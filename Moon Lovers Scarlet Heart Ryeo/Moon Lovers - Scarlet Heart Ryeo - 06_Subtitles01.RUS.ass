Dialogue: 0,0:00:18.95,0:00:22.97,надписи,,0000,0000,0000,,Жена Ван Ука, принца государства Корё, из рода Хэ
Dialogue: 0,0:01:52.68,0:01:54.09,мысли,,0000,0000,0000,,Сестра...
Dialogue: 0,0:01:56.69,0:01:58.89,мысли,,0000,0000,0000,,Мы сможем увидеться снова?
Dialogue: 0,0:02:06.29,0:02:08.29,общий текст,,0000,0000,0000,,Я уже скучаю
Dialogue: 0,0:02:11.19,0:02:12.99,общий текст,,0000,0000,0000,,Что же делать дальше?
Dialogue: 0,0:02:13.86,0:02:15.86,общий текст,,0000,0000,0000,,Просто ищи меня
Dialogue: 0,0:02:18.29,0:02:19.09,общий текст,,0000,0000,0000,,И я
Dialogue: 0,0:02:23.29,0:02:24.89,общий текст,,0000,0000,0000,,буду искать тебя
Dialogue: 0,0:02:30.19,0:02:31.35,общий текст,,0000,0000,0000,,Хорошо,
Dialogue: 0,0:02:32.59,0:02:35.05,общий текст,,0000,0000,0000,,что у меня появился такой друг
Dialogue: 0,0:03:13.29,0:03:14.59,общий текст,,0000,0000,0000,,Я...
Dialogue: 0,0:03:43.59,0:03:46.71,общий текст,,0000,0000,0000,,Почему я не сказал?
Dialogue: 0,0:03:51.79,0:03:55.26,общий текст,,0000,0000,0000,,Я прекрасно знал, что она всегда хотела услышать от меня эти слова
Dialogue: 0,0:03:58.29,0:04:00.67,общий текст,,0000,0000,0000,,Я не смог сказать, как сильно люблю и уважаю её
Dialogue: 0,0:04:04.74,0:04:07.14,общий текст,,0000,0000,0000,,Я всегда думал, что это не так
Dialogue: 0,0:04:12.49,0:04:14.49,общий текст,,0000,0000,0000,,Но, Су…
Dialogue: 0,0:04:19.89,0:04:21.89,общий текст,,0000,0000,0000,,В моём сердце были эти чувства
Dialogue: 0,0:04:27.09,0:04:28.50,общий текст,,0000,0000,0000,,Я думал, что это благодарность…
Dialogue: 0,0:04:30.73,0:04:32.29,общий текст,,0000,0000,0000,,Но это была любовь
Dialogue: 0,0:04:35.29,0:04:37.69,общий текст,,0000,0000,0000,,Мне всегда казалось, что с ней очень уютно и спокойно
Dialogue: 0,0:04:45.79,0:04:48.28,общий текст,,0000,0000,0000,,Но это была любовь
Dialogue: 0,0:04:56.29,0:04:57.89,курсив,,0000,0000,0000,,Что мне делать?
Dialogue: 0,0:05:06.76,0:05:08.94,курсив,,0000,0000,0000,,Су, что же мне делать?
Dialogue: 0,0:05:12.15,0:05:14.54,общий текст,,0000,0000,0000,,Я должен был ей сказать
Dialogue: 0,0:05:15.09,0:05:17.05,общий текст,,0000,0000,0000,,Наверное, она ждала этих слов
Dialogue: 0,0:05:22.66,0:05:24.80,общий текст,,0000,0000,0000,,Сестра могла знать
Dialogue: 0,0:05:25.94,0:05:28.00,общий текст,,0000,0000,0000,,Она обо всём знала...
Dialogue: 0,0:05:29.49,0:05:31.11,общий текст,,0000,0000,0000,,поэтому перестаньте
Dialogue: 0,0:05:31.66,0:05:32.43,общий текст,,0000,0000,0000,,Хорошо?
Dialogue: 0,0:05:37.17,0:05:38.67,общий текст,,0000,0000,0000,,Почему только сейчас…
Dialogue: 0,0:05:40.33,0:05:41.95,общий текст,,0000,0000,0000,,Только сейчас я…
Dialogue: 0,0:05:43.77,0:05:45.65,общий текст,,0000,0000,0000,,понял её чувства?
Dialogue: 0,0:05:45.65,0:05:49.01,общий текст,,0000,0000,0000,,Почему? Почему? Почему?
Dialogue: 0,0:05:49.01,0:05:51.01,общий текст,,0000,0000,0000,,Почему только сейчас?
Dialogue: 0,0:06:18.21,0:06:20.64,мысли,,0000,0000,0000,,Что мне дальше делать?
Dialogue: 0,0:06:21.67,0:06:23.79,мысли,,0000,0000,0000,,Как мне поступить?
Dialogue: 0,0:06:25.25,0:06:27.57,мысли,,0000,0000,0000,,В голове хоть шаром покати…
Dialogue: 0,0:06:50.93,0:06:52.87,общий текст,,0000,0000,0000,,Кто это?
Dialogue: 0,0:06:54.79,0:06:55.89,общий текст,,0000,0000,0000,,Кто там…
Dialogue: 0,0:07:04.67,0:07:05.73,курсив,,0000,0000,0000,,Божечки!
Dialogue: 0,0:07:06.03,0:07:08.75,курсив,,0000,0000,0000,,И почему все принцы уже женаты?
Dialogue: 0,0:07:10.49,0:07:13.00,курсив,,0000,0000,0000,,Какая наглость! Как неприлично с твоей стороны!
Dialogue: 0,0:07:13.00,0:07:14.19,курсив,,0000,0000,0000,,Тебе следует преподать урок!
Dialogue: 0,0:07:15.89,0:07:17.67,общий текст,,0000,0000,0000,,И что это такое?
Dialogue: 0,0:07:17.77,0:07:18.49,общий текст,,0000,0000,0000,,Что смешного?
Dialogue: 0,0:07:18.49,0:07:21.81,курсив,,0000,0000,0000,,В принце нет ни капли приличия!\NКак раз ему и надо преподать урок!
Dialogue: 0,0:07:25.01,0:07:26.73,курсив,,0000,0000,0000,,Ну-ка, прочь!
Dialogue: 0,0:07:27.05,0:07:28.27,курсив,,0000,0000,0000,,Уберите от меня руки!
Dialogue: 0,0:07:28.53,0:07:30.55,курсив,,0000,0000,0000,,Вот же...
Dialogue: 0,0:07:34.41,0:07:35.49,курсив,,0000,0000,0000,,Наглость какая!
Dialogue: 0,0:07:35.49,0:07:36.67,курсив,,0000,0000,0000,,Да неужто?
Dialogue: 0,0:07:36.67,0:07:38.13,курсив,,0000,0000,0000,,Ты как с принцем разговариваешь?!
Dialogue: 0,0:07:38.13,0:07:39.75,курсив,,0000,0000,0000,,И что с того, что ты принц?
Dialogue: 0,0:07:41.95,0:07:43.51,курсив,,0000,0000,0000,,Посмел ударить девушку?
Dialogue: 0,0:07:43.51,0:07:44.51,курсив,,0000,0000,0000,,Ты, мелкая!
Dialogue: 0,0:07:58.79,0:08:00.49,общий текст,,0000,0000,0000,,Что ты делаешь?
Dialogue: 0,0:08:05.29,0:08:09.39,общий текст,,0000,0000,0000,,И правда… Как ты додумался сделать кукольных человечков?
Dialogue: 0,0:08:09.72,0:08:11.92,общий текст,,0000,0000,0000,,Я даже немного расчувствовалась
Dialogue: 0,0:08:12.19,0:08:13.29,общий текст,,0000,0000,0000,,Ты лучший!
Dialogue: 0,0:08:14.29,0:08:15.72,общий текст,,0000,0000,0000,,Ты довольна, а это главное!
Dialogue: 0,0:08:16.19,0:08:19.28,общий текст,,0000,0000,0000,,Невестка умерла, и я боялся, что ты будешь сильно опечалена
Dialogue: 0,0:08:19.99,0:08:20.79,общий текст,,0000,0000,0000,,Но...
Dialogue: 0,0:08:21.40,0:08:23.40,общий текст,,0000,0000,0000,,Это что такое?
Dialogue: 0,0:08:23.99,0:08:26.69,общий текст,,0000,0000,0000,,Круто! Означает "самый лучший"
Dialogue: 0,0:08:26.69,0:08:29.69,общий текст,,0000,0000,0000,,Разве из всех пальцев на руке \Nбольшой не самый уважаемый?
Dialogue: 0,0:08:29.79,0:08:33.59,общий текст,,0000,0000,0000,,Нет! Разве его величество не самый уважаемый?
Dialogue: 0,0:08:35.69,0:08:38.08,общий текст,,0000,0000,0000,,Думаю, вот этот палец вполне неплох
Dialogue: 0,0:08:39.75,0:08:41.89,общий текст,,0000,0000,0000,,Ну, и так здорово
Dialogue: 0,0:08:42.59,0:08:45.89,общий текст,,0000,0000,0000,,10-й принц, сегодня ты лучший!
Dialogue: 0,0:08:46.59,0:08:48.79,общий текст,,0000,0000,0000,,Благодаря тебе я посмеялась
Dialogue: 0,0:08:49.79,0:08:53.59,общий текст,,0000,0000,0000,,Плохо, что в твоей жизни только я один лучший
Dialogue: 0,0:08:55.63,0:08:57.33,курсив,,0000,0000,0000,,Принц, сегодня ты лучший!
Dialogue: 0,0:08:57.73,0:08:58.70,курсив,,0000,0000,0000,,Конечно!
Dialogue: 0,0:08:58.70,0:09:01.27,курсив,,0000,0000,0000,,- Хватит! \N - Принц! Принц правда самый лучший!
Dialogue: 0,0:09:01.27,0:09:02.29,общий текст,,0000,0000,0000,,Правда?
Dialogue: 0,0:09:02.29,0:09:05.34,общий текст,,0000,0000,0000,,- Перестань!\N- Принц! Принц вырос самым красивым!
Dialogue: 0,0:09:05.34,0:09:06.79,общий текст,,0000,0000,0000,,- Ты всерьёз, да?\N - Я же сказала тебе перестать
Dialogue: 0,0:09:06.79,0:09:08.21,общий текст,,0000,0000,0000,,Тогда кто тебе больше всех нравится?
Dialogue: 0,0:09:08.21,0:09:08.89,общий текст,,0000,0000,0000,,Принц Ын, конечно!
Dialogue: 0,0:09:08.89,0:09:10.29,общий текст,,0000,0000,0000,,Хватит тебе
Dialogue: 0,0:09:25.76,0:09:28.30,общий текст,,0000,0000,0000,,Так и не извинился передо мной
Dialogue: 0,0:09:32.31,0:09:34.34,общий текст,,0000,0000,0000,,Ты неправильно понял нас с матушкой
Dialogue: 0,0:09:34.46,0:09:36.71,общий текст,,0000,0000,0000,,Только и умеешь лаять на других
Dialogue: 0,0:09:39.91,0:09:41.49,общий текст,,0000,0000,0000,,Мы могли бы быть братьями,
Dialogue: 0,0:09:42.46,0:09:44.29,общий текст,,0000,0000,0000,,но ты даже поздороваться не соизволишь
Dialogue: 0,0:09:44.44,0:09:47.74,общий текст,,0000,0000,0000,,Не должен ли я быть тем, кто получает приветствия?
Dialogue: 0,0:09:48.34,0:09:49.94,общий текст,,0000,0000,0000,,Я спас его от смерти
Dialogue: 0,0:09:50.36,0:09:51.87,общий текст,,0000,0000,0000,,Как долго ты
Dialogue: 0,0:09:51.87,0:09:54.11,общий текст,,0000,0000,0000,,собираешься оставаться на стороне кронпринца?
Dialogue: 0,0:09:57.49,0:10:00.29,общий текст,,0000,0000,0000,,Вот почему я обменял свою жизнь на это
Dialogue: 0,0:10:02.34,0:10:03.51,общий текст,,0000,0000,0000,,Что?
Dialogue: 0,0:10:03.89,0:10:04.74,общий текст,,0000,0000,0000,,Брат!
Dialogue: 0,0:10:05.19,0:10:08.54,общий текст,,0000,0000,0000,,Вы слышали, что народ Хупэкче теперь будет жить в Сонгаке?
Dialogue: 0,0:10:08.99,0:10:13.46,общий текст,,0000,0000,0000,,Его величество предоставит всем землю
Dialogue: 0,0:10:13.46,0:10:17.26,общий текст,,0000,0000,0000,,Будь то Пархэ или Хупэкче, его величество поглотит их
Dialogue: 0,0:10:17.54,0:10:19.06,общий текст,,0000,0000,0000,,Вот такое наше Корё
Dialogue: 0,0:10:19.19,0:10:19.89,общий текст,,0000,0000,0000,,Верно
Dialogue: 0,0:10:20.59,0:10:23.16,общий текст,,0000,0000,0000,,Развал нации - вопрос времени
Dialogue: 0,0:10:24.26,0:10:26.26,общий текст,,0000,0000,0000,,Посмотрите на дедушку 13-го принца
Dialogue: 0,0:10:26.39,0:10:28.39,общий текст,,0000,0000,0000,,Был могущественным королём Силлы,
Dialogue: 0,0:10:28.76,0:10:30.69,общий текст,,0000,0000,0000,,а теперь за нашего правителя цепляется, чтобы выжить
Dialogue: 0,0:10:30.69,0:10:33.04,общий текст,,0000,0000,0000,,Он даже во дворце показаться не смеет
Dialogue: 0,0:10:33.61,0:10:35.66,общий текст,,0000,0000,0000,,Только и может пресмыкаться
Dialogue: 0,0:10:36.74,0:10:37.79,общий текст,,0000,0000,0000,,Но
Dialogue: 0,0:10:38.11,0:10:39.79,общий текст,,0000,0000,0000,,мы такие же, как и они
Dialogue: 0,0:10:40.31,0:10:42.06,общий текст,,0000,0000,0000,,Просто ничто без императора
Dialogue: 0,0:10:43.61,0:10:46.16,общий текст,,0000,0000,0000,,Мы едим ту же пищу, данную нам владельцем,
Dialogue: 0,0:10:46.16,0:10:47.66,общий текст,,0000,0000,0000,,так о чём говорить?
Dialogue: 0,0:10:50.14,0:10:50.64,общий текст,,0000,0000,0000,,Что?
Dialogue: 0,0:10:51.24,0:10:53.74,общий текст,,0000,0000,0000,,Будешь ли ты пресмыкаться или есть как собака,
Dialogue: 0,0:10:54.79,0:10:57.14,общий текст,,0000,0000,0000,,ты всё равно ничего не посмеешь высказать владельцу
Dialogue: 0,0:10:57.19,0:10:59.49,общий текст,,0000,0000,0000,,Так что не нужно говорить ерунду
Dialogue: 0,0:11:01.89,0:11:05.99,общий текст,,0000,0000,0000,,Вместо того... не лучше ли будет пойти выпить?
Dialogue: 0,0:11:12.66,0:11:13.36,общий текст,,0000,0000,0000,,Пэк А,
Dialogue: 0,0:11:14.11,0:11:15.71,общий текст,,0000,0000,0000,,ты же пьёшь?
Dialogue: 0,0:11:16.86,0:11:20.06,общий текст,,0000,0000,0000,,Да, брат, пить - мой талант
Dialogue: 0,0:11:26.91,0:11:28.21,общий текст,,0000,0000,0000,,Спасибо, брат
Dialogue: 0,0:11:29.74,0:11:32.39,общий текст,,0000,0000,0000,,Я это не из-за тебя сказал, не благодари
Dialogue: 0,0:11:32.89,0:11:35.86,общий текст,,0000,0000,0000,,Просто ненавижу людей, которые унижают слабых
Dialogue: 0,0:11:36.11,0:11:38.66,общий текст,,0000,0000,0000,,Я благодарен за то, что вы усмирили мой гнев
Dialogue: 0,0:11:38.66,0:11:42.41,общий текст,,0000,0000,0000,,Мне бы даже не хватило смелости всё высказать
Dialogue: 0,0:11:46.89,0:11:49.30,мысли,,0000,0000,0000,,Время так быстро летит
Dialogue: 0,0:11:49.97,0:11:53.31,мысли,,0000,0000,0000,,И правда, я нахожусь здесь уже достаточно долго
Dialogue: 0,0:11:54.87,0:11:58.13,мысли,,0000,0000,0000,,Сначала волновалась, что не смогу тут прожить,
Dialogue: 0,0:11:58.13,0:12:00.55,мысли,,0000,0000,0000,,а сейчас думаю, что всё не так плохо
Dialogue: 0,0:12:02.91,0:12:04.03,мысли,,0000,0000,0000,,Вот только...
Dialogue: 0,0:12:05.03,0:12:07.67,мысли,,0000,0000,0000,,до каких пор я должна быть Хэ Су?
Dialogue: 0,0:12:11.11,0:12:12.79,мысли,,0000,0000,0000,,Я всегда хотела сказать сестре
Dialogue: 0,0:12:14.25,0:12:16.29,мысли,,0000,0000,0000,,именно такие слова:
Dialogue: 0,0:12:18.91,0:12:22.07,мысли,,0000,0000,0000,,прости меня... за всё
Dialogue: 0,0:12:23.25,0:12:24.45,мысли,,0000,0000,0000,,И спасибо тебе
Dialogue: 0,0:12:28.47,0:12:29.49,курсив,,0000,0000,0000,,Эй, Хэ Су!
Dialogue: 0,0:12:31.67,0:12:32.67,общий текст,,0000,0000,0000,,Сестра!
Dialogue: 0,0:12:33.13,0:12:35.65,общий текст,,0000,0000,0000,,- Сестрица Хэ Су!\N- Осторожно, упа... дёшь
Dialogue: 0,0:12:37.05,0:12:38.19,общий текст,,0000,0000,0000,,Фай-тин!
Dialogue: 0,0:12:39.89,0:12:40.95,общий текст,,0000,0000,0000,,Файтин
Dialogue: 0,0:12:40.95,0:12:41.83,общий текст,,0000,0000,0000,,Сестра!
Dialogue: 0,0:12:43.23,0:12:44.05,курсив,,0000,0000,0000,,Сестра!
Dialogue: 0,0:12:44.96,0:12:46.82,общий текст,,0000,0000,0000,,Вы хорошо поживали?
Dialogue: 0,0:12:46.82,0:12:48.58,общий текст,,0000,0000,0000,,Откуда вы все идёте?
Dialogue: 0,0:12:48.58,0:12:50.72,общий текст,,0000,0000,0000,,Мы ходили навестить нашу невестку
Dialogue: 0,0:12:50.72,0:12:52.37,общий текст,,0000,0000,0000,,Она, наверное, была счастлива
Dialogue: 0,0:12:53.96,0:12:58.36,общий текст,,0000,0000,0000,,Тогда, раз уж ты узнаешь раньше, можешь сама пойти и рассказать об этом Мён Хи
Dialogue: 0,0:12:59.54,0:13:01.61,общий текст,,0000,0000,0000,,У меня есть хорошие новости
Dialogue: 0,0:13:02.85,0:13:04.87,общий текст,,0000,0000,0000,,Ты скоро выйдешь замуж
Dialogue: 0,0:13:05.94,0:13:07.38,общий текст,,0000,0000,0000,,Замуж?..
Dialogue: 0,0:13:07.38,0:13:08.66,общий текст,,0000,0000,0000,,Я?!
Dialogue: 0,0:13:12.67,0:13:16.45,общий текст,,0000,0000,0000,,Вы планируете выдать Хэ Су замуж?
Dialogue: 0,0:13:18.36,0:13:20.93,общий текст,,0000,0000,0000,,Ясно. Просто это немного внезапно
Dialogue: 0,0:13:20.93,0:13:24.74,общий текст,,0000,0000,0000,,Она как раз в брачном возрасте. Мы не можем забыть об этом
Dialogue: 0,0:13:25.19,0:13:29.04,общий текст,,0000,0000,0000,,К счастью, мы нашли ей замечательного мужчину
Dialogue: 0,0:13:31.49,0:13:35.92,общий текст,,0000,0000,0000,,Для неё не будет так уж сложно вот так выйти замуж
Dialogue: 0,0:13:37.57,0:13:41.41,общий текст,,0000,0000,0000,,Но всё же, моя жена совсем недавно покинула нас
Dialogue: 0,0:13:41.41,0:13:43.25,общий текст,,0000,0000,0000,,Зачем сейчас выдавать её замуж?
Dialogue: 0,0:13:44.27,0:13:46.41,общий текст,,0000,0000,0000,,Вы должны дать ей немного времени
Dialogue: 0,0:13:46.41,0:13:48.37,общий текст,,0000,0000,0000,,Наоборот, это хорошо
Dialogue: 0,0:13:48.37,0:13:51.12,общий текст,,0000,0000,0000,,Если она проведёт слишком много времени в доме, где умерла невестка,
Dialogue: 0,0:13:51.12,0:13:53.87,общий текст,,0000,0000,0000,,это не сулит ничего хорошего для её будущего замужества
Dialogue: 0,0:13:53.87,0:13:56.49,общий текст,,0000,0000,0000,,Выше высочество, мы надеемся на ваше понимание
Dialogue: 0,0:13:56.49,0:13:58.51,общий текст,,0000,0000,0000,,Мы не можем потерять такую возможность
Dialogue: 0,0:14:03.99,0:14:06.50,общий текст,,0000,0000,0000,,Брак? Это столь шокирующе!
Dialogue: 0,0:14:07.79,0:14:09.76,общий текст,,0000,0000,0000,,Но ведь это правда, что она вошла в брачный возраст
Dialogue: 0,0:14:09.76,0:14:12.38,общий текст,,0000,0000,0000,,Вы сейчас здесь, вы можете возразить против брака
Dialogue: 0,0:14:12.38,0:14:13.57,общий текст,,0000,0000,0000,,Этот вопрос решает дом Хэ
Dialogue: 0,0:14:13.57,0:14:15.20,общий текст,,0000,0000,0000,,У нас нет прав возражать
Dialogue: 0,0:14:15.72,0:14:18.49,общий текст,,0000,0000,0000,,Брат! Брат! Брат!
Dialogue: 0,0:14:18.49,0:14:20.83,общий текст,,0000,0000,0000,,Это правда, что Хэ Су выходит замуж?
Dialogue: 0,0:14:20.83,0:14:23.11,общий текст,,0000,0000,0000,,Бэк А, ты слышал?
Dialogue: 0,0:14:23.11,0:14:24.60,общий текст,,0000,0000,0000,,Брат Ын услышал где-то
Dialogue: 0,0:14:24.60,0:14:28.99,общий текст,,0000,0000,0000,,Мужчине, за которого она выйдет замуж, больше 60-ти и у него очень много сыновей
Dialogue: 0,0:14:28.99,0:14:32.55,общий текст,,0000,0000,0000,,Эта глупышка. Она знает, что её ждёт?
Dialogue: 0,0:14:32.55,0:14:35.72,общий текст,,0000,0000,0000,,Если это правда, то это не брак. Её просто продали
Dialogue: 0,0:14:35.72,0:14:37.66,общий текст,,0000,0000,0000,,Да, её продали
Dialogue: 0,0:14:38.17,0:14:39.55,общий текст,,0000,0000,0000,,Что ты сейчас сказал?
Dialogue: 0,0:14:41.97,0:14:43.06,общий текст,,0000,0000,0000,,Повтори ещё раз
Dialogue: 0,0:14:43.06,0:14:45.21,общий текст,,0000,0000,0000,,В какой дом отдают Су?
Dialogue: 0,0:14:45.21,0:14:46.78,общий текст,,0000,0000,0000,,Брат, это слишком!
Dialogue: 0,0:14:46.78,0:14:49.43,общий текст,,0000,0000,0000,,Как вы можете так относиться к Су?
Dialogue: 0,0:14:49.43,0:14:52.09,общий текст,,0000,0000,0000,,Мужчина, за которого она выходит, предложил сделку -
Dialogue: 0,0:14:52.09,0:14:53.98,общий текст,,0000,0000,0000,,компенсировать убытки дома Хэ
Dialogue: 0,0:14:53.98,0:14:56.64,общий текст,,0000,0000,0000,,Непорядочно вот так продавать Су
Dialogue: 0,0:14:59.59,0:15:02.09,общий текст,,0000,0000,0000,,Я попробую найти выход
Dialogue: 0,0:15:18.64,0:15:20.79,общий текст,,0000,0000,0000,,Чэ Рён, я хочу уйти
Dialogue: 0,0:15:20.79,0:15:21.91,общий текст,,0000,0000,0000,,Что?
Dialogue: 0,0:15:21.91,0:15:24.47,общий текст,,0000,0000,0000,,Как я могу жить с мужчиной, которого раньше не видела?
Dialogue: 0,0:15:24.47,0:15:27.36,общий текст,,0000,0000,0000,,Сестра никогда бы не пожелала мне такой участи
Dialogue: 0,0:15:27.36,0:15:29.45,общий текст,,0000,0000,0000,,Давай это мне, я должна бежать
Dialogue: 0,0:15:29.45,0:15:30.86,общий текст,,0000,0000,0000,,Скорее, скорее!
Dialogue: 0,0:15:32.62,0:15:37.00,общий текст,,0000,0000,0000,,Да! Бегите! Уходите!
Dialogue: 0,0:15:37.00,0:15:42.02,общий текст,,0000,0000,0000,,Даже если меня до смерти изобьют, я не скажу им, куда вы пошли
Dialogue: 0,0:15:43.94,0:15:46.06,общий текст,,0000,0000,0000,,Чэ Рён...
Dialogue: 0,0:15:51.34,0:15:53.46,общий текст,,0000,0000,0000,,Су! Скорее выходи
Dialogue: 0,0:15:53.94,0:15:55.12,общий текст,,0000,0000,0000,,Быстрее!
Dialogue: 0,0:16:28.96,0:16:30.56,общий текст,,0000,0000,0000,,Вы будете в порядке?
Dialogue: 0,0:16:37.33,0:16:38.99,общий текст,,0000,0000,0000,,Я не могу вот так отдать тебя
Dialogue: 0,0:16:48.45,0:16:51.27,общий текст,,0000,0000,0000,,Вот так этот малыш и сказал
Dialogue: 0,0:16:55.98,0:16:57.29,общий текст,,0000,0000,0000,,Братец?
Dialogue: 0,0:17:00.57,0:17:01.82,общий текст,,0000,0000,0000,,За ним!
Dialogue: 0,0:17:12.00,0:17:14.49,общий текст,,0000,0000,0000,,- Остановитесь!\N- Остановитесь!
Dialogue: 0,0:17:14.49,0:17:15.49,общий текст,,0000,0000,0000,,Остановитесь!
Dialogue: 0,0:17:27.29,0:17:28.98,общий текст,,0000,0000,0000,,Брат, остановись!
Dialogue: 0,0:17:37.76,0:17:38.90,общий текст,,0000,0000,0000,,Что за наглость?
Dialogue: 0,0:17:38.90,0:17:40.79,общий текст,,0000,0000,0000,,Посмели встать на пути принцев?!
Dialogue: 0,0:17:40.79,0:17:43.72,общий текст,,0000,0000,0000,,- Брат\N- О, Ён Хва?
Dialogue: 0,0:17:43.72,0:17:45.89,общий текст,,0000,0000,0000,,Что такое? Что-то дома случилось?
Dialogue: 0,0:17:45.89,0:17:47.43,общий текст,,0000,0000,0000,,Извините,
Dialogue: 0,0:17:47.43,0:17:51.50,общий текст,,0000,0000,0000,,но, кажется, моя племянница сильно обременяет вас
Dialogue: 0,0:17:58.21,0:17:59.94,общий текст,,0000,0000,0000,,Сюрприз!
Dialogue: 0,0:18:01.29,0:18:04.09,общий текст,,0000,0000,0000,,Вы свою племянницу с моим братцем перепутали?
Dialogue: 0,0:18:04.09,0:18:06.38,общий текст,,0000,0000,0000,,Найдите их! Сейчас же!
Dialogue: 0,0:18:38.09,0:18:41.19,мысли,,0000,0000,0000,,Никогда бы не подумала, что вы тоже поможете мне
Dialogue: 0,0:18:42.99,0:18:47.54,мысли,,0000,0000,0000,,Просто не хочу видеть то, как твоей жизнью распоряжаются другие
Dialogue: 0,0:18:48.49,0:18:51.49,мысли,,0000,0000,0000,,Такая жизнь не имеет смысла
Dialogue: 0,0:19:38.00,0:19:39.86,общий текст,,0000,0000,0000,,Здравствуйте, ваше высочество
Dialogue: 0,0:19:40.57,0:19:44.25,общий текст,,0000,0000,0000,,Что привело вас сюда, да ещё и с дворцовой стражей?
Dialogue: 0,0:19:44.96,0:19:48.29,общий текст,,0000,0000,0000,,Это разве не госпожа Су из дома 8-го принца?
Dialogue: 0,0:19:49.84,0:19:51.78,общий текст,,0000,0000,0000,,Вам нужно пройти со мной
Dialogue: 0,0:19:51.78,0:19:53.01,общий текст,,0000,0000,0000,,Зачем она вам?
Dialogue: 0,0:19:53.84,0:19:58.27,общий текст,,0000,0000,0000,,Неужели человек, который хочет взять её в жёны, попросил об услуге?
Dialogue: 0,0:19:58.27,0:19:59.60,общий текст,,0000,0000,0000,,Чи Мон
Dialogue: 0,0:20:00.40,0:20:02.02,общий текст,,0000,0000,0000,,Закройте на это глаза лишь один раз
Dialogue: 0,0:20:02.02,0:20:03.92,общий текст,,0000,0000,0000,,Как она может выйти замуж за такого человека?
Dialogue: 0,0:20:03.92,0:20:05.23,общий текст,,0000,0000,0000,,Вам разве её не жаль?
Dialogue: 0,0:20:05.23,0:20:07.93,общий текст,,0000,0000,0000,,Госпоже Су было приказано войти во дворец
Dialogue: 0,0:20:13.13,0:20:14.86,общий текст,,0000,0000,0000,,Что значит: "войти во дворец"?
Dialogue: 0,0:20:19.02,0:20:20.10,общий текст,,0000,0000,0000,,Неужели...
Dialogue: 0,0:20:21.38,0:20:23.94,общий текст,,0000,0000,0000,,Было подтверждено, что император женится на Хэ Су
Dialogue: 0,0:20:23.94,0:20:25.39,общий текст,,0000,0000,0000,,Я здесь, чтобы забрать её
Dialogue: 0,0:20:27.77,0:20:29.33,общий текст,,0000,0000,0000,,Не может быть
Dialogue: 0,0:20:30.19,0:20:31.71,общий текст,,0000,0000,0000,,Наверное, это ошибка
Dialogue: 0,0:20:31.71,0:20:33.02,общий текст,,0000,0000,0000,,Это было внезапно, но
Dialogue: 0,0:20:33.02,0:20:35.57,общий текст,,0000,0000,0000,,дочь из клана Хон Ха Чжин Хэ и клана Ин Гю Го Мён, госпожа Су,
Dialogue: 0,0:20:35.57,0:20:37.49,общий текст,,0000,0000,0000,,абсолютно точно выйдет замуж за императора
Dialogue: 0,0:20:38.49,0:20:39.94,общий текст,,0000,0000,0000,,Ты что-то слышала об этом?
Dialogue: 0,0:20:39.94,0:20:41.62,общий текст,,0000,0000,0000,,Нет, совсем ничего
Dialogue: 0,0:20:43.13,0:20:44.74,общий текст,,0000,0000,0000,,Это невозможно. С чего бы мне...
Dialogue: 0,0:20:44.74,0:20:47.43,общий текст,,0000,0000,0000,,Ну хорошо. Не слезай и жди
Dialogue: 0,0:20:47.97,0:20:49.24,общий текст,,0000,0000,0000,,4-й принц
Dialogue: 0,0:20:55.38,0:20:56.44,курсив,,0000,0000,0000,,Астроном Чи Мон!
Dialogue: 0,0:20:57.46,0:20:58.70,общий текст,,0000,0000,0000,,Астроном!
Dialogue: 0,0:21:02.35,0:21:03.35,общий текст,,0000,0000,0000,,Выше высочество
Dialogue: 0,0:21:04.73,0:21:07.69,общий текст,,0000,0000,0000,,Как это случилось? Выходит замуж за императора?
Dialogue: 0,0:21:08.84,0:21:11.06,общий текст,,0000,0000,0000,,О, вы уже слышали
Dialogue: 0,0:21:12.26,0:21:16.02,общий текст,,0000,0000,0000,,Император признал заслуги дома Хэ
Dialogue: 0,0:21:16.02,0:21:18.72,общий текст,,0000,0000,0000,,Он хочет стать нам родственником
Dialogue: 0,0:21:18.72,0:21:22.16,общий текст,,0000,0000,0000,,Почему вы не сказали мне, что Су выйдет за его величество?
Dialogue: 0,0:21:23.86,0:21:25.71,общий текст,,0000,0000,0000,,Мён Хи умерла,
Dialogue: 0,0:21:25.71,0:21:28.33,общий текст,,0000,0000,0000,,мы с вами больше не связаны
Dialogue: 0,0:21:28.80,0:21:32.62,общий текст,,0000,0000,0000,,Пускай наша Су родит ребёнка императору
Dialogue: 0,0:21:34.77,0:21:38.79,общий текст,,0000,0000,0000,,И у вас могут появиться проблемы в отношениях из-за трона
Dialogue: 0,0:21:40.29,0:21:43.39,общий текст,,0000,0000,0000,,Вы боялись, что мы остановим брак, если узнаем?
Dialogue: 0,0:21:44.57,0:21:47.58,общий текст,,0000,0000,0000,,Нам больше нечего обсуждать, возвращаемся
Dialogue: 0,0:21:51.41,0:21:52.58,общий текст,,0000,0000,0000,,Отойдите
Dialogue: 0,0:21:53.98,0:21:55.37,общий текст,,0000,0000,0000,,Отойдите!
Dialogue: 0,0:21:57.80,0:22:00.85,общий текст,,0000,0000,0000,,Вы сами знаете, что случится, если ослушаетесь императорского приказа
Dialogue: 0,0:22:00.85,0:22:04.33,общий текст,,0000,0000,0000,,Отпустите её, брат! Разве можно не слушаться императора?
Dialogue: 0,0:22:04.33,0:22:07.25,общий текст,,0000,0000,0000,,Все наши братья могут умереть из-за неё
Dialogue: 0,0:22:23.76,0:22:25.29,общий текст,,0000,0000,0000,,Я говорил тебе не двигаться
Dialogue: 0,0:22:25.29,0:22:26.86,общий текст,,0000,0000,0000,,Думаю, я должна пойти
Dialogue: 0,0:22:27.62,0:22:31.61,общий текст,,0000,0000,0000,,Если пойдёшь сейчас, уйти из дворца будет трудно
Dialogue: 0,0:22:37.50,0:22:38.66,общий текст,,0000,0000,0000,,Я должна
Dialogue: 0,0:22:39.75,0:22:41.44,общий текст,,0000,0000,0000,,Тогда никто не пострадает
Dialogue: 0,0:23:09.59,0:23:11.25,общий текст,,0000,0000,0000,,И правда не пожалеешь?
Dialogue: 0,0:23:12.38,0:23:13.75,общий текст,,0000,0000,0000,,Не волнуйтесь
Dialogue: 0,0:23:13.75,0:23:17.00,общий текст,,0000,0000,0000,,Я попробую поговорить с ним
Dialogue: 0,0:23:21.28,0:23:22.76,общий текст,,0000,0000,0000,,Садитесь же в паланкин
Dialogue: 0,0:24:26.59,0:24:28.32,общий текст,,0000,0000,0000,,Возвращаемся во дворец!
Dialogue: 0,0:24:45.79,0:24:47.26,общий текст,,0000,0000,0000,,Глупая девчонка
Dialogue: 0,0:24:48.29,0:24:51.42,общий текст,,0000,0000,0000,,Мужчина за 60 и куча сыновей?
Dialogue: 0,0:24:51.42,0:24:52.75,общий текст,,0000,0000,0000,,Это наш император! Император!
Dialogue: 0,0:24:52.75,0:24:54.65,общий текст,,0000,0000,0000,,Где только такое слыхано?
Dialogue: 0,0:25:01.01,0:25:03.21,курсив,,0000,0000,0000,,Императрица здесь!
Dialogue: 0,0:25:09.84,0:25:11.49,общий текст,,0000,0000,0000,,Такой занятой человек
Dialogue: 0,0:25:12.09,0:25:13.71,общий текст,,0000,0000,0000,,и свадьбу устраивает?
Dialogue: 0,0:25:15.91,0:25:18.96,общий текст,,0000,0000,0000,,Что за спешка с первой брачной ночью до самой церемонии?
Dialogue: 0,0:25:24.96,0:25:27.26,общий текст,,0000,0000,0000,,Кидане наступают
Dialogue: 0,0:25:28.09,0:25:31.49,общий текст,,0000,0000,0000,,Мы должны объединить силы с кланом Хэ \NХон Ха Чжина, чтобы защитить северную границу
Dialogue: 0,0:25:33.11,0:25:36.91,общий текст,,0000,0000,0000,,Когда могущественные кланы нашей страны будут удовлетворены императорской семьёй?
Dialogue: 0,0:25:38.11,0:25:42.19,общий текст,,0000,0000,0000,,У народа никакой надежды на кронпринца нет, они роют ему могилу!
Dialogue: 0,0:25:42.41,0:25:44.61,общий текст,,0000,0000,0000,,Вот почему вы нацелены на его жизнь?!
Dialogue: 0,0:25:44.74,0:25:47.19,общий текст,,0000,0000,0000,,Я вырыл и себе могилу, и своему сыну!
Dialogue: 0,0:25:49.71,0:25:51.34,общий текст,,0000,0000,0000,,Всё ещё сомневаетесь во мне?
Dialogue: 0,0:25:52.91,0:25:57.84,общий текст,,0000,0000,0000,,Моя жена, у вас есть всё. Я сомневаюсь в вашей жадности!
Dialogue: 0,0:26:02.64,0:26:04.11,общий текст,,0000,0000,0000,,Думаю, что не смогу
Dialogue: 0,0:26:05.24,0:26:07.29,общий текст,,0000,0000,0000,,изменить ваше мнение обо мне
Dialogue: 0,0:26:33.27,0:26:36.55,мысли,,0000,0000,0000,,Я же в итоге не выйду замуж за Тхэджо?
Dialogue: 0,0:26:38.25,0:26:41.63,мысли,,0000,0000,0000,,Нет, даже несмотря на то, что я сейчас в Корё, - это неправильно!
Dialogue: 0,0:26:41.63,0:26:43.56,мысли,,0000,0000,0000,,Кто знает, что ещё пойдёт не так?
Dialogue: 0,0:26:50.97,0:26:52.82,мысли,,0000,0000,0000,,Держи голову прямо
Dialogue: 0,0:26:53.59,0:26:55.70,мысли,,0000,0000,0000,,Не паникуй, ты справишься
Dialogue: 0,0:26:56.70,0:27:00.27,мысли,,0000,0000,0000,,Должна обязательно выжить
Dialogue: 0,0:27:13.46,0:27:16.29,надписи,,0000,0000,0000,,{\pos(645,581)}Дворец Дамивон
Dialogue: 0,0:27:23.10,0:27:25.97,общий текст,,0000,0000,0000,,Через час поменяйте травяной мешок
Dialogue: 0,0:27:26.16,0:27:28.36,общий текст,,0000,0000,0000,,Наложница О! Наложница О!
Dialogue: 0,0:27:30.03,0:27:33.42,общий текст,,0000,0000,0000,,Астроном Чжи Мон передал вести о новой жене правителя
Dialogue: 0,0:27:34.39,0:27:36.52,общий текст,,0000,0000,0000,,Когда и из какой она семьи?
Dialogue: 0,0:27:44.86,0:27:46.93,общий текст,,0000,0000,0000,,Дворец Дамивон был построен, чтобы заботиться
Dialogue: 0,0:27:46.93,0:27:49.01,общий текст,,0000,0000,0000,,о духе и теле императора и принцев
Dialogue: 0,0:27:49.01,0:27:51.41,общий текст,,0000,0000,0000,,Здесь вы будете готовиться к свадьбе
Dialogue: 0,0:27:51.41,0:27:52.14,общий текст,,0000,0000,0000,,Извините
Dialogue: 0,0:27:53.14,0:27:57.25,общий текст,,0000,0000,0000,,Я вообще ничего не слышала о свадьбах
Dialogue: 0,0:27:57.25,0:27:59.37,общий текст,,0000,0000,0000,,Извиняюсь перед императором, но...
Dialogue: 0,0:27:59.37,0:28:02.55,общий текст,,0000,0000,0000,,Можете сообщить ему, что получилось недоразумение?
Dialogue: 0,0:28:02.55,0:28:05.09,общий текст,,0000,0000,0000,,Хотите отказаться от брака с императором?
Dialogue: 0,0:28:05.09,0:28:07.99,общий текст,,0000,0000,0000,,Не только от брака с императором, но и от брака с его дедушкой
Dialogue: 0,0:28:07.99,0:28:10.09,общий текст,,0000,0000,0000,,У меня нет намерения выходить за того, кого не знаю
Dialogue: 0,0:28:10.09,0:28:11.36,общий текст,,0000,0000,0000,,Боже, наложница О!
Dialogue: 0,0:28:13.87,0:28:18.35,общий текст,,0000,0000,0000,,Я так хотел вас увидеть, аж глаза большими стали
Dialogue: 0,0:28:19.16,0:28:20.64,общий текст,,0000,0000,0000,,Это она?
Dialogue: 0,0:28:21.82,0:28:24.15,общий текст,,0000,0000,0000,,Это госпожа Су из клана Хон Ха Чжин Хэ
Dialogue: 0,0:28:24.74,0:28:28.50,общий текст,,0000,0000,0000,,Теперь, раз вы здесь, я могу откланиваться
Dialogue: 0,0:28:31.82,0:28:34.26,общий текст,,0000,0000,0000,,Просто следуйте за судьбой
Dialogue: 0,0:28:37.28,0:28:38.51,общий текст,,0000,0000,0000,,Астроном
Dialogue: 0,0:28:40.25,0:28:44.25,общий текст,,0000,0000,0000,,Отныне перед нами не относитесь к себе так,\N словно вы всего лишь простолюдин
Dialogue: 0,0:28:45.25,0:28:47.28,общий текст,,0000,0000,0000,,А, это... я...
Dialogue: 0,0:28:47.28,0:28:48.66,общий текст,,0000,0000,0000,,Следуйте за мной, госпожа
Dialogue: 0,0:28:52.04,0:28:53.59,общий текст,,0000,0000,0000,,Пойдёмте
Dialogue: 0,0:29:02.22,0:29:05.19,общий текст,,0000,0000,0000,,Трудно с ней, очень трудно
Dialogue: 0,0:29:05.19,0:29:07.63,общий текст,,0000,0000,0000,,Что император в ней разглядел?
Dialogue: 0,0:29:18.29,0:29:21.48,общий текст,,0000,0000,0000,,Мы исследуем ваше тело, перед тем как вымыть
Dialogue: 0,0:29:21.48,0:29:22.62,общий текст,,0000,0000,0000,,Зачем?
Dialogue: 0,0:29:23.38,0:29:26.30,общий текст,,0000,0000,0000,,Женщина со шрамами на теле не может стать женой императора
Dialogue: 0,0:29:26.30,0:29:28.58,общий текст,,0000,0000,0000,,Поэтому мы должны вас проверить
Dialogue: 0,0:29:28.58,0:29:29.94,общий текст,,0000,0000,0000,,Я не хочу!
Dialogue: 0,0:29:31.51,0:29:33.29,общий текст,,0000,0000,0000,,У меня нет шрамов
Dialogue: 0,0:29:33.29,0:29:37.28,общий текст,,0000,0000,0000,,Мне не нравится, когда люди смотрят на меня, \Nпоэтому я даже в общественные бани не ходила
Dialogue: 0,0:29:37.28,0:29:38.86,общий текст,,0000,0000,0000,,А вы просите меня оголиться?
Dialogue: 0,0:29:38.86,0:29:41.48,общий текст,,0000,0000,0000,,Вы чего? Что вы делаете?!
Dialogue: 0,0:29:41.48,0:29:44.47,общий текст,,0000,0000,0000,,- Постойте!\N- Вы сегодня разделите ложе
Dialogue: 0,0:29:44.47,0:29:46.73,общий текст,,0000,0000,0000,,Это не займёт много времени, простите за грубость
Dialogue: 0,0:29:46.73,0:29:50.08,общий текст,,0000,0000,0000,,Разделим ложе?! Постойте! Постойте!
Dialogue: 0,0:29:50.08,0:29:52.35,общий текст,,0000,0000,0000,,Да что вы?! Попросила же остановиться!
Dialogue: 0,0:29:52.49,0:29:53.33,общий текст,,0000,0000,0000,,Стойте!
Dialogue: 0,0:29:56.24,0:29:58.82,общий текст,,0000,0000,0000,,Я уверена, вы слышали о браке императора
Dialogue: 0,0:29:58.82,0:30:00.64,общий текст,,0000,0000,0000,,Не собираетесь остановить его?
Dialogue: 0,0:30:01.30,0:30:05.23,общий текст,,0000,0000,0000,,Он делает это в интересах империи. Как я могу быть против?
Dialogue: 0,0:30:06.14,0:30:09.66,общий текст,,0000,0000,0000,,Вы всегда носили с собой буддистские чётки и теперь, похоже, стали святой
Dialogue: 0,0:30:09.66,0:30:12.14,общий текст,,0000,0000,0000,,У его величества уже есть 29 женщин
Dialogue: 0,0:30:12.14,0:30:15.03,общий текст,,0000,0000,0000,,Он мог принять во внимание интересы семьи, не только интересы империи
Dialogue: 0,0:30:15.03,0:30:19.35,общий текст,,0000,0000,0000,,Он хочет, чтобы после его смерти империя разделилась на 25 частей?
Dialogue: 0,0:30:19.35,0:30:21.80,общий текст,,0000,0000,0000,,Как вы можете такое говорить?
Dialogue: 0,0:30:22.40,0:30:24.34,курсив,,0000,0000,0000,,14-й принц здесь
Dialogue: 0,0:30:25.43,0:30:26.85,общий текст,,0000,0000,0000,,Скажите ему войти
Dialogue: 0,0:30:29.96,0:30:32.48,общий текст,,0000,0000,0000,,14-й принц приветствует вас, королева Хванбо
Dialogue: 0,0:30:32.48,0:30:33.68,общий текст,,0000,0000,0000,,Входи
Dialogue: 0,0:30:35.09,0:30:36.41,общий текст,,0000,0000,0000,,Помогите, мама
Dialogue: 0,0:30:36.41,0:30:38.06,общий текст,,0000,0000,0000,,Вы знаете Су из дома моего 8-го брата?
Dialogue: 0,0:30:38.06,0:30:41.11,общий текст,,0000,0000,0000,,Хэ Су выходит замуж за императора. Пожалуйста, остановите это
Dialogue: 0,0:30:44.16,0:30:46.89,общий текст,,0000,0000,0000,,Так он женится на ней?
Dialogue: 0,0:30:48.16,0:30:52.22,общий текст,,0000,0000,0000,,Вас, похоже, это не волнует. Потому что вы в родственных связях с ней?
Dialogue: 0,0:30:54.89,0:30:57.09,общий текст,,0000,0000,0000,,Кто может остановить свадьбу императора?
Dialogue: 0,0:30:57.09,0:30:58.98,общий текст,,0000,0000,0000,,Ты пытаешься прыгнуть выше головы
Dialogue: 0,0:30:59.90,0:31:03.69,общий текст,,0000,0000,0000,,Но это её дом принуждает Су к этому. Она даже не хочет выходить замуж
Dialogue: 0,0:31:03.69,0:31:05.18,общий текст,,0000,0000,0000,,Мама...
Dialogue: 0,0:31:05.18,0:31:06.77,курсив,,0000,0000,0000,,8-й принц здесь
Dialogue: 0,0:31:21.82,0:31:24.78,общий текст,,0000,0000,0000,,8-й принц приветствует вас, императрица Ю
Dialogue: 0,0:31:28.37,0:31:30.41,общий текст,,0000,0000,0000,,Что за неожиданный визит?
Dialogue: 0,0:31:31.63,0:31:34.07,общий текст,,0000,0000,0000,,- Ну...\N- Брат, вы пришли из-за Хэ Су?
Dialogue: 0,0:31:34.07,0:31:37.02,общий текст,,0000,0000,0000,,Вы видите? Это большая проблема
Dialogue: 0,0:31:37.02,0:31:39.21,общий текст,,0000,0000,0000,,Вы должны решить это, мама
Dialogue: 0,0:31:39.70,0:31:41.15,общий текст,,0000,0000,0000,,Я знаю, вы можете
Dialogue: 0,0:31:42.55,0:31:43.66,общий текст,,0000,0000,0000,,Ук
Dialogue: 0,0:31:44.98,0:31:47.31,общий текст,,0000,0000,0000,,Этот брак беспокоит тебя?
Dialogue: 0,0:31:47.31,0:31:48.57,общий текст,,0000,0000,0000,,Почему?
Dialogue: 0,0:31:52.00,0:31:55.43,общий текст,,0000,0000,0000,,Она мне как младшая сестра
Dialogue: 0,0:31:56.00,0:31:58.50,общий текст,,0000,0000,0000,,И это очень внезапно
Dialogue: 0,0:31:58.50,0:32:00.90,общий текст,,0000,0000,0000,,- Также...\N- Она кузина его мёртвой жены
Dialogue: 0,0:32:00.90,0:32:02.87,общий текст,,0000,0000,0000,,Конечно, он волнуется
Dialogue: 0,0:32:06.37,0:32:08.25,общий текст,,0000,0000,0000,,Это брак с императором
Dialogue: 0,0:32:09.22,0:32:11.29,общий текст,,0000,0000,0000,,Любопытно, почему же ты волнуешься за неё?
Dialogue: 0,0:32:16.60,0:32:17.82,общий текст,,0000,0000,0000,,Ваше высочество!
Dialogue: 0,0:32:30.67,0:32:31.97,общий текст,,0000,0000,0000,,Давайте
Dialogue: 0,0:32:31.97,0:32:34.76,общий текст,,0000,0000,0000,,Вы должны найти способ спасти Су
Dialogue: 0,0:32:34.76,0:32:37.78,общий текст,,0000,0000,0000,,Она вошла сюда сама. Пускай теперь терпит
Dialogue: 0,0:32:37.78,0:32:41.12,общий текст,,0000,0000,0000,,Если бы она сопротивлялась, нас бы всех убили
Dialogue: 0,0:32:41.12,0:32:44.63,общий текст,,0000,0000,0000,,Как бы там ни было, она могла сбежать, если бы захотела
Dialogue: 0,0:32:46.04,0:32:48.23,общий текст,,0000,0000,0000,,- Сейчас уже никто это не остановит\N- Брат!
Dialogue: 0,0:32:52.08,0:32:55.56,общий текст,,0000,0000,0000,,У тебя есть к ней чувства?
Dialogue: 0,0:32:55.96,0:32:57.19,общий текст,,0000,0000,0000,,Вот почему ты это делаешь?
Dialogue: 0,0:32:57.19,0:32:59.20,общий текст,,0000,0000,0000,,Чувства есть, но не у меня
Dialogue: 0,0:33:01.58,0:33:05.25,общий текст,,0000,0000,0000,,Но и для меня она особенная
Dialogue: 0,0:33:07.09,0:33:11.36,курсив,,0000,0000,0000,,После смерти Мён Хи, мы пили вместе каждый день
Dialogue: 0,0:33:11.91,0:33:16.86,воспоминания,,0000,0000,0000,,Если вам так нравилась сестра, почему не сказали ей?
Dialogue: 0,0:33:19.64,0:33:21.72,воспоминания,,0000,0000,0000,,Ну...
Dialogue: 0,0:33:22.28,0:33:25.24,воспоминания,,0000,0000,0000,,Ну, моя мама...
Dialogue: 0,0:33:26.42,0:33:28.79,воспоминания,,0000,0000,0000,,Она из королевской семьи Силлы, которая пала
Dialogue: 0,0:33:29.70,0:33:32.82,воспоминания,,0000,0000,0000,,Все мы принцы, но не все на одном уровне
Dialogue: 0,0:33:33.37,0:33:37.22,воспоминания,,0000,0000,0000,,Тогда твоя семья пользовалась высоким авторитетом
Dialogue: 0,0:33:38.17,0:33:40.72,воспоминания,,0000,0000,0000,,Я не был в состоянии просить о Мён Хи
Dialogue: 0,0:33:40.72,0:33:42.63,воспоминания,,0000,0000,0000,,Ну вот, опять!
Dialogue: 0,0:33:42.63,0:33:46.21,воспоминания,,0000,0000,0000,,Перестаньте говорить, будто можно завладеть человеком, и такое прочее
Dialogue: 0,0:33:46.21,0:33:49.74,воспоминания,,0000,0000,0000,,В этом месте людей принимают за собственность
Dialogue: 0,0:33:51.02,0:33:53.03,воспоминания,,0000,0000,0000,,Просто погодите тысячу лет
Dialogue: 0,0:33:53.03,0:33:55.23,воспоминания,,0000,0000,0000,,Вы не будете никому принадлежать
Dialogue: 0,0:33:55.27,0:33:57.73,воспоминания,,0000,0000,0000,,И вам принадлежать никто не будет
Dialogue: 0,0:33:57.73,0:33:59.11,воспоминания,,0000,0000,0000,,Принц? Пфф
Dialogue: 0,0:33:59.11,0:34:00.89,воспоминания,,0000,0000,0000,,Будь осторожна с тем, что говоришь
Dialogue: 0,0:34:00.89,0:34:03.30,воспоминания,,0000,0000,0000,,Да сколько той жизни?
Dialogue: 0,0:34:03.30,0:34:04.96,воспоминания,,0000,0000,0000,,- Вы всегда продолжаете и продолжаете...\N- Тихо
Dialogue: 0,0:34:04.96,0:34:09.44,воспоминания,,0000,0000,0000,,Статус - то, принц - сё...
Dialogue: 0,0:34:09.44,0:34:10.81,воспоминания,,0000,0000,0000,,Блин
Dialogue: 0,0:34:12.03,0:34:14.97,воспоминания,,0000,0000,0000,,Бэк А, слушай сюда
Dialogue: 0,0:34:15.94,0:34:20.98,воспоминания,,0000,0000,0000,,Можно жить хорошо, но ты всё равно однажды умрёшь
Dialogue: 0,0:34:20.98,0:34:23.82,воспоминания,,0000,0000,0000,,Ты можешь свалиться с неба
Dialogue: 0,0:34:23.85,0:34:27.06,воспоминания,,0000,0000,0000,,и закончить в таком вот месте
Dialogue: 0,0:34:29.27,0:34:32.63,воспоминания,,0000,0000,0000,,Так что следуй своему сердцу и живи
Dialogue: 0,0:34:33.13,0:34:36.17,воспоминания,,0000,0000,0000,,Делай, что хочешь и живи, как тебе хочется
Dialogue: 0,0:34:36.17,0:34:37.23,воспоминания,,0000,0000,0000,,Вот так!
Dialogue: 0,0:34:39.20,0:34:40.24,воспоминания,,0000,0000,0000,,О'кей?
Dialogue: 0,0:34:45.68,0:34:46.69,воспоминания,,0000,0000,0000,,О'кей?
Dialogue: 0,0:34:46.90,0:34:47.99,воспоминания,,0000,0000,0000,,О'кей
Dialogue: 0,0:34:48.72,0:34:52.06,общий текст,,0000,0000,0000,,Она так бездумно говорила, а ты просто слушал?
Dialogue: 0,0:34:52.06,0:34:53.42,общий текст,,0000,0000,0000,,Она не сказала ничего неправильного
Dialogue: 0,0:34:53.42,0:34:56.35,общий текст,,0000,0000,0000,,Посмотрите на Корё. Семейные связи и остальное
Dialogue: 0,0:34:56.35,0:34:59.69,общий текст,,0000,0000,0000,,Тебя принимают, только если ты красив и из богатой семьи
Dialogue: 0,0:34:59.69,0:35:01.60,общий текст,,0000,0000,0000,,Ты получаешь признание, если у тебя успешный брак
Dialogue: 0,0:35:02.31,0:35:04.79,общий текст,,0000,0000,0000,,Нас с вами не особо уважают
Dialogue: 0,0:35:05.09,0:35:07.25,общий текст,,0000,0000,0000,,Как же тяжело жить простым людям?
Dialogue: 0,0:35:07.25,0:35:08.29,общий текст,,0000,0000,0000,,И что?
Dialogue: 0,0:35:08.37,0:35:10.10,общий текст,,0000,0000,0000,,Ты хочешь свергнуть правителя?
Dialogue: 0,0:35:10.10,0:35:11.91,общий текст,,0000,0000,0000,,Ты собираешься изменить нацию?
Dialogue: 0,0:35:12.75,0:35:16.08,общий текст,,0000,0000,0000,,Я только хочу быть свободным
Dialogue: 0,0:35:16.28,0:35:19.24,общий текст,,0000,0000,0000,,Вы ведь тоже этого хотите. А Хэ Су?
Dialogue: 0,0:35:19.24,0:35:22.23,общий текст,,0000,0000,0000,,Как может девушка без родителей и родных выжить в этом месте?
Dialogue: 0,0:35:23.23,0:35:24.77,общий текст,,0000,0000,0000,,После сегодняшней ночи
Dialogue: 0,0:35:25.63,0:35:27.80,общий текст,,0000,0000,0000,,она даже не увидит императора
Dialogue: 0,0:35:29.82,0:35:33.53,общий текст,,0000,0000,0000,,Она задохнётся и умрёт
Dialogue: 0,0:35:49.62,0:35:52.84,общий текст,,0000,0000,0000,,Мы закончили ваш осмотр, теперь можете мыться
Dialogue: 0,0:35:52.84,0:35:54.73,общий текст,,0000,0000,0000,,Я хочу побыть одна
Dialogue: 0,0:35:54.73,0:35:57.68,общий текст,,0000,0000,0000,,Вы выходите замуж после захода солнца
Dialogue: 0,0:35:57.68,0:36:00.69,общий текст,,0000,0000,0000,,Император ждёт, так что... быстрее
Dialogue: 0,0:36:00.69,0:36:02.17,общий текст,,0000,0000,0000,,Отпустите меня!
Dialogue: 0,0:36:05.03,0:36:08.36,общий текст,,0000,0000,0000,,Ещё сегодняшним утром я не знала о том, что случится
Dialogue: 0,0:36:08.36,0:36:11.25,общий текст,,0000,0000,0000,,Мне нужно время, чтобы понять, что происходит
Dialogue: 0,0:36:12.99,0:36:16.62,общий текст,,0000,0000,0000,,Подождите здесь, я приготовлю вам ванну
Dialogue: 0,0:36:26.97,0:36:28.20,общий текст,,0000,0000,0000,,Свадьба?
Dialogue: 0,0:36:28.70,0:36:30.11,общий текст,,0000,0000,0000,,Разделим ложе?
Dialogue: 0,0:36:31.47,0:36:34.38,общий текст,,0000,0000,0000,,Нужно бежать, но куда?
Dialogue: 0,0:36:39.33,0:36:41.80,общий текст,,0000,0000,0000,,А, секретный туннель!
Dialogue: 0,0:36:42.23,0:36:44.02,общий текст,,0000,0000,0000,,Уверена, что вход здесь!
Dialogue: 0,0:37:25.01,0:37:26.34,общий текст,,0000,0000,0000,,Гордость?
Dialogue: 0,0:37:26.79,0:37:29.01,общий текст,,0000,0000,0000,,Мой отец принудил её к браку
Dialogue: 0,0:37:29.99,0:37:32.39,общий текст,,0000,0000,0000,,Кронпринц, спасите меня...
Dialogue: 0,0:37:32.39,0:37:33.94,общий текст,,0000,0000,0000,,Ты же так говорил?
Dialogue: 0,0:37:33.94,0:37:36.54,общий текст,,0000,0000,0000,,Кролик всегда роет два входа в норку
Dialogue: 0,0:37:37.19,0:37:39.34,общий текст,,0000,0000,0000,,Когда глупец стережёт передний вход,
Dialogue: 0,0:37:39.34,0:37:42.84,общий текст,,0000,0000,0000,,кролик выбежит через задний
Dialogue: 0,0:37:43.76,0:37:45.35,общий текст,,0000,0000,0000,,Чхве Чи Мон, которого я знал,
Dialogue: 0,0:37:45.35,0:37:47.89,общий текст,,0000,0000,0000,,никогда не сделал бы лишь один выход
Dialogue: 0,0:37:48.76,0:37:51.31,общий текст,,0000,0000,0000,,Он сделал бы два или ещё больше
Dialogue: 0,0:37:56.66,0:37:58.16,общий текст,,0000,0000,0000,,Поведай мне свой план
Dialogue: 0,0:38:09.54,0:38:10.87,общий текст,,0000,0000,0000,,Ваше величество
Dialogue: 0,0:38:10.87,0:38:13.60,общий текст,,0000,0000,0000,,Клан Хон Ха Чжин Хэ передали свою дочь Су
Dialogue: 0,0:38:13.60,0:38:15.20,общий текст,,0000,0000,0000,,Она готова к замужеству
Dialogue: 0,0:38:16.79,0:38:18.63,общий текст,,0000,0000,0000,,Вы сказали "Су"?
Dialogue: 0,0:38:20.69,0:38:23.95,общий текст,,0000,0000,0000,,Она, случайно, не кузина умершей жены моего 8-го сына?
Dialogue: 0,0:38:25.16,0:38:26.42,общий текст,,0000,0000,0000,,Верно
Dialogue: 0,0:38:28.88,0:38:31.59,общий текст,,0000,0000,0000,,Почему эта девочка?
Dialogue: 0,0:38:31.59,0:38:33.81,общий текст,,0000,0000,0000,,Эти люди полны жадности
Dialogue: 0,0:38:34.51,0:38:38.02,общий текст,,0000,0000,0000,,Вы бы хотели отменить свадьбу?
Dialogue: 0,0:38:42.68,0:38:44.98,общий текст,,0000,0000,0000,,Это будет очень трудно,
Dialogue: 0,0:38:44.98,0:38:47.66,общий текст,,0000,0000,0000,,да и где я найду другую подходящую девушку?
Dialogue: 0,0:38:49.53,0:38:50.83,общий текст,,0000,0000,0000,,Всё нормально, пойдёмте
Dialogue: 0,0:39:19.53,0:39:21.22,общий текст,,0000,0000,0000,,Разве это не Ук?
Dialogue: 0,0:39:27.33,0:39:31.86,общий текст,,0000,0000,0000,,Я осмелился прийти, чтобы кое-что обсудить с вами
Dialogue: 0,0:39:35.52,0:39:39.77,общий текст,,0000,0000,0000,,Такой умный парень преградил мне путь?
Dialogue: 0,0:39:42.52,0:39:46.52,общий текст,,0000,0000,0000,,У императорской семьи уже много родственников
Dialogue: 0,0:39:46.52,0:39:49.52,общий текст,,0000,0000,0000,,Могущественные кланы хотят держать императорскую семью под контролем
Dialogue: 0,0:39:51.12,0:39:55.90,общий текст,,0000,0000,0000,,Меня интересует то, почему вы хотите породниться с ещё одним кланом
Dialogue: 0,0:39:55.90,0:39:57.87,общий текст,,0000,0000,0000,,У меня есть хорошее оправдание
Dialogue: 0,0:39:58.41,0:40:02.80,общий текст,,0000,0000,0000,,Мне нужна помощь клана Хэ, чтобы остановить войну с киданями
Dialogue: 0,0:40:03.75,0:40:08.05,общий текст,,0000,0000,0000,,А ты по какой причине желаешь остановить мою свадьбу?
Dialogue: 0,0:40:14.81,0:40:15.83,общий текст,,0000,0000,0000,,Это...
Dialogue: 0,0:40:19.31,0:40:22.93,общий текст,,0000,0000,0000,,Что насчёт того, чтобы воспользоваться другим методом?
Dialogue: 0,0:40:27.93,0:40:29.85,общий текст,,0000,0000,0000,,Что вы себе позволяете?!
Dialogue: 0,0:40:29.85,0:40:31.03,курсив,,0000,0000,0000,,Ваше величество!
Dialogue: 0,0:40:31.03,0:40:34.71,курсив,,0000,0000,0000,,Пожалуйста, услышьте нас и остановите свадьбу
Dialogue: 0,0:40:36.98,0:40:39.71,общий текст,,0000,0000,0000,,Вам, видимо, жизнь ваша недорога!
Dialogue: 0,0:40:40.22,0:40:44.74,общий текст,,0000,0000,0000,,У меня есть свидетель, который подтвердит, что Хон Ха Чжин в сговоре с киданями
Dialogue: 0,0:40:47.19,0:40:48.75,общий текст,,0000,0000,0000,,Вы должны наказать его
Dialogue: 0,0:40:48.75,0:40:51.18,общий текст,,0000,0000,0000,,и выбрать суженую из другого клана
Dialogue: 0,0:40:51.78,0:40:54.77,общий текст,,0000,0000,0000,,Вы могли бы позволить клану Хэ быть магистратами своего города
Dialogue: 0,0:40:54.77,0:40:56.34,общий текст,,0000,0000,0000,,Примирение также возможно
Dialogue: 0,0:40:58.40,0:40:59.87,общий текст,,0000,0000,0000,,Вам не нужно жениться
Dialogue: 0,0:40:59.87,0:41:02.16,общий текст,,0000,0000,0000,,Есть другой способ укратить его силу
Dialogue: 0,0:41:03.13,0:41:05.65,общий текст,,0000,0000,0000,,Разве необходимо становиться родственниками?
Dialogue: 0,0:41:06.71,0:41:08.09,общий текст,,0000,0000,0000,,Министр
Dialogue: 0,0:41:08.09,0:41:09.58,общий текст,,0000,0000,0000,,Да, ваше величество?
Dialogue: 0,0:41:09.58,0:41:11.64,общий текст,,0000,0000,0000,,Я не отменю брак
Dialogue: 0,0:41:11.64,0:41:12.94,курсив,,0000,0000,0000,,Да, ваше величество
Dialogue: 0,0:41:12.94,0:41:17.02,общий текст,,0000,0000,0000,,Если я накажу его за сговор, как ты и сказал,
Dialogue: 0,0:41:17.88,0:41:21.22,общий текст,,0000,0000,0000,,отправка армии займёт день, границы государства будут нарушены
Dialogue: 0,0:41:22.23,0:41:24.85,общий текст,,0000,0000,0000,,Если преподам ему урок,
Dialogue: 0,0:41:24.85,0:41:28.68,общий текст,,0000,0000,0000,,не боитесь ли вы других могущественных кланов?!
Dialogue: 0,0:41:30.96,0:41:36.17,общий текст,,0000,0000,0000,,Во дворце искать причины действиям - это неправильно
Dialogue: 0,0:41:36.17,0:41:39.54,общий текст,,0000,0000,0000,,Нужно найти хорошее оправдание, чтобы остановить происходящее
Dialogue: 0,0:41:40.76,0:41:42.21,общий текст,,0000,0000,0000,,Поняли?
Dialogue: 0,0:41:43.36,0:41:44.91,общий текст,,0000,0000,0000,,А твоей причины
Dialogue: 0,0:41:46.60,0:41:47.85,общий текст,,0000,0000,0000,,недостаточно
Dialogue: 0,0:42:06.71,0:42:07.87,общий текст,,0000,0000,0000,,Су!
Dialogue: 0,0:42:15.09,0:42:16.46,общий текст,,0000,0000,0000,,Этой причины
Dialogue: 0,0:42:21.02,0:42:22.92,общий текст,,0000,0000,0000,,будет достаточно
Dialogue: 0,0:42:26.07,0:42:27.18,общий текст,,0000,0000,0000,,Что?
Dialogue: 0,0:42:28.52,0:42:32.42,общий текст,,0000,0000,0000,,Если на теле... будет шрам...
Dialogue: 0,0:42:33.17,0:42:36.52,общий текст,,0000,0000,0000,,Я не смогу стать женой правителя
Dialogue: 0,0:42:39.66,0:42:43.20,общий текст,,0000,0000,0000,,Поэтому, ваше величество, остановитесь
Dialogue: 0,0:42:44.32,0:42:46.27,общий текст,,0000,0000,0000,,Отпустите меня, прошу
Dialogue: 0,0:43:09.45,0:43:11.65,общий текст,,0000,0000,0000,,Ты бесстрашнее любого мужчины
Dialogue: 0,0:43:15.00,0:43:17.48,общий текст,,0000,0000,0000,,Приведите Хон Ха Чжина из клана Хэ
Dialogue: 0,0:43:17.48,0:43:19.10,общий текст,,0000,0000,0000,,Да, ваше величество
Dialogue: 0,0:43:23.27,0:43:24.46,общий текст,,0000,0000,0000,,Су!
Dialogue: 0,0:43:28.48,0:43:29.66,общий текст,,0000,0000,0000,,Су!
Dialogue: 0,0:43:36.48,0:43:37.57,общий текст,,0000,0000,0000,,Су...
Dialogue: 0,0:43:43.93,0:43:45.12,общий текст,,0000,0000,0000,,Су!
Dialogue: 0,0:43:45.12,0:43:47.37,общий текст,,0000,0000,0000,,- Су!\N- Сестра, сестра!
Dialogue: 0,0:43:47.37,0:43:48.96,общий текст,,0000,0000,0000,,Зовите лекаря!
Dialogue: 0,0:43:50.89,0:43:52.05,общий текст,,0000,0000,0000,,Скорее!
Dialogue: 0,0:43:52.05,0:43:53.45,общий текст,,0000,0000,0000,,Су! Скорее!
Dialogue: 0,0:43:53.45,0:43:55.46,курсив,,0000,0000,0000,,Ты как?!
Dialogue: 0,0:44:12.29,0:44:14.62,мысли,,0000,0000,0000,,Где это я?
Dialogue: 0,0:44:15.69,0:44:20.12,мысли,,0000,0000,0000,,Да, я умерла, но это не так
Dialogue: 0,0:44:20.91,0:44:23.94,мысли,,0000,0000,0000,,Корё... Тхэджо Ван Гон
Dialogue: 0,0:44:24.26,0:44:26.16,мысли,,0000,0000,0000,,Кванджон?
Dialogue: 0,0:44:26.94,0:44:29.64,мысли,,0000,0000,0000,,Кое-что о Кванджоне беспокоит меня
Dialogue: 0,0:44:30.41,0:44:32.64,мысли,,0000,0000,0000,,Я что-то забыла
Dialogue: 0,0:44:35.06,0:44:37.99,мысли,,0000,0000,0000,,Четвёртый император Корё - Кванджон
Dialogue: 0,0:44:37.99,0:44:40.97,мысли,,0000,0000,0000,,Да, он четвёртый правитель
Dialogue: 0,0:44:41.52,0:44:45.18,мысли,,0000,0000,0000,,Он убивал своих братьев и подданных
Dialogue: 0,0:44:45.18,0:44:47.52,мысли,,0000,0000,0000,,Четвёртый император Корё - Кванджон
Dialogue: 0,0:44:48.44,0:44:50.29,мысли,,0000,0000,0000,,Кто он?
Dialogue: 0,0:44:50.29,0:44:52.70,мысли,,0000,0000,0000,,Какой из принцев?
Dialogue: 0,0:44:52.70,0:44:53.87,мысли,,0000,0000,0000,,Неужели...
Dialogue: 0,0:45:05.04,0:45:06.72,общий текст,,0000,0000,0000,,Нет...
Dialogue: 0,0:45:08.25,0:45:09.80,общий текст,,0000,0000,0000,,Да
Dialogue: 0,0:45:09.80,0:45:12.10,общий текст,,0000,0000,0000,,Вы не умерли, а выжили
Dialogue: 0,0:45:13.80,0:45:15.92,общий текст,,0000,0000,0000,,И вы не замужем
Dialogue: 0,0:45:15.92,0:45:18.33,общий текст,,0000,0000,0000,,Поэтому я наблюдаю за вами вместо лекаря
Dialogue: 0,0:45:23.37,0:45:25.98,общий текст,,0000,0000,0000,,Это дворец, да?
Dialogue: 0,0:45:28.18,0:45:31.62,общий текст,,0000,0000,0000,,Поскольку вы не умерли, вы ещё во дворце
Dialogue: 0,0:45:34.08,0:45:38.75,общий текст,,0000,0000,0000,,Говорите, что должна умереть, чтобы покинуть это место?
Dialogue: 0,0:45:41.71,0:45:45.32,общий текст,,0000,0000,0000,,Лекарь сказал, что рана глубокая, останется шрам
Dialogue: 0,0:45:48.50,0:45:50.38,общий текст,,0000,0000,0000,,Я этого ожидала
Dialogue: 0,0:45:52.41,0:45:54.74,общий текст,,0000,0000,0000,,Так сильно не хотите быть женой правителя?
Dialogue: 0,0:45:55.70,0:45:58.35,общий текст,,0000,0000,0000,,Вы бы имели всё, что пожелаете
Dialogue: 0,0:45:59.73,0:46:04.75,общий текст,,0000,0000,0000,,Не важно то, как я буду жить,\N я хочу иметь право выбора
Dialogue: 0,0:46:06.31,0:46:09.14,общий текст,,0000,0000,0000,,Так думают люди, когда они молоды
Dialogue: 0,0:46:12.88,0:46:15.61,общий текст,,0000,0000,0000,,Вас скоро накажут
Dialogue: 0,0:46:15.61,0:46:17.92,общий текст,,0000,0000,0000,,Будьте готовы к этому
Dialogue: 0,0:46:19.19,0:46:20.78,общий текст,,0000,0000,0000,,Я не пожалею
Dialogue: 0,0:46:22.74,0:46:24.72,общий текст,,0000,0000,0000,,Я защищала то, что хотела
Dialogue: 0,0:46:26.47,0:46:27.86,общий текст,,0000,0000,0000,,Теперь буду платить
Dialogue: 0,0:46:35.53,0:46:36.92,общий текст,,0000,0000,0000,,Тогда отдыхайте
Dialogue: 0,0:47:54.92,0:47:56.74,общий текст,,0000,0000,0000,,Теперь всё будет хорошо
Dialogue: 0,0:47:59.18,0:48:00.45,общий текст,,0000,0000,0000,,Всё закончилось
Dialogue: 0,0:48:03.76,0:48:04.96,общий текст,,0000,0000,0000,,Император...
Dialogue: 0,0:48:08.38,0:48:09.46,общий текст,,0000,0000,0000,,Из-за...
Dialogue: 0,0:48:16.37,0:48:19.39,общий текст,,0000,0000,0000,,Из-за твоего шрама он отменил свадьбу
Dialogue: 0,0:48:23.05,0:48:24.08,общий текст,,0000,0000,0000,,Твой клан...
Dialogue: 0,0:48:25.16,0:48:29.50,общий текст,,0000,0000,0000,,Было установлено, что они пошли против интересов нации
Dialogue: 0,0:48:30.79,0:48:33.15,общий текст,,0000,0000,0000,,Больше они не окажут на тебя давления
Dialogue: 0,0:48:45.06,0:48:46.71,общий текст,,0000,0000,0000,,Прошлой ночью...
Dialogue: 0,0:48:49.52,0:48:51.00,общий текст,,0000,0000,0000,,Я чувствовал себя жалким
Dialogue: 0,0:48:54.04,0:48:55.40,общий текст,,0000,0000,0000,,Жалким
Dialogue: 0,0:48:59.62,0:49:02.50,общий текст,,0000,0000,0000,,И ещё раз жалким, просто жалким
Dialogue: 0,0:49:06.02,0:49:09.02,общий текст,,0000,0000,0000,,Я подумал, что был плохим человеком
Dialogue: 0,0:49:12.39,0:49:14.27,общий текст,,0000,0000,0000,,И молился своей покойной жене
Dialogue: 0,0:49:17.23,0:49:19.04,общий текст,,0000,0000,0000,,Сказал, что если ты вернёшься,
Dialogue: 0,0:49:23.82,0:49:27.52,общий текст,,0000,0000,0000,,я отплачу ей тем, что дам тебе те тёплые чувства, что не дал ей
Dialogue: 0,0:49:29.46,0:49:31.86,общий текст,,0000,0000,0000,,Я просил её о прощении и о том, чтобы вернула тебя мне
Dialogue: 0,0:49:34.16,0:49:35.30,общий текст,,0000,0000,0000,,Умолял
Dialogue: 0,0:49:41.41,0:49:43.69,общий текст,,0000,0000,0000,,Если бы ты стала женщиной императора,
Dialogue: 0,0:49:43.69,0:49:49.10,общий текст,,0000,0000,0000,,я бы никогда... не смог простить себя
Dialogue: 0,0:49:52.12,0:49:53.80,общий текст,,0000,0000,0000,,Я думала,
Dialogue: 0,0:49:55.89,0:49:58.22,общий текст,,0000,0000,0000,,что больше не увижу вас
Dialogue: 0,0:50:02.55,0:50:05.19,общий текст,,0000,0000,0000,,Даже не смогла бы попрощаться с вами
Dialogue: 0,0:50:06.97,0:50:11.60,общий текст,,0000,0000,0000,,Я не думаю, что было бы правильно вот так вот расстаться
Dialogue: 0,0:50:12.91,0:50:13.96,общий текст,,0000,0000,0000,,Так что...
Dialogue: 0,0:50:26.22,0:50:28.04,общий текст,,0000,0000,0000,,Такого больше не повторится
Dialogue: 0,0:50:29.10,0:50:30.67,общий текст,,0000,0000,0000,,Однажды я потерял тебя,
Dialogue: 0,0:50:32.65,0:50:35.61,общий текст,,0000,0000,0000,,но больше такого не случится, поэтому
Dialogue: 0,0:50:39.13,0:50:40.54,общий текст,,0000,0000,0000,,всё хорошо
Dialogue: 0,0:50:43.88,0:50:45.24,общий текст,,0000,0000,0000,,Всё будет хорошо, Су
Dialogue: 0,0:50:49.72,0:50:51.02,общий текст,,0000,0000,0000,,Хорошо
Dialogue: 0,0:51:01.02,0:51:04.98,общий текст,,0000,0000,0000,,Ваше величество, звёзды скрылись, солнце скоро взойдёт
Dialogue: 0,0:51:04.98,0:51:08.79,общий текст,,0000,0000,0000,,Вы должны немного поспать, чтобы сохранить трон
Dialogue: 0,0:51:08.79,0:51:10.12,общий текст,,0000,0000,0000,,Ладно
Dialogue: 0,0:51:13.56,0:51:14.86,общий текст,,0000,0000,0000,,Ваше величество
Dialogue: 0,0:51:14.86,0:51:17.71,общий текст,,0000,0000,0000,,Вы уже решили, что делать с кланом Хэ?
Dialogue: 0,0:51:22.84,0:51:26.26,общий текст,,0000,0000,0000,,Хоть я и чувствую жалость к ней,\N но я не могу переступать через закон
Dialogue: 0,0:51:28.36,0:51:30.24,общий текст,,0000,0000,0000,,Сделайте её рабыней
Dialogue: 0,0:51:32.19,0:51:34.64,общий текст,,0000,0000,0000,,Почему бы просто не позволить ей стать служанкой во дворце?
Dialogue: 0,0:51:34.64,0:51:37.31,общий текст,,0000,0000,0000,,И императрице Ю, и королеве Хванбо понадобится
Dialogue: 0,0:51:37.31,0:51:41.85,общий текст,,0000,0000,0000,,Даже супруга Кванджувон спрашивала о Хэ
Dialogue: 0,0:51:41.85,0:51:44.39,общий текст,,0000,0000,0000,,Я уверен, дети попросили об этом
Dialogue: 0,0:51:45.68,0:51:48.55,общий текст,,0000,0000,0000,,В каких она отношениях с принцами?
Dialogue: 0,0:51:48.55,0:51:51.30,общий текст,,0000,0000,0000,,Даже 8-й и 4-й вовлечены
Dialogue: 0,0:51:54.31,0:51:56.65,общий текст,,0000,0000,0000,,Не хочу раздувать из этого проблему
Dialogue: 0,0:51:56.65,0:51:58.32,общий текст,,0000,0000,0000,,Но...
Dialogue: 0,0:51:59.72,0:52:02.31,общий текст,,0000,0000,0000,,Наложница О из дворца Дамивон также подала прошение
Dialogue: 0,0:52:06.23,0:52:07.38,общий текст,,0000,0000,0000,,Дамивон?
Dialogue: 0,0:52:07.38,0:52:11.27,общий текст,,0000,0000,0000,,Я слышал, что Хэ Су проявляет интерес к лекарственным травам и красит женщин
Dialogue: 0,0:52:11.27,0:52:12.56,общий текст,,0000,0000,0000,,Они говорят, что она многое умеет
Dialogue: 0,0:52:12.56,0:52:15.08,общий текст,,0000,0000,0000,,Я верю, что она принесёт большую пользу императорской семье,
Dialogue: 0,0:52:15.08,0:52:16.44,общий текст,,0000,0000,0000,,если мы оставим её с наложницей О
Dialogue: 0,0:52:22.33,0:52:24.05,общий текст,,0000,0000,0000,,Где она сейчас?
Dialogue: 0,0:53:09.31,0:53:13.14,мысли,,0000,0000,0000,,Я бы хотела повидаться с сестрой
Dialogue: 0,0:53:14.20,0:53:16.39,мысли,,0000,0000,0000,,Хорошо, пошли вместе
Dialogue: 0,0:53:16.39,0:53:18.76,мысли,,0000,0000,0000,,Она попросила меня присматривать за тобой
Dialogue: 0,0:53:18.76,0:53:22.66,мысли,,0000,0000,0000,,Она будет счастлива, если мы придём вместе
Dialogue: 0,0:53:56.53,0:53:58.31,курсив,,0000,0000,0000,,Этого достаточно, чтобы отменить свадьбу
Dialogue: 0,0:53:58.31,0:54:01.16,курсив,,0000,0000,0000,,Почему она должна быть служанкой?
Dialogue: 0,0:54:01.16,0:54:03.71,общий текст,,0000,0000,0000,,Всё же, это счастье, что она избежала наказания
Dialogue: 0,0:54:03.71,0:54:05.92,общий текст,,0000,0000,0000,,Она могла стать рабыней
Dialogue: 0,0:54:05.92,0:54:07.31,общий текст,,0000,0000,0000,,Да
Dialogue: 0,0:54:07.31,0:54:09.36,общий текст,,0000,0000,0000,,Мне всё равно некуда идти
Dialogue: 0,0:54:09.36,0:54:11.07,общий текст,,0000,0000,0000,,Я слышала, что служанкам платят
Dialogue: 0,0:54:11.07,0:54:13.34,общий текст,,0000,0000,0000,,Это хорошо, что я смогу содержать себя
Dialogue: 0,0:54:13.34,0:54:14.80,общий текст,,0000,0000,0000,,Верно
Dialogue: 0,0:54:14.80,0:54:18.58,общий текст,,0000,0000,0000,,Вы из благородной семьи, поэтому к вам даже там будут относиться по-особенному
Dialogue: 0,0:54:18.58,0:54:22.39,общий текст,,0000,0000,0000,,Если будете хорошо работать, император разрешит вам выйти замуж
Dialogue: 0,0:54:22.39,0:54:24.64,общий текст,,0000,0000,0000,,Он также может отпускать вас в путешествия, так что работайте не покладая рук
Dialogue: 0,0:54:24.64,0:54:26.61,общий текст,,0000,0000,0000,,Путешествия? Правда?!
Dialogue: 0,0:54:26.61,0:54:28.11,общий текст,,0000,0000,0000,,Да
Dialogue: 0,0:54:28.11,0:54:31.32,общий текст,,0000,0000,0000,,Госпожа Су. Не пора ли нам?
Dialogue: 0,0:54:38.13,0:54:41.60,общий текст,,0000,0000,0000,,Думаю, первое время мне будет сложно видеться с сестрой
Dialogue: 0,0:54:45.54,0:54:47.11,общий текст,,0000,0000,0000,,Как и сказал Чхве Чи Мон,
Dialogue: 0,0:54:47.11,0:54:49.02,общий текст,,0000,0000,0000,,это счастье, что ты избежала наказания
Dialogue: 0,0:54:51.18,0:54:53.27,общий текст,,0000,0000,0000,,Не беспокойся сильно
Dialogue: 0,0:54:54.03,0:54:55.74,общий текст,,0000,0000,0000,,Я не беспокоюсь
Dialogue: 0,0:54:55.74,0:54:59.60,общий текст,,0000,0000,0000,,Нет ничего, что я не смогла бы сделать. Я умная
Dialogue: 0,0:54:59.60,0:55:01.63,общий текст,,0000,0000,0000,,И учусь очень быстро
Dialogue: 0,0:55:02.49,0:55:05.01,общий текст,,0000,0000,0000,,Я стану человеком, в котором нуждаются
Dialogue: 0,0:55:05.93,0:55:07.27,общий текст,,0000,0000,0000,,Вы же знаете
Dialogue: 0,0:55:44.41,0:55:48.08,общий текст,,0000,0000,0000,,Я буду навещать тебя каждый день
Dialogue: 0,0:55:56.02,0:55:57.30,общий текст,,0000,0000,0000,,Су!
Dialogue: 0,0:55:57.73,0:55:59.96,общий текст,,0000,0000,0000,,- Сестрёнка!\N- Су!
Dialogue: 0,0:56:04.51,0:56:06.91,общий текст,,0000,0000,0000,,Су! Су!
Dialogue: 0,0:56:06.91,0:56:08.65,курсив,,0000,0000,0000,,Ну-ка, подвинься!
Dialogue: 0,0:56:08.65,0:56:11.64,курсив,,0000,0000,0000,,Су, я думал, ты умерла
Dialogue: 0,0:56:12.14,0:56:14.58,общий текст,,0000,0000,0000,,Она бы так легко не умерла
Dialogue: 0,0:56:15.05,0:56:18.12,курсив,,0000,0000,0000,,Сестра, я пробовал всё, что мог, чтобы спасти тебя
Dialogue: 0,0:56:18.12,0:56:20.19,общий текст,,0000,0000,0000,,Это судьба
Dialogue: 0,0:56:20.19,0:56:23.05,курсив,,0000,0000,0000,,Да? Спасибо, что волновались
Dialogue: 0,0:56:23.40,0:56:25.21,общий текст,,0000,0000,0000,,Перестань заставлять людей волноваться
Dialogue: 0,0:56:25.21,0:56:27.24,общий текст,,0000,0000,0000,,Как ты могла сделать такое со своим телом?
Dialogue: 0,0:56:28.68,0:56:30.09,общий текст,,0000,0000,0000,,Прекращайте
Dialogue: 0,0:56:30.09,0:56:33.54,общий текст,,0000,0000,0000,,Если вымотаете её в первый же день, наложница О рада не будет
Dialogue: 0,0:56:33.54,0:56:35.09,общий текст,,0000,0000,0000,,Да, не будет
Dialogue: 0,0:56:35.09,0:56:36.46,общий текст,,0000,0000,0000,,Наложница О такая пугающая
Dialogue: 0,0:56:36.46,0:56:38.62,общий текст,,0000,0000,0000,,Я буду часто навещать тебя, не волнуйся
Dialogue: 0,0:56:39.32,0:56:41.25,мысли,,0000,0000,0000,,Он один из этих двоих или троих...
Dialogue: 0,0:56:41.25,0:56:43.17,мысли,,0000,0000,0000,,Следующий император здесь
Dialogue: 0,0:56:44.56,0:56:45.69,мысли,,0000,0000,0000,,Кто это?
Dialogue: 0,0:56:46.30,0:56:49.13,мысли,,0000,0000,0000,,Кто же станет Кванджоном и убьёт своих братьев?
Dialogue: 0,0:56:50.24,0:56:53.28,мысли,,0000,0000,0000,,Нет. Этого не может быть
Dialogue: 0,0:56:59.39,0:57:00.91,мысли,,0000,0000,0000,,Неужели...
Dialogue: 0,0:57:08.67,0:57:11.49,общий текст,,0000,0000,0000,,Твоя жизнь весьма интересна
Dialogue: 0,0:57:11.49,0:57:13.65,общий текст,,0000,0000,0000,,Сколько раз ты чуть не погибла?
Dialogue: 0,0:57:13.65,0:57:16.42,общий текст,,0000,0000,0000,,В следующий раз ты точно умрёшь
Dialogue: 0,0:57:16.42,0:57:17.58,общий текст,,0000,0000,0000,,- Хватит!\N- Хватит!
Dialogue: 0,0:57:18.57,0:57:19.99,общий текст,,0000,0000,0000,,Хватит!
Dialogue: 0,0:57:20.77,0:57:22.28,общий текст,,0000,0000,0000,,Пойдёмте, госпожа Су
Dialogue: 0,0:57:22.28,0:57:24.45,общий текст,,0000,0000,0000,,Нам пора уходить отсюда
Dialogue: 0,0:57:24.45,0:57:26.19,общий текст,,0000,0000,0000,,Императорская наложница О ждёт
Dialogue: 0,0:57:35.41,0:57:37.18,общий текст,,0000,0000,0000,,Су, файтин!
Dialogue: 0,0:57:47.78,0:57:50.31,общий текст,,0000,0000,0000,,Ничего не бойся, ладно?
Dialogue: 0,0:57:58.74,0:57:59.97,общий текст,,0000,0000,0000,,Сестра!
Dialogue: 0,0:59:36.90,0:59:39.65,в следующей серии,,0000,0000,0000,,Ты сможешь жить так до конца своих дней?
Dialogue: 0,0:59:39.65,0:59:41.15,в следующей серии,,0000,0000,0000,,Это единственный шанс
Dialogue: 0,0:59:41.15,0:59:42.48,в следующей серии,,0000,0000,0000,,стать императором
Dialogue: 0,0:59:42.48,0:59:43.85,в следующей серии,,0000,0000,0000,,Я тоже принц
Dialogue: 0,0:59:43.85,0:59:45.98,в следующей серии,,0000,0000,0000,,Тоже должен знать, как управляют государством
Dialogue: 0,0:59:45.98,0:59:47.63,в следующей серии,,0000,0000,0000,,Как следует подумай об этом
Dialogue: 0,0:59:47.63,0:59:49.40,в следующей серии,,0000,0000,0000,,Об истинной причине
Dialogue: 0,0:59:51.85,0:59:53.01,в следующей серии,,0000,0000,0000,,Что ты творишь?!
Dialogue: 0,0:59:53.01,0:59:54.23,в следующей серии,,0000,0000,0000,,По-вашему, мы на свиней похожи?
Dialogue: 0,0:59:54.23,0:59:54.86,в следующей серии,,0000,0000,0000,,Что?
Dialogue: 0,0:59:54.86,0:59:56.93,в следующей серии,,0000,0000,0000,,Спасибо, что стал моим лучшим другом
Dialogue: 0,0:59:56.93,0:59:59.26,в следующей серии,,0000,0000,0000,,Даже наследный принц заботится о ней
Dialogue: 0,0:59:59.26,1:00:01.08,в следующей серии,,0000,0000,0000,,Она и правда счастливица
Dialogue: 0,1:00:01.08,1:00:03.56,в следующей серии,,0000,0000,0000,,Я сделаю все, чтобы вернуть тебя обратно
Dialogue: 0,1:00:03.56,1:00:06.72,в следующей серии,,0000,0000,0000,,Я знаю о ваших чувствах, поэтому, пожалуйста, не беспокойтесь
Dialogue: 0,1:00:06.72,1:00:07.62,в следующей серии,,0000,0000,0000,,Жди меня
Dialogue: 0,1:00:07.62,1:00:10.68,в следующей серии,,0000,0000,0000,,Даже слова "жди меня" могут сделать человека счастливым
Dialogue: 0,1:00:10.94,1:00:12.16,в следующей серии,,0000,0000,0000,,Ты могла умереть
Dialogue: 0,1:00:12.16,1:00:13.32,в следующей серии,,0000,0000,0000,,Впредь так не делай,
Dialogue: 0,1:00:13.32,1:00:15.57,в следующей серии,,0000,0000,0000,,иначе не прощу тебя
Dialogue: 0,0:52:27.24,0:52:29.52,песня 4 davichi,,0000,0000,0000,,{\k38}При {\k24}ви{\k29}де {\k23}те{\k49}бя {\k65}я
Dialogue: 0,0:52:31.02,0:52:34.33,песня 4 davichi,,0000,0000,0000,,{\k36}Ды{\k27}шать {\k26}не {\k28}мо{\k41}гу, {\k46}ро{\k42}бе{\k85}ю
Dialogue: 0,0:52:34.52,0:52:38.12,песня 4 davichi,,0000,0000,0000,,{\k17}Как {\k26}буд{\k28}то {\k33}всё{\k43} в ми{\k64}ре {\k38}за{\k47}мер{\k64}ло
Dialogue: 0,0:52:40.42,0:52:45.02,песня 4 davichi,,0000,0000,0000,,{\k51}Ес{\k38}ли {\k51}ми{\k24}мо {\k37}прой{\k80}ду, {\k15}как {\k43}ве{\k34}те{\k109}рок, {\k0}
Dialogue: 0,0:52:45.02,0:52:48.12,песня 4 davichi,,0000,0000,0000,,{\k23}да{\k29}же {\k23}и {\k62}не {\k47}за{\k42}ме{\k62}тишь
Dialogue: 0,0:52:48.82,0:52:53.42,песня 4 davichi,,0000,0000,0000,,{\k48}Серд{\k39}це {\k65}моё {\k37}всё {\k55}от{\k43}да{\k35}но {\k33}те{\k105}бе
Dialogue: 0,0:52:55.32,0:53:01.42,песня 4 davichi,,0000,0000,0000,,{\k52}Но {\k19}лю{\k15}бить {\k27}те{\k34}бя {\k27}ведь {\k21}о{\k79}чень {\k47}боль{\k32}но {\k68}для {\k43}ме{\k146}ня
Dialogue: 0,0:53:01.42,0:53:03.62,песня 4 davichi,,0000,0000,0000,,{\k46}И {\k38}так {\k34}пе{\k42}чаль{\k60}но
Dialogue: 0,0:53:03.62,0:53:08.12,песня 4 davichi,,0000,0000,0000,,{\k55}С серд{\k25}ца {\k26}сво{\k26}е{\k32}го {\k74}мне вы{\k37}черк{\k58}нуть {\k27}те{\k90}бя
Dialogue: 0,0:53:09.42,0:53:11.02,песня 4 davichi,,0000,0000,0000,,{\k59}так {\k40}труд{\k61}но
Dialogue: 0,0:53:13.22,0:53:17.32,песня 4 davichi,,0000,0000,0000,,{\k33}Не {\k54}за{\k66}будь {\k79}ты, {\k42}про{\k116}шу!
Dialogue: 0,0:53:18.19,0:53:22.62,песня 4 davichi,,0000,0000,0000,,{\k26}Ту {\k48}веч{\k20}ну{\k74}ю {\k31}лю{\k138}бовь {\k40}мо{\k66}ю
Dialogue: 0,0:53:24.79,0:53:30.89,песня 4 davichi,,0000,0000,0000,,{\k52}Но {\k19}лю{\k15}бить {\k27}те{\k34}бя {\k27}ведь {\k21}о{\k79}чень {\k47}боль{\k32}но {\k68}для {\k43}ме{\k146}ня
Dialogue: 0,0:53:30.89,0:53:33.09,песня 4 davichi,,0000,0000,0000,,{\k46}И {\k38}так {\k34}пе{\k42}чаль{\k60}но
Dialogue: 0,0:53:33.09,0:53:38.19,песня 4 davichi,,0000,0000,0000,,{\k55}С серд{\k25}ца {\k26}сво{\k26}е{\k32}го {\k74}мне вы{\k37}черк{\k58}нуть {\k27}те{\k90}бя
Dialogue: 0,0:53:42.92,0:53:46.41,песня 4 davichi,,0000,0000,0000,,{\k50}Ве{\k42}рю {\k70}я, {\k75}ког{\k37}да-{\k75}то
Dialogue: 0,0:53:47.61,0:53:51.21,песня 4 davichi,,0000,0000,0000,,{\k49}как {\k36}я {\k35}хо{\k59}чу {\k55}лю{\k126}бить
Dialogue: 0,0:53:52.96,0:53:54.41,песня 4 davichi,,0000,0000,0000,,{\k41}смо{\k104}гу
Dialogue: 0,0:59:27.16,0:59:33.49,кредиты конец 2,,0000,0000,0000,,Спасибо, что смотрели с нами!\NРелиз-группа МАНИЯ{\fs53.002}
Dialogue: 0,0:59:27.16,0:59:33.49,кредиты конец,,0000,0000,0000,,{\pos(648,647)}{\fs53.002}\Nhttp://doramamania.mybb.ru\Nhttp://vk.com/doramamania
