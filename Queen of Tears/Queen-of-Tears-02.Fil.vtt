Dialogue: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialogue: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialogue: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialogue: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialogue: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialogue: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialogue: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialogue: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Screenwriter: Park Ji-eun{\c}{\i0}
Dialogue: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mga Direktor: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialogue: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,0:01:02.93,0:01:04.62,Default,,0,0,0,,{\an8}Well, I...
Dialogue: 0,0:01:04.64,0:01:07.41,Default,,0,0,0,,{\an8}So ano...?
Dialogue: 0,0:01:07.44,0:01:08.66,Default,,0,0,0,,{\an8}Oo?
Dialogue: 0,0:01:08.69,0:01:11.52,Default,,0,0,0,,{\an8}...Gusto kong sabihin ay...
Dialogue: 0,0:01:13.07,0:01:14.77,Default,,0,0,0,,{\an8}I...
Dialogue: 0,0:01:15.70,0:01:18.44,Default,,0,0,0,,{\an8}- Oo?\N- "I'm sorry."
Dialogue: 0,0:01:20.74,0:01:23.61,Default,,0,0,0,,{\an8}"Tungkol sa ngayon,"
Dialogue: 0,0:01:23.79,0:01:27.35,Default,,0,0,0,,{\an8}"at lahat ng nagawa ko hanggang ngayon."
Dialogue: 0,0:01:27.37,0:01:31.40,Default,,0,0,0,,{\an8}"Hindi na ito mauulit.\NI'll treat you better."
Dialogue: 0,0:01:31.42,0:01:34.91,Default,,0,0,0,,{\an8}Iyon ang gusto ko...
Dialogue: 0,0:01:35.67,0:01:36.86,Default,,0,0,0,,{\an8}upang sabihin,
Dialogue: 0,0:01:36.88,0:01:39.15,Default,,0,0,0,,{\an8}pero may tatlong buwan ka na lang para mabuhay?
Dialogue: 0,0:01:39.18,0:01:40.86,Default,,0,0,0,,Paano ito posible?
Dialogue: 0,0:01:40.89,0:01:44.05,Default,,0,0,0,,Paano ako mabubuhay kung wala ka?
Dialogue: 0,0:01:45.14,0:01:46.88,Default,,0,0,0,,Paano ito posible?
Dialogue: 0,0:01:46.98,0:01:49.62,Default,,0,0,0,,Natulala ako,
Dialogue: 0,0:01:49.65,0:01:51.89,Default,,0,0,0,,Hindi ko alam kung ano ang sasabihin.
Dialogue: 0,0:01:56.44,0:01:57.67,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:01:57.70,0:02:00.52,Default,,0,0,0,,Oo, tanga.
Dialogue: 0,0:02:09.46,0:02:11.66,Default,,0,0,0,,Mahal kita, Hong Hae-in.
Dialogue: 0,0:02:13.75,0:02:15.58,Default,,0,0,0,,Mahal kita.
Dialogue: 0,0:02:15.96,0:02:18.87,Default,,0,0,0,,Kung hindi mo kayang mabuhay ng wala ako...
Dialogue: 0,0:02:19.22,0:02:20.92,Default,,0,0,0,,Oo?
Dialogue: 0,0:02:21.97,0:02:23.57,Default,,0,0,0,,Gusto mo bang mamatay nang magkasama?
Dialogue: 0,0:02:29.06,0:02:31.35,Default,,0,0,0,,Sabi mo hindi mo kayang mabuhay ng wala ako.
Dialogue: 0,0:02:31.86,0:02:36.85,Default,,0,0,0,,Hindi ko ibig sabihin na sigurado akong\NI ay hindi mabubuhay kung wala ka.
Dialogue: 0,0:02:36.90,0:02:39.44,Default,,0,0,0,,Nagtataka lang ako...
Dialogue: 0,0:02:40.45,0:02:42.93,Default,,0,0,0,,kung posible na gawin iyon. Na-curious ako.
Dialogue: 0,0:02:42.95,0:02:46.36,Default,,0,0,0,,Eksakto. Kung ganoon ay dapat na lang tayong mamatay nang magkasama.
Dialogue: 0,0:02:46.58,0:02:51.27,Default,,0,0,0,,Ito ay isang opisyal na bagay noong\Naraw. Tinawag itong "sunjang."
Dialogue: 0,0:02:51.29,0:02:53.41,Default,,0,0,0,,Inilibing ka nila kasama ng iyong asawa.
Dialogue: 0,0:02:53.71,0:02:55.35,Default,,0,0,0,,Tama.
Dialogue: 0,0:02:55.38,0:02:57.31,Default,,0,0,0,,{\i1}Sunjang.{\i0}
Dialogue: 0,0:02:57.34,0:03:00.29,Default,,0,0,0,,Oo, {\i1}sunjang.{\i0}
Dialogue: 0,0:03:00.93,0:03:04.49,Default,,0,0,0,,Maaari mo akong tratuhin sa kabilang buhay.
Dialogue: 0,0:03:04.51,0:03:06.05,Default,,0,0,0,,Hindi ito masama.
Dialogue: 0,0:03:08.68,0:03:12.00,Default,,0,0,0,,Palagi kang magaling\Nat gumagawa ng nakakatakot na biro...
Dialogue: 0,0:03:12.02,0:03:13.97,Default,,0,0,0,,na may tuwid na mukha.
Dialogue: 0,0:03:14.31,0:03:16.02,Default,,0,0,0,,Tingin mo nagbibiro ako?
Dialogue: 0,0:03:18.44,0:03:19.50,Default,,0,0,0,,Seryoso ka?
Dialogue: 0,0:03:19.53,0:03:21.73,Default,,0,0,0,,Sinasabi ko na huwag maging dramatic.
Dialogue: 0,0:03:26.28,0:03:28.11,Default,,0,0,0,,Sabihin mo sa akin.
Dialogue: 0,0:03:30.79,0:03:32.99,Default,,0,0,0,,Ano ba talaga ang sinabi ng doktor?
Dialogue: 0,0:03:33.25,0:03:35.64,Default,,0,0,0,,Saan ka nasasaktan?
Dialogue: 0,0:03:35.67,0:03:38.70,Default,,0,0,0,,Talaga bang sinabi ng doktor na tatlo lang...?
Dialogue: 0,0:03:40.34,0:03:42.96,Default,,0,0,0,,Na may tatlong buwan ka na lang para mabuhay?
Dialogue: 0,0:03:47.14,0:03:48.84,Default,,0,0,0,,Kumusta, Propesor.
Dialogue: 0,0:03:49.18,0:03:50.88,Default,,0,0,0,,Ang resulta ng pagsubok?
Dialogue: 0,0:03:52.48,0:03:56.51,Default,,0,0,0,,Maaari mo bang i-email ito sa akin?\NI walang oras upang pumunta doon.
Dialogue: 0,0:04:16.71,0:04:18.83,Default,,0,0,0,,Kailangan nating pumunta sa isang lugar.
Dialogue: 0,0:04:20.09,0:04:21.73,Default,,0,0,0,,Libre mo ngayon, di ba?
Dialogue: 0,0:04:21.76,0:04:23.83,Default,,0,0,0,,Naghihintay ang sasakyan sa ibaba.
Dialogue: 0,0:04:27.18,0:04:29.05,Default,,0,0,0,,Hindi ako pupunta.
Dialogue: 0,0:04:31.14,0:04:33.88,Default,,0,0,0,,- Hindi ko man lang sinabi sayo kung saan tayo pupunta.\N- Di bale.
Dialogue: 0,0:04:33.90,0:04:36.61,Default,,0,0,0,,Tumanggi akong pumunta kahit saan kasama ka.
Dialogue: 0,0:04:38.27,0:04:40.77,Default,,0,0,0,,Saan ka pupunta ngayon?
Dialogue: 0,0:04:41.48,0:04:44.65,Default,,0,0,0,,Hindi ko alam. Wala akong ideya kung saan ako patungo.
Dialogue: 0,0:04:54.75,0:04:56.87,Default,,0,0,0,,{\i1}{\c&HFFFF&}Sungmin University Medical Center{\c}{\i0}
Dialogue: 0,0:05:18.90,0:05:21.46,Default,,0,0,0,,{\i1}Hindi tulad ng mga normal na tumor,{\i0}
Dialogue: 0,0:05:21.48,0:05:25.35,Default,,0,0,0,,{\i1}ang mga mala-fuzz na tumor na ito ay nakakalat.{\i0}
Dialogue: 0,0:05:31.83,0:05:33.36,Default,,0,0,0,,Maghintay.
Dialogue: 0,0:05:33.79,0:05:36.27,Default,,0,0,0,,Kailan ako nakarating dito?
Dialogue: 0,0:05:36.29,0:05:38.37,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:05:39.67,0:05:42.15,Default,,0,0,0,,Naalala kong nasa lobby ako,
Dialogue: 0,0:05:42.17,0:05:44.08,Default,,0,0,0,,so paano na ako nandito?
Dialogue: 0,0:05:44.30,0:05:46.23,Default,,0,0,0,,Para akong nagteleport.
Dialogue: 0,0:05:46.26,0:05:48.54,Default,,0,0,0,,Nangyari na ba ito dati?
Dialogue: 0,0:05:48.84,0:05:50.95,Default,,0,0,0,,Sinabi ko na sa iyo noong nakaraan.
Dialogue: 0,0:05:50.97,0:05:56.04,Default,,0,0,0,,Minsan sumasakit ang ulo ko at\N madalas makakalimutin, at minsan...
Dialogue: 0,0:05:56.06,0:05:58.75,Default,,0,0,0,,Nagustuhan ng aming mga VIP ang art class\Nginanap namin sa unang kalahating taon.
Dialogue: 0,0:05:58.77,0:05:59.99,Default,,0,0,0,,Inimbitahan namin ang mga sikat na artista...
Dialogue: 0,0:06:00.01,0:06:01.54,Default,,0,0,0,,Sasali sa amin si Restea.
Dialogue: 0,0:06:01.56,0:06:03.68,Default,,0,0,0,,Sa mga araw na ito, kalidad ng pagtulog...
Dialogue: 0,0:06:06.86,0:06:09.38,Default,,0,0,0,,{\i1}Sampung minuto? Kalahating oras?{\i0}
Dialogue: 0,0:06:09.41,0:06:14.36,Default,,0,0,0,,{\i1}Minsan hindi ko maalala kung ano ang ginawa ni\NI nitong mga nakaraang oras.{\i0}
Dialogue: 0,0:06:35.14,0:06:36.67,Default,,0,0,0,,Ms. Hong.
Dialogue: 0,0:06:37.14,0:06:40.75,Default,,0,0,0,,{\an8}Akala ko kinansela mo ang iyong mga plano\Nto makipagkita kay Direk Baek Hyun-woo.
Dialogue: 0,0:06:40.77,0:06:42.64,Default,,0,0,0,,Bakit nandito ka pa?
Dialogue: 0,0:06:43.65,0:06:46.31,Default,,0,0,0,,{\i1}Na-miss ko pa ang isang mahalagang appointment.{\i0}
Dialogue: 0,0:07:14.30,0:07:16.67,Default,,0,0,0,,Bakit hindi mo ako binisita ng mas maaga?
Dialogue: 0,0:07:16.76,0:07:19.37,Default,,0,0,0,,Naisip ko lang na matutulog na ako o mag-zone out...
Dialogue: 0,0:07:19.39,0:07:20.70,Default,,0,0,0,,dahil sa pagod.
Dialogue: 0,0:07:20.73,0:07:24.51,Default,,0,0,0,,Wala akong naramdamang pisikal na sakit,
Dialogue: 0,0:07:24.61,0:07:26.31,Default,,0,0,0,,kaya...
Dialogue: 0,0:07:27.82,0:07:29.34,Default,,0,0,0,,may mali ba sa akin?
Dialogue: 0,0:07:29.36,0:07:31.92,Default,,0,0,0,,Mayroon kang Cloud Cytoma. Ito ay isang napakabihirang sakit.
Dialogue: 0,0:07:31.95,0:07:34.09,Default,,0,0,0,,Walang maraming kaso sa buong mundo.
Dialogue: 0,0:07:34.12,0:07:38.07,Default,,0,0,0,,Ligtas na sabihin na ikaw ang\Nour unang Korean na pasyente.
Dialogue: 0,0:07:40.87,0:07:43.91,Default,,0,0,0,,- Kailangan ko bang operahan?\N- Hindi.
Dialogue: 0,0:07:45.13,0:07:49.19,Default,,0,0,0,,Nakikita ko. Maaari itong gamutin sa pamamagitan ng gamot.
Dialogue: 0,0:07:49.21,0:07:51.90,Default,,0,0,0,,Ang iyong kaso ay medyo mas kumplikado,
Dialogue: 0,0:07:51.92,0:07:54.11,Default,,0,0,0,,dahil iba ito sa mga regular na tumor.
Dialogue: 0,0:07:54.14,0:07:57.07,Default,,0,0,0,,Hindi ito malinaw na bukol ng tumor.
Dialogue: 0,0:07:57.10,0:08:02.34, Default,,0,0,0,,Nakakalat ang mga tumor cells\Nsa buong cranial nerves mo.
Dialogue: 0,0:08:03.23,0:08:05.04,Default,,0,0,0,,Nakakalat sila sa malawak na lugar.
Dialogue: 0,0:08:05.06,0:08:08.00,Default,,0,0,0,,Ito ang pinaka-concentrated\Nmalapit sa iyong temporal na lobe.
Dialogue: 0,0:08:08.02,0:08:12.19,Default,,0,0,0,,Naniniwala ako na ito ang sanhi ng\Ang iyong pansamantalang pagkawala ng memorya.
Dialogue: 0,0:08:12.36,0:08:13.63,Default,,0,0,0,,Ito ay isang bihirang sakit.
Dialogue: 0,0:08:13.65,0:08:17.57,Default,,0,0,0,,Ang mga sintomas ay hindi tiyak\Nand ay naiiba sa bawat kaso.
Dialogue: 0,0:08:17.70,0:08:21.89,Default,,0,0,0,,Kung lumala ito, maaari kang magkaroon ng\Nhallucinations o mga personality disorder.
Dialogue: 0,0:08:21.91,0:08:25.77,Default,,0,0,0,,Ang problema, hindi nakakatulong nang malaki ang pag-inom ng\Ngamot,
Dialogue: 0,0:08:25.79,0:08:28.06,Default,,0,0,0,,{\i1}at masyadong delikado ang pag-opera,{\i0}
Dialogue: 0,0:08:28.09,0:08:32.41,Default,,0,0,0,,{\i1}dahil masyadong kumalat ang mga tumor cells.{\i0}
Dialogue: 0,0:08:33.55,0:08:35.25,Default,,0,0,0,,{\i1}Ms. Hong?{\i0}
Dialogue: 0,0:08:38.30,0:08:39.84,Default,,0,0,0,,{\i1}Ms. Hong?{\i0}
Dialogue: 0,0:08:42.64,0:08:44.55,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,0:08:54.03,0:08:55.92,Default,,0,0,0,,- Okay.\N- Pardon?
Dialogue: 0,0:08:55.95,0:08:59.23,Default,,0,0,0,,Kaya ganyan ang mga ordinaryong tao.
Dialogue: 0,0:08:59.37,0:09:00.72,Default,,0,0,0,,Naiintindihan ko.
Dialogue: 0,0:09:00.74,0:09:03.43, Default,,0,0,0,, Ngayon sabihin sa akin kung anong paggamot ang makukuha ko.
Dialogue: 0,0:09:03.45,0:09:05.97,Default,,0,0,0,,Gusto kong malaman ang tungkol sa kaso ko, hindi sa kanila.
Dialogue: 0,0:09:06.00,0:09:08.56,Default,,0,0,0,,Nabalitaan kong nakalikom ka ng pera\Npara sa isang bagong ospital ng mga bata.
Dialogue: 0,0:09:08.59,0:09:10.69,Default,,0,0,0,,kaya ko na yan,
Dialogue: 0,0:09:10.71,0:09:12.75,Default,,0,0,0,,kaya sabihin mo sa akin...
Dialogue: 0,0:09:13.26,0:09:14.90,Default,,0,0,0,,kung paano ko sila maaalis.
Dialogue: 0,0:09:14.92,0:09:16.28,Default,,0,0,0,,Sa pagkakaalam ko,
Dialogue: 0,0:09:16.30,0:09:19.84,Default,,0,0,0,,walang kasalukuyang medikal na solusyon para dito.
Dialogue: 0,0:09:20.05,0:09:22.70,Default,,0,0,0,,Ang pinakamahusay na magagawa namin ay bigyan ka ng gamot...
Dialogue: 0,0:09:22.72,0:09:25.70,Default,,0,0,0,,upang maibsan ang iyong pananakit\Nand pansamantalang pagkawala ng memorya.
Dialogue: 0,0:09:25.73,0:09:29.22,Default,,0,0,0,,Gayunpaman, imposibleng\Ngagamot ang mismong sakit sa ngayon...
Dialogue: 0,0:09:29.81,0:09:31.89,Default,,0,0,0,,Nag-insinuate ka...
Dialogue: 0,0:09:32.36,0:09:35.69,Default,,0,0,0,,na malapit na akong mamatay.
Dialogue: 0,0:09:35.99,0:09:37.92,Default,,0,0,0,,Fine. Sabihin mo sa akin.
Dialogue: 0,0:09:37.95,0:09:40.26,Default,,0,0,0,,Kailan ako mamamatay?
Dialogue: 0,0:09:40.28,0:09:43.15,Default,,0,0,0,,Paghuhusga sa pamamagitan ng pagkalat ng mga tumor cells,
Dialogue: 0,0:09:43.83,0:09:47.11,Default,,0,0,0,,Naniniwala ako na mayroon kang mga tatlong buwan.
Dialogue: 0,0:09:53.13,0:09:54.77,Default,,0,0,0,,Ano ang alam niya, gayon pa man?
Dialogue: 0,0:09:54.80,0:09:57.29,Default,,0,0,0,,Siya ang pinakamahusay na nakakaalam bilang isang doktor.
Dialogue: 0,0:09:58.97,0:10:00.79,Default,,0,0,0,,Alam ko ang sarili kong katawan.
Dialogue: 0,0:10:01.60,0:10:03.78,Default,,0,0,0,,Para kang matigas ang ulo, matandang babae.
Dialogue: 0,0:10:03.81,0:10:06.87,Default,,0,0,0,,Nakita mo na ba akong kumain ng instant o junk food?
Dialogue: 0,0:10:06.89,0:10:08.16,Default,,0,0,0,,- Hindi.\N- Eksakto.
Dialogue: 0,0:10:08.19,0:10:09.93,Default,,0,0,0,,Hindi pa ako umiinom ng soda sa buong buhay ko.
Dialogue: 0,0:10:09.95,0:10:14.04,Default,,0,0,0,,Sa tingin mo ba nag-enjoy akong uminom\Nvegetable juice at panoorin ang kinain ko?
Dialogue: 0,0:10:14.07,0:10:17.81,Default,,0,0,0,,Nag-meditate ako sa umaga at\Ndid yoga sa gabi para sa stress ko.
Dialogue: 0,0:10:17.95,0:10:20.55,Default,,0,0,0,,Pinagmasdan ko ang aking paghinga kung walang oxygen concentrator.
Dialogue: 0,0:10:20.57,0:10:24.51,Default,,0,0,0,,Sinubukan kong manatiling malusog\Nmula nang ipanganak ako.
Dialogue: 0,0:10:24.54,0:10:26.07,Default,,0,0,0,,Naiintindihan ko.
Dialogue: 0,0:10:27.71,0:10:29.41,Default,,0,0,0,,Kalmado.
Dialogue: 0,0:10:30.63,0:10:33.69,Default,,0,0,0,,Kahit ang mga taong pumipinsala sa kanilang\Nkatawan sa pamamagitan ng pag-inom, paninigarilyo,
Dialogue: 0,0:10:33.71,0:10:36.44,Default,,0,0,0,,kumakain ng kahit anong gusto nila,\Nand not minding their breathing,
Dialogue: 0,0:10:36.46,0:10:38.83,Default,,0,0,0,,ay hindi sumasailalim sa sakit na ito,
Dialogue: 0,0:10:38.88,0:10:40.42,Default,,0,0,0,,so bakit ako?
Dialogue: 0,0:10:40.72,0:10:42.59,Default,,0,0,0,,Hindi ko rin alam.
Dialogue: 0,0:10:42.93,0:10:44.28,Default,,0,0,0,,Fine.
Dialogue: 0,0:10:44.31,0:10:47.55,Default,,0,0,0,,Naiintindihan ko na may sakit ako, pero bakit hindi nila ako maayos?
Dialogue: 0,0:10:47.60,0:10:49.91,Default,,0,0,0,,Ang mga tao ay naglalakbay patungo sa buwan,\Nand na mga sasakyan ang nagmamaneho,
Dialogue: 0,0:10:49.93,0:10:53.59,Default,,0,0,0,,ngunit hindi nila maalis ang isang maliit na tumor sa aking ulo?
Dialogue: 0,0:10:54.27,0:10:56.18,Default,,0,0,0,,Nakakatawa.
Dialogue: 0,0:10:58.57,0:11:00.65,Default,,0,0,0,,Paano kung...
Dialogue: 0,0:11:01.03,0:11:05.82,Default,,0,0,0,,pumunta tayo sa ospital bukas at susuriin muli?
Dialogue: 0,0:11:06.08,0:11:07.55,Default,,0,0,0,,Para saan?
Dialogue: 0,0:11:07.58,0:11:10.78,Default,,0,0,0,,Kailangan nating makasigurado. Ano ang gagawin\NI kung ito ay isang maling pagsusuri?
Dialogue: 0,0:11:14.04,0:11:17.12,Default,,0,0,0,,Ano ang gagawin mo kung ito ay isang maling diagnosis?
Dialogue: 0,0:11:18.05,0:11:20.21,Default,,0,0,0,,Matutuwa ako...
Dialogue: 0,0:11:22.80,0:11:27.17,Default,,0,0,0,,Kaya sige at muling kumpirmahin ang lahat.
Dialogue: 0,0:11:27.56,0:11:30.01,Default,,0,0,0,,Nababaliw ka na ngayon.
Dialogue: 0,0:11:30.73,0:11:34.30,Default,,0,0,0,,Kalimutan mo na lang ang lahat at magpahinga ka na...
Dialogue: 0,0:11:34.65,0:11:36.77,Default,,0,0,0,,Sa tingin mo makakatulog ako?
Dialogue: 0,0:11:36.98,0:11:38.68,Default,,0,0,0,,Tama.
Dialogue: 0,0:11:40.32,0:11:42.60,Default,,0,0,0,,Nagulat din ako.
Dialogue: 0,0:11:43.11,0:11:45.73,Default,,0,0,0,,Hindi ko alam kung makakatulog ako ngayong gabi.
Dialogue: 0,0:12:28.66,0:12:31.19,Default,,0,0,0,,Iba ang pakiramdam...
Dialogue: 0,0:12:32.66,0:12:34.91,Default,,0,0,0,,kumpara kahapon.
Dialogue: 0,0:12:46.34,0:12:49.55,Default,,0,0,0,,Huming? talaga? Gusto mo bang ilibing kasama siya?
Dialogue: 0,0:12:50.01,0:12:51.72,Default,,0,0,0,,Nalulungkot ako.
Dialogue: 0,0:12:54.31,0:12:55.50,Default,,0,0,0,,Maghihiwalay na tayo.
Dialogue: 0,0:12:55.52,0:13:00.64,Default,,0,0,0,,Maghihiwalay tayo sa loob ng tatlong\Nbuwan kahit walang divorce.
Dialogue: 0,0:13:04.90,0:13:06.61,Default,,0,0,0,,Hindi.
Dialogue: 0,0:13:08.45,0:13:10.57,Default,,0,0,0,,Huwag ngumiti.
Dialogue: 0,0:13:12.70,0:13:14.45,Default,,0,0,0,,Bumaba.
Dialogue: 0,0:13:21.13,0:13:22.83,Default,,0,0,0,,Hae-in?
Dialogue: 0,0:13:26.30,0:13:29.67,Default,,0,0,0,,Maghintay. Hindi siya natutulog.
Dialogue: 0,0:13:31.31,0:13:32.88,Default,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:13:42.36,0:13:43.89,Default,,0,0,0,,Hey.
Dialogue: 0,0:13:47.57,0:13:50.02,Default,,0,0,0,,Lampas 7 a.m.
Dialogue: 0,0:14:45.88,0:14:47.91,Default,,0,0,0,,Ano?
Dialogue: 0,0:14:48.09,0:14:49.87,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:15:07.82,0:15:11.61,Default,,0,0,0,,Dapat nasa magandang mood ka para sabihin iyan.
Dialogue: 0,0:15:13.32,0:15:15.32,Default,,0,0,0,,Maging ang iyong balat ay mukhang mas maganda.
Dialogue: 0,0:15:16.04,0:15:17.30,Default,,0,0,0,,Siguradong nakatulog ka ng maayos.
Dialogue: 0,0:15:17.33,0:15:20.11,Default,,0,0,0,,I tossed and turned all night.
Dialogue: 0,0:15:23.92,0:15:25.45,Default,,0,0,0,,Ako?
Dialogue: 0,0:15:26.34,0:15:28.25,Default,,0,0,0,,Ang balat ko?
Dialogue: 0,0:15:28.63,0:15:30.23,Default,,0,0,0,,Mali ka.
Dialogue: 0,0:15:30.26,0:15:33.21,Default,,0,0,0,,Hindi, hindi pwede.
Dialogue: 0,0:16:01.91,0:16:04.23,Default,,0,0,0,,Babalaan kita.
Dialogue: 0,0:16:04.25,0:16:06.06,Default,,0,0,0,,Ikaw lang ang nakakaalam nito,
Dialogue: 0,0:16:06.09,0:16:08.62,Default,,0,0,0,,kaya kung may makaalam, kasalanan mo.
Dialogue: 0,0:16:09.67,0:16:11.25,Default,,0,0,0,,Naiintindihan ko,
Dialogue: 0,0:16:11.38,0:16:13.90,Default,,0,0,0,,pero itatago mo ba itong sikreto magpakailanman?
Dialogue: 0,0:16:13.93,0:16:15.59,Default,,0,0,0,,Oo.
Dialogue: 0,0:16:16.01,0:16:17.91,Default,,0,0,0,,Hindi ba dapat malaman ng pamilya mo?
Dialogue: 0,0:16:17.93,0:16:20.37,Default,,0,0,0,,Siyempre hindi. Dapat ay sila ang huling makakaalam.
Dialogue: 0,0:16:20.39,0:16:22.08,Default,,0,0,0,,Pero sa tingin ko...
Dialogue: 0,0:16:22.10,0:16:26.29,Default,,0,0,0,,Malapit na akong sumali sa One Billion Club.
Dialogue: 0,0:16:26.31,0:16:29.42,Default,,0,0,0,,Alam mo ang sinabi ni Lolo\Nnang ibigay niya sa akin ang department store.
Dialogue: 0,0:16:29.44,0:16:31.75,Default,,0,0,0,,"Pipiliin kita kaysa sa tatay mo..."
Dialogue: 0,0:16:31.78,0:16:35.11,Default,,0,0,0,,"kung kikita ka ng mahigit $1 bilyon na benta."
Dialogue: 0,0:16:37.12,0:16:40.65,Default,,0,0,0,,Gusto mo sirain ko yan, kapag ganito ako kalapit?
Dialogue: 0,0:16:41.37,0:16:43.10,Default,,0,0,0,,Kaya pala hindi mo sasabihin sa kanila?
Dialogue: 0,0:16:43.12,0:16:45.68,Default,,0,0,0,,Hong Soo-cheol ang\Ntype na tumatawag sa doktor ko...
Dialogue: 0,0:16:45.71,0:16:48.60,Default,,0,0,0,,para kumpirmahin kung nagka-trangkaso talaga ako.
Dialogue: 0,0:16:48.63,0:16:51.83,Default,,0,0,0,,Sa tingin mo ba magiging iba ang nanay ko?
Dialogue: 0,0:16:52.01,0:16:54.53,Default,,0,0,0,,Pag nalaman nila ang sakit ko,
Dialogue: 0,0:16:54.55,0:16:57.03,Default,,0,0,0,,Sisipain ako palabas ng bahay.
Dialogue: 0,0:16:57.05,0:17:01.17,Default,,0,0,0,,Mag-aaway sila kung sino ang kukuha ng mga asset ko.
Dialogue: 0,0:17:05.56,0:17:07.66,Default,,0,0,0,,Hindi ako papayag.
Dialogue: 0,0:17:07.69,0:17:09.72,Default,,0,0,0,,Sa ibabaw ng patay kong katawan.
Dialogue: 0,0:17:25.62,0:17:29.39,Default,,0,0,0,,Bakit sa palagay mo gustong\Nan akong makita ni Lolo bago mag-almusal?
Dialogue: 0,0:17:29.42,0:17:31.90,Default,,0,0,0,,Gusto ba niya akong bigyan ng\Malapit at tapusin ito sa...
Dialogue: 0,0:17:31.92,0:17:32.98,Default,,0,0,0,,bago kumain ng almusal?
Dialogue: 0,0:17:33.01,0:17:35.21,Default,,0,0,0,,Any idea kung bakit ka niya gustong makita?
Dialogue: 0,0:17:36.09,0:17:37.24,Default,,0,0,0,,Siguro ito ay tungkol sa...
Dialogue: 0,0:17:37.26,0:17:39.86,Default,,0,0,0,,kung paano ko gustong ilunsad ang\Norganic New York coffee brand na iyon.
Dialogue: 0,0:17:39.89,0:17:42.82,Default,,0,0,0,,Yung nagtiwala ka sa paglulunsad?
Dialogue: 0,0:17:42.85,0:17:44.74,Default,,0,0,0,,Oo, pero nagkamali ako.
Dialogue: 0,0:17:44.77,0:17:49.72,Default,,0,0,0,,Ang mga hamak na iyon ay naglagay sa akin ng isa,\Nand ay nagpasya na magtrabaho kasama si Yeom Sang-jin.
Dialogue: 0,0:17:50.65,0:17:53.93,Default,,0,0,0,,Bakit ang mundong ito ay puno ng imoral na mga hamak?
Dialogue: 0,0:17:56.20,0:17:57.76,Default,,0,0,0,,Sa tingin mo ba alam ni Lolo?
Dialogue: 0,0:17:57.78,0:17:59.84,Default,,0,0,0,,Kahit kailan ko lang nalaman.
Dialogue: 0,0:17:59.87,0:18:02.22,Default,,0,0,0,,Kinakailangan ang mga panganib sa pagpapatakbo ng negosyo.
Dialogue: 0,0:18:02.24,0:18:06.11,Default,,0,0,0,,Huwag kang matakot. {\i1}force\Nmajeure{\i0} lang ang natuloy ang deal.
Dialogue: 0,0:18:06.16,0:18:09.06,Default,,0,0,0,,Oo, tama ka. Ito ay {\i1}pwersa lamang...{\i0}
Dialogue: 0,0:18:09.08,0:18:13.19,Default,,0,0,0,,Natuloy lang ang deal dahil sa {\i1}force majeure,{\i0}
Dialogue: 0,0:18:13.21,0:18:16.04,Default,,0,0,0,,pero nag-aalala pa rin ako na magagalit siya.
Dialogue: 0,0:18:17.26,0:18:20.17,Default,,0,0,0,,Siya ang lolo mo, hindi si Satanas.
Dialogue: 0,0:18:20.55,0:18:22.71,Default,,0,0,0,,Magtiwala ka at sabihin sa kanya.
Dialogue: 0,0:18:24.35,0:18:26.13,Default,,0,0,0,,- Dapat, di ba?\N- Oo.
Dialogue: 0,0:18:30.60,0:18:32.89,Default,,0,0,0,,{\i1}Paano ka walang kakayahan?!{\i0}
Dialogue: 0,0:18:33.48,0:18:35.89,Default,,0,0,0,,Lolo, natuloy lang ang deal na ito...
Dialogue: 0,0:18:36.03,0:18:38.00,Default,,0,0,0,,dahil sa {\i1}force majeure...{\i0}
Dialogue: 0,0:18:38.03,0:18:40.61,Default,,0,0,0,,Ano? Nagtagumpay ang isang deal?
Dialogue: 0,0:18:41.28,0:18:44.01,Default,,0,0,0,,Anong deal ang sinasabi mo?
Dialogue: 0,0:18:44.03,0:18:46.01,Default,,0,0,0,,Ang paglulunsad ng organic na New York coffee.
Dialogue: 0,0:18:46.04,0:18:47.35,Default,,0,0,0,,Hindi ba iyon ang tungkol dito?
Dialogue: 0,0:18:47.37,0:18:49.39,Default,,0,0,0,,Pinag-uusapan ko kung paano...
Dialogue: 0,0:18:49.41,0:18:52.77,Default,,0,0,0,,sobra ka sa $8 milyon...
Dialogue: 0,0:18:52.79,0:18:54.91,Default,,0,0,0,,sa corporate tax!
Dialogue: 0,0:18:55.13,0:18:56.65,Default,,0,0,0,,- Ano?\N- Ang legal team ni Hyun-woo...
Dialogue: 0,0:18:56.67,0:19:00.63,Default,,0,0,0,,nalaman ang tungkol dito at\Nmaghain ng claim sa pagwawasto.
Dialogue: 0,0:19:00.97,0:19:04.96,Default,,0,0,0,,Mababa ang pera na iyan\Nang drain kung hindi dahil sa kanya!
Dialogue: 0,0:19:05.10,0:19:06.41,Default,,0,0,0,,Ang bayaw mo di ba...
Dialogue: 0,0:19:06.43,0:19:08.24,Default,,0,0,0,,ang finance director?
Dialogue: 0,0:19:08.27,0:19:09.66,Default,,0,0,0,,- Fire him this instant!\N- Pero...
Dialogue: 0,0:19:09.68,0:19:12.29,Default,,0,0,0,,Gayundin, sobrang tiwala mo...
Dialogue: 0,0:19:12.31,0:19:15.33,Default,,0,0,0,,tungkol sa coffee deal na iyon. Nahulog din ba iyan?
Dialogue: 0,0:19:15.36,0:19:17.35,Default,,0,0,0,,- Hindi...\N- Sagutin mo ako!
Dialogue: 0,0:19:17.57,0:19:21.59,Default,,0,0,0,,Bakit wala kang magawa ng tama?
Dialogue: 0,0:19:21.61,0:19:24.69,Default,,0,0,0,,Wala ka bang natutunan kay Hae-in?
Dialogue: 0,0:19:24.78,0:19:26.43,Default,,0,0,0,,- Hindi ba?\N- Kita mo...
Dialogue: 0,0:19:26.45,0:19:28.39,Default,,0,0,0,,Say something, you scumbag!
Dialogue: 0,0:19:28.41,0:19:29.47,Default,,0,0,0,,Magsalita ka, hamak ka!
Dialogue: 0,0:19:29.50,0:19:31.22,Default,,0,0,0,,Gamitin mo yang bibig mo!
Dialogue: 0,0:19:31.25,0:19:32.93,Default,,0,0,0,,- Ako...\N- Sagutin mo ako, tanga!
Dialogue: 0,0:19:32.96,0:19:35.19,Default,,0,0,0,,Gusto kong sumagot, pero hindi ko magawa...
Dialogue: 0,0:19:35.21,0:19:36.19,Default,,0,0,0,,Pagkatapos magsalita!
Dialogue: 0,0:19:36.21,0:19:38.58,Default,,0,0,0,,Hindi ako makahinga.
Dialogue: 0,0:19:41.09,0:19:43.03,Default,,0,0,0,,Ano?
Dialogue: 0,0:19:43.05,0:19:44.92,Default,,0,0,0,,Bumangon ka!
Dialogue: 0,0:19:52.48,0:19:55.72,Default,,0,0,0,,Sa tingin ni Doctor Jeong may panic disorder siya.
Dialogue: 0,0:19:57.82,0:19:59.21,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:19:59.23,0:20:01.88,Default,,0,0,0,,Na-stress ka siguro\Nout ng lolo mo...
Dialogue: 0,0:20:01.90,0:20:03.51,Default,,0,0,0,,Kasalanan ito ni Hyun-woo.
Dialogue: 0,0:20:03.53,0:20:07.65,Default,,0,0,0,,Bakit ang galing niya sa trabaho niya?
Dialogue: 0,0:20:08.91,0:20:10.22,Default,,0,0,0,,I'm sorry, Inay.
Dialogue: 0,0:20:10.25,0:20:12.77,Default,,0,0,0,,Kasalanan ng kapatid ko.
Dialogue: 0,0:20:12.79,0:20:14.02,Default,,0,0,0,,Honey, nakakatawa iyon.
Dialogue: 0,0:20:14.04,0:20:16.69,Default,,0,0,0,,Nagsumikap ang kapatid mo\Nagkamali lang si Nand.
Dialogue: 0,0:20:16.71,0:20:19.27,Default,,0,0,0,,$8 milyon ay hindi naman seryoso.
Dialogue: 0,0:20:19.30,0:20:21.40,Default,,0,0,0,,$8 milyon?
Dialogue: 0,0:20:21.42,0:20:25.67,Default,,0,0,0,,Dahil lang ba ito sa $8 milyon?
Dialogue: 0,0:20:26.51,0:20:28.16,Default,,0,0,0,,Nasaan si Hyun-woo?
Dialogue: 0,0:20:28.18,0:20:30.63,Default,,0,0,0,,Ikinalulungkot ko talaga,
Dialogue: 0,0:20:31.60,0:20:33.80,Default,,0,0,0,,pero pareho ang resulta.
Dialogue: 0,0:20:34.69,0:20:38.25,Default,,0,0,0,,Ibig mo bang sabihin may natitira pa siyang tatlong buwan?
Dialogue: 0,0:20:38.27,0:20:41.14,Default,,0,0,0,,- Eksaktong tatlong buwan?\N- Hindi ko masabi.
Dialogue: 0,0:20:41.49,0:20:43.71,Default,,0,0,0,,Iresponsableng sagot yan.
Dialogue: 0,0:20:43.74,0:20:46.05,Default,,0,0,0,,Ikaw ay isang neurologist sa loob ng 30 taon.
Dialogue: 0,0:20:46.07,0:20:49.93,Default,,0,0,0,,Mangyaring maging eksakto sa porsyento.\NPPakibigay sa amin ang eksaktong numero.
Dialogue: 0,0:20:49.95,0:20:52.15,Default,,0,0,0,,Tama na. Tara na.
Dialogue: 0,0:20:52.29,0:20:54.82,Default,,0,0,0,,Hindi, Hae-in. Kailangan kong marinig ito.
Dialogue: 0,0:20:56.38,0:20:59.54,Default,,0,0,0,,Mabuti, kung gayon. aalis na ako ngayon.
Dialogue: 0,0:21:05.76,0:21:07.46,Default,,0,0,0,,Sir.
Dialogue: 0,0:21:08.14,0:21:10.53,Default,,0,0,0,,I'd appreciate it if you could be exact.
Dialogue: 0,0:21:10.56,0:21:13.47,Default,,0,0,0,,Ang buhay ko ay nasa linya dito.
Dialogue: 0,0:21:40.96,0:21:42.87,Default,,0,0,0,,Ito ay katawa-tawa.
Dialogue: 0,0:21:43.51,0:21:45.21,Default,,0,0,0,,Iba ako.
Dialogue: 0,0:21:52.51,0:21:53.49,Default,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:21:53.52,0:21:56.29,Default,,0,0,0,,Bakit hindi sumusundo si Hyun-woo?\Nsa office niya?
Dialogue: 0,0:21:56.31,0:21:57.95,Default,,0,0,0,,Tinanong ko kung bakit ka nandito.
Dialogue: 0,0:21:57.98,0:22:00.71,Default,,0,0,0,,Paano kung si Soo-cheol\Noverpaid ng ilang milyong dolyar?
Dialogue: 0,0:22:00.73,0:22:04.13,Default,,0,0,0,,Si Hyun-woo sana ang bahala dito nang tahimik.
Dialogue: 0,0:22:04.15,0:22:05.98,Default,,0,0,0,,Nagalit ang lolo mo kay Soo-cheol.
Dialogue: 0,0:22:06.00,0:22:08.67,Default,,0,0,0,,Malamang nalaman niya kahit papaano.\NHyun-woo ay hindi gagawin iyon.
Dialogue: 0,0:22:08.70,0:22:10.43,Default,,0,0,0,,Ano ang kinukuha mo sa akin?
Dialogue: 0,0:22:10.45,0:22:13.07,Default,,0,0,0,,Alam kong ikaw ang nasa likod nito.
Dialogue: 0,0:22:13.91,0:22:16.82,Default,,0,0,0,,Wala akong oras para diyan. ako ay...
Dialogue: 0,0:22:18.00,0:22:19.93,Default,,0,0,0,,medyo ginulo ng isang seryosong bagay.
Dialogue: 0,0:22:19.96,0:22:21.83,Default,,0,0,0,,Si Soo-cheol ay...
Dialogue: 0,0:22:23.17,0:22:24.95,Default,,0,0,0,,isang panic attack ngayon.
Dialogue: 0,0:22:26.01,0:22:27.71,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:22:30.97,0:22:33.22,Default,,0,0,0,,Nagulat ka siguro.
Dialogue: 0,0:22:34.97,0:22:36.67,Default,,0,0,0,,Pero Nanay,
Dialogue: 0,0:22:36.73,0:22:40.80,Default,,0,0,0,,Sinabi ko lang sa iyo na\NI ay may seryosong bagay din.
Dialogue: 0,0:22:41.73,0:22:43.60,Default,,0,0,0,,Hindi ka ba curious?
Dialogue: 0,0:22:44.40,0:22:48.56,Default,,0,0,0,,Lagi mong alam kung ano ang gagawin,\Nmalaki man ito o maliit.
Dialogue: 0,0:22:50.07,0:22:51.77,Default,,0,0,0,,Tama.
Dialogue: 0,0:22:52.28,0:22:54.28,Default,,0,0,0,,Ako na ang bahala...
Dialogue: 0,0:22:54.53,0:22:55.68,Default,,0,0,0,,ng aking negosyo.
Dialogue: 0,0:22:55.70,0:22:57.51,Default,,0,0,0,,You should go. Ito ang aking lugar ng trabaho.
Dialogue: 0,0:22:57.54,0:22:59.35,Default,,0,0,0,,Hoy, huwag mo akong pansinin.
Dialogue: 0,0:22:59.37,0:23:01.74,Default,,0,0,0,,Nandito ako para makita si Hyun-woo, gayunpaman.
Dialogue: 0,0:23:02.17,0:23:04.20,Default,,0,0,0,,Tigilan mo na kami,
Dialogue: 0,0:23:04.50,0:23:07.27,Default,,0,0,0,,o pahihirapan ko ang anak mo hanggang sa araw na mamatay ako,
Dialogue: 0,0:23:07.30,0:23:11.40,Default,,0,0,0,,gaano man ako ka-busy o distracted.
Dialogue: 0,0:23:11.43,0:23:14.55,Default,,0,0,0,,- Ano?\N- Pahihirapan ko siya ng tuluyan.
Dialogue: 0,0:23:15.10,0:23:16.66,Default,,0,0,0,,Totoo ba iyon?
Dialogue: 0,0:23:16.68,0:23:19.34,Default,,0,0,0,,Sa tingin mo uupo lang ako at manonood?
Dialogue: 0,0:23:19.56,0:23:21.26,Default,,0,0,0,,Ituloy mo.
Dialogue: 0,0:23:35.03,0:23:36.55,Default,,0,0,0,,Bakit dito mo gustong kumain?
Dialogue: 0,0:23:36.58,0:23:39.43,Default,,0,0,0,,Uy, hindi man lang ako ligtas sa meeting room ng Nour law firm.
Dialogue: 0,0:23:39.45,0:23:43.12,Default,,0,0,0,,Ang pampublikong lugar na tulad nito ay mas ligtas.
Dialogue: 0,0:23:43.25,0:23:44.91,Default,,0,0,0,,Bakit ganun?
Dialogue: 0,0:23:46.17,0:23:51.17,Default,,0,0,0,,Dahil I'm risking my\Nlife to go against Queens.
Dialogue: 0,0:23:52.13,0:23:53.88,Default,,0,0,0,,Bakit mo gagawin?
Dialogue: 0,0:23:54.97,0:23:58.32,Default,,0,0,0,,Matagal akong nag-isip pagkatapos kitang makitang umiiyak.
Dialogue: 0,0:23:58.35,0:24:00.80,Default,,0,0,0,,Tutulungan kita. Maghiwalay na tayo!
Dialogue: 0,0:24:05.44,0:24:08.93,Default,,0,0,0,,- Tungkol diyan...\N- Hindi ito madaling desisyon.
Dialogue: 0,0:24:09.03,0:24:10.84,Default,,0,0,0,,Isinapanganib ko ang aking trabaho.
Dialogue: 0,0:24:10.86,0:24:13.40,Default,,0,0,0,,Okay, pero huwag na lang.
Dialogue: 0,0:24:13.45,0:24:14.98,Default,,0,0,0,,Bakit hindi?
Dialogue: 0,0:24:17.24,0:24:19.40,Default,,0,0,0,,Hindi ako nakikipagdiborsiyo.
Dialogue: 0,0:24:20.45,0:24:24.37,Default,,0,0,0,,Hindi? Uy, hindi mo ba sinabi sa akin na ito ay masyadong hindi mabata?
Dialogue: 0,0:24:24.58,0:24:25.69,Default,,0,0,0,,Well...
Dialogue: 0,0:24:25.71,0:24:28.87,Default,,0,0,0,,Sinabi ko iyon dahil wala akong nakitang katapusan dito,
Dialogue: 0,0:24:29.25,0:24:33.12,Default,,0,0,0,,ngunit ngayon na nakikita ko ang isa,
Dialogue: 0,0:24:33.97,0:24:35.28,Default,,0,0,0,,Sa tingin ko kaya ko itong tiisin.
Dialogue: 0,0:24:35.30,0:24:37.59,Default,,0,0,0,,Ano ang ibig mong sabihin? Anong katapusan?
Dialogue: 0,0:24:38.72,0:24:40.41,Default,,0,0,0,,Well...
Dialogue: 0,0:24:40.43,0:24:43.41,Default,,0,0,0,,Binigyan ako ng Diyos ng ligtas na paghihiwalay.
Dialogue: 0,0:24:43.44,0:24:45.16,Default,,0,0,0,,Sabihin na lang natin.
Dialogue: 0,0:24:45.19,0:24:47.60,Default,,0,0,0,,Ipaliwanag sa mga termino ng karaniwang tao.
Dialogue: 0,0:25:01.62,0:25:05.32,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Halika sa Hangang Jamwon\NParking Lot Section One sa loob ng kalahating oras.{\c}{\i0}
Dialogue: 0,0:25:22.47,0:25:24.34,Default,,0,0,0,,Ano ang ginagawa natin?
Dialogue: 0,0:25:24.43,0:25:27.60,Default,,0,0,0,,Ang sasabihin ko sa iyo ay kumpidensyal,
Dialogue: 0,0:25:28.40,0:25:31.13,Default,,0,0,0,,- kaya kung may makaalam, ikaw ang may kasalanan.\N- Halika na.
Dialogue: 0,0:25:31.15,0:25:33.39,Default,,0,0,0,,Tungkol saan ito?
Dialogue: 0,0:25:49.33,0:25:50.81,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:25:50.84,0:25:53.48,Default,,0,0,0,,Sinabi niya sa akin noong ibibigay ko sa kanya ang mga papeles ng divorce,
Dialogue: 0,0:25:53.51,0:25:55.83,Default,,0,0,0,,na may natitira siyang tatlong buwan.
Dialogue: 0,0:25:56.42,0:25:59.00,Default,,0,0,0,,Nakipagkita din ako sa doktor niya ngayon.
Dialogue: 0,0:25:59.34,0:26:00.88,Default,,0,0,0,,Gosh, Hyun-woo.
Dialogue: 0,0:26:02.18,0:26:03.74,Default,,0,0,0,,Hey.
Dialogue: 0,0:26:03.77,0:26:06.37,Default,,0,0,0,,Nakakabaliw ito. Ano ang dapat kong sabihin?
Dialogue: 0,0:26:06.39,0:26:08.04,Default,,0,0,0,,Una...
Dialogue: 0,0:26:08.06,0:26:10.62,Default,,0,0,0,,- Mag shake hands tayo.\N- Wag na.
Dialogue: 0,0:26:10.65,0:26:12.88,Default,,0,0,0,,Tama, hindi mo dapat ipakita ang iyong kaligayahan.
Dialogue: 0,0:26:12.90,0:26:15.00,Default,,0,0,0,,Let me be the scumbag,
Dialogue: 0,0:26:15.03,0:26:17.92,Default,,0,0,0,,kaya kakampi mo si Lady Luck.
Dialogue: 0,0:26:17.95,0:26:20.97,Default,,0,0,0,,Iiwan mo sana siya nang walang\Na isang sentimos sa pangalan mo...
Dialogue: 0,0:26:20.99,0:26:22.30,Default,,0,0,0,,kung nakipagdiborsiyo ka.
Dialogue: 0,0:26:22.33,0:26:24.30,Default,,0,0,0,,Naligtas ka ng ilang segundong iyon.
Dialogue: 0,0:26:24.33,0:26:28.28,Default,,0,0,0,,Ano? Nangangahulugan ba ito na papalitan mo ang Queens?
Dialogue: 0,0:26:29.54,0:26:31.24,Default,,0,0,0,,Sa tingin mo...
Dialogue: 0,0:26:32.09,0:26:34.31,Default,,0,0,0,,- ganyan sila kagago?\N- Anong ibig mong sabihin?
Dialogue: 0,0:26:34.34,0:26:36.23,Default,,0,0,0,,Pumirma ba siya ng prenup o ano?
Dialogue: 0,0:26:36.26,0:26:37.90,Default,,0,0,0,,Tungkol sa hindi paghati sa kanyang mga ari-arian?
Dialogue: 0,0:26:37.92,0:26:40.03,Default,,0,0,0,,Alam mong hindi mahalaga kapag nagsampa ka ng kaso,
Dialogue: 0,0:26:40.05,0:26:41.74,Default,,0,0,0,,maliban kung isinulat niya ito sa kanyang kalooban.
Dialogue: 0,0:26:41.76,0:26:44.51,Default,,0,0,0,,Oo, sinulat niya ito...
Dialogue: 0,0:26:44.89,0:26:46.12,Default,,0,0,0,,sa kanyang kalooban.
Dialogue: 0,0:26:46.14,0:26:47.68,Default,,0,0,0,,Seryoso?
Dialogue: 0,0:26:48.98,0:26:50.68,Default,,0,0,0,,Oo.
Dialogue: 0,0:26:50.85,0:26:53.31,Default,,0,0,0,,Nangyari ito bago kami ikasal.
Dialogue: 0,0:26:53.57,0:26:55.79,Default,,0,0,0,,Tumanggi siyang magbigay ng kahit ano sa akin,
Dialogue: 0,0:26:55.82,0:26:58.84,Default,,0,0,0,,at na-notaryo pa ang testamento...
Dialogue: 0,0:26:58.86,0:27:00.56,Default,,0,0,0,,bago tayo ikasal.
Dialogue: 0,0:27:00.91,0:27:03.09,Default,,0,0,0,,Tiyak na iba ang mga conglomerates.
Dialogue: 0,0:27:03.12,0:27:04.64,Default,,0,0,0,,Sobrang kumpleto sila.
Dialogue: 0,0:27:04.66,0:27:06.44,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:27:06.62,0:27:08.72,Default,,0,0,0,,Masaya lang ako...
Dialogue: 0,0:27:08.75,0:27:13.45,Default,,0,0,0,,na makakatakas ako sa kanila\Nsafe and sound sa loob ng tatlong buwan.
Dialogue: 0,0:27:15.50,0:27:18.44,Default,,0,0,0,,Pero isipin mo ito.
Dialogue: 0,0:27:18.47,0:27:24.00,Default,,0,0,0,,Bakit binigyan ka ng Diyos ng tatlong buwang iyon?
Dialogue: 0,0:27:24.14,0:27:25.84,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:27:26.89,0:27:27.95,Default,,0,0,0,,Attorney Baek.
Dialogue: 0,0:27:27.97,0:27:30.12,Default,,0,0,0,,Mag-usap tayo nang propesyonal.
Dialogue: 0,0:27:30.14,0:27:33.37,Default,,0,0,0,,Alam mong malaya siyang mag-revise\Nher will sa tatlong buwang iyon.
Dialogue: 0,0:27:33.40,0:27:36.08,Default,,0,0,0,,Kailangan mo lang siyang manalo\Nover sa susunod na tatlong buwan,
Dialogue: 0,0:27:36.11,0:27:38.96,Default,,0,0,0,,kaya maiisip niya, "Sus,\Ndapat mahal na mahal niya ako."
Dialogue: 0,0:27:38.99,0:27:44.73,Default,,0,0,0,,"Dapat kong ibigay ang aking pinakamamahal\NQueens Department Store bago ako mamatay."
Dialogue: 0,0:27:47.08,0:27:48.14,Default,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:27:48.16,0:27:51.22,Default,,0,0,0,,Ang tatlong buwan ay wala pagkatapos\Npaglilingkod ng dalawang taon sa militar.
Dialogue: 0,0:27:51.25,0:27:52.85,Default,,0,0,0,,Isaalang-alang iyon at magiging mas madali ito.
Dialogue: 0,0:27:52.87,0:27:55.33,Default,,0,0,0,,Ilagay ang iyong puso at kaluluwa...
Dialogue: 0,0:27:55.54,0:27:57.24,Default,,0,0,0,,sa pagmamahal sa kanya.
Dialogue: 0,0:28:01.80,0:28:03.58,Default,,0,0,0,,Ikaw.
Dialogue: 0,0:28:04.39,0:28:06.92,Default,,0,0,0,,Seryoso ka bang iniisip...
Dialogue: 0,0:28:09.02,0:28:10.93,Default,,0,0,0,,Ganun ba ako materialistic?
Dialogue: 0,0:28:20.03,0:28:21.42,Default,,0,0,0,,Para saan iyon?
Dialogue: 0,0:28:21.44,0:28:24.01,Default,,0,0,0,,Ngayon ang anibersaryo ng kasal namin.
Dialogue: 0,0:28:24.06,0:28:25.09,Default,,0,0,0,,So?
Dialogue: 0,0:28:25.12,0:28:27.80,Default,,0,0,0,,Nagpareserba ako at\Nnaghanda ng sorpresa dalawang taon na ang nakakaraan,
Dialogue: 0,0:28:27.83,0:28:30.85,Default,,0,0,0,,pero nagalit ka at\Nsabi sa akin na huwag gumawa ng eksena.
Dialogue: 0,0:28:30.87,0:28:33.14,Default,,0,0,0,,- So?\N- So wala akong pinaghandaan last year,
Dialogue: 0,0:28:33.16,0:28:35.30,Default,,0,0,0,,pero nagalit ka pa\Nna nakinig talaga ako,
Dialogue: 0,0:28:35.32,0:28:38.08,Default,,0,0,0,,at tinanong kung mamamatay ako kung sasabihin mo sa akin.
Dialogue: 0,0:28:38.13,0:28:40.52,Default,,0,0,0,,Nandito ka ba para mangulit tungkol sa hindi pagkakapare-pareho ko?
Dialogue: 0,0:28:40.55,0:28:42.96,Default,,0,0,0,,Hindi, siyempre hindi.
Dialogue: 0,0:28:44.38,0:28:47.11,Default,,0,0,0,,Anong uri ng tao ang nagdadala ng mga bulaklak sa nitpick?
Dialogue: 0,0:28:47.14,0:28:50.28,Default,,0,0,0,,Kung ganoon, naging napakaganda ng kasal natin kaya't magdadala ka ng mga bulaklak...
Dialogue: 0,0:28:50.31,0:28:51.97,Default,,0,0,0,,sa ating anibersaryo?
Dialogue: 0,0:28:53.64,0:28:55.34,Default,,0,0,0,,To be honest,
Dialogue: 0,0:28:55.48,0:28:57.51,Default,,0,0,0,,Hindi ko masasabing oo diyan,
Dialogue: 0,0:28:57.81,0:29:01.43,Default,,0,0,0,,ngunit maaari nating gawin itong kaibig-ibig, hindi ba?
Dialogue: 0,0:29:04.86,0:29:06.56,Default,,0,0,0,,Masaya...
Dialogue: 0,0:29:11.04,0:29:12.99,Default,,0,0,0,,anibersaryo ng kasal.
Dialogue: 0,0:29:31.14,0:29:33.30,Default,,0,0,0,,Dalhan mo ako ng vase.
Dialogue: 0,0:29:34.14,0:29:35.79,Default,,0,0,0,,{\i1}Kumusta ang mga bagay?{\i0}
Dialogue: 0,0:29:35.81,0:29:38.87,Default,,0,0,0,,Nag-away ba sila o anupaman?
Dialogue: 0,0:29:38.90,0:29:41.46,Default,,0,0,0,,Hindi, hindi nila ginawa. sa halip...
Dialogue: 0,0:29:41.48,0:29:44.19,Default,,0,0,0,,- "Sa halip"?\N- Naging malapit na sila.
Dialogue: 0,0:29:44.49,0:29:46.38,Default,,0,0,0,,- "Malapit"?\N- Oo.
Dialogue: 0,0:29:46.40,0:29:50.32,Default,,0,0,0,,{\i1}Masyado siyang inaalagaan.\NIIto ay hindi katulad niya.{\i0}
Dialogue: 0,0:29:51.58,0:29:54.57,Default,,0,0,0,,Lagi bang para sa sampu ang talahanayang ito?
Dialogue: 0,0:29:55.75,0:29:57.53,Default,,0,0,0,,Labindalawa.
Dialogue: 0,0:30:06.26,0:30:08.54,Default,,0,0,0,,Palagi kaming dalawa lang,
Dialogue: 0,0:30:11.93,0:30:13.84,Default,,0,0,0,,pero magkalayo kami ng upuan.
Dialogue: 0,0:30:17.23,0:30:18.41,Default,,0,0,0,,Anong problema mo?
Dialogue: 0,0:30:18.44,0:30:20.14,Default,,0,0,0,,I will now...
Dialogue: 0,0:30:21.56,0:30:23.68,Default,,0,0,0,,umupo ka rito.
Dialogue: 0,0:30:52.97,0:30:57.41,Default,,0,0,0,,Masyadong maraming kontra sa kontrata.
Dialogue: 0,0:30:57.43,0:31:00.12,Default,,0,0,0,,Kailangan naming ibigay ang bayad sa pagsasaayos ng tindahan.
Dialogue: 0,0:31:00.14,0:31:03.50,Default,,0,0,0,,I don't think it's that\Nlaking loss on our part,
Dialogue: 0,0:31:03.52,0:31:05.54,Default,,0,0,0,,ibinigay ang kasikatan ng brand.
Dialogue: 0,0:31:05.57,0:31:08.92,Default,,0,0,0,,Tama, ngunit hindi sila kinakailangan\Nupang manatili sa isang tiyak na tagal ng panahon.
Dialogue: 0,0:31:08.95,0:31:11.01,Default,,0,0,0,,Sabihin nating gumastos kami ng $5 milyon...
Dialogue: 0,0:31:11.03,0:31:12.84,Default,,0,0,0,,upang dalhin sila.
Dialogue: 0,0:31:12.87,0:31:15.72,Default,,0,0,0,,Wala tayong karapatang pigilan sila\Kung gusto nilang umalis pagkalipas ng isang taon.
Dialogue: 0,0:31:15.74,0:31:18.89,Default,,0,0,0,,Kinakailangan din kaming magbayad\Na ng penalty kung malaman nila...
Dialogue: 0,0:31:18.91,0:31:22.12,Default,,0,0,0,,nagbebenta ang mga tao ng mga pekeng produkto.
Dialogue: 0,0:31:25.71,0:31:27.37,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,0:31:29.38,0:31:30.61,Default,,0,0,0,,Maghintay. okay lang ako...
Dialogue: 0,0:31:30.63,0:31:32.42,Default,,0,0,0,,Huwag magsalita. Hayaan mo ako.
Dialogue: 0,0:31:32.47,0:31:35.00,Default,,0,0,0,,- Mangyaring tumawag ng ambulansya.\N- Sorry?
Dialogue: 0,0:31:36.89,0:31:37.87,Default,,0,0,0,,Okay lang ako.
Dialogue: 0,0:31:37.89,0:31:39.88,Default,,0,0,0,,Ikaw ba talaga?
Dialogue: 0,0:31:40.60,0:31:42.80,Default,,0,0,0,,Nasakal lang ako ng tubig.
Dialogue: 0,0:31:45.27,0:31:46.75,Default,,0,0,0,,- Talaga?\N- Oo.
Dialogue: 0,0:31:46.77,0:31:48.48,Default,,0,0,0,,So?
Dialogue: 0,0:31:48.61,0:31:50.48,Default,,0,0,0,,Pwede ba tayong ipagpatuloy?
Dialogue: 0,0:31:50.57,0:31:52.10,Default,,0,0,0,,Oo, sir.
Dialogue: 0,0:31:52.82,0:31:54.94,Default,,0,0,0,,Hindi na kailangan ng ambulansya.
Dialogue: 0,0:31:59.41,0:32:00.76,Default,,0,0,0,,Ano ang pumasok sa kanya?
Dialogue: 0,0:32:00.79,0:32:02.47,Default,,0,0,0,,Sinusubukan lang niyang mabuhay.
Dialogue: 0,0:32:02.50,0:32:03.73,Default,,0,0,0,,Paalam, ginoo.
Dialogue: 0,0:32:03.75,0:32:06.16,Default,,0,0,0,,Tatawagan kita mamaya. Paalam.
Dialogue: 0,0:32:08.13,0:32:09.32,Default,,0,0,0,,Kung nanatili siya,
Dialogue: 0,0:32:09.34,0:32:12.86,Default,,0,0,0,,galit na sana siya\Nna wala siyang ginawa.
Dialogue: 0,0:32:12.88,0:32:16.13,Default,,0,0,0,,Masama talaga ang loob ko sa kanya.
Dialogue: 0,0:32:22.85,0:32:25.47,Default,,0,0,0,,Malamig. Dapat maghintay ka na lang sa loob.
Dialogue: 0,0:32:29.69,0:32:32.02,Default,,0,0,0,,Nagyeyelo ka.
Dialogue: 0,0:32:32.82,0:32:35.36,Default,,0,0,0,,Paano kung sipon ka?
Dialogue: 0,0:32:36.74,0:32:38.53,Default,,0,0,0,,Sus.
Dialogue: 0,0:32:41.45,0:32:43.95,Default,,0,0,0,,Bakit ang lamig ng mga kamay mo?
Dialogue: 0,0:32:45.63,0:32:48.87,Default,,0,0,0,,Secretary Na, malapit na ba ang sasakyan?
Dialogue: 0,0:32:49.80,0:32:51.83,Default,,0,0,0,,Well, oo.
Dialogue: 0,0:32:52.13,0:32:53.71,Default,,0,0,0,,Magiging okay ka ba?
Dialogue: 0,0:32:53.93,0:32:56.38,Default,,0,0,0,,Dapat ba akong tumawag ng ambulansya?
Dialogue: 0,0:33:00.64,0:33:02.34,Default,,0,0,0,,Ayan na.
Dialogue: 0,0:33:19.99,0:33:21.86,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:33:23.75,0:33:25.60,Default,,0,0,0,,Sus.
Dialogue: 0,0:33:25.62,0:33:27.91,Default,,0,0,0,,Dapat lang silang makipagtalo.
Dialogue: 0,0:33:28.21,0:33:30.08,Default,,0,0,0,,Ano ang pumasok sa kanya?
Dialogue: 0,0:33:38.30,0:33:40.11,Default,,0,0,0,,Diba sabi ko sayo?
Dialogue: 0,0:33:40.14,0:33:42.01,Default,,0,0,0,,Huwag magdrama.
Dialogue: 0,0:33:43.77,0:33:47.55,Default,,0,0,0,,Hae-in, hindi ako marunong magdrama.
Dialogue: 0,0:33:53.86,0:33:55.69,Default,,0,0,0,,{\i1}Ito{\i0} ay pagiging dramatiko.
Dialogue: 0,0:34:05.87,0:34:07.53,Default,,0,0,0,,Paumanhin.
Dialogue: 0,0:34:17.38,0:34:19.86,Default,,0,0,0,,{\i1}Hindi ko alam kung bakit...{\i0}
Dialogue: 0,0:34:19.89,0:34:23.03,Default,,0,0,0,,Hyun-woo reminds me of Grace Kelly.
Dialogue: 0,0:34:23.06,0:34:24.78,Default,,0,0,0,,Hindi ba siya nagpakasal sa isang hari?
Dialogue: 0,0:34:24.81,0:34:26.99,Default,,0,0,0,,- Pinaalala niya sakin si Diana.\N- Mali yun.
Dialogue: 0,0:34:27.02,0:34:29.41,Default,,0,0,0,,Naghiwalay ang dalawa.
Dialogue: 0,0:34:29.44,0:34:30.62,Default,,0,0,0,,- Sorry.\N- Mi-seon.
Dialogue: 0,0:34:30.65,0:34:32.92,Default,,0,0,0,,Pumunta ako dito para ayusin ang buhok ko, hindi bunutin.
Dialogue: 0,0:34:32.94,0:34:34.46,Default,,0,0,0,,sabi ko sorry.
Dialogue: 0,0:34:34.48,0:34:38.34,Default,,0,0,0,,Baka kasi housewife kami,\Npero hindi mo talaga kami tinatrato ng maayos.
Dialogue: 0,0:34:38.36,0:34:39.92,Default,,0,0,0,,- Sumasang-ayon ako.\N- Maging tapat ka sa amin.
Dialogue: 0,0:34:39.95,0:34:42.30,Default,,0,0,0,,Nakakainis ka ba kapag pinag-uusapan natin ang hitsura ni Hyun-woo?
Dialogue: 0,0:34:42.32,0:34:44.89,Default,,0,0,0,, Si Hyun-woo ay palaging maganda.
Dialogue: 0,0:34:44.91,0:34:45.97,Default,,0,0,0,,Hindi naman sa ganun.
Dialogue: 0,0:34:46.00,0:34:47.16,Default,,0,0,0,,Tama.
Dialogue: 0,0:34:47.19,0:34:48.18,Default,,0,0,0,,Narinig mo ba?
Dialogue: 0,0:34:48.21,0:34:50.68,Default,,0,0,0,,- Tungkol saan?\N- Ang anak ng electronics store.
Dialogue: 0,0:34:50.71,0:34:53.83,Default,,0,0,0,,- Kaninong mga in-law ang mga doktor?\N- Oo.
Dialogue: 0,0:34:54.54,0:34:56.15,Default,,0,0,0,,- Maghihiwalay na sila.\N- Talaga?
Dialogue: 0,0:34:56.17,0:34:57.57,Default,,0,0,0,,- Seryoso?\N- Oo!
Dialogue: 0,0:34:57.59,0:34:59.94,Default,,0,0,0,,- Goodness.\N- Goodness.
Dialogue: 0,0:34:59.97,0:35:02.86,Default,,0,0,0,,Sus, hindi iyon malaking bagay.
Dialogue: 0,0:35:02.89,0:35:04.57,Default,,0,0,0,,Ang mga diborsyo ay karaniwan sa mga araw na ito.
Dialogue: 0,0:35:04.60,0:35:07.49,Default,,0,0,0,,Mayroon pang mga palabas sa TV\Nnagtatampok ng mga hiwalay na mag-asawa.
Dialogue: 0,0:35:07.52,0:35:10.16,Default,,0,0,0,,Hindi nakakahiya ang hiwalayan ngayon.
Dialogue: 0,0:35:10.19,0:35:13.33,Default,,0,0,0,,Nahihiya siguro ang kanyang ina na makita ang kanyang mga kapitbahay.
Dialogue: 0,0:35:13.36,0:35:17.34,Default,,0,0,0,,Palagi siyang nagyayabang\Natungkol sa pagiging doktor ng kanyang manugang.
Dialogue: 0,0:35:17.36,0:35:18.84,Default,,0,0,0,,Akala ko doktor din siya.
Dialogue: 0,0:35:18.86,0:35:21.55,Default,,0,0,0,,Palagi siyang nagbibigay ng payo\Nsa iba kung sila ay masama.
Dialogue: 0,0:35:21.57,0:35:23.49,Default,,0,0,0,,- Sabihin mo sa akin.\N- Bakit sila naghihiwalay?
Dialogue: 0,0:35:23.51,0:35:24.68,Default,,0,0,0,,Masyado silang magkaiba.
Dialogue: 0,0:35:24.70,0:35:26.22,Default,,0,0,0,,Sinabi ko na sa iyo noon.
Dialogue: 0,0:35:26.24,0:35:30.49,Default,,0,0,0,,Hindi magtatagal ang kasal kung masyadong iba ang asawa\Nand ang asawa,
Dialogue: 0,0:35:33.08,0:35:35.99,Default,,0,0,0,,pero hindi ko sinasabing ganyan palagi.
Dialogue: 0,0:35:36.30,0:35:38.36,Default,,0,0,0,,Masaya bang kasal si Hyun-woo?
Dialogue: 0,0:35:38.38,0:35:40.65,Default,,0,0,0,,Syempre siya.
Dialogue: 0,0:35:40.68,0:35:42.36,Default,,0,0,0,,Pero alam mo kung ano ang sinasabi nila.
Dialogue: 0,0:35:42.39,0:35:45.11,Default,,0,0,0,,Mababa ang tingin ng mga nasa Seoul sa mga katulad namin.
Dialogue: 0,0:35:45.14,0:35:46.20,Default,,0,0,0,,Tama,
Dialogue: 0,0:35:46.22,0:35:49.72,Default,,0,0,0,,at ikinasal si Hyun-woo\Nsa isang conglomerate family.
Dialogue: 0,0:35:50.14,0:35:52.37,Default,,0,0,0,,Hindi ganyan ang hipag ko.
Dialogue: 0,0:35:52.40,0:35:55.60,Default,,0,0,0,,Tama. sigurado ako.
Dialogue: 0,0:35:56.11,0:35:59.39,Default,,0,0,0,,Kung gayon bakit hindi siya dumalo\Sa ika-60 na kaarawan ng tatay mo?
Dialogue: 0,0:36:00.03,0:36:02.92,Default,,0,0,0,,Nagsimulang magtsismisan ang mga tao pagkatapos.
Dialogue: 0,0:36:02.95,0:36:04.84,Default,,0,0,0,,- Sinasabi?\N- Na hindi sila magkasundo.
Dialogue: 0,0:36:04.87,0:36:06.80,Default,,0,0,0,,Sa tingin nila Hyun-woo ay hindi ginagamot nang maayos.
Dialogue: 0,0:36:06.83,0:36:08.91,Default,,0,0,0,,Yung hindi maganda ang pakikitungo sa mga in-laws...
Dialogue: 0,0:36:08.94,0:36:11.72,Default,,0,0,0,,attend birthday party\Nand magpanggap na tulad nila.
Dialogue: 0,0:36:11.75,0:36:14.01,Default,,0,0,0,,Ngunit ang mga taong tulad niya na\Nare good sa kanilang in-laws...
Dialogue: 0,0:36:14.03,0:36:16.12,Default,,0,0,0,,hindi na kailangang gawin iyon.
Dialogue: 0,0:36:16.25,0:36:18.62,Default,,0,0,0,,I see, pero galit ka ba?
Dialogue: 0,0:36:19.01,0:36:20.44,Default,,0,0,0,,Bakit ako magagalit?
Dialogue: 0,0:36:20.46,0:36:24.04,Default,,0,0,0,,Pagkatapos ay paluwagin ang mga kamao na iyon,\Hindi ka makakarating ng suntok.
Dialogue: 0,0:36:27.68,0:36:29.70,Default,,0,0,0,,- Sakit ng ulo ko.\N- Ano bang problema niya?
Dialogue: 0,0:36:29.72,0:36:31.41,Default,,0,0,0,,- Galit siya.\N- I see.
Dialogue: 0,0:36:31.43,0:36:33.29,Default,,0,0,0,,Masakit ang buong katawan ko ngayon.
Dialogue: 0,0:36:33.31,0:36:34.37,Default,,0,0,0,,Huwag magtapon ng mga bagay.
Dialogue: 0,0:36:34.40,0:36:37.76,Default,,0,0,0,,Nanunuod si Pinky, alam mo ba?
Dialogue: 0,0:36:40.03,0:36:42.05,Default,,0,0,0,,Hyun-woo, ang tanga.
Dialogue: 0,0:36:42.07,0:36:45.38,Default,,0,0,0,,Naiintindihan ko. Ang pag-aaral ng abogasya sa SNU\Nmarahil ay naging mapagmataas siya,
Dialogue: 0,0:36:45.41,0:36:48.23,Default,,0,0,0,,kaya mahirap na\Nbrown-nose isang conglomerate family,
Dialogue: 0,0:36:48.26,0:36:51.05,Default,,0,0,0,,pero hindi ba mas mabuting\Nbrown-nose sila, kung meron man?
Dialogue: 0,0:36:51.08,0:36:53.52,Default,,0,0,0,,Siyempre. Ako ay brown-nose\Nmiddle-schoolers bawat buwan.
Dialogue: 0,0:36:53.54,0:36:55.48,Default,,0,0,0,,- Bakit?\N- Kaya nagparehistro sila para sa susunod na buwan.
Dialogue: 0,0:36:55.50,0:36:57.93,Default,,0,0,0,,Uy, hindi ko rin mga kamay ang\Npapanatili ako sa negosyo.
Dialogue: 0,0:36:57.96,0:36:59.27,Default,,0,0,0,,Hindi naman. Ito ang aking bibig.
Dialogue: 0,0:36:59.30,0:37:02.90,Default,,0,0,0,,"Gosh, ang ganda mo\Ntoday. Glowing ang balat mo!"
Dialogue: 0,0:37:02.92,0:37:06.07,Default,,0,0,0,,"Mukhang mas bata ka ng sampung taon sa\Nbagong gupit na ito." Yan ang sinasabi ko.
Dialogue: 0,0:37:06.09,0:37:07.95,Default,,0,0,0,,Sana maging katulad natin si Hyun-woo.
Dialogue: 0,0:37:07.97,0:37:09.07,Default,,0,0,0,,Sus.
Dialogue: 0,0:37:09.10,0:37:11.47,Default,,0,0,0,,Na-dote ako sa kanya ng sobra.
Dialogue: 0,0:37:11.93,0:37:14.87,Default,,0,0,0,,Nay, hindi ba dapat may gawin ka tungkol dito?
Dialogue: 0,0:37:14.89,0:37:18.50,Default,,0,0,0,,- Baka talaga makipagdivorce siya.\N- Hindi big deal ang divorce.
Dialogue: 0,0:37:18.52,0:37:19.96,Default,,0,0,0,,Honey.
Dialogue: 0,0:37:19.98,0:37:23.21,Default,,0,0,0,,Nagdidiborsiyo ang mga tao kapag iniisip nila\Nnasa bingit na sila ng kamatayan.
Dialogue: 0,0:37:23.24,0:37:25.35,Default,,0,0,0,,Mas maganda kung hiwalayan.
Dialogue: 0,0:37:26.32,0:37:28.13,Default,,0,0,0,,Masarap ang noodles.
Dialogue: 0,0:37:28.16,0:37:29.94,Default,,0,0,0,,Higit pang sesame oil?
Dialogue: 0,0:37:29.99,0:37:31.99,Default,,0,0,0,,Oo, magdagdag pa.
Dialogue: 0,0:37:40.67,0:37:43.48,Default,,0,0,0,,{\i1}Naghanda ako ng iba't ibang pagkain para sa bawat isa sa inyo,{\i0}
Dialogue: 0,0:37:43.51,0:37:46.21,Default,,0,0,0,,{\i1}batay sa mga resulta ng pagsusuri sa dugo noong nakaraang linggo.{\i0}
Dialogue: 0,0:37:46.38,0:37:49.15,Default,,0,0,0,,Para naman sa vice chairman,\NI ay naghanda ng low-FODMAP diet...
Dialogue: 0,0:37:49.18,0:37:51.37,Default,,0,0,0,,para sa iyong irritable bowel syndrome.
Dialogue: 0,0:37:51.39,0:37:52.92,Default,,0,0,0,,Salamat.
Dialogue: 0,0:38:02.15,0:38:03.13,Default,,0,0,0,,Nasaan si Lolo?
Dialogue: 0,0:38:03.15,0:38:06.84,Default,,0,0,0,,Kailangan niyang mag-fast para sa kanyang\Nmedical checkup bukas.
Dialogue: 0,0:38:06.86,0:38:10.84,Default,,0,0,0,,Pustahan ako na mabubuhay siya hanggang 120 years old.
Dialogue: 0,0:38:10.87,0:38:12.93,Default,,0,0,0,,Walang karne ang akin.
Dialogue: 0,0:38:12.95,0:38:15.57,Default,,0,0,0,,Dahil sa cholesterol mo.
Dialogue: 0,0:38:18.73,0:38:19.79,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:38:19.82,0:38:20.81,Default,,0,0,0,,Oo?
Dialogue: 0,0:38:20.84,0:38:23.65,Default,,0,0,0,,Makakatanggap ka ng certification\Nof content bukas.
Dialogue: 0,0:38:23.67,0:38:26.69,Default,,0,0,0,,Magsasampa ako ng kaso kung paano\Nyou binuo ang iyong department store...
Dialogue: 0,0:38:26.72,0:38:29.88,Default,,0,0,0,,sa aking lupain sa Gwanggyo.
Dialogue: 0,0:38:30.43,0:38:34.03,Default,,0,0,0,,Napag-usapan na namin ito\Nnang nagsimula ang construction,
Dialogue: 0,0:38:34.06,0:38:35.87,Default,,0,0,0,,at hindi ganoon kalaki ang lupain.
Dialogue: 0,0:38:35.89,0:38:39.83,Default,,0,0,0,,Makinig. Nagsimula ang lahat ng digmaan dahil\Walang partido ang tumawid...
Dialogue: 0,0:38:39.85,0:38:42.89,Default,,0,0,0,,- lupain ng ibang partido.\N- Ibinigay mo sa akin ang iyong pahintulot.
Dialogue: 0,0:38:44.11,0:38:47.98,Default,,0,0,0,,Ginawa ko, ngunit tutol si Attorney Shim.
Dialogue: 0,0:38:48.03,0:38:51.13,Default,,0,0,0,,Baka kumalat ang tsismis tungkol sa\Npaano kita binigyan ng espesyal na pagtrato,
Dialogue: 0,0:38:51.16,0:38:53.59,Default,,0,0,0,,at maaaring kailangan kong magbayad ng buwis sa regalo.
Dialogue: 0,0:38:53.62,0:38:56.26,Default,,0,0,0,,Kaya magsasampa ka ng kaso,\Nngayon na ang gusali...
Dialogue: 0,0:38:56.29,0:38:57.43,Default,,0,0,0,,nagawa na?
Dialogue: 0,0:38:57.46,0:38:58.97,Default,,0,0,0,,Hindi mo pa nabubuksan.
Dialogue: 0,0:38:59.00,0:39:02.14,Default,,0,0,0,,Nakikita ko. Tapos dapat ko bang i-demolish?
Dialogue: 0,0:39:02.17,0:39:05.36,Default,,0,0,0,,Hae-in, ayaw na niyang pahabain ang kaso.
Dialogue: 0,0:39:05.38,0:39:07.75,Default,,0,0,0,,Gusto niyang makipag-ayos.
Dialogue: 0,0:39:07.84,0:39:09.82,Default,,0,0,0,,- Hyun-woo.\N- Oo, sir.
Dialogue: 0,0:39:09.84,0:39:13.21,Default,,0,0,0,,Tingnan mo ito kasama niya, at lumapit\Nup na may naaangkop na sukat.
Dialogue: 0,0:39:18.10,0:39:20.01,Default,,0,0,0,,"Isang naaangkop na panukala"?
Dialogue: 0,0:39:20.98,0:39:25.47,Default,,0,0,0,,Ano ang ibig sabihin nito? Dapat bang matakot at umatras ang\NI?
Dialogue: 0,0:39:25.61,0:39:28.25,Default,,0,0,0,,Ito ba ang ibig mong sabihin\Nnung sinabi mong dalhin ito?
Dialogue: 0,0:39:28.28,0:39:30.30,Default,,0,0,0,,Pinagbabantaan mo ako ng demandang iyon.
Dialogue: 0,0:39:30.32,0:39:31.76,Default,,0,0,0,,Ang sinasabi ko ay...
Dialogue: 0,0:39:31.78,0:39:33.40,Default,,0,0,0,,Sa tingin ko...
Dialogue: 0,0:39:36.70,0:39:37.68,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:39:37.70,0:39:40.02,Default,,0,0,0,,Pinutol mo lang ba ako?
Dialogue: 0,0:39:40.04,0:39:41.91,Default,,0,0,0,,Humihingi ako ng paumanhin,
Dialogue: 0,0:39:42.23,0:39:44.94,Default,,0,0,0,,pero dahil nagsampa ka na ng reklamo,
Dialogue: 0,0:39:44.96,0:39:47.81,Default,,0,0,0,, titingnan namin ito at ibibigay sa iyo ang aming tugon.
Dialogue: 0,0:39:47.84,0:39:50.57,Default,,0,0,0,,Gayunpaman, malalaman ng press\Natungkol dito sa proseso,
Dialogue: 0,0:39:50.59,0:39:53.03,Default,,0,0,0,,at maaaring magdulot iyon ng pagbagsak\Nin ang presyo ng stock at higit pa.
Dialogue: 0,0:39:53.05,0:39:55.67,Default,,0,0,0,,Kailangan kong ipaalam sa kanyang lolo.
Dialogue: 0,0:39:57.26,0:39:58.97,Default,,0,0,0,,Gagawin ko yan.
Dialogue: 0,0:39:59.35,0:40:01.89,Default,,0,0,0,,Yes, ma'am. Pagkatapos ay iyon na ang lahat.
Dialogue: 0,0:40:03.98,0:40:06.52,Default,,0,0,0,,Medyo masama ang pakiramdam niya.
Dialogue: 0,0:40:07.40,0:40:09.02,Default,,0,0,0,,Patawarin mo kami.
Dialogue: 0,0:40:24.63,0:40:27.44,Default,,0,0,0,,Gusto mong ilihim ito sa iyong pamilya.
Dialogue: 0,0:40:27.49,0:40:28.48,Default,,0,0,0,,Pero?
Dialogue: 0,0:40:28.50,0:40:31.78,Default,,0,0,0,,Pero hindi ba sila maghihinala na may nangyari,
Dialogue: 0,0:40:31.80,0:40:35.29,Default,,0,0,0,,kung tensyonado na kayong lahat at\Nanginginig ang mga kamao mo?
Dialogue: 0,0:40:36.26,0:40:40.47,Default,,0,0,0,,Tama. Alam kong ako ay kumikilos nang wala sa pagkatao,
Dialogue: 0,0:40:40.52,0:40:42.63,Default,,0,0,0,,pero paano ka?
Dialogue: 0,0:40:42.94,0:40:45.58,Default,,0,0,0,,You interrupted my mom and sided with me.
Dialogue: 0,0:40:45.60,0:40:48.01,Default,,0,0,0,,Tinignan mo rin ako sa mata nang buong pagmamahal.
Dialogue: 0,0:40:53.11,0:40:55.90,Default,,0,0,0,,Ikaw ang pinaka kahina-hinala.
Dialogue: 0,0:40:56.95,0:40:58.90,Default,,0,0,0,,Kumilos ka lang gaya ng dati.
Dialogue: 0,0:41:00.83,0:41:03.66,Default,,0,0,0,,Kailan ka pa nagbalat ng hipon para sa akin?
Dialogue: 0,0:41:10.17,0:41:13.33,Default,,0,0,0,,{\i1}Hindi ito gagana para sa amin.{\i0}
Dialogue: 0,0:41:18.68,0:41:20.66,Default,,0,0,0,,Imposible.
Dialogue: 0,0:41:20.68,0:41:23.54,Default,,0,0,0,,Paano tayo magbabago pagkatapos ng\Ntaon ng pamumuhay bilang mga estranghero?
Dialogue: 0,0:41:23.56,0:41:24.73,Default,,0,0,0,,Pero hindi ba iyon ang nangyari...
Dialogue: 0,0:41:24.76,0:41:26.12,Default,,0,0,0,,- tatlong taon na ang nakalipas?\N- Ano?
Dialogue: 0,0:41:26.15,0:41:28.01,Default,,0,0,0,,Hindi ka ba in love?
Dialogue: 0,0:41:28.11,0:41:30.38,Default,,0,0,0,,- That was...\N- Pareho kayong head over heels.
Dialogue: 0,0:41:30.40,0:41:32.75,Default,,0,0,0,,Binisita ka niya sakay ng helicopter...
Dialogue: 0,0:41:32.78,0:41:34.59,Default,,0,0,0,,at sumuway sa kanyang mga magulang. Ikaw din.
Dialogue: 0,0:41:34.61,0:41:36.21,Default,,0,0,0,,Hindi ka rin matino noon.
Dialogue: 0,0:41:36.24,0:41:38.18,Default,,0,0,0,,Nabaliw ka sa pag-ibig,
Dialogue: 0,0:41:38.20,0:41:41.28,Default,,0,0,0,,so di ba love yun?
Dialogue: 0,0:41:43.16,0:41:44.26,Default,,0,0,0,,Iyon ay ilang taon na ang nakalipas.
Dialogue: 0,0:41:44.29,0:41:46.68,Default,,0,0,0,,Oo, tama ka, pero\Nbigyan kita ng halimbawa.
Dialogue: 0,0:41:46.71,0:41:49.88,Default,,0,0,0,,Natutunan natin kung paano mabuhay sa tubig bilang\Nkids. Tapos ilang dekada na kaming hindi lumangoy.
Dialogue: 0,0:41:49.91,0:41:52.17,Default,,0,0,0,,Kahit mapunta tayo sa tubig\Nagain, lulutang pa rin tayo.
Dialogue: 0,0:41:52.19,0:41:55.36,Default,,0,0,0,,Maaaring isipin mong nakalimutan mo na ang lahat,\Npero naaalala ng iyong katawan.
Dialogue: 0,0:41:55.38,0:41:56.69,Default,,0,0,0,,Gayundin sa pag-ibig.
Dialogue: 0,0:41:56.72,0:41:58.86,Default,,0,0,0,,Maaaring isipin mong nakalimutan mo kung paano ito gawin,
Dialogue: 0,0:41:58.89,0:42:01.45,Default,,0,0,0,,pero naaalala ng puso mo kapag nakapasok ka na dito.
Dialogue: 0,0:42:01.47,0:42:03.24,Default,,0,0,0,,Ngunit hindi ito tulad ng paglangoy.
Dialogue: 0,0:42:03.27,0:42:06.22,Default,,0,0,0,,Siyempre ganun. Ang pagiging in love ay hindi espesyal.
Dialogue: 0,0:42:10.44,0:42:12.35,Default,,0,0,0,,Kakaiba, di ba?
Dialogue: 0,0:42:12.73,0:42:15.31,Default,,0,0,0,,Nagpakasal kami dahil in love kami,
Dialogue: 0,0:42:15.78,0:42:17.46,Default,,0,0,0,,so bakit nawawala yung pagmamahal na yun?
Dialogue: 0,0:42:17.49,0:42:19.26,Default,,0,0,0,,Bilang abogado ng diborsiyo,
Dialogue: 0,0:42:19.28,0:42:23.40,Default,,0,0,0,,I think the problem is\Nthat marriage is exclusive.
Dialogue: 0,0:42:23.45,0:42:25.26,Default,,0,0,0,,Hindi kailangang subukan ng mga mag-asawa,
Dialogue: 0,0:42:25.29,0:42:27.06,Default,,0,0,0,,kaya madismaya sila at lumaban.
Dialogue: 0,0:42:27.08,0:42:30.64,Default,,0,0,0,,Tapos lumapit sila sa akin. Ang pag-aasawa\Nginagawa lang na imposible...
Dialogue: 0,0:42:30.67,0:42:33.45,Default,,0,0,0,,upang manatili sa pag-ibig.
Dialogue: 0,0:42:37.84,0:42:41.09,Default,,0,0,0,,- Sa tingin mo ba?\N- Sa tingin ko, mas mabuting huwag kang magpakasal,
Dialogue: 0,0:42:41.14,0:42:44.26,Default,,0,0,0,,kung gusto mong magmahal ng matagal.
Dialogue: 0,0:43:15.71,0:43:19.12,Default,,0,0,0,,Mangyaring tanggapin ito bilang\Ntoken ng aking pagmamahal at katapatan.
Dialogue: 0,0:43:33.86,0:43:35.77,Default,,0,0,0,,Honey.
Dialogue: 0,0:43:36.40,0:43:38.25,Default,,0,0,0,,Nababaliw ka na ba? Hindi siya ang iyong "Honey."
Dialogue: 0,0:43:38.28,0:43:40.48,Default,,0,0,0,,Ang tagal na, Secretary Kim.
Dialogue: 0,0:43:40.65,0:43:42.61,Default,,0,0,0,,Hello, ma'am.
Dialogue: 0,0:43:43.99,0:43:46.85,Default,,0,0,0,,Ikakasal ka na? kayong dalawa?
Dialogue: 0,0:43:46.87,0:43:48.90,Default,,0,0,0,,At sa Korea noon?
Dialogue: 0,0:43:49.04,0:43:50.52,Default,,0,0,0,,Tama.
Dialogue: 0,0:43:50.54,0:43:53.02,Default,,0,0,0,,Narinig mo siguro na nasa kulungan ako.
Dialogue: 0,0:43:53.04,0:43:54.44,Default,,0,0,0,,Kaya bumalik ka.
Dialogue: 0,0:43:54.46,0:43:56.02,Default,,0,0,0,,Pero nakakahiya.
Dialogue: 0,0:43:56.05,0:43:59.37,Default,,0,0,0,,Nakalabas ako.
Dialogue: 0,0:44:06.31,0:44:07.84,Default,,0,0,0,,Calm down, Honey.
Dialogue: 0,0:44:09.64,0:44:11.08,Default,,0,0,0,,Ano ang sinabi ko sa iyo?
Dialogue: 0,0:44:11.10,0:44:13.00,Default,,0,0,0,,Sabi ko ililibre ko ang buhay mo...
Dialogue: 0,0:44:13.02,0:44:17.25,Default,,0,0,0,,basta umalis ka ng bansa at humiga.
Dialogue: 0,0:44:17.27,0:44:18.71,Default,,0,0,0,,- Tama.\N- So how dare you...
Dialogue: 0,0:44:18.73,0:44:21.34,Default,,0,0,0,,magpakasal sa harap ng lahat ng kamag-anak mo,
Dialogue: 0,0:44:21.36,0:44:23.31,Default,,0,0,0,,nung niloko mo ako?
Dialogue: 0,0:44:29.62,0:44:31.32,Default,,0,0,0,,Honey.
Dialogue: 0,0:44:31.79,0:44:33.53,Default,,0,0,0,,Honey.
Dialogue: 0,0:44:41.30,0:44:43.04,Default,,0,0,0,,Honey.
Dialogue: 0,0:44:44.30,0:44:46.59,Default,,0,0,0,,Honey!
Dialogue: 0,0:45:02.78,0:45:05.55,Default,,0,0,0,,Ma'am, may dugo ka...
Dialogue: 0,0:45:05.57,0:45:07.57,Default,,0,0,0,,Hindi akin.
Dialogue: 0,0:45:10.41,0:45:12.97,Default,,0,0,0,,- Saan?\N- Sa pisngi mo.
Dialogue: 0,0:45:13.00,0:45:15.23,Default,,0,0,0,,Hindi mo dapat gawin ito kapag nasa probation ka.
Dialogue: 0,0:45:15.25,0:45:17.99,Default,,0,0,0,,Maaari kang mapalubha\Nkaparusahan para sa pananakit at paninirang-puri.
Dialogue: 0,0:45:18.01,0:45:22.30,Default,,0,0,0,,Defamation? Malayo diyan ang nagawa ko sa mga manloloko.
Dialogue: 0,0:45:23.47,0:45:25.86,Default,,0,0,0,,Dapat ko bang ipakita sa iyo kung ano ang tunay na paninirang-puri?
Dialogue: 0,0:45:25.88,0:45:28.91,Default,,0,0,0,,Maaari kang makulong\Nuntil 60 ka na kung gagawin mo iyon.
Dialogue: 0,0:45:28.93,0:45:30.84,Default,,0,0,0,,Magiging okay ba iyon?
Dialogue: 0,0:45:31.56,0:45:33.37,Default,,0,0,0,,Nakipag-ayos na ako sa kanilang abogado.
Dialogue: 0,0:45:33.39,0:45:34.41,Default,,0,0,0,,Magkano?
Dialogue: 0,0:45:34.44,0:45:36.20,Default,,0,0,0,,- Gusto mo bang malaman?\N- Kalimutan mo na.
Dialogue: 0,0:45:36.23,0:45:38.54,Default,,0,0,0,,Sapat na para magtayo ng pool sa kanilang tahanan.
Dialogue: 0,0:45:38.56,0:45:40.81,Default,,0,0,0,,Hindi mo dapat ginawa iyon.
Dialogue: 0,0:45:41.23,0:45:43.35,Default,,0,0,0,,Naiinis ka pa rin ba sa kanila?
Dialogue: 0,0:45:47.24,0:45:48.76,Default,,0,0,0,,Naninigarilyo ka ba?
Dialogue: 0,0:45:48.78,0:45:50.51,Default,,0,0,0,,- I quit.\N- Kasi ginagawa ko.
Dialogue: 0,0:45:50.53,0:45:54.65,Default,,0,0,0,,Natuto akong manigarilyo dahil niloko ako ng mga ex-husband ko.
Dialogue: 0,0:45:56.96,0:45:58.27,Default,,0,0,0,,Hindi ka maaaring manigarilyo dito.
Dialogue: 0,0:45:58.29,0:46:00.27,Default,,0,0,0,,Tara na.
Dialogue: 0,0:46:00.29,0:46:02.20,Default,,0,0,0,,Go? saan?
Dialogue: 0,0:46:04.72,0:46:05.73,Default,,0,0,0,,Darn it.
Dialogue: 0,0:46:05.76,0:46:08.29,Default,,0,0,0,,Naghihingalo akong makalabas sa kulungan,
Dialogue: 0,0:46:09.34,0:46:12.21,Default,,0,0,0,,pero ngayong nasa labas na ako, wala nang mapupuntahan.
Dialogue: 0,0:46:13.68,0:46:15.38,Default,,0,0,0,,Uuwi ka na.
Dialogue: 0,0:46:16.27,0:46:18.80,Default,,0,0,0,,Hinihintay ka ng chairman.
Dialogue: 0,0:46:28.36,0:46:29.59,Default,,0,0,0,,Beom-ja.
Dialogue: 0,0:46:29.62,0:46:33.11,Default,,0,0,0,,Balita ko hindi ka kumain buong araw.
Dialogue: 0,0:46:40.46,0:46:43.31,Default,,0,0,0,,Ano sa iyo kung mamatay ako sa gutom o hindi?
Dialogue: 0,0:46:43.34,0:46:45.65,Default,,0,0,0,,Inilagay mo ako sa likod ng bar dahil wala kang pakialam.
Dialogue: 0,0:46:45.67,0:46:48.74,Default,,0,0,0,,Sus, hindi ako ang gumawa niyan.
Dialogue: 0,0:46:48.76,0:46:53.16,Default,,0,0,0,,Inatake mo ang isang inosenteng babae,
Dialogue: 0,0:46:53.18,0:46:55.84,Default,,0,0,0,,kaya pinarusahan ka sa iyong mga aksyon.
Dialogue: 0,0:46:56.93,0:46:58.33,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:46:58.35,0:47:00.96,Default,,0,0,0,,Ang babaeng pumatay kay Nanay at\Nnaging madam ng tahanan...
Dialogue: 0,0:47:00.99,0:47:03.21,Default,,0,0,0,,ay ganap na inosente.
Dialogue: 0,0:47:03.23,0:47:06.09,Default,,0,0,0,,Hindi siya ang ginang ng tahanan.
Dialogue: 0,0:47:06.11,0:47:08.25,Default,,0,0,0,,Wala siya sa rehistro ng aming pamilya.
Dialogue: 0,0:47:08.28,0:47:11.38,Default,,0,0,0,,Ang ginawa ko lang ay marahan siyang hinawakan sa buhok, pero ako ang makasalanan dito.
Dialogue: 0,0:47:11.41,0:47:14.05,Default,,0,0,0,,Hindi mo masasabing malumanay\Nnang dumulas ang kanyang disc.
Dialogue: 0,0:47:14.08,0:47:18.49,Default,,0,0,0,,Exactly, so mind your own business\Nand let me die for slipping her disc!
Dialogue: 0,0:47:24.00,0:47:26.69,Default,,0,0,0,,Hey, Beom-ja.
Dialogue: 0,0:47:26.71,0:47:28.73,Default,,0,0,0,,Mali ang ideya mo tungkol sa kanya.
Dialogue: 0,0:47:28.76,0:47:31.95,Default,,0,0,0,,Walang gusto si Seul-hee sa amin.
Dialogue: 0,0:47:31.97,0:47:34.88,Default,,0,0,0,,Hindi siya interesado sa\Nfortune o maging pamilya.
Dialogue: 0,0:47:35.64,0:47:38.62,Default,,0,0,0,,Mas nakakatakot yun.
Dialogue: 0,0:47:38.64,0:47:42.54,Default,,0,0,0,,Anong engrandeng plano ang kanyang pinaplano\Nupang mamuhay kasama ka at wala siyang gusto?
Dialogue: 0,0:47:42.56,0:47:46.52,Default,,0,0,0,,Ikaw ay isang geezer na may toneladang pera!
Dialogue: 0,0:47:47.19,0:47:50.05,Default,,0,0,0,,Hoy!
Dialogue: 0,0:47:50.07,0:47:51.30,Default,,0,0,0,,Sus.
Dialogue: 0,0:47:51.32,0:47:54.88,Default,,0,0,0,,I wonder when she'll wise up.
Dialogue: 0,0:47:54.91,0:47:59.18,Default,,0,0,0,,Wala na akong pag-asa since\Nshe's already in her fifties, right?
Dialogue: 0,0:47:59.20,0:48:00.85,Default,,0,0,0,,Huwag hayaang abalahin ka nito.
Dialogue: 0,0:48:00.87,0:48:03.81,Default,,0,0,0,,Nga pala, alam kong hindi ako makakapareha sayo,
Dialogue: 0,0:48:03.83,0:48:07.08,Default,,0,0,0,,ngunit hindi ka nakatutok sa laro.
Dialogue: 0,0:48:07.67,0:48:09.46,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:48:13.30,0:48:16.28,Default,,0,0,0,,- Goodness.\N- Hindi makakatulong ang pagtitig sa board.
Dialogue: 0,0:48:16.31,0:48:18.63,Default,,0,0,0,,Kailangan mong makita ang mas malaking larawan.
Dialogue: 0,0:48:18.68,0:48:20.22,Default,,0,0,0,,Tama ka.
Dialogue: 0,0:48:21.60,0:48:25.10,Default,,0,0,0,,Mahuhuli ka kung tatakas ka sa takot.
Dialogue: 0,0:48:30.44,0:48:32.84,Default,,0,0,0,,Pero kung susubukan mong hulihin ang tigre...
Dialogue: 0,0:48:32.86,0:48:37.07,Default,,0,0,0,,nang hindi inihahanda,
Dialogue: 0,0:48:37.45,0:48:39.18,Default,,0,0,0,, mawawala sa iyo ang lahat.
Dialogue: 0,0:48:39.20,0:48:41.15,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:48:41.41,0:48:45.45,Default,,0,0,0,,Ito ang dahilan kung bakit maaaring turuan ka ng {\i1}janggi{\i0} ng mga aralin sa buhay.
Dialogue: 0,0:49:13.20,0:49:15.31,Default,,0,0,0,,Ako ang pumalit sa iyong palasyo.
Dialogue: 0,0:49:15.82,0:49:17.51,Default,,0,0,0,,Saan tatakas ang hari ngayon?
Dialogue: 0,0:49:17.53,0:49:19.44,Default,,0,0,0,,Checkmate.
Dialogue: 0,0:49:20.99,0:49:23.78,Default,,0,0,0,,Nakita mo ba itong darating,
Dialogue: 0,0:49:23.96,0:49:26.60,Default,,0,0,0,,o sinuwerte ka lang?
Dialogue: 0,0:49:26.63,0:49:28.58,Default,,0,0,0,,Hindi ako sigurado.
Dialogue: 0,0:49:29.21,0:49:32.19,Default,,0,0,0,,Kailangan mo akong bigyan ng isang pabor, dahil natalo ka.
Dialogue: 0,0:49:32.21,0:49:33.44,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:49:33.47,0:49:37.71,Default,,0,0,0,,Sasabihin ko sa iyo kapag mayroon na ako.
Dialogue: 0,0:49:45.98,0:49:48.37,Default,,0,0,0,,Honey, nakita mo ba yun?
Dialogue: 0,0:49:48.40,0:49:51.27,Default,,0,0,0,,I think I just saw a shooting star.
Dialogue: 0,0:49:51.44,0:49:55.00,Default,,0,0,0,,Hindi ko alam na makikita ko sila sa Seoul.
Dialogue: 0,0:49:55.03,0:49:58.31,Default,,0,0,0,,Nangarap kang makapag-shoot ng\Nstars bago magkaroon ng Hae-in.
Dialogue: 0,0:50:00.91,0:50:02.49,Default,,0,0,0,,Ako ba?
Dialogue: 0,0:50:03.41,0:50:06.31,Default,,0,0,0,,Excited ka dahil akala mo magkakaroon ka ng baby girl.
Dialogue: 0,0:50:06.33,0:50:10.49,Default,,0,0,0,,Hindi ako sigurado. Hindi ko masyadong maalala.
Dialogue: 0,0:50:11.13,0:50:14.29,Default,,0,0,0,,Honey, huwag kang masyadong malupit kay Hae-in.
Dialogue: 0,0:50:16.17,0:50:17.83,Default,,0,0,0,,Ano ang ginawa ko?
Dialogue: 0,0:50:18.51,0:50:22.37,Default,,0,0,0,,Hanggang kailan mo hahayaan ang iyong nakaraan na sumama sa iyo?
Dialogue: 0,0:50:22.39,0:50:25.38,Default,,0,0,0,,Dapat kang bumitaw at magpatuloy.
Dialogue: 0,0:50:26.27,0:50:29.25,Default,,0,0,0,,Iyan ang sinabi mo noon.\NYang tatay mo ay ayaw ng anumang isyu,
Dialogue: 0,0:50:29.27,0:50:30.83,Default,,0,0,0,,kaya obligado ka.
Dialogue: 0,0:50:30.86,0:50:33.63,Default,,0,0,0,,Hindi ko pa rin maintindihan kung bakit kinailangang mamatay si Su-wan.
Dialogue: 0,0:50:33.65,0:50:36.84,Default,,0,0,0,,Aksidente lang. Walang dapat sisihin.
Dialogue: 0,0:50:36.86,0:50:39.72,Default,,0,0,0,,Tama ka. Walang kasalanan,
Dialogue: 0,0:50:39.74,0:50:42.15,Default,,0,0,0,,pero wala na si Su-wan.
Dialogue: 0,0:50:43.12,0:50:46.86,Default,,0,0,0,,Galit pa rin ako at nasasaktan araw-araw.
Dialogue: 0,0:50:47.08,0:50:48.78,Default,,0,0,0,,Sa iba...
Dialogue: 0,0:50:49.25,0:50:51.27,Default,,0,0,0,,Sa iyo, ito ay isang nakaraang kaganapan lamang,
Dialogue: 0,0:50:51.29,0:50:53.74,Default,,0,0,0,,ngunit binabalikan ko ang sandaling iyon araw-araw.
Dialogue: 0,0:50:55.26,0:50:58.50,Default,,0,0,0,,Ako ay pinagmumultuhan ng araw na nawala ang aking anak,
Dialogue: 0,0:51:00.47,0:51:03.96,Default,,0,0,0,,kaya huwag kang umasa na ako ay makatuwiran.
Dialogue: 0,0:51:50.02,0:51:52.97,Default,,0,0,0,,Bakit hindi pa siya umuuwi?
Dialogue: 0,0:51:54.40,0:51:56.35,Default,,0,0,0,,May sakit ba talaga siya?
Dialogue: 0,0:51:57.11,0:51:59.23,Default,,0,0,0,,Siya ay may mahusay na stamina.
Dialogue: 0,0:52:00.45,0:52:05.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}To be honest, napakababa ng chance niya\Nof survival,{\c}{\i0}
Dialogue: 0,0:52:05.99,0:52:08.68,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ngunit nangyayari ang mga himala.{\c}{\i0}
Dialogue: 0,0:52:08.70,0:52:10.39,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Paumanhin?{\c}{\i0}
Dialogue: 0,0:52:10.41,0:52:13.56,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gaano kadalas nangyayari ang mga himalang ito?{\c}{\i0}
Dialogue: 0,0:52:13.58,0:52:15.52,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Madalas ba itong mangyari?{\c}{\i0}
Dialogue: 0,0:52:15.54,0:52:17.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sa loob ng 30 taon ko bilang doktor,{\c}{\i0}
Dialogue: 0,0:52:17.80,0:52:21.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nasaksihan ko ang maraming pasyente\Nkahimalang gumaling...{\c}{\i0}
Dialogue: 0,0:52:21.88,0:52:25.32,Default,,0,0,0,,{\i1}{\c&HFFFF00&}mula sa hindi gaanong pag-asa na mga sakit.{\c}{\i0}
Dialogue: 0,0:52:25.35,0:52:27.88,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Huwag mawalan ng pag-asa.{\c}{\i0}
Dialogue: 0,0:52:29.35,0:52:31.02,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}mga klinikal na kaso para sa mga tumor sa utak{\c}{\i0}
Dialogue: 0,0:52:33.56,0:52:35.40,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Malignant tumor\NDwag sumuko sa paggamot{\c}{\i0}
Dialogue: 0,0:52:45.82,0:52:49.55,Default,,0,0,0,,{\an8}"Binigyan ng tatlong buwan upang mabuhay,\Nngunit buhay pa rin pagkatapos ng 30 taon."
Dialogue: 0,0:52:49.58,0:52:51.11,Default,,0,0,0,,30 taon?
Dialogue: 0,0:52:51.71,0:52:53.57,Default,,0,0,0,,Seryoso?
Dialogue: 0,0:52:56.92,0:53:00.58,Default,,0,0,0,,Hindi ko alam na ito ay karaniwan.
Dialogue: 0,0:53:01.72,0:53:05.50,Default,,0,0,0,,Sa palagay ko ay hindi laging tama ang hula ng isang doktor.
Dialogue: 0,0:53:05.68,0:53:08.21,Default,,0,0,0,,Ito ay... Gosh.
Dialogue: 0,0:53:08.47,0:53:10.24,Default,,0,0,0,,Ito ay hindi katulad ng mga drama.
Dialogue: 0,0:53:10.27,0:53:16.87,Default,,0,0,0,,"Nawala ang mga tumor pagkatapos\Ngising. Isang kaso na imposibleng medikal."
Dialogue: 0,0:53:16.90,0:53:20.60,Default,,0,0,0,,Paano ito magiging imposibleng medikal?
Dialogue: 0,0:53:20.98,0:53:23.27,Default,,0,0,0,,Ito ba ang katotohanan...
Dialogue: 0,0:53:24.20,0:53:27.23,Default,,0,0,0,,ng modernong medisina? talaga?
Dialogue: 0,0:54:41.31,0:54:44.00,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Maaari pa ring gumaling ang mga pasyenteng may sakit na terminal{\c}{\i0}
Dialogue: 0,0:54:44.03,0:54:46.38,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Binigyan ng 3 buwan bago mabuhay,\Nngunit buhay pa rin pagkatapos ng 30 taon{\c}{\i0}
Dialogue: 0,0:55:00.00,0:55:02.52,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ang mahimalang paggaling ng pancreatic cancer ko{\c}{\i0}
Dialogue: 0,0:55:02.54,0:55:04.33,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Yung kumakapit sa pag-asa{\c}{\i0}
Dialogue: 0,0:55:14.10,0:55:15.80,Default,,0,0,0,,Hey, Hae-in.
Dialogue: 0,0:55:17.73,0:55:19.80,Default,,0,0,0,,Kailan ka pumasok?
Dialogue: 0,0:55:23.77,0:55:26.43,Default,,0,0,0,,Bakit dito ka natutulog? Matulog sa kama.
Dialogue: 0,0:55:27.69,0:55:30.02,Default,,0,0,0,,Tama, dapat.
Dialogue: 0,0:55:31.24,0:55:32.77,Default,,0,0,0,,Ikaw din dapat.
Dialogue: 0,0:55:33.66,0:55:35.19,Default,,0,0,0,,Magandang gabi.
Dialogue: 0,0:55:47.59,0:55:49.17,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:55:50.51,0:55:52.04,Default,,0,0,0,,Oo?
Dialogue: 0,0:55:52.72,0:55:54.30,Default,,0,0,0,,To be honest,
Dialogue: 0,0:55:54.64,0:55:59.38,Default,,0,0,0,,hinala kita.
Dialogue: 0,0:56:00.94,0:56:02.72,Default,,0,0,0,,Ano?
Dialogue: 0,0:56:06.23,0:56:10.39,Default,,0,0,0,,Akala ko matutuwa kang marinig na namamatay na ako.
Dialogue: 0,0:56:10.57,0:56:14.11,Default,,0,0,0,,Akala ko iyon ang dahilan kung bakit napakabuti mo sa akin.
Dialogue: 0,0:56:15.70,0:56:18.44,Default,,0,0,0,,Naghinala din ako na mayroon kang...
Dialogue: 0,0:56:18.58,0:56:20.70,Default,,0,0,0,,isang lihim na motibo.
Dialogue: 0,0:56:22.37,0:56:23.98,Default,,0,0,0,,Aaminin ko...
Dialogue: 0,0:56:24.00,0:56:25.87,Default,,0,0,0,,Medyo naghinala ako.
Dialogue: 0,0:56:26.09,0:56:29.75,Default,,0,0,0,,Hindi ko alam na hinahanap mo ang mga bagay na iyon.
Dialogue: 0,0:56:37.72,0:56:42.76,Default,,0,0,0,,Ang mga himalang ito ay nangyayari nang mas madalas kaysa sa iyong iniisip.
Dialogue: 0,0:56:44.85,0:56:46.56,Default,,0,0,0,,Ano...?
Dialogue: 0,0:56:46.73,0:56:49.23,Default,,0,0,0,,Hindi mo kailangang pumunta dito.
Dialogue: 0,0:56:52.90,0:56:56.86,Default,,0,0,0,,Huwag mag-alala. Mabubuhay ako, anuman ang mangyari.
Dialogue: 0,0:56:58.12,0:56:59.55,Default,,0,0,0,,Matigas ako,
Dialogue: 0,0:56:59.58,0:57:02.14,Default,,0,0,0,,ngunit nabigla ako nang marinig ang aking diagnosis.
Dialogue: 0,0:57:02.16,0:57:03.64,Default,,0,0,0,,Nasiraan ako ng loob.
Dialogue: 0,0:57:03.67,0:57:08.04,Default,,0,0,0,,A part of me didn't care about\Nano ang mangyayari sa akin.
Dialogue: 0,0:57:08.25,0:57:10.90,Default,,0,0,0,,"Kung meron lang talaga akong tatlong buwan,"
Dialogue: 0,0:57:10.92,0:57:13.11,Default,,0,0,0,,"makakatulong ba ang pagtanggap ng paggamot?"
Dialogue: 0,0:57:13.13,0:57:15.04,Default,,0,0,0,,"Susuko na lang ba ako?"
Dialogue: 0,0:57:15.64,0:57:18.66,Default,,0,0,0,,"Walang magluluksa sa aking kamatayan,"
Dialogue: 0,0:57:18.68,0:57:20.80,Default,,0,0,0,,"kahit ang pamilya ko."
Dialogue: 0,0:57:21.06,0:57:23.55,Default,,0,0,0,,Nagkaroon ako ng lahat ng uri ng iniisip.
Dialogue: 0,0:57:25.73,0:57:27.29,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:57:27.31,0:57:30.77,Default,,0,0,0,,Pero may isang tao.
Dialogue: 0,0:57:32.82,0:57:37.23,Default,,0,0,0,,Ikaw sa lahat ng tao ang gusto kong mabuhay.
Dialogue: 0,0:57:37.41,0:57:38.94,Default,,0,0,0,,Ako?
Dialogue: 0,0:57:39.78,0:57:42.78,Default,,0,0,0,,Oo. Syempre.
Dialogue: 0,0:57:43.16,0:57:45.87,Default,,0,0,0,,Oo, ginagawa ko.
Dialogue: 0,0:57:46.83,0:57:49.29,Default,,0,0,0,,Naging mahirap para sa akin.
Dialogue: 0,0:57:50.75,0:57:55.25,Default,,0,0,0,,Sobrang hirap hawakan,\Nngunit ang makita kita ay nagbibigay sa akin ng pag-asa.
Dialogue: 0,0:57:56.01,0:57:57.07,Default,,0,0,0,,Gumawa ako ng sarili kong pananaliksik.
Dialogue: 0,0:57:57.09,0:57:59.95,Default,,0,0,0,,Hindi tulad sa Korea, may mga katulad na kaso sa ibang bansa.
Dialogue: 0,0:57:59.97,0:58:03.80,Default,,0,0,0,,Maraming lab diyan\Nna gumagawa ng mga bagong gamot.
Dialogue: 0,0:58:03.85,0:58:07.66,Default,,0,0,0,,Mapapabilis nila ang proseso,\Basta may pondo sila.
Dialogue: 0,0:58:07.69,0:58:11.97,Default,,0,0,0,,Aktibong titingnan ko ang pagsuporta sa kanila.
Dialogue: 0,0:58:12.61,0:58:14.39,Default,,0,0,0,,Talaga?
Dialogue: 0,0:58:15.15,0:58:17.02,Default,,0,0,0,,Ganyan ka ba kasaya?
Dialogue: 0,0:58:18.36,0:58:20.15,Default,,0,0,0,,Oo.
Dialogue: 0,0:58:20.58,0:58:22.74,Default,,0,0,0,,Siyempre ako.
Dialogue: 0,0:58:27.96,0:58:29.70,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:58:29.83,0:58:34.71,Default,,0,0,0,,Hindi ako mamamatay nang ganoon kadali, alang-alang sa iyo.
Dialogue: 0,0:59:13.42,0:59:15.11,Default,,0,0,0,,Para ba ito sa iyong social-media account?
Dialogue: 0,0:59:15.13,0:59:17.19,Default,,0,0,0,,Paano kung parte lang ng mukha mo?
Dialogue: 0,0:59:17.22,0:59:19.15,Default,,0,0,0,,Gusto ko talagang makita ka ng mundo.
Dialogue: 0,0:59:19.18,0:59:21.20,Default,,0,0,0,,Ngunit magpo-post ang media ng mga artikulo tungkol sa akin,
Dialogue: 0,0:59:21.22,0:59:25.16,Default,,0,0,0,,at hindi iyon gusto ng iyong mga magulang.
Dialogue: 0,0:59:25.18,0:59:26.41,Default,,0,0,0,,Ayokong mag-alala sila.
Dialogue: 0,0:59:26.43,0:59:28.38,Default,,0,0,0,,Ikaw talaga...!
Dialogue: 0,0:59:29.60,0:59:31.30,Default,,0,0,0,,Sige.
Dialogue: 0,0:59:34.02,0:59:35.00,Default,,0,0,0,,Gayundin,
Dialogue: 0,0:59:35.02,0:59:38.92,Default,,0,0,0,,Sinabi sa akin ni Jun-ho na ilihim ito,\Ndahil hindi pa ito nakumpirma.
Dialogue: 0,0:59:38.95,0:59:41.01,Default,,0,0,0,,Ang aming finance director? Tungkol saan?
Dialogue: 0,0:59:41.03,0:59:44.01,Default,,0,0,0,,Nakakatakot ang pakiramdam niya tungkol sa $8 milyon.
Dialogue: 0,0:59:44.03,0:59:45.58,Default,,0,0,0,,It's totally fine.
Dialogue: 0,0:59:45.60,0:59:46.60,Default,,0,0,0,,Gayunpaman.
Dialogue: 0,0:59:46.62,0:59:49.85,Default,,0,0,0,,Sinusubukan ka niyang i-hook up sa\Nisang tao para makabawi.
Dialogue: 0,0:59:49.87,0:59:52.27,Default,,0,0,0,,- Sino?\N- Isang pribadong equity fund investor.
Dialogue: 0,0:59:52.29,0:59:53.44,Default,,0,0,0,,Siya ang...
Dialogue: 0,0:59:53.46,0:59:56.77,Default,,0,0,0,,na nag-invest sa organic\Ncoffee deal para kay Yeom Sang-jin.
Dialogue: 0,0:59:56.80,0:59:58.83,Default,,0,0,0,,Talaga?
Dialogue: 0,1:00:00.05,1:00:03.15,Default,,0,0,0,,Ang pangalan niya ay David Yoon. Siya ay Korean-American.
Dialogue: 0,1:00:03.18,1:00:05.07,Default,,0,0,0,,{\i1}Kamakailan lang ay dumating siya sa Korea.{\i0}
Dialogue: 0,1:00:05.10,1:00:07.28,Default,,0,0,0,,{\i1}May kontrol siya sa pera ng langis sa Middle Eastern,{\i0}
Dialogue: 0,1:00:07.31,1:00:09.54,Default,,0,0,0,,{\i1}at narito siya para maghanap ng mga bagong investment.{\i0}
Dialogue: 0,1:00:09.56,1:00:12.93,Default,,0,0,0,,{\i1}Naghahanap siyang mamuhunan sa\Nleast dalawang bilyong dolyar.{\i0}
Dialogue: 0,1:00:27.24,1:00:31.03,Default,,0,0,0,,{\i1}Sinusubukan ni Hae-in na\Ndalhin si Hercyna sa kanyang tindahan,{\i0}
Dialogue: 0,1:00:31.08,1:00:35.10,Default,,0,0,0,,{\i1}at si David ang dahilan\Nmaaaring ilunsad ang brand...{\i0}
Dialogue: 0,1:00:35.13,1:00:39.20,Default,,0,0,0,,{\i1}kanilang unang Asian flagship store sa Seoul.{\i0}
Dialogue: 0,1:00:49.77,1:00:51.34,Default,,0,0,0,,Kumusta.
Dialogue: 0,1:00:55.36,1:00:57.31,Default,,0,0,0,,Kumusta.
Dialogue: 0,1:00:57.94,1:01:01.42,Default,,0,0,0,,Binabati kita. Gusto ko ang bagong renovation ng iyong seksyon ng pagkain.
Dialogue: 0,1:01:01.44,1:01:03.96,Default,,0,0,0,,Madalas akong kumakain sa food court mo ngayon.
Dialogue: 0,1:01:03.99,1:01:07.59,Default,,0,0,0,,Tama. Balita ko madalas kang dumaan.
Dialogue: 0,1:01:07.62,1:01:10.76,Default,,0,0,0,,Gayunpaman, mahaba\Nway pa ang Royal upang maging sa iyong level.
Dialogue: 0,1:01:10.79,1:01:12.82,Default,,0,0,0,,Ang aming mga dessert ay nangangailangan ng ilang tweaking.
Dialogue: 0,1:01:13.12,1:01:14.48,Default,,0,0,0,,Marami tayong gagawin.
Dialogue: 0,1:01:14.50,1:01:18.60,Default,,0,0,0,,Sa sandaling itayo ang fountain plaza\Nis sa unang palapag,
Dialogue: 0,1:01:18.63,1:01:20.27,Default,,0,0,0,,isasama natin si Hercyna,
Dialogue: 0,1:01:20.30,1:01:22.54,Default,,0,0,0,,at magtatrabaho kami mula doon.
Dialogue: 0,1:01:23.68,1:01:25.11,Default,,0,0,0,,Hindi, kailangan nating magsikap.
Dialogue: 0,1:01:25.13,1:01:27.36,Default,,0,0,0,,Paano kung maganda ang food section natin?
Dialogue: 0,1:01:27.39,1:01:31.42,Default,,0,0,0,,Isang department store na walang\NHercyna ay isang malaking restaurant lang.
Dialogue: 0,1:01:31.47,1:01:34.34,Default,,0,0,0,,May space din kami para kay Hercyna.
Dialogue: 0,1:01:37.81,1:01:39.12,Default,,0,0,0,,Gusto mo ba ng tip?
Dialogue: 0,1:01:39.15,1:01:42.17,Default,,0,0,0,,Sure, kung gusto mong bigyan ako ng isa.
Dialogue: 0,1:01:42.19,1:01:43.88,Default,,0,0,0,,Okay.
Dialogue: 0,1:01:43.90,1:01:46.34,Default,,0,0,0,,Sigurado akong alam mo na si Mr. Hermann...
Dialogue: 0,1:01:46.36,1:01:48.93,Default,,0,0,0,, inuuna ang halaga ng kumpanya at\Nmindset bago ang anumang bagay.
Dialogue: 0,1:01:48.95,1:01:52.30,Default,,0,0,0,,Naniniwala siya na ang mga bumubuo\Nmabuting relasyon sa iba...
Dialogue: 0,1:01:52.33,1:01:55.35,Default,,0,0,0,,ay ang pinakamahusay na mga kasosyo sa negosyo.
Dialogue: 0,1:01:55.37,1:01:56.98,Default,,0,0,0,,Iyan ang paniniwala niya.
Dialogue: 0,1:01:57.00,1:01:58.94,Default,,0,0,0,,- So?\N- Tumingin ka sa paligid mo.
Dialogue: 0,1:01:58.96,1:02:01.79,Default,,0,0,0,,Lahat ng tao dito ay nagdala ng kanilang\Nasawa, kasintahan, o miyembro ng pamilya.
Dialogue: 0,1:02:01.81,1:02:04.78,Default,,0,0,0,,Ikaw lang ang nandito...
Dialogue: 0,1:02:04.80,1:02:06.71,Default,,0,0,0,,na dumating mag-isa.
Dialogue: 0,1:02:06.80,1:02:08.50,Default,,0,0,0,,Ano?
Dialogue: 0,1:02:11.26,1:02:13.41,Default,,0,0,0,,Pinahanga mo ako.
Dialogue: 0,1:02:13.43,1:02:15.37,Default,,0,0,0,,Alam ng lahat na wala kang kaibigan,
Dialogue: 0,1:02:15.39,1:02:19.18,Default,,0,0,0,,pero paano mo maiisip na pumunta\Nito sa lahat ng lugar nang mag-isa?
Dialogue: 0,1:02:20.77,1:02:22.79,Default,,0,0,0,,Ikaw lang ang nag-iisang lobo dito.
Dialogue: 0,1:02:22.82,1:02:25.39,Default,,0,0,0,,Ikaw lang, Hae-in.
Dialogue: 0,1:02:25.74,1:02:27.56,Default,,0,0,0,,Kawawa ka.
Dialogue: 0,1:02:42.21,1:02:43.19,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialogue: 0,1:02:47.51,1:02:50.17,Default,,0,0,0,,- Nasaan ka?\N- {\i1}Nasa trial ako.{\i0}
Dialogue: 0,1:02:58.85,1:03:00.55,Default,,0,0,0,,Ano ang sinabi niya?
Dialogue: 0,1:03:04.19,1:03:05.17,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,1:03:05.19,1:03:07.59,Default,,0,0,0,,Nagtataka kang tumatawag sa\Ng iyong asawa para sa tulong.
Dialogue: 0,1:03:07.61,1:03:08.71,Default,,0,0,0,,Hindi siya darating?
Dialogue: 0,1:03:08.74,1:03:11.82,Default,,0,0,0,,- Nasa trial siya.\N- How fitting.
Dialogue: 0,1:03:11.91,1:03:13.30,Default,,0,0,0,,- Ano?\N- Ano ang magagawa mo?
Dialogue: 0,1:03:13.33,1:03:15.51,Default,,0,0,0,,Hindi mo siya masasabing magpiyansa.
Dialogue: 0,1:03:15.54,1:03:19.10,Default,,0,0,0,,Sa tingin ko iyon ay isang angkop na dahilan.
Dialogue: 0,1:03:19.12,1:03:21.98,Default,,0,0,0,,Hindi ito dahilan. Nasa trial talaga siya.
Dialogue: 0,1:03:22.00,1:03:25.00,Default,,0,0,0,,Bakit ang seryoso mo? nagbibiro lang ako.
Dialogue: 0,1:03:26.05,1:03:28.44,Default,,0,0,0,,Hoy, huwag mong pansinin ang mga tsismis.
Dialogue: 0,1:03:28.47,1:03:29.94,Default,,0,0,0,,Hindi ako naniniwala sa kanila.
Dialogue: 0,1:03:29.97,1:03:32.24,Default,,0,0,0,,- Anong tsismis?\N- Sigurado akong narinig mo...
Dialogue: 0,1:03:32.26,1:03:35.99,Default,,0,0,0,,na naghiwalay na kayong dalawa\Malapit nang maghiwalay si Nand.
Dialogue: 0,1:03:36.02,1:03:40.50,Default,,0,0,0,,Na pinakasalan ka lang niya para sa pera mo.\NI ayoko na silang pag-usapan.
Dialogue: 0,1:03:40.52,1:03:41.50,Default,,0,0,0,,Ngunit mayroon ka.
Dialogue: 0,1:03:41.52,1:03:44.08,Default,,0,0,0,,Halos nasimulan ko na.
Dialogue: 0,1:03:44.11,1:03:46.34,Default,,0,0,0,,Ordinaryong kasal mo sana.
Dialogue: 0,1:03:46.36,1:03:49.63,Default,,0,0,0,,Kahit ang mga tsismoso ay walang masyadong\Npag-uusapan kung nagpakasal ka...
Dialogue: 0,1:03:49.65,1:03:51.47,Default,,0,0,0,,sa sarili mong antas.
Dialogue: 0,1:03:51.49,1:03:53.43,Default,,0,0,0,,May na-realize ako sa buhay.
Dialogue: 0,1:03:53.45,1:03:56.76,Default,,0,0,0,,Ang kasal ay tungkol sa paghahanap ng makakasama sa buhay...
Dialogue: 0,1:03:56.79,1:04:00.99,Default,,0,0,0,,na nakatingin sa parehong direksyon gaya mo.
Dialogue: 0,1:04:02.67,1:04:04.73,Default,,0,0,0,,Ang nakalipas na apat na taon ng kasal...
Dialogue: 0,1:04:04.75,1:04:06.40,Default,,0,0,0,,ay naging mapayapa,
Dialogue: 0,1:04:06.42,1:04:10.46,Default,,0,0,0,,at pumukaw iyon sa curiosity ko tungkol sa\Nmga mag-asawang hindi magkasundo.
Dialogue: 0,1:04:10.80,1:04:14.28,Default,,0,0,0,,Ano ang pakiramdam? Hindi pa ako nagalit sa asawa ko dati.
Dialogue: 0,1:04:14.30,1:04:16.46,Default,,0,0,0,,Bakit mo ako tinatanong?
Dialogue: 0,1:04:17.68,1:04:20.16,Default,,0,0,0,,Hindi mo dapat ilabas ang galit mo sa akin...
Dialogue: 0,1:04:20.18,1:04:22.97,Default,,0,0,0,,para hindi ka mahal ng asawa mo.
Dialogue: 0,1:04:30.40,1:04:33.59,Default,,0,0,0,,Dapat ay pinakasalan mo lang si Yoon Eun-sung.
Dialogue: 0,1:04:33.61,1:04:35.47,Default,,0,0,0,,Bakit bigla mo siyang dadalhin?
Dialogue: 0,1:04:35.49,1:04:38.36,Default,,0,0,0,,Wala kang alam, di ba?
Dialogue: 0,1:04:38.41,1:04:40.72,Default,,0,0,0,,Siya ang kanang kamay ni Mr. Hermann.
Dialogue: 0,1:04:40.75,1:04:44.07,Default,,0,0,0,,Siya ang susi para maabot si Mr. Hermann.
Dialogue: 0,1:04:44.54,1:04:46.08,Default,,0,0,0,,Ano?
Dialogue: 0,1:04:46.13,1:04:49.23,Default,,0,0,0,,Uy, naging successful talaga siya.
Dialogue: 0,1:04:49.26,1:04:51.79,Default,,0,0,0,,Hindi siya pareho noong college.
Dialogue: 0,1:04:52.09,1:04:55.09,Default,,0,0,0,,Siya ang namamahala sa pananalapi ng mga\Nsheikh ngayon.
Dialogue: 0,1:04:55.64,1:04:58.67,Default,,0,0,0,,Kaya pinuntahan ko siya sa airport para batiin.
Dialogue: 0,1:04:58.85,1:05:00.55,Default,,0,0,0,,Eun-sung.
Dialogue: 0,1:05:14.16,1:05:15.90,Default,,0,0,0,,Matagal na.
Dialogue: 0,1:05:19.08,1:05:23.11,Default,,0,0,0,,Dapat ay ipinaalam mo sa akin\Kung nakabalik ka na sa Korea.
Dialogue: 0,1:05:24.67,1:05:27.95,Default,,0,0,0,,Hindi mo ba naaalala ang\Nhuling sinabi mo sa akin?
Dialogue: 0,1:05:28.04,1:05:29.83,Default,,0,0,0,,Para hindi ka makontak.
Dialogue: 0,1:05:30.80,1:05:33.00,Default,,0,0,0,,- Ginawa ko?\N- Oo.
Dialogue: 0,1:05:33.17,1:05:34.86,Default,,0,0,0,,Nagdududa ako.
Dialogue: 0,1:05:34.88,1:05:38.55,Default,,0,0,0,,"Magpatuloy tayong makipag-ugnayan."
Dialogue: 0,1:05:38.85,1:05:40.63,Default,,0,0,0,,Diba yun ang sinabi ko?
Dialogue: 0,1:05:47.94,1:05:51.96,Default,,0,0,0,,Tama ka. Sinabi ko sa iyo na huwag na muling makipag-ugnayan sa akin,
Dialogue: 0,1:05:51.98,1:05:54.39,Default,,0,0,0,,dahil patuloy kang tumatawid sa linya.
Dialogue: 0,1:05:55.49,1:05:58.11,Default,,0,0,0,,Tama, pero ngayon...
Dialogue: 0,1:05:58.32,1:06:01.03,Default,,0,0,0,,parang may sasabihin ka.
Dialogue: 0,1:06:02.04,1:06:04.40,Default,,0,0,0,,Sigurado akong alam mo na ito,
Dialogue: 0,1:06:05.21,1:06:06.35,Default,,0,0,0,,kaya sasabihin ko na lang.
Dialogue: 0,1:06:06.37,1:06:08.89,Default,,0,0,0,,Ye-na and I are in a brutal competition...
Dialogue: 0,1:06:08.92,1:06:10.98,Default,,0,0,0,,upang dalhin si Hercyna sa aming mga tindahan.
Dialogue: 0,1:06:11.00,1:06:15.07,Default,,0,0,0,,Mukhang maganda ang\Nrelationship mo kay Mr. Hermann,
Dialogue: 0,1:06:15.09,1:06:16.63,Default,,0,0,0,,kaya sabihin mo sa akin.
Dialogue: 0,1:06:16.68,1:06:19.38,Default,,0,0,0,,- Pwede mo ba akong tulungan?\N- Ako?
Dialogue: 0,1:06:22.38,1:06:23.91,Default,,0,0,0,,Bakit?
Dialogue: 0,1:06:24.14,1:06:28.10,Default,,0,0,0,,To be honest, wala akong masyadong maalala sa nakaraan,
Dialogue: 0,1:06:28.35,1:06:32.67,Default,,0,0,0,,so bakit hindi na lang natin sabihin na naghiwalay na tayo...
Dialogue: 0,1:06:32.69,1:06:34.56,Default,,0,0,0,, on good terms?
Dialogue: 0,1:06:57.68,1:07:01.00,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kailan matatapos ang trial? Malapit na bang matapos?{\c}{\i0}
Dialogue: 0,1:07:44.47,1:07:46.87,Default,,0,0,0,,- Paano ang trial?\N- Nanalo ako.
Dialogue: 0,1:07:46.89,1:07:49.38,Default,,0,0,0,,Mabilis akong nanalo para pumunta dito.
Dialogue: 0,1:08:41.57,1:08:43.31,Default,,0,0,0,,Eto na.
Dialogue: 0,1:08:47.99,1:08:50.57,Default,,0,0,0,,Isang non-alcoholic cocktail, pakiusap.
Dialogue: 0,1:08:50.91,1:08:53.85,Default,,0,0,0,,Ano ang sinabi mong kasal na naman?
Dialogue: 0,1:08:53.87,1:08:57.54,Default,,0,0,0,,Naghahanap ng kapareha sa buhay na tumingin\Nin sa parehong direksyon gaya mo?
Dialogue: 0,1:08:57.84,1:09:01.82,Default,,0,0,0,,Hindi ko ito nakuha noong una, ngunit\Npagkita sa iyong asawa ay naging malinaw ito.
Dialogue: 0,1:09:01.84,1:09:03.67,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,1:09:03.72,1:09:05.42,Default,,0,0,0,,Nakikita mo,
Dialogue: 0,1:09:05.51,1:09:10.34,Default,,0,0,0,,Mas gusto kong tumingin sa asawa ko kaysa sa ibang lugar.
Dialogue: 0,1:09:11.64,1:09:14.05,Default,,0,0,0,,Ang gwapo niya.
Dialogue: 0,1:09:14.48,1:09:16.01,Default,,0,0,0,,Eto na.
Dialogue: 0,1:09:23.65,1:09:25.80,Default,,0,0,0,,Honey, nasubukan mo na ba ito?
Dialogue: 0,1:09:25.82,1:09:28.48,Default,,0,0,0,,Bagay talaga.
Dialogue: 0,1:09:29.12,1:09:30.89,Default,,0,0,0,,- Pumunta ka ba dito para kumain?\N- Ano?
Dialogue: 0,1:09:30.91,1:09:33.07,Default,,0,0,0,,Ayokong makita ito.
Dialogue: 0,1:09:35.33,1:09:37.91,Default,,0,0,0,, mukha mo ang tinutukoy ko.
Dialogue: 0,1:09:38.13,1:09:39.83,Default,,0,0,0,,Umalis.
Dialogue: 0,1:09:40.17,1:09:42.46,Default,,0,0,0,,Isang puso? Ang liit mo...!
Dialogue: 0,1:09:50.06,1:09:51.76,Default,,0,0,0,,Narito.
Dialogue: 0,1:09:52.60,1:09:54.55,Default,,0,0,0,,Salamat.
Dialogue: 0,1:09:58.11,1:10:00.47,Default,,0,0,0,,Naisip ko si Hae-in paminsan-minsan,
Dialogue: 0,1:10:01.03,1:10:03.39,Default,,0,0,0,,kaya kakaiba ang pakiramdam...
Dialogue: 0,1:10:03.90,1:10:05.60,Default,,0,0,0,,upang makilala ang kanyang asawa.
Dialogue: 0,1:10:10.99,1:10:12.47,Default,,0,0,0,,Paumanhin?
Dialogue: 0,1:10:12.49,1:10:15.70,Default,,0,0,0,,Well, Hae-in and I...
Dialogue: 0,1:10:17.37,1:10:20.66,Default,,0,0,0,,may magandang relasyon sa nakaraan.
Dialogue: 0,1:10:23.92,1:10:25.53,Default,,0,0,0,,Hindi si Hae-in ang tipo...
Dialogue: 0,1:10:25.55,1:10:29.59,Default,,0,0,0,,na nagkaroon ng maraming magagandang\Nrelasyon sa kanyang buhay.
Dialogue: 0,1:10:30.22,1:10:32.13,Default,,0,0,0,,Iyan ay kahanga-hanga.
Dialogue: 0,1:10:33.85,1:10:35.55,Default,,0,0,0,,To be honest,
Dialogue: 0,1:10:37.06,1:10:39.16,Default,,0,0,0,,Nagustuhan ko siya ng sobra.
Dialogue: 0,1:10:40.41,1:10:42.35,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,1:10:43.98,1:10:45.69,Default,,0,0,0,,Hindi ka nakakaabala?
Dialogue: 0,1:10:46.03,1:10:47.21,Default,,0,0,0,,Paumanhin?
Dialogue: 0,1:10:47.24,1:10:50.65,Default,,0,0,0,,Isa lang ang ibig sabihin niyan.
Dialogue: 0,1:10:50.82,1:10:54.36,Default,,0,0,0,,Nagtitiwala ka sa kanya ng buo,\Ni wala kang pakialam.
Dialogue: 0,1:10:56.12,1:10:57.70,Default,,0,0,0,,Ito ba ang huli?
Dialogue: 0,1:11:02.75,1:11:04.33,Default,,0,0,0,,Nagbibiro lang ako.
Dialogue: 0,1:11:09.80,1:11:11.28,Default,,0,0,0,,Mr. Yoon.
Dialogue: 0,1:11:11.30,1:11:12.82,Default,,0,0,0,,Darating.
Dialogue: 0,1:11:12.85,1:11:14.59,Default,,0,0,0,,Paalam.
Dialogue: 0,1:11:21.61,1:11:23.43,Default,,0,0,0,,Yung jerk.
Dialogue: 0,1:11:26.82,1:11:28.52,Default,,0,0,0,,Paano niya nalaman?
Dialogue: 0,1:11:31.57,1:11:33.32,Default,,0,0,0,,Na-offend ako.
Dialogue: 0,1:11:39.33,1:11:40.43,Default,,0,0,0,,Nakakatawa.
Dialogue: 0,1:11:40.46,1:11:43.79,Default,,0,0,0,,{\i1}{\c&HFFFF00&}To be honest, nagustuhan ko siya ng sobra.{\c}{\i0}
Dialogue: 0,1:11:44.09,1:11:46.12,Default,,0,0,0,,Kung siya talaga...
Dialogue: 0,1:11:46.42,1:11:47.65,Default,,0,0,0,,gusto siya ng sobra,
Dialogue: 0,1:11:47.67,1:11:50.40,Default,,0,0,0,,kung gayon dapat ay nagsumikap siya at pinakasalan siya.
Dialogue: 0,1:11:50.43,1:11:53.34,Default,,0,0,0,,Kung ganoon ay ililigtas niya ang buhay ko.
Dialogue: 0,1:11:54.35,1:11:58.17,Default,,0,0,0,,Ano ang silbi ng pagsasabi sa\N tungkol sa kanyang nararamdaman ngayon?
Dialogue: 0,1:11:58.98,1:12:01.43,Default,,0,0,0,,Inaasar niya ba ako, o ano?
Dialogue: 0,1:12:07.57,1:12:09.81,Default,,0,0,0,,Nakakainis na scumbag.
Dialogue: 0,1:13:06.92,1:13:08.50,Default,,0,0,0,,Kumusta.
Dialogue: 0,1:13:09.09,1:13:11.16,Default,,0,0,0,,- Nagkita ulit tayo.\N- Hello.
Dialogue: 0,1:13:11.67,1:13:15.79,Default,,0,0,0,,Sus. Hindi ba masikip ang lugar na ito?
Dialogue: 0,1:13:18.01,1:13:19.32,Default,,0,0,0,,Tama ka.
Dialogue: 0,1:13:19.35,1:13:22.99,Default,,0,0,0,,Higit sa kalahati ng mga taong ito ang pumunta upang makita siya.
Dialogue: 0,1:13:23.02,1:13:25.35,Default,,0,0,0,,Gusto nila siyang makilala.
Dialogue: 0,1:13:27.65,1:13:31.75,Default,,0,0,0,,Ano ang ginagawa niya?
Dialogue: 0,1:13:31.78,1:13:33.38,Default,,0,0,0,,{\i1}Siya ay isang tycoon.{\i0}
Dialogue: 0,1:13:33.40,1:13:35.40,Default,,0,0,0,,Kahit ang pinakamayayamang tao mula sa Wall Street...
Dialogue: 0,1:13:35.43,1:13:39.22,Default,,0,0,0,,manghiram ng oil money sa kanya.
Dialogue: 0,1:13:39.24,1:13:41.72,Default,,0,0,0,,Maging si Chairman Yeom ay naghihingalo na makilala siya.
Dialogue: 0,1:13:41.75,1:13:45.02,Default,,0,0,0,,Sinisikap din ni Soo-cheol na makipagkita sa kanya,
Dialogue: 0,1:13:45.04,1:13:46.52,Default,,0,0,0,,ngunit hindi ito madali.
Dialogue: 0,1:13:46.54,1:13:49.85,Default,,0,0,0,,At itong si Yoon Eun-sung ay nag-aral\Nkaparehas ng kolehiyo ni Hae-in?
Dialogue: 0,1:13:49.88,1:13:51.83,Default,,0,0,0,,Oo.
Dialogue: 0,1:13:51.88,1:13:55.78,Default,,0,0,0,,Hindi ko alam kung ano ang sasabihin\Non sa iyo sa mga panahong tulad nito.
Dialogue: 0,1:13:55.80,1:13:57.07,Default,,0,0,0,,Bakit masama ang pakiramdam mo?
Dialogue: 0,1:13:57.09,1:13:58.45,Default,,0,0,0,,Dapat ako nagpakilala...
Dialogue: 0,1:13:58.47,1:14:01.70,Default,,0,0,0,,isang katulad niya kay Ms. Hong Hae-in.
Dialogue: 0,1:14:01.72,1:14:04.45,Default,,0,0,0,,Ano ang magagawa niya? Naghukay siya ng sariling libingan.
Dialogue: 0,1:14:04.48,1:14:07.50,Default,,0,0,0,,Gayunpaman, pinagsisisihan kong hindi ako nagsisikap.
Dialogue: 0,1:14:07.52,1:14:09.10,Default,,0,0,0,,Para gawin ang ano?
Dialogue: 0,1:14:16.24,1:14:18.88,Default,,0,0,0,,Sa tingin ko nagkakamali ka.
Dialogue: 0,1:14:18.91,1:14:21.73,Default,,0,0,0,,Palagi akong nagpapasalamat...
Dialogue: 0,1:14:22.29,1:14:24.89,Default,,0,0,0,,na hindi mo sinubukan.
Dialogue: 0,1:14:24.91,1:14:28.35,Default,,0,0,0,,Talagang nagpapasalamat ako na\Inalis mo ako sa iyong listahan...
Dialogue: 0,1:14:28.38,1:14:29.73,Default,,0,0,0,,ng mga kandidato sa kasal,
Dialogue: 0,1:14:29.75,1:14:34.75,Default,,0,0,0,,kaya iligtas mo ang iyong sarili sa walang kwentang pagkakasala.
Dialogue: 0,1:14:37.30,1:14:38.28,Default,,0,0,0,,Bakit ka tumawag?
Dialogue: 0,1:14:38.30,1:14:39.82,Default,,0,0,0,,Narinig mo kami.
Dialogue: 0,1:14:39.85,1:14:43.63,Default,,0,0,0,,Imbitahan si Yoon Eun-sung sa aming family hunt.
Dialogue: 0,1:14:46.52,1:14:51.68,Default,,0,0,0,,Tama. Makakasiguro akong\Ndarating siya kung sasabihin ko sa kanya,
Dialogue: 0,1:14:54.32,1:14:57.77,Default,,0,0,0,,pero bakit ko gagawin iyon? Wala akong dahilan para.
Dialogue: 0,1:14:59.78,1:15:01.48,Default,,0,0,0,,Iwi-withdraw ko...
Dialogue: 0,1:15:03.12,1:15:04.94,Default,,0,0,0,,ang demanda.
Dialogue: 0,1:15:34.73,1:15:36.31,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:17:03.24,1:17:05.68,Default,,0,0,0,,Narito ang bilang ng biktima na maaari mong mahuli.
Dialogue: 0,1:17:05.70,1:17:07.89,Default,,0,0,0,,Walang limitasyon para sa mga magpie at uwak.
Dialogue: 0,1:17:07.91,1:17:12.43,Default,,0,0,0,,Kung tungkol sa baboy-ramo, water deer, at pheasants,\Ang bawat isa ay maaaring makahuli ng maximum na lima.
Dialogue: 0,1:17:12.46,1:17:15.69,Default,,0,0,0,,Maaaring mangyari ang isang aksidente kung\Nakakagambala kayo sa isa't isa,
Dialogue: 0,1:17:15.71,1:17:18.02,Default,,0,0,0,,at pinagkamalan nilang hayop ang isa't isa,
Dialogue: 0,1:17:18.05,1:17:21.41,Default,,0,0,0,,kaya siguraduhing manatili ka sa iyong kurso.
Dialogue: 0,1:17:21.72,1:17:24.69,Default,,0,0,0,,Hindi ka dapat manghuli ng baboy na mag-isa.
Dialogue: 0,1:17:24.72,1:17:29.45,Default,,0,0,0,,Huwag puntirya o ibalik ang iyong\N sa kanila kung nag-iisa ka.
Dialogue: 0,1:17:29.47,1:17:30.78,Default,,0,0,0,,Pwede ba natin siyang gamitin ng baril?
Dialogue: 0,1:17:30.81,1:17:31.87,Default,,0,0,0,,Tulad ng alam mo na...
Dialogue: 0,1:17:31.89,1:17:34.84,Default,,0,0,0,,Ano ang magagawa natin? Pinili niyang bitbitin ang isa.
Dialogue: 0,1:17:34.94,1:17:37.14,Default,,0,0,0,,Paano kung siya ay pumatay?
Dialogue: 0,1:17:41.28,1:17:43.80,Default,,0,0,0,,Tingnan mo ang nakamamatay na tingin.
Dialogue: 0,1:17:43.82,1:17:45.42,Default,,0,0,0,,Wala na siya...
Dialogue: 0,1:17:45.45,1:17:48.78,Default,,0,0,0,,sa mental hospital, hindi kulungan.
Dialogue: 0,1:17:49.37,1:17:50.51,Default,,0,0,0,,Tara na.
Dialogue: 0,1:17:50.54,1:17:52.70,Default,,0,0,0,,Tita, kailangan na nating lumipat.
Dialogue: 0,1:17:54.96,1:17:56.82,Default,,0,0,0,,Narito.
Dialogue: 0,1:18:00.00,1:18:02.37,Default,,0,0,0,,Huwag hawakan ang baril nang ganyan.
Dialogue: 0,1:18:10.47,1:18:13.37,Default,,0,0,0,,Natamaan ko ba? Hindi ko masyadong makita.
Dialogue: 0,1:18:13.39,1:18:14.70,Default,,0,0,0,,Ginawa mo, Ama.
Dialogue: 0,1:18:14.73,1:18:18.30,Default,,0,0,0,,Nahulog ang pinakamalaki. sus.
Dialogue: 0,1:18:18.40,1:18:20.72,Default,,0,0,0,,Nakita ko rin, Lolo. sus!
Dialogue: 0,1:18:21.15,1:18:24.55,Default,,0,0,0,,Ikaw ba? Naniniwala akong ginawa ko rin.
Dialogue: 0,1:18:24.57,1:18:26.23,Default,,0,0,0,,Ginawa mo.
Dialogue: 0,1:18:27.78,1:18:29.44,Default,,0,0,0,,Nakuha mo ba talaga?
Dialogue: 0,1:18:29.53,1:18:32.07,Default,,0,0,0,,Sa tingin ko wala sa kanila ang nahulog.
Dialogue: 0,1:18:36.62,1:18:39.06,Default,,0,0,0,,Hyun-woo, ikaw ba ay isang Native American,
Dialogue: 0,1:18:39.08,1:18:41.65,Default,,0,0,0,,o isang Mongolian hunter?\NGanyan ba ang iyong paningin?
Dialogue: 0,1:18:41.67,1:18:43.82,Default,,0,0,0,,Sa tingin ko nahulog ito sa kakahuyan.
Dialogue: 0,1:18:43.84,1:18:46.87,Default,,0,0,0,,Sasabihin ko sa mga tauhan natin na kunin.
Dialogue: 0,1:18:47.30,1:18:50.45,Default,,0,0,0,,Paano kung umuwi si Hyun-woo\Nempty-handed this year, too?
Dialogue: 0,1:18:50.47,1:18:52.05,Default,,0,0,0,,Tama.
Dialogue: 0,1:18:52.14,1:18:53.45,Default,,0,0,0,,Tama siya.
Dialogue: 0,1:18:53.47,1:18:58.47,Default,,0,0,0,,Wala ka pang nahuli sa aming mga pangangaso.
Dialogue: 0,1:19:01.61,1:19:04.59,Default,,0,0,0,,Pumupunta kami dito taun-taon. Dapat matuto ka.
Dialogue: 0,1:19:04.61,1:19:06.96,Default,,0,0,0,,Takot ka ba sa baril?\NNagsilbi ka sa militar,
Dialogue: 0,1:19:06.99,1:19:08.42,Default,,0,0,0,,so dapat ba kitang turuan?
Dialogue: 0,1:19:08.45,1:19:11.22,Default,,0,0,0,,Okay lang yan. Dapat mong alalahanin ang iyong sarili.
Dialogue: 0,1:19:11.24,1:19:14.65,Default,,0,0,0,,Magaling na ako. Kaya't nag-alok akong turuan ka.
Dialogue: 0,1:19:15.54,1:19:17.72,Default,,0,0,0,,Ano naman sayo? Magaling ka ba?
Dialogue: 0,1:19:17.75,1:19:21.14,Default,,0,0,0,,Hindi ako sigurado. Duda ako kung kaya kong hawakan kayong lahat ng kandila.
Dialogue: 0,1:19:21.17,1:19:23.95,Default,,0,0,0,,Mapagpakumbaba siya sa lahat ng paraan.
Dialogue: 0,1:19:24.09,1:19:25.40,Default,,0,0,0,,Tama.
Dialogue: 0,1:19:25.42,1:19:29.49,Default,,0,0,0,,Tingnan natin kung sino ang kukuha ng\Npheasants para sa {\i1}mandu{\i0} na sopas ngayong taon.
Dialogue: 0,1:19:29.51,1:19:31.29,Default,,0,0,0,,Magsimula na tayo.
Dialogue: 0,1:19:31.43,1:19:32.61,Default,,0,0,0,,Tara na.
Dialogue: 0,1:19:32.64,1:19:34.92,Default,,0,0,0,,- Tara na.\N- Sige.
Dialogue: 0,1:19:50.91,1:19:53.02,Default,,0,0,0,,Mahuli ng isang bagay nang isang beses.
Dialogue: 0,1:19:53.58,1:19:57.64,Default,,0,0,0,,May dahilan kung bakit kami dinala ng lolo ko sa bundok na ito...
Dialogue: 0,1:19:57.66,1:19:59.31,Default,,0,0,0,,upang manghuli bawat taon.
Dialogue: 0,1:19:59.33,1:20:00.31,Default,,0,0,0,,Ano ito?
Dialogue: 0,1:20:00.33,1:20:04.10,Default,,0,0,0,,Gusto ba niyang magpanggap tayo\Nmatagumpay siyang nakabaril ng pato,
Dialogue: 0,1:20:04.13,1:20:05.79,Default,,0,0,0,,at purihin siya?
Dialogue: 0,1:20:06.46,1:20:08.40,Default,,0,0,0,,Mahalaga ang stamina kapag nangangaso,
Dialogue: 0,1:20:08.42,1:20:11.11,Default,,0,0,0,,ngunit ang mabilis na paghuhusga at layunin\Nkailangan din ang mga desisyon,
Dialogue: 0,1:20:11.13,1:20:14.66,Default,,0,0,0,,at lahat ng iyon ay mga birtud na dapat taglayin ng mga nagnenegosyo.
Dialogue: 0,1:20:14.68,1:20:16.57,Default,,0,0,0,,Iyan ba ang dahilan kung bakit marami kang nahuhuli bawat taon,
Dialogue: 0,1:20:16.60,1:20:19.63,Default,,0,0,0,,para patunayan sa kanya na ikaw ay\Na karapat-dapat na businesswoman?
Dialogue: 0,1:20:19.81,1:20:21.45,Default,,0,0,0,,Siyempre,
Dialogue: 0,1:20:21.48,1:20:24.93,Default,,0,0,0,,at mas mahuhuli ko rin ngayong taon.
Dialogue: 0,1:20:27.32,1:20:29.77,Default,,0,0,0,,Maghintay ka.
Dialogue: 0,1:20:35.24,1:20:38.03,Default,,0,0,0,,Oo, handa na ito.
Dialogue: 0,1:20:39.91,1:20:42.07,Default,,0,0,0,,Malapit sa gitna...
Dialogue: 0,1:20:42.33,1:20:43.39,Default,,0,0,0,,ng kursong iyon.
Dialogue: 0,1:20:43.42,1:20:45.52,Default,,0,0,0,,{\i1}{\c&HFFFF&}Wild Boar Habitat{\c}{\i0}
Dialogue: 0,1:20:45.54,1:20:47.38,Default,,0,0,0,,{\i1}{\c&HFFFF&}Restricted Area\Nproperty na Pag-aari ng Queens{\c}{\i0}
Dialogue: 0,1:21:07.19,1:21:10.18,Default,,0,0,0,,Saan sa mundo siya?
Dialogue: 0,1:21:10.69,1:21:12.21,Default,,0,0,0,,{\i1}Hindi maikonekta ang iyong tawag.{\i0}
Dialogue: 0,1:21:12.24,1:21:13.94,Default,,0,0,0,,Darn it.
Dialogue: 0,1:21:39.35,1:21:42.80,Default,,0,0,0,,Paumanhin. Akala ko isa kang water deer.
Dialogue: 0,1:21:43.27,1:21:45.18,Default,,0,0,0,,Bakit ka nandito?
Dialogue: 0,1:21:45.31,1:21:47.43,Default,,0,0,0,,Hindi ito ang iyong kurso.
Dialogue: 0,1:21:47.90,1:21:50.89,Default,,0,0,0,,Di ba? First time kong mang-hunting.
Dialogue: 0,1:21:51.28,1:21:55.98,Default,,0,0,0,,Hindi mo ba alam na maaaring nakamamatay ang pagsalakay\Ning teritoryo ng ibang tao kapag nangangaso?
Dialogue: 0,1:21:59.08,1:22:00.82,Default,,0,0,0,,Hindi ko alam yun.
Dialogue: 0,1:22:01.24,1:22:04.70,Default,,0,0,0,,Inaasahan kong matuto pa mula sa iyo.
Dialogue: 0,1:22:20.14,1:22:23.17,Default,,0,0,0,,Wala kang dapat gawin\N sa teritoryo ng ibang tao.
Dialogue: 0,1:22:24.77,1:22:27.72,Default,,0,0,0,,Gusto mo turuan kita di ba?
Dialogue: 0,1:22:50.92,1:22:52.95,Default,,0,0,0,,Ano ang mali sa akin?
Dialogue: 0,1:22:54.38,1:22:56.25,Default,,0,0,0,,Isa lang {\i1}mandu.{\i0}
Dialogue: 0,1:22:56.47,1:22:57.94,Default,,0,0,0,,Pheasant soup lang yan.
Dialogue: 0,1:22:57.97,1:22:59.96,Default,,0,0,0,,Isa itong ibon {\i1}mandu.{\i0}
Dialogue: 0,1:23:00.64,1:23:02.84,Default,,0,0,0,,Pheasant soup.
Dialogue: 0,1:24:08.37,1:24:12.12,Default,,0,0,0,,Huwag lokohin ang sarili mo. Hindi ito totoo.
Dialogue: 0,1:24:12.17,1:24:14.12,Default,,0,0,0,,Snap out of it, Hae-in.
Dialogue: 0,1:24:15.17,1:24:17.25,Default,,0,0,0,,Snap out of it.
Dialogue: 0,1:24:39.03,1:24:40.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ano ang masasabi mo?{\c}{\i0}
Dialogue: 0,1:24:45.99,1:24:49.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ako ay namamatay. May tatlong buwan pa akong natitira.{\c}{\i0}
Dialogue: 0,1:24:50.41,1:24:52.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mahal kita, Hong Hae-in.{\c}{\i0}
Dialogue: 0,1:24:53.12,1:24:54.99,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mahal kita.{\c}{\i0}
Dialogue: 0,1:25:28.91,1:25:30.49,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,1:25:51.93,1:25:54.75,Default,,0,0,0,,Tumanggi kang makipag-date sa\Ncivil servant o music teacher.
Dialogue: 0,1:25:54.77,1:25:56.62,Default,,0,0,0,,Bakit biglang gusto mo ng maybahay?
Dialogue: 0,1:25:56.65,1:25:59.38,Default,,0,0,0,,Hindi mo ba sinabi na malapit nang matanggal sa trabaho ang intern\N?
Dialogue: 0,1:25:59.40,1:26:00.75,Default,,0,0,0,,Isang taong walang trabaho?
Dialogue: 0,1:26:00.78,1:26:04.66,Default,,0,0,0,,Ayokong i-pressure ka, pero paano\Nka mag-iipon ng pera para makabili ng bahay?
Dialogue: 0,1:26:04.68,1:26:05.71,Default,,0,0,0,,Sumasang-ayon ako.
Dialogue: 0,1:26:05.74,1:26:09.09,Default,,0,0,0,,Hindi ko inaasahan ang isang mayamang manugang...
Dialogue: 0,1:26:09.12,1:26:11.43,Default,,0,0,0,,dahil nag-aral ka ng abogasya sa SNU.
Dialogue: 0,1:26:11.45,1:26:12.89,Default,,0,0,0,,Sana lang...
Dialogue: 0,1:26:12.91,1:26:15.18,Default,,0,0,0,,hindi siya mas mahirap sa atin. Iyon lang.
Dialogue: 0,1:26:15.21,1:26:18.45,Default,,0,0,0,,- Eksakto.\N- Hindi ko pa naramdaman ang ganito.
Dialogue: 0,1:26:21.50,1:26:23.41,Default,,0,0,0,,Lagi siyang...
Dialogue: 0,1:26:24.26,1:26:26.04,Default,,0,0,0,,sa isip ko.
Dialogue: 0,1:26:26.47,1:26:29.32,Default,,0,0,0,,Nagtataka ako kung bakit ang kanyang damit\Palagi namang may butas.
Dialogue: 0,1:26:29.35,1:26:32.53,Default,,0,0,0,,Nag-aalala ako na masisipa siya ng mga bagay.
Dialogue: 0,1:26:32.56,1:26:35.04,Default,,0,0,0,,Nag-aalala ako na baka mapagalitan na naman siya.
Dialogue: 0,1:26:35.06,1:26:37.00,Default,,0,0,0,,Naiisip ko siya kapag kumakain ako ng masasarap na pagkain.
Dialogue: 0,1:26:37.02,1:26:39.14,Default,,0,0,0,,Gusto kong dalhan siya.
Dialogue: 0,1:26:39.27,1:26:40.97,Default,,0,0,0,,Na-distract ako...
Dialogue: 0,1:26:41.69,1:26:44.18,Default,,0,0,0,,dahil sa kanya.
Dialogue: 0,1:26:44.74,1:26:46.60,Default,,0,0,0,,Siya ang magiging kamatayan ko.
Dialogue: 0,1:26:50.95,1:26:52.99,Default,,0,0,0,,Pagkatapos ay pakasalan mo siya.
Dialogue: 0,1:26:53.33,1:26:54.97,Default,,0,0,0,,- Honey.\N- Nanay.
Dialogue: 0,1:26:55.00,1:26:57.10,Default,,0,0,0,,Pakasalan mo siya kung ganoon kaseryoso.
Dialogue: 0,1:26:57.12,1:26:58.93,Default,,0,0,0,,Mas mabuti na ito kaysa mamatay.
Dialogue: 0,1:26:58.96,1:27:02.37,Default,,0,0,0,,Oo, totoo iyon, ngunit...
Dialogue: 0,1:27:03.88,1:27:06.62,Default,,0,0,0,,Oo, gagawin ko.
Dialogue: 0,1:27:10.22,1:27:12.42,Default,,0,0,0,,Magpapakasal na kami,
Dialogue: 0,1:27:15.18,1:27:17.59,Default,,0,0,0,,at poprotektahan ko siya magpakailanman.
Dialogue: 0,1:27:24.82,1:27:27.65,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,1:27:54.97,1:27:57.95,Default,,0,0,0,,{\an8}{\i1}Mayroon bang mga babae na ang puso ay nagtataksil pa rin...{\i0}
Dialogue: 0,1:27:57.98,1:28:00.29,Default,,0,0,0,,{\an8}{\i1}kapag nakita nila ang kanilang asawa,\Nsa kabila ng kasal...{\i0}
Dialogue: 0,1:28:00.31,1:28:02.55,Default,,0,0,0,,{\an8}{\i1}sa mahigit tatlong taon?{\i0}
Dialogue: 0,1:28:02.90,1:28:04.17,Default,,0,0,0,,{\an8}{\i1}Hindi pwede.{\i0}
Dialogue: 0,1:28:04.19,1:28:06.63,Default,,0,0,0,,{\an8}{\i1}Napansin kong nakabukas ang bakod.{\i0}
Dialogue: 0,1:28:06.65,1:28:09.30,Default,,0,0,0,,{\an8}{\i1}Naniniwala ka talagang mahal ka niya.{\i0}
Dialogue: 0,1:28:09.32,1:28:11.36,Default,,0,0,0,,{\an8}{\i1}Oo, ginagawa ko.{\i0}
Dialogue: 0,1:28:11.70,1:28:16.64,Default,,0,0,0,,{\an8}{\i1}Hindi ako kailanman naiinis\Nsa ngiti ng isang tao.{\i0}
Dialogue: 0,1:28:16.66,1:28:18.10,Default,,0,0,0,,{\an8}{\i1}Papatayin ko...{\i0}
Dialogue: 0,1:28:18.12,1:28:20.43,Default,,0,0,0,,{\an8}{\i1}bawat isang hamak na nagtataksil...{\i0}
Dialogue: 0,1:28:20.46,1:28:23.03,Default,,0,0,0,,{\an8}{\i1}at sinaksak ako sa likod.{\i0}
Dialogue: 0,1:28:23.25,1:28:25.45,Default,,0,0,0,,{\an8}{\i1}Huwag kang matakot.{\i0}
Dialogue: 0,1:28:26.67,1:28:27.94,Default,,0,0,0,,{\an8}{\i1}Dahil natakot ako.{\i0}
Dialogue: 0,1:28:27.96,1:28:30.83,Default,,0,0,0,,{\an8}{\i1}Kaya naman bumilis ang tibok ng puso ko.{\i0}
