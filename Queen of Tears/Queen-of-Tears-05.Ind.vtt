Dialog: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skenario: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sutradara: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:03.27,0:01:05.30,Default,,0,0,0,,Maaf aku berteriak.
Dialog: 0,0:01:13.19,0:01:14.89,Default,,0,0,0,,Sebenarnya...
Dialog: 0,0:01:16.74,0:01:18.52,Default,,0,0,0,,Saya tidak ingat.
Dialog: 0,0:01:19.99,0:01:22.94,Default,,0,0,0,,Saya tidak ingat sama sekali kenapa saya ada di sana.
Dialog: 0,0:01:27.12,0:01:29.24,Default,,0,0,0,,Aku tadi di depan rumahmu,
Dialog: 0,0:01:29.54,0:01:32.54,Default,,0,0,0,,lalu tiba-tiba aku berada di tempat lain.
Dialog: 0,0:01:36.47,0:01:39.08,Default,,0,0,0,,Saya tidak tahu kapan saya pergi ke sana,
Dialog: 0,0:01:40.97,0:01:43.01,Default,,0,0,0,,atau bagaimana caranya.
Dialog: 0,0:01:46.18,0:01:47.89,Default,,0,0,0,,Saya tidak tahu.
Dialog: 0,0:01:49.48,0:01:51.26,Default,,0,0,0,,Saya...
Dialogue: 0,0:01:55.82,0:01:57.52,Default,,0,0,0,,sangat takut.
Dialogue: 0,0:03:41.09,0:03:44.04,Default,,0,0,0,,Ngomong-ngomong, kenapa kamu datang ke sini sendirian?
Dialogue: 0,0:03:47.22,0:03:49.84,Default,,0,0,0,,Adikmu mengirimiku pesan.
Dialogue: 0,0:03:50.06,0:03:53.18,Default,,0,0,0,,Dia bilang ayahmu kalah dalam pemilu.
Dialogue: 0,0:03:53.35,0:03:56.81,Default,,0,0,0,,Saingannya memenangkan pemilih dengan makanan.
Dialog: 0,0:03:59.53,0:04:01.98,Default,,0,0,0,,Itulah sebabnya kamu datang?
Dialogue: 0,0:04:03.36,0:04:05.67,Default,,0,0,0,,Maksudku, dia kalah...
Dialog: 0,0:04:05.70,0:04:08.01,Default,,0,0,0,,untuk sup daging babi dan nasi.
Dialogue: 0,0:04:08.03,0:04:09.43,Default,,0,0,0,,Bagaimana aku bisa duduk diam?
Dialogue: 0,0:04:09.45,0:04:13.74,Default,,0,0,0,,Jadi itu sebabnya kamu melakukan serangan balik\Ndengan daging sapi dan lobster?
Dialogue: 0,0:04:14.50,0:04:16.44,Default,,0,0,0,,Kamu seharusnya menyaksikan...
Dialogue: 0,0:04:16.46,0:04:19.66,Default,,0,0,0,,bagaimana aku tanpa ampun mengalahkan 200 mangkuk sup.
Dialog: 0,0:04:47.07,0:04:48.30,Default,,0,0,0,,{\i1}Hae-in!{\i0}
Dialog: 0,0:04:48.32,0:04:50.43,Default,,0,0,0,,{\i1}- Hae-in!\N- Hae-in!{\i0}
Dialog: 0,0:04:50.45,0:04:51.55,Default,,0,0,0,,{\i1}Hae-in!{\i0}
Dialog: 0,0:04:51.58,0:04:53.57,Default,,0,0,0,,Apakah dia disana?
Dialog: 0,0:04:53.83,0:04:54.85,Default,,0,0,0,,Tidak, dia tidak.
Dialogue: 0,0:04:54.87,0:04:56.68,Default,,0,0,0,,- Hae-in!\N- Kamu belum menemukannya?
Dialog: 0,0:04:56.71,0:04:57.89,Default,,0,0,0,,Dimana dia?
Dialogue: 0,0:04:57.92,0:04:59.27,Default,,0,0,0,,Di mana dia berada?
Dialogue: 0,0:04:59.29,0:05:00.48,Default,,0,0,0,,Kasihan Hae-in!
Dialog: 0,0:05:00.50,0:05:01.86,Default,,0,0,0,,Hubungi polisi!
Dialog: 0,0:05:01.88,0:05:03.65,Default,,0,0,0,,- Kita harus melakukannya!\N- Hae-in!
Dialogue: 0,0:05:03.67,0:05:05.23,Default,,0,0,0,,- Hae-in!\N- Kamu di mana?
Dialog: 0,0:05:05.26,0:05:06.40,Default,,0,0,0,,Hae-in!
Dialog: 0,0:05:06.43,0:05:07.97,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:07.99,0:05:09.03,Default,,0,0,0,,Hae-in!
Dialog: 0,0:05:09.05,0:05:10.11,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialogue: 0,0:05:10.14,0:05:12.24,Default,,0,0,0,,- Hae-in!\N- Kemana dia pergi?
Dialog: 0,0:05:12.27,0:05:14.16,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:14.18,0:05:16.45,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:16.48,0:05:18.05,Default,,0,0,0,,Hae-in!
Dialog: 0,0:05:18.65,0:05:20.35,Default,,0,0,0,,Astaga!
Dialog: 0,0:05:20.40,0:05:21.92,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:05:21.94,0:05:23.84,Default,,0,0,0,,Ya ampun, sayangku!
Dialog: 0,0:05:23.86,0:05:27.02,Default,,0,0,0,,Ya ampun! Ini dia!
Dialog: 0,0:05:31.91,0:05:32.89,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 5{\c}{\i0}
Dialogue: 0,0:05:32.91,0:05:35.18,Default,,0,0,0,,{\an8}Kami benar-benar terkejut.
Dialogue: 0,0:05:35.20,0:05:37.82,Default,,0,0,0,,{\an8}Di mana kamu tadi?
Dialogue: 0,0:05:39.96,0:05:42.73,Default,,0,0,0,,{\an8}Berhenti bertanya padanya.
Dialogue: 0,0:05:42.75,0:05:44.36,Default,,0,0,0,,{\an8}Ayah, Ayah sebaiknya tidur.
Dialog: 0,0:05:44.38,0:05:45.36,Default,,0,0,0,,{\an8}Oke.
Dialogue: 0,0:05:45.38,0:05:47.40,Default,,0,0,0,,{\an8}Jangan pedulikan kami.
Dialogue: 0,0:05:47.43,0:05:50.32,Default,,0,0,0,,{\an8}Orang-orang di sini tidur lebih awal,
Dialog: 0,0:05:50.34,0:05:52.45,Default,,0,0,0,,{\an8}- jadi anggap seperti rumah sendiri.\N- Dia benar.
Dialog: 0,0:05:52.47,0:05:54.20,Default,,0,0,0,,{\an8}- Anggaplah kami tidak terlihat.\N- Benar.
Dialog: 0,0:05:54.22,0:05:55.49,Default,,0,0,0,,{\an8}Luar biasa.
Dialogue: 0,0:05:55.52,0:05:57.87,Default,,0,0,0,,{\an8}Bagaimana kamu bisa tidak terlihat saat berada di sini? Pergi.
Dialog: 0,0:05:57.89,0:05:59.91,Default,,0,0,0,,{\an8}- Ayo berangkat. Malam.\N- Malam.
Dialog: 0,0:05:59.94,0:06:01.64,Default,,0,0,0,,{\an8}Selamat malam.
Dialogue: 0,0:06:19.12,0:06:20.95,Default,,0,0,0,,Aku perlu mengeringkan rambutku.
Dialog: 0,0:06:22.46,0:06:23.69,Default,,0,0,0,,Apakah ada pengering rambut?
Dialog: 0,0:06:23.71,0:06:25.75,Default,,0,0,0,,Satu menit.
Dialogue: 0,0:06:32.55,0:06:35.67,Default,,0,0,0,,Ini cukup lama.
Dialog: 0,0:06:36.06,0:06:37.76,Default,,0,0,0,,Tidak apa-apa.
Dialog: 0,0:06:44.11,0:06:46.23,Default,,0,0,0,,Tidak berfungsi.
Dialog: 0,0:06:46.78,0:06:49.80,Default,,0,0,0,,Anda perlu menekan bagian bawah.
Dialog: 0,0:06:49.82,0:06:51.94,Default,,0,0,0,,Seperti ini?
Dialogue: 0,0:06:53.07,0:06:54.82,Default,,0,0,0,,Pegang kabelnya.
Dialog: 0,0:06:56.66,0:06:58.57,Default,,0,0,0,,Biar aku yang melakukannya.
Dialog: 0,0:07:02.13,0:07:05.20,Default,,0,0,0,,Ada cara untuk melakukan ini.
Dialogue: 0,0:07:37.58,0:07:40.03,Default,,0,0,0,,- Sekarang semuanya kering.\N- Benar.
Dialog: 0,0:07:40.54,0:07:42.70,Default,,0,0,0,,Menurutku kamu baik-baik saja.
Dialogue: 0,0:07:56.55,0:07:58.26,Default,,0,0,0,,Bu!
Dialog: 0,0:07:59.60,0:08:01.24,Default,,0,0,0,,Lihat ini.
Dialogue: 0,0:08:01.27,0:08:03.75,Default,,0,0,0,,Orang tidak mengubahnya\Tidak Mudah. Ada apa dengan dia?
Dialog: 0,0:08:03.77,0:08:04.83,Default,,0,0,0,,Apa itu?
Dialog: 0,0:08:04.85,0:08:08.29,Default,,0,0,0,,Hae-in pasti tiba-tiba mengunjungi mertuanya.
Dialogue: 0,0:08:08.32,0:08:10.67,Default,,0,0,0,,- Untuk apa?\N- Makanya aku tercengang.
Dialogue: 0,0:08:10.69,0:08:12.59,Default,,0,0,0,,Hillbillies sungguh luar biasa.
Dialog: 0,0:08:12.61,0:08:15.17,Default,,0,0,0,,Mereka memfilmkan ini dan mengunggahnya.
Dialog: 0,0:08:15.20,0:08:17.11,Default,,0,0,0,,Unggah apa?
Dialog: 0,0:08:17.53,0:08:19.30,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa yang kamu lakukan di sini?{\c}{\i0}
Dialogue: 0,0:08:19.33,0:08:21.56,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya senang Anda semua ada di sini.{\c}{\i0}
Dialogue: 0,0:08:21.58,0:08:23.64,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku melewatkan ulang tahunmu yang terakhir,{\c}{\i0}
Dialog: 0,0:08:23.66,0:08:27.31,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi saya datang untuk mentraktir penduduk desa makan.{\c}{\i0}
Dialog: 0,0:08:27.34,0:08:28.42,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}CEO cantik Hong Hae-in{\c}{\i0}
Dialogue: 0,0:08:28.45,0:08:31.57,Default,,0,0,0,,{\an8}Dia tidak pernah mengejutkanku di hari ulang tahunku.
Dialogue: 0,0:08:31.59,0:08:34.50,Default,,0,0,0,,Sungguh sulit dipercaya.
Dialog: 0,0:08:41.68,0:08:43.45,Default,,0,0,0,,Apakah kamu lapar?
Dialog: 0,0:08:43.48,0:08:45.64,Default,,0,0,0,,Apakah kamu ingin makan sesuatu?
Dialogue: 0,0:08:47.10,0:08:48.81,Default,,0,0,0,,Aku sudah makan banyak.
Dialogue: 0,0:08:48.86,0:08:50.54,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mau makan ini, ya?{\c}{\i0}
Dialogue: 0,0:08:50.57,0:08:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ini kepiting asin kecap.{\c}{\i0}
Dialogue: 0,0:08:52.82,0:08:54.67,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Penuh dengan telur.{\c}{\i0}
Dialogue: 0,0:08:54.70,0:08:57.38,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kami terkenal dengan kecap kami.{\c}{\i0}
Dialogue: 0,0:08:57.41,0:08:59.80,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ini adalah perut babi beku\Nyang dipanggang di atas briket.{\c}{\i0}
Dialogue: 0,0:08:59.83,0:09:01.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Minumlah sebelum menjadi dingin.{\c}{\i0}
Dialogue: 0,0:09:01.99,0:09:04.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku memakannya satu per satu, jadi harap tunggu.{\c}{\i0}
Dialog: 0,0:09:04.79,0:09:06.43,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa selanjutnya?\N- Coba ini juga.{\c}{\i0}
Dialogue: 0,0:09:06.46,0:09:08.89,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Minggir, ya? Kamu mencekik bayiku.{\c}{\i0}
Dialogue: 0,0:09:08.92,0:09:10.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan terlalu konyol.{\c}{\i0}
Dialogue: 0,0:09:10.71,0:09:13.61,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kunyah perlahan, atau perutmu akan sakit.{\c}{\i0}
Dialogue: 0,0:09:13.63,0:09:16.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Minumlah air juga.{\c}{\i0}
Dialogue: 0,0:09:18.47,0:09:20.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Beri dia beberapa telur.{\c}{\i0}
Dialog: 0,0:09:20.39,0:09:22.74,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Biar aku yang melakukannya.{\c}{\i0}
Dialogue: 0,0:09:22.77,0:09:26.09,Default,,0,0,0,,Mengapa mereka membuatnya sangat tidak nyaman?
Dialogue: 0,0:09:26.56,0:09:29.04,Default,,0,0,0,,Dan kenapa dia makan\Tidak semua yang mereka berikan padanya?
Dialogue: 0,0:09:29.06,0:09:30.87,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Perut babi beku paling enak disajikan panas.{\c}{\i0}
Dialog: 0,0:09:30.90,0:09:31.96,Default,,0,0,0,,{\an8}Apa?
Dialogue: 0,0:09:31.98,0:09:35.23,Default,,0,0,0,,{\an8}Bagaimana video ini bisa ditonton lebih dari 300.000 kali?
Dialogue: 0,0:09:35.70,0:09:38.09,Default,,0,0,0,,Kenapa dia makan begitu banyak?
Dialog: 0,0:09:38.11,0:09:42.80,Default,,0,0,0,,Daging sapi, babi, ayam, bebek, dan ikan.
Dialogue: 0,0:09:42.83,0:09:44.72,Default,,0,0,0,,Aku makan semua jenis daging.
Dialogue: 0,0:09:44.75,0:09:47.27,Default,,0,0,0,,Sepertinya berat badanku bertambah.
Dialog: 0,0:09:47.29,0:09:49.31,Default,,0,0,0,,- Benarkah?\N- Maksudku...
Dialogue: 0,0:09:49.33,0:09:53.50,Default,,0,0,0,,Seorang wanita menawariku ayam yang\Nbahkan belum pernah dibuatnya untuk menantu laki-lakinya.
Dialog: 0,0:09:55.01,0:09:58.75,Default,,0,0,0,,Saya pikir penduduk desa menyukai saya.
Dialogue: 0,0:10:08.44,0:10:12.75,Default,,0,0,0,,Sepertinya mereka baik-baik saja, jadi\Njangan berani menyebutkan perceraian.
Dialog: 0,0:10:12.77,0:10:14.33,Default,,0,0,0,,Anda mengerti.
Dialogue: 0,0:10:14.36,0:10:15.88,Default,,0,0,0,,Sudahkah kamu memberi tahu seseorang sejauh ini?
Dialog: 0,0:10:15.90,0:10:19.73,Default,,0,0,0,,Ayo Bu. Aku akan menjadi idiot jika melakukannya.
Dialog: 0,0:10:25.75,0:10:27.47,Default,,0,0,0,,- Kenapa kamu diam saja?\N- Apa?
Dialog: 0,0:10:27.50,0:10:30.06,Default,,0,0,0,,Ya ampun. Siapa itu? Siapa yang kamu beri tahu?
Dialogue: 0,0:10:30.08,0:10:32.23,Default,,0,0,0,,Aku sedang mengadakan {\i1}makgeolli{\i0} dengan Yeong-song dan...
Dialog: 0,0:10:32.25,0:10:33.23,Default,,0,0,0,,- Apa?\N- Apa?
Dialogue: 0,0:10:33.25,0:10:35.41,Default,,0,0,0,,Kau bilang padanya bahwa...
Dialogue: 0,0:10:35.63,0:10:38.44,Default,,0,0,0,,Kamu bilang padanya Hyun-woo hampir bercerai?
Dialog: 0,0:10:38.47,0:10:43.92,Default,,0,0,0,,Yah, Yeong-song itu seperti\Nkonselor pernikahan di desa ini,
Dialog: 0,0:10:44.60,0:10:46.47,Default,,0,0,0,,jadi saya berkonsultasi dengannya.
Dialogue: 0,0:10:46.56,0:10:47.53,Default,,0,0,0,,keluhku.
Dialog: 0,0:10:47.56,0:10:49.13,Default,,0,0,0,,Itu saja.
Dialog: 0,0:10:49.44,0:10:51.41,Default,,0,0,0,,Bagaimana jika dia memberitahu yang lain?
Dialog: 0,0:10:51.44,0:10:53.76,Default,,0,0,0,,- Ya.\N- Berita akan menyebar dengan cepat.
Dialogue: 0,0:10:53.98,0:10:57.21,Default,,0,0,0,,Konsultasi adalah soal kerahasiaan.
Dialogue: 0,0:10:57.23,0:11:01.65,Default,,0,0,0,,Dia tidak perlu merahasiakannya,\Nkarena dia bukan dokter berlisensi.
Dialog: 0,0:11:04.87,0:11:07.26,Default,,0,0,0,,Astaga. Meski begitu...
Dialog: 0,0:11:07.29,0:11:10.49,Default,,0,0,0,,Kamu dan mulut besarmu.
Dialog: 0,0:11:11.42,0:11:13.12,Default,,0,0,0,,Ayo.
Dialog: 0,0:11:19.76,0:11:22.61,Default,,0,0,0,,Kamu khawatir, jadi kamu datang ke sini jam segini?
Dialogue: 0,0:11:22.64,0:11:24.82,Default,,0,0,0,,Apakah kamu memberitahu seseorang?
Dialog: 0,0:11:24.85,0:11:26.55,Default,,0,0,0,,Tentu saja tidak.
Dialogue: 0,0:11:27.47,0:11:29.83,Default,,0,0,0,,Aku hanya memberitahu ibuku.
Dialog: 0,0:11:29.85,0:11:31.62,Default,,0,0,0,,Mengapa kamu melakukannya?
Dialogue: 0,0:11:31.64,0:11:34.08,Default,,0,0,0,,Du-gwan, dia satu-satunya keluarga yang kumiliki.
Dialog: 0,0:11:34.11,0:11:36.72,Default,,0,0,0,,Kami berbagi segalanya,
Dialogue: 0,0:11:37.19,0:11:40.60,Default,,0,0,0,,dan kamu tahu kondisinya.
Dialogue: 0,0:11:48.33,0:11:51.99,Default,,0,0,0,,Kapan kamu pulang, Sayang?\NKenapa kamu selalu pergi?
Dialogue: 0,0:11:52.04,0:11:53.68,Default,,0,0,0,,Di mana kamu tidur hari ini?
Dialog: 0,0:11:53.71,0:11:55.31,Default,,0,0,0,,Bu, tidurlah.
Dialog: 0,0:11:55.33,0:11:57.54,Default,,0,0,0,,Siapa kamu?
Dialog: 0,0:11:57.96,0:12:00.19,Default,,0,0,0,,Lihat? Jadi jangan khawatir tentang dia,
Dialog: 0,0:12:00.21,0:12:02.44,Default,,0,0,0,,dan khawatirkan putra dan istrinya.
Dialog: 0,0:12:02.47,0:12:04.49,Default,,0,0,0,,Tidak ada yang perlu dikhawatirkan.
Dialog: 0,0:12:04.51,0:12:05.95,Default,,0,0,0,,Meskipun begitu sibuk,
Dialog: 0,0:12:05.97,0:12:08.37,Default,,0,0,0,,Hae-in datang jauh-jauh ke sini untuk membantu kampanyeku.
Dialog: 0,0:12:08.39,0:12:10.59,Default,,0,0,0,,- Apa maksudnya?\N- Apa?
Dialog: 0,0:12:10.64,0:12:14.34,Default,,0,0,0,,Artinya keduanya sedang jatuh cinta.
Dialogue: 0,0:12:18.48,0:12:21.18,Default,,0,0,0,,Apa ini? Lucu sekali.
Dialogue: 0,0:12:21.90,0:12:24.23,Default,,0,0,0,,Itu selalu menjadi favoritku.
Dialog: 0,0:12:29.45,0:12:31.28,Default,,0,0,0,,Tanganmu.
Dialog: 0,0:12:38.42,0:12:40.83,Default,,0,0,0,,Kamu tidak boleh sendirian lagi.
Dialog: 0,0:12:41.96,0:12:43.96,Default,,0,0,0,,Kamu selalu terluka.
Dialogue: 0,0:13:00.23,0:13:02.77,Default,,0,0,0,,Kudengar ini adalah penyelamatmu.
Dialogue: 0,0:13:04.11,0:13:05.63,Default,,0,0,0,,Kenapa punyaku pendek sekali?
Dialog: 0,0:13:05.65,0:13:07.31,Default,,0,0,0,,Saya tersinggung.
Dialog: 0,0:13:08.03,0:13:09.63,Default,,0,0,0,,Ayo.
Dialogue: 0,0:13:09.66,0:13:11.34,Default,,0,0,0,,Apakah kamu percaya dengan membaca garis tangan?
Dialog: 0,0:13:11.37,0:13:14.22,Default,,0,0,0,,Tidak, tapi rasanya tidak enak.
Dialogue: 0,0:13:14.25,0:13:17.28,Default,,0,0,0,,Aku sakit parah, dan umurku pendek.
Dialogue: 0,0:13:18.13,0:13:20.31,Default,,0,0,0,,Kamu tidak sakit parah.
Dialogue: 0,0:13:20.34,0:13:22.15,Default,,0,0,0,,Kamu tidak ingin menjadi pasien.
Dialogue: 0,0:13:22.17,0:13:23.73,Default,,0,0,0,,Kamu bilang kamu akan menjadi lebih baik.
Dialogue: 0,0:13:23.76,0:13:27.67,Default,,0,0,0,,Kamu bilang Tuhan ada di pihakmu,\Ndan keajaiban akan terjadi.
Dialogue: 0,0:13:31.26,0:13:35.51,Default,,0,0,0,,Anda bilang pusat kanker terbaik\Ndi Eropa akan menyembuhkan segalanya!
Dialogue: 0,0:13:41.86,0:13:45.14,Default,,0,0,0,,Aku tak pernah bilang mereka bisa menyembuhkan segalanya.
Dialogue: 0,0:13:45.57,0:13:48.40,Default,,0,0,0,,Aku hanya bilang.
Dialogue: 0,0:13:48.61,0:13:51.65,Default,,0,0,0,,Ada alasan mengapa mereka yang terbaik.
Dialog: 0,0:13:52.20,0:13:53.90,Default,,0,0,0,,Apakah menurut Anda begitu?
Dialogue: 0,0:14:00.79,0:14:02.62,Default,,0,0,0,,Maukah kamu...
Dialog: 0,0:14:04.51,0:14:06.08,Default,,0,0,0,, ikut aku?
Dialogue: 0,0:14:09.93,0:14:12.75,Default,,0,0,0,,Bukannya aku takut pergi sendirian.
Dialogue: 0,0:14:13.06,0:14:16.34,Default,,0,0,0,,Hanya kamu satu-satunya orang yang tahu aku sakit.
Dialog: 0,0:14:27.90,0:14:29.81,Default,,0,0,0,,Apakah kamu serius?
Dialog: 0,0:14:31.91,0:14:33.82,Default,,0,0,0,,Itu sudah pasti.
Dialogue: 0,0:14:40.42,0:14:42.12,Default,,0,0,0,,Masih perih?
Dialogue: 0,0:15:53.16,0:15:54.76,Default,,0,0,0,,Apakah kamu sudah gila?
Dialogue: 0,0:15:54.78,0:15:56.64,Default,,0,0,0,,Apa yang coba kamu lakukan?
Dialog: 0,0:15:56.66,0:15:58.39,Default,,0,0,0,,Jangan bilang...
Dialogue: 0,0:15:58.41,0:16:00.70,Default,,0,0,0,,kamu ingin menciumnya.
Dialogue: 0,0:16:01.71,0:16:02.93,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:16:02.96,0:16:04.91,Default,,0,0,0,,Kamu gila.
Dialog: 0,0:16:05.46,0:16:06.99,Default,,0,0,0,,Kamu gila.
Dialog: 0,0:16:11.88,0:16:13.53,Default,,0,0,0,,Tapi tetap saja,
Dialogue: 0,0:16:13.55,0:16:16.54,Default,,0,0,0,,kamu seharusnya tidak membiarkannya tergantung.
Dialogue: 0,0:16:17.43,0:16:19.26,Default,,0,0,0,,Dia pasti terkejut.
Dialogue: 0,0:16:23.10,0:16:24.62,Default,,0,0,0,,Kamu mau masuk lagi?
Dialog: 0,0:16:24.65,0:16:27.93,Default,,0,0,0,,Apa yang akan kamu katakan padanya? Apa yang akan kamu lakukan?
Dialogue: 0,0:16:28.52,0:16:31.60,Default,,0,0,0,,Apakah kamu pikir kamu bisa kembali ke luar?
Dialogue: 0,0:16:33.53,0:16:35.23,Default,,0,0,0,,Tidak, kamu tidak bisa.
Dialog: 0,0:16:36.45,0:16:39.57,Default,,0,0,0,,Tidak. aku tidak akan bisa pergi...
Dialog: 0,0:16:39.62,0:16:41.32,Default,,0,0,0,,jika saya kembali.
Dialog: 0,0:16:41.91,0:16:43.86,Default,,0,0,0,,Saya tidak bisa.
Dialog: 0,0:16:54.97,0:16:56.67,Default,,0,0,0,,Apakah dia melarikan diri?
Dialog: 0,0:16:58.35,0:17:00.09,Default,,0,0,0,,Tidak.
Dialog: 0,0:17:00.18,0:17:01.74,Default,,0,0,0,,Saya yakin...
Dialog: 0,0:17:01.77,0:17:04.20,Default,,0,0,0,,ada yang harus dia lakukan.
Dialog: 0,0:17:04.23,0:17:07.97,Default,,0,0,0,,Mungkin dia harus ke toilet atau menelepon.
Dialogue: 0,0:17:18.41,0:17:20.07,Default,,0,0,0,,Tapi selama ini?
Dialogue: 0,0:17:24.29,0:17:25.93,Default,,0,0,0,,Bisakah kamu tenang?
Dialogue: 0,0:17:25.96,0:17:28.35,Default,,0,0,0,,Astaga, kamu berisik sekali.
Dialog: 0,0:17:28.38,0:17:30.03,Default,,0,0,0,,Diam!
Dialog: 0,0:17:31.71,0:17:32.98,Default,,0,0,0,,Apakah kamu dan Hae-in bertengkar?
Dialog: 0,0:17:33.01,0:17:34.75,Default,,0,0,0,,Tidak.
Dialogue: 0,0:17:35.05,0:17:36.57,Default,,0,0,0,,Justru sebaliknya.
Dialog: 0,0:17:36.59,0:17:39.15,Default,,0,0,0,,Lalu apakah kamu dihukum?
Dialogue: 0,0:17:39.18,0:17:42.88,Default,,0,0,0,,Apakah dia menyuruhmu keluar\Ndan merenung selama satu jam?
Dialogue: 0,0:17:43.35,0:17:45.83,Default,,0,0,0,,- Pernahkah kamu melakukannya?\N- Berkali-kali,
Dialog: 0,0:17:45.85,0:17:49.58,Default,,0,0,0,,tapi dia akan mendapat lebih banyak lagi\Nupset jika kamu melakukan apa yang dia katakan.
Dialogue: 0,0:17:49.61,0:17:54.14,Default,,0,0,0,,Dia akan memaafkanmu jika kamu\Ncepat kembali dan meminta maaf.
Dialog: 0,0:17:54.57,0:17:57.19,Default,,0,0,0,,Panas sekali.
Dialogue: 0,0:17:59.45,0:18:02.84,Default,,0,0,0,,Jadi, bersiaplah dan kembali ke dalam.
Dialog: 0,0:18:02.87,0:18:06.20,Default,,0,0,0,,Aku hanya di sini...
Dialogue: 0,0:18:06.83,0:18:09.32,Default,,0,0,0,,supaya aku bisa sadar.
Dialogue: 0,0:18:09.88,0:18:11.77,Default,,0,0,0,,Aku tidak bisa berpikir jernih di rumah.
Dialog: 0,0:18:11.79,0:18:13.45,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:18:22.89,0:18:25.26,Default,,0,0,0,,Saya tidak tahu. Aku tidak bisa.
Dialog: 0,0:18:45.12,0:18:46.10,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:18:53.09,0:18:54.99,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Di mana kamu?{\c}{\i0}
Dialog: 0,0:19:02.14,0:19:04.38,Default,,0,0,0,,Kenapa dia tidak membacanya?
Dialog: 0,0:19:04.97,0:19:07.30,Default,,0,0,0,,Hei, dia membacanya.
Dialogue: 0,0:19:20.90,0:19:22.09,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tidurlah sekarang.{\c}{\i0}
Dialog: 0,0:19:22.11,0:19:25.11,Default,,0,0,0,,"Tidur sekarang"?
Dialogue: 0,0:19:25.99,0:19:28.07,Default,,0,0,0,,Dia ingin aku tidur sekarang?
Dialogue: 0,0:19:29.33,0:19:30.86,Default,,0,0,0,,Sendiri?
Dialog: 0,0:19:40.05,0:19:41.53,Default,,0,0,0,,Baik.
Dialog: 0,0:19:41.55,0:19:43.29,Default,,0,0,0,,Itu yang dia inginkan.
Dialog: 0,0:19:44.47,0:19:45.78,Default,,0,0,0,,Tidur.
Dialogue: 0,0:19:45.80,0:19:47.34,Default,,0,0,0,,Tidurlah sekarang.
Dialog: 0,0:19:51.60,0:19:53.29,Default,,0,0,0,,Sialan.
Dialogue: 0,0:19:53.31,0:19:54.50,Default,,0,0,0,,Jadi dia kabur.
Dialog: 0,0:19:54.52,0:19:58.81,Default,,0,0,0,,Mengapa? Apa dia pikir aku akan memakannya hidup-hidup? Apakah dia takut padaku?
Dialog: 0,0:20:02.95,0:20:04.90,Default,,0,0,0,,Diam!
Dialog: 0,0:20:11.75,0:20:13.60,Default,,0,0,0,,Kenapa dia takut padaku?
Dialogue: 0,0:20:13.62,0:20:16.37,Default,,0,0,0,,Betapa menakutkannya aku?
Dialog: 0,0:20:17.21,0:20:19.73,Default,,0,0,0,,Bahkan anjing pun tertidur.
Dialog: 0,0:20:19.76,0:20:22.28,Default,,0,0,0,,Ayo pulang sekarang.
Dialogue: 0,0:20:22.30,0:20:24.40,Default,,0,0,0,,Aku akan berada di luar lebih lama lagi.
Dialog: 0,0:20:24.43,0:20:27.03,Default,,0,0,0,,Kalau begitu, Hae-in akan tidur sendirian.
Dialog: 0,0:20:27.05,0:20:29.63,Default,,0,0,0,,Ya, itu alasannya.
Dialogue: 0,0:20:30.10,0:20:32.18,Default,,0,0,0,,Aku akan kembali begitu dia melakukannya.
Dialog: 0,0:20:34.60,0:20:38.08,Default,,0,0,0,,Astaga, idiot.
Dialog: 0,0:20:38.11,0:20:39.29,Default,,0,0,0,,Mengapa?
Dialog: 0,0:20:39.32,0:20:41.56,Default,,0,0,0,,Mengapa kamu menunggu sampai saat itu?
Dialog: 0,0:20:47.20,0:20:48.90,Default,,0,0,0,,Karena saya mungkin...
Dialog: 0,0:20:50.29,0:20:51.82,Default,,0,0,0,,membuat kesalahan.
Dialog: 0,0:20:52.04,0:20:53.01,Default,,0,0,0,,Apa maksudmu?
Dialogue: 0,0:20:53.04,0:20:55.06,Default,,0,0,0,,Kamu hanya melakukan kesalahan saat sedang mabuk.
Dialog: 0,0:20:55.08,0:20:57.31,Default,,0,0,0,,Kamu seharusnya tidak mabuk kalau begitu.
Dialog: 0,0:20:57.33,0:20:58.56,Default,,0,0,0,,Tidak.
Dialog: 0,0:20:58.59,0:21:01.25,Default,,0,0,0,,Saya tidak akan membuat kesalahan apa pun...
Dialogue: 0,0:21:01.76,0:21:03.19,Default,,0,0,0,,jika aku minum dan pingsan.
Dialog: 0,0:21:03.22,0:21:06.17,Default,,0,0,0,,Saya tidak mengerti apa yang Anda katakan.
Dialog: 0,0:21:07.55,0:21:09.20,Default,,0,0,0,,Dengarkan baik-baik.
Dialogue: 0,0:21:09.22,0:21:12.92,Default,,0,0,0,,Aku akan minum lebih banyak,
Dialogue: 0,0:21:13.35,0:21:16.05,Default,,0,0,0,,dan jadi sia-sia.
Dialogue: 0,0:21:16.81,0:21:18.04,Default,,0,0,0,,Tolong bantu aku satu hal.
Dialog: 0,0:21:18.06,0:21:20.77,Default,,0,0,0,,- Apa itu?\N- Jangan...
Dialogue: 0,0:21:21.15,0:21:23.18,Default,,0,0,0,,taruh aku...
Dialog: 0,0:21:24.53,0:21:26.23,Default,,0,0,0,,kembali ke kamarku.
Dialog: 0,0:21:33.00,0:21:34.99,Default,,0,0,0,,Aku sangat tersesat.
Dialogue: 0,0:21:36.29,0:21:38.81,Default,,0,0,0,,Apakah kamu mau {\i1}ramyun?{\i0} Aku akan membuatkannya.
Dialogue: 0,0:21:40.59,0:21:45.33,Default,,0,0,0,,Dulu aku sangat takut pada istriku.
Dialog: 0,0:21:56.27,0:21:57.93,Default,,0,0,0,,Dulu...
Dialog: 0,0:21:58.52,0:22:00.43,Default,,0,0,0,,oke.
Dialog: 0,0:22:02.73,0:22:05.44,Default,,0,0,0,,Aku yakin aku tidak akan terpengaruh,
Dialog: 0,0:22:05.90,0:22:08.27,Default,,0,0,0,,tidak peduli apa yang terjadi padanya.
Dialog: 0,0:22:09.07,0:22:12.78,Default,,0,0,0,,Mengapa? Karena aku tidak menyukainya.
Dialog: 0,0:22:16.29,0:22:19.06,Default,,0,0,0,,Seperti yang telah saya lakukan sejauh ini,
Dialog: 0,0:22:19.08,0:22:22.44,Default,,0,0,0,,Saya hanya perlu terus tidak menyukai,
Dialog: 0,0:22:22.46,0:22:23.44,Default,,0,0,0,,membenci,
Dialog: 0,0:22:23.46,0:22:25.19,Default,,0,0,0,,dan bosan dengannya.
Dialogue: 0,0:22:25.21,0:22:28.29,Default,,0,0,0,,Aku hanya perlu mengantisipasi hari dimana kita berpisah.
Dialog: 0,0:22:29.97,0:22:32.21,Default,,0,0,0,,Aku tidak perlu menyukainya.
Dialogue: 0,0:22:33.18,0:22:34.88,Default,,0,0,0,,Sederhana saja.
Dialogue: 0,0:22:35.27,0:22:37.43,Default,,0,0,0,,Aku sudah melakukannya selama ini.
Dialog: 0,0:23:00.54,0:23:02.24,Default,,0,0,0,,Tapi...
Dialog: 0,0:23:03.21,0:23:04.99,Default,,0,0,0,,anehnya,
Dialog: 0,0:23:07.13,0:23:09.33,Default,,0,0,0,,Saya tidak bisa melakukannya lagi.
Dialog: 0,0:23:22.98,0:23:24.51,Default,,0,0,0,,Baik.
Dialog: 0,0:23:25.07,0:23:27.64,Default,,0,0,0,,Kita tidak perlu tidur bersama.
Dialogue: 0,0:23:27.78,0:23:30.56,Default,,0,0,0,,Kita sudah tidur terpisah selama bertahun-tahun.
Dialog: 0,0:23:33.03,0:23:34.24,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Dua Tahun Lalu{\c}{\i0}
Dialog: 0,0:23:37.45,0:23:38.89,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:23:38.91,0:23:42.16,Default,,0,0,0,,Ms. Hong menyuruh kami membersihkan kamar.
Dialog: 0,0:23:47.67,0:23:50.78,Default,,0,0,0,,Tim produk bertanggung jawab\Tidak memilih dan menghapus merek.
Dialogue: 0,0:23:50.80,0:23:53.96,Default,,0,0,0,,Tim penjualan perlu fokus\Non kinerja merek.
Dialog: 0,0:23:57.43,0:23:59.38,Default,,0,0,0,,Tunggu.
Dialog: 0,0:23:59.68,0:24:01.38,Default,,0,0,0,,Apa itu?
Dialog: 0,0:24:02.31,0:24:04.01,Default,,0,0,0,,Pembibitan.
Dialogue: 0,0:24:04.90,0:24:07.29,Default,,0,0,0,,- Apakah kamu membersihkannya?\N- Apa gunanya?
Dialogue: 0,0:24:07.32,0:24:09.64,Default,,0,0,0,,Itu hanya membuatku jengkel.
Dialogue: 0,0:24:13.53,0:24:15.97,Default,,0,0,0,,Itu membuatmu jengkel?
Dialog: 0,0:24:15.99,0:24:18.36,Default,,0,0,0,,Kami tidak membutuhkannya lagi.
Dialogue: 0,0:24:29.46,0:24:34.07,Default,,0,0,0,,Tim produk tidak dapat menarik\Nmerek bagus dengan kinerja buruk.
Dialog: 0,0:24:34.09,0:24:36.29,Default,,0,0,0,,Bukankah sudah jelas?
Dialog: 0,0:24:39.64,0:24:41.34,Default,,0,0,0,,Ya.
Dialog: 0,0:24:48.82,0:24:50.96,Default,,0,0,0,,Tolong pindahkan barang-barangku ke ruangan ini.
Dialog: 0,0:24:50.98,0:24:52.21,Default,,0,0,0,,Maaf?
Dialogue: 0,0:24:52.24,0:24:54.10,Default,,0,0,0,,Aku butuh tempat tidur juga.
Dialog: 0,0:24:55.45,0:24:56.72,Default,,0,0,0,,Saya akan tinggal di sini sekarang.
Dialog: 0,0:24:56.74,0:24:58.32,Default,,0,0,0,,Ya pak.
Dialog: 0,0:27:32.85,0:27:34.60,Default,,0,0,0,,Jangan menangis.
Dialogue: 0,0:27:36.27,0:27:38.23,Default,,0,0,0,,Kamu tidak punya hak.
Dialog: 0,0:28:51.31,0:28:53.22,Default,,0,0,0,,Kamu bangun pagi.
Dialogue: 0,0:28:53.94,0:28:56.26,Default,,0,0,0,,Apakah sepertinya aku tertidur?
Dialogue: 0,0:28:56.31,0:28:58.22,Default,,0,0,0,,Kamu tidak tidur sama sekali?
Dialogue: 0,0:29:01.94,0:29:03.60,Default,,0,0,0,,Apa urusanmu?
Dialog: 0,0:29:12.87,0:29:14.60,Default,,0,0,0,,Ho-yeol, bukankah kamu harus pergi ke sekolah?
Dialogue: 0,0:29:14.62,0:29:17.48,Default,,0,0,0,,Ayah, kenapa itu penting?
Dialogue: 0,0:29:17.50,0:29:19.66,Default,,0,0,0,,Mentor hidupku...
Dialog: 0,0:29:19.92,0:29:21.95,Default,,0,0,0,,ada di sini.
Dialog: 0,0:29:22.80,0:29:24.98,Default,,0,0,0,,Apa maksudmu? Siapa mentormu?
Dialogue: 0,0:29:25.01,0:29:27.28,Default,,0,0,0,,Dia adalah pilar keluarga\Nyang datang dengan supercar.
Dialogue: 0,0:29:27.30,0:29:30.66,Default,,0,0,0,,Ini bibiku, pemilik gedung\N dan panutanku.
Dialogue: 0,0:29:30.68,0:29:33.51,Default,,0,0,0,,Itu dia datang.
Dialog: 0,0:29:34.14,0:29:36.75,Default,,0,0,0,,- Ayo keluar.\N- Astaga, Hae-in.
Dialog: 0,0:29:36.77,0:29:38.93,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:29:39.44,0:29:40.71,Default,,0,0,0,,Kamu berbuat banyak.
Dialog: 0,0:29:40.73,0:29:41.96,Default,,0,0,0,,Pulang dengan selamat.
Dialog: 0,0:29:41.98,0:29:43.98,Default,,0,0,0,,Selamat tinggal.
Dialog: 0,0:29:45.61,0:29:47.51,Default,,0,0,0,,- Hyun-woo.\N- Halo, Bu.
Dialog: 0,0:29:47.53,0:29:49.65,Default,,0,0,0,,- Selamat tinggal.\N- Ya, Bu.
Dialogue: 0,0:29:50.45,0:29:52.30,Default,,0,0,0,,Ibumu sudah waras lagi.
Dialogue: 0,0:29:52.33,0:29:54.60,Default,,0,0,0,,Yeong-song, dia sudah lebih baik sekarang.
Dialog: 0,0:29:54.62,0:29:56.35,Default,,0,0,0,,Ya ampun, Ibu.
Dialog: 0,0:29:56.37,0:29:57.48,Default,,0,0,0,,Tetap kuat.
Dialog: 0,0:29:57.50,0:29:58.77,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:29:58.79,0:30:02.33,Default,,0,0,0,,Perceraian bukanlah apa-apa.
Dialogue: 0,0:30:02.46,0:30:04.27,Default,,0,0,0,,Aku juga ingin bercerai.
Dialogue: 0,0:30:04.30,0:30:06.83,Default,,0,0,0,,Seharusnya aku melakukannya, saat ada kesempatan.
Dialog: 0,0:30:07.88,0:30:09.92,Default,,0,0,0,,Ya ampun, Ibu.
Dialog: 0,0:30:10.30,0:30:12.46,Default,,0,0,0,,Astaga, Bu.
Dialogue: 0,0:30:12.56,0:30:14.70,Default,,0,0,0,,Saya pikir dia sudah kehabisan tenaga lagi.
Dialog: 0,0:30:14.72,0:30:16.66,Default,,0,0,0,,Kamu harus cepat pulang.
Dialog: 0,0:30:16.68,0:30:18.16,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:30:18.19,0:30:21.93,Default,,0,0,0,,Sayang, apakah kamu tidur di sini tadi malam?
Dialogue: 0,0:30:22.61,0:30:26.52,Default,,0,0,0,,Inilah sebabnya aku ingin bercerai.
Dialog: 0,0:30:27.86,0:30:28.84,Default,,0,0,0,,Ayo pulang saja.
Dialog: 0,0:30:28.86,0:30:31.43,Default,,0,0,0,,- Seharusnya aku menceraikanmu!\N- Ayo pergi!
Dialog: 0,0:30:31.45,0:30:33.59,Default,,0,0,0,,- Kamu harus pergi.\N- Dia penduduk desa.
Dialogue: 0,0:30:33.62,0:30:35.36,Default,,0,0,0,,Dia agak gila.
Dialog: 0,0:30:35.70,0:30:37.95,Default,,0,0,0,,Selamat tinggal, Sayang.
Dialog: 0,0:30:43.21,0:30:45.40,Default,,0,0,0,,Maaf atas ketidaknyamanan ini.
Dialog: 0,0:30:45.42,0:30:46.98,Default,,0,0,0,,Baiklah kalau begitu.
Dialog: 0,0:30:47.01,0:30:50.25,Default,,0,0,0,,- Selamat tinggal.\N- Astaga, Anda tidak merepotkan.
Dialog: 0,0:30:51.55,0:30:52.70,Default,,0,0,0,,Ini tidak banyak,
Dialog: 0,0:30:52.72,0:30:56.26,Default,,0,0,0,,tapi saya tidak menggunakan pestisida,\Njadi pastikan Anda memakannya.
Dialogue: 0,0:31:03.48,0:31:06.92,Default,,0,0,0,,Hae-in, aku tahu pekerjaan itu penting,
Dialogue: 0,0:31:06.94,0:31:09.23,Default,,0,0,0,,tapi kesehatanmu adalah yang utama.
Dialog: 0,0:31:11.11,0:31:12.68,Default,,0,0,0,,Kamu harus pergi.
Dialog: 0,0:31:12.70,0:31:14.32,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:31:14.95,0:31:17.53,Default,,0,0,0,,Oke, pulang dengan selamat.
Dialog: 0,0:31:18.91,0:31:22.74,Default,,0,0,0,,- Ayo berangkat.\N- Terima kasih, Hae-in.
Dialog: 0,0:31:23.17,0:31:25.33,Default,,0,0,0,,- Selamat tinggal.\N- Lanjutkan.
Dialogue: 0,0:31:27.13,0:31:28.73,Default,,0,0,0,,Kalau begitu, kita berangkat.
Dialog: 0,0:31:28.76,0:31:31.07,Default,,0,0,0,,- Oke.\N- Oke.
Dialog: 0,0:31:31.09,0:31:33.67,Default,,0,0,0,,Hubungi saya.
Dialogue: 0,0:31:49.74,0:31:51.81,Default,,0,0,0,,Apakah kamu punya rokok?
Dialog: 0,0:31:53.78,0:31:55.32,Default,,0,0,0,,Tidak.
Dialogue: 0,0:31:59.37,0:32:00.64,Default,,0,0,0,,Apakah menurutmu dia paham?
Dialog: 0,0:32:00.66,0:32:02.22,Default,,0,0,0,,Siapa yang tahu?
Dialogue: 0,0:32:02.25,0:32:04.27,Default,,0,0,0,,Menurutku dia tidak melakukannya,
Dialog: 0,0:32:04.29,0:32:07.31,Default,,0,0,0,,tapi ada udara dingin\Ndi antara mereka bahkan sebelum itu.
Dialogue: 0,0:32:07.34,0:32:09.82,Default,,0,0,0,,Mereka bahkan menghindari kontak mata sebelum masuk.
Dialogue: 0,0:32:09.84,0:32:11.15,Default,,0,0,0,,Kamu seharusnya tidak bicara...
Dialog: 0,0:32:11.17,0:32:13.57,Default,,0,0,0,,tentang bagaimana dia menerima surat cinta di masa lalu,
Dialog: 0,0:32:13.59,0:32:17.36,Default,,0,0,0,,dan bagaimana putri kepala sekolah\Na menyukainya. Semua pembicaraan tak berguna itu.
Dialogue: 0,0:32:17.39,0:32:19.24,Default,,0,0,0,,- Pasti membuatnya kesal.\N- Apa?
Dialog: 0,0:32:19.27,0:32:21.24,Default,,0,0,0,,Itu hanya lelucon.
Dialog: 0,0:32:21.27,0:32:22.45,Default,,0,0,0,,Lucukah?
Dialog: 0,0:32:22.48,0:32:25.79,Default,,0,0,0,,- Apakah kamu serius?\N- Dia tidak tidur di kamarnya tadi malam.
Dialog: 0,0:32:25.81,0:32:27.12,Default,,0,0,0,,- Apa?\N- Apa?
Dialog: 0,0:32:27.15,0:32:28.46,Default,,0,0,0,,Lalu apa yang dia lakukan?
Dialog: 0,0:32:28.48,0:32:30.46,Default,,0,0,0,,Kami minum bersama di toko.
Dialogue: 0,0:32:30.49,0:32:31.88,Default,,0,0,0,,Itu menyakitkan.
Dialog: 0,0:32:31.90,0:32:33.34,Default,,0,0,0,,Anda bersikeras, bukan?
Dialog: 0,0:32:33.36,0:32:35.05,Default,,0,0,0,,Tidak, dia tidak mau pergi.
Dialogue: 0,0:32:35.07,0:32:38.07,Default,,0,0,0,,Sepertinya tidur terpisah membuatnya canggung.
Dialogue: 0,0:32:42.21,0:32:44.93,Default,,0,0,0,,Bagaimana cinta mereka bisa mati?
Dialogue: 0,0:32:44.96,0:32:48.16,Default,,0,0,0,,Mereka dulu sedang jatuh cinta.
Dialog: 0,0:32:48.34,0:32:50.83,Default,,0,0,0,,Maaf atas pertemuan mendadak ini.
Dialogue: 0,0:32:51.01,0:32:53.92,Default,,0,0,0,,Kamu benar-benar berdandan untuk magang.
Dialogue: 0,0:32:54.01,0:32:56.45,Default,,0,0,0,,{\an8}Anda pasti menyukai merek-merek mewah. Saya juga melakukannya.
Dialog: 0,0:32:56.47,0:32:58.05,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Empat Tahun Lalu{\c}{\i0}
Dialog: 0,0:32:59.06,0:33:01.87,Default,,0,0,0,,Tn. Baek is on his way\Nback from working outside.
Dialog: 0,0:33:01.89,0:33:05.05,Default,,0,0,0,,Saya tahu. Itu sebabnya aku meneleponmu.
Dialog: 0,0:33:05.69,0:33:07.39,Default,,0,0,0,,Apa ini?
Dialog: 0,0:33:09.40,0:33:11.34,Default,,0,0,0,,Tentang Hyun-woo...
Dialog: 0,0:33:11.36,0:33:12.54,Default,,0,0,0,,Saya tahu.
Dialogue: 0,0:33:12.57,0:33:14.76,Default,,0,0,0,,Dia lumayan. Saya yakin Anda menginginkannya.
Dialogue: 0,0:33:14.78,0:33:17.73,Default,,0,0,0,,Dia pintar dan tampan.
Dialogue: 0,0:33:17.87,0:33:19.68,Default,,0,0,0,,Apakah dia memberitahumu berapa banyak sapi yang kita miliki?
Dialog: 0,0:33:19.70,0:33:22.18,Default,,0,0,0,,- Ya.\N- Serta ukuran kebun kita?
Dialogue: 0,0:33:22.20,0:33:25.07,Default,,0,0,0,,Dan bahwa kita memiliki satu-satunya toko di kota ini?
Dialogue: 0,0:33:27.38,0:33:29.14,Default,,0,0,0,,Bagaimana dengan rumahnya di Seoul?
Dialog: 0,0:33:29.17,0:33:30.56,Default,,0,0,0,,Dia menandatangani kontrak sewa dua tahun.
Dialog: 0,0:33:30.59,0:33:33.83,Default,,0,0,0,,Maka kamu harus tahu.
Dialogue: 0,0:33:34.76,0:33:39.67,Default,,0,0,0,,Aku tidak tahu aku materialistis,\Ntapi aku tidak bisa menahannya karena dia adalah keluarga.
Dialog: 0,0:33:41.47,0:33:43.37,Default,,0,0,0,,Kudengar kamu miskin,
Dialog: 0,0:33:43.39,0:33:46.25,Default,,0,0,0,,dan kamu memakai pakaian lusuh.
Dialogue: 0,0:33:46.27,0:33:49.10,Default,,0,0,0,,Tidak, semuanya vintage spesial...
Dialogue: 0,0:33:49.94,0:33:52.63,Default,,0,0,0,,Lagi pula, apa yang dia ketahui?
Dialog: 0,0:33:52.65,0:33:54.75,Default,,0,0,0,,Itu benar. Pokoknya...
Dialogue: 0,0:33:54.78,0:33:56.30,Default,,0,0,0,,Bisakah kamu berhenti menemuinya?
Dialog: 0,0:33:56.32,0:33:58.73,Default,,0,0,0,,Aku tidak akan pernah putus dengannya,
Dialog: 0,0:33:59.20,0:34:00.18,Default,,0,0,0,,dan itu final.
Dialogue: 0,0:34:00.20,0:34:02.34,Default,,0,0,0,,Kamu cukup egois.
Dialogue: 0,0:34:02.37,0:34:05.14,Default,,0,0,0,,Semua wanita yang ingin berkencan\Ndia adalah individu sukses,
Dialog: 0,0:34:05.16,0:34:08.02,Default,,0,0,0,,seperti pegawai negeri dan\Nkaryawan perusahaan besar.
Dialogue: 0,0:34:08.04,0:34:09.89,Default,,0,0,0,,Aku tahu ini kejam, tapi itulah kenyataannya.
Dialog: 0,0:34:09.92,0:34:12.73,Default,,0,0,0,,- Mi-seon!\N- Ya ampun.
Dialog: 0,0:34:12.75,0:34:14.15,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:34:14.17,0:34:16.46,Default,,0,0,0,,Apa yang kamu katakan pada Hae-in?
Dialog: 0,0:34:16.97,0:34:18.74,Default,,0,0,0,,- Saya tidak banyak bicara. Aku...\N- Astaga.
Dialog: 0,0:34:18.76,0:34:20.78,Default,,0,0,0,,Sudah kubilang berhenti menonton drama!
Dialogue: 0,0:34:20.80,0:34:24.09,Default,,0,0,0,,Uangnya sedikit berbeda dengan drama.
Dialogue: 0,0:34:24.43,0:34:27.87,Default,,0,0,0,,Hei, aku hanya ingin kalian putus\Nsebelum kalian tumbuh bersama,
Dialog: 0,0:34:27.89,0:34:31.10,Default,,0,0,0,,dan jujur saja. Dia bukan tipemu.
Dialog: 0,0:34:36.44,0:34:38.31,Default,,0,0,0,,- Lepaskan aku.\N- Oke.
Dialog: 0,0:34:41.91,0:34:45.39,Default,,0,0,0,,Apa sebenarnya tipenya?
Dialog: 0,0:34:45.41,0:34:47.36,Default,,0,0,0,,Wanita lembut dan murni.
Dialogue: 0,0:34:47.41,0:34:49.22,Default,,0,0,0,,Bukan orang yang pemarah sepertimu.
Dialog: 0,0:34:49.25,0:34:51.44,Default,,0,0,0,,Seseorang yang membutuhkan perlindungan.
Dialogue: 0,0:34:51.46,0:34:54.52,Default,,0,0,0,,Dia selalu mengatakan itu sejak SMA.
Dialog: 0,0:34:54.55,0:34:56.71,Default,,0,0,0,,Benarkah itu Pak Baek?
Dialog: 0,0:34:57.59,0:35:00.46,Default,,0,0,0,,Ya, itu dulu tipeku,
Dialog: 0,0:35:02.05,0:35:03.75,Default,,0,0,0,,tapi...
Dialog: 0,0:35:04.31,0:35:06.55,Default,,0,0,0,,wanita yang kucintai saat ini...
Dialog: 0,0:35:07.10,0:35:08.63,Default,,0,0,0,,adalah kamu,
Dialog: 0,0:35:10.52,0:35:11.79,Default,,0,0,0,,jadi...
Dialog: 0,0:35:11.81,0:35:14.52,Default,,0,0,0,,jangan repot-repot mendengarkannya.
Dialog: 0,0:35:15.23,0:35:16.98,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:35:18.24,0:35:20.06,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:35:28.04,0:35:29.89,Default,,0,0,0,,Itu mengesankan.
Dialog: 0,0:35:29.91,0:35:32.52,Default,,0,0,0,,Aku tidak percaya kamu melakukan itu.
Dialogue: 0,0:35:32.54,0:35:34.90,Default,,0,0,0,,Sederhananya, saya membantu mereka berkumpul.
Dialog: 0,0:35:34.92,0:35:38.52,Default,,0,0,0,,Mereka tampak semakin dekat setelah kejadian itu.
Dialog: 0,0:35:38.55,0:35:40.57,Default,,0,0,0,,Astaga.
Dialog: 0,0:35:40.59,0:35:42.58,Default,,0,0,0,,Apa-apaan ini...
Dialogue: 0,0:35:42.72,0:35:44.88,Default,,0,0,0,,{\i1}terjadi pada mereka?{\i0}
Dialog: 0,0:36:04.20,0:36:05.68,Default,,0,0,0,,Tidak apa-apa. Biarkan aku melakukannya.
Dialogue: 0,0:36:05.70,0:36:06.97,Default,,0,0,0,,- Ya pak.\N- Terima kasih.
Dialog: 0,0:36:06.99,0:36:08.69,Default,,0,0,0,,Tidak masalah.
Dialog: 0,0:36:25.51,0:36:27.63,Default,,0,0,0,,Saya tidak menunggu.
Dialogue: 0,0:36:27.68,0:36:31.30,Default,,0,0,0,,Jangan kira aku menunggu\Nkamu hanya karena aku begadang.
Dialog: 0,0:36:31.85,0:36:34.72,Default,,0,0,0,,Menurutku tidak seperti itu. Ayo masuk ke dalam.
Dialog: 0,0:36:35.40,0:36:37.10,Default,,0,0,0,,Dingin.
Dialogue: 0,0:36:39.57,0:36:41.34,Default,,0,0,0,,Aku tidak bisa tidur.
Dialogue: 0,0:36:41.36,0:36:43.92,Default,,0,0,0,,Itu bukan tempat tidurku sendiri, semua anjing menggonggong,
Dialogue: 0,0:36:43.95,0:36:46.26,Default,,0,0,0,,dan aku tidak meminum obat tidurku. Itu sebabnya.
Dialog: 0,0:36:46.28,0:36:48.72,Default,,0,0,0,,Baiklah. Menurutku, kamu juga tidak menunggu.
Dialogue: 0,0:36:48.74,0:36:51.56,Default,,0,0,0,,Kamu belum pernah menungguku sebelumnya.
Dialog: 0,0:36:51.58,0:36:54.73,Default,,0,0,0,,Kamu benar. Aku bukan tipe orang yang akan menunggu.
Dialog: 0,0:36:54.75,0:36:57.70,Default,,0,0,0,,Ya, saya tahu itu lebih baik dari siapa pun.
Dialog: 0,0:37:19.77,0:37:22.06,Default,,0,0,0,,Pegang payung dengan benar.
Dialog: 0,0:37:24.78,0:37:26.80,Default,,0,0,0,,Oke, ayo masuk saja ke dalam.
Dialog: 0,0:37:26.82,0:37:29.26,Default,,0,0,0,,Sedang mengalir. Anda akan masuk angin.
Dialog: 0,0:37:29.28,0:37:30.59,Default,,0,0,0,,Kita bisa ngobrol di rumah.
Dialog: 0,0:37:30.62,0:37:32.57,Default,,0,0,0,,Saya sudah selesai bicara.
Dialogue: 0,0:37:43.09,0:37:44.65,Default,,0,0,0,,Di mana payungmu?
Dialog: 0,0:37:44.67,0:37:46.54,Default,,0,0,0,,Kenapa kamu di sini?
Dialog: 0,0:37:47.51,0:37:49.54,Default,,0,0,0,,Mari kita bicara di dalam.
Dialog: 0,0:37:51.43,0:37:53.38,Default,,0,0,0,,Ayo.
Dialogue: 0,0:38:27.55,0:38:28.94,Default,,0,0,0,,Biar aku ganti baju.
Dialog: 0,0:38:28.97,0:38:30.79,Default,,0,0,0,,Oke.
Dialogue: 0,0:38:34.31,0:38:36.13,Default,,0,0,0,,Mau teh?
Dialog: 0,0:38:36.31,0:38:38.01,Default,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:38:39.15,0:38:41.51,Default,,0,0,0,,Saya merasa seperti pemilik di sini.
Dialog: 0,0:38:43.90,0:38:47.39,Default,,0,0,0,,Ngomong-ngomong, kenapa kamu ada di sini?
Dialog: 0,0:38:47.53,0:38:48.76,Default,,0,0,0,,Benar.
Dialog: 0,0:38:48.78,0:38:50.63,Default,,0,0,0,,Ibu Hae-in mengundangku.
Dialogue: 0,0:38:50.66,0:38:52.01,Default,,0,0,0,,Dia pasti merasa tidak enak...
Dialog: 0,0:38:52.03,0:38:53.97,Default,,0,0,0,,bahwa aku harus makan sendirian di hotel,
Dialog: 0,0:38:53.99,0:38:55.85,Default,,0,0,0,,jadi dia menawariku wisma.
Dialog: 0,0:38:55.87,0:38:57.72,Default,,0,0,0,,Hae-in dan aku ada urusan yang harus diselesaikan,
Dialog: 0,0:38:57.75,0:39:01.49,Default,,0,0,0,,jadi tinggal di sini akan lebih nyaman bagi kami.
Dialog: 0,0:39:02.46,0:39:06.06,Default,,0,0,0,,- Apakah Anda tidak nyaman?\N- Apakah Anda akan pergi jika saya menjawab ya?
Dialog: 0,0:39:06.09,0:39:07.62,Default,,0,0,0,,Tidak.
Dialog: 0,0:39:10.47,0:39:12.92,Default,,0,0,0,,Maka tidak ada gunanya menjawab.
Dialogue: 0,0:39:24.11,0:39:25.79,Default,,0,0,0,,Apa ini?
Dialog: 0,0:39:25.82,0:39:27.60,Default,,0,0,0,,Kapan ini terjadi?
Dialog: 0,0:39:37.37,0:39:40.36,Default,,0,0,0,,Apa? Mengapa tidak hilang?
Dialog: 0,0:39:46.92,0:39:49.50,Default,,0,0,0,,Minum. Anda akan masuk angin.
Dialog: 0,0:39:50.72,0:39:52.29,Default,,0,0,0,,Di mana dia?
Dialog: 0,0:39:52.39,0:39:53.57,Default,,0,0,0,,Tn. Baek?
Dialog: 0,0:39:53.59,0:39:55.34,Default,,0,0,0,,Dia naik ke atas.
Dialog: 0,0:39:56.06,0:39:58.30,Default,,0,0,0,,- Begitu.\N- Bukankah dia ada di kamar?
Dialog: 0,0:39:59.77,0:40:01.59,Default,,0,0,0,,Tidak.
Dialogue: 0,0:40:04.09,0:40:06.33,Default,,0,0,0,,Apakah kamu tidur terpisah?
Dialogue: 0,0:40:10.36,0:40:11.55,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana pernikahan mereka?{\c}{\i0}
Dialog: 0,0:40:11.57,0:40:13.72,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mengerikan.{\c}{\i0}
Dialogue: 0,0:40:13.74,0:40:16.19,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka tidur terpisah,{\c}{\i0}
Dialog: 0,0:40:16.24,0:40:18.18,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi ini aneh.{\c}{\i0}
Dialogue: 0,0:40:18.20,0:40:22.56,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jelas Hyun-woo\Nmuak dan bosan dengan mertuanya,{\c}{\i0}
Dialog: 0,0:40:22.58,0:40:24.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi dia terus mengatakan hal yang benar,{\c}{\i0}
Dialog: 0,0:40:24.88,0:40:25.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dan tahukah Anda?{\c}{\i0}
Dialog: 0,0:40:25.88,0:40:27.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ketua Hong...{\c}{\i0}
Dialog: 0,0:40:27.38,0:40:30.82,Default,,0,0,0,,{\i1}{\c&HFFFF00&}sebenarnya mendengarkan apa yang dia katakan.{\c}{\i0}
Dialog: 0,0:40:30.84,0:40:34.07,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in dan Hyun-woo berdebat\Nkapan pun mereka bersama,{\c}{\i0}
Dialogue: 0,0:40:34.09,0:40:37.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi anehnya, dia juga mendengarkannya.{\c}{\i0}
Dialogue: 0,0:40:37.14,0:40:41.59,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi Hyun-woo membantu\Nmereka sadar?{\c}{\i0}
Dialog: 0,0:40:41.81,0:40:43.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tepat.{\c}{\i0}
Dialogue: 0,0:40:44.23,0:40:47.12,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia bisa menimbulkan masalah dalam rencana kita.{\c}{\i0}
Dialog: 0,0:40:47.15,0:40:48.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Yang terbaik...{\c}{\i0}
Dialog: 0,0:40:48.44,0:40:51.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}untuk mengusirnya dari\Nrumah sesegera mungkin.{\c}{\i0}
Dialogue: 0,0:40:52.20,0:40:53.95,Default,,0,0,0,,Apakah kalian baik-baik saja?
Dialog: 0,0:40:55.16,0:40:56.22,Default,,0,0,0,,Apa?
Dialog: 0,0:40:56.24,0:40:57.80,Default,,0,0,0,,Ini sangat tidak biasa.
Dialogue: 0,0:40:57.83,0:41:02.56,Default,,0,0,0,,Suami akan diganggu\Njika teman laki-laki istrinya...
Dialog: 0,0:41:02.58,0:41:04.68,Default,,0,0,0,,pindah ke rumah mereka.
Dialog: 0,0:41:04.71,0:41:05.81,Default,,0,0,0,,Tapi?
Dialog: 0,0:41:05.83,0:41:07.60,Default,,0,0,0,,Aku bertanya padanya...
Dialog: 0,0:41:07.63,0:41:10.83,Default,,0,0,0,,jika dia merasa tidak nyaman dengan saya tinggal di sini,
Dialog: 0,0:41:13.22,0:41:15.04,Default,,0,0,0,,dan dia tidak keberatan.
Dialogue: 0,0:41:29.02,0:41:31.85,Default,,0,0,0,,Kenapa dia pindah dari hotel?
Dialogue: 0,0:41:31.98,0:41:35.31,Default,,0,0,0,,Apa yang ibu mertuaku pikirkan?
Dialog: 0,0:41:35.95,0:41:37.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in dan aku...{\c}{\i0}
Dialog: 0,0:41:38.37,0:41:41.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}memiliki hubungan yang baik di masa lalu.{\c}{\i0}
Dialog: 0,0:41:41.37,0:41:43.76,Default,,0,0,0,,Mereka memiliki hubungan yang baik.
Dialogue: 0,0:41:43.79,0:41:48.07,Default,,0,0,0,,Dia bukan seseorang yang seharusnya ada di sini.
Dialog: 0,0:41:48.21,0:41:51.08,Default,,0,0,0,,Astaga. Hubungan baik seperti apa?
Dialogue: 0,0:41:55.55,0:41:57.50,Default,,0,0,0,,Apakah aku akan terlihat menyedihkan...
Dialog: 0,0:41:59.18,0:42:01.30,Default,,0,0,0,,jika aku menanyakannya sekarang?
Dialogue: 0,0:42:10.77,0:42:12.42,Default,,0,0,0,,Jadi semuanya terhubung di sini.
Dialog: 0,0:42:12.44,0:42:16.10,Default,,0,0,0,,Kami tidak pernah mengungkapkan hal ini kepada media.
Dialog: 0,0:42:16.74,0:42:18.88,Default,,0,0,0,,Sepertinya rumah kita semua terpisah,
Dialog: 0,0:42:18.91,0:42:22.05,Default,,0,0,0,,tapi sebenarnya semuanya\Nterhubung di ruang bawah tanah.
Dialogue: 0,0:42:22.08,0:42:24.51,Default,,0,0,0,,Kakek kami sengaja\Nmendesainnya seperti ini.
Dialog: 0,0:42:24.54,0:42:25.76,Default,,0,0,0,,Begitu,
Dialog: 0,0:42:25.79,0:42:28.60,Default,,0,0,0,,jadi kamu punya akses ke semua rumah di sini.
Dialog: 0,0:42:28.62,0:42:30.64,Default,,0,0,0,,Ya, dan kami juga memiliki ruangan itu.
Dialog: 0,0:42:30.67,0:42:32.93,Default,,0,0,0,,Anda tahu film dengan\Nruang rahasia, "Shock Room"?
Dialog: 0,0:42:32.95,0:42:34.65,Default,,0,0,0,,Ini "Ruang Panik," idiot.
Dialog: 0,0:42:34.67,0:42:36.87,Default,,0,0,0,,- Saya tahu.\N- Lalu lakukan dengan benar.
Dialogue: 0,0:42:39.97,0:42:42.24,Default,,0,0,0,,Jangan terlalu kasar padanya.
Dialogue: 0,0:42:42.26,0:42:45.74,Default,,0,0,0,,Mereka akan menyajikan makan malam kita\Ndi sini, jadi ayo makan bersama.
Dialogue: 0,0:42:45.77,0:42:48.39,Default,,0,0,0,,Kalian boleh makan. Saya akan istirahat.
Dialog: 0,0:42:51.81,0:42:55.17,Default,,0,0,0,,Mengapa? Kamu makan enak sekali di rumah mertuamu,
Dialog: 0,0:42:55.19,0:42:56.80,Default,,0,0,0,,yang jarang kamu temui.
Dialog: 0,0:42:56.82,0:43:00.59,Default,,0,0,0,,Kamu makan semuanya dan tersenyum lebar.
Dialog: 0,0:43:00.61,0:43:02.88,Default,,0,0,0,,Kamu tahu video itu menjadi viral, bukan?
Dialogue: 0,0:43:02.91,0:43:06.51,Default,,0,0,0,,Tim PR kami bekerja keras hari ini untuk mengatasinya.
Dialog: 0,0:43:06.54,0:43:09.36,Default,,0,0,0,,Kenapa kamu begitu kesal?
Dialog: 0,0:43:09.58,0:43:10.68,Default,,0,0,0,,Karena saya mengunjunginya?
Dialogue: 0,0:43:10.71,0:43:13.06,Default,,0,0,0,,Karena aku makan semuanya dan banyak tersenyum?
Dialog: 0,0:43:13.09,0:43:14.31,Default,,0,0,0,,Atau...
Dialog: 0,0:43:14.34,0:43:15.36,Default,,0,0,0,,apakah itu videonya?
Dialogue: 0,0:43:15.38,0:43:18.08,Default,,0,0,0,,Karena tim PR harus melindungi saya?
Dialog: 0,0:43:18.97,0:43:20.55,Default,,0,0,0,,Saya tidak kesal.
Dialog: 0,0:43:20.58,0:43:21.61,Default,,0,0,0,,Tentu.
Dialog: 0,0:43:21.64,0:43:22.78,Default,,0,0,0,,Saya hanya terpesona.
Dialog: 0,0:43:22.80,0:43:24.42,Default,,0,0,0,,Dengan apa?
Dialog: 0,0:43:24.64,0:43:27.59,Default,,0,0,0,,Aku jarang melihatmu tersenyum seperti itu.
Dialogue: 0,0:43:28.56,0:43:31.47,Default,,0,0,0,,Aku juga jarang melihatmu tersenyum padaku.
Dialogue: 0,0:43:33.98,0:43:37.73,Default,,0,0,0,,Kita tidak punya banyak hal yang bisa membuat kita tersenyum, bukan?
Dialog: 0,0:43:37.78,0:43:39.21,Default,,0,0,0,,Tepat,
Dialog: 0,0:43:39.24,0:43:41.10,Default,,0,0,0,,jadi makanlah tanpa aku.
Dialogue: 0,0:43:42.11,0:43:44.36,Default,,0,0,0,,Selamat bersenang-senang.
Dialogue: 0,0:43:56.75,0:43:58.91,Default,,0,0,0,,Kamu pasti terkejut.
Dialog: 0,0:43:59.80,0:44:02.00,Default,,0,0,0,,Saya akan minta maaf atas namanya.
Dialog: 0,0:44:02.34,0:44:04.04,Default,,0,0,0,,Tidak apa-apa.
Dialog: 0,0:44:06.72,0:44:08.45,Default,,0,0,0,,Itu hal biasa.
Dialogue: 0,0:44:08.47,0:44:10.95,Default,,0,0,0,,Dapatkah kamu melihat betapa aku berjuang di sini?
Dialog: 0,0:44:10.98,0:44:13.01,Default,,0,0,0,,Benar.
Dialog: 0,0:44:13.19,0:44:16.18,Default,,0,0,0,,Tapi saya mengerti Hae-in.
Dialog: 0,0:44:16.86,0:44:20.67,Default,,0,0,0,,Saya yakin Anda sudah tahu,\Ntapi dia pemarah.
Dialogue: 0,0:44:20.69,0:44:26.07,Default,,0,0,0,,Aku yakin ketidakamanannya\Nterhadapku berperan.
Dialogue: 0,0:44:27.20,0:44:29.68,Default,,0,0,0,,Tapi menurutku dia tidak merasa seperti itu.
Dialogue: 0,0:44:29.70,0:44:34.78,Default,,0,0,0,,Dia tidak tahu aku mondar-mandir untuknya.
Dialog: 0,0:44:38.00,0:44:41.21,Default,,0,0,0,,Saya tidak tahu Anda sedang mondar-mandir.
Dialog: 0,0:44:41.30,0:44:45.54,Default,,0,0,0,,Tidak mudah untuk duduk di Tahta Ratu\N. Ada banyak hal yang harus dilakukan.
Dialogue: 0,0:44:46.14,0:44:48.88,Default,,0,0,0,,Tidakkah kamu lihat apa yang ada di pundakku?
Dialogue: 0,0:44:50.10,0:44:52.93,Default,,0,0,0,,Beban dan tanggung jawab.
Dialogue: 0,0:44:53.56,0:44:56.76,Default,,0,0,0,,Itulah alasan aku lebih pendek empat inci.
Dialogue: 0,0:44:57.27,0:45:00.73,Default,,0,0,0,,Nasibku dan Hae-in membebaniku.
Dialogue: 0,0:45:01.32,0:45:03.35,Default,,0,0,0,,Hae-in membebanimu?
Dialogue: 0,0:45:03.61,0:45:05.97,Default,,0,0,0,,Dia baru saja meninju perutku,
Dialog: 0,0:45:05.99,0:45:08.26,Default,,0,0,0,,dan aku tidak bisa bernapas selama beberapa menit.
Dialogue: 0,0:45:08.28,0:45:12.06,Default,,0,0,0,,Ibuku kaget sekali, dan mereka sering bertengkar,
Dialog: 0,0:45:12.08,0:45:15.49,Default,,0,0,0,,jadi ibuku mengunjungi seseorang.
Dialog: 0,0:45:15.92,0:45:17.62,Default,,0,0,0,,Siapa?
Dialogue: 0,0:45:18.13,0:45:21.40,Default,,0,0,0,,Dia tahu siapa yang akan menjadi Presiden\Ndan bahkan meramalkan COVID-19.
Dialog: 0,0:45:21.42,0:45:24.40,Default,,0,0,0,,Dia juga memperingatkan\Nkakekku untuk tidak pergi berburu.
Dialog: 0,0:45:24.43,0:45:26.24,Default,,0,0,0,,Benar, dukun hebat.
Dialog: 0,0:45:26.26,0:45:27.24,Default,,0,0,0,,Ya, dia.
Dialogue: 0,0:45:27.26,0:45:32.30,Default,,0,0,0,,Dia membayarnya sejumlah besar uang, dan mendapatkan ini.
Dialogue: 0,0:45:36.40,0:45:38.00,Default,,0,0,0,,Sebuah jimat?
Dialogue: 0,0:45:38.02,0:45:40.68,Default,,0,0,0,,{\an8}Ini akan membuatku tetap aman.
Dialog: 0,0:45:41.44,0:45:43.29,Default,,0,0,0,,Kata dukun...
Dialogue: 0,0:45:43.32,0:45:47.30,Default,,0,0,0,,ini akan membantuku menaklukkan Hae-in,\Nsupaya aku bisa melebarkan sayapku dan terbang.
Dialog: 0,0:45:47.32,0:45:48.80,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:45:48.82,0:45:52.10,Default,,0,0,0,,Astaga, aku tidak percaya padanya.\NIItu semua takhayul,
Dialogue: 0,0:45:52.12,0:45:55.72,Default,,0,0,0,,tapi ibuku memeriksa apakah aku menyimpannya.
Dialogue: 0,0:45:55.75,0:45:57.31,Default,,0,0,0,,Tapi menurutku itu tidak berhasil.
Dialog: 0,0:45:57.33,0:46:00.58,Default,,0,0,0,,Hae-in masih sama kuatnya.
Dialog: 0,0:46:01.09,0:46:03.98,Default,,0,0,0,,{\i1}Perawatan yang diusulkan oleh laboratorium Jerman...{\i0}
Dialog: 0,0:46:04.01,0:46:05.32,Default,,0,0,0,,{\i1}menggunakan sel CAR-T...{\i0}
Dialog: 0,0:46:05.34,0:46:08.36,Default,,0,0,0,,{\i1}untuk mengobati sel kekebalan.{\i0}
Dialogue: 0,0:46:08.39,0:46:11.26,Default,,0,0,0,,{\i1}Ini adalah jenis pengobatan kanker\Ndi mana mereka mengekstrak sel kekebalan...{\i0}
Dialog: 0,0:46:11.28,0:46:15.12,Default,,0,0,0,,{\i1}dari darahmu, ubah menjadi\sel NCAR-T yang memiliki kemampuan...{\i0}
Dialog: 0,0:46:15.14,0:46:18.12,Default,,0,0,0,,{\i1}untuk menghilangkan sel tumor, dan\Nmenyuntikkannya kembali ke tubuh Anda.{\i0}
Dialogue: 0,0:46:18.15,0:46:20.67,Default,,0,0,0,,{\i1}Perawatan ini sering\Nterbukti efektif...{\i0}
Dialog: 0,0:46:20.69,0:46:22.75,Default,,0,0,0,,{\i1}bagi penderita leukemia,{\i0}
Dialogue: 0,0:46:22.77,0:46:26.02,Default,,0,0,0,,tapi belum untuk tumor otak.
Dialog: 0,0:46:27.36,0:46:29.13,Default,,0,0,0,,Tapi...
Dialog: 0,0:46:29.16,0:46:32.14,Default,,0,0,0,,mereka bilang tingkat keberhasilannya lebih dari 50%.
Dialog: 0,0:46:32.16,0:46:35.81,Default,,0,0,0,,Saya yakin mereka memberi Anda\Nangka itu setelah melihat prognosis yang baik...
Dialog: 0,0:46:35.83,0:46:38.18,Default,,0,0,0,,pada pasien tumor otak...
Dialog: 0,0:46:38.21,0:46:42.15,Default,,0,0,0,,yang diberi perawatan ini dalam beberapa tahun terakhir,
Dialog: 0,0:46:42.17,0:46:45.02,Default,,0,0,0,,tetapi Anda tidak boleh menganggap itu sebagai pemulihan penuh.
Dialog: 0,0:46:45.05,0:46:47.00,Default,,0,0,0,,Saya akan melakukannya.
Dialog: 0,0:46:47.05,0:46:49.29,Default,,0,0,0,,Sudah kubilang berkali-kali.
Dialogue: 0,0:46:49.55,0:46:51.57,Default,,0,0,0,,Aku akan cari jalan.
Dialog: 0,0:46:51.60,0:46:54.21,Default,,0,0,0,,Bahkan jika aku harus mencari di seluruh dunia,
Dialog: 0,0:46:54.26,0:46:56.42,Default,,0,0,0,,Aku akan mencari cara untuk hidup,
Dialogue: 0,0:46:56.93,0:46:59.14,Default,,0,0,0,,jadi jangan beritahu aku...
Dialog: 0,0:47:02.44,0:47:04.52,Default,,0,0,0,,tidak akan berhasil.
Dialog: 0,0:47:14.41,0:47:16.39,Default,,0,0,0,,{\i1}Bayi mereka ada di inkubator.{\i0}
Dialogue: 0,0:47:16.41,0:47:18.45,Default,,0,0,0,,{\i1}Aku merasa tidak enak, jadi...{\i0}
Dialogue: 0,0:47:29.97,0:47:31.83,Default,,0,0,0,,Bagaimana kabar bayimu?
Dialog: 0,0:47:32.93,0:47:33.99,Default,,0,0,0,,Halo Bu.
Dialogue: 0,0:47:34.01,0:47:35.70,Default,,0,0,0,,Apa yang membawamu ke rumah sakit?
Dialog: 0,0:47:35.72,0:47:37.20,Default,,0,0,0,,Apakah masih di inkubator?
Dialog: 0,0:47:37.22,0:47:39.54,Default,,0,0,0,,Tidak, tidak lagi,
Dialog: 0,0:47:39.56,0:47:42.12,Default,,0,0,0,,- tapi bayi kita ada di ICU.\N- Siapa nama bayinya?
Dialogue: 0,0:47:42.15,0:47:45.47,Default,,0,0,0,,Kami belum mendaftarkan kelahirannya,
Dialog: 0,0:47:46.11,0:47:48.27,Default,,0,0,0,,tapi Cho-rong adalah nama panggilannya.
Dialog: 0,0:47:50.86,0:47:53.93,Default,,0,0,0,,Saya biasa minum jus sayur setiap pagi,
Dialogue: 0,0:47:53.95,0:47:56.97,Default,,0,0,0,,tapi akhir-akhir ini aku sibuk,\Njadi aku lupa.
Dialog: 0,0:47:56.99,0:47:58.39,Default,,0,0,0,,Maaf?
Dialog: 0,0:47:58.41,0:48:01.43,Default,,0,0,0,,Saya ingin memesan jus dari Anda secara rutin.
Dialog: 0,0:48:01.46,0:48:03.24,Default,,0,0,0,,Terima kasih bu.
Dialog: 0,0:48:03.54,0:48:06.10,Default,,0,0,0,,Saya akan mengirimkan satu kepada Anda, mulai besok...
Dialogue: 0,0:48:06.13,0:48:09.40,Default,,0,0,0,,Akan terlihat murah jika saya memilikinya\Nsendiri, jadi bawalah beberapa lagi.
Dialog: 0,0:48:09.42,0:48:11.40,Default,,0,0,0,,Ya, Bu. Berapa banyak lagi yang Anda inginkan?
Dialog: 0,0:48:11.43,0:48:12.82,Default,,0,0,0,,Yah...
Dialog: 0,0:48:12.84,0:48:16.38,Default,,0,0,0,,Jika semua karyawan saya\Nuntuk mendapatkan satu, maka sekitar 250.
Dialog: 0,0:48:16.72,0:48:18.42,Default,,0,0,0,,Maaf?
Dialogue: 0,0:48:20.27,0:48:22.34,Default,,0,0,0,,Terima kasih bu!
Dialog: 0,0:48:22.94,0:48:24.97,Default,,0,0,0,,Terima kasih!
Dialogue: 0,0:48:26.52,0:48:29.09,Default,,0,0,0,,Pak, ini adalah cetak biru\NI yang telah saya ceritakan kepada Anda.
Dialog: 0,0:48:29.11,0:48:33.30,Default,,0,0,0,,Ini adalah kompleks resor yang akan menjadi\Nistana kerajaan Ratu kita.
Dialog: 0,0:48:33.32,0:48:36.72,Default,,0,0,0,,Ini mencakup dua hotel bintang lima,\Ntoko bebas bea, kasino untuk orang asing,
Dialogue: 0,0:48:36.74,0:48:39.35,Default,,0,0,0,,sebuah arena, pusat konvensi,\Na taman air keluarga...
Dialog: 0,0:48:39.37,0:48:41.65,Default,,0,0,0,,Dan berapa biayanya?
Dialog: 0,0:48:41.96,0:48:43.87,Default,,0,0,0,,Satu miliar...
Dialog: 0,0:48:46.67,0:48:49.66,Default,,0,0,0,,- dan 700 hingga 900 juta dolar.\N- Lakukan...
Dialogue: 0,0:48:50.84,0:48:52.11,Default,,0,0,0,,Dengan uangmu.
Dialogue: 0,0:48:52.13,0:48:54.19,Default,,0,0,0,,Kakek, aku tidak meminta uangmu.
Dialogue: 0,0:48:54.22,0:48:57.70,Default,,0,0,0,,Kita hanya perlu mengamankan situs,\Nand Eun-sung akan berinvestasi pada kita.
Dialog: 0,0:48:57.72,0:48:58.82,Default,,0,0,0,,Siapa?
Dialog: 0,0:48:58.85,0:49:00.16,Default,,0,0,0,,Tn. Yoon Eun Sung.
Dialogue: 0,0:49:00.18,0:49:03.05,Default,,0,0,0,,Kami sudah cukup dekat sejak dia pindah.
Dialogue: 0,0:49:03.19,0:49:05.33,Default,,0,0,0,,Apakah kamu bilang dia setuju dengan ini?
Dialogue: 0,0:49:05.35,0:49:08.83,Default,,0,0,0,,Kita masih dalam tahap\N awal, tapi bisa dibilang begitu.
Dialog: 0,0:49:08.86,0:49:10.67,Default,,0,0,0,,Aku malu mengatakan ini,
Dialogue: 0,0:49:10.69,0:49:12.81,Default,,0,0,0,,tapi dia jungkir balik padaku.
Dialogue: 0,0:49:12.94,0:49:14.60,Default,,0,0,0,,Dia tidak sedingin yang kukira.
Dialogue: 0,0:49:14.62,0:49:17.13,Default,,0,0,0,,Dia sangat penyayang\Nonce kamu tumbuh padanya.
Dialogue: 0,0:49:17.16,0:49:18.13,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:49:18.16,0:49:20.14,Default,,0,0,0,,Dia pasti menyukaimu.
Dialogue: 0,0:49:20.16,0:49:21.55,Default,,0,0,0,,Lebih dari itu.
Dialogue: 0,0:49:21.58,0:49:26.91,Default,,0,0,0,,Dia sangat ingin mendengarkan apa yang ingin aku lakukan.
Dialog: 0,0:49:27.29,0:49:28.99,Default,,0,0,0,,Apakah dia?
Dialog: 0,0:49:29.13,0:49:32.52,Default,,0,0,0,,Ayah, dana Tuan Yoon berasal\Ndari uang minyak Timur Tengah,
Dialogue: 0,0:49:32.55,0:49:34.19,Default,,0,0,0,,jadi dia bisa diandalkan.
Dialogue: 0,0:49:34.22,0:49:35.23,Default,,0,0,0,,Benarkah?
Dialog: 0,0:49:35.26,0:49:36.78,Default,,0,0,0,,- Dalam hal ini...\N- Tunggu.
Dialogue: 0,0:49:36.80,0:49:39.36,Default,,0,0,0,,Saya pikir kita harus melakukan\Npemeriksaan validitas situs terlebih dahulu.
Dialogue: 0,0:49:39.39,0:49:42.95,Default,,0,0,0,,{\an8}Kami telah melakukan banyak studi kelayakan\Ndi situs kami sebelumnya.
Dialogue: 0,0:49:42.97,0:49:45.58,Default,,0,0,0,,{\an8}Namun, tidak ada satupun yang\Ndiselesaikan karena beberapa risiko.
Dialog: 0,0:49:45.60,0:49:48.50,Default,,0,0,0,,Kami memerlukan izin pemerintah\Nuntuk toko bebas bea dan kasino.
Dialog: 0,0:49:48.52,0:49:50.17,Default,,0,0,0,,Adapun perizinannya...
Dialog: 0,0:49:50.19,0:49:53.50,Default,,0,0,0,,Anda tahu kami memiliki orang\Ndi Kementerian Pertanahan.
Dialogue: 0,0:49:53.53,0:49:57.61,Default,,0,0,0,,Kita bisa mempercayainya karena dia\Nmenerima beasiswa kita.
Dialog: 0,0:49:57.72,0:49:59.65,Default,,0,0,0,,Tetapi orang bisa berubah.
Dialog: 0,0:49:59.99,0:50:04.32,Default,,0,0,0,,Beresiko mengandalkan dia, dan\Nmemulai bisnis senilai $1,9 miliar.
Dialogue: 0,0:50:07.33,0:50:11.29,Default,,0,0,0,,Itu poin yang adil, bukan?
Dialog: 0,0:50:11.71,0:50:14.69,Default,,0,0,0,,Ya, Ayah. Dia tahu apa yang penting.
Dialog: 0,0:50:14.72,0:50:16.42,Default,,0,0,0,,Ayah?
Dialog: 0,0:50:16.68,0:50:19.50,Default,,0,0,0,,Tinjau risikonya terlebih dahulu.
Dialog: 0,0:50:21.97,0:50:25.63,Default,,0,0,0,,Tidak ada salahnya mengulas, Soo-cheol.
Dialog: 0,0:50:33.82,0:50:35.52,Default,,0,0,0,,Hyun-woo.
Dialog: 0,0:50:35.61,0:50:37.27,Default,,0,0,0,,Halo pak.
Dialog: 0,0:50:43.49,0:50:47.16,Default,,0,0,0,,Kamu menyuruhku menelepon jika aku mengingat sesuatu.
Dialogue: 0,0:50:47.71,0:50:50.60,Default,,0,0,0,,Seorang pengantar gas datang hari itu.
Dialog: 0,0:50:50.63,0:50:52.87,Default,,0,0,0,,Kamera dasbor?
Dialog: 0,0:50:53.00,0:50:56.02,Default,,0,0,0,,Ya, dia punya satu.
Dialog: 0,0:50:56.05,0:50:57.98,Default,,0,0,0,,Saya menerimanya,
Dialogue: 0,0:50:58.01,0:51:01.90,Default,,0,0,0,,tapi ukuran memorinya kecil,\Njadi rekaman hari itu hilang.
Dialog: 0,0:51:01.93,0:51:04.62,Default,,0,0,0,,Tidak apa-apa. Saya akan mencoba memulihkannya.
Dialog: 0,0:51:04.64,0:51:08.22,Default,,0,0,0,,Saya akan mengirim kurir untuk mengambilnya.
Dialog: 0,0:51:08.52,0:51:10.22,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:51:11.31,0:51:12.46,Default,,0,0,0,,Ini dari kamera dasbor.
Dialog: 0,0:51:12.48,0:51:14.71,Default,,0,0,0,,Rekaman lama telah dihapus.
Dialogue: 0,0:51:14.73,0:51:16.29,Default,,0,0,0,,Berapa lama waktu yang dibutuhkan untuk memulihkannya?
Dialogue: 0,0:51:16.32,0:51:18.67,Default,,0,0,0,,Yah, menurutku setidaknya tiga sampai empat hari,
Dialog: 0,0:51:18.70,0:51:19.76,Default,,0,0,0,,tapi tidak ada jaminan.
Dialog: 0,0:51:19.78,0:51:22.55,Default,,0,0,0,,Ini rekaman penting,\Njadi harap pulihkan dengan baik.
Dialog: 0,0:51:22.57,0:51:24.28,Default,,0,0,0,,Oke.
Dialog: 0,0:51:24.70,0:51:28.26,Default,,0,0,0,,Dokter, ketua kami tertarik\Nin ubi jalar seminggu terakhir ini,
Dialog: 0,0:51:28.29,0:51:30.68,Default,,0,0,0,,karena itu adalah makanan favorit Lessie Brown...
Dialog: 0,0:51:30.71,0:51:32.14,Default,,0,0,0,,sampai kematiannya di 114.
Dialog: 0,0:51:32.17,0:51:36.27,Default,,0,0,0,,Saya dengar dia tertarik pada\Nberi minggu lalu, karena...
Dialog: 0,0:51:36.30,0:51:38.73,Default,,0,0,0,,Makanan favorit\NChristina Wahara hingga kematiannya di usia 102.
Dialog: 0,0:51:38.76,0:51:40.50,Default,,0,0,0,,Benar.
Dialogue: 0,0:51:40.80,0:51:46.16,Default,,0,0,0,,Tetapi karena Brown hidup 12\Ntahun lebih lama dari Wahara...
Dialog: 0,0:51:46.18,0:51:49.08,Default,,0,0,0,,Lalu ubi kering? Dia suka makanan manis.
Dialogue: 0,0:51:49.10,0:51:52.08,Default,,0,0,0,,Tidak, gula darahnya tinggi.\NKamu harus merebusnya.
Dialogue: 0,0:51:52.10,0:51:53.41,Default,,0,0,0,,Dia tidak akan suka itu.
Dialog: 0,0:51:53.44,0:51:54.42,Default,,0,0,0,,Mau bagaimana lagi.
Dialog: 0,0:51:54.44,0:51:59.88,Default,,0,0,0,,Silakan sajikan dada ayam,\Nkacang, dan putih telur untuk saat ini.
Dialog: 0,0:51:59.90,0:52:01.69,Default,,0,0,0,,Apakah kamu serius?
Dialog: 0,0:52:02.20,0:52:05.07,Default,,0,0,0,,Putih telur, dada ayam,
Dialog: 0,0:52:05.28,0:52:06.68,Default,,0,0,0,,dan kacang? Ayo.
Dialogue: 0,0:52:06.70,0:52:09.47,Default,,0,0,0,,Dia mengunyah iga kapan pun dia kesal.
Dialog: 0,0:52:09.50,0:52:10.68,Default,,0,0,0,,Dia mungkin juga mati.
Dialog: 0,0:52:10.71,0:52:12.02,Default,,0,0,0,,Perhatikan apa yang kamu katakan.
Dialogue: 0,0:52:12.04,0:52:13.10,Default,,0,0,0,,Apa departemenmu?
Dialog: 0,0:52:13.12,0:52:15.27,Default,,0,0,0,,- Obat keluarga, Bu.\N- Pak Jang.
Dialog: 0,0:52:15.29,0:52:18.56,Default,,0,0,0,,Psikiater ayahku juga seharusnya ada di sini,
Dialog: 0,0:52:18.59,0:52:20.94,Default,,0,0,0,,sehingga dia dapat mempertimbangkan kondisi mental\Nnya.
Dialog: 0,0:52:20.97,0:52:22.82,Default,,0,0,0,,Ya, Bu.
Dialog: 0,0:52:22.84,0:52:24.50,Default,,0,0,0,,Juga...
Dialog: 0,0:52:28.60,0:52:30.88,Default,,0,0,0,,Aku tidak bisa mempercayakanmu...
Dialog: 0,0:52:31.27,0:52:34.41,Default,,0,0,0,,dengan menyiapkan makanan ayahku.
Dialogue: 0,0:52:34.44,0:52:36.29,Default,,0,0,0,,Kudengar kamu membuat bumbunya sendiri.
Dialog: 0,0:52:36.31,0:52:40.59,Default,,0,0,0,,Dia hanya ingin kecap yang aku buat.
Dialog: 0,0:52:40.61,0:52:43.40,Default,,0,0,0,,Tepat. Siapa yang tahu apa yang Anda masukkan ke dalamnya?
Dialog: 0,0:52:44.36,0:52:49.55,Default,,0,0,0,,Saya ingin Anda mencoba semua makanannya di\Ndepan saya sebelum menyajikannya kepadanya.
Dialog: 0,0:52:49.58,0:52:51.43,Default,,0,0,0,,Seperti yang dilakukan dayang-dayang itu.
Dialog: 0,0:52:51.45,0:52:54.24,Default,,0,0,0,,Tidak, kamu akan menjadi selirnya.
Dialogue: 0,0:52:57.59,0:52:59.23,Default,,0,0,0,, Cukup sekian untuk hari ini.
Dialog: 0,0:52:59.25,0:53:01.46,Default,,0,0,0,,Anda boleh pergi.
Dialog: 0,0:53:04.09,0:53:05.36,Default,,0,0,0,,Apa yang harus kita lakukan?
Dialog: 0,0:53:05.39,0:53:08.32,Default,,0,0,0,,Bagaimana jika Beom-ja memukulnya lagi?
Dialogue: 0,0:53:08.35,0:53:11.51,Default,,0,0,0,,Haruskah aku menunggu dan mentraktirnya setelahnya?
Dialogue: 0,0:53:13.52,0:53:14.91,Default,,0,0,0,,Kenapa dikunci?
Dialogue: 0,0:53:14.94,0:53:17.31,Default,,0,0,0,,Berencana memohon padaku atau apalah?
Dialog: 0,0:53:18.44,0:53:20.47,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:53:28.70,0:53:30.53,Default,,0,0,0,,Apa itu tadi?
Dialog: 0,0:53:32.00,0:53:33.10,Default,,0,0,0,,Beom-ja.
Dialog: 0,0:53:33.12,0:53:34.18,Default,,0,0,0,,"Beom-ja"?
Dialogue: 0,0:53:34.21,0:53:37.18,Default,,0,0,0,,Kamu nakal dengan\Nsaya selama 20 tahun terakhir,
Dialog: 0,0:53:37.21,0:53:38.56,Default,,0,0,0,,dan akan terus melakukan itu.
Dialogue: 0,0:53:38.59,0:53:41.62,Default,,0,0,0,,Tapi coba tebak? Saya tidak lagi menganggapnya lucu.
Dialog: 0,0:53:42.21,0:53:44.78,Default,,0,0,0,,Apakah kamu gila? Beraninya\Nkamu bicara seperti itu padaku?
Dialog: 0,0:53:44.80,0:53:48.71,Default,,0,0,0,,"Manis"? Apakah Anda ingin lebih banyak cakram yang tergelincir?
Dialog: 0,0:53:50.18,0:53:52.91,Default,,0,0,0,,Tunggu! Itu menyakitkan!
Dialog: 0,0:53:52.93,0:53:56.55,Default,,0,0,0,,Saya menghitung sampai tiga. Satu dua tiga!
Dialog: 0,0:54:02.78,0:54:04.09,Default,,0,0,0,,Kepalkan rahangmu,
Dialogue: 0,0:54:04.11,0:54:06.44,Default,,0,0,0,,- Kenapa?\N- ...atau kamu akan gigit lidah.
Dialogue: 0,0:54:13.95,0:54:16.18,Default,,0,0,0,,Gadis itu memukulku!
Dialog: 0,0:54:16.21,0:54:18.18,Default,,0,0,0,,Di perutku! Seperti ini!
Dialog: 0,0:54:18.21,0:54:19.85,Default,,0,0,0,,Sialan.
Dialogue: 0,0:54:19.88,0:54:21.23,Default,,0,0,0,,Aku berani bertaruh kamu memukulnya.
Dialog: 0,0:54:21.25,0:54:23.40,Default,,0,0,0,,Tidak, saya tidak melakukannya!
Dialog: 0,0:54:23.42,0:54:25.48,Default,,0,0,0,,Aku memukulnya.
Dialogue: 0,0:54:25.51,0:54:29.63,Default,,0,0,0,,Aku memukulnya karena marah.
Dialog: 0,0:54:30.10,0:54:33.26,Default,,0,0,0,,- Maaf.\N- Lihat? Anda mendengarnya!
Dialogue: 0,0:54:35.48,0:54:38.12,Default,,0,0,0,,Apa menurutmu aku akan mempercayainya?
Dialog: 0,0:54:38.14,0:54:39.12,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:54:39.15,0:54:42.22,Default,,0,0,0,,Kamu mungkin tidak percaya padaku, tapi kamu percaya padanya.
Dialog: 0,0:54:53.45,0:54:56.15,Default,,0,0,0,,Percayalah padanya!
Dialogue: 0,0:54:59.83,0:55:03.06,Default,,0,0,0,,Reguler tanpa kafein dengan tambahan suntikan. Benar?
Dialog: 0,0:55:03.09,0:55:06.65,Default,,0,0,0,,- Anda tidak lupa.\N- Tentu saja tidak. Anda adalah penyelamat kami.
Dialogue: 0,0:55:06.67,0:55:10.03,Default,,0,0,0,,Kami hanyalah preman 15 tahun yang lalu,
Dialog: 0,0:55:10.05,0:55:11.49,Default,,0,0,0,,tapi kami segera menjadi...
Dialog: 0,0:55:11.51,0:55:13.78,Default,,0,0,0,,profesional urusan rahasia, terima kasih.
Dialog: 0,0:55:13.81,0:55:15.41,Default,,0,0,0,,Kamu benar.
Dialogue: 0,0:55:15.43,0:55:17.16,Default,,0,0,0,,Saya melihat bagaimana kantor Anda berkembang...
Dialog: 0,0:55:17.18,0:55:18.83,Default,,0,0,0,,{\i1}{\c&HFFFF&}Agen Detektif MZ{\c}{\i0}
Dialog: 0,0:55:18.85,0:55:20.20,Default,,0,0,0,,...setiap kali aku bercerai.
Dialog: 0,0:55:20.23,0:55:24.56,Default,,0,0,0,,Kami bukan lagi detektif\Nagency sederhana. Kami berlisensi dan bahkan membayar pajak.
Dialog: 0,0:55:25.11,0:55:26.54,Default,,0,0,0,,Saya tahu.
Dialogue: 0,0:55:26.57,0:55:28.71,Default,,0,0,0,,Tandamu berubah, jadi\NI hampir tidak dapat menemukanmu,
Dialog: 0,0:55:28.74,0:55:30.21,Default,,0,0,0,,jadi apa kabarmu sekarang?
Dialog: 0,0:55:30.24,0:55:33.18,Default,,0,0,0,,Kami adalah PIA yang lolos...
Dialog: 0,0:55:33.20,0:55:35.18,Default,,0,0,0,,tes bersertifikat negara.
Dialog: 0,0:55:35.20,0:55:37.47,Default,,0,0,0,,Kantor investigasi swasta.
Dialog: 0,0:55:37.50,0:55:38.81,Default,,0,0,0,,Lalu aku harus memanggilmu apa?
Dialogue: 0,0:55:38.83,0:55:40.31,Default,,0,0,0,,Bolehkah aku tetap memanggilmu "Tuan Park"?
Dialog: 0,0:55:40.33,0:55:42.62,Default,,0,0,0,,Panggil aku "Conan." Taman Conan.
Dialog: 0,0:55:45.46,0:55:47.16,Default,,0,0,0,,Conan, benar.
Dialogue: 0,0:55:48.88,0:55:51.29,Default,,0,0,0,,Lakukan pemeriksaan latar belakang padanya.
Dialog: 0,0:55:54.26,0:55:56.99,Default,,0,0,0,,Kategori manakah itu?
Dialog: 0,0:55:57.02,0:56:00.62,Default,,0,0,0,,Metode investigasi berbeda\Ntergantung pada apa yang ingin Anda cari.
Dialog: 0,0:56:00.64,0:56:02.22,Default,,0,0,0,,Semuanya.
Dialog: 0,0:56:02.73,0:56:07.14,Default,,0,0,0,,Aku ingin tahu segalanya tentang dia.
Dialogue: 0,0:56:07.65,0:56:10.94,Default,,0,0,0,,{\an8}Aku baru membencinya selama 20 tahun terakhir.
Dialog: 0,0:56:11.24,0:56:14.48,Default,,0,0,0,,Aku akhirnya sadar setelah dia memukulku.
Dialog: 0,0:56:14.53,0:56:16.61,Default,,0,0,0,,Saya perlu tahu...
Dialogue: 0,0:56:16.70,0:56:18.32,Default,,0,0,0,,siapa dia.
Dialog: 0,0:56:20.16,0:56:22.66,Default,,0,0,0,,Sialan.
Dialog: 0,0:56:33.13,0:56:35.39,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:56:36.93,0:56:38.24,Default,,0,0,0,,{\i1}Apakah kamu siap?{\i0}
Dialog: 0,0:56:38.26,0:56:40.49,Default,,0,0,0,,{\i1}Uji tuntas\Ntim Hercyna akan tiba dalam lima menit.{\i0}
Dialog: 0,0:56:40.52,0:56:43.20,Default,,0,0,0,,Ya, orang-orang saya sudah ada di sana.
Dialogue: 0,0:56:43.23,0:56:45.05,Default,,0,0,0,,Aku berangkat sekarang.
Dialog: 0,0:57:56.51,0:57:58.84,Default,,0,0,0,,Aku menunggumu.
Dialog: 0,0:57:59.51,0:58:00.70,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:58:00.72,0:58:02.51,Default,,0,0,0,,Ya, saya baik-baik saja.
Dialogue: 0,0:58:05.35,0:58:07.09,Default,,0,0,0,,Kita terlambat.
Dialog: 0,0:58:08.10,0:58:10.42,Default,,0,0,0,,Maaf, mereka pasti menunggu.
Dialog: 0,0:58:10.44,0:58:13.25,Default,,0,0,0,,Kamu kelihatannya tidak sehat. Apakah kamu ingin istirahat hari ini?
Dialogue: 0,0:58:13.28,0:58:15.75,Default,,0,0,0,,Kita bisa menjadwal ulang.
Dialog: 0,0:58:15.78,0:58:17.73,Default,,0,0,0,,Tidak, tidak perlu.
Dialog: 0,0:58:19.53,0:58:21.07,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:58:22.16,0:58:23.69,Default,,0,0,0,,Oke.
Dialogue: 0,0:58:50.77,0:58:52.17,Default,,0,0,0,,Ada apa?
Dialog: 0,0:58:52.19,0:58:53.93,Default,,0,0,0,,Jangan pedulikan aku.
Dialog: 0,0:59:10.00,0:59:11.70,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:59:12.29,0:59:13.69,Default,,0,0,0,,Wajahmu masih pucat.
Dialog: 0,0:59:13.71,0:59:16.02,Default,,0,0,0,,Jika kamu sakit...
Dialog: 0,0:59:16.05,0:59:17.58,Default,,0,0,0,,Saya tidak,
Dialogue: 0,0:59:17.76,0:59:21.04,Default,,0,0,0,,tapi kuharap begitu, jadi aku bisa beristirahat.
Dialog: 0,0:59:37.24,0:59:43.27,Default,,0,0,0,,Halo semuanya. Terima kasih sudah\Ndatang. Namaku Hong Hae-in.
Dialogue: 0,0:59:47.20,0:59:50.41,Default,,0,0,0,,Apakah Hae-in sudah menjalani pemeriksaan kesehatan?
Dialogue: 0,0:59:50.75,0:59:54.02,Default,,0,0,0,,Sudah lama sejak dia bergabung dengan keluarganya...
Dialogue: 0,0:59:54.04,0:59:56.33,Default,,0,0,0,,dengan pemeriksaan.
Dialogue: 0,0:59:56.63,0:59:58.91,Default,,0,0,0,,Mungkin dia melakukannya di tempat lain.
Dialog: 0,0:59:59.84,1:00:01.94,Default,,0,0,0,,Silakan cari tahu di mana.
Dialog: 0,1:00:01.97,1:00:03.50,Default,,0,0,0,,Oke.
Dialog: 0,1:00:03.64,1:00:08.09,Default,,0,0,0,,Saya pikir Anda harus menunda\Nperjalanan Anda ke Jerman.
Dialog: 0,1:00:08.35,1:00:10.38,Default,,0,0,0,,Mengapa? Untuk apa?
Dialogue: 0,1:00:12.06,1:00:14.08,Default,,0,0,0,,Jumlah sel darah putihmu terlalu rendah.
Dialogue: 0,1:00:14.11,1:00:16.58,Default,,0,0,0,,Mereka perlu mengekstrak dan mengubah selmu...
Dialog: 0,1:00:16.61,1:00:18.54,Default,,0,0,0,,untuk pengobatan sel kekebalan,
Dialog: 0,1:00:18.57,1:00:22.26,Default,,0,0,0,,{\an8}tetapi mereka tidak dapat melakukan itu ketika WBC Anda terlalu rendah.
Dialog: 0,1:00:22.28,1:00:27.53,Default,,0,0,0,,Laboratorium di Jerman itu akan\Nmenolak melakukannya dengan hasil ini.
Dialog: 0,1:00:27.99,1:00:30.60,Default,,0,0,0,,Kalau begitu, apakah kamu menyuruhku menyerah?
Dialogue: 0,1:00:30.62,1:00:32.77,Default,,0,0,0,,Bukan itu maksudku.
Dialog: 0,1:00:32.79,1:00:36.20,Default,,0,0,0,,Anda harus menunggu sampai WBC Anda meningkat...
Dialog: 0,1:00:37.25,1:00:38.95,Default,,0,0,0,,"Tunggu"?
Dialog: 0,1:00:40.26,1:00:42.92,Default,,0,0,0,,Saya tidak punya waktu untuk itu.
Dialog: 0,1:00:45.47,1:00:47.13,Default,,0,0,0,,Tunggu, Ms. Hong.
Dialog: 0,1:00:52.81,1:00:55.76,Default,,0,0,0,,Pak, saya baik-baik saja.
Dialog: 0,1:00:56.02,1:00:57.97,Default,,0,0,0,,Saya hampir tidak merasakan sakit apa pun.
Dialogue: 0,1:00:58.73,1:01:02.09,Default,,0,0,0,,Aku akan menemukan\Ntumor malang ini lebih cepat jika aku kesakitan.
Dialog: 0,1:01:02.11,1:01:04.15,Default,,0,0,0,,Tapi...
Dialog: 0,1:01:15.42,1:01:17.12,Default,,0,0,0,,Saya...
Dialog: 0,1:01:17.63,1:01:20.16,Default,,0,0,0,,Saya datang untuk pemeran ini.
Dialog: 0,1:01:21.38,1:01:23.92,Default,,0,0,0,,Omong-omong...
Dialog: 0,1:01:24.22,1:01:25.43,Default,,0,0,0,,{\i1}{\c&HFFFF&}Departemen Tumor Otak{\c}{\i0}
Dialog: 0,1:01:28.97,1:01:31.17,Default,,0,0,0,,Kenapa kamu ada di sana?
Dialog: 0,1:01:39.27,1:01:40.75,Default,,0,0,0,,Apakah kamu kenal Mi-yeong?
Dialog: 0,1:01:40.78,1:01:42.13,Default,,0,0,0,,Siapa itu?
Dialog: 0,1:01:42.15,1:01:43.42,Default,,0,0,0,,Temanku.
Dialog: 0,1:01:43.44,1:01:45.21,Default,,0,0,0,,Dia juga menderita tumor otak.
Dialog: 0,1:01:45.24,1:01:47.76,Default,,0,0,0,,Itu sekitar lima tahun yang lalu.
Dialog: 0,1:01:47.78,1:01:51.26,Default,,0,0,0,,Dia memanggil teman-temannya dan\Nmenangis di sungai ketika dia mengetahuinya.
Dialogue: 0,1:01:51.29,1:01:52.60,Default,,0,0,0,,Tapi bagaimana dengan dia?
Dialogue: 0,1:01:52.62,1:01:55.18,Default,,0,0,0,,Dia baik-baik saja sekarang. Dia yang\Npaling sehat di antara kita.
Dialogue: 0,1:01:55.21,1:01:57.48,Default,,0,0,0,,Dia bermain golf sepanjang waktu. Dia baik-baik saja.
Dialog: 0,1:01:57.50,1:02:01.31,Default,,0,0,0,,Kita punya uang lebih dari cukup.\NPenyakit yang tidak bisa disembuhkan sudah tidak ada lagi,
Dialog: 0,1:02:01.34,1:02:04.46,Default,,0,0,0,,jadi jangan khawatir tentang apa pun.
Dialog: 0,1:02:04.72,1:02:10.41,Default,,0,0,0,,Bibi, saya tidak khawatir akan menjadi lebih baik.\NI saya hanya khawatir Anda akan memberi tahu orang lain.
Dialog: 0,1:02:10.43,1:02:11.99,Default,,0,0,0,,Tidak ada yang tahu?
Dialogue: 0,1:02:12.01,1:02:14.22,Default,,0,0,0,,Bahkan suamimu pun tidak?
Dialog: 0,1:02:14.31,1:02:16.43,Default,,0,0,0,,Hanya dia yang tahu.
Dialog: 0,1:02:16.69,1:02:19.14,Default,,0,0,0,,Benarkah? Jadi begitu.
Dialog: 0,1:02:20.19,1:02:24.25,Default,,0,0,0,,Hei, tidak masalah asalkan dia\Ntahu. Tidak ada yang serius.
Dialog: 0,1:02:24.28,1:02:26.45,Default,,0,0,0,,Tepat. Ini tidak serius.
Dialog: 0,1:02:26.47,1:02:27.45,Default,,0,0,0,,Bibi.
Dialog: 0,1:02:27.47,1:02:28.47,Default,,0,0,0,,Ya?
Dialogue: 0,1:02:28.49,1:02:29.47,Default,,0,0,0,,Aku berangkat ke Jerman.
Dialog: 0,1:02:29.49,1:02:32.43,Default,,0,0,0,,Laboratorium mereka menemukan pengobatan jenis\Nof baru yang dapat menyembuhkan saya.
Dialog: 0,1:02:32.45,1:02:34.01,Default,,0,0,0,,Itulah sebabnya saya datang ke sini hari ini.
Dialog: 0,1:02:34.04,1:02:36.52,Default,,0,0,0,,Benarkah? Apakah itu benar?
Dialog: 0,1:02:36.54,1:02:39.27,Default,,0,0,0,,Jadi jangan beritahu siapapun.
Dialog: 0,1:02:39.29,1:02:40.94,Default,,0,0,0,,Hei! saya tidak akan melakukannya.
Dialog: 0,1:02:40.96,1:02:43.33,Default,,0,0,0,,Saya tidak ingin menimbulkan keributan.
Dialogue: 0,1:02:44.88,1:02:46.61,Default,,0,0,0,,Aku percaya padamu.
Dialog: 0,1:02:46.63,1:02:48.69,Default,,0,0,0,,Ya, Anda bisa.
Dialog: 0,1:02:48.72,1:02:50.38,Default,,0,0,0,,Apakah kamu tidak berangkat?
Dialog: 0,1:02:50.47,1:02:52.42,Default,,0,0,0,,Saya harus pergi sekarang.
Dialog: 0,1:03:02.57,1:03:03.71,Default,,0,0,0,,Hei.
Dialog: 0,1:03:03.73,1:03:06.60,Default,,0,0,0,,Saya yakin Anda terkejut.
Dialogue: 0,1:03:07.11,1:03:12.73,Default,,0,0,0,,Saya tahu ini bukan masalah serius,\Ntapi saya yakin Anda masih terkejut.
Dialog: 0,1:03:27.55,1:03:28.52,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mi-yeong{\c}{\i0}
Dialog: 0,1:03:30.05,1:03:33.55,Default,,0,0,0,,{\i1}Nomor yang Anda hubungi saat ini tidak tersedia.{\i0}
Dialog: 0,1:03:46.03,1:03:47.63,Default,,0,0,0,,Suk-hui.
Dialogue: 0,1:03:47.65,1:03:49.34,Default,,0,0,0,,Apakah Mi-yeong mengganti nomor teleponnya?
Dialogue: 0,1:03:49.36,1:03:52.17,Default,,0,0,0,,- {\i1}Siapa?{\i0}\N- Mi-yeong. Jang Mi-yeong.
Dialog: 0,1:03:52.20,1:03:54.86,Default,,0,0,0,,{\i1}Apa? Apa kamu tidak dengar?{\i0}
Dialog: 0,1:03:55.49,1:03:58.43,Default,,0,0,0,,{\i1}Benar. Anda berada di penjara.{\i0}
Dialog: 0,1:03:58.45,1:04:00.89,Default,,0,0,0,,Mengapa? Apakah sesuatu terjadi padanya?
Dialog: 0,1:04:00.92,1:04:02.68,Default,,0,0,0,,{\i1}Dia meninggal.{\i0}
Dialog: 0,1:04:02.71,1:04:03.85,Default,,0,0,0,,Dia meninggal?
Dialog: 0,1:04:03.88,1:04:05.23,Default,,0,0,0,,Mengapa?
Dialog: 0,1:04:05.25,1:04:08.66,Default,,0,0,0,,{\i1}Bagaimana menurut Anda? Dia kambuh lagi.{\i0}
Dialog: 0,1:04:09.76,1:04:11.99,Default,,0,0,0,,Mengapa?
Dialog: 0,1:04:12.01,1:04:14.95,Default,,0,0,0,,Saya dengar operasinya berjalan lancar dan dia baik-baik saja.
Dialogue: 0,1:04:14.97,1:04:19.51,Default,,0,0,0,,Saya dengar dia bermain golf sepanjang\Nwaktu, jadi kenapa dia mati?
Dialogue: 0,1:04:19.93,1:04:24.01,Default,,0,0,0,,{\i1}Bagaimana saya tahu? Saya rasa\Nit ini sulit dikalahkan.{\i0}
Dialogue: 0,1:04:25.19,1:04:28.56,Default,,0,0,0,,Kenapa dia mati?
Dialogue: 0,1:04:29.61,1:04:32.09,Default,,0,0,0,,Kenapa dia?
Dialogue: 0,1:04:32.11,1:04:34.68,Default,,0,0,0,,{\i1}Hei, kamu menangis?{\i0}
Dialogue: 0,1:04:34.70,1:04:37.90,Default,,0,0,0,,{\i1}Apakah kalian sedekat itu?{\i0}
Dialogue: 0,1:04:38.83,1:04:42.86,Default,,0,0,0,,Kenapa dia mati?
Dialog: 0,1:04:50.51,1:04:54.28,Default,,0,0,0,,Pada tahun 2014, keluarga kerajaan Monaco\Lelang peninggalan Napoleon mereka...
Dialog: 0,1:04:54.30,1:04:57.75,Default,,0,0,0,,sebelum memperbaiki istana mereka.
Dialogue: 0,1:04:57.97,1:05:02.79,Default,,0,0,0,,{\an8}Ini adalah gaun pedang yang dibeli Ketua\NHong di lelang itu.
Dialog: 0,1:05:02.81,1:05:04.25,Default,,0,0,0,,{\an8}Astaga.
Dialogue: 0,1:05:04.27,1:05:08.14,Default,,0,0,0,,{\an8}Pedang ini bernilai lebih dari $3 juta.
Dialog: 0,1:05:08.82,1:05:11.42,Default,,0,0,0,,Saya pernah melihat pedang serupa di museum di London,
Dialog: 0,1:05:11.44,1:05:13.26,Default,,0,0,0,,tapi tidak di dalam rumah.
Dialog: 0,1:05:13.28,1:05:16.68,Default,,0,0,0,,Napoleon adalah sosok favoritku.
Dialogue: 0,1:05:16.70,1:05:20.01,Default,,0,0,0,,Tidakkah menurutmu itu sebuah\Nkeajaiban bahwa seorang anak desa...
Dialog: 0,1:05:20.04,1:05:21.76,Default,,0,0,0,,dari sebuah pulau di selatan Perancis...
Dialog: 0,1:05:21.79,1:05:24.32,Default,,0,0,0,,menjadi kaisar?
Dialog: 0,1:05:25.83,1:05:29.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sangat miskin dan selalu lapar saat remaja.{\c}{\i0}
Dialogue: 0,1:05:29.50,1:05:33.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saat itulah saya menemukan\NNbiografi Napoleon...{\c}{\i0}
Dialog: 0,1:05:33.17,1:05:34.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dan mulai bermimpi.{\c}{\i0}
Dialog: 0,1:05:34.51,1:05:39.03,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga mengatasi kemiskinan dan mencapai mimpinya.{\c}{\i0}
Dialog: 0,1:05:39.06,1:05:40.78,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anda dapat melakukan hal yang sama.{\c}{\i0}
Dialogue: 0,1:05:40.81,1:05:43.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bermimpilah yang besar jika Anda ingin\Nmenjadi sangat sukses.{\c}{\i0}
Dialogue: 0,1:05:43.39,1:05:45.55,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ayo bantu dia.{\c}{\i0}
Dialog: 0,1:05:53.65,1:05:55.53,Default,,0,0,0,,{\i1}{\c&HFFFF&}Selamat datang Ketua Hong dari Queens Group{\c}{\i0}
Dialogue: 0,1:06:16.97,1:06:19.40,Default,,0,0,0,,Saya punya\Npotret Napoleon karya Jacques-Louis David...
Dialog: 0,1:06:19.43,1:06:21.59,Default,,0,0,0,,di rumahku di New York.
Dialog: 0,1:06:21.81,1:06:25.37,Default,,0,0,0,,Ini adalah lukisan dirinya dalam\Nseragam militernya pada tahun 1813.
Dialog: 0,1:06:25.39,1:06:28.72,Default,,0,0,0,,Jika boleh, saya ingin menghadiahkannya kepada Anda.
Dialogue: 0,1:06:32.07,1:06:33.60,Default,,0,0,0,,Untukku?
Dialog: 0,1:06:34.40,1:06:37.51,Default,,0,0,0,,Saya rasa Anda pantas mendapatkannya.
Dialog: 0,1:06:37.53,1:06:42.44,Default,,0,0,0,,Anda mengalami keajaiban sama seperti dia.
Dialog: 0,1:06:46.16,1:06:48.52,Default,,0,0,0,,Benar, ketika saya pertama kali datang ke Seoul,
Dialog: 0,1:06:48.54,1:06:51.74,Default,,0,0,0,,Saya adalah seorang penyemir sepatu di\Ndepan sebuah department store,
Dialog: 0,1:06:51.92,1:06:54.73,Default,,0,0,0,,tapi sekarang saya pemilik department store itu.
Dialog: 0,1:06:54.76,1:06:56.19,Default,,0,0,0,,Ini keajaiban, bukan?
Dialog: 0,1:06:56.22,1:06:57.92,Default,,0,0,0,,Tentu saja.
Dialog: 0,1:07:02.05,1:07:06.06,Default,,0,0,0,,{\i1}{\c&HFFFF&}Selamat datang Ketua Hong dari Queens Group{\c}{\i0}
Dialogue: 0,1:07:12.23,1:07:15.43,Default,,0,0,0,,Kamu tiba-tiba berangkat ke Jerman sendirian?
Dialogue: 0,1:07:15.90,1:07:18.52,Default,,0,0,0,,Mengapa Hyun-woo tidak datang?
Dialog: 0,1:07:18.65,1:07:19.88,Default,,0,0,0,,Dia sibuk,
Dialog: 0,1:07:19.91,1:07:21.61,Default,,0,0,0,,dan ini bukan apa-apa.
Dialogue: 0,1:07:21.74,1:07:22.76,Default,,0,0,0,,Haruskah aku ikut?
Dialog: 0,1:07:22.78,1:07:25.99,Default,,0,0,0,,Saya hanya perlu paspor saya. Aku akan ikut.
Dialog: 0,1:07:26.16,1:07:27.97,Default,,0,0,0,,- Bibi.\N- Ya?
Dialog: 0,1:07:28.00,1:07:30.24,Default,,0,0,0,,Saya lebih suka pergi sendiri.
Dialogue: 0,1:07:30.96,1:07:32.62,Default,,0,0,0,,Aku akan baik-baik saja.
Dialog: 0,1:08:29.52,1:08:31.05,Default,,0,0,0,,Hyun-woo.
Dialog: 0,1:08:31.85,1:08:34.64,Default,,0,0,0,,Mengapa Hae-in pergi ke Jerman sendirian?
Dialog: 0,1:08:34.98,1:08:36.17,Default,,0,0,0,,Maaf?
Dialogue: 0,1:08:36.19,1:08:38.48,Default,,0,0,0,,Apa kamu tidak tahu dia pergi?
Dialog: 0,1:08:38.98,1:08:41.65,Default,,0,0,0,,Dia bilang hanya kamu yang tahu tentang penyakitnya.
Dialog: 0,1:08:43.95,1:08:45.59,Default,,0,0,0,,Jadi kenapa kamu tidak pergi?
Dialogue: 0,1:08:45.62,1:08:49.68,Default,,0,0,0,,Dia bilang hanya kamu yang harus tahu,\Njadi kenapa dia pergi sendiri?
Dialog: 0,1:08:49.70,1:08:52.49,Default,,0,0,0,,Kenapa kamu membiarkannya pergi sendiri?
Dialog: 0,1:09:09.93,1:09:13.14,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,1:09:31.16,1:09:32.79,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:09:54.56,1:09:56.68,Default,,0,0,0,,Semangat!
Dialog: 0,1:09:58.81,1:10:01.38,Default,,0,0,0,,Saya tahu aliran bagus di Gapyeong.
Dialog: 0,1:10:01.40,1:10:03.62,Default,,0,0,0,,Penginapannya bagus,\Ndengan aktivitas olahraga air,
Dialog: 0,1:10:03.64,1:10:05.71,Default,,0,0,0,,jadi ayo pergi dan mengadakan barbekyu.
Dialog: 0,1:10:05.74,1:10:06.80,Default,,0,0,0,,Kedengarannya bagus.
Dialog: 0,1:10:06.82,1:10:08.91,Default,,0,0,0,,Tunggu. Izinkan saya mengundang semua orang.
Dialogue: 0,1:10:08.93,1:10:09.97,Default,,0,0,0,,Ya, sebaiknya.
Dialog: 0,1:10:09.99,1:10:12.53,Default,,0,0,0,,- Saya akan mengeposkannya di obrolan grup kita.\N- Oke.
Dialog: 0,1:10:14.29,1:10:16.20,Default,,0,0,0,,Seok-jun akan datang.
Dialog: 0,1:10:17.00,1:10:19.48,Default,,0,0,0,,Dae-ho membatalkan rencana golfnya yang akan datang.
Dialogue: 0,1:10:19.50,1:10:22.52,Default,,0,0,0,,Apakah Cheol-seung gila?\NDia ingin membawa istrinya?
Dialog: 0,1:10:22.55,1:10:24.15,Default,,0,0,0,,Bodoh sekali.
Dialog: 0,1:10:24.17,1:10:25.87,Default,,0,0,0,,Diblokir.
Dialog: 0,1:10:28.47,1:10:29.53,Default,,0,0,0,,Apakah kamu mendengarkan?
Dialog: 0,1:10:29.55,1:10:32.42,Default,,0,0,0,,- Tentu saja.\N- Lalu kenapa kamu tidak bersemangat?
Dialog: 0,1:10:32.64,1:10:35.76,Default,,0,0,0,,Tidak, saya bersemangat. Saya tidak sabar.
Dialog: 0,1:10:36.52,1:10:38.58,Default,,0,0,0,,Barbekyu. Oh ya.
Dialog: 0,1:10:38.60,1:10:40.76,Default,,0,0,0,,Olahraga air. Mengerti.
Dialog: 0,1:10:41.32,1:10:43.02,Default,,0,0,0,,Ini tidak benar.
Dialog: 0,1:10:43.48,1:10:46.67,Default,,0,0,0,,Di mana Hyun-woo tua yang biasa\N menenggak tiga cangkir espresso...
Dialog: 0,1:10:46.70,1:10:50.90,Default,,0,0,0,,bergadang semalaman berpesta\Nsaat istrinya pergi ke luar negeri?
Dialog: 0,1:10:51.95,1:10:52.93,Default,,0,0,0,,Saya di sini.
Dialog: 0,1:10:52.95,1:10:55.86,Default,,0,0,0,,Tidak, kamu tidak di sini.
Dialog: 0,1:10:56.12,1:10:57.56,Default,,0,0,0,,Anda berada di Jerman.
Dialog: 0,1:10:57.58,1:10:59.81,Default,,0,0,0,,Mengapa kamu memeriksa cuacanya?
Dialog: 0,1:10:59.83,1:11:02.49,Default,,0,0,0,,Apakah kamu mengkhawatirkan istrimu?
Dialog: 0,1:11:03.05,1:11:04.83,Default,,0,0,0,,Tentu saja tidak.
Dialogue: 0,1:11:05.38,1:11:08.19,Default,,0,0,0,,Apakah kamu berusaha keras untuk berpura-pura menyukainya,
Dialog: 0,1:11:08.22,1:11:10.84,Default,,0,0,0,,bahwa kamu benar-benar jatuh cinta?
Dialog: 0,1:11:11.14,1:11:12.11,Default,,0,0,0,,Tidak.
Dialogue: 0,1:11:12.14,1:11:14.53,Default,,0,0,0,,Aku mencurigaimu sejak\Ninsiden kue kacang.
Dialogue: 0,1:11:14.56,1:11:16.45,Default,,0,0,0,,- Kamu salah.\N- Benar?
Dialog: 0,1:11:16.48,1:11:18.12,Default,,0,0,0,,Tidak, kan?
Dialogue: 0,1:11:18.14,1:11:20.04,Default,,0,0,0,,Ya, bersiaplah.
Dialog: 0,1:11:20.06,1:11:22.17,Default,,0,0,0,,Jangan terlalu terlibat.
Dialog: 0,1:11:22.19,1:11:23.21,Default,,0,0,0,,Oke?
Dialog: 0,1:11:23.23,1:11:25.85,Default,,0,0,0,,Baiklah! Ayo lakukan itu lagi!
Dialog: 0,1:11:28.22,1:11:29.25,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sang Ratu{\c}{\i0}
Dialog: 0,1:11:31.87,1:11:33.48,Default,,0,0,0,,Ya, Sayang.
Dialog: 0,1:11:33.66,1:11:34.97,Default,,0,0,0,,Ini tidak menyenangkan.
Dialog: 0,1:11:34.99,1:11:37.49,Default,,0,0,0,,Ini sama sekali tidak menyenangkan.
Dialog: 0,1:11:38.08,1:11:39.91,Default,,0,0,0,,Tentu saja tidak.
Dialog: 0,1:13:35.61,1:13:37.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Berikut wawancara Anda dengan Nona Hong{\c}{\i0}
Dialog: 0,1:13:41.25,1:13:43.00,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in mengungkapkan...{\c}{\i0}
Dialogue: 0,1:13:46.50,1:13:50.87,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimanapun, dia jadi romantis sejak saat itu.{\c}{\i0}
Dialog: 0,1:13:51.63,1:13:54.62,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Begitulah kisah cinta kami dimulai.{\c}{\i0}
Dialogue: 0,1:13:55.26,1:13:56.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini pertanyaan terakhirku.{\c}{\i0}
Dialog: 0,1:13:56.84,1:13:59.50,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa impianmu?{\c}{\i0}
Dialogue: 0,1:13:59.72,1:14:02.70,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Menurutku penjualannya melebihi\N$1 miliar...{\c}{\i0}
Dialog: 0,1:14:02.72,1:14:04.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}di department store saya.{\c}{\i0}
Dialog: 0,1:14:04.94,1:14:07.46,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sedang mengerjakannya, dan itu akan segera terwujud.{\c}{\i0}
Dialog: 0,1:14:07.48,1:14:09.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Selamat sebelumnya.{\c}{\i0}
Dialogue: 0,1:14:09.06,1:14:10.79,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa impianmu selanjutnya?{\c}{\i0}
Dialogue: 0,1:14:10.82,1:14:15.71,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya kira saya akan mengincar jumlah penjualan yang lebih tinggi.{\c}{\i0}
Dialogue: 0,1:14:15.74,1:14:19.05,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana setelah kamu mencapai semua tujuanmu?{\c}{\i0}
Dialogue: 0,1:14:19.07,1:14:22.24,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku tak pernah berpikir sejauh itu sebelumnya.{\c}{\i0}
Dialog: 0,1:14:25.25,1:14:26.95,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pada saat itu...{\c}{\i0}
Dialog: 0,1:14:28.21,1:14:30.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin istirahat.{\c}{\i0}
Dialog: 0,1:14:32.38,1:14:35.17,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin bepergian dengan suami saya.{\c}{\i0}
Dialogue: 0,1:14:35.59,1:14:39.25,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjalanan pertama dan terakhir kami adalah bulan madu kami.{\c}{\i0}
Dialog: 0,1:14:39.68,1:14:41.74,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin pergi...{\c}{\i0}
Dialog: 0,1:14:41.76,1:14:43.59,Default,,0,0,0,,{\i1}{\c&HFFFF00&}saat berjalan-jalan,{\c}{\i0}
Dialogue: 0,1:14:43.72,1:14:46.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}minum teh, makan, ngobrol,{\c}{\i0}
Dialogue: 0,1:14:46.98,1:14:49.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dan lakukan beberapa hal lagi.{\c}{\i0}
Dialog: 0,1:14:51.48,1:14:53.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagus sekali.{\c}{\i0}
Dialog: 0,1:14:56.20,1:14:59.06,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya harap saya bisa melakukan itu...{\c}{\i0}
Dialog: 0,1:15:00.32,1:15:02.11,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}setiap hari.{\c}{\i0}
Dialog: 0,1:15:08.96,1:15:11.74,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya harap saya bisa melakukan itu...{\c}{\i0}
Dialog: 0,1:15:13.09,1:15:14.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}setiap hari.{\c}{\i0}
Dialogue: 0,1:16:45.01,1:16:47.59,Default,,0,0,0,,Kenapa mereka semua ingin aku menunggu?
Dialogue: 0,1:16:47.97,1:16:50.80,Default,,0,0,0,,Kenapa mereka bicara seolah waktu berpihak padaku?
Dialog: 0,1:16:51.94,1:16:53.59,Default,,0,0,0,,Saya tidak punya waktu.
Dialog: 0,1:16:56.19,1:16:57.89,Default,,0,0,0,,Saya tidak.
Dialog: 0,1:18:17.15,1:18:19.01,Default,,0,0,0,,"Jangan khawatir"?
Dialogue: 0,1:18:19.48,1:18:22.35,Default,,0,0,0,,Saya sudah khawatir\Nberjalan menuruni tangga ini.
Dialogue: 0,1:18:27.95,1:18:30.15,Default,,0,0,0,,Kenapa banyak sekali?
Dialog: 0,1:18:45.72,1:18:47.33,Default,,0,0,0,,Hong Hae-in!
Dialog: 0,1:18:53.22,1:18:54.92,Default,,0,0,0,,Apa itu tadi?
Dialogue: 0,1:18:56.85,1:18:59.55,Default,,0,0,0,,Apakah aku mendengar sesuatu sekarang?
Dialogue: 0,1:19:33.97,1:19:36.63,Default,,0,0,0,,Bukankah aku sudah bilang padamu untuk memakai sepatu yang nyaman?
Dialog: 0,1:19:38.27,1:19:40.43,Default,,0,0,0,,Kamu benar-benar tidak mendengarkan.
Dialog: 0,1:19:53.74,1:19:55.05,Default,,0,0,0,,Bagaimana kamu tahu aku ada di sini?
Dialogue: 0,1:19:55.08,1:19:56.18,Default,,0,0,0,,Ponselmu mati.
Dialog: 0,1:19:56.20,1:19:59.47,Default,,0,0,0,,Mereka bilang kamu meninggalkan\Nrumah sakit setelah ditolak,
Dialogue: 0,1:19:59.50,1:20:02.83,Default,,0,0,0,,tapi Sekretaris Na bilang kamu\Ntidak naik pesawat pulang,
Dialog: 0,1:20:03.67,1:20:05.87,Default,,0,0,0,,jadi aku berpikir panjang dan keras,
Dialog: 0,1:20:07.38,1:20:09.58,Default,,0,0,0,,dan tempat ini terlintas dalam pikiran.
Dialog: 0,1:20:11.22,1:20:13.46,Default,,0,0,0,,Anda menikmati bulan madu kami di sini.
Dialog: 0,1:20:13.64,1:20:15.46,Default,,0,0,0,,Anda menyukai namanya.
Dialog: 0,1:20:20.48,1:20:21.75,Default,,0,0,0,,Saya tidak pernah mengatakan itu.
Dialog: 0,1:20:21.77,1:20:23.55,Default,,0,0,0,,Saya bilang itu bohong.
Dialog: 0,1:20:23.90,1:20:27.18,Default,,0,0,0,,"Tempat tanpa kekhawatiran atau air mata."
Dialog: 0,1:20:27.73,1:20:30.35,Default,,0,0,0,,Mereka hanya berbohong untuk memikat wisatawan.
Dialog: 0,1:20:33.03,1:20:36.28,Default,,0,0,0,,Kaulah yang berbohong.
Dialogue: 0,1:20:36.87,1:20:38.85,Default,,0,0,0,,- Apa yang kulakukan?\N- Apa kamu tidak ingat?
Dialog: 0,1:20:38.87,1:20:41.82,Default,,0,0,0,,Apa yang kamu katakan padaku saat kamu melamar?
Dialog: 0,1:20:42.12,1:20:44.49,Default,,0,0,0,,Kamu berjanji tidak akan membuatku menangis.
Dialog: 0,1:20:44.79,1:20:46.62,Default,,0,0,0,,Kamu menyuruhku untuk mempercayaimu,
Dialog: 0,1:20:46.88,1:20:48.36,Default,,0,0,0,,tapi coba tebak?
Dialog: 0,1:20:48.38,1:20:51.00,Default,,0,0,0,,Saya banyak menangis selama pernikahan kami.
Dialog: 0,1:20:51.30,1:20:53.07,Default,,0,0,0,,Saya menangis saat mengemudi,
Dialog: 0,1:20:53.09,1:20:55.07,Default,,0,0,0,,mencuci muka,
Dialog: 0,1:20:55.10,1:20:57.00,Default,,0,0,0,,dan di tempat cuci mobil.
Dialog: 0,1:20:57.47,1:20:59.97,Default,,0,0,0,,Saya suka tidur terpisah,
Dialog: 0,1:21:00.39,1:21:02.93,Default,,0,0,0,,karena aku bisa menangis sampai tertidur.
Dialog: 0,1:21:06.90,1:21:08.60,Default,,0,0,0,,Dulu...
Dialogue: 0,1:21:09.23,1:21:12.48,Default,,0,0,0,,Aku hanya bilang terserah, supaya aku bisa menikah denganmu.
Dialog: 0,1:21:13.32,1:21:15.31,Default,,0,0,0,,Dan sekarang kita sudah menikah,
Dialog: 0,1:21:17.20,1:21:18.90,Default,,0,0,0,,jadi saya harus...
Dialog: 0,1:21:19.74,1:21:21.90,Default,,0,0,0,,tetap bersamamu...
Dialog: 0,1:21:23.04,1:21:25.03,Default,,0,0,0,,di saat seperti ini.
Dialogue: 0,1:21:35.47,1:21:37.71,Default,,0,0,0,,Pernahkah aku bilang padamu untuk tidak melakukannya?
Dialog: 0,1:21:38.93,1:21:40.84,Default,,0,0,0,,Aku menginginkanmu...
Dialogue: 0,1:21:41.18,1:21:43.34,Default,,0,0,0,,untuk tetap bersamaku.
Dialog: 0,1:21:45.85,1:21:47.97,Default,,0,0,0,,Aku tidak ingin sendirian.
Dialog: 0,1:21:50.03,1:21:52.10,Default,,0,0,0,,Selamanya.
Dialog: 0,1:21:57.41,1:21:59.11,Default,,0,0,0,,Maaf.
Dialogue: 0,1:22:03.79,1:22:05.70,Default,,0,0,0,,Maafkan aku.
Dialog: 0,1:22:23.73,1:22:25.26,Default,,0,0,0,,Ayo pulang.
Dialog: 0,1:22:28.36,1:22:30.77,Default,,0,0,0,,Saya pikir saya akan menemukannya di sini.
Dialog: 0,1:22:31.94,1:22:34.85,Default,,0,0,0,,Cara hidup yang ajaib,
Dialog: 0,1:22:35.57,1:22:38.40,Default,,0,0,0,,atau tempat tanpa kesedihan...
Dialog: 0,1:22:41.87,1:22:43.99,Default,,0,0,0,,Tapi tidak ada.
Dialog: 0,1:22:45.00,1:22:46.78,Default,,0,0,0,,Semua yang kuinginkan...
Dialog: 0,1:22:47.71,1:22:50.87,Default,,0,0,0,,adalah pulang bersamamu.
Dialog: 0,1:24:33.23,1:24:35.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya dengar ini adalah penyelamat Anda.{\c}{\i0}
Dialogue: 0,1:24:35.52,1:24:36.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa punyaku pendek sekali?{\c}{\i0}
Dialog: 0,1:24:36.98,1:24:38.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tersinggung.{\c}{\i0}
Dialog: 0,1:24:47.45,1:24:49.32,Default,,0,0,0,,Apakah ini...
Dialog: 0,1:24:50.12,1:24:51.99,Default,,0,0,0,,pendek?
Dialog: 0,1:24:59.55,1:25:01.25,Default,,0,0,0,,Saya kira...
Dialogue: 0,1:25:02.05,1:25:04.17,Default,,0,0,0,,seperti itulah.
Dialog: 0,1:25:21.82,1:25:23.73,Default,,0,0,0,,Bagaimana kalau sebanyak ini?
Dialogue: 0,1:25:28.58,1:25:31.03,Default,,0,0,0,,Sekitar segini.
Dialog: 0,1:25:57.61,1:26:00.53,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialogue: 0,1:26:28.09,1:26:31.37,Default,,0,0,0,,{\an8}{\i1}Aku benar-benar diberkati dengan suami yang baik.{\i0}
Dialog: 0,1:26:31.39,1:26:34.33,Default,,0,0,0,,{\an8}- {\i1}Bolehkah aku tidur di kamarmu?{\i0}\N- Tidur saja di mana pun kamu mau.
Dialog: 0,1:26:34.35,1:26:37.18,Default,,0,0,0,,{\an8}{\i1}Lakukan sesukamu. Ikuti kata hatimu.{\i0}
Dialog: 0,1:26:37.27,1:26:38.93,Default,,0,0,0,,{\an8}{\i1}Luar biasa.{\i0}
Dialog: 0,1:26:39.23,1:26:41.10,Default,,0,0,0,,{\an8}{\i1}Kenapa kamu harus melakukannya padahal dia sudah begitu kuat?{\i0}
Dialogue: 0,1:26:41.12,1:26:44.13,Default,,0,0,0,,{\an8}{\i1}Berhentilah serakah jika kamu sudah punya\Nit selama itu, brengsek!{\i0}
Dialog: 0,1:26:44.15,1:26:46.48,Default,,0,0,0,,{\an8}{\i1}Yongdu-ri telah menjadi terkenal.{\i0}
Dialogue: 0,1:26:46.82,1:26:49.88,Default,,0,0,0,,{\an8}{\i1}Suatu hubungan pasti\N akan hancur karena sebuah rahasia.{\i0}
Dialogue: 0,1:26:49.91,1:26:51.84,Default,,0,0,0,,{\an8}- {\i1}Aku baru saja melihat seseorang.\N- Hae-in!{\i0}
Dialog: 0,1:26:51.87,1:26:54.53,Default,,0,0,0,,{\an8}{\i1}Saat kamu akan mati...{\i0}
Dialogue: 0,1:26:54.62,1:26:56.52,Default,,0,0,0,,{\an8}{\i1}Mungkin dia datang...{\i0}
Dialog: 0,1:26:56.54,1:26:58.57,Default,,0,0,0,,{\an8}{\i1}karena sudah waktunya.{\i0}
