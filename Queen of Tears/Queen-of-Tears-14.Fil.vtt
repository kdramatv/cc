Dialogue: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialogue: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialogue: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialogue: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialogue: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialogue: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialogue: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialogue: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Screenwriter: Park Ji-eun{\c}{\i0}
Dialogue: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mga Direktor: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialogue: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,0:01:08.40,0:01:11.17,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Tatlong Taon ang Nakaraan{\c}{\i0}
Dialogue: 0,0:01:11.19,0:01:13.79,Default,,0,0,0,,I mean, honeymoon natin ito.
Dialogue: 0,0:01:13.82,0:01:16.92,Default,,0,0,0,,Bakit mo gustong bisitahin ang\Na cemetery, sa lahat ng lugar?
Dialogue: 0,0:01:16.95,0:01:18.94,Default,,0,0,0,,Bagay ka talaga.
Dialogue: 0,0:01:20.03,0:01:23.76,Default,,0,0,0,,Gusto ko kung paano may sementeryo\Nin sa gitna ng park.
Dialogue: 0,0:01:23.79,0:01:27.60,Default,,0,0,0,,Hindi ka inilibing sa isang\Nbundok o nakakalat sa dagat.
Dialogue: 0,0:01:27.62,0:01:29.64,Default,,0,0,0,,Nagpapahinga ka malapit sa iyong tahanan.
Dialogue: 0,0:01:29.67,0:01:32.33,Default,,0,0,0,,Ginagawa nitong parang wala ang kamatayan.
Dialogue: 0,0:01:34.96,0:01:36.58,Default,,0,0,0,,Marahil.
Dialogue: 0,0:01:48.90,0:01:50.33,Default,,0,0,0,,Libingan ba ng asawa niya?
Dialogue: 0,0:01:50.36,0:01:53.31,Default,,0,0,0,,Ano? Anong ibig mong sabihin?
Dialogue: 0,0:01:53.69,0:01:55.13,Default,,0,0,0,,Yung matandang lalaki doon.
Dialogue: 0,0:01:55.15,0:01:57.02,Default,,0,0,0,,Wala akong nakikitang tao.
Dialogue: 0,0:01:58.95,0:02:00.98,Default,,0,0,0,,Nandoon lang siya.
Dialogue: 0,0:02:01.83,0:02:03.86,Default,,0,0,0,,Huwag mo akong takutin ng ganyan.
Dialogue: 0,0:02:03.91,0:02:05.30,Default,,0,0,0,,Alam mo...
Dialogue: 0,0:02:05.33,0:02:07.35,Default,,0,0,0,,yung mga asawang lalaki sa mga pelikula...
Dialogue: 0,0:02:07.37,0:02:11.45,Default,,0,0,0,,na nagdadala ng bulaklak sa kanilang mga yumaong asawa araw-araw.
Dialogue: 0,0:02:11.58,0:02:13.41,Default,,0,0,0,,Mukha siyang isa.
Dialogue: 0,0:02:17.13,0:02:18.75,Default,,0,0,0,,Tandaan ito.
Dialogue: 0,0:02:19.26,0:02:22.59,Default,,0,0,0,,Hindi ako gagawa ng ganyan para sa iyo.
Dialogue: 0,0:02:23.81,0:02:24.78,Default,,0,0,0,,Ayaw mo?
Dialogue: 0,0:02:24.81,0:02:27.20,Default,,0,0,0,,Kung mamatay ka bago ako mamatay,
Dialogue: 0,0:02:27.23,0:02:30.16,Default,,0,0,0,,Mabubuhay pa ako ng isang araw,
Dialogue: 0,0:02:30.19,0:02:32.30,Default,,0,0,0,,at pagkatapos ay sundan ka.
Dialogue: 0,0:02:34.07,0:02:35.04,Default,,0,0,0,,Whatever.
Dialogue: 0,0:02:35.07,0:02:36.59,Default,,0,0,0,,Totoo.
Dialogue: 0,0:02:36.61,0:02:39.31,Default,,0,0,0,,Paano ako mabubuhay kung wala ka?
Dialogue: 0,0:02:39.86,0:02:41.40,Default,,0,0,0,,Whatever.
Dialogue: 0,0:02:41.57,0:02:43.13,Default,,0,0,0,,I mean it.
Dialogue: 0,0:02:43.16,0:02:45.23,Default,,0,0,0,,Tama na.
Dialogue: 0,0:02:45.66,0:02:49.06,Default,,0,0,0,,{\i1}Binibigyan namin ng diin ang aming masasayang sandali,{\i0}
Dialogue: 0,0:02:49.08,0:02:51.64,Default,,0,0,0,,{\i1}pero hindi namin alam...{\i0}
Dialogue: 0,0:02:51.67,0:02:53.91,Default,,0,0,0,,{\i1}kung ano ang hinaharap para sa atin,{\i0}
Dialogue: 0,0:02:54.21,0:02:57.27,Default,,0,0,0,,{\i1}kaya tayo ay nangangako na hindi natin matutupad,{\i0}
Dialogue: 0,0:02:57.30,0:03:00.65,Default,,0,0,0,,{\i1}at tumawa ng tulad ng mga masasayang\Nmga sandaling ito ay tatagal magpakailanman.{\i0}
Dialogue: 0,0:03:00.68,0:03:05.46,Default,,0,0,0,,{\i1}Gayunpaman, may madilim na bahagi\Nsa likod ng mga nagliliwanag na sandali.{\i0}
Dialogue: 0,0:03:05.89,0:03:08.78,Default,,0,0,0,,{\i1}Nang mawala ang mahiwagang sandali,{\i0}
Dialogue: 0,0:03:08.81,0:03:13.05,Default,,0,0,0,,{\i1}at dahil sa hirap ay gusto kong sumuko,{\i0}
Dialogue: 0,0:03:13.31,0:03:15.43,Default,,0,0,0,,{\i1}isang ideya ang pumasok sa isip ko.{\i0}
Dialogue: 0,0:03:16.82,0:03:22.73,Default,,0,0,0,,{\i1}"Oo naman. Marami na akong naranasan na kamalasan,\Npero nasa akin ka pa rin,"{\i0}
Dialogue: 0,0:03:23.24,0:03:25.73,Default,,0,0,0,,{\i1}at nakatulong iyon sa akin na makatiis.{\i0}
Dialogue: 0,0:03:38.88,0:03:40.58,Default,,0,0,0,,{\i1}Gayunpaman,{\i0}
Dialogue: 0,0:03:40.72,0:03:44.79,Default,,0,0,0,,{\i1}Kailangan kong gumawa ng brutal na desisyon.{\i0}
Dialogue: 0,0:03:50.68,0:03:52.22,Default,,0,0,0,,Kaya...
Dialogue: 0,0:03:53.44,0:03:55.22,Default,,0,0,0,,sinasabi mo sa akin...
Dialogue: 0,0:03:56.65,0:03:58.68,Default,,0,0,0,,upang gumawa ng desisyon?
Dialogue: 0,0:03:59.44,0:04:01.21,Default,,0,0,0,,Mawawala ang memorya ko kapag nakuha ko ito,
Dialogue: 0,0:04:01.24,0:04:03.31,Default,,0,0,0,,at mamatay kung hindi.
Dialogue: 0,0:04:03.49,0:04:06.36,Default,,0,0,0,,Sinasabi mo bang piliin ko ang hindi gaanong kasamaan?
Dialogue: 0,0:04:08.37,0:04:10.86,Default,,0,0,0,,- Hindi.\N- Ano?
Dialogue: 0,0:04:13.37,0:04:14.91,Default,,0,0,0,,Kalimutan mo na ito.
Dialogue: 0,0:04:15.00,0:04:16.83,Default,,0,0,0,,Magpapanggap ako...
Dialogue: 0,0:04:17.96,0:04:20.00,Default,,0,0,0,,magandang panaginip ang lahat ng ito.
Dialogue: 0,0:04:34.81,0:04:37.39,Default,,0,0,0,,Bitawan mo ako. Sabi ko, hayaan mo na.
Dialogue: 0,0:04:38.52,0:04:40.14,Default,,0,0,0,,Huwag pumili.
Dialogue: 0,0:04:40.36,0:04:42.27,Default,,0,0,0,,Huwag isipin.
Dialogue: 0,0:04:43.15,0:04:44.81,Default,,0,0,0,,Makinig ka lang sa akin.
Dialogue: 0,0:04:45.45,0:04:48.69,Default,,0,0,0,,Live lang.
Dialogue: 0,0:04:50.95,0:04:52.61,Default,,0,0,0,,Gawin mo yan.
Dialogue: 0,0:04:53.87,0:04:55.74,Default,,0,0,0,,Pakiusap...
Dialogue: 0,0:04:56.08,0:04:57.83,Default,,0,0,0,,live.
Dialogue: 0,0:04:58.79,0:05:00.33,Default,,0,0,0,,Okay?
Dialogue: 0,0:05:04.59,0:05:06.13,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:05:07.14,0:05:08.92,Default,,0,0,0,,Mangyaring mabuhay.
Dialogue: 0,0:05:11.35,0:05:14.97,Default,,0,0,0,,{\i1}Sa sandaling iyon, wala kaming ideya...{\i0}
Dialogue: 0,0:05:17.31,0:05:20.93,Default,,0,0,0,,{\i1}kung ano ang naghihintay sa amin sa kabilang panig.{\i0}
Dialogue: 0,0:05:23.86,0:05:25.11,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 14{\c}{\i0}
Dialogue: 0,0:05:45.13,0:05:46.94,Default,,0,0,0,,{\an8}- Saan ka pupunta?\N- Para makita si Hae-in.
Dialogue: 0,0:05:46.97,0:05:49.28,Default,,0,0,0,,{\an8}- Nasa Germany siya para sa operasyon.\N- Kaya naman.
Dialogue: 0,0:05:49.30,0:05:52.92,Default,,0,0,0,,{\an8}Kasama niya si Hyun-woo, bakit ka pupunta?
Dialogue: 0,0:05:54.18,0:05:55.58,Default,,0,0,0,,Mayroon akong sariling mga tungkulin na dapat gampanan.
Dialogue: 0,0:05:55.60,0:05:58.58,Default,,0,0,0,,Narito ang iyong mga tungkulin at kung ano ang dapat mong protektahan.
Dialogue: 0,0:05:58.60,0:06:02.01,Default,,0,0,0,,Bakit ka nahuhumaling sa isang babaeng namamatay?
Dialogue: 0,0:06:02.65,0:06:04.35,Default,,0,0,0,,Hindi siya namamatay.
Dialogue: 0,0:06:04.40,0:06:07.46,Default,,0,0,0,,Ililigtas siya ng operasyon, at\Nkakalimutan niya ang lahat ng masasamang alaala.
Dialogue: 0,0:06:07.49,0:06:08.76,Default,,0,0,0,,Magsisimula siyang muli.
Dialogue: 0,0:06:08.78,0:06:10.84,Default,,0,0,0,,Sa tingin mo ba bibigyan ka niya ng pagkakataon?
Dialogue: 0,0:06:10.87,0:06:12.40,Default,,0,0,0,,Hindi ka sumasang-ayon?
Dialogue: 0,0:06:17.75,0:06:20.56,Default,,0,0,0,,Si Beom-seok ay naghahanda na sa pwesto mo.
Dialogue: 0,0:06:20.58,0:06:23.60,Default,,0,0,0,,Nakilala ni Beom-jun ang mga direktor\Nna pabor sa kanya mula nang bumalik.
Dialogue: 0,0:06:23.63,0:06:25.19,Default,,0,0,0,,Malapit na ang pagpupulong ng mga stockholder.
Dialogue: 0,0:06:25.21,0:06:28.15,Default,,0,0,0,,Sisirain mo lahat ng ito para lang kay Hae-in?
Dialogue: 0,0:06:28.17,0:06:30.42,Default,,0,0,0,,Anong problema mo?
Dialogue: 0,0:06:32.22,0:06:34.34,Default,,0,0,0,,Hindi mo dapat ako iniwan.
Dialogue: 0,0:06:35.06,0:06:37.55,Default,,0,0,0,,Lahat ng ito ay dahil iniwan mo ako.
Dialogue: 0,0:06:38.14,0:06:41.71,Default,,0,0,0,,Hindi sana ako ma-curious\Natungkol sa kung gaano kahusay ang pamilyang ito,
Dialogue: 0,0:06:41.73,0:06:43.83,Default,,0,0,0,,para iwanan mo ang sarili mong anak...
Dialogue: 0,0:06:43.86,0:06:46.81,Default,,0,0,0,,o naiinggit kay Hae-in at sa huli...
Dialogue: 0,0:06:47.90,0:06:49.60,Default,,0,0,0,,inlove sa kanya.
Dialogue: 0,0:06:50.36,0:06:52.61,Default,,0,0,0,,Ano ang kakailanganin para huminto ka?
Dialogue: 0,0:06:59.00,0:07:00.70,Default,,0,0,0,,Hindi ko mapigilan.
Dialogue: 0,0:07:02.67,0:07:04.54,Default,,0,0,0,,Hindi hanggang mamatay ako.
Dialogue: 0,0:07:12.30,0:07:14.00,Default,,0,0,0,,Fine.
Dialogue: 0,0:07:15.93,0:07:18.13,Default,,0,0,0,,Kung gayon, hayaan mo akong tulungan ka.
Dialogue: 0,0:07:30.36,0:07:32.44,Default,,0,0,0,,Pupunta ka ba sa Frankfurt?
Dialogue: 0,0:07:32.86,0:07:34.61,Default,,0,0,0,,Oo.
Dialogue: 0,0:07:39.50,0:07:42.53,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Katawan Natagpuan Malapit sa Sambang\NReservoir Kinilala bilang Mr. Pyeon{\c}{\i0}
Dialogue: 0,0:09:08.13,0:09:10.08,Default,,0,0,0,,Paano mo ako nahanap?
Dialogue: 0,0:09:10.25,0:09:12.94,Default,,0,0,0,,Lumalabas ka tuwing umaga, kaya sinundan kita.
Dialogue: 0,0:09:12.96,0:09:16.25,Default,,0,0,0,,At least nagsusumikap ka.
Dialogue: 0,0:09:16.30,0:09:17.99,Default,,0,0,0,,Para saan?
Dialogue: 0,0:09:18.01,0:09:21.80,Default,,0,0,0,,Kailangan mong manalangin ng marami kung gusto mong pumunta sa langit.
Dialogue: 0,0:09:22.22,0:09:25.47,Default,,0,0,0,,Sa ganoong paraan, magkikita pa nga tayo...
Dialogue: 0,0:09:25.85,0:09:27.00,Default,,0,0,0,,sa kabilang buhay.
Dialogue: 0,0:09:27.02,0:09:30.18,Default,,0,0,0,,Ibinigay ba na mapupunta ka sa langit?
Dialogue: 0,0:09:30.23,0:09:32.39,Default,,0,0,0,,Hindi ba obvious?
Dialogue: 0,0:09:34.90,0:09:37.73,Default,,0,0,0,,Hindi ako nagdadasal kaya mapunta ako sa langit.
Dialogue: 0,0:09:39.45,0:09:40.93,Default,,0,0,0,,Kung gayon?
Dialogue: 0,0:09:40.95,0:09:43.86,Default,,0,0,0,,Nanalangin ako na maoperahan ka.
Dialogue: 0,0:09:44.16,0:09:47.70,Default,,0,0,0,,Sinabi ko sa Diyos na hindi ko hihilingin\Nna tandaan mo ang lahat.
Dialogue: 0,0:09:49.88,0:09:52.08,Default,,0,0,0,,Nagdasal lang ako na sana mabuhay ka.
Dialogue: 0,0:10:00.05,0:10:01.96,Default,,0,0,0,,Napakawalang kwentang panalangin.
Dialogue: 0,0:10:02.22,0:10:03.88,Default,,0,0,0,,Tara na.
Dialogue: 0,0:10:11.15,0:10:13.22,Default,,0,0,0,,Dapat ba tayong sumulat din ng isa?
Dialogue: 0,0:10:15.74,0:10:18.01,Default,,0,0,0,,Magsusulat ka ng walang kwentang bagay.
Dialogue: 0,0:10:18.03,0:10:19.56,Default,,0,0,0,,Tara na.
Dialogue: 0,0:10:33.17,0:10:35.83,Default,,0,0,0,,Binigyan kita ng sapat na oras para mag-isip.
Dialogue: 0,0:10:35.96,0:10:37.82,Default,,0,0,0,,Hindi na namin ito maibabalik.
Dialogue: 0,0:10:37.84,0:10:40.15,Default,,0,0,0,,Nag-book ako ng appointment,\Nkaya tara na pagkatapos ng almusal.
Dialogue: 0,0:10:40.18,0:10:41.88,Default,,0,0,0,,Kailangan nating pumunta sa isang lugar.
Dialogue: 0,0:10:43.60,0:10:45.34,Default,,0,0,0,,Saan?
Dialogue: 0,0:11:02.78,0:11:04.64,Default,,0,0,0,,Kilalanin ang lugar na ito?
Dialogue: 0,0:11:04.66,0:11:06.80,Default,,0,0,0,,Dumating kami sa aming honeymoon.
Dialogue: 0,0:11:06.83,0:11:08.06,Default,,0,0,0,,Ginawa namin.
Dialogue: 0,0:11:08.08,0:11:10.47,Default,,0,0,0,,Sabi mo maganda ito at kumuha ng maraming larawan.
Dialogue: 0,0:11:10.50,0:11:12.18,Default,,0,0,0,,May malapit ding pub.
Dialogue: 0,0:11:12.21,0:11:14.91,Default,,0,0,0,,Nakainom kami ng beer at nagtalo.
Dialogue: 0,0:11:15.00,0:11:18.65,Default,,0,0,0,,Ginawa namin. Sinabi mo na ako ay\Hindi masyadong cute kapag ako ay nalasing,
Dialogue: 0,0:11:18.67,0:11:20.83,Default,,0,0,0,,at sinabihan akong huwag mag-cute.
Dialogue: 0,0:11:21.26,0:11:22.74,Default,,0,0,0,,Hindi.
Dialogue: 0,0:11:22.76,0:11:24.53,Default,,0,0,0,,Tanda-tanda ko.
Dialogue: 0,0:11:24.55,0:11:27.96,Default,,0,0,0,,Sabi ko magpa-cute ka lang sa harap ko,
Dialogue: 0,0:11:28.35,0:11:30.54,Default,,0,0,0,,pero lahat ng babae ay nakatingin sa iyo.
Dialogue: 0,0:11:30.56,0:11:34.35,Default,,0,0,0,,Hindi ko alam yun. Bakit?\Nkasi ang mga mata ko ay sayo lang.
Dialogue: 0,0:11:36.36,0:11:38.06,Default,,0,0,0,,Talaga?
Dialogue: 0,0:11:38.32,0:11:41.39,Default,,0,0,0,,Sinabi mo noon, at hindi na ako nagalit.
Dialogue: 0,0:11:41.70,0:11:43.23,Default,,0,0,0,,Hindi kaagad.
Dialogue: 0,0:11:43.82,0:11:45.55,Default,,0,0,0,,Nagtampo ka ng halos dalawang oras.
Dialogue: 0,0:11:45.57,0:11:47.36,Default,,0,0,0,,Anyway...
Dialogue: 0,0:11:47.91,0:11:51.49,Default,,0,0,0,,Nadaanan namin ang lugar na ito sa\Nour na pabalik sa hotel,
Dialogue: 0,0:11:52.16,0:11:55.62,Default,,0,0,0,,at nakakita ng magandang full moon.
Dialogue: 0,0:11:56.46,0:12:00.65,Default,,0,0,0,,Tama ka. Ito ay malaki at napakarilag.
Dialogue: 0,0:12:00.67,0:12:02.65,Default,,0,0,0,,Nasa akin pa ang litrato.
Dialogue: 0,0:12:02.68,0:12:05.17,Default,,0,0,0,,Naaalala ko pa ang amoy,
Dialogue: 0,0:12:05.59,0:12:07.84,Default,,0,0,0,,ang buwan, at ang hangin...
Dialogue: 0,0:12:09.06,0:12:10.59,Default,,0,0,0,,ng araw na iyon.
Dialogue: 0,0:12:11.89,0:12:14.18,Default,,0,0,0,,Ganyan ang mga alaala.
Dialogue: 0,0:12:14.85,0:12:16.33,Default,,0,0,0,,Ang ibig sabihin ng pagiging buhay...
Dialogue: 0,0:12:16.36,0:12:19.29,Default,,0,0,0,,Pinaalagaan ko ang mga alaalang iyon\Nang kumukuha ng lakas mula sa kanila,
Dialogue: 0,0:12:19.32,0:12:22.06,Default,,0,0,0,,so those memories define me...
Dialogue: 0,0:12:22.24,0:12:23.85,Default,,0,0,0,,at ang buhay ko,
Dialogue: 0,0:12:24.57,0:12:27.11,Default,,0,0,0,,at mawawala sila sa akin.
Dialogue: 0,0:12:28.08,0:12:32.36,Default,,0,0,0,,Ang lugar na ito ay magiging\Nan ordinaryong field para sa akin,
Dialogue: 0,0:12:32.46,0:12:34.24,Default,,0,0,0,,at ikaw...
Dialogue: 0,0:12:38.09,0:12:40.37,Default,,0,0,0,,ay magiging estranghero.
Dialogue: 0,0:12:41.80,0:12:43.75,Default,,0,0,0,,Hindi na ako magiging sarili ko.
Dialogue: 0,0:12:45.93,0:12:49.63,Default,,0,0,0,,Kaya hindi ako nagpapaopera.
Dialogue: 0,0:12:49.76,0:12:52.05,Default,,0,0,0,,Namuhay ako bilang aking sarili,
Dialogue: 0,0:12:53.35,0:12:55.18,Default,,0,0,0,,at mamamatay ako nang ganoon.
Dialogue: 0,0:13:33.39,0:13:36.79,Default,,0,0,0,,Gosh, Beom-ja. Baliw ka ba?
Dialogue: 0,0:13:36.81,0:13:38.55,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:13:40.81,0:13:42.88,Default,,0,0,0,,Saan ka pupunta? Bumalik sa Yongdu-ri?
Dialogue: 0,0:13:42.90,0:13:46.02,Default,,0,0,0,,Snap out of it. Umuwi ka na.
Dialogue: 0,0:13:53.08,0:13:56.66,Default,,0,0,0,,Uy, mali ito.
Dialogue: 0,0:13:56.75,0:13:59.07,Default,,0,0,0,,Mamili na lang tayo.
Dialogue: 0,0:13:59.21,0:14:00.58,Default,,0,0,0,,Punta tayo sa isang department store.
Dialogue: 0,0:14:01.92,0:14:03.48,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- Nakikinig ako.{\c}{\i0}\N- Yongdu-ri.
Dialogue: 0,0:14:03.50,0:14:05.07,Default,,0,0,0,,Nabaliw na ako.
Dialogue: 0,0:14:05.09,0:14:06.36,Default,,0,0,0,,Bumalik talaga ako.
Dialogue: 0,0:14:06.38,0:14:07.53,Default,,0,0,0,,Ito ba ang iyong tahanan?
Dialogue: 0,0:14:07.55,0:14:11.34,Default,,0,0,0,,Dapat naputol ko ang mga gulong ko.
Dialogue: 0,0:14:14.72,0:14:16.59,Default,,0,0,0,,Sus, tanga mo!
Dialogue: 0,0:14:17.39,0:14:19.93,Default,,0,0,0,,- Ginulat mo ako!\N- Anong ginagawa mo dito?
Dialogue: 0,0:14:20.44,0:14:21.97,Default,,0,0,0,,Alam ko...
Dialogue: 0,0:14:22.82,0:14:25.04,Default,,0,0,0,,gusto mo ng walnut cake.
Dialogue: 0,0:14:25.07,0:14:26.63,Default,,0,0,0,,- Ako ba?\N- Oo.
Dialogue: 0,0:14:26.65,0:14:29.13,Default,,0,0,0,,Nagdala ako ng para sa iyo.
Dialogue: 0,0:14:29.15,0:14:30.30,Default,,0,0,0,,Pero bakit ka nandito?
Dialogue: 0,0:14:30.32,0:14:31.47,Default,,0,0,0,,Ito ang tahanan ni Yeong-song.
Dialogue: 0,0:14:31.49,0:14:33.40,Default,,0,0,0,,Talaga?
Dialogue: 0,0:14:33.53,0:14:35.69,Default,,0,0,0,,Maling address ang nakuha ko.
Dialogue: 0,0:14:36.04,0:14:37.93,Default,,0,0,0,,Beom-ja.
Dialogue: 0,0:14:37.96,0:14:39.91,Default,,0,0,0,,Ano...?
Dialogue: 0,0:14:46.67,0:14:48.78,Default,,0,0,0,,- Bakit...?\N- Pumunta siya sa akin.
Dialogue: 0,0:14:48.80,0:14:51.29,Default,,0,0,0,,Nagtatampo siya sa akin.
Dialogue: 0,0:14:52.14,0:14:54.70,Default,,0,0,0,,Gusto mo bang uminom ng tsaa?
Dialogue: 0,0:14:54.72,0:14:56.70,Default,,0,0,0,,Mayroon kaming masarap na plum tea.
Dialogue: 0,0:14:56.72,0:14:58.38,Default,,0,0,0,,- Dapat ba...?\N- Okay lang.
Dialogue: 0,0:14:58.64,0:15:01.79,Default,,0,0,0,,Pumunta siya sa akin. Nagkamali siya ng address.
Dialogue: 0,0:15:01.81,0:15:05.31,Default,,0,0,0,,Magkita-kita tayo. Tara na. Malamig.
Dialogue: 0,0:15:05.61,0:15:08.30,Default,,0,0,0,,- Sige.\N- Still.
Dialogue: 0,0:15:08.32,0:15:11.86,Default,,0,0,0,,Kumain ka ng tsaa, kahit na hindi ka pumunta dito para sa akin.
Dialogue: 0,0:15:21.33,0:15:23.81,Default,,0,0,0,,Magkaroon din ng ilang madeleines. Niluto ko lang sila.
Dialogue: 0,0:15:23.83,0:15:25.83,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:15:26.00,0:15:27.86,Default,,0,0,0,,Yeong-song.
Dialogue: 0,0:15:27.88,0:15:30.53,Default,,0,0,0,,Napaka-moderno ng pananaw mo sa buhay.
Dialogue: 0,0:15:30.55,0:15:33.45,Default,,0,0,0,,Nagtatrabaho ka lang sa bare minimum?
Dialogue: 0,0:15:33.47,0:15:36.03,Default,,0,0,0,,Hindi namin kailangan ng maraming upang mabuhay tulad ng iniisip namin.
Dialogue: 0,0:15:36.06,0:15:39.30,Default,,0,0,0,,- Ano pa ang gagawin mo?\N- Nagbabasa ako at nakikinig ng musika.
Dialogue: 0,0:15:40.48,0:15:41.45,Default,,0,0,0,,Palagay ko nahanap ko na.
Dialogue: 0,0:15:41.48,0:15:43.62,Default,,0,0,0,,Palagi akong pinipigilan at gusto kong tumakas...
Dialogue: 0,0:15:43.65,0:15:45.21,Default,,0,0,0,,noong nakatira ako sa Seoul.
Dialogue: 0,0:15:45.23,0:15:47.50,Default,,0,0,0,,Mananatili ako rito kasama sina Da-hye at Geon-u.
Dialogue: 0,0:15:47.52,0:15:49.13,Default,,0,0,0,,Magtatrabaho ako ng kaunti...
Dialogue: 0,0:15:49.15,0:15:50.92,Default,,0,0,0,,- at maging napakasaya.\N- Ikaw?
Dialogue: 0,0:15:50.95,0:15:53.13,Default,,0,0,0,,- As if.\N- Mahihirapan ka.
Dialogue: 0,0:15:53.16,0:15:55.76,Default,,0,0,0,,Sobrang materialistic niya, hindi katulad ko.
Dialogue: 0,0:15:55.78,0:15:58.41,Default,,0,0,0,,Hoy, hindi ako.
Dialogue: 0,0:15:58.44,0:15:59.43,Default,,0,0,0,,Mali ka.
Dialogue: 0,0:15:59.45,0:16:01.85,Default,,0,0,0,,Mga handbag lang ang dala niya\N nagkakahalaga ng sampu-sampung libo.
Dialogue: 0,0:16:01.87,0:16:03.98,Default,,0,0,0,,Ang halaga ng isang singsing ay pareho sa isang buong apartment.
Dialogue: 0,0:16:04.00,0:16:05.10,Default,,0,0,0,,Mayroon bang ganitong mga singsing?
Dialogue: 0,0:16:05.13,0:16:07.35,Default,,0,0,0,,At hindi lang iyon.
Dialogue: 0,0:16:07.38,0:16:09.11,Default,,0,0,0,,Magkano ulit ang relo na iyon?
Dialogue: 0,0:16:09.13,0:16:11.00,Default,,0,0,0,,- $200,000?\N- Hoy!
Dialogue: 0,0:16:14.18,0:16:16.53,Default,,0,0,0,,Nag-enjoy din ako dito.
Dialogue: 0,0:16:16.55,0:16:18.74,Default,,0,0,0,,Gusto kong magkaroon ng homemade plum tea,
Dialogue: 0,0:16:18.76,0:16:22.66,Default,,0,0,0,,madeleines, at pagbabasa at pakikinig\Nsa musika nang walang pag-aalala sa mundo.
Dialogue: 0,0:16:27.52,0:16:29.72,Default,,0,0,0,,Oo, ano ito?
Dialogue: 0,0:16:31.24,0:16:33.06,Default,,0,0,0,,Sige. Bye.
Dialogue: 0,0:16:34.36,0:16:35.38,Default,,0,0,0,,Nandito sina Mama at Papa.
Dialogue: 0,0:16:35.41,0:16:37.88,Default,,0,0,0,,Bakit sila patuloy na dumarating?\NDa-hye ay hindi komportable.
Dialogue: 0,0:16:37.91,0:16:39.18,Default,,0,0,0,,Tatawagan kita mamaya.
Dialogue: 0,0:16:39.20,0:16:41.35,Default,,0,0,0,,- Okay.\N- Tara na, Tita Beom-ja!
Dialogue: 0,0:16:41.37,0:16:43.82,Default,,0,0,0,,- Dapat na akong umalis.\N- Okay.
Dialogue: 0,0:16:46.46,0:16:47.99,Default,,0,0,0,,Halika muli.
Dialogue: 0,0:17:08.65,0:17:12.06,Default,,0,0,0,,Halika muli. Magluluto pa ako ng madeleines.
Dialogue: 0,0:17:51.65,0:17:54.14,Default,,0,0,0,,Gusto kong bumalik sa hotel.
Dialogue: 0,0:17:55.28,0:17:57.69,Default,,0,0,0,,Naghihintay ang professor.
Dialogue: 0,0:17:58.61,0:18:01.23,Default,,0,0,0,,Kausapin mo man lang siya.
Dialogue: 0,0:18:02.53,0:18:05.03,Default,,0,0,0,,Naghihintay din ang mga magulang mo.
Dialogue: 0,0:18:06.54,0:18:09.20,Default,,0,0,0,,Gusto nilang mag-video call.
Dialogue: 0,0:18:17.22,0:18:20.86,Default,,0,0,0,,- Nasaan si Da-hye?\N- Lumabas siya kasama si Geon-u para mamasyal.
Dialogue: 0,0:18:20.89,0:18:21.99,Default,,0,0,0,,Malamig sa labas.
Dialogue: 0,0:18:22.01,0:18:24.20,Default,,0,0,0,,Sa tingin ko hindi siya komportable na makita ang aking mga magulang.
Dialogue: 0,0:18:24.22,0:18:26.76,Default,,0,0,0,,Hoy, hindi mo ba kami babatiin?
Dialogue: 0,0:18:28.94,0:18:30.79,Default,,0,0,0,,Tungkol saan ito?
Dialogue: 0,0:18:30.81,0:18:32.79,Default,,0,0,0,,Tumanggi si Hae-in na magpaopera.
Dialogue: 0,0:18:32.82,0:18:34.52,Default,,0,0,0,,Ano?
Dialogue: 0,0:18:34.61,0:18:36.27,Default,,0,0,0,,Tumanggi siya?
Dialogue: 0,0:18:38.07,0:18:40.47,Default,,0,0,0,,Paano kung hatakin natin ang puso niya?
Dialogue: 0,0:18:40.49,0:18:41.97,Default,,0,0,0,,- Her heartstrings?\N- Magmakaawa tayo.
Dialogue: 0,0:18:41.99,0:18:44.94,Default,,0,0,0,,"Kung mamatay ka, mamamatay ako."
Dialogue: 0,0:18:45.95,0:18:49.27,Default,,0,0,0,,Hindi mo siya lubos na kilala.\NSSasabihin niya, "Gawin mo ang gusto mo."
Dialogue: 0,0:18:49.29,0:18:50.77,Default,,0,0,0,,Hindi pwede.
Dialogue: 0,0:18:50.79,0:18:54.27,Default,,0,0,0,,Malalaman niyang nambobola kami.\NTang pagbabanta sa kanya ay hindi uubra.
Dialogue: 0,0:18:54.29,0:18:57.71,Default,,0,0,0,,She's smart since she took after me.
Dialogue: 0,0:18:57.76,0:19:00.39,Default,,0,0,0,,Kung gayon, paano kung gagawa tayo ng lohikal na diskarte?
Dialogue: 0,0:19:00.41,0:19:01.40,Default,,0,0,0,,Paano?
Dialogue: 0,0:19:01.43,0:19:06.62,Default,,0,0,0,,May mga pagkakataon na ang pag-aani ng peras\Nay nagiging mahirap dahil sa matinding blight,
Dialogue: 0,0:19:06.64,0:19:08.49,Default,,0,0,0,,kahit gumamit tayo ng mamahaling pestisidyo,
Dialogue: 0,0:19:08.52,0:19:11.45,Default,,0,0,0,,ngunit ang kanilang mga ugat ay mabubulok kung\Nhindi natin sila i-spray.
Dialogue: 0,0:19:11.48,0:19:13.46,Default,,0,0,0,,- Nasa sangang-daan ka.\N- Eksakto.
Dialogue: 0,0:19:13.48,0:19:16.75,Default,,0,0,0,,Kahit na inaasahan namin ang isang malaking kawalan,\Npinili naming i-spray pa rin ang mga ito,
Dialogue: 0,0:19:16.78,0:19:19.55,Default,,0,0,0,,dahil kailangan nating i-save ang mga ugat...
Dialogue: 0,0:19:19.57,0:19:20.88,Default,,0,0,0,,para sa paparating na taon.
Dialogue: 0,0:19:21.89,0:19:25.94,Default,,0,0,0,,Kaya pinili mong iligtas sila, sa kabila ng\Npagdurusa ng pagkawala. gusto ko yan.
Dialogue: 0,0:19:26.08,0:19:28.10,Default,,0,0,0,,Pagkatapos ay gawin natin ito.
Dialogue: 0,0:19:28.12,0:19:29.81,Default,,0,0,0,,Susubukan muna nating maging lohikal.
Dialogue: 0,0:19:29.83,0:19:33.31,Default,,0,0,0,,Kung mabigo tayo, aakyat ka at papagalitan mo siya.
Dialogue: 0,0:19:33.33,0:19:35.56,Default,,0,0,0,,"Alagaan ang katawan na ibinigay sa iyo ng iyong mga magulang."
Dialogue: 0,0:19:35.59,0:19:38.33,Default,,0,0,0,,"Maaaring hindi pa kita pinanganak,\Npero ama mo pa rin ako."
Dialogue: 0,0:19:38.35,0:19:41.40,Default,,0,0,0,,Tapos suportahan mo siya, na nagsasabing\N"Let's just all die together,"
Dialogue: 0,0:19:41.43,0:19:44.63,Default,,0,0,0,,at pagkatapos... Okay.
Dialogue: 0,0:19:49.10,0:19:51.76,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- Hae-in.{\c}{\i0}\N- Oo, Inay.
Dialogue: 0,0:19:53.56,0:19:54.54,Default,,0,0,0,,Ma'am, ang kwentong peras.
Dialogue: 0,0:19:54.56,0:19:56.85,Default,,0,0,0,,Ang mga peras. Mga pestisidyo.
Dialogue: 0,0:20:00.65,0:20:01.71,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:20:01.74,0:20:05.34,Default,,0,0,0,,May runny nose ako. Maaari kang pumunta.
Dialogue: 0,0:20:05.37,0:20:06.72,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pagkatapos, ako na ang papalit.{\c}{\i0}
Dialogue: 0,0:20:06.74,0:20:08.68,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in, dapat...{\c}{\i0}
Dialogue: 0,0:20:08.70,0:20:10.10,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}pag-isipang mabuti.{\c}{\i0}
Dialogue: 0,0:20:10.12,0:20:11.76,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mapapakinabangan ka nito.{\c}{\i0}
Dialogue: 0,0:20:11.79,0:20:15.98,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mawawala ang iyong magagandang alaala,\Npero ang mga masasama rin.{\c}{\i0}
Dialogue: 0,0:20:16.00,0:20:17.15,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bakit sa tingin mo ako umiinom?{\c}{\i0}
Dialogue: 0,0:20:17.17,0:20:20.90,Default,,0,0,0,,Nilunod ko ang sarili ko sa alak para\Nkalimutan ang masasakit na alaala,
Dialogue: 0,0:20:20.92,0:20:22.86,Default,,0,0,0,,ngunit patuloy silang bumabalik,
Dialogue: 0,0:20:22.88,0:20:26.53,Default,,0,0,0,,kaya hindi ba magandang\N na kalimutan sila ng tuluyan?
Dialogue: 0,0:20:26.55,0:20:30.21,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi mo siya kinukumbinsi.{\c}{\i0}
Dialogue: 0,0:20:33.77,0:20:35.47,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in.{\c}{\i0}
Dialogue: 0,0:20:36.10,0:20:37.33,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Siguro nabigla ka.{\c}{\i0}
Dialogue: 0,0:20:37.36,0:20:41.39,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Huwag kang magalit kay Hyun-woo.\NI told him to keep it from you.{\c}{\i0}
Dialogue: 0,0:20:41.78,0:20:43.94,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ikinalulungkot ko na hindi namin sinabi sa iyo.{\c}{\i0}
Dialogue: 0,0:20:44.24,0:20:46.86,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Natatakot kaming tumanggi kang pumunta.{\c}{\i0}
Dialogue: 0,0:20:47.32,0:20:49.05,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:20:49.08,0:20:50.64,Default,,0,0,0,,Gagawin ko rin sana.
Dialogue: 0,0:20:50.66,0:20:52.60,Default,,0,0,0,,Pagkatapos malaman ang tungkol sa iyong sakit,
Dialogue: 0,0:20:52.62,0:20:56.02,Default,,0,0,0,,Naabot ko ang mga ospital sa buong mundo,
Dialogue: 0,0:20:56.04,0:21:01.79,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}at pareho silang nagsabi. Nakipag-ugnayan na sila kay Hyun-woo.{\c}{\i0}
Dialogue: 0,0:21:02.38,0:21:03.92,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Nagpadala siya...{\c}{\i0}
Dialogue: 0,0:21:04.17,0:21:07.13,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}daang mga email,{\c}{\i0}
Dialogue: 0,0:21:07.55,0:21:10.99,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}at tinawag ang U.S. at European\Nhospitals sa kalagitnaan ng gabi...{\c}{\i0}
Dialogue: 0,0:21:11.01,0:21:14.88,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}upang maghanap ng mga lab o ospital na makakapagligtas sa iyo.{\c}{\i0}
Dialogue: 0,0:21:22.07,0:21:26.06,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ganyan niya nahanap ang ospital na iyon.{\c}{\i0}
Dialogue: 0,0:21:26.49,0:21:28.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}So Hae-in,{\c}{\i0}
Dialogue: 0,0:21:28.78,0:21:31.61,Default,,0,0,0,,pag-isipan ito ng mabuti at...
Dialogue: 0,0:21:31.99,0:21:35.27,Default,,0,0,0,,"Think"? Dapat magfocus muna siya sa buhay.
Dialogue: 0,0:21:35.29,0:21:36.93,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi ka ba sumasang-ayon?{\c}{\i0}
Dialogue: 0,0:21:36.96,0:21:40.95,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi mahalaga ang iyong mga alaala kung mamatay ka, di ba?{\c}{\i0}
Dialogue: 0,0:21:41.17,0:21:42.87,Default,,0,0,0,,Hindi bababa sa...
Dialogue: 0,0:21:44.13,0:21:47.92,Default,,0,0,0,,tatandaan mo ako bilang isang anak\Nna nagkaroon ng magandang relasyon...
Dialogue: 0,0:21:48.84,0:21:50.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}sa iyo,{\c}{\i0}
Dialogue: 0,0:21:50.85,0:21:53.42,Default,,0,0,0,,ngunit pagkatapos ng operasyon,
Dialogue: 0,0:21:53.68,0:21:56.38,Default,,0,0,0,,Baka maging stranger ako.
Dialogue: 0,0:21:57.98,0:22:01.72,Default,,0,0,0,,Ang Hae-in na madalas makipagtalo sayo,
Dialogue: 0,0:22:02.82,0:22:06.89,Default,,0,0,0,,bago ang maluha-luhang pakikipagkasundo, mawawala na.
Dialogue: 0,0:22:07.07,0:22:09.61,Default,,0,0,0,,Hindi na kita makikilala.
Dialogue: 0,0:22:17.41,0:22:18.60,Default,,0,0,0,,Pakiunawa.
Dialogue: 0,0:22:18.62,0:22:20.45,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Paumanhin.{\c}{\i0}
Dialogue: 0,0:22:22.84,0:22:25.62,Default,,0,0,0,,Okay. Let's hang up.
Dialogue: 0,0:22:26.88,0:22:30.25,Default,,0,0,0,,Magpahinga ka, at mag-uusap tayong muli sa lalong madaling panahon. Okay?
Dialogue: 0,0:22:30.59,0:22:32.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- Teka...\N- Bakit mo ito in-off?{\c}{\i0}
Dialogue: 0,0:22:32.85,0:22:34.62,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi pa niya kami sinasagot.{\c}{\i0}
Dialogue: 0,0:22:34.64,0:22:37.70,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aako ba kayo ng responsibilidad\Kung tatanggi siya sa operasyon?{\c}{\i0}
Dialogue: 0,0:22:37.73,0:22:39.50,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sus, na-off mo ba talaga?{\c}{\i0}
Dialogue: 0,0:22:39.52,0:22:41.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Gusto ko rin siyang makausap.{\c}{\i0}
Dialogue: 0,0:22:41.10,0:22:43.00,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bakit mo gagawin?{\c}{\i0}
Dialogue: 0,0:22:43.02,0:22:46.35,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Marami na siyang iniisip.{\c}{\i0}
Dialogue: 0,0:22:49.32,0:22:51.40,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Umiiyak ka ba, Tatay?{\c}{\i0}
Dialogue: 0,0:22:51.70,0:22:53.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Umiiyak siya.{\c}{\i0}
Dialogue: 0,0:22:54.12,0:22:58.53,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pinaiyak mo na ako ngayon.{\c}{\i0}
Dialogue: 0,0:22:59.12,0:23:00.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kabutihan.{\c}{\i0}
Dialogue: 0,0:23:01.54,0:23:03.58,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Lahat ay umiiyak.{\c}{\i0}
Dialogue: 0,0:23:07.21,0:23:11.33,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tawagan siya pabalik at hikayatin siya.{\c}{\i0}
Dialogue: 0,0:23:11.47,0:23:13.07,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ano ang masasabi ko?{\c}{\i0}
Dialogue: 0,0:23:13.10,0:23:15.09,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}May dapat tayong gawin.{\c}{\i0}
Dialogue: 0,0:23:39.33,0:23:40.56,Default,,0,0,0,,Geon-u.
Dialogue: 0,0:23:40.58,0:23:43.91,Default,,0,0,0,,Ikot ulit natin.
Dialogue: 0,0:23:55.72,0:23:57.07,Default,,0,0,0,,Ano ang nagdadala sa iyo dito?
Dialogue: 0,0:23:57.10,0:23:59.67,Default,,0,0,0,,Hindi ka ba dapat mag-sorry muna?
Dialogue: 0,0:24:00.89,0:24:03.55,Default,,0,0,0,,- Hindi ka yata nagsisisi.\N- Hindi sa iyo,
Dialogue: 0,0:24:03.90,0:24:05.12,Default,,0,0,0,,pero ikinalulungkot ko ang aking pamilya.
Dialogue: 0,0:24:05.15,0:24:06.85,Default,,0,0,0,,Ang iyong pamilya?
Dialogue: 0,0:24:07.65,0:24:09.79,Default,,0,0,0,,Ganap kang nagkakamali.
Dialogue: 0,0:24:09.82,0:24:11.30,Default,,0,0,0,,Da-hye.
Dialogue: 0,0:24:11.32,0:24:12.42,Default,,0,0,0,,Huwag subukang magbago.
Dialogue: 0,0:24:12.45,0:24:14.86,Default,,0,0,0,,Pero gusto ko.
Dialogue: 0,0:24:15.07,0:24:16.93,Default,,0,0,0,,Hindi, gawin ang palagi mong ginagawa,
Dialogue: 0,0:24:16.95,0:24:18.55,Default,,0,0,0,,at scam ang mga nasa paligid mo.
Dialogue: 0,0:24:18.58,0:24:20.36,Default,,0,0,0,,Kung hindi, yung tinatawag mong pamilya...
Dialogue: 0,0:24:20.38,0:24:22.22,Default,,0,0,0,,- masasaktan.\N- Anong ibig mong sabihin?
Dialogue: 0,0:24:22.25,0:24:24.85,Default,,0,0,0,,Manatili dito kung gusto mong malaman.
Dialogue: 0,0:24:24.88,0:24:27.48,Default,,0,0,0,,Dumating ako para balaan ka, dahil\NI igalang ang kasaysayan...
Dialogue: 0,0:24:27.50,0:24:28.60,Default,,0,0,0,,magkasama kaming nagbahagi,
Dialogue: 0,0:24:28.63,0:24:30.33,Default,,0,0,0,,pero...
Dialogue: 0,0:24:30.55,0:24:32.02,Default,,0,0,0,,Hindi kita mabigyan ng maraming oras.
Dialogue: 0,0:24:32.05,0:24:34.90,Default,,0,0,0,,Ibigay mo sa akin ang USB stick na kinuha mo kay Jun-ho,
Dialogue: 0,0:24:34.93,0:24:38.38,Default,,0,0,0,,at umalis kasama ang iyong anak.
Dialogue: 0,0:24:40.85,0:24:42.54,Default,,0,0,0,,Hindi ka dapat pumunta dito.
Dialogue: 0,0:24:42.56,0:24:44.50,Default,,0,0,0,,Dapat nanatili ka na lang sa U.S.
Dialogue: 0,0:24:44.52,0:24:45.75,Default,,0,0,0,,Naiintindihan ko ang sinasabi mo,
Dialogue: 0,0:24:45.77,0:24:48.75,Default,,0,0,0,,kaya huwag mong saktan si Soo-cheol o ang pamilya ko.
Dialogue: 0,0:24:48.77,0:24:50.79,Default,,0,0,0,,Hindi ako uupo kung gagawin mo.
Dialogue: 0,0:24:50.82,0:24:52.64,Default,,0,0,0,,Ano ang gagawin mo?
Dialogue: 0,0:24:52.90,0:24:56.05,Default,,0,0,0,,Ibibigay ko ang USB stick sa\Nsa pulis o sa prosekusyon.
Dialogue: 0,0:24:56.07,0:24:57.34,Default,,0,0,0,,Sabay tayong bumaba.
Dialogue: 0,0:24:57.37,0:24:59.30,Default,,0,0,0,,Hindi mo dapat sinasabi yan bilang nanay.
Dialogue: 0,0:24:59.33,0:25:00.85,Default,,0,0,0,,Sino ang magbabantay kay Geon-u?
Dialogue: 0,0:25:00.87,0:25:04.07,Default,,0,0,0,,Aalagaan ba ng pamilyang ito\Nof isang bata na hindi sa kanila?
Dialogue: 0,0:25:04.66,0:25:06.37,Default,,0,0,0,,Hoy!
Dialogue: 0,0:25:07.00,0:25:09.52,Default,,0,0,0,,Bakit ang lamig mo sa labas?
Dialogue: 0,0:25:09.54,0:25:11.77,Default,,0,0,0,,Baka sipon si Geon-u.
Dialogue: 0,0:25:11.80,0:25:13.50,Default,,0,0,0,,Seon-hwa.
Dialogue: 0,0:25:13.72,0:25:17.67,Default,,0,0,0,,Kilala mo pa ba kung sino talaga si Da-hye?
Dialogue: 0,0:25:19.97,0:25:21.66,Default,,0,0,0,,Hindi mahalaga.
Dialogue: 0,0:25:21.68,0:25:24.84,Default,,0,0,0,,Tumanggi ang anak ko na pakawalan siya.
Dialogue: 0,0:26:18.32,0:26:20.02,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:28:11.85,0:28:14.47,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dalawang mahahalagang bagay na lang ang natitira sa akin...{\c}{\i0}
Dialogue: 0,0:28:14.60,0:28:17.26,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}sa buhay na ito na ibinigay mo sa akin.{\c}{\i0}
Dialogue: 0,0:28:17.61,0:28:20.00,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang mga alaala ng pagmamahal sa iba,{\c}{\i0}
Dialogue: 0,0:28:20.03,0:28:22.23,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}at mahalin pabalik.{\c}{\i0}
Dialogue: 0,0:28:22.53,0:28:25.02,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi ko sila mabitawan.{\c}{\i0}
Dialogue: 0,0:28:26.74,0:28:29.10,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi ko hihilingin sa iyo na iligtas ako,{\c}{\i0}
Dialogue: 0,0:28:29.12,0:28:30.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}pero pakiusap...{\c}{\i0}
Dialogue: 0,0:28:31.33,0:28:33.18,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}hayaan kong pahalagahan...{\c}{\i0}
Dialogue: 0,0:28:33.21,0:28:35.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}mga alaalang ito hanggang sa aking huling hininga.{\c}{\i0}
Dialogue: 0,0:29:06.20,0:29:07.73,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:29:27.89,0:29:31.13,Default,,0,0,0,,Hae-in, pasensya na.
Dialogue: 0,0:29:31.31,0:29:33.38,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:29:34.18,0:29:36.59,Default,,0,0,0,,Huwag mong gawin sa akin ito.
Dialogue: 0,0:29:37.60,0:29:41.02,Default,,0,0,0,,Huwag mo akong gustong mabuhay.
Dialogue: 0,0:29:49.66,0:29:52.90,Default,,0,0,0,,Hindi kita makikilala.
Dialogue: 0,0:29:55.37,0:29:58.37,Default,,0,0,0,,Magiging estranghero ako.
Dialogue: 0,0:30:07.97,0:30:10.67,Default,,0,0,0,,Kahit na ganyan,
Dialogue: 0,0:30:11.76,0:30:14.38,Default,,0,0,0,,Ako ang unang taong makikilala mo.
Dialogue: 0,0:30:15.81,0:30:18.97,Default,,0,0,0,,Then you'll fall in love with me again.
Dialogue: 0,0:30:19.10,0:30:22.47,Default,,0,0,0,,Tatakbo na naman ang puso mo\Npag nalasing ako at nagpapacute.
Dialogue: 0,0:30:22.77,0:30:25.52,Default,,0,0,0,,Maaari tayong magmahal muli.
Dialogue: 0,0:30:38.08,0:30:40.03,Default,,0,0,0,,Mananatili ako sa iyo,
Dialogue: 0,0:30:40.38,0:30:42.28,Default,,0,0,0,,kahit na...
Dialogue: 0,0:30:43.00,0:30:44.69,Default,,0,0,0,,hindi ka nahuhulog sa akin,
Dialogue: 0,0:30:44.71,0:30:46.66,Default,,0,0,0,,balewala ako,
Dialogue: 0,0:30:47.59,0:30:49.12,Default,,0,0,0,,o...
Dialogue: 0,0:30:49.55,0:30:51.67,Default,,0,0,0,,ayaw sa akin.
Dialogue: 0,0:30:53.35,0:30:55.55,Default,,0,0,0,,Nangako ako.
Dialogue: 0,0:30:58.35,0:31:00.68,Default,,0,0,0,,Na mananatili ako sa iyo,
Dialogue: 0,0:31:01.94,0:31:04.14,Default,,0,0,0,,kahit may utang ka...
Dialogue: 0,0:31:05.61,0:31:07.39,Default,,0,0,0,,o higit pa,
Dialogue: 0,0:31:08.49,0:31:10.48,Default,,0,0,0,,kaya...
Dialogue: 0,0:31:11.41,0:31:13.40,Default,,0,0,0,,huwag mag-alala,
Dialogue: 0,0:31:13.70,0:31:16.44,Default,,0,0,0,,at manatili ka lang dito, pakiusap.
Dialogue: 0,0:31:16.74,0:31:18.14,Default,,0,0,0,,Huwag manalangin...
Dialogue: 0,0:31:18.16,0:31:20.61,Default,,0,0,0,,tungkol sa pagkamatay.
Dialogue: 0,0:31:22.04,0:31:23.99,Default,,0,0,0,,Natatakot ako...
Dialogue: 0,0:31:26.71,0:31:29.75,Default,,0,0,0,,na ito ay magkatotoo.
Dialogue: 0,0:31:38.98,0:31:41.18,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:32:38.83,0:32:41.15,Default,,0,0,0,,Kailangan kong gumamit ng banyo.
Dialogue: 0,0:32:41.87,0:32:43.49,Default,,0,0,0,,Sige at kumain.
Dialogue: 0,0:33:28.29,0:33:29.99,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:33:32.42,0:33:34.12,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:33:36.55,0:33:39.07,Default,,0,0,0,,Hindi ka umiinom ng kape nang walang laman ang tiyan,
Dialogue: 0,0:33:39.10,0:33:41.55,Default,,0,0,0,,pero kumakain ka ng espresso?
Dialogue: 0,0:33:42.18,0:33:44.58,Default,,0,0,0,,Nagbabasa ka ba ng English\Nnewspaper na iyon para magmukhang matalino,
Dialogue: 0,0:33:44.60,0:33:49.05,Default,,0,0,0,,habang sadyang binabaluktot\Ang iyong mga kalamnan sa bisig?
Dialogue: 0,0:33:54.74,0:33:56.27,Default,,0,0,0,,Tama.
Dialogue: 0,0:34:05.04,0:34:07.74,Default,,0,0,0,,Oo, sinasadya ko itong ginagawa.
Dialogue: 0,0:34:11.29,0:34:12.83,Default,,0,0,0,,Maghintay.
Dialogue: 0,0:34:12.92,0:34:16.67,Default,,0,0,0,,Malaya ka bang kumikilos, dahil hindi namin nairehistro ang aming kasal?
Dialogue: 0,0:34:16.80,0:34:20.49,Default,,0,0,0,,Kasal ka na, kaya huminto\Npagsisikap na magpahanga ng iba.
Dialogue: 0,0:34:20.51,0:34:23.07,Default,,0,0,0,,Ibaba ang iyong manggas, ikabit ang mga butones,
Dialogue: 0,0:34:23.10,0:34:26.13,Default,,0,0,0,,at magkaroon ng ilang piniritong itlog na may ilang ketchup.
Dialogue: 0,0:34:32.23,0:34:33.77,Default,,0,0,0,,Ayoko.
Dialogue: 0,0:34:34.23,0:34:37.27,Default,,0,0,0,,- Bakit hindi?\N- I'm going to get under your skin.
Dialogue: 0,0:34:37.86,0:34:39.56,Default,,0,0,0,,Ano?
Dialogue: 0,0:34:41.12,0:34:43.07,Default,,0,0,0,,Sabi mo sayang ako.
Dialogue: 0,0:34:46.87,0:34:49.07,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ikaw ang magiging pinakamalaking basura.{\c}{\i0}
Dialogue: 0,0:34:54.75,0:34:56.54,Default,,0,0,0,,Ikaw ba...
Dialogue: 0,0:34:57.01,0:34:58.83,Default,,0,0,0,,naririnig mo iyon?
Dialogue: 0,0:34:59.68,0:35:02.75,Default,,0,0,0,,Gagawin ko itong hindi mabata para sa iyo...
Dialogue: 0,0:35:02.93,0:35:04.88,Default,,0,0,0,,para iwan ako.
Dialogue: 0,0:35:10.31,0:35:12.47,Default,,0,0,0,,Dapat may prutas ako.
Dialogue: 0,0:35:26.66,0:35:29.86,Default,,0,0,0,,Siya pa rin ang pinakamalaking basura.
Dialogue: 0,0:35:35.04,0:35:36.98,Default,,0,0,0,,Labas na ang resulta ng DNA test.
Dialogue: 0,0:35:37.00,0:35:40.11,Default,,0,0,0,,Ang dugo ng biktima ay nasa\Ncar seat at ang murder weapon.
Dialogue: 0,0:35:40.13,0:35:41.82,Default,,0,0,0,,At ang mga print sa armas?
Dialogue: 0,0:35:41.84,0:35:44.29,Default,,0,0,0,,Eto na. Itong lalaking ito.
Dialogue: 0,0:35:52.01,0:35:53.71,Default,,0,0,0,,Ibaba ang iyong mga manggas at i-button ang mga ito.
Dialogue: 0,0:35:53.73,0:35:56.92,Default,,0,0,0,,Hindi mo dapat ipakita ang iyong mga armas nang ganyan.
Dialogue: 0,0:35:56.94,0:35:58.71,Default,,0,0,0,,- It's my choice.\N- Hoy.
Dialogue: 0,0:35:58.73,0:36:00.34,Default,,0,0,0,,I-roll ang mga ito pababa.
Dialogue: 0,0:36:00.36,0:36:02.05,Default,,0,0,0,,- Hindi.\N- Gawin mo.
Dialogue: 0,0:36:02.07,0:36:03.61,Default,,0,0,0,,Ayoko.
Dialogue: 0,0:36:18.17,0:36:20.11,Default,,0,0,0,,Kumusta ang treatment ni Ms. Hong?
Dialogue: 0,0:36:20.13,0:36:21.74,Default,,0,0,0,,- Ibabalik ba siya?\N- Syempre.
Dialogue: 0,0:36:21.76,0:36:24.19,Default,,0,0,0,,Mamumuno ba siya muli?
Dialogue: 0,0:36:24.22,0:36:27.28,Default,,0,0,0,,Well, hindi ako sigurado tungkol diyan.
Dialogue: 0,0:36:27.31,0:36:29.66,Default,,0,0,0,,Lahat tayo naghihirap dito.
Dialogue: 0,0:36:29.68,0:36:32.12,Default,,0,0,0,,Masasabi mo kung bumababa ang isang kumpanya...
Dialogue: 0,0:36:32.14,0:36:33.95,Default,,0,0,0,,batay sa cafeteria at pantry.
Dialogue: 0,0:36:33.98,0:36:37.12,Default,,0,0,0,,Nagulat ako nang alisin nila ang coffee machine.
Dialogue: 0,0:36:37.15,0:36:38.92,Default,,0,0,0,,Pumunta ka ba sa cafeteria ngayon?
Dialogue: 0,0:36:38.94,0:36:41.94,Default,,0,0,0,,Tumigil pa sila sa pagbibigay ng Yakult bilang dessert.
Dialogue: 0,0:36:43.07,0:36:46.13,Default,,0,0,0,,Wala nang pakialam ang kumpanya\Natungkol sa kalusugan ng ating bituka.
Dialogue: 0,0:36:46.16,0:36:50.80,Default,,0,0,0,,Alam kong nakadepende ang kapalaran natin sa mga boss natin,\Npero hindi ba dapat may gawin tayo?
Dialogue: 0,0:36:50.83,0:36:53.95,Default,,0,0,0,,Hindi ako sigurado...
Dialogue: 0,0:36:54.00,0:36:56.91,Default,,0,0,0,,kung ganoon din ang nararamdaman ni Secretary Kim.
Dialogue: 0,0:36:57.92,0:36:59.02,Default,,0,0,0,,- Bakit ako?\N- Naglaro ka...
Dialogue: 0,0:36:59.05,0:37:01.36,Default,,0,0,0,,isang mahalagang papel sa kasalukuyang pamamahala.
Dialogue: 0,0:37:01.38,0:37:03.86,Default,,0,0,0,,Nagkakamali ka. Nagpatakbo lang ako ng ilang errands.
Dialogue: 0,0:37:03.88,0:37:06.47,Default,,0,0,0,,At ikaw ay ginantimpalaan.
Dialogue: 0,0:37:06.49,0:37:07.49,Default,,0,0,0,,Ako noon,
Dialogue: 0,0:37:07.51,0:37:09.62,Default,,0,0,0,,- pero hindi maganda sa pakiramdam.\N- Bakit hindi?
Dialogue: 0,0:37:09.64,0:37:13.08,Default,,0,0,0,,Naging\Nawfully mabait at mapagpatawad si Direk Baek.
Dialogue: 0,0:37:13.10,0:37:16.50,Default,,0,0,0,,Siya ang nagbayad ng college\Ntuition ng kapatid ko, kaya hindi ako masyadong masaya.
Dialogue: 0,0:37:16.52,0:37:18.75,Default,,0,0,0,,Iyan ang iyong kasalanan na nagsasalita.
Dialogue: 0,0:37:18.77,0:37:21.00,Default,,0,0,0,,Hindi lahat ng reward ay maganda.
Dialogue: 0,0:37:21.03,0:37:22.85,Default,,0,0,0,,Tinatawagan ka.
Dialogue: 0,0:37:23.53,0:37:25.06,Default,,0,0,0,,Kumusta?
Dialogue: 0,0:37:25.11,0:37:26.26,Default,,0,0,0,,Oo, ako ito.
Dialogue: 0,0:37:26.28,0:37:28.02,Default,,0,0,0,,Ano? saan?
Dialogue: 0,0:37:33.12,0:37:36.60,Default,,0,0,0,,Pyeon Seong-uk ay natagpuang patay.
Dialogue: 0,0:37:36.69,0:37:37.75,Default,,0,0,0,,{\i1}Siya ay pinaslang.{\i0}
Dialogue: 0,0:37:37.78,0:37:38.77,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:37:38.79,0:37:40.94,Default,,0,0,0,,{\i1}Sumiklab ang balita nang umalis ka papuntang Germany.{\i0}
Dialogue: 0,0:37:40.96,0:37:42.79,Default,,0,0,0,,{\i1}Ngayon ko lang din nalaman.{\i0}
Dialogue: 0,0:37:44.63,0:37:46.63,Default,,0,0,0,,Sige.
Dialogue: 0,0:37:50.76,0:37:52.68,Default,,0,0,0,,Sir, natunton ko ang suspek.
Dialogue: 0,0:37:52.71,0:37:53.74,Default,,0,0,0,,Ano?
Dialogue: 0,0:37:53.77,0:37:55.99,Default,,0,0,0,,Tumakas siya sa Frankfurt pagkatapos ng insidente.
Dialogue: 0,0:37:56.02,0:37:57.12,Default,,0,0,0,,Natunton ko...
Dialogue: 0,0:37:57.14,0:37:58.25,Default,,0,0,0,,ang kanyang kasalukuyang lokasyon din.
Dialogue: 0,0:37:58.85,0:38:02.04,Default,,0,0,0,,Humiling tayo ng warrant at ipadala ang\Nit sa Foreign Affairs Bureau.
Dialogue: 0,0:38:02.07,0:38:03.89,Default,,0,0,0,,Sakit sa ulo kung mawala siya sa ibang bansa.
Dialogue: 0,0:38:03.92,0:38:05.17,Default,,0,0,0,,Oo, sir.
Dialogue: 0,0:38:05.19,0:38:06.84,Default,,0,0,0,,Hey.
Dialogue: 0,0:38:06.86,0:38:08.17,Default,,0,0,0,,Dapat itong kumpidensyal.
Dialogue: 0,0:38:08.20,0:38:10.55,Default,,0,0,0,,Huwag hayaang mahanap ng media\Nout bago natin siya mahuli.
Dialogue: 0,0:38:10.57,0:38:12.57,Default,,0,0,0,,Oo, sir. malay ko.
Dialogue: 0,0:38:15.91,0:38:18.18,Default,,0,0,0,,- Nakipagkita ako kay Da-hye.\N- Sorry?
Dialogue: 0,0:38:18.21,0:38:19.73,Default,,0,0,0,,Puwede mo lang akong ipadala.
Dialogue: 0,0:38:19.75,0:38:21.27,Default,,0,0,0,,Hindi ko alam na sobrang pipi siya.
Dialogue: 0,0:38:21.29,0:38:22.81,Default,,0,0,0,,Sabi ko sayo.
Dialogue: 0,0:38:22.84,0:38:25.23,Default,,0,0,0,,- Nahulog siya kay Soo-cheol.\N- Kaya tinawagan ko si Jun-ho.
Dialogue: 0,0:38:25.26,0:38:27.96,Default,,0,0,0,,Bakit mo tatawagin ang scumbag na iyon?
Dialogue: 0,0:38:28.68,0:38:30.65,Default,,0,0,0,,Para maalagaan niya siya?
Dialogue: 0,0:38:30.68,0:38:33.12,Default,,0,0,0,,Iniligtas ko siya dahil sa awa,\Nand siya nagdudulot ng mga problema.
Dialogue: 0,0:38:33.14,0:38:35.34,Default,,0,0,0,,Isa-isa ko silang tatanggalin.
Dialogue: 0,0:38:39.15,0:38:42.46,Default,,0,0,0,,Pinadala mo ba ang mga lalaking iyon sa Germany kamakailan...
Dialogue: 0,0:38:42.48,0:38:44.81,Default,,0,0,0,,para alagaan ang isang tao?
Dialogue: 0,0:38:45.07,0:38:46.46,Default,,0,0,0,,Hindi na sila babalik.
Dialogue: 0,0:38:46.49,0:38:51.13,Default,,0,0,0,,Maglipat ng pera sa kanila kapag tumawag sila,\Nand humanap ng lugar na matutuluyan nila.
Dialogue: 0,0:38:51.16,0:38:52.73,Default,,0,0,0,,Yes, ma'am.
Dialogue: 0,0:39:09.93,0:39:11.07,Default,,0,0,0,,Bakit hindi sila babalik?
Dialogue: 0,0:39:11.09,0:39:15.09,Default,,0,0,0,,Gaano kabigat ang kanilang krimen,\Nna hindi na sila babalik?
Dialogue: 0,0:39:18.52,0:39:20.72,Default,,0,0,0,,Hey, Ko Jeong-ja.
Dialogue: 0,0:39:21.44,0:39:24.64,Default,,0,0,0,,Huwag maging musmos. Alam mo na ang mangyayari.
Dialogue: 0,0:39:28.65,0:39:31.56,Default,,0,0,0,,Sa tingin ko ay sasaktan niya si Hae-in.
Dialogue: 0,0:39:47.63,0:39:49.09,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}$60,000,000{\c}{\i0}
Dialogue: 0,0:39:52.51,0:39:53.57,Default,,0,0,0,,Kumuha.
Dialogue: 0,0:39:53.59,0:39:57.55,Default,,0,0,0,,Walang mas mahusay kaysa sa\Nyou sa pagtitiis sa kawalan ng katarungan.
Dialogue: 0,0:39:59.18,0:40:00.72,Default,,0,0,0,,Oo.
Dialogue: 0,0:40:01.10,0:40:02.89,Default,,0,0,0,,Kalimutan mo na lang ito.
Dialogue: 0,0:40:20.16,0:40:21.70,Default,,0,0,0,,Kumusta?
Dialogue: 0,0:40:25.75,0:40:27.29,Default,,0,0,0,,Kumusta?
Dialogue: 0,0:40:27.38,0:40:28.73,Default,,0,0,0,,{\i1}Ako ito, Grace.{\i0}
Dialogue: 0,0:40:28.75,0:40:30.57,Default,,0,0,0,,Kumusta. Tungkol saan ito?
Dialogue: 0,0:40:30.59,0:40:31.90,Default,,0,0,0,,Kinamusta ko lang.
Dialogue: 0,0:40:31.92,0:40:33.92,Default,,0,0,0,,Magaling ba ang lahat?
Dialogue: 0,0:40:34.93,0:40:36.95,Default,,0,0,0,,- Sorry?\N- Sila na yata.
Dialogue: 0,0:40:36.97,0:40:38.32,Default,,0,0,0,,Natutuwa ako, kung gayon.
Dialogue: 0,0:40:38.35,0:40:41.41,Default,,0,0,0,,{\i1}Patuloy na manatiling ligtas hanggang sa bumalik ka.{\i0}
Dialogue: 0,0:40:41.43,0:40:43.26,Default,,0,0,0,,Paalam, kung gayon.
Dialogue: 0,0:41:32.99,0:41:35.31,Default,,0,0,0,,Hae...
Dialogue: 0,0:41:35.82,0:41:37.97,Default,,0,0,0,,Hae-in...
Dialogue: 0,0:41:37.99,0:41:40.36,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:41:41.54,0:41:43.07,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:41:48.92,0:41:51.62,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:41:54.34,0:41:57.15,Default,,0,0,0,,Kumusta? Nagkaroon ng aksidente sa sasakyan.
Dialogue: 0,0:41:57.18,0:41:59.36,Default,,0,0,0,,Sa tingin ko isa itong hit-and-run.
Dialogue: 0,0:41:59.39,0:42:00.92,Default,,0,0,0,,Hae-in...
Dialogue: 0,0:42:01.85,0:42:03.42,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:42:03.97,0:42:06.12,Default,,0,0,0,,Iniulat ko ito!
Dialogue: 0,0:42:06.14,0:42:09.16,Default,,0,0,0,,My gosh. Tumalikod!
Dialogue: 0,0:42:09.19,0:42:12.97,Default,,0,0,0,,Maaaring sumabog ang sasakyan! Bumalik ka!
Dialogue: 0,0:42:14.74,0:42:16.48,Default,,0,0,0,,Hyun-woo!
Dialogue: 0,0:42:36.55,0:42:38.75,Default,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:42:38.97,0:42:40.61,Default,,0,0,0,,Kalmado. Okay?
Dialogue: 0,0:42:40.64,0:42:43.42,Default,,0,0,0,,Nabangga ka ba ng sasakyan? Paano?
Dialogue: 0,0:42:45.68,0:42:47.12,Default,,0,0,0,,Kahit na...
Dialogue: 0,0:42:47.14,0:42:48.45,Default,,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:42:48.48,0:42:52.43,Default,,0,0,0,,Paano mo mababasag ang bintana\Ngamit ang iyong kamay? Tingnan mo ito!
Dialogue: 0,0:42:53.94,0:42:55.68,Default,,0,0,0,,Tingnan mo ang iyong kamay!
Dialogue: 0,0:43:10.50,0:43:12.62,Default,,0,0,0,,Akala ko patay ka na.
Dialogue: 0,0:43:26.52,0:43:28.26,Default,,0,0,0,,Ako ay...
Dialogue: 0,0:43:28.35,0:43:29.79,Default,,0,0,0,,Ako ay...
Dialogue: 0,0:43:29.81,0:43:31.59,Default,,0,0,0,,Nagaan ang loob ko.
Dialogue: 0,0:43:39.57,0:43:41.10,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:43:42.07,0:43:43.77,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:43:45.12,0:43:47.07,Default,,0,0,0,,Okay na ang lahat.
Dialogue: 0,0:43:59.59,0:44:02.01,Default,,0,0,0,,{\i1}{\c&HFFFF&}Emergency Room{\c}{\i0}
Dialogue: 0,0:44:04.35,0:44:06.25,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,0:44:06.35,0:44:08.13,Default,,0,0,0,,Masakit.
Dialogue: 0,0:44:10.60,0:44:13.75,Default,,0,0,0,,Hindi ka dapat umarte na parang baliw.
Dialogue: 0,0:44:13.77,0:44:15.64,Default,,0,0,0,,Isa talaga ako,
Dialogue: 0,0:44:15.73,0:44:18.75,Default,,0,0,0,,mula nang nasaksihan ko ang pagbagsak.
Dialogue: 0,0:44:18.78,0:44:20.89,Default,,0,0,0,,Akala ko nasa sasakyan ka.
Dialogue: 0,0:44:21.49,0:44:24.06,Default,,0,0,0,,Kailan ka nakalabas?
Dialogue: 0,0:44:25.20,0:44:27.69,Default,,0,0,0,,Sa palagay ko, umiiral ang lady luck.
Dialogue: 0,0:44:40.34,0:44:41.32,Default,,0,0,0,,Tingnan.
Dialogue: 0,0:44:41.34,0:44:42.94,Default,,0,0,0,,Binili ko ulit.
Dialogue: 0,0:44:42.97,0:44:45.53,Default,,0,0,0,,Kasing mahal pa rin noon,
Dialogue: 0,0:44:45.55,0:44:47.25,Default,,0,0,0,,pero ito...
Dialogue: 0,0:44:47.81,0:44:49.34,Default,,0,0,0,,iniligtas ang buhay ko.
Dialogue: 0,0:44:55.98,0:44:57.96,Default,,0,0,0,,Iiyak ka ba ng ganyan kung mamatay ako?
Dialogue: 0,0:44:57.98,0:44:59.52,Default,,0,0,0,,Siyempre.
Dialogue: 0,0:45:02.07,0:45:04.19,Default,,0,0,0,,Kung gayon ay hindi mangyayari iyon.
Dialogue: 0,0:45:05.86,0:45:07.69,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:45:07.74,0:45:10.47,Default,,0,0,0,,Masyado kang humila sa puso ko.
Dialogue: 0,0:45:10.49,0:45:12.31,Default,,0,0,0,,Pinapagusto mong yakapin ka ng mga tao.
Dialogue: 0,0:45:12.33,0:45:15.31,Default,,0,0,0,,Ang sexy mo nang naka-sleeve up,\Ang cute mo kapag lasing,
Dialogue: 0,0:45:15.33,0:45:18.54,Default,,0,0,0,,at gusto mong yakapin ka ng iba kapag umiiyak ka.
Dialogue: 0,0:45:18.67,0:45:20.77,Default,,0,0,0,,Pumila ang mga babae,
Dialogue: 0,0:45:20.80,0:45:22.61,Default,,0,0,0,,at hindi ko iyon papayagan.
Dialogue: 0,0:45:22.63,0:45:25.86,Default,,0,0,0,,pupunta ako sa libingan ko.
Dialogue: 0,0:45:25.88,0:45:27.88,Default,,0,0,0,,Anong sinasabi mo?
Dialogue: 0,0:45:29.97,0:45:31.88,Default,,0,0,0,,Magpapaopera ako.
Dialogue: 0,0:45:37.98,0:45:39.93,Default,,0,0,0,,Ibig mo bang sabihin?
Dialogue: 0,0:45:42.40,0:45:45.30,Default,,0,0,0,,Kinikilabutan ako, kasi hindi ko alam...
Dialogue: 0,0:45:45.32,0:45:49.32,Default,,0,0,0,,kung mawawala lang ang alaala ko\Ni kung sino ako ng buo,
Dialogue: 0,0:45:50.08,0:45:52.53,Default,,0,0,0,,pero ayokong mawala ka.
Dialogue: 0,0:45:59.46,0:46:01.60,Default,,0,0,0,,Ayokong nakikita kang umiiyak.
Dialogue: 0,0:46:01.63,0:46:04.07,Default,,0,0,0,,Hinihikayat kita na pakasalan ako sa pamamagitan ng pangako...
Dialogue: 0,0:46:04.09,0:46:06.71,Default,,0,0,0,,Hinding-hindi kita paiiyakin.
Dialogue: 0,0:46:07.47,0:46:09.96,Default,,0,0,0,,Dapat ko nang tuparin ang pangako ko.
Dialogue: 0,0:46:17.44,0:46:18.87,Default,,0,0,0,,Salamat.
Dialogue: 0,0:46:18.90,0:46:21.47,Default,,0,0,0,,Naiintindihan ko kung ano ang dapat mong maramdaman.
Dialogue: 0,0:46:23.23,0:46:25.27,Default,,0,0,0,,Labis kang balisa...
Dialogue: 0,0:46:25.57,0:46:27.23,Default,,0,0,0,,at takot na takot,
Dialogue: 0,0:46:27.45,0:46:29.47,Default,,0,0,0,,pero hinding hindi ka...
Dialogue: 0,0:46:29.49,0:46:31.86,Default,,0,0,0,,wala sa sarili.
Dialogue: 0,0:46:32.03,0:46:33.93,Default,,0,0,0,,Hindi ko hahayaang mangyari iyon.
Dialogue: 0,0:46:33.95,0:46:35.82,Default,,0,0,0,,Tutulungan kitang manatili...
Dialogue: 0,0:46:36.16,0:46:38.24,Default,,0,0,0,,sino ka.
Dialogue: 0,0:46:40.42,0:46:41.95,Default,,0,0,0,,Sige.
Dialogue: 0,0:46:42.54,0:46:44.08,Default,,0,0,0,,Pinagkakatiwalaan kita.
Dialogue: 0,0:46:49.22,0:46:52.24,Default,,0,0,0,,Gosh, Pinky. Ang sarap mong kumain.
Dialogue: 0,0:46:52.26,0:46:53.28,Default,,0,0,0,,Masarap ba?
Dialogue: 0,0:46:53.31,0:46:54.87,Default,,0,0,0,,- Mag-usap tayo.\N- Hindi, salamat.
Dialogue: 0,0:46:54.89,0:46:56.03,Default,,0,0,0,,Ano ang sa iyo?
Dialogue: 0,0:46:56.06,0:46:57.66,Default,,0,0,0,,Ang gusali ay palaging aking turf.
Dialogue: 0,0:46:57.68,0:47:00.35,Default,,0,0,0,,Maaari itong magdulot ng lamat sa pagitan natin.
Dialogue: 0,0:47:01.56,0:47:03.83,Default,,0,0,0,,- I think I'm getting divorced.\N- Ano?
Dialogue: 0,0:47:03.86,0:47:06.94,Default,,0,0,0,,Pagod ka na bang mamuhay nang malayo sa iyong pamilya?
Dialogue: 0,0:47:07.49,0:47:08.63,Default,,0,0,0,,Siyempre.
Dialogue: 0,0:47:08.65,0:47:12.61,Default,,0,0,0,,Hindi ko alam kung kailan makukuha ng aking\Nasawa ang kanyang doctorate.
Dialogue: 0,0:47:12.70,0:47:15.86,Default,,0,0,0,,Pinadala ko ang aking anak sa ibang bansa upang palawakin ang kanyang pananaw,
Dialogue: 0,0:47:17.04,0:47:19.97,Default,,0,0,0,,at sa tingin ko masyado siyang abala para ma-miss ako.
Dialogue: 0,0:47:20.00,0:47:21.27,Default,,0,0,0,,Pagkatapos ay makipag-live sa kanila.
Dialogue: 0,0:47:21.29,0:47:22.64,Default,,0,0,0,,Kung gayon, sino ang magiging breadwinner?
Dialogue: 0,0:47:22.67,0:47:24.27,Default,,0,0,0,,Hindi ako makakaasa kay Hyun-woo forever.
Dialogue: 0,0:47:24.29,0:47:26.37,Default,,0,0,0,,So makikipagdivorce ka?
Dialogue: 0,0:47:26.55,0:47:28.58,Default,,0,0,0,,- Hindi yun ang dahilan.\N- Tapos?
Dialogue: 0,0:47:29.38,0:47:31.08,Default,,0,0,0,,- I think he's having affair.\N- Ano?
Dialogue: 0,0:47:31.10,0:47:33.32,Default,,0,0,0,,Isang babaeng Amerikano ang sumagot sa kanyang telepono,
Dialogue: 0,0:47:33.35,0:47:35.55,Default,,0,0,0,,at gabi na.
Dialogue: 0,0:47:46.53,0:47:50.40,Default,,0,0,0,,Bakit ka magbibigay ng napakasamang tugon?
Dialogue: 0,0:47:51.78,0:47:53.56,Default,,0,0,0,,Binabugbog ako.
Dialogue: 0,0:47:54.87,0:47:57.82,Default,,0,0,0,,I just blurted it the moment she talked.
Dialogue: 0,0:47:57.95,0:48:00.22,Default,,0,0,0,,Sus, ang bait niya talaga.
Dialogue: 0,0:48:00.25,0:48:03.69,Default,,0,0,0,,Sinadya niyang pumili ng babaeng Amerikano.
Dialogue: 0,0:48:03.71,0:48:07.77,Default,,0,0,0,,Alam niyang bahagya kang nagsasalita ng\Nwika at hindi mo sila kayang harapin.
Dialogue: 0,0:48:07.80,0:48:08.86,Default,,0,0,0,,Sus.
Dialogue: 0,0:48:08.88,0:48:12.00,Default,,0,0,0,,Totoo na hindi ko sila kayang harapin,
Dialogue: 0,0:48:12.18,0:48:14.57,Default,,0,0,0,,o pumunta ako doon.
Dialogue: 0,0:48:14.60,0:48:15.57,Default,,0,0,0,,{\i1}{\c&HFFFF&}Hairstylist Awards{\c}{\i0}
Dialogue: 0,0:48:16.39,0:48:18.37,Default,,0,0,0,,Kailangan kong manatili dito,
Dialogue: 0,0:48:18.39,0:48:20.45,Default,,0,0,0,,kaya tulungan mo ako.
Dialogue: 0,0:48:20.48,0:48:22.18,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:48:24.56,0:48:26.26,Default,,0,0,0,,Fine.
Dialogue: 0,0:48:26.65,0:48:28.54,Default,,0,0,0,,Maaari kang magkaroon ng gusali.
Dialogue: 0,0:48:28.57,0:48:30.18,Default,,0,0,0,,Iyo na ang lahat.
Dialogue: 0,0:48:31.24,0:48:32.81,Default,,0,0,0,,Salamat.
Dialogue: 0,0:48:35.20,0:48:37.59,Default,,0,0,0,,Sus, huwag kang umiyak.
Dialogue: 0,0:48:37.62,0:48:40.76,Default,,0,0,0,,Pakikinggan ko siya kapag nakita ko ang hamak na iyon.
Dialogue: 0,0:48:40.79,0:48:43.41,Default,,0,0,0,,Paano siya makikipag-date sa isang babaeng Amerikano?
Dialogue: 0,0:48:43.71,0:48:45.58,Default,,0,0,0,,Sus.
Dialogue: 0,0:48:46.59,0:48:48.23,Default,,0,0,0,,Welcome.
Dialogue: 0,0:48:48.25,0:48:49.36,Default,,0,0,0,,Kumusta.
Dialogue: 0,0:48:49.38,0:48:50.73,Default,,0,0,0,,Nasaan si Du-gwan?
Dialogue: 0,0:48:50.76,0:48:52.65,Default,,0,0,0,,Nasa palengke siya.
Dialogue: 0,0:48:52.67,0:48:55.32,Default,,0,0,0,,Mukhang busy siya ngayon,\Nkaya sabi ko ako na ang bahala sa tindahan niya.
Dialogue: 0,0:48:55.34,0:48:58.16,Default,,0,0,0,,- I see, so part-timing ka?\N- "Part-timing"?
Dialogue: 0,0:48:58.18,0:48:59.41,Default,,0,0,0,,Hindi.
Dialogue: 0,0:48:59.43,0:49:00.91,Default,,0,0,0,,Naranasan ko na.
Dialogue: 0,0:49:00.93,0:49:03.20,Default,,0,0,0,,Dati akong CEO ng\Na mart franchise sa Seoul.
Dialogue: 0,0:49:03.84,0:49:05.75,Default,,0,0,0,,Ito ay parang "Hindi Inaasahang Negosyo."
Dialogue: 0,0:49:05.77,0:49:07.75,Default,,0,0,0,,Ano iyon?
Dialogue: 0,0:49:07.77,0:49:09.42,Default,,0,0,0,,Ito ang variety show...
Dialogue: 0,0:49:09.44,0:49:11.04,Default,,0,0,0,,kasama sina Cha Tae-hyun at Zo In-sung.
Dialogue: 0,0:49:11.07,0:49:12.75,Default,,0,0,0,,Namamahala sila ng tindahan.
Dialogue: 0,0:49:12.78,0:49:15.06,Default,,0,0,0,,Tama ka.
Dialogue: 0,0:49:16.91,0:49:17.88,Default,,0,0,0,,Iyon lang!
Dialogue: 0,0:49:17.91,0:49:19.05,Default,,0,0,0,,Sige.
Dialogue: 0,0:49:19.08,0:49:20.22,Default,,0,0,0,,{\i1}{\c&HFFFF&}Snow Crab Ramyun $3.50{\c}{\i0}
Dialogue: 0,0:49:20.24,0:49:22.14,Default,,0,0,0,,Goodness, tingnan mo ito.
Dialogue: 0,0:49:22.16,0:49:24.82,Default,,0,0,0,,Ito ay isang kapistahan.
Dialogue: 0,0:49:25.12,0:49:26.10,Default,,0,0,0,,Sus.
Dialogue: 0,0:49:26.12,0:49:29.85,Default,,0,0,0,,Hindi madaling makuha\Nang snow crab na ito mula kay Uljin.
Dialogue: 0,0:49:29.88,0:49:31.23,Default,,0,0,0,,Mahal ang express delivery.
Dialogue: 0,0:49:31.25,0:49:32.73,Default,,0,0,0,,Hindi ba dapat maningil ka pa...
Dialogue: 0,0:49:32.76,0:49:36.40,Default,,0,0,0,,kaysa sa regular na {\i1}ramyun{\i0} na presyo na $3.50?
Dialogue: 0,0:49:36.43,0:49:38.45,Default,,0,0,0,,Hindi ko sinusubukang kumita.
Dialogue: 0,0:49:38.47,0:49:40.05,Default,,0,0,0,,Ano?
Dialogue: 0,0:49:40.76,0:49:43.79,Default,,0,0,0,,Unang Kabanata ng aking aklat,\N"The Neighborhood Business King,"
Dialogue: 0,0:49:43.81,0:49:47.75,Default,,0,0,0,,ay "Magtanong ng Pag-ibig sa Iyong Kapitbahay, Hindi Pera."
Dialogue: 0,0:49:47.77,0:49:49.25,Default,,0,0,0,,Nagsulat ka ng libro?
Dialogue: 0,0:49:49.27,0:49:51.97,Default,,0,0,0,,Gagawin ko, batay sa karanasang ito.
Dialogue: 0,0:49:53.19,0:49:55.80,Default,,0,0,0,,Mukhang kamangha-mangha.
Dialogue: 0,0:49:55.82,0:49:57.39,Default,,0,0,0,,- May abalone din sa loob.\N- Sus!
Dialogue: 0,0:49:57.41,0:49:58.72,Default,,0,0,0,,- Goodness.\N- Abalone?
Dialogue: 0,0:49:58.74,0:50:00.72,Default,,0,0,0,,- Hay.\N- Narinig ko ang balita.
Dialogue: 0,0:50:00.74,0:50:02.61,Default,,0,0,0,,Nag-film sila ng "Unexpected Business" dito?
Dialogue: 0,0:50:02.64,0:50:03.72,Default,,0,0,0,,Nandito ba si In-sung?
Dialogue: 0,0:50:03.75,0:50:05.22,Default,,0,0,0,,Hindi, hindi siya,
Dialogue: 0,0:50:05.25,0:50:06.56,Default,,0,0,0,,pero may snow-crab {\i1}ramyun.{\i0}
Dialogue: 0,0:50:06.58,0:50:09.10,Default,,0,0,0,,May abalone din, at $3.50 lang.
Dialogue: 0,0:50:09.13,0:50:10.65,Default,,0,0,0,,- Ito ay isang bang for the buck.\N- Tama.
Dialogue: 0,0:50:10.67,0:50:12.52,Default,,0,0,0,,Gusto ko ng double portion.
Dialogue: 0,0:50:12.55,0:50:14.27,Default,,0,0,0,,- Okay.\N- Pwede ba akong kumagat?
Dialogue: 0,0:50:14.30,0:50:16.17,Default,,0,0,0,,Salamat.
Dialogue: 0,0:50:20.25,0:50:22.91,Default,,0,0,0,,Alam mo kung ano? Aanyayahan ko ang aking ina at lahat ng mga babae.
Dialogue: 0,0:50:22.93,0:50:24.50,Default,,0,0,0,,Dapat ba nating sabihin sa ating mga anak na sumama din?
Dialogue: 0,0:50:24.52,0:50:26.66,Default,,0,0,0,,- Oo, dapat.\N- Sige.
Dialogue: 0,0:50:26.69,0:50:27.75,Default,,0,0,0,,Tingnan dito, In-sung.
Dialogue: 0,0:50:27.77,0:50:29.85,Default,,0,0,0,,Halika. nagtatrabaho ako.
Dialogue: 0,0:50:31.06,0:50:34.27,Default,,0,0,0,,Pinapahiya mo ako.
Dialogue: 0,0:50:43.83,0:50:45.81,Default,,0,0,0,,- Enjoy.\N- Bakit, salamat.
Dialogue: 0,0:50:45.83,0:50:47.91,Default,,0,0,0,,Kabutihan. Sabi ko magpahinga ka na.
Dialogue: 0,0:50:48.12,0:50:50.44,Default,,0,0,0,,Alam ko, pero hindi ko kaya.
Dialogue: 0,0:50:50.46,0:50:52.35,Default,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:50:52.38,0:50:53.77,Default,,0,0,0,,Ito ay napakalaking hit.
Dialogue: 0,0:50:53.80,0:50:55.83,Default,,0,0,0,,Hindi ko rin inaasahan.
Dialogue: 0,0:50:56.13,0:50:57.19,Default,,0,0,0,,Tingnan ito.
Dialogue: 0,0:50:57.22,0:51:00.19,Default,,0,0,0,,Inalis ko na ang iyong {\i1}ramyun{\i0} aisle.
Dialogue: 0,0:51:00.22,0:51:02.07,Default,,0,0,0,,- Nakikita ko iyon.\N- Gusto nilang lahat.
Dialogue: 0,0:51:02.10,0:51:04.49,Default,,0,0,0,,May tatlong serving nang sabay-sabay.
Dialogue: 0,0:51:04.51,0:51:06.41,Default,,0,0,0,,Dumating ang buong pamilya ni Chun-sik...
Dialogue: 0,0:51:06.43,0:51:09.25,Default,,0,0,0,,at nagkaroon ng halaga ng tanghalian at hapunan.
Dialogue: 0,0:51:09.27,0:51:11.41,Default,,0,0,0,,Chun-sik, ang jerk na yan.
Dialogue: 0,0:51:11.44,0:51:12.71,Default,,0,0,0,,- Sorry?\N- Look.
Dialogue: 0,0:51:12.73,0:51:14.33,Default,,0,0,0,,Makinig ka sa akin.
Dialogue: 0,0:51:14.36,0:51:17.75,Default,,0,0,0,,Hindi ka kikita\Nisinasaalang-alang ang snow crab, abalone,
Dialogue: 0,0:51:17.78,0:51:19.84,Default,,0,0,0,,hipon, at ang delivery fee, alam mo ba?
Dialogue: 0,0:51:19.86,0:51:21.30,Default,,0,0,0,,Baon kami sa utang.
Dialogue: 0,0:51:21.32,0:51:24.94,Default,,0,0,0,,Hindi, ito ay isang diskarte lamang sa marketing.
Dialogue: 0,0:51:26.37,0:51:28.31,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ikinalulungkot ko ang lahat ng abala,{\c}{\i0}
Dialogue: 0,0:51:28.33,0:51:31.06,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero ako ang pinaka-guilty\Natungkol sa pag-iwan sa kanya.{\c}{\i0}
Dialogue: 0,0:51:31.08,0:51:34.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Parang nag-iiwan ng bag ng basura...{\c}{\i0}
Dialogue: 0,0:51:34.88,0:51:36.19,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pagkatapos ng biyahe.{\c}{\i0}
Dialogue: 0,0:51:36.21,0:51:38.19,Default,,0,0,0,,Binabala niya ako.
Dialogue: 0,0:51:38.22,0:51:40.03,Default,,0,0,0,,Hindi kami kumikita sa {\i1}ramyun.{\i0}
Dialogue: 0,0:51:40.05,0:51:43.28,Default,,0,0,0,,Ang layunin namin ay gastusin sila\Npera sa mas mahal.
Dialogue: 0,0:51:43.30,0:51:49.05,Default,,0,0,0,,{\i1}Ramyun{\i0} ang pinakamahal na pagkain na mayroon kami.
Dialogue: 0,0:51:59.99,0:52:03.27,Default,,0,0,0,,Lubos kong nakalimutan iyon.
Dialogue: 0,0:52:03.82,0:52:05.94,Default,,0,0,0,,So natanggal ka ba?
Dialogue: 0,0:52:06.54,0:52:08.85,Default,,0,0,0,,Tinanggap ko ang responsibilidad at nagbitiw.
Dialogue: 0,0:52:08.87,0:52:13.03,Default,,0,0,0,,Ihinto ang pag-istorbo at bumalik sa Seoul.
Dialogue: 0,0:52:14.38,0:52:15.91,Default,,0,0,0,,Hindi.
Dialogue: 0,0:52:15.96,0:52:19.65,Default,,0,0,0,,Ipagpapatuloy ko ang pakikipag-ugnayan\Nsa mga mamimili dito,
Dialogue: 0,0:52:19.67,0:52:24.79,Default,,0,0,0,,at humanap ng paraan para magsama ang mga magsasaka\Nand big marts.
Dialogue: 0,0:52:32.63,0:52:35.80,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Akala mo ba ang pagnanakaw ng aking pasaporte\Nay mapipigilan akong pumunta sa Korea?{\c}{\i0}
Dialogue: 0,0:52:35.83,0:52:36.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nasaan ka?{\c}{\i0}
Dialogue: 0,0:52:36.87,0:52:40.09,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ms. Sinabi sa akin ni Moh na nagtago ka sa bayan ni Hyun-woo.{\c}{\i0}
Dialogue: 0,0:52:40.11,0:52:42.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dapat ba akong pumunta doon ngayon? Dapat ba ako?{\c}{\i0}
Dialogue: 0,0:52:42.45,0:52:44.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi, mangyaring huwag gawin iyon.{\c}{\i0}
Dialogue: 0,0:52:44.47,0:52:45.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pasensya na.{\c}{\i0}
Dialogue: 0,0:52:45.49,0:52:46.80,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kung gusto mong i-save si Soo-cheol,{\c}{\i0}
Dialogue: 0,0:52:46.82,0:52:49.93,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kilalanin mo ako sa address na ipinadala ko\Nkasama ang lahat ng ninakaw mo.{\c}{\i0}
Dialogue: 0,0:52:49.95,0:52:51.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ko na uulitin ang sarili ko.{\c}{\i0}
Dialogue: 0,0:52:55.17,0:52:57.40,Default,,0,0,0,,May malapit na amusement park.
Dialogue: 0,0:52:57.42,0:52:59.62,Default,,0,0,0,,Pupunta ba tayo doon bukas?
Dialogue: 0,0:53:00.05,0:53:02.28,Default,,0,0,0,,down ako. Gagawa ako ng {\i1}gimbap.{\i0}
Dialogue: 0,0:53:02.30,0:53:04.40,Default,,0,0,0,,Geon-u, pupunta tayo sa isang amusement park!
Dialogue: 0,0:53:04.43,0:53:06.09,Default,,0,0,0,,Isang amusement park!
Dialogue: 0,0:53:09.81,0:53:10.89,Default,,0,0,0,,Hindi ka ba nabighani?
Dialogue: 0,0:53:10.92,0:53:11.91,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:53:11.93,0:53:14.08,Default,,0,0,0,,Nasaan si Mommy?
Dialogue: 0,0:53:14.10,0:53:15.25,Default,,0,0,0,,Ayan na siya.
Dialogue: 0,0:53:15.27,0:53:16.97,Default,,0,0,0,,Hi, Mommy.
Dialogue: 0,0:53:24.95,0:53:26.56,Default,,0,0,0,,Geon-u, nandito si Mommy!
Dialogue: 0,0:53:27.37,0:53:30.18,Default,,0,0,0,,Kain na tayo.
Dialogue: 0,0:53:30.20,0:53:32.70,Default,,0,0,0,,- Ang sarap.\N- Ang sarap.
Dialogue: 0,0:53:34.16,0:53:35.87,Default,,0,0,0,,- Maganda ba?\N- Maganda.
Dialogue: 0,0:53:37.63,0:53:39.94,Default,,0,0,0,,Geon-u, tingnan mo ako.
Dialogue: 0,0:53:39.96,0:53:42.11,Default,,0,0,0,,Good boy. Magaling.
Dialogue: 0,0:53:42.13,0:53:43.57,Default,,0,0,0,,Geon-u.
Dialogue: 0,0:53:43.59,0:53:45.29,Default,,0,0,0,,Good boy.
Dialogue: 0,0:53:47.30,0:53:49.24,Default,,0,0,0,,Pagod na ako.
Dialogue: 0,0:53:49.26,0:53:51.66,Default,,0,0,0,,- Pwede mo ba akong bilhan ng kape?\N- Kape?
Dialogue: 0,0:53:51.68,0:53:54.30,Default,,0,0,0,,Maghintay dito. kukuha ako.
Dialogue: 0,0:53:56.27,0:53:58.22,Default,,0,0,0,,Ang lamig no?
Dialogue: 0,0:54:03.57,0:54:05.98,Default,,0,0,0,,Okay. Ang kamay mo.
Dialogue: 0,0:54:29.76,0:54:32.09,Default,,0,0,0,,- Babalik ako kaagad.\N- Okay.
Dialogue: 0,0:54:59.37,0:55:00.91,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:55:17.88,0:55:20.08,Default,,0,0,0,,Naghahanap ba siya ng banyo?
Dialogue: 0,0:55:45.13,0:55:46.86,Default,,0,0,0,,Da-hye...
Dialogue: 0,0:55:46.88,0:55:48.41,Default,,0,0,0,,Da-hye!
Dialogue: 0,0:55:50.55,0:55:52.08,Default,,0,0,0,,Da-hye!
Dialogue: 0,0:55:53.18,0:55:54.71,Default,,0,0,0,,Da...
Dialogue: 0,0:55:55.39,0:55:58.13,Default,,0,0,0,,Da-hye!
Dialogue: 0,0:55:59.02,0:56:00.66,Default,,0,0,0,,Da-hye!
Dialogue: 0,0:56:00.69,0:56:02.93,Default,,0,0,0,,Da-hye...
Dialogue: 0,0:56:04.11,0:56:06.00,Default,,0,0,0,,Da-hye...
Dialogue: 0,0:56:06.02,0:56:09.31,Default,,0,0,0,,Da-hye...
Dialogue: 0,0:56:10.95,0:56:14.98,Default,,0,0,0,,Bakit mo ako iniwan ulit?
Dialogue: 0,0:56:20.58,0:56:22.22,Default,,0,0,0,,{\i1}Ito ay isang pampublikong anunsyo.{\i0}
Dialogue: 0,0:56:22.25,0:56:27.02,Default,,0,0,0,,{\i1}Mr. Hinahanap ni Hong Soo-cheol, 31, ang kanyang asawa.{\i0}
Dialogue: 0,0:56:27.05,0:56:29.82,Default,,0,0,0,,{\i1}Mangyaring pumunta sa Lost Children Center...{\i0}
Dialogue: 0,0:56:29.84,0:56:32.99,Default,,0,0,0,,- Ano? Pero nasa hustong gulang na siya.\N- {\i1}...sa sandaling marinig mo ito.{\i0}
Dialogue: 0,0:56:33.01,0:56:34.45,Default,,0,0,0,,{\i1}Muli...{\i0}
Dialogue: 0,0:56:34.47,0:56:36.17,Default,,0,0,0,,{\i1}Da-hye.{\i0}
Dialogue: 0,0:56:36.89,0:56:38.59,Default,,0,0,0,,{\i1}Huwag kang pumunta.{\i0}
Dialogue: 0,0:56:38.97,0:56:40.51,Default,,0,0,0,,{\i1}I...{\i0}
Dialogue: 0,0:56:40.60,0:56:43.09,Default,,0,0,0,,{\i1}Gagawin ko pa.{\i0}
Dialogue: 0,0:56:45.06,0:56:48.06,Default,,0,0,0,,{\i1}Ipinapangako ko,{\i0}
Dialogue: 0,0:56:48.23,0:56:50.27,Default,,0,0,0,,{\i1}kaya mangyaring huwag umalis.{\i0}
Dialogue: 0,0:56:50.57,0:56:53.34,Default,,0,0,0,,Ano? Iniwan ba siya ng kanyang asawa dito at tumakas?
Dialogue: 0,0:56:53.36,0:56:55.76,Default,,0,0,0,,Hindi pwede. Siya ay inabandona.
Dialogue: 0,0:56:55.78,0:56:59.35,Default,,0,0,0,,Talo siya para iwan siya rito.
Dialogue: 0,0:56:59.37,0:57:01.11,Default,,0,0,0,,Hindi siya talo.
Dialogue: 0,0:57:01.50,0:57:02.60,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:57:02.62,0:57:04.78,Default,,0,0,0,,Hindi siya talo.
Dialogue: 0,0:57:04.92,0:57:06.52,Default,,0,0,0,,Asawa ko...
Dialogue: 0,0:57:06.54,0:57:09.16,Default,,0,0,0,,ay ang pinakakahanga-hangang tao kailanman.
Dialogue: 0,0:57:17.80,0:57:20.30,Default,,0,0,0,,Okay lang. Tara na.
Dialogue: 0,0:57:40.45,0:57:43.11,Default,,0,0,0,,Saan ka nagpunta matapos akong iwan?
Dialogue: 0,0:57:43.16,0:57:45.53,Default,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:57:56.38,0:57:59.04,Default,,0,0,0,,Pinahihirapan mo akong umalis.
Dialogue: 0,0:58:00.85,0:58:03.22,Default,,0,0,0,,Bakit mo ginagawa ito?
Dialogue: 0,1:00:18.23,1:00:20.21,Default,,0,0,0,,Huling gabi ko na dito.
Dialogue: 0,1:00:20.24,1:00:21.88,Default,,0,0,0,,Huwag bigyan ito ng anumang kahulugan.
Dialogue: 0,1:00:21.90,1:00:25.19,Default,,0,0,0,,Palagi kang magiging iyong sarili.
Dialogue: 0,1:00:27.08,1:00:29.01,Default,,0,0,0,,Gayunpaman,
Dialogue: 0,1:00:29.04,1:00:30.64,Default,,0,0,0,,ito na ang pagkakataon mo.
Dialogue: 0,1:00:30.66,1:00:32.95,Default,,0,0,0,,- Para saan?\N- Para maging malinis.
Dialogue: 0,1:00:33.33,1:00:35.89,Default,,0,0,0,,Kakalimutan ko ang lahat pagkatapos ng operasyon.
Dialogue: 0,1:00:35.92,1:00:37.83,Default,,0,0,0,,So?
Dialogue: 0,1:00:39.05,1:00:41.32,Default,,0,0,0,,Mga reklamo na mayroon ka.
Dialogue: 0,1:00:41.34,1:00:42.94,Default,,0,0,0,,Mga panahong nasaktan ka.
Dialogue: 0,1:00:42.97,1:00:44.65,Default,,0,0,0,,Mga bagay na hindi mo masabi sa akin.
Dialogue: 0,1:00:44.68,1:00:46.38,Default,,0,0,0,,Mga ganyang bagay.
Dialogue: 0,1:00:47.85,1:00:50.05,Default,,0,0,0,,Maaari kang maging tapat sa akin ngayon.
Dialogue: 0,1:00:54.19,1:00:55.76,Default,,0,0,0,,Kalimutan mo na ito.
Dialogue: 0,1:00:55.94,1:01:00.02,Default,,0,0,0,,Maraming beses na akong nahulog sa isang iyon.
Dialogue: 0,1:01:00.40,1:01:02.05,Default,,0,0,0,,Halika.
Dialogue: 0,1:01:02.07,1:01:04.23,Default,,0,0,0,,Kakalimutan ko pa rin sila.
Dialogue: 0,1:01:10.41,1:01:11.95,Default,,0,0,0,,Kalimutan ito.
Dialogue: 0,1:01:15.58,1:01:17.16,Default,,0,0,0,,Kaya...
Dialogue: 0,1:01:17.54,1:01:20.20,Default,,0,0,0,,mayroon kang ilang bagay.
Dialogue: 0,1:01:22.34,1:01:24.54,Default,,0,0,0,,Huwag mong subukang patawarin ako.
Dialogue: 0,1:01:28.26,1:01:29.99,Default,,0,0,0,,Ano ang kailangan mong mawala?
Dialogue: 0,1:01:30.01,1:01:33.55,Default,,0,0,0,,Malapit na akong operahan,\Nso ano ang pumipigil sa iyo?
Dialogue: 0,1:01:33.73,1:01:35.26,Default,,0,0,0,,Sabihin mo sa akin.
Dialogue: 0,1:01:36.69,1:01:38.22,Default,,0,0,0,,Ano?
Dialogue: 0,1:01:38.61,1:01:41.39,Default,,0,0,0,,- Wala?\N- Sinusubukan kong pumili.
Dialogue: 0,1:01:44.36,1:01:45.84,Default,,0,0,0,,Dapat marami.
Dialogue: 0,1:01:45.86,1:01:47.65,Default,,0,0,0,,Hindi talaga.
Dialogue: 0,1:01:55.96,1:01:57.81,Default,,0,0,0,,Sinasabi ko lang ito...
Dialogue: 0,1:01:57.83,1:02:00.24,Default,,0,0,0,,dahil sinabi mo sa akin.
Dialogue: 0,1:02:01.63,1:02:04.19,Default,,0,0,0,,Mahilig kang magbago...
Dialogue: 0,1:02:04.22,1:02:05.19,Default,,0,0,0,, madalas ang iyong isip.
Dialogue: 0,1:02:05.22,1:02:06.99,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,1:02:07.01,1:02:08.95,Default,,0,0,0,,Bibigyan kita ng halimbawa.
Dialogue: 0,1:02:08.97,1:02:11.53,Default,,0,0,0,,Gusto mong maalala ko ang ating anibersaryo,
Dialogue: 0,1:02:11.56,1:02:12.78,Default,,0,0,0,,kaya naghanda ako ng surpresa.
Dialogue: 0,1:02:12.81,1:02:15.41,Default,,0,0,0,,Tapos nagalit ka dito,
Dialogue: 0,1:02:15.44,1:02:17.78,Default,,0,0,0,,pero nagalit ka rin\Nnung wala akong pinaghandaan.
Dialogue: 0,1:02:17.81,1:02:19.87,Default,,0,0,0,,Lahat sa moderation.
Dialogue: 0,1:02:19.90,1:02:21.79,Default,,0,0,0,,Pero standard mo yan.
Dialogue: 0,1:02:21.82,1:02:25.21,Default,,0,0,0,,Hindi ko alam kung ano ang iniisip mo, kaya paano ko malalaman?
Dialogue: 0,1:02:25.24,1:02:27.67,Default,,0,0,0,,- Yan...\N- At saka, gusto kong marinig mo ako...
Dialogue: 0,1:02:27.70,1:02:30.13,Default,,0,0,0,,nang hindi nagagalit kapag kinakausap kita.
Dialogue: 0,1:02:30.16,1:02:31.89,Default,,0,0,0,,Magaling ako diyan.
Dialogue: 0,1:02:31.91,1:02:33.65,Default,,0,0,0,,Galit ka ngayon.
Dialogue: 0,1:02:34.87,1:02:36.39,Default,,0,0,0,,Hindi, nakikinig ako ng mabuti.
Dialogue: 0,1:02:36.41,1:02:38.10,Default,,0,0,0,,Palagi akong nakasimangot kapag nakikinig.
Dialogue: 0,1:02:38.12,1:02:39.18,Default,,0,0,0,,Gayundin...
Dialogue: 0,1:02:39.21,1:02:40.77,Default,,0,0,0,,Mayroon kang isang buong listahan.
Dialogue: 0,1:02:40.79,1:02:42.66,Default,,0,0,0,,Mahal kita.
Dialogue: 0,1:02:47.80,1:02:50.29,Default,,0,0,0,,- Ano?\N- Sabi ko mahal kita.
Dialogue: 0,1:02:52.93,1:02:56.30,Default,,0,0,0,,Sinabi mo sa akin na sabihin ang mga bagay na hindi ko masabi noon.
Dialogue: 0,1:02:59.19,1:03:00.85,Default,,0,0,0,,Sinabi ko nga.
Dialogue: 0,1:03:01.61,1:03:04.33,Default,,0,0,0,,Ituloy ang pagsasalita. Sabihin kung ano ang nasa isip mo.
Dialogue: 0,1:03:04.36,1:03:05.93,Default,,0,0,0,,Ituloy mo.
Dialogue: 0,1:03:11.07,1:03:12.94,Default,,0,0,0,,Salamat sa paggawa...
Dialogue: 0,1:03:13.24,1:03:15.36,Default,,0,0,0,,itong mahirap na desisyon.
Dialogue: 0,1:03:15.79,1:03:18.35,Default,,0,0,0,,Huwag magkasakit...
Dialogue: 0,1:03:18.37,1:03:20.23,Default,,0,0,0,,o nasaktan na.
Dialogue: 0,1:03:20.25,1:03:22.99,Default,,0,0,0,, Manatili sa akin magpakailanman.
Dialogue: 0,1:03:26.59,1:03:29.67,Default,,0,0,0,,Tayo na sa biyahe.
Dialogue: 0,1:03:29.76,1:03:31.32,Default,,0,0,0,,Maglakad lakad tayo.
Dialogue: 0,1:03:31.34,1:03:32.53,Default,,0,0,0,,Mag-ehersisyo tayo.
Dialogue: 0,1:03:32.55,1:03:34.88,Default,,0,0,0,,Magtalo tayo at magkaayos.
Dialogue: 0,1:03:35.10,1:03:37.93,Default,,0,0,0,,Gumawa tayo ng mga ordinaryong bagay,
Dialogue: 0,1:03:38.14,1:03:40.05,Default,,0,0,0,,at sabay na tumanda.
Dialogue: 0,1:03:45.19,1:03:47.02,Default,,0,0,0,,Napaka-unfair nito.
Dialogue: 0,1:03:47.61,1:03:50.65,Default,,0,0,0,,Kakalimutan ko rin lahat ng matatamis na salita na ito.
Dialogue: 0,1:03:51.61,1:03:53.05,Default,,0,0,0,,Okay lang.
Dialogue: 0,1:03:53.07,1:03:54.26,Default,,0,0,0,,Sasabihin ko silang muli.
Dialogue: 0,1:03:54.28,1:03:56.19,Default,,0,0,0,,Sasabihin ko sila araw-araw.
Dialogue: 0,1:03:59.29,1:04:00.82,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:04:11.22,1:04:12.75,Default,,0,0,0,,Well...
Dialogue: 0,1:04:13.18,1:04:16.88,Default,,0,0,0,,Isinulat ko lahat ng naiisip ko...
Dialogue: 0,1:04:17.06,1:04:18.74,Default,,0,0,0,,tungkol sa aking sarili,
Dialogue: 0,1:04:18.77,1:04:22.39,Default,,0,0,0,,ikaw, at ang buhay na nabuhay ko.
Dialogue: 0,1:04:22.69,1:04:24.79,Default,,0,0,0,,Sana magabayan ako nito...
Dialogue: 0,1:04:24.81,1:04:27.18,Default,,0,0,0,,sa susunod kong buhay,
Dialogue: 0,1:04:27.73,1:04:30.59,Default,,0,0,0,,pero makakalimutan kong meron ako nito,
Dialogue: 0,1:04:30.61,1:04:33.05,Default,,0,0,0,,kaya panatilihin ito...
Dialogue: 0,1:04:33.07,1:04:34.86,Default,,0,0,0,,at ibigay ito sa akin.
Dialogue: 0,1:04:38.37,1:04:39.81,Default,,0,0,0,,Nga pala,
Dialogue: 0,1:04:39.83,1:04:41.93,Default,,0,0,0,,kailan mo ito isinulat?
Dialogue: 0,1:04:41.96,1:04:44.27,Default,,0,0,0,,- Wag mo munang basahin.\N- Okay.
Dialogue: 0,1:04:44.29,1:04:46.66,Default,,0,0,0,,Mababasa mo ito...
Dialogue: 0,1:04:46.84,1:04:50.08,Default,,0,0,0,,habang hinihintay mo akong magising...
Dialogue: 0,1:04:50.26,1:04:51.79,Default,,0,0,0,,pagkatapos ng operasyon.
Dialogue: 0,1:04:53.38,1:04:54.40,Default,,0,0,0,,Okay.
Dialogue: 0,1:04:54.43,1:04:58.05,Default,,0,0,0,,Huwag baguhin ang anuman. Huwag mong gawing mas maganda ang iyong sarili.
Dialogue: 0,1:04:58.51,1:05:00.05,Default,,0,0,0,,Sige.
Dialogue: 0,1:05:03.02,1:05:05.10,Default,,0,0,0,,Halika rito.
Dialogue: 0,1:05:47.48,1:05:48.75,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:05:48.77,1:05:52.64,Default,,0,0,0,,Ang operasyon ba ay 10 a.m. sa Germany?
Dialogue: 0,1:05:53.36,1:05:55.84,Default,,0,0,0,,Nasa sampung minuto. Kabutihan.
Dialogue: 0,1:05:55.86,1:05:58.48,Default,,0,0,0,,Magiging maayos siya. Huwag kang mag-alala.
Dialogue: 0,1:05:58.95,1:06:00.89,Default,,0,0,0,,Okay. Itigil ang pag-alog ng iyong binti.
Dialogue: 0,1:06:00.91,1:06:02.44,Default,,0,0,0,,Okay.
Dialogue: 0,1:06:06.79,1:06:08.33,Default,,0,0,0,,Honey.
Dialogue: 0,1:06:08.83,1:06:10.95,Default,,0,0,0,,Paengsun...
Dialogue: 0,1:06:11.00,1:06:13.12,Default,,0,0,0,,- ay buhay.\N- Ano?
Dialogue: 0,1:06:13.21,1:06:15.40,Default,,0,0,0,,Talaga? Ang kuhol na walang shell?
Dialogue: 0,1:06:15.42,1:06:17.63,Default,,0,0,0,,Hindi ba siya namamatay?
Dialogue: 0,1:06:18.47,1:06:20.13,Default,,0,0,0,,Isa itong himala.
Dialogue: 0,1:06:20.81,1:06:22.51,Default,,0,0,0,,Ito ay.
Dialogue: 0,1:06:23.93,1:06:26.89,Default,,0,0,0,,Gosh, Seon-hwa. Ito ay isang magandang senyales.
Dialogue: 0,1:06:27.98,1:06:28.96,Default,,0,0,0,,Sa tingin mo ba?
Dialogue: 0,1:06:28.98,1:06:30.46,Default,,0,0,0,,Oo.
Dialogue: 0,1:06:30.48,1:06:32.02,Default,,0,0,0,,Siyempre.
Dialogue: 0,1:06:32.98,1:06:35.81,Default,,0,0,0,,Magiging maayos ang operasyon ni Hae-in.
Dialogue: 0,1:06:46.46,1:06:48.49,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:06:53.25,1:06:55.54,Default,,0,0,0,,Wala kang pupuntahan, di ba?
Dialogue: 0,1:06:55.88,1:06:57.03,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,1:06:57.05,1:07:00.38,Default,,0,0,0,,Kailangan andito ka pagdilat ko.
Dialogue: 0,1:07:00.55,1:07:02.32,Default,,0,0,0,,Parang imprinting.
Dialogue: 0,1:07:02.35,1:07:05.28,Default,,0,0,0,,Magiging parang bagong pisa akong pato.
Dialogue: 0,1:07:05.31,1:07:07.72,Default,,0,0,0,,Magtitiwala ako kung sino man ang una kong makita.
Dialogue: 0,1:07:09.77,1:07:11.47,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,1:07:11.52,1:07:15.13,Default,,0,0,0,,Mananatili ako sa iyo mula sa\Nsa sandaling imulat mo ang iyong mga mata...
Dialogue: 0,1:07:15.15,1:07:16.42,Default,,0,0,0,,hanggang sa magkasakit ka sa akin.
Dialogue: 0,1:07:16.44,1:07:21.61,Default,,0,0,0,,Paano kung wala akong maalala\Nanything o makilala ka?
Dialogue: 0,1:07:21.70,1:07:24.53,Default,,0,0,0,,Paano kung minamaltrato kita?
Dialogue: 0,1:07:27.16,1:07:29.95,Default,,0,0,0,,Hindi ito ang aking unang rodeo.
Dialogue: 0,1:07:31.00,1:07:33.23,Default,,0,0,0,,Hindi na iyon mahalaga.
Dialogue: 0,1:07:33.25,1:07:36.00,Default,,0,0,0,,Ipaopera na lang...
Dialogue: 0,1:07:36.55,1:07:38.08,Default,,0,0,0,,at bumalik.
Dialogue: 0,1:07:39.43,1:07:41.86,Default,,0,0,0,,Siguraduhing babalik ka.
Dialogue: 0,1:07:41.89,1:07:43.88,Default,,0,0,0,,Babalik ako.
Dialogue: 0,1:07:44.31,1:07:46.21,Default,,0,0,0,,Alagaan mo ako...
Dialogue: 0,1:07:46.56,1:07:48.34,Default,,0,0,0,,pagbalik ko.
Dialogue: 0,1:07:50.94,1:07:52.80,Default,,0,0,0,,Babalik ako.
Dialogue: 0,1:09:20.32,1:09:21.59,Default,,0,0,0,,{\i1}{\c&HFFFF&}Hae-in Hong\NIn Surgery{\c}{\i0}
Dialogue: 0,1:09:21.61,1:09:22.78,Default,,0,0,0,,{\i1}{\c&HFFFF&}In Recovery{\c}{\i0}
Dialogue: 0,1:09:35.83,1:09:37.53,Default,,0,0,0,,Mr. Baek Hyun-woo?
Dialogue: 0,1:09:40.96,1:09:42.52,Default,,0,0,0,,Sino ka?
Dialogue: 0,1:09:42.55,1:09:45.94,Default,,0,0,0,,Ako si Detective Kang Min-wook\Nmula sa German police force.
Dialogue: 0,1:09:45.97,1:09:47.45,Default,,0,0,0,,Tungkol saan ito?
Dialogue: 0,1:09:47.47,1:09:50.84,Default,,0,0,0,,Naaresto ka dahil sa\Npagpatay kay Mr. Pyeon Seong-uk.
Dialogue: 0,1:09:51.93,1:09:54.04,Default,,0,0,0,,Ano ang ibig mong sabihin? Ako ay isang suspek sa pagpatay?
Dialogue: 0,1:09:54.06,1:09:56.96,Default,,0,0,0,,May karapatan kang manatiling\Ntahimik at kumuha ng abogado.
Dialogue: 0,1:09:56.98,1:10:00.81,Default,,0,0,0,,Maaari ka ring magsampa ng reklamo\Kung sa tingin mo ay hindi makatarungan ang pag-arestong ito.
Dialogue: 0,1:10:02.07,1:10:03.04,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:10:03.07,1:10:04.92,Default,,0,0,0,,Ito ay isang hindi pagkakaunawaan.
Dialogue: 0,1:10:04.95,1:10:05.96,Default,,0,0,0,,Bigyan mo ako ng oras.
Dialogue: 0,1:10:05.99,1:10:07.38,Default,,0,0,0,,Pwede tayong mag-usap sa istasyon.
Dialogue: 0,1:10:07.41,1:10:08.94,Default,,0,0,0,,Tara na.
Dialogue: 0,1:10:10.49,1:10:11.80,Default,,0,0,0,,Teka!
Dialogue: 0,1:10:11.83,1:10:13.72,Default,,0,0,0,,Inoperahan ang asawa ko.
Dialogue: 0,1:10:13.75,1:10:15.36,Default,,0,0,0,,Kailangan nandoon ako kapag nagising siya.
Dialogue: 0,1:10:15.38,1:10:17.23,Default,,0,0,0,,Bigyan mo lang ako ng kalahating oras.
Dialogue: 0,1:10:17.25,1:10:19.39,Default,,0,0,0,,Nangakong nandoon ako!
Dialogue: 0,1:10:19.42,1:10:21.75,Default,,0,0,0,,Dapat nandoon ako!
Dialogue: 0,1:10:33.64,1:10:35.58,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,1:10:35.60,1:10:38.12,Default,,0,0,0,,Ako ang magiging tagapag-alaga niya.
Dialogue: 0,1:10:38.15,1:10:39.85,Default,,0,0,0,,Ito ba ang iyong scheme?
Dialogue: 0,1:10:40.19,1:10:41.58,Default,,0,0,0,,Anong scheme?
Dialogue: 0,1:10:41.61,1:10:43.18,Default,,0,0,0,,Pinoprotektahan ko lang...
Dialogue: 0,1:10:43.65,1:10:46.23,Default,,0,0,0,,ang babae ko mula sa isang kriminal.
Dialogue: 0,1:10:56.91,1:10:58.45,Default,,0,0,0,,Hae...
Dialogue: 0,1:10:59.17,1:11:00.14,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:11:00.17,1:11:02.94,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:11:02.96,1:11:04.02,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:11:04.05,1:11:06.71,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:11:08.18,1:11:11.34,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:11:13.06,1:11:14.92,Default,,0,0,0,,Hae...
Dialogue: 0,1:11:16.35,1:11:18.01,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:11:22.90,1:11:24.47,Default,,0,0,0,,{\i1}Hae-in.{\i0}
Dialogue: 0,1:11:28.28,1:11:31.39,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek, ang dating direktor ng legal team ng Queens,{\c}{\i0}
Dialogue: 0,1:11:31.42,1:11:33.03,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- ay inaresto sa Frankfurt...{\c}{\i0}\N- Nanay.
Dialogue: 0,1:11:33.05,1:11:35.57,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}bilang pangunahing suspek sa\Nreservoir murder na naganap...{\c}{\i0}
Dialogue: 0,1:11:35.60,1:11:38.06,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}sa Sambang, Yeongjin-gun,\NGyeonggi Province noong nakaraang buwan.{\c}{\i0}
Dialogue: 0,1:11:38.08,1:11:41.69,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Nagsanib pwersa ang pulis\Nsa Interpol para arestuhin siya,{\c}{\i0}
Dialogue: 0,1:11:41.71,1:11:43.45,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}at planong humiling ng warrant of arrest...{\c}{\i0}
Dialogue: 0,1:11:43.47,1:11:45.40,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}para sa pagpatay sa sandaling dalhin siya sa Korea.{\c}{\i0}
Dialogue: 0,1:11:45.42,1:11:50.15,Default,,0,0,0,,Maghintay. Kung naaresto si Hyun-woo,\Nsino ang kasama ni Hae-in ngayon?
Dialogue: 0,1:11:50.18,1:11:52.25,Default,,0,0,0,,Ano?
Dialogue: 0,1:11:55.01,1:11:57.92,Default,,0,0,0,,Nasaan ang number na binigay niya?
Dialogue: 0,1:11:58.27,1:11:59.84,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:11:59.94,1:12:01.62,Default,,0,0,0,,Beom-jun, dito.
Dialogue: 0,1:12:01.65,1:12:02.62,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}German Hospital{\c}{\i0}
Dialogue: 0,1:12:03.77,1:12:05.43,Default,,0,0,0,,Eto na.
Dialogue: 0,1:12:12.03,1:12:14.98,Default,,0,0,0,,Sinabi sa akin ng ospital na tumawag ka.
Dialogue: 0,1:12:15.03,1:12:17.30,Default,,0,0,0,,Huwag mag-alala. kasama ko siya.
Dialogue: 0,1:12:17.33,1:12:18.81,Default,,0,0,0,,Naging maayos ang operasyon,
Dialogue: 0,1:12:18.83,1:12:20.60,Default,,0,0,0,,at malapit na siyang gumaling.
Dialogue: 0,1:12:20.62,1:12:22.98,Default,,0,0,0,,Malapit na tayo.
Dialogue: 0,1:12:23.00,1:12:24.52,Default,,0,0,0,,{\i1}Tama.{\i0}
Dialogue: 0,1:12:24.54,1:12:26.91,Default,,0,0,0,,- Sa tingin ko ay hindi.\N- {\i1}Ano?{\i0}
Dialogue: 0,1:12:27.30,1:12:28.27,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,1:12:28.30,1:12:30.19,Default,,0,0,0,,{\i1}Hindi mo yata narinig.{\i0}
Dialogue: 0,1:12:30.22,1:12:32.74,Default,,0,0,0,,Gusto kong maghintay bilang paggalang...
Dialogue: 0,1:12:32.76,1:12:34.90,Default,,0,0,0,,hanggang sa natapos ang libing ni Chairman Hong,
Dialogue: 0,1:12:34.93,1:12:36.61,Default,,0,0,0,,pero hindi ako pumikit...
Dialogue: 0,1:12:36.64,1:12:39.37,Default,,0,0,0,,{\i1}sa iyong paglustay at malpractice.{\i0}
Dialogue: 0,1:12:39.39,1:12:41.65,Default,,0,0,0,,{\i1}Magsisimula na ang prosekusyon\Nkanilang imbestigasyon,{\i0}
Dialogue: 0,1:12:41.68,1:12:43.23,Default,,0,0,0,,para hindi ka makaalis.
Dialogue: 0,1:12:43.25,1:12:44.25,Default,,0,0,0,,Ang kulit mo!
Dialogue: 0,1:12:44.27,1:12:46.62,Default,,0,0,0,,Ako na ang bahala kay Hae-in at babalik sa Korea,
Dialogue: 0,1:12:46.65,1:12:48.18,Default,,0,0,0,,kaya...
Dialogue: 0,1:12:49.90,1:12:51.81,Default,,0,0,0,,leave her to me.
Dialogue: 0,1:13:02.83,1:13:04.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ito ay talagang higit pa...{\c}{\i0}
Dialogue: 0,1:13:04.38,1:13:06.08,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ng isang kahilingan.{\c}{\i0}
Dialogue: 0,1:13:07.92,1:13:11.04,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Isang pag-withdraw sa diborsyo.{\c}{\i0}
Dialogue: 0,1:13:17.18,1:13:19.67,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magandang date iyon. Oktubre 31.{\c}{\i0}
Dialogue: 0,1:13:30.03,1:13:31.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mula sa uniberso...{\c}{\i0}
Dialogue: 0,1:13:31.90,1:13:33.46,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ay nasa panig namin...{\c}{\i0}
Dialogue: 0,1:13:33.49,1:13:35.02,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gusto mo ba...{\c}{\i0}
Dialogue: 0,1:13:36.95,1:13:38.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pakasalan mo ako?{\c}{\i0}
Dialogue: 0,1:13:48.84,1:13:51.94,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mananatili ka sa akin?{\c}{\i0}
Dialogue: 0,1:13:51.96,1:13:53.54,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Oo.{\c}{\i0}
Dialogue: 0,1:13:54.01,1:13:55.75,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pupunta ako diyan...{\c}{\i0}
Dialogue: 0,1:13:55.88,1:13:57.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}para sa iyo.{\c}{\i0}
Dialogue: 0,1:14:03.02,1:14:04.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Minamahal na Hae-in mula sa hinaharap.{\c}{\i0}
Dialogue: 0,1:14:04.73,1:14:06.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ko na tatanungin kung kumusta ka, dahil alam ko...{\c}{\i0}
Dialogue: 0,1:14:06.73,1:14:07.91,Default,,0,0,0,,{\i1}{\c&HFFFF00&}magaling ka.{\c}{\i0}
Dialogue: 0,1:14:07.94,1:14:10.54,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magiging maganda ka, malusog,{\c}{\i0}
Dialogue: 0,1:14:10.57,1:14:13.27,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at ang pinakamatagumpay.{\c}{\i0}
Dialogue: 0,1:14:13.32,1:14:14.89,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kasama si Hyun-woo...{\c}{\i0}
Dialogue: 0,1:14:15.20,1:14:17.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}nananatili sa iyo, siyempre.{\c}{\i0}
Dialogue: 0,1:15:07.37,1:15:09.20,Default,,0,0,0,,Gising ka na ba sa wakas?
Dialogue: 0,1:15:15.26,1:15:18.25,Default,,0,0,0,,Huwag. Maubos mo ang sarili mo. Hayaan mo akong magsalita.
Dialogue: 0,1:15:19.64,1:15:22.70,Default,,0,0,0,,Malamang nalilito ka\Nand hindi alam kung sino ka.
Dialogue: 0,1:15:22.72,1:15:24.07,Default,,0,0,0,,Normal lang.
Dialogue: 0,1:15:24.10,1:15:26.95,Default,,0,0,0,,Kakagising mo lang mula sa isang major surgery.
Dialogue: 0,1:15:26.98,1:15:30.79,Default,,0,0,0,,Naalis ang isang tumor sa iyong utak.
Dialogue: 0,1:15:30.81,1:15:33.00,Default,,0,0,0,,Kaya hindi mo maalala.
Dialogue: 0,1:15:33.02,1:15:35.42,Default,,0,0,0,,Humingi ka sa akin ng pabor bago ang operasyon.
Dialogue: 0,1:15:35.44,1:15:38.05,Default,,0,0,0,,You asked me to be here pagkagising mo.
Dialogue: 0,1:15:38.07,1:15:41.40,Default,,0,0,0,,Kaya nanatili ako rito sa buong oras.
Dialogue: 0,1:15:43.66,1:15:45.19,Default,,0,0,0,,Baek Hyun-woo?
Dialogue: 0,1:16:27.62,1:16:29.15,Default,,0,0,0,,Ano ito?
Dialogue: 0,1:16:29.66,1:16:31.18,Default,,0,0,0,,Naaalala mo ba ang pangalang iyon?
Dialogue: 0,1:16:31.21,1:16:33.70,Default,,0,0,0,,Iyon lang ang natatandaan kong pangalan.
Dialogue: 0,1:16:35.79,1:16:37.62,Default,,0,0,0,,Hindi ako siya.
Dialogue: 0,1:16:39.67,1:16:41.19,Default,,0,0,0,,Ikaw si Hong Hae-in.
Dialogue: 0,1:16:41.22,1:16:43.33,Default,,0,0,0,,Ako si Yoon Eun-sung.
Dialogue: 0,1:16:46.35,1:16:48.58,Default,,0,0,0,,Nagsimula kaming magdate noong college.
Dialogue: 0,1:16:48.60,1:16:52.01,Default,,0,0,0,,Naghiwalay kami ng landas, pero mahal pa rin namin ang isa't isa.
Dialogue: 0,1:16:53.10,1:16:54.54,Default,,0,0,0,,Baek Hyun-woo...
Dialogue: 0,1:16:54.56,1:16:56.56,Default,,0,0,0,,ay ang iyong dating asawa.
Dialogue: 0,1:16:56.73,1:16:58.27,Default,,0,0,0,,Ako ay...
Dialogue: 0,1:16:58.82,1:17:00.60,Default,,0,0,0,,may asawa?
Dialogue: 0,1:17:01.74,1:17:04.76,Default,,0,0,0,,Ayokong maalarma ka\Nkagising mo lang,
Dialogue: 0,1:17:04.78,1:17:07.51,Default,,0,0,0,,pero lubusan ka niyang niloko.
Dialogue: 0,1:17:07.53,1:17:09.60,Default,,0,0,0,,Kaya mo siya hiniwalayan.
Dialogue: 0,1:17:09.62,1:17:11.90,Default,,0,0,0,,Nakipagdivorce ako?
Dialogue: 0,1:17:12.75,1:17:15.44,Default,,0,0,0,,Sina-stalk ka niya hanggang kamakailan lang,
Dialogue: 0,1:17:15.46,1:17:19.62,Default,,0,0,0,,pero inaresto siya ng\NInterpol bilang suspek sa pagpatay.
Dialogue: 0,1:17:20.67,1:17:23.29,Default,,0,0,0,,Dapat nagulat ka. pasensya na po.
Dialogue: 0,1:17:23.43,1:17:26.36,Default,,0,0,0,,Malamang naaalala mo ang pangalan niya...
Dialogue: 0,1:17:26.39,1:17:29.38,Default,,0,0,0,,dahil sa labis na paghihirap mo.
Dialogue: 0,1:17:29.81,1:17:31.51,Default,,0,0,0,,Kaya siguro.
Dialogue: 0,1:17:32.48,1:17:35.20,Default,,0,0,0,,Huwag mag-isip ng kahit ano at magpahinga ka lang.
Dialogue: 0,1:17:35.23,1:17:37.47,Default,,0,0,0,,Dadalhin ko ang doktor.
Dialogue: 0,1:18:22.78,1:18:24.92,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ko akalain na makikita ko ulit ang taglamig,{\c}{\i0}
Dialogue: 0,1:18:24.95,1:18:27.84,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pabayaan ang unang snow,{\c}{\i0}
Dialogue: 0,1:18:27.86,1:18:30.22,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero posible na ngayon.{\c}{\i0}
Dialogue: 0,1:18:30.24,1:18:31.78,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Siyempre.{\c}{\i0}
Dialogue: 0,1:18:32.20,1:18:36.41,Default,,0,0,0,,{\i1}{\c&HFFFF00&}At magkakatotoo ito kung mananatili pa rin ang\Nkulay noon.{\c}{\i0}
Dialogue: 0,1:18:37.67,1:18:39.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ano ang magkakatotoo?{\c}{\i0}
Dialogue: 0,1:18:39.67,1:18:41.45,Default,,0,0,0,,{\i1}{\c&HFFFF00&}My first love.{\c}{\i0}
Dialogue: 0,1:18:56.35,1:18:58.80,Default,,0,0,0,,Dapat gising na siya ngayon.
Dialogue: 0,1:19:56.16,1:19:57.90,Default,,0,0,0,,Umuulan ng niyebe.
Dialogue: 0,1:20:11.68,1:20:13.54,Default,,0,0,0,,Ito ba ang unang snow?
Dialogue: 0,1:20:44.96,1:20:46.66,Default,,0,0,0,,Ano ang mali sa akin?
Dialogue: 0,1:20:47.46,1:20:49.16,Default,,0,0,0,,Ano?
Dialogue: 0,1:21:00.35,1:21:02.43,Default,,0,0,0,,Sobrang sakit.
Dialogue: 0,1:21:46.48,1:21:51.18,Default,,0,0,0,,Kinakwento mo sa akin yung mga\Ndays mo sa law school.
Dialogue: 0,1:21:52.86,1:21:53.96,Default,,0,0,0,,Oo?
Dialogue: 0,1:21:53.99,1:21:56.97,Default,,0,0,0,,Palagi mong ipinagyayabang ang iyong magandang alaala.
Dialogue: 0,1:21:56.99,1:21:58.69,Default,,0,0,0,,At?
Dialogue: 0,1:21:58.95,1:22:02.28,Default,,0,0,0,,Ano ang sikreto mo sa pagsasaulo ng mabuti?
Dialogue: 0,1:22:03.25,1:22:05.02,Default,,0,0,0,,Hindi ako sigurado.
Dialogue: 0,1:22:05.04,1:22:07.53,Default,,0,0,0,,Madali kong naalala...
Dialogue: 0,1:22:07.83,1:22:10.87,Default,,0,0,0,,kahit anong tiningnan ko.
Dialogue: 0,1:22:11.00,1:22:12.83,Default,,0,0,0,,Seryoso ako.
Dialogue: 0,1:22:13.38,1:22:16.75,Default,,0,0,0,,Nilamon mo ba ang\Npages pagkatapos mong isaulo ang mga ito?
Dialogue: 0,1:22:17.97,1:22:19.50,Default,,0,0,0,,Hindi ako kambing.
Dialogue: 0,1:22:20.39,1:22:22.09,Default,,0,0,0,,Well...
Dialogue: 0,1:22:22.27,1:22:24.59,Default,,0,0,0,,Hindi ko kabisado lahat,
Dialogue: 0,1:22:24.89,1:22:27.20,Default,,0,0,0,,kaya paulit-ulit akong bumulong...
Dialogue: 0,1:22:27.23,1:22:30.00,Default,,0,0,0,,ang mahahalagang bahagi.
Dialogue: 0,1:22:30.02,1:22:31.93,Default,,0,0,0,,Tapos naalala ko...
Dialogue: 0,1:22:32.28,1:22:33.71,Default,,0,0,0,,boses ko sa panahon ng pagsubok.
Dialogue: 0,1:22:33.74,1:22:35.90,Default,,0,0,0,,Naalala ito ng subconscious ko.
Dialogue: 0,1:22:38.28,1:22:39.98,Default,,0,0,0,,Bakit mo natanong?
Dialogue: 0,1:22:41.33,1:22:42.86,Default,,0,0,0,,Walang dahilan.
Dialogue: 0,1:22:46.21,1:22:47.91,Default,,0,0,0,,Sleep.
Dialogue: 0,1:23:28.62,1:23:30.45,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:32.38,1:23:34.41,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:35.34,1:23:37.33,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:40.43,1:23:42.13,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:43.81,1:23:45.28,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:45.31,1:23:48.05,Default,,0,0,0,,Huwag kalimutan ang pangalang iyon.
Dialogue: 0,1:23:50.85,1:23:52.72,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:56.23,1:23:58.23,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:23:59.32,1:24:01.23,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,1:24:09.29,1:24:12.13,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,1:24:42.70,1:24:44.88,Default,,0,0,0,,{\an8}{\i1}Labis akong nag-aalala.{\i0}
Dialogue: 0,1:24:44.91,1:24:48.11,Default,,0,0,0,,{\an8}{\i1}Pananatilihin kitang ligtas.{\i0}
Dialogue: 0,1:24:48.29,1:24:50.77,Default,,0,0,0,,{\an8}{\i1}Namuhay ako nang malungkot.{\i0}
Dialogue: 0,1:24:50.79,1:24:53.31,Default,,0,0,0,,{\an8}{\i1}Sinundan nila si Hae-in sa\NGermany at pinanatiling updated ako.{\i0}
Dialogue: 0,1:24:53.33,1:24:55.94,Default,,0,0,0,,{\an8}{\i1}Pakitingnan ang mga dashcam ng bus\Nasa oras ng pagpatay.{\i0}
Dialogue: 0,1:24:55.97,1:24:57.82,Default,,0,0,0,,{\an8}{\i1}- Eksakto!\N- Aalis ako, kahit anong mangyari.{\i0}
Dialogue: 0,1:24:57.84,1:24:59.44,Default,,0,0,0,,{\an8}{\i1}Hayaan mo na si Da-hye!{\i0}
Dialogue: 0,1:24:59.46,1:25:02.86,Default,,0,0,0,,{\an8}{\i1}Ito ay magpapatunay na si Eun-sung at ang kanyang mga tauhan\Nnagsagawa ng $2 bilyong pandaraya sa pamumuhunan.{\i0}
Dialogue: 0,1:25:02.88,1:25:05.45,Default,,0,0,0,,{\an8}{\i1}Tumibok ang puso ko.{\i0}
Dialogue: 0,1:25:05.47,1:25:07.03,Default,,0,0,0,,{\an8}{\i1}Siya ang tao...{\i0}
Dialogue: 0,1:25:07.06,1:25:09.08,Default,,0,0,0,,{\an8}{\i1}- Gusto kong maalala magpakailanman.\N- Hae-in!{\i0}
Dialogue: 0,1:25:09.10,1:25:10.20,Default,,0,0,0,,{\an8}{\i1}Magkikita tayong muli,{\i0}
Dialogue: 0,1:25:10.23,1:25:13.47,Default,,0,0,0,,{\an8}{\i1}kasi hindi ako susuko. Mananatili ako sa iyo.{\i0}
