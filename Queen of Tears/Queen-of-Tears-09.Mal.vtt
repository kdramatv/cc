Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.06,0:01:06.23, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Di mana wangnya? Kami\Nmenuntut pampasan tanah kami!{\c}{\i0}
Dialog: 0,0:01:28.58,0:01:29.56, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:01:29.58,0:01:32.15, Lalai,,0,0,0,,Mengapa mereka bertindak\Npadahal kita yang menjadi mangsa di sini?
Dialog: 0,0:01:32.17,0:01:33.86, Lalai,,0,0,0,,Pampasan tanah?
Dialog: 0,0:01:33.88,0:01:36.34, Lalai,,0,0,0,,Semua huru-hara akan hilang jika kita pulang.
Dialog: 0,0:01:36.37,0:01:37.36,Lalai,,0,0,0,,Jom balik.
Dialog: 0,0:01:37.38,0:01:40.15, Lalai,,0,0,0,,Di mana kita boleh pergi, jika bukan di rumah?
Dialog: 0,0:01:40.18,0:01:42.63, Lalai,,0,0,0,,Kami tidak boleh pergi ke hotel.
Dialog: 0,0:01:46.23,0:01:47.50, Lalai,,0,0,0,,Hei, Grace.
Dialog: 0,0:01:47.52,0:01:52.10, Lalai,,0,0,0,,Puan, pintu pagar belakang adalah\Nempty. Anda boleh datang dengan cara ini.
Dialog: 0,0:01:52.40,0:01:55.35, Lalai,,0,0,0,,Anda memang terbaik. Okay.
Dialog: 0,0:01:55.78,0:01:58.27, Lalai,,0,0,0,, Putar ke belakang. Ambil pagar belakang.
Dialog: 0,0:02:04.04,0:02:05.78, Lalai,,0,0,0,,Jadi? Adakah mereka datang?
Dialog: 0,0:02:06.12,0:02:07.31, Lalai,,0,0,0,,Mari lihat apa yang boleh anda lakukan.
Dialog: 0,0:02:07.33,0:02:11.12, Lalai,,0,0,0,,"Sebuah keluarga konglomerat menjadi\Ndatang-miskin dan ditendang keluar."
Dialog: 0,0:02:12.79,0:02:14.75, Lalai,,0,0,0,,Ini dia datang!
Dialog: 0,0:02:20.22,0:02:22.20, Lalai,,0,0,0,,Apa yang kamu lakukan? Buka pintu pagar.
Dialog: 0,0:02:22.22,0:02:26.22,Lalai,,0,0,0,,Puan, anda perlu keluar sebentar.
Dialog: 0,0:02:31.44,0:02:33.83, Lalai,,0,0,0,,Apakah itu? saya penat.
Dialog: 0,0:02:33.86,0:02:37.21,Lalai,,0,0,0,,Adakah anda sedar bahawa Pengerusi Hong\Ngave Cik Moh adalah surat kuasa...
Dialog: 0,0:02:37.24,0:02:41.17, Lalai,,0,0,0,,untuk menguruskan segala-galanya di Queens Town...
Dialog: 0,0:02:41.20,0:02:44.32, Lalai,,0,0,0,,semasa ketiadaannya?
Dialog: 0,0:02:44.41,0:02:45.59,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:02:45.62,0:02:48.26, Lalai,,0,0,0,,Adakah dia menghalau kita?
Dialog: 0,0:02:48.29,0:02:50.56, Lalai,,0,0,0,,Tidak juga.
Dialog: 0,0:02:50.58,0:02:52.98, Lalai,,0,0,0,,Memandangkan tempat ini berkerumun...
Dialog: 0,0:02:53.00,0:02:54.77,Lalai,,0,0,0,,dengan pemberita dan penunjuk perasaan,
Dialog: 0,0:02:54.79,0:02:59.11,Lalai,,0,0,0,,dia mahu anda baring rendah sehingga habuk mendap.
Dialog: 0,0:02:59.13,0:03:02.65, Lalai,,0,0,0,,Adakah dia berhak melakukan\Nitu? Kami semua penduduk di sini.
Dialog: 0,0:03:02.68,0:03:04.38, Lalai,,0,0,0,,Diam, boleh?
Dialog: 0,0:03:04.85,0:03:07.41, Lalai,,0,0,0,,Jangan terlibat apabila orang dewasa bercakap.
Dialog: 0,0:03:07.43,0:03:09.66, Lalai,,0,0,0,,Apa yang awak cakap tadi?
Dialog: 0,0:03:09.68,0:03:12.00, Lalai,,0,0,0,, Sial.
Dialog: 0,0:03:12.02,0:03:15.10,Lalai,,0,0,0,,Anda tidak faham, bukan?
Dialog: 0,0:03:20.45,0:03:23.06, Lalai,,0,0,0,,Tunggu. Hei.
Dialog: 0,0:03:23.53,0:03:25.09,Lalai,,0,0,0,,Kenderaan syarikat, pemandu,
Dialog: 0,0:03:25.12,0:03:28.49, Lalai,,0,0,0,,telefon dan kad kredit bukan lagi milik anda.
Dialog: 0,0:03:28.79,0:03:31.56, Lalai,,0,0,0,,Kad keselamatan syarikat anda\Kad kunci Nand juga tidak akan berfungsi.
Dialog: 0,0:03:31.58,0:03:33.93, Lalai,,0,0,0,,Apa maksud anda? Ini rumah saya!
Dialog: 0,0:03:33.96,0:03:35.90, Lalai,,0,0,0,,Hubungi polis, Sayang!
Dialog: 0,0:03:35.92,0:03:37.44, Lalai,,0,0,0,, Pasti, hubungi mereka.
Dialog: 0,0:03:37.46,0:03:39.15, Lalai,,0,0,0,,Pemberita pasti menyukainya.
Dialog: 0,0:03:39.17,0:03:41.67,Lalai,,0,0,0,,{\an8}Memandangkan sejarah kita bersama,
Dialog: 0,0:03:42.18,0:03:44.59, Lalai,,0,0,0,,Saya telah mengemas beberapa keperluan untuk anda,
Dialog: 0,0:03:44.64,0:03:46.67, Lalai,,0,0,0,, jadi teruskan.
Dialog: 0,0:03:54.65,0:03:57.43, Lalai,,0,0,0,,- Apa itu?\N- Sial.
Dialog: 0,0:03:58.23,0:04:00.68, Lalai,,0,0,0,,Masuk! Terdapat kamera di sebelah sana!
Dialog: 0,0:04:08.79,0:04:10.25,Lalai,,0,0,0,,{\an8}Bukankah ini tidak masuk akal, Hyun-woo?
Dialog: 0,0:04:10.27,0:04:11.31, Lalai,,0,0,0,,{\an8}Bagaimana Seul-hee...
Dialog: 0,0:04:11.33,0:04:13.39,Lalai,,0,0,0,,{\an8}kunci pintu dan tendang kami keluar...
Dialog: 0,0:04:13.41,0:04:14.68,Lalai,,0,0,0,,{\an8}rumah ayah kita?
Dialog: 0,0:04:14.71,0:04:17.35,Lalai,,0,0,0,,{\an8}Anda boleh menegaskan hak anda\Nas penghuni rumah,
Dialog: 0,0:04:17.38,0:04:19.98,Lalai,,0,0,0,,{\an8}tetapi anda mesti memfailkan tuntutan mahkamah,
Dialog: 0,0:04:20.00,0:04:22.25,Lalai,,0,0,0,,{\an8}dan ia akan mengambil sedikit masa,
Dialog: 0,0:04:22.30,0:04:23.65, Lalai,,0,0,0,,{\an8}tetapi isu terbesar ialah,
Dialog: 0,0:04:23.68,0:04:26.55,Lalai,,0,0,0,,{\an8}pengerusi memasukkan klausa boleh tukar\Nrights dalam kontrak,
Dialog: 0,0:04:26.57,0:04:29.11,Lalai,,0,0,0,,{\an8}dan meletakkan keluarganya sebagai penjamin bersama,
Dialog: 0,0:04:29.14,0:04:31.99, Lalai,,0,0,0,,{\an8}jadi hartanah, saham,\Nand akaun bank peribadi anda...
Dialog: 0,0:04:32.02,0:04:33.72, Lalai,,0,0,0,,{\an8}semuanya dibekukan.
Dialog: 0,0:04:34.27,0:04:36.85, Lalai,,0,0,0,,{\an8}Aduh, Ayah.
Dialog: 0,0:04:37.27,0:04:40.56, Lalai,,0,0,0,,{\an8}Tunggu. Adakah ini benar, Sayang?
Dialog: 0,0:04:41.07,0:04:43.77,Lalai,,0,0,0,,{\an8}Saya pun tidak tahu. Aku pun bengang.
Dialog: 0,0:04:44.20,0:04:45.21,Lalai,,0,0,0,,{\an8}Pelembap bibir, sesiapa?
Dialog: 0,0:04:45.24,0:04:48.22, Lalai,,0,0,0,, Balsem bibir, kaki saya.
Dialog: 0,0:04:48.24,0:04:52.55, Lalai,,0,0,0,,Sebaik-baiknya media\Ntidak menyiarkan foto anda.
Dialog: 0,0:04:52.58,0:04:56.14, Lalai,,0,0,0,,Saya akan membawa anda ke suatu tempat yang selamat, dan\Nkita boleh memikirkan rancangan seterusnya di sana.
Dialog: 0,0:04:56.17,0:04:58.94, Lalai,,0,0,0,,Kenapa Soo-cheol senyap?
Dialog: 0,0:04:58.96,0:05:01.73, Lalai,,0,0,0,,Hei, Soo-cheol! Katakan sesuatu!
Dialog: 0,0:05:01.75,0:05:05.96,Lalai,,0,0,0,,Jadi isteri awak, Da-hye, turut\Nin dalam hal ini. Adakah saya betul?
Dialog: 0,0:05:06.13,0:05:09.45, Lalai,,0,0,0,,Apa yang saya katakan? Geon-u\Ntidak mengejarnya sama sekali!
Dialog: 0,0:05:09.47,0:05:11.17, Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:05:17.98,0:05:21.60, Lalai,,0,0,0,,By the way, ke mana kita hendak pergi?
Dialog: 0,0:05:22.78,0:05:24.48,Lalai,,0,0,0,,Nah...
Dialog: 0,0:05:41.50,0:05:42.94, Lalai,,0,0,0,,- Apa itu?\N- Apa itu?
Dialog: 0,0:05:42.96,0:05:43.98,Lalai,,0,0,0,,Apa?
Dialog: 0,0:05:44.01,0:05:46.62, Lalai,,0,0,0,,- Siapa yang membutakan kita?\N- Siapa itu?
Dialog: 0,0:05:49.68,0:05:51.53, Lalai,,0,0,0,,- Tunggu.\N- Siapa itu?
Dialog: 0,0:05:51.55,0:05:53.28, Lalai,,0,0,0,,Ini adalah harta persendirian.
Dialog: 0,0:05:53.31,0:05:55.63, Lalai,,0,0,0,,- Apa?\N- Adakah itu Hyun-woo?
Dialog: 0,0:05:56.56,0:05:57.65, Lalai,,0,0,0,,Siapa?
Dialog: 0,0:05:57.67,0:05:58.70, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:05:58.73,0:06:00.41, Lalai,,0,0,0,,Hei, Hyun-woo!
Dialog: 0,0:06:00.44,0:06:02.58, Lalai,,0,0,0,,Saya tidak tahu awak akan datang.
Dialog: 0,0:06:02.61,0:06:05.43, Lalai,,0,0,0,,Ayah, ia adalah mendesak.
Dialog: 0,0:06:05.49,0:06:08.51, Lalai,,0,0,0,,Hei, Hyun-woo. Kenapa awak tak angkat?
Dialog: 0,0:06:08.53,0:06:11.43, Lalai,,0,0,0,,Awak tak makan sedap ke?
Dialog: 0,0:06:11.45,0:06:13.14, Lalai,,0,0,0,, Awak nampak teruk.
Dialog: 0,0:06:13.16,0:06:15.22,Lalai,,0,0,0,,- Tidak, itu...\N- Jangan risau sangat.
Dialog: 0,0:06:15.24,0:06:16.97, Lalai,,0,0,0,,Saya gembira awak tinggalkan keluarga gila itu.
Dialog: 0,0:06:17.00,0:06:20.14, Lalai,,0,0,0,,Lihat apa yang berlaku kepada\Nmereka selepas mereka menghalau anda.
Dialog: 0,0:06:20.17,0:06:21.73, Lalai,,0,0,0,,Karma akan sentiasa menemui jalannya.
Dialog: 0,0:06:21.75,0:06:23.19,Lalai,,0,0,0,,- Tunggu...\N- Anda bertaruh.
Dialog: 0,0:06:23.21,0:06:25.77, Lalai,,0,0,0,,Saya sangat lega mendengar...
Dialog: 0,0:06:25.80,0:06:28.19, Lalai,,0,0,0,,bahawa keluarga itu musnah. Melayan mereka dengan betul!
Dialog: 0,0:06:28.22,0:06:32.88,Lalai,,0,0,0,,Apa pun, lupakan itu\Nsly musang dan hidup bahagia.
Dialog: 0,0:06:41.56,0:06:44.81, Lalai,,0,0,0,,Musang licik juga ada di sini.
Dialog: 0,0:06:46.19,0:06:48.06, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:06:48.36,0:06:50.73, Lalai,,0,0,0,,Anda di sini juga.
Dialog: 0,0:06:51.95,0:06:54.32, Lalai,,0,0,0,,Bukan dia sahaja.
Dialog: 0,0:07:26.02,0:07:27.71,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:07:27.73,0:07:29.84,Lalai,,0,0,0,,Itu bapa mertua awak. Tidak.
Dialog: 0,0:07:29.86,0:07:32.77,Lalai,,0,0,0,,Adakah ia "bekas bapa mertua"?
Dialog: 0,0:07:33.28,0:07:35.84, Lalai,,0,0,0,, Bagaimanapun... Apa yang membawa anda ke sini?
Dialog: 0,0:07:35.87,0:07:37.57, Lalai,,0,0,0,,Helo.
Dialog: 0,0:07:37.79,0:07:39.43, Lalai,,0,0,0,,Bagaimana keadaan anda?
Dialog: 0,0:07:39.45,0:07:41.14, Lalai,,0,0,0,,Baik.
Dialog: 0,0:07:41.16,0:07:43.45, Lalai,,0,0,0,, Katakan halo.
Dialog: 0,0:07:44.46,0:07:46.54, Lalai,,0,0,0,,- Helo.\N- Hello.
Dialog: 0,0:07:46.67,0:07:48.73, Lalai,,0,0,0,,Saya minta maaf kerana datang tanpa pemberitahuan.
Dialog: 0,0:07:48.75,0:07:50.71, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:07:51.01,0:07:52.71, Lalai,,0,0,0,,Saya gembira anda berada di sini.
Dialog: 0,0:07:52.93,0:07:55.78, Lalai,,0,0,0,,Sila ikut saya. dengan cara ini.
Dialog: 0,0:07:55.80,0:07:56.91, Lalai,,0,0,0,,Saya pulang ke Seoul.
Dialog: 0,0:07:56.93,0:07:58.28, Lalai,,0,0,0,,- Turun teksi.\N- Mak.
Dialog: 0,0:07:58.31,0:08:01.66, Lalai,,0,0,0,,Tiada teksi di sekitar sini pada jam ini.
Dialog: 0,0:08:01.68,0:08:06.31, Lalai,,0,0,0,, Kemudian saya akan cari jalan lain, jadi lakukan sesuka hati.
Dialog: 0,0:08:06.56,0:08:08.35, Lalai,,0,0,0,, Sayang.
Dialog: 0,0:08:08.82,0:08:10.64, Lalai,,0,0,0,, Sayang.
Dialog: 0,0:08:10.69,0:08:12.67, Lalai,,0,0,0,, Kami sudah pun di sini.
Dialog: 0,0:08:12.70,0:08:15.34,Lalai,,0,0,0,,Saya sudah beritahu awak saya tidak mahu datang.
Dialog: 0,0:08:15.36,0:08:17.98, Lalai,,0,0,0,, Astaga!
Dialog: 0,0:08:25.17,0:08:26.87, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:08:26.96,0:08:30.00, Lalai,,0,0,0,,Saya rasa dia terpijak tahi lembu.
Dialog: 0,0:08:37.85,0:08:39.62,Lalai,,0,0,0,,Ibu, jangan datang. Jangan datang kepada saya!
Dialog: 0,0:08:39.64,0:08:41.88, Lalai,,0,0,0,,Jangan datang kepada saya juga!
Dialog: 0,0:08:47.86,0:08:49.81, Lalai,,0,0,0,,Pn. Kim?
Dialog: 0,0:09:19.22,0:09:21.46, Lalai,,0,0,0,,Bagus.
Dialog: 0,0:09:28.23,0:09:30.10, Lalai,,0,0,0,,Hei, Hyeon-tae.
Dialog: 0,0:09:31.27,0:09:32.79, Lalai,,0,0,0,,Saya memilih banyak.
Dialog: 0,0:09:32.82,0:09:35.03, Lalai,,0,0,0,,Bagaimanakah saya hendak memahami perkara ini?
Dialog: 0,0:09:35.05,0:09:36.05, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:09:36.07,0:09:40.65,Lalai,,0,0,0,,Mengapa Hyun-woo membawa bekas isterinya\Nand keluarganya ke sini?
Dialog: 0,0:09:40.83,0:09:42.80, Lalai,,0,0,0,,Ia serupa dengan Korea.
Dialog: 0,0:09:42.83,0:09:44.51, Lalai,,0,0,0,,Mungkin ada Utara dan Selatan,
Dialog: 0,0:09:44.54,0:09:47.98,Lalai,,0,0,0,,tetapi kami masih dalam pasukan yang sama di Sukan Olimpik.
Dialog: 0,0:09:48.00,0:09:49.10, Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:09:49.13,0:09:52.29,Lalai,,0,0,0,,Kami berganding bahu apabila ada musuh bersama.
Dialog: 0,0:09:52.96,0:09:56.78, Lalai,,0,0,0,,Adakah ini bermakna mereka mungkin kembali bersama?
Dialog: 0,0:09:56.80,0:10:01.13,Lalai,,0,0,0,,Kami mungkin berada dalam pasukan yang sama, tetapi\Nitu tidak menjamin penyatuan.
Dialog: 0,0:10:03.64,0:10:05.97,Lalai,,0,0,0,,- Mari bersiap.\N- Okay.
Dialog: 0,0:10:17.45,0:10:19.15, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:10:21.53,0:10:23.57,Lalai,,0,0,0,,Terima kasih untuk hari ini.
Dialog: 0,0:10:23.62,0:10:25.53,Lalai,,0,0,0,,Saya akan mencari tempat baharu untuk pergi esok.
Dialog: 0,0:10:25.56,0:10:26.93, Lalai,,0,0,0,,Tiada apa-apa yang akan berubah...
Dialog: 0,0:10:26.95,0:10:29.07, Lalai,,0,0,0,,semalam.
Dialog: 0,0:10:29.33,0:10:32.85, Lalai,,0,0,0,,Saya tahu. Lebih-lebih lagi sebab\Nkita tidak sepatutnya tinggal di sini.
Dialog: 0,0:10:32.88,0:10:34.79, Lalai,,0,0,0,,Ia akan mengambil sedikit masa sehingga habuk mendap.
Dialog: 0,0:10:34.82,0:10:38.56,Lalai,,0,0,0,,Ini adalah tempat paling selamat dan paling\Nselesa yang boleh anda kunjungi.
Dialog: 0,0:10:40.30,0:10:42.24, Lalai,,0,0,0,,Bukan untuk saya.
Dialog: 0,0:10:42.26,0:10:45.30,Lalai,,0,0,0,,Saya berada di rumah bekas mertua saya.
Dialog: 0,0:10:47.98,0:10:50.09, Lalai,,0,0,0,,Bukan anda. saya.
Dialog: 0,0:10:50.23,0:10:52.55, Lalai,,0,0,0,,Ini selesa untuk saya.
Dialog: 0,0:10:54.57,0:10:56.27,Lalai,,0,0,0,,Biar saya...
Dialog: 0,0:10:57.61,0:10:59.64, Lalai,,0,0,0,, jadilah pentingkan diri buat masa ini.
Dialog: 0,0:11:00.15,0:11:02.47, Lalai,,0,0,0,,Saya mempunyai terlalu banyak dalam pinggan saya sekarang...
Dialog: 0,0:11:02.49,0:11:05.03, Lalai,,0,0,0,, untuk membimbangkan anda juga.
Dialog: 0,0:11:05.12,0:11:07.07, Lalai,,0,0,0,,Jangan risau tentang saya.
Dialog: 0,0:11:07.33,0:11:09.49,Lalai,,0,0,0,,Kami sudah bercerai.
Dialog: 0,0:11:09.66,0:11:11.35, Lalai,,0,0,0,,Apa sahaja yang berlaku kepada saya...
Dialog: 0,0:11:11.37,0:11:12.81, Lalai,,0,0,0,, atau keluarga saya...
Dialog: 0,0:11:12.83,0:11:16.08,Lalai,,0,0,0,,tiada kaitan dengan anda.
Dialog: 0,0:11:26.97,0:11:29.22,Lalai,,0,0,0,,Saya akan berhenti bimbang...
Dialog: 0,0:11:30.43,0:11:32.47, Lalai,,0,0,0,, setelah anda lebih baik.
Dialog: 0,0:11:36.90,0:11:38.64, Lalai,,0,0,0,,Tetapi buat masa ini,
Dialog: 0,0:11:39.86,0:11:41.51,Lalai,,0,0,0,,itu mustahil,
Dialog: 0,0:11:41.53,0:11:43.31, Lalai,,0,0,0,,jadi tolong...
Dialog: 0,0:11:45.32,0:11:47.02, Lalai,,0,0,0,,faham.
Dialog: 0,0:11:49.20,0:11:51.03, Lalai,,0,0,0,,Hanya...
Dialog: 0,0:11:51.41,0:11:53.32, Lalai,,0,0,0,, kekal bersama saya.
Dialog: 0,0:11:59.05,0:12:00.61, Lalai,,0,0,0,,Adakah anda fikir bersama...
Dialog: 0,0:12:00.63,0:12:02.65,Lalai,,0,0,0,,dalam situasi ini akan membuatkan kita lebih bahagia?
Dialog: 0,0:12:02.68,0:12:04.54, Lalai,,0,0,0,,Kita akan kurang sengsara.
Dialog: 0,0:12:05.01,0:12:08.13, Lalai,,0,0,0,,Jangan terlalu banyak berfikir untuk hari ini.
Dialog: 0,0:12:09.01,0:12:12.68,Lalai,,0,0,0,,Mari kita fokus untuk mengurangkan kesedihan.
Dialog: 0,0:12:26.99,0:12:29.94, Lalai,,0,0,0,,Saya telah menyingkirkan ketulan itu. Mengenai baunya...
Dialog: 0,0:12:31.50,0:12:33.74, Lalai,,0,0,0,,Ia akan mengambil sedikit masa untuk kering.
Dialog: 0,0:12:34.71,0:12:37.53, Lalai,,0,0,0,,- Buang sahaja.\N- Baik.
Dialog: 0,0:12:37.84,0:12:40.83, Lalai,,0,0,0,,Untuk apa? Mereka kelihatan mahal.
Dialog: 0,0:12:46.59,0:12:48.75,Lalai,,0,0,0,,Pakai ini buat masa ini.
Dialog: 0,0:13:15.08,0:13:18.45,Lalai,,0,0,0,,Bagaimana pula dengan tumit ini?\NSAwakkah saya membuangnya?
Dialog: 0,0:13:19.63,0:13:21.15, Lalai,,0,0,0,,Jadi apakah itu?
Dialog: 0,0:13:21.17,0:13:23.87, Lalai,,0,0,0,,Adakah dia akan menyingkirkannya atau tidak?
Dialog: 0,0:13:24.30,0:13:25.40,Lalai,,0,0,0,,Nampak mahal.
Dialog: 0,0:13:25.42,0:13:27.46,Lalai,,0,0,0,,Lebih $500.
Dialog: 0,0:13:38.65,0:13:40.51, Lalai,,0,0,0,,$5000?
Dialog: 0,0:13:54.79,0:13:57.20,Lalai,,0,0,0,,Saya datang ke sini bukan atas pilihan.
Dialog: 0,0:13:58.17,0:14:00.19, Lalai,,0,0,0,,Anak awak sangat cepat.
Dialog: 0,0:14:00.21,0:14:02.40, Lalai,,0,0,0,,Dia hampir menculik kami.
Dialog: 0,0:14:02.42,0:14:04.52,Lalai,,0,0,0,,Arwah ibu saya...
Dialog: 0,0:14:04.55,0:14:06.53, Lalai,,0,0,0,,betul.
Dialog: 0,0:14:06.55,0:14:10.04, Lalai,,0,0,0,,Dia berkata, "Anda tidak pernah tahu\Napa masa depan."
Dialog: 0,0:14:10.43,0:14:15.92,Lalai,,0,0,0,,Siapa tahu kita akan bertemu semula beberapa\Nhari selepas kita mengucapkan selamat tinggal terakhir?
Dialog: 0,0:14:16.23,0:14:20.83,Lalai,,0,0,0,,Kakak saya mendesak kami untuk tinggal\Nat di vilanya di Namhae.
Dialog: 0,0:14:20.86,0:14:23.31, Lalai,,0,0,0,,Kami akan meninggalkan perkara pertama pada waktu pagi.
Dialog: 0,0:14:24.15,0:14:25.98,Lalai,,0,0,0,,Tentu,
Dialog: 0,0:14:26.32,0:14:29.98,Lalai,,0,0,0,,tetapi jangan terlalu yakin.
Dialog: 0,0:14:50.93,0:14:52.45,Lalai,,0,0,0,,Tuan.
Dialog: 0,0:14:52.47,0:14:54.17,Lalai,,0,0,0,,Sila makan.
Dialog: 0,0:14:54.72,0:14:56.42,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:15:27.42,0:15:29.12,Lalai,,0,0,0,,Sedap.
Dialog: 0,0:15:30.26,0:15:32.17, Lalai,,0,0,0,,Adakah ia menepati citarasa anda?
Dialog: 0,0:15:33.34,0:15:35.96,Lalai,,0,0,0,,Ya, ia sangat lazat.
Dialog: 0,0:15:37.89,0:15:39.58, Lalai,,0,0,0,, Makan.
Dialog: 0,0:15:39.60,0:15:41.87, Lalai,,0,0,0,,Anda perlu mengurangkan pengambilan natrium.
Dialog: 0,0:15:41.89,0:15:45.21,Lalai,,0,0,0,,Doktor Yoon akan memarahi awak\Jika dia tahu. Jangan makan itu.
Dialog: 0,0:15:45.23,0:15:48.88, Lalai,,0,0,0,,Jangan risau. Dia tidak menjawab panggilan saya.
Dialog: 0,0:15:48.90,0:15:50.81, Lalai,,0,0,0,,Saya rasa dia menghalang saya.
Dialog: 0,0:15:55.95,0:16:00.57, Lalai,,0,0,0,,Kenapa awak tak makan, Soo-cheol?
Dialog: 0,0:16:08.13,0:16:09.81, Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,0:16:09.84,0:16:11.69, Lalai,,0,0,0,,Saya tidak lapar.
Dialog: 0,0:16:11.72,0:16:13.11, Lalai,,0,0,0,,Adakah anda mempunyai air?
Dialog: 0,0:16:13.13,0:16:14.90, Lalai,,0,0,0,,Ya, di sini.
Dialog: 0,0:16:14.93,0:16:16.75, Lalai,,0,0,0,,Ini dia.
Dialog: 0,0:16:17.55,0:16:19.49,Lalai,,0,0,0,,Anda lihat...
Dialog: 0,0:16:19.52,0:16:21.41, Lalai,,0,0,0,,Saya hanya minum air tertutup.
Dialog: 0,0:16:21.43,0:16:23.51, Lalai,,0,0,0,,Adakah anda mempunyai air botol?
Dialog: 0,0:16:23.77,0:16:26.35, Lalai,,0,0,0,,Hei, minum saja.
Dialog: 0,0:16:29.02,0:16:31.38, Lalai,,0,0,0,,Ya, kami ada di kedai. Saya akan membawa beberapa.
Dialog: 0,0:16:31.40,0:16:35.52,Lalai,,0,0,0,,Terima kasih. Saya lebih suka air mineral\N dari Alps, sila.
Dialog: 0,0:16:38.78,0:16:41.24,Lalai,,0,0,0,,Maaf? Alps?
Dialog: 0,0:16:41.66,0:16:43.78,Lalai,,0,0,0,,Saya tidak percaya anda.
Dialog: 0,0:16:45.50,0:16:46.69,Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,0:16:46.71,0:16:48.35, Lalai,,0,0,0,,Dia masih belum matang.
Dialog: 0,0:16:48.38,0:16:50.31,Lalai,,0,0,0,,Astaga, tidak mengapa.
Dialog: 0,0:16:50.34,0:16:52.29,Lalai,,0,0,0,,Kami faham.
Dialog: 0,0:16:52.55,0:16:55.03, Lalai,,0,0,0,,Ia tidak semestinya dari Alps.
Dialog: 0,0:16:55.05,0:16:59.07, Lalai,,0,0,0,,Jerman atau Australia baik-baik saja.
Dialog: 0,0:16:59.10,0:17:00.57, Lalai,,0,0,0,,Fiji juga okey.
Dialog: 0,0:17:00.60,0:17:04.80, Lalai,,0,0,0,,Kami tidak terlalu memilih.
Dialog: 0,0:17:05.56,0:17:08.93, Lalai,,0,0,0,,Ya, saya juga baik dengan mereka.
Dialog: 0,0:17:11.82,0:17:14.48, Lalai,,0,0,0,, Hanya minum dari cerek!
Dialog: 0,0:17:22.33,0:17:23.39, Lalai,,0,0,0,,Saya akan terima itu.
Dialog: 0,0:17:23.41,0:17:26.28, Lalai,,0,0,0,,- Astaga.\N- Tolonglah.
Dialog: 0,0:17:27.58,0:17:29.49, Lalai,,0,0,0,,Dia tidak memukul saya.
Dialog: 0,0:17:34.21,0:17:36.07, Lalai,,0,0,0,,Adakah anda melihat dia memukul abangnya?
Dialog: 0,0:17:36.09,0:17:37.44, Lalai,,0,0,0,,Saya sangat ketakutan.
Dialog: 0,0:17:37.47,0:17:39.49,Lalai,,0,0,0,,Apa yang anda maksudkan? Awak pukul saya juga.
Dialog: 0,0:17:39.51,0:17:42.57,Lalai,,0,0,0,,Hei, tamparan saya tidaklah sakit,
Dialog: 0,0:17:42.60,0:17:45.16,Lalai,,0,0,0,,tetapi Hae-in benar-benar...
Dialog: 0,0:17:45.18,0:17:47.14, Lalai,,0,0,0,, Patutkah saya membantu?
Dialog: 0,0:17:47.60,0:17:49.12, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:17:49.15,0:17:51.17, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:17:51.19,0:17:54.35, Lalai,,0,0,0,,Tidak, anda tidak perlu membantu. Anda boleh berehat sahaja.
Dialog: 0,0:17:56.65,0:17:58.56,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:18:00.12,0:18:01.82, Lalai,,0,0,0,,By the way, Hae-in...
Dialog: 0,0:18:02.16,0:18:03.43, Lalai,,0,0,0,, Betul.
Dialog: 0,0:18:03.45,0:18:05.18, Lalai,,0,0,0,,Boleh saya katakan sesuatu?
Dialog: 0,0:18:05.20,0:18:07.45,Lalai,,0,0,0,,Walaupun kamu berdua sudah bercerai...
Dialog: 0,0:18:07.92,0:18:09.66, Lalai,,0,0,0,, Pasti, anda boleh.
Dialog: 0,0:18:10.08,0:18:12.70,Lalai,,0,0,0,,Jangan ambil hati apa yang saya cakap tadi.
Dialog: 0,0:18:12.80,0:18:14.27,Lalai,,0,0,0,,Yang mana?
Dialog: 0,0:18:14.30,0:18:16.57, Lalai,,0,0,0,,Tentang anda musang licik dan semua.
Dialog: 0,0:18:16.59,0:18:19.69, Lalai,,0,0,0,,- Betul.\N- Saya tidak pernah tidak suka musang licik.
Dialog: 0,0:18:19.72,0:18:22.07,Lalai,,0,0,0,,Lagipun, itu nama panggilan saya di sekolah menengah.
Dialog: 0,0:18:22.10,0:18:23.87, Lalai,,0,0,0,,Saya kelihatan seperti musang, anda tahu?
Dialog: 0,0:18:23.89,0:18:27.58,Lalai,,0,0,0,,Saya ingin memohon maaf kerana\Nmengatakan keluarga anda telah musnah.
Dialog: 0,0:18:27.60,0:18:29.54, Lalai,,0,0,0,,Memang benar.
Dialog: 0,0:18:29.56,0:18:31.37, Lalai,,0,0,0,,Kami sudah selesai untuk.
Dialog: 0,0:18:31.40,0:18:33.04, Lalai,,0,0,0,,Ini adalah subjek yang sensitif.
Dialog: 0,0:18:33.07,0:18:34.88,Lalai,,0,0,0,,Saya tahu awak sudah bercerai,
Dialog: 0,0:18:34.90,0:18:36.46,Lalai,,0,0,0,,tetapi adakah anda bersetuju untuk datang ke sini...
Dialog: 0,0:18:36.49,0:18:38.46,Lalai,,0,0,0,,kerana anda mempunyai perasaan antara satu sama lain?
Dialog: 0,0:18:38.49,0:18:39.71,Lalai,,0,0,0,,No.
Dialog: 0,0:18:39.74,0:18:42.43,Lalai,,0,0,0,,Ia adalah kecemasan. Tiada lagi.
Dialog: 0,0:18:42.45,0:18:43.76,Lalai,,0,0,0,,Betul. Anda orang asing sekarang.
Dialog: 0,0:18:43.78,0:18:45.14, Lalai,,0,0,0,,Kami lebih daripada itu.
Dialog: 0,0:18:45.16,0:18:47.22, Lalai,,0,0,0,,Tetapi mungkinkah ada sesuatu di antara kamu...?
Dialog: 0,0:18:47.25,0:18:48.85, Lalai,,0,0,0,,Tidak, tidak sama sekali.
Dialog: 0,0:18:48.87,0:18:50.78, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:18:51.13,0:18:54.02,Lalai,,0,0,0,,Kami tidak akan bercerai jika itu berlaku.
Dialog: 0,0:18:54.04,0:18:55.56, Lalai,,0,0,0,,Itu benar.
Dialog: 0,0:18:55.59,0:18:57.15, Lalai,,0,0,0,,Dia betul.
Dialog: 0,0:18:57.17,0:18:59.32,Lalai,,0,0,0,,Jadi tolong jangan salah faham, jangka,
Dialog: 0,0:18:59.34,0:19:02.13, Lalai,,0,0,0,, atau memberi makna kepada mana-mana perkara ini.
Dialog: 0,0:19:03.64,0:19:06.66, Lalai,,0,0,0,,Saya tidak akan. Ingat So-yeong?
Dialog: 0,0:19:06.68,0:19:07.77, Lalai,,0,0,0,,Anak perempuan pengetua?
Dialog: 0,0:19:07.79,0:19:10.54,Lalai,,0,0,0,,Dia baru-baru ini mendapat pekerjaan\Nat sekolah menengah berdekatan,
Dialog: 0,0:19:10.56,0:19:13.25,Lalai,,0,0,0,,dan telah meminta nombor Hyun-woo,
Dialog: 0,0:19:13.27,0:19:16.06,Lalai,,0,0,0,,- tetapi saya tidak dapat memberitahunya.\N- Anda boleh.
Dialog: 0,0:19:16.11,0:19:17.81, Lalai,,0,0,0,,Boleh?
Dialog: 0,0:19:19.90,0:19:24.15,Lalai,,0,0,0,,Tetapi sekali lagi, saya tidak\Nperlu meminta kebenaran.
Dialog: 0,0:19:24.62,0:19:26.32,Lalai,,0,0,0,,Selamat malam, kalau begitu.
Dialog: 0,0:19:29.37,0:19:30.35, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:19:30.37,0:19:32.02, Lalai,,0,0,0,,Mereka tidak akan kembali bersama.
Dialog: 0,0:19:32.04,0:19:34.19, Lalai,,0,0,0,,Hei, saya juga tidak mahu.
Dialog: 0,0:19:34.21,0:19:35.52,Lalai,,0,0,0,,Dia sangat kurang ajar.
Dialog: 0,0:19:35.54,0:19:39.73, Lalai,,0,0,0,,Dia tidak peduli untuk mendengar\N saya dan terus memotong perkataan saya.
Dialog: 0,0:19:39.76,0:19:43.33, Lalai,,0,0,0,, Astaga, musang licik itu. Dia tidak sepatutnya datang.
Dialog: 0,0:19:45.72,0:19:48.20, Lalai,,0,0,0,,Ini adalah lampiran kami.
Dialog: 0,0:19:48.22,0:19:51.45,Lalai,,0,0,0,,Kami pernah tinggal di sini dahulu\NHyeon-tae dan Mi-seon...
Dialog: 0,0:19:51.48,0:19:53.00,Lalai,,0,0,0,,berkahwin.
Dialog: 0,0:19:53.02,0:19:55.60, Lalai,,0,0,0,,Kami memanaskan lantai.
Dialog: 0,0:19:57.44,0:19:59.36, Lalai,,0,0,0,,Saya minta maaf tentang segala-galanya.
Dialog: 0,0:19:59.38,0:20:00.38, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:20:00.40,0:20:01.96,Lalai,,0,0,0,,Tolong jangan minta maaf.
Dialog: 0,0:20:01.99,0:20:04.05, Lalai,,0,0,0,, Malah jiran membantu...
Dialog: 0,0:20:04.07,0:20:06.27, Lalai,,0,0,0,,apabila masa sukar,
Dialog: 0,0:20:06.53,0:20:08.53, Lalai,,0,0,0,,tetapi kami...
Dialog: 0,0:20:08.58,0:20:11.60,Lalai,,0,0,0,,dahulu keluarga.
Dialog: 0,0:20:11.62,0:20:15.02,Lalai,,0,0,0,,Hyun-woo beritahu saya rahsia awak ada di sini.
Dialog: 0,0:20:15.04,0:20:16.94,Lalai,,0,0,0,,Saya sudah memberi amaran kepada penduduk kampung...
Dialog: 0,0:20:16.96,0:20:20.44, Lalai,,0,0,0,,untuk tidak menggunakan internet.
Dialog: 0,0:20:20.46,0:20:22.82, Lalai,,0,0,0,,Tiada kamera CCTV di sekeliling,
Dialog: 0,0:20:22.84,0:20:27.49, Lalai,,0,0,0,,dan hampir tidak sesiapa pun menggunakan telefon pintar di sini,
Dialog: 0,0:20:27.51,0:20:32.01, Lalai,,0,0,0,,jadi jangan risau dan tidur lena.
Dialog: 0,0:20:33.52,0:20:34.50, Lalai,,0,0,0,,Terima kasih banyak.
Dialog: 0,0:20:34.52,0:20:37.31, Lalai,,0,0,0,, Astaga, bukan apa-apa.
Dialog: 0,0:20:39.11,0:20:42.19, Lalai,,0,0,0,,Anda boleh mandi di sini.
Dialog: 0,0:20:42.49,0:20:43.46, Lalai,,0,0,0,,Di mana tab mandi?
Dialog: 0,0:20:43.49,0:20:44.51, Lalai,,0,0,0,,Tiada satu,
Dialog: 0,0:20:44.53,0:20:48.40, Lalai,,0,0,0,,tetapi inilah pancuran.
Dialog: 0,0:20:55.50,0:20:56.56,Lalai,,0,0,0,,Di mana saya boleh mandi?
Dialog: 0,0:20:56.58,0:20:57.56, Lalai,,0,0,0,,Anda tidak boleh.
Dialog: 0,0:20:57.58,0:21:00.41, Lalai,,0,0,0,,- Bagaimana pula dengan bom mandi saya?\N- Jangan gunakannya.
Dialog: 0,0:21:02.30,0:21:05.21, Lalai,,0,0,0,,Anda boleh menggunakan tuala ini.
Dialog: 0,0:21:05.37,0:21:06.69,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hari Lahir Pertama Baek Ho-yeol{\c}{\i0}
Dialog: 0,0:21:06.72,0:21:10.82,Lalai,,0,0,0,,Bukankah kamu katakan nama anak saudara kamu ialah Ho-yeol?
Dialog: 0,0:21:10.85,0:21:12.63, Lalai,,0,0,0,,Ya, Baek Ho-yeol.
Dialog: 0,0:21:14.48,0:21:17.00, Lalai,,0,0,0,, "Bayi Ho-yeol" ini tidak mungkin...
Dialog: 0,0:21:17.02,0:21:20.43,Default,,0,0,0,,budak yang aku nampak tadi kan?
Dialog: 0,0:21:22.40,0:21:24.27, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:21:25.20,0:21:28.69, Lalai,,0,0,0,, Betul. Dulu dia kecik sangat.
Dialog: 0,0:21:28.87,0:21:32.11, Lalai,,0,0,0,,Dia sangat comel. Ya, ini dia.
Dialog: 0,0:21:32.83,0:21:34.81, Lalai,,0,0,0,,Jadi orang yang sama.
Dialog: 0,0:21:34.83,0:21:38.49, Lalai,,0,0,0,, Kemudian berapa umur tuala ini?
Dialog: 0,0:21:39.04,0:21:40.74, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:21:40.84,0:21:43.54, Lalai,,0,0,0,,Apa yang salah? Adakah anda mahu yang baru?
Dialog: 0,0:21:45.17,0:21:46.87, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:21:47.13,0:21:49.50,Lalai,,0,0,0,,Tahukah anda...
Dialog: 0,0:21:50.43,0:21:54.17, Lalai,,0,0,0,,apa yang lebih sukar dipercayai\Ndaripada tuala berusia lapan tahun ini?
Dialog: 0,0:21:55.39,0:21:57.09,Lalai,,0,0,0,,Itulah...
Dialog: 0,0:21:58.15,0:22:01.43, Lalai,,0,0,0,,Da-hye dan Geon-u telah meninggalkan saya,
Dialog: 0,0:22:02.11,0:22:07.35,Lalai,,0,0,0,,dan Yoon Eun-sung, si brengsek itu menipu saya!
Dialog: 0,0:22:12.87,0:22:14.01, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:22:14.04,0:22:16.28, Lalai,,0,0,0,,Di mana semua orang?
Dialog: 0,0:22:17.25,0:22:18.95, Lalai,,0,0,0,,Helo.
Dialog: 0,0:22:19.00,0:22:21.58, Lalai,,0,0,0,,Di manakah keluarga Hae-in?
Dialog: 0,0:22:22.05,0:22:23.02, Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,0:22:23.05,0:22:25.06, Lalai,,0,0,0,,Saya pasti mereka ada di suatu tempat.
Dialog: 0,0:22:25.09,0:22:27.00, Lalai,,0,0,0,,Mengapa anda melakukannya?
Dialog: 0,0:22:29.51,0:22:31.78, Lalai,,0,0,0,,Adakah anda mahu mereka kekal, kemudian?
Dialog: 0,0:22:31.80,0:22:33.32, Lalai,,0,0,0,,Bagaimana kita boleh hidup...
Dialog: 0,0:22:33.35,0:22:35.83, Lalai,,0,0,0,,di bawah bumbung yang sama dengan yang kita curi?
Dialog: 0,0:22:35.85,0:22:37.24,Lalai,,0,0,0,,Ia belum berakhir.
Dialog: 0,0:22:37.27,0:22:39.79,Lalai,,0,0,0,,Mereka akan cuba mencari kelemahan anda,
Dialog: 0,0:22:39.81,0:22:41.58, Lalai,,0,0,0,,dan membalas dendam.
Dialog: 0,0:22:41.61,0:22:43.21, Lalai,,0,0,0,,Sepatutnya anda rapatkan mereka...
Dialog: 0,0:22:43.24,0:22:44.63, Lalai,,0,0,0,,Jangan awak...
Dialog: 0,0:22:44.65,0:22:47.30,Lalai,,0,0,0,,hanya nak rapatkan Hae-in?
Dialog: 0,0:22:47.32,0:22:48.42, Lalai,,0,0,0,,Lupakan dia.
Dialog: 0,0:22:48.45,0:22:50.01, Lalai,,0,0,0,, Anda akan, akhirnya.
Dialog: 0,0:22:50.03,0:22:52.44,Lalai,,0,0,0,,Jangan susah-susah menyesal.
Dialog: 0,0:22:56.58,0:22:59.49,Lalai,,0,0,0,,Saya telah tinggal di sini selama 25 tahun,
Dialog: 0,0:22:59.58,0:23:01.81, Lalai,,0,0,0,,tetapi ini kali pertama saya memilih...
Dialog: 0,0:23:01.83,0:23:04.04, Lalai,,0,0,0,, wain saya sendiri.
Dialog: 0,0:23:05.59,0:23:07.65,Lalai,,0,0,0,,Mari kita mula menikmati apa yang kita ada.
Dialog: 0,0:23:07.67,0:23:09.37, Lalai,,0,0,0,, Okay?
Dialog: 0,0:23:10.09,0:23:13.29,Lalai,,0,0,0,,Ingat apa yang kamu katakan semasa menghantar saya pergi?
Dialog: 0,0:23:14.18,0:23:15.88, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan lupa.{\c}{\i0}
Dialog: 0,0:23:16.01,0:23:18.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya paling sayang kamu,{\c}{\i0}
Dialog: 0,0:23:19.81,0:23:21.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi saya akan kekal kuat dan mengharunginya,{\c}{\i0}
Dialog: 0,0:23:21.35,0:23:23.51,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}walaupun saya merindui awak...{\c}{\i0}
Dialog: 0,0:23:23.61,0:23:25.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan ingin berjumpa dengan anda,{\c}{\i0}
Dialog: 0,0:23:26.11,0:23:28.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}hanya kerana saya sayangkan awak.{\c}{\i0}
Dialog: 0,0:23:29.78,0:23:33.27,Lalai,,0,0,0,,{\i1}Dan anda menepati kata-kata anda.\NAnda cukup mahir dalam hal itu.{\i0}
Dialog: 0,0:23:33.45,0:23:37.60,Lalai,,0,0,0,,Anda tidak pernah tertanya-tanya tentang keadaan\Anak lelaki anda di luar negara.
Dialog: 0,0:23:37.62,0:23:40.26,Lalai,,0,0,0,,Anda tidak pernah bersusah payah untuk menelefon.\NAnda benar-benar menanggung semuanya,
Dialog: 0,0:23:40.29,0:23:42.14, Lalai,,0,0,0,,tetapi anda lihat,
Dialog: 0,0:23:42.17,0:23:44.41,Lalai,,0,0,0,,Saya sedar ia adalah satu pembohongan...
Dialog: 0,0:23:46.42,0:23:49.79,Lalai,,0,0,0,,untuk menanggung sesuatu kerana cinta.
Dialog: 0,0:23:50.05,0:23:51.96, Lalai,,0,0,0,,Anda tidak boleh menahannya...
Dialog: 0,0:23:52.51,0:23:54.38,Lalai,,0,0,0,,jika anda benar-benar mencintai seseorang.
Dialog: 0,0:24:02.06,0:24:03.97, Lalai,,0,0,0,,Apa yang anda perolehi?
Dialog: 0,0:24:04.23,0:24:05.79, Lalai,,0,0,0,,Adakah anda berkata...
Dialog: 0,0:24:05.81,0:24:06.94, Lalai,,0,0,0,, awak marah saya sekarang?
Dialog: 0,0:24:06.97,0:24:07.96, Lalai,,0,0,0,,No.
Dialog: 0,0:24:07.98,0:24:11.00, Lalai,,0,0,0,,Saya memberitahu anda bahawa saya akan membawa\NHae-in kembali ke sini pada semua kos.
Dialog: 0,0:24:11.03,0:24:12.59,Lalai,,0,0,0,,Saya bukan seperti awak.
Dialog: 0,0:24:12.61,0:24:16.98, Lalai,,0,0,0,,Ia membuatkan saya gila untuk tertanya-tanya\Ndi mana dia berada, dan apa yang dia lakukan.
Dialog: 0,0:24:19.16,0:24:20.86, Lalai,,0,0,0,,Saya tidak boleh...
Dialog: 0,0:24:21.83,0:24:23.53,Lalai,,0,0,0,,tahanlah.
Dialog: 0,0:24:24.92,0:24:27.73,Lalai,,0,0,0,,Adakah anda tahu betapa sukarnya\Nit untuk sampai sejauh ini?
Dialog: 0,0:24:27.75,0:24:30.50,Lalai,,0,0,0,,Mengapa anda fikir saya melakukan ini?
Dialog: 0,0:24:34.09,0:24:36.20,Lalai,,0,0,0,,Kami tidak berkongsi matlamat yang sama,
Dialog: 0,0:24:36.22,0:24:39.26,Lalai,,0,0,0,,jadi sama seperti bagaimana anda memilih keluarga ini berbanding saya,
Dialog: 0,0:24:40.02,0:24:41.84, Lalai,,0,0,0,,Saya juga boleh memilih...
Dialog: 0,0:24:42.27,0:24:44.76, Lalai,,0,0,0,,sesuatu yang lain atas anda.
Dialog: 0,0:25:01.20,0:25:04.20, Lalai,,0,0,0,,Periksa semua hotel dan vila.
Dialog: 0,0:25:08.92,0:25:11.04, Lalai,,0,0,0,,Ini adalah neraka yang hidup.
Dialog: 0,0:25:12.13,0:25:15.33,Lalai,,0,0,0,,Neraka jenis apa yang menawarkan kita selimut sutera...
Dialog: 0,0:25:15.38,0:25:18.34, Lalai,,0,0,0,,dan lantai yang hangat?
Dialog: 0,0:25:31.82,0:25:33.56, Lalai,,0,0,0,,Biarkan dia sahaja.
Dialog: 0,0:25:33.74,0:25:36.81, Lalai,,0,0,0,,Dia pasti benar-benar kecewa.
Dialog: 0,0:25:39.03,0:25:42.68, Lalai,,0,0,0,,Dia tidak pernah tidur di atas lantai keras sebelum ini.
Dialog: 0,0:25:42.70,0:25:47.20,Lalai,,0,0,0,,Dia hanya boleh tidur di atas katil diraja Sepanyol.
Dialog: 0,0:25:50.25,0:25:54.00, Lalai,,0,0,0,,Kita nampak lebih tebal daripada dia.
Dialog: 0,0:25:54.05,0:25:56.03, Lalai,,0,0,0,,Mari tukar selimut.
Dialog: 0,0:25:56.05,0:25:57.75,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:25:58.01,0:25:59.07, Lalai,,0,0,0,,Apa?
Dialog: 0,0:25:59.09,0:26:00.84, Lalai,,0,0,0,,Saya juga.
Dialog: 0,0:26:01.60,0:26:04.72,Lalai,,0,0,0,,Ini juga kali pertama saya tidur di atas lantai.
Dialog: 0,0:26:07.81,0:26:10.60,Lalai,,0,0,0,,Saya juga dari keluarga kaya.
Dialog: 0,0:26:20.57,0:26:22.27,Lalai,,0,0,0,,{\i1}Helo?{\i0}
Dialog: 0,0:26:22.45,0:26:23.93,Lalai,,0,0,0,,- Beom-seok.\N- {\i1}Saya melihat berita itu.{\i0}
Dialog: 0,0:26:23.95,0:26:25.85,Lalai,,0,0,0,,{\i1}Apa khabar semua?{\i0}
Dialog: 0,0:26:25.87,0:26:27.74, Lalai,,0,0,0,,Kucar-kacir.
Dialog: 0,0:26:28.21,0:26:31.91, Lalai,,0,0,0,,Saya kasihan dengan Ayah.
Dialog: 0,0:26:32.42,0:26:34.40,Lalai,,0,0,0,,{\i1}Saya menutup telefon jika ini mengenai dia.{\i0}
Dialog: 0,0:26:34.42,0:26:37.28,Lalai,,0,0,0,,Jangan jadi begini.
Dialog: 0,0:26:37.30,0:26:38.65, Lalai,,0,0,0,,{\i1}Ingat apa yang dia katakan?{\i0}
Dialog: 0,0:26:38.68,0:26:40.95,Lalai,,0,0,0,,{\i1}Dia memberitahu saya supaya tidak datang ke pengebumiannya,{\i0}
Dialog: 0,0:26:40.97,0:26:43.53,Lalai,,0,0,0,,{\i1}jadi jangan hubungi saya, walaupun dia meninggal dunia.{\i0}
Dialog: 0,0:26:43.56,0:26:46.67, Lalai,,0,0,0,,Ayuh. Jangan jadi macam ni.
Dialog: 0,0:26:48.02,0:26:51.72,Lalai,,0,0,0,,Saya berdendam dengan dia semasa dia sihat,
Dialog: 0,0:26:53.36,0:26:55.68,Lalai,,0,0,0,,tetapi sekarang dia sakit,
Dialog: 0,0:26:56.23,0:26:58.21,Lalai,,0,0,0,,Saya rasa sangat bersalah.
Dialog: 0,0:26:58.24,0:26:59.94,Lalai,,0,0,0,,{\i1}Untuk apa?{\i0}
Dialog: 0,0:27:02.07,0:27:04.98, Lalai,,0,0,0,,Mungkin semuanya akan baik-baik saja...
Dialog: 0,0:27:06.45,0:27:09.18,Lalai,,0,0,0,,jika saya layan Seul-hee dengan lebih baik.
Dialog: 0,0:27:09.21,0:27:13.31, Lalai,,0,0,0,,Mungkin dia marah kerana saya menganiaya dia.
Dialog: 0,0:27:13.34,0:27:14.69, Lalai,,0,0,0,,Kira-kira sepuluh tahun yang lalu,
Dialog: 0,0:27:14.71,0:27:16.81, Lalai,,0,0,0,,Saya sangat terkejut apabila Ayah memberitahu saya...
Dialog: 0,0:27:16.84,0:27:18.40,Lalai,,0,0,0,,dia mahu dia menjadi isterinya yang sah,
Dialog: 0,0:27:18.42,0:27:20.61, Lalai,,0,0,0,,jadi dia menyerah pada idea itu.
Dialog: 0,0:27:20.63,0:27:24.13,Lalai,,0,0,0,,Mungkin dia menyimpan dendam dan merancang segala-galanya.
Dialog: 0,0:27:27.68,0:27:30.37, Lalai,,0,0,0,,Cincin bodoh ini. Bukan apa.
Dialog: 0,0:27:30.39,0:27:32.97, Lalai,,0,0,0,,Saya sepatutnya biarkan dia memilikinya.
Dialog: 0,0:27:35.27,0:27:37.68, Lalai,,0,0,0,, Patutkah saya mengembalikannya kepadanya?
Dialog: 0,0:27:37.94,0:27:41.44, Lalai,,0,0,0,, Patutkah saya berikannya sekarang?
Dialog: 0,0:27:44.16,0:27:46.03, Lalai,,0,0,0,,{\i1}Beom-ja.{\i0}
Dialog: 0,0:27:46.87,0:27:51.36,Lalai,,0,0,0,,Rasanya saya yang dipersalahkan\Natas apa yang berlaku kepada Ayah.
Dialog: 0,0:28:03.55,0:28:06.96, Lalai,,0,0,0,,Kenapa awak menangis? Adakah suami anda meninggalkan anda?
Dialog: 0,0:28:07.43,0:28:10.76,Lalai,,0,0,0,,- Tidak.\N- Adakah ibu bapa anda sakit?
Dialog: 0,0:28:13.44,0:28:15.14,Lalai,,0,0,0,,Ya...
Dialog: 0,0:28:15.86,0:28:19.13, Lalai,,0,0,0,,Ayah saya sakit.
Dialog: 0,0:28:19.15,0:28:21.06, Lalai,,0,0,0,,Oh, sayang.
Dialog: 0,0:28:21.65,0:28:23.55,Lalai,,0,0,0,,Adalah perkara biasa untuk rasa bersalah...
Dialog: 0,0:28:23.57,0:28:27.32,Lalai,,0,0,0,,apabila ibu bapa anda jatuh sakit.
Dialog: 0,0:28:27.41,0:28:28.39, Lalai,,0,0,0,, Menangis.
Dialog: 0,0:28:28.41,0:28:31.22,Lalai,,0,0,0,,Lepaskan semuanya dan mula merawatnya dengan lebih baik.
Dialog: 0,0:28:31.25,0:28:33.16, Lalai,,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:28:34.00,0:28:36.74, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:28:38.84,0:28:40.96, Lalai,,0,0,0,,Mak!
Dialog: 0,0:28:41.63,0:28:42.78, Lalai,,0,0,0,,Mak!
Dialog: 0,0:28:42.80,0:28:45.96,Lalai,,0,0,0,,Bagus, apa yang perlu saya lakukan?
Dialog: 0,0:28:46.14,0:28:48.59,Lalai,,0,0,0,,Ada apa?
Dialog: 0,0:28:49.01,0:28:53.39, Lalai,,0,0,0,,Ada orang gila ini yang memanggil\Nsaya "Ibu" dan mengekori saya.
Dialog: 0,0:28:53.42,0:28:54.45,Lalai,,0,0,0,,Apa?
Dialog: 0,0:28:54.48,0:28:58.22, Lalai,,0,0,0,,Boleh awak beritahu dia awak anak saya?
Dialog: 0,0:28:59.40,0:29:01.64, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:29:02.44,0:29:04.35, Lalai,,0,0,0,,Ibu.
Dialog: 0,0:29:04.86,0:29:07.40, Lalai,,0,0,0,,Sudah terlambat untuk keluar.
Dialog: 0,0:29:09.45,0:29:12.97, Lalai,,0,0,0,,Maafkan saya. Ini ibu saya,
Dialog: 0,0:29:13.00,0:29:14.97, Lalai,,0,0,0,,- jadi teruskan perjalanan anda.\N- Apa?
Dialog: 0,0:29:15.00,0:29:17.27,Lalai,,0,0,0,,Saya anak perempuannya,
Dialog: 0,0:29:17.29,0:29:19.62, Lalai,,0,0,0,, jadi tinggalkan.
Dialog: 0,0:29:19.96,0:29:22.48,Lalai,,0,0,0,,Awak bukan dari Seoul?
Dialog: 0,0:29:22.51,0:29:24.23,Lalai,,0,0,0,,Dia ibu saya.
Dialog: 0,0:29:24.26,0:29:26.29, Lalai,,0,0,0,,Tidak, dia milik saya!
Dialog: 0,0:29:29.43,0:29:32.20,Default,,0,0,0,,Mak, awak tak nak tengok drama ke?
Dialog: 0,0:29:32.22,0:29:34.05, Lalai,,0,0,0,,Drama?
Dialog: 0,0:29:36.69,0:29:39.60, Lalai,,0,0,0,,Nah, saya tidak boleh melangkau perkara itu.
Dialog: 0,0:29:39.81,0:29:41.51,Lalai,,0,0,0,,Mari, anakku.
Dialog: 0,0:29:44.74,0:29:46.69, Lalai,,0,0,0,,Sinetron.
Dialog: 0,0:29:49.66,0:29:51.73, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:29:51.99,0:29:54.74, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:30:02.38,0:30:03.77,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Mestilah Cinta{\c}{\i0}
Dialog: 0,0:30:03.80,0:30:07.46,Lalai,,0,0,0,,Hyun-woo dan saya mempunyai citarasa yang sama.
Dialog: 0,0:30:18.73,0:30:20.43,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Adakah anda sedang tidur?{\c}{\i0}
Dialog: 0,0:30:39.79,0:30:41.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya akan melakukannya.{\c}{\i0}
Dialog: 0,0:30:41.42,0:30:43.12,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kenapa?{\c}{\i0}
Dialog: 0,0:30:43.84,0:30:46.44,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya perlu pergi kerja awal esok,{\c}{\i0}
Dialog: 0,0:30:46.46,0:30:48.75,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi saya tidak akan dapat melihat anda...{\c}{\i0}
Dialog: 0,0:30:52.93,0:30:55.05, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Esok pergi kerja awal.{\c}{\i0}
Dialog: 0,0:30:55.14,0:30:57.88,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bilakah anda akan pulang...?{\c}{\i0}
Dialog: 0,0:31:03.06,0:31:04.85,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baik.{\c}{\i0}
Dialog: 0,0:31:09.28,0:31:11.26,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perlukah saya berlepas esok?{\c}{\i0}
Dialog: 0,0:31:11.28,0:31:14.28,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bolehkah anda berlepas esok sahaja?{\c}{\i0}
Dialog: 0,0:31:31.93,0:31:33.63,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Selamat malam.{\c}{\i0}
Dialog: 0,0:31:39.18,0:31:42.54, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya akan mendengar lagu\Non MP3 anda sebelum saya tidur.{\c}{\i0}
Dialog: 0,0:31:43.24,0:31:45.17, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Itu? Bagaimanakah lagu-lagunya?{\c}{\i0}
Dialog: 0,0:31:45.19,0:31:46.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Mereka semua orang lama.{\c}{\i0}
Dialog: 0,0:31:46.82,0:31:48.29,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sukakannya.{\c}{\i0}
Dialog: 0,0:31:48.32,0:31:50.42,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Semuanya ialah lagu kegemaran saya.{\c}{\i0}
Dialog: 0,0:31:50.45,0:31:53.05, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}MP3 itu bukan milik saya.{\c}{\i0}
Dialog: 0,0:31:53.07,0:31:54.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Kemudian?\N- Saya mengambilnya pada masa lalu.{\c}{\i0}
Dialog: 0,0:31:54.99,0:31:58.76, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak dapat mencari pemiliknya,\Njadi saya menyimpannya bersama saya selama ini.{\c}{\i0}
Dialog: 0,0:31:58.79,0:31:59.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di manakah anda menemuinya?{\c}{\i0}
Dialog: 0,0:31:59.95,0:32:01.02,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di sekolah menengah saya.{\c}{\i0}
Dialog: 0,0:32:01.04,0:32:03.31, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di padang.{\c}{\i0}
Dialog: 0,0:32:03.33,0:32:06.27,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Awak tidak bersekolah di Hanil Foreign\NLanguage High School?{\c}{\i0}
Dialog: 0,0:32:06.29,0:32:09.58,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ya, saya mengambilnya pada hari pertama saya di sana.{\c}{\i0}
Dialog: 0,0:32:27.07,0:32:28.93, Lalai,,0,0,0,,Apa?
Dialog: 0,0:32:29.86,0:32:32.48, Lalai,,0,0,0,,Jadi ini milik saya?
Dialog: 0,0:32:34.99,0:32:36.69, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tunggu.{\c}{\i0}
Dialog: 0,0:32:59.85,0:33:02.17,Lalai,,0,0,0,,{\i1}Itu...{\i0}
Dialog: 0,0:33:02.23,0:33:04.30, Lalai,,0,0,0,,Hyun-woo?
Dialog: 0,0:33:05.98,0:33:08.47, Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,0:33:09.48,0:33:11.18,Lalai,,0,0,0,,Maksud saya...
Dialog: 0,0:33:11.78,0:33:13.55,Lalai,,0,0,0,,Adakah dia dilahirkan...
Dialog: 0,0:33:13.57,0:33:16.11, Lalai,,0,0,0,,untuk mencintai saya atau sesuatu?
Dialog: 0,0:33:16.91,0:33:19.09,Lalai,,0,0,0,,Dia jatuh cinta kepada saya dalam masa yang singkat itu,
Dialog: 0,0:33:19.12,0:33:21.76,Lalai,,0,0,0,,jadi dia menyimpan ini selama ini.
Dialog: 0,0:33:21.79,0:33:25.60,Lalai,,0,0,0,,Dia akan sangat terkejut jika dia\Nmengetahui gadis yang dia jatuh cinta...
Dialog: 0,0:33:25.62,0:33:27.62, Lalai,,0,0,0,,adalah saya.
Dialog: 0,0:33:32.80,0:33:35.53,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tetapi mengapa anda masih memilikinya?{\c}{\i0}
Dialog: 0,0:33:35.55,0:33:38.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia pasti sangat cantik.{\c}{\i0}
Dialog: 0,0:33:39.14,0:33:40.84,Lalai,,0,0,0,,Apa...?
Dialog: 0,0:33:45.64,0:33:47.34, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:33:50.02,0:33:51.72,Lalai,,0,0,0,,Saya tidak...
Dialog: 0,0:33:53.57,0:33:55.69, Lalai,,0,0,0,,ingat.
Dialog: 0,0:33:56.40,0:33:57.80, Lalai,,0,0,0,,Anda tidak?
Dialog: 0,0:33:57.82,0:33:58.88,Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:33:58.91,0:34:00.94, Lalai,,0,0,0,,Itu tahun lalu.
Dialog: 0,0:34:01.53,0:34:03.01,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:34:03.04,0:34:06.93,Lalai,,0,0,0,,Hakikat bahawa anda masih menyimpan\Nini selama ini mesti bermakna...
Dialog: 0,0:34:06.96,0:34:10.78, Lalai,,0,0,0,, anda tidak dapat mengeluarkannya dari fikiran anda.
Dialog: 0,0:34:10.84,0:34:13.33, Lalai,,0,0,0,,Dia pasti cantik.
Dialog: 0,0:34:15.05,0:34:17.94,Lalai,,0,0,0,,Ayuh. bukan macam tu.
Dialog: 0,0:34:17.97,0:34:19.11, Lalai,,0,0,0,,Saya tidak ingat...
Dialog: 0,0:34:19.14,0:34:22.91,Lalai,,0,0,0,,jika orang itu lelaki,\Nperempuan, seorang guru, seorang pelajar,
Dialog: 0,0:34:22.93,0:34:24.62, Lalai,,0,0,0,,atau pengawal keselamatan.
Dialog: 0,0:34:24.64,0:34:27.09, Lalai,,0,0,0,,Saya tidak ingat apa-apa.
Dialog: 0,0:34:31.94,0:34:34.06, Lalai,,0,0,0,,Kalau begitu kenapa masih menyimpannya?
Dialog: 0,0:34:36.99,0:34:38.94, Lalai,,0,0,0,,Saya tidak menyimpannya.
Dialog: 0,0:34:39.49,0:34:41.90, Lalai,,0,0,0,,Saya hanya menyimpannya.
Dialog: 0,0:34:44.83,0:34:47.24,Lalai,,0,0,0,,Baiklah. awak boleh pergi.
Dialog: 0,0:34:48.54,0:34:51.12, Lalai,,0,0,0,, Pergi. Pergi tidur.
Dialog: 0,0:34:55.55,0:34:57.33, Lalai,,0,0,0,,Apa kali ini?
Dialog: 0,0:34:57.84,0:35:00.08, Lalai,,0,0,0,,Tirai.
Dialog: 0,0:35:00.47,0:35:02.21, Lalai,,0,0,0,,Pastikan anda melukisnya.
Dialog: 0,0:35:02.35,0:35:04.70,Lalai,,0,0,0,,Bilik ini menghadap ke timur,
Dialog: 0,0:35:04.72,0:35:06.74, Lalai,,0,0,0,, jadi ia menjadi agak terang pada waktu pagi.
Dialog: 0,0:35:06.77,0:35:09.09, Lalai,,0,0,0,,Baiklah, jadi pergi.
Dialog: 0,0:38:08.28,0:38:10.59, Lalai,,0,0,0,, Patutkah saya bantu?
Dialog: 0,0:38:10.62,0:38:11.80, Lalai,,0,0,0,,Sudikah anda?
Dialog: 0,0:38:11.83,0:38:14.36,Lalai,,0,0,0,,Saya akan membuat beberapa {\i1}japchae.{\i0}
Dialog: 0,0:38:15.66,0:38:18.62, Lalai,,0,0,0,,Bolehkah anda memotong lobak merah ini untuk saya?
Dialog: 0,0:38:19.88,0:38:21.58,Lalai,,0,0,0,,Okey.
Dialog: 0,0:38:26.38,0:38:29.61, Lalai,,0,0,0,,Sayang, berhati-hati untuk tidak mencincang jari anda.
Dialog: 0,0:38:29.64,0:38:32.66, Lalai,,0,0,0,,Anda perlu mengubahnya.
Dialog: 0,0:38:32.68,0:38:37.72, Lalai,,0,0,0,,Seberapa nipis anda mahu saya memotongnya?
Dialog: 0,0:38:37.81,0:38:41.04, Lalai,,0,0,0,,Nah... Ia...
Dialog: 0,0:38:41.06,0:38:42.93, Lalai,,0,0,0,,Biar saya tunjukkan.
Dialog: 0,0:39:00.12,0:39:01.85, Lalai,,0,0,0,,- Ibu.\N- Ya?
Dialog: 0,0:39:01.88,0:39:04.33, Lalai,,0,0,0,,Anda luar biasa.
Dialog: 0,0:39:04.42,0:39:07.00, Lalai,,0,0,0,,Apa yang luar biasa tentang ini?
Dialog: 0,0:39:10.51,0:39:13.34, Lalai,,0,0,0,,Bagaimana anda boleh berkata begitu? Ini seperti...
Dialog: 0,0:39:13.76,0:39:15.20, Lalai,,0,0,0,,seni moden.
Dialog: 0,0:39:15.22,0:39:17.05,Lalai,,0,0,0,,Betulkah?
Dialog: 0,0:39:17.22,0:39:18.62,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:39:18.64,0:39:20.41, Lalai,,0,0,0,,Itu yang baharu.
Dialog: 0,0:39:20.44,0:39:22.37,Lalai,,0,0,0,,Anda sedang membuat {\i1}japchae,{\i0} kan?
Dialog: 0,0:39:22.40,0:39:25.68, Lalai,,0,0,0,,Apa lagi yang perlu anda lakukan?
Dialog: 0,0:39:25.90,0:39:27.71,Lalai,,0,0,0,,Seterusnya...
Dialog: 0,0:39:27.74,0:39:30.52, Lalai,,0,0,0,,Saya perlu masak telur.
Dialog: 0,0:39:30.65,0:39:32.80, Lalai,,0,0,0,,- Bagaimana sebenarnya anda melakukannya?\N- Telur?
Dialog: 0,0:39:32.82,0:39:35.36, Lalai,,0,0,0,,Ia adalah kek. Patutkah saya tunjukkan?
Dialog: 0,0:39:35.99,0:39:37.86,Lalai,,0,0,0,,Saya teruja.
Dialog: 0,0:39:44.79,0:39:46.15,Lalai,,0,0,0,,Anda sangat luar biasa.
Dialog: 0,0:39:46.17,0:39:48.00, Lalai,,0,0,0,,Saya boleh menggunakan kedua-dua tangan.
Dialog: 0,0:39:49.97,0:39:52.36,Lalai,,0,0,0,,Kebaikan, Ibu.
Dialog: 0,0:39:52.39,0:39:53.99, Lalai,,0,0,0,,Anda benar-benar hebat.
Dialog: 0,0:39:54.01,0:39:56.41,Lalai,,0,0,0,,Adakah saya? Perlukah saya mencubanya juga?
Dialog: 0,0:39:56.43,0:39:58.30, Lalai,,0,0,0,, Satu putaran?
Dialog: 0,0:39:59.06,0:40:02.05, Lalai,,0,0,0,,Saya hanya bergurau.
Dialog: 0,0:40:02.81,0:40:05.04, Lalai,,0,0,0,,Mengapa perubahan hati?
Dialog: 0,0:40:05.06,0:40:06.79,Lalai,,0,0,0,,Awak kata vila awak kosong.
Dialog: 0,0:40:06.82,0:40:09.88, Lalai,,0,0,0,,Apa yang salah? Adakah suami anda menentangnya?
Dialog: 0,0:40:09.90,0:40:12.90,Lalai,,0,0,0,,Sekiranya wartawan mengetahui?
Dialog: 0,0:40:14.03,0:40:15.80, Lalai,,0,0,0,,Dia sukar dipercayai.
Dialog: 0,0:40:15.83,0:40:18.60, Lalai,,0,0,0,,Siapa yang membantunya apabila\N perniagaannya gagal?
Dialog: 0,0:40:18.62,0:40:22.24,Lalai,,0,0,0,,Bagaimana dia boleh melakukan ini kepada\Nsuami saya, semua orang?
Dialog: 0,0:40:22.75,0:40:24.45,Lalai,,0,0,0,,Lupakan.
Dialog: 0,0:40:24.75,0:40:26.45,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,0:40:27.84,0:40:30.08, Lalai,,0,0,0,,Di sini anda.
Dialog: 0,0:40:30.71,0:40:32.90, Lalai,,0,0,0,,Saya mencari anda di merata tempat.
Dialog: 0,0:40:32.93,0:40:34.71, Lalai,,0,0,0,,Kenapa saya?
Dialog: 0,0:40:35.47,0:40:37.36, Lalai,,0,0,0,,Sekarang sudah bersih.
Dialog: 0,0:40:37.39,0:40:39.28, Lalai,,0,0,0,,Mereka tidak berbau sama sekali.
Dialog: 0,0:40:39.31,0:40:40.45, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:40:40.47,0:40:42.91, Lalai,,0,0,0,,- Miliki jika anda mahu.\N- Betulkah?
Dialog: 0,0:40:42.94,0:40:45.25, Lalai,,0,0,0,,Tetapi ia sangat mahal.
Dialog: 0,0:40:45.27,0:40:48.06, Lalai,,0,0,0,,Tidak mengapa. Mereka milik awak.
Dialog: 0,0:40:50.07,0:40:52.46,Lalai,,0,0,0,,Kalau begitu kenapa kamu tidak benarkan saya menyisir rambut kamu?
Dialog: 0,0:40:52.49,0:40:54.27,Lalai,,0,0,0,,Saya sangat mahir.
Dialog: 0,0:41:03.62,0:41:05.60,Lalai,,0,0,0,,Apakah jenis gaya rambut yang anda mahukan?
Dialog: 0,0:41:05.62,0:41:08.41, Lalai,,0,0,0,,Apa yang boleh anda lakukan?
Dialog: 0,0:41:08.54,0:41:10.02, Lalai,,0,0,0,,Semuanya.
Dialog: 0,0:41:10.05,0:41:14.75,Lalai,,0,0,0,,Saya pernah bekerja di Cheongdam-dong, awak tahu?
Dialog: 0,0:41:15.80,0:41:18.57, Lalai,,0,0,0,,Mi-seon, apa yang sedang berlaku?
Dialog: 0,0:41:18.60,0:41:21.70, Lalai,,0,0,0,,Ini adalah kelainan terbaik yang pernah ada\Nsejak "The Sixth Sense."
Dialog: 0,0:41:21.72,0:41:23.79,Lalai,,0,0,0,,Tapak tangan saya pun berpeluh.
Dialog: 0,0:41:23.81,0:41:25.51,Lalai,,0,0,0,,- Hey...\N- Awak jahat mulut musang licik itu.
Dialog: 0,0:41:25.53,0:41:27.91,Lalai,,0,0,0,,Kemudian saya dengar dia tiba-tiba muncul.
Dialog: 0,0:41:27.94,0:41:29.75, Lalai,,0,0,0,,Itu hanya berlaku dalam filem atau drama.
Dialog: 0,0:41:29.77,0:41:31.84, Lalai,,0,0,0,,Ini lebih mendebarkan daripada mana-mana penamat drama.
Dialog: 0,0:41:31.86,0:41:33.63, Lalai,,0,0,0,,- Ya.\N- Jadi apa yang berlaku?
Dialog: 0,0:41:33.65,0:41:35.90,Lalai,,0,0,0,,Kawan-kawan, mari kita bincang nanti.
Dialog: 0,0:41:35.99,0:41:40.61,Lalai,,0,0,0,,Saya dengar ibu Hae-in seorang psikopat.
Dialog: 0,0:41:40.78,0:41:43.43, Lalai,,0,0,0,,Apa maksud anda? Itu hanya omong kosong.
Dialog: 0,0:41:43.45,0:41:45.06, Lalai,,0,0,0,,- Pergi!\N- Tunggu!
Dialog: 0,0:41:45.08,0:41:49.23, Lalai,,0,0,0,,Saya tidak akan pergi. Suami saya memberitahu saya segala-galanya.
Dialog: 0,0:41:49.25,0:41:51.98,Lalai,,0,0,0,,Saya dengar dia terpijak\Ndung sebaik dia tiba,
Dialog: 0,0:41:52.00,0:41:54.12, Lalai,,0,0,0,,dan menangis sungai.
Dialog: 0,0:41:57.80,0:42:01.84, Lalai,,0,0,0,,Sangat gila. Bagaimana dia boleh melangkah\Bukan tahi sebaik sahaja dia tiba?
Dialog: 0,0:42:02.14,0:42:03.33, Lalai,,0,0,0,,Berterus terang.
Dialog: 0,0:42:03.35,0:42:06.45,Lalai,,0,0,0,,- Mak awak yang pijak.\N- Betul.
Dialog: 0,0:42:06.48,0:42:09.25, Lalai,,0,0,0,,Mereka bekas mertua yang\Menyingkirkan sesuatu dengan teruk.
Dialog: 0,0:42:09.27,0:42:12.00,Lalai,,0,0,0,,Keluarga miskin itu melarikan diri\N tengah malam,
Dialog: 0,0:42:12.02,0:42:13.50,Lalai,,0,0,0,,dan Cikgu Jeon terpaksa menerima mereka.
Dialog: 0,0:42:13.53,0:42:17.05, Lalai,,0,0,0,,Ya, saya melihat berita itu. Mereka\Ntiada apa-apa nama mereka sekarang.
Dialog: 0,0:42:17.07,0:42:21.89,Lalai,,0,0,0,,Ibu anda mungkin kelihatan tegar,\Ntapi dia seorang yang lembut hati.
Dialog: 0,0:42:21.91,0:42:24.15, Lalai,,0,0,0,,- Ya.\N- Terima kasih.
Dialog: 0,0:42:26.04,0:42:29.81,Default,,0,0,0,,By the way, bukankah wanita itu sangat tidak tahu malu?
Dialog: 0,0:42:29.83,0:42:32.48, Lalai,,0,0,0,,Beraninya dia datang ke sini selepas apa yang dia lakukan?
Dialog: 0,0:42:32.50,0:42:34.31, Lalai,,0,0,0,,- Betul.\N- Anda tahu apa?
Dialog: 0,0:42:34.34,0:42:36.90,Lalai,,0,0,0,,Saya ingin melihat wajahnya sekali sahaja.
Dialog: 0,0:42:36.92,0:42:37.98, Lalai,,0,0,0,,Saya juga.
Dialog: 0,0:42:38.01,0:42:41.50,Lalai,,0,0,0,,Apa? Adakah terdapat sesuatu di bibir saya?
Dialog: 0,0:42:45.81,0:42:47.68, Lalai,,0,0,0,,Kemudian lihat.
Dialog: 0,0:42:48.35,0:42:51.39,Lalai,,0,0,0,,Anda mahu berjumpa saya, jadi lihat baik-baik.
Dialog: 0,0:42:54.61,0:42:56.59, Lalai,,0,0,0,,Aset kami hanya dibekukan buat masa ini.
Dialog: 0,0:42:56.61,0:42:57.96, Lalai,,0,0,0,,Kami bukan miskin.
Dialog: 0,0:42:57.99,0:43:01.38,Lalai,,0,0,0,,Walaupun sudah lewat ketika kami tiba,\Nkami tidak melarikan diri di tengah malam,
Dialog: 0,0:43:01.40,0:43:03.40,Lalai,,0,0,0,,dan kami akan pergi tidak lama lagi.
Dialog: 0,0:43:03.49,0:43:06.01, Lalai,,0,0,0,,Kami tidak mengejek mereka.
Dialog: 0,0:43:06.04,0:43:07.90,Lalai,,0,0,0,,Awak faham?
Dialog: 0,0:43:08.62,0:43:10.37, Lalai,,0,0,0,,- Ya.\N- Ya.
Dialog: 0,0:43:11.88,0:43:13.19,Lalai,,0,0,0,,Astaga.
Dialog: 0,0:43:13.21,0:43:15.54, Lalai,,0,0,0,,Awak ambil saya untuk apa?
Dialog: 0,0:43:16.84,0:43:18.54, Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:43:20.43,0:43:22.13, Lalai,,0,0,0,,Hei.
Dialog: 0,0:43:22.39,0:43:24.07, Lalai,,0,0,0,,Anda tidak bersarapan.
Dialog: 0,0:43:24.10,0:43:27.20, Lalai,,0,0,0,,Saya bawa ini ke kebun.
Dialog: 0,0:43:27.22,0:43:29.62, Lalai,,0,0,0,,Mee sup kacang sejuk\Sedap dan menyegarkan.
Dialog: 0,0:43:29.64,0:43:31.39, Lalai,,0,0,0,,Adakah anda mahukan beberapa?
Dialog: 0,0:43:38.07,0:43:41.44, Lalai,,0,0,0,,Saya tidak mempunyai karbohidrat pada siang hari.
Dialog: 0,0:43:48.45,0:43:52.45,Lalai,,0,0,0,,Astaga. Kemudian bilakah anda akan memilikinya?
Dialog: 0,0:44:01.30,0:44:04.32, Lalai,,0,0,0,,Apakah perasaan anda tentang\Nmenjadi pengerusi termuda?
Dialog: 0,0:44:04.35,0:44:06.11, Lalai,,0,0,0,,Apakah rancangan anda?
Dialog: 0,0:44:06.14,0:44:08.27, Lalai,,0,0,0,,Adakah ia berbeza daripada\Npengurusan sebelumnya?
Dialog: 0,0:44:08.29,0:44:11.20,Lalai,,0,0,0,,Terdapat khabar angin tentang penstrukturan semula berskala besar. Adakah ia benar?
Dialog: 0,0:44:11.23,0:44:13.35, Lalai,,0,0,0,,Bagaimana keadaan Pengerusi Hong?
Dialog: 0,0:44:19.65,0:44:22.59,Lalai,,0,0,0,,Saya bercadang untuk menubuhkan sebuah\Nperbadanan di Singapura menjelang 2025,
Dialog: 0,0:44:22.61,0:44:26.30, Lalai,,0,0,0,, supaya kita boleh bercabang ke pasaran asing.
Dialog: 0,0:44:26.33,0:44:28.68,Lalai,,0,0,0,,Kami memerlukan kira-kira $140 juta untuk menubuhkan...
Dialog: 0,0:44:28.70,0:44:31.27, Lalai,,0,0,0,,dan jalankan syarikat ini\Nitu akan berfungsi sebagai asas...
Dialog: 0,0:44:31.29,0:44:33.52, Lalai,,0,0,0,,untuk gedung serbaneka dan pasar raya di luar negara.
Dialog: 0,0:44:33.54,0:44:36.44, Lalai,,0,0,0,,{\an8}Saya melawat Encik Song di\Npenitentiary dan bercakap dengannya.
Dialog: 0,0:44:36.46,0:44:40.23,Lalai,,0,0,0,,Saya rasa dia tidak tahu di mana\Ntabung rahsia pengerusi.
Dialog: 0,0:44:40.26,0:44:42.44,Lalai,,0,0,0,,Dia mencipta dana dan memindahkannya ke luar negara,
Dialog: 0,0:44:42.47,0:44:45.65,Lalai,,0,0,0,,tetapi dia tidak tahu di mana ia berada.
Dialog: 0,0:44:45.68,0:44:46.70, Lalai,,0,0,0,,Bagaimana mungkin?
Dialog: 0,0:44:46.72,0:44:49.99,Lalai,,0,0,0,,Pejabat pengerusi\Nmenguruskan lejar secara manual,
Dialog: 0,0:44:50.02,0:44:52.04, Lalai,,0,0,0,,dan menyerahkannya kepada pengerusi untuk disemak.
Dialog: 0,0:44:52.06,0:44:56.71, Lalai,,0,0,0,,Proses pemutihan adalah rumit,\Nmemandangkan mereka melalui sepuluh negara.
Dialog: 0,0:44:56.73,0:45:00.71,Lalai,,0,0,0,,Destinasi terakhir ialah\Na bank di Labuan, Malaysia,
Dialog: 0,0:45:00.73,0:45:02.89, Lalai,,0,0,0,,tetapi wang itu tiada.
Dialog: 0,0:45:11.83,0:45:14.36, Lalai,,0,0,0,,Anda mahu berjumpa saya, Pengerusi Yoon?
Dialog: 0,0:45:16.33,0:45:18.03, Lalai,,0,0,0,,Anda tidak teragak-agak...
Dialog: 0,0:45:18.46,0:45:20.06, Lalai,,0,0,0,,untuk memanggil saya begitu.
Dialog: 0,0:45:20.09,0:45:21.40, Lalai,,0,0,0,,Mengapa saya perlu?
Dialog: 0,0:45:21.42,0:45:22.61, Lalai,,0,0,0,,Perkara telah berubah.
Dialog: 0,0:45:22.63,0:45:26.53,Lalai,,0,0,0,,Saya bukan lagi sebahagian daripada\NQueens atau suami Hae-in.
Dialog: 0,0:45:26.55,0:45:28.25,Lalai,,0,0,0,,Saya nampak,
Dialog: 0,0:45:28.60,0:45:29.57,Lalai,,0,0,0,,tapi sayang.
Dialog: 0,0:45:29.60,0:45:33.70,Lalai,,0,0,0,,Saya berasa tidak selesa kerana anda\Nmasih mengetuai pasukan undang-undang kami.
Dialog: 0,0:45:33.73,0:45:36.43,Lalai,,0,0,0,,Sudah tentu. saya faham.
Dialog: 0,0:45:37.94,0:45:39.64,Lalai,,0,0,0,,En. Baek.
Dialog: 0,0:45:42.57,0:45:44.27,Lalai,,0,0,0,,Lepaskan perbuatan itu, sudah.
Dialog: 0,0:45:49.45,0:45:53.24,Lalai,,0,0,0,,Saya jujur, kerana anda\N nampaknya tahu segala-galanya.
Dialog: 0,0:45:53.62,0:45:55.41,Lalai,,0,0,0,,Saya masih menunggu.
Dialog: 0,0:45:55.83,0:45:58.85, Lalai,,0,0,0,,Saya menyerahkan resume saya kepada\NBaekhwa, Taepung, Hwang & Kim.
Dialog: 0,0:45:58.88,0:46:01.90,Lalai,,0,0,0,,Kami masih merundingkan gaji saya,\Ntapi ia bukan mudah dalam bidang ini.
Dialog: 0,0:46:01.92,0:46:04.73,Lalai,,0,0,0,,Sukar untuk menaikkan gaji anda\Jika anda telah berehat.
Dialog: 0,0:46:04.76,0:46:09.11, Lalai,,0,0,0,,Seperti yang anda sedia maklum,\NI tidak menerima sebarang nafkah,
Dialog: 0,0:46:09.14,0:46:11.74, Lalai,,0,0,0,,jadi saya perlu membuat kerja ini.
Dialog: 0,0:46:11.76,0:46:14.26, Lalai,,0,0,0,,Saya hanya perlukan sebulan.
Dialog: 0,0:46:14.43,0:46:17.34, Lalai,,0,0,0,,Bolehkah anda membantu saya?
Dialog: 0,0:46:18.69,0:46:20.71, Lalai,,0,0,0,,Jadi anda sedang mencari kerja baharu?
Dialog: 0,0:46:20.73,0:46:22.08, Lalai,,0,0,0,,Betul, dan seperti yang anda tahu,
Dialog: 0,0:46:22.11,0:46:25.50,Lalai,,0,0,0,,Saya tidak mempunyai akses kepada dokumen terperingkat\Nteam yang sah.
Dialog: 0,0:46:25.53,0:46:27.85, Lalai,,0,0,0,,Tiada apa yang perlu dirisaukan.
Dialog: 0,0:46:32.12,0:46:33.82, Lalai,,0,0,0,,Anda boleh pergi.
Dialog: 0,0:46:36.75,0:46:38.53,Lalai,,0,0,0,,Di mana dia?
Dialog: 0,0:46:40.04,0:46:41.27,Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:46:41.29,0:46:43.83,Lalai,,0,0,0,,Bukankah kamu yang menjemputnya semalam?
Dialog: 0,0:46:48.63,0:46:50.38, Lalai,,0,0,0,, Jadi di mana dia?
Dialog: 0,0:46:51.85,0:46:53.55,Lalai,,0,0,0,,Saya takut...
Dialog: 0,0:46:53.68,0:46:55.80,Lalai,,0,0,0,,Saya pun tak tahu.
Dialog: 0,0:46:56.85,0:47:00.22,Lalai,,0,0,0,,Anda telah menjemputnya, tetapi anda\Tidak tahu ke mana dia pergi?
Dialog: 0,0:47:00.48,0:47:01.58,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:47:01.61,0:47:03.25, Lalai,,0,0,0,,Saya rasa dia tidak boleh mempercayai saya.
Dialog: 0,0:47:03.27,0:47:06.09, Lalai,,0,0,0,,Dia mengambil kereta itu dan belum mengangkatnya.
Dialog: 0,0:47:06.11,0:47:07.75, Lalai,,0,0,0,,Sila beritahu saya...
Dialog: 0,0:47:07.78,0:47:09.98, Lalai,,0,0,0,,jika anda menjumpainya.
Dialog: 0,0:47:11.11,0:47:12.81, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:47:45.86,0:47:49.48,Lalai,,0,0,0,,Anda pemilik sebenar cawan teh ini.
Dialog: 0,0:47:49.53,0:47:51.21,Lalai,,0,0,0,,Ia lebih sesuai dengan anda.
Dialog: 0,0:47:51.24,0:47:53.72,Lalai,,0,0,0,,Saya suka pakaian awak juga.
Dialog: 0,0:47:53.74,0:47:56.72,Lalai,,0,0,0,,Anda kelihatan glamor dan elegan. Itu jarang berlaku.
Dialog: 0,0:47:56.74,0:48:01.11,Lalai,,0,0,0,,Inilah sebabnya saya tidak berdandan.\NIMudah untuk saya kelihatan glamor.
Dialog: 0,0:48:01.75,0:48:04.48, Lalai,,0,0,0,,Sila datang ke spa sebelum saya menutupnya.
Dialog: 0,0:48:04.50,0:48:06.60, Lalai,,0,0,0,,Biar saya jaga awak buat kali terakhir.
Dialog: 0,0:48:06.63,0:48:08.87, Lalai,,0,0,0,,Adakah anda menutupnya?
Dialog: 0,0:48:10.55,0:48:11.53,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:48:11.55,0:48:13.88, Lalai,,0,0,0,,Kenapa? Bukankah perniagaan sudah bagus?
Dialog: 0,0:48:20.23,0:48:22.89, Lalai,,0,0,0,,Sudah tentu anda harus menutupnya.
Dialog: 0,0:48:23.10,0:48:24.08, Lalai,,0,0,0,, Betul?
Dialog: 0,0:48:24.10,0:48:25.54,Lalai,,0,0,0,,Anda sudah lama mengalaminya.
Dialog: 0,0:48:25.56,0:48:26.79,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:48:26.82,0:48:30.89,Lalai,,0,0,0,,Saya fikir saya akan menjadi tua sambil\Nmenjadikan orang lain kelihatan lebih muda.
Dialog: 0,0:48:31.24,0:48:33.31, Lalai,,0,0,0,,- Itu tidak boleh berlaku.\N- Betul?
Dialog: 0,0:48:35.07,0:48:38.05,Lalai,,0,0,0,,Sebaik sahaja saya memegang jawatan, saya mahu\Nmelancarkan rangkaian kosmetik...
Dialog: 0,0:48:38.08,0:48:40.01, Lalai,,0,0,0,,dengan produk dari gedung serbaneka.
Dialog: 0,0:48:40.04,0:48:41.10, Lalai,,0,0,0,,Apa kata anda?
Dialog: 0,0:48:41.12,0:48:44.27, Lalai,,0,0,0,,Sama seperti Lafayette atau Harrods,
Dialog: 0,0:48:44.29,0:48:46.77,Lalai,,0,0,0,,kita harus memberikan kedai kita\Na reputasi mewah...
Dialog: 0,0:48:46.79,0:48:47.90,Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:48:47.92,0:48:49.66, Lalai,,0,0,0,,"Ambil jawatan"?
Dialog: 0,0:48:50.26,0:48:52.67, Lalai,,0,0,0,,- Apa?\N- Di mana?
Dialog: 0,0:48:53.43,0:48:56.21,Lalai,,0,0,0,,Bukankah saya mengambil alih tempat Hae-in?
Dialog: 0,0:48:56.72,0:48:59.62, Lalai,,0,0,0,,Adakah ia kelihatan terlalu pelik\Jika saya mengambil alih serta-merta?
Dialog: 0,0:48:59.64,0:49:02.34,Lalai,,0,0,0,,Lalu bagaimana dengan pengarah dahulu?
Dialog: 0,0:49:09.40,0:49:11.10,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:49:12.57,0:49:14.52,Lalai,,0,0,0,,Tutup spa anda,
Dialog: 0,0:49:15.41,0:49:17.76, Lalai,,0,0,0,,kemas barang anda dan\Sertai Pengarah Jo di A.S.
Dialog: 0,0:49:17.78,0:49:21.69,Lalai,,0,0,0,,Kami terlalu banyak kerugian jika mereka menangkap anda di sini.
Dialog: 0,0:49:22.58,0:49:26.18, Lalai,,0,0,0,,Anda boleh memulakan baris\Nkosmetik kecil di sana jika anda mahu.
Dialog: 0,0:49:26.21,0:49:28.58,Lalai,,0,0,0,,Saya akan mencari beberapa pelabur.
Dialog: 0,0:49:35.29,0:49:38.00,Lalai,,0,0,0,,{\i1}Anda boleh menutup perniagaan anda,\Nbergerak dan bersembunyi,{\i0}
Dialog: 0,0:49:38.04,0:49:40.52,Lalai,,0,0,0,,{\i1}tetapi satu perkara yang anda tidak boleh\Nubah ialah akademi anak anda...{\i0}
Dialog: 0,0:49:40.54,0:49:41.57,Lalai,,0,0,0,,{\i1}jika anda seorang ibu bapa.{\i0}
Dialog: 0,0:49:41.60,0:49:42.99,Lalai,,0,0,0,,{\i1}Anak perempuannya seorang senior.{\i0}
Dialog: 0,0:49:43.02,0:49:46.68,Lalai,,0,0,0,,{\i1}Dia sedang bersedia untuk pergi ke\Nkolej dengan mengambil jurusan cello.{\i0}
Dialog: 0,0:49:47.94,0:49:51.71,Lalai,,0,0,0,,Saya menyaman anda kerana penipuan dan melanggar\NAkta Privasi Komunikasi,
Dialog: 0,0:49:51.73,0:49:54.26,Lalai,,0,0,0,,tetapi mereka tidak dapat menghantar surat kepada anda\Nkertas anda tiada.
Dialog: 0,0:49:54.28,0:49:56.40,Lalai,,0,0,0,,Saya mencari anda di merata tempat.
Dialog: 0,0:50:08.38,0:50:10.52, Lalai,,0,0,0,,Jadi dia mempunyai perkara ini selama ini.
Dialog: 0,0:50:10.54,0:50:12.50, Lalai,,0,0,0,,Dia mesti telah membuat salinan.
Dialog: 0,0:50:13.26,0:50:15.00, Lalai,,0,0,0,,Siapa dia?
Dialog: 0,0:50:18.84,0:50:21.57,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Soo-cheol, izinkan saya mendedahkan kebenaran...{\c}{\i0}
Dialog: 0,0:50:21.60,0:50:24.53,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}tentang bekas isteri anda, Cheon Da-hye.{\c}{\i0}
Dialog: 0,0:50:24.56,0:50:26.59,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ia mungkin menakutkan anda sedikit.{\c}{\i0}
Dialog: 0,0:50:27.52,0:50:31.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda kata anda akan mendapat ruam hanya\Berada di sebelah wanita yang lebih tua,{\c}{\i0}
Dialog: 0,0:50:31.11,0:50:34.27, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}tetapi anda lihat, saya lima tahun lebih tua daripada anda.{\c}{\i0}
Dialog: 0,0:50:34.36,0:50:38.67,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Segala-galanya tentang ibu bapa saya,\Nkekayaan mereka dan pendidikan saya adalah palsu.{\c}{\i0}
Dialog: 0,0:50:38.70,0:50:42.78, Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Satu lagi. Geon-u bukan anak awak.{\c}{\i0}
Dialog: 0,0:50:43.79,0:50:45.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimanakah ia tidak jelas?{\c}{\i0}
Dialog: 0,0:50:45.37,0:50:48.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda mempunyai ciri yang tajam,\Nmanakala Geon-u lembut.{\c}{\i0}
Dialog: 0,0:50:48.37,0:50:50.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimanakah anda tidak boleh mengesyakinya?{\c}{\i0}
Dialog: 0,0:50:51.75,0:50:54.62,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya turut sedih meninggalkan kamu.{\c}{\i0}
Dialog: 0,0:50:55.92,0:50:58.19,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak akan bertemu lelaki lain seperti kamu.{\c}{\i0}
Dialog: 0,0:50:58.22,0:51:00.32,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda akan berkahwin dengan saya, atau tidak?{\c}{\i0}
Dialog: 0,0:51:00.34,0:51:02.04, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya kata tidak.{\c}{\i0}
Dialog: 0,0:51:02.72,0:51:05.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baik, tetapi berikan saya sarung tangan anda.{\c}{\i0}
Dialog: 0,0:51:06.86,0:51:08.04, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda perit lagi kekok.{\c}{\i0}
Dialog: 0,0:51:08.06,0:51:09.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Siapa nama saya lagi?{\c}{\i0}
Dialog: 0,0:51:09.39,0:51:10.75, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cheon Da-hye.{\c}{\i0}
Dialog: 0,0:51:10.77,0:51:12.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda kaya, tetapi anda tidak terlalu pintar.{\c}{\i0}
Dialog: 0,0:51:12.73,0:51:16.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bolehkah awak berjanji bahawa saya tidak perlu berkahwin dengan awak?{\c}{\i0}
Dialog: 0,0:51:16.28,0:51:17.34, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya.{\c}{\i0}
Dialog: 0,0:51:17.36,0:51:20.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sebenarnya, adakah peredam itu hangat?{\c}{\i0}
Dialog: 0,0:51:37.32,0:51:42.11, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda sepatutnya mengenali saya\Selepas memberikan saya semua yang saya mahu.{\c}{\i0}
Dialog: 0,0:51:42.14,0:51:44.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sila beri mereka tepukan...{\c}{\i0}
Dialog: 0,0:51:44.14,0:51:47.42, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}semasa mereka memulakan perjalanan baharu mereka.{\c}{\i0}
Dialog: 0,0:51:51.06,0:51:53.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka berdua tampan.{\c}{\i0}
Dialog: 0,0:51:53.27,0:51:54.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hei.{\c}{\i0}
Dialog: 0,0:51:54.40,0:51:56.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan buat saya kecewa.{\c}{\i0}
Dialog: 0,0:51:56.40,0:51:59.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sangat jengkel apabila\NHae-in enggan mendengar saya,{\c}{\i0}
Dialog: 0,0:51:59.28,0:52:00.96, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan sebaliknya memilih lelaki itu.{\c}{\i0}
Dialog: 0,0:52:00.99,0:52:04.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lebih baik kamu memikat Soo-cheol\Nand berkahwin dengan dia segera.{\c}{\i0}
Dialog: 0,0:52:04.57,0:52:05.97, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baiklah.{\c}{\i0}
Dialog: 0,0:52:05.99,0:52:07.60,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan beritahu dia nama sebenar anda.{\c}{\i0}
Dialog: 0,0:52:07.62,0:52:08.89, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Gunakan yang palsu.{\c}{\i0}
Dialog: 0,0:52:08.91,0:52:11.31, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak, saya akan menggunakan nama sebenar saya.{\c}{\i0}
Dialog: 0,0:52:11.33,0:52:13.95,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}By the way, di mana dia?{\c}{\i0}
Dialog: 0,0:52:14.00,0:52:15.35, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Di sana.{\c}{\i0}
Dialog: 0,0:52:15.38,0:52:16.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan sekali-kali berkahwin.{\c}{\i0}
Dialog: 0,0:52:16.84,0:52:18.02, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia sangat sibuk.{\c}{\i0}
Dialog: 0,0:52:18.05,0:52:19.07, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Tidak boleh.\N- Saya tahu.{\c}{\i0}
Dialog: 0,0:52:19.09,0:52:21.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itukah bayi cengeng yang saya kenali?{\c}{\i0}
Dialog: 0,0:52:21.47,0:52:23.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia sangat tinggi... Hanya jenis saya.{\c}{\i0}
Dialog: 0,0:52:23.43,0:52:26.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak, di belakangnya.{\c}{\i0}
Dialog: 0,0:52:36.69,0:52:38.67, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Si bodoh itu. Dia tidak berubah.{\c}{\i0}
Dialog: 0,0:52:38.69,0:52:42.77, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Astaga.\N- Bagaimanapun, makan, kerana anda masih di sini.{\c}{\i0}
Dialog: 0,0:52:44.49,0:52:46.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Selamat tinggal.{\c}{\i0}
Dialog: 0,0:53:00.55,0:53:01.98,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Tuan.\N- Senang berjumpa dengan awak.{\c}{\i0}
Dialog: 0,0:53:02.01,0:53:04.07, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Di manakah anda? Saya sedang mencari awak.{\c}{\i0}
Dialog: 0,0:53:04.09,0:53:05.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya gembira anda berada di sini.{\c}{\i0}
Dialog: 0,0:53:05.43,0:53:06.70, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Makan.{\c}{\i0}
Dialog: 0,0:53:06.72,0:53:10.42,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tetapi anda gagal mengenali saya.{\c}{\i0}
Dialog: 0,0:53:24.15,0:53:25.46, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Helo.{\c}{\i0}
Dialog: 0,0:53:25.49,0:53:27.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nama saya Cheon Da-hye.{\c}{\i0}
Dialog: 0,0:53:27.87,0:53:29.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}"Cheon Da-hye"?{\c}{\i0}
Dialog: 0,0:53:33.91,0:53:36.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu nama yang cantik,{\c}{\i0}
Dialog: 0,0:53:36.08,0:53:38.48, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan begitu juga wajah anda.{\c}{\i0}
Dialog: 0,0:53:38.50,0:53:40.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya faham.{\c}{\i0}
Dialog: 0,0:53:41.63,0:53:44.65,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda belum makan lagi.{\c}{\i0}
Dialog: 0,0:53:44.67,0:53:46.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mari kita lihat...{\c}{\i0}
Dialog: 0,0:53:46.13,0:53:47.95,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Lupakan saya,{\c}{\i0}
Dialog: 0,0:53:47.97,0:53:50.82,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}seperti yang anda lakukan pada masa lalu.{\c}{\i0}
Dialog: 0,0:53:50.85,0:53:52.20,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Geon-u juga.{\c}{\i0}
Dialog: 0,0:53:52.22,0:53:55.72, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ia tidak sukar. Bagaimanapun, anda\Ntidak begitu cerah.{\c}{\i0}
Dialog: 0,0:54:05.82,0:54:07.52, Lalai,,0,0,0,,Hei.
Dialog: 0,0:54:09.12,0:54:10.82, Lalai,,0,0,0,,Kenapa awak menangis?
Dialog: 0,0:54:12.04,0:54:15.57,Lalai,,0,0,0,,Di mana saya akan mencari Da-hye?
Dialog: 0,0:54:20.63,0:54:21.94, Lalai,,0,0,0,,Anda tidak boleh.
Dialog: 0,0:54:21.96,0:54:24.91, Lalai,,0,0,0,,Dia mengambil segala-galanya dan\Nmungkin bersembunyi.
Dialog: 0,0:54:26.22,0:54:29.32, Lalai,,0,0,0,,Tidak, anda silap. Dia terlupa sesuatu.
Dialog: 0,0:54:29.34,0:54:31.13, Lalai,,0,0,0,,Apa?
Dialog: 0,0:54:31.18,0:54:33.30, Lalai,,0,0,0,,Saya.
Dialog: 0,0:54:34.68,0:54:37.09, Lalai,,0,0,0,,Saya masih di sini.
Dialog: 0,0:54:37.94,0:54:39.80, Lalai,,0,0,0,,Dia pernah berkata...
Dialog: 0,0:54:40.40,0:54:43.14,Lalai,,0,0,0,,Saya adalah orang yang paling berharga,
Dialog: 0,0:54:44.73,0:54:48.02,Lalai,,0,0,0,,jadi ke mana dia pergi selepas meninggalkan saya?
Dialog: 0,0:55:24.23,0:55:26.00, Lalai,,0,0,0,,Aduh, awak dah bangun?
Dialog: 0,0:55:26.03,0:55:27.29, Lalai,,0,0,0,,Hai, anda sudah bangun.
Dialog: 0,0:55:27.32,0:55:30.02, Lalai,,0,0,0,,Tahan.
Dialog: 0,0:55:42.17,0:55:43.60, Lalai,,0,0,0,,Lihat ini, Geon-u.
Dialog: 0,0:55:43.63,0:55:47.20, Lalai,,0,0,0,,Ia pernah menjadi anak patung kegemaran saya.
Dialog: 0,0:55:52.64,0:55:55.32, Lalai,,0,0,0,,Tetapi apa gunanya melakukan ini sekarang?
Dialog: 0,0:55:55.35,0:55:57.03, Lalai,,0,0,0,,Jadual telah ditukar.
Dialog: 0,0:55:57.06,0:55:58.95, Lalai,,0,0,0,,- Saya akan kembalikannya semula.\N- Tetapi bagaimana?
Dialog: 0,0:55:58.98,0:56:02.16,Lalai,,0,0,0,,Eun-sung tidak mencapai apa yang dia\N lakukan secara sah, dan saya akan membuktikannya.
Dialog: 0,0:56:02.19,0:56:03.33, Lalai,,0,0,0,, Baik.
Dialog: 0,0:56:03.35,0:56:06.75,Lalai,,0,0,0,,Katakanlah ia menyalahi undang-undang\Nand kami mempunyai semua bukti.
Dialog: 0,0:56:06.78,0:56:09.65, Lalai,,0,0,0,,Memfailkan saman, menghadiri perbicaraan,\Menuntutnya semula untuk mendapatkan saham...
Dialog: 0,0:56:09.67,0:56:11.46, Lalai,,0,0,0,,Ia akan mengambil masa sekurang-kurangnya lima tahun.
Dialog: 0,0:56:11.49,0:56:13.14,Lalai,,0,0,0,,- Adakah anda pasti?\N- Saya akan mengambil jalan pintas.
Dialog: 0,0:56:13.17,0:56:15.37,Lalai,,0,0,0,,- Yang mana?\N- Penipuan pelaburan.
Dialog: 0,0:56:15.93,0:56:17.80, Lalai,,0,0,0,,Dia merancang penipuan pelaburan $2 bilion...
Dialog: 0,0:56:17.83,0:56:19.68,Lalai,,0,0,0,,dari awal, dan memikat keluarga...
Dialog: 0,0:56:19.70,0:56:22.87, Lalai,,0,0,0,,dengan idea perniagaan baharu untuk mencuri saham mereka.
Dialog: 0,0:56:23.08,0:56:26.35,Lalai,,0,0,0,,Mereka akan mendapat semula\Nsita sementara mereka jika saya dapat membuktikannya,
Dialog: 0,0:56:26.38,0:56:28.73, Lalai,,0,0,0,,tetapi yang paling penting, dia akan kehilangan kuasanya.
Dialog: 0,0:56:28.76,0:56:29.77, Lalai,,0,0,0,,Bagaimana pula dengan saham?
Dialog: 0,0:56:29.80,0:56:32.19, Lalai,,0,0,0,,Stok tetap miliknya.
Dialog: 0,0:56:32.22,0:56:34.92, Lalai,,0,0,0,,Saya akan menggunakan taktik yang sama yang dia lakukan.
Dialog: 0,0:56:42.19,0:56:44.83, Lalai,,0,0,0,,- Awak buat apa?\N- Saya ada banyak masa.
Dialog: 0,0:56:44.85,0:56:47.67, Lalai,,0,0,0,,Mereka sepatutnya memberi kami\Njawatan baharu. Saya berasa tidak senang di sini.
Dialog: 0,0:56:47.69,0:56:49.21, Lalai,,0,0,0,,Saya berasa teruk.
Dialog: 0,0:56:49.23,0:56:51.38,Lalai,,0,0,0,,Saya tidak pernah menolak panggilan Encik Hong sebelum ini.
Dialog: 0,0:56:51.40,0:56:52.42, Lalai,,0,0,0,,Jangan berasa sedih.
Dialog: 0,0:56:52.45,0:56:55.17,Lalai,,0,0,0,,Sebaik-baiknya putuskan hubungan dengan segera.
Dialog: 0,0:56:55.20,0:56:57.62,Lalai,,0,0,0,,Bukankah awak cukup rapat dengan Cik Hong?
Dialog: 0,0:56:57.64,0:56:58.68, Lalai,,0,0,0,,Siapa itu?
Dialog: 0,0:56:58.70,0:57:00.30, Lalai,,0,0,0,,- Aduh.\N- Aduh.
Dialog: 0,0:57:00.33,0:57:04.64, Lalai,,0,0,0,,Tahukah anda mengapa "persahabatan"\Nand "kesetiaan" ialah kata nama abstrak?
Dialog: 0,0:57:04.67,0:57:06.70, Lalai,,0,0,0,, Kerana ia tidak wujud.
Dialog: 0,0:57:09.21,0:57:12.27,Lalai,,0,0,0,,Setiausaha Na dan Cik Hong nampaknya tidak berhubung langsung.
Dialog: 0,0:57:12.30,0:57:13.78, Lalai,,0,0,0,,Dia sedang mengambil cuti.
Dialog: 0,0:57:13.80,0:57:15.90, Lalai,,0,0,0,,Dia akan tinggal di ladang bersama anaknya.
Dialog: 0,0:57:15.93,0:57:18.11,Lalai,,0,0,0,,- Dan Encik Baek?\N- Dia tiada kerja hari ini,
Dialog: 0,0:57:18.14,0:57:20.41, Lalai,,0,0,0,,jadi dia telah menulis resume...
Dialog: 0,0:57:20.43,0:57:23.01, Lalai,,0,0,0,, dan menghadiri temu duga kerja juga.
Dialog: 0,0:57:27.06,0:57:29.88, Lalai,,0,0,0,,Saya tidak mahu mendengarnya!\NBSahkan eksekutif!
Dialog: 0,0:57:29.90,0:57:32.00, Lalai,,0,0,0,,- Tangkap mereka!\N- Tangkap mereka!
Dialog: 0,0:57:32.03,0:57:34.80,Lalai,,0,0,0,,{\an8}Kami menuntut Queens\Nmenyelesaikan penipuan pelaburan ini!
Dialog: 0,0:57:34.82,0:57:36.67, Lalai,,0,0,0,,Hei, apa rancangan awak?
Dialog: 0,0:57:36.70,0:57:37.68, Lalai,,0,0,0,,Mereka kelihatan marah.
Dialog: 0,0:57:37.70,0:57:40.47, Lalai,,0,0,0,,Pengarah undang-undang juga menyebelahi mereka!
Dialog: 0,0:57:40.49,0:57:41.93, Lalai,,0,0,0,,Anda berkahwin dengan keluarga itu!
Dialog: 0,0:57:41.95,0:57:42.97, Lalai,,0,0,0,,Tidak, anda silap.
Dialog: 0,0:57:43.00,0:57:45.06, Lalai,,0,0,0,,Dia telah dipecat dari kerja dan rumah.
Dialog: 0,0:57:45.08,0:57:47.78, Lalai,,0,0,0,,Dia tidak mempunyai pengaruh apa-apa.
Dialog: 0,0:57:50.38,0:57:52.41,Lalai,,0,0,0,,Bagaimanapun...
Dialog: 0,0:57:52.55,0:57:54.73, Lalai,,0,0,0,,Saya datang ke sini untuk mendengar anda.
Dialog: 0,0:57:54.76,0:57:56.49,Lalai,,0,0,0,,Kami telah pun menceritakan kisah kami.
Dialog: 0,0:57:56.51,0:57:59.57,Lalai,,0,0,0,,Ratu memikat kami dengan menawarkan\Nuntuk membayar lima kali ganda harga pasaran.
Dialog: 0,0:57:59.60,0:58:01.99,Lalai,,0,0,0,,Kemudian mereka berkata projek resort\Nkompleks gagal,
Dialog: 0,0:58:02.01,0:58:04.30, Lalai,,0,0,0,,dan ditawarkan hanya dua kali ganda?
Dialog: 0,0:58:05.23,0:58:07.62, Lalai,,0,0,0,,Saya rasa ada kontrak berganda.
Dialog: 0,0:58:07.65,0:58:10.56, Lalai,,0,0,0,,- Biar saya lihat kontraknya, dan...\N- Jangan mengarut.
Dialog: 0,0:58:28.79,0:58:30.38,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Peguam Hwang{\c}{\i0}
Dialog: 0,0:58:36.38,0:58:37.48,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Presiden Bank Gu Bon-jun{\c}{\i0}
Dialog: 0,0:58:46.23,0:58:47.33,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Assemblyman Han{\c}{\i0}
Dialog: 0,0:58:47.35,0:58:48.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pengarah Ryu{\c}{\i0}
Dialog: 0,0:58:49.65,0:58:51.29,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sedang dalam mesyuarat. Saya akan menghubungi anda semula.{\c}{\i0}
Dialog: 0,0:59:00.70,0:59:02.18, Lalai,,0,0,0,, Kebaikan!
Dialog: 0,0:59:02.20,0:59:04.94, Lalai,,0,0,0,,Apa yang kamu lakukan di luar sini?
Dialog: 0,0:59:06.04,0:59:07.39, Lalai,,0,0,0,,Anda bekerja pada hujung minggu juga.
Dialog: 0,0:59:07.41,0:59:08.47, Lalai,,0,0,0,,Ya.
Dialog: 0,0:59:08.50,0:59:11.14, Lalai,,0,0,0,,Rumput tidak pernah berhenti tumbuh.
Dialog: 0,0:59:11.17,0:59:13.44, Lalai,,0,0,0,,Tiada apa-apa lagi yang boleh kami minta...
Dialog: 0,0:59:13.46,0:59:16.73, Lalai,,0,0,0,,daripada {\i1}makgeolli{\i0} dan {\i1}pajeon yang sejuk...{\i0}
Dialog: 0,0:59:16.76,0:59:20.55, Lalai,,0,0,0,,selepas kerja pagi kami.
Dialog: 0,0:59:20.58,0:59:21.57, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:59:21.59,0:59:25.53,Lalai,,0,0,0,,Anda menjalani kehidupan yang hebat dikelilingi oleh alam semula jadi.
Dialog: 0,0:59:25.56,0:59:27.26,Lalai,,0,0,0,,Saya iri hati.
Dialog: 0,0:59:28.52,0:59:29.66, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:59:29.69,0:59:32.75,Lalai,,0,0,0,,Orang akan ketawa jika mereka\Ndengar bahawa keluarga kaya...
Dialog: 0,0:59:32.77,0:59:35.64,Lalai,,0,0,0,,memang iri hati dengan sesetengah petani.
Dialog: 0,0:59:35.82,0:59:39.05, Lalai,,0,0,0,,Omong-omong, saya tidak pasti jika\Nyou pernah mengalami {\i1}makgeolli{\i0} sebelum ini.
Dialog: 0,0:59:39.07,0:59:40.90,Lalai,,0,0,0,,Saya pernah melakukannya,
Dialog: 0,0:59:40.99,0:59:44.11, Lalai,,0,0,0,, kerana ingin tahu, semasa di kolej 30 tahun lalu.
Dialog: 0,0:59:46.08,0:59:49.24, Lalai,,0,0,0,,Maka anda sepatutnya mempunyai beberapa hari ini.
Dialog: 0,0:59:53.63,0:59:55.33, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:59:55.71,0:59:57.15, Lalai,,0,0,0,,- Di sini.\N- Baik.
Dialog: 0,0:59:57.17,0:59:59.92, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:00:00.63,1:00:02.57,Lalai,,0,0,0,,Okey.
Dialog: 0,1:00:02.59,1:00:04.59,Lalai,,0,0,0,,Kemudian...
Dialog: 0,1:00:04.97,1:00:08.95,Lalai,,0,0,0,,Kita perlu membuat roti bakar, tetapi apa yang harus kita katakan?
Dialog: 0,1:00:08.98,1:00:12.85,Lalai,,0,0,0,,Bagaimana pula dengan "Kesihatan paling penting"?
Dialog: 0,1:00:14.52,1:00:16.13,Lalai,,0,0,0,,Kami tidak boleh mengatakan itu,
Dialog: 0,1:00:16.15,1:00:20.00,Lalai,,0,0,0,,kerana bapanya terlantar.
Dialog: 0,1:00:20.03,1:00:22.05,Lalai,,0,0,0,,Lalu bagaimana pula...
Dialog: 0,1:00:22.07,1:00:23.97,Lalai,,0,0,0,,"Seronok melihat awak"?
Dialog: 0,1:00:23.99,1:00:26.76,Lalai,,0,0,0,,Itu juga tidak akan berfungsi,
Dialog: 0,1:00:26.78,1:00:29.19,Lalai,,0,0,0,,sejak situasi semasa mereka...
Dialog: 0,1:00:29.62,1:00:31.97,Lalai,,0,0,0,,bukankah itu indah.
Dialog: 0,1:00:32.00,1:00:33.82,Lalai,,0,0,0,,Mari kita...
Dialog: 0,1:00:33.96,1:00:34.94,Lalai,,0,0,0,,dentingkan cermin mata kami.
Dialog: 0,1:00:34.96,1:00:36.66,Lalai,,0,0,0,,Tetapi...
Dialog: 0,1:00:56.90,1:00:58.50,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:00:58.52,1:00:59.96,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:00:59.98,1:01:01.89,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:01:03.24,1:01:04.34,Lalai,,0,0,0,,Mari...
Dialog: 0,1:01:04.36,1:01:05.42,Lalai,,0,0,0,,Mari kita minum lebih sedikit.
Dialog: 0,1:01:05.45,1:01:08.09,Lalai,,0,0,0,,Jangan jadi bodoh. Kita patut pulang.
Dialog: 0,1:01:08.12,1:01:11.11,Lalai,,0,0,0,,Tidak, saya tidak akan kembali ke sana.
Dialog: 0,1:01:11.62,1:01:14.52,Lalai,,0,0,0,,Astaga. Adakah rumah kita tidak selesa?
Dialog: 0,1:01:14.54,1:01:16.52,Lalai,,0,0,0,,Saya akui ia lebih lusuh daripada...
Dialog: 0,1:01:16.54,1:01:20.12,Lalai,,0,0,0,,Tidak, bukan itu sebabnya!
Dialog: 0,1:01:21.55,1:01:23.96,Lalai,,0,0,0,,Sebagai ketua keluarga saya,
Dialog: 0,1:01:24.97,1:01:28.86,Lalai,,0,0,0,,Saya patut menghiburkan mereka dan berkata...
Dialog: 0,1:01:28.89,1:01:31.24,Lalai,,0,0,0,,semuanya baik.
Dialog: 0,1:01:31.27,1:01:33.55,Lalai,,0,0,0,,Perkara itu akan berlalu,
Dialog: 0,1:01:33.64,1:01:36.22,Lalai,,0,0,0,,dan kita harus pulang esok,
Dialog: 0,1:01:36.27,1:01:40.21,Lalai,,0,0,0,,tetapi saya tidak boleh mengatakannya sekarang.
Dialog: 0,1:01:40.23,1:01:42.25,Lalai,,0,0,0,,Saya terlalu malu untuk berdepan dengan mereka.
Dialog: 0,1:01:42.28,1:01:44.63,Lalai,,0,0,0,,Saya juga tidak mahu pulang.
Dialog: 0,1:01:44.65,1:01:47.48,Lalai,,0,0,0,,Oh, sayang.
Dialog: 0,1:01:48.28,1:01:49.39,Lalai,,0,0,0,,Awal hari ini,
Dialog: 0,1:01:49.41,1:01:53.74,Lalai,,0,0,0,,Saya menelefon rakan terdekat saya.
Dialog: 0,1:01:54.12,1:01:56.56,Lalai,,0,0,0,,Saya tidak pernah meminta bantuan seperti itu sebelum ini,
Dialog: 0,1:01:56.58,1:02:01.15,Lalai,,0,0,0,,tetapi saya meminta dia hanya\N$20,000, kerana kami tidak mempunyai wang.
Dialog: 0,1:02:01.17,1:02:03.12,Lalai,,0,0,0,,Dan?
Dialog: 0,1:02:03.59,1:02:04.73,Lalai,,0,0,0,,Dia kata tidak.
Dialog: 0,1:02:04.76,1:02:06.94,Lalai,,0,0,0,,Dia teragak-agak untuk memberi saya wang,
Dialog: 0,1:02:06.97,1:02:10.28,Lalai,,0,0,0,,memandangkan kami akan disoal siasat\Noleh pihak pendakwaan tidak lama lagi,
Dialog: 0,1:02:10.30,1:02:12.16,Lalai,,0,0,0,,dan wartawan sedang mencari kami.
Dialog: 0,1:02:12.18,1:02:13.45,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:02:13.47,1:02:15.16,Lalai,,0,0,0,,Saya terkedu.
Dialog: 0,1:02:15.18,1:02:18.16,Lalai,,0,0,0,,Saya boleh faham kenapa anda tercengang,
Dialog: 0,1:02:18.19,1:02:20.21,Lalai,,0,0,0,,kerana dia adalah kawan terdekat anda.
Dialog: 0,1:02:20.23,1:02:22.72,Lalai,,0,0,0,,Tidak, bukan kerana dia.
Dialog: 0,1:02:23.15,1:02:26.46,Lalai,,0,0,0,,Pada hakikatnya saya tidak mempunyai $20,000 pun.
Dialog: 0,1:02:26.49,1:02:31.01,Lalai,,0,0,0,,Saya baru-baru ini menandatangani cukai\Ninvois bernilai $45.6 juta,
Dialog: 0,1:02:31.03,1:02:34.64,Lalai,,0,0,0,,tetapi sekarang saya tidak mempunyai $20,000 dalam poket saya.
Dialog: 0,1:02:34.66,1:02:38.12,Lalai,,0,0,0,,Saya berasa amat menyedihkan.
Dialog: 0,1:02:42.09,1:02:43.79,Lalai,,0,0,0,,Lihat.
Dialog: 0,1:02:44.92,1:02:48.39,Lalai,,0,0,0,,Saya tidak tahu sama ada ini akan menghiburkan anda.
Dialog: 0,1:02:48.41,1:02:49.45,Lalai,,0,0,0,,Okey.
Dialog: 0,1:02:49.47,1:02:51.42,Lalai,,0,0,0,,Tetapi tiada siapa yang melakukannya.
Dialog: 0,1:02:52.18,1:02:54.84,Lalai,,0,0,0,,Tiada sesiapa yang mempunyai banyak dalam poket mereka.
Dialog: 0,1:02:54.89,1:02:58.45,Lalai,,0,0,0,,En. Baek! Saya tahu awak berbohong\Nhanya untuk membuat saya berasa lebih baik!
Dialog: 0,1:02:58.48,1:03:00.58,Lalai,,0,0,0,,Maksud saya!
Dialog: 0,1:03:00.61,1:03:03.06,Lalai,,0,0,0,,Saya tidak pernah mengalami sebanyak itu sebelum ini!
Dialog: 0,1:03:08.61,1:03:09.63,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:03:09.66,1:03:11.52,Lalai,,0,0,0,,Nanti kita bincang lagi.
Dialog: 0,1:03:12.45,1:03:14.15,Lalai,,0,0,0,,Mak Cik Hae-in.
Dialog: 0,1:03:17.66,1:03:18.77,Lalai,,0,0,0,,Hei.
Dialog: 0,1:03:18.79,1:03:22.31,Lalai,,0,0,0,,Saya dengar awak sedang dalam acar sekarang.
Dialog: 0,1:03:22.34,1:03:23.94,Lalai,,0,0,0,,Sedikit.
Dialog: 0,1:03:23.96,1:03:24.94,Lalai,,0,0,0,,Ceritanya panjang.
Dialog: 0,1:03:24.96,1:03:27.27,Lalai,,0,0,0,,Saya dengar rahsia awak ada di sini.
Dialog: 0,1:03:27.30,1:03:30.53,Lalai,,0,0,0,,Jangan risau. Tiada siapa yang akan\Ndengar intipan dari hujung kita.
Dialog: 0,1:03:30.55,1:03:31.57,Lalai,,0,0,0,,"Akhir kita"?
Dialog: 0,1:03:31.59,1:03:32.91,Lalai,,0,0,0,,Kafe Internet Yongdu-ri.
Dialog: 0,1:03:32.93,1:03:35.45,Lalai,,0,0,0,,Saya cukup banyak menjalankan tempat itu.
Dialog: 0,1:03:35.47,1:03:36.91,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:03:36.93,1:03:38.63,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:03:41.81,1:03:43.72,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:04:14.89,1:04:16.32,Lalai,,0,0,0,,Ya ampun, dia sudah bangun.
Dialog: 0,1:04:16.35,1:04:18.67,Lalai,,0,0,0,,- Hae-in.\N- Awak okay tak, Hae-in?
Dialog: 0,1:04:20.23,1:04:23.30,Lalai,,0,0,0,,Ambil air, Sayang.
Dialog: 0,1:04:27.23,1:04:29.17,Lalai,,0,0,0,,Awak tak patut ke hospital?
Dialog: 0,1:04:29.19,1:04:30.89,Lalai,,0,0,0,,Sepatutnya?
Dialog: 0,1:04:31.24,1:04:33.15,Lalai,,0,0,0,,Saya okay.
Dialog: 0,1:04:33.28,1:04:35.46,Lalai,,0,0,0,,Saya tidak dapat tidur lena\Nmalam tadi, jadi saya pening.
Dialog: 0,1:04:35.48,1:04:37.47,Lalai,,0,0,0,,Adakah anda mengambil ubat anda?
Dialog: 0,1:04:37.49,1:04:40.32,Lalai,,0,0,0,,Ubat apa? Adakah dia sakit?
Dialog: 0,1:04:41.16,1:04:42.25,Lalai,,0,0,0,,Ini untuk anemia saya.
Dialog: 0,1:04:42.27,1:04:43.31,Lalai,,0,0,0,,Anda mengalami anemia?
Dialog: 0,1:04:43.33,1:04:45.52,Lalai,,0,0,0,,Hasil pemeriksaan anda tidak pernah menunjukkan perkara itu.
Dialog: 0,1:04:45.54,1:04:46.52,Lalai,,0,0,0,,Seberapa teruknya?
Dialog: 0,1:04:46.54,1:04:48.65,Lalai,,0,0,0,,Aduh, jangan dramatik sangat.
Dialog: 0,1:04:48.67,1:04:50.61,Lalai,,0,0,0,,Saya juga anemia.
Dialog: 0,1:04:50.63,1:04:53.36,Lalai,,0,0,0,,Saya pun pening, memandangkan\NI pun tak boleh tidur lena.
Dialog: 0,1:04:53.38,1:04:56.28,Lalai,,0,0,0,,Soo-cheol juga tidak sihat.
Dialog: 0,1:04:56.30,1:04:58.71,Lalai,,0,0,0,,Kita semua menderita di sini.
Dialog: 0,1:04:59.77,1:05:04.50,Lalai,,0,0,0,,Walaupun masih, pengsan bukanlah perkara biasa.
Dialog: 0,1:05:04.52,1:05:08.33,Lalai,,0,0,0,,Tag bersama-sama dengan Hyun-woo ke Seoul\Esok dan melawat hospital.
Dialog: 0,1:05:08.36,1:05:10.06,Lalai,,0,0,0,,Baiklah, saya akan lakukan itu.
Dialog: 0,1:05:13.82,1:05:16.34,Lalai,,0,0,0,,Apa? saya penat.
Dialog: 0,1:05:16.37,1:05:18.76,Lalai,,0,0,0,,Kenapa awak kejam sangat dengan Hae-in?
Dialog: 0,1:05:18.78,1:05:21.60,Lalai,,0,0,0,,- Bilakah saya?\N- Dia sakit.
Dialog: 0,1:05:21.62,1:05:23.56,Lalai,,0,0,0,,Dia pengsan.
Dialog: 0,1:05:23.58,1:05:26.07,Lalai,,0,0,0,,Orang yang tidak dikenali pun akan risau.
Dialog: 0,1:05:26.21,1:05:28.10,Lalai,,0,0,0,,Tidak mengapa. Ibu mertuanya...
Dialog: 0,1:05:28.13,1:05:30.69,Lalai,,0,0,0,,Tidak, bekas ibu mertuanya\Njaga dia dengan baik.
Dialog: 0,1:05:30.72,1:05:31.98,Lalai,,0,0,0,,Nampak tak?
Dialog: 0,1:05:32.01,1:05:34.44,Lalai,,0,0,0,,Hae-in tidak teragak-agak untuk mematuhinya.
Dialog: 0,1:05:34.47,1:05:38.38,Lalai,,0,0,0,,Pernahkah dia melakukan perkara yang sama kepada saya?
Dialog: 0,1:05:38.51,1:05:42.17,Lalai,,0,0,0,,Seon-hwa, adakah anda rasa anda\Ntahu segala-galanya tentang Hae-in?
Dialog: 0,1:05:42.22,1:05:46.68,Lalai,,0,0,0,,Tidak, sudah tentu tidak, dan tidak perlu untuk itu.
Dialog: 0,1:05:49.52,1:05:50.83,Lalai,,0,0,0,,Seon-hwa.
Dialog: 0,1:05:50.86,1:05:52.64,Lalai,,0,0,0,,Apa?
Dialog: 0,1:05:53.61,1:05:55.85,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:05:56.03,1:05:57.01,Lalai,,0,0,0,,Seon-hwa!
Dialog: 0,1:05:57.03,1:05:58.88,Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,1:05:58.91,1:06:00.51,Lalai,,0,0,0,,Berhenti memanggil nama saya.
Dialog: 0,1:06:00.53,1:06:01.60,Lalai,,0,0,0,,Hae-in ialah...
Dialog: 0,1:06:01.62,1:06:03.45,Lalai,,0,0,0,,Bagaimana dengan dia?
Dialog: 0,1:06:08.00,1:06:10.02,Lalai,,0,0,0,,Beri saya kebaikan ini.
Dialog: 0,1:06:10.04,1:06:12.52,Lalai,,0,0,0,,Layani dia dengan baik, supaya anda tidak akan menyesal di kemudian hari.
Dialog: 0,1:06:12.55,1:06:14.71,Lalai,,0,0,0,,Sila.
Dialog: 0,1:06:15.17,1:06:16.69,Lalai,,0,0,0,,Mengapa saya akan menyesal?
Dialog: 0,1:06:16.72,1:06:19.67,Lalai,,0,0,0,,Saya tidak pernah melakukan perkara yang saya menyesal.
Dialog: 0,1:06:23.35,1:06:26.55,Lalai,,0,0,0,,Aduh, ini sangat menjengkelkan.
Dialog: 0,1:06:26.73,1:06:30.10,Lalai,,0,0,0,,Dia akan sangat patah hati.
Dialog: 0,1:06:31.02,1:06:32.72,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:06:56.84,1:07:00.29,Lalai,,0,0,0,,Mengapa tiada bekas saya seperti dia?
Dialog: 0,1:07:12.11,1:07:13.67,Lalai,,0,0,0,,Saya menghubungi doktor anda.
Dialog: 0,1:07:13.69,1:07:16.39,Lalai,,0,0,0,,- Awak boleh jumpa dia esok.\N- Duduk.
Dialog: 0,1:07:21.70,1:07:24.05,Lalai,,0,0,0,,Apa yang telah anda lakukan?
Dialog: 0,1:07:24.08,1:07:25.78,Lalai,,0,0,0,,Apa?
Dialog: 0,1:07:25.95,1:07:29.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Beberapa hari, dia diselubungi telur.{\c}{\i0}
Dialog: 0,1:07:52.44,1:07:53.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Pembelian Tanah{\c}{\i0}
Dialog: 0,1:07:53.52,1:07:55.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Setiausaha Na?{\c}{\i0}
Dialog: 0,1:07:55.78,1:07:58.05,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jom kita adakan mesyuarat di pantri pejabat.{\c}{\i0}
Dialog: 0,1:07:58.07,1:07:59.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baik.{\c}{\i0}
Dialog: 0,1:08:01.99,1:08:04.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya rasa dia telah berjumpa...{\c}{\i0}
Dialog: 0,1:08:04.62,1:08:06.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dengan penunjuk perasaan darat tersebut.{\c}{\i0}
Dialog: 0,1:08:06.24,1:08:07.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baiklah.{\c}{\i0}
Dialog: 0,1:08:07.50,1:08:08.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nanti kita bincang lagi.{\c}{\i0}
Dialog: 0,1:08:08.58,1:08:11.24,Lalai,,0,0,0,,Adakah anda berhubung dengannya?
Dialog: 0,1:08:13.92,1:08:16.90,Lalai,,0,0,0,,Beritahu saya berapa banyak yang anda tahu...
Dialog: 0,1:08:16.92,1:08:18.62,Lalai,,0,0,0,,di belakang saya.
Dialog: 0,1:08:20.67,1:08:22.86,Lalai,,0,0,0,,Ini adalah penipuan pelaburan hartanah biasa anda.
Dialog: 0,1:08:22.89,1:08:25.49,Lalai,,0,0,0,,Seorang broker membeli tanah\Nin soalan daripada pemilik,
Dialog: 0,1:08:25.51,1:08:27.70,Lalai,,0,0,0,,dan ditawarkan lima kali ganda harga pasaran.
Dialog: 0,1:08:27.72,1:08:30.68,Lalai,,0,0,0,,Kemudian mereka menandatangani kontrak dengan\NQueens untuk satu pertiga daripada harga itu.
Dialog: 0,1:08:30.70,1:08:32.59,Lalai,,0,0,0,,Kontrak berganda?
Dialog: 0,1:08:32.65,1:08:34.16,Lalai,,0,0,0,,Itu penipuan yang disengajakan.
Dialog: 0,1:08:34.19,1:08:35.37,Lalai,,0,0,0,,Kita perlu membuktikannya.
Dialog: 0,1:08:35.40,1:08:37.21,Lalai,,0,0,0,,Dan broker? Anda menyebut satu.
Dialog: 0,1:08:37.23,1:08:38.80,Lalai,,0,0,0,,Adakah dia di Korea? Adakah dia sudah melarikan diri?
Dialog: 0,1:08:38.82,1:08:40.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Paradise Land, Ltd.{\c}{\i0}
Dialog: 0,1:08:53.87,1:08:56.03,Lalai,,0,0,0,,{\i1}Dia memang hilang,{\i0}
Dialog: 0,1:08:56.92,1:08:59.66,Lalai,,0,0,0,,{\i1}tetapi dia akan berkahwin hujung minggu ini.{\i0}
Dialog: 0,1:09:00.05,1:09:03.15,Lalai,,0,0,0,,{\i1}Saya rasa dia bercadang untuk terbang\Nout serta-merta selepas itu,{\i0}
Dialog: 0,1:09:03.18,1:09:04.78,Lalai,,0,0,0,,tetapi dia tidak akan dapat.
Dialog: 0,1:09:04.80,1:09:06.49,Lalai,,0,0,0,,Saya memujuk pemilik tanah untuk menyaman,
Dialog: 0,1:09:06.51,1:09:08.92, Lalai,,0,0,0,, dan letakkannya dalam Senarai Larangan Terbang hari ini.
Dialog: 0,1:09:10.77,1:09:14.00,Lalai,,0,0,0,,Perkara akan berlalu sebaik sahaja kita menangkapnya.
Dialog: 0,1:09:14.02,1:09:15.46,Lalai,,0,0,0,,Ya,
Dialog: 0,1:09:15.48,1:09:17.75,Lalai,,0,0,0,,tetapi anda tidak perlu risau...
Dialog: 0,1:09:17.77,1:09:19.29,Lalai,,0,0,0,,dengan perkara ini.
Dialog: 0,1:09:19.32,1:09:21.31,Lalai,,0,0,0,,Mengapa tidak? Kenapa saya tidak boleh?
Dialog: 0,1:09:23.78,1:09:24.76,Lalai,,0,0,0,,Lihat saya.
Dialog: 0,1:09:24.78,1:09:26.55,Lalai,,0,0,0,,Saya sedang mati.
Dialog: 0,1:09:26.57,1:09:29.30,Lalai,,0,0,0,,Keluarga kami hancur.\NKami miskin dan tiada tempat tinggal.
Dialog: 0,1:09:29.33,1:09:30.93,Lalai,,0,0,0,,Datuk saya koma.
Dialog: 0,1:09:30.95,1:09:31.97,Lalai,,0,0,0,,Da-hye lari.
Dialog: 0,1:09:32.00,1:09:33.39,Lalai,,0,0,0,,Soo-cheol tiada,
Dialog: 0,1:09:33.41,1:09:35.11,Lalai,,0,0,0,,tetapi bahagian yang paling teruk...
Dialog: 0,1:09:35.17,1:09:37.87,Lalai,,0,0,0,,adalah saya berada di kampung halaman bekas suami saya.
Dialog: 0,1:09:39.80,1:09:41.44,Lalai,,0,0,0,,Adakah itu...
Dialog: 0,1:09:41.46,1:09:42.52,Lalai,,0,0,0,,sangat teruk?
Dialog: 0,1:09:42.55,1:09:45.28,Lalai,,0,0,0,,Saya perlu buat sesuatu...
Dialog: 0,1:09:45.30,1:09:46.53,Lalai,,0,0,0,,dalam situasi ini.
Dialog: 0,1:09:46.55,1:09:49.16,Lalai,,0,0,0,,Hari ini, saya juga memberi diri saya\Ninjection yang akan meningkatkan WBC saya.
Dialog: 0,1:09:49.19,1:09:50.70,Lalai,,0,0,0,,Saya tidak mahu duduk diam.
Dialog: 0,1:09:50.72,1:09:53.76,Lalai,,0,0,0,,Saya faham. Anda melakukannya dengan baik.
Dialog: 0,1:09:54.10,1:09:56.79,Lalai,,0,0,0,,Ya, saya akan dapat bangkit semula...
Dialog: 0,1:09:56.81,1:09:59.60,Lalai,,0,0,0,,jika saya teruskan perkara ini,
Dialog: 0,1:09:59.98,1:10:03.02,Lalai,,0,0,0,,dan anda boleh meninggalkan\N saya tanpa rasa bimbang.
Dialog: 0,1:10:03.61,1:10:06.35,Lalai,,0,0,0,,Kemudian akhirnya kita akan berpisah...
Dialog: 0,1:10:07.07,1:10:09.18,Lalai,,0,0,0,,seperti pasangan yang benar-benar bercerai.
Dialog: 0,1:10:09.20,1:10:10.90,Lalai,,0,0,0,,Itulah matlamat saya,
Dialog: 0,1:10:11.08,1:10:13.57,Lalai,,0,0,0,,untuk berpisah dengan anda untuk kebaikan.
Dialog: 0,1:10:21.50,1:10:23.20,Lalai,,0,0,0,,Saya akan mula berkongsi...
Dialog: 0,1:10:23.59,1:10:25.23,Lalai,,0,0,0,,semuanya dengan anda.
Dialog: 0,1:10:25.26,1:10:27.69,Lalai,,0,0,0,,Mari kita lakukan semua yang kita mampu,
Dialog: 0,1:10:27.72,1:10:30.30,Lalai,,0,0,0,,selagi badan anda boleh menerimanya.
Dialog: 0,1:10:30.76,1:10:32.67,Lalai,,0,0,0,,Anda sepatutnya mencapai matlamat anda...
Dialog: 0,1:10:32.89,1:10:34.76,Lalai,,0,0,0,,secepat mungkin.
Dialog: 0,1:10:35.89,1:10:37.59,Lalai,,0,0,0,,Betul.
Dialog: 0,1:11:52.59,1:11:53.60,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kad Pengenalan\NHong Hae-in{\c}{\i0}
Dialog: 0,1:12:00.31,1:12:02.35,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pusat Perubatan Universiti Sungmin\NHong Hae-in{\c}{\i0}
Dialog: 0,1:12:08.28,1:12:10.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pusat Perubatan Universiti Sungmin{\c}{\i0}
Dialog: 0,1:12:10.90,1:12:12.81,Lalai,,0,0,0,,Saya akan letak kereta dan naik.
Dialog: 0,1:12:12.87,1:12:14.57,Lalai,,0,0,0,,Okey.
Dialog: 0,1:12:14.99,1:12:16.62,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Adakah anda pesakit?\NYes{\c}{\i0}
Dialog: 0,1:12:18.91,1:12:20.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Keluarkan Semula Dokumen Sebelumnya{\c}{\i0}
Dialog: 0,1:12:20.41,1:12:22.00,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Memuatkan{\c}{\i0}
Dialog: 0,1:12:29.17,1:12:30.80,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Rujukan{\c}{\i0}
Dialog: 0,1:12:38.81,1:12:41.04,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Sel tumor telah merebak antara saraf kranial{\c}{\i0}
Dialog: 0,1:12:41.06,1:12:42.94,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Rawatan tidak berjaya kerana WBC rendah{\c}{\i0}
Dialog: 0,1:12:49.07,1:12:51.70,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Purata anggaran hayat\Jangkaan ialah tiga bulan{\c}{\i0}
Dialog: 0,1:13:24.27,1:13:27.26,Lalai,,0,0,0,,Tunggu! siapa nama awak?
Dialog: 0,1:13:28.78,1:13:31.21,Lalai,,0,0,0,,Malah pengarah hospital\Nenggan memberitahu saya nama anda,
Dialog: 0,1:13:31.24,1:13:32.75,Lalai,,0,0,0,,tetapi akhirnya saya dapat berjumpa dengan awak.
Dialog: 0,1:13:32.78,1:13:34.90,Lalai,,0,0,0,,Anda menulis diagnosis ini,
Dialog: 0,1:13:35.57,1:13:37.36,Lalai,,0,0,0,,jadi beritahu saya.
Dialog: 0,1:13:37.53,1:13:39.80,Lalai,,0,0,0,,Bagaimanakah saya boleh menyelamatkan Hong Hae-in?
Dialog: 0,1:13:39.83,1:13:42.11,Lalai,,0,0,0,,Itu sahaja yang saya perlu tahu.
Dialog: 0,1:13:59.97,1:14:02.19,Lalai,,0,0,0,,Kenapa awak ada di sini? Saya\Sedang ke pejabat doktor.
Dialog: 0,1:14:02.21,1:14:03.54,Lalai,,0,0,0,,Doktor memanggil.
Dialog: 0,1:14:03.56,1:14:05.72,Lalai,,0,0,0,,Eun-sung datang.
Dialog: 0,1:14:19.41,1:14:20.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya minta maaf.{\c}{\i0}
Dialog: 0,1:14:20.58,1:14:24.51,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda bukan keluarga mahupun penjaganya,\Njadi saya tidak bertanggungjawab untuk memberitahu anda.{\c}{\i0}
Dialog: 0,1:14:24.54,1:14:26.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tiada apa-apa untuk dikatakan.{\c}{\i0}
Dialog: 0,1:14:26.58,1:14:28.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betulkah?{\c}{\i0}
Dialog: 0,1:14:28.58,1:14:31.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda memberitahu saya jika saya menjadi penjaganya?{\c}{\i0}
Dialog: 0,1:14:33.17,1:14:34.92,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,1:14:37.18,1:14:38.57,Lalai,,0,0,0,,Helo.
Dialog: 0,1:14:38.59,1:14:40.28,Lalai,,0,0,0,,Awak tak lapar ke?
Dialog: 0,1:14:40.30,1:14:42.38,Lalai,,0,0,0,,Sila duduk di sini.
Dialog: 0,1:14:45.60,1:14:47.20,Lalai,,0,0,0,,Jadi...
Dialog: 0,1:14:47.29,1:14:48.36,Lalai,,0,0,0,,Anda lihat...
Dialog: 0,1:14:48.38,1:14:49.37,Lalai,,0,0,0,,Ya?
Dialog: 0,1:14:49.40,1:14:53.21,Lalai,,0,0,0,,Seorang wanita tua meminjamkan sapu tangannya kepada saya.
Dialog: 0,1:14:53.23,1:14:55.39,Lalai,,0,0,0,,Wanita tua apa?
Dialog: 0,1:14:55.49,1:14:59.06,Lalai,,0,0,0,,Jadi... Dia...
Dialog: 0,1:14:59.11,1:15:02.22,Lalai,,0,0,0,,Dia mempunyai seorang anak lelaki.
Dialog: 0,1:15:02.24,1:15:03.97,Lalai,,0,0,0,,Saya nampak, dan namanya...?
Dialog: 0,1:15:03.99,1:15:05.97,Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,1:15:06.00,1:15:08.14,Lalai,,0,0,0,,Dia nampak biasa.
Dialog: 0,1:15:08.17,1:15:10.89,Lalai,,0,0,0,,Dia kelihatan seperti Leslie Cheung.
Dialog: 0,1:15:10.92,1:15:12.98,Lalai,,0,0,0,,Di kawasan kejiranan kita?
Dialog: 0,1:15:13.00,1:15:14.06,Lalai,,0,0,0,,Tidak, saya meraguinya.
Dialog: 0,1:15:14.09,1:15:16.65,Lalai,,0,0,0,,Dia juga mempunyai suara yang bagus.
Dialog: 0,1:15:16.67,1:15:19.03,Lalai,,0,0,0,,Seperti penyanyi.
Dialog: 0,1:15:19.05,1:15:22.99,Lalai,,0,0,0,,Seorang lelaki yang kelihatan seperti Leslie Cheung\Nand mempunyai suara penyanyi.
Dialog: 0,1:15:23.01,1:15:25.09,Lalai,,0,0,0,,Di kawasan kejiranan kita?
Dialog: 0,1:15:25.27,1:15:29.93,Lalai,,0,0,0,,Melainkan ia hantu,\NI takut anda tersilap.
Dialog: 0,1:15:30.56,1:15:32.26,Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,1:15:32.44,1:15:34.35,Lalai,,0,0,0,,Ia kelihatan serupa.
Dialog: 0,1:15:40.74,1:15:41.84,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:15:41.87,1:15:43.57,Lalai,,0,0,0,,Mereka ada di sini.
Dialog: 0,1:15:47.37,1:15:48.64,Lalai,,0,0,0,,Adakah anda lapar?
Dialog: 0,1:15:48.66,1:15:51.20,Lalai,,0,0,0,,- Ya.\N- Okay, jom makan.
Dialog: 0,1:15:52.17,1:15:54.40,Lalai,,0,0,0,,Pemasaan yang bagus.
Dialog: 0,1:15:54.42,1:15:56.02,Lalai,,0,0,0,,Makan malam sudah sedia. Jom makan.
Dialog: 0,1:15:56.05,1:15:57.02,Lalai,,0,0,0,,Apa untuk makan malam?
Dialog: 0,1:15:57.05,1:15:58.40,Lalai,,0,0,0,,Saya membuat tulang rusuk pendek yang direbus.
Dialog: 0,1:15:58.42,1:15:59.94,Lalai,,0,0,0,,- Tulang rusuk pendek direbus?\N- Sedap.
Dialog: 0,1:15:59.97,1:16:02.10,Lalai,,0,0,0,,- Saya harap tidak mengapa.\N- Adakah anda menambah buah berangan juga?
Dialog: 0,1:16:02.12,1:16:03.82,Lalai,,0,0,0,,Adakah anda...?
Dialog: 0,1:16:27.87,1:16:30.28,Lalai,,0,0,0,,Adakah Grace melawat anda?
Dialog: 0,1:16:30.58,1:16:32.32,Lalai,,0,0,0,,Adakah anda memberitahunya tidak?
Dialog: 0,1:16:32.96,1:16:34.27,Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,1:16:34.29,1:16:37.77,Lalai,,0,0,0,,Syabas. Dia perlu tahu tempatnya.
Dialog: 0,1:16:37.80,1:16:40.94,Lalai,,0,0,0,,Hantar kenyataan akhbar dan katakan\NI akan mengambil alih gedung serbaneka.
Dialog: 0,1:16:40.97,1:16:43.38,Lalai,,0,0,0,,Tidak, itu tempat Hae-in.
Dialog: 0,1:16:47.06,1:16:48.03,Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:16:48.06,1:16:49.78,Lalai,,0,0,0,,Dia akan kembali.
Dialog: 0,1:16:49.81,1:16:52.26,Lalai,,0,0,0,,Saya akan menguruskannya sehingga itu.
Dialog: 0,1:16:55.15,1:16:57.67,Lalai,,0,0,0,,Dia tidak akan mati semudah itu.
Dialog: 0,1:16:57.69,1:16:59.50,Lalai,,0,0,0,,Saya akan menjaganya dengan baik,
Dialog: 0,1:16:59.53,1:17:03.06,Lalai,,0,0,0,,jadi dia hidup, tetapi tetap tidak sedarkan diri.
Dialog: 0,1:17:06.28,1:17:11.76,Lalai,,0,0,0,,Selagi dia koma,\NI saya bertanggungjawab ke atas 21% saham.
Dialog: 0,1:17:11.79,1:17:13.74,Lalai,,0,0,0,,Adakah anda faham?
Dialog: 0,1:17:23.30,1:17:25.57,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Alih keluar saya daripada senarai larangan terbang\NIni satu-satunya amaran anda{\c}{\i0}
Dialog: 0,1:18:01.00,1:18:02.34,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}En. Yoon Eun-sung{\c}{\i0}
Dialog: 0,1:18:04.88,1:18:06.69,Lalai,,0,0,0,,Apa yang telah anda lakukan?
Dialog: 0,1:18:06.72,1:18:07.82,Lalai,,0,0,0,,Saya beritahu awak.
Dialog: 0,1:18:07.84,1:18:09.45,Lalai,,0,0,0,,Kami tidak berkongsi matlamat yang sama.
Dialog: 0,1:18:09.47,1:18:10.62,Lalai,,0,0,0,,Mana pengerusi?
Dialog: 0,1:18:10.64,1:18:12.28,Lalai,,0,0,0,,{\i1}Anda tidak sepatutnya melakukan ini.{\i0}
Dialog: 0,1:18:12.31,1:18:14.20,Lalai,,0,0,0,,Bagaimana jika dia mati?
Dialog: 0,1:18:14.23,1:18:16.22,Lalai,,0,0,0,,Maka ia tidak dapat dielakkan.
Dialog: 0,1:18:54.85,1:18:55.83,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:18:55.85,1:18:57.55,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya akan pergi sekarang.{\c}{\i0}
Dialog: 0,1:19:50.86,1:19:53.55,Lalai,,0,0,0,,Nak pergi mana ni\Nlate? Jom makan malam.
Dialog: 0,1:19:53.58,1:19:55.18,Lalai,,0,0,0,,Saya hanya pergi...
Dialog: 0,1:19:55.20,1:19:56.90,Lalai,,0,0,0,,untuk berjalan-jalan.
Dialog: 0,1:19:57.83,1:20:00.77,Lalai,,0,0,0,,Saya rasa Hyun-woo akan datang tidak lama lagi.
Dialog: 0,1:20:00.79,1:20:02.23,Lalai,,0,0,0,,Adakah dia?
Dialog: 0,1:20:02.25,1:20:03.39,Lalai,,0,0,0,,Ya.
Dialog: 0,1:20:03.42,1:20:06.02,Lalai,,0,0,0,,Kita patut tunggu dan makan dengan dia.
Dialog: 0,1:20:06.05,1:20:08.00,Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,1:20:11.76,1:20:14.32,Lalai,,0,0,0,,Jangan pergi terlalu jauh, okay?
Dialog: 0,1:20:14.35,1:20:16.05,Lalai,,0,0,0,,Okey.
Dialog: 0,1:21:07.48,1:21:09.23,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:21:42.06,1:21:43.80,Lalai,,0,0,0,,Hyun-woo?
Dialog: 0,1:21:43.85,1:21:45.27,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:22:28.65,1:22:30.56,Lalai,,0,0,0,,En. Pyeon Seong-uk?
Dialog: 0,1:22:31.40,1:22:33.09,Lalai,,0,0,0,,Saya telah mencari awak.
Dialog: 0,1:22:33.11,1:22:35.00,Lalai,,0,0,0,,Saya faham. saya sepatutnya...
Dialog: 0,1:22:35.03,1:22:37.42,Lalai,,0,0,0,,di Boracay sekarang selepas perkahwinan saya,
Dialog: 0,1:22:37.45,1:22:40.38,Lalai,,0,0,0,,tetapi keadaan menjadi\Nrumit, terima kasih kepada anda.
Dialog: 0,1:22:40.41,1:22:41.76,Lalai,,0,0,0,,Adakah anda mendapat teks saya?
Dialog: 0,1:22:41.79,1:22:43.49,Lalai,,0,0,0,,Saya menjawab dan berkata...
Dialog: 0,1:22:43.79,1:22:46.11,Lalai,,0,0,0,,kita harus menanganinya secara sah,
Dialog: 0,1:22:49.08,1:22:51.41,Lalai,,0,0,0,,kerana saya tidak akan menggugurkan saman itu.
Dialog: 0,1:23:53.11,1:23:54.88,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,1:23:54.90,1:23:58.55,Lalai,,0,0,0,,Fakta bahawa anda masih menyimpan\Nini selama ini mesti bermakna...
Dialog: 0,1:23:58.57,1:24:01.98,Lalai,,0,0,0,,anda tidak dapat mengeluarkannya dari fikiran anda.
Dialog: 0,1:24:02.07,1:24:04.44,Lalai,,0,0,0,,Dia pasti cantik.
Dialog: 0,1:24:05.95,1:24:07.56,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:24:07.58,1:24:09.81,Lalai,,0,0,0,,Bukan begitu.
Dialog: 0,1:24:09.83,1:24:11.02,Lalai,,0,0,0,,Saya tidak ingat...
Dialog: 0,1:24:11.04,1:24:12.81,Lalai,,0,0,0,,jika orang itu lelaki, perempuan,
Dialog: 0,1:24:12.83,1:24:15.15,Lalai,,0,0,0,,seorang guru, seorang pelajar,
Dialog: 0,1:24:15.17,1:24:19.46,Lalai,,0,0,0,,atau pengawal keselamatan. Saya tidak ingat apa-apa.
Dialog: 0,1:24:19.76,1:24:21.40,Lalai,,0,0,0,,{\i1}Itu hampir.{\i0}
Dialog: 0,1:24:21.43,1:24:24.28,Lalai,,0,0,0,,Dia pasti tajam, sama seperti seorang CEO sepatutnya.
Dialog: 0,1:24:24.30,1:24:25.70,Lalai,,0,0,0,,Bagaimana dia boleh mendapatkannya dengan segera?
Dialog: 0,1:24:25.72,1:24:29.41,Lalai,,0,0,0,,Sebaik sahaja dia melihatnya, ususnya\Nmengatakannya itu milik seorang wanita.
Dialog: 0,1:24:29.43,1:24:30.91,Lalai,,0,0,0,,Sudah hampir.
Dialog: 0,1:24:30.94,1:24:32.12,Lalai,,0,0,0,,Saya hampir ditangkap.
Dialog: 0,1:24:32.15,1:24:34.50,Lalai,,0,0,0,,Bukankah anda berkata...
Dialog: 0,1:24:34.52,1:24:36.08,Lalai,,0,0,0,,anda mencari seluruh sekolah...
Dialog: 0,1:24:36.11,1:24:39.64, Lalai,,0,0,0,,untuk gadis itu, sama seperti\Nputera dari "Cinderella"?
Dialog: 0,1:24:42.49,1:24:44.19,Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,1:24:44.53,1:24:46.44,Lalai,,0,0,0,,Dia sungguh cantik.
Dialog: 0,1:24:53.88,1:24:55.81,Lalai,,0,0,0,,- Adakah anda masih ingat itu?\N- Jelas sekali.
Dialog: 0,1:24:55.84,1:24:57.31,Lalai,,0,0,0,,Dia adalah jenis ideal saya.
Dialog: 0,1:24:57.34,1:24:59.55,Lalai,,0,0,0,,Adakah anda rasa anda akan mengenalinya?
Dialog: 0,1:24:59.57,1:25:00.61,Lalai,,0,0,0,,Segera.
Dialog: 0,1:25:00.63,1:25:02.19,Lalai,,0,0,0,,Saya tahu sudah terlambat,
Dialog: 0,1:25:02.22,1:25:06.30,Lalai,,0,0,0,,tetapi mungkin dia adalah takdir anda.
Dialog: 0,1:25:09.60,1:25:12.51,Lalai,,0,0,0,,Saya tertanya-tanya di mana dia berada, dan apa yang dia lakukan.
Dialog: 0,1:25:19.03,1:25:21.95,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:25:52.18,1:25:54.79,Lalai,,0,0,0,,{\an8}- {\i1}Apakah penghinaan yang dia dapat?\N- Saya akan bunuh awak!{\i0}
Dialog: 0,1:25:54.81,1:25:57.83,Lalai,,0,0,0,,{\an8}{\i1}Walaupun begitu, saya akan membuat pilihan yang sama.{\i0}
Dialog: 0,1:25:57.86,1:26:01.34,Lalai,,0,0,0,,{\an8}{\i1}Anda sepatutnya tahu sekarang,\NI lakukan apa sahaja yang saya fikirkan.{\i0}
Dialog: 0,1:26:01.36,1:26:03.38,Lalai,,0,0,0,,{\an8}{\i1}Tiada jumlah wang yang boleh membeli pengalaman ini.{\i0}
Dialog: 0,1:26:03.40,1:26:05.26,Lalai,,0,0,0,,{\an8}{\i1}- Awak suruh saya tahan!\N- Nepotisme?{\i0}
Dialog: 0,1:26:05.28,1:26:07.84,Lalai,,0,0,0,,{\an8}{\i1}Adakah dia akan berpindah? Adakah dia mahu tinggal bersama anda?{\i0}
Dialog: 0,1:26:07.87,1:26:10.11,Lalai,,0,0,0,,{\an8}{\i1}Tidak boleh. Adakah dia cemburu?{\i0}
Dialog: 0,1:26:10.66,1:26:13.43,Lalai,,0,0,0,,{\an8}{\i1}Dari apa yang saya dengar, dia berpura-pura tidak tahu.{\i0}
Dialog: 0,1:26:13.45,1:26:17.24,Lalai,,0,0,0,,{\an8}{\i1}Saya mempunyai kebolehan untuk mendedahkan kebenaran.{\i0}
Dialog: 0,1:26:17.33,1:26:19.10,Lalai,,0,0,0,,{\an8}{\i1}Ada sesuatu yang perlu saya lakukan.{\i0}
Dialog: 0,1:26:19.13,1:26:20.98,Lalai,,0,0,0,,{\an8}{\i1}Anda benar-benar menguji kesabaran saya,{\i0}
Dialog: 0,1:26:21.00,1:26:23.21,Lalai,,0,0,0,,{\an8}{\i1}jadi sesat sahaja.{\i0}
