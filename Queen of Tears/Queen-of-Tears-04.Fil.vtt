Dialogue: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialogue: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialogue: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialogue: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialogue: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialogue: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialogue: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialogue: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Screenwriter: Park Ji-eun{\c}{\i0}
Dialogue: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mga Direktor: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialogue: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,0:01:02.56,0:01:04.48,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 4{\c}{\i0}
Dialogue: 0,0:01:07.48,0:01:10.26,Default,,0,0,0,,{\an8}Mr. Oh, umalis ka na ba? nasaan ka
Dialogue: 0,0:01:10.90,0:01:13.85,Default,,0,0,0,,{\an8}Ano? Eto na.
Dialogue: 0,0:01:18.53,0:01:20.90,Default,,0,0,0,,{\an8}Nasa bulsa ko.
Dialogue: 0,0:01:23.62,0:01:25.32,Default,,0,0,0,,{\an8}Ano?
Dialogue: 0,0:01:28.50,0:01:30.85,Default,,0,0,0,,{\an8}Hae-in, teka.
Dialogue: 0,0:01:30.88,0:01:32.10,Default,,0,0,0,,{\an8}Maghintay.
Dialogue: 0,0:01:32.13,0:01:33.61,Default,,0,0,0,,{\an8}Maghintay.
Dialogue: 0,0:01:33.63,0:01:35.33,Default,,0,0,0,,{\an8}Teka!
Dialogue: 0,0:01:43.85,0:01:45.55,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:01:46.35,0:01:48.00,Default,,0,0,0,,Hindi ako sigurado.
Dialogue: 0,0:01:48.02,0:01:50.72,Default,,0,0,0,,Ano ako...
Dialogue: 0,0:01:52.40,0:01:54.14,Default,,0,0,0,,ginagawa ngayon?
Dialogue: 0,0:01:54.98,0:01:56.98,Default,,0,0,0,,Natutuwa ako...
Dialogue: 0,0:01:57.15,0:02:00.36,Default,,0,0,0,,nahanap mo ang iyong telepono.
Dialogue: 0,0:02:01.41,0:02:04.69,Default,,0,0,0,,Maaaring mahirap makuha ito.
Dialogue: 0,0:02:11.58,0:02:13.29,Default,,0,0,0,,Bakit hindi ako...
Dialogue: 0,0:02:17.80,0:02:19.63,Default,,0,0,0,,confident?
Dialogue: 0,0:02:19.93,0:02:21.75,Default,,0,0,0,,Ano?
Dialogue: 0,0:02:22.60,0:02:24.59,Default,,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,0:02:27.10,0:02:29.05,Default,,0,0,0,,Tama.
Dialogue: 0,0:02:33.77,0:02:35.77,Default,,0,0,0,,Sabi ko naman sayo diba?
Dialogue: 0,0:02:37.74,0:02:39.44,Default,,0,0,0,,Sisimulan ko na...
Dialogue: 0,0:02:40.07,0:02:42.44,Default,,0,0,0,, sumusubok ng mga bagong bagay.
Dialogue: 0,0:04:32.31,0:04:34.01,Default,,0,0,0,,Magandang gabi.
Dialogue: 0,0:04:35.19,0:04:37.76,Default,,0,0,0,,Tama. Magandang gabi.
Dialogue: 0,0:04:45.61,0:04:47.40,Default,,0,0,0,,Matutulog ka na ba?
Dialogue: 0,0:05:02.42,0:05:04.12,Default,,0,0,0,,Well,
Dialogue: 0,0:05:05.22,0:05:06.79,Default,,0,0,0,,Hindi ako sigurado.
Dialogue: 0,0:05:21.61,0:05:24.23,Default,,0,0,0,,Magre-recharge ito sa lalong madaling panahon.
Dialogue: 0,0:05:24.28,0:05:25.98,Default,,0,0,0,,Ano iyon?
Dialogue: 0,0:05:26.15,0:05:28.17,Default,,0,0,0,,Masasabi niya lang...
Dialogue: 0,0:05:28.20,0:05:29.98,Default,,0,0,0,,gusto niyang pumasok.
Dialogue: 0,0:05:33.04,0:05:35.24,Default,,0,0,0,,Anong meron sa kanya?
Dialogue: 0,0:06:31.39,0:06:33.13,Default,,0,0,0,,Birthday ni Hae-in?
Dialogue: 0,0:06:33.35,0:06:35.84,Default,,0,0,0,,Ang araw na naging public ang department store.
Dialogue: 0,0:06:37.64,0:06:39.47,Default,,0,0,0,,Birthday ko?
Dialogue: 0,0:06:41.77,0:06:44.31,Default,,0,0,0,,Hindi ito ang anibersaryo ng aming kasal.
Dialogue: 0,0:06:44.65,0:06:45.88,Default,,0,0,0,,One Billion Club?
Dialogue: 0,0:06:45.90,0:06:46.92,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Subukan muli sa loob ng 30 segundo{\c}{\i0}
Dialogue: 0,0:06:46.94,0:06:48.89,Default,,0,0,0,,Darn it.
Dialogue: 0,0:07:18.98,0:07:20.68,Default,,0,0,0,,Huwag sabihin sa akin...
Dialogue: 0,0:07:28.40,0:07:30.48,Default,,0,0,0,,Ito ay 1031?
Dialogue: 0,0:07:34.82,0:07:36.24,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}9 Hindi Nabasang Mensahe{\c}{\i0}
Dialogue: 0,0:07:39.31,0:07:40.41,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tanggalin{\c}{\i0}
Dialogue: 0,0:07:40.44,0:07:41.43,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}8 Hindi Nabasang Mensahe{\c}{\i0}
Dialogue: 0,0:07:41.46,0:07:43.03,Default,,0,0,0,,Okay, tapos na.
Dialogue: 0,0:07:43.21,0:07:44.91,Default,,0,0,0,,My gosh.
Dialogue: 0,0:07:46.13,0:07:48.41,Default,,0,0,0,,Gulat mo ako.
Dialogue: 0,0:07:53.38,0:07:55.50,Default,,0,0,0,,Ano ka...
Dialogue: 0,0:07:57.81,0:07:59.51,Default,,0,0,0,,ginagawa dito?
Dialogue: 0,0:08:00.22,0:08:01.93,Default,,0,0,0,,Well...
Dialogue: 0,0:08:04.56,0:08:06.43,Default,,0,0,0,,Hindi ako makatulog, kaya...
Dialogue: 0,0:08:09.36,0:08:11.31,Default,,0,0,0,,Hindi mo...
Dialogue: 0,0:08:11.82,0:08:13.56,Default,,0,0,0,,tulog,
Dialogue: 0,0:08:17.37,0:08:19.61,Default,,0,0,0,,so pumunta ka sa kwarto ko?
Dialogue: 0,0:08:26.08,0:08:27.95,Default,,0,0,0,,Kaya...
Dialogue: 0,0:08:28.79,0:08:30.75,Default,,0,0,0,,dahil sa akin?
Dialogue: 0,0:08:31.92,0:08:35.25,Default,,0,0,0,,Hindi ka makatulog dahil sa akin?
Dialogue: 0,0:08:41.89,0:08:44.20,Default,,0,0,0,,Hindi yun.
Dialogue: 0,0:08:44.23,0:08:47.72,Default,,0,0,0,,Hindi naman ganoon. ako lang...
Dialogue: 0,0:08:47.94,0:08:49.75,Default,,0,0,0,,Hindi ako makatulog,
Dialogue: 0,0:08:49.77,0:08:51.04,Default,,0,0,0,,para sa walang partikular na dahilan,
Dialogue: 0,0:08:51.07,0:08:57.11,Default,,0,0,0,,kaya pumunta ako para tingnan kung pareho ang nararamdaman mo,
Dialogue: 0,0:08:58.45,0:08:59.72,Default,,0,0,0,,at...
Dialogue: 0,0:08:59.74,0:09:02.11,Default,,0,0,0,,kung gusto mong makipag-usap.
Dialogue: 0,0:09:03.62,0:09:05.82,Default,,0,0,0,,Pero pagod ka na, di ba?
Dialogue: 0,0:09:06.54,0:09:08.49,Default,,0,0,0,,Medyo pagod na ako,
Dialogue: 0,0:09:09.00,0:09:12.00,Default,,0,0,0,,pero gawin natin. Mag-usap tayo.
Dialogue: 0,0:09:13.84,0:09:15.54,Default,,0,0,0,,Saan?
Dialogue: 0,0:09:15.80,0:09:16.90,Default,,0,0,0,,Upo ba tayo dito?
Dialogue: 0,0:09:16.93,0:09:18.74,Default,,0,0,0,,Pagod ka na.
Dialogue: 0,0:09:18.76,0:09:21.13,Default,,0,0,0,,Naisip ko yata...
Dialogue: 0,0:09:21.47,0:09:23.16,Default,,0,0,0,,sa sarili ko lang.
Dialogue: 0,0:09:23.18,0:09:25.99,Default,,0,0,0,,Nakainom ka ng ilang beses, at medyo gabi na.
Dialogue: 0,0:09:26.02,0:09:27.25,Default,,0,0,0,,Totoo yan, pero...
Dialogue: 0,0:09:27.27,0:09:29.29,Default,,0,0,0,,Kaya pagod ka na.
Dialogue: 0,0:09:29.31,0:09:31.83,Default,,0,0,0,,Well, I think I've sobered\Nup a little. Umupo na tayo.
Dialogue: 0,0:09:31.86,0:09:34.23,Default,,0,0,0,,Hindi. Huwag umupo.
Dialogue: 0,0:09:34.78,0:09:39.06,Default,,0,0,0,,Ako ay hindi nag-iisip.
Dialogue: 0,0:09:40.41,0:09:42.11,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:09:42.20,0:09:45.95,Default,,0,0,0,,Marami kang gagawin bukas. Dapat magpahinga ka.
Dialogue: 0,0:09:47.21,0:09:49.27,Default,,0,0,0,,Matulog ng mahimbing.
Dialogue: 0,0:09:49.29,0:09:51.29,Default,,0,0,0,,Higa.
Dialogue: 0,0:09:59.34,0:10:01.34,Default,,0,0,0,,Siya ang nagmamalasakit...
Dialogue: 0,0:10:04.27,0:10:06.30,Default,,0,0,0,,sobra para sa akin.
Dialogue: 0,0:10:13.82,0:10:16.23,Default,,0,0,0,,Malapit na iyon.
Dialogue: 0,0:10:40.01,0:10:41.71,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi pwede...{\c}{\i0}
Dialogue: 0,0:10:47.22,0:10:49.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ito ay 1031?{\c}{\i0}
Dialogue: 0,0:10:51.77,0:10:54.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Binabati kita. Apat na linggo kang buntis.{\c}{\i0}
Dialogue: 0,0:10:57.99,0:10:59.67,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Well...{\c}{\i0}
Dialogue: 0,0:10:59.70,0:11:02.40,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apat na linggo...{\c}{\i0}
Dialogue: 0,0:11:02.70,0:11:05.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}At kailan isisilang ang sanggol?{\c}{\i0}
Dialogue: 0,0:11:05.58,0:11:08.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ito ay nakatakda sa Oktubre 31.{\c}{\i0}
Dialogue: 0,0:11:08.87,0:11:12.99,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nakikita ko. Oktubre 31.{\c}{\i0}
Dialogue: 0,0:11:13.92,0:11:15.60,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magandang date iyon.{\c}{\i0}
Dialogue: 0,0:11:15.63,0:11:17.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Oktubre 31.{\c}{\i0}
Dialogue: 0,0:11:33.90,0:11:37.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mangyaring gumamit ng mga de-kalidad na eco-\Nfriendly interior na materyales.{\c}{\i0}
Dialogue: 0,0:11:37.15,0:11:40.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tama. Narinig ko ang bagay na iyon ay\Na kailangan para sa isang silid ng sanggol.{\c}{\i0}
Dialogue: 0,0:12:20.11,0:12:21.80,Default,,0,0,0,,Dapat kong...
Dialogue: 0,0:12:21.82,0:12:23.92,Default,,0,0,0,,Paano ka makakapunta doon?
Dialogue: 0,0:12:23.95,0:12:26.93,Default,,0,0,0,,I mean, hindi pa namin siya nakilala\N ng maayos simula noong ikasal sila,
Dialogue: 0,0:12:26.95,0:12:31.19,Default,,0,0,0,,- pero bigla nilang binanggit ang divorce, kaya...\N- Mom, I tried to stop her.
Dialogue: 0,0:12:31.29,0:12:32.99,Default,,0,0,0,,At sumama ka sa kanya?
Dialogue: 0,0:12:34.17,0:12:35.60,Default,,0,0,0,,Anyway, ano ang sinabi niya?
Dialogue: 0,0:12:35.62,0:12:37.85,Default,,0,0,0,,Wala siyang ideya.
Dialogue: 0,0:12:37.88,0:12:40.51,Default,,0,0,0,,- Oo.\N- Si Hyun-woo lang ang nag-iisip ng divorce.
Dialogue: 0,0:12:40.53,0:12:41.52,Default,,0,0,0,,Talaga?
Dialogue: 0,0:12:41.55,0:12:44.57,Default,,0,0,0,,At sinabi niyang bibisita siya sa amin sa lalong madaling panahon.
Dialogue: 0,0:12:44.59,0:12:46.29,Default,,0,0,0,,- At Tatay.\N- Oo?
Dialogue: 0,0:12:47.85,0:12:51.30,Default,,0,0,0,,Sa wakas ay idinagdag ko siya sa aking messenger app!
Dialogue: 0,0:12:52.93,0:12:55.00,Default,,0,0,0,,Pero paano si Hyun-woo?
Dialogue: 0,0:12:55.02,0:12:57.25,Default,,0,0,0,,Sabi niya hindi niya ito hihiwalayan.
Dialogue: 0,0:12:57.27,0:12:58.79,Default,,0,0,0,,Magaling sila. Huwag kang mag-alala.
Dialogue: 0,0:12:58.81,0:13:01.04,Default,,0,0,0,,- Nakakagaan ng loob.\N- Hindi sila!
Dialogue: 0,0:13:01.07,0:13:05.17,Default,,0,0,0,,Isinasaalang-alang niya ang divorce\Nhabang walang ideya ang kanyang asawa.
Dialogue: 0,0:13:05.20,0:13:06.84,Default,,0,0,0,,Sa tingin mo, maayos na sila?
Dialogue: 0,0:13:06.86,0:13:09.98,Default,,0,0,0,,Wala sa kanila ang nakakaalam ng nararamdaman ng isa.
Dialogue: 0,0:13:14.79,0:13:16.70,Default,,0,0,0,,Imbitahan ako sa chat.
Dialogue: 0,0:13:17.37,0:13:20.62,Default,,0,0,0,,Hindi na ako magsasabi ng marami o magpapadala ng mga larawan.
Dialogue: 0,0:13:36.14,0:13:40.18,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kukuha kami ngayon ng larawan ng\Nmga miyembro ng pamilya at mga kamag-anak.{\c}{\i0}
Dialogue: 0,0:13:43.48,0:13:45.19,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ms. Kim.{\c}{\i0}
Dialogue: 0,0:13:45.95,0:13:47.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Oo?{\c}{\i0}
Dialogue: 0,0:13:48.41,0:13:49.93,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Alam ko...{\c}{\i0}
Dialogue: 0,0:13:49.95,0:13:54.40,Default,,0,0,0,,{\i1}{\c&HFFFF00&}hindi mo gusto si Hyun-woo bilang iyong manugang.{\c}{\i0}
Dialogue: 0,0:13:54.58,0:13:57.10,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ako sigurado kung dapat kong sabihin ito,{\c}{\i0}
Dialogue: 0,0:13:57.12,0:14:00.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero noong sinabi sa amin ni Hyun-woo na may nakikita siya,{\c}{\i0}
Dialogue: 0,0:14:00.75,0:14:04.36,Default,,0,0,0,,{\i1}{\c&HFFFF00&}sabi niya baka matanggal sa trabaho ang babae\Nand ay mawalan ng trabaho sa lalong madaling panahon,{\c}{\i0}
Dialogue: 0,0:14:04.38,0:14:07.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kaya kailangan niyang magbigay\N para sa kanya kung pinakasalan niya ito.{\c}{\i0}
Dialogue: 0,0:14:07.72,0:14:12.07,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pagkatapos ay sinabi ng aming pamilya\N makakahanap siya ng mas mabuting babae,{\c}{\i0}
Dialogue: 0,0:14:12.10,0:14:14.62,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at na siya ay masyadong mahirap.{\c}{\i0}
Dialogue: 0,0:14:14.64,0:14:18.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maging ang isang pamilyang tulad namin ay masyadong nagkalkula.{\c}{\i0}
Dialogue: 0,0:14:18.39,0:14:20.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ko maisip kung ano ang naramdaman mo.{\c}{\i0}
Dialogue: 0,0:14:20.35,0:14:25.04,Default,,0,0,0,,{\i1}{\c&HFFFF00&}May malaking pagkakaiba. Sigurado akong\Nyou ay nabalisa at nabigo.{\c}{\i0}
Dialogue: 0,0:14:25.07,0:14:28.21,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Lahat tayo ay tao, kung tutuusin,{\c}{\i0}
Dialogue: 0,0:14:28.24,0:14:29.55,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kaya...{\c}{\i0}
Dialogue: 0,0:14:29.57,0:14:31.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Naiintindihan ko.{\c}{\i0}
Dialogue: 0,0:14:31.62,0:14:35.61,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tama. Natutuwa akong naiintindihan mo.{\c}{\i0}
Dialogue: 0,0:14:36.08,0:14:37.18,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Alam ko...{\c}{\i0}
Dialogue: 0,0:14:37.20,0:14:38.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}marami ang kulang sa anak ko,{\c}{\i0}
Dialogue: 0,0:14:38.83,0:14:42.16,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero sana alagaan mo siya.{\c}{\i0}
Dialogue: 0,0:14:42.25,0:14:44.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Marami siyang kulang? Malinaw na hindi mo kilala ang iyong anak.{\c}{\i0}
Dialogue: 0,0:14:44.92,0:14:47.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nagawa niyang pakasalan ang anak ko.{\c}{\i0}
Dialogue: 0,0:14:47.17,0:14:49.28,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagay talaga siya.{\c}{\i0}
Dialogue: 0,0:14:49.30,0:14:50.74,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Patawad?{\c}{\i0}
Dialogue: 0,0:14:50.76,0:14:53.45,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ito ay isang papuri. Bilang isang abogado, siya ay dapat...{\c}{\i0}
Dialogue: 0,0:14:53.47,0:14:57.41,Default,,0,0,0,,{\i1}{\c&HFFFF00&}mahusay sa pagkalkula, pagiging praktikal,\Nand kunin ang gusto niya.{\c}{\i0}
Dialogue: 0,0:14:57.43,0:15:00.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Ano ka...?\N- Ang sabi ko matalino siya...{\c}{\i0}
Dialogue: 0,0:15:00.31,0:15:02.43,Default,,0,0,0,,{\i1}{\c&HFFFF00&}na hindi niya pinalampas ang pagkakataong ito.{\c}{\i0}
Dialogue: 0,0:15:03.61,0:15:06.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ano ang ibig mong sabihin, "ang pagkakataong ito"?{\c}{\i0}
Dialogue: 0,0:15:06.36,0:15:08.23,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sigurado akong alam mo.{\c}{\i0}
Dialogue: 0,0:15:08.49,0:15:09.63,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tama.{\c}{\i0}
Dialogue: 0,0:15:09.65,0:15:12.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anuman ang ibig mong sabihin,{\c}{\i0}
Dialogue: 0,0:15:12.16,0:15:15.22,Default,,0,0,0,,{\i1}{\c&HFFFF00&}isa itong kasal sa pagitan ng aming mga anak.{\c}{\i0}
Dialogue: 0,0:15:15.24,0:15:16.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Alam ko iyon.{\c}{\i0}
Dialogue: 0,0:15:16.49,0:15:20.22,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Eksakto. Gusto ko lang sabihin na maganda,{\c}{\i0}
Dialogue: 0,0:15:20.25,0:15:23.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}bilang kanilang mga magulang, kung matutulungan natin sila...{\c}{\i0}
Dialogue: 0,0:15:23.75,0:15:26.61,Default,,0,0,0,,{\i1}{\c&HFFFF00&}lead a happy marriage. Iyon lang.{\c}{\i0}
Dialogue: 0,0:15:26.63,0:15:28.57,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kung kasal nila,{\c}{\i0}
Dialogue: 0,0:15:28.59,0:15:31.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}business nila ang magkaroon ng masayang buhay.{\c}{\i0}
Dialogue: 0,0:15:31.55,0:15:34.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bakit tayo dapat tumulong?{\c}{\i0}
Dialogue: 0,0:15:37.64,0:15:40.18,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sino siya para sabihin sa akin kung ano ang gagawin?{\c}{\i0}
Dialogue: 0,0:15:45.36,0:15:47.42,Default,,0,0,0,,{\i1}Diborsyo o hindi,{\i0}
Dialogue: 0,0:15:47.44,0:15:49.56,Default,,0,0,0,,Nag-aalala ako.
Dialogue: 0,0:15:50.32,0:15:54.56,Default,,0,0,0,,Mangyaring mamuhay ng magandang buhay, pwede ba?
Dialogue: 0,0:15:54.87,0:15:56.57,Default,,0,0,0,,Shoo!
Dialogue: 0,0:16:12.22,0:16:14.40,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Huwag kalimutang uminom ng\Norange juice sa umaga.{\c}{\i0}
Dialogue: 0,0:16:14.43,0:16:16.46,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Iyan ang gamot sa hangover mo.{\c}{\i0}
Dialogue: 0,0:16:19.43,0:16:21.16,Default,,0,0,0,,Hindi ba masyadong malamig?
Dialogue: 0,0:16:21.18,0:16:23.83,Default,,0,0,0,,Gusto mo ipagtimpla kita ng tsaa?
Dialogue: 0,0:16:23.85,0:16:25.66,Default,,0,0,0,,Mas maganda ang isang bagay na mainit.
Dialogue: 0,0:16:25.69,0:16:27.43,Default,,0,0,0,,Magaling ako.
Dialogue: 0,0:16:28.65,0:16:30.35,Default,,0,0,0,,Maghintay.
Dialogue: 0,0:16:48.42,0:16:51.41,Default,,0,0,0,,Panatilihing presentable ang iyong sarili. Hindi ka na bata.
Dialogue: 0,0:17:10.15,0:17:12.52,Default,,0,0,0,,My goodness.
Dialogue: 0,0:17:13.28,0:17:15.94,Default,,0,0,0,,Nagtaka ako kung bakit tumitibok ang puso ko.
Dialogue: 0,0:17:16.99,0:17:20.36,Default,,0,0,0,,Natakot kasi ako. yun lang.
Dialogue: 0,0:17:20.45,0:17:23.36,Default,,0,0,0,,Kaya naman bumilis ang tibok ng puso ko.
Dialogue: 0,0:17:47.14,0:17:50.93,Default,,0,0,0,,Ano sa palagay mo? Isinusuot ko ito sa pagpupulong ngayong gabi.
Dialogue: 0,0:17:57.70,0:17:59.40,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:18:00.32,0:18:03.03,Default,,0,0,0,,Ito ay isang Hercyna vintage jacket mula 1982.
Dialogue: 0,0:18:03.91,0:18:06.77,Default,,0,0,0,,- Totoo ba yun?\N- Dalawang piraso lang ang mundo.
Dialogue: 0,0:18:06.79,0:18:08.60,Default,,0,0,0,,Ang asawa ni CEO Hermann ay may isa,
Dialogue: 0,0:18:08.62,0:18:10.66,Default,,0,0,0,,at ang isa ay ito.
Dialogue: 0,0:18:15.30,0:18:17.00,Default,,0,0,0,,Hindi mo gusto?
Dialogue: 0,0:18:18.59,0:18:20.29,Default,,0,0,0,,Hindi yun.
Dialogue: 0,0:18:20.47,0:18:22.17,Default,,0,0,0,,Well...
Dialogue: 0,0:18:27.48,0:18:29.39,Default,,0,0,0,,Mukhang maayos.
Dialogue: 0,0:18:41.91,0:18:43.86,Default,,0,0,0,,Bakit ang ganda niya?
Dialogue: 0,0:18:44.87,0:18:46.57,Default,,0,0,0,,Bakit?
Dialogue: 0,0:18:48.46,0:18:50.16,Default,,0,0,0,,Bakit sa lupa?
Dialogue: 0,0:18:52.33,0:18:54.04,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:19:04.47,0:19:06.17,Default,,0,0,0,,Tara na.
Dialogue: 0,0:19:08.98,0:19:10.80,Default,,0,0,0,,Gusto ko ang suit mo.
Dialogue: 0,0:19:13.52,0:19:14.58,Default,,0,0,0,,Ang suit ko?
Dialogue: 0,0:19:14.61,0:19:16.77,Default,,0,0,0,,Oo. Mukha kang mabait.
Dialogue: 0,0:19:35.63,0:19:37.91,Default,,0,0,0,,Dapat nasa magandang mood ka.
Dialogue: 0,0:19:38.59,0:19:39.69,Default,,0,0,0,,Hindi, hindi talaga.
Dialogue: 0,0:19:39.72,0:19:41.75,Default,,0,0,0,,Ngunit nag-hum ka.
Dialogue: 0,0:19:42.43,0:19:44.59,Default,,0,0,0,,- Ako?\N- Oo.
Dialogue: 0,0:19:49.43,0:19:51.55,Default,,0,0,0,,- Kailan?\N- Ngayon lang.
Dialogue: 0,0:19:57.61,0:19:58.79,Default,,0,0,0,,Excited ka na ba?
Dialogue: 0,0:19:58.82,0:20:02.52,Default,,0,0,0,,Dahil pinuri ka niya?\NI kaya ka nag-hum?
Dialogue: 0,0:20:02.57,0:20:04.65,Default,,0,0,0,,Sus, nabaliw na ba ako?
Dialogue: 0,0:20:05.28,0:20:09.11,Default,,0,0,0,,Siguro meron, dahil matagal na siyang hindi nagcompliment sa akin, o...
Dialogue: 0,0:20:17.71,0:20:20.71,Default,,0,0,0,,Tingnan mo ang pagsimangot niya. Hindi siya masaya sa isang bagay.
Dialogue: 0,0:20:21.47,0:20:23.07,Default,,0,0,0,,Malapit na siyang magkasakit.
Dialogue: 0,0:20:23.09,0:20:28.32,Default,,0,0,0,,Lima, apat, tatlo, dalawa, isa.
Dialogue: 0,0:20:28.35,0:20:31.37,Default,,0,0,0,,Ano ang nangyari sa pagdekorasyon ng\Npersonal-shopper room na parang gallery?
Dialogue: 0,0:20:31.39,0:20:33.87,Default,,0,0,0,,- Ay, hindi.\N- Ang reputasyon at kulay ng artist...
Dialogue: 0,0:20:33.89,0:20:36.12,Default,,0,0,0,,hindi nababagay sa interior design!
Dialogue: 0,0:20:36.15,0:20:40.64,Default,,0,0,0,,Sigaw at nanlilisik na parang\Nganyan, mukha siyang masama.
Dialogue: 0,0:20:40.73,0:20:44.10,Default,,0,0,0,,Kaya natatakot ako at bumilis ang tibok ng puso ko.
Dialogue: 0,0:20:48.28,0:20:51.24,Default,,0,0,0,,Oo, ito ang tinutukoy ko!
Dialogue: 0,0:20:51.45,0:20:53.97,Default,,0,0,0,,Ano ang nangyari? Excited siya.
Dialogue: 0,0:20:54.00,0:20:55.70,Default,,0,0,0,,Hindi masama.
Dialogue: 0,0:21:07.39,0:21:10.09,Default,,0,0,0,,Ano ang...? Ano bang problema ko?
Dialogue: 0,0:21:11.14,0:21:12.84,Default,,0,0,0,,Bakit ako ngumiti?
Dialogue: 0,0:21:13.39,0:21:14.91,Default,,0,0,0,,Kumuha.
Dialogue: 0,0:21:14.94,0:21:16.41,Default,,0,0,0,,{\i1}Uy, delikado.{\i0}
Dialogue: 0,0:21:16.44,0:21:20.33,Default,,0,0,0,,Alam mo kung paano umibig ang mga aktor sa\Nreal habang kinukunan ang mga romantikong eksena nang magkasama.
Dialogue: 0,0:21:20.36,0:21:22.25,Default,,0,0,0,,Tulad ni Hyun Bin at Son Ye-jin.
Dialogue: 0,0:21:22.28,0:21:23.75,Default,,0,0,0,,Hindi iyon ang kaso.
Dialogue: 0,0:21:23.78,0:21:27.02,Default,,0,0,0,,At binili mo pa siya ng sapatos?
Dialogue: 0,0:21:31.08,0:21:32.51,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kabutihan.{\c}{\i0}
Dialogue: 0,0:21:32.54,0:21:36.14,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ang buong punto ng isang escalator\Nis para maiwasang umakyat.{\c}{\i0}
Dialogue: 0,0:21:36.16,0:21:38.20,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Napakainip niya.{\c}{\i0}
Dialogue: 0,0:21:39.25,0:21:40.95,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ako makapaniwala sa kanya.{\c}{\i0}
Dialogue: 0,0:21:42.13,0:21:43.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mag-ingat!{\c}{\i0}
Dialogue: 0,0:21:51.60,0:21:53.74,Default,,0,0,0,,{\i1}{\c&HFFFF00&}May sumigaw lang ba?{\c}{\i0}
Dialogue: 0,0:21:53.77,0:21:54.87,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Narinig ko rin.{\c}{\i0}
Dialogue: 0,0:21:54.89,0:21:57.84,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anong uri ng loko ang sumisigaw ng ganyan dito?{\c}{\i0}
Dialogue: 0,0:22:06.57,0:22:08.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sir?{\c}{\i0}
Dialogue: 0,0:22:08.16,0:22:09.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maaari ba kitang tulungan?{\c}{\i0}
Dialogue: 0,0:22:10.78,0:22:12.57,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Well...{\c}{\i0}
Dialogue: 0,0:22:13.74,0:22:17.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mayroon ka bang pares nito sa sukat na 6?{\c}{\i0}
Dialogue: 0,0:22:17.58,0:22:20.24,Default,,0,0,0,,{\i1}Kaya pala binili mo ang sapatos para sa kanya?{\i0}
Dialogue: 0,0:22:20.54,0:22:22.81,Default,,0,0,0,,Hindi niya binago ang kanyang kalooban. Hindi ko siya papayagan...
Dialogue: 0,0:22:22.84,0:22:25.06,Default,,0,0,0,,- mahulog at mamatay.\N- Tama.
Dialogue: 0,0:22:25.09,0:22:26.57,Default,,0,0,0,,- Kaya lang?\N- Syempre.
Dialogue: 0,0:22:26.59,0:22:27.82,Default,,0,0,0,,Kahit ako nagulat...
Dialogue: 0,0:22:27.84,0:22:30.53,Default,,0,0,0,,na sobrang kalkulado at cold-hearted ko.
Dialogue: 0,0:22:30.55,0:22:32.88,Default,,0,0,0,,So ano ang sinabi niya?
Dialogue: 0,0:22:45.94,0:22:48.88,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kaya binili mo sila dahil 50% ang diskwento nila?{\c}{\i0}
Dialogue: 0,0:22:48.90,0:22:50.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}At ngayon ang huling araw.{\c}{\i0}
Dialogue: 0,0:22:50.78,0:22:53.26,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Plus, ang 6 ay isang sikat na laki,{\c}{\i0}
Dialogue: 0,0:22:53.28,0:22:55.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at ang mga puti ay\Nsold out sa buong bansa.{\c}{\i0}
Dialogue: 0,0:22:55.79,0:22:58.07,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maliban sa pares na ito.{\c}{\i0}
Dialogue: 0,0:22:58.71,0:23:00.41,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kailangan kong bilhin ang mga ito.{\c}{\i0}
Dialogue: 0,0:23:00.67,0:23:02.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sigurado akong ginawa mo,{\c}{\i0}
Dialogue: 0,0:23:02.75,0:23:05.10,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero ang shoe closet ko...{\c}{\i0}
Dialogue: 0,0:23:05.13,0:23:08.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ay puno ng mamahaling sapatos\NI ay kailangang magbayad ng dagdag para makabili.{\c}{\i0}
Dialogue: 0,0:23:08.72,0:23:12.57,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magsusuot ba ako ng mga binili sa kalahating presyo?{\c}{\i0}
Dialogue: 0,0:23:12.59,0:23:16.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Siyempre alam kong marami ka\Nof mahal, marangyang sapatos,{\c}{\i0}
Dialogue: 0,0:23:17.40,0:23:19.64,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ngunit wala sa kanila ang komportable.{\c}{\i0}
Dialogue: 0,0:23:21.77,0:23:24.64,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Ang ganda nila.\N- Ang ganda mo kahit wala sila.{\c}{\i0}
Dialogue: 0,0:23:25.27,0:23:30.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bukod dito, ang mga takong ay napakanipis at mataas.{\c}{\i0}
Dialogue: 0,0:23:31.91,0:23:34.02,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nag-aalala akong baka mahulog ka,{\c}{\i0}
Dialogue: 0,0:23:35.45,0:23:37.26,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kaya bakit hindi mo...{\c}{\i0}
Dialogue: 0,0:23:37.29,0:23:39.82,Default,,0,0,0,,{\i1}{\c&HFFFF00&}magsuot ng kumportableng sapatos paminsan-minsan?{\c}{\i0}
Dialogue: 0,0:23:43.54,0:23:45.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Iwanan sila dito, kung gayon.{\c}{\i0}
Dialogue: 0,0:23:45.84,0:23:47.56,Default,,0,0,0,,Hindi niya sila gusto noon.
Dialogue: 0,0:23:47.59,0:23:49.86,Default,,0,0,0,,Hindi ako makapaniwala sa reaksyon niya.
Dialogue: 0,0:23:49.88,0:23:51.23,Default,,0,0,0,,Pero mas hindi kapani-paniwala?
Dialogue: 0,0:23:51.26,0:23:52.79,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:23:55.01,0:23:57.09,Default,,0,0,0,,Sinuot niya ang mga ito.
Dialogue: 0,0:24:05.23,0:24:08.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Wow, mukhang si Ms. Hong...\N- Tama ba?{\c}{\i0}
Dialogue: 0,0:24:08.36,0:24:10.06,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maganda, tama ba?{\c}{\i0}
Dialogue: 0,0:24:10.40,0:24:12.98,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi, napaka-feisty niya ngayon.{\c}{\i0}
Dialogue: 0,0:24:15.28,0:24:17.98,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Parang handa siyang durugin ang sinuman.{\c}{\i0}
Dialogue: 0,0:24:20.00,0:24:21.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Eksakto.{\c}{\i0}
Dialogue: 0,0:24:22.50,0:24:26.20,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anyway, napakadalas ng pagkikita ng dalawang iyon sa mga araw na ito.{\c}{\i0}
Dialogue: 0,0:24:26.33,0:24:28.83,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Ito si Secretary Na.\N- Hi.{\c}{\i0}
Dialogue: 0,0:24:28.92,0:24:30.75,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tama.{\c}{\i0}
Dialogue: 0,0:24:30.92,0:24:34.08,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ito ay dahil sa Hercyna store.{\c}{\i0}
Dialogue: 0,0:24:34.97,0:24:38.03,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamakailan ay bumibisita si Mr. Yoon araw-araw,{\c}{\i0}
Dialogue: 0,0:24:38.05,0:24:39.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pagkain at kape,{\c}{\i0}
Dialogue: 0,0:24:39.56,0:24:42.22,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at kahit na mamasyal kasama siya.{\c}{\i0}
Dialogue: 0,0:24:43.81,0:24:46.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mukhang hindi mo alam ito,{\c}{\i0}
Dialogue: 0,0:24:46.35,0:24:48.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ngunit ang mga workaholic ay gumagamit pa ng...{\c}{\i0}
Dialogue: 0,0:24:48.36,0:24:52.14,Default,,0,0,0,,{\i1}{\c&HFFFF00&}mga oras ng pagkain at coffee break para pag-usapan ang tungkol sa trabaho.{\c}{\i0}
Dialogue: 0,0:24:52.28,0:24:53.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kaya nga.{\c}{\i0}
Dialogue: 0,0:25:03.25,0:25:05.02,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mr. Maaaring kaibigan niya si Yoon,{\c}{\i0}
Dialogue: 0,0:25:05.04,0:25:08.49,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero malinaw na hindi niya kilala si Hae-in.{\c}{\i0}
Dialogue: 0,0:25:08.67,0:25:09.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in hate it...{\c}{\i0}
Dialogue: 0,0:25:09.84,0:25:13.61,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kapag may humawak sa buhok niya ng ganoon.{\c}{\i0}
Dialogue: 0,0:25:13.63,0:25:15.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nakangiti siya.{\c}{\i0}
Dialogue: 0,0:25:16.30,0:25:19.84,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mukhang hindi niya talaga ito kinasusuklaman.{\c}{\i0}
Dialogue: 0,0:25:21.39,0:25:24.80,Default,,0,0,0,,Kaya ba nakakaistorbo ka ba?\NDNagseselos ka ba?
Dialogue: 0,0:25:25.39,0:25:28.46,Default,,0,0,0,,Nakikinig ka ba? Hindi mo ba nakukuha ang punto ko?
Dialogue: 0,0:25:28.48,0:25:31.31,Default,,0,0,0,,Yan ang punto mo. Nagseselos ka.
Dialogue: 0,0:25:31.82,0:25:34.06,Default,,0,0,0,,Hindi mo ba alam kung ano ang ibig sabihin ng "selos"?
Dialogue: 0,0:25:34.15,0:25:36.84,Default,,0,0,0,,Iyan ang nararamdaman mo kapag may gusto ka sa isang tao,
Dialogue: 0,0:25:36.86,0:25:39.63,Default,,0,0,0,,at may lumalabas na karibal.
Dialogue: 0,0:25:39.66,0:25:41.01,Default,,0,0,0,,Maling premise iyon.
Dialogue: 0,0:25:41.03,0:25:43.51,Default,,0,0,0,,Ayoko kay Hae-in.\NBakit naman ako magseselos?
Dialogue: 0,0:25:43.54,0:25:46.31,Default,,0,0,0,,- Kaya hindi ka nakakaabala?\N- Hindi, hindi naman.
Dialogue: 0,0:25:46.33,0:25:48.68,Default,,0,0,0,,Wala akong pakialam kung close sila,
Dialogue: 0,0:25:48.71,0:25:50.81,Default,,0,0,0,,o kung pumunta sila kahit saan magkasama.
Dialogue: 0,0:25:50.84,0:25:54.54,Default,,0,0,0,,Nakuha ko, pero ano ka\Ngrilling sa halip na karne?
Dialogue: 0,0:26:08.10,0:26:10.26,Default,,0,0,0,,Iyan ba ang suot mo?
Dialogue: 0,0:26:10.48,0:26:14.77,Default,,0,0,0,,Binili ito ng aking asawa para sa akin, at\Nasked na isuot ko ang mga ito. Ano ang magagawa ko?
Dialogue: 0,0:26:15.36,0:26:19.92,Default,,0,0,0,,Gayunpaman, nakikipagkita kami sa CEO ng Hercyna.\NHindi ba mas mabuting isuot ang kanilang sapatos?
Dialogue: 0,0:26:19.95,0:26:21.90,Default,,0,0,0,,Gusto mo bang hanapin kita?
Dialogue: 0,0:26:22.28,0:26:24.05,Default,,0,0,0,,Suot ko ang mga damit nila.
Dialogue: 0,0:26:24.08,0:26:25.85,Default,,0,0,0,,Hindi komportable ang kanilang mga sapatos,
Dialogue: 0,0:26:25.87,0:26:29.02,Default,,0,0,0,,at nag-aalala siya na baka mahulog ako.
Dialogue: 0,0:26:29.04,0:26:30.57,Default,,0,0,0,,Sino?
Dialogue: 0,0:26:31.00,0:26:32.66,Default,,0,0,0,,Hyun-woo ay.
Dialogue: 0,0:26:33.30,0:26:35.50,Default,,0,0,0,,Nakakabahala.
Dialogue: 0,0:26:54.27,0:26:55.85,Default,,0,0,0,,Tama.
Dialogue: 0,0:26:58.19,0:26:59.94,Default,,0,0,0,,Ano?
Dialogue: 0,0:27:00.91,0:27:03.84,Default,,0,0,0,,Kahit anong sabihin ni Hermann, makinig ka lang.
Dialogue: 0,0:27:03.87,0:27:05.48,Default,,0,0,0,,Kapag tapos na siya,
Dialogue: 0,0:27:05.66,0:27:07.53,Default,,0,0,0,,sabihin mo lang ang isang bagay.
Dialogue: 0,0:27:31.85,0:27:33.71,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sara Lopez?{\c}{\i0}
Dialogue: 0,0:27:33.73,0:27:37.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sikat na designer siya sa Europe.\NPinaplano naming magbukas ng tindahan.{\c}{\i0}
Dialogue: 0,0:27:37.62,0:27:39.19,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ano naman sa kanya?{\c}{\i0}
Dialogue: 0,0:27:39.65,0:27:41.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Siya ang bagong mistress ni Hermann.{\c}{\i0}
Dialogue: 0,0:27:44.74,0:27:47.03,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi alam ng asawa niya?{\c}{\i0}
Dialogue: 0,0:27:47.79,0:27:51.27,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Siya ay isang mainitin ang ulo, mahusay na abogado.{\c}{\i0}
Dialogue: 0,0:27:51.29,0:27:52.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kung malalaman niya,{\c}{\i0}
Dialogue: 0,0:27:52.87,0:27:56.08,Default,,0,0,0,,{\i1}{\c&HFFFF00&}hindi na niya makikita ang kanyang baby girl.{\c}{\i0}
Dialogue: 0,0:28:39.09,0:28:41.83,Default,,0,0,0,,Pinandilatan ka ni Hermann.
Dialogue: 0,0:28:43.09,0:28:46.59,Default,,0,0,0,,Dahil bukod sa dalawa,\NI lang ang nakakaalam.
Dialogue: 0,0:28:47.22,0:28:49.30,Default,,0,0,0,,Hindi ka ba inaayos, kung ganoon?
Dialogue: 0,0:28:50.06,0:28:51.24,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:28:51.27,0:28:55.43,Default,,0,0,0,,Mayroon pa akong ilang card na laruin laban sa kanya.
Dialogue: 0,0:28:57.44,0:28:59.13,Default,,0,0,0,,Tama si Ye-na.
Dialogue: 0,0:28:59.15,0:29:01.79,Default,,0,0,0,,Hindi ikaw ang Eun-sung na kilala ko.
Dialogue: 0,0:29:01.82,0:29:03.94,Default,,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:29:05.53,0:29:07.73,Default,,0,0,0,,Nagsumikap ako...
Dialogue: 0,0:29:07.87,0:29:10.15,Default,,0,0,0,,para marinig ito mula sa iyo.
Dialogue: 0,0:29:11.08,0:29:15.20,Default,,0,0,0,,Utang o kabaitan, lagi kong binabayaran. may utang ako sayo.
Dialogue: 0,0:29:17.33,0:29:19.74,Default,,0,0,0,,Sige. Hahawakan kita nito.
Dialogue: 0,0:29:26.63,0:29:28.85,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Walnut and Peanut Snacks{\c}{\i0}
Dialogue: 0,0:29:32.43,0:29:34.03,Default,,0,0,0,,Isang bag ng peanut cake, pakiusap.
Dialogue: 0,0:29:34.06,0:29:35.16,Default,,0,0,0,,Oo naman.
Dialogue: 0,0:29:35.19,0:29:37.25,Default,,0,0,0,,Paki-pack ito sa dalawang layer.
Dialogue: 0,0:29:37.27,0:29:38.97,Default,,0,0,0,,Okay.
Dialogue: 0,0:29:39.81,0:29:42.02,Default,,0,0,0,,- Iuuwi mo na?\N- Oo.
Dialogue: 0,0:29:46.82,0:29:48.67,Default,,0,0,0,,Ito ang dahilan kung bakit ako naghihinala.
Dialogue: 0,0:29:48.70,0:29:52.76,Default,,0,0,0,,Sa aking paningin, kung iisipin mo\Nher kapag nakita mo itong mga meryenda...
Dialogue: 0,0:29:52.79,0:29:54.99,Default,,0,0,0,,kapag lasing ka,
Dialogue: 0,0:29:55.71,0:29:57.89,Default,,0,0,0,,ibig sabihin mahal mo siya!
Dialogue: 0,0:29:57.92,0:29:58.98,Default,,0,0,0,,Love, my foot.
Dialogue: 0,0:29:59.00,0:30:01.40,Default,,0,0,0,,- Mga peanut cake lang sila.\N- Eto.
Dialogue: 0,0:30:01.42,0:30:03.20,Default,,0,0,0,,Gusto mo rin?
Dialogue: 0,0:30:03.42,0:30:05.52,Default,,0,0,0,,- Salamat.\N- Salamat.
Dialogue: 0,0:30:05.55,0:30:07.25,Default,,0,0,0,,Sila lang...
Dialogue: 0,0:30:09.01,0:30:10.71,Default,,0,0,0,, peanut cakes.
Dialogue: 0,0:30:15.06,0:30:18.37,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Nasaan ka? Magmadaling umuwi.\NI may sasabihin sa iyo.{\c}{\i0}
Dialogue: 0,0:30:18.39,0:30:21.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Huwag mag-alala. Isang magandang balita na magugustuhan mo.{\c}{\i0}
Dialogue: 0,0:30:21.11,0:30:22.33,Default,,0,0,0,,May sasabihin sa akin?
Dialogue: 0,0:30:22.36,0:30:25.27,Default,,0,0,0,,Magandang balita na magugustuhan mo?
Dialogue: 0,0:30:26.90,0:30:28.59,Default,,0,0,0,,Teka! Hindi pwede.
Dialogue: 0,0:30:28.61,0:30:30.97,Default,,0,0,0,,- Ano?\N- "Iniiwan ko lahat ng asset ko..."
Dialogue: 0,0:30:30.99,0:30:32.84,Default,,0,0,0,,"kay Baek Hyun-woo."
Dialogue: 0,0:30:32.87,0:30:34.65,Default,,0,0,0,,Pagbabago sa kanyang kalooban.
Dialogue: 0,0:30:38.16,0:30:40.48,Default,,0,0,0,,- Halika. No way.\N- Yes way!
Dialogue: 0,0:30:40.50,0:30:42.73,Default,,0,0,0,,Ito ay dapat!
Dialogue: 0,0:30:42.75,0:30:45.27,Default,,0,0,0,,Congrats, ikaw na punk!
Dialogue: 0,0:30:45.30,0:30:47.48,Default,,0,0,0,,- Wag mo akong kalimutan.\N- Hindi pwede yun.
Dialogue: 0,0:30:47.51,0:30:48.65,Default,,0,0,0,,Hayaan mo.
Dialogue: 0,0:30:48.68,0:30:50.38,Default,,0,0,0,,Punk ka!
Dialogue: 0,0:30:52.47,0:30:54.09,Default,,0,0,0,,Hey.
Dialogue: 0,0:30:54.22,0:30:56.30,Default,,0,0,0,,Hey.
Dialogue: 0,0:30:58.60,0:31:02.01,Default,,0,0,0,,Ito ay mga peanut cake. Gusto ng ilan?
Dialogue: 0,0:31:12.24,0:31:14.94,Default,,0,0,0,,Gusto kong ibigay ito sa iyo bago pa manlamig,
Dialogue: 0,0:31:14.99,0:31:16.94,Default,,0,0,0,,kaya nagmadali akong umuwi.
Dialogue: 0,0:31:21.04,0:31:22.74,Default,,0,0,0,,Paano ito?
Dialogue: 0,0:31:22.88,0:31:23.98,Default,,0,0,0,,Mabuti naman.
Dialogue: 0,0:31:24.00,0:31:25.70,Default,,0,0,0,,Mainit pa rin.
Dialogue: 0,0:31:26.13,0:31:27.83,Default,,0,0,0,,Tama?
Dialogue: 0,0:31:31.59,0:31:33.29,Default,,0,0,0,,Nga pala,
Dialogue: 0,0:31:33.51,0:31:37.16,Default,,0,0,0,,ano itong magandang balita na magugustuhan ko?
Dialogue: 0,0:31:37.18,0:31:38.88,Default,,0,0,0,,Tama.
Dialogue: 0,0:31:39.64,0:31:41.47,Default,,0,0,0,,Bakit hindi mo ito buksan?
Dialogue: 0,0:31:43.02,0:31:44.72,Default,,0,0,0,,Ito?
Dialogue: 0,0:31:49.61,0:31:51.40,Default,,0,0,0,,Buksan ito?
Dialogue: 0,0:31:54.03,0:31:56.19,Default,,0,0,0,,Huwag kang mabigla.
Dialogue: 0,0:31:58.54,0:32:00.24,Default,,0,0,0,,Okay.
Dialogue: 0,0:32:00.29,0:32:02.07,Default,,0,0,0,,Ayoko.
Dialogue: 0,0:32:04.63,0:32:06.10,Default,,0,0,0,,Nakuha ko ito kanina lang.
Dialogue: 0,0:32:06.13,0:32:09.02,Default,,0,0,0,,Ito ay mula sa isa sa pinakamahusay na\Ncancer center sa Europe.
Dialogue: 0,0:32:09.05,0:32:13.13,Default,,0,0,0,,Sa mga susunod na pahina ay ang kanilang mga research paper.
Dialogue: 0,0:32:20.14,0:32:21.24,Default,,0,0,0,,Oo.
Dialogue: 0,0:32:21.27,0:32:22.37,Default,,0,0,0,,Tama.
Dialogue: 0,0:32:22.39,0:32:25.58,Default,,0,0,0,,Akala nila kaya nila akong gamutin,
Dialogue: 0,0:32:25.61,0:32:27.77,Default,,0,0,0,,- Ano?\N- ...at ang pagkakataon...
Dialogue: 0,0:32:31.82,0:32:33.65,Default,,0,0,0,,higit sa 50%.
Dialogue: 0,0:32:33.86,0:32:35.73,Default,,0,0,0,,Over?
Dialogue: 0,0:32:36.62,0:32:38.98,Default,,0,0,0,,Alam kong magiging masaya ka.
Dialogue: 0,0:32:42.12,0:32:43.82,Default,,0,0,0,,Dito.
Dialogue: 0,0:32:44.44,0:32:47.31,Default,,0,0,0,,Ang pagkakataon ay humigit-kumulang 51%,
Dialogue: 0,0:32:47.34,0:32:49.98,Default,,0,0,0,,at gusto nilang gumawa ng mga klinikal na paggamot sa akin.
Dialogue: 0,0:32:50.00,0:32:52.23,Default,,0,0,0,,- Totoo naman.\N- Anong sinabi ko?
Dialogue: 0,0:32:52.26,0:32:54.90,Default,,0,0,0,,Sabi ko hindi ako magpapatalo sa sakit na iyon.
Dialogue: 0,0:32:54.93,0:32:56.88,Default,,0,0,0,,Na ang Diyos ay nasa aking panig.
Dialogue: 0,0:32:56.93,0:32:59.51,Default,,0,0,0,,Kakampi ka,
Dialogue: 0,0:32:59.64,0:33:01.55,Default,,0,0,0,,at gayundin ang Diyos.
Dialogue: 0,0:33:01.93,0:33:04.51,Default,,0,0,0,,My goodness.
Dialogue: 0,0:33:05.06,0:33:07.14,Default,,0,0,0,,Napanatag ang loob ko.
Dialogue: 0,0:33:42.72,0:33:44.30,Default,,0,0,0,,Kung...
Dialogue: 0,0:33:44.52,0:33:46.55,Default,,0,0,0,,gumaling na siya,
Dialogue: 0,0:33:47.23,0:33:48.87,Default,,0,0,0,,pagkatapos...
Dialogue: 0,0:33:48.90,0:33:50.21,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Natapos ang hapunan ng team...{\c}{\i0}
Dialogue: 0,0:33:50.23,0:33:54.04,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- 9:30 kagabi, kaya bakit...?\N- Bakit kailangan mong ilabas ito sa...?{\c}{\i0}
Dialogue: 0,0:33:54.07,0:33:56.02,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ko ba nasabi sa iyo?{\c}{\i0}
Dialogue: 0,0:33:56.15,0:33:58.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nag-aalala lang ako.{\c}{\i0}
Dialogue: 0,0:33:58.66,0:34:00.30,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Say something!\N- Hindi si Hyun-woo.{\c}{\i0}
Dialogue: 0,0:34:00.32,0:34:03.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Bahagi ka ng aming pamilyang Hong!\N- Hyun-woo!{\c}{\i0}
Dialogue: 0,0:34:06.08,0:34:10.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bilisan mo. Mahuhuli na tayo.\NIto ang dahilan kung bakit palagi kang nahuhuli.{\c}{\i0}
Dialogue: 0,0:34:10.50,0:34:13.75,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Sorry.\N- Nakakadismaya ka.{\c}{\i0}
Dialogue: 0,0:34:57.17,0:34:58.96,Default,,0,0,0,,Buhay na ganyan...
Dialogue: 0,0:34:59.47,0:35:01.59,Default,,0,0,0,,sa loob ng 50 taon pa?
Dialogue: 0,0:35:03.51,0:35:05.21,Default,,0,0,0,,Hindi.
Dialogue: 0,0:35:06.47,0:35:08.34,Default,,0,0,0,,Dapat akong makipagdiborsiyo...
Dialogue: 0,0:35:08.43,0:35:10.89,Default,,0,0,0,,gaya ng orihinal kong pinlano.
Dialogue: 0,0:35:12.40,0:35:13.37,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kasunduan sa Diborsiyo{\c}{\i0}
Dialogue: 0,0:35:15.23,0:35:17.06,Default,,0,0,0,,{\i1}Tama.{\i0}
Dialogue: 0,0:35:17.11,0:35:20.15,Default,,0,0,0,,{\i1}Ngayong gumaling na ako,{\i0}
Dialogue: 0,0:35:20.53,0:35:22.59,Default,,0,0,0,,{\i1}ipagtaksilan mo ba ako?{\i0}
Dialogue: 0,0:35:22.62,0:35:25.18,Default,,0,0,0,,{\i1}Nabawi mo ang iyong buhay,{\i0}
Dialogue: 0,0:35:25.20,0:35:28.11,Default,,0,0,0,,{\i1}kaya gusto ko rin bumalik sa akin.{\i0}
Dialogue: 0,0:35:32.08,0:35:33.78,Default,,0,0,0,,{\i1}Tama.{\i0}
Dialogue: 0,0:35:34.13,0:35:37.00,Default,,0,0,0,,{\i1}Nararamdaman iyon ng mga tao.{\i0}
Dialogue: 0,0:35:37.09,0:35:38.79,Default,,0,0,0,,{\i1}Naiintindihan ito.{\i0}
Dialogue: 0,0:35:41.51,0:35:43.25,Default,,0,0,0,,{\i1}Gayunpaman...{\i0}
Dialogue: 0,0:35:54.31,0:35:56.89,Default,,0,0,0,,{\i1}Hindi aking mga tao.{\i0}
Dialogue: 0,0:36:03.41,0:36:08.28,Default,,0,0,0,,Maaaring mas malala pa ito kaysa sa aking imahinasyon.
Dialogue: 0,0:36:15.59,0:36:17.02,Default,,0,0,0,,Sus, pagod na ako.
Dialogue: 0,0:36:17.04,0:36:18.19,Default,,0,0,0,,- Goodness.\N- Okay ka lang?
Dialogue: 0,0:36:18.21,0:36:19.52,Default,,0,0,0,,Oo, ayos lang ako.
Dialogue: 0,0:36:19.55,0:36:22.62,Default,,0,0,0,,Goodness, nakakapagod.
Dialogue: 0,0:36:25.26,0:36:26.99,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:36:27.01,0:36:28.87,Default,,0,0,0,,Naging mas mabuti ako.
Dialogue: 0,0:36:28.89,0:36:32.09,Default,,0,0,0,,Tatay, hindi ka ba nauuhaw? Magkaroon ng ganito.
Dialogue: 0,0:36:33.27,0:36:35.14,Default,,0,0,0,,Tama. Salamat.
Dialogue: 0,0:36:36.56,0:36:39.46,Default,,0,0,0,,Pwede ko ba talagang inumin to?\NHindi mo naman nilason 'yan diba?
Dialogue: 0,0:36:39.48,0:36:42.56,Default,,0,0,0,,Halika, Tatay. Inumin mo na lang.
Dialogue: 0,0:36:42.61,0:36:44.46,Default,,0,0,0,,Ano ang nangyari sa iyo?
Dialogue: 0,0:36:44.49,0:36:46.77,Default,,0,0,0,,Palagi akong ganito.
Dialogue: 0,0:36:47.62,0:36:49.34,Default,,0,0,0,,Tingnan mo ito.
Dialogue: 0,0:36:49.37,0:36:51.10,Default,,0,0,0,,Masaya kaming magkasama noon.
Dialogue: 0,0:36:51.12,0:36:55.02,Default,,0,0,0,,I mean, dati kami, before\Nilang babaeng babae ang pumasok sa picture.
Dialogue: 0,0:36:55.04,0:36:56.94,Default,,0,0,0,,Hindi kami ganito kagulo.
Dialogue: 0,0:36:56.96,0:36:59.66,Default,,0,0,0,,Mr. Hong, pasok muna ako sa loob.
Dialogue: 0,0:37:11.14,0:37:14.05,Default,,0,0,0,,Tatay, naaalala mo ba...
Dialogue: 0,0:37:14.10,0:37:16.58,Default,,0,0,0,,gaano mo ako kamahal?
Dialogue: 0,0:37:16.60,0:37:17.66,Default,,0,0,0,,You doted on me.
Dialogue: 0,0:37:17.69,0:37:21.63,Default,,0,0,0,,Palagi kang bumibili ng regalo para sa akin noong pabalik ka mula sa iyong mga business trip.
Dialogue: 0,0:37:21.65,0:37:23.59,Default,,0,0,0,,Matagal nang nakalipas.
Dialogue: 0,0:37:23.61,0:37:27.93,Default,,0,0,0,,Lagi mong sinasabi sa akin na tumira sa\Nyou habang buhay nang hindi nag-aasawa,
Dialogue: 0,0:37:27.95,0:37:30.39,Default,,0,0,0,,and see? kasama pa rin kita.
Dialogue: 0,0:37:30.41,0:37:33.66,Default,,0,0,0,,Hindi ko sinabing magpakasal ka at bumalik ka.
Dialogue: 0,0:37:33.69,0:37:34.72,Default,,0,0,0,,Halika.
Dialogue: 0,0:37:34.75,0:37:36.98,Default,,0,0,0,,Malapit nang bumalik ang pag-ibig, Tatay.
Dialogue: 0,0:37:37.00,0:37:40.15,Default,,0,0,0,,Bakit ako bumalik sa loob ng\Ntatlong taon tuwing ikasal ako?
Dialogue: 0,0:37:40.17,0:37:42.83,Default,,0,0,0,,Iyan ay dahil...
Dialogue: 0,0:37:43.05,0:37:45.69,Default,,0,0,0,,mahal ka ng iyong magandang anak.
Dialogue: 0,0:37:45.72,0:37:47.95,Default,,0,0,0,,Hoy, tumigil ka. malapit na akong kumain.
Dialogue: 0,0:37:47.97,0:37:49.82,Default,,0,0,0,,- Mawawalan ako ng gana.\N- Naku.
Dialogue: 0,0:37:49.85,0:37:52.07,Default,,0,0,0,,Hindi ka dapat mawalan ng gana.
Dialogue: 0,0:37:52.10,0:37:55.33,Default,,0,0,0,,Sa edad mo, mas delikado\Nsa maubusan ng pera.
Dialogue: 0,0:37:55.35,0:37:59.26,Default,,0,0,0,,Ano ito? Sabihin mo lang.\NBakit ka nagkakaganito?
Dialogue: 0,0:38:00.11,0:38:02.92,Default,,0,0,0,,Alam mo, birthday ko\Nkinabukasan.
Dialogue: 0,0:38:02.94,0:38:05.48,Default,,0,0,0,,Ayoko ng iba.
Dialogue: 0,0:38:05.57,0:38:09.55,Default,,0,0,0,,Gusto ko lang makipag-date kasama\Nmy beloved dad, tayong dalawa lang.
Dialogue: 0,0:38:09.57,0:38:11.57,Default,,0,0,0,,- Please?\N- My gosh.
Dialogue: 0,0:38:11.91,0:38:14.44,Default,,0,0,0,,Pakiusap, Tatay?
Dialogue: 0,0:38:14.62,0:38:17.02,Default,,0,0,0,,Gusto kong may masarap kasama ka.
Dialogue: 0,0:38:17.04,0:38:19.64,Default,,0,0,0,,- Itigil mo na.\N- Gagawin mo ba akong maganda?
Dialogue: 0,0:38:19.67,0:38:22.19,Default,,0,0,0,,Hoy, tumigil ka. Grabe yan!
Dialogue: 0,0:38:22.21,0:38:24.16,Default,,0,0,0,,Stop! umalis ka na!
Dialogue: 0,0:38:50.20,0:38:51.98,Default,,0,0,0,,Hey.
Dialogue: 0,0:38:52.74,0:38:54.39,Default,,0,0,0,,- Hello.\N- Hello.
Dialogue: 0,0:38:54.41,0:38:57.39,Default,,0,0,0,,Anong ginagawa mo dito sa\Numaga sa weekend?
Dialogue: 0,0:38:57.41,0:38:59.18,Default,,0,0,0,,Para sa negosasyon kay Hercyna.
Dialogue: 0,0:39:00.10,0:39:01.60,Default,,0,0,0,,Kung gayon dapat akong sumama sa iyo.
Dialogue: 0,0:39:01.63,0:39:05.61,Default,,0,0,0,,Dapat nasa loop ang legal na team para magtrabaho sa mga detalye.
Dialogue: 0,0:39:05.63,0:39:06.65,Default,,0,0,0,,Darating yan mamaya.
Dialogue: 0,0:39:06.67,0:39:10.15,Default,,0,0,0,,Tinatalakay namin ang\Nnegosasyon sa pagitan ng mga CEO,
Dialogue: 0,0:39:10.18,0:39:13.38,Default,,0,0,0,,upang alisin ang anumang mga salik na lumalabag sa deal.
Dialogue: 0,0:39:14.68,0:39:17.24,Default,,0,0,0,,Naiistorbo ka ba namin? Maaari tayong pumunta sa ibang lugar.
Dialogue: 0,0:39:17.27,0:39:19.13,Default,,0,0,0,,Paano ang aking hotel?
Dialogue: 0,0:39:19.48,0:39:21.12,Default,,0,0,0,,Magagawa mo lang dito.
Dialogue: 0,0:39:21.15,0:39:23.14,Default,,0,0,0,,Narito, kumportable.
Dialogue: 0,0:39:24.77,0:39:26.35,Default,,0,0,0,,Salamat.
Dialogue: 0,0:39:26.40,0:39:27.88,Default,,0,0,0,,Dapat akong magpasalamat sa iyo.
Dialogue: 0,0:39:27.90,0:39:30.13,Default,,0,0,0,,Tumutulong ka sa asawa ko.
Dialogue: 0,0:39:30.15,0:39:31.13,Default,,0,0,0,,Gusto mo ng kape?
Dialogue: 0,0:39:31.16,0:39:33.19,Default,,0,0,0,,- Oo, salamat.\N- Sige.
Dialogue: 0,0:39:33.78,0:39:37.40,Default,,0,0,0,,Ikaw din? Hindi ka umiinom ng\Nkape nang walang laman ang tiyan.
Dialogue: 0,0:39:43.75,0:39:45.45,Default,,0,0,0,,Totoo iyan.
Dialogue: 0,0:39:46.42,0:39:49.96,Default,,0,0,0,,- Isang espresso para sa iyo, tama ba?\N- Oo.
Dialogue: 0,0:40:01.14,0:40:04.26,Default,,0,0,0,,Sobrang nagmamalasakit siya sa akin.
Dialogue: 0,0:40:04.98,0:40:06.81,Default,,0,0,0,,Ano?
Dialogue: 0,0:40:07.40,0:40:11.60,Default,,0,0,0,,Sabi niya ang kape ay parang lason sa\Nan na walang laman ang tiyan at ito ay hindi malusog.
Dialogue: 0,0:40:12.86,0:40:15.05,Default,,0,0,0,,Hindi niya ako pinainom.
Dialogue: 0,0:40:15.07,0:40:17.48,Default,,0,0,0,,I mean, hindi ko siya anak, alam mo ba?
Dialogue: 0,0:40:18.87,0:40:21.11,Default,,0,0,0,,I guess she can't stop...
Dialogue: 0,0:40:21.16,0:40:23.23,Default,,0,0,0,,nag-aalala tungkol sa akin.
Dialogue: 0,0:40:23.25,0:40:26.24,Default,,0,0,0,,Si Hae-in ay dapat na nagmamalasakit sa iyo.
Dialogue: 0,0:40:26.71,0:40:28.41,Default,,0,0,0,,Nainggit ako sa iyo.
Dialogue: 0,0:40:28.75,0:40:30.86,Default,,0,0,0,,Well, oo. Sa tingin ko rin.
Dialogue: 0,0:40:30.88,0:40:32.86,Default,,0,0,0,,Hindi siya ganyan sa akin.
Dialogue: 0,0:40:32.88,0:40:37.50,Default,,0,0,0,,Lagi siyang humihingi ng tulong sa akin, sinasabing\NI'm the only one who can help her.
Dialogue: 0,0:40:37.56,0:40:39.59,Default,,0,0,0,,Ganyan siya palagi.
Dialogue: 0,0:40:39.64,0:40:44.33,Default,,0,0,0,,Tatawagan niya ako anumang oras na humihingi ng tulong,\Nsabing ako lang ang meron siya.
Dialogue: 0,0:40:44.35,0:40:46.00,Default,,0,0,0,,Paano ako hindi makakatulong, kung gayon?
Dialogue: 0,0:40:46.02,0:40:50.13,Default,,0,0,0,,Kahit sa pagkakataong ito. Ang ganitong uri ng\Nnegosasyon ay maaaring tumagal ng isang taon,
Dialogue: 0,0:40:50.15,0:40:53.19,Default,,0,0,0,,pero hiniling niya sa akin na tapusin ito sa loob ng dalawang linggo.
Dialogue: 0,0:40:53.90,0:40:57.48,Default,,0,0,0,,Wala akong oras na gawin\Walang iba habang nasa Korea ako.
Dialogue: 0,0:40:57.62,0:40:58.72,Default,,0,0,0,,Mukhang...
Dialogue: 0,0:40:58.74,0:41:01.82,Default,,0,0,0,,Kailangan kong manatili sa kanya sa lahat ng oras.
Dialogue: 0,0:41:04.87,0:41:06.58,Default,,0,0,0,,Iyon ay...
Dialogue: 0,0:41:07.46,0:41:09.41,Default,,0,0,0,,panatag.
Dialogue: 0,0:41:17.76,0:41:20.55,Default,,0,0,0,,Dinadala mo ba ito sa kanya?
Dialogue: 0,0:41:25.90,0:41:28.01,Default,,0,0,0,,Na-curious ako bigla.
Dialogue: 0,0:41:28.94,0:41:30.00,Default,,0,0,0,,Tungkol saan?
Dialogue: 0,0:41:30.02,0:41:33.80,Default,,0,0,0,,Hindi mo ba kinasusuklaman kapag\Walang humawak sa buhok mo?
Dialogue: 0,0:41:33.82,0:41:35.05,Default,,0,0,0,,- Ano?\N- I mean,
Dialogue: 0,0:41:35.07,0:41:36.63,Default,,0,0,0,,noong hinawakan ko ito noong huling beses,
Dialogue: 0,0:41:36.66,0:41:40.19,Default,,0,0,0,, sinigawan mo ako, sinasabing\NI ay sinisira ang iyong hairstyle.
Dialogue: 0,0:41:40.53,0:41:42.49,Default,,0,0,0,,Anong sinasabi mo?
Dialogue: 0,0:41:42.62,0:41:44.15,Default,,0,0,0,,Sa madaling salita.
Dialogue: 0,0:41:45.37,0:41:47.82,Default,,0,0,0,,Nagalit ka nung ginawa ko,
Dialogue: 0,0:41:48.13,0:41:50.83,Default,,0,0,0,,bakit hindi mo ginawa noong ginawa ni Mr. Yoon?
Dialogue: 0,0:41:51.25,0:41:52.79,Default,,0,0,0,,Ano?
Dialogue: 0,0:41:56.43,0:41:57.40,Default,,0,0,0,,Iyan ay dahil...
Dialogue: 0,0:41:57.43,0:41:59.34,Default,,0,0,0,,Gusto kong maging patas ka.
Dialogue: 0,0:41:59.68,0:42:01.36,Default,,0,0,0,,Hindi lang Mr. Yoon.
Dialogue: 0,0:42:01.39,0:42:04.22,Default,,0,0,0,,Kung sinumang lalaki ang humawak sa iyong buhok,
Dialogue: 0,0:42:04.43,0:42:06.13,Default,,0,0,0,,dapat kang magalit.
Dialogue: 0,0:42:07.94,0:42:10.01,Default,,0,0,0,,Maliban sa iyong tagapag-ayos ng buhok.
Dialogue: 0,0:42:25.66,0:42:27.36,Default,,0,0,0,,Kakaalis niya...
Dialogue: 0,0:42:29.04,0:42:30.95,Default,,0,0,0,,nang walang sinasabi.
Dialogue: 0,0:42:42.72,0:42:44.32,Default,,0,0,0,,Paano niya magagawa iyon?
Dialogue: 0,0:42:44.35,0:42:46.01,Default,,0,0,0,,Darn it.
Dialogue: 0,0:42:49.85,0:42:51.72,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:42:56.32,0:42:58.02,Default,,0,0,0,,Sus...
Dialogue: 0,0:42:59.03,0:43:01.26,Default,,0,0,0,,Ito ay hindi kapani-paniwala.
Dialogue: 0,0:43:01.28,0:43:05.72,Default,,0,0,0,,I've never been this\Nannoyed with someone's smile.
Dialogue: 0,0:43:05.74,0:43:07.99,Default,,0,0,0,,Bagay talaga siya.
Dialogue: 0,0:43:18.09,0:43:20.96,Default,,0,0,0,,Nakangiti pa siya. ano?
Dialogue: 0,0:43:21.68,0:43:25.42,Default,,0,0,0,,Yung jerk. Bakit niya hinihila si\Nit pababa? Hoy, ang kulit mo. Teka.
Dialogue: 0,0:43:26.60,0:43:29.30,Default,,0,0,0,,Maghintay. Hey.
Dialogue: 0,0:43:29.48,0:43:31.62,Default,,0,0,0,,Ano bang problema niya?
Dialogue: 0,0:43:31.65,0:43:34.12,Default,,0,0,0,,Sa tingin mo hindi kita mapapanood kung gagawin mo ito?
Dialogue: 0,0:43:34.15,0:43:37.06,Default,,0,0,0,,Hahanap ako ng paraan, kahit anong mangyari.
Dialogue: 0,0:43:55.42,0:43:57.12,Default,,0,0,0,,Ako ay...
Dialogue: 0,0:43:57.42,0:43:59.96,Default,,0,0,0,,naglalakad lang.
Dialogue: 0,0:44:00.59,0:44:02.29,Default,,0,0,0,,Naglalakad-lakad.
Dialogue: 0,0:44:03.68,0:44:07.59,Default,,0,0,0,,Hindi dahil curious ako.
Dialogue: 0,0:44:11.19,0:44:12.97,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:44:13.69,0:44:15.39,Default,,0,0,0,,Ano?
Dialogue: 0,0:44:15.98,0:44:17.89,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:44:20.03,0:44:22.46,Default,,0,0,0,,Diba sabi mo "Honey"?
Dialogue: 0,0:44:22.49,0:44:24.34,Default,,0,0,0,,Hindi, hindi ko ginawa.
Dialogue: 0,0:44:24.37,0:44:26.15,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:44:26.37,0:44:27.59,Default,,0,0,0,,Malamang mali ang narinig ko.
Dialogue: 0,0:44:27.62,0:44:29.26,Default,,0,0,0,,Sige.
Dialogue: 0,0:44:29.29,0:44:32.16,Default,,0,0,0,,Buweno, ituloy mo.
Dialogue: 0,0:44:32.83,0:44:34.56,Default,,0,0,0,,Tawagan mo ako kung kailangan mo ako.
Dialogue: 0,0:44:34.58,0:44:36.45,Default,,0,0,0,,Hindi, hindi kita kakailanganin ngayon.
Dialogue: 0,0:44:36.54,0:44:38.24,Default,,0,0,0,,Pumunta ka lang at magpahinga.
Dialogue: 0,0:44:39.17,0:44:40.83,Default,,0,0,0,,Nagpapahinga ako.
Dialogue: 0,0:44:41.97,0:44:43.78,Default,,0,0,0,,- Uy.\N- Oo?
Dialogue: 0,0:44:43.80,0:44:44.94,Default,,0,0,0,,Hindi, hindi ikaw.
Dialogue: 0,0:44:44.97,0:44:46.15,Default,,0,0,0,,Eun-sung!
Dialogue: 0,0:44:46.18,0:44:49.57,Default,,0,0,0,,Nabalitaan kong nang-aabala si ate\Nyou noong Linggo, kaya pumunta ako.
Dialogue: 0,0:44:49.60,0:44:51.45,Default,,0,0,0,,Hoy, mawala ka.
Dialogue: 0,0:44:51.48,0:44:52.79,Default,,0,0,0,,Nagtatrabaho kami.
Dialogue: 0,0:44:52.81,0:44:55.75,Default,,0,0,0,,Alam mo, sinubukan kitang kontakin ng maraming beses,
Dialogue: 0,0:44:55.77,0:44:57.00,Default,,0,0,0,,pero ang secretary mo...
Dialogue: 0,0:44:57.02,0:44:59.83,Default,,0,0,0,,hindi nababagay sa iyong internasyonal,\Nclean-cut na imahe.
Dialogue: 0,0:44:59.86,0:45:04.76,Default,,0,0,0,,Binabaan niya ako ng hindi alam\Ngaano kami kalapit. Sobrang nasaktan ako.
Dialogue: 0,0:45:04.78,0:45:07.57,Default,,0,0,0,,Talaga? Kakausapin ko sila Mr. Hong.
Dialogue: 0,0:45:07.62,0:45:11.22,Default,,0,0,0,,Huwag kang masyadong pormal sa akin. Tratuhin mo lang akong parang iyong nakababatang kapatid.
Dialogue: 0,0:45:11.25,0:45:14.60,Default,,0,0,0,,Seryoso, mas malapit ako sa iyo kaysa kay Hyun-woo,
Dialogue: 0,0:45:14.62,0:45:17.78,Default,,0,0,0,,na tatlong taon ko nang naging bayaw.
Dialogue: 0,0:45:18.21,0:45:20.12,Default,,0,0,0,,Nandito ka pa rin?
Dialogue: 0,0:45:21.46,0:45:23.11,Default,,0,0,0,,Aalis na ako.
Dialogue: 0,0:45:23.13,0:45:25.07,Default,,0,0,0,,- Hindi, huwag kang lalabas.\N- Tama.
Dialogue: 0,0:45:25.09,0:45:26.79,Default,,0,0,0,,Ayoko.
Dialogue: 0,0:45:27.01,0:45:29.21,Default,,0,0,0,,Kumain ka na ba?
Dialogue: 0,0:45:29.85,0:45:31.97,Default,,0,0,0,,Bakit sobrang down ka?
Dialogue: 0,0:45:32.02,0:45:36.96,Default,,0,0,0,,Sa paraang nakikita ko, si Eun-sung ay parang bagong pag-asa mo.
Dialogue: 0,0:45:36.98,0:45:38.37,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:45:38.40,0:45:41.63,Default,,0,0,0,,Hae-in ay may 51% na pagkakataong mabuhay ngayon.
Dialogue: 0,0:45:41.65,0:45:44.13,Default,,0,0,0,,Siyempre dapat masaya ka para sa kanya,
Dialogue: 0,0:45:44.15,0:45:46.71,Default,,0,0,0,,pero wala na ang pag-asa mo.
Dialogue: 0,0:45:46.74,0:45:50.39,Default,,0,0,0,,Ang iyong pag-asa para sa isang mayaman at ligtas na paghihiwalay.
Dialogue: 0,0:45:50.41,0:45:52.11,Default,,0,0,0,,So?
Dialogue: 0,0:45:52.49,0:45:56.98,Default,,0,0,0,,Paano kung magmahalan sina Eun-sung at Hae-in?
Dialogue: 0,0:45:57.00,0:45:58.06,Default,,0,0,0,,Makakakuha ka ng sustento.
Dialogue: 0,0:45:58.08,0:45:59.39,Default,,0,0,0,,Hindi, hindi si Yoon Eun-sung.
Dialogue: 0,0:45:59.42,0:46:00.69,Default,,0,0,0,,Bakit hindi?
Dialogue: 0,0:46:00.71,0:46:04.37,Default,,0,0,0,,Ang creepy ng lalaking iyon.
Dialogue: 0,0:46:07.63,0:46:09.28,Default,,0,0,0,,Sino ang nagmamalasakit?
Dialogue: 0,0:46:09.30,0:46:12.07,Default,,0,0,0,,Hoy, sa tingin ko siya ang iyong tagapagligtas.
Dialogue: 0,0:46:12.10,0:46:15.37,Default,,0,0,0,,Dapat kang magpasalamat\Nna siya ay dumating upang iligtas ka.
Dialogue: 0,0:46:15.39,0:46:19.30,Default,,0,0,0,,May mali sa kanya.
Dialogue: 0,0:46:19.69,0:46:23.31,Default,,0,0,0,,- Nararamdaman ko na.\N- Halika na.
Dialogue: 0,0:46:24.19,0:46:26.92,Default,,0,0,0,,Sino ang nagmamalasakit kung ano ang iyong tagapagligtas?
Dialogue: 0,0:46:26.95,0:46:30.98,Default,,0,0,0,,Kung nalulunod ka, at hindi mo\Ngusto ang rescuer, hindi ba...
Dialogue: 0,0:46:32.03,0:46:34.07,Default,,0,0,0,,grab the rope?
Dialogue: 0,0:46:36.46,0:46:39.49,Default,,0,0,0,,Sa anumang kaso, hindi ako papayag na ganoon ka-jerk.
Dialogue: 0,0:46:39.75,0:46:41.37,Default,,0,0,0,,Sabi ko hindi.
Dialogue: 0,0:46:45.21,0:46:46.23,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,0:46:46.26,0:46:48.17,Default,,0,0,0,,{\i1}Eun-sung.{\i0}
Dialogue: 0,0:46:48.34,0:46:50.65,Default,,0,0,0,,Nakikita mo ang lupaing ito? Ito ay 825 ektarya.
Dialogue: 0,0:46:50.68,0:46:53.78,Default,,0,0,0,,Ang Neverland ay 355 ektarya at ang Souland ay 230 ektarya.
Dialogue: 0,0:46:53.81,0:46:55.58,Default,,0,0,0,,Mas malaki ito kaysa sa pinagsamang dalawa.
Dialogue: 0,0:46:55.60,0:46:57.59,Default,,0,0,0,,Kahanga-hanga.
Dialogue: 0,0:46:58.06,0:47:01.00,Default,,0,0,0,,Alam mo ang dalawang pinakamahalagang\Nbagay sa negosyo ng resort,
Dialogue: 0,0:47:01.02,0:47:02.92,Default,,0,0,0,,securing ang lupa at paglilisensya.
Dialogue: 0,0:47:02.94,0:47:07.02,Default,,0,0,0,,Tulad ng nakikita mo, mayroon kaming\Nland, at tungkol sa paglilisensya...
Dialogue: 0,0:47:08.95,0:47:11.73,Default,,0,0,0,,Mayroon tayong tao sa Ministry of Land.
Dialogue: 0,0:47:12.57,0:47:14.26,Default,,0,0,0,,Totoo ba iyon?
Dialogue: 0,0:47:14.28,0:47:16.47,Default,,0,0,0,,Nag-aral siya sa Queens scholarships,
Dialogue: 0,0:47:16.50,0:47:18.35,Default,,0,0,0,,at siya ang tutor ko.
Dialogue: 0,0:47:18.37,0:47:20.39,Default,,0,0,0,,- I see.\N- Tama.
Dialogue: 0,0:47:20.42,0:47:23.94,Default,,0,0,0,,K-pop, K-drama. Ang nilalamang Korean\Nis ay sikat na sikat ngayon.
Dialogue: 0,0:47:23.96,0:47:27.12,Default,,0,0,0,,Sabay nating malampasan ang Disney, Eun-sung!
Dialogue: 0,0:47:29.68,0:47:31.63,Default,,0,0,0,,Pag-iisipan ko.
Dialogue: 0,0:47:55.79,0:47:56.76,Default,,0,0,0,,Ay naku.
Dialogue: 0,0:47:56.79,0:47:59.68,Default,,0,0,0,,Nakilala niya ang lahat ng taong ito?
Dialogue: 0,0:47:59.71,0:48:03.06,Default,,0,0,0,,Kilala mo ba si Robert Bailey,\Nang maalamat na hedge fund manager?
Dialogue: 0,0:48:03.08,0:48:06.23,Default,,0,0,0,,Sa kanyang 12 apprentice,\Nito ang pinakamagaling.
Dialogue: 0,0:48:06.25,0:48:11.29,Default,,0,0,0,,Ipinagkatiwala pa ni Robert sa kanya ang kanyang asset management\N. Ano pa ang masasabi?
Dialogue: 0,0:48:11.97,0:48:13.07,Default,,0,0,0,,Talaga?
Dialogue: 0,0:48:13.09,0:48:16.50,Default,,0,0,0,,Perpekto siya bilang partner ni Mr. Hong Soo-cheol,
Dialogue: 0,0:48:17.39,0:48:20.88,Default,,0,0,0,,pero medyo mapili siya, kaya...
Dialogue: 0,0:48:21.27,0:48:24.21,Default,,0,0,0,,Ngunit kusang-loob niyang tinutulungan si\NHae-in patungkol kay Hercyna.
Dialogue: 0,0:48:24.23,0:48:27.14,Default,,0,0,0,,Oo, dahil magkalapit ang dalawa,
Dialogue: 0,0:48:27.90,0:48:33.44,Default,,0,0,0,,at maaaring iyon ang dahilan kung bakit hindi lumalapit si Mr. Yoon\ kay Mr. Hong.
Dialogue: 0,0:48:33.99,0:48:35.30,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:48:35.32,0:48:36.34,Default,,0,0,0,,Pag-isipan mo.
Dialogue: 0,0:48:36.37,0:48:37.59,Default,,0,0,0,,Para kay Ms. Hong,
Dialogue: 0,0:48:37.62,0:48:41.76,Default,,0,0,0,,kung magbubukas si Hercyna sa kanyang mall, siguradong aabot siya ng $1 bilyon na benta.
Dialogue: 0,0:48:41.79,0:48:46.73,Default,,0,0,0,,Pagkatapos ay sasandal ang chairman sa\Pagbibigay ng grupo sa kanya, gaya ng ipinangako niya.
Dialogue: 0,0:48:46.75,0:48:48.02,Default,,0,0,0,,Sinasabi mo bang...
Dialogue: 0,0:48:48.05,0:48:53.04,Default,,0,0,0,,Ayaw ni Hae-in na magtagumpay si Soo-cheol\Nin attracting investment para sa resort?
Dialogue: 0,0:48:53.30,0:48:57.38,Default,,0,0,0,,Oo! Maaaring paikutin ni Soo-cheol ang mga mesa.
Dialogue: 0,0:48:58.22,0:49:02.70,Default,,0,0,0,,I mean, hindi ko alam kung ano\NMs. Hong told Mr. Yoon,
Dialogue: 0,0:49:02.73,0:49:06.93,Default,,0,0,0,,pero parang hindi niya kinokonsidera\NMr. Hong bilang potensyal na kasosyo.
Dialogue: 0,0:49:07.02,0:49:10.60,Default,,0,0,0,,Nagdi-dinner siya kasama ang apo ni Chairman\NYeom ngayong gabi.
Dialogue: 0,0:49:12.78,0:49:15.67,Default,,0,0,0,,Hindi nagsisinungaling ang manghuhula.
Dialogue: 0,0:49:15.70,0:49:17.01,Default,,0,0,0,,Sabi ko naman sayo diba?
Dialogue: 0,0:49:17.03,0:49:22.70,Default,,0,0,0,,Ms. Si Hong ay nakatadhana upang biktimahin\Non ang kanyang mga kapatid sa buong buhay niya.
Dialogue: 0,0:49:23.66,0:49:27.66,Default,,0,0,0,,Gayunpaman, hindi mo na kailangan ang\Walang iba pang pakikitungo sa kanya.
Dialogue: 0,0:49:27.75,0:49:30.23,Default,,0,0,0,,Ang paghula ay parang Bibliya sa kanya.
Dialogue: 0,0:49:30.25,0:49:33.23,Default,,0,0,0,,Kung naghahanap ka ng kahit ano online at sabihin sa kanya,
Dialogue: 0,0:49:33.26,0:49:34.65,Default,,0,0,0,,naniniwala lang siya.
Dialogue: 0,0:49:34.68,0:49:37.75,Default,,0,0,0,,Ngunit nagtrabaho iyon sa iyong kalamangan.
Dialogue: 0,0:49:38.26,0:49:43.93,Default,,0,0,0,,Totoo iyan. Marami akong nakinabang dito sa loob ng humigit-kumulang 15 taon.
Dialogue: 0,0:50:20.80,0:50:22.63,Default,,0,0,0,,Ano ang nagdadala sa iyo dito?
Dialogue: 0,0:50:25.48,0:50:27.33,Default,,0,0,0,,Alam ko.
Dialogue: 0,0:50:27.35,0:50:32.13,Default,,0,0,0,,Kung hindi ko binawi ang suit, hindi rin mangyayari iyong mall\Nin Gwanggyo.
Dialogue: 0,0:50:32.15,0:50:33.85,Default,,0,0,0,,Gusto mo ba yun?
Dialogue: 0,0:50:36.74,0:50:39.48,Default,,0,0,0,,Itigil ang pagputok sa paligid ng bush.
Dialogue: 0,0:50:39.87,0:50:41.57,Default,,0,0,0,,Sabihin mo lang sa akin.
Dialogue: 0,0:50:42.95,0:50:45.68,Default,,0,0,0,,Ano ang sinabi mo kay Eun-sung tungkol kay Soo-cheol?
Dialogue: 0,0:50:45.70,0:50:49.81,Default,,0,0,0,,Ano ang sinabi mo na dahilan kung bakit hindi niya naisipang mag-invest sa Soo-cheol?
Dialogue: 0,0:50:49.83,0:50:51.02,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:50:51.04,0:50:52.44,Default,,0,0,0,,Obvious naman.
Dialogue: 0,0:50:52.46,0:50:57.40,Default,,0,0,0,,"Kung si Soo-cheol ay nakakuha ng puhunan, masama\Npara sa akin, kaya mag-invest ka na lang sa Sang-jin."
Dialogue: 0,0:50:57.42,0:50:59.86,Default,,0,0,0,,Dahil magagalit iyan sa chairman.
Dialogue: 0,0:50:59.89,0:51:03.63,Default,,0,0,0,,Sa tingin mo ba ay may katuturan pa iyon?
Dialogue: 0,0:51:03.68,0:51:06.41,Default,,0,0,0,,Oo! Sa palagay ko ay higit kang\Nsa kaya mong gawin iyon,
Dialogue: 0,0:51:06.43,0:51:09.97,Default,,0,0,0,,dahil isa kang wench\Nwho's selfish to the bone.
Dialogue: 0,0:51:10.02,0:51:14.12,Default,,0,0,0,,Wala kang pakialam kung may mamatay sa paligid mo.\NHahanap ka lang ng paraan para iligtas ang sarili mo,
Dialogue: 0,0:51:14.15,0:51:16.73,Default,,0,0,0,,at kaya ang kuya mo...
Dialogue: 0,0:51:25.83,0:51:28.64,Default,,0,0,0,,Masama ang pakiramdam niya simula kaninang umaga.
Dialogue: 0,0:51:28.66,0:51:30.14,Default,,0,0,0,,I think she need to rest.
Dialogue: 0,0:51:30.17,0:51:31.91,Default,,0,0,0,,Paumanhin, Inay.
Dialogue: 0,0:51:32.79,0:51:35.90,Default,,0,0,0,,So sinasabi mo bang umalis ako?
Dialogue: 0,0:51:35.92,0:51:38.46,Default,,0,0,0,,Nung kausap ko pa siya?
Dialogue: 0,0:51:40.63,0:51:42.34,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:52:19.30,0:52:21.08,Default,,0,0,0,,Sabihin natin sa pamilya mo.
Dialogue: 0,0:52:22.34,0:52:23.32,Default,,0,0,0,,Sabi ko hindi.
Dialogue: 0,0:52:23.34,0:52:26.24,Default,,0,0,0,,Maaaring mangyari anumang oras ang mga sitwasyong tulad ng nauna.
Dialogue: 0,0:52:26.26,0:52:28.20,Default,,0,0,0,,Baka malaman nila.
Dialogue: 0,0:52:28.22,0:52:30.17,Default,,0,0,0,,Gagamot ako.
Dialogue: 0,0:52:31.39,0:52:33.75,Default,,0,0,0,,You're acting like I'll drop dead tomorrow.
Dialogue: 0,0:52:33.77,0:52:35.51,Default,,0,0,0,,Ikaw ay...
Dialogue: 0,0:52:35.73,0:52:37.89,Default,,0,0,0,,makasarili at iresponsable.
Dialogue: 0,0:52:38.32,0:52:39.79,Default,,0,0,0,,Oo.
Dialogue: 0,0:52:39.82,0:52:44.36,Default,,0,0,0,,Iniisip mo ang pera mo,\Nstocks, at ang One Billion Club. Naiintindihan ko.
Dialogue: 0,0:52:44.57,0:52:49.74,Default,,0,0,0,,Naiintindihan ko na nag-aalala ka sa iyong pamilya\Hindi maaaring kunin kung ano ang sa iyo kapag nalaman nila,
Dialogue: 0,0:52:49.83,0:52:51.53,Default,,0,0,0,,pero...
Dialogue: 0,0:52:52.37,0:52:55.07,Default,,0,0,0,,pinapanatili ang mahalagang bagay na ito mula sa kanila...
Dialogue: 0,0:52:55.13,0:52:58.08,Default,,0,0,0,,dahil ayaw mong may makuha.
Dialogue: 0,0:52:58.63,0:53:00.16,Default,,0,0,0,,Tama ba?
Dialogue: 0,0:53:03.22,0:53:05.38,Default,,0,0,0,,Ayokong mabigla sila.
Dialogue: 0,0:53:07.89,0:53:09.76,Default,,0,0,0,,Ang aking mga magulang...
Dialogue: 0,0:53:15.77,0:53:18.43,Default,,0,0,0,,Nawalan na sila ng anak.
Dialogue: 0,0:53:24.95,0:53:27.02,Default,,0,0,0,,Kaya bakit sila takutin?
Dialogue: 0,0:53:30.33,0:53:33.03,Default,,0,0,0,,Hinding-hindi ako magiging mabuting anak, gayunpaman.
Dialogue: 0,0:53:33.33,0:53:35.03,Default,,0,0,0,,ako lang...
Dialogue: 0,0:53:35.50,0:53:38.74,Default,,0,0,0,,ayokong maging mas\Nterrible na pag-iral sa aking pamilya,
Dialogue: 0,0:53:39.50,0:53:41.58,Default,,0,0,0,,at higit sa lahat,
Dialogue: 0,0:53:42.01,0:53:46.29,Default,,0,0,0,,Sigurado akong gagaling ako,\Nkaya itigil mo na ang pagtrato sa akin na parang pasyente.
Dialogue: 0,0:53:53.56,0:53:55.16,Default,,0,0,0,,Pwede ka bang umalis?
Dialogue: 0,0:53:55.19,0:53:56.72,Default,,0,0,0,,Gusto kong magpahinga.
Dialogue: 0,0:54:10.24,0:54:11.93,Default,,0,0,0,,At ang pagbili ng stock?
Dialogue: 0,0:54:11.95,0:54:16.41,Default,,0,0,0,,Bumili kami ng 14.7% sa kabuuan, 4.9% bawat tao.
Dialogue: 0,0:54:16.83,0:54:19.45,Default,,0,0,0,,At ang mga direktor na sumusuporta sa chairman?
Dialogue: 0,0:54:26.13,0:54:29.53,Default,,0,0,0,,{\i1}Ang rate ng pagbabalik ng huling\Nblind trust ay malapit sa 90%,{\i0}
Dialogue: 0,0:54:29.55,0:54:32.82,Default,,0,0,0,,{\i1}kaya sabik silang sumali sa susunod na pondo.{\i0}
Dialogue: 0,0:54:32.85,0:54:36.33,Default,,0,0,0,,Kailangan natin silang pangunahan na ilagay ang\NQueens stocks bilang collateral sa susunod.
Dialogue: 0,0:54:36.35,0:54:38.20,Default,,0,0,0,,Napakataas ng minimum na halaga,
Dialogue: 0,0:54:38.23,0:54:41.25,Default,,0,0,0,,I doubt na makakabuo sila ng ganyang kalaking pera sa loob ng ilang araw.
Dialogue: 0,0:54:41.27,0:54:44.64,Default,,0,0,0,,Kung minamadali natin sila, ilalagay nila\Nang kanilang mga stock bilang collateral.
Dialogue: 0,0:54:45.40,0:54:47.56,Default,,0,0,0,,Sunod si Chairman Hong.
Dialogue: 0,0:54:47.70,0:54:50.69,Default,,0,0,0,,Ang pagsisiyasat ng prosekusyon.
Dialogue: 0,0:54:51.16,0:54:52.26,Default,,0,0,0,,Masama ang loob ko sa kanya.
Dialogue: 0,0:54:52.28,0:54:55.03,Default,,0,0,0,,Ayaw niya sa kulungan.
Dialogue: 0,0:54:58.21,0:55:00.99,Default,,0,0,0,,Nga pala, paano mo ito gagawin?
Dialogue: 0,0:55:01.79,0:55:05.06,Default,,0,0,0,,{\i1}Ang tunay na tagapag-alaga ng chairman...{\i0}
Dialogue: 0,0:55:05.09,0:55:07.48,Default,,0,0,0,,{\i1}ay si Song Jeong-beom sa Finance.{\i0}
Dialogue: 0,0:55:07.51,0:55:12.80,Default,,0,0,0,,{\i1}Siya ay sumipsip ng sarili niyang bahagi,\Nas pati na rin ang slush na pondo ng chairman.{\i0}
Dialogue: 0,0:55:13.10,0:55:16.08,Default,,0,0,0,,Ibibigay namin ang lahat ng ebidensya\Nover sa prosekusyon,
Dialogue: 0,0:55:16.10,0:55:18.37,Default,,0,0,0,,at habang tinitingnan nila ang mga nakatataas,
Dialogue: 0,0:55:18.39,0:55:22.01,Default,,0,0,0,,iimbestigahan din nila ang chairman.
Dialogue: 0,0:55:33.99,0:55:37.15,Default,,0,0,0,,Makikita mo ang Queens Tower mula dito,
Dialogue: 0,0:55:39.41,0:55:41.37,Default,,0,0,0,,at gusto ko iyon.
Dialogue: 0,0:55:41.83,0:55:45.83,Default,,0,0,0,,Para akong tumitingin sa masarap na pagkain.
Dialogue: 0,0:56:05.02,0:56:06.72,Default,,0,0,0,,Darn it.
Dialogue: 0,0:56:07.40,0:56:10.05,Default,,0,0,0,,Sinabi ko sa iyo na palakihin ang font.
Dialogue: 0,0:56:10.07,0:56:13.80,Default,,0,0,0,,Darn it. Ihanda ang mga dokumento\Naga at magtakda ng isa pang pulong.
Dialogue: 0,0:56:13.82,0:56:16.23,Default,,0,0,0,,Hindi ako makapaniwala sa kanila.
Dialogue: 0,0:56:16.62,0:56:18.24,Default,,0,0,0,,Lumabas!
Dialogue: 0,0:56:19.12,0:56:20.74,Default,,0,0,0,,Out!
Dialogue: 0,0:56:29.59,0:56:32.15,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sa tingin ko ay papayagan kitang sumali\Nsa pribadong equity fund.{\c}{\i0}
Dialogue: 0,0:56:32.18,0:56:34.70,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang minimum na halaga ay $20 milyon,{\c}{\i0}
Dialogue: 0,0:56:34.72,0:56:38.45,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}at maaari mong ilagay ang iyong Queens stocks\Nup bilang collateral kung kapos ka sa pera.{\c}{\i0}
Dialogue: 0,0:56:38.47,0:56:41.62,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang rate ng kita ay inaasahang mas mataas. First come, first serve,{\c}{\i0}
Dialogue: 0,0:56:41.64,0:56:44.71,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}kaya gumawa ng isang mabilis na desisyon.\NCakailangan ang pagiging kumpidensyal.{\c}{\i0}
Dialogue: 0,0:56:44.73,0:56:46.33,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- Salamat.\N- Naiintindihan ko.{\c}{\i0}
Dialogue: 0,0:56:46.36,0:56:48.14,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Posible iyon.{\c}{\i0}
Dialogue: 0,0:56:51.19,0:56:53.01,Default,,0,0,0,,Nandito na siya.
Dialogue: 0,0:56:53.03,0:56:56.02,Default,,0,0,0,,Ano ang napasok sa Beom-ja?
Dialogue: 0,0:56:56.49,0:57:00.07,Default,,0,0,0,,Bakit bigla niya akong\Ngustong i-treat ng pagkain?
Dialogue: 0,0:57:05.58,0:57:07.70,Default,,0,0,0,,Dumating na ang chairman.
Dialogue: 0,0:57:25.73,0:57:27.29,Default,,0,0,0,,Hindi, Tatay. Hindi ka pwedeng umalis.
Dialogue: 0,0:57:27.31,0:57:29.68,Default,,0,0,0,,- Sa ibabaw ng patay kong katawan.\N- Ilipat.
Dialogue: 0,0:57:30.94,0:57:33.05,Default,,0,0,0,,Dad, pakinggan mo lang ako.
Dialogue: 0,0:57:33.07,0:57:35.19,Default,,0,0,0,,Ayoko ng iba.
Dialogue: 0,0:57:36.32,0:57:37.68,Default,,0,0,0,,Bigyan mo lang ako ng pagkakataon.
Dialogue: 0,0:57:37.70,0:57:38.93,Default,,0,0,0,,Ang kulit mo.
Dialogue: 0,0:57:38.95,0:57:41.19,Default,,0,0,0,,Diba binigyan kita ng chance?
Dialogue: 0,0:57:41.24,0:57:45.78,Default,,0,0,0,,Binigyan kita ng isa, pero ibinenta mo ako\Nout sa prosecution para iligtas ang sarili mo!
Dialogue: 0,0:57:46.25,0:57:49.52,Default,,0,0,0,,Habang nakakulong ako,\Nikayo ang nagplano na pumalit sa akin...
Dialogue: 0,0:57:49.54,0:57:52.15,Default,,0,0,0,,kasama ang mga direktor na sumuporta sa iyo.
Dialogue: 0,0:57:52.17,0:57:54.65,Default,,0,0,0,,- Nakalimutan mo na ba?\N- Wala ako sa tamang pag-iisip.
Dialogue: 0,0:57:54.67,0:57:59.20,Default,,0,0,0,,Narinig ko na sinusubukan mong i-pin\Nang singil sa paglustay sa akin,
Dialogue: 0,0:57:59.22,0:58:00.32,Default,,0,0,0,,kaya nawala ako.
Dialogue: 0,0:58:00.35,0:58:02.76,Default,,0,0,0,,I'm so sorry.
Dialogue: 0,0:58:03.77,0:58:05.45,Default,,0,0,0,,20 taon na ang nakalipas.
Dialogue: 0,0:58:05.48,0:58:07.96,Default,,0,0,0,,Mapapatawad mo pa sana\Na estranghero pagkalipas ng mahabang panahon.
Dialogue: 0,0:58:07.98,0:58:09.79,Default,,0,0,0,,Bakit ang harsh mo sa anak mo?
Dialogue: 0,0:58:09.81,0:58:12.04,Default,,0,0,0,,Mas gugustuhin kong patawarin ang isang estranghero!
Dialogue: 0,0:58:12.07,0:58:15.39,Default,,0,0,0,,Paano ko mapapatawad ang aking\Ngayong anak na nagtaksil sa akin?
Dialogue: 0,0:58:16.32,0:58:18.19,Default,,0,0,0,,Hindi ko kaya,
Dialogue: 0,0:58:18.57,0:58:20.55,Default,,0,0,0,,kaya huwag na ulit gagawa ng ganito.
Dialogue: 0,0:58:20.58,0:58:22.19,Default,,0,0,0,,Tatay!
Dialogue: 0,0:58:22.58,0:58:24.35,Default,,0,0,0,,Na-miss kita.
Dialogue: 0,0:58:24.37,0:58:26.78,Default,,0,0,0,,Kaya talaga ako pumunta.
Dialogue: 0,0:58:29.96,0:58:32.08,Default,,0,0,0,,Well, nakita mo na ako ngayon.
Dialogue: 0,0:58:33.55,0:58:35.25,Default,,0,0,0,,Ayoko na...
Dialogue: 0,0:58:35.55,0:58:37.46,Default,,0,0,0,,see you again.
Dialogue: 0,0:58:37.72,0:58:39.49,Default,,0,0,0,,Inrate mo.
Dialogue: 0,0:58:39.51,0:58:41.80,Default,,0,0,0,,Huwag kang pumunta sa libing ko.
Dialogue: 0,0:58:44.72,0:58:46.63,Default,,0,0,0,,Darn it.
Dialogue: 0,0:59:05.91,0:59:08.36,Default,,0,0,0,,Bakit napakababa ng tingin mo?
Dialogue: 0,0:59:08.96,0:59:11.16,Default,,0,0,0,,Parang hindi ka pa kumakain.
Dialogue: 0,0:59:14.55,0:59:16.54,Default,,0,0,0,,Kapag masama ang pakiramdam mo,
Dialogue: 0,0:59:16.67,0:59:18.28,Default,,0,0,0,,wala nang mas hihigit pa sa...
Dialogue: 0,0:59:18.30,0:59:21.21,Default,,0,0,0,,isang mangkok nito.
Dialogue: 0,0:59:22.22,0:59:26.45,Default,,0,0,0,,Palagi akong ginagawa ng nanay ko kapag may sakit ako.
Dialogue: 0,0:59:26.47,0:59:30.91,Default,,0,0,0,,Noong nagtitinda ako ng mga pahayagan\Nand shine people's shoes sa Myeong-dong.
Dialogue: 0,0:59:30.94,0:59:33.64,Default,,0,0,0,,Kapag ako ay nagugutom o may sakit,
Dialogue: 0,0:59:35.40,0:59:38.64,Default,,0,0,0,,Palagi kong iniisip ito.
Dialogue: 0,0:59:38.74,0:59:40.65,Default,,0,0,0,,Magkaroon ng ilan.
Dialogue: 0,0:59:41.07,0:59:45.86,Default,,0,0,0,,Mula sa pagtulog sa lansangan\Nusing mga pahayagan bilang kumot,
Dialogue: 0,0:59:45.95,0:59:51.77,Default,,0,0,0,,sa pagmamay-ari ng isa sa mga nangungunang\Ndepartment store at mart franchise ng Korea,
Dialogue: 0,0:59:51.79,0:59:54.33,Default,,0,0,0,, tumagal ng 60 taon,
Dialogue: 0,0:59:55.17,0:59:58.41,Default,,0,0,0,,pero bakit parang...
Dialogue: 0,0:59:58.63,1:00:01.32,Default,,0,0,0,,Nag-iisa akong nakatayo sa ilang?
Dialogue: 0,1:00:01.34,1:00:04.49,Default,,0,0,0,,May bagay na siguradong nasaktan nang husto ang iyong damdamin.
Dialogue: 0,1:00:04.51,1:00:07.26,Default,,0,0,0,,Ako lang ang nakakaalam kung gaano kalambot ang puso...
Dialogue: 0,1:00:07.39,1:00:09.34,Default,,0,0,0,,ikaw ay.
Dialogue: 0,1:00:22.45,1:00:25.07,Default,,0,0,0,,Ang lasa ay parang...
Dialogue: 0,1:00:25.49,1:00:27.74,Default,,0,0,0,,sa nanay ko.
Dialogue: 0,1:00:34.46,1:00:36.10,Default,,0,0,0,,Bakit hindi mo kami mabigyan ng refund?
Dialogue: 0,1:00:36.13,1:00:38.73,Default,,0,0,0,,Nasira ang balat ng baby ko pagkatapos niyang gamitin ito,
Dialogue: 0,1:00:38.76,1:00:42.15,Default,,0,0,0,,pero hindi mo kami mabibigyan ng refund,\Npabayaan mo lang kaming bayaran?
Dialogue: 0,1:00:42.18,1:00:45.45,Default,,0,0,0,,Sir, mahigit walong buwan na ang nakalipas\Nmula nang bilhin mo ang produkto,
Dialogue: 0,1:00:45.47,1:00:47.66,Default,,0,0,0,,at halos nagamit mo na lahat.
Dialogue: 0,1:00:47.68,1:00:49.58,Default,,0,0,0,,Hey. Natutuwa akong dinala mo ito.
Dialogue: 0,1:00:49.60,1:00:52.45,Default,,0,0,0,,Ganito ang mukha ko\Ndahil gumamit ako ng ganito.
Dialogue: 0,1:00:52.48,1:00:55.54,Default,,0,0,0,,Kung hindi, hindi magiging ganito ang balat ko\N!
Dialogue: 0,1:00:55.56,1:00:59.02,Default,,0,0,0,,Babe, huwag kang mapagod. Lalala ito.
Dialogue: 0,1:00:59.07,1:01:01.05,Default,,0,0,0,,Bigyan mo lang kami ng refund ngayon din.
Dialogue: 0,1:01:01.07,1:01:02.92,Default,,0,0,0,,Sir, hindi po namin magagawa yun.
Dialogue: 0,1:01:02.95,1:01:05.65,Default,,0,0,0,,Hindi ba ako naging malinaw sa sarili ko?
Dialogue: 0,1:01:09.16,1:01:11.31,Default,,0,0,0,,Sir, huminahon po kayo.
Dialogue: 0,1:01:11.33,1:01:13.86,Default,,0,0,0,,Paano ako kakalma?
Dialogue: 0,1:01:14.29,1:01:18.35,Default,,0,0,0,,Tama. Sa tingin mo isa ako sa mga\Nobnoxious na customer, hindi ba?
Dialogue: 0,1:01:18.38,1:01:21.08,Default,,0,0,0,,Gusto mo bang ipakita ko sa iyo ang totoong bagay?
Dialogue: 0,1:01:25.34,1:01:28.34,Default,,0,0,0,,Sir, hindi mo ito magagawa dito.
Dialogue: 0,1:01:29.22,1:01:33.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gusto kong gamitin ang aming security deposit para sa\Nher surgery, pero ayaw makinig ng nanay ko.{\c}{\i0}
Dialogue: 0,1:01:36.19,1:01:40.08,Default,,0,0,0,,Ito ay isang hindi makatwirang\Ndemand. Hindi ka namin matutulungan.
Dialogue: 0,1:01:40.11,1:01:41.54,Default,,0,0,0,,"Hindi Makatwiran"?
Dialogue: 0,1:01:41.57,1:01:45.44,Default,,0,0,0,,Wala kang pag-asa. Halika dito.\NHow dare you talk to me...?
Dialogue: 0,1:01:49.91,1:01:51.86,Default,,0,0,0,,Sino ka?
Dialogue: 0,1:01:51.99,1:01:53.56,Default,,0,0,0,,Hayaan mo.
Dialogue: 0,1:01:53.58,1:01:55.57,Default,,0,0,0,,Bitawan mo ako.
Dialogue: 0,1:01:58.29,1:02:00.10,Default,,0,0,0,,Hindi ito ang lugar para sa ganoong pag-uugali.
Dialogue: 0,1:02:00.13,1:02:03.73,Default,,0,0,0,,Tingnan mo, wala akong negosyo sa iyo na maliit na prito.
Dialogue: 0,1:02:03.76,1:02:04.94,Default,,0,0,0,,Dalhin ang iyong CEO.
Dialogue: 0,1:02:04.97,1:02:07.57,Default,,0,0,0,,Dalhin ang iyong CEO ngayon din!
Dialogue: 0,1:02:07.59,1:02:09.24,Default,,0,0,0,,- Nandito siya.\N- Ano?
Dialogue: 0,1:02:09.26,1:02:11.30,Default,,0,0,0,,Ako ang CEO.
Dialogue: 0,1:02:12.14,1:02:13.41,Default,,0,0,0,,Ikaw ba ang CEO?
Dialogue: 0,1:02:13.43,1:02:15.87,Default,,0,0,0,,Bakit hindi mo sanayin nang maayos ang iyong empleyado?
Dialogue: 0,1:02:15.89,1:02:18.89,Default,,0,0,0,,Tama ka. Parang hindi ko nagawa ng maayos.
Dialogue: 0,1:02:20.98,1:02:22.81,Default,,0,0,0,,Ms. Kim Min-ji?
Dialogue: 0,1:02:23.44,1:02:25.13,Default,,0,0,0,,Deal sa aming mga customer lang.
Dialogue: 0,1:02:25.15,1:02:28.05,Default,,0,0,0,,Para sa mga kriminal, iulat sila\Nsa pulis nang walang babala.
Dialogue: 0,1:02:28.07,1:02:30.38,Default,,0,0,0,,Ano? Isang kriminal?
Dialogue: 0,1:02:30.41,1:02:32.80,Default,,0,0,0,,Tinatawag mong kriminal ang iyong mga customer?
Dialogue: 0,1:02:32.83,1:02:34.64,Default,,0,0,0,,Babe, kinukunan mo ba ito ng video?
Dialogue: 0,1:02:34.66,1:02:35.89,Default,,0,0,0,,Oo.
Dialogue: 0,1:02:35.91,1:02:38.68,Default,,0,0,0,,Ang CEO ng mall na ito ay tumitingin\Ndown sa kanyang mga customer.
Dialogue: 0,1:02:38.71,1:02:40.98,Default,,0,0,0,,Idemanda natin siya at turuan siya ng leksyon.
Dialogue: 0,1:02:41.00,1:02:42.95,Default,,0,0,0,,Gawin natin iyan.
Dialogue: 0,1:02:43.59,1:02:45.19,Default,,0,0,0,,Siguraduhing gawin ito.
Dialogue: 0,1:02:45.21,1:02:46.92,Default,,0,0,0,,Gagawin ko rin.
Dialogue: 0,1:02:47.93,1:02:50.82,Default,,0,0,0,,Alam ko, dahil magaling na abogado ang asawa ko.
Dialogue: 0,1:02:50.85,1:02:52.07,Default,,0,0,0,,Maaari kang singilin...
Dialogue: 0,1:02:52.10,1:02:55.03,Default,,0,0,0,,na may sagabal sa negosyo, espesyal na pag-atake,
Dialogue: 0,1:02:55.06,1:02:57.41,Default,,0,0,0,,at pinsala sa ari-arian,
Dialogue: 0,1:02:57.44,1:03:02.39,Default,,0,0,0,,at magsasampa ako ng isa pang kaso para sa\Npagkalugi ng benta na idinulot mo.
Dialogue: 0,1:03:02.52,1:03:04.75,Default,,0,0,0,,- Na-film ba ninyo lahat?\N- Oo, ginawa namin!
Dialogue: 0,1:03:04.78,1:03:07.98,Default,,0,0,0,,- Ginawa ko. Dito!\N- Mangyaring gumawa ng paraan.
Dialogue: 0,1:03:09.24,1:03:10.55,Default,,0,0,0,,Dalhin sila sa pulis.
Dialogue: 0,1:03:10.57,1:03:12.65,Default,,0,0,0,,Let's go, Babe.
Dialogue: 0,1:03:20.46,1:03:22.53,Default,,0,0,0,,Salamat.
Dialogue: 0,1:03:25.38,1:03:28.46,Default,,0,0,0,,Nga pala, Mr. Baek, tungkol kay Park Seok-hun.
Dialogue: 0,1:03:28.59,1:03:30.36,Default,,0,0,0,,Ano naman sa kanya?
Dialogue: 0,1:03:30.38,1:03:33.07,Default,,0,0,0,,Paikot-ikot siya na nagsasabing...
Dialogue: 0,1:03:33.10,1:03:38.08,Default,,0,0,0,,na ang Yongdu Pear na iyong pino-promote\Nas ang aming village specialty ay walang hinaharap.
Dialogue: 0,1:03:38.10,1:03:40.54,Default,,0,0,0,,Sinasabi niya na ang Yongdu Apple ay magiging...
Dialogue: 0,1:03:40.56,1:03:42.96,Default,,0,0,0,,ang bagong K-food craze sa buong mundo.
Dialogue: 0,1:03:42.98,1:03:44.79,Default,,0,0,0,,Apple? Kabutihan.
Dialogue: 0,1:03:44.82,1:03:46.34,Default,,0,0,0,,Nakakatawa lang.
Dialogue: 0,1:03:46.36,1:03:48.80,Default,,0,0,0,,Sa kaugalian, ang mga mansanas ay hindi tugma sa peras.
Dialogue: 0,1:03:48.82,1:03:51.05,Default,,0,0,0,,Siyempre... Talaga?
Dialogue: 0,1:03:51.07,1:03:54.05,Default,,0,0,0,,Isipin mo lang ang mga serbisyong pang-alaala.
Dialogue: 0,1:03:54.08,1:03:56.60,Default,,0,0,0,,Naglalagay kami ng peras sa mga mesa, hindi mga mansanas!
Dialogue: 0,1:03:56.62,1:04:00.72,Default,,0,0,0,,Bukod dito, ang mga persimmon at peras ay magkakasama. Ang mga persimmon at mansanas ay hindi.
Dialogue: 0,1:04:00.75,1:04:04.98,Default,,0,0,0,,Gaano niya kalakas-loob na maliitin ang kahalagahan\Nof peras, ang aming tradisyonal na prutas?
Dialogue: 0,1:04:05.00,1:04:07.36,Default,,0,0,0,,Anyway, tumatakbo ang taong ito...
Dialogue: 0,1:04:07.38,1:04:11.11,Default,,0,0,0,,isang kampanya sa halalan sa mga matalinong paraan.
Dialogue: 0,1:04:11.13,1:04:13.57,Default,,0,0,0,,Alam mo yung restaurant ng mama niya?
Dialogue: 0,1:04:13.59,1:04:18.45,Default,,0,0,0,,Nag-aalok siya ng kalahating presyo ng tanghalian,\Nkaya lahat ay kumakain doon ngayon.
Dialogue: 0,1:04:18.47,1:04:19.49,Default,,0,0,0,,Ang tanga mo!
Dialogue: 0,1:04:19.52,1:04:21.47,Default,,0,0,0,,Bakit hindi mo sinabi sa akin ng mas maaga?
Dialogue: 0,1:04:21.69,1:04:23.37,Default,,0,0,0,,Yung maliit...!
Dialogue: 0,1:04:23.40,1:04:25.96,Default,,0,0,0,,Hindi siya naglalaro ng patas, di ba?
Dialogue: 0,1:04:25.98,1:04:28.31,Default,,0,0,0,,Pupunta ka ba diyan?
Dialogue: 0,1:04:28.78,1:04:30.36,Default,,0,0,0,,{\i1}{\c&HFFFF&}Half-Price na Tanghalian{\c}{\i0}
Dialogue: 0,1:04:37.74,1:04:38.72,Default,,0,0,0,,Kumusta.
Dialogue: 0,1:04:38.74,1:04:40.18,Default,,0,0,0,,Hey, Mr. Park.
Dialogue: 0,1:04:40.20,1:04:42.14,Default,,0,0,0,,Masarap ang sopas ngayon.
Dialogue: 0,1:04:42.16,1:04:43.98,Default,,0,0,0,,Halika. Ito ay palaging mabuti.
Dialogue: 0,1:04:44.00,1:04:46.69,Default,,0,0,0,,Ano ito?
Dialogue: 0,1:04:46.71,1:04:48.86,Default,,0,0,0,,Parang handaan.
Dialogue: 0,1:04:48.88,1:04:51.86,Default,,0,0,0,,Dapat tayong makipagkumpitensya sa mga pangako at plano,
Dialogue: 0,1:04:51.88,1:04:55.57,Default,,0,0,0,,ngunit sinusubukan niyang manalo ng mga tao\Nover sa isang sikat na kanta.
Dialogue: 0,1:04:55.60,1:04:59.62,Default,,0,0,0,,I mean, kung manalo siya sa eleksyon na ganito,\Nit's not his victory. Sa singer yan!
Dialogue: 0,1:04:59.64,1:05:04.25,Default,,0,0,0,,Dapat itong ituring na\paglabag sa batas ng Nelection. Oo.
Dialogue: 0,1:05:04.27,1:05:06.21,Default,,0,0,0,,Chun-sik, mangalap ng ebidensya.
Dialogue: 0,1:05:06.23,1:05:10.93,Default,,0,0,0,,Yung mga naglilibang at yung mga\Nnaglalaro kasama. Iuulat ko ang lahat!
Dialogue: 0,1:05:11.15,1:05:12.98,Default,,0,0,0,,Halika!
Dialogue: 0,1:05:16.24,1:05:18.11,Default,,0,0,0,,Napahamak kayong lahat.
Dialogue: 0,1:05:20.24,1:05:22.24,Default,,0,0,0,,Maghintay. ano...?
Dialogue: 0,1:05:22.66,1:05:24.57,Default,,0,0,0,,- Mr. Baek.\N- Ano?
Dialogue: 0,1:05:34.30,1:05:37.74,Default,,0,0,0,,Seok-hun! Kukuha pa ako ng isang pinggan ng baboy.
Dialogue: 0,1:05:37.76,1:05:38.86,Default,,0,0,0,,Isa pang soju, din!
Dialogue: 0,1:05:38.89,1:05:41.45,Default,,0,0,0,,Sobrang sarap!
Dialogue: 0,1:05:41.47,1:05:43.93,Default,,0,0,0,,Ang piraso ng...!
Dialogue: 0,1:05:44.02,1:05:45.16,Default,,0,0,0,,Anak ka ng...!
Dialogue: 0,1:05:45.19,1:05:46.29,Default,,0,0,0,,I shoulda...!
Dialogue: 0,1:05:46.31,1:05:47.54,Default,,0,0,0,,Gaano ito kalala?
Dialogue: 0,1:05:47.56,1:05:50.29,Default,,0,0,0,,Pumasok siya sa bitag nila.
Dialogue: 0,1:05:50.32,1:05:55.05,Default,,0,0,0,,Korupsyon sa pamilya. Isa itong isyu kahit na\Nhindi maiiwasan ng mga pangulo ng bansa.
Dialogue: 0,1:05:55.07,1:05:58.80,Default,,0,0,0,,Hinayaan ng anak ng kasalukuyang pinuno ng nayon\Nang kabaligtaran na ipagluto siya ng pagkain.
Dialogue: 0,1:05:58.82,1:06:02.26,Default,,0,0,0,,Sinabi ng mga tao na sira ang pamilya ng ulo,
Dialogue: 0,1:06:02.29,1:06:05.56,Default,,0,0,0,,dahil hindi nadisiplina ng maayos ang kanyang mga anak\N.
Dialogue: 0,1:06:05.58,1:06:06.85,Default,,0,0,0,,Ang tanga mo!
Dialogue: 0,1:06:06.87,1:06:08.66,Default,,0,0,0,,Hindi ako makapaniwala sa iyo!
Dialogue: 0,1:06:10.34,1:06:12.65,Default,,0,0,0,,Tatay, babaguhin ko ang opinyon nila.
Dialogue: 0,1:06:12.67,1:06:13.90,Default,,0,0,0,,Ano ang magagawa mo?
Dialogue: 0,1:06:13.92,1:06:15.98,Default,,0,0,0,,Ang aking salon ay gumagawa ng humigit-kumulang 90%
Dialogue: 0,1:06:16.01,1:06:18.70,Default,,0,0,0,,ng mga tsismis sa Yongdu-ri.
Dialogue: 0,1:06:18.72,1:06:20.84,Default,,0,0,0,,Alam mo, mga tsismosa!
Dialogue: 0,1:06:21.06,1:06:23.91,Default,,0,0,0,,- Magagamit natin sila.\N- Parang smear campaign?
Dialogue: 0,1:06:23.93,1:06:27.08,Default,,0,0,0,,Eksakto! Nagnakaw si Seok-hun ng meryenda sa aming tindahan...
Dialogue: 0,1:06:27.10,1:06:28.37,Default,,0,0,0,,noong bata pa siya.
Dialogue: 0,1:06:28.40,1:06:29.62,Default,,0,0,0,,Ilalantad namin iyon.
Dialogue: 0,1:06:29.65,1:06:33.43,Default,,0,0,0,,"Ang magnanakaw ng itlog ay magnanakaw ng baka!"
Dialogue: 0,1:06:33.73,1:06:35.60,Default,,0,0,0,,Ano sa tingin mo?
Dialogue: 0,1:06:36.70,1:06:38.01,Default,,0,0,0,,May sigarilyo ka ba?
Dialogue: 0,1:06:38.03,1:06:39.94,Default,,0,0,0,,Tumigil ako sa paninigarilyo.
Dialogue: 0,1:06:56.76,1:06:57.99,Default,,0,0,0,,Mi-seon, sasama ka ba?
Dialogue: 0,1:06:58.01,1:07:00.99,Default,,0,0,0,,Magkakaharap ang iyong ama at Seok-hun\N.
Dialogue: 0,1:07:01.01,1:07:02.36,Default,,0,0,0,,Sige.
Dialogue: 0,1:07:02.39,1:07:08.12,Default,,0,0,0,,Sa tingin ko ay hindi. Ang iyong pamilya ay nangangailangan ng maraming tao hangga't maaari sa kanilang panig.
Dialogue: 0,1:07:08.14,1:07:10.33,Default,,0,0,0,,- Bakit?\N- Ano ang ibig mong sabihin, "bakit"?
Dialogue: 0,1:07:10.35,1:07:13.25,Default,,0,0,0,,Dehade kasi ang ulo ngayon.
Dialogue: 0,1:07:13.27,1:07:14.84,Default,,0,0,0,,Just go!
Dialogue: 0,1:07:14.86,1:07:15.92,Default,,0,0,0,,Halika na lang!
Dialogue: 0,1:07:15.94,1:07:18.13,Default,,0,0,0,,My gosh! go lang!
Dialogue: 0,1:07:18.15,1:07:19.63,Default,,0,0,0,,Hindi, Pinky!
Dialogue: 0,1:07:19.66,1:07:21.55,Default,,0,0,0,,Bumalik ka.
Dialogue: 0,1:07:21.57,1:07:24.09,Default,,0,0,0,,{\i1}Nandito ako...{\i0}
Dialogue: 0,1:07:24.12,1:07:26.97,Default,,0,0,0,,{\i1}dahil kailangan ng ating barangay ang mga kabataan.{\i0}
Dialogue: 0,1:07:27.00,1:07:28.31,Default,,0,0,0,,Tulad ng sinabi ko kanina,
Dialogue: 0,1:07:28.33,1:07:32.44,Default,,0,0,0,,Gagawin kong K-food ang Yongdu Apple\Nibig ng mga tao sa buong mundo!
Dialogue: 0,1:07:32.46,1:07:37.46,Default,,0,0,0,,Ako, si Park Seok-hun, babawi\Nang dalawang taon na nawala si Yongdu-ri!
Dialogue: 0,1:07:39.55,1:07:41.15,Default,,0,0,0,,Tanggap na siya.
Dialogue: 0,1:07:41.18,1:07:42.88,Default,,0,0,0,,Okay lang.
Dialogue: 0,1:07:43.35,1:07:45.30,Default,,0,0,0,,Okay lang.
Dialogue: 0,1:07:46.68,1:07:48.74,Default,,0,0,0,,Lahat, ang ating Yongdu-ri...
Dialogue: 0,1:07:48.77,1:07:51.83,Default,,0,0,0,,ay parang puso ng Korean peras.
Dialogue: 0,1:07:51.85,1:07:55.83,Default,,0,0,0,,Well, hindi ba ang puso ng mga peras ay Naju o Seongju?
Dialogue: 0,1:07:55.86,1:08:00.51,Default,,0,0,0,,Tama! Hindi si Yongdu-ri ang puso. Parang...
Dialogue: 0,1:08:00.53,1:08:01.59,Default,,0,0,0,,Paano ko ito ilalagay?
Dialogue: 0,1:08:01.61,1:08:04.38,Default,,0,0,0,,Ito ay mas katulad ng bituka.
Dialogue: 0,1:08:04.41,1:08:06.03,Default,,0,0,0,,Tama ba ako?
Dialogue: 0,1:08:06.66,1:08:09.89,Default,,0,0,0,,Tama. Kung ito ang puso, ang ating mga peras...
Dialogue: 0,1:08:09.91,1:08:14.06,Default,,0,0,0,,ay ibebenta sa kanyang anak na babae-\Nin-law's department store.
Dialogue: 0,1:08:14.09,1:08:16.12,Default,,0,0,0,,Tama ka!
Dialogue: 0,1:08:17.96,1:08:21.32,Default,,0,0,0,,Ano? Bakit dinala iyon dito?
Dialogue: 0,1:08:21.34,1:08:22.61,Default,,0,0,0,,Ang aking manugang...
Dialogue: 0,1:08:22.64,1:08:25.32,Default,,0,0,0,,pinananatiling hiwalay ang kanyang trabaho at pribadong buhay!
Dialogue: 0,1:08:25.35,1:08:27.87,Default,,0,0,0,,Naiintindihan ko na siya ay isang mahusay na CEO,
Dialogue: 0,1:08:27.89,1:08:28.91,Default,,0,0,0,,pero ang kanyang pribadong buhay?
Dialogue: 0,1:08:28.93,1:08:32.25,Default,,0,0,0,,To be blunt, nabalitaan lang namin\N na nagpakasal sila ng anak mo.
Dialogue: 0,1:08:32.27,1:08:35.87,Default,,0,0,0,,- Hindi pa namin siya nakita.\N- Hindi ba siya sumakay sa chopper?
Dialogue: 0,1:08:35.90,1:08:38.75,Default,,0,0,0,,Tama. Akala ko sumiklab ang digmaan noon.
Dialogue: 0,1:08:38.78,1:08:41.76,Default,,0,0,0,,Totoo na hindi pa siya\Nbinibisita simula noong ikasal sila.
Dialogue: 0,1:08:41.78,1:08:44.19,Default,,0,0,0,,Bago pa sila ikasal?
Dialogue: 0,1:08:45.83,1:08:47.55,Default,,0,0,0,,- Ano?\N- Anong nangyayari?
Dialogue: 0,1:08:47.58,1:08:50.90,Default,,0,0,0,,- Lindol ba?\N- Anong nangyayari?
Dialogue: 0,1:08:51.29,1:08:52.75,Default,,0,0,0,,{\i1}{\c&HFFFF&}Yongdu-ri Community Hall{\c}{\i0}
Dialogue: 0,1:08:59.59,1:09:02.62,Default,,0,0,0,,- Ano iyon?\N- I-film ito.
Dialogue: 0,1:09:03.01,1:09:05.29,Default,,0,0,0,,Marami silang dala.
Dialogue: 0,1:09:35.08,1:09:36.95,Default,,0,0,0,,Ama?
Dialogue: 0,1:09:38.42,1:09:39.81,Default,,0,0,0,,My gosh.
Dialogue: 0,1:09:39.84,1:09:41.75,Default,,0,0,0,,Ay naku.
Dialogue: 0,1:09:51.52,1:09:53.17,Default,,0,0,0,,Hindi pwede...
Dialogue: 0,1:09:55.39,1:09:56.71,Default,,0,0,0,,Dumating siya.
Dialogue: 0,1:09:56.73,1:09:58.64,Default,,0,0,0,,Sa wakas.
Dialogue: 0,1:10:05.40,1:10:09.01,Default,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,1:10:09.03,1:10:11.05,Default,,0,0,0,,Natutuwa akong nandito kayong lahat.
Dialogue: 0,1:10:11.08,1:10:13.26,Default,,0,0,0,,Na-miss ko ang huling kaarawan mo,
Dialogue: 0,1:10:13.29,1:10:17.66,Default,,0,0,0,,kaya pumunta ako para kumain ng mga taganayon.
Dialogue: 0,1:10:20.46,1:10:25.37,Default,,0,0,0,,Hello, ako si Hong Hae-in, ang manugang ng\Nvillage head.
Dialogue: 0,1:10:29.14,1:10:30.41,Default,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,1:10:30.43,1:10:31.99,Default,,0,0,0,,I texted her.
Dialogue: 0,1:10:32.01,1:10:35.29,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sabi mo bibisita ka sa amin isa sa mga araw na ito.{\c}{\i0}
Dialogue: 0,1:10:35.31,1:10:39.37,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pwede bang ngayon at ngayon ang araw na iyon?{\c}{\i0}
Dialogue: 0,1:10:39.40,1:10:43.75,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang aking ama ay tumatakbo para sa muling halalan,\Nand ito ay hindi maganda.{\c}{\i0}
Dialogue: 0,1:10:43.78,1:10:48.56,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sa tingin ko kailangan niyang ipakita sa mga tao\Nisang taong maimpluwensyang sumusuporta sa kanya.{\c}{\i0}
Dialogue: 0,1:10:56.76,1:10:59.28,Default,,0,0,0,,Nabasa niya! May nakasulat na "basahin."
Dialogue: 0,1:11:03.05,1:11:05.25,Default,,0,0,0,,Dumating siya dahil sa text na iyon?
Dialogue: 0,1:11:05.30,1:11:07.17,Default,,0,0,0,,Hindi rin ako makapaniwala.
Dialogue: 0,1:11:07.88,1:11:10.38,Default,,0,0,0,,Good job!
Dialogue: 0,1:11:11.10,1:11:12.41,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:11:12.43,1:11:13.78,Default,,0,0,0,,Hindi masyado.
Dialogue: 0,1:11:13.81,1:11:16.99,Default,,0,0,0,,Mamahaling nutritional supplement, ginseng,
Dialogue: 0,1:11:17.02,1:11:20.21,Default,,0,0,0,,mga pampaganda, silk scarves, cashmere muffler,
Dialogue: 0,1:11:20.23,1:11:22.50,Default,,0,0,0,,Italian leather gloves, atbp.
Dialogue: 0,1:11:22.52,1:11:25.25,Default,,0,0,0,,Bibili sana ako ng kaunti para kay Ama,
Dialogue: 0,1:11:25.28,1:11:26.46,Default,,0,0,0,,pero lumampas ako.
Dialogue: 0,1:11:26.49,1:11:28.34,Default,,0,0,0,,Maaari kang magbahagi.
Dialogue: 0,1:11:28.36,1:11:31.05,Default,,0,0,0,,Ay naku. Hindi ako makapaniwala sa iyo.
Dialogue: 0,1:11:31.07,1:11:34.28,Default,,0,0,0,,Masyado kang bumili.
Dialogue: 0,1:11:36.16,1:11:39.10,Default,,0,0,0,,- Baek Du-gwan!\N- Baek Du-gwan!
Dialogue: 0,1:11:39.12,1:11:44.02,Default,,0,0,0,,- Hae-in!\N- Baek Du-gwan!
Dialogue: 0,1:11:44.04,1:11:47.27,Default,,0,0,0,,Lahat! Ano ang espesyalidad ni Yongdu-ri? Mansanas o peras?
Dialogue: 0,1:11:47.30,1:11:49.58,Default,,0,0,0,,- Mga peras!\N- Mga peras!
Dialogue: 0,1:11:50.59,1:11:53.66,Default,,0,0,0,,- Baek Du-gwan!\N- Baek Du-gwan!
Dialogue: 0,1:11:53.68,1:11:56.07,Default,,0,0,0,,- Hae-in!\N- Baek Du-gwan!
Dialogue: 0,1:11:56.10,1:11:58.35,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Baek Du-gwan\NA hard worker na nagpoprotekta kay Yongdu-ri{\c}{\i0}
Dialogue: 0,1:12:27.71,1:12:31.17,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo. Nandito si Hae-in.{\c}{\i0}
Dialogue: 0,1:12:34.47,1:12:36.57,Default,,0,0,0,,- Uy.\N- {\i1}Nay, na-miss ko ang tawag mo.{\i0}
Dialogue: 0,1:12:36.60,1:12:38.78,Default,,0,0,0,,Okay lang. kamusta ka na?
Dialogue: 0,1:12:38.81,1:12:42.58,Default,,0,0,0,,Narinig kong pumunta sina Mi-seon at Hyeon-tae\Ndoon. Nagulat ka siguro.
Dialogue: 0,1:12:42.60,1:12:46.17,Default,,0,0,0,,Hindi, okay lang. Walang masama\Nnangyari, kaya huwag mag-alala.
Dialogue: 0,1:12:46.19,1:12:47.46,Default,,0,0,0,,{\i1}At si Hae-in ay...{\i0}
Dialogue: 0,1:12:47.48,1:12:49.44,Default,,0,0,0,,Oo, magaling din siya.
Dialogue: 0,1:12:49.47,1:12:50.50,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,1:12:50.53,1:12:52.56,Default,,0,0,0,,{\i1}Nag-away ba kayong dalawa?{\i0}
Dialogue: 0,1:12:53.95,1:12:54.92,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,1:12:54.95,1:12:57.68,Default,,0,0,0,,Kung gayon bakit hindi mo alam kung nasaan siya?
Dialogue: 0,1:12:57.70,1:12:59.64,Default,,0,0,0,,{\i1}Nandito siya.{\i0}
Dialogue: 0,1:12:59.66,1:13:01.72,Default,,0,0,0,,Ano? Bakit siya naroroon?
Dialogue: 0,1:13:01.75,1:13:03.48,Default,,0,0,0,,{\i1}Dapat ikaw mismo ang pumunta sa kanya.{\i0}
Dialogue: 0,1:13:03.50,1:13:06.91,Default,,0,0,0,,{\i1}Ang buong baryo ay nagdiriwang\Na, salamat sa kanya.{\i0}
Dialogue: 0,1:13:08.30,1:13:10.33,Default,,0,0,0,,Ano ang sinasabi niya?
Dialogue: 0,1:13:12.26,1:13:14.63,Default,,0,0,0,,Nasaan si Hae-in ngayon?
Dialogue: 0,1:13:41.37,1:13:43.50,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialogue: 0,1:15:05.62,1:15:07.53,Default,,0,0,0,,Sino ka?
Dialogue: 0,1:15:08.29,1:15:09.95,Default,,0,0,0,,Ako?
Dialogue: 0,1:15:10.17,1:15:12.02,Default,,0,0,0,,Ako ang manugang.
Dialogue: 0,1:15:12.04,1:15:14.40,Default,,0,0,0,,- Sino ka?\N- Kilala ko lahat sa pamilyang ito,
Dialogue: 0,1:15:14.42,1:15:16.33,Default,,0,0,0,,pero hindi pa kita nakikita.
Dialogue: 0,1:15:17.72,1:15:19.50,Default,,0,0,0,,Hindi ako madalas pumunta dito.
Dialogue: 0,1:15:24.89,1:15:27.54,Default,,0,0,0,,Bakit mo ako tinitingnan ng ganyan\Nganyan? Bahagi ako ng pamilya.
Dialogue: 0,1:15:27.56,1:15:29.55,Default,,0,0,0,,Kung gayon ano ang pangalan ng aso?
Dialogue: 0,1:15:32.31,1:15:33.58,Default,,0,0,0,,Musty.
Dialogue: 0,1:15:33.61,1:15:34.58,Default,,0,0,0,,Spotty?
Dialogue: 0,1:15:34.61,1:15:36.25,Default,,0,0,0,,Wala silang aso.
Dialogue: 0,1:15:36.28,1:15:37.46,Default,,0,0,0,,Mukha kang kahina-hinala.
Dialogue: 0,1:15:37.49,1:15:39.59,Default,,0,0,0,,Bakit ka naghihinala?
Dialogue: 0,1:15:39.61,1:15:43.18,Default,,0,0,0,,Ako ang asawa ni Baek Hyun-woo,\Nanak ng pamilyang ito. Masaya? Ngayon pumunta ka.
Dialogue: 0,1:15:43.20,1:15:46.26,Default,,0,0,0,,Ikaw ang may-ari ng gusali.\NDapat sinabi mo sa akin ng mas maaga.
Dialogue: 0,1:15:46.29,1:15:48.31,Default,,0,0,0,,- Ano?\N- Sinabi sa akin ng tatay ko...
Dialogue: 0,1:15:48.33,1:15:51.53,Default,,0,0,0,,Ang asawa ni Uncle Hyun-woo ay\Nang may-ari ng building namin.
Dialogue: 0,1:15:54.84,1:15:56.44,Default,,0,0,0,,Hayaan mong batiin kita ng maayos, Tita.
Dialogue: 0,1:15:56.46,1:15:59.33,Default,,0,0,0,,- Ako si Baek Ho-yeol.\N- I see.
Dialogue: 0,1:15:59.51,1:16:02.03,Default,,0,0,0,,Pamangkin kita na narinig ko lang.
Dialogue: 0,1:16:02.05,1:16:03.49,Default,,0,0,0,,Oo, ako nga.
Dialogue: 0,1:16:03.51,1:16:05.95,Default,,0,0,0,,May nakita akong hindi pamilyar na sasakyan sa harap ng bahay.
Dialogue: 0,1:16:05.97,1:16:08.41,Default,,0,0,0,,Iyo ba Tita?
Dialogue: 0,1:16:08.43,1:16:10.18,Default,,0,0,0,,Oo, ito nga.
Dialogue: 0,1:16:10.81,1:16:12.16,Default,,0,0,0,,Ang sakit.
Dialogue: 0,1:16:12.19,1:16:16.29,Default,,0,0,0,,Isang V8 engine, ang horsepower at speed tuning.
Dialogue: 0,1:16:16.32,1:16:19.39,Default,,0,0,0,,Sa iyo talaga ang bihirang sasakyan na iyon?
Dialogue: 0,1:16:19.70,1:16:22.23,Default,,0,0,0,,Puwede ba akong sumakay, please?
Dialogue: 0,1:16:23.24,1:16:26.48,Default,,0,0,0,,Kung hahayaan kita, titigil ka ba sa pakikipag-usap sa akin?
Dialogue: 0,1:16:26.95,1:16:28.90,Default,,0,0,0,,Pangako ko sa iyo.
Dialogue: 0,1:16:31.50,1:16:34.44,Default,,0,0,0,,Kaya mo ba siyang i-drive sa paligid ng village?
Dialogue: 0,1:16:34.46,1:16:37.23,Default,,0,0,0,,Siguro tatlo o apat na lap.
Dialogue: 0,1:16:37.25,1:16:38.96,Default,,0,0,0,,Yes, ma'am.
Dialogue: 0,1:18:32.41,1:18:34.39,Default,,0,0,0,,Nandito na ang bunso ko!
Dialogue: 0,1:18:34.41,1:18:35.85,Default,,0,0,0,,Gosh, Hyun-woo.
Dialogue: 0,1:18:35.87,1:18:39.27,Default,,0,0,0,,Yung massage chair na binigay mo sa amin last time.
Dialogue: 0,1:18:39.29,1:18:42.25,Default,,0,0,0,,Napakaganda nito. maraming salamat po.
Dialogue: 0,1:18:42.67,1:18:46.48,Default,,0,0,0,,Sinabi sa akin ng mga kaibigan ko na magpa-picture ako sa iyo kapag nakilala kita.
Dialogue: 0,1:18:46.51,1:18:48.58,Default,,0,0,0,,Okay lang ba?
Dialogue: 0,1:18:49.68,1:18:50.99,Default,,0,0,0,,Dalawa, tatlo.
Dialogue: 0,1:18:51.01,1:18:53.07,Default,,0,0,0,,I'm sorry, pero pwede ka bang tumabi?
Dialogue: 0,1:18:53.10,1:18:54.53,Default,,0,0,0,,Halika.
Dialogue: 0,1:18:54.56,1:18:55.83,Default,,0,0,0,,Ang braso mo rin.
Dialogue: 0,1:18:55.85,1:18:57.75,Default,,0,0,0,,- Pati braso ko?\N- Tayong dalawa lang.
Dialogue: 0,1:18:57.77,1:19:02.50,Default,,0,0,0,,Ngayon, ngayon. Nag-install siya ng mga air conditioner\Nand boiler sa aming senior center.
Dialogue: 0,1:19:02.52,1:19:07.15,Default,,0,0,0,,Hyun-woo ang pagmamalaki ni Yongdu-ri.\NGPalakpakan siya!
Dialogue: 0,1:19:07.78,1:19:08.92,Default,,0,0,0,,Kapatid ko siya.
Dialogue: 0,1:19:08.95,1:19:10.01,Default,,0,0,0,,Kapatid ko.
Dialogue: 0,1:19:10.03,1:19:11.73,Default,,0,0,0,,Kumain ka nang busog.
Dialogue: 0,1:19:16.12,1:19:17.43,Default,,0,0,0,,Well...
Dialogue: 0,1:19:17.46,1:19:20.69,Default,,0,0,0,,Narinig ko ito mula sa iyong kapatid,
Dialogue: 0,1:19:20.71,1:19:23.04,Default,,0,0,0,,pero huwag kang mag-alala sa akin.
Dialogue: 0,1:19:23.09,1:19:25.73,Default,,0,0,0,,Hindi ko binanggit ang divorce sa asawa mo.
Dialogue: 0,1:19:25.76,1:19:27.48,Default,,0,0,0,,Binabanggit mo ngayon, Dad.
Dialogue: 0,1:19:27.51,1:19:29.17,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,1:19:29.51,1:19:32.28,Default,,0,0,0,,Wala siya dito. Nasa bahay siya.
Dialogue: 0,1:19:32.30,1:19:33.70,Default,,0,0,0,,- Hindi, hindi siya.\N- Ano?
Dialogue: 0,1:19:33.72,1:19:36.37,Default,,0,0,0,,Kinuha ko lang si Ho-yeol. Wala siya doon.
Dialogue: 0,1:19:36.39,1:19:37.99,Default,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,1:19:38.02,1:19:39.80,Default,,0,0,0,,Wala siya.
Dialogue: 0,1:19:52.32,1:19:53.89,Default,,0,0,0,,Hello, Mr. Baek.
Dialogue: 0,1:19:53.91,1:19:55.09,Default,,0,0,0,,Nasaan si Hae-in?
Dialogue: 0,1:19:55.12,1:19:59.36,Default,,0,0,0,,Wala siya sa community hall?\NPagbalik ko, wala siya.
Dialogue: 0,1:20:17.35,1:20:19.05,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:20:22.44,1:20:23.41,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:20:23.44,1:20:25.64,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:20:28.86,1:20:30.39,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:20:48.05,1:20:49.75,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:20:51.30,1:20:53.00,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:21:09.32,1:21:11.02,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:21:56.45,1:21:57.98,Default,,0,0,0,,Ano ang nangyari?
Dialogue: 0,1:22:03.75,1:22:06.41,Default,,0,0,0,,- Bakit ka nandito?\N- Bakit ka sumisigaw?
Dialogue: 0,1:22:09.29,1:22:11.91,Default,,0,0,0,,Narinig ko na bigla kang pumunta rito,
Dialogue: 0,1:22:12.59,1:22:14.61,Default,,0,0,0,,kaya dumating ako, pero wala ka sa bahay...
Dialogue: 0,1:22:14.63,1:22:16.78,Default,,0,0,0,,o sa bulwagan. Walang nakakaalam kung nasaan ka.
Dialogue: 0,1:22:16.80,1:22:18.88,Default,,0,0,0,,Hindi mo sinagot ang iyong telepono!
Dialogue: 0,1:22:18.97,1:22:20.67,Default,,0,0,0,,Kaya...
Dialogue: 0,1:22:21.06,1:22:23.67,Default,,0,0,0,,- bakit ka nandito...?\N- Tahan na.
Dialogue: 0,1:22:25.23,1:22:27.26,Default,,0,0,0,,Lumabas ako para mamasyal.
Dialogue: 0,1:22:29.94,1:22:32.34,Default,,0,0,0,,Isang lakad sa lugar na ito?
Dialogue: 0,1:22:32.36,1:22:34.27,Default,,0,0,0,,Oo.
Dialogue: 0,1:22:35.86,1:22:38.40,Default,,0,0,0,,- Nag-alala ako!\N- Bakit magiging kayo?
Dialogue: 0,1:22:39.53,1:22:41.53,Default,,0,0,0,,Hindi ako pasyente.
Dialogue: 0,1:22:44.75,1:22:46.61,Default,,0,0,0,,Tama.
Dialogue: 0,1:22:47.00,1:22:49.66,Default,,0,0,0,,Oo, sinabi mo sa akin iyan.
Dialogue: 0,1:22:52.38,1:22:54.46,Default,,0,0,0,,Pasensya na sumigaw ako.
Dialogue: 0,1:23:27.66,1:23:29.41,Default,,0,0,0,,Ang totoo ay...
Dialogue: 0,1:23:30.92,1:23:32.70,Default,,0,0,0,,Hindi ko na maalala.
Dialogue: 0,1:23:34.13,1:23:37.08,Default,,0,0,0,,Hindi ko talaga maalala kung bakit ako nandoon.
Dialogue: 0,1:23:48.52,1:23:50.58,Default,,0,0,0,,Nasa harap ako ng bahay mo,
Dialogue: 0,1:23:50.60,1:23:53.47,Default,,0,0,0,,tapos bigla akong nasa ibang lugar.
Dialogue: 0,1:23:56.74,1:23:59.35,Default,,0,0,0,,Hindi ko alam kung kailan ako pumunta doon,
Dialogue: 0,1:24:01.45,1:24:03.19,Default,,0,0,0,,o paano.
Dialogue: 0,1:24:06.33,1:24:08.03,Default,,0,0,0,,Wala akong ideya.
Dialogue: 0,1:24:09.96,1:24:11.66,Default,,0,0,0,,Ako ay...
Dialogue: 0,1:24:16.25,1:24:17.96,Default,,0,0,0,,nakakatakot.
Dialogue: 0,1:25:39.17,1:25:42.90,Default,,0,0,0,,{\i1}{\c&HFFFF&}Pinangalanang Outstanding School of 2006{\c}{\i0}
Dialogue: 0,1:25:42.92,1:25:45.58,Default,,0,0,0,,- Nandito na tayo.\N- Okay.
Dialogue: 0,1:25:46.18,1:25:48.50,Default,,0,0,0,,- See you later.\N- See you.
Dialogue: 0,1:25:50.89,1:25:52.80,Default,,0,0,0,,Teka, Hyun-woo.
Dialogue: 0,1:25:53.43,1:25:56.50,Default,,0,0,0,,Hindi ganoon\Niba ang mga tao sa Seoul. Huwag masiraan ng loob.
Dialogue: 0,1:25:56.52,1:25:58.54,Default,,0,0,0,,Manindigan.
Dialogue: 0,1:25:58.57,1:26:00.13,Default,,0,0,0,,- Matatag.\N- Tumayo nang tuwid,
Dialogue: 0,1:26:00.15,1:26:03.17,Default,,0,0,0,,at subukang sumikat nang ganito.
Dialogue: 0,1:26:03.19,1:26:05.05,Default,,0,0,0,,- Okay.\N- Mabuti. Pumasok ka.
Dialogue: 0,1:26:05.07,1:26:07.11,Default,,0,0,0,,- Bye, Dad.\N- Bye.
Dialogue: 0,1:26:07.16,1:26:10.03,Default,,0,0,0,,- Makinig sa iyong guro.\N- Magmaneho nang ligtas!
Dialogue: 0,1:26:16.17,1:26:19.31,Default,,0,0,0,,Pupunta si Hae-in sa U.S. para mag-aral.
Dialogue: 0,1:26:19.34,1:26:21.36,Default,,0,0,0,,Magpaalam ka sa kanya, okay?
Dialogue: 0,1:26:21.38,1:26:23.62,Default,,0,0,0,,- Yes, sir.\N- Yes, sir.
Dialogue: 0,1:26:26.93,1:26:28.63,Default,,0,0,0,,Tingnan mo ang mukha niya.
Dialogue: 0,1:26:28.76,1:26:30.78,Default,,0,0,0,,Buong-buo pa rin siya sa sarili niya.
Dialogue: 0,1:26:30.81,1:26:35.18,Default,,0,0,0,,May tsismis na siya ay\Nadmitted sa mental hospital.
Dialogue: 0,1:26:35.35,1:26:38.60,Default,,0,0,0,,Balita ko dahil pumunta siya\Nmad pagkatapos mamatay ang kapatid niya.
Dialogue: 0,1:27:21.02,1:27:22.72,Default,,0,0,0,,Maghintay.
Dialogue: 0,1:27:34.99,1:27:36.70,Default,,0,0,0,,Kunin mo.
Dialogue: 0,1:27:40.29,1:27:41.99,Default,,0,0,0,,Hindi ko ito kailangan.
Dialogue: 0,1:27:58.18,1:28:01.05,Default,,0,0,0,,Linisin ito at lagyan ng ointment.
Dialogue: 0,1:28:12.41,1:28:13.98,Default,,0,0,0,,Umiiyak ka ba?
Dialogue: 0,1:28:16.91,1:28:18.82,Default,,0,0,0,,Hindi ako.
Dialogue: 0,1:28:29.84,1:28:31.71,Default,,0,0,0,,Ikaw.
Dialogue: 0,1:28:43.27,1:28:46.19,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,1:29:13.38,1:29:15.32,Default,,0,0,0,,{\an8}{\i1}Huwag kang mangahas na banggitin ang diborsyo.{\i0}
Dialogue: 0,1:29:15.35,1:29:17.03,Default,,0,0,0,,{\an8}{\i1}Nakuha mo.{\i0}
Dialogue: 0,1:29:17.06,1:29:19.33,Default,,0,0,0,,{\an8}{\i1}Walang anuman ang diborsyo.{\i0}
Dialogue: 0,1:29:19.35,1:29:21.76,Default,,0,0,0,,{\an8}{\i1}Gusto ko ring makipagdiborsiyo.{\i0}
Dialogue: 0,1:29:23.39,1:29:24.87,Default,,0,0,0,,{\an8}- {\i1}Anong mali?\N- Don't mind me.{\i0}
Dialogue: 0,1:29:24.90,1:29:27.00,Default,,0,0,0,,{\an8}{\i1}Paano namatay ang kanilang pagmamahalan?{\i0}
Dialogue: 0,1:29:27.02,1:29:29.59,Default,,0,0,0,,{\an8}{\i1}Dati silang baliw sa pag-ibig.{\i0}
Dialogue: 0,1:29:29.61,1:29:32.59,Default,,0,0,0,,{\an8}{\i1}Ang babaeng mahal ko ngayon ay ikaw.{\i0}
Dialogue: 0,1:29:32.61,1:29:34.55,Default,,0,0,0,,{\an8}{\i1}Masyadong mababa ang iyong white blood cell count.{\i0}
Dialogue: 0,1:29:34.57,1:29:36.55,Default,,0,0,0,,{\an8}{\i1}Hahanap ako ng paraan.{\i0}
Dialogue: 0,1:29:36.57,1:29:38.34,Default,,0,0,0,,{\an8}{\i1}Kahit kailangan kong hanapin ang mundo,{\i0}
Dialogue: 0,1:29:38.37,1:29:39.85,Default,,0,0,0,,{\an8}{\i1}Hahanap ako ng paraan para mabuhay.{\i0}
Dialogue: 0,1:29:39.87,1:29:41.47,Default,,0,0,0,,{\an8}{\i1}Kaya ako dapat...{\i0}
Dialogue: 0,1:29:41.50,1:29:43.97,Default,,0,0,0,,{\an8}{\i1}kasama mo sa mga panahong tulad nito.{\i0}
Dialogue: 0,1:29:44.00,1:29:45.02,Default,,0,0,0,,{\an8}{\i1}Gusto kita...{\i0}
Dialogue: 0,1:29:45.04,1:29:47.41,Default,,0,0,0,,{\an8}{\i1}upang makasama ako.{\i0}
