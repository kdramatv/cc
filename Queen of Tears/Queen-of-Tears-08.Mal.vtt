Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.93,0:01:05.39, Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Empat Tahun Lalu{\c}{\i0}
Dialog: 0,0:01:14.28,0:01:16.53, Lalai,,0,0,0,,Itu pelik.
Dialog: 0,0:01:16.55,0:01:17.55, Lalai,,0,0,0,,Apa itu?
Dialog: 0,0:01:17.57,0:01:19.80, Lalai,,0,0,0,,Mereka kata ini...
Dialog: 0,0:01:19.82,0:01:22.44, Lalai,,0,0,0,,tempat temu janji terbaik,
Dialog: 0,0:01:22.49,0:01:24.74, Lalai,,0,0,0,,tetapi kenapa ia kosong?
Dialog: 0,0:01:26.83,0:01:28.62, Lalai,,0,0,0,,Anda betul. Ia adalah.
Dialog: 0,0:01:34.80,0:01:36.55, Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Disewa untuk Hari{\c}{\i0}
Dialog: 0,0:01:57.61,0:02:00.02, Lalai,,0,0,0,,Muzik...
Dialog: 0,0:02:00.66,0:02:01.76, Lalai,,0,0,0,,Bagaimana pula?
Dialog: 0,0:02:01.78,0:02:04.30, Lalai,,0,0,0,,Bukankah mereka biasanya bermain...
Dialog: 0,0:02:04.33,0:02:06.68, Lalai,,0,0,0,,lagu gembira seperti yang...
Dialog: 0,0:02:06.70,0:02:09.02, Lalai,,0,0,0,,dalam "The Little Mermaid"?
Dialog: 0,0:02:09.04,0:02:11.91, Lalai,,0,0,0,,Bunyinya agak terlalu romantis.
Dialog: 0,0:02:21.22,0:02:22.20, Lalai,,0,0,0,,Tukar lagu!
Dialog: 0,0:02:22.22,0:02:23.24, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:02:23.26,0:02:26.47, Lalai,,0,0,0,,Senarai main ini dipanggil "Call for Love."
Dialog: 0,0:02:29.60,0:02:31.43, Lalai,,0,0,0,,Muzik berubah.
Dialog: 0,0:02:32.15,0:02:33.89, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:02:34.32,0:02:36.02, Lalai,,0,0,0,,Sungguh menarik.
Dialog: 0,0:02:37.44,0:02:39.71, Lalai,,0,0,0,,Pn. Hong, hari ini...
Dialog: 0,0:02:39.74,0:02:42.76,Lalai,,0,0,0,,rasanya seperti seluruh alam semesta...
Dialog: 0,0:02:42.78,0:02:45.86,Lalai,,0,0,0,,ada di pihak kami.
Dialog: 0,0:02:46.29,0:02:50.66, Lalai,,0,0,0,,Kami pergi ke restoran terkenal,\Nand hanya kami di sana.
Dialog: 0,0:02:50.87,0:02:53.02, Lalai,,0,0,0,,Apabila kami pergi ke taman hiburan,
Dialog: 0,0:02:53.04,0:02:54.85, Lalai,,0,0,0,, tiada orang lain berada di tempat yang besar itu...
Dialog: 0,0:02:54.88,0:02:57.37, Lalai,,0,0,0,,kecuali kami.
Dialog: 0,0:02:59.13,0:03:00.83, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:03:08.18,0:03:10.09,Lalai,,0,0,0,,Sebut saja...
Dialog: 0,0:03:10.56,0:03:14.18,Lalai,,0,0,0,,Oleh kerana alam semesta berada di pihak kita...
Dialog: 0,0:03:16.65,0:03:18.35, Lalai,,0,0,0,,Adakah anda...
Dialog: 0,0:03:19.99,0:03:21.69,Lalai,,0,0,0,,kahwin dengan saya?
Dialog: 0,0:04:35.40,0:04:37.10,Lalai,,0,0,0,,Adakah anda menangis?
Dialog: 0,0:04:40.40,0:04:42.10,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:04:44.61,0:04:46.77, Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,0:04:55.00,0:04:56.87, Lalai,,0,0,0,,Adakah anda begitu risau?
Dialog: 0,0:05:01.88,0:05:03.87, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:05:09.51,0:05:11.21, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:05:13.39,0:05:15.09,Lalai,,0,0,0,,Saya sayang awak.
Dialog: 0,0:05:44.51,0:05:46.25, Lalai,,0,0,0,,Saya harap...
Dialog: 0,0:05:47.97,0:05:50.42, Lalai,,0,0,0,,saat ini tidak akan berakhir.
Dialog: 0,0:05:51.55,0:05:54.34, Lalai,,0,0,0,,Saya harap awak teruskan...
Dialog: 0,0:05:54.64,0:05:57.22,Lalai,,0,0,0,,untuk tersenyum kepada saya...
Dialog: 0,0:05:58.73,0:06:00.46, Lalai,,0,0,0,,tanpa mengetahui kebenaran.
Dialog: 0,0:06:00.48,0:06:02.79, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:06:02.82,0:06:04.56, Lalai,,0,0,0,,Apa yang saya tidak tahu?
Dialog: 0,0:06:10.95,0:06:12.94, Lalai,,0,0,0,,Jangan terkejut.
Dialog: 0,0:06:19.83,0:06:22.16, Lalai,,0,0,0,,Kami sudah pergi ke Jerman.
Dialog: 0,0:06:31.22,0:06:33.00, Lalai,,0,0,0,,Kami lakukan?
Dialog: 0,0:06:35.93,0:06:38.18, Lalai,,0,0,0,,Saya sudah menerima rawatan?
Dialog: 0,0:06:39.02,0:06:40.72, Lalai,,0,0,0,,No.
Dialog: 0,0:06:41.23,0:06:43.76, Lalai,,0,0,0,,Anda belum bersedia.
Dialog: 0,0:06:49.40,0:06:51.27, Lalai,,0,0,0,,Saya terkedu.
Dialog: 0,0:06:52.70,0:06:54.86, Lalai,,0,0,0,,Bagaimana saya boleh melupakannya?
Dialog: 0,0:06:57.04,0:07:00.35, Lalai,,0,0,0,,Bagaimana jika saya kehilangan semua ingatan saya?
Dialog: 0,0:07:00.37,0:07:03.62,Lalai,,0,0,0,,Saya sudah sakit seperti itu. Itu akan menjadi sangat tidak adil.
Dialog: 0,0:07:06.59,0:07:08.29, Lalai,,0,0,0,,Ada masanya...
Dialog: 0,0:07:09.55,0:07:12.75, Lalai,,0,0,0,,apabila orang lupa sepenuhnya,
Dialog: 0,0:07:13.26,0:07:15.25, Lalai,,0,0,0,, walaupun mereka tidak sakit.
Dialog: 0,0:07:19.10,0:07:21.30, Lalai,,0,0,0,,Saya pun sama.
Dialog: 0,0:07:23.81,0:07:25.56, Lalai,,0,0,0,,Saya sudah lupa semuanya.
Dialog: 0,0:07:26.65,0:07:28.35, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:07:28.48,0:07:29.63, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:07:29.65,0:07:32.86, Lalai,,0,0,0,,Adakah ada perkara lain yang saya terlupa?
Dialog: 0,0:07:36.87,0:07:40.24,Lalai,,0,0,0,,Saya akan ceraikan awak...
Dialog: 0,0:07:41.21,0:07:43.53, Lalai,,0,0,0,,tanpa memberitahu anda terlebih dahulu.
Dialog: 0,0:07:46.04,0:07:47.74,Lalai,,0,0,0,,Apa?
Dialog: 0,0:07:48.30,0:07:50.91, Lalai,,0,0,0,,Dan anda mendapat tahu di Jerman,
Dialog: 0,0:07:51.88,0:07:54.63, Lalai,,0,0,0,,jadi ia agak sukar untuk kami kebelakangan ini.
Dialog: 0,0:07:55.80,0:07:57.71,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:07:57.97,0:08:00.26, Lalai,,0,0,0,,anda akan pergi...
Dialog: 0,0:08:00.56,0:08:02.93, Lalai,,0,0,0,,untuk menceraikan saya?
Dialog: 0,0:08:03.19,0:08:04.89, Lalai,,0,0,0,,Ya.
Dialog: 0,0:08:08.11,0:08:10.85, Lalai,,0,0,0,,Dan saya tahu?
Dialog: 0,0:08:11.32,0:08:13.02, Lalai,,0,0,0,,Ya.
Dialog: 0,0:08:14.07,0:08:15.77, Lalai,,0,0,0,,Jangan berbohong.
Dialog: 0,0:08:16.12,0:08:17.82, Lalai,,0,0,0,,Jika itu benar,
Dialog: 0,0:08:18.08,0:08:20.64, Lalai,,0,0,0,, maka anda tidak akan berada di sini sekarang.
Dialog: 0,0:08:20.66,0:08:23.86, Lalai,,0,0,0,,Saya akan patahkan tulang awak\Tidak pula pecah gegendang telinga awak.
Dialog: 0,0:08:23.92,0:08:25.98, Lalai,,0,0,0,,- Hae-in...\N- Patutkah saya berbuat demikian sekarang?
Dialog: 0,0:08:26.00,0:08:28.31, Lalai,,0,0,0,,Saya tidak tahu apa yang sedang berlaku.
Dialog: 0,0:08:28.34,0:08:30.70, Lalai,,0,0,0,, Kemudian cuba ingat...
Dialog: 0,0:08:31.34,0:08:34.21, Lalai,,0,0,0,,apa yang saya lakukan kepada awak,
Dialog: 0,0:08:36.14,0:08:39.16, Lalai,,0,0,0,, dan betapa anda membenci saya.
Dialog: 0,0:08:39.18,0:08:43.76, Lalai,,0,0,0,,Tidak, saya benar-benar tidak ingat...
Dialog: 0,0:08:44.35,0:08:45.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi, anda tidak akan bersusah payah mencuba lagi?{\c}{\i0}
Dialog: 0,0:08:45.94,0:08:48.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan berterima kasih jika anda\N menceraikan saya tanpa memfailkan saman.{\c}{\i0}
Dialog: 0,0:08:48.40,0:08:50.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Walaupun begitu, tidak dapat ditanggung bersama anda.{\c}{\i0}
Dialog: 0,0:08:50.32,0:08:51.89, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in.{\c}{\i0}
Dialog: 0,0:08:52.69,0:08:55.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tahu jenis orang anda.{\c}{\i0}
Dialog: 0,0:08:55.40,0:08:57.01, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak hairanlah saya memilih untuk berbuat demikian.{\c}{\i0}
Dialog: 0,0:08:57.03,0:08:58.76, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya boleh hidup...{\c}{\i0}
Dialog: 0,0:08:58.78,0:09:00.13,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kehidupan yang selesa dan kaya,{\c}{\i0}
Dialog: 0,0:09:00.16,0:09:01.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kerana saya benci tinggal dengan awak...{\c}{\i0}
Dialog: 0,0:09:01.83,0:09:03.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}lebih daripada segala-galanya!{\c}{\i0}
Dialog: 0,0:09:03.16,0:09:05.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apabila saya dengar awak akan mati tidak lama lagi,{\c}{\i0}
Dialog: 0,0:09:05.54,0:09:06.68,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya berasa lega jauh di lubuk hati.{\c}{\i0}
Dialog: 0,0:09:06.71,0:09:09.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kami akan bercerai bersih jika saya bersabar\Ndengan anda selama tiga bulan akan datang,{\c}{\i0}
Dialog: 0,0:09:09.86,0:09:11.56, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi jika anda memilih...{\c}{\i0}
Dialog: 0,0:09:11.59,0:09:14.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}untuk tidak mengambil sebarang tindakan\Nat semua dan ceraikan saya sahaja,{\c}{\i0}
Dialog: 0,0:09:14.26,0:09:15.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kemudian jujurnya,{\c}{\i0}
Dialog: 0,0:09:15.55,0:09:17.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya amat berterima kasih.{\c}{\i0}
Dialog: 0,0:09:17.64,0:09:19.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda akan melakukannya?{\c}{\i0}
Dialog: 0,0:09:31.19,0:09:33.85, Lalai,,0,0,0,,- Hae-in...\N- Berhenti. Saya ingat sekarang.
Dialog: 0,0:09:35.61,0:09:39.15,Lalai,,0,0,0,,Saya ingat betapa awak hina saya,
Dialog: 0,0:09:39.91,0:09:42.82, Lalai,,0,0,0,, dan betapa sengsaranya hidup anda.
Dialog: 0,0:09:43.08,0:09:44.82, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:09:45.29,0:09:47.39,Lalai,,0,0,0,,Adakah anda fikir anda akan hidup dengan selesa...
Dialog: 0,0:09:47.42,0:09:50.70,Lalai,,0,0,0,,jika anda berkahwin dengan saya, tetapi mendapati\Bukankah itu berlaku?
Dialog: 0,0:09:51.84,0:09:54.33, Lalai,,0,0,0,,Mestilah menghiburkan...
Dialog: 0,0:09:54.38,0:09:57.87, Lalai,,0,0,0,,untuk melihat saya tidak ingat\Tiada apa-apa dan bercakap kosong.
Dialog: 0,0:09:58.13,0:09:59.78, Lalai,,0,0,0,,No.
Dialog: 0,0:09:59.80,0:10:02.55,Lalai,,0,0,0,,- Saya tidak...\N- Saya juga sengsara!
Dialog: 0,0:10:03.85,0:10:05.55, Lalai,,0,0,0,,Bukan anda sahaja.
Dialog: 0,0:10:05.89,0:10:07.63, Lalai,,0,0,0,,Saya juga sengsara.
Dialog: 0,0:10:10.52,0:10:12.87, Lalai,,0,0,0,,Saya tidak boleh menghabiskan sisa hidup saya...
Dialog: 0,0:10:12.90,0:10:14.59, Lalai,,0,0,0,, di sebelah anda.
Dialog: 0,0:10:14.61,0:10:17.85, Lalai,,0,0,0,,- Hae-in, tunggu.\N- Mari berpisah.
Dialog: 0,0:10:21.91,0:10:23.69,Lalai,,0,0,0,,Saya mahu cerai.
Dialog: 0,0:10:43.14,0:10:44.54,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 8{\c}{\i0}
Dialog: 0,0:10:47.10,0:10:48.75, Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Penggera{\c}{\i0}
Dialog: 0,0:11:08.95,0:11:11.31,Lalai,,0,0,0,,{\an8}Ini adalah perceraian secara suka sama suka,
Dialog: 0,0:11:11.33,0:11:14.66,Lalai,,0,0,0,,{\an8}jadi kenapa kita ada di sini, sedangkan awak\Nak bercerai tanpa sebarang nafkah?
Dialog: 0,0:11:14.71,0:11:16.61, Lalai,,0,0,0,,{\an8}Siapa peguam mereka?
Dialog: 0,0:11:16.63,0:11:18.15,Lalai,,0,0,0,,{\an8}Saya tidak pasti.
Dialog: 0,0:11:18.17,0:11:21.92, Lalai,,0,0,0,,{\an8}Ini tidak sesuai dengan saya.
Dialog: 0,0:11:56.25,0:11:59.54,Lalai,,0,0,0,,Mestilah dia. Dia mesti peguam perceraiannya.
Dialog: 0,0:12:01.09,0:12:04.03,Lalai,,0,0,0,,- Jadi?\N- Awak tak tahu apa-apa, kan?
Dialog: 0,0:12:04.05,0:12:05.86, Lalai,,0,0,0,,Dia...
Dialog: 0,0:12:05.89,0:12:06.86, Lalai,,0,0,0,,lelaki yang menakutkan.
Dialog: 0,0:12:06.89,0:12:09.84, Lalai,,0,0,0,,Dia hanya seorang peguam.
Dialog: 0,0:12:10.72,0:12:13.75,Lalai,,0,0,0,,{\i1}Terdapat banyak khabar angin tentang siapa dia.{\i0}
Dialog: 0,0:12:13.77,0:12:15.64, Lalai,,0,0,0,,{\i1}Waris bongsu keluarga konglomerat.{\i0}
Dialog: 0,0:12:15.66,0:12:17.58,Lalai,,0,0,0,,{\i1}Seorang bekas tentera yang ditempatkan di luar negara.{\i0}
Dialog: 0,0:12:17.61,0:12:19.75,Lalai,,0,0,0,,{\i1}Seseorang yang datang ke sini dengan kapal angkasa.{\i0}
Dialog: 0,0:12:19.78,0:12:22.71,Lalai,,0,0,0,,{\i1}Orang lain mengatakan dia serigala jadian.{\i0}
Dialog: 0,0:12:22.74,0:12:25.26,Lalai,,0,0,0,,{\i1}Namanya Vincenzo,{\i0}
Dialog: 0,0:12:25.28,0:12:27.19,Lalai,,0,0,0,,{\i1}dan dia...{\i0}
Dialog: 0,0:12:27.58,0:12:28.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sila tunjukkan belas kasihan.{\c}{\i0}
Dialog: 0,0:12:28.91,0:12:30.35, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tolong selamatkan kami.{\c}{\i0}
Dialog: 0,0:12:30.37,0:12:31.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Tolong.\N- Tolong.{\c}{\i0}
Dialog: 0,0:12:31.37,0:12:33.95, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Sekali ini sahaja.\N- Tolong selamatkan kami.{\c}{\i0}
Dialog: 0,0:12:35.58,0:12:36.64,Lalai,,0,0,0,,{\i1}Dia daripada mafia.{\i0}
Dialog: 0,0:12:36.67,0:12:38.27, Lalai,,0,0,0,,Mafia?
Dialog: 0,0:12:38.29,0:12:40.77, Lalai,,0,0,0,,Maksud anda mafia dari permainan "Mafia" itu?
Dialog: 0,0:12:40.80,0:12:43.98,Lalai,,0,0,0,,Tidak, mafia sebenar, dan dia seorang consigliere.
Dialog: 0,0:12:44.01,0:12:46.13, Lalai,,0,0,0,,Dia bos.
Dialog: 0,0:12:46.18,0:12:48.61, Lalai,,0,0,0,,Saya fikir dia berada di Itali.
Dialog: 0,0:12:48.64,0:12:50.91, Lalai,,0,0,0,,Saya dengar...
Dialog: 0,0:12:50.93,0:12:53.55, Lalai,,0,0,0,,dia tidak berunding dengan kata-kata.
Dialog: 0,0:12:54.06,0:12:56.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak layak diberi alasan.{\c}{\i0}
Dialog: 0,0:13:18.42,0:13:21.81,Lalai,,0,0,0,,{\i1}Saya rasa Cik Hong telah memutuskan untuk tidak memaafkan kamu.{\i0}
Dialog: 0,0:13:21.84,0:13:25.53,Lalai,,0,0,0,,Sejujurnya, apa yang anda\N lakukan terhadapnya amat menjengkelkan.
Dialog: 0,0:13:25.55,0:13:28.50,Lalai,,0,0,0,,Awak tipu dia supaya fikir awak sedang jatuh cinta.
Dialog: 0,0:13:28.89,0:13:30.86, Lalai,,0,0,0,,Anda memberitahu saya...
Dialog: 0,0:13:30.89,0:13:32.59,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:13:33.14,0:13:35.63, Lalai,,0,0,0,,Dia mungkin mahu kamu mati.
Dialog: 0,0:13:35.73,0:13:39.26,Lalai,,0,0,0,,{\i1}Hae-in, tolong lepaskan saya sekali ini!{\i0}
Dialog: 0,0:13:40.06,0:13:42.29,Lalai,,0,0,0,,{\i1}En. Baek, awak menipu pelanggan saya.{\i0}
Dialog: 0,0:13:42.32,0:13:45.48,Lalai,,0,0,0,,{\i1}Beberapa surat cerai\Ntidak akan menebusnya.{\i0}
Dialog: 0,0:13:47.53,0:13:51.52,Lalai,,0,0,0,,{\i1}Maaf saya katakan ini, tetapi kejahatan\Nharus dibalas dengan kejahatan.{\i0}
Dialog: 0,0:13:52.20,0:13:55.11,Lalai,,0,0,0,,{\i1}Tidak!{\i0}
Dialog: 0,0:13:56.46,0:13:57.89,Lalai,,0,0,0,,{\i1}Hae-in, itu Yang-gi.{\i0}
Dialog: 0,0:13:57.92,0:14:00.52,Lalai,,0,0,0,,{\i1}Dia menyuruh saya melakukan ini.{\i0}
Dialog: 0,0:14:00.54,0:14:02.24,Lalai,,0,0,0,,{\i1}Si brengsek itu...!{\i0}
Dialog: 0,0:14:03.05,0:14:04.96,Lalai,,0,0,0,,Itu rancangan dia.
Dialog: 0,0:14:05.13,0:14:06.83, Lalai,,0,0,0,, Senyap.
Dialog: 0,0:14:07.34,0:14:08.94, Lalai,,0,0,0,,Bolehkah saya pergi?
Dialog: 0,0:14:08.97,0:14:10.74,Lalai,,0,0,0,,Saya mempunyai keluarga.
Dialog: 0,0:14:10.76,0:14:14.55,Lalai,,0,0,0,,Anda tidak mempunyai anak dan tidak akan\Mendapat isteri juga tidak lama lagi.
Dialog: 0,0:14:15.60,0:14:17.55, Lalai,,0,0,0,,Lakukan sesuka hati.
Dialog: 0,0:14:18.23,0:14:20.30, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:14:29.15,0:14:31.27,Lalai,,0,0,0,,Pertama sekali, harap maklum...
Dialog: 0,0:14:31.32,0:14:34.07, Lalai,,0,0,0,, bahawa saya tidak di sini untuk berunding.
Dialog: 0,0:14:46.76,0:14:49.36,Lalai,,0,0,0,,Itu kertas rasmi\Nmengenai penceraian...
Dialog: 0,0:14:49.38,0:14:51.36,Lalai,,0,0,0,,yang Encik Baek sediakan. Betul ke?
Dialog: 0,0:14:51.39,0:14:52.99,Lalai,,0,0,0,,Ya.
Dialog: 0,0:14:53.01,0:14:54.61, Lalai,,0,0,0,,- Apa salahnya?\N- Tengoklah.
Dialog: 0,0:14:54.64,0:14:56.88,Lalai,,0,0,0,,Dia menulis sebab utama perceraian...
Dialog: 0,0:14:57.52,0:15:00.26, Lalai,,0,0,0,,sebagai "perbezaan yang tidak dapat didamaikan."
Dialog: 0,0:15:01.90,0:15:03.76, Lalai,,0,0,0,,Ini sialan...
Dialog: 0,0:15:04.52,0:15:06.27, Lalai,,0,0,0,,nutjobs.
Dialog: 0,0:15:08.28,0:15:12.27,Lalai,,0,0,0,,Bukankah itu sebab yang paling mudah dan optimum?
Dialog: 0,0:15:15.78,0:15:17.05, Lalai,,0,0,0,, Tengok dia.
Dialog: 0,0:15:17.08,0:15:20.31,Lalai,,0,0,0,,Dia seorang wanita kaya yang terkenal kerana ketampanannya.
Dialog: 0,0:15:20.33,0:15:22.85,Lalai,,0,0,0,,Ketua Pegawai Eksekutif gedung serbaneka ini\Ndilahirkan dalam keluarga kaya.
Dialog: 0,0:15:22.88,0:15:25.48,Lalai,,0,0,0,,Tabloid dan khabar angin membuat\Ndia adalah seseorang yang bongkak,
Dialog: 0,0:15:25.50,0:15:28.58, Lalai,,0,0,0,,dan dia ahli Kelab One Billion.
Dialog: 0,0:15:30.67,0:15:32.38, Lalai,,0,0,0,,Belum.
Dialog: 0,0:15:35.14,0:15:37.70, Lalai,,0,0,0,,Nah, belum lagi.
Dialog: 0,0:15:37.72,0:15:39.49,Lalai,,0,0,0,,Bagaimanapun, memandangkan fakta ini,
Dialog: 0,0:15:39.52,0:15:42.66,Lalai,,0,0,0,,tidak ramai yang akan menyangka\N personalitinya adalah kekuatannya,
Dialog: 0,0:15:42.69,0:15:44.72, Lalai,,0,0,0,,dan sekarang...
Dialog: 0,0:15:45.90,0:15:48.84,Lalai,,0,0,0,,dia akan bercerai dengan pengarah semata-mata...
Dialog: 0,0:15:48.86,0:15:51.31, Lalai,,0,0,0,, kerana perbezaan yang tidak dapat didamaikan?
Dialog: 0,0:15:53.36,0:15:58.15,Lalai,,0,0,0,,Takkan orang langsung fikir\Ndia mempunyai personaliti yang teruk?
Dialog: 0,0:15:58.33,0:16:00.20,Lalai,,0,0,0,,Betul.
Dialog: 0,0:16:00.33,0:16:04.45, Lalai,,0,0,0,, Kemudian apa yang perlu kami katakan?\NDAdakah anda mempunyai sebarang cadangan?
Dialog: 0,0:16:04.92,0:16:06.62, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:16:09.42,0:16:12.15, Lalai,,0,0,0, "Mereka menjadi jauh\N kerana jadual mereka yang padat."
Dialog: 0,0:16:12.17,0:16:14.50,Lalai,,0,0,0,,Tetapi mereka tinggal di bawah bumbung yang sama.
Dialog: 0,0:16:16.97,0:16:19.66, Lalai,,0,0,0, "Mereka bersetuju untuk kekal sebagai kawan baik."
Dialog: 0,0:16:19.68,0:16:21.03, Lalai,,0,0,0,,Saya rasa mereka tidak boleh.
Dialog: 0,0:16:21.06,0:16:24.43, Lalai,,0,0,0,,- "Mereka mendoakan yang terbaik untuk satu sama lain."\N- Tunggu.
Dialog: 0,0:16:24.69,0:16:26.68, Lalai,,0,0,0,,Saya tidak mahu begitu.
Dialog: 0,0:16:29.65,0:16:33.05, Lalai,,0,0,0,,Dari apa yang saya tahu, tiada pelanggan saya pernah melakukannya.
Dialog: 0,0:16:33.07,0:16:35.02, Lalai,,0,0,0,,Mereka hanya mengatakan ini.
Dialog: 0,0:16:39.08,0:16:42.45, Lalai,,0,0,0,,Anda boleh menulis apa sahaja yang anda mahu.
Dialog: 0,0:16:44.21,0:16:45.91,Lalai,,0,0,0,,Adakah anda pasti?
Dialog: 0,0:16:46.46,0:16:48.62, Lalai,,0,0,0,,Anda tidak akan menyesal?
Dialog: 0,0:16:48.98,0:16:50.68,Lalai,,0,0,0,,Betul.
Dialog: 0,0:16:51.01,0:16:53.16, Lalai,,0,0,0,, Walau apa pun,
Dialog: 0,0:16:53.34,0:16:55.88, Lalai,,0,0,0,,, bagaimanapun, ia bukan sebab sebenar.
Dialog: 0,0:17:29.04,0:17:33.62, Lalai,,0,0,0,,Mengapa anda memilih kereta bawah tanah,\N bukannya teksi atau kereta?
Dialog: 0,0:17:34.80,0:17:36.44, Lalai,,0,0,0,,Anda tahu.
Dialog: 0,0:17:36.47,0:17:40.16,Lalai,,0,0,0,,Apabila saya mengalami hari yang sukar,\Ntetapi tidak ada sesiapa untuk mengata,
Dialog: 0,0:17:40.18,0:17:41.78, Lalai,,0,0,0,,Saya ambil Baris Dua.
Dialog: 0,0:17:41.83,0:17:42.82,Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:17:42.85,0:17:45.29, Lalai,,0,0,0,,Baris ini ialah gelung,
Dialog: 0,0:17:45.31,0:17:46.95, Lalai,,0,0,0,, jadi ia mengelilingi Seoul.
Dialog: 0,0:17:46.98,0:17:50.93, Lalai,,0,0,0,,Masa berlalu dengan pantas apabila saya menonton orang.
Dialog: 0,0:17:51.19,0:17:54.00, Lalai,,0,0,0,,Saya kekal di kereta bawah tanah sehingga matahari terbenam.
Dialog: 0,0:17:54.03,0:17:57.40,Lalai,,0,0,0,,Kemudian di antara Stesen Dangsan dan Hapjeong,
Dialog: 0,0:17:59.95,0:18:03.07, Lalai,,0,0,0,,Saya dapat melihat matahari terbenam yang terbaik di Seoul.
Dialog: 0,0:18:21.97,0:18:23.28,Lalai,,0,0,0,,Cantik kan?
Dialog: 0,0:18:23.31,0:18:26.37, Lalai,,0,0,0,,Masa terbenam membantu saya melupakan...
Dialog: 0,0:18:26.39,0:18:29.16, Lalai,,0,0,0,, betapa teruknya hari yang saya lalui.
Dialog: 0,0:18:29.19,0:18:32.76, Lalai,,0,0,0,,Ia membuatkan saya mahu pulang.
Dialog: 0,0:19:08.60,0:19:10.30, Lalai,,0,0,0,,Tuan.
Dialog: 0,0:19:10.35,0:19:12.89,Lalai,,0,0,0,,Mari kita singgah ke suatu tempat.
Dialog: 0,0:19:25.16,0:19:29.82, Lalai,,0,0,0,,Dia makan sup nasi, bermain\Nbaseball, mencuci keretanya,
Dialog: 0,0:19:30.54,0:19:32.24,Lalai,,0,0,0,,lari pusingan,
Dialog: 0,0:19:32.58,0:19:34.77, Lalai,,0,0,0,, dan makan nasi sup lagi.
Dialog: 0,0:19:34.79,0:19:36.79,Lalai,,0,0,0,,Adakah itu bagus?
Dialog: 0,0:19:37.21,0:19:39.86, Lalai,,0,0,0,,Dia juga telah menggoreng daging babi. Dia makan dengan baik.
Dialog: 0,0:19:39.88,0:19:42.38, Lalai,,0,0,0,, Tengok awak. Awak berlari lagi.
Dialog: 0,0:19:45.26,0:19:47.12, Lalai,,0,0,0,,Dia berlari dengan baik.
Dialog: 0,0:19:47.14,0:19:49.22, Lalai,,0,0,0,,Apa urusan dia? Astaga.
Dialog: 0,0:19:57.07,0:19:59.79, Lalai,,0,0,0,,- Pergi perlahan-lahan. Anda akan mencederakan diri sendiri.\N- Berhati-hati.
Dialog: 0,0:19:59.82,0:20:02.44, Lalai,,0,0,0,,Saya juga.
Dialog: 0,0:20:03.49,0:20:06.07, Lalai,,0,0,0,,Mereka semua bersenam secara berpasangan,
Dialog: 0,0:20:06.24,0:20:08.69, Lalai,,0,0,0,,jadi kenapa dia berlari seorang diri?
Dialog: 0,0:20:14.96,0:20:17.08, Lalai,,0,0,0,,Adakah ini menyeronokkan?
Dialog: 0,0:20:18.05,0:20:19.87, Lalai,,0,0,0,,Benarkah?
Dialog: 0,0:20:53.00,0:20:54.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Masakan Rumah Nenek{\c}{\i0}
Dialog: 0,0:20:54.54,0:20:57.52, Lalai,,0,0,0,,Dua mangkuk nasi sup dan satu soju, tolong.
Dialog: 0,0:20:57.54,0:20:59.24, Lalai,,0,0,0,, Akan datang.
Dialog: 0,0:21:01.00,0:21:02.32, Lalai,,0,0,0,,Ia tidak akan mengambil masa yang lama.
Dialog: 0,0:21:02.34,0:21:04.29,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:21:05.18,0:21:06.92, Lalai,,0,0,0,,Apa yang anda mahukan?
Dialog: 0,0:21:07.55,0:21:10.13, Lalai,,0,0,0,,Satu mangkuk nasi sup dan satu soju.
Dialog: 0,0:21:10.26,0:21:11.95, Lalai,,0,0,0,,Apa?
Dialog: 0,0:21:11.97,0:21:15.29,Lalai,,0,0,0,,Tolong satu mangkuk nasi sup dan satu soju.
Dialog: 0,0:21:15.31,0:21:18.43, Lalai,,0,0,0,,"Satu mangkuk nasi sup dan satu soju." Okay.
Dialog: 0,0:21:29.57,0:21:31.51, Lalai,,0,0,0,,Anda tidak boleh makan {\i1}sundae{\i0} dan sup nasi...
Dialog: 0,0:21:31.54,0:21:34.58,Lalai,,0,0,0,,kerana isteri anda benci baunya,\Ntetapi anda boleh mengetepikan diri anda sekarang.
Dialog: 0,0:21:34.60,0:21:36.39, Lalai,,0,0,0,,Ini adalah faedah daripada perceraian.
Dialog: 0,0:21:36.42,0:21:39.10,Lalai,,0,0,0,,Cuma fikirkan perkara yang baik.
Dialog: 0,0:21:39.13,0:21:41.81, Lalai,,0,0,0,, Tengok. Anda tidak perlu lagi\Nbimbang tentang lelaki yang mengekori anda,
Dialog: 0,0:21:41.84,0:21:43.40, Lalai,,0,0,0,, atau terpaksa bergegas pulang.
Dialog: 0,0:21:43.42,0:21:44.73,Lalai,,0,0,0,,Anda terpaksa meninggalkan kami...
Dialog: 0,0:21:44.76,0:21:47.90,Lalai,,0,0,0,,semasa minum jika ibu mertua anda\ mahupun pengerusi memanggil anda.
Dialog: 0,0:21:47.93,0:21:52.42, Lalai,,0,0,0,, Astaga. Itulah sebabnya anda tidak bertemu kami\Selalu, dan sentiasa makan malam bersendirian.
Dialog: 0,0:21:55.64,0:21:57.20, Lalai,,0,0,0,,Saya tahu,
Dialog: 0,0:21:57.23,0:21:59.00, Lalai,,0,0,0,,tetapi saya mahukan kehidupan itu.
Dialog: 0,0:21:59.02,0:22:03.04, Lalai,,0,0,0,,Apa maksud anda? Anda mahukan itu?\NDAdakah anda menghidap sindrom Stockholm?
Dialog: 0,0:22:03.07,0:22:04.67, Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,0:22:04.69,0:22:06.56, Lalai,,0,0,0,,Saya cuma mahu...
Dialog: 0,0:22:07.11,0:22:09.86, Lalai,,0,0,0,,untuk kekal dengan Hae-in.
Dialog: 0,0:22:28.30,0:22:29.82, Lalai,,0,0,0,,Mengenai pil itu, tuan,
Dialog: 0,0:22:29.84,0:22:31.36, Lalai,,0,0,0,,Saya juga akan menghantar e-mel kepada anda,
Dialog: 0,0:22:31.39,0:22:34.57, Lalai,,0,0,0,,tetapi ia digunakan untuk merawat tumor malignan.
Dialog: 0,0:22:34.60,0:22:36.74,Lalai,,0,0,0,,{\i1}Ia adalah ubat antikanser.{\i0}
Dialog: 0,0:22:36.77,0:22:39.43,Lalai,,0,0,0,,- Adakah anda pasti?\N- {\i1}Ya, saya pasti.{\i0}
Dialog: 0,0:22:53.45,0:22:55.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:23:00.21,0:23:01.85, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Evergreen Hope Orphanage{\c}{\i0}
Dialog: 0,0:23:01.88,0:23:03.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:23:19.35,0:23:21.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hei! Anda!{\c}{\i0}
Dialog: 0,0:23:21.39,0:23:22.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda! Tidak mengapa.{\c}{\i0}
Dialog: 0,0:23:22.90,0:23:25.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak mengapa. Hei.{\c}{\i0}
Dialog: 0,0:23:25.19,0:23:26.75,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bajingan!{\c}{\i0}
Dialog: 0,0:23:26.78,0:23:28.63, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika anjing saya cedera?{\c}{\i0}
Dialog: 0,0:23:28.65,0:23:30.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda sudah gila?{\c}{\i0}
Dialog: 0,0:23:30.40,0:23:33.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda tahu betapa mahalnya anjing ini?{\c}{\i0}
Dialog: 0,0:23:33.70,0:23:36.01, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang anda lihat?\N- Hentikan.{\c}{\i0}
Dialog: 0,0:23:36.03,0:23:38.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya hampir digigit anjing awak.{\c}{\i0}
Dialog: 0,0:23:38.29,0:23:40.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dan siapa kamu?{\c}{\i0}
Dialog: 0,0:23:40.25,0:23:42.68,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidakkah mereka mengajar anda adab?{\c}{\i0}
Dialog: 0,0:23:42.71,0:23:44.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik. Hong!{\c}{\i0}
Dialog: 0,0:23:49.92,0:23:51.62, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in.{\c}{\i0}
Dialog: 0,0:23:51.84,0:23:53.24, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Atuk.{\c}{\i0}
Dialog: 0,0:23:53.26,0:23:55.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey? Adakah anda cedera?{\c}{\i0}
Dialog: 0,0:23:55.26,0:23:56.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda?{\c}{\i0}
Dialog: 0,0:23:56.93,0:23:59.53, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia cucu perempuan pengerusi\NQueens Group.{\c}{\i0}
Dialog: 0,0:23:59.56,0:24:01.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagus, saya tidak tahu.{\c}{\i0}
Dialog: 0,0:24:01.10,0:24:02.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey?{\c}{\i0}
Dialog: 0,0:24:02.89,0:24:04.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jom ke hospital.{\c}{\i0}
Dialog: 0,0:24:04.40,0:24:05.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baik?{\c}{\i0}
Dialog: 0,0:24:05.61,0:24:07.56, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kebaikan.{\c}{\i0}
Dialog: 0,0:24:37.76,0:24:39.46, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Terima kasih.{\c}{\i0}
Dialog: 0,0:25:28.56,0:25:31.42, Lalai,,0,0,0,, En. Oh, mana Hae-in?\NSdia belum pulang.
Dialog: 0,0:25:31.44,0:25:33.63, Lalai,,0,0,0,,{\i1}Dia menyuruh saya pulang.{\i0}
Dialog: 0,0:25:33.65,0:25:35.71,Lalai,,0,0,0,,{\i1}Dia turun di sekolah rendah berdekatan.{\i0}
Dialog: 0,0:25:35.74,0:25:37.38, Lalai,,0,0,0,,Anda sepatutnya memerhatikannya.
Dialog: 0,0:25:37.41,0:25:40.69,Lalai,,0,0,0,,Saya tidak dapat menjejakinya,\Nmemandangkan dia keseorangan kebelakangan ini.
Dialog: 0,0:25:40.74,0:25:42.64, Lalai,,0,0,0,,Ini bukan perkara yang kami persetujui.
Dialog: 0,0:25:42.66,0:25:44.61,Lalai,,0,0,0,,{\i1}Maaf, tuan.{\i0}
Dialog: 0,0:25:55.22,0:25:57.99, Lalai,,0,0,0,,Di manakah anda? Kenapa awak naik teksi?
Dialog: 0,0:25:58.01,0:26:00.07, Lalai,,0,0,0,,Saya terpaksa singgah di suatu tempat.
Dialog: 0,0:26:00.10,0:26:01.80, Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:26:02.51,0:26:06.09,Lalai,,0,0,0,,Adakah Encik Baek akan terus bekerja untuk anda?\NAbukankah anda tidak selesa?
Dialog: 0,0:26:07.02,0:26:10.00,Lalai,,0,0,0,,Saya tidak bercadang untuk memecatnya jika dia mahu kekal.
Dialog: 0,0:26:10.02,0:26:13.18,Lalai,,0,0,0,,Lagipun, kita perlukan dia dalam syarikat.
Dialog: 0,0:26:13.86,0:26:16.02, Lalai,,0,0,0,,Orang yang Ratu sangat perlukan...
Dialog: 0,0:26:18.14,0:26:19.84, Lalai,,0,0,0,,adalah saya,
Dialog: 0,0:26:20.55,0:26:22.25, Lalai,,0,0,0,,dan saya juga...
Dialog: 0,0:26:22.66,0:26:24.36, Lalai,,0,0,0,, yang anda perlukan.
Dialog: 0,0:26:25.00,0:26:27.61, Lalai,,0,0,0,, Adakah saya masih perlu membuktikannya?
Dialog: 0,0:26:31.13,0:26:34.50,Lalai,,0,0,0,,Saya akan memberitahu anda kemudian,
Dialog: 0,0:26:34.63,0:26:36.19, Lalai,,0,0,0,,tetapi saya hanya akan menyatakannya sekarang.
Dialog: 0,0:26:36.21,0:26:38.58, Lalai,,0,0,0,,Saya berfikir panjang dan keras.
Dialog: 0,0:26:38.72,0:26:40.67, Lalai,,0,0,0,,Saya akan terlepas...
Dialog: 0,0:26:41.01,0:26:42.53, Lalai,,0,0,0,, pada Hercyna.
Dialog: 0,0:26:42.55,0:26:44.42,Lalai,,0,0,0,,Apa?
Dialog: 0,0:26:45.02,0:26:47.83, Lalai,,0,0,0,,Saya menghargai semua bantuan yang anda berikan kepada saya,
Dialog: 0,0:26:47.85,0:26:50.12,Lalai,,0,0,0,,tetapi En. Hermann memilih kedai kami...
Dialog: 0,0:26:50.15,0:26:53.42,Lalai,,0,0,0,,kerana awak, bukan saya.
Dialog: 0,0:26:53.44,0:26:56.67,Lalai,,0,0,0,,Saya mahu menggunakan awak kerana tamak,
Dialog: 0,0:26:56.69,0:26:59.09, Lalai,,0,0,0,,- tetapi itu...\N- Kemudian lakukan itu.
Dialog: 0,0:26:59.11,0:27:00.59, Lalai,,0,0,0,,Itulah sebabnya saya di sini.
Dialog: 0,0:27:00.61,0:27:04.44,Lalai,,0,0,0,,Adakah anda tahu apa yang saya telah lakukan dalam hidup\Nuntuk menjadi seseorang yang berguna kepada anda?
Dialog: 0,0:27:05.95,0:27:07.65, Lalai,,0,0,0,,Adakah saya perlu tahu?
Dialog: 0,0:27:11.83,0:27:12.81, Lalai,,0,0,0,, Hae-in.
Dialog: 0,0:27:12.83,0:27:16.90,Lalai,,0,0,0,,Saya tidak akan meminta apa-apa kepada anda,\Walaupun anda memilih Hercyna.
Dialog: 0,0:27:16.92,0:27:20.21,Lalai,,0,0,0,,Apa yang saya mahu lakukan ialah tunjukkan kepada anda...
Dialog: 0,0:27:20.97,0:27:24.13, Lalai,,0,0,0,,Saya boleh memberikan anda segala-galanya...
Dialog: 0,0:27:24.85,0:27:26.55, Lalai,,0,0,0,,orang lain tidak dapat.
Dialog: 0,0:27:29.23,0:27:33.47,Lalai,,0,0,0,,Awak berterus-terang sejak saya bercerai sekarang,
Dialog: 0,0:27:33.77,0:27:35.51, Lalai,,0,0,0,,tetapi dengar.
Dialog: 0,0:27:35.90,0:27:38.54,Lalai,,0,0,0,,Saya tak ceraikan dia supaya awak boleh ada peluang.
Dialog: 0,0:27:38.57,0:27:42.69,Lalai,,0,0,0,,Saya berkahwin dengan Hyun-woo kerana\Ndia kata dia akan tetap dengan saya,
Dialog: 0,0:27:43.03,0:27:47.11,Lalai,,0,0,0,,dan saya menceraikannya kerana\NI berasa buruk tentang segala-galanya...
Dialog: 0,0:27:47.79,0:27:49.49,Lalai,,0,0,0,,dia terpaksa lalui.
Dialog: 0,0:27:51.71,0:27:54.12, Lalai,,0,0,0,,Bolehkah anda mengatakan perkara yang sama,
Dialog: 0,0:27:54.50,0:27:56.52, Lalai,,0,0,0,, walaupun anda kehilangan segala-galanya?
Dialog: 0,0:27:56.54,0:27:58.91, Lalai,,0,0,0,,- Apa?\N- Walaupun begitu?
Dialog: 0,0:28:00.05,0:28:01.75, Lalai,,0,0,0,,Anda tidak memerlukan saya?
Dialog: 0,0:28:03.39,0:28:05.54, Lalai,,0,0,0,,Adakah anda baru pulang ke rumah?
Dialog: 0,0:28:36.75,0:28:39.81,Lalai,,0,0,0,,Anda telah melalui begitu banyak, puan.
Dialog: 0,0:28:39.84,0:28:43.36, Lalai,,0,0,0,,- Dia sentiasa mengganggu.\N- Dan dia masih begitu.
Dialog: 0,0:28:43.38,0:28:46.49,Lalai,,0,0,0,,Kenapa Hyun-woo tidak berhenti kerja?
Dialog: 0,0:28:46.51,0:28:48.59, Lalai,,0,0,0,,Anda patut memecatnya.
Dialog: 0,0:28:49.01,0:28:52.76,Lalai,,0,0,0,,Ibu, jika ada satu perkara\NI tidak boleh lakukan, itu mengakalinya.
Dialog: 0,0:28:52.98,0:28:55.18, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:28:55.40,0:28:57.83, Lalai,,0,0,0,,Dia menceraikannya tanpa mengambil sebarang wang.
Dialog: 0,0:28:57.86,0:28:59.50,Lalai,,0,0,0,,Bagaimana jika kita memprovokasi dia,
Dialog: 0,0:28:59.52,0:29:02.63, Lalai,,0,0,0,,dan dia menggunakan otak\N pintarnya itu untuk mendapatkan nafkah?
Dialog: 0,0:29:02.65,0:29:06.84, Lalai,,0,0,0,,Tetapi, pengarah yang sah mempunyai banyak kuasa.
Dialog: 0,0:29:06.87,0:29:09.51, Lalai,,0,0,0,,Tidakkah anda berasa tidak senang\Nbahawa dia masih mempunyai kuasa itu?
Dialog: 0,0:29:09.53,0:29:11.51, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:29:11.54,0:29:14.66,Lalai,,0,0,0,,Itulah sebabnya anda harus menyingkirkan dia.
Dialog: 0,0:29:16.37,0:29:19.16, Lalai,,0,0,0,,Ya ampun, kenapa dia telefon saya?
Dialog: 0,0:29:20.59,0:29:23.00, Lalai,,0,0,0,,Anda tiada pelanggan. bagus.
Dialog: 0,0:29:23.05,0:29:25.11, Lalai,,0,0,0,,Ibu, kenapa kamu di sini?
Dialog: 0,0:29:25.13,0:29:28.53,Lalai,,0,0,0,,Saya mahu kelihatan seperti ahli politik wanita.
Dialog: 0,0:29:28.55,0:29:30.53, Lalai,,0,0,0,,- Jadikan saya satu.\N- Apa?
Dialog: 0,0:29:30.56,0:29:33.28, Lalai,,0,0,0,,Anda tahu gaya rambut mereka ada...
Dialog: 0,0:29:33.31,0:29:35.95, Lalai,,0,0,0,,semasa memberi permohonan maaf secara terbuka untuk menunjukkan bahawa...
Dialog: 0,0:29:35.98,0:29:37.79, Lalai,,0,0,0,, mereka minta maaf?
Dialog: 0,0:29:37.81,0:29:42.21, Lalai,,0,0,0,,Tetapi saya tidak mahu kelihatan budak.
Dialog: 0,0:29:42.23,0:29:44.55, Lalai,,0,0,0,,- Tiada gaya rambut sebegitu.\N- Ayuh!
Dialog: 0,0:29:44.57,0:29:48.09, Lalai,,0,0,0,, Berikan rambut saya sedikit poof seperti ini.
Dialog: 0,0:29:48.11,0:29:50.22, Lalai,,0,0,0,,Saya faham. Poof.
Dialog: 0,0:29:50.24,0:29:54.07, Lalai,,0,0,0,,Ya, saya perlukan sedikit kotoran untuk kelihatan yakin.
Dialog: 0,0:29:58.71,0:30:01.10, Lalai,,0,0,0,,Saya berasa teruk...
Dialog: 0,0:30:01.13,0:30:03.19, Lalai,,0,0,0,,selepas panggilan kami sebelum ini.
Dialog: 0,0:30:03.21,0:30:06.11,Lalai,,0,0,0,,Perkahwinan adalah\Njanji yang paling penting dalam hidup seseorang.
Dialog: 0,0:30:06.13,0:30:09.15,Lalai,,0,0,0,,Hae-in pasti sangat kecewa.
Dialog: 0,0:30:09.18,0:30:14.30,Lalai,,0,0,0,,Saya pasti anda dan suami anda\Nterdiam juga.
Dialog: 0,0:30:14.47,0:30:17.04, Lalai,,0,0,0,,Saya sepatutnya mengajar anak saya dengan lebih baik.
Dialog: 0,0:30:17.06,0:30:19.47, Lalai,,0,0,0,,Saya benar-benar minta maaf.
Dialog: 0,0:30:21.69,0:30:23.71, Lalai,,0,0,0,,- Adakah ini skema?\N- Maaf?
Dialog: 0,0:30:23.73,0:30:27.09,Lalai,,0,0,0,,Adakah anak peguam kamu menyuruh kamu\Lakukan ini supaya dia mendapat nafkah,
Dialog: 0,0:30:27.11,0:30:28.88, Lalai,,0,0,0,,dan sebahagian daripada kekayaan Hae-in?
Dialog: 0,0:30:28.91,0:30:30.26, Lalai,,0,0,0,,Maaf?
Dialog: 0,0:30:30.28,0:30:32.64, Lalai,,0,0,0,,Jangan beritahu saya anda sedang merakam ini.
Dialog: 0,0:30:32.66,0:30:36.06, Lalai,,0,0,0,,Anda tidak boleh menggunakan rakaman ini di mahkamah,\Nmemandangkan saya tidak bersetuju dengannya.
Dialog: 0,0:30:36.08,0:30:38.93, Lalai,,0,0,0,,Rakaman? Mengapa saya melakukan perkara sedemikian?
Dialog: 0,0:30:38.96,0:30:41.52, Lalai,,0,0,0,,Mengapa anda tidak? Malah anak anda melakukannya.
Dialog: 0,0:30:41.54,0:30:43.60, Lalai,,0,0,0,,- Hyun-woo?\N- Ya.
Dialog: 0,0:30:43.63,0:30:47.02, Lalai,,0,0,0,,Dia menyamun bilik pengerusi kami.
Dialog: 0,0:30:47.05,0:30:49.90,Lalai,,0,0,0,,Saya tidak tahu sama ada dia mahu menjual rakaman itu,
Dialog: 0,0:30:49.93,0:30:53.61, Lalai,,0,0,0,, atau gunakannya terhadap Hae-in untuk perceraian mereka.
Dialog: 0,0:30:53.64,0:30:56.74, Lalai,,0,0,0,,Apa yang dia cakap? Adakah dia mengakuinya?
Dialog: 0,0:30:56.77,0:30:59.58,Lalai,,0,0,0,,- Dia menafikannya.\N- Maka itulah kebenarannya.
Dialog: 0,0:30:59.60,0:31:02.33, Lalai,,0,0,0,,Adakah ia penting lagi?
Dialog: 0,0:31:02.36,0:31:04.22,Lalai,,0,0,0,,Mereka sudah bercerai sekarang.
Dialog: 0,0:31:06.57,0:31:08.81, Lalai,,0,0,0,,Saya rasa anda tidak tahu.
Dialog: 0,0:31:09.20,0:31:13.68,Lalai,,0,0,0,,Inilah sebabnya sesetengah orang\Ntidak patut berkahwin antara satu sama lain.
Dialog: 0,0:31:13.70,0:31:15.68,Lalai,,0,0,0,,Mereka hanya akan menjatuhkan satu sama lain.
Dialog: 0,0:31:15.70,0:31:19.20,Lalai,,0,0,0,,Itulah sebabnya saya menentang mereka sekeras-kerasnya.
Dialog: 0,0:31:22.88,0:31:24.94,Lalai,,0,0,0,,Anda mungkin menentang mereka,
Dialog: 0,0:31:24.96,0:31:29.96,Lalai,,0,0,0,,tetapi mereka cukup berkongsi\Nkenangan bahagia untuk berkahwin.
Dialog: 0,0:31:30.17,0:31:31.24, Lalai,,0,0,0,,Apa?
Dialog: 0,0:31:31.26,0:31:33.95, Lalai,,0,0,0,,Saya sedar bahawa hidup mungkin kelihatan panjang,
Dialog: 0,0:31:33.97,0:31:37.38, Lalai,,0,0,0,,tetapi kenangan gembira adalah terhad.
Dialog: 0,0:31:38.10,0:31:39.08, Lalai,,0,0,0,,Jadi?
Dialog: 0,0:31:39.10,0:31:41.08, Lalai,,0,0,0,,Mereka mungkin telah berpisah,
Dialog: 0,0:31:41.10,0:31:43.08, Lalai,,0,0,0,,tetapi saya harap...
Dialog: 0,0:31:43.10,0:31:45.42,Lalai,,0,0,0,,mereka akan tetap menghargai...
Dialog: 0,0:31:45.44,0:31:49.17,Lalai,,0,0,0,,kenangan bahagia itu.
Dialog: 0,0:31:49.19,0:31:51.09, Lalai,,0,0,0,,Itu idea yang bagus.
Dialog: 0,0:31:51.11,0:31:53.67,Lalai,,0,0,0,,Perceraian telah pun diselesaikan,
Dialog: 0,0:31:53.70,0:31:59.31,Lalai,,0,0,0,,jadi saya harap keluarga anda tidak akan\Ncuba mendapatkan apa-apa daripadanya.
Dialog: 0,0:31:59.33,0:32:03.27,Lalai,,0,0,0,,Juga, sila pujuk dia untuk berhenti kerja.
Dialog: 0,0:32:03.29,0:32:06.95, Lalai,,0,0,0,,Kenapa dia tidak? Dia sangat menyedihkan.
Dialog: 0,0:32:07.42,0:32:10.96,Lalai,,0,0,0,,Saya harap kita tidak akan berjumpa lagi.
Dialog: 0,0:32:22.52,0:32:25.04, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:32:25.06,0:32:27.29,Lalai,,0,0,0,,Bukankah dia memberitahu siapa yang dia temui?
Dialog: 0,0:32:27.32,0:32:30.09,Lalai,,0,0,0,,Berdasarkan cara dia berpakaian\Nsebelum ke Seoul,
Dialog: 0,0:32:30.11,0:32:31.21,Lalai,,0,0,0,,mungkin itu Cik Kim.
Dialog: 0,0:32:31.24,0:32:33.94, Lalai,,0,0,0,,Kalau begitu kenapa dia tidak angkat?
Dialog: 0,0:32:35.11,0:32:37.40, Lalai,,0,0,0,,Itu dia! mak!
Dialog: 0,0:32:39.87,0:32:43.52,Lalai,,0,0,0,,Saya bagi rambut dia banyak poof, tetapi semuanya hilang.
Dialog: 0,0:32:43.54,0:32:45.04, Lalai,,0,0,0,, Pergi bersalam dengannya.
Dialog: 0,0:32:45.07,0:32:46.06, Lalai,,0,0,0,,Nenek!
Dialog: 0,0:32:46.08,0:32:49.56, Lalai,,0,0,0,,Helo, anak anjing sayang.
Dialog: 0,0:32:49.59,0:32:51.91,Lalai,,0,0,0,,- Adakah anda menunggu saya?\N- Ya.
Dialog: 0,0:32:52.72,0:32:55.79,Lalai,,0,0,0,,- Kaki saya sakit, jadi saya beli selipar.\N- Syabas.
Dialog: 0,0:32:57.05,0:33:00.01, Lalai,,0,0,0,,Saya bimbang, kerana anda tidak menjawab.
Dialog: 0,0:33:01.77,0:33:03.51,Lalai,,0,0,0,,Adakah anda sudah makan malam?
Dialog: 0,0:33:06.69,0:33:08.47, Lalai,,0,0,0,,Belum.
Dialog: 0,0:33:11.07,0:33:13.05, Lalai,,0,0,0,,Hei, pesan beberapa bahasa Cina.
Dialog: 0,0:33:13.07,0:33:16.73, Lalai,,0,0,0,,Lupakan. Kita sepatutnya mempunyai nasi.
Dialog: 0,0:33:17.82,0:33:19.47, Lalai,,0,0,0,, Dari mana saya harus memesan? Ting Hua?
Dialog: 0,0:33:19.49,0:33:20.89, Lalai,,0,0,0,,Tidak, mereka tidak bagus.
Dialog: 0,0:33:20.91,0:33:24.11, Lalai,,0,0,0,,Tembok Besar China mempunyai perkhidmatan yang lebih baik.
Dialog: 0,0:33:24.21,0:33:26.07, Lalai,,0,0,0,,Adakah anda mempunyai kupon?
Dialog: 0,0:33:28.58,0:33:30.90,Lalai,,0,0,0,,Itulah senarai pelanggan yang membeli...
Dialog: 0,0:33:30.92,0:33:33.32, Lalai,,0,0,0,,Jam tangan ulang tahun ke-101 Ronde de Frédic.
Dialog: 0,0:33:33.34,0:33:35.78,Lalai,,0,0,0,,Ada satu orang Korea.
Dialog: 0,0:33:35.80,0:33:38.63,Lalai,,0,0,0,,Bukankah dia perempuan simpanan pengerusi?
Dialog: 0,0:33:38.89,0:33:39.91, Lalai,,0,0,0,,Di manakah ia dibeli?
Dialog: 0,0:33:39.93,0:33:42.72, Lalai,,0,0,0,,Enam tahun lalu di Fifth Avenue, Manhattan.
Dialog: 0,0:33:43.73,0:33:45.62,Lalai,,0,0,0,,Ia jam tangan lelaki.
Dialog: 0,0:33:45.64,0:33:47.97,Lalai,,0,0,0,,Saya tertanya-tanya kepada siapa dia menghadiahkannya.
Dialog: 0,0:33:51.23,0:33:56.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia pergi ke suatu tempat tanpa saya\Namun dua hingga tiga kali seminggu.{\c}{\i0}
Dialog: 0,0:34:34.57,0:34:36.35, Lalai,,0,0,0,,Kereta kami...
Dialog: 0,0:34:36.61,0:34:38.51, Lalai,,0,0,0,, baik. Kami tidak terhempas.
Dialog: 0,0:34:38.53,0:34:41.09,Lalai,,0,0,0,,- Adakah ini kebetulan?\N- Tidak.
Dialog: 0,0:34:41.12,0:34:43.39,Lalai,,0,0,0,,Saya nampak awak mengikut Hae-in dari pejabat,
Dialog: 0,0:34:43.41,0:34:44.80,Lalai,,0,0,0,,jadi saya ikut awak.
Dialog: 0,0:34:44.83,0:34:47.60,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia digunakan untuk merawat tumor malignan.{\c}{\i0}
Dialog: 0,0:34:47.62,0:34:49.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia adalah ubat antikanser.{\c}{\i0}
Dialog: 0,0:34:50.00,0:34:50.98, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, saya pasti.{\c}{\i0}
Dialog: 0,0:34:51.00,0:34:53.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah seseorang yang anda kenali sakit?{\c}{\i0}
Dialog: 0,0:34:53.34,0:34:55.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Helo?{\c}{\i0}
Dialog: 0,0:34:55.30,0:34:57.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}En. Yoon?{\c}{\i0}
Dialog: 0,0:35:11.44,0:35:12.41,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Panggilan{\c}{\i0}
Dialog: 0,0:35:12.44,0:35:13.90,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:35:16.03,0:35:18.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya melaporkan kembali kepadanya setiap saat...{\c}{\i0}
Dialog: 0,0:35:18.19,0:35:20.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tentang orang yang anda temui.{\c}{\i0}
Dialog: 0,0:35:20.78,0:35:23.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia menyuruh saya menyemak\Npil ini, jadi saya bertanya kepada rakan...{\c}{\i0}
Dialog: 0,0:35:23.57,0:35:25.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}yang bekerja di sebuah syarikat farmaseutikal.{\c}{\i0}
Dialog: 0,0:35:25.91,0:35:27.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya benar-benar minta maaf.{\c}{\i0}
Dialog: 0,0:35:27.66,0:35:29.56, Lalai,,0,0,0,,Mengapa kamu mengikutinya?
Dialog: 0,0:35:29.58,0:35:31.74,Lalai,,0,0,0,,Dia bukan isteri awak lagi,
Dialog: 0,0:35:32.50,0:35:35.12, Lalai,,0,0,0,,jadi apa urusan anda?
Dialog: 0,0:35:36.55,0:35:42.29,Lalai,,0,0,0,,Lihat. Jika anda terus mengikutinya,\NI juga tidak akan berhenti mengikuti anda,
Dialog: 0,0:35:42.39,0:35:46.84,Lalai,,0,0,0,,dan jika anda cuba mencederakannya,\NI akan melakukan perkara yang sama kepada anda.
Dialog: 0,0:35:47.14,0:35:48.33, Lalai,,0,0,0,,Itu rancangan saya.
Dialog: 0,0:35:48.35,0:35:51.13, Lalai,,0,0,0,,Jadi anda mahu melindunginya.
Dialog: 0,0:35:51.19,0:35:52.33, Lalai,,0,0,0,,Lakukan sesuka hati.
Dialog: 0,0:35:52.35,0:35:55.39,Lalai,,0,0,0,,Dia akan memilih saya, bagaimanapun.
Dialog: 0,0:35:56.15,0:35:58.64, Lalai,,0,0,0,,Anda akan faham apa yang saya maksudkan tidak lama lagi.
Dialog: 0,0:36:19.59,0:36:22.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah keluarga anda berhijrah ke sana,\Anda juga tidak belajar di luar negara?{\c}{\i0}
Dialog: 0,0:36:22.76,0:36:24.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya telah diterima pakai di luar negara.{\c}{\i0}
Dialog: 0,0:36:25.09,0:36:28.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu bapa angkat saya meninggal dunia\Sejurus sebelum saya menamatkan pengajian di kolej,{\c}{\i0}
Dialog: 0,0:36:28.64,0:36:31.76, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi saya tiada keluarga sekarang.{\c}{\i0}
Dialog: 0,0:36:35.43,0:36:37.13,Lalai,,0,0,0,,Masuk.
Dialog: 0,0:36:40.40,0:36:42.55, Lalai,,0,0,0,,Eun-sung.
Dialog: 0,0:36:42.57,0:36:45.42, Lalai,,0,0,0,,Saya boleh sahaja pergi kepada awak.
Dialog: 0,0:36:45.45,0:36:47.52,Lalai,,0,0,0,,Ia adalah mendesak.
Dialog: 0,0:36:48.37,0:36:50.16,Lalai,,0,0,0,,En. Na daripada Bolt One dipanggil.
Dialog: 0,0:36:50.19,0:36:51.18,Lalai,,0,0,0,,Apa? untuk apa?
Dialog: 0,0:36:51.20,0:36:52.76,Lalai,,0,0,0,,Mengenai tanah.
Dialog: 0,0:36:52.79,0:36:55.81,Lalai,,0,0,0,,Terdapat pangkalan tentera berhampiran\Narea tempat resort itu akan dibina.
Dialog: 0,0:36:55.83,0:36:57.85,Lalai,,0,0,0,,Aduh, itukah maksudnya?
Dialog: 0,0:36:57.88,0:36:59.90,Lalai,,0,0,0,,Mereka bersetuju untuk berpindah.
Dialog: 0,0:36:59.92,0:37:03.23, Lalai,,0,0,0,,Jika tidak, stesen laser mereka akan\Nmembuat pembinaan mustahil.
Dialog: 0,0:37:03.26,0:37:05.71, Lalai,,0,0,0,,Saya dengar mereka tidak bergerak.
Dialog: 0,0:37:06.26,0:37:07.96, Lalai,,0,0,0,,Apa?
Dialog: 0,0:37:12.73,0:37:15.66, Lalai,,0,0,0,,Mengapa mereka berubah fikiran?
Dialog: 0,0:37:15.69,0:37:19.04,Lalai,,0,0,0,,MOLIT mahu berpindah, tetapi MND\Nenggan dan berkata ia akan memerlukan kos yang terlalu tinggi,
Dialog: 0,0:37:19.07,0:37:21.71, Lalai,,0,0,0,,jadi mereka membatalkan semuanya.
Dialog: 0,0:37:21.73,0:37:25.06, Lalai,,0,0,0,,Adakah MND lebih berkuasa daripada MOLIT?
Dialog: 0,0:37:26.74,0:37:28.43, Lalai,,0,0,0,,Saya tidak terlalu pasti, tuan.
Dialog: 0,0:37:28.45,0:37:30.84, Lalai,,0,0,0,,MOLIT mesti menang dalam apa jua keadaan.
Dialog: 0,0:37:30.87,0:37:33.18, Lalai,,0,0,0,,Anda masih tidak dapat menghubungi\Npengurus kanan MOLIT?
Dialog: 0,0:37:33.20,0:37:35.22,Lalai,,0,0,0,,Tidak, dia terus menghantar mesej bahawa dia sedang menghadiri mesyuarat.
Dialog: 0,0:37:35.25,0:37:38.49, Lalai,,0,0,0,,Dia tidak boleh melakukan ini kepada saya.
Dialog: 0,0:37:55.48,0:37:56.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Atuk{\c}{\i0}
Dialog: 0,0:38:17.54,0:38:18.68, Lalai,,0,0,0,,Helo?
Dialog: 0,0:38:18.71,0:38:20.66, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:38:21.63,0:38:22.73, Lalai,,0,0,0,,- Tuan.\N- Apa itu?
Dialog: 0,0:38:22.75,0:38:25.69,Lalai,,0,0,0,,- Pengerusi mahu berjumpa dengan kamu.\N- Tidak...
Dialog: 0,0:38:25.72,0:38:27.94, Lalai,,0,0,0,,Mengapa anda tidak boleh cepat cerdik?
Dialog: 0,0:38:27.97,0:38:31.60,Lalai,,0,0,0,,Tidakkah anda nampak bagaimana saya menolak panggilannya untuk pertama kali dalam hidup saya?
Dialog: 0,0:38:31.62,0:38:32.66, Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,0:38:32.68,0:38:34.87, Lalai,,0,0,0,,Anda sepatutnya membuat alasan.
Dialog: 0,0:38:34.89,0:38:38.39, Lalai,,0,0,0,,Bagaimana anda boleh katakan ya?
Dialog: 0,0:38:39.15,0:38:41.29, Lalai,,0,0,0,,Hyun-woo. Di mana dia?
Dialog: 0,0:38:41.31,0:38:43.22, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:38:44.40,0:38:47.67, Lalai,,0,0,0,,Hyun-woo, ia pasti sukar untuk anda.
Dialog: 0,0:38:47.70,0:38:49.88, Lalai,,0,0,0,,- Apa yang salah?\N- Anda tahu apa yang mereka katakan.
Dialog: 0,0:38:49.91,0:38:52.55,Lalai,,0,0,0,,Pekerja telah meletakkan jawatan\NSurat sedia sepanjang masa,
Dialog: 0,0:38:52.58,0:38:55.43,Lalai,,0,0,0,,jadi kenapa anda tidak boleh menyimpan\Nkertas cerai dalam peti besi anda?
Dialog: 0,0:38:55.45,0:38:56.97,Lalai,,0,0,0,,Bukan salah awak.
Dialog: 0,0:38:57.00,0:38:59.41, Lalai,,0,0,0,,Keluarga kami yang mencarinya.
Dialog: 0,0:39:00.00,0:39:01.31, Lalai,,0,0,0,,Apa ini?
Dialog: 0,0:39:01.33,0:39:03.40, Lalai,,0,0,0,,- Isu dengan tapak.\N- Apa?
Dialog: 0,0:39:03.42,0:39:06.73, Lalai,,0,0,0,,Pangkalan tentera perlu bergerak,\Nsupaya orang ramai boleh melawat resort kami,
Dialog: 0,0:39:06.76,0:39:09.11, Lalai,,0,0,0,,naik lif ke ruang rehat langit,
Dialog: 0,0:39:09.13,0:39:10.65, Lalai,,0,0,0,,makan stik dan wain,
Dialog: 0,0:39:10.68,0:39:15.30, Lalai,,0,0,0,,memandang bintang dan berenang di kolam infiniti,
Dialog: 0,0:39:15.51,0:39:18.20,Lalai,,0,0,0,,- tetapi mereka tidak akan bergerak.\N- Saya memberitahu anda untuk menjalankan ujian kesahan.
Dialog: 0,0:39:18.23,0:39:19.29,Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:39:19.31,0:39:22.46,Lalai,,0,0,0,,Awak memang cakap macam tu, tapi Encik Yoon\Nswoop masuk pada masa itu,
Dialog: 0,0:39:22.48,0:39:24.50,Lalai,,0,0,0,,dan membuat tawaran yang menarik,
Dialog: 0,0:39:24.52,0:39:26.73, Lalai,,0,0,0,,jadi saya terlalu tergesa-gesa.
Dialog: 0,0:39:27.11,0:39:28.63, Lalai,,0,0,0,,Saya faham. Kemudian anda harus pergi kepadanya.
Dialog: 0,0:39:28.65,0:39:30.42,Lalai,,0,0,0,,- Minta tolong dia.\N- Ayuh!
Dialog: 0,0:39:30.45,0:39:33.63, Lalai,,0,0,0,,Dia dari A.S. Dia tidak pernah\N berkhidmat dalam tentera,
Dialog: 0,0:39:33.66,0:39:35.76, Lalai,,0,0,0,, jadi apa yang dia tahu tentang memindahkan pangkalan?
Dialog: 0,0:39:35.79,0:39:38.86,Lalai,,0,0,0,,Sebaliknya, anda seorang marin.
Dialog: 0,0:39:42.58,0:39:45.52,Lalai,,0,0,0,,Bukan hanya marin,\Ntetapi pasukan pengawal khas.
Dialog: 0,0:39:45.54,0:39:46.52,Lalai,,0,0,0,,Nampak?
Dialog: 0,0:39:46.55,0:39:49.48,Lalai,,0,0,0,,Saya hanya meminta anda untuk\Nbantu memandangkan anda istimewa.
Dialog: 0,0:39:49.51,0:39:51.63, Lalai,,0,0,0,,Tolong selamatkan saya.
Dialog: 0,0:39:52.68,0:39:54.38,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:39:55.68,0:39:57.42,Lalai,,0,0,0,,Ya?
Dialog: 0,0:39:57.89,0:39:59.24, Lalai,,0,0,0,,Apa yang anda lakukan?
Dialog: 0,0:39:59.27,0:40:01.41, Lalai,,0,0,0,,Saya dalam masalah besar.
Dialog: 0,0:40:01.44,0:40:04.66, Lalai,,0,0,0,,Saya kehilangan bahagian terakhir\Nof teka-teki 2000 keping ini.
Dialog: 0,0:40:04.69,0:40:06.29,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:40:06.32,0:40:08.88,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kumpulan Queens, yang bercita-cita tinggi\Mengumumkan bangunan...{\c}{\i0}
Dialog: 0,0:40:08.90,0:40:12.42,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}kompleks peranginan terbesar di\NAsia Timur Laut, sedang menghadapi nasib malang.{\c}{\i0}
Dialog: 0,0:40:12.45,0:40:14.42,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pangkalan tentera berdekatan dibatalkan...{\c}{\i0}
Dialog: 0,0:40:14.45,0:40:16.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}rancangan mereka untuk berpindah dan\Noleh itu, telah terhad...{\c}{\i0}
Dialog: 0,0:40:16.99,0:40:19.18, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}ketinggian resort hingga 590 kaki.{\c}{\i0}
Dialog: 0,0:40:19.20,0:40:23.85, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini bermakna hotel hanya boleh membina\N39 tingkat, bukannya 90 yang asal.{\c}{\i0}
Dialog: 0,0:40:23.87,0:40:27.15,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Anggaran pendapatan hotel\Nkemungkinan akan turun secara drastik,{\c}{\i0}
Dialog: 0,0:40:27.17,0:40:30.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan pelaburnya mungkin menuntut prabayaran...{\c}{\i0}
Dialog: 0,0:40:30.55,0:40:33.33, Lalai,,0,0,0,,Adakah Soo-cheol masih tidak menjawab?
Dialog: 0,0:40:33.38,0:40:36.66, Lalai,,0,0,0,,Tidak, Bapa. Saya rasa dia cuba menyelesaikan masalah ini...
Dialog: 0,0:40:36.68,0:40:40.49,Lalai,,0,0,0,,Dia tidak sepatutnya membiarkan ini berlaku\N di tempat pertama. Sudah terlambat!
Dialog: 0,0:40:40.52,0:40:44.64, Lalai,,0,0,0,,Bagaimana dia sama bodohnya seperti anda?
Dialog: 0,0:40:44.69,0:40:46.39,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:40:47.86,0:40:49.84, Lalai,,0,0,0,,Hei, anda semua berada di sini.
Dialog: 0,0:40:49.86,0:40:51.63, Lalai,,0,0,0,,Mengapa anda tidak mengambilnya?
Dialog: 0,0:40:51.65,0:40:54.98,Lalai,,0,0,0,,Saya di sini sekarang dengan penyelesaian.
Dialog: 0,0:40:58.41,0:41:00.11, Lalai,,0,0,0,,{\an8}Apakah ini?
Dialog: 0,0:41:02.62,0:41:06.48,Lalai,,0,0,0,,Saya melihat ke dalam jarak jauh\Nradar berhampiran tanah kami.
Dialog: 0,0:41:06.50,0:41:10.86, Lalai,,0,0,0,,Setelah dibina pada tahun 1994, ia\N usang dan perlu dibaiki.
Dialog: 0,0:41:10.88,0:41:12.77, Lalai,,0,0,0,,Kadar kecekapannya melebihi 60%,
Dialog: 0,0:41:12.80,0:41:15.49, Lalai,,0,0,0,,dan ia menerima ujian keselamatan Gred C\Nin tahun lepas.
Dialog: 0,0:41:15.51,0:41:18.95, Lalai,,0,0,0,,Kerajaan memberi kami wang,\Njadi ia akan diperbaiki pada musim panas ini.
Dialog: 0,0:41:18.97,0:41:21.74, Lalai,,0,0,0,,Meningkatkan ketinggian radar.
Dialog: 0,0:41:21.77,0:41:23.93, Lalai,,0,0,0,,- Bagaimana pula?\N- Maaf?
Dialog: 0,0:41:28.86,0:41:33.34, Lalai,,0,0,0,,Stesen radar adalah 590 kaki,\Nand hotel adalah 1150 kaki,
Dialog: 0,0:41:33.36,0:41:34.50,Lalai,,0,0,0,,jadi jika anda menyediakan...
Dialog: 0,0:41:34.53,0:41:39.61, Lalai,,0,0,0,,struktur konkrit di atas\N stesen yang 560 kaki atau lebih,
Dialog: 0,0:41:39.99,0:41:41.39,Lalai,,0,0,0,,maka masalah selesai.
Dialog: 0,0:41:41.41,0:41:44.53, Lalai,,0,0,0,,Nampaknya seperti penyelesaian yang optimum.
Dialog: 0,0:41:44.87,0:41:46.48,Lalai,,0,0,0,,Betul.
Dialog: 0,0:41:46.50,0:41:49.31, Lalai,,0,0,0,,Hyun-woo sememangnya bijak.
Dialog: 0,0:41:49.34,0:41:52.90,Lalai,,0,0,0,,Saya mendapat idea. Dia\Nbaru menulisnya sebagai peguam saya.
Dialog: 0,0:41:52.92,0:41:55.92,Lalai,,0,0,0,,Hyun-woo agak bijak.
Dialog: 0,0:41:58.84,0:42:02.12,Lalai,,0,0,0,,Mengapa rasanya tiada sesiapa yang mendengar saya?
Dialog: 0,0:42:02.14,0:42:05.49,Lalai,,0,0,0,,Bagaimanapun, pastikan anda menerangkan\Nit baik kepada pelabur.
Dialog: 0,0:42:05.52,0:42:09.80,Lalai,,0,0,0,,Anda faham. Saya pasti mereka akan berasa lega.
Dialog: 0,0:42:09.94,0:42:12.04, Lalai,,0,0,0,,Anda tidak dengar apa yang saya katakan tadi?
Dialog: 0,0:42:12.07,0:42:15.71,Lalai,,0,0,0,,Masalahnya telah selesai,\Njadi mengapa anda menarik diri?
Dialog: 0,0:42:15.74,0:42:17.46, Lalai,,0,0,0,,Saya tidak faham.
Dialog: 0,0:42:17.49,0:42:21.68, Lalai,,0,0,0,,Saya mendengar pengurus kewangan Pengerusi Hong telah diambil untuk disoal siasat.
Dialog: 0,0:42:21.70,0:42:22.89, Lalai,,0,0,0,,Mengenai itu...
Dialog: 0,0:42:22.91,0:42:25.56, Lalai,,0,0,0,,Bagaimana anda boleh menyimpan berita penting itu daripada kami?
Dialog: 0,0:42:25.58,0:42:29.74, Lalai,,0,0,0,,Saya tidak akan tahu jika ia bukan kerana penasihat undang-undang kami.
Dialog: 0,0:42:30.33,0:42:32.33, Lalai,,0,0,0,,Penasihat undang-undang anda?
Dialog: 0,0:42:33.05,0:42:35.66, Lalai,,0,0,0,,Seperti dalam Apollon? Adakah saya betul?
Dialog: 0,0:42:36.05,0:42:38.07, Lalai,,0,0,0,, En. Baek merancangnya dengan baik.
Dialog: 0,0:42:38.09,0:42:40.11,Lalai,,0,0,0,,Tiada siapa yang akan melabur...
Dialog: 0,0:42:40.14,0:42:42.86, Lalai,,0,0,0,,apabila pengurus kewangan telah ditangkap.
Dialog: 0,0:42:42.89,0:42:45.05,Lalai,,0,0,0,,Saya tidak percaya Hyun-woo.
Dialog: 0,0:42:45.31,0:42:48.59,Lalai,,0,0,0,,Dia sepatutnya membalas dendam pada Hae-in, bukan saya.
Dialog: 0,0:42:49.06,0:42:53.35, Lalai,,0,0,0,,Adakah ini penamat, kerana\Nmereka semua menarik diri? Astaga.
Dialog: 0,0:42:53.57,0:42:55.15, Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:42:55.18,0:42:56.17,Lalai,,0,0,0,,Apa?
Dialog: 0,0:42:56.19,0:42:57.89, Lalai,,0,0,0,,Ia adalah permulaan.
Dialog: 0,0:42:58.49,0:43:01.02, Lalai,,0,0,0,,Hei, adakah itu bermakna...?
Dialog: 0,0:43:03.70,0:43:05.01,Lalai,,0,0,0,,Tuan.
Dialog: 0,0:43:05.04,0:43:07.07, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:43:09.71,0:43:12.75,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}P Rancangan Pelaburan untuk Melabur\N$900 Juta dalam Q Resort{\c}{\i0}
Dialog: 0,0:43:18.09,0:43:21.19,Lalai,,0,0,0,,{\an8}Kami, Pione Investment,\Nakan menjadi pelabur tunggal anda.
Dialog: 0,0:43:21.22,0:43:23.91, Lalai,,0,0,0,,Lebih mudah untuk menyusun sesuatu\Tidak jika kita pelabur tunggal.
Dialog: 0,0:43:23.94,0:43:25.82,Lalai,,0,0,0,,Ya, pelabur tunggal adalah cara yang tepat.
Dialog: 0,0:43:25.85,0:43:29.08,Lalai,,0,0,0,,Orang kata kita tidak sepatutnya\Nmemasukkan semua telur kita dalam satu bakul,
Dialog: 0,0:43:29.10,0:43:32.93,Lalai,,0,0,0,,tetapi tidak mengapa\Nmemandangkan kami mempercayai Eun-sung.
Dialog: 0,0:43:33.98,0:43:36.08,Lalai,,0,0,0,,Ya, ini semua tentang siapa anda bekerja,
Dialog: 0,0:43:36.11,0:43:38.09, Lalai,,0,0,0,, dan saya juga paling menghargai kepercayaan.
Dialog: 0,0:43:38.11,0:43:41.13,Lalai,,0,0,0,,Adakah anda pasangan jiwa saya, atau apa?
Dialog: 0,0:43:41.16,0:43:45.78,Lalai,,0,0,0,,Saya selalu mengatakan bahawa perniagaan\Nis mengenai mereka yang terlibat.
Dialog: 0,0:43:46.45,0:43:49.01, Lalai,,0,0,0,,Seluruh hidup saya ada di tangan awak.
Dialog: 0,0:43:49.04,0:43:53.10,Lalai,,0,0,0,,Saya pasti ini tidak mudah untuk anda,\Njadi terima kasih kerana melakukan ini.
Dialog: 0,0:43:53.13,0:43:56.41, Lalai,,0,0,0,,Saya harus memeterai perjanjian\Nsebelum anda mengubah fikiran anda.
Dialog: 0,0:44:05.51,0:44:08.76, Lalai,,0,0,0,, Anda tidak sepatutnya berada di sini, tuan.
Dialog: 0,0:44:10.39,0:44:12.00,Lalai,,0,0,0,,Hyun-woo, tentang apa ini?
Dialog: 0,0:44:12.02,0:44:13.80,Lalai,,0,0,0,,Setiausaha Jang.
Dialog: 0,0:44:17.94,0:44:21.67,Lalai,,0,0,0,,Tuan, pasukan undang-undang memberikan\Pendapat mereka tentang perjanjian pelaburan ini,
Dialog: 0,0:44:21.70,0:44:25.73, Lalai,,0,0,0,,tetapi saya rasa anda tidak menerimanya.\NSila pertimbangkan semula hak boleh tukar.
Dialog: 0,0:44:26.12,0:44:27.84,Lalai,,0,0,0,,Jika risiko pemilik menyebabkan masalah,
Dialog: 0,0:44:27.87,0:44:31.68,Lalai,,0,0,0,,maka 6.7% saham anda akan\Nserah kepada Encik Yoon.
Dialog: 0,0:44:31.71,0:44:33.77, Lalai,,0,0,0,,Anda tidak sepatutnya terburu-buru tentang perkara ini.
Dialog: 0,0:44:33.79,0:44:34.81, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:44:34.83,0:44:36.02, Lalai,,0,0,0,,Lihat, Encik Baek!
Dialog: 0,0:44:36.04,0:44:38.24, Lalai,,0,0,0,,Apa yang dia baru cakap...
Dialog: 0,0:44:38.42,0:44:40.66, Lalai,,0,0,0,, masuk akal juga.
Dialog: 0,0:44:41.22,0:44:43.25,Lalai,,0,0,0,,Bapa!
Dialog: 0,0:44:43.63,0:44:44.90,Lalai,,0,0,0,,Anda boleh lakukan sesuka hati.
Dialog: 0,0:44:44.93,0:44:49.05,Lalai,,0,0,0,,Walau bagaimanapun, saya juga akan menarik\Tidak jika ini gagal.
Dialog: 0,0:44:49.81,0:44:51.59,Lalai,,0,0,0,,Amanah...
Dialog: 0,0:44:51.64,0:44:53.76,Lalai,,0,0,0,,perlu bersama.
Dialog: 0,0:45:05.36,0:45:08.72,Lalai,,0,0,0,,Dia berkata anda perlu\Nmembuat keputusan besar tidak lama lagi.
Dialog: 0,0:45:08.74,0:45:12.01, Lalai,,0,0,0,,Jika seseorang menawarkan anda sejumlah besar\Njumlah wang dan beberapa kertas,
Dialog: 0,0:45:12.04,0:45:13.60,Lalai,,0,0,0,,dia menasihati anda untuk menerimanya.
Dialog: 0,0:45:13.62,0:45:17.83, Lalai,,0,0,0,,Melakukan itu akan menyelamatkan anda dan syarikat anda.
Dialog: 0,0:45:18.84,0:45:21.69, Lalai,,0,0,0,,Sesiapa yang melemparkan sepana monyet ke dalamnya...
Dialog: 0,0:45:21.71,0:45:25.15,Lalai,,0,0,0,,akan mengkhianati anda di jalan raya,
Dialog: 0,0:45:25.18,0:45:27.46, Lalai,,0,0,0,,jadi anda harus mengabaikannya.
Dialog: 0,0:45:27.97,0:45:29.88,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:45:32.72,0:45:35.20,Lalai,,0,0,0,,Anda mesti mendengar saya.
Dialog: 0,0:45:35.23,0:45:39.50,Lalai,,0,0,0,,Sama seperti di tempat perburuan itu,\Nbomoh hebat ini telah menyelamatkan nyawa kamu...
Dialog: 0,0:45:39.52,0:45:41.89,Lalai,,0,0,0,,{\i1}berkali-kali.{\i0}
Dialog: 0,0:45:42.73,0:45:44.50,Lalai,,0,0,0,,Dia pasti bagus.
Dialog: 0,0:45:44.53,0:45:46.52,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:45:46.74,0:45:48.44,Lalai,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:45:48.62,0:45:50.05,Lalai,,0,0,0,,- Hyun-woo?\N- Ya, tuan.
Dialog: 0,0:45:50.08,0:45:52.94, Lalai,,0,0,0,,Saya tidak melemparkan orang keluar serta-merta.
Dialog: 0,0:45:53.16,0:45:54.93, Lalai,,0,0,0,,Saya beri mereka tiga peluang,
Dialog: 0,0:45:54.96,0:45:58.39,Lalai,,0,0,0,,tetapi awak mengkhianati cucu saya,
Dialog: 0,0:45:58.42,0:46:04.41, Lalai,,0,0,0,, menyadap bilik saya, dan cuba merosakkan perjanjian ini.
Dialog: 0,0:46:04.59,0:46:06.69, Lalai,,0,0,0,,Itu sudah tiga pukulan.
Dialog: 0,0:46:06.72,0:46:09.25,Lalai,,0,0,0,,- Tuan...\N- Keluar.
Dialog: 0,0:46:35.41,0:46:37.08,Lalai,,0,0,0,,Adakah ini rosak?
Dialog: 0,0:46:37.11,0:46:38.10, Lalai,,0,0,0,,Sila.
Dialog: 0,0:46:38.12,0:46:39.95, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:46:48.13,0:46:49.13,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}ID Tidak Sah{\c}{\i0}
Dialog: 0,0:46:55.35,0:46:58.38,Lalai,,0,0,0,,Tuan, anda perlu keluar.
Dialog: 0,0:47:01.73,0:47:03.12,Lalai,,0,0,0,,En. Baek Hyun-woo.
Dialog: 0,0:47:03.15,0:47:05.02, Lalai,,0,0,0,,Sila tinggalkan kad pengenalan anda, telefon korporat,
Dialog: 0,0:47:05.04,0:47:08.34, Lalai,,0,0,0,,komputer riba dan peralatan lain\Ndi belakang dan meninggalkan bangunan.
Dialog: 0,0:47:08.36,0:47:11.17, Lalai,,0,0,0,,Sudah lewat waktu kerja.\NAnda tidak boleh melakukan ini secara tiba-tiba.
Dialog: 0,0:47:11.20,0:47:12.99,Lalai,,0,0,0,,Ini arahan pengerusi.
Dialog: 0,0:47:13.02,0:47:14.01, Lalai,,0,0,0,,Sila tinggalkan.
Dialog: 0,0:47:14.03,0:47:16.95, Lalai,,0,0,0,,Adakah pasukan keselamatan tidak mempunyai peraturan?
Dialog: 0,0:47:21.00,0:47:23.99,Lalai,,0,0,0,,Adakah anda orang pengerusi atau sesuatu?
Dialog: 0,0:47:24.46,0:47:27.29,Lalai,,0,0,0,,Sudah lewat waktu bekerja. pulang ke rumah.
Dialog: 0,0:47:27.63,0:47:29.73,Lalai,,0,0,0,,Tetapi pengerusi mengarahkan kami...
Dialog: 0,0:47:29.76,0:47:32.17, Lalai,,0,0,0,, Pulang sahaja.
Dialog: 0,0:47:37.43,0:47:39.12,Lalai,,0,0,0,,Sekurang-kurangnya buat perjanjian.
Dialog: 0,0:47:39.14,0:47:41.45,Lalai,,0,0,0,,Tuntut sesuatu sebagai balasan untuk berhenti.
Dialog: 0,0:47:41.48,0:47:43.62, Lalai,,0,0,0,,Adakah anda benar-benar akan membiarkan mereka menendang anda keluar?
Dialog: 0,0:47:43.65,0:47:45.21, Lalai,,0,0,0,,Mereka tidak boleh.
Dialog: 0,0:47:45.23,0:47:50.80,Lalai,,0,0,0,,Pengerusi boleh memecat saya sebagai\Npengarah, tetapi saya juga pengurus pasukan.
Dialog: 0,0:47:50.82,0:47:53.42, Lalai,,0,0,0,,Dia memerlukan alasan yang sah untuk memecatnya.
Dialog: 0,0:47:53.45,0:47:57.80,Lalai,,0,0,0,,Saya tahu pasukan audit tidak dapat\Nmenemui sebarang sebab untuk memecat saya.
Dialog: 0,0:47:57.83,0:47:59.53,Lalai,,0,0,0,,Itu...
Dialog: 0,0:48:00.21,0:48:02.91, Lalai,,0,0,0,,Baik, tetapi mengapa anda masih di sini?
Dialog: 0,0:48:03.21,0:48:07.19,Lalai,,0,0,0,,Anda sangat ingin bercerai,\Anda diam-diam bersedia untuk itu,
Dialog: 0,0:48:07.21,0:48:10.15,Lalai,,0,0,0,,jadi mengapa anda masih di sini\Nand membiarkan mereka memalukan anda?
Dialog: 0,0:48:10.17,0:48:11.92,Lalai,,0,0,0,,Ketika awak bersama saya...
Dialog: 0,0:48:14.39,0:48:16.49,Lalai,,0,0,0,,Anda terpaksa bersabar dengannya,
Dialog: 0,0:48:16.51,0:48:18.21, Lalai,,0,0,0,,tetapi tidak lagi.
Dialog: 0,0:48:18.68,0:48:20.08, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:48:20.10,0:48:24.05, Lalai,,0,0,0,,Saya hanya melakukan ini kerana\NI masih mahu berada di sini.
Dialog: 0,0:48:30.99,0:48:32.69, Lalai,,0,0,0,,Apakah perasaan anda?
Dialog: 0,0:48:33.95,0:48:35.73, Lalai,,0,0,0,,Saya okay.
Dialog: 0,0:49:05.48,0:49:09.85,Lalai,,0,0,0,,- Cik Hong.\N- Anda lebih baik masuk, atau saya akan langgar awak.
Dialog: 0,0:49:32.34,0:49:33.82, Lalai,,0,0,0,,Yang mana satu?
Dialog: 0,0:49:33.84,0:49:36.29,Lalai,,0,0,0,,Syarikat? Perjumpaan semula? Bar?
Dialog: 0,0:49:36.68,0:49:39.70,Lalai,,0,0,0,,Jangan susah-susah menafikannya.
Dialog: 0,0:49:39.72,0:49:42.30,Lalai,,0,0,0,,Saya tahu segala-galanya tentang perceraian.
Dialog: 0,0:49:43.35,0:49:45.12, Lalai,,0,0,0,,Hanya ada satu jawapan.
Dialog: 0,0:49:45.14,0:49:46.84,Lalai,,0,0,0,,Seorang perempuan simpanan.
Dialog: 0,0:49:48.77,0:49:50.47,Lalai,,0,0,0,,Puan...
Dialog: 0,0:49:50.94,0:49:52.63,Lalai,,0,0,0,,Hae-in adalah satu-satunya wanita dalam hidup saya.
Dialog: 0,0:49:52.65,0:49:54.84, Lalai,,0,0,0,,Kalau begitu jangan pergi!
Dialog: 0,0:49:54.86,0:49:57.92,Lalai,,0,0,0,,Awak semua dia ada, jadi kenapa awak pergi?
Dialog: 0,0:49:57.95,0:49:59.82,Lalai,,0,0,0,,Saya tidak akan ke mana-mana.
Dialog: 0,0:50:01.24,0:50:03.44, Lalai,,0,0,0,,Bagaimana mungkin saya meninggalkan dia?
Dialog: 0,0:50:04.04,0:50:06.14, Lalai,,0,0,0,,Itulah sebabnya saya masih di syarikat itu.
Dialog: 0,0:50:06.16,0:50:08.07, Lalai,,0,0,0,,Saya akan tetap dengan dia...
Dialog: 0,0:50:08.25,0:50:10.31, Lalai,,0,0,0,,pada semua kos.
Dialog: 0,0:50:10.34,0:50:12.04,Lalai,,0,0,0,,Juga...
Dialog: 0,0:50:12.34,0:50:17.19,Lalai,,0,0,0,,Saya akan sampaikan ke bahagian bawah siapa\Nbugged bilik pengerusi,
Dialog: 0,0:50:17.22,0:50:19.86, Lalai,,0,0,0,,serahkan rakaman kepada Apollon,
Dialog: 0,0:50:19.89,0:50:22.13, Lalai,,0,0,0,, dan mahu saya keluar daripada keluarga.
Dialog: 0,0:50:28.52,0:50:30.22, Lalai,,0,0,0,,Mengenai itu...
Dialog: 0,0:50:31.44,0:50:33.33, Lalai,,0,0,0,,Saya ada syak wasangka.
Dialog: 0,0:50:33.36,0:50:35.06, Lalai,,0,0,0,,Pn. Moh?
Dialog: 0,0:50:35.19,0:50:36.17, Lalai,,0,0,0,,Bagaimana anda tahu?
Dialog: 0,0:50:36.19,0:50:38.98, Lalai,,0,0,0,,Semua orang tahu betapa anda menghinanya.
Dialog: 0,0:50:39.11,0:50:40.72, Lalai,,0,0,0,,Bukan sebabnya.
Dialog: 0,0:50:40.74,0:50:43.09, Lalai,,0,0,0,,Dia lebih menakutkan daripada yang anda fikirkan.
Dialog: 0,0:50:43.12,0:50:47.16,Lalai,,0,0,0,,Dia telah hidup di bawah jati diri palsu dan menipu kami selama beberapa dekad.
Dialog: 0,0:50:47.29,0:50:49.66, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:50:50.21,0:50:52.85, Lalai,,0,0,0,,Nama sebenarnya ialah Oh Sun-yeong.
Dialog: 0,0:50:52.88,0:50:54.52,Lalai,,0,0,0,,Dia mempunyai seorang anak lelaki,
Dialog: 0,0:50:54.55,0:50:56.27, Lalai,,0,0,0,,dan dia berumur 34 tahun sekarang,
Dialog: 0,0:50:56.30,0:50:59.54, Lalai,,0,0,0,,dan Oh Sun-yeong telah meninggal dunia di atas kertas.
Dialog: 0,0:50:59.97,0:51:02.24, Lalai,,0,0,0,,Jadi? Tidak waras, bukan?
Dialog: 0,0:51:02.26,0:51:04.12,Lalai,,0,0,0,,Awak tidak mahu bekerjasama dengan saya?
Dialog: 0,0:51:04.14,0:51:07.01, Lalai,,0,0,0,,Saya juga mempunyai rakan kongsi bernama "Conan."
Dialog: 0,0:51:10.69,0:51:12.54, Lalai,,0,0,0,, Iced Americano sepanjang jalan, bukan?
Dialog: 0,0:51:12.56,0:51:16.04,Lalai,,0,0,0,,- Macam mana awak tahu?\N- Saya nampak awak jenis yang degil.
Dialog: 0,0:51:16.07,0:51:17.46, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:51:17.49,0:51:20.47,Lalai,,0,0,0,,Dia boleh lulus sebagai bomoh.
Dialog: 0,0:51:20.49,0:51:21.88, Lalai,,0,0,0,,Saya secara praktikal membesarkannya sendiri.
Dialog: 0,0:51:21.91,0:51:23.30, Lalai,,0,0,0,,Apa yang anda dapati?
Dialog: 0,0:51:23.33,0:51:26.26,Lalai,,0,0,0,,Saya berjumpa dengan pengawal dari\NOh penjara Sun-yeong.
Dialog: 0,0:51:26.29,0:51:27.60,Lalai,,0,0,0,,Dia bersalin di belakang jeriji,
Dialog: 0,0:51:27.62,0:51:30.02,Lalai,,0,0,0,,dan menghantarnya ke rumah anak yatim\Wilayah Nin Gangwon.
Dialog: 0,0:51:30.04,0:51:31.99, Lalai,,0,0,0,,- Di mana sebenarnya?\N- Ia...
Dialog: 0,0:51:33.75,0:51:36.94,Lalai,,0,0,0,,- Wonsan.\N- Bukankah itu berhampiran tempat perburuan?
Dialog: 0,0:51:36.96,0:51:38.52,Lalai,,0,0,0,,Ya, vila kami ada di sana.
Dialog: 0,0:51:38.55,0:51:40.44, Lalai,,0,0,0,,Ya, ia sangat hampir.
Dialog: 0,0:51:40.47,0:51:42.78, Lalai,,0,0,0,,Ia Rumah Anak Yatim Harapan Evergreen.
Dialog: 0,0:51:42.80,0:51:44.24, Lalai,,0,0,0,,"Evergreen"?
Dialog: 0,0:51:44.26,0:51:45.87, Lalai,,0,0,0,,Itu...
Dialog: 0,0:51:45.89,0:51:48.20, Lalai,,0,0,0,,Ayah saya dan perempuan itu ditaja...
Dialog: 0,0:51:48.23,0:51:51.43, Lalai,,0,0,0,,dan memberikan biasiswa\N di sana sehingga sedekad yang lalu!
Dialog: 0,0:51:55.11,0:51:58.46, Lalai,,0,0,0,, Rumah anak yatim itu terbakar sepuluh tahun lalu.
Dialog: 0,0:51:58.49,0:52:00.59,Lalai,,0,0,0,,Saya percaya pengarah itu meninggal dunia juga.
Dialog: 0,0:52:00.61,0:52:03.81, Lalai,,0,0,0,,Adakah anda mengenali sesiapa yang boleh kami hubungi?
Dialog: 0,0:52:03.99,0:52:05.72,Lalai,,0,0,0,,- Saya tidak pasti.\N- Bagaimana dengan dia?
Dialog: 0,0:52:05.74,0:52:06.76, Lalai,,0,0,0,,Siapa?
Dialog: 0,0:52:06.79,0:52:09.60,Lalai,,0,0,0,,Lelaki yang datang ke tempat perburuan bersama kamu.
Dialog: 0,0:52:09.62,0:52:11.52,Lalai,,0,0,0,,Orang yang ingin membeli anjing kami.
Dialog: 0,0:52:11.54,0:52:13.98,Lalai,,0,0,0,,- Encik Yoon Eun-sung?\N- Jangan mengarut.
Dialog: 0,0:52:14.00,0:52:16.83, Lalai,,0,0,0,,Apa? Awak kata dia nampak familiar juga.
Dialog: 0,0:52:17.92,0:52:20.92, Lalai,,0,0,0,,Siapa yang dia ingatkan anda?
Dialog: 0,0:52:21.01,0:52:23.99, Lalai,,0,0,0,,Ada budak ini di rumah anak yatim.
Dialog: 0,0:52:24.01,0:52:26.91, Lalai,,0,0,0,,Dia sangat bijak, dia menerima\Nbiasiswa daripada Queens Group,
Dialog: 0,0:52:26.93,0:52:29.49,Lalai,,0,0,0,,tetapi dia dibawa ke balai polis sekali,
Dialog: 0,0:52:29.52,0:52:31.47, Lalai,,0,0,0,,selepas meracuni dan membunuh anjing jiran,
Dialog: 0,0:52:31.50,0:52:34.07, Lalai,,0,0,0,,dan Encik Yoon kelihatan seperti dia.
Dialog: 0,0:52:35.86,0:52:38.21,Lalai,,0,0,0,,Dia memang cakap dia anak angkat ke A.S.
Dialog: 0,0:52:38.23,0:52:41.85, Lalai,,0,0,0,,Betul. Budak itu\Dianakkan ke A.S. juga.
Dialog: 0,0:52:45.66,0:52:47.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bukankah dia perempuan simpanan pengerusi?{\c}{\i0}
Dialog: 0,0:52:47.49,0:52:50.01, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia jam tangan lelaki.\NI tertanya-tanya kepada siapa dia menghadiahkannya.{\c}{\i0}
Dialog: 0,0:52:50.04,0:52:51.72, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia lebih menakutkan daripada yang anda fikirkan.{\c}{\i0}
Dialog: 0,0:52:51.75,0:52:55.10, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia telah hidup di bawah\Nidentiti palsu dan menipu kami selama beberapa dekad.{\c}{\i0}
Dialog: 0,0:52:55.13,0:52:58.44, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia bersalin di balik jeruji besi dan menghantarnya\N ke rumah anak yatim di Wilayah Gangwon.{\c}{\i0}
Dialog: 0,0:52:58.46,0:52:59.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya telah diterima pakai di luar negara.{\c}{\i0}
Dialog: 0,0:52:59.84,0:53:01.65, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia telah diambil sebagai anak angkat oleh keluarga Korea pada 12.{\c}{\i0}
Dialog: 0,0:53:01.67,0:53:04.36,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia mempunyai seorang anak lelaki, dan dia berusia 34 tahun sekarang.{\c}{\i0}
Dialog: 0,0:53:04.38,0:53:07.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi saya tiada keluarga sekarang.{\c}{\i0}
Dialog: 0,0:53:14.64,0:53:16.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kuasa Wakil\NHong Man-dae{\c}{\i0}
Dialog: 0,0:53:19.90,0:53:21.42,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hak untuk membuat sebarang keputusan perubatan{\c}{\i0}
Dialog: 0,0:53:23.40,0:53:25.42, Lalai,,0,0,0,,Mengapa anda menandatangani ini?
Dialog: 0,0:53:25.45,0:53:28.30,Lalai,,0,0,0,,Mengapa anda memberi saya\Nhak untuk membuat keputusan untuk anda?
Dialog: 0,0:53:28.33,0:53:30.89, Lalai,,0,0,0,,Apabila pihak pendakwaan\Nmenyiasat dana rahsia,
Dialog: 0,0:53:30.91,0:53:33.09,Lalai,,0,0,0,,mereka mungkin tidak yakin\Nbahawa anda telah menyelewengkannya,
Dialog: 0,0:53:33.11,0:53:35.89, Lalai,,0,0,0,,hanya kerana anda mempunyai sedikit\Nof wang di bawah nama anda.
Dialog: 0,0:53:35.92,0:53:39.10,Lalai,,0,0,0,,Sesiapa sahaja boleh menjadi pengurus kewangan.
Dialog: 0,0:53:39.13,0:53:40.95, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:53:41.84,0:53:43.71, Lalai,,0,0,0,, Nampak?
Dialog: 0,0:53:43.80,0:53:45.11, Lalai,,0,0,0,,Ini demi saya.
Dialog: 0,0:53:45.13,0:53:47.46, Lalai,,0,0,0,,Anda masih tidak mahu melakukannya?
Dialog: 0,0:53:48.39,0:53:49.49, Lalai,,0,0,0,,Tidak, saya sepatutnya.
Dialog: 0,0:53:49.51,0:53:53.58,Lalai,,0,0,0,,Hari ini hari lahir awak,\Njadi ini boleh jadi hadiah saya untuk awak.
Dialog: 0,0:53:53.60,0:53:54.70,Lalai,,0,0,0,,Betul.
Dialog: 0,0:53:54.73,0:53:58.05,Lalai,,0,0,0,,Ya, saya akan menganggapnya sebagai hadiah hari jadi saya.
Dialog: 0,0:54:11.28,0:54:14.66, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Diberi kuasa oleh: Hong Man-dae{\c}{\i0}
Dialog: 0,0:54:28.47,0:54:31.36,Default,,0,0,0,,{\an8}Tunggu, kenapa Encik Yoon duduk sini?
Dialog: 0,0:54:31.39,0:54:33.24, Lalai,,0,0,0,,Dia sepatutnya duduk bersama kita.
Dialog: 0,0:54:33.26,0:54:34.99,Lalai,,0,0,0,,Nah...
Dialog: 0,0:54:35.02,0:54:36.64, Lalai,,0,0,0,,Itu pesanan saya.
Dialog: 0,0:54:36.67,0:54:37.70,Lalai,,0,0,0,,Apa?
Dialog: 0,0:54:37.73,0:54:40.81, Lalai,,0,0,0,,Ia betul. Dia bukan keluarga pula.
Dialog: 0,0:54:41.69,0:54:45.43, Lalai,,0,0,0,,Kenapa? Anda duduk bersama kami apabila\Nyou bukan keluarga juga.
Dialog: 0,0:54:46.49,0:54:48.30,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:54:48.32,0:54:51.34, Lalai,,0,0,0,,Jadi anda boleh menjadi keluarga, walaupun ia tidak di atas kertas.
Dialog: 0,0:54:51.37,0:54:53.86, Lalai,,0,0,0,,- Jika anda tinggal bersama...\N- Jadi?
Dialog: 0,0:54:54.29,0:54:56.31, Lalai,,0,0,0,, Awak cakap Encik Yoon boleh jadi keluarga?
Dialog: 0,0:54:56.33,0:54:58.03, Lalai,,0,0,0,,Adakah itu yang anda fikirkan?
Dialog: 0,0:54:58.96,0:55:01.41, Lalai,,0,0,0,,Tidak, saya tidak pernah berkata begitu.
Dialog: 0,0:55:01.92,0:55:03.81,Lalai,,0,0,0,,Hae-in telah bercerai tidak lama dahulu.
Dialog: 0,0:55:03.84,0:55:07.11, Lalai,,0,0,0,,Apakah yang orang akan fikirkan jika dia duduk di sebelahnya?
Dialog: 0,0:55:07.13,0:55:10.04, Lalai,,0,0,0,,Mereka akan fikir dia mempunyai niat yang cetek.
Dialog: 0,0:55:10.72,0:55:12.15, Lalai,,0,0,0,,"Cetek"?
Dialog: 0,0:55:12.18,0:55:14.24, Lalai,,0,0,0,,Adakah anda serius baru sahaja berkata begitu?
Dialog: 0,0:55:14.26,0:55:15.41, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:55:15.43,0:55:16.99,Lalai,,0,0,0,,Kemudian...
Dialog: 0,0:55:17.02,0:55:19.08, Lalai,,0,0,0,,anda tidak sepatutnya memberi mereka idea yang salah.
Dialog: 0,0:55:19.10,0:55:22.10,Lalai,,0,0,0,,Siapa kamu untuk memerintahkan orang ramai?
Dialog: 0,0:55:24.36,0:55:26.25,Lalai,,0,0,0,,Seon-hwa...
Dialog: 0,0:55:26.28,0:55:28.10, Lalai,,0,0,0,, ialah wanita rumah.
Dialog: 0,0:55:29.99,0:55:32.94,Lalai,,0,0,0,,Anda benar-benar sesuatu, anda tahu?
Dialog: 0,0:55:35.29,0:55:36.55, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:55:36.58,0:55:40.78,Lalai,,0,0,0,,Jangan gusar tentang\Ntiada apa-apa pada hari yang baik ini.
Dialog: 0,0:55:49.67,0:55:51.24, Lalai,,0,0,0,,{\i1}Mengapa dia mempunyai ini?{\i0}
Dialog: 0,0:55:51.26,0:55:54.28, Lalai,,0,0,0,,Ini milik Ibu!
Dialog: 0,0:55:54.30,0:55:56.24,Lalai,,0,0,0,,Dia memakainya sepanjang hidupnya,
Dialog: 0,0:55:56.26,0:55:58.12, Lalai,,0,0,0,, dan saya sepatutnya mewarisinya,
Dialog: 0,0:55:58.14,0:56:00.95, Lalai,,0,0,0,,jadi bagaimana anda boleh memberikannya kepadanya?
Dialog: 0,0:56:00.98,0:56:04.56,Lalai,,0,0,0,,Okey. Biarkan saya pergi, dan saya akan menanggalkannya.
Dialog: 0,0:56:05.61,0:56:09.25, Lalai,,0,0,0,,Ayah, kenapa awak jadi gila?
Dialog: 0,0:56:09.28,0:56:12.72,Lalai,,0,0,0,,Anda mungkin selalu gila kerja,\Ntetapi anda tidak seperti ini.
Dialog: 0,0:56:12.74,0:56:14.68, Lalai,,0,0,0,,Mengapa anda tidak boleh membuat pertimbangan yang baik?
Dialog: 0,0:56:14.70,0:56:18.14, Lalai,,0,0,0,,Lihat siapa yang bercakap! Beraninya awak?
Dialog: 0,0:56:18.16,0:56:21.22, Lalai,,0,0,0,,Anda telah menendang Beom-seok keluar\Nand memperlakukan Beom-jun seperti orang bodoh.
Dialog: 0,0:56:21.25,0:56:23.60, Lalai,,0,0,0,,Lihat siapa yang tinggal sekarang.
Dialog: 0,0:56:23.63,0:56:27.44, Lalai,,0,0,0,,Anda hanya ada perempuan ini\Nyang sedang menunggu untuk memerah susu anda kering!
Dialog: 0,0:56:27.46,0:56:28.65, Lalai,,0,0,0,, Tonton apa yang anda katakan!
Dialog: 0,0:56:28.67,0:56:32.07,Lalai,,0,0,0,,Apabila anak-anak saya berundur\Non takut saya akan menghantar mereka ke penjara,
Dialog: 0,0:56:32.09,0:56:33.99,Lalai,,0,0,0,,dia sahaja yang meningkat!
Dialog: 0,0:56:34.01,0:56:37.74, Lalai,,0,0,0,,Mungkin dia tidak takut untuk pergi\Nmemandangkan dia pernah ke sana!
Dialog: 0,0:56:37.76,0:56:39.92, Lalai,,0,0,0,,Apakah perkara karut yang kamu muntahkan?
Dialog: 0,0:56:40.39,0:56:41.58, Lalai,,0,0,0,,Anda tidak tahu apa-apa.
Dialog: 0,0:56:41.60,0:56:43.95, Lalai,,0,0,0,,Saya akan memberitahu anda kemudian.
Dialog: 0,0:56:43.98,0:56:46.46, Lalai,,0,0,0,,Dia pernah masuk penjara,
Dialog: 0,0:56:46.48,0:56:48.21, Lalai,,0,0,0,, malah mempunyai anak!
Dialog: 0,0:56:48.23,0:56:51.73, Lalai,,0,0,0,,Dia hidup di bawah nama palsu selama ini!
Dialog: 0,0:56:52.07,0:56:55.34, Lalai,,0,0,0,,Beom-ja, kenapa awak jahat sangat dengan saya?
Dialog: 0,0:56:55.37,0:56:58.05, Lalai,,0,0,0,,Saya mungkin miskin,
Dialog: 0,0:56:58.08,0:57:01.49,Lalai,,0,0,0,,tetapi saya sentiasa berusaha untuk menjalani kehidupan yang jujur.
Dialog: 0,0:57:04.33,0:57:07.24,Lalai,,0,0,0,,Maaf, tuan.
Dialog: 0,0:57:08.17,0:57:10.45, Lalai,,0,0,0,,Saya tidak boleh melakukan ini lagi.
Dialog: 0,0:57:10.51,0:57:13.12, Lalai,,0,0,0,,Saya akan tinggalkan rumah ini.
Dialog: 0,0:57:13.72,0:57:16.13,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:57:16.34,0:57:19.82,Lalai,,0,0,0,,Anda tahu Beom-ja selalu bercakap bukan-bukan.
Dialog: 0,0:57:19.85,0:57:20.83, Lalai,,0,0,0,,Bodoh!
Dialog: 0,0:57:20.85,0:57:24.12,Lalai,,0,0,0,,Lebih baik anda berhenti, atau saya akan menghantar\Nyou ke rumah sakit jiwa. faham?
Dialog: 0,0:57:24.14,0:57:26.01, Lalai,,0,0,0,,Suaka mental?
Dialog: 0,0:57:27.56,0:57:30.47,Lalai,,0,0,0,,Maka saya patut lakukan sebanyak ini.
Dialog: 0,0:57:32.57,0:57:34.92,Lalai,,0,0,0,,Anda!
Dialog: 0,0:57:34.95,0:57:36.13, Lalai,,0,0,0,,Lepaskan dia!
Dialog: 0,0:57:36.16,0:57:39.15,Lalai,,0,0,0,,Saya kata, lepaskan dia!
Dialog: 0,0:57:47.54,0:57:48.52,Lalai,,0,0,0,,Bapa...
Dialog: 0,0:57:48.54,0:57:49.69, Lalai,,0,0,0,,Saya sangat muak dengan awak.
Dialog: 0,0:57:49.71,0:57:52.82,Lalai,,0,0,0,,Ibu kamu membalas dendam kepada saya...
Dialog: 0,0:57:52.84,0:57:54.65,Lalai,,0,0,0,,dengan melahirkan anda.
Dialog: 0,0:57:54.67,0:57:58.86, Lalai,,0,0,0,,Bagaimana awak boleh menyeksa saya sehingga hari ini?
Dialog: 0,0:57:58.89,0:58:00.78, Lalai,,0,0,0,, Pergi sahaja, boleh?
Dialog: 0,0:58:00.81,0:58:02.03, Lalai,,0,0,0,,Tinggalkan, saya mohon.
Dialog: 0,0:58:02.06,0:58:04.09, Lalai,,0,0,0,, Pergi sahaja!
Dialog: 0,0:58:12.78,0:58:14.48, Lalai,,0,0,0,,Saya akan lakukan itu.
Dialog: 0,0:58:14.53,0:58:17.13, Lalai,,0,0,0,,Anda tidak akan dapat menyelamatkan muka,
Dialog: 0,0:58:17.16,0:58:19.43, Lalai,,0,0,0,,selepas menendang keluar dua daripada tiga anak anda.
Dialog: 0,0:58:19.45,0:58:21.65, Lalai,,0,0,0,,Saya pergi atas kehendak saya sendiri.
Dialog: 0,0:58:22.20,0:58:25.07, Lalai,,0,0,0,,Adakan majlis hari jadi yang hebat hari ini.
Dialog: 0,0:58:27.00,0:58:29.10,Lalai,,0,0,0,,Sekurang-kurangnya saya akan menghadiri pengebumian awak.
Dialog: 0,0:58:29.13,0:58:30.77, Lalai,,0,0,0,,Walaupun masih,
Dialog: 0,0:58:30.79,0:58:33.58,Lalai,,0,0,0,,Saya harap awak panjang umur.
Dialog: 0,0:58:41.64,0:58:43.67, Lalai,,0,0,0,, Si kecil itu...!
Dialog: 0,0:58:51.36,0:58:53.10, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:58:53.90,0:58:55.98, Lalai,,0,0,0,,Baiklah, sekarang.
Dialog: 0,0:58:57.28,0:58:59.34, Lalai,,0,0,0,,Adakah folikel rambut utuh?
Dialog: 0,0:58:59.36,0:59:02.52, Lalai,,0,0,0,,Mungkin. Saya menarik mereka keluar dengan sekuat tenaga saya.
Dialog: 0,0:59:02.91,0:59:04.61, Lalai,,0,0,0,,Dan Encik Yoon?
Dialog: 0,0:59:08.37,0:59:10.07, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:59:16.26,0:59:17.96,Lalai,,0,0,0,,Puan.
Dialog: 0,0:59:26.10,0:59:28.01, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:59:29.52,0:59:31.51,Lalai,,0,0,0,,Tidak...
Dialog: 0,0:59:31.56,0:59:35.13, Lalai,,0,0,0,,Saya tidak okay, Hyun-woo...
Dialog: 0,0:59:35.15,0:59:39.98,Lalai,,0,0,0,,Ayah saya memukul saya buat kali pertama dalam hidupnya.
Dialog: 0,0:59:40.03,0:59:44.82, Lalai,,0,0,0,,Dia pukul saya...
Dialog: 0,0:59:55.46,0:59:57.44,Default,,0,0,0,,Bagaimana jika Atuk pengsan...
Dialog: 0,0:59:57.46,1:00:00.11, Lalai,,0,0,0,, kerana gembira selepas menerima kejutan saya?
Dialog: 0,1:00:00.13,1:00:02.03,Lalai,,0,0,0,,Jangan terlalu memaksa diri sendiri. Bertenang.
Dialog: 0,1:00:02.05,1:00:04.07,Lalai,,0,0,0,,Saya terlalu tenang selama ini.
Dialog: 0,1:00:04.10,1:00:05.91,Lalai,,0,0,0,,Saya perlu tukar.
Dialog: 0,1:00:05.93,1:00:07.83,Lalai,,0,0,0,,Nampak tak? Saya penyelesaian Queens sekarang.
Dialog: 0,1:00:07.85,1:00:11.01,Lalai,,0,0,0,,Saya penyelamat nyawa mereka.
Dialog: 0,1:00:12.60,1:00:16.88,Lalai,,0,0,0,,Namun, datuk kamu mahu\Nah hari jadi yang tenang tahun ini.
Dialog: 0,1:00:16.90,1:00:19.30,Lalai,,0,0,0,,Anda tidak bersalah.
Dialog: 0,1:00:19.32,1:00:21.10,Lalai,,0,0,0,,Jangan biarkan dia menipu anda. Ia hanya ujian.
Dialog: 0,1:00:21.13,1:00:23.47,Lalai,,0,0,0,,Ia seperti separuh penggal atau peperiksaan.
Dialog: 0,1:00:23.49,1:00:26.34, Lalai,,0,0,0,,Dalam aspek itu, ini seperti CSAT.
Dialog: 0,1:00:26.37,1:00:30.65,Lalai,,0,0,0,,Adakah saya akan dipilih sebagai waris atau tidak?
Dialog: 0,1:00:30.71,1:00:31.72,Lalai,,0,0,0,,Ini adalah perlawanan,
Dialog: 0,1:00:31.75,1:00:33.66,Lalai,,0,0,0,,tetapi saya ada firasat.
Dialog: 0,1:00:34.54,1:00:36.37,Lalai,,0,0,0,,Apa? macam mana?
Dialog: 0,1:00:38.88,1:00:40.57,Lalai,,0,0,0,,Hari ini akan...
Dialog: 0,1:00:40.59,1:00:43.83,Lalai,,0,0,0,,hari terbaik dalam hidup saya.
Dialog: 0,1:00:44.09,1:00:45.65,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:00:45.68,1:00:46.95,Lalai,,0,0,0,,Pakai pakaian yang cantik,
Dialog: 0,1:00:46.97,1:00:49.30,Lalai,,0,0,0,,dan bawa Geon-u ke salun rambut.
Dialog: 0,1:00:50.35,1:00:52.43,Lalai,,0,0,0,,Saya akan tunggu.
Dialog: 0,1:01:01.19,1:01:02.89,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:01:06.41,1:01:08.11,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:01:25.97,1:01:26.95,Lalai,,0,0,0,,Bodoh.
Dialog: 0,1:01:26.97,1:01:29.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Tahniah atas Ulang Tahun Ke-20 Pengerusi Hong\NF!{\c}{\i0}
Dialog: 0,1:01:53.20,1:01:57.96,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Hari Lahir Ke-80 Pengerusi Hong{\c}{\i0}
Dialog: 0,1:02:13.14,1:02:18.51,Lalai,,0,0,0,,Kami telah berkumpul untuk\Nmeraikan hari lahir pengerusi.
Dialog: 0,1:02:18.56,1:02:20.42,Lalai,,0,0,0,,Keluarga kami melalui...
Dialog: 0,1:02:20.44,1:02:22.42, Lalai,,0,0,0,,tampalan kasar baru-baru ini.
Dialog: 0,1:02:22.44,1:02:27.06,Lalai,,0,0,0,,Orang memfitnahnya dan menyebarkan khabar angin.
Dialog: 0,1:02:27.49,1:02:28.72,Lalai,,0,0,0,,Walau bagaimanapun,
Dialog: 0,1:02:28.74,1:02:31.01,Lalai,,0,0,0,,wira kita tidak mengalah...
Dialog: 0,1:02:31.03,1:02:32.22,Lalai,,0,0,0,,tidak berputus asa.
Dialog: 0,1:02:32.24,1:02:35.26,Lalai,,0,0,0,,Dia mengatasi semua kesusahan.
Dialog: 0,1:02:35.29,1:02:38.53,Lalai,,0,0,0,,Semua orang, sila bertepuk tangan untuk Pengerusi Hong Man-dae.
Dialog: 0,1:03:04.03,1:03:05.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kakitangan Dibenarkan Sahaja{\c}{\i0}
Dialog: 0,1:03:36.68,1:03:37.68,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,1:03:48.57,1:03:50.59,Lalai,,0,0,0,,{\i1}Impian menjadi kenyataan.{\i0}
Dialog: 0,1:03:50.61,1:03:54.47,Lalai,,0,0,0,,Terdapat Mickey Mouse di\NA.S. dan Totoro di Jepun.
Dialog: 0,1:03:54.49,1:03:57.18,Lalai,,0,0,0,,Taman Hiburan Queens, yang\Nakan menjadi yang terbesar...
Dialog: 0,1:03:57.20,1:03:59.10,Lalai,,0,0,0,,di Asia Timur Laut,
Dialog: 0,1:03:59.12,1:04:01.93,Lalai,,0,0,0,,juga mempunyai watak yang disayangi.
Dialog: 0,1:04:01.96,1:04:04.81,Lalai,,0,0,0,,Saya menciptanya sendiri.
Dialog: 0,1:04:04.84,1:04:09.02,Lalai,,0,0,0,,Ini Pengerusi Hong, datuk saya.
Dialog: 0,1:04:09.05,1:04:10.92,Lalai,,0,0,0,,Saya?
Dialog: 0,1:04:12.59,1:04:15.57,Lalai,,0,0,0,,Soo-cheol menyediakan\Nhadiah hari jadi yang hebat untuk Ayah.
Dialog: 0,1:04:15.60,1:04:17.30,Lalai,,0,0,0,,Anda betul.
Dialog: 0,1:04:17.64,1:04:19.79,Lalai,,0,0,0,,{\an8}Saya sangat gembira kerana akhirnya dapat...
Dialog: 0,1:04:19.81,1:04:23.18,Lalai,,0,0,0,,untuk mendedahkannya kepada anda semua.
Dialog: 0,1:04:25.02,1:04:27.56,Lalai,,0,0,0,,Ayuh keluar, Man-sung!
Dialog: 0,1:04:48.42,1:04:50.64,Lalai,,0,0,0,,Kami bercadang untuk menjual\Nbarangan nyanyian manusia ini...
Dialog: 0,1:04:50.66,1:04:52.78,Lalai,,0,0,0,,sebagai mainan, pakaian golf, mug,
Dialog: 0,1:04:52.80,1:04:56.74,Lalai,,0,0,0,,rantai kunci, tikar dan banyak lagi,
Dialog: 0,1:04:56.76,1:04:58.46,Lalai,,0,0,0,,dan sudah tentu,
Dialog: 0,1:04:58.72,1:05:01.68,Lalai,,0,0,0,,kami akan mengeluarkan NFT juga.
Dialog: 0,1:05:09.57,1:05:12.39,Lalai,,0,0,0,,Suruh Soo-cheol berhenti.
Dialog: 0,1:05:15.32,1:05:18.44,Lalai,,0,0,0,,{\i1}Sila berhenti.{\i0}
Dialog: 0,1:05:25.63,1:05:28.13,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Cheon Da-hye{\c}{\i0}
Dialog: 0,1:05:35.89,1:05:38.63,Lalai,,0,0,0,,Saya mendapat keputusan DNA.
Dialog: 0,1:05:52.19,1:05:53.89,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:06:04.87,1:06:06.57,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:06:51.96,1:06:53.27,Lalai,,0,0,0,,Da...
Dialog: 0,1:06:53.30,1:06:55.00,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:07:06.48,1:07:08.22,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:07:09.90,1:07:11.68,Lalai,,0,0,0,,Da-hye!
Dialog: 0,1:07:31.33,1:07:33.03,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:07:50.90,1:07:52.41,Lalai,,0,0,0,,Da-hye!
Dialog: 0,1:07:52.44,1:07:54.81,Lalai,,0,0,0,,Geon-u!
Dialog: 0,1:08:00.32,1:08:04.61,Lalai,,0,0,0,,Anak saya tidak boleh tidur jika saya tidak memasukkannya ke dalam.
Dialog: 0,1:08:05.58,1:08:08.40,Lalai,,0,0,0,,Sila, Da-hye!
Dialog: 0,1:08:14.84,1:08:16.94,Lalai,,0,0,0,,Geon-u.
Dialog: 0,1:08:16.96,1:08:17.94,Lalai,,0,0,0,,Mari kita cuba.
Dialog: 0,1:08:17.96,1:08:20.08,Lalai,,0,0,0,,Hanya satu gigitan, Geon-u.
Dialog: 0,1:08:23.34,1:08:25.04,Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,1:08:29.23,1:08:30.93,Lalai,,0,0,0,,Geon-u.
Dialog: 0,1:08:32.14,1:08:35.10,Lalai,,0,0,0,,Geon-u.
Dialog: 0,1:08:35.86,1:08:37.60,Lalai,,0,0,0,,Geon-u.
Dialog: 0,1:08:37.98,1:08:39.81,Lalai,,0,0,0,,Mama ada di sini.
Dialog: 0,1:08:57.80,1:08:58.80,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Beom-ja{\c}{\i0}
Dialog: 0,1:09:13.73,1:09:14.94,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo{\c}{\i0}
Dialog: 0,1:09:21.44,1:09:24.38,Lalai,,0,0,0,,Kenapa awak telefon saya pada jam ini?
Dialog: 0,1:09:24.41,1:09:26.22,Lalai,,0,0,0,,Maaf. Ia mendesak.
Dialog: 0,1:09:26.24,1:09:27.84,Lalai,,0,0,0,,Adakah anda seorang, tuan?
Dialog: 0,1:09:27.87,1:09:29.55,Default,,0,0,0,,Aku main Janggi. kenapa?
Dialog: 0,1:09:29.58,1:09:31.85,Lalai,,0,0,0,,{\i1}Sila dengar sahaja jika Cik Moh ada bersama anda.{\i0}
Dialog: 0,1:09:31.87,1:09:33.74,Lalai,,0,0,0,,Apa?
Dialog: 0,1:09:35.37,1:09:38.27,Lalai,,0,0,0,,Saya buat ujian DNA pada Cik Moh dan Encik Yoon.
Dialog: 0,1:09:38.29,1:09:41.71,Lalai,,0,0,0,,Terdapat 99% peluang atau\N lebih tinggi bahawa mereka berkaitan.
Dialog: 0,1:09:41.80,1:09:44.53,Lalai,,0,0,0,,{\i1}En. Yoon telah mengumpulkan bahagian anda.{\i0}
Dialog: 0,1:09:44.55,1:09:48.03,Lalai,,0,0,0,,{\i1}Dia sudah mengambil 9.6%\Nof saham pengarah...{\i0}
Dialog: 0,1:09:48.05,1:09:50.41,Lalai,,0,0,0,,{\i1}melalui perjanjian perampasan.{\i0}
Dialog: 0,1:09:50.43,1:09:54.43,Lalai,,0,0,0,,Tuan, anda mesti menarik balik\Nhak boleh tukar sekarang.
Dialog: 0,1:09:55.44,1:09:57.68,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:09:59.27,1:10:01.73,Lalai,,0,0,0,,Saya akan menghubungi anda semula kemudian.
Dialog: 0,1:10:08.57,1:10:10.36,Lalai,,0,0,0,,Checkmate.
Dialog: 0,1:10:13.37,1:10:15.07,Lalai,,0,0,0,,Saya mendapat raja.
Dialog: 0,1:10:23.30,1:10:27.17,Lalai,,0,0,0,,Ada apa? Adakah anda mempunyai sesuatu untuk dikatakan?
Dialog: 0,1:10:31.89,1:10:33.59,Lalai,,0,0,0,,Anda...
Dialog: 0,1:10:35.52,1:10:37.22,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:10:37.65,1:10:39.72,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:10:48.07,1:10:50.88,Lalai,,0,0,0,,Tidak, anda mungkin tidak okay.
Dialog: 0,1:10:50.91,1:10:52.80,Lalai,,0,0,0,,Itulah yang dilakukan oleh dadah.
Dialog: 0,1:10:52.83,1:10:57.39,Lalai,,0,0,0,,Sepuluh minit dalam sistem pernafasan,\Dan anda perlahan-lahan akan lumpuh.
Dialog: 0,1:10:57.41,1:10:59.57,Lalai,,0,0,0,,Jadi memang benar.
Dialog: 0,1:10:59.83,1:11:01.53,Lalai,,0,0,0,,Sungguh luar biasa.
Dialog: 0,1:11:08.63,1:11:10.63,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:11:10.72,1:11:12.71,Lalai,,0,0,0,,Anda tidak akan mati serta-merta.
Dialog: 0,1:11:16.14,1:11:19.29,Lalai,,0,0,0,,Jika anda berbuat demikian, ini tidak akan berguna.
Dialog: 0,1:11:19.31,1:11:22.58,Lalai,,0,0,0,,Saya hanya boleh menjadi penjaga anda yang sah,
Dialog: 0,1:11:22.61,1:11:27.00,Lalai,,0,0,0,,dan katakan, jika anda koma,
Dialog: 0,1:11:27.03,1:11:28.67,Lalai,,0,0,0,,jadi...
Dialog: 0,1:11:28.70,1:11:29.84,Lalai,,0,0,0,,koma...
Dialog: 0,1:11:29.86,1:11:32.94,Lalai,,0,0,0,,selama dua hingga tiga bulan sebelum anda mati.
Dialog: 0,1:11:34.24,1:11:36.36,Lalai,,0,0,0,,Bolehkah anda melakukannya untuk saya?
Dialog: 0,1:12:03.19,1:12:04.37,Lalai,,0,0,0,,Nampak?
Dialog: 0,1:12:04.40,1:12:08.23,Lalai,,0,0,0,,Hyun-woo dan Beom-ja betul,
Dialog: 0,1:12:08.49,1:12:12.36,Lalai,,0,0,0,,jadi mengapa anda mempercayai saya dan bukannya mereka?
Dialog: 0,1:12:25.54,1:12:31.08,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Selamat hari lahir kepada anda{\i0} ♫{\c}
Dialog: 0,1:12:31.22,1:12:34.90,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Selamat hari lahir, sayang Beom-ja{\i0} ♫{\c}
Dialog: 0,1:12:34.93,1:12:37.70,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Selamat hari lahir kepada anda{\i0} ♫{\c}
Dialog: 0,1:12:37.72,1:12:39.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mari ke sini.{\c}{\i0}
Dialog: 0,1:12:44.69,1:12:47.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan ambil sekarang. Sila senyum.{\c}{\i0}
Dialog: 0,1:12:48.78,1:12:50.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sebut kimchi pada kiraan tiga.{\c}{\i0}
Dialog: 0,1:12:50.61,1:12:54.34,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baik. Satu, dua, tiga.{\c}{\i0}
Dialog: 0,1:12:54.37,1:12:56.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kimchi.{\c}{\i0}
Dialog: 0,1:13:08.80,1:13:11.32,Lalai,,0,0,0,,Ada apa dengan kamu semua? Adakah anda tidak tahu siapa saya?
Dialog: 0,1:13:11.34,1:13:13.40,Lalai,,0,0,0,,Mengapa saya tidak dapat melihatnya?
Dialog: 0,1:13:13.43,1:13:16.74,Lalai,,0,0,0,,Hanya mereka yang dibenarkan oleh\penjaganya yang sah boleh masuk.
Dialog: 0,1:13:16.76,1:13:18.20,Lalai,,0,0,0,,- Alih.\N- Tidak, tuan.
Dialog: 0,1:13:18.22,1:13:19.89,Lalai,,0,0,0,,- Tidak, tuan!\N- Baik.
Dialog: 0,1:13:19.92,1:13:20.91,Lalai,,0,0,0,,Hei.
Dialog: 0,1:13:20.93,1:13:24.75,Lalai,,0,0,0,,Kami anak pengerusi,\Njadi siapa penjaga ini?
Dialog: 0,1:13:24.77,1:13:26.16,Lalai,,0,0,0,,- Alih.\N- Tidak, puan.
Dialog: 0,1:13:26.19,1:13:28.10,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:13:37.07,1:13:38.05,Lalai,,0,0,0,,Awak perempuan.
Dialog: 0,1:13:38.08,1:13:40.72,Lalai,,0,0,0,,Apa yang telah anda lakukan?
Dialog: 0,1:13:40.74,1:13:42.86,Lalai,,0,0,0,,Beri saya satu minit.
Dialog: 0,1:13:43.08,1:13:44.39,Lalai,,0,0,0,,Apa yang berlaku, Peguam Han?
Dialog: 0,1:13:44.42,1:13:48.45,Lalai,,0,0,0,,Pengerusi mengalami jantung mendadak\Nattack dan menerima rawatan,
Dialog: 0,1:13:48.59,1:13:50.77,Lalai,,0,0,0,,tetapi dia kini tidak sedarkan diri.
Dialog: 0,1:13:50.80,1:13:52.75,Lalai,,0,0,0,,Tidak, Bapa!
Dialog: 0,1:13:53.42,1:13:59.09,Lalai,,0,0,0,,Dan Penjaga sahnya semasa ialah Cik Moh Seul-hee.
Dialog: 0,1:14:02.85,1:14:03.95,Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,1:14:03.98,1:14:05.89,Lalai,,0,0,0,,Betul.
Dialog: 0,1:14:09.06,1:14:12.67,Lalai,,0,0,0,,Pengerusi baru-baru ini memberikan\Nkuasa wakil kepadanya.
Dialog: 0,1:14:12.69,1:14:16.71,Lalai,,0,0,0,,{\an8}Menurut dokumen ini,\NM. Moh adalah penjaganya yang sah,
Dialog: 0,1:14:16.74,1:14:20.55,Lalai,,0,0,0,,dan mempunyai hak untuk membuat\Nkeputusan sebagai gantinya,
Dialog: 0,1:14:20.58,1:14:22.68,Lalai,,0,0,0,,memandangkan dia tidak sedarkan diri sekarang.
Dialog: 0,1:14:22.70,1:14:27.06,Lalai,,0,0,0,,Jika ini terbukti rekaan,\Anda akan didakwa dengan pemalsuan, gunakan,
Dialog: 0,1:14:27.08,1:14:29.73,Lalai,,0,0,0,,dan membuat entri tidak benar\N dalam dokumen rasmi ini.
Dialog: 0,1:14:29.75,1:14:33.27,Lalai,,0,0,0,,Saya ada video dia menandatangani kertas ini.
Dialog: 0,1:14:33.30,1:14:35.00,Lalai,,0,0,0,,Saya akan menghantarnya kepada anda.
Dialog: 0,1:14:35.05,1:14:36.03,Default,,0,0,0,,- Saya pening.\N- Sayang.
Dialog: 0,1:14:36.05,1:14:37.96,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:14:40.80,1:14:44.45,Lalai,,0,0,0,,Dia pasti tidak mempercayai anak-anaknya\Nuntuk memberi saya hak untuk bertindak sebagai gantinya,
Dialog: 0,1:14:44.48,1:14:47.16,Lalai,,0,0,0,,sekiranya perkara seperti ini berlaku.
Dialog: 0,1:14:47.19,1:14:50.37,Lalai,,0,0,0,,Anda hanya berminat untuk\Nmengambil seberapa banyak wang daripadanya...
Dialog: 0,1:14:50.40,1:14:51.92,Lalai,,0,0,0,,seboleh-bolehnya.
Dialog: 0,1:14:51.94,1:14:55.00,Lalai,,0,0,0,,Pengerusi memilih syarikat...
Dialog: 0,1:14:55.03,1:14:57.71,Lalai,,0,0,0,,dia membesarkan seluruh hidupnya atas keluarganya sendiri.
Dialog: 0,1:14:57.74,1:15:00.52,Lalai,,0,0,0,,Saya tahu apa yang dia mahukan lebih daripada anda semua.
Dialog: 0,1:15:00.87,1:15:02.65,Lalai,,0,0,0,,Saya ikut kehendak dia.
Dialog: 0,1:15:02.99,1:15:05.15,Lalai,,0,0,0,,"Kehendaknya"?
Dialog: 0,1:15:05.75,1:15:07.82,Lalai,,0,0,0,,"Kehendaknya"?
Dialog: 0,1:15:08.42,1:15:11.33,Lalai,,0,0,0,,Hei, saya tidak tahu tentang itu,
Dialog: 0,1:15:11.54,1:15:13.31,Lalai,,0,0,0,,tetapi saya tahu apa yang anda mahukan.
Dialog: 0,1:15:13.34,1:15:15.60,Lalai,,0,0,0,,Anda dan anak anda,\NYoon Eun-sung, akan menggunakan...
Dialog: 0,1:15:15.62,1:15:17.65,Lalai,,0,0,0,, kuasa wakil untuk memihak kepada anda!
Dialog: 0,1:15:17.67,1:15:19.50,Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,1:15:20.39,1:15:23.20,Lalai,,0,0,0,,Yoon Eun-sung? Yoon Eun-sung?
Dialog: 0,1:15:23.22,1:15:24.28,Lalai,,0,0,0,,Betul, tuan.
Dialog: 0,1:15:24.31,1:15:26.55,Lalai,,0,0,0,,Kami menyemak keputusan DNA.
Dialog: 0,1:15:29.23,1:15:30.96,Lalai,,0,0,0,,Ya, Encik Yoon ialah anak saya.
Dialog: 0,1:15:30.98,1:15:33.29,Lalai,,0,0,0,,Kenapa? Adakah itu salah?
Dialog: 0,1:15:33.32,1:15:35.85,Lalai,,0,0,0,,Adakah itu mengubah apa-apa?
Dialog: 0,1:15:36.19,1:15:37.57,Lalai,,0,0,0,,Hei!
Dialog: 0,1:15:37.59,1:15:38.59,Lalai,,0,0,0,,Sialan!
Dialog: 0,1:15:38.61,1:15:40.88,Lalai,,0,0,0,,Beom-ja, teruskan berlakon comel,
Dialog: 0,1:15:40.91,1:15:43.25,Lalai,,0,0,0,,dan saya mungkin diam-diam memindahkan\Bapa awak ke bilik lain,
Dialog: 0,1:15:43.28,1:15:46.01,Lalai,,0,0,0,,dan tidak memberi anda\Npeluang untuk mengucapkan selamat tinggal kepadanya.
Dialog: 0,1:15:46.04,1:15:47.86,Lalai,,0,0,0,,Anda tidak percaya saya?
Dialog: 0,1:16:00.22,1:16:03.03,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini adalah kejadian yang belum pernah terjadi sebelumnya\N dalam industri perniagaan.{\c}{\i0}
Dialog: 0,1:16:03.05,1:16:04.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Mesyuarat pemegang saham...{\c}{\i0}
Dialog: 0,1:16:04.76,1:16:07.87,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}bersetuju untuk mengambil\Nrights keluarga Queens berbanding syarikat mereka sendiri.{\c}{\i0}
Dialog: 0,1:16:07.89,1:16:11.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pione Investment, sebuah kompleks peranginan baharu pelabur\Nin Queens,{\c}{\i0}
Dialog: 0,1:16:11.52,1:16:12.87,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}membeli 14.7%{\c}{\i0}
Dialog: 0,1:16:12.90,1:16:16.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}saham Queens pada\Nawal bulan ini,{\c}{\i0}
Dialog: 0,1:16:16.11,1:16:18.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}dan mengumumkan penyertaannya\N dalam pengurusan.{\c}{\i0}
Dialog: 0,1:16:18.53,1:16:21.84,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pione kemudian mengumpulkan sejumlah\Nof 24.3% daripada saham.{\c}{\i0}
Dialog: 0,1:16:21.86,1:16:26.18,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Setelah Pengerusi Hong tidak sedarkan diri\Ndisebabkan serangan jantung mengejut,{\c}{\i0}
Dialog: 0,1:16:26.20,1:16:28.81,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pione menggunakan hak boleh tukar,{\c}{\i0}
Dialog: 0,1:16:28.83,1:16:30.68,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}dan mengambil 6.7% sahamnya.{\c}{\i0}
Dialog: 0,1:16:30.71,1:16:32.14,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kini dengan jumlah 31%,{\c}{\i0}
Dialog: 0,1:16:32.17,1:16:36.06,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}mereka telah menjadi pemegang saham kedua terbesar.{\c}{\i0}
Dialog: 0,1:16:36.09,1:16:39.19,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pione kemudian menganjurkan\Nmesyuarat pemegang saham sementara.{\c}{\i0}
Dialog: 0,1:16:39.21,1:16:41.78,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dengan surat kuasa wakil, Cik Moh Seul-hee...{\c}{\i0}
Dialog: 0,1:16:41.80,1:16:44.40,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}berpihak pada Pelaburan Pione.{\c}{\i0}
Dialog: 0,1:16:44.43,1:16:47.70,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}68.8% yang mengejutkan menyokong\Npenyingkiran keluarga Ratu,{\c}{\i0}
Dialog: 0,1:16:47.72,1:16:52.45,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}manakala hanya 31.2% menentangnya.{\c}{\i0}
Dialog: 0,1:16:52.48,1:16:55.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Industri perniagaan terpegun\Noleh peristiwa yang tidak pernah berlaku sebelum ini,{\c}{\i0}
Dialog: 0,1:16:55.81,1:16:58.29,Lalai,,0,0,0,,di mana sebuah keluarga konglomerat kehilangan kuasa...
Dialog: 0,1:16:58.32,1:17:01.73,Lalai,,0,0,0,,disebabkan tentangan daripada pemegang saham.
Dialog: 0,1:17:02.24,1:17:04.24,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:17:11.37,1:17:13.79,Lalai,,0,0,0,,{\an8}{\i1}Apa yang akan berlaku kepada keluarga sekarang?{\i0}
Dialog: 0,1:17:13.82,1:17:14.85,Lalai,,0,0,0,,{\an8}{\i1}Siapa tahu?{\i0}
Dialog: 0,1:17:14.88,1:17:17.06,Lalai,,0,0,0,,{\an8}{\i1}Pemberita pun tidak tahu di mana mereka berada.{\i0}
Dialog: 0,1:17:17.09,1:17:19.15,Lalai,,0,0,0,,{\i1}Mereka tiada di rumah mahupun di hotel.{\i0}
Dialog: 0,1:17:19.17,1:17:21.82,Lalai,,0,0,0,,{\i1}Mereka tidak boleh meninggalkan\Nnegara kerana siasatan.{\i0}
Dialog: 0,1:17:21.84,1:17:25.13,Lalai,,0,0,0,,{\i1}Anda betul. Di manakah mereka berada?{\i0}
Dialog: 0,1:17:39.15,1:17:40.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,1:17:52.66,1:17:54.43,Lalai,,0,0,0,,Hei.
Dialog: 0,1:17:54.46,1:17:57.64,Lalai,,0,0,0,,- Apa yang kamu lakukan di sini?\N- Du-gwan, saya gembira kamu ada di sini.
Dialog: 0,1:17:57.67,1:17:59.44,Lalai,,0,0,0,,Saya akan menghantar teks kepada anda.
Dialog: 0,1:17:59.46,1:18:00.56,Lalai,,0,0,0,,Du-gwan.
Dialog: 0,1:18:00.59,1:18:02.23,Lalai,,0,0,0,,Berapa harga sosej?
Dialog: 0,1:18:02.26,1:18:03.73,Lalai,,0,0,0,,Bagaimana anda membuka kedai?
Dialog: 0,1:18:03.76,1:18:05.74,Lalai,,0,0,0,,Kod laluan ialah 0070.
Dialog: 0,1:18:05.76,1:18:07.82,Lalai,,0,0,0,,Semua orang tahu itu.
Dialog: 0,1:18:07.84,1:18:09.41,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:18:09.43,1:18:10.53,Lalai,,0,0,0,,Saya patut menukarnya.
Dialog: 0,1:18:10.56,1:18:13.58,Lalai,,0,0,0,,Penduduk kampung ingin\Nmembayar bil runcit mereka yang belum dibayar,
Dialog: 0,1:18:13.60,1:18:15.50,Lalai,,0,0,0,,jadi kami menjalankan tempat itu untuk anda.
Dialog: 0,1:18:15.52,1:18:16.91,Lalai,,0,0,0,,Lihat ini.
Dialog: 0,1:18:16.94,1:18:19.79,Lalai,,0,0,0,,- Di sini.\N- Kami menulis semuanya.
Dialog: 0,1:18:19.82,1:18:22.78,Lalai,,0,0,0,,Mereka tidak pernah singgah apabila saya mendesak mereka,
Dialog: 0,1:18:22.80,1:18:23.80,Lalai,,0,0,0,,jadi kenapa sekarang?
Dialog: 0,1:18:23.82,1:18:27.65,Lalai,,0,0,0,,Saya rasa mereka mahu\Nmembantu selepas menonton berita.
Dialog: 0,1:18:34.79,1:18:35.85,Lalai,,0,0,0,,Anda tahu apa?
Dialog: 0,1:18:35.87,1:18:39.77,Lalai,,0,0,0,,Hari ini suram, jadi bagaimana\Namun beberapa {\i1}ramyun{\i0} dan soju?
Dialog: 0,1:18:39.79,1:18:40.94,Lalai,,0,0,0,,Bunyinya bagus.
Dialog: 0,1:18:40.96,1:18:42.66,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:18:44.72,1:18:46.42,Lalai,,0,0,0,,Sore...
Dialog: 0,1:18:51.43,1:18:53.12,Lalai,,0,0,0,,Di sini.
Dialog: 0,1:18:53.14,1:18:54.84,Lalai,,0,0,0,,Berhati-hati.
Dialog: 0,1:18:55.31,1:18:57.20,Lalai,,0,0,0,,Aduh, nampak sedap.
Dialog: 0,1:18:57.23,1:18:58.79,Lalai,,0,0,0,,Makan.
Dialog: 0,1:18:58.81,1:19:00.46,Lalai,,0,0,0,,Du-gwan.
Dialog: 0,1:19:00.48,1:19:04.13,Lalai,,0,0,0,,Mengapa anda menutup\Nkedai atas sesuatu yang remeh?
Dialog: 0,1:19:04.15,1:19:06.10,Lalai,,0,0,0,,Saya kecewa dengan awak.
Dialog: 0,1:19:07.45,1:19:10.51,Lalai,,0,0,0,,Mengapa anda bersembunyi?
Dialog: 0,1:19:10.53,1:19:13.05,Lalai,,0,0,0,,Jujurlah. Bukan salah awak.
Dialog: 0,1:19:13.08,1:19:15.35,Lalai,,0,0,0,,Hyun-woo dipersalahkan.
Dialog: 0,1:19:15.37,1:19:17.77,Lalai,,0,0,0,,Hyun-woo tidak melakukan apa-apa kesalahan.
Dialog: 0,1:19:17.79,1:19:18.89,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,1:19:18.92,1:19:21.49,Lalai,,0,0,0,,Dia cuma mangsa taufan hebat ini.
Dialog: 0,1:19:30.47,1:19:32.25,Lalai,,0,0,0,,Du-gwan.
Dialog: 0,1:19:34.06,1:19:36.33,Lalai,,0,0,0,,Anda patut tahu, sebagai petani sendiri.
Dialog: 0,1:19:36.35,1:19:40.58,Lalai,,0,0,0,,Tanaman tidak menumbuhkan akar yang mendalam\Jika anda menanamnya dalam angin,
Dialog: 0,1:19:40.60,1:19:42.00,Lalai,,0,0,0,,kerana mereka tidak memerlukannya,
Dialog: 0,1:19:42.02,1:19:47.77,Lalai,,0,0,0,,tetapi yang ditanam di tengah angin kencang\Nare berakar umbi dan tidak dapat dikalahkan.
Dialog: 0,1:19:48.65,1:19:54.23,Lalai,,0,0,0,,Dalam erti kata itu, taufan boleh membantu dalam kehidupan.
Dialog: 0,1:19:55.08,1:19:58.51,Lalai,,0,0,0,,Anda seperti salah seorang daripada mereka.
Dialog: 0,1:19:58.54,1:20:00.22,Lalai,,0,0,0,,Seorang ahli falsafah.
Dialog: 0,1:20:00.25,1:20:01.95,Lalai,,0,0,0,,Hei.
Dialog: 0,1:20:02.00,1:20:06.73,Lalai,,0,0,0,,Jika anda sangat menyukai taufan,\Anda boleh mengalaminya sendiri.
Dialog: 0,1:20:06.76,1:20:11.25,Lalai,,0,0,0,,Rasanya hati saya memikirkan anak saya...
Dialog: 0,1:20:12.05,1:20:15.34, Lalai,,0,0,0,, bersendirian dalam bencana itu!
Dialog: 0,1:20:16.93,1:20:19.01,Lalai,,0,0,0,,- Du-gwan...\N- Tinggalkan saya.
Dialog: 0,1:20:19.73,1:20:22.18,Lalai,,0,0,0,,Ada beberapa {\i1}ramyun{\i0} juga.
Dialog: 0,1:20:22.73,1:20:24.64,Lalai,,0,0,0,,Apa itu?
Dialog: 0,1:20:25.32,1:20:27.10,Lalai,,0,0,0,,Ada apa dengan cahaya?
Dialog: 0,1:20:28.03,1:20:30.19,Lalai,,0,0,0,,Siapa di sini pada jam ini?
Dialog: 0,1:20:32.16,1:20:34.36,Lalai,,0,0,0,,- Apa?\N- Adakah itu Hyun-woo?
Dialog: 0,1:20:34.45,1:20:35.58,Lalai,,0,0,0,,Siapa?
Dialog: 0,1:20:35.60,1:20:36.64,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,1:20:36.66,1:20:39.11,Lalai,,0,0,0,,Hei, Hyun-woo!
Dialog: 0,1:20:39.41,1:20:42.18,Lalai,,0,0,0,,Saya tidak tahu awak akan datang.
Dialog: 0,1:20:42.21,1:20:45.03,Lalai,,0,0,0,,Ayah, ianya mendesak.
Dialog: 0,1:20:45.21,1:20:46.40,Lalai,,0,0,0,,Hei, Hyun-woo.
Dialog: 0,1:20:46.42,1:20:48.11, Lalai,,0,0,0,,Mengapa kamu tidak mengangkatnya?
Dialog: 0,1:20:48.13,1:20:51.15,Lalai,,0,0,0,,Awak tak makan sedap ke?
Dialog: 0,1:20:51.17,1:20:52.94,Lalai,,0,0,0,,Anda kelihatan teruk.
Dialog: 0,1:20:52.97,1:20:54.32,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:20:54.34,1:20:55.86,Lalai,,0,0,0,,Jangan risau sangat.
Dialog: 0,1:20:55.89,1:20:57.62,Lalai,,0,0,0,,Saya gembira awak tinggalkan keluarga gila itu.
Dialog: 0,1:20:57.64,1:21:00.08,Lalai,,0,0,0,,Lihat apa yang berlaku kepada\Nmereka selepas mereka menghalau anda.
Dialog: 0,1:21:00.10,1:21:02.16,Lalai,,0,0,0,,- Karma akan sentiasa menemui jalannya.\N- Mi-seon.
Dialog: 0,1:21:02.19,1:21:03.75,Lalai,,0,0,0,,- Tunggu...\N- Anda bertaruh.
Dialog: 0,1:21:03.77,1:21:07.79,Lalai,,0,0,0,,Saya sangat lega apabila mendengar\Nbahawa keluarga itu hancur.
Dialog: 0,1:21:07.82,1:21:09.42,Lalai,,0,0,0,,Layankan mereka dengan betul!
Dialog: 0,1:21:09.44,1:21:13.94,Lalai,,0,0,0,,Apa pun, lupakan itu\Nsly musang dan hidup bahagia.
Dialog: 0,1:21:34.05,1:21:35.70,Lalai,,0,0,0,,Musang licik...
Dialog: 0,1:21:35.72,1:21:37.42,Lalai,,0,0,0,,ada di sini juga.
Dialog: 0,1:21:38.68,1:21:40.51,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:21:40.85,1:21:43.18,Lalai,,0,0,0,,Anda di sini juga.
Dialog: 0,1:21:44.39,1:21:46.76,Lalai,,0,0,0,,Bukan dia sahaja.
Dialog: 0,1:22:49.75,1:22:51.31,Lalai,,0,0,0,,Saya tahu,
Dialog: 0,1:22:51.34,1:22:53.11,Lalai,,0,0,0,,tetapi saya mahukan kehidupan itu.
Dialog: 0,1:22:53.13,1:22:55.69,Lalai,,0,0,0,,Apa yang anda maksudkan? Anda mahu itu?
Dialog: 0,1:22:55.72,1:22:57.15,Lalai,,0,0,0,,Adakah anda mempunyai sindrom Stockholm?
Dialog: 0,1:22:57.18,1:22:58.78,Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,1:22:58.80,1:23:00.71,Lalai,,0,0,0,,Saya cuma mahu...
Dialog: 0,1:23:01.22,1:23:03.84, Lalai,,0,0,0,,untuk kekal dengan Hae-in.
Dialog: 0,1:23:15.65,1:23:17.51,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:23:17.53,1:23:19.13,Lalai,,0,0,0,,Kebaikan, datang lagi.
Dialog: 0,1:23:19.16,1:23:21.02,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:23:42.60,1:23:44.07,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:23:44.10,1:23:45.88,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:23:46.02,1:23:48.72,Lalai,,0,0,0,,Kenapa awak menangis?
Dialog: 0,1:23:57.36,1:23:58.88,Lalai,,0,0,0,,Suami saya.
Dialog: 0,1:23:58.90,1:24:00.81,Lalai,,0,0,0,,Ya?
Dialog: 0,1:24:02.03,1:24:04.73,Lalai,,0,0,0,,Dia mahu kekal dengan saya.
Dialog: 0,1:24:06.29,1:24:09.11,Lalai,,0,0,0,,Dan adakah itu menyedihkan?
Dialog: 0,1:24:10.87,1:24:12.83,Lalai,,0,0,0,,Sudah tentu,
Dialog: 0,1:24:15.21,1:24:17.71,Lalai,,0,0,0,,kerana mendengar itu membuatkan saya mahu...
Dialog: 0,1:24:20.30,1:24:22.63,Lalai,,0,0,0,,untuk hidup.
Dialog: 0,1:24:24.05,1:24:26.84,Lalai,,0,0,0,,Kemudian hidup. Apa yang menghalang anda?
Dialog: 0,1:24:27.06,1:24:30.34,Lalai,,0,0,0,,Saya juga terdesak untuk hidup.
Dialog: 0,1:24:32.44,1:24:34.31,Lalai,,0,0,0,,Saya mahu melekat...
Dialog: 0,1:24:34.69,1:24:37.18,Lalai,,0,0,0,,dengan dia.
Dialog: 0,1:24:40.65,1:24:43.90,Lalai,,0,0,0,,Astaga. Awak mabuk.
Dialog: 0,1:24:56.63,1:24:58.95,Lalai,,0,0,0,,Saya mahu hidup.
Dialog: 0,1:24:59.13,1:25:01.04,Lalai,,0,0,0,,Terdesak.
Dialog: 0,1:25:11.52,1:25:14.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:25:44.68,1:25:46.53,Lalai,,0,0,0,,{\an8}{\i1}Mereka mungkin kembali bersama?{\i0}
Dialog: 0,1:25:46.55,1:25:49.13,Lalai,,0,0,0,,{\an8}{\i1}Adakah anda mempunyai perasaan antara satu sama lain?{\i0}
Dialog: 0,1:25:49.56,1:25:51.24,Lalai,,0,0,0,,{\an8}{\i1}Hanya minum dari cerek!{\i0}
Dialog: 0,1:25:51.27,1:25:53.83,Lalai,,0,0,0,,{\an8}{\i1}Ini adalah twist terbaik yang pernah ada\Nsejak "The Sixth Sense."{\i0}
Dialog: 0,1:25:53.85,1:25:57.35,Lalai,,0,0,0,,{\an8}- {\i1}Dia kelihatan seperti Leslie Cheung.\N- Saya dengar dia seorang psikopat.{\i0}
Dialog: 0,1:25:58.36,1:25:59.33,Lalai,,0,0,0,,{\an8}{\i1}Apa?{\i0}
Dialog: 0,1:25:59.36,1:26:01.71,Lalai,,0,0,0,,{\an8}{\i1}Adakah dia dilahirkan untuk mencintai saya atau sesuatu?{\i0}
Dialog: 0,1:26:01.73,1:26:04.55,Lalai,,0,0,0,,{\an8}{\i1}Di mana dia? Hae-in.{\i0}
Dialog: 0,1:26:04.57,1:26:07.34,Lalai,,0,0,0,,{\an8}- {\i1}Apa sahaja yang berlaku kepada saya atau keluarga saya...\N- Hae-in ialah...{\i0}
Dialog: 0,1:26:07.37,1:26:08.88,Lalai,,0,0,0,,{\an8}{\i1}tiada kaitan dengan anda.{\i0}
Dialog: 0,1:26:08.91,1:26:10.64,Lalai,,0,0,0,,{\an8}{\i1}Jika saya boleh membuktikannya,{\i0}
Dialog: 0,1:26:10.66,1:26:14.15,Lalai,,0,0,0,,{\an8}{\i1}Saya akan menggunakan yang sama\Ntactic Yoon Eun-sung lakukan.{\i0}
