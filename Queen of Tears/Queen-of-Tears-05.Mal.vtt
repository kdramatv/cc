Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:03.27,0:01:05.30, Lalai,,0,0,0,,Saya minta maaf saya menjerit.
Dialog: 0,0:01:13.19,0:01:14.89, Lalai,,0,0,0,, Hakikatnya...
Dialog: 0,0:01:16.74,0:01:18.52, Lalai,,0,0,0,,Saya tidak ingat.
Dialog: 0,0:01:19.99,0:01:22.94,Lalai,,0,0,0,,Saya tidak ingat sama sekali mengapa saya berada di sana.
Dialog: 0,0:01:27.12,0:01:29.24,Lalai,,0,0,0,,Saya berada di hadapan rumah awak,
Dialog: 0,0:01:29.54,0:01:32.54, Lalai,,0,0,0,,kemudian tiba-tiba saya berada di tempat lain.
Dialog: 0,0:01:36.47,0:01:39.08,Lalai,,0,0,0,,Saya tidak tahu bila saya pergi ke sana,
Dialog: 0,0:01:40.97,0:01:43.01, Lalai,,0,0,0,, atau bagaimana.
Dialog: 0,0:01:46.18,0:01:47.89, Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,0:01:49.48,0:01:51.26, Lalai,,0,0,0,,Saya...
Dialog: 0,0:01:55.82,0:01:57.52,Lalai,,0,0,0,,sangat takut.
Dialog: 0,0:03:41.09,0:03:44.04,Lalai,,0,0,0,,By the way, kenapa awak datang sendiri ke sini?
Dialog: 0,0:03:47.22,0:03:49.84, Lalai,,0,0,0,,Kakak awak menghantar mesej kepada saya.
Dialog: 0,0:03:50.06,0:03:53.18, Lalai,,0,0,0,,Dia kata ayah kamu kalah dalam pilihan raya.
Dialog: 0,0:03:53.35,0:03:56.81, Lalai,,0,0,0,,Saingannya memenangi pengundi dengan makanan.
Dialog: 0,0:03:59.53,0:04:01.98, Lalai,,0,0,0,,Itu sebab awak datang?
Dialog: 0,0:04:03.36,0:04:05.67, Lalai,,0,0,0,,Maksud saya, dia kalah...
Dialog: 0,0:04:05.70,0:04:08.01, Lalai,,0,0,0,,kepada sup daging babi dan nasi.
Dialog: 0,0:04:08.03,0:04:09.43, Lalai,,0,0,0,,Bagaimana saya boleh duduk diam?
Dialog: 0,0:04:09.45,0:04:13.74, Lalai,,0,0,0,,Jadi itulah sebabnya anda menyerang balas\Ndengan daging lembu dan udang galah?
Dialog: 0,0:04:14.50,0:04:16.44, Lalai,,0,0,0,,Anda sepatutnya menyaksikan...
Dialog: 0,0:04:16.46,0:04:19.66, Lalai,,0,0,0,,bagaimana saya tanpa belas kasihan mengalahkan 200 mangkuk sup.
Dialog: 0,0:04:47.07,0:04:48.30,Lalai,,0,0,0,,{\i1}Hae-in!{\i0}
Dialog: 0,0:04:48.32,0:04:50.43, Lalai,,0,0,0,,{\i1}- Hae-in!\N- Hae-in!{\i0}
Dialog: 0,0:04:50.45,0:04:51.55,Lalai,,0,0,0,,{\i1}Hae-in!{\i0}
Dialog: 0,0:04:51.58,0:04:53.57, Lalai,,0,0,0,,Adakah dia di sana?
Dialog: 0,0:04:53.83,0:04:54.85, Lalai,,0,0,0,,Tidak, dia tidak.
Dialog: 0,0:04:54.87,0:04:56.68,Lalai,,0,0,0,,- Hae-in!\N- Awak belum jumpa dia lagi?
Dialog: 0,0:04:56.71,0:04:57.89, Lalai,,0,0,0,,Di mana dia?
Dialog: 0,0:04:57.92,0:04:59.27, Lalai,,0,0,0,,Mana mungkin dia?
Dialog: 0,0:04:59.29,0:05:00.48, Lalai,,0,0,0,, Hae-in saya yang malang!
Dialog: 0,0:05:00.50,0:05:01.86, Lalai,,0,0,0,,Hubungi polis!
Dialog: 0,0:05:01.88,0:05:03.65, Lalai,,0,0,0,,- Kita terpaksa!\N- Hae-in!
Dialog: 0,0:05:03.67,0:05:05.23, Lalai,,0,0,0,,- Hae-in!\N- Awak kat mana?
Dialog: 0,0:05:05.26,0:05:06.40, Lalai,,0,0,0,,Hae-in!
Dialog: 0,0:05:06.43,0:05:07.97, Lalai,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:07.99,0:05:09.03, Lalai,,0,0,0,,Hae-in!
Dialog: 0,0:05:09.05,0:05:10.11, Lalai,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:10.14,0:05:12.24, Lalai,,0,0,0,,- Hae-in!\N- Ke mana dia pergi?
Dialog: 0,0:05:12.27,0:05:14.16, Lalai,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:14.18,0:05:16.45, Lalai,,0,0,0,,- Hae-in!\N- Hae-in!
Dialog: 0,0:05:16.48,0:05:18.05,Lalai,,0,0,0,,Hae-in!
Dialog: 0,0:05:18.65,0:05:20.35, Lalai,,0,0,0,, Astaga!
Dialog: 0,0:05:20.40,0:05:21.92, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:05:21.94,0:05:23.84, Lalai,,0,0,0,,Ya ampun, sayangku!
Dialog: 0,0:05:23.86,0:05:27.02, Lalai,,0,0,0,, Kebaikan! Di sini anda berada!
Dialog: 0,0:05:31.91,0:05:32.89,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 5{\c}{\i0}
Dialog: 0,0:05:32.91,0:05:35.18,Lalai,,0,0,0,,{\an8}Kami benar-benar terkejut.
Dialog: 0,0:05:35.20,0:05:37.82, Lalai,,0,0,0,,{\an8}Di manakah anda?
Dialog: 0,0:05:39.96,0:05:42.73, Lalai,,0,0,0,,{\an8}Berhenti bertanya kepadanya.
Dialog: 0,0:05:42.75,0:05:44.36,Lalai,,0,0,0,,{\an8}Ayah, kamu patut tidur.
Dialog: 0,0:05:44.38,0:05:45.36, Lalai,,0,0,0,,{\an8}Baiklah.
Dialog: 0,0:05:45.38,0:05:47.40,Lalai,,0,0,0,,{\an8}Jangan kisah kami.
Dialog: 0,0:05:47.43,0:05:50.32,Lalai,,0,0,0,,{\an8}Orang di sini tidur awal,
Dialog: 0,0:05:50.34,0:05:52.45,Lalai,,0,0,0,,{\an8}- jadi buat diri sendiri di rumah.\N- Dia betul.
Dialog: 0,0:05:52.47,0:05:54.20,Lalai,,0,0,0,,{\an8}- Anggap kami tidak kelihatan.\N- Betul.
Dialog: 0,0:05:54.22,0:05:55.49, Lalai,,0,0,0,,{\an8}Sukar dipercayai.
Dialog: 0,0:05:55.52,0:05:57.87,Lalai,,0,0,0,,{\an8}Bagaimanakah anda boleh menjadi halimunan apabila anda berada di sini? Pergi.
Dialog: 0,0:05:57.89,0:05:59.91,Lalai,,0,0,0,,{\an8}- Jom. Malam.\N- Malam.
Dialog: 0,0:05:59.94,0:06:01.64, Lalai,,0,0,0,,{\an8}Selamat malam.
Dialog: 0,0:06:19.12,0:06:20.95, Lalai,,0,0,0,,Saya perlu mengeringkan rambut saya.
Dialog: 0,0:06:22.46,0:06:23.69, Lalai,,0,0,0,,Adakah pengering rambut?
Dialog: 0,0:06:23.71,0:06:25.75, Lalai,,0,0,0,, Satu minit.
Dialog: 0,0:06:32.55,0:06:35.67, Lalai,,0,0,0,,Ini agak lama.
Dialog: 0,0:06:36.06,0:06:37.76, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:06:44.11,0:06:46.23, Lalai,,0,0,0,,Ia tidak berfungsi.
Dialog: 0,0:06:46.78,0:06:49.80, Lalai,,0,0,0,,Anda perlu menekan bahagian bawah.
Dialog: 0,0:06:49.82,0:06:51.94, Lalai,,0,0,0,,Macam ini?
Dialog: 0,0:06:53.07,0:06:54.82, Lalai,,0,0,0,,Pegang kabel.
Dialog: 0,0:06:56.66,0:06:58.57, Lalai,,0,0,0,,Biar saya buat.
Dialog: 0,0:07:02.13,0:07:05.20, Lalai,,0,0,0,,Ada cara untuk melakukan ini.
Dialog: 0,0:07:37.58,0:07:40.03, Lalai,,0,0,0,,- Semuanya kering sekarang.\N- Betul.
Dialog: 0,0:07:40.54,0:07:42.70, Lalai,,0,0,0,,Saya rasa awak baik.
Dialog: 0,0:07:56.55,0:07:58.26, Lalai,,0,0,0,,Mak!
Dialog: 0,0:07:59.60,0:08:01.24, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:08:01.27,0:08:03.75, Lalai,,0,0,0,,Orang ramai tidak mengubahnya\Dengan mudah. Ada apa dengan dia?
Dialog: 0,0:08:03.77,0:08:04.83, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:08:04.85,0:08:08.29,Lalai,,0,0,0,,Hae-in mesti tiba-tiba melawat mertuanya.
Dialog: 0,0:08:08.32,0:08:10.67,Lalai,,0,0,0,,- Untuk apa?\N- Itulah sebabnya saya terkedu.
Dialog: 0,0:08:10.69,0:08:12.59, Lalai,,0,0,0,,Hillbillies sukar dipercayai.
Dialog: 0,0:08:12.61,0:08:15.17, Lalai,,0,0,0,,Mereka merakam ini dan memuat naiknya.
Dialog: 0,0:08:15.20,0:08:17.11, Lalai,,0,0,0,,Muat naik apa?
Dialog: 0,0:08:17.53,0:08:19.30, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa yang anda lakukan di sini?{\c}{\i0}
Dialog: 0,0:08:19.33,0:08:21.56,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya gembira anda semua berada di sini.{\c}{\i0}
Dialog: 0,0:08:21.58,0:08:23.64,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya terlepas hari lahir terakhir anda,{\c}{\i0}
Dialog: 0,0:08:23.66,0:08:27.31,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi saya datang untuk menjamu orang kampung.{\c}{\i0}
Dialog: 0,0:08:27.34,0:08:28.42,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}CEO Hong Hae-in yang cantik{\c}{\i0}
Dialog: 0,0:08:28.45,0:08:31.57,Lalai,,0,0,0,,{\an8}Dia tidak pernah mengejutkan saya pada hari lahir saya.
Dialog: 0,0:08:31.59,0:08:34.50, Lalai,,0,0,0,,Sungguh sukar dipercayai.
Dialog: 0,0:08:41.68,0:08:43.45, Lalai,,0,0,0,,Adakah anda lapar?
Dialog: 0,0:08:43.48,0:08:45.64, Lalai,,0,0,0,,Adakah anda mahu makan sesuatu?
Dialog: 0,0:08:47.10,0:08:48.81,Lalai,,0,0,0,,Saya sudah makan banyak.
Dialog: 0,0:08:48.86,0:08:50.54,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ada beberapa perkara ini, boleh?{\c}{\i0}
Dialog: 0,0:08:50.57,0:08:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ini ialah ketam perap kicap.{\c}{\i0}
Dialog: 0,0:08:52.82,0:08:54.67,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ia penuh dengan kijang.{\c}{\i0}
Dialog: 0,0:08:54.70,0:08:57.38,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kami terkenal dengan kicap kami.{\c}{\i0}
Dialog: 0,0:08:57.41,0:08:59.80, Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ini adalah perut babi beku\Ngrilled atas briket.{\c}{\i0}
Dialog: 0,0:08:59.83,0:09:01.97, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Makan sebelum sejuk.{\c}{\i0}
Dialog: 0,0:09:01.99,0:09:04.77, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sedang memakannya satu demi satu, jadi sila tunggu.{\c}{\i0}
Dialog: 0,0:09:04.79,0:09:06.43, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa seterusnya?\N- Cuba ini juga.{\c}{\i0}
Dialog: 0,0:09:06.46,0:09:08.89, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Alih, boleh? Anda menyesakkan bayi saya.{\c}{\i0}
Dialog: 0,0:09:08.92,0:09:10.69, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan terlalu mengarut.{\c}{\i0}
Dialog: 0,0:09:10.71,0:09:13.61, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kunyah perlahan-lahan, atau anda akan sakit perut.{\c}{\i0}
Dialog: 0,0:09:13.63,0:09:16.04,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Minum air juga.{\c}{\i0}
Dialog: 0,0:09:18.47,0:09:20.36, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Beri dia beberapa telur.{\c}{\i0}
Dialog: 0,0:09:20.39,0:09:22.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Biar saya lakukannya.{\c}{\i0}
Dialog: 0,0:09:22.77,0:09:26.09, Lalai,,0,0,0,,Mengapa mereka membuatnya tidak selesa?
Dialog: 0,0:09:26.56,0:09:29.04, Lalai,,0,0,0,,Dan kenapa dia makan\Tiada semua yang mereka berikan kepadanya?
Dialog: 0,0:09:29.06,0:09:30.87, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perut babi beku paling sesuai apabila panas.{\c}{\i0}
Dialog: 0,0:09:30.90,0:09:31.96, Lalai,,0,0,0,,{\an8}Apa?
Dialog: 0,0:09:31.98,0:09:35.23, Lalai,,0,0,0,,{\an8}Bagaimanakah video ini mempunyai lebih 300,000 tontonan?
Dialog: 0,0:09:35.70,0:09:38.09, Lalai,,0,0,0,,Kenapa dia makan banyak sangat?
Dialog: 0,0:09:38.11,0:09:42.80, Lalai,,0,0,0,,Daging lembu, daging babi, ayam, itik dan ikan.
Dialog: 0,0:09:42.83,0:09:44.72,Lalai,,0,0,0,,Saya mempunyai semua jenis daging.
Dialog: 0,0:09:44.75,0:09:47.27,Lalai,,0,0,0,,Saya rasa berat badan saya bertambah.
Dialog: 0,0:09:47.29,0:09:49.31, Lalai,,0,0,0,,- Betul ke?\N- Maksud saya...
Dialog: 0,0:09:49.33,0:09:53.50,Lalai,,0,0,0,,Seorang wanita menawarkan saya ayam yang tidak pernah dibuatnya untuk menantunya.
Dialog: 0,0:09:55.01,0:09:58.75,Default,,0,0,0,,Saya rasa orang kampung suka saya.
Dialog: 0,0:10:08.44,0:10:12.75,Lalai,,0,0,0,,Nampaknya mereka baik-baik saja, jadi\Jangan berani menyebut tentang perceraian.
Dialog: 0,0:10:12.77,0:10:14.33, Lalai,,0,0,0,,Anda faham.
Dialog: 0,0:10:14.36,0:10:15.88, Lalai,,0,0,0,,Adakah anda memberitahu sesiapa setakat ini?
Dialog: 0,0:10:15.90,0:10:19.73, Lalai,,0,0,0,,Ayuh, Ibu. Saya akan menjadi bodoh jika saya berbuat demikian.
Dialog: 0,0:10:25.75,0:10:27.47, Lalai,,0,0,0,,- Kenapa awak senyap sangat?\N- Apa?
Dialog: 0,0:10:27.50,0:10:30.06, Lalai,,0,0,0,,Kebaikan. Siapakah itu? Siapa yang awak beritahu?
Dialog: 0,0:10:30.08,0:10:32.23, Lalai,,0,0,0,,Saya sedang {\i1}makgeolli{\i0} dengan Yeong-song dan...
Dialog: 0,0:10:32.25,0:10:33.23, Lalai,,0,0,0,,- Apa?\N- Apa?
Dialog: 0,0:10:33.25,0:10:35.41, Lalai,,0,0,0,,Anda memberitahunya bahawa...
Dialog: 0,0:10:35.63,0:10:38.44, Lalai,,0,0,0,,Kau beritahu dia Hyun-woo hampir bercerai?
Dialog: 0,0:10:38.47,0:10:43.92,Lalai,,0,0,0,,Nah, Yeong-song adalah seperti\N kaunselor perkahwinan di kampung ini,
Dialog: 0,0:10:44.60,0:10:46.47,Lalai,,0,0,0,,jadi saya berunding dengannya.
Dialog: 0,0:10:46.56,0:10:47.53, Lalai,,0,0,0,,Saya mengeluh.
Dialog: 0,0:10:47.56,0:10:49.13, Lalai,,0,0,0,,Itu sahaja.
Dialog: 0,0:10:49.44,0:10:51.41,Lalai,,0,0,0,,Bagaimana jika dia memberitahu orang lain?
Dialog: 0,0:10:51.44,0:10:53.76, Lalai,,0,0,0,,- Ya.\N- Perkataan akan tersebar dengan cepat.
Dialog: 0,0:10:53.98,0:10:57.21,Lalai,,0,0,0,,Perundingan adalah mengenai kerahsiaan.
Dialog: 0,0:10:57.23,0:11:01.65, Lalai,,0,0,0,,Dia tidak perlu berahsia,\Nmemandangkan dia bukan doktor berlesen.
Dialog: 0,0:11:04.87,0:11:07.26, Lalai,,0,0,0,, Astaga. Walaupun masih...
Dialog: 0,0:11:07.29,0:11:10.49, Lalai,,0,0,0,,Anda dan mulut besar anda.
Dialog: 0,0:11:11.42,0:11:13.12,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:11:19.76,0:11:22.61, Lalai,,0,0,0,,Anda bimbang, jadi anda datang ke sini pada jam ini?
Dialog: 0,0:11:22.64,0:11:24.82,Lalai,,0,0,0,,Adakah anda memberitahu sesiapa?
Dialog: 0,0:11:24.85,0:11:26.55, Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:11:27.47,0:11:29.83,Lalai,,0,0,0,,Saya hanya memberitahu ibu saya.
Dialog: 0,0:11:29.85,0:11:31.62, Lalai,,0,0,0,,Mengapa anda?
Dialog: 0,0:11:31.64,0:11:34.08,Lalai,,0,0,0,,Du-gwan, dia satu-satunya keluarga yang saya ada.
Dialog: 0,0:11:34.11,0:11:36.72, Lalai,,0,0,0,,Kami berkongsi segala-galanya,
Dialog: 0,0:11:37.19,0:11:40.60, Lalai,,0,0,0,, dan anda tahu keadaan dia.
Dialog: 0,0:11:48.33,0:11:51.99,Lalai,,0,0,0,,Bila awak pulang, Sayang?\NKenapa awak selalu tiada?
Dialog: 0,0:11:52.04,0:11:53.68, Lalai,,0,0,0,,Di manakah anda tidur hari ini?
Dialog: 0,0:11:53.71,0:11:55.31, Lalai,,0,0,0,,Ibu, pergi tidur.
Dialog: 0,0:11:55.33,0:11:57.54,Lalai,,0,0,0,,Siapa kamu?
Dialog: 0,0:11:57.96,0:12:00.19, Lalai,,0,0,0,, Nampak? Jadi jangan risau tentang dia,
Dialog: 0,0:12:00.21,0:12:02.44, Lalai,,0,0,0,, dan bimbang tentang anak anda dan isterinya.
Dialog: 0,0:12:02.47,0:12:04.49,Lalai,,0,0,0,,Tiada apa yang perlu dirisaukan.
Dialog: 0,0:12:04.51,0:12:05.95,Lalai,,0,0,0,,Walaupun sibuk,
Dialog: 0,0:12:05.97,0:12:08.37, Lalai,,0,0,0,,Hae-in datang ke sini untuk membantu kempen saya.
Dialog: 0,0:12:08.39,0:12:10.59, Lalai,,0,0,0,,- Apa maksudnya?\N- Apa?
Dialog: 0,0:12:10.64,0:12:14.34,Lalai,,0,0,0,,Maknanya mereka berdua sedang bercinta gila.
Dialog: 0,0:12:18.48,0:12:21.18, Lalai,,0,0,0,,Apa ini? comelnya.
Dialog: 0,0:12:21.90,0:12:24.23, Lalai,,0,0,0,,Ia sentiasa menjadi kegemaran saya.
Dialog: 0,0:12:29.45,0:12:31.28, Lalai,,0,0,0,,Tangan anda.
Dialog: 0,0:12:38.42,0:12:40.83, Lalai,,0,0,0,,Anda tidak sepatutnya bersendirian lagi.
Dialog: 0,0:12:41.96,0:12:43.96, Lalai,,0,0,0,,Anda sentiasa cedera.
Dialog: 0,0:13:00.23,0:13:02.77, Lalai,,0,0,0,,Saya dengar ini talian hayat anda.
Dialog: 0,0:13:04.11,0:13:05.63, Lalai,,0,0,0,,Mengapa saya pendek?
Dialog: 0,0:13:05.65,0:13:07.31, Lalai,,0,0,0,,Saya tersinggung.
Dialog: 0,0:13:08.03,0:13:09.63, Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:13:09.66,0:13:11.34, Lalai,,0,0,0,,Adakah anda percaya pada bacaan tapak tangan?
Dialog: 0,0:13:11.37,0:13:14.22, Lalai,,0,0,0,,Tidak, tetapi ia tidak menyenangkan.
Dialog: 0,0:13:14.25,0:13:17.28,Lalai,,0,0,0,,Saya sakit tenat, dan talian hayat saya pendek.
Dialog: 0,0:13:18.13,0:13:20.31, Lalai,,0,0,0,,Anda tidak sakit tenat.
Dialog: 0,0:13:20.34,0:13:22.15, Lalai,,0,0,0,,Anda tidak mahu menjadi pesakit.
Dialog: 0,0:13:22.17,0:13:23.73, Lalai,,0,0,0,,Anda kata anda akan menjadi lebih baik.
Dialog: 0,0:13:23.76,0:13:27.67, Lalai,,0,0,0,,Kamu berkata Tuhan ada di pihak kamu,\Dan keajaiban akan berlaku.
Dialog: 0,0:13:31.26,0:13:35.51,Lalai,,0,0,0,,Anda kata pusat kanser terbaik\Nin Eropah akan menyembuhkan segala-galanya!
Dialog: 0,0:13:41.86,0:13:45.14, Lalai,,0,0,0,,Saya tidak pernah kata mereka akan menyembuhkan segala-galanya.
Dialog: 0,0:13:45.57,0:13:48.40, Lalai,,0,0,0,,Saya cuma cakap.
Dialog: 0,0:13:48.61,0:13:51.65, Lalai,,0,0,0,,Ada sebab mereka yang terbaik.
Dialog: 0,0:13:52.20,0:13:53.90, Lalai,,0,0,0,,Adakah anda fikir begitu?
Dialog: 0,0:14:00.79,0:14:02.62, Lalai,,0,0,0,,Adakah anda...
Dialog: 0,0:14:04.51,0:14:06.08, Lalai,,0,0,0,,ikut saya?
Dialog: 0,0:14:09.93,0:14:12.75,Lalai,,0,0,0,,Bukannya saya takut pergi sendirian.
Dialog: 0,0:14:13.06,0:14:16.34,Lalai,,0,0,0,,Anda seorang sahaja yang tahu saya sakit.
Dialog: 0,0:14:27.90,0:14:29.81,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:14:31.91,0:14:33.82, Lalai,,0,0,0,,Itu diberikan.
Dialog: 0,0:14:40.42,0:14:42.12, Lalai,,0,0,0,,Adakah ia masih menyengat?
Dialog: 0,0:15:53.16,0:15:54.76, Lalai,,0,0,0,,Adakah anda sudah gila?
Dialog: 0,0:15:54.78,0:15:56.64, Lalai,,0,0,0,,Apa yang anda cuba lakukan?
Dialog: 0,0:15:56.66,0:15:58.39, Lalai,,0,0,0,,Jangan beritahu saya...
Dialog: 0,0:15:58.41,0:16:00.70, Lalai,,0,0,0,,anda mahu menciumnya.
Dialog: 0,0:16:01.71,0:16:02.93, Lalai,,0,0,0,,Ya ampun.
Dialog: 0,0:16:02.96,0:16:04.91, Lalai,,0,0,0,, Awak gila.
Dialog: 0,0:16:05.46,0:16:06.99, Lalai,,0,0,0,,Anda gila.
Dialog: 0,0:16:11.88,0:16:13.53, Lalai,,0,0,0,,Tetapi tetap,
Dialog: 0,0:16:13.55,0:16:16.54, Lalai,,0,0,0,,anda tidak sepatutnya membiarkan dia tergantung.
Dialog: 0,0:16:17.43,0:16:19.26,Lalai,,0,0,0,,Dia pasti terkejut.
Dialog: 0,0:16:23.10,0:16:24.62, Lalai,,0,0,0,,Anda akan masuk semula?
Dialog: 0,0:16:24.65,0:16:27.93, Lalai,,0,0,0,,Apa yang anda akan katakan kepadanya? Apa yang anda akan lakukan?
Dialog: 0,0:16:28.52,0:16:31.60, Lalai,,0,0,0,,Adakah anda rasa anda boleh kembali ke luar?
Dialog: 0,0:16:33.53,0:16:35.23, Lalai,,0,0,0,,Tidak, anda tidak boleh.
Dialog: 0,0:16:36.45,0:16:39.57,Lalai,,0,0,0,,No. Saya tidak akan dapat pergi...
Dialog: 0,0:16:39.62,0:16:41.32, Lalai,,0,0,0,,jika saya kembali.
Dialog: 0,0:16:41.91,0:16:43.86, Lalai,,0,0,0,,Saya tidak boleh.
Dialog: 0,0:16:54.97,0:16:56.67,Lalai,,0,0,0,,Adakah dia melarikan diri?
Dialog: 0,0:16:58.35,0:17:00.09, Lalai,,0,0,0,,No.
Dialog: 0,0:17:00.18,0:17:01.74, Lalai,,0,0,0,,Saya pasti...
Dialog: 0,0:17:01.77,0:17:04.20,Lalai,,0,0,0,,dia ada sesuatu nak dibuat.
Dialog: 0,0:17:04.23,0:17:07.97,Lalai,,0,0,0,,Mungkin dia terpaksa pergi ke tandas atau membuat panggilan.
Dialog: 0,0:17:18.41,0:17:20.07, Lalai,,0,0,0,,Tetapi selama ini?
Dialog: 0,0:17:24.29,0:17:25.93, Lalai,,0,0,0,,Boleh tolong diam?
Dialog: 0,0:17:25.96,0:17:28.35, Lalai,,0,0,0,,Aduh, bisingnya awak.
Dialog: 0,0:17:28.38,0:17:30.03, Lalai,,0,0,0,,Diam!
Dialog: 0,0:17:31.71,0:17:32.98,Lalai,,0,0,0,,Adakah anda dan Hae-in bertengkar?
Dialog: 0,0:17:33.01,0:17:34.75, Lalai,,0,0,0,,No.
Dialog: 0,0:17:35.05,0:17:36.57,Lalai,,0,0,0,,Ia adalah sebaliknya.
Dialog: 0,0:17:36.59,0:17:39.15, Lalai,,0,0,0,,Maka adakah anda sedang dihukum?
Dialog: 0,0:17:39.18,0:17:42.88,Lalai,,0,0,0,,Adakah dia menyuruh anda pergi ke luar\Nand muhasabah diri selama sejam?
Dialog: 0,0:17:43.35,0:17:45.83,Lalai,,0,0,0,,- Adakah anda pernah melakukannya?\N- Banyak kali,
Dialog: 0,0:17:45.85,0:17:49.58,Lalai,,0,0,0,,tetapi dia akan menjadi lebih\Marah jika anda melakukan apa yang dia katakan.
Dialog: 0,0:17:49.61,0:17:54.14,Lalai,,0,0,0,,Dia akan memaafkan anda jika anda\N cepat kembali dan meminta maaf.
Dialog: 0,0:17:54.57,0:17:57.19, Lalai,,0,0,0,,Itu panas.
Dialog: 0,0:17:59.45,0:18:02.84, Lalai,,0,0,0,, Jadi pegang dan masuk semula.
Dialog: 0,0:18:02.87,0:18:06.20,Lalai,,0,0,0,,Saya hanya di sini...
Dialog: 0,0:18:06.83,0:18:09.32, Lalai,,0,0,0,,supaya saya sedar.
Dialog: 0,0:18:09.88,0:18:11.77,Lalai,,0,0,0,,Saya tidak boleh berfikir dengan betul di rumah.
Dialog: 0,0:18:11.79,0:18:13.45, Lalai,,0,0,0,,Kenapa tidak?
Dialog: 0,0:18:22.89,0:18:25.26,Lalai,,0,0,0,,Saya tidak tahu. Saya tidak boleh.
Dialog: 0,0:18:45.12,0:18:46.10,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:18:53.09,0:18:54.99,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di manakah anda?{\c}{\i0}
Dialog: 0,0:19:02.14,0:19:04.38, Lalai,,0,0,0,,Kenapa dia tidak membacanya?
Dialog: 0,0:19:04.97,0:19:07.30, Lalai,,0,0,0,,Hei, dia membacanya.
Dialog: 0,0:19:20.90,0:19:22.09, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tidur sekarang.{\c}{\i0}
Dialog: 0,0:19:22.11,0:19:25.11, Lalai,,0,0,0,,"Tidur sekarang"?
Dialog: 0,0:19:25.99,0:19:28.07, Lalai,,0,0,0,,Dia mahu saya tidur sekarang?
Dialog: 0,0:19:29.33,0:19:30.86, Lalai,,0,0,0,,Sendiri?
Dialog: 0,0:19:40.05,0:19:41.53, Lalai,,0,0,0,, Baik.
Dialog: 0,0:19:41.55,0:19:43.29,Lalai,,0,0,0,,Itu yang dia mahu.
Dialog: 0,0:19:44.47,0:19:45.78,Lalai,,0,0,0,,Tidur.
Dialog: 0,0:19:45.80,0:19:47.34, Lalai,,0,0,0,,Tidur sekarang.
Dialog: 0,0:19:51.60,0:19:53.29, Lalai,,0,0,0,, Sial.
Dialog: 0,0:19:53.31,0:19:54.50, Lalai,,0,0,0,,Jadi dia lari.
Dialog: 0,0:19:54.52,0:19:58.81, Lalai,,0,0,0,,Kenapa? Adakah dia fikir saya akan makan\N dia hidup-hidup? Adakah dia takut dengan saya?
Dialog: 0,0:20:02.95,0:20:04.90, Lalai,,0,0,0,, Senyap!
Dialog: 0,0:20:11.75,0:20:13.60, Lalai,,0,0,0,,Kenapa dia takut pada saya?
Dialog: 0,0:20:13.62,0:20:16.37, Lalai,,0,0,0,,Bagaimanakah saya menakutkan?
Dialog: 0,0:20:17.21,0:20:19.73, Lalai,,0,0,0,,Anjing pun sedang tidur.
Dialog: 0,0:20:19.76,0:20:22.28,Lalai,,0,0,0,,Jom kita balik ke rumah sekarang.
Dialog: 0,0:20:22.30,0:20:24.40, Lalai,,0,0,0,,Saya akan keluar lebih lama.
Dialog: 0,0:20:24.43,0:20:27.03, Lalai,,0,0,0,, Hae-in akan tidur sendirian, kemudian.
Dialog: 0,0:20:27.05,0:20:29.63, Lalai,,0,0,0,,Ya, itulah sebabnya.
Dialog: 0,0:20:30.10,0:20:32.18, Lalai,,0,0,0,,Saya akan kembali sebaik sahaja dia melakukannya.
Dialog: 0,0:20:34.60,0:20:38.08, Lalai,,0,0,0,,Aduh, bodoh.
Dialog: 0,0:20:38.11,0:20:39.29, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:20:39.32,0:20:41.56, Lalai,,0,0,0,,Mengapa anda menunggu sehingga itu?
Dialog: 0,0:20:47.20,0:20:48.90, Lalai,,0,0,0,, Kerana saya mungkin...
Dialog: 0,0:20:50.29,0:20:51.82, Lalai,,0,0,0,,buat kesilapan.
Dialog: 0,0:20:52.04,0:20:53.01, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:20:53.04,0:20:55.06,Lalai,,0,0,0,,Anda hanya melakukan kesilapan apabila anda mabuk.
Dialog: 0,0:20:55.08,0:20:57.31, Lalai,,0,0,0,,Anda tidak sepatutnya mabuk dalam kes itu.
Dialog: 0,0:20:57.33,0:20:58.56, Lalai,,0,0,0,,No.
Dialog: 0,0:20:58.59,0:21:01.25,Lalai,,0,0,0,,Saya tidak akan membuat sebarang kesilapan...
Dialog: 0,0:21:01.76,0:21:03.19, Lalai,,0,0,0,,jika saya minum dan pengsan.
Dialog: 0,0:21:03.22,0:21:06.17, Lalai,,0,0,0,,Saya tidak tahu apa yang anda katakan.
Dialog: 0,0:21:07.55,0:21:09.20, Lalai,,0,0,0,,Dengar dengan teliti.
Dialog: 0,0:21:09.22,0:21:12.92, Lalai,,0,0,0,,Saya akan minum lebih banyak,
Dialog: 0,0:21:13.35,0:21:16.05, Lalai,,0,0,0,, dan sia-sia sepenuhnya.
Dialog: 0,0:21:16.81,0:21:18.04, Lalai,,0,0,0,,Cukup tolong saya.
Dialog: 0,0:21:18.06,0:21:20.77, Lalai,,0,0,0,,- Apa itu?\N- Jangan...
Dialog: 0,0:21:21.15,0:21:23.18, Lalai,,0,0,0,,letakkan saya...
Dialog: 0,0:21:24.53,0:21:26.23, Lalai,,0,0,0,, kembali ke bilik saya.
Dialog: 0,0:21:33.00,0:21:34.99, Lalai,,0,0,0,,Saya sangat tersesat.
Dialog: 0,0:21:36.29,0:21:38.81, Lalai,,0,0,0,,Adakah anda mahu {\i1}ramyun?{\i0} Saya akan buatkan.
Dialog: 0,0:21:40.59,0:21:45.33,Lalai,,0,0,0,,Saya pernah sangat takut dengan isteri saya.
Dialog: 0,0:21:56.27,0:21:57.93, Lalai,,0,0,0,,Saya pernah...
Dialog: 0,0:21:58.52,0:22:00.43, Lalai,,0,0,0,,okay.
Dialog: 0,0:22:02.73,0:22:05.44, Lalai,,0,0,0,,Saya pasti saya tidak akan terkejut,
Dialog: 0,0:22:05.90,0:22:08.27, Lalai,,0,0,0,, tidak kira apa yang berlaku kepadanya.
Dialog: 0,0:22:09.07,0:22:12.78, Lalai,,0,0,0,,Kenapa? Kerana saya tidak menyukainya.
Dialog: 0,0:22:16.29,0:22:19.06, Lalai,,0,0,0,, Sama seperti yang saya lakukan setakat ini,
Dialog: 0,0:22:19.08,0:22:22.44, Lalai,,0,0,0,,Saya hanya perlu teruskan tidak suka,
Dialog: 0,0:22:22.46,0:22:23.44,Lalai,,0,0,0,,membenci,
Dialog: 0,0:22:23.46,0:22:25.19, Lalai,,0,0,0,,dan bosan dengannya.
Dialog: 0,0:22:25.21,0:22:28.29,Lalai,,0,0,0,,Saya hanya perlu menjangkakan hari kita berpisah.
Dialog: 0,0:22:29.97,0:22:32.21, Lalai,,0,0,0,,Saya tidak perlu menyukainya.
Dialog: 0,0:22:33.18,0:22:34.88, Lalai,,0,0,0,,Ianya mudah.
Dialog: 0,0:22:35.27,0:22:37.43, Lalai,,0,0,0,,Saya telah melakukannya selama ini.
Dialog: 0,0:23:00.54,0:23:02.24, Lalai,,0,0,0,,Tetapi...
Dialog: 0,0:23:03.21,0:23:04.99, Lalai,,0,0,0,, cukup pelik,
Dialog: 0,0:23:07.13,0:23:09.33, Lalai,,0,0,0,,Saya tidak boleh melakukannya lagi.
Dialog: 0,0:23:22.98,0:23:24.51, Lalai,,0,0,0,, Baik.
Dialog: 0,0:23:25.07,0:23:27.64, Lalai,,0,0,0,,Kita tidak perlu tidur bersama.
Dialog: 0,0:23:27.78,0:23:30.56, Lalai,,0,0,0,,Kami telah tidur berasingan selama bertahun-tahun.
Dialog: 0,0:23:33.03,0:23:34.24,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Dua Tahun Lalu{\c}{\i0}
Dialog: 0,0:23:37.45,0:23:38.89, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:23:38.91,0:23:42.16,Lalai,,0,0,0,,Pn. Hong menyuruh kami membersihkan bilik.
Dialog: 0,0:23:47.67,0:23:50.78, Lalai,,0,0,0,,Pasukan produk bertanggungjawab\Tidak memilih dan mengalih keluar jenama.
Dialog: 0,0:23:50.80,0:23:53.96, Lalai,,0,0,0,,Pasukan jualan perlu fokus\Bukan prestasi jenama.
Dialog: 0,0:23:57.43,0:23:59.38, Lalai,,0,0,0,,Tahan.
Dialog: 0,0:23:59.68,0:24:01.38, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:24:02.31,0:24:04.01, Lalai,,0,0,0,,Tadika.
Dialog: 0,0:24:04.90,0:24:07.29, Lalai,,0,0,0,,- Adakah anda sedang membersihkan diri?\N- Apa gunanya?
Dialog: 0,0:24:07.32,0:24:09.64, Lalai,,0,0,0,,Ia hanya mengganggu saya.
Dialog: 0,0:24:13.53,0:24:15.97, Lalai,,0,0,0,,Ia mengganggu anda?
Dialog: 0,0:24:15.99,0:24:18.36, Lalai,,0,0,0,,Kami tidak memerlukannya lagi.
Dialog: 0,0:24:29.46,0:24:34.07, Lalai,,0,0,0,,Pasukan produk tidak dapat menarik\Njenama yang baik dengan prestasi yang lemah.
Dialog: 0,0:24:34.09,0:24:36.29,Lalai,,0,0,0,,Bukankah itu jelas?
Dialog: 0,0:24:39.64,0:24:41.34, Lalai,,0,0,0,,Ya.
Dialog: 0,0:24:48.82,0:24:50.96, Lalai,,0,0,0,,Sila alihkan barang-barang saya ke dalam bilik ini.
Dialog: 0,0:24:50.98,0:24:52.21,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:24:52.24,0:24:54.10,Lalai,,0,0,0,,Saya perlukan katil juga.
Dialog: 0,0:24:55.45,0:24:56.72,Lalai,,0,0,0,,Saya akan tinggal di sini buat masa ini.
Dialog: 0,0:24:56.74,0:24:58.32, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:27:32.85,0:27:34.60,Lalai,,0,0,0,,Jangan menangis.
Dialog: 0,0:27:36.27,0:27:38.23, Lalai,,0,0,0,,Anda tiada hak.
Dialog: 0,0:28:51.31,0:28:53.22,Lalai,,0,0,0,,Anda bangun awal.
Dialog: 0,0:28:53.94,0:28:56.26, Lalai,,0,0,0,,Adakah ia kelihatan seperti saya tidur?
Dialog: 0,0:28:56.31,0:28:58.22, Lalai,,0,0,0,,Anda tidak tidur langsung?
Dialog: 0,0:29:01.94,0:29:03.60, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:29:12.87,0:29:14.60,Lalai,,0,0,0,,Ho-yeol, tak patut ke awak pergi sekolah?
Dialog: 0,0:29:14.62,0:29:17.48, Lalai,,0,0,0,,Ayah, kenapa perkara itu penting?
Dialog: 0,0:29:17.50,0:29:19.66, Lalai,,0,0,0,,Mentor hidup saya...
Dialog: 0,0:29:19.92,0:29:21.95,Lalai,,0,0,0,,ada di sini.
Dialog: 0,0:29:22.80,0:29:24.98, Lalai,,0,0,0,,Apa maksud anda? Siapa mentor anda?
Dialog: 0,0:29:25.01,0:29:27.28, Lalai,,0,0,0,,Dia tonggak keluarga\Nyang datang dengan kereta super.
Dialog: 0,0:29:27.30,0:29:30.66, Lalai,,0,0,0,,Itu makcik saya, sebuah bangunan\Pemilik dan model peranan saya.
Dialog: 0,0:29:30.68,0:29:33.51, Lalai,,0,0,0,, Dia datang.
Dialog: 0,0:29:34.14,0:29:36.75, Lalai,,0,0,0,,- Ayuh keluar.\N- Gosh, Hae-in.
Dialog: 0,0:29:36.77,0:29:38.93, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:29:39.44,0:29:40.71, Lalai,,0,0,0,,Anda telah melakukan banyak perkara.
Dialog: 0,0:29:40.73,0:29:41.96, Lalai,,0,0,0,, Pulang dengan selamat.
Dialog: 0,0:29:41.98,0:29:43.98, Lalai,,0,0,0,,Selamat tinggal.
Dialog: 0,0:29:45.61,0:29:47.51,Lalai,,0,0,0,,- Hyun-woo.\N- Hello, puan.
Dialog: 0,0:29:47.53,0:29:49.65,Lalai,,0,0,0,,- Selamat tinggal.\N- Ya, puan.
Dialog: 0,0:29:50.45,0:29:52.30,Lalai,,0,0,0,,Ibu awak sudah waras lagi.
Dialog: 0,0:29:52.33,0:29:54.60,Lalai,,0,0,0,,Yeong-song, dia sudah lebih baik sekarang.
Dialog: 0,0:29:54.62,0:29:56.35, Lalai,,0,0,0,,Kebaikan, Ibu.
Dialog: 0,0:29:56.37,0:29:57.48,Lalai,,0,0,0,,Kekal kuat.
Dialog: 0,0:29:57.50,0:29:58.77, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:29:58.79,0:30:02.33,Lalai,,0,0,0,,Perceraian bukan apa-apa.
Dialog: 0,0:30:02.46,0:30:04.27,Lalai,,0,0,0,,Saya juga mahu bercerai.
Dialog: 0,0:30:04.30,0:30:06.83, Lalai,,0,0,0,,Saya sepatutnya, apabila saya mempunyai peluang.
Dialog: 0,0:30:07.88,0:30:09.92, Lalai,,0,0,0,,Baiklah, Ibu.
Dialog: 0,0:30:10.30,0:30:12.46,Lalai,,0,0,0,,Aduh, puan.
Dialog: 0,0:30:12.56,0:30:14.70,Lalai,,0,0,0,,Saya rasa dia sudah keluar dari masalah itu lagi.
Dialog: 0,0:30:14.72,0:30:16.66, Lalai,,0,0,0,,Anda harus cepat pulang.
Dialog: 0,0:30:16.68,0:30:18.16,Lalai,,0,0,0,,Jom.
Dialog: 0,0:30:18.19,0:30:21.93,Lalai,,0,0,0,,Sayang, awak tidur di sini semalam?
Dialog: 0,0:30:22.61,0:30:26.52,Lalai,,0,0,0,,Inilah sebabnya saya mahu bercerai.
Dialog: 0,0:30:27.86,0:30:28.84,Lalai,,0,0,0,,Mari kita pulang.
Dialog: 0,0:30:28.86,0:30:31.43, Lalai,,0,0,0,,- Saya sepatutnya ceraikan awak!\N- Jom!
Dialog: 0,0:30:31.45,0:30:33.59,Lalai,,0,0,0,,- Awak patut pergi.\N- Dia orang kampung.
Dialog: 0,0:30:33.62,0:30:35.36, Lalai,,0,0,0,,Dia agak gila.
Dialog: 0,0:30:35.70,0:30:37.95, Lalai,,0,0,0,,Selamat tinggal, Sayang.
Dialog: 0,0:30:43.21,0:30:45.40,Lalai,,0,0,0,,Saya minta maaf atas kesulitan ini.
Dialog: 0,0:30:45.42,0:30:46.98, Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,0:30:47.01,0:30:50.25, Lalai,,0,0,0,,- Selamat tinggal.\N- Astaga, awak bukan menyusahkan.
Dialog: 0,0:30:51.55,0:30:52.70, Lalai,,0,0,0,,Ini tidak banyak,
Dialog: 0,0:30:52.72,0:30:56.26, Lalai,,0,0,0,,tetapi saya tidak menggunakan racun perosak,\Njadi pastikan anda memakannya.
Dialog: 0,0:31:03.48,0:31:06.92,Lalai,,0,0,0,,Hae-in, saya tahu kerja itu penting,
Dialog: 0,0:31:06.94,0:31:09.23,Lalai,,0,0,0,,tetapi kesihatan anda diutamakan.
Dialog: 0,0:31:11.11,0:31:12.68, Lalai,,0,0,0,,Anda harus pergi.
Dialog: 0,0:31:12.70,0:31:14.32,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:31:14.95,0:31:17.53,Lalai,,0,0,0,,Baiklah, selamat pulang.
Dialog: 0,0:31:18.91,0:31:22.74, Lalai,,0,0,0,,- Jom.\N- Terima kasih, Hae-in.
Dialog: 0,0:31:23.17,0:31:25.33, Lalai,,0,0,0,,- Selamat tinggal.\N- Pergi.
Dialog: 0,0:31:27.13,0:31:28.73, Lalai,,0,0,0,,Kalau begitu, kita akan pergi.
Dialog: 0,0:31:28.76,0:31:31.07, Lalai,,0,0,0,,- Okay.\N- Okay.
Dialog: 0,0:31:31.09,0:31:33.67, Lalai,,0,0,0,, Hubungi saya.
Dialog: 0,0:31:49.74,0:31:51.81, Lalai,,0,0,0,,Adakah anda mempunyai rokok?
Dialog: 0,0:31:53.78,0:31:55.32,Lalai,,0,0,0,,No.
Dialog: 0,0:31:59.37,0:32:00.64, Lalai,,0,0,0,,Adakah anda fikir dia menangkapnya?
Dialog: 0,0:32:00.66,0:32:02.22, Lalai,,0,0,0,,Siapa tahu?
Dialog: 0,0:32:02.25,0:32:04.27, Lalai,,0,0,0,,Saya tidak fikir dia melakukannya,
Dialog: 0,0:32:04.29,0:32:07.31, Lalai,,0,0,0,,tetapi terdapat udara sejuk\Ndi antara mereka sebelum itu.
Dialog: 0,0:32:07.34,0:32:09.82, Lalai,,0,0,0,,Mereka malah mengelak daripada bertentang mata sebelum melompat masuk.
Dialog: 0,0:32:09.84,0:32:11.15, Lalai,,0,0,0,,Anda tidak sepatutnya bercakap...
Dialog: 0,0:32:11.17,0:32:13.57,Lalai,,0,0,0,,tentang bagaimana dia menerima surat cinta pada masa lalu,
Dialog: 0,0:32:13.59,0:32:17.36,Lalai,,0,0,0,,dan bagaimana anak perempuan pengetua telah\Na menyukainya. Semua cakap tak guna tu.
Dialog: 0,0:32:17.39,0:32:19.24, Lalai,,0,0,0,,- Ia pasti membuatkan dia kecewa.\N- Apa?
Dialog: 0,0:32:19.27,0:32:21.24, Lalai,,0,0,0,,Itu hanya gurauan.
Dialog: 0,0:32:21.27,0:32:22.45, Lalai,,0,0,0,,Adakah ia kelakar?
Dialog: 0,0:32:22.48,0:32:25.79,Lalai,,0,0,0,,- Adakah awak serius?\N- Dia tidak tidur di biliknya semalam.
Dialog: 0,0:32:25.81,0:32:27.12, Lalai,,0,0,0,,- Apa?\N- Apa?
Dialog: 0,0:32:27.15,0:32:28.46, Lalai,,0,0,0,, Kemudian apa yang dia buat?
Dialog: 0,0:32:28.48,0:32:30.46,Lalai,,0,0,0,,Kami minum bersama di kedai.
Dialog: 0,0:32:30.49,0:32:31.88, Lalai,,0,0,0,,Sakit.
Dialog: 0,0:32:31.90,0:32:33.34, Lalai,,0,0,0,,Anda berkeras, bukan?
Dialog: 0,0:32:33.36,0:32:35.05, Lalai,,0,0,0,,Tidak, dia tidak mahu pergi.
Dialog: 0,0:32:35.07,0:32:38.07, Lalai,,0,0,0,,Saya rasa tidur secara berasingan menjadikannya janggal.
Dialog: 0,0:32:42.21,0:32:44.93,Lalai,,0,0,0,,Bagaimana cinta mereka boleh mati?
Dialog: 0,0:32:44.96,0:32:48.16,Lalai,,0,0,0,,Dulu mereka jatuh cinta.
Dialog: 0,0:32:48.34,0:32:50.83, Lalai,,0,0,0,,Saya minta maaf atas pertemuan yang mengejut ini.
Dialog: 0,0:32:51.01,0:32:53.92, Lalai,,0,0,0,,Anda pasti berpakaian untuk pelatih.
Dialog: 0,0:32:54.01,0:32:56.45,Lalai,,0,0,0,,{\an8}Anda mesti suka jenama mewah. Saya juga begitu.
Dialog: 0,0:32:56.47,0:32:58.05,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Empat Tahun Lalu{\c}{\i0}
Dialog: 0,0:32:59.06,0:33:01.87, Lalai,,0,0,0,, En. Baek dalam perjalanan\N balik dari bekerja di luar.
Dialog: 0,0:33:01.89,0:33:05.05, Lalai,,0,0,0,,Saya tahu. Sebab tu saya panggil awak.
Dialog: 0,0:33:05.69,0:33:07.39, Lalai,,0,0,0,,Apakah ini?
Dialog: 0,0:33:09.40,0:33:11.34,Lalai,,0,0,0,,Tentang Hyun-woo...
Dialog: 0,0:33:11.36,0:33:12.54, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:33:12.57,0:33:14.76,Lalai,,0,0,0,,Dia baik. Saya pasti awak mahukan dia.
Dialog: 0,0:33:14.78,0:33:17.73,Lalai,,0,0,0,,Dia bijak dan kacak.
Dialog: 0,0:33:17.87,0:33:19.68, Lalai,,0,0,0,,Adakah dia memberitahu anda berapa banyak lembu yang kami miliki?
Dialog: 0,0:33:19.70,0:33:22.18,Lalai,,0,0,0,,- Ya.\N- Serta saiz kebun kita?
Dialog: 0,0:33:22.20,0:33:25.07, Lalai,,0,0,0,,Dan bahawa kita memiliki satu-satunya kedai di bandar?
Dialog: 0,0:33:27.38,0:33:29.14, Lalai,,0,0,0,,Bagaimana dengan rumahnya di Seoul?
Dialog: 0,0:33:29.17,0:33:30.56, Lalai,,0,0,0,,Dia menandatangani pajakan dua tahun.
Dialog: 0,0:33:30.59,0:33:33.83, Lalai,,0,0,0,,Maka anda mesti tahu.
Dialog: 0,0:33:34.76,0:33:39.67,Lalai,,0,0,0,,Saya tidak tahu saya materialistik,\Ntetapi saya tidak dapat menahannya kerana dia adalah keluarga.
Dialog: 0,0:33:41.47,0:33:43.37,Lalai,,0,0,0,,Saya dengar awak miskin,
Dialog: 0,0:33:43.39,0:33:46.25,Lalai,,0,0,0,,dan anda memakai pakaian lusuh.
Dialog: 0,0:33:46.27,0:33:49.10,Lalai,,0,0,0,,Tidak, semuanya vintaj istimewa...
Dialog: 0,0:33:49.94,0:33:52.63, Lalai,,0,0,0,,Apa yang dia tahu, pula?
Dialog: 0,0:33:52.65,0:33:54.75, Lalai,,0,0,0,,Itu benar. Bagaimanapun...
Dialog: 0,0:33:54.78,0:33:56.30,Lalai,,0,0,0,,Bolehkah anda berhenti melihatnya?
Dialog: 0,0:33:56.32,0:33:58.73,Lalai,,0,0,0,,Saya tidak akan pernah putus dengan dia,
Dialog: 0,0:33:59.20,0:34:00.18, Lalai,,0,0,0,, dan itu muktamad.
Dialog: 0,0:34:00.20,0:34:02.34, Lalai,,0,0,0,,Anda agak pentingkan diri sendiri.
Dialog: 0,0:34:02.37,0:34:05.14,Lalai,,0,0,0,,Semua wanita yang ingin dating\N dia adalah individu yang berjaya,
Dialog: 0,0:34:05.16,0:34:08.02,Lalai,,0,0,0,,seperti penjawat awam dan\Npekerja syarikat utama.
Dialog: 0,0:34:08.04,0:34:09.89,Lalai,,0,0,0,,Saya tahu ia kejam, tetapi ia adalah realiti.
Dialog: 0,0:34:09.92,0:34:12.73, Lalai,,0,0,0,,- Mi-seon!\N- Baik.
Dialog: 0,0:34:12.75,0:34:14.15, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:34:14.17,0:34:16.46,Lalai,,0,0,0,,Apa yang kamu katakan kepada Hae-in?
Dialog: 0,0:34:16.97,0:34:18.74, Lalai,,0,0,0,,- Saya tidak banyak cakap. Saya...\N- Aduhai.
Dialog: 0,0:34:18.76,0:34:20.78,Lalai,,0,0,0,,Saya suruh awak berhenti menonton drama!
Dialog: 0,0:34:20.80,0:34:24.09, Lalai,,0,0,0,, Wangnya agak sedikit tidak seperti drama.
Dialog: 0,0:34:24.43,0:34:27.87,Lalai,,0,0,0,,Hei, saya cuma nak awak putus\Nsebelum awak membesar antara satu sama lain,
Dialog: 0,0:34:27.89,0:34:31.10, Lalai,,0,0,0,,dan jujurlah. Dia bukan jenis awak.
Dialog: 0,0:34:36.44,0:34:38.31,Lalai,,0,0,0,,- Lepaskan saya.\N- Okay.
Dialog: 0,0:34:41.91,0:34:45.39,Lalai,,0,0,0,,Apa sebenarnya jenis dia?
Dialog: 0,0:34:45.41,0:34:47.36, Lalai,,0,0,0,,Wanita lembut dan tulen.
Dialog: 0,0:34:47.41,0:34:49.22,Lalai,,0,0,0,,Bukan seseorang yang pemarah seperti anda.
Dialog: 0,0:34:49.25,0:34:51.44, Lalai,,0,0,0,,Seseorang yang memerlukan perlindungan.
Dialog: 0,0:34:51.46,0:34:54.52,Lalai,,0,0,0,,Dia selalu cakap macam tu sejak sekolah menengah lagi.
Dialog: 0,0:34:54.55,0:34:56.71,Lalai,,0,0,0,,Adakah itu benar, Encik Baek?
Dialog: 0,0:34:57.59,0:35:00.46,Lalai,,0,0,0,,Ya, itu dulu jenis saya,
Dialog: 0,0:35:02.05,0:35:03.75,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:35:04.31,0:35:06.55,Lalai,,0,0,0,,wanita yang saya cintai sekarang...
Dialog: 0,0:35:07.10,0:35:08.63, Lalai,,0,0,0,,adakah anda,
Dialog: 0,0:35:10.52,0:35:11.79,Lalai,,0,0,0,,jadi...
Dialog: 0,0:35:11.81,0:35:14.52,Lalai,,0,0,0,,tak payahlah dengar cakap dia.
Dialog: 0,0:35:15.23,0:35:16.98, Lalai,,0,0,0,,Jom.
Dialog: 0,0:35:18.24,0:35:20.06, Lalai,,0,0,0,,Jom.
Dialog: 0,0:35:28.04,0:35:29.89, Lalai,,0,0,0,,Itu mengagumkan.
Dialog: 0,0:35:29.91,0:35:32.52, Lalai,,0,0,0,,Saya tidak percaya anda melakukan itu.
Dialog: 0,0:35:32.54,0:35:34.90,Lalai,,0,0,0,,Ringkasnya, saya membantu mereka berkumpul.
Dialog: 0,0:35:34.92,0:35:38.52,Lalai,,0,0,0,,Mereka kelihatan semakin rapat selepas kejadian itu.
Dialog: 0,0:35:38.55,0:35:40.57, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:35:40.59,0:35:42.58,Lalai,,0,0,0,,Apa yang ada di dunia...
Dialog: 0,0:35:42.72,0:35:44.88,Lalai,,0,0,0,,{\i1}berlaku kepada mereka?{\i0}
Dialog: 0,0:36:04.20,0:36:05.68, Lalai,,0,0,0,,Tidak mengapa. Biar saya buat.
Dialog: 0,0:36:05.70,0:36:06.97, Lalai,,0,0,0,,- Ya, tuan.\N- Terima kasih.
Dialog: 0,0:36:06.99,0:36:08.69, Lalai,,0,0,0,,Tiada masalah.
Dialog: 0,0:36:25.51,0:36:27.63, Lalai,,0,0,0,,Saya tidak menunggu.
Dialog: 0,0:36:27.68,0:36:31.30,Lalai,,0,0,0,,Jangan fikir saya menunggu\Nyou hanya kerana saya berjaga.
Dialog: 0,0:36:31.85,0:36:34.72,Lalai,,0,0,0,,Saya tidak fikir begitu. Jom masuk dalam.
Dialog: 0,0:36:35.40,0:36:37.10,Lalai,,0,0,0,,Sejuk.
Dialog: 0,0:36:39.57,0:36:41.34, Lalai,,0,0,0,,Saya tidak boleh tidur.
Dialog: 0,0:36:41.36,0:36:43.92,Lalai,,0,0,0,,Itu bukan katil saya sendiri, anjing-anjing semuanya menyalak,
Dialog: 0,0:36:43.95,0:36:46.26, Lalai,,0,0,0,,dan saya tidak mempunyai pil tidur. sebab tu.
Dialog: 0,0:36:46.28,0:36:48.72,Lalai,,0,0,0,,Baiklah. Saya rasa awak juga tidak menunggu.
Dialog: 0,0:36:48.74,0:36:51.56,Lalai,,0,0,0,,Anda tidak pernah menunggu saya sebelum ini.
Dialog: 0,0:36:51.58,0:36:54.73, Lalai,,0,0,0,,Anda betul. Saya bukan jenis yang akan menunggu.
Dialog: 0,0:36:54.75,0:36:57.70,Lalai,,0,0,0,,Ya, saya tahu itu lebih baik daripada orang lain.
Dialog: 0,0:37:19.77,0:37:22.06, Lalai,,0,0,0,,Pegang payung dengan betul.
Dialog: 0,0:37:24.78,0:37:26.80,Lalai,,0,0,0,,Baiklah, jadi mari kita masuk sahaja.
Dialog: 0,0:37:26.82,0:37:29.26,Lalai,,0,0,0,,Mencurah-curah. Anda akan diserang selsema.
Dialog: 0,0:37:29.28,0:37:30.59,Lalai,,0,0,0,,Kita boleh bercakap di rumah.
Dialog: 0,0:37:30.62,0:37:32.57,Lalai,,0,0,0,,Saya sudah selesai bercakap.
Dialog: 0,0:37:43.09,0:37:44.65, Lalai,,0,0,0,,Di mana payung awak?
Dialog: 0,0:37:44.67,0:37:46.54, Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:37:47.51,0:37:49.54,Lalai,,0,0,0,,Mari kita bincang di dalam.
Dialog: 0,0:37:51.43,0:37:53.38,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:38:27.55,0:38:28.94, Lalai,,0,0,0,,Biar saya tukar.
Dialog: 0,0:38:28.97,0:38:30.79,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:38:34.31,0:38:36.13, Lalai,,0,0,0,,Adakah anda mahu minum teh?
Dialog: 0,0:38:36.31,0:38:38.01, Lalai,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:38:39.15,0:38:41.51,Lalai,,0,0,0,,Saya rasa seperti pemilik di sini.
Dialog: 0,0:38:43.90,0:38:47.39,Lalai,,0,0,0,,By the way, kenapa awak ada di sini?
Dialog: 0,0:38:47.53,0:38:48.76,Lalai,,0,0,0,,Betul.
Dialog: 0,0:38:48.78,0:38:50.63,Lalai,,0,0,0,,Ibu Hae-in menjemput saya.
Dialog: 0,0:38:50.66,0:38:52.01, Lalai,,0,0,0,,Dia pasti berasa teruk...
Dialog: 0,0:38:52.03,0:38:53.97,Lalai,,0,0,0,,saya terpaksa makan seorang diri di hotel,
Dialog: 0,0:38:53.99,0:38:55.85, Lalai,,0,0,0,,jadi dia menawarkan rumah tetamu kepada saya.
Dialog: 0,0:38:55.87,0:38:57.72,Lalai,,0,0,0,,Hae-in dan saya ada urusan,
Dialog: 0,0:38:57.75,0:39:01.49,Lalai,,0,0,0,,jadi tinggal di sini akan lebih memudahkan kita.
Dialog: 0,0:39:02.46,0:39:06.06, Lalai,,0,0,0,,- Adakah anda tidak selesa?\N- Adakah anda akan pergi jika saya berkata ya?
Dialog: 0,0:39:06.09,0:39:07.62, Lalai,,0,0,0,,No.
Dialog: 0,0:39:10.47,0:39:12.92, Lalai,,0,0,0,, Maka tiada gunanya menjawab.
Dialog: 0,0:39:24.11,0:39:25.79, Lalai,,0,0,0,,Apa ini?
Dialog: 0,0:39:25.82,0:39:27.60, Lalai,,0,0,0,,Bilakah ini berlaku?
Dialog: 0,0:39:37.37,0:39:40.36,Lalai,,0,0,0,,Apa? Mengapa ia tidak akan dicuci?
Dialog: 0,0:39:46.92,0:39:49.50,Lalai,,0,0,0,,Minum. Anda akan diserang selsema.
Dialog: 0,0:39:50.72,0:39:52.29,Lalai,,0,0,0,,Di mana dia?
Dialog: 0,0:39:52.39,0:39:53.57,Lalai,,0,0,0,,En. Baek?
Dialog: 0,0:39:53.59,0:39:55.34, Lalai,,0,0,0,,Dia naik ke atas.
Dialog: 0,0:39:56.06,0:39:58.30, Lalai,,0,0,0,,- Saya faham.\N- Bukankah dia di dalam bilik?
Dialog: 0,0:39:59.77,0:40:01.59,Lalai,,0,0,0,,No.
Dialog: 0,0:40:04.09,0:40:06.33, Lalai,,0,0,0,,Adakah anda tidur secara berasingan?
Dialog: 0,0:40:10.36,0:40:11.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana perkahwinan mereka?{\c}{\i0}
Dialog: 0,0:40:11.57,0:40:13.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengerikan.{\c}{\i0}
Dialog: 0,0:40:13.74,0:40:16.19, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka telah tidur secara berasingan,{\c}{\i0}
Dialog: 0,0:40:16.24,0:40:18.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi pelik.{\c}{\i0}
Dialog: 0,0:40:18.20,0:40:22.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jelas sekali bahawa Hyun-woo\Nmusik dan bosan dengan mertuanya,{\c}{\i0}
Dialog: 0,0:40:22.58,0:40:24.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi dia tetap mengatakan perkara yang betul,{\c}{\i0}
Dialog: 0,0:40:24.88,0:40:25.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan anda tahu apa?{\c}{\i0}
Dialog: 0,0:40:25.88,0:40:27.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pengerusi Hong...{\c}{\i0}
Dialog: 0,0:40:27.38,0:40:30.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}sebenarnya mendengar apa yang dia katakan.{\c}{\i0}
Dialog: 0,0:40:30.84,0:40:34.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in dan Hyun-woo bertengkar\Npada bila-bila masa mereka bersama,{\c}{\i0}
Dialog: 0,0:40:34.09,0:40:37.11, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi anehnya, dia juga mendengarnya.{\c}{\i0}
Dialog: 0,0:40:37.14,0:40:41.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi Hyun-woo sedang membantu\Nmereka sedar?{\c}{\i0}
Dialog: 0,0:40:41.81,0:40:43.34, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tepat sekali.{\c}{\i0}
Dialog: 0,0:40:44.23,0:40:47.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia boleh menyebabkan masalah dalam rancangan kami.{\c}{\i0}
Dialog: 0,0:40:47.15,0:40:48.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Memang terbaik...{\c}{\i0}
Dialog: 0,0:40:48.44,0:40:51.69, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}untuk menendangnya keluar dari\Nrumah secepat mungkin.{\c}{\i0}
Dialog: 0,0:40:52.20,0:40:53.95,Lalai,,0,0,0,,Adakah kamu okey?
Dialog: 0,0:40:55.16,0:40:56.22,Lalai,,0,0,0,,Apa?
Dialog: 0,0:40:56.24,0:40:57.80, Lalai,,0,0,0,,Ini agak luar biasa.
Dialog: 0,0:40:57.83,0:41:02.56,Lalai,,0,0,0,,Suami akan terganggu\Kalau kawan lelaki isterinya...
Dialog: 0,0:41:02.58,0:41:04.68, Lalai,,0,0,0,, berpindah ke rumah mereka.
Dialog: 0,0:41:04.71,0:41:05.81,Lalai,,0,0,0,,Tetapi?
Dialog: 0,0:41:05.83,0:41:07.60,Lalai,,0,0,0,,Saya tanya dia...
Dialog: 0,0:41:07.63,0:41:10.83,Lalai,,0,0,0,,jika dia tidak selesa dengan saya tinggal di sini,
Dialog: 0,0:41:13.22,0:41:15.04, Lalai,,0,0,0,,dan dia tidak kisah.
Dialog: 0,0:41:29.02,0:41:31.85, Lalai,,0,0,0,,Mengapa dia mahu keluar dari hotel?
Dialog: 0,0:41:31.98,0:41:35.31,Lalai,,0,0,0,,Apakah yang ibu mertua saya fikirkan?
Dialog: 0,0:41:35.95,0:41:37.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in dan Saya...{\c}{\i0}
Dialog: 0,0:41:38.37,0:41:41.34,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}mempunyai hubungan yang baik pada masa lalu.{\c}{\i0}
Dialog: 0,0:41:41.37,0:41:43.76,Lalai,,0,0,0,,Mereka mempunyai hubungan yang baik.
Dialog: 0,0:41:43.79,0:41:48.07, Lalai,,0,0,0,,Dia bukan seseorang yang sepatutnya berada di sini.
Dialog: 0,0:41:48.21,0:41:51.08, Lalai,,0,0,0,, Astaga. Apakah jenis hubungan yang baik?
Dialog: 0,0:41:55.55,0:41:57.50,Lalai,,0,0,0,,Adakah saya akan kelihatan menyedihkan...
Dialog: 0,0:41:59.18,0:42:01.30, Lalai,,0,0,0,,kalau saya tanya dia sekarang?
Dialog: 0,0:42:10.77,0:42:12.42, Lalai,,0,0,0,,Jadi semuanya disambungkan di sini.
Dialog: 0,0:42:12.44,0:42:16.10,Lalai,,0,0,0,,Kami tidak pernah mendedahkan perkara ini kepada media.
Dialog: 0,0:42:16.74,0:42:18.88,Lalai,,0,0,0,,Mungkin kelihatan seperti rumah kita semua terpisah,
Dialog: 0,0:42:18.91,0:42:22.05, Lalai,,0,0,0,,tetapi semuanya\Nbersambung di ruangan bawah tanah.
Dialog: 0,0:42:22.08,0:42:24.51, Lalai,,0,0,0,,Datuk kita sengaja\Nreka bentuk begini.
Dialog: 0,0:42:24.54,0:42:25.76,Lalai,,0,0,0,,Saya nampak,
Dialog: 0,0:42:25.79,0:42:28.60, Lalai,,0,0,0,, jadi anda mempunyai akses kepada semua rumah di bawah ini.
Dialog: 0,0:42:28.62,0:42:30.64, Lalai,,0,0,0,,Ya, dan kami juga mempunyai bilik itu.
Dialog: 0,0:42:30.67,0:42:32.93, Lalai,,0,0,0,,Anda tahu filem dengan\Nsecret room, "Shock Room"?
Dialog: 0,0:42:32.95,0:42:34.65,Lalai,,0,0,0,,Ini "Bilik Panik," bodoh.
Dialog: 0,0:42:34.67,0:42:36.87, Lalai,,0,0,0,,- Saya tahu.\N- Kemudian perbetulkan.
Dialog: 0,0:42:39.97,0:42:42.24,Lalai,,0,0,0,,Jangan terlalu keras padanya.
Dialog: 0,0:42:42.26,0:42:45.74,Lalai,,0,0,0,,Mereka akan bawa makan malam kita\Di sini, jadi mari kita makan bersama.
Dialog: 0,0:42:45.77,0:42:48.39,Lalai,,0,0,0,,Kamu boleh makan. Saya akan berehat.
Dialog: 0,0:42:51.81,0:42:55.17,Lalai,,0,0,0,,Kenapa? Anda makan dengan sangat baik pada mertua anda,
Dialog: 0,0:42:55.19,0:42:56.80,Lalai,,0,0,0,,yang jarang anda temui.
Dialog: 0,0:42:56.82,0:43:00.59,Lalai,,0,0,0,,Anda makan semuanya dan tersenyum dari telinga ke telinga.
Dialog: 0,0:43:00.61,0:43:02.88,Lalai,,0,0,0,,Anda tahu video itu menjadi viral, bukan?
Dialog: 0,0:43:02.91,0:43:06.51, Lalai,,0,0,0,,Pasukan PR kami bekerja keras hari ini untuk menangani perkara itu.
Dialog: 0,0:43:06.54,0:43:09.36, Lalai,,0,0,0,,Mengapa awak kecewa sangat?
Dialog: 0,0:43:09.58,0:43:10.68, Lalai,,0,0,0,, Kerana saya melawat mereka?
Dialog: 0,0:43:10.71,0:43:13.06, Lalai,,0,0,0,,Sebab saya makan semuanya dan tersenyum?
Dialog: 0,0:43:13.09,0:43:14.31,Lalai,,0,0,0,,Atau...
Dialog: 0,0:43:14.34,0:43:15.36, Lalai,,0,0,0,, adakah video itu?
Dialog: 0,0:43:15.38,0:43:18.08,Lalai,,0,0,0,,Sebab pasukan PR terpaksa melindungi saya?
Dialog: 0,0:43:18.97,0:43:20.55,Lalai,,0,0,0,,Saya tidak kecewa.
Dialog: 0,0:43:20.58,0:43:21.61, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:43:21.64,0:43:22.78,Lalai,,0,0,0,,Saya hanya terpesona.
Dialog: 0,0:43:22.80,0:43:24.42,Lalai,,0,0,0,,Dengan apa?
Dialog: 0,0:43:24.64,0:43:27.59,Lalai,,0,0,0,,Saya jarang nampak awak senyum macam tu.
Dialog: 0,0:43:28.56,0:43:31.47,Lalai,,0,0,0,,Saya juga jarang melihat awak tersenyum kepada saya.
Dialog: 0,0:43:33.98,0:43:37.73, Lalai,,0,0,0,, Kita tidak perlu tersenyum, bukan?
Dialog: 0,0:43:37.78,0:43:39.21,Lalai,,0,0,0,,Tepat sekali,
Dialog: 0,0:43:39.24,0:43:41.10,Lalai,,0,0,0,,jadi makan tanpa saya.
Dialog: 0,0:43:42.11,0:43:44.36, Lalai,,0,0,0,,Selamat menikmati.
Dialog: 0,0:43:56.75,0:43:58.91, Lalai,,0,0,0,,Anda pasti terkejut.
Dialog: 0,0:43:59.80,0:44:02.00, Lalai,,0,0,0,,Saya akan memohon maaf bagi pihaknya.
Dialog: 0,0:44:02.34,0:44:04.04, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:44:06.72,0:44:08.45, Lalai,,0,0,0,,Ia perkara biasa.
Dialog: 0,0:44:08.47,0:44:10.95, Lalai,,0,0,0,,Bolehkah anda lihat betapa saya bergelut di sini?
Dialog: 0,0:44:10.98,0:44:13.01,Lalai,,0,0,0,,Betul.
Dialog: 0,0:44:13.19,0:44:16.18,Lalai,,0,0,0,,Tetapi saya faham Hae-in.
Dialog: 0,0:44:16.86,0:44:20.67,Lalai,,0,0,0,,Saya pasti anda sudah tahu,\Ntetapi dia mempunyai perangai yang teruk.
Dialog: 0,0:44:20.69,0:44:26.07, Lalai,,0,0,0,,Saya pasti rasa tidak selamatnya\Nterhadap saya memainkan peranan.
Dialog: 0,0:44:27.20,0:44:29.68,Lalai,,0,0,0,,Saya rasa dia tidak rasa begitu.
Dialog: 0,0:44:29.70,0:44:34.78,Lalai,,0,0,0,,Dia tidak tahu saya sedang melangkah untuknya.
Dialog: 0,0:44:38.00,0:44:41.21, Lalai,,0,0,0,,Saya tidak tahu anda sedang berjalan sendiri.
Dialog: 0,0:44:41.30,0:44:45.54,Lalai,,0,0,0,,Bukan mudah untuk duduk di atas Takhta Ratu. Banyak yang perlu dilakukan.
Dialog: 0,0:44:46.14,0:44:48.88, Lalai,,0,0,0,,Nampak tak apa yang ada di bahu saya?
Dialog: 0,0:44:50.10,0:44:52.93, Lalai,,0,0,0,,Beban dan tanggungjawab.
Dialog: 0,0:44:53.56,0:44:56.76, Lalai,,0,0,0,, Itulah sebab saya lebih pendek empat inci.
Dialog: 0,0:44:57.27,0:45:00.73,Lalai,,0,0,0,,Kedua-dua nasib saya dan Hae-in membebankan saya.
Dialog: 0,0:45:01.32,0:45:03.35, Lalai,,0,0,0,, Hae-in membebankan awak?
Dialog: 0,0:45:03.61,0:45:05.97, Lalai,,0,0,0,,Dia baru-baru ini menumbuk perut saya,
Dialog: 0,0:45:05.99,0:45:08.26, Lalai,,0,0,0,, dan saya tidak boleh bernafas untuk satu minit yang baik.
Dialog: 0,0:45:08.28,0:45:12.06,Lalai,,0,0,0,,Ibu saya sangat terkejut, dan mereka banyak bertengkar,
Dialog: 0,0:45:12.08,0:45:15.49, Lalai,,0,0,0,,jadi ibu saya melawat seseorang.
Dialog: 0,0:45:15.92,0:45:17.62,Lalai,,0,0,0,,Siapa?
Dialog: 0,0:45:18.13,0:45:21.40,Lalai,,0,0,0,,Dia tahu siapa yang akan menjadi Presiden\Nand malah meramalkan COVID-19.
Dialog: 0,0:45:21.42,0:45:24.40,Lalai,,0,0,0,,Dia juga memberi amaran kepada\Ayah saya supaya tidak pergi memburu.
Dialog: 0,0:45:24.43,0:45:26.24,Lalai,,0,0,0,,Betul, bomoh besar.
Dialog: 0,0:45:26.26,0:45:27.24,Lalai,,0,0,0,,Ya, dia.
Dialog: 0,0:45:27.26,0:45:32.30, Lalai,,0,0,0,,Dia membayarnya sejumlah besar, dan mendapat ini.
Dialog: 0,0:45:36.40,0:45:38.00,Lalai,,0,0,0,,Azimat?
Dialog: 0,0:45:38.02,0:45:40.68, Lalai,,0,0,0,,{\an8}Ini akan memastikan saya selamat.
Dialog: 0,0:45:41.44,0:45:43.29,Lalai,,0,0,0,,Bomoh itu berkata...
Dialog: 0,0:45:43.32,0:45:47.30,Lalai,,0,0,0,,ini akan membantu saya menundukkan Hae-in,\Nsupaya saya boleh melebarkan sayap dan terbang.
Dialog: 0,0:45:47.32,0:45:48.80, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:45:48.82,0:45:52.10,Lalai,,0,0,0,,Astaga, saya tidak percaya dia.\NIItu semua khurafat,
Dialog: 0,0:45:52.12,0:45:55.72,Lalai,,0,0,0,,tetapi ibu saya menyemak sama ada saya menyimpannya pada saya.
Dialog: 0,0:45:55.75,0:45:57.31,Lalai,,0,0,0,,Saya rasa ia tidak berkesan.
Dialog: 0,0:45:57.33,0:46:00.58,Lalai,,0,0,0,,Hae-in masih sama kuatnya.
Dialog: 0,0:46:01.09,0:46:03.98,Lalai,,0,0,0,,{\i1}Rawatan yang dicadangkan oleh makmal Jerman...{\i0}
Dialog: 0,0:46:04.01,0:46:05.32,Lalai,,0,0,0,,{\i1}menggunakan sel CAR-T...{\i0}
Dialog: 0,0:46:05.34,0:46:08.36,Lalai,,0,0,0,,{\i1}untuk merawat sel imun.{\i0}
Dialog: 0,0:46:08.39,0:46:11.26,Lalai,,0,0,0,,{\i1}Ia adalah sejenis rawatan kanser\Ndi mana mereka mengekstrak sel imun...{\i0}
Dialog: 0,0:46:11.28,0:46:15.12,Lalai,,0,0,0,,{\i1}daripada darah anda, ubahlah ia menjadi\NCAR-T sel yang mempunyai keupayaan...{\i0}
Dialog: 0,0:46:15.14,0:46:18.12, Lalai,,0,0,0,,{\i1}untuk membuang sel tumor dan\Nsuntikkan semula ke dalam badan anda.{\i0}
Dialog: 0,0:46:18.15,0:46:20.67,Lalai,,0,0,0,,{\i1}Rawatan ini selalunya\Nterbukti berkesan...{\i0}
Dialog: 0,0:46:20.69,0:46:22.75,Lalai,,0,0,0,,{\i1}untuk mereka yang menghidap leukemia,{\i0}
Dialog: 0,0:46:22.77,0:46:26.02, Lalai,,0,0,0,,tetapi belum lagi dengan tumor otak.
Dialog: 0,0:46:27.36,0:46:29.13,Lalai,,0,0,0,,Tetapi...
Dialog: 0,0:46:29.16,0:46:32.14, Lalai,,0,0,0,,mereka berkata kadar kejayaan melebihi 50%.
Dialog: 0,0:46:32.16,0:46:35.81,Lalai,,0,0,0,,Saya percaya mereka memberi anda\Nangka itu selepas melihat ramalan yang baik...
Dialog: 0,0:46:35.83,0:46:38.18, Lalai,,0,0,0,,pada pesakit tumor otak...
Dialog: 0,0:46:38.21,0:46:42.15,Lalai,,0,0,0,,yang diberi rawatan ini dalam beberapa tahun kebelakangan ini,
Dialog: 0,0:46:42.17,0:46:45.02, Lalai,,0,0,0,,tetapi anda tidak sepatutnya menganggap itu pemulihan sepenuhnya.
Dialog: 0,0:46:45.05,0:46:47.00, Lalai,,0,0,0,,Saya akan.
Dialog: 0,0:46:47.05,0:46:49.29,Lalai,,0,0,0,,Saya beritahu awak banyak kali.
Dialog: 0,0:46:49.55,0:46:51.57,Lalai,,0,0,0,,Saya akan cari jalan.
Dialog: 0,0:46:51.60,0:46:54.21, Lalai,,0,0,0,, Walaupun saya perlu mencari dunia,
Dialog: 0,0:46:54.26,0:46:56.42,Lalai,,0,0,0,,Saya akan cari jalan untuk hidup,
Dialog: 0,0:46:56.93,0:46:59.14,Lalai,,0,0,0,,jadi jangan beritahu saya...
Dialog: 0,0:47:02.44,0:47:04.52, Lalai,,0,0,0,,ia tidak akan berfungsi.
Dialog: 0,0:47:14.41,0:47:16.39,Lalai,,0,0,0,,{\i1}Bayi mereka berada dalam inkubator.{\i0}
Dialog: 0,0:47:16.41,0:47:18.45,Lalai,,0,0,0,,{\i1}Saya berasa teruk, jadi...{\i0}
Dialog: 0,0:47:29.97,0:47:31.83, Lalai,,0,0,0,,Bagaimana keadaan bayi anda?
Dialog: 0,0:47:32.93,0:47:33.99,Lalai,,0,0,0,,Hello, puan.
Dialog: 0,0:47:34.01,0:47:35.70,Lalai,,0,0,0,,Apa yang membawa anda ke hospital?
Dialog: 0,0:47:35.72,0:47:37.20,Lalai,,0,0,0,,Adakah ia masih dalam inkubator?
Dialog: 0,0:47:37.22,0:47:39.54, Lalai,,0,0,0,,Tidak, tidak lagi,
Dialog: 0,0:47:39.56,0:47:42.12,Lalai,,0,0,0,,- tetapi bayi kami di ICU.\N- Siapa nama bayi itu?
Dialog: 0,0:47:42.15,0:47:45.47,Lalai,,0,0,0,,Kami belum mendaftar kelahiran,
Dialog: 0,0:47:46.11,0:47:48.27,Lalai,,0,0,0,,tetapi Cho-rong ialah nama panggilannya.
Dialog: 0,0:47:50.86,0:47:53.93,Lalai,,0,0,0,,Saya pernah minum jus sayuran setiap pagi,
Dialog: 0,0:47:53.95,0:47:56.97,Lalai,,0,0,0,,tetapi saya sibuk sejak kebelakangan ini,\Njadi saya lupa.
Dialog: 0,0:47:56.99,0:47:58.39,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:47:58.41,0:48:01.43,Lalai,,0,0,0,,Saya ingin memesan jus daripada anda dengan kerap.
Dialog: 0,0:48:01.46,0:48:03.24,Lalai,,0,0,0,,Terima kasih, puan.
Dialog: 0,0:48:03.54,0:48:06.10,Lalai,,0,0,0,,Saya akan menghantar satu kepada anda, mulai esok...
Dialog: 0,0:48:06.13,0:48:09.40,Lalai,,0,0,0,,Nampak murah jika saya memilikinya\Nsendiri, jadi bawa beberapa lagi.
Dialog: 0,0:48:09.42,0:48:11.40,Lalai,,0,0,0,,Ya, puan. Berapa banyak lagi yang anda mahu?
Dialog: 0,0:48:11.43,0:48:12.82,Lalai,,0,0,0,,Nah...
Dialog: 0,0:48:12.84,0:48:16.38, Lalai,,0,0,0,,Jika semua pekerja saya\Ndapat satu, maka kira-kira 250 orang.
Dialog: 0,0:48:16.72,0:48:18.42,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:48:20.27,0:48:22.34,Lalai,,0,0,0,,Terima kasih, puan!
Dialog: 0,0:48:22.94,0:48:24.97,Lalai,,0,0,0,,Terima kasih!
Dialog: 0,0:48:26.52,0:48:29.09, Lalai,,0,0,0,,Tuan, ini adalah pelan tindakan\NI telah beritahu anda.
Dialog: 0,0:48:29.11,0:48:33.30, Lalai,,0,0,0,,Itu resort kompleks yang akan menjadi\Nistana empayar Queens kita.
Dialog: 0,0:48:33.32,0:48:36.72,Lalai,,0,0,0,,Ia termasuk dua hotel lima bintang,\Kedai bebas cukai, kasino untuk warga asing,
Dialog: 0,0:48:36.74,0:48:39.35, Lalai,,0,0,0,, arena, pusat konvensyen,\Taman air keluarga Na...
Dialog: 0,0:48:39.37,0:48:41.65, Lalai,,0,0,0,,Dan berapa kosnya?
Dialog: 0,0:48:41.96,0:48:43.87, Lalai,,0,0,0,,Satu bilion...
Dialog: 0,0:48:46.67,0:48:49.66, Lalai,,0,0,0,,- dan 700 hingga 900 juta dolar.\N- Lakukan...
Dialog: 0,0:48:50.84,0:48:52.11, Lalai,,0,0,0,,Dengan wang anda.
Dialog: 0,0:48:52.13,0:48:54.19,Lalai,,0,0,0,,Atuk, saya tidak meminta wang anda.
Dialog: 0,0:48:54.22,0:48:57.70,Lalai,,0,0,0,,Kami hanya perlu memastikan tapak,\Nand Eun-sung akan melabur dalam kami.
Dialog: 0,0:48:57.72,0:48:58.82,Lalai,,0,0,0,,Siapa?
Dialog: 0,0:48:58.85,0:49:00.16, Lalai,,0,0,0,, En. Yoon Eun-sung.
Dialog: 0,0:49:00.18,0:49:03.05,Lalai,,0,0,0,,Kami agak rapat sejak dia berpindah.
Dialog: 0,0:49:03.19,0:49:05.33, Lalai,,0,0,0,,Adakah anda mengatakan dia bersetuju dengan ini?
Dialog: 0,0:49:05.35,0:49:08.83,Lalai,,0,0,0,,Kami masih di peringkat awal, tetapi anda boleh katakan begitu.
Dialog: 0,0:49:08.86,0:49:10.67, Lalai,,0,0,0,,Saya malu untuk mengatakan ini,
Dialog: 0,0:49:10.69,0:49:12.81, Lalai,,0,0,0,,tetapi dia sangat merugikan saya.
Dialog: 0,0:49:12.94,0:49:14.60,Lalai,,0,0,0,,Dia tidak berhati dingin seperti yang saya sangka.
Dialog: 0,0:49:14.62,0:49:17.13,Lalai,,0,0,0,,Dia sangat penyayang\Setelah anda membesar dengan dia.
Dialog: 0,0:49:17.16,0:49:18.13, Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,0:49:18.16,0:49:20.14, Lalai,,0,0,0,,Dia pasti menyukai anda.
Dialog: 0,0:49:20.16,0:49:21.55, Lalai,,0,0,0,,Ia lebih daripada itu.
Dialog: 0,0:49:21.58,0:49:26.91,Lalai,,0,0,0,,Dia tidak sabar-sabar untuk mendengar apa yang saya mahu lakukan.
Dialog: 0,0:49:27.29,0:49:28.99,Lalai,,0,0,0,,Adakah dia?
Dialog: 0,0:49:29.13,0:49:32.52,Lalai,,0,0,0,,Ayah, dana Encik Yoon datang\Ndari wang minyak Timur Tengah,
Dialog: 0,0:49:32.55,0:49:34.19,Lalai,,0,0,0,,jadi dia boleh dipercayai.
Dialog: 0,0:49:34.22,0:49:35.23,Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,0:49:35.26,0:49:36.78, Lalai,,0,0,0,,- Kalau macam tu...\N- Tunggu.
Dialog: 0,0:49:36.80,0:49:39.36,Lalai,,0,0,0,,Saya rasa kita patut melakukan\Nsemakan kesahihan tapak dahulu.
Dialog: 0,0:49:39.39,0:49:42.95,Lalai,,0,0,0,,{\an8}Kami telah melakukan banyak kemungkinan\Nkajian di tapak kami pada masa lalu.
Dialog: 0,0:49:42.97,0:49:45.58,Lalai,,0,0,0,,{\an8}Walau bagaimanapun, tiada seorang pun daripada mereka\Nselesai kerana beberapa risiko.
Dialog: 0,0:49:45.60,0:49:48.50, Lalai,,0,0,0,,Kami memerlukan lesen kerajaan\Nuntuk kedai dan kasino bebas cukai.
Dialog: 0,0:49:48.52,0:49:50.17,Lalai,,0,0,0,,Bagi pelesenan...
Dialog: 0,0:49:50.19,0:49:53.50,Lalai,,0,0,0,,Anda tahu kami mempunyai orang kami\Nin Kementerian Tanah.
Dialog: 0,0:49:53.53,0:49:57.61,Lalai,,0,0,0,,Kami boleh mempercayainya sejak dia\N menerima biasiswa kami.
Dialog: 0,0:49:57.72,0:49:59.65, Lalai,,0,0,0,,Tetapi orang boleh berubah.
Dialog: 0,0:49:59.99,0:50:04.32,Lalai,,0,0,0,,Adalah berisiko untuk bergantung padanya dan\Nmulakan perniagaan bernilai $1.9 bilion.
Dialog: 0,0:50:07.33,0:50:11.29, Lalai,,0,0,0,,Itu satu perkara yang adil, bukan?
Dialog: 0,0:50:11.71,0:50:14.69, Lalai,,0,0,0,,Ya, Bapa. Dia tahu apa yang penting.
Dialog: 0,0:50:14.72,0:50:16.42, Lalai,,0,0,0,,Bapa?
Dialog: 0,0:50:16.68,0:50:19.50, Lalai,,0,0,0,,Semak risiko dahulu.
Dialog: 0,0:50:21.97,0:50:25.63, Lalai,,0,0,0,,Tidak salah untuk menyemak, Soo-cheol.
Dialog: 0,0:50:33.82,0:50:35.52, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:50:35.61,0:50:37.27, Lalai,,0,0,0,,Helo, tuan.
Dialog: 0,0:50:43.49,0:50:47.16,Lalai,,0,0,0,,Awak suruh saya telefon jika saya teringat apa-apa.
Dialog: 0,0:50:47.71,0:50:50.60, Lalai,,0,0,0,,Seorang penghantar gas datang pada hari itu.
Dialog: 0,0:50:50.63,0:50:52.87, Lalai,,0,0,0,,Kamera pemuka?
Dialog: 0,0:50:53.00,0:50:56.02, Lalai,,0,0,0,,Ya, dia ada.
Dialog: 0,0:50:56.05,0:50:57.98,Lalai,,0,0,0,,Saya menerimanya,
Dialog: 0,0:50:58.01,0:51:01.90, Lalai,,0,0,0,,tetapi saiz ingatannya kecil,\Njadi rakaman dari hari itu hilang.
Dialog: 0,0:51:01.93,0:51:04.62,Lalai,,0,0,0,,Tidak mengapa. Saya akan cuba memulihkannya.
Dialog: 0,0:51:04.64,0:51:08.22, Lalai,,0,0,0,,Saya akan menghantar penghantar untuk mengambilnya.
Dialog: 0,0:51:08.52,0:51:10.22, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:51:11.31,0:51:12.46, Lalai,,0,0,0,,Ini daripada kamera pemuka.
Dialog: 0,0:51:12.48,0:51:14.71, Lalai,,0,0,0,,Rakaman lama telah dipadamkan.
Dialog: 0,0:51:14.73,0:51:16.29, Lalai,,0,0,0,,Berapa lama masa untuk memulihkannya?
Dialog: 0,0:51:16.32,0:51:18.67, Lalai,,0,0,0,,Nah, saya akan katakan sekurang-kurangnya tiga hingga empat hari,
Dialog: 0,0:51:18.70,0:51:19.76, Lalai,,0,0,0,,tetapi tiada jaminan.
Dialog: 0,0:51:19.78,0:51:22.55, Lalai,,0,0,0,,Ia adalah rakaman penting,\Njadi sila pulihkannya dengan baik.
Dialog: 0,0:51:22.57,0:51:24.28,Lalai,,0,0,0,,Okey.
Dialog: 0,0:51:24.70,0:51:28.26,Lalai,,0,0,0,,Doktor, pengerusi kami berminat\Nin keledek minggu lepas,
Dialog: 0,0:51:28.29,0:51:30.68, Lalai,,0,0,0,,kerana itu adalah makanan kegemaran Lessie Brown...
Dialog: 0,0:51:30.71,0:51:32.14, Lalai,,0,0,0,,sehingga kematiannya pada 114.
Dialog: 0,0:51:32.17,0:51:36.27,Lalai,,0,0,0,,Saya dengar dia berminat dengan\Nberi minggu lepas, kerana mereka...
Dialog: 0,0:51:36.30,0:51:38.73, Lalai,,0,0,0,,Makanan kegemaran Christina Wahara\N sehingga kematiannya pada usia 102 tahun.
Dialog: 0,0:51:38.76,0:51:40.50,Lalai,,0,0,0,,Betul.
Dialog: 0,0:51:40.80,0:51:46.16,Lalai,,0,0,0,,Tetapi kerana Brown hidup 12\Ntahun lebih lama daripada Wahara...
Dialog: 0,0:51:46.18,0:51:49.08, Lalai,,0,0,0,,Kemudian keledek kering? Dia suka makanan manis.
Dialog: 0,0:51:49.10,0:51:52.08, Lalai,,0,0,0,,Tidak, dia mempunyai gula darah tinggi.\NAnda harus merebusnya.
Dialog: 0,0:51:52.10,0:51:53.41, Lalai,,0,0,0,,Dia tidak akan suka itu.
Dialog: 0,0:51:53.44,0:51:54.42,Lalai,,0,0,0,,Ia tidak dapat dielakkan.
Dialog: 0,0:51:54.44,0:51:59.88, Lalai,,0,0,0,,Sila hidangkan dia dada ayam,\Nkacang dan putih telur buat masa ini.
Dialog: 0,0:51:59.90,0:52:01.69,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:52:02.20,0:52:05.07, Lalai,,0,0,0,,Putih telur, dada ayam,
Dialog: 0,0:52:05.28,0:52:06.68, Lalai,,0,0,0,,dan kekacang? Ayuh.
Dialog: 0,0:52:06.70,0:52:09.47, Lalai,,0,0,0,,Dia mengunyah tulang rusuk setiap kali dia kecewa.
Dialog: 0,0:52:09.50,0:52:10.68, Lalai,,0,0,0,,Dia juga boleh mati.
Dialog: 0,0:52:10.71,0:52:12.02, Lalai,,0,0,0,, Tonton apa yang anda katakan.
Dialog: 0,0:52:12.04,0:52:13.10, Lalai,,0,0,0,, Apakah jabatan anda?
Dialog: 0,0:52:13.12,0:52:15.27,Lalai,,0,0,0,,- Perubatan keluarga, puan.\N- Encik Jang.
Dialog: 0,0:52:15.29,0:52:18.56,Lalai,,0,0,0,,Pakar psikiatri ayah saya juga sepatutnya berada di sini,
Dialog: 0,0:52:18.59,0:52:20.94, Lalai,,0,0,0,,supaya dia boleh mengambil kira keadaan mentalnya.
Dialog: 0,0:52:20.97,0:52:22.82,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:52:22.84,0:52:24.50,Lalai,,0,0,0,,Juga...
Dialog: 0,0:52:28.60,0:52:30.88,Lalai,,0,0,0,,Saya tidak boleh amanahkan awak...
Dialog: 0,0:52:31.27,0:52:34.41, Lalai,,0,0,0,,dengan menyediakan hidangan ayah saya.
Dialog: 0,0:52:34.44,0:52:36.29,Lalai,,0,0,0,,Saya dengar awak buat perasa sendiri.
Dialog: 0,0:52:36.31,0:52:40.59,Default,,0,0,0,,Dia hanya mahukan kicap yang saya buat.
Dialog: 0,0:52:40.61,0:52:43.40,Lalai,,0,0,0,,Tepat sekali. Siapa tahu apa yang anda masukkan ke dalam?
Dialog: 0,0:52:44.36,0:52:49.55,Lalai,,0,0,0,,Saya mahu anda mencuba semua makanannya di\Ndepan saya sebelum menghidangkannya kepadanya.
Dialog: 0,0:52:49.58,0:52:51.43, Lalai,,0,0,0,,Seperti yang dilakukan oleh wanita mahkamah itu.
Dialog: 0,0:52:51.45,0:52:54.24,Lalai,,0,0,0,,Tidak, anda akan menjadi gundiknya.
Dialog: 0,0:52:57.59,0:52:59.23, Lalai,,0,0,0,,Itu sahaja untuk hari ini.
Dialog: 0,0:52:59.25,0:53:01.46, Lalai,,0,0,0,, Anda boleh pergi.
Dialog: 0,0:53:04.09,0:53:05.36, Lalai,,0,0,0,,Apa yang kita buat?
Dialog: 0,0:53:05.39,0:53:08.32, Lalai,,0,0,0,,Bagaimana jika Beom-ja memukulnya lagi?
Dialog: 0,0:53:08.35,0:53:11.51, Lalai,,0,0,0,, Patutkah saya menunggu dan merawatnya selepas itu?
Dialog: 0,0:53:13.52,0:53:14.91, Lalai,,0,0,0,,Mengapa anda menguncinya?
Dialog: 0,0:53:14.94,0:53:17.31, Lalai,,0,0,0,, Bercadang untuk mengemis saya atau sesuatu?
Dialog: 0,0:53:18.44,0:53:20.47, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:53:28.70,0:53:30.53, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:53:32.00,0:53:33.10, Lalai,,0,0,0,, Beom-ja.
Dialog: 0,0:53:33.12,0:53:34.18, Lalai,,0,0,0,,"Beom-ja"?
Dialog: 0,0:53:34.21,0:53:37.18, Lalai,,0,0,0,,Anda telah bersikap kurang ajar dengan\N saya selama 20 tahun yang lalu,
Dialog: 0,0:53:37.21,0:53:38.56, Lalai,,0,0,0,, dan akan terus melakukannya.
Dialog: 0,0:53:38.59,0:53:41.62, Lalai,,0,0,0,,Tetapi rasa apa? Saya tidak lagi menganggapnya comel.
Dialog: 0,0:53:42.21,0:53:44.78,Lalai,,0,0,0,,Adakah anda gila? Beraninya\Nyou bercakap dengan saya seperti itu?
Dialog: 0,0:53:44.80,0:53:48.71, Lalai,,0,0,0,,"Comel"? Adakah anda mahu lebih banyak cakera tergelincir?
Dialog: 0,0:53:50.18,0:53:52.91, Lalai,,0,0,0,,Tunggu! Itu menyakitkan!
Dialog: 0,0:53:52.93,0:53:56.55, Lalai,,0,0,0,,Saya mengira hingga tiga. Satu, dua, tiga!
Dialog: 0,0:54:02.78,0:54:04.09, Lalai,,0,0,0,, Ketap rahang anda,
Dialog: 0,0:54:04.11,0:54:06.44, Lalai,,0,0,0,,- Kenapa?\N- ...atau anda akan menggigit lidah anda.
Dialog: 0,0:54:13.95,0:54:16.18, Lalai,,0,0,0,, Perempuan itu memukul saya!
Dialog: 0,0:54:16.21,0:54:18.18, Lalai,,0,0,0,,Dalam perut saya! Macam ni!
Dialog: 0,0:54:18.21,0:54:19.85, Lalai,,0,0,0,, Sial.
Dialog: 0,0:54:19.88,0:54:21.23, Lalai,,0,0,0,,Saya pasti awak pukul dia.
Dialog: 0,0:54:21.25,0:54:23.40, Lalai,,0,0,0,,Tidak, saya tidak!
Dialog: 0,0:54:23.42,0:54:25.48, Lalai,,0,0,0,,Saya pukul dia.
Dialog: 0,0:54:25.51,0:54:29.63, Lalai,,0,0,0,,Saya memukulnya kerana geram.
Dialog: 0,0:54:30.10,0:54:33.26, Lalai,,0,0,0,,- Saya minta maaf.\N- Nampak? Anda mendengarnya!
Dialog: 0,0:54:35.48,0:54:38.12, Lalai,,0,0,0,,Adakah anda fikir saya akan percaya dia?
Dialog: 0,0:54:38.14,0:54:39.12, Lalai,,0,0,0,,Kenapa tidak?
Dialog: 0,0:54:39.15,0:54:42.22,Lalai,,0,0,0,,Anda mungkin tidak percaya saya, tetapi anda percaya dia.
Dialog: 0,0:54:53.45,0:54:56.15, Lalai,,0,0,0,, Percayalah!
Dialog: 0,0:54:59.83,0:55:03.06, Lalai,,0,0,0,, Decaf biasa dengan tangkapan tambahan. Betul ke?
Dialog: 0,0:55:03.09,0:55:06.65, Lalai,,0,0,0,,- Anda tidak lupa.\N- Sudah tentu tidak. Anda penyelamat kami.
Dialog: 0,0:55:06.67,0:55:10.03, Lalai,,0,0,0,,Kami hanyalah samseng 15 tahun lalu,
Dialog: 0,0:55:10.05,0:55:11.49, Lalai,,0,0,0,,tetapi kami cepat menjadi...
Dialog: 0,0:55:11.51,0:55:13.78, Lalai,,0,0,0,, profesional urusan rahsia, terima kasih kepada anda.
Dialog: 0,0:55:13.81,0:55:15.41,Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:55:15.43,0:55:17.16,Lalai,,0,0,0,,Saya melihat bagaimana pejabat anda berkembang...
Dialog: 0,0:55:17.18,0:55:18.83,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Agensi Detektif MZ{\c}{\i0}
Dialog: 0,0:55:18.85,0:55:20.20,Lalai,,0,0,0,,...setiap kali saya bercerai.
Dialog: 0,0:55:20.23,0:55:24.56,Lalai,,0,0,0,,Kami bukan lagi detektif mudah\Nagency. Kami berlesen dan juga membayar cukai.
Dialog: 0,0:55:25.11,0:55:26.54, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:55:26.57,0:55:28.71, Lalai,,0,0,0,,Tanda anda berubah, jadi\NI hampir tidak dapat mencari anda,
Dialog: 0,0:55:28.74,0:55:30.21, Lalai,,0,0,0,,jadi apa awak sekarang?
Dialog: 0,0:55:30.24,0:55:33.18, Lalai,,0,0,0,,Kami adalah PIA yang lulus...
Dialog: 0,0:55:33.20,0:55:35.18, Lalai,,0,0,0,,ujian diperakui negeri.
Dialog: 0,0:55:35.20,0:55:37.47, Lalai,,0,0,0,,Pejabat penyiasatan persendirian.
Dialog: 0,0:55:37.50,0:55:38.81, Lalai,,0,0,0,,Kalau begitu, apa yang patut saya panggil awak?
Dialog: 0,0:55:38.83,0:55:40.31, Lalai,,0,0,0,,Bolehkah saya terus memanggil awak "Encik Park"?
Dialog: 0,0:55:40.33,0:55:42.62, Lalai,,0,0,0,,Panggil saya "Conan." Taman Conan.
Dialog: 0,0:55:45.46,0:55:47.16, Lalai,,0,0,0,,Conan, itu.
Dialog: 0,0:55:48.88,0:55:51.29, Lalai,,0,0,0,,Lakukan pemeriksaan latar belakang padanya.
Dialog: 0,0:55:54.26,0:55:56.99, Lalai,,0,0,0,,Kategori yang manakah itu?
Dialog: 0,0:55:57.02,0:56:00.62,Lalai,,0,0,0,,Kaedah penyiasatan berbeza\Nbergantung pada perkara yang anda ingin cari.
Dialog: 0,0:56:00.64,0:56:02.22, Lalai,,0,0,0,,Semuanya.
Dialog: 0,0:56:02.73,0:56:07.14, Lalai,,0,0,0,,Saya ingin tahu segala-galanya tentang dia.
Dialog: 0,0:56:07.65,0:56:10.94,Lalai,,0,0,0,,{\an8}Saya hanya membencinya sejak 20 tahun lalu.
Dialog: 0,0:56:11.24,0:56:14.48,Lalai,,0,0,0,,Saya akhirnya sedar selepas dia memukul saya.
Dialog: 0,0:56:14.53,0:56:16.61, Lalai,,0,0,0,,Saya perlu tahu...
Dialog: 0,0:56:16.70,0:56:18.32, Lalai,,0,0,0,,siapa dia.
Dialog: 0,0:56:20.16,0:56:22.66, Lalai,,0,0,0,, Sial.
Dialog: 0,0:56:33.13,0:56:35.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:56:36.93,0:56:38.24,Lalai,,0,0,0,,{\i1}Adakah anda bersedia?{\i0}
Dialog: 0,0:56:38.26,0:56:40.49, Lalai,,0,0,0,,{\i1}Ketekunan wajar Hercyna\Nteam akan berada di sini dalam lima masa.{\i0}
Dialog: 0,0:56:40.52,0:56:43.20,Lalai,,0,0,0,,Ya, orang saya sudah ada.
Dialog: 0,0:56:43.23,0:56:45.05, Lalai,,0,0,0,,Saya akan pergi sekarang.
Dialog: 0,0:57:56.51,0:57:58.84, Lalai,,0,0,0,,Saya sedang menunggu awak.
Dialog: 0,0:57:59.51,0:58:00.70, Lalai,,0,0,0,,Adakah anda okey?
Dialog: 0,0:58:00.72,0:58:02.51, Lalai,,0,0,0,,Ya, saya tidak apa-apa.
Dialog: 0,0:58:05.35,0:58:07.09,Lalai,,0,0,0,,Kami sudah lewat.
Dialog: 0,0:58:08.10,0:58:10.42, Lalai,,0,0,0,,Maaf, mereka mesti menunggu.
Dialog: 0,0:58:10.44,0:58:13.25, Lalai,,0,0,0,,Anda tidak kelihatan sihat. Adakah anda mahu berehat hari ini?
Dialog: 0,0:58:13.28,0:58:15.75, Lalai,,0,0,0,,Kami boleh menjadualkan semula.
Dialog: 0,0:58:15.78,0:58:17.73, Lalai,,0,0,0,,Tidak, tidak perlu.
Dialog: 0,0:58:19.53,0:58:21.07, Lalai,,0,0,0,,Jom.
Dialog: 0,0:58:22.16,0:58:23.69, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:58:50.77,0:58:52.17, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:58:52.19,0:58:53.93, Lalai,,0,0,0,,Jangan kisah saya.
Dialog: 0,0:59:10.00,0:59:11.70,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:59:12.29,0:59:13.69,Lalai,,0,0,0,,Muka awak masih pucat.
Dialog: 0,0:59:13.71,0:59:16.02,Lalai,,0,0,0,,Jika anda sakit...
Dialog: 0,0:59:16.05,0:59:17.58,Lalai,,0,0,0,,Saya tidak,
Dialog: 0,0:59:17.76,0:59:21.04, Lalai,,0,0,0,,tetapi saya harap saya begitu, supaya saya boleh berehat.
Dialog: 0,0:59:37.24,0:59:43.27, Lalai,,0,0,0,,Helo, semua. Terima kasih kerana\Datang. Nama saya Hong Hae-in.
Dialog: 0,0:59:47.20,0:59:50.41, Lalai,,0,0,0,,Adakah Hae-in sedang menjalani pemeriksaan kesihatan?
Dialog: 0,0:59:50.75,0:59:54.02,Lalai,,0,0,0,,Sudah agak lama dia tidak menyertai keluarganya...
Dialog: 0,0:59:54.04,0:59:56.33, Lalai,,0,0,0,,dengan pemeriksaan.
Dialog: 0,0:59:56.63,0:59:58.91, Lalai,,0,0,0,,Mungkin dia melakukannya di tempat lain.
Dialog: 0,0:59:59.84,1:00:01.94,Lalai,,0,0,0,,Sila ketahui di mana.
Dialog: 0,1:00:01.97,1:00:03.50,Lalai,,0,0,0,,Okey.
Dialog: 0,1:00:03.64,1:00:08.09,Lalai,,0,0,0,,Saya rasa anda patut menangguhkan\Perjalanan anda ke Jerman.
Dialog: 0,1:00:08.35,1:00:10.38,Lalai,,0,0,0,,Kenapa? untuk apa?
Dialog: 0,1:00:12.06,1:00:14.08,Lalai,,0,0,0,,Kilangan sel darah putih anda terlalu rendah.
Dialog: 0,1:00:14.11,1:00:16.58,Lalai,,0,0,0,,Mereka perlu mengekstrak dan mengubah sel anda...
Dialog: 0,1:00:16.61,1:00:18.54,Lalai,,0,0,0,,untuk rawatan sel imun,
Dialog: 0,1:00:18.57,1:00:22.26,Lalai,,0,0,0,,{\an8}tetapi mereka tidak boleh berbuat demikian apabila WBC anda terlalu rendah.
Dialog: 0,1:00:22.28,1:00:27.53,Lalai,,0,0,0,,Makmal di Jerman akan\Nenggan melakukannya dengan keputusan ini.
Dialog: 0,1:00:27.99,1:00:30.60,Lalai,,0,0,0,,Adakah anda memberitahu saya untuk menyerah, kemudian?
Dialog: 0,1:00:30.62,1:00:32.77,Lalai,,0,0,0,,Bukan itu yang saya maksudkan.
Dialog: 0,1:00:32.79,1:00:36.20,Lalai,,0,0,0,,Anda harus menunggu sehingga WBC anda meningkat...
Dialog: 0,1:00:37.25,1:00:38.95,Lalai,,0,0,0,,"Tunggu"?
Dialog: 0,1:00:40.26,1:00:42.92,Lalai,,0,0,0,,Saya tidak mempunyai masa untuk itu.
Dialog: 0,1:00:45.47,1:00:47.13,Lalai,,0,0,0,,Tunggu, Cik Hong.
Dialog: 0,1:00:52.81,1:00:55.76,Lalai,,0,0,0,,Tuan, saya sihat.
Dialog: 0,1:00:56.02,1:00:57.97,Lalai,,0,0,0,,Saya hampir tidak berasa sakit.
Dialog: 0,1:00:58.73,1:01:02.09,Lalai,,0,0,0,,Saya akan dapati ini\Ntumor celaka lebih awal jika saya mengalami kesakitan.
Dialog: 0,1:01:02.11,1:01:04.15,Lalai,,0,0,0,,Tetapi...
Dialog: 0,1:01:15.42,1:01:17.12,Lalai,,0,0,0,,Saya...
Dialog: 0,1:01:17.63,1:01:20.16,Lalai,,0,0,0,,Saya datang untuk pelakon ini.
Dialog: 0,1:01:21.38,1:01:23.92,Lalai,,0,0,0,,By the way...
Dialog: 0,1:01:24.22,1:01:25.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Jabatan Tumor Otak{\c}{\i0}
Dialog: 0,1:01:28.97,1:01:31.17,Lalai,,0,0,0,,Mengapa awak berada di sana?
Dialog: 0,1:01:39.27,1:01:40.75,Lalai,,0,0,0,,Awak kenal Mi-yeong?
Dialog: 0,1:01:40.78,1:01:42.13,Lalai,,0,0,0,,Siapa itu?
Dialog: 0,1:01:42.15,1:01:43.42,Lalai,,0,0,0,,Rakan saya.
Dialog: 0,1:01:43.44,1:01:45.21,Lalai,,0,0,0,,Dia juga menghidap tumor otak.
Dialog: 0,1:01:45.24,1:01:47.76,Lalai,,0,0,0,,Ia kira-kira lima tahun yang lalu.
Dialog: 0,1:01:47.78,1:01:51.26,Lalai,,0,0,0,,Dia menelefon rakan-rakannya dan\Nmenangis di sungai apabila mengetahuinya.
Dialog: 0,1:01:51.29,1:01:52.60,Lalai,,0,0,0,,Tetapi bagaimana dengan dia?
Dialog: 0,1:01:52.62,1:01:55.18,Lalai,,0,0,0,,Dia baik sekarang. Dialah yang\Npaling sihat antara kami.
Dialog: 0,1:01:55.21,1:01:57.48,Lalai,,0,0,0,,Dia bermain golf sepanjang masa. Dia sihat.
Dialog: 0,1:01:57.50,1:02:01.31,Lalai,,0,0,0,,Kami mempunyai lebih daripada cukup wang.\Npenyakit yang boleh diubati tidak wujud lagi,
Dialog: 0,1:02:01.34,1:02:04.46,Lalai,,0,0,0,,jadi jangan risau tentang sesuatu.
Dialog: 0,1:02:04.72,1:02:10.41,Lalai,,0,0,0,,Makcik, saya tidak bimbang untuk menjadi lebih baik.\NI cuma bimbang anda akan memberitahu orang lain.
Dialog: 0,1:02:10.43,1:02:11.99,Lalai,,0,0,0,,Adakah sesiapa yang tahu?
Dialog: 0,1:02:12.01,1:02:14.22,Lalai,,0,0,0,,Bukan suami awak?
Dialog: 0,1:02:14.31,1:02:16.43,Lalai,,0,0,0,,Hanya dia yang tahu.
Dialog: 0,1:02:16.69,1:02:19.14,Lalai,,0,0,0,,Betulkah? saya nampak.
Dialog: 0,1:02:20.19,1:02:24.25,Lalai,,0,0,0,,Hei, tidak mengapa asalkan dia\Ntahu. Ia tidak serius.
Dialog: 0,1:02:24.28,1:02:26.45,Lalai,,0,0,0,,Tepat sekali. Ia tidak serius.
Dialog: 0,1:02:26.47,1:02:27.45,Lalai,,0,0,0,,Makcik.
Dialog: 0,1:02:27.47,1:02:28.47,Lalai,,0,0,0,,Ya?
Dialog: 0,1:02:28.49,1:02:29.47,Lalai,,0,0,0,,Saya akan ke Jerman.
Dialog: 0,1:02:29.49,1:02:32.43,Lalai,,0,0,0,,Makmal mereka menemui jenis\rawatan Nof baharu yang boleh menyembuhkan saya.
Dialog: 0,1:02:32.45,1:02:34.01,Lalai,,0,0,0,,Itulah sebabnya saya datang ke sini hari ini.
Dialog: 0,1:02:34.04,1:02:36.52,Lalai,,0,0,0,,Betulkah? Adakah itu benar?
Dialog: 0,1:02:36.54,1:02:39.27,Lalai,,0,0,0,,Jadi jangan beritahu sesiapa.
Dialog: 0,1:02:39.29,1:02:40.94,Lalai,,0,0,0,,Hei! Saya tidak akan.
Dialog: 0,1:02:40.96,1:02:43.33,Lalai,,0,0,0,,Saya tidak mahu menimbulkan adegan.
Dialog: 0,1:02:44.88,1:02:46.61,Lalai,,0,0,0,,Saya akan percayakan awak.
Dialog: 0,1:02:46.63,1:02:48.69,Lalai,,0,0,0,,Ya, anda boleh.
Dialog: 0,1:02:48.72,1:02:50.38,Lalai,,0,0,0,,Awak tak pergi ke?
Dialog: 0,1:02:50.47,1:02:52.42,Lalai,,0,0,0,,Saya patut pergi sekarang.
Dialog: 0,1:03:02.57,1:03:03.71,Lalai,,0,0,0,,Hei.
Dialog: 0,1:03:03.73,1:03:06.60,Lalai,,0,0,0,,Saya pasti anda terkejut.
Dialog: 0,1:03:07.11,1:03:12.73,Lalai,,0,0,0,,Saya tahu ia bukan sesuatu yang serius,\Ntetapi saya pasti anda masih terkejut.
Dialog: 0,1:03:27.55,1:03:28.52,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Mi-yeong{\c}{\i0}
Dialog: 0,1:03:30.05,1:03:33.55,Lalai,,0,0,0,,{\i1}Nombor yang anda dail tidak tersedia pada masa ini.{\i0}
Dialog: 0,1:03:46.03,1:03:47.63,Lalai,,0,0,0,,Suk-hui.
Dialog: 0,1:03:47.65,1:03:49.34,Lalai,,0,0,0,,Adakah Mi-yeong menukar nombornya?
Dialog: 0,1:03:49.36,1:03:52.17,Lalai,,0,0,0,,- {\i1}Siapa?{\i0}\N- Mi-yeong. Jang Mi-yeong.
Dialog: 0,1:03:52.20,1:03:54.86,Lalai,,0,0,0,,{\i1}Apa? Adakah anda tidak mendengar?{\i0}
Dialog: 0,1:03:55.49,1:03:58.43,Lalai,,0,0,0,,{\i1}Betul. Anda berada dalam penjara.{\i0}
Dialog: 0,1:03:58.45,1:04:00.89,Lalai,,0,0,0,,Kenapa? Adakah sesuatu berlaku kepadanya?
Dialog: 0,1:04:00.92,1:04:02.68,Lalai,,0,0,0,,{\i1}Dia meninggal dunia.{\i0}
Dialog: 0,1:04:02.71,1:04:03.85,Lalai,,0,0,0,,Dia meninggal dunia?
Dialog: 0,1:04:03.88,1:04:05.23,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:04:05.25,1:04:08.66,Lalai,,0,0,0,,{\i1}Apa pendapat anda? Dia kambuh semula.{\i0}
Dialog: 0,1:04:09.76,1:04:11.99,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:04:12.01,1:04:14.95,Lalai,,0,0,0,,Saya dengar pembedahan berjalan lancar dan dia baik-baik saja.
Dialog: 0,1:04:14.97,1:04:19.51,Lalai,,0,0,0,,Saya dengar dia bermain golf sepanjang\Nmasa, jadi kenapa dia mati?
Dialog: 0,1:04:19.93,1:04:24.01,Lalai,,0,0,0,,{\i1}Bagaimana saya tahu? Saya rasa\Nit sukar untuk ditewaskan.{\i0}
Dialog: 0,1:04:25.19,1:04:28.56,Lalai,,0,0,0,,Kenapa dia mati?
Dialog: 0,1:04:29.61,1:04:32.09,Lalai,,0,0,0,,Kenapa dia?
Dialog: 0,1:04:32.11,1:04:34.68,Lalai,,0,0,0,,{\i1}Hei, awak menangis?{\i0}
Dialog: 0,1:04:34.70,1:04:37.90,Lalai,,0,0,0,,{\i1}Adakah kamu begitu rapat?{\i0}
Dialog: 0,1:04:38.83,1:04:42.86,Lalai,,0,0,0,,Kenapa dia mati?
Dialog: 0,1:04:50.51,1:04:54.28,Lalai,,0,0,0,,Pada 2014, keluarga diraja Monaco\Nauctioned meninggalkan peninggalan Napoleon mereka...
Dialog: 0,1:04:54.30,1:04:57.75,Lalai,,0,0,0,,sebelum membaiki istana mereka.
Dialog: 0,1:04:57.97,1:05:02.79,Lalai,,0,0,0,,{\an8}Ini adalah pedang pakaian Pengerusi\NHong yang dibeli di lelongan itu.
Dialog: 0,1:05:02.81,1:05:04.25,Lalai,,0,0,0,,{\an8}Aduh.
Dialog: 0,1:05:04.27,1:05:08.14,Lalai,,0,0,0,,{\an8}Pedang ini bernilai lebih $3 juta.
Dialog: 0,1:05:08.82,1:05:11.42,Lalai,,0,0,0,,Saya pernah melihat pedang yang serupa di sebuah muzium di London,
Dialog: 0,1:05:11.44,1:05:13.26,Lalai,,0,0,0,,tetapi bukan di dalam rumah.
Dialog: 0,1:05:13.28,1:05:16.68,Lalai,,0,0,0,,Napoleon ialah figura kegemaran saya.
Dialog: 0,1:05:16.70,1:05:20.01,Lalai,,0,0,0,,Tidakkah anda fikir ia adalah\Nkeajaiban bahawa seorang budak kampung...
Dialog: 0,1:05:20.04,1:05:21.76,Lalai,,0,0,0,,dari sebuah pulau di selatan Perancis...
Dialog: 0,1:05:21.79,1:05:24.32,Lalai,,0,0,0,,menjadi maharaja?
Dialog: 0,1:05:25.83,1:05:29.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya miskin dan sentiasa lapar semasa remaja.{\c}{\i0}
Dialog: 0,1:05:29.50,1:05:33.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ketika itulah saya terjumpa\NNapoleon biografi...{\c}{\i0}
Dialog: 0,1:05:33.17,1:05:34.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan mula bermimpi.{\c}{\i0}
Dialog: 0,1:05:34.51,1:05:39.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga mengatasi kemiskinan dan mencapai impiannya.{\c}{\i0}
Dialog: 0,1:05:39.06,1:05:40.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda boleh melakukan perkara yang sama.{\c}{\i0}
Dialog: 0,1:05:40.81,1:05:43.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bermimpilah besar jika anda ingin\Nmenjadi sangat berjaya.{\c}{\i0}
Dialog: 0,1:05:43.39,1:05:45.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mari kita bantu dia.{\c}{\i0}
Dialog: 0,1:05:53.65,1:05:55.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Selamat Datang Pengerusi Hong Kumpulan Queens{\c}{\i0}
Dialog: 0,1:06:16.97,1:06:19.40,Lalai,,0,0,0,,Saya ada Jacques-Louis David's\Nportrait of Napoleon...
Dialog: 0,1:06:19.43,1:06:21.59,Lalai,,0,0,0,,di rumah saya di New York.
Dialog: 0,1:06:21.81,1:06:25.37,Lalai,,0,0,0,,Ia adalah lukisan dia dalam\N uniform tenteranya pada tahun 1813.
Dialog: 0,1:06:25.39,1:06:28.72,Lalai,,0,0,0,,Jika boleh, saya ingin menghadiahkannya kepada anda.
Dialog: 0,1:06:32.07,1:06:33.60,Lalai,,0,0,0,,Kepada saya?
Dialog: 0,1:06:34.40,1:06:37.51,Lalai,,0,0,0,,Saya rasa anda layak menerimanya.
Dialog: 0,1:06:37.53,1:06:42.44,Lalai,,0,0,0,,Anda mengalami keajaiban seperti dia.
Dialog: 0,1:06:46.16,1:06:48.52,Lalai,,0,0,0,,Betul, semasa saya mula-mula datang ke Seoul,
Dialog: 0,1:06:48.54,1:06:51.74,Lalai,,0,0,0,,Saya adalah tukang penggilap kasut di\Ndepan kedai serbaneka,
Dialog: 0,1:06:51.92,1:06:54.73,Lalai,,0,0,0,,tetapi sekarang saya pemilik kedai serbaneka itu.
Dialog: 0,1:06:54.76,1:06:56.19,Lalai,,0,0,0,,Ia satu keajaiban, bukan?
Dialog: 0,1:06:56.22,1:06:57.92,Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,1:07:02.05,1:07:06.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Selamat Datang Pengerusi Hong Kumpulan Queens{\c}{\i0}
Dialog: 0,1:07:12.23,1:07:15.43,Lalai,,0,0,0,,Anda tiba-tiba bertolak ke Jerman sendirian?
Dialog: 0,1:07:15.90,1:07:18.52,Lalai,,0,0,0,,Kenapa Hyun-woo tidak datang?
Dialog: 0,1:07:18.65,1:07:19.88,Lalai,,0,0,0,,Dia sibuk,
Dialog: 0,1:07:19.91,1:07:21.61,Lalai,,0,0,0,,dan ini bukan apa-apa.
Dialog: 0,1:07:21.74,1:07:22.76,Lalai,,0,0,0,, Patutkah saya datang?
Dialog: 0,1:07:22.78,1:07:25.99,Lalai,,0,0,0,,Saya hanya perlukan pasport saya. Saya akan tag bersama.
Dialog: 0,1:07:26.16,1:07:27.97,Lalai,,0,0,0,,- Makcik.\N- Ya?
Dialog: 0,1:07:28.00,1:07:30.24,Lalai,,0,0,0,,Saya lebih suka pergi bersendirian.
Dialog: 0,1:07:30.96,1:07:32.62,Lalai,,0,0,0,,Saya akan baik-baik saja.
Dialog: 0,1:08:29.52,1:08:31.05,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,1:08:31.85,1:08:34.64,Lalai,,0,0,0,,Mengapa Hae-in pergi ke Jerman seorang diri?
Dialog: 0,1:08:34.98,1:08:36.17,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:08:36.19,1:08:38.48,Lalai,,0,0,0,,Tidakkah anda tahu dia pergi?
Dialog: 0,1:08:38.98,1:08:41.65,Lalai,,0,0,0,,Dia berkata hanya anda yang tahu tentang penyakitnya.
Dialog: 0,1:08:43.95,1:08:45.59,Lalai,,0,0,0,,Jadi kenapa awak tidak pergi?
Dialog: 0,1:08:45.62,1:08:49.68,Lalai,,0,0,0,,Dia berkata hanya anda yang perlu tahu,\Njadi mengapa dia pergi bersendirian?
Dialog: 0,1:08:49.70,1:08:52.49,Lalai,,0,0,0,,Kenapa awak biarkan dia seorang diri?
Dialog: 0,1:09:09.93,1:09:13.14,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,1:09:31.16,1:09:32.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:09:54.56,1:09:56.68, Lalai,,0,0,0,, Ceria!
Dialog: 0,1:09:58.81,1:10:01.38,Lalai,,0,0,0,,Saya tahu aliran hebat di Gapyeong.
Dialog: 0,1:10:01.40,1:10:03.62,Lalai,,0,0,0,,Penginapannya bagus,\Ndengan aktiviti sukan air,
Dialog: 0,1:10:03.64,1:10:05.71,Lalai,,0,0,0,,jadi mari kita pergi barbeku.
Dialog: 0,1:10:05.74,1:10:06.80,Lalai,,0,0,0,,Bunyinya bagus.
Dialog: 0,1:10:06.82,1:10:08.91,Lalai,,0,0,0,,Tahan. Izinkan saya menjemput semua orang.
Dialog: 0,1:10:08.93,1:10:09.97,Lalai,,0,0,0,,Ya, anda sepatutnya.
Dialog: 0,1:10:09.99,1:10:12.53,Lalai,,0,0,0,,- Saya akan siarkan pada sembang kumpulan kami.\N- Okay.
Dialog: 0,1:10:14.29,1:10:16.20,Lalai,,0,0,0,,Seok-jun akan datang.
Dialog: 0,1:10:17.00,1:10:19.48,Lalai,,0,0,0,,Dae-ho membatalkan rancangan golfnya untuk datang.
Dialog: 0,1:10:19.50,1:10:22.52,Lalai,,0,0,0,,Adakah Cheol-seung gila?\Ndia mahu membawa isterinya?
Dialog: 0,1:10:22.55,1:10:24.15,Lalai,,0,0,0,,Bodoh betul.
Dialog: 0,1:10:24.17,1:10:25.87,Lalai,,0,0,0,,Disekat.
Dialog: 0,1:10:28.47,1:10:29.53,Lalai,,0,0,0,,Adakah anda mendengar?
Dialog: 0,1:10:29.55,1:10:32.42,Lalai,,0,0,0,,- Sudah tentu.\N- Jadi kenapa anda tidak teruja?
Dialog: 0,1:10:32.64,1:10:35.76,Lalai,,0,0,0,,Tidak, saya teruja. Saya tidak sabar.
Dialog: 0,1:10:36.52,1:10:38.58,Lalai,,0,0,0,,Barbeku. Oh, ya.
Dialog: 0,1:10:38.60,1:10:40.76,Lalai,,0,0,0,,Sukan air. faham.
Dialog: 0,1:10:41.32,1:10:43.02,Lalai,,0,0,0,,Ini tidak betul.
Dialog: 0,1:10:43.48,1:10:46.67,Lalai,,0,0,0,,Di mana Hyun-woo lama yang menggunakan\Nuntuk turun tiga cawan espresso...
Dialog: 0,1:10:46.70,1:10:50.90,Lalai,,0,0,0,,berjaga sepanjang malam berpesta\Napabila isterinya ke luar negara?
Dialog: 0,1:10:51.95,1:10:52.93,Lalai,,0,0,0,,Saya di sini.
Dialog: 0,1:10:52.95,1:10:55.86,Lalai,,0,0,0,,Tidak, anda tiada di sini.
Dialog: 0,1:10:56.12,1:10:57.56,Lalai,,0,0,0,,Anda berada di Jerman.
Dialog: 0,1:10:57.58,1:10:59.81,Lalai,,0,0,0,,Mengapa anda menyemak cuaca mereka?
Dialog: 0,1:10:59.83,1:11:02.49,Lalai,,0,0,0,,Adakah anda bimbang tentang isteri anda?
Dialog: 0,1:11:03.05,1:11:04.83,Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,1:11:05.38,1:11:08.19,Lalai,,0,0,0,,Adakah anda berusaha keras untuk berpura-pura menyukainya,
Dialog: 0,1:11:08.22,1:11:10.84,Lalai,,0,0,0,,bahawa anda sebenarnya telah jatuh cinta?
Dialog: 0,1:11:11.14,1:11:12.11,Lalai,,0,0,0,,No.
Dialog: 0,1:11:12.14,1:11:14.53,Lalai,,0,0,0,,Saya syak awak sejak\Ninsiden kek kacang.
Dialog: 0,1:11:14.56,1:11:16.45,Lalai,,0,0,0,,- Anda salah.\N- Betul?
Dialog: 0,1:11:16.48,1:11:18.12,Lalai,,0,0,0,,Tidak, bukan?
Dialog: 0,1:11:18.14,1:11:20.04,Lalai,,0,0,0,,Ya, dapatkan genggaman.
Dialog: 0,1:11:20.06,1:11:22.17,Lalai,,0,0,0,,Jangan terlalu memikirkannya.
Dialog: 0,1:11:22.19,1:11:23.21,Lalai,,0,0,0,,Okey?
Dialog: 0,1:11:23.23,1:11:25.85,Lalai,,0,0,0,,Baiklah! Jom buat lagi!
Dialog: 0,1:11:28.22,1:11:29.25,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Permaisuri{\c}{\i0}
Dialog: 0,1:11:31.87,1:11:33.48,Lalai,,0,0,0,,Ya, Sayang.
Dialog: 0,1:11:33.66,1:11:34.97,Lalai,,0,0,0,,Ia tidak menyeronokkan.
Dialog: 0,1:11:34.99,1:11:37.49,Lalai,,0,0,0,,Ini tidak menyeronokkan sama sekali.
Dialog: 0,1:11:38.08,1:11:39.91,Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,1:13:35.61,1:13:37.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Berikut ialah temu bual anda dengan Cik Hong{\c}{\i0}
Dialog: 0,1:13:41.25,1:13:43.00,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in mendedahkan...{\c}{\i0}
Dialog: 0,1:13:46.50,1:13:50.87,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa pun, dia seorang yang romantik sejak itu.{\c}{\i0}
Dialog: 0,1:13:51.63,1:13:54.62,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Begitulah kisah cinta kami bermula.{\c}{\i0}
Dialog: 0,1:13:55.26,1:13:56.82,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini soalan terakhir saya.{\c}{\i0}
Dialog: 0,1:13:56.84,1:13:59.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apakah impian anda?{\c}{\i0}
Dialog: 0,1:13:59.72,1:14:02.70,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya perlu katakan melebihi\N$1 bilion dalam jualan...{\c}{\i0}
Dialog: 0,1:14:02.72,1:14:04.91,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}di gedung serbaneka saya.{\c}{\i0}
Dialog: 0,1:14:04.94,1:14:07.46,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sedang mengusahakannya dan ia akan berlaku tidak lama lagi.{\c}{\i0}
Dialog: 0,1:14:07.48,1:14:09.04,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tahniah terlebih dahulu.{\c}{\i0}
Dialog: 0,1:14:09.06,1:14:10.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apakah impian anda seterusnya?{\c}{\i0}
Dialog: 0,1:14:10.82,1:14:15.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya rasa saya akan menyasarkan jumlah jualan yang lebih tinggi.{\c}{\i0}
Dialog: 0,1:14:15.74,1:14:19.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana pula selepas anda mencapai semua matlamat anda?{\c}{\i0}
Dialog: 0,1:14:19.07,1:14:22.24,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak pernah terfikir sejauh itu sebelum ini.{\c}{\i0}
Dialog: 0,1:14:25.25,1:14:26.95,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pada masa itu...{\c}{\i0}
Dialog: 0,1:14:28.21,1:14:30.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin berehat.{\c}{\i0}
Dialog: 0,1:14:32.38,1:14:35.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin mengembara bersama suami saya.{\c}{\i0}
Dialog: 0,1:14:35.59,1:14:39.25,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjalanan pertama dan terakhir kami ialah bulan madu kami.{\c}{\i0}
Dialog: 0,1:14:39.68,1:14:41.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ingin pergi...{\c}{\i0}
Dialog: 0,1:14:41.76,1:14:43.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}berjalan-jalan,{\c}{\i0}
Dialog: 0,1:14:43.72,1:14:46.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}minum teh, makan, sembang,{\c}{\i0}
Dialog: 0,1:14:46.98,1:14:49.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan lakukan beberapa mengejar semula.{\c}{\i0}
Dialog: 0,1:14:51.48,1:14:53.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu bagus.{\c}{\i0}
Dialog: 0,1:14:56.20,1:14:59.06,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya harap saya boleh melakukannya...{\c}{\i0}
Dialog: 0,1:15:00.32,1:15:02.11,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}setiap hari.{\c}{\i0}
Dialog: 0,1:15:08.96,1:15:11.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya harap saya boleh melakukannya...{\c}{\i0}
Dialog: 0,1:15:13.09,1:15:14.91,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}setiap hari.{\c}{\i0}
Dialog: 0,1:16:45.01,1:16:47.59,Lalai,,0,0,0,,Mengapa mereka semua mahu saya menunggu?
Dialog: 0,1:16:47.97,1:16:50.80,Lalai,,0,0,0,,Mengapa mereka bercakap seperti masa menyebelahi saya?
Dialog: 0,1:16:51.94,1:16:53.59,Lalai,,0,0,0,,Saya tiada masa.
Dialog: 0,1:16:56.19,1:16:57.89,Lalai,,0,0,0,,Saya tidak.
Dialog: 0,1:18:17.15,1:18:19.01,Lalai,,0,0,0,,"Jangan risau"?
Dialog: 0,1:18:19.48,1:18:22.35,Lalai,,0,0,0,,Saya sudah risau tentang\Nberjalan menuruni tangga ini.
Dialog: 0,1:18:27.95,1:18:30.15,Lalai,,0,0,0,,Mengapa terdapat begitu banyak?
Dialog: 0,1:18:45.72,1:18:47.33,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:18:53.22,1:18:54.92,Lalai,,0,0,0,,Apa itu?
Dialog: 0,1:18:56.85,1:18:59.55,Lalai,,0,0,0,,Adakah saya mendengar sesuatu sekarang?
Dialog: 0,1:19:33.97,1:19:36.63,Lalai,,0,0,0,,Bukankah saya memberitahu anda untuk memakai kasut yang selesa?
Dialog: 0,1:19:38.27,1:19:40.43,Lalai,,0,0,0,,Anda betul-betul tidak mendengar.
Dialog: 0,1:19:53.74,1:19:55.05,Lalai,,0,0,0,,Bagaimana anda tahu saya berada di sini?
Dialog: 0,1:19:55.08,1:19:56.18,Lalai,,0,0,0,,Telefon anda dimatikan.
Dialog: 0,1:19:56.20,1:19:59.47,Lalai,,0,0,0,,Mereka berkata anda meninggalkan\Nhospital selepas ditolak,
Dialog: 0,1:19:59.50,1:20:02.83,Lalai,,0,0,0,,tetapi Setiausaha Na berkata anda\N tidak menaiki penerbangan pulang,
Dialog: 0,1:20:03.67,1:20:05.87,Lalai,,0,0,0,,jadi saya berfikir panjang,
Dialog: 0,1:20:07.38,1:20:09.58,Lalai,,0,0,0,,dan tempat ini terlintas di fikiran.
Dialog: 0,1:20:11.22,1:20:13.46,Lalai,,0,0,0,,Anda menikmati bulan madu kami di sini.
Dialog: 0,1:20:13.64,1:20:15.46,Lalai,,0,0,0,,Anda menyukai nama itu.
Dialog: 0,1:20:20.48,1:20:21.75,Lalai,,0,0,0,,Saya tidak pernah berkata begitu.
Dialog: 0,1:20:21.77,1:20:23.55,Lalai,,0,0,0,,Saya cakap itu tipu.
Dialog: 0,1:20:23.90,1:20:27.18,Lalai,,0,0,0,,"Tempat yang tiada kebimbangan atau air mata."
Dialog: 0,1:20:27.73,1:20:30.35,Lalai,,0,0,0,,Mereka hanya berbohong untuk menarik pelancong.
Dialog: 0,1:20:33.03,1:20:36.28,Lalai,,0,0,0,,Kau yang tipu.
Dialog: 0,1:20:36.87,1:20:38.85,Lalai,,0,0,0,,- Apa yang saya buat?\N- Awak tak ingat?
Dialog: 0,1:20:38.87,1:20:41.82,Lalai,,0,0,0,,Apa yang anda katakan kepada saya semasa anda melamar?
Dialog: 0,1:20:42.12,1:20:44.49,Lalai,,0,0,0,,Awak berjanji tidak akan membuat saya menangis.
Dialog: 0,1:20:44.79,1:20:46.62,Lalai,,0,0,0,,Awak suruh saya percayakan awak,
Dialog: 0,1:20:46.88,1:20:48.36,Lalai,,0,0,0,,tetapi rasa apa?
Dialog: 0,1:20:48.38,1:20:51.00,Lalai,,0,0,0,,Saya banyak menangis semasa perkahwinan kami.
Dialog: 0,1:20:51.30,1:20:53.07,Lalai,,0,0,0,,Saya menangis semasa memandu,
Dialog: 0,1:20:53.09,1:20:55.07,Lalai,,0,0,0,,mencuci muka saya,
Dialog: 0,1:20:55.10,1:20:57.00,Lalai,,0,0,0,,dan di tempat cuci kereta.
Dialog: 0,1:20:57.47,1:20:59.97,Lalai,,0,0,0,,Saya suka tidur berasingan,
Dialog: 0,1:21:00.39,1:21:02.93,Lalai,,0,0,0,,kerana saya boleh menangis sendiri hingga tidur.
Dialog: 0,1:21:06.90,1:21:08.60,Lalai,,0,0,0,,Dulu...
Dialog: 0,1:21:09.23,1:21:12.48,Lalai,,0,0,0,,Saya cuma cakap apa sahaja, supaya saya boleh kahwin dengan awak.
Dialog: 0,1:21:13.32,1:21:15.31,Lalai,,0,0,0,,Dan kini kami sudah berkahwin,
Dialog: 0,1:21:17.20,1:21:18.90,Lalai,,0,0,0,,jadi saya patut...
Dialog: 0,1:21:19.74,1:21:21.90,Lalai,,0,0,0,,berpegang pada anda...
Dialog: 0,1:21:23.04,1:21:25.03,Lalai,,0,0,0,,dalam masa seperti ini.
Dialog: 0,1:21:35.47,1:21:37.71,Lalai,,0,0,0,,Adakah saya pernah memberitahu anda untuk tidak melakukannya?
Dialog: 0,1:21:38.93,1:21:40.84,Lalai,,0,0,0,,Saya mahukan awak...
Dialog: 0,1:21:41.18,1:21:43.34,Lalai,,0,0,0,,untuk kekal dengan saya.
Dialog: 0,1:21:45.85,1:21:47.97,Lalai,,0,0,0,,Saya tidak mahu bersendirian.
Dialog: 0,1:21:50.03,1:21:52.10,Lalai,,0,0,0,,Pernah.
Dialog: 0,1:21:57.41,1:21:59.11,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:22:03.79,1:22:05.70,Lalai,,0,0,0,,Saya benar-benar minta maaf.
Dialog: 0,1:22:23.73,1:22:25.26,Lalai,,0,0,0,,Jom pulang.
Dialog: 0,1:22:28.36,1:22:30.77,Lalai,,0,0,0,,Saya fikir saya akan menemuinya di sini.
Dialog: 0,1:22:31.94,1:22:34.85,Lalai,,0,0,0,,Cara hidup yang ajaib,
Dialog: 0,1:22:35.57,1:22:38.40,Lalai,,0,0,0,,atau tempat yang tiada kesedihan...
Dialog: 0,1:22:41.87,1:22:43.99,Lalai,,0,0,0,,Tetapi tiada.
Dialog: 0,1:22:45.00,1:22:46.78,Lalai,,0,0,0,,Semua yang saya mahu...
Dialog: 0,1:22:47.71,1:22:50.87,Lalai,,0,0,0,, adalah untuk pulang bersama anda.
Dialog: 0,1:24:33.23,1:24:35.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya dengar ini talian hayat anda.{\c}{\i0}
Dialog: 0,1:24:35.52,1:24:36.96,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapakah saya terlalu pendek?{\c}{\i0}
Dialog: 0,1:24:36.98,1:24:38.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tersinggung.{\c}{\i0}
Dialog: 0,1:24:47.45,1:24:49.32,Lalai,,0,0,0,,Adakah ini...
Dialog: 0,1:24:50.12,1:24:51.99,Lalai,,0,0,0,,pendek?
Dialog: 0,1:24:59.55,1:25:01.25,Lalai,,0,0,0,,Saya rasa...
Dialog: 0,1:25:02.05,1:25:04.17,Lalai,,0,0,0,,ia betul.
Dialog: 0,1:25:21.82,1:25:23.73,Lalai,,0,0,0,,Bagaimana dengan jumlah ini?
Dialog: 0,1:25:28.58,1:25:31.03, Lalai,,0,0,0,, Kira-kira sebanyak ini.
Dialog: 0,1:25:57.61,1:26:00.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:26:28.09,1:26:31.37,Lalai,,0,0,0,,{\an8}{\i1}Saya benar-benar dikurniakan suami yang baik.{\i0}
Dialog: 0,1:26:31.39,1:26:34.33,Lalai,,0,0,0,,{\an8}- {\i1}Bolehkah saya tidur di bilik awak?{\i0}\N- Tidur sahaja di mana-mana yang awak mahu.
Dialog: 0,1:26:34.35,1:26:37.18,Lalai,,0,0,0,,{\an8}{\i1}Lakukan seperti yang anda mahu. Ikut kata hati anda.{\i0}
Dialog: 0,1:26:37.27,1:26:38.93,Lalai,,0,0,0,,{\an8}{\i1}Sukar dipercayai.{\i0}
Dialog: 0,1:26:39.23,1:26:41.10,Lalai,,0,0,0,,{\an8}{\i1}Mengapa anda mahu apabila dia sudah begitu kuat?{\i0}
Dialog: 0,1:26:41.12,1:26:44.13,Lalai,,0,0,0,,{\an8}{\i1}Berhenti tamak jika anda sudah\Nit selama itu, bajingan!{\i0}
Dialog: 0,1:26:44.15,1:26:46.48,Lalai,,0,0,0,,{\an8}{\i1}Yongdu-ri telah menjadi terkenal.{\i0}
Dialog: 0,1:26:46.82,1:26:49.88,Lalai,,0,0,0,,{\an8}{\i1}Perhubungan terikat\Nuntuk runtuh dengan rahsia.{\i0}
Dialog: 0,1:26:49.91,1:26:51.84,Lalai,,0,0,0,,{\an8}- {\i1}Saya baru nampak seseorang.\N- Hae-in!{\i0}
Dialog: 0,1:26:51.87,1:26:54.53,Lalai,,0,0,0,,{\an8}{\i1}Apabila anda hampir mati...{\i0}
Dialog: 0,1:26:54.62,1:26:56.52,Lalai,,0,0,0,,{\an8}{\i1}Mungkin dia datang...{\i0}
Dialog: 0,1:26:56.54,1:26:58.57,Lalai,,0,0,0,,{\an8}{\i1}kerana sudah tiba masanya.{\i0}
