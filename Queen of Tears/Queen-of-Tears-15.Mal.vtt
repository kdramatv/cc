Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.56,0:01:03.53, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 15{\c}{\i0}
Dialog: 0,0:01:36.38,0:01:38.29, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:39.22,0:01:41.38, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:41.81,0:01:43.88, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:49.73,0:01:52.68, Lalai,,0,0,0,,Jangan lupa nama itu.
Dialog: 0,0:01:53.86,0:01:55.64, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:56.90,0:01:58.90, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:59.11,0:02:01.07, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:02:02.33,0:02:04.19, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:03:40.88,0:03:44.32,Lalai,,0,0,0,,Mengapa mereka tiba-tiba\Ntukar doktor dan jururawatnya?
Dialog: 0,0:03:44.34,0:03:45.45, Lalai,,0,0,0,, Mengalahkan saya.
Dialog: 0,0:03:45.47,0:03:49.58,Lalai,,0,0,0,,Lelaki itu ialah tunangan Cik Hong,\Nand dia bercakap dengan pengarah.
Dialog: 0,0:03:49.60,0:03:52.58, Lalai,,0,0,0,,Dia juga menderma satu tan kepada yayasan itu.
Dialog: 0,0:03:52.60,0:03:54.83, Lalai,,0,0,0,,Pengarah menyuruh kami menutup mulut,
Dialog: 0,0:03:54.85,0:03:56.62, Lalai,,0,0,0,, atau kami akan disaman.
Dialog: 0,0:03:56.65,0:03:58.08, Lalai,,0,0,0,,Bagaimana dengan lelaki lain?
Dialog: 0,0:03:58.11,0:04:00.00, Lalai,,0,0,0,,- Bukankah dia tunangnya?\N- Saya tidak tahu.
Dialog: 0,0:04:00.03,0:04:01.92, Lalai,,0,0,0,,Dia mengaku tunangnya juga.
Dialog: 0,0:04:01.95,0:04:04.56, Lalai,,0,0,0,,Saya tertanya-tanya siapa yang sebenarnya.
Dialog: 0,0:04:10.08,0:04:11.26,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:04:11.29,0:04:14.35, Lalai,,0,0,0,,bekas suami saya telah mengikut saya ke sini?
Dialog: 0,0:04:14.37,0:04:15.89, Lalai,,0,0,0,,Ya.
Dialog: 0,0:04:15.92,0:04:18.90,Lalai,,0,0,0,,Dia gigih bertanya\Nyou sebelum pembedahan...
Dialog: 0,0:04:18.92,0:04:20.11, Lalai,,0,0,0,,untuk menyemak kehendak anda.
Dialog: 0,0:04:20.13,0:04:21.23,Lalai,,0,0,0,,Sudah tentu anda menolak.
Dialog: 0,0:04:21.26,0:04:23.23, Lalai,,0,0,0,,Kami mengalami kemalangan sebelum pembedahan.
Dialog: 0,0:04:23.26,0:04:26.28, Lalai,,0,0,0,,Sebuah lori merempuh kenderaan kami.
Dialog: 0,0:04:26.30,0:04:29.71, Lalai,,0,0,0,,Saya percaya dia berada di belakangnya.
Dialog: 0,0:04:29.76,0:04:31.59,Lalai,,0,0,0,,- Tidak boleh.\N- Baek Hyun-woo tidak akan teragak-agak...
Dialog: 0,0:04:31.62,0:04:34.08, Lalai,,0,0,0,,untuk melakukan apa sahaja apabila dia berdendam.
Dialog: 0,0:04:34.10,0:04:36.50, Lalai,,0,0,0,,Dia mengancam saya berkali-kali.
Dialog: 0,0:04:36.52,0:04:39.33, Lalai,,0,0,0,,Bagaimanakah kami terselamat daripada nahas itu?
Dialog: 0,0:04:39.36,0:04:41.06, Lalai,,0,0,0,, Betul.
Dialog: 0,0:04:42.03,0:04:44.96, Lalai,,0,0,0,, Syukurlah kami tiada di dalam kereta,
Dialog: 0,0:04:44.99,0:04:47.34,Lalai,,0,0,0,,tetapi saya sangka awak, jadi saya cederakan tangan saya...
Dialog: 0,0:04:47.37,0:04:49.98, Lalai,,0,0,0,,cuba memecahkan tingkap.
Dialog: 0,0:04:54.46,0:04:56.32,Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:04:58.42,0:05:00.37, Lalai,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:05:01.00,0:05:05.75,Lalai,,0,0,0,,Saya hanya mahu berhenti melihat dia menyeksa awak.
Dialog: 0,0:05:05.84,0:05:09.80,Lalai,,0,0,0,,Apabila dia mempunyai hubungan sulit dan ingin menceraikan kamu,
Dialog: 0,0:05:13.93,0:05:16.55, Lalai,,0,0,0,,anda cuba bunuh diri.
Dialog: 0,0:05:18.98,0:05:22.43,Lalai,,0,0,0,,Saya cuba bunuh diri kerana\Nguy yang menipu saya?
Dialog: 0,0:05:23.44,0:05:25.46,Lalai,,0,0,0,,Saya sedih.
Dialog: 0,0:05:25.49,0:05:28.65, Lalai,,0,0,0,,Tidak sama sekali. Anda terlalu lembut hati dan baik.
Dialog: 0,0:05:29.87,0:05:32.22,Lalai,,0,0,0,,Saya tidak dapat berbuat apa-apa ketika itu...
Dialog: 0,0:05:32.24,0:05:34.72,Lalai,,0,0,0,,sejak anda masih berkahwin, tetapi tidak lagi.
Dialog: 0,0:05:34.75,0:05:38.07, Lalai,,0,0,0,,Saya akan memastikan anda selamat, tidak kira apa pun.
Dialog: 0,0:05:43.96,0:05:46.03,Default,,0,0,0,,Ini adalah perhentian bas berhampiran Takungan Sambang.
Dialog: 0,0:05:46.05,0:05:47.15,Lalai,,0,0,0,,Bukankah itu anda?
Dialog: 0,0:05:47.18,0:05:49.61, Lalai,,0,0,0,,Mengapa anda berada di sana semasa kematiannya?
Dialog: 0,0:05:49.64,0:05:52.32,Lalai,,0,0,0,,Kami telah bersetuju untuk berjumpa, tetapi dia tidak pernah muncul.
Dialog: 0,0:05:52.34,0:05:53.32, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:05:53.34,0:05:55.41,Lalai,,0,0,0,,{\i1}Kalau begitu kenapa rambut awak ditemui...{\i0}
Dialog: 0,0:05:55.43,0:05:57.62,Default,,0,0,0,,di dalam kereta mangsa?
Dialog: 0,0:05:57.64,0:05:59.91, Lalai,,0,0,0,,Saya percaya ia telah ditanam.
Dialog: 0,0:05:59.94,0:06:01.72, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:06:02.02,0:06:03.00, Lalai,,0,0,0,,Bagaimana dengan ini?
Dialog: 0,0:06:03.02,0:06:05.25, Lalai,,0,0,0,,Kami menjumpai pisau ini berhampiran tempat kejadian.
Dialog: 0,0:06:05.28,0:06:08.05, Lalai,,0,0,0,,Ia mempunyai cap jari anda dan darahnya.
Dialog: 0,0:06:08.07,0:06:10.63, Lalai,,0,0,0,,Luka tusukannya sepadan dengan bilah.
Dialog: 0,0:06:10.66,0:06:12.89,Lalai,,0,0,0,,- Adakah anda masih akan bermain bodoh?\N- Jika saya...
Dialog: 0,0:06:12.91,0:06:14.55, Lalai,,0,0,0,, benar-benar menggunakan pisau itu,
Dialog: 0,0:06:14.58,0:06:17.32, Lalai,,0,0,0,, adakah saya akan meninggalkannya?
Dialog: 0,0:06:17.62,0:06:20.06, Lalai,,0,0,0,,Adakah anda mendapat kecederaan itu daripada menikamnya?
Dialog: 0,0:06:20.08,0:06:22.66, Lalai,,0,0,0,,Saya mengalami kemalangan di Jerman.
Dialog: 0,0:06:22.75,0:06:25.27, Lalai,,0,0,0,,Saya mencederakan diri sendiri semasa cuba\Nmemecahkan cermin kereta.
Dialog: 0,0:06:25.30,0:06:28.61,Lalai,,0,0,0,,Jika saya mendapat ini kerana\Ntangan saya tergelincir semasa menggunakan pisau,
Dialog: 0,0:06:28.63,0:06:31.61, Lalai,,0,0,0,,potongan itu akan berada di tapak tangan saya,
Dialog: 0,0:06:31.64,0:06:32.74, Lalai,,0,0,0,,bukan belakang tangan saya.
Dialog: 0,0:06:32.76,0:06:33.95, Lalai,,0,0,0,,Saya tidak percaya anda.
Dialog: 0,0:06:33.97,0:06:35.62, Lalai,,0,0,0,,Tuntut tidak bersalah sesuka hati,
Dialog: 0,0:06:35.64,0:06:38.99,Lalai,,0,0,0,,tetapi ia tidak akan mudah dengan semua\Nbukti kukuh yang kami ada.
Dialog: 0,0:06:39.02,0:06:41.41, Lalai,,0,0,0,,Bersih akan memberi anda hukuman yang lebih ringan.
Dialog: 0,0:06:41.44,0:06:43.97,Lalai,,0,0,0,,Bukankah anda sepatutnya tahu sebagai seorang peguam?
Dialog: 0,0:06:50.11,0:06:53.48, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hyun-woo, jika perkara ini berlaku lagi,{\c}{\i0}
Dialog: 0,0:06:53.87,0:06:55.90, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jangan selamatkan saya.{\c}{\i0}
Dialog: 0,0:07:21.35,0:07:25.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apabila dia mempunyai hubungan sulit dan ingin menceraikan anda,{\c}{\i0}
Dialog: 0,0:07:25.31,0:07:27.64,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anda cuba mengambil nyawa anda sendiri.{\c}{\i0}
Dialog: 0,0:08:17.53,0:08:20.04,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo\NHae-in{\c}{\i0}
Dialog: 0,0:08:22.08,0:08:23.22,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sebulan Kemudian{\c}{\i0}
Dialog: 0,0:08:23.25,0:08:25.39,Lalai,,0,0,0,,{\an8}- Hae-in!\N- Hae-in!
Dialog: 0,0:08:25.42,0:08:27.85,Lalai,,0,0,0,,Ini saya, Ibu. Adakah anda mengenali saya?
Dialog: 0,0:08:27.88,0:08:29.98, Lalai,,0,0,0,,Kebaikan. apa khabar
Dialog: 0,0:08:30.00,0:08:30.98, Lalai,,0,0,0,,Adakah anda sihat sekarang?
Dialog: 0,0:08:31.01,0:08:33.71, Lalai,,0,0,0,,Hae-in, ia pasti kasar.
Dialog: 0,0:08:38.39,0:08:40.30, Lalai,,0,0,0,,Helo.
Dialog: 0,0:08:41.56,0:08:43.30, Lalai,,0,0,0,,Bapa.
Dialog: 0,0:08:43.98,0:08:46.09,Lalai,,0,0,0,,Ibu. makcik.
Dialog: 0,0:08:48.69,0:08:50.64, Lalai,,0,0,0,,Hong Soo-cheol, puan.
Dialog: 0,0:08:52.86,0:08:54.34, Lalai,,0,0,0,,Saya telah mendengar banyak tentang awak.
Dialog: 0,0:08:54.36,0:08:57.90, Lalai,,0,0,0,,Kita patut ambil makanan pada suatu masa.
Dialog: 0,0:08:59.66,0:09:00.64, Lalai,,0,0,0,, Hae-in?
Dialog: 0,0:09:00.66,0:09:02.69, Lalai,,0,0,0,,Hae-in...
Dialog: 0,0:09:02.79,0:09:05.78,Lalai,,0,0,0,,agak letih kerana terbang.
Dialog: 0,0:09:06.25,0:09:09.02, Lalai,,0,0,0,,Dia harus pulang dan berehat.
Dialog: 0,0:09:09.04,0:09:11.02, Lalai,,0,0,0,,Anda tiada hak untuk terlibat.
Dialog: 0,0:09:11.05,0:09:12.62, Lalai,,0,0,0,, En. Hong.
Dialog: 0,0:09:12.96,0:09:15.48,Lalai,,0,0,0,,Tolong jaga adab anda di hadapan Encik Yoon.
Dialog: 0,0:09:15.51,0:09:17.07, Lalai,,0,0,0,,- Hae-in.\N- Hae-in.
Dialog: 0,0:09:17.30,0:09:21.17,Lalai,,0,0,0,,Adakah anda tahu apa yang dia lakukan kepada keluarga kita?
Dialog: 0,0:09:21.47,0:09:25.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka akan mendakwa saya menendang mereka\Nout dan mengambil alih Queens,{\c}{\i0}
Dialog: 0,0:09:25.35,0:09:26.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi inilah kebenarannya.{\c}{\i0}
Dialog: 0,0:09:26.46,0:09:29.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pengerusi sudah muak dengan\Nkeluarganya berebut wangnya,{\c}{\i0}
Dialog: 0,0:09:29.15,0:09:31.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan memberi saya kedudukannya sebelum dia meninggal dunia.{\c}{\i0}
Dialog: 0,0:09:31.36,0:09:33.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga meminta ibu saya mengambil alih asetnya.{\c}{\i0}
Dialog: 0,0:09:33.47,0:09:35.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia mahu anda mewarisi segala-galanya,{\c}{\i0}
Dialog: 0,0:09:35.70,0:09:39.11, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi dia tahu keluarga tidak akan membenarkannya.{\c}{\i0}
Dialog: 0,0:09:39.41,0:09:40.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ahli keluarga anda yang dipanggil...{\c}{\i0}
Dialog: 0,0:09:40.83,0:09:44.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}gembira mendengar anda akan mati tidak lama lagi.{\c}{\i0}
Dialog: 0,0:09:45.75,0:09:47.10, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:09:47.12,0:09:50.31, Lalai,,0,0,0,,Saya mempunyai idea kasar.\NI membaca banyak artikel berita juga.
Dialog: 0,0:09:50.33,0:09:54.40,Lalai,,0,0,0,,Saya percaya kita tidak pernah\N cukup dekat untuk menjadi sebahagia ini...
Dialog: 0,0:09:54.42,0:09:55.73, Lalai,,0,0,0,,tentang berjumpa antara satu sama lain.
Dialog: 0,0:09:55.76,0:09:57.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah keluarga saya pernah menghubungi saya?{\c}{\i0}
Dialog: 0,0:09:57.59,0:09:59.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, dan mereka bercakap tentang perkara yang sama.{\c}{\i0}
Dialog: 0,0:09:59.89,0:10:02.78, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka mahukan hak mengundi anda\Nuntuk mesyuarat pemegang saham.{\c}{\i0}
Dialog: 0,0:10:02.81,0:10:05.45, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka bimbang kerana saya mahu memulihkan anda.{\c}{\i0}
Dialog: 0,0:10:05.47,0:10:07.83, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka mahu bercakap dengan anda, tetapi saya menolak.{\c}{\i0}
Dialog: 0,0:10:07.85,0:10:10.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda telah meminta saya berbuat demikian sebelum pembedahan.{\c}{\i0}
Dialog: 0,0:10:11.27,0:10:14.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya datang ke sini seorang diri untuk\Npembedahan besar ini menunjukkan...{\c}{\i0}
Dialog: 0,0:10:14.40,0:10:16.84, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jenis hubungan yang kami ada.{\c}{\i0}
Dialog: 0,0:10:16.86,0:10:18.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mesti pernah hidup...{\c}{\i0}
Dialog: 0,0:10:18.95,0:10:19.92,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kehidupan yang sunyi.{\c}{\i0}
Dialog: 0,0:10:19.95,0:10:21.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda lakukan.{\c}{\i0}
Dialog: 0,0:10:21.41,0:10:23.57, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda sentiasa bersendirian,{\c}{\i0}
Dialog: 0,0:10:24.37,0:10:26.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi perkara yang sama berlaku untuk saya.{\c}{\i0}
Dialog: 0,0:10:28.79,0:10:32.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya yang kami ada hanyalah satu sama lain.{\c}{\i0}
Dialog: 0,0:10:33.75,0:10:36.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan percayakan keluarga anda.{\c}{\i0}
Dialog: 0,0:10:37.76,0:10:40.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak mahu mereka mengeksploitasi anda...{\c}{\i0}
Dialog: 0,0:10:40.59,0:10:42.13, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}lagi.{\c}{\i0}
Dialog: 0,0:10:44.64,0:10:45.62,Lalai,,0,0,0,,Anda silap.
Dialog: 0,0:10:45.64,0:10:48.83, Lalai,,0,0,0,,Saya tidak tahu apa yang dia beritahu awak,\Ntapi jangan percaya dia.
Dialog: 0,0:10:48.85,0:10:50.25, Lalai,,0,0,0,, Percayai keluarga anda.
Dialog: 0,0:10:50.27,0:10:53.67,Lalai,,0,0,0,,Saya dengar awak bawak\Na jimat dalam dompet awak,
Dialog: 0,0:10:53.69,0:10:56.60, Lalai,,0,0,0,, dengan harapan ia akan melemahkan tenaga saya.
Dialog: 0,0:10:57.23,0:10:58.55,Lalai,,0,0,0,,Wah.
Dialog: 0,0:10:58.57,0:11:01.15,Lalai,,0,0,0,,- Awak beritahu dia?\N- Saya nyatakan fakta.
Dialog: 0,0:11:01.24,0:11:03.52, Lalai,,0,0,0,,Ibu memberikannya kepada saya.
Dialog: 0,0:11:06.20,0:11:09.07, Lalai,,0,0,0,,Itu tidak penting sekarang.
Dialog: 0,0:11:09.54,0:11:11.37, Lalai,,0,0,0,,- Hae-in...\N- Saya dengar...
Dialog: 0,0:11:11.46,0:11:14.73,Lalai,,0,0,0,,anda menyaman saya untuk\Nkedai jabatan di Gwanggyo.
Dialog: 0,0:11:14.75,0:11:17.27, Lalai,,0,0,0,,Kemudian saya segera membatalkan tuntutan itu.
Dialog: 0,0:11:17.30,0:11:19.15,Lalai,,0,0,0,,Saya tidak cuba untuk berhadapan dengan anda.
Dialog: 0,0:11:19.17,0:11:21.99,Lalai,,0,0,0,,Saya cuma harap awak tak fikir darah buruk kami...
Dialog: 0,0:11:22.01,0:11:24.95, Lalai,,0,0,0,,boleh dipadamkan hanya kerana saya hilang ingatan.
Dialog: 0,0:11:24.97,0:11:28.53, Lalai,,0,0,0,,Hae-in. Memang benar bahawa keluarga kami mempunyai masalah,
Dialog: 0,0:11:28.56,0:11:30.91, Lalai,,0,0,0,,tetapi kami boleh menerangkan segala-galanya.
Dialog: 0,0:11:30.94,0:11:33.33, Lalai,,0,0,0,,Ya, dan dia tidak sepatutnya berada di sini.
Dialog: 0,0:11:33.35,0:11:35.50,Lalai,,0,0,0,,Suami anda sepatutnya berada di sini.
Dialog: 0,0:11:35.52,0:11:38.50,Lalai,,0,0,0,,Betul. Adakah anda maksudkan bekas suami saya?
Dialog: 0,0:11:38.53,0:11:41.94,Lalai,,0,0,0,,Siapa yang menyediakan dokumen cerai secara rahsia sebelum saya mengetahuinya?
Dialog: 0,0:11:42.15,0:11:43.81, Lalai,,0,0,0,,Apa?
Dialog: 0,0:11:44.53,0:11:46.51, Lalai,,0,0,0,,Itu benar, tetapi...
Dialog: 0,0:11:46.53,0:11:49.64, Lalai,,0,0,0,,Anda buat dia berbunyi sangat jahat,
Dialog: 0,0:11:49.66,0:11:51.31, Lalai,,0,0,0,,tetapi ia adalah cerita yang panjang.
Dialog: 0,0:11:51.33,0:11:54.32, Lalai,,0,0,0,,Saya dengar dia dipenjarakan kerana membunuh.
Dialog: 0,0:12:03.38,0:12:05.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak akan pergi ke mana-mana, bukan?{\c}{\i0}
Dialog: 0,0:12:05.14,0:12:08.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda perlu berada di sini apabila saya membuka mata.{\c}{\i0}
Dialog: 0,0:12:23.11,0:12:24.80,Lalai,,0,0,0,,{\i1}Mengapa anda mahu pulang?{\i0}
Dialog: 0,0:12:24.82,0:12:27.55,Lalai,,0,0,0,,Saya sudah mendapat tempat untuk anda tinggal.
Dialog: 0,0:12:27.58,0:12:30.51,Lalai,,0,0,0,,Saya mahu pulang ke rumah\Nand menjalani kehidupan seperti dulu.
Dialog: 0,0:12:30.54,0:12:33.86, Lalai,,0,0,0,,Ia mungkin membantu saya mendapatkan semula ingatan saya.
Dialog: 0,0:12:34.50,0:12:36.41, Lalai,,0,0,0,,Saya mahu berbuat demikian.
Dialog: 0,0:12:37.04,0:12:41.06,Lalai,,0,0,0,,Saya bimbang keluarga anda akan menghalang anda.
Dialog: 0,0:12:41.09,0:12:44.57, Lalai,,0,0,0,,Ibu bapa anda amat menyusahkan anda untuk dikembalikan semula.
Dialog: 0,0:12:44.59,0:12:46.98,Lalai,,0,0,0,,Para pengarah terus mendakwa\Bagaimana anda tidak cekap...
Dialog: 0,0:12:47.01,0:12:48.61, Lalai,,0,0,0,,- disebabkan keadaan anda.\N- Saya tahu.
Dialog: 0,0:12:48.64,0:12:50.07, Lalai,,0,0,0,,Saya akan pastikan perkara itu tidak akan berlaku.
Dialog: 0,0:12:50.10,0:12:51.45, Lalai,,0,0,0,,Terima kasih atas keprihatinan anda.
Dialog: 0,0:12:51.47,0:12:53.84, Lalai,,0,0,0,,Anda sudah cukup berterima kasih kepada saya.
Dialog: 0,0:12:55.52,0:12:57.64, Lalai,,0,0,0,,Tepati janji anda.
Dialog: 0,0:12:57.94,0:12:59.67,Lalai,,0,0,0,,Awak kata kita akan kahwin...
Dialog: 0,0:12:59.69,0:13:02.23, Lalai,,0,0,0,,selepas pembedahan.
Dialog: 0,0:13:03.36,0:13:06.86,Lalai,,0,0,0,,Serahkan persiapan perkahwinan kepada saya.
Dialog: 0,0:13:21.42,0:13:22.56, Lalai,,0,0,0,,Helo.
Dialog: 0,0:13:22.59,0:13:24.57,Lalai,,0,0,0,,- Sudah agak lama.\N- Saya ada soalan.
Dialog: 0,0:13:24.59,0:13:28.32, Lalai,,0,0,0,,Terdapat kemalangan kereta sebelum pembedahan Hae-in.
Dialog: 0,0:13:28.34,0:13:30.63, Lalai,,0,0,0,,- Adakah anda berada di belakangnya?\N- Ya.
Dialog: 0,0:13:38.31,0:13:40.08, Lalai,,0,0,0,, Dia tidak mati, walaupun,
Dialog: 0,0:13:40.11,0:13:41.81, Lalai,,0,0,0,,jadi apa isunya?
Dialog: 0,0:13:46.28,0:13:48.17, Lalai,,0,0,0,,Ada apa dengan rupa itu? Awak tahu.
Dialog: 0,0:13:48.20,0:13:50.01, Lalai,,0,0,0,,Saya sudah memberi amaran kepada anda bahawa...
Dialog: 0,0:13:50.03,0:13:53.61,Lalai,,0,0,0,,dia boleh terluka lagi jika anda melekat dengannya,
Dialog: 0,0:13:54.54,0:13:55.85, Lalai,,0,0,0,, dan ia tidak akan berubah.
Dialog: 0,0:13:55.87,0:13:57.72,Lalai,,0,0,0,,Awak dah habis ugut saya?
Dialog: 0,0:13:57.75,0:14:00.08, Lalai,,0,0,0,, Kemudian giliran saya.
Dialog: 0,0:14:03.59,0:14:05.44, Lalai,,0,0,0,,Itu bilik ini, bukan?
Dialog: 0,0:14:05.46,0:14:08.17, Lalai,,0,0,0,, Tempat Pengerusi Hong rebah.
Dialog: 0,0:14:09.18,0:14:11.45, Lalai,,0,0,0,,Saya melihat apa yang anda lakukan melalui lukisan itu...
Dialog: 0,0:14:11.47,0:14:14.05, Lalai,,0,0,0,,Saya hadiahkan dia.
Dialog: 0,0:14:20.86,0:14:22.92,Lalai,,0,0,0,,Saya ada bukti,
Dialog: 0,0:14:22.94,0:14:26.63, Lalai,,0,0,0,, jadi sentuh Hae-in sekali lagi,
Dialog: 0,0:14:26.65,0:14:30.01,Lalai,,0,0,0,,dan saya akan meletakkan awak di belakang\Nbars seperti yang saya lakukan dengan Hyun-woo.
Dialog: 0,0:14:30.03,0:14:32.01, Lalai,,0,0,0,,Bagaimana...?
Dialog: 0,0:14:32.03,0:14:34.59,Lalai,,0,0,0,,Bagaimana... berani awak?
Dialog: 0,0:14:34.62,0:14:35.60, Lalai,,0,0,0,,Betul.
Dialog: 0,0:14:35.62,0:14:37.85,Lalai,,0,0,0,,Saya adalah penghalang anda sekarang.
Dialog: 0,0:14:37.87,0:14:41.41,Lalai,,0,0,0,,Singkirkan saya jika anda berani.
Dialog: 0,0:14:49.13,0:14:52.60,Lalai,,0,0,0,,Bagaimana jika dia kata dia akan berkahwin dengan Eun-sung?
Dialog: 0,0:14:52.62,0:14:54.59,Lalai,,0,0,0,,- Tidak mungkin.\N- Saya benar-benar dapat melihat kedatangan itu,
Dialog: 0,0:14:54.61,0:14:55.83, Lalai,,0,0,0,, berdasarkan apa yang saya lihat hari ini.
Dialog: 0,0:14:55.86,0:14:56.94, Lalai,,0,0,0,,Dia orang yang berbeza.
Dialog: 0,0:14:56.97,0:14:59.26, Lalai,,0,0,0,,Tidak, dia tidak akan berbuat demikian.
Dialog: 0,0:14:59.52,0:15:01.91,Lalai,,0,0,0,,Sebenarnya, saya sentiasa memerhatikannya.
Dialog: 0,0:15:01.94,0:15:04.79, Lalai,,0,0,0,,Agensi Detektif Hong Gil-dong?
Dialog: 0,0:15:04.82,0:15:07.88,Lalai,,0,0,0,,Ya, Gil-dong ialah moyang keluarga kami.
Dialog: 0,0:15:07.90,0:15:09.88, Lalai,,0,0,0,,Orang juga memanggil saya "sejenis..."
Dialog: 0,0:15:09.90,0:15:11.63, Lalai,,0,0,0,, dan memuji banyak bakat saya,
Dialog: 0,0:15:11.66,0:15:13.73, Lalai,,0,0,0,,jadi saya kekalkan nama itu.
Dialog: 0,0:15:13.78,0:15:14.93,Lalai,,0,0,0,,Apa?
Dialog: 0,0:15:14.95,0:15:17.43, Lalai,,0,0,0,,Tolak $10 juta dan\Berikan $1.5 juta kepada Encik Kim.
Dialog: 0,0:15:17.45,0:15:18.51, Lalai,,0,0,0,,Bangunan boleh kekal.
Dialog: 0,0:15:18.54,0:15:21.52,Lalai,,0,0,0,,- Saya membelinya kerana bosan.\N- Tidak mengapa. Dia juga seorang detektif.
Dialog: 0,0:15:22.84,0:15:24.49,Lalai,,0,0,0,,Menyamar adalah sifat kedua saya.
Dialog: 0,0:15:25.34,0:15:27.29,Lalai,,0,0,0,,En. Nam, keluar.
Dialog: 0,0:15:28.42,0:15:30.50,Lalai,,0,0,0,,Staking out adalah sifat kedua saya.
Dialog: 0,0:15:31.01,0:15:34.57, Lalai,,0,0,0,,Ia adalah tangan kanan dan kiri saya.
Dialog: 0,0:15:34.60,0:15:37.20,Lalai,,0,0,0,,Ia kelihatan biasa, seperti yang anda lihat,
Dialog: 0,0:15:37.22,0:15:38.58, Lalai,,0,0,0,,supaya mereka boleh masuk ke mana-mana sahaja.
Dialog: 0,0:15:38.60,0:15:41.24,Lalai,,0,0,0,,Detektif Hong ialah otak agensi kami.
Dialog: 0,0:15:41.27,0:15:43.96,Lalai,,0,0,0,,Dia selalu menjadi ulat buku dan pernah...
Dialog: 0,0:15:43.98,0:15:45.29,Lalai,,0,0,0,,perniagaan berkaitan buku.
Dialog: 0,0:15:45.31,0:15:47.21,Lalai,,0,0,0,,Perniagaan apa?
Dialog: 0,0:15:47.23,0:15:49.25, Lalai,,0,0,0,,Saya menjalankan kedai buku komik.
Dialog: 0,0:15:49.28,0:15:53.05, Lalai,,0,0,0,,Buku komik ialah pangkalan data\Nterutama yang mengandungi...
Dialog: 0,0:15:53.07,0:15:54.09, Lalai,,0,0,0,,semua jenis kes.
Dialog: 0,0:15:54.11,0:15:56.34, Lalai,,0,0,0,,Itu asas kerja saya.
Dialog: 0,0:15:56.37,0:15:59.10,Lalai,,0,0,0,,Kes yang manakah telah anda siasat?
Dialog: 0,0:15:59.12,0:16:01.36, Lalai,,0,0,0,,Ada yang terkenal?
Dialog: 0,0:16:01.75,0:16:04.48,Lalai,,0,0,0,,Itu untuk anda ketahui.
Dialog: 0,0:16:04.50,0:16:08.61,Lalai,,0,0,0,,Detektif yang cekap\Ntidak akan bertanya soalan sedemikian.
Dialog: 0,0:16:08.63,0:16:12.36,Lalai,,0,0,0,,By the way, berapa banyak daripada\Nperbelanjaan yang anda bayar balik?
Dialog: 0,0:16:12.38,0:16:13.44,Lalai,,0,0,0,,Puan.
Dialog: 0,0:16:13.47,0:16:16.53,Lalai,,0,0,0,,Biar saya tanya soalan remeh.\NBerapa bayaran pampasan makanan?
Dialog: 0,0:16:16.55,0:16:18.82, Lalai,,0,0,0,,Kami mengenakan bayaran $8 setiap hidangan, tetapi ia agak ketat.
Dialog: 0,0:16:18.85,0:16:21.41, Lalai,,0,0,0,, Makanan laut {\i1}jajangmyeon{\i0} berharga\N$12 di kawasan kejiranan kami.
Dialog: 0,0:16:21.43,0:16:24.25,Lalai,,0,0,0,,- Apa?\N- Harga zaman sekarang memang gila kan?
Dialog: 0,0:16:24.27,0:16:27.81,Lalai,,0,0,0,,Kita harus menumpukan pada\Nekonomi dan bukannya suspek.
Dialog: 0,0:16:30.73,0:16:32.21, Lalai,,0,0,0,,Dia membisu.
Dialog: 0,0:16:32.24,0:16:35.13, Lalai,,0,0,0,, Ketat mulut. Tulis itu.
Dialog: 0,0:16:35.16,0:16:37.05, Lalai,,0,0,0,,Oh, saya.
Dialog: 0,0:16:37.07,0:16:39.73, Lalai,,0,0,0,,- Anda sudah berada di sini.\N- Ya, tuan.
Dialog: 0,0:16:40.37,0:16:41.60, Lalai,,0,0,0,, Kerja bagus.
Dialog: 0,0:16:41.62,0:16:43.10, Lalai,,0,0,0,,Siapakah mereka?
Dialog: 0,0:16:43.12,0:16:46.94, Lalai,,0,0,0,,Mereka mengikuti Hae-in ke\NGermany dan memastikan saya dikemas kini.
Dialog: 0,0:16:46.96,0:16:50.69, Lalai,,0,0,0,,Agensi Detektif Hong Gil-dong kami\Nakan sentiasa memberi anda diskaun.
Dialog: 0,0:16:50.71,0:16:53.71, Lalai,,0,0,0,,Kami mengawasi sasaran kami,\Menganalisis punca dan psikologi mereka,
Dialog: 0,0:16:53.74,0:16:56.15, Lalai,,0,0,0,,menawarkan penyelesaian, malah memberi anda waranti.
Dialog: 0,0:16:56.18,0:16:58.49,Lalai,,0,0,0,,Kami menawarkan pakej penuh\Nas kami mengikut sasaran kami.
Dialog: 0,0:16:58.51,0:16:59.86, Lalai,,0,0,0,,Oh, ya.
Dialog: 0,0:16:59.89,0:17:01.99, Lalai,,0,0,0,,Tidak teruk, kamu semua.
Dialog: 0,0:17:02.02,0:17:03.58, Lalai,,0,0,0,,- Jadi beritahu saya.\N- Apa?
Dialog: 0,0:17:03.60,0:17:05.56, Lalai,,0,0,0,,- Apa yang anda dapati?\N- Kami akan memberitahu anda sekarang.
Dialog: 0,0:17:05.58,0:17:09.74, Lalai,,0,0,0,,Anda akan bebas daripada semua kebimbangan anda.
Dialog: 0,0:17:42.77,0:17:44.88, Lalai,,0,0,0,,Mengapa ia kosong?
Dialog: 0,0:17:52.94,0:17:55.48, Lalai,,0,0,0,,Kami tidur di bilik yang berbeza.
Dialog: 0,0:17:55.65,0:17:57.35, Lalai,,0,0,0,, Adakah itu?
Dialog: 0,0:18:32.31,0:18:34.68, Lalai,,0,0,0,,Kami mempunyai cita rasa yang sama dalam muzik.
Dialog: 0,0:18:37.69,0:18:39.98, Lalai,,0,0,0,, Pasti, itu mungkin.
Dialog: 0,0:18:42.28,0:18:44.30,Lalai,,0,0,0,,Dia jenis apa?
Dialog: 0,0:18:44.33,0:18:47.64,Lalai,,0,0,0,,Saya tidak akan dapat dikalahkan jika saya mengenali musuh saya dan diri saya sendiri,
Dialog: 0,0:18:47.66,0:18:49.97,Lalai,,0,0,0,,tetapi saya sendiri tidak tahu.
Dialog: 0,0:18:50.00,0:18:51.70, Lalai,,0,0,0,,Dalam kes itu,
Dialog: 0,0:18:51.88,0:18:54.70,Lalai,,0,0,0,,bukankah saya sepatutnya mengenali musuh saya?
Dialog: 0,0:19:04.05,0:19:05.45, Lalai,,0,0,0,,Ya.
Dialog: 0,0:19:05.47,0:19:08.20,Lalai,,0,0,0,,Ini adalah tempat paling selamat untuk berjumpa dengannya.
Dialog: 0,0:19:08.23,0:19:09.91, Lalai,,0,0,0,,Betapa kejinya dia,
Dialog: 0,0:19:09.94,0:19:11.96,Lalai,,0,0,0,,bahawa dia ada di sini selepas mengintai bekas isterinya,
Dialog: 0,0:19:11.98,0:19:14.76,Lalai,,0,0,0,,siapa dia menipu, dan membunuh seseorang?
Dialog: 0,0:19:16.69,0:19:20.00, Lalai,,0,0,0,,Saya mesti menjadi hakim yang buruk tentang watak.
Dialog: 0,0:19:20.03,0:19:22.65, Lalai,,0,0,0,,Mengapa saya akan jatuh cinta kepadanya?
Dialog: 0,0:20:04.70,0:20:06.23, Lalai,,0,0,0,, Hae-in.
Dialog: 0,0:20:08.58,0:20:10.57,Lalai,,0,0,0,,Duduk, Encik Baek.
Dialog: 0,0:20:25.97,0:20:27.61, Lalai,,0,0,0,,Adakah anda sihat sekarang?
Dialog: 0,0:20:27.64,0:20:30.05, Lalai,,0,0,0,,Jika tidak, mengapa saya berada di sini?
Dialog: 0,0:20:31.56,0:20:33.55, Lalai,,0,0,0,,Adakah pembedahan berjalan lancar?
Dialog: 0,0:20:33.77,0:20:37.12, Lalai,,0,0,0,,Adakah anda masih mendapat\Nrawatan? Adakah anda dalam kesakitan?
Dialog: 0,0:20:37.15,0:20:39.52,Lalai,,0,0,0,,Adakah anda bimbang tentang saya?
Dialog: 0,0:20:44.66,0:20:46.36, Lalai,,0,0,0,,Saya...
Dialog: 0,0:20:48.87,0:20:50.68, Lalai,,0,0,0,,Saya sangat risau.
Dialog: 0,0:20:50.70,0:20:52.24, Lalai,,0,0,0,,Itu kelakar.
Dialog: 0,0:20:52.83,0:20:55.81,Lalai,,0,0,0,,Anda mesti fikir saya bodoh\Nsejak saya hilang ingatan.
Dialog: 0,0:20:55.83,0:20:57.66, Lalai,,0,0,0,,Saya juga merindui awak.
Dialog: 0,0:21:04.51,0:21:06.17, Lalai,,0,0,0,,Saya tahu segala-galanya.
Dialog: 0,0:21:06.43,0:21:08.78,Lalai,,0,0,0,,Saya tahu kenapa awak kahwin dengan saya,
Dialog: 0,0:21:08.80,0:21:12.41, Lalai,,0,0,0,,cara anda bersedia untuk perceraian,\Dan apa yang anda lakukan selepas itu.
Dialog: 0,0:21:12.43,0:21:15.22,Lalai,,0,0,0,,Saya mendengar dan mengesahkan semuanya.
Dialog: 0,0:21:16.77,0:21:18.41,Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:21:18.44,0:21:21.71,Lalai,,0,0,0,,Saya tidak tahu apa yang Eun-sung beritahu awak,
Dialog: 0,0:21:21.73,0:21:23.69, Lalai,,0,0,0,,tetapi tiada satu pun yang benar.
Dialog: 0,0:21:23.86,0:21:26.40, Lalai,,0,0,0,,Saya tahu awak keliru,
Dialog: 0,0:21:26.53,0:21:27.51,Lalai,,0,0,0,,tetapi jika anda mempercayai saya...
Dialog: 0,0:21:27.53,0:21:29.01, Lalai,,0,0,0,,Saya hanya percaya apa yang saya lihat.
Dialog: 0,0:21:29.03,0:21:31.22,Lalai,,0,0,0,,Surat cerai yang awak sediakan di belakang saya,
Dialog: 0,0:21:31.24,0:21:33.76,Lalai,,0,0,0,,dan hakikat bahawa anda berada di\N di sini sebagai suspek pembunuhan,
Dialog: 0,0:21:33.79,0:21:35.77,Lalai,,0,0,0,,adalah yang saya sahkan.
Dialog: 0,0:21:35.79,0:21:38.02,Lalai,,0,0,0,,Kalau begitu kenapa awak datang ke sini?
Dialog: 0,0:21:38.04,0:21:41.16,Lalai,,0,0,0,,Jika anda mengesahkan dan mengetahui segala-galanya,
Dialog: 0,0:21:41.50,0:21:43.54,Lalai,,0,0,0,,lalu kenapa awak ada di sini?
Dialog: 0,0:21:43.67,0:21:46.25,Lalai,,0,0,0,,Bukankah kerana anda ragu?
Dialog: 0,0:21:47.01,0:21:48.71, Lalai,,0,0,0,,Saya datang ke sini...
Dialog: 0,0:21:51.89,0:21:53.42,Lalai,,0,0,0,,kerana...
Dialog: 0,0:21:56.14,0:21:58.14, Lalai,,0,0,0,,Katakanlah...
Dialog: 0,0:21:58.85,0:22:01.81, Lalai,,0,0,0,, jadi kita tidak akan berjumpa lagi.
Dialog: 0,0:22:02.86,0:22:04.54, Lalai,,0,0,0,,Saya ingin tahu, sejujurnya,
Dialog: 0,0:22:04.57,0:22:06.48,Lalai,,0,0,0,,tetapi sekarang kita telah bertemu,
Dialog: 0,0:22:06.65,0:22:08.21,Lalai,,0,0,0,,kita tidak akan berjumpa lagi.
Dialog: 0,0:22:08.24,0:22:09.94, Lalai,,0,0,0,,No.
Dialog: 0,0:22:10.45,0:22:12.98,Lalai,,0,0,0,,Kita jumpa lagi,
Dialog: 0,0:22:13.74,0:22:15.95, Lalai,,0,0,0,,kerana saya tidak akan berputus asa.
Dialog: 0,0:22:16.54,0:22:18.68, Lalai,,0,0,0,,Saya akan tetap dengan awak.
Dialog: 0,0:22:18.71,0:22:22.41,Lalai,,0,0,0,,Itu kaya, datang daripada\Tiada orang yang terkurung.
Dialog: 0,0:22:36.35,0:22:38.22,Lalai,,0,0,0,,Saya berjanji...
Dialog: 0,0:22:40.73,0:22:43.64, Lalai,,0,0,0,,untuk bersama anda apabila anda bangun.
Dialog: 0,0:22:44.86,0:22:46.64, Lalai,,0,0,0,,Saya minta maaf saya tiada di sana.
Dialog: 0,0:22:47.65,0:22:50.15, Lalai,,0,0,0,,Saya benar-benar minta maaf...
Dialog: 0,0:22:50.74,0:22:52.57,Lalai,,0,0,0,,anda terpaksa datang ke sini,
Dialog: 0,0:22:52.95,0:22:54.57,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:22:54.91,0:22:57.15, Lalai,,0,0,0,,Saya akan keluar, tidak kira apa.
Dialog: 0,0:22:57.50,0:22:59.57, Lalai,,0,0,0,,Saya berjanji ini kepada anda.
Dialog: 0,0:22:59.62,0:23:00.88, Lalai,,0,0,0,,Jadi anda...
Dialog: 0,0:23:00.90,0:23:01.93, Lalai,,0,0,0,, Banduan 9971.
Dialog: 0,0:23:01.96,0:23:03.79, Lalai,,0,0,0,,Masa anda sudah tamat.
Dialog: 0,0:23:03.96,0:23:06.52,Lalai,,0,0,0,,Makan dengan baik, jangan risau tentang apa-apa,
Dialog: 0,0:23:06.55,0:23:08.55, Lalai,,0,0,0,, dan teruskan mendapatkan rawatan.
Dialog: 0,0:23:08.57,0:23:09.57, Lalai,,0,0,0,, Banduan 9971.
Dialog: 0,0:23:09.59,0:23:12.15, Lalai,,0,0,0,,Kekal sihat.
Dialog: 0,0:23:12.18,0:23:16.01, Lalai,,0,0,0,,Sila lakukan itu untuk saya. Okay?
Dialog: 0,0:23:16.06,0:23:17.97, Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:23:36.83,0:23:40.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Perkhidmatan Pembetulan Korea{\c}{\i0}
Dialog: 0,0:23:43.17,0:23:45.28,Lalai,,0,0,0,,Saya hampir menjawab balik.
Dialog: 0,0:23:46.84,0:23:48.52,Lalai,,0,0,0,,Dia sangat licik.
Dialog: 0,0:23:48.55,0:23:51.29,Lalai,,0,0,0,,Bagaimana dia boleh menipu, walaupun sebagai banduan?
Dialog: 0,0:23:51.55,0:23:54.82,Lalai,,0,0,0,,Saya boleh faham bagaimana dia menipu saya pada masa lalu.
Dialog: 0,0:23:54.85,0:23:58.42, Lalai,,0,0,0,, Dia pasti fasih.
Dialog: 0,0:24:08.32,0:24:11.06, Lalai,,0,0,0,,Saya perlukan ubat loya. hati saya...
Dialog: 0,0:24:11.49,0:24:13.67, Lalai,,0,0,0,,berlumba.
Dialog: 0,0:24:13.70,0:24:15.17,Lalai,,0,0,0,,Saya rasa loya.
Dialog: 0,0:24:15.20,0:24:17.97, Lalai,,0,0,0,,Saya sangat kecewa.
Dialog: 0,0:24:17.99,0:24:19.69, Lalai,,0,0,0,, Satu minit.
Dialog: 0,0:24:22.79,0:24:25.66,Default,,0,0,0,,Pening sangat, nak menangis.
Dialog: 0,0:24:31.01,0:24:32.71, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:24:42.98,0:24:45.39, Lalai,,0,0,0,,Di manakah anda?
Dialog: 0,0:24:46.65,0:24:48.58, Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:24:48.61,0:24:51.56,Lalai,,0,0,0,,Jawab saya dahulu. Di mana anda telah pergi?
Dialog: 0,0:24:53.20,0:24:55.15,Lalai,,0,0,0,,Saya tidak mahu menjawab.
Dialog: 0,0:24:55.28,0:24:56.97, Lalai,,0,0,0,,Bolehkah awak pergi?
Dialog: 0,0:24:56.99,0:25:00.69,Lalai,,0,0,0,,Saya tidak mahu sesiapa berada di sini\Tanpa kebenaran saya, walaupun anda.
Dialog: 0,0:25:01.62,0:25:03.15, Lalai,,0,0,0,, Betul.
Dialog: 0,0:25:03.66,0:25:04.64, Lalai,,0,0,0,,Maaf,
Dialog: 0,0:25:04.66,0:25:07.31,Lalai,,0,0,0,,tetapi anda masih menerima\Nrawatan, dan saya memberitahu anda.
Dialog: 0,0:25:07.33,0:25:09.94, Lalai,,0,0,0,,Anda berada dalam bahaya beberapa kali.
Dialog: 0,0:25:09.96,0:25:10.98, Lalai,,0,0,0,,Saya tahu,
Dialog: 0,0:25:11.00,0:25:13.19,Lalai,,0,0,0,,dan Hyun-woo berada di belakang mereka,
Dialog: 0,0:25:13.22,0:25:15.83, Lalai,,0,0,0,,tetapi dia dikurung, jadi saya tidak selamat?
Dialog: 0,0:25:18.26,0:25:20.05, Lalai,,0,0,0,,Saya cuma...
Dialog: 0,0:25:25.06,0:25:27.83, Lalai,,0,0,0,,cemas apabila anda tiada,
Dialog: 0,0:25:27.85,0:25:29.97, Lalai,,0,0,0,, kerana perkara terus berlaku.
Dialog: 0,0:25:31.61,0:25:34.73, Lalai,,0,0,0,,Saya minta maaf kerana membimbangkan awak.
Dialog: 0,0:25:39.28,0:25:40.82, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:25:41.79,0:25:43.32, Lalai,,0,0,0,, Rehat.
Dialog: 0,0:26:31.46,0:26:35.33, Lalai,,0,0,0,,Tidak mungkin. Saya rasa khabar angin\Natentang perkahwinan mereka adalah benar.
Dialog: 0,0:26:35.76,0:26:37.82, Lalai,,0,0,0,,Adakah ia sudah berakhir dengan Pengarah Baek?
Dialog: 0,0:26:37.84,0:26:39.03, Lalai,,0,0,0,, Tonton apa yang anda katakan.
Dialog: 0,0:26:39.05,0:26:40.99,Lalai,,0,0,0,,Kami semua menandatangani NDA,
Dialog: 0,0:26:41.01,0:26:43.57, Lalai,,0,0,0,,- terutamanya anda.\N- Apa yang perlu dirisaukan?
Dialog: 0,0:26:43.60,0:26:45.80,Lalai,,0,0,0,,Saya tidak lagi bekerja untuknya.
Dialog: 0,0:26:46.52,0:26:48.43, Lalai,,0,0,0,,Kami tidak akan berjumpa.
Dialog: 0,0:26:51.86,0:26:53.56, Lalai,,0,0,0,,Pn. Hong!
Dialog: 0,0:26:54.36,0:26:55.58, Lalai,,0,0,0,,Helo.
Dialog: 0,0:26:55.61,0:26:57.38, Lalai,,0,0,0,,Saya mendengar tentang awak.
Dialog: 0,0:26:57.40,0:26:59.41, Lalai,,0,0,0,,Adakah anda semua lebih baik sekarang?
Dialog: 0,0:26:59.43,0:27:00.42,Lalai,,0,0,0,,Ya.
Dialog: 0,0:27:00.45,0:27:02.47, Lalai,,0,0,0,,Saya benar-benar lega. sungguh.
Dialog: 0,0:27:02.49,0:27:05.68, Lalai,,0,0,0,,Terima kasih kepada bayaran untuk\Npembedahan dan bil hospital,
Dialog: 0,0:27:05.70,0:27:06.76,Lalai,,0,0,0,,Cho-rong...
Dialog: 0,0:27:06.79,0:27:09.52,Lalai,,0,0,0,,Dia mempunyai nama sebenar sekarang.
Dialog: 0,0:27:09.54,0:27:10.98, Lalai,,0,0,0,,So-yul.
Dialog: 0,0:27:11.00,0:27:13.66,Lalai,,0,0,0,,So-yul sihat sekarang.
Dialog: 0,0:27:15.00,0:27:16.19, Lalai,,0,0,0,,Saya gembira.
Dialog: 0,0:27:16.21,0:27:18.87, Lalai,,0,0,0,,Terima kasih banyak. Saya tidak akan lupa ini.
Dialog: 0,0:27:27.18,0:27:28.91, Lalai,,0,0,0,,- Adakah saya melakukan itu?\N- Maaf?
Dialog: 0,0:27:28.93,0:27:30.79,Lalai,,0,0,0,,Adakah saya benar-benar melakukan apa yang dia katakan?
Dialog: 0,0:27:30.81,0:27:34.01, Lalai,,0,0,0,,Saya tidak pasti. Itu sebelum saya diupah.
Dialog: 0,0:27:37.73,0:27:39.80,Lalai,,0,0,0,,Terima kasih kerana menepati janji anda.
Dialog: 0,0:27:39.82,0:27:42.40,Lalai,,0,0,0,,Janji? janji apa?
Dialog: 0,0:27:42.78,0:27:47.61,Lalai,,0,0,0,,Anda berjanji untuk kembali sebelum saya selesai\Nmembayar ansuran untuk ini.
Dialog: 0,0:27:48.37,0:27:49.81, Lalai,,0,0,0,,Jadi awak setiausaha saya?
Dialog: 0,0:27:49.83,0:27:50.93, Lalai,,0,0,0,,Ya.
Dialog: 0,0:27:50.96,0:27:52.60,Lalai,,0,0,0,,Maka anda mesti tahu banyak tentang saya.
Dialog: 0,0:27:52.62,0:27:56.31,Lalai,,0,0,0,,Sudah tentu. Anggap saya sebagai\Nmanusia pemacu keras luaran.
Dialog: 0,0:27:57.88,0:27:59.44, Lalai,,0,0,0,,Dalam kes itu,
Dialog: 0,0:27:59.46,0:28:01.37,Lalai,,0,0,0,,saya jenis apakah?
Dialog: 0,0:28:02.09,0:28:03.78,Lalai,,0,0,0,,Nah...
Dialog: 0,0:28:03.80,0:28:04.86, Lalai,,0,0,0,,Anda dulu...
Dialog: 0,0:28:04.89,0:28:06.59,Lalai,,0,0,0,,Pn. Hong.
Dialog: 0,0:28:07.14,0:28:09.08, Lalai,,0,0,0,,Pn. Hong, saya gembira mendengar...
Dialog: 0,0:28:09.10,0:28:12.04, Lalai,,0,0,0,,anda kembali. Adakah anda sihat sekarang?
Dialog: 0,0:28:12.06,0:28:14.81, Lalai,,0,0,0,,Dia pekerja yang anda kenali.
Dialog: 0,0:28:14.84,0:28:15.83, Lalai,,0,0,0,,Helo.
Dialog: 0,0:28:15.86,0:28:17.42, Lalai,,0,0,0,,Terima kasih kepada anda,
Dialog: 0,0:28:17.44,0:28:21.13,Lalai,,0,0,0,,ibu saya menerima semua\Nrawatannya dan meninggal dunia dengan aman.
Dialog: 0,0:28:21.15,0:28:24.84, Lalai,,0,0,0,,Anda menghantar bunga kepadanya\Npengebumian, menanggung kos,
Dialog: 0,0:28:24.86,0:28:26.26, Lalai,,0,0,0,, malah datang.
Dialog: 0,0:28:26.28,0:28:28.80, Lalai,,0,0,0,,Anda mungkin tidak ingat, tetapi saya akan sentiasa ingat.
Dialog: 0,0:28:28.83,0:28:30.57,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:28:30.79,0:28:32.82, Lalai,,0,0,0,,Tiada masalah.
Dialog: 0,0:28:38.59,0:28:42.86, Lalai,,0,0,0,,Saya menghantar bunga ke pengebumian ahli keluarga\N pekerja saya?
Dialog: 0,0:28:42.88,0:28:44.94, Lalai,,0,0,0,, Betapa sensitifnya saya.
Dialog: 0,0:28:44.97,0:28:48.21,Lalai,,0,0,0,,- Itu Pengarah Baek...\N- Apa?
Dialog: 0,0:28:48.68,0:28:49.66, Lalai,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:28:49.68,0:28:51.41,Lalai,,0,0,0,,Anda seorang yang baik.
Dialog: 0,0:28:51.43,0:28:55.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sudah tiba masanya kita memotong semua jenama...{\c}{\i0}
Dialog: 0,0:28:55.31,0:28:57.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}yang menghalang jualan kami.{\c}{\i0}
Dialog: 0,0:28:57.31,0:28:59.56, Lalai,,0,0,0,,Anda sangat mesra.
Dialog: 0,0:29:00.73,0:29:03.31, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah ini kreatif? bahagian mana? Bagaimana?{\c}{\i0}
Dialog: 0,0:29:03.45,0:29:04.96,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya hanya ingin tahu.{\c}{\i0}
Dialog: 0,0:29:04.99,0:29:06.05, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jawab saya.{\c}{\i0}
Dialog: 0,0:29:06.07,0:29:08.47, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bahagian yang mana? Bagaimana? Kenapa?!{\c}{\i0}
Dialog: 0,0:29:08.49,0:29:11.76,Lalai,,0,0,0,,- Awak juga baik hati.\N- Adakah saya benar-benar suka...
Dialog: 0,0:29:11.79,0:29:14.70,Lalai,,0,0,0,,Ibu Teresa?
Dialog: 0,0:29:16.12,0:29:17.56, Lalai,,0,0,0,,Ya, saya rasa.
Dialog: 0,0:29:17.58,0:29:19.40, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:29:19.42,0:29:21.48,Lalai,,0,0,0,,Saya nampak kucing terbiar dalam perjalanan ke sini,
Dialog: 0,0:29:21.50,0:29:24.23, Lalai,,0,0,0,,dan saya ingin memberinya makanan ringan,
Dialog: 0,0:29:24.26,0:29:25.82, Lalai,,0,0,0,,jadi saya membeli beberapa dan memberinya makan.
Dialog: 0,0:29:25.84,0:29:29.50,Lalai,,0,0,0,,Rasanya saya terdesak untuk melakukan kebaikan.
Dialog: 0,0:29:29.72,0:29:32.20,Lalai,,0,0,0,,Saya mungkin hilang ingatan,
Dialog: 0,0:29:32.22,0:29:35.51, Lalai,,0,0,0,,tetapi sifat sebenar saya masih kekal.
Dialog: 0,0:29:37.77,0:29:39.75,Lalai,,0,0,0,,Saya harap kita serasi.
Dialog: 0,0:29:39.77,0:29:41.79, Lalai,,0,0,0,,- Maaf?\N- Anda pemacu keras luaran saya.
Dialog: 0,0:29:41.82,0:29:44.71,Lalai,,0,0,0,,Saya seperti papan induk yang\Telah menjalani tetapan semula kilang.
Dialog: 0,0:29:44.74,0:29:48.06, Lalai,,0,0,0,,Saya memerlukan pemacu keras luaran saya yang mengandungi data saya.
Dialog: 0,0:29:50.95,0:29:53.68, Lalai,,0,0,0,,Tetapi saya di jabatan lain.
Dialog: 0,0:29:53.70,0:29:55.61, Lalai,,0,0,0,,Saya akan uruskan.
Dialog: 0,0:29:58.29,0:30:00.98, Lalai,,0,0,0,,Teliti rekod keterangan pihak pendakwaan.
Dialog: 0,0:30:01.00,0:30:03.11, Lalai,,0,0,0,,- Apa? Kenapa?\N- Ini kes pembunuhan.
Dialog: 0,0:30:03.13,0:30:05.35,Lalai,,0,0,0,,Mereka ingin mengumpulkan seberapa\N bukti yang mungkin.
Dialog: 0,0:30:05.37,0:30:08.36, Lalai,,0,0,0,,Jika ada apa-apa yang mereka\N tidak kemukakan sebagai bukti,
Dialog: 0,0:30:08.38,0:30:10.50,Lalai,,0,0,0,,ia mesti memihak kepada kita.
Dialog: 0,0:30:14.10,0:30:17.20,Lalai,,0,0,0,,Jadi bukti yang mereka tidak kemukakan...
Dialog: 0,0:30:17.23,0:30:20.18, Lalai,,0,0,0,, adakah ini analisis komponen bagi\Njejak bukti di tempat kejadian?
Dialog: 0,0:30:20.21,0:30:22.12, Lalai,,0,0,0,,Ya, sekeping gentian hijau.
Dialog: 0,0:30:22.15,0:30:24.54, Lalai,,0,0,0,,- Jadi itu bukan milik Hyun-woo.\N- Itulah sebabnya mereka mengabaikannya.
Dialog: 0,0:30:24.57,0:30:27.52,Lalai,,0,0,0,,Saya rasa ia dari pakaian pembunuh sebenar,
Dialog: 0,0:30:28.15,0:30:29.80, Lalai,,0,0,0,, dan kita perlu mencarinya.
Dialog: 0,0:30:29.82,0:30:31.68,Lalai,,0,0,0,,{\i1}Pisau yang digunakan sebagai senjata pembunuhan...{\i0}
Dialog: 0,0:30:31.70,0:30:33.68, Lalai,,0,0,0,, sememangnya milik saya.
Dialog: 0,0:30:33.70,0:30:35.86, Lalai,,0,0,0,,Jadi mengapa ia berada di sana?
Dialog: 0,0:30:36.25,0:30:37.81, Lalai,,0,0,0,,- Mungkin ia dicuri.\N- Saya percaya...
Dialog: 0,0:30:37.84,0:30:40.48,Lalai,,0,0,0,,ia hilang beberapa hari\Nsebelum kami berlepas ke Jerman.
Dialog: 0,0:30:40.51,0:30:42.95, Lalai,,0,0,0,,- Saya tidak terlalu memikirkannya.\N- Jadi ia telah dicuri.
Dialog: 0,0:30:42.98,0:30:44.37, Lalai,,0,0,0,,Saya akan lihat kamera CCTV.
Dialog: 0,0:30:44.40,0:30:46.40, Lalai,,0,0,0,,Satu lagi. Sila semak dashcam bas...
Dialog: 0,0:30:46.42,0:30:49.11, Lalai,,0,0,0,,yang beroperasi berhampiran tempat kejadian\Sekitar masa pembunuhan.
Dialog: 0,0:30:49.13,0:30:53.71, Lalai,,0,0,0,,Mungkin ada kereta yang mencurigakan,\Tidak juga si pembunuh boleh menaiki bas.
Dialog: 0,0:30:56.72,0:30:58.62, Lalai,,0,0,0,,Helo. Berapa kerapkah ia dipadamkan?
Dialog: 0,0:30:58.64,0:31:00.70,Lalai,,0,0,0,,Tuan, boleh saya bertanya sesuatu?
Dialog: 0,0:31:00.73,0:31:04.39, Lalai,,0,0,0,,Adakah terdapat kamera berhampiran tapak memancing?
Dialog: 0,0:31:11.36,0:31:14.33,Lalai,,0,0,0,,Ayah, saya singkirkan semuanya dari atas bumbung.
Dialog: 0,0:31:14.35,0:31:15.39,Lalai,,0,0,0,,Singkirkan apa?
Dialog: 0,0:31:15.41,0:31:16.85, Lalai,,0,0,0,, Burung gagak menangis sepanjang hari.
Dialog: 0,0:31:16.87,0:31:19.43, Lalai,,0,0,0,,Hei. Saya gembira anda melakukannya\Nsebelum perbicaraan hari ini.
Dialog: 0,0:31:19.46,0:31:20.60, Lalai,,0,0,0,,Maksud saya...
Dialog: 0,0:31:20.62,0:31:23.52,Lalai,,0,0,0,,Saya tahu pendengaran akan berjalan lancar.
Dialog: 0,0:31:23.54,0:31:25.24,Lalai,,0,0,0,,Saya lakukan,
Dialog: 0,0:31:25.55,0:31:26.98, Lalai,,0,0,0,,tetapi burung gagak tidak sesuai.
Dialog: 0,0:31:27.01,0:31:29.12,Lalai,,0,0,0,,Astaga, makan saja, sudah.
Dialog: 0,0:31:30.17,0:31:31.94, Lalai,,0,0,0,, Sayang.
Dialog: 0,0:31:31.97,0:31:34.96, Lalai,,0,0,0,,- Bukan bejana.\N- Kenapa tidak?
Dialog: 0,0:31:35.14,0:31:36.87, Lalai,,0,0,0,,Anda akan membungkusnya.
Dialog: 0,0:31:36.89,0:31:41.45,Lalai,,0,0,0,,Anda semua dilarang daripada\Nmembungkus, mencelup atau mencampur...
Dialog: 0,0:31:41.48,0:31:42.54, Lalai,,0,0,0,,sebarang makanan hari ini.
Dialog: 0,0:31:42.56,0:31:45.08, Lalai,,0,0,0,,Jangan lepaskan apa-apa pun.
Dialog: 0,0:31:45.11,0:31:47.59,Lalai,,0,0,0,,Ia akan berasa tidak menyenangkan...
Dialog: 0,0:31:47.61,0:31:49.56, Lalai,,0,0,0,,jika anda melakukannya.
Dialog: 0,0:31:50.65,0:31:52.01, Lalai,,0,0,0,,Selamat pagi.
Dialog: 0,0:31:52.03,0:31:53.47, Lalai,,0,0,0,, Astaga, sejuk.
Dialog: 0,0:31:53.49,0:31:57.23,Lalai,,0,0,0,,Da-hye letih dan mahu tidur.
Dialog: 0,0:32:03.54,0:32:06.06, Lalai,,0,0,0,,Tidak, itu tidak dikira.
Dialog: 0,0:32:06.09,0:32:08.11, Lalai,,0,0,0,,Mereka tidak jatuh.
Dialog: 0,0:32:08.13,0:32:11.40,Lalai,,0,0,0,,Soo-cheol baru sahaja meletakkannya...
Dialog: 0,0:32:11.42,0:32:12.94,Lalai,,0,0,0,,di atas lantai...
Dialog: 0,0:32:12.97,0:32:15.79,Lalai,,0,0,0,,seperti ini.
Dialog: 0,0:32:16.01,0:32:18.70, Lalai,,0,0,0,,Dia betul. Anda meletakkan mereka...
Dialog: 0,0:32:18.72,0:32:20.45, Lalai,,0,0,0,, di atas lantai, bukan?
Dialog: 0,0:32:20.48,0:32:22.49,Lalai,,0,0,0,,Tidak, saya menggugurkannya,
Dialog: 0,0:32:22.52,0:32:24.83, Lalai,,0,0,0,,tetapi saya agak santai dan tidak kisah.
Dialog: 0,0:32:24.85,0:32:29.56, Lalai,,0,0,0,,Saya akan bungkusnya dalam bejana,\Ndunk dalam sup...
Dialog: 0,0:32:30.36,0:32:33.02,Default,,0,0,0,,Sup ni memang sedap puan.
Dialog: 0,0:32:36.82,0:32:39.80,Lalai,,0,0,0,,Defendan berada berhampiran jenayah\N tempat kejadian sekitar masa yang dianggarkan...
Dialog: 0,0:32:39.83,0:32:43.27, Lalai,,0,0,0,, kematian mangsa antara jam 8 dan 9 malam.
Dialog: 0,0:32:43.29,0:32:46.77,Lalai,,0,0,0,,Tambahan pula, rambut defendan\Nditemui di dalam kereta mangsa.
Dialog: 0,0:32:46.79,0:32:49.14,Lalai,,0,0,0,,Darah mangsa dan\Ndefendan cap jari...
Dialog: 0,0:32:49.17,0:32:50.85,Lalai,,0,0,0,,juga ditemui pada senjata pembunuhan.
Dialog: 0,0:32:50.88,0:32:53.98,Lalai,,0,0,0,,Oleh itu, kami ingin\N mendakwa Baek Hyun-woo kerana membunuh.
Dialog: 0,0:32:54.01,0:32:56.25, Lalai,,0,0,0,,Adakah anda mengakui tuduhan ini?
Dialog: 0,0:32:57.47,0:32:58.45,Lalai,,0,0,0,,Tidak, Yang Berhormat.
Dialog: 0,0:32:58.47,0:33:02.66,Lalai,,0,0,0,,Memang benar saya telah bersetuju untuk\Nbertemu mangsa pada hari itu,
Dialog: 0,0:33:02.68,0:33:04.24, Lalai,,0,0,0,,tetapi dia tidak pernah muncul.
Dialog: 0,0:33:04.27,0:33:06.68, Lalai,,0,0,0,,Oleh itu, saya tidak pernah berjumpa dengannya.
Dialog: 0,0:33:06.94,0:33:09.46, Lalai,,0,0,0,,Pembela boleh membuat hujah mereka.
Dialog: 0,0:33:09.48,0:33:10.63,Lalai,,0,0,0,,Yang Berhormat.
Dialog: 0,0:33:10.65,0:33:12.38, Lalai,,0,0,0,,Pelanggan saya telah mendakwa tidak bersalah...
Dialog: 0,0:33:12.40,0:33:15.13, Lalai,,0,0,0,,sejak awal penyiasatan ini.
Dialog: 0,0:33:15.15,0:33:17.34,Lalai,,0,0,0,,Jika benar, pembunuh sebenar ada di luar sana.
Dialog: 0,0:33:17.37,0:33:21.43,Lalai,,0,0,0,,Mari kita lihat pembunuhan\Nsenjata dakwaan pihak pendakwaan...
Dialog: 0,0:33:21.45,0:33:23.14,Lalai,,0,0,0,,untuk menjadi bukti paling tegas mereka.
Dialog: 0,0:33:23.16,0:33:24.77, Lalai,,0,0,0,,Pisau dapur ada kesan...
Dialog: 0,0:33:24.79,0:33:27.37, Lalai,,0,0,0,, cetakan defendan, darah mangsa,
Dialog: 0,0:33:27.88,0:33:30.87, Lalai,,0,0,0,,serta sekeping akrilik hijau.
Dialog: 0,0:33:31.05,0:33:33.82, Lalai,,0,0,0,,Seperti yang anda lihat,\Ndefendan tidak memakai pakaian hijau.
Dialog: 0,0:33:33.84,0:33:37.07,Lalai,,0,0,0,,Walaupun begitu, itu tidak dapat membuktikan\Nit milik orang lain.
Dialog: 0,0:33:37.09,0:33:38.49,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,0:33:38.51,0:33:42.01,Lalai,,0,0,0,,Namun, bagaimana jika seseorang berpakaian hijau...
Dialog: 0,0:33:42.39,0:33:46.20,Lalai,,0,0,0,,mencuri pisau dari rumahnya...
Dialog: 0,0:33:46.23,0:33:49.97, Lalai,,0,0,0,,yang ditemui berhampiran tempat kejadian?
Dialog: 0,0:34:05.08,0:34:06.35, Lalai,,0,0,0,,Ia adalah pisau.
Dialog: 0,0:34:06.37,0:34:08.45, Lalai,,0,0,0,,Ya, anda betul.
Dialog: 0,0:34:09.67,0:34:12.40,Lalai,,0,0,0,,Ia adalah pisau yang digunakan dalam pembunuhan itu.
Dialog: 0,0:34:12.42,0:34:15.23,Lalai,,0,0,0,,Dia juga memakai pakaian hijau.
Dialog: 0,0:34:15.26,0:34:17.21, Lalai,,0,0,0,, Rakaman seterusnya, sila.
Dialog: 0,0:34:17.97,0:34:20.61,Lalai,,0,0,0,,{\i1}Individu yang sama dilihat terbakar...{\i0}
Dialog: 0,0:34:20.64,0:34:23.41,Lalai,,0,0,0,,baju-T, sarung tangan dan lain-lain\NPakaiannya hanya lebih satu batu...
Dialog: 0,0:34:23.43,0:34:24.99, Lalai,,0,0,0,,dari tempat kejadian.
Dialog: 0,0:34:25.02,0:34:28.20,Lalai,,0,0,0,,Saya meminta analisis tentang\Ngentian terbakar dan yang...
Dialog: 0,0:34:28.23,0:34:30.25, Lalai,,0,0,0,,terdapat pada senjata pembunuhan.
Dialog: 0,0:34:30.27,0:34:32.33, Lalai,,0,0,0,,Spektrofotometer inframerah menunjukkan...
Dialog: 0,0:34:32.36,0:34:34.96, Lalai,,0,0,0,,...bahawa gentian ini adalah sama,
Dialog: 0,0:34:34.98,0:34:37.80,Lalai,,0,0,0,,dan darah mangsa serta\NDNA ditemui pada baju-T.
Dialog: 0,0:34:37.82,0:34:39.76,Lalai,,0,0,0,,Ini semua bukti keadaan.
Dialog: 0,0:34:39.78,0:34:43.09,Lalai,,0,0,0,,Senjata pembunuhan hanya mempunyai\Njejak cetakan defendan.
Dialog: 0,0:34:43.12,0:34:46.06, Lalai,,0,0,0,,Bagaimana jika saya mempunyai bukti yang lebih pasti?
Dialog: 0,0:34:46.08,0:34:48.34,Lalai,,0,0,0,,Contohnya, foto dan\Nvideo tempat kejadian...
Dialog: 0,0:34:48.36,0:34:50.81, Lalai,,0,0,0,,pembunuh mengambil dirinya.
Dialog: 0,0:34:50.83,0:34:53.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia mesti telah mengambil foto atau video.{\c}{\i0}
Dialog: 0,0:34:53.42,0:34:54.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kami memerlukan telefonnya.{\c}{\i0}
Dialog: 0,0:34:54.80,0:34:57.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda maksudkan dia merekodkan jenayahnya sendiri?{\c}{\i0}
Dialog: 0,0:34:57.26,0:35:00.63,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, jika dia seorang pembunuh upahan.{\c}{\i0}
Dialog: 0,0:35:01.05,0:35:02.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia memerlukan bukti untuk mendapat bayaran.{\c}{\i0}
Dialog: 0,0:35:02.80,0:35:05.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia perlu mengklik pada URL ini.{\c}{\i0}
Dialog: 0,0:35:07.68,0:35:09.31,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Item anda akan dihantar pada pukul 2 p.m.{\c}{\i0}
Dialog: 0,0:35:09.34,0:35:10.33,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Menyalin...{\c}{\i0}
Dialog: 0,0:35:10.35,0:35:13.17, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia melakukannya. Saya kini boleh menduplikasi telefonnya!{\c}{\i0}
Dialog: 0,0:35:13.19,0:35:14.92,Lalai,,0,0,0,,Individu tanpa nama...
Dialog: 0,0:35:14.94,0:35:16.16, Lalai,,0,0,0,,menghantar saya foto dan video...
Dialog: 0,0:35:16.18,0:35:18.63, Lalai,,0,0,0,,tempat kejadian yang\Nada dalam telefon pembunuh.
Dialog: 0,0:35:18.65,0:35:20.59,Lalai,,0,0,0,,- Saya akan serahkan ini sebagai bukti.\N- Bantahan.
Dialog: 0,0:35:20.61,0:35:23.18, Lalai,,0,0,0,,Kami tidak bersetuju dengan bukti ini sebelum ini.
Dialog: 0,0:35:23.20,0:35:26.05, Lalai,,0,0,0,,Ia boleh diperoleh\Secara tidak sah. Tolong tolak.
Dialog: 0,0:35:26.08,0:35:30.16,Lalai,,0,0,0,,Bukti tegas ini\Nakan mempengaruhi perbicaraan!
Dialog: 0,0:35:42.76,0:35:44.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Bangku{\c}{\i0}
Dialog: 0,0:35:44.60,0:35:46.13, Lalai,,0,0,0,,Saya akan menerimanya.
Dialog: 0,0:36:06.45,0:36:09.15,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pembunuh sebenar Pembunuhan Yeongjin-gun\NSambang Reservoir...{\c}{\i0}
Dialog: 0,0:36:09.17,0:36:10.22,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}telah ditangkap.{\c}{\i0}
Dialog: 0,0:36:10.25,0:36:12.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pengawal Pantai Busan menangkap Yoo,{\c}{\i0}
Dialog: 0,0:36:12.42,0:36:14.73,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}yang cuba\Nmengayuh bot nelayan...{\c}{\i0}
Dialog: 0,0:36:14.75,0:36:17.48, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}pukul 11 malam tadi kira-kira 9 batu nautika selatan.{\c}{\i0}
Dialog: 0,0:36:17.50,0:36:21.36,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoo mendakwa dia melakukan\Njenayah itu seorang diri.{\c}{\i0}
Dialog: 0,0:36:21.38,0:36:24.24,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Sementara itu, Baek, yang\Ditahan sebagai suspek,{\c}{\i0}
Dialog: 0,0:36:24.26,0:36:26.86, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}telah dibebaskan semasa perbicaraan pertama hari ini.{\c}{\i0}
Dialog: 0,0:36:26.89,0:36:29.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia dibebaskan serta-merta.{\c}{\i0}
Dialog: 0,0:36:30.93,0:36:32.37, Lalai,,0,0,0,,Kenapa dia tak keluar?
Dialog: 0,0:36:32.39,0:36:34.20, Lalai,,0,0,0,,Adakah sesuatu berlaku?
Dialog: 0,0:36:34.23,0:36:36.12,Lalai,,0,0,0,,Dia akan keluar apabila tiba masanya.
Dialog: 0,0:36:36.15,0:36:38.63, Lalai,,0,0,0,,Mengapa kita di sini?
Dialog: 0,0:36:38.65,0:36:41.84, Lalai,,0,0,0,,Saya sepatutnya berada di jari kaki saya,\Nmemandangkan penguntit saya yang berbahaya...
Dialog: 0,0:36:41.86,0:36:44.61, Lalai,,0,0,0,,- telah dibebaskan.\N- Dia tidak mengintai...
Dialog: 0,0:36:44.95,0:36:47.80,Lalai,,0,0,0,,Sejujurnya, anda lebih seperti seorang penguntit.
Dialog: 0,0:36:47.83,0:36:50.11, Lalai,,0,0,0,,- Saya tidak...\N- Dia ada.
Dialog: 0,0:36:55.88,0:36:57.70, Lalai,,0,0,0,,Di sini!
Dialog: 0,0:36:57.96,0:36:59.91, Lalai,,0,0,0,,Abang bayi saya!
Dialog: 0,0:37:04.68,0:37:06.78, Lalai,,0,0,0,,Saya tidak percaya ini.
Dialog: 0,0:37:06.80,0:37:08.53,Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:37:08.55,0:37:09.57, Lalai,,0,0,0,,Saya tidak apa-apa.
Dialog: 0,0:37:09.60,0:37:10.62, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:37:10.64,0:37:11.83, Lalai,,0,0,0,,Anda pasti risau.
Dialog: 0,0:37:11.85,0:37:14.54,Lalai,,0,0,0,,Saya rasa setiap orang mempunyai kuantiti masalah dalam hidup mereka.
Dialog: 0,0:37:14.56,0:37:16.96,Lalai,,0,0,0,,Hyeon-tae dan saya selalu menyebabkan masalah remeh,
Dialog: 0,0:37:16.98,0:37:18.46, Lalai,,0,0,0,,tetapi tidak pernah sebesar ini.
Dialog: 0,0:37:18.48,0:37:21.04,Lalai,,0,0,0,,Hyun-woo tidak melakukan apa-apa. Dia dibingkai.
Dialog: 0,0:37:21.07,0:37:23.69, Lalai,,0,0,0,,Ya, anda betul.
Dialog: 0,0:37:23.78,0:37:26.52,Lalai,,0,0,0,,- Astaga.\N- Awak selamat sekarang, okay?
Dialog: 0,0:37:29.91,0:37:31.44,Lalai,,0,0,0,,Apa?
Dialog: 0,0:37:31.58,0:37:33.53, Lalai,,0,0,0,,Saya rasa mereka hampir.
Dialog: 0,0:37:40.34,0:37:44.75,Lalai,,0,0,0,,"Keluarga yang mesra."
Dialog: 0,0:37:46.76,0:37:48.74, Lalai,,0,0,0,,- Makan ini.\N- Tidak, terima kasih.
Dialog: 0,0:37:48.76,0:37:50.66,Lalai,,0,0,0,,- Apa?\N- Tak apa.
Dialog: 0,0:37:50.68,0:37:53.05,Default,,0,0,0,,Aku rasa dia tak makan tauhu.
Dialog: 0,0:37:53.72,0:37:56.09, Lalai,,0,0,0,,"Tidak makan tauhu."
Dialog: 0,0:37:57.56,0:37:59.72,Lalai,,0,0,0,,Adakah dia tidak menyukainya?
Dialog: 0,0:38:00.52,0:38:03.14, Lalai,,0,0,0,,- Mengapa? Sedap.\N- Awak tengah buat apa?
Dialog: 0,0:38:10.57,0:38:12.61, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:38:13.12,0:38:14.60,Lalai,,0,0,0,,Adakah dia melihat saya?
Dialog: 0,0:38:14.62,0:38:17.53, Lalai,,0,0,0,,- Dia buat, kan?\N- Dia pergi.
Dialog: 0,0:38:19.13,0:38:20.66, Lalai,,0,0,0,, Adakah dia?
Dialog: 0,0:38:28.01,0:38:30.95, Lalai,,0,0,0,,Baik. Mari kita diam-diam mengikuti mereka.
Dialog: 0,0:38:30.97,0:38:33.07, Lalai,,0,0,0,,Apa? Adakah kita serius mengintai dia?
Dialog: 0,0:38:33.10,0:38:35.74, Lalai,,0,0,0,,Sudah tentu tidak. saya cuma nak...
Dialog: 0,0:38:35.77,0:38:40.29,Lalai,,0,0,0,,untuk mengawasinya dan\Nlihat jika dia akan merancang apa-apa lagi.
Dialog: 0,0:38:40.31,0:38:42.42, Lalai,,0,0,0,,Itulah stalking.
Dialog: 0,0:38:42.44,0:38:44.85, Lalai,,0,0,0,, Teruskan sahaja, sudah.
Dialog: 0,0:38:52.95,0:38:55.64, Lalai,,0,0,0,,Pastikan ia diratakan dengan betul.
Dialog: 0,0:38:55.66,0:38:57.47, Lalai,,0,0,0,,Saya sedang melakukannya sekarang.
Dialog: 0,0:38:57.50,0:38:58.81, Lalai,,0,0,0,,Turun jika anda takut.
Dialog: 0,0:38:58.83,0:39:01.62, Lalai,,0,0,0,,Saya perlu menyemak, walaupun.
Dialog: 0,0:39:03.04,0:39:05.61, Lalai,,0,0,0,,Du-gwan, adakah anda akan baik-baik saja?
Dialog: 0,0:39:05.63,0:39:09.19, Lalai,,0,0,0,,Sudah tentu. Jika boleh, saya akan\Nmengedarkan semuanya secara percuma.
Dialog: 0,0:39:09.22,0:39:10.82,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Hyun-woo Discharged\NHJualan Harga Separuh!{\c}{\i0}
Dialog: 0,0:39:10.84,0:39:13.17, Lalai,,0,0,0,,Adakah anda mahu membelinya juga?
Dialog: 0,0:39:14.10,0:39:17.08,Lalai,,0,0,0,,Baiklah, anda mesti suka {\i1}mandu.{\i0}
Dialog: 0,0:39:17.10,0:39:18.99, Lalai,,0,0,0,,Ini ada di rumah.
Dialog: 0,0:39:19.02,0:39:20.95, Lalai,,0,0,0,,Kenapa, terima kasih.
Dialog: 0,0:39:20.98,0:39:23.37,Default,,0,0,0,,- Saya lebih bersyukur.\N- Tahniah juga.
Dialog: 0,0:39:23.40,0:39:25.18,Lalai,,0,0,0,,Terima kasih, puan.
Dialog: 0,0:39:25.36,0:39:26.75, Lalai,,0,0,0,,Selamat tinggal.
Dialog: 0,0:39:26.78,0:39:29.02,Lalai,,0,0,0,,Selamat tinggal, puan.
Dialog: 0,0:39:30.15,0:39:32.97, Lalai,,0,0,0,,Adakah anda akhirnya mendapat falsafah pemasaran saya?
Dialog: 0,0:39:32.99,0:39:35.83, Lalai,,0,0,0,,Sama sekali. Saya harus meminta pelanggan saya untuk cinta,
Dialog: 0,0:39:35.85,0:39:36.89,Lalai,,0,0,0,,bukan wang.
Dialog: 0,0:39:36.91,0:39:37.95,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:39:37.97,0:39:40.06,Lalai,,0,0,0,,Saya mengikut falsafah itu apabila saya kembali.
Dialog: 0,0:39:40.08,0:39:42.10,Lalai,,0,0,0,,Baik.
Dialog: 0,0:39:42.12,0:39:43.70,Lalai,,0,0,0,,Semoga berjaya.
Dialog: 0,0:39:43.83,0:39:46.06, Lalai,,0,0,0,,Tuan, adakah roti kukus ini separuh juga?
Dialog: 0,0:39:46.09,0:39:48.32, Lalai,,0,0,0,,Roti kukus? Hei!
Dialog: 0,0:39:48.34,0:39:49.86, Lalai,,0,0,0,, Separuh, kaki saya!
Dialog: 0,0:39:49.88,0:39:51.83, Lalai,,0,0,0,, Ke tepi.
Dialog: 0,0:39:52.93,0:39:55.25, Lalai,,0,0,0,,Ia percuma. Mengetuk diri sendiri.
Dialog: 0,0:39:57.72,0:39:59.79, Lalai,,0,0,0,,Ais krim juga percuma!
Dialog: 0,0:39:59.81,0:40:01.29,Lalai,,0,0,0,,Takkan dia menyesal esok?
Dialog: 0,0:40:01.31,0:40:04.22, Lalai,,0,0,0,, Esok? Dia akan menyesal malam ini.
Dialog: 0,0:40:05.48,0:40:06.71, Lalai,,0,0,0,,Hei, masuk barisan!
Dialog: 0,0:40:06.73,0:40:08.60, Lalai,,0,0,0,,Itu mesti Hyun-woo.
Dialog: 0,0:40:09.44,0:40:11.05, Lalai,,0,0,0,, Kebaikan! Hei!
Dialog: 0,0:40:11.07,0:40:12.92,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,0:40:12.95,0:40:15.19, Lalai,,0,0,0,,- Baik!\N- Sayang.
Dialog: 0,0:40:15.91,0:40:17.44, Lalai,,0,0,0,,Itu Hyun-woo.
Dialog: 0,0:40:20.96,0:40:23.82, Lalai,,0,0,0,,Saya pulang, Ayah.
Dialog: 0,0:40:24.00,0:40:25.53,Lalai,,0,0,0,,Baik.
Dialog: 0,0:40:25.63,0:40:27.29,Lalai,,0,0,0,,Selamat pulang.
Dialog: 0,0:40:27.50,0:40:28.98,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:40:29.00,0:40:30.87, Lalai,,0,0,0,,Jangan cakap begitu.
Dialog: 0,0:40:32.01,0:40:35.34,Lalai,,0,0,0,,Mengapa anda meminta maaf\Napabila anda tidak melakukan kesalahan?
Dialog: 0,0:40:35.39,0:40:37.53, Lalai,,0,0,0,,- Syabas, Hyun-woo.\N- Tahniah.
Dialog: 0,0:40:37.56,0:40:38.70, Lalai,,0,0,0,,Anda melakukannya dengan baik.
Dialog: 0,0:40:38.72,0:40:40.53, Lalai,,0,0,0,,- Tahniah.\N- Syabas.
Dialog: 0,0:40:40.56,0:40:42.79, Lalai,,0,0,0,,Mestilah sukar.
Dialog: 0,0:40:42.81,0:40:44.64, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:40:51.19,0:40:53.52,Lalai,,0,0,0,,Selamat kembali, Hyun-woo.
Dialog: 0,0:40:53.57,0:40:54.71,Lalai,,0,0,0,,Bukankah itu Soo-cheol?
Dialog: 0,0:40:54.74,0:40:57.97,Lalai,,0,0,0,,Ya, dia telah tinggal di sini\Nand mengelak ibunya.
Dialog: 0,0:40:57.99,0:40:59.85, Lalai,,0,0,0,,Tetapi kenapa di sini?
Dialog: 0,0:40:59.87,0:41:03.18,Lalai,,0,0,0,,Itu rumah ibu bapa bekas suaminya.
Dialog: 0,0:41:03.21,0:41:04.99,Lalai,,0,0,0,,Adakah dia selesa?
Dialog: 0,0:41:05.17,0:41:06.99, Lalai,,0,0,0,,Saya rasa.
Dialog: 0,0:41:07.17,0:41:09.16,Lalai,,0,0,0,,Lihatlah betapa gembiranya mereka.
Dialog: 0,0:41:09.42,0:41:12.62, Lalai,,0,0,0,, Mereka adalah keluarga yang ganjil.
Dialog: 0,0:41:14.51,0:41:16.42, Lalai,,0,0,0,,Salji turun!
Dialog: 0,0:41:16.68,0:41:19.09, Lalai,,0,0,0,,- Aduh!\N- Aduh!
Dialog: 0,0:41:36.57,0:41:38.11,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:41:38.70,0:41:40.40,Lalai,,0,0,0,,Ibu.
Dialog: 0,0:41:41.08,0:41:42.61, Lalai,,0,0,0,,Anda kembali.
Dialog: 0,0:41:43.08,0:41:45.82,Lalai,,0,0,0,,Saya membuat bubur kacang merah manis, kegemaran anda.
Dialog: 0,0:41:50.13,0:41:51.90,Lalai,,0,0,0,,Anda pasti sangat risau.
Dialog: 0,0:41:51.92,0:41:54.66, Lalai,,0,0,0,,Hei, saya tidak risau...
Dialog: 0,0:41:54.72,0:41:56.50, Lalai,,0,0,0,,sedikit,
Dialog: 0,0:41:56.84,0:41:59.75,Lalai,,0,0,0,,kerana keadilan akan sentiasa diutamakan.
Dialog: 0,0:42:00.05,0:42:01.88, Lalai,,0,0,0,,Bukan saya.
Dialog: 0,0:42:02.35,0:42:04.24, Lalai,,0,0,0,,Saya risau sakit.
Dialog: 0,0:42:04.27,0:42:06.83, Lalai,,0,0,0,,- Saya juga.\N- Saya juga.
Dialog: 0,0:42:06.85,0:42:10.17, Lalai,,0,0,0,,Bayi malang saya telah melalui begitu banyak perkara.
Dialog: 0,0:42:10.19,0:42:15.02, Lalai,,0,0,0,,Saya risau sakit!
Dialog: 0,0:42:15.49,0:42:17.85,Lalai,,0,0,0,,Ibu bapanya kelihatan baik hati.
Dialog: 0,0:42:19.91,0:42:23.30,Lalai,,0,0,0,,Dia mesti tidak suka tauhu, tetapi\Nmenikmati bubur kacang merah yang manis.
Dialog: 0,0:42:23.33,0:42:25.53,Lalai,,0,0,0,,Adakah dia seorang kanak-kanak, atau apa?
Dialog: 0,0:42:27.79,0:42:29.74,Lalai,,0,0,0,,"Seronok makan..."
Dialog: 0,0:42:31.71,0:42:33.31, Lalai,,0,0,0,,"bubur kacang merah manis."
Dialog: 0,0:42:33.34,0:42:35.90,Lalai,,0,0,0,,Anda mengingatkan saya tentang diri saya pada masa lalu.
Dialog: 0,0:42:35.92,0:42:36.90,Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,0:42:36.92,0:42:39.15,Lalai,,0,0,0,,Saya seperti awak sebelum saya jatuh cinta dengan BTS.
Dialog: 0,0:42:39.18,0:42:41.28,Lalai,,0,0,0,,Cinta sejati bukan,
Dialog: 0,0:42:41.30,0:42:44.20,Lalai,,0,0,0,,"Astaga, saya sangat sayangkan dia."
Dialog: 0,0:42:44.22,0:42:47.29,Lalai,,0,0,0,,Ia adalah, "Apa ini? Apa urusan dia?"
Dialog: 0,0:42:47.31,0:42:49.55, Lalai,,0,0,0,,Begitulah ia bermula.
Dialog: 0,0:42:50.52,0:42:53.83,Lalai,,0,0,0,,Adakah anda selalu bercakap fikiran anda di hadapan saya?
Dialog: 0,0:42:53.86,0:42:55.39,Lalai,,0,0,0,,Ya.
Dialog: 0,0:42:56.53,0:42:58.34, Lalai,,0,0,0,,Saya seorang bos yang santai.
Dialog: 0,0:42:58.36,0:43:00.86, Lalai,,0,0,0,,Anda tidak ingat apa-apa?
Dialog: 0,0:43:01.20,0:43:02.18, Lalai,,0,0,0,,Kemudian...
Dialog: 0,0:43:02.20,0:43:05.32,Lalai,,0,0,0,,adakah anda ingat bersetuju untuk memberi saya $100,000?
Dialog: 0,0:43:06.75,0:43:08.61, Lalai,,0,0,0,,Tidak mungkin.
Dialog: 0,0:43:09.79,0:43:13.27,Lalai,,0,0,0,,Anda mungkin tidak ingat, tetapi\Anda masih mempunyai pertimbangan yang jelas,
Dialog: 0,0:43:13.29,0:43:15.45,Lalai,,0,0,0,,jadi kenapa anda tidak tahu?
Dialog: 0,0:43:15.63,0:43:17.33, Lalai,,0,0,0,, Tahu apa?
Dialog: 0,0:43:17.80,0:43:20.88,Lalai,,0,0,0,,Siapa yang anda sayangi.
Dialog: 0,0:43:22.72,0:43:24.42,Lalai,,0,0,0,,Dan siapa itu?
Dialog: 0,0:43:25.76,0:43:29.76, Lalai,,0,0,0,,Saya tidak boleh katakan, memandangkan tugas saya ada dalam talian,
Dialog: 0,0:43:30.06,0:43:31.85, Lalai,,0,0,0,,tetapi saya akan katakan ini.
Dialog: 0,0:43:32.06,0:43:33.96,Lalai,,0,0,0,,Hati awak terletak...
Dialog: 0,0:43:33.98,0:43:36.18, Lalai,,0,0,0,, ke mana badan anda pergi.
Dialog: 0,0:44:10.06,0:44:11.33, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:44:11.35,0:44:15.54,Lalai,,0,0,0,,En. Ivan menjumpainya di dalam tong sampah dan\Nkata kita harus mencari pemiliknya.
Dialog: 0,0:44:15.56,0:44:16.75, Lalai,,0,0,0,,Adakah ia mempunyai nama?
Dialog: 0,0:44:16.77,0:44:21.17, Lalai,,0,0,0,,Tidak, dan saya tidak boleh membacanya kerana\Nit dalam bahasa asing.
Dialog: 0,0:44:21.20,0:44:22.59, Lalai,,0,0,0,,Maka bagaimana kita akan mencari pemiliknya?
Dialog: 0,0:44:22.61,0:44:24.05, Lalai,,0,0,0,,Buang sahaja.
Dialog: 0,0:44:24.07,0:44:25.26, Lalai,,0,0,0,,Mungkin buku nota itu.
Dialog: 0,0:44:25.28,0:44:26.72,Lalai,,0,0,0,,En. Peguam Baek...
Dialog: 0,0:44:26.74,0:44:32.27,Lalai,,0,0,0,, menelefon dari Korea dan meminta\Nus memulangkan buku nota kepadanya.
Dialog: 0,0:44:32.29,0:44:34.57,Lalai,,0,0,0,,- Saya akan pergi.\N- Okay, bye.
Dialog: 0,0:44:37.34,0:44:38.31, Lalai,,0,0,0,, Yeong-song.
Dialog: 0,0:44:38.34,0:44:40.46, Lalai,,0,0,0,,Dia kembali lagi.
Dialog: 0,0:45:08.49,0:45:11.44,Lalai,,0,0,0,,Mak Cik Beom-ja, adakah kamu tinggal di sini atau sesuatu?
Dialog: 0,0:45:12.70,0:45:15.52,Lalai,,0,0,0,,Saya di sini untuk mengucapkan tahniah kepada Hyun-woo.
Dialog: 0,0:45:15.54,0:45:17.52,Lalai,,0,0,0,,Perkhidmatan katering akan tiba tidak lama lagi.
Dialog: 0,0:45:17.54,0:45:19.59,Lalai,,0,0,0,, Patutkah saya menyuruh mereka pergi ke balai raya?
Dialog: 0,0:45:19.61,0:45:21.02, Lalai,,0,0,0,,Helo, Beom-ja.
Dialog: 0,0:45:21.05,0:45:24.00, Lalai,,0,0,0,,Kebaikan. Anda berada di sini juga.
Dialog: 0,0:45:24.47,0:45:27.36,Lalai,,0,0,0,,Saya menyediakan banyak hadiah juga,\Nkerana saya berada dalam mood yang baik.
Dialog: 0,0:45:27.39,0:45:28.86, Lalai,,0,0,0,,- Datanglah nanti.\N- Astaga, hadiah?
Dialog: 0,0:45:28.89,0:45:30.03, Lalai,,0,0,0,,Seperti...?
Dialog: 0,0:45:30.06,0:45:32.37, Lalai,,0,0,0,,Suplemen dan pengurut.
Dialog: 0,0:45:32.39,0:45:34.81, Lalai,,0,0,0,,Hadiah utama ialah mesin basuh muatan hadapan yang terkini.
Dialog: 0,0:45:34.84,0:45:35.83, Lalai,,0,0,0,,Aduh, mesin basuh?
Dialog: 0,0:45:35.85,0:45:37.62, Lalai,,0,0,0,,- Tidak boleh.\N- Pencuci?
Dialog: 0,0:45:37.65,0:45:40.77, Lalai,,0,0,0,,Ya ampun, kami bercadang untuk mendapatkan yang baharu.
Dialog: 0,0:45:41.23,0:45:43.46,Lalai,,0,0,0,,Beginikah cara orang kaya melenturkan wang mereka?
Dialog: 0,0:45:43.49,0:45:46.42,Lalai,,0,0,0,,Saya ingin hidup seperti dia dalam kehidupan seterusnya.
Dialog: 0,0:45:46.45,0:45:49.36, Lalai,,0,0,0,,Macam saya? Dan apa itu?
Dialog: 0,0:45:49.49,0:45:51.39,Lalai,,0,0,0,,Anda ada wang. awak cantik,
Dialog: 0,0:45:51.41,0:45:53.39,Lalai,,0,0,0,,dan yang paling penting, anda telah berkahwin tiga kali.
Dialog: 0,0:45:53.41,0:45:56.06, Lalai,,0,0,0,,Saya paling iri dengan itu.
Dialog: 0,0:45:56.08,0:45:57.92,Lalai,,0,0,0,,Anda tidak perlu menyebutnya.
Dialog: 0,0:45:57.94,0:45:58.94, Lalai,,0,0,0,,Mengapa tidak?
Dialog: 0,0:45:58.96,0:46:00.56, Lalai,,0,0,0,,Bukan semua orang boleh berbuat demikian.
Dialog: 0,0:46:00.59,0:46:02.56,Lalai,,0,0,0,,Aduh, saya setuju.
Dialogue: 0,0:46:02.59,0:46:05.69,Default,,0,0,0,,Saya tidak boleh menukar mesin basuh saya, apatah lagi suami saya.
Dialog: 0,0:46:05.72,0:46:09.03,Default,,0,0,0,,Jangan cakap macam tu depan orang bujang.
Dialog: 0,0:46:09.05,0:46:10.97,Lalai,,0,0,0,,By the way, adakah awak benar-benar tidak akan berkahwin?
Dialog: 0,0:46:10.99,0:46:12.91,Lalai,,0,0,0,,Saya boleh beri jaminan untuk guru tadika itu.
Dialog: 0,0:46:12.93,0:46:15.37, Lalai,,0,0,0,,Bang-sil betul. Dia benar-benar\Nmelompat melalui gelung.
Dialog: 0,0:46:15.39,0:46:16.45,Lalai,,0,0,0,,Temui wanita itu sahaja.
Dialog: 0,0:46:16.48,0:46:17.87, Lalai,,0,0,0,, Kawan-kawan.
Dialog: 0,0:46:17.90,0:46:18.94,Lalai,,0,0,0,,Anda tidak sepatutnya membiarkan dia...
Dialog: 0,0:46:18.96,0:46:20.21,Lalai,,0,0,0,,tentukan sendiri.
Dialog: 0,0:46:20.23,0:46:21.58,Lalai,,0,0,0,,Anda perlu mendesaknya.
Dialog: 0,0:46:21.61,0:46:23.79, Lalai,,0,0,0,,Anda perlu meneruskan.
Dialog: 0,0:46:23.82,0:46:24.84, Lalai,,0,0,0,,Bagaimana dengan minggu depan?
Dialog: 0,0:46:24.86,0:46:26.67, Lalai,,0,0,0,,- Yeong-song...\N- Maafkan saya.
Dialog: 0,0:46:26.70,0:46:28.30,Lalai,,0,0,0,,Di mana balai raya lagi?
Dialog: 0,0:46:28.32,0:46:30.05,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Cabutan Bertuah{\c}{\i0}
Dialog: 0,0:46:30.07,0:46:33.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Meraikan Pelepasan Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:46:38.25,0:46:40.48,Lalai,,0,0,0,,Tepuk tangan!
Dialog: 0,0:46:40.50,0:46:43.98, Lalai,,0,0,0,,Semua orang! Saya ingin mengucapkan terima kasih kepada anda semua...
Dialog: 0,0:46:44.00,0:46:47.44,Lalai,,0,0,0,,untuk menghadiri perayaan abang saya...
Dialog: 0,0:46:47.47,0:46:50.50,Lalai,,0,0,0,,Pelepasan Baek Hyun-woo!
Dialog: 0,0:46:52.47,0:46:54.99,Lalai,,0,0,0,,Inilah kemuncak parti itu.
Dialog: 0,0:46:55.02,0:46:59.01, Lalai,,0,0,0,,Dia akan potong tauhu. Bertepuk tangan!
Dialog: 0,0:47:03.52,0:47:04.92,Lalai,,0,0,0,,Mari kita lakukan bersama-sama.
Dialog: 0,0:47:04.94,0:47:07.10,Lalai,,0,0,0,,Okey. Satu, dua, tiga.
Dialog: 0,0:47:08.07,0:47:09.92, Lalai,,0,0,0,,Itu potongan yang bersih.
Dialog: 0,0:47:09.95,0:47:11.88,Lalai,,0,0,0,,- Tahniah.\N- Terima kasih.
Dialog: 0,0:47:11.91,0:47:13.98,Lalai,,0,0,0,,Saya faham!
Dialog: 0,0:47:14.28,0:47:16.28,Lalai,,0,0,0,,Saya memenangi TV!
Dialog: 0,0:47:17.45,0:47:21.16,Lalai,,0,0,0,,Hadiah seterusnya ialah makanan tambahan.
Dialog: 0,0:47:22.21,0:47:25.65, Lalai,,0,0,0,,Adik saya, Cik Baek Mi-seon,\Nakan pilih pemenang.
Dialog: 0,0:47:25.67,0:47:27.58,Lalai,,0,0,0,,Ayuh keluar.
Dialog: 0,0:47:32.26,0:47:33.80, Lalai,,0,0,0,,Pilih satu.
Dialog: 0,0:47:37.89,0:47:39.80,Lalai,,0,0,0,,Nombor bertuah ialah...
Dialog: 0,0:47:42.98,0:47:44.51,Lalai,,0,0,0,,17!
Dialog: 0,0:47:44.94,0:47:46.29,Lalai,,0,0,0,,Siapa itu?
Dialog: 0,0:47:46.32,0:47:47.96,Lalai,,0,0,0,,- Ini Bang-sil!\N- Ini saya!
Dialog: 0,0:47:47.99,0:47:49.80,Lalai,,0,0,0,,Ini saya!
Dialog: 0,0:47:49.82,0:47:51.65, Lalai,,0,0,0,,Bang-sil!
Dialog: 0,0:47:56.33,0:47:57.47,Lalai,,0,0,0,,Tahniah.
Dialog: 0,0:47:57.49,0:48:00.78, Lalai,,0,0,0,,Terima kasih, Hyun-woo. Saya akan menjadi lebih cantik sekarang.
Dialog: 0,0:48:02.75,0:48:05.45,Lalai,,0,0,0,,Tahniah.
Dialog: 0,0:48:05.75,0:48:08.65, Lalai,,0,0,0,,- Hadiah utama yang ditunggu-tunggu...\N- Saya ditakdirkan untuk tidak pernah kelaparan.
Dialog: 0,0:48:08.67,0:48:10.73, Lalai,,0,0,0,,...pencuci, adalah satu-satunya yang tinggal.
Dialog: 0,0:48:10.76,0:48:13.32,Lalai,,0,0,0,,Pn. Hong Beom-ja, yang menyediakan semua hadiah ini,
Dialog: 0,0:48:13.34,0:48:16.67, Lalai,,0,0,0,,akan mengumumkan pemenang. Bertepuk tangan!
Dialog: 0,0:48:35.70,0:48:37.57,Lalai,,0,0,0,,Pemenang ialah...
Dialog: 0,0:48:39.12,0:48:42.28, Lalai,,0,0,0,, Lima! tahniah!
Dialog: 0,0:48:42.41,0:48:44.37, Lalai,,0,0,0,,Siapa itu?
Dialog: 0,0:48:46.88,0:48:48.23,Lalai,,0,0,0,,- Apa?\N- Aduh, Yeong-song!
Dialog: 0,0:48:48.25,0:48:50.15, Lalai,,0,0,0,, Yeong-song, awak menang!
Dialog: 0,0:48:50.17,0:48:52.63, Lalai,,0,0,0,,Itu Yeong-song!
Dialog: 0,0:48:52.66,0:48:53.65, Lalai,,0,0,0,, Yeong-song!
Dialog: 0,0:48:53.68,0:48:55.07, Lalai,,0,0,0,,Itu milik anda!
Dialog: 0,0:48:55.09,0:48:56.49,Lalai,,0,0,0,,Anda menang!
Dialog: 0,0:48:56.51,0:48:58.57,Lalai,,0,0,0,,- Astaga.\N- Anda boleh memilikinya.
Dialog: 0,0:48:58.60,0:48:59.66,Lalai,,0,0,0,,Apa?
Dialog: 0,0:48:59.68,0:49:01.16, Lalai,,0,0,0,,- Betulkah?\N- Kenapa?
Dialog: 0,0:49:01.18,0:49:03.75, Lalai,,0,0,0,,Saya tidak perlukan satu, tetapi kamu semua perlukan.
Dialog: 0,0:49:03.77,0:49:06.05, Lalai,,0,0,0,,- Serius?\N- Tidak boleh!
Dialog: 0,0:49:17.16,0:49:18.86, Lalai,,0,0,0,,Terima kasih!
Dialog: 0,0:49:26.54,0:49:27.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Dewan Komuniti Yongdu-ri{\c}{\i0}
Dialog: 0,0:49:27.92,0:49:30.16, Lalai,,0,0,0,,Tunggu, Encik Kim!
Dialog: 0,0:49:31.51,0:49:32.48, Lalai,,0,0,0,,Ya, Beom-ja?
Dialog: 0,0:49:32.51,0:49:34.44,Lalai,,0,0,0,,Bagaimanakah anda tidak mementingkan diri sendiri?
Dialog: 0,0:49:34.47,0:49:36.09, Lalai,,0,0,0,,Anda memenangi mesin basuh.
Dialog: 0,0:49:36.12,0:49:37.15,Lalai,,0,0,0,,Itu milik anda.
Dialog: 0,0:49:37.18,0:49:39.78, Lalai,,0,0,0,,Tetapi mesin basuh saya berfungsi dengan baik.
Dialog: 0,0:49:39.81,0:49:43.20,Lalai,,0,0,0,,Saya tahu ia sudah lama dan tidak stabil. Saya melihatnya.
Dialog: 0,0:49:43.23,0:49:45.47, Lalai,,0,0,0,,Ia masih menjalankan tugasnya.
Dialog: 0,0:49:45.94,0:49:47.91, Lalai,,0,0,0,, Yang ini ialah model terbaharu.
Dialog: 0,0:49:47.94,0:49:51.50, Lalai,,0,0,0,,Ia mempunyai sistem AI. Ia\Nboleh mencuci selimut dan kasut.
Dialog: 0,0:49:52.63,0:49:54.32,Lalai,,0,0,0,,Ya.
Dialog: 0,0:49:54.65,0:49:57.27, Lalai,,0,0,0,,"Ya"?
Dialog: 0,0:49:57.36,0:49:59.80, Lalai,,0,0,0,,Anda harus merebut peluang.
Dialog: 0,0:49:59.83,0:50:03.90, Lalai,,0,0,0,,Begitu juga dengan mesin basuh dan orang.\NMengapa anda tidak mengambilnya?
Dialog: 0,0:50:07.67,0:50:10.85, Lalai,,0,0,0,,Saya tidak akan kembali ke sini sebaik sahaja saya pergi hari ini.
Dialog: 0,0:50:10.88,0:50:12.90, Lalai,,0,0,0,,Anda masih tidak akan merebut saya?
Dialog: 0,0:50:12.92,0:50:14.98, Lalai,,0,0,0,,Bagaimana jika anda tidak pernah melihat saya lagi?
Dialog: 0,0:50:15.01,0:50:17.83, Lalai,,0,0,0,,Apa yang menghalang saya daripada berkahwin lagi?
Dialog: 0,0:50:18.76,0:50:21.30,Lalai,,0,0,0,,Adakah anda akan berkahwin lagi?
Dialog: 0,0:50:21.89,0:50:24.51, Lalai,,0,0,0,,Bukan itu yang saya maksudkan.
Dialog: 0,0:50:28.90,0:50:31.10, Lalai,,0,0,0,,Saya akan katakan ini sekali.
Dialog: 0,0:50:33.65,0:50:36.02, Lalai,,0,0,0,,Saya berminat dengan awak.
Dialog: 0,0:50:36.15,0:50:37.46, Lalai,,0,0,0,,No.
Dialog: 0,0:50:37.49,0:50:39.27,Lalai,,0,0,0,,Saya suka awak,
Dialog: 0,0:50:39.99,0:50:42.53, Lalai,,0,0,0,,jadi takkan awak buat apa-apa ke?
Dialog: 0,0:50:43.37,0:50:46.53, Lalai,,0,0,0,,Sebaik sahaja saya pergi, saya tidak akan kembali.
Dialog: 0,0:50:53.30,0:50:54.48,Lalai,,0,0,0,,Pn. Hong...
Dialog: 0,0:50:54.50,0:50:55.69, Lalai,,0,0,0,, Satu minit.
Dialog: 0,0:50:55.71,0:50:57.97,Lalai,,0,0,0,,Saya ada soalan nak tanya dia.
Dialog: 0,0:50:57.99,0:50:58.99, Lalai,,0,0,0,,Saya akan masuk tidak lama lagi.
Dialog: 0,0:50:59.01,0:51:00.78, Lalai,,0,0,0,,- Bukan sebab itu.\N- Apa?
Dialog: 0,0:51:00.80,0:51:02.57, Lalai,,0,0,0,,- Apa itu?\N- Nah...
Dialog: 0,0:51:02.60,0:51:03.70, Lalai,,0,0,0,,Itu...
Dialog: 0,0:51:03.72,0:51:05.30, Lalai,,0,0,0,, Perkara ini...
Dialog: 0,0:51:07.23,0:51:08.62, Lalai,,0,0,0,,Ia wayarles.
Dialog: 0,0:51:08.64,0:51:12.56, Lalai,,0,0,0,,Ia disambungkan kepada pembesar suara dalaman.
Dialog: 0,0:51:14.52,0:51:16.54,Lalai,,0,0,0,,{\i1}Begitu juga dengan mesin basuh dan orang.{\i0}
Dialog: 0,0:51:16.57,0:51:18.00, Lalai,,0,0,0,,{\i1}Mengapa anda tidak mahu mengambilnya?{\i0}
Dialog: 0,0:51:18.03,0:51:19.63,Lalai,,0,0,0,,{\i1}Saya tidak akan kembali ke sini...{\i0}
Dialog: 0,0:51:19.65,0:51:21.01,Lalai,,0,0,0,,{\i1}sebaik sahaja saya pergi hari ini.{\i0}
Dialog: 0,0:51:21.03,0:51:22.70,Lalai,,0,0,0,,{\i1}Anda masih tidak merebut saya?{\i0}
Dialog: 0,0:51:22.72,0:51:24.12,Lalai,,0,0,0,,{\i1}Bagaimana jika anda tidak pernah melihat saya lagi?{\i0}
Dialog: 0,0:51:24.14,0:51:26.14,Lalai,,0,0,0,,{\i1}Apakah yang menghalang saya daripada berkahwin lagi?{\i0}
Dialog: 0,0:51:26.17,0:51:27.15, Lalai,,0,0,0,, Kebaikan!
Dialog: 0,0:51:27.18,0:51:28.47, Lalai,,0,0,0,,Dia sangat keren.
Dialog: 0,0:51:28.50,0:51:30.03, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:51:30.83,0:51:32.34,Lalai,,0,0,0,,{\i1}Adakah anda akan berkahwin lagi?{\i0}
Dialog: 0,0:51:32.36,0:51:33.35,Lalai,,0,0,0,,Adakah dia bodoh?
Dialog: 0,0:51:33.38,0:51:35.73, Lalai,,0,0,0,,Bukan itu yang dia maksudkan.
Dialog: 0,0:51:35.75,0:51:38.41,Lalai,,0,0,0,,{\i1}Bukan itu yang saya maksudkan.{\i0}
Dialog: 0,0:51:40.22,0:51:41.74, Lalai,,0,0,0,,{\i1}Saya akan katakan ini sekali.{\i0}
Dialog: 0,0:51:41.76,0:51:43.49,Lalai,,0,0,0,,{\i1}Saya berminat dengan awak.{\i0}
Dialog: 0,0:51:43.51,0:51:44.53, Lalai,,0,0,0,,{\i1}No.{\i0}
Dialog: 0,0:51:44.55,0:51:46.09,Lalai,,0,0,0,,{\i1}Saya suka awak,{\i0}
Dialog: 0,0:51:46.52,0:51:51.25, Lalai,,0,0,0,,{\i1}jadi takkan awak buat apa-apa?\Bila saya pergi, saya tidak akan kembali.{\i0}
Dialog: 0,0:51:51.27,0:51:52.80, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:51:53.61,0:51:56.56,Lalai,,0,0,0,,Dia memalukan keluarga kami.
Dialog: 0,0:52:04.62,0:52:07.44, Lalai,,0,0,0,, Yeong-song! Jawab dengan bijak!
Dialog: 0,0:52:07.62,0:52:08.60, Lalai,,0,0,0,,Mak Cik Beom-ja!
Dialog: 0,0:52:08.62,0:52:09.64, Lalai,,0,0,0,,Tak apa!
Dialog: 0,0:52:09.66,0:52:12.06, Lalai,,0,0,0,,- Tak apa!\N- Sial.
Dialog: 0,0:52:12.08,0:52:14.91, Lalai,,0,0,0,,Nak ke mana? Tidak, tunggu!
Dialog: 0,0:52:15.04,0:52:17.65, Lalai,,0,0,0,,Tidak, anda harus terus menyenggol dia!
Dialog: 0,0:52:17.67,0:52:19.23, Lalai,,0,0,0,,Teruskan!
Dialog: 0,0:52:19.26,0:52:22.17, Lalai,,0,0,0,, Kejar dia! Cepat!
Dialog: 0,0:52:23.76,0:52:25.88, Lalai,,0,0,0,, Yeong-song!
Dialog: 0,0:52:28.93,0:52:32.08, Lalai,,0,0,0,,Tuan, Baek Hyun-woo meminta\Njawatankuasa kakitangan untuk mengembalikannya.
Dialog: 0,0:52:32.10,0:52:33.75, Lalai,,0,0,0,,Pertuduhan membunuhnya telah digugurkan,
Dialog: 0,0:52:33.77,0:52:35.77,Lalai,,0,0,0,,jadi tiada cara yang sah untuk menolak permintaannya.
Dialog: 0,0:52:35.79,0:52:38.29,Lalai,,0,0,0,,Aduh, adakah dia zombi atau apa?
Dialog: 0,0:52:38.32,0:52:39.92,Lalai,,0,0,0,,Dia seorang yang tabah.
Dialog: 0,0:52:39.94,0:52:42.17, Lalai,,0,0,0,,Anda betul, tetapi ada masalah yang lebih besar.
Dialog: 0,0:52:42.20,0:52:44.72, Lalai,,0,0,0,,Pertemuan rakan kongsi terhad\Nakan berlangsung di New York.
Dialog: 0,0:52:44.74,0:52:47.90,Lalai,,0,0,0,,Mereka akan mengundi berkenaan\Npemecatan pengerusi.
Dialog: 0,0:52:51.12,0:52:53.35, Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:52:53.37,0:52:55.06, Lalai,,0,0,0,,Jika pengerusi gagal menyediakan,
Dialog: 0,0:52:55.08,0:52:58.19, Lalai,,0,0,0,,atau mengada-adakan, dokumen\N kewangan kepada pelabur,
Dialog: 0,0:52:58.21,0:53:01.13, Lalai,,0,0,0,,rakan kongsi terhad boleh mengadakan\Nmesyuarat dan memecat pengerusi...
Dialog: 0,0:53:01.15,0:53:02.98, Lalai,,0,0,0,,Tepat!
Dialog: 0,0:53:03.17,0:53:06.57, Lalai,,0,0,0,,Siapa yang menyerahkan dokumen tersebut?
Dialog: 0,0:53:06.60,0:53:08.78, Lalai,,0,0,0,,Adakah itu Baek Hyun-woo? Adakah saya betul?
Dialog: 0,0:53:08.81,0:53:11.45, Lalai,,0,0,0,,Tidak, bukan.
Dialog: 0,0:53:11.47,0:53:15.00, Lalai,,0,0,0,,Apa pendapat anda? Saya memakai\Nini untuk perasmian Pengerusi saya.
Dialog: 0,0:53:16.24,0:53:17.68, Lalai,,0,0,0,,Perasmian.
Dialog: 0,0:53:19.57,0:53:21.38, Lalai,,0,0,0,, Perlukah saya katakan apa-apa?
Dialog: 0,0:53:21.40,0:53:23.46, Lalai,,0,0,0,,Ia sangat sesuai dengan anda.
Dialog: 0,0:53:23.49,0:53:24.71,Lalai,,0,0,0,,Bukan?
Dialog: 0,0:53:24.74,0:53:27.32, Lalai,,0,0,0,,Saya sepatutnya menemui tempat saya lebih awal.
Dialog: 0,0:53:32.33,0:53:33.56, Lalai,,0,0,0,,Hubungi bank.
Dialog: 0,0:53:33.58,0:53:34.62,Lalai,,0,0,0,,Suruh mereka menggandakan...
Dialog: 0,0:53:34.64,0:53:37.42,Lalai,,0,0,0,,urus niaga sebelumnya dan\Njadikannya 4.2% mengikut budi bicara yang teliti.
Dialog: 0,0:53:37.44,0:53:38.44, Lalai,,0,0,0,,Semua serentak?
Dialog: 0,0:53:38.46,0:53:41.63, Lalai,,0,0,0,,Saya tiada masa. Saya perlu\Nmembeli seberapa banyak stok yang saya boleh,
Dialog: 0,0:53:41.71,0:53:44.50,Lalai,,0,0,0,,jadi mereka tidak akan dapat menghalau saya.
Dialog: 0,0:53:44.80,0:53:46.50,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:53:46.59,0:53:49.16, Lalai,,0,0,0,,Dia membeli 4.2% sekali gus.
Dialog: 0,0:53:49.18,0:53:50.20,Lalai,,0,0,0,,Dia mesti tergesa-gesa.
Dialog: 0,0:53:50.22,0:53:52.87, Lalai,,0,0,0,,Sudah tentu. Dia akhirnya\Nmenghabiskan dana rahsia.
Dialog: 0,0:53:52.89,0:53:56.45, Lalai,,0,0,0,,Adakah kami telah menemui fail yang sepatutnya diserahkan oleh Encik Pyeon\N?
Dialog: 0,0:53:56.48,0:53:57.87, Lalai,,0,0,0,,Tidak, tuan.
Dialog: 0,0:53:57.90,0:54:00.21, Lalai,,0,0,0,,Walau bagaimanapun, saya menerima sesuatu yang lain.
Dialog: 0,0:54:00.23,0:54:02.67, Lalai,,0,0,0,,Ini akan membuktikan Eun-sung dan anak buahnya...
Dialog: 0,0:54:02.69,0:54:06.01, Lalai,,0,0,0,,menjalankan pelaburan $2 bilion\Npenipuan untuk mengambil alih Queens.
Dialog: 0,0:54:06.03,0:54:08.44, Lalai,,0,0,0,,Kebaikan. Siapa yang memberikannya kepada anda?
Dialog: 0,0:54:20.46,0:54:22.29,Lalai,,0,0,0,,Adakah anda membawanya?
Dialog: 0,0:54:27.97,0:54:29.61,Lalai,,0,0,0,,Itulah wang dari A.S.
Dialog: 0,0:54:29.64,0:54:31.24, Lalai,,0,0,0,,- Itu sahaja.\N- Sial.
Dialog: 0,0:54:31.26,0:54:33.12, Lalai,,0,0,0,,- Jom, sekarang.\N- Apa maksud awak?
Dialog: 0,0:54:33.14,0:54:36.43,Lalai,,0,0,0,,Saya beri awak semua wang\NI dapat daripada Seul-hee. Itu sahaja.
Dialog: 0,0:54:37.52,0:54:39.75, Lalai,,0,0,0,,Dan wang yang anda berikan kepada keluarga Hong?
Dialog: 0,0:54:39.77,0:54:42.01, Lalai,,0,0,0,,Itu kepunyaan mereka.
Dialog: 0,0:54:45.40,0:54:46.59, Lalai,,0,0,0,,Dan batang USB?
Dialog: 0,0:54:46.61,0:54:49.17, Lalai,,0,0,0,, Da-hye yang memberikannya kepada kamu?
Dialog: 0,0:54:49.20,0:54:50.26, Lalai,,0,0,0,,Ya.
Dialog: 0,0:54:50.28,0:54:51.43,Lalai,,0,0,0,,{\i1}Saya beritahu awak.{\i0}
Dialog: 0,0:54:51.45,0:54:53.18, Lalai,,0,0,0,,Itu talian hayat saya, jadi saya menyembunyikannya.
Dialog: 0,0:54:53.20,0:54:54.94, Lalai,,0,0,0,, Talian hayat anda?
Dialog: 0,0:54:55.04,0:54:57.35, Lalai,,0,0,0,,Aduh, bodoh betul.
Dialog: 0,0:54:57.37,0:55:00.39, Lalai,,0,0,0,,Itulah sebabnya kamu akan mati.
Dialog: 0,0:55:00.42,0:55:03.15,Lalai,,0,0,0,,- Apa?\N- Cikgu Moh sudah muak dengan kamu.
Dialog: 0,0:55:03.17,0:55:05.52,Lalai,,0,0,0,,Saya memuja awak, jadi saya bersikap tenang pada awak.
Dialog: 0,0:55:05.55,0:55:10.67,Lalai,,0,0,0,,Saya pasti anda tahu dia membenci gadis comel.
Dialog: 0,0:55:11.93,0:55:13.16, Lalai,,0,0,0,,Tetap diam.
Dialog: 0,0:55:13.18,0:55:14.99, Lalai,,0,0,0,,Saya suruh awak diam.
Dialog: 0,0:55:15.02,0:55:17.17, Lalai,,0,0,0,,- Buka!\N- Tetap diam!
Dialog: 0,0:55:22.73,0:55:23.73, Lalai,,0,0,0,,Bodoh itu.
Dialog: 0,0:55:23.76,0:55:25.19,Lalai,,0,0,0,,- Hei, pijak gas.\N- Buka!
Dialog: 0,0:55:25.22,0:55:26.21, Lalai,,0,0,0,,Tetap diam.
Dialog: 0,0:55:26.23,0:55:27.34, Lalai,,0,0,0,,Diam!
Dialog: 0,0:55:27.36,0:55:28.94, Lalai,,0,0,0,,Hentikan kereta!
Dialog: 0,0:55:29.49,0:55:31.02, Lalai,,0,0,0,,Diam!
Dialog: 0,0:55:33.16,0:55:34.18, Lalai,,0,0,0,,Hentikan kereta!
Dialog: 0,0:55:34.20,0:55:36.11, Lalai,,0,0,0,,Lepaskan Da-hye!
Dialog: 0,0:55:38.66,0:55:40.14, Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:55:40.17,0:55:42.37, Lalai,,0,0,0,, Sial! Buka pintu!
Dialog: 0,0:55:57.22,0:55:58.88, Lalai,,0,0,0,, Sial.
Dialog: 0,0:56:16.45,0:56:18.28,Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:56:18.87,0:56:20.26,Lalai,,0,0,0,,Adakah dia tinggi pada sesuatu?
Dialog: 0,0:56:20.29,0:56:21.99, Lalai,,0,0,0,,Adakah dia?
Dialog: 0,0:56:24.67,0:56:25.85, Lalai,,0,0,0,,Beg kotoran!
Dialog: 0,0:56:25.88,0:56:27.77,Lalai,,0,0,0,,Saya suruh awak lepaskan dia!
Dialog: 0,0:56:27.80,0:56:29.27, Lalai,,0,0,0,,Tetap diam.
Dialog: 0,0:56:29.30,0:56:30.86, Lalai,,0,0,0,,Soo-cheol! Lari!
Dialog: 0,0:56:30.88,0:56:33.50, Lalai,,0,0,0,,Adakah anda mahu mati?
Dialog: 0,0:56:37.14,0:56:38.12, Lalai,,0,0,0,,Soo-cheol!
Dialog: 0,0:56:38.14,0:56:39.67, Lalai,,0,0,0,,Soo-cheol!
Dialog: 0,0:56:41.39,0:56:43.29, Lalai,,0,0,0,,- Oh, tidak!\N- Sial.
Dialog: 0,0:56:43.31,0:56:44.54,Lalai,,0,0,0,,En. Hong.
Dialog: 0,0:56:44.56,0:56:46.96, Lalai,,0,0,0,,Tinggalkan sementara saya masih bersikap baik.
Dialog: 0,0:56:46.98,0:56:48.52,Lalai,,0,0,0,,Okey?
Dialog: 0,0:56:49.98,0:56:52.69, Lalai,,0,0,0,,Berhenti dipukul, dan lari!
Dialog: 0,0:56:54.36,0:56:56.63, Lalai,,0,0,0,,Kenapa anda cuba menjadi hero?
Dialog: 0,0:56:56.66,0:56:58.98, Lalai,,0,0,0,,- Lari!\N- Tetap diam!
Dialog: 0,0:57:09.88,0:57:11.66, Lalai,,0,0,0,, Sial.
Dialog: 0,0:57:15.30,0:57:17.38, Lalai,,0,0,0,,Soo-cheol!
Dialog: 0,0:57:20.97,0:57:21.99, Lalai,,0,0,0,, Mati!
Dialog: 0,0:57:22.02,0:57:24.01, Lalai,,0,0,0,, Mati!
Dialog: 0,0:57:25.40,0:57:27.60, Lalai,,0,0,0,,- Mati!\N- Lari!
Dialog: 0,0:57:39.99,0:57:41.01, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Da-hye!{\c}{\i0}
Dialog: 0,0:57:41.04,0:57:42.05,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Geon-u!{\c}{\i0}
Dialog: 0,0:57:42.08,0:57:44.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika saya perlu melindungi\Nkeluarga saya pada masa hadapan,{\c}{\i0}
Dialog: 0,0:57:44.91,0:57:46.73, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi saya tidak boleh?{\c}{\i0}
Dialog: 0,0:57:46.75,0:57:49.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya takut.{\c}{\i0}
Dialog: 0,0:57:51.96,0:57:53.87, Lalai,,0,0,0,,Oh, kawan...
Dialog: 0,0:57:54.63,0:57:55.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Melebih-lebihkan,{\c}{\i0}
Dialog: 0,0:57:55.88,0:57:58.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}supaya mereka akan berasa angkuh dan berfikir,{\c}{\i0}
Dialog: 0,0:57:58.18,0:58:00.11, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}"Dia bukan tandingan saya."{\c}{\i0}
Dialog: 0,0:58:00.14,0:58:02.03, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}"Saya agak menang."{\c}{\i0}
Dialog: 0,0:58:02.06,0:58:03.74, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}"Saya sangat kuat."{\c}{\i0}
Dialog: 0,0:58:03.77,0:58:05.34, Lalai,,0,0,0,,Jom.
Dialog: 0,0:58:06.31,0:58:08.55, Lalai,,0,0,0,,- Darn it!\N- Astaga.
Dialog: 0,0:58:09.31,0:58:10.71, Lalai,,0,0,0,,Soo-cheol!
Dialog: 0,0:58:10.73,0:58:13.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda mesti menunggu sehingga mereka tidak berjaga-jaga,{\c}{\i0}
Dialog: 0,0:58:13.19,0:58:16.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kemudian mendarat pukulan kritikal anda.{\c}{\i0}
Dialog: 0,0:58:29.04,0:58:30.69, Lalai,,0,0,0,,Jom. Buang basikal.
Dialog: 0,0:58:30.71,0:58:32.37, Lalai,,0,0,0,,Singkirkan...
Dialog: 0,0:59:06.25,0:59:07.35, Lalai,,0,0,0,,Apa...?
Dialog: 0,0:59:07.37,0:59:09.28, Lalai,,0,0,0,,Apa itu?
Dialog: 0,0:59:11.88,0:59:13.23, Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:13.25,0:59:14.98,Lalai,,0,0,0,,Soo-cheol, buka mata awak.
Dialog: 0,0:59:15.00,0:59:16.91, Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:24.60,0:59:27.20, Lalai,,0,0,0,,Polis? Kami berada di jalan kereta api Yongdu-ri.
Dialog: 0,0:59:27.23,0:59:29.20,Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:29.23,0:59:31.05, Lalai,,0,0,0,,Bangun.
Dialog: 0,0:59:31.44,0:59:32.97, Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:34.19,0:59:35.93, Lalai,,0,0,0,,Adakah dia sudah mati?
Dialog: 0,0:59:38.15,0:59:39.81, Lalai,,0,0,0,, Soo-cheol.
Dialog: 0,0:59:39.86,0:59:41.69, Lalai,,0,0,0,, Soo-cheol.
Dialog: 0,0:59:42.41,0:59:44.07, Lalai,,0,0,0,,Tidak, Soo-cheol.
Dialog: 0,0:59:44.62,0:59:45.89, Lalai,,0,0,0,, Soo-cheol.
Dialog: 0,0:59:45.91,0:59:47.64, Lalai,,0,0,0,,Saya sayang awak. jangan pergi.
Dialog: 0,0:59:47.66,0:59:49.78, Lalai,,0,0,0,,Tidak, Soo-cheol.
Dialog: 0,0:59:49.83,0:59:51.37,Lalai,,0,0,0,,Soo-cheol...
Dialog: 0,0:59:55.88,0:59:57.41, Lalai,,0,0,0,,Saya juga.
Dialog: 0,1:00:00.17,1:00:02.50,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:00:06.39,1:00:08.84,Lalai,,0,0,0,,Mengapa anda berbuat demikian?
Dialog: 0,1:00:09.48,1:00:12.01,Lalai,,0,0,0,,Maafkan saya, Soo-cheol...
Dialog: 0,1:00:27.83,1:00:30.22,Lalai,,0,0,0,,Tunggu. Kenapa saya mengelak dari dia?
Dialog: 0,1:00:30.25,1:00:31.82,Lalai,,0,0,0,,Saya CEO.
Dialog: 0,1:00:32.58,1:00:34.78,Lalai,,0,0,0,,Alangkah kelakarnya.
Dialog: 0,1:00:35.00,1:00:38.33,Lalai,,0,0,0,,Siapa yang membenarkan dia kembali ke sini?
Dialog: 0,1:00:39.55,1:00:41.25,Lalai,,0,0,0,,Saya patut bertanya.
Dialog: 0,1:00:58.40,1:01:00.60,Lalai,,0,0,0,,Saya perlu bercakap dengan awak.
Dialog: 0,1:01:03.32,1:01:05.15,Lalai,,0,0,0,,Begitu juga.
Dialog: 0,1:01:05.62,1:01:07.36,Lalai,,0,0,0,,Anda telah dikembalikan?
Dialog: 0,1:01:07.45,1:01:08.43,Lalai,,0,0,0,,Ya.
Dialog: 0,1:01:08.45,1:01:10.36,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:01:10.66,1:01:11.76,Lalai,,0,0,0,,Adakah kerana saya?
Dialog: 0,1:01:11.79,1:01:13.99,Lalai,,0,0,0,,Ini tempat kerja saya.
Dialog: 0,1:01:14.08,1:01:15.43,Lalai,,0,0,0,,Anda boleh pergi ke tempat lain.
Dialog: 0,1:01:15.46,1:01:17.06,Lalai,,0,0,0,,Itu pilihan saya.
Dialog: 0,1:01:17.09,1:01:18.74,Lalai,,0,0,0,,Saya berasa tidak senang.
Dialog: 0,1:01:21.55,1:01:23.23,Lalai,,0,0,0,,Saya tidak selesa,
Dialog: 0,1:01:23.26,1:01:25.49,Lalai,,0,0,0,,jadi sila letak jawatan dan cari kerja baharu.
Dialog: 0,1:01:25.51,1:01:27.75,Lalai,,0,0,0,,Saya betul-betul tidak mahu...
Dialog: 0,1:01:28.51,1:01:30.80,Lalai,,0,0,0,,untuk berjumpa dengan anda.
Dialog: 0,1:01:33.06,1:01:35.18,Lalai,,0,0,0,,Ada apa dengan rupa itu?
Dialog: 0,1:01:35.52,1:01:38.00,Lalai,,0,0,0,,Anda meninggalkan saya tinggi dan kering.
Dialog: 0,1:01:38.02,1:01:41.63,Lalai,,0,0,0,,Adakah anda fikir anda boleh memikat\N saya sekarang sejak saya hilang ingatan?
Dialog: 0,1:01:41.65,1:01:43.56,Lalai,,0,0,0,,Adakah itu?
Dialog: 0,1:01:46.16,1:01:48.30,Lalai,,0,0,0,,Awak kata saya akan sentiasa menjadi jenis ideal awak,
Dialog: 0,1:01:48.32,1:01:49.72,Lalai,,0,0,0,,dan anda akan jatuh cinta kepada saya lagi.
Dialog: 0,1:01:49.74,1:01:52.07,Lalai,,0,0,0,,Anda begitu yakin,
Dialog: 0,1:01:52.75,1:01:55.78,Lalai,,0,0,0,,jadi saya fikir anda akan mengenali saya tidak lama lagi.
Dialog: 0,1:01:56.42,1:01:57.39,Lalai,,0,0,0,, Jatuh untuk awak?
Dialog: 0,1:01:57.42,1:01:58.60,Lalai,,0,0,0,,Tetapi tidak mengapa.
Dialog: 0,1:01:58.63,1:02:00.62,Lalai,,0,0,0,,Saya nampak ini akan datang.
Dialog: 0,1:02:02.21,1:02:05.65,Lalai,,0,0,0,,Anda lebih tidak tahu malu daripada yang saya sangka.
Dialog: 0,1:02:05.68,1:02:07.36,Lalai,,0,0,0,,Adakah keluarga saya menjanjikan sesuatu kepada anda?
Dialog: 0,1:02:07.39,1:02:08.56,Lalai,,0,0,0,,Mengapa kamu berusaha keras?
Dialog: 0,1:02:08.58,1:02:10.20,Lalai,,0,0,0,,- Hae-in...\N- Jangan sebut nama saya.
Dialog: 0,1:02:10.22,1:02:11.91,Lalai,,0,0,0,,Saya mungkin mudah jatuh...
Dialog: 0,1:02:11.93,1:02:14.54,Lalai,,0,0,0,,untuk tatapan dan suara anda pada masa lalu,
Dialog: 0,1:02:14.56,1:02:16.09,Lalai,,0,0,0,,tetapi tidak lagi.
Dialog: 0,1:02:16.73,1:02:18.85,Lalai,,0,0,0,,Saya tidak mahu berjumpa dengan awak lagi.
Dialog: 0,1:02:26.20,1:02:28.15,Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:02:28.45,1:02:30.65,Lalai,,0,0,0,,Jangan lakukan ini.
Dialog: 0,1:02:35.29,1:02:37.02,Lalai,,0,0,0,,- Tidak...\N- Saya tidak mahu mendengarnya.
Dialog: 0,1:02:37.04,1:02:39.41,Lalai,,0,0,0,,Jangan pegang saya.
Dialog: 0,1:02:41.38,1:02:43.12,Lalai,,0,0,0,,Lepaskan saya.
Dialog: 0,1:03:28.76,1:03:30.38,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pusat Perubatan Grünwald Pengirim{\c}{\i0}
Dialog: 0,1:03:36.22,1:03:38.22,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:03:41.73,1:03:45.06,Lalai,,0,0,0,,Hei, ini saya. Rahmat.
Dialog: 0,1:03:45.32,1:03:49.14,Lalai,,0,0,0,,Kebaikan. Anda benar-benar tidak ingat apa-apa.
Dialog: 0,1:03:50.99,1:03:52.80,Lalai,,0,0,0,,Saya adalah orang kegemaran anda...
Dialog: 0,1:03:52.82,1:03:55.94,Lalai,,0,0,0,,yang paling anda percayai.
Dialog: 0,1:04:01.04,1:04:02.39,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:04:02.42,1:04:04.10,Lalai,,0,0,0,,Maaf.
Dialog: 0,1:04:04.13,1:04:07.73,Lalai,,0,0,0,,Saya rasa kami tidak cukup rapat\Nuntuk bercakap santai dan berpelukan antara satu sama lain.
Dialog: 0,1:04:07.76,1:04:09.19,Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,1:04:09.22,1:04:11.63,Lalai,,0,0,0,,- Ini saya.\N- Maafkan saya.
Dialog: 0,1:04:15.39,1:04:17.17,Lalai,,0,0,0,,Bagaimana dia tahu?
Dialog: 0,1:04:18.31,1:04:19.41,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:04:19.43,1:04:21.12,Lalai,,0,0,0,,Jika firasatnya begitu tepat,
Dialog: 0,1:04:21.14,1:04:24.14,Lalai,,0,0,0,,kenapa dia masih membiarkan Eun-sung memperdayakannya?
Dialog: 0,1:04:35.58,1:04:37.13,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda mempunyai mel{\c}{\i0}
Dialog: 0,1:04:37.91,1:04:39.05,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:04:39.08,1:04:41.47,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Penghantar Aqua: Hong Hae-in{\c}{\i0}
Dialog: 0,1:04:41.50,1:04:43.41,Lalai,,0,0,0,,Ini daripada saya?
Dialog: 0,1:04:44.33,1:04:48.25,Lalai,,0,0,0,,Saya hantar sendiri jemputan?
Dialog: 0,1:04:56.89,1:04:59.17,Lalai,,0,0,0,,Anda boleh masuk.
Dialog: 0,1:04:59.56,1:05:01.09,Lalai,,0,0,0,,Okey.
Dialog: 0,1:05:04.73,1:05:06.85,Lalai,,0,0,0,,Dia masuk sekarang.
Dialog: 0,1:05:10.61,1:05:13.35,Lalai,,0,0,0,,Kenapa tempat besar ini kosong?
Dialog: 0,1:05:52.99,1:05:54.38,Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,1:05:54.40,1:05:56.40,Lalai,,0,0,0,,Saya ingin bertanya kepada anda.
Dialog: 0,1:06:00.95,1:06:03.49,Lalai,,0,0,0,,Anda telah menghantar jemputan kepada saya.
Dialog: 0,1:06:19.60,1:06:20.99,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kami akan memulakan perkahwinan...{\c}{\i0}
Dialog: 0,1:06:21.01,1:06:22.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&} Hong Hae-in, pengantin perempuan,{\c}{\i0}
Dialog: 0,1:06:22.77,1:06:26.29,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan Baek Hyun-woo, pengantin lelaki.{\c}{\i0}
Dialog: 0,1:06:26.31,1:06:28.14,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Inilah pengantin lelaki.{\c}{\i0}
Dialog: 0,1:07:27.62,1:07:29.36,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Nah...{\c}{\i0}
Dialog: 0,1:07:30.33,1:07:33.20,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa khabar, Hyun-woo dari masa depan?{\c}{\i0}
Dialog: 0,1:07:33.59,1:07:35.69,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan beritahu saya anda telah bercerai.{\c}{\i0}
Dialog: 0,1:07:35.71,1:07:37.57,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Adakah anda mempunyai anak?{\c}{\i0}
Dialog: 0,1:07:37.59,1:07:38.82,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Satu? Dua?{\c}{\i0}
Dialog: 0,1:07:38.84,1:07:41.15,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Namun, tidak mengapa,{\c}{\i0}
Dialog: 0,1:07:41.18,1:07:44.76,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}kerana yang saya perlukan hanyalah Hae-in.{\c}{\i0}
Dialog: 0,1:07:45.01,1:07:46.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan buat dia menangis.{\c}{\i0}
Dialog: 0,1:07:47.10,1:07:48.88,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Buat dia gembira.{\c}{\i0}
Dialog: 0,1:07:53.23,1:07:55.04,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in yang dihormati dari masa hadapan.{\c}{\i0}
Dialog: 0,1:07:55.07,1:07:58.63,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya ragu anda akan menonton, tetapi jika anda menonton,{\c}{\i0}
Dialog: 0,1:07:58.65,1:07:59.92,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}kenapa awak?{\c}{\i0}
Dialog: 0,1:07:59.95,1:08:01.88,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan ini dan mulakan kerja.{\c}{\i0}
Dialog: 0,1:08:01.91,1:08:04.22,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak akan bertanya khabar anda, kerana saya tahu...{\c}{\i0}
Dialog: 0,1:08:04.24,1:08:05.64,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}anda akan baik-baik saja.{\c}{\i0}
Dialog: 0,1:08:05.66,1:08:07.76,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda akan sama cantik, sihat,{\c}{\i0}
Dialog: 0,1:08:07.79,1:08:10.36,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan yang paling berjaya.{\c}{\i0}
Dialog: 0,1:08:10.58,1:08:11.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dengan Hyun-woo...{\c}{\i0}
Dialog: 0,1:08:11.83,1:08:14.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dengan anda, sudah tentu.{\c}{\i0}
Dialog: 0,1:08:31.10,1:08:32.75,Lalai,,0,0,0,,En. Baek Hyun-woo?
Dialog: 0,1:08:32.77,1:08:34.30,Lalai,,0,0,0,,Ya.
Dialog: 0,1:08:35.36,1:08:39.77,Lalai,,0,0,0,,Pn. Hong menyewakan seluruh\Naquarium dan menghantar bunga ini kepada anda.
Dialog: 0,1:08:40.61,1:08:42.19,Lalai,,0,0,0,,Saya menyewakan...
Dialog: 0,1:08:42.24,1:08:44.34,Lalai,,0,0,0,,akuarium ini?
Dialog: 0,1:08:44.43,1:08:45.43,Lalai,,0,0,0,,Bila?
Dialog: 0,1:08:45.45,1:08:46.43,Lalai,,0,0,0,,Kira-kira sebulan yang lalu,
Dialog: 0,1:08:46.45,1:08:48.61,Lalai,,0,0,0,,dan empat tahun lalu juga.
Dialog: 0,1:08:49.41,1:08:50.95,Lalai,,0,0,0,,Nah, kalau begitu...
Dialog: 0,1:08:52.08,1:08:54.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka kata ini tempat temu janji terbaik,{\c}{\i0}
Dialog: 0,1:08:54.58,1:08:56.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi mengapa ia begitu kosong?{\c}{\i0}
Dialog: 0,1:08:57.17,1:08:59.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik. Hong, hari ini...{\c}{\i0}
Dialog: 0,1:08:59.92,1:09:02.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}rasanya seperti seluruh alam semesta...{\c}{\i0}
Dialog: 0,1:09:02.76,1:09:05.63,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}berpihak kepada kami.{\c}{\i0}
Dialog: 0,1:09:07.85,1:09:09.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda betul.{\c}{\i0}
Dialog: 0,1:09:12.23,1:09:13.93,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:09:14.90,1:09:17.58,Lalai,,0,0,0,,Itu bukan alam semesta.
Dialog: 0,1:09:17.61,1:09:19.42,Lalai,,0,0,0,,Itu awak.
Dialog: 0,1:09:19.44,1:09:20.75,Lalai,,0,0,0,,Saya tidak pernah tahu.
Dialog: 0,1:09:20.78,1:09:24.19,Lalai,,0,0,0,,Saya tidak tahu tentang apa ini\Nis, tetapi saya akan pergi.
Dialog: 0,1:09:35.29,1:09:36.27,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo.{\c}{\i0}
Dialog: 0,1:09:36.29,1:09:37.89,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan cuba melangkau perkahwinan...{\c}{\i0}
Dialog: 0,1:09:37.92,1:09:40.65,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}hanya kerana saya hilang ingatan.{\c}{\i0}
Dialog: 0,1:09:40.67,1:09:43.73,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Memandangkan saya hilang ingatan, saya mungkin\Nas memakai gaun pengantin sekali lagi.{\c}{\i0}
Dialog: 0,1:09:43.76,1:09:45.32,Lalai,,0,0,0,,Adakah saya menulis ini?
Dialog: 0,1:09:45.34,1:09:46.36,Lalai,,0,0,0,,Itu tidak boleh.
Dialog: 0,1:09:46.39,1:09:49.74,Lalai,,0,0,0,,Adakah saya benar-benar ingin berkahwin semula\Nlelaki yang mempunyai hubungan sulit...
Dialog: 0,1:09:49.76,1:09:51.97,Lalai,,0,0,0,,di belakang saya?
Dialog: 0,1:09:52.23,1:09:53.20,Lalai,,0,0,0,,Tidak boleh.
Dialog: 0,1:09:53.23,1:09:55.18,Lalai,,0,0,0,,Anda betul.
Dialog: 0,1:09:55.27,1:09:57.14,Lalai,,0,0,0,,Anda tidak akan melakukannya.
Dialog: 0,1:10:00.69,1:10:03.06,Lalai,,0,0,0,,Anda tidak akan melakukan ini...
Dialog: 0,1:10:03.82,1:10:05.98,Lalai,,0,0,0,,jika saya benar-benar menipu awak,
Dialog: 0,1:10:06.95,1:10:09.18,Lalai,,0,0,0,,jadi mulalah ragu-ragu.
Dialog: 0,1:10:09.20,1:10:11.34,Lalai,,0,0,0,,Anda tidak perlu percaya saya,
Dialog: 0,1:10:11.37,1:10:13.56,Lalai,,0,0,0,,tapi jangan percaya Eun-sung pun.
Dialog: 0,1:10:13.58,1:10:16.70,Lalai,,0,0,0,,Jangan percaya sesiapa. Ragu segalanya.
Dialog: 0,1:10:17.79,1:10:19.49,Lalai,,0,0,0,,Eun-sung...
Dialog: 0,1:10:19.54,1:10:21.79,Lalai,,0,0,0,,tidak pernah melindungi anda.
Dialog: 0,1:10:22.92,1:10:27.50,Lalai,,0,0,0,,Dia telah mengasingkan awak daripada keluarga awak dan saya.
Dialog: 0,1:10:34.56,1:10:37.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Syukurlah kami tiada di dalam kereta,{\c}{\i0}
Dialog: 0,1:10:37.02,1:10:40.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi saya sangka anda,{\c}{\i0}
Dialog: 0,1:10:40.15,1:10:43.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi saya sakit tangan saya cuba memecahkan tingkap.{\c}{\i0}
Dialog: 0,1:11:26.53,1:11:28.40,Lalai,,0,0,0,,Ada sesuatu yang salah?
Dialog: 0,1:11:30.66,1:11:32.44,Lalai,,0,0,0,,Ini bagus.
Dialog: 0,1:11:35.12,1:11:38.36,Lalai,,0,0,0,,Awak risaukan saya.
Dialog: 0,1:11:38.96,1:11:41.28,Lalai,,0,0,0,,Saya ada soalan.
Dialog: 0,1:11:41.63,1:11:43.49,Lalai,,0,0,0,,Pegang pemikiran itu.
Dialog: 0,1:11:44.42,1:11:48.11,Lalai,,0,0,0,,Saya akan mempunyai\Nglass yang lain. Adakah anda mahukan satu?
Dialog: 0,1:11:48.13,1:11:49.96,Lalai,,0,0,0,,Saya okay.
Dialog: 0,1:11:59.85,1:12:01.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda mempunyai rakaman yang belum dibuka\NTonton sekarang{\c}{\i0}
Dialog: 0,1:12:12.16,1:12:13.13,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kamera Amanah{\c}{\i0}
Dialog: 0,1:12:53.82,1:12:55.36,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:12:56.74,1:12:58.51,Lalai,,0,0,0,, Patutkah kita pergi ke A.S.?
Dialog: 0,1:12:58.54,1:13:00.22,Lalai,,0,0,0,,- Apa?\N- Kami berdua...
Dialog: 0,1:13:00.25,1:13:02.43,Lalai,,0,0,0,,telah ditinggalkan oleh keluarga kami,
Dialog: 0,1:13:02.46,1:13:04.35,Lalai,,0,0,0,,jadi...
Dialog: 0,1:13:04.38,1:13:06.41,Lalai,,0,0,0,,mari...
Dialog: 0,1:13:08.25,1:13:09.95,Lalai,,0,0,0,,keluar.
Dialog: 0,1:13:10.34,1:13:13.58,Lalai,,0,0,0,,Kita boleh hidup bahagia di sana.
Dialog: 0,1:13:16.80,1:13:18.96,Lalai,,0,0,0,,Adakah anda pasti saya telah ditinggalkan?
Dialog: 0,1:13:19.77,1:13:21.30,Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,1:13:23.23,1:13:25.14,Lalai,,0,0,0,,Adakah anda fikir saya berbohong?
Dialog: 0,1:13:28.90,1:13:30.77,Lalai,,0,0,0,,Bukan sebab itu.
Dialog: 0,1:13:31.24,1:13:32.98,Lalai,,0,0,0,,Jom bincang lagi...
Dialog: 0,1:13:33.03,1:13:35.27,Lalai,,0,0,0,,apabila anda sedar.
Dialog: 0,1:13:40.74,1:13:43.45,Lalai,,0,0,0,,Anda ada soalan untuk saya.
Dialog: 0,1:13:50.46,1:13:53.00,Lalai,,0,0,0,,Saya rasa saya tidak perlu bertanya.
Dialog: 0,1:13:55.30,1:13:57.13,Lalai,,0,0,0,,Bye.
Dialog: 0,1:14:14.82,1:14:16.92,Lalai,,0,0,0,,Setiausaha Na, ini saya.
Dialog: 0,1:14:16.95,1:14:19.43,Lalai,,0,0,0,,Saya kehilangan telefon lama saya,
Dialog: 0,1:14:19.45,1:14:20.98,Lalai,,0,0,0,,jadi...
Dialog: 0,1:14:21.12,1:14:23.32,Lalai,,0,0,0,,bolehkah anda memberi saya...
Dialog: 0,1:14:24.16,1:14:26.16,Lalai,,0,0,0,,En. Nombor Baek?
Dialog: 0,1:14:27.12,1:14:29.49,Lalai,,0,0,0,,Ya, hantarkan mesej kepada saya.
Dialog: 0,1:14:49.61,1:14:53.65,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Setiausaha Na\NHIni nombor Pengarah Baek{\c}{\i0}
Dialog: 0,1:14:57.86,1:15:02.37,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pengarah Baek{\c}{\i0}
Dialog: 0,1:15:10.08,1:15:11.62,Lalai,,0,0,0,,En. Baek?
Dialog: 0,1:15:11.67,1:15:13.27,Lalai,,0,0,0,,Ini saya, Hong Hae-in.
Dialog: 0,1:15:13.30,1:15:16.41,Lalai,,0,0,0,,Saya perlu bercakap dengan awak.
Dialog: 0,1:15:17.34,1:15:19.00,Lalai,,0,0,0,,Di manakah anda?
Dialog: 0,1:15:21.85,1:15:24.92,Lalai,,0,0,0,,Baiklah, saya akan ke sana tidak lama lagi.
Dialog: 0,1:15:42.74,1:15:43.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Penerima Hae-in Hong{\c}{\i0}
Dialog: 0,1:16:33.83,1:16:35.49,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kepada Baek Hyun-woo.{\c}{\i0}
Dialog: 0,1:16:35.75,1:16:39.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Anda mungkin akan membaca\Nini semasa saya menjalani pembedahan.{\c}{\i0}
Dialog: 0,1:16:39.88,1:16:41.44,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika saya gagal...{\c}{\i0}
Dialog: 0,1:16:41.47,1:16:43.82,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}untuk bangun,{\c}{\i0}
Dialog: 0,1:16:43.84,1:16:46.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}maka ini mungkin kehendak saya.{\c}{\i0}
Dialog: 0,1:16:47.31,1:16:50.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak akan meminta anda meratapi saya\Nselama tiga tahun seperti masa lalu,{\c}{\i0}
Dialog: 0,1:16:50.85,1:16:53.96,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}tetapi saya ingin anda merindui saya...{\c}{\i0}
Dialog: 0,1:16:53.98,1:16:56.33,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}sepanjang empat musim,{\c}{\i0}
Dialog: 0,1:16:56.36,1:16:58.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan panggil saya apabila anda mabuk,{\c}{\i0}
Dialog: 0,1:16:59.15,1:17:01.48,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}tetapi selepas itu,{\c}{\i0}
Dialog: 0,1:17:01.95,1:17:04.65,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}lupakan saya dan jalani hidup anda.{\c}{\i0}
Dialog: 0,1:17:06.28,1:17:08.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jatuh cinta dengan penuh semangat, berkahwin,{\c}{\i0}
Dialog: 0,1:17:08.95,1:17:11.36,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan mempunyai keluarga sendiri.{\c}{\i0}
Dialog: 0,1:17:11.79,1:17:13.91,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya berjanji tidak akan cemburu.{\c}{\i0}
Dialog: 0,1:17:18.05,1:17:20.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sudah cemburu.{\c}{\i0}
Dialog: 0,1:17:23.30,1:17:24.94,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagi aset saya,{\c}{\i0}
Dialog: 0,1:17:24.97,1:17:27.92,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}belanjakan mengikut cara yang anda rasa sesuai.{\c}{\i0}
Dialog: 0,1:17:28.72,1:17:31.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Berfikir saya mungkin mati...{\c}{\i0}
Dialog: 0,1:17:31.10,1:17:33.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}membuat saya tergesa-gesa.{\c}{\i0}
Dialog: 0,1:17:33.52,1:17:36.29,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bolehkah saya pergi ke syurga jika saya tergesa-gesa\N ada beberapa perbuatan baik?{\c}{\i0}
Dialog: 0,1:17:36.31,1:17:39.43,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dengan cara itu saya boleh berjumpa dengan kamu lagi.{\c}{\i0}
Dialog: 0,1:17:40.48,1:17:42.38,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hanya memikirkan perkara ini...{\c}{\i0}
Dialog: 0,1:17:42.40,1:17:44.40,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}membuat saya sedih,{\c}{\i0}
Dialog: 0,1:17:45.07,1:17:46.77,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}tetapi...{\c}{\i0}
Dialog: 0,1:17:47.87,1:17:50.72,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}bagaimana jika pembedahan itu berjaya,{\c}{\i0}
Dialog: 0,1:17:50.74,1:17:53.61,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}tetapi saya lupa siapa awak?{\c}{\i0}
Dialog: 0,1:17:54.67,1:17:57.20,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana jika saya melayan kamu seperti orang asing?{\c}{\i0}
Dialog: 0,1:17:59.25,1:18:00.90,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Atau lebih teruk lagi,{\c}{\i0}
Dialog: 0,1:18:00.92,1:18:03.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}bagaimana jika saya menganiaya kamu?{\c}{\i0}
Dialog: 0,1:18:04.05,1:18:07.63,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana jika anda tidak boleh menerimanya\Nanymore, dan muak dengan saya?{\c}{\i0}
Dialog: 0,1:18:07.84,1:18:09.96,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa yang perlu saya lakukan kemudian?{\c}{\i0}
Dialog: 0,1:18:10.68,1:18:12.53,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Walaupun itu berlaku,{\c}{\i0}
Dialog: 0,1:18:12.56,1:18:14.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jangan muak dengan saya.{\c}{\i0}
Dialog: 0,1:18:15.77,1:18:17.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan kepenatan.{\c}{\i0}
Dialog: 0,1:18:17.85,1:18:19.76,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Teruskan mencintai saya.{\c}{\i0}
Dialog: 0,1:18:22.53,1:18:24.34,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jenis ideal saya tidak akan berubah,{\c}{\i0}
Dialog: 0,1:18:24.36,1:18:27.27,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi saya akan jatuh cinta kepada anda sekali lagi.{\c}{\i0}
Dialog: 0,1:18:27.53,1:18:29.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda kata saya akan sentiasa menjadi jenis ideal anda,{\c}{\i0}
Dialog: 0,1:18:29.32,1:18:30.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan anda akan jatuh cinta kepada saya lagi.{\c}{\i0}
Dialog: 0,1:18:30.74,1:18:32.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda begitu yakin,{\c}{\i0}
Dialog: 0,1:18:32.24,1:18:35.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi saya fikir anda akan mengenali saya tidak lama lagi.{\c}{\i0}
Dialog: 0,1:18:36.37,1:18:38.53,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Sila bersabar sehingga itu.{\c}{\i0}
Dialog: 0,1:18:38.79,1:18:41.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kami tidak akan berjumpa lagi.{\c}{\i0}
Dialog: 0,1:18:41.17,1:18:43.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kita jumpa lagi,{\c}{\i0}
Dialog: 0,1:18:44.30,1:18:46.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kerana saya tidak akan berputus asa.{\c}{\i0}
Dialog: 0,1:18:47.05,1:18:49.50,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan tetap dengan anda.{\c}{\i0}
Dialog: 0,1:18:52.22,1:18:55.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apabila akhirnya saya ingat awak,{\c}{\i0}
Dialog: 0,1:18:57.44,1:18:59.47,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jom kahwin lagi.{\c}{\i0}
Dialog: 0,1:19:12.49,1:19:14.19,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dan Hong Hae-in,{\c}{\i0}
Dialog: 0,1:19:14.41,1:19:16.14,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jika anda membaca ini,{\c}{\i0}
Dialog: 0,1:19:16.16,1:19:21.16,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}ini mesti bermakna pembedahan itu berjaya\Nan anda tidak ingat apa-apa,{\c}{\i0}
Dialog: 0,1:19:21.96,1:19:25.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi izinkan saya memperkenalkannya kepada anda.{\c}{\i0}
Dialog: 0,1:19:27.84,1:19:32.67,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo boleh membetulkan apa sahaja,{\c}{\i0}
Dialog: 0,1:19:33.43,1:19:35.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini ialah dulang. Anda hanya perlu menariknya.{\c}{\i0}
Dialog: 0,1:19:35.60,1:19:37.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- ...tetapi dia banyak mengomel.{\c}{\i0}\N{\i1}{\c&HFFFF00&}- Cik Hong.{}\c
Dialog: 0,1:19:37.10,1:19:40.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Alih keluar kertas jika tertera ia tersekat.{\c}{\i0}
Dialog: 0,1:19:40.48,1:19:41.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda menendangnya?{\c}{\i0}
Dialog: 0,1:19:41.90,1:19:43.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kerana kertas tersekat.{\c}{\i0}
Dialog: 0,1:19:43.69,1:19:46.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sedang melakukan manuver Heimlich.{\c}{\i0}
Dialog: 0,1:19:46.40,1:19:48.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tolong jangan tendangnya.{\c}{\i0}
Dialog: 0,1:19:49.20,1:19:51.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cuma minta bantuan saya.{\c}{\i0}
Dialog: 0,1:19:56.08,1:19:57.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidakkah kaki anda sakit?{\c}{\i0}
Dialog: 0,1:19:57.83,1:19:59.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nah...{\c}{\i0}
Dialog: 0,1:20:00.08,1:20:02.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sikit sahaja.{\c}{\i0}
Dialog: 0,1:20:06.76,1:20:09.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Perlukah saya melihatnya?{\c}{\i0}
Dialog: 0,1:20:20.77,1:20:22.58,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia mudah diperdaya.{\c}{\i0}
Dialog: 0,1:20:22.60,1:20:24.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}En. Baek, adakah anda tahu?{\c}{\i0}
Dialog: 0,1:20:24.40,1:20:28.09,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Rakun tinggal di taman atas bumbung kami.{\c}{\i0}
Dialog: 0,1:20:28.11,1:20:29.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nama dia Yeong-suk.{\c}{\i0}
Dialog: 0,1:20:29.61,1:20:31.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Yeong-suk.{\c}{\i0}
Dialog: 0,1:20:32.41,1:20:35.43,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia boleh menjadi sangat comel apabila\Ndia mabuk, jadi berhati-hati.{\c}{\i0}
Dialog: 0,1:20:35.45,1:20:37.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya yang minum bukan dia.{\c}{\i0}
Dialog: 0,1:20:37.79,1:20:40.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah saya membuat anda tidak selesa di sana?{\c}{\i0}
Dialog: 0,1:20:46.75,1:20:49.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya fikir awak sudah mati.{\c}{\i0}
Dialog: 0,1:20:49.34,1:20:51.25,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia menarik hati anda apabila dia menangis,{\c}{\i0}
Dialog: 0,1:20:51.28,1:20:53.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi jangan buat dia menangis.{\c}{\i0}
Dialog: 0,1:20:53.55,1:20:55.66,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia sangat seksi dengan lengan bajunya ke atas,{\c}{\i0}
Dialog: 0,1:20:55.68,1:20:58.09,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi tutup dia.{\c}{\i0}
Dialog: 0,1:21:00.18,1:21:02.54,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika anda masih keliru,{\c}{\i0}
Dialog: 0,1:21:02.56,1:21:04.26,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}ingat ini sahaja.{\c}{\i0}
Dialog: 0,1:21:04.90,1:21:06.89,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dialah sebabnya...{\c}{\i0}
Dialog: 0,1:21:07.52,1:21:10.85,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak mahu hilang ingatan,{\c}{\i0}
Dialog: 0,1:21:11.03,1:21:13.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan walaupun saya melakukannya,{\c}{\i0}
Dialog: 0,1:21:13.07,1:21:16.36,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dialah sebab saya mahu hidup.{\c}{\i0}
Dialog: 0,1:21:18.29,1:21:21.65,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo ialah orangnya...{\c}{\i0}
Dialog: 0,1:21:22.54,1:21:25.07,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya mahu ingat selama-lamanya.{\c}{\i0}
Dialog: 0,1:21:35.76,1:21:39.46,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sangat gembira kerana dia bersama saya.{\c}{\i0}
Dialog: 0,1:21:41.22,1:21:43.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya sangat berdoa...{\c}{\i0}
Dialog: 0,1:21:43.85,1:21:46.18,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}bahawa dia akan tetap bersama anda...{\c}{\i0}
Dialog: 0,1:21:46.98,1:21:48.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}juga.{\c}{\i0}
Dialog: 0,1:21:51.15,1:21:53.06,Lalai,,0,0,0,,Maafkan saya, Hyun-woo.
Dialog: 0,1:21:54.70,1:21:56.61,Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,1:22:14.34,1:22:16.59,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in{\c}{\i0}
Dialog: 0,1:22:34.65,1:22:36.17,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:22:36.20,1:22:38.61,Lalai,,0,0,0,,Kekal di sana! Saya akan datang kepada anda!
Dialog: 0,1:23:11.27,1:23:12.97,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,1:23:14.44,1:23:16.56,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:24:15.55,1:24:19.50,Lalai,,0,0,0,,Saya mengikuti Encik Yoon dan Cik Hong di Jerman.
Dialog: 0,1:24:24.39,1:24:28.88,Lalai,,0,0,0,,{\i1}Pertama sekali, dia menjaganya dengan tekun.{\i0}
Dialog: 0,1:24:38.44,1:24:40.30,Lalai,,0,0,0,,Bolehkah kami masuk ke dalam jika anda kesejukan?
Dialog: 0,1:24:40.32,1:24:41.34,Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,1:24:41.36,1:24:44.18,Lalai,,0,0,0,,{\i1}Mereka boleh dengan mudah melepasi\Nas perlawanan yang dibuat di syurga,{\i0}
Dialog: 0,1:24:44.20,1:24:47.53,Lalai,,0,0,0,,tetapi mereka tidak dapat menipu mata saya yang tajam.
Dialog: 0,1:24:52.37,1:24:54.62,Lalai,,0,0,0,,Tidak mengapa. biar saya.
Dialog: 0,1:24:56.29,1:24:58.16,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:24:58.80,1:25:00.46,Lalai,,0,0,0,,Tidak mengapa. biar saya.
Dialog: 0,1:25:06.89,1:25:09.37,Lalai,,0,0,0,,Tidak mengapa. Saya boleh berjalan sendiri.
Dialog: 0,1:25:09.39,1:25:11.91,Lalai,,0,0,0,,{\i1}Seorang wanita tidak pernah menolak bantuan lelaki...{\i0}
Dialog: 0,1:25:11.94,1:25:14.46,Lalai,,0,0,0,,jika dia ada perasaan terhadap lelaki itu.
Dialog: 0,1:25:14.48,1:25:15.83,Lalai,,0,0,0,,Dia cuba melibatkan dia,
Dialog: 0,1:25:15.86,1:25:17.92,Lalai,,0,0,0,,tetapi Cik Hong berkeras.
Dialog: 0,1:25:17.94,1:25:21.05,Lalai,,0,0,0,,Hatinya masih tahu,\Nwalaupun dia hilang ingatan.
Dialog: 0,1:25:21.07,1:25:22.38,Lalai,,0,0,0,,"Saya tidak tertarik kepadanya."
Dialog: 0,1:25:22.40,1:25:24.05,Lalai,,0,0,0,,Akibatnya, Encik Yoon...
Dialog: 0,1:25:24.07,1:25:26.47,Lalai,,0,0,0,, sedang merana dengan cinta yang tidak berbalas,
Dialog: 0,1:25:26.49,1:25:28.05,Lalai,,0,0,0,,jenis cinta yang paling sunyi.
Dialog: 0,1:25:28.08,1:25:30.22,Lalai,,0,0,0,,Dia berhadapan dengan cinta yang sunyi dan tidak berbalas.
Dialog: 0,1:25:30.25,1:25:32.57,Lalai,,0,0,0,,Itu kesimpulan saya.
Dialog: 0,1:25:33.92,1:25:35.98,Lalai,,0,0,0,,Adakah anda mengatakan mereka akan berpisah tidak lama lagi?
Dialog: 0,1:25:36.00,1:25:38.44,Lalai,,0,0,0,,Hubungan mereka pasti akan berakhir,
Dialog: 0,1:25:38.46,1:25:42.83,Lalai,,0,0,0,,tetapi dia boleh bertindak dengan serius\Tidak apabila realiti berlaku.
Dialog: 0,1:25:42.92,1:25:45.04,Lalai,,0,0,0,,{\i1}Kita perlu berhati-hati.{\i0}
Dialog: 0,1:26:02.86,1:26:07.47,Lalai,,0,0,0,,{\i1}Dia boleh mendatangkan bahaya kepada kita semua.{\i0}
Dialog: 0,1:26:07.49,1:26:10.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:26:41.69,1:26:43.43,Lalai,,0,0,0,,{\an8}{\i1}Adakah dia masih hidup?{\i0}
Dialog: 0,1:26:43.74,1:26:45.73,Lalai,,0,0,0,,{\an8}{\i1}Adakah dia sudah mati?{\i0}
Dialog: 0,1:26:46.28,1:26:47.51,Lalai,,0,0,0,,{\an8}{\i1}Terima kasih...{\i0}
Dialog: 0,1:26:47.53,1:26:49.90,Lalai,,0,0,0,,{\an8}{\i1}kerana sentiasa berpegang kepada saya.{\i0}
Dialog: 0,1:26:50.37,1:26:52.51,Lalai,,0,0,0,,{\an8}{\i1}Tidak kira apa yang berlaku...{\i0}
Dialog: 0,1:26:52.54,1:26:54.01,Lalai,,0,0,0,,{\an8}{\i1}Baek Hyun-woo!{\i0}
Dialog: 0,1:26:54.04,1:26:56.24,Lalai,,0,0,0,,{\an8}{\i1}Saya akan melindunginya.{\i0}
