Dialog: 0,0:01:16.95,0:01:18.77, Lalai,,0,0,0,,{\an8}Hei!
Dialog: 0,0:01:20.16,0:01:21.62, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Gim Tinju Ratu{\c}{\i0}
Dialog: 0,0:01:26.46,0:01:28.35, Lalai,,0,0,0,,{\an8}Anda menemui tempat yang betul.
Dialog: 0,0:01:28.37,0:01:31.77, Lalai,,0,0,0,,{\an8}Bangunan ini mempunyai WiFi terbaik di bandar.
Dialog: 0,0:01:31.80,0:01:33.66, Lalai,,0,0,0,,{\an8}Datang bila-bila masa anda mahu.
Dialog: 0,0:01:33.92,0:01:35.32, Lalai,,0,0,0,,{\an8}Terima kasih.
Dialog: 0,0:01:35.34,0:01:37.43,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kumpulan Remaja Lelaki Pemenang\NBaek Hyun-woo{\c}{\i0}
Dialog: 0,0:01:38.97,0:01:40.49, Lalai,,0,0,0,,{\an8}"Baek Hyun-woo"?
Dialog: 0,0:01:40.51,0:01:42.49, Lalai,,0,0,0,,Adakah dia pernah bertinju?
Dialog: 0,0:01:42.51,0:01:44.07,Lalai,,0,0,0,,{\i1}Ya,{\i0}
Dialog: 0,0:01:44.10,0:01:45.97, Lalai,,0,0,0,,{\i1}dan dia pandai melakukannya.{\i0}
Dialog: 0,0:01:47.27,0:01:50.29,Lalai,,0,0,0,,{\i1}Dia sangat bijak, dia menggunakan otaknya ketika bertinju.{\i0}
Dialog: 0,0:01:50.31,0:01:54.35,Lalai,,0,0,0,,{\i1}Dia meramalkan pergerakan lawannya.{\i0}
Dialog: 0,0:02:00.12,0:02:03.40, Lalai,,0,0,0,,{\i1}Ringkasnya, dia adalah simulator hidup.{\i0}
Dialog: 0,0:02:06.62,0:02:09.66,Lalai,,0,0,0,,{\i1}Dia memikat anda masuk, kemudian mengelak pergerakan anda.{\i0}
Dialog: 0,0:02:09.92,0:02:16.08,Lalai,,0,0,0,,{\i1}Dia menunggu sehingga anda keletihan,\Nand kemudian dia melemparkan tumbukannya kepada anda.{\i0}
Dialog: 0,0:02:16.51,0:02:17.61, Lalai,,0,0,0,,{\i1}Anda menjadi tidak berdaya.{\i0}
Dialog: 0,0:02:17.63,0:02:20.08,Lalai,,0,0,0,,{\i1}Dia juga telah mengetuk saya.{\i0}
Dialog: 0,0:02:24.72,0:02:28.01, Lalai,,0,0,0,,Saya tidak dapat mengesan anda, jadi\NI tidak dapat menghantar kertas kepada anda.
Dialog: 0,0:02:29.85,0:02:31.76, Lalai,,0,0,0,,Ini dia.
Dialog: 0,0:02:31.90,0:02:34.10, Lalai,,0,0,0,,Pastikan anda mengupah seorang peguam.
Dialog: 0,0:02:34.32,0:02:35.29,Lalai,,0,0,0,,Apa?
Dialog: 0,0:02:35.32,0:02:38.81, Lalai,,0,0,0,,Saya memanggil mereka sebelum melompat keluar dari kereta saya.
Dialog: 0,0:02:41.87,0:02:45.40,Lalai,,0,0,0,,Anda telah ditangkap dalam perbuatan itu,\Njadi anda akan dibawa ke stesen.
Dialog: 0,0:02:46.24,0:02:48.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Polis untuk Rakyat{\c}{\i0}
Dialog: 0,0:02:52.71,0:02:54.24, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}En. Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:02:56.00,0:02:57.96, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}En. Pyeon{\c}{\i0}
Dialog: 0,0:03:01.76,0:03:03.29, Lalai,,0,0,0,,Hyun-woo?
Dialog: 0,0:03:27.95,0:03:31.06,Lalai,,0,0,0,,Adakah anda telah berbohong pada\suami anda, di semua tempat?
Dialog: 0,0:03:31.08,0:03:32.14, Lalai,,0,0,0,,Saya kecewa.
Dialog: 0,0:03:32.17,0:03:33.52,Lalai,,0,0,0,,Kecewa?
Dialog: 0,0:03:33.54,0:03:35.95,Lalai,,0,0,0,,Itu kaya, datang daripada anda.
Dialog: 0,0:03:37.25,0:03:38.40, Lalai,,0,0,0,,Bagaimana awak jumpa saya?
Dialog: 0,0:03:38.42,0:03:42.03,Lalai,,0,0,0,,Anda sepatutnya tahu sekarang, saya lakukan\Apa sahaja yang saya fikirkan.
Dialog: 0,0:03:42.05,0:03:44.15,Lalai,,0,0,0,,Mudah untuk mencari anda,
Dialog: 0,0:03:44.18,0:03:45.32,Lalai,,0,0,0,,jadi Hae-in,
Dialog: 0,0:03:45.35,0:03:47.50, Lalai,,0,0,0,,jangan jadikan saya jahat lagi.
Dialog: 0,0:03:50.27,0:03:52.12, Lalai,,0,0,0,,Adakah anda mengancam saya?
Dialog: 0,0:03:52.14,0:03:55.22,Lalai,,0,0,0,,Ya, saya,
Dialog: 0,0:03:55.44,0:03:58.52,Lalai,,0,0,0,,tetapi inilah ancaman sebenar, jadi dengar.
Dialog: 0,0:03:58.65,0:04:00.77, Lalai,,0,0,0,,Saya melihat diagnosis doktor anda,
Dialog: 0,0:04:01.11,0:04:04.09,Lalai,,0,0,0,,tetapi doktor anda enggan mengulas lanjut,
Dialog: 0,0:04:04.11,0:04:06.15, Lalai,,0,0,0,,kerana saya bukan penjaga awak,
Dialog: 0,0:04:06.28,0:04:07.51, Lalai,,0,0,0,,jadi...
Dialog: 0,0:04:07.53,0:04:09.61, Lalai,,0,0,0,,Saya akan jadi begitu sahaja.
Dialog: 0,0:04:09.75,0:04:10.72,Lalai,,0,0,0,,Adakah anda gila?
Dialog: 0,0:04:10.75,0:04:13.36, Lalai,,0,0,0,,Ya, saya rasa saya sedikit.
Dialog: 0,0:04:17.79,0:04:19.95,Lalai,,0,0,0,,Saya tahu anda tidak mempunyai banyak masa,
Dialog: 0,0:04:20.67,0:04:22.57, Lalai,,0,0,0,,jadi saya juga tidak, dan itu membuatkan saya gila.
Dialog: 0,0:04:22.59,0:04:24.75, Lalai,,0,0,0,,Saya tidak perlu takut.
Dialog: 0,0:04:26.18,0:04:27.45, Lalai,,0,0,0,,Baik, lakukan sesuka hati.
Dialog: 0,0:04:27.47,0:04:29.71, Lalai,,0,0,0,,Saya juga tidak perlu takut.
Dialog: 0,0:04:30.64,0:04:33.34,Lalai,,0,0,0,,Ibu bapa anda tidak tahu anda sakit.
Dialog: 0,0:04:34.77,0:04:36.29, Lalai,,0,0,0,,Mengapa anda tidak memberitahu mereka?
Dialog: 0,0:04:36.31,0:04:38.18, Lalai,,0,0,0,, Kerana anda takut.
Dialog: 0,0:04:38.44,0:04:41.77, Lalai,,0,0,0,,Saya faham. Mereka sudah kehilangan seorang anak lelaki sekali.
Dialog: 0,0:04:45.32,0:04:46.55, Lalai,,0,0,0,,Hei, Eun-sung.
Dialog: 0,0:04:46.57,0:04:48.63, Lalai,,0,0,0,,Teruskan bertindak begini,
Dialog: 0,0:04:48.66,0:04:52.15,Lalai,,0,0,0,,jika anda mahu saya membuat orang yang anda sayangi sengsara.
Dialog: 0,0:04:52.33,0:04:54.03, Lalai,,0,0,0,,Jika anda tidak,
Dialog: 0,0:04:54.12,0:04:56.82,Lalai,,0,0,0,,kembali segera.
Dialog: 0,0:04:57.17,0:04:59.10,Lalai,,0,0,0,,Kedudukan anda masih tersedia.
Dialog: 0,0:04:59.13,0:05:01.20, Lalai,,0,0,0,,Anda ada dua hari.
Dialog: 0,0:05:01.75,0:05:03.48,Lalai,,0,0,0,,Saya akan mengadakan sidang akhbar kemudian.
Dialog: 0,0:05:03.51,0:05:05.12, Lalai,,0,0,0,, Jumpa anda di sana.
Dialog: 0,0:05:07.97,0:05:10.05, Lalai,,0,0,0,,Serahkan semuanya kepada saya.
Dialog: 0,0:05:11.81,0:05:14.01, Lalai,,0,0,0,,Orang yang akan menyelamatkan kamu...
Dialog: 0,0:05:15.48,0:05:17.26, Lalai,,0,0,0,,adalah saya, bukan Hyun-woo.
Dialog: 0,0:05:19.94,0:05:22.22, Lalai,,0,0,0,,Awak brengsek!
Dialog: 0,0:05:22.65,0:05:24.50, Lalai,,0,0,0,,Bagaimana anda boleh melakukan ini kepada kami?
Dialog: 0,0:05:24.53,0:05:26.34, Lalai,,0,0,0,,Bagaimana anda boleh melakukan ini kepada saya?
Dialog: 0,0:05:26.36,0:05:29.27,Lalai,,0,0,0,,Saya akan bunuh awak!
Dialog: 0,0:05:32.04,0:05:33.99, Lalai,,0,0,0,,Aduh, Soo-cheol.
Dialog: 0,0:05:37.75,0:05:39.44, Lalai,,0,0,0,,Hei, awak okay?
Dialog: 0,0:05:39.46,0:05:42.44,Lalai,,0,0,0,,Keluarga kami hancur...
Dialog: 0,0:05:42.46,0:05:44.02, Lalai,,0,0,0,,kerana awak menipu saya.
Dialog: 0,0:05:44.05,0:05:45.58, Lalai,,0,0,0,,Saya yang dipersalahkan.
Dialog: 0,0:05:47.97,0:05:49.59,Lalai,,0,0,0,,Bodoh.
Dialog: 0,0:05:49.93,0:05:51.41,Lalai,,0,0,0,,Bukan salah awak.
Dialog: 0,0:05:51.43,0:05:54.38, Lalai,,0,0,0,,Sesiapa sahaja pasti akan ditipu.
Dialog: 0,0:05:54.52,0:05:57.05, Lalai,,0,0,0,,Bukan salah awak, jadi berhenti menangis.
Dialog: 0,0:05:59.10,0:06:00.46, Lalai,,0,0,0,,Di manakah Da-hye?
Dialog: 0,0:06:00.48,0:06:02.60, Lalai,,0,0,0,,Di mana dia?
Dialog: 0,0:06:03.15,0:06:04.50, Lalai,,0,0,0,, Beritahu saya...
Dialog: 0,0:06:04.53,0:06:07.52, Lalai,,0,0,0,, jika dia baik-baik saja.
Dialog: 0,0:06:09.03,0:06:10.94, Lalai,,0,0,0,,Sila.
Dialog: 0,0:06:29.43,0:06:32.24,Lalai,,0,0,0,,Anda baru sahaja tersandung batu dan jatuh...
Dialog: 0,0:06:32.26,0:06:33.72, Lalai,,0,0,0,,semasa berlari dalam gelap.
Dialog: 0,0:06:33.75,0:06:34.74, Lalai,,0,0,0,,Mengapa saya?
Dialog: 0,0:06:34.76,0:06:36.41, Lalai,,0,0,0,, Kerana kamu mabuk.
Dialog: 0,0:06:36.43,0:06:38.38, Lalai,,0,0,0,,Saya tidak minum.
Dialog: 0,0:06:39.31,0:06:43.14, Lalai,,0,0,0,,Saya katakan yang lain tidak sepatutnya\Ntahu Eun-sung ada di sini.
Dialog: 0,0:06:43.19,0:06:44.97, Lalai,,0,0,0,,Kenapa dia ada di sini?
Dialog: 0,0:06:47.99,0:06:51.81, Lalai,,0,0,0,,Saya patut tahu kenapa si brengsek itu datang ke sini.
Dialog: 0,0:06:52.16,0:06:53.86, Lalai,,0,0,0,,Ada sesuatu...
Dialog: 0,0:06:54.16,0:06:58.45,Lalai,,0,0,0,,Saya perlu buat, jadi jangan\Nberitahu ibu bapa kita dulu.
Dialog: 0,0:07:00.29,0:07:02.37, Lalai,,0,0,0,,Jawab saya.
Dialog: 0,0:07:03.25,0:07:04.87, Lalai,,0,0,0,, Baik.
Dialog: 0,0:07:06.00,0:07:09.41, Lalai,,0,0,0,,Saya mengalami rabun malam,\Njadi saya tidak dapat melihat apa-apa.
Dialog: 0,0:07:12.93,0:07:15.16,Lalai,,0,0,0,,{\i1}Anda tahu saya boleh menangkap nyamuk dalam gelap.{\i0}
Dialog: 0,0:07:15.18,0:07:17.57,Lalai,,0,0,0,,Ya, melihat dalam gelap adalah satu-satunya bakat anda.
Dialog: 0,0:07:17.60,0:07:20.87, Lalai,,0,0,0,,Tepat sekali, dan lelaki ini.
Dialog: 0,0:07:20.89,0:07:23.75, Lalai,,0,0,0,,Pengerusi baharu Queens.
Dialog: 0,0:07:23.77,0:07:24.96, Lalai,,0,0,0,,- Betul ke?\N- Ya.
Dialog: 0,0:07:24.98,0:07:26.63,Lalai,,0,0,0,,Itu bermakna dia musuh ketat mereka.
Dialog: 0,0:07:26.65,0:07:28.60,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:07:29.99,0:07:31.30,Lalai,,0,0,0,,Apa? awak kenal dia?
Dialog: 0,0:07:31.32,0:07:33.02, Lalai,,0,0,0,,Dia jenis saya.
Dialog: 0,0:07:49.17,0:07:50.30,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:07:51.17,0:07:52.71,Lalai,,0,0,0,,Sialan.
Dialog: 0,0:07:52.97,0:07:54.07, Lalai,,0,0,0,,Mengambil masa yang lama.
Dialog: 0,0:07:54.09,0:07:57.06, Lalai,,0,0,0,,Adakah anda memadamkan nombor Korea\N, e-mel dan media sosial anda?
Dialog: 0,0:07:57.08,0:07:58.07,Lalai,,0,0,0,,{\i1}Sudah tentu.{\i0}
Dialog: 0,0:07:58.10,0:07:59.99,Lalai,,0,0,0,,Saya juga berpindah di bawah nama palsu.
Dialog: 0,0:08:00.02,0:08:01.08, Lalai,,0,0,0,,Baik.
Dialog: 0,0:08:01.10,0:08:02.54,Lalai,,0,0,0,,Janganlah kita memanggil satu sama lain.
Dialog: 0,0:08:02.56,0:08:05.14, Lalai,,0,0,0,,- Hanya hubungi jika ia mendesak buat masa ini.\N- Okay.
Dialog: 0,0:08:05.69,0:08:07.64, Lalai,,0,0,0,,By the way,
Dialog: 0,0:08:07.73,0:08:09.89, Lalai,,0,0,0,, adakah anda melihat Soo-cheol?
Dialog: 0,0:08:11.19,0:08:12.90, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:08:12.95,0:08:14.26, Lalai,,0,0,0,,Tiada sebab.
Dialog: 0,0:08:14.28,0:08:15.92, Lalai,,0,0,0,,Dia sangat lemah fikiran.
Dialog: 0,0:08:15.95,0:08:17.18,Lalai,,0,0,0,,{\i1}Saya pasti dia terkejut.{\i0}
Dialog: 0,0:08:17.20,0:08:19.65, Lalai,,0,0,0,,Jadi... Adakah anda bimbang?
Dialog: 0,0:08:19.74,0:08:21.68, Lalai,,0,0,0,,Mengapa saya jadi?
Dialog: 0,0:08:21.70,0:08:23.89, Lalai,,0,0,0,,{\i1}Saya hanya ingin tahu. Itu sahaja.{\i0}
Dialog: 0,0:08:23.92,0:08:25.82,Lalai,,0,0,0,,Soo-cheol...
Dialog: 0,0:08:27.13,0:08:28.87, Lalai,,0,0,0,,marah dengan awak.
Dialog: 0,0:08:30.25,0:08:31.73, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:08:31.76,0:08:34.99,Lalai,,0,0,0,,{\i1}Dia akan membuat anda membayar jika dia menjumpai anda,{\i0}
Dialog: 0,0:08:35.01,0:08:36.32, Lalai,,0,0,0,, jadi berbaring.
Dialog: 0,0:08:36.34,0:08:38.50,Lalai,,0,0,0,,Baiklah. Selamat tinggal.
Dialog: 0,0:08:42.31,0:08:44.51,Lalai,,0,0,0,,Sudah tentu dia marah.
Dialog: 0,0:08:46.56,0:08:48.31, Lalai,,0,0,0,,Saya juga begitu.
Dialog: 0,0:08:49.65,0:08:51.88, Lalai,,0,0,0,,Dia akhirnya matang.
Dialog: 0,0:08:51.90,0:08:53.92,Lalai,,0,0,0,,Dia bukanlah seorang yang bodoh sepenuhnya.
Dialog: 0,0:08:53.95,0:08:56.56,Lalai,,0,0,0,,Da-hye...
Dialog: 0,0:09:01.58,0:09:03.90,Lalai,,0,0,0,,Da-hye...
Dialog: 0,0:09:04.54,0:09:06.78,Lalai,,0,0,0,,Da-hye...
Dialog: 0,0:09:15.42,0:09:16.68,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:09:17.55,0:09:19.15,Lalai,,0,0,0,,{\i1}Orang yang anda dail tidak tersedia.{\i0}
Dialog: 0,0:09:19.18,0:09:22.88, Lalai,,0,0,0,,{\i1}Sila tinggalkan mesej selepas\Nbip. Anda mungkin perlu membayar...{\i0}
Dialog: 0,0:09:49.79,0:09:50.98, Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:09:51.00,0:09:53.09,Lalai,,0,0,0,,Awak keluar kerja beberapa jam yang lalu, jadi kenapa awak lambat,
Dialog: 0,0:09:53.11,0:09:55.11, Lalai,,0,0,0,,dan apakah yang berlaku pada wajah anda?
Dialog: 0,0:09:55.13,0:09:57.03, Lalai,,0,0,0,,Saya cuma...
Dialog: 0,0:09:57.05,0:09:58.71, Lalai,,0,0,0,,Nah...
Dialog: 0,0:10:01.05,0:10:03.80, Lalai,,0,0,0,,- Adakah anda terkena?\N- Tidak, saya tidak.
Dialog: 0,0:10:04.14,0:10:06.37, Lalai,,0,0,0,,Sejauh manakah anda terluka?
Dialog: 0,0:10:06.39,0:10:08.25,Lalai,,0,0,0,,Hae-in, biar saya terangkan.
Dialog: 0,0:10:08.27,0:10:10.51, Lalai,,0,0,0,,Hae-in. Tolong?
Dialog: 0,0:10:12.36,0:10:15.31, Lalai,,0,0,0,,Biar saya bercakap. Bertahanlah. biar saya...
Dialog: 0,0:10:16.74,0:10:18.77, Lalai,,0,0,0,,Tetap diam.
Dialog: 0,0:10:21.07,0:10:22.80, Lalai,,0,0,0,, Hentikan.
Dialog: 0,0:10:22.83,0:10:25.15, Lalai,,0,0,0,, Datang ke sini. Biar saya periksa.
Dialog: 0,0:10:27.25,0:10:30.57, Lalai,,0,0,0,,Mengapa ini merah? Adakah anda\Nget clubbed atau sesuatu?
Dialog: 0,0:10:31.29,0:10:32.99, Lalai,,0,0,0,,Biar saya...
Dialog: 0,0:10:33.09,0:10:35.02, Lalai,,0,0,0,,terangkan.
Dialog: 0,0:10:35.05,0:10:36.77, Lalai,,0,0,0,,Saya tidak dipukul.
Dialog: 0,0:10:36.80,0:10:38.87, Lalai,,0,0,0,,Buka mulut anda.
Dialog: 0,0:10:42.14,0:10:44.20,Lalai,,0,0,0,,Adakah anda menggigit lidah anda?
Dialog: 0,0:10:44.22,0:10:45.76, Lalai,,0,0,0,,No.
Dialog: 0,0:10:45.93,0:10:48.62,Lalai,,0,0,0,,Saya tidak menggigit lidah atau dipukul.
Dialog: 0,0:10:48.64,0:10:51.89, Lalai,,0,0,0,, Tengok. Saya baik-baik saja.
Dialog: 0,0:10:52.61,0:10:56.29, Lalai,,0,0,0,,Saya baru sahaja mendapat calar dan bibir terbelah.
Dialog: 0,0:10:56.32,0:10:58.27, Lalai,,0,0,0,,Dan kenapa, betul-betul?
Dialog: 0,0:11:14.46,0:11:16.04, Lalai,,0,0,0,,Tetap diam.
Dialog: 0,0:11:21.63,0:11:24.15,Lalai,,0,0,0,,Saya bukan nak mendabik dada,
Dialog: 0,0:11:24.18,0:11:26.38, Lalai,,0,0,0,,tetapi saya menentang tiga lelaki.
Dialog: 0,0:11:27.52,0:11:30.33, Lalai,,0,0,0,,Ia bukan perjuangan yang mudah,
Dialog: 0,0:11:30.35,0:11:31.66, Lalai,,0,0,0,,dan mereka...
Dialog: 0,0:11:31.69,0:11:33.08, Lalai,,0,0,0,, malah dibawa...
Dialog: 0,0:11:33.10,0:11:36.92, Lalai,,0,0,0,, belantan dan senjata lain apabila ia datang untuk saya.
Dialog: 0,0:11:36.94,0:11:38.34, Lalai,,0,0,0,,Dan anda tidak bersenjata?
Dialog: 0,0:11:38.36,0:11:39.80,Lalai,,0,0,0,,Nah...
Dialog: 0,0:11:39.82,0:11:44.30,Lalai,,0,0,0,,Anda mungkin tidak tahu, tetapi\NI pernah bertinju semasa saya kecil.
Dialog: 0,0:11:44.32,0:11:46.47,Lalai,,0,0,0,,Saya boleh menerima pukulan dengan baik,
Dialog: 0,0:11:46.49,0:11:48.47, Lalai,,0,0,0,,jadi ia tidak menyakitkan sedikit pun.
Dialog: 0,0:11:48.49,0:11:50.15, Lalai,,0,0,0,, Tunggu.
Dialog: 0,0:11:51.91,0:11:54.78, Lalai,,0,0,0,,Ia hanya menyengat.
Dialog: 0,0:11:55.42,0:11:58.02, Lalai,,0,0,0,,Siapa itu? Orang gila mana yang buat awak macam ni?
Dialog: 0,0:11:58.05,0:12:00.61, Lalai,,0,0,0,,Ingat broker tanah itu...
Dialog: 0,0:12:00.63,0:12:02.07, Lalai,,0,0,0,,siapa dalam senarai larangan terbang?
Dialog: 0,0:12:02.09,0:12:03.57,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:12:03.59,0:12:06.96, Lalai,,0,0,0,,anda telah diserang semasa menjejaki penipu?
Dialog: 0,0:12:07.35,0:12:09.09,Lalai,,0,0,0,,Tetapi saya menang.
Dialog: 0,0:12:09.52,0:12:11.26, Lalai,,0,0,0,,Saya tidak kagum.
Dialog: 0,0:12:11.64,0:12:14.91, Lalai,,0,0,0,,Anda sepatutnya melarikan diri jika anda kalah bilangan.
Dialog: 0,0:12:14.94,0:12:16.50, Lalai,,0,0,0,,Dia telah ditangkap.
Dialog: 0,0:12:16.52,0:12:19.96, Lalai,,0,0,0,,Kita boleh mengubah keadaan jika dia terbukti bersalah...
Dialog: 0,0:12:19.98,0:12:21.52, Lalai,,0,0,0,,Diam.
Dialog: 0,0:12:27.95,0:12:30.40, Lalai,,0,0,0,,Jika ini berlaku lagi,
Dialog: 0,0:12:30.45,0:12:32.14, Lalai,,0,0,0,, lari sahaja.
Dialog: 0,0:12:32.16,0:12:33.70,Lalai,,0,0,0,,Janji dengan saya.
Dialog: 0,0:12:38.04,0:12:39.66, Lalai,,0,0,0,,Jawab saya.
Dialog: 0,0:12:39.96,0:12:41.66, Lalai,,0,0,0,,Awak kata diam.
Dialog: 0,0:12:42.80,0:12:44.92,Lalai,,0,0,0,,Tetapi janji dengan saya.
Dialog: 0,0:12:47.76,0:12:49.67, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:12:50.39,0:12:52.17, Lalai,,0,0,0,,Saya tidak boleh berbuat demikian.
Dialog: 0,0:12:54.19,0:12:56.26,Lalai,,0,0,0,,Saya sudah berjanji.
Dialog: 0,0:12:56.69,0:12:58.64, Lalai,,0,0,0,,Janji apa?
Dialog: 0,0:12:59.94,0:13:01.81, Lalai,,0,0,0,,Ini mengenai anda.
Dialog: 0,0:13:03.36,0:13:04.84,Lalai,,0,0,0,,Bagaimanapun...
Dialog: 0,0:13:04.86,0:13:07.06, Lalai,,0,0,0,,Ia adalah janji kepada diri saya sendiri.
Dialog: 0,0:13:10.99,0:13:12.74,Lalai,,0,0,0,,Jangan berjanji...
Dialog: 0,0:13:13.12,0:13:14.99, Lalai,,0,0,0,,tentang saya.
Dialog: 0,0:13:19.08,0:13:22.04,Lalai,,0,0,0,,Hanya pasangan suami isteri yang berbuat demikian, dan...
Dialog: 0,0:13:23.38,0:13:26.21,Lalai,,0,0,0,,kami sudah bercerai, jadi kami tidak perlu.
Dialog: 0,0:13:41.27,0:13:44.85,Lalai,,0,0,0,,Balik dibelasah macam ni lagi,
Dialog: 0,0:13:46.20,0:13:48.36, Lalai,,0,0,0,, dan saya akan bunuh awak sendiri.
Dialog: 0,0:13:48.78,0:13:50.57, Lalai,,0,0,0,, Faham?
Dialog: 0,0:13:50.99,0:13:53.15,Lalai,,0,0,0,,Saya tidak dipukul...
Dialog: 0,0:13:55.29,0:13:56.86, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:14:11.80,0:14:13.80,Lalai,,0,0,0,,Jom makan.
Dialog: 0,0:14:20.86,0:14:22.93, Lalai,,0,0,0,,Apa yang berlaku pada wajah anda?
Dialog: 0,0:14:27.78,0:14:28.84, Lalai,,0,0,0,,Saya jatuh malam tadi.
Dialog: 0,0:14:28.86,0:14:30.69, Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:14:34.99,0:14:37.61,Lalai,,0,0,0,,Aduh, apa yang berlaku kepada awak?
Dialog: 0,0:14:39.62,0:14:42.10, Lalai,,0,0,0,,Saya tersandung dan jatuh.
Dialog: 0,0:14:42.13,0:14:44.19, Lalai,,0,0,0,,Jadi kamu berdua jatuh?
Dialog: 0,0:14:44.21,0:14:47.23,Lalai,,0,0,0,,- Adakah kamu bergaduh?\N- Saya tidak akan berani.
Dialog: 0,0:14:47.26,0:14:48.98, Lalai,,0,0,0,,Saya dengar...
Dialog: 0,0:14:49.01,0:14:51.17, Lalai,,0,0,0,,dia pernah bertinju.
Dialog: 0,0:14:51.51,0:14:53.15, Lalai,,0,0,0,,Mengenai itu...
Dialog: 0,0:14:53.20,0:14:54.20, Lalai,,0,0,0,,Jadi anda dengar.
Dialog: 0,0:14:54.22,0:14:55.91, Lalai,,0,0,0,,Dia melawat gim saya semalam.
Dialog: 0,0:14:55.93,0:14:57.87, Lalai,,0,0,0,,Dia terkejut dengan trofi anda.
Dialog: 0,0:14:58.38,0:15:00.41, Lalai,,0,0,0,,Adakah anda bermain sukan?
Dialog: 0,0:15:00.44,0:15:01.50, Lalai,,0,0,0,,- Ya.\N- Astaga.
Dialog: 0,0:15:01.52,0:15:05.42,Lalai,,0,0,0,,Saya akhirnya boleh mengatakan ini sekarang,\Ntapi bukan mudah untuk membesarkannya.
Dialog: 0,0:15:05.44,0:15:08.00, Lalai,,0,0,0,,Dia memenangi setiap pertandingan,
Dialog: 0,0:15:08.03,0:15:10.51, Lalai,,0,0,0,,dan sentiasa berada dalam sepuluh teratas negara...
Dialog: 0,0:15:10.53,0:15:13.30, Lalai,,0,0,0,,selepas setiap peperiksaan.
Dialog: 0,0:15:13.32,0:15:16.76,Lalai,,0,0,0,,Kami tidak tahu jalan mana\Nuntuk menggalakkan dia ambil.
Dialog: 0,0:15:16.79,0:15:18.86, Lalai,,0,0,0,,Anda sempurna.
Dialog: 0,0:15:18.91,0:15:22.78,Lalai,,0,0,0,,- Tidak.\N- Nampaknya saya bercakap besar tentang anak saya,
Dialog: 0,0:15:22.83,0:15:25.29,Lalai,,0,0,0,,tetapi ini adalah kebenaran.
Dialog: 0,0:15:25.34,0:15:28.32, Lalai,,0,0,0,,Dia pasti mengejar saya.
Dialog: 0,0:15:28.34,0:15:31.69,Lalai,,0,0,0,,Tidak, Hyeon-tae ialah orang yang mengejar kamu.
Dialog: 0,0:15:31.72,0:15:34.78,Lalai,,0,0,0,,Semua orang kata Hyun-woo ialah\Nahli keluarga kami yang ganjil.
Dialog: 0,0:15:34.80,0:15:38.17,Lalai,,0,0,0,,Saya ambil tahu ibu saya, jadi saya tidak boleh berbohong.
Dialog: 0,0:15:41.02,0:15:43.87, Lalai,,0,0,0,,Bagaimana dengan anda?
Dialog: 0,0:15:43.90,0:15:46.47, Lalai,,0,0,0,,Dia tidak mengejar saya.
Dialog: 0,0:15:47.36,0:15:49.89, Lalai,,0,0,0,,Mengapa tidak? Sudah tentu saya lakukan.
Dialog: 0,0:15:55.45,0:15:57.22,Lalai,,0,0,0,,Bagi Hae-in,
Dialog: 0,0:15:57.24,0:16:00.14,Lalai,,0,0,0,,dia cantik,
Dialog: 0,0:16:00.16,0:16:02.74, Lalai,,0,0,0,,sama seperti ibunya.
Dialog: 0,0:16:18.76,0:16:20.59, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:16:21.39,0:16:22.37, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:16:22.39,0:16:24.43,Lalai,,0,0,0,,Sebenarnya,
Dialog: 0,0:16:24.56,0:16:27.75,Lalai,,0,0,0,,Hae-in suruh saya jangan beritahu awak, tapi...
Dialog: 0,0:16:27.77,0:16:29.56, Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,0:16:35.57,0:16:36.68, Lalai,,0,0,0,,- Apa?\N- Apa?
Dialog: 0,0:16:36.70,0:16:38.51, Lalai,,0,0,0,,Anda ada sesuatu untuk diperkatakan.
Dialog: 0,0:16:38.53,0:16:40.53, Lalai,,0,0,0,,- Adakah saya?\N- Tidak?
Dialog: 0,0:16:41.41,0:16:43.24, Lalai,,0,0,0,,Saya fikir anda melakukannya.
Dialog: 0,0:16:43.29,0:16:45.24,Lalai,,0,0,0,,Teruskan, kemudian.
Dialog: 0,0:16:50.38,0:16:52.08, Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:16:52.34,0:16:54.12,Lalai,,0,0,0,,Abaikan dia.
Dialog: 0,0:16:55.22,0:16:57.79,Lalai,,0,0,0,,Adakah anda menggunakan salap pagi ini?
Dialog: 0,0:16:58.43,0:17:00.99, Lalai,,0,0,0,,Tidak, saya tergesa-gesa.
Dialog: 0,0:17:01.02,0:17:03.47, Lalai,,0,0,0,,Izinkan saya melihat wajah awak.
Dialog: 0,0:17:17.32,0:17:21.26,Lalai,,0,0,0,,- Anda perlu kerap menggunakan ini.\N- Tetapi saya okey sekarang.
Dialog: 0,0:17:21.29,0:17:22.97, Lalai,,0,0,0,,Tidak, anda tidak.
Dialog: 0,0:17:23.00,0:17:25.78,Lalai,,0,0,0,,Sapukan salap...
Dialog: 0,0:17:28.25,0:17:31.08, Lalai,,0,0,0,,dan kerap ganti pembalut, supaya ia tidak akan berparut.
Dialog: 0,0:17:44.06,0:17:45.58,Lalai,,0,0,0,,Ada.
Dialog: 0,0:17:45.60,0:17:46.75, Lalai,,0,0,0,, Pergi.
Dialog: 0,0:17:46.77,0:17:48.30,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:17:50.11,0:17:51.81, Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,0:17:52.98,0:17:54.98, Lalai,,0,0,0,,Saya akan pergi sekarang.
Dialog: 0,0:17:55.65,0:17:57.19,Lalai,,0,0,0,,Okey.
Dialog: 0,0:17:57.65,0:18:00.36, Lalai,,0,0,0,, Pandu dengan selamat.
Dialog: 0,0:18:32.15,0:18:33.68, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:18:35.82,0:18:39.06, Lalai,,0,0,0,,Sekarang waktu sibuk,
Dialog: 0,0:18:40.07,0:18:42.65, Lalai,,0,0,0,,jadi saya rasa saya patut tunggu...
Dialog: 0,0:18:42.74,0:18:44.28, Lalai,,0,0,0,,lima minit.
Dialog: 0,0:18:47.20,0:18:48.52,Lalai,,0,0,0,,Nah...
Dialog: 0,0:18:48.54,0:18:51.49, Lalai,,0,0,0,,Adalah yang terbaik untuk mengelakkan lalu lintas.
Dialog: 0,0:18:52.71,0:18:55.25, Lalai,,0,0,0,,Ya, betul-betul.
Dialog: 0,0:18:56.71,0:18:58.25,Lalai,,0,0,0,,Betul.
Dialog: 0,0:19:07.47,0:19:10.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,0:19:32.12,0:19:34.49, Lalai,,0,0,0,,Bagaimana jika kita berbuat demikian?
Dialog: 0,0:19:35.67,0:19:36.65, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:19:36.67,0:19:39.15, Lalai,,0,0,0,,Jika kami menggunakan salap tepat pada masanya,
Dialog: 0,0:19:39.17,0:19:40.57,Lalai,,0,0,0,,membasmi kuman luka kami,
Dialog: 0,0:19:40.59,0:19:43.29, Lalai,,0,0,0,,dan menggantikan pembalut kami setiap kali,
Dialog: 0,0:19:43.34,0:19:45.80, Lalai,,0,0,0,,adakah keadaan berbeza?
Dialog: 0,0:19:47.76,0:19:49.47, Lalai,,0,0,0,,Tidak, sebelum itu.
Dialog: 0,0:19:49.73,0:19:51.04,Lalai,,0,0,0,,Bagaimana jika kita berpisah...
Dialog: 0,0:19:51.06,0:19:53.45, Lalai,,0,0,0,,pada masa kami makan aiskrim...
Dialog: 0,0:19:53.48,0:19:55.10, Lalai,,0,0,0,, di sini?
Dialog: 0,0:19:55.81,0:19:59.42,Lalai,,0,0,0,,Jika kita tidak berkahwin,\Nkita akan menghargai...
Dialog: 0,0:19:59.44,0:20:02.94,Lalai,,0,0,0,,kenangan, sehingga ke hari ini.
Dialog: 0,0:20:03.28,0:20:05.01, Lalai,,0,0,0,,Tidak perlu...
Dialog: 0,0:20:05.03,0:20:07.44, Lalai,,0,0,0,,untuk luka...
Dialog: 0,0:20:07.58,0:20:09.78, Lalai,,0,0,0,,untuk bernanah,
Dialog: 0,0:20:10.00,0:20:11.89, Lalai,,0,0,0,, atau parut untuk terbentuk.
Dialog: 0,0:20:11.91,0:20:13.60, Lalai,,0,0,0,,Anda akan bertemu seseorang...
Dialog: 0,0:20:13.62,0:20:18.20,Lalai,,0,0,0,,siapa yang lebih baik, lebih hangat,
Dialog: 0,0:20:18.30,0:20:21.29, Lalai,,0,0,0,, dan lebih baik daripada saya.
Dialog: 0,0:20:21.42,0:20:24.33, Lalai,,0,0,0,,Anda akan bahagia hidup bersama.
Dialog: 0,0:20:24.68,0:20:26.59, Lalai,,0,0,0,,Mungkin tidak.
Dialog: 0,0:20:28.60,0:20:30.45, Lalai,,0,0,0,,Jika kita berpisah,
Dialog: 0,0:20:30.47,0:20:31.91, Lalai,,0,0,0,,anda mungkin...
Dialog: 0,0:20:31.93,0:20:34.47, Lalai,,0,0,0,,tidak akan tahu keadaan saya,
Dialog: 0,0:20:34.60,0:20:38.17, Lalai,,0,0,0,,tetapi saya akan tahu apa yang anda lakukan,
Dialog: 0,0:20:38.19,0:20:39.72, Lalai,,0,0,0,, dan saya mungkin...
Dialog: 0,0:20:40.07,0:20:42.48, Lalai,,0,0,0,, pasti menyesal.
Dialog: 0,0:20:43.74,0:20:45.88, Lalai,,0,0,0,,Tetapi jika anda tahu bagaimana keadaan akan berakhir...
Dialog: 0,0:20:45.91,0:20:47.69, Lalai,,0,0,0,,Walaupun masih,
Dialog: 0,0:20:49.49,0:20:51.69, Lalai,,0,0,0,,Saya akan membuat pilihan yang sama.
Dialog: 0,0:20:56.92,0:20:59.73, Lalai,,0,0,0,,Tetapi jika saya tahu kemudian apa yang saya tahu sekarang,
Dialog: 0,0:20:59.75,0:21:01.94, Lalai,,0,0,0,,Saya akan bertanya kepada anda lebih kerap.
Dialog: 0,0:21:01.96,0:21:03.40, Lalai,,0,0,0,,Tanya apa?
Dialog: 0,0:21:03.42,0:21:05.46, Lalai,,0,0,0,,Cara hari anda.
Dialog: 0,0:21:10.51,0:21:12.09,Lalai,,0,0,0,,{\i1}"Ada apa-apa..."{\i0}
Dialog: 0,0:21:12.31,0:21:14.01, Lalai,,0,0,0,,{\i1}"itu merisaukan awak?"{\i0}
Dialog: 0,0:21:15.02,0:21:16.83,Lalai,,0,0,0,,{\i1}Saya kesal...{\i0}
Dialog: 0,0:21:17.15,0:21:19.85,Lalai,,0,0,0,,{\i1}tidak menanyakan soalan sedemikian kepada anda.{\i0}
Dialog: 0,0:22:12.08,0:22:14.86,Lalai,,0,0,0,,Pukul berapa awak pulang semalam?
Dialog: 0,0:22:16.20,0:22:18.53,Lalai,,0,0,0,,Pengerusi okey?
Dialog: 0,0:22:24.30,0:22:25.44, Lalai,,0,0,0,,Saya faham...
Dialog: 0,0:22:25.46,0:22:27.79,Lalai,,0,0,0,,apa yang anda maksudkan,
Dialog: 0,0:22:27.84,0:22:29.28, Lalai,,0,0,0,,tetapi pertama,
Dialog: 0,0:22:29.30,0:22:31.36, Lalai,,0,0,0,,bawa pengerusi semula.
Dialog: 0,0:22:31.39,0:22:33.03, Lalai,,0,0,0,, Kemudian kita boleh berbincang.
Dialog: 0,0:22:33.06,0:22:34.84, Lalai,,0,0,0,,Kami tidak perlu.
Dialog: 0,0:22:35.47,0:22:38.16,Lalai,,0,0,0,,Saya akan berkahwin dengan Hae-in secepat mungkin.
Dialog: 0,0:22:38.19,0:22:40.01, Lalai,,0,0,0,,Apa? kahwin dengan dia?
Dialog: 0,0:22:41.86,0:22:43.83, Lalai,,0,0,0,,Adakah dia bersetuju dengannya?
Dialog: 0,0:22:43.86,0:22:45.93,Lalai,,0,0,0,,Anda masih tidak mengenali saya?
Dialog: 0,0:22:47.61,0:22:49.52, Lalai,,0,0,0,,Saya akan mewujudkannya.
Dialog: 0,0:23:02.92,0:23:04.67,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Intranet{\c}{\i0}
Dialog: 0,0:23:05.80,0:23:08.76,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pelantikan Kakitangan Baharu{\c}{\i0}
Dialog: 0,0:23:10.62,0:23:12.99,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo\NRPenyingkiran daripada kedudukan kerana penyelewengan{\c}{\i0}
Dialog: 0,0:23:15.35,0:23:16.92,Lalai,,0,0,0,,Adakah anda membacanya?
Dialog: 0,0:23:19.06,0:23:20.97, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:23:21.02,0:23:22.68, Lalai,,0,0,0,,Ada sesuatu?
Dialog: 0,0:23:48.92,0:23:51.08, Lalai,,0,0,0,,Ia lebih kecil daripada yang saya sangka.
Dialog: 0,0:23:53.76,0:23:56.16, Lalai,,0,0,0,,Ia hanya sesuai untuk seorang.
Dialog: 0,0:23:56.18,0:23:59.55, Lalai,,0,0,0,,Anda pasti terkejut dengan pengumuman yang tiba-tiba itu.
Dialog: 0,0:24:00.27,0:24:02.45, Lalai,,0,0,0,,Saya memang nampak ia akan datang,
Dialog: 0,0:24:02.48,0:24:04.20,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:24:04.30,0:24:05.29, Lalai,,0,0,0,,"penyelewengan"?
Dialog: 0,0:24:05.31,0:24:06.75, Lalai,,0,0,0,,Adakah anda mempunyai bukti?
Dialog: 0,0:24:06.77,0:24:09.46, Lalai,,0,0,0,,Sudah tentu. Satu jawatankuasa\N kakitangan akan dijadualkan tidak lama lagi.
Dialog: 0,0:24:09.48,0:24:11.27, Lalai,,0,0,0,,Ketahui sendiri kemudian.
Dialog: 0,0:24:13.28,0:24:14.80, Lalai,,0,0,0,,Saya terkejut.
Dialog: 0,0:24:14.82,0:24:16.47, Lalai,,0,0,0,, Yongdu-ri, bukan?
Dialog: 0,0:24:16.49,0:24:18.19, Lalai,,0,0,0,,Udaranya segar.
Dialog: 0,0:24:18.66,0:24:22.20,Lalai,,0,0,0,,Walaupun masih, bagaimana anda boleh membawanya ke sana?
Dialog: 0,0:24:26.25,0:24:28.91, Lalai,,0,0,0,,Saya rasa anda tidak mendengar.
Dialog: 0,0:24:32.38,0:24:34.46,Lalai,,0,0,0,,Saya jumpa dia semalam.
Dialog: 0,0:24:35.34,0:24:37.17, Lalai,,0,0,0,,Dia tidak memberitahu anda?
Dialog: 0,0:24:37.60,0:24:39.55, Lalai,,0,0,0,,Kami tiada masa.
Dialog: 0,0:24:40.06,0:24:41.33, Lalai,,0,0,0,,Saya agak sibuk.
Dialog: 0,0:24:41.35,0:24:43.72,Lalai,,0,0,0,,En. Pyeon telah ditangkap semalam.
Dialog: 0,0:24:47.31,0:24:49.31, Lalai,,0,0,0,,Saya rasa anda tidak mendengar.
Dialog: 0,0:24:50.11,0:24:51.54, Lalai,,0,0,0,,Saya tidak faham.
Dialog: 0,0:24:51.57,0:24:54.71, Lalai,,0,0,0,, Daripada apa yang saya dengar,
Dialog: 0,0:24:54.74,0:24:56.47,Lalai,,0,0,0,,dia juga berpura-pura tidak tahu sekarang,
Dialog: 0,0:24:56.49,0:24:59.36, Lalai,,0,0,0,,tetapi jangan risau. saya ada kebolehan...
Dialog: 0,0:24:59.87,0:25:02.32, Lalai,,0,0,0,,untuk mendedahkan kebenaran.
Dialog: 0,0:25:06.92,0:25:08.44, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:25:08.46,0:25:10.10, Lalai,,0,0,0,,Baik.
Dialog: 0,0:25:10.13,0:25:12.66,Lalai,,0,0,0,,Mari kita lakukan yang terbaik, kemudian.
Dialog: 0,0:25:14.67,0:25:16.21, Lalai,,0,0,0,,Bye.
Dialog: 0,0:25:39.03,0:25:40.59,Lalai,,0,0,0,,Bukankah kita patut bertanya khabar?
Dialog: 0,0:25:40.62,0:25:44.01, Lalai,,0,0,0,,Jangan. Dia seperti Crown\NPrince Sado dalam peti nasi itu.
Dialog: 0,0:25:44.04,0:25:46.12, Lalai,,0,0,0,,- Apa maksud awak?\N- Awak tak tengok filem ke?
Dialog: 0,0:25:46.15,0:25:47.31,Lalai,,0,0,0,,Daripada memecatnya,
Dialog: 0,0:25:47.33,0:25:50.52,Lalai,,0,0,0,,mereka meletakkannya di hadapan semua orang untuk dilihat.
Dialog: 0,0:25:50.54,0:25:53.06, Lalai,,0,0,0,,Mereka mahu melihat siapa yang menyebelahinya.
Dialog: 0,0:25:53.09,0:25:55.52,Lalai,,0,0,0,,Astaga, adakah itu sebabnya mereka meletakkan\N dia di sebelah bilik merokok?
Dialog: 0,0:25:55.55,0:25:58.67, Lalai,,0,0,0,,Mereka mahu melihat dengan siapa dia rapat.
Dialog: 0,0:25:58.72,0:26:00.25,Lalai,,0,0,0,,Jom.
Dialog: 0,0:26:10.02,0:26:13.02, Lalai,,0,0,0,,Saya tidak sangka anda akan menjawab panggilan saya.
Dialog: 0,0:26:14.57,0:26:16.27,Lalai,,0,0,0,,Betul.
Dialog: 0,0:26:16.32,0:26:19.88,Lalai,,0,0,0,,Saya tidak memadamkan nombor\Nyang belum diselesaikan.
Dialog: 0,0:26:19.91,0:26:23.43, Lalai,,0,0,0,,Selalu ada mereka yang\Nenggan membayar yuran mencari jodoh.
Dialog: 0,0:26:23.45,0:26:28.22,Lalai,,0,0,0,,Saya mengejar mereka hingga ke hujung\Nearth dan memastikan mereka menderita.
Dialog: 0,0:26:28.25,0:26:31.28, Lalai,,0,0,0,,Itulah cara saya menyelesaikan masalah.
Dialog: 0,0:26:34.84,0:26:36.77, Lalai,,0,0,0,,Ya, saya tahu,
Dialog: 0,0:26:36.80,0:26:39.32, Lalai,,0,0,0,,tetapi saya agak tepat tentang penempatan saya.
Dialog: 0,0:26:39.34,0:26:40.32,Lalai,,0,0,0,,Apa?
Dialog: 0,0:26:40.34,0:26:44.32,Lalai,,0,0,0,,Mungkin anda tidak mendapat apa yang anda\Ninginkan kerana anda tidak memperolehnya.
Dialog: 0,0:26:44.35,0:26:47.03, Lalai,,0,0,0,,Adakah anda mengatakan saya tidak melakukan kerja saya?
Dialog: 0,0:26:47.06,0:26:51.25,Lalai,,0,0,0,,Adakah anda mendedikasikan beberapa dekad kehidupan dan hamba anda di bawah bumbung ini,
Dialog: 0,0:26:51.27,0:26:54.88,Lalai,,0,0,0,,atau adakah anda tinggal di luar negara bersendirian\Nselama bertahun-tahun seperti Eun-sung?
Dialog: 0,0:26:54.90,0:26:57.59,Lalai,,0,0,0,,Ia bukan seperti anda bekerja secara percuma, sama ada,
Dialog: 0,0:26:57.61,0:26:58.92,Lalai,,0,0,0,,jadi saya agak terkedu...
Dialog: 0,0:26:58.95,0:27:01.51, Lalai,,0,0,0,, yang anda tuntut untuk menjadi\NCEO selepas melakukan beberapa kerja.
Dialog: 0,0:27:01.53,0:27:05.18,Lalai,,0,0,0,,Walaupun masih, awak suruh saya pergi ke luar negara...
Dialog: 0,0:27:05.20,0:27:06.60, Lalai,,0,0,0,,dengan sedikit wang.
Dialog: 0,0:27:06.62,0:27:07.85, Lalai,,0,0,0,,Bukankah itu terlalu keras?
Dialog: 0,0:27:07.87,0:27:10.49,Lalai,,0,0,0,,Saya akan benarkan awak jadi CEO kemudian,
Dialog: 0,0:27:11.08,0:27:13.33, Lalai,,0,0,0,,tetapi lakukan nilai wang anda.
Dialog: 0,0:27:14.42,0:27:16.12,Lalai,,0,0,0,,Bagaimana?
Dialog: 0,0:27:18.55,0:27:19.73, Lalai,,0,0,0,,Cari Hong Man-dae.
Dialog: 0,0:27:19.76,0:27:21.24,Lalai,,0,0,0,,Apa?
Dialog: 0,0:27:21.26,0:27:22.96, Lalai,,0,0,0,,Apa yang anda...?
Dialog: 0,0:27:32.94,0:27:35.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ditutup untuk Penyelenggaraan Elektrik{\c}{\i0}
Dialog: 0,0:27:35.48,0:27:38.79,Lalai,,0,0,0,,{\an8}{\i1}Tidak banyak hospital yang\Nare mempunyai kakitangan penuh sepanjang masa,{\i0}
Dialog: 0,0:27:38.82,0:27:41.01, Lalai,,0,0,0,,dan mempunyai bilik VVIP...
Dialog: 0,0:27:41.03,0:27:44.23, Lalai,,0,0,0,, meliputi seluruh lantai.
Dialog: 0,0:27:44.45,0:27:46.14, Lalai,,0,0,0,,Baiklah. Mari kita mulakan.
Dialog: 0,0:27:46.16,0:27:47.99, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:27:48.37,0:27:49.51, Lalai,,0,0,0,,Helo.
Dialog: 0,0:27:49.54,0:27:51.89,Lalai,,0,0,0,,Adakah ini bilik VIP\Npentadbiran di Hospital Hanju?
Dialog: 0,0:27:51.91,0:27:55.39, Lalai,,0,0,0,,CEO kami mahu menerima terapi sel stem.
Dialog: 0,0:27:55.42,0:27:58.44, Lalai,,0,0,0,,Adakah bilik VIP anda di tingkat 23 tersedia?
Dialog: 0,0:27:58.46,0:28:00.75, Lalai,,0,0,0,,{\i1}Apa? Dia melakukan apa kepada bapa saya?{\i0}
Dialog: 0,0:28:01.84,0:28:04.36, Lalai,,0,0,0,,Ke mana dia bawa dia?
Dialog: 0,0:28:04.39,0:28:05.70,Lalai,,0,0,0,,{\i1}Saya masih menelitinya.{\i0}
Dialog: 0,0:28:05.72,0:28:08.28, Lalai,,0,0,0,,Menurut jururawat,\NSeul-hee tidak terlibat.
Dialog: 0,0:28:08.31,0:28:10.37, Lalai,,0,0,0,,Eun-sung melakukannya seorang diri.
Dialog: 0,0:28:10.39,0:28:11.58, Lalai,,0,0,0,, Sial.
Dialog: 0,0:28:11.60,0:28:13.75, Lalai,,0,0,0,,Saya akan membuat mereka membayar.
Dialog: 0,0:28:13.77,0:28:15.66, Lalai,,0,0,0,,Anda tunggu. Saya menelefon teksi.
Dialog: 0,0:28:15.69,0:28:18.02, Lalai,,0,0,0,,Saya akan berada di Seoul tidak lama lagi.
Dialog: 0,0:28:19.57,0:28:21.27, Lalai,,0,0,0,,Saya menutup telefon.
Dialog: 0,0:28:21.69,0:28:24.31, Lalai,,0,0,0,,Hei, awak anak ibu saya.
Dialog: 0,0:28:24.57,0:28:26.72, Lalai,,0,0,0,,Dia menipu saya hari itu.
Dialog: 0,0:28:26.74,0:28:28.98, Lalai,,0,0,0,,Saya bermaksud untuk mengembalikan ini.
Dialog: 0,0:28:29.49,0:28:31.03, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:28:31.54,0:28:34.14,Lalai,,0,0,0,,Ibu kamu pinjamkan kepada saya hari itu.
Dialog: 0,0:28:34.17,0:28:35.70, Lalai,,0,0,0,,Tetapi...
Dialog: 0,0:28:35.75,0:28:37.10, Lalai,,0,0,0,,kenapa dia?
Dialog: 0,0:28:37.13,0:28:38.79,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:28:39.00,0:28:41.77, Lalai,,0,0,0,,Saya boleh memadam apa yang saya tumpahkan.
Dialog: 0,0:28:41.80,0:28:43.75, Lalai,,0,0,0,,Apa yang anda tumpahkan?
Dialog: 0,0:28:51.39,0:28:52.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa kamu menangis?{\c}{\i0}
Dialog: 0,0:28:52.89,0:28:54.76,Lalai,,0,0,0,,Nah...
Dialog: 0,0:28:57.27,0:28:59.21,Lalai,,0,0,0,,Astaga, saya hampir memberitahu anda.
Dialog: 0,0:28:59.23,0:29:00.71, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:29:00.73,0:29:03.23, Lalai,,0,0,0,,Bagaimanapun, kembalikan itu kepadanya.
Dialog: 0,0:29:03.95,0:29:07.57,Lalai,,0,0,0,,Hanya orang bodoh terbesar yang menangis apabila masa sukar.
Dialog: 0,0:29:07.95,0:29:09.30, Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:29:09.33,0:29:11.10,Lalai,,0,0,0,,Saya tidak menangis.
Dialog: 0,0:29:11.12,0:29:13.61, Lalai,,0,0,0,,Dan hanya orang bodoh biasa yang menanggungnya.
Dialog: 0,0:29:14.25,0:29:17.58, Lalai,,0,0,0,,Lalu apakah yang dilakukan oleh orang yang bijak?
Dialog: 0,0:29:18.25,0:29:21.91, Lalai,,0,0,0,,Mereka makan daging apabila masa sukar.
Dialog: 0,0:29:26.55,0:29:30.80,Lalai,,0,0,0,,Lain kali, makan daging\Ndaripada menangis seperti orang bodoh.
Dialog: 0,0:29:39.94,0:29:42.00, Lalai,,0,0,0,,Apa yang dia cakap?
Dialog: 0,0:29:42.03,0:29:44.69, Lalai,,0,0,0,,Daging, kaki saya.
Dialog: 0,0:29:46.99,0:29:50.32, Lalai,,0,0,0,, Astaga, bandar ini sangat pelik.
Dialog: 0,0:29:51.87,0:29:53.45,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Ketua Kampung{\c}{\i0}
Dialog: 0,0:30:08.09,0:30:10.46, Lalai,,0,0,0,,Nampak bagus, Du-gwan.
Dialog: 0,0:30:11.35,0:30:12.49, Lalai,,0,0,0,,Mengapa kamu di sini?
Dialog: 0,0:30:12.51,0:30:15.47, Lalai,,0,0,0,,Kami akan berjumpa anda buat kali terakhir.
Dialog: 0,0:30:15.52,0:30:16.74, Lalai,,0,0,0,,Hei.
Dialog: 0,0:30:16.77,0:30:18.97, Lalai,,0,0,0,,Adakah saya mati atau sesuatu?
Dialog: 0,0:30:25.44,0:30:27.51,Lalai,,0,0,0,,Saya Park Seok-hun, ketua kampung baharu.
Dialog: 0,0:30:27.53,0:30:29.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Perasmian Park Seok-hun,\Nketua kampung baharu{\c}{\i0}
Dialog: 0,0:30:29.86,0:30:32.59,Lalai,,0,0,0,,Hari ini hebat. Berseronoklah.
Dialog: 0,0:30:32.62,0:30:34.40,Lalai,,0,0,0,,Pesta perasmian akan berlangsung...
Dialog: 0,0:30:34.42,0:30:36.47, Lalai,,0,0,0,,di restoran sup daging babi dan nasi saya.
Dialog: 0,0:30:36.50,0:30:39.39, Lalai,,0,0,0,,Sila datang dan dapatkan.\NI berjanji untuk melakukannya dengan baik!
Dialog: 0,0:30:39.42,0:30:41.70, Lalai,,0,0,0,,Sila tonton saya!
Dialog: 0,0:30:43.25,0:30:44.90,Lalai,,0,0,0,,- Park Seok-hun!\N- Park Seok-hun!
Dialog: 0,0:30:44.92,0:30:48.73,Lalai,,0,0,0,,- Park Seok-hun!\N- Park Seok-hun!
Dialog: 0,0:30:48.76,0:30:50.67,Lalai,,0,0,0,,Jom makan.
Dialog: 0,0:30:53.26,0:30:54.80,Lalai,,0,0,0,,By the way,
Dialog: 0,0:30:54.89,0:30:57.01, Lalai,,0,0,0,,di manakah Chun-sik?
Dialog: 0,0:30:58.23,0:30:59.75,Lalai,,0,0,0,,Dia anak perempuannya.
Dialog: 0,0:30:59.77,0:31:03.46,Lalai,,0,0,0,,Kami tahu semua orang di bandar ini.\N Patutkah kami mengupah orang asing?
Dialog: 0,0:31:03.48,0:31:05.52, Lalai,,0,0,0,,Dan kali terakhir...
Dialog: 0,0:31:07.53,0:31:08.80, Lalai,,0,0,0,, Beritahu saya secara terperinci.
Dialog: 0,0:31:08.82,0:31:10.97,Lalai,,0,0,0,,Apa yang orang Seok-hun katakan kepada kamu?
Dialog: 0,0:31:10.99,0:31:13.93, Lalai,,0,0,0,,Ingat kita pergi minum semasa\Nperhimpunan penggantian ladang?
Dialog: 0,0:31:13.95,0:31:16.76, Lalai,,0,0,0,,Dan resit hilang.
Dialog: 0,0:31:16.79,0:31:18.64, Lalai,,0,0,0,,- Sebab itu?\N- Bukan itu sahaja.
Dialog: 0,0:31:18.66,0:31:20.66,Lalai,,0,0,0,,Mereka juga membawa semua resume sambilan...
Dialog: 0,0:31:20.69,0:31:23.73, Lalai,,0,0,0,,dari bazar bandar-luar bandar dua tahun lalu,
Dialog: 0,0:31:23.75,0:31:26.56,Lalai,,0,0,0,,dan mendakwa pekerja sambilan\Ndipilih daripada dipilih.
Dialog: 0,0:31:26.59,0:31:28.61, Lalai,,0,0,0,,Saya tidak percaya mereka.
Dialog: 0,0:31:28.63,0:31:31.42,Lalai,,0,0,0,,Bertenang.
Dialog: 0,0:31:32.05,0:31:35.45,Lalai,,0,0,0,,Terdapat dua perkara yang\Ntidak wujud di dunia ini.
Dialog: 0,0:31:35.47,0:31:36.82, Lalai,,0,0,0,,Satu, hadiah percuma.
Dialog: 0,0:31:36.85,0:31:38.70, Lalai,,0,0,0,,Dua,
Dialog: 0,0:31:38.73,0:31:40.16, Lalai,,0,0,0,,pemindahan kuasa secara aman.
Dialog: 0,0:31:40.18,0:31:43.12, Lalai,,0,0,0,,Itu benar, Du-gwan.
Dialog: 0,0:31:43.15,0:31:45.46, Lalai,,0,0,0,,Itu adalah fakta di seluruh dunia.
Dialog: 0,0:31:45.48,0:31:48.50,Lalai,,0,0,0,,Mereka melakukan apa yang mereka semua lakukan.
Dialog: 0,0:31:48.53,0:31:50.17, Lalai,,0,0,0,,Apabila kuasa baharu mengambil alih,
Dialog: 0,0:31:50.19,0:31:53.98,Lalai,,0,0,0,,mereka menyeksa mereka yang paling hampir dengan yang sebelumnya.
Dialog: 0,0:31:55.91,0:31:57.39,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:31:57.41,0:31:59.14, Lalai,,0,0,0,,Bukan itu sahaja.
Dialog: 0,0:31:59.16,0:32:03.32,Lalai,,0,0,0,,Mereka akan memadamkan semua kesan\Nof rejim sebelumnya tidak lama lagi.
Dialog: 0,0:32:04.00,0:32:05.83, Lalai,,0,0,0,, Memadamkan jejak?
Dialog: 0,0:32:08.84,0:32:11.73, Lalai,,0,0,0,, Cat lagi. Saya masih boleh melihatnya. Di sini, gunakan ini.
Dialog: 0,0:32:11.76,0:32:12.90,Lalai,,0,0,0,,- Okay.\N- Okay.
Dialog: 0,0:32:12.93,0:32:14.54, Lalai,,0,0,0,,- Terima kasih.\N- Pasti.
Dialog: 0,0:32:15.51,0:32:18.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ketua Kampung{\c}{\i0}
Dialog: 0,0:32:18.93,0:32:19.99, Lalai,,0,0,0,, Seok-hun.
Dialog: 0,0:32:20.02,0:32:21.69, Lalai,,0,0,0,,Pear tidak bersalah.
Dialog: 0,0:32:21.71,0:32:22.70,Lalai,,0,0,0,,Apa?
Dialog: 0,0:32:22.73,0:32:25.16, Lalai,,0,0,0,,Apa yang anda mahu padamkan bukanlah pear itu.
Dialog: 0,0:32:25.19,0:32:28.17,Lalai,,0,0,0,,Ini adalah kehadiran saya di kampung ini.
Dialog: 0,0:32:28.19,0:32:31.50,Lalai,,0,0,0,,Anda mahu memadamkan reputasi saya\Nas ketua kampung yang paling bijak.
Dialog: 0,0:32:31.53,0:32:32.80, Lalai,,0,0,0,,Itu tidak benar.
Dialog: 0,0:32:32.82,0:32:35.17, Lalai,,0,0,0,,Frasa baharu Yongdu-ri ialah...
Dialog: 0,0:32:35.20,0:32:37.72,Lalai,,0,0,0,,"The Pretty Apple Village,"
Dialog: 0,0:32:37.74,0:32:39.35, Lalai,,0,0,0,,jadi kita perlu melukisnya.
Dialog: 0,0:32:39.37,0:32:42.26,Lalai,,0,0,0,,Terdapat banyak dinding di sekeliling sini.
Dialog: 0,0:32:42.29,0:32:45.18, Lalai,,0,0,0,,Adakah anda perlu menggunakan yang ini?
Dialog: 0,0:32:45.21,0:32:48.19,Lalai,,0,0,0,,Kami tidak meminta anda memperlakukan\Nus seperti kami masih berkuasa.
Dialog: 0,0:32:48.21,0:32:51.25, Lalai,,0,0,0,,Perlakukan kami dengan sedikit hormat.
Dialog: 0,0:32:52.63,0:32:55.25, Lalai,,0,0,0,,Adakah anda akan terus menonton?
Dialog: 0,0:32:55.97,0:32:57.92,Lalai,,0,0,0,,Sangat tidak selesa.
Dialog: 0,0:33:09.32,0:33:10.67,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Peti Masuk{\c}{\i0}
Dialog: 0,0:33:10.69,0:33:12.40,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Tidak Dihantar\NDa-hye{\c}{\i0}
Dialog: 0,0:33:44.10,0:33:45.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Di manakah anda?{\c}{\i0}
Dialog: 0,0:33:45.39,0:33:48.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya berada di belakang pokok.{\c}{\i0}
Dialog: 0,0:33:50.61,0:33:52.46, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Terima kasih, Sayang. Anda menyelamatkan saya.{\c}{\i0}
Dialog: 0,0:33:52.48,0:33:53.54, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kekal fokus.{\c}{\i0}
Dialog: 0,0:33:53.57,0:33:56.42, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Gunakan dart beracun anda.\N- Saya tiada. Saya hanya mempunyai kapak.{\c}{\i0}
Dialog: 0,0:33:56.45,0:33:59.93,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya memberitahu anda untuk meningkatkan\Nsenjata anda apabila anda mendapat wang.{\c}{\i0}
Dialog: 0,0:33:59.95,0:34:01.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Siapa yang menggunakan kapak hari ini?{\c}{\i0}
Dialog: 0,0:34:01.45,0:34:03.05, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Vulcan pun tidak mencukupi.{\c}{\i0}
Dialog: 0,0:34:03.08,0:34:04.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak mempunyai sebarang wang.{\c}{\i0}
Dialog: 0,0:34:04.16,0:34:08.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya perlu memburu untuk mendapatkannya, tetapi\NI terlalu sibuk untuk memburu.{\c}{\i0}
Dialog: 0,0:34:11.71,0:34:12.98,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lihat di belakang anda.{\c}{\i0}
Dialog: 0,0:34:13.00,0:34:15.65,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda terus terkena\Nkerana anda hanya melihat ke hadapan.{\c}{\i0}
Dialog: 0,0:34:15.67,0:34:18.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda lihat, ia datang dari\Ndepan apabila saya melihat ke belakang.{\c}{\i0}
Dialog: 0,0:34:18.59,0:34:20.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lihat di belakang anda!{\c}{\i0}
Dialog: 0,0:34:24.22,0:34:26.93,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda marah kerana saya tidak baik dalam hal ini?{\c}{\i0}
Dialog: 0,0:34:27.31,0:34:30.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kami hidup dalam dunia anjing-makan-anjing,{\c}{\i0}
Dialog: 0,0:34:30.35,0:34:33.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi anda perlu lebih berhati-hati.{\c}{\i0}
Dialog: 0,0:34:47.54,0:34:49.21,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Senarai Rakan\NGeonumama{\c}{\i0}
Dialog: 0,0:34:51.00,0:34:52.62,Lalai,,0,0,0,,Ada apa?
Dialog: 0,0:34:54.59,0:34:56.27,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Luar Talian 2 jam, 3 minit, 4 saat{\c}{\i0}
Dialog: 0,0:34:58.17,0:35:00.29,Lalai,,0,0,0,,Da-hye...
Dialog: 0,0:35:02.55,0:35:04.63, Lalai,,0,0,0,,telah dalam talian dua jam lalu.
Dialog: 0,0:35:06.47,0:35:07.53, Lalai,,0,0,0,,Terima kasih banyak-banyak.
Dialog: 0,0:35:07.56,0:35:09.68, Lalai,,0,0,0,, Serius. terima kasih.
Dialog: 0,0:35:10.48,0:35:11.83, Lalai,,0,0,0,,Terima kasih banyak.
Dialog: 0,0:35:11.85,0:35:13.25,Default,,0,0,0,,Pulang dengan selamat, puan.
Dialog: 0,0:35:13.27,0:35:15.27, Lalai,,0,0,0,,Bye.
Dialog: 0,0:35:20.53,0:35:22.09,Lalai,,0,0,0,,Hello, puan.
Dialog: 0,0:35:22.12,0:35:25.69,Lalai,,0,0,0,,Saya baru berjumpa dengan isteri pengarah Sama\NMedical Center.
Dialog: 0,0:35:25.83,0:35:31.14,Lalai,,0,0,0,,Puan perempuan Pengerusi Ryu Seong-gwang berada di bilik VIP mereka.
Dialog: 0,0:35:31.17,0:35:34.41, Lalai,,0,0,0,,Dia sedang berehat selepas menyiapkan dadanya...
Dialog: 0,0:35:38.26,0:35:40.15, Lalai,,0,0,0,,Ya.
Dialog: 0,0:35:40.17,0:35:43.46,Lalai,,0,0,0,,Okey. Nanti saya telefon awak balik.
Dialog: 0,0:35:46.06,0:35:48.59,Lalai,,0,0,0,,Apa yang membawa anda ke sini?
Dialog: 0,0:35:56.86,0:35:59.71,Lalai,,0,0,0,,Saya ingat awak beritahu saya awak tahu sedikit...
Dialog: 0,0:35:59.74,0:36:00.92,Lalai,,0,0,0,,tentang perkara undang-undang,
Dialog: 0,0:36:00.95,0:36:05.27,Lalai,,0,0,0,,sejak anda berada dalam industri kecantikan\Nand mencari jodoh keluarga kaya...
Dialog: 0,0:36:05.32,0:36:07.32, Lalai,,0,0,0,, sepanjang hidup anda.
Dialog: 0,0:36:09.20,0:36:11.10,Lalai,,0,0,0,,- Jadi?\N- Jadi saya di sini untuk memberitahu anda sesuatu.
Dialog: 0,0:36:11.12,0:36:12.52, Lalai,,0,0,0,,Anda sedang menguruskan...
Dialog: 0,0:36:12.54,0:36:16.23, Lalai,,0,0,0,,13 cawangan spa anda yang tidak berdaftar.
Dialog: 0,0:36:16.25,0:36:18.16, Lalai,,0,0,0,,Anda tidak sepatutnya berbuat demikian.
Dialog: 0,0:36:18.67,0:36:20.07, Lalai,,0,0,0,,Lihat.
Dialog: 0,0:36:20.09,0:36:23.36,Lalai,,0,0,0,,Anda meremehkan fakta\Nbahawa saya bekerja lebih keras daripada yang lain.
Dialog: 0,0:36:23.38,0:36:24.90,Lalai,,0,0,0,,Itu menyakitkan perasaan saya.
Dialog: 0,0:36:24.93,0:36:28.45,Lalai,,0,0,0,,Bukan sahaja anda bekerja keras, tetapi anda\Juga mengelak sejumlah besar cukai.
Dialog: 0,0:36:28.47,0:36:31.03, Lalai,,0,0,0,,Aduh, berapa cukai semua ini?
Dialog: 0,0:36:31.06,0:36:32.37, Lalai,,0,0,0,,Berapa banyak...?
Dialog: 0,0:36:32.39,0:36:34.79,Lalai,,0,0,0,,By the way, siapa awak?
Dialog: 0,0:36:34.81,0:36:36.51,Lalai,,0,0,0,,Betul.
Dialog: 0,0:36:39.78,0:36:41.44, Lalai,,0,0,0,,Ini saya.
Dialog: 0,0:36:42.07,0:36:43.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Peguam Kim Yang-gi{\c}{\i0}
Dialog: 0,0:36:43.07,0:36:44.46,Lalai,,0,0,0,,Pn. Ko.
Dialog: 0,0:36:44.49,0:36:48.84,Lalai,,0,0,0,,Anda seperti seorang selebriti dalam bidang kami,\Njadi saya agak terkejut sekarang.
Dialog: 0,0:36:48.87,0:36:51.31,Lalai,,0,0,0,,Mengapa saya terkenal?
Dialog: 0,0:36:51.33,0:36:54.64,Lalai,,0,0,0,,Kerana anda seorang\Npembuat jodoh dan perosak rumah.
Dialog: 0,0:36:54.67,0:36:57.31,Lalai,,0,0,0,,Anda akan melakukan segala-galanya dalam kuasa anda untuk memisahkan pasangan...
Dialog: 0,0:36:57.34,0:36:59.06, Lalai,,0,0,0,,jika mereka tidak membayar anda dengan baik.
Dialog: 0,0:36:59.09,0:37:02.23, Lalai,,0,0,0,,Anda akan membuat laporan palsu tanpa nama\Nand mengupah orang untuk memikat mereka.
Dialog: 0,0:37:02.26,0:37:05.78, Lalai,,0,0,0,,Terima kasih kepada anda, saya mendapat kerja.
Dialog: 0,0:37:05.80,0:37:07.99,Lalai,,0,0,0,,Ini semua pelanggan...
Dialog: 0,0:37:08.01,0:37:10.34, Lalai,,0,0,0,,di firma kami.
Dialog: 0,0:37:10.89,0:37:13.45, Lalai,,0,0,0,,Ini tiada kaitan\Ndengan anda, jadi mengapa anda peduli?
Dialog: 0,0:37:13.48,0:37:15.20,Lalai,,0,0,0,,Pasangan bercerai ini...
Dialog: 0,0:37:15.23,0:37:19.12,Lalai,,0,0,0,,tidak akan duduk diam jika mereka mengetahui kebenarannya.
Dialog: 0,0:37:19.15,0:37:22.34,Lalai,,0,0,0,,Mereka semua panas baran...
Dialog: 0,0:37:22.36,0:37:24.42, Lalai,,0,0,0,, dan daripada latar belakang yang berpengaruh.
Dialog: 0,0:37:24.45,0:37:27.56,Lalai,,0,0,0,,Perhimpunan Negara,\NPPejabat Pendakwaraya, mahkamah...
Dialog: 0,0:37:27.62,0:37:29.32,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:37:29.49,0:37:31.47, Lalai,,0,0,0,,Pengerusi ini...
Dialog: 0,0:37:31.49,0:37:33.95,Lalai,,0,0,0,,adalah bekas samseng.
Dialog: 0,0:37:34.66,0:37:37.37, Lalai,,0,0,0,,Saya faham, jadi diam.
Dialog: 0,0:37:37.79,0:37:39.35, Lalai,,0,0,0,,Kenapa awak buat begini?
Dialog: 0,0:37:39.38,0:37:42.36, Lalai,,0,0,0,,Saya berada di pihak anda jauh di lubuk hati.
Dialog: 0,0:37:42.38,0:37:45.58,Lalai,,0,0,0,,Maka anda harus membuktikannya.
Dialog: 0,0:37:50.81,0:37:52.70, Lalai,,0,0,0,,Tetapi anda lihat...
Dialog: 0,0:37:52.72,0:37:55.01, Lalai,,0,0,0,, Sentimen tidak menggerakkan saya.
Dialog: 0,0:37:55.98,0:37:57.45,Lalai,,0,0,0,,Hanya wang tunai sahaja.
Dialog: 0,0:37:57.48,0:37:58.62, Lalai,,0,0,0,,Saya jujur.
Dialog: 0,0:37:58.65,0:38:03.52,Lalai,,0,0,0,,Mereka menawarkan saya tawaran hebat,\Njadi saya teragak-agak untuk menolaknya,
Dialog: 0,0:38:03.69,0:38:07.88, Lalai,,0,0,0,, jadi pertama sekali, biar saya lihat apa yang anda boleh tawarkan...
Dialog: 0,0:38:07.91,0:38:09.56, Lalai,,0,0,0,, Sial!
Dialog: 0,0:38:09.62,0:38:11.43, Lalai,,0,0,0,,Anda tiada hak untuk tawar-menawar.
Dialog: 0,0:38:11.45,0:38:13.10, Lalai,,0,0,0,,Adakah anda seorang kalkulator?
Dialog: 0,0:38:13.12,0:38:14.60, Lalai,,0,0,0,,Anda sangat cepat berfikir.
Dialog: 0,0:38:14.62,0:38:16.83, Lalai,,0,0,0,,Bagaimanakah anda boleh berfikir untuk membuat perjanjian?
Dialog: 0,0:38:16.86,0:38:17.89,Lalai,,0,0,0,,Astaga.
Dialog: 0,0:38:17.92,0:38:19.89, Lalai,,0,0,0,, Itu sangat keras.
Dialog: 0,0:38:19.92,0:38:23.58,Lalai,,0,0,0,,Jangan bandingkan saya dengan objek.
Dialog: 0,0:38:28.34,0:38:32.80,Lalai,,0,0,0,,Awak kenal saya kan? Saya tidak pernah teragak-agak untuk mengotorkan tangan saya.
Dialog: 0,0:38:33.76,0:38:36.29,Lalai,,0,0,0,,Berhenti mengira melainkan\Anda mahu masuk penjara.
Dialog: 0,0:38:36.31,0:38:37.87, Lalai,,0,0,0,,Bercakap daripada pengalaman,
Dialog: 0,0:38:37.89,0:38:40.50,Lalai,,0,0,0,,kamu jenis perempuan itu...
Dialog: 0,0:38:40.52,0:38:42.64,Lalai,,0,0,0,,paling benci.
Dialog: 0,0:38:54.58,0:38:57.72,Lalai,,0,0,0,,Yoon Eun-sung sangat teliti.
Dialog: 0,0:38:57.75,0:39:00.43, Lalai,,0,0,0,,Tiada apa-apa pada kamera pemuka.
Dialog: 0,0:39:00.46,0:39:03.73, Lalai,,0,0,0,,Saya datang dengan senarai\hospital am peringkat tinggi...
Dialog: 0,0:39:03.75,0:39:07.90,Lalai,,0,0,0,,yang membenarkan pengawal keselamatan dan\Nmempunyai bilik VIP dengan lif peribadi,
Dialog: 0,0:39:07.92,0:39:09.90,Lalai,,0,0,0,,di mana anda boleh menyewakan seluruh tingkat.
Dialog: 0,0:39:09.93,0:39:13.34, Lalai,,0,0,0,,- Saya telah melihat ke dalam mereka.\N- Jadi adakah anda menjumpainya?
Dialog: 0,0:39:13.89,0:39:16.30, Lalai,,0,0,0,,Ia akan mengambil masa beberapa hari.
Dialog: 0,0:39:16.93,0:39:20.58, Lalai,,0,0,0,,Saya rasa kita harus mencari dalam\Nan jam radius pemanduan dari Seoul.
Dialog: 0,0:39:20.60,0:39:21.91, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:39:21.94,0:39:23.46, Lalai,,0,0,0,,Pengerusi Hong sakit tenat.
Dialog: 0,0:39:23.48,0:39:25.54, Lalai,,0,0,0,,Kebanyakan ambulans tidak mempunyai tangki oksigen,
Dialog: 0,0:39:25.57,0:39:28.57, Lalai,,0,0,0,,yang bermaksud pasukan perubatan mesti\N terpaksa memberinya oksigen secara manual.
Dialog: 0,0:39:28.59,0:39:30.96, Lalai,,0,0,0,,Mereka hanya boleh melakukannya selama sejam.
Dialog: 0,0:39:30.99,0:39:33.02, Lalai,,0,0,0,,Ya, itu munasabah.
Dialog: 0,0:39:33.41,0:39:35.76, Lalai,,0,0,0,, Maka itu menolak lima daripada ini.
Dialog: 0,0:39:35.79,0:39:39.53, Lalai,,0,0,0,,Saya akan bertanya dan menyemak yang lain.
Dialog: 0,0:39:39.71,0:39:42.06,Lalai,,0,0,0,,Mari kita kongsi senarai dan lihat juga.
Dialog: 0,0:39:42.08,0:39:43.81,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:39:43.83,0:39:46.40,Lalai,,0,0,0,,Anda seperti sebuah keluarga.
Dialog: 0,0:39:46.42,0:39:48.23, Lalai,,0,0,0,,Saya suka suasana ini.
Dialog: 0,0:39:48.26,0:39:51.50,Lalai,,0,0,0,,Sebelah lagi tidak mesra langsung.
Dialog: 0,0:39:56.14,0:39:58.83,Lalai,,0,0,0,,Adakah anda fikir saya gembira untuk menendang anda keluar?
Dialog: 0,0:39:58.85,0:40:01.76, Lalai,,0,0,0,,Apa khabar anda semua?
Dialog: 0,0:40:02.48,0:40:04.46,Lalai,,0,0,0,,Apa khabar Cik Kim?
Dialog: 0,0:40:04.48,0:40:06.43, Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:40:07.19,0:40:09.63, Lalai,,0,0,0,,Maafkan saya, Mi-seon. Saya sepatutnya pergi.
Dialog: 0,0:40:09.65,0:40:11.96, Lalai,,0,0,0,, Alhamdulillah, kami sudah berada di sini.
Dialog: 0,0:40:11.99,0:40:14.51,Lalai,,0,0,0,,Mereka semua ada di sana dan menunggu untuk meminta maaf.
Dialog: 0,0:40:14.53,0:40:16.72,Lalai,,0,0,0,,Saya sudah tahu apa yang mereka akan katakan.
Dialog: 0,0:40:16.74,0:40:18.97, Lalai,,0,0,0, "Kami tidak tahu anda hadir."
Dialog: 0,0:40:18.99,0:40:22.31, Lalai,,0,0,0, "Kami tidak cuba mencederakan anda. Kami minta maaf."
Dialog: 0,0:40:22.33,0:40:24.35, Lalai,,0,0,0,,Kami tidak tahu anda berada di sini.
Dialog: 0,0:40:24.38,0:40:26.98,Lalai,,0,0,0,,Kami tidak cuba menyinggung perasaan anda.
Dialog: 0,0:40:27.00,0:40:29.79,Lalai,,0,0,0,,Apa pun, kami benar-benar minta maaf.
Dialog: 0,0:40:33.09,0:40:34.49,Lalai,,0,0,0,,Betul ke? awak minta maaf.
Dialog: 0,0:40:34.51,0:40:37.49, Lalai,,0,0,0,,Mereka tidak tahu cerita penuh.
Dialog: 0,0:40:37.51,0:40:41.83, Lalai,,0,0,0,,Tepat sekali. Kami hanya membaca tentang bagaimana anda telah hancur.
Dialog: 0,0:40:41.85,0:40:45.87,Lalai,,0,0,0,,- Betul?\N- Namun, kami tidak mempercayai media.
Dialog: 0,0:40:45.90,0:40:47.83, Lalai,,0,0,0, "Tidak mungkin. Mereka mungkin masih akan berjaya..."
Dialog: 0,0:40:47.86,0:40:49.73, Lalai,,0,0,0,,- "untuk tiga tahun lagi."\N- Betul.
Dialog: 0,0:40:49.75,0:40:51.88,Lalai,,0,0,0,,- Ya.\N- Kami ingin menyemak fakta,
Dialog: 0,0:40:51.90,0:40:54.94, Lalai,,0,0,0,, dan kongsi kebenaran.
Dialog: 0,0:40:55.82,0:40:56.80,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:40:56.82,0:40:58.30,Lalai,,0,0,0,,Saya juga yang bersalah.
Dialog: 0,0:40:58.33,0:40:59.89, Lalai,,0,0,0,,Saya sepatutnya memberitahu anda saya berada di sini.
Dialog: 0,0:40:59.91,0:41:01.69, Lalai,,0,0,0,,- Saya hanya mendengar sahaja.\N- Saya lega.
Dialog: 0,0:41:01.72,0:41:06.06, Lalai,,0,0,0,,Kami akan sering berjumpa,\Njadi saya gembira kami berdamai.
Dialog: 0,0:41:06.08,0:41:08.33, Lalai,,0,0,0,,Betul.
Dialog: 0,0:41:08.38,0:41:09.60, Lalai,,0,0,0,,Ia tidak akan selama itu.
Dialog: 0,0:41:09.63,0:41:11.52,Lalai,,0,0,0,,Kami hanya berehat.
Dialog: 0,0:41:11.55,0:41:13.61,Lalai,,0,0,0,,Kami di sini hanya untuk berehat.
Dialog: 0,0:41:13.63,0:41:19.46,Lalai,,0,0,0,,Kami terlalu kerap pergi ke tempat seperti Bali,\NHawaii dan Cancún,
Dialog: 0,0:41:19.64,0:41:24.30,Lalai,,0,0,0,,jadi kami fikir kami akan melawat\Nan tempat yang luar biasa kali ini.
Dialog: 0,0:41:26.10,0:41:27.64, Lalai,,0,0,0,,"Luar Biasa"?
Dialog: 0,0:41:27.86,0:41:30.38, Lalai,,0,0,0,,Berbanding dengan Cancún? Pasti.
Dialog: 0,0:41:30.40,0:41:33.23, Lalai,,0,0,0,,Yongdu-ri adalah unik,\Nand tiada lautan juga.
Dialog: 0,0:41:33.53,0:41:37.47, Lalai,,0,0,0,,Agak tidak selesa, tetapi\NI rasa ini adalah pengalaman yang baik.
Dialog: 0,0:41:37.49,0:41:40.68,Lalai,,0,0,0,,Bilakah saya akan dapat tinggal di\Ntempat seperti ini lagi?
Dialog: 0,0:41:40.70,0:41:43.43, Lalai,,0,0,0,,Tiada jumlah wang yang boleh membeli pengalaman ini.
Dialog: 0,0:41:43.45,0:41:46.28,Lalai,,0,0,0,,Betul, dan anda juga bangkrut.
Dialog: 0,0:41:47.12,0:41:49.08, Lalai,,0,0,0,,- Maaf?\N- Memang betul awak miskin buat masa ini.
Dialog: 0,0:41:49.11,0:41:51.06,Lalai,,0,0,0,,Aset mereka dibekukan, bukan?
Dialog: 0,0:41:51.09,0:41:53.82,Lalai,,0,0,0,,Ya, tetapi mereka akan mendapatkannya kemudian.
Dialog: 0,0:41:53.84,0:41:56.19,Lalai,,0,0,0,,Betul, tetapi mereka tidak tahu...
Dialog: 0,0:41:56.22,0:41:59.20,Lalai,,0,0,0,,jika mereka masih hidup pada masa itu.
Dialog: 0,0:41:59.22,0:42:02.24, Lalai,,0,0,0,,Keluarga kami memiliki 40 ekar\Nland yang telah menjadi kawasan hijau...
Dialog: 0,0:42:02.26,0:42:03.45, Lalai,,0,0,0,,selama 50 tahun.
Dialog: 0,0:42:03.47,0:42:05.01,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:42:06.60,0:42:07.58, Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,0:42:07.60,0:42:12.64, Lalai,,0,0,0,,Bagaimana dengan kamu semua pergi,\Sekarang kamu sudah berdamai?
Dialog: 0,0:42:12.78,0:42:15.63, Lalai,,0,0,0,,Saya tidak pernah melihat sesiapa meninggalkan bandar kami...
Dialog: 0,0:42:15.65,0:42:19.13, Lalai,,0,0,0,,selepas mengatakan mereka akan melakukannya.
Dialog: 0,0:42:19.16,0:42:21.68, Lalai,,0,0,0,,Maafkan saya, tetapi apa yang anda perolehi?
Dialog: 0,0:42:21.70,0:42:23.60, Lalai,,0,0,0,,Saya cuma ada firasat...
Dialog: 0,0:42:23.62,0:42:26.97,Lalai,,0,0,0,,bahawa kita akan sering berjumpa\Nother untuk masa yang lama,
Dialog: 0,0:42:27.00,0:42:28.87, Lalai,,0,0,0,, dan saya gembira mengenainya.
Dialog: 0,0:42:29.79,0:42:31.39,Lalai,,0,0,0,,Mari kita pergi.
Dialog: 0,0:42:31.42,0:42:32.90, Lalai,,0,0,0,,- Pergi?\N- Ya, pergi.
Dialog: 0,0:42:32.92,0:42:34.73, Lalai,,0,0,0,,- Sekarang?\N- Ya, sekarang.
Dialog: 0,0:42:34.76,0:42:37.29, Lalai,,0,0,0,,- Bye.\N- Kita pergi sekarang.
Dialog: 0,0:42:37.42,0:42:39.13,Lalai,,0,0,0,,Apa...?
Dialog: 0,0:42:39.59,0:42:41.49,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:42:41.51,0:42:43.28,Lalai,,0,0,0,,Saya sangat tertekan.
Dialog: 0,0:42:43.31,0:42:44.84, Lalai,,0,0,0,,Kafein.
Dialog: 0,0:42:44.97,0:42:46.51,Lalai,,0,0,0,,Kafein!
Dialog: 0,0:42:49.60,0:42:53.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Taman Jun{\c}{\i0}
Dialog: 0,0:42:53.19,0:42:54.78,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Sila Bayar Awal{\c}{\i0}
Dialog: 0,0:43:12.59,0:43:16.20,Lalai,,0,0,0,,Saya ingin memesan.
Dialog: 0,0:43:16.76,0:43:17.82, Lalai,,0,0,0,,Sila ambil pesanan saya.
Dialog: 0,0:43:17.84,0:43:20.79,Lalai,,0,0,0,,Kami menerima pesanan di sini.
Dialog: 0,0:43:28.31,0:43:30.30, Lalai,,0,0,0,,Dua syot espreso.
Dialog: 0,0:43:31.31,0:43:32.54, Lalai,,0,0,0,,Itu akan menjadi $3.20.
Dialog: 0,0:43:32.56,0:43:34.58,Lalai,,0,0,0,,- Adakah anda mempunyai kad gabungan?\N- Tidak mengapa.
Dialog: 0,0:43:34.61,0:43:36.14, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:43:40.74,0:43:42.52, Lalai,,0,0,0,,Ia tidak berfungsi.
Dialog: 0,0:43:48.04,0:43:50.16,Lalai,,0,0,0,,Macam mana nak bayar puan?
Dialog: 0,0:43:51.83,0:43:55.10,Lalai,,0,0,0,,Lihat. Saya sangat memerlukan kopi.
Dialog: 0,0:43:55.13,0:43:59.11,Lalai,,0,0,0,,Boleh saya minum dulu, kemudian bayar awak kemudian?
Dialog: 0,0:43:59.13,0:44:01.67,Lalai,,0,0,0,,Minum dulu, bayar kemudian.
Dialog: 0,0:44:02.43,0:44:03.53, Lalai,,0,0,0,,Bolehkah saya berbuat demikian?
Dialog: 0,0:44:03.55,0:44:06.82,Lalai,,0,0,0,,Maaf, tetapi ada talian.
Dialog: 0,0:44:06.85,0:44:08.76, Lalai,,0,0,0,,Bolehkah anda mengetepikan?
Dialog: 0,0:44:13.10,0:44:14.21, Lalai,,0,0,0,,Helo.
Dialog: 0,0:44:14.23,0:44:15.75,Lalai,,0,0,0,,Sepuluh orang Amerika ais,
Dialog: 0,0:44:15.77,0:44:19.09,Lalai,,0,0,0,,sepuluh latte ais, bekas sirap,
Dialog: 0,0:44:19.11,0:44:20.75, Lalai,,0,0,0,,dan satu lagi penuh dengan ketulan ais.
Dialog: 0,0:44:20.78,0:44:22.46, Lalai,,0,0,0,,- Okay?\N- Pasti. saya tahu.
Dialog: 0,0:44:22.49,0:44:25.88,Lalai,,0,0,0,,Selain itu, saya juga ingin membayar untuknya.
Dialog: 0,0:44:25.91,0:44:27.48,Lalai,,0,0,0,,Okey.
Dialog: 0,0:44:28.54,0:44:32.11, Lalai,,0,0,0,,Mengapa anda minum kopi\Napabila anda tidak boleh tidur lena?
Dialog: 0,0:44:32.83,0:44:36.37, Lalai,,0,0,0,, Bagaimanapun, terima kasih untuk kopi.
Dialog: 0,0:44:37.96,0:44:39.54,Lalai,,0,0,0,,Tidak perlu berterima kasih kepada saya.
Dialog: 0,0:44:40.05,0:44:42.46, Lalai,,0,0,0,,Ia bukan percuma.
Dialog: 0,0:44:56.69,0:44:58.54,Lalai,,0,0,0,,Baiklah, mari mulakan.
Dialog: 0,0:44:58.57,0:45:00.29,Lalai,,0,0,0,,- Okay.\N- Natasha.
Dialog: 0,0:45:00.32,0:45:01.85, Lalai,,0,0,0,,Ya?
Dialog: 0,0:45:01.99,0:45:03.46,Lalai,,0,0,0,,Jadilah mentornya untuk hari itu.
Dialog: 0,0:45:03.49,0:45:05.36,Lalai,,0,0,0,,Okey.
Dialog: 0,0:45:08.78,0:45:10.49,Lalai,,0,0,0,,Nepotisme?
Dialog: 0,0:45:12.50,0:45:14.35, Lalai,,0,0,0,,Adakah anda bercakap dengan saya, wanita muda?
Dialog: 0,0:45:14.37,0:45:16.98,Lalai,,0,0,0,,Ya, saya bercakap dengan awak.
Dialog: 0,0:45:17.00,0:45:19.60,Lalai,,0,0,0,,Kenapa awak bercakap dengan santai?\NI lebih tua daripada awak.
Dialog: 0,0:45:19.63,0:45:21.65, Lalai,,0,0,0,,Saya bukan wanita muda. Saya senior awak.
Dialog: 0,0:45:21.67,0:45:22.98,Lalai,,0,0,0,,Adakah anda tahu maksudnya?
Dialog: 0,0:45:23.01,0:45:25.49, Lalai,,0,0,0,,Ya, masa telah berubah.
Dialog: 0,0:45:25.51,0:45:28.86,Lalai,,0,0,0,,Saya tidak berani memijak bayang\Norang tua saya pada zaman dahulu.
Dialog: 0,0:45:28.89,0:45:30.70,Lalai,,0,0,0,,Apa? bayang apa?
Dialog: 0,0:45:30.72,0:45:32.16, Lalai,,0,0,0,,Adakah dia seorang boomer, atau apa?
Dialog: 0,0:45:32.18,0:45:34.62,Lalai,,0,0,0,,Anda tidak mahu belajar? Lupakan saja.
Dialog: 0,0:45:34.64,0:45:36.54, Lalai,,0,0,0,, Baik. Apa yang saya patut buat?
Dialog: 0,0:45:36.56,0:45:38.42,Lalai,,0,0,0,,Ikuti saya.
Dialog: 0,0:45:38.44,0:45:39.73,Lalai,,0,0,0,,Cepat.
Dialog: 0,0:45:39.76,0:45:40.75,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:45:40.77,0:45:43.00, Lalai,,0,0,0,,Saya hanya akan menunjukkan sekali sahaja.
Dialog: 0,0:45:43.03,0:45:44.96, Lalai,,0,0,0,,Lakukan ini. Kemudian ini.
Dialog: 0,0:45:44.99,0:45:47.98,Lalai,,0,0,0,,Kemudian begini.
Dialog: 0,0:45:48.41,0:45:50.28, Lalai,,0,0,0,, Giliran anda.
Dialog: 0,0:45:55.58,0:45:56.85, Lalai,,0,0,0,,Macam ini?
Dialog: 0,0:45:56.87,0:45:59.60, Lalai,,0,0,0,,Pegang bahagian ini.
Dialog: 0,0:45:59.63,0:46:02.06, Lalai,,0,0,0,,Tidak, bukan seperti itu.
Dialog: 0,0:46:02.09,0:46:03.61, Lalai,,0,0,0,,Awak suruh saya tahan!
Dialog: 0,0:46:03.63,0:46:06.61, Lalai,,0,0,0,,Adakah bahasa Korea sesukar itu? tak faham ke?
Dialog: 0,0:46:06.63,0:46:09.84, Lalai,,0,0,0,, Tahan seperti ini.
Dialog: 0,0:46:13.72,0:46:15.03,Lalai,,0,0,0,,Pn. Jeon!
Dialog: 0,0:46:15.06,0:46:18.30, Lalai,,0,0,0,,Anda patut memecatnya. Dia hilang punca.
Dialog: 0,0:46:19.44,0:46:22.13, Lalai,,0,0,0,,- Astaga.\N- Apa? awak adalah.
Dialog: 0,0:46:22.15,0:46:23.79, Lalai,,0,0,0,,Pasti nepotisme terlibat.
Dialog: 0,0:46:23.82,0:46:25.64, Lalai,,0,0,0,, Astaga!
Dialog: 0,0:46:25.99,0:46:27.81, Lalai,,0,0,0,, Tengok awak.
Dialog: 0,0:46:45.46,0:46:47.48,Lalai,,0,0,0,,Anda tidak tersesat.
Dialog: 0,0:46:47.51,0:46:49.28,Lalai,,0,0,0,,Jadi adakah anda mahu pelukan?
Dialog: 0,0:46:49.30,0:46:51.63, Lalai,,0,0,0,,Tidak, terima kasih. Adakah anda membawanya?
Dialog: 0,0:46:52.47,0:46:55.42,Lalai,,0,0,0,,Anda tahu ini satu pelanggaran\Nof undang-undang buruh, bukan?
Dialog: 0,0:47:01.40,0:47:03.21,Lalai,,0,0,0,,Saya sepatutnya berada di ladang sekarang,
Dialog: 0,0:47:03.23,0:47:06.52, Lalai,,0,0,0,,membakar pizza dengan keju organik.
Dialog: 0,0:47:11.20,0:47:12.86, Lalai,,0,0,0,,Adakah anda mahu pelukan?
Dialog: 0,0:47:13.03,0:47:14.73, Lalai,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:47:15.79,0:47:17.31, Lalai,,0,0,0,,Saya tidak faham.
Dialog: 0,0:47:17.33,0:47:20.66,Lalai,,0,0,0,,Mengapa anda memilih untuk\Nmenginap di bekas mertua anda?
Dialog: 0,0:47:21.29,0:47:24.69, Lalai,,0,0,0,,Kami tergesa-gesa dan baru\Nberada di sini sebentar.
Dialog: 0,0:47:24.71,0:47:26.44,Lalai,,0,0,0,,Namun, saya tidak akan datang ke sini.
Dialog: 0,0:47:26.46,0:47:28.90,Lalai,,0,0,0,,Katakan saya terpaksa memilih\Nantara penjara dan mertua saya.
Dialog: 0,0:47:28.92,0:47:31.44, Lalai,,0,0,0,,- Saya akan memilih yang pertama.\N- Tidak boleh.
Dialog: 0,0:47:31.47,0:47:35.13, Lalai,,0,0,0,,Sekurang-kurangnya saya tidak perlu memasak di penjara.
Dialog: 0,0:47:35.60,0:47:39.63,Lalai,,0,0,0,,Ibu mertua saya memasak segala-galanya.\NKami mempunyai {\i1}japchae{\i0} dan tulang rusuk untuk sarapan.
Dialog: 0,0:47:39.81,0:47:42.08,Lalai,,0,0,0,,Aduh, awak cakap "mak mertua."
Dialog: 0,0:47:42.10,0:47:43.71,Lalai,,0,0,0,,Jujurlah. Adakah perceraian itu palsu?
Dialog: 0,0:47:43.73,0:47:46.79,Lalai,,0,0,0,,- Apa yang kamu katakan?\N- Jika tidak, bagaimana kamu boleh menjadi begitu penyayang?
Dialog: 0,0:47:46.82,0:47:49.81,Lalai,,0,0,0,,Saya tidak penyayang. Awak silap.
Dialog: 0,0:47:49.86,0:47:54.34,Lalai,,0,0,0,,Kenapa Encik Baek masih bekerja,\Walaupun selepas penghinaan yang dia terima?
Dialog: 0,0:47:54.37,0:47:56.76,Lalai,,0,0,0,,Apakah penghinaan yang dia dapat?
Dialog: 0,0:47:56.79,0:47:58.76, Lalai,,0,0,0,,Saya rasa anda tidak mendengar.
Dialog: 0,0:47:58.79,0:48:00.52, Lalai,,0,0,0,,Saya dengar semasa dalam perjalanan ke sini.
Dialog: 0,0:48:00.54,0:48:02.68, Lalai,,0,0,0,,Dia sedang menunggu untuk ditugaskan semula.
Dialog: 0,0:48:02.71,0:48:05.49, Lalai,,0,0,0,,Menunggu untuk ditugaskan semula? untuk apa?
Dialog: 0,0:48:05.84,0:48:07.94, Lalai,,0,0,0,,Sesetengah penyelewengan atau sesuatu.
Dialog: 0,0:48:07.96,0:48:10.79,Lalai,,0,0,0,,Mereka akan mengadakan jawatankuasa kakitangan tidak lama lagi.
Dialog: 0,0:48:12.05,0:48:13.84,Lalai,,0,0,0,,Penyelewengan?
Dialog: 0,0:48:13.97,0:48:15.45,Lalai,,0,0,0,,Apa jenis?
Dialog: 0,0:48:15.47,0:48:17.95,Lalai,,0,0,0,,Pasukan audit tidak menemui apa-apa padanya.
Dialog: 0,0:48:17.97,0:48:20.41,Lalai,,0,0,0,,Dia menerima rasuah daripada firma guaman.
Dialog: 0,0:48:20.43,0:48:21.58,Lalai,,0,0,0,,Apa?
Dialog: 0,0:48:21.60,0:48:22.83, Lalai,,0,0,0,, Tunggu.
Dialog: 0,0:48:22.85,0:48:24.66, Lalai,,0,0,0,,Adakah dia menggelapkan wang daripada kos buruh?
Dialog: 0,0:48:24.69,0:48:27.42,Lalai,,0,0,0,,{\i1}Dia memberikan syarikat saingan\Na senarai pelanggan VIP kami.{\i0}
Dialog: 0,0:48:27.44,0:48:29.34,Lalai,,0,0,0,,Ada banyak lagi yang boleh saya buat.
Dialog: 0,0:48:29.36,0:48:32.65, Lalai,,0,0,0,,Jadi anda akan membuat tuduhan palsu?
Dialog: 0,0:48:32.82,0:48:34.36,Lalai,,0,0,0,,Adakah itu?
Dialog: 0,0:48:34.70,0:48:37.18,Lalai,,0,0,0,,Saya sedang berdebat yang mana satu untuk digunakan,
Dialog: 0,0:48:37.20,0:48:41.03, Lalai,,0,0,0,,tetapi apa pun, dia akan menjadi bekas banduan.
Dialog: 0,0:48:48.09,0:48:50.52,Lalai,,0,0,0,,Hei, kamu pulang bersama.
Dialog: 0,0:48:50.55,0:48:52.37,Lalai,,0,0,0,,Betul.
Dialog: 0,0:48:52.51,0:48:56.50,Lalai,,0,0,0,,Saya ada janji temu di Seoul.
Dialog: 0,0:48:59.26,0:49:00.80, Lalai,,0,0,0,,Hei.
Dialog: 0,0:49:01.89,0:49:03.24, Lalai,,0,0,0,,Saya berfikir panjang dan keras.
Dialog: 0,0:49:03.27,0:49:05.01, Lalai,,0,0,0,,- "Perlukah saya beritahu dia ini?"\N- Kalau begitu jangan.
Dialog: 0,0:49:05.03,0:49:07.25,Lalai,,0,0,0,,Adakah anda tahu siapa yang datang malam tadi?
Dialog: 0,0:49:07.27,0:49:08.81, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:49:08.90,0:49:12.05, Lalai,,0,0,0,, Anda lakukan? Jadi anda tahu\NYoon Eun-sung melawat Hae-in.
Dialog: 0,0:49:12.07,0:49:13.69, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:49:14.03,0:49:17.05,Lalai,,0,0,0,,Tetapi kenapa dia diam-diam melawat\Nher pada tengah malam?
Dialog: 0,0:49:17.07,0:49:18.97, Lalai,,0,0,0,,Adakah sesuatu berlaku di antara mereka?
Dialog: 0,0:49:18.99,0:49:21.14,Lalai,,0,0,0,,Jangan mengarut.
Dialog: 0,0:49:21.16,0:49:23.57, Lalai,,0,0,0,,Jangan bentak saya.
Dialog: 0,0:49:23.62,0:49:26.68, Lalai,,0,0,0,,Saya tidak membentak awak,\Nand tiada apa-apa yang berlaku.
Dialog: 0,0:49:26.71,0:49:28.69, Lalai,,0,0,0,,Tiada apa-apa yang berlaku.
Dialog: 0,0:49:28.71,0:49:30.62, Lalai,,0,0,0,,Anda tidak tahu apa-apa.
Dialog: 0,0:49:32.34,0:49:34.96,Lalai,,0,0,0,,Apa masalah dia?
Dialog: 0,0:49:35.84,0:49:37.38, Lalai,,0,0,0,,Tidak boleh.
Dialog: 0,0:49:37.43,0:49:38.99,Lalai,,0,0,0,,Adakah dia cemburu?
Dialog: 0,0:49:39.01,0:49:42.24,Lalai,,0,0,0,,Hae-in tidak berganjak pun\Selepas mendengar tentang So-yeong...
Dialog: 0,0:49:42.27,0:49:43.41,Lalai,,0,0,0,,Tetapi Hyun-woo...
Dialog: 0,0:49:43.43,0:49:44.79,Lalai,,0,0,0,,Astaga.
Dialog: 0,0:49:44.81,0:49:46.45, Lalai,,0,0,0,,Bodoh betul.
Dialog: 0,0:49:46.48,0:49:48.01, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:49:49.19,0:49:51.17, Lalai,,0,0,0,,Bagus hari ini!
Dialog: 0,0:49:51.19,0:49:52.79, Lalai,,0,0,0,,Terima kasih!
Dialog: 0,0:49:52.82,0:49:55.59,Lalai,,0,0,0,,- Mari kita mulakan dengan Natasha.\N- Okay.
Dialog: 0,0:49:55.61,0:49:58.80,Lalai,,0,0,0,,Anda memilih 4000, yang menjadikan jumlah keseluruhan $280,
Dialog: 0,0:49:58.82,0:50:01.44, Lalai,,0,0,0,,tetapi saya akan beri anda $300.
Dialog: 0,0:50:02.79,0:50:05.47, Lalai,,0,0,0,, Bagi anda pula, anda memilih 70, yang menjadikan...
Dialog: 0,0:50:05.50,0:50:07.06, Lalai,,0,0,0,,jumlah $4.90.
Dialog: 0,0:50:07.08,0:50:09.81, Lalai,,0,0,0,,Anda berhutang kopi kepada saya, jadi anda akan mendapat 1700 secara keseluruhan.
Dialog: 0,0:50:09.84,0:50:12.06, Lalai,,0,0,0,,- Cik Lee Su-gyeong?\N- Di sini.
Dialog: 0,0:50:12.09,0:50:13.86, Lalai,,0,0,0,,- Kerja bagus.\N- Terima kasih!
Dialog: 0,0:50:13.88,0:50:15.15, Lalai,,0,0,0,,- Cik Park Seon-nyeo?\N- Sini.
Dialog: 0,0:50:15.17,0:50:16.75, Lalai,,0,0,0,,- Kerja bagus.\N- Baik.
Dialog: 0,0:50:39.07,0:50:41.98,Lalai,,0,0,0,,Sayang, inilah pil tidur awak.
Dialog: 0,0:50:55.38,0:50:57.53, Lalai,,0,0,0,,Kebaikan, Sayang.
Dialog: 0,0:50:57.55,0:51:01.63, Lalai,,0,0,0,,Anda sudah lama tidak tidur lena tanpa\Nany ubat.
Dialog: 0,0:51:34.25,0:51:37.15, Lalai,,0,0,0,,Kenapa awak minum seorang diri pada jam ini?
Dialog: 0,0:51:37.17,0:51:38.61, Lalai,,0,0,0,,Nah...
Dialog: 0,0:51:38.63,0:51:41.20,Lalai,,0,0,0,,Saya berasa muram, sekarang saya telah\Nberundur dari kedudukan saya.
Dialog: 0,0:51:41.22,0:51:45.05, Lalai,,0,0,0,,Saya hanyalah ketua kampung\Bukan kejiranan kecil ini.
Dialog: 0,0:51:51.98,0:51:53.96,Lalai,,0,0,0,,Saya boleh faham.
Dialog: 0,0:51:53.98,0:51:55.29, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:51:55.32,0:51:57.64, Lalai,,0,0,0,,- Betul ke?\N- Tengok.
Dialog: 0,0:51:58.11,0:52:00.92, Lalai,,0,0,0,,Bateri saya masih separuh penuh pada jam ini,
Dialog: 0,0:52:00.95,0:52:02.73, Lalai,,0,0,0,,memandangkan tiada siapa yang menghubungi saya.
Dialog: 0,0:52:04.53,0:52:05.97, Lalai,,0,0,0,,Tiada sesiapa pun yang angkat.
Dialog: 0,0:52:05.99,0:52:10.10,Lalai,,0,0,0,,Semasa saya menjadi naib pengerusi,\NI hampir tidak pernah mendengar mesej itu...
Dialog: 0,0:52:10.12,0:52:12.60, Lalai,,0,0,0,,yang dimainkan apabila anda tidak mengambilnya,
Dialog: 0,0:52:12.62,0:52:15.08, Lalai,,0,0,0,,tetapi saya mendengarnya setiap hari sekarang.
Dialog: 0,0:52:18.26,0:52:19.61, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:52:19.63,0:52:22.21, Lalai,,0,0,0,,Inilah pengakhiran pemerintahan kita.
Dialog: 0,0:52:23.22,0:52:26.78,Lalai,,0,0,0,,Saya bersetuju dengan pepatah bahawa\Bayang-bayang anda tidak meninggalkan anda...
Dialog: 0,0:52:26.81,0:52:28.67, Lalai,,0,0,0,,dalam masa gelap.
Dialog: 0,0:52:36.48,0:52:38.14,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:52:42.57,0:52:44.69,Lalai,,0,0,0,,Adakah anda mempunyai sebarang {\i1}makgeolli?{\i0}
Dialog: 0,0:52:45.20,0:52:48.01, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ayah! Anda kata Chemicals and Motors adalah milik saya.{\c}{\i0}
Dialog: 0,0:52:48.03,0:52:49.14,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kemudian putuslah dengan dia.{\c}{\i0}
Dialog: 0,0:52:49.16,0:52:52.77,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika tidak, anda tidak akan mendapat syarikat saya!{\c}{\i0}
Dialog: 0,0:52:52.79,0:52:54.89,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tidak, saya enggan berpisah dengannya.{\c}{\i0}
Dialog: 0,0:52:54.92,0:52:56.23,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa yang anda katakan?{\c}{\i0}
Dialog: 0,0:52:56.25,0:52:57.90,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Tidak pernah.\N- Beraninya anda?{\c}{\i0}
Dialog: 0,0:52:57.92,0:52:59.86, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Berhenti! Berhenti di situ!{\c}{\i0}
Dialog: 0,0:52:59.88,0:53:03.48,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}CEO Jang dan Tiga Anak Lelakinya{\c}{\i0}
Dialog: 0,0:53:03.51,0:53:05.33, Lalai,,0,0,0,,{\an8}Ayuh, sekarang.
Dialog: 0,0:53:05.47,0:53:07.53, Lalai,,0,0,0,,Mereka sentiasa menamatkannya di bahagian yang terbaik.
Dialog: 0,0:53:07.55,0:53:09.09, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:53:09.97,0:53:12.05, Lalai,,0,0,0,,Adakah mereka benar-benar berbuat demikian?
Dialog: 0,0:53:12.52,0:53:13.49,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:53:13.52,0:53:16.68,Lalai,,0,0,0,,Begitukah cara hidup orang kaya?
Dialog: 0,0:53:17.11,0:53:18.12, Lalai,,0,0,0,,Saya mohon berbeza.
Dialog: 0,0:53:18.15,0:53:20.38,Lalai,,0,0,0,,Drama-drama tu buat saya terfikir...
Dialog: 0,0:53:20.40,0:53:23.34, Lalai,,0,0,0,,penulis tidak membuat kajian mereka dengan betul.
Dialog: 0,0:53:23.36,0:53:25.06, Lalai,,0,0,0,, Kenapa?
Dialog: 0,0:53:25.24,0:53:28.01,Lalai,,0,0,0,,Watak-watak itu sering\Nkelihatan memegang leher mereka,
Dialog: 0,0:53:28.03,0:53:32.14,Lalai,,0,0,0,,tetapi orang kaya sangat ketat\Mengenai tekanan darah mereka.
Dialog: 0,0:53:32.16,0:53:36.10,Lalai,,0,0,0,,- Lagipun, kita ada doktor tinggal.\N- Doktor tinggal?
Dialog: 0,0:53:36.12,0:53:39.31, Lalai,,0,0,0,,Mereka mengeluarkan natrium daripada diet kita\Jika tekanan darah kita meningkat sedikit pun.
Dialog: 0,0:53:39.34,0:53:41.54, Lalai,,0,0,0,,Mereka mengalih keluar semuanya.
Dialog: 0,0:53:42.21,0:53:45.69,Lalai,,0,0,0,,Dan semua rumah mempunyai\Ntangga di ruang tamu.
Dialog: 0,0:53:45.72,0:53:49.28,Lalai,,0,0,0,,Tepat sekali. Anda semua tidak memilikinya, bukan?
Dialog: 0,0:53:49.30,0:53:50.87, Lalai,,0,0,0,,Ia bukan gedung opera.
Dialog: 0,0:53:50.89,0:53:54.70,Lalai,,0,0,0,,Kita semua lakukan, dan kita sering menggunakannya untuk naik ke tingkat atas,
Dialog: 0,0:53:54.73,0:53:58.68, Lalai,,0,0,0,,tetapi kami menaiki lif apabila\Turun untuk melindungi lutut kami.
Dialog: 0,0:53:58.90,0:54:03.06, Lalai,,0,0,0,,Penulis perlu melakukan penyelidikan yang lebih baik.
Dialog: 0,0:54:07.41,0:54:09.32, Lalai,,0,0,0,,Ini betul.
Dialog: 0,0:54:23.80,0:54:25.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Adakah anda sedang tidur?{\c}{\i0}
Dialog: 0,0:54:34.60,0:54:36.97,Lalai,,0,0,0,,{\i1}Hae-in, awak tidur?{\i0}
Dialog: 0,0:54:46.78,0:54:48.31,Lalai,,0,0,0,,Apa?
Dialog: 0,0:54:49.78,0:54:51.65, Lalai,,0,0,0,,Sebutkan apa yang perlu anda katakan.
Dialog: 0,0:54:54.33,0:54:56.85,Lalai,,0,0,0,,Saya dengar Eun-sung datang semalam.
Dialog: 0,0:54:56.87,0:54:58.10,Lalai,,0,0,0,,Adakah Soo-cheol memberitahu anda?
Dialog: 0,0:54:58.12,0:55:00.41, Lalai,,0,0,0,,Itu tidak penting.
Dialog: 0,0:55:01.54,0:55:03.23, Lalai,,0,0,0,,Apa yang dia cakap?
Dialog: 0,0:55:03.25,0:55:06.00, Lalai,,0,0,0,,Dia cuma tanya kenapa saya ada di sini.
Dialog: 0,0:55:07.17,0:55:08.96, Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:55:09.55,0:55:10.53, Lalai,,0,0,0,,Apa lagi?
Dialog: 0,0:55:10.55,0:55:12.15,Lalai,,0,0,0,,Dia juga memberitahu saya...
Dialog: 0,0:55:12.18,0:55:13.91, Lalai,,0,0,0,,untuk berfungsi semula,
Dialog: 0,0:55:13.93,0:55:15.03, Lalai,,0,0,0,,dan pulang ke rumah.
Dialog: 0,0:55:15.06,0:55:16.37, Lalai,,0,0,0,, Pulang?
Dialog: 0,0:55:16.39,0:55:17.49,Lalai,,0,0,0,,Ya.
Dialog: 0,0:55:17.52,0:55:20.97, Lalai,,0,0,0,,Adakah dia akan berpindah jika anda melakukannya?
Dialog: 0,0:55:21.94,0:55:23.67, Lalai,,0,0,0,,Dia akan kekal?
Dialog: 0,0:55:23.69,0:55:25.00, Lalai,,0,0,0,,Nah...
Dialog: 0,0:55:25.03,0:55:27.00, Lalai,,0,0,0,,Kami tidak bercakap secara terperinci.
Dialog: 0,0:55:27.03,0:55:29.17, Lalai,,0,0,0,,Adakah dia mahu tinggal bersama kamu?
Dialog: 0,0:55:29.20,0:55:30.67, Lalai,,0,0,0,,Kamu berdua tidak bersama.
Dialog: 0,0:55:30.70,0:55:32.38,Lalai,,0,0,0,,Kami juga begitu, tetapi lihatlah kami.
Dialog: 0,0:55:32.41,0:55:35.36, Lalai,,0,0,0,,Tidak, kami berbeza. Kami adalah...
Dialog: 0,0:55:37.41,0:55:39.35,Lalai,,0,0,0,,berkahwin.
Dialog: 0,0:55:39.37,0:55:41.37, Lalai,,0,0,0,,Tetapi tidak lagi.
Dialog: 0,0:55:42.08,0:55:45.83, Lalai,,0,0,0,,Anda telah membantu saya setakat ini,\Nand saya rasa anda telah melakukan cukup.
Dialog: 0,0:55:46.63,0:55:47.61,Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:55:47.63,0:55:50.21,Lalai,,0,0,0,,Saya dengar anda sedang menunggu untuk ditugaskan.
Dialog: 0,0:55:50.26,0:55:52.00, Lalai,,0,0,0,,Kenapa awak tak beritahu saya?
Dialog: 0,0:55:52.47,0:55:53.45,Lalai,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:55:53.47,0:55:55.70,Lalai,,0,0,0,,Bagaimana ia tiada apabila\Nsebabnya ialah penyelewengan?
Dialog: 0,0:55:55.72,0:55:58.11, Lalai,,0,0,0,,Siapa tahu pada dokumen apa\Nmereka memalsukan tandatangan anda?
Dialog: 0,0:55:58.14,0:56:00.70, Lalai,,0,0,0,,Penggelapan? Sesuatu yang menyalahi undang-undang?\Ndia mampu melakukan apa sahaja.
Dialog: 0,0:56:00.72,0:56:02.71,Lalai,,0,0,0,,Anda tidak perlu risau tentang saya.
Dialog: 0,0:56:02.73,0:56:05.89,Lalai,,0,0,0,,Anda tidak mahu risau tentang saya.
Dialog: 0,0:56:06.23,0:56:08.35, Lalai,,0,0,0,,Begitu juga dengan saya.
Dialog: 0,0:56:09.69,0:56:12.02, Lalai,,0,0,0,,Saya akan uruskan isu saya sendiri.
Dialog: 0,0:56:13.70,0:56:15.18,Lalai,,0,0,0,,Saya rasa tidak selesa...
Dialog: 0,0:56:15.20,0:56:18.03, Lalai,,0,0,0,,bahawa awak menderita sia-sia kerana saya.
Dialog: 0,0:56:22.67,0:56:25.66, Lalai,,0,0,0,,Jangan dingin sangat.
Dialog: 0,0:56:26.34,0:56:27.98,Lalai,,0,0,0,,Saya hanya melakukannya untuk anda...
Dialog: 0,0:56:28.00,0:56:30.41, Lalai,,0,0,0,,Jangan buat apa-apa untuk saya.
Dialog: 0,0:56:32.43,0:56:35.42,Lalai,,0,0,0,,Saya akan cari penyelesaian saya sendiri.
Dialog: 0,0:57:47.71,0:57:49.44, Lalai,,0,0,0,,Helo, Doktor.
Dialog: 0,0:57:49.46,0:57:52.58,Lalai,,0,0,0,,Ya, saya sedang makan ubat,
Dialog: 0,0:57:52.67,0:57:55.78,Lalai,,0,0,0,,tetapi saya sering sakit kepala sejak kebelakangan ini.
Dialog: 0,0:57:55.80,0:57:59.30,Lalai,,0,0,0,,Saya telah memberikan diri saya\Nsuntikan WBC setiap hari.
Dialog: 0,0:58:01.01,0:58:04.74, Lalai,,0,0,0,,Tumor nampaknya tidak\N telah tumbuh dalam foto terkini.
Dialog: 0,0:58:04.77,0:58:06.97, Lalai,,0,0,0,,Mungkinkah ia sesuatu yang lain?
Dialog: 0,0:58:07.98,0:58:08.96, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:58:08.98,0:58:10.76, Lalai,,0,0,0,, Bangun.
Dialog: 0,0:58:11.23,0:58:12.89, Lalai,,0,0,0,,Bangun sekarang.
Dialog: 0,0:58:14.99,0:58:16.69, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:58:16.82,0:58:18.88, Lalai,,0,0,0,, Beritahu saya perkara sebenar.
Dialog: 0,0:58:18.91,0:58:22.23,Lalai,,0,0,0,,Hae-in sakit, bukan?
Dialog: 0,0:58:23.75,0:58:26.39, Lalai,,0,0,0,, Beritahu saya. Dia bersikap pelik sejak kebelakangan ini.
Dialog: 0,0:58:26.41,0:58:28.06, Lalai,,0,0,0,,Dia juga pengsan kali terakhir.
Dialog: 0,0:58:28.08,0:58:30.27,Lalai,,0,0,0,,Saya rasa dia sedang menyuntik dirinya juga.
Dialog: 0,0:58:30.29,0:58:32.70, Lalai,,0,0,0,,Saya rasa ada sesuatu yang berlaku.
Dialog: 0,0:58:35.76,0:58:39.17, Lalai,,0,0,0,,Dia mahu ia menjadi rahsia,
Dialog: 0,0:58:40.30,0:58:41.84,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:58:42.72,0:58:45.87,Lalai,,0,0,0,,Saya perlukan awak untuk menjaganya apabila saya tiada,
Dialog: 0,0:58:45.89,0:58:47.20,Lalai,,0,0,0,,jadi saya akan beritahu awak.
Dialog: 0,0:58:47.23,0:58:49.01, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:58:56.24,0:58:57.94,Lalai,,0,0,0,,Dia telah...
Dialog: 0,0:58:59.91,0:59:01.69, Lalai,,0,0,0,, tumor otak,
Dialog: 0,0:59:03.83,0:59:05.36, Lalai,,0,0,0,,tetapi...
Dialog: 0,0:59:05.41,0:59:07.45, Lalai,,0,0,0,,besar,
Dialog: 0,0:59:08.83,0:59:10.82, Lalai,,0,0,0,,dan ia adalah kes yang jarang berlaku,
Dialog: 0,0:59:11.17,0:59:13.44, Lalai,,0,0,0,,jadi dia tidak boleh menjalani pembedahan sekarang.
Dialog: 0,0:59:13.46,0:59:16.83, Lalai,,0,0,0,,Dia memantaunya semasa mengambil ubat.
Dialog: 0,0:59:23.72,0:59:25.37, Lalai,,0,0,0,,Tetapi kadar...
Dialog: 0,0:59:25.39,0:59:27.30, Lalai,,0,0,0,,tidak tinggi.
Dialog: 0,0:59:28.81,0:59:30.29, Lalai,,0,0,0,,Berapa kadar?
Dialog: 0,0:59:30.31,0:59:32.47, Lalai,,0,0,0,,Adakah anda maksudkan...
Dialog: 0,0:59:33.15,0:59:35.81, Lalai,,0,0,0,,kadar kemandirian?
Dialog: 0,0:59:46.58,0:59:48.43, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:59:48.45,0:59:50.22,Lalai,,0,0,0,,Saya tidak percaya ini.
Dialog: 0,0:59:50.25,0:59:52.27,Lalai,,0,0,0,,Dia masih sangat muda.
Dialog: 0,0:59:52.29,0:59:54.48,Lalai,,0,0,0,,Tiada seorang pun dalam keluarganya yang tahu,
Dialog: 0,0:59:54.50,0:59:56.41, Lalai,,0,0,0,,kecuali ibu saudaranya.
Dialog: 0,0:59:56.92,0:59:59.04,Lalai,,0,0,0,,Bukan ibu bapanya?
Dialog: 0,0:59:59.42,1:00:01.00,Lalai,,0,0,0,,Betul.
Dialog: 0,1:00:01.47,1:00:05.13,Lalai,,0,0,0,,Mereka sepatutnya masih tahu tentang perkara ini.
Dialog: 0,1:00:05.39,1:00:07.67,Lalai,,0,0,0,,Bila anda tahu?
Dialog: 0,1:00:11.73,1:00:14.93,Lalai,,0,0,0,,Adakah anda ingat hari ketika saya melawat,
Dialog: 0,1:00:15.23,1:00:17.93,Lalai,,0,0,0,,dan cakap saya nak ceraikan dia?
Dialog: 0,1:00:18.07,1:00:21.06,Lalai,,0,0,0,,Saya dapat tahu hari itu selepas pulang ke Seoul.
Dialog: 0,1:00:23.20,1:00:24.59,Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,1:00:24.62,1:00:26.53,Lalai,,0,0,0,,Jadi...
Dialog: 0,1:00:26.78,1:00:29.76,Lalai,,0,0,0,,anda bertekad untuk menceraikannya,
Dialog: 0,1:00:29.79,1:00:32.87,Lalai,,0,0,0,,kemudian tiba-tiba berubah hati kerana...
Dialog: 0,1:00:38.00,1:00:39.54,Lalai,,0,0,0,,Ya.
Dialog: 0,1:00:40.09,1:00:45.59,Lalai,,0,0,0,,Selepas mengetahuinya, saya telah memutuskan untuk mengekalkan perkahwinan kami.
Dialog: 0,1:00:50.81,1:00:52.29,Lalai,,0,0,0,,Kau bajingan.
Dialog: 0,1:00:52.31,1:00:54.22,Lalai,,0,0,0,,Anda sepatutnya lebih tahu.
Dialog: 0,1:00:55.10,1:00:56.68,Lalai,,0,0,0,,Oh, sayang.
Dialog: 0,1:00:56.86,1:00:58.89,Lalai,,0,0,0,,Saya tidak tahu,
Dialog: 0,1:00:59.36,1:01:01.60,Lalai,,0,0,0,,dan hanya mengasihani anda.
Dialog: 0,1:01:02.99,1:01:05.61,Lalai,,0,0,0,,Bagaimana anda boleh?
Dialog: 0,1:01:07.62,1:01:09.28,Lalai,,0,0,0,,Saya tahu.
Dialog: 0,1:01:10.62,1:01:12.47,Lalai,,0,0,0,,Saya bajingan.
Dialog: 0,1:01:12.50,1:01:18.20,Lalai,,0,0,0,,Hae-in mengetahui segala-galanya\Nyet masih datang ke sini apabila saya memberitahunya,
Dialog: 0,1:01:20.46,1:01:22.16,Lalai,,0,0,0,,jadi Ibu,
Dialog: 0,1:01:24.93,1:01:26.84,Lalai,,0,0,0,,sila ambil...
Dialog: 0,1:01:28.14,1:01:29.80,Lalai,,0,0,0,,jaga dia dengan baik...
Dialog: 0,1:01:30.60,1:01:32.59,Lalai,,0,0,0,,apabila saya tiada.
Dialog: 0,1:01:33.69,1:01:35.26,Lalai,,0,0,0,,Saya mohon.
Dialog: 0,1:02:24.61,1:02:26.15,Lalai,,0,0,0,,Ibu.
Dialog: 0,1:02:32.58,1:02:34.01,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:02:34.04,1:02:35.85,Lalai,,0,0,0,,Saya datang untuk beberapa kimchi.
Dialog: 0,1:02:35.87,1:02:38.95,Lalai,,0,0,0,,Ibu kamu menangis.
Dialog: 0,1:02:39.67,1:02:41.94,Lalai,,0,0,0,,- Kenapa?\N- Bukankah itu jelas?
Dialog: 0,1:02:41.96,1:02:45.07,Lalai,,0,0,0,,Dia selalu menentangnya dan mahu saya berhenti,
Dialog: 0,1:02:45.09,1:02:48.99,Lalai,,0,0,0,,tetapi sekarang saya telah melangkah\N, dia pasti kecewa.
Dialog: 0,1:02:49.01,1:02:53.34,Lalai,,0,0,0,,Apa? Dia berkata dia berasa lega kerana\Nyou bukan lagi ketua kampung.
Dialog: 0,1:02:55.02,1:02:56.66,Lalai,,0,0,0,,Dia tidak sengaja.
Dialog: 0,1:02:56.68,1:02:57.94,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:02:57.96,1:02:58.95,Lalai,,0,0,0,,Ibu.
Dialog: 0,1:02:58.98,1:03:02.18, Lalai,,0,0,0,, Pergi sahaja. Nanti balik.
Dialog: 0,1:03:03.98,1:03:06.17,Lalai,,0,0,0,,Ini adalah jamuan.
Dialog: 0,1:03:06.19,1:03:08.38,Lalai,,0,0,0,,Saya patut makan di sini sahaja hari ini.
Dialog: 0,1:03:08.40,1:03:10.81,Lalai,,0,0,0,,Suruh Hae-in datang makan.
Dialog: 0,1:03:11.12,1:03:12.69,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:03:17.21,1:03:18.81,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:03:18.83,1:03:21.07,Lalai,,0,0,0,,Ada apa dengan awak? Bergerak.
Dialog: 0,1:03:21.58,1:03:24.45,Lalai,,0,0,0,,Saya tahu apa yang anda alami,
Dialog: 0,1:03:24.96,1:03:26.27,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:03:26.30,1:03:27.83,Lalai,,0,0,0,,anda nampak...
Dialog: 0,1:03:29.05,1:03:31.25,Lalai,,0,0,0,,Kenapa anda tidak berfikir seperti ini?
Dialog: 0,1:03:31.76,1:03:35.82,Lalai,,0,0,0,,Saya, Baek Du-gwan, dulu milik rakyat,
Dialog: 0,1:03:35.85,1:03:39.43,Lalai,,0,0,0,,tetapi kini saya milik awak.
Dialog: 0,1:03:40.19,1:03:43.18,Lalai,,0,0,0,,Mengapa saya mahu begitu?
Dialog: 0,1:03:44.69,1:03:46.68,Lalai,,0,0,0,,Betulkah?
Dialog: 0,1:03:50.74,1:03:54.15,Lalai,,0,0,0,,Alhamdulillah, kami berpesta untuk sarapan.
Dialog: 0,1:03:54.70,1:03:56.40,Lalai,,0,0,0,,Ada apa?
Dialog: 0,1:03:56.74,1:03:58.95,Lalai,,0,0,0,,Sila bantu diri anda.
Dialog: 0,1:04:05.29,1:04:07.36,Lalai,,0,0,0,,Hae-in, mari makan.
Dialog: 0,1:04:07.38,1:04:08.91,Lalai,,0,0,0,,Okey.
Dialog: 0,1:04:13.22,1:04:14.95,Lalai,,0,0,0,,Di mana kakak awak?
Dialog: 0,1:04:14.97,1:04:18.06,Lalai,,0,0,0,,Beom-ja bertolak ke Seoul pada\Npagi untuk menjalankan beberapa tugas.
Dialog: 0,1:04:18.08,1:04:19.12,Lalai,,0,0,0,,Oh, ya.
Dialog: 0,1:04:19.14,1:04:22.41,Lalai,,0,0,0,,Aduh, seronoknya kalau dia makan bersama kita.
Dialog: 0,1:04:22.44,1:04:24.97,Lalai,,0,0,0,,Jom makan.
Dialog: 0,1:04:38.91,1:04:42.20,Lalai,,0,0,0,,By the way, mana Soo-cheol?
Dialog: 0,1:04:49.59,1:04:51.65,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Gim Tinju Ratu{\c}{\i0}
Dialog: 0,1:04:51.67,1:04:52.72,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Geonumama telah log masuk{\c}{\i0}
Dialog: 0,1:04:56.97,1:04:59.80,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:05:07.06,1:05:08.54,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Da-hye.{\c}{\i0}\N- Astaga.
Dialog: 0,1:05:08.57,1:05:10.54,Lalai,,0,0,0,,Mengapa dia bermain ini?
Dialog: 0,1:05:10.57,1:05:12.53,Lalai,,0,0,0,,Saya mengekalkan watak saya kerana semua item.
Dialog: 0,1:05:12.55,1:05:14.38,Lalai,,0,0,0,,{\an8}- Astaga.\N{\i1}{\c&H7AA0FF&}- Biar saya katakan satu perkara.{\c}{\i0}
Dialog: 0,1:05:14.41,1:05:16.09,Lalai,,0,0,0,,{\an8}Lupakan. Anda hanya akan menyumpah saya.
Dialog: 0,1:05:16.12,1:05:17.22,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Geonupapa menghantar mesej{\c}{\i0}
Dialog: 0,1:05:17.24,1:05:18.64,Lalai,,0,0,0,,{\an8}Apakah ini?
Dialog: 0,1:05:18.66,1:05:21.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini ialah vaksinasi Geon-u\Nrekod dalam bahasa Inggeris dan Korea.{\c}{\i0}
Dialog: 0,1:05:21.37,1:05:24.31,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia memerlukan pusingan kedua\NMMR vaksin dan vaksin cacar air.{\c}{\i0}
Dialog: 0,1:05:24.33,1:05:26.64,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pastikan dia mendapat\Nnya di mana sahaja anda berada.{\c}{\i0}
Dialog: 0,1:05:26.67,1:05:30.15,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pastikan anda menyanyi\N"Baby Shark" apabila dia mendapatnya.{\c}{\i0}
Dialog: 0,1:05:30.17,1:05:34.82,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Anak jerung, doo doo doo doo doo doo{\i0} ♫{\c}
Dialog: 0,1:05:34.84,1:05:38.36,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Anak jerung, doo doo doo doo doo doo\NBbayi yu{\i0} ♫{\c}
Dialog: 0,1:05:38.39,1:05:44.83,Lalai,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Mommy Shark, doo doo doo doo doo doo{\i0} ♫{\c}
Dialog: 0,1:05:44.85,1:05:46.83,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Selesai.{\c}{\i0}
Dialog: 0,1:05:46.85,1:05:48.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Terima kasih.\N- Astaga.{\c}{\i0}
Dialog: 0,1:05:48.19,1:05:49.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Aduh, Geon-u.{\c}{\i0}
Dialog: 0,1:05:49.82,1:05:51.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah ia menyakitkan?{\c}{\i0}
Dialog: 0,1:05:51.32,1:05:52.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Syabas.{\c}{\i0}
Dialog: 0,1:05:52.32,1:05:55.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia tidak menangis pun.{\c}{\i0}
Dialog: 0,1:05:57.16,1:05:58.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ayuh.{\c}{\i0}
Dialog: 0,1:06:13.46,1:06:15.68,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Geonumama telah log keluar{\c}{\i0}
Dialog: 0,1:06:41.37,1:06:43.49,Lalai,,0,0,0,,Pergi ke suatu tempat?
Dialog: 0,1:06:43.62,1:06:45.70,Lalai,,0,0,0,,- Seoul.\N- Jadi tiba-tiba?
Dialog: 0,1:06:47.29,1:06:48.31,Lalai,,0,0,0,,Lihat.
Dialog: 0,1:06:48.33,1:06:51.65,Lalai,,0,0,0,,Beom-ja pun bertolak ke Seoul.\NKenapa kamu semua ke sana?
Dialog: 0,1:06:51.67,1:06:55.75,Lalai,,0,0,0,,Adakah anda mahu wartawan\Njumpa anda? Kami bersembunyi, anda tahu?
Dialog: 0,1:06:55.97,1:06:58.33,Lalai,,0,0,0,,Ada sesuatu yang perlu saya lakukan.
Dialog: 0,1:06:58.38,1:07:00.50,Lalai,,0,0,0,,Saya dengar Eun-sung melawat.
Dialog: 0,1:07:01.51,1:07:04.37,Lalai,,0,0,0,,Apakah jenis rancangan anda\Nmeminta Soo-cheol merahsiakan?
Dialog: 0,1:07:04.39,1:07:07.13,Lalai,,0,0,0,,Adakah anda akan bertemu dengannya hari ini juga?
Dialog: 0,1:07:07.52,1:07:11.97,Lalai,,0,0,0,,Untuk apa? Adakah anda akan merayu dia untuk menyelamatkan sekurang-kurangnya anda?
Dialog: 0,1:07:13.27,1:07:15.10,Lalai,,0,0,0,,Sudah tentu saya patut.
Dialog: 0,1:07:15.36,1:07:17.34,Lalai,,0,0,0,,Adakah kita semua turun bersama-sama?
Dialog: 0,1:07:17.36,1:07:20.31,Lalai,,0,0,0,,Apa? Saya tak percaya awak.
Dialog: 0,1:07:21.28,1:07:23.43,Lalai,,0,0,0,,Jangan beritahu saya anda akan bekerja untuknya.
Dialog: 0,1:07:23.45,1:07:26.32,Lalai,,0,0,0,,Itulah tempat saya dari mula.
Dialog: 0,1:07:28.04,1:07:31.31,Lalai,,0,0,0,,Jangan beritahu saya anda berdua berpakat\Nsupaya anda boleh menghalau keluarga anda,
Dialog: 0,1:07:31.33,1:07:35.33,Lalai,,0,0,0,,dan ambil alih syarikat itu sendiri.
Dialog: 0,1:07:41.84,1:07:43.57,Lalai,,0,0,0,,Fikirkan apa sahaja yang anda mahu.
Dialog: 0,1:07:43.60,1:07:45.30,Lalai,,0,0,0,,Hei!
Dialog: 0,1:08:01.66,1:08:03.38,Lalai,,0,0,0,,Sayang, awak akan ke Seoul?
Dialog: 0,1:08:03.41,1:08:04.80,Lalai,,0,0,0,,Ya.
Dialog: 0,1:08:04.83,1:08:07.22,Lalai,,0,0,0,,Anda tidak akan mendapat sebarang teksi di sini.
Dialog: 0,1:08:07.24,1:08:09.15,Lalai,,0,0,0,,Saya akan memandu awak. Naik.
Dialog: 0,1:08:15.80,1:08:17.33,Lalai,,0,0,0,,Pegang erat.
Dialog: 0,1:08:30.69,1:08:31.66,Lalai,,0,0,0,,Ibu.
Dialog: 0,1:08:31.69,1:08:33.51,Lalai,,0,0,0,,Ya?
Dialog: 0,1:08:33.94,1:08:36.72,Lalai,,0,0,0,,Terima kasih untuk segala-galanya.
Dialog: 0,1:08:37.86,1:08:41.77,Lalai,,0,0,0,,Adakah anda pergi ke suatu tempat yang jauh?\NTItu pelik untuk anda katakan.
Dialog: 0,1:08:55.67,1:08:58.20,Lalai,,0,0,0,,Angin mesti kuat.
Dialog: 0,1:08:58.59,1:09:00.66, Lalai,,0,0,0,,Mata saya bergenang.
Dialog: 0,1:09:11.85,1:09:15.01,Lalai,,0,0,0,,Sudah tentu. Saya tahu ini dilarang.
Dialog: 0,1:09:17.44,1:09:21.42,Lalai,,0,0,0,,Tetapi kami tidak pernah menyimpan sebarang\Nrahsia antara satu sama lain.
Dialog: 0,1:09:21.44,1:09:24.75,Lalai,,0,0,0,,Ingat ketika anak bongsu kamu melarikan diri\Nto Sokcho kerana dia tidak dapat melupakan...
Dialog: 0,1:09:24.77,1:09:27.88,Lalai,,0,0,0,,cinta pertamanya, dan saya pergi ke sana untuk mendapatkannya?
Dialog: 0,1:09:27.91,1:09:29.76,Lalai,,0,0,0,,Kita boleh ketawa mengenainya sekarang.
Dialog: 0,1:09:29.79,1:09:31.93,Lalai,,0,0,0,,Dia sangat kesakitan.
Dialog: 0,1:09:31.95,1:09:33.18,Lalai,,0,0,0,,Las Vegas, adakah itu?
Dialog: 0,1:09:33.21,1:09:36.41,Lalai,,0,0,0,,Dia pergi ke sana untuk mengambil dadah...
Dialog: 0,1:09:38.09,1:09:40.41,Lalai,,0,0,0,,Tepat sekali,
Dialog: 0,1:09:40.50,1:09:42.11,Lalai,,0,0,0,,jadi awak beritahu saya?
Dialog: 0,1:09:42.13,1:09:45.25,Lalai,,0,0,0,,Sudah tentu. Tiada siapa yang akan tahu anda memberitahu saya.
Dialog: 0,1:09:49.35,1:09:51.05,Lalai,,0,0,0,,Siapa?
Dialog: 0,1:09:53.21,1:09:55.51,Lalai,,0,0,0,,Pengerusi Hong Man-dae dari Queens?
Dialog: 0,1:09:55.60,1:09:59.72,Lalai,,0,0,0,,Jadi di situlah dia.
Dialog: 0,1:10:47.61,1:10:49.66,Lalai,,0,0,0,,Adakah Encik Baek tahu bahawa Cik Hong ada di sini?
Dialog: 0,1:10:49.68,1:10:50.68,Lalai,,0,0,0,,Saya rasa tidak begitu.
Dialog: 0,1:10:50.70,1:10:53.40,Lalai,,0,0,0,,Betul, dia meninggalkannya.
Dialog: 0,1:10:58.79,1:11:01.52,Lalai,,0,0,0,,- Ke mana anda tergesa-gesa?\N- Seperti yang anda tahu, ini adalah kecemasan.
Dialog: 0,1:11:01.54,1:11:03.31,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:11:03.34,1:11:04.77,Lalai,,0,0,0,,Anda tidak pernah dengar.
Dialog: 0,1:11:04.80,1:11:07.17,Lalai,,0,0,0,,Mari kita kekalkan seperti itu.
Dialog: 0,1:11:27.24,1:11:28.59,Lalai,,0,0,0,,Selamat datang kembali.
Dialog: 0,1:11:28.61,1:11:30.59,Lalai,,0,0,0,,Saya tidak kembali kerana ugutan awak.
Dialog: 0,1:11:30.61,1:11:32.68,Lalai,,0,0,0,,Saya tahu anda tidak akan mengembalikan apa yang menjadi milik kita,
Dialog: 0,1:11:32.70,1:11:35.40,Lalai,,0,0,0,,jadi jika saya tidak dapat mendapatkannya kembali,
Dialog: 0,1:11:35.87,1:11:38.28,Lalai,,0,0,0,,Saya rasa saya perlu berkongsi.
Dialog: 0,1:11:44.30,1:11:46.08,Lalai,,0,0,0,,Jadi peliharalah kata-kata anda.
Dialog: 0,1:12:18.29,1:12:20.89,Lalai,,0,0,0,,Sidang akhbar akan bermula tidak lama lagi.
Dialog: 0,1:12:20.91,1:12:24.37,Lalai,,0,0,0,,Seperti yang kami nyatakan sebelum ini, kami\N tidak akan menjawab sebarang soalan.
Dialog: 0,1:12:28.80,1:12:31.82,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sidang Akhbar untuk Perasmian\Nof Yoon Eun-sung di Kumpulan Queens{\c}{\i0}
Dialog: 0,1:12:39.31,1:12:40.87,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:12:40.89,1:12:42.50,Lalai,,0,0,0,,Bagaimana anda tahu?
Dialog: 0,1:12:42.52,1:12:44.18,Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,1:12:45.48,1:12:47.00,Lalai,,0,0,0,,Saya beritahu awak.
Dialog: 0,1:12:47.02,1:12:48.46,Lalai,,0,0,0,,Saya akan cari penyelesaian saya sendiri.
Dialog: 0,1:12:48.48,1:12:50.35,Lalai,,0,0,0,,Dan ini...
Dialog: 0,1:12:54.91,1:12:56.86,Lalai,,0,0,0,,- adakah penyelesaian anda?\N- Ya.
Dialog: 0,1:12:57.24,1:13:00.11,Lalai,,0,0,0,,Saya suka perkara yang pasti dan cepat.
Dialog: 0,1:13:00.95,1:13:03.36,Lalai,,0,0,0,,Jom. Sudah hampir masanya.
Dialog: 0,1:13:30.94,1:13:32.86,Lalai,,0,0,0,,- Adakah anda pasti ini?\N- Saya beritahu anda.
Dialog: 0,1:13:32.88,1:13:36.00,Lalai,,0,0,0,,Saya semak semula. Saya positif.
Dialog: 0,1:13:40.54,1:13:41.51,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Cik. Moh Seul-hee{\c}{\i0}
Dialog: 0,1:13:47.08,1:13:49.10,Lalai,,0,0,0,,- Hello, puan.\N- {\i1}Sudah jumpa dia?{\i0}
Dialog: 0,1:13:49.13,1:13:53.36,Lalai,,0,0,0,,Tidak, puan. Saya mencari seluruh Seoul.
Dialog: 0,1:13:53.38,1:13:56.88,Lalai,,0,0,0,,Mungkin dia berada di kawasan luar bandar.
Dialog: 0,1:13:58.60,1:14:00.12,Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,1:14:00.14,1:14:03.13,Lalai,,0,0,0,,Saya akan menghubungi awak sebaik sahaja saya menemuinya.
Dialog: 0,1:14:04.39,1:14:07.64,Lalai,,0,0,0,,Adakah anda melihatnya? Aku membelakanginya.
Dialog: 0,1:14:21.95,1:14:24.35,Lalai,,0,0,0,,Ya, keadaannya sama.
Dialog: 0,1:14:24.37,1:14:25.91,Lalai,,0,0,0,,Ya.
Dialog: 0,1:14:33.59,1:14:35.65,Lalai,,0,0,0,,Akhbar ekonomi utama, akhbar harian,
Dialog: 0,1:14:35.67,1:14:38.61,Lalai,,0,0,0,,media langsung dan yang di luar negara\Telah membuat permintaan tambahan,
Dialog: 0,1:14:38.64,1:14:40.49,Lalai,,0,0,0,,jadi kami menyusunnya.
Dialog: 0,1:14:40.51,1:14:43.01,Lalai,,0,0,0,,Pasukan PR telah pun menghulurkan panduan.
Dialog: 0,1:14:43.39,1:14:45.58,Lalai,,0,0,0,,Anda boleh ikut panduan ini,\Nad kami akan melepaskannya...
Dialog: 0,1:14:45.60,1:14:47.45,Lalai,,0,0,0,,tanpa sekatan.
Dialog: 0,1:14:47.48,1:14:51.42,Lalai,,0,0,0,,Kami akan mempunyai teleprompter, jadi\Nyonya boleh berehat dan membaca perkataan.
Dialog: 0,1:14:51.44,1:14:54.23,Lalai,,0,0,0,,Bagaimana pula dengan pengumuman perkahwinan anda?
Dialog: 0,1:14:54.44,1:14:55.96,Lalai,,0,0,0,,Jangan sertakan itu.
Dialog: 0,1:14:55.99,1:14:58.09,Lalai,,0,0,0,,Saya akan mengumumkannya pada penghujungnya.
Dialog: 0,1:14:58.11,1:14:59.77,Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,1:15:01.66,1:15:03.36,Lalai,,0,0,0,,Bolehkah itu?
Dialog: 0,1:15:25.47,1:15:28.22,Lalai,,0,0,0,,Helo, saya Yoon Eun-sung.
Dialog: 0,1:15:29.31,1:15:32.67,Lalai,,0,0,0,,Pelaburan Pione telah menjadi\NQueens pemegang saham kedua terbesar,
Dialog: 0,1:15:32.69,1:15:34.78,Lalai,,0,0,0,,dan saya menjadi pengerusi baharu Kumpulan Queens...
Dialog: 0,1:15:34.80,1:15:37.21,Lalai,,0,0,0,,selepas mengadakan mesyuarat agung luar biasa.
Dialog: 0,1:15:37.24,1:15:40.26,Lalai,,0,0,0,,Keputusan ini tidak dapat dielakkan\Nmemandangkan bekas pengerusi jatuh sakit,
Dialog: 0,1:15:40.28,1:15:43.18,Lalai,,0,0,0,,dan kami terpaksa menghentikan kejatuhan saham kami.
Dialog: 0,1:15:43.20,1:15:47.56,Lalai,,0,0,0,,Selain itu, saya mempunyai banyak\Pengalaman dalam menyelamatkan syarikat...
Dialog: 0,1:15:47.58,1:15:50.31,Lalai,,0,0,0,,daripada krisis dan menstabilkannya semula.
Dialog: 0,1:15:50.33,1:15:51.85,Lalai,,0,0,0,,Walaupun semuanya, walau bagaimanapun,
Dialog: 0,1:15:51.88,1:15:54.48,Lalai,,0,0,0,,Saya diseksa oleh andaian yang tidak berasas...
Dialog: 0,1:15:54.50,1:15:56.65,Lalai,,0,0,0,,dan tuduhan palsu...
Dialog: 0,1:15:56.67,1:15:58.65,Lalai,,0,0,0,,tentang bagaimana saya mengkhianati bekas pengerusi,
Dialog: 0,1:15:58.67,1:16:00.78,Lalai,,0,0,0,,tendang keluar keluarganya,
Dialog: 0,1:16:00.80,1:16:06.13,Lalai,,0,0,0,,mencuri daripada mereka, mengurung mereka,\Nand menyimpan mereka di Asia Tenggara.
Dialog: 0,1:16:09.27,1:16:11.45,Lalai,,0,0,0,,Satu perkara yang pasti ialah,
Dialog: 0,1:16:11.48,1:16:14.25,Lalai,,0,0,0,,inilah yang dikehendaki oleh\Nbekas pengerusi.
Dialog: 0,1:16:14.27,1:16:17.17,Lalai,,0,0,0,,Untuk membuktikan ini dan jelaskan\Menghapuskan salah faham,
Dialog: 0,1:16:17.19,1:16:20.94,Lalai,,0,0,0,,Saya ingin membuat pengumuman besar hari ini.
Dialog: 0,1:16:24.87,1:16:28.43,Lalai,,0,0,0,,Saya akan melantik semula Cik Hong Hae-in,\N kawan lama saya...
Dialog: 0,1:16:28.45,1:16:32.07, Lalai,,0,0,0,, dan ahli perniagaan berbakat, sebagai\N Ketua Pegawai Eksekutif Queens Department Store.
Dialog: 0,1:16:32.21,1:16:34.73,Lalai,,0,0,0,,Sepanjang tiga tahun lalu, kedai itu membuat...
Dialog: 0,1:16:34.75,1:16:36.98, Lalai,,0,0,0,, rekod keuntungan sepanjang masa di bawah pengurusannya.
Dialog: 0,1:16:37.00,1:16:39.15,Lalai,,0,0,0,,Itu hanya menunjukkan betapa cekapnya dia.
Dialog: 0,1:16:39.17,1:16:42.21,Lalai,,0,0,0,,Sekarang mari kita dengar daripadanya.
Dialog: 0,1:16:56.19,1:16:58.75,Lalai,,0,0,0,,Helo, saya Hong Hae-in.
Dialog: 0,1:16:58.78,1:17:01.75,Lalai,,0,0,0,,Seperti kata Pengerusi Yoon,
Dialog: 0,1:17:01.78,1:17:05.22,Lalai,,0,0,0,,saya dan dia berkawan sejak kolej,
Dialog: 0,1:17:05.24,1:17:07.90,Lalai,,0,0,0,,dan Encik Yoon...
Dialog: 0,1:17:09.41,1:17:11.89,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}En. Saya dan Yoon akan melakukan yang terbaik\Nuntuk mengambil lonjakan baharu{\c}{\i0}
Dialog: 0,1:17:11.91,1:17:13.57,Lalai,,0,0,0,,Dia...
Dialog: 0,1:17:14.17,1:17:17.29,Lalai,,0,0,0,,mengancam saya.
Dialog: 0,1:17:25.84,1:17:28.36,Lalai,,0,0,0,,Dia mengancam untuk menipu\Nmenuduh dan meletakkan Encik Baek Hyun-woo,
Dialog: 0,1:17:28.39,1:17:32.74,Lalai,,0,0,0,,suami saya dan bekas\Pengarah Sah, di belakang rejim.
Dialog: 0,1:17:32.77,1:17:36.55,Lalai,,0,0,0,,Saya ada rakaman sebagai bukti.
Dialog: 0,1:17:38.94,1:17:39.92,Lalai,,0,0,0,,Tunggu, Hae-in.
Dialog: 0,1:17:39.94,1:17:42.75,Lalai,,0,0,0,,Tambahan pula, saya tidak boleh kembali ke kedudukan saya...
Dialog: 0,1:17:42.78,1:17:45.02,Lalai,,0,0,0,,sebagai Ketua Pegawai Eksekutif gedung serbaneka saya,
Dialog: 0,1:17:45.57,1:17:47.40,Lalai,,0,0,0,,kerana...
Dialog: 0,1:17:47.53,1:17:49.69,Lalai,,0,0,0,,Saya diberitahu...
Dialog: 0,1:17:51.24,1:17:54.95,Lalai,,0,0,0,,bahawa saya mempunyai sedikit masa lagi untuk hidup.
Dialog: 0,1:19:02.07,1:19:04.29,Lalai,,0,0,0,,{\an8}Minum! Bahagian bawah!
Dialog: 0,1:19:04.32,1:19:06.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Empat Tahun Lalu{\c}{\i0}
Dialog: 0,1:19:06.03,1:19:07.80,Lalai,,0,0,0,,Bawah ke atas!
Dialog: 0,1:19:07.82,1:19:09.65,Lalai,,0,0,0,,Bagus!
Dialog: 0,1:19:09.99,1:19:13.55,Lalai,,0,0,0,,Kenapa pelatih kita, Hae-in, tidak minum?
Dialog: 0,1:19:13.58,1:19:15.43,Lalai,,0,0,0,,Minum!
Dialog: 0,1:19:15.45,1:19:18.99,Lalai,,0,0,0,,Saya sudah beritahu awak saya tidak minum.
Dialog: 0,1:19:21.54,1:19:25.11,Lalai,,0,0,0,,Betulkah? Kemudian mari kita lakukan pukulan cinta.
Dialog: 0,1:19:25.13,1:19:26.65,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:19:26.67,1:19:27.86,Lalai,,0,0,0,,Okey. minum.
Dialog: 0,1:19:27.88,1:19:29.86,Lalai,,0,0,0,,- Love shot.\N- Okay. minum.
Dialog: 0,1:19:29.89,1:19:32.67,Lalai,,0,0,0,,- Tembakan cinta.\N- Siapa itu?
Dialog: 0,1:19:32.85,1:19:34.76,Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:19:34.81,1:19:37.24,Lalai,,0,0,0,,Saya minum bukan dia.
Dialog: 0,1:19:37.27,1:19:39.00,Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:19:39.02,1:19:40.55,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:19:50.82,1:19:53.94,Lalai,,0,0,0,,Mengapa kamu tidak melakukan pukulan cinta dengan saya?
Dialog: 0,1:20:11.55,1:20:13.95,Lalai,,0,0,0,,Pn. Hong, kenapa awak susah hati?
Dialog: 0,1:20:13.97,1:20:16.20,Lalai,,0,0,0,,Adakah saya membuat anda tidak selesa di sana?
Dialog: 0,1:20:16.22,1:20:18.16,Lalai,,0,0,0,,Ya, sangat.
Dialog: 0,1:20:18.18,1:20:19.41,Lalai,,0,0,0,,Saya baru...
Dialog: 0,1:20:19.43,1:20:21.59,Lalai,,0,0,0,,Anda terlalu comel.
Dialog: 0,1:20:22.35,1:20:25.00,Lalai,,0,0,0,,- Apa?\N- Anda terlalu comel apabila anda mabuk,
Dialog: 0,1:20:25.02,1:20:27.17,Lalai,,0,0,0,,tetapi awak masih mabuk dan berlagak comel...
Dialog: 0,1:20:27.19,1:20:29.48,Lalai,,0,0,0,,di hadapan wanita lain.
Dialog: 0,1:20:29.86,1:20:31.69,Lalai,,0,0,0,,Beraninya awak?
Dialog: 0,1:20:32.70,1:20:33.87,Lalai,,0,0,0,,Ia tidak akan berlaku lagi.
Dialog: 0,1:20:33.89,1:20:34.93,Lalai,,0,0,0,,Jangan lupa.
Dialog: 0,1:20:34.95,1:20:37.68,Lalai,,0,0,0,,Anda membuat hati orang berdegup kencang...
Dialog: 0,1:20:37.70,1:20:39.53,Lalai,,0,0,0,,apabila anda mabuk.
Dialog: 0,1:20:39.62,1:20:41.89,Lalai,,0,0,0,,Itu langkah istimewa anda,
Dialog: 0,1:20:41.92,1:20:44.23,Lalai,,0,0,0,,jadi jangan lakukannya di hadapan orang lain.
Dialog: 0,1:20:44.25,1:20:46.24,Lalai,,0,0,0,,Okey.
Dialog: 0,1:20:52.09,1:20:53.83,Lalai,,0,0,0,,Saya tidak akan melakukannya.
Dialog: 0,1:21:15.37,1:21:17.53,Lalai,,0,0,0,,{\i1}Itulah yang dia katakan.{\i0}
Dialog: 0,1:21:17.77,1:21:18.76,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Malam Tadi{\c}{\i0}
Dialog: 0,1:21:18.79,1:21:21.83,Lalai,,0,0,0,,Hae-in cakap aku buat jantung dia berdegup kencang...
Dialog: 0,1:21:21.86,1:21:22.83,Lalai,,0,0,0,,apabila saya mabuk.
Dialog: 0,1:21:22.86,1:21:23.85,Lalai,,0,0,0,,Jom pulang.
Dialog: 0,1:21:23.87,1:21:25.70,Lalai,,0,0,0,,Anda mabuk.
Dialog: 0,1:21:27.71,1:21:29.56,Lalai,,0,0,0,,Adakah anda rasa dia masih merasakan perkara yang sama?
Dialog: 0,1:21:29.59,1:21:33.53,Lalai,,0,0,0,,Adakah jantungnya masih berdegup kencang\Sekarang pun jika saya mabuk...
Dialog: 0,1:21:33.55,1:21:34.65,Lalai,,0,0,0,,dan berlagak comel?
Dialog: 0,1:21:34.68,1:21:38.21,Lalai,,0,0,0,,Dia tidak akan menceraikan kamu ketika itu.
Dialog: 0,1:21:38.47,1:21:42.91,Lalai,,0,0,0,,Mengapa jantung saya berdegup kencang apabila saya melihatnya?
Dialog: 0,1:21:42.93,1:21:46.26,Lalai,,0,0,0,,- Memang betul?\N- Ya, betul.
Dialog: 0,1:21:46.94,1:21:52.18,Lalai,,0,0,0,,Saya mendapat rama-rama, dan saya\Ngembira apabila saya melihatnya.
Dialog: 0,1:21:52.74,1:21:55.48,Lalai,,0,0,0,,Saya rindu dia bila dia tiada,
Dialog: 0,1:21:55.91,1:21:57.86,Lalai,,0,0,0,,dan apabila saya memandangnya,
Dialog: 0,1:21:59.91,1:22:02.49,Lalai,,0,0,0,,Saya takut...
Dialog: 0,1:22:03.37,1:22:05.22,Lalai,,0,0,0,,bahawa saya tidak akan berjumpa dengannya lagi.
Dialog: 0,1:22:05.25,1:22:07.28,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:22:11.80,1:22:13.71,Lalai,,0,0,0,,Tetapi dia tidak mahu saya...
Dialog: 0,1:22:15.13,1:22:17.96,Lalai,,0,0,0,,untuk melakukan apa sahaja...
Dialog: 0,1:22:18.60,1:22:20.84,Lalai,,0,0,0,,untuk dia lagi.
Dialog: 0,1:22:21.47,1:22:22.78,Lalai,,0,0,0,,Saya membuat dia tidak selesa.
Dialog: 0,1:22:22.81,1:22:24.95,Lalai,,0,0,0,,Dia pasti tidak menyukai anda lagi.
Dialog: 0,1:22:24.98,1:22:28.35,Lalai,,0,0,0,,Tetapi dia meletakkan pembalut ini pada saya,
Dialog: 0,1:22:29.23,1:22:31.50, Lalai,,0,0,0,, dan juga menggunakan salap untuk saya.
Dialog: 0,1:22:31.52,1:22:34.17,Lalai,,0,0,0,,Betulkah? Kemudian adakah dia masih menyukai anda?
Dialog: 0,1:22:34.19,1:22:36.05,Lalai,,0,0,0,,Ia mengelirukan.
Dialog: 0,1:22:36.07,1:22:38.19,Lalai,,0,0,0,,Tanya sahaja dia.
Dialog: 0,1:22:43.08,1:22:45.53,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:22:46.37,1:22:48.48,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:22:48.50,1:22:51.04,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:22:51.13,1:22:53.33,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:22:54.46,1:22:56.58,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:22:59.72,1:23:01.42,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:23:09.10,1:23:10.97,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:23:11.23,1:23:13.25,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:23:13.27,1:23:15.42,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:23:15.44,1:23:17.77,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:23:18.57,1:23:20.44,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:23:21.57,1:23:23.82,Lalai,,0,0,0,,{\i1}Dia suka saya.{\i0}
Dialog: 0,1:23:24.45,1:23:26.53,Lalai,,0,0,0,,{\i1}Dia tidak suka saya.{\i0}
Dialog: 0,1:23:26.66,1:23:28.57,Lalai,,0,0,0,,{\i1}Dia suka saya.{\i0}
Dialog: 0,1:23:29.00,1:23:30.74,Lalai,,0,0,0,,{\i1}Dia tidak suka saya.{\i0}
Dialog: 0,1:23:31.21,1:23:33.04,Lalai,,0,0,0,,Dia suka saya.
Dialog: 0,1:23:33.75,1:23:35.54,Lalai,,0,0,0,,Dia tidak suka saya.
Dialog: 0,1:23:41.97,1:23:43.71,Lalai,,0,0,0,,Dia suka saya?
Dialog: 0,1:23:47.48,1:23:49.01,Lalai,,0,0,0,,Betulkah?
Dialog: 0,1:23:53.19,1:23:54.72,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:23:55.44,1:23:58.77,Lalai,,0,0,0,,Tetapi bukan itu yang berlaku untuk saya.
Dialog: 0,1:24:00.66,1:24:02.23,Lalai,,0,0,0,,Saya...
Dialog: 0,1:24:06.29,1:24:08.20,Lalai,,0,0,0,,sayangi dia.
Dialog: 0,1:24:27.39,1:24:29.51,Lalai,,0,0,0,,Saya sayang awak, Hae-in.
Dialog: 0,1:25:01.13,1:25:03.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:25:34.62,1:25:36.70,Lalai,,0,0,0,,{\an8}{\i1}Saya akan berikan apa sahaja yang anda mahu...{\i0}
Dialog: 0,1:25:36.75,1:25:38.87,Lalai,,0,0,0,,{\an8}{\i1}Saya akan bersamanya.{\i0}
Dialog: 0,1:25:39.46,1:25:43.07,Lalai,,0,0,0,,{\an8}{\i1}Saya gembira, asalkan anda mengeringkan\Nrambut saya dengan pengering rambut yang rosak.{\i0}
Dialog: 0,1:25:43.09,1:25:46.42,Lalai,,0,0,0,,{\an8}{\i1}Sila ajar saya cara bertinju.{\i0}
Dialog: 0,1:25:46.68,1:25:48.95,Lalai,,0,0,0,,{\an8}{\i1}- Beri?\N- Kita jumpa malam ni?{\i0}
Dialog: 0,1:25:48.97,1:25:49.99,Lalai,,0,0,0,,{\an8}{\i1}Pada waktu malam?{\i0}
Dialog: 0,1:25:50.01,1:25:51.93,Lalai,,0,0,0,,{\an8}{\i1}Dia sedang mencari tabung rahsia pengerusi.{\i0}
Dialog: 0,1:25:51.95,1:25:53.58,Lalai,,0,0,0,,{\an8}{\i1}Saya akan cari dulu.{\i0}
Dialog: 0,1:25:53.60,1:25:55.66,Lalai,,0,0,0,,{\an8}{\i1}Buang...{\i0}
Dialog: 0,1:25:55.69,1:25:56.79,Lalai,,0,0,0,,{\an8}{\i1}Baek Hyun-woo.{\i0}
Dialog: 0,1:25:56.81,1:25:58.54,Lalai,,0,0,0,,{\an8}{\i1}Saya belum boleh mati.{\i0}
Dialog: 0,1:25:58.57,1:26:00.92,Lalai,,0,0,0,,{\an8}{\i1}Saya belum memberitahu anda lagi.{\i0}
Dialog: 0,1:26:00.94,1:26:02.77,Lalai,,0,0,0,,{\an8}{\i1}Saya sayang awak.{\i0}
