Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.56,0:01:04.27,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 6{\c}{\i0}
Dialog: 0,0:01:55.82,0:01:57.92,Lalai,,0,0,0,,Kenapa Hae-in tiba-tiba pergi ke Jerman?
Dialog: 0,0:01:57.95,0:02:01.57, Lalai,,0,0,0,, Mengalahkan saya. Dia cuma cakap itu urusan peribadi.
Dialog: 0,0:02:27.18,0:02:28.79, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:02:28.81,0:02:31.83, Lalai,,0,0,0,,Saya tidak boleh merokok, kerana terdapat\Kamera Nare di mana-mana.
Dialog: 0,0:02:31.86,0:02:34.38, Lalai,,0,0,0,,Semua kamera dimatikan,\Dan pembantu sudah tiada.
Dialog: 0,0:02:34.40,0:02:38.10, Lalai,,0,0,0,,Ini satu-satunya peluang saya. Biar\N saya hisap satu dan minum segelas.
Dialog: 0,0:02:38.95,0:02:41.44, Lalai,,0,0,0,,Lain kali kita buat, okay?
Dialog: 0,0:02:46.24,0:02:48.97, Lalai,,0,0,0,,Luangkan masa anda. Malam masih muda.
Dialog: 0,0:02:49.00,0:02:52.37,Lalai,,0,0,0,,Hae-in sudah tiada, dan Hyun-woo pergi juga.
Dialog: 0,0:03:24.74,0:03:27.32, Lalai,,0,0,0,,Nampaknya mereka tidak serasi,
Dialog: 0,0:03:28.08,0:03:30.57, Lalai,,0,0,0,,tetapi saya mohon untuk berbeza.
Dialog: 0,0:03:34.71,0:03:37.49,Lalai,,0,0,0,,{\i1}Mereka suka antara satu sama lain,{\i0}
Dialog: 0,0:03:37.75,0:03:39.75,Lalai,,0,0,0,,{\i1}tetapi mereka tidak tahu itu.{\i0}
Dialog: 0,0:03:40.09,0:03:43.50,Lalai,,0,0,0,,{\i1}Itulah sebabnya mereka tidak pernah\Bukan halaman yang sama. Bodoh.{\i0}
Dialog: 0,0:04:15.88,0:04:17.62,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,0:04:17.75,0:04:21.40, Lalai,,0,0,0,, Bermimpi jika rancangan anda ingin mencari\Nsesuatu pada Hyun-woo dan menghalaunya.
Dialog: 0,0:04:21.42,0:04:24.15,Lalai,,0,0,0,,Grace telah memerhatikannya selama tiga tahun,
Dialog: 0,0:04:24.18,0:04:26.09, Lalai,,0,0,0,,dan tidak menemui apa-apa.
Dialog: 0,0:04:26.22,0:04:28.50, Lalai,,0,0,0,,- Betul ke?\N- Saya beritahu awak.
Dialog: 0,0:04:37.19,0:04:41.27, Lalai,,0,0,0,,Tetapi seseorang yang bersih\N tidak akan mempunyai sesuatu seperti ini.
Dialog: 0,0:04:49.66,0:04:51.80, Lalai,,0,0,0,, En. Kim, kenapa awak telefon saya?
Dialog: 0,0:04:51.83,0:04:55.04,Lalai,,0,0,0,,{\an8}Kita tidak sepatutnya menelefon antara satu sama lain\Nsemasa bos kita sedang bercuti.
Dialog: 0,0:04:55.06,0:04:56.24,Lalai,,0,0,0,,Di manakah anda? Pulau Jeju?
Dialog: 0,0:04:56.26,0:04:57.31, Lalai,,0,0,0,,{\i1}Di tempat yang lebih baik.{\i0}
Dialog: 0,0:04:57.33,0:04:59.73, Lalai,,0,0,0,,Sampai pada intinya. Saya akan menutup telefon jika anda bercakap kedai.
Dialog: 0,0:04:59.75,0:05:02.11, Lalai,,0,0,0,,Adakah Cik Hong berada di Frankfurt?
Dialog: 0,0:05:02.13,0:05:04.57,Lalai,,0,0,0,,{\i1}Saya rasa Encik Baek telah terbang keluar semalam,{\i0}
Dialog: 0,0:05:04.59,0:05:06.57,Lalai,,0,0,0,,tetapi dia tidak memberitahu saya destinasinya.
Dialog: 0,0:05:06.59,0:05:08.82, Lalai,,0,0,0,,Bagaimana saya tahu ke mana bos anda pergi?
Dialog: 0,0:05:08.85,0:05:11.71, Lalai,,0,0,0,,Mengapa Cik Hong pergi ke Jerman?
Dialog: 0,0:05:12.47,0:05:13.62, Lalai,,0,0,0,,Mengapa anda ingin tahu?
Dialog: 0,0:05:13.64,0:05:15.79,Lalai,,0,0,0,,Mereka berdua tiba-tiba pergi,
Dialog: 0,0:05:15.81,0:05:17.75,Lalai,,0,0,0,,{\i1}dan saya berada dalam kegelapan.{\i0}
Dialog: 0,0:05:17.77,0:05:20.87,Lalai,,0,0,0,,Jangan bersusah payah mencari\Nmereka jika mereka tidak memberitahu anda.
Dialog: 0,0:05:20.90,0:05:21.92, Lalai,,0,0,0,,Ia salah.
Dialog: 0,0:05:21.94,0:05:25.46, Lalai,,0,0,0,,Selain itu, saya tidak mempunyai rehat selama seminggu selama bertahun-tahun,
Dialog: 0,0:05:25.49,0:05:28.76,Lalai,,0,0,0,,jadi jangan hubungi saya untuk perkara remeh\atau perkara penting.
Dialog: 0,0:05:33.04,0:05:34.64, Lalai,,0,0,0,,Saya pasti...
Dialog: 0,0:05:34.66,0:05:36.47, Lalai,,0,0,0,,sesuatu telah berlaku.
Dialog: 0,0:05:36.50,0:05:40.99, Lalai,,0,0,0,,Di manakah mereka berada?
Dialog: 0,0:05:43.55,0:05:45.08,Lalai,,0,0,0,,Jom pulang.
Dialog: 0,0:05:50.60,0:05:54.13, Lalai,,0,0,0,,Saya fikir saya akan menemuinya di sini.
Dialog: 0,0:05:55.35,0:05:58.43, Lalai,,0,0,0,,Cara hidup yang ajaib,
Dialog: 0,0:05:59.02,0:06:01.51, Lalai,,0,0,0,, atau tempat yang tiada kesedihan.
Dialog: 0,0:06:05.57,0:06:07.27, Lalai,,0,0,0,,Tetapi tiada.
Dialog: 0,0:06:08.32,0:06:10.06, Lalai,,0,0,0,, Semua yang saya mahu...
Dialog: 0,0:06:10.99,0:06:13.94, Lalai,,0,0,0,, adalah untuk pulang bersama anda.
Dialog: 0,0:07:10.72,0:07:13.61,Lalai,,0,0,0,,Kamu berdua pasti sedang jatuh cinta,
Dialog: 0,0:07:13.64,0:07:18.16, Lalai,,0,0,0,,tetapi adakah anda fikir anda boleh melakukannya di tempat lain?
Dialog: 0,0:07:18.18,0:07:23.12,Lalai,,0,0,0,,Isteri saya yang tersayang juga sedang menunggu saya...
Dialog: 0,0:07:23.15,0:07:27.35, Lalai,,0,0,0,,balik ke rumah.
Dialog: 0,0:07:58.47,0:08:00.08, Lalai,,0,0,0,,Saya tertanya-tanya apa rahsia yang dia sembunyikan.
Dialog: 0,0:08:00.10,0:08:01.37, Lalai,,0,0,0,,Mungkin tiada apa-apa.
Dialog: 0,0:08:01.39,0:08:02.62, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:08:02.64,0:08:04.91, Lalai,,0,0,0,,Perhubungan terikat\Nuntuk runtuh dengan rahsia.
Dialog: 0,0:08:04.94,0:08:07.01, Lalai,,0,0,0,,Itulah kuasanya.
Dialog: 0,0:08:18.53,0:08:20.94, Lalai,,0,0,0,,Mengapa mi cawan tiba-tiba?
Dialog: 0,0:08:24.75,0:08:25.85, Lalai,,0,0,0,,Saya mahu mencubanya.
Dialog: 0,0:08:25.88,0:08:28.56,Lalai,,0,0,0,,Saya tahu ia penuh dengan bahan kimia dan MSG,
Dialog: 0,0:08:28.59,0:08:32.37,Lalai,,0,0,0,,tetapi saya akan kecewa jika saya mati\Tanpa rasa.
Dialog: 0,0:08:33.59,0:08:35.88, Lalai,,0,0,0,,Tunggu sahaja tiga minit.
Dialog: 0,0:08:38.05,0:08:39.74, Lalai,,0,0,0,,Kemudian saya akan bercakap sementara itu.
Dialog: 0,0:08:39.76,0:08:42.66, Lalai,,0,0,0,,Saya akan bercakap sementara kita menunggu, jadi ia tidak akan kelihatan...
Dialog: 0,0:08:42.68,0:08:44.22, Lalai,,0,0,0,,terlalu serius.
Dialog: 0,0:08:44.39,0:08:45.37, Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,0:08:45.39,0:08:48.43, Lalai,,0,0,0,,Perkara yang saya ingin anda lakukan.
Dialog: 0,0:08:49.86,0:08:51.39, Lalai,,0,0,0,,Saya sedang mendengar.
Dialog: 0,0:08:52.61,0:08:54.31, Lalai,,0,0,0,,Jangan tahan...
Dialog: 0,0:08:54.65,0:08:56.77, Lalai,,0,0,0,,perkhidmatan peringatan untuk saya.
Dialog: 0,0:08:57.24,0:08:59.76, Lalai,,0,0,0,,Saya tidak suka mana-mana makanan.
Dialog: 0,0:08:59.78,0:09:01.86, Lalai,,0,0,0,,Jika anda ingin memperingati saya,
Dialog: 0,0:09:01.95,0:09:04.89,Lalai,,0,0,0,,fikirkan saya sambil menikmati\Nsedikit wain di tempat yang bagus,
Dialog: 0,0:09:04.91,0:09:08.08, Lalai,,0,0,0,,dan letakkan beberapa beg tangan Hercyna di atas meja.
Dialog: 0,0:09:09.42,0:09:12.31,Lalai,,0,0,0,,Adakah anda jadi begini\Nkerana klinik menolak anda?
Dialog: 0,0:09:12.34,0:09:15.28,Lalai,,0,0,0,,Mereka boleh menghubungi anda semula\Ndengan berita baik di hadapan.
Dialog: 0,0:09:15.30,0:09:18.11, Lalai,,0,0,0,,Tulis obituari yang bagus juga.
Dialog: 0,0:09:18.14,0:09:21.63, Lalai,,0,0,0,,Tambah beberapa cerita mengharukan tentang saya.
Dialog: 0,0:09:22.10,0:09:23.53, Lalai,,0,0,0,,Tiada.
Dialog: 0,0:09:23.56,0:09:24.95, Lalai,,0,0,0,,Tidak, saya pasti ada.
Dialog: 0,0:09:24.98,0:09:26.60, Lalai,,0,0,0,,Juga...
Dialog: 0,0:09:26.63,0:09:27.62, Lalai,,0,0,0,,Ada lagi?
Dialog: 0,0:09:27.65,0:09:31.12, Lalai,,0,0,0,,Berjaga-jaga semasa pengebumian saya.
Dialog: 0,0:09:31.15,0:09:33.96, Lalai,,0,0,0,,Semua orang yang tidak menyukai saya akan hadir.
Dialog: 0,0:09:33.99,0:09:36.96, Lalai,,0,0,0,,Hyeon-ju, Jeong-mi, Eun-jin dan Ye-na.
Dialog: 0,0:09:36.99,0:09:38.52,Lalai,,0,0,0,,Dengar baik-baik...
Dialog: 0,0:09:38.66,0:09:40.41, Lalai,,0,0,0,, kepada apa yang mereka katakan.
Dialog: 0,0:09:40.43,0:09:41.43, Lalai,,0,0,0,,Dan?
Dialog: 0,0:09:41.45,0:09:44.10, Lalai,,0,0,0,, Saman mereka semua jika mereka memburukkan saya.
Dialog: 0,0:09:44.12,0:09:46.81,Lalai,,0,0,0,,Saman mereka kerana memfitnah si mati.
Dialog: 0,0:09:46.83,0:09:48.39, Lalai,,0,0,0,,- Saya?\N- Adakah saya patut?
Dialog: 0,0:09:48.42,0:09:51.24, Lalai,,0,0,0,,- Saya akan berada di dalam keranda.\N- Ayuh.
Dialog: 0,0:09:53.38,0:09:57.08,Lalai,,0,0,0,,Saya tidak fikir sesiapa akan bersedih,
Dialog: 0,0:09:58.68,0:10:00.42, Lalai,,0,0,0,, jadi anda sepatutnya.
Dialog: 0,0:10:01.43,0:10:03.30,Lalai,,0,0,0,,Awak akan menangis, kan?
Dialog: 0,0:10:06.35,0:10:08.37,Lalai,,0,0,0,, Menangis apabila ramai orang.
Dialog: 0,0:10:08.39,0:10:11.22,Lalai,,0,0,0,,Lebih baik jika ada kamera di sekeliling.
Dialog: 0,0:10:12.73,0:10:14.43, Lalai,,0,0,0,,Adakah anda mahu saya...
Dialog: 0,0:10:14.86,0:10:16.89, Lalai,,0,0,0,,menangis?
Dialog: 0,0:10:20.45,0:10:22.73, Lalai,,0,0,0,,Ya dan tidak.
Dialog: 0,0:10:23.28,0:10:25.68, Lalai,,0,0,0,,Saya mahu anda berasa sedih,
Dialog: 0,0:10:25.70,0:10:27.24,Lalai,,0,0,0,,tetapi saya tidak mahu awak...
Dialog: 0,0:10:28.58,0:10:30.57, Lalai,,0,0,0,,terlalu sedih.
Dialog: 0,0:10:31.29,0:10:34.98,Lalai,,0,0,0,,Saya akan berasa tidak senang jika awak mengingati saya selama-lamanya,
Dialog: 0,0:10:35.00,0:10:38.21,Lalai,,0,0,0,,tetapi saya akan marah jika anda berpindah dengan cepat.
Dialog: 0,0:10:38.97,0:10:40.79, Lalai,,0,0,0,, Kemudian apa yang perlu saya lakukan?
Dialog: 0,0:10:41.93,0:10:43.63, Lalai,,0,0,0,,Saya akan...
Dialog: 0,0:10:44.18,0:10:46.42, Lalai,,0,0,0,,seperti anda...
Dialog: 0,0:10:46.64,0:10:49.63, Lalai,,0,0,0,,untuk menganggap ia memalukan.
Dialog: 0,0:10:52.65,0:10:55.39,Lalai,,0,0,0,,Saya ingin anda kasihan...
Dialog: 0,0:10:56.28,0:10:58.31, Lalai,,0,0,0,,bahawa saya tiada lagi.
Dialog: 0,0:11:00.82,0:11:02.36, Lalai,,0,0,0,,Cukuplah.
Dialog: 0,0:11:04.83,0:11:06.82, Lalai,,0,0,0,,Tiga minit anda tamat.
Dialog: 0,0:11:15.54,0:11:17.25, Lalai,,0,0,0,, Yang terakhir.
Dialog: 0,0:11:19.76,0:11:21.88, Lalai,,0,0,0,,Saya ada wasiat.
Dialog: 0,0:11:22.51,0:11:24.57,Lalai,,0,0,0,,Saya menulisnya sebelum kami berkahwin.
Dialog: 0,0:11:24.60,0:11:28.55,Lalai,,0,0,0,,Ibu saya enggan memberi kami\Nberkati jika saya tidak menulisnya.
Dialog: 0,0:11:29.14,0:11:31.08, Lalai,,0,0,0,,Anda tidak akan mewarisi apa-apa.
Dialog: 0,0:11:31.10,0:11:33.75, Lalai,,0,0,0,,Itu yang dikatakan, tetapi...
Dialog: 0,0:11:33.77,0:11:35.50, Lalai,,0,0,0,,Saya akan menyemaknya.
Dialog: 0,0:11:35.52,0:11:38.98,Lalai,,0,0,0,,Saya tidak tahu hari ini akan tiba secepat ini.
Dialog: 0,0:11:39.36,0:11:43.11,Lalai,,0,0,0,,Saya hanya menulisnya supaya kita boleh berkahwin.
Dialog: 0,0:11:45.83,0:11:47.98, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:11:48.74,0:11:50.70,Lalai,,0,0,0,,Adakah anda kecewa?
Dialog: 0,0:11:53.08,0:11:54.78,Lalai,,0,0,0,,No.
Dialog: 0,0:11:55.33,0:11:57.12,Lalai,,0,0,0,,Saya bersyukur...
Dialog: 0,0:11:57.80,0:11:59.50, Lalai,,0,0,0,, bahawa anda akan melakukannya.
Dialog: 0,0:12:00.92,0:12:02.71, Lalai,,0,0,0,,Sila lakukan itu,
Dialog: 0,0:12:03.97,0:12:05.67, Lalai,,0,0,0,,tetapi...
Dialog: 0,0:12:05.97,0:12:07.92, Lalai,,0,0,0,,bukan sekarang.
Dialog: 0,0:12:08.31,0:12:10.17, Lalai,,0,0,0,,Saya tidak akan membenarkannya.
Dialog: 0,0:12:11.81,0:12:13.72,Lalai,,0,0,0,,Kemudian bila?
Dialog: 0,0:12:14.19,0:12:15.72, Lalai,,0,0,0,,Kemudian.
Dialog: 0,0:12:16.65,0:12:20.09, Lalai,,0,0,0,,Setelah anda pulih sepenuhnya,
Dialog: 0,0:12:20.11,0:12:21.64, Lalai,,0,0,0,,anda boleh melakukannya.
Dialog: 0,0:12:26.57,0:12:28.28,Lalai,,0,0,0,,Tetapi buat masa ini...
Dialog: 0,0:12:36.83,0:12:38.54,Lalai,,0,0,0,,Jom makan.
Dialog: 0,0:12:39.00,0:12:41.16, Lalai,,0,0,0,,Sudah lebih tiga minit.
Dialog: 0,0:12:44.26,0:12:45.96, Lalai,,0,0,0,,Ia akan menjadi basah.
Dialog: 0,0:13:14.50,0:13:16.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Juseong Tech 24{\c}{\i0}
Dialog: 0,0:13:28.59,0:13:31.05, Lalai,,0,0,0,, Letakkan semula. Kita perlu pergi.
Dialog: 0,0:13:31.22,0:13:33.70,Lalai,,0,0,0,,Saya tidak dapat membeli ini, walaupun\Selepas menunggu selama berbulan-bulan.
Dialog: 0,0:13:33.72,0:13:36.30, Lalai,,0,0,0,,Tetapi dia menyimpannya di dalam almarinya.
Dialog: 0,0:13:36.69,0:13:41.47, Lalai,,0,0,0,,Hei, bagaimana keadaan akan berubah\Tidak jika kita kaya seperti ini?
Dialog: 0,0:13:42.32,0:13:44.54,Lalai,,0,0,0,,Adakah hidup kita berbeza?
Dialog: 0,0:13:44.57,0:13:46.31,Lalai,,0,0,0,,Adakah anda iri hati?
Dialog: 0,0:13:46.78,0:13:51.02,Lalai,,0,0,0,,Saya tahu saya akan lebih bijak daripada Soo-cheol.
Dialog: 0,0:13:51.33,0:13:52.55, Lalai,,0,0,0,,Bagaimana dia bodoh?
Dialog: 0,0:13:52.58,0:13:56.91,Lalai,,0,0,0,,Saya tidak pernah berjumpa sesiapa yang\Nlebih mudah untuk diperbodohkan daripada dia.
Dialog: 0,0:13:57.67,0:13:59.87,Lalai,,0,0,0,,Itulah sebabnya awak boleh kahwin dengan dia.
Dialog: 0,0:14:00.96,0:14:03.83, Lalai,,0,0,0,,Adakah anda tahu apa yang dia katakan kepada saya?
Dialog: 0,0:14:07.76,0:14:10.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak suka Lee Seung-gi, walaupun dia terkenal.{\c}{\i0}
Dialog: 0,0:14:11.00,0:14:11.99,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa?{\c}{\i0}
Dialog: 0,0:14:12.01,0:14:14.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia menyanyi tentang seorang wanita yang lebih tua daripadanya.{\c}{\i0}
Dialog: 0,0:14:14.85,0:14:17.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak suka wanita yang lebih tua daripada saya.{\c}{\i0}
Dialog: 0,0:14:17.43,0:14:19.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adik-adik saya membuli saya sejak saya kecil lagi,{\c}{\i0}
Dialog: 0,0:14:19.81,0:14:22.00, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi saya trauma.{\c}{\i0}
Dialog: 0,0:14:22.02,0:14:23.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya faham.{\c}{\i0}
Dialog: 0,0:14:23.19,0:14:25.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Badan saya bertindak balas terlebih dahulu apabila saya bertemu dengan wanita yang lebih tua.{\c}{\i0}
Dialog: 0,0:14:25.48,0:14:27.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya merinding dan ruam.{\c}{\i0}
Dialog: 0,0:14:27.40,0:14:29.51,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Malah saya sendiri terpesona.{\c}{\i0}
Dialog: 0,0:14:29.53,0:14:32.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya seperti pengesan umur.{\c}{\i0}
Dialog: 0,0:14:34.74,0:14:36.51,Lalai,,0,0,0,,Bagaimanakah anda fikir dia akan bertindak balas...
Dialog: 0,0:14:36.54,0:14:40.95,Lalai,,0,0,0,,jika dia mendapat tahu isterinya\Sebenarnya lima tahun lebih tua daripadanya?
Dialog: 0,0:14:51.84,0:14:52.82, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:14:52.85,0:14:55.74,Lalai,,0,0,0,,Anda tidak menyentuh kepala dengan\Niron. Bawakan saya pisau buluh.
Dialog: 0,0:14:55.76,0:14:57.41,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:14:57.43,0:14:58.83, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:14:58.85,0:15:00.58, Lalai,,0,0,0,,Ini? Ia ginseng liar.
Dialog: 0,0:15:00.60,0:15:04.14, Lalai,,0,0,0,,Ia bukan sebarang liar\Nginseng. Ia berusia satu abad.
Dialog: 0,0:15:04.40,0:15:07.67,Lalai,,0,0,0,,Hadiah daripada Tuhan ini malah boleh\Nmenghidupkan semula orang mati.
Dialog: 0,0:15:07.69,0:15:09.63, Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:15:09.65,0:15:11.51, Lalai,,0,0,0,,Secara kiasan.
Dialog: 0,0:15:11.53,0:15:16.93,Lalai,,0,0,0,,Kebimbangan Soo-cheol dan berlebihan\Nberpeluh disebabkan tenaganya yang lemah,
Dialog: 0,0:15:16.95,0:15:18.81, Lalai,,0,0,0,,jadi dia perlu makan ini dengan kerap.
Dialog: 0,0:15:18.83,0:15:22.10, Lalai,,0,0,0,, Keseluruhan panjang\Nginseng liar ini ialah 4 kaki.
Dialog: 0,0:15:22.12,0:15:26.77, Lalai,,0,0,0,,Saya telah menghidap ginseng liar selama 20 tahun sekarang,\Ntetapi saya tidak pernah melihat ginseng sebesar ini sebelum ini.
Dialog: 0,0:15:26.80,0:15:28.40,Lalai,,0,0,0,,Hei, berikan ini kepada saya.
Dialog: 0,0:15:28.42,0:15:29.90, Lalai,,0,0,0,,Jangan jadi bodoh.
Dialog: 0,0:15:29.92,0:15:31.32, Lalai,,0,0,0,,Adakah anda suka ginseng liar?
Dialog: 0,0:15:31.34,0:15:34.32, Lalai,,0,0,0,, Seon-hwa, berapa harga ini? Saya akan membayar anda lebih.
Dialog: 0,0:15:34.35,0:15:38.33,Lalai,,0,0,0,,Saya membeli ini bukan untuk orang lain melainkan anak saya.
Dialog: 0,0:15:38.35,0:15:40.04, Lalai,,0,0,0,,Saya tidak boleh berbuat demikian.
Dialog: 0,0:15:40.06,0:15:42.33, Lalai,,0,0,0,,Ia bukan untuk saya.
Dialog: 0,0:15:42.35,0:15:45.25,Lalai,,0,0,0,,Ia untuk anak awak yang lain, Hae-in.
Dialog: 0,0:15:45.27,0:15:47.79,Lalai,,0,0,0,,Apa? Kenapa awak,\Npadahal dia sudah begitu kuat?
Dialog: 0,0:15:47.82,0:15:49.75,Lalai,,0,0,0,,Adakah anda mahu dia menjadi Superwoman?
Dialog: 0,0:15:49.78,0:15:52.81,Lalai,,0,0,0,,Dia tidak kuat!
Dialog: 0,0:15:54.11,0:15:57.11, Lalai,,0,0,0,,Dia juga boleh jatuh sakit.
Dialog: 0,0:15:57.58,0:16:01.71,Lalai,,0,0,0,,Hae-in jarang diserang selsema sepanjang hayatnya, jadi jangan risau tentang dia.
Dialog: 0,0:16:01.73,0:16:02.77, Lalai,,0,0,0,, Seon-hwa.
Dialog: 0,0:16:02.79,0:16:07.77,Lalai,,0,0,0,,Anda tidak boleh menjamin kesihatan seseorang.\NI tidak bermakna dia akan sihat selama-lamanya.
Dialog: 0,0:16:07.80,0:16:10.87,Lalai,,0,0,0,,Biar saya jaga kesihatan anak-anak saya.
Dialog: 0,0:16:14.84,0:16:18.34, Lalai,,0,0,0,,Hei, awak kata ini panjangnya 4 kaki.
Dialog: 0,0:16:18.68,0:16:21.30, Lalai,,0,0,0,,Kenapa kamu tidak berpecah dengan Hae-in?
Dialog: 0,0:16:21.68,0:16:23.75,Lalai,,0,0,0,,Bukan saya tidak mahu berkongsi.
Dialog: 0,0:16:23.77,0:16:27.25,Lalai,,0,0,0,,Ginseng liar hanya\Berkesan jika anda memilikinya sepenuhnya.
Dialog: 0,0:16:27.27,0:16:29.29,Lalai,,0,0,0,,Baiklah, kemudian biarkan Hae-in memiliki semuanya.
Dialog: 0,0:16:29.32,0:16:33.05, Lalai,,0,0,0,,Anda tidak berkata apa-apa selama\Nselama 20 tahun yang lalu, jadi kenapa sekarang?
Dialog: 0,0:16:33.07,0:16:37.19,Lalai,,0,0,0,,Berhenti menjadi tamak jika anda telah\Mengalaminya selama itu, bodoh!
Dialog: 0,0:16:41.25,0:16:43.39,Lalai,,0,0,0,,Kebaikan. Apa masalah dia?
Dialog: 0,0:16:43.41,0:16:45.53, Lalai,,0,0,0,,Saya rasa ia menopaus.
Dialog: 0,0:16:45.92,0:16:47.77,Lalai,,0,0,0,,Hei, makanlah sebelum dia kembali.
Dialog: 0,0:16:47.79,0:16:49.35, Lalai,,0,0,0,,Ambil.
Dialog: 0,0:16:49.38,0:16:52.04, Lalai,,0,0,0,,- Sila potong menjadi tiga.\N- Okay.
Dialog: 0,0:16:59.18,0:17:01.05, Lalai,,0,0,0,, Beom-jun.
Dialog: 0,0:17:02.47,0:17:04.72, Lalai,,0,0,0,,Hei, Beom-ja.
Dialog: 0,0:17:05.77,0:17:07.96,Lalai,,0,0,0,,Beom-seok bertolak ke Hawaii malam tadi.
Dialog: 0,0:17:07.98,0:17:12.06,Lalai,,0,0,0,,Kami tidak pernah berkumpul.
Dialog: 0,0:17:14.90,0:17:16.94, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:17:18.28,0:17:20.05, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:17:20.08,0:17:22.05, Lalai,,0,0,0,,Adakah anda memberi makan siput sekarang?
Dialog: 0,0:17:22.08,0:17:26.89,Lalai,,0,0,0,,Cangkang Paengsun patah.\Ndia pasti sangat kesakitan.
Dialog: 0,0:17:26.92,0:17:29.89, Lalai,,0,0,0,,Dia perlu makan kulit telur untuk mendapatkan lebih banyak kalsium,
Dialog: 0,0:17:29.92,0:17:33.29, Lalai,,0,0,0,,tetapi dia tidak akan makan apa-apa.
Dialog: 0,0:17:34.76,0:17:38.65, Lalai,,0,0,0,,Apa guna anda jika siput itu\Nmematahkan cangkangnya dan tidak mempunyai selera makan?
Dialog: 0,0:17:38.68,0:17:41.11, Lalai,,0,0,0,,Ada lagi.
Dialog: 0,0:17:41.14,0:17:43.07, Lalai,,0,0,0,,Apabila siput kehilangan cangkerangnya...
Dialog: 0,0:17:43.10,0:17:46.38, Lalai,,0,0,0,,Saya tidak kisah! Ia mungkin akan bertukar menjadi slug!
Dialog: 0,0:17:46.89,0:17:49.97, Lalai,,0,0,0,,Dia akan mati tanpa cangkerangnya.
Dialog: 0,0:17:50.31,0:17:53.13, Lalai,,0,0,0,,Ringkasnya, dia menderita\Ndari penyakit yang tidak dapat diubati.
Dialog: 0,0:17:53.15,0:17:54.85, Lalai,,0,0,0,,Dia sakit tenat.
Dialog: 0,0:18:03.62,0:18:06.11, Lalai,,0,0,0,,- Apa yang salah?\N- Beom-jun.
Dialog: 0,0:18:11.34,0:18:13.04, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:18:15.26,0:18:17.07, Lalai,,0,0,0,,Siapa kali ini?
Dialog: 0,0:18:17.09,0:18:19.86, Lalai,,0,0,0,, Beom-jun saya yang malang...
Dialog: 0,0:18:19.89,0:18:21.63, Lalai,,0,0,0,, Beom-ja.
Dialog: 0,0:18:22.14,0:18:24.46, Lalai,,0,0,0,,Saya minta maaf untuk mengatakan ini,
Dialog: 0,0:18:24.85,0:18:29.30,Lalai,,0,0,0,,tetapi anda ahli keluarga\N yang paling menyedihkan selepas Paengsun.
Dialog: 0,0:18:33.69,0:18:35.23, Lalai,,0,0,0,, Beom-jun.
Dialog: 0,0:18:35.40,0:18:37.02, Lalai,,0,0,0,,Ada segelas.
Dialog: 0,0:18:48.54,0:18:51.45,Lalai,,0,0,0,,Anda hanya mati untuk minum, bukan?
Dialog: 0,0:18:58.51,0:19:01.38, Lalai,,0,0,0,,Apa yang perlu saya lakukan dengan abang saya yang malang?
Dialog: 0,0:19:24.37,0:19:26.99, Lalai,,0,0,0,,Semuanya dalam bahasa Jerman.
Dialog: 0,0:19:27.79,0:19:31.24, Lalai,,0,0,0,, Lagipun, kami berada di Jerman.
Dialog: 0,0:19:34.00,0:19:37.04, Lalai,,0,0,0,, Patutkah saya mematikannya?
Dialog: 0,0:19:45.35,0:19:47.55,Lalai,,0,0,0,,Saya akan tidur dalam bilik itu.
Dialog: 0,0:19:48.52,0:19:51.38, Lalai,,0,0,0,,Anda boleh tidur di mana-mana yang anda mahu.
Dialog: 0,0:19:53.23,0:19:56.31, Lalai,,0,0,0,,Awak nak saya ambil bilik tu?
Dialog: 0,0:20:00.78,0:20:03.76, Lalai,,0,0,0,,Bukan itu yang saya katakan.\Tidurlah di mana sahaja anda mahu.
Dialog: 0,0:20:03.78,0:20:06.19, Lalai,,0,0,0,,Lakukan seperti yang anda mahu. Ikut kata hati.
Dialog: 0,0:20:28.89,0:20:29.95, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:20:29.97,0:20:31.97, Lalai,,0,0,0,,Bolehkah saya...?
Dialog: 0,0:20:32.18,0:20:34.68, Lalai,,0,0,0,,Maksud saya, mulai hari ini,
Dialog: 0,0:20:36.06,0:20:39.02, Lalai,,0,0,0,,boleh saya tidur dalam bilik awak?
Dialog: 0,0:20:44.36,0:20:46.06, Lalai,,0,0,0,,Saya rasa...
Dialog: 0,0:20:46.45,0:20:48.52,Lalai,,0,0,0,,anda masih tidak selesa.
Dialog: 0,0:20:52.45,0:20:54.32, Lalai,,0,0,0,,Saya tidak pernah berkata begitu.
Dialog: 0,0:20:54.96,0:20:56.95, Lalai,,0,0,0,,Saya tidak berkata apa-apa.
Dialog: 0,0:20:57.13,0:21:00.10, Lalai,,0,0,0,,Jangan membuat kesimpulan. saya...
Dialog: 0,0:21:00.13,0:21:02.08, Lalai,,0,0,0,, memikirkannya.
Dialog: 0,0:21:02.46,0:21:04.17, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:21:05.47,0:21:07.17, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:21:07.47,0:21:09.17, Lalai,,0,0,0,,Fikirkanlah.
Dialog: 0,0:21:12.68,0:21:14.04, Lalai,,0,0,0,,Jadi...
Dialog: 0,0:21:14.39,0:21:16.10, Lalai,,0,0,0,,hanya hari ini,
Dialog: 0,0:21:16.27,0:21:18.04, Lalai,,0,0,0,, atau mulai hari ini?
Dialog: 0,0:21:18.06,0:21:20.33, Lalai,,0,0,0,,Dari hari ini hingga selamanya?
Dialog: 0,0:21:20.36,0:21:23.52,Lalai,,0,0,0,,Ya, hari ini hingga selama-lamanya.
Dialog: 0,0:21:27.24,0:21:29.27, Lalai,,0,0,0,,Tawaran.
Dialog: 0,0:21:33.70,0:21:36.41, Lalai,,0,0,0,,- Deal.\N- Saya faham. "Perjanjian"?
Dialog: 0,0:21:36.92,0:21:39.49, Lalai,,0,0,0,,Itu yang awak cakap, kan?
Dialog: 0,0:21:42.05,0:21:43.75, Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,0:22:06.32,0:22:08.15, Lalai,,0,0,0,,Awak kenal Kim Ye-na?
Dialog: 0,0:22:08.20,0:22:11.34, Lalai,,0,0,0,, Ketua Pegawai Eksekutif Diraja, yang kami\N temui di pesta Hercyna.
Dialog: 0,0:22:11.37,0:22:13.11, Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,0:22:13.33,0:22:14.80, Lalai,,0,0,0,,Dia mendapat...
Dialog: 0,0:22:14.83,0:22:17.57, Lalai,,0,0,0,,ke dalam kemalangan kereta minggu lepas.
Dialog: 0,0:22:18.83,0:22:21.64, Lalai,,0,0,0,,Dia pengsan dan pergi ke ED.
Dialog: 0,0:22:21.67,0:22:24.44, Lalai,,0,0,0,,Kemudian suaminya dan peguamnya bergegas menghampiri.
Dialog: 0,0:22:24.46,0:22:26.32, Lalai,,0,0,0,,- Peguamnya?\N- Ya.
Dialog: 0,0:22:26.34,0:22:30.92, Lalai,,0,0,0,,Suaminya menyangka dia sedang nazak,\Njadi dia mahu dia menandatangani beberapa perkara.
Dialog: 0,0:22:31.47,0:22:33.17, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:22:35.47,0:22:41.47,Lalai,,0,0,0,,Dia bersungguh-sungguh memberitahu\Ndoktor dia belum boleh mati lagi,
Dialog: 0,0:22:41.52,0:22:43.37, Lalai,,0,0,0,,kerana dia terpaksa menandatangani sesuatu.
Dialog: 0,0:22:43.40,0:22:47.38, Lalai,,0,0,0,,Dia menyebabkan adegan dan berkata\Ndia perlu menyemak semula kehendaknya.
Dialog: 0,0:22:47.40,0:22:50.65, Lalai,,0,0,0,,Dia bising sehingga dia bangun.
Dialog: 0,0:22:51.07,0:22:52.61, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:22:53.91,0:22:55.85, Lalai,,0,0,0,,Saya nampak ia akan datang.
Dialog: 0,0:22:55.87,0:22:58.47,Lalai,,0,0,0,,Dia kelihatan seperti Shrek versi manusia.
Dialog: 0,0:22:58.50,0:23:00.60, Lalai,,0,0,0,,Bagaimanakah raksasa itu boleh menjadi begitu keji?
Dialog: 0,0:23:00.62,0:23:04.54,Lalai,,0,0,0,,Isterinya di ambang kematian,\Dan dia hanya mementingkan wangnya?
Dialog: 0,0:23:05.13,0:23:06.95, Lalai,,0,0,0,,Dia layak mati.
Dialog: 0,0:23:09.88,0:23:13.75, Lalai,,0,0,0,,Jangan cakap kasar sangat.
Dialog: 0,0:23:14.26,0:23:16.62,Lalai,,0,0,0,,Betul. Bukan dia sahaja.
Dialog: 0,0:23:16.64,0:23:20.24,Lalai,,0,0,0,,Perkara pertama orang bertanya apabila\Nmereka mendengar tentang kematian seseorang ialah,
Dialog: 0,0:23:20.27,0:23:23.21, Lalai,,0,0,0,,"Jadi siapa yang menerima semua warisan?"
Dialog: 0,0:23:23.23,0:23:26.21, Lalai,,0,0,0,,"Wang tunai? Hartanah?\NStok? Cukai warisan?"
Dialog: 0,0:23:26.23,0:23:29.21,Default,,0,0,0,,Ada yang kata ada\Nsuami ketawa dalam tandas...
Dialog: 0,0:23:29.24,0:23:31.23, Lalai,,0,0,0,,di pengebumian isteri mereka.
Dialog: 0,0:23:37.74,0:23:39.57, Lalai,,0,0,0,,Bukan semua orang...
Dialog: 0,0:23:43.75,0:23:45.66,Lalai,,0,0,0,,sama seperti anda.
Dialog: 0,0:23:46.25,0:23:48.29,Lalai,,0,0,0,,Apa? Seperti saya?
Dialog: 0,0:23:49.21,0:23:53.21,Lalai,,0,0,0,,Adakah anda masih ingat perkara pertama\Nyou cakap semasa saya berkata saya sakit?
Dialog: 0,0:23:55.29,0:23:57.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak, Hong Hae-in.{\c}{\i0}
Dialog: 0,0:23:57.88,0:23:58.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak.{\c}{\i0}
Dialog: 0,0:23:58.88,0:24:00.66, Lalai,,0,0,0, "Saya sayang awak."
Dialog: 0,0:24:02.19,0:24:03.16, Lalai,,0,0,0,, Adakah saya?
Dialog: 0,0:24:03.19,0:24:08.47, Lalai,,0,0,0,,Tahukah anda kata-kata itu sangat menghiburkan saya?
Dialog: 0,0:24:09.44,0:24:11.19,Lalai,,0,0,0,,Nah...
Dialog: 0,0:24:11.28,0:24:14.09,Lalai,,0,0,0,,Jangan terlalu menekankan apa yang saya katakan...
Dialog: 0,0:24:14.11,0:24:17.61, Lalai,,0,0,0,,Anda mahu melihat sama ada saya bernafas dengan baik.
Dialog: 0,0:24:19.33,0:24:21.49,Lalai,,0,0,0,,Anda panik apabila saya batuk.
Dialog: 0,0:24:21.91,0:24:24.14, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey? Sila hubungi ambulans.{\c}{\i0}
Dialog: 0,0:24:24.17,0:24:28.44,Lalai,,0,0,0,,Anda tidak mengambil berat tentang\N kehendak saya atau kekayaan yang anda akan dapat.
Dialog: 0,0:24:28.46,0:24:30.25, Lalai,,0,0,0,,Anda tidak pernah bertanya.
Dialog: 0,0:24:30.71,0:24:34.75,Lalai,,0,0,0,,Awak berjaga sepanjang malam kerana risaukan saya.
Dialog: 0,0:24:39.26,0:24:41.53,Lalai,,0,0,0,,Itu suami saya.
Dialog: 0,0:24:41.56,0:24:43.80, Lalai,,0,0,0,,Kamu memang luar biasa.
Dialog: 0,0:24:46.73,0:24:48.43, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:24:49.57,0:24:51.21,Lalai,,0,0,0,,Tiada orang seperti saya.
Dialog: 0,0:24:51.23,0:24:55.61, Lalai,,0,0,0,,Dan kini anda terbang ke seluruh dunia hanya untuk saya.
Dialog: 0,0:24:56.99,0:24:59.03, Lalai,,0,0,0,,Hanya mungkin...
Dialog: 0,0:24:59.08,0:25:01.61, Lalai,,0,0,0,,terima kasih kepada penerbangan terus.
Dialog: 0,0:25:01.91,0:25:05.24,Lalai,,0,0,0,,Saya benar-benar dikurniakan seorang suami yang baik.
Dialog: 0,0:25:09.92,0:25:11.45, Lalai,,0,0,0,,No.
Dialog: 0,0:25:11.96,0:25:14.33, Lalai,,0,0,0,,Itu satu perkara yang anda tiada.
Dialog: 0,0:27:14.59,0:27:17.72,Lalai,,0,0,0,,Hyun-woo, di mana awak?\NAnda belum menjawab.
Dialog: 0,0:27:17.74,0:27:18.77, Lalai,,0,0,0,,Maaf, saya tidak dapat pergi.
Dialog: 0,0:27:18.80,0:27:21.58,Lalai,,0,0,0,,{\i1}Saya sepatutnya memberitahu anda, tetapi saya terlalu sibuk.{\i0}
Dialog: 0,0:27:22.43,0:27:23.40,Lalai,,0,0,0,,Di manakah anda?
Dialog: 0,0:27:23.43,0:27:25.24,Lalai,,0,0,0,,Saya tidak boleh katakan sekarang. Nanti.
Dialog: 0,0:27:25.26,0:27:28.91, Lalai,,0,0,0,,Jawab saya "ya" atau "tidak."\NAAdakah anda ditahan di luar kehendak anda?
Dialog: 0,0:27:28.93,0:27:31.00, Lalai,,0,0,0,,Apa yang kamu katakan? Tidak, saya tidak.
Dialog: 0,0:27:31.02,0:27:32.66, Lalai,,0,0,0,,Kalau begitu kenapa kamu tidak boleh datang?
Dialog: 0,0:27:32.69,0:27:35.00,Lalai,,0,0,0,,Cheol-seung memberitahu isterinya dia tidak boleh datang,
Dialog: 0,0:27:35.02,0:27:37.79,Lalai,,0,0,0,,dan dia memukulnya dengan\Nslipper, tetapi dia masih datang.
Dialog: 0,0:27:37.82,0:27:39.43, Lalai,,0,0,0,,- Dia memukul kepala saya.\N- Jadi di mana awak?
Dialog: 0,0:27:39.45,0:27:40.78,Lalai,,0,0,0,,{\i1}Kami sedang berseronok.{\i0}
Dialog: 0,0:27:40.80,0:27:41.84,Lalai,,0,0,0,,- Dae-ho...\N- {\i1}Saya tahu.{\i0}
Dialog: 0,0:27:41.86,0:27:44.88,Lalai,,0,0,0,,{\i1}Dia mungkin membawa peti\Npenuh dengan soju dan bir.{\i0}
Dialog: 0,0:27:44.91,0:27:47.60,Lalai,,0,0,0,,{\i1}Yeong-beom dan Sang-pil\Nare mungkin menyalakan kayu,{\i0}
Dialog: 0,0:27:47.62,0:27:49.26, Lalai,,0,0,0,,dan anda sedang memegang sepasang penyepit.
Dialog: 0,0:27:49.29,0:27:50.60,Lalai,,0,0,0,,- Siapa beli daging ni?\N- Astaga.
Dialog: 0,0:27:50.62,0:27:54.89, Lalai,,0,0,0,,Cheol-seung mungkin membeli bahu babi,\Nmemandangkan ia lebih kenyal daripada perut babi.
Dialog: 0,0:27:54.92,0:27:57.52, Lalai,,0,0,0,,Kami juga mempunyai leher babi. Ia berair dan lembut.
Dialog: 0,0:27:57.55,0:28:01.40, Lalai,,0,0,0,,Ya, ada leher babi yang berair,\Bahu babi yang kenyal,
Dialog: 0,0:28:01.42,0:28:04.15, Lalai,,0,0,0,,bir dan soju,
Dialog: 0,0:28:04.18,0:28:06.53, Lalai,,0,0,0,,tetapi kami tidak akan\Nselesaikannya jika saya berada di sana.
Dialog: 0,0:28:06.55,0:28:09.22, Lalai,,0,0,0,,Saya akan merosakkan mood.
Dialog: 0,0:28:09.31,0:28:10.84, Lalai,,0,0,0,, Jadi di manakah anda?
Dialog: 0,0:28:18.23,0:28:19.93, Lalai,,0,0,0,,Jerman.
Dialog: 0,0:28:20.19,0:28:22.05, Lalai,,0,0,0,,Jadi anda akhirnya pergi.
Dialog: 0,0:28:22.07,0:28:23.34,Lalai,,0,0,0,,{\i1}Sebaiknya anda tidak menyesal.{\i0}
Dialog: 0,0:28:23.36,0:28:26.84, Lalai,,0,0,0,,Kami akan mencelupkan sedikit\Npork leher panggang dalam {\i1}gochujang,{\i0}
Dialog: 0,0:28:26.87,0:28:28.09, Lalai,,0,0,0,,dan campurkan sedikit alkohol juga.
Dialog: 0,0:28:28.12,0:28:30.32, Lalai,,0,0,0,,Baiklah, selamat mencuba.
Dialog: 0,0:28:30.70,0:28:33.52,Lalai,,0,0,0,,Hae-in dan saya akan minum bir dan {\i1}schweinshaxe.{\i0}
Dialog: 0,0:28:33.54,0:28:36.69, Lalai,,0,0,0,,- Hei, apa itu "schweinshaxe"?\N- Bukankah itu kaki babi Jerman?
Dialog: 0,0:28:36.71,0:28:38.65, Lalai,,0,0,0,,Saya tidak kisah. Anda akan membayar untuk ini.
Dialog: 0,0:28:38.67,0:28:41.15, Lalai,,0,0,0,,Saya tidak akan mengembalikan yuran penyertaan anda.
Dialog: 0,0:28:41.17,0:28:42.15, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:28:42.17,0:28:43.32,Lalai,,0,0,0,,Hyun-woo tidak boleh datang.
Dialog: 0,0:28:43.34,0:28:44.60,Lalai,,0,0,0,,- Adakah dia ditangkap?\N- Adakah dia?
Dialog: 0,0:28:44.63,0:28:46.41, Lalai,,0,0,0,,No.
Dialog: 0,0:28:49.64,0:28:51.17, Lalai,,0,0,0,,Dia sudah berubah.
Dialog: 0,0:28:53.14,0:28:55.22, Lalai,,0,0,0,,Dia benar-benar berubah.
Dialog: 0,0:29:00.07,0:29:01.81, Lalai,,0,0,0,,Sayang, lihat ini.
Dialog: 0,0:29:05.28,0:29:07.44, Lalai,,0,0,0,,Makmal menghulurkan tangan.
Dialog: 0,0:31:05.07,0:31:08.63, Lalai,,0,0,0,,Ada rawatan ini\Ndipanggil "tangkapan Filgrastim."
Dialog: 0,0:31:08.65,0:31:12.38, Lalai,,0,0,0,,Mereka mahu meningkatkan WBC saya dengan itu,\Walaupun ia tidak dijamin.
Dialog: 0,0:31:12.41,0:31:14.53, Lalai,,0,0,0,,Mereka masih mahu mencuba.
Dialog: 0,0:31:27.30,0:31:29.23, Lalai,,0,0,0,,Hei, itu bagus.
Dialog: 0,0:31:29.26,0:31:32.00, Lalai,,0,0,0,, Nampak? Saya memberitahu anda akan ada berita baik.
Dialog: 0,0:31:32.68,0:31:33.74,Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:31:33.76,0:31:37.66, Lalai,,0,0,0,,Mengekalkan sistem imun yang baik\Ni penting untuk rawatan ini.
Dialog: 0,0:31:37.68,0:31:40.29, Lalai,,0,0,0,,Kekalkan suhu badan yang baik,\Nsupaya anda tidak diserang selsema.
Dialog: 0,0:31:40.32,0:31:42.58, Lalai,,0,0,0,,Pastikan anda juga mempunyai protein,
Dialog: 0,0:31:42.60,0:31:45.50,Lalai,,0,0,0,,dan jauhi makanan mentah\Sekiranya berlaku keracunan darah.
Dialog: 0,0:31:45.52,0:31:47.25, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:31:47.28,0:31:49.77, Lalai,,0,0,0,,Bagaimana anda tahu perkara ini?
Dialog: 0,0:31:51.86,0:31:53.48,Lalai,,0,0,0,,Akal.
Dialog: 0,0:31:53.95,0:31:55.98,Lalai,,0,0,0,,Sejak bila?
Dialog: 0,0:32:17.60,0:32:18.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Juseong Tech 24{\c}{\i0}
Dialog: 0,0:32:28.40,0:32:30.85, Lalai,,0,0,0,,Helo. Bagaimana saya boleh membantu anda?
Dialog: 0,0:32:31.44,0:32:33.92,Lalai,,0,0,0,,Ya, anda perlu membantu saya.
Dialog: 0,0:32:33.95,0:32:35.77, Lalai,,0,0,0,, Maaf?
Dialog: 0,0:32:43.79,0:32:44.85, Lalai,,0,0,0,,Bagaimana keadaannya?
Dialog: 0,0:32:44.87,0:32:46.69, Lalai,,0,0,0,,- Memang bagus.\N- Saya gembira.
Dialog: 0,0:32:46.71,0:32:49.29,Lalai,,0,0,0,,Terima kasih, puan.
Dialog: 0,0:32:59.22,0:33:00.41, Lalai,,0,0,0,,Tetap berjaga-jaga, boleh?
Dialog: 0,0:33:00.43,0:33:02.93, Lalai,,0,0,0,,- Apa yang salah?\N- "Apa yang salah"?
Dialog: 0,0:33:03.69,0:33:05.30, Lalai,,0,0,0,,Hei.
Dialog: 0,0:33:05.35,0:33:06.33, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:33:06.35,0:33:09.01, Lalai,,0,0,0,,Anda berada dalam rakaman kamera pemuka.
Dialog: 0,0:33:10.32,0:33:11.29,Lalai,,0,0,0,,Kenapa saya...?
Dialog: 0,0:33:11.32,0:33:13.88, Lalai,,0,0,0,,Ya, bodoh. Anda mungkin telah ditangkap.
Dialog: 0,0:33:13.90,0:33:16.40,Lalai,,0,0,0,,Kenapa saya nampak gemuk sangat?
Dialog: 0,0:33:16.74,0:33:18.05,Lalai,,0,0,0,,Adakah itu penting?
Dialog: 0,0:33:18.07,0:33:22.26,Lalai,,0,0,0,,Mengapa awak berdiri di situ\Nsemasa ada kereta memandu?
Dialog: 0,0:33:22.29,0:33:23.81,Lalai,,0,0,0,,- Adakah ini salah saya?\N- Kemudian adakah itu milik saya?
Dialog: 0,0:33:23.83,0:33:25.22,Lalai,,0,0,0,,Bukankah kita dalam pasukan yang sama?
Dialog: 0,0:33:25.25,0:33:28.48, Lalai,,0,0,0,,Anda sepatutnya menyokong saya,\Nsupaya saya boleh melakukannya dengan baik di luar sana,
Dialog: 0,0:33:28.50,0:33:29.56, Lalai,,0,0,0,,tetapi apakah ini?
Dialog: 0,0:33:29.59,0:33:33.55,Lalai,,0,0,0,,Saya melakukan semua kerja dan hampir\Nditangkap, terima kasih atas ketidakcekapan anda.
Dialog: 0,0:33:33.57,0:33:34.57, Lalai,,0,0,0,, Senyap.
Dialog: 0,0:33:34.59,0:33:37.58,Lalai,,0,0,0,,Bagaimana jika Encik Yoon tidak menemui ini?
Dialog: 0,0:33:37.68,0:33:39.86, Lalai,,0,0,0,,Kekal berjaga-jaga.
Dialog: 0,0:33:39.89,0:33:42.05,Lalai,,0,0,0,,Kita hampir sampai.
Dialog: 0,0:33:42.85,0:33:44.28, Lalai,,0,0,0,, Hampir di mana?
Dialog: 0,0:33:44.31,0:33:47.12,Lalai,,0,0,0,,Adakah Eun-sung akan membawa gambar besar...
Dialog: 0,0:33:47.15,0:33:49.43, Lalai,,0,0,0,,dan menelan Ratu keseluruhan?
Dialog: 0,0:33:49.61,0:33:51.21,Lalai,,0,0,0,,Ini bukan urusan anda.
Dialog: 0,0:33:51.23,0:33:53.50,Lalai,,0,0,0,,Cukup ambil bahagian anda dan pergi.
Dialog: 0,0:33:53.53,0:33:55.35, Lalai,,0,0,0,,Itu benar,
Dialog: 0,0:33:55.82,0:33:59.69,Lalai,,0,0,0,,tetapi apa yang akan berlaku kepada keluarga\Setelah dia mengambil alih Ratu?
Dialog: 0,0:34:00.70,0:34:03.90,Lalai,,0,0,0,,Jangan beritahu saya yang awak risaukan Soo-cheol?
Dialog: 0,0:34:05.16,0:34:06.14, Lalai,,0,0,0,,Saya?
Dialog: 0,0:34:06.16,0:34:07.47, Lalai,,0,0,0,,Kekal profesional.
Dialog: 0,0:34:07.50,0:34:09.37, Lalai,,0,0,0,,Itu menghina.
Dialog: 0,0:34:09.42,0:34:11.60,Lalai,,0,0,0,,Adakah anda fikir saya mempunyai perasaan terhadap si bodoh itu?
Dialog: 0,0:34:11.63,0:34:12.65, Lalai,,0,0,0,, Lupakan saja.
Dialog: 0,0:34:12.67,0:34:16.48,Lalai,,0,0,0,,Jangan lupa. Anda bukan puan kaya\Nhanya kerana orang memperlakukan anda seperti seorang.
Dialog: 0,0:34:16.51,0:34:19.61,Lalai,,0,0,0,,Apa sahaja. Saya tidak mahu menjadi satu.
Dialog: 0,0:34:19.64,0:34:21.86, Lalai,,0,0,0,,Saya tidak boleh merokok dengan tenang.
Dialog: 0,0:34:21.89,0:34:24.32,Lalai,,0,0,0,,Betul. Berhenti merokok, boleh?
Dialog: 0,0:34:24.35,0:34:26.95,Lalai,,0,0,0,,Saya terpaksa belajar cara mengedit\Nvideo, supaya saya boleh memadam...
Dialog: 0,0:34:26.98,0:34:29.54, Lalai,,0,0,0,, rakaman anda merokok di taman!
Dialog: 0,0:34:29.56,0:34:33.31, Lalai,,0,0,0,,Bagus. Jadi YouTuber sebaik sahaja anda bersara.
Dialog: 0,0:34:35.15,0:34:36.98, Lalai,,0,0,0,,Hei!
Dialog: 0,0:34:40.36,0:34:41.59,Lalai,,0,0,0,,Ibu.
Dialog: 0,0:34:41.62,0:34:43.48,Lalai,,0,0,0,,Hello, puan.
Dialog: 0,0:34:43.53,0:34:44.60,Lalai,,0,0,0,,Bila anda tiba?
Dialog: 0,0:34:44.62,0:34:47.64, Lalai,,0,0,0,,Siapa yang kamu jerit?
Dialog: 0,0:34:47.66,0:34:49.02,Lalai,,0,0,0,,Maaf? WHO?
Dialog: 0,0:34:49.04,0:34:50.73, Lalai,,0,0,0,,Itu suara anda.
Dialog: 0,0:34:50.75,0:34:52.99,Lalai,,0,0,0,,Saya tidak berkata apa-apa.
Dialog: 0,0:34:53.09,0:34:55.52,Lalai,,0,0,0,,Puan, adakah anda mendengar sesuatu?
Dialog: 0,0:34:55.55,0:34:59.08, Lalai,,0,0,0,,Tidak, saya tidak mendengar apa-apa.
Dialog: 0,0:34:59.63,0:35:02.29,Lalai,,0,0,0,,Ibu, kamu menakutkan saya.
Dialog: 0,0:35:05.39,0:35:08.41,Lalai,,0,0,0,,Saya sakit kepala, kerana\NI tidak dapat tidur semalam.
Dialog: 0,0:35:08.43,0:35:09.95, Lalai,,0,0,0,,Oh, sayang.
Dialog: 0,0:35:09.98,0:35:12.25, Lalai,,0,0,0,,Anda memerlukan urutan kulit kepala.
Dialog: 0,0:35:12.27,0:35:15.33,Lalai,,0,0,0,,Anda harus celupkan badan anda\Nin sedikit garam merah jambu dahulu.
Dialog: 0,0:35:15.36,0:35:17.52,Lalai,,0,0,0,,Selepas anda.
Dialog: 0,0:35:30.71,0:35:34.91,Lalai,,0,0,0,,Anda tukang urut terbaik pernah.
Dialog: 0,0:35:35.21,0:35:38.08, Lalai,,0,0,0,,Saya sudah berasa lebih baik.
Dialog: 0,0:35:40.47,0:35:42.17,Lalai,,0,0,0,,By the way,
Dialog: 0,0:35:42.47,0:35:44.61,Lalai,,0,0,0,,Saya dengar Encik Baek pergi ke Jerman.
Dialog: 0,0:35:44.64,0:35:46.34, Lalai,,0,0,0,,Saya rasa begitu.
Dialog: 0,0:35:47.18,0:35:48.16,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:35:48.18,0:35:49.93, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:35:51.48,0:35:52.83, Lalai,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:35:52.85,0:35:54.68, Lalai,,0,0,0,, Beritahu saya.
Dialog: 0,0:35:55.06,0:35:56.77, Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,0:35:57.02,0:35:59.39, Lalai,,0,0,0,,Saya tersilap.
Dialog: 0,0:36:00.28,0:36:02.02, Lalai,,0,0,0,,Kesilapan apa?
Dialog: 0,0:36:04.91,0:36:06.47, Lalai,,0,0,0,,Beberapa hari lalu,
Dialog: 0,0:36:06.49,0:36:08.93,Lalai,,0,0,0,,Saya secara tidak sengaja memberitahu Encik Baek\Nabi tentang wasiat Cik Hong.
Dialog: 0,0:36:08.95,0:36:10.47,Lalai,,0,0,0,,Apa?
Dialog: 0,0:36:10.50,0:36:15.29,Lalai,,0,0,0,,Dia berkata dia mendengar segala-galanya\Nand menuntut saya untuk memberitahu perkara sebenar.
Dialog: 0,0:36:15.32,0:36:16.31,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:36:16.34,0:36:19.87,Lalai,,0,0,0,,Saya tahu dia akhirnya akan jumpa\Nout, jadi saya beritahu dia secara kasar.
Dialog: 0,0:36:20.51,0:36:23.94, Lalai,,0,0,0,,Dan dia telah menyebabkan masalah di tempat kerja sejak itu.
Dialog: 0,0:36:23.97,0:36:25.45,Lalai,,0,0,0,,Hyun-woo?
Dialog: 0,0:36:25.47,0:36:28.78,Lalai,,0,0,0,,En. Hong melakukan yang terbaik...
Dialog: 0,0:36:28.81,0:36:31.70,Lalai,,0,0,0,,untuk menjalankan pelaburan\Nprojek dengan Encik Yoon,
Dialog: 0,0:36:31.73,0:36:35.21,Lalai,,0,0,0,,tetapi Encik Baek berkata mereka harus\Ndapat ujian kesahan dahulu,
Dialog: 0,0:36:35.23,0:36:39.84, Lalai,,0,0,0,,jadi projek berisiko dibatalkan.
Dialog: 0,0:36:39.86,0:36:41.56, Lalai,,0,0,0,,Apa?!
Dialog: 0,0:36:41.90,0:36:43.92, Lalai,,0,0,0,,Kami berada pada masa yang sukar, Datuk.
Dialog: 0,0:36:43.95,0:36:46.09,Lalai,,0,0,0,,Bagaimana jika Encik Yoon berubah fikiran?
Dialog: 0,0:36:46.12,0:36:48.26,Lalai,,0,0,0,,Jadi? Perniagaan adalah tentang menjadi tabah.
Dialog: 0,0:36:48.28,0:36:49.80,Lalai,,0,0,0,,Anda tidak sepatutnya risau.
Dialog: 0,0:36:49.83,0:36:52.39,Lalai,,0,0,0,,Ayuh. Bukan kita yang melabur.
Dialog: 0,0:36:52.41,0:36:57.60, Lalai,,0,0,0,,Dia pelabur di sini,\Njadi kenapa kita sedang mengira?
Dialog: 0,0:36:57.63,0:36:59.23, Lalai,,0,0,0,,Saya sangat kecewa.
Dialog: 0,0:36:59.25,0:37:00.69, Lalai,,0,0,0,, Kita sepatutnya.
Dialog: 0,0:37:00.71,0:37:03.07, Lalai,,0,0,0,,Awak rasa duit dia percuma, bodoh?
Dialog: 0,0:37:03.09,0:37:06.82,Lalai,,0,0,0,,Hyun-woo berhati-hati dan teliti, jika ada,
Dialog: 0,0:37:06.84,0:37:08.50, Lalai,,0,0,0,,jadi lakukan apa yang dia katakan.
Dialog: 0,0:37:13.06,0:37:15.89,Lalai,,0,0,0,,Hyun-woo sangat menjengkelkan.
Dialog: 0,0:37:21.82,0:37:23.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pengerusi Hong.{\c}{\i0}
Dialog: 0,0:37:23.24,0:37:25.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Majlis biasiswa akan bermula tidak lama lagi.{\c}{\i0}
Dialog: 0,0:37:25.32,0:37:28.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Soo-cheol, bermain dengan rakan anda.{\c}{\i0}
Dialog: 0,0:37:29.66,0:37:31.19, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dengan cara ini.{\c}{\i0}
Dialog: 0,0:37:32.41,0:37:34.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tetapi mereka bukan kawan saya.{\c}{\i0}
Dialog: 0,0:37:53.85,0:37:57.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hei, berani kau baling\Na bola ke kepala abang?{\c}{\i0}
Dialog: 0,0:37:57.77,0:37:59.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia sudah pun bodoh.{\c}{\i0}
Dialog: 0,0:37:59.44,0:38:01.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika dia menjadi lebih bodoh?{\c}{\i0}
Dialog: 0,0:38:01.69,0:38:03.00, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Siapa nama anda?{\c}{\i0}
Dialog: 0,0:38:03.03,0:38:04.60, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hong Hae-in. Mengapa?{\c}{\i0}
Dialog: 0,0:38:08.49,0:38:10.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah urusannya?{\c}{\i0}
Dialog: 0,0:38:11.99,0:38:13.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berhenti menangis.{\c}{\i0}
Dialog: 0,0:38:14.16,0:38:15.95, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda bising sekali.{\c}{\i0}
Dialog: 0,0:38:26.17,0:38:27.71,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hei.{\c}{\i0}
Dialog: 0,0:38:28.30,0:38:29.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya?{\c}{\i0}
Dialog: 0,0:38:29.30,0:38:30.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda cucu pengerusi?{\c}{\i0}
Dialog: 0,0:38:30.76,0:38:32.50,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya.{\c}{\i0}
Dialog: 0,0:38:32.64,0:38:34.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dan adakah dia kakak kamu?{\c}{\i0}
Dialog: 0,0:38:34.22,0:38:36.09, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya.{\c}{\i0}
Dialog: 0,0:38:36.73,0:38:38.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda anak lelaki tunggal?{\c}{\i0}
Dialog: 0,0:38:38.60,0:38:40.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya pernah mempunyai seorang abang,{\c}{\i0}
Dialog: 0,0:38:40.56,0:38:42.31,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi tidak lagi.{\c}{\i0}
Dialog: 0,0:38:43.32,0:38:46.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya faham... Jadi awak satu-satunya anak lelaki.{\c}{\i0}
Dialog: 0,0:38:48.86,0:38:50.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tiup ke dalamnya.{\c}{\i0}
Dialog: 0,0:38:52.44,0:38:54.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jom kahwin nanti.{\c}{\i0}
Dialog: 0,0:38:54.41,0:38:56.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Tidak.\N- Mengapa tidak?{\c}{\i0}
Dialog: 0,0:38:56.20,0:38:58.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Awak kecik...!{\c}{\i0}
Dialog: 0,0:39:00.12,0:39:02.99, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Datuk!{\c}{\i0}\N- Datuk!
Dialog: 0,0:39:03.50,0:39:07.52,Lalai,,0,0,0,,Jangan dengar cakap dia sahaja. Dengarkan saya juga. saya...
Dialog: 0,0:39:07.55,0:39:11.03,Lalai,,0,0,0,,Saya berfikir panjang dan keras sebelum mengutarakan perkara ini,
Dialog: 0,0:39:11.05,0:39:13.50,Lalai,,0,0,0,,- jadi kenapa awak...?\N- Bodoh betul.
Dialog: 0,0:39:23.40,0:39:25.92,Lalai,,0,0,0,,By the way, bagaimana keadaan Geon-u...
Dialog: 0,0:39:25.94,0:39:27.85,Lalai,,0,0,0,,kacak sangat?
Dialog: 0,0:39:27.90,0:39:28.88, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:39:28.90,0:39:30.76, Lalai,,0,0,0,,Dia tidak mengejar anda.
Dialog: 0,0:39:30.78,0:39:33.48, Lalai,,0,0,0,,Apa yang anda maksudkan? Kami hampir kembar.
Dialog: 0,0:39:36.62,0:39:37.89,Lalai,,0,0,0,,Adakah dia mengambil ujian DNA?
Dialog: 0,0:39:37.91,0:39:39.77,Lalai,,0,0,0,,Sudah tentu, sebaik sahaja dia dilahirkan.
Dialog: 0,0:39:39.79,0:39:41.56, Lalai,,0,0,0,,Anda melihat hasilnya.
Dialog: 0,0:39:41.58,0:39:43.35, Lalai,,0,0,0,,Mereka 99.99% sepadan.
Dialog: 0,0:39:43.38,0:39:45.40,Lalai,,0,0,0,,Anda tidak nampak Da-hye di sini?
Dialog: 0,0:39:45.42,0:39:47.73,Lalai,,0,0,0,,Hei, ujian DNA adalah formaliti.
Dialog: 0,0:39:47.76,0:39:49.52, Lalai,,0,0,0,,Anda semua mengambil satu.
Dialog: 0,0:39:49.55,0:39:51.53,Lalai,,0,0,0,,Jangan kurang ajar dengan datuk.
Dialog: 0,0:39:51.55,0:39:55.88,Lalai,,0,0,0,,Saya hanya bergurau, memandangkan\NGeon-u sangat kacak dan bijak.
Dialog: 0,0:39:56.39,0:39:58.63, Lalai,,0,0,0,,Saya boleh bersabar dengan orang...
Dialog: 0,0:39:59.10,0:40:00.58,Lalai,,0,0,0,,mulut buruk ibu bapa saya,
Dialog: 0,0:40:00.60,0:40:03.89, Lalai,,0,0,0,,tetapi bukan isteri atau anak saya.
Dialog: 0,0:40:04.15,0:40:06.43,Lalai,,0,0,0,,Saya rasa saya tidak boleh makan.
Dialog: 0,0:40:06.52,0:40:08.43,Lalai,,0,0,0,,Jom, Sayang.
Dialog: 0,0:40:10.82,0:40:13.47,Lalai,,0,0,0,,Sungguh teruk anak lelaki.
Dialog: 0,0:40:13.49,0:40:16.90,Lalai,,0,0,0,,Ya, dia boleh bersabar dengan\Norang yang memburukkan ibu bapanya.
Dialog: 0,0:40:22.21,0:40:24.85,Lalai,,0,0,0,,Lihat keningnya.\NI mempunyai kening yang sama seperti bayi.
Dialog: 0,0:40:24.88,0:40:26.95, Lalai,,0,0,0,,Mereka menebal dengan masa,
Dialog: 0,0:40:27.17,0:40:28.61, Lalai,,0,0,0,,dan lihat hidungnya.
Dialog: 0,0:40:28.63,0:40:30.61, Lalai,,0,0,0,,Saya terkena hidung semasa bermain bola sepak,
Dialog: 0,0:40:30.63,0:40:31.98,Lalai,,0,0,0,,jadi ia agak rendah,
Dialog: 0,0:40:32.01,0:40:33.24, Lalai,,0,0,0,,tetapi saya mempunyai hidung yang sama.
Dialog: 0,0:40:33.26,0:40:34.49, Lalai,,0,0,0,,Jambatan hidung saya sangat tinggi.
Dialog: 0,0:40:34.51,0:40:36.96,Lalai,,0,0,0,,- Orang menyangka saya bercampur.\N- Saya faham.
Dialog: 0,0:40:38.10,0:40:41.54, Lalai,,0,0,0,,Rambut tebal dan jari kakinya...
Dialog: 0,0:40:41.56,0:40:43.16, Lalai,,0,0,0,,Saya berasa sedih dengan awak.
Dialog: 0,0:40:43.19,0:40:47.01,Lalai,,0,0,0,,Keluarga kita mesti kuat\Ngenes. Dia tidak menyerupai anda.
Dialog: 0,0:40:55.07,0:40:56.77,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:40:57.74,0:41:00.35,Lalai,,0,0,0,,- Kenapa?\N- Saya yang paling lemah dalam keluarga.
Dialog: 0,0:41:00.37,0:41:04.57,Lalai,,0,0,0,,Kakak saya bosan dengan saya, dan\Nantuk saya memarahi saya sepanjang masa.
Dialog: 0,0:41:05.08,0:41:07.66, Lalai,,0,0,0,,Itulah sebabnya anda dianiaya.
Dialog: 0,0:41:08.09,0:41:09.23, Lalai,,0,0,0,,Saya akan buat yang lebih baik,
Dialog: 0,0:41:09.25,0:41:12.46,Lalai,,0,0,0,,jadi tiada siapa yang berani menganiaya anda.
Dialog: 0,0:41:15.84,0:41:20.34, Lalai,,0,0,0,,Projek kompleks resort akan\Na terkena. Saya akan buat yang terbaik demi awak.
Dialog: 0,0:41:20.81,0:41:22.51, Lalai,,0,0,0,, Percayalah.
Dialog: 0,0:41:26.06,0:41:27.29,Lalai,,0,0,0,,Agak kurang masak.
Dialog: 0,0:41:27.31,0:41:30.50, Lalai,,0,0,0,,Ia akan lebih masak semasa kita makan.
Dialog: 0,0:41:30.52,0:41:33.81, Lalai,,0,0,0,,Helo, tuan. Bolehkah saya bertanya arah?
Dialog: 0,0:41:36.32,0:41:39.80, Lalai,,0,0,0,,Ya ampun, anda telah menemui lelaki yang betul.
Dialog: 0,0:41:39.83,0:41:43.51, Lalai,,0,0,0,,Saya tahu semua jalan berturap dan\Tidak berturap di sekitar sini.
Dialog: 0,0:41:43.54,0:41:45.47,Lalai,,0,0,0,,Saya tahu ke mana anjing pergi,
Dialog: 0,0:41:45.50,0:41:48.69, Lalai,,0,0,0,, dan juga tempat burung terbang. Saya tahu segala-galanya,
Dialog: 0,0:41:48.71,0:41:50.56,Lalai,,0,0,0,,- jadi tanya saya.\N- Okay.
Dialog: 0,0:41:50.59,0:41:52.31, Lalai,,0,0,0,,Ini adalah tempat yang terdapat di YouTube.
Dialog: 0,0:41:52.34,0:41:54.79,Lalai,,0,0,0,,- Adakah anda tahu di mana ia?\N- YouTube?
Dialog: 0,0:41:55.38,0:41:58.21, Lalai,,0,0,0,,Adakah kampung kita di YouTube?
Dialog: 0,0:42:00.30,0:42:01.95, Lalai,,0,0,0,,Kawasan yang manakah itu?
Dialog: 0,0:42:01.97,0:42:03.88, Lalai,,0,0,0,,- Sini.\N- Tunggu.
Dialog: 0,0:42:09.65,0:42:11.08,Lalai,,0,0,0,,{\i1}Mestilah ini.{\i0}
Dialog: 0,0:42:11.11,0:42:13.04,Lalai,,0,0,0,,Bukankah Hong Hae-in duduk di sini?
Dialog: 0,0:42:13.07,0:42:14.84, Lalai,,0,0,0,,Hong Hae-in.
Dialog: 0,0:42:14.86,0:42:16.39,Lalai,,0,0,0,,Anda kelihatan cantik.
Dialog: 0,0:42:18.45,0:42:21.05, Lalai,,0,0,0,,Apa yang mereka semua buat di sana?
Dialog: 0,0:42:21.08,0:42:24.43,Lalai,,0,0,0,,Di situlah Hae-in duduk.\NA kerusi waris konglomerat,
Dialog: 0,0:42:24.45,0:42:27.14,Lalai,,0,0,0,,dan dinding itulah dia bersandar.
Dialog: 0,0:42:27.16,0:42:29.68,Lalai,,0,0,0,,Ia seperti bergambar di hadapan Tembok Berlin.
Dialog: 0,0:42:29.71,0:42:31.06, Lalai,,0,0,0,,Sesuatu seperti itu.
Dialog: 0,0:42:31.09,0:42:32.95, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:42:33.17,0:42:36.79,Lalai,,0,0,0,,Mereka meniru apa yang\NHae-in lakukan pada masa lapangnya.
Dialog: 0,0:42:39.34,0:42:40.32,Lalai,,0,0,0,,Bukankah itu anjing?
Dialog: 0,0:42:40.34,0:42:42.95,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Hae-in, sila katakan sesuatu.{\c}{\i0}
Dialog: 0,0:42:42.97,0:42:46.13, Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Helo. Saya Hong Hae-in daripada Kumpulan Queens.{\c}{\i0}
Dialog: 0,0:42:47.06,0:42:48.62,Lalai,,0,0,0,,Dia adalah pemimpin terbaik.
Dialog: 0,0:42:48.64,0:42:50.06,Lalai,,0,0,0,,Bukankah ini anjing?
Dialog: 0,0:42:50.09,0:42:51.12, Lalai,,0,0,0,,Ya, betul.
Dialog: 0,0:42:51.15,0:42:52.42,Lalai,,0,0,0,,Kami betul.
Dialog: 0,0:42:52.44,0:42:53.43,Lalai,,0,0,0,,Senyum.
Dialog: 0,0:42:53.46,0:42:56.28,Lalai,,0,0,0,,{\i1}Ayah, Yongdu-ri telah menjadi terkenal.{\i0}
Dialog: 0,0:42:57.95,0:42:59.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Hong Hae-in melawat{\c}{\i0}
Dialog: 0,0:43:06.41,0:43:08.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Hong Hae-in berada di sini{\c}{\i0}
Dialog: 0,0:43:08.08,0:43:10.57, Lalai,,0,0,0,,Hae-in ada di sini.
Dialog: 0,0:43:10.83,0:43:12.60, Lalai,,0,0,0,,Mengapa mereka tidak membenarkan kami masuk?
Dialog: 0,0:43:12.63,0:43:14.65,Lalai,,0,0,0,,Hae-in mengambil satu gigitan itik mereka.
Dialog: 0,0:43:14.67,0:43:17.19,Default,,0,0,0,,Sekarang orang beratur untuk makan di sini...
Dialog: 0,0:43:17.21,0:43:21.11, Lalai,,0,0,0,,pada awal pagi, tetapi masih tidak boleh masuk.
Dialog: 0,0:43:21.14,0:43:23.91, Lalai,,0,0,0,,Kedua-dua restoran ketam perap dan\Nfrozen-perut babi...
Dialog: 0,0:43:23.93,0:43:26.28,Lalai,,0,0,0,,telah ditempah sepenuhnya dan dihantar ke mana-mana.
Dialog: 0,0:43:26.31,0:43:27.78, Lalai,,0,0,0,,Sangat gila.
Dialog: 0,0:43:27.81,0:43:29.33, Lalai,,0,0,0,,Mengapa mereka melakukan ini?
Dialog: 0,0:43:29.35,0:43:31.53,Lalai,,0,0,0,,Nah... Mereka mungkin tidak dapat\Nberpakaian seperti orang kaya,
Dialog: 0,0:43:31.55,0:43:33.75, Lalai,,0,0,0,, jadi mereka mahu sekurang-kurangnya makan seperti mereka.
Dialog: 0,0:43:33.77,0:43:36.43, Lalai,,0,0,0,,Saya rasa ia adalah seperti itu.
Dialog: 0,0:43:37.07,0:43:38.30,Lalai,,0,0,0,,Hae-in adalah yang terbaik.
Dialog: 0,0:43:38.32,0:43:44.76,Lalai,,0,0,0,,Saya berusaha selama beberapa dekad untuk membuat Yongdu-ri dikenali,
Dialog: 0,0:43:44.78,0:43:47.93,Lalai,,0,0,0,,tetapi dia mencapainya dalam masa kurang dari sehari.
Dialog: 0,0:43:47.95,0:43:51.98,Lalai,,0,0,0,,Adalah selamat untuk mengatakan bahawa anda mempunyai\N kelebihan dalam pilihan raya.
Dialog: 0,0:43:52.00,0:43:55.83,Lalai,,0,0,0,,Menantu awak sedang membantu ekonomi kita.
Dialog: 0,0:43:56.75,0:43:58.57,Lalai,,0,0,0,,Apa yang Seok-hun buat?
Dialog: 0,0:43:58.59,0:44:00.82,Lalai,,0,0,0,,Saya pasti dia rasa tewas.
Dialog: 0,0:44:00.84,0:44:05.46,Lalai,,0,0,0,,Mungkin dia berharap Hae-in akan\Nmengunjungi restoran ibunya.
Dialog: 0,0:44:10.89,0:44:12.59,Lalai,,0,0,0,,Saya meraguinya.
Dialog: 0,0:44:13.56,0:44:16.21,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kunyah perlahan-lahan, atau anda akan sakit perut.{\c}{\i0}
Dialog: 0,0:44:16.23,0:44:18.98,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Epal adalah yang terbaik untuk senak.{\c}{\i0}
Dialog: 0,0:44:20.03,0:44:21.90,Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:44:23.70,0:44:26.05, Lalai,,0,0,0,,Kenapa dia makan itu?
Dialog: 0,0:44:26.08,0:44:29.03, Lalai,,0,0,0,,Dia sepatutnya mempunyai pear sebaliknya,
Dialog: 0,0:44:30.12,0:44:32.11, Lalai,,0,0,0,,jadi kenapa epal?
Dialog: 0,0:44:32.71,0:44:34.73,Lalai,,0,0,0,,Seok-hun, bajingan licik itu.
Dialog: 0,0:44:34.75,0:44:38.48,Lalai,,0,0,0,,Yongdu-ri telah menjadi\Nrumah kepada epal kepada orang luar,
Dialog: 0,0:44:38.50,0:44:41.58,Lalai,,0,0,0,,hanya kerana Hae-in menggigit.
Dialog: 0,0:44:41.76,0:44:44.07, Lalai,,0,0,0,,Saya rasa sudah "permainan tamat".
Dialog: 0,0:44:44.09,0:44:46.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Yongdu-ri Sama dengan Epal Sedap{\c}{\i0}
Dialog: 0,0:44:46.55,0:44:48.20,Lalai,,0,0,0,,Jom cepat.
Dialog: 0,0:44:48.22,0:44:50.92, Lalai,,0,0,0,,Anda akhirnya sibuk sekarang.
Dialog: 0,0:44:51.23,0:44:54.05, Lalai,,0,0,0,,Hari yang hebat.
Dialog: 0,0:44:56.15,0:44:58.77, Lalai,,0,0,0,,Ambil keseluruhan kotak.
Dialog: 0,0:45:01.28,0:45:02.80, Lalai,,0,0,0,,- Video sedang sohor kini.\N- Ya.
Dialog: 0,0:45:02.82,0:45:05.40, Lalai,,0,0,0,,Ia mencapai lebih 500,000 tontonan.
Dialog: 0,0:45:05.82,0:45:08.76,Lalai,,0,0,0,,Mi-seon, saya menjadi peminat\Nof Cik Hong selepas lawatannya.
Dialog: 0,0:45:08.78,0:45:11.22, Lalai,,0,0,0,,Bagaimana ada lingkaran cahaya di sekelilingnya...
Dialog: 0,0:45:11.25,0:45:14.18,Lalai,,0,0,0,,apabila dia memperkenalkan dirinya\Nas menantu keluarga?
Dialog: 0,0:45:14.21,0:45:17.48, Lalai,,0,0,0,,Terdapat lori udang galah\Ndi belakangnya. Mungkin itu sahaja.
Dialog: 0,0:45:17.50,0:45:20.40,Lalai,,0,0,0,,Di sini. Semak ini.
Dialog: 0,0:45:20.42,0:45:23.02,Lalai,,0,0,0,,Seseorang dari Jeju memesan ketam perap kami.
Dialog: 0,0:45:23.05,0:45:27.42,Lalai,,0,0,0,,Alhamdulillah, ketam saya akan dapat\Nuntuk melawat Jeju sebelum saya pergi.
Dialog: 0,0:45:29.72,0:45:31.71,Lalai,,0,0,0,,- Bertuahlah awak.\N- Betul.
Dialog: 0,0:45:34.23,0:45:35.37,Lalai,,0,0,0,,Tahan.
Dialog: 0,0:45:35.39,0:45:37.16,Lalai,,0,0,0,,- Apa yang salah?\N- Apa yang anda maksudkan?
Dialog: 0,0:45:37.19,0:45:38.87,Lalai,,0,0,0,,Anda kelihatan seperti seorang wanita kelaparan...
Dialog: 0,0:45:38.90,0:45:42.93,Lalai,,0,0,0,,siapa yang kecewa kerana\Nmenemui tiada nasi dalam periuk.
Dialog: 0,0:45:44.36,0:45:47.59,Lalai,,0,0,0,,Seok-hun telah mempromosikan epalnya,
Dialog: 0,0:45:47.61,0:45:49.92, Lalai,,0,0,0,,jadi bagaimana anda boleh memuat naik\Nvideo Hae-in makan satu?
Dialog: 0,0:45:49.94,0:45:51.55,Lalai,,0,0,0,,- Adakah anda?\N- Adakah saya?
Dialog: 0,0:45:51.58,0:45:53.26, Lalai,,0,0,0,,Maaf, saya akan mengeditnya.
Dialog: 0,0:45:53.29,0:45:55.31, Lalai,,0,0,0,,Lupakan. Lebih 500,000 orang menontonnya.
Dialog: 0,0:45:55.33,0:45:57.12,Lalai,,0,0,0,,Sudah terlambat sekarang!
Dialog: 0,0:45:57.25,0:45:59.35,Lalai,,0,0,0,,Kalau begitu mari ajak Hae-in melawat semula.
Dialog: 0,0:45:59.38,0:46:00.42,Lalai,,0,0,0,,- Ya.\N- Dia sepatutnya datang.
Dialog: 0,0:46:00.44,0:46:02.98, Lalai,,0,0,0,,Dia boleh membuat persembahan makan dengan buah pear ayah kamu,
Dialog: 0,0:46:03.01,0:46:05.18, Lalai,,0,0,0,,dan tolak ke Laluan Hong Hae-in.
Dialog: 0,0:46:05.20,0:46:06.19, Lalai,,0,0,0,, Laluan apa?
Dialog: 0,0:46:06.22,0:46:08.36,Lalai,,0,0,0,,Persatuan wanita memulakan projek baharu.
Dialog: 0,0:46:08.39,0:46:10.20,Lalai,,0,0,0,,Sejak kampung kita sudah terkenal,
Dialog: 0,0:46:10.22,0:46:14.33, Lalai,,0,0,0,,kami akan menghiasi pintu masuk\Nand memanggilnya "Laluan Hong Hae-in."
Dialog: 0,0:46:14.35,0:46:16.66, Lalai,,0,0,0,,- Betul.\N- Kami akan mendapat hak potret.
Dialog: 0,0:46:16.69,0:46:19.29,Lalai,,0,0,0,,Kemudian kami akan memaparkan foto Hyun-woo dan dia.
Dialog: 0,0:46:19.31,0:46:22.08, Lalai,,0,0,0,,Juga dikenali sebagai "Yongdu-ri Queen's Path."
Dialog: 0,0:46:22.11,0:46:24.38, Lalai,,0,0,0,,"Berjalan di jalan ini,\Nand cintamu akan menjadi kenyataan."
Dialog: 0,0:46:24.40,0:46:26.06,Lalai,,0,0,0,,Mari kita tambah itu juga.
Dialog: 0,0:46:29.82,0:46:31.47,Lalai,,0,0,0,,- Keluar!\N- Baik!
Dialog: 0,0:46:31.49,0:46:33.51, Lalai,,0,0,0,,Keluar dan jangan melawat dalam masa terdekat!
Dialog: 0,0:46:33.54,0:46:35.28,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:46:35.45,0:46:37.16, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:46:37.33,0:46:38.68,Lalai,,0,0,0,,Apa?
Dialog: 0,0:46:38.71,0:46:40.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Salun Rambut Ratu{\c}{\i0}
Dialog: 0,0:46:54.85,0:46:56.62, Lalai,,0,0,0,,Terlalu lewat. Dia dah kahwin.
Dialog: 0,0:46:56.64,0:46:59.54, Lalai,,0,0,0,,Anda sepatutnya datang lima tahun lebih awal.
Dialog: 0,0:46:59.56,0:47:01.85, Lalai,,0,0,0,, Pergi sahaja, boleh?
Dialog: 0,0:47:14.45,0:47:18.66,Lalai,,0,0,0,,Orang di sini mudah bertanya khabar jika anda menutup mata.
Dialog: 0,0:47:19.71,0:47:21.70, Lalai,,0,0,0,,Ia budaya yang bagus.
Dialog: 0,0:47:22.75,0:47:23.94,Lalai,,0,0,0,,Anda pasti gembira...
Dialog: 0,0:47:23.96,0:47:26.23,Lalai,,0,0,0,,bahawa anda popular dengan semua wanita,
Dialog: 0,0:47:26.26,0:47:29.23,Lalai,,0,0,0,,termasuk anak perempuan pengetua Yongdu-ri.
Dialog: 0,0:47:29.26,0:47:31.38,Lalai,,0,0,0,,Anak perempuan pengetua?
Dialog: 0,0:47:32.59,0:47:34.32,Lalai,,0,0,0,,So-yeong?
Dialog: 0,0:47:35.71,0:47:38.22,Lalai,,0,0,0,,Adakah itu namanya?
Dialog: 0,0:47:38.52,0:47:41.14,Lalai,,0,0,0,,Saya dengar dia baik dan cantik.
Dialog: 0,0:47:41.69,0:47:43.16,Lalai,,0,0,0,,Nah...
Dialog: 0,0:47:43.19,0:47:46.10,Lalai,,0,0,0,,Dia comel dan berambut pendek.
Dialog: 0,0:47:46.36,0:47:49.06, Lalai,,0,0,0,,Ya, dia lakukan.
Dialog: 0,0:47:51.15,0:47:52.38,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:47:52.41,0:47:54.76,Lalai,,0,0,0,,Adakah dia cinta pertama awak yang Mi-seon sebutkan?
Dialog: 0,0:47:54.78,0:47:57.32,Lalai,,0,0,0,,Dia bukan cinta pertama saya.
Dialog: 0,0:48:01.46,0:48:03.69,Lalai,,0,0,0,,Jika seluruh keluarga anda mengenalinya,
Dialog: 0,0:48:03.71,0:48:05.52,Lalai,,0,0,0,, adakah itu bermakna anda sudah bertunang?
Dialog: 0,0:48:05.54,0:48:06.73,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:48:06.75,0:48:08.48, Lalai,,0,0,0,,Itu mengarut.
Dialog: 0,0:48:08.51,0:48:10.07, Lalai,,0,0,0,,Kami tidak pernah makan tengah hari.
Dialog: 0,0:48:10.09,0:48:12.78,Lalai,,0,0,0,,Kami tidak pernah melakukan apa-apa,\Njadi bagaimana dia cinta pertama saya?
Dialog: 0,0:48:12.80,0:48:15.25,Lalai,,0,0,0,,Anda tidak perlu berbuat apa-apa.
Dialog: 0,0:48:15.39,0:48:19.37,Lalai,,0,0,0,,Anda gembira melihatnya dari jauh.\NAnda tidak boleh berhenti memikirkannya.
Dialog: 0,0:48:19.39,0:48:22.20,Lalai,,0,0,0,,Anda mengambil lencongan hanya untuk melihat mereka sekali lagi.
Dialog: 0,0:48:22.23,0:48:26.06,Lalai,,0,0,0,,Jika anda melakukannya buat kali pertama,\Nmaka itulah cinta pertama anda.
Dialog: 0,0:48:30.99,0:48:33.69, Lalai,,0,0,0,,Itu agak spesifik.
Dialog: 0,0:48:34.45,0:48:36.77, Lalai,,0,0,0,,Bercakap daripada pengalaman?
Dialog: 0,0:48:36.91,0:48:39.32, Lalai,,0,0,0,,Anda boleh katakan begitu.
Dialog: 0,0:48:42.33,0:48:44.10,Lalai,,0,0,0,,Anda gembira melihat dia dari jauh.
Dialog: 0,0:48:44.12,0:48:45.77,Lalai,,0,0,0,,Anda tidak boleh berhenti memikirkan dia,
Dialog: 0,0:48:45.79,0:48:48.58, Lalai,,0,0,0,, dan anda juga mengambil jalan memutar?
Dialog: 0,0:48:49.38,0:48:51.08,Lalai,,0,0,0,,Betul.
Dialog: 0,0:48:54.72,0:48:56.25,Lalai,,0,0,0,,Siapa dia?
Dialog: 0,0:48:56.64,0:49:00.92,Lalai,,0,0,0,,Setiap gadis jatuh cinta dengan seorang sekurang-kurangnya sekali.
Dialog: 0,0:49:00.97,0:49:02.45, Lalai,,0,0,0,,Seorang lelaki di dalam bas.
Dialog: 0,0:49:02.48,0:49:04.33, Lalai,,0,0,0,,Seorang lelaki di dalam bas?
Dialog: 0,0:49:04.35,0:49:06.68,Lalai,,0,0,0,,Adakah anda menaiki bas ke sekolah?
Dialog: 0,0:49:07.23,0:49:09.06, Lalai,,0,0,0,,Itu tidak boleh.
Dialog: 0,0:49:31.88,0:49:33.15, Lalai,,0,0,0,,Siapa mereka?
Dialog: 0,0:49:33.17,0:49:36.86, Lalai,,0,0,0,,Kamera CCTV telah rosak\N kebelakangan ini, dan mereka adalah pembaikan.
Dialog: 0,0:49:36.89,0:49:39.96, Lalai,,0,0,0,,Ia akan mengambil masa kira-kira sejam, tuan.
Dialog: 0,0:49:59.03,0:50:00.73, Lalai,,0,0,0,,Semuanya sudah selesai.
Dialog: 0,0:50:12.25,0:50:13.61,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Perceraian{\c}{\i0}
Dialog: 0,0:50:13.63,0:50:17.58,Lalai,,0,0,0,,Ya, saya pasti ia sukar untuk anda\Tidak juga. Awak tinggal cukup lama.
Dialog: 0,0:50:37.65,0:50:39.38, Lalai,,0,0,0,,Adakah anda menjumpainya?
Dialog: 0,0:50:39.41,0:50:40.88, Lalai,,0,0,0,,No.
Dialog: 0,0:50:40.91,0:50:44.07, Lalai,,0,0,0,,- Adakah anda pasti ini dia?\N- Saya rasa begitu.
Dialog: 0,0:50:45.41,0:50:49.07, Lalai,,0,0,0,,Itu tiga tahun lalu.\NMungkin mereka telah membuangnya.
Dialog: 0,0:50:51.25,0:50:52.79, Lalai,,0,0,0,,Adakah anda fikir begitu?
Dialog: 0,0:51:22.57,0:51:24.28, Lalai,,0,0,0,,Ia bagus.
Dialog: 0,0:51:45.39,0:51:48.01, Lalai,,0,0,0,,Adakah mereka mempunyai banyak masa?
Dialog: 0,0:51:50.69,0:51:54.04, Lalai,,0,0,0,,Orang-orang itu tidak melakukan apa-apa di hadapan air pancut itu.
Dialog: 0,0:51:54.06,0:51:55.83, Lalai,,0,0,0,,Mereka hanya membuang masa berjemur.
Dialog: 0,0:51:55.86,0:51:59.13, Lalai,,0,0,0,,Mereka hanya memberi makan burung merpati.
Dialog: 0,0:51:59.15,0:52:02.67, Lalai,,0,0,0,,Mereka sedang berehat sambil melakukan perkara yang tidak bermakna.
Dialog: 0,0:52:02.70,0:52:06.51,Lalai,,0,0,0,,Tepat sekali. Mereka membuang\Nmasa melakukan perkara yang tidak bermakna.
Dialog: 0,0:52:06.54,0:52:09.18, Lalai,,0,0,0,,Adakah mereka membual tentang masa yang mereka ada?
Dialog: 0,0:52:09.20,0:52:11.32, Lalai,,0,0,0,,Betapa boros.
Dialog: 0,0:52:19.76,0:52:22.12,Lalai,,0,0,0,,Tuah untuk dijual. Beli nasib.
Dialog: 0,0:52:22.80,0:52:26.25, Lalai,,0,0,0,,Dapatkan nasib di tangan anda sendiri. Nasib untuk dijual.
Dialog: 0,0:52:26.43,0:52:29.51,Lalai,,0,0,0,,Beli nasib. Ayuh dapatkan nasib anda.
Dialog: 0,0:52:32.60,0:52:35.62, Lalai,,0,0,0,,Cuba menjana wang\Bukan semanggi empat daun biasa?
Dialog: 0,0:52:35.65,0:52:37.40, Lalai,,0,0,0,,Sungguh penipuan.
Dialog: 0,0:52:37.42,0:52:40.11, Lalai,,0,0,0,,Si bodoh jenis apa yang akan membeli barang sedemikian?
Dialog: 0,0:53:05.84,0:53:07.78, Lalai,,0,0,0,,Adakah anda mendapat satu?
Dialog: 0,0:53:07.80,0:53:10.63, Lalai,,0,0,0,,Ya, hanya untuk keseronokan.
Dialog: 0,0:53:16.56,0:53:19.27, Lalai,,0,0,0,,Itu mahal untuk sesetengah daun.
Dialog: 0,0:53:51.77,0:53:53.88, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:53:54.02,0:53:57.47, Lalai,,0,0,0,,Saya agak terpegun sekarang.
Dialog: 0,0:53:58.10,0:53:59.75, Lalai,,0,0,0,,Kenapa? apa salahnya
Dialog: 0,0:53:59.77,0:54:02.27,Lalai,,0,0,0,,- Berat saya...\N- Berat awak?
Dialog: 0,0:54:02.57,0:54:04.30, Lalai,,0,0,0,,Naik sebanyak 6 paun.
Dialog: 0,0:54:04.32,0:54:07.65,Lalai,,0,0,0,,Saya telah menambah 6 paun sejak\N melawat hospital saya di Korea.
Dialog: 0,0:54:07.70,0:54:09.87, Lalai,,0,0,0,,- Apa?\N- Bukankah anda biasanya menurunkan berat badan apabila sakit?
Dialog: 0,0:54:09.90,0:54:12.43, Lalai,,0,0,0,,Adakah itu penting sekarang?
Dialog: 0,0:54:12.45,0:54:17.24,Lalai,,0,0,0,,Apa yang anda tahu? Tiada siapa yang pernah memberitahu\Nyou bahawa anda mempunyai baki tiga bulan untuk hidup.
Dialog: 0,0:54:21.63,0:54:25.36, Lalai,,0,0,0,,Saya cantik sepanjang hidup saya,\Njadi bagaimana jika saya menjadi hodoh?
Dialog: 0,0:54:25.38,0:54:28.00,Lalai,,0,0,0,,Anda hanya akan ingat wajah hodoh saya.
Dialog: 0,0:54:29.09,0:54:30.80, Lalai,,0,0,0,,Saya tidak akan membenarkan itu.
Dialog: 0,0:54:31.47,0:54:33.13,Lalai,,0,0,0,,Nah...
Dialog: 0,0:54:33.52,0:54:37.59,Lalai,,0,0,0,,Kau takkan percaya kalau aku cakap kau cantik...
Dialog: 0,0:54:38.27,0:54:40.51, Lalai,,0,0,0,,tidak kira berat badan anda, boleh?
Dialog: 0,0:54:41.82,0:54:42.96,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:54:42.98,0:54:45.27,Lalai,,0,0,0,,Saya telah menambah berat badan.
Dialog: 0,0:54:45.94,0:54:48.44, Lalai,,0,0,0,,- Bukan itu yang saya maksudkan.\N- Tonton sahaja.
Dialog: 0,0:54:48.86,0:54:52.07, Lalai,,0,0,0,,Saya akan menjadi cantik sehingga saya mati.
Dialog: 0,0:55:01.46,0:55:03.16, Lalai,,0,0,0,,Saya akan kembali.
Dialog: 0,0:57:56.43,0:57:57.96,Lalai,,0,0,0,,Saya lapar.
Dialog: 0,0:58:25.91,0:58:27.81, Lalai,,0,0,0,,Berapa lama anda mencari saya?
Dialog: 0,0:58:27.83,0:58:29.91, Lalai,,0,0,0,,Selama kira-kira sejam.
Dialog: 0,0:58:31.38,0:58:33.79, Lalai,,0,0,0,,Masa semakin pudar.
Dialog: 0,0:58:33.88,0:58:36.08, Lalai,,0,0,0,,Saya tidak mempunyai banyak masa seperti sekarang.
Dialog: 0,0:58:37.72,0:58:40.00, Lalai,,0,0,0,,Anda tidak ingat lagi?
Dialog: 0,0:58:41.01,0:58:42.55, Lalai,,0,0,0,,Tidak, saya lakukan.
Dialog: 0,0:58:43.97,0:58:46.51,Lalai,,0,0,0,,- Saya baru nampak seseorang.\N- Siapa?
Dialog: 0,0:58:50.31,0:58:52.22,Lalai,,0,0,0,,{\i1}Adik saya.{\i0}
Dialog: 0,0:59:22.18,0:59:24.26,Lalai,,0,0,0,,{\i1}Semasa saya berumur sembilan tahun,{\i0}
Dialog: 0,0:59:24.31,0:59:27.33, Lalai,,0,0,0,,{\i1}kami menaiki bot\Nsemasa percutian musim panas kami.{\i0}
Dialog: 0,0:59:27.35,0:59:29.84,Lalai,,0,0,0,,{\i1}Kami mengalami kemalangan misteri.{\i0}
Dialog: 0,0:59:48.66,0:59:50.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Ada!\N- Hae-in!{\c}{\i0}
Dialog: 0,0:59:50.21,0:59:52.35, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in! Kebaikan!{\c}{\i0}
Dialog: 0,0:59:52.38,0:59:55.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Aduh, Hae-in!{\c}{\i0}
Dialog: 0,0:59:55.88,0:59:57.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey?{\c}{\i0}
Dialog: 0,0:59:57.80,0:59:59.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Adakah kamu sihat?\N- Ibu, mana Su-wan?{\c}{\i0}
Dialog: 0,0:59:59.80,1:00:02.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia menyelamatkan saya.{\c}{\i0}
Dialog: 0,1:00:03.01,1:00:04.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan?{\c}{\i0}
Dialog: 0,1:00:05.93,1:00:08.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia cuma...{\c}{\i0}
Dialog: 0,1:00:10.27,1:00:11.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,1:00:11.85,1:00:13.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,1:00:14.15,1:00:15.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,1:00:15.57,1:00:18.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tolong selamatkan anak saya!{\c}{\i0}
Dialog: 0,1:00:18.44,1:00:20.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Su-wan!\N- Satu, dua, tiga, empat.{\c}{\i0}
Dialog: 0,1:00:20.24,1:00:22.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Lima, enam, tujuh, lapan, sembilan...\N- Su-wan!{\c}{\i0}
Dialog: 0,1:00:22.86,1:00:24.69,Lalai,,0,0,0,,{\i1}Begitulah...{\i0}
Dialog: 0,1:00:25.41,1:00:27.53,Lalai,,0,0,0,,{\i1}dia meninggal dunia.{\i0}
Dialog: 0,1:00:28.33,1:00:30.81,Lalai,,0,0,0,,{\i1}Selepas kehilangan anaknya,{\i0}
Dialog: 0,1:00:30.83,1:00:32.89,Lalai,,0,0,0,,{\i1}ibu saya tidak dapat...{\i0}
Dialog: 0,1:00:32.92,1:00:35.49,Lalai,,0,0,0,,{\i1}makan, tidur atau maafkan saya...{\i0}
Dialog: 0,1:00:35.84,1:00:38.16,Lalai,,0,0,0,,{\i1}untuk masa yang sangat lama,{\i0}
Dialog: 0,1:00:39.01,1:00:40.52,Lalai,,0,0,0,,{\i1}dan saya berasa teruk...{\i0}
Dialog: 0,1:00:40.55,1:00:42.42,Lalai,,0,0,0,,{\i1}untuk Su-wan.{\i0}
Dialog: 0,1:00:43.59,1:00:45.50,Lalai,,0,0,0,,{\i1}Itu bukan salah awak.{\i0}
Dialog: 0,1:00:52.02,1:00:53.55,Lalai,,0,0,0,,Saya tahu,
Dialog: 0,1:00:53.90,1:00:56.39,Lalai,,0,0,0,,tetapi saya tidak dapat menghilangkan rasa bersalah,
Dialog: 0,1:00:57.94,1:01:00.06,Lalai,,0,0,0,,kerana rasanya...
Dialog: 0,1:01:00.44,1:01:02.56,Lalai,,0,0,0,,Saya telah mencuri nyawanya.
Dialog: 0,1:01:06.99,1:01:08.80,Lalai,,0,0,0,,Saya mendengar ini di suatu tempat.
Dialog: 0,1:01:08.83,1:01:10.93,Lalai,,0,0,0,,Apabila anda hampir mati,
Dialog: 0,1:01:10.95,1:01:13.91,Lalai,,0,0,0,,orang yang paling menyayangi\Nyou menjemput anda...
Dialog: 0,1:01:14.25,1:01:16.24,Lalai,,0,0,0,,dalam bentuk malaikat.
Dialog: 0,1:01:16.79,1:01:18.33,Lalai,,0,0,0,,Su-wan...
Dialog: 0,1:01:19.05,1:01:21.33,Lalai,,0,0,0,,yang mengorbankan nyawanya untuk saya...
Dialog: 0,1:01:27.39,1:01:29.30,Lalai,,0,0,0,,Mungkin dia datang...
Dialog: 0,1:01:30.06,1:01:32.09,Lalai,,0,0,0,,kerana sudah tiba masanya.
Dialog: 0,1:01:40.02,1:01:45.15,Lalai,,0,0,0,,Delirium ialah salah satu daripada banyak\N kesan sampingan suntikan anda.
Dialog: 0,1:01:45.45,1:01:48.23,Lalai,,0,0,0,,Itu halusinasi. Ia bukan malaikat.
Dialog: 0,1:01:49.87,1:01:51.40,Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,1:01:52.62,1:01:55.07,Lalai,,0,0,0,,Ia sebahagian daripada rawatan.
Dialog: 0,1:02:08.18,1:02:10.25,Lalai,,0,0,0,,Bukan mudah...
Dialog: 0,1:02:10.43,1:02:12.32,Lalai,,0,0,0,,untuk bertahan dari penyakit,
Dialog: 0,1:02:12.35,1:02:14.05,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:02:15.56,1:02:18.14,Lalai,,0,0,0,,anda mesti menempuhnya, Hae-in.
Dialog: 0,1:02:23.11,1:02:24.73,Lalai,,0,0,0,,Anda betul,
Dialog: 0,1:02:24.86,1:02:26.56,Lalai,,0,0,0,,dan saya akan,
Dialog: 0,1:02:27.28,1:02:28.98,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:02:29.45,1:02:32.61,Lalai,,0,0,0,,katakan banyak masa berlalu,
Dialog: 0,1:02:33.08,1:02:36.07,Lalai,,0,0,0,,dan anda mati.
Dialog: 0,1:02:38.37,1:02:41.49,Lalai,,0,0,0,,Kemudian saya akan menjadi malaikat dan menjemput awak.
Dialog: 0,1:02:49.64,1:02:50.74,Lalai,,0,0,0,,Jika saya muncul,
Dialog: 0,1:02:50.76,1:02:53.05,Lalai,,0,0,0,,ia akan menjadi kurang menakutkan untuk anda.
Dialog: 0,1:02:59.10,1:03:00.64,Lalai,,0,0,0,,Adakah anda pasti?
Dialog: 0,1:03:01.41,1:03:02.50,Lalai,,0,0,0,,Itu akan menjadi kurang menakutkan?
Dialog: 0,1:03:02.52,1:03:06.31,Lalai,,0,0,0,,Sudah tentu. Saya akan menjadi malaikat yang paling cantik.
Dialog: 0,1:03:16.16,1:03:17.70,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:03:18.87,1:03:20.41,Lalai,,0,0,0,,Okey.
Dialog: 0,1:03:20.67,1:03:22.33,Lalai,,0,0,0,,Anda lakukan itu.
Dialog: 0,1:03:26.05,1:03:27.75,Lalai,,0,0,0,,Tetapi buat masa ini,
Dialog: 0,1:03:29.13,1:03:30.92,Lalai,,0,0,0,,mari kita gali.
Dialog: 0,1:03:37.77,1:03:39.47,Lalai,,0,0,0,,Apa?
Dialog: 0,1:03:44.15,1:03:45.93,Lalai,,0,0,0,,Jom makan...
Dialog: 0,1:03:46.44,1:03:48.14,Lalai,,0,0,0,,dan kekal kuat.
Dialog: 0,1:03:58.96,1:04:00.12,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Juseong Tech{\c}{\i0}
Dialog: 0,1:04:10.84,1:04:15.11,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Juseong Tech 24{\c}{\i0}
Dialog: 0,1:04:15.14,1:04:18.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ditutup{\c}{\i0}
Dialog: 0,1:04:18.22,1:04:20.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pemulihan Data\NJuseong Tech 24{\c}{\i0}
Dialog: 0,1:04:22.10,1:04:24.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kami Telah Tutup Atas Sebab Peribadi{\c}{\i0}
Dialog: 0,1:04:24.40,1:04:26.97,Lalai,,0,0,0,,Ya. Itu sempurna.
Dialog: 0,1:04:28.28,1:04:30.96, Lalai,,0,0,0,,Ini barat laut.
Dialog: 0,1:04:30.99,1:04:34.84,Lalai,,0,0,0,,Inilah arah yang bertanggung jawab untuk wang, kejayaan dan nasib.
Dialog: 0,1:04:34.87,1:04:37.72,Lalai,,0,0,0,,Senang sekali anda memasang\Nan melukis yang berdaya usaha...
Dialog: 0,1:04:37.74,1:04:38.76,Lalai,,0,0,0,,seperti ini di sini.
Dialog: 0,1:04:38.79,1:04:42.03,Lalai,,0,0,0,,Ia akhirnya menemui pemiliknya.\NIIa kelihatan lebih baik di sini.
Dialog: 0,1:04:42.87,1:04:45.48,Lalai,,0,0,0,,Anda telah memberikan saya hadiah yang begitu besar.
Dialog: 0,1:04:45.50,1:04:47.95,Lalai,,0,0,0,,Bagaimana saya boleh membayar balik kepada anda?
Dialog: 0,1:04:48.67,1:04:49.65,Lalai,,0,0,0,,Tidak perlu.
Dialog: 0,1:04:49.67,1:04:52.83,Lalai,,0,0,0,,Saya hanya memberikannya kepada anda kerana menghormati.
Dialog: 0,1:04:53.05,1:04:54.32,Lalai,,0,0,0,,Betul.
Dialog: 0,1:04:54.34,1:04:56.61,Lalai,,0,0,0,,Mengenai kompleks peranginan itu...
Dialog: 0,1:04:56.64,1:05:00.78,Lalai,,0,0,0,,Saya mendengar firma perunding sedang\Nmenyemak kesahihan dan keuntungannya.
Dialog: 0,1:05:00.81,1:05:04.08,Lalai,,0,0,0,,Ya, cucu menantu saya menasihati saya untuk berbuat demikian.
Dialog: 0,1:05:04.10,1:05:05.75,Lalai,,0,0,0,,Saya gembira. Adalah baik untuk memastikan.
Dialog: 0,1:05:05.77,1:05:09.18,Lalai,,0,0,0,,Saya sedang bercakap dengan syarikat lain\Tidak juga, jadi jangan rasa tertekan.
Dialog: 0,1:05:09.48,1:05:14.97,Lalai,,0,0,0,,Apa? Syarikat lain? Saya dengar\NChairman Yeom sibuk kebelakangan ini.
Dialog: 0,1:05:14.99,1:05:16.47,Lalai,,0,0,0,,Adakah anda bercakap dengan dia juga?
Dialog: 0,1:05:16.49,1:05:19.01,Lalai,,0,0,0,,Aduh, saya harap Pengerusi Yeom...
Dialog: 0,1:05:19.04,1:05:22.43,Lalai,,0,0,0,,tidak mencuri peluang hebat ini daripada kami.
Dialog: 0,1:05:22.46,1:05:24.32,Lalai,,0,0,0,,Itu tidak boleh berlaku.
Dialog: 0,1:05:27.08,1:05:29.33,Lalai,,0,0,0,,- Tuan.\N- Apa itu?
Dialog: 0,1:05:29.71,1:05:32.98,Lalai,,0,0,0,,Berapa banyak wang yang Encik Song telah menggelapkan?
Dialog: 0,1:05:33.01,1:05:34.28,Lalai,,0,0,0,,$13 juta, tuan.
Dialog: 0,1:05:34.30,1:05:36.75,Lalai,,0,0,0,,Dan tiada siapa yang tahu?
Dialog: 0,1:05:37.01,1:05:38.70,Lalai,,0,0,0,,- Sepanjang masa ini?\N- Saya minta maaf.
Dialog: 0,1:05:38.72,1:05:40.24,Lalai,,0,0,0,,Dia menetapkan gaji pekerja...
Dialog: 0,1:05:40.26,1:05:42.95,Lalai,,0,0,0,,lebih tinggi daripada biasa, atau\Npenyata kewangan yang dimanipulasi...
Dialog: 0,1:05:42.98,1:05:45.25,Lalai,,0,0,0,,berdasarkan sijil deposit.
Dialog: 0,1:05:45.27,1:05:47.12,Lalai,,0,0,0,,Adakah dia akan menutup mulutnya?
Dialog: 0,1:05:47.15,1:05:50.17,Lalai,,0,0,0,,Peguam kami hadir semasa\Npendakwaan menyoal siasatnya.
Dialog: 0,1:05:50.19,1:05:52.46,Lalai,,0,0,0,,Dia tidak akan memberitahu jiwa,
Dialog: 0,1:05:52.49,1:05:54.27,Lalai,,0,0,0,,tetapi inilah masalahnya.
Dialog: 0,1:05:55.53,1:05:59.22,Lalai,,0,0,0,,Ia adalah jumlah yang besar, jadi\N atasan akan terlibat.
Dialog: 0,1:05:59.24,1:06:02.68,Lalai,,0,0,0,,Mereka boleh memanggil anda juga,\Njadi anda harus beranikan diri,
Dialog: 0,1:06:02.70,1:06:06.83,Lalai,,0,0,0,,tetapi sudah tentu, firma guaman kami akan\N melakukan yang terbaik untuk menghalangnya.
Dialog: 0,1:06:06.86,1:06:07.85,Lalai,,0,0,0,,Beom-jun.
Dialog: 0,1:06:07.88,1:06:09.53,Lalai,,0,0,0,,Ya, Bapa.
Dialog: 0,1:06:10.00,1:06:11.69,Lalai,,0,0,0,,Ini bukan...
Dialog: 0,1:06:11.71,1:06:13.15,Lalai,,0,0,0,,tentang Encik Song.
Dialog: 0,1:06:13.17,1:06:14.83,Lalai,,0,0,0,,Mereka mengejar saya!
Dialog: 0,1:06:15.13,1:06:16.96,Lalai,,0,0,0,,Siapa yang melakukannya?
Dialog: 0,1:06:17.76,1:06:20.38,Lalai,,0,0,0,,Siapa yang memberitahu pihak pendakwaan mengenainya?
Dialog: 0,1:06:20.64,1:06:24.17,Lalai,,0,0,0,,Mestilah seseorang yang sangat rapat dengan anda.
Dialog: 0,1:06:24.27,1:06:25.24,Lalai,,0,0,0,,Saya akan cari mereka.
Dialog: 0,1:06:25.27,1:06:27.09,Lalai,,0,0,0,,Mereka akan membayar untuk ini.
Dialog: 0,1:06:31.15,1:06:32.68,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:06:37.61,1:06:39.27,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:06:40.78,1:06:42.48,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:06:43.79,1:06:46.22,Lalai,,0,0,0,,Ia adalah peranti mendengar VOX pemancar RF.
Dialog: 0,1:06:46.25,1:06:50.10,Lalai,,0,0,0,,Ia hanya diaktifkan apabila ia mendengar\Ntahap hingar atau suara manusia tertentu.
Dialog: 0,1:06:50.13,1:06:53.86,Lalai,,0,0,0,,Siapa yang berani melakukan ini?
Dialog: 0,1:06:53.88,1:06:55.73,Lalai,,0,0,0,,Memandangkan saiz peranti ini,
Dialog: 0,1:06:55.76,1:07:00.21,Lalai,,0,0,0,,Saya rasa kita boleh mencari microwave\Nreceiver dalam radius 1 batu.
Dialog: 0,1:07:56.57,1:07:59.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kami boleh memindahkan\N$30 juta ke akaun Encik Jin.{\c}{\i0}
Dialog: 0,1:07:59.07,1:08:02.34,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kemudian jual stok di bawah nama\N yang dipinjam dan hantarkannya dalam ketulan kecil.{\c}{\i0}
Dialog: 0,1:08:02.36,1:08:04.76,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ya, lakukan itu dan maklumkan kepada Encik Jin.{\c}{\i0}
Dialog: 0,1:08:04.78,1:08:05.80,Lalai,,0,0,0,,- Tunggu.\N{\i1}{\c&H7AA0FF&}- Ya, tuan.{\c}{\i0}
Dialog: 0,1:08:05.83,1:08:08.24,Lalai,,0,0,0,,Kenapa ini ada di pejabat Hyun-woo?
Dialog: 0,1:08:09.54,1:08:11.31,Lalai,,0,0,0,,Ada lagi?
Dialog: 0,1:08:11.33,1:08:13.83,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Terdapat peti besi di dalam bilik Encik Baek.{\c}{\i0}
Dialog: 0,1:08:14.71,1:08:16.41,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bukanya.{\c}{\i0}
Dialog: 0,1:08:25.47,1:08:26.74,Lalai,,0,0,0,,Mengapa saya tidak dapat menghubungi anda?
Dialog: 0,1:08:26.76,1:08:29.08,Lalai,,0,0,0,,Tahukah anda apa yang berlaku malam tadi?
Dialog: 0,1:08:29.10,1:08:32.00,Lalai,,0,0,0,,Kajian datuk kamu telah diserang.
Dialog: 0,1:08:32.02,1:08:33.41,Lalai,,0,0,0,,{\i1}Dia sudah berada di tepi...{\i0}
Dialog: 0,1:08:33.44,1:08:35.96,Lalai,,0,0,0,,{\i1}kerana pengurus kewangannya\Ndituduh melakukan penyelewengan.{\i0}
Dialog: 0,1:08:35.98,1:08:37.50,Lalai,,0,0,0,,- Jadi?\N- "Jadi"?
Dialog: 0,1:08:37.53,1:08:40.81,Lalai,,0,0,0,,Suami anda menyediakan pepijat.
Dialog: 0,1:08:42.70,1:08:43.67,Lalai,,0,0,0,,Adakah anda mempunyai bukti?
Dialog: 0,1:08:43.70,1:08:45.80,Lalai,,0,0,0,,Itulah sebabnya saya menelefon.
Dialog: 0,1:08:45.83,1:08:48.01,Lalai,,0,0,0,,Kami menemui penerima di dalam biliknya.
Dialog: 0,1:08:48.04,1:08:51.14,Lalai,,0,0,0,,Sesiapa sahaja boleh meletakkannya\Ndi sana semasa kami tiada.
Dialog: 0,1:08:51.16,1:08:53.53,Lalai,,0,0,0,,Rumah itu kosong berhari-hari.
Dialog: 0,1:08:53.75,1:08:54.73,Lalai,,0,0,0,,Adakah kamu semua bodoh?
Dialog: 0,1:08:54.75,1:08:56.52,Lalai,,0,0,0,,Jangan berpihak kepadanya.
Dialog: 0,1:08:56.54,1:09:00.98,Lalai,,0,0,0,,Saya rasa pelik bahawa Hyun-woo sangat menentang idea perniagaan Soo-cheol.
Dialog: 0,1:09:01.01,1:09:05.04,Lalai,,0,0,0,,Periksa kamera CCTV sebelum\Nmenunding jari anda kepadanya.
Dialog: 0,1:09:06.05,1:09:07.30,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu{\c}{\i0}
Dialog: 0,1:09:19.61,1:09:21.92,Lalai,,0,0,0,,Nampak? Saya semua yang anda ada, bukan?
Dialog: 0,1:09:21.94,1:09:22.92,Lalai,,0,0,0,,Akui saja.
Dialog: 0,1:09:22.95,1:09:26.19,Lalai,,0,0,0,,Ya, saya di sini.
Dialog: 0,1:09:26.24,1:09:28.94,Lalai,,0,0,0,,Kedai ditutup.
Dialog: 0,1:09:29.58,1:09:32.14,Lalai,,0,0,0,,Tidak, untuk kebaikan. Mereka telah tutup.
Dialog: 0,1:09:32.16,1:09:33.27,Lalai,,0,0,0,,Apa yang anda berikan kepada mereka?
Dialog: 0,1:09:33.29,1:09:34.85,Lalai,,0,0,0,,Kemudian lihat di seberang jalan.
Dialog: 0,1:09:34.87,1:09:35.89,Lalai,,0,0,0,,Kereta saya ada.
Dialog: 0,1:09:35.92,1:09:37.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Tempat Letak Kereta Awam{\c}{\i0}
Dialog: 0,1:09:37.21,1:09:39.77,Lalai,,0,0,0,,Apa? Awak tidak berbohong.
Dialog: 0,1:09:39.80,1:09:40.94,Lalai,,0,0,0,,Kenapa awak letak kereta di sini?
Dialog: 0,1:09:40.96,1:09:43.54, Lalai,,0,0,0,,Kuncinya terletak pada roda kanan hadapan.
Dialog: 0,1:09:46.76,1:09:47.86,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:09:47.89,1:09:51.07,Lalai,,0,0,0,,Hantar kad SD kamera pemuka saya,
Dialog: 0,1:09:51.10,1:09:54.79, Lalai,,0,0,0,, dan ketahui bila kedai ditutup.
Dialog: 0,1:09:54.81,1:09:56.25,Lalai,,0,0,0,,Adakah ini kes, dengan suspek?
Dialog: 0,1:09:56.27,1:09:58.58,Lalai,,0,0,0,,Sesuatu seperti itu. Terima kasih terlebih dahulu.
Dialog: 0,1:09:58.61,1:10:01.00,Lalai,,0,0,0,,Saya mungkin seorang peguam cerai,
Dialog: 0,1:10:01.03,1:10:03.94,Lalai,,0,0,0,,tetapi saya sentiasa mahu\Nmengusahakan kes jenayah.
Dialog: 0,1:10:05.28,1:10:07.86,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:10:20.96,1:10:22.58,Lalai,,0,0,0,,Ke mana anda pergi?
Dialog: 0,1:10:23.09,1:10:24.75,Lalai,,0,0,0,,Saya sedang menelefon.
Dialog: 0,1:10:25.01,1:10:26.40,Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,1:10:26.43,1:10:28.46,Lalai,,0,0,0,,Saya sedang menelefon Yang-gi.
Dialog: 0,1:10:29.47,1:10:31.92,Lalai,,0,0,0,,Adakah orang lain menghubungi anda?
Dialog: 0,1:10:32.51,1:10:34.30,Lalai,,0,0,0,,Seperti siapa?
Dialog: 0,1:10:34.39,1:10:37.47,Lalai,,0,0,0,,Ibu saya atau orang lain.
Dialog: 0,1:10:38.77,1:10:41.63,Lalai,,0,0,0,,Jangan angkat sebarang panggilan daripada keluarga saya.
Dialog: 0,1:10:41.65,1:10:42.75,Lalai,,0,0,0,,Mengapa tidak?
Dialog: 0,1:10:42.78,1:10:44.39,Lalai,,0,0,0,,Jangan.
Dialog: 0,1:10:45.82,1:10:46.99,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu Mertua{\c}{\i0}
Dialog: 0,1:10:54.66,1:10:56.77,Lalai,,0,0,0,,Jangan jawab.
Dialog: 0,1:10:56.79,1:11:00.20,Lalai,,0,0,0,,Saya tidak boleh tertekan apabila mengambil suntikan.
Dialog: 0,1:11:00.75,1:11:02.63,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,1:11:13.81,1:11:15.78,Lalai,,0,0,0,,Ini Moh Seul-hee.
Dialog: 0,1:11:15.81,1:11:17.74,Lalai,,0,0,0,,Ia Oh Sun-yeong.
Dialog: 0,1:11:17.77,1:11:20.60,Lalai,,0,0,0,,Apa yang anda maksudkan? Ia Seul-hee.
Dialog: 0,1:11:21.61,1:11:25.31,Lalai,,0,0,0,,Dia Oh Sun-yeong yang meninggal dunia 30 tahun lalu.
Dialog: 0,1:11:26.40,1:11:32.13,Lalai,,0,0,0,,Jadi Oh Sun-yeong ini meninggal 30 tahun yang lalu,
Dialog: 0,1:11:32.16,1:11:35.03,Lalai,,0,0,0,,- dan dia sebenarnya Moh Seul-hee?\N- Betul.
Dialog: 0,1:11:36.87,1:11:39.72,Lalai,,0,0,0,,Lalu di manakah Moh Seul-hee yang sebenar?
Dialog: 0,1:11:39.75,1:11:42.45,Lalai,,0,0,0,,Saya tidak pasti. Namun...
Dialog: 0,1:11:46.46,1:11:50.15,Lalai,,0,0,0,,Sun-yeong telah ditangkap kerana berzina\Ntiga tahun sebelum kematiannya,
Dialog: 0,1:11:50.18,1:11:53.13,Lalai,,0,0,0,,dan dia bersalin di balik jeruji besi.
Dialog: 0,1:11:54.60,1:11:56.17,Lalai,,0,0,0,,Dia ada anak?
Dialog: 0,1:11:58.39,1:11:59.37,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:11:59.39,1:12:01.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dipenjara ketika hamil 4 bulan\NGelahirkan anak lelaki{\c}{\i0}
Dialog: 0,1:12:04.86,1:12:07.34,Lalai,,0,0,0,,Ayah, kita patut tunggu sehingga Hyun-woo datang.
Dialog: 0,1:12:07.36,1:12:09.44,Lalai,,0,0,0,,Senyap!
Dialog: 0,1:12:24.34,1:12:25.31,Lalai,,0,0,0,,Apa?
Dialog: 0,1:12:25.34,1:12:28.04,Lalai,,0,0,0,,- Beraninya dia?\N- Apa itu?
Dialog: 0,1:12:34.79,1:12:36.01,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,1:12:36.04,1:12:37.03,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:12:37.06,1:12:38.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ditandatangani: Baek Hyun-woo\NHong Hae-in{\c}{\i0}
Dialog: 0,1:12:46.94,1:12:48.68,Lalai,,0,0,0,,Adakah saya perlu berdoa?
Dialog: 0,1:12:51.07,1:12:53.38,Lalai,,0,0,0,,Keputusan terapi keluar esok.
Dialog: 0,1:12:53.41,1:12:56.90,Lalai,,0,0,0,,Saya perlukan semua tuah yang saya dapat.
Dialog: 0,1:12:59.24,1:13:01.24,Lalai,,0,0,0,,Mengapa beratur panjang?
Dialog: 0,1:13:02.25,1:13:04.10, Lalai,,0,0,0,, Patutkah kita menyemaknya?
Dialog: 0,1:13:04.12,1:13:06.53,Lalai,,0,0,0,,Anda tidak suka menunggu dalam barisan.
Dialog: 0,1:13:06.75,1:13:09.25,Lalai,,0,0,0,,Betul, saya tidak berbuat demikian.
Dialog: 0,1:13:09.51,1:13:13.03,Lalai,,0,0,0,,Saya rasa seperti orang biasa. Saya benci itu.
Dialog: 0,1:13:13.05,1:13:14.19,Lalai,,0,0,0,,Tetapi?
Dialog: 0,1:13:14.22,1:13:15.70,Lalai,,0,0,0,,Tetapi...
Dialog: 0,1:13:15.72,1:13:17.88,Lalai,,0,0,0,,cukup pelik,
Dialog: 0,1:13:18.68,1:13:20.74,Lalai,,0,0,0,,Saya ingin menjadi biasa sekali.
Dialog: 0,1:13:20.77,1:13:26.21,Lalai,,0,0,0,,Saya mahu beratur dan hanya\Nharap mereka masih makan kebab...
Dialog: 0,1:13:26.23,1:13:28.60,Lalai,,0,0,0,,tinggal untuk saya.
Dialog: 0,1:13:31.19,1:13:32.92,Lalai,,0,0,0,,Mengapa anda tidak beratur?
Dialog: 0,1:13:32.95,1:13:34.65,Lalai,,0,0,0,,Saya akan kembali.
Dialog: 0,1:14:17.91,1:14:19.73,Lalai,,0,0,0,,Dia perlukan...
Dialog: 0,1:14:21.49,1:14:23.57,Lalai,,0,0,0,,semua tuah yang dia dapat.
Dialog: 0,1:14:29.50,1:14:31.73,Lalai,,0,0,0,,Anda masih tidak dapat menghubungi mereka?
Dialog: 0,1:14:31.75,1:14:34.86,Lalai,,0,0,0,,Tidak, telefon mereka dimatikan.
Dialog: 0,1:14:34.88,1:14:37.63,Lalai,,0,0,0,,- Astaga.\N- Perceraian?
Dialog: 0,1:14:37.84,1:14:39.78,Lalai,,0,0,0,,Saya melihat ke dalam dia,
Dialog: 0,1:14:39.80,1:14:42.24,Lalai,,0,0,0,,dan rakan yang dia jumpa\Npaling kerap hari ini...
Dialog: 0,1:14:42.26,1:14:46.63, Lalai,,0,0,0,, ialah Kim Yang-gi, seorang peguam perceraian.
Dialog: 0,1:14:46.69,1:14:49.21,Lalai,,0,0,0,,Itu mungkin bukan apa-apa,\Ntetapi ada masalah yang lebih besar.
Dialog: 0,1:14:49.23,1:14:51.37,Lalai,,0,0,0,,Di sinilah Encik Kim bekerja.
Dialog: 0,1:14:51.40,1:14:54.06,Lalai,,0,0,0,,- Itu Apollon.\N- Apa?
Dialog: 0,1:14:54.32,1:14:57.05,Lalai,,0,0,0,,Bukankah itu firma guaman Pengerusi Yeom?
Dialog: 0,1:14:57.07,1:15:00.22,Lalai,,0,0,0,,Ya, jadi saya bimbang bahawa\NMr. Baek mungkin telah menyerahkan...
Dialog: 0,1:15:00.24,1:15:02.01,Lalai,,0,0,0,,fail-fail yang disepit kepadanya.
Dialog: 0,1:15:02.03,1:15:06.85,Lalai,,0,0,0,,Itu mesti bermakna Hyun-woo\N ialah pemberi maklumat, bukan?
Dialog: 0,1:15:06.87,1:15:09.54,Lalai,,0,0,0,,Anda tidak sepatutnya membuat kesimpulan.
Dialog: 0,1:15:09.57,1:15:10.56,Lalai,,0,0,0,,Dia betul.
Dialog: 0,1:15:10.58,1:15:13.94,Lalai,,0,0,0,,Hyun-woo tidak tahu\Tiada apa-apa tentang tabung rahsia.
Dialog: 0,1:15:13.96,1:15:16.07,Lalai,,0,0,0,,Saya tidak mahu mendengarnya. Panggil mereka.
Dialog: 0,1:15:16.09,1:15:18.46,Lalai,,0,0,0,,Suruh mereka pulang sekarang!
Dialog: 0,1:16:09.02,1:16:10.72,Lalai,,0,0,0,,Saya jumpa.
Dialog: 0,1:16:11.40,1:16:13.22,Lalai,,0,0,0,,Ia masih di sini.
Dialog: 0,1:16:33.46,1:16:34.77,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,1:17:26.72,1:17:28.68,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu{\c}{\i0}
Dialog: 0,1:17:35.48,1:17:37.06,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ayah{\c}{\i0}
Dialog: 0,1:17:43.28,1:17:44.98,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,1:17:45.95,1:17:47.65,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:17:57.17,1:18:00.45,Lalai,,0,0,0,,Apa itu? Apa yang dia pegang?
Dialog: 0,1:18:02.71,1:18:03.69,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu\NMesej Baharu{\c}{\i0}
Dialog: 0,1:18:38.21,1:18:41.58,Lalai,,0,0,0,,Hae-in, saya jumpa. Dalam perjalanan ke sini...
Dialog: 0,1:19:02.82,1:19:05.61,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,1:19:09.07,1:19:11.07,Lalai,,0,0,0,,Beritahu saya ini tidak benar.
Dialog: 0,1:19:11.95,1:19:13.94,Lalai,,0,0,0,,Katakan.
Dialog: 0,1:19:14.66,1:19:16.78,Lalai,,0,0,0,,Nafikannya.
Dialog: 0,1:19:18.42,1:19:20.27,Lalai,,0,0,0,,- Hae-in...\N- Katakan.
Dialog: 0,1:19:20.29,1:19:22.20,Lalai,,0,0,0,,Beritahu saya ia tidak benar.
Dialog: 0,1:19:25.09,1:19:27.46, Lalai,,0,0,0,, Beritahu saya itu bukan awak.
Dialog: 0,1:19:37.48,1:19:39.01,Lalai,,0,0,0,,No.
Dialog: 0,1:19:42.73,1:19:45.18,Lalai,,0,0,0,,Itu saya.
Dialog: 0,1:19:54.99,1:19:57.11,Lalai,,0,0,0,,Maaf saya tidak dapat memberitahu anda.
Dialog: 0,1:21:12.36,1:21:14.57,Lalai,,0,0,0,,- Saya okay. Ambillah.\N- Encik Baek...
Dialog: 0,1:21:14.60,1:21:15.63,Lalai,,0,0,0,,Saya betul-betul okay.
Dialog: 0,1:21:15.66,1:21:17.90,Lalai,,0,0,0,,Tetapi saya...
Dialog: 0,1:21:27.17,1:21:29.79,Lalai,,0,0,0,,Saya ada pemandu.
Dialog: 0,1:21:45.10,1:21:46.50,Lalai,,0,0,0,,Tunggu. Perlahan.
Dialog: 0,1:21:46.52,1:21:47.92,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:21:47.94,1:21:49.77,Lalai,,0,0,0,,Perlahankan sedikit.
Dialog: 0,1:22:29.23,1:22:34.34,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda gembira melihatnya dari jauh.\NAnda tidak boleh berhenti memikirkannya.{\c}{\i0}
Dialog: 0,1:22:34.36,1:22:37.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda mengambil lencongan hanya untuk melihatnya sekali lagi.{\c}{\i0}
Dialog: 0,1:22:37.20,1:22:40.86,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika anda melakukannya buat kali pertama,\Nmaka itulah cinta pertama anda.{\c}{\i0}
Dialog: 0,1:22:49.75,1:22:52.19,Lalai,,0,0,0,,Tuan, sila ikut bas itu.
Dialog: 0,1:22:52.21,1:22:53.65,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:22:53.67,1:22:55.32,Lalai,,0,0,0,,Bas itu akan menyeberangi jambatan.
Dialog: 0,1:22:55.34,1:22:57.63,Lalai,,0,0,0,,Tidak mengapa. Sila ikutinya.
Dialog: 0,1:24:21.97,1:24:24.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:24:53.00,1:24:55.45,Lalai,,0,0,0,,{\an8}{\i1}Anda telah menyerahkan segala-galanya?{\i0}
Dialog: 0,1:24:56.46,1:24:59.11,Lalai,,0,0,0,,{\an8}{\i1}Apa yang anda akan lakukan? Lakukan sesuatu jika anda boleh!{\i0}
Dialog: 0,1:24:59.13,1:25:01.96,Lalai,,0,0,0,,{\an8}{\i1}Berhenti bermain. Anda jijikkan saya.{\i0}
Dialog: 0,1:25:02.38,1:25:04.78,Lalai,,0,0,0,,{\an8}{\i1}Dia telah menyadap bilik anda.{\i0}
Dialog: 0,1:25:04.80,1:25:06.45,Lalai,,0,0,0,,{\an8}{\i1}Tetapi saya boleh melihat melepasinya.{\i0}
Dialog: 0,1:25:06.47,1:25:08.24,Lalai,,0,0,0,,{\an8}{\i1}Mengapa anda mahu?{\i0}
Dialog: 0,1:25:08.26,1:25:09.70,Lalai,,0,0,0,,{\an8}{\i1}Dia tahu tentang perceraian itu.{\i0}
Dialog: 0,1:25:09.72,1:25:11.41,Lalai,,0,0,0,,{\an8}{\i1}Pasukan audit akan melakukannya.{\i0}
Dialog: 0,1:25:11.43,1:25:13.58,Lalai,,0,0,0,,{\an8}{\i1}Anda akan ditendang keluar tanpa belas kasihan.{\i0}
Dialog: 0,1:25:13.60,1:25:16.62,Lalai,,0,0,0,,{\an8}- {\i1}Dia menghantar bunga kepada Kim Min-ji.\N- Di mana dia sekarang?{\i0}
Dialog: 0,1:25:16.65,1:25:18.00,Lalai,,0,0,0,,{\an8}{\i1}Sungguh bersemangat.{\i0}
Dialog: 0,1:25:18.02,1:25:20.92,Lalai,,0,0,0,,{\an8}{\i1}Bagaimana jika saya menggantikannya?{\i0}
Dialog: 0,1:25:20.94,1:25:24.48,Lalai,,0,0,0,,{\an8}{\i1}Tetapi sila jaga\Njarak anda daripada Yoon Eun-sung.{\i0}
