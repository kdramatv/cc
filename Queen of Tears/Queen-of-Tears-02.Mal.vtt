Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.93,0:01:04.62,Lalai,,0,0,0,,{\an8}Nah, saya...
Dialog: 0,0:01:04.64,0:01:07.41, Lalai,,0,0,0,,{\an8}Jadi apa...?
Dialog: 0,0:01:07.44,0:01:08.66, Lalai,,0,0,0,,{\an8}Ya?
Dialog: 0,0:01:08.69,0:01:11.52, Lalai,,0,0,0,,{\an8}...Saya ingin katakan ialah...
Dialog: 0,0:01:13.07,0:01:14.77, Lalai,,0,0,0,,{\an8}Saya...
Dialog: 0,0:01:15.70,0:01:18.44, Lalai,,0,0,0,,{\an8}- Ya?\N- "Saya minta maaf."
Dialog: 0,0:01:20.74,0:01:23.61, Lalai,,0,0,0,,{\an8}"Perihal hari ini,"
Dialog: 0,0:01:23.79,0:01:27.35, Lalai,,0,0,0,,{\an8}"dan semua yang saya lakukan setakat ini."
Dialog: 0,0:01:27.37,0:01:31.40, Lalai,,0,0,0,,{\an8}"Ia tidak akan berlaku lagi.\NI akan melayan anda dengan lebih baik."
Dialog: 0,0:01:31.42,0:01:34.91, Lalai,,0,0,0,,{\an8}Itulah yang saya mahu...
Dialog: 0,0:01:35.67,0:01:36.86, Lalai,,0,0,0,,{\an8}untuk mengatakan,
Dialog: 0,0:01:36.88,0:01:39.15,Lalai,,0,0,0,,{\an8}tetapi anda hanya mempunyai tiga bulan untuk hidup?
Dialog: 0,0:01:39.18,0:01:40.86, Lalai,,0,0,0,,Bagaimana mungkin?
Dialog: 0,0:01:40.89,0:01:44.05, Lalai,,0,0,0,,Bagaimana saya boleh hidup tanpa awak?
Dialog: 0,0:01:45.14,0:01:46.88, Lalai,,0,0,0,,Bagaimana mungkin?
Dialog: 0,0:01:46.98,0:01:49.62, Lalai,,0,0,0,,Saya sangat terkedu,
Dialog: 0,0:01:49.65,0:01:51.89, Lalai,,0,0,0,,Saya tidak tahu nak cakap apa.
Dialog: 0,0:01:56.44,0:01:57.67,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:01:57.70,0:02:00.52, Lalai,,0,0,0,,Ya, bodoh.
Dialog: 0,0:02:09.46,0:02:11.66, Lalai,,0,0,0,,Saya sayang awak, Hong Hae-in.
Dialog: 0,0:02:13.75,0:02:15.58,Lalai,,0,0,0,,Saya sayang awak.
Dialog: 0,0:02:15.96,0:02:18.87, Lalai,,0,0,0,,Jika awak tidak boleh hidup tanpa saya...
Dialog: 0,0:02:19.22,0:02:20.92, Lalai,,0,0,0,,Ya?
Dialog: 0,0:02:21.97,0:02:23.57, Lalai,,0,0,0,,Adakah anda mahu mati bersama?
Dialog: 0,0:02:29.06,0:02:31.35, Lalai,,0,0,0,,Awak kata awak tak boleh hidup tanpa saya.
Dialog: 0,0:02:31.86,0:02:36.85,Lalai,,0,0,0,,Saya tidak bermaksud saya pasti\NI tidak boleh hidup tanpa awak.
Dialog: 0,0:02:36.90,0:02:39.44, Lalai,,0,0,0,,Saya hanya tertanya-tanya...
Dialog: 0,0:02:40.45,0:02:42.93, Lalai,,0,0,0,,jika boleh berbuat demikian. Saya ingin tahu.
Dialog: 0,0:02:42.95,0:02:46.36, Lalai,,0,0,0,, Tepat sekali. Kemudian kita hanya perlu mati bersama.
Dialog: 0,0:02:46.58,0:02:51.27, Lalai,,0,0,0,,Ia adalah perkara rasmi pada\N hari itu. Ia dipanggil "sunjang."
Dialog: 0,0:02:51.29,0:02:53.41, Lalai,,0,0,0,,Mereka menguburkan anda bersama pasangan anda.
Dialog: 0,0:02:53.71,0:02:55.35, Lalai,,0,0,0,, Betul.
Dialog: 0,0:02:55.38,0:02:57.31,Lalai,,0,0,0,,{\i1}Sunjang.{\i0}
Dialog: 0,0:02:57.34,0:03:00.29, Lalai,,0,0,0,,Ya, {\i1}sunjang.{\i0}
Dialog: 0,0:03:00.93,0:03:04.49,Lalai,,0,0,0,,Awak boleh layan saya dengan lebih baik di akhirat.
Dialog: 0,0:03:04.51,0:03:06.05, Lalai,,0,0,0,,Ia tidak teruk.
Dialog: 0,0:03:08.68,0:03:12.00, Lalai,,0,0,0,,Anda sentiasa baik\Nat membuat jenaka yang menakutkan...
Dialog: 0,0:03:12.02,0:03:13.97, Lalai,,0,0,0,,dengan muka lurus.
Dialog: 0,0:03:14.31,0:03:16.02,Lalai,,0,0,0,,Adakah anda fikir saya bergurau?
Dialog: 0,0:03:18.44,0:03:19.50,Lalai,,0,0,0,,Awak serius?
Dialog: 0,0:03:19.53,0:03:21.73, Lalai,,0,0,0,,Saya katakan jangan dramatik.
Dialog: 0,0:03:26.28,0:03:28.11, Lalai,,0,0,0,, Beritahu saya.
Dialog: 0,0:03:30.79,0:03:32.99, Lalai,,0,0,0,,Apa sebenarnya yang doktor katakan?
Dialog: 0,0:03:33.25,0:03:35.64, Lalai,,0,0,0,,Di mana anda sakit?
Dialog: 0,0:03:35.67,0:03:38.70, Lalai,,0,0,0,,Adakah doktor benar-benar\Nkatakan ia hanya memerlukan tiga...?
Dialog: 0,0:03:40.34,0:03:42.96, Lalai,,0,0,0,,Bahawa anda hanya mempunyai tiga bulan untuk hidup?
Dialog: 0,0:03:47.14,0:03:48.84, Lalai,,0,0,0,,Helo, Profesor.
Dialog: 0,0:03:49.18,0:03:50.88, Lalai,,0,0,0,,Hasil ujian?
Dialog: 0,0:03:52.48,0:03:56.51,Lalai,,0,0,0,,Bolehkah anda e-melkannya kepada saya?\NI tidak mempunyai masa untuk pergi ke sana.
Dialog: 0,0:04:16.71,0:04:18.83, Lalai,,0,0,0,,Kita perlu pergi ke suatu tempat.
Dialog: 0,0:04:20.09,0:04:21.73, Lalai,,0,0,0,,Anda bebas hari ini, bukan?
Dialog: 0,0:04:21.76,0:04:23.83, Lalai,,0,0,0,,Kereta sedang menunggu di tingkat bawah.
Dialog: 0,0:04:27.18,0:04:29.05, Lalai,,0,0,0,,Saya tidak akan pergi.
Dialog: 0,0:04:31.14,0:04:33.88, Lalai,,0,0,0,,- Saya tidak memberitahu anda ke mana kita hendak pergi.\N- Tidak mengapa.
Dialog: 0,0:04:33.90,0:04:36.61, Lalai,,0,0,0,,Saya enggan pergi ke mana-mana dengan awak.
Dialog: 0,0:04:38.27,0:04:40.77, Lalai,,0,0,0,,Ke mana anda hendak pergi sekarang?
Dialog: 0,0:04:41.48,0:04:44.65, Lalai,,0,0,0,,Saya tidak tahu. Saya tidak tahu ke mana saya pergi.
Dialog: 0,0:04:54.75,0:04:56.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pusat Perubatan Universiti Sungmin{\c}{\i0}
Dialog: 0,0:05:18.90,0:05:21.46, Lalai,,0,0,0,,{\i1}Tidak seperti tumor biasa,{\i0}
Dialog: 0,0:05:21.48,0:05:25.35, Lalai,,0,0,0,,{\i1}tumor seperti fuzz ini bertaburan.{\i0}
Dialog: 0,0:05:31.83,0:05:33.36, Lalai,,0,0,0,,Tahan.
Dialog: 0,0:05:33.79,0:05:36.27, Lalai,,0,0,0,,Bila saya sampai di sini?
Dialog: 0,0:05:36.29,0:05:38.37, Lalai,,0,0,0,,Maaf?
Dialog: 0,0:05:39.67,0:05:42.15, Lalai,,0,0,0,,Saya masih ingat berada di lobi,
Dialog: 0,0:05:42.17,0:05:44.08, Lalai,,0,0,0,,jadi bagaimana saya sudah berada di sini?
Dialog: 0,0:05:44.30,0:05:46.23, Lalai,,0,0,0,,Ia seperti saya teleport.
Dialog: 0,0:05:46.26,0:05:48.54, Lalai,,0,0,0,,Adakah perkara ini pernah berlaku sebelum ini?
Dialog: 0,0:05:48.84,0:05:50.95, Lalai,,0,0,0,,Saya beritahu anda kali terakhir.
Dialog: 0,0:05:50.97,0:05:56.04, Lalai,,0,0,0,,Kadang-kadang saya sakit kepala dan\N sering pelupa, dan kadang-kadang...
Dialog: 0,0:05:56.06,0:05:58.75, Lalai,,0,0,0,,VIP kami menggemari kelas seni\Nkami adakan pada separuh tahun pertama.
Dialog: 0,0:05:58.77,0:05:59.99,Lalai,,0,0,0,,Kami menjemput artis terkenal...
Dialog: 0,0:06:00.01,0:06:01.54, Lalai,,0,0,0,,Restea akan menyertai kami.
Dialog: 0,0:06:01.56,0:06:03.68, Lalai,,0,0,0,,Hari ini, kualiti tidur...
Dialog: 0,0:06:06.86,0:06:09.38, Lalai,,0,0,0,,{\i1}Sepuluh minit? Setengah jam?{\i0}
Dialog: 0,0:06:09.41,0:06:14.36, Lalai,,0,0,0,,{\i1}Kadang-kadang saya tidak ingat apa yang\NI lakukan selama beberapa jam yang lalu.{\i0}
Dialog: 0,0:06:35.14,0:06:36.67, Lalai,,0,0,0,,Pn. Hong.
Dialog: 0,0:06:37.14,0:06:40.75,Lalai,,0,0,0,,{\an8}Saya fikir anda telah membatalkan rancangan anda\Nuntuk bertemu dengan Pengarah Baek Hyun-woo.
Dialog: 0,0:06:40.77,0:06:42.64, Lalai,,0,0,0,,Kenapa awak masih di sini?
Dialog: 0,0:06:43.65,0:06:46.31,Lalai,,0,0,0,,{\i1}Malah saya terlepas janji temu penting.{\i0}
Dialog: 0,0:07:14.30,0:07:16.67, Lalai,,0,0,0,,Kenapa awak tidak melawat saya lebih awal?
Dialog: 0,0:07:16.76,0:07:19.37, Lalai,,0,0,0,,Saya cuma fikir saya akan mengantuk atau mengezon...
Dialog: 0,0:07:19.39,0:07:20.70, Lalai,,0,0,0,, kerana keletihan.
Dialog: 0,0:07:20.73,0:07:24.51, Lalai,,0,0,0,,Saya tidak merasakan sebarang kesakitan fizikal,
Dialog: 0,0:07:24.61,0:07:26.31, Lalai,,0,0,0,,jadi...
Dialog: 0,0:07:27.82,0:07:29.34, Lalai,,0,0,0,,ada apa-apa yang salah dengan saya?
Dialog: 0,0:07:29.36,0:07:31.92, Lalai,,0,0,0,,Anda mempunyai Cloud Cytoma. Ia adalah penyakit yang sangat jarang berlaku.
Dialog: 0,0:07:31.95,0:07:34.09, Lalai,,0,0,0,,Tiada banyak kes di seluruh dunia.
Dialog: 0,0:07:34.12,0:07:38.07, Lalai,,0,0,0,,Adalah selamat untuk mengatakan anda ialah\Nour pesakit Korea pertama.
Dialog: 0,0:07:40.87,0:07:43.91, Lalai,,0,0,0,,- Adakah saya memerlukan pembedahan?\N- Tidak.
Dialog: 0,0:07:45.13,0:07:49.19, Lalai,,0,0,0,,Saya faham. Ia boleh dirawat dengan ubat.
Dialog: 0,0:07:49.21,0:07:51.90,Lalai,,0,0,0,,Kes anda agak rumit,
Dialog: 0,0:07:51.92,0:07:54.11, Lalai,,0,0,0,,kerana ia berbeza daripada tumor biasa.
Dialog: 0,0:07:54.14,0:07:57.07, Lalai,,0,0,0,,Ia bukan ketulan tumor yang jelas.
Dialog: 0,0:07:57.10,0:08:02.34, Lalai,,0,0,0,,Sel tumor tersebar\Nseluruh saraf kranial anda.
Dialog: 0,0:08:03.23,0:08:05.04, Lalai,,0,0,0,,Ia tersebar di kawasan yang luas.
Dialog: 0,0:08:05.06,0:08:08.00, Lalai,,0,0,0,,Ia paling pekat\Nberhampiran lobus temporal anda.
Dialog: 0,0:08:08.02,0:08:12.19, Lalai,,0,0,0,,Saya percaya ini adalah punca kehilangan ingatan sementara anda.
Dialog: 0,0:08:12.36,0:08:13.63, Lalai,,0,0,0,,Ia adalah penyakit yang jarang berlaku.
Dialog: 0,0:08:13.65,0:08:17.57, Lalai,,0,0,0,,Simptomnya tidak spesifik\Nand berbeza dari kes ke kes.
Dialog: 0,0:08:17.70,0:08:21.89,Lalai,,0,0,0,,Jika ia bertambah teruk, anda boleh mengalami\Nhalusinasi atau gangguan personaliti.
Dialog: 0,0:08:21.91,0:08:25.77, Lalai,,0,0,0,,Masalahnya, pengambilan\Nubat tidak banyak membantu,
Dialog: 0,0:08:25.79,0:08:28.06,Lalai,,0,0,0,,{\i1}dan terlalu berbahaya untuk menjalani pembedahan,{\i0}
Dialog: 0,0:08:28.09,0:08:32.41,Lalai,,0,0,0,,{\i1}memandangkan sel tumor telah merebak terlalu banyak.{\i0}
Dialog: 0,0:08:33.55,0:08:35.25,Lalai,,0,0,0,,{\i1}Cik. Hong?{\i0}
Dialog: 0,0:08:38.30,0:08:39.84, Lalai,,0,0,0,,{\i1}Cik. Hong?{\i0}
Dialog: 0,0:08:42.64,0:08:44.55, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:08:54.03,0:08:55.92, Lalai,,0,0,0,,- Okay.\N- Maaf?
Dialog: 0,0:08:55.95,0:08:59.23, Lalai,,0,0,0,,Jadi begitulah keadaannya bagi orang biasa.
Dialog: 0,0:08:59.37,0:09:00.72, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:09:00.74,0:09:03.43, Lalai,,0,0,0,,Sekarang beritahu saya rawatan yang saya boleh dapatkan.
Dialog: 0,0:09:03.45,0:09:05.97,Lalai,,0,0,0,,Saya ingin tahu tentang kes saya, bukan kes mereka.
Dialog: 0,0:09:06.00,0:09:08.56, Lalai,,0,0,0,,Saya dengar awak sedang mengumpul wang\Nuntuk hospital kanak-kanak baharu.
Dialog: 0,0:09:08.59,0:09:10.69, Lalai,,0,0,0,,Saya boleh uruskan itu,
Dialog: 0,0:09:10.71,0:09:12.75, Lalai,,0,0,0,,jadi beritahu saya...
Dialog: 0,0:09:13.26,0:09:14.90,Lalai,,0,0,0,,bagaimana saya boleh menyingkirkannya.
Dialog: 0,0:09:14.92,0:09:16.28,Lalai,,0,0,0,,Untuk pengetahuan saya,
Dialog: 0,0:09:16.30,0:09:19.84, Lalai,,0,0,0,,tiada penyelesaian perubatan semasa untuk ini.
Dialog: 0,0:09:20.05,0:09:22.70,Lalai,,0,0,0,,Yang terbaik yang boleh kami lakukan ialah memberi anda ubat...
Dialog: 0,0:09:22.72,0:09:25.70, Lalai,,0,0,0,,untuk meredakan sakit kepala anda\Ndan kehilangan ingatan sementara.
Dialog: 0,0:09:25.73,0:09:29.22,Lalai,,0,0,0,,Walau bagaimanapun, adalah mustahil untuk\Mengubati penyakit itu sendiri buat masa ini...
Dialog: 0,0:09:29.81,0:09:31.89, Lalai,,0,0,0,,Anda telah menyindir...
Dialog: 0,0:09:32.36,0:09:35.69, Lalai,,0,0,0,,bahawa saya akan mati tidak lama lagi.
Dialog: 0,0:09:35.99,0:09:37.92, Lalai,,0,0,0,, Baik. Beritahu saya.
Dialog: 0,0:09:37.95,0:09:40.26, Lalai,,0,0,0,,Bila saya akan mati?
Dialog: 0,0:09:40.28,0:09:43.15, Lalai,,0,0,0,,Berdasarkan penyebaran sel tumor,
Dialog: 0,0:09:43.83,0:09:47.11, Lalai,,0,0,0,,Saya percaya anda mempunyai kira-kira tiga bulan.
Dialog: 0,0:09:53.13,0:09:54.77, Lalai,,0,0,0,,Apa yang dia tahu, pula?
Dialog: 0,0:09:54.80,0:09:57.29, Lalai,,0,0,0,,Dia paling tahu sebagai seorang doktor.
Dialog: 0,0:09:58.97,0:10:00.79, Lalai,,0,0,0,,Saya tahu badan saya sendiri.
Dialog: 0,0:10:01.60,0:10:03.78, Lalai,,0,0,0,,Anda bercakap seperti seorang wanita tua yang degil.
Dialog: 0,0:10:03.81,0:10:06.87, Lalai,,0,0,0,,Pernahkah anda melihat saya makan segera atau makanan ringan?
Dialog: 0,0:10:06.89,0:10:08.16, Lalai,,0,0,0,,- Tidak.\N- Tepat.
Dialog: 0,0:10:08.19,0:10:09.93, Lalai,,0,0,0,,Saya tidak pernah minum soda sepanjang hidup saya.
Dialog: 0,0:10:09.95,0:10:14.04, Lalai,,0,0,0,,Adakah anda rasa saya seronok minum\Njus sayuran dan menonton apa yang saya makan?
Dialog: 0,0:10:14.07,0:10:17.81, Lalai,,0,0,0,,Saya bermeditasi pada waktu pagi dan\Nd yoga pada waktu malam untuk tekanan saya.
Dialog: 0,0:10:17.95,0:10:20.55, Lalai,,0,0,0,,Saya melihat pernafasan saya jika tiada\Ntiada penumpu oksigen.
Dialog: 0,0:10:20.57,0:10:24.51,Lalai,,0,0,0,,Saya telah cuba untuk kekal sihat\Nsejak saya dilahirkan.
Dialog: 0,0:10:24.54,0:10:26.07, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:10:27.71,0:10:29.41, Lalai,,0,0,0,,Bertenang.
Dialog: 0,0:10:30.63,0:10:33.69,Lalai,,0,0,0,,Malah orang yang membahayakan\Nbadan mereka dengan minum, merokok,
Dialog: 0,0:10:33.71,0:10:36.44, Lalai,,0,0,0,,makan apa sahaja yang mereka mahu,\Nand tidak kisah pernafasan mereka,
Dialog: 0,0:10:36.46,0:10:38.83, Lalai,,0,0,0,,tidak tertakluk kepada penyakit ini,
Dialog: 0,0:10:38.88,0:10:40.42, Lalai,,0,0,0,,jadi kenapa saya?
Dialog: 0,0:10:40.72,0:10:42.59,Lalai,,0,0,0,,Saya pun tak tahu.
Dialog: 0,0:10:42.93,0:10:44.28, Lalai,,0,0,0,, Baik.
Dialog: 0,0:10:44.31,0:10:47.55, Lalai,,0,0,0,,Saya faham saya sakit, tetapi kenapa mereka tidak boleh membetulkan saya?
Dialog: 0,0:10:47.60,0:10:49.91, Lalai,,0,0,0,,Orang ramai pergi ke bulan,\Kereta Nand memandu sendiri,
Dialog: 0,0:10:49.93,0:10:53.59, Lalai,,0,0,0,,tetapi mereka tidak boleh mengeluarkan tumor kecil di kepala saya?
Dialog: 0,0:10:54.27,0:10:56.18, Lalai,,0,0,0,,Itu menggelikan.
Dialog: 0,0:10:58.57,0:11:00.65, Lalai,,0,0,0,,Bagaimana pula...
Dialog: 0,0:11:01.03,0:11:05.82,Lalai,,0,0,0,,kita pergi hospital esok dan periksa semula?
Dialog: 0,0:11:06.08,0:11:07.55, Lalai,,0,0,0,,Untuk apa?
Dialog: 0,0:11:07.58,0:11:10.78, Lalai,,0,0,0,,Kita perlu pastikan. Apakah yang\NI lakukan jika ia adalah diagnosis yang salah?
Dialog: 0,0:11:14.04,0:11:17.12, Lalai,,0,0,0,,Apa yang anda lakukan jika ia adalah diagnosis yang salah?
Dialog: 0,0:11:18.05,0:11:20.21, Lalai,,0,0,0,,Saya akan gembira...
Dialog: 0,0:11:22.80,0:11:27.17,Lalai,,0,0,0,,Jadi mari kita pergi dan sahkan semula segala-galanya.
Dialog: 0,0:11:27.56,0:11:30.01, Lalai,,0,0,0,,Anda berada di tepi sekarang.
Dialog: 0,0:11:30.73,0:11:34.30,Lalai,,0,0,0,,Lupakan semuanya dan berehat...
Dialog: 0,0:11:34.65,0:11:36.77, Lalai,,0,0,0,,Adakah anda fikir saya boleh tidur?
Dialog: 0,0:11:36.98,0:11:38.68, Lalai,,0,0,0,, Betul.
Dialog: 0,0:11:40.32,0:11:42.60,Lalai,,0,0,0,,Saya juga terlalu terkejut.
Dialog: 0,0:11:43.11,0:11:45.73, Lalai,,0,0,0,,Saya tidak tahu sama ada saya boleh tidur malam ini.
Dialog: 0,0:12:28.66,0:12:31.19,Lalai,,0,0,0,,Rasanya berbeza...
Dialog: 0,0:12:32.66,0:12:34.91, Lalai,,0,0,0,,berbanding semalam.
Dialog: 0,0:12:46.34,0:12:49.55, Lalai,,0,0,0,, Berdengung? Betul ke? Adakah anda\Ningin dikebumikan bersamanya?
Dialog: 0,0:12:50.01,0:12:51.72,Lalai,,0,0,0,,Saya sedih.
Dialog: 0,0:12:54.31,0:12:55.50,Lalai,,0,0,0,,Kita akan berpisah.
Dialog: 0,0:12:55.52,0:13:00.64,Lalai,,0,0,0,,Kami akan berpisah dalam masa tiga\Nbulan walaupun tanpa perceraian.
Dialog: 0,0:13:04.90,0:13:06.61, Lalai,,0,0,0,,No.
Dialog: 0,0:13:08.45,0:13:10.57, Lalai,,0,0,0,,Jangan senyum.
Dialog: 0,0:13:12.70,0:13:14.45, Lalai,,0,0,0,,Turun ke bawah.
Dialog: 0,0:13:21.13,0:13:22.83, Lalai,,0,0,0,, Hae-in?
Dialog: 0,0:13:26.30,0:13:29.67, Lalai,,0,0,0,,Tunggu. Dia tidak pernah tidur.
Dialog: 0,0:13:31.31,0:13:32.88, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:13:42.36,0:13:43.89, Lalai,,0,0,0,,Hei.
Dialog: 0,0:13:47.57,0:13:50.02, Lalai,,0,0,0,,Sudah pukul 7 pagi.
Dialog: 0,0:14:45.88,0:14:47.91,Lalai,,0,0,0,,Apa?
Dialog: 0,0:14:48.09,0:14:49.87, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:15:07.82,0:15:11.61, Lalai,,0,0,0,,Anda mesti berada dalam mood yang baik untuk mengatakannya.
Dialog: 0,0:15:13.32,0:15:15.32,Lalai,,0,0,0,,Malah kulit anda kelihatan lebih baik.
Dialog: 0,0:15:16.04,0:15:17.30, Lalai,,0,0,0,,Anda mesti tidur lena.
Dialog: 0,0:15:17.33,0:15:20.11, Lalai,,0,0,0,,Saya melambung dan berpusing sepanjang malam.
Dialog: 0,0:15:23.92,0:15:25.45,Lalai,,0,0,0,,Saya?
Dialog: 0,0:15:26.34,0:15:28.25, Lalai,,0,0,0,, Kulit saya?
Dialog: 0,0:15:28.63,0:15:30.23, Lalai,,0,0,0,,Anda silap.
Dialog: 0,0:15:30.26,0:15:33.21, Lalai,,0,0,0,,Tidak, itu tidak boleh.
Dialog: 0,0:16:01.91,0:16:04.23, Lalai,,0,0,0,,Izinkan saya memberi amaran kepada anda.
Dialog: 0,0:16:04.25,0:16:06.06,Lalai,,0,0,0,,Anda sahaja yang tahu tentang perkara ini,
Dialog: 0,0:16:06.09,0:16:08.62,Lalai,,0,0,0,,jadi jika sesiapa tahu, itu salah anda.
Dialog: 0,0:16:09.67,0:16:11.25, Lalai,,0,0,0,,Saya faham,
Dialog: 0,0:16:11.38,0:16:13.90,Lalai,,0,0,0,,tetapi adakah anda akan merahsiakan perkara ini selama-lamanya?
Dialog: 0,0:16:13.93,0:16:15.59,Lalai,,0,0,0,,Ya.
Dialog: 0,0:16:16.01,0:16:17.91,Lalai,,0,0,0,,Bukankah keluarga anda tahu?
Dialog: 0,0:16:17.93,0:16:20.37, Lalai,,0,0,0,,Sudah tentu tidak. Mereka sepatutnya\N menjadi orang terakhir yang tahu.
Dialog: 0,0:16:20.39,0:16:22.08, Lalai,,0,0,0,,Tetapi saya rasa...
Dialog: 0,0:16:22.10,0:16:26.29,Lalai,,0,0,0,,Saya sangat hampir untuk menyertai One Billion Club.
Dialog: 0,0:16:26.31,0:16:29.42,Lalai,,0,0,0,,Anda tahu apa yang Datuk katakan\Napabila dia memberi saya kedai serbaneka.
Dialog: 0,0:16:29.44,0:16:31.75,Lalai,,0,0,0,,"Saya akan pilih awak berbanding ayah awak..."
Dialog: 0,0:16:31.78,0:16:35.11, Lalai,,0,0,0,,"jika anda memperoleh jualan melebihi $1 bilion."
Dialog: 0,0:16:37.12,0:16:40.65, Lalai,,0,0,0,,Anda mahu saya merosakkannya, apabila saya sedekat ini?
Dialog: 0,0:16:41.37,0:16:43.10, Lalai,,0,0,0,,Itulah sebabnya anda tidak akan memberitahu mereka?
Dialog: 0,0:16:43.12,0:16:45.68,Lalai,,0,0,0,,Hong Soo-cheol ialah\Njenis yang memanggil doktor saya...
Dialog: 0,0:16:45.71,0:16:48.60, Lalai,,0,0,0,,untuk mengesahkan sama ada saya benar-benar diserang selesema.
Dialog: 0,0:16:48.63,0:16:51.83, Lalai,,0,0,0,,Adakah anda fikir ibu saya akan berbeza?
Dialog: 0,0:16:52.01,0:16:54.53,Lalai,,0,0,0,,Jika mereka mengetahui tentang penyakit saya,
Dialog: 0,0:16:54.55,0:16:57.03, Lalai,,0,0,0,,Saya akan dihalau keluar dari rumah.
Dialog: 0,0:16:57.05,0:17:01.17,Lalai,,0,0,0,,Mereka akan berebut siapa yang akan mendapatkan aset saya.
Dialog: 0,0:17:05.56,0:17:07.66, Lalai,,0,0,0,,Saya tidak akan membenarkan itu.
Dialog: 0,0:17:07.69,0:17:09.72, Lalai,,0,0,0,, Atas mayat saya.
Dialog: 0,0:17:25.62,0:17:29.39,Lalai,,0,0,0,,Mengapa anda rasa Datuk mahu\Njumpa saya sebelum bersarapan?
Dialog: 0,0:17:29.42,0:17:31.90,Lalai,,0,0,0,,Adakah dia mahu memberi saya\Dekat dan menyelesaikannya dengan...
Dialog: 0,0:17:31.92,0:17:32.98, Lalai,,0,0,0,,sebelum bersarapan?
Dialog: 0,0:17:33.01,0:17:35.21, Lalai,,0,0,0,,Ada idea mengapa dia mahu berjumpa dengan anda?
Dialog: 0,0:17:36.09,0:17:37.24, Lalai,,0,0,0,,Mungkin ini tentang...
Dialog: 0,0:17:37.26,0:17:39.86, Lalai,,0,0,0,,bagaimana saya ingin melancarkan\jenama kopi Norganic New York itu.
Dialog: 0,0:17:39.89,0:17:42.82, Lalai,,0,0,0,,Yang anda yakin untuk dilancarkan?
Dialog: 0,0:17:42.85,0:17:44.74,Lalai,,0,0,0,,Ya, tetapi saya silap.
Dialog: 0,0:17:44.77,0:17:49.72,Lalai,,0,0,0,,Orang-orang bajingan itu meletakkan satu pada saya,\Nand memutuskan untuk bekerja dengan Yeom Sang-jin.
Dialog: 0,0:17:50.65,0:17:53.93,Lalai,,0,0,0,,Mengapa dunia ini penuh dengan bajingan yang tidak bermoral?
Dialog: 0,0:17:56.20,0:17:57.76,Lalai,,0,0,0,,Adakah anda rasa Atuk tahu?
Dialog: 0,0:17:57.78,0:17:59.84, Lalai,,0,0,0,,Malah saya baru tahu.
Dialog: 0,0:17:59.87,0:18:02.22,Lalai,,0,0,0,,Risiko diperlukan untuk menjalankan perniagaan.
Dialog: 0,0:18:02.24,0:18:06.11, Lalai,,0,0,0,,Jangan takut. Hanya {\i1}force\Nmajeure{\i0} yang menyebabkan perjanjian itu gagal.
Dialog: 0,0:18:06.16,0:18:09.06, Lalai,,0,0,0,,Ya, anda betul. Ia hanya {\i1}paksa...{\i0}
Dialog: 0,0:18:09.08,0:18:13.19,Lalai,,0,0,0,,Perjanjian itu hanya gagal kerana {\i1}force majeure,{\i0}
Dialog: 0,0:18:13.21,0:18:16.04,Lalai,,0,0,0,,tetapi saya masih bimbang dia akan marah.
Dialog: 0,0:18:17.26,0:18:20.17,Lalai,,0,0,0,,Dia datuk kamu, bukan Syaitan.
Dialog: 0,0:18:20.55,0:18:22.71, Lalai,,0,0,0,, Yakin dan beritahu dia.
Dialog: 0,0:18:24.35,0:18:26.13, Lalai,,0,0,0,,- Saya patut, kan?\N- Ya.
Dialog: 0,0:18:30.60,0:18:32.89,Lalai,,0,0,0,,{\i1}Bagaimanakah anda tidak cekap?!{\i0}
Dialog: 0,0:18:33.48,0:18:35.89,Lalai,,0,0,0,,Atuk, perjanjian ini hanya gagal...
Dialog: 0,0:18:36.03,0:18:38.00,Lalai,,0,0,0,,disebabkan {\i1}force majeure...{\i0}
Dialog: 0,0:18:38.03,0:18:40.61,Lalai,,0,0,0,,Apa? Perjanjian gagal?
Dialog: 0,0:18:41.28,0:18:44.01, Lalai,,0,0,0,,Perjanjian apa yang anda cakapkan?
Dialog: 0,0:18:44.03,0:18:46.01, Lalai,,0,0,0,,Pelancaran kopi organik New York.
Dialog: 0,0:18:46.04,0:18:47.35, Lalai,,0,0,0,,Bukankah itu maksudnya?
Dialog: 0,0:18:47.37,0:18:49.39,Lalai,,0,0,0,,Saya bercakap tentang bagaimana...
Dialog: 0,0:18:49.41,0:18:52.77, Lalai,,0,0,0,,anda terlebih bayar $8 juta...
Dialog: 0,0:18:52.79,0:18:54.91, Lalai,,0,0,0,,dalam cukai korporat!
Dialog: 0,0:18:55.13,0:18:56.65, Lalai,,0,0,0,,- Apa?\N- Pasukan guaman Hyun-woo...
Dialog: 0,0:18:56.67,0:19:00.63, Lalai,,0,0,0,, mengetahui tentangnya dan akan\Nfailkan tuntutan pembetulan.
Dialog: 0,0:19:00.97,0:19:04.96, Lalai,,0,0,0,,Wang itu akan habis\Nlongkang jika bukan kerana dia!
Dialog: 0,0:19:05.10,0:19:06.41,Lalai,,0,0,0,,Bukankah abang ipar kamu...
Dialog: 0,0:19:06.43,0:19:08.24, Lalai,,0,0,0,,pengarah kewangan?
Dialog: 0,0:19:08.27,0:19:09.66, Lalai,,0,0,0,,- Pecat dia seketika!\N- Tapi...
Dialog: 0,0:19:09.68,0:19:12.29,Lalai,,0,0,0,,Selain itu, anda begitu yakin...
Dialog: 0,0:19:12.31,0:19:15.33, Lalai,,0,0,0,,tentang perjanjian kopi itu. Adakah\N itu masuk ke dalam longkang juga?
Dialog: 0,0:19:15.36,0:19:17.35,Lalai,,0,0,0,,- Tidak...\N- Jawab saya!
Dialog: 0,0:19:17.57,0:19:21.59, Lalai,,0,0,0,,Mengapa anda tidak boleh melakukan apa-apa dengan betul?
Dialog: 0,0:19:21.61,0:19:24.69,Lalai,,0,0,0,,Awak tak belajar apa-apa dari Hae-in?
Dialog: 0,0:19:24.78,0:19:26.43, Lalai,,0,0,0,,- Bukan?\N- Awak nampak...
Dialog: 0,0:19:26.45,0:19:28.39, Lalai,,0,0,0,,Katakan sesuatu, bodoh!
Dialog: 0,0:19:28.41,0:19:29.47, Lalai,,0,0,0,,Cakap, bajingan!
Dialog: 0,0:19:29.50,0:19:31.22,Lalai,,0,0,0,,Gunakan mulut anda itu!
Dialog: 0,0:19:31.25,0:19:32.93,Lalai,,0,0,0,,- Saya...\N- Jawab saya, bodoh!
Dialog: 0,0:19:32.96,0:19:35.19,Default,,0,0,0,,Saya nak balas, tapi tak boleh...
Dialog: 0,0:19:35.21,0:19:36.19, Lalai,,0,0,0,, Kemudian cakap!
Dialog: 0,0:19:36.21,0:19:38.58, Lalai,,0,0,0,,Saya tidak boleh bernafas.
Dialog: 0,0:19:41.09,0:19:43.03, Lalai,,0,0,0,,Apa?
Dialog: 0,0:19:43.05,0:19:44.92,Lalai,,0,0,0,,Bangun!
Dialog: 0,0:19:52.48,0:19:55.72,Lalai,,0,0,0,,Doktor Jeong rasa dia mengalami gangguan panik.
Dialog: 0,0:19:57.82,0:19:59.21,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:19:59.23,0:20:01.88,Lalai,,0,0,0,,Kamu pasti sangat tertekan\Tidak oleh datuk kamu...
Dialog: 0,0:20:01.90,0:20:03.51, Lalai,,0,0,0,,Ini salah Hyun-woo.
Dialog: 0,0:20:03.53,0:20:07.65, Lalai,,0,0,0,,Mengapa dia pandai dalam kerjanya?
Dialog: 0,0:20:08.91,0:20:10.22,Lalai,,0,0,0,,Maafkan saya, Ibu.
Dialog: 0,0:20:10.25,0:20:12.77,Lalai,,0,0,0,,Ini salah abang saya.
Dialog: 0,0:20:12.79,0:20:14.02, Lalai,,0,0,0,,Sayang, itu mengarut.
Dialog: 0,0:20:14.04,0:20:16.69,Lalai,,0,0,0,,Abang kamu bekerja keras\Nand baru sahaja melakukan kesilapan.
Dialog: 0,0:20:16.71,0:20:19.27, Lalai,,0,0,0,,$8 juta tidaklah begitu serius.
Dialog: 0,0:20:19.30,0:20:21.40, Lalai,,0,0,0,,$8 juta?
Dialog: 0,0:20:21.42,0:20:25.67, Lalai,,0,0,0,,Adakah ini semua hanya kerana $8 juta?
Dialog: 0,0:20:26.51,0:20:28.16, Lalai,,0,0,0,,Di mana Hyun-woo?
Dialog: 0,0:20:28.18,0:20:30.63, Lalai,,0,0,0,,Saya benar-benar minta maaf,
Dialog: 0,0:20:31.60,0:20:33.80, Lalai,,0,0,0,,tetapi hasilnya adalah sama.
Dialog: 0,0:20:34.69,0:20:38.25, Lalai,,0,0,0,,Adakah anda maksudkan dia benar-benar mempunyai baki tiga bulan lagi?
Dialog: 0,0:20:38.27,0:20:41.14, Lalai,,0,0,0,,- Tepat tiga bulan?\N- Saya tidak boleh katakan.
Dialog: 0,0:20:41.49,0:20:43.71, Lalai,,0,0,0,,Itu jawapan yang tidak bertanggungjawab.
Dialog: 0,0:20:43.74,0:20:46.05, Lalai,,0,0,0,,Anda telah menjadi pakar neurologi selama 30 tahun.
Dialog: 0,0:20:46.07,0:20:49.93, Lalai,,0,0,0,,Sila tepat dengan peratusan.\NSila berikan kami nombor yang tepat.
Dialog: 0,0:20:49.95,0:20:52.15, Lalai,,0,0,0,,Cukuplah. jom pergi.
Dialog: 0,0:20:52.29,0:20:54.82, Lalai,,0,0,0,,Tidak, Hae-in. Saya perlu mendengar ini.
Dialog: 0,0:20:56.38,0:20:59.54, Lalai,,0,0,0,,Baik, kemudian. Saya akan pergi sekarang.
Dialog: 0,0:21:05.76,0:21:07.46, Lalai,,0,0,0,,Tuan.
Dialog: 0,0:21:08.14,0:21:10.53, Lalai,,0,0,0,,Saya amat menghargainya jika anda boleh tepat.
Dialog: 0,0:21:10.56,0:21:13.47, Lalai,,0,0,0,,Hidup saya dalam talian di sini.
Dialog: 0,0:21:40.96,0:21:42.87, Lalai,,0,0,0,,Ini mengarut.
Dialog: 0,0:21:43.51,0:21:45.21, Lalai,,0,0,0,,Saya berbeza.
Dialog: 0,0:21:52.51,0:21:53.49, Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:21:53.52,0:21:56.29,Lalai,,0,0,0,,Mengapa Hyun-woo tidak mengambilnya?\NI ada di pejabatnya?
Dialog: 0,0:21:56.31,0:21:57.95, Lalai,,0,0,0,,Saya tanya kenapa awak ada di sini.
Dialog: 0,0:21:57.98,0:22:00.71, Lalai,,0,0,0,,Jadi bagaimana jika Soo-cheol\Tidak membayar beberapa juta dolar?
Dialog: 0,0:22:00.73,0:22:04.13, Lalai,,0,0,0,,Hyun-woo boleh menguruskannya dengan senyap.
Dialog: 0,0:22:04.15,0:22:05.98, Lalai,,0,0,0,,Datuk awak marah dengan Soo-cheol.
Dialog: 0,0:22:06.00,0:22:08.67,Lalai,,0,0,0,,Dia pasti tahu entah bagaimana.\NHyun-woo tidak akan berbuat demikian.
Dialog: 0,0:22:08.70,0:22:10.43, Lalai,,0,0,0,,Awak ambil saya untuk apa?
Dialog: 0,0:22:10.45,0:22:13.07, Lalai,,0,0,0,,Saya tahu anda berada di belakangnya.
Dialog: 0,0:22:13.91,0:22:16.82, Lalai,,0,0,0,,Saya tiada masa untuk itu. saya...
Dialog: 0,0:22:18.00,0:22:19.93, Lalai,,0,0,0,,sedikit terganggu oleh perkara yang serius.
Dialog: 0,0:22:19.96,0:22:21.83, Lalai,,0,0,0,,Soo-cheol mempunyai...
Dialog: 0,0:22:23.17,0:22:24.95, Lalai,,0,0,0,,serangan panik hari ini.
Dialog: 0,0:22:26.01,0:22:27.71, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:22:30.97,0:22:33.22, Lalai,,0,0,0,,Anda pasti terkejut.
Dialog: 0,0:22:34.97,0:22:36.67,Lalai,,0,0,0,,Tetapi Ibu,
Dialog: 0,0:22:36.73,0:22:40.80,Lalai,,0,0,0,,Saya baru sahaja memberitahu anda bahawa\NI juga mempunyai perkara yang serius.
Dialog: 0,0:22:41.73,0:22:43.60,Lalai,,0,0,0,,Awak tidak ingin tahu?
Dialog: 0,0:22:44.40,0:22:48.56, Lalai,,0,0,0,,Anda sentiasa tahu apa yang perlu dilakukan,\Nsama ada ia besar atau kecil.
Dialog: 0,0:22:50.07,0:22:51.77, Lalai,,0,0,0,, Betul.
Dialog: 0,0:22:52.28,0:22:54.28, Lalai,,0,0,0,,Saya akan jaga...
Dialog: 0,0:22:54.53,0:22:55.68, Lalai,,0,0,0,, perniagaan saya.
Dialog: 0,0:22:55.70,0:22:57.51, Lalai,,0,0,0,,Anda patut pergi. Ini adalah tempat kerja saya.
Dialog: 0,0:22:57.54,0:22:59.35, Lalai,,0,0,0,,Hei, jangan kisah saya.
Dialog: 0,0:22:59.37,0:23:01.74,Lalai,,0,0,0,,Saya di sini untuk berjumpa Hyun-woo, bagaimanapun.
Dialog: 0,0:23:02.17,0:23:04.20,Lalai,,0,0,0,,Berhenti memprovokasi kami,
Dialog: 0,0:23:04.50,0:23:07.27, Lalai,,0,0,0,, atau saya akan menyeksa anak awak sehingga hari saya mati,
Dialog: 0,0:23:07.30,0:23:11.40, Lalai,,0,0,0,, tidak kira betapa sibuk atau terganggu saya.
Dialog: 0,0:23:11.43,0:23:14.55,Lalai,,0,0,0,,- Apa?\N- Saya akan seksa dia selama-lamanya.
Dialog: 0,0:23:15.10,0:23:16.66, Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,0:23:16.68,0:23:19.34, Lalai,,0,0,0,,Adakah anda fikir saya hanya duduk dan menonton?
Dialog: 0,0:23:19.56,0:23:21.26, Lalai,,0,0,0,, Teruskan.
Dialog: 0,0:23:35.03,0:23:36.55,Lalai,,0,0,0,,Kenapa awak nak makan di sini?
Dialog: 0,0:23:36.58,0:23:39.43,Lalai,,0,0,0,,Hei, saya rasa tidak selamat pun dalam\bilik mesyuarat firma guaman Nour.
Dialog: 0,0:23:39.45,0:23:43.12,Lalai,,0,0,0,,Tempat awam seperti ini terasa lebih selamat.
Dialog: 0,0:23:43.25,0:23:44.91, Lalai,,0,0,0,,Kenapa begitu?
Dialog: 0,0:23:46.17,0:23:51.17, Lalai,,0,0,0,, Kerana saya mempertaruhkan\N nyawa saya untuk menentang Queens.
Dialog: 0,0:23:52.13,0:23:53.88, Lalai,,0,0,0,,Mengapa anda?
Dialog: 0,0:23:54.97,0:23:58.32,Lalai,,0,0,0,,Saya berfikir panjang selepas melihat awak menangis.
Dialog: 0,0:23:58.35,0:24:00.80, Lalai,,0,0,0,,Saya akan bantu anda. Mari bercerai!
Dialog: 0,0:24:05.44,0:24:08.93, Lalai,,0,0,0,,- Mengenai itu...\N- Ini bukan keputusan yang mudah.
Dialog: 0,0:24:09.03,0:24:10.84, Lalai,,0,0,0,,Saya mempertaruhkan pekerjaan saya.
Dialog: 0,0:24:10.86,0:24:13.40, Lalai,,0,0,0,,Baiklah, tetapi jangan lakukannya.
Dialog: 0,0:24:13.45,0:24:14.98, Lalai,,0,0,0,,Kenapa tidak?
Dialog: 0,0:24:17.24,0:24:19.40,Lalai,,0,0,0,,Saya tidak akan bercerai.
Dialog: 0,0:24:20.45,0:24:24.37, Lalai,,0,0,0,,Tidak? Hei, bukankah anda memberitahu\N saya ia terlalu sukar ditanggung?
Dialog: 0,0:24:24.58,0:24:25.69,Lalai,,0,0,0,,Nah...
Dialog: 0,0:24:25.71,0:24:28.87,Lalai,,0,0,0,,Saya berkata demikian kerana saya tidak nampak penghujungnya,
Dialog: 0,0:24:29.25,0:24:33.12, Lalai,,0,0,0,,tetapi sekarang saya nampak satu,
Dialog: 0,0:24:33.97,0:24:35.28,Lalai,,0,0,0,,Saya rasa saya boleh tahan.
Dialog: 0,0:24:35.30,0:24:37.59, Lalai,,0,0,0,,Apa maksud anda? penghujung apa?
Dialog: 0,0:24:38.72,0:24:40.41,Lalai,,0,0,0,,Nah...
Dialog: 0,0:24:40.43,0:24:43.41,Lalai,,0,0,0,,Tuhan memberi saya perpisahan yang selamat.
Dialog: 0,0:24:43.44,0:24:45.16,Lalai,,0,0,0,,Sebut sahaja.
Dialog: 0,0:24:45.19,0:24:47.60, Lalai,,0,0,0,, Jelaskan dalam istilah orang biasa.
Dialog: 0,0:25:01.62,0:25:05.32,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Datang ke Hangang Jamwon\NParking Lot Bahagian Satu dalam masa setengah jam.{\c}{\i0}
Dialog: 0,0:25:22.47,0:25:24.34, Lalai,,0,0,0,,Apa yang sedang kita lakukan?
Dialog: 0,0:25:24.43,0:25:27.60,Lalai,,0,0,0,,Apa yang saya akan beritahu anda adalah sulit,
Dialog: 0,0:25:28.40,0:25:31.13,Lalai,,0,0,0,,- jadi kalau sesiapa tahu, itu salah awak.\N- Ayuh.
Dialog: 0,0:25:31.15,0:25:33.39, Lalai,,0,0,0,,Mengenai apa ini?
Dialog: 0,0:25:49.33,0:25:50.81,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:25:50.84,0:25:53.48,Lalai,,0,0,0,,Dia memberitahu saya semasa saya hendak memberikan surat cerai kepadanya,
Dialog: 0,0:25:53.51,0:25:55.83, Lalai,,0,0,0,,bahawa dia mempunyai baki tiga bulan lagi.
Dialog: 0,0:25:56.42,0:25:59.00,Lalai,,0,0,0,,Saya berjumpa dengan doktornya hari ini juga.
Dialog: 0,0:25:59.34,0:26:00.88, Lalai,,0,0,0,,Aduh, Hyun-woo.
Dialog: 0,0:26:02.18,0:26:03.74, Lalai,,0,0,0,,Hei.
Dialog: 0,0:26:03.77,0:26:06.37, Lalai,,0,0,0,,Ini gila. Apa yang patut saya katakan?
Dialog: 0,0:26:06.39,0:26:08.04, Lalai,,0,0,0,,Pertama...
Dialog: 0,0:26:08.06,0:26:10.62,Lalai,,0,0,0,,- Mari berjabat tangan.\N- Jangan.
Dialog: 0,0:26:10.65,0:26:12.88,Lalai,,0,0,0,,Betul, anda tidak sepatutnya menunjukkan kegembiraan anda.
Dialog: 0,0:26:12.90,0:26:15.00, Lalai,,0,0,0,,Biar saya jadi bajingan,
Dialog: 0,0:26:15.03,0:26:17.92, Lalai,,0,0,0,,jadi Lady Luck menyebelahi anda.
Dialog: 0,0:26:17.95,0:26:20.97,Lalai,,0,0,0,,Anda akan meninggalkannya tanpa\Nama satu sen pun...
Dialog: 0,0:26:20.99,0:26:22.30, Lalai,,0,0,0,, jika anda telah bercerai.
Dialog: 0,0:26:22.33,0:26:24.30, Lalai,,0,0,0,,Beberapa saat itu menyelamatkan anda.
Dialog: 0,0:26:24.33,0:26:28.28,Lalai,,0,0,0,,Apa? Adakah ini bermakna anda akan mengambil alih Queens?
Dialog: 0,0:26:29.54,0:26:31.24,Lalai,,0,0,0,,Adakah anda fikir...
Dialog: 0,0:26:32.09,0:26:34.31, Lalai,,0,0,0,,- mereka sebodoh itu?\N- Apa maksud awak?
Dialog: 0,0:26:34.34,0:26:36.23, Lalai,,0,0,0,,Adakah dia menandatangani pranikah atau sesuatu?
Dialog: 0,0:26:36.26,0:26:37.90, Lalai,,0,0,0,,Tentang tidak membahagikan asetnya?
Dialog: 0,0:26:37.92,0:26:40.03, Lalai,,0,0,0,, Anda tahu ia tidak akan menjadi masalah apabila anda memfailkan saman,
Dialog: 0,0:26:40.05,0:26:41.74, Lalai,,0,0,0,,melainkan dia menulisnya dalam wasiatnya.
Dialog: 0,0:26:41.76,0:26:44.51, Lalai,,0,0,0,,Ya, dia menulisnya...
Dialog: 0,0:26:44.89,0:26:46.12,Lalai,,0,0,0,,dalam kehendaknya.
Dialog: 0,0:26:46.14,0:26:47.68, Lalai,,0,0,0,, Serius?
Dialog: 0,0:26:48.98,0:26:50.68, Lalai,,0,0,0,,Ya.
Dialog: 0,0:26:50.85,0:26:53.31,Lalai,,0,0,0,,Ia berlaku sebelum kami berkahwin.
Dialog: 0,0:26:53.57,0:26:55.79,Lalai,,0,0,0,,Dia enggan memberikan apa-apa kepada saya,
Dialog: 0,0:26:55.82,0:26:58.84, Lalai,,0,0,0,, malah mendapat wasiat dinotari...
Dialog: 0,0:26:58.86,0:27:00.56,Lalai,,0,0,0,,sebelum kita berkahwin.
Dialog: 0,0:27:00.91,0:27:03.09, Lalai,,0,0,0,, Konglomerat pasti berbeza.
Dialog: 0,0:27:03.12,0:27:04.64, Lalai,,0,0,0,,Ia sangat teliti.
Dialog: 0,0:27:04.66,0:27:06.44, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:27:06.62,0:27:08.72,Lalai,,0,0,0,,Saya hanya gembira...
Dialog: 0,0:27:08.75,0:27:13.45, Lalai,,0,0,0,,bahawa saya boleh melarikan diri daripadanya\Nselamat dan sihat dalam masa tiga bulan.
Dialog: 0,0:27:15.50,0:27:18.44, Lalai,,0,0,0,,Tetapi fikirkan tentang perkara ini.
Dialog: 0,0:27:18.47,0:27:24.00, Lalai,,0,0,0,,Mengapa Tuhan memberi kamu tiga bulan itu?
Dialog: 0,0:27:24.14,0:27:25.84, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:27:26.89,0:27:27.95, Lalai,,0,0,0,,Peguam Baek.
Dialog: 0,0:27:27.97,0:27:30.12,Lalai,,0,0,0,,Mari kita bercakap secara profesional.
Dialog: 0,0:27:30.14,0:27:33.37, Lalai,,0,0,0,,Anda tahu dia bebas untuk menyemak\Nnya kehendak dalam tiga bulan itu.
Dialog: 0,0:27:33.40,0:27:36.08,Lalai,,0,0,0,,Anda hanya perlu memenanginya\Tidak pernah dalam tiga bulan akan datang,
Dialog: 0,0:27:36.11,0:27:38.96, Lalai,,0,0,0,,jadi dia akan berfikir, "Astaga,\Ndia pasti sangat mencintai saya."
Dialog: 0,0:27:38.99,0:27:44.73, Lalai,,0,0,0,,"Saya harus menyerahkan kekasih saya\NQueens Department Store sebelum saya mati."
Dialog: 0,0:27:47.08,0:27:48.14, Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:27:48.16,0:27:51.22,Lalai,,0,0,0,,Tiga bulan tiada apa-apa selepas\N berkhidmat dua tahun dalam tentera.
Dialog: 0,0:27:51.25,0:27:52.85, Lalai,,0,0,0,, Pertimbangkan itu dan ia akan menjadi lebih mudah.
Dialog: 0,0:27:52.87,0:27:55.33,Lalai,,0,0,0,,Letakkan hati dan jiwa anda...
Dialog: 0,0:27:55.54,0:27:57.24,Lalai,,0,0,0,,untuk mencintainya.
Dialog: 0,0:28:01.80,0:28:03.58,Lalai,,0,0,0,,Anda.
Dialog: 0,0:28:04.39,0:28:06.92,Lalai,,0,0,0,,Adakah anda serius berfikir...
Dialog: 0,0:28:09.02,0:28:10.93,Lalai,,0,0,0,,Saya begitu materialistik?
Dialog: 0,0:28:20.03,0:28:21.42, Lalai,,0,0,0,,Untuk apa itu?
Dialog: 0,0:28:21.44,0:28:24.01, Lalai,,0,0,0,,Hari ini ulang tahun perkahwinan kami.
Dialog: 0,0:28:24.06,0:28:25.09, Lalai,,0,0,0,,Jadi?
Dialog: 0,0:28:25.12,0:28:27.80,Lalai,,0,0,0,,Saya telah membuat tempahan dan\Nmenyediakan kejutan dua tahun lalu,
Dialog: 0,0:28:27.83,0:28:30.85, Lalai,,0,0,0,,tetapi anda sangat kecewa dan\Nmemberitahu saya untuk tidak membuat adegan.
Dialog: 0,0:28:30.87,0:28:33.14, Lalai,,0,0,0,,- Jadi?\N- Jadi saya tidak menyediakan apa-apa tahun lepas,
Dialog: 0,0:28:33.16,0:28:35.30,Lalai,,0,0,0,,tetapi anda masih marah\Nbahawa saya sebenarnya mendengar,
Dialog: 0,0:28:35.32,0:28:38.08, Lalai,,0,0,0,, dan bertanya sama ada saya akan mati jika anda menyuruh saya.
Dialog: 0,0:28:38.13,0:28:40.52, Lalai,,0,0,0,,Adakah anda di sini untuk membicarakan ketidakkonsistenan saya?
Dialog: 0,0:28:40.55,0:28:42.96, Lalai,,0,0,0,,Tidak, sudah tentu tidak.
Dialog: 0,0:28:44.38,0:28:47.11, Lalai,,0,0,0,,Orang jenis apakah yang membawa bunga kepada nitpick?
Dialog: 0,0:28:47.14,0:28:50.28,Lalai,,0,0,0,,Perkahwinan kita pernah begitu indah sehingga kamu membawa bunga...
Dialog: 0,0:28:50.31,0:28:51.97, Lalai,,0,0,0,, pada ulang tahun kita?
Dialog: 0,0:28:53.64,0:28:55.34, Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,0:28:55.48,0:28:57.51,Lalai,,0,0,0,,Saya tidak boleh mengatakan ya untuk itu,
Dialog: 0,0:28:57.81,0:29:01.43, Lalai,,0,0,0,,tetapi kita sentiasa boleh menjadikannya indah, bukan?
Dialog: 0,0:29:04.86,0:29:06.56,Lalai,,0,0,0,,Senang...
Dialog: 0,0:29:11.04,0:29:12.99, Lalai,,0,0,0,,ulang tahun perkahwinan.
Dialog: 0,0:29:31.14,0:29:33.30, Lalai,,0,0,0,, Bawa saya pasu.
Dialog: 0,0:29:34.14,0:29:35.79,Lalai,,0,0,0,,{\i1}Bagaimana keadaannya?{\i0}
Dialog: 0,0:29:35.81,0:29:38.87, Lalai,,0,0,0,,Adakah mereka bergaduh atau sebagainya?
Dialog: 0,0:29:38.90,0:29:41.46, Lalai,,0,0,0,,Tidak, mereka tidak. Sebaliknya...
Dialog: 0,0:29:41.48,0:29:44.19,Lalai,,0,0,0,,- "Sebaliknya"?\N- Mereka semakin hampir.
Dialog: 0,0:29:44.49,0:29:46.38, Lalai,,0,0,0,,- "Lebih Dekat"?\N- Ya.
Dialog: 0,0:29:46.40,0:29:50.32, Lalai,,0,0,0,,{\i1}Dia sangat menjaganya.\NISangat berbeza dengan dia.{\i0}
Dialog: 0,0:29:51.58,0:29:54.57, Lalai,,0,0,0,,Adakah jadual ini sentiasa untuk sepuluh?
Dialog: 0,0:29:55.75,0:29:57.53, Lalai,,0,0,0,, Dua Belas.
Dialog: 0,0:30:06.26,0:30:08.54,Lalai,,0,0,0,,Selalunya hanya kami berdua,
Dialog: 0,0:30:11.93,0:30:13.84, Lalai,,0,0,0,,tetapi kami duduk berjauhan.
Dialog: 0,0:30:17.23,0:30:18.41, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:30:18.44,0:30:20.14, Lalai,,0,0,0,,Saya akan...
Dialog: 0,0:30:21.56,0:30:23.68, Lalai,,0,0,0,, duduk di sini.
Dialog: 0,0:30:52.97,0:30:57.41, Lalai,,0,0,0,,Terdapat terlalu banyak kontra dalam kontrak.
Dialog: 0,0:30:57.43,0:31:00.12, Lalai,,0,0,0,,Kami perlu menyediakan yuran pengubahsuaian kedai.
Dialog: 0,0:31:00.14,0:31:03.50,Lalai,,0,0,0,,Saya tidak fikir ia adalah satu kerugian besar di pihak kami,
Dialog: 0,0:31:03.52,0:31:05.54,Lalai,,0,0,0,,memandangkan populariti jenama.
Dialog: 0,0:31:05.57,0:31:08.92, Lalai,,0,0,0,,Betul, tetapi ia tidak diperlukan\Nuntuk tinggal untuk jangka masa tertentu.
Dialog: 0,0:31:08.95,0:31:11.01, Lalai,,0,0,0,, Katakan kita membelanjakan $5 juta...
Dialog: 0,0:31:11.03,0:31:12.84, Lalai,,0,0,0,,untuk membawa mereka masuk.
Dialog: 0,0:31:12.87,0:31:15.72,Lalai,,0,0,0,,Kami tiada hak untuk menghalang mereka\Jika mereka mahu pergi selepas setahun.
Dialog: 0,0:31:15.74,0:31:18.89,Lalai,,0,0,0,,Kami juga dikehendaki membayar\Na penalti jika mereka mengetahui...
Dialog: 0,0:31:18.91,0:31:22.12,Lalai,,0,0,0,,orang menjual produk tiruan.
Dialog: 0,0:31:25.71,0:31:27.37,Lalai,,0,0,0,,Awak okey?
Dialog: 0,0:31:29.38,0:31:30.61, Lalai,,0,0,0,, Tunggu. saya okay...
Dialog: 0,0:31:30.63,0:31:32.42, Lalai,,0,0,0,,Jangan bercakap. biar saya.
Dialog: 0,0:31:32.47,0:31:35.00, Lalai,,0,0,0,,- Sila hubungi ambulans.\N- Maaf?
Dialog: 0,0:31:36.89,0:31:37.87, Lalai,,0,0,0,,Saya tidak apa-apa.
Dialog: 0,0:31:37.89,0:31:39.88, Lalai,,0,0,0,,Adakah anda benar-benar?
Dialog: 0,0:31:40.60,0:31:42.80, Lalai,,0,0,0,,Saya baru tercekik air.
Dialog: 0,0:31:45.27,0:31:46.75, Lalai,,0,0,0,,- Betulkah?\N- Ya.
Dialog: 0,0:31:46.77,0:31:48.48,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:31:48.61,0:31:50.48, Lalai,,0,0,0,,Bolehkah kita menyambung semula?
Dialog: 0,0:31:50.57,0:31:52.10, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:31:52.82,0:31:54.94, Lalai,,0,0,0,,Tidak perlu ambulans.
Dialog: 0,0:31:59.41,0:32:00.76, Lalai,,0,0,0,,Apa yang berlaku kepadanya?
Dialog: 0,0:32:00.79,0:32:02.47, Lalai,,0,0,0,,Dia hanya cuba bertahan.
Dialog: 0,0:32:02.50,0:32:03.73, Lalai,,0,0,0,,Selamat tinggal, tuan.
Dialog: 0,0:32:03.75,0:32:06.16,Lalai,,0,0,0,,Nanti saya telefon awak. selamat tinggal.
Dialog: 0,0:32:08.13,0:32:09.32, Lalai,,0,0,0,,Jika dia diam,
Dialog: 0,0:32:09.34,0:32:12.86, Lalai,,0,0,0,,dia pasti marah\Nbahawa dia tidak melakukan apa-apa.
Dialog: 0,0:32:12.88,0:32:16.13,Lalai,,0,0,0,,Saya sangat kasihan dengan dia.
Dialog: 0,0:32:22.85,0:32:25.47, Lalai,,0,0,0,,Sejuk. Anda hanya perlu menunggu di dalam.
Dialog: 0,0:32:29.69,0:32:32.02, Lalai,,0,0,0,,Anda kesejukan.
Dialog: 0,0:32:32.82,0:32:35.36, Lalai,,0,0,0,,Bagaimana jika anda diserang selsema?
Dialog: 0,0:32:36.74,0:32:38.53, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:32:41.45,0:32:43.95, Lalai,,0,0,0,,Kenapa tangan awak sejuk sangat?
Dialog: 0,0:32:45.63,0:32:48.87,Default,,0,0,0,,Setiausaha Na, kereta akan datang tidak lama lagi?
Dialog: 0,0:32:49.80,0:32:51.83, Lalai,,0,0,0,,Nah, ya.
Dialog: 0,0:32:52.13,0:32:53.71, Lalai,,0,0,0,,Adakah anda akan baik-baik saja?
Dialog: 0,0:32:53.93,0:32:56.38, Lalai,,0,0,0,, Patutkah saya menghubungi ambulans?
Dialog: 0,0:33:00.64,0:33:02.34, Lalai,,0,0,0,, Itu dia.
Dialog: 0,0:33:19.99,0:33:21.86,Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:33:23.75,0:33:25.60, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:33:25.62,0:33:27.91, Lalai,,0,0,0,,Mereka sepatutnya berhujah sahaja.
Dialog: 0,0:33:28.21,0:33:30.08, Lalai,,0,0,0,,Apa yang berlaku kepadanya?
Dialog: 0,0:33:38.30,0:33:40.11,Lalai,,0,0,0,,Bukankah saya memberitahu anda?
Dialog: 0,0:33:40.14,0:33:42.01, Lalai,,0,0,0,,Jangan dramatik.
Dialog: 0,0:33:43.77,0:33:47.55,Lalai,,0,0,0,,Hae-in, saya tidak tahu bagaimana untuk menjadi dramatik.
Dialog: 0,0:33:53.86,0:33:55.69,Lalai,,0,0,0,,{\i1}Ini{\i0} sedang dramatik.
Dialog: 0,0:34:05.87,0:34:07.53, Lalai,,0,0,0,,Maaf.
Dialog: 0,0:34:17.38,0:34:19.86,Lalai,,0,0,0,,{\i1}Saya tidak tahu kenapa...{\i0}
Dialog: 0,0:34:19.89,0:34:23.03, Lalai,,0,0,0,,Hyun-woo mengingatkan saya kepada Grace Kelly.
Dialog: 0,0:34:23.06,0:34:24.78,Lalai,,0,0,0,,Bukankah dia telah berkahwin dengan seorang raja?
Dialog: 0,0:34:24.81,0:34:26.99, Lalai,,0,0,0,,- Dia mengingatkan saya kepada Diana.\N- Itu salah.
Dialog: 0,0:34:27.02,0:34:29.41,Lalai,,0,0,0,,Kedua-dua mereka telah bercerai.
Dialog: 0,0:34:29.44,0:34:30.62, Lalai,,0,0,0,,- Maaf.\N- Mi-seon.
Dialog: 0,0:34:30.65,0:34:32.92,Lalai,,0,0,0,,Saya datang ke sini untuk merapikan rambut, bukan dicabut.
Dialog: 0,0:34:32.94,0:34:34.46,Lalai,,0,0,0,,Saya kata saya minta maaf.
Dialog: 0,0:34:34.48,0:34:38.34,Lalai,,0,0,0,,Mungkin kerana kami suri rumah,\Ntetapi awak memang tidak melayan kami dengan baik.
Dialog: 0,0:34:38.36,0:34:39.92,Lalai,,0,0,0,,- Saya setuju.\N- Jujurlah dengan kami.
Dialog: 0,0:34:39.95,0:34:42.30,Lalai,,0,0,0,,Adakah ia menjengkelkan anda apabila kita\Nbercakap tentang rupa Hyun-woo?
Dialog: 0,0:34:42.32,0:34:44.89,Lalai,,0,0,0,,Hyun-woo sentiasa tampan.
Dialog: 0,0:34:44.91,0:34:45.97,Lalai,,0,0,0,,Bukan begitu.
Dialog: 0,0:34:46.00,0:34:47.16,Lalai,,0,0,0,,Betul.
Dialog: 0,0:34:47.19,0:34:48.18,Lalai,,0,0,0,,Awak dengar?
Dialog: 0,0:34:48.21,0:34:50.68, Lalai,,0,0,0,,- Mengenai apa?\N- Anak perempuan kedai elektronik.
Dialog: 0,0:34:50.71,0:34:53.83, Lalai,,0,0,0,,- Mertua siapa doktor?\N- Ya.
Dialog: 0,0:34:54.54,0:34:56.15, Lalai,,0,0,0,,- Mereka akan bercerai.\N- Betul ke?
Dialog: 0,0:34:56.17,0:34:57.57,Lalai,,0,0,0,,- Serius?\N- Ya!
Dialog: 0,0:34:57.59,0:34:59.94,Lalai,,0,0,0,,- Kebaikan.\N- Kebaikan.
Dialog: 0,0:34:59.97,0:35:02.86, Lalai,,0,0,0,, Astaga, itu bukan masalah besar.
Dialog: 0,0:35:02.89,0:35:04.57,Lalai,,0,0,0,,Perceraian adalah perkara biasa hari ini.
Dialog: 0,0:35:04.60,0:35:07.49,Lalai,,0,0,0,,Malah ada rancangan TV\Nyang memaparkan pasangan bercerai.
Dialog: 0,0:35:07.52,0:35:10.16,Lalai,,0,0,0,,Tidak memalukan untuk bercerai hari ini.
Dialog: 0,0:35:10.19,0:35:13.33,Lalai,,0,0,0,,Ibunya pasti sangat\Nmalu melihat jirannya.
Dialog: 0,0:35:13.36,0:35:17.34,Lalai,,0,0,0,,Dia selalu mendabik dada\Mengenai menantunya seorang doktor.
Dialog: 0,0:35:17.36,0:35:18.84,Lalai,,0,0,0,,Saya fikir dia juga seorang doktor.
Dialog: 0,0:35:18.86,0:35:21.55,Lalai,,0,0,0,,Dia sentiasa memberi nasihat\N kepada orang lain jika mereka tidak sihat.
Dialog: 0,0:35:21.57,0:35:23.49, Lalai,,0,0,0,,- Beritahu saya mengenainya.\N- Mengapa mereka berpecah?
Dialog: 0,0:35:23.51,0:35:24.68, Lalai,,0,0,0,,Ia terlalu berbeza.
Dialog: 0,0:35:24.70,0:35:26.22,Lalai,,0,0,0,,Saya beritahu awak sebelum ini.
Dialog: 0,0:35:26.24,0:35:30.49,Lalai,,0,0,0,,Perkahwinan tidak akan kekal jika isteri\Nand suami terlalu berbeza,
Dialog: 0,0:35:33.08,0:35:35.99,Lalai,,0,0,0,,tetapi saya tidak mengatakan perkara itu selalu berlaku.
Dialog: 0,0:35:36.30,0:35:38.36,Lalai,,0,0,0,,Adakah Hyun-woo bahagia berkahwin?
Dialog: 0,0:35:38.38,0:35:40.65, Lalai,,0,0,0,,Sudah tentu dia.
Dialog: 0,0:35:40.68,0:35:42.36, Lalai,,0,0,0,,Tetapi anda tahu apa yang mereka katakan.
Dialog: 0,0:35:42.39,0:35:45.11,Lalai,,0,0,0,,Mereka di Seoul memandang rendah orang seperti kami.
Dialog: 0,0:35:45.14,0:35:46.20,Lalai,,0,0,0,,Betul,
Dialog: 0,0:35:46.22,0:35:49.72,Lalai,,0,0,0,,dan Hyun-woo berkahwin\Ndengan sebuah keluarga konglomerat.
Dialog: 0,0:35:50.14,0:35:52.37,Lalai,,0,0,0,,Kakak ipar saya tidak begitu.
Dialog: 0,0:35:52.40,0:35:55.60,Lalai,,0,0,0,,Betul. saya pasti.
Dialog: 0,0:35:56.11,0:35:59.39,Lalai,,0,0,0,,Lalu kenapa dia tidak hadir\Hari jadi ayah anda yang ke-60?
Dialog: 0,0:36:00.03,0:36:02.92, Lalai,,0,0,0,,Orang ramai mula bergosip selepas itu.
Dialog: 0,0:36:02.95,0:36:04.84, Lalai,,0,0,0,,- Sebut?\N- Bahawa mereka tidak sehaluan.
Dialog: 0,0:36:04.87,0:36:06.80,Lalai,,0,0,0,,Mereka fikir Hyun-woo tidak dilayan dengan baik.
Dialog: 0,0:36:06.83,0:36:08.91,Lalai,,0,0,0,,Hanya mereka yang tidak melayan mertua mereka dengan baik...
Dialog: 0,0:36:08.94,0:36:11.72,Lalai,,0,0,0,,menghadiri parti hari jadi\Nand berpura-pura seperti mereka.
Dialog: 0,0:36:11.75,0:36:14.01,Lalai,,0,0,0,,Tetapi orang suka dia yang\Baik dengan mertua...
Dialog: 0,0:36:14.03,0:36:16.12, Lalai,,0,0,0,,tidak perlu berbuat demikian.
Dialog: 0,0:36:16.25,0:36:18.62,Lalai,,0,0,0,,Saya faham, tetapi adakah anda marah?
Dialog: 0,0:36:19.01,0:36:20.44, Lalai,,0,0,0,,Kenapa saya nak marah?
Dialog: 0,0:36:20.46,0:36:24.04, Lalai,,0,0,0,,Kemudian lepaskan penumbuk itu,\Anda juga tidak akan melakukan pukulan.
Dialog: 0,0:36:27.68,0:36:29.70,Lalai,,0,0,0,,- Saya sakit kepala.\N- Ada apa dengan dia?
Dialog: 0,0:36:29.72,0:36:31.41, Lalai,,0,0,0,,- Dia marah.\N- Saya faham.
Dialog: 0,0:36:31.43,0:36:33.29,Lalai,,0,0,0,,Seluruh badan saya sakit hari ini.
Dialog: 0,0:36:33.31,0:36:34.37, Lalai,,0,0,0,,Jangan buang barang.
Dialog: 0,0:36:34.40,0:36:37.76, Lalai,,0,0,0,, Pinky sedang menonton, anda tahu?
Dialog: 0,0:36:40.03,0:36:42.05, Lalai,,0,0,0,,Hyun-woo, si bodoh itu.
Dialog: 0,0:36:42.07,0:36:45.38, Lalai,,0,0,0,,Saya faham. Belajar undang-undang di SNU\Nmungkin membuatnya sombong,
Dialog: 0,0:36:45.41,0:36:48.23, Lalai,,0,0,0,,jadi pasti sukar untuk\Nmengenai keluarga konglomerat,
Dialog: 0,0:36:48.26,0:36:51.05, Lalai,,0,0,0,,tetapi bukankah lebih baik untuk\Nhidung coklat, jika ada?
Dialog: 0,0:36:51.08,0:36:53.52,Lalai,,0,0,0,,Sudah tentu. Saya berhidung coklat\Nkanak-kanak sekolah menengah setiap bulan.
Dialog: 0,0:36:53.54,0:36:55.48,Lalai,,0,0,0,,- Kenapa?\N- Jadi mereka mendaftar untuk bulan berikutnya.
Dialog: 0,0:36:55.50,0:36:57.93,Lalai,,0,0,0,,Hei, bukan tangan saya yang\N mengekalkan saya dalam perniagaan juga.
Dialog: 0,0:36:57.96,0:36:59.27, Lalai,,0,0,0,,Tidak sama sekali. itu mulut saya.
Dialog: 0,0:36:59.30,0:37:02.90,Lalai,,0,0,0,,"Aduh, cantiknya awak\Nhari ini. Kulit awak berseri-seri!"
Dialog: 0,0:37:02.92,0:37:06.07, Lalai,,0,0,0,,"Anda kelihatan sepuluh tahun lebih muda dengan\Nguntingan rambut baharu ini." Itulah yang saya katakan.
Dialog: 0,0:37:06.09,0:37:07.95,Lalai,,0,0,0,,Saya harap Hyun-woo boleh jadi seperti kita.
Dialog: 0,0:37:07.97,0:37:09.07, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:37:09.10,0:37:11.47, Lalai,,0,0,0,,Saya terlalu menyayanginya.
Dialog: 0,0:37:11.93,0:37:14.87,Lalai,,0,0,0,,Ibu, tidakkah kamu patut melakukan sesuatu tentang perkara ini?
Dialog: 0,0:37:14.89,0:37:18.50,Lalai,,0,0,0,,- Dia mungkin akan bercerai.\N- Perceraian bukan masalah besar.
Dialog: 0,0:37:18.52,0:37:19.96,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:37:19.98,0:37:23.21,Lalai,,0,0,0,,Orang bercerai apabila mereka fikir\Nmereka berada di ambang kematian.
Dialog: 0,0:37:23.24,0:37:25.35,Lalai,,0,0,0,,Lebih baik bercerai.
Dialog: 0,0:37:26.32,0:37:28.13, Lalai,,0,0,0,,Mee sedap.
Dialog: 0,0:37:28.16,0:37:29.94, Lalai,,0,0,0,,Lebih banyak minyak bijan?
Dialog: 0,0:37:29.99,0:37:31.99,Lalai,,0,0,0,,Ya, tambah lagi.
Dialog: 0,0:37:40.67,0:37:43.48,Lalai,,0,0,0,,{\i1}Saya menyediakan hidangan yang berbeza untuk setiap daripada anda,{\i0}
Dialog: 0,0:37:43.51,0:37:46.21,Lalai,,0,0,0,,{\i1}berdasarkan keputusan ujian darah minggu lepas.{\i0}
Dialog: 0,0:37:46.38,0:37:49.15,Lalai,,0,0,0,,Bagi timbalan pengerusi,\NI menyediakan diet rendah FODMAP...
Dialog: 0,0:37:49.18,0:37:51.37, Lalai,,0,0,0,,untuk sindrom usus besar anda.
Dialog: 0,0:37:51.39,0:37:52.92,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:38:02.15,0:38:03.13, Lalai,,0,0,0,,Di manakah Atuk?
Dialog: 0,0:38:03.15,0:38:06.84,Lalai,,0,0,0,,Dia perlu berpuasa untuk\Npemeriksaan perubatannya esok.
Dialog: 0,0:38:06.86,0:38:10.84, Lalai,,0,0,0,,Saya akan bertaruh dia akan hidup sehingga 120 tahun.
Dialog: 0,0:38:10.87,0:38:12.93, Lalai,,0,0,0,,Saya tidak mempunyai daging.
Dialog: 0,0:38:12.95,0:38:15.57,Lalai,,0,0,0,,Ini kerana kolesterol anda.
Dialog: 0,0:38:18.73,0:38:19.79,Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:38:19.82,0:38:20.81,Lalai,,0,0,0,,Ya?
Dialog: 0,0:38:20.84,0:38:23.65, Lalai,,0,0,0,,Anda akan menerima pensijilan\kandungan Nof esok.
Dialog: 0,0:38:23.67,0:38:26.69,Lalai,,0,0,0,,Saya akan memfailkan saman tentang cara\Nyou membina gedung serbaneka anda...
Dialog: 0,0:38:26.72,0:38:29.88, Lalai,,0,0,0,, atas tanah saya di Gwanggyo.
Dialog: 0,0:38:30.43,0:38:34.03,Lalai,,0,0,0,,Kami sudah pun bercakap tentang perkara ini\Napabila pembinaan bermula,
Dialog: 0,0:38:34.06,0:38:35.87, Lalai,,0,0,0,, dan ia tidak begitu luas.
Dialog: 0,0:38:35.89,0:38:39.83, Lalai,,0,0,0,,Dengar. Semua peperangan bermula kerana\Tiada pihak yang melangkah...
Dialog: 0,0:38:39.85,0:38:42.89,Lalai,,0,0,0,,- tanah pihak lain.\N- Anda memberi saya kebenaran anda.
Dialog: 0,0:38:44.11,0:38:47.98, Lalai,,0,0,0,,Saya lakukan, tetapi Peguam Shim menentangnya.
Dialog: 0,0:38:48.03,0:38:51.13,Lalai,,0,0,0,,Khabar angin mungkin tersebar tentang\Bagaimana saya memberi anda layanan istimewa,
Dialog: 0,0:38:51.16,0:38:53.59, Lalai,,0,0,0,, dan saya mungkin perlu membayar cukai hadiah.
Dialog: 0,0:38:53.62,0:38:56.26,Lalai,,0,0,0,,Jadi anda akan memfailkan saman,\Sekarang bangunan itu...
Dialog: 0,0:38:56.29,0:38:57.43,Lalai,,0,0,0,,sudah dibina?
Dialog: 0,0:38:57.46,0:38:58.97, Lalai,,0,0,0,,Anda belum buka lagi.
Dialog: 0,0:38:59.00,0:39:02.14, Lalai,,0,0,0,,Saya faham. Kemudian adakah saya perlu merobohkannya?
Dialog: 0,0:39:02.17,0:39:05.36,Lalai,,0,0,0,,Hae-in, dia tidak mahu memanjangkan kes itu.
Dialog: 0,0:39:05.38,0:39:07.75, Lalai,,0,0,0,,Dia mahu berunding.
Dialog: 0,0:39:07.84,0:39:09.82,Lalai,,0,0,0,,- Hyun-woo.\N- Ya, tuan.
Dialog: 0,0:39:09.84,0:39:13.21,Lalai,,0,0,0,,Lihatlah dengan dia, dan datang\Bangun dengan ukuran yang sesuai.
Dialog: 0,0:39:18.10,0:39:20.01, Lalai,,0,0,0,,"Suatu ukuran yang sesuai"?
Dialog: 0,0:39:20.98,0:39:25.47, Lalai,,0,0,0,,Apakah maksudnya? Patutkah\NI takut dan berundur?
Dialog: 0,0:39:25.61,0:39:28.25,Lalai,,0,0,0,,Adakah ini yang anda maksudkan\Napabila anda berkata teruskan?
Dialog: 0,0:39:28.28,0:39:30.30, Lalai,,0,0,0,,Anda mengancam saya dengan tuntutan mahkamah itu.
Dialog: 0,0:39:30.32,0:39:31.76, Lalai,,0,0,0,,Apa yang saya katakan ialah...
Dialog: 0,0:39:31.78,0:39:33.40,Lalai,,0,0,0,,Saya rasa...
Dialog: 0,0:39:36.70,0:39:37.68, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:39:37.70,0:39:40.02,Lalai,,0,0,0,,Adakah anda baru sahaja memotong saya?
Dialog: 0,0:39:40.04,0:39:41.91,Lalai,,0,0,0,,Saya minta maaf,
Dialog: 0,0:39:42.23,0:39:44.94,Lalai,,0,0,0,,tetapi memandangkan anda sudah memfailkan aduan,
Dialog: 0,0:39:44.96,0:39:47.81,Lalai,,0,0,0,,kami akan menelitinya dan memberikan jawapan kami.
Dialog: 0,0:39:47.84,0:39:50.57,Lalai,,0,0,0,,Walau bagaimanapun, akhbar akan mengetahui\Mengenai perkara ini dalam proses,
Dialog: 0,0:39:50.59,0:39:53.03, Lalai,,0,0,0,,dan itu boleh menyebabkan kejatuhan\Nin harga saham dan banyak lagi.
Dialog: 0,0:39:53.05,0:39:55.67,Lalai,,0,0,0,,Saya perlu memaklumkan kepada datuknya.
Dialog: 0,0:39:57.26,0:39:58.97, Lalai,,0,0,0,,Saya akan lakukan itu.
Dialog: 0,0:39:59.35,0:40:01.89,Lalai,,0,0,0,,Ya, puan. Maka itu sahaja.
Dialog: 0,0:40:03.98,0:40:06.52, Lalai,,0,0,0,,Dia berasa agak tidak sihat.
Dialog: 0,0:40:07.40,0:40:09.02, Lalai,,0,0,0,,Maafkan kami.
Dialog: 0,0:40:24.63,0:40:27.44,Lalai,,0,0,0,,Anda mahu merahsiakannya daripada keluarga anda.
Dialog: 0,0:40:27.49,0:40:28.48,Lalai,,0,0,0,,Tetapi?
Dialog: 0,0:40:28.50,0:40:31.78,Lalai,,0,0,0,,Tetapi bukankah mereka akan mengesyaki ada sesuatu yang berlaku,
Dialog: 0,0:40:31.80,0:40:35.29,Lalai,,0,0,0,,jika anda semua tegang dan\Nyebuk tangan anda menggeletar?
Dialog: 0,0:40:36.26,0:40:40.47,Lalai,,0,0,0,,Betul. Saya tahu saya bertindak di luar watak,
Dialog: 0,0:40:40.52,0:40:42.63, Lalai,,0,0,0,,tetapi bagaimana dengan anda?
Dialog: 0,0:40:42.94,0:40:45.58,Lalai,,0,0,0,,Awak mengganggu ibu saya dan menyebelahi saya.
Dialog: 0,0:40:45.60,0:40:48.01, Lalai,,0,0,0,,Awak juga memandang mata saya dengan penuh kasih sayang.
Dialog: 0,0:40:53.11,0:40:55.90, Lalai,,0,0,0,,Anda adalah yang paling mencurigakan.
Dialog: 0,0:40:56.95,0:40:58.90, Lalai,,0,0,0,,Bertindak seperti biasa.
Dialog: 0,0:41:00.83,0:41:03.66, Lalai,,0,0,0,,Bila awak pernah kupas udang untuk saya?
Dialog: 0,0:41:10.17,0:41:13.33, Lalai,,0,0,0,,{\i1}Ia tidak akan berfungsi untuk kita.{\i0}
Dialog: 0,0:41:18.68,0:41:20.66, Lalai,,0,0,0,,Mustahil.
Dialog: 0,0:41:20.68,0:41:23.54, Lalai,,0,0,0,,Bagaimanakah kita boleh berubah selepas\Ntahun hidup sebagai orang asing?
Dialog: 0,0:41:23.56,0:41:24.73, Lalai,,0,0,0,,Tetapi bukankah begitu...
Dialog: 0,0:41:24.76,0:41:26.12, Lalai,,0,0,0,,- tiga tahun lalu?\N- Apa itu?
Dialog: 0,0:41:26.15,0:41:28.01,Lalai,,0,0,0,,Bukankah anda jatuh cinta?
Dialog: 0,0:41:28.11,0:41:30.38,Lalai,,0,0,0,,- Itu tadi...\N- Kamu berdua sangat terkedu.
Dialog: 0,0:41:30.40,0:41:32.75, Lalai,,0,0,0,,Dia melawat anda menaiki helikopter...
Dialog: 0,0:41:32.78,0:41:34.59,Lalai,,0,0,0,,dan menderhaka kepada ibu bapanya. awak juga.
Dialog: 0,0:41:34.61,0:41:36.21,Lalai,,0,0,0,,Anda juga tidak siuman ketika itu.
Dialog: 0,0:41:36.24,0:41:38.18,Lalai,,0,0,0,,Anda gila cinta,
Dialog: 0,0:41:38.20,0:41:41.28,Lalai,,0,0,0,,bukankah itu cinta?
Dialog: 0,0:41:43.16,0:41:44.26, Lalai,,0,0,0,,Itu tahun lalu.
Dialog: 0,0:41:44.29,0:41:46.68,Lalai,,0,0,0,,Ya, anda betul, tetapi\Nbiar saya berikan satu contoh.
Dialog: 0,0:41:46.71,0:41:49.88, Lalai,,0,0,0,,Kami belajar cara untuk terus hidup di dalam air sebagai\Nkids. Kemudian kami tidak berenang selama beberapa dekad.
Dialog: 0,0:41:49.91,0:41:52.17,Lalai,,0,0,0,,Walaupun kita berakhir di dalam air\Nagain, kita akan tetap terapung.
Dialog: 0,0:41:52.19,0:41:55.36,Lalai,,0,0,0,,Anda mungkin fikir anda terlupa semuanya,\Ntetapi badan anda ingat.
Dialog: 0,0:41:55.38,0:41:56.69,Lalai,,0,0,0,,Begitu juga dengan cinta.
Dialog: 0,0:41:56.72,0:41:58.86,Lalai,,0,0,0,,Anda mungkin fikir anda terlupa cara melakukannya,
Dialog: 0,0:41:58.89,0:42:01.45,Lalai,,0,0,0,,tetapi hati anda mengingati sebaik sahaja anda memasukinya.
Dialog: 0,0:42:01.47,0:42:03.24, Lalai,,0,0,0,,Tetapi ini bukan seperti berenang.
Dialog: 0,0:42:03.27,0:42:06.22,Lalai,,0,0,0,,Sudah tentu. Bercinta bukanlah sesuatu yang istimewa.
Dialog: 0,0:42:10.44,0:42:12.35,Lalai,,0,0,0,,Pelik, bukan?
Dialog: 0,0:42:12.73,0:42:15.31,Lalai,,0,0,0,,Kami berkahwin kerana kami bercinta,
Dialog: 0,0:42:15.78,0:42:17.46,Lalai,,0,0,0,,jadi kenapa cinta itu hilang?
Dialog: 0,0:42:17.49,0:42:19.26,Lalai,,0,0,0,,Sebagai peguam cerai,
Dialog: 0,0:42:19.28,0:42:23.40,Lalai,,0,0,0,,Saya rasa masalahnya\Nbahawa perkahwinan itu eksklusif.
Dialog: 0,0:42:23.45,0:42:25.26,Lalai,,0,0,0,,Pasangan tidak perlu mencuba,
Dialog: 0,0:42:25.29,0:42:27.06,Lalai,,0,0,0,,jadi mereka kecewa dan bergaduh.
Dialog: 0,0:42:27.08,0:42:30.64, Lalai,,0,0,0,,Kemudian mereka datang kepada saya. Perkahwinan\Nhanya menjadikannya mustahil...
Dialog: 0,0:42:30.67,0:42:33.45, Lalai,,0,0,0,,untuk kekal bercinta.
Dialog: 0,0:42:37.84,0:42:41.09,Lalai,,0,0,0,,- Adakah anda fikir begitu?\N- Saya rasa lebih baik jangan berkahwin,
Dialog: 0,0:42:41.14,0:42:44.26,Default,,0,0,0,,kalau nak bercinta lama-lama.
Dialog: 0,0:43:15.71,0:43:19.12,Lalai,,0,0,0,,Sila terima ini sebagai\Ntanda kasih sayang dan kesetiaan saya.
Dialog: 0,0:43:33.86,0:43:35.77,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:43:36.40,0:43:38.25,Lalai,,0,0,0,,Adakah anda gila? Dia bukan "Sayang" awak.
Dialog: 0,0:43:38.28,0:43:40.48,Lalai,,0,0,0,,Sudah lama, Setiausaha Kim.
Dialog: 0,0:43:40.65,0:43:42.61,Lalai,,0,0,0,,Hello, puan.
Dialog: 0,0:43:43.99,0:43:46.85,Lalai,,0,0,0,,Anda akan berkahwin? kamu berdua?
Dialog: 0,0:43:46.87,0:43:48.90, Lalai,,0,0,0,,Dan di Korea pada masa itu?
Dialog: 0,0:43:49.04,0:43:50.52,Lalai,,0,0,0,,Betul.
Dialog: 0,0:43:50.54,0:43:53.02, Lalai,,0,0,0,,Anda mesti pernah dengar saya berada dalam penjara.
Dialog: 0,0:43:53.04,0:43:54.44,Lalai,,0,0,0,,Itulah sebabnya awak kembali.
Dialog: 0,0:43:54.46,0:43:56.02, Lalai,,0,0,0,,Tetapi memalukan.
Dialog: 0,0:43:56.05,0:43:59.37, Lalai,,0,0,0,,Saya keluar.
Dialog: 0,0:44:06.31,0:44:07.84, Lalai,,0,0,0,, Tenang, Sayang.
Dialog: 0,0:44:09.64,0:44:11.08, Lalai,,0,0,0,,Apa yang saya beritahu awak?
Dialog: 0,0:44:11.10,0:44:13.00,Lalai,,0,0,0,,Saya kata saya akan menyelamatkan nyawa awak...
Dialog: 0,0:44:13.02,0:44:17.25,Lalai,,0,0,0,,selagi anda meninggalkan negara ini dan berbaring.
Dialog: 0,0:44:17.27,0:44:18.71, Lalai,,0,0,0,,- Betul.\N- Jadi beraninya awak...
Dialog: 0,0:44:18.73,0:44:21.34,Lalai,,0,0,0,,nikah di hadapan semua saudara mara,
Dialog: 0,0:44:21.36,0:44:23.31, Lalai,,0,0,0,,apabila awak menipu saya?
Dialog: 0,0:44:29.62,0:44:31.32,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:44:31.79,0:44:33.53,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:44:41.30,0:44:43.04,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:44:44.30,0:44:46.59,Lalai,,0,0,0,,Sayang!
Dialog: 0,0:45:02.78,0:45:05.55,Lalai,,0,0,0,,Puan, awak ada darah...
Dialog: 0,0:45:05.57,0:45:07.57, Lalai,,0,0,0,,Ia bukan milik saya.
Dialog: 0,0:45:10.41,0:45:12.97, Lalai,,0,0,0,,- Di mana?\N- Di pipi awak.
Dialog: 0,0:45:13.00,0:45:15.23, Lalai,,0,0,0,,Anda tidak sepatutnya melakukan ini semasa anda dalam percubaan.
Dialog: 0,0:45:15.25,0:45:17.99,Lalai,,0,0,0,,Anda boleh menjadi lebih teruk\Nhukuman kerana serangan dan fitnah.
Dialog: 0,0:45:18.01,0:45:22.30, Lalai,,0,0,0,, Fitnah? Apa yang saya lakukan setakat ini\Nterhadap penipu itu jauh dari itu.
Dialog: 0,0:45:23.47,0:45:25.86, Lalai,,0,0,0,, Patutkah saya tunjukkan kepada anda bagaimana fitnah sebenar?
Dialog: 0,0:45:25.88,0:45:28.91, Lalai,,0,0,0,,Anda boleh berada di belakang bar\Sehingga anda berumur 60 tahun jika anda berbuat demikian.
Dialog: 0,0:45:28.93,0:45:30.84, Lalai,,0,0,0,,Adakah itu boleh?
Dialog: 0,0:45:31.56,0:45:33.37,Lalai,,0,0,0,,Saya sudah selesai dengan peguam mereka.
Dialog: 0,0:45:33.39,0:45:34.41, Lalai,,0,0,0,,Berapa?
Dialog: 0,0:45:34.44,0:45:36.20,Lalai,,0,0,0,,- Adakah anda ingin tahu?\N- Lupakan.
Dialog: 0,0:45:36.23,0:45:38.54,Lalai,,0,0,0,,Ia sudah memadai untuk membina kolam di rumah mereka.
Dialog: 0,0:45:38.56,0:45:40.81, Lalai,,0,0,0,,Anda tidak sepatutnya berbuat demikian.
Dialog: 0,0:45:41.23,0:45:43.35,Lalai,,0,0,0,,Adakah anda masih membenci mereka?
Dialog: 0,0:45:47.24,0:45:48.76,Lalai,,0,0,0,,Adakah anda merokok?
Dialog: 0,0:45:48.78,0:45:50.51,Lalai,,0,0,0,,- Saya berhenti.\N- Kerana saya lakukan.
Dialog: 0,0:45:50.53,0:45:54.65,Lalai,,0,0,0,,Saya belajar merokok kerana\Nall bekas suami saya curang dengan saya.
Dialog: 0,0:45:56.96,0:45:58.27, Lalai,,0,0,0,,Anda tidak boleh merokok di sini.
Dialog: 0,0:45:58.29,0:46:00.27,Lalai,,0,0,0,,Jom.
Dialog: 0,0:46:00.29,0:46:02.20, Lalai,,0,0,0,, Pergi? di mana?
Dialog: 0,0:46:04.72,0:46:05.73, Lalai,,0,0,0,, Sial.
Dialog: 0,0:46:05.76,0:46:08.29, Lalai,,0,0,0,,Saya bermati-matian untuk keluar dari penjara,
Dialog: 0,0:46:09.34,0:46:12.21,Lalai,,0,0,0,,tetapi sekarang saya sudah keluar, tiada tempat untuk pergi.
Dialog: 0,0:46:13.68,0:46:15.38,Lalai,,0,0,0,,Anda sepatutnya pulang.
Dialog: 0,0:46:16.27,0:46:18.80,Lalai,,0,0,0,,Pengerusi sedang menunggu anda.
Dialog: 0,0:46:28.36,0:46:29.59, Lalai,,0,0,0,, Beom-ja.
Dialog: 0,0:46:29.62,0:46:33.11,Lalai,,0,0,0,,Saya dengar awak tak makan sepanjang hari.
Dialog: 0,0:46:40.46,0:46:43.31, Lalai,,0,0,0,,Apa guna awak jika saya mati kelaparan atau tidak?
Dialog: 0,0:46:43.34,0:46:45.65,Lalai,,0,0,0,,Anda meletakkan saya di belakang bar kerana anda tidak peduli.
Dialog: 0,0:46:45.67,0:46:48.74,Lalai,,0,0,0,,Astaga, bukan saya yang buat begitu.
Dialog: 0,0:46:48.76,0:46:53.16, Lalai,,0,0,0,,Anda telah menyerang seorang wanita yang tidak bersalah,
Dialog: 0,0:46:53.18,0:46:55.84, Lalai,,0,0,0,,jadi anda telah dihukum atas tindakan anda.
Dialog: 0,0:46:56.93,0:46:58.33, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:46:58.35,0:47:00.96,Lalai,,0,0,0,,Wanita yang membunuh Ibu dan\Nmenjadi puan rumah...
Dialog: 0,0:47:00.99,0:47:03.21,Lalai,,0,0,0,,tidak bersalah sama sekali.
Dialog: 0,0:47:03.23,0:47:06.09,Lalai,,0,0,0,,Dia bukan puan rumah.
Dialog: 0,0:47:06.11,0:47:08.25, Lalai,,0,0,0,,Dia tiada dalam daftar keluarga kami.
Dialog: 0,0:47:08.28,0:47:11.38,Lalai,,0,0,0,,Apa yang saya lakukan hanyalah mencengkam rambutnya dengan lembut, tetapi saya yang berdosa di sini.
Dialog: 0,0:47:11.41,0:47:14.05,Lalai,,0,0,0,,Anda tidak boleh mengatakan ia lembut\Napabila cakeranya tergelincir.
Dialog: 0,0:47:14.08,0:47:18.49,Lalai,,0,0,0,,Tepat sekali, jadi fikirkan urusan anda sendiri\Nand biarkan saya mati kerana tergelincir cakeranya!
Dialog: 0,0:47:24.00,0:47:26.69, Lalai,,0,0,0,,Hei, Beom-ja.
Dialog: 0,0:47:26.71,0:47:28.73, Lalai,,0,0,0,,Anda mempunyai idea yang salah tentang dia.
Dialog: 0,0:47:28.76,0:47:31.95,Lalai,,0,0,0,,Seul-hee tidak mahu apa-apa daripada kami.
Dialog: 0,0:47:31.97,0:47:34.88,Lalai,,0,0,0,,Dia tidak berminat dengan\Nberuntung atau menjadi keluarga.
Dialog: 0,0:47:35.64,0:47:38.62, Lalai,,0,0,0,,Itu lebih menakutkan.
Dialog: 0,0:47:38.64,0:47:42.54, Lalai,,0,0,0,,Apakah rancangan besar yang dia rencanakan\Nuntuk tinggal bersama anda dan tidak mahu apa-apa?
Dialog: 0,0:47:42.56,0:47:46.52,Lalai,,0,0,0,,Anda hanya seorang kakek yang mempunyai banyak wang!
Dialog: 0,0:47:47.19,0:47:50.05, Lalai,,0,0,0,,Hei!
Dialog: 0,0:47:50.07,0:47:51.30, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:47:51.32,0:47:54.88,Lalai,,0,0,0,,Saya tertanya-tanya bila dia akan bijak.
Dialog: 0,0:47:54.91,0:47:59.18,Lalai,,0,0,0,,Saya tidak sepatutnya mempunyai harapan kerana\Ndia sudah berusia lima puluhan, bukan?
Dialog: 0,0:47:59.20,0:48:00.85,Lalai,,0,0,0,,Jangan biarkan ia mengganggu anda.
Dialog: 0,0:48:00.87,0:48:03.81,Lalai,,0,0,0,,By the way, saya tahu saya bukan tandingan awak,
Dialog: 0,0:48:03.83,0:48:07.08, Lalai,,0,0,0,,tetapi anda langsung tidak menumpukan pada permainan.
Dialog: 0,0:48:07.67,0:48:09.46, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:48:13.30,0:48:16.28, Lalai,,0,0,0,,- Kebaikan.\N- Merenung papan tidak akan membantu.
Dialog: 0,0:48:16.31,0:48:18.63, Lalai,,0,0,0,,Anda perlu melihat gambaran yang lebih besar.
Dialog: 0,0:48:18.68,0:48:20.22, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:48:21.60,0:48:25.10,Lalai,,0,0,0,,Anda akan ditangkap jika anda melarikan diri dalam ketakutan.
Dialog: 0,0:48:30.44,0:48:32.84, Lalai,,0,0,0,,Tetapi jika anda cuba menangkap harimau itu...
Dialog: 0,0:48:32.86,0:48:37.07, Lalai,,0,0,0,,tanpa disediakan,
Dialog: 0,0:48:37.45,0:48:39.18,Lalai,,0,0,0,,anda akan kehilangan segala-galanya.
Dialog: 0,0:48:39.20,0:48:41.15,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:48:41.41,0:48:45.45,Lalai,,0,0,0,,Inilah sebab mengapa {\i1}janggi{\i0} boleh mengajar anda pelajaran hidup.
Dialog: 0,0:49:13.20,0:49:15.31,Lalai,,0,0,0,,Saya mengambil alih istana awak.
Dialog: 0,0:49:15.82,0:49:17.51,Lalai,,0,0,0,,Ke mana raja akan lari sekarang?
Dialog: 0,0:49:17.53,0:49:19.44, Lalai,,0,0,0,,Checkmate.
Dialog: 0,0:49:20.99,0:49:23.78,Lalai,,0,0,0,,Adakah anda melihat kedatangan ini,
Dialog: 0,0:49:23.96,0:49:26.60, Lalai,,0,0,0,,atau adakah anda hanya bernasib baik?
Dialog: 0,0:49:26.63,0:49:28.58,Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,0:49:29.21,0:49:32.19, Lalai,,0,0,0,,Anda perlu memberi saya satu bantuan, kerana anda kalah.
Dialog: 0,0:49:32.21,0:49:33.44, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:49:33.47,0:49:37.71, Lalai,,0,0,0,,Saya akan beritahu anda apabila saya ada.
Dialog: 0,0:49:45.98,0:49:48.37,Lalai,,0,0,0,,Sayang, awak nampak tak?
Dialog: 0,0:49:48.40,0:49:51.27, Lalai,,0,0,0,,Saya rasa saya baru nampak bintang jatuh.
Dialog: 0,0:49:51.44,0:49:55.00,Lalai,,0,0,0,,Saya tidak tahu saya boleh melihat mereka di Seoul.
Dialog: 0,0:49:55.03,0:49:58.31,Lalai,,0,0,0,,Anda bermimpi untuk menembak\Nbintang sebelum mempunyai Hae-in.
Dialog: 0,0:50:00.91,0:50:02.49, Lalai,,0,0,0,, Adakah saya?
Dialog: 0,0:50:03.41,0:50:06.31, Lalai,,0,0,0,,Anda teruja kerana anda\Nfikirkan anda akan mempunyai bayi perempuan.
Dialog: 0,0:50:06.33,0:50:10.49, Lalai,,0,0,0,,Saya tidak pasti. Saya tidak berapa ingat.
Dialog: 0,0:50:11.13,0:50:14.29,Lalai,,0,0,0,,Sayang, jangan keras sangat pada Hae-in.
Dialog: 0,0:50:16.17,0:50:17.83, Lalai,,0,0,0,,Apa yang saya buat?
Dialog: 0,0:50:18.51,0:50:22.37, Lalai,,0,0,0,,Berapa lama anda akan membiarkan masa lalu anda menghantui anda?
Dialog: 0,0:50:22.39,0:50:25.38, Lalai,,0,0,0,,Anda harus melepaskan dan teruskan.
Dialog: 0,0:50:26.27,0:50:29.25,Lalai,,0,0,0,,Itulah yang kamu katakan ketika itu.\NYa ayah kamu tidak mahu sebarang masalah,
Dialog: 0,0:50:29.27,0:50:30.83, Lalai,,0,0,0,,jadi anda bertanggungjawab.
Dialog: 0,0:50:30.86,0:50:33.63,Default,,0,0,0,,Saya masih tidak faham kenapa Su-wan terpaksa mati.
Dialog: 0,0:50:33.65,0:50:36.84, Lalai,,0,0,0,,Itu hanya kemalangan. Tiada siapa yang patut dipersalahkan.
Dialog: 0,0:50:36.86,0:50:39.72,Lalai,,0,0,0,,Anda betul. Bukan salah sesiapa,
Dialog: 0,0:50:39.74,0:50:42.15, Lalai,,0,0,0,,tetapi Su-wan sudah tiada.
Dialog: 0,0:50:43.12,0:50:46.86, Lalai,,0,0,0,,Saya masih kecewa dan kesakitan setiap hari.
Dialog: 0,0:50:47.08,0:50:48.78, Lalai,,0,0,0,,Kepada orang lain...
Dialog: 0,0:50:49.25,0:50:51.27,Lalai,,0,0,0,,Kepada anda, ia hanyalah peristiwa masa lalu,
Dialog: 0,0:50:51.29,0:50:53.74, Lalai,,0,0,0,,tetapi saya mengimbau detik itu setiap hari.
Dialog: 0,0:50:55.26,0:50:58.50,Lalai,,0,0,0,,Saya dihantui pada hari saya kehilangan anak saya,
Dialog: 0,0:51:00.47,0:51:03.96, Lalai,,0,0,0,,jadi jangan harap saya bersikap munasabah.
Dialog: 0,0:51:50.02,0:51:52.97, Lalai,,0,0,0,,Kenapa dia masih belum pulang?
Dialog: 0,0:51:54.40,0:51:56.35, Lalai,,0,0,0,,Adakah dia benar-benar sakit?
Dialog: 0,0:51:57.11,0:51:59.23, Lalai,,0,0,0,,Dia mempunyai stamina yang hebat.
Dialog: 0,0:52:00.45,0:52:05.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sejujurnya, peluangnya\Nof survival adalah sangat rendah,{\c}{\i0}
Dialog: 0,0:52:05.99,0:52:08.68, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi keajaiban berlaku.{\c}{\i0}
Dialog: 0,0:52:08.70,0:52:10.39, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Maaf?{\c}{\i0}
Dialog: 0,0:52:10.41,0:52:13.56, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berapa kerapkah keajaiban ini berlaku?{\c}{\i0}
Dialog: 0,0:52:13.58,0:52:15.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah ia sering berlaku?{\c}{\i0}
Dialog: 0,0:52:15.54,0:52:17.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sepanjang 30 tahun saya sebagai doktor,{\c}{\i0}
Dialog: 0,0:52:17.80,0:52:21.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya telah menyaksikan ramai pesakit\Npulih secara ajaib...{\c}{\i0}
Dialog: 0,0:52:21.88,0:52:25.32, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}daripada penyakit yang kurang diharap.{\c}{\i0}
Dialog: 0,0:52:25.35,0:52:27.88, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan putus harapan.{\c}{\i0}
Dialog: 0,0:52:29.35,0:52:31.02,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}kes klinikal untuk tumor otak{\c}{\i0}
Dialog: 0,0:52:33.56,0:52:35.40,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tumor ganas\NDjangan berputus asa dalam rawatan{\c}{\i0}
Dialog: 0,0:52:45.82,0:52:49.55,Lalai,,0,0,0,,{\an8}"Diberi tiga bulan untuk hidup,\Ntetapi masih hidup selepas 30 tahun."
Dialog: 0,0:52:49.58,0:52:51.11, Lalai,,0,0,0,,30 tahun?
Dialog: 0,0:52:51.71,0:52:53.57,Lalai,,0,0,0,,Serius?
Dialog: 0,0:52:56.92,0:53:00.58, Lalai,,0,0,0,,Saya tidak tahu ia adalah perkara biasa.
Dialog: 0,0:53:01.72,0:53:05.50,Lalai,,0,0,0,,Saya rasa ramalan doktor tidak selalunya betul.
Dialog: 0,0:53:05.68,0:53:08.21, Lalai,,0,0,0,,Ini... Astaga.
Dialog: 0,0:53:08.47,0:53:10.24, Lalai,,0,0,0,,Ini tidak seperti drama.
Dialog: 0,0:53:10.27,0:53:16.87, Lalai,,0,0,0,,"Tumor hilang selepas\Nbangun. Kes yang mustahil dari segi perubatan."
Dialog: 0,0:53:16.90,0:53:20.60, Lalai,,0,0,0,,Bagaimana ia mustahil dari segi perubatan?
Dialog: 0,0:53:20.98,0:53:23.27,Lalai,,0,0,0,,Adakah ini realiti...
Dialog: 0,0:53:24.20,0:53:27.23, Lalai,,0,0,0,,perubatan moden? Betul ke?
Dialog: 0,0:54:41.31,0:54:44.00,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pesakit terminal masih boleh pulih{\c}{\i0}
Dialog: 0,0:54:44.03,0:54:46.38,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Diberi 3 bulan untuk hidup,\Ntetapi masih hidup selepas 30 tahun{\c}{\i0}
Dialog: 0,0:55:00.00,0:55:02.52,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Penyembuhan ajaib kanser pankreas saya{\c}{\i0}
Dialog: 0,0:55:02.54,0:55:04.33,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Mereka yang berpaut pada harapan{\c}{\i0}
Dialog: 0,0:55:14.10,0:55:15.80, Lalai,,0,0,0,,Hei, Hae-in.
Dialog: 0,0:55:17.73,0:55:19.80, Lalai,,0,0,0,,Bila anda masuk?
Dialog: 0,0:55:23.77,0:55:26.43, Lalai,,0,0,0,,Kenapa awak tidur di sini? Tidur atas katil.
Dialog: 0,0:55:27.69,0:55:30.02, Lalai,,0,0,0,,Betul, saya sepatutnya.
Dialog: 0,0:55:31.24,0:55:32.77, Lalai,,0,0,0,,Anda juga sepatutnya.
Dialog: 0,0:55:33.66,0:55:35.19,Lalai,,0,0,0,,Selamat malam.
Dialog: 0,0:55:47.59,0:55:49.17, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:55:50.51,0:55:52.04, Lalai,,0,0,0,,Ya?
Dialog: 0,0:55:52.72,0:55:54.30, Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,0:55:54.64,0:55:59.38, Lalai,,0,0,0,,Saya syak awak.
Dialog: 0,0:56:00.94,0:56:02.72, Lalai,,0,0,0,,Apa?
Dialog: 0,0:56:06.23,0:56:10.39, Lalai,,0,0,0,,Saya fikir anda akan gembira mendengar saya hampir mati.
Dialog: 0,0:56:10.57,0:56:14.11, Lalai,,0,0,0,,Saya fikir itulah sebabnya awak\Nberbuat baik dengan saya.
Dialog: 0,0:56:15.70,0:56:18.44, Lalai,,0,0,0,,Saya juga mengesyaki anda mempunyai...
Dialog: 0,0:56:18.58,0:56:20.70, Lalai,,0,0,0,,motif tersembunyi.
Dialog: 0,0:56:22.37,0:56:23.98,Lalai,,0,0,0,,Saya akui...
Dialog: 0,0:56:24.00,0:56:25.87,Lalai,,0,0,0,,Saya agak curiga.
Dialog: 0,0:56:26.09,0:56:29.75, Lalai,,0,0,0,,Saya tidak tahu anda akan mencari perkara itu.
Dialog: 0,0:56:37.72,0:56:42.76, Lalai,,0,0,0,,Keajaiban ini berlaku lebih kerap daripada yang anda fikirkan.
Dialog: 0,0:56:44.85,0:56:46.56,Lalai,,0,0,0,,Apa...?
Dialog: 0,0:56:46.73,0:56:49.23, Lalai,,0,0,0,,Anda tidak perlu datang ke sini.
Dialog: 0,0:56:52.90,0:56:56.86, Lalai,,0,0,0,,Jangan risau. Saya akan hidup, tidak kira apa.
Dialog: 0,0:56:58.12,0:56:59.55, Lalai,,0,0,0,,Saya bertindak keras,
Dialog: 0,0:56:59.58,0:57:02.14, Lalai,,0,0,0,,tetapi saya terkejut mendengar diagnosis saya.
Dialog: 0,0:57:02.16,0:57:03.64, Lalai,,0,0,0,,Saya putus asa.
Dialog: 0,0:57:03.67,0:57:08.04, Lalai,,0,0,0,,Sebahagian daripada saya tidak peduli\Napa yang akan berlaku kepada saya.
Dialog: 0,0:57:08.25,0:57:10.90,Lalai,,0,0,0,,"Jika saya benar-benar hanya mempunyai tiga bulan,"
Dialog: 0,0:57:10.92,0:57:13.11, Lalai,,0,0,0,,"adakah menerima rawatan juga membantu?"
Dialog: 0,0:57:13.13,0:57:15.04, Lalai,,0,0,0,,"Patutkah saya berputus asa?"
Dialog: 0,0:57:15.64,0:57:18.66,Lalai,,0,0,0,,"Tiada siapa yang akan meratapi kematian saya,"
Dialog: 0,0:57:18.68,0:57:20.80,Lalai,,0,0,0,,"bukan keluarga saya pun."
Dialog: 0,0:57:21.06,0:57:23.55, Lalai,,0,0,0,,Saya mempunyai pelbagai fikiran.
Dialog: 0,0:57:25.73,0:57:27.29,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:57:27.31,0:57:30.77, Lalai,,0,0,0,,Tetapi ada seorang.
Dialog: 0,0:57:32.82,0:57:37.23,Lalai,,0,0,0,,Anda daripada semua orang mahu saya hidup.
Dialog: 0,0:57:37.41,0:57:38.94, Lalai,,0,0,0,,Saya?
Dialog: 0,0:57:39.78,0:57:42.78,Lalai,,0,0,0,,Ya. Sudah tentu.
Dialog: 0,0:57:43.16,0:57:45.87, Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,0:57:46.83,0:57:49.29, Lalai,,0,0,0,,Sukar untuk saya.
Dialog: 0,0:57:50.75,0:57:55.25,Lalai,,0,0,0,,Terlalu banyak untuk dikendalikan,\Ntetapi melihat anda memberi saya harapan.
Dialog: 0,0:57:56.01,0:57:57.07, Lalai,,0,0,0,,Saya membuat kajian sendiri.
Dialog: 0,0:57:57.09,0:57:59.95,Lalai,,0,0,0,,Tidak seperti di Korea, terdapat\N terdapat kes serupa di luar negara.
Dialog: 0,0:57:59.97,0:58:03.80,Lalai,,0,0,0,,Terdapat banyak makmal di luar sana\Nyang sedang membangunkan ubat baharu.
Dialog: 0,0:58:03.85,0:58:07.66, Lalai,,0,0,0,,Mereka akan dapat mempercepatkan proses,\Selagi mereka mempunyai dana.
Dialog: 0,0:58:07.69,0:58:11.97, Lalai,,0,0,0,,Saya akan cuba menyokong mereka secara aktif.
Dialog: 0,0:58:12.61,0:58:14.39, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:58:15.15,0:58:17.02,Lalai,,0,0,0,,Adakah anda begitu gembira?
Dialog: 0,0:58:18.36,0:58:20.15, Lalai,,0,0,0,,Ya.
Dialog: 0,0:58:20.58,0:58:22.74, Lalai,,0,0,0,,Sudah tentu saya.
Dialog: 0,0:58:27.96,0:58:29.70, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:58:29.83,0:58:34.71,Lalai,,0,0,0,,Saya tidak akan mati semudah itu, demi awak.
Dialog: 0,0:59:13.42,0:59:15.11, Lalai,,0,0,0,,Adakah ini untuk akaun media sosial anda?
Dialog: 0,0:59:15.13,0:59:17.19,Lalai,,0,0,0,,Bagaimana jika ia hanya sebahagian daripada muka anda?
Dialog: 0,0:59:17.22,0:59:19.15,Lalai,,0,0,0,,Saya benar-benar mahu dunia melihat awak.
Dialog: 0,0:59:19.18,0:59:21.20,Lalai,,0,0,0,,Tetapi media akan menyiarkan artikel tentang saya,
Dialog: 0,0:59:21.22,0:59:25.16, Lalai,,0,0,0,, dan ibu bapa anda tidak mahu perkara itu.
Dialog: 0,0:59:25.18,0:59:26.41, Lalai,,0,0,0,,Saya tidak mahu membimbangkan mereka.
Dialog: 0,0:59:26.43,0:59:28.38,Lalai,,0,0,0,,Awak memang...!
Dialog: 0,0:59:29.60,0:59:31.30, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:59:34.02,0:59:35.00, Lalai,,0,0,0,,Juga,
Dialog: 0,0:59:35.02,0:59:38.92,Lalai,,0,0,0,,Jun-ho memberitahu saya untuk merahsiakannya,\Nmemandangkan ia belum disahkan lagi.
Dialog: 0,0:59:38.95,0:59:41.01, Lalai,,0,0,0,,Pengarah kewangan kami? Tentang apa?
Dialog: 0,0:59:41.03,0:59:44.01, Lalai,,0,0,0,,Dia berasa teruk tentang $8 juta itu.
Dialog: 0,0:59:44.03,0:59:45.58, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:59:45.60,0:59:46.60, Lalai,,0,0,0,, Masih.
Dialog: 0,0:59:46.62,0:59:49.85, Lalai,,0,0,0,,Dia cuba menghubungkan anda dengan\Tiada seseorang untuk menebusnya.
Dialog: 0,0:59:49.87,0:59:52.27, Lalai,,0,0,0,,- Siapa?\N- Pelabur dana ekuiti persendirian.
Dialog: 0,0:59:52.29,0:59:53.44, Lalai,,0,0,0,,Dialah...
Dialog: 0,0:59:53.46,0:59:56.77, Lalai,,0,0,0,,yang melabur dalam perjanjian\Nkopi organik untuk Yeom Sang-jin.
Dialog: 0,0:59:56.80,0:59:58.83, Lalai,,0,0,0,, Betulkah?
Dialog: 0,1:00:00.05,1:00:03.15,Lalai,,0,0,0,,Nama dia David Yoon. Dia orang Korea-Amerika.
Dialog: 0,1:00:03.18,1:00:05.07,Lalai,,0,0,0,,{\i1}Dia baru-baru ini datang ke Korea.{\i0}
Dialog: 0,1:00:05.10,1:00:07.28,Lalai,,0,0,0,,{\i1}Dia mengawal wang minyak Timur Tengah,{\i0}
Dialog: 0,1:00:07.31,1:00:09.54,Lalai,,0,0,0,,{\i1}dan dia berada di sini untuk mencari pelaburan baharu.{\i0}
Dialog: 0,1:00:09.56,1:00:12.93,Lalai,,0,0,0,,{\i1}Dia ingin melabur pada\Nsekurang-kurangnya beberapa bilion dolar.{\i0}
Dialog: 0,1:00:27.24,1:00:31.03,Lalai,,0,0,0,,{\i1}Hae-in telah cuba\Nmembawa Hercyna ke dalam kedainya,{\i0}
Dialog: 0,1:00:31.08,1:00:35.10,Lalai,,0,0,0,,{\i1}dan David adalah sebab\Njenama itu boleh dilancarkan...{\i0}
Dialog: 0,1:00:35.13,1:00:39.20,Lalai,,0,0,0,,{\i1}kedai perdana Asia pertama mereka di Seoul.{\i0}
Dialog: 0,1:00:49.77,1:00:51.34,Lalai,,0,0,0,,Hai.
Dialog: 0,1:00:55.36,1:00:57.31,Lalai,,0,0,0,,Hai.
Dialog: 0,1:00:57.94,1:01:01.42,Lalai,,0,0,0,,Tahniah. Saya menyukai pengubahsuaian baharu bahagian makanan anda.
Dialog: 0,1:01:01.44,1:01:03.96,Lalai,,0,0,0,,Saya kerap makan di medan selera kamu hari ini.
Dialog: 0,1:01:03.99,1:01:07.59,Lalai,,0,0,0,,Betul. Saya dengar awak sering datang.
Dialog: 0,1:01:07.62,1:01:10.76,Lalai,,0,0,0,,Bagaimanapun, Royal masih mempunyai banyak\N cara untuk mencapai tahap anda.
Dialog: 0,1:01:10.79,1:01:12.82, Lalai,,0,0,0,,Pencuci mulut kami memerlukan sedikit pengubahsuaian.
Dialog: 0,1:01:13.12,1:01:14.48,Lalai,,0,0,0,,Banyak yang perlu kita lakukan.
Dialog: 0,1:01:14.50,1:01:18.60,Lalai,,0,0,0,,Setelah plaza air pancut\Nis dibina di tingkat satu,
Dialog: 0,1:01:18.63,1:01:20.27,Lalai,,0,0,0,,kami akan membawa masuk Hercyna,
Dialog: 0,1:01:20.30,1:01:22.54,Lalai,,0,0,0,,dan kami akan berusaha dari situ.
Dialog: 0,1:01:23.68,1:01:25.11,Lalai,,0,0,0,,Tidak, kita perlu bekerja lebih keras.
Dialog: 0,1:01:25.13,1:01:27.36,Lalai,,0,0,0,,Jadi bagaimana jika bahagian makanan kita hebat?
Dialog: 0,1:01:27.39,1:01:31.42,Lalai,,0,0,0,,Sebuah gedung serbaneka tanpa\NHercyna hanyalah sebuah restoran besar.
Dialog: 0,1:01:31.47,1:01:34.34,Lalai,,0,0,0,,Kami juga mempunyai ruang untuk Hercyna.
Dialog: 0,1:01:37.81,1:01:39.12,Lalai,,0,0,0,,Adakah anda mahukan petua?
Dialog: 0,1:01:39.15,1:01:42.17,Lalai,,0,0,0,,Tentu, jika anda mahu berikan saya satu.
Dialog: 0,1:01:42.19,1:01:43.88,Lalai,,0,0,0,,Okey.
Dialog: 0,1:01:43.90,1:01:46.34,Lalai,,0,0,0,,Saya pasti anda tahu bahawa En. Hermann...
Dialog: 0,1:01:46.36,1:01:48.93,Lalai,,0,0,0,,mendahulukan nilai syarikat dan\Nmindset sebelum perkara lain.
Dialog: 0,1:01:48.95,1:01:52.30,Lalai,,0,0,0,,Dia percaya bahawa mereka yang membentuk\Nhubungan baik dengan orang lain...
Dialog: 0,1:01:52.33,1:01:55.35,Lalai,,0,0,0,,adalah rakan kongsi perniagaan terbaik.
Dialog: 0,1:01:55.37,1:01:56.98,Lalai,,0,0,0,,Itu kepercayaannya.
Dialog: 0,1:01:57.00,1:01:58.94,Lalai,,0,0,0,,- Jadi?\N- Lihat sekeliling anda.
Dialog: 0,1:01:58.96,1:02:01.79,Lalai,,0,0,0,,Semua orang di sini telah membawa\Npasangan, kekasih atau ahli keluarga mereka.
Dialog: 0,1:02:01.81,1:02:04.78,Lalai,,0,0,0,,Anda seorang sahaja di sini...
Dialog: 0,1:02:04.80,1:02:06.71,Lalai,,0,0,0,,yang datang bersendirian.
Dialog: 0,1:02:06.80,1:02:08.50,Lalai,,0,0,0,,Apa?
Dialog: 0,1:02:11.26,1:02:13.41,Lalai,,0,0,0,,Anda menarik perhatian saya.
Dialog: 0,1:02:13.43,1:02:15.37,Lalai,,0,0,0,,Semua orang tahu anda tiada kawan,
Dialog: 0,1:02:15.39,1:02:19.18,Lalai,,0,0,0,,tetapi bagaimana anda boleh terfikir untuk datang\Di semua tempat sendirian?
Dialog: 0,1:02:20.77,1:02:22.79,Lalai,,0,0,0,,Anda adalah satu-satunya serigala di sini.
Dialog: 0,1:02:22.82,1:02:25.39,Lalai,,0,0,0,,Hanya awak, Hae-in.
Dialog: 0,1:02:25.74,1:02:27.56,Lalai,,0,0,0,,Kasihan awak.
Dialog: 0,1:02:42.21,1:02:43.19,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:02:47.51,1:02:50.17,Lalai,,0,0,0,,- Di manakah anda?\N- {\i1}Saya sedang dalam percubaan.{\i0}
Dialog: 0,1:02:58.85,1:03:00.55,Lalai,,0,0,0,,Apa dia cakap?
Dialog: 0,1:03:04.19,1:03:05.17,Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,1:03:05.19,1:03:07.59,Lalai,,0,0,0,,Anda sedang panik menelefon\Suami anda untuk mendapatkan bantuan.
Dialog: 0,1:03:07.61,1:03:08.71,Lalai,,0,0,0,,Dia tidak akan datang?
Dialog: 0,1:03:08.74,1:03:11.82,Lalai,,0,0,0,,- Dia sedang dalam perbicaraan.\N- Amat sesuai.
Dialog: 0,1:03:11.91,1:03:13.30,Lalai,,0,0,0,,- Apa?\N- Apa yang boleh anda lakukan?
Dialog: 0,1:03:13.33,1:03:15.51,Lalai,,0,0,0,,Anda tidak boleh suruh dia ikat jamin.
Dialog: 0,1:03:15.54,1:03:19.10,Lalai,,0,0,0,,Saya rasa itu adalah alasan yang sesuai.
Dialog: 0,1:03:19.12,1:03:21.98,Lalai,,0,0,0,,Itu bukan alasan. Dia benar-benar dalam perbicaraan.
Dialog: 0,1:03:22.00,1:03:25.00,Lalai,,0,0,0,,Kenapa awak serius sangat? Saya hanya bergurau.
Dialog: 0,1:03:26.05,1:03:28.44,Lalai,,0,0,0,,Hei, jangan kisah khabar angin.
Dialog: 0,1:03:28.47,1:03:29.94,Lalai,,0,0,0,,Saya tidak percaya mereka.
Dialog: 0,1:03:29.97,1:03:32.24,Lalai,,0,0,0,,- Khabar angin apa?\N- Saya pasti anda dengar...
Dialog: 0,1:03:32.26,1:03:35.99,Lalai,,0,0,0,,yang kamu berdua telah berpisah\Nand akan bercerai tidak lama lagi.
Dialog: 0,1:03:36.02,1:03:40.50,Lalai,,0,0,0,,Bahawa dia hanya berkahwin dengan kamu untuk wang kamu.\NI tidak mahu bercakap tentang mereka.
Dialog: 0,1:03:40.52,1:03:41.50,Lalai,,0,0,0,,Tetapi anda ada.
Dialog: 0,1:03:41.52,1:03:44.08,Lalai,,0,0,0,,Saya baru sahaja mula.
Dialog: 0,1:03:44.11,1:03:46.34,Lalai,,0,0,0,,Anda sepatutnya berkahwin biasa.
Dialog: 0,1:03:46.36,1:03:49.63,Lalai,,0,0,0,,Penggosip pun tidak akan banyak\Nuntuk dibincangkan jika anda telah berkahwin dengan seseorang...
Dialog: 0,1:03:49.65,1:03:51.47,Lalai,,0,0,0,,pada tahap anda sendiri.
Dialog: 0,1:03:51.49,1:03:53.43,Lalai,,0,0,0,,Saya telah menyedari sesuatu dalam hidup.
Dialog: 0,1:03:53.45,1:03:56.76,Lalai,,0,0,0,,Perkahwinan adalah tentang mencari pasangan hidup...
Dialog: 0,1:03:56.79,1:04:00.99,Lalai,,0,0,0,,yang melihat ke arah yang sama dengan anda.
Dialog: 0,1:04:02.67,1:04:04.73,Lalai,,0,0,0,,Empat tahun perkahwinan saya yang lalu...
Dialog: 0,1:04:04.75,1:04:06.40,Lalai,,0,0,0,,tidak apa-apa melainkan damai,
Dialog: 0,1:04:06.42,1:04:10.46,Lalai,,0,0,0,, dan itu menimbulkan rasa ingin tahu saya tentang\Pasangan yang tidak dapat bergaul.
Dialog: 0,1:04:10.80,1:04:14.28,Lalai,,0,0,0,,Bagaimana rasanya? Saya tidak pernah\Nmarah dengan suami saya sebelum ini.
Dialog: 0,1:04:14.30,1:04:16.46,Lalai,,0,0,0,,Kenapa awak tanya saya?
Dialog: 0,1:04:17.68,1:04:20.16,Lalai,,0,0,0,,Kamu tidak sepatutnya melampiaskan kemarahan kamu kepada saya...
Dialog: 0,1:04:20.18,1:04:22.97,Lalai,,0,0,0,,kerana tidak disayangi oleh suami.
Dialog: 0,1:04:30.40,1:04:33.59,Lalai,,0,0,0,,Awak sepatutnya berkahwin dengan Yoon Eun-sung.
Dialog: 0,1:04:33.61,1:04:35.47,Lalai,,0,0,0,,Kenapa awak tiba-tiba bawa dia?
Dialog: 0,1:04:35.49,1:04:38.36,Lalai,,0,0,0,,Anda tidak tahu apa-apa, bukan?
Dialog: 0,1:04:38.41,1:04:40.72,Lalai,,0,0,0,,Dia orang kanan Encik Hermann.
Dialog: 0,1:04:40.75,1:04:44.07,Lalai,,0,0,0,,Dia adalah kunci untuk menghubungi En. Hermann.
Dialog: 0,1:04:44.54,1:04:46.08,Lalai,,0,0,0,,Apa?
Dialog: 0,1:04:46.13,1:04:49.23,Lalai,,0,0,0,,Hei, dia benar-benar berjaya.
Dialog: 0,1:04:49.26,1:04:51.79,Lalai,,0,0,0,,Dia bukan lelaki yang sama dari kolej.
Dialog: 0,1:04:52.09,1:04:55.09,Lalai,,0,0,0,,Dia bertanggungjawab menguruskan\kewangan Nsheikh sekarang.
Dialog: 0,1:04:55.64,1:04:58.67,Lalai,,0,0,0,,Sebab itu saya pergi menyambutnya di lapangan terbang.
Dialog: 0,1:04:58.85,1:05:00.55,Lalai,,0,0,0,,Eun-sung.
Dialog: 0,1:05:14.16,1:05:15.90,Lalai,,0,0,0,,Sudah agak lama.
Dialog: 0,1:05:19.08,1:05:23.11,Lalai,,0,0,0,,Anda sepatutnya memberitahu saya\Jika anda sudah kembali ke Korea.
Dialog: 0,1:05:24.67,1:05:27.95,Lalai,,0,0,0,,Tidakkah anda ingat\N perkara terakhir yang anda katakan kepada saya?
Dialog: 0,1:05:28.04,1:05:29.83,Lalai,,0,0,0,,Untuk tidak menghubungi anda.
Dialog: 0,1:05:30.80,1:05:33.00, Lalai,,0,0,0,,- Saya buat?\N- Ya.
Dialog: 0,1:05:33.17,1:05:34.86,Lalai,,0,0,0,,Saya ragu itu.
Dialog: 0,1:05:34.88,1:05:38.55,Lalai,,0,0,0,,"Mari kita terus berhubung."
Dialog: 0,1:05:38.85,1:05:40.63,Lalai,,0,0,0,,Bukankah itu yang saya katakan?
Dialog: 0,1:05:47.94,1:05:51.96,Lalai,,0,0,0,,Anda betul. Saya memberitahu anda untuk tidak menghubungi saya lagi,
Dialog: 0,1:05:51.98,1:05:54.39,Lalai,,0,0,0,,kerana anda terus melepasi garisan.
Dialog: 0,1:05:55.49,1:05:58.11,Lalai,,0,0,0,,Betul, tetapi sekarang...
Dialog: 0,1:05:58.32,1:06:01.03,Lalai,,0,0,0,,nampaknya anda ada sesuatu untuk diperkatakan.
Dialog: 0,1:06:02.04,1:06:04.40,Lalai,,0,0,0,,Saya pasti anda sudah tahu perkara ini,
Dialog: 0,1:06:05.21,1:06:06.35,Lalai,,0,0,0,,jadi saya akan katakan sahaja.
Dialog: 0,1:06:06.37,1:06:08.89,Lalai,,0,0,0,,Ye-na dan saya berada dalam persaingan yang kejam...
Dialog: 0,1:06:08.92,1:06:10.98,Lalai,,0,0,0,,untuk membawa Hercyna ke kedai kami.
Dialog: 0,1:06:11.00,1:06:15.07,Lalai,,0,0,0,,Nampaknya anda mempunyai hubungan\N yang baik dengan En. Hermann,
Dialog: 0,1:06:15.09,1:06:16.63,Lalai,,0,0,0,,jadi beritahu saya.
Dialog: 0,1:06:16.68,1:06:19.38,Lalai,,0,0,0,,- Boleh awak tolong saya?\N- Saya?
Dialog: 0,1:06:22.38,1:06:23.91,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:06:24.14,1:06:28.10,Lalai,,0,0,0,,Sejujurnya, saya tidak ingat masa lalu,
Dialog: 0,1:06:28.35,1:06:32.67,Lalai,,0,0,0,,jadi kenapa kita tidak katakan kita putus cinta...
Dialog: 0,1:06:32.69,1:06:34.56,Lalai,,0,0,0,,dengan baik?
Dialog: 0,1:06:57.68,1:07:01.00,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Bilakah percubaan akan tamat? Adakah hampir tamat?{\c}{\i0}
Dialog: 0,1:07:44.47,1:07:46.87,Lalai,,0,0,0,,- Bagaimana dengan perbicaraan?\N- Saya menang.
Dialog: 0,1:07:46.89,1:07:49.38,Lalai,,0,0,0,,Saya menang cepat untuk datang ke sini.
Dialog: 0,1:08:41.57,1:08:43.31,Lalai,,0,0,0,,Ini dia.
Dialog: 0,1:08:47.99,1:08:50.57,Lalai,,0,0,0,,Tolong satu koktel bukan alkohol.
Dialog: 0,1:08:50.91,1:08:53.85,Lalai,,0,0,0,,Apa kata awak kahwin lagi?
Dialog: 0,1:08:53.87,1:08:57.54,Lalai,,0,0,0,,Mencari pasangan hidup yang memandang\Nin arah yang sama dengan anda?
Dialog: 0,1:08:57.84,1:09:01.82,Lalai,,0,0,0,,Saya tidak faham pada mulanya, tetapi\Nmelihat suami anda menjelaskannya.
Dialog: 0,1:09:01.84,1:09:03.67,Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,1:09:03.72,1:09:05.42,Lalai,,0,0,0,,Anda lihat,
Dialog: 0,1:09:05.51,1:09:10.34,Lalai,,0,0,0,,Saya lebih suka melihat suami saya daripada di tempat lain.
Dialog: 0,1:09:11.64,1:09:14.05,Lalai,,0,0,0,,Dia kacak.
Dialog: 0,1:09:14.48,1:09:16.01,Lalai,,0,0,0,,Ini dia.
Dialog: 0,1:09:23.65,1:09:25.80,Lalai,,0,0,0,,Sayang, awak dah cuba ke belum?
Dialog: 0,1:09:25.82,1:09:28.48,Lalai,,0,0,0,,Ia benar-benar sesuatu.
Dialog: 0,1:09:29.12,1:09:30.89,Lalai,,0,0,0,,- Awak datang ke sini untuk makan?\N- Apa?
Dialog: 0,1:09:30.91,1:09:33.07,Lalai,,0,0,0,,Saya tidak mahu melihatnya.
Dialog: 0,1:09:35.33,1:09:37.91,Lalai,,0,0,0,,Saya bercakap tentang wajah awak.
Dialog: 0,1:09:38.13,1:09:39.83, Lalai,,0,0,0,, Pergi.
Dialog: 0,1:09:40.17,1:09:42.46,Lalai,,0,0,0,,Hati? awak kecik...!
Dialog: 0,1:09:50.06,1:09:51.76,Lalai,,0,0,0,,Di sini.
Dialog: 0,1:09:52.60,1:09:54.55,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:09:58.11,1:10:00.47,Lalai,,0,0,0,,Saya terfikir tentang Hae-in dari semasa ke semasa,
Dialog: 0,1:10:01.03,1:10:03.39,Lalai,,0,0,0,,jadi terasa ganjil...
Dialog: 0,1:10:03.90,1:10:05.60,Lalai,,0,0,0,,untuk bertemu suaminya.
Dialog: 0,1:10:10.99,1:10:12.47,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:10:12.49,1:10:15.70,Lalai,,0,0,0,,Nah, Hae-in dan saya...
Dialog: 0,1:10:17.37,1:10:20.66,Lalai,,0,0,0,,mempunyai hubungan yang baik pada masa lalu.
Dialog: 0,1:10:23.92,1:10:25.53,Lalai,,0,0,0,,Hae-in bukan jenis...
Dialog: 0,1:10:25.55,1:10:29.59,Lalai,,0,0,0,,yang mempunyai banyak hubungan\N yang baik sepanjang hayatnya.
Dialog: 0,1:10:30.22,1:10:32.13,Lalai,,0,0,0,,Itu agak mengagumkan.
Dialog: 0,1:10:33.85,1:10:35.55,Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,1:10:37.06,1:10:39.16,Lalai,,0,0,0,,Saya sangat menyukainya.
Dialog: 0,1:10:40.41,1:10:42.35,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:10:43.98,1:10:45.69,Lalai,,0,0,0,,Ia tidak mengganggu anda?
Dialog: 0,1:10:46.03,1:10:47.21,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:10:47.24,1:10:50.65,Lalai,,0,0,0,,Itu hanya bermaksud satu daripada dua perkara.
Dialog: 0,1:10:50.82,1:10:54.36,Lalai,,0,0,0,,Anda mempercayainya sepenuhnya,\Anda juga tidak peduli.
Dialog: 0,1:10:56.12,1:10:57.70,Lalai,,0,0,0,,Adakah ia yang terakhir?
Dialog: 0,1:11:02.75,1:11:04.33,Lalai,,0,0,0,,Saya cuma bergurau.
Dialog: 0,1:11:09.80,1:11:11.28,Lalai,,0,0,0,,En. Yoon.
Dialog: 0,1:11:11.30,1:11:12.82,Lalai,,0,0,0,,Datang.
Dialog: 0,1:11:12.85,1:11:14.59,Lalai,,0,0,0,,Selamat tinggal.
Dialog: 0,1:11:21.61,1:11:23.43,Lalai,,0,0,0,,Si brengsek itu.
Dialog: 0,1:11:26.82,1:11:28.52,Lalai,,0,0,0,,Bagaimana dia tahu?
Dialog: 0,1:11:31.57,1:11:33.32,Lalai,,0,0,0,,Saya tersinggung.
Dialog: 0,1:11:39.33,1:11:40.43,Lalai,,0,0,0,,Sungguh tidak masuk akal.
Dialog: 0,1:11:40.46,1:11:43.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sejujurnya, saya sangat menyukainya.{\c}{\i0}
Dialog: 0,1:11:44.09,1:11:46.12,Lalai,,0,0,0,,Jika dia benar...
Dialog: 0,1:11:46.42,1:11:47.65,Lalai,,0,0,0,,sangat menyukainya,
Dialog: 0,1:11:47.67,1:11:50.40,Lalai,,0,0,0,,maka dia sepatutnya bekerja keras dan mengahwininya.
Dialog: 0,1:11:50.43,1:11:53.34,Lalai,,0,0,0,,Kalau begitu dia akan menyelamatkan nyawa saya.
Dialog: 0,1:11:54.35,1:11:58.17,Lalai,,0,0,0,,Apa gunanya memberitahu\N perasaan dia sekarang?
Dialog: 0,1:11:58.98,1:12:01.43,Lalai,,0,0,0,,Adakah dia mengusik saya, atau apa?
Dialog: 0,1:12:07.57,1:12:09.81,Lalai,,0,0,0,,Sakit yang menjengkelkan.
Dialog: 0,1:13:06.92,1:13:08.50,Lalai,,0,0,0,,Helo.
Dialog: 0,1:13:09.09,1:13:11.16,Lalai,,0,0,0,,- Kita jumpa lagi.\N- Hello.
Dialog: 0,1:13:11.67,1:13:15.79,Lalai,,0,0,0,,Astaga. Bukankah tempat ini penuh sesak?
Dialog: 0,1:13:18.01,1:13:19.32,Lalai,,0,0,0,,Anda betul.
Dialog: 0,1:13:19.35,1:13:22.99,Lalai,,0,0,0,,Lebih separuh daripada orang ini datang menemuinya.
Dialog: 0,1:13:23.02,1:13:25.35,Lalai,,0,0,0,,Mereka mahu berjumpa dengannya.
Dialog: 0,1:13:27.65,1:13:31.75,Lalai,,0,0,0,,Apa yang dia buat?
Dialog: 0,1:13:31.78,1:13:33.38,Lalai,,0,0,0,,{\i1}Dia seorang hartawan.{\i0}
Dialog: 0,1:13:33.40,1:13:35.40,Lalai,,0,0,0,,Malah orang terkaya dari Wall Street...
Dialog: 0,1:13:35.43,1:13:39.22,Default,,0,0,0,,pinjam duit minyak dari dia.
Dialog: 0,1:13:39.24,1:13:41.72,Lalai,,0,0,0,,Pengerusi Yeom pun teringin nak jumpa dia.
Dialog: 0,1:13:41.75,1:13:45.02,Lalai,,0,0,0,,Soo-cheol juga cuba berjumpa dengannya,
Dialog: 0,1:13:45.04,1:13:46.52,Lalai,,0,0,0,,tetapi ia bukan mudah.
Dialog: 0,1:13:46.54,1:13:49.85,Lalai,,0,0,0,,Dan Yoon Eun-sung ini menghadiri\N kolej yang sama dengan Hae-in?
Dialog: 0,1:13:49.88,1:13:51.83,Lalai,,0,0,0,,Ya.
Dialog: 0,1:13:51.88,1:13:55.78,Lalai,,0,0,0,,Saya tidak tahu apa yang hendak saya katakan\Npada anda pada masa-masa seperti ini.
Dialog: 0,1:13:55.80,1:13:57.07,Lalai,,0,0,0,,Mengapa anda berasa teruk?
Dialog: 0,1:13:57.09,1:13:58.45,Lalai,,0,0,0,,Saya sepatutnya memperkenalkan...
Dialog: 0,1:13:58.47,1:14:01.70,Lalai,,0,0,0,,seseorang seperti dia kepada Cik Hong Hae-in.
Dialog: 0,1:14:01.72,1:14:04.45,Lalai,,0,0,0,,Apa yang dia boleh buat? Dia menggali kuburnya sendiri.
Dialog: 0,1:14:04.48,1:14:07.50,Lalai,,0,0,0,,Namun, saya menyesal kerana tidak berusaha lebih keras.
Dialog: 0,1:14:07.52,1:14:09.10,Lalai,,0,0,0,,Untuk melakukan apa?
Dialog: 0,1:14:16.24,1:14:18.88,Lalai,,0,0,0,,Saya rasa anda silap.
Dialog: 0,1:14:18.91,1:14:21.73,Lalai,,0,0,0,,Saya sentiasa bersyukur...
Dialog: 0,1:14:22.29,1:14:24.89,Lalai,,0,0,0,,bahawa anda tidak berusaha lebih keras.
Dialog: 0,1:14:24.91,1:14:28.35,Lalai,,0,0,0,,Saya amat berterima kasih kerana anda\Mengecualikan saya daripada senarai anda...
Dialog: 0,1:14:28.38,1:14:29.73,Lalai,,0,0,0,, calon perkahwinan,
Dialog: 0,1:14:29.75,1:14:34.75,Lalai,,0,0,0,,jadi selamatkan diri anda daripada rasa bersalah yang tidak berguna itu.
Dialog: 0,1:14:37.30,1:14:38.28,Lalai,,0,0,0,,Kenapa awak telefon?
Dialog: 0,1:14:38.30,1:14:39.82,Lalai,,0,0,0,,Anda mendengar kami.
Dialog: 0,1:14:39.85,1:14:43.63,Lalai,,0,0,0,,Jemput Yoon Eun-sung ke pemburuan keluarga kami.
Dialog: 0,1:14:46.52,1:14:51.68,Lalai,,0,0,0,,Betul. Saya boleh jamin\Ndia akan datang jika saya beritahu dia,
Dialog: 0,1:14:54.32,1:14:57.77,Lalai,,0,0,0,,tetapi mengapa saya perlu berbuat demikian? Saya tidak mempunyai sebab untuk.
Dialog: 0,1:14:59.78,1:15:01.48,Lalai,,0,0,0,,Saya akan tarik balik...
Dialog: 0,1:15:03.12,1:15:04.94,Lalai,,0,0,0,,gugatan.
Dialog: 0,1:15:34.73,1:15:36.31,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:17:03.24,1:17:05.68,Lalai,,0,0,0,,Berikut ialah bilangan mangsa yang boleh anda tangkap.
Dialog: 0,1:17:05.70,1:17:07.89,Lalai,,0,0,0,,Tiada had untuk burung murai dan burung gagak.
Dialog: 0,1:17:07.91,1:17:12.43,Lalai,,0,0,0,,Bagi babi hutan, rusa air dan burung pegar,\Nyou setiap satu boleh menangkap maksimum lima orang.
Dialog: 0,1:17:12.46,1:17:15.69,Lalai,,0,0,0,,Kemalangan mungkin berlaku jika\Anda menghalang satu sama lain,
Dialog: 0,1:17:15.71,1:17:18.02,Lalai,,0,0,0,,dan silap antara satu sama lain sebagai haiwan,
Dialog: 0,1:17:18.05,1:17:21.41,Lalai,,0,0,0,,jadi pastikan anda kekal dalam laluan anda.
Dialog: 0,1:17:21.72,1:17:24.69,Lalai,,0,0,0,,Anda tidak sepatutnya memburu babi sendirian.
Dialog: 0,1:17:24.72,1:17:29.45,Lalai,,0,0,0,,Jangan halakan atau pusingkan\N anda padanya jika anda bersendirian.
Dialog: 0,1:17:29.47,1:17:30.78,Lalai,,0,0,0,,Bolehkah kita benarkan dia menggunakan senjata api?
Dialog: 0,1:17:30.81,1:17:31.87,Lalai,,0,0,0,,Seperti yang anda sedia maklum...
Dialog: 0,1:17:31.89,1:17:34.84,Lalai,,0,0,0,,Apa yang boleh kita lakukan? Dia memilih untuk membawa satu.
Dialog: 0,1:17:34.94,1:17:37.14,Lalai,,0,0,0,,Bagaimana jika dia melakukan pembunuhan?
Dialog: 0,1:17:41.28,1:17:43.80,Lalai,,0,0,0,,Lihat pandangan membunuh itu.
Dialog: 0,1:17:43.82,1:17:45.42,Lalai,,0,0,0,,Dia sepatutnya pergi...
Dialog: 0,1:17:45.45,1:17:48.78,Lalai,,0,0,0,,ke hospital mental, bukan penjara.
Dialog: 0,1:17:49.37,1:17:50.51,Lalai,,0,0,0,,Jom.
Dialog: 0,1:17:50.54,1:17:52.70,Lalai,,0,0,0,,Makcik, kita perlu bergerak.
Dialog: 0,1:17:54.96,1:17:56.82,Lalai,,0,0,0,,Di sini.
Dialog: 0,1:18:00.00,1:18:02.37,Lalai,,0,0,0,,Jangan pegang senjata api macam tu.
Dialog: 0,1:18:10.47,1:18:13.37,Lalai,,0,0,0,,Adakah saya memukulnya? Saya tidak boleh melihat dengan baik.
Dialog: 0,1:18:13.39,1:18:14.70,Lalai,,0,0,0,,Awak buat, Ayah.
Dialog: 0,1:18:14.73,1:18:18.30,Lalai,,0,0,0,,Yang terbesar jatuh. Astaga.
Dialog: 0,1:18:18.40,1:18:20.72,Lalai,,0,0,0,,Saya juga melihatnya, Datuk. Astaga!
Dialog: 0,1:18:21.15,1:18:24.55,Lalai,,0,0,0,,Adakah anda? Saya percaya saya juga begitu.
Dialog: 0,1:18:24.57,1:18:26.23,Lalai,,0,0,0,,Anda lakukan.
Dialog: 0,1:18:27.78,1:18:29.44,Lalai,,0,0,0,,Adakah anda benar-benar memahaminya?
Dialog: 0,1:18:29.53,1:18:32.07,Lalai,,0,0,0,,Saya rasa tidak ada yang jatuh.
Dialog: 0,1:18:36.62,1:18:39.06,Lalai,,0,0,0,,Hyun-woo, adakah anda penduduk asli Amerika,
Dialog: 0,1:18:39.08,1:18:41.65,Lalai,,0,0,0,,atau pemburu Mongolia?\NIAdakah penglihatan anda begitu hebat?
Dialog: 0,1:18:41.67,1:18:43.82,Lalai,,0,0,0,,Saya rasa ia jatuh ke dalam hutan.
Dialog: 0,1:18:43.84,1:18:46.87,Lalai,,0,0,0,,Saya akan beritahu lelaki kita untuk mendapatkannya.
Dialog: 0,1:18:47.30,1:18:50.45,Lalai,,0,0,0,,Bagaimana jika Hyun-woo pulang ke rumah\Nempty-handed tahun ini juga?
Dialog: 0,1:18:50.47,1:18:52.05,Lalai,,0,0,0,,Betul.
Dialog: 0,1:18:52.14,1:18:53.45,Lalai,,0,0,0,,Dia betul.
Dialog: 0,1:18:53.47,1:18:58.47,Lalai,,0,0,0,,Anda tidak pernah menangkap apa-apa dalam pemburuan kami.
Dialog: 0,1:19:01.61,1:19:04.59,Lalai,,0,0,0,,Kami datang ke sini setiap tahun. Awak patut belajar.
Dialog: 0,1:19:04.61,1:19:06.96,Lalai,,0,0,0,,Adakah anda takut dengan senjata api?\NAnda berkhidmat dalam tentera,
Dialog: 0,1:19:06.99,1:19:08.42,Lalai,,0,0,0,,jadi patutkah saya ajar awak?
Dialog: 0,1:19:08.45,1:19:11.22,Lalai,,0,0,0,,Tidak mengapa. Anda harus risau tentang diri anda.
Dialog: 0,1:19:11.24,1:19:14.65,Lalai,,0,0,0,,Saya sudah mahir. Itulah sebabnya saya menawarkan diri untuk mengajar anda.
Dialog: 0,1:19:15.54,1:19:17.72,Lalai,,0,0,0,,Bagaimana dengan anda? Adakah anda baik?
Dialog: 0,1:19:17.75,1:19:21.14,Lalai,,0,0,0,,Saya tidak pasti. Saya ragu saya boleh\Nmegang lilin kepada anda semua.
Dialog: 0,1:19:21.17,1:19:23.95,Lalai,,0,0,0,,Dia merendah diri dalam segala hal.
Dialog: 0,1:19:24.09,1:19:25.40,Lalai,,0,0,0,,Betul.
Dialog: 0,1:19:25.42,1:19:29.49,Lalai,,0,0,0,,Mari kita lihat siapa yang akan menangkap\Npheasants untuk sup {\i1}mandu{\i0} tahun ini.
Dialog: 0,1:19:29.51,1:19:31.29,Lalai,,0,0,0,,Mari kita mulakan.
Dialog: 0,1:19:31.43,1:19:32.61,Lalai,,0,0,0,,Jom.
Dialog: 0,1:19:32.64,1:19:34.92,Lalai,,0,0,0,,- Jom.\N- Baiklah.
Dialog: 0,1:19:50.91,1:19:53.02,Lalai,,0,0,0,,Tangkap sesuatu sekali.
Dialog: 0,1:19:53.58,1:19:57.64,Lalai,,0,0,0,,Ada sebab datuk\Nmembawa kami ke gunung ini...
Dialog: 0,1:19:57.66,1:19:59.31,Lalai,,0,0,0,,untuk memburu setiap tahun.
Dialog: 0,1:19:59.33,1:20:00.31,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:20:00.33,1:20:04.10,Lalai,,0,0,0,,Adakah dia mahu kita berpura-pura\Dia berjaya menembak itik,
Dialog: 0,1:20:04.13,1:20:05.79,Lalai,,0,0,0,,dan puji dia?
Dialog: 0,1:20:06.46,1:20:08.40,Lalai,,0,0,0,,Stamina penting semasa memburu,
Dialog: 0,1:20:08.42,1:20:11.11,Lalai,,0,0,0,,tetapi pertimbangan pantas dan objektif\Nkeputusan juga diperlukan,
Dialog: 0,1:20:11.13,1:20:14.66,Lalai,,0,0,0,, dan itu semua adalah nilai murni yang harus ada pada mereka yang menjalankan perniagaan.
Dialog: 0,1:20:14.68,1:20:16.57,Lalai,,0,0,0,,Itulah sebabnya anda menangkap begitu ramai setiap tahun,
Dialog: 0,1:20:16.60,1:20:19.63,Lalai,,0,0,0,,untuk membuktikan kepadanya bahawa anda\Na ahli perniagaan yang layak?
Dialog: 0,1:20:19.81,1:20:21.45,Lalai,,0,0,0,,Sudah tentu,
Dialog: 0,1:20:21.48,1:20:24.93,Lalai,,0,0,0,,dan saya akan dapat yang paling banyak tahun ini juga.
Dialog: 0,1:20:27.32,1:20:29.77,Lalai,,0,0,0,,Luangkan masa anda.
Dialog: 0,1:20:35.24,1:20:38.03,Lalai,,0,0,0,,Ya, sudah sedia.
Dialog: 0,1:20:39.91,1:20:42.07,Lalai,,0,0,0,,Ia dekat tengah...
Dialog: 0,1:20:42.33,1:20:43.39,Lalai,,0,0,0,,sudah tentu.
Dialog: 0,1:20:43.42,1:20:45.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Habitat Babi Hutan{\c}{\i0}
Dialog: 0,1:20:45.54,1:20:47.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kawasan Terhad\NHartanah Milik Ratu{\c}{\i0}
Dialog: 0,1:21:07.19,1:21:10.18,Lalai,,0,0,0,,Di manakah dia?
Dialog: 0,1:21:10.69,1:21:12.21,Lalai,,0,0,0,,{\i1}Panggilan anda tidak boleh disambungkan.{\i0}
Dialog: 0,1:21:12.24,1:21:13.94,Lalai,,0,0,0,,Sialan.
Dialog: 0,1:21:39.35,1:21:42.80,Lalai,,0,0,0,,Maaf. Saya fikir anda adalah rusa air.
Dialog: 0,1:21:43.27,1:21:45.18,Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,1:21:45.31,1:21:47.43,Lalai,,0,0,0,,Ini bukan kursus anda.
Dialog: 0,1:21:47.90,1:21:50.89,Lalai,,0,0,0,,Bukan? Ini kali pertama saya memburu.
Dialog: 0,1:21:51.28,1:21:55.98,Lalai,,0,0,0,,Tidakkah anda tahu ia boleh membawa maut untuk menyerang\nwilayah orang lain semasa memburu?
Dialog: 0,1:21:59.08,1:22:00.82,Lalai,,0,0,0,,Saya tidak tahu itu.
Dialog: 0,1:22:01.24,1:22:04.70,Lalai,,0,0,0,,Saya berharap untuk mengetahui lebih lanjut daripada anda.
Dialog: 0,1:22:20.14,1:22:23.17,Lalai,,0,0,0,,Anda tidak sepatutnya melakukan apa-apa\N di wilayah orang lain.
Dialog: 0,1:22:24.77,1:22:27.72,Lalai,,0,0,0,,Awak mahu saya ajar awak, bukan?
Dialog: 0,1:22:50.92,1:22:52.95,Lalai,,0,0,0,,Apa salah saya?
Dialog: 0,1:22:54.38,1:22:56.25,Lalai,,0,0,0,,Itu hanya {\i1}mandu.{\i0}
Dialog: 0,1:22:56.47,1:22:57.94,Lalai,,0,0,0,,Itu hanya sup pegar.
Dialog: 0,1:22:57.97,1:22:59.96,Lalai,,0,0,0,,Ia adalah pegar {\i1}mandu.{\i0}
Dialog: 0,1:23:00.64,1:23:02.84,Lalai,,0,0,0,,Sup pheasant.
Dialog: 0,1:24:08.37,1:24:12.12,Lalai,,0,0,0,,Jangan menipu diri sendiri. Ini tidak benar.
Dialog: 0,1:24:12.17,1:24:14.12,Lalai,,0,0,0,,Tarik keluar, Hae-in.
Dialog: 0,1:24:15.17,1:24:17.25,Lalai,,0,0,0,,Tarik keluar.
Dialog: 0,1:24:39.03,1:24:40.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa yang anda katakan?{\c}{\i0}
Dialog: 0,1:24:45.99,1:24:49.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya hampir mati. Saya ada tiga bulan lagi.{\c}{\i0}
Dialog: 0,1:24:50.41,1:24:52.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak, Hong Hae-in.{\c}{\i0}
Dialog: 0,1:24:53.12,1:24:54.99,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak.{\c}{\i0}
Dialog: 0,1:25:28.91,1:25:30.49,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:25:51.93,1:25:54.75,Lalai,,0,0,0,,Anda enggan bertemu dengan\Npenjawat awam atau guru muzik itu.
Dialog: 0,1:25:54.77,1:25:56.62,Default,,0,0,0,,Kenapa tiba-tiba nak suri rumah?
Dialog: 0,1:25:56.65,1:25:59.38,Lalai,,0,0,0,,Bukankah anda mengatakan bahawa pelatih\N akan dipecat tidak lama lagi?
Dialog: 0,1:25:59.40,1:26:00.75,Lalai,,0,0,0,,Seseorang yang menganggur?
Dialog: 0,1:26:00.78,1:26:04.66,Lalai,,0,0,0,,Saya tidak mahu menekan anda, tetapi bagaimana\Nanda akan menyimpan wang untuk membeli rumah?
Dialog: 0,1:26:04.68,1:26:05.71,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,1:26:05.74,1:26:09.09,Lalai,,0,0,0,,Saya tidak sangka menantu yang kaya...
Dialog: 0,1:26:09.12,1:26:11.43,Lalai,,0,0,0,,hanya kerana anda belajar undang-undang di SNU.
Dialog: 0,1:26:11.45,1:26:12.89,Lalai,,0,0,0,,Saya cuma berharap...
Dialog: 0,1:26:12.91,1:26:15.18,Lalai,,0,0,0,,dia tidak akan lebih miskin daripada kita. Itu sahaja.
Dialog: 0,1:26:15.21,1:26:18.45,Lalai,,0,0,0,,- Betul sekali.\N- Saya tidak pernah berasa begini sebelum ini.
Dialog: 0,1:26:21.50,1:26:23.41,Lalai,,0,0,0,,Dia sentiasa...
Dialog: 0,1:26:24.26,1:26:26.04,Lalai,,0,0,0,,di fikiran saya.
Dialog: 0,1:26:26.47,1:26:29.32,Lalai,,0,0,0,,Saya tertanya-tanya kenapa pakaiannya\Selalu berlubang.
Dialog: 0,1:26:29.35,1:26:32.53,Lalai,,0,0,0,,Saya khuatir dia akan\Pergi menendang sesuatu.
Dialog: 0,1:26:32.56,1:26:35.04,Default,,0,0,0,,Saya risau dia dimarahi lagi.
Dialog: 0,1:26:35.06,1:26:37.00,Lalai,,0,0,0,,Saya teringat dia apabila saya makan makanan yang sedap.
Dialog: 0,1:26:37.02,1:26:39.14,Lalai,,0,0,0,,Saya nak bawa dia.
Dialog: 0,1:26:39.27,1:26:40.97,Lalai,,0,0,0,,Saya sangat terganggu...
Dialog: 0,1:26:41.69,1:26:44.18,Lalai,,0,0,0,,kerana dia.
Dialog: 0,1:26:44.74,1:26:46.60,Lalai,,0,0,0,,Dia akan menjadi kematian saya.
Dialog: 0,1:26:50.95,1:26:52.99,Lalai,,0,0,0,,Kemudian kahwini dia.
Dialog: 0,1:26:53.33,1:26:54.97,Lalai,,0,0,0,,- Sayang.\N- Mak.
Dialog: 0,1:26:55.00,1:26:57.10,Lalai,,0,0,0,,Kahwini dia jika ia serius.
Dialog: 0,1:26:57.12,1:26:58.93,Lalai,,0,0,0,,Ia lebih baik daripada mati.
Dialog: 0,1:26:58.96,1:27:02.37,Lalai,,0,0,0,,Ya, itu benar, tetapi...
Dialog: 0,1:27:03.88,1:27:06.62,Lalai,,0,0,0,,Ya, saya akan.
Dialog: 0,1:27:10.22,1:27:12.42,Lalai,,0,0,0,,Kami akan berkahwin,
Dialog: 0,1:27:15.18,1:27:17.59,Lalai,,0,0,0,, dan saya akan melindunginya selama-lamanya.
Dialog: 0,1:27:24.82,1:27:27.65,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:27:54.97,1:27:57.95,Lalai,,0,0,0,,{\an8}{\i1}Adakah wanita yang hatinya masih berdebar...{\i0}
Dialog: 0,1:27:57.98,1:28:00.29,Lalai,,0,0,0,,{\an8}{\i1}apabila mereka melihat suami mereka,\Nwalaupun sudah berkahwin...{\i0}
Dialog: 0,1:28:00.31,1:28:02.55,Lalai,,0,0,0,,{\an8}{\i1}selama lebih tiga tahun?{\i0}
Dialog: 0,1:28:02.90,1:28:04.17,Lalai,,0,0,0,,{\an8}{\i1}Tidak boleh.{\i0}
Dialog: 0,1:28:04.19,1:28:06.63,Lalai,,0,0,0,,{\an8}{\i1}Saya perasan pagar telah terbuka.{\i0}
Dialog: 0,1:28:06.65,1:28:09.30,Lalai,,0,0,0,,{\an8}{\i1}Anda sebenarnya percaya dia mencintai anda.{\i0}
Dialog: 0,1:28:09.32,1:28:11.36,Lalai,,0,0,0,,{\an8}{\i1}Ya, saya lakukan.{\i0}
Dialog: 0,1:28:11.70,1:28:16.64,Lalai,,0,0,0,,{\an8}{\i1}Saya tidak pernah sejengkel ini\Ndengan senyuman seseorang.{\i0}
Dialog: 0,1:28:16.66,1:28:18.10,Lalai,,0,0,0,,{\an8}{\i1}Saya akan bunuh...{\i0}
Dialog: 0,1:28:18.12,1:28:20.43,Lalai,,0,0,0,,{\an8}{\i1}setiap bajingan yang mengkhianati...{\i0}
Dialog: 0,1:28:20.46,1:28:23.03,Lalai,,0,0,0,,{\an8}{\i1}dan tikam saya dari belakang.{\i0}
Dialog: 0,1:28:23.25,1:28:25.45,Lalai,,0,0,0,,{\an8}{\i1}Jangan takut.{\i0}
Dialog: 0,1:28:26.67,1:28:27.94,Lalai,,0,0,0,,{\an8}{\i1}Itu kerana saya takut.{\i0}
Dialog: 0,1:28:27.96,1:28:30.83,Lalai,,0,0,0,,{\an8}{\i1}Itulah sebabnya jantung saya berdegup kencang.{\i0}
