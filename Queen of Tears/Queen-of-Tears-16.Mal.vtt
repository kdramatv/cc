Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.68,0:01:03.83, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod Akhir{\c}{\i0}
Dialog: 0,0:01:38.80,0:01:40.54, Lalai,,0,0,0,, Hae-in?
Dialog: 0,0:02:13.38,0:02:15.50, Lalai,,0,0,0,,Sila keluar, tuan.
Dialog: 0,0:02:16.51,0:02:18.50,Lalai,,0,0,0,,Keluar.
Dialog: 0,0:02:32.36,0:02:34.18, Lalai,,0,0,0,,Ia lelaki, 35. Pesakit kemalangan lalu lintas.
Dialog: 0,0:02:34.21,0:02:35.54, Lalai,,0,0,0,,Dia tidak sedarkan diri.
Dialog: 0,0:02:35.57,0:02:38.35, Lalai,,0,0,0,,- Alih ke tepi.\N- Datang.
Dialog: 0,0:02:40.16,0:02:42.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sudikah awak berkahwin dengan saya?{\c}{\i0}
Dialog: 0,0:02:45.49,0:02:48.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika kita berkahwin,{\c}{\i0}
Dialog: 0,0:02:49.33,0:02:52.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anda mungkin agak terkejut dengan siapa saya.{\c}{\i0}
Dialog: 0,0:02:52.17,0:02:54.31,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda mungkin tidak tahu perkara ini,{\c}{\i0}
Dialog: 0,0:02:54.34,0:02:56.77,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi keluarga saya berbeza daripada keluarga anda.{\c}{\i0}
Dialog: 0,0:02:56.80,0:02:58.86, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka tidak mungkin berbeza.{\c}{\i0}
Dialog: 0,0:02:58.88,0:03:00.15, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda silap.{\c}{\i0}
Dialog: 0,0:03:00.17,0:03:03.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda hanya tidak tahu, tetapi\N keluarga saya sangat berbeza,{\c}{\i0}
Dialog: 0,0:03:03.76,0:03:06.99,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi anda mungkin bingung\Nand bergelut untuk bergaul dengan mereka,{\c}{\i0}
Dialog: 0,0:03:07.02,0:03:09.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}walaupun anda bersabar dengan\Semuanya dan berasa sunyi,{\c}{\i0}
Dialog: 0,0:03:10.10,0:03:12.18,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak akan dapat menyebelahi anda.{\c}{\i0}
Dialog: 0,0:03:13.86,0:03:16.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda menolak...{\c}{\i0}
Dialog: 0,0:03:16.11,0:03:17.71, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}cadangan saya?{\c}{\i0}
Dialog: 0,0:03:17.73,0:03:19.09,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}No.{\c}{\i0}
Dialog: 0,0:03:19.11,0:03:22.09,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan membuatnya pendek jika saya melakukannya.{\c}{\i0}
Dialog: 0,0:03:22.11,0:03:24.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu sahaja yang penting.{\c}{\i0}
Dialog: 0,0:03:24.78,0:03:27.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini bukan perkara mudah.{\c}{\i0}
Dialog: 0,0:03:27.16,0:03:29.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tetapi saya okay.{\c}{\i0}
Dialog: 0,0:03:35.79,0:03:38.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika anda benar-benar okay...{\c}{\i0}
Dialog: 0,0:03:41.34,0:03:43.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mahu berkahwin dengan awak.{\c}{\i0}
Dialog: 0,0:03:44.30,0:03:47.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mahu tinggal bersama kamu.{\c}{\i0}
Dialog: 0,0:03:55.65,0:03:56.62, Lalai,,0,0,0,,Apakah vitalnya?
Dialog: 0,0:03:56.65,0:03:58.13, Lalai,,0,0,0,,BPnya ialah 101/66.
Dialog: 0,0:03:58.15,0:03:59.21, Lalai,,0,0,0,,Oksigennya ialah 92%...
Dialog: 0,0:03:59.23,0:04:01.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Katakan kita berkahwin.{\c}{\i0}
Dialog: 0,0:04:01.28,0:04:03.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Walaupun anda tidak menyebelahi saya,{\c}{\i0}
Dialog: 0,0:04:03.49,0:04:06.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya boleh berpihak kepada awak, bukan?{\c}{\i0}
Dialog: 0,0:04:06.49,0:04:09.36, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemudian kami akan berada dalam pasukan yang sama, bagaimanapun.{\c}{\i0}
Dialog: 0,0:04:09.54,0:04:11.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah perkahwinan.{\c}{\i0}
Dialog: 0,0:04:11.45,0:04:14.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berada di pihak yang sama dan di atas bot yang sama,{\c}{\i0}
Dialog: 0,0:04:14.25,0:04:18.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan jika bot itu terbalik,\Nmaka kita turun bersama-sama.{\c}{\i0}
Dialog: 0,0:04:18.17,0:04:21.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika anda hidup, maka saya juga akan hidup.{\c}{\i0}
Dialog: 0,0:04:23.13,0:04:24.75, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Begitulah.{\c}{\i0}
Dialog: 0,0:04:26.34,0:04:27.88, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betulkah?{\c}{\i0}
Dialog: 0,0:04:30.85,0:04:33.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda mungkin tidak tahu perkara ini,{\c}{\i0}
Dialog: 0,0:04:33.43,0:04:37.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi hidup ini tidak mudah.{\c}{\i0}
Dialog: 0,0:04:37.02,0:04:39.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya pernah menjadi mangsa penipuan hartanah.{\c}{\i0}
Dialog: 0,0:04:39.23,0:04:40.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tetapi anda seorang peguam.{\c}{\i0}
Dialog: 0,0:04:40.40,0:04:42.31,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tahu, kan?{\c}{\i0}
Dialog: 0,0:04:44.28,0:04:45.63, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda lihat,{\c}{\i0}
Dialog: 0,0:04:45.66,0:04:48.19, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}penipu profesional...{\c}{\i0}
Dialog: 0,0:04:48.28,0:04:51.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}lebih bijak daripada peguam.{\c}{\i0}
Dialog: 0,0:04:52.58,0:04:54.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya benar-benar tertipu,{\c}{\i0}
Dialog: 0,0:04:56.46,0:04:58.64, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi pada masa hadapan,{\c}{\i0}
Dialog: 0,0:04:58.67,0:05:00.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}akan ada banyak kali...{\c}{\i0}
Dialog: 0,0:05:00.59,0:05:02.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}apabila saya lebih terpegun,{\c}{\i0}
Dialog: 0,0:05:02.71,0:05:04.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}salah,{\c}{\i0}
Dialog: 0,0:05:04.26,0:05:06.07, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan kecewa,{\c}{\i0}
Dialog: 0,0:05:06.09,0:05:09.34,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi saya amat gembira...{\c}{\i0}
Dialog: 0,0:05:09.60,0:05:13.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jika anda menaiki bot saya.{\c}{\i0}
Dialog: 0,0:05:14.06,0:05:16.18,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Walaupun kita perlu menyelamatkan air...{\c}{\i0}
Dialog: 0,0:05:16.35,0:05:19.81, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan berbaris sepanjang malam, saya akan mempunyai seseorang...{\c}{\i0}
Dialog: 0,0:05:20.82,0:05:22.60, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}untuk bergantung.{\c}{\i0}
Dialog: 0,0:05:23.57,0:05:24.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bukankah kita patut berkahwin dengan seseorang...{\c}{\i0}
Dialog: 0,0:05:24.90,0:05:27.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}siapa yang membuatkan kita berasa begitu?{\c}{\i0}
Dialog: 0,0:05:27.57,0:05:29.09,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya...{\c}{\i0}
Dialog: 0,0:05:29.12,0:05:30.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya...{\c}{\i0}
Dialog: 0,0:05:32.99,0:05:36.07, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}melamar anda hari ini.{\c}{\i0}
Dialog: 0,0:06:11.87,0:06:13.73, Lalai,,0,0,0,,Di mana dia?
Dialog: 0,0:06:14.33,0:06:16.72, Lalai,,0,0,0,, Di sini?
Dialog: 0,0:06:16.75,0:06:18.99, Lalai,,0,0,0,,Di mana?
Dialog: 0,0:06:20.58,0:06:23.34, Lalai,,0,0,0,,Maafkan saya. anak saya...
Dialog: 0,0:06:23.36,0:06:24.35, Lalai,,0,0,0,,Dia ada di sini...
Dialog: 0,0:06:24.38,0:06:26.02, Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:06:26.05,0:06:27.27, Lalai,,0,0,0,,Doktor.
Dialog: 0,0:06:27.30,0:06:29.69, Lalai,,0,0,0,,Kami sedang mencari Baek Hyun-woo.
Dialog: 0,0:06:29.72,0:06:31.20,Lalai,,0,0,0,,Ya, dia...
Dialog: 0,0:06:31.22,0:06:32.57, Lalai,,0,0,0,,- Apa itu?\N- Kemalangan kereta.
Dialog: 0,0:06:32.59,0:06:34.03, Lalai,,0,0,0,,- Ya, kemalangan kereta.\N- Encik Baek?
Dialog: 0,0:06:34.06,0:06:35.03, Lalai,,0,0,0,,Adakah dia masih hidup?
Dialog: 0,0:06:35.06,0:06:36.24, Lalai,,0,0,0,,Ya.
Dialog: 0,0:06:36.27,0:06:38.16, Lalai,,0,0,0,,Rusuk dan hatinya cedera teruk.
Dialog: 0,0:06:38.18,0:06:40.95, Lalai,,0,0,0,,Mungkin terdapat pendarahan dalaman,\Njadi kita perlu membuat tindakan susulan.
Dialog: 0,0:06:40.98,0:06:42.16, Lalai,,0,0,0,, Alhamdulillah.
Dialog: 0,0:06:42.19,0:06:43.58, Lalai,,0,0,0,,Dia masih hidup.
Dialog: 0,0:06:43.61,0:06:45.13, Lalai,,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:06:45.15,0:06:46.67, Lalai,,0,0,0,, Sayang.
Dialog: 0,0:06:46.69,0:06:47.84, Lalai,,0,0,0,,Doktor.
Dialog: 0,0:06:47.86,0:06:49.84, Lalai,,0,0,0,,Di mana dia sekarang?
Dialog: 0,0:06:49.86,0:06:51.69, Lalai,,0,0,0,,Dia ada di sana.
Dialog: 0,0:06:53.03,0:06:55.44, Lalai,,0,0,0,,- Hyun-woo.\N- Dia telah diterima masuk.
Dialog: 0,0:07:00.12,0:07:01.75, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:08:05.65,0:08:07.33, Lalai,,0,0,0,,Adakah anda sudah bangun?
Dialog: 0,0:08:07.36,0:08:08.93, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:08:21.50,0:08:23.24, Lalai,,0,0,0,,Adakah anda melakukannya?
Dialog: 0,0:08:29.67,0:08:31.83, Lalai,,0,0,0,,Adakah anda membawa saya ke sini...
Dialog: 0,0:08:32.05,0:08:33.98, Lalai,,0,0,0,, melawan kehendak saya?
Dialog: 0,0:08:34.01,0:08:38.16, Lalai,,0,0,0,,Saya beritahu awak saya akan lakukan apa sahaja untuk melindungi awak.
Dialog: 0,0:08:38.18,0:08:40.55, Lalai,,0,0,0,,Itulah sebabnya anda melakukan ini?
Dialog: 0,0:08:40.68,0:08:44.84,Lalai,,0,0,0,,Ya, saya enggan melihat awak\Ntipu dan disakiti oleh Hyun-woo lagi.
Dialog: 0,0:08:45.10,0:08:46.68, Lalai,,0,0,0,,Itulah sebabnya...
Dialog: 0,0:08:47.86,0:08:50.14, Lalai,,0,0,0,,Saya terpaksa menggunakan kekerasan.
Dialog: 0,0:08:51.23,0:08:53.23, Lalai,,0,0,0,,Di mana kita?
Dialog: 0,0:08:55.07,0:08:56.69, Lalai,,0,0,0,,Jawab saya dahulu.
Dialog: 0,0:08:57.45,0:08:59.90,Lalai,,0,0,0,,Kenapa awak pergi ke sana untuk berjumpa dengannya?
Dialog: 0,0:09:04.58,0:09:06.70, Lalai,,0,0,0,,Anda tidak boleh menjawab saya.
Dialog: 0,0:09:13.59,0:09:16.21, Lalai,,0,0,0,,Berapa lama saya mesti memahami,
Dialog: 0,0:09:16.43,0:09:17.78,Lalai,,0,0,0,,pesakit,
Dialog: 0,0:09:17.80,0:09:19.67, Lalai,,0,0,0,,dan memaafkan?
Dialog: 0,0:09:22.43,0:09:24.72,Lalai,,0,0,0,,Saya tidak mahu marah awak.
Dialog: 0,0:09:25.81,0:09:28.64, Lalai,,0,0,0,,Sebenarnya, saya nampak buku nota.
Dialog: 0,0:09:29.65,0:09:32.96, Lalai,,0,0,0,,Seseorang telah menghantarnya dari Jerman.\NI mesti telah menulisnya sebelum pembedahan.
Dialog: 0,0:09:32.98,0:09:35.51,Lalai,,0,0,0,,Ia kelihatan seperti tulisan tangan saya,\Ntetapi butirannya berbeza...
Dialog: 0,0:09:35.53,0:09:37.05, Lalai,,0,0,0,, daripada apa yang anda beritahu saya,
Dialog: 0,0:09:37.07,0:09:38.34, Lalai,,0,0,0,,jadi saya ingin menyemak.
Dialog: 0,0:09:38.36,0:09:41.15, Lalai,,0,0,0,,Sebab itu saya mahu berdepan dengannya.
Dialog: 0,0:09:41.33,0:09:42.86, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:09:44.04,0:09:45.31, Lalai,,0,0,0,, Sejujurnya,
Dialog: 0,0:09:45.33,0:09:48.23, Lalai,,0,0,0,, sesiapa sahaja boleh menyalin tulisan tangan saya.
Dialog: 0,0:09:48.25,0:09:50.74, Lalai,,0,0,0,,Tiada bukti itu saya.
Dialog: 0,0:09:51.13,0:09:53.11, Lalai,,0,0,0,,Semuanya boleh dibuat-buat.
Dialog: 0,0:09:53.13,0:09:55.08, Lalai,,0,0,0,,Jadi?
Dialog: 0,0:09:56.63,0:09:58.11, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:09:58.13,0:10:00.96, Lalai,,0,0,0,,Saya tidak berfikir panjang. Sepatutnya saya tanya awak dulu.
Dialog: 0,0:10:06.06,0:10:10.50,Lalai,,0,0,0,,Saya minta maaf saya mengesyaki dan\Maafkan anda. Ia tidak akan berlaku lagi,
Dialog: 0,0:10:10.52,0:10:11.75,Lalai,,0,0,0,,jadi...
Dialog: 0,0:10:11.77,0:10:13.47, Lalai,,0,0,0,,mari...
Dialog: 0,0:10:14.40,0:10:16.10,Lalai,,0,0,0,,Jom pulang.
Dialog: 0,0:10:19.95,0:10:22.07, Lalai,,0,0,0,,Jika saya betul...
Dialog: 0,0:10:22.28,0:10:25.32, Lalai,,0,0,0,,dan anda tidak berfikir, kemudian dengarkan saya.
Dialog: 0,0:10:25.79,0:10:28.70,Lalai,,0,0,0,,Mari kita keluar bersama dan...
Dialog: 0,0:10:29.17,0:10:30.39,Lalai,,0,0,0,,berkahwin.
Dialog: 0,0:10:30.42,0:10:32.48,Lalai,,0,0,0,,Helikopter akan datang pada waktu subuh.
Dialog: 0,0:10:32.50,0:10:34.52, Lalai,,0,0,0,,Saya telah merancang segala-galanya.
Dialog: 0,0:10:34.55,0:10:36.25, Lalai,,0,0,0,,Anda hanya perlu...
Dialog: 0,0:10:36.42,0:10:38.12, Lalai,,0,0,0,,untuk mengikuti saya.
Dialog: 0,0:10:45.51,0:10:48.97, Lalai,,0,0,0,,Bagaimana pula dengan gedung serbaneka?\NI baru sahaja dipulihkan.
Dialog: 0,0:10:49.77,0:10:53.08,Lalai,,0,0,0,,Pengurus profesional boleh menguruskannya...
Dialog: 0,0:10:53.11,0:10:54.89, Lalai,,0,0,0,,sehingga anda kembali.
Dialog: 0,0:10:57.15,0:10:58.69, Lalai,,0,0,0,,Bolehkah itu?
Dialog: 0,0:11:07.54,0:11:09.07, Lalai,,0,0,0,,Jawab saya.
Dialog: 0,0:11:13.54,0:11:15.33, Lalai,,0,0,0,,Baiklah, mari kita buat.
Dialog: 0,0:11:21.68,0:11:24.20,Lalai,,0,0,0,,{\an8}Disebabkan oleh salji dan\plat lesen tidak berdaftar,
Dialog: 0,0:11:24.22,0:11:26.11,Lalai,,0,0,0,,Saya rasa saya tidak boleh menjejakinya lagi.
Dialog: 0,0:11:26.14,0:11:28.13, Lalai,,0,0,0,, Polis pun tak boleh.
Dialog: 0,0:11:31.05,0:11:32.70,Lalai,,0,0,0,,- Awak jumpa dia?\N- Kenapa awak ada di sini?
Dialog: 0,0:11:32.73,0:11:34.50,Lalai,,0,0,0,,- Bukankah awak berada di ED?\N- Jawab saya!
Dialog: 0,0:11:34.52,0:11:35.71, Lalai,,0,0,0,, Awak gila.
Dialog: 0,0:11:35.73,0:11:37.79, Lalai,,0,0,0,, Kembali ke hospital.
Dialog: 0,0:11:37.82,0:11:39.39,Lalai,,0,0,0,,Okey?
Dialog: 0,0:11:40.61,0:11:43.48,Lalai,,0,0,0,,Kenapa awak datang ke sini lewat malam?
Dialog: 0,0:11:48.91,0:11:50.47, Lalai,,0,0,0,,Anda lihat...
Dialog: 0,0:11:50.50,0:11:52.64, Lalai,,0,0,0,,Hyun-woo baru sahaja menghubungi saya.
Dialog: 0,0:11:52.67,0:11:53.81, Lalai,,0,0,0,, Hae-in hilang.
Dialog: 0,0:11:53.83,0:11:57.48, Lalai,,0,0,0,,- Hilang?\N- Dia hilang begitu sahaja.
Dialog: 0,0:11:57.50,0:12:01.36,Lalai,,0,0,0,,Dia memberitahu saya untuk tidak memberitahu anda\Nand untuk melihatnya secara berhemah,
Dialog: 0,0:12:01.38,0:12:02.78, Lalai,,0,0,0,,tetapi saya fikir anda patut tahu.
Dialog: 0,0:12:02.80,0:12:03.99,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Beritahu Cik Moh...{\c}{\i0}
Dialog: 0,0:12:04.01,0:12:06.00, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}bahawa Hae-in tiada.{\c}{\i0}
Dialog: 0,0:12:06.64,0:12:09.17, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia akan menjadi lebih pantas untuk dia mencarinya.{\c}{\i0}
Dialog: 0,0:12:11.60,0:12:15.12,Lalai,,0,0,0,,Saya rasa Encik Yoon ada kaitan dengannya.
Dialog: 0,0:12:15.15,0:12:17.21, Lalai,,0,0,0,,Perasmian anda hampir tiba.
Dialog: 0,0:12:17.23,0:12:20.93, Lalai,,0,0,0,,Saya bimbang perkara ini boleh menyebabkan masalah.
Dialog: 0,0:12:21.07,0:12:23.02,Lalai,,0,0,0,,Okey. Awak boleh pergi.
Dialog: 0,0:12:23.70,0:12:25.23,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:12:31.58,0:12:33.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ada bukti,{\c}{\i0}
Dialog: 0,0:12:33.41,0:12:37.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi sentuh Hae-in sekali lagi,{\c}{\i0}
Dialog: 0,0:12:37.13,0:12:41.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan saya akan menahan awak\Nas yang saya lakukan dengan Hyun-woo.{\c}{\i0}
Dialog: 0,0:12:46.64,0:12:48.46, Lalai,,0,0,0,,Helo.
Dialog: 0,0:12:49.47,0:12:51.99,Lalai,,0,0,0,,Saya ingin mengalihkan wang yang saya ada...
Dialog: 0,0:12:52.02,0:12:53.08, Lalai,,0,0,0,, dalam peti besi.
Dialog: 0,0:12:53.10,0:12:57.10,Lalai,,0,0,0,,{\i1}En. Yoon menukarnya\Nall kepada dolar dan mengambilnya.{\i0}
Dialog: 0,0:13:08.07,0:13:10.03, Lalai,,0,0,0,,Dia akan pergi sekarang.
Dialog: 0,0:13:31.22,0:13:33.99, Lalai,,0,0,0,, En. Pembunuh Pyeon akhirnya\Nmempunyai perubahan hati.
Dialog: 0,0:13:34.02,0:13:36.79,Lalai,,0,0,0,,Dia tidak menamakan secara khusus Eun-sung,
Dialog: 0,0:13:36.81,0:13:38.37, Lalai,,0,0,0,,tetapi dia ada menyebut seorang rakan sejenayah.
Dialog: 0,0:13:38.40,0:13:39.92,Lalai,,0,0,0,,Saya pasti Eun-sung dengar.
Dialog: 0,0:13:39.94,0:13:43.48, Lalai,,0,0,0,,Dia mungkin merancang untuk\Nmeninggalkan negara, bukan?
Dialog: 0,0:13:46.03,0:13:47.56, Lalai,,0,0,0,,Hei.
Dialog: 0,0:13:49.11,0:13:50.94, Lalai,,0,0,0,,Adakah anda sedang tidur?
Dialog: 0,0:13:54.70,0:13:56.24, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:14:01.29,0:14:02.73, Lalai,,0,0,0,,Hyun-woo!
Dialog: 0,0:14:02.75,0:14:04.37, Lalai,,0,0,0,,Hei.
Dialog: 0,0:14:06.38,0:14:07.96, Lalai,,0,0,0,,Saya tidak tidur.
Dialog: 0,0:14:09.84,0:14:13.70,Lalai,,0,0,0,,Maka anda sepatutnya berkata demikian, atau sekurang-kurangnya\N berdengkur jika anda sedang tidur!
Dialog: 0,0:14:13.72,0:14:17.04,Lalai,,0,0,0,,Anda baru sahaja melarikan diri dari ED.\Bayangkan betapa takutnya saya.
Dialog: 0,0:14:17.06,0:14:19.12,Lalai,,0,0,0,,Saya tidak akan mati. jangan risau.
Dialog: 0,0:14:19.14,0:14:21.35, Lalai,,0,0,0,,Ini membuatkan saya gila.
Dialog: 0,0:14:23.23,0:14:24.58,Lalai,,0,0,0,,Hei, saya peguam cerai.
Dialog: 0,0:14:24.61,0:14:26.00, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:14:26.03,0:14:29.01, Lalai,,0,0,0,,Perceraian tidak menguntungkan,\Ntetapi semua pelanggan saya berkata...
Dialog: 0,0:14:29.03,0:14:32.47,Lalai,,0,0,0,,mereka bercerai untuk mendapatkan masa depan yang lebih bahagia.
Dialog: 0,0:14:32.49,0:14:35.26,Lalai,,0,0,0,,Ringkasnya, saya amat berbangga untuk membantu mereka...
Dialog: 0,0:14:35.29,0:14:37.51, Lalai,,0,0,0,,yang ingin menjalani kehidupan yang lebih baik.
Dialog: 0,0:14:37.54,0:14:38.93, Lalai,,0,0,0,,- Jadi?\N- Tetapi anda berbeza.
Dialog: 0,0:14:38.96,0:14:41.32,Lalai,,0,0,0,,Anda tidak mempedulikan diri sendiri.
Dialog: 0,0:14:42.00,0:14:44.33, Lalai,,0,0,0,,Anda sedang menggali kubur anda sendiri.
Dialog: 0,0:14:45.59,0:14:47.65, Lalai,,0,0,0,,- Yang-gi...\N- Jadilah diri sendiri.
Dialog: 0,0:14:47.67,0:14:50.54, Lalai,,0,0,0,,Jangan bercakap dengan suara yang rendah dan penuh kasih sayang.
Dialog: 0,0:14:53.05,0:14:56.51,Lalai,,0,0,0,,Terima kasih kerana sentiasa bersama saya.
Dialog: 0,0:14:59.10,0:15:01.64, Lalai,,0,0,0,,Jangan bertindak secara berbeza.
Dialog: 0,0:15:02.27,0:15:03.37, Lalai,,0,0,0,,Anda kawan baik.
Dialog: 0,0:15:03.40,0:15:05.93, Lalai,,0,0,0,,Jangan puji saya!
Dialog: 0,0:15:06.19,0:15:08.52, Lalai,,0,0,0,,Adakah anda benar-benar mati, atau apa?
Dialog: 0,0:15:23.54,0:15:24.64, Lalai,,0,0,0,,Di mana kita?
Dialog: 0,0:15:24.67,0:15:26.58,Lalai,,0,0,0,,Ini tempat memburu kami.
Dialog: 0,0:15:26.75,0:15:28.98,Lalai,,0,0,0,,- Vila kami ada di sini.\N- Patutkah saya hubungi polis?
Dialog: 0,0:15:29.01,0:15:31.53,Lalai,,0,0,0,,Saya akan menghubungi awak selepas saya masuk dan menyemak.
Dialog: 0,0:15:31.55,0:15:33.28, Lalai,,0,0,0,,Panggil mereka kemudian.
Dialog: 0,0:15:33.30,0:15:34.32, Lalai,,0,0,0,,Hei.
Dialog: 0,0:15:34.35,0:15:37.09, Lalai,,0,0,0,,Anda pergi sendiri? Hei!
Dialog: 0,0:15:56.95,0:15:57.93, Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kawasan Terhad{\c}{\i0}
Dialog: 0,0:16:29.27,0:16:32.13, Lalai,,0,0,0,, Di bawah itu terdapat pintu sisi ke dapur.
Dialog: 0,0:16:32.15,0:16:33.59, Lalai,,0,0,0,,Kami akan mengangkut bahan...
Dialog: 0,0:16:33.61,0:16:36.56, Lalai,,0,0,0,,melalui pintu itu apabila pengerusi melawat.
Dialog: 0,0:16:36.62,0:16:37.59,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:16:37.62,0:16:39.72,Lalai,,0,0,0,,By the way, adakah sesuatu sedang berlaku?
Dialog: 0,0:16:39.74,0:16:43.72, Lalai,,0,0,0,,Kenderaan telah datang\N dan mengangkut barang.
Dialog: 0,0:16:46.17,0:16:48.58,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:16:49.04,0:16:52.29,Lalai,,0,0,0,,Saya akan terangkan semuanya setelah habuk mendap.
Dialog: 0,0:16:58.01,0:16:59.59, Lalai,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:17:01.93,0:17:04.51, Lalai,,0,0,0,,Di mana wang saya? Adakah di sini?
Dialog: 0,0:17:04.56,0:17:06.18, Lalai,,0,0,0,,Saya fikir...
Dialog: 0,0:17:06.56,0:17:08.42,Lalai,,0,0,0,,anda datang untuk mengucapkan selamat tinggal,
Dialog: 0,0:17:08.44,0:17:10.47, Lalai,,0,0,0,, kerana saya akan pergi.
Dialog: 0,0:17:11.94,0:17:16.52,Lalai,,0,0,0,,Anda boleh keluar jika anda mahu,\Ntetapi berikan saya wang dan fail saya.
Dialog: 0,0:17:17.03,0:17:18.77, Lalai,,0,0,0,,Fail apa?
Dialog: 0,0:17:24.46,0:17:26.77, Lalai,,0,0,0,,Buktinya anda membunuh pengerusi?
Dialog: 0,0:17:26.79,0:17:30.29,Lalai,,0,0,0,,Adakah anda benar-benar bimbang saya akan mendedahkan anda?
Dialog: 0,0:17:31.80,0:17:33.83, Lalai,,0,0,0,,Anda kenal saya.
Dialog: 0,0:17:35.38,0:17:38.50,Lalai,,0,0,0,,Saya sentiasa pandai menyimpan rahsia.
Dialog: 0,0:17:50.61,0:17:52.68, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Terima kasih.{\c}{\i0}
Dialog: 0,0:18:36.15,0:18:37.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tertinggal sesuatu.{\c}{\i0}
Dialog: 0,0:18:37.61,0:18:39.40, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda teruskan.{\c}{\i0}
Dialog: 0,0:18:39.70,0:18:41.23, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baiklah.{\c}{\i0}
Dialog: 0,0:18:53.42,0:18:55.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda berada di sini?{\c}{\i0}
Dialog: 0,0:18:55.80,0:18:58.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Untuk berjumpa dengan anda.\N- Bagaimana jika seseorang melihat anda?{\c}{\i0}
Dialog: 0,0:18:58.67,0:19:01.42, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan sampai ke sana tidak lama lagi. Sabar.{\c}{\i0}
Dialog: 0,0:19:03.68,0:19:05.67, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Naik teksi balik.{\c}{\i0}
Dialog: 0,0:19:06.72,0:19:08.63, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu.{\c}{\i0}
Dialog: 0,0:19:09.69,0:19:11.59,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan terperangkap.{\c}{\i0}
Dialog: 0,0:19:15.86,0:19:17.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,0:19:17.07,0:19:18.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Su-wan!\N- Su-wan!{\c}{\i0}
Dialog: 0,0:19:18.28,0:19:19.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,0:19:19.32,0:19:20.34,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Oh, tidak!{\c}{\i0}
Dialog: 0,0:19:20.36,0:19:22.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,0:19:22.74,0:19:26.51,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,0:19:26.54,0:19:28.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Su-wan!\N- Su-wan!{\c}{\i0}
Dialog: 0,0:19:33.79,0:19:35.92,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Ada kemalangan!{\c}{\i0}
Dialog: 0,0:19:35.94,0:19:36.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Oh, tidak!{\c}{\i0}
Dialog: 0,0:19:36.96,0:19:38.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Di manakah anak-anak?{\c}{\i0}
Dialog: 0,0:19:38.09,0:19:39.73, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sila tunggu.{\c}{\i0}
Dialog: 0,0:19:39.76,0:19:42.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sila cepat dan selamatkan mereka!{\c}{\i0}
Dialog: 0,0:20:01.74,0:20:02.80, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan pergi ke sana.{\c}{\i0}
Dialog: 0,0:20:02.82,0:20:05.34, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Apa yang sedang berlaku?{\c}{\i0}
Dialog: 0,0:20:05.37,0:20:08.57, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Apa yang sedang berlaku?{\c}{\i0}
Dialog: 0,0:20:12.46,0:20:14.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda tidak pergi?{\c}{\i0}
Dialog: 0,0:20:16.08,0:20:17.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah dia sudah mati?{\c}{\i0}
Dialog: 0,0:20:20.67,0:20:22.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda telah memecahkan bot.{\c}{\i0}
Dialog: 0,0:20:22.51,0:20:23.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya melihatnya,{\c}{\i0}
Dialog: 0,0:20:23.78,0:20:24.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi Ibu.{\c}{\i0}
Dialog: 0,0:20:24.84,0:20:27.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kita hanya boleh hidup bersama jika mereka mati.{\c}{\i0}
Dialog: 0,0:20:27.30,0:20:30.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya saya tidak memberitahu sesiapa.{\c}{\i0}
Dialog: 0,0:20:32.18,0:20:33.33, Lalai,,0,0,0,,{\i1}Saya fikir melakukan itu...{\i0}
Dialog: 0,0:20:33.35,0:20:35.87,Lalai,,0,0,0,,{\i1}bermakna anda akan datang kepada saya tidak lama lagi,{\i0}
Dialog: 0,0:20:35.90,0:20:37.46,Lalai,,0,0,0,,{\i1}jadi saya tunggu.{\i0}
Dialog: 0,0:20:37.48,0:20:38.96, Lalai,,0,0,0,,Anda mungkin tidak tahu...
Dialog: 0,0:20:38.98,0:20:41.50,Lalai,,0,0,0,,betapa peritnya menunggu\Tiada seseorang yang tidak akan datang.
Dialog: 0,0:20:41.53,0:20:43.05, Lalai,,0,0,0,,Anda betul. saya tidak.
Dialog: 0,0:20:43.07,0:20:45.76,Lalai,,0,0,0,,Jika Hae-in juga telah meninggal dunia ketika itu,
Dialog: 0,0:20:45.78,0:20:50.01, Lalai,,0,0,0,,anda tidak akan mengganggu\N rancangan saya dengan cara ini.
Dialog: 0,0:20:50.04,0:20:51.99, Lalai,,0,0,0,,Itu satu-satunya penyesalan saya.
Dialog: 0,0:20:55.33,0:20:57.45, Lalai,,0,0,0,, Jadi di manakah fail itu?
Dialog: 0,0:21:00.34,0:21:02.25, Lalai,,0,0,0,,Ia ada dalam laci saya.
Dialog: 0,0:21:02.67,0:21:05.32, Lalai,,0,0,0,,- Kod laluan ialah hari lahir anda.\N- Dan wang?
Dialog: 0,0:21:05.34,0:21:06.88, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:21:07.43,0:21:10.11, Lalai,,0,0,0,,Anda berkata untuk melindungi diri saya dengan wang itu.
Dialog: 0,0:21:10.14,0:21:13.01, Lalai,,0,0,0,,Awak kata itu cara awak mencintai saya!
Dialog: 0,0:21:17.40,0:21:18.93, Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:21:44.46,0:21:45.78, Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:21:45.80,0:21:47.63, Lalai,,0,0,0,,Hae-in!
Dialog: 0,0:21:47.80,0:21:50.42,Lalai,,0,0,0,,Hae-in. Di mana dia?
Dialog: 0,0:22:37.64,0:22:39.39, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:22:41.65,0:22:44.22, Lalai,,0,0,0,,Ada apa dengan muka awak? Adakah anda terluka?
Dialog: 0,0:22:44.61,0:22:45.79,Lalai,,0,0,0,,Saya okay.
Dialog: 0,0:22:45.82,0:22:47.69, Lalai,,0,0,0,,Nampak tak okay.
Dialog: 0,0:22:47.78,0:22:50.48, Lalai,,0,0,0,, Bersandar pada saya, okay?
Dialog: 0,0:22:50.57,0:22:51.84, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:22:51.87,0:22:54.89,Lalai,,0,0,0,,Pergi terus untuk sampai ke pintu pagar utama.
Dialog: 0,0:22:54.91,0:22:56.30, Lalai,,0,0,0,,Rakan saya sedang menunggu di sana.
Dialog: 0,0:22:56.33,0:22:57.64, Lalai,,0,0,0,,Teruskan. Saya akan ke sana tidak lama lagi.
Dialog: 0,0:22:57.66,0:22:59.31, Lalai,,0,0,0,,Awak ambil saya untuk apa?
Dialog: 0,0:22:59.33,0:23:03.49, Lalai,,0,0,0,,Adakah saya jenis yang mementingkan diri sendiri yang akan\Ntinggalkan penyelamat saya?
Dialog: 0,0:23:03.84,0:23:04.81, Lalai,,0,0,0,,Bukan itu...
Dialog: 0,0:23:04.84,0:23:07.12, Lalai,,0,0,0,,Dan saya tahu segala-galanya.
Dialog: 0,0:23:07.21,0:23:10.08, Lalai,,0,0,0,,Saya tahu maksud awak kepada saya.
Dialog: 0,0:23:10.43,0:23:12.74, Lalai,,0,0,0,,Saya menyesal mengesyaki awak.
Dialog: 0,0:23:12.76,0:23:15.13,Lalai,,0,0,0,,Nanti saya minta maaf betul-betul.
Dialog: 0,0:23:18.64,0:23:20.26, Lalai,,0,0,0,,Cukup ambil saya.
Dialog: 0,0:23:22.02,0:23:24.39, Lalai,,0,0,0,,Kami berada di bot yang sama malam ini.
Dialog: 0,0:23:24.98,0:23:27.10,Lalai,,0,0,0,,Kita akan bergerak bersama.
Dialog: 0,0:24:37.60,0:24:39.96, Lalai,,0,0,0,, Di sini!
Dialog: 0,0:25:11.63,0:25:13.75,Lalai,,0,0,0,,Kenapa awak bersama dia?
Dialog: 0,0:25:15.80,0:25:16.94, Lalai,,0,0,0,,Datang kepada saya.
Dialog: 0,0:25:16.97,0:25:18.79, Lalai,,0,0,0,,Jika anda lakukan,
Dialog: 0,0:25:18.97,0:25:21.70,Lalai,,0,0,0,,Saya akan menutup mata terhadap segala-galanya.
Dialog: 0,0:25:21.72,0:25:23.70,Lalai,,0,0,0,,Kami bersetuju untuk keluar bersama!
Dialog: 0,0:25:23.73,0:25:25.79,Lalai,,0,0,0,,Maaf,
Dialog: 0,0:25:25.81,0:25:27.91, Lalai,,0,0,0,,tetapi itu tidak akan berlaku.
Dialog: 0,0:25:27.94,0:25:31.58,Lalai,,0,0,0,,Saya berasa tidak senang dan tidak menyukai awak,\Walaupun saya tidak ingat apa-apa,
Dialog: 0,0:25:31.61,0:25:33.81, Lalai,,0,0,0,,dan sekarang saya tahu sebabnya.
Dialog: 0,0:25:35.65,0:25:38.02, Lalai,,0,0,0,,Mengapa saya membuat anda berasa tidak senang?
Dialog: 0,0:25:39.03,0:25:41.36, Lalai,,0,0,0,, Beritahu saya. Kenapa awak tak suka saya?
Dialog: 0,0:25:41.53,0:25:45.26,Lalai,,0,0,0,,Hidup saya musnah kerana awak,\Nyet saya tetap mencuba yang terbaik! Jadi kenapa?
Dialog: 0,0:25:45.29,0:25:47.27, Lalai,,0,0,0,,Eun-sung! Cukuplah!
Dialog: 0,0:25:47.29,0:25:50.33, Lalai,,0,0,0,,- Semuanya sudah berakhir!\N- Diam! Ia belum berakhir!
Dialog: 0,0:25:57.63,0:25:59.17, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:25:59.76,0:26:01.36, Lalai,,0,0,0,,Masih belum terlambat, Hae-in.
Dialog: 0,0:26:01.39,0:26:02.78, Lalai,,0,0,0,,Jom. Okay?
Dialog: 0,0:26:02.81,0:26:04.83, Lalai,,0,0,0,,Buang!
Dialog: 0,0:26:04.85,0:26:06.93, Lalai,,0,0,0,,Saya tidak akan pergi. Atas mayat saya.
Dialog: 0,0:26:10.23,0:26:12.06, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:26:16.44,0:26:18.35, Lalai,,0,0,0,, Atas mayat anda?
Dialog: 0,0:26:31.67,0:26:33.06, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:26:33.09,0:26:35.73, Lalai,,0,0,0,,- Eun-sung!\N- Jatuhkan senapang sekarang!
Dialog: 0,0:26:35.76,0:26:37.96,Lalai,,0,0,0,,Kami akan tembak jika anda tidak!
Dialog: 0,0:26:40.01,0:26:42.09,Lalai,,0,0,0,,Maafkan saya, Hae-in,
Dialog: 0,0:26:48.81,0:26:50.97, Lalai,,0,0,0,,tetapi saya tidak boleh meninggalkan awak di sini.
Dialog: 0,0:26:51.27,0:26:52.81, Lalai,,0,0,0,,Saya akan pergi...
Dialog: 0,0:26:54.36,0:26:57.81, Lalai,,0,0,0,,untuk membawa awak bersama saya, walaupun saya terpaksa membunuh awak.
Dialog: 0,0:27:58.05,0:27:59.58,Lalai,,0,0,0,,Tidak...
Dialog: 0,0:28:00.01,0:28:01.58, Lalai,,0,0,0,, En. Baek.
Dialog: 0,0:28:02.63,0:28:04.53, Lalai,,0,0,0,, En. Baek.
Dialog: 0,0:28:04.55,0:28:07.34, Lalai,,0,0,0,, En. Baek, buka mata awak. Tolong?
Dialog: 0,0:28:09.18,0:28:10.79, Lalai,,0,0,0,, En. Baek, tidak!
Dialog: 0,0:28:10.81,0:28:13.25, Lalai,,0,0,0,,Sila bangun! Tolong?
Dialog: 0,0:28:13.27,0:28:15.68, Lalai,,0,0,0,,Tolong kami!
Dialog: 0,0:28:20.32,0:28:21.85, Lalai,,0,0,0,,Hyun-woo!
Dialog: 0,0:28:22.78,0:28:24.73, Lalai,,0,0,0,,Baek Hyun-woo!
Dialog: 0,0:28:47.35,0:28:49.53, Lalai,,0,0,0,,Kami akan bawa dia ke pusat trauma utama.
Dialog: 0,0:28:49.56,0:28:50.95,Lalai,,0,0,0,,Beritahu mereka seorang lelaki ditembak,
Dialog: 0,0:28:50.97,0:28:54.14, Lalai,,0,0,0,,- dan memerlukan pembedahan segera.\N- Ya, tuan.
Dialog: 0,0:29:03.32,0:29:04.59, Lalai,,0,0,0,,Pendarahannya tidak akan berhenti.
Dialog: 0,0:29:04.61,0:29:05.97, Lalai,,0,0,0,,Maklumkan pihak hospital!
Dialog: 0,0:29:05.99,0:29:08.09, Lalai,,0,0,0,,BPnya ialah 80/50. Ia jatuh!
Dialog: 0,0:29:08.12,0:29:10.82, Lalai,,0,0,0,,Tuan, saya akan tekan luka anda.
Dialog: 0,0:29:14.04,0:29:15.57,Lalai,,0,0,0,,En. Baek.
Dialog: 0,0:29:16.50,0:29:18.24,Lalai,,0,0,0,,Buka mata anda.
Dialog: 0,0:29:19.46,0:29:20.77, Lalai,,0,0,0,,Okey?
Dialog: 0,0:29:20.80,0:29:24.00, Lalai,,0,0,0,,Kami akan membawa anda ke hospital. Anda akan baik-baik saja.
Dialog: 0,0:29:24.38,0:29:26.00, Lalai,,0,0,0,,Bertahan di sana.
Dialog: 0,0:29:27.39,0:29:29.09, Lalai,,0,0,0,,Saya...
Dialog: 0,0:29:34.14,0:29:35.68, Lalai,,0,0,0,,okay.
Dialog: 0,0:29:50.62,0:29:52.32,Lalai,,0,0,0,,Jangan menangis.
Dialog: 0,0:30:42.63,0:30:44.52,Lalai,,0,0,0,,Jangan pergi ke mana-mana.
Dialog: 0,0:30:44.55,0:30:46.02, Lalai,,0,0,0,,Saya tidak akan ke mana-mana.
Dialog: 0,0:30:46.05,0:30:47.57, Lalai,,0,0,0,,Saya akan menunggu.
Dialog: 0,0:30:47.59,0:30:49.75,Lalai,,0,0,0,,Jangan risau tentang saya.
Dialog: 0,0:30:50.18,0:30:52.29, Lalai,,0,0,0,, Jumpa anda selepas pembedahan.
Dialog: 0,0:31:09.03,0:31:11.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak akan pergi ke mana-mana, bukan?{\c}{\i0}
Dialog: 0,0:31:12.16,0:31:16.32,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika saya tidak ingat\Tiada apa-apa atau mengenali anda?{\c}{\i0}
Dialog: 0,0:31:16.83,0:31:18.31,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika saya menganiaya kamu?{\c}{\i0}
Dialog: 0,0:31:18.33,0:31:20.68,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia bukan rodeo pertama saya.{\c}{\i0}
Dialog: 0,0:31:20.71,0:31:22.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu tidak penting sama sekali.{\c}{\i0}
Dialog: 0,0:31:22.58,0:31:25.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}{\i1}{\c&HFFFF00&}Hanya dapatkan pembedahan...{\i0}{\c}{\i0}
Dialog: 0,0:31:25.75,0:31:27.45, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan kembali.{\c}{\i0}
Dialog: 0,0:31:28.21,0:31:31.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pastikan anda kembali.{\c}{\i0}
Dialog: 0,0:31:31.26,0:31:32.49,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan kembali.{\c}{\i0}
Dialog: 0,0:31:32.51,0:31:36.71, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tolong jaga saya apabila saya kembali.{\c}{\i0}
Dialog: 0,0:31:40.73,0:31:42.89,Lalai,,0,0,0,,Itulah yang saya lakukan.
Dialog: 0,0:31:43.73,0:31:46.14,Lalai,,0,0,0,,Saya lupa siapa dia.
Dialog: 0,0:31:46.94,0:31:49.14,Lalai,,0,0,0,,Saya layan dia seperti orang asing.
Dialog: 0,0:31:49.78,0:31:51.48,Lalai,,0,0,0,,Saya menganiaya dia...
Dialog: 0,0:31:52.91,0:31:55.40, Lalai,,0,0,0,,sekian.
Dialog: 0,0:33:18.62,0:33:19.76, Lalai,,0,0,0,,Adakah sesuatu berlaku?
Dialog: 0,0:33:19.78,0:33:21.05, Lalai,,0,0,0,,Saya terdengar bunyi bising.
Dialog: 0,0:33:21.08,0:33:23.26,Lalai,,0,0,0,,- Awak kenal Encik Yoon Eun-sung?\N- Ya. kenapa?
Dialog: 0,0:33:23.29,0:33:25.53, Lalai,,0,0,0,,Dia baru sahaja meninggal dunia.
Dialog: 0,0:33:46.48,0:33:48.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bilakah anda akan kembali?{\c}{\i0}
Dialog: 0,0:33:54.82,0:33:56.05,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:33:56.61,0:33:57.92,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:33:57.95,0:34:00.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kembali segera!{\c}{\i0}
Dialog: 0,0:34:00.87,0:34:02.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan menunggu anda!{\c}{\i0}
Dialog: 0,0:34:02.99,0:34:04.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:34:05.25,0:34:07.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu!{\c}{\i0}
Dialog: 0,0:34:08.54,0:34:11.24, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan menunggu!{\c}{\i0}
Dialog: 0,0:34:11.92,0:34:13.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibu.{\c}{\i0}
Dialog: 0,0:34:13.76,0:34:15.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan pergi.{\c}{\i0}
Dialog: 0,0:34:46.37,0:34:47.60, Lalai,,0,0,0,,Anda masih bangun?
Dialog: 0,0:34:47.62,0:34:48.89, Lalai,,0,0,0,,Saya tidak boleh tidur.
Dialog: 0,0:34:48.92,0:34:51.56, Lalai,,0,0,0,,Saya akan tunggu sedikit lagi kemudian\Nambil beberapa pil tidur.
Dialog: 0,0:34:51.58,0:34:53.79, Lalai,,0,0,0,,Apa yang anda lakukan?
Dialog: 0,0:34:55.46,0:34:56.94, Lalai,,0,0,0,,Itu adalah masa yang menggembirakan.
Dialog: 0,0:34:56.96,0:34:58.23,Lalai,,0,0,0,,Saya setuju,
Dialog: 0,0:34:58.26,0:35:00.79, Lalai,,0,0,0,,tetapi saya hanya...
Dialog: 0,0:35:01.18,0:35:03.25, Lalai,,0,0,0,, menyedarinya sekarang.
Dialog: 0,0:35:09.56,0:35:11.43,Lalai,,0,0,0,,Mari kita tidur sekarang.
Dialog: 0,0:35:12.77,0:35:14.77,Lalai,,0,0,0,,Saya okey sekarang.
Dialog: 0,0:35:15.57,0:35:20.21,Lalai,,0,0,0,,Kami sangat menyukai pantai ini,\Nkami melawat setiap tahun,
Dialog: 0,0:35:20.24,0:35:22.17, Lalai,,0,0,0,,tetapi kami tidak pernah kembali...
Dialog: 0,0:35:22.20,0:35:24.26, Lalai,,0,0,0,,selepas kejadian itu.
Dialog: 0,0:35:24.28,0:35:26.19,Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:35:29.62,0:35:31.32,Lalai,,0,0,0,,Tahan.
Dialog: 0,0:35:31.46,0:35:32.89, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:35:32.92,0:35:34.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga pandai berenang.{\c}{\i0}
Dialog: 0,0:35:34.71,0:35:36.52, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul. Lihat di sini.{\c}{\i0}
Dialog: 0,0:35:36.55,0:35:38.73, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga pergi ke Kem Kor Marin kanak-kanak.{\c}{\i0}
Dialog: 0,0:35:38.76,0:35:42.00, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia pernah menyelamatkan seorang kanak-kanak daripada lemas.{\c}{\i0}
Dialog: 0,0:35:47.97,0:35:49.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa?{\c}{\i0}
Dialog: 0,0:35:50.02,0:35:51.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya rasa...{\c}{\i0}
Dialog: 0,0:35:51.81,0:35:54.71,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mengenali pantai ini.{\c}{\i0}
Dialog: 0,0:35:54.73,0:35:57.60, Lalai,,0,0,0,,Ya, inilah tempatnya.
Dialog: 0,0:35:58.19,0:35:59.63, Lalai,,0,0,0,,Tunggu.
Dialog: 0,0:35:59.65,0:36:01.13, Lalai,,0,0,0,,Mengapa saya tidak mengenalinya?
Dialog: 0,0:36:01.15,0:36:02.34, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:36:02.36,0:36:04.11, Lalai,,0,0,0,,- Saya...\N- Seon-hwa!
Dialog: 0,0:36:04.74,0:36:06.44, Lalai,,0,0,0,, Beom-jun!
Dialog: 0,0:36:07.87,0:36:09.74, Lalai,,0,0,0,,Saya ada berita buruk.
Dialog: 0,0:36:19.09,0:36:20.71, Lalai,,0,0,0,,Hei, Sayang.
Dialog: 0,0:36:23.47,0:36:24.74,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:36:24.76,0:36:26.42,Lalai,,0,0,0,,Tengok...
Dialog: 0,0:36:26.89,0:36:28.42,Lalai,,0,0,0,,Kami...
Dialog: 0,0:36:29.68,0:36:31.22,Lalai,,0,0,0,,Hyun-woo...
Dialog: 0,0:36:31.48,0:36:33.01, Lalai,,0,0,0,,ibu bapa.
Dialog: 0,0:36:38.65,0:36:40.18,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:36:45.36,0:36:47.15,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:36:53.54,0:36:55.06, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:36:55.08,0:36:57.12, Lalai,,0,0,0,,Polis berkata...
Dialog: 0,0:36:57.38,0:37:00.45, Lalai,,0,0,0,,dia ditembak.
Dialog: 0,0:37:01.55,0:37:02.98, Lalai,,0,0,0,,Ya.
Dialog: 0,0:37:03.01,0:37:04.40, Lalai,,0,0,0,,Ia adalah kerana saya.
Dialog: 0,0:37:04.43,0:37:07.00, Lalai,,0,0,0,,Dia mengambil peluru...
Dialog: 0,0:37:07.43,0:37:09.09, Lalai,,0,0,0,,untuk saya.
Dialog: 0,0:37:29.33,0:37:31.86,Lalai,,0,0,0,,Tidak mengapa. jangan menangis.
Dialog: 0,0:37:32.66,0:37:34.36,Lalai,,0,0,0,,Hyun-woo...
Dialog: 0,0:37:35.21,0:37:37.16, Lalai,,0,0,0,, akan baik-baik saja,
Dialog: 0,0:37:40.00,0:37:42.02,Lalai,,0,0,0,,jadi jangan menangis.
Dialog: 0,0:37:42.05,0:37:44.75,Lalai,,0,0,0,,Maaf...
Dialog: 0,0:38:06.95,0:38:10.27,Lalai,,0,0,0,,Saya mempunyai dua anak lelaki,
Dialog: 0,0:38:10.32,0:38:12.78, Lalai,,0,0,0,,tetapi seorang mati ketika dia kecil.
Dialog: 0,0:38:13.16,0:38:16.97,Lalai,,0,0,0,,Saya sangka dia mati semasa cuba menyelamatkan Hae-in.
Dialog: 0,0:38:17.00,0:38:19.49,Lalai,,0,0,0,,Itu bukan salah dia,
Dialog: 0,0:38:20.13,0:38:23.12, Lalai,,0,0,0,,tetapi saya membencinya.
Dialog: 0,0:38:25.72,0:38:27.96,Lalai,,0,0,0,,Saya menyedihkan...
Dialog: 0,0:38:28.76,0:38:30.46, Lalai,,0,0,0,,dan bodoh.
Dialog: 0,0:38:39.23,0:38:41.58,Lalai,,0,0,0,,Adakah anda ingat apa yang anda beritahu saya kali terakhir?
Dialog: 0,0:38:41.61,0:38:46.55,Lalai,,0,0,0,,Anda kata Hyun-woo pernah menyelamatkan\Na kanak-kanak di Kem Kor Marin.
Dialog: 0,0:38:46.57,0:38:47.88, Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,0:38:47.90,0:38:50.11, Lalai,,0,0,0,,Sebuah bot tidak berfungsi,
Dialog: 0,0:38:50.24,0:38:52.65, Lalai,,0,0,0,,dan dia menyelamatkan seorang gadis...
Dialog: 0,0:38:55.12,0:38:58.56, Lalai,,0,0,0,,Lokasi dan tarikh kelihatan biasa.
Dialog: 0,0:38:58.58,0:39:02.49, Lalai,,0,0,0,,Saya mendapati ia agak ganjil.
Dialog: 0,0:39:15.60,0:39:17.42, Lalai,,0,0,0,,Saya akan menjahitnya.
Dialog: 0,0:39:19.31,0:39:21.01, Lalai,,0,0,0,,BPnya menurun.
Dialog: 0,0:39:21.05,0:39:22.83, Lalai,,0,0,0,,- Terhenti jantung!\N- Dapatkan defibrilator.
Dialog: 0,0:39:22.86,0:39:25.22, Lalai,,0,0,0,,- Kekalkan epinefrin.\N- Ya, tuan.
Dialog: 0,0:39:31.70,0:39:34.38,Lalai,,0,0,0,,{\i1}Saya percaya ia adalah pantai yang sama.{\i0}
Dialog: 0,0:39:34.41,0:39:35.97, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan pergi ke sana.{\c}{\i0}
Dialog: 0,0:39:35.99,0:39:38.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Cepat!{\c}{\i0}
Dialog: 0,0:39:38.58,0:39:41.14, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Apa yang sedang berlaku?{\c}{\i0}
Dialog: 0,0:39:41.17,0:39:42.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in!{\c}{\i0}
Dialog: 0,0:39:43.54,0:39:45.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in!{\c}{\i0}
Dialog: 0,0:39:45.88,0:39:48.08, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in!{\c}{\i0}
Dialog: 0,0:40:39.52,0:40:42.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu dia!{\c}{\i0}
Dialog: 0,0:40:42.27,0:40:43.50,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Putar bot!{\c}{\i0}
Dialog: 0,0:40:43.52,0:40:45.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berbalik!{\c}{\i0}
Dialog: 0,0:40:47.19,0:40:49.60,Lalai,,0,0,0,,{\i1}Itu Hyun-woo...{\i0}
Dialog: 0,0:40:52.53,0:40:54.40,Lalai,,0,0,0,,{\i1}siapa yang telah menyelamatkan Hae-in.{\i0}
Dialog: 0,0:41:05.58,0:41:08.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan...{\c}{\i0}
Dialog: 0,0:41:08.75,0:41:11.75,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak, Su-wan...{\c}{\i0}
Dialog: 0,0:41:12.38,0:41:15.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan, tolong!{\c}{\i0}
Dialog: 0,0:41:16.22,0:41:18.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anakku yang malang!{\c}{\i0}
Dialog: 0,0:41:19.72,0:41:21.67,Lalai,,0,0,0,,{\i1}Sukar dipercayai.{\i0}
Dialog: 0,0:41:21.72,0:41:24.34,Lalai,,0,0,0,,Bercakap tentang takdir yang saling berkaitan.
Dialog: 0,0:41:24.85,0:41:26.39,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,0:41:27.27,0:41:29.33,Lalai,,0,0,0,,Saya terlalu diliputi kesedihan...
Dialog: 0,0:41:29.36,0:41:32.68, Lalai,,0,0,0,,untuk perasan Hae-in dalam kesakitan.
Dialog: 0,0:41:32.82,0:41:37.15,Lalai,,0,0,0,,Saya tidak pernah menyangka seseorang boleh menyelamatkannya.
Dialog: 0,0:41:39.45,0:41:41.90,Lalai,,0,0,0,,Saya tidak tahu siapa yang menyelamatkannya...
Dialog: 0,0:41:42.91,0:41:45.06,Lalai,,0,0,0,,ada bersama kami selama ini.
Dialog: 0,0:41:45.08,0:41:48.70,Lalai,,0,0,0,,Saya membencinya, menyakitinya,\Nand memberinya masa yang sukar.
Dialog: 0,0:41:49.59,0:41:51.29,Lalai,,0,0,0,,Itulah yang saya lakukan.
Dialog: 0,0:41:56.09,0:41:58.38,Lalai,,0,0,0,,Semuanya adalah masa lalu.
Dialog: 0,0:41:59.80,0:42:03.30,Lalai,,0,0,0,,Biar yang lalu berlalu.
Dialog: 0,0:42:04.31,0:42:05.84,Lalai,,0,0,0,,Buat masa ini,
Dialog: 0,0:42:10.27,0:42:12.14,Default,,0,0,0,,kita doakan saja...
Dialog: 0,0:42:13.03,0:42:15.23,Lalai,,0,0,0,,Hyun-woo itu...
Dialog: 0,0:42:15.69,0:42:18.15, Lalai,,0,0,0,,akan melalui,
Dialog: 0,0:42:18.49,0:42:19.88,Lalai,,0,0,0,,dan...
Dialog: 0,0:42:19.91,0:42:22.53, Lalai,,0,0,0,,sekali dia buat...
Dialog: 0,0:42:25.16,0:42:28.62, Lalai,,0,0,0,,Kita hanya perlu bersyukur.
Dialog: 0,0:42:29.75,0:42:31.28,Lalai,,0,0,0,,Betul.
Dialog: 0,0:42:33.46,0:42:35.33, Lalai,,0,0,0,,Saya akan lakukan itu.
Dialog: 0,0:42:50.23,0:42:54.28,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialog: 0,0:43:04.70,0:43:07.40,Lalai,,0,0,0,,Puan, saya tidak percaya tragedi ini.
Dialog: 0,0:43:09.08,0:43:12.23, Lalai,,0,0,0,, Berapakah jumlah saham milik Eun-sung?
Dialog: 0,0:43:12.25,0:43:13.60, Lalai,,0,0,0,,Dia mempunyai 15.9%.
Dialog: 0,0:43:13.63,0:43:15.02, Lalai,,0,0,0,, Pindahkan mereka kepada saya dengan segera.
Dialog: 0,0:43:15.05,0:43:16.87, Lalai,,0,0,0,,Maaf?
Dialog: 0,0:43:17.46,0:43:18.98, Lalai,,0,0,0,,Saya baru sahaja mengesahkannya.
Dialog: 0,0:43:19.01,0:43:22.82, Lalai,,0,0,0,,Anak saya sudah mati, yang bermaksud\N sahamnya semua milik saya.
Dialog: 0,0:43:22.85,0:43:24.67,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:43:27.47,0:43:29.01, Lalai,,0,0,0,,Dan...
Dialog: 0,0:43:29.52,0:43:32.75,Lalai,,0,0,0,,berapa banyak saham tambahan\Nboleh saya beli dengan dana rahsia?
Dialog: 0,0:43:32.77,0:43:34.58,Lalai,,0,0,0,,Anda boleh membeli 7%,
Dialog: 0,0:43:34.61,0:43:37.25,Lalai,,0,0,0,,tetapi adakah Pione Investment\Ningin berganding bahu dengan kami?
Dialog: 0,0:43:37.28,0:43:38.55, Lalai,,0,0,0,,Apakah matlamat mereka?
Dialog: 0,0:43:38.57,0:43:40.80,Lalai,,0,0,0,,Mereka mahu memusnahkan\NQueens Group, menjual segala-galanya,
Dialog: 0,0:43:40.82,0:43:42.30, Lalai,,0,0,0,,dan keluar dengan keuntungan.
Dialog: 0,0:43:42.32,0:43:45.26,Lalai,,0,0,0,,Beritahu mereka bahawa kami akan menjual semuanya dalam setahun,
Dialog: 0,0:43:45.28,0:43:46.39, Lalai,,0,0,0,,dan biarkan mereka pergi.
Dialog: 0,0:43:46.41,0:43:48.28, Lalai,,0,0,0,, Mereka tidak akan menolak.
Dialog: 0,0:43:48.70,0:43:50.24,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:43:51.21,0:43:53.89,Lalai,,0,0,0,,Eun-sung adalah orang yang menyebabkan semua isu.
Dialog: 0,0:43:53.92,0:43:55.31,Lalai,,0,0,0,,Mereka tiada kaitan dengan saya,
Dialog: 0,0:43:55.34,0:43:58.54, Lalai,,0,0,0,,jadi mereka tidak boleh menghalang saya daripada menjadi Pengerusi.
Dialog: 0,0:43:58.63,0:44:00.32, Lalai,,0,0,0,,Ya, itu betul.
Dialog: 0,0:44:00.34,0:44:02.79, Lalai,,0,0,0,,Perasmian saya...
Dialog: 0,0:44:03.18,0:44:05.00, Lalai,,0,0,0,,akan hebat.
Dialog: 0,0:44:08.68,0:44:10.74, Lalai,,0,0,0,,Kami berjaya menjahit luka.
Dialog: 0,0:44:10.77,0:44:11.91, Lalai,,0,0,0,,Dia kehilangan banyak darah,
Dialog: 0,0:44:11.94,0:44:15.00, Lalai,,0,0,0,, dan sudah pun mengalami patah tulang rusuk.
Dialog: 0,0:44:15.02,0:44:17.54,Lalai,,0,0,0,,Pembedahan itu panjang kerana mendesak,
Dialog: 0,0:44:17.57,0:44:20.23, Lalai,,0,0,0,,tetapi dia berjaya.
Dialog: 0,0:44:20.28,0:44:23.47,Lalai,,0,0,0,,Namun, dia masih belum sedar.
Dialog: 0,0:44:23.49,0:44:25.32,Lalai,,0,0,0,,Kita perlu memantau dia.
Dialog: 0,0:44:25.74,0:44:27.48,Lalai,,0,0,0,,- Terima kasih.\N- Terima kasih.
Dialog: 0,0:44:28.74,0:44:30.01,Lalai,,0,0,0,,Alhamdulillah.
Dialog: 0,0:44:30.04,0:44:32.49, Lalai,,0,0,0,,- Anda patut pergi.\N- Tidak, kami tinggal.
Dialog: 0,0:44:32.87,0:44:34.02,Lalai,,0,0,0,,- Hyun-woo.\N- Jangan.
Dialog: 0,0:44:34.04,0:44:36.70, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:44:42.17,0:44:43.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi di manakah fail itu?{\c}{\i0}
Dialog: 0,0:44:43.22,0:44:45.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia ada dalam laci saya.{\c}{\i0}
Dialog: 0,0:44:45.55,0:44:47.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kod laluan ialah hari lahir anda.{\c}{\i0}
Dialog: 0,0:45:14.00,0:45:15.66, Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:45:17.92,0:45:20.41,Lalai,,0,0,0,,Kenapa awak belum bangun lagi?
Dialog: 0,0:45:21.51,0:45:24.87,Lalai,,0,0,0,,Nampak tak saya tunggu awak?
Dialog: 0,0:45:25.30,0:45:27.38,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sangat bimbang.{\c}{\i0}
Dialog: 0,0:45:27.68,0:45:28.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya juga merindui awak.{\c}{\i0}
Dialog: 0,0:45:28.68,0:45:29.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya berasa tidak senang.{\c}{\i0}
Dialog: 0,0:45:29.85,0:45:31.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak selesa,{\c}{\i0}
Dialog: 0,0:45:31.39,0:45:33.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi sila letak jawatan dan cari kerja baharu.{\c}{\i0}
Dialog: 0,0:45:33.93,0:45:35.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya betul-betul tidak mahu...{\c}{\i0}
Dialog: 0,0:45:35.48,0:45:37.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}untuk berjumpa dengan anda.{\c}{\i0}
Dialog: 0,0:45:37.52,0:45:38.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ada apa dengan rupa itu?{\c}{\i0}
Dialog: 0,0:45:38.69,0:45:41.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda meninggalkan saya tinggi dan kering.{\c}{\i0}
Dialog: 0,0:45:41.69,0:45:43.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda fikir anda boleh memikat saya sekarang,{\c}{\i0}
Dialog: 0,0:45:43.57,0:45:45.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}sejak saya hilang ingatan?{\c}{\i0}
Dialog: 0,0:45:45.28,0:45:46.98,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah itu?{\c}{\i0}
Dialog: 0,0:45:49.20,0:45:51.94,Lalai,,0,0,0,,Saya belum minta maaf lagi.
Dialog: 0,0:45:53.79,0:45:56.61,Lalai,,0,0,0,,Saya tidak mendapat semula semua ingatan saya,
Dialog: 0,0:45:56.71,0:45:58.62,Lalai,,0,0,0,,tetapi saya rasa saya tahu kenapa...
Dialog: 0,0:45:58.71,0:46:03.00,Lalai,,0,0,0,,hati saya sakit sebaik sahaja saya melihat awak.
Dialog: 0,0:46:03.42,0:46:06.17, Lalai,,0,0,0,,Saya faham kenapa saya membuat alasan...
Dialog: 0,0:46:06.43,0:46:08.50, Lalai,,0,0,0,,untuk berjumpa dengan anda.
Dialog: 0,0:46:11.26,0:46:14.34, Lalai,,0,0,0,, Masa lalu tidak penting.
Dialog: 0,0:46:15.02,0:46:18.76,Lalai,,0,0,0,,Apa yang penting kita kembali bersama,
Dialog: 0,0:46:19.98,0:46:23.31, Lalai,,0,0,0,,jadi sila bangun.
Dialog: 0,0:46:23.61,0:46:26.19, Lalai,,0,0,0,,Dengar saya,
Dialog: 0,0:46:28.03,0:46:30.86, Lalai,,0,0,0,,dan beritahu saya semuanya baik-baik saja.
Dialog: 0,0:46:32.91,0:46:37.16,Lalai,,0,0,0,,Saya risau sakit sekarang,
Dialog: 0,0:46:40.08,0:46:42.58,Lalai,,0,0,0,,dan saya sangat merindui awak.
Dialog: 0,0:47:28.38,0:47:32.54,Lalai,,0,0,0,,Saya hanya minum air selama\Nsepanjang 24 jam atau lebih.
Dialog: 0,0:47:33.51,0:47:35.87,Lalai,,0,0,0,,Saya serius. saya tak makan.
Dialog: 0,0:47:35.89,0:47:37.84, Lalai,,0,0,0,,Saya juga tidak tidur.
Dialog: 0,0:47:39.18,0:47:40.89, Lalai,,0,0,0,, Tonton saya sahaja.
Dialog: 0,0:47:41.06,0:47:44.12, Lalai,,0,0,0,,Saya akan teruskan sehingga awak bangun.
Dialog: 0,0:47:44.15,0:47:47.84,Lalai,,0,0,0,,Awak korbankan diri awak untuk selamatkan saya,
Dialog: 0,0:47:47.86,0:47:51.46, Lalai,,0,0,0,,dan anda masih belum sedarkan diri,
Dialog: 0,0:47:51.49,0:47:54.77, Lalai,,0,0,0,,jadi bagaimana saya boleh makan atau tidur?
Dialog: 0,0:47:55.24,0:47:56.43,Lalai,,0,0,0,,Awak tak lupa kan?
Dialog: 0,0:47:56.45,0:47:58.93,Lalai,,0,0,0,,Saya masih memerlukan rawatan. Saya perlu berhati-hati.
Dialog: 0,0:47:58.95,0:48:00.85, Lalai,,0,0,0,,Saya juga boleh membebankan diri...
Dialog: 0,0:48:00.87,0:48:03.49, Lalai,,0,0,0,,dan runtuh.
Dialog: 0,0:48:05.75,0:48:08.41,Lalai,,0,0,0,,Saya agak pening sekarang,
Dialog: 0,0:48:08.51,0:48:11.79,Lalai,,0,0,0,,kerana saya menangis sangat.
Dialog: 0,0:48:19.98,0:48:22.55,Lalai,,0,0,0,,Anda masih tidak akan bangun?
Dialog: 0,0:48:28.44,0:48:30.67,Lalai,,0,0,0,,Hyun-woo, awak dah bangun?
Dialog: 0,0:48:30.69,0:48:32.44, Lalai,,0,0,0,, En. Baek.
Dialog: 0,0:48:40.62,0:48:42.02,Lalai,,0,0,0,,Syabas.
Dialog: 0,0:48:42.04,0:48:44.32,Lalai,,0,0,0,,Syabas. Terima kasih banyak-banyak.
Dialog: 0,0:48:46.79,0:48:48.33, Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:48:48.38,0:48:49.44,Lalai,,0,0,0,,No.
Dialog: 0,0:48:49.46,0:48:51.36, Lalai,,0,0,0,,Jangan cuba bercakap.
Dialog: 0,0:48:51.38,0:48:54.04, Lalai,,0,0,0,,Tunggu. Saya akan hubungi doktor.
Dialog: 0,0:49:00.52,0:49:02.22,Lalai,,0,0,0,,Adakah anda okey?
Dialog: 0,0:49:07.65,0:49:09.00, Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:49:09.02,0:49:12.14, Lalai,,0,0,0,,Anda membuat saya berasa lebih teruk.
Dialog: 0,0:49:12.36,0:49:14.30,Lalai,,0,0,0,,Kenapa awak masih risaukan saya,
Dialog: 0,0:49:14.32,0:49:16.22,Lalai,,0,0,0,,apabila anda hampir mati?
Dialog: 0,0:49:16.24,0:49:18.44,Lalai,,0,0,0,,Saya okay.
Dialog: 0,0:49:26.75,0:49:28.28,Lalai,,0,0,0,,Lihat.
Dialog: 0,0:49:30.17,0:49:32.29,Lalai,,0,0,0,,Saya minta maaf...
Dialog: 0,0:49:32.67,0:49:34.40,Lalai,,0,0,0,,Saya gagal mengenali awak.
Dialog: 0,0:49:34.42,0:49:36.24, Lalai,,0,0,0,,Saya tidak ingat apa-apa,
Dialog: 0,0:49:36.26,0:49:38.20, Lalai,,0,0,0,, dan hanya berkata kasar kepada anda.
Dialog: 0,0:49:38.22,0:49:40.05, Lalai,,0,0,0,,Saya juga.
Dialog: 0,0:49:41.31,0:49:43.80,Lalai,,0,0,0,,Saya pun lupa.
Dialog: 0,0:49:44.77,0:49:48.96,Lalai,,0,0,0,,Saya terlupa betapa saya sayangkan awak.
Dialog: 0,0:49:48.98,0:49:50.71,Lalai,,0,0,0,,Saya terlupa bagaimana saya berjanji...
Dialog: 0,0:49:50.73,0:49:52.89, Lalai,,0,0,0,,untuk bersama anda...
Dialog: 0,0:49:53.36,0:49:57.23, Lalai,,0,0,0,, melalui tebal dan nipis.
Dialog: 0,0:49:59.32,0:50:01.15,Lalai,,0,0,0,,Saya terlupa semuanya.
Dialog: 0,0:50:04.37,0:50:06.57, Lalai,,0,0,0,,Saya menyebabkan awak sakit.
Dialog: 0,0:50:09.21,0:50:10.74, Lalai,,0,0,0,,Maaf,
Dialog: 0,0:50:14.72,0:50:16.79, Lalai,,0,0,0,,dan saya sayang kamu.
Dialog: 0,0:50:32.40,0:50:33.93, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:50:48.54,0:50:50.07, Lalai,,0,0,0,,Jangan menangis.
Dialog: 0,0:51:04.81,0:51:05.78, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:51:05.81,0:51:08.30, Lalai,,0,0,0,,Oh, saya. Hyun-woo.
Dialog: 0,0:51:08.69,0:51:10.50,Lalai,,0,0,0,,- Sayang saya.\N- Hyun-woo bangun!
Dialog: 0,0:51:10.52,0:51:11.71, Lalai,,0,0,0,,Bayi saya.
Dialog: 0,0:51:11.73,0:51:13.81, Lalai,,0,0,0,,Adakah dia bangun?
Dialog: 0,0:51:13.90,0:51:16.00,Lalai,,0,0,0,,- Hyun-woo.\N- Awak okay?
Dialog: 0,0:51:16.03,0:51:17.04,Lalai,,0,0,0,,Dia okey.
Dialog: 0,0:51:17.07,0:51:19.05, Lalai,,0,0,0,,Dia juga boleh bercakap dengan baik.
Dialog: 0,0:51:19.07,0:51:20.88, Lalai,,0,0,0,,- Dia bercakap?\N- Ya.
Dialog: 0,0:51:20.91,0:51:22.18, Lalai,,0,0,0,,Apa dia cakap?
Dialog: 0,0:51:22.20,0:51:24.48, Lalai,,0,0,0,,Dia berkata, "Saya sayang awak."
Dialog: 0,0:51:25.24,0:51:26.94, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:51:27.04,0:51:29.24,Lalai,,0,0,0,,Saya sayang awak juga.
Dialog: 0,0:51:29.79,0:51:30.85,Lalai,,0,0,0,,Saya sayang awak, Hyun-woo.
Dialog: 0,0:51:30.87,0:51:32.31, Lalai,,0,0,0,,No.
Dialog: 0,0:51:32.33,0:51:34.52, Lalai,,0,0,0,,Dia berkata pada Hae-in.
Dialog: 0,0:51:34.54,0:51:38.66,Lalai,,0,0,0,,Saya masih sayangkan awak, Hyun-woo.
Dialog: 0,0:51:39.01,0:51:40.78, Lalai,,0,0,0,,- Ayah.\N- Dia masih dalam pemulihan.
Dialog: 0,0:51:40.80,0:51:41.78, Lalai,,0,0,0,,Dia masih dalam kesakitan.
Dialog: 0,0:51:41.80,0:51:42.93, Lalai,,0,0,0,, Awak tak patut peluk dia.
Dialog: 0,0:51:42.95,0:51:43.99,Lalai,,0,0,0,,Saya sayang awak.
Dialog: 0,0:51:44.01,0:51:46.66, Lalai,,0,0,0,,- Doktor.\N- Syabas.
Dialog: 0,0:51:46.68,0:51:48.16, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:51:48.18,0:51:50.64, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:51:51.31,0:51:53.26,Lalai,,0,0,0,,Syabas.
Dialog: 0,0:51:57.19,0:51:58.21, Lalai,,0,0,0,, Wah!
Dialog: 0,0:51:58.24,0:52:00.17, Lalai,,0,0,0,, Tembak-menembak di Korea?
Dialog: 0,0:52:00.20,0:52:01.76,Lalai,,0,0,0,,Saya tidak tahu sama ada ini syarikat...
Dialog: 0,0:52:01.79,0:52:03.37, Lalai,,0,0,0,, atau set drama.
Dialog: 0,0:52:03.39,0:52:04.38, Lalai,,0,0,0,,Saya sangat bengang.
Dialog: 0,0:52:04.41,0:52:07.57,Lalai,,0,0,0,,Saya akan katakan ini lebih seperti drama sejarah.
Dialog: 0,0:52:07.74,0:52:09.93, Lalai,,0,0,0,,- Apa yang anda maksudkan?\N- Sebagai jurusan sejarah,
Dialog: 0,0:52:09.96,0:52:12.68, Lalai,,0,0,0,,Saya melihat ini sebagai pertempuran untuk takhta.
Dialog: 0,0:52:12.71,0:52:14.44, Lalai,,0,0,0,,Mereka membunuh dan mencetuskan pertumpahan darah.
Dialog: 0,0:52:14.46,0:52:15.60,Lalai,,0,0,0,,Anda silap.
Dialog: 0,0:52:15.63,0:52:16.77, Lalai,,0,0,0,,Ini ialah melodrama.
Dialog: 0,0:52:16.80,0:52:18.40, Lalai,,0,0,0,,Seperti "The Dark Knight."
Dialog: 0,0:52:18.42,0:52:20.69, Lalai,,0,0,0,,- Itu bukan melodrama.\N- Ya, betul.
Dialog: 0,0:52:20.72,0:52:22.61, Lalai,,0,0,0,,Batman melalui begitu banyak perkara,
Dialog: 0,0:52:22.63,0:52:23.86,Lalai,,0,0,0,,hanya untuk melindungi wanitanya...
Dialog: 0,0:52:23.89,0:52:25.28,Lalai,,0,0,0,,dan kota tercintanya,
Dialog: 0,0:52:25.30,0:52:26.95, Lalai,,0,0,0,, atau pun "Titanic."
Dialog: 0,0:52:26.97,0:52:28.32,Lalai,,0,0,0,,Jack mengorbankan dirinya...
Dialog: 0,0:52:28.35,0:52:31.38,Lalai,,0,0,0,,untuk wanita yang dia cintai...
Dialog: 0,0:52:31.94,0:52:32.91,Lalai,,0,0,0,,Apa sahaja.
Dialog: 0,0:52:32.94,0:52:35.47, Lalai,,0,0,0,,Saya tidak berminat, bagaimanapun.
Dialog: 0,0:52:35.61,0:52:36.96, Lalai,,0,0,0,,Bagaimanakah anda fikir ia akan berakhir?
Dialog: 0,0:52:36.98,0:52:40.17, Lalai,,0,0,0,,Adakah anda fikir keluarga Queens\Nakan mengambil semula takhta?
Dialog: 0,0:52:40.19,0:52:42.21, Lalai,,0,0,0,,Kenapa? Adakah anda bimbang?
Dialog: 0,0:52:42.24,0:52:44.46,Lalai,,0,0,0,,Saya harap anda kekal berhubung\Ndengan Encik Hong Soo-cheol.
Dialog: 0,0:52:44.48,0:52:45.99,Lalai,,0,0,0,,Adakah sudah terlambat sekarang?
Dialog: 0,0:52:46.02,0:52:47.05, Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,0:52:47.08,0:52:49.89, Lalai,,0,0,0,,Bagaimanapun, saya belajar...
Dialog: 0,0:52:49.91,0:52:53.14, Lalai,,0,0,0,,kata nama abstrak seperti cinta, persahabatan,
Dialog: 0,0:52:53.16,0:52:55.77,Lalai,,0,0,0,,kesetiaan dan kesetiaan...
Dialog: 0,0:52:55.79,0:52:57.48, Lalai,,0,0,0,,mungkin tidak kelihatan,
Dialog: 0,0:52:57.50,0:52:59.77, Lalai,,0,0,0,,tetapi ia pasti wujud.
Dialog: 0,0:52:59.80,0:53:02.96, Lalai,,0,0,0,,Selain itu, ia adalah yang paling berkuasa.
Dialog: 0,0:53:11.93,0:53:13.83, Lalai,,0,0,0,,Terlalu sibuk kali terakhir untuk menyambut anda.
Dialog: 0,0:53:13.85,0:53:16.29,Lalai,,0,0,0,,Saya kawan Hyun-woo.
Dialog: 0,0:53:16.31,0:53:17.89, Lalai,,0,0,0,,Saya Kim Yang-gi.
Dialog: 0,0:53:18.15,0:53:19.58, Lalai,,0,0,0,,- Saya tahu.\N- Awak tahu?
Dialog: 0,0:53:19.61,0:53:20.88, Lalai,,0,0,0,,Dia menulis secara ringkas...
Dialog: 0,0:53:20.90,0:53:23.55, Lalai,,0,0,0,,tentang orang di sekelilingnya dalam buku notanya.
Dialog: 0,0:53:24.61,0:53:25.80, Lalai,,0,0,0,,Apa yang dia tulis?
Dialog: 0,0:53:25.82,0:53:27.72,Lalai,,0,0,0,,Bahawa anda adalah peguam perceraiannya,
Dialog: 0,0:53:28.78,0:53:30.18, Lalai,,0,0,0,,jadi ini bukan alasan.
Dialog: 0,0:53:30.20,0:53:31.51,Lalai,,0,0,0,,Ya, saya adalah peguamnya,
Dialog: 0,0:53:31.54,0:53:34.27,Lalai,,0,0,0,,tetapi saya hampir tidak bertahan dan\Nagak memarahinya.
Dialog: 0,0:53:34.29,0:53:36.10,Lalai,,0,0,0,,Saya cuba menghalangnya...
Dialog: 0,0:53:36.12,0:53:37.69,Lalai,,0,0,0,,daripada menceraikan kamu.
Dialog: 0,0:53:37.71,0:53:39.23, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:53:39.25,0:53:40.48,Lalai,,0,0,0,,By the way,
Dialog: 0,0:53:40.50,0:53:42.82, Lalai,,0,0,0,,- kenapa kita bercerai?\N- Maaf?
Dialog: 0,0:53:42.84,0:53:46.58, Lalai,,0,0,0,,Saya rasa anda lebih tahu.
Dialog: 0,0:53:47.47,0:53:48.74,Lalai,,0,0,0,,Nah...
Dialog: 0,0:53:48.76,0:53:52.16,Lalai,,0,0,0,,Anda berantakan kerana kesibukan\Njadual anda dan memutuskan untuk kekal sebagai kawan...
Dialog: 0,0:53:52.18,0:53:54.66,Lalai,,0,0,0,,Walaupun tinggal bersama?
Dialog: 0,0:53:54.68,0:53:56.22, Lalai,,0,0,0,,Saya tahu, kan?
Dialog: 0,0:53:57.40,0:54:01.43,Lalai,,0,0,0,,Saya rasa sebabnya tidak penting lagi.
Dialog: 0,0:54:02.15,0:54:03.21,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:54:03.23,0:54:05.84, Lalai,,0,0,0,,Tidak ada gunanya menggali masa lalu.
Dialog: 0,0:54:05.86,0:54:08.42, Lalai,,0,0,0,,Saya rasa anda hanya perlu risau tentang lelaki itu...
Dialog: 0,0:54:08.45,0:54:11.76,Lalai,,0,0,0,,yang dibutakan oleh cinta,
Dialog: 0,0:54:11.79,0:54:14.45,Lalai,,0,0,0,,dan mengorbankan dirinya untuk anda.
Dialog: 0,0:54:16.96,0:54:18.89,Lalai,,0,0,0,,Anda kawan baik.
Dialog: 0,0:54:18.92,0:54:21.45, Lalai,,0,0,0,, Astaga. Saya sanjung.
Dialog: 0,0:54:22.09,0:54:25.75,Lalai,,0,0,0,,Malah saya tidak tahu saya seorang kawan yang hebat,
Dialog: 0,0:54:25.88,0:54:29.11,Lalai,,0,0,0,,tetapi kebenaran sentiasa\Ndedahkan dirinya dalam masa yang sukar.
Dialog: 0,0:54:29.14,0:54:30.44, Lalai,,0,0,0,,Saya pasti dia merasakan perkara yang sama.
Dialog: 0,0:54:30.46,0:54:32.95, Lalai,,0,0,0,,Dia nampaknya akhirnya sedar...
Dialog: 0,0:54:32.97,0:54:35.03,Lalai,,0,0,0,,betapa dia menyayangi kamu.
Dialog: 0,0:54:35.06,0:54:38.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan puji saya!{\c}{\i0}
Dialog: 0,0:54:38.02,0:54:40.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda benar-benar mati, atau apa?{\c}{\i0}
Dialog: 0,0:54:41.15,0:54:43.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak tahu apa-apa, bukan?{\c}{\i0}
Dialog: 0,0:54:44.15,0:54:45.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan ke sana...{\c}{\i0}
Dialog: 0,0:54:47.32,0:54:49.65,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kerana saya mahu gembira.{\c}{\i0}
Dialog: 0,0:54:49.82,0:54:52.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak akan dapat hidup dengannya...{\c}{\i0}
Dialog: 0,0:54:52.99,0:54:55.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jika sesuatu berlaku padanya,{\c}{\i0}
Dialog: 0,0:54:57.58,0:54:59.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}atau jika dia cedera.{\c}{\i0}
Dialog: 0,0:55:01.96,0:55:03.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak boleh meramalkan masa depan.{\c}{\i0}
Dialog: 0,0:55:03.42,0:55:06.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak tahan dengannya pada masa lalu,{\c}{\i0}
Dialog: 0,0:55:06.97,0:55:09.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi kini anda sudah mula terkedu.{\c}{\i0}
Dialog: 0,0:55:09.30,0:55:10.84, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda betul.{\c}{\i0}
Dialog: 0,0:55:12.85,0:55:14.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Siapa tahu?{\c}{\i0}
Dialog: 0,0:55:35.24,0:55:36.68, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hei, Hae-in.{\c}{\i0}
Dialog: 0,0:55:36.70,0:55:38.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika anda tidak mahu menyesal,{\c}{\i0}
Dialog: 0,0:55:38.83,0:55:41.16,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jangan berani lepaskan Hyun-woo.{\c}{\i0}
Dialog: 0,0:55:45.42,0:55:48.27, Lalai,,0,0,0,,Saya hampir menyelongkar kertas itu.
Dialog: 0,0:55:48.30,0:55:50.40, Lalai,,0,0,0,,Saya tergesa-gesa.
Dialog: 0,0:55:50.43,0:55:53.34, Lalai,,0,0,0,,Saya sepatutnya hanya menumpukan pada\Nsurgeri jika nyawa saya berada dalam bahaya.
Dialog: 0,0:55:53.36,0:55:55.98,Lalai,,0,0,0,,Bila saya ada masa untuk risau tentang dia?
Dialog: 0,0:56:02.02,0:56:03.55, Lalai,,0,0,0,,Tetapi sekali lagi...
Dialog: 0,0:56:06.15,0:56:08.27, Lalai,,0,0,0,,Saya faham mengapa saya bimbang.
Dialog: 0,0:56:09.24,0:56:10.94, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:56:48.65,0:56:50.94,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya tidak akan melepaskan anda. Saya masih di sini.{\c}{\i0}
Dialog: 0,0:56:52.78,0:56:55.61, Lalai,,0,0,0,,Bila dia membaca ini?
Dialog: 0,0:56:55.66,0:56:57.36, Lalai,,0,0,0,,Sungguh licik...
Dialog: 0,0:57:01.70,0:57:03.24,Lalai,,0,0,0,,En. Baek.
Dialog: 0,0:57:04.42,0:57:06.08, Lalai,,0,0,0,,Bangun.
Dialog: 0,0:57:09.13,0:57:11.57, Lalai,,0,0,0,,Terdapat salah faham.
Dialog: 0,0:57:11.59,0:57:13.86, Lalai,,0,0,0,,Saya tidak menulis bahagian ini.
Dialog: 0,0:57:13.88,0:57:16.38, Lalai,,0,0,0,, Diri lama saya yang menulisnya...
Dialog: 0,0:57:16.89,0:57:18.36, Lalai,,0,0,0,,tergesa-gesa,
Dialog: 0,0:57:18.39,0:57:20.84, Lalai,,0,0,0,,jadi kenapa awak membalas saya?
Dialog: 0,0:57:21.39,0:57:23.63, Lalai,,0,0,0,,Apa? Adakah anda tersenyum?
Dialog: 0,0:57:23.98,0:57:26.43, Lalai,,0,0,0,,Saya melihat segala-galanya. Bangun sekarang.
Dialog: 0,0:57:29.11,0:57:31.42, Lalai,,0,0,0,,Hei, apa itu?
Dialog: 0,0:57:31.44,0:57:33.05, Lalai,,0,0,0,, En. Baek.
Dialog: 0,0:57:33.07,0:57:34.51, Lalai,,0,0,0,,Kenapa awak licik sangat?
Dialog: 0,0:57:34.53,0:57:36.48,Lalai,,0,0,0,,Siapa yang ajar awak?
Dialog: 0,0:57:38.91,0:57:41.68, Lalai,,0,0,0,,Jangan buat saya ketawa. Sakit hati.
Dialog: 0,0:57:41.70,0:57:44.57,Lalai,,0,0,0,,Kalau begitu jangan ketawa dan jawab saya sahaja.
Dialog: 0,0:57:52.05,0:57:54.83, Lalai,,0,0,0,, Patutkah kita pulang ke rumah?
Dialog: 0,0:57:55.18,0:57:56.94, Lalai,,0,0,0,,Saya rasa kita patut.
Dialog: 0,0:57:56.97,0:57:58.50,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:57:59.14,0:58:01.59, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:58:07.94,0:58:10.39, Lalai,,0,0,0,,Kita patut makan.
Dialog: 0,0:58:10.44,0:58:12.63, Lalai,,0,0,0,,- Saya baru makan sandwic.\N- Itu makanan ringan.
Dialog: 0,0:58:12.65,0:58:14.85, Lalai,,0,0,0,,- Ini bukan hidangan.\N- Betul.
Dialog: 0,0:58:14.99,0:58:18.01, Lalai,,0,0,0,,Tetapi beg saya masih ada di dalam.
Dialog: 0,0:58:18.03,0:58:19.90, Lalai,,0,0,0,,- Itu biru di sebelah katil.\N- Hei.
Dialog: 0,0:58:19.93,0:58:23.30, Lalai,,0,0,0,,Beg anda sepatutnya menjadi yang paling kecil daripada kebimbangan anda.
Dialog: 0,0:58:23.33,0:58:27.14,Lalai,,0,0,0,,Cinta sedang di udara sekarang.
Dialog: 0,0:58:27.17,0:58:28.78, Lalai,,0,0,0,,Mari kita pergi.
Dialog: 0,0:58:29.04,0:58:31.52, Lalai,,0,0,0,,Apa kata anda kepada sup ikan pedas...
Dialog: 0,0:58:31.54,0:58:33.11, Lalai,,0,0,0,,- dekat Namhansanseong?\N- Saya kecewa!
Dialog: 0,0:58:33.13,0:58:34.52, Lalai,,0,0,0,,- Beberapa {\i1}makgeolli?{\i0}\N- Bunyinya bagus!
Dialog: 0,0:58:34.55,0:58:36.32,Lalai,,0,0,0,,Bukankah itu sangat jauh?
Dialog: 0,0:58:36.34,0:58:38.11, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:58:38.13,0:58:39.70,Lalai,,0,0,0,,Ia masih berhampiran ibu negara.
Dialog: 0,0:58:39.72,0:58:41.03, Lalai,,0,0,0,,Cepat!
Dialog: 0,0:58:41.05,0:58:44.16,Lalai,,0,0,0,,Kami selalu makan di sekitar pinggir bandar,
Dialog: 0,0:58:44.18,0:58:45.68, Lalai,,0,0,0,, demi burung kekasih itu.
Dialog: 0,0:58:45.71,0:58:46.70,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:58:46.73,0:58:47.75,Lalai,,0,0,0,,Syabas.
Dialog: 0,0:58:47.77,0:58:49.41,Lalai,,0,0,0,,Hantar kami alamat hospital.
Dialog: 0,0:58:49.44,0:58:53.00,Lalai,,0,0,0,,Tidak banyak yang boleh kami lakukan\Kecuali menghantar beberapa lauk.
Dialog: 0,0:58:53.02,0:58:54.96, Lalai,,0,0,0,,- Makanan hospital tidak sedap.\N- Saya setuju.
Dialog: 0,0:58:54.98,0:58:56.96,Lalai,,0,0,0,,Pn. Hong juga tidak sihat sepenuhnya.
Dialog: 0,0:58:56.99,0:59:00.42, Lalai,,0,0,0,,Bagaimana jika dia sakit semasa menjaganya?
Dialog: 0,0:59:00.45,0:59:01.55,Lalai,,0,0,0,,Saya masih iri hati.
Dialog: 0,0:59:01.57,0:59:04.60,Lalai,,0,0,0,,Dia menjaga seorang lelaki\Nyang mengambil peluru untuknya.
Dialog: 0,0:59:04.62,0:59:08.03, Lalai,,0,0,0,,Selain itu, dia sangat cantik.
Dialog: 0,0:59:09.21,0:59:12.69, Lalai,,0,0,0,, Apa sahaja. Dia tidak ingat dia.
Dialog: 0,0:59:12.71,0:59:15.65,Lalai,,0,0,0,,Dia hanya seseorang yang dia temui baru-baru ini.\Adakah anda benar-benar iri hati?
Dialog: 0,0:59:15.67,0:59:18.73, Lalai,,0,0,0,,Itulah bahagian yang terbaik.
Dialog: 0,0:59:18.76,0:59:20.49, Lalai,,0,0,0,,- Apa?\N- Sama ada tiga tahun...
Dialog: 0,0:59:20.51,0:59:22.53, Lalai,,0,0,0,, atau 30 tahun bersama suami anda,
Dialog: 0,0:59:22.55,0:59:24.24,Lalai,,0,0,0,, adakah anda tahu bila anda paling gembira?
Dialog: 0,0:59:24.26,0:59:27.37,Lalai,,0,0,0,,Itu masa anda mula-mula berjumpa antara satu sama lain.
Dialog: 0,0:59:27.39,0:59:30.04,Default,,0,0,0,,Bila dia paling kacak?
Dialog: 0,0:59:30.06,0:59:32.97, Lalai,,0,0,0,,Apabila anda hampir tidak mengenalinya!
Dialog: 0,0:59:33.73,0:59:36.52,Lalai,,0,0,0,,Bahagian yang terbaik ialah apabila anda orang asing!
Dialog: 0,0:59:46.37,0:59:51.07, Lalai,,0,0,0,,Anda mesti menganggap saya bodoh kerana saya hilang ingatan.
Dialog: 0,0:59:52.21,0:59:53.52, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:59:53.54,0:59:54.85, Lalai,,0,0,0,,Biar saya frasa semula...
Dialog: 0,0:59:54.88,0:59:56.94, Lalai,,0,0,0,,apa yang awak beritahu saya.
Dialog: 0,0:59:56.96,0:59:58.50,Lalai,,0,0,0,,Bukan sahaja...
Dialog: 0,0:59:59.84,1:00:01.86,Lalai,,0,0,0,,adakah anda kacak dan mempunyai suara yang bagus,
Dialog: 0,1:00:01.88,1:00:04.07,Lalai,,0,0,0,,tetapi anda adalah pelajar terbaik di sekolah undang-undang.
Dialog: 0,1:00:04.10,1:00:06.37,Lalai,,0,0,0,,Anda juga seorang juara tinju\Nia semasa muda.
Dialog: 0,1:00:06.39,1:00:08.03,Lalai,,0,0,0,,Anda menyertai Kor Marin...
Dialog: 0,1:00:08.06,1:00:10.95,Lalai,,0,0,0,,Pasukan pengawal khas, tepatnya.
Dialog: 0,1:00:10.98,1:00:15.51,Lalai,,0,0,0,,Tepat sekali, jadi anda mendakwa sebagai...
Dialog: 0,1:00:15.65,1:00:17.93,Lalai,,0,0,0,,lelaki yang begitu sempurna.
Dialog: 0,1:00:18.78,1:00:20.85,Lalai,,0,0,0,,Tengok sini, Encik Baek.
Dialog: 0,1:00:21.07,1:00:23.52,Lalai,,0,0,0,,Ya, saya sedang melihat awak.
Dialog: 0,1:00:25.20,1:00:27.68,Lalai,,0,0,0,,Saya faham anda mahu menarik perhatian saya,
Dialog: 0,1:00:27.70,1:00:30.76,Lalai,,0,0,0,,tetapi anda menolaknya. Awak terlalu sempurna.
Dialog: 0,1:00:30.79,1:00:33.95,Lalai,,0,0,0,,Maksud saya... Adakah saya begitu sempurna?
Dialog: 0,1:00:34.00,1:00:37.66,Lalai,,0,0,0,,Sudah tentu. Awak ada semua sifat yang saya suka.
Dialog: 0,1:00:38.05,1:00:41.79,Lalai,,0,0,0,,Betulkah? Adakah anda menyayangi mereka semua?
Dialog: 0,1:00:44.05,1:00:48.91,Lalai,,0,0,0,,Saya faham awak suka saya,\Nand mahu memenangi hati saya sekali lagi,
Dialog: 0,1:00:48.93,1:00:51.08,Lalai,,0,0,0,,tetapi anda harus jujur tentang diri anda.
Dialog: 0,1:00:51.10,1:00:53.20,Lalai,,0,0,0,,Jangan keterlaluan dan beritahu saya perkara sebenar.
Dialog: 0,1:00:53.23,1:00:54.97,Lalai,,0,0,0,,Itulah kebenaran.
Dialog: 0,1:00:55.06,1:00:58.22,Lalai,,0,0,0,,Jujurlah. Anda tidak pernah menjadi juara, bukan?
Dialog: 0,1:01:00.61,1:01:01.84,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:01:01.86,1:01:05.40,Lalai,,0,0,0,,Saya juga suka cara anda ketawa.
Dialog: 0,1:01:07.16,1:01:09.61,Lalai,,0,0,0,,Anda tahu terlalu banyak tentang saya.
Dialog: 0,1:01:09.70,1:01:12.82,Lalai,,0,0,0,,Ia tidak adil, kerana saya tidak ingat apa-apa.
Dialog: 0,1:01:23.72,1:01:26.13,Lalai,,0,0,0,,Ayah, ini saya.
Dialog: 0,1:01:26.30,1:01:28.53,Lalai,,0,0,0,,Adakah anda akhirnya memaafkan saya?
Dialog: 0,1:01:28.55,1:01:29.82,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:01:29.85,1:01:34.68,Lalai,,0,0,0,,Ayah, kami bertiga telah\Nakhirnya berkumpul.
Dialog: 0,1:01:35.35,1:01:37.46,Lalai,,0,0,0,,Jangan risau lagi.
Dialog: 0,1:01:37.48,1:01:41.85,Lalai,,0,0,0,,Sekarang kita telah bersatu semula,\Nkita akan mengambil semula apa yang kita miliki.
Dialog: 0,1:01:43.44,1:01:45.65,Lalai,,0,0,0,,Kami akan membalas dendam anda.
Dialog: 0,1:01:51.04,1:01:53.31,Lalai,,0,0,0,,Jika anda lihat di sini, dia membeli...
Dialog: 0,1:01:53.33,1:01:56.02,Lalai,,0,0,0,,tambahan 7% daripada\N pelabur bukan institusi.
Dialog: 0,1:01:56.04,1:01:58.81,Lalai,,0,0,0,,Adakah itu menjadikan bahagian dia 45.1%?
Dialog: 0,1:01:58.84,1:02:01.73,Lalai,,0,0,0,,Saham beku kami ialah 39.3%.
Dialog: 0,1:02:01.75,1:02:03.89,Lalai,,0,0,0,,Adakah Pione Investment\Nterus menyebelahinya?
Dialog: 0,1:02:03.91,1:02:06.49,Lalai,,0,0,0,,Berdasarkan apa yang saya lihat di New York, mungkin.
Dialog: 0,1:02:06.51,1:02:08.45,Lalai,,0,0,0,,Matlamat mereka adalah untuk menjual syarikat...
Dialog: 0,1:02:08.47,1:02:11.24,Lalai,,0,0,0,,dan pergi sebaik sahaja mereka\Nboleh tanpa menyebabkan kejadian,
Dialog: 0,1:02:11.26,1:02:15.12,Lalai,,0,0,0,,- dan Seul-hee akan mewujudkannya.\N- Maka kami tiada jodoh secara sah.
Dialog: 0,1:02:15.14,1:02:16.70,Lalai,,0,0,0,,Dia pemegang saham terbesar.
Dialog: 0,1:02:16.73,1:02:20.00,Lalai,,0,0,0,,Dia membeli 13.3% daripada\Nsaham dengan dana rahsia,
Dialog: 0,1:02:20.02,1:02:22.04,Lalai,,0,0,0,,tetapi dana rahsia adalah haram,
Dialog: 0,1:02:22.07,1:02:24.88, Lalai,,0,0,0,, dan ia harus dikembalikan kepada kerajaan.
Dialog: 0,1:02:24.90,1:02:27.90,Lalai,,0,0,0,,Saya akan memfailkan saman batal untuknya.
Dialog: 0,1:02:33.70,1:02:35.24,Lalai,,0,0,0,,Hei!
Dialog: 0,1:02:35.79,1:02:38.39,Lalai,,0,0,0,,Apa maksud anda? Mengapa\Nkita harus menyerahkan diri?
Dialog: 0,1:02:38.42,1:02:42.41,Lalai,,0,0,0,,Hei, saya telah melakukan bahagian saya.
Dialog: 0,1:02:48.89,1:02:53.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hyun-woo memberitahu saya bahawa\NMs. Hong akan menyukai lagu-lagu ini.{\c}{\i0}
Dialog: 0,1:02:53.68,1:02:56.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ragu dia akan ingat apa-apa\Nhanya dengan mendengarnya.{\c}{\i0}
Dialog: 0,1:02:56.77,1:02:58.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia telah menonton terlalu banyak drama.{\c}{\i0}
Dialog: 0,1:02:58.31,1:03:00.60,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia melakukan semua yang dia mampu.{\c}{\i0}
Dialog: 0,1:03:00.73,1:03:03.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Selain itu, satu pakej akan dihantar dari Jerman.{\c}{\i0}
Dialog: 0,1:03:03.11,1:03:05.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pastikan dia faham.{\c}{\i0}
Dialog: 0,1:03:05.90,1:03:08.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa saya mesti berbuat demikian?{\c}{\i0}
Dialog: 0,1:03:17.83,1:03:19.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini dari Jerman.{\c}{\i0}
Dialog: 0,1:03:20.25,1:03:25.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan terima. Encik Yoon mahu\Nsemak semua mel yang dihantar kepada Cik Hong.{\c}{\i0}
Dialog: 0,1:03:29.13,1:03:31.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah ini untuk En. Yoon?{\c}{\i0}
Dialog: 0,1:03:31.43,1:03:32.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan mengambilnya.{\c}{\i0}
Dialog: 0,1:03:32.64,1:03:35.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya dalam perjalanan untuk berjumpa dengannya sekarang.{\c}{\i0}
Dialog: 0,1:03:40.27,1:03:43.54,Lalai,,0,0,0,,{\i1}Saya adalah utusan cinta mereka.{\i0}
Dialog: 0,1:03:43.56,1:03:45.08,Lalai,,0,0,0,,Saya akan katakan saya menebus dosa saya.
Dialog: 0,1:03:45.11,1:03:46.34,Lalai,,0,0,0,,Awak dengar tak?
Dialog: 0,1:03:46.36,1:03:48.34,Lalai,,0,0,0,,Jika mereka mahukan saham beku mereka kembali,
Dialog: 0,1:03:48.36,1:03:51.05,Lalai,,0,0,0,,mereka perlu membuktikan Seul-hee\N berada di belakang segala-galanya.
Dialog: 0,1:03:51.07,1:03:52.22,Lalai,,0,0,0,,Kami saksi.
Dialog: 0,1:03:52.24,1:03:53.34,Lalai,,0,0,0,,Anda boleh melakukannya, kemudian.
Dialog: 0,1:03:53.37,1:03:54.84,Lalai,,0,0,0,,- Grace.\N- Hei.
Dialog: 0,1:03:54.87,1:03:58.26,Lalai,,0,0,0,,Perkara paling sia-sia yang anda boleh\Ndo ialah turun dengan seseorang.
Dialog: 0,1:03:58.29,1:04:01.66,Lalai,,0,0,0,,Sekurang-kurangnya izinkan saya berkabung untuk awak.
Dialog: 0,1:04:02.67,1:04:07.29,Lalai,,0,0,0,,Grace, saya tidak mahu hidup seperti Eun-sung.
Dialog: 0,1:04:07.63,1:04:09.36,Lalai,,0,0,0,,Awak tak kasihankan dia?
Dialog: 0,1:04:09.38,1:04:13.24,Lalai,,0,0,0,,Dia terdesak untuk cinta sepanjang hidupnya, tetapi tidak pernah menerimanya.
Dialog: 0,1:04:13.26,1:04:16.42,Lalai,,0,0,0,,Adakah sesiapa yang bersamanya semasa kematiannya?
Dialog: 0,1:04:17.14,1:04:19.28,Lalai,,0,0,0,,Saya mahu mula menjalani kehidupan yang jujur.
Dialog: 0,1:04:19.31,1:04:20.83,Lalai,,0,0,0,,Tiada rahsia.
Dialog: 0,1:04:20.85,1:04:22.29,Lalai,,0,0,0,,Tiada rasa bersalah.
Dialog: 0,1:04:22.31,1:04:23.87,Lalai,,0,0,0,,Tiada penyesalan.
Dialog: 0,1:04:23.90,1:04:25.79,Lalai,,0,0,0,,Saya mahu...
Dialog: 0,1:04:25.82,1:04:27.89,Lalai,,0,0,0,,untuk mencintai...
Dialog: 0,1:04:28.23,1:04:29.77,Lalai,,0,0,0,,dan disayangi.
Dialog: 0,1:04:31.36,1:04:32.90,Lalai,,0,0,0,,Hei.
Dialog: 0,1:04:33.41,1:04:37.01, Lalai,,0,0,0,,Adakah anda fikir mereka akan menerima anda,\Walaupun selepas anda menjalani hukuman penjara?
Dialog: 0,1:04:37.03,1:04:39.32,Lalai,,0,0,0,,Siapa yang akan masuk penjara?
Dialog: 0,1:04:47.04,1:04:48.30,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Evergreen Hope Orphanage{\c}{\i0}
Dialog: 0,1:04:50.05,1:04:51.32,Lalai,,0,0,0,,Jawab saya.
Dialog: 0,1:04:51.34,1:04:52.61,Lalai,,0,0,0,,Anda tidak akan ke mana-mana.
Dialog: 0,1:04:52.63,1:04:53.78,Lalai,,0,0,0,,Jangan buat perkara bodoh.
Dialog: 0,1:04:53.80,1:04:56.67,Lalai,,0,0,0,,Di sinilah kami mula-mula bertemu.
Dialog: 0,1:04:59.02,1:05:02.01,Lalai,,0,0,0,,Saya hampir tidak ingat. Saya sangat kecil.
Dialog: 0,1:05:02.44,1:05:05.55,Lalai,,0,0,0,,Saya sangat bosan di sini.
Dialog: 0,1:05:05.77,1:05:08.38,Lalai,,0,0,0,,Anak-anak lain mempunyai harapan\Nand menunggu ibu mereka...
Dialog: 0,1:05:08.40,1:05:10.10,Lalai,,0,0,0,,untuk mengambilnya,
Dialog: 0,1:05:10.36,1:05:12.60,Lalai,,0,0,0,,tetapi saya tiada sesiapa untuk menunggu.
Dialog: 0,1:05:13.32,1:05:18.40,Lalai,,0,0,0,,Ibu bapa saya langsung tidak meninggalkan\N surat atau nota dengan nama saya.
Dialog: 0,1:05:18.53,1:05:21.26,Lalai,,0,0,0,,Mereka baru sahaja meninggalkan saya dalam\peti Napple semasa musim sejuk.
Dialog: 0,1:05:21.29,1:05:24.20,Lalai,,0,0,0,,Mereka pasti tidak mempunyai rancangan untuk kembali.
Dialog: 0,1:05:25.33,1:05:28.49,Lalai,,0,0,0,,Kemudian pada suatu hari, anda muncul.
Dialog: 0,1:05:28.67,1:05:32.66,Lalai,,0,0,0,,Anda melawat sekali setiap beberapa\Nbulan, dan saya menunggu anda.
Dialog: 0,1:05:34.01,1:05:38.09,Lalai,,0,0,0,,Adakah ketika itu awak mula menaruh perasaan pada saya?
Dialog: 0,1:05:38.35,1:05:41.80,Lalai,,0,0,0,,Bukan itu. Saya hanya boleh\Nmemilikinya apabila anda melawat.
Dialog: 0,1:05:42.10,1:05:43.88,Lalai,,0,0,0,,Strawberry shortcake.
Dialog: 0,1:05:44.94,1:05:46.93,Lalai,,0,0,0,,Da-hye?
Dialog: 0,1:05:47.65,1:05:49.25,Lalai,,0,0,0,,Adakah ini bermakna...
Dialog: 0,1:05:49.27,1:05:52.21,Lalai,,0,0,0,,Saya cinta pertama awak?
Dialog: 0,1:05:52.23,1:05:55.27,Lalai,,0,0,0,,- Betul ke?\N- Saya sedang menunggu kek,
Dialog: 0,1:05:56.28,1:05:57.81,Lalai,,0,0,0,,dan...
Dialog: 0,1:05:59.62,1:06:01.53,Lalai,,0,0,0,,Saya ragu anda mengenali perkara ini.
Dialog: 0,1:06:01.79,1:06:03.82,Lalai,,0,0,0,,Dulu ia milik anda.
Dialog: 0,1:06:05.46,1:06:07.02,Lalai,,0,0,0,,Betulkah?
Dialog: 0,1:06:07.04,1:06:09.62,Lalai,,0,0,0,,Anda menyimpannya selama ini...
Dialog: 0,1:06:09.79,1:06:12.48,Lalai,,0,0,0,,sebagai tanda...
Dialog: 0,1:06:12.51,1:06:14.67,Lalai,,0,0,0,,cinta kita?
Dialog: 0,1:06:15.09,1:06:17.09,Lalai,,0,0,0,,Inilah takdir kita yang tidak berkesudahan.
Dialog: 0,1:06:17.12,1:06:18.11,Lalai,,0,0,0,,Bodoh.
Dialog: 0,1:06:18.14,1:06:20.50,Lalai,,0,0,0,,Saya mengambilnya daripada anda.
Dialog: 0,1:06:23.77,1:06:27.37,Lalai,,0,0,0,,{\i1}Saya sangat menyukai anak patung itu.{\i0}
Dialog: 0,1:06:27.40,1:06:28.87,Lalai,,0,0,0,,{\i1}Membawanya bersama saya...{\i0}
Dialog: 0,1:06:28.90,1:06:33.02,Lalai,,0,0,0,,{\i1}membuat saya berasa seperti anak kaya yang mempunyai ibu bapa.{\i0}
Dialog: 0,1:06:33.53,1:06:36.13,Lalai,,0,0,0,,{\i1}Ia sangat lembut.{\i0}
Dialog: 0,1:06:36.15,1:06:37.80,Lalai,,0,0,0,,{\i1}Saya suka perasaannya.{\i0}
Dialog: 0,1:06:37.82,1:06:40.05,Lalai,,0,0,0,,{\i1}Saya mudah tertidur, walaupun dalam kesejukan,{\i0}
Dialog: 0,1:06:40.07,1:06:42.55,Lalai,,0,0,0,,{\i1}jadi saya ingin mengucapkan terima kasih,{\i0}
Dialog: 0,1:06:42.58,1:06:44.18,Lalai,,0,0,0,,tetapi itu sahaja.
Dialog: 0,1:06:44.20,1:06:46.82,Lalai,,0,0,0,,Anda tidak pernah kembali.
Dialog: 0,1:06:47.33,1:06:49.66,Lalai,,0,0,0,,Jadi adakah anda menunggu saya?
Dialog: 0,1:06:50.63,1:06:52.10,Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,1:06:52.13,1:06:55.29,Lalai,,0,0,0,,Pengerusi memberikan kek yang sama sekali lagi,
Dialog: 0,1:07:01.18,1:07:03.59,Lalai,,0,0,0,,tapi tak sedap lagi,
Dialog: 0,1:07:09.27,1:07:11.97,Lalai,,0,0,0,,kerana saya sedang menunggu awak.
Dialog: 0,1:07:16.49,1:07:19.02,Lalai,,0,0,0,,Saya menunggu lama,
Dialog: 0,1:07:19.74,1:07:22.48,Lalai,,0,0,0,,jadi giliran anda sekarang.
Dialog: 0,1:07:24.12,1:07:25.74,Lalai,,0,0,0,,Saya akan kembali.
Dialog: 0,1:07:26.08,1:07:28.02,Lalai,,0,0,0,,Saya perlu melakukan ini untuk mengangkat beban.
Dialog: 0,1:07:28.04,1:07:30.03,Lalai,,0,0,0,,Da-hye.
Dialog: 0,1:07:30.50,1:07:31.64,Lalai,,0,0,0,,No.
Dialog: 0,1:07:31.67,1:07:33.74,Lalai,,0,0,0,,Sila jaga Geon-u.
Dialog: 0,1:07:34.80,1:07:37.69,Lalai,,0,0,0,,Saya berjanji akan baik selamanya...
Dialog: 0,1:07:37.72,1:07:39.28,Lalai,,0,0,0,,sebaik sahaja saya kembali.
Dialog: 0,1:07:39.30,1:07:42.28,Lalai,,0,0,0,,Saya akan menjadi isteri yang setia dan baik hati.
Dialog: 0,1:07:42.30,1:07:43.49,Lalai,,0,0,0,,Jangan mengarut.
Dialog: 0,1:07:43.51,1:07:46.66,Lalai,,0,0,0,,Adakah anda fikir saya akan membenarkan anda melakukan ini?
Dialog: 0,1:07:46.68,1:07:50.97,Lalai,,0,0,0,,Saya akan mengupah\Nattorney terbaik di negara ini.
Dialog: 0,1:07:51.02,1:07:54.25,Lalai,,0,0,0,,Saya akan menghabiskan semua wang saya jika perlu.
Dialog: 0,1:07:54.27,1:07:56.18,Lalai,,0,0,0,,Saya enggan mengucapkan selamat tinggal!
Dialog: 0,1:07:57.32,1:07:59.09,Lalai,,0,0,0,,Saya tidak mahu.
Dialog: 0,1:07:59.11,1:08:01.27,Lalai,,0,0,0,,Soo-cheol, tolong.
Dialog: 0,1:08:04.20,1:08:06.61,Lalai,,0,0,0,,Berhenti bercakap.
Dialog: 0,1:08:18.30,1:08:19.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Mahkamah{\c}{\i0}
Dialog: 0,1:08:19.30,1:08:20.86,Lalai,,0,0,0,,{\i1}Eun-sung, arwah anak lelaki defendan,{\i0}
Dialog: 0,1:08:20.88,1:08:23.86,Lalai,,0,0,0,,mencuci $900 juta wang rahsia melalui syarikat shellnya,
Dialog: 0,1:08:23.89,1:08:25.86,Lalai,,0,0,0,,dan membelanjakannya untuk saham Kumpulan Queens.
Dialog: 0,1:08:25.89,1:08:28.62,Lalai,,0,0,0,,Selepas kematiannya,\Ndefendan menerima bahagiannya...
Dialog: 0,1:08:28.64,1:08:30.79,Lalai,,0,0,0,,dan membelanjakan baki dana untuk lebih banyak saham.
Dialog: 0,1:08:30.81,1:08:33.29,Lalai,,0,0,0,,Dia memperoleh sejumlah 13.3% saham.
Dialog: 0,1:08:33.31,1:08:38.00,Lalai,,0,0,0,,Plaintif kami ingin memfailkan\saman Kebatalan berkenaan 13.3%...
Dialog: 0,1:08:38.03,1:08:40.17,Lalai,,0,0,0,,defendan memperoleh secara haram.
Dialog: 0,1:08:40.19,1:08:43.77,Lalai,,0,0,0,,Kaunselor defendan\Nboleh memberikan jawapan mereka.
Dialog: 0,1:08:44.20,1:08:47.72,Lalai,,0,0,0,,Defendan kami secara sah\Mewarisi saham dan wang...
Dialog: 0,1:08:47.74,1:08:50.31,Lalai,,0,0,0,,sebelum ini dimiliki oleh arwah anaknya...
Dialog: 0,1:08:50.33,1:08:51.64,Lalai,,0,0,0,,melalui undang-undang penggantian.
Dialog: 0,1:08:51.66,1:08:54.35,Lalai,,0,0,0,, Belum pun sebulan dia kehilangan anaknya.
Dialog: 0,1:08:54.38,1:08:57.40,Lalai,,0,0,0,,Adalah tidak berperikemanusiaan bagi plaintif\N memfailkan saman terhadapnya...
Dialog: 0,1:08:57.42,1:09:00.57,Lalai,,0,0,0,,untuk mengawal syarikat\Nsemasa dia masih berkabung.
Dialog: 0,1:09:00.59,1:09:03.11,Lalai,,0,0,0,,Defendan, Moh,\Nmelakukan penipuan $2 bilion...
Dialog: 0,1:09:03.13,1:09:05.45,Lalai,,0,0,0,,untuk mengambil alih Kumpulan Queens.
Dialog: 0,1:09:05.47,1:09:08.28,Lalai,,0,0,0,,{\i1}Dia menggalakkan orang ramai untuk membeli\Na sebidang tanah yang bermasalah.{\i0}
Dialog: 0,1:09:08.31,1:09:10.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Setelah pembinaan bermula,{\c}{\i0}
Dialog: 0,1:09:10.60,1:09:12.49,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}kami akan menyindir isu pelesenan...{\c}{\i0}
Dialog: 0,1:09:12.52,1:09:15.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}berkaitan dengan ketinggian\Nsekatan kepada pelabur.{\c}{\i0}
Dialog: 0,1:09:15.48,1:09:19.42,Lalai,,0,0,0,,Dia berjaya membuat plaintif\Nmelabur dalam penipuan dengan mengada-adakan...
Dialog: 0,1:09:19.44,1:09:21.96,Lalai,,0,0,0,,keuntungan perniagaan sebanyak lima kali ganda.
Dialog: 0,1:09:21.99,1:09:23.92,Lalai,,0,0,0,,{\i1}Selain itu, dia mencipta kontrak berganda...{\i0}
Dialog: 0,1:09:23.95,1:09:26.55,Lalai,,0,0,0,,{\i1}untuk menjadikannya kelihatan seperti\Nplaintif berada di belakangnya.{\i0}
Dialog: 0,1:09:26.57,1:09:30.26,Lalai,,0,0,0,, Akibatnya, pemilik tanah\Nfailkan saman terhadap plaintif.
Dialog: 0,1:09:30.29,1:09:33.22,Lalai,,0,0,0,,Saya ingin mengemukakan bukti berkaitan,\Nrekod prosiding...
Dialog: 0,1:09:33.25,1:09:36.06,Lalai,,0,0,0,,mengenai penempatan semula pangkalan\Narmy, rancangan pembelian tanah,
Dialog: 0,1:09:36.08,1:09:39.04, Lalai,,0,0,0,,dan bukti keuntungan perniagaan rekaan.
Dialog: 0,1:09:39.25,1:09:40.27,Lalai,,0,0,0,,Semua caj ini...
Dialog: 0,1:09:40.30,1:09:44.07,Lalai,,0,0,0,,ada kaitan dengan Encik Yoon Eun-sung,\Narwah anak lelaki defendan.
Dialog: 0,1:09:44.09,1:09:47.61,Lalai,,0,0,0,,Mereka tiada kaitan dengannya,\Nad tiada bukti untuk menyokongnya.
Dialog: 0,1:09:47.64,1:09:48.66,Lalai,,0,0,0,,Yang Berhormat.
Dialog: 0,1:09:48.68,1:09:50.74,Lalai,,0,0,0,,Saya dan anak saya telah berpisah selama 20 tahun.
Dialog: 0,1:09:50.76,1:09:52.84,Lalai,,0,0,0,,Jadi bagaimana saya tahu...
Dialog: 0,1:09:53.06,1:09:55.54,Lalai,,0,0,0,,bahawa dia telah merancang semua ini?
Dialog: 0,1:09:55.56,1:09:59.51,Lalai,,0,0,0,,Tolong faham saya masih bersedih...
Dialog: 0,1:09:59.65,1:10:01.71,Lalai,,0,0,0,,kehilangan anak saya,
Dialog: 0,1:10:01.73,1:10:05.90,Lalai,,0,0,0,,dan tidak dapat menghuraikan lebih lanjut.
Dialog: 0,1:10:07.24,1:10:11.23,Lalai,,0,0,0,,Saya ingin membawa saksi kepada\Npendirian yang akan membuktikan dia berbohong.
Dialog: 0,1:10:14.46,1:10:16.68,Lalai,,0,0,0,,Saya menyembunyikan identiti saya,
Dialog: 0,1:10:16.71,1:10:19.98,Lalai,,0,0,0,,dan berkahwin dengan Hong Soo-cheol\Nas defendan memberitahu saya.
Dialog: 0,1:10:20.00,1:10:22.73,Lalai,,0,0,0,,Saya memberikan dia maklumat intim,
Dialog: 0,1:10:22.76,1:10:25.03,Lalai,,0,0,0,,memperkenalkan Yoon Eun-sung kepada Hong Soo-cheol,
Dialog: 0,1:10:25.05,1:10:28.75,Lalai,,0,0,0,,dan memujuk suami saya untuk melabur dalam penipuan itu.
Dialog: 0,1:10:28.84,1:10:31.62,Lalai,,0,0,0,,Adakah anda mempunyai bukti bahawa defendan...
Dialog: 0,1:10:31.64,1:10:32.78,Lalai,,0,0,0,,memberi anda pesanan itu?
Dialog: 0,1:10:32.81,1:10:34.84,Lalai,,0,0,0,,Saya...
Dialog: 0,1:10:35.18,1:10:36.16,Lalai,,0,0,0,,jangan.
Dialog: 0,1:10:36.19,1:10:38.08,Lalai,,0,0,0,,Saya dan defendan jarang berjumpa,
Dialog: 0,1:10:38.10,1:10:40.12,Lalai,,0,0,0,,kerana dia sangat berhati-hati.
Dialog: 0,1:10:40.15,1:10:42.33,Lalai,,0,0,0,,Dia membuat orang lain memberi saya pesanannya.
Dialog: 0,1:10:42.36,1:10:45.71,Lalai,,0,0,0,,Saksi kini sedang\Dalam siasatan kerana penipuan.
Dialog: 0,1:10:45.74,1:10:48.00,Lalai,,0,0,0,,Sila ingat bahawa\Ndia boleh melakukan sumpah bohong...
Dialog: 0,1:10:48.02,1:10:50.43,Lalai,,0,0,0,,untuk meringankan hukuman, Yang Berhormat.
Dialog: 0,1:10:51.03,1:10:53.90,Lalai,,0,0,0,,Defendan, anda boleh sebut kenyataan penutup anda.
Dialog: 0,1:10:54.91,1:10:59.39,Lalai,,0,0,0,,Yang Berhormat, apa yang mungkin saya\Ninginkan apabila saya kehilangan anak saya?
Dialog: 0,1:10:59.42,1:11:02.66,Lalai,,0,0,0,,Allahyarham pengerusi menyerahkan\Tidak pernah syarikatnya kepada saya...
Dialog: 0,1:11:03.00,1:11:05.40,Lalai,,0,0,0,,kerana dia tidak boleh mempercayai keluarganya sendiri.
Dialog: 0,1:11:05.42,1:11:07.11,Lalai,,0,0,0,,Dia mahukan saya...
Dialog: 0,1:11:07.13,1:11:09.19,Lalai,,0,0,0,,untuk melindunginya,
Dialog: 0,1:11:09.22,1:11:12.17,Lalai,,0,0,0,,dan itu sahaja yang saya mahu lakukan.
Dialog: 0,1:11:22.73,1:11:24.21,Lalai,,0,0,0,,Yang Berhormat.
Dialog: 0,1:11:24.23,1:11:25.92,Lalai,,0,0,0,,Saya ingin meminta Cik Hong Hae-in,
Dialog: 0,1:11:25.94,1:11:28.80,Lalai,,0,0,0,,salah seorang plaintif kami,\Nuntuk memberikan kenyataan penutup.
Dialog: 0,1:11:28.82,1:11:30.36,Lalai,,0,0,0,,Dia mungkin berbuat demikian.
Dialog: 0,1:11:36.66,1:11:38.28,Lalai,,0,0,0,,Tiga minggu lalu,
Dialog: 0,1:11:38.33,1:11:41.60,Lalai,,0,0,0,,Saya telah diculik dan dikurung\Noleh anak defendan.
Dialog: 0,1:11:41.63,1:11:44.48,Lalai,,0,0,0,,Ketika itulah saya terdengar mereka berdua bercakap.
Dialog: 0,1:11:44.50,1:11:46.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Buktinya anda membunuh pengerusi?{\c}{\i0}
Dialog: 0,1:11:46.55,1:11:48.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika Hae-in juga telah meninggal dunia ketika itu,{\c}{\i0}
Dialog: 0,1:11:48.92,1:11:52.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anda tidak akan mengganggu\N rancangan saya dengan cara ini.{\c}{\i0}
Dialog: 0,1:11:52.43,1:11:53.49,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu satu-satunya penyesalan saya.{\c}{\i0}
Dialog: 0,1:11:53.51,1:11:57.03,Lalai,,0,0,0,,Ketika itulah saya mengetahui\N kemalangan bot 25 tahun lalu,
Dialog: 0,1:11:57.06,1:12:01.85,Lalai,,0,0,0,,dan kematian datuk saya,\N semuanya berkaitan dengan defendan.
Dialog: 0,1:12:12.16,1:12:14.01,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,1:12:14.03,1:12:15.61,Lalai,,0,0,0,,Beraninya awak?
Dialog: 0,1:12:16.12,1:12:20.03,Lalai,,0,0,0,,Hae-in, apa yang awak cakap?
Dialog: 0,1:12:20.71,1:12:23.41,Lalai,,0,0,0,,Saya tidak bersalah, Yang Berhormat.
Dialog: 0,1:12:25.67,1:12:29.52,Lalai,,0,0,0,,Yang Berhormat, plaintif\Baru-baru ini menerima pembedahan otak.
Dialog: 0,1:12:29.55,1:12:32.00,Lalai,,0,0,0,,- Tiada bukti.\N- Ya, ada.
Dialog: 0,1:12:34.80,1:12:38.13,Lalai,,0,0,0,,Bukti ini akan menyokong kenyataannya.
Dialog: 0,1:12:49.28,1:12:51.88,Lalai,,0,0,0,,Yang Berhormat, bukti itu\Ntidak diserahkan terlebih dahulu.
Dialog: 0,1:12:51.90,1:12:53.80,Lalai,,0,0,0,,Anda mahukan bukti.
Dialog: 0,1:12:53.82,1:12:55.77,Lalai,,0,0,0,,Saya akan terima.
Dialog: 0,1:13:14.05,1:13:16.49,Lalai,,0,0,0,,Tunggu. Itu...
Dialog: 0,1:13:16.51,1:13:18.92,Lalai,,0,0,0,,Kenapa...?
Dialog: 0,1:13:39.83,1:13:42.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Aduh, saya tidak tahu lagi.{\c}{\i0}
Dialog: 0,1:13:42.48,1:13:43.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah ini?{\c}{\i0}
Dialog: 0,1:13:43.54,1:13:45.64,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya membuat salinan...{\c}{\i0}
Dialog: 0,1:13:45.67,1:13:46.89,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan letakkannya semula.{\c}{\i0}
Dialog: 0,1:13:46.92,1:13:49.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia tidak akan tahu kami menukarnya.{\c}{\i0}
Dialog: 0,1:13:55.80,1:13:58.86,Lalai,,0,0,0,,Yang Berhormat! Tunggu. Tolong hentikan video itu.
Dialog: 0,1:13:58.89,1:14:00.15,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tidak, anda mungkin tidak sihat.{\c}{\i0}
Dialog: 0,1:14:00.17,1:14:03.24,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Itulah yang dilakukan oleh ubat. Sepuluh\Nminit dalam sistem pernafasan,{\c}{\i0}
Dialog: 0,1:14:03.27,1:14:05.54,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- dan anda akan menjadi lumpuh perlahan-lahan.{\c}{\i0}\N- Anda...!
Dialog: 0,1:14:05.56,1:14:08.04,Lalai,,0,0,0,,Awak perempuan. Saya akan bunuh awak.
Dialog: 0,1:14:08.06,1:14:09.29,Lalai,,0,0,0,,Awak... Bapa...
Dialog: 0,1:14:09.31,1:14:10.96,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Jangan risau.{\c}{\i0}\N- Ayah...
Dialog: 0,1:14:10.98,1:14:13.09,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda tidak akan mati serta-merta.{\c}{\i0}
Dialog: 0,1:14:13.11,1:14:15.44,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika anda lakukan,{\c}{\i0}
Dialog: 0,1:14:15.95,1:14:17.09,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}ini tidak akan berguna.{\c}{\i0}
Dialog: 0,1:14:17.11,1:14:20.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya hanya boleh menjadi penjaga anda yang sah...{\c}{\i0}
Dialog: 0,1:14:20.16,1:14:24.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan nyatakan jika anda koma,{\c}{\i0}
Dialog: 0,1:14:24.58,1:14:26.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi...{\c}{\i0}
Dialog: 0,1:14:26.17,1:14:27.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}koma...{\c}{\i0}
Dialog: 0,1:14:27.42,1:14:30.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}selama dua hingga tiga bulan sebelum anda mati.{\c}{\i0}
Dialog: 0,1:14:30.46,1:14:32.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bolehkah anda melakukannya untuk saya?{\c}{\i0}
Dialog: 0,1:14:45.68,1:14:48.50,Lalai,,0,0,0,,Ia... Ia tidak benar.
Dialog: 0,1:14:48.52,1:14:50.05,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:14:50.44,1:14:51.96,Lalai,,0,0,0,,Ia adalah rekaan.
Dialog: 0,1:14:51.98,1:14:53.93,Lalai,,0,0,0,,Itu bukan saya.
Dialog: 0,1:14:54.40,1:14:56.60,Lalai,,0,0,0,,Katakan sesuatu!
Dialog: 0,1:15:01.41,1:15:04.39,Lalai,,0,0,0,,Sila faham bahawa dia\Nperlu ditangkap sekarang,
Dialog: 0,1:15:04.41,1:15:05.60,Lalai,,0,0,0,,kerana dia mempunyai sejarah...
Dialog: 0,1:15:05.62,1:15:09.28,Lalai,,0,0,0,,menyamar dirinya, dan boleh melarikan diri.
Dialog: 0,1:15:09.63,1:15:10.77,Lalai,,0,0,0,,Pn. Moh Seul-hee.
Dialog: 0,1:15:10.79,1:15:12.58,Lalai,,0,0,0,,Anda ditahan kerana cubaan membunuh.
Dialog: 0,1:15:12.60,1:15:15.32,Lalai,,0,0,0,,Anda boleh mengupah peguam dan memfailkan aduan...
Dialog: 0,1:15:15.34,1:15:16.90,Lalai,,0,0,0,,jika anda menganggap penahanan ini tidak adil.
Dialog: 0,1:15:16.92,1:15:18.61,Lalai,,0,0,0,,Kenapa saya? Tidak!
Dialog: 0,1:15:18.63,1:15:21.50,Lalai,,0,0,0,,- Dapatkan dia.\N- Apa yang saya buat?
Dialog: 0,1:15:22.80,1:15:26.53,Lalai,,0,0,0,,Saya tidak bersalah! Apa salah saya sangat?
Dialog: 0,1:15:26.56,1:15:28.08,Lalai,,0,0,0,,Apa yang saya buat?
Dialog: 0,1:15:28.10,1:15:29.12,Lalai,,0,0,0,,Saya tidak bersalah!
Dialog: 0,1:15:29.14,1:15:31.04,Lalai,,0,0,0,,Lepaskan saya! Saya tidak bersalah!
Dialog: 0,1:15:31.06,1:15:32.71,Lalai,,0,0,0,,Ini tidak adil!
Dialog: 0,1:15:32.73,1:15:35.75,Lalai,,0,0,0,,Apa salah saya? Saya tidak bersalah!
Dialog: 0,1:15:35.78,1:15:38.71,Lalai,,0,0,0,,Apa yang saya buat pada kamu semua?
Dialog: 0,1:15:38.74,1:15:40.72,Lalai,,0,0,0,,Lepaskan saya! Hei!
Dialog: 0,1:15:40.74,1:15:43.58,Lalai,,0,0,0,,Lepaskan saya! sial!
Dialog: 0,1:15:43.60,1:15:44.64,Lalai,,0,0,0,,Lepaskan saya! Tidak!
Dialog: 0,1:15:44.66,1:15:47.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Keluarga Kumpulan Queens telah dikembalikan semula.{\c}{\i0}
Dialog: 0,1:15:47.83,1:15:50.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Keluarga memfailkan saman batal...{\c}{\i0}
Dialog: 0,1:15:50.83,1:15:52.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}terhadap Moh Seul-hee, pasangan domestik...{\c}{\i0}
Dialog: 0,1:15:52.81,1:15:54.60,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}almarhum Pengerusi Hong Man-dae.{\c}{\i0}
Dialog: 0,1:15:54.63,1:15:57.61,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo, peguam plaintif,{\c}{\i0}
Dialog: 0,1:15:57.63,1:15:59.90,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}berjaya membuktikan bahawa\Narwah Yoon Eun-sung...{\c}{\i0}
Dialog: 0,1:15:59.93,1:16:02.86,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan Moh Seul-hee berada\Ndi sebalik penipuan pelaburan.{\c}{\i0}
Dialog: 0,1:16:02.89,1:16:05.49,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Akibatnya, keluarga itu menuntut semula...{\c}{\i0}
Dialog: 0,1:16:05.51,1:16:08.37,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}semua saham mereka yang hilang daripada Pione Investment,{\c}{\i0}
Dialog: 0,1:16:08.39,1:16:12.08,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan penjamin bersama.{\c}{\i0}
Dialog: 0,1:16:12.10,1:16:16.10,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Mereka yang berkaitan dengan penipuan juga telah disabitkan kesalahan.{\c}{\i0}
Dialog: 0,1:16:18.65,1:16:21.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Rakaman video keracunan Moh Seul-hee...{\c}{\i0}
Dialog: 0,1:16:21.20,1:16:25.01,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Allahyarham pengerusi telah diserahkan\Nas bukti semasa perbicaraan,{\c}{\i0}
Dialog: 0,1:16:25.03,1:16:26.10,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}mengejutkan orang ramai.{\c}{\i0}
Dialog: 0,1:16:26.13,1:16:27.90,Lalai,,0,0,0,,- Hubungi peguam saya!\N{\i1}{\c&H7AA0FF&}- Moh telah ditangkap...{\c}{\i0}
Dialog: 0,1:16:27.93,1:16:29.54,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- ...untuk cubaan membunuh.{\c}{\i0}\N- Panggil dia!
Dialog: 0,1:16:29.56,1:16:31.87,Lalai,,0,0,0,,- Hubungi peguam saya!\N{\i1}{\c&H7AA0FF&}- Dia juga sedang disiasat...{\c}{\i0}
Dialog: 0,1:16:31.89,1:16:32.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}untuk penipuan pelaburan,{\c}{\i0}
Dialog: 0,1:16:32.95,1:16:36.44,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}pelanggaran undang-undang transaksi pertukaran asing\N dan kecurian identiti.{\c}{\i0}
Dialog: 0,1:16:37.00,1:16:39.52,Lalai,,0,0,0,,Hei, diam.
Dialog: 0,1:16:39.55,1:16:42.29,Lalai,,0,0,0,,Anda terlalu bising.
Dialog: 0,1:16:42.47,1:16:44.15,Lalai,,0,0,0,,Sialan.
Dialog: 0,1:16:44.18,1:16:46.61,Lalai,,0,0,0,,Lepaskan saya.
Dialog: 0,1:16:46.64,1:16:48.24,Lalai,,0,0,0,,Tangkap dia!
Dialog: 0,1:16:48.27,1:16:51.01,Lalai,,0,0,0,,- Hei!\N- Lepaskan saya!
Dialog: 0,1:16:58.94,1:17:00.81,Lalai,,0,0,0,,Hei.
Dialog: 0,1:17:04.20,1:17:06.11,Lalai,,0,0,0,,Pijak dia.
Dialog: 0,1:17:09.62,1:17:11.57,Lalai,,0,0,0,,Cukuplah.
Dialog: 0,1:18:00.75,1:18:02.27,Lalai,,0,0,0,,Di mana semua orang?
Dialog: 0,1:18:02.30,1:18:05.57,Lalai,,0,0,0,,Hae-in pergi melihat dokumen\Nsebelum kembali bekerja secara rasmi,
Dialog: 0,1:18:05.59,1:18:07.74,Lalai,,0,0,0,,dan Soo-cheol... Sudah jelas.
Dialog: 0,1:18:07.76,1:18:09.49,Lalai,,0,0,0,,Dia meraung. Biarkan dia sendirian.
Dialog: 0,1:18:09.51,1:18:13.01,Lalai,,0,0,0,,Dia akan menangis teresak-esak untuk beberapa kali\N selepas menghantar isterinya pergi.
Dialog: 0,1:18:17.90,1:18:24.13,Lalai,,0,0,0,,Okey. Inilah kapal terbang.
Dialog: 0,1:18:24.15,1:18:26.65,Lalai,,0,0,0,,Anda makan dengan baik.
Dialog: 0,1:18:27.45,1:18:29.01,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Hong Geon-u, Soo-cheol, Da-hye{\c}{\i0}
Dialog: 0,1:18:29.03,1:18:32.49,Lalai,,0,0,0,,Mari kita kuat...
Dialog: 0,1:18:32.83,1:18:34.90,Lalai,,0,0,0,,sehingga Ibu datang.
Dialog: 0,1:18:36.25,1:18:37.85,Lalai,,0,0,0,,- Dan Beom-ja?\N- Mengalahkan saya.
Dialog: 0,1:18:37.87,1:18:41.85,Lalai,,0,0,0,,Dia mendapat semua boneka\Nand pergi selepas mendapat teks.
Dialog: 0,1:18:41.88,1:18:43.90,Lalai,,0,0,0,,Astaga, dia begitu spontan.
Dialog: 0,1:18:43.92,1:18:45.73,Default,,0,0,0,,Kenapa tiba-tiba dia nak jumpa?
Dialog: 0,1:18:45.76,1:18:48.74,Lalai,,0,0,0,,Astaga, saya tidak sepatutnya minum semalam.
Dialog: 0,1:18:48.76,1:18:53.88,Lalai,,0,0,0,,Saya sangat kembung. Di manakah kelopak mata berganda saya?
Dialog: 0,1:19:00.44,1:19:01.71,Lalai,,0,0,0,,Adakah anda tersesat?
Dialog: 0,1:19:01.73,1:19:04.60,Lalai,,0,0,0,,Saya sengaja memilih\Nbangunan tertinggi, jadi lebih mudah untuk dicari.
Dialog: 0,1:19:04.63,1:19:06.59,Lalai,,0,0,0,,Anda betul. Saya melihat bangunan itu,
Dialog: 0,1:19:06.61,1:19:09.17,Lalai,,0,0,0,,tetapi saya mengambil sedikit masa untuk mencari jalan ke sini.
Dialog: 0,1:19:09.20,1:19:10.55,Lalai,,0,0,0,,Saya minta maaf kerana tiba-tiba menelefon.
Dialog: 0,1:19:10.57,1:19:13.61,Lalai,,0,0,0,,Saya menyukainya. Jantung saya berdegup kencang.
Dialog: 0,1:19:19.00,1:19:21.74,Lalai,,0,0,0,,Saya ada sesuatu nak cakap.
Dialog: 0,1:19:22.00,1:19:23.62,Lalai,,0,0,0,,Saya sedang mendengar.
Dialog: 0,1:19:33.01,1:19:34.92,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:19:46.11,1:19:51.15,Lalai,,0,0,0,,Seperti yang anda sedia maklum, kami sangat berbeza.
Dialog: 0,1:19:52.49,1:19:54.19,Lalai,,0,0,0,,Adakah anda di sini...
Dialog: 0,1:19:54.66,1:19:57.47,Lalai,,0,0,0,,untuk menyatakan yang jelas?
Dialog: 0,1:19:57.50,1:20:01.02,Lalai,,0,0,0,,"Saya tahu awak mengaku perasaan awak\Npada saya, tetapi awak dari keluarga kaya."
Dialog: 0,1:20:01.04,1:20:02.73,Lalai,,0,0,0,,"Keluarga kami terlalu berbeza,"
Dialog: 0,1:20:02.75,1:20:03.92,Lalai,,0,0,0,,"jadi ia tidak akan berjaya..."
Dialog: 0,1:20:03.94,1:20:04.94,Lalai,,0,0,0,,Beom-ja.
Dialog: 0,1:20:04.96,1:20:06.36,Lalai,,0,0,0,,Biar saya cakap dulu.
Dialog: 0,1:20:06.97,1:20:08.59,Lalai,,0,0,0,,Teruskan.
Dialog: 0,1:20:11.22,1:20:12.95,Lalai,,0,0,0,,Anda telah berkahwin...
Dialog: 0,1:20:12.97,1:20:13.95,Lalai,,0,0,0,,tiga kali...
Dialog: 0,1:20:15.18,1:20:17.20,Lalai,,0,0,0,,jadi itulah maksudnya.
Dialog: 0,1:20:17.22,1:20:21.84,Lalai,,0,0,0,,Anda enggan berkencan dengan wanita\Nyang telah berkahwin tiga kali.
Dialog: 0,1:20:23.19,1:20:25.42,Lalai,,0,0,0,,- Saya faham.\N- Bukan itu sahaja.
Dialog: 0,1:20:25.44,1:20:27.75,Lalai,,0,0,0,,Anda telah pun mengalami segala-galanya.
Dialog: 0,1:20:27.78,1:20:29.67,Lalai,,0,0,0,,Anda jatuh hati kepada orang lain, bertarikh dengan mereka,
Dialog: 0,1:20:29.69,1:20:31.80,Lalai,,0,0,0,,berkahwin, dan segalanya,
Dialog: 0,1:20:31.82,1:20:35.40,Lalai,,0,0,0,,tetapi ini yang pertama untuk saya.
Dialog: 0,1:20:36.16,1:20:38.01,Lalai,,0,0,0,,- Apa?\N- Saya tidak pernah berkencan dengan sesiapa pun dengan betul,
Dialog: 0,1:20:38.04,1:20:40.32,Lalai,,0,0,0,,malah sehingga hari ini.
Dialog: 0,1:20:41.83,1:20:43.99,Lalai,,0,0,0,,- Serius?\N- Ya,
Dialog: 0,1:20:44.42,1:20:49.54,Lalai,,0,0,0,,jadi sukar untuk berjalan mengikut rentak anda.
Dialog: 0,1:21:15.74,1:21:17.74,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Menunggu Bermaksud Cinta{\c}{\i0}
Dialog: 0,1:21:16.74,1:21:20.97,Lalai,,0,0,0,,{\i1}Ini kali pertama saya menunggu seseorang.{\i0}
Dialog: 0,1:21:18.98,1:21:21.85,Lalai,,0,0,0,,{\i1}Saya tidak pernah merindui seorang wanita sebelum ini,{\i0}
Dialog: 0,1:21:22.21,1:21:23.98,Lalai,,0,0,0,,tetapi kemudian saya tersekat.
Dialog: 0,1:21:24.00,1:21:27.83,Lalai,,0,0,0,,Sama seperti bagaimana saya tersesat hari ini,\NI tidak tahu hendak pergi ke mana.
Dialog: 0,1:21:31.05,1:21:32.75,Lalai,,0,0,0,,Kemudian...
Dialog: 0,1:21:33.22,1:21:37.13,Lalai,,0,0,0,,apa yang anda mahu saya lakukan?
Dialog: 0,1:21:41.06,1:21:44.20,Lalai,,0,0,0,,Saya pandai memasak dan membakar.
Dialog: 0,1:21:44.23,1:21:46.71,Lalai,,0,0,0,,Saya ingin memasak daging untuk\Nyou apabila anda sedang bergelut,
Dialog: 0,1:21:46.73,1:21:49.67,Lalai,,0,0,0,,dan bakar madeleines untuk anda apabila anda bosan.
Dialog: 0,1:21:49.69,1:21:51.21,Lalai,,0,0,0,,Saya ingin berbuat demikian.
Dialog: 0,1:21:51.23,1:21:55.19,Lalai,,0,0,0,,Mengapa anda tidak melawat saya ketika anda sedang bergelut...
Dialog: 0,1:21:55.53,1:21:57.27,Lalai,,0,0,0,,atau rasa bosan?
Dialog: 0,1:21:59.20,1:22:01.26,Lalai,,0,0,0,,Baiklah, saya akan lakukan itu.
Dialog: 0,1:22:01.29,1:22:04.53,Lalai,,0,0,0,,Saya hanya akan datang kepada anda jika\Anda tidak dapat mencari jalan anda.
Dialog: 0,1:22:06.63,1:22:10.54,Lalai,,0,0,0,,Anda boleh mengambil masa manis anda.
Dialog: 0,1:22:17.97,1:22:19.95,Lalai,,0,0,0,,Adakah bercerai menjadi trend hari ini?
Dialog: 0,1:22:19.97,1:22:22.12,Lalai,,0,0,0,,Kenapa awak nak cerai?
Dialog: 0,1:22:22.14,1:22:26.37,Lalai,,0,0,0,,Jika ia bukan mengenai wang, wanita atau keganasan,
Dialog: 0,1:22:26.39,1:22:28.29,Lalai,,0,0,0,,kemudian sabar sahaja.
Dialog: 0,1:22:28.31,1:22:29.33,Lalai,,0,0,0,,Semuanya.
Dialog: 0,1:22:29.36,1:22:30.57,Lalai,,0,0,0,,- Semuanya?\N- Semuanya?
Dialog: 0,1:22:30.60,1:22:32.04,Lalai,,0,0,0,,Chun-sik bertemu...
Dialog: 0,1:22:32.07,1:22:33.96,Lalai,,0,0,0,,cinta pertamanya di perjumpaan semula.
Dialog: 0,1:22:33.99,1:22:35.63,Lalai,,0,0,0,,Kebaikan. Hei.
Dialog: 0,1:22:35.65,1:22:38.97,Lalai,,0,0,0,,Selalu ada cinta pertama semasa perjumpaan.
Dialog: 0,1:22:38.99,1:22:42.11,Lalai,,0,0,0,,Ia perkara biasa.
Dialog: 0,1:22:42.16,1:22:47.57,Lalai,,0,0,0,,Dia bekerja dalam insurans, dan dia mengambil\Tanpa tiga polisi insurans hayat.
Dialog: 0,1:22:48.42,1:22:49.52,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:22:49.54,1:22:51.65,Lalai,,0,0,0,,- Dan dia menjadi ganas?\N- Tidak, itu saya.
Dialog: 0,1:22:51.67,1:22:55.15,Lalai,,0,0,0,,Saya memukulnya kerana marah,\Nand dia menuntut cerai...
Dialog: 0,1:22:55.17,1:22:56.23,Lalai,,0,0,0,,kerananya.
Dialog: 0,1:22:56.26,1:22:58.49,Lalai,,0,0,0,,Jadi? Bilakah anda akan menceraikannya?
Dialog: 0,1:22:58.51,1:23:01.13,Lalai,,0,0,0,,Saya ingin melakukannya dengan segera,
Dialog: 0,1:23:02.35,1:23:04.49,Lalai,,0,0,0,,tetapi masa pertengahan penggal anak kita akan datang tidak lama lagi.
Dialog: 0,1:23:04.52,1:23:06.26,Lalai,,0,0,0,,Ini adalah saat genting.
Dialog: 0,1:23:06.43,1:23:09.66,Lalai,,0,0,0,,Saya terfikir untuk menceraikannya semasa rehat,
Dialog: 0,1:23:09.69,1:23:12.88,Lalai,,0,0,0,,tetapi kami sudah menempah perjalanan,
Dialog: 0,1:23:12.90,1:23:14.46,Lalai,,0,0,0,,jadi saya tidak boleh berbuat demikian.
Dialog: 0,1:23:14.48,1:23:16.96,Lalai,,0,0,0,,Dan sebaik sahaja persekolahan bermula,\Npenggal pertengahan akan datang lagi.
Dialog: 0,1:23:16.99,1:23:19.44,Lalai,,0,0,0,,- Astaga, awak betul.\N- Betul.
Dialog: 0,1:23:20.03,1:23:23.44,Lalai,,0,0,0,,Maka anda tidak akan pernah menceraikannya. Buat sahaja sekarang.
Dialog: 0,1:23:23.79,1:23:25.65,Lalai,,0,0,0,,Saya akan sertai awak.
Dialog: 0,1:23:26.12,1:23:27.14,Lalai,,0,0,0,,Sertai saya?
Dialog: 0,1:23:27.16,1:23:30.56,Lalai,,0,0,0,,Kita akan mengalami lebih sedikit kerosakan jika\Nkita menjatuhkan bom ini bersama-sama.
Dialog: 0,1:23:30.58,1:23:33.48,Lalai,,0,0,0,,Mari kita masa pengumuman kita. Saya akan pergi sekarang.
Dialog: 0,1:23:33.50,1:23:34.98,Lalai,,0,0,0,,Anda boleh menunggu beberapa hari.
Dialog: 0,1:23:35.01,1:23:37.96,Lalai,,0,0,0,,Hei, adakah anda serius?
Dialog: 0,1:23:41.59,1:23:42.78,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:23:42.80,1:23:44.74,Lalai,,0,0,0,,Saya berfikir panjang dan keras.
Dialog: 0,1:23:44.76,1:23:46.76,Lalai,,0,0,0,,- Ia mesti dilakukan.\N- Apa yang wanita itu katakan?
Dialog: 0,1:23:46.79,1:23:49.62,Lalai,,0,0,0,,Saya tidak tahu. Nama dia Jenny.
Dialog: 0,1:23:49.85,1:23:52.16,Lalai,,0,0,0,,Dia berkata dia isterinya atau sesuatu.
Dialog: 0,1:23:52.19,1:23:54.38,Lalai,,0,0,0,,Itu dia cakap? Bahawa dia isterinya?
Dialog: 0,1:23:54.40,1:23:57.64,Lalai,,0,0,0,,Ya, itulah konteksnya.
Dialog: 0,1:23:58.65,1:24:01.30,Lalai,,0,0,0,,Suami anda meminta saya\Nuntuk menyampaikan mesej ini kepada anda.
Dialog: 0,1:24:01.32,1:24:02.43,Lalai,,0,0,0,,Jenny...
Dialog: 0,1:24:02.45,1:24:03.97,Lalai,,0,0,0,,- berumur 60 tahun.\N- Apa?
Dialog: 0,1:24:03.99,1:24:06.49,Lalai,,0,0,0,,Dia sebaya dengan saya.
Dialog: 0,1:24:06.87,1:24:08.51,Default,,0,0,0,,Jadi dia suka perempuan yang lebih tua?
Dialog: 0,1:24:08.54,1:24:10.27,Lalai,,0,0,0,,Bukan itu.
Dialog: 0,1:24:10.29,1:24:13.06,Lalai,,0,0,0,,Dia meninggalkan telefonnya di makmal,
Dialog: 0,1:24:13.08,1:24:16.00,Lalai,,0,0,0,,dan profesornya mengambilnya.
Dialog: 0,1:24:16.17,1:24:18.02,Lalai,,0,0,0,,Serius?
Dialog: 0,1:24:18.05,1:24:19.65,Lalai,,0,0,0,,Jadi dia profesornya?
Dialog: 0,1:24:19.67,1:24:22.49,Lalai,,0,0,0,,Dia kecewa kerana tidak dapat menghubungi anda,
Dialog: 0,1:24:22.51,1:24:24.34,Lalai,,0,0,0,,- dan meminta saya menyampaikan ini.\N- Relay apa?
Dialog: 0,1:24:24.36,1:24:26.27,Lalai,,0,0,0,,"Saya sayang awak!"
Dialog: 0,1:24:27.97,1:24:29.66,Lalai,,0,0,0,,Mengapa dia akan mengatakannya kepada anda,
Dialog: 0,1:24:29.68,1:24:32.60,Lalai,,0,0,0,,apabila dia boleh mengatakannya kepada saya?
Dialog: 0,1:24:32.98,1:24:35.46,Lalai,,0,0,0,,Dia tidak pernah menyebut perkataan itu kepada saya sebelum ini.
Dialog: 0,1:24:35.48,1:24:37.13,Lalai,,0,0,0,,Anda harus menyahsekat nombornya.
Dialog: 0,1:24:37.15,1:24:38.88,Lalai,,0,0,0,,Tahukah anda mengapa peperangan berlaku?
Dialog: 0,1:24:38.90,1:24:41.55,Lalai,,0,0,0,,Ia disebabkan oleh komunikasi yang lemah.
Dialog: 0,1:24:41.57,1:24:43.72,Lalai,,0,0,0,,Mengapa anda tidak mahu bercakap?
Dialog: 0,1:24:43.74,1:24:45.63,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:24:45.66,1:24:47.19,Lalai,,0,0,0,,Di sini.
Dialog: 0,1:24:49.58,1:24:51.10,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:24:51.12,1:24:52.85,Lalai,,0,0,0,,Hadiah daripada kami, pemilik bangunan.
Dialog: 0,1:24:52.87,1:24:54.64,Lalai,,0,0,0,,Pergi jumpa dia.
Dialog: 0,1:24:54.67,1:24:57.94,Lalai,,0,0,0,,Pandang matanya dan beritahu dia perkara ini.
Dialog: 0,1:24:57.96,1:24:59.83,Lalai,,0,0,0,,"Saya sayang awak"?
Dialog: 0,1:25:00.05,1:25:01.96,Lalai,,0,0,0, "Saya juga!"
Dialog: 0,1:25:04.47,1:25:06.30,Lalai,,0,0,0,,Ibu...
Dialog: 0,1:25:07.31,1:25:09.22,Lalai,,0,0,0,,Ayah...
Dialog: 0,1:25:12.52,1:25:14.76,Lalai,,0,0,0,,Pergi.
Dialog: 0,1:25:14.98,1:25:18.18,Lalai,,0,0,0,,Go. Pergi ke A.S.
Dialog: 0,1:25:18.98,1:25:20.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Queens Department Store{\c}{\i0}
Dialog: 0,1:25:21.65,1:25:22.76,Lalai,,0,0,0,,Setiausaha Na.
Dialog: 0,1:25:22.78,1:25:25.01,Lalai,,0,0,0,,Saya baru mendapat idea.
Dialog: 0,1:25:25.03,1:25:26.72,Lalai,,0,0,0,,Saya sedang berfikir untuk mengalih keluar...
Dialog: 0,1:25:26.74,1:25:29.85,Lalai,,0,0,0,,kedai pop timbul ini dan mengubah suai kawasan itu.
Dialog: 0,1:25:29.87,1:25:33.99,Lalai,,0,0,0,,- Saya ingin mempunyai plaza...\N- ...jadi kanak-kanak boleh berlari-lari?
Dialog: 0,1:25:34.08,1:25:36.77,Lalai,,0,0,0,,Ya, dan saya mahukan ruang rehat...
Dialog: 0,1:25:36.79,1:25:39.83, Lalai,,0,0,0,,Kami akan membuat banyak daripadanya.
Dialog: 0,1:25:40.05,1:25:42.38,Lalai,,0,0,0,,Anda sudah memberitahu saya perkara ini sebelum pembedahan.
Dialog: 0,1:25:42.41,1:25:43.44,Lalai,,0,0,0,,Saya buat?
Dialog: 0,1:25:43.47,1:25:47.38,Lalai,,0,0,0,,Saya rasa beberapa perkara tidak pernah berubah,\Nwalaupun hilang ingatan.
Dialog: 0,1:25:57.31,1:25:58.33,Lalai,,0,0,0,,Adakah anda makan tengah hari?
Dialog: 0,1:25:58.36,1:26:00.35,Lalai,,0,0,0,,Saya akan melakukannya.
Dialog: 0,1:26:00.82,1:26:02.64,Lalai,,0,0,0,,Nikmati.
Dialog: 0,1:26:02.78,1:26:04.35,Lalai,,0,0,0,,Nikmati makan tengah hari anda.
Dialog: 0,1:26:13.04,1:26:15.16,Lalai,,0,0,0,,Bila anda akan berkahwin?
Dialog: 0,1:26:15.96,1:26:18.41,Lalai,,0,0,0,,- Jangan mengarut.\N- Bukan?
Dialog: 0,1:26:18.71,1:26:19.69,Lalai,,0,0,0,,No.
Dialog: 0,1:26:19.71,1:26:20.98,Lalai,,0,0,0,,Fikirkanlah.
Dialog: 0,1:26:21.00,1:26:24.98,Lalai,,0,0,0,,Dia seperti orang asing yang baru saya kenali.
Dialog: 0,1:26:25.01,1:26:27.07,Lalai,,0,0,0,,Saya suka dia, dan saya bersyukur,
Dialog: 0,1:26:27.09,1:26:29.66,Lalai,,0,0,0,,tetapi suhu cinta kami berbeza.
Dialog: 0,1:26:29.68,1:26:31.34,Lalai,,0,0,0,,Adakah mereka?
Dialog: 0,1:26:31.51,1:26:35.18,Lalai,,0,0,0,,Sudah tentu. Suhunya kira-kira 350 °F.
Dialog: 0,1:26:35.81,1:26:38.21,Default,,0,0,0,,Cukup panas nak goreng ayam ni.
Dialog: 0,1:26:38.23,1:26:40.75,Lalai,,0,0,0,,Berbeza dengan dia yang sedang mendidih,
Dialog: 0,1:26:40.77,1:26:44.80,Lalai,,0,0,0,,suhu saya hanya\Tiada untuk secawan kopi.
Dialog: 0,1:26:44.82,1:26:49.23,Lalai,,0,0,0,,Itulah sebabnya terlalu awal untuk bercakap tentang perkahwinan.
Dialog: 0,1:26:50.37,1:26:51.90,Lalai,,0,0,0,,Mengapa anda bertanya?
Dialog: 0,1:26:51.99,1:26:53.22,Lalai,,0,0,0,,Adakah itu yang dia katakan?
Dialog: 0,1:26:53.24,1:26:55.45,Lalai,,0,0,0,,- Adakah dia mahu berkahwin dengan saya?\N- Tidak.
Dialog: 0,1:26:57.08,1:26:58.35,Lalai,,0,0,0,,- Tidak?\N- Betul.
Dialog: 0,1:26:58.37,1:27:00.02,Lalai,,0,0,0,,Dia tidak pernah berkata sedemikian.
Dialog: 0,1:27:00.04,1:27:01.98,Lalai,,0,0,0,,Ia hanyalah sesuatu yang diandaikan oleh semua orang.
Dialog: 0,1:27:02.00,1:27:04.62,Lalai,,0,0,0,,Dia masih melamar, bukan?
Dialog: 0,1:27:07.43,1:27:10.70,Lalai,,0,0,0,,Saya tidak ingat, tetapi dia ingat pada masa lalu.
Dialog: 0,1:27:10.72,1:27:12.50,Lalai,,0,0,0,,- Saya juga ada di rumah.\N- Ayuh.
Dialog: 0,1:27:12.53,1:27:14.45,Lalai,,0,0,0,,Anda tidak ingat itu,
Dialog: 0,1:27:14.47,1:27:15.53,Lalai,,0,0,0,,jadi ia tidak dikira.
Dialog: 0,1:27:15.56,1:27:17.38,Lalai,,0,0,0,,Dia tak meminang lagi?
Dialog: 0,1:27:17.73,1:27:20.68,Lalai,,0,0,0,,Serius? Itu sejuk.
Dialog: 0,1:27:22.52,1:27:23.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mesej Baharu{\c}{\i0}
Dialog: 0,1:27:27.86,1:27:30.01,Default,,0,0,0,,Puan, masanya sudah tiba.
Dialog: 0,1:27:30.03,1:27:31.51,Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,1:27:31.53,1:27:33.97,Lalai,,0,0,0,,Pengarah Baek membuat\Tempahan di sebuah restoran...
Dialog: 0,1:27:33.99,1:27:36.95,Lalai,,0,0,0,,di mana ramai orang melamar.
Dialog: 0,1:27:37.71,1:27:39.31,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:27:39.33,1:27:41.52,Lalai,,0,0,0,,Saya belum bersedia lagi.
Dialog: 0,1:27:41.54,1:27:43.27,Lalai,,0,0,0,,Mengapa dia mendahului dirinya?
Dialog: 0,1:27:43.29,1:27:45.15,Lalai,,0,0,0,,Bagaimana saya boleh menolaknya?
Dialog: 0,1:27:45.17,1:27:48.83,Lalai,,0,0,0,,Saya tidak mahu menyakiti seseorang\Nyang mengambil peluru untuk saya.
Dialog: 0,1:28:29.59,1:28:30.57,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:28:30.59,1:28:33.03,Lalai,,0,0,0,,Dia patut telefon saya...
Dialog: 0,1:28:33.05,1:28:35.13,Lalai,,0,0,0,,jika dia menempah restoran.
Dialog: 0,1:28:36.81,1:28:38.59,Lalai,,0,0,0,,Saya lapar.
Dialog: 0,1:28:40.10,1:28:41.79,Lalai,,0,0,0,,Aduh, serius.
Dialog: 0,1:28:41.81,1:28:42.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:28:45.86,1:28:46.96,Lalai,,0,0,0,,{\i1}Helo?{\i0}
Dialog: 0,1:28:46.98,1:28:48.68,Lalai,,0,0,0,,Helo?
Dialog: 0,1:28:49.86,1:28:51.26,Lalai,,0,0,0,,Maksud saya...
Dialog: 0,1:28:51.28,1:28:52.98,Lalai,,0,0,0,,Di manakah anda...
Dialog: 0,1:28:53.66,1:28:54.63,Lalai,,0,0,0,,sekarang?
Dialog: 0,1:28:54.66,1:28:55.93,Lalai,,0,0,0,,- Ceria!\N- Ceria!
Dialog: 0,1:28:55.95,1:28:59.74,Lalai,,0,0,0,,Saya sedang makan malam syarikat di sebuah restoran.
Dialog: 0,1:29:00.71,1:29:03.45,Lalai,,0,0,0,,Adakah sesuatu sedang berlaku? Adakah anda tidak sihat?
Dialog: 0,1:29:03.71,1:29:05.52,Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,1:29:05.54,1:29:09.87,Lalai,,0,0,0,,Saya tidak apa-apa. Nikmati makan malam anda.
Dialog: 0,1:29:14.18,1:29:16.05,Lalai,,0,0,0,,Makan malam syarikat?
Dialog: 0,1:29:52.47,1:29:54.17,Lalai,,0,0,0,,Apa itu?
Dialog: 0,1:29:54.38,1:29:55.69,Lalai,,0,0,0,,Dia bukan kanak-kanak lagi.
Dialog: 0,1:29:55.72,1:29:57.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Singkirkan mereka.{\c}{\i0}
Dialog: 0,1:30:00.72,1:30:02.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Alih keluar...{\c}{\i0}
Dialog: 0,1:30:02.68,1:30:06.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}semua bintang\N yang bercahaya-dalam-gelap dan semua objek.{\c}{\i0}
Dialog: 0,1:30:25.37,1:30:27.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimanakah anda boleh mengalihkan\Nbarang anda tanpa memberitahu saya?{\c}{\i0}
Dialog: 0,1:30:27.48,1:30:29.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tidak pernah memberitahu saya yang anda\Menosongkan bilik ini juga.{\c}{\i0}
Dialog: 0,1:30:29.82,1:30:31.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa yang anda perolehi?{\c}{\i0}
Dialog: 0,1:30:33.05,1:30:34.98,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda menyalahkan saya atas keguguran?{\c}{\i0}
Dialog: 0,1:30:35.01,1:30:36.32,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa yang anda katakan?{\c}{\i0}
Dialog: 0,1:30:36.34,1:30:39.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak pernah terfikir begitu.\NI saya sama sedihnya dengan awak...{\c}{\i0}
Dialog: 0,1:30:39.18,1:30:41.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan berbohong.{\c}{\i0}
Dialog: 0,1:30:41.10,1:30:44.63,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tahu awak nak cakap ini salah saya!{\c}{\i0}
Dialog: 0,1:30:49.19,1:30:50.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lupakan.{\c}{\i0}
Dialog: 0,1:30:50.40,1:30:53.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak boleh bercakap apa-apa dengan anda.{\c}{\i0}
Dialog: 0,1:31:29.06,1:31:31.54,Lalai,,0,0,0,,Saya tunggu awak semalam.
Dialog: 0,1:31:31.56,1:31:34.29,Lalai,,0,0,0,,Saya dengar awak menempah restoran...
Dialog: 0,1:31:34.32,1:31:36.30,Lalai,,0,0,0,,di mana ramai orang telah mencadangkan.
Dialog: 0,1:31:36.32,1:31:38.01,Lalai,,0,0,0,,Saya terkejut, kerana saya fikir...
Dialog: 0,1:31:38.03,1:31:40.22,Lalai,,0,0,0,,anda mahu melamar saya lagi.
Dialog: 0,1:31:40.25,1:31:43.87,Lalai,,0,0,0,,Saya berfikir panjang dan keras tentang\Bagaimana cara mengecewakan anda dengan lembut.
Dialog: 0,1:31:45.08,1:31:48.14,Lalai,,0,0,0,,Jadi awak bercadang untuk menolak saya...
Dialog: 0,1:31:48.16,1:31:49.89,Lalai,,0,0,0,,jika saya mencadangkan?
Dialog: 0,1:31:49.92,1:31:51.95,Lalai,,0,0,0,,Ya,
Dialog: 0,1:31:52.08,1:31:53.70,Lalai,,0,0,0,,tetapi anda tidak pernah melakukannya,
Dialog: 0,1:31:54.88,1:31:56.71,Lalai,,0,0,0,,jadi saya tidak dapat menolak awak.
Dialog: 0,1:31:57.80,1:31:59.88,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:32:00.22,1:32:02.00,Lalai,,0,0,0,,Tetapi kenapa?
Dialog: 0,1:32:02.30,1:32:03.82,Lalai,,0,0,0,,Kenapa awak tolak saya?
Dialog: 0,1:32:03.85,1:32:05.76,Lalai,,0,0,0,,Sebab saya takut.
Dialog: 0,1:32:05.85,1:32:09.47,Lalai,,0,0,0,,Kami baik. Saya tidak mahu merosakkannya.
Dialog: 0,1:32:16.07,1:32:17.64,Lalai,,0,0,0,,Tetapi sudah terlambat.
Dialog: 0,1:32:18.11,1:32:21.47,Lalai,,0,0,0,,Saya akan menolak anda jika\Anda melamar semalam,
Dialog: 0,1:32:21.49,1:32:23.82,Lalai,,0,0,0,,tetapi saya sudah berubah fikiran sekarang.
Dialog: 0,1:32:25.66,1:32:29.20,Lalai,,0,0,0,,Saya teringat memori terburuk saya malam tadi.
Dialog: 0,1:32:31.00,1:32:33.87,Lalai,,0,0,0,,Ia menghancurkan dan menyakitkan saya,
Dialog: 0,1:32:34.09,1:32:36.29,Lalai,,0,0,0,,tetapi saya juga lega.
Dialog: 0,1:32:36.75,1:32:40.58,Lalai,,0,0,0,,Saya kurang takut sekarang berbanding ketika saya dalam gelap.
Dialog: 0,1:32:42.80,1:32:45.07,Lalai,,0,0,0,,Kami mungkin berpecah belah...
Dialog: 0,1:32:45.10,1:32:48.03,Lalai,,0,0,0,,disebabkan perkara remeh.
Dialog: 0,1:32:48.06,1:32:50.87,Lalai,,0,0,0,,Kami mengatakan perkara yang kami tidak maksudkan,
Dialog: 0,1:32:50.89,1:32:52.50,Lalai,,0,0,0,,dan melindungi ego kita,
Dialog: 0,1:32:52.52,1:32:55.33, Lalai,,0,0,0,, dan itu menyebabkan salah faham bodoh.
Dialog: 0,1:32:55.36,1:32:58.21,Lalai,,0,0,0,,Daripada mengetuk pintu anda,
Dialog: 0,1:32:58.23,1:32:59.75,Lalai,,0,0,0,,mungkin lebih mudah...
Dialog: 0,1:32:59.78,1:33:02.94,Lalai,,0,0,0,,untuk tinggal di bilik saya...
Dialog: 0,1:33:03.45,1:33:05.27,Lalai,,0,0,0,,dan membenci anda,
Dialog: 0,1:33:05.70,1:33:07.23,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:33:08.08,1:33:10.24,Lalai,,0,0,0,,Saya tidak akan berbuat demikian lagi.
Dialog: 0,1:33:11.79,1:33:14.41,Lalai,,0,0,0,,Maka mungkin kita boleh mencubanya.
Dialog: 0,1:33:20.59,1:33:22.40,Lalai,,0,0,0,,Saya juga.
Dialog: 0,1:33:22.43,1:33:24.21,Lalai,,0,0,0,,Saya merasakan perkara yang sama.
Dialog: 0,1:33:25.39,1:33:28.42,Lalai,,0,0,0,,Saya tidak akan takut...
Dialog: 0,1:33:28.60,1:33:31.08,Lalai,,0,0,0,,untuk mengambil peluru lain untuk anda,
Dialog: 0,1:33:31.10,1:33:34.25,Lalai,,0,0,0,,tetapi saya takut...
Dialog: 0,1:33:34.27,1:33:35.97,Lalai,,0,0,0,,kita akan keletihan...
Dialog: 0,1:33:36.52,1:33:42.69,Lalai,,0,0,0,,dan kecewa antara satu sama lain\Nother selepas bertengkar...
Dialog: 0,1:33:44.70,1:33:46.34,Lalai,,0,0,0,,perkara yang paling remeh.
Dialog: 0,1:33:46.37,1:33:48.64,Lalai,,0,0,0,,Saya tidak yakin bahawa\Nkita tidak akan berpecah belah...
Dialog: 0,1:33:48.66,1:33:51.28,Lalai,,0,0,0,,atau saling berdendam...
Dialog: 0,1:33:53.41,1:33:55.28,Lalai,,0,0,0,,sekali lagi,
Dialog: 0,1:33:56.63,1:33:59.08,Lalai,,0,0,0,,tetapi saya boleh menjanjikan ini kepada anda.
Dialog: 0,1:34:14.60,1:34:16.51,Lalai,,0,0,0,,Saya akan tetap dengan awak.
Dialog: 0,1:34:18.73,1:34:21.18,Lalai,,0,0,0,,Tidak kira apa yang berlaku,
Dialog: 0,1:34:25.40,1:34:27.30,Lalai,,0,0,0,,Saya boleh baiki keadaan...
Dialog: 0,1:34:27.32,1:34:29.69,Lalai,,0,0,0,,apabila ia rosak.
Dialog: 0,1:34:29.91,1:34:33.70,Lalai,,0,0,0,,Ia mungkin tidak selalu sempurna,
Dialog: 0,1:34:36.75,1:34:38.28,Lalai,,0,0,0,,tetapi saya boleh melakukannya.
Dialog: 0,1:34:39.92,1:34:41.69,Lalai,,0,0,0,,Jika anda tidak mengapa,
Dialog: 0,1:34:41.71,1:34:43.75,Lalai,,0,0,0,,maka awak akan kahwin dengan saya?
Dialog: 0,1:34:48.51,1:34:50.05,Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,1:34:53.81,1:34:55.68,Lalai,,0,0,0,,Tetapi...
Dialog: 0,1:34:56.06,1:34:57.97,Lalai,,0,0,0,,Saya memerlukan lebih banyak masa.
Dialog: 0,1:34:59.48,1:35:01.81,Lalai,,0,0,0,,Kami masih di peringkat permulaan,
Dialog: 0,1:35:04.36,1:35:07.02,Lalai,,0,0,0,,jadi tolong jangan tergesa-gesa.
Dialog: 0,1:35:09.03,1:35:10.68,Lalai,,0,0,0,,Betul.
Dialog: 0,1:35:10.70,1:35:11.68,Lalai,,0,0,0,,Okey.
Dialog: 0,1:35:11.70,1:35:13.40,Lalai,,0,0,0,,Anda hanya boleh memeluk saya...
Dialog: 0,1:35:13.62,1:35:16.97,Lalai,,0,0,0,,selepas kita berpegangan tangan sekurang-kurangnya lima kali.
Dialog: 0,1:35:17.00,1:35:18.53,Lalai,,0,0,0,,Apa...?
Dialog: 0,1:35:19.33,1:35:20.91,Lalai,,0,0,0,,Lima kali?
Dialog: 0,1:35:29.76,1:35:33.13,Lalai,,0,0,0,,Saya ingin bersarapan\Bersama setiap pagi.
Dialog: 0,1:35:34.72,1:35:36.83,Lalai,,0,0,0,,Menyihatkan untuk bersarapan,
Dialog: 0,1:35:36.85,1:35:38.72,Lalai,,0,0,0,,jadi tidak mengapa.
Dialog: 0,1:35:39.44,1:35:40.66, Lalai,,0,0,0,,Dan berjalan-jalan setiap hari?
Dialog: 0,1:35:40.69,1:35:43.42,Lalai,,0,0,0,,Vitamin D adalah penting,
Dialog: 0,1:35:43.44,1:35:44.84,Lalai,,0,0,0,,jadi idea yang bagus juga.
Dialog: 0,1:35:44.86,1:35:47.81,Lalai,,0,0,0,,Bagaimana pula dengan pergi melancong setiap musim?
Dialog: 0,1:35:47.86,1:35:51.86,Lalai,,0,0,0,,Rehat yang baik akan membantu kita bekerja dengan lebih baik.
Dialog: 0,1:35:52.53,1:35:54.44,Lalai,,0,0,0,,Itu rancangan yang bagus.
Dialog: 0,1:35:57.71,1:36:00.27,Lalai,,0,0,0,,Kita mesti...
Dialog: 0,1:36:00.29,1:36:02.49,Lalai,,0,0,0,,- pada jari kaki kita.\N- Kenapa?
Dialog: 0,1:36:02.54,1:36:04.27,Lalai,,0,0,0,,Kerana kehidupan tidak pernah terungkap...
Dialog: 0,1:36:04.30,1:36:06.15, Lalai,,0,0,0,, mengikut cara yang anda mahukan.
Dialog: 0,1:36:06.17,1:36:08.67,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kebajikan Pembetulan yang\NMembawa kepada Masa Depan yang Lebih Cerah{\c}{\i0}
Dialog: 0,1:36:22.73,1:36:25.31,Lalai,,0,0,0,,Geon-u, kenapa kamu tidak pergi menemui ibu kamu?
Dialog: 0,1:36:31.70,1:36:34.47,Lalai,,0,0,0,,Geon-u, adakah anda tahu siapa saya?
Dialog: 0,1:36:34.49,1:36:36.69,Lalai,,0,0,0,,- Adakah anda ingat saya?\N- Ya.
Dialog: 0,1:36:38.37,1:36:39.93,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:36:39.96,1:36:42.68,Lalai,,0,0,0,,Maafkan saya. saya sayang awak.
Dialog: 0,1:36:42.71,1:36:45.58,Lalai,,0,0,0,,- Mak.\N- Maafkan saya, Geon-u.
Dialog: 0,1:36:45.88,1:36:47.27,Lalai,,0,0,0,,Geon-u boleh menunggang...
Dialog: 0,1:36:47.30,1:36:49.87,Lalai,,0,0,0,,sekarang basikal roda tiga, Sayang.
Dialog: 0,1:36:50.13,1:36:51.67,Lalai,,0,0,0,,Saya ajar dia.
Dialog: 0,1:36:53.84,1:36:55.63,Lalai,,0,0,0,,Biar saya tunjukkan.
Dialog: 0,1:37:05.31,1:37:06.89,Lalai,,0,0,0,,Syabas.
Dialog: 0,1:37:07.48,1:37:08.59,Lalai,,0,0,0,,Datang ke kafe.
Dialog: 0,1:37:08.61,1:37:10.38,Lalai,,0,0,0,,Saya akan berikan anda hadiah percuma.
Dialog: 0,1:37:10.40,1:37:12.40,Lalai,,0,0,0,,Bye.
Dialog: 0,1:37:13.91,1:37:15.69,Lalai,,0,0,0,,Geon-u.
Dialog: 0,1:37:16.16,1:37:17.86,Lalai,,0,0,0,,Adakah ia benar-benar musim bunga?
Dialog: 0,1:37:17.95,1:37:19.47,Lalai,,0,0,0,,Mengapa ia terasa lebih sejuk...
Dialog: 0,1:37:19.50,1:37:22.70,Lalai,,0,0,0,,- Apa yang perlu kita buat?\N- ...di luar sini?
Dialog: 0,1:37:28.96,1:37:30.71,Lalai,,0,0,0,,Nak ke mana?
Dialog: 0,1:37:32.17,1:37:35.54,Lalai,,0,0,0,,Ibu saya suruh saya jemput awak.\NKita pergi makan bersama.
Dialog: 0,1:37:37.76,1:37:39.30,Lalai,,0,0,0,,Saya juga?
Dialog: 0,1:37:40.06,1:37:42.37,Lalai,,0,0,0,,- Betul ke?\N- Cepat.
Dialog: 0,1:37:42.39,1:37:45.96,Lalai,,0,0,0,,Pn. Kim adalah yang terbaik.
Dialog: 0,1:37:45.98,1:37:49.31,Lalai,,0,0,0,,- Geon-u, awak dah besar sangat.\N- Dia kawan saya.
Dialog: 0,1:37:50.57,1:37:51.59,Lalai,,0,0,0,,Mari kita teruskan.
Dialog: 0,1:37:51.61,1:37:55.86,Lalai,,0,0,0,,- Jom!\N- {\i1}Kami memaafkan mereka yang pernah kami benci.{\i0}
Dialog: 0,1:38:09.34,1:38:12.44,Lalai,,0,0,0,,{\i1}Lihat, Encik Kim.{\i0}
Dialog: 0,1:38:12.46,1:38:14.73,Lalai,,0,0,0,,{\i1}Adakah anda tahu teori perkadaran?{\i0}
Dialog: 0,1:38:14.76,1:38:16.70,Lalai,,0,0,0,,- {\i1}Saat itu...\N- Ya, saya lakukan.{\i0}
Dialog: 0,1:38:16.72,1:38:18.53,Lalai,,0,0,0,,{\i1}Masa semakin pantas...{\i0}
Dialog: 0,1:38:18.55,1:38:20.45,Lalai,,0,0,0,,{\i1}apabila masa kesuntukan.{\i0}
Dialog: 0,1:38:20.47,1:38:23.58,Lalai,,0,0,0,,{\i1}Saya juga cepat menua.{\i0}
Dialog: 0,1:38:23.60,1:38:25.66,Lalai,,0,0,0,,{\i1}Pergelangan tangan saya sakit semalam.{\i0}
Dialog: 0,1:38:25.69,1:38:27.37,Lalai,,0,0,0,,{\i1}Hari ini, lutut saya retak.{\i0}
Dialog: 0,1:38:27.40,1:38:29.26,Lalai,,0,0,0,,{\i1}Anda harus mengambil omega-3...{\i0}
Dialog: 0,1:38:30.15,1:38:31.79,Lalai,,0,0,0,,Bukan sebab itu.
Dialog: 0,1:38:31.82,1:38:33.71,Lalai,,0,0,0,,Berapa lama anda akan menyeret ini?
Dialog: 0,1:38:33.74,1:38:36.60,Lalai,,0,0,0,,Saya tidak tahu anda akan mengambil masa sebanyak ini.
Dialog: 0,1:38:43.66,1:38:46.78,Lalai,,0,0,0,,Kita akan berciuman pertama\Npada masa saya sudah kecut!
Dialog: 0,1:39:43.18,1:39:46.16,Lalai,,0,0,0,,{\i1}Kami menyedari bahawa beberapa perkara\Ntidak akan berlaku, walaupun kami berusaha keras,{\i0}
Dialog: 0,1:39:46.18,1:39:49.08,Lalai,,0,0,0,,{\i1}tetapi walaupun begitu,{\i0}
Dialog: 0,1:39:49.10,1:39:51.58,Lalai,,0,0,0,,{\i1}kami mengetahui bahawa tidak mengapa.{\i0}
Dialog: 0,1:39:51.61,1:39:52.87,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Gim Tinju Ratu{\c}{\i0}
Dialog: 0,1:39:52.90,1:39:55.79,Default,,0,0,0,,Muhammad Ali pernah berkata begini.
Dialog: 0,1:39:55.82,1:40:00.17,Lalai,,0,0,0,,"Hidup setiap hari seperti hari terakhir anda."
Dialog: 0,1:40:00.20,1:40:03.64, Lalai,,0,0,0, "Kemudian anda akan temui jawapannya suatu hari nanti."
Dialog: 0,1:40:03.66,1:40:06.26,Lalai,,0,0,0,,Jadi anda harus hidup setiap hari...
Dialog: 0,1:40:06.29,1:40:07.60,Lalai,,0,0,0,,Tahan. Saya mendapat panggilan.
Dialog: 0,1:40:07.62,1:40:08.81,Lalai,,0,0,0,,Teruskan.
Dialog: 0,1:40:08.83,1:40:10.70,Lalai,,0,0,0,,Berjaga-jaga.
Dialog: 0,1:40:11.38,1:40:12.35,Lalai,,0,0,0,,Hai, Mak.
Dialog: 0,1:40:12.38,1:40:14.98,Lalai,,0,0,0,,Jangan jadi tuan tanah yang teruk.
Dialog: 0,1:40:15.00,1:40:17.04,Lalai,,0,0,0,,Wah.
Dialog: 0,1:40:17.67,1:40:19.67,Lalai,,0,0,0,,Saya rindu Hae-in.
Dialog: 0,1:40:19.80,1:40:22.61,Lalai,,0,0,0,,Dia adalah tuan rumah yang tidak\Tidak tahu dia memiliki tempat ini.
Dialog: 0,1:40:22.64,1:40:25.76,Lalai,,0,0,0,,{\i1}Kami hidup setiap hari dengan sepenuhnya.{\i0}
Dialog: 0,1:40:31.31,1:40:32.97,Lalai,,0,0,0,,Hei.
Dialog: 0,1:40:34.06,1:40:36.92,Lalai,,0,0,0,,Saya tidak percaya anda membenarkan\Nadik anda menjadi Pengerusi,
Dialog: 0,1:40:36.94,1:40:40.09,Lalai,,0,0,0,,dan memilih untuk mempunyai {\i1}ramyun{\i0} di sini.
Dialog: 0,1:40:40.11,1:40:41.38,Lalai,,0,0,0,,Saya sukakannya.
Dialog: 0,1:40:41.41,1:40:43.55,Lalai,,0,0,0,,Inilah tempat saya.
Dialog: 0,1:40:43.57,1:40:49.82,Lalai,,0,0,0,,Saya akhirnya boleh mengucapkan selamat tinggal kepada orang lain\Tanpa berfikir untuk mengkhianati mereka.
Dialog: 0,1:40:50.25,1:40:53.53,Lalai,,0,0,0,,Ini adalah syurga bagi saya!
Dialog: 0,1:40:53.83,1:40:58.96,Lalai,,0,0,0,,Syurga apakah yang tidak mempunyai kimchi?\N{\i1}Ramyun{\i0} dan kimchi berjalan seiring.
Dialog: 0,1:41:02.63,1:41:04.61,Lalai,,0,0,0,,- Adakah ia berfungsi?\N- Ya, betul.
Dialog: 0,1:41:04.64,1:41:07.28,Lalai,,0,0,0,,Aduh. Kami mencari anda di mana-mana.
Dialog: 0,1:41:07.31,1:41:08.99,Lalai,,0,0,0,,Kami membawa beberapa kimchi.
Dialog: 0,1:41:09.02,1:41:11.20,Lalai,,0,0,0,, {\i1}ramyun{\i0} juga sudah sedia!
Dialog: 0,1:41:11.23,1:41:13.26,Lalai,,0,0,0,,- Bagus.\N- Ayuh.
Dialog: 0,1:41:13.90,1:41:17.13,Lalai,,0,0,0,,- Kebaikan. Tunggu.\N- Hello.
Dialog: 0,1:41:17.15,1:41:19.71,Lalai,,0,0,0,,- Helo.\N- Jangan beri salam kepadanya sekarang.
Dialog: 0,1:41:19.74,1:41:21.09,Lalai,,0,0,0,,Bagaimanakah saya hendak menghentikan ini?
Dialog: 0,1:41:21.11,1:41:22.30,Lalai,,0,0,0,,- Brek!\N- Apa?
Dialog: 0,1:41:22.32,1:41:23.92,Lalai,,0,0,0,,Brek! Injak brek!
Dialog: 0,1:41:23.95,1:41:25.82,Lalai,,0,0,0,,- Bukan kayu gear!\N- Awak nak ke mana?
Dialog: 0,1:41:25.84,1:41:26.97,Lalai,,0,0,0,,Du-gwan, di sini!
Dialog: 0,1:41:26.99,1:41:28.22,Lalai,,0,0,0,,{\i1}Kita kadang-kadang boleh berhenti...{\i0}
Dialog: 0,1:41:28.24,1:41:30.86,Lalai,,0,0,0,,{\i1}dan hargai pemandangan.{\i0}
Dialog: 0,1:41:33.83,1:41:37.33,Lalai,,0,0,0,,{\i1}Kemudian masa akan beransur-ansur\Nmula mengalir dengan lebih cepat.{\i0}
Dialog: 0,1:41:42.84,1:41:44.44,Lalai,,0,0,0,,{\i1}Masa akan berlalu pergi,{\i0}
Dialog: 0,1:41:44.47,1:41:47.25,Lalai,,0,0,0,,{\i1}dan kami tidak akan dapat berbuat apa-apa mengenainya.{\i0}
Dialog: 0,1:41:58.90,1:42:01.14,Lalai,,0,0,0,,{\i1}Begitulah kami akan berbelanja...{\i0}
Dialog: 0,1:42:01.57,1:42:03.60,Lalai,,0,0,0,,{\i1}setiap hari dalam hidup kita.{\i0}
Dialog: 0,1:42:16.54,1:42:20.70,Lalai,,0,0,0,,{\i1}Kami akan menikmati semua\Nkebahagiaan yang diberikan oleh kehidupan kepada kami.{\i0}
Dialog: 0,1:43:50.01,1:43:53.57,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Hong Hae-in\N22 Ogos 1990, 7 April 2074{\c}{\i0}
Dialog: 0,1:43:53.60,1:43:57.31,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Menghabiskan hidup saya dengan awak adalah satu keajaiban{\c}{\i0}
Dialog: 0,1:44:40.94,1:44:42.64,Lalai,,0,0,0,,{\i1}Suatu hari...{\i0}
Dialog: 0,1:44:44.06,1:44:46.77,Lalai,,0,0,0,,{\i1}apabila hanya seorang daripada kita yang tinggal...{\i0}
Dialog: 0,1:45:19.27,1:45:23.22,Lalai,,0,0,0,,{\i1}Yang lain boleh datang menemui mereka.{\i0}
Dialog: 0,1:45:30.44,1:45:33.06,Lalai,,0,0,0,,{\i1}Maka ia tidak akan menakutkan sama sekali,{\i0}
Dialog: 0,1:45:37.16,1:45:40.11,Lalai,,0,0,0,,- {\i1}kerana kita akan bersama.\N- ...kerana kita akan bersama.{\i0}
