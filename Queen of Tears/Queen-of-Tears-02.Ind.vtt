Dialog: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skenario: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sutradara: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialogue: 0,0:01:02.93,0:01:04.62,Default,,0,0,0,,{\an8}Baiklah, saya...
Dialogue: 0,0:01:04.64,0:01:07.41,Default,,0,0,0,,{\an8}Jadi apa...?
Dialog: 0,0:01:07.44,0:01:08.66,Default,,0,0,0,,{\an8}Ya?
Dialogue: 0,0:01:08.69,0:01:11.52,Default,,0,0,0,,{\an8}...Saya ingin mengatakan adalah...
Dialog: 0,0:01:13.07,0:01:14.77,Default,,0,0,0,,{\an8}Saya...
Dialog: 0,0:01:15.70,0:01:18.44,Default,,0,0,0,,{\an8}- Ya?\N- "Maaf."
Dialog: 0,0:01:20.74,0:01:23.61,Default,,0,0,0,,{\an8}"Tentang hari ini,"
Dialog: 0,0:01:23.79,0:01:27.35,Default,,0,0,0,,{\an8}"dan semua yang telah saya lakukan sejauh ini."
Dialogue: 0,0:01:27.37,0:01:31.40,Default,,0,0,0,,{\an8}"Ini tidak akan terjadi lagi.\NI akan memperlakukan Anda lebih baik."
Dialogue: 0,0:01:31.42,0:01:34.91,Default,,0,0,0,,{\an8}Itulah yang kuinginkan...
Dialog: 0,0:01:35.67,0:01:36.86,Default,,0,0,0,,{\an8}untuk mengatakan,
Dialogue: 0,0:01:36.88,0:01:39.15,Default,,0,0,0,,{\an8}tapi umurmu hanya tinggal tiga bulan lagi?
Dialog: 0,0:01:39.18,0:01:40.86,Default,,0,0,0,,Bagaimana mungkin?
Dialogue: 0,0:01:40.89,0:01:44.05,Default,,0,0,0,,Bagaimana aku bisa hidup tanpamu?
Dialog: 0,0:01:45.14,0:01:46.88,Default,,0,0,0,,Bagaimana mungkin?
Dialog: 0,0:01:46.98,0:01:49.62,Default,,0,0,0,,Aku sangat tercengang,
Dialog: 0,0:01:49.65,0:01:51.89,Default,,0,0,0,,Saya tidak tahu harus berkata apa.
Dialog: 0,0:01:56.44,0:01:57.67,Default,,0,0,0,,Apakah kamu serius?
Dialog: 0,0:01:57.70,0:02:00.52,Default,,0,0,0,,Ya, bodoh.
Dialog: 0,0:02:09.46,0:02:11.66,Default,,0,0,0,,Aku cinta kamu, Hong Hae-in.
Dialog: 0,0:02:13.75,0:02:15.58,Default,,0,0,0,,Aku cinta kamu.
Dialog: 0,0:02:15.96,0:02:18.87,Default,,0,0,0,,Jika kamu tidak bisa hidup tanpaku...
Dialog: 0,0:02:19.22,0:02:20.92,Default,,0,0,0,,Ya?
Dialogue: 0,0:02:21.97,0:02:23.57,Default,,0,0,0,,Mau mati bersama?
Dialogue: 0,0:02:29.06,0:02:31.35,Default,,0,0,0,,Kamu bilang kamu tidak bisa hidup tanpaku.
Dialogue: 0,0:02:31.86,0:02:36.85,Default,,0,0,0,,Aku tidak bermaksud yakin\NI tidak bisa hidup tanpamu.
Dialog: 0,0:02:36.90,0:02:39.44,Default,,0,0,0,,Saya hanya ingin tahu...
Dialogue: 0,0:02:40.45,0:02:42.93,Default,,0,0,0,,jika hal itu bisa dilakukan. Saya penasaran.
Dialog: 0,0:02:42.95,0:02:46.36,Default,,0,0,0,,Tepat. Kalau begitu kita harus mati bersama saja.
Dialogue: 0,0:02:46.58,0:02:51.27,Default,,0,0,0,,Itu adalah hal resmi pada\Nmasa lalu. Itu disebut "sunjang."
Dialogue: 0,0:02:51.29,0:02:53.41,Default,,0,0,0,,Mereka menguburkanmu bersama pasanganmu.
Dialog: 0,0:02:53.71,0:02:55.35,Default,,0,0,0,,Benar.
Dialog: 0,0:02:55.38,0:02:57.31,Default,,0,0,0,,{\i1}Sunjang.{\i0}
Dialog: 0,0:02:57.34,0:03:00.29,Default,,0,0,0,,Ya, {\i1}sunjang.{\i0}
Dialog: 0,0:03:00.93,0:03:04.49,Default,,0,0,0,,Kamu bisa memperlakukanku lebih baik di akhirat.
Dialogue: 0,0:03:04.51,0:03:06.05,Default,,0,0,0,,Lumayan.
Dialogue: 0,0:03:08.68,0:03:12.00,Default,,0,0,0,,Kamu selalu baik\Nat membuat lelucon yang menakutkan...
Dialog: 0,0:03:12.02,0:03:13.97,Default,,0,0,0,,dengan wajah datar.
Dialog: 0,0:03:14.31,0:03:16.02,Default,,0,0,0,,Menurutmu aku bercanda?
Dialog: 0,0:03:18.44,0:03:19.50,Default,,0,0,0,,Kamu serius?
Dialogue: 0,0:03:19.53,0:03:21.73,Default,,0,0,0,,Saya bilang jangan terlalu dramatis.
Dialog: 0,0:03:26.28,0:03:28.11,Default,,0,0,0,,Katakan padaku.
Dialog: 0,0:03:30.79,0:03:32.99,Default,,0,0,0,,Apa sebenarnya yang dikatakan dokter?
Dialogue: 0,0:03:33.25,0:03:35.64,Default,,0,0,0,,Di mana yang sakit?
Dialogue: 0,0:03:35.67,0:03:38.70,Default,,0,0,0,,Apakah dokter benar\Nmengatakan hanya butuh tiga...?
Dialogue: 0,0:03:40.34,0:03:42.96,Default,,0,0,0,,Bahwa hidupmu hanya tinggal tiga bulan?
Dialog: 0,0:03:47.14,0:03:48.84,Default,,0,0,0,,Halo, Profesor.
Dialog: 0,0:03:49.18,0:03:50.88,Default,,0,0,0,,Hasil tesnya?
Dialogue: 0,0:03:52.48,0:03:56.51,Default,,0,0,0,,Bisakah Anda mengirimkannya lewat email ke saya?\NI tidak punya waktu ke sana.
Dialog: 0,0:04:16.71,0:04:18.83,Default,,0,0,0,,Kita harus pergi ke suatu tempat.
Dialog: 0,0:04:20.09,0:04:21.73,Default,,0,0,0,,Kamu ada waktu luang hari ini, bukan?
Dialog: 0,0:04:21.76,0:04:23.83,Default,,0,0,0,,Mobil menunggu di bawah.
Dialog: 0,0:04:27.18,0:04:29.05,Default,,0,0,0,,Saya tidak akan pergi.
Dialog: 0,0:04:31.14,0:04:33.88,Default,,0,0,0,,- Aku bahkan tidak memberitahumu kemana kita akan pergi.\N- Tidak masalah.
Dialog: 0,0:04:33.90,0:04:36.61,Default,,0,0,0,,Aku menolak pergi kemana pun bersamamu.
Dialog: 0,0:04:38.27,0:04:40.77,Default,,0,0,0,,Mau kemana sekarang?
Dialog: 0,0:04:41.48,0:04:44.65,Default,,0,0,0,,Saya tidak tahu. Saya tidak tahu ke mana tujuan saya.
Dialog: 0,0:04:54.75,0:04:56.87,Default,,0,0,0,,{\i1}{\c&HFFFF&}Pusat Medis Universitas Sungmin{\c}{\i0}
Dialog: 0,0:05:18.90,0:05:21.46,Default,,0,0,0,,{\i1}Tidak seperti tumor normal,{\i0}
Dialog: 0,0:05:21.48,0:05:25.35,Default,,0,0,0,,{\i1}tumor mirip bulu halus ini tersebar.{\i0}
Dialog: 0,0:05:31.83,0:05:33.36,Default,,0,0,0,,Tunggu.
Dialog: 0,0:05:33.79,0:05:36.27,Default,,0,0,0,,Kapan aku sampai di sini?
Dialog: 0,0:05:36.29,0:05:38.37,Default,,0,0,0,,Maaf?
Dialog: 0,0:05:39.67,0:05:42.15,Default,,0,0,0,,Saya ingat berada di lobi,
Dialog: 0,0:05:42.17,0:05:44.08,Default,,0,0,0,,jadi bagaimana aku sudah ada di sini?
Dialogue: 0,0:05:44.30,0:05:46.23,Default,,0,0,0,,Ini seperti aku berteleportasi.
Dialog: 0,0:05:46.26,0:05:48.54,Default,,0,0,0,,Apakah ini pernah terjadi sebelumnya?
Dialog: 0,0:05:48.84,0:05:50.95,Default,,0,0,0,,Sudah kubilang terakhir kali.
Dialogue: 0,0:05:50.97,0:05:56.04,Default,,0,0,0,,Kadang-kadang saya sakit kepala dan\Nsering pelupa, dan kadang-kadang...
Dialogue: 0,0:05:56.06,0:05:58.75,Default,,0,0,0,,VIP kami menyukai kelas seni\Nyang kami selenggarakan pada setengah tahun pertama.
Dialog: 0,0:05:58.77,0:05:59.99,Default,,0,0,0,,Kami mengundang artis terkenal...
Dialog: 0,0:06:00.01,0:06:01.54,Default,,0,0,0,,Restea akan bergabung dengan kita.
Dialogue: 0,0:06:01.56,0:06:03.68,Default,,0,0,0,,Saat ini, kualitas tidur...
Dialog: 0,0:06:06.86,0:06:09.38,Default,,0,0,0,,{\i1}Sepuluh menit? Setengah jam?{\i0}
Dialogue: 0,0:06:09.41,0:06:14.36,Default,,0,0,0,,{\i1}Terkadang aku tidak ingat apa\NI yang lakukan selama beberapa jam terakhir.{\i0}
Dialog: 0,0:06:35.14,0:06:36.67,Default,,0,0,0,,Ms. Hong.
Dialog: 0,0:06:37.14,0:06:40.75,Default,,0,0,0,,{\an8}Saya kira Anda membatalkan rencana\Nuntuk bertemu dengan Direktur Baek Hyun-woo.
Dialog: 0,0:06:40.77,0:06:42.64,Default,,0,0,0,,Kenapa kamu masih di sini?
Dialogue: 0,0:06:43.65,0:06:46.31,Default,,0,0,0,,{\i1}Aku bahkan melewatkan janji penting.{\i0}
Dialogue: 0,0:07:14.30,0:07:16.67,Default,,0,0,0,,Kenapa kamu tidak mengunjungiku lebih awal?
Dialogue: 0,0:07:16.76,0:07:19.37,Default,,0,0,0,,Aku hanya berpikir aku tertidur atau keluar zona...
Dialog: 0,0:07:19.39,0:07:20.70,Default,,0,0,0,,karena kelelahan.
Dialog: 0,0:07:20.73,0:07:24.51,Default,,0,0,0,,Saya tidak merasakan sakit fisik apa pun,
Dialog: 0,0:07:24.61,0:07:26.31,Default,,0,0,0,,jadi...
Dialog: 0,0:07:27.82,0:07:29.34,Default,,0,0,0,,apa ada yang salah dengan diriku?
Dialog: 0,0:07:29.36,0:07:31.92,Default,,0,0,0,,Anda menderita Cloud Cytoma. Ini adalah penyakit yang sangat langka.
Dialogue: 0,0:07:31.95,0:07:34.09,Default,,0,0,0,,Tidak banyak kasus di seluruh dunia.
Dialogue: 0,0:07:34.12,0:07:38.07,Default,,0,0,0,,Dapat dikatakan bahwa Anda\No pasien Korea pertama kami.
Dialog: 0,0:07:40.87,0:07:43.91,Default,,0,0,0,,- Apakah saya perlu dioperasi?\N- Tidak.
Dialog: 0,0:07:45.13,0:07:49.19,Default,,0,0,0,,Saya mengerti. Hal ini dapat diobati dengan obat-obatan.
Dialogue: 0,0:07:49.21,0:07:51.90,Default,,0,0,0,,Kasusmu sedikit lebih rumit,
Dialog: 0,0:07:51.92,0:07:54.11,Default,,0,0,0,,karena berbeda dengan tumor biasa.
Dialogue: 0,0:07:54.14,0:07:57.07,Default,,0,0,0,,Itu bukan benjolan tumor yang jelas.
Dialog: 0,0:07:57.10,0:08:02.34,Default,,0,0,0,,Sel tumor tersebar\Nkeseluruh saraf kranialmu.
Dialogue: 0,0:08:03.23,0:08:05.04,Default,,0,0,0,,Mereka tersebar di area yang luas.
Dialogue: 0,0:08:05.06,0:08:08.00,Default,,0,0,0,,Ini yang paling terkonsentrasi\Ndekat lobus temporal Anda.
Dialogue: 0,0:08:08.02,0:08:12.19,Default,,0,0,0,,Saya yakin inilah penyebab\Nhilangnya memori sementara Anda.
Dialogue: 0,0:08:12.36,0:08:13.63,Default,,0,0,0,,Ini penyakit langka.
Dialog: 0,0:08:13.65,0:08:17.57,Default,,0,0,0,,Gejalanya tidak spesifik\Ndan berbeda dari kasus ke kasus.
Dialogue: 0,0:08:17.70,0:08:21.89,Default,,0,0,0,,Jika memburuk, Anda bisa menderita\Nhalusinasi atau gangguan kepribadian.
Dialogue: 0,0:08:21.91,0:08:25.77,Default,,0,0,0,,Masalahnya adalah, meminum\Nobat tidak akan banyak membantu,
Dialog: 0,0:08:25.79,0:08:28.06,Default,,0,0,0,,{\i1}dan terlalu berbahaya untuk menjalani operasi,{\i0}
Dialog: 0,0:08:28.09,0:08:32.41,Default,,0,0,0,,{\i1}karena sel tumor sudah menyebar terlalu banyak.{\i0}
Dialog: 0,0:08:33.55,0:08:35.25,Default,,0,0,0,,{\i1}Ms. Hong?{\i0}
Dialog: 0,0:08:38.30,0:08:39.84,Default,,0,0,0,,{\i1}Ms. Hong?{\i0}
Dialog: 0,0:08:42.64,0:08:44.55,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:08:54.03,0:08:55.92,Default,,0,0,0,,- Oke.\N- Maaf?
Dialog: 0,0:08:55.95,0:08:59.23,Default,,0,0,0,,Jadi itulah yang terjadi pada orang biasa.
Dialog: 0,0:08:59.37,0:09:00.72,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:09:00.74,0:09:03.43,Default,,0,0,0,,Sekarang beri tahu saya perawatan apa yang bisa saya dapatkan.
Dialog: 0,0:09:03.45,0:09:05.97,Default,,0,0,0,,Saya ingin tahu tentang kasus saya, bukan kasus mereka.
Dialog: 0,0:09:06.00,0:09:08.56,Default,,0,0,0,,Saya dengar Anda menggalang dana\Nuntuk rumah sakit anak baru.
Dialog: 0,0:09:08.59,0:09:10.69,Default,,0,0,0,,Saya bisa mengurusnya,
Dialogue: 0,0:09:10.71,0:09:12.75,Default,,0,0,0,,jadi beritahu aku...
Dialogue: 0,0:09:13.26,0:09:14.90,Default,,0,0,0,,bagaimana cara menghilangkannya.
Dialog: 0,0:09:14.92,0:09:16.28,Default,,0,0,0,,Sepengetahuan saya,
Dialogue: 0,0:09:16.30,0:09:19.84,Default,,0,0,0,,saat ini belum ada solusi medis untuk hal ini.
Dialog: 0,0:09:20.05,0:09:22.70,Default,,0,0,0,,Yang terbaik yang bisa kami lakukan adalah memberimu obat...
Dialog: 0,0:09:22.72,0:09:25.70,Default,,0,0,0,,untuk meringankan sakit kepalamu\Ndan kehilangan memori sementara.
Dialog: 0,0:09:25.73,0:09:29.22,Default,,0,0,0,,Namun, tidak mungkin\Nmenyembuhkan penyakit itu sendiri untuk saat ini...
Dialogue: 0,0:09:29.81,0:09:31.89,Default,,0,0,0,,Kamu menyindir...
Dialog: 0,0:09:32.36,0:09:35.69,Default,,0,0,0,,bahwa aku akan segera mati.
Dialog: 0,0:09:35.99,0:09:37.92,Default,,0,0,0,,Baik. Beri tahu saya.
Dialog: 0,0:09:37.95,0:09:40.26,Default,,0,0,0,,Kapan aku akan mati?
Dialogue: 0,0:09:40.28,0:09:43.15,Default,,0,0,0,,Dilihat dari penyebaran sel tumornya,
Dialog: 0,0:09:43.83,0:09:47.11,Default,,0,0,0,,Saya yakin waktu Anda sekitar tiga bulan.
Dialogue: 0,0:09:53.13,0:09:54.77,Default,,0,0,0,,Apa yang dia tahu?
Dialog: 0,0:09:54.80,0:09:57.29,Default,,0,0,0,,Dia paling tahu sebagai dokter.
Dialog: 0,0:09:58.97,0:10:00.79,Default,,0,0,0,,Saya tahu tubuh saya sendiri.
Dialogue: 0,0:10:01.60,0:10:03.78,Default,,0,0,0,,Kamu berbicara seperti wanita tua yang keras kepala.
Dialogue: 0,0:10:03.81,0:10:06.87,Default,,0,0,0,,Pernahkah kamu melihatku makan makanan instan atau junk food?
Dialog: 0,0:10:06.89,0:10:08.16,Default,,0,0,0,,- Tidak.\N- Tepat.
Dialogue: 0,0:10:08.19,0:10:09.93,Default,,0,0,0,,Aku belum pernah minum soda seumur hidupku.
Dialogue: 0,0:10:09.95,0:10:14.04,Default,,0,0,0,,Apakah menurut Anda saya menikmati minum\Njus sayur dan memperhatikan apa yang saya makan?
Dialogue: 0,0:10:14.07,0:10:17.81,Default,,0,0,0,,Saya bermeditasi di pagi hari dan\N melakukan yoga di malam hari untuk mengatasi stres saya.
Dialog: 0,0:10:17.95,0:10:20.55,Default,,0,0,0,,Saya memperhatikan pernapasan saya jika\Ntidak ada konsentrator oksigen.
Dialogue: 0,0:10:20.57,0:10:24.51,Default,,0,0,0,,Saya sudah berusaha untuk tetap sehat\Nsejak saya lahir.
Dialog: 0,0:10:24.54,0:10:26.07,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:10:27.71,0:10:29.41,Default,,0,0,0,,Tenang.
Dialog: 0,0:10:30.63,0:10:33.69,Default,,0,0,0,,Bahkan orang yang membahayakan\Ntubuhnya dengan minum, merokok,
Dialog: 0,0:10:33.71,0:10:36.44,Default,,0,0,0,,makan apa pun yang mereka mau,\Ndan tidak memedulikan pernapasan mereka,
Dialog: 0,0:10:36.46,0:10:38.83,Default,,0,0,0,,tidak terkena penyakit ini,
Dialogue: 0,0:10:38.88,0:10:40.42,Default,,0,0,0,,lalu kenapa aku?
Dialog: 0,0:10:40.72,0:10:42.59,Default,,0,0,0,,Saya juga tidak tahu.
Dialog: 0,0:10:42.93,0:10:44.28,Default,,0,0,0,,Baik.
Dialogue: 0,0:10:44.31,0:10:47.55,Default,,0,0,0,,Aku sakit, tapi kenapa mereka tidak bisa menyembuhkanku?
Dialogue: 0,0:10:47.60,0:10:49.91,Default,,0,0,0,,Orang bepergian ke bulan,\Ndan mobil menyetir sendiri,
Dialogue: 0,0:10:49.93,0:10:53.59,Default,,0,0,0,,tapi mereka tidak bisa menghilangkan tumor kecil di kepalaku?
Dialogue: 0,0:10:54.27,0:10:56.18,Default,,0,0,0,,Itu menggelikan.
Dialog: 0,0:10:58.57,0:11:00.65,Default,,0,0,0,,Bagaimana kalau...
Dialog: 0,0:11:01.03,0:11:05.82,Default,,0,0,0,,besok kita ke rumah sakit dan periksa lagi?
Dialogue: 0,0:11:06.08,0:11:07.55,Default,,0,0,0,,Untuk apa?
Dialogue: 0,0:11:07.58,0:11:10.78,Default,,0,0,0,,Kita harus yakin. Apa yang harus\NI lakukan jika salah diagnosis?
Dialogue: 0,0:11:14.04,0:11:17.12,Default,,0,0,0,,Apa yang kamu lakukan jika salah diagnosis?
Dialog: 0,0:11:18.05,0:11:20.21,Default,,0,0,0,,Saya akan sangat gembira...
Dialog: 0,0:11:22.80,0:11:27.17,Default,,0,0,0,,Jadi ayo pergi dan konfirmasi ulang semuanya.
Dialogue: 0,0:11:27.56,0:11:30.01,Default,,0,0,0,,Kamu sedang gelisah saat ini.
Dialog: 0,0:11:30.73,0:11:34.30,Default,,0,0,0,,Lupakan semuanya dan istirahatlah...
Dialogue: 0,0:11:34.65,0:11:36.77,Default,,0,0,0,,Apa menurutmu aku bisa tidur?
Dialog: 0,0:11:36.98,0:11:38.68,Default,,0,0,0,,Benar.
Dialogue: 0,0:11:40.32,0:11:42.60,Default,,0,0,0,,Aku juga kaget.
Dialog: 0,0:11:43.11,0:11:45.73,Default,,0,0,0,,Saya tidak tahu apakah saya bisa tidur malam ini.
Dialogue: 0,0:12:28.66,0:12:31.19,Default,,0,0,0,,Rasanya berbeda...
Dialog: 0,0:12:32.66,0:12:34.91,Default,,0,0,0,,dibandingkan kemarin.
Dialog: 0,0:12:46.34,0:12:49.55,Default,,0,0,0,,Bersenandung? Benar-benar? Apakah Anda\Ningin dikuburkan bersamanya?
Dialogue: 0,0:12:50.01,0:12:51.72,Default,,0,0,0,,Aku sedih.
Dialogue: 0,0:12:54.31,0:12:55.50,Default,,0,0,0,,Kita akan berpisah.
Dialogue: 0,0:12:55.52,0:13:00.64,Default,,0,0,0,,Kita akan berpisah dalam tiga\Nbulan bahkan tanpa perceraian.
Dialog: 0,0:13:04.90,0:13:06.61,Default,,0,0,0,,Tidak.
Dialog: 0,0:13:08.45,0:13:10.57,Default,,0,0,0,,Jangan tersenyum.
Dialog: 0,0:13:12.70,0:13:14.45,Default,,0,0,0,,Turun.
Dialog: 0,0:13:21.13,0:13:22.83,Default,,0,0,0,,Hae-in?
Dialog: 0,0:13:26.30,0:13:29.67,Default,,0,0,0,,Tunggu. Dia tidak pernah tidur.
Dialog: 0,0:13:31.31,0:13:32.88,Default,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:13:42.36,0:13:43.89,Default,,0,0,0,,Hei.
Dialog: 0,0:13:47.57,0:13:50.02,Default,,0,0,0,,Sudah lewat jam 7 pagi.
Dialog: 0,0:14:45.88,0:14:47.91,Default,,0,0,0,,Apa?
Dialog: 0,0:14:48.09,0:14:49.87,Default,,0,0,0,,Apa itu?
Dialog: 0,0:15:07.82,0:15:11.61,Default,,0,0,0,,Kamu pasti sedang dalam mood yang baik untuk mengatakan itu.
Dialogue: 0,0:15:13.32,0:15:15.32,Default,,0,0,0,,Bahkan kulitmu terlihat lebih baik.
Dialogue: 0,0:15:16.04,0:15:17.30,Default,,0,0,0,,Kamu pasti tidur nyenyak.
Dialogue: 0,0:15:17.33,0:15:20.11,Default,,0,0,0,,Aku bolak-balik sepanjang malam.
Dialog: 0,0:15:23.92,0:15:25.45,Default,,0,0,0,,Saya?
Dialogue: 0,0:15:26.34,0:15:28.25,Default,,0,0,0,,Kulitku?
Dialog: 0,0:15:28.63,0:15:30.23,Default,,0,0,0,,Kamu salah.
Dialog: 0,0:15:30.26,0:15:33.21,Default,,0,0,0,,Tidak, itu tidak mungkin.
Dialog: 0,0:16:01.91,0:16:04.23,Default,,0,0,0,,Izinkan saya memperingatkan Anda.
Dialog: 0,0:16:04.25,0:16:06.06,Default,,0,0,0,,Hanya kamu yang mengetahui hal ini,
Dialog: 0,0:16:06.09,0:16:08.62,Default,,0,0,0,,jadi kalau ada yang tahu, itu salahmu.
Dialog: 0,0:16:09.67,0:16:11.25,Default,,0,0,0,,Saya mengerti,
Dialogue: 0,0:16:11.38,0:16:13.90,Default,,0,0,0,,tapi maukah kamu merahasiakan ini selamanya?
Dialog: 0,0:16:13.93,0:16:15.59,Default,,0,0,0,,Ya.
Dialogue: 0,0:16:16.01,0:16:17.91,Default,,0,0,0,,Apa keluargamu tidak tahu?
Dialog: 0,0:16:17.93,0:16:20.37,Default,,0,0,0,,Tentu saja tidak. Mereka seharusnya\Nmenjadi orang terakhir yang mengetahuinya.
Dialog: 0,0:16:20.39,0:16:22.08,Default,,0,0,0,,Tapi menurutku...
Dialogue: 0,0:16:22.10,0:16:26.29,Default,,0,0,0,,Saya hampir bergabung dengan Klub Satu Miliar.
Dialog: 0,0:16:26.31,0:16:29.42,Default,,0,0,0,,Kamu tahu apa yang Kakek katakan\Nsaat dia memberiku department store.
Dialog: 0,0:16:29.44,0:16:31.75,Default,,0,0,0,,"Aku akan memilihmu daripada ayahmu..."
Dialogue: 0,0:16:31.78,0:16:35.11,Default,,0,0,0,,"jika penjualan Anda lebih dari $1 miliar."
Dialogue: 0,0:16:37.12,0:16:40.65,Default,,0,0,0,,Kau ingin aku merusaknya, saat aku sedekat ini?
Dialogue: 0,0:16:41.37,0:16:43.10,Default,,0,0,0,,Itu sebabnya kamu tidak mau memberi tahu mereka?
Dialog: 0,0:16:43.12,0:16:45.68,Default,,0,0,0,,Hong Soo-cheol adalah\Ntipe yang memanggil dokterku...
Dialog: 0,0:16:45.71,0:16:48.60,Default,,0,0,0,,untuk memastikan apakah saya benar-benar terkena flu.
Dialogue: 0,0:16:48.63,0:16:51.83,Default,,0,0,0,,Apakah menurutmu ibuku akan berbeda?
Dialog: 0,0:16:52.01,0:16:54.53,Default,,0,0,0,,Jika mereka mengetahui penyakitku,
Dialogue: 0,0:16:54.55,0:16:57.03,Default,,0,0,0,,Aku akan diusir dari rumah.
Dialogue: 0,0:16:57.05,0:17:01.17,Default,,0,0,0,,Mereka berebut siapa yang akan mendapatkan asetku.
Dialog: 0,0:17:05.56,0:17:07.66,Default,,0,0,0,,Saya tidak akan mengizinkannya.
Dialogue: 0,0:17:07.69,0:17:09.72,Default,,0,0,0,,Di atas mayatku.
Dialogue: 0,0:17:25.62,0:17:29.39,Default,,0,0,0,,Menurutmu kenapa Kakek ingin\N menemuiku sebelum sarapan?
Dialogue: 0,0:17:29.42,0:17:31.90,Default,,0,0,0,,Apakah dia ingin memberiku\Nearful dan menyelesaikannya dengan...
Dialog: 0,0:17:31.92,0:17:32.98,Default,,0,0,0,,sebelum sarapan?
Dialogue: 0,0:17:33.01,0:17:35.21,Default,,0,0,0,,Tahu kenapa dia ingin bertemu denganmu?
Dialog: 0,0:17:36.09,0:17:37.24,Default,,0,0,0,,Mungkin ini tentang...
Dialogue: 0,0:17:37.26,0:17:39.86,Default,,0,0,0,,betapa aku ingin meluncurkan merek kopi\Norganic New York itu.
Dialogue: 0,0:17:39.89,0:17:42.82,Default,,0,0,0,,Yang kamu yakin akan meluncurkannya?
Dialog: 0,0:17:42.85,0:17:44.74,Default,,0,0,0,,Ya, tapi saya salah.
Dialogue: 0,0:17:44.77,0:17:49.72,Default,,0,0,0,,Para bajingan itu menyalahkanku,\Nand memutuskan untuk bekerja dengan Yeom Sang-jin.
Dialogue: 0,0:17:50.65,0:17:53.93,Default,,0,0,0,,Mengapa dunia ini penuh dengan bajingan tak bermoral?
Dialogue: 0,0:17:56.20,0:17:57.76,Default,,0,0,0,,Menurutmu Kakek tahu?
Dialogue: 0,0:17:57.78,0:17:59.84,Default,,0,0,0,,Bahkan aku baru mengetahuinya akhir-akhir ini.
Dialog: 0,0:17:59.87,0:18:02.22,Default,,0,0,0,,Risiko diperlukan untuk menjalankan bisnis.
Dialogue: 0,0:18:02.24,0:18:06.11,Default,,0,0,0,,Jangan takut. Hanya karena {\i1}keadaan\Nmajeure{\i0} kesepakatan itu gagal.
Dialogue: 0,0:18:06.16,0:18:09.06,Default,,0,0,0,,Ya, kamu benar. Itu hanya {\i1}kekuatan...{\i0}
Dialog: 0,0:18:09.08,0:18:13.19,Default,,0,0,0,,Kesepakatan hanya gagal karena {\i1}keadaan kahar,{\i0}
Dialog: 0,0:18:13.21,0:18:16.04,Default,,0,0,0,,tapi aku masih khawatir dia akan marah.
Dialogue: 0,0:18:17.26,0:18:20.17,Default,,0,0,0,,Dia kakekmu, bukan Setan.
Dialog: 0,0:18:20.55,0:18:22.71,Default,,0,0,0,,Percaya diri dan beritahu dia.
Dialog: 0,0:18:24.35,0:18:26.13,Default,,0,0,0,,- Harusnya, kan?\N- Ya.
Dialog: 0,0:18:30.60,0:18:32.89,Default,,0,0,0,,{\i1}Kenapa kamu begitu tidak kompeten?!{\i0}
Dialog: 0,0:18:33.48,0:18:35.89,Default,,0,0,0,,Kakek, kesepakatan ini hanya gagal...
Dialog: 0,0:18:36.03,0:18:38.00,Default,,0,0,0,,karena {\i1}keadaan kahar...{\i0}
Dialog: 0,0:18:38.03,0:18:40.61,Default,,0,0,0,,Apa? Kesepakatan gagal?
Dialogue: 0,0:18:41.28,0:18:44.01,Default,,0,0,0,,Kesepakatan apa yang kamu bicarakan?
Dialog: 0,0:18:44.03,0:18:46.01,Default,,0,0,0,,Peluncuran kopi organik New York.
Dialogue: 0,0:18:46.04,0:18:47.35,Default,,0,0,0,,Bukankah ini maksudnya?
Dialogue: 0,0:18:47.37,0:18:49.39,Default,,0,0,0,,Saya sedang membicarakan tentang bagaimana...
Dialog: 0,0:18:49.41,0:18:52.77,Default,,0,0,0,,Anda membayar lebih $8 juta...
Dialog: 0,0:18:52.79,0:18:54.91,Default,,0,0,0,,dalam pajak perusahaan!
Dialog: 0,0:18:55.13,0:18:56.65,Default,,0,0,0,,- Apa?\N- Tim hukum Hyun-woo...
Dialogue: 0,0:18:56.67,0:19:00.63,Default,,0,0,0,, mengetahuinya dan akan\Nmengajukan klaim perbaikan.
Dialogue: 0,0:19:00.97,0:19:04.96,Default,,0,0,0,,Uang itu akan habis\Nsia-sia kalau bukan karena dia!
Dialogue: 0,0:19:05.10,0:19:06.41,Default,,0,0,0,,Bukankah kakak iparmu...
Dialogue: 0,0:19:06.43,0:19:08.24,Default,,0,0,0,,direktur keuangan?
Dialog: 0,0:19:08.27,0:19:09.66,Default,,0,0,0,,- Pecat dia sekarang juga!\N- Tapi...
Dialog: 0,0:19:09.68,0:19:12.29,Default,,0,0,0,,Juga, kamu sangat percaya diri...
Dialog: 0,0:19:12.31,0:19:15.33,Default,,0,0,0,,tentang kesepakatan kopi itu. Apakah\Nitu sia-sia juga?
Dialog: 0,0:19:15.36,0:19:17.35,Default,,0,0,0,,- Tidak...\N- Jawab aku!
Dialog: 0,0:19:17.57,0:19:21.59,Default,,0,0,0,,Kenapa kamu tidak bisa melakukan apa pun dengan benar?
Dialog: 0,0:19:21.61,0:19:24.69,Default,,0,0,0,,Apakah kamu belum belajar apa pun dari Hae-in?
Dialog: 0,0:19:24.78,0:19:26.43,Default,,0,0,0,,- Bukan?\N- Anda lihat...
Dialog: 0,0:19:26.45,0:19:28.39,Default,,0,0,0,,Katakan sesuatu, bajingan!
Dialog: 0,0:19:28.41,0:19:29.47,Default,,0,0,0,,Bicaralah, bajingan!
Dialogue: 0,0:19:29.50,0:19:31.22,Default,,0,0,0,,Manfaatkan mulutmu itu!
Dialogue: 0,0:19:31.25,0:19:32.93,Default,,0,0,0,,- I...\N- Jawab aku, idiot!
Dialog: 0,0:19:32.96,0:19:35.19,Default,,0,0,0,,Saya ingin membalas, tetapi saya tidak bisa...
Dialog: 0,0:19:35.21,0:19:36.19,Default,,0,0,0,,Kalau begitu bicara!
Dialog: 0,0:19:36.21,0:19:38.58,Default,,0,0,0,,Aku tidak bisa bernapas.
Dialog: 0,0:19:41.09,0:19:43.03,Default,,0,0,0,,Apa?
Dialog: 0,0:19:43.05,0:19:44.92,Default,,0,0,0,,Bangun!
Dialog: 0,0:19:52.48,0:19:55.72,Default,,0,0,0,,Dokter Jeong mengira dia menderita gangguan panik.
Dialog: 0,0:19:57.82,0:19:59.21,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:19:59.23,0:20:01.88,Default,,0,0,0,,Kamu pasti sangat stres\Nout oleh kakekmu...
Dialog: 0,0:20:01.90,0:20:03.51,Default,,0,0,0,,Ini salah Hyun-woo.
Dialog: 0,0:20:03.53,0:20:07.65,Default,,0,0,0,,Mengapa dia begitu baik dalam pekerjaannya?
Dialogue: 0,0:20:08.91,0:20:10.22,Default,,0,0,0,,maafkan aku, Bu.
Dialogue: 0,0:20:10.25,0:20:12.77,Default,,0,0,0,,Ini salah kakakku.
Dialog: 0,0:20:12.79,0:20:14.02,Default,,0,0,0,,Sayang, itu konyol.
Dialogue: 0,0:20:14.04,0:20:16.69,Default,,0,0,0,,Adikmu bekerja keras\Ndan baru saja melakukan kesalahan.
Dialogue: 0,0:20:16.71,0:20:19.27,Default,,0,0,0,,$8 juta tidak terlalu serius.
Dialog: 0,0:20:19.30,0:20:21.40,Default,,0,0,0,,$8 juta?
Dialogue: 0,0:20:21.42,0:20:25.67,Default,,0,0,0,,Apakah ini semua hanya karena $8 juta?
Dialog: 0,0:20:26.51,0:20:28.16,Default,,0,0,0,,Di mana Hyun-woo?
Dialogue: 0,0:20:28.18,0:20:30.63,Default,,0,0,0,,Aku benar-benar minta maaf,
Dialog: 0,0:20:31.60,0:20:33.80,Default,,0,0,0,,tapi hasilnya sama saja.
Dialogue: 0,0:20:34.69,0:20:38.25,Default,,0,0,0,,Maksudmu dia benar-benar punya waktu tiga bulan lagi?
Dialog: 0,0:20:38.27,0:20:41.14,Default,,0,0,0,,- Tepat tiga bulan?\N- Saya tidak tahu.
Dialog: 0,0:20:41.49,0:20:43.71,Default,,0,0,0,,Itu jawaban yang tidak bertanggung jawab.
Dialogue: 0,0:20:43.74,0:20:46.05,Default,,0,0,0,,Anda telah menjadi ahli saraf selama 30 tahun.
Dialog: 0,0:20:46.07,0:20:49.93,Default,,0,0,0,,Harap tepat dengan persentasenya.\NTolong beri kami angka pastinya.
Dialog: 0,0:20:49.95,0:20:52.15,Default,,0,0,0,,Cukup. Ayo pergi.
Dialog: 0,0:20:52.29,0:20:54.82,Default,,0,0,0,,Tidak, Hae-in. Saya perlu mendengar ini.
Dialog: 0,0:20:56.38,0:20:59.54,Default,,0,0,0,,Baiklah, kalau begitu. Saya berangkat sekarang.
Dialog: 0,0:21:05.76,0:21:07.46,Default,,0,0,0,,Pak.
Dialogue: 0,0:21:08.14,0:21:10.53,Default,,0,0,0,,Saya sangat menghargai jika Anda bisa menebaknya dengan tepat.
Dialogue: 0,0:21:10.56,0:21:13.47,Default,,0,0,0,,Hidupku dipertaruhkan di sini.
Dialog: 0,0:21:40.96,0:21:42.87,Default,,0,0,0,,Ini konyol.
Dialog: 0,0:21:43.51,0:21:45.21,Default,,0,0,0,,Saya berbeda.
Dialog: 0,0:21:52.51,0:21:53.49,Default,,0,0,0,,Kenapa kamu ada di sini?
Dialogue: 0,0:21:53.52,0:21:56.29,Default,,0,0,0,,Kenapa Hyun-woo tidak mengangkatnya?\NIApakah dia ada di kantornya?
Dialog: 0,0:21:56.31,0:21:57.95,Default,,0,0,0,,Saya bertanya kenapa kamu ada di sini.
Dialogue: 0,0:21:57.98,0:22:00.71,Default,,0,0,0,,Jadi bagaimana jika Soo-cheol\Novermembayar beberapa juta dolar?
Dialogue: 0,0:22:00.73,0:22:04.13,Default,,0,0,0,,Hyun-woo bisa saja mengurusnya dengan tenang.
Dialogue: 0,0:22:04.15,0:22:05.98,Default,,0,0,0,,Kakekmu marah pada Soo-cheol.
Dialogue: 0,0:22:06.00,0:22:08.67,Default,,0,0,0,,Dia pasti mengetahuinya.\NHyun-woo tidak akan melakukan itu.
Dialogue: 0,0:22:08.70,0:22:10.43,Default,,0,0,0,,Kamu menganggapku untuk apa?
Dialog: 0,0:22:10.45,0:22:13.07,Default,,0,0,0,,Saya tahu Anda berada di belakangnya.
Dialog: 0,0:22:13.91,0:22:16.82,Default,,0,0,0,,Saya tidak punya waktu untuk itu. saya...
Dialog: 0,0:22:18.00,0:22:19.93,Default,,0,0,0,,sedikit terganggu oleh masalah serius.
Dialog: 0,0:22:19.96,0:22:21.83,Default,,0,0,0,,Soo-cheol telah...
Dialogue: 0,0:22:23.17,0:22:24.95,Default,,0,0,0,,serangan panik hari ini.
Dialog: 0,0:22:26.01,0:22:27.71,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:22:30.97,0:22:33.22,Default,,0,0,0,,Kamu pasti kaget.
Dialog: 0,0:22:34.97,0:22:36.67,Default,,0,0,0,,Tapi Bu,
Dialogue: 0,0:22:36.73,0:22:40.80,Default,,0,0,0,,Aku baru saja memberitahumu bahwa\NI punya masalah serius juga.
Dialogue: 0,0:22:41.73,0:22:43.60,Default,,0,0,0,,Penasaran gak?
Dialogue: 0,0:22:44.40,0:22:48.56,Default,,0,0,0,,Kamu selalu tahu apa yang harus dilakukan,\Nentah itu besar atau kecil.
Dialog: 0,0:22:50.07,0:22:51.77,Default,,0,0,0,,Benar.
Dialogue: 0,0:22:52.28,0:22:54.28,Default,,0,0,0,,Aku akan menjaganya...
Dialog: 0,0:22:54.53,0:22:55.68,Default,,0,0,0,,urusanku.
Dialog: 0,0:22:55.70,0:22:57.51,Default,,0,0,0,,Kamu harus pergi. Ini adalah tempat kerja saya.
Dialog: 0,0:22:57.54,0:22:59.35,Default,,0,0,0,,Hei, jangan pedulikan aku.
Dialogue: 0,0:22:59.37,0:23:01.74,Default,,0,0,0,,Aku di sini untuk menemui Hyun-woo.
Dialog: 0,0:23:02.17,0:23:04.20,Default,,0,0,0,,Berhenti memprovokasi kami,
Dialog: 0,0:23:04.50,0:23:07.27,Default,,0,0,0,,atau aku akan menyiksa anakmu sampai aku mati,
Dialog: 0,0:23:07.30,0:23:11.40,Default,,0,0,0,,tidak peduli seberapa sibuk atau terganggunya saya.
Dialog: 0,0:23:11.43,0:23:14.55,Default,,0,0,0,,- Apa?\N- Aku akan menyiksanya selamanya.
Dialog: 0,0:23:15.10,0:23:16.66,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:23:16.68,0:23:19.34,Default,,0,0,0,,Apa menurutmu aku akan duduk dan menonton saja?
Dialogue: 0,0:23:19.56,0:23:21.26,Default,,0,0,0,,Ayo.
Dialog: 0,0:23:35.03,0:23:36.55,Default,,0,0,0,,Kenapa kamu ingin makan di sini?
Dialogue: 0,0:23:36.58,0:23:39.43,Default,,0,0,0,,Hei, aku bahkan tidak merasa aman di\ruang rapat firma hukum Nour.
Dialogue: 0,0:23:39.45,0:23:43.12,Default,,0,0,0,,Tempat umum seperti ini terasa lebih aman.
Dialog: 0,0:23:43.25,0:23:44.91,Default,,0,0,0,,Mengapa demikian?
Dialog: 0,0:23:46.17,0:23:51.17,Default,,0,0,0,,Karena aku mempertaruhkan\Nhidupku untuk melawan Ratu.
Dialog: 0,0:23:52.13,0:23:53.88,Default,,0,0,0,,Mengapa kamu melakukannya?
Dialogue: 0,0:23:54.97,0:23:58.32,Default,,0,0,0,,Aku berpikir lama dan keras setelah melihatmu menangis.
Dialog: 0,0:23:58.35,0:24:00.80,Default,,0,0,0,,Saya akan membantu Anda. Ayo kita bercerai!
Dialogue: 0,0:24:05.44,0:24:08.93,Default,,0,0,0,,- Tentang itu...\N- Ini bukanlah keputusan yang mudah.
Dialogue: 0,0:24:09.03,0:24:10.84,Default,,0,0,0,,Aku mempertaruhkan pekerjaanku.
Dialog: 0,0:24:10.86,0:24:13.40,Default,,0,0,0,,Oke, tapi jangan lakukan itu.
Dialog: 0,0:24:13.45,0:24:14.98,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:24:17.24,0:24:19.40,Default,,0,0,0,,Saya tidak akan bercerai.
Dialog: 0,0:24:20.45,0:24:24.37,Default,,0,0,0,,Tidak? Hei, bukankah kamu bilang\Npadaku itu terlalu tak tertahankan?
Dialog: 0,0:24:24.58,0:24:25.69,Default,,0,0,0,,Yah...
Dialogue: 0,0:24:25.71,0:24:28.87,Default,,0,0,0,,Aku mengatakan itu karena aku tidak melihat akhir dari ini,
Dialog: 0,0:24:29.25,0:24:33.12,Default,,0,0,0,,tapi sekarang aku melihatnya,
Dialog: 0,0:24:33.97,0:24:35.28,Default,,0,0,0,,Saya rasa saya bisa menanggungnya.
Dialog: 0,0:24:35.30,0:24:37.59,Default,,0,0,0,,Apa maksudmu? Akhir apa?
Dialog: 0,0:24:38.72,0:24:40.41,Default,,0,0,0,,Yah...
Dialog: 0,0:24:40.43,0:24:43.41,Default,,0,0,0,,Tuhan memberiku perpisahan yang aman.
Dialogue: 0,0:24:43.44,0:24:45.16,Default,,0,0,0,,Anggap saja begitu.
Dialog: 0,0:24:45.19,0:24:47.60,Default,,0,0,0,,Jelaskan dalam istilah awam.
Dialog: 0,0:25:01.62,0:25:05.32,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Datanglah ke Hangang Jamwon\NParking Bagian Satu dalam setengah jam.{\c}{\i0}
Dialog: 0,0:25:22.47,0:25:24.34,Default,,0,0,0,,Apa yang kita lakukan?
Dialog: 0,0:25:24.43,0:25:27.60,Default,,0,0,0,,Apa yang akan saya sampaikan kepada Anda bersifat rahasia,
Dialogue: 0,0:25:28.40,0:25:31.13,Default,,0,0,0,,- jadi kalau ada yang tahu, itu salahmu.\N- Ayolah.
Dialogue: 0,0:25:31.15,0:25:33.39,Default,,0,0,0,,Tentang apa ini?
Dialog: 0,0:25:49.33,0:25:50.81,Default,,0,0,0,,Apakah kamu serius?
Dialogue: 0,0:25:50.84,0:25:53.48,Default,,0,0,0,,Dia memberitahuku saat aku hendak\Nmemberinya surat cerai,
Dialog: 0,0:25:53.51,0:25:55.83,Default,,0,0,0,,bahwa dia punya waktu tiga bulan lagi.
Dialog: 0,0:25:56.42,0:25:59.00,Default,,0,0,0,,Saya juga bertemu dengan dokternya hari ini.
Dialog: 0,0:25:59.34,0:26:00.88,Default,,0,0,0,,Astaga, Hyun-woo.
Dialog: 0,0:26:02.18,0:26:03.74,Default,,0,0,0,,Hei.
Dialogue: 0,0:26:03.77,0:26:06.37,Default,,0,0,0,,Ini gila. Apa yang harus saya katakan?
Dialog: 0,0:26:06.39,0:26:08.04,Default,,0,0,0,,Pertama...
Dialog: 0,0:26:08.06,0:26:10.62,Default,,0,0,0,,- Ayo berjabat tangan.\N- Jangan.
Dialog: 0,0:26:10.65,0:26:12.88,Default,,0,0,0,,Benar, kamu tidak seharusnya menunjukkan kebahagiaanmu.
Dialog: 0,0:26:12.90,0:26:15.00,Default,,0,0,0,,Biarkan aku menjadi bajingan,
Dialog: 0,0:26:15.03,0:26:17.92,Default,,0,0,0,,jadi Keberuntungan ada di pihakmu.
Dialogue: 0,0:26:17.95,0:26:20.97,Default,,0,0,0,,Kau akan meninggalkannya tanpa\Na satu sen pun atas namamu...
Dialogue: 0,0:26:20.99,0:26:22.30,Default,,0,0,0,,jika kamu bercerai.
Dialog: 0,0:26:22.33,0:26:24.30,Default,,0,0,0,,Beberapa detik itu menyelamatkanmu.
Dialog: 0,0:26:24.33,0:26:28.28,Default,,0,0,0,,Apa? Apakah ini berarti kamu akan mengambil alih Queens?
Dialog: 0,0:26:29.54,0:26:31.24,Default,,0,0,0,,Menurutmu...
Dialogue: 0,0:26:32.09,0:26:34.31,Default,,0,0,0,,- mereka sebodoh itu?\N- Apa maksudmu?
Dialogue: 0,0:26:34.34,0:26:36.23,Default,,0,0,0,,Apakah dia menandatangani perjanjian pranikah atau semacamnya?
Dialog: 0,0:26:36.26,0:26:37.90,Default,,0,0,0,,Tentang tidak membagi hartanya?
Dialog: 0,0:26:37.92,0:26:40.03,Default,,0,0,0,,Kamu tahu itu tidak masalah setelah kamu mengajukan gugatan,
Dialog: 0,0:26:40.05,0:26:41.74,Default,,0,0,0,,kecuali dia menulisnya dalam surat wasiatnya.
Dialog: 0,0:26:41.76,0:26:44.51,Default,,0,0,0,,Ya, dia menulisnya...
Dialog: 0,0:26:44.89,0:26:46.12,Default,,0,0,0,,dalam wasiatnya.
Dialog: 0,0:26:46.14,0:26:47.68,Default,,0,0,0,,Serius?
Dialog: 0,0:26:48.98,0:26:50.68,Default,,0,0,0,,Ya.
Dialogue: 0,0:26:50.85,0:26:53.31,Default,,0,0,0,,Itu terjadi sebelum kita menikah.
Dialog: 0,0:26:53.57,0:26:55.79,Default,,0,0,0,,Dia menolak memberikan apa pun kepadaku,
Dialog: 0,0:26:55.82,0:26:58.84,Default,,0,0,0,,dan bahkan mendapat surat wasiat dari notaris...
Dialog: 0,0:26:58.86,0:27:00.56,Default,,0,0,0,,sebelum kita menikah.
Dialog: 0,0:27:00.91,0:27:03.09,Default,,0,0,0,,Konglomerat memang berbeda.
Dialog: 0,0:27:03.12,0:27:04.64,Default,,0,0,0,,Mereka sangat teliti.
Dialog: 0,0:27:04.66,0:27:06.44,Default,,0,0,0,,Tidak apa-apa.
Dialogue: 0,0:27:06.62,0:27:08.72,Default,,0,0,0,,Aku hanya senang...
Dialogue: 0,0:27:08.75,0:27:13.45,Default,,0,0,0,,bahwa aku bisa lepas dari mereka\Ndengan selamat dalam tiga bulan.
Dialog: 0,0:27:15.50,0:27:18.44,Default,,0,0,0,,Tapi pikirkan ini.
Dialogue: 0,0:27:18.47,0:27:24.00,Default,,0,0,0,,Kenapa Tuhan memberimu tiga bulan itu?
Dialog: 0,0:27:24.14,0:27:25.84,Default,,0,0,0,,Hyun-woo.
Dialog: 0,0:27:26.89,0:27:27.95,Default,,0,0,0,,Pengacara Baek.
Dialog: 0,0:27:27.97,0:27:30.12,Default,,0,0,0,,Mari kita bicara secara profesional.
Dialogue: 0,0:27:30.14,0:27:33.37,Default,,0,0,0,,Kau tahu dia bebas merevisi\Nkeinginannya dalam tiga bulan itu.
Dialog: 0,0:27:33.40,0:27:36.08,Default,,0,0,0,,Kamu hanya perlu memenangkannya\Nover dalam tiga bulan ke depan,
Dialogue: 0,0:27:36.11,0:27:38.96,Default,,0,0,0,,jadi dia akan berpikir, "Astaga,\Ndia pasti sangat mencintaiku."
Dialog: 0,0:27:38.99,0:27:44.73,Default,,0,0,0,,"Aku harus menyerahkan\NQueens Department Store kesayanganku sebelum aku mati."
Dialog: 0,0:27:47.08,0:27:48.14,Default,,0,0,0,,Apa yang kamu katakan?
Dialogue: 0,0:27:48.16,0:27:51.22,Default,,0,0,0,,Tiga bulan bukanlah apa-apa setelah\Nmenjalani dua tahun di militer.
Dialog: 0,0:27:51.25,0:27:52.85,Default,,0,0,0,,Pertimbangkan itu dan itu akan lebih mudah.
Dialogue: 0,0:27:52.87,0:27:55.33,Default,,0,0,0,,Letakkan hati dan jiwamu...
Dialogue: 0,0:27:55.54,0:27:57.24,Default,,0,0,0,,mencintainya.
Dialog: 0,0:28:01.80,0:28:03.58,Default,,0,0,0,,Anda.
Dialogue: 0,0:28:04.39,0:28:06.92,Default,,0,0,0,,Apakah kamu serius berpikir...
Dialogue: 0,0:28:09.02,0:28:10.93,Default,,0,0,0,,Saya materialistis itu?
Dialogue: 0,0:28:20.03,0:28:21.42,Default,,0,0,0,,Untuk apa itu?
Dialogue: 0,0:28:21.44,0:28:24.01,Default,,0,0,0,,Hari ini adalah ulang tahun pernikahan kita.
Dialogue: 0,0:28:24.06,0:28:25.09,Default,,0,0,0,,Jadi?
Dialogue: 0,0:28:25.12,0:28:27.80,Default,,0,0,0,,Saya sudah melakukan reservasi dan\Nmenyiapkan kejutan dua tahun lalu,
Dialog: 0,0:28:27.83,0:28:30.85,Default,,0,0,0,,tapi kamu sangat kesal dan\Nmemintaku untuk tidak membuat keributan.
Dialog: 0,0:28:30.87,0:28:33.14,Default,,0,0,0,,- Jadi?\N- Jadi saya tidak mempersiapkan apa pun tahun lalu,
Dialog: 0,0:28:33.16,0:28:35.30,Default,,0,0,0,,tapi kamu masih marah\Nkarena aku benar-benar mendengarkan,
Dialog: 0,0:28:35.32,0:28:38.08,Default,,0,0,0,,dan bertanya apakah aku akan mati jika kamu menyuruhku.
Dialogue: 0,0:28:38.13,0:28:40.52,Default,,0,0,0,,Apakah kamu di sini untuk memikirkan ketidakkonsistenanku?
Dialog: 0,0:28:40.55,0:28:42.96,Default,,0,0,0,,Tidak, tentu saja tidak.
Dialogue: 0,0:28:44.38,0:28:47.11,Default,,0,0,0,,Orang seperti apa yang membawa bunga untuk diremehkan?
Dialogue: 0,0:28:47.14,0:28:50.28,Default,,0,0,0,,Lalu pernahkah pernikahan kita begitu\Nindah hingga kau membawakan bunga...
Dialog: 0,0:28:50.31,0:28:51.97,Default,,0,0,0,,di hari jadi kita?
Dialog: 0,0:28:53.64,0:28:55.34,Default,,0,0,0,,Sejujurnya,
Dialog: 0,0:28:55.48,0:28:57.51,Default,,0,0,0,,Saya tidak bisa mengatakan ya untuk itu,
Dialogue: 0,0:28:57.81,0:29:01.43,Default,,0,0,0,,tapi kita selalu bisa membuatnya indah, bukan?
Dialog: 0,0:29:04.86,0:29:06.56,Default,,0,0,0,,Selamat...
Dialog: 0,0:29:11.04,0:29:12.99,Default,,0,0,0,,ulang tahun pernikahan.
Dialog: 0,0:29:31.14,0:29:33.30,Default,,0,0,0,,Bawakan aku vas.
Dialog: 0,0:29:34.14,0:29:35.79,Default,,0,0,0,,{\i1}Bagaimana kabarnya?{\i0}
Dialog: 0,0:29:35.81,0:29:38.87,Default,,0,0,0,,Apakah mereka berkelahi atau semacamnya?
Dialog: 0,0:29:38.90,0:29:41.46,Default,,0,0,0,,Tidak, mereka tidak melakukannya. Sebaliknya...
Dialogue: 0,0:29:41.48,0:29:44.19,Default,,0,0,0,,- "Agak"?\N- Mereka semakin dekat.
Dialog: 0,0:29:44.49,0:29:46.38,Default,,0,0,0,,- "Lebih Dekat"?\N- Ya.
Dialogue: 0,0:29:46.40,0:29:50.32,Default,,0,0,0,,{\i1}Dia sangat menjaganya.\NIsangat berbeda dengannya.{\i0}
Dialogue: 0,0:29:51.58,0:29:54.57,Default,,0,0,0,,Apakah meja ini selalu untuk sepuluh orang?
Dialog: 0,0:29:55.75,0:29:57.53,Default,,0,0,0,,Dua Belas.
Dialogue: 0,0:30:06.26,0:30:08.54,Default,,0,0,0,,Selalu hanya kita berdua,
Dialogue: 0,0:30:11.93,0:30:13.84,Default,,0,0,0,,tapi kita duduk berjauhan.
Dialog: 0,0:30:17.23,0:30:18.41,Default,,0,0,0,,Ada apa denganmu?
Dialog: 0,0:30:18.44,0:30:20.14,Default,,0,0,0,,Sekarang saya akan...
Dialog: 0,0:30:21.56,0:30:23.68,Default,,0,0,0,,duduklah di sini.
Dialog: 0,0:30:52.97,0:30:57.41,Default,,0,0,0,,Ada terlalu banyak kontra dalam kontrak.
Dialog: 0,0:30:57.43,0:31:00.12,Default,,0,0,0,,Kami perlu menyediakan biaya renovasi toko.
Dialogue: 0,0:31:00.14,0:31:03.50,Default,,0,0,0,,Menurutku bukan\Nkerugian besar di pihak kita,
Dialog: 0,0:31:03.52,0:31:05.54,Default,,0,0,0,,mengingat popularitas merek.
Dialog: 0,0:31:05.57,0:31:08.92,Default,,0,0,0,,Benar, namun tidak diharuskan\Nuntuk bertahan selama jangka waktu tertentu.
Dialogue: 0,0:31:08.95,0:31:11.01,Default,,0,0,0,,Misalnya kita menghabiskan $5 juta...
Dialog: 0,0:31:11.03,0:31:12.84,Default,,0,0,0,,untuk memasukkan mereka.
Dialog: 0,0:31:12.87,0:31:15.72,Default,,0,0,0,,Kami tidak berhak menghentikan mereka\Njika mereka ingin pergi setelah satu tahun.
Dialogue: 0,0:31:15.74,0:31:18.89,Default,,0,0,0,,Kita juga diharuskan membayar\Na denda jika mereka mengetahui...
Dialog: 0,0:31:18.91,0:31:22.12,Default,,0,0,0,,orang menjual produk palsu.
Dialog: 0,0:31:25.71,0:31:27.37,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:31:29.38,0:31:30.61,Default,,0,0,0,,Tunggu. saya baik-baik saja...
Dialog: 0,0:31:30.63,0:31:32.42,Default,,0,0,0,,Jangan bicara. Biarkan aku.
Dialog: 0,0:31:32.47,0:31:35.00,Default,,0,0,0,,- Silakan hubungi ambulans.\N- Maaf?
Dialog: 0,0:31:36.89,0:31:37.87,Default,,0,0,0,,Saya baik-baik saja.
Dialog: 0,0:31:37.89,0:31:39.88,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:31:40.60,0:31:42.80,Default,,0,0,0,,Aku baru saja tersedak air.
Dialog: 0,0:31:45.27,0:31:46.75,Default,,0,0,0,,- Benarkah?\N- Ya.
Dialog: 0,0:31:46.77,0:31:48.48,Default,,0,0,0,,Jadi?
Dialog: 0,0:31:48.61,0:31:50.48,Default,,0,0,0,,Bisakah kita melanjutkan?
Dialog: 0,0:31:50.57,0:31:52.10,Default,,0,0,0,,Ya pak.
Dialog: 0,0:31:52.82,0:31:54.94,Default,,0,0,0,,Tidak perlu ambulans.
Dialogue: 0,0:31:59.41,0:32:00.76,Default,,0,0,0,,Apa yang merasukinya?
Dialogue: 0,0:32:00.79,0:32:02.47,Default,,0,0,0,,Dia hanya berusaha bertahan.
Dialog: 0,0:32:02.50,0:32:03.73,Default,,0,0,0,,Selamat tinggal pak.
Dialog: 0,0:32:03.75,0:32:06.16,Default,,0,0,0,,Saya akan menghubungi Anda nanti. Selamat tinggal.
Dialog: 0,0:32:08.13,0:32:09.32,Default,,0,0,0,,Jika dia diam saja,
Dialog: 0,0:32:09.34,0:32:12.86,Default,,0,0,0,,dia akan marah\Nkalau dia tidak melakukan apa pun.
Dialog: 0,0:32:12.88,0:32:16.13,Default,,0,0,0,,Aku sungguh kasihan padanya.
Dialog: 0,0:32:22.85,0:32:25.47,Default,,0,0,0,,Dingin. Anda sebaiknya menunggu di dalam saja.
Dialogue: 0,0:32:29.69,0:32:32.02,Default,,0,0,0,,Kamu kedinginan.
Dialogue: 0,0:32:32.82,0:32:35.36,Default,,0,0,0,,Bagaimana jika kamu masuk angin?
Dialog: 0,0:32:36.74,0:32:38.53,Default,,0,0,0,,Astaga.
Dialogue: 0,0:32:41.45,0:32:43.95,Default,,0,0,0,,Kenapa tanganmu dingin sekali?
Dialog: 0,0:32:45.63,0:32:48.87,Default,,0,0,0,,Sekretaris Na, apakah mobilnya akan segera hadir?
Dialog: 0,0:32:49.80,0:32:51.83,Default,,0,0,0,,Ya, ya.
Dialog: 0,0:32:52.13,0:32:53.71,Default,,0,0,0,,Apakah kamu akan baik-baik saja?
Dialogue: 0,0:32:53.93,0:32:56.38,Default,,0,0,0,,Haruskah aku memanggil ambulans?
Dialog: 0,0:33:00.64,0:33:02.34,Default,,0,0,0,,Itu dia.
Dialog: 0,0:33:19.99,0:33:21.86,Default,,0,0,0,,Tidak apa-apa.
Dialog: 0,0:33:23.75,0:33:25.60,Default,,0,0,0,,Astaga.
Dialogue: 0,0:33:25.62,0:33:27.91,Default,,0,0,0,,Mereka seharusnya berdebat saja.
Dialogue: 0,0:33:28.21,0:33:30.08,Default,,0,0,0,,Apa yang merasukinya?
Dialog: 0,0:33:38.30,0:33:40.11,Default,,0,0,0,,Bukankah aku sudah memberitahumu?
Dialog: 0,0:33:40.14,0:33:42.01,Default,,0,0,0,,Jangan dramatis.
Dialog: 0,0:33:43.77,0:33:47.55,Default,,0,0,0,,Hae-in, aku tidak tahu bagaimana menjadi dramatis.
Dialogue: 0,0:33:53.86,0:33:55.69,Default,,0,0,0,,{\i1}Ini{\i0} sungguh dramatis.
Dialog: 0,0:34:05.87,0:34:07.53,Default,,0,0,0,,Maaf.
Dialog: 0,0:34:17.38,0:34:19.86,Default,,0,0,0,,{\i1}Saya tidak tahu kenapa...{\i0}
Dialog: 0,0:34:19.89,0:34:23.03,Default,,0,0,0,,Hyun-woo mengingatkanku pada Grace Kelly.
Dialogue: 0,0:34:23.06,0:34:24.78,Default,,0,0,0,,Bukankah dia menikah dengan seorang raja?
Dialog: 0,0:34:24.81,0:34:26.99,Default,,0,0,0,,- Dia mengingatkanku pada Diana.\N- Itu salah.
Dialogue: 0,0:34:27.02,0:34:29.41,Default,,0,0,0,,Keduanya bercerai.
Dialog: 0,0:34:29.44,0:34:30.62,Default,,0,0,0,,- Maaf.\N- Mi-seon.
Dialog: 0,0:34:30.65,0:34:32.92,Default,,0,0,0,,Aku datang ke sini untuk menata rambutku, bukan mencabutnya.
Dialogue: 0,0:34:32.94,0:34:34.46,Default,,0,0,0,,Aku bilang aku minta maaf.
Dialogue: 0,0:34:34.48,0:34:38.34,Default,,0,0,0,,Mungkin karena kami ibu rumah tangga,\Ntapi kamu sungguh tidak memperlakukan kami dengan baik.
Dialog: 0,0:34:38.36,0:34:39.92,Default,,0,0,0,,- Saya setuju.\N- Jujurlah kepada kami.
Dialogue: 0,0:34:39.95,0:34:42.30,Default,,0,0,0,,Apakah kamu kesal saat kita\Nberbicara tentang penampilan Hyun-woo?
Dialogue: 0,0:34:42.32,0:34:44.89,Default,,0,0,0,,Hyun-woo selalu tampan.
Dialog: 0,0:34:44.91,0:34:45.97,Default,,0,0,0,,Bukan seperti itu.
Dialog: 0,0:34:46.00,0:34:47.16,Default,,0,0,0,,Benar.
Dialog: 0,0:34:47.19,0:34:48.18,Default,,0,0,0,,Apakah kamu dengar?
Dialog: 0,0:34:48.21,0:34:50.68,Default,,0,0,0,,- Tentang apa?\N- Putri toko elektronik.
Dialog: 0,0:34:50.71,0:34:53.83,Default,,0,0,0,,- Mertua siapa yang dokter?\N- Ya.
Dialogue: 0,0:34:54.54,0:34:56.15,Default,,0,0,0,,- Mereka akan bercerai.\N- Benarkah?
Dialog: 0,0:34:56.17,0:34:57.57,Default,,0,0,0,,- Serius?\N- Ya!
Dialog: 0,0:34:57.59,0:34:59.94,Default,,0,0,0,,- Ya ampun.\N- Ya ampun.
Dialog: 0,0:34:59.97,0:35:02.86,Default,,0,0,0,,Astaga, itu bukan masalah besar.
Dialogue: 0,0:35:02.89,0:35:04.57,Default,,0,0,0,,Perceraian adalah hal biasa saat ini.
Dialog: 0,0:35:04.60,0:35:07.49,Default,,0,0,0,,Bahkan ada acara TV\Nyang menampilkan pasangan yang bercerai.
Dialogue: 0,0:35:07.52,0:35:10.16,Default,,0,0,0,,Tidak sayang kalau bercerai akhir-akhir ini.
Dialogue: 0,0:35:10.19,0:35:13.33,Default,,0,0,0,,Ibunya pasti sangat\Ndipermalukan melihat tetangganya.
Dialogue: 0,0:35:13.36,0:35:17.34,Default,,0,0,0,,Dia selalu membual\Ntentang menantunya yang menjadi dokter.
Dialog: 0,0:35:17.36,0:35:18.84,Default,,0,0,0,,Saya kira dia juga seorang dokter.
Dialog: 0,0:35:18.86,0:35:21.55,Default,,0,0,0,,Dia selalu memberi nasehat\Nkepada orang lain jika mereka sedang tidak sehat.
Dialog: 0,0:35:21.57,0:35:23.49,Default,,0,0,0,,- Ceritakan padaku.\N- Mengapa mereka berpisah?
Dialogue: 0,0:35:23.51,0:35:24.68,Default,,0,0,0,,Mereka terlalu berbeda.
Dialog: 0,0:35:24.70,0:35:26.22,Default,,0,0,0,,Sudah kubilang sebelumnya.
Dialogue: 0,0:35:26.24,0:35:30.49,Default,,0,0,0,,Pernikahan tidak akan bertahan jika istri\Ndan suami terlalu berbeda,
Dialogue: 0,0:35:33.08,0:35:35.99,Default,,0,0,0,,tapi saya tidak mengatakan bahwa selalu demikian.
Dialogue: 0,0:35:36.30,0:35:38.36,Default,,0,0,0,,Apakah pernikahan Hyun-woo bahagia?
Dialogue: 0,0:35:38.38,0:35:40.65,Default,,0,0,0,,Tentu saja.
Dialogue: 0,0:35:40.68,0:35:42.36,Default,,0,0,0,,Tapi kamu tahu apa kata mereka.
Dialogue: 0,0:35:42.39,0:35:45.11,Default,,0,0,0,,Orang-orang di Seoul meremehkan orang-orang seperti kita.
Dialog: 0,0:35:45.14,0:35:46.20,Default,,0,0,0,,Benar,
Dialog: 0,0:35:46.22,0:35:49.72,Default,,0,0,0,,dan Hyun-woo menikah\Ndengan keluarga konglomerat.
Dialogue: 0,0:35:50.14,0:35:52.37,Default,,0,0,0,,Adik iparku tidak seperti itu.
Dialog: 0,0:35:52.40,0:35:55.60,Default,,0,0,0,,Benar. saya yakin.
Dialogue: 0,0:35:56.11,0:35:59.39,Default,,0,0,0,,Lalu kenapa dia tidak menghadiri\Nulang tahun ayahmu yang ke-60?
Dialogue: 0,0:36:00.03,0:36:02.92,Default,,0,0,0,,Orang-orang mulai bergosip setelahnya.
Dialog: 0,0:36:02.95,0:36:04.84,Default,,0,0,0,,- Mengatakan?\N- Bahwa hubungan mereka tidak baik.
Dialog: 0,0:36:04.87,0:36:06.80,Default,,0,0,0,,Mereka pikir Hyun-woo tidak diperlakukan dengan baik.
Dialog: 0,0:36:06.83,0:36:08.91,Default,,0,0,0,,Hanya mereka yang tidak memperlakukan mertuanya dengan baik...
Dialogue: 0,0:36:08.94,0:36:11.72,Default,,0,0,0,,menghadiri pesta ulang tahun\Ndan berpura-pura seperti mereka.
Dialogue: 0,0:36:11.75,0:36:14.01,Default,,0,0,0,,Tapi orang seperti dia yang\Nare baik pada mertuanya...
Dialog: 0,0:36:14.03,0:36:16.12,Default,,0,0,0,,tidak perlu melakukan itu.
Dialog: 0,0:36:16.25,0:36:18.62,Default,,0,0,0,,Begitu, tapi apakah kamu marah?
Dialogue: 0,0:36:19.01,0:36:20.44,Default,,0,0,0,,Kenapa aku harus marah?
Dialogue: 0,0:36:20.46,0:36:24.04,Default,,0,0,0,,Kemudian kendurkan tinju itu,\Atau kamu tidak akan melayangkan pukulan.
Dialogue: 0,0:36:27.68,0:36:29.70,Default,,0,0,0,,- Aku pusing.\N- Ada apa dengannya?
Dialog: 0,0:36:29.72,0:36:31.41,Default,,0,0,0,,- Dia marah.\N- Begitu.
Dialogue: 0,0:36:31.43,0:36:33.29,Default,,0,0,0,,Seluruh badanku sakit hari ini.
Dialog: 0,0:36:33.31,0:36:34.37,Default,,0,0,0,,Jangan membuang barang.
Dialog: 0,0:36:34.40,0:36:37.76,Default,,0,0,0,,Pinky sedang menonton, kamu tahu?
Dialogue: 0,0:36:40.03,0:36:42.05,Default,,0,0,0,,Hyun-woo, si bodoh itu.
Dialog: 0,0:36:42.07,0:36:45.38,Default,,0,0,0,,Saya mengerti. Belajar hukum di SNU\Nmungkin membuatnya sombong,
Dialogue: 0,0:36:45.41,0:36:48.23,Default,,0,0,0,,jadi pasti sulit untuk\Nmencari-cari keluarga konglomerat,
Dialogue: 0,0:36:48.26,0:36:51.05,Default,,0,0,0,,tapi bukankah lebih baik\Nmenghina mereka, jika ada?
Dialog: 0,0:36:51.08,0:36:53.52,Default,,0,0,0,,Tentu saja. Saya adalah anak-anak sekolah menengah yang hidung coklatnya setiap bulan.
Dialogue: 0,0:36:53.54,0:36:55.48,Default,,0,0,0,,- Mengapa?\N- Jadi mereka mendaftar untuk bulan berikutnya.
Dialogue: 0,0:36:55.50,0:36:57.93,Default,,0,0,0,,Hei, bukan tanganku yang\Nmembuatku tetap berbisnis.
Dialog: 0,0:36:57.96,0:36:59.27,Default,,0,0,0,,Tidak sama sekali. Itu mulutku.
Dialogue: 0,0:36:59.30,0:37:02.90,Default,,0,0,0,,"Astaga, kamu cantik sekali\Nhari ini. Kulitmu bercahaya!"
Dialogue: 0,0:37:02.92,0:37:06.07,Default,,0,0,0,,"Kamu terlihat sepuluh tahun lebih muda dengan\Npotongan rambut baru ini." Itulah yang saya katakan.
Dialog: 0,0:37:06.09,0:37:07.95,Default,,0,0,0,,Saya berharap Hyun-woo bisa seperti kita.
Dialog: 0,0:37:07.97,0:37:09.07,Default,,0,0,0,,Astaga.
Dialogue: 0,0:37:09.10,0:37:11.47,Default,,0,0,0,,Aku terlalu menyayanginya.
Dialogue: 0,0:37:11.93,0:37:14.87,Default,,0,0,0,,Bu, bukankah ibu harus melakukan sesuatu terhadap hal ini?
Dialogue: 0,0:37:14.89,0:37:18.50,Default,,0,0,0,,- Dia mungkin akan bercerai.\N- Perceraian bukanlah masalah besar.
Dialog: 0,0:37:18.52,0:37:19.96,Default,,0,0,0,,Sayang.
Dialogue: 0,0:37:19.98,0:37:23.21,Default,,0,0,0,,Orang bercerai ketika mereka berpikir\Nmereka berada di ambang kematian.
Dialogue: 0,0:37:23.24,0:37:25.35,Default,,0,0,0,,Lebih baik bercerai saja.
Dialogue: 0,0:37:26.32,0:37:28.13,Default,,0,0,0,,Mienya enak.
Dialog: 0,0:37:28.16,0:37:29.94,Default,,0,0,0,,Lebih banyak minyak wijen?
Dialog: 0,0:37:29.99,0:37:31.99,Default,,0,0,0,,Ya, tambahkan lagi.
Dialogue: 0,0:37:40.67,0:37:43.48,Default,,0,0,0,,{\i1}Aku menyiapkan makanan berbeda untuk kalian masing-masing,{\i0}
Dialog: 0,0:37:43.51,0:37:46.21,Default,,0,0,0,,{\i1}berdasarkan hasil tes darah minggu lalu.{\i0}
Dialogue: 0,0:37:46.38,0:37:49.15,Default,,0,0,0,,Sedangkan untuk wakil ketua,\NI menyiapkan diet rendah FODMAP...
Dialogue: 0,0:37:49.18,0:37:51.37,Default,,0,0,0,,untuk sindrom iritasi usus besarmu.
Dialog: 0,0:37:51.39,0:37:52.92,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:38:02.15,0:38:03.13,Default,,0,0,0,,Di mana Kakek?
Dialogue: 0,0:38:03.15,0:38:06.84,Default,,0,0,0,,Dia harus berpuasa untuk\Npemeriksaan kesehatannya besok.
Dialogue: 0,0:38:06.86,0:38:10.84,Default,,0,0,0,,Aku berani bertaruh dia akan hidup hingga usia 120 tahun.
Dialog: 0,0:38:10.87,0:38:12.93,Default,,0,0,0,,Punyaku tidak ada dagingnya.
Dialogue: 0,0:38:12.95,0:38:15.57,Default,,0,0,0,,Itu karena kolesterolmu.
Dialog: 0,0:38:18.73,0:38:19.79,Default,,0,0,0,,Hae-in.
Dialog: 0,0:38:19.82,0:38:20.81,Default,,0,0,0,,Ya?
Dialog: 0,0:38:20.84,0:38:23.65,Default,,0,0,0,,Anda akan menerima sertifikasi\Tidak ada isinya besok.
Dialogue: 0,0:38:23.67,0:38:26.69,Default,,0,0,0,,Saya akan mengajukan tuntutan atas cara\NAnda membangun department store Anda...
Dialogue: 0,0:38:26.72,0:38:29.88,Default,,0,0,0,,di atas tanahku di Gwanggyo.
Dialogue: 0,0:38:30.43,0:38:34.03,Default,,0,0,0,,Kita sudah membicarakan hal ini\Nsaat konstruksi dimulai,
Dialogue: 0,0:38:34.06,0:38:35.87,Default,,0,0,0,,dan daratannya tidak terlalu luas.
Dialog: 0,0:38:35.89,0:38:39.83,Default,,0,0,0,,Dengarkan. Semua perang dimulai karena\Tidak ada pihak yang melangkahi...
Dialog: 0,0:38:39.85,0:38:42.89,Default,,0,0,0,,- tanah pihak lain.\N- Anda memberi saya izin.
Dialog: 0,0:38:44.11,0:38:47.98,Default,,0,0,0,,Ya, tapi Pengacara Shim menentangnya.
Dialogue: 0,0:38:48.03,0:38:51.13,Default,,0,0,0,,Rumor mungkin menyebar tentang\Nbagaimana aku memberimu perlakuan khusus,
Dialogue: 0,0:38:51.16,0:38:53.59,Default,,0,0,0,,dan saya mungkin harus membayar pajak hadiah.
Dialog: 0,0:38:53.62,0:38:56.26,Default,,0,0,0,,Jadi, Anda akan mengajukan gugatan,\Nkarena gedung...
Dialog: 0,0:38:56.29,0:38:57.43,Default,,0,0,0,,sudah dibuat?
Dialogue: 0,0:38:57.46,0:38:58.97,Default,,0,0,0,,Kamu belum membukanya.
Dialog: 0,0:38:59.00,0:39:02.14,Default,,0,0,0,,Saya mengerti. Lalu haruskah aku menghancurkannya saja?
Dialog: 0,0:39:02.17,0:39:05.36,Default,,0,0,0,,Hae-in, dia tidak ingin memperpanjang kasus ini.
Dialog: 0,0:39:05.38,0:39:07.75,Default,,0,0,0,,Dia ingin bernegosiasi.
Dialog: 0,0:39:07.84,0:39:09.82,Default,,0,0,0,,- Hyun-woo.\N- Ya, Pak.
Dialog: 0,0:39:09.84,0:39:13.21,Default,,0,0,0,,Perhatikan bersama dia, dan datang\Nup dengan ukuran yang sesuai.
Dialog: 0,0:39:18.10,0:39:20.01,Default,,0,0,0,,"Ukuran yang tepat"?
Dialogue: 0,0:39:20.98,0:39:25.47,Default,,0,0,0,,Apa maksudnya? Haruskah\NI takut dan mundur?
Dialogue: 0,0:39:25.61,0:39:28.25,Default,,0,0,0,,Inikah maksudmu\Nsaat kamu bilang ayo lakukan?
Dialog: 0,0:39:28.28,0:39:30.30,Default,,0,0,0,,Anda mengancam saya dengan gugatan itu.
Dialogue: 0,0:39:30.32,0:39:31.76,Default,,0,0,0,,Maksudku adalah...
Dialogue: 0,0:39:31.78,0:39:33.40,Default,,0,0,0,,Menurutku...
Dialog: 0,0:39:36.70,0:39:37.68,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:39:37.70,0:39:40.02,Default,,0,0,0,,Apakah kamu baru saja memotongku?
Dialog: 0,0:39:40.04,0:39:41.91,Default,,0,0,0,,Saya minta maaf,
Dialog: 0,0:39:42.23,0:39:44.94,Default,,0,0,0,,tetapi karena Anda sudah mengajukan keluhan,
Dialog: 0,0:39:44.96,0:39:47.81,Default,,0,0,0,,kami akan memeriksanya dan memberikan balasan kami.
Dialog: 0,0:39:47.84,0:39:50.57,Default,,0,0,0,,Namun, pers akan mengetahui\Ntentang hal ini dalam prosesnya,
Dialog: 0,0:39:50.59,0:39:53.03,Default,,0,0,0,,dan itu bisa menyebabkan jatuhnya\N harga saham dan banyak lagi.
Dialogue: 0,0:39:53.05,0:39:55.67,Default,,0,0,0,,Aku harus memberitahu kakeknya.
Dialogue: 0,0:39:57.26,0:39:58.97,Default,,0,0,0,,Aku akan melakukannya.
Dialog: 0,0:39:59.35,0:40:01.89,Default,,0,0,0,,Ya, Bu. Maka itu saja.
Dialog: 0,0:40:03.98,0:40:06.52,Default,,0,0,0,,Dia merasa agak tidak enak badan.
Dialog: 0,0:40:07.40,0:40:09.02,Default,,0,0,0,,Mohon maaf.
Dialogue: 0,0:40:24.63,0:40:27.44,Default,,0,0,0,,Kamu ingin merahasiakannya dari keluargamu.
Dialog: 0,0:40:27.49,0:40:28.48,Default,,0,0,0,,Tapi?
Dialog: 0,0:40:28.50,0:40:31.78,Default,,0,0,0,,Tapi bukankah mereka akan mencurigai ada sesuatu yang terjadi,
Dialogue: 0,0:40:31.80,0:40:35.29,Default,,0,0,0,,jika tubuhmu tegang dan\Ntinjumu gemetar?
Dialog: 0,0:40:36.26,0:40:40.47,Default,,0,0,0,,Benar. Aku tahu aku bertindak di luar karakter,
Dialog: 0,0:40:40.52,0:40:42.63,Default,,0,0,0,,tapi bagaimana denganmu?
Dialog: 0,0:40:42.94,0:40:45.58,Default,,0,0,0,,Kamu menyela ibuku dan memihakku.
Dialogue: 0,0:40:45.60,0:40:48.01,Default,,0,0,0,,Kamu juga menatap mataku dengan penuh kasih.
Dialog: 0,0:40:53.11,0:40:55.90,Default,,0,0,0,,Kamu yang paling mencurigakan.
Dialog: 0,0:40:56.95,0:40:58.90,Default,,0,0,0,,Bertingkahlah seperti biasanya.
Dialogue: 0,0:41:00.83,0:41:03.66,Default,,0,0,0,,Kapan kamu pernah mengupas udang untukku?
Dialogue: 0,0:41:10.17,0:41:13.33,Default,,0,0,0,,{\i1}Itu tidak akan berhasil bagi kami.{\i0}
Dialog: 0,0:41:18.68,0:41:20.66,Default,,0,0,0,,Tidak mungkin.
Dialogue: 0,0:41:20.68,0:41:23.54,Default,,0,0,0,,Bagaimana kita bisa berubah setelah\Nbertahun-tahun hidup sebagai orang asing?
Dialogue: 0,0:41:23.56,0:41:24.73,Default,,0,0,0,,Tapi bukankah begitu...
Dialog: 0,0:41:24.76,0:41:26.12,Default,,0,0,0,,- tiga tahun lalu?\N- Apa itu?
Dialogue: 0,0:41:26.15,0:41:28.01,Default,,0,0,0,,Bukankah kamu sedang jatuh cinta?
Dialogue: 0,0:41:28.11,0:41:30.38,Default,,0,0,0,,- Tadi...\N- Kalian berdua jungkir balik.
Dialog: 0,0:41:30.40,0:41:32.75,Default,,0,0,0,,Dia mengunjungimu dengan helikopter...
Dialog: 0,0:41:32.78,0:41:34.59,Default,,0,0,0,,dan tidak menaati orang tuanya. Kamu juga.
Dialogue: 0,0:41:34.61,0:41:36.21,Default,,0,0,0,,Kamu juga tidak waras saat itu.
Dialog: 0,0:41:36.24,0:41:38.18,Default,,0,0,0,,Kamu gila cinta,
Dialogue: 0,0:41:38.20,0:41:41.28,Default,,0,0,0,,jadi bukankah itu cinta?
Dialog: 0,0:41:43.16,0:41:44.26,Default,,0,0,0,,Itu terjadi bertahun-tahun yang lalu.
Dialog: 0,0:41:44.29,0:41:46.68,Default,,0,0,0,,Ya, Anda benar, tapi\Nsaya beri contoh.
Dialogue: 0,0:41:46.71,0:41:49.88,Default,,0,0,0,,Kita belajar cara bertahan hidup di air sebagai\Nanak-anak. Maka kita tidak berenang selama beberapa dekade.
Dialogue: 0,0:41:49.91,0:41:52.17,Default,,0,0,0,,Bahkan jika kita berakhir di air\Nagain, kita akan tetap terapung.
Dialogue: 0,0:41:52.19,0:41:55.36,Default,,0,0,0,,Kamu mungkin berpikir kamu lupa semuanya,\Ntapi tubuhmu mengingatnya.
Dialogue: 0,0:41:55.38,0:41:56.69,Default,,0,0,0,,Sama halnya dengan cinta.
Dialog: 0,0:41:56.72,0:41:58.86,Default,,0,0,0,,Anda mungkin mengira Anda lupa cara melakukannya,
Dialog: 0,0:41:58.89,0:42:01.45,Default,,0,0,0,,tapi hatimu mengingatnya begitu kamu masuk ke dalamnya.
Dialogue: 0,0:42:01.47,0:42:03.24,Default,,0,0,0,,Tapi ini tidak seperti berenang.
Dialog: 0,0:42:03.27,0:42:06.22,Default,,0,0,0,,Tentu saja. Jatuh cinta bukanlah sesuatu yang istimewa.
Dialogue: 0,0:42:10.44,0:42:12.35,Default,,0,0,0,,Aneh ya?
Dialog: 0,0:42:12.73,0:42:15.31,Default,,0,0,0,,Kita menikah karena kita sedang jatuh cinta,
Dialogue: 0,0:42:15.78,0:42:17.46,Default,,0,0,0,,lalu kenapa cinta itu hilang?
Dialogue: 0,0:42:17.49,0:42:19.26,Default,,0,0,0,,Sebagai pengacara perceraian,
Dialogue: 0,0:42:19.28,0:42:23.40,Default,,0,0,0,,Menurutku masalahnya adalah\Npernikahan itu eksklusif.
Dialog: 0,0:42:23.45,0:42:25.26,Default,,0,0,0,,Pasangan tidak merasa perlu untuk mencoba,
Dialog: 0,0:42:25.29,0:42:27.06,Default,,0,0,0,,jadi mereka kecewa dan bertengkar.
Dialogue: 0,0:42:27.08,0:42:30.64,Default,,0,0,0,,Lalu mereka mendatangiku. Pernikahan\Nhanya membuat hal itu mustahil...
Dialogue: 0,0:42:30.67,0:42:33.45,Default,,0,0,0,,untuk tetap jatuh cinta.
Dialogue: 0,0:42:37.84,0:42:41.09,Default,,0,0,0,,- Menurutmu begitu?\N- Menurutku yang terbaik adalah tidak menikah,
Dialog: 0,0:42:41.14,0:42:44.26,Default,,0,0,0,,jika kamu ingin jatuh cinta dalam waktu yang lama.
Dialog: 0,0:43:15.71,0:43:19.12,Default,,0,0,0,,Terimalah ini sebagai\Ntanda cinta dan kesetiaanku.
Dialog: 0,0:43:33.86,0:43:35.77,Default,,0,0,0,,Sayang.
Dialog: 0,0:43:36.40,0:43:38.25,Default,,0,0,0,,Apakah kamu gila? Dia bukan "Sayang"-mu.
Dialog: 0,0:43:38.28,0:43:40.48,Default,,0,0,0,,Sudah lama tidak bertemu, Sekretaris Kim.
Dialog: 0,0:43:40.65,0:43:42.61,Default,,0,0,0,,Halo Bu.
Dialogue: 0,0:43:43.99,0:43:46.85,Default,,0,0,0,,Kamu akan menikah? Kalian berdua?
Dialog: 0,0:43:46.87,0:43:48.90,Default,,0,0,0,,Dan di Korea pada saat itu?
Dialog: 0,0:43:49.04,0:43:50.52,Default,,0,0,0,,Benar.
Dialogue: 0,0:43:50.54,0:43:53.02,Default,,0,0,0,,Kau pasti dengar aku dipenjara.
Dialog: 0,0:43:53.04,0:43:54.44,Default,,0,0,0,,Itulah sebabnya kamu kembali.
Dialogue: 0,0:43:54.46,0:43:56.02,Default,,0,0,0,,Tapi sayang sekali.
Dialog: 0,0:43:56.05,0:43:59.37,Default,,0,0,0,,Saya keluar.
Dialog: 0,0:44:06.31,0:44:07.84,Default,,0,0,0,,Tenang, Sayang.
Dialog: 0,0:44:09.64,0:44:11.08,Default,,0,0,0,,Apa yang kubilang padamu?
Dialogue: 0,0:44:11.10,0:44:13.00,Default,,0,0,0,,Aku bilang aku akan mengampuni nyawamu...
Dialog: 0,0:44:13.02,0:44:17.25,Default,,0,0,0,,selama kamu meninggalkan negara itu dan bersembunyi.
Dialog: 0,0:44:17.27,0:44:18.71,Default,,0,0,0,,- Benar.\N- Jadi, beraninya kamu...
Dialog: 0,0:44:18.73,0:44:21.34,Default,,0,0,0,,menikah di depan semua kerabatmu,
Dialogue: 0,0:44:21.36,0:44:23.31,Default,,0,0,0,,kapan kamu selingkuh?
Dialog: 0,0:44:29.62,0:44:31.32,Default,,0,0,0,,Sayang.
Dialog: 0,0:44:31.79,0:44:33.53,Default,,0,0,0,,Sayang.
Dialog: 0,0:44:41.30,0:44:43.04,Default,,0,0,0,,Sayang.
Dialog: 0,0:44:44.30,0:44:46.59,Default,,0,0,0,,Sayang!
Dialogue: 0,0:45:02.78,0:45:05.55,Default,,0,0,0,,Bu, anda ada darahnya...
Dialog: 0,0:45:05.57,0:45:07.57,Default,,0,0,0,,Itu bukan milikku.
Dialog: 0,0:45:10.41,0:45:12.97,Default,,0,0,0,,- Dimana?\N- Di pipimu.
Dialog: 0,0:45:13.00,0:45:15.23,Default,,0,0,0,,Anda tidak boleh melakukan ini saat Anda dalam masa percobaan.
Dialogue: 0,0:45:15.25,0:45:17.99,Default,,0,0,0,,Anda bisa mendapatkan hukuman\N yang lebih berat karena penyerangan dan pencemaran nama baik.
Dialog: 0,0:45:18.01,0:45:22.30,Default,,0,0,0,,Pencemaran nama baik? Apa yang saya lakukan sejauh ini\Nterhadap para cheater itu jauh dari itu.
Dialogue: 0,0:45:23.47,0:45:25.86,Default,,0,0,0,,Haruskah saya tunjukkan seperti apa pencemaran nama baik yang sebenarnya?
Dialogue: 0,0:45:25.88,0:45:28.91,Default,,0,0,0,,Kamu bisa berada di balik jeruji besi\Nsampai umurmu 60 tahun jika melakukan itu.
Dialog: 0,0:45:28.93,0:45:30.84,Default,,0,0,0,,Apakah akan baik-baik saja?
Dialog: 0,0:45:31.56,0:45:33.37,Default,,0,0,0,,Saya sudah menyelesaikan masalah dengan pengacara mereka.
Dialog: 0,0:45:33.39,0:45:34.41,Default,,0,0,0,,Berapa?
Dialog: 0,0:45:34.44,0:45:36.20,Default,,0,0,0,,- Ingin tahu?\N- Lupakan saja.
Dialogue: 0,0:45:36.23,0:45:38.54,Default,,0,0,0,,Cukup membangun kolam di rumah mereka.
Dialog: 0,0:45:38.56,0:45:40.81,Default,,0,0,0,,Kamu seharusnya tidak melakukan itu.
Dialogue: 0,0:45:41.23,0:45:43.35,Default,,0,0,0,,Apakah kamu masih membencinya?
Dialogue: 0,0:45:47.24,0:45:48.76,Default,,0,0,0,,Apakah kamu merokok?
Dialog: 0,0:45:48.78,0:45:50.51,Default,,0,0,0,,- Saya berhenti.\N- Karena saya melakukannya.
Dialogue: 0,0:45:50.53,0:45:54.65,Default,,0,0,0,,Saya belajar merokok karena\Tidak semua mantan suami saya selingkuh.
Dialog: 0,0:45:56.96,0:45:58.27,Default,,0,0,0,,Kamu tidak boleh merokok di sini.
Dialog: 0,0:45:58.29,0:46:00.27,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:46:00.29,0:46:02.20,Default,,0,0,0,,Pergi? Di mana?
Dialog: 0,0:46:04.72,0:46:05.73,Default,,0,0,0,,Sialan.
Dialogue: 0,0:46:05.76,0:46:08.29,Default,,0,0,0,,Aku sangat ingin keluar dari penjara,
Dialog: 0,0:46:09.34,0:46:12.21,Default,,0,0,0,,tapi sekarang aku keluar, tidak ada tempat untuk pergi.
Dialog: 0,0:46:13.68,0:46:15.38,Default,,0,0,0,,Kamu harus pulang.
Dialog: 0,0:46:16.27,0:46:18.80,Default,,0,0,0,,Ketua sedang menunggumu.
Dialog: 0,0:46:28.36,0:46:29.59,Default,,0,0,0,,Beom-ja.
Dialogue: 0,0:46:29.62,0:46:33.11,Default,,0,0,0,,Kudengar kamu tidak makan seharian.
Dialogue: 0,0:46:40.46,0:46:43.31,Default,,0,0,0,,Apa urusanmu kalau aku mati kelaparan atau tidak?
Dialog: 0,0:46:43.34,0:46:45.65,Default,,0,0,0,,Kamu memenjarakanku karena kamu tidak peduli.
Dialogue: 0,0:46:45.67,0:46:48.74,Default,,0,0,0,,Astaga, bukan aku yang melakukan itu.
Dialogue: 0,0:46:48.76,0:46:53.16,Default,,0,0,0,,Kamu menyerang wanita yang tidak bersalah,
Dialog: 0,0:46:53.18,0:46:55.84,Default,,0,0,0,,jadi kamu dihukum atas tindakanmu.
Dialog: 0,0:46:56.93,0:46:58.33,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:46:58.35,0:47:00.96,Default,,0,0,0,,Wanita yang membunuh Ibu dan\Nmenjadi nyonya rumah...
Dialogue: 0,0:47:00.99,0:47:03.21,Default,,0,0,0,,sama sekali tidak bersalah.
Dialogue: 0,0:47:03.23,0:47:06.09,Default,,0,0,0,,Dia bukan nyonya rumah.
Dialogue: 0,0:47:06.11,0:47:08.25,Default,,0,0,0,,Dia tidak ada dalam daftar keluarga kita.
Dialogue: 0,0:47:08.28,0:47:11.38,Default,,0,0,0,,Yang kulakukan hanyalah menjambak\Nrambutnya dengan lembut, tapi akulah yang berdosa di sini.
Dialogue: 0,0:47:11.41,0:47:14.05,Default,,0,0,0,,Kamu tidak bisa mengatakan itu lembut\Nketika disknya tergelincir.
Dialogue: 0,0:47:14.08,0:47:18.49,Default,,0,0,0,,Tepat sekali, jadi urus urusanmu sendiri\Ndan biarkan aku mati karena menyelipkan disknya!
Dialog: 0,0:47:24.00,0:47:26.69,Default,,0,0,0,,Hei, Beom-ja.
Dialog: 0,0:47:26.71,0:47:28.73,Default,,0,0,0,,Kamu salah paham tentang dia.
Dialog: 0,0:47:28.76,0:47:31.95,Default,,0,0,0,,Seul-hee tidak menginginkan apa pun dari kita.
Dialogue: 0,0:47:31.97,0:47:34.88,Default,,0,0,0,,Dia tidak tertarik pada\Nkeberuntungan atau menjadi keluarga.
Dialogue: 0,0:47:35.64,0:47:38.62,Default,,0,0,0,,Itu bahkan lebih menakutkan.
Dialogue: 0,0:47:38.64,0:47:42.54,Default,,0,0,0,,Rencana besar apa yang dia rencanakan\Nuntuk tinggal bersamamu dan tidak menginginkan apa pun?
Dialogue: 0,0:47:42.56,0:47:46.52,Default,,0,0,0,,Kamu cuma kakek tua yang punya banyak uang!
Dialog: 0,0:47:47.19,0:47:50.05,Default,,0,0,0,,Hei!
Dialog: 0,0:47:50.07,0:47:51.30,Default,,0,0,0,,Astaga.
Dialogue: 0,0:47:51.32,0:47:54.88,Default,,0,0,0,,Aku penasaran kapan dia akan sadar.
Dialogue: 0,0:47:54.91,0:47:59.18,Default,,0,0,0,,Aku seharusnya tidak punya harapan karena\Ndia sudah berusia lima puluhan, kan?
Dialog: 0,0:47:59.20,0:48:00.85,Default,,0,0,0,,Jangan biarkan hal itu mengganggumu.
Dialog: 0,0:48:00.87,0:48:03.81,Default,,0,0,0,,Ngomong-ngomong, aku tahu aku bukan tandinganmu,
Dialog: 0,0:48:03.83,0:48:07.08,Default,,0,0,0,,tapi kamu sama sekali tidak fokus pada permainan.
Dialog: 0,0:48:07.67,0:48:09.46,Default,,0,0,0,,Apa maksudmu?
Dialog: 0,0:48:13.30,0:48:16.28,Default,,0,0,0,,- Ya ampun.\N- Menatap papan tidak akan membantu.
Dialogue: 0,0:48:16.31,0:48:18.63,Default,,0,0,0,,Anda perlu melihat gambaran yang lebih besar.
Dialog: 0,0:48:18.68,0:48:20.22,Default,,0,0,0,,Kamu benar.
Dialogue: 0,0:48:21.60,0:48:25.10,Default,,0,0,0,,Kamu akan ketahuan jika lari ketakutan.
Dialog: 0,0:48:30.44,0:48:32.84,Default,,0,0,0,,Tetapi jika kamu mencoba menangkap harimau...
Dialog: 0,0:48:32.86,0:48:37.07,Default,,0,0,0,,tanpa persiapan,
Dialog: 0,0:48:37.45,0:48:39.18,Default,,0,0,0,,kamu akan kehilangan segalanya.
Dialog: 0,0:48:39.20,0:48:41.15,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:48:41.41,0:48:45.45,Default,,0,0,0,,Inilah sebabnya {\i1}janggi{\i0} bisa memberimu pelajaran hidup.
Dialogue: 0,0:49:13.20,0:49:15.31,Default,,0,0,0,,Aku mengambil alih istanamu.
Dialog: 0,0:49:15.82,0:49:17.51,Default,,0,0,0,,Ke mana raja akan melarikan diri sekarang?
Dialog: 0,0:49:17.53,0:49:19.44,Default,,0,0,0,,Skakmat.
Dialog: 0,0:49:20.99,0:49:23.78,Default,,0,0,0,,Apakah kamu melihat ini datang,
Dialogue: 0,0:49:23.96,0:49:26.60,Default,,0,0,0,,atau kamu hanya beruntung?
Dialog: 0,0:49:26.63,0:49:28.58,Default,,0,0,0,,Saya tidak yakin.
Dialogue: 0,0:49:29.21,0:49:32.19,Default,,0,0,0,,Kamu perlu memberiku satu bantuan, karena kamu kalah.
Dialog: 0,0:49:32.21,0:49:33.44,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:49:33.47,0:49:37.71,Default,,0,0,0,,Aku akan memberitahumu kalau aku punya.
Dialog: 0,0:49:45.98,0:49:48.37,Default,,0,0,0,,Sayang, apakah kamu melihatnya?
Dialogue: 0,0:49:48.40,0:49:51.27,Default,,0,0,0,,Sepertinya aku baru saja melihat bintang jatuh.
Dialog: 0,0:49:51.44,0:49:55.00,Default,,0,0,0,,Aku tidak tahu aku bisa melihatnya di Seoul.
Dialogue: 0,0:49:55.03,0:49:58.31,Default,,0,0,0,,Kamu bermimpi memotret\Nbintang sebelum memiliki Hae-in.
Dialog: 0,0:50:00.91,0:50:02.49,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:50:03.41,0:50:06.31,Default,,0,0,0,,Kamu bersemangat karena\Nmengira kamu akan punya bayi perempuan.
Dialog: 0,0:50:06.33,0:50:10.49,Default,,0,0,0,,Saya tidak yakin. Saya tidak begitu ingat.
Dialog: 0,0:50:11.13,0:50:14.29,Default,,0,0,0,,Sayang, jangan terlalu keras pada Hae-in.
Dialog: 0,0:50:16.17,0:50:17.83,Default,,0,0,0,,Apa yang kulakukan?
Dialogue: 0,0:50:18.51,0:50:22.37,Default,,0,0,0,,Berapa lama kamu akan membiarkan masa lalu menghantuimu?
Dialog: 0,0:50:22.39,0:50:25.38,Default,,0,0,0,,Kamu harus melepaskannya dan melanjutkan.
Dialogue: 0,0:50:26.27,0:50:29.25,Default,,0,0,0,,Itulah yang kamu katakan saat itu.\NAyahmu tidak ingin ada masalah,
Dialog: 0,0:50:29.27,0:50:30.83,Default,,0,0,0,,jadi Anda wajib.
Dialog: 0,0:50:30.86,0:50:33.63,Default,,0,0,0,,Aku masih tidak mengerti kenapa Su-wan harus mati.
Dialog: 0,0:50:33.65,0:50:36.84,Default,,0,0,0,,Itu hanya kecelakaan. Tidak ada yang bisa disalahkan.
Dialog: 0,0:50:36.86,0:50:39.72,Default,,0,0,0,,Kamu benar. Ini bukan salah siapa-siapa,
Dialog: 0,0:50:39.74,0:50:42.15,Default,,0,0,0,,tapi Su-wan sudah pergi.
Dialogue: 0,0:50:43.12,0:50:46.86,Default,,0,0,0,,Aku masih kesal dan kesakitan setiap hari.
Dialog: 0,0:50:47.08,0:50:48.78,Default,,0,0,0,,Kepada yang lain...
Dialogue: 0,0:50:49.25,0:50:51.27,Default,,0,0,0,,Bagimu, ini hanya kejadian masa lalu,
Dialogue: 0,0:50:51.29,0:50:53.74,Default,,0,0,0,,tapi aku menghidupkan kembali momen itu setiap hari.
Dialog: 0,0:50:55.26,0:50:58.50,Default,,0,0,0,,Aku dihantui oleh hari ketika aku kehilangan anakku,
Dialog: 0,0:51:00.47,0:51:03.96,Default,,0,0,0,,jadi jangan harap aku bersikap masuk akal.
Dialogue: 0,0:51:50.02,0:51:52.97,Default,,0,0,0,,Kenapa dia belum juga pulang?
Dialog: 0,0:51:54.40,0:51:56.35,Default,,0,0,0,,Apakah dia benar-benar sakit?
Dialog: 0,0:51:57.11,0:51:59.23,Default,,0,0,0,,Dia memiliki stamina yang hebat.
Dialogue: 0,0:52:00.45,0:52:05.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sejujurnya, peluangnya\No untuk bertahan hidup sangat rendah,{\c}{\i0}
Dialog: 0,0:52:05.99,0:52:08.68,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi keajaiban bisa saja terjadi.{\c}{\i0}
Dialog: 0,0:52:08.70,0:52:10.39,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maaf?{\c}{\i0}
Dialogue: 0,0:52:10.41,0:52:13.56,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Seberapa sering keajaiban ini terjadi?{\c}{\i0}
Dialogue: 0,0:52:13.58,0:52:15.52,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah sering terjadi?{\c}{\i0}
Dialogue: 0,0:52:15.54,0:52:17.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Selama 30 tahun saya menjadi dokter,{\c}{\i0}
Dialogue: 0,0:52:17.80,0:52:21.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya telah menyaksikan banyak pasien\Nsembuh secara ajaib...{\c}{\i0}
Dialog: 0,0:52:21.88,0:52:25.32,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dari penyakit yang bahkan lebih kecil harapannya.{\c}{\i0}
Dialog: 0,0:52:25.35,0:52:27.88,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan putus asa.{\c}{\i0}
Dialog: 0,0:52:29.35,0:52:31.02,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}kasus klinis tumor otak{\c}{\i0}
Dialog: 0,0:52:33.56,0:52:35.40,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tumor ganas\NDjangan menyerah pada pengobatan{\c}{\i0}
Dialogue: 0,0:52:45.82,0:52:49.55,Default,,0,0,0,,{\an8}"Diberi waktu tiga bulan untuk hidup,\Ntapi masih hidup setelah 30 tahun."
Dialog: 0,0:52:49.58,0:52:51.11,Default,,0,0,0,,30 tahun?
Dialog: 0,0:52:51.71,0:52:53.57,Default,,0,0,0,,Serius?
Dialogue: 0,0:52:56.92,0:53:00.58,Default,,0,0,0,,Aku tidak tahu ini biasa terjadi.
Dialogue: 0,0:53:01.72,0:53:05.50,Default,,0,0,0,,Saya kira prediksi\Ndokter tidak selalu benar.
Dialog: 0,0:53:05.68,0:53:08.21,Default,,0,0,0,,Ini... Astaga.
Dialog: 0,0:53:08.47,0:53:10.24,Default,,0,0,0,,Ini tidak seperti di drama.
Dialogue: 0,0:53:10.27,0:53:16.87,Default,,0,0,0,,"Tumornya hilang setelah\Nbangun. Kasus yang mustahil secara medis."
Dialogue: 0,0:53:16.90,0:53:20.60,Default,,0,0,0,,Bagaimana mungkin secara medis tidak mungkin?
Dialog: 0,0:53:20.98,0:53:23.27,Default,,0,0,0,,Apakah ini kenyataannya...
Dialogue: 0,0:53:24.20,0:53:27.23,Default,,0,0,0,,pengobatan modern? Benar-benar?
Dialog: 0,0:54:41.31,0:54:44.00,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pasien yang sakit parah masih bisa pulih{\c}{\i0}
Dialogue: 0,0:54:44.03,0:54:46.38,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Diberi waktu 3 bulan untuk hidup,\Ntapi masih hidup setelah 30 tahun{\c}{\i0}
Dialogue: 0,0:55:00.00,0:55:02.52,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Penyembuhan ajaib kanker pankreasku{\c}{\i0}
Dialogue: 0,0:55:02.54,0:55:04.33,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Mereka yang berpegang teguh pada harapan{\c}{\i0}
Dialog: 0,0:55:14.10,0:55:15.80,Default,,0,0,0,,Hei, Hae-in.
Dialog: 0,0:55:17.73,0:55:19.80,Default,,0,0,0,,Kapan kamu masuk?
Dialog: 0,0:55:23.77,0:55:26.43,Default,,0,0,0,,Kenapa kamu tidur di sini? Tidur di tempat tidur.
Dialog: 0,0:55:27.69,0:55:30.02,Default,,0,0,0,,Baiklah, saya harus melakukannya.
Dialogue: 0,0:55:31.24,0:55:32.77,Default,,0,0,0,,Kamu juga harusnya.
Dialog: 0,0:55:33.66,0:55:35.19,Default,,0,0,0,,Selamat malam.
Dialog: 0,0:55:47.59,0:55:49.17,Default,,0,0,0,,Hyun-woo.
Dialog: 0,0:55:50.51,0:55:52.04,Default,,0,0,0,,Ya?
Dialog: 0,0:55:52.72,0:55:54.30,Default,,0,0,0,,Sejujurnya,
Dialog: 0,0:55:54.64,0:55:59.38,Default,,0,0,0,,Saya mencurigai Anda.
Dialog: 0,0:56:00.94,0:56:02.72,Default,,0,0,0,,Apa?
Dialogue: 0,0:56:06.23,0:56:10.39,Default,,0,0,0,,Kupikir kamu akan senang mendengar aku sekarat.
Dialogue: 0,0:56:10.57,0:56:14.11,Default,,0,0,0,,Kupikir itu sebabnya kamu\N begitu baik padaku.
Dialogue: 0,0:56:15.70,0:56:18.44,Default,,0,0,0,,Saya juga curiga Anda...
Dialog: 0,0:56:18.58,0:56:20.70,Default,,0,0,0,,motif tersembunyi.
Dialog: 0,0:56:22.37,0:56:23.98,Default,,0,0,0,,Saya akui...
Dialog: 0,0:56:24.00,0:56:25.87,Default,,0,0,0,,Saya agak curiga.
Dialogue: 0,0:56:26.09,0:56:29.75,Default,,0,0,0,,Saya tidak tahu Anda telah mencari hal-hal itu.
Dialogue: 0,0:56:37.72,0:56:42.76,Default,,0,0,0,,Keajaiban ini terjadi lebih sering dari yang Anda kira.
Dialog: 0,0:56:44.85,0:56:46.56,Default,,0,0,0,,Apa...?
Dialog: 0,0:56:46.73,0:56:49.23,Default,,0,0,0,,Kamu tidak perlu datang ke sini.
Dialog: 0,0:56:52.90,0:56:56.86,Default,,0,0,0,,Jangan khawatir. Aku akan hidup, apapun yang terjadi.
Dialogue: 0,0:56:58.12,0:56:59.55,Default,,0,0,0,,Aku bertindak tegar,
Dialogue: 0,0:56:59.58,0:57:02.14,Default,,0,0,0,,tapi aku terkejut mendengar diagnosaku.
Dialog: 0,0:57:02.16,0:57:03.64,Default,,0,0,0,,Saya putus asa.
Dialogue: 0,0:57:03.67,0:57:08.04,Default,,0,0,0,,Sebagian diriku tidak peduli\Napa yang akan terjadi padaku.
Dialogue: 0,0:57:08.25,0:57:10.90,Default,,0,0,0,,"Kalau saja aku hanya punya waktu tiga bulan,"
Dialogue: 0,0:57:10.92,0:57:13.11,Default,,0,0,0,,"apakah menerima pengobatan akan membantu?"
Dialog: 0,0:57:13.13,0:57:15.04,Default,,0,0,0,,"Haruskah aku menyerah saja?"
Dialog: 0,0:57:15.64,0:57:18.66,Default,,0,0,0,,"Tak seorang pun akan meratapi kematianku,"
Dialog: 0,0:57:18.68,0:57:20.80,Default,,0,0,0,,"bahkan bukan keluargaku."
Dialog: 0,0:57:21.06,0:57:23.55,Default,,0,0,0,,Aku mempunyai berbagai macam pemikiran.
Dialog: 0,0:57:25.73,0:57:27.29,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:57:27.31,0:57:30.77,Default,,0,0,0,,Tapi ada satu orang.
Dialogue: 0,0:57:32.82,0:57:37.23,Default,,0,0,0,,Kalian semua ingin aku hidup.
Dialog: 0,0:57:37.41,0:57:38.94,Default,,0,0,0,,Saya?
Dialog: 0,0:57:39.78,0:57:42.78,Default,,0,0,0,,Ya. Tentu saja.
Dialogue: 0,0:57:43.16,0:57:45.87,Default,,0,0,0,,Ya, benar.
Dialogue: 0,0:57:46.83,0:57:49.29,Default,,0,0,0,,Ini berat bagiku.
Dialogue: 0,0:57:50.75,0:57:55.25,Default,,0,0,0,,Terlalu berat untuk ditangani,\Ntapi melihatmu memberiku harapan.
Dialog: 0,0:57:56.01,0:57:57.07,Default,,0,0,0,,Saya melakukan penelitian sendiri.
Dialogue: 0,0:57:57.09,0:57:59.95,Default,,0,0,0,,Tidak seperti di Korea, ada\Nkasus serupa di luar negeri.
Dialogue: 0,0:57:59.97,0:58:03.80,Default,,0,0,0,,Ada banyak laboratorium di luar sana\Nyang mengembangkan obat baru.
Dialogue: 0,0:58:03.85,0:58:07.66,Default,,0,0,0,,Mereka bisa mempercepat prosesnya,\Selama mereka punya dana.
Dialogue: 0,0:58:07.69,0:58:11.97,Default,,0,0,0,,Saya akan secara aktif berupaya mendukung mereka.
Dialog: 0,0:58:12.61,0:58:14.39,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:58:15.15,0:58:17.02,Default,,0,0,0,,Apakah kamu sebahagia itu?
Dialog: 0,0:58:18.36,0:58:20.15,Default,,0,0,0,,Ya.
Dialog: 0,0:58:20.58,0:58:22.74,Default,,0,0,0,,Tentu saja.
Dialog: 0,0:58:27.96,0:58:29.70,Default,,0,0,0,,Jangan khawatir.
Dialogue: 0,0:58:29.83,0:58:34.71,Default,,0,0,0,,Aku tidak akan mati semudah itu, demi kamu.
Dialogue: 0,0:59:13.42,0:59:15.11,Default,,0,0,0,,Apakah ini untuk akun media sosialmu?
Dialogue: 0,0:59:15.13,0:59:17.19,Default,,0,0,0,,Bagaimana jika itu hanya sebagian dari wajahmu?
Dialogue: 0,0:59:17.22,0:59:19.15,Default,,0,0,0,,Aku sangat ingin dunia melihatmu.
Dialog: 0,0:59:19.18,0:59:21.20,Default,,0,0,0,,Tetapi media akan memposting artikel tentang saya,
Dialog: 0,0:59:21.22,0:59:25.16,Default,,0,0,0,,dan orang tuamu tidak menginginkan itu.
Dialog: 0,0:59:25.18,0:59:26.41,Default,,0,0,0,,Saya tidak ingin membuat mereka khawatir.
Dialog: 0,0:59:26.43,0:59:28.38,Default,,0,0,0,,Kamu benar-benar...!
Dialog: 0,0:59:29.60,0:59:31.30,Default,,0,0,0,,Baiklah.
Dialog: 0,0:59:34.02,0:59:35.00,Default,,0,0,0,,Juga,
Dialogue: 0,0:59:35.02,0:59:38.92,Default,,0,0,0,,Jun-ho menyuruhku merahasiakannya,\Nkarena belum dikonfirmasi.
Dialogue: 0,0:59:38.95,0:59:41.01,Default,,0,0,0,,Direktur keuangan kita? Tentang apa?
Dialogue: 0,0:59:41.03,0:59:44.01,Default,,0,0,0,,Dia merasa tidak enak dengan $8 juta itu.
Dialog: 0,0:59:44.03,0:59:45.58,Default,,0,0,0,,Tidak apa-apa.
Dialog: 0,0:59:45.60,0:59:46.60,Default,,0,0,0,,Tetap.
Dialog: 0,0:59:46.62,0:59:49.85,Default,,0,0,0,,Dia mencoba menghubungkanmu dengan\Nseseorang untuk menebusnya.
Dialog: 0,0:59:49.87,0:59:52.27,Default,,0,0,0,,- Siapa?\N- Investor dana ekuitas swasta.
Dialogue: 0,0:59:52.29,0:59:53.44,Default,,0,0,0,,Dialah orangnya...
Dialog: 0,0:59:53.46,0:59:56.77,Default,,0,0,0,,yang berinvestasi dalam kesepakatan\Nkopi organik untuk Yeom Sang-jin.
Dialog: 0,0:59:56.80,0:59:58.83,Default,,0,0,0,,Benarkah?
Dialog: 0,1:00:00.05,1:00:03.15,Default,,0,0,0,,Namanya David Yoon. Dia orang Korea-Amerika.
Dialog: 0,1:00:03.18,1:00:05.07,Default,,0,0,0,,{\i1}Dia baru saja datang ke Korea.{\i0}
Dialogue: 0,1:00:05.10,1:00:07.28,Default,,0,0,0,,{\i1}Dia menguasai uang minyak Timur Tengah,{\i0}
Dialog: 0,1:00:07.31,1:00:09.54,Default,,0,0,0,,{\i1}dan dia di sini untuk mencari investasi baru.{\i0}
Dialogue: 0,1:00:09.56,1:00:12.93,Default,,0,0,0,,{\i1}Dia ingin berinvestasi setidaknya\Nsetidaknya beberapa miliar dolar.{\i0}
Dialogue: 0,1:00:27.24,1:00:31.03,Default,,0,0,0,,{\i1}Hae-in telah mencoba\Nmembawa Hercyna ke tokonya,{\i0}
Dialog: 0,1:00:31.08,1:00:35.10,Default,,0,0,0,,{\i1}dan David adalah alasannya\Nmerek tersebut dapat diluncurkan...{\i0}
Dialogue: 0,1:00:35.13,1:00:39.20,Default,,0,0,0,,{\i1}toko utama Asia pertama mereka di Seoul.{\i0}
Dialog: 0,1:00:49.77,1:00:51.34,Default,,0,0,0,,Hai.
Dialog: 0,1:00:55.36,1:00:57.31,Default,,0,0,0,,Hai.
Dialog: 0,1:00:57.94,1:01:01.42,Default,,0,0,0,,Selamat. Saya menyukai renovasi baru\Nbagian makanan Anda.
Dialogue: 0,1:01:01.44,1:01:03.96,Default,,0,0,0,,Aku sering makan di food courtmu akhir-akhir ini.
Dialog: 0,1:01:03.99,1:01:07.59,Default,,0,0,0,,Benar. Aku dengar kamu sering datang ke sini.
Dialogue: 0,1:01:07.62,1:01:10.76,Default,,0,0,0,,Bagaimanapun, Royal masih memiliki jalan\Npanjang untuk mencapai levelmu.
Dialogue: 0,1:01:10.79,1:01:12.82,Default,,0,0,0,,Makanan penutup kita perlu sedikit penyesuaian.
Dialog: 0,1:01:13.12,1:01:14.48,Default,,0,0,0,,Banyak yang harus kita lakukan.
Dialog: 0,1:01:14.50,1:01:18.60,Default,,0,0,0,,Setelah alun-alun air mancur\Ni dibangun di lantai pertama,
Dialog: 0,1:01:18.63,1:01:20.27,Default,,0,0,0,,kami akan mendatangkan Hercyna,
Dialog: 0,1:01:20.30,1:01:22.54,Default,,0,0,0,,dan kami akan bekerja dari sana.
Dialog: 0,1:01:23.68,1:01:25.11,Default,,0,0,0,,Tidak, kita harus bekerja lebih keras.
Dialogue: 0,1:01:25.13,1:01:27.36,Default,,0,0,0,,Jadi bagaimana jika bagian makanan kita enak?
Dialogue: 0,1:01:27.39,1:01:31.42,Default,,0,0,0,,Toserba tanpa\NHercyna hanyalah sebuah restoran besar.
Dialogue: 0,1:01:31.47,1:01:34.34,Default,,0,0,0,,Kami juga punya ruang untuk Hercyna.
Dialogue: 0,1:01:37.81,1:01:39.12,Default,,0,0,0,,Mau tip?
Dialog: 0,1:01:39.15,1:01:42.17,Default,,0,0,0,,Tentu, jika Anda ingin memberi saya satu.
Dialog: 0,1:01:42.19,1:01:43.88,Default,,0,0,0,,Oke.
Dialog: 0,1:01:43.90,1:01:46.34,Default,,0,0,0,,Saya yakin Anda tahu bahwa Pak Hermann...
Dialog: 0,1:01:46.36,1:01:48.93,Default,,0,0,0,,mengutamakan nilai perusahaan dan\Npola pikir di atas hal lain.
Dialog: 0,1:01:48.95,1:01:52.30,Default,,0,0,0,,Dia percaya bahwa mereka yang membentuk\Nhubungan baik dengan orang lain...
Dialog: 0,1:01:52.33,1:01:55.35,Default,,0,0,0,,adalah mitra bisnis terbaik.
Dialog: 0,1:01:55.37,1:01:56.98,Default,,0,0,0,,Itu keyakinannya.
Dialog: 0,1:01:57.00,1:01:58.94,Default,,0,0,0,,- Jadi?\N- Lihatlah sekelilingmu.
Dialog: 0,1:01:58.96,1:02:01.79,Default,,0,0,0,,Semua orang di sini membawa\Npasangan, kekasih, atau anggota keluarganya.
Dialog: 0,1:02:01.81,1:02:04.78,Default,,0,0,0,,Kamu satu-satunya di sini...
Dialog: 0,1:02:04.80,1:02:06.71,Default,,0,0,0,,siapa yang datang sendiri.
Dialog: 0,1:02:06.80,1:02:08.50,Default,,0,0,0,,Apa?
Dialogue: 0,1:02:11.26,1:02:13.41,Default,,0,0,0,,Kamu membuatku terkesan.
Dialog: 0,1:02:13.43,1:02:15.37,Default,,0,0,0,,Semua orang tahu kamu tidak punya teman,
Dialogue: 0,1:02:15.39,1:02:19.18,Default,,0,0,0,,tapi bagaimana kamu bisa berpikir untuk datang\Nke semua tempat sendirian?
Dialog: 0,1:02:20.77,1:02:22.79,Default,,0,0,0,,Kaulah satu-satunya serigala yang sendirian di sini.
Dialog: 0,1:02:22.82,1:02:25.39,Default,,0,0,0,,Hanya kamu, Hae-in.
Dialogue: 0,1:02:25.74,1:02:27.56,Default,,0,0,0,,Kasihan kamu.
Dialog: 0,1:02:42.21,1:02:43.19,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:02:47.51,1:02:50.17,Default,,0,0,0,,- Kamu dimana?\N- {\i1}Aku sedang dalam uji coba.{\i0}
Dialog: 0,1:02:58.85,1:03:00.55,Default,,0,0,0,,Apa yang dia katakan?
Dialog: 0,1:03:04.19,1:03:05.17,Default,,0,0,0,,Apa maksudmu?
Dialogue: 0,1:03:05.19,1:03:07.59,Default,,0,0,0,,Kamu dengan panik menelepon\Nsuamimu untuk meminta bantuan.
Dialog: 0,1:03:07.61,1:03:08.71,Default,,0,0,0,,Dia tidak datang?
Dialog: 0,1:03:08.74,1:03:11.82,Default,,0,0,0,,- Dia sedang dalam uji coba.\N- Cocok sekali.
Dialogue: 0,1:03:11.91,1:03:13.30,Default,,0,0,0,,- Apa?\N- Apa yang bisa kamu lakukan?
Dialog: 0,1:03:13.33,1:03:15.51,Default,,0,0,0,,Kamu tidak bisa menyuruhnya memberi jaminan.
Dialogue: 0,1:03:15.54,1:03:19.10,Default,,0,0,0,,Menurutku itu alasan yang pas.
Dialog: 0,1:03:19.12,1:03:21.98,Default,,0,0,0,,Ini bukan alasan. Dia benar-benar sedang dalam uji coba.
Dialog: 0,1:03:22.00,1:03:25.00,Default,,0,0,0,,Kenapa kamu begitu serius? Saya hanya bercanda.
Dialog: 0,1:03:26.05,1:03:28.44,Default,,0,0,0,,Hei, jangan pedulikan rumornya.
Dialog: 0,1:03:28.47,1:03:29.94,Default,,0,0,0,,Saya tidak percaya mereka.
Dialog: 0,1:03:29.97,1:03:32.24,Default,,0,0,0,,- Rumor apa?\N- Saya yakin Anda pernah mendengarnya...
Dialogue: 0,1:03:32.26,1:03:35.99,Default,,0,0,0,,bahwa kalian berdua telah berpisah\Ndan akan segera bercerai.
Dialog: 0,1:03:36.02,1:03:40.50,Default,,0,0,0,,Bahwa dia hanya menikahimu demi uangmu.\NI bahkan tidak ingin membicarakannya.
Dialogue: 0,1:03:40.52,1:03:41.50,Default,,0,0,0,,Tapi sudah.
Dialog: 0,1:03:41.52,1:03:44.08,Default,,0,0,0,,Saya baru saja memulai.
Dialogue: 0,1:03:44.11,1:03:46.34,Default,,0,0,0,,Kamu seharusnya menjalani pernikahan biasa.
Dialogue: 0,1:03:46.36,1:03:49.63,Default,,0,0,0,,Bahkan para penggosip pun tidak akan punya banyak\N untuk dibicarakan jika kamu menikah dengan seseorang...
Dialog: 0,1:03:49.65,1:03:51.47,Default,,0,0,0,,pada level Anda sendiri.
Dialogue: 0,1:03:51.49,1:03:53.43,Default,,0,0,0,,Aku telah menyadari sesuatu dalam hidup.
Dialogue: 0,1:03:53.45,1:03:56.76,Default,,0,0,0,,Pernikahan adalah mencari pasangan hidup...
Dialogue: 0,1:03:56.79,1:04:00.99,Default,,0,0,0,,siapa yang melihat ke arah yang sama denganmu.
Dialogue: 0,1:04:02.67,1:04:04.73,Default,,0,0,0,,Empat tahun pernikahanku yang lalu...
Dialog: 0,1:04:04.75,1:04:06.40,Default,,0,0,0,,tidak lain hanyalah kedamaian,
Dialog: 0,1:04:06.42,1:04:10.46,Default,,0,0,0,,dan itu menggugah rasa ingin tahu saya tentang\Npasangan yang tidak akur.
Dialog: 0,1:04:10.80,1:04:14.28,Default,,0,0,0,,Bagaimana rasanya? Aku belum pernah\Nmarah pada suamiku sebelumnya.
Dialog: 0,1:04:14.30,1:04:16.46,Default,,0,0,0,,Kenapa kamu bertanya padaku?
Dialogue: 0,1:04:17.68,1:04:20.16,Default,,0,0,0,,Jangan melampiaskan amarahmu padaku...
Dialog: 0,1:04:20.18,1:04:22.97,Default,,0,0,0,,karena tidak dicintai oleh suamimu.
Dialogue: 0,1:04:30.40,1:04:33.59,Default,,0,0,0,,Seharusnya kamu menikah saja dengan Yoon Eun-sung.
Dialogue: 0,1:04:33.61,1:04:35.47,Default,,0,0,0,,Kenapa kamu tiba-tiba mengungkitnya?
Dialogue: 0,1:04:35.49,1:04:38.36,Default,,0,0,0,,Kamu tidak tahu apa-apa kan?
Dialogue: 0,1:04:38.41,1:04:40.72,Default,,0,0,0,,Dia tangan kanan Pak Hermann.
Dialogue: 0,1:04:40.75,1:04:44.07,Default,,0,0,0,,Dia kunci untuk menghubungi Pak Hermann.
Dialog: 0,1:04:44.54,1:04:46.08,Default,,0,0,0,,Apa?
Dialog: 0,1:04:46.13,1:04:49.23,Default,,0,0,0,,Hei, dia menjadi sangat sukses.
Dialog: 0,1:04:49.26,1:04:51.79,Default,,0,0,0,,Dia bukan orang yang sama dari kampus.
Dialogue: 0,1:04:52.09,1:04:55.09,Default,,0,0,0,,Dia bertugas mengatur keuangan\Nsyeikh sekarang.
Dialog: 0,1:04:55.64,1:04:58.67,Default,,0,0,0,,Itulah sebabnya aku pergi menyambutnya di bandara.
Dialog: 0,1:04:58.85,1:05:00.55,Default,,0,0,0,,Eun-sung.
Dialog: 0,1:05:14.16,1:05:15.90,Default,,0,0,0,,Sudah lama tidak bertemu.
Dialogue: 0,1:05:19.08,1:05:23.11,Default,,0,0,0,,Kamu seharusnya memberitahuku\Njika kamu kembali ke Korea.
Dialogue: 0,1:05:24.67,1:05:27.95,Default,,0,0,0,,Apakah kamu tidak ingat\Nhal terakhir yang kamu katakan padaku?
Dialog: 0,1:05:28.04,1:05:29.83,Default,,0,0,0,,Untuk tidak menghubungi Anda.
Dialog: 0,1:05:30.80,1:05:33.00,Default,,0,0,0,,- Benar?\N- Ya.
Dialog: 0,1:05:33.17,1:05:34.86,Default,,0,0,0,,Saya meragukannya.
Dialog: 0,1:05:34.88,1:05:38.55,Default,,0,0,0,,"Mari terus berhubungan."
Dialog: 0,1:05:38.85,1:05:40.63,Default,,0,0,0,,Bukankah itu yang kubilang?
Dialog: 0,1:05:47.94,1:05:51.96,Default,,0,0,0,,Kamu benar. Sudah kubilang jangan\Nuntuk menghubungiku lagi,
Dialog: 0,1:05:51.98,1:05:54.39,Default,,0,0,0,,karena kamu terus melewati batas.
Dialog: 0,1:05:55.49,1:05:58.11,Default,,0,0,0,,Benar, tapi sekarang...
Dialog: 0,1:05:58.32,1:06:01.03,Default,,0,0,0,,sepertinya ada yang ingin Anda katakan.
Dialog: 0,1:06:02.04,1:06:04.40,Default,,0,0,0,,Saya yakin Anda sudah mengetahui ini,
Dialogue: 0,1:06:05.21,1:06:06.35,Default,,0,0,0,,jadi saya ucapkan saja.
Dialog: 0,1:06:06.37,1:06:08.89,Default,,0,0,0,,Ye-na dan aku berada dalam kompetisi brutal...
Dialog: 0,1:06:08.92,1:06:10.98,Default,,0,0,0,,untuk membawa Hercyna ke toko kami.
Dialog: 0,1:06:11.00,1:06:15.07,Default,,0,0,0,,Sepertinya Anda memiliki hubungan yang baik\N dengan Pak Hermann,
Dialog: 0,1:06:15.09,1:06:16.63,Default,,0,0,0,,jadi beritahu aku.
Dialog: 0,1:06:16.68,1:06:19.38,Default,,0,0,0,,- Bisakah Anda membantu saya?\N- Saya?
Dialog: 0,1:06:22.38,1:06:23.91,Default,,0,0,0,,Mengapa?
Dialog: 0,1:06:24.14,1:06:28.10,Default,,0,0,0,,Sejujurnya, saya tidak ingat banyak tentang masa lalu,
Dialog: 0,1:06:28.35,1:06:32.67,Default,,0,0,0,,jadi kenapa kita tidak bilang saja kita putus...
Dialog: 0,1:06:32.69,1:06:34.56,Default,,0,0,0,,hubungan baik?
Dialog: 0,1:06:57.68,1:07:01.00,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kapan uji cobanya akan berakhir? Apakah ini hampir berakhir?{\c}{\i0}
Dialog: 0,1:07:44.47,1:07:46.87,Default,,0,0,0,,- Bagaimana dengan uji cobanya?\N- Saya menang.
Dialog: 0,1:07:46.89,1:07:49.38,Default,,0,0,0,,Saya menang cepat datang ke sini.
Dialog: 0,1:08:41.57,1:08:43.31,Default,,0,0,0,,Ini dia.
Dialog: 0,1:08:47.99,1:08:50.57,Default,,0,0,0,,Tolong satu koktail non-alkohol.
Dialogue: 0,1:08:50.91,1:08:53.85,Default,,0,0,0,,Apa katamu menikah lagi?
Dialogue: 0,1:08:53.87,1:08:57.54,Default,,0,0,0,,Menemukan pasangan hidup yang tampak\Nke arah yang sama denganmu?
Dialog: 0,1:08:57.84,1:09:01.82,Default,,0,0,0,,Awalnya saya tidak mengerti, tapi\Nmelihat suami Anda memperjelasnya.
Dialog: 0,1:09:01.84,1:09:03.67,Default,,0,0,0,,Apa maksudmu?
Dialog: 0,1:09:03.72,1:09:05.42,Default,,0,0,0,,Anda lihat,
Dialog: 0,1:09:05.51,1:09:10.34,Default,,0,0,0,,Saya lebih suka melihat suami saya daripada di tempat lain.
Dialogue: 0,1:09:11.64,1:09:14.05,Default,,0,0,0,,Dia setampan itu.
Dialog: 0,1:09:14.48,1:09:16.01,Default,,0,0,0,,Ini dia.
Dialog: 0,1:09:23.65,1:09:25.80,Default,,0,0,0,,Sayang, apakah kamu sudah mencobanya?
Dialog: 0,1:09:25.82,1:09:28.48,Default,,0,0,0,,Ini benar-benar sesuatu.
Dialog: 0,1:09:29.12,1:09:30.89,Default,,0,0,0,,- Apakah kamu datang ke sini untuk makan?\N- Apa?
Dialog: 0,1:09:30.91,1:09:33.07,Default,,0,0,0,,Saya tidak ingin melihatnya.
Dialogue: 0,1:09:35.33,1:09:37.91,Default,,0,0,0,,Aku sedang membicarakan wajahmu.
Dialog: 0,1:09:38.13,1:09:39.83,Default,,0,0,0,,Pergi.
Dialog: 0,1:09:40.17,1:09:42.46,Default,,0,0,0,,Hati? Kamu kecil...!
Dialog: 0,1:09:50.06,1:09:51.76,Default,,0,0,0,,Di Sini.
Dialog: 0,1:09:52.60,1:09:54.55,Default,,0,0,0,,Terima kasih.
Dialog: 0,1:09:58.11,1:10:00.47,Default,,0,0,0,,Aku memikirkan Hae-in sesekali,
Dialog: 0,1:10:01.03,1:10:03.39,Default,,0,0,0,,jadi terasa aneh...
Dialog: 0,1:10:03.90,1:10:05.60,Default,,0,0,0,,untuk bertemu suaminya.
Dialog: 0,1:10:10.99,1:10:12.47,Default,,0,0,0,,Maaf?
Dialogue: 0,1:10:12.49,1:10:15.70,Default,,0,0,0,,Yah, Hae-in dan aku...
Dialog: 0,1:10:17.37,1:10:20.66,Default,,0,0,0,,memiliki hubungan yang baik di masa lalu.
Dialog: 0,1:10:23.92,1:10:25.53,Default,,0,0,0,,Hae-in bukan tipe...
Dialogue: 0,1:10:25.55,1:10:29.59,Default,,0,0,0,,yang mempunyai banyak hubungan baik\Nsemasa hidupnya.
Dialog: 0,1:10:30.22,1:10:32.13,Default,,0,0,0,,Itu cukup mengesankan.
Dialog: 0,1:10:33.85,1:10:35.55,Default,,0,0,0,,Sejujurnya,
Dialogue: 0,1:10:37.06,1:10:39.16,Default,,0,0,0,,Aku sangat menyukainya.
Dialog: 0,1:10:40.41,1:10:42.35,Default,,0,0,0,,Saya mengerti.
Dialog: 0,1:10:43.98,1:10:45.69,Default,,0,0,0,,Tidak mengganggumu?
Dialog: 0,1:10:46.03,1:10:47.21,Default,,0,0,0,,Maaf?
Dialog: 0,1:10:47.24,1:10:50.65,Default,,0,0,0,,Itu hanya berarti satu dari dua hal.
Dialogue: 0,1:10:50.82,1:10:54.36,Default,,0,0,0,,Kamu percaya sepenuhnya padanya,\Atau kamu tidak peduli.
Dialog: 0,1:10:56.12,1:10:57.70,Default,,0,0,0,,Apakah yang terakhir?
Dialog: 0,1:11:02.75,1:11:04.33,Default,,0,0,0,,Saya hanya bercanda.
Dialog: 0,1:11:09.80,1:11:11.28,Default,,0,0,0,,Tn. Yoon.
Dialog: 0,1:11:11.30,1:11:12.82,Default,,0,0,0,,Datang.
Dialog: 0,1:11:12.85,1:11:14.59,Default,,0,0,0,,Selamat tinggal.
Dialogue: 0,1:11:21.61,1:11:23.43,Default,,0,0,0,,Si brengsek itu.
Dialog: 0,1:11:26.82,1:11:28.52,Default,,0,0,0,,Bagaimana dia tahu?
Dialog: 0,1:11:31.57,1:11:33.32,Default,,0,0,0,,Saya tersinggung.
Dialog: 0,1:11:39.33,1:11:40.43,Default,,0,0,0,,Konyol sekali.
Dialogue: 0,1:11:40.46,1:11:43.79,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sejujurnya, aku sangat menyukainya.{\c}{\i0}
Dialog: 0,1:11:44.09,1:11:46.12,Default,,0,0,0,,Jika dia benar-benar...
Dialogue: 0,1:11:46.42,1:11:47.65,Default,,0,0,0,,sangat menyukainya,
Dialog: 0,1:11:47.67,1:11:50.40,Default,,0,0,0,,maka dia seharusnya bekerja keras dan menikahinya.
Dialogue: 0,1:11:50.43,1:11:53.34,Default,,0,0,0,,Maka dia akan menyelamatkan nyawaku.
Dialogue: 0,1:11:54.35,1:11:58.17,Default,,0,0,0,,Apa gunanya memberitahu\Naku tentang perasaannya sekarang?
Dialog: 0,1:11:58.98,1:12:01.43,Default,,0,0,0,,Apakah dia menggodaku, atau apa?
Dialogue: 0,1:12:07.57,1:12:09.81,Default,,0,0,0,,Dasar bajingan yang menyebalkan.
Dialog: 0,1:13:06.92,1:13:08.50,Default,,0,0,0,,Halo.
Dialog: 0,1:13:09.09,1:13:11.16,Default,,0,0,0,,- Kita bertemu lagi.\N- Halo.
Dialog: 0,1:13:11.67,1:13:15.79,Default,,0,0,0,,Astaga. Bukankah tempat ini penuh?
Dialog: 0,1:13:18.01,1:13:19.32,Default,,0,0,0,,Kamu benar.
Dialog: 0,1:13:19.35,1:13:22.99,Default,,0,0,0,,Lebih dari separuh orang-orang ini datang menemuinya.
Dialog: 0,1:13:23.02,1:13:25.35,Default,,0,0,0,,Mereka ingin bertemu dengannya.
Dialog: 0,1:13:27.65,1:13:31.75,Default,,0,0,0,,Apa yang dia lakukan?
Dialog: 0,1:13:31.78,1:13:33.38,Default,,0,0,0,,{\i1}Dia seorang taipan.{\i0}
Dialog: 0,1:13:33.40,1:13:35.40,Default,,0,0,0,,Bahkan orang terkaya dari Wall Street...
Dialog: 0,1:13:35.43,1:13:39.22,Default,,0,0,0,,meminjam uang minyak darinya.
Dialog: 0,1:13:39.24,1:13:41.72,Default,,0,0,0,,Bahkan Ketua Yeom sangat ingin bertemu dengannya.
Dialog: 0,1:13:41.75,1:13:45.02,Default,,0,0,0,,Soo-cheol juga mencoba bertemu dengannya,
Dialog: 0,1:13:45.04,1:13:46.52,Default,,0,0,0,,tapi itu tidak mudah.
Dialogue: 0,1:13:46.54,1:13:49.85,Default,,0,0,0,,Dan Yoon Eun-sung ini kuliah\Ndi perguruan tinggi yang sama dengan Hae-in?
Dialog: 0,1:13:49.88,1:13:51.83,Default,,0,0,0,,Ya.
Dialog: 0,1:13:51.88,1:13:55.78,Default,,0,0,0,,Aku tidak tahu harus berkata apa\Nkepadamu di saat seperti ini.
Dialogue: 0,1:13:55.80,1:13:57.07,Default,,0,0,0,,Kenapa kamu merasa tidak enak?
Dialog: 0,1:13:57.09,1:13:58.45,Default,,0,0,0,,Saya seharusnya memperkenalkan...
Dialog: 0,1:13:58.47,1:14:01.70,Default,,0,0,0,,seseorang seperti dia pada Nona Hong Hae-in.
Dialog: 0,1:14:01.72,1:14:04.45,Default,,0,0,0,,Apa yang bisa dia lakukan? Dia menggali kuburnya sendiri.
Dialogue: 0,1:14:04.48,1:14:07.50,Default,,0,0,0,,Tetap saja, aku menyesal tidak berusaha lebih keras.
Dialogue: 0,1:14:07.52,1:14:09.10,Default,,0,0,0,,Untuk melakukan apa?
Dialog: 0,1:14:16.24,1:14:18.88,Default,,0,0,0,,Saya pikir Anda salah.
Dialogue: 0,1:14:18.91,1:14:21.73,Default,,0,0,0,,Aku selalu bersyukur...
Dialogue: 0,1:14:22.29,1:14:24.89,Default,,0,0,0,,bahwa kamu tidak berusaha lebih keras.
Dialogue: 0,1:14:24.91,1:14:28.35,Default,,0,0,0,,Saya benar-benar berterima kasih karena Anda\Tidak memasukkan saya dari daftar Anda...
Dialog: 0,1:14:28.38,1:14:29.73,Default,,0,0,0,,calon nikah,
Dialog: 0,1:14:29.75,1:14:34.75,Default,,0,0,0,,jadi hindari rasa bersalah yang tidak berguna itu.
Dialog: 0,1:14:37.30,1:14:38.28,Default,,0,0,0,,Kenapa kamu menelepon?
Dialog: 0,1:14:38.30,1:14:39.82,Default,,0,0,0,,Anda mendengar kami.
Dialogue: 0,1:14:39.85,1:14:43.63,Default,,0,0,0,,Undang Yoon Eun-sung ke perburuan keluarga kita.
Dialog: 0,1:14:46.52,1:14:51.68,Default,,0,0,0,,Benar. Aku jamin\Ndia akan datang jika aku menyuruhnya,
Dialogue: 0,1:14:54.32,1:14:57.77,Default,,0,0,0,,tapi kenapa aku harus melakukan itu? Saya tidak punya alasan untuk itu.
Dialog: 0,1:14:59.78,1:15:01.48,Default,,0,0,0,,Saya akan menarik...
Dialog: 0,1:15:03.12,1:15:04.94,Default,,0,0,0,,gugatan.
Dialog: 0,1:15:34.73,1:15:36.31,Default,,0,0,0,,Hae-in.
Dialog: 0,1:17:03.24,1:17:05.68,Default,,0,0,0,,Berikut jumlah mangsa yang bisa kamu tangkap.
Dialog: 0,1:17:05.70,1:17:07.89,Default,,0,0,0,,Tidak ada batasan untuk burung murai dan burung gagak.
Dialog: 0,1:17:07.91,1:17:12.43,Default,,0,0,0,,Sedangkan untuk babi hutan, rusa air, dan burung pegar,\NAnda masing-masing dapat menangkap maksimal lima.
Dialog: 0,1:17:12.46,1:17:15.69,Default,,0,0,0,,Kecelakaan mungkin terjadi jika\Nkalian menghalangi,
Dialog: 0,1:17:15.71,1:17:18.02,Default,,0,0,0,,dan salah mengira satu sama lain sebagai binatang,
Dialogue: 0,1:17:18.05,1:17:21.41,Default,,0,0,0,,jadi pastikan kamu tetap mengikuti jalurmu.
Dialog: 0,1:17:21.72,1:17:24.69,Default,,0,0,0,,Kamu tidak boleh berburu babi hutan sendirian.
Dialog: 0,1:17:24.72,1:17:29.45,Default,,0,0,0,,Jangan bidik atau membelakangi mereka jika Anda sendirian.
Dialog: 0,1:17:29.47,1:17:30.78,Default,,0,0,0,,Bisakah kita membiarkan dia menggunakan senjata api?
Dialog: 0,1:17:30.81,1:17:31.87,Default,,0,0,0,,Seperti yang sudah Anda ketahui...
Dialog: 0,1:17:31.89,1:17:34.84,Default,,0,0,0,,Apa yang bisa kita lakukan? Dia memilih untuk membawanya.
Dialog: 0,1:17:34.94,1:17:37.14,Default,,0,0,0,,Bagaimana jika dia melakukan pembunuhan?
Dialogue: 0,1:17:41.28,1:17:43.80,Default,,0,0,0,,Lihat tampang mematikan itu.
Dialog: 0,1:17:43.82,1:17:45.42,Default,,0,0,0,,Dia seharusnya pergi...
Dialog: 0,1:17:45.45,1:17:48.78,Default,,0,0,0,,ke rumah sakit jiwa, bukan penjara.
Dialog: 0,1:17:49.37,1:17:50.51,Default,,0,0,0,,Ayo pergi.
Dialog: 0,1:17:50.54,1:17:52.70,Default,,0,0,0,,Bibi, kita harus pindah.
Dialog: 0,1:17:54.96,1:17:56.82,Default,,0,0,0,,Di sini.
Dialog: 0,1:18:00.00,1:18:02.37,Default,,0,0,0,,Jangan pegang senjata api seperti itu.
Dialog: 0,1:18:10.47,1:18:13.37,Default,,0,0,0,,Apakah saya berhasil? Saya tidak bisa melihat dengan baik.
Dialog: 0,1:18:13.39,1:18:14.70,Default,,0,0,0,,Ya, Ayah.
Dialog: 0,1:18:14.73,1:18:18.30,Default,,0,0,0,,Yang terbesar jatuh. Astaga.
Dialog: 0,1:18:18.40,1:18:20.72,Default,,0,0,0,,Aku juga melihatnya, Kakek. Astaga!
Dialog: 0,1:18:21.15,1:18:24.55,Default,,0,0,0,,Benarkah? Saya yakin saya juga melakukannya.
Dialogue: 0,1:18:24.57,1:18:26.23,Default,,0,0,0,,Ya.
Dialog: 0,1:18:27.78,1:18:29.44,Default,,0,0,0,,Apakah kamu benar-benar mengerti?
Dialog: 0,1:18:29.53,1:18:32.07,Default,,0,0,0,,Saya kira tidak ada satupun yang jatuh.
Dialog: 0,1:18:36.62,1:18:39.06,Default,,0,0,0,,Hyun-woo, apakah kamu penduduk asli Amerika,
Dialog: 0,1:18:39.08,1:18:41.65,Default,,0,0,0,,atau pemburu Mongolia?\NIApakah penglihatan Anda sehebat itu?
Dialog: 0,1:18:41.67,1:18:43.82,Default,,0,0,0,,Saya kira jatuh ke dalam hutan.
Dialogue: 0,1:18:43.84,1:18:46.87,Default,,0,0,0,,Aku akan beritahu orang-orang kita untuk mendapatkannya.
Dialogue: 0,1:18:47.30,1:18:50.45,Default,,0,0,0,,Bagaimana jika Hyun-woo pulang\dengan tangan hampa tahun ini juga?
Dialog: 0,1:18:50.47,1:18:52.05,Default,,0,0,0,,Benar.
Dialog: 0,1:18:52.14,1:18:53.45,Default,,0,0,0,,Dia benar.
Dialog: 0,1:18:53.47,1:18:58.47,Default,,0,0,0,,Kamu belum pernah menangkap apa pun dalam perburuan kami.
Dialog: 0,1:19:01.61,1:19:04.59,Default,,0,0,0,,Kami datang ke sini setiap tahun. Anda harus belajar.
Dialog: 0,1:19:04.61,1:19:06.96,Default,,0,0,0,,Apakah kamu takut dengan senjata?\NKamu bertugas di militer,
Dialog: 0,1:19:06.99,1:19:08.42,Default,,0,0,0,,jadi haruskah aku mengajarimu?
Dialog: 0,1:19:08.45,1:19:11.22,Default,,0,0,0,,Tidak apa-apa. Anda harus mengkhawatirkan diri sendiri.
Dialog: 0,1:19:11.24,1:19:14.65,Default,,0,0,0,,Saya sudah pandai. Itu sebabnya aku menawarkan untuk mengajarimu.
Dialog: 0,1:19:15.54,1:19:17.72,Default,,0,0,0,,Bagaimana denganmu? Apakah kamu baik-baik saja?
Dialog: 0,1:19:17.75,1:19:21.14,Default,,0,0,0,,Saya tidak yakin. Aku ragu aku bisa\Nmenyambut kalian semua.
Dialog: 0,1:19:21.17,1:19:23.95,Default,,0,0,0,,Dia rendah hati dalam segala hal.
Dialog: 0,1:19:24.09,1:19:25.40,Default,,0,0,0,,Benar.
Dialogue: 0,1:19:25.42,1:19:29.49,Default,,0,0,0,,Mari kita lihat siapa yang akan menangkap\Nburung pegar untuk sup {\i1}mandu{\i0} tahun ini.
Dialog: 0,1:19:29.51,1:19:31.29,Default,,0,0,0,,Mari kita mulai.
Dialog: 0,1:19:31.43,1:19:32.61,Default,,0,0,0,,Ayo pergi.
Dialog: 0,1:19:32.64,1:19:34.92,Default,,0,0,0,,- Ayo berangkat.\N- Baiklah.
Dialog: 0,1:19:50.91,1:19:53.02,Default,,0,0,0,,Tangkap sesuatu sekali saja.
Dialogue: 0,1:19:53.58,1:19:57.64,Default,,0,0,0,,Ada alasan kakekku\Nmembawa kita ke gunung ini...
Dialog: 0,1:19:57.66,1:19:59.31,Default,,0,0,0,,untuk berburu setiap tahun.
Dialog: 0,1:19:59.33,1:20:00.31,Default,,0,0,0,,Apa itu?
Dialog: 0,1:20:00.33,1:20:04.10,Default,,0,0,0,,Apakah dia ingin kita berpura-pura\Ndia berhasil menembak bebek,
Dialog: 0,1:20:04.13,1:20:05.79,Default,,0,0,0,,dan puji dia?
Dialog: 0,1:20:06.46,1:20:08.40,Default,,0,0,0,,Stamina penting saat berburu,
Dialog: 0,1:20:08.42,1:20:11.11,Default,,0,0,0,,namun penilaian cepat dan keputusan\N yang obyektif juga diperlukan,
Dialog: 0,1:20:11.13,1:20:14.66,Default,,0,0,0,,dan itu semua adalah keutamaan yang\Nharus dimiliki oleh mereka yang berbisnis.
Dialog: 0,1:20:14.68,1:20:16.57,Default,,0,0,0,,Itukah sebabnya kamu menangkap begitu banyak setiap tahun,
Dialog: 0,1:20:16.60,1:20:19.63,Default,,0,0,0,,untuk membuktikan kepadanya bahwa Anda\Na pengusaha wanita yang layak?
Dialog: 0,1:20:19.81,1:20:21.45,Default,,0,0,0,,Tentu saja,
Dialog: 0,1:20:21.48,1:20:24.93,Default,,0,0,0,,dan saya akan menangkap yang terbanyak tahun ini juga.
Dialog: 0,1:20:27.32,1:20:29.77,Default,,0,0,0,,Luangkan waktumu.
Dialog: 0,1:20:35.24,1:20:38.03,Default,,0,0,0,,Ya, sudah siap.
Dialogue: 0,1:20:39.91,1:20:42.07,Default,,0,0,0,,Dekat tengah...
Dialog: 0,1:20:42.33,1:20:43.39,Default,,0,0,0,,tentu saja.
Dialog: 0,1:20:43.42,1:20:45.52,Default,,0,0,0,,{\i1}{\c&HFFFF&}Habitat Babi Hutan{\c}{\i0}
Dialog: 0,1:20:45.54,1:20:47.38,Default,,0,0,0,,{\i1}{\c&HFFFF&}Area Terlarang\NProperti Milik Ratu{\c}{\i0}
Dialogue: 0,1:21:07.19,1:21:10.18,Default,,0,0,0,,Di mana dia berada?
Dialog: 0,1:21:10.69,1:21:12.21,Default,,0,0,0,,{\i1}Panggilan Anda tidak dapat tersambung.{\i0}
Dialog: 0,1:21:12.24,1:21:13.94,Default,,0,0,0,,Sialan.
Dialog: 0,1:21:39.35,1:21:42.80,Default,,0,0,0,,Maaf. Saya pikir kamu adalah seekor rusa air.
Dialog: 0,1:21:43.27,1:21:45.18,Default,,0,0,0,,Mengapa kamu ada di sini?
Dialog: 0,1:21:45.31,1:21:47.43,Default,,0,0,0,,Ini bukan kursusmu.
Dialog: 0,1:21:47.90,1:21:50.89,Default,,0,0,0,,Bukan? Ini pertama kalinya aku berburu.
Dialog: 0,1:21:51.28,1:21:55.98,Default,,0,0,0,,Tahukah kamu bahwa menyerang\Nwilayah orang lain saat berburu bisa berakibat fatal?
Dialog: 0,1:21:59.08,1:22:00.82,Default,,0,0,0,,Saya tidak mengetahuinya.
Dialog: 0,1:22:01.24,1:22:04.70,Default,,0,0,0,,Saya berharap dapat belajar lebih banyak dari Anda.
Dialog: 0,1:22:20.14,1:22:23.17,Default,,0,0,0,,Kamu tidak boleh melakukan apa pun\Ndi wilayah orang lain.
Dialog: 0,1:22:24.77,1:22:27.72,Default,,0,0,0,,Kamu ingin aku mengajarimu, bukan?
Dialog: 0,1:22:50.92,1:22:52.95,Default,,0,0,0,,Ada apa denganku?
Dialogue: 0,1:22:54.38,1:22:56.25,Default,,0,0,0,,Itu hanya {\i1}mandu.{\i0}
Dialog: 0,1:22:56.47,1:22:57.94,Default,,0,0,0,,Itu hanya sup burung pegar.
Dialogue: 0,1:22:57.97,1:22:59.96,Default,,0,0,0,,Itu burung pegar {\i1}mandu.{\i0}
Dialog: 0,1:23:00.64,1:23:02.84,Default,,0,0,0,,Sup burung pegar.
Dialog: 0,1:24:08.37,1:24:12.12,Default,,0,0,0,,Jangan membodohi diri sendiri. Ini tidak nyata.
Dialog: 0,1:24:12.17,1:24:14.12,Default,,0,0,0,,Keluar dari situ, Hae-in.
Dialog: 0,1:24:15.17,1:24:17.25,Default,,0,0,0,,Keluar dari sana.
Dialog: 0,1:24:39.03,1:24:40.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana menurutmu?{\c}{\i0}
Dialog: 0,1:24:45.99,1:24:49.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku sekarat. Aku punya waktu tiga bulan lagi.{\c}{\i0}
Dialog: 0,1:24:50.41,1:24:52.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku mencintaimu, Hong Hae-in.{\c}{\i0}
Dialog: 0,1:24:53.12,1:24:54.99,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku cinta kamu.{\c}{\i0}
Dialog: 0,1:25:28.91,1:25:30.49,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,1:25:51.93,1:25:54.75,Default,,0,0,0,,Anda menolak berkencan dengan\NPNS atau guru musik itu.
Dialog: 0,1:25:54.77,1:25:56.62,Default,,0,0,0,,Kenapa kamu tiba-tiba menginginkan ibu rumah tangga?
Dialogue: 0,1:25:56.65,1:25:59.38,Default,,0,0,0,,Bukankah kamu bilang bahwa pekerja magang\Nakan segera dipecat?
Dialogue: 0,1:25:59.40,1:26:00.75,Default,,0,0,0,,Seseorang yang menganggur?
Dialogue: 0,1:26:00.78,1:26:04.66,Default,,0,0,0,,Saya tidak ingin menekan Anda, tapi bagaimana\NAnda bisa menabung uang untuk membeli rumah?
Dialog: 0,1:26:04.68,1:26:05.71,Default,,0,0,0,,Saya setuju.
Dialog: 0,1:26:05.74,1:26:09.09,Default,,0,0,0,,Saya tidak menyangka akan ada menantu yang kaya...
Dialog: 0,1:26:09.12,1:26:11.43,Default,,0,0,0,,hanya karena kamu belajar hukum di SNU.
Dialog: 0,1:26:11.45,1:26:12.89,Default,,0,0,0,,Saya hanya berharap...
Dialog: 0,1:26:12.91,1:26:15.18,Default,,0,0,0,,dia tidak akan lebih miskin dari kita. Itu saja.
Dialog: 0,1:26:15.21,1:26:18.45,Default,,0,0,0,,- Tepat sekali.\N- Aku belum pernah merasa seperti ini sebelumnya.
Dialog: 0,1:26:21.50,1:26:23.41,Default,,0,0,0,,Dia selalu...
Dialog: 0,1:26:24.26,1:26:26.04,Default,,0,0,0,,di pikiranku.
Dialog: 0,1:26:26.47,1:26:29.32,Default,,0,0,0,,Aku penasaran kenapa bajunya\Selalu berlubang.
Dialogue: 0,1:26:29.35,1:26:32.53,Default,,0,0,0,,Aku khawatir dia akan\Ngoyah.
Dialogue: 0,1:26:32.56,1:26:35.04,Default,,0,0,0,,Aku khawatir dia akan dimarahi lagi.
Dialog: 0,1:26:35.06,1:26:37.00,Default,,0,0,0,,Aku memikirkannya saat aku makan makanan enak.
Dialog: 0,1:26:37.02,1:26:39.14,Default,,0,0,0,,Aku ingin membawakannya beberapa.
Dialogue: 0,1:26:39.27,1:26:40.97,Default,,0,0,0,,Aku sangat terganggu...
Dialog: 0,1:26:41.69,1:26:44.18,Default,,0,0,0,,karena dia.
Dialog: 0,1:26:44.74,1:26:46.60,Default,,0,0,0,,Dia akan menjadi kematianku.
Dialog: 0,1:26:50.95,1:26:52.99,Default,,0,0,0,,Kalau begitu nikahi dia.
Dialog: 0,1:26:53.33,1:26:54.97,Default,,0,0,0,,- Sayang.\N- Ibu.
Dialogue: 0,1:26:55.00,1:26:57.10,Default,,0,0,0,,Nikahi dia jika itu serius.
Dialogue: 0,1:26:57.12,1:26:58.93,Default,,0,0,0,,Lebih baik daripada mati.
Dialog: 0,1:26:58.96,1:27:02.37,Default,,0,0,0,,Ya, itu benar, tapi...
Dialog: 0,1:27:03.88,1:27:06.62,Default,,0,0,0,,Ya, saya akan melakukannya.
Dialog: 0,1:27:10.22,1:27:12.42,Default,,0,0,0,,Kita akan menikah,
Dialog: 0,1:27:15.18,1:27:17.59,Default,,0,0,0,,dan aku akan melindunginya selamanya.
Dialog: 0,1:27:24.82,1:27:27.65,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialogue: 0,1:27:54.97,1:27:57.95,Default,,0,0,0,,{\an8}{\i1}Apakah ada wanita yang hatinya masih berdebar kencang...{\i0}
Dialog: 0,1:27:57.98,1:28:00.29,Default,,0,0,0,,{\an8}{\i1}ketika mereka melihat suaminya,\Nmeskipun sudah menikah...{\i0}
Dialog: 0,1:28:00.31,1:28:02.55,Default,,0,0,0,,{\an8}{\i1}selama lebih dari tiga tahun?{\i0}
Dialog: 0,1:28:02.90,1:28:04.17,Default,,0,0,0,,{\an8}{\i1}Tidak mungkin.{\i0}
Dialogue: 0,1:28:04.19,1:28:06.63,Default,,0,0,0,,{\an8}{\i1}Saya lihat pagarnya dibuka paksa.{\i0}
Dialogue: 0,1:28:06.65,1:28:09.30,Default,,0,0,0,,{\an8}{\i1}Kamu benar-benar yakin dia mencintaimu.{\i0}
Dialogue: 0,1:28:09.32,1:28:11.36,Default,,0,0,0,,{\an8}{\i1}Ya, benar.{\i0}
Dialogue: 0,1:28:11.70,1:28:16.64,Default,,0,0,0,,{\an8}{\i1}Aku belum pernah sebal ini\Ndengan senyuman seseorang.{\i0}
Dialog: 0,1:28:16.66,1:28:18.10,Default,,0,0,0,,{\an8}{\i1}Aku akan membunuh...{\i0}
Dialog: 0,1:28:18.12,1:28:20.43,Default,,0,0,0,,{\an8}{\i1}setiap bajingan yang mengkhianati...{\i0}
Dialog: 0,1:28:20.46,1:28:23.03,Default,,0,0,0,,{\an8}{\i1}dan menusukku dari belakang.{\i0}
Dialog: 0,1:28:23.25,1:28:25.45,Default,,0,0,0,,{\an8}{\i1}Jangan takut.{\i0}
Dialogue: 0,1:28:26.67,1:28:27.94,Default,,0,0,0,,{\an8}{\i1}Itu karena aku takut.{\i0}
Dialogue: 0,1:28:27.96,1:28:30.83,Default,,0,0,0,,{\an8}{\i1}Itulah sebabnya jantungku berdebar kencang.{\i0}
