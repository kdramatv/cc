Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.56,0:01:04.48,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 4{\c}{\i0}
Dialog: 0,0:01:07.48,0:01:10.26,Lalai,,0,0,0,,{\an8}En. Oh, awak dah pergi? awak kat mana?
Dialog: 0,0:01:10.90,0:01:13.85, Lalai,,0,0,0,,{\an8}Apa? Ini dia.
Dialog: 0,0:01:18.53,0:01:20.90, Lalai,,0,0,0,,{\an8}Ia ada di dalam poket saya.
Dialog: 0,0:01:23.62,0:01:25.32, Lalai,,0,0,0,,{\an8}Apa?
Dialog: 0,0:01:28.50,0:01:30.85, Lalai,,0,0,0,,{\an8}Hae-in, tunggu.
Dialog: 0,0:01:30.88,0:01:32.10, Lalai,,0,0,0,,{\an8}Tunggu.
Dialog: 0,0:01:32.13,0:01:33.61, Lalai,,0,0,0,,{\an8}Tunggu.
Dialog: 0,0:01:33.63,0:01:35.33, Lalai,,0,0,0,,{\an8}Tunggu!
Dialog: 0,0:01:43.85,0:01:45.55, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:01:46.35,0:01:48.00, Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,0:01:48.02,0:01:50.72,Lalai,,0,0,0,,Apakah saya...
Dialog: 0,0:01:52.40,0:01:54.14, Lalai,,0,0,0,, lakukan sekarang?
Dialog: 0,0:01:54.98,0:01:56.98,Lalai,,0,0,0,,Saya gembira...
Dialog: 0,0:01:57.15,0:02:00.36, Lalai,,0,0,0,,anda menjumpai telefon anda.
Dialog: 0,0:02:01.41,0:02:04.69, Lalai,,0,0,0,,Mungkin sukar untuk mendapatkannya.
Dialog: 0,0:02:11.58,0:02:13.29, Lalai,,0,0,0,,Mengapa saya tidak...
Dialog: 0,0:02:17.80,0:02:19.63, Lalai,,0,0,0,, yakin?
Dialog: 0,0:02:19.93,0:02:21.75, Lalai,,0,0,0,,Apa?
Dialog: 0,0:02:22.60,0:02:24.59, Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:02:27.10,0:02:29.05, Lalai,,0,0,0,, Betul.
Dialog: 0,0:02:33.77,0:02:35.77, Lalai,,0,0,0,,Saya dah cakap, kan?
Dialog: 0,0:02:37.74,0:02:39.44, Lalai,,0,0,0,,Saya akan mulakan...
Dialog: 0,0:02:40.07,0:02:42.44, Lalai,,0,0,0,,mencuba perkara baharu.
Dialog: 0,0:04:32.31,0:04:34.01, Lalai,,0,0,0,,Selamat malam.
Dialog: 0,0:04:35.19,0:04:37.76, Lalai,,0,0,0,,Betul. selamat malam.
Dialog: 0,0:04:45.61,0:04:47.40, Lalai,,0,0,0,,Adakah anda akan tidur?
Dialog: 0,0:05:02.42,0:05:04.12,Lalai,,0,0,0,,Nah,
Dialog: 0,0:05:05.22,0:05:06.79, Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,0:05:21.61,0:05:24.23, Lalai,,0,0,0,,Ia akan dicas semula dalam masa yang singkat.
Dialog: 0,0:05:24.28,0:05:25.98, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:05:26.15,0:05:28.17, Lalai,,0,0,0,,Dia boleh sahaja berkata...
Dialog: 0,0:05:28.20,0:05:29.98, Lalai,,0,0,0,,dia mahu masuk.
Dialog: 0,0:05:33.04,0:05:35.24, Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:06:31.39,0:06:33.13, Lalai,,0,0,0,,Hari lahir Hae-in?
Dialog: 0,0:06:33.35,0:06:35.84, Lalai,,0,0,0,,Hari kedai serbaneka itu diketahui umum.
Dialog: 0,0:06:37.64,0:06:39.47, Lalai,,0,0,0,,Hari lahir saya?
Dialog: 0,0:06:41.77,0:06:44.31, Lalai,,0,0,0,,Ia tidak boleh menjadi ulang tahun perkahwinan kami.
Dialog: 0,0:06:44.65,0:06:45.88, Lalai,,0,0,0,, Kelab Satu Bilion?
Dialog: 0,0:06:45.90,0:06:46.92,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Cuba lagi dalam 30 saat{\c}{\i0}
Dialog: 0,0:06:46.94,0:06:48.89, Lalai,,0,0,0,, Sial.
Dialog: 0,0:07:18.98,0:07:20.68, Lalai,,0,0,0,,Jangan beritahu saya...
Dialog: 0,0:07:28.40,0:07:30.48, Lalai,,0,0,0,,Ini 1031?
Dialog: 0,0:07:34.82,0:07:36.24, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}9 Mesej Belum Dibaca{\c}{\i0}
Dialog: 0,0:07:39.31,0:07:40.41,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Padam{\c}{\i0}
Dialog: 0,0:07:40.44,0:07:41.43, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}8 Mesej Belum Dibaca{\c}{\i0}
Dialog: 0,0:07:41.46,0:07:43.03, Lalai,,0,0,0,,Baiklah, selesai.
Dialog: 0,0:07:43.21,0:07:44.91, Lalai,,0,0,0,,Ya ampun.
Dialog: 0,0:07:46.13,0:07:48.41, Lalai,,0,0,0,, Awak mengejutkan saya.
Dialog: 0,0:07:53.38,0:07:55.50,Lalai,,0,0,0,,Apa awak...
Dialog: 0,0:07:57.81,0:07:59.51, Lalai,,0,0,0,, lakukan di sini?
Dialog: 0,0:08:00.22,0:08:01.93, Lalai,,0,0,0,,Nah...
Dialog: 0,0:08:04.56,0:08:06.43, Lalai,,0,0,0,,Saya tidak boleh tidur, jadi...
Dialog: 0,0:08:09.36,0:08:11.31, Lalai,,0,0,0,,Anda tidak boleh...
Dialog: 0,0:08:11.82,0:08:13.56, Lalai,,0,0,0,,tidur,
Dialog: 0,0:08:17.37,0:08:19.61, Lalai,,0,0,0,,jadi awak datang ke bilik saya?
Dialog: 0,0:08:26.08,0:08:27.95, Lalai,,0,0,0,,Jadi...
Dialog: 0,0:08:28.79,0:08:30.75, Lalai,,0,0,0,, kerana saya?
Dialog: 0,0:08:31.92,0:08:35.25, Lalai,,0,0,0,,Awak tak boleh tidur sebab saya?
Dialog: 0,0:08:41.89,0:08:44.20, Lalai,,0,0,0,,Bukan itu.
Dialog: 0,0:08:44.23,0:08:47.72,Lalai,,0,0,0,,Bukan begitu. saya cuma...
Dialog: 0,0:08:47.94,0:08:49.75, Lalai,,0,0,0,,Saya tidak boleh tidur,
Dialog: 0,0:08:49.77,0:08:51.04, Lalai,,0,0,0,,tanpa sebab tertentu,
Dialog: 0,0:08:51.07,0:08:57.11, Lalai,,0,0,0,,jadi saya datang untuk melihat sama ada anda merasakan perkara yang sama,
Dialog: 0,0:08:58.45,0:08:59.72, Lalai,,0,0,0,,dan...
Dialog: 0,0:08:59.74,0:09:02.11, Lalai,,0,0,0,,jika anda mahu bercakap.
Dialog: 0,0:09:03.62,0:09:05.82,Lalai,,0,0,0,,Tetapi awak terlalu penat, kan?
Dialog: 0,0:09:06.54,0:09:08.49,Lalai,,0,0,0,,Saya agak letih,
Dialog: 0,0:09:09.00,0:09:12.00, Lalai,,0,0,0,,tetapi mari kita lakukannya. Jom bincang.
Dialog: 0,0:09:13.84,0:09:15.54, Lalai,,0,0,0,, Jadi di mana?
Dialog: 0,0:09:15.80,0:09:16.90, Lalai,,0,0,0,, Patutkah kita duduk di sini?
Dialog: 0,0:09:16.93,0:09:18.74, Lalai,,0,0,0,,Anda penat.
Dialog: 0,0:09:18.76,0:09:21.13, Lalai,,0,0,0,,Saya rasa saya fikir...
Dialog: 0,0:09:21.47,0:09:23.16,Lalai,,0,0,0,,hanya untuk diri saya sendiri.
Dialog: 0,0:09:23.18,0:09:25.99, Lalai,,0,0,0,,Anda telah minum sedikit, dan sudah agak lewat.
Dialog: 0,0:09:26.02,0:09:27.25, Lalai,,0,0,0,,Itu benar, tetapi...
Dialog: 0,0:09:27.27,0:09:29.29,Lalai,,0,0,0,,Jadi awak penat.
Dialog: 0,0:09:29.31,0:09:31.83,Lalai,,0,0,0,,Saya rasa saya sudah sedar\Nup sedikit. Jom duduk.
Dialog: 0,0:09:31.86,0:09:34.23, Lalai,,0,0,0,,No. jangan duduk.
Dialog: 0,0:09:34.78,0:09:39.06, Lalai,,0,0,0,,Saya tidak fikir.
Dialog: 0,0:09:40.41,0:09:42.11, Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,0:09:42.20,0:09:45.95,Lalai,,0,0,0,,Banyak yang perlu anda lakukan esok. Awak patut berehat.
Dialog: 0,0:09:47.21,0:09:49.27, Lalai,,0,0,0,,Selamat tidur malam.
Dialog: 0,0:09:49.29,0:09:51.29, Lalai,,0,0,0,, Baring.
Dialog: 0,0:09:59.34,0:10:01.34,Lalai,,0,0,0,,Dia peduli...
Dialog: 0,0:10:04.27,0:10:06.30, Lalai,,0,0,0,, begitu banyak untuk saya.
Dialog: 0,0:10:13.82,0:10:16.23, Lalai,,0,0,0,,Itu sangat hampir.
Dialog: 0,0:10:40.01,0:10:41.71, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak mungkin...{\c}{\i0}
Dialog: 0,0:10:47.22,0:10:49.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini 1031?{\c}{\i0}
Dialog: 0,0:10:51.77,0:10:54.81, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tahniah. Anda hamil empat minggu.{\c}{\i0}
Dialog: 0,0:10:57.99,0:10:59.67, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nah...{\c}{\i0}
Dialog: 0,0:10:59.70,0:11:02.40, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Empat minggu...{\c}{\i0}
Dialog: 0,0:11:02.70,0:11:05.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemudian bilakah bayi itu akan dilahirkan?{\c}{\i0}
Dialog: 0,0:11:05.58,0:11:08.85, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia akan tiba pada 31 Oktober.{\c}{\i0}
Dialog: 0,0:11:08.87,0:11:12.99, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya faham. 31 Oktober.{\c}{\i0}
Dialog: 0,0:11:13.92,0:11:15.60, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu tarikh yang baik.{\c}{\i0}
Dialog: 0,0:11:15.63,0:11:17.66, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}31 Oktober.{\c}{\i0}
Dialog: 0,0:11:33.90,0:11:37.13, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sila gunakan bahan dalaman eko-\Nmesra berkualiti tinggi.{\c}{\i0}
Dialog: 0,0:11:37.15,0:11:40.81, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul. Saya dengar benda itu\Na mesti untuk bilik bayi.{\c}{\i0}
Dialog: 0,0:12:20.11,0:12:21.80, Lalai,,0,0,0,,Saya sepatutnya...
Dialog: 0,0:12:21.82,0:12:23.92, Lalai,,0,0,0,,Bagaimana anda boleh pergi ke sana?
Dialog: 0,0:12:23.95,0:12:26.93,Lalai,,0,0,0,,Maksud saya, kami tidak pernah berjumpa dengannya\Nsejak mereka berkahwin,
Dialog: 0,0:12:26.95,0:12:31.19,Lalai,,0,0,0,,- tetapi mereka tiba-tiba menyebut tentang perceraian, jadi...\N- Ibu, saya cuba menghalangnya.
Dialog: 0,0:12:31.29,0:12:32.99, Lalai,,0,0,0,,Dan awak pergi dengan dia?
Dialog: 0,0:12:34.17,0:12:35.60, Lalai,,0,0,0,, Bagaimanapun, apa yang dia katakan?
Dialog: 0,0:12:35.62,0:12:37.85, Lalai,,0,0,0,,Dia tidak tahu.
Dialog: 0,0:12:37.88,0:12:40.51,Lalai,,0,0,0,,- Ya.\N- Hanya Hyun-woo yang memikirkan untuk bercerai.
Dialog: 0,0:12:40.53,0:12:41.52,Lalai,,0,0,0,,Betulkah?
Dialog: 0,0:12:41.55,0:12:44.57,Lalai,,0,0,0,,Dan dia berkata dia akan datang melawat kami tidak lama lagi.
Dialog: 0,0:12:44.59,0:12:46.29,Lalai,,0,0,0,,- Dan Ayah.\N- Ya?
Dialog: 0,0:12:47.85,0:12:51.30, Lalai,,0,0,0,,Saya akhirnya menambahkannya pada apl messenger saya!
Dialog: 0,0:12:52.93,0:12:55.00,Lalai,,0,0,0,,Tetapi bagaimana dengan Hyun-woo?
Dialog: 0,0:12:55.02,0:12:57.25, Lalai,,0,0,0,,Dia cakap dia takkan ceraikan dia.
Dialog: 0,0:12:57.27,0:12:58.79, Lalai,,0,0,0,,Mereka berjalan lancar. jangan risau.
Dialog: 0,0:12:58.81,0:13:01.04, Lalai,,0,0,0,,- Itu melegakan.\N- Tidak!
Dialog: 0,0:13:01.07,0:13:05.17,Lalai,,0,0,0,,Dia sedang mempertimbangkan untuk bercerai\Nsementara isterinya tidak tahu.
Dialog: 0,0:13:05.20,0:13:06.84, Lalai,,0,0,0,,Anda rasa mereka berjalan dengan baik?
Dialog: 0,0:13:06.86,0:13:09.98, Lalai,,0,0,0,,Masing-masing tidak tahu perasaan yang lain.
Dialog: 0,0:13:14.79,0:13:16.70, Lalai,,0,0,0,,Jemput saya dalam sembang.
Dialog: 0,0:13:17.37,0:13:20.62, Lalai,,0,0,0,,Saya tidak akan bercakap banyak atau menghantar foto.
Dialog: 0,0:13:36.14,0:13:40.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kini kami akan mengambil gambar\Nahli keluarga dan saudara mara.{\c}{\i0}
Dialog: 0,0:13:43.48,0:13:45.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik. Kim.{\c}{\i0}
Dialog: 0,0:13:45.95,0:13:47.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya?{\c}{\i0}
Dialog: 0,0:13:48.41,0:13:49.93,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tahu...{\c}{\i0}
Dialog: 0,0:13:49.95,0:13:54.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anda tidak suka Hyun-woo sebagai menantu anda.{\c}{\i0}
Dialog: 0,0:13:54.58,0:13:57.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak pasti sama ada saya perlu mengatakan ini,{\c}{\i0}
Dialog: 0,0:13:57.12,0:14:00.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi apabila Hyun-woo memberitahu kami dia sedang berjumpa seseorang,{\c}{\i0}
Dialog: 0,0:14:00.75,0:14:04.36,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dia berkata gadis itu mungkin akan dipecat\Nand akan menganggur tidak lama lagi,{\c}{\i0}
Dialog: 0,0:14:04.38,0:14:07.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi dia perlu menyediakan\Nuntuknya jika dia berkahwin dengannya.{\c}{\i0}
Dialog: 0,0:14:07.72,0:14:12.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemudian keluarga kami berkata\Ndia boleh mencari gadis yang lebih baik,{\c}{\i0}
Dialog: 0,0:14:12.10,0:14:14.62, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan dia terlalu miskin.{\c}{\i0}
Dialog: 0,0:14:14.64,0:14:18.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Malah keluarga seperti kami terlalu berkira.{\c}{\i0}
Dialog: 0,0:14:18.39,0:14:20.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak dapat bayangkan perasaan anda.{\c}{\i0}
Dialog: 0,0:14:20.35,0:14:25.04, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Terdapat perbezaan yang besar. Saya pasti\Nyou kecewa dan kecewa.{\c}{\i0}
Dialog: 0,0:14:25.07,0:14:28.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lagi pun kita semua manusia,{\c}{\i0}
Dialog: 0,0:14:28.24,0:14:29.55,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi...{\c}{\i0}
Dialog: 0,0:14:29.57,0:14:31.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya faham.{\c}{\i0}
Dialog: 0,0:14:31.62,0:14:35.61, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul. Saya gembira anda faham.{\c}{\i0}
Dialog: 0,0:14:36.08,0:14:37.18,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tahu...{\c}{\i0}
Dialog: 0,0:14:37.20,0:14:38.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anak saya banyak kekurangan,{\c}{\i0}
Dialog: 0,0:14:38.83,0:14:42.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi saya harap anda menjaga dia dengan baik.{\c}{\i0}
Dialog: 0,0:14:42.25,0:14:44.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia banyak kekurangan? Anda jelas tidak mengenali anak anda.{\c}{\i0}
Dialog: 0,0:14:44.92,0:14:47.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia berjaya mengahwini anak perempuan saya.{\c}{\i0}
Dialog: 0,0:14:47.17,0:14:49.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia benar-benar sesuatu.{\c}{\i0}
Dialog: 0,0:14:49.30,0:14:50.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Maaf?{\c}{\i0}
Dialog: 0,0:14:50.76,0:14:53.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini adalah pujian. Sebagai seorang peguam, dia sepatutnya...{\c}{\i0}
Dialog: 0,0:14:53.47,0:14:57.41, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}pandai mengira, praktikal,\Nand mengambil apa yang dia mahu.{\c}{\i0}
Dialog: 0,0:14:57.43,0:15:00.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa awak...?\N- Saya cakap dia bijak...{\c}{\i0}
Dialog: 0,0:15:00.31,0:15:02.43, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}bahawa dia tidak melepaskan peluang ini.{\c}{\i0}
Dialog: 0,0:15:03.61,0:15:06.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah yang anda maksudkan, "peluang ini"?{\c}{\i0}
Dialog: 0,0:15:06.36,0:15:08.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya pasti anda tahu.{\c}{\i0}
Dialog: 0,0:15:08.49,0:15:09.63, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul.{\c}{\i0}
Dialog: 0,0:15:09.65,0:15:12.13,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Walau apa pun yang anda maksudkan,{\c}{\i0}
Dialog: 0,0:15:12.16,0:15:15.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}ini perkahwinan antara anak-anak kita.{\c}{\i0}
Dialog: 0,0:15:15.24,0:15:16.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tahu itu.{\c}{\i0}
Dialog: 0,0:15:16.49,0:15:20.22, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tepat sekali. Saya cuma nak cakap ia bagus,{\c}{\i0}
Dialog: 0,0:15:20.25,0:15:23.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}sebagai ibu bapa mereka, jika kami boleh membantu mereka...{\c}{\i0}
Dialog: 0,0:15:23.75,0:15:26.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}memimpin perkahwinan yang bahagia. Itu sahaja.{\c}{\i0}
Dialog: 0,0:15:26.63,0:15:28.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika itu perkahwinan mereka,{\c}{\i0}
Dialog: 0,0:15:28.59,0:15:31.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}urusan mereka untuk menjalani kehidupan yang bahagia.{\c}{\i0}
Dialog: 0,0:15:31.55,0:15:34.13, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa kami perlu membantu?{\c}{\i0}
Dialog: 0,0:15:37.64,0:15:40.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Siapa dia untuk memberitahu saya apa yang perlu dilakukan?{\c}{\i0}
Dialog: 0,0:15:45.36,0:15:47.42,Lalai,,0,0,0,,{\i1}Perceraian atau tidak,{\i0}
Dialog: 0,0:15:47.44,0:15:49.56,Lalai,,0,0,0,,Saya sangat risau.
Dialog: 0,0:15:50.32,0:15:54.56,Lalai,,0,0,0,,Tolong jalani kehidupan yang baik, boleh?
Dialog: 0,0:15:54.87,0:15:56.57,Lalai,,0,0,0,,Shoo!
Dialog: 0,0:16:12.22,0:16:14.40,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan lupa minum\Jus Norange pada waktu pagi.{\c}{\i0}
Dialog: 0,0:16:14.43,0:16:16.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah penawar mabuk anda.{\c}{\i0}
Dialog: 0,0:16:19.43,0:16:21.16,Lalai,,0,0,0,,Bukankah itu terlalu sejuk?
Dialog: 0,0:16:21.18,0:16:23.83, Lalai,,0,0,0,,Mahu saya buatkan teh untuk awak?
Dialog: 0,0:16:23.85,0:16:25.66, Lalai,,0,0,0,,Sesuatu yang hangat adalah lebih baik.
Dialog: 0,0:16:25.69,0:16:27.43, Lalai,,0,0,0,,Saya baik.
Dialog: 0,0:16:28.65,0:16:30.35, Lalai,,0,0,0,,Tahan.
Dialog: 0,0:16:48.42,0:16:51.41,Lalai,,0,0,0,,Pastikan diri anda kelihatan rapi. Awak bukan budak.
Dialog: 0,0:17:10.15,0:17:12.52, Lalai,,0,0,0,,Ya ampun.
Dialog: 0,0:17:13.28,0:17:15.94,Default,,0,0,0,,Saya tertanya-tanya kenapa jantung saya berdebar-debar.
Dialog: 0,0:17:16.99,0:17:20.36, Lalai,,0,0,0,,Itu kerana saya takut. Itu sahaja.
Dialog: 0,0:17:20.45,0:17:23.36,Lalai,,0,0,0,,Itulah sebabnya jantung saya berdegup kencang.
Dialog: 0,0:17:47.14,0:17:50.93, Lalai,,0,0,0,,Apa pendapat anda? Saya memakai\Nini untuk mesyuarat malam ini.
Dialog: 0,0:17:57.70,0:17:59.40, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:18:00.32,0:18:03.03, Lalai,,0,0,0,,Ia adalah jaket vintaj Hercyna dari tahun 1982.
Dialog: 0,0:18:03.91,0:18:06.77,Lalai,,0,0,0,,- Adakah itu benar?\N- Terdapat hanya dua bahagian di dunia.
Dialog: 0,0:18:06.79,0:18:08.60,Lalai,,0,0,0,,Isteri CEO Hermann ada satu,
Dialog: 0,0:18:08.62,0:18:10.66, Lalai,,0,0,0,,dan yang satu lagi ialah yang ini.
Dialog: 0,0:18:15.30,0:18:17.00, Lalai,,0,0,0,,Anda tidak menyukainya?
Dialog: 0,0:18:18.59,0:18:20.29, Lalai,,0,0,0,,Bukan itu.
Dialog: 0,0:18:20.47,0:18:22.17,Lalai,,0,0,0,,Nah...
Dialog: 0,0:18:27.48,0:18:29.39, Lalai,,0,0,0,,Nampak baik.
Dialog: 0,0:18:41.91,0:18:43.86, Lalai,,0,0,0,,Kenapa dia nampak cantik?
Dialog: 0,0:18:44.87,0:18:46.57,Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:18:48.46,0:18:50.16, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:18:52.33,0:18:54.04, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:19:04.47,0:19:06.17,Lalai,,0,0,0,,Jom.
Dialog: 0,0:19:08.98,0:19:10.80, Lalai,,0,0,0,,Saya suka sut awak.
Dialog: 0,0:19:13.52,0:19:14.58, Lalai,,0,0,0,,Saman saya?
Dialog: 0,0:19:14.61,0:19:16.77, Lalai,,0,0,0,,Ya. awak nampak baik.
Dialog: 0,0:19:35.63,0:19:37.91,Lalai,,0,0,0,,Anda mesti berada dalam mood yang baik.
Dialog: 0,0:19:38.59,0:19:39.69, Lalai,,0,0,0,,Tidak, tidak juga.
Dialog: 0,0:19:39.72,0:19:41.75, Lalai,,0,0,0,,Tetapi anda sedang bersenandung.
Dialog: 0,0:19:42.43,0:19:44.59, Lalai,,0,0,0,,- Saya?\N- Ya.
Dialog: 0,0:19:49.43,0:19:51.55,Lalai,,0,0,0,,- Bila?\N- Tadi.
Dialog: 0,0:19:57.61,0:19:58.79,Lalai,,0,0,0,,Adakah anda teruja?
Dialog: 0,0:19:58.82,0:20:02.52,Lalai,,0,0,0,,Kerana dia memuji kamu?\NIItulah sebab kamu bersenandung?
Dialog: 0,0:20:02.57,0:20:04.65, Lalai,,0,0,0,,Aduh, adakah saya sudah gila?
Dialog: 0,0:20:05.28,0:20:09.11, Lalai,,0,0,0,,Mungkin saya ada, kerana dia sudah lama tidak memuji saya, atau...
Dialog: 0,0:20:17.71,0:20:20.71, Lalai,,0,0,0,,Tengok dia berkerut. Dia tidak berpuas hati dengan sesuatu.
Dialog: 0,0:20:21.47,0:20:23.07, Lalai,,0,0,0,,Dia akan melarat tidak lama lagi.
Dialog: 0,0:20:23.09,0:20:28.32, Lalai,,0,0,0,,Lima, empat, tiga, dua, satu.
Dialog: 0,0:20:28.35,0:20:31.37, Lalai,,0,0,0,,Apa yang berlaku dengan menghias\Nbilik pembeli peribadi seperti galeri?
Dialog: 0,0:20:31.39,0:20:33.87, Lalai,,0,0,0,,- Oh, tidak.\N- Reputasi dan warna artis...
Dialog: 0,0:20:33.89,0:20:36.12, Lalai,,0,0,0,,tidak sesuai dengan reka bentuk dalaman!
Dialog: 0,0:20:36.15,0:20:40.64, Lalai,,0,0,0,,Menjerit dan menjeling seperti\Nitu, dia kelihatan begitu jahat.
Dialog: 0,0:20:40.73,0:20:44.10, Lalai,,0,0,0,,Itulah sebabnya saya takut dan jantung saya berdegup kencang.
Dialog: 0,0:20:48.28,0:20:51.24, Lalai,,0,0,0,,Ya, inilah yang saya bincangkan!
Dialog: 0,0:20:51.45,0:20:53.97, Lalai,,0,0,0,,Apa yang berlaku? Dia teruja.
Dialog: 0,0:20:54.00,0:20:55.70, Lalai,,0,0,0,,Tidak teruk.
Dialog: 0,0:21:07.39,0:21:10.09, Lalai,,0,0,0,,Apa...? Apa salah saya?
Dialog: 0,0:21:11.14,0:21:12.84, Lalai,,0,0,0,,Mengapa saya tersenyum?
Dialog: 0,0:21:13.39,0:21:14.91, Lalai,,0,0,0,,Dapatkan cengkaman.
Dialog: 0,0:21:14.94,0:21:16.41,Lalai,,0,0,0,,{\i1}Hei, itu berbahaya.{\i0}
Dialog: 0,0:21:16.44,0:21:20.33, Lalai,,0,0,0,,Anda tahu bagaimana pelakon jatuh cinta pada\Nreal semasa merakam adegan romantis bersama.
Dialog: 0,0:21:20.36,0:21:22.25, Lalai,,0,0,0,,Seperti Hyun Bin dan Son Ye-jin.
Dialog: 0,0:21:22.28,0:21:23.75, Lalai,,0,0,0,,Bukan begitu.
Dialog: 0,0:21:23.78,0:21:27.02, Lalai,,0,0,0,,Namun anda membeli kasutnya?
Dialog: 0,0:21:31.08,0:21:32.51, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kebaikan.{\c}{\i0}
Dialog: 0,0:21:32.54,0:21:36.14, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Titik keseluruhan eskalator\Nis untuk mengelak daripada perlu berjalan ke atas.{\c}{\i0}
Dialog: 0,0:21:36.16,0:21:38.20, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia sangat tidak sabar.{\c}{\i0}
Dialog: 0,0:21:39.25,0:21:40.95, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak percaya dia.{\c}{\i0}
Dialog: 0,0:21:42.13,0:21:43.96, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Awas!{\c}{\i0}
Dialog: 0,0:21:51.60,0:21:53.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah seseorang baru sahaja menjerit?{\c}{\i0}
Dialog: 0,0:21:53.77,0:21:54.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya juga mendengarnya.{\c}{\i0}
Dialog: 0,0:21:54.89,0:21:57.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah jenis orang gila yang menjerit seperti itu di sini?{\c}{\i0}
Dialog: 0,0:22:06.57,0:22:08.13, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tuan?{\c}{\i0}
Dialog: 0,0:22:08.16,0:22:09.86, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Boleh saya bantu anda?{\c}{\i0}
Dialog: 0,0:22:10.78,0:22:12.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nah...{\c}{\i0}
Dialog: 0,0:22:13.74,0:22:17.11, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda mempunyai sepasang ini dalam saiz 6?{\c}{\i0}
Dialog: 0,0:22:17.58,0:22:20.24,Lalai,,0,0,0,,{\i1}Itulah sebabnya anda membeli kasut untuknya?{\i0}
Dialog: 0,0:22:20.54,0:22:22.81, Lalai,,0,0,0,,Dia tidak mengubah kehendaknya. Saya tak boleh biarkan dia...
Dialog: 0,0:22:22.84,0:22:25.06, Lalai,,0,0,0,,- jatuh dan mati.\N- Betul.
Dialog: 0,0:22:25.09,0:22:26.57, Lalai,,0,0,0,,- Jadi itulah sebabnya?\N- Sudah tentu.
Dialog: 0,0:22:26.59,0:22:27.82,Lalai,,0,0,0,,Saya pun terkejut...
Dialog: 0,0:22:27.84,0:22:30.53, Lalai,,0,0,0,,sehingga saya sangat berkira dan berhati dingin.
Dialog: 0,0:22:30.55,0:22:32.88, Lalai,,0,0,0,,Jadi apa yang dia katakan?
Dialog: 0,0:22:45.94,0:22:48.88, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi, anda membelinya kerana ia mendapat potongan 50%?{\c}{\i0}
Dialog: 0,0:22:48.90,0:22:50.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dan hari ini ialah hari terakhir.{\c}{\i0}
Dialog: 0,0:22:50.78,0:22:53.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tambahan, 6 ialah saiz yang popular,{\c}{\i0}
Dialog: 0,0:22:53.28,0:22:55.76, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan yang putih\Ndijual di seluruh negara.{\c}{\i0}
Dialog: 0,0:22:55.79,0:22:58.07, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kecuali pasangan ini.{\c}{\i0}
Dialog: 0,0:22:58.71,0:23:00.41, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya terpaksa membelinya.{\c}{\i0}
Dialog: 0,0:23:00.67,0:23:02.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya pasti anda melakukannya,{\c}{\i0}
Dialog: 0,0:23:02.75,0:23:05.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi almari kasut saya...{\c}{\i0}
Dialog: 0,0:23:05.13,0:23:08.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}penuh dengan kasut mahal\NI terpaksa membayar tambahan untuk membeli.{\c}{\i0}
Dialog: 0,0:23:08.72,0:23:12.57, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah saya akan memakai yang dibeli pada separuh harga?{\c}{\i0}
Dialog: 0,0:23:12.59,0:23:16.96,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sudah tentu saya tahu anda mempunyai banyak\Tidak mahal, kasut yang mewah,{\c}{\i0}
Dialog: 0,0:23:17.40,0:23:19.64, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi tiada satu pun yang selesa.{\c}{\i0}
Dialog: 0,0:23:21.77,0:23:24.64, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Mereka cantik.\N- Anda cantik walaupun tanpa mereka.{\c}{\i0}
Dialog: 0,0:23:25.27,0:23:30.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Selain itu, tumitnya sangat nipis dan tinggi.{\c}{\i0}
Dialog: 0,0:23:31.91,0:23:34.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya bimbang anda mungkin terjatuh,{\c}{\i0}
Dialog: 0,0:23:35.45,0:23:37.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi mengapa anda tidak...{\c}{\i0}
Dialog: 0,0:23:37.29,0:23:39.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}pakai kasut yang selesa sekali-sekala?{\c}{\i0}
Dialog: 0,0:23:43.54,0:23:45.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Biarkan mereka di sini, kemudian.{\c}{\i0}
Dialog: 0,0:23:45.84,0:23:47.56, Lalai,,0,0,0,,Dia tidak menyukainya ketika itu.
Dialog: 0,0:23:47.59,0:23:49.86, Lalai,,0,0,0,,Saya tidak percaya reaksinya.
Dialog: 0,0:23:49.88,0:23:51.23, Lalai,,0,0,0,,Tetapi lebih sukar dipercayai?
Dialog: 0,0:23:51.26,0:23:52.79, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:23:55.01,0:23:57.09, Lalai,,0,0,0,,Dia memakainya.
Dialog: 0,0:24:05.23,0:24:08.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Wah, Cik Hong nampak begitu...\N- Betul tak?{\c}{\i0}
Dialog: 0,0:24:08.36,0:24:10.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cantik, bukan?{\c}{\i0}
Dialog: 0,0:24:10.40,0:24:12.98, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak, dia kelihatan sangat bersemangat hari ini.{\c}{\i0}
Dialog: 0,0:24:15.28,0:24:17.98,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Seperti dia sudah bersedia untuk menghancurkan sesiapa sahaja.{\c}{\i0}
Dialog: 0,0:24:20.00,0:24:21.70,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tepat sekali.{\c}{\i0}
Dialog: 0,0:24:22.50,0:24:26.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa pun, mereka berdua sering bertemu hari ini.{\c}{\i0}
Dialog: 0,0:24:26.33,0:24:28.83,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Ini Setiausaha Na.\N- Hai.{\c}{\i0}
Dialog: 0,0:24:28.92,0:24:30.75, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul.{\c}{\i0}
Dialog: 0,0:24:30.92,0:24:34.08, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini kerana kedai Hercyna.{\c}{\i0}
Dialog: 0,0:24:34.97,0:24:38.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Baru-baru ini Encik Yoon telah melawat setiap hari,{\c}{\i0}
Dialog: 0,0:24:38.05,0:24:39.53, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}sedang makan dan minum kopi,{\c}{\i0}
Dialog: 0,0:24:39.56,0:24:42.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan juga berjalan-jalan dengannya.{\c}{\i0}
Dialog: 0,0:24:43.81,0:24:46.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nampaknya anda tidak tahu perkara ini,{\c}{\i0}
Dialog: 0,0:24:46.35,0:24:48.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi orang gila kerja juga menggunakan...{\c}{\i0}
Dialog: 0,0:24:48.36,0:24:52.14, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}masa makan dan rehat kopi untuk bercakap tentang kerja.{\c}{\i0}
Dialog: 0,0:24:52.28,0:24:53.81, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya.{\c}{\i0}
Dialog: 0,0:25:03.25,0:25:05.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}En. Yoon mungkin kawannya,{\c}{\i0}
Dialog: 0,0:25:05.04,0:25:08.49,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi dia jelas tidak mengenali Hae-in dengan baik.{\c}{\i0}
Dialog: 0,0:25:08.67,0:25:09.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in benci...{\c}{\i0}
Dialog: 0,0:25:09.84,0:25:13.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}apabila seseorang menyentuh rambutnya seperti itu.{\c}{\i0}
Dialog: 0,0:25:13.63,0:25:15.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia tersenyum.{\c}{\i0}
Dialog: 0,0:25:16.30,0:25:19.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nampaknya dia tidak begitu membencinya.{\c}{\i0}
Dialog: 0,0:25:21.39,0:25:24.80,Lalai,,0,0,0,,Jadi adakah ia mengganggu anda?\NDAdakah ia membuatkan anda cemburu?
Dialog: 0,0:25:25.39,0:25:28.46, Lalai,,0,0,0,,Adakah anda mendengar? Adakah anda tidak faham maksud saya?
Dialog: 0,0:25:28.48,0:25:31.31, Lalai,,0,0,0,,Itu maksud anda. Awak cemburu.
Dialog: 0,0:25:31.82,0:25:34.06,Lalai,,0,0,0,,Tahukah anda apa maksud "cemburu"?
Dialog: 0,0:25:34.15,0:25:36.84,Lalai,,0,0,0,,Itulah yang anda rasa apabila anda menyukai seseorang,
Dialog: 0,0:25:36.86,0:25:39.63, Lalai,,0,0,0,,dan saingan muncul.
Dialog: 0,0:25:39.66,0:25:41.01, Lalai,,0,0,0,,Itu premis yang salah.
Dialog: 0,0:25:41.03,0:25:43.51,Lalai,,0,0,0,,Saya tak sukakan Hae-in pun.\NKenapa saya nak cemburu?
Dialog: 0,0:25:43.54,0:25:46.31, Lalai,,0,0,0,,- Jadi ia tidak mengganggu anda?\N- Tidak, tidak sama sekali.
Dialog: 0,0:25:46.33,0:25:48.68,Lalai,,0,0,0,,Saya tidak kisah jika mereka rapat,
Dialog: 0,0:25:48.71,0:25:50.81, Lalai,,0,0,0,, atau jika mereka pergi ke mana-mana bersama-sama.
Dialog: 0,0:25:50.84,0:25:54.54,Lalai,,0,0,0,,Saya faham, tetapi apa yang anda\Ngrilling dan bukannya daging?
Dialog: 0,0:26:08.10,0:26:10.26, Lalai,,0,0,0,,Adakah anda memakainya?
Dialog: 0,0:26:10.48,0:26:14.77, Lalai,,0,0,0,,Suami saya membelinya untuk saya, dan\Nasked supaya saya memakainya. Apa yang boleh saya buat?
Dialog: 0,0:26:15.36,0:26:19.92,Lalai,,0,0,0,,Namun, kami akan berjumpa dengan CEO Hercyna.\NBukankah lebih baik memakai kasut mereka?
Dialog: 0,0:26:19.95,0:26:21.90,Lalai,,0,0,0,,Mahu saya carikan awak?
Dialog: 0,0:26:22.28,0:26:24.05,Lalai,,0,0,0,,Saya memakai pakaian mereka.
Dialog: 0,0:26:24.08,0:26:25.85,Lalai,,0,0,0,,Kasut mereka tidak selesa,
Dialog: 0,0:26:25.87,0:26:29.02,Lalai,,0,0,0,,dan dia bimbang saya mungkin terjatuh.
Dialog: 0,0:26:29.04,0:26:30.57, Lalai,,0,0,0,,Siapa?
Dialog: 0,0:26:31.00,0:26:32.66, Lalai,,0,0,0,,Hyun-woo ialah.
Dialog: 0,0:26:33.30,0:26:35.50, Lalai,,0,0,0,,Sungguh membimbangkan.
Dialog: 0,0:26:54.27,0:26:55.85,Lalai,,0,0,0,,Betul.
Dialog: 0,0:26:58.19,0:26:59.94, Lalai,,0,0,0,,Apa?
Dialog: 0,0:27:00.91,0:27:03.84, Lalai,,0,0,0,,Apa sahaja yang Hermann katakan, dengar sahaja.
Dialog: 0,0:27:03.87,0:27:05.48, Lalai,,0,0,0,,Apabila dia selesai,
Dialog: 0,0:27:05.66,0:27:07.53, Lalai,,0,0,0,,cakap satu perkara sahaja.
Dialog: 0,0:27:31.85,0:27:33.71,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sara Lopez?{\c}{\i0}
Dialog: 0,0:27:33.73,0:27:37.13, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia seorang pereka terkenal di Eropah.\NKami merancang untuk membuka kedai.{\c}{\i0}
Dialog: 0,0:27:37.62,0:27:39.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana dengan dia?{\c}{\i0}
Dialog: 0,0:27:39.65,0:27:41.77, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia perempuan simpanan baharu Hermann.{\c}{\i0}
Dialog: 0,0:27:44.74,0:27:47.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Isteri dia tak tahu?{\c}{\i0}
Dialog: 0,0:27:47.79,0:27:51.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia seorang peguam yang panas baran dan cekap.{\c}{\i0}
Dialog: 0,0:27:51.29,0:27:52.85,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika dia dapat tahu,{\c}{\i0}
Dialog: 0,0:27:52.87,0:27:56.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dia tidak akan pernah melihat bayi perempuannya.{\c}{\i0}
Dialog: 0,0:28:39.09,0:28:41.83, Lalai,,0,0,0,,Hermann sedang menjeling ke arah anda.
Dialog: 0,0:28:43.09,0:28:46.59,Lalai,,0,0,0,,Kerana selain kedua-duanya,\NI adalah satu-satunya yang tahu.
Dialog: 0,0:28:47.22,0:28:49.30, Lalai,,0,0,0,,Bukankah anda dalam keadaan betul?
Dialog: 0,0:28:50.06,0:28:51.24, Lalai,,0,0,0,,Tidak apa-apa.
Dialog: 0,0:28:51.27,0:28:55.43, Lalai,,0,0,0,,Saya ada beberapa kad lagi untuk menentangnya.
Dialog: 0,0:28:57.44,0:28:59.13, Lalai,,0,0,0,, Ye-na betul.
Dialog: 0,0:28:59.15,0:29:01.79,Lalai,,0,0,0,,Awak bukan Eun-sung yang saya kenal.
Dialog: 0,0:29:01.82,0:29:03.94, Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:29:05.53,0:29:07.73,Lalai,,0,0,0,,Saya telah bekerja keras...
Dialog: 0,0:29:07.87,0:29:10.15, Lalai,,0,0,0,,untuk mendengar ini daripada anda.
Dialog: 0,0:29:11.08,0:29:15.20,Lalai,,0,0,0,,Hutang atau kebaikan, saya sentiasa\Nmembayarnya. Saya berhutang dengan awak.
Dialog: 0,0:29:17.33,0:29:19.74, Lalai,,0,0,0,,Baiklah. Saya akan menahan anda untuk itu.
Dialog: 0,0:29:26.63,0:29:28.85,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Snek Walnut dan Kacang Tanah{\c}{\i0}
Dialog: 0,0:29:32.43,0:29:34.03, Lalai,,0,0,0,,Tolong satu beg kuih kacang.
Dialog: 0,0:29:34.06,0:29:35.16, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:29:35.19,0:29:37.25, Lalai,,0,0,0,,Sila bungkus dalam dua lapisan.
Dialog: 0,0:29:37.27,0:29:38.97, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:29:39.81,0:29:42.02, Lalai,,0,0,0,,- Anda bawa pulang?\N- Ya.
Dialog: 0,0:29:46.82,0:29:48.67, Lalai,,0,0,0,,Inilah sebabnya saya curiga.
Dialog: 0,0:29:48.70,0:29:52.76,Lalai,,0,0,0,,Pada pandangan saya, jika anda terfikir tentang\Nher apabila anda melihat makanan ringan ini...
Dialog: 0,0:29:52.79,0:29:54.99, Lalai,,0,0,0,,apabila anda mabuk,
Dialog: 0,0:29:55.71,0:29:57.89,Lalai,,0,0,0,,ini bermakna anda mencintainya!
Dialog: 0,0:29:57.92,0:29:58.98, Lalai,,0,0,0,,Cinta, kakiku.
Dialog: 0,0:29:59.00,0:30:01.40, Lalai,,0,0,0,,- Ia hanyalah kuih kacang.\N- Di sini.
Dialog: 0,0:30:01.42,0:30:03.20, Lalai,,0,0,0,,Anda mahukan juga?
Dialog: 0,0:30:03.42,0:30:05.52, Lalai,,0,0,0,,- Terima kasih.\N- Terima kasih.
Dialog: 0,0:30:05.55,0:30:07.25,Lalai,,0,0,0,,Mereka hanya...
Dialog: 0,0:30:09.01,0:30:10.71, Lalai,,0,0,0,,kuih kacang.
Dialog: 0,0:30:15.06,0:30:18.37, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di manakah anda? Cepat pulang.\NI ada sesuatu nak beritahu awak.{\c}{\i0}
Dialog: 0,0:30:18.39,0:30:21.08, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan risau. Berita baik yang anda akan suka.{\c}{\i0}
Dialog: 0,0:30:21.11,0:30:22.33, Lalai,,0,0,0,,Sesuatu untuk diberitahu kepada saya?
Dialog: 0,0:30:22.36,0:30:25.27, Lalai,,0,0,0,,Berita baik yang anda akan suka?
Dialog: 0,0:30:26.90,0:30:28.59, Lalai,,0,0,0,,Tunggu! tak boleh.
Dialog: 0,0:30:28.61,0:30:30.97, Lalai,,0,0,0,,- Apa?\N- "Saya tinggalkan semua aset saya..."
Dialog: 0,0:30:30.99,0:30:32.84, Lalai,,0,0,0,,"kepada Baek Hyun-woo."
Dialog: 0,0:30:32.87,0:30:34.65, Lalai,,0,0,0,, Menukar kehendaknya.
Dialog: 0,0:30:38.16,0:30:40.48, Lalai,,0,0,0,,- Ayuh. Tidak boleh.\N- Ya begitu!
Dialog: 0,0:30:40.50,0:30:42.73, Lalai,,0,0,0,,Mestilah!
Dialog: 0,0:30:42.75,0:30:45.27,Lalai,,0,0,0,,Tahniah, awak punk!
Dialog: 0,0:30:45.30,0:30:47.48,Lalai,,0,0,0,,- Jangan lupakan saya.\N- Tidak boleh begitu.
Dialog: 0,0:30:47.51,0:30:48.65, Lalai,,0,0,0,,Lepaskan.
Dialog: 0,0:30:48.68,0:30:50.38, Lalai,,0,0,0,,Kau punk!
Dialog: 0,0:30:52.47,0:30:54.09, Lalai,,0,0,0,,Hei.
Dialog: 0,0:30:54.22,0:30:56.30, Lalai,,0,0,0,,Hei.
Dialog: 0,0:30:58.60,0:31:02.01, Lalai,,0,0,0,,Ini adalah kuih kacang. Mahukan beberapa?
Dialog: 0,0:31:12.24,0:31:14.94, Lalai,,0,0,0,,Saya ingin memberi anda ini sebelum ia menjadi sejuk,
Dialog: 0,0:31:14.99,0:31:16.94, Lalai,,0,0,0,,jadi saya bergegas pulang.
Dialog: 0,0:31:21.04,0:31:22.74, Lalai,,0,0,0,,Bagaimana keadaannya?
Dialog: 0,0:31:22.88,0:31:23.98, Lalai,,0,0,0,,Ia bagus.
Dialog: 0,0:31:24.00,0:31:25.70, Lalai,,0,0,0,,Masih panas.
Dialog: 0,0:31:26.13,0:31:27.83,Lalai,,0,0,0,,Betul ke?
Dialog: 0,0:31:31.59,0:31:33.29,Lalai,,0,0,0,,By the way,
Dialog: 0,0:31:33.51,0:31:37.16,Lalai,,0,0,0,,apakah berita baik yang akan saya sukai ini?
Dialog: 0,0:31:37.18,0:31:38.88,Lalai,,0,0,0,,Betul.
Dialog: 0,0:31:39.64,0:31:41.47, Lalai,,0,0,0,,Mengapa anda tidak membukanya?
Dialog: 0,0:31:43.02,0:31:44.72, Lalai,,0,0,0,,Ini?
Dialog: 0,0:31:49.61,0:31:51.40, Lalai,,0,0,0,,Buka?
Dialog: 0,0:31:54.03,0:31:56.19,Lalai,,0,0,0,,Jangan terkejut.
Dialog: 0,0:31:58.54,0:32:00.24, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:32:00.29,0:32:02.07, Lalai,,0,0,0,,Saya tidak akan.
Dialog: 0,0:32:04.63,0:32:06.10, Lalai,,0,0,0,,Saya mendapatnya lebih awal.
Dialog: 0,0:32:06.13,0:32:09.02,Lalai,,0,0,0,,Ia daripada salah satu pusat\Nkanser terbaik di Eropah.
Dialog: 0,0:32:09.05,0:32:13.13, Lalai,,0,0,0,,Pada halaman seterusnya ialah kertas penyelidikan mereka.
Dialog: 0,0:32:20.14,0:32:21.24, Lalai,,0,0,0,,Ya.
Dialog: 0,0:32:21.27,0:32:22.37, Lalai,,0,0,0,,Betul.
Dialog: 0,0:32:22.39,0:32:25.58,Lalai,,0,0,0,,Mereka fikir mereka boleh menyembuhkan saya,
Dialog: 0,0:32:25.61,0:32:27.77, Lalai,,0,0,0,,- Apa?\N- ...dan peluang...
Dialog: 0,0:32:31.82,0:32:33.65, Lalai,,0,0,0,, melebihi 50%.
Dialog: 0,0:32:33.86,0:32:35.73, Lalai,,0,0,0,, Tamat?
Dialog: 0,0:32:36.62,0:32:38.98, Lalai,,0,0,0,,Saya tahu anda akan sangat gembira.
Dialog: 0,0:32:42.12,0:32:43.82, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:32:44.44,0:32:47.31, Lalai,,0,0,0,,Peluangnya adalah kira-kira 51%,
Dialog: 0,0:32:47.34,0:32:49.98, Lalai,,0,0,0,,dan mereka ingin melakukan rawatan klinikal ke atas saya.
Dialog: 0,0:32:50.00,0:32:52.23, Lalai,,0,0,0,,- Memang benar.\N- Apa yang saya katakan?
Dialog: 0,0:32:52.26,0:32:54.90,Lalai,,0,0,0,,Saya kata saya tidak akan kalah dengan penyakit itu.
Dialog: 0,0:32:54.93,0:32:56.88, Lalai,,0,0,0,,Bahawa Tuhan ada di pihak saya.
Dialog: 0,0:32:56.93,0:32:59.51,Lalai,,0,0,0,,Anda berada di pihak saya,
Dialog: 0,0:32:59.64,0:33:01.55, Lalai,,0,0,0,,dan begitu juga Tuhan.
Dialog: 0,0:33:01.93,0:33:04.51, Lalai,,0,0,0,,Ya ampun.
Dialog: 0,0:33:05.06,0:33:07.14, Lalai,,0,0,0,,Saya berasa begitu yakin.
Dialog: 0,0:33:42.72,0:33:44.30,Lalai,,0,0,0,,Jika...
Dialog: 0,0:33:44.52,0:33:46.55,Lalai,,0,0,0,,dia sudah sembuh,
Dialog: 0,0:33:47.23,0:33:48.87,Lalai,,0,0,0,,kemudian...
Dialog: 0,0:33:48.90,0:33:50.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Makan malam pasukan selesai...{\c}{\i0}
Dialog: 0,0:33:50.23,0:33:54.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- pada 9:30 malam tadi, jadi kenapa...?\N- Mengapa anda perlu mengemukakannya di...?{\c}{\i0}
Dialog: 0,0:33:54.07,0:33:56.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bukankah saya telah memberitahu anda?{\c}{\i0}
Dialog: 0,0:33:56.15,0:33:58.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya cuma risau.{\c}{\i0}
Dialog: 0,0:33:58.66,0:34:00.30, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Katakan sesuatu!\N- Ini bukan Hyun-woo.{\c}{\i0}
Dialog: 0,0:34:00.32,0:34:03.69, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Anda sebahagian daripada keluarga Hong kami!\N- Hyun-woo!{\c}{\i0}
Dialog: 0,0:34:06.08,0:34:10.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cepat. Kami akan lambat.\NInilah sebabnya anda selalu lewat.{\c}{\i0}
Dialog: 0,0:34:10.50,0:34:13.75,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Saya minta maaf.\N- Anda sangat mengecewakan.{\c}{\i0}
Dialog: 0,0:34:57.17,0:34:58.96,Lalai,,0,0,0,,Kehidupan seperti itu...
Dialog: 0,0:34:59.47,0:35:01.59, Lalai,,0,0,0,,untuk 50 tahun lagi?
Dialog: 0,0:35:03.51,0:35:05.21,Lalai,,0,0,0,,No.
Dialog: 0,0:35:06.47,0:35:08.34,Lalai,,0,0,0,,Saya patut bercerai...
Dialog: 0,0:35:08.43,0:35:10.89, Lalai,,0,0,0,,seperti yang saya rancangkan pada asalnya.
Dialog: 0,0:35:12.40,0:35:13.37,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Perjanjian Perceraian{\c}{\i0}
Dialog: 0,0:35:15.23,0:35:17.06,Lalai,,0,0,0,,{\i1}Betul.{\i0}
Dialog: 0,0:35:17.11,0:35:20.15,Lalai,,0,0,0,,{\i1}Sekarang saya telah sembuh,{\i0}
Dialog: 0,0:35:20.53,0:35:22.59,Lalai,,0,0,0,,{\i1}anda akan mengkhianati saya?{\i0}
Dialog: 0,0:35:22.62,0:35:25.18,Lalai,,0,0,0,,{\i1}Anda mendapat semula hidup anda,{\i0}
Dialog: 0,0:35:25.20,0:35:28.11, Lalai,,0,0,0,,{\i1}jadi saya mahukan milik saya juga.{\i0}
Dialog: 0,0:35:32.08,0:35:33.78,Lalai,,0,0,0,,{\i1}Betul.{\i0}
Dialog: 0,0:35:34.13,0:35:37.00,Lalai,,0,0,0,,{\i1}Orang ramai boleh berasa begitu.{\i0}
Dialog: 0,0:35:37.09,0:35:38.79,Lalai,,0,0,0,,{\i1}Ia boleh difahami.{\i0}
Dialog: 0,0:35:41.51,0:35:43.25,Lalai,,0,0,0,,{\i1}Namun...{\i0}
Dialog: 0,0:35:54.31,0:35:56.89,Lalai,,0,0,0,,{\i1}Bukan orang saya.{\i0}
Dialog: 0,0:36:03.41,0:36:08.28, Lalai,,0,0,0,,Ia mungkin lebih teruk daripada imaginasi saya.
Dialog: 0,0:36:15.59,0:36:17.02,Lalai,,0,0,0,,Aduh, saya kepenatan.
Dialog: 0,0:36:17.04,0:36:18.19,Lalai,,0,0,0,,- Kebaikan.\N- Awak okay?
Dialog: 0,0:36:18.21,0:36:19.52, Lalai,,0,0,0,,Ya, saya tidak apa-apa.
Dialog: 0,0:36:19.55,0:36:22.62, Lalai,,0,0,0,, Bagus, ia meletihkan.
Dialog: 0,0:36:25.26,0:36:26.99, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:36:27.01,0:36:28.87, Lalai,,0,0,0,,Saya telah menjadi lebih baik.
Dialog: 0,0:36:28.89,0:36:32.09,Lalai,,0,0,0,,Ayah, awak tak dahaga ke? miliki ini.
Dialog: 0,0:36:33.27,0:36:35.14,Lalai,,0,0,0,,Betul. Terima kasih.
Dialog: 0,0:36:36.56,0:36:39.46,Lalai,,0,0,0,,Bolehkah saya minum ini?\NAnda tidak meracuninya, bukan?
Dialog: 0,0:36:39.48,0:36:42.56,Lalai,,0,0,0,,Ayuh, Ayah. Minum sahaja.
Dialog: 0,0:36:42.61,0:36:44.46, Lalai,,0,0,0,,Apa yang berlaku kepada anda?
Dialog: 0,0:36:44.49,0:36:46.77,Lalai,,0,0,0,,Saya selalu begini.
Dialog: 0,0:36:47.62,0:36:49.34, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:36:49.37,0:36:51.10,Lalai,,0,0,0,,Kami pernah sangat gembira bersama.
Dialog: 0,0:36:51.12,0:36:55.02,Lalai,,0,0,0,,Maksud saya, kita dulu, sebelum\Nsesetengah perempuan masuk gambar.
Dialog: 0,0:36:55.04,0:36:56.94, Lalai,,0,0,0,,Kami tidak kacau begini.
Dialog: 0,0:36:56.96,0:36:59.66, Lalai,,0,0,0,, En. Hong, saya masuk dulu.
Dialog: 0,0:37:11.14,0:37:14.05,Lalai,,0,0,0,,Ayah ingat...
Dialog: 0,0:37:14.10,0:37:16.58, Lalai,,0,0,0,,seberapa besar awak memuja saya?
Dialog: 0,0:37:16.60,0:37:17.66, Lalai,,0,0,0,,Awak sayang saya.
Dialog: 0,0:37:17.69,0:37:21.63, Lalai,,0,0,0,,Anda sentiasa membeli hadiah untuk saya semasa\Anda pulang dari perjalanan perniagaan anda.
Dialog: 0,0:37:21.65,0:37:23.59, Lalai,,0,0,0,,Itu dahulu.
Dialog: 0,0:37:23.61,0:37:27.93,Lalai,,0,0,0,,Awak selalu suruh saya hidup dengan\Nyou selamanya tanpa berkahwin,
Dialog: 0,0:37:27.95,0:37:30.39, Lalai,,0,0,0,,dan lihat? Saya masih bersama awak.
Dialog: 0,0:37:30.41,0:37:33.66,Lalai,,0,0,0,,Saya tak suruh awak kahwin dan balik.
Dialog: 0,0:37:33.69,0:37:34.72,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:37:34.75,0:37:36.98,Lalai,,0,0,0,,Cinta akan kembali, Ayah.
Dialog: 0,0:37:37.00,0:37:40.15, Lalai,,0,0,0,,Mengapa saya kembali dalam masa\Ntiga tahun apabila saya berkahwin?
Dialog: 0,0:37:40.17,0:37:42.83, Lalai,,0,0,0,,Itu kerana...
Dialog: 0,0:37:43.05,0:37:45.69, Lalai,,0,0,0,,anak perempuan awak yang cantik menyayangi awak.
Dialog: 0,0:37:45.72,0:37:47.95, Lalai,,0,0,0,,Hei, berhenti. Saya akan makan tidak lama lagi.
Dialog: 0,0:37:47.97,0:37:49.82,Lalai,,0,0,0,,- Saya akan hilang selera makan.\N- Oh, tidak.
Dialog: 0,0:37:49.85,0:37:52.07, Lalai,,0,0,0,, Anda tidak sepatutnya kehilangan selera makan.
Dialog: 0,0:37:52.10,0:37:55.33,Lalai,,0,0,0,,Pada usia anda, ia lebih berbahaya\Ndaripada kehabisan wang.
Dialog: 0,0:37:55.35,0:37:59.26, Lalai,,0,0,0,,Apakah itu? Katakan sahaja.\NMengapa anda menjadi seperti ini?
Dialog: 0,0:38:00.11,0:38:02.92,Lalai,,0,0,0,,Anda tahu, ini hari lahir saya\Nesok.
Dialog: 0,0:38:02.94,0:38:05.48,Lalai,,0,0,0,,Saya tidak mahu apa-apa lagi.
Dialog: 0,0:38:05.57,0:38:09.55,Lalai,,0,0,0,,Saya hanya mahu pergi dating dengan\N ayah tercinta, hanya kami berdua.
Dialog: 0,0:38:09.57,0:38:11.57, Lalai,,0,0,0,,- Tolong?\N- Ya ampun.
Dialog: 0,0:38:11.91,0:38:14.44, Lalai,,0,0,0,,Tolong, Ayah?
Dialog: 0,0:38:14.62,0:38:17.02,Lalai,,0,0,0,,Saya mahu makan sesuatu yang lazat dengan awak.
Dialog: 0,0:38:17.04,0:38:19.64, Lalai,,0,0,0,,- Hentikan.\N- Adakah anda akan melayan saya dengan sesuatu yang baik?
Dialog: 0,0:38:19.67,0:38:22.19, Lalai,,0,0,0,,Hei, berhenti. Itu keji!
Dialog: 0,0:38:22.21,0:38:24.16, Lalai,,0,0,0,, Berhenti! pergi pergi!
Dialog: 0,0:38:50.20,0:38:51.98, Lalai,,0,0,0,,Hei.
Dialog: 0,0:38:52.74,0:38:54.39,Lalai,,0,0,0,,- Helo.\N- Hello.
Dialog: 0,0:38:54.41,0:38:57.39, Lalai,,0,0,0,,Apa yang anda lakukan di sini pada\Npagi pada hujung minggu?
Dialog: 0,0:38:57.41,0:38:59.18, Lalai,,0,0,0,,Untuk rundingan dengan Hercyna.
Dialog: 0,0:39:00.10,0:39:01.60, Lalai,,0,0,0,,Maka saya patut menyertai awak.
Dialog: 0,0:39:01.63,0:39:05.61, Lalai,,0,0,0,,Pasukan undang-undang harus berada dalam\Ngelung untuk menyelesaikan butiran.
Dialog: 0,0:39:05.63,0:39:06.65, Lalai,,0,0,0,,Itu akan datang kemudian.
Dialog: 0,0:39:06.67,0:39:10.15,Lalai,,0,0,0,,Kami sedang membincangkan\Nrundingan antara CEO,
Dialog: 0,0:39:10.18,0:39:13.38, Lalai,,0,0,0,,untuk menyingkirkan sebarang faktor pemecah perjanjian.
Dialog: 0,0:39:14.68,0:39:17.24,Lalai,,0,0,0,,Adakah kami mengganggu anda? Kita boleh pergi ke tempat lain.
Dialog: 0,0:39:17.27,0:39:19.13, Lalai,,0,0,0,,Bagaimana dengan hotel saya?
Dialog: 0,0:39:19.48,0:39:21.12, Lalai,,0,0,0,,Anda boleh melakukannya di sini.
Dialog: 0,0:39:21.15,0:39:23.14, Lalai,,0,0,0,, Di sini, dengan selesa.
Dialog: 0,0:39:24.77,0:39:26.35, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:39:26.40,0:39:27.88, Lalai,,0,0,0,,Saya patut berterima kasih.
Dialog: 0,0:39:27.90,0:39:30.13,Lalai,,0,0,0,,Awak tolong isteri saya.
Dialog: 0,0:39:30.15,0:39:31.13, Lalai,,0,0,0,,Mahukan kopi?
Dialog: 0,0:39:31.16,0:39:33.19, Lalai,,0,0,0,,- Ya, terima kasih.\N- Pasti.
Dialog: 0,0:39:33.78,0:39:37.40, Lalai,,0,0,0,,Anda juga? Anda tidak minum\Nkopi semasa perut kosong.
Dialog: 0,0:39:43.75,0:39:45.45, Lalai,,0,0,0,,Itu benar.
Dialog: 0,0:39:46.42,0:39:49.96,Lalai,,0,0,0,,- Espresso untuk anda, bukan?\N- Ya.
Dialog: 0,0:40:01.14,0:40:04.26,Lalai,,0,0,0,,Dia sangat mengambil berat tentang saya.
Dialog: 0,0:40:04.98,0:40:06.81, Lalai,,0,0,0,,Apa?
Dialog: 0,0:40:07.40,0:40:11.60,Lalai,,0,0,0,,Dia berkata kopi seperti racun pada\Nan perut kosong dan ia tidak sihat.
Dialog: 0,0:40:12.86,0:40:15.05, Lalai,,0,0,0,,Dia tidak membenarkan saya meminumnya.
Dialog: 0,0:40:15.07,0:40:17.48,Lalai,,0,0,0,,Maksud saya, saya bukan anak dia, awak tahu?
Dialog: 0,0:40:18.87,0:40:21.11, Lalai,,0,0,0,,Saya rasa dia tidak boleh berhenti...
Dialog: 0,0:40:21.16,0:40:23.23, Lalai,,0,0,0,,bimbang tentang saya.
Dialog: 0,0:40:23.25,0:40:26.24,Lalai,,0,0,0,,Hae-in mesti mengambil berat tentang kamu.
Dialog: 0,0:40:26.71,0:40:28.41, Lalai,,0,0,0,,Saya iri dengan awak.
Dialog: 0,0:40:28.75,0:40:30.86, Lalai,,0,0,0,,Nah, ya. Saya fikir begitu juga.
Dialog: 0,0:40:30.88,0:40:32.86, Lalai,,0,0,0,,Dia tidak begitu pada saya.
Dialog: 0,0:40:32.88,0:40:37.50,Lalai,,0,0,0,,Dia selalu meminta bantuan saya, berkata\NI sahaja yang boleh membantunya.
Dialog: 0,0:40:37.56,0:40:39.59, Lalai,,0,0,0,,Dia selalu begitu.
Dialog: 0,0:40:39.64,0:40:44.33, Lalai,,0,0,0,,Dia akan menghubungi saya pada bila-bila masa untuk meminta bantuan,\Nkatakan saya seorang sahaja yang dia ada.
Dialog: 0,0:40:44.35,0:40:46.00, Lalai,,0,0,0,,Bagaimana saya tidak boleh membantu, kalau begitu?
Dialog: 0,0:40:46.02,0:40:50.13, Lalai,,0,0,0,, Walaupun kali ini. Rundingan semacam ini boleh mengambil masa setahun,
Dialog: 0,0:40:50.15,0:40:53.19, Lalai,,0,0,0,,tetapi dia meminta saya menyelesaikannya dalam masa dua minggu.
Dialog: 0,0:40:53.90,0:40:57.48,Lalai,,0,0,0,,Saya tidak akan mempunyai masa untuk melakukan\Apa-apa lagi semasa saya berada di Korea.
Dialog: 0,0:40:57.62,0:40:58.72,Lalai,,0,0,0,,Nampaknya...
Dialog: 0,0:40:58.74,0:41:01.82, Lalai,,0,0,0,,Saya perlu terjebak dengannya sepanjang masa.
Dialog: 0,0:41:04.87,0:41:06.58,Lalai,,0,0,0,,Itu...
Dialog: 0,0:41:07.46,0:41:09.41, Lalai,,0,0,0,, meyakinkan.
Dialog: 0,0:41:17.76,0:41:20.55, Lalai,,0,0,0,,Adakah anda membawa ini kepadanya?
Dialog: 0,0:41:25.90,0:41:28.01, Lalai,,0,0,0,,Saya tiba-tiba ingin tahu.
Dialog: 0,0:41:28.94,0:41:30.00, Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,0:41:30.02,0:41:33.80,Lalai,,0,0,0,,Tidakkah anda benci apabila\Tiada seseorang menyentuh rambut anda?
Dialog: 0,0:41:33.82,0:41:35.05, Lalai,,0,0,0,,- Apa?\N- Maksud saya,
Dialog: 0,0:41:35.07,0:41:36.63, Lalai,,0,0,0,,apabila saya menyentuhnya kali terakhir,
Dialog: 0,0:41:36.66,0:41:40.19,Lalai,,0,0,0,,anda menjerit kepada saya, mengatakan\NI merosakkan gaya rambut anda.
Dialog: 0,0:41:40.53,0:41:42.49,Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:41:42.62,0:41:44.15, Lalai,,0,0,0,,Ringkasnya.
Dialog: 0,0:41:45.37,0:41:47.82,Lalai,,0,0,0,,Awak marah bila saya buat,
Dialog: 0,0:41:48.13,0:41:50.83, Lalai,,0,0,0,, jadi kenapa awak tidak buat semasa Encik Yoon melakukannya?
Dialog: 0,0:41:51.25,0:41:52.79,Lalai,,0,0,0,,Apa?
Dialog: 0,0:41:56.43,0:41:57.40,Lalai,,0,0,0,,Itu kerana...
Dialog: 0,0:41:57.43,0:41:59.34,Lalai,,0,0,0,,Saya mahu awak berlaku adil.
Dialog: 0,0:41:59.68,0:42:01.36, Lalai,,0,0,0,,Bukan sahaja Encik Yoon.
Dialog: 0,0:42:01.39,0:42:04.22,Lalai,,0,0,0,,Jika mana-mana lelaki menyentuh rambut anda,
Dialog: 0,0:42:04.43,0:42:06.13,Lalai,,0,0,0,,anda patut marah.
Dialog: 0,0:42:07.94,0:42:10.01, Lalai,,0,0,0,,Kecuali pendandan rambut anda.
Dialog: 0,0:42:25.66,0:42:27.36, Lalai,,0,0,0,,Dia baru sahaja pergi...
Dialog: 0,0:42:29.04,0:42:30.95, Lalai,,0,0,0,,tanpa berkata apa-apa.
Dialog: 0,0:42:42.72,0:42:44.32, Lalai,,0,0,0,,Bagaimana dia boleh berbuat demikian?
Dialog: 0,0:42:44.35,0:42:46.01,Lalai,,0,0,0,,Sialan.
Dialog: 0,0:42:49.85,0:42:51.72,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:42:56.32,0:42:58.02,Lalai,,0,0,0,,Astaga...
Dialog: 0,0:42:59.03,0:43:01.26, Lalai,,0,0,0,,Ini sukar dipercayai.
Dialog: 0,0:43:01.28,0:43:05.72,Lalai,,0,0,0,,Saya tidak pernah begini\Menjengkelkan dengan senyuman seseorang.
Dialog: 0,0:43:05.74,0:43:07.99, Lalai,,0,0,0,,Dia benar-benar sesuatu.
Dialog: 0,0:43:18.09,0:43:20.96, Lalai,,0,0,0,,Dia masih tersenyum. apa?
Dialog: 0,0:43:21.68,0:43:25.42, Lalai,,0,0,0,,Si brengsek itu. Mengapa dia menarik\Nit ke bawah? Hei, awak bodoh. Tunggu.
Dialog: 0,0:43:26.60,0:43:29.30, Lalai,,0,0,0,,Tunggu. Hei.
Dialog: 0,0:43:29.48,0:43:31.62,Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:43:31.65,0:43:34.12,Lalai,,0,0,0,,Awak rasa saya tak boleh tengok awak kalau awak buat macam ni?
Dialog: 0,0:43:34.15,0:43:37.06, Lalai,,0,0,0,,Saya akan cari jalan, tidak kira apa.
Dialog: 0,0:43:55.42,0:43:57.12,Lalai,,0,0,0,,Saya...
Dialog: 0,0:43:57.42,0:43:59.96, Lalai,,0,0,0,,hanya berjalan.
Dialog: 0,0:44:00.59,0:44:02.29, Lalai,,0,0,0,,Berjalan-jalan.
Dialog: 0,0:44:03.68,0:44:07.59,Lalai,,0,0,0,,Bukan kerana saya ingin tahu.
Dialog: 0,0:44:11.19,0:44:12.97,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:44:13.69,0:44:15.39,Lalai,,0,0,0,,Apa?
Dialog: 0,0:44:15.98,0:44:17.89, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:44:20.03,0:44:22.46,Lalai,,0,0,0,,Bukankah awak sebut "Sayang"?
Dialog: 0,0:44:22.49,0:44:24.34, Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,0:44:24.37,0:44:26.15, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:44:26.37,0:44:27.59,Lalai,,0,0,0,,Saya mesti salah dengar.
Dialog: 0,0:44:27.62,0:44:29.26, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:44:29.29,0:44:32.16, Lalai,,0,0,0,,Nah, teruskan.
Dialog: 0,0:44:32.83,0:44:34.56,Lalai,,0,0,0,,Hubungi saya jika anda memerlukan saya.
Dialog: 0,0:44:34.58,0:44:36.45,Lalai,,0,0,0,,Tidak, saya tidak memerlukan awak hari ini.
Dialog: 0,0:44:36.54,0:44:38.24, Lalai,,0,0,0,, Pergi dan berehat sahaja.
Dialog: 0,0:44:39.17,0:44:40.83, Lalai,,0,0,0,,Saya sedang berehat.
Dialog: 0,0:44:41.97,0:44:43.78, Lalai,,0,0,0,,- Hei.\N- Ya?
Dialog: 0,0:44:43.80,0:44:44.94, Lalai,,0,0,0,,Tidak, bukan anda.
Dialog: 0,0:44:44.97,0:44:46.15,Lalai,,0,0,0,,Eun-sung!
Dialog: 0,0:44:46.18,0:44:49.57,Lalai,,0,0,0,,Saya dengar kakak saya mengganggu\Nyou pada hari Ahad, jadi saya datang.
Dialog: 0,0:44:49.60,0:44:51.45, Lalai,,0,0,0,,Hei, tersesat.
Dialog: 0,0:44:51.48,0:44:52.79,Lalai,,0,0,0,,Kami sedang bekerja.
Dialog: 0,0:44:52.81,0:44:55.75,Lalai,,0,0,0,,Anda tahu, saya cuba menghubungi awak berkali-kali,
Dialog: 0,0:44:55.77,0:44:57.00, Lalai,,0,0,0,,tetapi setiausaha anda...
Dialog: 0,0:44:57.02,0:44:59.83, Lalai,,0,0,0,,tidak sesuai antarabangsa anda,\Imej potongan bersih.
Dialog: 0,0:44:59.86,0:45:04.76,Lalai,,0,0,0,,Dia menutup telefon saya tanpa mengetahui\Nsejauh mana kami berada. Saya sangat terluka.
Dialog: 0,0:45:04.78,0:45:07.57,Lalai,,0,0,0,,Betulkah? Saya akan bercakap dengan mereka, Encik Hong.
Dialog: 0,0:45:07.62,0:45:11.22,Lalai,,0,0,0,,Jangan terlalu formal dengan saya. Hanya\Nlayan saya seperti adik lelaki awak.
Dialog: 0,0:45:11.25,0:45:14.60,Lalai,,0,0,0,,Serius, saya rasa lebih dekat dengan awak berbanding Hyun-woo,
Dialog: 0,0:45:14.62,0:45:17.78,Lalai,,0,0,0,,yang telah menjadi abang ipar saya selama tiga tahun.
Dialog: 0,0:45:18.21,0:45:20.12, Lalai,,0,0,0,,Anda masih di sini?
Dialog: 0,0:45:21.46,0:45:23.11, Lalai,,0,0,0,,Saya akan pergi.
Dialog: 0,0:45:23.13,0:45:25.07, Lalai,,0,0,0,,- Tidak, jangan keluar.\N- Betul.
Dialog: 0,0:45:25.09,0:45:26.79, Lalai,,0,0,0,,Saya tidak akan.
Dialog: 0,0:45:27.01,0:45:29.21,Lalai,,0,0,0,,Dah makan ke?
Dialog: 0,0:45:29.85,0:45:31.97, Lalai,,0,0,0,,Mengapa awak sangat sedih?
Dialog: 0,0:45:32.02,0:45:36.96,Lalai,,0,0,0,,Cara saya melihatnya, Eun-sung seperti harapan baru awak.
Dialog: 0,0:45:36.98,0:45:38.37, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:45:38.40,0:45:41.63,Lalai,,0,0,0,,Hae-in mempunyai 51% peluang untuk hidup sekarang.
Dialog: 0,0:45:41.65,0:45:44.13,Lalai,,0,0,0,,Sudah tentu anda patut gembira untuknya,
Dialog: 0,0:45:44.15,0:45:46.71,Lalai,,0,0,0,,tetapi harapan anda sudah tiada.
Dialog: 0,0:45:46.74,0:45:50.39,Lalai,,0,0,0,,Harapan anda untuk perpisahan yang kaya dan selamat.
Dialog: 0,0:45:50.41,0:45:52.11,Lalai,,0,0,0,,Jadi?
Dialog: 0,0:45:52.49,0:45:56.98,Lalai,,0,0,0,,Bagaimana jika Eun-sung dan Hae-in jatuh cinta?
Dialog: 0,0:45:57.00,0:45:58.06, Lalai,,0,0,0,,Anda akan mendapat nafkah.
Dialog: 0,0:45:58.08,0:45:59.39, Lalai,,0,0,0,,Tidak, bukan Yoon Eun-sung.
Dialog: 0,0:45:59.42,0:46:00.69, Lalai,,0,0,0,,Kenapa tidak?
Dialog: 0,0:46:00.71,0:46:04.37, Lalai,,0,0,0,, Lelaki itu menyeramkan.
Dialog: 0,0:46:07.63,0:46:09.28, Lalai,,0,0,0,,Siapa peduli?
Dialog: 0,0:46:09.30,0:46:12.07,Lalai,,0,0,0,,Hei, saya rasa dia penyelamat awak.
Dialog: 0,0:46:12.10,0:46:15.37, Lalai,,0,0,0,,Anda sepatutnya bersyukur\Nbahawa dia datang untuk menyelamatkan anda.
Dialog: 0,0:46:15.39,0:46:19.30,Lalai,,0,0,0,,Ada sesuatu yang tidak kena dengan dia.
Dialog: 0,0:46:19.69,0:46:23.31,Lalai,,0,0,0,,- Saya dapat merasakannya.\N- Ayuh.
Dialog: 0,0:46:24.19,0:46:26.92, Lalai,,0,0,0,,Siapa peduli bagaimana penyelamat anda?
Dialog: 0,0:46:26.95,0:46:30.98,Lalai,,0,0,0,,Jika anda lemas, dan anda tidak\N suka penyelamat, adakah anda tidak...
Dialog: 0,0:46:32.03,0:46:34.07, Lalai,,0,0,0,,pegang tali?
Dialog: 0,0:46:36.46,0:46:39.49,Lalai,,0,0,0,,Dalam apa jua keadaan, saya tidak boleh biarkan ia menjadi bodoh.
Dialog: 0,0:46:39.75,0:46:41.37,Lalai,,0,0,0,,Saya kata tidak.
Dialog: 0,0:46:45.21,0:46:46.23,Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:46:46.26,0:46:48.17,Lalai,,0,0,0,,{\i1}Eun-sung.{\i0}
Dialog: 0,0:46:48.34,0:46:50.65, Lalai,,0,0,0,,Nampak tanah ini? Ia adalah 825 ekar.
Dialog: 0,0:46:50.68,0:46:53.78, Lalai,,0,0,0,,Neverland ialah 355 ekar dan Souland ialah 230 ekar.
Dialog: 0,0:46:53.81,0:46:55.58, Lalai,,0,0,0,,Ia lebih besar daripada gabungan kedua-duanya.
Dialog: 0,0:46:55.60,0:46:57.59, Lalai,,0,0,0,, Mengagumkan.
Dialog: 0,0:46:58.06,0:47:01.00, Lalai,,0,0,0,,Anda tahu dua perkara paling penting\N dalam perniagaan resort,
Dialog: 0,0:47:01.02,0:47:02.92, Lalai,,0,0,0,,menjaga tanah dan pelesenan.
Dialog: 0,0:47:02.94,0:47:07.02, Lalai,,0,0,0,,Seperti yang anda lihat, kami mempunyai\Nland, dan bagi pelesenan...
Dialog: 0,0:47:08.95,0:47:11.73, Lalai,,0,0,0,,Kami mempunyai orang kami di Kementerian Tanah.
Dialog: 0,0:47:12.57,0:47:14.26,Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,0:47:14.28,0:47:16.47,Lalai,,0,0,0,,Dia belajar dengan biasiswa Queens,
Dialog: 0,0:47:16.50,0:47:18.35, Lalai,,0,0,0,, dan dia adalah tutor saya.
Dialog: 0,0:47:18.37,0:47:20.39, Lalai,,0,0,0,,- Saya faham.\N- Betul.
Dialog: 0,0:47:20.42,0:47:23.94, Lalai,,0,0,0,,K-pop, K-drama. Kandungan Korea\Nis begitu popular hari ini.
Dialog: 0,0:47:23.96,0:47:27.12,Lalai,,0,0,0,,Mari kita kalahkan Disney bersama-sama, Eun-sung!
Dialog: 0,0:47:29.68,0:47:31.63, Lalai,,0,0,0,,Saya akan fikirkannya.
Dialog: 0,0:47:55.79,0:47:56.76, Lalai,,0,0,0,,Oh, saya.
Dialog: 0,0:47:56.79,0:47:59.68, Lalai,,0,0,0,,Dia berjumpa dengan semua orang ini?
Dialog: 0,0:47:59.71,0:48:03.06, Lalai,,0,0,0,,Adakah anda mengenali Robert Bailey,\Npengurus dana lindung nilai yang legenda?
Dialog: 0,0:48:03.08,0:48:06.23,Lalai,,0,0,0,,Antara 12 perantisnya,\Nlelaki ini yang terbaik.
Dialog: 0,0:48:06.25,0:48:11.29,Lalai,,0,0,0,,Robert malah mempercayakan pengurusan asetnya\Ndengannya. Apa lagi yang perlu dikatakan?
Dialog: 0,0:48:11.97,0:48:13.07,Lalai,,0,0,0,,Betulkah?
Dialog: 0,0:48:13.09,0:48:16.50,Lalai,,0,0,0,,Dia sempurna sebagai pasangan Encik Hong Soo-cheol,
Dialog: 0,0:48:17.39,0:48:20.88,Lalai,,0,0,0,,tetapi dia agak pemilih, jadi...
Dialog: 0,0:48:21.27,0:48:24.21,Lalai,,0,0,0,,Tetapi dia dengan rela hati membantu\NHae-in berkenaan Hercyna.
Dialog: 0,0:48:24.23,0:48:27.14,Lalai,,0,0,0,,Ya, kerana kedua-duanya begitu rapat,
Dialog: 0,0:48:27.90,0:48:33.44,Lalai,,0,0,0,,dan itu mungkin sebab Encik Yoon\Tidak rapat dengan Encik Hong.
Dialog: 0,0:48:33.99,0:48:35.30, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:48:35.32,0:48:36.34, Lalai,,0,0,0,,Fikirkanlah.
Dialog: 0,0:48:36.37,0:48:37.59,Lalai,,0,0,0,,Untuk Cik Hong,
Dialog: 0,0:48:37.62,0:48:41.76, Lalai,,0,0,0,,jika Hercyna dibuka di pusat beli-belahnya, dia pasti akan\Mencapai $1 bilion dalam jualan.
Dialog: 0,0:48:41.79,0:48:46.73, Lalai,,0,0,0,,Kemudian pengerusi akan condong ke arah\Memberi kumpulan itu kepadanya, seperti yang dijanjikannya.
Dialog: 0,0:48:46.75,0:48:48.02,Lalai,,0,0,0,,Adakah anda berkata...
Dialog: 0,0:48:48.05,0:48:53.04,Lalai,,0,0,0,,Hae-in tidak mahu Soo-cheol berjaya\Nin menarik pelaburan untuk resort?
Dialog: 0,0:48:53.30,0:48:57.38,Lalai,,0,0,0,,Ya! Soo-cheol boleh memusingkan meja.
Dialog: 0,0:48:58.22,0:49:02.70,Lalai,,0,0,0,,Maksud saya, saya tidak tahu apa\NMs. Hong memberitahu Encik Yoon,
Dialog: 0,0:49:02.73,0:49:06.93,Lalai,,0,0,0,,tetapi nampaknya dia tidak menganggap\NMr. Hong sebagai rakan kongsi yang berpotensi.
Dialog: 0,0:49:07.02,0:49:10.60,Lalai,,0,0,0,,Dia sedang makan malam dengan cucu Pengerusi\NYeom malam ini.
Dialog: 0,0:49:12.78,0:49:15.67,Lalai,,0,0,0,,Tilik nasib tidak menipu.
Dialog: 0,0:49:15.70,0:49:17.01,Lalai,,0,0,0,,Saya dah beritahu awak, bukan?
Dialog: 0,0:49:17.03,0:49:22.70,Lalai,,0,0,0,,Pn. Hong ditakdirkan untuk memangsa\Bukan adik-beradiknya sepanjang hidupnya.
Dialog: 0,0:49:23.66,0:49:27.66,Lalai,,0,0,0,,Apa-apa pun, anda tidak perlu\Apa-apa lagi untuk berurusan dengannya.
Dialog: 0,0:49:27.75,0:49:30.23,Lalai,,0,0,0,,Meramal nasib adalah seperti Bible baginya.
Dialog: 0,0:49:30.25,0:49:33.23,Lalai,,0,0,0,,Jika anda mencari apa-apa dalam talian dan beritahu dia,
Dialog: 0,0:49:33.26,0:49:34.65, Lalai,,0,0,0,,dia hanya percaya.
Dialog: 0,0:49:34.68,0:49:37.75, Lalai,,0,0,0,,Tetapi itu berkesan untuk kelebihan anda.
Dialog: 0,0:49:38.26,0:49:43.93, Lalai,,0,0,0,,Itu benar. Saya telah mendapat banyak\N manfaat daripadanya selama kira-kira 15 tahun.
Dialog: 0,0:50:20.80,0:50:22.63, Lalai,,0,0,0,,Apa yang membawa anda ke sini?
Dialog: 0,0:50:25.48,0:50:27.33, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:50:27.35,0:50:32.13,Lalai,,0,0,0,,Jika saya tidak menarik balik saman itu, pusat beli-belah anda\Nin Gwanggyo tidak akan berlaku.
Dialog: 0,0:50:32.15,0:50:33.85, Lalai,,0,0,0,,Adakah anda mahu itu?
Dialog: 0,0:50:36.74,0:50:39.48, Lalai,,0,0,0,,Berhenti berdebar-debar.
Dialog: 0,0:50:39.87,0:50:41.57, Lalai,,0,0,0,, Beritahu saya sahaja.
Dialog: 0,0:50:42.95,0:50:45.68,Lalai,,0,0,0,,Apa yang awak beritahu Eun-sung tentang Soo-cheol?
Dialog: 0,0:50:45.70,0:50:49.81,Lalai,,0,0,0,,Apa yang anda katakan yang membuatkan dia\Ntidak mempertimbangkan untuk melabur dalam Soo-cheol?
Dialog: 0,0:50:49.83,0:50:51.02, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:50:51.04,0:50:52.44, Lalai,,0,0,0,, Jelas sekali.
Dialog: 0,0:50:52.46,0:50:57.40,Lalai,,0,0,0,,"Jika Soo-cheol mendapat pelaburan, itu tidak baik\Nuntuk saya, jadi melabur dalam Sang-jin sebaliknya."
Dialog: 0,0:50:57.42,0:50:59.86, Lalai,,0,0,0,, Kerana itu akan membuat pengerusi berang.
Dialog: 0,0:50:59.89,0:51:03.63, Lalai,,0,0,0,,Adakah anda rasa itu masuk akal?
Dialog: 0,0:51:03.68,0:51:06.41, Lalai,,0,0,0,,Ya! Saya rasa anda lebih\Ndaripada mampu melakukan itu,
Dialog: 0,0:51:06.43,0:51:09.97,Lalai,,0,0,0,,kerana awak perempuan\Nyang mementingkan diri sendiri.
Dialog: 0,0:51:10.02,0:51:14.12,Lalai,,0,0,0,,Anda tidak kisah jika sesiapa di sekeliling anda mati.\NAnda hanya mencari jalan untuk menyelamatkan diri,
Dialog: 0,0:51:14.15,0:51:16.73, Lalai,,0,0,0,,dan itulah sebabnya abang kamu...
Dialog: 0,0:51:25.83,0:51:28.64, Lalai,,0,0,0,,Dia berasa tidak sihat sejak pagi tadi.
Dialog: 0,0:51:28.66,0:51:30.14, Lalai,,0,0,0,,Saya rasa dia perlu berehat.
Dialog: 0,0:51:30.17,0:51:31.91, Lalai,,0,0,0,,Maafkan saya, Ibu.
Dialog: 0,0:51:32.79,0:51:35.90, Lalai,,0,0,0,,Jadi awak suruh saya pergi?
Dialog: 0,0:51:35.92,0:51:38.46, Lalai,,0,0,0,,Apabila saya masih bercakap dengannya?
Dialog: 0,0:51:40.63,0:51:42.34, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:52:19.30,0:52:21.08, Lalai,,0,0,0,,Mari beritahu keluarga anda.
Dialog: 0,0:52:22.34,0:52:23.32, Lalai,,0,0,0,,Saya kata tidak.
Dialog: 0,0:52:23.34,0:52:26.24,Lalai,,0,0,0,,Situasi seperti sebelum ini boleh berlaku pada bila-bila masa.
Dialog: 0,0:52:26.26,0:52:28.20, Lalai,,0,0,0,,Mereka mungkin mengetahui.
Dialog: 0,0:52:28.22,0:52:30.17, Lalai,,0,0,0,,Saya akan dirawat.
Dialog: 0,0:52:31.39,0:52:33.75, Lalai,,0,0,0,, Awak berlagak seperti saya akan mati esok.
Dialog: 0,0:52:33.77,0:52:35.51,Lalai,,0,0,0,,Anda sedang...
Dialog: 0,0:52:35.73,0:52:37.89, Lalai,,0,0,0,, mementingkan diri sendiri dan tidak bertanggungjawab.
Dialog: 0,0:52:38.32,0:52:39.79, Lalai,,0,0,0,,Ya.
Dialog: 0,0:52:39.82,0:52:44.36, Lalai,,0,0,0,,Anda sedang memikirkan tentang wang anda,\Nsaham, dan One Billion Club. saya faham.
Dialog: 0,0:52:44.57,0:52:49.74,Lalai,,0,0,0,,Saya dapati anda bimbang keluarga anda\Tidak boleh mengambil apa yang anda miliki jika mereka mengetahuinya,
Dialog: 0,0:52:49.83,0:52:51.53,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:52:52.37,0:52:55.07,Lalai,,0,0,0,,menjaga perkara penting ini daripada mereka...
Dialog: 0,0:52:55.13,0:52:58.08, Lalai,,0,0,0,,kerana anda tidak mahu apa-apa diambil.
Dialog: 0,0:52:58.63,0:53:00.16, Lalai,,0,0,0,,Betul ke?
Dialog: 0,0:53:03.22,0:53:05.38, Lalai,,0,0,0,,Saya tidak mahu mengejutkan mereka.
Dialog: 0,0:53:07.89,0:53:09.76, Lalai,,0,0,0,,Ibu bapa saya...
Dialog: 0,0:53:15.77,0:53:18.43, Lalai,,0,0,0,,Mereka sudah kehilangan seorang anak.
Dialog: 0,0:53:24.95,0:53:27.02, Lalai,,0,0,0,,Jadi mengapa menakutkan mereka?
Dialog: 0,0:53:30.33,0:53:33.03, Lalai,,0,0,0,,Saya tidak boleh menjadi anak yang baik, bagaimanapun.
Dialog: 0,0:53:33.33,0:53:35.03, Lalai,,0,0,0,,Saya cuma...
Dialog: 0,0:53:35.50,0:53:38.74,Lalai,,0,0,0,,tidak mahu menjadi kewujudan yang lebih\Nngerikan kepada keluarga saya,
Dialog: 0,0:53:39.50,0:53:41.58, Lalai,,0,0,0,, dan lebih penting lagi,
Dialog: 0,0:53:42.01,0:53:46.29,Lalai,,0,0,0,,Saya yakin saya akan sembuh,\Njadi berhenti melayan saya seperti pesakit.
Dialog: 0,0:53:53.56,0:53:55.16, Lalai,,0,0,0,,Bolehkah awak pergi?
Dialog: 0,0:53:55.19,0:53:56.72,Lalai,,0,0,0,,Saya mahu berehat.
Dialog: 0,0:54:10.24,0:54:11.93, Lalai,,0,0,0,,Dan pembelian saham?
Dialog: 0,0:54:11.95,0:54:16.41, Lalai,,0,0,0,,Kami membeli 14.7% secara keseluruhan, 4.9% setiap orang.
Dialog: 0,0:54:16.83,0:54:19.45, Lalai,,0,0,0,,Dan pengarah yang menyokong pengerusi?
Dialog: 0,0:54:26.13,0:54:29.53,Lalai,,0,0,0,,{\i1}Kadar pulangan kepercayaan\Nbuta terakhir adalah hampir 90%,{\i0}
Dialog: 0,0:54:29.55,0:54:32.82,Lalai,,0,0,0,,{\i1}jadi mereka tidak sabar-sabar untuk menyertai dana seterusnya.{\i0}
Dialog: 0,0:54:32.85,0:54:36.33, Lalai,,0,0,0,,Kita perlu memimpin mereka untuk meletakkan\NQueens saham sebagai cagaran seterusnya.
Dialog: 0,0:54:36.35,0:54:38.20, Lalai,,0,0,0,,Jumlah minimum sangat tinggi,
Dialog: 0,0:54:38.23,0:54:41.25,Lalai,,0,0,0,,Saya ragu mereka boleh mendapatkan\Ndengan wang tunai sebanyak itu dalam beberapa hari.
Dialog: 0,0:54:41.27,0:54:44.64, Lalai,,0,0,0,,Jika kita tergesa-gesa, mereka akan meletakkan\Nstok mereka sebagai cagaran.
Dialog: 0,0:54:45.40,0:54:47.56, Lalai,,0,0,0,,Seterusnya ialah Pengerusi Hong.
Dialog: 0,0:54:47.70,0:54:50.69, Lalai,,0,0,0,,Siasatan pendakwaan.
Dialog: 0,0:54:51.16,0:54:52.26, Lalai,,0,0,0,,Saya berasa kasihan kepadanya.
Dialog: 0,0:54:52.28,0:54:55.03, Lalai,,0,0,0,,Dia benci penjara.
Dialog: 0,0:54:58.21,0:55:00.99, Lalai,,0,0,0,,By the way, bagaimana anda akan melakukannya?
Dialog: 0,0:55:01.79,0:55:05.06,Lalai,,0,0,0,,{\i1}Penjaga keselamatan pengerusi yang sebenar...{\i0}
Dialog: 0,0:55:05.09,0:55:07.48,Lalai,,0,0,0,,{\i1}adalah Song Jeong-beom dalam Kewangan.{\i0}
Dialog: 0,0:55:07.51,0:55:12.80, Lalai,,0,0,0,,{\i1}Dia menyedut bahagiannya sendiri,\Nas serta dana lumpur pengerusi.{\i0}
Dialog: 0,0:55:13.10,0:55:16.08,Lalai,,0,0,0,,Kami akan menyerahkan semua bukti\Tidak pernah kepada pihak pendakwaan,
Dialog: 0,0:55:16.10,0:55:18.37, Lalai,,0,0,0,, dan semasa mereka melihat ke atas,
Dialog: 0,0:55:18.39,0:55:22.01, Lalai,,0,0,0,,mereka akan menyiasat pengerusi juga.
Dialog: 0,0:55:33.99,0:55:37.15, Lalai,,0,0,0,,Anda boleh melihat Queens Tower dari sini,
Dialog: 0,0:55:39.41,0:55:41.37, Lalai,,0,0,0,, dan saya suka itu.
Dialog: 0,0:55:41.83,0:55:45.83,Lalai,,0,0,0,,Rasanya saya sedang melihat hidangan yang lazat.
Dialog: 0,0:56:05.02,0:56:06.72, Lalai,,0,0,0,,Sialan.
Dialog: 0,0:56:07.40,0:56:10.05, Lalai,,0,0,0,,Saya suruh anda besarkan fon.
Dialog: 0,0:56:10.07,0:56:13.80, Lalai,,0,0,0,,Sialan. Sediakan dokumen\Naga dan tetapkan mesyuarat lain.
Dialog: 0,0:56:13.82,0:56:16.23, Lalai,,0,0,0,,Saya tidak percaya mereka.
Dialog: 0,0:56:16.62,0:56:18.24,Lalai,,0,0,0,,Keluar!
Dialog: 0,0:56:19.12,0:56:20.74, Lalai,,0,0,0,,Keluar!
Dialog: 0,0:56:29.59,0:56:32.15,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya rasa saya boleh membenarkan anda menyertai\Ndana ekuiti persendirian.{\c}{\i0}
Dialog: 0,0:56:32.18,0:56:34.70,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jumlah minimum ialah $20 juta,{\c}{\i0}
Dialog: 0,0:56:34.72,0:56:38.45, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan anda boleh meletakkan saham Queens\Nup anda sebagai cagaran jika anda kekurangan wang tunai.{\c}{\i0}
Dialog: 0,0:56:38.47,0:56:41.62, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kadar pendapatan dijangka\Nlebih tinggi. Pertama datang, dahulu dilayan,{\c}{\i0}
Dialog: 0,0:56:41.64,0:56:44.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi buat keputusan yang cepat.\NCerahsiaan adalah satu kemestian.{\c}{\i0}
Dialog: 0,0:56:44.73,0:56:46.33, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Terima kasih.\N- Saya faham.{\c}{\i0}
Dialog: 0,0:56:46.36,0:56:48.14,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Itu mungkin.{\c}{\i0}
Dialog: 0,0:56:51.19,0:56:53.01, Lalai,,0,0,0,,Dia sudah ada di sini.
Dialog: 0,0:56:53.03,0:56:56.02, Lalai,,0,0,0,,Apa yang terjadi pada Beom-ja?
Dialog: 0,0:56:56.49,0:57:00.07,Lalai,,0,0,0,,Mengapa dia tiba-tiba\Ningin menjamu saya?
Dialog: 0,0:57:05.58,0:57:07.70,Lalai,,0,0,0,,Pengerusi telah tiba.
Dialog: 0,0:57:25.73,0:57:27.29,Lalai,,0,0,0,,Tidak, Ayah. Anda tidak boleh pergi.
Dialog: 0,0:57:27.31,0:57:29.68, Lalai,,0,0,0,,- Di atas mayat saya.\N- Bergerak.
Dialog: 0,0:57:30.94,0:57:33.05, Lalai,,0,0,0,,Ayah, dengar cakap saya.
Dialog: 0,0:57:33.07,0:57:35.19, Lalai,,0,0,0,,Saya tidak mahu apa-apa lagi.
Dialog: 0,0:57:36.32,0:57:37.68, Lalai,,0,0,0,,Beri saya peluang sahaja.
Dialog: 0,0:57:37.70,0:57:38.93, Lalai,,0,0,0,,Awak brengsek.
Dialog: 0,0:57:38.95,0:57:41.19,Lalai,,0,0,0,,Bukankah saya telah memberi anda peluang?
Dialog: 0,0:57:41.24,0:57:45.78,Lalai,,0,0,0,,Saya beri awak satu, tetapi awak jual saya\Nout kepada pihak pendakwaan untuk menyelamatkan diri!
Dialog: 0,0:57:46.25,0:57:49.52,Lalai,,0,0,0,,Semasa saya dikurung,\Nyou merancang untuk menggantikan saya...
Dialog: 0,0:57:49.54,0:57:52.15, Lalai,,0,0,0,,dengan pengarah yang menyokong anda.
Dialog: 0,0:57:52.17,0:57:54.65,Lalai,,0,0,0,,- Adakah anda terlupa?\N- Saya tidak waras.
Dialog: 0,0:57:54.67,0:57:59.20,Lalai,,0,0,0,,Saya dengar anda cuba menyematkan\N tuduhan penyelewengan ke atas saya,
Dialog: 0,0:57:59.22,0:58:00.32, Lalai,,0,0,0,,jadi saya kehilangannya.
Dialog: 0,0:58:00.35,0:58:02.76, Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,0:58:03.77,0:58:05.45, Lalai,,0,0,0,,Sudah 20 tahun.
Dialog: 0,0:58:05.48,0:58:07.96,Lalai,,0,0,0,,Anda akan memaafkan\Na orang asing selepas ini.
Dialog: 0,0:58:07.98,0:58:09.79,Lalai,,0,0,0,,Mengapa kamu begitu keras terhadap anak kamu?
Dialog: 0,0:58:09.81,0:58:12.04, Lalai,,0,0,0,,Saya lebih suka memaafkan orang yang tidak dikenali!
Dialog: 0,0:58:12.07,0:58:15.39,Lalai,,0,0,0,,Bagaimana saya boleh memaafkan\Anak saya yang mengkhianati saya?
Dialog: 0,0:58:16.32,0:58:18.19, Lalai,,0,0,0,,Saya tidak boleh,
Dialog: 0,0:58:18.57,0:58:20.55, Lalai,,0,0,0,,jadi jangan lakukan perkara seperti ini lagi.
Dialog: 0,0:58:20.58,0:58:22.19, Lalai,,0,0,0,,Ayah!
Dialog: 0,0:58:22.58,0:58:24.35, Lalai,,0,0,0,,Saya merindui awak.
Dialog: 0,0:58:24.37,0:58:26.78, Lalai,,0,0,0,,Itulah sebabnya saya datang.
Dialog: 0,0:58:29.96,0:58:32.08, Lalai,,0,0,0,,Nah, anda telah melihat saya sekarang.
Dialog: 0,0:58:33.55,0:58:35.25, Lalai,,0,0,0,,Saya tidak mahu...
Dialog: 0,0:58:35.55,0:58:37.46, Lalai,,0,0,0,,jumpa lagi.
Dialog: 0,0:58:37.72,0:58:39.49, Lalai,,0,0,0,,Anda tidak berterima kasih.
Dialog: 0,0:58:39.51,0:58:41.80, Lalai,,0,0,0,,Jangan datang ke pengebumian saya.
Dialog: 0,0:58:44.72,0:58:46.63, Lalai,,0,0,0,, Sial.
Dialog: 0,0:59:05.91,0:59:08.36, Lalai,,0,0,0,,Kenapa awak pandang rendah sangat?
Dialog: 0,0:59:08.96,0:59:11.16, Lalai,,0,0,0,,Nampaknya awak belum makan.
Dialog: 0,0:59:14.55,0:59:16.54, Lalai,,0,0,0,,Apabila anda tidak sihat,
Dialog: 0,0:59:16.67,0:59:18.28, Lalai,,0,0,0,,tidak ada yang lebih baik daripada...
Dialog: 0,0:59:18.30,0:59:21.21, Lalai,,0,0,0,,semangkuk ini.
Dialog: 0,0:59:22.22,0:59:26.45,Lalai,,0,0,0,,Ibu saya selalu buat saya begini semasa saya sakit.
Dialog: 0,0:59:26.47,0:59:30.91,Lalai,,0,0,0,,Dulu ketika saya menjual surat khabar\Nand menyerikan kasut orang di Myeong-dong.
Dialog: 0,0:59:30.94,0:59:33.64, Lalai,,0,0,0,,Apabila saya lapar atau sakit,
Dialog: 0,0:59:35.40,0:59:38.64, Lalai,,0,0,0,,Saya selalu memikirkan perkara ini.
Dialog: 0,0:59:38.74,0:59:40.65, Lalai,,0,0,0,,Ada beberapa.
Dialog: 0,0:59:41.07,0:59:45.86, Lalai,,0,0,0,,Dari tidur di jalanan\Nusing surat khabar sebagai selimut,
Dialog: 0,0:59:45.95,0:59:51.77, Lalai,,0,0,0,,untuk memiliki salah satu kedai jabatan dan francais pasar terkemuka di Korea,
Dialog: 0,0:59:51.79,0:59:54.33, Lalai,,0,0,0,,ia mengambil masa 60 tahun,
Dialog: 0,0:59:55.17,0:59:58.41,Lalai,,0,0,0,,tapi kenapa rasanya...
Dialog: 0,0:59:58.63,1:00:01.32,Lalai,,0,0,0,,Saya berdiri sendirian di padang gurun?
Dialog: 0,1:00:01.34,1:00:04.49,Lalai,,0,0,0,,Sesuatu pasti telah menyakiti perasaan anda dengan teruk.
Dialog: 0,1:00:04.51,1:00:07.26,Lalai,,0,0,0,,Hanya saya yang tahu betapa lembutnya hati...
Dialog: 0,1:00:07.39,1:00:09.34,Lalai,,0,0,0,,anda.
Dialog: 0,1:00:22.45,1:00:25.07,Lalai,,0,0,0,,Rasanya seperti...
Dialog: 0,1:00:25.49,1:00:27.74,Lalai,,0,0,0,,ibu saya.
Dialog: 0,1:00:34.46,1:00:36.10,Lalai,,0,0,0,,Mengapa anda tidak boleh memberi kami bayaran balik?
Dialog: 0,1:00:36.13,1:00:38.73,Lalai,,0,0,0,,Kulit bayi saya rosak selepas dia menggunakan ini,
Dialog: 0,1:00:38.76,1:00:42.15,Lalai,,0,0,0,,tetapi anda tidak boleh memberikan bayaran balik kepada kami,\Napalagi memberi pampasan kepada kami?
Dialog: 0,1:00:42.18,1:00:45.45,Lalai,,0,0,0,,Tuan, sudah lebih lapan bulan\Nsejak anda membeli produk,
Dialog: 0,1:00:45.47,1:00:47.66,Lalai,,0,0,0,,dan anda hampir menggunakan kesemuanya.
Dialog: 0,1:00:47.68,1:00:49.58,Lalai,,0,0,0,,Hei. Saya gembira anda membangkitkannya.
Dialog: 0,1:00:49.60,1:00:52.45,Lalai,,0,0,0,,Muka saya kelihatan begini\Nkerana saya menggunakan sebanyak ini.
Dialog: 0,1:00:52.48,1:00:55.54,Lalai,,0,0,0,,Jika saya tidak, kulit saya\Ntakkan jadi begini!
Dialog: 0,1:00:55.56,1:00:59.02,Lalai,,0,0,0,,Sayang, jangan bosan. Ia akan menjadi lebih teruk.
Dialog: 0,1:00:59.07,1:01:01.05,Lalai,,0,0,0,,Beri kami bayaran balik sekarang.
Dialog: 0,1:01:01.07,1:01:02.92,Lalai,,0,0,0,,Tuan, kami tidak boleh berbuat demikian.
Dialog: 0,1:01:02.95,1:01:05.65,Lalai,,0,0,0,,Bukankah saya cukup jelas?
Dialog: 0,1:01:09.16,1:01:11.31,Lalai,,0,0,0,,Tuan, sila bertenang.
Dialog: 0,1:01:11.33,1:01:13.86,Lalai,,0,0,0,,Bagaimanakah saya boleh bertenang?
Dialog: 0,1:01:14.29,1:01:18.35,Lalai,,0,0,0,,Betul. Anda fikir saya salah seorang daripada pelanggan\Nobnoxious itu, bukan?
Dialog: 0,1:01:18.38,1:01:21.08,Lalai,,0,0,0,,Mahu saya tunjukkan perkara sebenar?
Dialog: 0,1:01:25.34,1:01:28.34,Lalai,,0,0,0,,Tuan, anda tidak boleh melakukan ini di sini.
Dialog: 0,1:01:29.22,1:01:33.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mahu menggunakan deposit keselamatan kami untuk\pembedahannya, tetapi ibu saya tidak mahu mendengar.{\c}{\i0}
Dialog: 0,1:01:36.19,1:01:40.08,Lalai,,0,0,0,,Ini adalah permintaan\N yang tidak munasabah. Kami tidak boleh membantu anda.
Dialog: 0,1:01:40.11,1:01:41.54, Lalai,,0,0,0,,"Tidak Munasabah"?
Dialog: 0,1:01:41.57,1:01:45.44,Lalai,,0,0,0,,Anda tiada harapan. Kemarilah.\Nberaninya awak bercakap dengan saya...?
Dialog: 0,1:01:49.91,1:01:51.86,Lalai,,0,0,0,,Siapa awak?
Dialog: 0,1:01:51.99,1:01:53.56,Lalai,,0,0,0,,Lepaskan.
Dialog: 0,1:01:53.58,1:01:55.57,Lalai,,0,0,0,,Lepaskan saya.
Dialog: 0,1:01:58.29,1:02:00.10, Lalai,,0,0,0,,Ini bukan tempat untuk kelakuan sedemikian.
Dialog: 0,1:02:00.13,1:02:03.73,Lalai,,0,0,0,,Lihat, saya tiada urusan dengan kamu anak ikan kecil.
Dialog: 0,1:02:03.76,1:02:04.94,Lalai,,0,0,0,,Bawa CEO anda.
Dialog: 0,1:02:04.97,1:02:07.57,Lalai,,0,0,0,,Bawa CEO anda sekarang!
Dialog: 0,1:02:07.59,1:02:09.24,Lalai,,0,0,0,,- Dia ada di sini.\N- Apa?
Dialog: 0,1:02:09.26,1:02:11.30,Lalai,,0,0,0,,Saya CEO.
Dialog: 0,1:02:12.14,1:02:13.41,Lalai,,0,0,0,,Adakah anda CEO?
Dialog: 0,1:02:13.43,1:02:15.87,Lalai,,0,0,0,,Mengapa anda tidak melatih pekerja anda dengan betul?
Dialog: 0,1:02:15.89,1:02:18.89,Lalai,,0,0,0,,Anda betul. Saya rasa saya tidak melakukannya dengan betul.
Dialog: 0,1:02:20.98,1:02:22.81,Lalai,,0,0,0,,Pn. Kim Min-ji?
Dialog: 0,1:02:23.44,1:02:25.13,Lalai,,0,0,0,,Berurusan dengan pelanggan kami sahaja.
Dialog: 0,1:02:25.15,1:02:28.05,Lalai,,0,0,0,,Bagi penjenayah, laporkan mereka\Nkepada polis tanpa amaran.
Dialog: 0,1:02:28.07,1:02:30.38,Lalai,,0,0,0,,Apa? Penjenayah?
Dialog: 0,1:02:30.41,1:02:32.80,Lalai,,0,0,0,,Anda memanggil pelanggan anda penjenayah?
Dialog: 0,1:02:32.83,1:02:34.64,Lalai,,0,0,0,,Babe, adakah anda merakam ini?
Dialog: 0,1:02:34.66,1:02:35.89,Lalai,,0,0,0,,Ya.
Dialog: 0,1:02:35.91,1:02:38.68,Lalai,,0,0,0,,Ketua Pegawai Eksekutif pusat beli-belah ini memandang\Nkesian pelanggannya.
Dialog: 0,1:02:38.71,1:02:40.98,Lalai,,0,0,0,,Mari kita saman dia dan ajar dia.
Dialog: 0,1:02:41.00,1:02:42.95,Lalai,,0,0,0,,Mari kita lakukan itu.
Dialog: 0,1:02:43.59,1:02:45.19,Lalai,,0,0,0,,Pastikan anda melakukannya.
Dialog: 0,1:02:45.21,1:02:46.92,Lalai,,0,0,0,,Saya juga akan.
Dialog: 0,1:02:47.93,1:02:50.82,Lalai,,0,0,0,,Saya tahu betul, kerana suami saya seorang peguam yang baik.
Dialog: 0,1:02:50.85,1:02:52.07,Lalai,,0,0,0,,Anda boleh dicaj...
Dialog: 0,1:02:52.10,1:02:55.03,Lalai,,0,0,0,,dengan halangan perniagaan, serangan khas,
Dialog: 0,1:02:55.06,1:02:57.41,Lalai,,0,0,0,,dan kerosakan harta benda,
Dialog: 0,1:02:57.44,1:03:02.39,Lalai,,0,0,0,,dan saya akan memfailkan saman lain untuk\Nkerugian jualan yang anda sebabkan.
Dialog: 0,1:03:02.52,1:03:04.75,Lalai,,0,0,0,,- Adakah anda semua merakamnya?\N- Ya, kami lakukan!
Dialog: 0,1:03:04.78,1:03:07.98,Lalai,,0,0,0,,- Saya lakukan. Di sini!\N- Sila beri laluan.
Dialog: 0,1:03:09.24,1:03:10.55,Lalai,,0,0,0,,Bawa mereka kepada polis.
Dialog: 0,1:03:10.57,1:03:12.65,Lalai,,0,0,0,,Jom, Babe.
Dialog: 0,1:03:20.46,1:03:22.53,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:03:25.38,1:03:28.46,Lalai,,0,0,0,,By the way, Encik Baek, tentang Park Seok-hun.
Dialog: 0,1:03:28.59,1:03:30.36,Lalai,,0,0,0,,Bagaimana dengan dia?
Dialog: 0,1:03:30.38,1:03:33.07,Lalai,,0,0,0,,Dia berkeliling sambil berkata...
Dialog: 0,1:03:33.10,1:03:38.08,Lalai,,0,0,0,,bahawa Yongdu Pear yang anda promosikan\Nas kepakaran kampung kami tidak mempunyai masa depan.
Dialog: 0,1:03:38.10,1:03:40.54,Lalai,,0,0,0,,Dia mendakwa Epal Yongdu akan...
Dialog: 0,1:03:40.56,1:03:42.96,Lalai,,0,0,0,,kegilaan K-food baharu di seluruh dunia.
Dialog: 0,1:03:42.98,1:03:44.79,Lalai,,0,0,0,,Apple? Kebaikan.
Dialog: 0,1:03:44.82,1:03:46.34,Lalai,,0,0,0,,Itu mengarut.
Dialog: 0,1:03:46.36,1:03:48.80,Lalai,,0,0,0,,Secara tradisinya, epal tidak sepadan dengan pear.
Dialog: 0,1:03:48.82,1:03:51.05,Lalai,,0,0,0,,Sudah tentu... Betul?
Dialog: 0,1:03:51.07,1:03:54.05,Lalai,,0,0,0,,Cuma fikirkan tentang perkhidmatan peringatan.
Dialog: 0,1:03:54.08,1:03:56.60,Lalai,,0,0,0,,Kami meletakkan pear di atas meja, bukan epal!
Dialog: 0,1:03:56.62,1:04:00.72,Lalai,,0,0,0,,Selain itu, kesemak dan pear pergi\Bersama. Kesemak dan epal tidak.
Dialog: 0,1:04:00.75,1:04:04.98,Lalai,,0,0,0,,Beraninya dia memperkecilkan kepentingan\Nof pear, buah tradisional kita?
Dialog: 0,1:04:05.00,1:04:07.36,Lalai,,0,0,0,,Bagaimanapun, lelaki ini berlari...
Dialog: 0,1:04:07.38,1:04:11.11,Lalai,,0,0,0,,kempen pilihan raya dengan cara yang bijak.
Dialog: 0,1:04:11.13,1:04:13.57,Lalai,,0,0,0,,Anda tahu restoran ibunya?
Dialog: 0,1:04:13.59,1:04:18.45,Lalai,,0,0,0,,Dia menawarkan makan tengah hari separuh harga,\Njadi semua orang makan di sana sekarang.
Dialog: 0,1:04:18.47,1:04:19.49,Lalai,,0,0,0,,Bodoh!
Dialog: 0,1:04:19.52,1:04:21.47,Lalai,,0,0,0,,Kenapa awak tidak beritahu saya lebih awal?
Dialog: 0,1:04:21.69,1:04:23.37,Lalai,,0,0,0,,Si kecil itu...!
Dialog: 0,1:04:23.40,1:04:25.96,Lalai,,0,0,0,,Dia tidak bermain adil, bukan?
Dialog: 0,1:04:25.98,1:04:28.31,Lalai,,0,0,0,,Adakah anda akan ke sana?
Dialog: 0,1:04:28.78,1:04:30.36,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Makan Tengah Hari Separuh Harga{\c}{\i0}
Dialog: 0,1:04:37.74,1:04:38.72,Lalai,,0,0,0,,Helo.
Dialog: 0,1:04:38.74,1:04:40.18,Lalai,,0,0,0,,Hei, Encik Park.
Dialog: 0,1:04:40.20,1:04:42.14,Lalai,,0,0,0,,Sup sangat sedap hari ini.
Dialog: 0,1:04:42.16,1:04:43.98,Lalai,,0,0,0,,Ayuh. Ia sentiasa baik.
Dialog: 0,1:04:44.00,1:04:46.69,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:04:46.71,1:04:48.86,Lalai,,0,0,0,,Ia seperti kenduri.
Dialog: 0,1:04:48.88,1:04:51.86,Lalai,,0,0,0,,Kita harus bersaing dengan ikrar dan rancangan,
Dialog: 0,1:04:51.88,1:04:55.57,Lalai,,0,0,0,,tetapi dia cuba memenangi orang\Tidak pernah dengan lagu popular.
Dialog: 0,1:04:55.60,1:04:59.62,Lalai,,0,0,0,,Maksud saya, jika dia memenangi pilihan raya seperti ini,\Ni bukan kemenangannya. Itu milik penyanyi!
Dialog: 0,1:04:59.64,1:05:04.25,Lalai,,0,0,0,,Ia harus dianggap sebagai\pelanggaran undang-undang Pilihan Raya. ya.
Dialog: 0,1:05:04.27,1:05:06.21,Lalai,,0,0,0,,Chun-sik, kumpulkan bukti.
Dialog: 0,1:05:06.23,1:05:10.93,Lalai,,0,0,0,,Mereka yang menghiburkan dan mereka yang\Nbermain bersama. Saya akan melaporkan semuanya!
Dialog: 0,1:05:11.15,1:05:12.98,Lalai,,0,0,0,,Ayuh!
Dialog: 0,1:05:16.24,1:05:18.11,Lalai,,0,0,0,,Kamu semua akan ditakdirkan.
Dialog: 0,1:05:20.24,1:05:22.24,Lalai,,0,0,0,,Tunggu. apa...?
Dialog: 0,1:05:22.66,1:05:24.57,Lalai,,0,0,0,,- Encik Baek.\N- Apa?
Dialog: 0,1:05:34.30,1:05:37.74,Lalai,,0,0,0,,Seok-hun! Saya akan mempunyai satu lagi pinggan daging babi.
Dialog: 0,1:05:37.76,1:05:38.86,Lalai,,0,0,0,,Satu lagi soju juga!
Dialog: 0,1:05:38.89,1:05:41.45,Lalai,,0,0,0,,Sangat sedap!
Dialog: 0,1:05:41.47,1:05:43.93,Lalai,,0,0,0,,Sekeping...!
Dialog: 0,1:05:44.02,1:05:45.16,Lalai,,0,0,0,,Anda anak kepada...!
Dialog: 0,1:05:45.19,1:05:46.29,Lalai,,0,0,0,,Saya patut...!
Dialog: 0,1:05:46.31,1:05:47.54,Lalai,,0,0,0,,Seberapa teruknya?
Dialog: 0,1:05:47.56,1:05:50.29,Lalai,,0,0,0,,Dia masuk ke dalam perangkap mereka.
Dialog: 0,1:05:50.32,1:05:55.05,Lalai,,0,0,0,,Rasuah keluarga. Ini adalah isu yang tidak dapat dielakkan oleh presiden negara.
Dialog: 0,1:05:55.07,1:05:58.80,Lalai,,0,0,0,,Anak ketua kampung sekarang membiarkan\Nsebelah menjamunya makan.
Dialog: 0,1:05:58.82,1:06:02.26,Default,,0,0,0,,Orang cakap keluarga ketua dah hancur,
Dialog: 0,1:06:02.29,1:06:05.56,Lalai,,0,0,0,,kerana anak-anaknya\Ntidak berdisiplin dengan betul.
Dialog: 0,1:06:05.58,1:06:06.85,Lalai,,0,0,0,,Bodoh!
Dialog: 0,1:06:06.87,1:06:08.66,Lalai,,0,0,0,,Saya tidak percaya anda!
Dialog: 0,1:06:10.34,1:06:12.65,Lalai,,0,0,0,,Ayah, saya akan tukar pendapat mereka.
Dialog: 0,1:06:12.67,1:06:13.90,Lalai,,0,0,0,,Apa yang boleh anda lakukan?
Dialog: 0,1:06:13.92,1:06:15.98,Lalai,,0,0,0,,Salun saya menghasilkan kira-kira 90%
Dialog: 0,1:06:16.01,1:06:18.70, Lalai,,0,0,0,, khabar angin yang tersebar di Yongdu-ri.
Dialog: 0,1:06:18.72,1:06:20.84,Lalai,,0,0,0,,Kamu tahu, tukang gosip!
Dialog: 0,1:06:21.06,1:06:23.91,Lalai,,0,0,0,,- Kita boleh menggunakannya.\N- Seperti kempen fitnah?
Dialog: 0,1:06:23.93,1:06:27.08,Lalai,,0,0,0,,Tepat! Seok-hun mencuri makanan ringan dari kedai kami...
Dialog: 0,1:06:27.10,1:06:28.37,Lalai,,0,0,0,,ketika dia masih kecil.
Dialog: 0,1:06:28.40,1:06:29.62,Lalai,,0,0,0,,Kami akan mendedahkannya.
Dialog: 0,1:06:29.65,1:06:33.43,Lalai,,0,0,0,,"Siapa yang mencuri telur akan mencuri lembu!"
Dialog: 0,1:06:33.73,1:06:35.60,Lalai,,0,0,0,,Apa pendapat anda?
Dialog: 0,1:06:36.70,1:06:38.01,Lalai,,0,0,0,,Ada rokok?
Dialog: 0,1:06:38.03,1:06:39.94,Lalai,,0,0,0,,Saya berhenti merokok.
Dialog: 0,1:06:56.76,1:06:57.99,Lalai,,0,0,0,,Mi-seon, awak akan datang?
Dialog: 0,1:06:58.01,1:07:00.99,Lalai,,0,0,0,,Ayah kamu dan Seok-hun\Nakan bertentang mata.
Dialog: 0,1:07:01.01,1:07:02.36,Lalai,,0,0,0,,Teruskan.
Dialog: 0,1:07:02.39,1:07:08.12,Lalai,,0,0,0,,Saya tidak fikir begitu. Keluarga anda memerlukan seramai mungkin orang di pihak mereka.
Dialog: 0,1:07:08.14,1:07:10.33,Lalai,,0,0,0,,- Mengapa?\N- Apakah yang anda maksudkan, "mengapa"?
Dialog: 0,1:07:10.35,1:07:13.25,Lalai,,0,0,0,,Sebab kepala berada dalam keadaan yang kurang baik sekarang.
Dialog: 0,1:07:13.27,1:07:14.84,Lalai,,0,0,0,,Terus!
Dialog: 0,1:07:14.86,1:07:15.92,Lalai,,0,0,0,, Datang sahaja!
Dialog: 0,1:07:15.94,1:07:18.13,Lalai,,0,0,0,,Ya ampun! Pergi sahaja!
Dialog: 0,1:07:18.15,1:07:19.63,Lalai,,0,0,0,,Tidak, Pinky!
Dialog: 0,1:07:19.66,1:07:21.55,Lalai,,0,0,0,,Anda masuk semula.
Dialog: 0,1:07:21.57,1:07:24.09,Lalai,,0,0,0,,{\i1}Saya berdiri di sini...{\i0}
Dialog: 0,1:07:24.12,1:07:26.97,Lalai,,0,0,0,,{\i1}kerana kampung kita memerlukan orang muda.{\i0}
Dialog: 0,1:07:27.00,1:07:28.31,Lalai,,0,0,0,,Seperti yang saya katakan tadi,
Dialog: 0,1:07:28.33,1:07:32.44,Lalai,,0,0,0,,Saya akan menjadikan Epal Yongdu sebagai K-food\Digemari oleh orang di seluruh dunia!
Dialog: 0,1:07:32.46,1:07:37.46,Lalai,,0,0,0,,Saya, Park Seok-hun, akan pulih\Ndua tahun Yongdu-ri hilang!
Dialog: 0,1:07:39.55,1:07:41.15,Lalai,,0,0,0,,Dia diterima dengan baik.
Dialog: 0,1:07:41.18,1:07:42.88,Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,1:07:43.35,1:07:45.30,Lalai,,0,0,0,,Tidak apa-apa.
Dialog: 0,1:07:46.68,1:07:48.74,Lalai,,0,0,0,,Semua orang, Yongdu-ri kami...
Dialog: 0,1:07:48.77,1:07:51.83,Lalai,,0,0,0,,ibarat jantung buah pear Korea.
Dialog: 0,1:07:51.85,1:07:55.83,Lalai,,0,0,0,,Nah, bukankah jantung pear Naju atau Seongju?
Dialog: 0,1:07:55.86,1:08:00.51,Lalai,,0,0,0,,Betul! Yongdu-ri bukan\Nhati. Ia lebih seperti...
Dialog: 0,1:08:00.53,1:08:01.59,Lalai,,0,0,0,,Bagaimana cara saya meletakkannya?
Dialog: 0,1:08:01.61,1:08:04.38,Lalai,,0,0,0,,Ia lebih seperti usus.
Dialog: 0,1:08:04.41,1:08:06.03,Lalai,,0,0,0,,Adakah saya betul?
Dialog: 0,1:08:06.66,1:08:09.89,Lalai,,0,0,0,,Betul. Jika itu hati, pir kita...
Dialog: 0,1:08:09.91,1:08:14.06,Lalai,,0,0,0,,akan dijual di kedai serbaneka anak perempuannya-\Nin-law.
Dialog: 0,1:08:14.09,1:08:16.12,Lalai,,0,0,0,,Anda betul!
Dialog: 0,1:08:17.96,1:08:21.32,Lalai,,0,0,0,,Apa? Mengapa membawa perkara itu di sini?
Dialog: 0,1:08:21.34,1:08:22.61,Lalai,,0,0,0,,Menantu saya...
Dialog: 0,1:08:22.64,1:08:25.32,Lalai,,0,0,0,,menjauhkan pekerjaan dan kehidupan peribadinya!
Dialog: 0,1:08:25.35,1:08:27.87,Lalai,,0,0,0,,Saya faham dia seorang CEO yang baik,
Dialog: 0,1:08:27.89,1:08:28.91,Lalai,,0,0,0,,tetapi kehidupan peribadinya?
Dialog: 0,1:08:28.93,1:08:32.25,Lalai,,0,0,0,,Sejujurnya, kami hanya mendengar\Ndia dan anak kamu berkahwin.
Dialog: 0,1:08:32.27,1:08:35.87,Lalai,,0,0,0,,- Kami tidak pernah melihatnya.\N- Bukankah dia datang dengan helikopter?
Dialog: 0,1:08:35.90,1:08:38.75,Lalai,,0,0,0,,Betul. Saya fikir perang telah meletus ketika itu.
Dialog: 0,1:08:38.78,1:08:41.76,Lalai,,0,0,0,,Memang dia tidak pernah\Ndilawati sejak mereka berkahwin.
Dialog: 0,1:08:41.78,1:08:44.19,Lalai,,0,0,0,,Itu sebelum mereka berkahwin?
Dialog: 0,1:08:45.83,1:08:47.55,Lalai,,0,0,0,,- Apa?\N- Apa yang sedang berlaku?
Dialog: 0,1:08:47.58,1:08:50.90,Lalai,,0,0,0,,- Adakah ia gempa bumi?\N- Apa yang sedang berlaku?
Dialog: 0,1:08:51.29,1:08:52.75,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Dewan Masyarakat Yongdu-ri{\c}{\i0}
Dialog: 0,1:08:59.59,1:09:02.62,Lalai,,0,0,0,,- Apa itu?\N- Rakamkannya.
Dialog: 0,1:09:03.01,1:09:05.29,Lalai,,0,0,0,,Mereka membawa banyak.
Dialog: 0,1:09:35.08,1:09:36.95,Lalai,,0,0,0,,Bapa?
Dialog: 0,1:09:38.42,1:09:39.81,Lalai,,0,0,0,,Ya ampun.
Dialog: 0,1:09:39.84,1:09:41.75,Lalai,,0,0,0,,Oh, saya.
Dialog: 0,1:09:51.52,1:09:53.17,Lalai,,0,0,0,,Tidak mungkin...
Dialog: 0,1:09:55.39,1:09:56.71,Lalai,,0,0,0,,Dia datang.
Dialog: 0,1:09:56.73,1:09:58.64,Lalai,,0,0,0,,Akhirnya.
Dialog: 0,1:10:05.40,1:10:09.01,Lalai,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,1:10:09.03,1:10:11.05,Lalai,,0,0,0,,Saya gembira anda semua ada di sini.
Dialog: 0,1:10:11.08,1:10:13.26,Lalai,,0,0,0,,Saya terlepas hari lahir terakhir awak,
Dialog: 0,1:10:13.29,1:10:17.66,Lalai,,0,0,0,,jadi saya datang untuk menjamu orang kampung.
Dialog: 0,1:10:20.46,1:10:25.37,Lalai,,0,0,0,,Helo, saya Hong Hae-in, menantu perempuan\N ketua kampung.
Dialog: 0,1:10:29.14,1:10:30.41,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:10:30.43,1:10:31.99,Lalai,,0,0,0,,Saya menghantar mesej kepadanya.
Dialog: 0,1:10:32.01,1:10:35.29,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda kata anda akan melawat kami satu hari ini.{\c}{\i0}
Dialog: 0,1:10:35.31,1:10:39.37,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bolehkah hari itu hari ini dan sekarang?{\c}{\i0}
Dialog: 0,1:10:39.40,1:10:43.75,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ayah saya bertanding untuk pemilihan semula,\Nand ia tidak kelihatan baik.{\c}{\i0}
Dialog: 0,1:10:43.78,1:10:48.56,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya rasa dia perlu menunjukkan kepada orang\Nseseorang yang berpengaruh menyokongnya.{\c}{\i0}
Dialog: 0,1:10:56.76,1:10:59.28,Lalai,,0,0,0,,Dia membacanya! Ia berkata "baca."
Dialog: 0,1:11:03.05,1:11:05.25,Lalai,,0,0,0,,Dia datang kerana teks itu?
Dialog: 0,1:11:05.30,1:11:07.17,Lalai,,0,0,0,,Saya juga tidak percaya.
Dialog: 0,1:11:07.88,1:11:10.38,Lalai,,0,0,0,,Bagus!
Dialog: 0,1:11:11.10,1:11:12.41,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:11:12.43,1:11:13.78,Lalai,,0,0,0,,Ia tidak banyak.
Dialog: 0,1:11:13.81,1:11:16.99,Lalai,,0,0,0,,Suplemen pemakanan yang mahal, ginseng,
Dialog: 0,1:11:17.02,1:11:20.21,Lalai,,0,0,0,,kosmetik, tudung sutera, peredam kasmir,
Dialog: 0,1:11:20.23,1:11:22.50,Lalai,,0,0,0,,Sarung tangan kulit Itali, dan seterusnya.
Dialog: 0,1:11:22.52,1:11:25.25,Lalai,,0,0,0,,Saya akan membeli sedikit untuk Ayah,
Dialog: 0,1:11:25.28,1:11:26.46,Lalai,,0,0,0,,tetapi saya melampaui batas.
Dialog: 0,1:11:26.49,1:11:28.34,Lalai,,0,0,0,,Anda boleh berkongsi.
Dialog: 0,1:11:28.36,1:11:31.05,Lalai,,0,0,0,,Oh, saya. Saya tak percaya awak.
Dialog: 0,1:11:31.07,1:11:34.28,Lalai,,0,0,0,,Anda membeli terlalu banyak.
Dialog: 0,1:11:36.16,1:11:39.10,Lalai,,0,0,0,,- Baek Du-gwan!\N- Baek Du-gwan!
Dialog: 0,1:11:39.12,1:11:44.02,Lalai,,0,0,0,,- Hae-in!\N- Baek Du-gwan!
Dialog: 0,1:11:44.04,1:11:47.27,Lalai,,0,0,0,,Semua orang! Apakah keistimewaan Yongdu-ri? Epal atau pir?
Dialog: 0,1:11:47.30,1:11:49.58,Lalai,,0,0,0,,- Pear!\N- Pear!
Dialog: 0,1:11:50.59,1:11:53.66,Lalai,,0,0,0,,- Baek Du-gwan!\N- Baek Du-gwan!
Dialog: 0,1:11:53.68,1:11:56.07,Lalai,,0,0,0,,- Hae-in!\N- Baek Du-gwan!
Dialog: 0,1:11:56.10,1:11:58.35,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Baek Du-gwan\NA pekerja keras yang melindungi Yongdu-ri{\c}{\i0}
Dialog: 0,1:12:27.71,1:12:31.17,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo. Hae-in di sini.{\c}{\i0}
Dialog: 0,1:12:34.47,1:12:36.57,Lalai,,0,0,0,,- Hei.\N- {\i1}Ibu, saya terlepas panggilan awak.{\i0}
Dialog: 0,1:12:36.60,1:12:38.78,Lalai,,0,0,0,,Tidak apa-apa. apa khabar
Dialog: 0,1:12:38.81,1:12:42.58,Lalai,,0,0,0,,Saya dengar Mi-seon dan Hyeon-tae pergi\N sana. Anda pasti terkejut.
Dialog: 0,1:12:42.60,1:12:46.17,Lalai,,0,0,0,,Tidak, tidak mengapa. Tiada apa-apa yang buruk\Nberlaku, jadi jangan risau.
Dialog: 0,1:12:46.19,1:12:47.46,Lalai,,0,0,0,,{\i1}Dan Hae-in ialah...{\i0}
Dialog: 0,1:12:47.48,1:12:49.44,Lalai,,0,0,0,,Ya, dia juga sihat.
Dialog: 0,1:12:49.47,1:12:50.50,Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,1:12:50.53,1:12:52.56,Lalai,,0,0,0,,{\i1}Adakah kamu berdua bergaduh?{\i0}
Dialog: 0,1:12:53.95,1:12:54.92,Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,1:12:54.95,1:12:57.68,Lalai,,0,0,0,,Kalau begitu kenapa anda tidak tahu di mana dia?
Dialog: 0,1:12:57.70,1:12:59.64,Lalai,,0,0,0,,{\i1}Dia di sini.{\i0}
Dialog: 0,1:12:59.66,1:13:01.72,Lalai,,0,0,0,,Apa? Mengapa dia berada di sana?
Dialog: 0,1:13:01.75,1:13:03.48,Lalai,,0,0,0,,{\i1}Anda harus datang bertanya kepadanya sendiri.{\i0}
Dialog: 0,1:13:03.50,1:13:06.91,Lalai,,0,0,0,,{\i1}Seluruh kampung mengadakan\Na kenduri, terima kasih kepadanya.{\i0}
Dialog: 0,1:13:08.30,1:13:10.33,Lalai,,0,0,0,,Apa yang dia cakapkan?
Dialog: 0,1:13:12.26,1:13:14.63,Lalai,,0,0,0,,Di manakah Hae-in sekarang?
Dialog: 0,1:13:41.37,1:13:43.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:15:05.62,1:15:07.53,Lalai,,0,0,0,,Siapa awak?
Dialog: 0,1:15:08.29,1:15:09.95,Lalai,,0,0,0,,Saya?
Dialog: 0,1:15:10.17,1:15:12.02,Lalai,,0,0,0,,Saya menantu.
Dialog: 0,1:15:12.04,1:15:14.40,Lalai,,0,0,0,,- Siapa awak?\N- Saya kenal semua orang dalam keluarga ini,
Dialog: 0,1:15:14.42,1:15:16.33,Lalai,,0,0,0,,tetapi saya tidak pernah melihat awak.
Dialog: 0,1:15:17.72,1:15:19.50,Lalai,,0,0,0,,Saya tidak kerap ke sini.
Dialog: 0,1:15:24.89,1:15:27.54,Lalai,,0,0,0,,Kenapa awak pandang saya seperti\Nitu? Saya sebahagian daripada keluarga.
Dialog: 0,1:15:27.56,1:15:29.55,Lalai,,0,0,0,,Apa nama anjing itu?
Dialog: 0,1:15:32.31,1:15:33.58,Lalai,,0,0,0,,Hapak.
Dialog: 0,1:15:33.61,1:15:34.58, Lalai,,0,0,0,, Jerawat?
Dialog: 0,1:15:34.61,1:15:36.25,Lalai,,0,0,0,,Mereka tidak mempunyai anjing.
Dialog: 0,1:15:36.28,1:15:37.46,Lalai,,0,0,0,,Anda kelihatan mencurigakan.
Dialog: 0,1:15:37.49,1:15:39.59,Lalai,,0,0,0,,Mengapa anda begitu curiga?
Dialog: 0,1:15:39.61,1:15:43.18,Lalai,,0,0,0,,Saya isteri Baek Hyun-woo,\Nanak kepada keluarga ini. gembira? Sekarang pergi.
Dialog: 0,1:15:43.20,1:15:46.26,Lalai,,0,0,0,,Anda pemilik bangunan.\NAnda sepatutnya memberitahu saya lebih awal.
Dialog: 0,1:15:46.29,1:15:48.31,Lalai,,0,0,0,,- Apa?\N- Ayah saya memberitahu saya...
Dialog: 0,1:15:48.33,1:15:51.53,Lalai,,0,0,0,,Isteri Uncle Hyun-woo ialah\Npemilik bangunan kami.
Dialog: 0,1:15:54.84,1:15:56.44,Lalai,,0,0,0,,Biar saya sambut dengan betul, Makcik.
Dialog: 0,1:15:56.46,1:15:59.33,Lalai,,0,0,0,,- Saya Baek Ho-yeol.\N- Saya faham.
Dialog: 0,1:15:59.51,1:16:02.03,Lalai,,0,0,0,,Awak anak saudara saya yang hanya saya dengar.
Dialog: 0,1:16:02.05,1:16:03.49,Lalai,,0,0,0,,Ya, saya.
Dialog: 0,1:16:03.51,1:16:05.95,Lalai,,0,0,0,,Saya ternampak sebuah kereta yang tidak dikenali di hadapan rumah.
Dialog: 0,1:16:05.97,1:16:08.41,Lalai,,0,0,0,,Adakah anda, Makcik?
Dialog: 0,1:16:08.43,1:16:10.18,Lalai,,0,0,0,,Ya, betul.
Dialog: 0,1:16:10.81,1:16:12.16,Lalai,,0,0,0,,Sakit.
Dialog: 0,1:16:12.19,1:16:16.29, Lalai,,0,0,0,, Enjin V8, kuasa kuda dan penalaan kelajuan.
Dialog: 0,1:16:16.32,1:16:19.39,Lalai,,0,0,0,,Kereta jarang itu benar-benar milik awak?
Dialog: 0,1:16:19.70,1:16:22.23,Lalai,,0,0,0,,Boleh saya minta tumpangan?
Dialog: 0,1:16:23.24,1:16:26.48,Lalai,,0,0,0,,Jika saya benarkan awak, adakah awak akan berhenti bercakap dengan saya?
Dialog: 0,1:16:26.95,1:16:28.90,Lalai,,0,0,0,,Saya berjanji kepada anda.
Dialog: 0,1:16:31.50,1:16:34.44,Lalai,,0,0,0,,Bolehkah anda memandu dia keliling kampung?
Dialog: 0,1:16:34.46,1:16:37.23,Lalai,,0,0,0,,Mungkin tiga atau empat pusingan.
Dialog: 0,1:16:37.25,1:16:38.96,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,1:18:32.41,1:18:34.39,Lalai,,0,0,0,,Anak bongsu saya di sini!
Dialog: 0,1:18:34.41,1:18:35.85,Lalai,,0,0,0,,Aduh, Hyun-woo.
Dialog: 0,1:18:35.87,1:18:39.27,Lalai,,0,0,0,,Kerusi urut yang anda berikan kepada kami kali terakhir.
Dialog: 0,1:18:39.29,1:18:42.25,Lalai,,0,0,0,,Ia sangat bagus. Terima kasih banyak-banyak.
Dialog: 0,1:18:42.67,1:18:46.48,Lalai,,0,0,0,,Rakan saya memberitahu saya untuk mengambil\Ngambar dengan anda apabila saya bertemu dengan anda.
Dialog: 0,1:18:46.51,1:18:48.58,Lalai,,0,0,0,,Bolehkah itu?
Dialog: 0,1:18:49.68,1:18:50.99,Lalai,,0,0,0,,Dua, tiga.
Dialog: 0,1:18:51.01,1:18:53.07,Lalai,,0,0,0,,Saya minta maaf, tetapi bolehkah awak mengetepikan?
Dialog: 0,1:18:53.10,1:18:54.53,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:18:54.56,1:18:55.83,Lalai,,0,0,0,,Lengan anda juga.
Dialog: 0,1:18:55.85,1:18:57.75,Lalai,,0,0,0,,- Malah lengan saya?\N- Hanya kami berdua.
Dialog: 0,1:18:57.77,1:19:02.50,Lalai,,0,0,0,,Sekarang, sekarang. Dia memasang penghawa dingin\Nand dandang di pusat kanan kami.
Dialog: 0,1:19:02.52,1:19:07.15,Lalai,,0,0,0,,Hyun-woo adalah kebanggaan Yongdu-ri.\Beri dia tepukan!
Dialog: 0,1:19:07.78,1:19:08.92,Lalai,,0,0,0,,Dia abang saya.
Dialog: 0,1:19:08.95,1:19:10.01,Lalai,,0,0,0,,Abang saya.
Dialog: 0,1:19:10.03,1:19:11.73,Lalai,,0,0,0,,Makan kenyang.
Dialog: 0,1:19:16.12,1:19:17.43,Lalai,,0,0,0,,Nah...
Dialog: 0,1:19:17.46,1:19:20.69,Lalai,,0,0,0,,Saya mendengarnya daripada abang dan kakak awak,
Dialog: 0,1:19:20.71,1:19:23.04,Lalai,,0,0,0,,tetapi jangan risau tentang saya.
Dialog: 0,1:19:23.09,1:19:25.73,Lalai,,0,0,0,,Saya tidak pernah menyebut tentang perceraian kepada isteri awak.
Dialog: 0,1:19:25.76,1:19:27.48,Lalai,,0,0,0,,Anda menyebutnya sekarang, Ayah.
Dialog: 0,1:19:27.51,1:19:29.17,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:19:29.51,1:19:32.28,Lalai,,0,0,0,,Dia tiada di sini. Dia ada di rumah.
Dialog: 0,1:19:32.30,1:19:33.70,Lalai,,0,0,0,,- Tidak, dia tidak.\N- Apa?
Dialog: 0,1:19:33.72,1:19:36.37,Lalai,,0,0,0,,Saya baru sahaja mengambil Ho-yeol. Dia tiada di sana.
Dialog: 0,1:19:36.39,1:19:37.99,Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,1:19:38.02,1:19:39.80,Lalai,,0,0,0,,Dia tiada di sana.
Dialog: 0,1:19:52.32,1:19:53.89,Lalai,,0,0,0,,Helo, Encik Baek.
Dialog: 0,1:19:53.91,1:19:55.09,Lalai,,0,0,0,,Di manakah Hae-in?
Dialog: 0,1:19:55.12,1:19:59.36,Lalai,,0,0,0,,Dia tiada di balai raya?\NApabila saya balik, dia tiada di sini.
Dialog: 0,1:20:17.35,1:20:19.05,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:20:22.44,1:20:23.41,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:20:23.44,1:20:25.64,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:20:28.86,1:20:30.39,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:20:48.05,1:20:49.75,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:20:51.30,1:20:53.00,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:21:09.32,1:21:11.02,Lalai,,0,0,0,,Hong Hae-in!
Dialog: 0,1:21:56.45,1:21:57.98,Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,1:22:03.75,1:22:06.41,Lalai,,0,0,0,,- Kenapa awak ada di sini?\N- Kenapa awak menjerit?
Dialog: 0,1:22:09.29,1:22:11.91,Lalai,,0,0,0,,Saya dengar awak datang ke sini secara tiba-tiba,
Dialog: 0,1:22:12.59,1:22:14.61,Lalai,,0,0,0,,jadi saya datang, tetapi awak tiada di rumah...
Dialog: 0,1:22:14.63,1:22:16.78, Lalai,,0,0,0,, atau di dewan. Tiada siapa yang tahu di mana anda berada.
Dialog: 0,1:22:16.80,1:22:18.88,Lalai,,0,0,0,,Anda tidak menjawab telefon anda!
Dialog: 0,1:22:18.97,1:22:20.67,Lalai,,0,0,0,,Jadi...
Dialog: 0,1:22:21.06,1:22:23.67,Lalai,,0,0,0,,- kenapa awak ada di sini...?\N- Tunggu.
Dialog: 0,1:22:25.23,1:22:27.26,Lalai,,0,0,0,,Saya keluar berjalan-jalan.
Dialog: 0,1:22:29.94,1:22:32.34,Lalai,,0,0,0,,Berjalan di kawasan kejiranan ini?
Dialog: 0,1:22:32.36,1:22:34.27,Lalai,,0,0,0,,Ya.
Dialog: 0,1:22:35.86,1:22:38.40,Lalai,,0,0,0,,- Saya risau!\N- Kenapa awak jadi begitu?
Dialog: 0,1:22:39.53,1:22:41.53,Lalai,,0,0,0,,Saya bukan pesakit.
Dialog: 0,1:22:44.75,1:22:46.61,Lalai,,0,0,0,,Betul.
Dialog: 0,1:22:47.00,1:22:49.66,Lalai,,0,0,0,,Ya, anda memberitahu saya perkara itu.
Dialog: 0,1:22:52.38,1:22:54.46,Lalai,,0,0,0,,Saya minta maaf saya menjerit.
Dialog: 0,1:23:27.66,1:23:29.41,Lalai,,0,0,0,,Yang benar adalah...
Dialog: 0,1:23:30.92,1:23:32.70,Lalai,,0,0,0,,Saya tidak ingat.
Dialog: 0,1:23:34.13,1:23:37.08,Lalai,,0,0,0,,Saya tidak ingat sama sekali mengapa saya berada di sana.
Dialog: 0,1:23:48.52,1:23:50.58,Lalai,,0,0,0,,Saya berada di hadapan rumah awak,
Dialog: 0,1:23:50.60,1:23:53.47,Lalai,,0,0,0,,kemudian tiba-tiba saya berada di tempat lain.
Dialog: 0,1:23:56.74,1:23:59.35,Lalai,,0,0,0,,Saya tidak tahu bila saya pergi ke sana,
Dialog: 0,1:24:01.45,1:24:03.19,Lalai,,0,0,0,,atau bagaimana.
Dialog: 0,1:24:06.33,1:24:08.03,Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,1:24:09.96,1:24:11.66,Lalai,,0,0,0,,Saya...
Dialog: 0,1:24:16.25,1:24:17.96,Lalai,,0,0,0,,sangat takut.
Dialog: 0,1:25:39.17,1:25:42.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Dinamakan Sekolah Cemerlang 2006{\c}{\i0}
Dialog: 0,1:25:42.92,1:25:45.58,Lalai,,0,0,0,,- Kami di sini.\N- Okay.
Dialog: 0,1:25:46.18,1:25:48.50,Lalai,,0,0,0,,- Jumpa nanti.\N- Jumpa lagi.
Dialog: 0,1:25:50.89,1:25:52.80,Lalai,,0,0,0,,Tunggu, Hyun-woo.
Dialog: 0,1:25:53.43,1:25:56.50,Lalai,,0,0,0,,Orang Seoul tidak begitu\Nberbeza. Jangan rasa kecil hati.
Dialog: 0,1:25:56.52,1:25:58.54,Lalai,,0,0,0,,Berdiri teguh.
Dialog: 0,1:25:58.57,1:26:00.13,Lalai,,0,0,0,,- Teguh.\N- Berdiri tegak,
Dialog: 0,1:26:00.15,1:26:03.17,Lalai,,0,0,0,,dan cuba silau seperti ini.
Dialog: 0,1:26:03.19,1:26:05.05,Lalai,,0,0,0,,- Okay.\N- Bagus. masuk.
Dialog: 0,1:26:05.07,1:26:07.11,Lalai,,0,0,0,,- Bye, Ayah.\N- Bye.
Dialog: 0,1:26:07.16,1:26:10.03,Lalai,,0,0,0,,- Dengar cakap cikgu.\N- Pandu dengan selamat!
Dialog: 0,1:26:16.17,1:26:19.31,Lalai,,0,0,0,,Hae-in akan pergi ke A.S. untuk belajar.
Dialog: 0,1:26:19.34,1:26:21.36,Lalai,,0,0,0,,Katakan selamat tinggal padanya, boleh?
Dialog: 0,1:26:21.38,1:26:23.62,Lalai,,0,0,0,,- Ya, tuan.\N- Ya, tuan.
Dialog: 0,1:26:26.93,1:26:28.63,Lalai,,0,0,0,,Tengok muka dia.
Dialog: 0,1:26:28.76,1:26:30.78,Lalai,,0,0,0,,Dia masih begitu penuh dengan dirinya.
Dialog: 0,1:26:30.81,1:26:35.18,Lalai,,0,0,0,,Ada khabar angin bahawa dia sedang\Nad dimasukkan ke hospital mental.
Dialog: 0,1:26:35.35,1:26:38.60,Lalai,,0,0,0,,Saya dengar itu kerana dia pergi\Nmad selepas abangnya meninggal dunia.
Dialog: 0,1:27:21.02,1:27:22.72,Lalai,,0,0,0,,Tunggu.
Dialog: 0,1:27:34.99,1:27:36.70,Lalai,,0,0,0,,Ambil.
Dialog: 0,1:27:40.29,1:27:41.99,Lalai,,0,0,0,,Saya tidak memerlukannya.
Dialog: 0,1:27:58.18,1:28:01.05,Lalai,,0,0,0,,Bersihkan dan letakkan sedikit salap di atasnya.
Dialog: 0,1:28:12.41,1:28:13.98,Lalai,,0,0,0,,Adakah anda menangis?
Dialog: 0,1:28:16.91,1:28:18.82,Lalai,,0,0,0,,Saya tidak.
Dialog: 0,1:28:29.84,1:28:31.71,Lalai,,0,0,0,,Anda.
Dialog: 0,1:28:43.27,1:28:46.19,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:29:13.38,1:29:15.32,Lalai,,0,0,0,,{\an8}{\i1}Jangan berani sebut pasal perceraian.{\i0}
Dialog: 0,1:29:15.35,1:29:17.03,Lalai,,0,0,0,,{\an8}{\i1}Anda faham.{\i0}
Dialog: 0,1:29:17.06,1:29:19.33,Lalai,,0,0,0,,{\an8}{\i1}Perceraian bukan apa-apa.{\i0}
Dialog: 0,1:29:19.35,1:29:21.76,Lalai,,0,0,0,,{\an8}{\i1}Saya juga mahu bercerai.{\i0}
Dialog: 0,1:29:23.39,1:29:24.87,Lalai,,0,0,0,,{\an8}- {\i1}Ada apa?\N- Jangan kisah saya.{\i0}
Dialog: 0,1:29:24.90,1:29:27.00,Lalai,,0,0,0,,{\an8}{\i1}Bagaimanakah cinta mereka boleh mati?{\i0}
Dialog: 0,1:29:27.02,1:29:29.59,Lalai,,0,0,0,,{\an8}{\i1}Dulu mereka sedang jatuh cinta.{\i0}
Dialog: 0,1:29:29.61,1:29:32.59,Lalai,,0,0,0,,{\an8}{\i1}Wanita yang saya cintai sekarang ialah awak.{\i0}
Dialog: 0,1:29:32.61,1:29:34.55,Lalai,,0,0,0,,{\an8}{\i1}Kilangan sel darah putih anda terlalu rendah.{\i0}
Dialog: 0,1:29:34.57,1:29:36.55,Lalai,,0,0,0,,{\an8}{\i1}Saya akan cari jalan.{\i0}
Dialog: 0,1:29:36.57,1:29:38.34,Lalai,,0,0,0,,{\an8}{\i1}Walaupun saya perlu mencari dunia,{\i0}
Dialog: 0,1:29:38.37,1:29:39.85,Lalai,,0,0,0,,{\an8}{\i1}Saya akan cari jalan untuk hidup.{\i0}
Dialog: 0,1:29:39.87,1:29:41.47,Lalai,,0,0,0,,{\an8}{\i1}Jadi saya sepatutnya...{\i0}
Dialog: 0,1:29:41.50,1:29:43.97,Lalai,,0,0,0,,{\an8}{\i1}dengan anda pada masa seperti ini.{\i0}
