Dialogue: 0,1:25:50.01,1:25:51.93,Default,,0,0,0,,{\an8}{\i1}Naghahanap siya ng secret fund ng chairman.{\i0}
Dialogue: 0,1:25:51.95,1:25:53.58,Default,,0,0,0,,{\an8}{\i1}Hahanapin ko muna.{\i0}
Dialogue: 0,1:25:53.60,1:25:55.66,Default,,0,0,0,,{\an8}{\i1}Alisin...{\i0}
Dialogue: 0,1:25:55.69,1:25:56.79,Default,,0,0,0,,{\an8}{\i1}ni Baek Hyun-woo.{\i0}
Dialogue: 0,1:25:56.81,1:25:58.54,Default,,0,0,0,,{\an8}{\i1}Hindi pa ako pwedeng mamatay.{\i0}
Dialogue: 0,1:25:58.57,1:26:00.92,Default,,0,0,0,,{\an8}{\i1}Hindi ko pa nasasabi sa iyo.{\i0}
