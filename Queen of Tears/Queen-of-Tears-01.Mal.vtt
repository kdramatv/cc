Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.52,0:01:04.39, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 1{\c}{\i0}
Dialog: 0,0:01:26.96,0:01:30.64,Lalai,,0,0,0,,{\i1}Semua orang berkata ia adalah perkahwinan abad ini.{\i0}
Dialog: 0,0:01:30.67,0:01:32.94,Lalai,,0,0,0,,{\i1}Waris kepada konglomerat Korea\Npaling berkuasa...{\i0}
Dialog: 0,0:01:32.96,0:01:35.25,Lalai,,0,0,0,,{\i1}berkahwin dengan rekrut baharu.{\i0}
Dialog: 0,0:01:42.85,0:01:45.05,Lalai,,0,0,0,,{\an8}{\i1}Sudah tiga tahun,{\i0}
Dialog: 0,0:01:45.77,0:01:48.18, Lalai,,0,0,0,,{\an8}tetapi nampaknya baru semalam.
Dialog: 0,0:01:48.73,0:01:52.42,Lalai,,0,0,0,,{\an8}Orang bertanya kepada saya bagaimana rasanya menjadi sebahagian...
Dialog: 0,0:01:52.44,0:01:54.09,Lalai,,0,0,0,,{\an8}sebuah konglomerat,
Dialog: 0,0:01:54.11,0:01:56.44, Lalai,,0,0,0,,{\an8}dan tinggal bersama seorang ratu.
Dialog: 0,0:01:57.03,0:01:58.63, Lalai,,0,0,0,,{\an8}Saya tidak pasti.
Dialog: 0,0:01:58.66,0:02:00.26,Lalai,,0,0,0,,{\an8}Adakah anda percaya saya jika saya berkata ini?
Dialog: 0,0:02:00.28,0:02:02.11, Lalai,,0,0,0,,{\an8}Saya cuma...
Dialog: 0,0:02:02.20,0:02:03.84,Lalai,,0,0,0,,{\an8}lelaki bertuah...
Dialog: 0,0:02:03.87,0:02:05.64,Lalai,,0,0,0,,{\an8}yang berkahwin...
Dialog: 0,0:02:05.66,0:02:08.32, Lalai,,0,0,0,,{\an8}cinta dalam hidup saya.
Dialog: 0,0:02:08.62,0:02:11.31, Lalai,,0,0,0,,Saya tahu orang bergosip tentang...
Dialog: 0,0:02:11.33,0:02:12.73,Lalai,,0,0,0,,bagaimana Baek Hyun-woo berkahwin dengan saya...
Dialog: 0,0:02:12.75,0:02:14.48,Lalai,,0,0,0,,semata-mata kerana keluarga saya...
Dialog: 0,0:02:14.50,0:02:17.75, Lalai,,0,0,0,,dan kekayaan kita.
Dialog: 0,0:02:23.01,0:02:25.80,Lalai,,0,0,0,,Khabar angin itu hanya bermula kerana\NI memilih untuk tidak mendedahkan wajah saya...
Dialog: 0,0:02:25.82,0:02:27.81, Lalai,,0,0,0,, atas pelbagai sebab.
Dialog: 0,0:02:28.14,0:02:31.33, Lalai,,0,0,0,,Saya rasa ini akan menamatkan khabar angin itu,
Dialog: 0,0:02:31.35,0:02:35.14, Lalai,,0,0,0,, kerana saya akhirnya mendedahkan wajah saya.
Dialog: 0,0:02:43.83,0:02:44.89,Lalai,,0,0,0,,{\i1}Kehidupan perkahwinan kami...{\i0}
Dialog: 0,0:02:44.91,0:02:48.03, Lalai,,0,0,0,,bukan sesuatu yang luar biasa.
Dialog: 0,0:02:51.92,0:02:54.87,Lalai,,0,0,0,,{\i1}Saya bangun di sebelahnya.{\i0}
Dialog: 0,0:02:56.00,0:02:57.83,Lalai,,0,0,0,,{\i1}Kami bersarapan bersama.{\i0}
Dialog: 0,0:02:58.34,0:03:01.33,Lalai,,0,0,0,,{\i1}Kami juga pergi bekerja bersama.{\i0}
Dialog: 0,0:03:03.89,0:03:05.53,Lalai,,0,0,0,,{\i1}Bagaimana rasanya...{\i0}
Dialog: 0,0:03:05.56,0:03:08.05, Lalai,,0,0,0,,{\i1}untuk bersama sepanjang siang dan malam?{\i0}
Dialog: 0,0:03:12.98,0:03:14.54,Lalai,,0,0,0,,Ia membuatkan saya gembira.
Dialog: 0,0:03:14.56,0:03:16.81,Lalai,,0,0,0,,Saya pasti sebahagian daripada anda sudah tahu.
Dialog: 0,0:03:16.86,0:03:19.21, Lalai,,0,0,0,,Selepas pulang dari\Npengajaran saya di luar negara lima tahun lalu,
Dialog: 0,0:03:19.23,0:03:22.19,Lalai,,0,0,0,,{\i1}Saya menyertai Queens Department Store,\Nyang dimiliki ayah saya pada masa itu,{\i0}
Dialog: 0,0:03:22.21,0:03:23.88, Lalai,,0,0,0,,{\i1}sebagai pelatih.{\i0}
Dialog: 0,0:03:23.91,0:03:26.94,Lalai,,0,0,0,,{\i1}Anda boleh katakan saya bekerja secara menyamar.{\i0}
Dialog: 0,0:03:42.59,0:03:44.65,Lalai,,0,0,0,,{\i1}Wanita tahu perkara ini.{\i0}
Dialog: 0,0:03:44.68,0:03:46.38, Lalai,,0,0,0,"Saya faham."
Dialog: 0,0:03:47.72,0:03:49.87, Lalai,,0,0,0,"Lelaki ini suka saya."
Dialog: 0,0:03:49.89,0:03:52.30, Lalai,,0,0,0,,"Itulah sebabnya dia bercumbu dengan saya."
Dialog: 0,0:03:52.44,0:03:53.50,Lalai,,0,0,0,,{\i1}No.{\i0}
Dialog: 0,0:03:53.52,0:03:55.43, Lalai,,0,0,0,,Bukan begitu.
Dialog: 0,0:03:56.27,0:03:59.22, Lalai,,0,0,0,,Dia terus menendang mesin fotostat.
Dialog: 0,0:04:04.07,0:04:05.76,Lalai,,0,0,0,,- {\i1}Jadi saya risau.{\i0}\N- Apa yang salah?
Dialog: 0,0:04:05.78,0:04:07.52,Lalai,,0,0,0,,{\i1}Mengenai mesin fotostat.{\i0}
Dialog: 0,0:04:08.37,0:04:10.40, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:04:12.08,0:04:14.66,Lalai,,0,0,0,,{\i1}Tetapi selepas membantunya beberapa kali,{\i0}
Dialog: 0,0:04:14.71,0:04:16.87,Lalai,,0,0,0,,{\i1}Saya mula risau tentang dia.{\i0}
Dialog: 0,0:04:18.21,0:04:19.73, Lalai,,0,0,0,,Apabila menghantar faks...
Dialog: 0,0:04:19.75,0:04:23.19,Lalai,,0,0,0,,{\i1}Pada masa itu, orang ramai\Bergosip tentang betapa menjengkelkan...{\i0}
Dialog: 0,0:04:23.22,0:04:25.44,Lalai,,0,0,0,,{\i1}pelatih baharu ialah,{\i0}
Dialog: 0,0:04:25.47,0:04:28.00,Lalai,,0,0,0,,{\i1}jadi saya pasti dia akan dipecat tidak lama lagi.{\i0}
Dialog: 0,0:04:34.64,0:04:36.75, Lalai,,0,0,0,,Anda perlu berhenti, Cik Hong.
Dialog: 0,0:04:36.77,0:04:38.62, Lalai,,0,0,0,,Saya telah melakukan kerja sambilan saya yang saksama.
Dialog: 0,0:04:38.65,0:04:41.14, Lalai,,0,0,0,,Anda akan dipecat.
Dialog: 0,0:04:41.23,0:04:42.75, Lalai,,0,0,0,,Saya tidak kisah.
Dialog: 0,0:04:42.78,0:04:44.88,Lalai,,0,0,0,,Betul. Anda hanya akan mencari pekerjaan lain,
Dialog: 0,0:04:44.90,0:04:46.13, Lalai,,0,0,0,,tetapi...
Dialog: 0,0:04:46.16,0:04:49.30, Lalai,,0,0,0,,anda akan dipecat di sana juga.\NDAdakah anda mahu bertaruh padanya?
Dialog: 0,0:04:49.33,0:04:51.03, Lalai,,0,0,0,,Anda tahu apa?
Dialog: 0,0:04:51.29,0:04:54.78,Lalai,,0,0,0,,Jantung saya melonjak setiap kali\Nyonya atasan memarahi awak.
Dialog: 0,0:04:54.91,0:04:57.66, Lalai,,0,0,0,,Anda dimarahi setiap hari.
Dialog: 0,0:05:03.67,0:05:05.37, Lalai,,0,0,0,,Mengapa ia melompat?
Dialog: 0,0:05:14.39,0:05:16.41, Lalai,,0,0,0,,- Apa?\N- Mengapa jantung anda melompat,
Dialog: 0,0:05:16.44,0:05:18.50,Default,,0,0,0,,bila aku pulak yang kena maki?
Dialog: 0,0:05:18.52,0:05:20.14, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:05:25.74,0:05:27.92,Lalai,,0,0,0,,Luangkan masa anda,
Dialog: 0,0:05:27.95,0:05:29.73, Lalai,,0,0,0,, dan fikirkan tentang itu.
Dialog: 0,0:05:49.22,0:05:50.92,Lalai,,0,0,0,,Anda boleh datang sekarang.
Dialog: 0,0:05:53.64,0:05:55.51, Lalai,,0,0,0,,Awak tak ada payung ke?
Dialog: 0,0:05:56.68,0:05:59.55, Lalai,,0,0,0,,Tidak, saya tidak, tetapi...
Dialog: 0,0:06:00.31,0:06:02.01, Lalai,,0,0,0,,Ambil saya.
Dialog: 0,0:06:04.86,0:06:08.23, Lalai,,0,0,0,,Anda sentiasa memerlukan bantuan, dan...
Dialog: 0,0:06:09.91,0:06:11.61, Lalai,,0,0,0,,menyusahkan saya.
Dialog: 0,0:06:12.03,0:06:13.73, Lalai,,0,0,0,,Apakah ini?
Dialog: 0,0:06:13.99,0:06:17.53, Lalai,,0,0,0,,Saya membuat jantung awak berdebar-debar, dan sekarang saya mengganggu awak?
Dialog: 0,0:06:26.30,0:06:28.08, Lalai,,0,0,0,,Pn. Hong.
Dialog: 0,0:06:28.47,0:06:30.46, Lalai,,0,0,0,,Dengar dengan teliti.
Dialog: 0,0:06:31.22,0:06:35.42,Lalai,,0,0,0,,Saya tidak memberitahu anda ini sekiranya ia akan\Nmembuat anda berasa tidak selesa,
Dialog: 0,0:06:35.81,0:06:37.51, Lalai,,0,0,0,,tetapi anda tahu,
Dialog: 0,0:06:38.31,0:06:40.50, Lalai,,0,0,0,,Saya pergi ke Universiti Kebangsaan Seoul,
Dialog: 0,0:06:40.52,0:06:42.89, Lalai,,0,0,0,, dan sekolah undang-undang pada masa itu.
Dialog: 0,0:06:43.69,0:06:46.50, Lalai,,0,0,0,,Ibu bapa saya tinggal di selatan,
Dialog: 0,0:06:46.53,0:06:48.92,Lalai,,0,0,0,,tetapi masyarakat menghormati keluarga kita.
Dialog: 0,0:06:48.95,0:06:52.05, Lalai,,0,0,0,,Sebagai contoh, kami memiliki lebih 30 ekor lembu.
Dialog: 0,0:06:52.07,0:06:54.72, Lalai,,0,0,0,,Seorang anak lembu lain dilahirkan beberapa hari lalu,
Dialog: 0,0:06:54.74,0:06:57.39, Lalai,,0,0,0,,jadi kami mempunyai hampir 35 sekarang.
Dialog: 0,0:06:57.41,0:06:58.72, Lalai,,0,0,0,,Bagi pangsapuri studio saya,
Dialog: 0,0:06:58.75,0:07:00.52, Lalai,,0,0,0,,Saya menandatangani pajakan dua tahun...
Dialog: 0,0:07:00.54,0:07:02.48, Lalai,,0,0,0,, daripada membayar sewa bulanan.
Dialog: 0,0:07:02.50,0:07:05.66, Lalai,,0,0,0,,Ini bermakna saya mempunyai banyak\Sedikit wang di sisi.
Dialog: 0,0:07:05.88,0:07:07.83, Lalai,,0,0,0,,Apa yang anda perolehi?
Dialog: 0,0:07:08.67,0:07:10.37, Lalai,,0,0,0,,Walaupun...
Dialog: 0,0:07:10.47,0:07:13.13,Lalai,,0,0,0,,anda dipecat dan tidak dapat mencari pekerjaan baharu,
Dialog: 0,0:07:13.59,0:07:15.49, Lalai,,0,0,0,,Saya boleh jaga awak.
Dialog: 0,0:07:15.51,0:07:17.21, Lalai,,0,0,0,,Itulah yang saya maksudkan.
Dialog: 0,0:07:18.35,0:07:21.50, Lalai,,0,0,0,,Saya jujur. Saya sentiasa\Ninginkan bakal isteri saya bekerja,
Dialog: 0,0:07:21.52,0:07:23.35, Lalai,,0,0,0,,tetapi jika anda,
Dialog: 0,0:07:23.69,0:07:26.14, Lalai,,0,0,0,,Saya boleh cuba menjadi pencari nafkah tunggal.
Dialog: 0,0:07:27.78,0:07:30.60, Lalai,,0,0,0,,Maksud saya, jangan rasa tertekan.
Dialog: 0,0:07:31.24,0:07:32.94, Lalai,,0,0,0,,Hanya saja...
Dialog: 0,0:07:34.03,0:07:35.73, Lalai,,0,0,0,,Saya suka awak.
Dialog: 0,0:07:38.33,0:07:40.03,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:07:43.08,0:07:44.78, Lalai,,0,0,0,,apa yang anda katakan?
Dialog: 0,0:07:56.26,0:07:59.01, Lalai,,0,0,0,,Anda tidak perlu menjawab saya hari ini.
Dialog: 0,0:08:01.60,0:08:03.43, Lalai,,0,0,0,,Jangan basah.
Dialog: 0,0:08:06.77,0:08:08.93, Lalai,,0,0,0,,- Saya...\N- Saya okay.
Dialog: 0,0:08:09.11,0:08:10.17, Lalai,,0,0,0,,Ambil.
Dialog: 0,0:08:10.19,0:08:12.13,Lalai,,0,0,0,,- Encik Baek...\N- Saya betul-betul okay.
Dialog: 0,0:08:12.15,0:08:14.31, Lalai,,0,0,0,,Tetapi saya...
Dialog: 0,0:08:23.66,0:08:25.37, Lalai,,0,0,0,,Saya ada...
Dialog: 0,0:08:25.79,0:08:27.53, Lalai,,0,0,0,,seorang pemandu.
Dialog: 0,0:08:53.44,0:08:55.52,Lalai,,0,0,0,,{\i1}Kelakar, kan?{\i0}
Dialog: 0,0:09:01.29,0:09:03.10, Lalai,,0,0,0,,Memang begitu.
Dialog: 0,0:09:03.12,0:09:04.31,Lalai,,0,0,0,,Apa pun,
Dialog: 0,0:09:04.33,0:09:07.49,Lalai,,0,0,0,,dia seorang yang romantik sejak itu.
Dialog: 0,0:09:08.25,0:09:10.65,Lalai,,0,0,0,,Begitulah kisah cinta kami bermula,
Dialog: 0,0:09:10.67,0:09:13.61,Lalai,,0,0,0,,tetapi dia terkejut selepas\Nmengetahui siapa keluarga saya.
Dialog: 0,0:09:13.63,0:09:15.32,Lalai,,0,0,0,,Dia menyerahkan surat peletakan jawatannya...
Dialog: 0,0:09:15.34,0:09:17.79, Lalai,,0,0,0,,{\i1}dan menghantui saya,{\i0}
Dialog: 0,0:09:18.05,0:09:19.75,Lalai,,0,0,0,,{\i1}jadi...{\i0}
Dialog: 0,0:09:23.06,0:09:25.18,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo, keluarlah.{\c}{\i0}
Dialog: 0,0:10:18.15,0:10:20.77, Lalai,,0,0,0,,Adakah anda akan meninggalkan saya berdiri di sini?
Dialog: 0,0:10:43.51,0:10:47.13, Lalai,,0,0,0,,Dia kelihatan seperti malaikat yang dihantar dari syurga.
Dialog: 0,0:10:50.23,0:10:53.47, Lalai,,0,0,0,,- Begitulah rupa dia ketika itu.\N- Tetapi tidak lagi?
Dialog: 0,0:10:54.57,0:10:57.67,Lalai,,0,0,0,,Sudah tentu, dia masih malaikat.
Dialog: 0,0:10:57.69,0:10:59.84, Lalai,,0,0,0,,Saya beritahu awak banyak kali...
Dialog: 0,0:10:59.86,0:11:01.01, Lalai,,0,0,0,,itu...
Dialog: 0,0:11:01.03,0:11:02.13,Lalai,,0,0,0,,Saya gembira.
Dialog: 0,0:11:02.16,0:11:03.47, Lalai,,0,0,0,,Nah...
Dialog: 0,0:11:03.49,0:11:05.30, Lalai,,0,0,0,,Dia dan Saya...
Dialog: 0,0:11:05.33,0:11:08.45,Lalai,,0,0,0,,semoga kehidupan berumahtangga bahagia.
Dialog: 0,0:11:08.54,0:11:11.74,Lalai,,0,0,0,,Kami masih sangat bercinta.
Dialog: 0,0:11:14.79,0:11:17.11,Lalai,,0,0,0,,{\i1}Baek Hyun-woo akan bercerai.{\i0}
Dialog: 0,0:11:17.13,0:11:18.23,Lalai,,0,0,0,,Serius?
Dialog: 0,0:11:18.26,0:11:20.86, Lalai,,0,0,0,,- Ini rahsia.\N- Sudah tentu. Lagipun kami rakan sekerja.
Dialog: 0,0:11:20.88,0:11:24.11, Lalai,,0,0,0,, Bagaimanapun, dia mahu salah seorang daripada kita mewakilinya.
Dialog: 0,0:11:24.14,0:11:25.95, Lalai,,0,0,0,,Ya, sudah tentu.
Dialog: 0,0:11:25.97,0:11:28.33, Lalai,,0,0,0,,Anda ialah peguam perceraian #1 di negara ini.
Dialog: 0,0:11:28.35,0:11:29.53, Lalai,,0,0,0,,Anda patut melakukannya, Yang-gi.
Dialog: 0,0:11:29.56,0:11:30.74, Lalai,,0,0,0,,Saya akan...
Dialog: 0,0:11:30.77,0:11:32.50,Lalai,,0,0,0,,suka menolongnya. sungguh,
Dialog: 0,0:11:32.52,0:11:34.83, Lalai,,0,0,0,,tetapi saya sudah menyulap begitu banyak kes.
Dialog: 0,0:11:34.86,0:11:36.29, Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,0:11:36.32,0:11:40.10, Lalai,,0,0,0,,Peguam Choi Cheol-seung mempunyai kadar kemenangan 90%.
Dialog: 0,0:11:42.36,0:11:43.38, Lalai,,0,0,0,,Bolehkah anda membantunya?
Dialog: 0,0:11:43.41,0:11:45.13, Lalai,,0,0,0,,Saya secara rahsia akan membantu anda.
Dialog: 0,0:11:45.16,0:11:47.55, Lalai,,0,0,0,,Kenapa secara rahsia? Lakukan secara terbuka.
Dialog: 0,0:11:47.58,0:11:49.32,Lalai,,0,0,0,,Takut mendapat sisi buruk Queens...
Dialog: 0,0:11:49.34,0:11:52.42, Lalai,,0,0,0,,dan kehilangan pekerjaan kamu, kamu bajingan?
Dialog: 0,0:11:52.96,0:11:54.39, Lalai,,0,0,0,,Betul.
Dialog: 0,0:11:54.42,0:11:56.14,Lalai,,0,0,0,,Anda betul. sebab tu.
Dialog: 0,0:11:56.17,0:11:57.69, Lalai,,0,0,0,,Saya akan gila untuk mengambil kerja itu.
Dialog: 0,0:11:57.71,0:12:00.07,Lalai,,0,0,0,,Mak saudara Hyun-woo bercerai tiga kali.
Dialog: 0,0:12:00.09,0:12:03.03, Lalai,,0,0,0,,Anda semua tahu nasib\N peguam bekas suaminya.
Dialog: 0,0:12:03.05,0:12:04.69, Lalai,,0,0,0,,Mereka semua dipecat.
Dialog: 0,0:12:04.72,0:12:08.28,Lalai,,0,0,0,,Hyun-woo membuat kesilapan. Mengapa\Ndia meletakkan kami dalam acar seperti ini?
Dialog: 0,0:12:08.31,0:12:10.37, Lalai,,0,0,0,,- Betul sekali.\N- Jujurlah.
Dialog: 0,0:12:10.39,0:12:13.58,Lalai,,0,0,0,,Dia adalah yang paling bijak daripada kami.\NSentiasa teratas dalam kelas kami,
Dialog: 0,0:12:13.60,0:12:14.73, Lalai,,0,0,0,, jadi kenapa dia tidak boleh...
Dialog: 0,0:12:14.76,0:12:16.28, Lalai,,0,0,0,,- peguam perceraiannya sendiri?\N- Betul.
Dialog: 0,0:12:16.30,0:12:18.25,Lalai,,0,0,0,,- Itu lebih baik.\N- Saya bertaruh dia akan cemerlang.
Dialog: 0,0:12:18.27,0:12:20.38,Default,,0,0,0,,By the way, kenapa dia nak cerai?
Dialog: 0,0:12:20.40,0:12:25.34, Lalai,,0,0,0,,Tepat sekali. Dia menjalani kehidupan\Nimpian semua lelaki Korea.
Dialog: 0,0:12:25.36,0:12:27.97,Lalai,,0,0,0,,Isterinya ialah Hong Hae-in,\Nwaris Kumpulan Queens,
Dialog: 0,0:12:27.99,0:12:29.99,Lalai,,0,0,0,,jadi kenapa?
Dialog: 0,0:12:32.37,0:12:34.03, Lalai,,0,0,0,,Dia gila.
Dialog: 0,0:12:34.33,0:12:36.03, Lalai,,0,0,0,, Orang gila?
Dialog: 0,0:12:45.18,0:12:47.45,Lalai,,0,0,0,,Betul. Mengenai sembang kumpulan One Billion Club itu...
Dialog: 0,0:12:47.47,0:12:49.78,Lalai,,0,0,0,,Ya. Mengapa mereka tidak menjemput saya?
Dialog: 0,0:12:49.81,0:12:52.83,Lalai,,0,0,0,,Jualan kami hanya pada $880 juta, jadi...
Dialog: 0,0:12:52.85,0:12:54.24, Lalai,,0,0,0,,Itu bukan satu jurang yang besar.
Dialog: 0,0:12:54.27,0:12:56.46,Lalai,,0,0,0,,- Kami hanya kurang $100 juta.\N- Saya tahu.
Dialog: 0,0:12:56.48,0:12:58.62,Lalai,,0,0,0,,Saya minta mereka bulatkan sahaja,
Dialog: 0,0:12:58.65,0:13:01.25, Lalai,,0,0,0,, dan menjadi lebih fleksibel,
Dialog: 0,0:13:01.28,0:13:02.59, Lalai,,0,0,0,,tetapi ia masih sukar.
Dialog: 0,0:13:02.61,0:13:04.00, Lalai,,0,0,0,,Kenapa mereka cerewet sangat?
Dialog: 0,0:13:04.03,0:13:05.17, Lalai,,0,0,0,,By the way, saya dengar...
Dialog: 0,0:13:05.20,0:13:07.89, Lalai,,0,0,0,, Gedung Membeli-belah Diraja itu\Nmembual tentang cara CEO mereka...
Dialog: 0,0:13:07.92,0:13:10.93, Lalai,,0,0,0,,akan menyertai One Billion\NClub menjelang akhir tahun.
Dialog: 0,0:13:10.95,0:13:13.56, Lalai,,0,0,0,,Mereka juga bermegah bahawa\Nmereka akan menyediakan Hercyna...
Dialog: 0,0:13:13.58,0:13:15.40,Lalai,,0,0,0,,di tingkat pertama bersebelahan dengan air pancut.
Dialog: 0,0:13:15.42,0:13:16.48, Lalai,,0,0,0,,Mereka pasti gila.
Dialog: 0,0:13:16.50,0:13:18.54, Lalai,,0,0,0,, Beritahu saya mengenainya. Gedung serbaneka di Korea...
Dialog: 0,0:13:18.57,0:13:21.56,Lalai,,0,0,0,,terbahagi kepada mereka yang mempunyai\NHercyna dan mereka yang tidak,
Dialog: 0,0:13:21.59,0:13:25.17,Lalai,,0,0,0,,dan Hercyna hanya mahu bekerja\Ndengan mereka yang berada dalam kelab itu.
Dialog: 0,0:13:27.43,0:13:28.70,Lalai,,0,0,0,,Sudah tiba masanya...
Dialog: 0,0:13:28.72,0:13:31.07, Lalai,,0,0,0,,kami potong semua jenama...
Dialog: 0,0:13:31.10,0:13:34.42, Lalai,,0,0,0,,yang menghalang jualan kami.
Dialog: 0,0:13:35.39,0:13:37.35, Lalai,,0,0,0,,Ini ialah carta penilaian berkala kami.
Dialog: 0,0:13:37.38,0:13:38.37, Lalai,,0,0,0,,Di bahagian bawah,
Dialog: 0,0:13:38.40,0:13:41.63,Lalai,,0,0,0,,kami mempunyai senarai jenama dalam\Nbahagian bawah 20% jualan.
Dialog: 0,0:13:41.65,0:13:43.34, Lalai,,0,0,0,,Berapa ramai daripada mereka yang boleh kita tutup?
Dialog: 0,0:13:43.36,0:13:46.67, Lalai,,0,0,0,,Yang bergaris merah\Nberada di bahagian bawah 20%...
Dialog: 0,0:13:46.70,0:13:47.80, Lalai,,0,0,0,,sekurang-kurangnya dua kali.
Dialog: 0,0:13:47.82,0:13:51.19,Lalai,,0,0,0,,Pada dasarnya, mereka harus\Nditutup. Namun...
Dialog: 0,0:13:53.66,0:13:55.49, Lalai,,0,0,0,,"Namun"?
Dialog: 0,0:13:56.21,0:13:58.41, Lalai,,0,0,0,,Mengapa terdapat "bagaimanapun"?
Dialog: 0,0:14:00.08,0:14:02.48, Lalai,,0,0,0,,Kita harus menutupnya jika boleh.
Dialog: 0,0:14:02.50,0:14:05.32,Lalai,,0,0,0,,Kami memang meminta nasihat pasukan undang-undang kami,
Dialog: 0,0:14:05.34,0:14:06.96, Lalai,,0,0,0,, dan mereka berkata tidak.
Dialog: 0,0:14:11.30,0:14:13.00, Lalai,,0,0,0,,Siapa yang kata?
Dialog: 0,0:14:13.06,0:14:15.09, Lalai,,0,0,0,,Pengarah Baek Hyun-woo.
Dialog: 0,0:14:21.77,0:14:24.63, Lalai,,0,0,0,, En. Yu, sila bungkus\Nkontrak selepas mengesahkan...
Dialog: 0,0:14:24.65,0:14:25.71,Lalai,,0,0,0,,yuran komisen.
Dialog: 0,0:14:25.73,0:14:27.09, Lalai,,0,0,0,,Ya, tuan. Juga...
Dialog: 0,0:14:27.11,0:14:29.59, Lalai,,0,0,0,,Pengurus tingkat dua menyerahkan laporan.
Dialog: 0,0:14:29.61,0:14:32.13, Lalai,,0,0,0,,Salah seorang pelanggan kami terjatuh dan mencederakan dirinya...
Dialog: 0,0:14:32.16,0:14:34.57, Lalai,,0,0,0,,semasa berjalan dengan tumit 5 inci.
Dialog: 0,0:14:34.79,0:14:37.28,Lalai,,0,0,0,,Tuan, CEO ingin berjumpa dengan anda.
Dialog: 0,0:14:38.12,0:14:39.52,Lalai,,0,0,0,,Saya tengah mesyuarat.
Dialog: 0,0:14:39.54,0:14:41.02,Lalai,,0,0,0,,Nah...
Dialog: 0,0:14:41.04,0:14:44.49,Lalai,,0,0,0,,Dia mahu berjumpa dengan anda\Segera. Dia sangat kecewa.
Dialog: 0,0:15:15.99,0:15:17.69, Lalai,,0,0,0,, En. Baek.
Dialog: 0,0:15:18.00,0:15:21.78, Lalai,,0,0,0,,Mengapa kita tidak boleh menutup\Njenama yang tidak menguntungkan?
Dialog: 0,0:15:22.54,0:15:26.23,Lalai,,0,0,0,,Banyak jenama melabur\N$500,000 dalam peralatan.
Dialog: 0,0:15:26.25,0:15:28.32, Lalai,,0,0,0,,Kita tidak boleh menendang mereka keluar begitu sahaja.
Dialog: 0,0:15:28.34,0:15:29.57,Lalai,,0,0,0,,Failkan saman pengusiran, kemudian.
Dialog: 0,0:15:29.59,0:15:31.15,Lalai,,0,0,0,,Mustahil untuk menang.
Dialog: 0,0:15:31.18,0:15:34.15,Lalai,,0,0,0,,Undang-undang telah disemak berkali-kali untuk menghalang pengedar besar...
Dialog: 0,0:15:34.18,0:15:36.21,Lalai,,0,0,0,,daripada menyalahgunakan kuasa mereka.
Dialog: 0,0:15:36.72,0:15:39.34, Lalai,,0,0,0,,Adakah anda berkata...
Dialog: 0,0:15:40.31,0:15:42.59, Lalai,,0,0,0,,Saya dalam perjalanan kuasa?
Dialog: 0,0:15:42.65,0:15:44.26,Lalai,,0,0,0,,Begitukah?
Dialog: 0,0:15:44.52,0:15:47.00, Lalai,,0,0,0,,- Bukan itu yang saya...\N- Adakah ini organisasi bukan untung?
Dialog: 0,0:15:47.02,0:15:48.54, Lalai,,0,0,0,,Adakah kita sukarelawan?
Dialog: 0,0:15:48.57,0:15:51.17,Lalai,,0,0,0,,Adakah wajar untuk membiarkannya,\Napabila kita tidak mendapat...
Dialog: 0,0:15:51.20,0:15:54.44, Lalai,,0,0,0,, nilai wang kita untuk tempat yang mahal itu?
Dialog: 0,0:15:55.91,0:15:58.14, Lalai,,0,0,0,,Bahagian jualan sengaja mengecualikan...
Dialog: 0,0:15:58.16,0:15:59.77,Lalai,,0,0,0,,jenama dengan markah prestasi rendah...
Dialog: 0,0:15:59.79,0:16:02.97, Lalai,,0,0,0,,daripada acara jemputan pelanggan dan\Ndiskaun untuk menghalang jualan tambahan.
Dialog: 0,0:16:02.99,0:16:07.35, Lalai,,0,0,0,,Jenama tersebut boleh mengadu\Nkepada media atau menyaman kami.
Dialog: 0,0:16:07.38,0:16:08.73, Lalai,,0,0,0,,Maka kita benar-benar akan menghadapi masalah.
Dialog: 0,0:16:08.75,0:16:11.65, Lalai,,0,0,0,,Saya percaya penyelesaian\N yang lebih baik ialah membantu...
Dialog: 0,0:16:11.67,0:16:13.38, Lalai,,0,0,0,,meningkatkan jualan mereka.
Dialog: 0,0:16:16.18,0:16:17.24,Lalai,,0,0,0,,En. Baek.
Dialog: 0,0:16:17.26,0:16:19.92,Lalai,,0,0,0,,Adakah saya meminta nasihat anda?
Dialog: 0,0:16:21.48,0:16:24.18, Lalai,,0,0,0,,Saya memberitahu anda untuk menutupnya.
Dialog: 0,0:16:24.98,0:16:28.08,Lalai,,0,0,0,,Jika mereka tidak mendengar, failkan tuntutan mahkamah dan menang.
Dialog: 0,0:16:28.11,0:16:31.18, Lalai,,0,0,0,,Saya percaya itu tugas pasukan anda.
Dialog: 0,0:16:38.99,0:16:40.05,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:16:40.08,0:16:42.11, Lalai,,0,0,0,,Mesyuarat ini sudah tamat.
Dialog: 0,0:17:05.19,0:17:07.83,Lalai,,0,0,0,,Adakah anda tidak sabar-sabar untuk memberitahu orang lain\Ntahu kami tidak serasi?
Dialog: 0,0:17:07.86,0:17:09.87,Lalai,,0,0,0,,Hubungan kami tiada kaitan dengan ini.
Dialog: 0,0:17:09.90,0:17:11.42,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:17:11.44,0:17:15.59,Lalai,,0,0,0,,Adakah itu sebabnya anda memberi amaran kepada\Npengurus kedai yang saya mahu pecat...
Dialog: 0,0:17:15.61,0:17:18.88, Lalai,,0,0,0,,tentang pelanggaran sebelumnya\Nuntuk membantu dia terus bertahan?
Dialog: 0,0:17:18.91,0:17:21.68, Lalai,,0,0,0,,Pengurus itu telah\N bersama kami sejak awal,
Dialog: 0,0:17:21.70,0:17:23.39,Lalai,,0,0,0,,dan dia masih sama rajin.
Dialog: 0,0:17:23.41,0:17:28.78, Lalai,,0,0,0,, Baik. Anda sangat baik dan mengambil berat kepada orang lain.
Dialog: 0,0:17:28.83,0:17:31.27,Lalai,,0,0,0,,Adakah anda mahu menjadi hero atau sesuatu?
Dialog: 0,0:17:31.30,0:17:34.82,Lalai,,0,0,0,,Berhenti bermain syahid dan\Nlayan mereka yang rapat dengan anda dengan lebih baik.
Dialog: 0,0:17:34.84,0:17:36.58, Lalai,,0,0,0,,Mereka yang rapat dengan saya?
Dialog: 0,0:17:37.97,0:17:39.67, Lalai,,0,0,0,,Seperti dalam anda?
Dialog: 0,0:17:40.68,0:17:41.74,Lalai,,0,0,0,,Apa?
Dialog: 0,0:17:41.76,0:17:43.47,Lalai,,0,0,0,,Adakah anda benar-benar berfikir...
Dialog: 0,0:17:43.60,0:17:45.30, Lalai,,0,0,0,,kita dekat?
Dialog: 0,0:17:48.48,0:17:50.60,Lalai,,0,0,0,,Saya perlu bercakap dengan awak.
Dialog: 0,0:17:50.98,0:17:52.75, Lalai,,0,0,0,,Datang ke ruang rehat dalam masa sejam.
Dialog: 0,0:17:52.78,0:17:54.48, Lalai,,0,0,0,, Baik.
Dialog: 0,0:18:42.24,0:18:44.16,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,0:18:56.09,0:18:57.52,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Adakah anda dalam perjalanan? Saya di sini.{\c}{\i0}
Dialog: 0,0:18:57.55,0:18:59.49,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Di manakah anda? Lupakan saja. Saya akan pergi.{\c}{\i0}
Dialog: 0,0:18:59.51,0:19:01.21,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Datang ke bilik keluarga.{\c}{\i0}
Dialog: 0,0:19:04.76,0:19:06.01,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,0:19:19.15,0:19:20.90, Lalai,,0,0,0,,Apa yang menyebabkan anda terlalu lama?
Dialog: 0,0:19:21.70,0:19:22.80,Lalai,,0,0,0,,Saya menghantar mesej kepadanya lewat.
Dialog: 0,0:19:22.82,0:19:24.13, Lalai,,0,0,0,,Anda tidak perlu mengingatkannya.
Dialog: 0,0:19:24.16,0:19:26.73,Lalai,,0,0,0,,Dia tahu kami ada mesyuarat keluarga.
Dialog: 0,0:19:27.33,0:19:29.03, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:19:29.25,0:19:30.60, Lalai,,0,0,0,,Temu bual apakah itu?
Dialog: 0,0:19:30.62,0:19:33.39, Lalai,,0,0,0,,Ia adalah bahagian budaya\Nof "Hanyang Economic Daily."
Dialog: 0,0:19:33.42,0:19:36.23,Lalai,,0,0,0,,Temu bual yang menggembirakan\Ndi mana CEO dan ahli politik...
Dialog: 0,0:19:36.25,0:19:37.94, Lalai,,0,0,0,,tunjukkan rumah dan keluarga mereka.
Dialog: 0,0:19:37.96,0:19:39.69, Lalai,,0,0,0,,Mereka berdua ditemu bual.
Dialog: 0,0:19:39.72,0:19:42.86, Lalai,,0,0,0,,Kenapa tunjukkan rumah? Mereka bukan selebriti.
Dialog: 0,0:19:42.89,0:19:46.32, Lalai,,0,0,0,,Kami terpaksa melakukan sesuatu tentang tabloid.
Dialog: 0,0:19:46.35,0:19:49.17,Lalai,,0,0,0,,Saya setuju. Orang ramai bergosip tentang\Nbagaimana mereka dipisahkan tahun lepas.
Dialog: 0,0:19:49.20,0:19:52.00,Lalai,,0,0,0,,Ini semua kerana mereka melihat anda bertengkar di tempat kerja.
Dialog: 0,0:19:52.02,0:19:54.04, Lalai,,0,0,0,,- Anda berhujah?\N- Ya, hari ini.
Dialog: 0,0:19:54.06,0:19:55.29, Lalai,,0,0,0,,Ia bukan hujah yang mudah.
Dialog: 0,0:19:55.31,0:19:58.52,Lalai,,0,0,0,,Agak tidak selesa\Nuntuk mereka yang berada di dalam bilik mesyuarat.
Dialog: 0,0:20:03.41,0:20:06.22, Lalai,,0,0,0,,Betul, Hyun-woo. Mengenai\N Suruhanjaya Perdagangan Adil...
Dialog: 0,0:20:06.24,0:20:08.16, Lalai,,0,0,0,,Mereka terus memanggil kami untuk perkara remeh.
Dialog: 0,0:20:08.18,0:20:09.40, Lalai,,0,0,0,,Bolehkah anda menjaganya?
Dialog: 0,0:20:09.42,0:20:11.43, Lalai,,0,0,0,,Anda harus bertanya kepada pasukan undang-undang Queens Mart.
Dialog: 0,0:20:11.46,0:20:12.77, Lalai,,0,0,0,,Ia terlalu padat,
Dialog: 0,0:20:12.79,0:20:15.81, Lalai,,0,0,0,,tetapi anda cepat berfikir dan bijak,
Dialog: 0,0:20:15.83,0:20:18.94,Lalai,,0,0,0,,dan orang atasan di Suruhanjaya Perdagangan Pameran\N menyayangi anda.
Dialog: 0,0:20:18.96,0:20:20.98, Lalai,,0,0,0,,Kami mempunyai bidang kuasa kami sendiri...
Dialog: 0,0:20:21.01,0:20:23.63, Lalai,,0,0,0,,Kenapa anda tidak boleh katakan anda akan melakukannya?
Dialog: 0,0:20:29.22,0:20:30.28, Lalai,,0,0,0,,Dan kamu berdua.
Dialog: 0,0:20:30.31,0:20:31.49, Lalai,,0,0,0,,Saya mahu awak mempunyai bayi.
Dialog: 0,0:20:31.52,0:20:34.08, Lalai,,0,0,0,,Orang ramai perlu berhenti mengumpat.
Dialog: 0,0:20:34.10,0:20:35.58,Lalai,,0,0,0,,Adakah anda menghubungi Dr. Joo?
Dialog: 0,0:20:35.60,0:20:37.12,Lalai,,0,0,0,,Ya, saya telah menempah janji temu.
Dialog: 0,0:20:37.15,0:20:38.79, Lalai,,0,0,0,,Dia akan mendapat pemeriksaan pranatal,
Dialog: 0,0:20:38.82,0:20:40.79, Lalai,,0,0,0,,kemudian mulakan prosedur dengan segera.
Dialog: 0,0:20:40.82,0:20:42.59,Lalai,,0,0,0,,Bagi Hyun-woo, selepas bayi itu dilahirkan,
Dialog: 0,0:20:42.61,0:20:44.01, Lalai,,0,0,0,,anda akan pergi ke Boston...
Dialog: 0,0:20:44.03,0:20:46.13,Lalai,,0,0,0,,dalam tempoh dua tahun akan datang untuk mendapatkan MBA.
Dialog: 0,0:20:46.16,0:20:47.88, Lalai,,0,0,0,,Saya sudah memberitahu anda perkara ini.
Dialog: 0,0:20:47.91,0:20:49.76,Default,,0,0,0,,Saya tidak berminat untuk mendapatkan ijazah.
Dialog: 0,0:20:49.79,0:20:50.93, Lalai,,0,0,0,,Dan saya juga berkata...
Dialog: 0,0:20:50.95,0:20:53.32,Lalai,,0,0,0,,itu bukan terpulang kepada anda.
Dialog: 0,0:20:53.62,0:20:57.16, Lalai,,0,0,0,,Mereka tidak berhutang cucu kepada kita,\Njadi berhentilah menekannya.
Dialog: 0,0:20:57.42,0:20:59.49, Lalai,,0,0,0,,Minum teh awak, Hyun-woo.
Dialog: 0,0:21:01.84,0:21:03.40, Lalai,,0,0,0,,Anda lihat,
Dialog: 0,0:21:03.42,0:21:07.21,Lalai,,0,0,0,,Saya lebih suka berjumpa dengan Su-bin pada bulan Mei.
Dialog: 0,0:21:12.52,0:21:14.58, Lalai,,0,0,0,,Siapa Su-bin?
Dialog: 0,0:21:14.60,0:21:17.43, Lalai,,0,0,0,,Siapa menurut anda? Ia adalah cucu perempuan saya yang akan datang.
Dialog: 0,0:21:17.69,0:21:20.04, Lalai,,0,0,0,,Namanya bermaksud "sangat bersinar."
Dialog: 0,0:21:20.07,0:21:23.04, Lalai,,0,0,0,,Tidak buruk, bukan? Hong Su-bin.
Dialog: 0,0:21:23.07,0:21:24.77, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:21:24.99,0:21:26.69, Lalai,,0,0,0,,Adakah dia menjadi Hong Su-bin...
Dialog: 0,0:21:27.03,0:21:28.22,Lalai,,0,0,0,,bukan Baek Su-bin?
Dialog: 0,0:21:28.24,0:21:30.02, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:21:30.74,0:21:32.93, Lalai,,0,0,0,,Anda tidak mahu dia mempunyai nama keluarga ibunya?
Dialog: 0,0:21:32.95,0:21:35.10,Lalai,,0,0,0,,Kita tidak perlu mengikut sistem patriarki.
Dialog: 0,0:21:35.12,0:21:39.08,Lalai,,0,0,0,,Saya rasa ia agak kuno\Nmenggunakan nama keluarga bapa.
Dialog: 0,0:21:40.25,0:21:43.77, Lalai,,0,0,0,,Tetapi apabila saya bertanya kepada anda tentang\Ngiving Geon-u nama keluarga ibunya,
Dialog: 0,0:21:43.80,0:21:46.46, Lalai,,0,0,0,,kamu kata itu mengarut.
Dialog: 0,0:21:48.68,0:21:49.74, Lalai,,0,0,0,,Ini berbeza.
Dialog: 0,0:21:49.76,0:21:52.63,Lalai,,0,0,0,,Bukankah ia sama? Tidak?
Dialog: 0,0:22:16.08,0:22:17.91, Lalai,,0,0,0,,Kita perlu bercakap.
Dialog: 0,0:22:24.05,0:22:26.48, Lalai,,0,0,0,,Kami sedang mengandung, walaupun\Tiada apa-apa yang berlaku?
Dialog: 0,0:22:26.51,0:22:27.90, Lalai,,0,0,0,,Dan saya akan pergi ke luar negara sendirian?
Dialog: 0,0:22:27.92,0:22:29.92,Lalai,,0,0,0,,Ada apa?
Dialog: 0,0:22:30.01,0:22:32.13, Lalai,,0,0,0,,Bukankah itu perkara yang baik?
Dialog: 0,0:22:34.35,0:22:36.03, Lalai,,0,0,0,,Jangan cakap saya nak saya datang.
Dialog: 0,0:22:36.06,0:22:37.93, Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:22:38.73,0:22:39.91, Lalai,,0,0,0,, Tepat sekali.
Dialog: 0,0:22:39.94,0:22:41.71, Lalai,,0,0,0,, Kemudian lakukan bahagian anda dan pergi ke luar negara.
Dialog: 0,0:22:41.73,0:22:44.25,Lalai,,0,0,0,,Kami akan meminta orang lain membesarkan bayi kami.
Dialog: 0,0:22:44.27,0:22:46.14, Lalai,,0,0,0,,Ia mudah dan bagus. Apa isunya?
Dialog: 0,0:22:46.17,0:22:47.87, Lalai,,0,0,0,,"Bagus"?
Dialog: 0,0:22:48.03,0:22:49.17, Lalai,,0,0,0,,Adakah anda gembira tentang perkara ini?
Dialog: 0,0:22:49.20,0:22:50.90,Lalai,,0,0,0,,Serius?
Dialog: 0,0:22:52.53,0:22:54.93,Lalai,,0,0,0,,Adakah anda benar-benar mahukan bayi?
Dialog: 0,0:22:54.95,0:22:57.15, Lalai,,0,0,0,,Jika ia diperlukan.
Dialog: 0,0:23:03.46,0:23:05.29,Lalai,,0,0,0,,Ya?
Dialog: 0,0:23:05.42,0:23:09.04, Lalai,,0,0,0,,Adakah anda memberitahu mereka saya ingin menandatangani\Nooff sebelum mereka menerbitkan artikel?
Dialog: 0,0:23:09.72,0:23:10.69, Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,0:23:10.72,0:23:12.42, Lalai,,0,0,0,,Juga...
Dialog: 0,0:23:12.64,0:23:14.70,Lalai,,0,0,0,,Suruh mereka memperkenalkan Pengarah Baek dengan betul.
Dialog: 0,0:23:14.72,0:23:17.80,Default,,0,0,0,,Jangan lupa sebut dia belajar undang-undang di SNU.
Dialog: 0,0:23:21.85,0:23:22.91,Lalai,,0,0,0,,Apa?
Dialog: 0,0:23:22.94,0:23:26.29, Lalai,,0,0,0,,Berhenti melakukan temu duga ini. Saya sudah selesai dengan mereka.
Dialog: 0,0:23:26.32,0:23:27.46, Lalai,,0,0,0,,Lakukan sahaja jika perlu.
Dialog: 0,0:23:27.48,0:23:29.84, Lalai,,0,0,0,,Bagaimana saya boleh, sedangkan mereka mengenai pasangan suami isteri?
Dialog: 0,0:23:29.86,0:23:32.30, Lalai,,0,0,0,,Anda boleh memberitahu mereka semua tentang saya.
Dialog: 0,0:23:32.32,0:23:34.93,Lalai,,0,0,0,,Beritahu mereka bagaimana kita sangat jatuh cinta,
Dialog: 0,0:23:34.95,0:23:36.68,Lalai,,0,0,0,,dan selamat berkahwin.
Dialog: 0,0:23:36.70,0:23:38.51, Lalai,,0,0,0,, Beritahu mereka segala-galanya.
Dialog: 0,0:23:38.54,0:23:40.82,Lalai,,0,0,0,,Semuanya pembohongan.
Dialog: 0,0:23:55.14,0:23:56.66, Lalai,,0,0,0,,Hei.
Dialog: 0,0:23:56.68,0:23:58.37, Lalai,,0,0,0,,Saya mahukan foto dahulu.
Dialog: 0,0:23:58.39,0:24:01.13, Lalai,,0,0,0,,Saya akan pilih yang mereka akan gunakan.
Dialog: 0,0:24:16.91,0:24:18.55, Lalai,,0,0,0,,Mengapa mereka menerbitkan artikel yang tidak berguna?
Dialog: 0,0:24:18.58,0:24:19.72,Lalai,,0,0,0,,Mengapa mereka tidak menyebut...
Dialog: 0,0:24:19.74,0:24:22.70,Lalai,,0,0,0,,bagaimana saya menderma $200,000 secara tanpa nama?
Dialog: 0,0:24:23.08,0:24:24.27, Lalai,,0,0,0,,Lihat.
Dialog: 0,0:24:24.29,0:24:25.64, Lalai,,0,0,0,,Saya tahu saya melakukannya tanpa nama,
Dialog: 0,0:24:25.67,0:24:29.95,Lalai,,0,0,0,,kerana saya tidak mahu sesiapa\N tahu, tetapi semua orang harus tahu.
Dialog: 0,0:24:30.30,0:24:31.94,Lalai,,0,0,0,,Bukankah itu tujuan pasukan PR?
Dialog: 0,0:24:31.97,0:24:33.96, Lalai,,0,0,0,,Saya sangat kecewa.
Dialog: 0,0:24:41.31,0:24:43.09, Lalai,,0,0,0,,Untuk apa itu?
Dialog: 0,0:24:45.06,0:24:46.12,Lalai,,0,0,0,,Apa?
Dialog: 0,0:24:46.15,0:24:47.37, Lalai,,0,0,0,,Apa yang anda mahukan?
Dialog: 0,0:24:47.40,0:24:49.14, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:24:49.69,0:24:51.38, Lalai,,0,0,0,, Beritahu saya dari sana.
Dialog: 0,0:24:51.40,0:24:53.30, Lalai,,0,0,0,,Gunakan perkataan anda.
Dialog: 0,0:24:53.32,0:24:55.02, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:24:56.62,0:24:58.09, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:24:58.12,0:25:00.26, Lalai,,0,0,0,,- Soo-cheol.\N- Apa?
Dialog: 0,0:25:00.29,0:25:01.90, Lalai,,0,0,0,,Jangan elak saya,
Dialog: 0,0:25:02.00,0:25:03.06, Lalai,,0,0,0,, atau anda akan mendapat...
Dialog: 0,0:25:03.08,0:25:05.82, Lalai,,0,0,0,,mata hitam dan mula meraung lagi.
Dialog: 0,0:25:06.79,0:25:08.70, Lalai,,0,0,0,,Tunggu...
Dialog: 0,0:25:09.38,0:25:11.65, Lalai,,0,0,0,,Adakah anda gila?
Dialog: 0,0:25:11.67,0:25:12.98, Lalai,,0,0,0,,Kenapa awak pukul saya?
Dialog: 0,0:25:13.01,0:25:15.86, Lalai,,0,0,0,,Adakah Hyun-woo rakan anda atau\Nseseorang yang lebih muda daripada anda?
Dialog: 0,0:25:15.88,0:25:17.07, Lalai,,0,0,0,,"Berfikir cepat"?
Dialog: 0,0:25:17.09,0:25:19.59, Lalai,,0,0,0,,Beraninya awak?
Dialog: 0,0:25:25.02,0:25:27.33,Lalai,,0,0,0,,Tak hormat suami saya lagi,
Dialog: 0,0:25:27.35,0:25:29.01, Lalai,,0,0,0,,dan saya akan bunuh awak.
Dialog: 0,0:25:29.86,0:25:32.81, Lalai,,0,0,0,,- Jawab saya.\N- Baik. saya faham.
Dialog: 0,0:25:36.20,0:25:38.09, Lalai,,0,0,0,,Ahli sihir gila itu.
Dialog: 0,0:25:38.11,0:25:41.05, Lalai,,0,0,0,,Kenapa nak marah saya, bila dia\Nbully Hyun-woo sepanjang masa?
Dialog: 0,0:25:41.08,0:25:44.11, Lalai,,0,0,0,, Dia benar-benar psikopat!
Dialog: 0,0:25:46.58,0:25:48.91, Lalai,,0,0,0,,Saya tidak bercakap tentang awak.
Dialog: 0,0:26:04.06,0:26:06.45,Lalai,,0,0,0,,Semua orang mahu anda mempertimbangkan semula perceraian ini,
Dialog: 0,0:26:06.48,0:26:09.00, Lalai,,0,0,0,,dan tinggal bersamanya.
Dialog: 0,0:26:09.02,0:26:12.10, Lalai,,0,0,0,,Mereka mahu saya memberitahu anda perkara itu. Adakah anda menangis?
Dialog: 0,0:26:13.90,0:26:16.23,Lalai,,0,0,0,,Apa? Adakah anda sudah mabuk?
Dialog: 0,0:26:18.74,0:26:21.05, Lalai,,0,0,0,,Apakah ini? Awak buat hati saya berdebar.
Dialog: 0,0:26:21.07,0:26:22.18, Lalai,,0,0,0,, Adakah saya?
Dialog: 0,0:26:22.20,0:26:24.85,Default,,0,0,0,,Rupa-rupanya saya comel bila mabuk.
Dialog: 0,0:26:24.87,0:26:27.01, Lalai,,0,0,0,,- Dia kata itu langkah istimewa saya.\N- Siapa kata?
Dialog: 0,0:26:27.04,0:26:30.37, Lalai,,0,0,0,,Hae-in berkata begitu.
Dialog: 0,0:26:30.46,0:26:32.16, Lalai,,0,0,0,,Dia berkata...
Dialog: 0,0:26:33.17,0:26:34.23, Lalai,,0,0,0,,Saya comel.
Dialog: 0,0:26:34.25,0:26:36.21,Lalai,,0,0,0,,Adakah anda menyombongkan diri?
Dialog: 0,0:26:36.59,0:26:38.19, Lalai,,0,0,0,,Kenapa saya jadi begitu?
Dialog: 0,0:26:38.22,0:26:40.25, Lalai,,0,0,0,,Kenapa saya comel?
Dialog: 0,0:26:40.43,0:26:43.03, Lalai,,0,0,0,,Mengapa saya menggunakan langkah istimewa saya dan kelihatan comel?
Dialog: 0,0:26:43.05,0:26:45.24,Lalai,,0,0,0,,Kenapa saya buat jantung dia berdebar?
Dialog: 0,0:26:45.27,0:26:46.99, Lalai,,0,0,0,,Dan sebagai hasilnya,
Dialog: 0,0:26:47.02,0:26:48.95, Lalai,,0,0,0,,Saya rosakkan...
Dialog: 0,0:26:48.98,0:26:50.85, Lalai,,0,0,0,,kehidupan saya sendiri.
Dialog: 0,0:26:51.27,0:26:54.72,Lalai,,0,0,0,,Kami tidak akan berkahwin\Kalau saya tidak begitu comel.
Dialog: 0,0:26:55.82,0:26:58.21, Lalai,,0,0,0,,Si gila ini benar-benar sia-sia.
Dialog: 0,0:26:58.24,0:26:59.55, Lalai,,0,0,0,,Hei, bangun.
Dialog: 0,0:26:59.57,0:27:02.84,Lalai,,0,0,0,,Isteri saya telah menelefon saya,\Meminta saya membeli lampin untuk bayi kami.
Dialog: 0,0:27:02.87,0:27:05.59, Lalai,,0,0,0,,Tidak, saya tidak akan pulang.
Dialog: 0,0:27:05.62,0:27:07.68, Lalai,,0,0,0,,Mengapa saya?
Dialog: 0,0:27:07.70,0:27:08.81, Lalai,,0,0,0,,Mengapa awak tidak pulang ke rumah?
Dialog: 0,0:27:08.83,0:27:10.49,Lalai,,0,0,0,,Saya mabuk!
Dialog: 0,0:27:10.58,0:27:13.33,Lalai,,0,0,0,,Saya terlalu comel apabila saya mabuk!
Dialog: 0,0:27:14.09,0:27:18.27,Lalai,,0,0,0,,Saya selalu dikenali sebagai "anak\N yang comel dari rumah pokok pir di Yongdu-ri."
Dialog: 0,0:27:18.30,0:27:20.32, Lalai,,0,0,0,,Ia adalah sifat saya.
Dialog: 0,0:27:20.34,0:27:23.21,Lalai,,0,0,0,,Saya dilahirkan seperti ini.
Dialog: 0,0:27:23.80,0:27:25.96, Lalai,,0,0,0,,Apa yang boleh saya lakukan?
Dialog: 0,0:27:31.10,0:27:33.05, Lalai,,0,0,0,, Jadi anda tidak akan pulang?
Dialog: 0,0:27:33.52,0:27:35.72, Lalai,,0,0,0,,Tinggalkan saya di sini.
Dialog: 0,0:27:35.82,0:27:37.96,Lalai,,0,0,0,,Saya akan dibawa pulang dengan selamat.
Dialog: 0,0:27:37.98,0:27:39.85, Lalai,,0,0,0,,Oleh siapa?
Dialog: 0,0:27:42.61,0:27:44.94, Lalai,,0,0,0,,Mereka akan menghalang semua skandal.
Dialog: 0,0:27:48.70,0:27:49.81, Lalai,,0,0,0,,Tidak boleh.
Dialog: 0,0:27:49.83,0:27:51.57,Lalai,,0,0,0,,Nak tengok?
Dialog: 0,0:28:03.09,0:28:04.96, Lalai,,0,0,0,,Tidak boleh.
Dialog: 0,0:28:05.05,0:28:07.13, Lalai,,0,0,0,,Setiap kali...
Dialog: 0,0:28:08.56,0:28:11.12, Lalai,,0,0,0,,Saya mengoyakkan daun dari dahan...
Dialog: 0,0:28:11.14,0:28:13.45,Lalai,,0,0,0,,untuk melihat sama ada saya patut bercerai atau tidak...
Dialog: 0,0:28:13.48,0:28:15.37, Lalai,,0,0,0,,Awak buat begitu?
Dialog: 0,0:28:15.40,0:28:17.12, Lalai,,0,0,0,,Saya selalu berakhir dengan "tidak."
Dialog: 0,0:28:17.15,0:28:19.88, Lalai,,0,0,0,,Setiap kali.
Dialog: 0,0:28:19.90,0:28:21.25,Lalai,,0,0,0,,Jadi nasib awak.
Dialog: 0,0:28:21.28,0:28:23.02, Lalai,,0,0,0,,Tiada sesiapa.
Dialog: 0,0:28:23.15,0:28:25.06, Lalai,,0,0,0,,Tiada sesiapa di dunia ini...
Dialog: 0,0:28:25.66,0:28:28.40,Lalai,,0,0,0,,berpihak kepada saya.
Dialog: 0,0:28:28.83,0:28:32.24, Lalai,,0,0,0,,Tiada sehelai daun pun di sisi saya.
Dialog: 0,0:28:32.83,0:28:35.77,Lalai,,0,0,0,,Saya tidak memerlukan sesiapa di pihak saya.\NI hanya mahu memiliki bangunan.
Dialog: 0,0:28:35.79,0:28:38.73, Lalai,,0,0,0,,Bangunan itu akan berada di pihak saya selama-lamanya.
Dialog: 0,0:28:38.75,0:28:40.49,Default,,0,0,0,,Mood isteri saya macam roller coaster.
Dialog: 0,0:28:40.52,0:28:42.81, Lalai,,0,0,0,,Dia akan tersenyum pada\Npagi kemudian mengamuk pada waktu malam.
Dialog: 0,0:28:42.83,0:28:45.75,Lalai,,0,0,0,,Adakah salah saya kita kehabisan lampin?\NKenapa dia marah saya?
Dialog: 0,0:28:45.77,0:28:47.24, Lalai,,0,0,0,,Saya hanya perlukan sebuah bangunan.
Dialog: 0,0:28:47.26,0:28:49.03, Lalai,,0,0,0,,Bangunan konkrit tidak berubah.
Dialog: 0,0:28:49.06,0:28:50.57,Lalai,,0,0,0,,Mereka tidak mengomel atau marah.
Dialog: 0,0:28:50.60,0:28:52.22, Lalai,,0,0,0,, Pergi.
Dialog: 0,0:28:54.19,0:28:56.46, Lalai,,0,0,0,, Dapatkan lampin anda.
Dialog: 0,0:28:56.48,0:28:58.14, Lalai,,0,0,0,, Keluar sahaja.
Dialog: 0,0:29:12.75,0:29:14.70,Lalai,,0,0,0,,♫ {\i1}Siapa yang berkata{\i0} ♫
Dialog: 0,0:29:15.21,0:29:17.85,Lalai,,0,0,0,,♫ {\i1}cinta{\i0} ♫
Dialog: 0,0:29:17.88,0:29:24.42,Lalai,,0,0,0,,♫ {\i1}cantik?{\i0} ♫
Dialog: 0,0:29:31.01,0:29:32.83, Lalai,,0,0,0,,Tinggalkan sahaja, sudah.
Dialog: 0,0:29:32.85,0:29:34.70, Lalai,,0,0,0,,Anda boleh pulang sekarang.
Dialog: 0,0:29:34.73,0:29:37.39, Lalai,,0,0,0,,Anda akan terus melihat saya menangis?
Dialog: 0,0:29:38.98,0:29:42.35,Lalai,,0,0,0,,Saya hanya menangis dalam perjalanan pulang!
Dialog: 0,0:29:47.45,0:29:50.23, Lalai,,0,0,0,,Mengapa anda pergi ke arah itu?
Dialog: 0,0:30:05.59,0:30:12.59,Lalai,,0,0,0,,♫ {\i1}Tidurkan saya{\i0} ♫
Dialog: 0,0:30:12.68,0:30:19.09,Lalai,,0,0,0,,♫ {\i1}dengan tangan anda yang saksama{\i0} ♫
Dialog: 0,0:32:32.01,0:32:33.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kad Pengenalan Peguam\NBaek Hyun-woo{\c}{\i0}
Dialog: 0,0:32:34.70,0:32:36.43, Lalai,,0,0,0,,Hei, bukankah dia menantu Queens?
Dialog: 0,0:32:36.45,0:32:39.01, Lalai,,0,0,0,, Menantu, kaki saya. Dia memang seorang butler.
Dialog: 0,0:32:39.04,0:32:42.47,Lalai,,0,0,0,,Saya dengar dia membersihkan kekusutan mertuanya.
Dialog: 0,0:32:42.50,0:32:44.45,Lalai,,0,0,0,,Di mana maruah dirinya?
Dialog: 0,0:32:46.50,0:32:49.65,Lalai,,0,0,0,,Dia tidak akan berkahwin\Ni dengan keluarga itu jika dia ada.
Dialog: 0,0:32:49.67,0:32:51.40,Lalai,,0,0,0,,Dia memalukan semua peguam.
Dialog: 0,0:32:51.42,0:32:53.71,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:33:04.64,0:33:05.87, Lalai,,0,0,0,,Oh, saya.
Dialog: 0,0:33:05.90,0:33:08.43, Lalai,,0,0,0,,Haleluya, Hyun-woo.
Dialog: 0,0:33:09.19,0:33:11.13, Lalai,,0,0,0,,Jadi bagaimana jika saya mempunyai $25 juta dalam akaun saya?
Dialog: 0,0:33:11.15,0:33:13.24,Lalai,,0,0,0,,Saya tidak boleh menggunakannya untuk membeli benang gigi di sini.
Dialog: 0,0:33:13.26,0:33:15.34, Lalai,,0,0,0,,Omong-omong, bagaimana anda menghasilkan idea ini?
Dialog: 0,0:33:15.36,0:33:17.06,Lalai,,0,0,0,,Puan.
Dialog: 0,0:33:17.45,0:33:20.48, Lalai,,0,0,0,,Ini sebenarnya menyalahi undang-undang, anda lihat.
Dialog: 0,0:33:20.91,0:33:21.97, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:33:22.00,0:33:24.14, Lalai,,0,0,0,,Berapa lama saya mesti dikurung?
Dialog: 0,0:33:24.16,0:33:25.81,Lalai,,0,0,0,,Saya tidak melakukan dosa besar.
Dialog: 0,0:33:25.83,0:33:28.40,Lalai,,0,0,0,,Saya fikir Seul-hee ialah\Npemberi maklumat yang melaporkan saya...
Dialog: 0,0:33:28.42,0:33:30.27,Lalai,,0,0,0,,untuk penyelewengan, jadi saya mencengkam rambutnya.
Dialog: 0,0:33:30.29,0:33:32.31,Lalai,,0,0,0,,Adakah itu jenayah?
Dialog: 0,0:33:32.34,0:33:34.65,Lalai,,0,0,0,,Dia terpaksa menerima rawatan selama empat minggu.
Dialog: 0,0:33:34.67,0:33:37.70, Lalai,,0,0,0,, Sial. Saya sepatutnya dimasukkan ke hospital sebaliknya.
Dialog: 0,0:33:37.72,0:33:39.53,Lalai,,0,0,0,,Dia sebab ibu saya meninggal dunia.
Dialog: 0,0:33:39.55,0:33:43.26, Lalai,,0,0,0,,Tunggu dan lihat sahaja. Saya akan membalas dendam padanya.
Dialog: 0,0:33:44.60,0:33:46.34,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:33:47.15,0:33:48.41,Lalai,,0,0,0,,Membalas dendam...
Dialog: 0,0:33:48.44,0:33:49.58,Lalai,,0,0,0,,adalah kepakaran saya.
Dialog: 0,0:33:49.61,0:33:51.79,Lalai,,0,0,0,,Saya sedar sepenuhnya tentang itu, puan.
Dialog: 0,0:33:51.82,0:33:54.63,Lalai,,0,0,0,,Ketiga-tiga bekas suami saya\Ntelah meninggalkan negara ini.
Dialog: 0,0:33:54.65,0:33:57.77,Lalai,,0,0,0,,Saya membawa neraka kepada mereka semua dan saudara-mara mereka.
Dialog: 0,0:33:58.66,0:34:00.22,Lalai,,0,0,0,,Puan.
Dialog: 0,0:34:00.24,0:34:02.68,Lalai,,0,0,0,,Pasangan suami isteri akhirnya boleh berpisah,
Dialog: 0,0:34:02.70,0:34:04.76, Lalai,,0,0,0,,jadi kenapa anda perlu pergi sejauh itu?
Dialog: 0,0:34:04.79,0:34:06.74, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:34:07.04,0:34:09.39, Lalai,,0,0,0,,Perceraian adalah kejam dan tidak kemas.
Dialog: 0,0:34:09.42,0:34:11.19,Lalai,,0,0,0,,Tiada "selamat tinggal" dalam perceraian.
Dialog: 0,0:34:11.21,0:34:14.79,Lalai,,0,0,0,,Penyelesaian terbaik ialah salah seorang daripada mereka mati.
Dialog: 0,0:34:14.84,0:34:17.15,Lalai,,0,0,0,,Jika saya berkahwin dan bercerai lagi pada masa hadapan,
Dialog: 0,0:34:17.18,0:34:19.42,Lalai,,0,0,0,,Saya akan meminta anda mengambil kes saya.
Dialog: 0,0:34:19.89,0:34:21.45,Lalai,,0,0,0,,Kenapa awak...
Dialog: 0,0:34:21.47,0:34:23.53,Lalai,,0,0,0,,sudah berfikir untuk bercerai lagi?
Dialog: 0,0:34:23.56,0:34:25.16,Lalai,,0,0,0,,Apa sahaja.
Dialog: 0,0:34:25.18,0:34:27.29,Lalai,,0,0,0,,Atas sebab tertentu,
Dialog: 0,0:34:27.31,0:34:29.87,Lalai,,0,0,0,,Saya rasa perkahwinan dan penceraian berjalan seiring,
Dialog: 0,0:34:29.90,0:34:32.35,Lalai,,0,0,0,, bukannya perkahwinan dan kebahagiaan.
Dialog: 0,0:34:32.52,0:34:33.71,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,0:34:33.73,0:34:35.17, Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:34:35.19,0:34:36.38, Lalai,,0,0,0,,Tiada apa-apa.
Dialog: 0,0:34:36.40,0:34:37.84, Lalai,,0,0,0,,Hei. Tengok sini.
Dialog: 0,0:34:37.86,0:34:40.23,Lalai,,0,0,0,,Saya kehilangan banyak rambut, bukan?
Dialog: 0,0:34:40.41,0:34:42.22, Lalai,,0,0,0,,Saya benar-benar perlu keluar dari sini.
Dialog: 0,0:34:42.24,0:34:43.93, Lalai,,0,0,0,,Tempat ini penuh dengan perempuan.
Dialog: 0,0:34:43.95,0:34:46.81, Lalai,,0,0,0,,Saya akan menjadi seperti\Nmereka jika saya tinggal di sini lagi.
Dialog: 0,0:34:46.83,0:34:48.53, Lalai,,0,0,0,,Perkhidmatan peringatan ibu saya akan datang.
Dialog: 0,0:34:48.55,0:34:50.60, Lalai,,0,0,0,,Ayah saya akan menyelesaikan perkara ini sebelum itu...
Dialog: 0,0:34:50.63,0:34:51.85,Lalai,,0,0,0,,demi dia, kan?
Dialog: 0,0:34:51.88,0:34:54.52,Lalai,,0,0,0,,Saya kini berada di hadapan Queens Town...
Dialog: 0,0:34:54.55,0:34:57.24,Lalai,,0,0,0,,di Hanil-dong, Yongsan-gu,\NSeoul tempat upacara peringatan...
Dialog: 0,0:34:57.27,0:34:59.40,Lalai,,0,0,0,, Yang Mi-suk, arwah isteri pengerusi\NQueens,
Dialog: 0,0:34:59.42,0:35:00.49, Lalai,,0,0,0,, sedang berlaku.
Dialog: 0,0:35:00.51,0:35:03.36, Lalai,,0,0,0,,Ahli keluarga tiba seorang demi seorang.
Dialog: 0,0:35:03.39,0:35:05.82,Lalai,,0,0,0,,Tahun ini, Hong Beom-seok,\Nanak lelaki sulung pengerusi...
Dialog: 0,0:35:05.85,0:35:07.66, Lalai,,0,0,0,,dan bekas Ketua Pegawai Eksekutif Queens Distribution,
Dialog: 0,0:35:07.68,0:35:11.21, Lalai,,0,0,0,,terbang dari Hawaii.
Dialog: 0,0:35:11.23,0:35:12.66, Lalai,,0,0,0,,Ada minat yang mendalam...
Dialog: 0,0:35:12.69,0:35:16.46,Lalai,,0,0,0,,sama ada pengerusi\Nand anaknya akan berdamai atau tidak...
Dialog: 0,0:35:16.48,0:35:19.10,Lalai,,0,0,0,,selepas perseteruan lama mereka.
Dialog: 0,0:35:20.40,0:35:23.93,Lalai,,0,0,0,,Tuan, bolehkah anda melihat pancake saya?\NDAdakah anda rasa bahagian dalamnya sudah masak?
Dialog: 0,0:35:23.95,0:35:25.39,Lalai,,0,0,0,,Mengapa anda bertanya kepada saya begitu?
Dialog: 0,0:35:25.41,0:35:27.10, Lalai,,0,0,0,,Anda belajar kimia di Harvard,
Dialog: 0,0:35:27.12,0:35:29.32, Lalai,,0,0,0,,jadi saya fikir anda akan tahu.
Dialog: 0,0:35:29.91,0:35:31.56, Lalai,,0,0,0,,Ya. Berdasarkan warna,
Dialog: 0,0:35:31.58,0:35:33.52,Lalai,,0,0,0,,Saya pasti mereka sudah masak. Balikkan mereka.
Dialog: 0,0:35:33.54,0:35:36.04, Lalai,,0,0,0,,Ya, tuan. Saya akan melakukan penyaduran.
Dialog: 0,0:35:36.50,0:35:39.19, Lalai,,0,0,0,,Adakah anda yang lulus\Ndari Sekolah Reka Bentuk Parsons?
Dialog: 0,0:35:39.22,0:35:40.73, Lalai,,0,0,0,,Tidak, itu saya.
Dialog: 0,0:35:40.76,0:35:42.99,Lalai,,0,0,0,,Keluarganya telah menjadi arkitek selama beberapa generasi.
Dialog: 0,0:35:43.01,0:35:44.91, Lalai,,0,0,0,,Keluarganya membuat arca besar...
Dialog: 0,0:35:44.93,0:35:46.87, Lalai,,0,0,0,,- di hadapan Louvre.\N- Saya jujur.
Dialog: 0,0:35:46.89,0:35:49.59, Lalai,,0,0,0,,Saya cukup yakin tentang menyusun makanan.
Dialog: 0,0:35:52.35,0:35:54.97,Lalai,,0,0,0,,Sungguh membazir bakat.
Dialog: 0,0:35:55.98,0:35:57.75,Lalai,,0,0,0,,Adik-adik ipar saya yang dikasihi.
Dialog: 0,0:35:57.78,0:36:00.59,Lalai,,0,0,0,,Ini Encik Choi. Dia\Nkahwin dengan Min-hee, saudara kita.
Dialog: 0,0:36:00.61,0:36:01.71, Lalai,,0,0,0,,Adik-adik ipar saya.
Dialog: 0,0:36:01.74,0:36:03.05, Lalai,,0,0,0,,Helo.
Dialog: 0,0:36:03.07,0:36:04.47, Lalai,,0,0,0,,Helo.
Dialog: 0,0:36:04.49,0:36:07.97,Lalai,,0,0,0,,Pada masa lalu,\Nkeluarga berkuasa seperti diraja...
Dialog: 0,0:36:07.99,0:36:11.14,Lalai,,0,0,0,,membuat ahli lelaki bersedia\Tiada segala-galanya untuk upacara peringatan.
Dialog: 0,0:36:11.16,0:36:14.23,Lalai,,0,0,0,,Pengerusi sangat\Nminat dalam tradisi diraja,
Dialog: 0,0:36:14.25,0:36:16.65, Lalai,,0,0,0,,jadi kami telah melakukan ini selama beberapa tahun sekarang.
Dialog: 0,0:36:16.67,0:36:19.33, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:36:19.63,0:36:20.77,Lalai,,0,0,0,,Betul.
Dialog: 0,0:36:20.80,0:36:23.65, Lalai,,0,0,0,,Ini semestinya sebab tradisi\Nanti masa depan berjalan lancar bersama-sama.
Dialog: 0,0:36:23.68,0:36:26.41, Lalai,,0,0,0,,Ini bukan cara lama.\NIIa agak progresif dan bagus.
Dialog: 0,0:36:26.43,0:36:28.24,Lalai,,0,0,0,,Ia sesuai dengan aliran semasa.
Dialog: 0,0:36:28.26,0:36:31.03, Lalai,,0,0,0,,Jika ia sangat progresif, bagus dan bergaya,
Dialog: 0,0:36:31.06,0:36:32.72,Lalai,,0,0,0,,kenapa anda tidak sertai kami?
Dialog: 0,0:36:33.23,0:36:34.50,Lalai,,0,0,0,,Anda kenal saya.
Dialog: 0,0:36:34.52,0:36:36.46,Lalai,,0,0,0,,Saya telah pergi ke gereja sejak tahun lepas,
Dialog: 0,0:36:36.48,0:36:38.21,Lalai,,0,0,0,,jadi ini bertentangan dengan agama saya.
Dialog: 0,0:36:38.23,0:36:40.43,Lalai,,0,0,0,,Saya dilahirkan sebagai seorang Kristian.
Dialog: 0,0:36:41.28,0:36:43.88,Lalai,,0,0,0,,Sejak saya masih muda,
Dialog: 0,0:36:43.91,0:36:45.92,Lalai,,0,0,0,,Saya ada syarat...
Dialog: 0,0:36:45.95,0:36:49.90,Lalai,,0,0,0,,di mana saya tidak dapat menghidu minyak. memang memalukan.
Dialog: 0,0:36:50.66,0:36:52.39,Lalai,,0,0,0,,Terima kasih atas kerja keras anda.
Dialog: 0,0:36:52.41,0:36:54.70,Lalai,,0,0,0,,Semoga berjaya.
Dialog: 0,0:36:55.63,0:36:57.69, Lalai,,0,0,0,,- Gosh.\N- Serius?
Dialog: 0,0:36:57.71,0:36:59.73, Lalai,,0,0,0,,Ini ialah upacara peringatan keluarga Hong,
Dialog: 0,0:36:59.75,0:37:03.07, Lalai,,0,0,0,,tetapi tiada sesiapa di sini yang mempunyai nama keluarga itu.
Dialog: 0,0:37:03.09,0:37:05.32,Lalai,,0,0,0,,Mereka harus menyediakan perkhidmatan peringatan mereka sendiri.
Dialog: 0,0:37:05.34,0:37:06.99,Lalai,,0,0,0,,- Astaga.\N- Saya anak lelaki kelima...
Dialog: 0,0:37:07.01,0:37:09.32, Lalai,,0,0,0,,daripada keluarga Yu di\NPaechon County, generasi ke-39.
Dialog: 0,0:37:09.35,0:37:12.83,Lalai,,0,0,0,,Apakah yang akan ibu saya katakan jika dia melihat\N saya menyiapkan lidi ini dalam sepuluh saat?
Dialog: 0,0:37:12.85,0:37:15.12,Lalai,,0,0,0,,Jangan bercakap tentang betapa berharganya kita...
Dialog: 0,0:37:15.14,0:37:17.14,Lalai,,0,0,0,,kepada keluarga kita.
Dialog: 0,0:37:18.98,0:37:20.29, Lalai,,0,0,0,,Selamat Datang ke Ratu.
Dialog: 0,0:37:20.32,0:37:22.13, Lalai,,0,0,0,,- Selamat datang.\N- Selamat datang.
Dialog: 0,0:37:22.15,0:37:24.23,Lalai,,0,0,0,,Jika saya jadi awak,
Dialog: 0,0:37:24.82,0:37:26.98, Lalai,,0,0,0,,Saya akan lari sekarang.
Dialog: 0,0:37:30.62,0:37:33.70, Lalai,,0,0,0,,Masih belum terlambat, kerana ia adalah\N upacara peringatan pertamanya.
Dialog: 0,0:37:33.91,0:37:37.28, Lalai,,0,0,0,,Bagaimana warnanya? Adakah ia kelihatan terlalu kusam?
Dialog: 0,0:37:37.33,0:37:40.54, Lalai,,0,0,0,,Hijau jed bukanlah warna yang mudah.
Dialog: 0,0:37:40.59,0:37:44.69,Lalai,,0,0,0,,Saya hanya melihat dua orang\Nyang kelihatan bagus dalam warna itu.
Dialog: 0,0:37:44.72,0:37:45.82,Lalai,,0,0,0,,Anda...
Dialog: 0,0:37:45.84,0:37:49.67, Lalai,,0,0,0,,dan Yuna Kim di Pertunjukan Fesyen London.
Dialog: 0,0:37:51.05,0:37:53.37, Lalai,,0,0,0,, Dia? Ya, dia kelihatan sangat baik.
Dialog: 0,0:37:53.39,0:37:55.12,Lalai,,0,0,0,,Dan begitu juga puan.
Dialog: 0,0:37:55.14,0:37:58.01, Lalai,,0,0,0,,Anda tahu cara menggembirakan orang lain.
Dialog: 0,0:38:01.69,0:38:03.34,Lalai,,0,0,0,,Pn. Moh.
Dialog: 0,0:38:03.36,0:38:06.31,Lalai,,0,0,0,,Mengapa anda tidak memakai\N{\i1}hanbok{\i0} yang dihantar kepada anda?
Dialog: 0,0:38:06.86,0:38:09.80, Lalai,,0,0,0,,Saya tidak sepatutnya berada di upacara peringatan ini.
Dialog: 0,0:38:09.82,0:38:12.15,Lalai,,0,0,0,,Keluarga boleh melakukannya tanpa saya.
Dialog: 0,0:38:13.03,0:38:15.64,Lalai,,0,0,0,,Anda telah bersama kami selama lebih\N20 tahun, jadi anda juga keluarga.
Dialog: 0,0:38:15.66,0:38:17.66, Lalai,,0,0,0,,Itulah keluarga.
Dialog: 0,0:38:17.71,0:38:21.65,Lalai,,0,0,0,,Kamu baik hati,\Ntetapi saya akan tinggal di bilik saya.
Dialog: 0,0:38:21.67,0:38:23.40,Lalai,,0,0,0,,Orang akan bercakap...
Dialog: 0,0:38:23.42,0:38:27.03, Lalai,,0,0,0,,tentang cara saya mendorong anda dan menganiaya anda.
Dialog: 0,0:38:27.05,0:38:29.71, Lalai,,0,0,0, "Tolak awak"? Siapa tolak siapa?
Dialog: 0,0:38:36.56,0:38:39.25, Lalai,,0,0,0,,Adakah anda mendorongnya?
Dialog: 0,0:38:39.27,0:38:41.71, Lalai,,0,0,0,,Saya? Tolak dia?
Dialog: 0,0:38:41.73,0:38:44.04, Lalai,,0,0,0,,Tidak, Bapa. tidak pernah.
Dialog: 0,0:38:44.07,0:38:45.54, Lalai,,0,0,0,,Lalu mengapa anda berkata demikian?
Dialog: 0,0:38:45.57,0:38:49.38,Lalai,,0,0,0,,Anda hanya berkata demikian kerana\Nitulah cara anda memikirkannya.
Dialog: 0,0:38:49.41,0:38:51.01, Lalai,,0,0,0,,Bukan sebab itu.
Dialog: 0,0:38:51.03,0:38:55.43,Lalai,,0,0,0,,Dia tidak mahu memakai {\i1}hanbok.{\i0}
Dialog: 0,0:38:55.45,0:38:58.20,Lalai,,0,0,0,,- Mengapa tidak?\N- Saya tidak tahu.
Dialog: 0,0:38:59.58,0:39:01.45, Lalai,,0,0,0,,Anda tidak akan melakukannya?
Dialog: 0,0:39:01.71,0:39:03.99, Lalai,,0,0,0,,Sudah tentu saya akan.
Dialog: 0,0:39:08.05,0:39:09.96, Lalai,,0,0,0,,Anda mendengarnya.
Dialog: 0,0:39:10.63,0:39:12.34, Lalai,,0,0,0,,Jom.
Dialog: 0,0:39:21.73,0:39:24.47,Lalai,,0,0,0,,Sungguh gila...!
Dialog: 0,0:39:25.19,0:39:27.23,Lalai,,0,0,0,,Aduh, saya sangat tertekan.
Dialog: 0,0:39:28.53,0:39:30.42,Lalai,,0,0,0,,Dia seorang yang licik.
Dialog: 0,0:39:30.45,0:39:35.57,Lalai,,0,0,0,,Dia akan hadir dengan beraninya\NMs. Upacara memperingati Yang...
Dialog: 0,0:39:35.87,0:39:37.55,Default,,0,0,0,,kerana pengerusi berkeras.
Dialog: 0,0:39:37.58,0:39:39.45,Lalai,,0,0,0,,Itu rancangan dia.
Dialog: 0,0:39:41.33,0:39:45.24,Lalai,,0,0,0,,Siapa kenal teman wanita mertua\Boleh jadi lebih teruk daripada ibu mertua?
Dialog: 0,0:40:04.02,0:40:06.47, Lalai,,0,0,0,, Beom-ja ada!
Dialog: 0,0:40:19.75,0:40:21.40, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:40:28.46,0:40:29.98, Lalai,,0,0,0,,Mengapa dia dilepaskan hari ini?
Dialog: 0,0:40:30.01,0:40:32.78, Lalai,,0,0,0,,Anda kata dia akan jatuh sakit jika dia\N kekal dikurung dalam kesejukan ini.
Dialog: 0,0:40:32.80,0:40:34.69,Lalai,,0,0,0,,Betul.
Dialog: 0,0:40:34.72,0:40:36.45, Lalai,,0,0,0,,Saya memang cakap begitu.
Dialog: 0,0:40:36.47,0:40:40.17,Lalai,,0,0,0,,Namun, anda sepatutnya menunggu untuk melepaskan\Nher selepas upacara peringatan.
Dialog: 0,0:40:42.73,0:40:44.91,Lalai,,0,0,0,,Apa? Lihatlah yang tidak berguna itu.
Dialog: 0,0:40:44.94,0:40:46.76, Lalai,,0,0,0,,Lihat sahaja dia.
Dialog: 0,0:40:48.11,0:40:49.98, Lalai,,0,0,0,,Saya tidak fikir, tuan.
Dialog: 0,0:40:55.99,0:40:57.30,Lalai,,0,0,0,,Ibu.
Dialog: 0,0:40:57.32,0:40:59.59, Lalai,,0,0,0,,Saya telah dikurung.
Dialog: 0,0:40:59.62,0:41:03.70,Lalai,,0,0,0,,Ayah meletakkan anak perempuan tunggalnya di sebalik bar,
Dialog: 0,0:41:04.37,0:41:07.81,Lalai,,0,0,0,,hanya kerana saya mencengkam rambut teman wanitanya dan menendangnya.
Dialog: 0,0:41:07.84,0:41:09.74, Lalai,,0,0,0,,Hei.
Dialog: 0,0:41:10.88,0:41:12.91, Lalai,,0,0,0,,Itulah kebenaran.
Dialog: 0,0:41:13.01,0:41:15.74, Lalai,,0,0,0,,Anda sangat menyusahkan dia.
Dialog: 0,0:41:15.76,0:41:18.53,Lalai,,0,0,0,,Bukan sahaja anda jatuh cinta dengan\Nwanita yang membunuh isteri anda,
Dialog: 0,0:41:18.55,0:41:20.53,Lalai,,0,0,0,,tetapi kamu menghantar anak perempuan kamu ke penjara.
Dialog: 0,0:41:20.56,0:41:23.08, Lalai,,0,0,0,,Anda benar-benar tidak berhati perut.
Dialog: 0,0:41:23.10,0:41:26.08,Lalai,,0,0,0,,Beom-ja, ini adalah peringatan\Nkhidmat Ibu. Nanti kita bincang. Okay?
Dialog: 0,0:41:26.10,0:41:28.83, Lalai,,0,0,0,,Anda tiada bezanya. Adakah\Nyou lupa siapa dia?
Dialog: 0,0:41:28.86,0:41:30.67,Lalai,,0,0,0,,Ibu mati kerana dia!
Dialog: 0,0:41:30.69,0:41:32.21,Lalai,,0,0,0,,Ibu meninggal dunia akibat serangan jantung...
Dialog: 0,0:41:32.23,0:41:36.13, Lalai,,0,0,0,,Tepat! Mengapa anda fikir dia mengalaminya?
Dialog: 0,0:41:36.16,0:41:39.23,Lalai,,0,0,0,,Jantungnya berhenti kerana dia\Nmarah pada Moh Seul-hee!
Dialog: 0,0:41:39.53,0:41:43.47,Lalai,,0,0,0,,Jadi bagaimana anda boleh tahan melihat\Nat dia setiap hari dan malam?
Dialog: 0,0:41:43.50,0:41:45.14, Lalai,,0,0,0,,Anda tidak kecewa?
Dialog: 0,0:41:45.16,0:41:48.83, Lalai,,0,0,0,,- Beom-ja, Saya...\N- Aduh, Mak.
Dialog: 0,0:41:49.00,0:41:51.15,Lalai,,0,0,0,,Apa gunanya mempunyai anak lelaki?
Dialog: 0,0:41:51.17,0:41:53.52,Lalai,,0,0,0,,Anda tidak menyediakan pun\Nskate, makanan kegemarannya,
Dialog: 0,0:41:53.55,0:41:54.86, Lalai,,0,0,0,,jadi siapa awak untuk bercakap?
Dialog: 0,0:41:54.88,0:41:58.15, Lalai,,0,0,0,,Mak Cik Beom-ja, kami ada kasut luncur.\NBaunya rumah.
Dialog: 0,0:41:58.18,0:42:00.36, Lalai,,0,0,0,,Sesat, bodoh!
Dialog: 0,0:42:00.39,0:42:03.74,Lalai,,0,0,0,,Bagaimana anda tidak pernah melawat\N saya apabila saya membesarkan anda sendiri?
Dialog: 0,0:42:03.77,0:42:06.54,Lalai,,0,0,0,,Anda tidak membesarkannya.
Dialog: 0,0:42:06.56,0:42:08.08,Lalai,,0,0,0,,Jangan mengarut.
Dialog: 0,0:42:08.10,0:42:09.46, Lalai,,0,0,0,,Mak Cik Beom-ja.
Dialog: 0,0:42:09.48,0:42:11.46, Lalai,,0,0,0,,Kami hanya menghidangkan alkohol.
Dialog: 0,0:42:11.48,0:42:13.02, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:42:13.53,0:42:16.14, Lalai,,0,0,0,,Kita harus teruskan. Teruskan.
Dialog: 0,0:42:29.79,0:42:30.94, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:42:30.96,0:42:32.19,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:42:32.21,0:42:34.48, Lalai,,0,0,0,,Hei, pusingkan kaca perlahan-lahan.
Dialog: 0,0:42:34.51,0:42:37.19, Lalai,,0,0,0,,Dia seorang yang ringan.\NAnda akan membuatnya mabuk!
Dialog: 0,0:42:37.22,0:42:38.96, Lalai,,0,0,0,, Beom-ja.
Dialog: 0,0:42:39.09,0:42:40.32,Lalai,,0,0,0,,Ibu minum seperti ikan.
Dialog: 0,0:42:40.34,0:42:44.71,Lalai,,0,0,0,,Itu fakta yang kita berdua tahu adalah benar.
Dialog: 0,0:42:45.35,0:42:46.91,Lalai,,0,0,0,,Mengapa anda fikir dia minum begitu banyak?
Dialog: 0,0:42:46.93,0:42:49.93,Lalai,,0,0,0,,Sebab wanita itu membuatkan dia tertekan!
Dialog: 0,0:42:50.23,0:42:51.33,Lalai,,0,0,0,,Pakcik.
Dialog: 0,0:42:51.36,0:42:54.75,Lalai,,0,0,0,,Bukankah tersentuh hati anda\Nmengetahui adik anda meninggal dunia...
Dialog: 0,0:42:54.78,0:42:57.71,Lalai,,0,0,0,,kerana dia marah\Noleh perempuan itu? Katakan sesuatu!
Dialog: 0,0:42:57.74,0:43:00.13, Lalai,,0,0,0,, Beom-ja, bukan sebab dia mati.
Dialog: 0,0:43:00.16,0:43:03.30,Lalai,,0,0,0,,Dia meninggal dunia akibat serangan jantung.\NIIa berlaku dalam keluarga.
Dialog: 0,0:43:03.33,0:43:05.69,Lalai,,0,0,0,,- Anda juga harus berhati-hati.\N- Baik.
Dialog: 0,0:43:05.83,0:43:07.53, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:43:08.12,0:43:10.12,Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:43:15.13,0:43:16.27,Lalai,,0,0,0,,Ibu.
Dialog: 0,0:43:16.30,0:43:19.37,Lalai,,0,0,0,,Keluarga ini benar-benar bencana.
Dialog: 0,0:43:20.80,0:43:23.20,Lalai,,0,0,0,,Tak payahlah melawat.
Dialog: 0,0:43:23.22,0:43:26.05, Lalai,,0,0,0,,Saya akan minum alkohol.
Dialog: 0,0:43:26.72,0:43:28.68, Lalai,,0,0,0,,Anda harus membuat pusingan U.
Dialog: 0,0:43:29.94,0:43:33.15,Lalai,,0,0,0,,En. Hong, anda akhirnya kembali selepas\N19 tahun. Adakah anda akan menyertai semula Queens...?
Dialog: 0,0:43:33.18,0:43:35.48,Lalai,,0,0,0,,Adakah anda akan menghadiri upacara peringatan ibu anda?
Dialog: 0,0:43:35.51,0:43:37.09, Lalai,,0,0,0,,Adakah anda akan berjumpa dengan Pengerusi Hong?
Dialog: 0,0:43:37.11,0:43:39.44,Lalai,,0,0,0,,Adakah kamu berdua telah berdamai?
Dialog: 0,0:43:49.79,0:43:52.18,Lalai,,0,0,0,,Sila duduk. Dia akan pergi akhirnya.
Dialog: 0,0:43:52.21,0:43:54.20,Lalai,,0,0,0,,Sebab itu saya lebih hina dia.
Dialog: 0,0:43:56.17,0:43:58.86, Lalai,,0,0,0,,Si brengsek itu tidak datang berjumpa saya.
Dialog: 0,0:43:58.88,0:44:01.07, Lalai,,0,0,0,,Dia datang untuk mengambil gambarnya.
Dialog: 0,0:44:01.09,0:44:02.44, Lalai,,0,0,0,, Tengok dia.
Dialog: 0,0:44:02.47,0:44:06.24, Lalai,,0,0,0,,Dia sengaja berdiri\Selama hujan untuk kamera.
Dialog: 0,0:44:06.26,0:44:08.21, Lalai,,0,0,0,,Memang bodoh.
Dialog: 0,0:44:10.93,0:44:13.75,Lalai,,0,0,0,,Kamilah yang memasak semua penkek itu.
Dialog: 0,0:44:13.77,0:44:15.08,Lalai,,0,0,0,,Adakah anda nampak tangan saya menggeletar?
Dialog: 0,0:44:15.11,0:44:17.32,Lalai,,0,0,0,,Tetapi mereka tidak membenarkan\Nus menghadiri perkhidmatan itu.
Dialog: 0,0:44:17.35,0:44:20.26,Lalai,,0,0,0,,Sekarang ini, saya banyak menghabiskan masa\Forum bukan internet tentang ibu.
Dialog: 0,0:44:20.29,0:44:23.34, Lalai,,0,0,0,,Saya boleh kaitkan dengan banyak siaran mereka.
Dialog: 0,0:44:23.39,0:44:26.35,Lalai,,0,0,0,,Saya tidak ingat kali terakhir\NI melawat ibu bapa saya pada hari cuti.
Dialog: 0,0:44:26.37,0:44:28.41, Lalai,,0,0,0,,Mereka berkata mereka akan melepaskan kami selepas kami membersihkan diri.
Dialog: 0,0:44:28.44,0:44:30.16,Lalai,,0,0,0,,- "Tunggu makcik mertua kamu."\N- Betul.
Dialog: 0,0:44:30.18,0:44:31.49,Lalai,,0,0,0,,"Tunggu pakcik mertua kamu."
Dialog: 0,0:44:31.51,0:44:32.53, Lalai,,0,0,0,,"Potong beberapa epal."
Dialog: 0,0:44:32.56,0:44:33.73, Lalai,,0,0,0,,"Hidangkan penkek."
Dialog: 0,0:44:33.75,0:44:35.85,Lalai,,0,0,0,,Maksud saya, bagaimana dengan keluarga kita?
Dialog: 0,0:44:35.88,0:44:38.06,Lalai,,0,0,0,,Hari ini hari lahir bapa Hyun-woo.
Dialog: 0,0:44:38.09,0:44:39.77,Lalai,,0,0,0,,Hari lahirnya yang ke-60,
Dialog: 0,0:44:39.80,0:44:43.03, Lalai,,0,0,0,,tetapi dia boleh melawatnya kerana\Bukan upacara peringatan ini.
Dialog: 0,0:44:43.05,0:44:45.95,Lalai,,0,0,0,,Apapun, saya paling kasihan kepadanya.
Dialog: 0,0:44:45.97,0:44:47.20,Lalai,,0,0,0,,- Saya juga.\N- Saya juga.
Dialog: 0,0:44:47.22,0:44:50.24,Lalai,,0,0,0,,Isteri kami adalah sepupu mereka,\Ntetapi dia berkahwin dengan talian terus. Astaga.
Dialog: 0,0:44:50.27,0:44:51.97, Lalai,,0,0,0,, Mertuanya...
Dialog: 0,0:44:52.14,0:44:53.20,Lalai,,0,0,0,,semuanya menakutkan.
Dialog: 0,0:44:53.23,0:44:55.35,Lalai,,0,0,0,,- {\i1}Ia.\N- Ya.{\i0}
Dialog: 0,0:44:55.44,0:44:57.22,Lalai,,0,0,0,,Pengarah Jo.
Dialog: 0,0:44:57.73,0:45:00.34, Lalai,,0,0,0,,Anda telah menghadiri\N perkhidmatan peringatan selama 20 tahun sekarang.
Dialog: 0,0:45:00.36,0:45:03.96,Lalai,,0,0,0,,Dia sentiasa melayan saya dengan baik.\TIDAK sudah tentu saya patut datang.
Dialog: 0,0:45:03.99,0:45:06.98,Lalai,,0,0,0,,Saya tahu anda telah menyerahkan surat peletakan jawatan anda,
Dialog: 0,0:45:07.03,0:45:08.64, Lalai,,0,0,0,,tetapi saya benar-benar tidak mahu menerimanya.
Dialog: 0,0:45:08.67,0:45:11.60,Lalai,,0,0,0,,Saya berfikir panjang dan keras\Nsebelum membuat keputusan itu.
Dialog: 0,0:45:11.62,0:45:14.32,Lalai,,0,0,0,,Tidak lama lagi saya akan terlalu tua untuk memulakan yang baru.
Dialog: 0,0:45:14.67,0:45:17.53,Lalai,,0,0,0,,Baiklah. Ia tidak boleh membantu, kemudian.
Dialog: 0,0:45:19.09,0:45:20.69, Lalai,,0,0,0,,Saya akan sentiasa menyokong anda.
Dialog: 0,0:45:20.71,0:45:22.44, Lalai,,0,0,0,,Terima kasih banyak, tuan.
Dialog: 0,0:45:22.46,0:45:24.82, Lalai,,0,0,0,, Tengok dia. Sungguh ganjil\Ndia berhenti begitu tiba-tiba.
Dialog: 0,0:45:24.84,0:45:26.28,Lalai,,0,0,0,,Saya pasti ada sesuatu yang berlaku.
Dialog: 0,0:45:26.30,0:45:28.46,Lalai,,0,0,0,,Saya akan menyiasat dia secara berhemah.
Dialog: 0,0:45:29.01,0:45:31.99, Lalai,,0,0,0,,Tidak, semua orang patut tahu tentang perkara ini.
Dialog: 0,0:45:32.02,0:45:35.72,Lalai,,0,0,0,,Ketahui apa yang dia lakukan dan biarkan\Nmedia melihat dia pergi ke mahkamah.
Dialog: 0,0:45:35.81,0:45:38.01, Lalai,,0,0,0,,Tujuan saya bukan untuk menghukum dia.
Dialog: 0,0:45:38.48,0:45:40.22,Lalai,,0,0,0,,Ini untuk memalukan dia.
Dialog: 0,0:45:41.36,0:45:44.85, Lalai,,0,0,0,,Mengapa anda ingin berbuat demikian?
Dialog: 0,0:45:49.74,0:45:52.22,Lalai,,0,0,0,,Saya tidak pernah benarkan mereka yang\Nmembelakangiku...
Dialog: 0,0:45:52.24,0:45:53.35, Lalai,,0,0,0,,untuk dibiarkan dalam satu bahagian.
Dialog: 0,0:45:53.37,0:45:56.27,Lalai,,0,0,0,,Mereka perlu menderita dalam perjalanan keluar,
Dialog: 0,0:45:56.29,0:45:59.12, Lalai,,0,0,0,,jadi ia tidak akan menimbulkan masalah lagi.
Dialog: 0,0:46:01.59,0:46:03.54,Lalai,,0,0,0,,Ada apa dengan muka?
Dialog: 0,0:46:04.05,0:46:06.25, Lalai,,0,0,0,,Adakah anda mempunyai sesuatu untuk dikatakan?
Dialog: 0,0:46:06.38,0:46:09.46, Lalai,,0,0,0,,Tetapi dia menumpukan bertahun-tahun untuk anda.
Dialog: 0,0:46:10.76,0:46:13.55,Lalai,,0,0,0,,Adakah betul untuk memotongnya...
Dialog: 0,0:46:14.18,0:46:16.51, Lalai,,0,0,0,, sangat kejam?
Dialog: 0,0:46:23.11,0:46:24.75,Lalai,,0,0,0,,Itu mungkin yang dia fikirkan,
Dialog: 0,0:46:24.78,0:46:26.09,Lalai,,0,0,0,,tetapi itu pendapat dia.
Dialog: 0,0:46:26.11,0:46:28.34, Lalai,,0,0,0,,Saya percaya sesebuah organisasi mesti mengikut peraturannya.
Dialog: 0,0:46:28.36,0:46:30.18, Lalai,,0,0,0,,Itu betul-betul.
Dialog: 0,0:46:30.20,0:46:34.26,Lalai,,0,0,0,,Bukan dia sahaja. Saya mengejar sesiapa\Nelse yang mempunyai idea yang sama.
Dialog: 0,0:46:34.29,0:46:37.41,Lalai,,0,0,0,,Ini adalah amaran kepada mereka\Nyang ingin menikam saya dari belakang.
Dialog: 0,0:46:38.33,0:46:40.31, Lalai,,0,0,0,,- Ya, tuan.\N- Ingat itu.
Dialog: 0,0:46:40.33,0:46:43.87, Lalai,,0,0,0,,- Maaf?\N- Anda tidak sepatutnya mengucapkan selamat tinggal...
Dialog: 0,0:46:43.96,0:46:45.71, Lalai,,0,0,0,, kepada mereka yang meninggalkan anda.
Dialog: 0,0:46:47.42,0:46:49.88, Lalai,,0,0,0,,Anda mesti menikam mereka dari belakang.
Dialog: 0,0:46:50.84,0:46:52.55, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:46:53.43,0:46:55.13,Lalai,,0,0,0,,Syabas.
Dialog: 0,0:46:55.35,0:46:57.09, Lalai,,0,0,0,, Rehat.
Dialog: 0,0:47:00.48,0:47:01.62, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:47:01.65,0:47:03.35, Lalai,,0,0,0,,Selamat tinggal, kemudian.
Dialog: 0,0:47:17.16,0:47:19.66,Lalai,,0,0,0,,{\i1}Saya tidak mempunyai selera makan.{\i0}
Dialog: 0,0:47:20.25,0:47:24.41,Lalai,,0,0,0,,Rasanya selera saya hilang sepenuhnya.
Dialog: 0,0:47:24.71,0:47:28.08, Lalai,,0,0,0,,Sangat menyesakkan untuk berada di sekeliling ramai orang.
Dialog: 0,0:47:31.51,0:47:34.24, Lalai,,0,0,0,,Tahap tekanan anda nampaknya sangat tinggi.
Dialog: 0,0:47:34.26,0:47:36.20,Lalai,,0,0,0,,Berdasarkan ujian pelengkap ayat anda,
Dialog: 0,0:47:36.22,0:47:38.70,Lalai,,0,0,0,,anda menulis bahawa keinginan terbesar anda sekarang...
Dialog: 0,0:47:38.73,0:47:40.84,Lalai,,0,0,0,,sedang bercerai.
Dialog: 0,0:47:40.89,0:47:44.10, Lalai,,0,0,0,,- Betul.\N- Saya faham... Dan kenapa begitu?
Dialog: 0,0:47:44.65,0:47:49.48,Lalai,,0,0,0,,Saya tinggal bersama ibu bapa mertua saya...
Dialog: 0,0:47:49.57,0:47:51.77,Lalai,,0,0,0,,dan datuk mertua saya.
Dialog: 0,0:47:52.07,0:47:53.22,Lalai,,0,0,0,,Dan dia.
Dialog: 0,0:47:53.24,0:47:55.26,Lalai,,0,0,0,,Serta makcik mertua saya yang baru sahaja discaj,
Dialog: 0,0:47:55.28,0:47:56.93,Lalai,,0,0,0,,dan keluarga abang ipar saya.
Dialog: 0,0:47:56.95,0:47:58.74,Lalai,,0,0,0,,Kita semua hidup...
Dialog: 0,0:47:59.54,0:48:01.45, Lalai,,0,0,0,,di bawah bumbung yang sama.
Dialog: 0,0:48:02.79,0:48:04.62, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:48:04.92,0:48:08.40,Lalai,,0,0,0,,Jarang untuk melihat keluarga besar\Nkini. Anda diberkati.
Dialog: 0,0:48:08.42,0:48:11.11, Lalai,,0,0,0,,Kami sangat bertuah kerana kami\Nmakan malam bersama setiap malam.
Dialog: 0,0:48:11.13,0:48:14.32, Lalai,,0,0,0,, Kemudian kami berkumpul pada pukul 9 malam. untuk bercakap.
Dialog: 0,0:48:14.34,0:48:15.61, Lalai,,0,0,0,,Pertemuan akhir hari.
Dialog: 0,0:48:15.64,0:48:17.78, Lalai,,0,0,0,,Hujung minggu, cuti,\Nhari lahir dan Krismas.
Dialog: 0,0:48:17.81,0:48:21.58, Lalai,,0,0,0,,Kami menghabiskannya bersama sepanjang\Ntahun '. Ia selamat untuk mengatakan...
Dialog: 0,0:48:21.60,0:48:23.89, Lalai,,0,0,0,,Saya tiada masa untuk diri sendiri.
Dialog: 0,0:48:25.52,0:48:27.71,Lalai,,0,0,0,,Kami mempunyai 15 perkhidmatan peringatan setahun.
Dialog: 0,0:48:27.73,0:48:29.54,Lalai,,0,0,0,,Mereka mengatakan keluarga bangsawan pada masa lalu...
Dialog: 0,0:48:29.57,0:48:32.26,Lalai,,0,0,0,,membuat ahli lelaki mereka\Nbersedia untuk perkhidmatan,
Dialog: 0,0:48:32.28,0:48:35.68,Lalai,,0,0,0,,jadi menantu-menantu bersedia\Nuntuk keseluruhan perkhidmatan,
Dialog: 0,0:48:35.70,0:48:39.69, Lalai,,0,0,0,,tetapi anak lelaki mereka tidak pernah membantu.
Dialog: 0,0:48:41.20,0:48:43.03, Lalai,,0,0,0,,Rasanya...
Dialog: 0,0:48:43.37,0:48:46.87, Lalai,,0,0,0,,anda memerlukan tempat di mana\Anda boleh jauh daripada mereka.
Dialog: 0,0:48:47.38,0:48:49.73,Lalai,,0,0,0,,Adakah anda mempunyai pekerjaan?
Dialog: 0,0:48:49.76,0:48:51.82, Lalai,,0,0,0,,- Ya.\N- Baik.
Dialog: 0,0:48:51.84,0:48:52.98,Lalai,,0,0,0,,Bagaimana kehidupan kerja anda?
Dialog: 0,0:48:53.01,0:48:54.83, Lalai,,0,0,0,,Isteri saya adalah bos saya,
Dialog: 0,0:48:55.89,0:48:58.00,Lalai,,0,0,0,,dan bapa mertua saya ialah bosnya.
Dialog: 0,0:48:58.31,0:49:00.41,Lalai,,0,0,0,,Kemudian datuk mertua saya...
Dialog: 0,0:49:00.43,0:49:02.18,Lalai,,0,0,0,,adalah bosnya.
Dialog: 0,0:49:02.68,0:49:05.25,Lalai,,0,0,0,,Jantungku berdegup kencang, dan tanganku menggeletar...
Dialog: 0,0:49:05.27,0:49:06.83, Lalai,,0,0,0,,setiap kali mertua saya menghubungi.
Dialog: 0,0:49:06.86,0:49:09.64, Lalai,,0,0,0,,Saya bimbang tentang apa yang mereka akan minta saya lakukan.
Dialog: 0,0:49:09.86,0:49:13.09,Lalai,,0,0,0,,Mengapa anda tidak menjauhkan diri\Ndari persekitaran yang tertekan ini?
Dialog: 0,0:49:13.11,0:49:14.59,Lalai,,0,0,0,,Maka perceraian adalah satu-satunya pilihan.
Dialog: 0,0:49:14.61,0:49:16.34, Lalai,,0,0,0,,Anda boleh keluar dengan isteri anda.
Dialog: 0,0:49:16.37,0:49:19.32,Lalai,,0,0,0,,Memang saya tidak suka mertua saya. Namun...
Dialog: 0,0:49:19.62,0:49:21.72,Lalai,,0,0,0,,Saya lebih hina isteri saya.
Dialog: 0,0:49:21.75,0:49:22.85, Lalai,,0,0,0,,Kenapa begitu?
Dialog: 0,0:49:22.87,0:49:24.66,Lalai,,0,0,0,,Dia tidak kisah...
Dialog: 0,0:49:24.79,0:49:27.94,Lalai,,0,0,0,, sama sekali tentang saya, atau cara keluarganya melayan saya.
Dialog: 0,0:49:27.96,0:49:31.11,Lalai,,0,0,0,,Dia hanya mementingkan dirinya. Tidakkah dia mementingkan diri sendiri?
Dialog: 0,0:49:31.13,0:49:33.48,Lalai,,0,0,0,,Saya hanya berkahwin dalam keluarga kerana dia,
Dialog: 0,0:49:33.51,0:49:36.00, Lalai,,0,0,0,,dan bertahan selama tiga tahun rawatan ini,
Dialog: 0,0:49:36.76,0:49:38.45, Lalai,,0,0,0,,tetapi dia tidak kisah.
Dialog: 0,0:49:38.47,0:49:41.99,Lalai,,0,0,0,,Sebelum kami berkahwin,\Ndia kata saya boleh mempercayainya.
Dialog: 0,0:49:42.02,0:49:43.93,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sahaja yang anda perlukan.{\c}{\i0}
Dialog: 0,0:49:43.98,0:49:45.68, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Percayalah kepada saya.{\c}{\i0}
Dialog: 0,0:49:45.73,0:49:48.01,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak akan pernah...{\c}{\i0}
Dialog: 0,0:49:48.27,0:49:50.47,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}membuat anda menangis.{\c}{\i0}
Dialog: 0,0:49:59.07,0:50:01.34, Lalai,,0,0,0,,Saya bodoh kerana mempercayainya.
Dialog: 0,0:50:01.37,0:50:04.07, Lalai,,0,0,0,,Adakah anda terluka dan kecewa dengannya?
Dialog: 0,0:50:05.54,0:50:06.52, Lalai,,0,0,0,,No.
Dialog: 0,0:50:06.54,0:50:08.52, Lalai,,0,0,0,,Saya tidak lagi berasa seperti itu.
Dialog: 0,0:50:08.54,0:50:10.20, Lalai,,0,0,0,,Saya hanya menghinanya.
Dialog: 0,0:50:10.38,0:50:12.08,Lalai,,0,0,0,,Saya benci dia...
Dialog: 0,0:50:12.34,0:50:13.98,Lalai,,0,0,0,,dengan semangat.
Dialog: 0,0:50:14.01,0:50:15.53, Lalai,,0,0,0,,Dan itulah sebabnya anda mahu bercerai.
Dialog: 0,0:50:15.55,0:50:17.28, Lalai,,0,0,0,,Itulah satu-satunya cara saya akan hidup.
Dialog: 0,0:50:17.30,0:50:19.21, Lalai,,0,0,0,,Kalau begitu kenapa tidak anda?
Dialog: 0,0:50:20.60,0:50:22.41, Lalai,,0,0,0,, Kerana saya boleh mati.
Dialog: 0,0:50:22.43,0:50:23.49,Lalai,,0,0,0,,Apa?
Dialog: 0,0:50:23.52,0:50:25.20,Lalai,,0,0,0,,Bapa mertua saya...
Dialog: 0,0:50:25.23,0:50:27.76,Lalai,,0,0,0,,paling hina apabila kaumnya...
Dialog: 0,0:50:28.69,0:50:31.29,Lalai,,0,0,0,,membelakangkan dia.
Dialog: 0,0:50:31.31,0:50:33.21,Lalai,,0,0,0,,Saat saya ceraikan dia,
Dialog: 0,0:50:33.23,0:50:34.79, Lalai,,0,0,0,,dia akan tikam saya dari belakang.
Dialog: 0,0:50:34.82,0:50:35.88, Lalai,,0,0,0,, Tikam awak?
Dialog: 0,0:50:35.90,0:50:38.48, Lalai,,0,0,0,,Sudah tentu itu adalah kiasan,
Dialog: 0,0:50:40.37,0:50:43.28, Lalai,,0,0,0,,tetapi ditikam mungkin lebih baik.
Dialog: 0,0:50:55.13,0:50:59.42, Lalai,,0,0,0,,Saya akan tetapkan anda sesuatu yang kuat, jadi terimalah.
Dialog: 0,0:50:59.97,0:51:01.67, Lalai,,0,0,0,, Tunggu di sana.
Dialog: 0,0:51:13.32,0:51:15.06, Lalai,,0,0,0,,Selamat tinggal.
Dialog: 0,0:51:27.45,0:51:29.45,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Isteri{\c}{\i0}
Dialog: 0,0:51:35.05,0:51:36.15, Lalai,,0,0,0,,Saya sayang awak, Sayang.
Dialog: 0,0:51:36.17,0:51:37.86, Lalai,,0,0,0,,Saya benar-benar rasa saya gembira.
Dialog: 0,0:51:37.88,0:51:40.25,Lalai,,0,0,0,,Saya tidak melakukan apa-apa.
Dialog: 0,0:51:40.47,0:51:42.53, Lalai,,0,0,0,,Saya sangat bersyukur...
Dialog: 0,0:51:42.55,0:51:44.25, Lalai,,0,0,0,,Helo?
Dialog: 0,0:51:50.81,0:51:52.51,Lalai,,0,0,0,,Saya sangat gembira.
Dialog: 0,0:51:54.44,0:51:55.75, Lalai,,0,0,0,,Tunggu, Grace.
Dialog: 0,0:51:55.77,0:51:58.09, Lalai,,0,0,0,,Kenapa awak tak cakap apa-apa?
Dialog: 0,0:51:58.11,0:52:00.17, Lalai,,0,0,0,,Anda harus bertanggungjawab untuk berkata...
Dialog: 0,0:52:00.20,0:52:02.80, Lalai,,0,0,0,,pewaris Ketiga Kumpulan Jinseong\N adalah urusan sebenar.
Dialog: 0,0:52:02.82,0:52:04.72, Lalai,,0,0,0,,Mengapa saya perlu berbuat demikian?
Dialog: 0,0:52:04.74,0:52:07.93,Lalai,,0,0,0,,Saya dengar awak pilih anak sulung mereka.\NGO pada tarikh buta itu.
Dialog: 0,0:52:07.95,0:52:09.43, Lalai,,0,0,0,,Tetapi pengerusi tidak suka dia,
Dialog: 0,0:52:09.46,0:52:11.24,Lalai,,0,0,0,,jadi bagaimana saya boleh menetapkan anak perempuan saya dengannya,
Dialog: 0,0:52:11.26,0:52:14.10,Lalai,,0,0,0,,apabila saya mendengar anak lelaki ketiganya akan mewarisi segala-galanya?
Dialog: 0,0:52:14.13,0:52:16.35, Lalai,,0,0,0,,Anda sepatutnya datang kepada saya dahulu.
Dialog: 0,0:52:16.38,0:52:19.03,Lalai,,0,0,0,,Kamu sudah mengatur janji\N buta dengan anak sulung, penyangak,
Dialog: 0,0:52:19.06,0:52:20.61, Lalai,,0,0,0,,jadi apa yang boleh saya lakukan?
Dialog: 0,0:52:20.63,0:52:22.61, Lalai,,0,0,0,,Anda hanya perlu pergi ke pencari jodoh itu.
Dialog: 0,0:52:22.63,0:52:24.49,Lalai,,0,0,0,,Saya berada dalam dilema.
Dialog: 0,0:52:24.51,0:52:28.42, Lalai,,0,0,0,,Apakah pilihan yang saya ada apabila\NI mendengar anda tidak lagi cekap?
Dialog: 0,0:52:34.40,0:52:35.46, Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:52:35.48,0:52:37.58, Lalai,,0,0,0,, Jadi bagaimana jika anda melayan wanita Ratu?
Dialog: 0,0:52:37.61,0:52:41.75,Lalai,,0,0,0,,Anda boleh mengawasi hal rumah tangga mereka,\Ntetapi anak perempuan anda masih bujang.
Dialog: 0,0:52:41.78,0:52:43.63, Lalai,,0,0,0,,Itulah sebabnya...
Dialog: 0,0:52:43.66,0:52:47.05,Lalai,,0,0,0,,Hong Hae-in menyesal kerana tidak mendengar\N saya, dan berkahwin dengan suaminya yang kini.
Dialog: 0,0:52:47.08,0:52:48.82,Lalai,,0,0,0,,Serius?
Dialog: 0,0:52:48.91,0:52:51.03, Lalai,,0,0,0,,Adakah mereka bercerai?
Dialog: 0,0:52:52.21,0:52:54.77, Lalai,,0,0,0,,Anda tidak boleh bersama seseorang\Nyang keluar dari liga anda.
Dialog: 0,0:52:54.79,0:52:57.08,Lalai,,0,0,0,,Tiga tahun sudah memadai.
Dialog: 0,0:52:57.21,0:52:58.27, Lalai,,0,0,0,,Tunggu dan lihat sahaja.
Dialog: 0,0:52:58.30,0:52:59.94,Lalai,,0,0,0,,Malah Hong Hae-in yang hebat...
Dialog: 0,0:52:59.96,0:53:03.75,Lalai,,0,0,0,,akan mendengar saya apabila dia mahu berkahwin semula.
Dialog: 0,0:53:18.44,0:53:20.22,Lalai,,0,0,0,,Pn. Hong!
Dialog: 0,0:53:25.57,0:53:28.43,Lalai,,0,0,0,,Ibu kamu singgah ke spa kami pagi ini.
Dialog: 0,0:53:28.45,0:53:31.49,Lalai,,0,0,0,,Saya suruh awak datang. Mengapa anda tidak mahu?
Dialog: 0,0:53:33.00,0:53:35.99,Lalai,,0,0,0,,Adakah anda tertekan hari ini?
Dialog: 0,0:53:36.50,0:53:38.44, Lalai,,0,0,0,,Kulit anda kelihatan kusam.
Dialog: 0,0:53:38.46,0:53:41.86, Lalai,,0,0,0,,Kami mempunyai beberapa serum dan mesin yang hebat.
Dialog: 0,0:53:41.88,0:53:44.86,Lalai,,0,0,0,,Saya akan kosongkan jadual kami, jadi singgahlah.
Dialog: 0,0:53:44.88,0:53:46.94, Lalai,,0,0,0,,Anda mesti sibuk, jadi anda tidak perlu berbuat demikian.
Dialog: 0,0:53:46.97,0:53:48.79, Lalai,,0,0,0,,Kami tidak sibuk.
Dialog: 0,0:53:49.72,0:53:54.49,Lalai,,0,0,0,,Awak risau sangat tentang saya!
Dialog: 0,0:53:54.52,0:53:55.58, Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,0:53:55.60,0:53:57.39,Lalai,,0,0,0,,Apa?
Dialog: 0,0:53:58.15,0:54:02.31, Lalai,,0,0,0,,Saya cuma cakap saya tidak akan pergi ke spa anda.
Dialog: 0,0:54:05.32,0:54:08.06, Lalai,,0,0,0,,Anda sangat dingin.
Dialog: 0,0:54:09.28,0:54:11.73, Lalai,,0,0,0,,Awak buat saya rasa jauh.
Dialog: 0,0:54:13.04,0:54:16.03, Lalai,,0,0,0,,Anda sepatutnya berasa begitu.
Dialog: 0,0:54:16.75,0:54:18.02, Lalai,,0,0,0,,Anda mesti melayan saya...
Dialog: 0,0:54:18.04,0:54:21.10,Lalai,,0,0,0,,macam kawan sebab awak rasa kita rapat.
Dialog: 0,0:54:21.13,0:54:24.41,Lalai,,0,0,0,,Saya harap anda akan lebih\Nberhati-hati. Ia tidak selesa.
Dialog: 0,0:54:24.46,0:54:26.17,Lalai,,0,0,0,,Tetapi...
Dialog: 0,0:54:31.64,0:54:34.08,Lalai,,0,0,0,,{\i1}Dia mempunyai perangai jahat.{\i0}
Dialog: 0,0:54:34.10,0:54:38.05, Lalai,,0,0,0,,Dia sangat menjengkelkan. Adakah anda tidak bersetuju?
Dialog: 0,0:54:39.60,0:54:41.71,Lalai,,0,0,0,,Waris ketiga Kumpulan Jinseong...
Dialog: 0,0:54:41.73,0:54:43.21, Lalai,,0,0,0,, menjadi makanan vegan hari ini.
Dialog: 0,0:54:43.23,0:54:46.81,Lalai,,0,0,0,,Forum vegan akan diadakan\Nat hotel mereka pada Jumaat depan.
Dialog: 0,0:54:46.99,0:54:48.34, Lalai,,0,0,0,, Bawa anak perempuan anda ke sana.
Dialog: 0,0:54:48.36,0:54:50.56, Lalai,,0,0,0,,- Saya akan cuba sediakan.\N- Betul ke?
Dialog: 0,0:54:50.82,0:54:52.53, Lalai,,0,0,0,,Anda boleh pergi sekarang.
Dialog: 0,0:54:52.95,0:54:55.44,Lalai,,0,0,0,,Saya ada sesuatu nak buat.
Dialog: 0,0:54:55.58,0:54:56.64, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:54:56.66,0:54:59.37,Lalai,,0,0,0,,Saya percayakan awak, Grace.
Dialog: 0,0:55:04.55,0:55:06.73, Lalai,,0,0,0,,Anda lihat,
Dialog: 0,0:55:06.76,0:55:09.03, Lalai,,0,0,0,,Saya pernah berada dalam industri kecantikan...
Dialog: 0,0:55:09.05,0:55:12.91,Lalai,,0,0,0,,dan mencari jodoh keluarga kaya...
Dialog: 0,0:55:12.93,0:55:14.32,Lalai,,0,0,0,,sepanjang hidup saya,
Dialog: 0,0:55:14.35,0:55:16.95,Lalai,,0,0,0,,jadi saya tidak tahu sangat tentang hal undang-undang.
Dialog: 0,0:55:16.98,0:55:18.76, Lalai,,0,0,0,,Saya faham. pasal apa ni?
Dialog: 0,0:55:21.60,0:55:22.67, Lalai,,0,0,0,,Saya pasti anda mendengar...
Dialog: 0,0:55:22.69,0:55:26.29,Lalai,,0,0,0,,anak bongsu Daegyeong\Nmeninggal dunia akibat kemalangan kereta.
Dialog: 0,0:55:26.32,0:55:27.38,Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:55:27.40,0:55:29.05, Lalai,,0,0,0,,Nampaknya...
Dialog: 0,0:55:29.07,0:55:32.43, Lalai,,0,0,0,,isterinya tidak akan mewarisi hartanya.
Dialog: 0,0:55:32.45,0:55:35.47,Lalai,,0,0,0,,Ternyata, suaminya telah menulis wasiat...
Dialog: 0,0:55:35.49,0:55:37.51,Lalai,,0,0,0,,sebelum mereka berkahwin.
Dialog: 0,0:55:37.54,0:55:40.64, Lalai,,0,0,0,,Dia berkata anak, anak saudara atau anak saudaranya...
Dialog: 0,0:55:40.67,0:55:43.06,Lalai,,0,0,0,,sepatutnya mewarisi kekayaannya jika dia mati,
Dialog: 0,0:55:43.08,0:55:45.79, Lalai,,0,0,0,,tetapi pasangan itu tidak pernah mempunyai anak.
Dialog: 0,0:55:46.00,0:55:47.02, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:55:47.05,0:55:48.86,Lalai,,0,0,0,,Kalau begitu, isteri boleh menuntut...
Dialog: 0,0:55:48.88,0:55:51.32, Lalai,,0,0,0,,rizab undang-undang bagi\Ninheritance dan failkan tuntutan mahkamah.
Dialog: 0,0:55:51.34,0:55:54.75,Lalai,,0,0,0,,Saya boleh memperkenalkan anda kepada peguam jika anda mahu.
Dialog: 0,0:55:55.06,0:55:58.45,Lalai,,0,0,0,,Untuk apa? saya ada awak.
Dialog: 0,0:55:58.48,0:55:59.95, Lalai,,0,0,0,,Anda berada di atas bot yang sama.
Dialog: 0,0:55:59.98,0:56:01.20,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:56:01.23,0:56:05.51,Lalai,,0,0,0,,Pn. Hong juga menulis sebuah\Nwill sebelum dia berkahwin.
Dialog: 0,0:56:06.98,0:56:08.68,Lalai,,0,0,0,,Tahukah anda?
Dialog: 0,0:56:08.94,0:56:10.25, Lalai,,0,0,0,,Anda pasti terfikir...
Dialog: 0,0:56:10.28,0:56:12.01, Lalai,,0,0,0,,perjanjian pranikah itu.
Dialog: 0,0:56:12.03,0:56:14.38, Lalai,,0,0,0,,Saya tidak percaya dia tidak memberitahu anda.
Dialog: 0,0:56:14.41,0:56:17.14,Lalai,,0,0,0,,Dia seorang yang tidak berhati perut.
Dialog: 0,0:56:17.16,0:56:19.01, Lalai,,0,0,0,,{\i1}Waspada mengatakan bahawa Ratu...{\i0}
Dialog: 0,0:56:19.04,0:56:22.43, Lalai,,0,0,0,,{\i1}akan mewarisi semua wang tunai,\Nsaham dan hartanahnya...{\i0}
Dialog: 0,0:56:22.46,0:56:23.98, Lalai,,0,0,0,,jika sesuatu berlaku padanya.
Dialog: 0,0:56:24.00,0:56:26.98, Lalai,,0,0,0,,Dia kata awak takkan dapat apa-apa.
Dialog: 0,0:56:27.00,0:56:30.11, Lalai,,0,0,0,,Dia menulisnya dengan begitu terperinci.
Dialog: 0,0:56:30.13,0:56:34.92, Lalai,,0,0,0,,Kami menggunakannya sebagai templat untuk semua wasiat masa hadapan.
Dialog: 0,0:56:37.60,0:56:39.16, Lalai,,0,0,0,,Ada apa dengan muka itu?
Dialog: 0,0:56:39.18,0:56:42.16,Lalai,,0,0,0,,Adakah anda benar-benar fikir ia adalah\Nperkahwinan abad ini...
Dialog: 0,0:56:42.19,0:56:44.71, Lalai,,0,0,0,,yang mengatasi semua latar belakang,
Dialog: 0,0:56:44.73,0:56:46.71, Lalai,,0,0,0,, seperti yang didakwa media?
Dialog: 0,0:56:46.73,0:56:49.13, Lalai,,0,0,0,,Jangan terlalu naif.
Dialog: 0,0:56:49.15,0:56:52.76,Lalai,,0,0,0,,Pn. Hong tidak mahu suami.
Dialog: 0,0:56:52.78,0:56:55.76,Lalai,,0,0,0,,Dia mahukan budak yang dia boleh\Nadd ke dalam daftar keluarga,
Dialog: 0,0:56:55.78,0:56:57.97, Lalai,,0,0,0,, dan ketika itulah anda muncul.
Dialog: 0,0:56:57.99,0:57:02.77,Lalai,,0,0,0,,Awak kacak dan bijak.\NIItu PR terbaik yang dia boleh miliki.
Dialog: 0,0:57:02.79,0:57:04.89,Lalai,,0,0,0,,Anda patuh mengikut kehendaknya.
Dialog: 0,0:57:04.92,0:57:07.90,Lalai,,0,0,0,,Satu-satunya masalah ialah pertikaian kekayaan,
Dialog: 0,0:57:07.92,0:57:11.16, Lalai,,0,0,0,,tetapi itu telah diselesaikan, terima kasih kepada kehendak.
Dialog: 0,0:57:11.42,0:57:13.12,Lalai,,0,0,0,,Cukuplah.
Dialog: 0,0:57:14.47,0:57:16.17,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:57:16.68,0:57:18.38, Lalai,,0,0,0,,Helo, Profesor.
Dialog: 0,0:57:19.97,0:57:24.05,Lalai,,0,0,0,,Bolehkah anda e-melkannya kepada saya?\NI tidak mempunyai masa untuk pergi ke sana.
Dialog: 0,0:57:43.91,0:57:45.99, Lalai,,0,0,0,,Kenapa awak tidak angkat?
Dialog: 0,0:57:47.92,0:57:49.99, Lalai,,0,0,0,,Kita perlu pergi ke suatu tempat.
Dialog: 0,0:57:50.55,0:57:53.77, Lalai,,0,0,0,,Saya tahu anda bebas hari ini. saya periksa.
Dialog: 0,0:57:53.80,0:57:55.79,Lalai,,0,0,0,,Kereta sedang menunggu di tingkat bawah.
Dialog: 0,0:57:57.89,0:57:59.59, Lalai,,0,0,0,,Saya tidak akan pergi.
Dialog: 0,0:58:01.81,0:58:03.70,Lalai,,0,0,0,,Saya tidak memberitahu anda ke mana kita hendak pergi.
Dialog: 0,0:58:03.73,0:58:05.55, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:58:05.85,0:58:08.47, Lalai,,0,0,0,,Saya enggan pergi ke mana-mana dengan awak.
Dialog: 0,0:58:41.64,0:58:43.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Yongdu-ri's Prodigy Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:58:43.56,0:58:46.05, Lalai,,0,0,0,,"Keajaiban"? Itu dari zaman dahulu.
Dialog: 0,0:58:52.48,0:58:54.13,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:58:54.15,0:58:55.79, Lalai,,0,0,0,,ini pendapat Yongdu-ri.
Dialog: 0,0:58:55.82,0:58:57.84, Lalai,,0,0,0,,Mereka tidak kisah anda menjalani tempoh berturut-turut.
Dialog: 0,0:58:57.86,0:59:00.38, Lalai,,0,0,0,,Itu pendapat umum.
Dialog: 0,0:59:00.41,0:59:03.80, Lalai,,0,0,0,,Singgah kedai saya nanti untuk snek.\N {\i1}makgeolli{\i0} baharu rasanya sedap.
Dialog: 0,0:59:03.83,0:59:04.89, Lalai,,0,0,0,, Sekali lagi?
Dialog: 0,0:59:04.91,0:59:07.11, Lalai,,0,0,0,,- Awak sentiasa pemurah.\N- Astaga.
Dialog: 0,0:59:07.29,0:59:11.14,Lalai,,0,0,0,,Saya harap saya dapat memberi anda\Nsesuatu yang lebih baik, tetapi ada...
Dialog: 0,0:59:11.17,0:59:13.02, Lalai,,0,0,0,,Akta Solicitation dan Graft yang Tidak Wajar.
Dialog: 0,0:59:13.04,0:59:14.69,Lalai,,0,0,0,,Ketua kampung juga kerja negeri,
Dialog: 0,0:59:14.71,0:59:17.07, Lalai,,0,0,0,,jadi saya tidak boleh terlalu murah hati.
Dialog: 0,0:59:17.09,0:59:18.40,Lalai,,0,0,0,,Aduh, saya sentiasa bersyukur.
Dialog: 0,0:59:18.42,0:59:19.74, Lalai,,0,0,0,,Anda sudah cukup melakukannya.
Dialog: 0,0:59:19.76,0:59:21.33,Lalai,,0,0,0,,- Anda faham, kan?\N- Sudah tentu.
Dialog: 0,0:59:21.35,0:59:23.22, Lalai,,0,0,0,, Baiklah, Cik Jeon.
Dialog: 0,0:59:24.01,0:59:25.76, Lalai,,0,0,0,,Helo.
Dialog: 0,0:59:26.14,0:59:27.87, Lalai,,0,0,0,,- Astaga.\N- Hei.
Dialog: 0,0:59:27.89,0:59:29.58, Lalai,,0,0,0,,Adakah ia tersekat lagi?
Dialog: 0,0:59:29.60,0:59:32.12, Lalai,,0,0,0,,Kamu bodoh. Bagaimana anda boleh memanggil diri anda petani?
Dialog: 0,0:59:32.15,0:59:34.21,Lalai,,0,0,0,,Bagaimana anda berjaya mendapatkan penanam...
Dialog: 0,0:59:34.23,0:59:35.67, Lalai,,0,0,0,, tersekat setiap kali?
Dialog: 0,0:59:35.69,0:59:37.13, Lalai,,0,0,0,,Apa yang menyebabkan anda terlalu lama?
Dialog: 0,0:59:37.15,0:59:38.21,Lalai,,0,0,0,,Saya...
Dialog: 0,0:59:38.24,0:59:41.06, Lalai,,0,0,0,,Saya bukan 119. Saya tidak selalu boleh datang serta-merta.
Dialog: 0,0:59:45.83,0:59:47.72,Lalai,,0,0,0,,Isteri saya pernah memandu seorang petani...
Dialog: 0,0:59:47.75,0:59:50.14, Lalai,,0,0,0,,dan tangkap sotong kecil di\NBeolgyo, Wilayah Jeolla...
Dialog: 0,0:59:50.16,0:59:52.56,Lalai,,0,0,0,,sebelum berkahwin dengan saya.
Dialog: 0,0:59:52.58,0:59:54.91,Lalai,,0,0,0,,Dia benar-benar sesuatu.
Dialog: 0,0:59:57.88,0:59:59.83, Lalai,,0,0,0,,Ia berfungsi!
Dialog: 0,1:00:01.22,1:00:03.49,Lalai,,0,0,0,,Aduhai, cuaca yang indah.
Dialog: 0,1:00:03.51,1:00:05.30,Lalai,,0,0,0,,Apa? Hei.
Dialog: 0,1:00:05.56,1:00:08.70,Lalai,,0,0,0,,Yeong-cheol! Bagaimana keadaan lutut ibu anda?
Dialog: 0,1:00:08.73,1:00:10.04,Lalai,,0,0,0,,Mereka sama!
Dialog: 0,1:00:10.06,1:00:12.12,Lalai,,0,0,0,,Itulah sebabnya dia perlu mengambil glukosamin!
Dialog: 0,1:00:12.15,1:00:14.64,Lalai,,0,0,0,,- Duduk!\N- Okay.
Dialog: 0,1:00:15.36,1:00:17.75,Lalai,,0,0,0,,Bukankah anak anda akan mengambil separuh penggal tidak lama lagi?
Dialog: 0,1:00:17.78,1:00:20.00,Lalai,,0,0,0,,Ada apa dengan saya? Ini kerja dia.
Dialog: 0,1:00:20.03,1:00:21.59,Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:00:21.61,1:00:25.09,Lalai,,0,0,0,,Walaupun begitu, anda harus membantu dia menghafal!
Dialog: 0,1:00:25.12,1:00:29.65,Lalai,,0,0,0,,Apabila Hyun-woo pergi ke SNU,\NI membantunya siang dan malam...
Dialog: 0,1:00:34.00,1:00:36.23,Lalai,,0,0,0,,Mengapa anda tiba-tiba memecut?
Dialog: 0,1:00:36.25,1:00:38.58,Default,,0,0,0,,Saya suruh awak duduk kan?
Dialog: 0,1:00:38.76,1:00:43.03,Lalai,,0,0,0,,Mereka mungkin kelihatan seperti biasa\Npetani, tetapi mereka lebih daripada itu.
Dialog: 0,1:00:43.05,1:00:45.70,Lalai,,0,0,0,,Mereka semua pengundi.
Dialog: 0,1:00:45.72,1:00:48.49,Lalai,,0,0,0,,Pemilihan semula sudah dekat\Nsudut. Anda tidak tahu apa-apa.
Dialog: 0,1:00:48.51,1:00:50.20,Lalai,,0,0,0,,Pemilihan semula, kaki saya.
Dialog: 0,1:00:50.22,1:00:52.62,Lalai,,0,0,0,,Kita perlu menjaga kebun dan kedai kita.
Dialog: 0,1:00:52.64,1:00:54.79,Lalai,,0,0,0,,Kami sudah banyak berjoging.
Dialog: 0,1:00:54.81,1:00:56.71,Lalai,,0,0,0,,Bukankah saya telah memberitahu anda berkali-kali...
Dialog: 0,1:00:56.73,1:00:58.29,Lalai,,0,0,0,,untuk melepaskan jawatan anda?
Dialog: 0,1:00:58.32,1:00:59.38,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:00:59.40,1:01:01.42,Lalai,,0,0,0,,Saya hanya melakukan ini demi keseimbangan.
Dialog: 0,1:01:01.44,1:01:03.60,Lalai,,0,0,0,,- Berapa baki?\N- Dengar saya.
Dialog: 0,1:01:03.95,1:01:07.80,Lalai,,0,0,0,,Ipar duai Hyun-woo mungkin menjadi\Tunjang ekonomi negara ini,
Dialog: 0,1:01:07.83,1:01:10.01,Lalai,,0,0,0,,tetapi mereka tidak mempunyai banyak kuasa politik.
Dialog: 0,1:01:10.04,1:01:12.01,Lalai,,0,0,0,,Keluarga kami hanya boleh mempunyai baki...
Dialog: 0,1:01:12.04,1:01:13.93,Lalai,,0,0,0,,kerana saya mengekalkan...
Dialog: 0,1:01:13.96,1:01:16.62,Default,,0,0,0,,jawatan penting saya sebagai ketua kampung.
Dialog: 0,1:01:17.71,1:01:20.48,Lalai,,0,0,0,,Kenapa awak berhenti sekarang?
Dialog: 0,1:01:20.51,1:01:22.87,Lalai,,0,0,0,,- Hyun-woo!\N- Apa?
Dialog: 0,1:01:29.72,1:01:31.49,Lalai,,0,0,0,,Anda tidak menelefon pun.
Dialog: 0,1:01:31.52,1:01:32.83,Lalai,,0,0,0,,Saya baru terfikir untuk melawat.
Dialog: 0,1:01:32.85,1:01:34.37,Lalai,,0,0,0,,Di manakah Hae-in?
Dialog: 0,1:01:34.39,1:01:36.68,Lalai,,0,0,0,,Adakah anda di sini bersendirian lagi?
Dialog: 0,1:01:39.69,1:01:41.50,Lalai,,0,0,0,,Awak dah makan belum?
Dialog: 0,1:01:41.53,1:01:43.69,Lalai,,0,0,0,,Belum.
Dialog: 0,1:01:44.03,1:01:45.73,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:01:54.91,1:01:56.66,Lalai,,0,0,0,,Ini kelihatan matang.
Dialog: 0,1:01:58.50,1:01:59.98,Lalai,,0,0,0,,Alih ke tepi.
Dialog: 0,1:02:00.00,1:02:02.36,Lalai,,0,0,0,,Mari kita lihat.
Dialog: 0,1:02:02.38,1:02:05.75,Lalai,,0,0,0,,Alih. Anak bongsu saya ada di sini.
Dialog: 0,1:02:18.81,1:02:21.06,Lalai,,0,0,0,,Astaga, awak pasti lapar.
Dialog: 0,1:02:29.57,1:02:31.28,Lalai,,0,0,0,,Luangkan masa anda.
Dialog: 0,1:02:39.21,1:02:41.16,Lalai,,0,0,0,,Adakah ia bagus?
Dialog: 0,1:03:20.37,1:03:22.16,Lalai,,0,0,0,,Ya, saya sibuk. kenapa?
Dialog: 0,1:03:24.59,1:03:25.98,Lalai,,0,0,0,,Hyun-woo ada di sini?
Dialog: 0,1:03:26.01,1:03:27.87,Lalai,,0,0,0,,Satu minit.
Dialog: 0,1:03:28.59,1:03:31.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Salun Rambut Ratu{\c}{\i0}
Dialog: 0,1:03:31.26,1:03:33.07,Lalai,,0,0,0,,Bajingan kecil itu.
Dialog: 0,1:03:33.10,1:03:35.32,Lalai,,0,0,0,,Dia tidak datang pun untuk ulang tahun ayah yang ke-60.
Dialog: 0,1:03:35.35,1:03:37.05,Lalai,,0,0,0,,Jangan biarkan dia pergi.
Dialog: 0,1:03:41.10,1:03:43.50,Lalai,,0,0,0,,Saya ingin bertanya sesuatu kepada awak.
Dialog: 0,1:03:43.52,1:03:45.75,Lalai,,0,0,0,,Saya kecewa dengan awak dan Hae-in.
Dialog: 0,1:03:45.78,1:03:49.25,Lalai,,0,0,0,,Saya dapati anda tidak boleh datang\Secara tetap malah pada hari cuti,
Dialog: 0,1:03:49.28,1:03:51.92,Lalai,,0,0,0,,tetapi bukankah sepatutnya anda telah\Nattended ulang tahun ke-60 Ayah?
Dialog: 0,1:03:51.95,1:03:54.94,Lalai,,0,0,0,,- Sungguh tidak berperasaan.\N- Ya, anda betul.
Dialog: 0,1:03:55.58,1:03:56.80,Lalai,,0,0,0,,Saya tidak berhati perut.
Dialog: 0,1:03:56.83,1:03:58.68,Lalai,,0,0,0,,Sekurang-kurangnya dia tahu dia salah.
Dialog: 0,1:03:58.70,1:04:01.20,Lalai,,0,0,0,,Sebab itu saya akan bercerai.
Dialog: 0,1:04:01.96,1:04:04.69,Lalai,,0,0,0,,- Apa?\N- Ayah. mak.
Dialog: 0,1:04:04.71,1:04:07.12,Lalai,,0,0,0,,Saya akan ceraikan Hae-in.
Dialog: 0,1:04:09.01,1:04:11.17,Lalai,,0,0,0,,- Saya minta maaf.\N- Tunggu.
Dialog: 0,1:04:11.34,1:04:13.45,Lalai,,0,0,0,,Hei, jangan beritahu saya...
Dialog: 0,1:04:13.47,1:04:16.66,Lalai,,0,0,0,,anda akan bercerai\Nhanya kerana apa yang saya katakan.
Dialog: 0,1:04:16.68,1:04:18.66,Lalai,,0,0,0,,Ada apa dengan awak? Ulang tahun ke-60 bukan apa-apa.
Dialog: 0,1:04:18.68,1:04:20.29,Lalai,,0,0,0,,Hari lahir datang setiap tahun.
Dialog: 0,1:04:20.31,1:04:23.25,Lalai,,0,0,0,,Memang. Siapa yang menyambut ulang tahun\N ke-60 hari ini?
Dialog: 0,1:04:23.27,1:04:25.62,Lalai,,0,0,0,,Lupakan ke-70 juga. Kami\Dijangka untuk hidup lebih lama.
Dialog: 0,1:04:25.65,1:04:27.08,Lalai,,0,0,0,,Bukan kerana itu.
Dialog: 0,1:04:27.11,1:04:28.25,Lalai,,0,0,0,,Kemudian?
Dialog: 0,1:04:28.28,1:04:31.48,Lalai,,0,0,0,,Apakah itu? Saya pasti anda mempunyai sebab.
Dialog: 0,1:04:33.11,1:04:35.30,Lalai,,0,0,0,,Jangan beritahu saya anda sedang melihat yang lain...?
Dialog: 0,1:04:35.32,1:04:37.32,Lalai,,0,0,0,,Ayuh.
Dialog: 0,1:04:37.74,1:04:38.97,Lalai,,0,0,0,,No.
Dialog: 0,1:04:39.00,1:04:40.39,Lalai,,0,0,0,,Kemudian adakah Hae-in mempunyai...?
Dialog: 0,1:04:40.41,1:04:42.66,Lalai,,0,0,0,,Boleh tolong berhenti?
Dialog: 0,1:04:43.00,1:04:46.62,Lalai,,0,0,0,,Itu juga tidak benar.\NIItu terlalu banyak untuk saya.
Dialog: 0,1:04:47.67,1:04:48.94,Lalai,,0,0,0,,Saya tidak gembira.
Dialog: 0,1:04:48.96,1:04:51.86,Lalai,,0,0,0,,Itu sebab yang tidak masuk akal.
Dialog: 0,1:04:51.88,1:04:53.44,Lalai,,0,0,0,,Adakah anda fikir saya sentiasa gembira?
Dialog: 0,1:04:53.47,1:04:54.86,Lalai,,0,0,0,,Dia betul.
Dialog: 0,1:04:54.89,1:04:57.45,Lalai,,0,0,0,,Ayah kamu juga tidak bahagia\N dalam perkahwinan ini.
Dialog: 0,1:04:57.47,1:04:58.91,Lalai,,0,0,0,,Jika ada, saya sengsara,
Dialog: 0,1:04:58.93,1:05:00.66,Lalai,,0,0,0,,tetapi saya hanya mampu bertahan...
Dialog: 0,1:05:00.68,1:05:02.58,Lalai,,0,0,0,,kerana kebahagiaan terkecil...
Dialog: 0,1:05:02.60,1:05:05.21,Lalai,,0,0,0,,Saya rasa sekali dalam bulan biru.
Dialog: 0,1:05:05.23,1:05:08.58,Lalai,,0,0,0,,- Itu perkahwinan. Itulah kehidupan.\N- Anda tahu apa yang anda cakapkan.
Dialog: 0,1:05:08.61,1:05:09.71,Lalai,,0,0,0,,Saya jujur.
Dialog: 0,1:05:09.73,1:05:12.98,Lalai,,0,0,0,,Adakah anda fikir saya bersama ibu\N anda kerana saya sayangkan dia?
Dialog: 0,1:05:15.53,1:05:17.36,Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,1:05:18.66,1:05:20.49,Lalai,,0,0,0,,Saya belum selesai.
Dialog: 0,1:05:21.00,1:05:22.43,Lalai,,0,0,0,,Sudah tentu saya sayang awak,
Dialog: 0,1:05:22.46,1:05:25.31,Lalai,,0,0,0,,tetapi jika cinta adalah satu-satunya perkara yang anda rasa,
Dialog: 0,1:05:25.33,1:05:27.06,Lalai,,0,0,0,,maka itu akan menjadi kematian anda.
Dialog: 0,1:05:27.08,1:05:30.04,Lalai,,0,0,0,,Tentu. Saya harap awak panjang umur.
Dialog: 0,1:05:30.42,1:05:31.69,Lalai,,0,0,0,,Lihat ini.
Dialog: 0,1:05:31.71,1:05:36.11,Lalai,,0,0,0,,Kami masih gagal untuk bertemu mata,\Nwalaupun sudah berkahwin selama 40 tahun.
Dialog: 0,1:05:36.14,1:05:37.96,Lalai,,0,0,0,,Tidak sama sekali.
Dialog: 0,1:05:39.18,1:05:41.21,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:05:41.27,1:05:43.79,Lalai,,0,0,0,,Saya faham,
Dialog: 0,1:05:43.81,1:05:45.51,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:05:45.94,1:05:50.43,Lalai,,0,0,0,,Saya berfikir panjang dan keras\Nsebelum membuat keputusan ini.
Dialog: 0,1:05:52.69,1:05:54.44,Lalai,,0,0,0,,Saya akan melakukannya.
Dialog: 0,1:05:57.74,1:05:59.48,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:06:05.08,1:06:07.02,Lalai,,0,0,0,,Berhenti!
Dialog: 0,1:06:07.04,1:06:09.98,Lalai,,0,0,0,,Berhenti! Keluar, bodoh!
Dialog: 0,1:06:10.00,1:06:11.98,Lalai,,0,0,0,,Anda sangat mementingkan diri sendiri.
Dialog: 0,1:06:12.00,1:06:14.61,Lalai,,0,0,0,,Takkan awak tahu saya terpaksa berkorban untuk awak?
Dialog: 0,1:06:14.63,1:06:16.44,Lalai,,0,0,0,,Pengorbanan apa?
Dialog: 0,1:06:16.47,1:06:19.15,Lalai,,0,0,0,,Saya tidak dapat pergi ke kolej pun,\Nkerana ibu bapa kita menjual...
Dialog: 0,1:06:19.18,1:06:20.99,Lalai,,0,0,0,,semua lembu kami untuk menghantar anda ke Seoul.
Dialog: 0,1:06:21.01,1:06:22.32,Lalai,,0,0,0,,Bagaimana anda boleh melupakannya?
Dialog: 0,1:06:22.35,1:06:24.74,Lalai,,0,0,0,,Bagaimanakah kamu tidak tahu malu?\NAnda tidak boleh pergi ke kolej...
Dialog: 0,1:06:24.77,1:06:27.14,Lalai,,0,0,0,,kerana anda gagal hadir.
Dialog: 0,1:06:29.48,1:06:32.10,Lalai,,0,0,0,,Naif sangat budak ni.
Dialog: 0,1:06:34.28,1:06:37.55,Lalai,,0,0,0,,Mengapa anda rasa Grand\NPrince Yang-nyeong berlakon?
Dialog: 0,1:06:37.57,1:06:39.01,Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,1:06:39.03,1:06:40.59,Lalai,,0,0,0,,Itu pengorbanan.
Dialog: 0,1:06:40.62,1:06:43.64,Lalai,,0,0,0,,Dia mengorbankan dirinya dan bertindak\Nout demi abangnya Se-jong.
Dialog: 0,1:06:43.66,1:06:45.22,Lalai,,0,0,0,,Adakah anda fikir saya seronok berlakon?
Dialog: 0,1:06:45.25,1:06:48.93,Lalai,,0,0,0,,Saya melepaskan harapan, harapan, dan lembu ibu bapa kita...
Dialog: 0,1:06:48.96,1:06:51.06,Lalai,,0,0,0,,hanya untuk anda.
Dialog: 0,1:06:51.09,1:06:52.10,Lalai,,0,0,0,,Awak buat?
Dialog: 0,1:06:52.13,1:06:53.48,Lalai,,0,0,0,,Ya, saya.
Dialog: 0,1:06:53.50,1:06:56.21,Lalai,,0,0,0,,Saya terpaksa berkorban sebagai anak sulung.
Dialog: 0,1:06:57.51,1:07:00.61,Lalai,,0,0,0,,Saya faham, Cik Baek Mi-seon.\NThumbelina dari Geng Kereta Yongdu.
Dialog: 0,1:07:00.64,1:07:02.20,Lalai,,0,0,0,,Hei!
Dialog: 0,1:07:02.22,1:07:05.13,Lalai,,0,0,0,,Itu dahulu.
Dialog: 0,1:07:07.73,1:07:09.55,Lalai,,0,0,0,,Saya akan pergi.
Dialog: 0,1:07:13.69,1:07:15.42,Lalai,,0,0,0,,Saya tidak mahu menekan awak.
Dialog: 0,1:07:15.44,1:07:17.56,Lalai,,0,0,0,,Anda sudah.
Dialog: 0,1:07:17.82,1:07:19.97,Lalai,,0,0,0,,- Saya hanya risaukan Ayah.\N- Bagaimana dengan dia?
Dialog: 0,1:07:19.99,1:07:23.05,Lalai,,0,0,0,,Adakah anda tahu betapa gembiranya dia mengahwinkan anda dengan Queens?
Dialog: 0,1:07:23.08,1:07:25.82,Lalai,,0,0,0,,Dia cakap dia tak ada selera,\Ntapi habiskan semangkuk nasi...
Dialog: 0,1:07:25.84,1:07:28.50,Lalai,,0,0,0,,setiap kali harga saham Queens naik.
Dialog: 0,1:07:28.87,1:07:31.39,Lalai,,0,0,0,,Dia sentiasa menikmati sup nasi.
Dialog: 0,1:07:31.42,1:07:33.44,Lalai,,0,0,0,,Ya, itu benar.
Dialog: 0,1:07:33.46,1:07:34.60,Lalai,,0,0,0,,Betul, tetapi...
Dialog: 0,1:07:34.63,1:07:37.65,Lalai,,0,0,0,,Seorang anak lelaki dari bandar kecil ini bercerai?
Dialog: 0,1:07:37.67,1:07:40.40,Lalai,,0,0,0,,Dia akan dihina! Bangunlah, bodoh!
Dialog: 0,1:07:40.43,1:07:42.70,Lalai,,0,0,0,,Ini bukan Seoul atau Hollywood.
Dialog: 0,1:07:42.72,1:07:43.82,Lalai,,0,0,0,,Ini Yongdu-ri.
Dialog: 0,1:07:43.85,1:07:45.99,Lalai,,0,0,0,,Rakan awak Chang-sik\Ngot bercerai dua tahun lalu,
Dialog: 0,1:07:46.02,1:07:48.33,Lalai,,0,0,0,,dan mereka masih bercakap mengenainya.
Dialog: 0,1:07:48.35,1:07:50.33,Lalai,,0,0,0,,Dia betul.
Dialog: 0,1:07:50.35,1:07:52.29,Lalai,,0,0,0,,Semua wanita di salon rambut saya...
Dialog: 0,1:07:52.31,1:07:55.25,Lalai,,0,0,0,,masih tertanya-tanya kenapa dia bercerai.
Dialog: 0,1:07:55.27,1:07:56.75,Lalai,,0,0,0,,Betul. Namun...
Dialog: 0,1:07:56.78,1:08:00.40,Lalai,,0,0,0,,tiada sesiapa akan bercakap tentang dia\Jika anda bercerai juga.
Dialog: 0,1:08:02.36,1:08:04.59,Lalai,,0,0,0,,Adakah ini kerana sewa gim anda?
Dialog: 0,1:08:04.62,1:08:06.80,Lalai,,0,0,0,,Dan kerana Gyeong-jun yang belajar di luar negara?
Dialog: 0,1:08:06.83,1:08:09.03,Lalai,,0,0,0,,Memandangkan anda perlu menghantar wang kepadanya?
Dialog: 0,1:08:10.66,1:08:12.53,Lalai,,0,0,0,,Adakah anda menggunakan saya untuk menjalani kehidupan yang selesa,
Dialog: 0,1:08:12.56,1:08:15.15,Lalai,,0,0,0,,sama seperti bagaimana Sim-cheong\Ndijual untuk 300 guni beras?
Dialog: 0,1:08:15.17,1:08:17.27,Lalai,,0,0,0,,Astaga. Tidak, saya...
Dialog: 0,1:08:17.30,1:08:21.11,Lalai,,0,0,0,,Saya tidak akan menggunakan anda jika ia sebanyak itu,
Dialog: 0,1:08:21.13,1:08:23.15,Lalai,,0,0,0,,- tetapi tidak.\N- Sial.
Dialog: 0,1:08:23.18,1:08:25.07,Lalai,,0,0,0,,Hei, Hyun-woo.
Dialog: 0,1:08:25.10,1:08:26.49,Lalai,,0,0,0,,Hyun...
Dialog: 0,1:08:26.51,1:08:27.53,Lalai,,0,0,0,,Hyun-woo!
Dialog: 0,1:08:27.56,1:08:29.37,Lalai,,0,0,0,,- Baek Hyun-woo!\N- Hyun-woo!
Dialog: 0,1:08:29.39,1:08:31.34,Lalai,,0,0,0,,Tinggal malam!
Dialog: 0,1:09:24.95,1:09:26.99,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,1:10:08.12,1:10:09.82,Lalai,,0,0,0,,Saya ada...
Dialog: 0,1:10:10.91,1:10:12.61,Lalai,,0,0,0,,sesuatu untuk diperkatakan.
Dialog: 0,1:10:14.79,1:10:16.66,Lalai,,0,0,0,,Saya pergi dulu.
Dialog: 0,1:10:16.96,1:10:18.69,Lalai,,0,0,0,,Apa?
Dialog: 0,1:10:18.71,1:10:21.33,Lalai,,0,0,0,,Saya juga begitu, jadi biarkan saya pergi dahulu.
Dialog: 0,1:10:23.17,1:10:26.33,Lalai,,0,0,0,,Okey. Teruskan.
Dialog: 0,1:10:27.30,1:10:29.13,Lalai,,0,0,0,,Saya...
Dialog: 0,1:10:32.31,1:10:34.17,Lalai,,0,0,0,,mati.
Dialog: 0,1:10:38.60,1:10:40.72,Lalai,,0,0,0,,Saya ada tiga bulan lagi.
Dialog: 0,1:10:46.57,1:10:48.27,Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,1:10:54.45,1:10:56.35,Lalai,,0,0,0,,Saya kata kita perlu pergi ke suatu tempat hari ini.
Dialog: 0,1:10:56.37,1:10:58.24,Lalai,,0,0,0,,Saya pergi ke hospital,
Dialog: 0,1:10:58.58,1:11:01.62,Lalai,,0,0,0,,dan doktor berkata saya sedang nazak,
Dialog: 0,1:11:01.71,1:11:03.83, Lalai,,0,0,0,, dan saya mempunyai tiga bulan.
Dialog: 0,1:11:05.21,1:11:06.92,Lalai,,0,0,0,,Apa...
Dialog: 0,1:11:06.97,1:11:08.71,Lalai,,0,0,0,,kau cakap?
Dialog: 0,1:11:09.76,1:11:12.00,Lalai,,0,0,0,,Betul apa yang saya katakan.
Dialog: 0,1:11:12.22,1:11:17.05,Lalai,,0,0,0,,Doktor kata saya hanya\Nada tiga bulan untuk hidup.
Dialog: 0,1:11:18.31,1:11:20.26,Lalai,,0,0,0,,Itu sahaja.
Dialog: 0,1:11:20.77,1:11:22.83,Lalai,,0,0,0,,- Apa yang anda ingin katakan?\N- Apa?
Dialog: 0,1:11:22.86,1:11:26.23,Lalai,,0,0,0,,Anda ada sesuatu untuk diperkatakan. Apa itu?
Dialog: 0,1:11:28.90,1:11:30.61,Lalai,,0,0,0,,Saya tidak fikir...
Dialog: 0,1:11:31.82,1:11:34.69,Lalai,,0,0,0,,itu penting sekarang.
Dialog: 0,1:11:39.87,1:11:42.85,Lalai,,0,0,0,,Sebut saja. Saya tahu awak ada sesuatu nak cakap.
Dialog: 0,1:11:42.88,1:11:46.40,Lalai,,0,0,0,,Nah, saya...
Dialog: 0,1:11:46.42,1:11:50.49,Lalai,,0,0,0,,- Jadi apa...\N- Ya?
Dialog: 0,1:11:50.51,1:11:53.34,Lalai,,0,0,0,,...Saya ingin katakan ialah...
Dialog: 0,1:11:54.89,1:11:56.59,Lalai,,0,0,0,,Saya...
Dialog: 0,1:11:57.56,1:11:58.66,Lalai,,0,0,0,,Ya?
Dialog: 0,1:11:58.68,1:12:00.59,Lalai,,0,0,0,,"Maafkan saya."
Dialog: 0,1:12:02.48,1:12:05.43,Lalai,,0,0,0,,"Mengenai hari ini,"
Dialog: 0,1:12:05.52,1:12:09.17,Lalai,,0,0,0,"dan semua yang saya lakukan."
Dialog: 0,1:12:09.19,1:12:13.22,Lalai,,0,0,0,"Ia tidak akan berlaku lagi.\NI akan melayan anda dengan lebih baik."
Dialog: 0,1:12:13.24,1:12:17.19,Lalai,,0,0,0,,Itulah yang saya mahu...
Dialog: 0,1:12:17.49,1:12:18.68,Lalai,,0,0,0,,untuk mengatakan,
Dialog: 0,1:12:18.70,1:12:22.68,Lalai,,0,0,0,,tetapi anda hanya mempunyai tiga bulan\N untuk hidup? Bagaimana mungkin?
Dialog: 0,1:12:22.71,1:12:25.87,Lalai,,0,0,0,,Bagaimana saya boleh hidup tanpa awak?
Dialog: 0,1:12:26.96,1:12:28.71,Lalai,,0,0,0,,Bagaimana mungkin?
Dialog: 0,1:12:28.80,1:12:31.44,Lalai,,0,0,0,,Saya sangat terkejut,
Dialog: 0,1:12:31.47,1:12:33.71,Lalai,,0,0,0,,Saya tidak tahu nak cakap apa.
Dialog: 0,1:12:38.27,1:12:39.33,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,1:12:39.35,1:12:42.39,Lalai,,0,0,0,,Ya, bodoh.
Dialog: 0,1:12:53.91,1:12:56.19,Lalai,,0,0,0,,Saya sayang awak, Hong Hae-in.
Dialog: 0,1:12:57.24,1:12:59.11,Lalai,,0,0,0,,Saya sayang awak.
Dialog: 0,1:13:15.26,1:13:17.36,Lalai,,0,0,0,,{\i1}Sila berikan mereka tepukan gemuruh...{\i0}
Dialog: 0,1:13:17.39,1:13:20.59,Lalai,,0,0,0,,{\i1}semasa mereka memulakan perjalanan baharu mereka.{\i0}
Dialog: 0,1:13:25.69,1:13:27.42,Lalai,,0,0,0,,{\i1}Sila bertepuk tangan dan bersorak lebih kuat lagi...{\i0}
Dialog: 0,1:13:27.44,1:13:30.35,Lalai,,0,0,0,,{\i1}untuk mendoakan yang terbaik untuk mereka.{\i0}
Dialog: 0,1:13:35.66,1:13:38.68,Lalai,,0,0,0,,Semua orang, sila lihat kamera!
Dialog: 0,1:13:38.70,1:13:41.60,Lalai,,0,0,0,,Sila ketawa pada kiraan tiga.
Dialog: 0,1:13:41.62,1:13:43.70,Lalai,,0,0,0,,Satu, dua, tiga.
Dialog: 0,1:14:00.76,1:14:03.62,Lalai,,0,0,0,,En. Baek, tahniah atas perkahwinan.
Dialog: 0,1:14:03.64,1:14:05.95,Lalai,,0,0,0,,Sila katakan sesuatu kepada diri sendiri dalam tempoh sepuluh tahun.
Dialog: 0,1:14:05.98,1:14:08.29,Lalai,,0,0,0,,Apa khabar, Hyun-woo dari masa depan?
Dialog: 0,1:14:08.31,1:14:10.60,Lalai,,0,0,0,,Jangan beritahu saya anda telah bercerai.
Dialog: 0,1:14:11.40,1:14:13.00,Lalai,,0,0,0,,Adakah anda mempunyai anak?
Dialog: 0,1:14:13.03,1:14:14.59,Lalai,,0,0,0,,Satu? dua?
Dialog: 0,1:14:14.61,1:14:16.59,Lalai,,0,0,0,,Tidak mengapa,
Dialog: 0,1:14:16.61,1:14:20.48,Lalai,,0,0,0,,kerana yang saya perlukan hanyalah Hae-in.
Dialog: 0,1:14:21.45,1:14:23.72,Lalai,,0,0,0,,Saya harap awak masih ingat...
Dialog: 0,1:14:23.75,1:14:27.27,Lalai,,0,0,0,,betapa anda menyayanginya,
Dialog: 0,1:14:27.29,1:14:29.87,Lalai,,0,0,0,,malah sehingga hari ini.
Dialog: 0,1:14:32.05,1:14:34.00,Lalai,,0,0,0,,Jangan buat dia menangis.
Dialog: 0,1:14:34.17,1:14:36.21,Lalai,,0,0,0,,Buat dia gembira.
Dialog: 0,1:14:36.68,1:14:38.71,Lalai,,0,0,0,,Mengapa saya mesti menjawabnya?
Dialog: 0,1:14:39.14,1:14:41.91,Lalai,,0,0,0,,Ia akan menjadi sesuatu yang menarik untuk ditonton pada masa hadapan.
Dialog: 0,1:14:41.93,1:14:45.16,Lalai,,0,0,0,,Saya akan terlalu sibuk dengan kehidupan\Nuntuk menonton ini dalam tempoh sepuluh tahun.
Dialog: 0,1:14:45.18,1:14:47.30,Lalai,,0,0,0,,Adakah saya perlu melakukan ini?
Dialog: 0,1:14:48.27,1:14:50.21,Lalai,,0,0,0,,Hae-in yang dihormati dari masa hadapan.
Dialog: 0,1:14:50.23,1:14:54.59,Lalai,,0,0,0,,Saya syak anda sedang menonton ini,\Ntetapi jika anda menontonnya, kenapa anda?
Dialog: 0,1:14:54.61,1:14:56.05,Lalai,,0,0,0,,Matikan ini dan mulakan kerja.
Dialog: 0,1:14:56.07,1:14:59.84,Lalai,,0,0,0,,Saya tidak akan bertanya khabar anda,\Nmemandangkan saya tahu anda akan sihat.
Dialog: 0,1:14:59.87,1:15:01.89,Lalai,,0,0,0,,Anda akan sama cantik, sihat,
Dialog: 0,1:15:01.91,1:15:04.36,Lalai,,0,0,0,,dan yang paling berjaya.
Dialog: 0,1:15:04.62,1:15:08.24,Lalai,,0,0,0,,Dengan Hyun-woo, sudah tentu.
Dialog: 0,1:15:16.09,1:15:18.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:15:46.20,1:15:48.64,Lalai,,0,0,0,,{\an8}{\i1}Anda hanya mempunyai tiga bulan\N untuk hidup? Bagaimanakah ia boleh dilakukan?{\i0}
Dialog: 0,1:15:48.66,1:15:52.02,Lalai,,0,0,0,,{\an8}{\i1}Jika anda tidak boleh hidup tanpa saya...\NDAdakah anda mahu mati bersama?{\i0}
Dialog: 0,1:15:52.04,1:15:53.39,Lalai,,0,0,0,,{\an8}{\i1}Saya cuma gembira...{\i0}
Dialog: 0,1:15:53.42,1:15:56.81,Lalai,,0,0,0,,{\an8}{\i1}bahawa saya boleh melarikan diri daripadanya dengan selamat.{\i0}
Dialog: 0,1:15:56.84,1:15:59.98,Lalai,,0,0,0,,{\an8}{\i1}Letakkan hati dan jiwa anda untuk mencintainya.{\i0}
Dialog: 0,1:16:00.01,1:16:01.36,Lalai,,0,0,0,,{\an8}{\i1}Saya begitu materialistik?{\i0}
Dialog: 0,1:16:01.39,1:16:03.24,Lalai,,0,0,0,,{\an8}{\i1}Saya akan duduk di sini.{\i0}
Dialog: 0,1:16:03.26,1:16:05.91,Lalai,,0,0,0,,{\an8}{\i1}- Adakah anda okay?\N- Mereka sepatutnya berdebat sahaja.{\i0}
Dialog: 0,1:16:05.93,1:16:09.51,Lalai,,0,0,0,,{\an8}{\i1}Bagaimanakah kita boleh berubah, selepas\Ntahun hidup sebagai orang asing?{\i0}
Dialog: 0,1:16:09.60,1:16:11.30,Lalai,,0,0,0,,{\an8}{\i1}Awas!{\i0}
Dialog: 0,1:16:11.35,1:16:13.29,Lalai,,0,0,0,,{\an8}{\i1}Saya terfikir tentang Hae-in dari semasa ke semasa,{\i0}
Dialog: 0,1:16:13.31,1:16:16.29,Lalai,,0,0,0,,{\an8}{\i1}jadi rasa pelik untuk berjumpa dengan suaminya.{\i0}
Dialog: 0,1:16:16.32,1:16:20.48,Lalai,,0,0,0,,{\an8}{\i1}Saya tidak suka Hong Hae-in pun.\NKenapa saya rasa cemburu?{\i0}
