Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:05.64,0:01:07.34, Lalai,,0,0,0,, Beritahu saya ini tidak benar.
Dialog: 0,0:01:09.61,0:01:11.08,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,0:01:11.61,0:01:13.48, Lalai,,0,0,0,, Katakan.
Dialog: 0,0:01:14.11,0:01:15.81, Lalai,,0,0,0,, Nafikannya.
Dialog: 0,0:01:16.91,0:01:18.92, Lalai,,0,0,0,,- Hae-in...\N- Katakan.
Dialog: 0,0:01:18.95,0:01:20.94, Lalai,,0,0,0,, Beritahu saya ia tidak benar.
Dialog: 0,0:01:23.75,0:01:25.53, Lalai,,0,0,0,, Beritahu saya itu bukan awak.
Dialog: 0,0:01:36.30,0:01:38.04, Lalai,,0,0,0,,No.
Dialog: 0,0:01:39.68,0:01:42.34, Lalai,,0,0,0,,Itu saya.
Dialog: 0,0:01:45.14,0:01:47.84, Lalai,,0,0,0,,Maaf saya tidak dapat memberitahu anda.
Dialog: 0,0:02:05.45,0:02:07.45, Lalai,,0,0,0,,Bila?
Dialog: 0,0:02:08.54,0:02:10.28, Lalai,,0,0,0,,Bila...?
Dialog: 0,0:02:11.84,0:02:14.04, Lalai,,0,0,0,,Bila anda menyediakan ini?
Dialog: 0,0:02:17.34,0:02:19.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya ada...{\c}{\i0}
Dialog: 0,0:02:21.55,0:02:23.46, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}sesuatu untuk diperkatakan.{\c}{\i0}
Dialog: 0,0:02:23.89,0:02:25.67, Lalai,,0,0,0,,Mungkin...
Dialog: 0,0:02:25.77,0:02:27.55, Lalai,,0,0,0,,hari itu?
Dialog: 0,0:02:28.31,0:02:31.22, Lalai,,0,0,0,,Hari saya beritahu awak saya sedang mati?
Dialog: 0,0:02:34.69,0:02:36.52, Lalai,,0,0,0,,Ya.
Dialog: 0,0:02:46.41,0:02:48.24, Lalai,,0,0,0,,Adakah itu sebabnya...
Dialog: 0,0:02:48.37,0:02:50.20, Lalai,,0,0,0,,anda kekalkan...
Dialog: 0,0:02:50.75,0:02:53.08, Lalai,,0,0,0,,tutup mulut anda,
Dialog: 0,0:02:53.42,0:02:55.62, Lalai,,0,0,0,,dan tidak memberitahu saya?
Dialog: 0,0:02:55.67,0:02:58.12, Lalai,,0,0,0,, Kerana saya akan mati tidak lama lagi?
Dialog: 0,0:02:58.67,0:03:00.62, Lalai,,0,0,0,,Ya.
Dialog: 0,0:03:14.52,0:03:16.22,Lalai,,0,0,0,,Jadi...
Dialog: 0,0:03:19.36,0:03:21.48, Lalai,,0,0,0,,anda berbohong selama ini?
Dialog: 0,0:03:31.04,0:03:33.37, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:03:34.25,0:03:36.83, Lalai,,0,0,0,,Anda telah berbohong melalui gigi anda,
Dialog: 0,0:03:38.92,0:03:41.12, Lalai,,0,0,0,,jadi apa yang menghalang anda sekarang?
Dialog: 0,0:03:54.40,0:03:56.56, Lalai,,0,0,0,,Saya jumpa...
Dialog: 0,0:03:58.52,0:04:00.56, Lalai,,0,0,0,, dalam perjalanan saya ke sini.
Dialog: 0,0:04:03.24,0:04:05.52, Lalai,,0,0,0,,Kunci kami masih ada di sini.
Dialog: 0,0:05:05.72,0:05:07.42,Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:05:19.31,0:05:21.60, Lalai,,0,0,0,,Sudah terlambat untuk pergi ke mana-mana.
Dialog: 0,0:05:26.78,0:05:29.02, Lalai,,0,0,0,,Kekal di sini. saya akan pergi.
Dialog: 0,0:05:29.49,0:05:31.36,Lalai,,0,0,0,,Hanya...
Dialog: 0,0:05:31.83,0:05:33.86, Lalai,,0,0,0,, biarkan saya sendiri.
Dialog: 0,0:05:35.12,0:05:37.11, Lalai,,0,0,0,,Saya tidak ada...
Dialog: 0,0:05:38.17,0:05:40.62,Lalai,,0,0,0,,tenaga untuk marah.
Dialog: 0,0:05:42.42,0:05:44.50, Lalai,,0,0,0,, Dengarkan saya.
Dialog: 0,0:05:45.72,0:05:48.53, Lalai,,0,0,0,,Saya akan memberitahu anda mengapa saya berbuat demikian,
Dialog: 0,0:05:48.55,0:05:50.38, Lalai,,0,0,0,,apa yang saya rasa,
Dialog: 0,0:05:50.47,0:05:52.38, Lalai,,0,0,0,, dan rancangan saya.
Dialog: 0,0:05:55.73,0:05:58.76, Lalai,,0,0,0,,Tidak, lupakan sahaja.
Dialog: 0,0:05:59.73,0:06:01.43, Lalai,,0,0,0,,Saya tidak ingin tahu.
Dialog: 0,0:06:42.27,0:06:44.35,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak, Hong Hae-in.{\c}{\i0}
Dialog: 0,0:06:45.61,0:06:47.31, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sayang awak.{\c}{\i0}
Dialog: 0,0:06:56.99,0:06:58.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey?{\c}{\i0}
Dialog: 0,0:08:15.53,0:08:17.52, Lalai,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:08:17.99,0:08:20.90,Lalai,,0,0,0,,Tidakkah anda tahu anda harus lebih berhati-hati?
Dialog: 0,0:08:28.17,0:08:29.87, Lalai,,0,0,0,,Mari kita masuk.
Dialog: 0,0:08:30.80,0:08:33.67, Lalai,,0,0,0,,Saya akan terangkan semuanya,
Dialog: 0,0:08:34.68,0:08:36.54, Lalai,,0,0,0,,dan kemudian...
Dialog: 0,0:08:37.01,0:08:38.80, Lalai,,0,0,0,,Saya akan lakukan seperti yang anda katakan,
Dialog: 0,0:08:39.26,0:08:41.38, Lalai,,0,0,0,,- jadi...\N- Hyun-woo.
Dialog: 0,0:08:47.86,0:08:50.60, Lalai,,0,0,0,,Jika ini berlaku lagi,
Dialog: 0,0:08:54.32,0:08:56.27, Lalai,,0,0,0,,jangan selamatkan saya.
Dialog: 0,0:09:37.32,0:09:38.47,Lalai,,0,0,0,,{\i1}Saya sangat terkejut.{\i0}
Dialog: 0,0:09:38.49,0:09:40.80, Lalai,,0,0,0,,Hyun-woo adalah perkara biasa.
Dialog: 0,0:09:40.83,0:09:41.80, Lalai,,0,0,0,,{\an8}Apa yang anda maksudkan?
Dialog: 0,0:09:41.83,0:09:44.22,Lalai,,0,0,0,,{\an8}Saya fikir dia hilang akal sejak kebelakangan ini,
Dialog: 0,0:09:44.25,0:09:46.56,Lalai,,0,0,0,,{\an8}memandangkan dia kelihatan benar-benar mencintai Hae-in,
Dialog: 0,0:09:46.58,0:09:49.64, Lalai,,0,0,0,,{\an8}tetapi dia sama seperti lelaki lain.
Dialog: 0,0:09:49.67,0:09:51.27,Lalai,,0,0,0,,{\an8}Saya juga terkejut.
Dialog: 0,0:09:51.29,0:09:54.75,Lalai,,0,0,0,,{\an8}Siapa tahu dia merancang\Nuntuk menceraikannya secara rahsia?
Dialog: 0,0:09:57.59,0:10:00.54,Lalai,,0,0,0,,{\an8}- Saya tertanya-tanya bila semuanya bermula.\N- Apa?
Dialog: 0,0:10:01.14,0:10:02.78,Lalai,,0,0,0,,{\an8}Mesti ada yang menggalakkannya.
Dialog: 0,0:10:02.81,0:10:04.70,Lalai,,0,0,0,,{\an8}Saya juga telah mengesyaki seseorang.
Dialog: 0,0:10:04.72,0:10:06.43, Lalai,,0,0,0,,{\an8}Siapa?
Dialog: 0,0:10:10.56,0:10:12.31,Lalai,,0,0,0,,{\an8}Makcik saya.
Dialog: 0,0:10:12.44,0:10:14.14, Lalai,,0,0,0,,{\an8}Saya faham.
Dialog: 0,0:10:15.28,0:10:16.25,Lalai,,0,0,0,,{\an8}Apa?
Dialog: 0,0:10:16.28,0:10:20.01,Lalai,,0,0,0,,Dia menghalang laluan saya\Nand bercakap mengarut kebelakangan ini,
Dialog: 0,0:10:20.03,0:10:23.07,Lalai,,0,0,0,,tentang Hyun-woo lebih kacak daripada saya.
Dialog: 0,0:10:25.91,0:10:29.06, Lalai,,0,0,0,,Baru-baru ini nampaknya mereka\Ndua berkongsi rahsia.
Dialog: 0,0:10:29.08,0:10:31.16, Lalai,,0,0,0,,Saya melihatnya kali terakhir.
Dialog: 0,0:10:31.79,0:10:34.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Keutamaan terbesar perniagaan ini...{\c}{\i0}
Dialog: 0,0:10:36.59,0:10:38.82,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Jadi kenapa anda tidak pergi?{\c}{\i0}
Dialog: 0,0:10:38.84,0:10:40.75, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa dia pergi bersendirian?{\c}{\i0}
Dialog: 0,0:10:41.64,0:10:43.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda membiarkan dia pergi seorang diri?{\c}{\i0}
Dialog: 0,0:10:43.89,0:10:46.21,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Hantar siapa sahaja?\N- Kenapa?{\c}{\i0}
Dialog: 0,0:10:48.98,0:10:51.30, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa? Mengapa dia menangis?{\c}{\i0}
Dialog: 0,0:10:51.85,0:10:55.79,Lalai,,0,0,0,,Mereka sedang berbual serius secara rahsia.
Dialog: 0,0:10:55.82,0:10:57.50, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:10:57.53,0:10:59.52, Lalai,,0,0,0,,Saya tertanya-tanya tentang apa itu.
Dialog: 0,0:12:12.31,0:12:13.37, Lalai,,0,0,0,,Nak ke mana?
Dialog: 0,0:12:13.39,0:12:15.97, Lalai,,0,0,0,,Rawatan gagal, jadi apa?
Dialog: 0,0:12:16.06,0:12:19.04, Lalai,,0,0,0,,Maksudnya ialah kita perlukan masa.
Dialog: 0,0:12:19.07,0:12:21.80,Lalai,,0,0,0,,Jom pulang ke Korea,\Naikkan WBC anda, kemudian kembali...
Dialog: 0,0:12:21.82,0:12:24.15, Lalai,,0,0,0,,Kau keji.
Dialog: 0,0:12:24.36,0:12:30.11,Lalai,,0,0,0,,Saya tahu awak gembira saya akan mati,\Nand telah menyerahkan segala-galanya.
Dialog: 0,0:12:34.00,0:12:37.33, Lalai,,0,0,0,,Anda telah menyerahkan segala-galanya?
Dialog: 0,0:13:10.16,0:13:12.69, Lalai,,0,0,0,,Jadi anda tidak akan cuba lagi?
Dialog: 0,0:13:16.54,0:13:18.62, Lalai,,0,0,0,,Bagaimana pula dengan tuntutan mahkamah?
Dialog: 0,0:13:19.59,0:13:22.29,Lalai,,0,0,0,,Saya akan berterima kasih jika awak ceraikan saya...
Dialog: 0,0:13:22.59,0:13:24.50,Lalai,,0,0,0,,tanpa memfailkan saman.
Dialog: 0,0:13:27.80,0:13:30.42,Lalai,,0,0,0,,- Apa?\N- Anda tahu segala-galanya sekarang.
Dialog: 0,0:13:30.97,0:13:32.66, Lalai,,0,0,0,,Jadi?
Dialog: 0,0:13:32.68,0:13:36.38, Lalai,,0,0,0,,Anda tidak akan melepaskan saya semudah itu.
Dialog: 0,0:13:37.31,0:13:40.35,Lalai,,0,0,0,,Adalah tidak tertanggung untuk tinggal bersama anda.
Dialog: 0,0:13:41.73,0:13:44.75,Lalai,,0,0,0,,Jangan berlagak seperti anda tidak tahu, Hae-in.
Dialog: 0,0:13:44.78,0:13:47.90,Lalai,,0,0,0,,Anda tahu jenis orang anda.
Dialog: 0,0:13:49.62,0:13:51.78, Lalai,,0,0,0,,Tidak hairanlah saya memilih untuk berbuat demikian.
Dialog: 0,0:13:52.70,0:13:55.85,Lalai,,0,0,0,,Saya boleh menjalani kehidupan yang selesa dan kaya,
Dialog: 0,0:13:55.87,0:13:58.57,Lalai,,0,0,0,,jadi kenapa saya mahu lari?
Dialog: 0,0:14:02.67,0:14:06.04,Lalai,,0,0,0,,Kerana saya benci hidup\Ndengan awak lebih daripada segalanya!
Dialog: 0,0:14:09.43,0:14:11.13, Lalai,,0,0,0,,Hei.
Dialog: 0,0:14:11.47,0:14:14.37,Lalai,,0,0,0,,- Baek Hyun-woo.\N- Ya, anda betul.
Dialog: 0,0:14:14.39,0:14:16.08, Lalai,,0,0,0,,Saya jujur.
Dialog: 0,0:14:16.10,0:14:19.18,Lalai,,0,0,0,,Apabila saya dengar awak akan mati tidak lama lagi,
Dialog: 0,0:14:19.52,0:14:23.18, Lalai,,0,0,0,,Saya berasa lega jauh di lubuk hati.
Dialog: 0,0:14:24.40,0:14:26.67,Lalai,,0,0,0,,Kami akan bercerai bersih\Jika saya bersabar dengan awak...
Dialog: 0,0:14:26.69,0:14:28.98, Lalai,,0,0,0,,untuk tiga bulan akan datang,
Dialog: 0,0:14:29.70,0:14:31.86, Lalai,,0,0,0,,tetapi saya telah ditangkap.
Dialog: 0,0:14:33.95,0:14:36.07, Lalai,,0,0,0,,Semuanya musnah.
Dialog: 0,0:14:40.71,0:14:43.03, Lalai,,0,0,0,,Jika anda memilih...
Dialog: 0,0:14:43.13,0:14:46.91,Lalai,,0,0,0,,tidak mengambil sebarang tindakan\Nat semua dan ceraikan saya sahaja,
Dialog: 0,0:14:48.30,0:14:50.46, Lalai,,0,0,0,,sejujurnya,
Dialog: 0,0:14:50.93,0:14:52.63, Lalai,,0,0,0,,Saya akan berterima kasih.
Dialog: 0,0:14:56.06,0:14:57.88, Lalai,,0,0,0,,Adakah anda akan melakukannya?
Dialog: 0,0:15:01.98,0:15:03.68, Lalai,,0,0,0,,Apa yang perlu saya lakukan?
Dialog: 0,0:15:04.19,0:15:06.50, Lalai,,0,0,0,, Patutkah saya berkemas dan pergi sebaik sahaja kami pulang?
Dialog: 0,0:15:06.53,0:15:07.50,Lalai,,0,0,0,,Atau...
Dialog: 0,0:15:07.53,0:15:12.90,Lalai,,0,0,0,,jika saya terus merendahkan kaki anda, adakah anda akan menyemak semula kehendak anda?
Dialog: 0,0:15:21.50,0:15:23.78, Lalai,,0,0,0,,Adakah anda pasti anda boleh menangani perkara ini?
Dialog: 0,0:15:26.21,0:15:29.79,Lalai,,0,0,0,,Awak rasa awak boleh tahan kemarahan saya?
Dialog: 0,0:15:33.47,0:15:35.59,Lalai,,0,0,0,,Kemudian teruskan!
Dialog: 0,0:15:36.93,0:15:38.84, Lalai,,0,0,0,,Apa yang anda akan lakukan?
Dialog: 0,0:15:39.14,0:15:41.38,Lalai,,0,0,0,,Lakukan sesuatu jika anda boleh!
Dialog: 0,0:16:11.13,0:16:13.90,Lalai,,0,0,0,,En. Song telah melalui\Npusingan pertama soal siasatnya,
Dialog: 0,0:16:13.93,0:16:18.41, Lalai,,0,0,0,,tetapi peguam kami meragui\Npendakwaan akan berhenti di sini.
Dialog: 0,0:16:18.43,0:16:20.99, Lalai,,0,0,0,,Jika itu cara pendakwaan akan diteruskan,
Dialog: 0,0:16:21.02,0:16:24.16,Lalai,,0,0,0,,maka hanya tinggal masa\N sehingga mereka memanggil anda.
Dialog: 0,0:16:24.19,0:16:26.54, Lalai,,0,0,0,,Lihat kekacauan yang kita hadapi ini, terima kasih kepada Hyun-woo.
Dialog: 0,0:16:26.56,0:16:30.09,Lalai,,0,0,0,,Saya bimbang mereka memanggil awak.
Dialog: 0,0:16:30.11,0:16:32.25, Lalai,,0,0,0,,Anda perlu mengambil ubat anda tepat pada masanya.
Dialog: 0,0:16:32.28,0:16:34.90, Lalai,,0,0,0,, Kemudian anda boleh pergi sebaliknya.
Dialog: 0,0:16:34.95,0:16:36.09, Lalai,,0,0,0,,- Maaf?\N- Apa yang salah?
Dialog: 0,0:16:36.12,0:16:41.44,Lalai,,0,0,0,,Saya berada di dalam penjara selama sepuluh bulan\Nsemasa umur saya Soo-cheol.
Dialog: 0,0:16:42.00,0:16:43.06, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:16:43.08,0:16:46.37,Lalai,,0,0,0,,Kalaulah saya semuda Soo-cheol.
Dialog: 0,0:16:52.13,0:16:54.50,Lalai,,0,0,0,,Kenapa awak pandang saya?
Dialog: 0,0:16:55.76,0:16:59.41, Lalai,,0,0,0,,Ini adalah pengalaman yang anda\Ntak boleh beli dengan wang pun.
Dialog: 0,0:16:59.43,0:17:00.62,Lalai,,0,0,0,,Saya tidak berminat.
Dialog: 0,0:17:00.64,0:17:05.25,Lalai,,0,0,0,,Jika anda muncul sebagai gantinya,\Norang akan menganggap anda pewaris,
Dialog: 0,0:17:05.27,0:17:07.36,Lalai,,0,0,0,,tetapi jika anda tidak melakukannya, mereka akan menganggap anda teruk.
Dialog: 0,0:17:07.38,0:17:09.25,Lalai,,0,0,0,,Saya mempunyai keluarga untuk dilindungi.
Dialog: 0,0:17:09.27,0:17:11.13, Lalai,,0,0,0,,Saya juga begitu.
Dialog: 0,0:17:11.15,0:17:13.09, Lalai,,0,0,0,,Ya, itu saya. Awak patut lindungi saya.
Dialog: 0,0:17:13.11,0:17:14.59,Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:17:14.61,0:17:16.48, Lalai,,0,0,0,,Senyap!
Dialog: 0,0:17:16.78,0:17:20.64, Lalai,,0,0,0,,Masalahnya ialah kita mempunyai\Nurusan pelaburan penting akan datang.
Dialog: 0,0:17:20.66,0:17:23.97,Lalai,,0,0,0,,Jika pelabur mengetahui,\Nurusniaga mungkin gagal.
Dialog: 0,0:17:24.00,0:17:26.52, Lalai,,0,0,0,,Dia betul, tuan. Kita harus menyegerakan perjanjian itu.
Dialog: 0,0:17:26.54,0:17:29.39,Lalai,,0,0,0,,Kami menyediakan jamuan penuh di hadapan kami...
Dialog: 0,0:17:29.42,0:17:31.06, Lalai,,0,0,0,,yang boleh diambil oleh Pengerusi Yeom.
Dialog: 0,0:17:31.09,0:17:33.44, Lalai,,0,0,0,,Pemberita akan mengetahui lambat laun.
Dialog: 0,0:17:33.46,0:17:37.61, Lalai,,0,0,0,, En. Yoon akan menarik diri serta-merta, kemudian,\Nand itulah yang Pengerusi Yeom mahukan.
Dialog: 0,0:17:37.63,0:17:41.59,Lalai,,0,0,0,,Mula-mula kita perlu memastikan perjanjian itu.
Dialog: 0,0:17:43.02,0:17:44.72,Lalai,,0,0,0,,Atuk!
Dialog: 0,0:18:37.40,0:18:39.28,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Queens Mart Masuk Perniagaan Resort Baharu{\c}{\i0}
Dialog: 0,0:18:41.32,0:18:43.80, Lalai,,0,0,0,,Setelah pembinaan bermula,
Dialog: 0,0:18:43.83,0:18:47.47, Lalai,,0,0,0,,kami akan menyindir isu pelesenan\Nberkaitan dengan sekatan ketinggian...
Dialog: 0,0:18:47.50,0:18:49.22, Lalai,,0,0,0,,kepada pelabur.
Dialog: 0,0:18:49.25,0:18:51.73,Lalai,,0,0,0,,Kemudian pelabur dan saham\Nfirma yang memberi pinjaman...
Dialog: 0,0:18:51.75,0:18:54.69, Lalai,,0,0,0,,akan memilih pilihan pra-pembayaran.
Dialog: 0,0:18:54.71,0:18:57.69,Lalai,,0,0,0,,Soo-cheol, pengecut itu, akan terkejut.
Dialog: 0,0:18:57.71,0:18:59.50,Lalai,,0,0,0,,Dia mungkin menangis.
Dialog: 0,0:18:59.55,0:19:02.32,Lalai,,0,0,0,,Ketika itulah saya akan menawarkan untuk melabur jumlah itu...
Dialog: 0,0:19:02.34,0:19:05.74, Lalai,,0,0,0,,pelabur telah menarik diri,\Nand mencadangkan bon boleh tukar.
Dialog: 0,0:19:05.76,0:19:08.70, Lalai,,0,0,0,,Ini adalah masanya pihak pendakwaan akan menyiasat?
Dialog: 0,0:19:08.73,0:19:09.70,Lalai,,0,0,0,,Betul.
Dialog: 0,0:19:09.73,0:19:12.73, Lalai,,0,0,0,,Setelah berita penyelewengan diterima\Nout dan keluarga Hong masuk penjara,
Dialog: 0,0:19:12.75,0:19:16.08, Lalai,,0,0,0,,Saya akan menggunakan bon boleh tukar\Nuntuk membeli saham Queens.
Dialog: 0,0:19:16.11,0:19:20.55, Lalai,,0,0,0,, Kemudian saya akan menggabungkannya dengan\N 4.9% yang saya beli sebelum ini,
Dialog: 0,0:19:20.57,0:19:23.90, Lalai,,0,0,0,,dan menjadi pemegang saham terbesar.
Dialog: 0,0:19:25.28,0:19:27.64, Lalai,,0,0,0,,Semuanya berjalan lancar.
Dialog: 0,0:19:27.66,0:19:30.22,Lalai,,0,0,0,,Hyun-woo pun tiada dalam gambar sekarang.
Dialog: 0,0:19:30.25,0:19:35.12, Lalai,,0,0,0,,Siapa tahu kami akan menemui surat cerai\N pada masa yang tepat ini?
Dialog: 0,0:19:36.09,0:19:37.40,Lalai,,0,0,0,,Adakah Hyun-woo mengakuinya?
Dialog: 0,0:19:37.42,0:19:39.11, Lalai,,0,0,0,,Adakah dia menandatangani surat cerai?
Dialog: 0,0:19:39.13,0:19:41.73, Lalai,,0,0,0,,Kenapa perlu bertanya? Sudah tentu dia.
Dialog: 0,0:19:41.76,0:19:43.07, Lalai,,0,0,0,,Bagaimana dia boleh melakukan ini?
Dialog: 0,0:19:43.09,0:19:44.82, Lalai,,0,0,0,,Kenapa anda tertanya-tanya?
Dialog: 0,0:19:44.85,0:19:46.61, Lalai,,0,0,0,,Mereka sepatutnya bercerai sahaja.
Dialog: 0,0:19:46.64,0:19:50.58,Lalai,,0,0,0,,Dia menyadap bilik anda dan memberikan\Npita kepada pihak pendakwaan,
Dialog: 0,0:19:50.60,0:19:52.41, Lalai,,0,0,0,,tetapi saya boleh melihat melepasinya.
Dialog: 0,0:19:52.44,0:19:54.08, Lalai,,0,0,0,,Mengapa anda mahu?
Dialog: 0,0:19:54.10,0:19:57.33, Lalai,,0,0,0,,Keluarga kami sangat bertolak ansur\Tanpa penderitaan ibu bapa mereka.
Dialog: 0,0:19:57.36,0:19:59.54,Lalai,,0,0,0,,Satu perkara yang saya tidak faham...
Dialog: 0,0:19:59.57,0:20:03.84,Lalai,,0,0,0,,adalah si bajingan itu mahu menceraikannya dahulu.
Dialog: 0,0:20:03.86,0:20:06.44, Lalai,,0,0,0,,Itu satu perkara yang saya faham.
Dialog: 0,0:20:06.66,0:20:08.82,Lalai,,0,0,0,,Saya pasti ada seseorang.
Dialog: 0,0:20:09.24,0:20:11.18, Lalai,,0,0,0,,Mungkin perempuan simpanan.
Dialog: 0,0:20:11.21,0:20:14.24, Lalai,,0,0,0,,- Ayah, saya akan menelitinya.\N- Tidak.
Dialog: 0,0:20:14.71,0:20:16.48, Lalai,,0,0,0,,- Pasukan audit akan.\N- Mereka akan?
Dialog: 0,0:20:16.50,0:20:19.90,Lalai,,0,0,0,,Dia akan meninggalkan Queens selepas perceraian.\NI perlu mengetahui sebelum itu.
Dialog: 0,0:20:19.92,0:20:23.65, Lalai,,0,0,0,,Saya akan melihat melalui komputernya,\Ndokumen kewangan, telefon dan akaun.
Dialog: 0,0:20:23.68,0:20:24.90,Lalai,,0,0,0,,Saya akan menjejaki dananya.
Dialog: 0,0:20:24.93,0:20:28.07,Lalai,,0,0,0,,Saya akan tahu siapa yang dia jumpa\Nand apa yang dia lakukan.
Dialog: 0,0:20:28.10,0:20:30.99,Lalai,,0,0,0,,Apabila saya mendapati sebarang\Penggelapan atau perbuatan yang menyalahi undang-undang,
Dialog: 0,0:20:31.02,0:20:34.93, Lalai,,0,0,0,,Saya akan melaporkannya, dan memfailkan tuntutan untuk ganti rugi.
Dialog: 0,0:20:36.31,0:20:39.27, Lalai,,0,0,0,,- Anda akan pergi sejauh itu?\N- Ya, saya akan melakukannya.
Dialog: 0,0:20:41.32,0:20:46.69,Lalai,,0,0,0,,Saya akan uruskan, jadi\Ntolong jangan ganggu.
Dialog: 0,0:20:56.63,0:20:58.41, Lalai,,0,0,0,,Dia pasti tidak berbelas kasihan.
Dialog: 0,0:20:59.42,0:21:01.36,Lalai,,0,0,0,,Saya cakap saya akan jemput awak di lapangan terbang.
Dialog: 0,0:21:01.38,0:21:02.36, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:21:02.38,0:21:04.61, Lalai,,0,0,0,,Hei, awak cedera?
Dialog: 0,0:21:04.63,0:21:06.74, Lalai,,0,0,0,,Bolehkah anda mendengar saya?
Dialog: 0,0:21:06.76,0:21:11.80, Lalai,,0,0,0,,Gegendang telinga anda boleh meletus apabila anda dipukul.\NIIa berlaku kepada ramai pelanggan saya.
Dialog: 0,0:21:11.89,0:21:13.37, Lalai,,0,0,0,,Bolehkah anda mendengar saya?
Dialog: 0,0:21:13.39,0:21:14.54,Lalai,,0,0,0,,Cukuplah.
Dialog: 0,0:21:14.56,0:21:17.21, Lalai,,0,0,0,,Jadi awak okay. awak sihat.
Dialog: 0,0:21:17.23,0:21:19.85, Lalai,,0,0,0,, Astaga. Syabas.
Dialog: 0,0:21:19.94,0:21:22.60, Lalai,,0,0,0,, Datang ke sini. Biar saya peluk awak.
Dialog: 0,0:21:28.12,0:21:31.18, Lalai,,0,0,0,,Anda sepatutnya berpura-pura tidak bersalah,\Nmemandangkan anda tetap bertindak.
Dialog: 0,0:21:31.20,0:21:32.76, Lalai,,0,0,0, "Surat cerai bukan apa-apa."
Dialog: 0,0:21:32.79,0:21:35.09, Lalai,,0,0,0,"Saya baru sahaja berlatih untuk\Nmenjadi peguam cerai."
Dialog: 0,0:21:35.12,0:21:37.48, Lalai,,0,0,0,,Tidakkah anda boleh membuat improvisasi?
Dialog: 0,0:21:37.50,0:21:40.90,Lalai,,0,0,0,,{\an8}Dia pasti marah. Saya akan bertaruh\Ndia lebih menakutkan sekarang.
Dialog: 0,0:21:40.92,0:21:43.27, Lalai,,0,0,0,,Saya pasti awak sudah putus asa.
Dialog: 0,0:21:43.30,0:21:44.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Tersedia untuk Sewa Bulanan{\c}{\i0}
Dialog: 0,0:21:44.51,0:21:46.78,Lalai,,0,0,0,,Anda bekerja keras berpura-pura jatuh cinta.
Dialog: 0,0:21:46.80,0:21:48.82, Lalai,,0,0,0,,Anda pasti berasa putus asa sekarang.
Dialog: 0,0:21:48.84,0:21:50.07, Lalai,,0,0,0,,Anda silap.
Dialog: 0,0:21:50.10,0:21:51.86, Lalai,,0,0,0,,- Apa maksud awak?\N- Dia tidak marah.
Dialog: 0,0:21:51.89,0:21:53.76, Lalai,,0,0,0,,- Betulkah?\N- Betul,
Dialog: 0,0:21:54.35,0:21:57.22, Lalai,,0,0,0,, dan saya tidak berasa putus asa.
Dialog: 0,0:21:58.81,0:22:00.04, Lalai,,0,0,0,,- Saya kecewa.\N- Hei.
Dialog: 0,0:22:00.06,0:22:01.83, Lalai,,0,0,0,,Anda tidak berada dalam kedudukan untuk berasa seperti itu.
Dialog: 0,0:22:01.86,0:22:03.58,Lalai,,0,0,0,,Hae-in menangis.
Dialog: 0,0:22:03.61,0:22:05.39, Lalai,,0,0,0,, Dia lakukan,
Dialog: 0,0:22:05.44,0:22:07.76, Lalai,,0,0,0,, dan ia membuatkan saya gila...
Dialog: 0,0:22:07.78,0:22:11.27, Lalai,,0,0,0,, melihat dia menangis.
Dialog: 0,0:22:12.33,0:22:14.61,Lalai,,0,0,0,,Apa yang ada di dunia...
Dialog: 0,0:22:16.12,0:22:18.57,Lalai,,0,0,0,,adakah saya lakukan padanya?
Dialog: 0,0:22:23.21,0:22:24.19, Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:22:24.21,0:22:27.36, Lalai,,0,0,0,,Saya fikir dia tidak tahan berada di sebelahnya.
Dialog: 0,0:22:27.38,0:22:30.25,Lalai,,0,0,0,,Adakah dia mempunyai perasaan terhadapnya, atau apa?
Dialog: 0,0:22:31.05,0:22:32.95, Lalai,,0,0,0,,Jadi apakah tindakan anda seterusnya?
Dialog: 0,0:22:32.97,0:22:35.28, Lalai,,0,0,0,,- Apa langkah?\N- Adakah anda tiada rancangan?
Dialog: 0,0:22:35.31,0:22:37.62, Lalai,,0,0,0,,Dia mungkin sedang merancang sesuatu.
Dialog: 0,0:22:37.64,0:22:39.16, Lalai,,0,0,0,,Sudah tentu dia.
Dialog: 0,0:22:39.19,0:22:42.62,Lalai,,0,0,0,,Anda kecewakan dia, jadi saya akan\Nbet dia memikirkan cara terbaik...
Dialog: 0,0:22:42.65,0:22:43.92,Lalai,,0,0,0,,untuk membalas dendam.
Dialog: 0,0:22:43.94,0:22:45.54,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:22:45.57,0:22:47.13, Lalai,,0,0,0,,- Dia sepatutnya.\N- Apa maksud awak?
Dialog: 0,0:22:47.15,0:22:50.63, Lalai,,0,0,0,,Dia perlukan motivasi itu.\Ndia perlu fokus pada sesuatu.
Dialog: 0,0:22:50.66,0:22:54.01, Lalai,,0,0,0,,Jadi awak sengaja biarkan dia\Nfokus untuk merosakkan hidup awak?
Dialog: 0,0:22:54.03,0:22:55.34,Lalai,,0,0,0,,Adakah anda pengorbanan?
Dialog: 0,0:22:55.37,0:22:58.31, Lalai,,0,0,0,,Adakah anda seorang askar yang menghadapi pertempuran yang kalah?
Dialog: 0,0:22:58.33,0:23:00.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika perkara ini berlaku lagi,{\c}{\i0}
Dialog: 0,0:23:00.87,0:23:02.62, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jangan selamatkan saya.{\c}{\i0}
Dialog: 0,0:23:03.46,0:23:06.08, Lalai,,0,0,0,,Ini satu-satunya cara dia akan hidup.
Dialog: 0,0:23:24.82,0:23:26.72, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:23:27.40,0:23:28.50, Lalai,,0,0,0,,Mengapa anda melakukannya?
Dialog: 0,0:23:28.53,0:23:31.26,Lalai,,0,0,0,,Saya dalam perjalanan untuk berjumpa\Ngrandfather anda. Nanti kita bincang.
Dialog: 0,0:23:31.28,0:23:32.98, Lalai,,0,0,0,,Ia tetap saya.
Dialog: 0,0:23:33.95,0:23:35.80,Lalai,,0,0,0,,- Apa maksud anda?\N- Cuba semua yang anda mahu,
Dialog: 0,0:23:35.83,0:23:38.69, Lalai,,0,0,0,,tetapi pewarisnya ialah saya!
Dialog: 0,0:23:41.33,0:23:43.06, Lalai,,0,0,0,,Anda masih tidak faham?
Dialog: 0,0:23:43.08,0:23:45.56,Lalai,,0,0,0,,Adakah anda begitu cemburu dengan saya,\Nbahawa anda akan mengganggu biliknya?
Dialog: 0,0:23:45.59,0:23:48.65, Lalai,,0,0,0,,Adakah anda ingin tahu semua\Nperbualan yang kami alami?
Dialog: 0,0:23:48.67,0:23:50.11, Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,0:23:50.13,0:23:52.11, Lalai,,0,0,0,,- Saya tidak mengganggu biliknya.\N- Saya faham.
Dialog: 0,0:23:52.13,0:23:53.82, Lalai,,0,0,0,,Dapatkan apa?
Dialog: 0,0:23:53.84,0:23:56.70,Lalai,,0,0,0,,Saya tahu anda akan\Nsesuatu apabila anda bersabar...
Dialog: 0,0:23:56.72,0:23:58.16,Lalai,,0,0,0,,dengan semua yang Hae-in lakukan,
Dialog: 0,0:23:58.18,0:24:01.18, Lalai,,0,0,0,,tetapi bagaimana sekarang? Anda telah ditangkap.
Dialog: 0,0:24:04.02,0:24:08.29,Lalai,,0,0,0,,Saya bercadang untuk memberi anda sesuatu\Setelah perjanjian resort ini berjaya.
Dialog: 0,0:24:08.32,0:24:11.09,Lalai,,0,0,0,,"Saya harus menubuhkan cawangan di Yufuin atau Cancún,"
Dialog: 0,0:24:11.11,0:24:13.38, Lalai,,0,0,0,,"dan hantar dia ke sana."
Dialog: 0,0:24:13.41,0:24:15.55, Lalai,,0,0,0,,"Tidak, Yufuin terlalu dekat."
Dialog: 0,0:24:15.57,0:24:17.80, Lalai,,0,0,0,,"Hae-in hanya perlu terbang sejam."
Dialog: 0,0:24:17.83,0:24:19.93,Lalai,,0,0,0,,"Dia harus pergi ke Cancún jika dia mahukan kebebasan."
Dialog: 0,0:24:19.95,0:24:22.99,Lalai,,0,0,0,,Itulah betapa saya mengambil berat tentang awak.
Dialog: 0,0:24:26.34,0:24:27.31,Lalai,,0,0,0,,Apa?
Dialog: 0,0:24:27.34,0:24:29.94, Lalai,,0,0,0,,Anda perlu menghentikan pembinaan resort.
Dialog: 0,0:24:29.96,0:24:32.48,Lalai,,0,0,0,,Firma perunding Encik Yoon memperkenalkan...
Dialog: 0,0:24:32.51,0:24:36.82, Lalai,,0,0,0,,meramalkan keuntungan tahunan sebanyak $500 juta,\Ntetapi angka sebenar ialah $89 juta.
Dialog: 0,0:24:36.85,0:24:39.24, Lalai,,0,0,0,,Itu kurang daripada 20%. Bukankah itu ganjil?
Dialog: 0,0:24:39.26,0:24:42.20,Lalai,,0,0,0,,Anda telah menandatangani kontrak\Walaupun sebelum ujian kesahihan...
Dialog: 0,0:24:42.23,0:24:44.25, Lalai,,0,0,0,,Anda cuba menghalang lagi!
Dialog: 0,0:24:44.27,0:24:48.22,Lalai,,0,0,0,,Berhenti bimbang tentang kejayaan saya.
Dialog: 0,0:24:53.49,0:24:56.27,Lalai,,0,0,0,,Jangan lupa! Ia akan menjadi saya!
Dialog: 0,0:25:03.41,0:25:04.89,Lalai,,0,0,0,,Saya minta maaf kerana membimbangkan awak.
Dialog: 0,0:25:04.92,0:25:06.27, Lalai,,0,0,0,,Baiklah, jelaskan.
Dialog: 0,0:25:06.29,0:25:08.69, Lalai,,0,0,0,,Kenapa awak sorokkan surat cerai?
Dialog: 0,0:25:08.71,0:25:11.40, Lalai,,0,0,0,,Adakah anda akan mengejutkan kami dengannya nanti?
Dialog: 0,0:25:11.42,0:25:14.73,Lalai,,0,0,0,,Adakah itu sebabnya anda mencela\N perkataan saya dan tidak mematuhi saya?
Dialog: 0,0:25:14.76,0:25:16.92, Lalai,,0,0,0,,Hanya kerana kertas itu?
Dialog: 0,0:25:18.60,0:25:20.49,Lalai,,0,0,0,,Tuan, pengerusi ingin berjumpa dengan tuan.
Dialog: 0,0:25:20.51,0:25:21.57, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:25:21.60,0:25:23.49, Lalai,,0,0,0,,Sila tinggalkan semua elektronik anda di luar.
Dialog: 0,0:25:23.52,0:25:25.04, Lalai,,0,0,0,,Ya, lakukan itu.
Dialog: 0,0:25:25.06,0:25:27.39, Lalai,,0,0,0,,Anda boleh merakam walaupun sekarang.
Dialog: 0,0:25:46.75,0:25:49.23, Lalai,,0,0,0,,Apa yang Pengerusi Yeom janjikan kepada kamu?
Dialog: 0,0:25:49.25,0:25:50.56, Lalai,,0,0,0,,- Maaf?\N- Perceraian.
Dialog: 0,0:25:50.59,0:25:52.81, Lalai,,0,0,0,,Saya tidak kisah tentangnya.
Dialog: 0,0:25:52.84,0:25:54.76, Lalai,,0,0,0,,Anda memilih untuk merosakkan nasib anda.
Dialog: 0,0:25:54.78,0:25:55.82, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:25:55.84,0:25:58.19, Lalai,,0,0,0,,Tetapi jika anda menyadap bilik saya,
Dialog: 0,0:25:58.22,0:26:01.70,Lalai,,0,0,0,,dan Pengerusi Yeom menyerahkan\Nit kepada pihak pendakwaan,
Dialog: 0,0:26:01.72,0:26:03.07, Lalai,,0,0,0,,Saya tidak akan membenarkan itu.
Dialog: 0,0:26:03.10,0:26:06.45, Lalai,,0,0,0,,Adakah anda merancang penyelewengan Encik Song juga?
Dialog: 0,0:26:06.48,0:26:08.29, Lalai,,0,0,0,,Adakah anda menyasarkan saya?
Dialog: 0,0:26:08.31,0:26:11.79, Lalai,,0,0,0,,Memang benar penyelewengan\N disasarkan kepada anda.
Dialog: 0,0:26:11.82,0:26:13.46, Lalai,,0,0,0,,Adakah anda bermain bijak dengan saya?
Dialog: 0,0:26:13.48,0:26:16.69, Lalai,,0,0,0,,Saya bertanya sama ada anda berada di belakangnya!
Dialog: 0,0:26:21.41,0:26:25.10,Lalai,,0,0,0,,Pengarah Jo Hyeon-myeong meluluskan\NMr. Fail penyelewengan Song.
Dialog: 0,0:26:25.12,0:26:27.95, Lalai,,0,0,0,,Lelaki di sebelahnya telah bertanggungjawab ke atas audit luaran Queens.
Dialog: 0,0:26:27.97,0:26:30.43,Lalai,,0,0,0,,Dia ialah Hwang Byeong-u yang\N mempunyai firma perakaunan sendiri.
Dialog: 0,0:26:30.46,0:26:33.35,Lalai,,0,0,0,,- Mereka pergi ke kolej yang sama.\N- Jadi apa?
Dialog: 0,0:26:33.38,0:26:35.86, Lalai,,0,0,0,,Dia telah melakukan audit tahunan,
Dialog: 0,0:26:35.88,0:26:38.36, Lalai,,0,0,0,,jadi pelik bahawa dia tidak menemui sebarang isu sehingga sekarang.
Dialog: 0,0:26:38.38,0:26:39.74, Lalai,,0,0,0,,Ada firma perakaunannya...
Dialog: 0,0:26:39.76,0:26:43.50, Lalai,,0,0,0,, benar-benar tidak menyedari tentang Kecurangan Encik Song selama lima tahun yang lalu?
Dialog: 0,0:26:53.86,0:26:58.88,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jadi anda memberitahu saya Jo Hyeon-myeong\Nschemed dengan firmanya,{\c}{\i0}
Dialog: 0,0:26:58.90,0:27:02.30,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan menutup mata terhadap penyelewengan?{\c}{\i0}
Dialog: 0,0:27:02.32,0:27:04.22,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jadi saya akan disiasat?{\c}{\i0}
Dialog: 0,0:27:04.24,0:27:05.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tidak, tuan.{\c}{\i0}
Dialog: 0,0:27:05.41,0:27:09.06, Lalai,,0,0,0,,Pengarah Jo tidak melakukan ini\Nalone. Seseorang mengarahkannya.
Dialog: 0,0:27:09.08,0:27:15.44,Lalai,,0,0,0,,Saya percaya individu itu telah menyadap bilik anda dan meletakkan pemancar di dalam bilik saya.
Dialog: 0,0:27:15.46,0:27:17.91, Lalai,,0,0,0,,Dan siapakah orang ini?
Dialog: 0,0:27:22.64,0:27:24.16,Lalai,,0,0,0,,Saya belum tahu lagi.
Dialog: 0,0:27:24.18,0:27:25.20,Lalai,,0,0,0,,Apa?
Dialog: 0,0:27:25.22,0:27:26.37, Lalai,,0,0,0,,Anda tidak pasti,
Dialog: 0,0:27:26.39,0:27:31.25,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}namun awak mahu saya percaya awak selepas\Napa yang awak lakukan kepada cucu saya?{\c}{\i0}
Dialog: 0,0:27:31.27,0:27:32.58,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Adakah anda?{\c}{\i0}
Dialog: 0,0:27:32.60,0:27:34.30, Lalai,,0,0,0,,Pengarah Jo.
Dialog: 0,0:27:34.73,0:27:36.72, Lalai,,0,0,0,,Anda harus cepat.
Dialog: 0,0:27:39.07,0:27:42.56,Lalai,,0,0,0,,Kenapa? Kerana Baek Hyun-woo mengejar awak.
Dialog: 0,0:27:53.33,0:27:54.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anggaran Aset $2,386.69{\c}{\i0}
Dialog: 0,0:27:59.42,0:28:01.15, Lalai,,0,0,0,,Adakah anda membuat saham lagi?
Dialog: 0,0:28:01.17,0:28:02.53, Lalai,,0,0,0,,Pasaran kucar-kacir.
Dialog: 0,0:28:02.55,0:28:08.05, Lalai,,0,0,0,,Tidak kira berapa warna birunya,\Selagi bayi saya merah.
Dialog: 0,0:28:08.35,0:28:09.42,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Queens Department Store{\c}{\i0}
Dialog: 0,0:28:10.10,0:28:12.41, Lalai,,0,0,0,,- Ia merah.\N- Apa itu?
Dialog: 0,0:28:12.44,0:28:13.45,Lalai,,0,0,0,,- Siapa bayi anda?\N- Tidak.
Dialog: 0,0:28:13.48,0:28:15.33, Lalai,,0,0,0,,- Ayuh. Beritahu saya.\N- Tidak.
Dialog: 0,0:28:15.36,0:28:17.96, Lalai,,0,0,0,,Tidak!
Dialog: 0,0:28:17.98,0:28:19.34, Lalai,,0,0,0,, Hentikan itu!
Dialog: 0,0:28:19.36,0:28:20.92,Lalai,,0,0,0,,Adakah anda gila?
Dialog: 0,0:28:20.94,0:28:23.05, Lalai,,0,0,0,,Anda membeli saham Queens?
Dialog: 0,0:28:23.07,0:28:25.65, Lalai,,0,0,0,,Ibu akan bunuh saya, jadi diam!
Dialog: 0,0:28:25.82,0:28:28.07, Lalai,,0,0,0,,Mengapa anda membelinya?
Dialog: 0,0:28:29.79,0:28:32.35, Lalai,,0,0,0,,Saya mempunyainya pada masa lalu, tetapi saya menjualnya.
Dialog: 0,0:28:32.37,0:28:35.39,Lalai,,0,0,0,,- Bila?\N- Apabila Hyun-woo menyebut tentang perceraian.
Dialog: 0,0:28:35.42,0:28:38.65, Lalai,,0,0,0,,Saya tidak boleh mengabaikan risiko pemilik.
Dialog: 0,0:28:38.67,0:28:43.40,Lalai,,0,0,0,,Tiada apa-apa yang baik akan datang daripada\N media menyebut perceraian mereka.
Dialog: 0,0:28:43.43,0:28:45.32, Lalai,,0,0,0,, Betapa liciknya awak.
Dialog: 0,0:28:45.34,0:28:48.28,Lalai,,0,0,0,,Kemudian anda membelinya semula apabila\NHyun-woo memutuskan untuk tidak bercerai?
Dialog: 0,0:28:48.30,0:28:50.28,Lalai,,0,0,0,,Betul. Semak ini.
Dialog: 0,0:28:50.31,0:28:52.80, Lalai,,0,0,0,,- Ia naik, kan?\N- Astaga.
Dialog: 0,0:28:54.10,0:28:55.80, Lalai,,0,0,0,,Ibu.
Dialog: 0,0:28:56.52,0:28:58.54,Lalai,,0,0,0,,Ia tidak seperti anda untuk tidur sebentar.
Dialog: 0,0:28:58.57,0:29:00.47, Lalai,,0,0,0,,Saya bermimpi buruk.
Dialog: 0,0:29:00.73,0:29:02.55, Lalai,,0,0,0,,- Astaga.\N- Apa itu?
Dialog: 0,0:29:02.57,0:29:03.75, Lalai,,0,0,0,,Ia adalah samar-samar.
Dialog: 0,0:29:03.78,0:29:06.20, Lalai,,0,0,0,,Apa itu? Mungkin ia adalah mimpi konsepsi.
Dialog: 0,0:29:06.22,0:29:07.26, Lalai,,0,0,0,,Hyun-woo seorang ayah?
Dialog: 0,0:29:07.28,0:29:09.98, Lalai,,0,0,0,,Ia bukan sesuatu yang comel seperti itu.
Dialog: 0,0:29:18.84,0:29:20.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu{\c}{\i0}
Dialog: 0,0:29:26.55,0:29:28.70, Lalai,,0,0,0,,- Hello?\N- Hello?
Dialog: 0,0:29:28.72,0:29:31.16,Lalai,,0,0,0,,Bukankah ini telefon Encik Baek Hyun-woo?
Dialog: 0,0:29:31.18,0:29:32.62, Lalai,,0,0,0,,Ya, betul.
Dialog: 0,0:29:32.64,0:29:34.70,Lalai,,0,0,0,,Saya ibu Hae-in.
Dialog: 0,0:29:34.73,0:29:37.25, Lalai,,0,0,0,,Helo, Cik Kim. Apa khabar?
Dialog: 0,0:29:37.27,0:29:40.83,Lalai,,0,0,0,,Saya rasa Hyun-woo tertinggal telefonnya,
Dialog: 0,0:29:40.86,0:29:43.29,Lalai,,0,0,0,,- {\i1}tetapi kenapa awak...?{\i0}\N- Ya.
Dialog: 0,0:29:43.32,0:29:45.38,Lalai,,0,0,0,,Dia bercakap dengan bapa mertua saya.
Dialog: 0,0:29:45.40,0:29:48.09,Lalai,,0,0,0,,{\i1}Saya tidak tahu jika anda tahu,{\i0}
Dialog: 0,0:29:48.11,0:29:50.72, Lalai,,0,0,0,,tetapi Hyun-woo membalikkan keluarga kami.
Dialog: 0,0:29:50.74,0:29:52.14,Lalai,,0,0,0,,Apa? Apa yang berlaku?
Dialog: 0,0:29:52.16,0:29:55.15,Lalai,,0,0,0,,Bilik bapa mertua saya diserang...
Dialog: 0,0:29:57.21,0:29:58.73, Lalai,,0,0,0,,Lupakan.
Dialog: 0,0:29:58.75,0:30:01.83,Lalai,,0,0,0,,Tahukah anda Hyun-woo mahu bercerai?
Dialog: 0,0:30:03.05,0:30:06.07, Lalai,,0,0,0,,Dia ada menyebutnya sebelum ini,
Dialog: 0,0:30:06.09,0:30:08.33,Lalai,,0,0,0,,{\i1}tetapi perkara biasa bagi pasangan suami isteri...{\i0}
Dialog: 0,0:30:08.35,0:30:10.07, Lalai,,0,0,0,,untuk melalui tompok kasar.
Dialog: 0,0:30:10.09,0:30:12.57, Lalai,,0,0,0,,Saya fikir mereka telah menyelesaikannya.
Dialog: 0,0:30:12.60,0:30:14.66,Lalai,,0,0,0,,Dia tahu tentang perceraian itu.
Dialog: 0,0:30:14.68,0:30:16.43, Lalai,,0,0,0,,Lihat...
Dialog: 0,0:30:16.73,0:30:19.62, Lalai,,0,0,0,,Anda harus mendengarnya terlebih dahulu.
Dialog: 0,0:30:19.65,0:30:21.58,Lalai,,0,0,0,,{\i1}Anda memberitahu saya untuk tidak menghalang mereka...{\i0}
Dialog: 0,0:30:21.61,0:30:23.42,Lalai,,0,0,0,,pada hari mereka berkahwin,
Dialog: 0,0:30:23.44,0:30:27.21,Lalai,,0,0,0,,tetapi anda lihat, saya akan pastikan mereka berpisah,
Dialog: 0,0:30:27.24,0:30:29.31,Lalai,,0,0,0,,{\i1}jadi jangan halang saya.{\i0}
Dialog: 0,0:30:30.82,0:30:33.03, Lalai,,0,0,0,,Mak, apa dia cakap?
Dialog: 0,0:30:33.33,0:30:35.11, Lalai,,0,0,0,,Apa yang perlu saya lakukan?
Dialog: 0,0:30:36.70,0:30:39.49,Lalai,,0,0,0,,Kebaikan. Apa yang saya buat?
Dialog: 0,0:30:39.54,0:30:41.28,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,0:30:43.00,0:30:45.00, Lalai,,0,0,0,,Ibu.
Dialog: 0,0:30:49.01,0:30:50.86, Lalai,,0,0,0,,Mestilah huru-hara.
Dialog: 0,0:30:50.89,0:30:53.67, Lalai,,0,0,0,,Bagaimana jika dia benar-benar bercerai?
Dialog: 0,0:31:00.31,0:31:01.66, Lalai,,0,0,0,,Awak brengsek.
Dialog: 0,0:31:01.69,0:31:03.37,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Jual{\c}{\i0}
Dialog: 0,0:31:03.40,0:31:04.52,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Pesanan anda telah selesai{\c}{\i0}
Dialog: 0,0:31:06.19,0:31:07.17, Lalai,,0,0,0,,Saya menjualnya.
Dialog: 0,0:31:07.19,0:31:09.88, Lalai,,0,0,0,,Tidak rumit.
Dialog: 0,0:31:09.90,0:31:12.72,Lalai,,0,0,0,,Buat apa yang mereka lakukan dengan epal.
Dialog: 0,0:31:12.74,0:31:15.39,Lalai,,0,0,0,,Pn. Hong boleh menggigit pir anda dan berkata,
Dialog: 0,0:31:15.41,0:31:18.51, Lalai,,0,0,0,"Astaga, manisnya."\NTItu sahaja yang dia perlu lakukan.
Dialog: 0,0:31:18.54,0:31:20.02, Lalai,,0,0,0,,Saya patut minta tolong dia lagi?
Dialog: 0,0:31:20.04,0:31:22.10, Lalai,,0,0,0,,Dia sepatutnya membantu kami.
Dialog: 0,0:31:22.13,0:31:25.12,Lalai,,0,0,0,,Merekalah yang mengambil kesempatan daripadanya.
Dialog: 0,0:31:25.38,0:31:27.06, Lalai,,0,0,0,,Apa pendapat anda tentang ini?
Dialog: 0,0:31:27.09,0:31:28.90,Lalai,,0,0,0,,Ia sudah luar biasa...
Dialog: 0,0:31:28.92,0:31:31.86,Lalai,,0,0,0,,bahawa dia meluangkan masa untuk datang ke sini dan melentur,
Dialog: 0,0:31:31.89,0:31:34.99,Lalai,,0,0,0,,dan anda ingin meminta bantuannya sekali lagi?
Dialog: 0,0:31:35.01,0:31:37.09, Lalai,,0,0,0,,Ia tidak akan mudah.
Dialog: 0,0:31:37.18,0:31:38.78, Lalai,,0,0,0,,- Betul.\N- Anda akan kehilangan muka.
Dialog: 0,0:31:38.81,0:31:40.33, Lalai,,0,0,0,,Betul ke?
Dialog: 0,0:31:40.35,0:31:43.79,Lalai,,0,0,0,,Kalau begitu adakah anda akan membiarkan Park Seok-hun mengambil segala-galanya?
Dialog: 0,0:31:43.81,0:31:47.21, Lalai,,0,0,0,,Anda sentiasa melampau.
Dialog: 0,0:31:47.23,0:31:49.39, Lalai,,0,0,0,,Adakah anda INFP?
Dialog: 0,0:31:50.53,0:31:52.76, Lalai,,0,0,0,,Apa maksud anda? Saya Park Chun-sik.
Dialog: 0,0:31:52.78,0:31:55.84, Lalai,,0,0,0,,Saya bercakap tentang matlamat anda.\NAdakah anda akan melakukan apa sahaja untuk mencapainya?
Dialog: 0,0:31:55.87,0:31:57.55, Lalai,,0,0,0,,Atau adakah proses itu lebih penting?
Dialog: 0,0:31:57.58,0:32:00.57, Lalai,,0,0,0,,INFP atau ENFJ.
Dialog: 0,0:32:04.04,0:32:06.49, Lalai,,0,0,0,,Dalam kes itu...
Dialog: 0,0:32:06.67,0:32:08.27, Lalai,,0,0,0,,Saya INFP.
Dialog: 0,0:32:08.30,0:32:11.23, Lalai,,0,0,0,,Kemudian beri dia makan pir\Nand suruh dia mengulas mengenainya.
Dialog: 0,0:32:11.26,0:32:13.78, Lalai,,0,0,0,,Mula-mula kita perlu mengalih keluar\Nvideo dia makan epal.
Dialog: 0,0:32:13.80,0:32:15.82,Lalai,,0,0,0,,Jika anda tidak mahu musuh mencuri makanan anda,
Dialog: 0,0:32:15.85,0:32:19.80,Lalai,,0,0,0,,- jangan letak meja di hadapan mereka.\N- Itu masuk akal.
Dialog: 0,0:32:20.56,0:32:22.45, Lalai,,0,0,0,,Ayah, kenapa kamu tidak angkat?
Dialog: 0,0:32:22.48,0:32:25.29, Lalai,,0,0,0,,Ia kehabisan bateri. Saya gembira anda berada di sini.
Dialog: 0,0:32:25.31,0:32:27.96, Lalai,,0,0,0,,Tanggalkan video Hae-in makan epal itu.
Dialog: 0,0:32:27.98,0:32:29.08, Lalai,,0,0,0,,Saya sudah ada.
Dialog: 0,0:32:29.11,0:32:31.38, Lalai,,0,0,0,,Itu bukan isunya. Saya ada berita buruk.
Dialog: 0,0:32:31.40,0:32:33.10, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:32:34.70,0:32:36.40, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:32:36.49,0:32:39.65,Lalai,,0,0,0,,Anda semua akan tahu akhirnya.
Dialog: 0,0:32:41.91,0:32:43.99,Lalai,,0,0,0,,Hyun-woo...
Dialog: 0,0:32:44.42,0:32:47.31,Lalai,,0,0,0,,Kebaikan. Apa yang kita buat?
Dialog: 0,0:32:47.34,0:32:48.73,Lalai,,0,0,0,,Mereka akan bercerai?
Dialog: 0,0:32:48.75,0:32:51.07,Lalai,,0,0,0,,Hyeon-tae, adakah anda mempunyai sebarang pil keresahan?
Dialog: 0,0:32:51.09,0:32:53.90, Lalai,,0,0,0,,- Sudah tentu tidak.\N- Itu bukan masalahnya.
Dialog: 0,0:32:53.93,0:32:55.53,Lalai,,0,0,0,,Dia harus mengatasinya.
Dialog: 0,0:32:55.55,0:32:58.00,Lalai,,0,0,0,,Sialan!
Dialog: 0,0:32:59.47,0:33:01.12,Lalai,,0,0,0,,Adakah ini menghiburkan anda?
Dialog: 0,0:33:01.14,0:33:05.29,Lalai,,0,0,0,,Anda lihat, saya ingin menggunakan Penyelesaian Dr. Oh dalam situasi ini.
Dialog: 0,0:33:05.31,0:33:07.87, Lalai,,0,0,0,,Ia adalah Episod 58, yang bersama Nancy Lang.
Dialog: 0,0:33:07.90,0:33:11.00,Lalai,,0,0,0,,Dr. Oh menyebut tiga langkah\Nuntuk mengatasi kesusahan dalam hidup.
Dialog: 0,0:33:11.03,0:33:12.95, Lalai,,0,0,0,,- Saya melihatnya, tetapi terlupa.\N- Langkah pertama.
Dialog: 0,0:33:12.97,0:33:14.00, Lalai,,0,0,0,,Pengakuan.
Dialog: 0,0:33:14.03,0:33:18.07, Lalai,,0,0,0,,Menilai krisis semasa dengan tepat.
Dialog: 0,0:33:18.70,0:33:21.24, Lalai,,0,0,0,,Adakah mereka menyerahkan surat cerai?
Dialog: 0,0:33:21.49,0:33:23.19,Lalai,,0,0,0,,Saya rasa tidak begitu.
Dialog: 0,0:33:23.71,0:33:25.31, Lalai,,0,0,0,,Langkah dua. Kesedaran diri.
Dialog: 0,0:33:25.33,0:33:30.58, Lalai,,0,0,0,,Ketahui betapa teruknya keadaan\Ndan sejauh mana ia boleh menjadi lebih teruk.
Dialog: 0,0:33:30.67,0:33:32.94, Lalai,,0,0,0,,Adakah terdapat sebarang artikel atau tabloid?
Dialog: 0,0:33:32.96,0:33:35.73, Lalai,,0,0,0,,Belum lagi, tetapi hanya\N menunggu masa, bukan?
Dialog: 0,0:33:35.76,0:33:37.46,Lalai,,0,0,0,,Sudah tentu.
Dialog: 0,0:33:37.76,0:33:39.82, Lalai,,0,0,0,,Dan akhir sekali, menyusunnya.
Dialog: 0,0:33:39.85,0:33:43.92,Lalai,,0,0,0,,Tentukan perkara yang akan anda tinggalkan\Nand apa yang akan anda simpan. Kemudian bertindak atasnya.
Dialog: 0,0:33:47.06,0:33:49.29,Lalai,,0,0,0,,Siapa yang mengambil berat tentang pilihan raya lagi?
Dialog: 0,0:33:49.31,0:33:51.14, Lalai,,0,0,0,,Lupakan.
Dialog: 0,0:33:51.94,0:33:54.55,Lalai,,0,0,0,,- Awak nak ke mana?\N- Mana ibu awak?
Dialog: 0,0:33:54.57,0:33:57.05, Lalai,,0,0,0,,Dia baru sahaja pergi. Saya tidak tahu ke mana dia pergi.
Dialog: 0,0:33:57.07,0:34:01.01, Lalai,,0,0,0,,Adakah anda perlu menyebut pilihan raya sekarang?
Dialog: 0,0:34:01.03,0:34:02.09,Lalai,,0,0,0,,Maaf.
Dialog: 0,0:34:02.12,0:34:04.07, Lalai,,0,0,0,,Saya INTP.
Dialog: 0,0:34:05.83,0:34:09.60,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,0:34:09.63,0:34:12.69, Lalai,,0,0,0,,Apa yang dia cakapkan?
Dialog: 0,0:34:12.71,0:34:16.19,Lalai,,0,0,0,,Ibu Hyun-woo tahu segala-galanya dan berbohong kepada kami.
Dialog: 0,0:34:16.22,0:34:20.00, Lalai,,0,0,0,,Beraninya mereka memuat naik video itu\Nof Hae-in, sedangkan dia tidak tahu apa-apa?
Dialog: 0,0:34:20.05,0:34:21.16,Lalai,,0,0,0,,Bertenang.
Dialog: 0,0:34:21.18,0:34:22.95,Lalai,,0,0,0,,Bertenang sebagai ibunya.
Dialog: 0,0:34:22.97,0:34:25.30,Lalai,,0,0,0,,Bayangkan bagaimana perasaan Hae-in.
Dialog: 0,0:34:25.89,0:34:27.49,Lalai,,0,0,0,,Seon-hwa!
Dialog: 0,0:34:27.52,0:34:28.58, Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:34:28.60,0:34:30.12,Lalai,,0,0,0,,Adakah Hyun-woo benar-benar melakukan itu?
Dialog: 0,0:34:30.15,0:34:32.71,Lalai,,0,0,0,,Anda sentiasa mempertahankan dia.
Dialog: 0,0:34:32.73,0:34:34.13, Lalai,,0,0,0,,Apa yang saya beritahu awak?
Dialog: 0,0:34:34.15,0:34:39.02, Lalai,,0,0,0,,Anda adalah seorang hakim yang lemah terhadap watak.\Tidak hairanlah anda sentiasa dikhianati.
Dialog: 0,0:34:39.20,0:34:41.19,Lalai,,0,0,0,,Jangan salahkan saya.
Dialog: 0,0:34:43.03,0:34:46.82,Lalai,,0,0,0,,Anda akan sentiasa ditipu jika\Tiada seseorang berazam untuk menipu anda.
Dialog: 0,0:34:47.79,0:34:49.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa saya tidak perlu memberitahu sesiapa?{\c}{\i0}
Dialog: 0,0:34:49.48,0:34:51.66, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Awek itu telah\Nmenipu kami selama lebih 20 tahun!{\c}{\i0}
Dialog: 0,0:34:51.68,0:34:52.73, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tepat sekali.{\c}{\i0}
Dialog: 0,0:34:52.75,0:34:55.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itu membuktikan betapa ganasnya dia.{\c}{\i0}
Dialog: 0,0:34:55.55,0:34:57.57,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jika anda tidak mempunyai bukti,{\c}{\i0}
Dialog: 0,0:34:57.59,0:35:00.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dia hanya akan menafikannya dan menjadikan anda bodoh.{\c}{\i0}
Dialog: 0,0:35:00.05,0:35:03.99,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mari kita bersabar. Dia mempunyai seorang anak lelaki,\Njadi dia mesti menghantar wang kepadanya.{\c}{\i0}
Dialog: 0,0:35:04.01,0:35:05.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mari kita cari dia dahulu.{\c}{\i0}
Dialog: 0,0:35:05.31,0:35:08.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sementara itu, kawal perasaan marah anda.{\c}{\i0}
Dialog: 0,0:35:08.48,0:35:10.34, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda mesti.{\c}{\i0}
Dialog: 0,0:35:15.36,0:35:19.05,Lalai,,0,0,0,,Saya tidak akan dapat mengaitkannya,\Nmemandangkan saya bukan seorang ibu,
Dialog: 0,0:35:19.07,0:35:23.36,Lalai,,0,0,0,,tetapi sekali lagi, saya rasa perkara yang sama berlaku untuk anda.
Dialog: 0,0:35:26.08,0:35:28.70,Lalai,,0,0,0,,Anda tidak perlu menjadi seorang ibu untuk berhubung.
Dialog: 0,0:35:28.75,0:35:30.64, Lalai,,0,0,0,,Saya boleh bayangkan perasaan dia.
Dialog: 0,0:35:30.67,0:35:33.31,Lalai,,0,0,0,,Namun, fikir dua kali tentang perceraian itu.
Dialog: 0,0:35:33.33,0:35:34.52,Lalai,,0,0,0,,Saya tahu masa telah berubah,
Dialog: 0,0:35:34.54,0:35:37.86,Lalai,,0,0,0,,tetapi Hae-in akan lebih menderita\Ndaripada dia jika mereka bercerai.
Dialog: 0,0:35:37.88,0:35:39.83, Lalai,,0,0,0,,Ambil dia, sebagai contoh.
Dialog: 0,0:35:41.97,0:35:43.11, Lalai,,0,0,0,,Kenapa awak pandang saya?
Dialog: 0,0:35:43.14,0:35:46.20,Lalai,,0,0,0,,Berbeza dengan bekas suaminya\Nyang semuanya gembira berkahwin semula,
Dialog: 0,0:35:46.22,0:35:47.87,Lalai,,0,0,0,,Beom-ja masih bujang.
Dialog: 0,0:35:47.89,0:35:49.12, Lalai,,0,0,0,,Apa yang anda maksudkan?
Dialog: 0,0:35:49.14,0:35:51.16,Lalai,,0,0,0,,Saya juga segera berkahwin semula.
Dialog: 0,0:35:51.19,0:35:53.72,Lalai,,0,0,0,,Dan anda bercerai dengan cepat.
Dialog: 0,0:35:55.27,0:35:58.21,Lalai,,0,0,0,,Seon-hwa, itu bukan masalahnya sekarang.
Dialog: 0,0:35:58.23,0:35:59.96, Lalai,,0,0,0,,Di manakah Hae-in? Apa yang dia buat?
Dialog: 0,0:35:59.99,0:36:03.90,Lalai,,0,0,0,,Aduh, dia sudah bergelut seperti sediakala.
Dialog: 0,0:36:04.49,0:36:08.69,Lalai,,0,0,0,,Dia sudah bergelut?\NIAda sesuatu yang berlaku dengan dia?
Dialog: 0,0:36:09.00,0:36:10.10, Lalai,,0,0,0,,No.
Dialog: 0,0:36:10.12,0:36:13.82, Lalai,,0,0,0,,Dia hanya gila kerja.
Dialog: 0,0:36:15.00,0:36:17.10, Lalai,,0,0,0,,Dia perlu mengambil nafas. sial.
Dialog: 0,0:36:17.13,0:36:18.83, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:36:19.13,0:36:21.37, Lalai,,0,0,0,,Apa yang dia cakap?
Dialog: 0,0:37:09.64,0:37:12.28,Lalai,,0,0,0,,Ada. Saya juga menandatanganinya,
Dialog: 0,0:37:12.31,0:37:16.72,Lalai,,0,0,0,,tetapi terpulang kepada saya bila dan bagaimana saya akan menyerahkannya.
Dialog: 0,0:37:17.69,0:37:19.64,Lalai,,0,0,0,,Okey.
Dialog: 0,0:37:20.32,0:37:22.00, Lalai,,0,0,0,,Saya akhirnya dapat memahami mengapa...
Dialog: 0,0:37:22.03,0:37:24.67,Lalai,,0,0,0,,makcik saya memukul bekas suaminya\Nsehingga sebelum bercerai.
Dialog: 0,0:37:24.70,0:37:28.65, Lalai,,0,0,0,,Saya akan mengupah peguam yang lebih cekap daripada dia.
Dialog: 0,0:37:28.90,0:37:30.51, Lalai,,0,0,0,,Anda tidak akan meninggalkan rumah ini tanpa sebarang kecederaan.
Dialog: 0,0:37:30.53,0:37:33.20,Lalai,,0,0,0,,Anda akan ditendang keluar tanpa belas kasihan.
Dialog: 0,0:37:34.37,0:37:36.16,Lalai,,0,0,0,,Okey.
Dialog: 0,0:37:37.12,0:37:38.91, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:37:47.43,0:37:50.71,Lalai,,0,0,0,,Tetapi tolong jaga jarak\N anda dari Yoon Eun-sung.
Dialog: 0,0:37:53.31,0:37:54.28, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:37:54.31,0:37:57.62,Lalai,,0,0,0,,Dia tidak berhubung untuk masa yang lama\N kemudian tiba-tiba muncul.
Dialog: 0,0:37:57.65,0:38:00.75,Lalai,,0,0,0,,Kemudian dia menghadiahkan Soo-cheol\Nand anda pelaburan yang besar,
Dialog: 0,0:38:00.77,0:38:02.75, Lalai,,0,0,0,,dan perjanjian Hercyna.
Dialog: 0,0:38:02.78,0:38:04.04, Lalai,,0,0,0,,Dia mesti ada motif.
Dialog: 0,0:38:04.07,0:38:06.73, Lalai,,0,0,0,,- Dia juga curiga.\N- Macam mana?
Dialog: 0,0:38:08.99,0:38:12.18, Lalai,,0,0,0,,Terdapat rakaman dashcam\Nof insiden tempat memburu.
Dialog: 0,0:38:12.20,0:38:14.81,Lalai,,0,0,0,,Saya memberikan kad SD kepada\Ndata-syarikat pemulihan.
Dialog: 0,0:38:14.83,0:38:18.24,Lalai,,0,0,0,,En. Yoon melawat mereka,\Nand pemiliknya telah hilang.
Dialog: 0,0:38:21.88,0:38:25.82,Lalai,,0,0,0,,Jadi? Bagaimanakah ia membuktikan sesuatu?
Dialog: 0,0:38:25.84,0:38:28.53, Lalai,,0,0,0,,Dia boleh jadi pelanggan lain,
Dialog: 0,0:38:28.55,0:38:31.03, Lalai,,0,0,0,, dan walaupun dia mempunyai sesuatu di lengan bajunya,
Dialog: 0,0:38:31.05,0:38:33.03, Lalai,,0,0,0,,dia tidak akan menipu saya semudah itu.
Dialog: 0,0:38:33.06,0:38:34.76, Lalai,,0,0,0,,Tetapi saya lakukan.
Dialog: 0,0:38:41.15,0:38:43.52,Lalai,,0,0,0,,Cuma jangan buat kesilapan yang sama.
Dialog: 0,0:39:07.55,0:39:10.49,Lalai,,0,0,0,,Kami telah menyediakan pain\Nbubur cendawan untuk sarapan pagi.
Dialog: 0,0:39:10.51,0:39:12.50, Lalai,,0,0,0,,- Adakah anda mahukan?\N- Tidak.
Dialog: 0,0:39:12.80,0:39:14.50,Lalai,,0,0,0,,Saya mahu daging lembu.
Dialog: 0,0:40:16.20,0:40:19.49,Lalai,,0,0,0,,Pn. Kalung berlian Hong membutakan saya.
Dialog: 0,0:40:20.00,0:40:22.52, Lalai,,0,0,0,,Kami mempunyai burung merak pada umumnya.
Dialog: 0,0:40:22.54,0:40:24.78,Lalai,,0,0,0,,- Bersiap sedia.\N- Ya, puan.
Dialog: 0,0:40:25.13,0:40:26.94, Lalai,,0,0,0,,Maaf, tapi burung merak apa?
Dialog: 0,0:40:26.96,0:40:29.36,Lalai,,0,0,0,,Betul. Anda seorang pemula di sini.
Dialog: 0,0:40:29.38,0:40:30.82,Lalai,,0,0,0,,Bagaimanakah rupa Cik Hong?
Dialog: 0,0:40:30.84,0:40:31.82, Lalai,,0,0,0,, Cantik.
Dialog: 0,0:40:31.84,0:40:33.54, Lalai,,0,0,0,,Itu benar.
Dialog: 0,0:40:35.09,0:40:37.11, Lalai,,0,0,0,,Baiklah, ingat ini sahaja.
Dialog: 0,0:40:37.14,0:40:39.32,Lalai,,0,0,0,,Semakin kecewa dia, semakin cantik dia berpakaian.
Dialog: 0,0:40:39.35,0:40:42.79,Lalai,,0,0,0,,Dia kelihatan seperti burung merak yang hebat hari ini.
Dialog: 0,0:40:42.81,0:40:45.04, Lalai,,0,0,0,,Maknanya kita semua mati.
Dialog: 0,0:40:45.06,0:40:46.62, Lalai,,0,0,0,,Kemudian apa yang perlu kita lakukan?
Dialog: 0,0:40:46.65,0:40:48.29, Lalai,,0,0,0,,Ada...
Dialog: 0,0:40:48.32,0:40:49.75,Lalai,,0,0,0,,{\i1}tiada penyelesaian.{\i0}
Dialog: 0,0:40:49.78,0:40:55.19,Lalai,,0,0,0,,{\i1}Bencana alam dan kemurungan Cik Hong\Nare dua perkara yang tidak dapat dikawal oleh manusia.{\i0}
Dialog: 0,0:41:01.20,0:41:03.77,Lalai,,0,0,0,,Aduh, maafkan saya!
Dialog: 0,0:41:03.79,0:41:05.64, Lalai,,0,0,0,,Saya akan mencetak semula dokumen ini dan...
Dialog: 0,0:41:05.67,0:41:07.70,Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:41:08.44,0:41:09.50,Lalai,,0,0,0,,Maaf?
Dialog: 0,0:41:09.53,0:41:10.56, Lalai,,0,0,0,,Apa yang awak buat...?
Dialog: 0,0:41:10.59,0:41:13.19,Lalai,,0,0,0,,Tidak mengapa. Ia bukan situasi hidup atau mati.
Dialog: 0,0:41:13.22,0:41:15.24, Lalai,,0,0,0,,Jangan berasa sedih kerana tertumpah.
Dialog: 0,0:41:15.26,0:41:17.92,Lalai,,0,0,0,,Tidak mengapa. Awak boleh pergi.
Dialog: 0,0:41:18.64,0:41:21.84,Lalai,,0,0,0,,Pn. Hong, adakah anda sangat kecewa?
Dialog: 0,0:41:22.52,0:41:27.16,Lalai,,0,0,0,,Tidak, saya ada sesuatu yang lebih membuat saya marah.
Dialog: 0,0:41:27.19,0:41:29.10, Lalai,,0,0,0,,Ini bukan apa-apa.
Dialog: 0,0:41:29.23,0:41:30.38,Lalai,,0,0,0,,Lihat.
Dialog: 0,0:41:30.40,0:41:35.52,Lalai,,0,0,0,,Laporan ceroboh ini pun...
Dialog: 0,0:41:36.28,0:41:38.40,Lalai,,0,0,0,,tidak membuat saya marah.
Dialog: 0,0:41:41.95,0:41:44.06, Lalai,,0,0,0,,Dia sangat menakutkan, walaupun tidak marah.
Dialog: 0,0:41:44.08,0:41:47.12, Lalai,,0,0,0,,Saya tertanya-tanya apa yang dia marah.
Dialog: 0,0:41:49.54,0:41:51.81, Lalai,,0,0,0,,Kami daripada pasukan audit.
Dialog: 0,0:41:51.84,0:41:53.69,Lalai,,0,0,0,,Kami sedang menjalankan siasatan...
Dialog: 0,0:41:53.71,0:41:57.17, Lalai,,0,0,0,,selepas menerima laporan tentang\Npenggunaan perbelanjaan yang menyalahi undang-undang.
Dialog: 0,0:41:57.76,0:41:59.63, Lalai,,0,0,0,,Sila berdiri.
Dialog: 0,0:41:59.85,0:42:02.42, Lalai,,0,0,0,,Jangan carik sebarang dokumen.
Dialog: 0,0:42:03.18,0:42:05.55, Lalai,,0,0,0,,Jangan musnahkan atau gerakkan apa-apa.
Dialog: 0,0:42:17.99,0:42:20.63, Lalai,,0,0,0,, Astaga, ini adalah pertumpahan darah.
Dialog: 0,0:42:20.66,0:42:22.93, Lalai,,0,0,0,,Adakah Pertempuran Hong-Baek bermula sekali lagi?
Dialog: 0,0:42:22.95,0:42:24.26, Lalai,,0,0,0,,Ini akan menjadi bencana.
Dialog: 0,0:42:24.29,0:42:26.36,Lalai,,0,0,0,,Jom.
Dialog: 0,0:42:33.84,0:42:36.11, Lalai,,0,0,0,,- Semuanya?\N- Ya.
Dialog: 0,0:42:36.13,0:42:37.78, Lalai,,0,0,0,,- Anda akan menolaknya?\N- Ya.
Dialog: 0,0:42:37.80,0:42:40.49,Lalai,,0,0,0,,Tetapi anda sudah mengesahkan\Nnya sebelum pergi ke Jerman.
Dialog: 0,0:42:40.51,0:42:42.34, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:42:43.18,0:42:44.74,Lalai,,0,0,0,,- Semuanya?\N- Ya.
Dialog: 0,0:42:44.77,0:42:46.49,Lalai,,0,0,0,,Dia menolak kesemuanya.
Dialog: 0,0:42:46.52,0:42:48.54, Lalai,,0,0,0,,Ia biasanya berlangsung seminggu.
Dialog: 0,0:42:48.56,0:42:51.33, Lalai,,0,0,0,, Tempohnya bukan masalah kali ini.
Dialog: 0,0:42:51.36,0:42:53.64, Lalai,,0,0,0,,Keamatan berada pada tahap yang lain.
Dialog: 0,0:42:53.69,0:42:55.84, Lalai,,0,0,0,,Apa yang berlaku di Jerman?
Dialog: 0,0:42:55.86,0:42:57.84,Lalai,,0,0,0,,Mari kita kongsi jadual mereka.
Dialog: 0,0:42:57.86,0:42:59.98,Lalai,,0,0,0,,Jangan biarkan mereka bertembung antara satu sama lain.
Dialog: 0,0:43:00.53,0:43:03.51,Lalai,,0,0,0,,Apa? Mesyuarat makan tengah hari. Kami juga menikmati sushi di J Hotel.
Dialog: 0,0:43:03.53,0:43:06.60, Lalai,,0,0,0,,Tukarnya. Saya akan mengikut\Njadual anda untuk menaiki lif.
Dialog: 0,0:43:06.62,0:43:07.85,Lalai,,0,0,0,,Okey.
Dialog: 0,0:43:07.87,0:43:10.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:43:18.38,0:43:19.97,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Queens Department Store Inc.{\c}{\i0}
Dialog: 0,0:43:19.99,0:43:23.12,Lalai,,0,0,0,,"Kami telah menyemak kontrak\Nuntuk kedai yang akan ditutup tidak lama lagi,"
Dialog: 0,0:43:23.15,0:43:24.14, Lalai,,0,0,0,,"jadi anda boleh meneruskan."
Dialog: 0,0:43:24.17,0:43:27.03, Lalai,,0,0,0,,"Kami telah membincangkan perkara ini,\Njadi anda tidak boleh mengubahnya."
Dialog: 0,0:43:27.06,0:43:30.04, Lalai,,0,0,0, "Anda perlu membayar tiga kali ganda\Nyuran penalti jika anda berbuat demikian."
Dialog: 0,0:43:30.06,0:43:31.76, Lalai,,0,0,0,,"Sila luluskan, supaya kami boleh meneruskan."
Dialog: 0,0:43:31.78,0:43:33.77, Lalai,,0,0,0,"Selamat tinggal, kalau begitu."
Dialog: 0,0:43:35.36,0:43:37.31,Lalai,,0,0,0,,Itu dia cakap.
Dialog: 0,0:43:39.07,0:43:42.67, Lalai,,0,0,0,,"Pasukan undang-undang boleh menguruskan\Nisu penalti. Saya tidak boleh meluluskan ini."
Dialog: 0,0:43:42.70,0:43:44.68,Lalai,,0,0,0,, "Sepatutnya kamu tidak muncul..."
Dialog: 0,0:43:44.70,0:43:47.51,Lalai,,0,0,0,,"dengan senario berbeza\Mengenai isu yang mungkin berlaku,"
Dialog: 0,0:43:47.54,0:43:50.66, Lalai,,0,0,0,,"jalankan simulasi, dan kemudian\Nlaporkan kepada saya? Sekali lagi."
Dialog: 0,0:43:51.17,0:43:53.16, Lalai,,0,0,0,,Itulah yang dia katakan.
Dialog: 0,0:43:54.13,0:43:56.79, Lalai,,0,0,0,,- Sungguh bersemangat.\N- Maaf?
Dialog: 0,0:43:57.76,0:43:59.46, Lalai,,0,0,0,,Tak kisah.
Dialog: 0,0:43:59.63,0:44:02.28,Lalai,,0,0,0,,Bukankah kita makan sushi di Hotel J hari ini?
Dialog: 0,0:44:02.30,0:44:04.09,Lalai,,0,0,0,,Jom.
Dialog: 0,0:44:05.47,0:44:08.05, Lalai,,0,0,0,,Bagaimana pula dengan restoran Cina?
Dialog: 0,0:44:08.43,0:44:10.04, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:44:10.06,0:44:12.83, Lalai,,0,0,0,,Kos yang tinggi untuk kita semua\Nuntuk mendapatkan sushi {\i1}omakase.{\i0}
Dialog: 0,0:44:12.85,0:44:16.47,Lalai,,0,0,0,,Tidak mengapa. Ini hadiah saya.
Dialog: 0,0:44:16.94,0:44:19.48,Lalai,,0,0,0,,Saya tahu betapa gigihnya awak bekerja.
Dialog: 0,0:44:21.07,0:44:23.26,Lalai,,0,0,0,,Biar bahasa Cina, tuan.
Dialog: 0,0:44:23.28,0:44:26.22,Lalai,,0,0,0,,Set makan tengah hari masam manis\Npork mereka sedap.
Dialog: 0,0:44:26.24,0:44:27.68, Lalai,,0,0,0,,Kenapa tiba-tiba?
Dialog: 0,0:44:27.70,0:44:29.68, Lalai,,0,0,0,,Adakah sebab lain?
Dialog: 0,0:44:29.70,0:44:31.97, Lalai,,0,0,0,,Tidak, tidak sama sekali.
Dialog: 0,0:44:32.00,0:44:34.82, Lalai,,0,0,0,,Mereka semua lebih suka menggunakan bahasa Cina.
Dialog: 0,0:44:39.67,0:44:41.11,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ada apa dengan muka Encik Kim?{\c}{\i0}
Dialog: 0,0:44:41.13,0:44:43.23,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia akan membunuh kita jika kita memilih sushi.{\c}{\i0}
Dialog: 0,0:44:43.26,0:44:46.24,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya pasti ini kerana Cik Hong akan pergi ke sana.{\c}{\i0}
Dialog: 0,0:44:46.26,0:44:49.03,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya rasa Encik Baek menangkapnya.\NI fikir dia suka{\i0} jajangmyeon.{\c}
Dialog: 0,0:44:49.06,0:44:50.24,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini menghiburkan.{\c}{\i0}
Dialog: 0,0:44:50.27,0:44:53.41,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Saya tidak kisah apa yang kita ada.\NI cuma mahu melihat orang kaya bertengkar.{\c}{\i0}
Dialog: 0,0:44:53.44,0:44:54.44,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Saya juga saya juga{\c}{\i0}
Dialog: 0,0:44:57.40,0:44:59.21,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Owl telah bertukar kepada bahasa Cina.{\c}{\i0}
Dialog: 0,0:44:59.23,0:45:02.98, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baik. Helang itu menuju ke\N lif di Bangunan A.{\c}{\i0}
Dialog: 0,0:45:04.61,0:45:07.19,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Owl menuju ke Bangunan B.{\c}{\i0}
Dialog: 0,0:45:11.91,0:45:14.70, Lalai,,0,0,0,,Sudah lewat. Jom ke Bangunan B.
Dialog: 0,0:45:15.04,0:45:17.53, Lalai,,0,0,0,,Tetapi ia akan tiba tidak lama lagi.
Dialog: 0,0:45:18.00,0:45:21.62,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Helang telah menukar haluan.\NMendekati Bangunan B dalam masa tiga minit.{\c}{\i0}
Dialog: 0,0:45:25.09,0:45:27.09, Lalai,,0,0,0,, Patutkah kita berjalan?
Dialog: 0,0:45:27.18,0:45:30.84,Lalai,,0,0,0,,- Sangat sihat untuk menaiki tangga.\N- Tidak jika anda akan turun.
Dialog: 0,0:45:36.15,0:45:37.12,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kecemasan.{\c}{\i0}
Dialog: 0,0:45:37.15,0:45:40.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Cik. Hong akan datang ke sini! Bantuan!{\c}{\i0}
Dialog: 0,0:45:50.33,0:45:52.65, Lalai,,0,0,0,,Saya juga berada dalam bilik sembang.
Dialog: 0,0:45:54.46,0:45:56.36,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:46:06.30,0:46:08.61, Lalai,,0,0,0,,Kamu mesti makan di luar bersama.
Dialog: 0,0:46:08.64,0:46:10.57, Lalai,,0,0,0,,Anda tidak perlu melakukan banyak perkara.
Dialog: 0,0:46:10.60,0:46:13.20,Lalai,,0,0,0,,Saya merawat mereka, kerana\Nmereka mempunyai banyak kerja.
Dialog: 0,0:46:13.22,0:46:14.45, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:46:14.48,0:46:15.99,Lalai,,0,0,0,,Anda sepatutnya melakukan yang lebih baik,
Dialog: 0,0:46:16.02,0:46:18.58, Lalai,,0,0,0,, dan semasa anda melakukannya,\Beri saya laporan analisis...
Dialog: 0,0:46:18.60,0:46:20.26, Lalai,,0,0,0,,pada kes yang anda telah berulang kali hilang...
Dialog: 0,0:46:20.28,0:46:23.94, Lalai,,0,0,0,,dalam tiga tahun lalu,\Nand ketahui cara untuk menambah baik.
Dialog: 0,0:46:24.32,0:46:25.71,Lalai,,0,0,0,,Ya, puan,
Dialog: 0,0:46:25.74,0:46:28.01, Lalai,,0,0,0,,tetapi apabila anda menyemaknya,
Dialog: 0,0:46:28.03,0:46:31.51,Lalai,,0,0,0,,Saya harap anda tinggalkan sebarang\Nperasaan peribadi yang anda miliki.
Dialog: 0,0:46:31.53,0:46:32.93, Lalai,,0,0,0,,Saya rasa anda tidak tahu.
Dialog: 0,0:46:32.95,0:46:34.35, Lalai,,0,0,0,,Saya agak AI...
Dialog: 0,0:46:34.37,0:46:36.89, Lalai,,0,0,0,, apabila ia berkaitan dengan kerja,\Njadi jangan risau tentang itu.
Dialog: 0,0:46:36.91,0:46:38.60, Lalai,,0,0,0,, Betulkah? Saya tidak tahu.
Dialog: 0,0:46:38.62,0:46:39.98,Lalai,,0,0,0,,Kejahilan kamu itu...
Dialog: 0,0:46:40.00,0:46:43.41, Lalai,,0,0,0,, adalah sebab anda terus kehilangan kes tersebut.
Dialog: 0,0:47:10.74,0:47:12.63, Lalai,,0,0,0,, Patutkah kita menaiki tangga?
Dialog: 0,0:47:12.66,0:47:14.61, Lalai,,0,0,0,,- Pasti.\N- Jom.
Dialog: 0,0:47:23.46,0:47:24.56,Lalai,,0,0,0,,Adakah anda membaca berita?
Dialog: 0,0:47:24.59,0:47:26.40, Lalai,,0,0,0,,Bioteknologi baharu NSFA telah direka?
Dialog: 0,0:47:26.42,0:47:29.78,Lalai,,0,0,0,,- Kami melabur di dalamnya.\N- Adakah anda menggunakan saham anda sebagai cagaran?
Dialog: 0,0:47:29.80,0:47:32.40,Lalai,,0,0,0,,Adalah mustahil untuk mendapatkan wang secara tunai.
Dialog: 0,0:47:32.43,0:47:35.41,Lalai,,0,0,0,,{\an8}Saya juga menandatangani rampasan\Nagreement dengan bank.
Dialog: 0,0:47:35.43,0:47:37.24,Lalai,,0,0,0,,{\an8}Saya juga.
Dialog: 0,0:47:37.27,0:47:41.68,Lalai,,0,0,0,,{\an8}Bagaimana jika bank merampas saham kita?
Dialog: 0,0:47:42.15,0:47:44.14,Lalai,,0,0,0,,{\an8}Bolehkah anda menghubungi Pengarah Jo?
Dialog: 0,0:47:44.61,0:47:48.17,Lalai,,0,0,0,,Aduh, sedih melihat awak pergi.
Dialog: 0,0:47:48.19,0:47:51.46,Lalai,,0,0,0,,- Orang ramai dengan saya begitu mudah.\N- Kekal sihat.
Dialog: 0,0:47:51.49,0:47:53.22,Lalai,,0,0,0,,Anak-anak anda akan gembira melihat anda.
Dialog: 0,0:47:53.24,0:47:55.51,Lalai,,0,0,0,,Lebih-lebih lagi, kerana anda kaya sekarang.
Dialog: 0,0:47:55.53,0:47:59.06,Lalai,,0,0,0,,Saya mula semula, jadi saya\Sedang melakukan banyak kebaikan...
Dialog: 0,0:47:59.08,0:48:00.78, Lalai,,0,0,0,, dan bantu orang lain.
Dialog: 0,0:48:01.58,0:48:03.28, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:48:03.96,0:48:05.44, Lalai,,0,0,0,,Statut had...
Dialog: 0,0:48:05.46,0:48:08.44, Lalai,,0,0,0,,untuk penipuan kewangan\N$100,000 atau lebih ialah 25 tahun.
Dialog: 0,0:48:08.46,0:48:11.11, Lalai,,0,0,0,,Anda tidak boleh membantu orang lain jika anda berada di dalam penjara,
Dialog: 0,0:48:11.13,0:48:13.29,Lalai,,0,0,0,,jadi jangan terperangkap.
Dialog: 0,0:48:13.76,0:48:17.49,Lalai,,0,0,0,,Anda bertaruh. Saya akan tinggal jauh dari\NKorean pasar dan restoran.
Dialog: 0,0:48:17.51,0:48:19.38,Lalai,,0,0,0,,Saya akan hidup dengan baik.
Dialog: 0,0:48:20.73,0:48:22.43, Lalai,,0,0,0,,Selamat tinggal, kemudian.
Dialog: 0,0:48:24.73,0:48:26.71,Lalai,,0,0,0,,Sungguh bajingan.
Dialog: 0,0:48:26.73,0:48:31.23,Lalai,,0,0,0,,Bagaimana dia begitu kurang ajar, selepas menghisap\Rakan sekerjanya yang sudah lama kering?
Dialog: 0,0:48:33.11,0:48:35.77, Lalai,,0,0,0,,Selamat tinggal. Teruskan.
Dialog: 0,0:48:38.70,0:48:41.11, Lalai,,0,0,0,,Beg kotoran.
Dialog: 0,0:48:57.72,0:48:59.85,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Pusat Perubatan Universiti Sungmin{\c}{\i0}
Dialog: 0,0:49:10.82,0:49:11.94,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:49:23.54,0:49:25.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in.{\c}{\i0}
Dialog: 0,0:49:40.31,0:49:43.67, Lalai,,0,0,0,,Hubungi Pusat Perubatan Sungmin.\NI perlu menyemak sesuatu.
Dialog: 0,0:49:46.56,0:49:48.62,Lalai,,0,0,0,,Baiklah, Encik Baek.
Dialog: 0,0:49:48.65,0:49:50.75,Lalai,,0,0,0,,Bagaimana keadaan anda? Apa yang membawa anda ke sini?
Dialog: 0,0:49:50.77,0:49:53.17,Lalai,,0,0,0,,Saya ada soalan.
Dialog: 0,0:49:53.19,0:49:55.30, Lalai,,0,0,0,,Adakah anda mengenali jam tangan ini?
Dialog: 0,0:49:55.32,0:49:57.05, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:49:57.07,0:50:00.34, Lalai,,0,0,0,,Ia adalah edisi terhad untuk ulang tahun ke-101 Ronde\Nde Frédic.
Dialog: 0,0:50:00.37,0:50:02.72,Lalai,,0,0,0,,- Hanya 101 daripadanya dibuat.\N- Saya faham.
Dialog: 0,0:50:02.74,0:50:05.01, Lalai,,0,0,0,,Tetapi yang ini adalah prapesan.
Dialog: 0,0:50:05.04,0:50:06.68, Lalai,,0,0,0,,Adakah anda nampak berlian kuning ini?
Dialog: 0,0:50:06.71,0:50:11.58, Lalai,,0,0,0,,Berlian ini hanya ditambahkan pada\Ndail sepuluh jam tangan yang ditempah.
Dialog: 0,0:50:12.59,0:50:14.02,Lalai,,0,0,0,,Saya tahu banyak yang perlu ditanya,
Dialog: 0,0:50:14.05,0:50:17.42, Lalai,,0,0,0,,tetapi boleh saya tahu siapa yang membeli sepuluh jam tangan itu?
Dialog: 0,0:50:17.59,0:50:18.99, Lalai,,0,0,0,, Pasti, saya boleh membantu anda.
Dialog: 0,0:50:19.01,0:50:23.53, Lalai,,0,0,0,,Anda telah membantu ibu saya menyelesaikan\Ninsiden penyelewengan perubatan.
Dialog: 0,0:50:23.56,0:50:25.62,Lalai,,0,0,0,,Saya rapat dengan ketua pasukan HQ.
Dialog: 0,0:50:25.64,0:50:26.89, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:50:26.92,0:50:27.95, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:50:27.98,0:50:29.62, Lalai,,0,0,0,,Saya akan beralih sekarang.
Dialog: 0,0:50:29.65,0:50:30.79, Lalai,,0,0,0,,Pandang jauh ke hadapan.
Dialog: 0,0:50:30.81,0:50:32.60, Lalai,,0,0,0,,- Perlahan-lahan.\N- Bagus.
Dialog: 0,0:50:32.82,0:50:33.96, Lalai,,0,0,0,, Luruskan belakang anda.
Dialog: 0,0:50:33.98,0:50:35.50, Lalai,,0,0,0,,Pijak pedal. Itu sahaja.
Dialog: 0,0:50:35.53,0:50:38.42, Lalai,,0,0,0,,Baik, belok. Ya, perlahan-lahan.
Dialog: 0,0:50:38.45,0:50:41.34, Lalai,,0,0,0,, Perlahan-lahan. Itu bagus.
Dialog: 0,0:50:41.37,0:50:42.39, Lalai,,0,0,0,,Pusing dengan lancar.
Dialog: 0,0:50:42.41,0:50:44.14, Lalai,,0,0,0,,- Macam ni?\N- Ya, betul.
Dialog: 0,0:50:44.16,0:50:47.07, Lalai,,0,0,0,,- Anda hebat.\N- Okay.
Dialog: 0,0:50:49.25,0:50:51.48, Lalai,,0,0,0,,Anda hebat. Adakah anda benar-benar seorang pemula?
Dialog: 0,0:50:51.50,0:50:55.41, Lalai,,0,0,0,,Saya tidak memerlukan roda tambahan ini,\Ntetapi dia terus mendesak.
Dialog: 0,0:50:55.67,0:50:57.65, Lalai,,0,0,0,,Anda kenal dia, kan? Dia pemenang pingat gangsa.
Dialog: 0,0:50:57.67,0:51:00.03, Lalai,,0,0,0,,- Ya.\N- Saya patut mendengar pro.
Dialog: 0,0:51:00.05,0:51:01.99, Lalai,,0,0,0,,Semua orang menggunakan roda latihan pada mulanya.
Dialog: 0,0:51:02.01,0:51:04.99, Lalai,,0,0,0,,Saya akan terbang tanpa mereka.
Dialog: 0,0:51:05.02,0:51:06.97, Lalai,,0,0,0,, Tonton saya.
Dialog: 0,0:51:07.68,0:51:10.08, Lalai,,0,0,0,,- Saya akan pergi lebih cepat.\N- Baiklah, tetapi berehat.
Dialog: 0,0:51:10.10,0:51:11.96, Lalai,,0,0,0,, Perlahan-lahan. Itu sahaja.
Dialog: 0,0:51:11.98,0:51:13.50,Lalai,,0,0,0,,- Macam ni?\N- Betul.
Dialog: 0,0:51:13.52,0:51:15.77, Lalai,,0,0,0,, Pergi dalam garis lurus.
Dialog: 0,0:51:17.36,0:51:18.76, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:51:18.78,0:51:21.34, Lalai,,0,0,0,,Ya ampun, anakku! Soo-cheol!
Dialog: 0,0:51:21.36,0:51:23.90, Lalai,,0,0,0,,Oh, sayang!
Dialog: 0,0:51:24.12,0:51:25.26,Lalai,,0,0,0,,Anda berdarah!
Dialog: 0,0:51:25.29,0:51:27.85, Lalai,,0,0,0,,Kenapa kamu tidak menghalangnya?
Dialog: 0,0:51:27.87,0:51:29.35, Lalai,,0,0,0,,Mengapa mereka perlu?
Dialog: 0,0:51:29.37,0:51:33.69,Lalai,,0,0,0,,Nampak tak semua kotoran dan simen ini?\NKenapa awak nak tumpang sini? Ia berbahaya.
Dialog: 0,0:51:33.71,0:51:36.91, Lalai,,0,0,0,,- Jangan naik ini.\N- Ayuh, Ibu!
Dialog: 0,0:51:39.13,0:51:43.79, Lalai,,0,0,0,,Skateboard, basikal, ski,\Nrollerblades dan skuter sepak.
Dialog: 0,0:51:44.01,0:51:47.12,Lalai,,0,0,0,,Saya tidak boleh menaiki mana-mana daripadanya kerana anda.
Dialog: 0,0:51:47.14,0:51:50.70,Lalai,,0,0,0,,Anda tidak membenarkan saya menunggang curam\Ngelongsor, jadi saya tidak mempunyai pengalaman.
Dialog: 0,0:51:50.73,0:51:52.62, Lalai,,0,0,0,, Kerana anda mungkin terjatuh...
Dialog: 0,0:51:52.65,0:51:54.89,Lalai,,0,0,0,,Tepat sekali. Saya tidak pernah jatuh sebelum ini.
Dialog: 0,0:51:55.52,0:51:56.54,Lalai,,0,0,0,,Betul.
Dialog: 0,0:51:56.57,0:51:59.21, Lalai,,0,0,0,, Sekarang adakah anda faham betapa saya menyayangi anda?
Dialog: 0,0:51:59.24,0:52:01.30, Lalai,,0,0,0,,Kenapa awak mesti jatuh?
Dialog: 0,0:52:01.32,0:52:02.63, Lalai,,0,0,0,,Ibu.
Dialog: 0,0:52:02.66,0:52:04.61, Lalai,,0,0,0,,Sebagai ayahnya,
Dialog: 0,0:52:04.74,0:52:08.01,Lalai,,0,0,0,,Saya sekurang-kurangnya harus mengajar\NGeon-u cara menunggang basikal.
Dialog: 0,0:52:08.04,0:52:10.52,Lalai,,0,0,0,,Jadi hanya untuk mengajar anak anda cara menunggang?
Dialog: 0,0:52:10.54,0:52:11.60, Lalai,,0,0,0,,- Itulah sebabnya?\N- Ya.
Dialog: 0,0:52:11.62,0:52:13.45, Lalai,,0,0,0,,Saya akan ajar dia...
Dialog: 0,0:52:13.50,0:52:16.48, Lalai,,0,0,0,,cara menunggang basikal,\Nrollerblades, sepak skuter,
Dialog: 0,0:52:16.50,0:52:20.29, Lalai,,0,0,0,, papan luncur dan ski.
Dialog: 0,0:52:20.51,0:52:23.74, Lalai,,0,0,0,,Anda hanya boleh mengupah seseorang untuk mengajarnya.
Dialog: 0,0:52:23.76,0:52:26.74, Lalai,,0,0,0,,Mengapa anda meletakkan diri anda dalam bahaya seperti itu?
Dialog: 0,0:52:26.76,0:52:30.03, Lalai,,0,0,0,,Ayah sepatutnya mengajar\Nanak mereka perkara ini.
Dialog: 0,0:52:30.06,0:52:31.76, Lalai,,0,0,0,,Saya akan mulakan.
Dialog: 0,0:52:32.14,0:52:34.75, Lalai,,0,0,0,,- Baiklah.\N- Tidak, Soo-cheol. Anda akan jatuh.
Dialog: 0,0:52:34.77,0:52:37.92,Lalai,,0,0,0,,- Soo-cheol...\N- Encik Kim, alihkan kereta!
Dialog: 0,0:52:37.94,0:52:40.09,Lalai,,0,0,0,,- Ibu, jom.\N- Turun.
Dialog: 0,0:52:40.11,0:52:42.84, Lalai,,0,0,0,,Alihkan kereta, atau saya akan merempuhnya.
Dialog: 0,0:52:42.86,0:52:43.88, Lalai,,0,0,0,,Helo?
Dialog: 0,0:52:43.91,0:52:46.13,Lalai,,0,0,0,,{\i1}Helo, ini Kevin dari Manhattan.{\i0}
Dialog: 0,0:52:46.16,0:52:47.13, Lalai,,0,0,0,,Helo.
Dialog: 0,0:52:47.16,0:52:51.86, Lalai,,0,0,0,,{\i1}Ini mengenai Upper West Side\Napartment. Pemiliknya mahu menjualnya.{\i0}
Dialog: 0,0:52:55.17,0:52:56.48, Lalai,,0,0,0,,Bagus.
Dialog: 0,0:52:56.50,0:53:00.86, Lalai,,0,0,0,,{\i1}Kemudian saya akan meneruskan. Kontrak akan\N sah sehingga akhir bulan.{\i0}
Dialog: 0,0:53:00.88,0:53:02.94,Lalai,,0,0,0,,{\i1}Adakah anda akan berada di sini pada masa itu?{\i0}
Dialog: 0,0:53:02.97,0:53:06.38,Lalai,,0,0,0,,{\i1}Anda perlu menandatanganinya sendiri.{\i0}
Dialog: 0,0:53:09.68,0:53:11.91, Lalai,,0,0,0,,Saya akan sampai dalam dua minggu.
Dialog: 0,0:53:11.93,0:53:14.91,Lalai,,0,0,0,,Puan, ada sesuatu\Agak saya dapat tahu tentang Encik Baek.
Dialog: 0,0:53:14.94,0:53:16.29, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:53:16.31,0:53:19.92, Lalai,,0,0,0,,Dia terus memanggil\Nnama perempuan di taman atas bumbung.
Dialog: 0,0:53:19.94,0:53:21.64,Lalai,,0,0,0,,Nama perempuan?
Dialog: 0,0:53:35.58,0:53:37.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Yeong-suk.{\c}{\i0}
Dialog: 0,0:53:42.96,0:53:44.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Yeong-suk?{\c}{\i0}
Dialog: 0,0:53:48.60,0:53:50.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Yeong...{\c}{\i0}
Dialog: 0,0:53:55.39,0:53:58.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Keluar jika anda berada di sini.{\c}{\i0}
Dialog: 0,0:53:58.48,0:54:00.77,Lalai,,0,0,0,,{\i1}Nama dia Yeong-suk.{\i0}
Dialog: 0,0:54:02.57,0:54:05.88, Lalai,,0,0,0,,- Itu?\N- Dia terus menyuruhnya keluar.
Dialog: 0,0:54:05.90,0:54:07.72, Lalai,,0,0,0,,Lupakan.
Dialog: 0,0:54:07.74,0:54:10.52, Lalai,,0,0,0,,Saya mengenali nama itu.
Dialog: 0,0:54:11.49,0:54:13.24,Lalai,,0,0,0,,Ya, puan.
Dialog: 0,0:54:41.90,0:54:43.83, Lalai,,0,0,0,,Adakah anda menemui apa-apa?
Dialog: 0,0:54:43.86,0:54:47.13, Lalai,,0,0,0,,Kami sentiasa memerhatikan\NMr. Baek sepanjang masa sejak kebelakangan ini.
Dialog: 0,0:54:47.15,0:54:51.44, Lalai,,0,0,0,,Inilah yang dia lakukan setiap jam.
Dialog: 0,0:54:52.87,0:54:55.72,Lalai,,0,0,0,,Tempat yang dia pergi bukan tipikal.
Dialog: 0,0:54:55.75,0:54:57.99, Lalai,,0,0,0,,Apa yang dia buat?
Dialog: 0,0:54:59.50,0:55:00.85,Lalai,,0,0,0,,Apa? "Besbol syiling"?
Dialog: 0,0:55:00.88,0:55:02.85, Lalai,,0,0,0,,Ya, lima bola untuk 50 sen.
Dialog: 0,0:55:02.88,0:55:04.77, Lalai,,0,0,0,,Dia selalu pergi ke sana selepas kerja.
Dialog: 0,0:55:04.80,0:55:06.62, Lalai,,0,0,0,,- Dengan siapa?\N- Sendirian.
Dialog: 0,0:55:13.43,0:55:15.87, Lalai,,0,0,0,,Lupakan. Seterusnya.
Dialog: 0,0:55:15.89,0:55:17.33, Lalai,,0,0,0,,Apa itu "Masakan Rumah Nenek"?
Dialog: 0,0:55:17.35,0:55:20.12, Lalai,,0,0,0,,Mereka menjual makanan yang dimasak di rumah.\Dia makan malam di sana setiap hari.
Dialog: 0,0:55:20.15,0:55:21.85, Lalai,,0,0,0,,- Dengan siapa?\N- Sendirian.
Dialog: 0,0:55:27.11,0:55:29.76,Lalai,,0,0,0,,{\i1}Saya mencuba makanan mereka untuk tujuan penyelidikan.{\i0}
Dialog: 0,0:55:29.78,0:55:33.05, Lalai,,0,0,0,,Sedap. Saya juga akan pergi ke sana seorang diri.
Dialog: 0,0:55:33.07,0:55:35.68, Lalai,,0,0,0,,Mengapa dia bertindak kasihan dan makan sendirian?
Dialog: 0,0:55:35.70,0:55:38.03, Lalai,,0,0,0,,Dia sentiasa boleh makan di rumah.
Dialog: 0,0:55:39.41,0:55:42.18, Lalai,,0,0,0,,Bagaimana dengan dua hari lalu?\Ndia pulang ke rumah pada tengah malam.
Dialog: 0,0:55:42.21,0:55:45.02,Lalai,,0,0,0,,Betul. Dia menikmati sedikit daging babi {\i1}bulgogi...{\i0}
Dialog: 0,0:55:45.05,0:55:47.61, Lalai,,0,0,0,,di Masakan Rumah Nenek untuk makan malam,
Dialog: 0,0:55:47.63,0:55:49.72,Lalai,,0,0,0,,membeli dua botol air di kedai serbaneka,
Dialog: 0,0:55:49.74,0:55:51.78, Lalai,,0,0,0,, dan pergi ke sekolah rendah berdekatan.
Dialog: 0,0:55:51.80,0:55:54.86, Lalai,,0,0,0,,Pada jam itu? Adakah ia satu pertemuan rahsia?
Dialog: 0,0:55:54.89,0:55:56.59, Lalai,,0,0,0,,Tidak, dia bersendirian.
Dialog: 0,0:55:56.97,0:55:59.68, Lalai,,0,0,0,,- Apa yang dia buat di sana seorang diri?\N- Dia berlari.
Dialog: 0,0:56:00.31,0:56:01.75, Lalai,,0,0,0,,- Dia lari?\N- Ya.
Dialog: 0,0:56:01.77,0:56:05.12,Lalai,,0,0,0,,Anda tahu guru menghukum\Npelajar mereka dengan membuat mereka melakukan pusingan.
Dialog: 0,0:56:05.15,0:56:07.84, Lalai,,0,0,0,,Itulah yang dia lakukan.
Dialog: 0,0:56:07.86,0:56:09.25, Lalai,,0,0,0,,- Untuk apa?\N- Mengalahkan saya.
Dialog: 0,0:56:09.28,0:56:14.22,Lalai,,0,0,0,,Ia bukan seorang atlet,\Ntetapi dia juga menyanyi dan menjerit.
Dialog: 0,0:56:14.24,0:56:16.05, Lalai,,0,0,0,,Saya agak ketakutan.
Dialog: 0,0:56:16.08,0:56:18.07, Lalai,,0,0,0,,Adakah anda ingin melihat?
Dialog: 0,0:56:27.59,0:56:33.94,Lalai,,0,0,0,,♫ {\i1}Jangan tanya saya mengapa saya pergi{\i0} ♫
Dialog: 0,0:56:33.97,0:56:35.78,Lalai,,0,0,0,,♫ {\i1}Saya{\i0} ♫
Dialog: 0,0:56:35.80,0:56:39.41,Lalai,,0,0,0,,♫ {\i1}bodohnya{\i0} ♫
Dialog: 0,0:56:39.43,0:56:40.79,Lalai,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:56:40.81,0:56:43.72, Lalai,,0,0,0,,Saya dah cakap, tuan. Dia bukan tipikal.
Dialog: 0,0:56:43.90,0:56:46.21,Lalai,,0,0,0,,Dia bertemu dengan seekor kucing terbiar dalam perjalanan pulang.
Dialog: 0,0:56:46.23,0:56:48.79,Lalai,,0,0,0,,{\i1}Dia bertanya khabar dan memberikannya snek.{\i0}
Dialog: 0,0:56:48.82,0:56:50.42,Lalai,,0,0,0,,{\i1}Saya tidak sangka perempuan simpanan,{\i0}
Dialog: 0,0:56:50.44,0:56:52.42, Lalai,,0,0,0,,tetapi saya menjangkakan untuk melihat beberapa taikun.
Dialog: 0,0:56:52.45,0:56:54.13, Lalai,,0,0,0,,Adakah anda melakukan kerja anda dengan betul?
Dialog: 0,0:56:54.16,0:56:56.93,Lalai,,0,0,0,,Saya tidak mahu bermegah, tetapi anda lihat...
Dialog: 0,0:56:56.95,0:57:00.60,Lalai,,0,0,0,,Saya sangat cekap, saya boleh mencari\Na sasaran walaupun di Korea Utara.
Dialog: 0,0:57:00.62,0:57:03.53, Lalai,,0,0,0,,Itu benar. Dia sangat tabah.
Dialog: 0,0:57:03.83,0:57:05.48, Lalai,,0,0,0,,Sebagai pengarah undang-undang Queens,
Dialog: 0,0:57:05.50,0:57:08.44, Lalai,,0,0,0,,satu-satunya pertemuannya dengan kucing?
Dialog: 0,0:57:08.46,0:57:09.98,Lalai,,0,0,0,,Ini Aeong.
Dialog: 0,0:57:10.00,0:57:11.90,Lalai,,0,0,0,,- Apa itu?\N- Nama kucing.
Dialog: 0,0:57:11.92,0:57:14.07,Lalai,,0,0,0,,Ia paling ganas\Ncat di kawasan kejiranan ini,
Dialog: 0,0:57:14.09,0:57:16.53,Lalai,,0,0,0,,tetapi dia menamakannya, dan ia mendengarnya.
Dialog: 0,0:57:16.55,0:57:20.99, Lalai,,0,0,0,,Saya juga mengupah bekas-CSI\Nhacker untuk menggodam telefonnya.
Dialog: 0,0:57:21.02,0:57:23.84, Lalai,,0,0,0,,Terdapat banyak foto Aeong.
Dialog: 0,0:57:31.86,0:57:34.80, Lalai,,0,0,0,,Pelik, kan? Kami fikir perkara yang sama.
Dialog: 0,0:57:34.82,0:57:38.93,Lalai,,0,0,0,,Lelaki jenis apakah yang mengambil gambar yang begitu cantik\Tentang wanitanya yang ingin diceraikannya?
Dialog: 0,0:57:38.95,0:57:43.31,Lalai,,0,0,0,,Jika anda melihat dengan teliti,\Nfoto ini membuatkan kakinya kelihatan panjang.
Dialog: 0,0:57:43.33,0:57:45.98, Lalai,,0,0,0,,Foto ini memerlukan banyak penumpuan.
Dialog: 0,0:57:46.00,0:57:48.28,Lalai,,0,0,0,,- Ini cinta sejati.\N- Sama sekali.
Dialog: 0,0:57:58.55,0:58:02.53,Lalai,,0,0,0,,Saya tidak fikir dia mempunyai seorang wanita di sisi.
Dialog: 0,0:58:02.56,0:58:04.68, Lalai,,0,0,0,,Ini tidak membuktikan apa-apa.
Dialog: 0,0:58:04.73,0:58:07.20,Lalai,,0,0,0,,Anda telah mengekorinya berkali-kali.
Dialog: 0,0:58:07.23,0:58:10.25, Lalai,,0,0,0,,Dia tahu berkelakuan baik pada masa seperti ini.
Dialog: 0,0:58:10.27,0:58:11.67, Lalai,,0,0,0,,Adakah anda fikir begitu?
Dialog: 0,0:58:11.69,0:58:14.44, Lalai,,0,0,0,,Nombor akan memberitahu.
Dialog: 0,0:58:14.82,0:58:17.15,Lalai,,0,0,0,,Hasil audit akan keluar tidak lama lagi.
Dialog: 0,0:58:19.49,0:58:21.68,Lalai,,0,0,0,,{\i1}Mereka tidak menemui apa-apa langsung.{\i0}
Dialog: 0,0:58:21.70,0:58:24.18, Lalai,,0,0,0,,Mereka melakukan pemeriksaan menyeluruh,\Ndari yuran perundingannya...
Dialog: 0,0:58:24.20,0:58:27.02, Lalai,,0,0,0,, kepada perbelanjaan litigasi, dan tidak menemui apa-apa.
Dialog: 0,0:58:27.04,0:58:30.48, Lalai,,0,0,0,,Saya menyemak butiran kad dan akaunnya,\Nand dia tidak berbelanja banyak.
Dialog: 0,0:58:30.50,0:58:32.52,Lalai,,0,0,0,,Dia hanya sering pergi ke tempat cuci kereta,
Dialog: 0,0:58:32.55,0:58:34.61, Lalai,,0,0,0,,- tapi...\N- Tapi apa?
Dialog: 0,0:58:34.63,0:58:38.33, Lalai,,0,0,0,,Dia akan mengeluarkan beribu-ribu\Ndollar secara tunai dari semasa ke semasa.
Dialog: 0,0:58:38.38,0:58:40.08, Lalai,,0,0,0,,- Betulkah?\N- Ya.
Dialog: 0,0:58:40.35,0:58:42.99, Lalai,,0,0,0,, Satu lagi perkara yang ganjil ialah dia selalu membelanjakan $300...
Dialog: 0,0:58:43.01,0:58:46.70, Lalai,,0,0,0,,di Moulin Rouge pada hari penarikannya.
Dialog: 0,0:58:46.73,0:58:49.22,Lalai,,0,0,0,,Moulin Rouge?
Dialog: 0,0:58:49.40,0:58:51.64, Lalai,,0,0,0,,- Bar?\N- Kedai bunga.
Dialog: 0,0:59:08.16,0:59:11.89, Lalai,,0,0,0,,Dia membelanjakan $300 hari ini dan menghantar\N bunga kepada Kim Min-ji.
Dialog: 0,0:59:11.92,0:59:14.45,Lalai,,0,0,0,,Itu nama perempuan.
Dialog: 0,0:59:14.63,0:59:16.87,Lalai,,0,0,0,,- Saya percaya begitu.\N- Saya faham,
Dialog: 0,0:59:17.09,0:59:20.19,Lalai,,0,0,0,,jadi dia membeli beberapa bunga\Nand mengeluarkan wang tunai...
Dialog: 0,0:59:20.22,0:59:23.05, Lalai,,0,0,0,,sebelum bertemu Kim Min-ji ini?
Dialog: 0,0:59:24.35,0:59:25.95,Lalai,,0,0,0,,Di mana?
Dialog: 0,0:59:25.97,0:59:28.63, Lalai,,0,0,0,,Di mana dia sekarang?
Dialog: 0,0:59:30.35,0:59:32.04,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kim Min-ji\NGangju-gu, Seoul{\c}{\i0}
Dialog: 0,0:59:32.06,0:59:33.67,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Anak perempuan\NKim Min-ji{\c}{\i0}
Dialog: 0,0:59:33.69,0:59:36.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}CEO Hong Hae-in of Queens Department Store{\c}{\i0}
Dialog: 0,0:59:41.99,0:59:43.73,Lalai,,0,0,0,,Pn. Hong.
Dialog: 0,0:59:47.00,0:59:48.78,Lalai,,0,0,0,,Pn. Hong.
Dialog: 0,0:59:49.16,0:59:50.99, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik. Kim Min-ji?{\c}{\i0}
Dialog: 0,0:59:51.08,0:59:53.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berurusan dengan pelanggan kami sahaja.{\c}{\i0}
Dialog: 0,0:59:56.84,0:59:59.11, Lalai,,0,0,0,,Syarikat sudah membantu pengebumian.
Dialog: 0,0:59:59.13,1:00:03.45,Lalai,,0,0,0,,Anda secara peribadi menghantar bunga kepada kami dan\Memberi kami banyak wang takziah,
Dialog: 0,1:00:03.47,1:00:05.70,Lalai,,0,0,0,, malah anda meluangkan masa untuk melawat.
Dialog: 0,1:00:05.72,1:00:08.42,Lalai,,0,0,0,,Saya tidak tahu bagaimana untuk berterima kasih...
Dialog: 0,1:00:44.76,1:00:49.92,Lalai,,0,0,0,,Saya rasa Encik Baek telah menghantar\Ndukacita atas nama awak.
Dialog: 0,1:00:50.77,1:00:53.26,Lalai,,0,0,0,,Saya agak tersentuh.
Dialog: 0,1:00:56.31,1:00:58.01,Lalai,,0,0,0,,Saya sukakannya.
Dialog: 0,1:00:58.15,1:00:59.75,Lalai,,0,0,0,,Macam mana?
Dialog: 0,1:00:59.78,1:01:01.46,Lalai,,0,0,0,,Semua dewan pengebumian adalah sama,
Dialog: 0,1:01:01.49,1:01:04.80,Lalai,,0,0,0,,tetapi tempat ini bersih dan moden.
Dialog: 0,1:01:04.82,1:01:08.05,Lalai,,0,0,0,,Bukan hanya kekwa,\N tetapi dahlia dan tulip juga.
Dialog: 0,1:01:08.08,1:01:10.49,Lalai,,0,0,0,,Ia menceriakan bilik.
Dialog: 0,1:01:10.66,1:01:12.53,Lalai,,0,0,0,,Adakah malaikat itu?
Dialog: 0,1:01:12.62,1:01:15.41,Lalai,,0,0,0,,Gaya Rococo. saya suka.
Dialog: 0,1:01:15.58,1:01:18.48,Lalai,,0,0,0,,Saya juga suka bagaimana mereka mempunyai lampu halogen di sini,
Dialog: 0,1:01:18.50,1:01:21.54, Lalai,,0,0,0,,tetapi lampu sematkan pada fotonya.
Dialog: 0,1:01:22.55,1:01:26.00,Lalai,,0,0,0,,Adakah anda sedang mencari dewan pengebumian?
Dialog: 0,1:01:27.93,1:01:29.20,Lalai,,0,0,0,,Apa?
Dialog: 0,1:01:29.22,1:01:32.34,Lalai,,0,0,0,,Maksud saya, anda melihat sekeliling dengan teliti.
Dialog: 0,1:01:34.31,1:01:36.35,Lalai,,0,0,0,,Saya hanya melihat sekeliling.
Dialog: 0,1:01:36.65,1:01:38.35,Lalai,,0,0,0,,Saya faham.
Dialog: 0,1:01:38.52,1:01:42.64,Lalai,,0,0,0,,Sudah agak lama kami tidak datang ke pengebumian seperti ini.
Dialog: 0,1:01:43.11,1:01:46.02,Lalai,,0,0,0,,Kebanyakan pengebumian yang kami hadiri...
Dialog: 0,1:01:46.24,1:01:49.36,Lalai,,0,0,0,,jarang ada ahli keluarga yang menangis seperti mereka.
Dialog: 0,1:01:52.04,1:01:55.06,Lalai,,0,0,0,,Mereka sedang sibuk berunding dengan\Natorneys atau akauntan mereka...
Dialog: 0,1:01:55.08,1:01:57.83, Lalai,,0,0,0,,tentang cukai warisan atau hadiah mereka.
Dialog: 0,1:01:59.63,1:02:01.77,Lalai,,0,0,0,,Ibu...
Dialog: 0,1:02:01.80,1:02:03.54,Lalai,,0,0,0,,Anda betul.
Dialog: 0,1:02:04.72,1:02:08.67,Lalai,,0,0,0,,Mereka benar-benar berkabung.
Dialog: 0,1:02:31.99,1:02:34.24,Lalai,,0,0,0,,Kenapa awak hantar bunga...
Dialog: 0,1:02:34.33,1:02:36.57,Lalai,,0,0,0,,dan wang takziah?
Dialog: 0,1:02:37.96,1:02:40.60,Lalai,,0,0,0,,Berhenti bermain. awak jijikkan saya.
Dialog: 0,1:02:40.63,1:02:44.15,Lalai,,0,0,0,,Walaupun saya hilang ingatan di jalan raya,
Dialog: 0,1:02:44.17,1:02:46.98,Lalai,,0,0,0,,Saya tidak akan lupa apa yang awak lakukan kepada saya.
Dialog: 0,1:02:47.01,1:02:50.21,Lalai,,0,0,0,,Awak lepaskan tangan saya ketika saya...
Dialog: 0,1:02:50.39,1:02:52.09,Lalai,,0,0,0,,paling tidak berdaya.
Dialog: 0,1:02:54.18,1:02:57.12,Lalai,,0,0,0,,Saya tidak akan memaafkan awak.
Dialog: 0,1:02:57.14,1:03:00.60,Lalai,,0,0,0,,Cuba semua yang anda mahu,
Dialog: 0,1:03:01.65,1:03:04.52,Lalai,,0,0,0,,tetapi saya akan marah awak sehingga nafas terakhir saya,
Dialog: 0,1:03:04.90,1:03:08.48,Lalai,,0,0,0,,jadi semua yang anda perlu lakukan...
Dialog: 0,1:03:08.74,1:03:10.86,Lalai,,0,0,0,,adalah diam...
Dialog: 0,1:03:12.49,1:03:15.36,Lalai,,0,0,0,,dan tersesat apabila saya menyuruh anda.
Dialog: 0,1:03:36.10,1:03:38.59,Lalai,,0,0,0,,- Itu pantas.\N- Sudah tentu.
Dialog: 0,1:03:42.86,1:03:45.54,Lalai,,0,0,0,,- Apa itu?\N- Bukan apa.
Dialog: 0,1:03:45.57,1:03:49.52,Lalai,,0,0,0,,- Saya tidak mahu menambah bahan api ke dalam api.\N- Tidak, biar saya mendengarnya.
Dialog: 0,1:03:49.90,1:03:51.47,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:03:51.49,1:03:54.26,Lalai,,0,0,0,,Adakah anda tahu Setiausaha Kim\Nand saya telah menjadi agak rapat?
Dialog: 0,1:03:54.28,1:03:55.46,Lalai,,0,0,0,,Kami baru sahaja bercakap melalui telefon.
Dialog: 0,1:03:55.48,1:03:58.06,Lalai,,0,0,0, "Bagaimana keadaan mereka? Adakah\Anda rasa mereka telah berdamai?"
Dialog: 0,1:03:58.08,1:04:00.93, Lalai,,0,0,0, "Ke mana mereka akan pergi selepas kerja?\NDJangan biarkan mereka bersilang jalan."
Dialog: 0,1:04:00.96,1:04:03.94,Lalai,,0,0,0,,- Itulah setiausaha...\N- Bukan kami sahaja.
Dialog: 0,1:04:03.96,1:04:05.81,Lalai,,0,0,0,,Semua pekerja juga sedang nazak.
Dialog: 0,1:04:05.84,1:04:08.58,Lalai,,0,0,0,,Mereka lebih suka apabila anda tidak peduli,
Dialog: 0,1:04:08.80,1:04:11.03,Lalai,,0,0,0,,tetapi anda mengalami hari baik dan buruk sejak kebelakangan ini.
Dialog: 0,1:04:11.05,1:04:14.21,Lalai,,0,0,0,,Cukup. Lebih baik saya tidak mendengarnya.
Dialog: 0,1:04:14.64,1:04:16.45,Lalai,,0,0,0,,Awak buat saya bercakap.
Dialog: 0,1:04:16.47,1:04:19.12,Lalai,,0,0,0,,Bagaimanapun, ada satu perkara yang boleh anda lakukan untuk kami.
Dialog: 0,1:04:19.14,1:04:20.83,Lalai,,0,0,0,,- Kekal mesra.\N- Cukup.
Dialog: 0,1:04:20.85,1:04:22.58,Lalai,,0,0,0,,Alangkah baiknya jika anda pergi melancong.
Dialog: 0,1:04:22.60,1:04:25.12,Lalai,,0,0,0,,- Di luar negara, jika boleh.\N- Awak tak sibuk ke?
Dialog: 0,1:04:25.15,1:04:27.81,Lalai,,0,0,0,,Sudah tentu saya. Saya setiausaha awak.
Dialog: 0,1:04:28.53,1:04:30.94,Lalai,,0,0,0,,Anda sedang makan malam dengan Encik Yoon.
Dialog: 0,1:04:31.28,1:04:33.23,Lalai,,0,0,0,,Anda sering berjumpa dengannya.
Dialog: 0,1:04:35.99,1:04:37.69,Lalai,,0,0,0,,Hebat kan?
Dialog: 0,1:04:37.79,1:04:39.43,Lalai,,0,0,0,,Tiada tahap perpecahan.
Dialog: 0,1:04:39.45,1:04:44.18,Lalai,,0,0,0,,Yuran penyertaan sebanyak 8% tidaklah teruk,
Dialog: 0,1:04:44.21,1:04:48.36,Lalai,,0,0,0,,tetapi kenapa dia mahu Hercyna\N mengupah pekerja mereka sendiri?
Dialog: 0,1:04:48.38,1:04:49.57,Lalai,,0,0,0,,Itu peraturan dia.
Dialog: 0,1:04:49.59,1:04:53.21,Lalai,,0,0,0,,- Pekerja mesti berumur 27 tahun ke bawah.\N- Saya tahu, tapi kenapa?
Dialog: 0,1:04:53.51,1:04:56.84,Lalai,,0,0,0,,Dia tidak mahu orang tua\Pekerja menjual produknya.
Dialog: 0,1:04:58.31,1:04:59.41,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,1:04:59.43,1:05:02.58,Lalai,,0,0,0,,Apa yang mengerikan tentang penuaan?\NISebenarnya satu rahmat.
Dialog: 0,1:05:02.60,1:05:04.66,Lalai,,0,0,0,,Ia hebat dan sesuatu untuk dipertandingkan.
Dialog: 0,1:05:04.69,1:05:06.72,Lalai,,0,0,0,,Ia cantik.
Dialog: 0,1:05:09.48,1:05:11.18,Lalai,,0,0,0,,Dia menjengkelkan.
Dialog: 0,1:05:12.49,1:05:16.59,Lalai,,0,0,0,,Jadi adakah anda akan berputus asa? Dia\Naccept hampir semua syarat kami.
Dialog: 0,1:05:16.62,1:05:18.32,Lalai,,0,0,0,,"Kami"?
Dialog: 0,1:05:25.21,1:05:27.20,Lalai,,0,0,0,,Syarat anda.
Dialog: 0,1:05:27.79,1:05:30.36,Lalai,,0,0,0,,Ya, dia terima syarat saya...
Dialog: 0,1:05:30.38,1:05:33.32,Lalai,,0,0,0,,demi anda,
Dialog: 0,1:05:33.34,1:05:35.13,Lalai,,0,0,0,,jadi beritahu saya.
Dialog: 0,1:05:37.43,1:05:39.13,Lalai,,0,0,0,,Apa yang anda mahukan?
Dialog: 0,1:05:39.64,1:05:42.59,Lalai,,0,0,0,,Saya tahu saya berhutang dengan awak.
Dialog: 0,1:05:42.98,1:05:46.39,Lalai,,0,0,0,,Saya berasa tidak senang, kerana anda\Ntidak meminta bantuan daripada saya.
Dialog: 0,1:05:46.48,1:05:50.22,Lalai,,0,0,0,,Jika ia sesuatu yang boleh saya lakukan\N sekarang, maka saya akan melakukannya.
Dialog: 0,1:05:52.40,1:05:54.98,Lalai,,0,0,0,,- Ceraikan dia.\N- Apa?
Dialog: 0,1:05:57.20,1:05:59.48,Lalai,,0,0,0,,Ceraikan Baek Hyun-woo.
Dialog: 0,1:06:00.20,1:06:02.32,Lalai,,0,0,0,,Itulah yang saya mahu.
Dialog: 0,1:06:05.33,1:06:08.87,Lalai,,0,0,0,,Dia bercadang untuk meninggalkan awak.\NAdakah awak masih mengekalkan dia?
Dialog: 0,1:06:19.60,1:06:21.30,Lalai,,0,0,0,,Itu urusan saya.
Dialog: 0,1:06:22.01,1:06:25.09,Lalai,,0,0,0,,Anda melepasi garisan sekali lagi.
Dialog: 0,1:06:27.73,1:06:30.35, Lalai,,0,0,0,, Patutkah saya benar-benar melepasi garisan kali ini?
Dialog: 0,1:06:31.44,1:06:33.35,Lalai,,0,0,0,,Bagaimana jika saya...
Dialog: 0,1:06:36.03,1:06:37.73,Lalai,,0,0,0,, menggantikan dia?
Dialog: 0,1:06:52.34,1:06:56.25,Lalai,,0,0,0,,Saya akan melampaui batas\Jika saya benar-benar bertanya kepada anda.
Dialog: 0,1:07:18.15,1:07:19.86,Lalai,,0,0,0,,Saya tidak boleh makan.
Dialog: 0,1:07:20.95,1:07:25.24,Lalai,,0,0,0,,Saya tidak boleh mencerna makanan dengan baik apabila saya tersinggung.
Dialog: 0,1:08:02.95,1:08:05.39,Lalai,,0,0,0,,{\i1}Dia telah diambil sebagai anak angkat oleh keluarga Korea pada 12.{\i0}
Dialog: 0,1:08:05.41,1:08:07.84,Lalai,,0,0,0,,A.S. mungkin luas, tetapi\Nkomuniti Korea kecil.
Dialog: 0,1:08:07.87,1:08:12.14,Lalai,,0,0,0,,Peguam antarabangsa baharu kami\Nused tinggal di kawasan kejiranannya.
Dialog: 0,1:08:12.17,1:08:14.94,Lalai,,0,0,0,,Mereka tidak rapat, tetapi\Keluarganya terkenal.
Dialog: 0,1:08:14.96,1:08:17.11,Lalai,,0,0,0,,- Macam mana?\N- Tidak lama selepas dia diterima pakai.
Dialog: 0,1:08:17.13,1:08:19.11,Lalai,,0,0,0,,Ibu bapa angkatnya berpindah ke rumah yang lebih besar.
Dialog: 0,1:08:19.13,1:08:21.74,Lalai,,0,0,0,,Kemudian mereka menghantarnya ke\Nsekolah swasta paling mahal.
Dialog: 0,1:08:21.76,1:08:24.03,Lalai,,0,0,0,,Akademi Hill Crawford.
Dialog: 0,1:08:24.05,1:08:26.32,Lalai,,0,0,0,,Kos tuisyen tahunan melebihi $60,000,
Dialog: 0,1:08:26.35,1:08:28.24,Lalai,,0,0,0,,tetapi ibu bapanya tidak kaya.
Dialog: 0,1:08:28.27,1:08:30.24,Lalai,,0,0,0,,Bolehkah anda menghubungi ibu bapanya?
Dialog: 0,1:08:30.27,1:08:31.97,Lalai,,0,0,0,,Saya telah menelitinya.
Dialog: 0,1:08:32.35,1:08:34.04,Lalai,,0,0,0,,Mereka berdua meninggal dunia.
Dialog: 0,1:08:34.06,1:08:36.08,Lalai,,0,0,0,,Ia adalah kemalangan memandu dalam keadaan mabuk,
Dialog: 0,1:08:36.11,1:08:39.14,Lalai,,0,0,0,,tetapi orang menganggapnya ganjil,
Dialog: 0,1:08:39.40,1:08:42.02,Lalai,,0,0,0,,kerana kedua-duanya bukan peminum.
Dialog: 0,1:09:26.99,1:09:28.82,Lalai,,0,0,0,,Anda tidak sepatutnya berada di sini.
Dialog: 0,1:09:29.91,1:09:33.61,Lalai,,0,0,0,,Bagaimana keadaan tempat ini? Ia kosong untuk masa yang lama.
Dialog: 0,1:09:33.71,1:09:34.77,Lalai,,0,0,0,,Anda patut pergi.
Dialog: 0,1:09:34.79,1:09:39.24,Lalai,,0,0,0,,Saya berasa yakin apabila mengetahui anak saya\Ntinggal di bawah bumbung yang sama dengan saya.
Dialog: 0,1:09:40.59,1:09:42.29,Lalai,,0,0,0,,Saya suruh awak pergi.
Dialog: 0,1:09:43.30,1:09:47.92,Lalai,,0,0,0,,- Anda perlu lebih berhati-hati, Cik Moh.\N- Jangan panggil saya begitu. Panggil saya "Ibu."
Dialog: 0,1:09:49.10,1:09:53.09,Lalai,,0,0,0,,Awak suruh saya jangan panggil awak begitu,\Njadi saya menahan diri saya selama ini.
Dialog: 0,1:09:53.18,1:09:55.39,Lalai,,0,0,0,,Sekarang saya tidak boleh mengatakannya lagi.
Dialog: 0,1:09:56.15,1:09:58.05,Lalai,,0,0,0,,Betul.
Dialog: 0,1:09:59.40,1:10:02.43,Lalai,,0,0,0,,Kami mempunyai masa lalu.
Dialog: 0,1:10:05.03,1:10:07.44,Lalai,,0,0,0,,Tetapi saya tidak menyesal.
Dialog: 0,1:10:08.87,1:10:12.07,Lalai,,0,0,0,,Betulkah? When this is your life right now?
Dialog: 0,1:10:12.87,1:10:15.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia seorang pembantu rumah.{\c}{\i0}
Dialog: 0,1:10:15.12,1:10:16.64,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia berada di sini untuk seketika.{\c}{\i0}
Dialog: 0,1:10:16.67,1:10:18.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda boleh katakan dia seperti...{\c}{\i0}
Dialog: 0,1:10:18.17,1:10:20.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}ketua pembantu rumah yang datuk bergantung.{\c}{\i0}
Dialog: 0,1:10:20.71,1:10:21.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan pedulikan dia.{\c}{\i0}
Dialog: 0,1:10:21.84,1:10:23.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia bukan sesiapa.{\c}{\i0}
Dialog: 0,1:10:23.30,1:10:25.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dan di sebelah sana...{\c}{\i0}
Dialog: 0,1:10:29.89,1:10:30.95,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Aduh, masinnya.{\c}{\i0}
Dialog: 0,1:10:30.97,1:10:32.62,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik. Moh has lost her touch.{\c}{\i0}
Dialog: 0,1:10:32.64,1:10:35.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa ini sangat masin?{\c}{\i0}
Dialog: 0,1:10:35.18,1:10:38.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya anda harus menendangnya keluar serta-merta.{\c}{\i0}
Dialog: 0,1:10:38.27,1:10:42.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan melakukannya\Belum ada jika terpulang kepada saya.{\c}{\i0}
Dialog: 0,1:10:42.02,1:10:45.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Makan. The other dishes are fine.\N- Okay.{\c}{\i0}
Dialog: 0,1:10:48.24,1:10:50.42,Lalai,,0,0,0,,{\i1}Tidakkah kamu ingat semuanya...{\i0}
Dialog: 0,1:10:50.44,1:10:52.67,Lalai,,0,0,0,,anda telah kalah dalam tempoh 30 tahun yang lalu?
Dialog: 0,1:10:53.37,1:10:54.60,Lalai,,0,0,0,,Sudah tentu saya lakukan.
Dialog: 0,1:10:54.62,1:10:57.27,Lalai,,0,0,0,,Saya mahu menjaga anak saya rapat,
Dialog: 0,1:10:57.29,1:10:59.18,Lalai,,0,0,0,,dan angkat dia sendiri,
Dialog: 0,1:10:59.21,1:11:03.10,Lalai,,0,0,0,,tetapi jika saya melakukannya, anda tidak akan\N mendapat hidangan hari jadi yang sedap,
Dialog: 0,1:11:03.13,1:11:06.07, Lalai,,0,0,0,,atau pakaian sekolah yang serba baharu.
Dialog: 0,1:11:06.09,1:11:07.65,Lalai,,0,0,0,,Kami akan menjadi miskin.
Dialog: 0,1:11:07.68,1:11:10.24,Lalai,,0,0,0,,Saya akan berkata, "Kami sekeluarga. Bertahanlah."
Dialog: 0,1:11:10.26,1:11:12.53,Lalai,,0,0,0, "Perkara akan dicari tidak lama lagi,"
Dialog: 0,1:11:12.55,1:11:16.76,Lalai,,0,0,0,,tetapi itu tidak akan berlaku.
Dialog: 0,1:11:19.90,1:11:22.06,Lalai,,0,0,0,,Ia rumah yang bagus, bukan?
Dialog: 0,1:11:22.65,1:11:25.38,Lalai,,0,0,0,,Pengerusi Hong sangat teliti.
Dialog: 0,1:11:25.40,1:11:27.63,Lalai,,0,0,0,,Dia mengambil masa lima tahun untuk membina rumah ini,
Dialog: 0,1:11:27.65,1:11:29.67,Lalai,,0,0,0,,apabila ia akan mengambil masa yang lain setahun.
Dialog: 0,1:11:29.70,1:11:33.86,Lalai,,0,0,0,,Dia pun memilih batu mana yang hendak diletakkan di taman,
Dialog: 0,1:11:35.83,1:11:38.56,Lalai,,0,0,0,,tetapi tidak lama lagi...
Dialog: 0,1:11:38.58,1:11:40.93,Lalai,,0,0,0,,kami akan tendang mereka semua,
Dialog: 0,1:11:40.96,1:11:43.41,Lalai,,0,0,0,,dan miliki rumah ini untuk diri kita sendiri.
Dialog: 0,1:11:45.80,1:11:48.11,Lalai,,0,0,0,,Jangan fikir ia tidak adil.
Dialog: 0,1:11:48.13,1:11:51.99,Lalai,,0,0,0,,Kami hanya mengubah susunan perkara.
Dialog: 0,1:11:52.01,1:11:54.61,Lalai,,0,0,0,,Keluarga ini mempunyai semua yang mereka inginkan.
Dialog: 0,1:11:54.64,1:11:56.03,Lalai,,0,0,0,,Mereka gembira,
Dialog: 0,1:11:56.06,1:11:57.66,Lalai,,0,0,0,,dan sekarang...
Dialog: 0,1:11:57.68,1:12:00.14,Lalai,,0,0,0,,kami akan ambil alih...
Dialog: 0,1:12:00.98,1:12:02.68,Lalai,,0,0,0,,dan menjadi gembira.
Dialog: 0,1:12:04.73,1:12:07.31,Lalai,,0,0,0,,Anda lebih cuai daripada yang saya sangka.
Dialog: 0,1:12:07.53,1:12:09.44,Lalai,,0,0,0,,Adakah anda fikir ia akan mudah?
Dialog: 0,1:12:10.07,1:12:12.22,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Saya...\N- Tidak, begitulah.{\c}{\i0}
Dialog: 0,1:12:12.24,1:12:13.51,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Tendang bola kepada saya.{\c}{\i0}
Dialog: 0,1:12:13.53,1:12:14.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya mahu melakukannya juga.{\c}{\i0}
Dialog: 0,1:12:14.99,1:12:16.55,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ada di sana.{\c}{\i0}
Dialog: 0,1:12:16.58,1:12:18.10,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kawan-kawan, minumlah.{\c}{\i0}
Dialog: 0,1:12:18.12,1:12:20.06,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibu bawa minuman.{\c}{\i0}
Dialog: 0,1:12:20.08,1:12:22.77,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Jom.\N- Bolehkah kita dapatkannya sekarang?{\c}{\i0}
Dialog: 0,1:12:22.79,1:12:23.94,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Bolehkah kita meminumnya?{\c}{\i0}
Dialog: 0,1:12:23.96,1:12:26.08,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemari!{\c}{\i0}
Dialog: 0,1:12:30.05,1:12:32.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya ampun, puteriku.{\c}{\i0}
Dialog: 0,1:12:32.30,1:12:34.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda bangun?{\c}{\i0}
Dialog: 0,1:12:34.64,1:12:38.59,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Ya ampun, awak sangat cantik.{\c}{\i0}
Dialog: 0,1:12:39.52,1:12:42.39,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}{\i1}Kebaikan.{\i0}{\c}{\i0}
Dialog: 0,1:12:42.44,1:12:44.33,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Beom-jun, berhati-hati.{\c}{\i0}
Dialog: 0,1:12:44.36,1:12:46.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Kawan-kawan, lihat di sini.{\c}{\i0}
Dialog: 0,1:12:46.82,1:12:48.50,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}- Bawa saya.\N- Pasti.{\c}{\i0}
Dialog: 0,1:12:48.53,1:12:50.71,Lalai,,0,0,0,,Pengerusi Hong menikmati kebahagiaannya di hadapan kami,
Dialog: 0,1:12:50.74,1:12:52.59,Lalai,,0,0,0,,dan dia masih ingat masa itu.
Dialog: 0,1:12:52.61,1:12:54.34,Lalai,,0,0,0,,Kami belum mengambilnya lagi.
Dialog: 0,1:12:54.37,1:12:55.34,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda tidak akan jatuh.{\c}{\i0}
Dialog: 0,1:12:55.37,1:12:57.19,Lalai,,0,0,0,,Kita tidak sepatutnya...
Dialog: 0,1:12:57.79,1:12:59.90,Lalai,,0,0,0,,puas hati macam ni.
Dialog: 0,1:13:10.55,1:13:13.88,Lalai,,0,0,0,,- Apakah ini?\N- Gunakannya mengikut kehendak anda.
Dialog: 0,1:13:14.55,1:13:17.25,Lalai,,0,0,0,,Di manakah saya boleh menggunakan ini?
Dialog: 0,1:13:17.68,1:13:21.95,Lalai,,0,0,0,,Setiausaha Jang memberitahu saya anda akan\N disiasat untuk dana rahsia.
Dialog: 0,1:13:21.98,1:13:24.58,Lalai,,0,0,0,,Anak lelaki atau cucu anda tidak boleh masuk penjara untuk anda,
Dialog: 0,1:13:24.60,1:13:27.21,Lalai,,0,0,0,,kerana mereka mempunyai banyak perkara.
Dialog: 0,1:13:27.23,1:13:29.68,Lalai,,0,0,0,,- Jadi?\N- Saya akan pergi.
Dialog: 0,1:13:30.40,1:13:33.51,Lalai,,0,0,0,,Katakan saya diam-diam\Merampas dana rahsia anda...
Dialog: 0,1:13:33.53,1:13:36.06,Lalai,,0,0,0,,melalui yayasan biasiswa.
Dialog: 0,1:13:36.28,1:13:40.30,Lalai,,0,0,0,,Saya bukan ahli lembaga\N mahupun keluarga anda mengikut undang-undang.
Dialog: 0,1:13:40.33,1:13:45.06,Lalai,,0,0,0,,Jika saya bertanggungjawab, anda tidak akan\Nperlu risau tentang risiko pemilik.
Dialog: 0,1:13:45.08,1:13:48.44,Lalai,,0,0,0,,Walaupun media membuat liputan,\NI boleh menerima kejatuhan sahaja.
Dialog: 0,1:13:48.46,1:13:51.54,Lalai,,0,0,0,,Tiada penghormatan yang perlu saya pertahankan,
Dialog: 0,1:13:51.59,1:13:53.23,Lalai,,0,0,0,,jadi tidak mengapa.
Dialog: 0,1:13:53.26,1:13:57.29,Lalai,,0,0,0,,Saya akan disoal siasat dan pergi ke penjara.
Dialog: 0,1:13:57.72,1:13:59.55,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:14:08.15,1:14:10.72,Lalai,,0,0,0,,Anda jauh lebih baik...
Dialog: 0,1:14:11.94,1:14:14.52,Lalai,,0,0,0,,daripada semua anak saya digabungkan.
Dialog: 0,1:15:00.66,1:15:02.44,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:15:07.04,1:15:10.70,Lalai,,0,0,0,,Kenapa awak keluar dalam kesejukan? mana kereta awak?
Dialog: 0,1:15:11.17,1:15:14.08,Lalai,,0,0,0,,Di mana? Mana Encik Oh?
Dialog: 0,1:15:29.65,1:15:31.47,Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,1:15:33.15,1:15:35.48,Lalai,,0,0,0,,Bagaimana saya sampai ke sini?
Dialog: 0,1:15:41.32,1:15:43.82,Lalai,,0,0,0,,Saya terus mendapati diri saya seperti ini hari ini.
Dialog: 0,1:15:43.91,1:15:47.74,Lalai,,0,0,0,,Masa terus berlalu apabila\NI sudah kesuntukan masa.
Dialog: 0,1:15:51.33,1:15:53.10,Lalai,,0,0,0,,Bagaimana dengan anda?
Dialog: 0,1:15:53.13,1:15:55.25,Lalai,,0,0,0,,Bagaimana anda tahu saya berada di sini?
Dialog: 0,1:16:00.13,1:16:03.00,Lalai,,0,0,0,,Adakah anda mengenali payung ini?
Dialog: 0,1:16:03.64,1:16:06.21,Lalai,,0,0,0,,Adakah anda ingat memberikannya kepada saya?
Dialog: 0,1:16:07.06,1:16:10.43,Lalai,,0,0,0,,Saya benar-benar terkedu ketika itu.
Dialog: 0,1:16:12.27,1:16:13.97,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:16:15.52,1:16:17.59,Lalai,,0,0,0,,Jangan pandang saya macam tu.
Dialog: 0,1:16:17.61,1:16:19.38,Lalai,,0,0,0,,Ada 51% peluang.
Dialog: 0,1:16:19.40,1:16:22.36,Lalai,,0,0,0,,Saya boleh pergi ke Jerman dan menerima rawatan.
Dialog: 0,1:16:34.13,1:16:35.19,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:16:35.21,1:16:37.29,Lalai,,0,0,0,,Mengapa awak terus menghubungi saya?
Dialog: 0,1:17:04.20,1:17:08.85,Lalai,,0,0,0,,Betul. Awak tahu Ye-na, kan? Dia\N mengalami kemalangan kereta dua hari lalu.
Dialog: 0,1:17:08.87,1:17:11.31,Lalai,,0,0,0,,Dia pengsan dan pergi ke ED.
Dialog: 0,1:17:11.33,1:17:14.31,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia pengsan dan pergi ke ED.{\c}{\i0}
Dialog: 0,1:17:14.33,1:17:16.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemudian suaminya...{\c}{\i0}
Dialog: 0,1:17:16.25,1:17:19.11,Lalai,,0,0,0,,Kemudian suaminya dan peguamnya bergegas menghampiri.
Dialog: 0,1:17:19.13,1:17:23.61,Lalai,,0,0,0,,Dia menyebabkan adegan dan berkata\Ndia perlu menyemak semula kehendaknya.
Dialog: 0,1:17:23.63,1:17:27.84,Lalai,,0,0,0,,Dia bising sehingga dia bangun.
Dialog: 0,1:17:37.44,1:17:39.43,Lalai,,0,0,0,,Adakah anda menangis?
Dialog: 0,1:17:42.40,1:17:44.44,Lalai,,0,0,0,,Maaf.
Dialog: 0,1:17:46.57,1:17:48.69,Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,1:17:56.92,1:17:58.79,Lalai,,0,0,0,,Adakah anda begitu risau?
Dialog: 0,1:18:03.88,1:18:05.92,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:18:20.82,1:18:22.52,Lalai,,0,0,0,,Baek Hyun-woo.
Dialog: 0,1:18:24.78,1:18:26.48,Lalai,,0,0,0,,Saya sayang awak.
Dialog: 0,1:19:16.83,1:19:19.10,Lalai,,0,0,0,,- Nama dia Yeong-suk.\N- Lupakan.
Dialog: 0,1:19:19.12,1:19:22.03,Lalai,,0,0,0,,- Saya mengenali nama itu.\N- Ya, puan.
Dialog: 0,1:19:27.01,1:19:29.54,Lalai,,0,0,0,,Itu dahulu.
Dialog: 0,1:19:30.43,1:19:32.16,Lalai,,0,0,0,,Dia masih memanggilnya?
Dialog: 0,1:19:32.18,1:19:35.64,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Peta Panduan Queens Department Store{\c}{\i0}
Dialog: 0,1:19:36.39,1:19:38.24,Lalai,,0,0,0,,En. Baek, awak tahu?
Dialog: 0,1:19:38.27,1:19:41.04, Lalai,,0,0,0,,Rakun tinggal di taman atas bumbung kami.
Dialog: 0,1:19:41.06,1:19:43.12,Lalai,,0,0,0,,Itu tidak boleh.
Dialog: 0,1:19:43.15,1:19:45.38,Lalai,,0,0,0,,Tiada rakun di Seoul.
Dialog: 0,1:19:45.40,1:19:47.10,Lalai,,0,0,0,,Saya nampak dia.
Dialog: 0,1:19:47.32,1:19:49.05, Lalai,,0,0,0,, Banyak kali.
Dialog: 0,1:19:49.07,1:19:51.05,Lalai,,0,0,0,,- Betulkah?\N- Ya.
Dialog: 0,1:19:51.07,1:19:54.86,Lalai,,0,0,0,,Dia hanya keluar dari persembunyian apabila\Nit kosong dan anda memanggil namanya.
Dialog: 0,1:19:56.79,1:19:58.82,Lalai,,0,0,0,,Dia keluar?
Dialog: 0,1:20:01.50,1:20:03.49,Lalai,,0,0,0,,Itu mustahil.
Dialog: 0,1:20:03.67,1:20:06.66,Lalai,,0,0,0,,Anda mesti menganggap saya bodoh.
Dialog: 0,1:20:06.96,1:20:08.66,Lalai,,0,0,0,,Saya serius.
Dialog: 0,1:20:10.13,1:20:12.34,Lalai,,0,0,0,,Nama dia Yeong-suk.
Dialog: 0,1:20:17.06,1:20:18.79,Lalai,,0,0,0,,Anda berbohong, bukan?
Dialog: 0,1:20:18.81,1:20:21.20,Lalai,,0,0,0,,Panggil namanya apabila tiada sesiapa di sekeliling,
Dialog: 0,1:20:21.23,1:20:24.89,Lalai,,0,0,0,,tetapi dia hanya keluar apabila dia mahu.
Dialog: 0,1:20:31.53,1:20:34.32,Lalai,,0,0,0,,Ayuh. Jangan berbohong.
Dialog: 0,1:20:35.12,1:20:36.98,Lalai,,0,0,0,,Anda berbohong.
Dialog: 0,1:20:37.04,1:20:39.40,Lalai,,0,0,0,,Dia sangat comel.
Dialog: 0,1:20:46.38,1:20:48.70,Lalai,,0,0,0,,Awak tipu saya lagi.
Dialog: 0,1:20:49.38,1:20:51.21,Lalai,,0,0,0,,Anda berbohong.
Dialog: 0,1:20:51.26,1:20:53.21,Lalai,,0,0,0,,Dia mempunyai mata yang besar dan bulat.
Dialog: 0,1:20:53.34,1:20:55.25,Lalai,,0,0,0,,Saya tahu awak juga akan mencintainya.
Dialog: 0,1:21:03.81,1:21:06.54,Lalai,,0,0,0,,Saya minta maaf, tetapi awak tidak menipu saya.
Dialog: 0,1:21:06.57,1:21:10.56,Lalai,,0,0,0,,Dia bodoh. Dia masih percaya.
Dialog: 0,1:21:11.24,1:21:14.27,Lalai,,0,0,0,,Adakah dia percaya semua yang saya katakan?
Dialog: 0,1:21:20.12,1:21:24.78,Lalai,,0,0,0,,Tidak hairanlah dia berkahwin dengan saya selepas saya berkata...
Dialog: 0,1:21:26.04,1:21:28.20,Lalai,,0,0,0,,Saya akan buat dia gembira.
Dialog: 0,1:21:33.93,1:21:35.63,Lalai,,0,0,0,,Yeong-suk.
Dialog: 0,1:21:35.84,1:21:38.34,Lalai,,0,0,0,,Keluar jika anda berada di sini.
Dialog: 0,1:21:39.72,1:21:41.55,Lalai,,0,0,0,,Yeong-suk?
Dialog: 0,1:21:57.41,1:21:59.94,Lalai,,0,0,0,,Yeong-suk!
Dialog: 0,1:22:06.33,1:22:09.12,Lalai,,0,0,0,,Saya nak jumpa awak, Yeong-suk.
Dialog: 0,1:22:12.51,1:22:15.34,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:22:46.71,1:22:49.19,Lalai,,0,0,0,,{\an8}{\i1}Dia berlari pusingan, dan makan sup nasi semula.{\i0}
Dialog: 0,1:22:49.21,1:22:51.29,Lalai,,0,0,0,,{\an8}{\i1}Adakah ini menyeronokkan?{\i0}
Dialog: 0,1:22:51.84,1:22:53.52,Lalai,,0,0,0,,{\an8}{\i1}Bagaimana mungkin saya meninggalkannya?{\i0}
Dialog: 0,1:22:53.55,1:22:55.25,Lalai,,0,0,0,,{\an8}{\i1}Keluar.{\i0}
Dialog: 0,1:22:55.55,1:22:57.65,Lalai,,0,0,0,,{\an8}{\i1}Perjumpaan semula? Bar? Hanya ada satu jawapan.{\i0}
Dialog: 0,1:22:57.68,1:22:59.75,Lalai,,0,0,0,,{\an8}{\i1}Seorang perempuan simpanan.{\i0}
Dialog: 0,1:23:00.47,1:23:03.32,Lalai,,0,0,0,,{\an8}{\i1}Mengapa anda masih di sini dan\Nmembiarkan mereka mengaibkan anda?{\i0}
Dialog: 0,1:23:03.35,1:23:04.53,Lalai,,0,0,0,,{\an8}{\i1}Hari ini ialah...{\i0}
Dialog: 0,1:23:04.56,1:23:07.45,Lalai,,0,0,0,,{\an8}{\i1}hari terbaik dalam hidup saya.{\i0}
Dialog: 0,1:23:07.48,1:23:10.08,Lalai,,0,0,0,,{\an8}{\i1}Dia tetap akan memilih saya.{\i0}
Dialog: 0,1:23:10.11,1:23:11.79,Lalai,,0,0,0,,{\an8}{\i1}Anda! Biarkan dia pergi!{\i0}
Dialog: 0,1:23:11.82,1:23:13.50,Lalai,,0,0,0,,{\an8}{\i1}...dan jika anda cuba mencederakannya,{\i0}
Dialog: 0,1:23:13.53,1:23:15.94,Lalai,,0,0,0,,{\an8}{\i1}Saya akan melakukan perkara yang sama kepada anda.{\i0}
