Dialogue: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialogue: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialogue: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialogue: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialogue: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialogue: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialogue: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialogue: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Screenwriter: Park Ji-eun{\c}{\i0}
Dialogue: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mga Direktor: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialogue: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,0:01:03.18,0:01:04.95,Default,,0,0,0,,Du-gwan!
Dialogue: 0,0:01:04.98,0:01:06.96,Default,,0,0,0,,Tingnan!
Dialogue: 0,0:01:06.99,0:01:07.98,Default,,0,0,0,,Oh, mahal!
Dialogue: 0,0:01:08.00,0:01:09.96,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Dating CEO Hong Hae-in Terminally Ill{\c}{\i0}
Dialogue: 0,0:01:12.57,0:01:14.34,Default,,0,0,0,,- Gosh!\N- Gosh, Du-gwan!
Dialogue: 0,0:01:14.36,0:01:15.50,Default,,0,0,0,,Du-gwan!
Dialogue: 0,0:01:15.53,0:01:17.09,Default,,0,0,0,,Huwag kalimutan ang iyong sapatos!
Dialogue: 0,0:01:17.11,0:01:18.90,Default,,0,0,0,,Mi-seon!
Dialogue: 0,0:01:27.50,0:01:31.16,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dahil sinabihan ako...{\c}{\i0}
Dialogue: 0,0:01:32.17,0:01:34.21,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kaunti na lang ang natitira kong oras...{\c}{\i0}
Dialogue: 0,0:01:34.26,0:01:36.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}upang mabuhay.{\c}{\i0}
Dialogue: 0,0:01:41.81,0:01:43.62,Default,,0,0,0,,Kailan ka na-diagnose?
Dialogue: 0,0:01:43.64,0:01:46.43,Default,,0,0,0,,Alam din ba ito ni Chairman Yoon?
Dialogue: 0,0:03:12.85,0:03:15.51,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:03:17.11,0:03:18.68,Default,,0,0,0,,{\i1}Hindi pa ako pwedeng mamatay.{\i0}
Dialogue: 0,0:03:20.28,0:03:22.27,Default,,0,0,0,,{\i1}Hindi ko pa...{\i0}
Dialogue: 0,0:03:22.53,0:03:24.98,Default,,0,0,0,,{\i1}sinabi pa sa iyo.{\i0}
Dialogue: 0,0:03:25.49,0:03:27.48,Default,,0,0,0,,Parating na!
Dialogue: 0,0:03:29.41,0:03:31.03,Default,,0,0,0,,{\i1}Okay lang yun.{\i0}
Dialogue: 0,0:03:35.08,0:03:38.15,Default,,0,0,0,,{\i1}Na kahit kailan ay hindi ako nagdamdam sa iyo.{\i0}
Dialogue: 0,0:03:38.17,0:03:39.65,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ano ang silbi nito?{\c}{\i0}
Dialogue: 0,0:03:39.67,0:03:41.62,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nakakainis lang ako.{\c}{\i0}
Dialogue: 0,0:03:42.30,0:03:45.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maghiwalay tayo. Gusto ko ng diborsiyo.{\c}{\i0}
Dialogue: 0,0:03:45.55,0:03:49.17,Default,,0,0,0,,{\i1}Hindi kita pinasalamatan sa\Nnanatili sa akin nitong mga taon,{\i0}
Dialogue: 0,0:03:57.07,0:04:00.17,Default,,0,0,0,,{\i1}sa kabila ng lahat ng masasakit na salita...{\i0}
Dialogue: 0,0:04:00.19,0:04:01.34,Default,,0,0,0,,{\i1}Hindi ko sinasadya.{\i0}
Dialogue: 0,0:04:01.36,0:04:03.98,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mahal ko siya.{\c}{\i0}
Dialogue: 0,0:04:07.24,0:04:09.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mahal kita, Hae-in.{\c}{\i0}
Dialogue: 0,0:04:11.25,0:04:13.16,Default,,0,0,0,,{\i1}Mahal kita.{\i0}
Dialogue: 0,0:04:15.17,0:04:17.81,Default,,0,0,0,,{\i1}Ikaw ang dahilan kung bakit gusto kong mabuhay pa.{\i0}
Dialogue: 0,0:04:17.84,0:04:18.81,Default,,0,0,0,,Hindi ka makapasok.
Dialogue: 0,0:04:18.84,0:04:21.41,Default,,0,0,0,,Bawal kang pumasok.
Dialogue: 0,0:04:28.64,0:04:31.51,Default,,0,0,0,,{\i1}Akala ko mas marami akong oras.{\i0}
Dialogue: 0,0:05:35.75,0:05:38.62,Default,,0,0,0,,Hinahanap namin si Hong Hae-in.
Dialogue: 0,0:05:39.25,0:05:42.49,Default,,0,0,0,,Ma'am, nasaan si Hong Hae-in?
Dialogue: 0,0:05:42.80,0:05:45.91,Default,,0,0,0,,{\i1}Hindi pa ako humihingi ng paumanhin sa lahat.{\i0}
Dialogue: 0,0:05:50.26,0:05:53.89,Default,,0,0,0,,{\i1}{\c&HFFFF&}Intensive Care Unit{\c}{\i0}
Dialogue: 0,0:06:22.38,0:06:24.24,Default,,0,0,0,,{\i1}Pasensya na.{\i0}
Dialogue: 0,0:06:31.76,0:06:33.96,Default,,0,0,0,,{\i1}Ikinalulungkot ko ang lahat.{\i0}
Dialogue: 0,0:06:40.77,0:06:41.90,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 11{\c}{\i0}
Dialogue: 0,0:06:57.66,0:06:59.70,Default,,0,0,0,,{\an8}Akala ko hindi mo siya nahanap.
Dialogue: 0,0:07:00.04,0:07:02.37,Default,,0,0,0,,{\an8}- Kita mo...\N- Lumabas ka.
Dialogue: 0,0:07:03.33,0:07:06.15,Default,,0,0,0,,{\an8}Ano ang nagbibigay sa iyo ng karapatan?\NHindi mo ito ospital.
Dialogue: 0,0:07:06.17,0:07:10.15,Default,,0,0,0,,{\an8}Pupuntahan mo ang chairman.\NGLumabas ka, dahil hindi kita papayagan.
Dialogue: 0,0:07:10.17,0:07:13.70,Default,,0,0,0,,Ang iyong anak ay nagtaksil sa iyo at inilipat siya dito,
Dialogue: 0,0:07:13.72,0:07:16.82,Default,,0,0,0,,so sa tingin mo ba ikaw pa rin ang legal guardian niya?
Dialogue: 0,0:07:16.85,0:07:19.34,Default,,0,0,0,,Sa tingin mo ba hahayaan kong mag-slide iyon?
Dialogue: 0,0:07:21.23,0:07:23.79,Default,,0,0,0,,Ako na mismo ang lalabas.
Dialogue: 0,0:07:23.81,0:07:26.18,Default,,0,0,0,,Huwag mo akong hawakan, pakiusap.
Dialogue: 0,0:07:31.24,0:07:32.94,Default,,0,0,0,,Darn it.
Dialogue: 0,0:07:34.03,0:07:37.11,Default,,0,0,0,,Hoy! Darn it!
Dialogue: 0,0:07:40.50,0:07:42.24,Default,,0,0,0,,Hoy!
Dialogue: 0,0:07:55.85,0:07:56.82,Default,,0,0,0,,{\i1}{\c&HFFFF&}Emergency Staircase{\c}{\i0}
Dialogue: 0,0:08:10.74,0:08:13.21,Default,,0,0,0,,- Buksan mo ang pinto.\N- Sorry, pero hindi ko kaya.
Dialogue: 0,0:08:13.24,0:08:15.52,Default,,0,0,0,,Hindi kita kinakausap. Buksan mo.
Dialogue: 0,0:08:21.29,0:08:23.11,Default,,0,0,0,,Ako rin!
Dialogue: 0,0:08:23.33,0:08:24.77,Default,,0,0,0,,Papasukin mo rin ako!
Dialogue: 0,0:08:24.79,0:08:28.02,Default,,0,0,0,,Tingnan mo. nakikiusap ako sayo.
Dialogue: 0,0:08:28.04,0:08:31.73,Default,,0,0,0,,Pakiusap. I'm sorry for being\Nso rude to you all this time.
Dialogue: 0,0:08:31.76,0:08:33.87,Default,,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:08:34.01,0:08:37.86,Default,,0,0,0,,Pakiusap makita ko ang tatay ko minsan lang.
Dialogue: 0,0:08:37.89,0:08:39.41,Default,,0,0,0,,Pakiusap.
Dialogue: 0,0:08:39.43,0:08:41.28,Default,,0,0,0,,Lumuhod ba ako?
Dialogue: 0,0:08:41.31,0:08:42.62,Default,,0,0,0,,Dapat ba?
Dialogue: 0,0:08:42.64,0:08:44.33,Default,,0,0,0,,Fine.
Dialogue: 0,0:08:44.35,0:08:46.47,Default,,0,0,0,,Fine? talaga?
Dialogue: 0,0:08:47.23,0:08:49.22,Default,,0,0,0,,Ibig mo bang sabihin?
Dialogue: 0,0:08:50.44,0:08:54.90,Default,,0,0,0,,Gusto kong umalis ka kaagad pagkatapos.\N kung hindi, kaladkarin ka palabas.
Dialogue: 0,0:08:55.66,0:08:59.69,Default,,0,0,0,,Salamat.
Dialogue: 0,0:09:17.22,0:09:19.00,Default,,0,0,0,,Ama?
Dialogue: 0,0:09:22.10,0:09:24.62,Default,,0,0,0,,Ama!
Dialogue: 0,0:09:24.64,0:09:25.95,Default,,0,0,0,,Ama!
Dialogue: 0,0:09:25.98,0:09:28.21,Default,,0,0,0,,Ama!
Dialogue: 0,0:09:28.23,0:09:31.17,Default,,0,0,0,,Nagising ka na!
Dialogue: 0,0:09:31.19,0:09:33.75,Default,,0,0,0,,I'm so proud of you!
Dialogue: 0,0:09:33.78,0:09:36.35,Default,,0,0,0,,Magaling ka!
Dialogue: 0,0:09:43.12,0:09:45.22,Default,,0,0,0,,Halika, ngayon na.
Dialogue: 0,0:09:45.25,0:09:48.37,Default,,0,0,0,,Hindi mo ba alam kung sino ako?
Dialogue: 0,0:09:50.08,0:09:51.81,Default,,0,0,0,,Sus.
Dialogue: 0,0:09:51.84,0:09:53.40,Default,,0,0,0,,{\i1}Ama!{\i0}
Dialogue: 0,0:09:53.42,0:09:56.58,Default,,0,0,0,,Ano? Namatay ba siya?
Dialogue: 0,0:09:57.09,0:09:59.42,Default,,0,0,0,,Ama!
Dialogue: 0,0:09:59.93,0:10:04.63,Default,,0,0,0,,Ama!
Dialogue: 0,0:10:14.90,0:10:16.89,Default,,0,0,0,,Wench mo.
Dialogue: 0,0:10:17.03,0:10:18.96,Default,,0,0,0,,Tapos ka na para.
Dialogue: 0,0:10:18.99,0:10:21.55,Default,,0,0,0,,Ginawa ka niyang legal na tagapag-alaga?
Dialogue: 0,0:10:21.57,0:10:23.22,Default,,0,0,0,,Gising na siya ngayon,
Dialogue: 0,0:10:23.24,0:10:27.39,Default,,0,0,0,,kaya nawalan ka ng kapangyarihan\Nof attorney ngayon. tama ba ako?
Dialogue: 0,0:10:27.41,0:10:29.95,Default,,0,0,0,,Oo, totoo iyan.
Dialogue: 0,0:10:30.12,0:10:33.74,Default,,0,0,0,,- Maghintay. Tawagan natin ang doktor niya...\N- Shut up!
Dialogue: 0,0:10:34.00,0:10:36.50,Default,,0,0,0,,Tumawag sa pulis.
Dialogue: 0,0:10:37.01,0:10:38.54,Default,,0,0,0,,Ama.
Dialogue: 0,0:10:38.72,0:10:40.61,Default,,0,0,0,,Siya iyon, di ba?
Dialogue: 0,0:10:40.64,0:10:43.96,Default,,0,0,0,,Sinaktan ka ng babaeng iyon, di ba?
Dialogue: 0,0:10:56.65,0:10:58.69,Default,,0,0,0,,Sino ka?
Dialogue: 0,0:11:11.58,0:11:13.33,Default,,0,0,0,,Ama...
Dialogue: 0,0:11:41.32,0:11:43.26,Default,,0,0,0,,Darn it!
Dialogue: 0,0:11:43.28,0:11:45.57,Default,,0,0,0,,Bakit mo rin ako pinapaalis?
Dialogue: 0,0:11:46.58,0:11:48.28,Default,,0,0,0,,Darn it.
Dialogue: 0,0:11:55.84,0:11:59.84,Default,,0,0,0,,{\i1}{\c&HFFFF&}Intensive Care Unit{\c}{\i0}
Dialogue: 0,0:12:12.94,0:12:16.81,Default,,0,0,0,,Ano ang... mali sa kanya?
Dialogue: 0,0:12:17.44,0:12:19.06,Default,,0,0,0,,Ina...
Dialogue: 0,0:12:20.73,0:12:21.88,Default,,0,0,0,,Ano bang problema niya?
Dialogue: 0,0:12:21.90,0:12:25.55,Default,,0,0,0,,Ang CT scan ay nagpapakita ng matinding pamamaga ng utak.
Dialogue: 0,0:12:25.57,0:12:28.01,Default,,0,0,0,,Na-pressure ang mga selula ng tumor sa utak\Nang mga tissue sa paligid,
Dialogue: 0,0:12:28.03,0:12:30.30,Default,,0,0,0,,at pansamantalang tumaas\Nher intracranial pressure.
Dialogue: 0,0:12:30.33,0:12:31.56,Default,,0,0,0,,Babaan muna natin...
Dialogue: 0,0:12:31.58,0:12:33.52,Default,,0,0,0,,Brain tumor?
Dialogue: 0,0:12:33.54,0:12:35.66,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:12:36.63,0:12:41.15,Default,,0,0,0,,Alam mo ba ang lahat\NHae-in na inihayag? talaga?
Dialogue: 0,0:12:41.17,0:12:44.32,Default,,0,0,0,,- Honey.\N- Saka bakit hindi mo sinabi sa amin? Bakit?
Dialogue: 0,0:12:44.34,0:12:45.90,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:12:45.93,0:12:48.22,Default,,0,0,0,,Dapat sinabi mo sa amin na may sakit siya.
Dialogue: 0,0:12:48.25,0:12:49.28,Default,,0,0,0,,Bakit hindi mo ginawa?
Dialogue: 0,0:12:49.31,0:12:51.46,Default,,0,0,0,,- Stop.\N- Niloko na naman niya tayo!
Dialogue: 0,0:12:55.02,0:12:56.91,Default,,0,0,0,,Inilihim niya ito sa amin.
Dialogue: 0,0:12:56.94,0:12:59.37,Default,,0,0,0,,Niloko niya tayo noong si\NHae-in ay ganito kalubha.
Dialogue: 0,0:12:59.40,0:13:02.77,Default,,0,0,0,,- Ano ang pinaplano mo this time?\N- Sabi ko tumigil ka na.
Dialogue: 0,0:13:07.24,0:13:09.61,Default,,0,0,0,,Wala kaming karapatang magalit.
Dialogue: 0,0:13:18.00,0:13:19.70,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:13:20.34,0:13:22.73,Default,,0,0,0,,Wala kaming ideya,
Dialogue: 0,0:13:22.76,0:13:25.54,Default,,0,0,0,,sa kabila ng pagiging magulang niya.
Dialogue: 0,0:13:26.13,0:13:27.88,Default,,0,0,0,,Pakipaliwanag.
Dialogue: 0,0:13:28.51,0:13:30.67,Default,,0,0,0,,Paki-elaborate...
Dialogue: 0,0:13:31.18,0:13:34.99,Default,,0,0,0,,sa kanyang kasalukuyang kondisyon.
Dialogue: 0,0:13:35.02,0:13:39.00,Default,,0,0,0,,Ms. Si Hong ay dumaranas ng Cloud Cytoma.
Dialogue: 0,0:13:39.02,0:13:41.81,Default,,0,0,0,,Ito ay isang uri ng malignant na tumor sa utak.
Dialogue: 0,0:13:41.90,0:13:45.63,Default,,0,0,0,,Hindi tulad ng iyong tipikal na tumor, kung saan ang tumor ay...
Dialogue: 0,0:13:45.65,0:13:47.09,Default,,0,0,0,,isang malaking bukol,
Dialogue: 0,0:13:47.11,0:13:50.84,Default,,0,0,0,, kumalat ang mga tumor cell na ito\Nsa buong cranial nerves niya na parang ulap.
Dialogue: 0,0:13:50.87,0:13:55.15,Default,,0,0,0,,Ang kaso niya ay isang napakabihirang kaso sa buong mundo,
Dialogue: 0,0:13:55.25,0:13:57.91,Default,,0,0,0,,kaya naging mahirap na tratuhin siya.
Dialogue: 0,0:14:09.84,0:14:12.13,Default,,0,0,0,,Paumanhin, Inay.
Dialogue: 0,0:14:45.17,0:14:48.61,Default,,0,0,0,,Ikinalulungkot ko talaga na hindi ko sinabi sa iyo ng mas maaga.
Dialogue: 0,0:14:48.63,0:14:51.54,Default,,0,0,0,,Sinabi niya sigurong huwag.
Dialogue: 0,0:14:51.93,0:14:54.42,Default,,0,0,0,,Ito ay malamang na isang malaking pasanin.
Dialogue: 0,0:14:59.02,0:15:01.54,Default,,0,0,0,,Ayaw ni Hae-in sa kanyang mga magulang...
Dialogue: 0,0:15:01.56,0:15:03.42,Default,,0,0,0,,na maging heartbroken,
Dialogue: 0,0:15:03.44,0:15:07.52,Default,,0,0,0,,kaya gusto niyang sabihin sa iyo\Nonce things are looking up.
Dialogue: 0,0:15:08.15,0:15:11.23,Default,,0,0,0,,Sana hindi ka magkamali ng ideya.
Dialogue: 0,0:15:33.26,0:15:35.09,Default,,0,0,0,,{\i1}{\c&HFFFF&}{\i1}{\c&HFFFF00&}Tatay.{\c&HFFFF&}{\i0}{\c}{\i0}
Dialogue: 0,0:15:41.44,0:15:45.00,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Sa pamamagitan ng malawak at walang katapusang karagatan{\i0} ♫{\c}
Dialogue: 0,0:15:45.02,0:15:48.79,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}tumayo sa isang maliit na cottage{\i0} ♫{\c}
Dialogue: 0,0:15:48.82,0:15:52.09,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Tirahan ang isang ama na mangingisda{\i0} ♫{\c}
Dialogue: 0,0:15:52.11,0:15:55.59,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}at ang kanyang anak na babae{\i0} ♫{\c}
Dialogue: 0,0:15:55.62,0:15:58.85,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Oh my love, oh my love{\i0} ♫{\c}
Dialogue: 0,0:15:58.87,0:16:01.97,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Oh mahal ko, Clementine{\i0} ♫{\c}
Dialogue: 0,0:16:02.00,0:16:05.48,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Bakit mo ako iniwan ng tuluyan?{\i0} ♫{\c}
Dialogue: 0,0:16:05.50,0:16:09.04,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Pag-iiwan sa iyong matandang ama{\i0} ♫{\c}
Dialogue: 0,0:16:21.89,0:16:23.27,Default,,0,0,0,,Paghuhusga sa mga resulta ng MRI,
Dialogue: 0,0:16:23.29,0:16:26.64,Default,,0,0,0,,Naniniwala ako na mayroon siyang vascular dementia dahil\Nto sa isang pinsala sa ulo at pagdurugo ng utak.
Dialogue: 0,0:16:26.66,0:16:29.23,Default,,0,0,0,,Ang malaking pinsala sa kanyang\Nfrontal at temporal na lobes...
Dialogue: 0,0:16:29.25,0:16:32.26,Default,,0,0,0,,ay nagpapahirap sa kanya na\Nmag-isip ng makatwiran o maalala ang mga bagay.
Dialogue: 0,0:16:32.28,0:16:37.55,Default,,0,0,0,,Sa ngayon, wala tayong choice kundi\Nmaghintay hanggang gumaling ang utak niya.
Dialogue: 0,0:16:37.57,0:16:39.34,Default,,0,0,0,,Bigyan natin siya ng dalawang linggo.
Dialogue: 0,0:16:39.37,0:16:41.14,Default,,0,0,0,,Ibig sabihin makaka-recover siya?
Dialogue: 0,0:16:41.16,0:16:44.74,Default,,0,0,0,,Nag-iiba-iba ito sa bawat kaso, kaya\NI ay walang magagarantiyahan.
Dialogue: 0,0:17:12.28,0:17:13.81,Default,,0,0,0,,Seon-hwa.
Dialogue: 0,0:17:16.16,0:17:17.69,Default,,0,0,0,,Dapat natulala ka.
Dialogue: 0,0:17:18.03,0:17:20.09,Default,,0,0,0,,Narinig ko lang, at...
Dialogue: 0,0:17:20.12,0:17:22.61,Default,,0,0,0,,Alam mong may sakit siya.
Dialogue: 0,0:17:23.45,0:17:27.03,Default,,0,0,0,,Kaya nga sinabi mo sa akin\Nhuwag akong gumawa ng mga bagay na pagsisisihan ko.
Dialogue: 0,0:17:31.75,0:17:33.62,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:17:37.09,0:17:39.46,Default,,0,0,0,,Alam ng lahat.
Dialogue: 0,0:17:39.97,0:17:42.17,Default,,0,0,0,,Alam ng lahat maliban sa akin.
Dialogue: 0,0:17:46.44,0:17:48.09,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pero Nanay,{\c}{\i0}
Dialogue: 0,0:17:48.48,0:17:52.43,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sinabi ko lang sa iyo na mayroon din akong seryosong bagay.{\c}{\i0}
Dialogue: 0,0:17:52.82,0:17:54.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi ka ba curious?{\c}{\i0}
Dialogue: 0,0:17:54.36,0:17:58.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Palagi mong alam kung ano ang gagawin,\Nmalaki man ito o maliit.{\c}{\i0}
Dialogue: 0,0:17:58.78,0:18:00.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tama.{\c}{\i0}
Dialogue: 0,0:18:01.03,0:18:02.94,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ako na ang bahala...{\c}{\i0}
Dialogue: 0,0:18:03.37,0:18:05.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ng aking negosyo.{\c}{\i0}
Dialogue: 0,0:18:07.25,0:18:09.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sus, huwag kang masyadong madrama.{\c}{\i0}
Dialogue: 0,0:18:09.75,0:18:11.14,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anemic din ako.{\c}{\i0}
Dialogue: 0,0:18:11.17,0:18:14.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nahihilo din ako, since\NI hindi rin masyadong makatulog.{\c}{\i0}
Dialogue: 0,0:18:14.13,0:18:17.28,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hindi rin maganda si Soo-cheol.{\c}{\i0}
Dialogue: 0,0:18:17.30,0:18:19.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Lahat tayo ay naghihirap dito.{\c}{\i0}
Dialogue: 0,0:19:58.90,0:20:00.46,Default,,0,0,0,,- Ano?\N- {\i1}Ano ito tungkol kay Hae-in?{\i0}
Dialogue: 0,0:20:00.49,0:20:02.76,Default,,0,0,0,,Totoo ba? May sakit ba siya?
Dialogue: 0,0:20:02.78,0:20:04.22,Default,,0,0,0,,I doubt na alam ng pamilya niya,
Dialogue: 0,0:20:04.24,0:20:05.76,Default,,0,0,0,,kahit si Soo-cheol.
Dialogue: 0,0:20:05.78,0:20:07.98,Default,,0,0,0,,{\i1}Tiyak na nabigla siya.{\i0}
Dialogue: 0,0:20:12.21,0:20:13.85,Default,,0,0,0,,Kaya ka tumawag?
Dialogue: 0,0:20:13.87,0:20:15.69,Default,,0,0,0,,Ito ay isang maliit na pabor.
Dialogue: 0,0:20:15.71,0:20:19.15,Default,,0,0,0,,May anxiety disorder siya.\N nangyayari ito kapag na-stress siya.
Dialogue: 0,0:20:19.17,0:20:21.36,Default,,0,0,0,,{\i1}Seryoso. Kailangan niya ng gamot.{\i0}
Dialogue: 0,0:20:21.38,0:20:23.57,Default,,0,0,0,,Sa tingin ko wala siyang kinuha.
Dialogue: 0,0:20:23.59,0:20:27.11,Default,,0,0,0,,Mayroon kami sa bahay. Maaari bang sabihin mo sa isang tao na kunin ito?
Dialogue: 0,0:20:27.14,0:20:28.24,Default,,0,0,0,,- Ito ay...\N- {\i1}Hey.{\i0}
Dialogue: 0,0:20:28.26,0:20:31.08,Default,,0,0,0,,- Cheon Da-hye.\N- Baka himatayin siya at mamatay!
Dialogue: 0,0:20:31.10,0:20:34.47,Default,,0,0,0,,- Tapos hayaan mo siyang mamatay.\N- Hoy, paano mo...?
Dialogue: 0,0:20:35.19,0:20:37.37,Default,,0,0,0,,Ano ang gusto mong gawin ko?
Dialogue: 0,0:20:37.40,0:20:39.38,Default,,0,0,0,,Papatayin ko ba siya?
Dialogue: 0,0:20:39.40,0:20:42.35,Default,,0,0,0,,Huwag mo na akong tatawagan\Nover something like this,
Dialogue: 0,0:20:42.69,0:20:45.02,Default,,0,0,0,,o ako mismo ang papatay sa kanya.
Dialogue: 0,0:20:56.33,0:20:57.87,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:21:02.88,0:21:04.83,Default,,0,0,0,,Sa tingin ko ito ang dahilan.
Dialogue: 0,0:21:05.01,0:21:06.71,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:21:10.01,0:21:11.74,Default,,0,0,0,,Ano iyon?
Dialogue: 0,0:21:11.77,0:21:14.38,Default,,0,0,0,,Inutusan akong dalhin ito...
Dialogue: 0,0:21:16.44,0:21:18.75,Default,,0,0,0,,kaya masupil nito ang kanyang lakas.
Dialogue: 0,0:21:18.77,0:21:21.06,Default,,0,0,0,,Hindi ako naniwala.
Dialogue: 0,0:21:21.57,0:21:24.64,Default,,0,0,0,,Gusto ko lang maging mas magaling sa kanya kahit minsan,
Dialogue: 0,0:21:25.65,0:21:27.56,Default,,0,0,0,,pero...
Dialogue: 0,0:21:27.82,0:21:29.55,Default,,0,0,0,,paano kung ang kahabag-habag na anting-anting na ito...
Dialogue: 0,0:21:29.57,0:21:35.07,Default,,0,0,0,,ang dahilan kaya siya nagkasakit?
Dialogue: 0,0:21:35.37,0:21:36.81,Default,,0,0,0,,Kasalanan ko ang lahat.
Dialogue: 0,0:21:36.83,0:21:39.91,Default,,0,0,0,,Hindi ko dapat dinala ang tangang talisman na ito.
Dialogue: 0,0:22:00.06,0:22:01.76,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:22:01.98,0:22:03.81,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:22:07.65,0:22:10.86,Default,,0,0,0,,Paano ang isang anting-anting? Baliw ka.
Dialogue: 0,0:22:13.58,0:22:17.31,Default,,0,0,0,,Nakita mo ba yun? Ang\Ntalisman na ito ay dapat na makapangyarihan.
Dialogue: 0,0:22:17.33,0:22:20.12,Default,,0,0,0,,Nagising siya nang mapunit ko ito.
Dialogue: 0,0:22:20.46,0:22:22.08,Default,,0,0,0,,Soo-cheol.
Dialogue: 0,0:22:22.59,0:22:25.00,Default,,0,0,0,,Pasensya na...
Dialogue: 0,0:22:26.51,0:22:28.04,Default,,0,0,0,,para sa lahat.
Dialogue: 0,0:22:29.51,0:22:33.92,Default,,0,0,0,,Hyun-woo, I don't think she's in her right mind.
Dialogue: 0,0:22:35.64,0:22:37.33,Default,,0,0,0,,Kunin ang doktor at ang pamilya.
Dialogue: 0,0:22:37.35,0:22:39.14,Default,,0,0,0,,Ang aming pamilya...
Dialogue: 0,0:22:53.45,0:22:55.90,Default,,0,0,0,,- Okay ka lang?\N- Mahal kita.
Dialogue: 0,0:22:59.08,0:23:01.53,Default,,0,0,0,,Minahal kita...
Dialogue: 0,0:23:01.63,0:23:03.53,Default,,0,0,0,,mula sa sandaling nagkakilala tayo...
Dialogue: 0,0:23:04.29,0:23:05.83,Default,,0,0,0,,hanggang ngayon.
Dialogue: 0,0:23:08.67,0:23:11.79,Default,,0,0,0,,I'm sorry kung hindi kita tinatrato ng mas maayos.
Dialogue: 0,0:23:12.55,0:23:15.67,Default,,0,0,0,,Ikinalulungkot ko rin na iniwan kitang mag-isa...
Dialogue: 0,0:23:16.77,0:23:18.30,Default,,0,0,0,,sa aking pamilya.
Dialogue: 0,0:23:20.14,0:23:23.35,Default,,0,0,0,,Sa palagay ko ay alam na ng isang bahagi ko...
Dialogue: 0,0:23:23.98,0:23:25.97,Default,,0,0,0,,gusto mo ng divorce.
Dialogue: 0,0:23:28.36,0:23:29.96,Default,,0,0,0,,Nagtiis ka sa amin ng napakatagal,
Dialogue: 0,0:23:29.99,0:23:31.90,Default,,0,0,0,,kaya...
Dialogue: 0,0:23:32.74,0:23:35.57,Default,,0,0,0,,ayos lang. Huwag kang sumama.
Dialogue: 0,0:23:43.29,0:23:45.12,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:23:45.17,0:23:48.00,Default,,0,0,0,,Kung hindi ko sasabihin ang mga bagay na ito bago ako mamatay,
Dialogue: 0,0:23:49.17,0:23:52.50,Default,,0,0,0,,hindi mo malalaman ang tunay kong nararamdaman.
Dialogue: 0,0:23:54.80,0:23:56.84,Default,,0,0,0,,Sinasabi ko na sa iyo ito ngayon,
Dialogue: 0,0:23:57.85,0:24:00.09,Default,,0,0,0,,dahil hindi ko alam kung kailan ako mamamatay.
Dialogue: 0,0:24:15.91,0:24:17.94,Default,,0,0,0,,Kagabi,
Dialogue: 0,0:24:19.29,0:24:22.53,Default,,0,0,0,,Nagdasal ako nang higit pa kaysa sa buong buhay ko.
Dialogue: 0,0:24:25.25,0:24:27.74,Default,,0,0,0,,Sabi ko wala akong gagawin...
Dialogue: 0,0:24:28.34,0:24:30.71,Default,,0,0,0,,pero umiiyak araw-araw,
Dialogue: 0,0:24:31.42,0:24:33.37,Default,,0,0,0,,uminom ng isang toneladang alak,
Dialogue: 0,0:24:34.01,0:24:35.79,Default,,0,0,0,,tulog sa kalye,
Dialogue: 0,0:24:36.30,0:24:38.55,Default,,0,0,0,,at mamuhay nang walang ingat...
Dialogue: 0,0:24:39.51,0:24:41.59,Default,,0,0,0,,kung namatay ka.
Dialogue: 0,0:24:45.15,0:24:47.35,Default,,0,0,0,,Banta yan, hindi panalangin.
Dialogue: 0,0:24:53.57,0:24:55.35,Default,,0,0,0,,Wala akong pakialam.
Dialogue: 0,0:24:56.03,0:24:58.11,Default,,0,0,0,,Kung mamatay ka,
Dialogue: 0,0:24:59.49,0:25:00.89,Default,,0,0,0,,Isusuko ko ang sarili ko.
Dialogue: 0,0:25:00.91,0:25:01.97,Default,,0,0,0,,Manood ka lang.
Dialogue: 0,0:25:02.00,0:25:04.43,Default,,0,0,0,,Paano ako makakapanood kapag patay na ako?
Dialogue: 0,0:25:04.46,0:25:06.99,Default,,0,0,0,,Kaya putulin mo na ang kalokohan.
Dialogue: 0,0:25:07.17,0:25:09.45,Default,,0,0,0,,Binubuksan ko ang puso ko sa iyo.
Dialogue: 0,0:25:12.05,0:25:13.87,Default,,0,0,0,,Natakot pa nga ako...
Dialogue: 0,0:25:13.92,0:25:16.67,Default,,0,0,0,,sa pagtulog ko, kaso hindi ko...
Dialogue: 0,0:25:17.14,0:25:19.05,Default,,0,0,0,,para sabihin sa iyo.
Dialogue: 0,0:25:20.51,0:25:22.30,Default,,0,0,0,,Huwag kang matakot.
Dialogue: 0,0:25:23.89,0:25:26.01,Default,,0,0,0,,Hindi ka mamamatay.
Dialogue: 0,0:25:34.28,0:25:36.60,Default,,0,0,0,,Hindi ka mamamatay.
Dialogue: 0,0:25:37.86,0:25:39.94,Default,,0,0,0,,Hindi kita papayagan.
Dialogue: 0,0:25:58.64,0:26:00.15,Default,,0,0,0,,{\i1}{\c&HFFFF&}Endoscopy{\c}{\i0}
Dialogue: 0,0:26:00.18,0:26:01.53,Default,,0,0,0,,Nay!
Dialogue: 0,0:26:01.55,0:26:04.63,Default,,0,0,0,,Nagising si Hae-in! Bilisan mo!
Dialogue: 0,0:26:21.62,0:26:24.15,Default,,0,0,0,,Saan siya nagpunta?
Dialogue: 0,0:26:25.75,0:26:28.93,Default,,0,0,0,,Bakit hindi mo sinabi sa amin ang tungkol dito?
Dialogue: 0,0:26:28.96,0:26:31.98,Default,,0,0,0,,Pero okay lang. Alam ko na ang tungkol dito ngayon.
Dialogue: 0,0:26:32.00,0:26:36.02,Default,,0,0,0,,Huwag mag-alala. Marami sa aking malalapit na kaibigan ay mga kilalang doktor.
Dialogue: 0,0:26:36.05,0:26:37.65,Default,,0,0,0,,Nasa buong mundo sila.
Dialogue: 0,0:26:37.67,0:26:41.34,Default,,0,0,0,,Talaga? Dapat sinabi ko sayo ng mas maaga.
Dialogue: 0,0:26:46.73,0:26:48.26,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:26:50.98,0:26:55.04,Default,,0,0,0,,Bakit ka nagso-sorry? Ikaw ang may sakit.
Dialogue: 0,0:26:55.07,0:26:57.88,Default,,0,0,0,,Dapat sinabi mo sa akin ng mas maaga.
Dialogue: 0,0:26:57.90,0:27:01.15,Default,,0,0,0,,Napakasakit sigurong ilihim ito.
Dialogue: 0,0:27:01.66,0:27:03.98,Default,,0,0,0,,Okay ka na ngayon.
Dialogue: 0,0:27:04.45,0:27:06.47,Default,,0,0,0,,Magiging maayos ang lahat. Okay?
Dialogue: 0,0:27:06.49,0:27:08.03,Default,,0,0,0,,Okay.
Dialogue: 0,0:27:15.59,0:27:17.33,Default,,0,0,0,,Nasaan si Nanay?
Dialogue: 0,0:27:35.36,0:27:36.93,Default,,0,0,0,,Ina.
Dialogue: 0,0:27:37.32,0:27:39.34,Default,,0,0,0,,Hayaan mo akong mag-isa.
Dialogue: 0,0:27:39.36,0:27:43.11,Default,,0,0,0,,I'm really sorry hindi ko sinabi sa iyo...
Dialogue: 0,0:27:43.37,0:27:45.11,Default,,0,0,0,,mas maaga.
Dialogue: 0,0:27:46.53,0:27:48.15,Default,,0,0,0,,Kalimutan mo na ito.
Dialogue: 0,0:27:48.20,0:27:50.49,Default,,0,0,0,,Anong klaseng ina...
Dialogue: 0,0:27:51.21,0:27:54.19,Default,,0,0,0,,hindi niya alam na namamatay ang anak niya?
Dialogue: 0,0:27:54.21,0:27:57.37,Default,,0,0,0,,Wala akong alam tungkol sa sarili kong anak.
Dialogue: 0,0:28:03.26,0:28:04.86,Default,,0,0,0,,Nakakaawa.
Dialogue: 0,0:28:04.89,0:28:07.45,Default,,0,0,0,,Hindi ako makapaniwala na nailabas ko ang sakit ko...
Dialogue: 0,0:28:07.47,0:28:10.59,Default,,0,0,0,,sa sarili kong anak.
Dialogue: 0,0:28:12.48,0:28:15.30,Default,,0,0,0,,Sa tuwing inaabot ako ng batang iyon...
Dialogue: 0,0:28:19.32,0:28:20.85,Default,,0,0,0,,{\i1}Hindi ko siya hinawakan...{\i0}
Dialogue: 0,0:28:21.82,0:28:24.02,Default,,0,0,0,,{\i1}kahit isang beses.{\i0}
Dialogue: 0,0:28:38.55,0:28:40.94,Default,,0,0,0,,{\i1}Kahit ako hindi ko kayang mabuhay sa sarili ko.{\i0}
Dialogue: 0,0:28:40.96,0:28:43.58,Default,,0,0,0,,Ayaw kong magkaroon ng nanay na katulad ko.
Dialogue: 0,0:28:49.06,0:28:50.71,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:28:51.31,0:28:53.04,Default,,0,0,0,,Kasalanan ko ang lahat.
Dialogue: 0,0:28:53.06,0:28:56.33,Default,,0,0,0,,Nagdulot ako ng anak ko...
Dialogue: 0,0:28:56.35,0:28:59.85,Default,,0,0,0,,sakit at stress.
Dialogue: 0,0:29:00.61,0:29:03.06,Default,,0,0,0,,Kaya siya may sakit.
Dialogue: 0,0:29:24.42,0:29:26.50,Default,,0,0,0,,Doktor ka ba?
Dialogue: 0,0:29:32.81,0:29:36.39,Default,,0,0,0,,Paano mo malalaman ang mga bagay\Na hindi alam ng doktor?
Dialogue: 0,0:29:36.44,0:29:40.08,Default,,0,0,0,,Hindi nila alam ang dahilan,\Ni kung paano maiiwasan ang sakit ko.
Dialogue: 0,0:29:40.11,0:29:42.92,Default,,0,0,0,,Hindi rin ito sanhi ng stress.
Dialogue: 0,0:29:42.94,0:29:45.10,Default,,0,0,0,,Kumusta ka...
Dialogue: 0,0:29:51.12,0:29:53.11,Default,,0,0,0,,naïve?
Dialogue: 0,0:29:53.66,0:29:55.70,Default,,0,0,0,,Nakakainis ka.
Dialogue: 0,0:29:59.83,0:30:01.37,Default,,0,0,0,,At...
Dialogue: 0,0:30:03.59,0:30:05.33,Default,,0,0,0,,Mahihirapan ako...
Dialogue: 0,0:30:06.22,0:30:08.50,Default,,0,0,0,,para magkaroon din ng anak na katulad ko,
Dialogue: 0,0:30:08.55,0:30:10.67,Default,,0,0,0,,kaya hindi mo kasalanan ang lahat.
Dialogue: 0,0:30:11.47,0:30:13.01,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:30:32.95,0:30:34.82,Default,,0,0,0,,Masakit ba...
Dialogue: 0,0:30:35.45,0:30:37.61,Default,,0,0,0,,marami?
Dialogue: 0,0:30:43.04,0:30:45.08,Default,,0,0,0,,Well...
Dialogue: 0,0:30:45.21,0:30:49.00,Default,,0,0,0,,May mga pagkakataon na\Nsakit at mga oras na hindi.
Dialogue: 0,0:30:54.51,0:30:57.42,Default,,0,0,0,,Hindi ko alam na may sakit ka.
Dialogue: 0,0:30:57.77,0:30:59.55,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:31:00.10,0:31:02.05,Default,,0,0,0,,Kasalanan ko ang lahat.
Dialogue: 0,0:31:02.48,0:31:05.18,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:31:05.23,0:31:07.69,Default,,0,0,0,,Nagkamali ako.
Dialogue: 0,0:31:09.07,0:31:11.15,Default,,0,0,0,,Sabi ko sayo.
Dialogue: 0,0:31:11.24,0:31:14.39,Default,,0,0,0,,Wala itong kinalaman sa pagtrato mo sa akin.
Dialogue: 0,0:31:14.41,0:31:17.28,Default,,0,0,0,,Ayokong sabihin sayo, kasi alam ko...
Dialogue: 0,0:31:19.41,0:31:21.66,Default,,0,0,0,,hindi mo maiintindihan.
Dialogue: 0,0:31:24.75,0:31:26.29,Default,,0,0,0,,Pasensya na.
Dialogue: 0,0:31:26.38,0:31:27.98,Default,,0,0,0,,Ako ay...
Dialogue: 0,0:31:28.01,0:31:30.71,Default,,0,0,0,,I'm really sorry.
Dialogue: 0,0:31:31.93,0:31:33.84,Default,,0,0,0,,Hindi ako mabubuhay...
Dialogue: 0,0:31:34.26,0:31:36.34,Default,,0,0,0,,kung wala ka.
Dialogue: 0,0:31:36.51,0:31:38.87,Default,,0,0,0,,Hindi.
Dialogue: 0,0:31:38.89,0:31:40.72,Default,,0,0,0,,Huwag mamatay.
Dialogue: 0,0:31:43.10,0:31:47.31,Default,,0,0,0,,Huwag kang mamatay, Hae-in. pasensya na po...
Dialogue: 0,0:32:00.87,0:32:02.99,Default,,0,0,0,,Mahal kong Hae-in...
Dialogue: 0,0:32:12.05,0:32:15.29,Default,,0,0,0,,I'm sorry...
Dialogue: 0,0:32:30.65,0:32:34.72,Default,,0,0,0,,Kakampi lang niya si Lady Luck, since\Nnapakasipag ng evil wench na iyon.
Dialogue: 0,0:32:34.74,0:32:37.48,Default,,0,0,0,,Siya ay bagay.
Dialogue: 0,0:32:48.29,0:32:49.44,Default,,0,0,0,,Chairman Hong.
Dialogue: 0,0:32:49.46,0:32:52.08,Default,,0,0,0,,Nakikilala mo ba kung nasaan kami?
Dialogue: 0,0:32:56.97,0:33:00.76,Default,,0,0,0,,Halika, huwag kang matakot. Nakauwi na kami.
Dialogue: 0,0:33:01.89,0:33:03.88,Default,,0,0,0,,Pumasok na tayo sa loob.
Dialogue: 0,0:33:10.86,0:33:15.52,Default,,0,0,0,,Ma'am, maraming magagandang\Nelectric wheelchairs ngayon.
Dialogue: 0,0:33:42.52,0:33:46.41,Default,,0,0,0,,Maaaring wala na ang chairman,\Npero tumanggi siyang pakainin...
Dialogue: 0,0:33:46.44,0:33:47.62,Default,,0,0,0,,ng sinuman maliban sa akin,
Dialogue: 0,0:33:47.65,0:33:51.08,Default,,0,0,0,,kaya hindi ko siya maiwan. Kaya't hiniling kong pumunta ka rito.
Dialogue: 0,0:33:51.11,0:33:54.80,Default,,0,0,0,,Naiintindihan namin. It's only\Nthanks to you nagising na siya.
Dialogue: 0,0:33:54.82,0:33:57.17,Default,,0,0,0,,Sapat na sa pambobola. Ipaliwanag ang iyong sarili.
Dialogue: 0,0:33:57.20,0:33:59.76,Default,,0,0,0,,Paano siya magdaraos ng ganyang\Npress conference ngayon?
Dialogue: 0,0:33:59.78,0:34:02.55,Default,,0,0,0,,Wala rin kaming ideya.\NChairman Yoon biglang...
Dialogue: 0,0:34:02.58,0:34:04.05,Default,,0,0,0,,Dapat mas alam mo.
Dialogue: 0,0:34:04.08,0:34:06.18,Default,,0,0,0,,Malaki lang ang binabayaran mo...
Dialogue: 0,0:34:06.21,0:34:09.27,Default,,0,0,0,,para maiwasan mo ang mga ganitong kalamidad na mangyari.
Dialogue: 0,0:34:09.29,0:34:11.40,Default,,0,0,0,,Goodness, hindi ko ba dapat sinabi iyon?
Dialogue: 0,0:34:11.42,0:34:13.73,Default,,0,0,0,,"Wala kang karapatang magsabi ng mga ganyan sa amin."
Dialogue: 0,0:34:13.76,0:34:16.53,Default,,0,0,0,,"Ano ang alam mo, kapag ikaw ay\Nluto at nars ang chairman?"
Dialogue: 0,0:34:16.55,0:34:19.49,Default,,0,0,0,,- Yun ba?\N- Syempre hindi ma'am.
Dialogue: 0,0:34:19.51,0:34:22.61,Default,,0,0,0,,Kung ganoon, isumite ang lahat ng\Ndraft sa akin bago mo ibigay ang mga ito...
Dialogue: 0,0:34:22.64,0:34:26.16,Default,,0,0,0,,kay Chairman Yoon, at sabihin sa\NPR team na pumunta bukas ng umaga.
Dialogue: 0,0:34:26.18,0:34:27.79,Default,,0,0,0,,Para saan?
Dialogue: 0,0:34:27.81,0:34:30.12,Default,,0,0,0,,Hindi mo ba binabasa ang balita? Galit na galit ang publiko.
Dialogue: 0,0:34:30.15,0:34:33.73,Default,,0,0,0,,Nakikiramay sila sa\Nformer na pamamahala at pinupuna kami.
Dialogue: 0,0:34:33.76,0:34:36.50,Default,,0,0,0,,Ako lang ba ang nag-aalala\Natungkol sa pagbagsak ng mga presyo ng stock?
Dialogue: 0,0:34:36.52,0:34:38.51,Default,,0,0,0,,Galit na galit ang mga anchor limited partners.
Dialogue: 0,0:34:38.53,0:34:39.76,Default,,0,0,0,,Nag-aalala sila na...
Dialogue: 0,0:34:39.78,0:34:42.47,Default,,0,0,0,,maaantala ang exit point\Ndahil sa pabagsak na stock.
Dialogue: 0,0:34:42.49,0:34:45.94,Default,,0,0,0,,May tsismis na gusto nilang magtakda\Nup ng co-general-partner investor.
Dialogue: 0,0:34:46.00,0:34:49.56,Default,,0,0,0,,Kailangan nating hanapin ang secret fund\Kung gusto natin silang tumahimik.
Dialogue: 0,0:34:49.58,0:34:50.77,Default,,0,0,0,,Nahukay mo ba ito?
Dialogue: 0,0:34:50.79,0:34:53.27,Default,,0,0,0,,Oo, nakumpirma na si Jamal Ibrahim,
Dialogue: 0,0:34:53.29,0:34:56.98,Default,,0,0,0,,ang presidente ng bangko ng LCC\NInvestment Bank sa Labuan, Malaysia,
Dialogue: 0,0:34:57.01,0:34:58.69,Default,,0,0,0,,pinamahalaan ang account.
Dialogue: 0,0:34:58.72,0:35:01.36,Default,,0,0,0,,Sa tingin ko binawi niya ang\Npera at inilipat ito.
Dialogue: 0,0:35:01.39,0:35:03.55,Default,,0,0,0,,- Magkano?\N- Halos $900 milyon.
Dialogue: 0,0:35:04.60,0:35:06.83,Default,,0,0,0,,Magpadala ng isang tao sa Labuan ngayon din.
Dialogue: 0,0:35:06.85,0:35:09.64,Default,,0,0,0,,Alamin ang susunod na ruta.
Dialogue: 0,0:35:09.81,0:35:13.51,Default,,0,0,0,,Kilala ang restaurant na ito sa kanilang {\i1}kal-guksu.{\i0}
Dialogue: 0,0:35:13.82,0:35:16.56,Default,,0,0,0,,- Subukan mong kumain.\N- Sorry.
Dialogue: 0,0:35:16.86,0:35:18.85,Default,,0,0,0,,Sa tingin ko hindi ko kaya.
Dialogue: 0,0:35:19.82,0:35:23.36,Default,,0,0,0,,Kailangan mong kumain ng maayos sa mga oras na ganito.
Dialogue: 0,0:35:23.62,0:35:25.05,Default,,0,0,0,,Umaasa sa iyo ang iyong pamilya.
Dialogue: 0,0:35:25.08,0:35:29.14,Default,,0,0,0,,Kailangan mong manatiling matatag kung gusto mong gawin din ng iyong mga anak.
Dialogue: 0,0:35:29.16,0:35:32.07,Default,,0,0,0,,Hindi nila ako tinitingnan para sa lakas.
Dialogue: 0,0:35:32.46,0:35:34.35,Default,,0,0,0,,Hindi ako ang haligi ng pamilya namin.
Dialogue: 0,0:35:34.38,0:35:37.98,Default,,0,0,0,,Sa katunayan, ang tatay ko noon pa man.
Dialogue: 0,0:35:38.01,0:35:41.88,Default,,0,0,0,,Nakakasakit ako minsan, pero sa totoo lang gumaan din ang\NI.
Dialogue: 0,0:35:43.43,0:35:45.03,Default,,0,0,0,,Pathetic, tama ba?
Dialogue: 0,0:35:45.05,0:35:47.70,Default,,0,0,0,,Nagaan ang loob ko na hindi umaasa sa akin ang mga anak ko.
Dialogue: 0,0:35:47.72,0:35:50.88,Default,,0,0,0,,Ang aking anak na babae ay namamatay,
Dialogue: 0,0:35:52.65,0:35:55.93,Default,,0,0,0,,at sinabi ko sa kanya na magtiwala ako,
Dialogue: 0,0:35:56.02,0:35:59.55,Default,,0,0,0,,pero duda ako na may ibig sabihin iyon sa kanya.
Dialogue: 0,0:35:59.57,0:36:01.26,Default,,0,0,0,,Mali ka.
Dialogue: 0,0:36:01.28,0:36:03.34,Default,,0,0,0,,Hindi ganoon ang tingin sa amin ng aming mga anak.
Dialogue: 0,0:36:03.36,0:36:05.68,Default,,0,0,0,,Namatay ang aking ama bago ang kanyang panahon,
Dialogue: 0,0:36:05.70,0:36:07.01,Default,,0,0,0,,ngunit kahit hanggang ngayon,
Dialogue: 0,0:36:07.03,0:36:09.35,Default,,0,0,0,,Iniisip ko siya kapag kailangan kong gumawa ng mabigat na desisyon.
Dialogue: 0,0:36:09.37,0:36:11.68,Default,,0,0,0,,"Ano kaya ang gagawin niya?"
Dialogue: 0,0:36:11.71,0:36:13.78,Default,,0,0,0,,Ikaw ay...
Dialogue: 0,0:36:14.54,0:36:16.79,Default,,0,0,0,,isang parola para sa iyong mga anak,
Dialogue: 0,0:36:17.13,0:36:19.11,Default,,0,0,0,,kahit sino ka man,
Dialogue: 0,0:36:19.13,0:36:21.40,Default,,0,0,0,,kaya kumain ka ng mabuti, manatiling malakas,
Dialogue: 0,0:36:21.42,0:36:25.21,Default,,0,0,0,,itaas ang iyong ulo, at sumikat ang iyong liwanag.
Dialogue: 0,0:36:26.35,0:36:28.17,Default,,0,0,0,,Dito.
Dialogue: 0,0:36:28.35,0:36:29.88,Default,,0,0,0,,Narito.
Dialogue: 0,0:36:30.64,0:36:32.16,Default,,0,0,0,,Kain na tayo.
Dialogue: 0,0:36:32.19,0:36:34.62,Default,,0,0,0,,Kahit ang pinakamasarap na {\i1}kal-guksu{\i0} ay masama...
Dialogue: 0,0:36:34.65,0:36:36.26,Default,,0,0,0,,kung ito ay nagiging basa.
Dialogue: 0,0:36:50.58,0:36:52.64,Default,,0,0,0,,"Anong kakapanood ko lang? Drama ba ito?"
Dialogue: 0,0:36:52.66,0:36:55.31,Default,,0,0,0,,"Kalokohan pa rin siya sa\Nlove sa dating asawa."
Dialogue: 0,0:36:55.33,0:36:57.20,Default,,0,0,0,,"Wala pa akong nakitang may karamdamang nakamamatay..."
Dialogue: 0,0:36:57.23,0:36:59.14,Default,,0,0,0,,- "so in love."\N- Enough.
Dialogue: 0,0:37:00.38,0:37:03.23,Default,,0,0,0,,Naging usap-usapan ka sa\Nbayan habang natutulog ka.
Dialogue: 0,0:37:03.26,0:37:04.82,Default,,0,0,0,,Huwag kang tanga. Nakakahiya.
Dialogue: 0,0:37:04.84,0:37:08.03,Default,,0,0,0,,Ano ang ibig mong sabihin? Ikaw ay\Nagpapatuloy sa mga malalaking pagbabago.
Dialogue: 0,0:37:08.05,0:37:10.41,Default,,0,0,0,,Ambisyoso ka tungkol sa\Npagsali sa One Billion Club.
Dialogue: 0,0:37:10.43,0:37:12.78,Default,,0,0,0,,Pagkatapos ay nasira ang iyong pamilya\Nand ay tumakas sa isang araw,
Dialogue: 0,0:37:12.81,0:37:15.47,Default,,0,0,0,,at ngayon ikaw na si Juliet.
Dialogue: 0,0:37:15.73,0:37:18.50,Default,,0,0,0,,Sa madaling salita, iniisip ng mga tao\NI'm hopelessly in love...
Dialogue: 0,0:37:18.52,0:37:22.31,Default,,0,0,0,,with my ex-husband, and that\NI revealed my illness just to save him.
Dialogue: 0,0:37:22.57,0:37:24.98,Default,,0,0,0,,- Totoo yun.\N- Kaya naman ako nahihiya.
Dialogue: 0,0:37:25.86,0:37:28.59,Default,,0,0,0,,May iba pang mga bagay na dapat ipag-alala.
Dialogue: 0,0:37:28.62,0:37:30.32,Default,,0,0,0,,Tulad ng...?
Dialogue: 0,0:37:34.21,0:37:36.07,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:37:37.29,0:37:38.56,Default,,0,0,0,,Bumili ako ng formal dress.
Dialogue: 0,0:37:38.58,0:37:41.27,Default,,0,0,0,,Binili ko ito sa buong presyo sa isang department store.
Dialogue: 0,0:37:41.30,0:37:43.57,Default,,0,0,0,,- Ano ang ibig sabihin nito?\N- Sabihin mo sa akin.
Dialogue: 0,0:37:43.59,0:37:45.98,Default,,0,0,0,,Na sobrang excited ako...
Dialogue: 0,0:37:46.01,0:37:48.17,Default,,0,0,0,,tungkol sa iyong pagbabalik,
Dialogue: 0,0:37:48.59,0:37:50.41,Default,,0,0,0,,ngunit dapat akong makakuha ng refund.
Dialogue: 0,0:37:50.43,0:37:51.87,Default,,0,0,0,,Huwag kang mag-abala.
Dialogue: 0,0:37:51.89,0:37:54.03,Default,,0,0,0,,Itatalaga ka nila sa ibang tao.
Dialogue: 0,0:37:54.06,0:37:55.70,Default,,0,0,0,,Maaari mo itong isuot.
Dialogue: 0,0:37:55.73,0:37:57.45,Default,,0,0,0,,- Hindi, salamat.\N- Bakit hindi?
Dialogue: 0,0:37:57.48,0:37:59.16,Default,,0,0,0,,Alam mo nahihiya ako sa mga estranghero.
Dialogue: 0,0:37:59.19,0:38:02.81,Default,,0,0,0,,Dahil sa aking trabaho, hindi ako\Nmagkakaroon ng maraming pagkakataon,
Dialogue: 0,0:38:03.11,0:38:06.40,Default,,0,0,0,,kaya bumalik ka. Maghihintay ako.
Dialogue: 0,0:38:06.49,0:38:08.44,Default,,0,0,0,,Hindi ko magagarantiya na,
Dialogue: 0,0:38:08.82,0:38:10.63,Default,,0,0,0,,pero gagawin ko ang lahat.
Dialogue: 0,0:38:10.66,0:38:14.36,Default,,0,0,0,,Akala ko balewala na.\NLagi mong sinasabi na gawin mo lang,
Dialogue: 0,0:38:14.66,0:38:16.70,Default,,0,0,0,,kaya ganun din ang sasabihin ko.
Dialogue: 0,0:38:17.04,0:38:19.66,Default,,0,0,0,,Bumalik bago ko bayaran lahat ng installment.
Dialogue: 0,0:38:21.42,0:38:23.19,Default,,0,0,0,,At kailan iyon?
Dialogue: 0,0:38:23.21,0:38:24.79,Default,,0,0,0,,Sa anim na buwan.
Dialogue: 0,0:38:25.67,0:38:28.13,Default,,0,0,0,,- Medyo...\N- Bumalik ka na lang.
Dialogue: 0,0:38:28.93,0:38:31.36,Default,,0,0,0,,Fine, gagawin ko.
Dialogue: 0,0:38:31.39,0:38:33.05,Default,,0,0,0,,Bakit ka nagagalit?
Dialogue: 0,0:38:36.31,0:38:38.01,Default,,0,0,0,,I'll...
Dialogue: 0,0:38:38.64,0:38:40.37,Default,,0,0,0,,yakapin kita ngayon,
Dialogue: 0,0:38:40.40,0:38:42.51,Default,,0,0,0,,dahil sa wakas nagising ka na.
Dialogue: 0,0:38:58.04,0:38:59.39,Default,,0,0,0,,Tingnan mo ito.
Dialogue: 0,0:38:59.42,0:39:04.66,Default,,0,0,0,,I became a divorcée who's still\Nin love with her ex in a single day.
Dialogue: 0,0:39:08.80,0:39:09.99,Default,,0,0,0,,Nakakatawa ba ito sa iyo?
Dialogue: 0,0:39:10.01,0:39:13.25,Default,,0,0,0,,Bakit mo hahayaang abalahin ka niyan?
Dialogue: 0,0:39:14.56,0:39:16.26,Default,,0,0,0,,Tumingin ka sa likod mo.
Dialogue: 0,0:39:22.81,0:39:25.39,Default,,0,0,0,,Naaawa sila sa akin, di ba?
Dialogue: 0,0:39:26.57,0:39:28.52,Default,,0,0,0,,Wala pang tumingin sa akin ng ganyan dati.
Dialogue: 0,0:39:28.55,0:39:30.83,Default,,0,0,0,,Ito ay una.
Dialogue: 0,0:39:31.32,0:39:33.73,Default,,0,0,0,,Hindi ito gagawin.
Dialogue: 0,0:39:33.99,0:39:36.49,Default,,0,0,0,,Dote on me in front of them.
Dialogue: 0,0:39:37.33,0:39:39.01,Default,,0,0,0,,"Sa harap nila"?
Dialogue: 0,0:39:39.04,0:39:41.68,Default,,0,0,0,,- Paano?\N- Una...
Dialogue: 0,0:39:41.71,0:39:45.12,Default,,0,0,0,,- Titigan mo ako nang buong pagmamahal.\N- "Lovingly"?
Dialogue: 0,0:39:53.39,0:39:54.92,Default,,0,0,0,,Ganito?
Dialogue: 0,0:40:03.85,0:40:06.85,Default,,0,0,0,,Well...
Dialogue: 0,0:40:13.86,0:40:15.57,Default,,0,0,0,,Hindi masama.
Dialogue: 0,0:40:27.67,0:40:29.87,Default,,0,0,0,,Gaano katagal ka maghahanap?
Dialogue: 0,0:40:29.92,0:40:31.40,Default,,0,0,0,,Ano?
Dialogue: 0,0:40:31.42,0:40:33.25,Default,,0,0,0,,Ano ang ginagawa ng kaliwang braso mo?
Dialogue: 0,0:40:34.34,0:40:36.04,Default,,0,0,0,,Tama.
Dialogue: 0,0:40:36.26,0:40:37.84,Default,,0,0,0,,Ganito?
Dialogue: 0,0:40:48.11,0:40:51.28,Default,,0,0,0,,{\i1}{\c&HFFFF&}Sungmin University Medical Center{\c}{\i0}
Dialogue: 0,0:41:09.67,0:41:11.36,Default,,0,0,0,,Nagulat ako tumawag ka.
Dialogue: 0,0:41:11.38,0:41:13.02,Default,,0,0,0,,May sasabihin ako.
Dialogue: 0,0:41:13.05,0:41:14.57,Default,,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,0:41:14.59,0:41:15.78,Default,,0,0,0,,Mas maganda ako.
Dialogue: 0,0:41:15.80,0:41:18.00,Default,,0,0,0,,Aalis ako bukas.
Dialogue: 0,0:41:18.64,0:41:19.74,Default,,0,0,0,,Bakit kaagad?
Dialogue: 0,0:41:19.76,0:41:23.12,Default,,0,0,0,,- Wala na silang magagawa para sa akin.\N- Pagkatapos ay bumalik sa bahay.
Dialogue: 0,0:41:23.14,0:41:24.41,Default,,0,0,0,,Ito ay mas maginhawa.
Dialogue: 0,0:41:24.44,0:41:27.14,Default,,0,0,0,,Hindi ako tumawag para pag-usapan iyon.
Dialogue: 0,0:41:27.18,0:41:29.09,Default,,0,0,0,,- Nakikinig ako.\N- Alam kong nasa adobo ka.
Dialogue: 0,0:41:29.12,0:41:30.96,Default,,0,0,0,,Nahihirapan kang makitungo sa media.
Dialogue: 0,0:41:30.98,0:41:33.35,Default,,0,0,0,,The anchor limited partners\Ndapat nagpapabigat sa iyo.
Dialogue: 0,0:41:33.38,0:41:35.51,Default,,0,0,0,,Wala kang sapat na stock para pigilan sila,
Dialogue: 0,0:41:35.53,0:41:39.07,Default,,0,0,0,,kahit na gusto nila ng bagong general partner.
Dialogue: 0,0:41:40.03,0:41:41.64,Default,,0,0,0,,So alam mo na.
Dialogue: 0,0:41:41.66,0:41:42.89,Default,,0,0,0,,Salamat sa iyo,
Dialogue: 0,0:41:42.91,0:41:44.74,Default,,0,0,0,,kaya...
Dialogue: 0,0:41:46.00,0:41:47.39,Default,,0,0,0,,nag-aalala ka ba sa akin?
Dialogue: 0,0:41:47.42,0:41:51.31,Default,,0,0,0,,Hindi. Hindi ako sama ng loob sa sitwasyon mo.
Dialogue: 0,0:41:51.34,0:41:55.71,Default,,0,0,0,,Gawin mo akong muli, at mawawalan ka ng mas malaking bagay.
Dialogue: 0,0:41:56.43,0:41:58.21,Default,,0,0,0,,Iyon lang.
Dialogue: 0,0:42:01.68,0:42:03.07,Default,,0,0,0,,Fine.
Dialogue: 0,0:42:03.10,0:42:05.43,Default,,0,0,0,,Iyon ang dahilan kung bakit ka tumawag,
Dialogue: 0,0:42:06.35,0:42:08.51,Default,,0,0,0,,pero bumilis ang tibok ng puso ko...
Dialogue: 0,0:42:09.73,0:42:13.31,Default,,0,0,0,,nang matanggap ko ang tawag mo, kahit\Nthough alam ko kung bakit ka tumawag.
Dialogue: 0,0:42:14.32,0:42:16.19,Default,,0,0,0,,Hindi mo alam...
Dialogue: 0,0:42:16.90,0:42:19.17,Default,,0,0,0,,gaano ko na katagal itong nararamdaman,
Dialogue: 0,0:42:19.20,0:42:21.47,Default,,0,0,0,,o noong una silang nabuo.
Dialogue: 0,0:42:21.49,0:42:23.03,Default,,0,0,0,,Hindi, ayoko,
Dialogue: 0,0:42:27.16,0:42:28.87,Default,,0,0,0,,at hindi ko na kailangan.
Dialogue: 0,0:42:29.79,0:42:31.58,Default,,0,0,0,,Naaalala mo ba kung bakit...
Dialogue: 0,0:42:31.71,0:42:33.94,Default,,0,0,0,,Pinaputol ko ang relasyon mo sa kolehiyo?
Dialogue: 0,0:42:33.96,0:42:36.48,Default,,0,0,0,,Nagpapasalamat ako sa iyong\Ntulong noong ako ay nahihirapan,
Dialogue: 0,0:42:36.51,0:42:39.67,Default,,0,0,0,,pero ikaw ang dahilan kung bakit ako nahihirapan...
Dialogue: 0,0:42:39.89,0:42:41.75,Default,,0,0,0,,sa unang lugar.
Dialogue: 0,0:42:42.01,0:42:45.67,Default,,0,0,0,,Siguro dapat nagustuhan mo ako\Nback bago ko ginawa ang mga bagay na iyon.
Dialogue: 0,0:42:46.06,0:42:47.54,Default,,0,0,0,,Ginawa ko lang ang mga ganyan...
Dialogue: 0,0:42:47.56,0:42:50.66,Default,,0,0,0,,dahil hindi ako makalapit sayo,\Nkahit anong pilit ko.
Dialogue: 0,0:42:50.69,0:42:53.01,Default,,0,0,0,,Ganyan ang pakikitungo mo sa iba.
Dialogue: 0,0:42:53.19,0:42:54.92,Default,,0,0,0,,Tingnan mo kahit ngayon lang.
Dialogue: 0,0:42:54.94,0:42:58.81,Default,,0,0,0,,Itinulak mo ako sa isang kanal para maalis mo ako dito,
Dialogue: 0,0:42:59.53,0:43:02.11,Default,,0,0,0,,so sino ang posibleng magkakagusto sa iyo?
Dialogue: 0,0:43:02.16,0:43:04.65,Default,,0,0,0,,Kung gayon paano si Hyun-woo?
Dialogue: 0,0:43:05.54,0:43:07.61,Default,,0,0,0,,Deserve ba niya ang pagmamahal mo?
Dialogue: 0,0:43:07.83,0:43:10.23,Default,,0,0,0,,Iiwan ka na niya.
Dialogue: 0,0:43:10.25,0:43:13.19,Default,,0,0,0,,Nagulo ba ang tumor mo sa\Nyong memorya? nakalimutan mo na ba
Dialogue: 0,0:43:13.21,0:43:15.08,Default,,0,0,0,,Kasama ko siya ngayon.
Dialogue: 0,0:43:18.17,0:43:20.04,Default,,0,0,0,,Siya ang kasama ko...
Dialogue: 0,0:43:20.26,0:43:21.79,Default,,0,0,0,,ngayon.
Dialogue: 0,0:43:24.31,0:43:26.26,Default,,0,0,0,,Dapat ko bang ipaliwanag pa?
Dialogue: 0,0:43:42.78,0:43:45.69,Default,,0,0,0,,- Tapos ka na bang magsalita?\N- Mr. Baek.
Dialogue: 0,0:43:45.78,0:43:47.72,Default,,0,0,0,,Bakit dumidikit ka pa rin sa kanya?
Dialogue: 0,0:43:47.75,0:43:49.89,Default,,0,0,0,,Bakit ko sasabihin sa iyo?
Dialogue: 0,0:43:49.91,0:43:53.02,Default,,0,0,0,,Nagkaroon ka ba ng damdamin\Npagkatapos malaman na siya ay namamatay,
Dialogue: 0,0:43:53.04,0:43:56.08,Default,,0,0,0,,o umaasa ka bang may iiwan siya sa iyo?
Dialogue: 0,0:43:58.38,0:43:59.52,Default,,0,0,0,,Puntahan mo lang ako.
Dialogue: 0,0:43:59.55,0:44:02.75,Default,,0,0,0,,Ibibigay ko sayo ang kahit ano\ng gusto mo kung iiwan mo siya.
Dialogue: 0,0:44:12.52,0:44:15.76,Default,,0,0,0,,Sinusubukan mo talaga ang pasensya ko, kaya go lang.
Dialogue: 0,0:44:21.65,0:44:23.19,Default,,0,0,0,,Hey.
Dialogue: 0,0:44:28.08,0:44:31.31,Default,,0,0,0,,Ayokong sabihin sa iyo ang isang bagay\Ni hindi pa man lang nasasabi sa kanya.
Dialogue: 0,0:44:31.33,0:44:33.98,Default,,0,0,0,,Subukan ang lahat ng gusto mo. Wala akong pupuntahan.
Dialogue: 0,0:44:34.00,0:44:37.06,Default,,0,0,0,,Mananatili ako sa kanya magpakailanman.
Dialogue: 0,0:44:37.09,0:44:38.66,Default,,0,0,0,,Sasamahan ko siya,
Dialogue: 0,0:44:38.92,0:44:41.92,Default,,0,0,0,,kaya huwag kang huminga at mawala ka lang.
Dialogue: 0,0:44:57.90,0:44:59.72,Default,,0,0,0,,Umuwi ka na.
Dialogue: 0,0:45:00.48,0:45:01.88,Default,,0,0,0,,Nandito na ang chairman.
Dialogue: 0,0:45:01.90,0:45:03.52,Default,,0,0,0,,Narinig mo ba?
Dialogue: 0,0:45:06.91,0:45:08.57,Default,,0,0,0,,Mukhang masaya ka.
Dialogue: 0,0:45:08.70,0:45:09.76,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,0:45:09.79,0:45:14.24,Default,,0,0,0,,Paano ko, kung ang pag-ibig ng\Nyyong buhay ay durog sa puso mo?
Dialogue: 0,0:45:14.71,0:45:16.14,Default,,0,0,0,,Anong nangyari sa mukha mo?
Dialogue: 0,0:45:16.17,0:45:18.62,Default,,0,0,0,,- Nasaktan ka ba?\N- Wala...
Dialogue: 0,0:45:19.59,0:45:21.66,Default,,0,0,0,,ng iyong negosyo.
Dialogue: 0,0:45:22.34,0:45:25.33,Default,,0,0,0,,Palagi akong nabubuhay nang walang pag-asa.
Dialogue: 0,0:45:25.51,0:45:27.74,Default,,0,0,0,,Walang sakit na hihigit sa iba,
Dialogue: 0,0:45:27.76,0:45:30.30,Default,,0,0,0,,at wala akong pakialam kung masaktan man ako,
Dialogue: 0,0:45:30.56,0:45:32.58,Default,,0,0,0,,kaya huminto ka sa pagsisikap na kumilos...
Dialogue: 0,0:45:32.60,0:45:34.30,Default,,0,0,0,,parang isang tipikal na ina.
Dialogue: 0,0:45:36.65,0:45:38.35,Default,,0,0,0,,May bisita ka.
Dialogue: 0,0:45:48.91,0:45:51.14,Default,,0,0,0,,Bakit hindi ka nagsusundo?
Dialogue: 0,0:45:51.16,0:45:55.74,Default,,0,0,0,,Wala ka bang kasalanan sa nangyari sa akin?
Dialogue: 0,0:45:57.62,0:46:00.70,Default,,0,0,0,,Sabi ko wag mo akong tawagan eh bakit ka nandito?
Dialogue: 0,0:46:01.50,0:46:05.61,Default,,0,0,0,,Naiwasan kong maaresto, ngunit\Nhindi nila ako binitawan.
Dialogue: 0,0:46:05.63,0:46:09.20,Default,,0,0,0,,- Hindi uupo si Baek Hyun-woo!\N- So?
Dialogue: 0,0:46:09.22,0:46:12.12,Default,,0,0,0,,Ako lang ba ang bababa,\Kung malaman ng mundo...
Dialogue: 0,0:46:12.14,0:46:14.57,Default,,0,0,0,,tungkol sa dobleng kontrata\Nand ang pandaraya sa pamumuhunan sa lupa?
Dialogue: 0,0:46:14.60,0:46:18.59,Default,,0,0,0,,Sa tingin mo ba ay pananatilihin mo ang iyong posisyon, Chairman Yoon?
Dialogue: 0,0:46:18.94,0:46:22.08,Default,,0,0,0,,Ito ang dami ng stock\NEun-sung's limited partners.
Dialogue: 0,0:46:22.11,0:46:23.44,Default,,0,0,0,,pinarinig ko siya ngayon.
Dialogue: 0,0:46:23.47,0:46:25.24,Default,,0,0,0,, "Hindi ba galit ang mga limitado mong partner?"
Dialogue: 0,0:46:25.26,0:46:27.01,Default,,0,0,0,,"Ayaw ba nila ng bagong general partner?"
Dialogue: 0,0:46:27.03,0:46:29.09,Default,,0,0,0,,Pumayag siya.
Dialogue: 0,0:46:29.11,0:46:30.22,Default,,0,0,0,,Ibig sabihin...
Dialogue: 0,0:46:30.24,0:46:33.14,Default,,0,0,0,,Hindi pa rin niya nahahanap ang\NChairman Hong's secret fund.
Dialogue: 0,0:46:33.16,0:46:35.05,Default,,0,0,0,,Alam mo ba...
Dialogue: 0,0:46:35.08,0:46:36.89,Default,,0,0,0,,ng secret fund sa Switzerland?
Dialogue: 0,0:46:36.91,0:46:39.31,Default,,0,0,0,,Tatlong korporasyon ay\NItinatag sa Virgin Islands,
Dialogue: 0,0:46:39.33,0:46:40.89,Default,,0,0,0,,Moldova, at Singapore.
Dialogue: 0,0:46:40.92,0:46:44.15,Default,,0,0,0,,Ang lihim na pondo sa Switzerland\Nis ay lumipat sa Singapore.
Dialogue: 0,0:46:44.17,0:46:45.86,Default,,0,0,0,,Pagkatapos ang Virgin Islands...
Dialogue: 0,0:46:45.88,0:46:49.07,Default,,0,0,0,,{\an8}gawin itong parang nagpahiram sila ng pera sa Moldova,
Dialogue: 0,0:46:49.09,0:46:52.75,Default,,0,0,0,,at sina-underwrite ng Singapore ang utang ng Moldova.
Dialogue: 0,0:46:53.18,0:46:55.66,Default,,0,0,0,,Pagkatapos ay inanunsyo ng Moldova na hindi nila ito mababayaran?
Dialogue: 0,0:46:55.68,0:46:57.12,Default,,0,0,0,,Tama.
Dialogue: 0,0:46:57.14,0:47:00.00,Default,,0,0,0,,{\an8}Pagkatapos ay nagsampa ng default suit ang Virgin Islands,
Dialogue: 0,0:47:00.02,0:47:02.60,Default,,0,0,0,,{\an8}at hinihiling ng hukuman sa Singapore na bayaran ito.
Dialogue: 0,0:47:03.48,0:47:06.50,Default,,0,0,0,,Ginagawa ng korte na posible\Nang ilipat ang lihim na pondo sa legal na paraan.
Dialogue: 0,0:47:06.53,0:47:08.92,Default,,0,0,0,,Kapag tapos na ang lahat,\Ntatlong korporasyong ito...
Dialogue: 0,0:47:08.95,0:47:11.63,Default,,0,0,0,,shut down at gawin itong\Nmahirap subaybayan ang pondo.
Dialogue: 0,0:47:11.66,0:47:13.59,Default,,0,0,0,,Patuloy silang naglalaba sa ganitong paraan,
Dialogue: 0,0:47:13.62,0:47:18.15,Default,,0,0,0,,at sa wakas, ipinapadala nila ang pera\Nsa isang bangko sa Labuan, Malaysia.
Dialogue: 0,0:47:19.04,0:47:20.10,Default,,0,0,0,,Hindi kapani-paniwala.
Dialogue: 0,0:47:20.12,0:47:23.90,Default,,0,0,0,,Ibig bang sabihin ang sekreto\Nfund ay nasa Malaysia ngayon?
Dialogue: 0,0:47:23.92,0:47:27.36,Default,,0,0,0,,I don't think so, because\NEun-sung sent someone to Labuan today.
Dialogue: 0,0:47:27.38,0:47:30.96,Default,,0,0,0,,Kaya hindi rin niya alam ang\Nfinal destination.
Dialogue: 0,0:47:33.97,0:47:36.09,Default,,0,0,0,,Nga pala,
Dialogue: 0,0:47:36.27,0:47:38.51,Default,,0,0,0,,paano mo nalaman ito?
Dialogue: 0,0:47:39.35,0:47:42.54,Default,,0,0,0,,{\i1}Maraming tao ang hindi nasisiyahan\Natungkol sa kasalukuyang sitwasyon,{\i0}
Dialogue: 0,0:47:42.56,0:47:44.33,Default,,0,0,0,,{\i1}ngunit hindi nila ito maipahayag.{\i0}
Dialogue: 0,0:47:44.36,0:47:48.85,Default,,0,0,0,,{\i1}Ang ilan sa kanila ay nagtatrabaho\Npara sa mga Reyna nang mahigit 30 taon.{\i0}
Dialogue: 0,0:47:48.90,0:47:51.80,Default,,0,0,0,,{\i1}Si Secretary Jang ay\NChairman Hong's secretary sa loob ng maraming taon,{\i0}
Dialogue: 0,0:47:51.82,0:47:55.23,Default,,0,0,0,,{\i1}ngunit tinanggihan niya ang isang malaking suweldo at nagbitiw.{\i0}
Dialogue: 0,0:47:57.12,0:47:58.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Secretary Jang.{\c}{\i0}
Dialogue: 0,0:47:59.29,0:48:00.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kumusta ka na?{\c}{\i0}
Dialogue: 0,0:48:00.79,0:48:02.04,Default,,0,0,0,,{\i1}Sinabi nila sa iyo...{\i0}
Dialogue: 0,0:48:02.07,0:48:03.89,Default,,0,0,0,,para sa atin ang mga bagay na ito?
Dialogue: 0,0:48:03.92,0:48:08.25,Default,,0,0,0,,Hindi, para sa kumpanyang pinaglaanan nila ng buong buhay nila.
Dialogue: 0,0:48:08.30,0:48:11.54,Default,,0,0,0,,Ayaw na nilang makitang gumuho ang\Nkumpanya.
Dialogue: 0,0:48:12.93,0:48:14.84,Default,,0,0,0,,Ano naman sayo?
Dialogue: 0,0:48:15.72,0:48:17.95,Default,,0,0,0,,Bakit mo ginagawa ito? Para sa kumpanya?
Dialogue: 0,0:48:17.97,0:48:20.43,Default,,0,0,0,,Oo, para ito sa kumpanya,
Dialogue: 0,0:48:22.73,0:48:26.54,Default,,0,0,0,,dahil alam ko kung gaano mo kamahal...
Dialogue: 0,0:48:26.57,0:48:28.10,Default,,0,0,0,,iyong kumpanya.
Dialogue: 0,0:48:39.08,0:48:42.14,Default,,0,0,0,,Isinaalang-alang namin ang bawat Nopinyon ng aming mga miyembro.
Dialogue: 0,0:48:42.16,0:48:44.56,Default,,0,0,0,,Nilabag mo ang iyong tungkulin sa pagiging kumpidensyal,
Dialogue: 0,0:48:44.58,0:48:46.91,Default,,0,0,0,,at nag-leak na impormasyon...
Dialogue: 0,0:48:51.51,0:48:53.40,Default,,0,0,0,,- Sino ka?\N- Tama.
Dialogue: 0,0:48:53.43,0:48:56.45,Default,,0,0,0,,Nandito kami para ipagtanggol ang aming\Nkliyente, Mr. Baek Hyun-woo.
Dialogue: 0,0:48:56.47,0:48:59.74,Default,,0,0,0,,Tingnan mo. Wala kang karapatang\Npanghimasukan sa internal audit na ito.
Dialogue: 0,0:48:59.77,0:49:03.33,Default,,0,0,0,,Ayon sa Artikulo 12, Paragraph 1,\NItem 3 at Artikulo 11, Paragraph 4...
Dialogue: 0,0:49:03.35,0:49:06.54,Default,,0,0,0,,ng Administrative Procedure Act,\Ang kliyente ni Nour ay may karapatang kumuha...
Dialogue: 0,0:49:06.56,0:49:08.68,Default,,0,0,0,,isang abogado na kumatawan sa kanya.
Dialogue: 0,0:49:11.90,0:49:13.00,Default,,0,0,0,,Ituloy natin.
Dialogue: 0,0:49:13.03,0:49:15.57,Default,,0,0,0,,Dahil sa mga kadahilanang ito,\Npagdesisyunan namin na tanggalin ka...
Dialogue: 0,0:49:15.60,0:49:16.90,Default,,0,0,0,,Ang dahilan mo sa pagpapaalis sa kanya...
Dialogue: 0,0:49:16.92,0:49:19.76,Default,,0,0,0,,ay nakatanggap ka ng tip-off\Nmula sa executive ng isang karibal na kumpanya,
Dialogue: 0,0:49:19.79,0:49:22.31,Default,,0,0,0,,na nag-claim na si Mr. Baek\Nleaked VIP information sa kanila,
Dialogue: 0,0:49:22.33,0:49:25.60,Default,,0,0,0,,at nakumpirma mong nakuha niya ang kanyang\Nhands dito sa pamamagitan ng paggamit ng kanyang company ID.
Dialogue: 0,0:49:25.62,0:49:28.13,Default,,0,0,0,,- Oo, at?\N- Kailan mo natanggap ang tip-off na iyon?
Dialogue: 0,0:49:28.15,0:49:29.19,Default,,0,0,0,,Noong Agosto 6.
Dialogue: 0,0:49:29.21,0:49:31.02,Default,,0,0,0,,Kailan kinuha ni Mr. Baek ang VIP list?
Dialogue: 0,0:49:31.05,0:49:32.19,Default,,0,0,0,,Agosto 1 at 2.
Dialogue: 0,0:49:32.21,0:49:33.78,Default,,0,0,0,,- Dalawang magkaibang okasyon.\N- Kakaiba.
Dialogue: 0,0:49:33.80,0:49:37.24,Default,,0,0,0,,Na-delete ang kanyang intranet ID noong ika-28 ng Hulyo.
Dialogue: 0,0:49:37.26,0:49:38.32,Default,,0,0,0,,Tama.
Dialogue: 0,0:49:38.35,0:49:41.12,Default,,0,0,0,,{\an8}{\i1}Ibinalik ko ang aking ID card, company card, laptop,{\i0}
Dialogue: 0,0:49:41.14,0:49:42.83,Default,,0,0,0,,{\an8}at lahat ng iba pa sa araw na iyon.
Dialogue: 0,0:49:42.85,0:49:45.87,Default,,0,0,0,,Siguro hindi ito ang iyong ID.\NMaaari kang gumamit ng ibang tao.
Dialogue: 0,0:49:45.89,0:49:47.00,Default,,0,0,0,,Katulad nino?
Dialogue: 0,0:49:47.02,0:49:49.12,Default,,0,0,0,,Siguro isa sa mga miyembro ng team niya.
Dialogue: 0,0:49:49.15,0:49:54.38,Default,,0,0,0,,Ibig sabihin, may access ang isang regular na empleyado\Nto sa VIP list ng Queens Department Store.
Dialogue: 0,0:49:54.40,0:49:55.88,Default,,0,0,0,,- Hindi ba problema yun?\N- Tama.
Dialogue: 0,0:49:55.90,0:49:59.05,Default,,0,0,0,,Kailangan may patunay na ang\Ntiyak na impormasyon ay pinaghigpitan...
Dialogue: 0,0:49:59.07,0:50:00.68,Default,,0,0,0,,para ito ay maituturing na classified.
Dialogue: 0,0:50:00.70,0:50:03.81,Default,,0,0,0,,Kung sinuman ang makakakuha ng access\Nand i-download ang materyal,
Dialogue: 0,0:50:03.83,0:50:06.06,Default,,0,0,0,,na nagpapakita lang na ang tindahan...
Dialogue: 0,0:50:06.08,0:50:08.64,Default,,0,0,0,,hindi inilihim ang VIP list.
Dialogue: 0,0:50:08.67,0:50:13.19,Default,,0,0,0,,Ang totoong problema ay ang paglustay,\Nand niya pinirmahan ang lahat ng kaugnay na dokumento.
Dialogue: 0,0:50:13.21,0:50:16.30,Default,,0,0,0,,Humiling kami ng pagpapatunay sa isang\Ndocument examiner na dating...
Dialogue: 0,0:50:16.32,0:50:20.11,Default,,0,0,0,,ang dating Chief of Document sa\NNFS hinggil sa 27 signature na iyon.
Dialogue: 0,0:50:20.14,0:50:22.41,Default,,0,0,0,,Ang mga sukat at mga detalye ng mga lagda...
Dialogue: 0,0:50:22.43,0:50:24.99,Default,,0,0,0,,ay napatunayang eksaktong pareho.
Dialogue: 0,0:50:25.02,0:50:28.64,Default,,0,0,0,,Posible lang ito kung nadoble ang pirma niya.
Dialogue: 0,0:50:28.73,0:50:33.08,Default,,0,0,0,,Hindi namin mapagkakatiwalaan ang resultang ito,\Ndahil hiniling mo ito.
Dialogue: 0,0:50:33.11,0:50:35.42,Default,,0,0,0,,Pagkatapos ay hilingin natin sa prosekusyon na tasahin ito.
Dialogue: 0,0:50:35.44,0:50:38.01,Default,,0,0,0,,Para sa iyong kaalaman, walang multa para sa pamemeke ng dokumento.
Dialogue: 0,0:50:38.03,0:50:41.28,Default,,0,0,0,, Tanging pagkakulong ng maximum na tatlong taon.
Dialogue: 0,0:50:44.08,0:50:45.26,Default,,0,0,0,,Umaasa kami...
Dialogue: 0,0:50:45.29,0:50:48.41,Default,,0,0,0,,gagawin mo...
Dialogue: 0,0:50:48.67,0:50:50.58,Default,,0,0,0,,isang matalinong desisyon.
Dialogue: 0,0:51:49.43,0:51:51.55,Default,,0,0,0,,- {\i1}Ako po.{\i0}\N- Hello, sir.
Dialogue: 0,0:51:53.94,0:51:55.72,Default,,0,0,0,,Alisin...
Dialogue: 0,0:51:55.94,0:51:57.64,Default,,0,0,0,,ni Baek Hyun-woo.
Dialogue: 0,0:51:58.53,0:52:00.34,Default,,0,0,0,,Istorbo siya sa aming dalawa.
Dialogue: 0,0:52:00.36,0:52:02.31,Default,,0,0,0,,Boracay, diba?
Dialogue: 0,0:52:02.45,0:52:03.47,Default,,0,0,0,,Ipapadala kita doon,
Dialogue: 0,0:52:03.49,0:52:05.16,Default,,0,0,0,,{\i1}at binabayaran ka ng malaki.{\i0}
Dialogue: 0,0:52:05.18,0:52:06.22,Default,,0,0,0,,Chairman Yoon.
Dialogue: 0,0:52:06.24,0:52:09.51,Default,,0,0,0,,Nagkaroon ng hiccup last time,\Ndahil medyo pabaya ako.
Dialogue: 0,0:52:09.54,0:52:12.62,Default,,0,0,0,,{\i1}Aalagaan ko ito ng maayos sa pagkakataong ito.{\i0}
Dialogue: 0,0:52:25.35,0:52:28.49,Default,,0,0,0,,The more attorneys, the better.\NIMabuti na mayroon ka sa amin.
Dialogue: 0,0:52:28.52,0:52:34.12,Default,,0,0,0,,Sa kabila ng iba't ibang specialty,\Nnagsama-sama kami para tumulong sa isang kaibigan.
Dialogue: 0,0:52:34.15,0:52:35.62,Default,,0,0,0,,Para kaming Avengers.
Dialogue: 0,0:52:35.65,0:52:39.21,Default,,0,0,0,,I'm sorry, pero andito rin ako\Ndahil nagtanong tuloy ang mga tao...
Dialogue: 0,0:52:39.23,0:52:41.84,Default,,0,0,0,,kung nagkabalikan kayo ng ex mo.
Dialogue: 0,0:52:41.86,0:52:43.52,Default,,0,0,0,,Ikaw ba?
Dialogue: 0,0:52:49.83,0:52:51.31,Default,,0,0,0,,Wala sa iyo iyon.
Dialogue: 0,0:52:51.33,0:52:53.35,Default,,0,0,0,,Nag-major ka sa commercial law.
Dialogue: 0,0:52:53.37,0:52:57.60,Default,,0,0,0,,Tama siya. Napakahusay mo sa\NBills of Exchange Act at Check Act.
Dialogue: 0,0:52:57.63,0:53:00.02,Default,,0,0,0,,Iyan ang nakaraan. Kinukuha ko ang lahat ng uri ng mga kaso ngayon.
Dialogue: 0,0:53:00.05,0:53:02.44,Default,,0,0,0,,Tingnan mo ito,
Dialogue: 0,0:53:02.47,0:53:04.44,Default,,0,0,0,,at subaybayan ang pera.
Dialogue: 0,0:53:04.47,0:53:05.59,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}WSB Switzerland Bank{\c}{\i0}
Dialogue: 0,0:53:07.01,0:53:09.46,Default,,0,0,0,,Saan mo nakuha ang mga ito?
Dialogue: 0,0:53:13.44,0:53:14.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kumusta.{\c}{\i0}
Dialogue: 0,0:53:15.23,0:53:16.54,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kunin ito.{\c}{\i0}
Dialogue: 0,0:53:16.56,0:53:18.88,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Itatapon ko ito sa aking paglabas.\N- Salamat.{\c}{\i0}
Dialogue: 0,0:53:18.90,0:53:20.20,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Pangalawang basement level?\N- Oo.{\c}{\i0}
Dialogue: 0,0:53:20.23,0:53:21.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Secretary Na, hello.{\c}{\i0}
Dialogue: 0,0:53:21.99,0:53:23.52,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kumusta.{\c}{\i0}
Dialogue: 0,0:53:24.91,0:53:26.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magkaroon ng isa.{\c}{\i0}
Dialogue: 0,0:53:26.41,0:53:27.94,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Salamat.{\c}{\i0}
Dialogue: 0,0:53:49.96,0:53:52.27,Default,,0,0,0,,{\i1}Hinahanap ni Eun-sung\Nang secret fund ng chairman...{\i0}
Dialogue: 0,0:53:52.30,0:53:54.04,Default,,0,0,0,,para makabili pa siya ng stocks.
Dialogue: 0,0:53:54.06,0:53:55.75,Default,,0,0,0,,Isang lihim na pondo? magkano?
Dialogue: 0,0:53:55.77,0:53:57.60,Default,,0,0,0,,$900 milyon.
Dialogue: 0,0:54:02.57,0:54:04.10,Default,,0,0,0,,Pupunta ako...
Dialogue: 0,0:54:05.03,0:54:06.94,Default,,0,0,0,,para hanapin muna ito.
Dialogue: 0,0:54:07.28,0:54:10.18,Default,,0,0,0,,Ma'am, mag-ingat sa UV rays.
Dialogue: 0,0:54:10.20,0:54:11.47,Default,,0,0,0,,Bakit ka nagpapatuloy?
Dialogue: 0,0:54:11.49,0:54:13.47,Default,,0,0,0,,Hindi ka ba kumampi kay Beom-ja?
Dialogue: 0,0:54:13.50,0:54:14.47,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:54:14.50,0:54:16.64,Default,,0,0,0,,Sus, nagkamali ka ng ideya.
Dialogue: 0,0:54:16.67,0:54:18.18,Default,,0,0,0,,Noon,
Dialogue: 0,0:54:18.21,0:54:20.31,Default,,0,0,0,,Nakaramdam ako ng kilabot dahil nakiusap siya sa akin...
Dialogue: 0,0:54:20.34,0:54:23.40,Default,,0,0,0,,para matulungan siyang makita ang kanyang ama nang isang beses lang.
Dialogue: 0,0:54:23.42,0:54:25.02,Default,,0,0,0,,Pambihira akong malambot minsan.
Dialogue: 0,0:54:25.05,0:54:26.82,Default,,0,0,0,,Fine. Kampihan mo kung sino man ang kaawaan mo.
Dialogue: 0,0:54:26.84,0:54:29.40,Default,,0,0,0,,Sus, Ms. Moh!
Dialogue: 0,0:54:29.43,0:54:30.95,Default,,0,0,0,,Kilala mo ako.
Dialogue: 0,0:54:30.97,0:54:33.99,Default,,0,0,0,,Pera at kapangyarihan lang ang kinakampihan ko.
Dialogue: 0,0:54:34.02,0:54:38.09,Default,,0,0,0,,Kung tutuusin, ikaw na ang reyna ngayon.
Dialogue: 0,0:54:38.52,0:54:42.00,Default,,0,0,0,,Hindi ko na kailangang maging\NCEO o anupaman.
Dialogue: 0,0:54:42.02,0:54:44.63,Default,,0,0,0,,Mananatili lang ako sa iyo...
Dialogue: 0,0:54:44.65,0:54:45.96,Default,,0,0,0,,tulad ng iyong kasambahay.
Dialogue: 0,0:54:45.99,0:54:48.35,Default,,0,0,0,,Maid, paa ko.
Dialogue: 0,0:54:48.91,0:54:49.88,Default,,0,0,0,,Tingnan natin, kung gayon.
Dialogue: 0,0:54:49.91,0:54:51.22,Default,,0,0,0,,Sure thing.
Dialogue: 0,0:54:51.24,0:54:56.28,Default,,0,0,0,,Ako, ang kamangha-manghang Grace, ay maglilingkod sa iyo nang kamangha-mangha.
Dialogue: 0,0:55:02.54,0:55:04.73,Default,,0,0,0,,Sir, naalala mo ba itong kwarto?
Dialogue: 0,0:55:04.75,0:55:06.90,Default,,0,0,0,,Sabi nila nasa pamilyar na kapaligiran...
Dialogue: 0,0:55:06.92,0:55:08.92,Default,,0,0,0,,tutulungan kang gumaling, kaya dinala kita dito.
Dialogue: 0,0:55:08.95,0:55:10.99,Default,,0,0,0,,Hindi madaling maging caregiver.
Dialogue: 0,0:55:11.01,0:55:13.28,Default,,0,0,0,,Hayaan mo akong magpamasahe sayo mamaya.
Dialogue: 0,0:55:13.30,0:55:15.20,Default,,0,0,0,,Kumusta naman ang frankincense oil?
Dialogue: 0,0:55:15.22,0:55:16.76,Default,,0,0,0,,Oo naman.
Dialogue: 0,0:55:40.12,0:55:41.68,Default,,0,0,0,,Salamat.
Dialogue: 0,0:55:41.71,0:55:44.79,Default,,0,0,0,,Maaari kang pumunta at hayaan siyang magpahinga.
Dialogue: 0,0:55:59.64,0:56:01.12,Default,,0,0,0,,So?
Dialogue: 0,0:56:01.14,0:56:02.71,Default,,0,0,0,,Nagbabalik ba iyon ng mga alaala?
Dialogue: 0,0:56:02.73,0:56:04.50,Default,,0,0,0,,Sabihin mo sa akin. Nasaan ang pera ko?
Dialogue: 0,0:56:04.52,0:56:08.35,Default,,0,0,0,,Nasaan ang lihim na pondo na itinago mo sa ilalim ng aking pangalan?
Dialogue: 0,0:56:35.26,0:56:37.96,Default,,0,0,0,,Patuloy na panoorin siya, anuman ang mangyari.
Dialogue: 0,0:56:38.14,0:56:40.88,Default,,0,0,0,,Sino ang nakakaalam kung ano pa ang gagawin niya sa kanya?
Dialogue: 0,0:56:44.98,0:56:46.51,Default,,0,0,0,,I'm hang up.
Dialogue: 0,0:57:07.34,0:57:08.31,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:57:08.34,0:57:11.54,Default,,0,0,0,,Sus, napakaraming balat ang ipinapakita niya sa sikat ng araw.
Dialogue: 0,0:57:26.98,0:57:28.46,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:57:28.48,0:57:30.14,Default,,0,0,0,,"Tingnan mo ako."
Dialogue: 0,0:57:30.32,0:57:32.17,Default,,0,0,0,,"Maganda ako."
Dialogue: 0,0:57:32.19,0:57:33.88,Default,,0,0,0,,"Maganda rin ang katawan ko."
Dialogue: 0,0:57:33.90,0:57:35.44,Default,,0,0,0,,Iyon ba?
Dialogue: 0,0:57:36.03,0:57:37.73,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:58:03.43,0:58:05.09,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:58:06.27,0:58:07.66,Default,,0,0,0,,I...
Dialogue: 0,0:58:07.69,0:58:09.22,Default,,0,0,0,,Well...
Dialogue: 0,0:58:10.52,0:58:12.96,Default,,0,0,0,,Naniniwala akong nakasilip ka.
Dialogue: 0,0:58:12.98,0:58:15.75,Default,,0,0,0,,Hindi, hindi ako. dumaan lang ako...
Dialogue: 0,0:58:15.78,0:58:18.27,Default,,0,0,0,,nung nakita kita doon.
Dialogue: 0,0:58:22.12,0:58:23.69,Default,,0,0,0,,Gusto mo ba?
Dialogue: 0,0:58:25.29,0:58:26.81,Default,,0,0,0,,- Ano yun?\N- Mulberries.
Dialogue: 0,0:58:26.83,0:58:28.82,Default,,0,0,0,,As in...
Dialogue: 0,0:58:30.42,0:58:32.31,Default,,0,0,0,,- berries?\N- Oo, tama ka.
Dialogue: 0,0:58:32.34,0:58:34.79,Default,,0,0,0,,Maganda sila sa mga babae.
Dialogue: 0,0:58:37.84,0:58:39.61,Default,,0,0,0,,- Magkano?\N- Hindi sila ibinebenta.
Dialogue: 0,0:58:39.64,0:58:40.70,Default,,0,0,0,,Libre sila.
Dialogue: 0,0:58:40.72,0:58:42.38,Default,,0,0,0,,Bakit mo...?
Dialogue: 0,0:58:44.68,0:58:47.34,Default,,0,0,0,,Gaano ka orihinal. bibigyan kita niyan.
Dialogue: 0,0:58:47.52,0:58:49.16,Default,,0,0,0,,Ano?
Dialogue: 0,0:58:49.19,0:58:53.21,Default,,0,0,0,,Ikaw ang unang tao na gumawa\Na lumipat gamit ang mulberry,
Dialogue: 0,0:58:53.23,0:58:55.29,Default,,0,0,0,,ngunit hayaan mo akong maging malinaw.
Dialogue: 0,0:58:55.32,0:58:56.46,Default,,0,0,0,,Tinatanggap ang mga ito...
Dialogue: 0,0:58:56.49,0:58:59.15,Default,,0,0,0,,hindi ibig sabihin tanggap ko na ang pagmamahal mo.
Dialogue: 0,0:59:01.70,0:59:04.93,Default,,0,0,0,,- Ano ang MBTI mo?\N- Ano?
Dialogue: 0,0:59:04.95,0:59:07.43,Default,,0,0,0,,Sa tingin ko isa kang ISTJ.
Dialogue: 0,0:59:07.46,0:59:09.89,Default,,0,0,0,,- Ako... Ano?\N- Hindi ka nagpapahayag ng emosyon nang maayos.
Dialogue: 0,0:59:09.92,0:59:14.31,Default,,0,0,0,,Ikaw ay isang perfectionist na may magandang memorya.\NMukhang malamig ka, pero ang lambot mo talaga.
Dialogue: 0,0:59:14.34,0:59:18.25,Default,,0,0,0,, Parehong Robert De Niro at\NNatalie Portman ang ganitong uri.
Dialogue: 0,0:59:20.93,0:59:22.75,Default,,0,0,0,,Anong sinasabi niya?
Dialogue: 0,0:59:23.97,0:59:25.62,Default,,0,0,0,,Bakit ka nakauwi?
Dialogue: 0,0:59:25.64,0:59:27.66,Default,,0,0,0,,Hindi ba dapat nagtatrabaho ka tulad ng iba?
Dialogue: 0,0:59:27.68,0:59:29.39,Default,,0,0,0,,Hindi ako nagtatrabaho...
Dialogue: 0,0:59:30.02,0:59:31.46,Default,,0,0,0,,ganun karami.
Dialogue: 0,0:59:31.48,0:59:32.50,Default,,0,0,0,,Bakit hindi?
Dialogue: 0,0:59:32.52,0:59:35.10,Default,,0,0,0,,Dahil ang buhay ay masyadong maikli.
Dialogue: 0,0:59:35.19,0:59:38.06,Default,,0,0,0,,Nagtatrabaho lang ako para maging sapat sa sarili.
Dialogue: 0,0:59:45.79,0:59:48.45,Default,,0,0,0,,Ano kaya? Isa siyang self-sufficient farmer?
Dialogue: 0,0:59:58.67,1:00:00.61,Default,,0,0,0,,Sinabi ba niya ang mga ito para sa akin?
Dialogue: 0,1:00:00.63,1:00:02.33,Default,,0,0,0,,Sus.
Dialogue: 0,1:00:03.97,1:00:06.26,Default,,0,0,0,,Natalie Portman?
Dialogue: 0,1:00:25.83,1:00:27.72,Default,,0,0,0,,Goodness!
Dialogue: 0,1:00:27.74,1:00:29.72,Default,,0,0,0,,Marami yan!
Dialogue: 0,1:00:29.75,1:00:32.18,Default,,0,0,0,,Galing sila kay Yeong-song.
Dialogue: 0,1:00:32.21,1:00:33.98,Default,,0,0,0,,Pumitas siya ng ilang mulberry.
Dialogue: 0,1:00:34.00,1:00:35.44,Default,,0,0,0,,Meron pa daw siya.
Dialogue: 0,1:00:35.46,1:00:37.10,Default,,0,0,0,,Masyado siyang pumili,
Dialogue: 0,1:00:37.13,1:00:39.62,Default,,0,0,0,,kaya ibinabahagi niya ang mga ito.
Dialogue: 0,1:00:40.84,1:00:41.98,Default,,0,0,0,,Nakakatawa siya.
Dialogue: 0,1:00:42.01,1:00:43.69,Default,,0,0,0,,Maaari niyang ibenta ang sobra.
Dialogue: 0,1:00:43.72,1:00:46.36,Default,,0,0,0,,Lagi niyang isinasantabi para sa kanyang pamilya,
Dialogue: 0,1:00:46.39,1:00:48.32,Default,,0,0,0,,at ibibigay ang iba.
Dialogue: 0,1:00:48.35,1:00:51.34,Default,,0,0,0,,Ano ang gagawin natin sa lahat ng ito?
Dialogue: 0,1:01:21.34,1:01:24.82,Default,,0,0,0,,May nagsabi sa akin minsan na ang\Nmatalino ay kumakain ng karne kapag mahirap ang panahon.
Dialogue: 0,1:01:24.84,1:01:27.86,Default,,0,0,0,,Oo, tama ka.
Dialogue: 0,1:01:27.89,1:01:31.95,Default,,0,0,0,,Ang determinasyon lang ay hindi\Npalakasin ang iyong paghahangad.
Dialogue: 0,1:01:31.97,1:01:33.99,Default,,0,0,0,,Mahalaga rin ang iyong kalusugan.
Dialogue: 0,1:01:34.02,1:01:36.29,Default,,0,0,0,,- Punasan mo ang iyong mga kamay.\N- Okay.
Dialogue: 0,1:01:36.31,1:01:40.46,Default,,0,0,0,,At isipin kung ano ang iyong kinain\Hindi lahat ng iyong espesyal na okasyon.
Dialogue: 0,1:01:40.48,1:01:41.92,Default,,0,0,0,,Ito ay karne.
Dialogue: 0,1:01:41.94,1:01:44.61,Default,,0,0,0,,Tama? Mga kaarawan, graduation,\Nang araw na nakakuha ka ng bagong trabaho,
Dialogue: 0,1:01:44.64,1:01:45.63,Default,,0,0,0,,at tingnan mo.
Dialogue: 0,1:01:45.66,1:01:49.05,Default,,0,0,0,,Ipinagdiriwang din namin siya\Ndischarge dahil sa ilang karne.
Dialogue: 0,1:01:49.08,1:01:51.80,Default,,0,0,0,,Palagi kaming may Chinese food tuwing birthday ko.
Dialogue: 0,1:01:51.83,1:01:54.95,Default,,0,0,0,,Ano ang sweet-and-sour na baboy?\NPaano ang chili chicken?
Dialogue: 0,1:01:56.37,1:01:58.41,Default,,0,0,0,,- Let me grill it.\N- Ikaw?
Dialogue: 0,1:01:58.54,1:02:00.77,Default,,0,0,0,,Kane lang ang kinakain mo...
Dialogue: 0,1:02:00.80,1:02:02.36,Default,,0,0,0,,iyan ay inihain sa iyong plato.
Dialogue: 0,1:02:02.38,1:02:05.07,Default,,0,0,0,,Magiihaw na ako ng karne ng pamilya ko simula ngayon.
Dialogue: 0,1:02:05.09,1:02:06.94,Default,,0,0,0,,Ibaba mo ang iyong mga sipit.
Dialogue: 0,1:02:06.97,1:02:08.84,Default,,0,0,0,,- Hayaan mo.\N- Oo, sir.
Dialogue: 0,1:02:15.48,1:02:16.66,Default,,0,0,0,,Hae-in, naalala ko...
Dialogue: 0,1:02:16.69,1:02:19.71,Default,,0,0,0,,pinakamahalaga ang sinasabi ng doktor na iyong WBC.
Dialogue: 0,1:02:19.73,1:02:21.75,Default,,0,0,0,,Sabi niya kailangan mong abutin...
Dialogue: 0,1:02:21.77,1:02:25.10,Default,,0,0,0,,isang partikular na antas upang makatanggap ng paggamot sa Germany.
Dialogue: 0,1:02:25.40,1:02:26.46,Default,,0,0,0,,Tama iyan.
Dialogue: 0,1:02:26.49,1:02:27.97,Default,,0,0,0,,Ang aking WBC ay kailangang...
Dialogue: 0,1:02:27.99,1:02:31.89,Default,,0,0,0,,sa pagitan ng 4000 at 10,000 cell bawat microliter.
Dialogue: 0,1:02:31.91,1:02:34.01,Default,,0,0,0,,Gaano ito kataas sa Germany?
Dialogue: 0,1:02:34.04,1:02:35.95,Default,,0,0,0,,Ito ay 1500 cells/µL.
Dialogue: 0,1:02:37.04,1:02:38.02,Default,,0,0,0,,Napakababa.
Dialogue: 0,1:02:38.04,1:02:40.64,Default,,0,0,0,,Ngunit tumaas ito kamakailan.
Dialogue: 0,1:02:40.67,1:02:43.04,Default,,0,0,0,,Mga 3000 na ngayon.
Dialogue: 0,1:02:43.59,1:02:45.11,Default,,0,0,0,,Doble ang halaga.
Dialogue: 0,1:02:45.13,1:02:46.82,Default,,0,0,0,,Proud ako sa iyo.
Dialogue: 0,1:02:46.84,1:02:49.07,Default,,0,0,0,,Well... Hindi ganoon kalaki ang deal.
Dialogue: 0,1:02:49.09,1:02:52.61,Default,,0,0,0,,- May lampas 1000 pa ako.\N- Malapit ka na.
Dialogue: 0,1:02:52.64,1:02:54.41,Default,,0,0,0,,Subukan pa.
Dialogue: 0,1:02:54.43,1:02:57.95,Default,,0,0,0,,Uy, hindi ito tulad ng pag-aaral.\NI ay hindi maaaring "magsumikap."
Dialogue: 0,1:02:57.98,1:03:01.04,Default,,0,0,0,,Kung ganoon, ano ang dapat mong gawin? Kumuha ng mga iniksyon at?
Dialogue: 0,1:03:01.06,1:03:02.58,Default,,0,0,0,,Tinignan ko ito.
Dialogue: 0,1:03:02.61,1:03:06.46,Default,,0,0,0,,Ito ay tungkol sa kanyang stamina at immunity.
Dialogue: 0,1:03:06.49,1:03:09.76,Default,,0,0,0,,Kailangan niyang kumain ng maayos at uminom ng\Na maraming bitamina at protina.
Dialogue: 0,1:03:09.78,1:03:11.13,Default,,0,0,0,,Kailangan din niya ng magandang pahinga.
Dialogue: 0,1:03:11.16,1:03:14.33,Default,,0,0,0,,Kung gayon kailangan niyang kumain ng maraming karne...
Dialogue: 0,1:03:14.35,1:03:15.35,Default,,0,0,0,,at beans.
Dialogue: 0,1:03:15.37,1:03:18.03,Default,,0,0,0,,Planohin ko na ang diet niya.
Dialogue: 0,1:03:24.46,1:03:25.77,Default,,0,0,0,,- Beom-jun.\N- Oo?
Dialogue: 0,1:03:25.80,1:03:27.50,Default,,0,0,0,,I-flip ang mga ito.
Dialogue: 0,1:03:27.72,1:03:29.83,Default,,0,0,0,,Tama.
Dialogue: 0,1:03:31.05,1:03:32.03,Default,,0,0,0,,Hindi.
Dialogue: 0,1:03:32.05,1:03:33.78,Default,,0,0,0,,Nasunog sila. Ano ang dapat kong gawin?
Dialogue: 0,1:03:33.81,1:03:35.80,Default,,0,0,0,,Pwede natin silang putulin.
Dialogue: 0,1:03:36.02,1:03:38.20,Default,,0,0,0,,- Maaari mo bang ibigay sa akin ang gunting?\N- Hindi.
Dialogue: 0,1:03:38.23,1:03:39.80,Default,,0,0,0,,Gagawin ko.
Dialogue: 0,1:03:40.44,1:03:42.75,Default,,0,0,0,,Kaya kailangan niya ng karne at beans.
Dialogue: 0,1:03:42.77,1:03:43.87,Default,,0,0,0,,Ano pa?
Dialogue: 0,1:03:43.90,1:03:46.96,Default,,0,0,0,,Mga saging at mani...
Dialogue: 0,1:03:46.98,1:03:49.51,Default,,0,0,0,,- Maganda ito.\N- Gosh.
Dialogue: 0,1:03:49.53,1:03:51.81,Default,,0,0,0,,Masarap ito.
Dialogue: 0,1:03:52.03,1:03:53.73,Default,,0,0,0,,Maganda talaga.
Dialogue: 0,1:03:53.83,1:03:56.11,Default,,0,0,0,,- Look.\N- Excited siya.
Dialogue: 0,1:03:57.87,1:03:59.78,Default,,0,0,0,,Kabutihan.
Dialogue: 0,1:04:00.96,1:04:02.78,Default,,0,0,0,,Kailangan mong i-flip ito.
Dialogue: 0,1:04:03.75,1:04:05.54,Default,,0,0,0,,Tingnan mo ito.
Dialogue: 0,1:04:06.67,1:04:08.36,Default,,0,0,0,,Kailangan niya ng maraming protina.
Dialogue: 0,1:04:08.38,1:04:10.42,Default,,0,0,0,,Ginagawa niya.
Dialogue: 0,1:04:14.22,1:04:16.28,Default,,0,0,0,,Kumain habang ginagawa mo ito.
Dialogue: 0,1:04:16.31,1:04:19.13,Default,,0,0,0,,Punasan ito para sa kanya.
Dialogue: 0,1:04:28.99,1:04:30.52,Default,,0,0,0,,Pumasok.
Dialogue: 0,1:04:35.28,1:04:37.78,Default,,0,0,0,,Hindi na ito gumagana muli.
Dialogue: 0,1:04:39.45,1:04:41.41,Default,,0,0,0,,Hindi ba?
Dialogue: 0,1:04:45.29,1:04:47.27,Default,,0,0,0,,Kailangan mo lang pindutin ang bahaging ito.
Dialogue: 0,1:04:47.30,1:04:50.75,Default,,0,0,0,,Hindi ako kasinggaling mo.
Dialogue: 0,1:04:51.76,1:04:53.82,Default,,0,0,0,,Dapat ba akong bumili ng bago?
Dialogue: 0,1:04:53.84,1:04:54.90,Default,,0,0,0,,Bakit?
Dialogue: 0,1:04:54.93,1:04:56.28,Default,,0,0,0,,Dahil nahihirapan kang gamitin ito.
Dialogue: 0,1:04:56.30,1:04:59.54,Default,,0,0,0,,Magagawa mo ito para sa akin.\NTingnan mo kung gaano ka kagaling.
Dialogue: 0,1:05:02.35,1:05:03.83,Default,,0,0,0,,Sa tingin ko...
Dialogue: 0,1:05:03.85,1:05:05.51,Default,,0,0,0,,Bumabuti na ako...
Dialogue: 0,1:05:06.98,1:05:09.10,Default,,0,0,0,, lalo kong pinapatuyo ang iyong buhok.
Dialogue: 0,1:05:11.74,1:05:12.71,Default,,0,0,0,,Tama ka.
Dialogue: 0,1:05:12.74,1:05:15.06,Default,,0,0,0,,Maganda ang ginawa mo sa mga kulot.
Dialogue: 0,1:05:17.33,1:05:20.55,Default,,0,0,0,,Ngayong magaling ka na,\Npatuloy mong patuyuin ang buhok ko para sa akin.
Dialogue: 0,1:05:20.58,1:05:22.21,Default,,0,0,0,,Oo naman. Hindi problema yun.
Dialogue: 0,1:05:22.23,1:05:23.22,Default,,0,0,0,,Ano pa?
Dialogue: 0,1:05:23.25,1:05:27.70,Default,,0,0,0,,Sabihin mo sa akin kung ano pa ang gusto mong gawin ko, at gagawin ko.
Dialogue: 0,1:05:29.09,1:05:30.69,Default,,0,0,0,,Masaya ako,
Dialogue: 0,1:05:30.71,1:05:34.58,Default,,0,0,0,,basta patuyuin mo ang buhok ko\Ngamit ang sirang hair dryer.
Dialogue: 0,1:05:36.14,1:05:37.78,Default,,0,0,0,,So ito lang?
Dialogue: 0,1:05:37.80,1:05:39.45,Default,,0,0,0,,Ito ay isang malaking pabor.
Dialogue: 0,1:05:39.47,1:05:42.24,Default,,0,0,0,,Kailangan mo akong kasama araw-araw.
Dialogue: 0,1:05:42.27,1:05:43.66,Default,,0,0,0,,Hindi ko akalain...
Dialogue: 0,1:05:43.68,1:05:46.72,Default,,0,0,0,,dapat ako ay matakaw sa ngayon.
Dialogue: 0,1:05:48.31,1:05:50.90,Default,,0,0,0,,Hindi, maging gahaman.
Dialogue: 0,1:05:50.93,1:05:51.96,Default,,0,0,0,,Kaya mo.
Dialogue: 0,1:05:51.98,1:05:54.34,Default,,0,0,0,,Huwag mo na akong piliting tratuhin nang maayos.
Dialogue: 0,1:05:54.36,1:05:58.13,Default,,0,0,0,,Hindi ko ipinagtapat ang pagmamahal ko kay\Nyou para mas maganda ang pakikitungo mo sa akin.
Dialogue: 0,1:05:58.16,1:05:59.69,Default,,0,0,0,,Ako ay...
Dialogue: 0,1:06:00.20,1:06:01.76,Default,,0,0,0,,expressing my feelings.
Dialogue: 0,1:06:01.79,1:06:03.49,Default,,0,0,0,,Gayundin sa akin.
Dialogue: 0,1:06:05.29,1:06:06.91,Default,,0,0,0,,Gusto ito ng puso ko.
Dialogue: 0,1:06:08.21,1:06:10.08,Default,,0,0,0,,Gusto kong gumawa ng mas mahusay,
Dialogue: 0,1:06:10.46,1:06:12.45,Default,,0,0,0,,kung kaya ko.
Dialogue: 0,1:06:13.21,1:06:14.96,Default,,0,0,0,,Yun ang nararamdaman ko.
Dialogue: 0,1:06:21.39,1:06:23.09,Default,,0,0,0,,Kahapon...
Dialogue: 0,1:06:23.14,1:06:25.97,Default,,0,0,0,,Hindi ko makilala ang mukha ni Soo-cheol...
Dialogue: 0,1:06:26.52,1:06:29.64,Default,,0,0,0,,sa loob ng ilang segundo.
Dialogue: 0,1:06:30.06,1:06:33.52,Default,,0,0,0,,Hindi ko rin maalala ang pangalan ng doktor ko.
Dialogue: 0,1:06:33.78,1:06:36.30,Default,,0,0,0,,Naligaw din ako sa kwarto ko sa ospital...
Dialogue: 0,1:06:36.32,1:06:39.27,Default,,0,0,0,,sa loob ng isang minuto, at nakatayo lang.
Dialogue: 0,1:06:40.78,1:06:43.80,Default,,0,0,0,,Noong unang sinabi sa akin ng aking doktor ang tungkol sa aking sakit,
Dialogue: 0,1:06:43.83,1:06:45.60,Default,,0,0,0,,binanggit niya ang pagkawala ng memorya,
Dialogue: 0,1:06:45.62,1:06:48.60,Default,,0,0,0,,pagkawala ng pandama, at kapansanan sa pagsasalita,
Dialogue: 0,1:06:48.62,1:06:50.87,Default,,0,0,0,,pero hindi ako naniwala sa kanya.
Dialogue: 0,1:06:51.63,1:06:53.95,Default,,0,0,0,,Akala ko sa iba lang nangyari yun.
Dialogue: 0,1:06:54.21,1:06:56.37,Default,,0,0,0,,Akala ko iba ako,
Dialogue: 0,1:06:57.05,1:07:01.49,Default,,0,0,0,,ngunit nangyayari ito sa eksaktong pagkakasunud-sunod.
Dialogue: 0,1:07:01.51,1:07:06.01,Default,,0,0,0,,Asahan ko ang susunod na sintomas,\Nand ito ay nakakatakot.
Dialogue: 0,1:07:06.35,1:07:07.95,Default,,0,0,0,,Ayoko sayo...
Dialogue: 0,1:07:07.98,1:07:10.76,Default,,0,0,0,,na katabi ko kapag nangyari ito.
Dialogue: 0,1:07:14.69,1:07:16.21,Default,,0,0,0,,Anong sinasabi mo?
Dialogue: 0,1:07:16.24,1:07:18.81,Default,,0,0,0,,Maging masaya tayo kung nasaan tayo ngayon,
Dialogue: 0,1:07:20.07,1:07:21.72,Default,,0,0,0,,at kapag lumala ang sakit ko,
Dialogue: 0,1:07:21.74,1:07:23.86,Default,,0,0,0,,Gusto kita...
Dialogue: 0,1:07:24.37,1:07:26.61,Default,,0,0,0,,para iwan ako.
Dialogue: 0,1:07:29.50,1:07:31.24,Default,,0,0,0,,Iyan ang hiling ko.
Dialogue: 0,1:07:50.52,1:07:52.29,Default,,0,0,0,,Ano? Kailan siya umalis sa laro?
Dialogue: 0,1:07:52.31,1:07:53.46,Default,,0,0,0,,May nangyari ba?
Dialogue: 0,1:07:53.48,1:07:54.46,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Na-deactivate na Miyembro{\c}{\i0}
Dialogue: 0,1:07:55.19,1:07:56.73,Default,,0,0,0,,Darn it.
Dialogue: 0,1:08:18.30,1:08:19.83,Default,,0,0,0,,Uminom.
Dialogue: 0,1:08:27.68,1:08:29.51,Default,,0,0,0,,Ganun ba kapait?
Dialogue: 0,1:08:33.27,1:08:36.26,Default,,0,0,0,,- Hindi kasing buhay ko.\N- Mahal.
Dialogue: 0,1:08:40.57,1:08:42.42,Default,,0,0,0,,Guro, mangyaring makipag-usap sa akin nang basta-basta.
Dialogue: 0,1:08:42.45,1:08:44.15,Default,,0,0,0,,"Master"?
Dialogue: 0,1:08:47.37,1:08:49.68,Default,,0,0,0,,Turuan mo ako kung paano mag-box.
Dialogue: 0,1:08:49.70,1:08:52.14,Default,,0,0,0,,Hindi ako makapunta ng isang suntok...
Dialogue: 0,1:08:52.16,1:08:56.58,Default,,0,0,0,,on Eun-sung last time,\Nand ay napahiya.
Dialogue: 0,1:08:58.55,1:08:59.90,Default,,0,0,0,,Naiintindihan ko,
Dialogue: 0,1:08:59.92,1:09:02.32,Default,,0,0,0,,pero kung bigla kang magsisimula\Nmagtrabaho dahil sa galit,
Dialogue: 0,1:09:02.34,1:09:04.57,Default,,0,0,0,,- masasaktan mo ang mga kasukasuan mo...\N- Mga kasukasuan?
Dialogue: 0,1:09:04.59,1:09:05.70,Default,,0,0,0,,Okay lang sa akin!
Dialogue: 0,1:09:05.72,1:09:08.51,Default,,0,0,0,,Mababaliw na ako sa ganitong bilis!
Dialogue: 0,1:09:09.10,1:09:13.68,Default,,0,0,0,,Paano kung kailangan kong protektahan ang aking\Npamilya sa hinaharap, ngunit hindi ko magawa?
Dialogue: 0,1:09:15.06,1:09:16.25,Default,,0,0,0,,kinatakutan ko ito.
Dialogue: 0,1:09:16.27,1:09:18.31,Default,,0,0,0,,Oh, mahal.
Dialogue: 0,1:09:22.24,1:09:23.46,Default,,0,0,0,,Fine.
Dialogue: 0,1:09:23.49,1:09:25.27,Default,,0,0,0,,Tuturuan kita.
Dialogue: 0,1:09:26.20,1:09:27.18,Default,,0,0,0,,Salamat.
Dialogue: 0,1:09:27.20,1:09:28.43,Default,,0,0,0,,Umupo.
Dialogue: 0,1:09:28.45,1:09:29.51,Default,,0,0,0,,Umupo.
Dialogue: 0,1:09:29.54,1:09:31.32,Default,,0,0,0,,Umupo.
Dialogue: 0,1:09:32.87,1:09:35.23,Default,,0,0,0,,Dahil ginagawa namin ito nang nagmamadali,
Dialogue: 0,1:09:35.25,1:09:37.04,Default,,0,0,0,,Isa lang ang maituturo ko sa iyo.
Dialogue: 0,1:09:37.07,1:09:38.06,Default,,0,0,0,,Ano iyon?
Dialogue: 0,1:09:38.09,1:09:40.20,Default,,0,0,0,,Paglapag ng isang suntok...
Dialogue: 0,1:09:41.05,1:09:43.29,Default,,0,0,0,,sa isang taong makapangyarihan.
Dialogue: 0,1:09:48.35,1:09:50.92,Default,,0,0,0,,May dalawang pangunahing kasanayan.
Dialogue: 0,1:09:51.31,1:09:52.84,Default,,0,0,0,,Soo-cheol.
Dialogue: 0,1:09:53.68,1:09:55.43,Default,,0,0,0,,Pindutin mo ako.
Dialogue: 0,1:09:55.90,1:09:57.43,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,1:10:02.57,1:10:04.48,Default,,0,0,0,,Ganyan na ba ako kalakas?
Dialogue: 0,1:10:05.45,1:10:08.48,Default,,0,0,0,,Hindi, ito ang unang kasanayan.
Dialogue: 0,1:10:08.58,1:10:09.55,Default,,0,0,0,,Exaggerate,
Dialogue: 0,1:10:09.58,1:10:11.89,Default,,0,0,0,,para maging mayabang sila at mag-isip,
Dialogue: 0,1:10:11.91,1:10:13.89,Default,,0,0,0,,"Hindi siya kapares sa akin."
Dialogue: 0,1:10:13.91,1:10:15.56,Default,,0,0,0,,"Medyo nanalo ako."
Dialogue: 0,1:10:15.58,1:10:18.16,Default,,0,0,0,,"Nakakagulat na malakas ako."
Dialogue: 0,1:10:18.97,1:10:20.62,Default,,0,0,0,,Okay, dalhin ito.
Dialogue: 0,1:10:25.22,1:10:27.03,Default,,0,0,0,,- Magaling.\N- Masakit talaga!
Dialogue: 0,1:10:27.05,1:10:28.78,Default,,0,0,0,,- Sorry.\N- Ilong ko!
Dialogue: 0,1:10:28.80,1:10:31.16,Default,,0,0,0,,Bakit ko kailangang matutunan ito?
Dialogue: 0,1:10:31.18,1:10:32.99,Default,,0,0,0,,Kaya hahayaan nila ang kanilang bantay.
Dialogue: 0,1:10:33.02,1:10:36.16,Default,,0,0,0,,Dapat kang maghintay hanggang sa mawala ang kanilang bantay,
Dialogue: 0,1:10:36.19,1:10:38.21,Default,,0,0,0,,pagkatapos ay ilagay ang iyong kritikal na suntok.
Dialogue: 0,1:10:38.23,1:10:39.96,Default,,0,0,0,,Pero binubugbog hanggang dun?
Dialogue: 0,1:10:39.98,1:10:41.79,Default,,0,0,0,,Iyon ang pangalawang kasanayan.
Dialogue: 0,1:10:41.82,1:10:43.29,Default,,0,0,0,,Endurance.
Dialogue: 0,1:10:43.32,1:10:46.09,Default,,0,0,0,,Kailangan mo ng stamina para makakuha ng mga suntok.
Dialogue: 0,1:10:46.11,1:10:48.31,Default,,0,0,0,,Sa tingin mo kaya ko yun?
Dialogue: 0,1:10:54.95,1:10:57.22,Default,,0,0,0,,Si Muhammad Ali, ang aking mentor, ang nagsabi nito.
Dialogue: 0,1:10:57.25,1:10:58.81,Default,,0,0,0,,"Imposible..."
Dialogue: 0,1:10:58.83,1:11:01.53,Default,,0,0,0,,"ay hindi katotohanan, ito ay opinyon."
Dialogue: 0,1:11:06.72,1:11:08.78,Default,,0,0,0,,Kaya mo, Soo-cheol.
Dialogue: 0,1:11:08.80,1:11:12.03,Default,,0,0,0,,Take some blows for now\Nand maging kampeon sa buhay.
Dialogue: 0,1:11:12.05,1:11:13.91,Default,,0,0,0,,Sinabi din ba yan ng mentor mo?
Dialogue: 0,1:11:13.93,1:11:15.58,Default,,0,0,0,,Hindi, ako ang nagsasalita.
Dialogue: 0,1:11:15.60,1:11:16.58,Default,,0,0,0,,Sige.
Dialogue: 0,1:11:16.60,1:11:18.16,Default,,0,0,0,,Subukan natin ito.
Dialogue: 0,1:11:18.19,1:11:19.72,Default,,0,0,0,,Okay.
Dialogue: 0,1:11:30.70,1:11:31.80,Default,,0,0,0,,Kabutihan.
Dialogue: 0,1:11:31.82,1:11:34.34,Default,,0,0,0,,Hindi ko alam na\Nrelax ka sa ganito kagandang...
Dialogue: 0,1:11:34.37,1:11:36.68,Default,,0,0,0,,at malinis na kapaligiran.
Dialogue: 0,1:11:36.70,1:11:37.97,Default,,0,0,0,,Nakaka-relax, paa ko.
Dialogue: 0,1:11:38.00,1:11:39.47,Default,,0,0,0,,Ang lakas ng loob mong pumunta dito?
Dialogue: 0,1:11:39.50,1:11:41.57,Default,,0,0,0,,Inay, niyaya ko siya.
Dialogue: 0,1:11:41.67,1:11:43.02,Default,,0,0,0,,Talaga? Bakit?
Dialogue: 0,1:11:43.04,1:11:45.23,Default,,0,0,0,,May isang bagay na hindi ko nasabi sa iyo.
Dialogue: 0,1:11:45.25,1:11:47.79,Default,,0,0,0,,Tungkol ito sa secret fund ni Lolo.
Dialogue: 0,1:11:49.68,1:11:51.07,Default,,0,0,0,,$900 milyon?
Dialogue: 0,1:11:51.09,1:11:53.24,Default,,0,0,0,,At ang pera ay nasa Malaysia?
Dialogue: 0,1:11:53.26,1:11:54.86,Default,,0,0,0,,Hindi, sa tingin ko nandito na.
Dialogue: 0,1:11:54.89,1:11:55.95,Default,,0,0,0,,- Sa Korea?\N- Yes, sir.
Dialogue: 0,1:11:55.97,1:11:58.70,Default,,0,0,0,,Na-launder ito sa\NHong Kong bago pumunta rito.
Dialogue: 0,1:11:58.73,1:12:00.33,Default,,0,0,0,,Ang kumpanyang papel na iyon...
Dialogue: 0,1:12:00.35,1:12:03.62,Default,,0,0,0,,pinahiram ang pera sa limang\Ninvestment company sa Korea...
Dialogue: 0,1:12:03.65,1:12:05.58,Default,,0,0,0,,bago isara.
Dialogue: 0,1:12:05.61,1:12:09.13,Default,,0,0,0,,Ibig sabihin, hindi na kailangang bayaran ng limang kumpanya\N.
Dialogue: 0,1:12:09.15,1:12:11.34,Default,,0,0,0,,Pagmamay-ari ba ni Tatay ang mga kumpanyang iyon?
Dialogue: 0,1:12:11.36,1:12:13.88,Default,,0,0,0,,Bago siya bumagsak,\Inilipat ang Nowership...
Dialogue: 0,1:12:13.91,1:12:15.68,Default,,0,0,0,,kay Ms. Moh.
Dialogue: 0,1:12:15.70,1:12:16.76,Default,,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,1:12:16.79,1:12:18.97,Default,,0,0,0,,Sinasabi mo ba na kinuha lahat ng wench?
Dialogue: 0,1:12:19.00,1:12:21.14,Default,,0,0,0,,Sa tingin ko ay hindi.
Dialogue: 0,1:12:21.17,1:12:23.41,Default,,0,0,0,,{\i1}Hinahanap pa rin niya.{\i0}
Dialogue: 0,1:12:31.43,1:12:32.65,Default,,0,0,0,,{\i1}Sabihin mo sa akin.{\i0}
Dialogue: 0,1:12:32.68,1:12:33.74,Default,,0,0,0,,{\i1}Nasaan ang pera ko?{\i0}
Dialogue: 0,1:12:33.76,1:12:36.74,Default,,0,0,0,,{\i1}Nasaan ang lihim na pondo na itinago mo sa ilalim ng aking pangalan?{\i0}
Dialogue: 0,1:12:36.76,1:12:38.70,Default,,0,0,0,,Sigurado ka bang pinapayagan si Grace...
Dialogue: 0,1:12:38.72,1:12:40.37,Default,,0,0,0,,- para marinig ito?\N- Mapagkakatiwalaan mo ako.
Dialogue: 0,1:12:40.39,1:12:42.41,Default,,0,0,0,,Nag-defect ako.
Dialogue: 0,1:12:42.44,1:12:43.71,Default,,0,0,0,,Remember Lee Woong-pyung?
Dialogue: 0,1:12:43.73,1:12:45.46,Default,,0,0,0,,Pinalipad ko na rin ang jet ko...
Dialogue: 0,1:12:45.48,1:12:48.08,Default,,0,0,0,,sa lupain ng kalayaan.
Dialogue: 0,1:12:48.11,1:12:50.88,Default,,0,0,0,,Tingnan natin ang tungkol diyan.\NTingnan natin ang iyong jet.
Dialogue: 0,1:12:50.90,1:12:52.01,Default,,0,0,0,,Sabihin sa amin.
Dialogue: 0,1:12:52.03,1:12:55.93,Default,,0,0,0,,May kakaibang sinabi ang isang taong kilala ko sa real-estate\Nnegosyo.
Dialogue: 0,1:12:55.95,1:12:58.68,Default,,0,0,0,,Yung Direktor Jin ng Queens Gallery nirentahan...
Dialogue: 0,1:12:58.70,1:13:01.39,Default,,0,0,0,,isang 4-acre na bodega sa\Noutskirts ng Gyeonggi Province.
Dialogue: 0,1:13:01.41,1:13:04.89,Default,,0,0,0,,Hindi naman sila gumagawa ng set ng pelikula,
Dialogue: 0,1:13:04.92,1:13:06.48,Default,,0,0,0,,so bakit kailangan nila ng napakalaking isa?
Dialogue: 0,1:13:06.51,1:13:08.56,Default,,0,0,0,,Kaya sa tingin mo nandiyan ang pera.
Dialogue: 0,1:13:14.84,1:13:17.20,Default,,0,0,0,,Sinabi mo sa akin na dalhin mo lahat ng mail na ipinadala...
Dialogue: 0,1:13:17.22,1:13:18.74,Default,,0,0,0,,sa dating chairman.
Dialogue: 0,1:13:18.76,1:13:20.30,Default,,0,0,0,,Maganda.
Dialogue: 0,1:13:25.73,1:13:27.29,Default,,0,0,0,,Kaya kong dumating mag-isa.
Dialogue: 0,1:13:27.31,1:13:29.67,Default,,0,0,0,,Hindi mo na kailangang mag-umpok dito.
Dialogue: 0,1:13:29.69,1:13:33.38,Default,,0,0,0,,Hindi ka namin mapagkakatiwalaan. Ito ay tulad ng\Npag-iiwan ng isang bata sa kanyang sariling mga aparato.
Dialogue: 0,1:13:33.40,1:13:35.80,Default,,0,0,0,,Nalantad kayong lahat sa media.
Dialogue: 0,1:13:35.82,1:13:38.93,Default,,0,0,0,,- Paano kung makilala ka nila?\N- Nag disguise kami.
Dialogue: 0,1:13:38.95,1:13:41.78,Default,,0,0,0,,Kami ang kukuha mula rito, kaya maaari kang umalis.
Dialogue: 0,1:13:42.20,1:13:44.39,Default,,0,0,0,,Sinasaktan mo ang damdamin ko.
Dialogue: 0,1:13:44.42,1:13:47.14,Default,,0,0,0,,Ito ay isang undercover na misyon.
Dialogue: 0,1:13:47.17,1:13:49.52,Default,,0,0,0,,Nagpeke ka na ba dati? Hindi.
Dialogue: 0,1:13:49.55,1:13:51.90,Default,,0,0,0,,Buong buhay ko ay peke,
Dialogue: 0,1:13:51.92,1:13:54.03,Default,,0,0,0,,so paano mo ako iiwan dito?
Dialogue: 0,1:13:54.05,1:13:56.57,Default,,0,0,0,,Okay. Pansin, pakiusap.
Dialogue: 0,1:13:56.59,1:13:58.45,Default,,0,0,0,,Ako ay isang real-estate agent,
Dialogue: 0,1:13:58.47,1:14:02.41,Default,,0,0,0,,at ikaw ay mga wholesale na dealer\Nna nangangailangan ng malaking bodega.
Dialogue: 0,1:14:02.43,1:14:05.54,Default,,0,0,0,,Ako na ang magsasalita, kaya huwag kang magsalita ng kahit ano.
Dialogue: 0,1:14:08.15,1:14:09.89,Default,,0,0,0,,Tara na.
Dialogue: 0,1:14:13.49,1:14:16.34,Default,,0,0,0,,Walang lugar para itago ang lahat ng pera.
Dialogue: 0,1:14:16.36,1:14:17.63,Default,,0,0,0,,Nga pala,
Dialogue: 0,1:14:17.66,1:14:19.44,Default,,0,0,0,,ano ang iimbak nila?
Dialogue: 0,1:14:22.79,1:14:24.99,Default,,0,0,0,,- Mga golf club...\N- Damit...
Dialogue: 0,1:14:26.17,1:14:27.64,Default,,0,0,0,,Nag-import siya...
Dialogue: 0,1:14:27.67,1:14:29.94,Default,,0,0,0,,golf equipment,
Dialogue: 0,1:14:29.96,1:14:32.61,Default,,0,0,0,,at nagbebenta siya ng mga damit sa Dongdaemun.
Dialogue: 0,1:14:32.63,1:14:34.90,Default,,0,0,0,,Siya ay mula sa China.
Dialogue: 0,1:14:34.92,1:14:37.40,Default,,0,0,0,,Naiintindihan niya ang Korean,
Dialogue: 0,1:14:37.43,1:14:39.63,Default,,0,0,0,,ngunit hindi ito makapagsalita.
Dialogue: 0,1:14:40.85,1:14:43.84,Default,,0,0,0,,Sir. Walang kulantro.
Dialogue: 0,1:14:43.97,1:14:46.34,Default,,0,0,0,,Hindi ako nagsasalita ng Chinese.
Dialogue: 0,1:14:51.02,1:14:53.63,Default,,0,0,0,,Nandito ba ang temperatura at halumigmig...
Dialogue: 0,1:14:53.65,1:14:54.71,Default,,0,0,0,,na kinokontrol?
Dialogue: 0,1:14:54.74,1:14:55.80,Default,,0,0,0,,Napansin mo.
Dialogue: 0,1:14:55.82,1:14:59.47,Default,,0,0,0,,Nag-import ng sining ang dati naming mga customer.
Dialogue: 0,1:14:59.49,1:15:01.34,Default,,0,0,0,,Medyo alam ko ang art.
Dialogue: 0,1:15:01.37,1:15:02.51,Default,,0,0,0,,Sino ang mga artist?
Dialogue: 0,1:15:02.53,1:15:04.55,Default,,0,0,0,,Hindi sila sikat.
Dialogue: 0,1:15:04.58,1:15:06.68,Default,,0,0,0,,Rookies sila noon, pero sikat na sikat na sila ngayon.
Dialogue: 0,1:15:06.71,1:15:08.98,Default,,0,0,0,,Ang kanilang mga gawa ay tumalon ng 20 hanggang 30 beses sa presyo.
Dialogue: 0,1:15:09.00,1:15:11.19,Default,,0,0,0,,Nagdudulot ng magandang enerhiya ang lugar na ito.
Dialogue: 0,1:15:11.21,1:15:14.61,Default,,0,0,0,,- Walang cilantro sa ulam ko, please.\N- Oo.
Dialogue: 0,1:15:14.63,1:15:17.01,Default,,0,0,0,,Gusto niyang makita ang artwork.
Dialogue: 0,1:15:17.03,1:15:18.03,Default,,0,0,0,,Sure thing.
Dialogue: 0,1:15:18.05,1:15:21.42,Default,,0,0,0,,Kamahalan, ano na ang nangyari sa aking anak?
Dialogue: 0,1:15:24.10,1:15:25.62,Default,,0,0,0,,{\i1}Bukas ang main door.{\i0}
Dialogue: 0,1:15:25.64,1:15:27.62,Default,,0,0,0,,{\i1}Papasok na kami sa loob, kaya tingnan ang opisina.{\i0}
Dialogue: 0,1:15:27.64,1:15:30.26,Default,,0,0,0,,Okay. gagawin ko yan.
Dialogue: 0,1:15:43.37,1:15:45.09,Default,,0,0,0,,Itinuturing itong business trip.
Dialogue: 0,1:15:45.12,1:15:47.53,Default,,0,0,0,,Babayaran kita ng extra.
Dialogue: 0,1:15:48.50,1:15:53.37,Default,,0,0,0,,Hindi talaga nila ako dapat mahuli na ginagawa ito dito.
Dialogue: 0,1:16:04.18,1:16:08.24,Default,,0,0,0,,Ito ang maling paraan upang mag-imbak ng likhang sining.
Dialogue: 0,1:16:08.27,1:16:11.37,Default,,0,0,0,,Sabi mo ba itong mga piraso\Nof artwork ay tumalon sa presyo?
Dialogue: 0,1:16:11.40,1:16:13.37,Default,,0,0,0,,Oo, yun ang narinig ko.
Dialogue: 0,1:16:13.40,1:16:18.10,Default,,0,0,0,,Magaling ako sa sining, ngunit\Nhindi sila ganoon kaganda sa akin.
Dialogue: 0,1:16:22.57,1:16:26.05,Default,,0,0,0,,Sa tingin ko nasa artwork ang pera.\NDito niya nilabaan.
Dialogue: 0,1:16:26.08,1:16:29.47,Default,,0,0,0,,Kaya binili niya ang trabaho ng mga baguhang artista sa mataas na halaga gamit ang pera?
Dialogue: 0,1:16:29.50,1:16:31.43,Default,,0,0,0,,Oo, sampu hanggang dalawampung ulit.
Dialogue: 0,1:16:31.46,1:16:33.98,Default,,0,0,0,,Pagkatapos ilipat ang pera,\NI think 90% or more of it...
Dialogue: 0,1:16:34.00,1:16:36.27,Default,,0,0,0,,ibinalik sa kanya sa pamamagitan ng cash.
Dialogue: 0,1:16:36.30,1:16:38.57,Default,,0,0,0,,Iyan ay isang malaking halaga.
Dialogue: 0,1:16:38.59,1:16:40.96,Default,,0,0,0,,I wonder where all that money is.
Dialogue: 0,1:16:43.89,1:16:45.01,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pagde-decrypt...{\c}{\i0}
Dialogue: 0,1:16:50.43,1:16:52.04,Default,,0,0,0,,Kailangan na nating umalis.
Dialogue: 0,1:16:52.06,1:16:53.41,Default,,0,0,0,,Wala kaming oras.
Dialogue: 0,1:16:53.44,1:16:54.54,Default,,0,0,0,,Darn it.
Dialogue: 0,1:16:54.56,1:16:56.81,Default,,0,0,0,,Masyadong maraming data.
Dialogue: 0,1:16:59.86,1:17:03.52,Default,,0,0,0,,Tatanungin ko ang aking mga kliyente at\Tatawagan ka kaagad.
Dialogue: 0,1:17:04.53,1:17:06.07,Default,,0,0,0,,Paalam.
Dialogue: 0,1:17:14.96,1:17:16.71,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Opisina\NPPaki-Knock{\c}{\i0}
Dialogue: 0,1:17:21.80,1:17:23.96,Default,,0,0,0,,Sira ba?
Dialogue: 0,1:17:41.19,1:17:45.10,Default,,0,0,0,,Hindi ka dapat mabasa. Maghintay\Ndito habang dinadala ko ang sasakyan.
Dialogue: 0,1:18:21.27,1:18:23.06,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:18:31.91,1:18:34.99,Default,,0,0,0,,Hyun-woo, mabilis iyon.
Dialogue: 0,1:18:35.79,1:18:37.23,Default,,0,0,0,,Bakit nandito ka sa labas?
Dialogue: 0,1:18:37.25,1:18:39.16,Default,,0,0,0,,Bumangon.
Dialogue: 0,1:18:45.22,1:18:46.83,Default,,0,0,0,,Medyo nahihilo ako.
Dialogue: 0,1:18:47.51,1:18:49.63,Default,,0,0,0,,Gutom na rin ako.
Dialogue: 0,1:18:52.64,1:18:55.59,Default,,0,0,0,,Kumain muna tayo ng masarap bago tayo umuwi.
Dialogue: 0,1:18:58.77,1:19:00.30,Default,,0,0,0,,Oo naman.
Dialogue: 0,1:19:17.50,1:19:19.16,Default,,0,0,0,,Matagal ba akong wala?
Dialogue: 0,1:19:20.96,1:19:23.04,Default,,0,0,0,,Hindi, hindi ganoon katagal.
Dialogue: 0,1:19:32.01,1:19:33.63,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:19:33.89,1:19:35.76,Default,,0,0,0,,Hang tight.
Dialogue: 0,1:19:36.06,1:19:37.54,Default,,0,0,0,,Bakit?
Dialogue: 0,1:19:37.56,1:19:39.12,Default,,0,0,0,,Binubuntot na naman ba tayo?
Dialogue: 0,1:19:39.14,1:19:41.30,Default,,0,0,0,,Huwag mag-alala. Kaya kong mawala siya.
Dialogue: 0,1:21:04.81,1:21:06.33,Default,,0,0,0,,- Okay ka lang?\N- Oo.
Dialogue: 0,1:21:06.36,1:21:08.89,Default,,0,0,0,,Tawagan ba natin ang pulis?
Dialogue: 0,1:21:09.15,1:21:10.46,Default,,0,0,0,,- Teka.\N- Dapat.
Dialogue: 0,1:21:10.49,1:21:13.31,Default,,0,0,0,,Inatake ka rin ng tatlong lalaki noong nakaraan.
Dialogue: 0,1:22:51.21,1:22:53.25,Default,,0,0,0,,Hae-in!
Dialogue: 0,1:23:09.61,1:23:10.58,Default,,0,0,0,,Sus.
Dialogue: 0,1:23:10.61,1:23:12.33,Default,,0,0,0,,Tingnan ang mga komentong ito.
Dialogue: 0,1:23:12.36,1:23:13.71,Default,,0,0,0,,Ito ay dahil si Eun-sung...
Dialogue: 0,1:23:13.73,1:23:16.34,Default,,0,0,0,,nagkakalat ng maling alingawngaw tungkol sa kung paano\Naka iniimbestigahan...
Dialogue: 0,1:23:16.37,1:23:18.38,Default,,0,0,0,,para sa paglustay ng pera bago ang diborsyo.
Dialogue: 0,1:23:18.41,1:23:19.42,Default,,0,0,0,,Okay lang. Huwag pansinin ang mga ito.
Dialogue: 0,1:23:19.45,1:23:21.63,Default,,0,0,0,,Paano ko kaya iyon magagawa?
Dialogue: 0,1:23:21.66,1:23:24.20,Default,,0,0,0,,"Dapat ay\Ninasal siya ng ex ni Hong Hae-in para sa pera."
Dialogue: 0,1:23:24.23,1:23:25.26,Default,,0,0,0,,"Scammer siya."
Dialogue: 0,1:23:25.29,1:23:27.52,Default,,0,0,0,"Ito ang dahilan kung bakit dapat kang\Nmag-ingat sa mga gwapong lalaki."
Dialogue: 0,1:23:27.54,1:23:29.77,Default,,0,0,0,,How dare they curse at you?
Dialogue: 0,1:23:29.79,1:23:31.10,Default,,0,0,0,,Kasuhan natin silang lahat.
Dialogue: 0,1:23:31.13,1:23:33.49,Default,,0,0,0,,Kalimutan mo na ito. Tara na.
Dialogue: 0,1:23:33.96,1:23:36.07,Default,,0,0,0,,Maghintay. May nagbad-mouth din kay Hae-in.
Dialogue: 0,1:23:36.09,1:23:39.28,Default,,0,0,0,,"Nakakuha na siya ng rebound after\Nthe divorce. She must be easy."
Dialogue: 0,1:23:39.30,1:23:41.07,Default,,0,0,0,,Wala silang alam tungkol sa kanya.
Dialogue: 0,1:23:41.09,1:23:44.17,Default,,0,0,0,,"Siguro nagsinungaling siya tungkol sa kanyang kamatayan."
Dialogue: 0,1:23:44.85,1:23:47.01,Default,,0,0,0,,Ito ay tumawid sa linya...
Dialogue: 0,1:23:48.09,1:23:49.06,Default,,0,0,0,,Ano ang ID?
Dialogue: 0,1:23:49.09,1:23:50.12,Default,,0,0,0,,Screenshot ito.
Dialogue: 0,1:23:50.15,1:23:52.00,Default,,0,0,0,,Gumawa ng PDF file at idemanda sila.
Dialogue: 0,1:23:52.02,1:23:53.42,Default,,0,0,0,,Hindi ako makikipag-ayos o makikipag-ayos.
Dialogue: 0,1:23:53.44,1:23:55.33,Default,,0,0,0,,Anong meron sa mata mo? Tinatakot mo ako.
Dialogue: 0,1:23:55.36,1:23:57.98,Default,,0,0,0,,Magbabayad silang lahat para dito.
Dialogue: 0,1:24:03.49,1:24:06.33,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,1:24:36.65,1:24:38.96,Default,,0,0,0,,{\an8}{\i1}Malapit ko nang mahanap ang secret fund.{\i0}
Dialogue: 0,1:24:38.99,1:24:40.88,Default,,0,0,0,,{\an8}{\i1}Ayan!{\i0}
Dialogue: 0,1:24:40.90,1:24:42.34,Default,,0,0,0,,{\an8}{\i1}Snap out of it.{\i0}
Dialogue: 0,1:24:42.36,1:24:44.88,Default,,0,0,0,,{\an8}{\i1}Mayroon kaming sariling kuwentong mala-pelikula.{\i0}
Dialogue: 0,1:24:44.91,1:24:47.14,Default,,0,0,0,,{\an8}{\i1}How lovey-dovey.{\i0}
Dialogue: 0,1:24:47.16,1:24:49.64,Default,,0,0,0,,{\an8}{\i1}Nasaan ang rebulto?{\i0}
Dialogue: 0,1:24:49.66,1:24:51.10,Default,,0,0,0,,{\an8}{\i1}Da-hye!{\i0}
Dialogue: 0,1:24:51.12,1:24:52.81,Default,,0,0,0,,{\an8}{\i1}Scumbags!{\i0}
Dialogue: 0,1:24:52.83,1:24:54.19,Default,,0,0,0,,{\an8}{\i1}Kailangan kong suriin.{\i0}
Dialogue: 0,1:24:54.21,1:24:56.81,Default,,0,0,0,,{\an8}{\i1}Wala na akong masigurado.{\i0}
Dialogue: 0,1:24:56.84,1:24:59.19,Default,,0,0,0,,{\an8}{\i1}Ako ang unang nagdevelop ng feelings para sayo.{\i0}
Dialogue: 0,1:24:59.21,1:25:01.69,Default,,0,0,0,,{\an8}{\i1}So alam niya kung nasaan ang pera?{\i0}
Dialogue: 0,1:25:01.72,1:25:04.38,Default,,0,0,0,,{\an8}{\i1}Totoo ba ito? Hindi ako nananaginip?{\i0}
