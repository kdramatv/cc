Dialog: 0,1:23:41.97,1:23:43.71,Default,,0,0,0,,Dia menyukaiku?
Dialog: 0,1:23:47.48,1:23:49.01,Default,,0,0,0,,Benarkah?
Dialog: 0,1:23:53.19,1:23:54.72,Default,,0,0,0,,Astaga.
Dialog: 0,1:23:55.44,1:23:58.77,Default,,0,0,0,,Tapi bukan itu yang terjadi pada saya.
Dialog: 0,1:24:00.66,1:24:02.23,Default,,0,0,0,,Saya...
Dialog: 0,1:24:06.29,1:24:08.20,Default,,0,0,0,,cintai dia.
Dialog: 0,1:24:27.39,1:24:29.51,Default,,0,0,0,,Aku cinta kamu, Hae-in.
Dialog: 0,1:25:01.13,1:25:03.97,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:25:34.62,1:25:36.70,Default,,0,0,0,,{\an8}{\i1}Aku akan memberikan apa pun yang kamu inginkan...{\i0}
Dialog: 0,1:25:36.75,1:25:38.87,Default,,0,0,0,,{\an8}{\i1}Aku akan bersamanya.{\i0}
Dialogue: 0,1:25:39.46,1:25:43.07,Default,,0,0,0,,{\an8}{\i1}Aku senang, selama kamu mengeringkan\Nrambutku dengan pengering rambut yang rusak.{\i0}
Dialog: 0,1:25:43.09,1:25:46.42,Default,,0,0,0,,{\an8}{\i1}Tolong ajari saya cara bertinju.{\i0}
Dialog: 0,1:25:46.68,1:25:48.95,Default,,0,0,0,,{\an8}{\i1}- Beri?\N- Bagaimana kalau kita bertemu malam ini?{\i0}
Dialog: 0,1:25:48.97,1:25:49.99,Default,,0,0,0,,{\an8}{\i1}Di malam hari?{\i0}
Dialogue: 0,1:25:50.01,1:25:51.93,Default,,0,0,0,,{\an8}{\i1}Dia mencari dana rahasia ketua.{\i0}
Dialog: 0,1:25:51.95,1:25:53.58,Default,,0,0,0,,{\an8}{\i1}Aku akan mencarinya dulu.{\i0}
Dialog: 0,1:25:53.60,1:25:55.66,Default,,0,0,0,,{\an8}{\i1}Singkirkan...{\i0}
Dialog: 0,1:25:55.69,1:25:56.79,Default,,0,0,0,,{\an8}{\i1}dari Baek Hyun-woo.{\i0}
Dialog: 0,1:25:56.81,1:25:58.54,Default,,0,0,0,,{\an8}{\i1}Aku belum bisa mati.{\i0}
Dialog: 0,1:25:58.57,1:26:00.92,Default,,0,0,0,,{\an8}{\i1}Aku belum memberitahumu.{\i0}
Dialog: 0,1:26:00.94,1:26:02.77,Default,,0,0,0,,{\an8}{\i1}Aku cinta kamu.{\i0}
