Dialog: 0,1:16:09.60,1:16:11.30,Default,,0,0,0,,{\an8}{\i1}Hati-hati!{\i0}
Dialogue: 0,1:16:11.35,1:16:13.29,Default,,0,0,0,,{\an8}{\i1}Aku sesekali memikirkan Hae-in,{\i0}
Dialog: 0,1:16:13.31,1:16:16.29,Default,,0,0,0,,{\an8}{\i1}jadi rasanya aneh bertemu suaminya.{\i0}
