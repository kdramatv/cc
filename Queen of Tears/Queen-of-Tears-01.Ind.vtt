Dialog: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skenario: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sutradara: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.52,0:01:04.39,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 1{\c}{\i0}
Dialogue: 0,0:01:26.96,0:01:30.64,Default,,0,0,0,,{\i1}Semua orang bilang ini pernikahan abad ini.{\i0}
Dialog: 0,0:01:30.67,0:01:32.94,Default,,0,0,0,,{\i1}Pewaris konglomerat\Npaling kuat di Korea...{\i0}
Dialog: 0,0:01:32.96,0:01:35.25,Default,,0,0,0,,{\i1}menikah dengan rekrutan baru.{\i0}
Dialogue: 0,0:01:42.85,0:01:45.05,Default,,0,0,0,,{\an8}{\i1}Sudah tiga tahun,{\i0}
Dialog: 0,0:01:45.77,0:01:48.18,Default,,0,0,0,,{\an8}tapi sepertinya baru kemarin.
Dialogue: 0,0:01:48.73,0:01:52.42,Default,,0,0,0,,{\an8}Orang-orang bertanya padaku bagaimana rasanya menjadi bagian...
Dialog: 0,0:01:52.44,0:01:54.09,Default,,0,0,0,,{\an8}dari konglomerat,
Dialog: 0,0:01:54.11,0:01:56.44,Default,,0,0,0,,{\an8}dan tinggal bersama seorang ratu.
Dialog: 0,0:01:57.03,0:01:58.63,Default,,0,0,0,,{\an8}Saya tidak yakin.
Dialogue: 0,0:01:58.66,0:02:00.26,Default,,0,0,0,,{\an8}Apakah kamu percaya jika aku mengatakan ini?
Dialogue: 0,0:02:00.28,0:02:02.11,Default,,0,0,0,,{\an8}Aku hanya...
Dialog: 0,0:02:02.20,0:02:03.84,Default,,0,0,0,,{\an8}orang yang beruntung...
Dialogue: 0,0:02:03.87,0:02:05.64,Default,,0,0,0,,{\an8}yang menikah...
Dialog: 0,0:02:05.66,0:02:08.32,Default,,0,0,0,,{\an8}cinta dalam hidupku.
Dialogue: 0,0:02:08.62,0:02:11.31,Default,,0,0,0,,Saya tahu orang-orang bergosip tentang...
Dialog: 0,0:02:11.33,0:02:12.73,Default,,0,0,0,,bagaimana Baek Hyun-woo menikahiku...
Dialog: 0,0:02:12.75,0:02:14.48,Default,,0,0,0,,semata-mata karena keluargaku...
Dialog: 0,0:02:14.50,0:02:17.75,Default,,0,0,0,,dan kekayaan kita.
Dialogue: 0,0:02:23.01,0:02:25.80,Default,,0,0,0,,Rumor itu dimulai karena\NI memilih untuk tidak memperlihatkan wajahku...
Dialog: 0,0:02:25.82,0:02:27.81,Default,,0,0,0,,karena berbagai alasan.
Dialogue: 0,0:02:28.14,0:02:31.33,Default,,0,0,0,,Saya kira ini akan mengakhiri rumor tersebut,
Dialog: 0,0:02:31.35,0:02:35.14,Default,,0,0,0,,karena akhirnya aku memperlihatkan wajahku.
Dialog: 0,0:02:43.83,0:02:44.89,Default,,0,0,0,,{\i1}Kehidupan pernikahan kami...{\i0}
Dialog: 0,0:02:44.91,0:02:48.03,Default,,0,0,0,,tidak ada yang luar biasa.
Dialogue: 0,0:02:51.92,0:02:54.87,Default,,0,0,0,,{\i1}Aku terbangun di sampingnya.{\i0}
Dialogue: 0,0:02:56.00,0:02:57.83,Default,,0,0,0,,{\i1}Kita sarapan bersama.{\i0}
Dialogue: 0,0:02:58.34,0:03:01.33,Default,,0,0,0,,{\i1}Kami juga akan bekerja sama.{\i0}
Dialogue: 0,0:03:03.89,0:03:05.53,Default,,0,0,0,,{\i1}Bagaimana rasanya...{\i0}
Dialog: 0,0:03:05.56,0:03:08.05,Default,,0,0,0,,{\i1}bersama sepanjang siang dan malam?{\i0}
Dialogue: 0,0:03:12.98,0:03:14.54,Default,,0,0,0,,Itu membuatku bahagia.
Dialogue: 0,0:03:14.56,0:03:16.81,Default,,0,0,0,,Saya yakin sebagian dari kalian sudah mengetahuinya.
Dialogue: 0,0:03:16.86,0:03:19.21,Default,,0,0,0,,Setelah kembali dari\Nstudiku di luar negeri lima tahun yang lalu,
Dialogue: 0,0:03:19.23,0:03:22.19,Default,,0,0,0,,{\i1}Saya bergabung dengan Queens Department Store,\Nyang dimiliki ayah saya saat itu,{\i0}
Dialog: 0,0:03:22.21,0:03:23.88,Default,,0,0,0,,{\i1}sebagai pekerja magang.{\i0}
Dialogue: 0,0:03:23.91,0:03:26.94,Default,,0,0,0,,{\i1}Bisa dibilang saya bekerja secara sembunyi-sembunyi.{\i0}
Dialogue: 0,0:03:42.59,0:03:44.65,Default,,0,0,0,,{\i1}Wanita mengetahui hal-hal ini.{\i0}
Dialog: 0,0:03:44.68,0:03:46.38,Default,,0,0,0,,"Saya mengerti."
Dialog: 0,0:03:47.72,0:03:49.87,Default,,0,0,0,,"Orang ini menyukaiku."
Dialogue: 0,0:03:49.89,0:03:52.30,Default,,0,0,0,,"Itulah sebabnya dia menggodaku."
Dialog: 0,0:03:52.44,0:03:53.50,Default,,0,0,0,,{\i1}Tidak.{\i0}
Dialog: 0,0:03:53.52,0:03:55.43,Default,,0,0,0,,Bukan itu masalahnya.
Dialog: 0,0:03:56.27,0:03:59.22,Default,,0,0,0,,Dia terus menendang mesin fotokopi.
Dialogue: 0,0:04:04.07,0:04:05.76,Default,,0,0,0,,- {\i1}Jadi aku khawatir.{\i0}\N- Ada apa?
Dialog: 0,0:04:05.78,0:04:07.52,Default,,0,0,0,,{\i1}Tentang mesin fotokopi.{\i0}
Dialog: 0,0:04:08.37,0:04:10.40,Default,,0,0,0,,Ada apa?
Dialogue: 0,0:04:12.08,0:04:14.66,Default,,0,0,0,,{\i1}Tetapi setelah membantunya beberapa kali,{\i0}
Dialogue: 0,0:04:14.71,0:04:16.87,Default,,0,0,0,,{\i1}Aku mulai mengkhawatirkannya.{\i0}
Dialog: 0,0:04:18.21,0:04:19.73,Default,,0,0,0,,Saat mengirim faks...
Dialogue: 0,0:04:19.75,0:04:23.19,Default,,0,0,0,,{\i1}Saat itu, orang\Ngosip tentang betapa menjengkelkannya...{\i0}
Dialogue: 0,0:04:23.22,0:04:25.44,Default,,0,0,0,,{\i1}magang baru tadi,{\i0}
Dialog: 0,0:04:25.47,0:04:28.00,Default,,0,0,0,,{\i1}jadi aku yakin dia akan segera dipecat.{\i0}
Dialog: 0,0:04:34.64,0:04:36.75,Default,,0,0,0,,Anda harus berhenti, Ms. Hong.
Dialogue: 0,0:04:36.77,0:04:38.62,Default,,0,0,0,,Aku sudah melakukan banyak pekerjaan paruh waktu.
Dialogue: 0,0:04:38.65,0:04:41.14,Default,,0,0,0,,Kau akan dipecat.
Dialog: 0,0:04:41.23,0:04:42.75,Default,,0,0,0,,Saya tidak peduli.
Dialog: 0,0:04:42.78,0:04:44.88,Default,,0,0,0,,Benar. Anda hanya akan mencari pekerjaan lain,
Dialog: 0,0:04:44.90,0:04:46.13,Default,,0,0,0,,tapi...
Dialogue: 0,0:04:46.16,0:04:49.30,Default,,0,0,0,,kamu juga akan dipecat di sana.\NDApakah kamu ingin bertaruh?
Dialogue: 0,0:04:49.33,0:04:51.03,Default,,0,0,0,,Tahu tidak?
Dialogue: 0,0:04:51.29,0:04:54.78,Default,,0,0,0,,Jantungku berdegup kencang setiap kali\Natasanmu menegurmu.
Dialogue: 0,0:04:54.91,0:04:57.66,Default,,0,0,0,,Kamu dimarahi setiap hari.
Dialogue: 0,0:05:03.67,0:05:05.37,Default,,0,0,0,,Kenapa melompat?
Dialog: 0,0:05:14.39,0:05:16.41,Default,,0,0,0,,- Apa?\N- Kenapa jantungmu berdebar kencang,
Dialogue: 0,0:05:16.44,0:05:18.50,Default,,0,0,0,,kapan aku yang dimarahi?
Dialog: 0,0:05:18.52,0:05:20.14,Default,,0,0,0,,Mengapa?
Dialogue: 0,0:05:25.74,0:05:27.92,Default,,0,0,0,,Luangkan waktumu,
Dialog: 0,0:05:27.95,0:05:29.73,Default,,0,0,0,,dan pikirkan itu.
Dialog: 0,0:05:49.22,0:05:50.92,Default,,0,0,0,,Kamu bisa datang sekarang juga.
Dialogue: 0,0:05:53.64,0:05:55.51,Default,,0,0,0,,Apakah kamu tidak punya payung?
Dialog: 0,0:05:56.68,0:05:59.55,Default,,0,0,0,,Tidak, saya tidak melakukannya, tapi...
Dialog: 0,0:06:00.31,0:06:02.01,Default,,0,0,0,,Ambil punyaku.
Dialog: 0,0:06:04.86,0:06:08.23,Default,,0,0,0,,Kamu selalu membutuhkan bantuan, dan...
Dialogue: 0,0:06:09.91,0:06:11.61,Default,,0,0,0,,itu menggangguku.
Dialog: 0,0:06:12.03,0:06:13.73,Default,,0,0,0,,Apa ini?
Dialogue: 0,0:06:13.99,0:06:17.53,Default,,0,0,0,,Aku membuat jantungmu berdebar kencang, dan sekarang aku mengganggumu?
Dialog: 0,0:06:26.30,0:06:28.08,Default,,0,0,0,,Ms. Hong.
Dialog: 0,0:06:28.47,0:06:30.46,Default,,0,0,0,,Dengarkan baik-baik.
Dialog: 0,0:06:31.22,0:06:35.42,Default,,0,0,0,,Aku tidak memberitahumu ini karena takut\Nmembuatmu merasa tidak nyaman,
Dialog: 0,0:06:35.81,0:06:37.51,Default,,0,0,0,,tapi tahukah Anda,
Dialog: 0,0:06:38.31,0:06:40.50,Default,,0,0,0,,Saya kuliah di Universitas Nasional Seoul,
Dialog: 0,0:06:40.52,0:06:42.89,Default,,0,0,0,,dan sekolah hukum pada saat itu.
Dialogue: 0,0:06:43.69,0:06:46.50,Default,,0,0,0,,Orang tuaku tinggal di selatan,
Dialog: 0,0:06:46.53,0:06:48.92,Default,,0,0,0,,tetapi komunitas menghormati keluarga kami.
Dialogue: 0,0:06:48.95,0:06:52.05,Default,,0,0,0,,Misalnya, kami memiliki lebih dari 30 ekor sapi.
Dialog: 0,0:06:52.07,0:06:54.72,Default,,0,0,0,,Anak sapi lain lahir beberapa hari yang lalu,
Dialog: 0,0:06:54.74,0:06:57.39,Default,,0,0,0,,jadi kita punya hampir 35 sekarang.
Dialogue: 0,0:06:57.41,0:06:58.72,Default,,0,0,0,,Untuk apartemen studioku,
Dialog: 0,0:06:58.75,0:07:00.52,Default,,0,0,0,,Saya menandatangani kontrak sewa dua tahun...
Dialog: 0,0:07:00.54,0:07:02.48,Default,,0,0,0,,daripada membayar sewa bulanan.
Dialogue: 0,0:07:02.50,0:07:05.66,Default,,0,0,0,,Itu artinya aku punya banyak\Nuang tambahan.
Dialog: 0,0:07:05.88,0:07:07.83,Default,,0,0,0,,Apa maksudmu?
Dialog: 0,0:07:08.67,0:07:10.37,Default,,0,0,0,,Bahkan jika...
Dialog: 0,0:07:10.47,0:07:13.13,Default,,0,0,0,,kamu dipecat dan tidak dapat menemukan pekerjaan baru,
Dialogue: 0,0:07:13.59,0:07:15.49,Default,,0,0,0,,Aku bisa menjagamu.
Dialog: 0,0:07:15.51,0:07:17.21,Default,,0,0,0,,Itulah yang saya maksud.
Dialogue: 0,0:07:18.35,0:07:21.50,Default,,0,0,0,,Jujur saja. Aku selalu\Ningin calon istriku bekerja,
Dialog: 0,0:07:21.52,0:07:23.35,Default,,0,0,0,,tapi jika itu kamu,
Dialogue: 0,0:07:23.69,0:07:26.14,Default,,0,0,0,,Saya bisa mencoba menjadi satu-satunya pencari nafkah.
Dialog: 0,0:07:27.78,0:07:30.60,Default,,0,0,0,,Maksudku, jangan merasa tertekan.
Dialog: 0,0:07:31.24,0:07:32.94,Default,,0,0,0,,Hanya saja...
Dialog: 0,0:07:34.03,0:07:35.73,Default,,0,0,0,,Aku menyukaimu.
Dialog: 0,0:07:38.33,0:07:40.03,Default,,0,0,0,,Jadi...
Dialogue: 0,0:07:43.08,0:07:44.78,Default,,0,0,0,,bagaimana menurutmu?
Dialog: 0,0:07:56.26,0:07:59.01,Default,,0,0,0,,Kamu tidak perlu menjawabku hari ini.
Dialogue: 0,0:08:01.60,0:08:03.43,Default,,0,0,0,,Jangan sampai basah.
Dialog: 0,0:08:06.77,0:08:08.93,Default,,0,0,0,,- Saya...\N- Saya baik-baik saja.
Dialog: 0,0:08:09.11,0:08:10.17,Default,,0,0,0,,Ambillah.
Dialog: 0,0:08:10.19,0:08:12.13,Default,,0,0,0,,- Pak Baek...\N- Saya baik-baik saja.
Dialogue: 0,0:08:12.15,0:08:14.31,Default,,0,0,0,,Tapi aku...
Dialog: 0,0:08:23.66,0:08:25.37,Default,,0,0,0,,Saya punya...
Dialog: 0,0:08:25.79,0:08:27.53,Default,,0,0,0,,driver.
Dialog: 0,0:08:53.44,0:08:55.52,Default,,0,0,0,,{\i1}Lucu bukan?{\i0}
Dialog: 0,0:09:01.29,0:09:03.10,Default,,0,0,0,,Memang benar.
Dialog: 0,0:09:03.12,0:09:04.31,Default,,0,0,0,,Pokoknya,
Dialogue: 0,0:09:04.33,0:09:07.49,Default,,0,0,0,,dia menjadi romantis sejak saat itu.
Dialog: 0,0:09:08.25,0:09:10.65,Default,,0,0,0,,Begitulah kisah cinta kami dimulai,
Dialogue: 0,0:09:10.67,0:09:13.61,Default,,0,0,0,,tapi dia terkejut setelah\N mengetahui siapa keluargaku.
Dialog: 0,0:09:13.63,0:09:15.32,Default,,0,0,0,,Dia menyerahkan surat pengunduran dirinya...
Dialog: 0,0:09:15.34,0:09:17.79,Default,,0,0,0,,{\i1}dan membuatku takut,{\i0}
Dialog: 0,0:09:18.05,0:09:19.75,Default,,0,0,0,,{\i1}jadi...{\i0}
Dialog: 0,0:09:23.06,0:09:25.18,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo, keluar.{\c}{\i0}
Dialog: 0,0:10:18.15,0:10:20.77,Default,,0,0,0,,Apakah kamu akan membiarkanku berdiri di sini?
Dialog: 0,0:10:43.51,0:10:47.13,Default,,0,0,0,,Dia tampak seperti malaikat yang diutus dari surga.
Dialogue: 0,0:10:50.23,0:10:53.47,Default,,0,0,0,,- Seperti itulah penampilannya saat itu.\N- Tapi sekarang tidak lagi?
Dialogue: 0,0:10:54.57,0:10:57.67,Default,,0,0,0,,Tentu saja, dia tetaplah bidadari.
Dialog: 0,0:10:57.69,0:10:59.84,Default,,0,0,0,,Sudah kubilang berkali-kali...
Dialog: 0,0:10:59.86,0:11:01.01,Default,,0,0,0,,itu...
Dialog: 0,0:11:01.03,0:11:02.13,Default,,0,0,0,,Saya senang.
Dialog: 0,0:11:02.16,0:11:03.47,Default,,0,0,0,,Yah...
Dialog: 0,0:11:03.49,0:11:05.30,Default,,0,0,0,,Dia dan aku...
Dialog: 0,0:11:05.33,0:11:08.45,Default,,0,0,0,,semoga hidup pernikahan bahagia.
Dialogue: 0,0:11:08.54,0:11:11.74,Default,,0,0,0,,Kami masih saling mencintai.
Dialog: 0,0:11:14.79,0:11:17.11,Default,,0,0,0,,{\i1}Baek Hyun-woo akan bercerai.{\i0}
Dialog: 0,0:11:17.13,0:11:18.23,Default,,0,0,0,,Serius?
Dialog: 0,0:11:18.26,0:11:20.86,Default,,0,0,0,,- Itu rahasia.\N- Tentu saja. Bagaimanapun juga, kita adalah rekan kerja.
Dialog: 0,0:11:20.88,0:11:24.11,Default,,0,0,0,,Bagaimanapun, dia ingin salah satu dari kita mewakilinya.
Dialog: 0,0:11:24.14,0:11:25.95,Default,,0,0,0,,Ya, tentu saja.
Dialogue: 0,0:11:25.97,0:11:28.33,Default,,0,0,0,,Kamu adalah pengacara perceraian #1 di negeri ini.
Dialog: 0,0:11:28.35,0:11:29.53,Default,,0,0,0,,Kamu harus melakukannya, Yang-gi.
Dialog: 0,0:11:29.56,0:11:30.74,Default,,0,0,0,,Saya akan...
Dialog: 0,0:11:30.77,0:11:32.50,Default,,0,0,0,,senang membantunya. Sungguh,
Dialogue: 0,0:11:32.52,0:11:34.83,Default,,0,0,0,,tapi saya sudah menangani begitu banyak kasus.
Dialog: 0,0:11:34.86,0:11:36.29,Default,,0,0,0,,Baiklah kalau begitu.
Dialog: 0,0:11:36.32,0:11:40.10,Default,,0,0,0,,Pengacara Choi Cheol-seung menawarkan tingkat kemenangan 90%.
Dialog: 0,0:11:42.36,0:11:43.38,Default,,0,0,0,,Bisakah kamu membantunya?
Dialogue: 0,0:11:43.41,0:11:45.13,Default,,0,0,0,,Aku diam-diam akan membantumu.
Dialog: 0,0:11:45.16,0:11:47.55,Default,,0,0,0,,Kenapa diam-diam? Lakukan secara terbuka.
Dialogue: 0,0:11:47.58,0:11:49.32,Default,,0,0,0,,Takut mendapat sisi buruk dari Queens...
Dialogue: 0,0:11:49.34,0:11:52.42,Default,,0,0,0,,dan kehilangan pekerjaan, dasar bajingan licik?
Dialog: 0,0:11:52.96,0:11:54.39,Default,,0,0,0,,Benar.
Dialog: 0,0:11:54.42,0:11:56.14,Default,,0,0,0,,Kamu benar. Itu sebabnya.
Dialogue: 0,0:11:56.17,0:11:57.69,Default,,0,0,0,,Aku gila sekali menerima pekerjaan itu.
Dialogue: 0,0:11:57.71,0:12:00.07,Default,,0,0,0,,Bibi mertua Hyun-woo bercerai tiga kali.
Dialogue: 0,0:12:00.09,0:12:03.03,Default,,0,0,0,,Kalian semua tahu nasib\Npengacara mantan suaminya.
Dialogue: 0,0:12:03.05,0:12:04.69,Default,,0,0,0,,Mereka semua dipecat.
Dialogue: 0,0:12:04.72,0:12:08.28,Default,,0,0,0,,Hyun-woo melakukan kesalahan. Kenapa\Ndia memasukkan kita ke dalam masalah seperti ini?
Dialogue: 0,0:12:08.31,0:12:10.37,Default,,0,0,0,,- Tepat sekali.\N- Jujur saja.
Dialogue: 0,0:12:10.39,0:12:13.58,Default,,0,0,0,,Dia yang terpintar di antara kami.\NSelalu menjadi yang teratas di kelas kami,
Dialog: 0,0:12:13.60,0:12:14.73,Default,,0,0,0,,jadi kenapa dia tidak bisa...
Dialog: 0,0:12:14.76,0:12:16.28,Default,,0,0,0,,- pengacara perceraiannya sendiri?\N- Benar.
Dialog: 0,0:12:16.30,0:12:18.25,Default,,0,0,0,,- Itu akan lebih baik.\N- Aku yakin dia akan unggul.
Dialog: 0,0:12:18.27,0:12:20.38,Default,,0,0,0,,Ngomong-ngomong, kenapa dia ingin bercerai?
Dialog: 0,0:12:20.40,0:12:25.34,Default,,0,0,0,,Tepat. Dia menjalani\Nkehidupan impian semua pria Korea.
Dialogue: 0,0:12:25.36,0:12:27.97,Default,,0,0,0,,Istrinya adalah Hong Hae-in,\Npewaris Queens Group,
Dialog: 0,0:12:27.99,0:12:29.99,Default,,0,0,0,,jadi kenapa?
Dialogue: 0,0:12:32.37,0:12:34.03,Default,,0,0,0,,Dia gila.
Dialogue: 0,0:12:34.33,0:12:36.03,Default,,0,0,0,,Orang gila?
Dialog: 0,0:12:45.18,0:12:47.45,Default,,0,0,0,,Benar. Tentang obrolan grup Satu Miliar Klub itu...
Dialog: 0,0:12:47.47,0:12:49.78,Default,,0,0,0,,Ya. Mengapa mereka belum mengundangku?
Dialogue: 0,0:12:49.81,0:12:52.83,Default,,0,0,0,,Penjualan kita hanya $880 juta, jadi...
Dialog: 0,0:12:52.85,0:12:54.24,Default,,0,0,0,,Itu bukan kesenjangan yang besar.
Dialogue: 0,0:12:54.27,0:12:56.46,Default,,0,0,0,,- Kita hanya kekurangan $100 juta.\N- Saya tahu.
Dialog: 0,0:12:56.48,0:12:58.62,Default,,0,0,0,,Saya minta mereka mengumpulkannya saja,
Dialog: 0,0:12:58.65,0:13:01.25,Default,,0,0,0,,dan lebih fleksibel,
Dialog: 0,0:13:01.28,0:13:02.59,Default,,0,0,0,,tapi masih sulit tidak.
Dialogue: 0,0:13:02.61,0:13:04.00,Default,,0,0,0,,Kenapa mereka cerewet sekali?
Dialogue: 0,0:13:04.03,0:13:05.17,Default,,0,0,0,,Ngomong-ngomong, aku dengar...
Dialogue: 0,0:13:05.20,0:13:07.89,Default,,0,0,0,,Royal Department Store\Nmembual tentang bagaimana CEO mereka...
Dialogue: 0,0:13:07.92,0:13:10.93,Default,,0,0,0,,akan bergabung dengan One Billion\NClub pada akhir tahun.
Dialogue: 0,0:13:10.95,0:13:13.56,Default,,0,0,0,,Mereka juga membual bahwa\Nmereka akan menyiapkan Hercyna...
Dialog: 0,0:13:13.58,0:13:15.40,Default,,0,0,0,,di lantai pertama sebelah air mancur.
Dialog: 0,0:13:15.42,0:13:16.48,Default,,0,0,0,,Mereka pasti gila.
Dialogue: 0,0:13:16.50,0:13:18.54,Default,,0,0,0,,Ceritakan padaku. Department store di Korea...
Dialogue: 0,0:13:18.57,0:13:21.56,Default,,0,0,0,,dibagi menjadi yang punya\NHercyna dan yang tidak,
Dialog: 0,0:13:21.59,0:13:25.17,Default,,0,0,0,,dan Hercyna hanya ingin bekerja\Ndengan mereka yang ada di klub itu.
Dialog: 0,0:13:27.43,0:13:28.70,Default,,0,0,0,,Sudah waktunya...
Dialog: 0,0:13:28.72,0:13:31.07,Default,,0,0,0,,kami memotong semua merek...
Dialog: 0,0:13:31.10,0:13:34.42,Default,,0,0,0,,yang menghambat penjualan kami.
Dialog: 0,0:13:35.39,0:13:37.35,Default,,0,0,0,,Ini adalah bagan evaluasi berkala kami.
Dialog: 0,0:13:37.38,0:13:38.37,Default,,0,0,0,,Di bagian bawah,
Dialog: 0,0:13:38.40,0:13:41.63,Default,,0,0,0,,kami memiliki daftar merek di\N20% penjualan terbawah.
Dialogue: 0,0:13:41.65,0:13:43.34,Default,,0,0,0,,Berapa banyak yang bisa kita matikan?
Dialogue: 0,0:13:43.36,0:13:46.67,Default,,0,0,0,,Yang bergaris bawah merah\Nberada di 20% terbawah...
Dialog: 0,0:13:46.70,0:13:47.80,Default,,0,0,0,,setidaknya dua kali.
Dialogue: 0,0:13:47.82,0:13:51.19,Default,,0,0,0,,Pada prinsipnya, mereka harus\Ndimatikan. Namun...
Dialog: 0,0:13:53.66,0:13:55.49,Default,,0,0,0,,"Namun"?
Dialogue: 0,0:13:56.21,0:13:58.41,Default,,0,0,0,,Kenapa ada "namun"?
Dialogue: 0,0:14:00.08,0:14:02.48,Default,,0,0,0,,Kita harus mematikannya jika bisa.
Dialog: 0,0:14:02.50,0:14:05.32,Default,,0,0,0,,Kami memang meminta saran dari tim hukum kami,
Dialog: 0,0:14:05.34,0:14:06.96,Default,,0,0,0,,dan mereka bilang tidak.
Dialogue: 0,0:14:11.30,0:14:13.00,Default,,0,0,0,,Siapa bilang begitu?
Dialog: 0,0:14:13.06,0:14:15.09,Default,,0,0,0,,Sutradara Baek Hyun-woo.
Dialog: 0,0:14:21.77,0:14:24.63,Default,,0,0,0,,Tn. Yu, tolong selesaikan\Nkontraknya setelah mengonfirmasi...
Dialog: 0,0:14:24.65,0:14:25.71,Default,,0,0,0,,biaya komisi.
Dialog: 0,0:14:25.73,0:14:27.09,Default,,0,0,0,,Ya pak. Juga...
Dialog: 0,0:14:27.11,0:14:29.59,Default,,0,0,0,,Manajer lantai dua menyerahkan laporan.
Dialog: 0,0:14:29.61,0:14:32.13,Default,,0,0,0,,Salah satu pelanggan kami jatuh dan melukai dirinya sendiri...
Dialog: 0,0:14:32.16,0:14:34.57,Default,,0,0,0,,sambil berjalan dengan sepatu hak 5 inci.
Dialog: 0,0:14:34.79,0:14:37.28,Default,,0,0,0,,Pak, CEO ingin bertemu dengan Anda.
Dialog: 0,0:14:38.12,0:14:39.52,Default,,0,0,0,,Saya sedang rapat.
Dialog: 0,0:14:39.54,0:14:41.02,Default,,0,0,0,,Yah...
Dialogue: 0,0:14:41.04,0:14:44.49,Default,,0,0,0,,Dia ingin bertemu denganmu\Segera. Dia sangat kesal.
Dialog: 0,0:15:15.99,0:15:17.69,Default,,0,0,0,,Tn. Baek.
Dialogue: 0,0:15:18.00,0:15:21.78,Default,,0,0,0,,Mengapa kita tidak bisa menutup\Nmerek yang tidak menguntungkan?
Dialogue: 0,0:15:22.54,0:15:26.23,Default,,0,0,0,,Banyak merek yang berinvestasi\N$500.000 pada peralatan.
Dialogue: 0,0:15:26.25,0:15:28.32,Default,,0,0,0,,Kita tidak bisa mengusir mereka begitu saja.
Dialog: 0,0:15:28.34,0:15:29.57,Default,,0,0,0,,Ajukan gugatan penggusuran, lalu.
Dialogue: 0,0:15:29.59,0:15:31.15,Default,,0,0,0,,Mustahil menang.
Dialog: 0,0:15:31.18,0:15:34.15,Default,,0,0,0,,Undang-undang telah direvisi berkali-kali untuk mencegah distributor besar...
Dialog: 0,0:15:34.18,0:15:36.21,Default,,0,0,0,,dari menyalahgunakan kekuasaan mereka.
Dialog: 0,0:15:36.72,0:15:39.34,Default,,0,0,0,,Apakah maksudmu...
Dialogue: 0,0:15:40.31,0:15:42.59,Default,,0,0,0,,Saya sedang dalam perjalanan listrik?
Dialogue: 0,0:15:42.65,0:15:44.26,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:15:44.52,0:15:47.00,Default,,0,0,0,,- Bukan itu yang saya...\N- Apakah ini organisasi nirlaba?
Dialogue: 0,0:15:47.02,0:15:48.54,Default,,0,0,0,,Apakah kita sukarelawan?
Dialogue: 0,0:15:48.57,0:15:51.17,Default,,0,0,0,,Apakah benar membiarkannya,\Nsaat kita tidak mendapatkan...
Dialogue: 0,0:15:51.20,0:15:54.44,Default,,0,0,0,,nilai uang kita untuk tempat mahal itu?
Dialog: 0,0:15:55.91,0:15:58.14,Default,,0,0,0,,Divisi penjualan sengaja mengecualikan...
Dialog: 0,0:15:58.16,0:15:59.77,Default,,0,0,0,,merek dengan skor kinerja rendah...
Dialog: 0,0:15:59.79,0:16:02.97,Default,,0,0,0,,dari acara undangan pelanggan dan\Ndiskon untuk menghambat penjualan tambahan.
Dialogue: 0,0:16:02.99,0:16:07.35,Default,,0,0,0,,Merek-merek tersebut dapat mengadu\Nkepada media atau menuntut kami.
Dialogue: 0,0:16:07.38,0:16:08.73,Default,,0,0,0,,Maka kita akan benar-benar mendapat masalah.
Dialog: 0,0:16:08.75,0:16:11.65,Default,,0,0,0,,Saya yakin solusi\N yang lebih baik adalah membantu...
Dialog: 0,0:16:11.67,0:16:13.38,Default,,0,0,0,,meningkatkan penjualan mereka.
Dialog: 0,0:16:16.18,0:16:17.24,Default,,0,0,0,,Tn. Baek.
Dialog: 0,0:16:17.26,0:16:19.92,Default,,0,0,0,,Apakah saya meminta saran Anda?
Dialogue: 0,0:16:21.48,0:16:24.18,Default,,0,0,0,,Aku bilang padamu untuk mematikannya.
Dialog: 0,0:16:24.98,0:16:28.08,Default,,0,0,0,,Jika mereka tidak mendengarkan, ajukan gugatan dan menangkan.
Dialogue: 0,0:16:28.11,0:16:31.18,Default,,0,0,0,,Saya yakin itulah tugas tim Anda.
Dialog: 0,0:16:38.99,0:16:40.05,Default,,0,0,0,,Ya, Bu.
Dialogue: 0,0:16:40.08,0:16:42.11,Default,,0,0,0,,Rapat ini selesai.
Dialogue: 0,0:17:05.19,0:17:07.83,Default,,0,0,0,,Apakah kamu ingin membiarkan orang lain\Ntahu bahwa kita tidak akur?
Dialog: 0,0:17:07.86,0:17:09.87,Default,,0,0,0,,Hubungan kita tidak ada hubungannya dengan ini.
Dialog: 0,0:17:09.90,0:17:11.42,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:17:11.44,0:17:15.59,Default,,0,0,0,,Itukah sebabnya Anda memperingatkan\Nmanajer toko bahwa saya ingin memecat...
Dialog: 0,0:17:15.61,0:17:18.88,Default,,0,0,0,,tentang pelanggaran sebelumnya\Nuntuk membantunya tetap bertahan?
Dialog: 0,0:17:18.91,0:17:21.68,Default,,0,0,0,,Manajer itu telah\Nbersama kita sejak awal,
Dialog: 0,0:17:21.70,0:17:23.39,Default,,0,0,0,,dan dia masih pekerja keras.
Dialog: 0,0:17:23.41,0:17:28.78,Default,,0,0,0,,Baik. Kamu sangat baik dan perhatian pada orang lain.
Dialog: 0,0:17:28.83,0:17:31.27,Default,,0,0,0,,Apakah kamu ingin menjadi pahlawan atau apalah?
Dialogue: 0,0:17:31.30,0:17:34.82,Default,,0,0,0,,Berhenti berperan sebagai martir dan\Nperlakukan orang-orang terdekatmu dengan lebih baik.
Dialogue: 0,0:17:34.84,0:17:36.58,Default,,0,0,0,,Mereka yang dekat denganku?
Dialogue: 0,0:17:37.97,0:17:39.67,Default,,0,0,0,,Seperti dirimu?
Dialog: 0,0:17:40.68,0:17:41.74,Default,,0,0,0,,Apa?
Dialog: 0,0:17:41.76,0:17:43.47,Default,,0,0,0,,Apakah kamu benar-benar berpikir...
Dialogue: 0,0:17:43.60,0:17:45.30,Default,,0,0,0,,kita sudah dekat?
Dialogue: 0,0:17:48.48,0:17:50.60,Default,,0,0,0,,Aku perlu bicara denganmu.
Dialog: 0,0:17:50.98,0:17:52.75,Default,,0,0,0,,Datanglah ke ruang tunggu satu jam lagi.
Dialog: 0,0:17:52.78,0:17:54.48,Default,,0,0,0,,Baik.
Dialog: 0,0:18:42.24,0:18:44.16,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,0:18:56.09,0:18:57.52,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apakah Anda sedang dalam perjalanan? aku di sini.{\c}{\i0}
Dialog: 0,0:18:57.55,0:18:59.49,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Di mana kamu? Lupakan. aku berangkat.{\c}{\i0}
Dialog: 0,0:18:59.51,0:19:01.21,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Datanglah ke ruang keluarga.{\c}{\i0}
Dialog: 0,0:19:04.76,0:19:06.01,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialogue: 0,0:19:19.15,0:19:20.90,Default,,0,0,0,,Kenapa lama sekali?
Dialog: 0,0:19:21.70,0:19:22.80,Default,,0,0,0,,Aku terlambat mengiriminya pesan.
Dialog: 0,0:19:22.82,0:19:24.13,Default,,0,0,0,,Kamu tidak perlu mengingatkan dia.
Dialog: 0,0:19:24.16,0:19:26.73,Default,,0,0,0,,Dia tahu kita ada pertemuan keluarga.
Dialogue: 0,0:19:27.33,0:19:29.03,Default,,0,0,0,,maafkan aku.
Dialog: 0,0:19:29.25,0:19:30.60,Default,,0,0,0,,Wawancara macam apa itu?
Dialog: 0,0:19:30.62,0:19:33.39,Default,,0,0,0,,Itu adalah bagian budaya\Nof "Harian Ekonomi Hanyang."
Dialog: 0,0:19:33.42,0:19:36.23,Default,,0,0,0,,Ini adalah wawancara yang mengharukan\Ndi mana para CEO dan politisi...
Dialogue: 0,0:19:36.25,0:19:37.94,Default,,0,0,0,,tunjukkan rumah dan keluarganya.
Dialog: 0,0:19:37.96,0:19:39.69,Default,,0,0,0,,Mereka berdua diwawancarai.
Dialog: 0,0:19:39.72,0:19:42.86,Default,,0,0,0,,Mengapa menunjukkan rumahnya? Mereka bukan selebriti.
Dialogue: 0,0:19:42.89,0:19:46.32,Default,,0,0,0,,Kami harus melakukan sesuatu terhadap tabloid.
Dialog: 0,0:19:46.35,0:19:49.17,Default,,0,0,0,,Saya setuju. Orang-orang bergosip tentang\Nbagaimana mereka berpisah tahun lalu.
Dialogue: 0,0:19:49.20,0:19:52.00,Default,,0,0,0,,Itu semua karena mereka melihatmu berdebat di tempat kerja.
Dialog: 0,0:19:52.02,0:19:54.04,Default,,0,0,0,,- Anda berdebat?\N- Ya, hari ini.
Dialogue: 0,0:19:54.06,0:19:55.29,Default,,0,0,0,,Itu bukan argumen yang sederhana.
Dialog: 0,0:19:55.31,0:19:58.52,Default,,0,0,0,,Cukup tidak nyaman\Nbagi yang ada di ruang rapat.
Dialog: 0,0:20:03.41,0:20:06.22,Default,,0,0,0,,Benar, Hyun-woo. Tentang\NKomisi Perdagangan yang Adil...
Dialogue: 0,0:20:06.24,0:20:08.16,Default,,0,0,0,,Mereka terus memanggil kita untuk masalah sepele.
Dialogue: 0,0:20:08.18,0:20:09.40,Default,,0,0,0,,Bisakah kamu mengurusnya?
Dialog: 0,0:20:09.42,0:20:11.43,Default,,0,0,0,,Anda harus bertanya kepada tim hukum Queens Mart.
Dialogue: 0,0:20:11.46,0:20:12.77,Default,,0,0,0,,Mereka terlalu padat,
Dialog: 0,0:20:12.79,0:20:15.81,Default,,0,0,0,,tapi kamu berpikir cepat dan cerdas,
Dialogue: 0,0:20:15.83,0:20:18.94,Default,,0,0,0,,dan petinggi di Fair\NTrade Commission menyukaimu.
Dialog: 0,0:20:18.96,0:20:20.98,Default,,0,0,0,,Kami memiliki yurisdiksi kami sendiri...
Dialogue: 0,0:20:21.01,0:20:23.63,Default,,0,0,0,,Kenapa kamu tidak bilang saja kamu akan melakukannya?
Dialogue: 0,0:20:29.22,0:20:30.28,Default,,0,0,0,,Dan kalian berdua.
Dialog: 0,0:20:30.31,0:20:31.49,Default,,0,0,0,,Aku ingin kamu punya bayi.
Dialogue: 0,0:20:31.52,0:20:34.08,Default,,0,0,0,,Orang-orang harus berhenti bergosip.
Dialogue: 0,0:20:34.10,0:20:35.58,Default,,0,0,0,,Sudahkah Anda menghubungi Dr. Joo?
Dialog: 0,0:20:35.60,0:20:37.12,Default,,0,0,0,,Ya, saya sudah membuat janji.
Dialogue: 0,0:20:37.15,0:20:38.79,Default,,0,0,0,,Dia akan menjalani pemeriksaan pranatal,
Dialog: 0,0:20:38.82,0:20:40.79,Default,,0,0,0,,lalu segera mulai prosedurnya.
Dialog: 0,0:20:40.82,0:20:42.59,Default,,0,0,0,,Adapun Hyun-woo, setelah bayinya lahir,
Dialog: 0,0:20:42.61,0:20:44.01,Default,,0,0,0,,kamu akan pergi ke Boston...
Dialog: 0,0:20:44.03,0:20:46.13,Default,,0,0,0,,dalam dua tahun ke depan untuk mendapatkan gelar MBA.
Dialog: 0,0:20:46.16,0:20:47.88,Default,,0,0,0,,Aku sudah memberitahumu ini.
Dialog: 0,0:20:47.91,0:20:49.76,Default,,0,0,0,,Saya tidak tertarik untuk mendapatkan gelar.
Dialog: 0,0:20:49.79,0:20:50.93,Default,,0,0,0,,Dan saya juga bilang...
Dialogue: 0,0:20:50.95,0:20:53.32,Default,,0,0,0,,itu bukan terserah kamu.
Dialog: 0,0:20:53.62,0:20:57.16,Default,,0,0,0,,Mereka tidak berhutang cucu pada kita,\Njadi berhentilah menekannya.
Dialog: 0,0:20:57.42,0:20:59.49,Default,,0,0,0,,Minumlah tehmu, Hyun-woo.
Dialog: 0,0:21:01.84,0:21:03.40,Default,,0,0,0,,Anda lihat,
Dialogue: 0,0:21:03.42,0:21:07.21,Default,,0,0,0,,Saya lebih suka bertemu Su-bin di bulan Mei.
Dialog: 0,0:21:12.52,0:21:14.58,Default,,0,0,0,,Siapa Su-bin?
Dialog: 0,0:21:14.60,0:21:17.43,Default,,0,0,0,,Menurutmu siapa? Itu cucu masa depanku.
Dialogue: 0,0:21:17.69,0:21:20.04,Default,,0,0,0,,Namanya berarti "sangat bersinar."
Dialogue: 0,0:21:20.07,0:21:23.04,Default,,0,0,0,,Lumayan kan? Hong Su Bin.
Dialog: 0,0:21:23.07,0:21:24.77,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:21:24.99,0:21:26.69,Default,,0,0,0,,Apakah dia akan menjadi Hong Su-bin...
Dialog: 0,0:21:27.03,0:21:28.22,Default,,0,0,0,,bukannya Baek Su-bin?
Dialog: 0,0:21:28.24,0:21:30.02,Default,,0,0,0,,Ada apa?
Dialogue: 0,0:21:30.74,0:21:32.93,Default,,0,0,0,,Kamu tidak ingin dia mempunyai nama keluarga ibunya?
Dialogue: 0,0:21:32.95,0:21:35.10,Default,,0,0,0,,Kita tidak perlu mengikuti sistem patriarki.
Dialogue: 0,0:21:35.12,0:21:39.08,Default,,0,0,0,,Menurutku cukup kuno\Nmenggunakan nama belakang ayah.
Dialogue: 0,0:21:40.25,0:21:43.77,Default,,0,0,0,,Tapi saat aku bertanya padamu tentang\Nmemberi Geon-u nama belakang ibunya,
Dialogue: 0,0:21:43.80,0:21:46.46,Default,,0,0,0,,kamu bilang itu omong kosong.
Dialog: 0,0:21:48.68,0:21:49.74,Default,,0,0,0,,Ini berbeda.
Dialog: 0,0:21:49.76,0:21:52.63,Default,,0,0,0,,Sama bukan? TIDAK?
Dialog: 0,0:22:16.08,0:22:17.91,Default,,0,0,0,,Kita perlu bicara.
Dialogue: 0,0:22:24.05,0:22:26.48,Default,,0,0,0,,Kita akan punya bayi, meskipun\Tidak ada yang terjadi?
Dialogue: 0,0:22:26.51,0:22:27.90,Default,,0,0,0,,Dan aku akan pergi ke luar negeri sendirian?
Dialog: 0,0:22:27.92,0:22:29.92,Default,,0,0,0,,Ada apa?
Dialogue: 0,0:22:30.01,0:22:32.13,Default,,0,0,0,,Bukankah itu bagus?
Dialog: 0,0:22:34.35,0:22:36.03,Default,,0,0,0,,Jangan bilang kamu ingin aku datang.
Dialog: 0,0:22:36.06,0:22:37.93,Default,,0,0,0,,Tentu saja tidak.
Dialog: 0,0:22:38.73,0:22:39.91,Default,,0,0,0,,Tepat.
Dialog: 0,0:22:39.94,0:22:41.71,Default,,0,0,0,,Lalu lakukan bagianmu dan pergi ke luar negeri.
Dialogue: 0,0:22:41.73,0:22:44.25,Default,,0,0,0,,Bagaimanapun, kita akan minta orang lain membesarkan bayi kita.
Dialog: 0,0:22:44.27,0:22:46.14,Default,,0,0,0,,Nyaman dan menyenangkan. Apa masalahnya?
Dialog: 0,0:22:46.17,0:22:47.87,Default,,0,0,0,,"Bagus"?
Dialog: 0,0:22:48.03,0:22:49.17,Default,,0,0,0,,Apakah kamu senang dengan ini?
Dialog: 0,0:22:49.20,0:22:50.90,Default,,0,0,0,,Serius?
Dialog: 0,0:22:52.53,0:22:54.93,Default,,0,0,0,,Apakah kamu benar-benar menginginkan bayi?
Dialog: 0,0:22:54.95,0:22:57.15,Default,,0,0,0,,Jika diperlukan.
Dialog: 0,0:23:03.46,0:23:05.29,Default,,0,0,0,,Ya?
Dialog: 0,0:23:05.42,0:23:09.04,Default,,0,0,0,,Apakah Anda memberi tahu mereka bahwa saya ingin menandatangani\Noff sebelum mereka menerbitkan artikel?
Dialog: 0,0:23:09.72,0:23:10.69,Default,,0,0,0,,Tentu saja.
Dialog: 0,0:23:10.72,0:23:12.42,Default,,0,0,0,,Juga...
Dialog: 0,0:23:12.64,0:23:14.70,Default,,0,0,0,,Suruh mereka memperkenalkan Direktur Baek dengan benar.
Dialog: 0,0:23:14.72,0:23:17.80,Default,,0,0,0,,Jangan lupa sebutkan dia belajar hukum di SNU.
Dialog: 0,0:23:21.85,0:23:22.91,Default,,0,0,0,,Apa?
Dialog: 0,0:23:22.94,0:23:26.29,Default,,0,0,0,,Berhenti melakukan wawancara ini. Saya sudah selesai dengan mereka.
Dialog: 0,0:23:26.32,0:23:27.46,Default,,0,0,0,,Lakukan sendiri jika perlu.
Dialogue: 0,0:23:27.48,0:23:29.84,Default,,0,0,0,,Bagaimana bisa, kalau itu tentang pasangan yang sudah menikah?
Dialog: 0,0:23:29.86,0:23:32.30,Default,,0,0,0,,Kamu bisa menceritakan semuanya tentang aku kepada mereka.
Dialog: 0,0:23:32.32,0:23:34.93,Default,,0,0,0,,Beri tahu mereka betapa kita begitu jatuh cinta,
Dialog: 0,0:23:34.95,0:23:36.68,Default,,0,0,0,,dan menikah dengan bahagia.
Dialog: 0,0:23:36.70,0:23:38.51,Default,,0,0,0,,Ceritakan semuanya.
Dialogue: 0,0:23:38.54,0:23:40.82,Default,,0,0,0,,Itu semua bohong.
Dialog: 0,0:23:55.14,0:23:56.66,Default,,0,0,0,,Hei.
Dialog: 0,0:23:56.68,0:23:58.37,Default,,0,0,0,,Saya mau fotonya dulu.
Dialogue: 0,0:23:58.39,0:24:01.13,Default,,0,0,0,,Saya pilih yang akan mereka gunakan.
Dialogue: 0,0:24:16.91,0:24:18.55,Default,,0,0,0,,Mengapa mereka menerbitkan artikel yang tidak berguna?
Dialogue: 0,0:24:18.58,0:24:19.72,Default,,0,0,0,,Kenapa mereka tidak menyebutkan...
Dialogue: 0,0:24:19.74,0:24:22.70,Default,,0,0,0,,bagaimana saya mendonasikan $200,000 secara anonim?
Dialog: 0,0:24:23.08,0:24:24.27,Default,,0,0,0,,Lihat.
Dialog: 0,0:24:24.29,0:24:25.64,Default,,0,0,0,,Saya tahu saya melakukannya secara anonim,
Dialog: 0,0:24:25.67,0:24:29.95,Default,,0,0,0,,karena saya tidak ingin siapa pun\Ntahu, tetapi semua orang harus tahu.
Dialogue: 0,0:24:30.30,0:24:31.94,Default,,0,0,0,,Bukankah itu gunanya tim PR?
Dialog: 0,0:24:31.97,0:24:33.96,Default,,0,0,0,,Aku sangat frustrasi.
Dialogue: 0,0:24:41.31,0:24:43.09,Default,,0,0,0,,Untuk apa itu?
Dialog: 0,0:24:45.06,0:24:46.12,Default,,0,0,0,,Apa?
Dialog: 0,0:24:46.15,0:24:47.37,Default,,0,0,0,,Apa yang kamu inginkan?
Dialog: 0,0:24:47.40,0:24:49.14,Default,,0,0,0,,Apa itu?
Dialog: 0,0:24:49.69,0:24:51.38,Default,,0,0,0,,Katakan padaku dari sana.
Dialog: 0,0:24:51.40,0:24:53.30,Default,,0,0,0,,Gunakan kata-katamu.
Dialog: 0,0:24:53.32,0:24:55.02,Default,,0,0,0,,Astaga.
Dialog: 0,0:24:56.62,0:24:58.09,Default,,0,0,0,,Astaga.
Dialog: 0,0:24:58.12,0:25:00.26,Default,,0,0,0,,- Soo-cheol.\N- Apa?
Dialog: 0,0:25:00.29,0:25:01.90,Default,,0,0,0,,Jangan hindari aku,
Dialog: 0,0:25:02.00,0:25:03.06,Default,,0,0,0,,atau Anda akan mendapatkan...
Dialogue: 0,0:25:03.08,0:25:05.82,Default,,0,0,0,,mata lebam dan mulai menangis lagi.
Dialog: 0,0:25:06.79,0:25:08.70,Default,,0,0,0,,Tunggu...
Dialog: 0,0:25:09.38,0:25:11.65,Default,,0,0,0,,Apakah kamu gila?
Dialogue: 0,0:25:11.67,0:25:12.98,Default,,0,0,0,,Kenapa kamu memukulku?
Dialogue: 0,0:25:13.01,0:25:15.86,Default,,0,0,0,,Apakah Hyun-woo temanmu atau\Nseseorang yang lebih muda darimu?
Dialog: 0,0:25:15.88,0:25:17.07,Default,,0,0,0,,"Berpikir cepat"?
Dialog: 0,0:25:17.09,0:25:19.59,Default,,0,0,0,,Beraninya kamu?
Dialog: 0,0:25:25.02,0:25:27.33,Default,,0,0,0,,Tidak menghormati suamiku lagi,
Dialog: 0,0:25:27.35,0:25:29.01,Default,,0,0,0,,dan aku akan membunuhmu.
Dialog: 0,0:25:29.86,0:25:32.81,Default,,0,0,0,,- Jawab aku.\N- Baik. Saya mengerti.
Dialogue: 0,0:25:36.20,0:25:38.09,Default,,0,0,0,,Penyihir gila itu.
Dialogue: 0,0:25:38.11,0:25:41.05,Default,,0,0,0,,Kenapa marah padaku, padahal dia\Nmenindas Hyun-woo sepanjang waktu?
Dialogue: 0,0:25:41.08,0:25:44.11,Default,,0,0,0,,Dia benar-benar psikopat!
Dialogue: 0,0:25:46.58,0:25:48.91,Default,,0,0,0,,Aku tidak membicarakanmu.
Dialog: 0,0:26:04.06,0:26:06.45,Default,,0,0,0,,Semua orang ingin kamu mempertimbangkan kembali perceraian ini,
Dialog: 0,0:26:06.48,0:26:09.00,Default,,0,0,0,,dan tinggal bersamanya.
Dialogue: 0,0:26:09.02,0:26:12.10,Default,,0,0,0,,Mereka ingin aku memberitahumu hal itu. Apakah kamu menangis?
Dialog: 0,0:26:13.90,0:26:16.23,Default,,0,0,0,,Apa? Apakah kamu sudah mabuk?
Dialog: 0,0:26:18.74,0:26:21.05,Default,,0,0,0,,Apa ini? Kamu membuat hatiku berdebar.
Dialogue: 0,0:26:21.07,0:26:22.18,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:26:22.20,0:26:24.85,Default,,0,0,0,,Rupanya aku manis saat mabuk.
Dialog: 0,0:26:24.87,0:26:27.01,Default,,0,0,0,,- Dia bilang itu jurus spesialku.\N- Siapa bilang?
Dialog: 0,0:26:27.04,0:26:30.37,Default,,0,0,0,,Hae-in mengatakan itu.
Dialogue: 0,0:26:30.46,0:26:32.16,Default,,0,0,0,,Dia bilang...
Dialogue: 0,0:26:33.17,0:26:34.23,Default,,0,0,0,,Aku manis.
Dialog: 0,0:26:34.25,0:26:36.21,Default,,0,0,0,,Apakah kamu menyombongkan diri?
Dialogue: 0,0:26:36.59,0:26:38.19,Default,,0,0,0,,Kenapa aku seperti itu?
Dialogue: 0,0:26:38.22,0:26:40.25,Default,,0,0,0,,Kenapa aku lucu?
Dialogue: 0,0:26:40.43,0:26:43.03,Default,,0,0,0,,Kenapa aku menggunakan jurus spesialku dan terlihat lucu?
Dialogue: 0,0:26:43.05,0:26:45.24,Default,,0,0,0,,Kenapa aku membuat jantungnya berdebar?
Dialog: 0,0:26:45.27,0:26:46.99,Default,,0,0,0,,Dan sebagai hasilnya,
Dialogue: 0,0:26:47.02,0:26:48.95,Default,,0,0,0,,Aku merusak...
Dialog: 0,0:26:48.98,0:26:50.85,Default,,0,0,0,,hidupku sendiri.
Dialogue: 0,0:26:51.27,0:26:54.72,Default,,0,0,0,,Kita tidak akan menikah\Nkalau saja aku tidak begitu manis.
Dialogue: 0,0:26:55.82,0:26:58.21,Default,,0,0,0,,Orang gila ini benar-benar sia-sia.
Dialog: 0,0:26:58.24,0:26:59.55,Default,,0,0,0,,Hei, bangun.
Dialogue: 0,0:26:59.57,0:27:02.84,Default,,0,0,0,,Istriku meneleponku,\Memintaku membelikan popok untuk bayi kami.
Dialog: 0,0:27:02.87,0:27:05.59,Default,,0,0,0,,Tidak, aku tidak akan pulang.
Dialog: 0,0:27:05.62,0:27:07.68,Default,,0,0,0,,Mengapa saya harus melakukannya?
Dialog: 0,0:27:07.70,0:27:08.81,Default,,0,0,0,,Kenapa kamu tidak pulang?
Dialogue: 0,0:27:08.83,0:27:10.49,Default,,0,0,0,,Aku mabuk!
Dialog: 0,0:27:10.58,0:27:13.33,Default,,0,0,0,,Aku terlalu manis saat mabuk!
Dialogue: 0,0:27:14.09,0:27:18.27,Default,,0,0,0,,Aku selalu dikenal sebagai "anak\Nimut dari rumah pohon pir di Yongdu-ri."
Dialog: 0,0:27:18.30,0:27:20.32,Default,,0,0,0,,Itu sifatku.
Dialogue: 0,0:27:20.34,0:27:23.21,Default,,0,0,0,,Aku terlahir seperti ini.
Dialog: 0,0:27:23.80,0:27:25.96,Default,,0,0,0,,Apa yang bisa kulakukan?
Dialogue: 0,0:27:31.10,0:27:33.05,Default,,0,0,0,,Jadi kamu tidak mau pulang?
Dialog: 0,0:27:33.52,0:27:35.72,Default,,0,0,0,,Tinggalkan saja aku di sini.
Dialog: 0,0:27:35.82,0:27:37.96,Default,,0,0,0,,Aku akan dibawa pulang dengan selamat.
Dialog: 0,0:27:37.98,0:27:39.85,Default,,0,0,0,,Oleh siapa?
Dialogue: 0,0:27:42.61,0:27:44.94,Default,,0,0,0,,Mereka akan mencegah semua skandal.
Dialog: 0,0:27:48.70,0:27:49.81,Default,,0,0,0,,Tidak mungkin.
Dialog: 0,0:27:49.83,0:27:51.57,Default,,0,0,0,,Ingin melihat?
Dialog: 0,0:28:03.09,0:28:04.96,Default,,0,0,0,,Tidak mungkin.
Dialog: 0,0:28:05.05,0:28:07.13,Default,,0,0,0,,Setiap saat...
Dialogue: 0,0:28:08.56,0:28:11.12,Default,,0,0,0,,Aku merobek daun dari dahan...
Dialog: 0,0:28:11.14,0:28:13.45,Default,,0,0,0,,untuk melihat apakah aku harus bercerai atau tidak...
Dialogue: 0,0:28:13.48,0:28:15.37,Default,,0,0,0,,Kamu yang melakukannya?
Dialogue: 0,0:28:15.40,0:28:17.12,Default,,0,0,0,,Saya selalu mendapat jawaban "tidak".
Dialog: 0,0:28:17.15,0:28:19.88,Default,,0,0,0,,Setiap saat.
Dialog: 0,0:28:19.90,0:28:21.25,Default,,0,0,0,,Jadi, itu takdirmu.
Dialog: 0,0:28:21.28,0:28:23.02,Default,,0,0,0,,Tidak ada siapa-siapa.
Dialog: 0,0:28:23.15,0:28:25.06,Default,,0,0,0,,Tak seorang pun di dunia ini...
Dialogue: 0,0:28:25.66,0:28:28.40,Default,,0,0,0,,ada di pihakku.
Dialogue: 0,0:28:28.83,0:28:32.24,Default,,0,0,0,,Tidak ada sehelai daun pun yang ada di sisiku.
Dialog: 0,0:28:32.83,0:28:35.77,Default,,0,0,0,,Saya tidak membutuhkan siapa pun di sisi saya.\NI hanya ingin memiliki gedung.
Dialogue: 0,0:28:35.79,0:28:38.73,Default,,0,0,0,,Bangunan itu akan berada di sisiku selamanya.
Dialog: 0,0:28:38.75,0:28:40.49,Default,,0,0,0,,Suasana hati istriku seperti roller coaster.
Dialogue: 0,0:28:40.52,0:28:42.81,Default,,0,0,0,,Dia akan tersenyum di\Npagi hari lalu mengamuk di malam hari.
Dialogue: 0,0:28:42.83,0:28:45.75,Default,,0,0,0,,Apakah salahku karena popoknya habis?\NKenapa dia marah padaku?
Dialog: 0,0:28:45.77,0:28:47.24,Default,,0,0,0,,Saya hanya butuh bangunan.
Dialogue: 0,0:28:47.26,0:28:49.03,Default,,0,0,0,,Bangunan beton tidak berubah.
Dialogue: 0,0:28:49.06,0:28:50.57,Default,,0,0,0,,Mereka tidak mengomel atau marah.
Dialog: 0,0:28:50.60,0:28:52.22,Default,,0,0,0,,Mulai.
Dialogue: 0,0:28:54.19,0:28:56.46,Default,,0,0,0,,Ambil popokmu.
Dialogue: 0,0:28:56.48,0:28:58.14,Default,,0,0,0,,Biarkan saja.
Dialog: 0,0:29:12.75,0:29:14.70,Default,,0,0,0,,♫ {\i1}Siapa bilang{\i0} ♫
Dialog: 0,0:29:15.21,0:29:17.85,Default,,0,0,0,,♫ {\i1}cinta{\i0} ♫
Dialogue: 0,0:29:17.88,0:29:24.42,Default,,0,0,0,,♫ {\i1}indahkah?{\i0} ♫
Dialog: 0,0:29:31.01,0:29:32.83,Default,,0,0,0,,Sudah pergi.
Dialog: 0,0:29:32.85,0:29:34.70,Default,,0,0,0,,Kamu bisa pulang sekarang.
Dialogue: 0,0:29:34.73,0:29:37.39,Default,,0,0,0,,Kau akan terus melihatku menangis?
Dialog: 0,0:29:38.98,0:29:42.35,Default,,0,0,0,,Aku hanya menangis dalam perjalanan pulang!
Dialog: 0,0:29:47.45,0:29:50.23,Default,,0,0,0,,Kenapa kamu pergi ke sana?
Dialog: 0,0:30:05.59,0:30:12.59,Default,,0,0,0,,♫ {\i1}Menidurkanku{\i0} ♫
Dialogue: 0,0:30:12.68,0:30:19.09,Default,,0,0,0,,♫ {\i1}dengan tangan cantikmu{\i0} ♫
Dialog: 0,0:32:32.01,0:32:33.80,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kartu Identifikasi Pengacara\NBaek Hyun-woo{\c}{\i0}
Dialog: 0,0:32:34.70,0:32:36.43,Default,,0,0,0,,Hei, bukankah dia menantu Ratu?
Dialogue: 0,0:32:36.45,0:32:39.01,Default,,0,0,0,,Menantu, kakiku. Dia seorang kepala pelayan.
Dialog: 0,0:32:39.04,0:32:42.47,Default,,0,0,0,,Kudengar dia membereskan kekacauan mertuanya.
Dialog: 0,0:32:42.50,0:32:44.45,Default,,0,0,0,,Di mana harga dirinya?
Dialogue: 0,0:32:46.50,0:32:49.65,Default,,0,0,0,,Dia tidak akan menikah\Ndengan keluarga itu jika dia punya.
Dialogue: 0,0:32:49.67,0:32:51.40,Default,,0,0,0,,Dia mempermalukan semua pengacara.
Dialog: 0,0:32:51.42,0:32:53.71,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:33:04.64,0:33:05.87,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:33:05.90,0:33:08.43,Default,,0,0,0,,Haleluya, Hyun-woo.
Dialogue: 0,0:33:09.19,0:33:11.13,Default,,0,0,0,,Jadi bagaimana jika saya memiliki $25 juta di akun saya?
Dialogue: 0,0:33:11.15,0:33:13.24,Default,,0,0,0,,Aku bahkan tidak bisa menggunakannya untuk membeli benang gigi di sini.
Dialogue: 0,0:33:13.26,0:33:15.34,Default,,0,0,0,,Ngomong-ngomong, bagaimana kamu mendapatkan ide ini?
Dialog: 0,0:33:15.36,0:33:17.06,Default,,0,0,0,,Bu.
Dialogue: 0,0:33:17.45,0:33:20.48,Default,,0,0,0,,Ini sebenarnya ilegal lho.
Dialog: 0,0:33:20.91,0:33:21.97,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:33:22.00,0:33:24.14,Default,,0,0,0,,Berapa lama aku harus dikurung?
Dialogue: 0,0:33:24.16,0:33:25.81,Default,,0,0,0,,Aku tidak melakukan dosa sebesar itu.
Dialog: 0,0:33:25.83,0:33:28.40,Default,,0,0,0,,Saya pikir Seul-hee adalah\Npelapor yang melaporkan saya...
Dialog: 0,0:33:28.42,0:33:30.27,Default,,0,0,0,,untuk penggelapan, jadi aku menjambak rambutnya.
Dialog: 0,0:33:30.29,0:33:32.31,Default,,0,0,0,,Apakah itu kejahatan?
Dialog: 0,0:33:32.34,0:33:34.65,Default,,0,0,0,,Dia harus menerima perawatan selama empat minggu.
Dialog: 0,0:33:34.67,0:33:37.70,Default,,0,0,0,,Sialan. Seharusnya aku merawatnya di rumah sakit.
Dialogue: 0,0:33:37.72,0:33:39.53,Default,,0,0,0,,Dialah alasan ibuku meninggal.
Dialog: 0,0:33:39.55,0:33:43.26,Default,,0,0,0,,Tunggu dan lihat saja. Aku akan membalas dendam padanya.
Dialog: 0,0:33:44.60,0:33:46.34,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:33:47.15,0:33:48.41,Default,,0,0,0,,Membalas dendam...
Dialogue: 0,0:33:48.44,0:33:49.58,Default,,0,0,0,,adalah keahlianku.
Dialog: 0,0:33:49.61,0:33:51.79,Default,,0,0,0,,Saya sadar sepenuhnya, Bu.
Dialog: 0,0:33:51.82,0:33:54.63,Default,,0,0,0,,Ketiga mantan suamiku\Ntelah meninggalkan negara ini.
Dialog: 0,0:33:54.65,0:33:57.77,Default,,0,0,0,,Aku membawa neraka bagi mereka semua dan kerabat mereka.
Dialog: 0,0:33:58.66,0:34:00.22,Default,,0,0,0,,Bu.
Dialogue: 0,0:34:00.24,0:34:02.68,Default,,0,0,0,,Pasangan suami istri pada akhirnya bisa berpisah,
Dialog: 0,0:34:02.70,0:34:04.76,Default,,0,0,0,,jadi kenapa kamu harus sejauh itu?
Dialog: 0,0:34:04.79,0:34:06.74,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:34:07.04,0:34:09.39,Default,,0,0,0,,Perceraian itu brutal dan berantakan.
Dialogue: 0,0:34:09.42,0:34:11.19,Default,,0,0,0,,Tidak ada kata selamat tinggal dalam perceraian.
Dialog: 0,0:34:11.21,0:34:14.79,Default,,0,0,0,,Solusi terbaik adalah salah satu dari mereka mati.
Dialog: 0,0:34:14.84,0:34:17.15,Default,,0,0,0,,Jika saya menikah dan bercerai lagi di kemudian hari,
Dialog: 0,0:34:17.18,0:34:19.42,Default,,0,0,0,,Saya akan meminta Anda menangani kasus saya.
Dialog: 0,0:34:19.89,0:34:21.45,Default,,0,0,0,,Kenapa kamu...
Dialogue: 0,0:34:21.47,0:34:23.53,Default,,0,0,0,,sudah berpikir untuk bercerai lagi?
Dialog: 0,0:34:23.56,0:34:25.16,Default,,0,0,0,,Terserah.
Dialog: 0,0:34:25.18,0:34:27.29,Default,,0,0,0,,Untuk beberapa alasan,
Dialogue: 0,0:34:27.31,0:34:29.87,Default,,0,0,0,,Menurutku pernikahan dan perceraian berjalan beriringan,
Dialog: 0,0:34:29.90,0:34:32.35,Default,,0,0,0,,bukannya pernikahan dan kebahagiaan.
Dialog: 0,0:34:32.52,0:34:33.71,Default,,0,0,0,,Saya setuju.
Dialog: 0,0:34:33.73,0:34:35.17,Default,,0,0,0,,Apa katamu?
Dialog: 0,0:34:35.19,0:34:36.38,Default,,0,0,0,,Tidak ada.
Dialog: 0,0:34:36.40,0:34:37.84,Default,,0,0,0,,Hei. Lihat disini.
Dialogue: 0,0:34:37.86,0:34:40.23,Default,,0,0,0,,Rambutku rontok banyak ya?
Dialogue: 0,0:34:40.41,0:34:42.22,Default,,0,0,0,,Aku benar-benar harus keluar dari sini.
Dialogue: 0,0:34:42.24,0:34:43.93,Default,,0,0,0,,Tempat ini penuh dengan gadis.
Dialogue: 0,0:34:43.95,0:34:46.81,Default,,0,0,0,,Aku akan menjadi seperti\Nmereka jika aku tinggal di sini lebih lama lagi.
Dialogue: 0,0:34:46.83,0:34:48.53,Default,,0,0,0,,Upacara peringatan ibuku sebentar lagi.
Dialogue: 0,0:34:48.55,0:34:50.60,Default,,0,0,0,,Ayahku akan menyelesaikan ini sebelum itu...
Dialog: 0,0:34:50.63,0:34:51.85,Default,,0,0,0,,demi dia, kan?
Dialog: 0,0:34:51.88,0:34:54.52,Default,,0,0,0,,Saat ini aku berada di depan Queens Town...
Dialog: 0,0:34:54.55,0:34:57.24,Default,,0,0,0,,di Hanil-dong, Yongsan-gu,\NSeoul tempat upacara peringatan...
Dialog: 0,0:34:57.27,0:34:59.40,Default,,0,0,0,,dari Yang Mi-suk, mendiang istri ketua\NQueens,
Dialog: 0,0:34:59.42,0:35:00.49,Default,,0,0,0,,sedang berlangsung.
Dialog: 0,0:35:00.51,0:35:03.36,Default,,0,0,0,,Anggota keluarga datang satu per satu.
Dialog: 0,0:35:03.39,0:35:05.82,Default,,0,0,0,,Tahun ini, Hong Beom-seok,\Nputra tertua ketua...
Dialog: 0,0:35:05.85,0:35:07.66,Default,,0,0,0,,dan mantan CEO Queens Distribution,
Dialog: 0,0:35:07.68,0:35:11.21,Default,,0,0,0,,terbang dari Hawaii.
Dialogue: 0,0:35:11.23,0:35:12.66,Default,,0,0,0,,Ada ketertarikan...
Dialog: 0,0:35:12.69,0:35:16.46,Default,,0,0,0,,apakah ketua\Ndan putranya akan berdamai atau tidak...
Dialog: 0,0:35:16.48,0:35:19.10,Default,,0,0,0,,setelah perseteruan lama mereka.
Dialogue: 0,0:35:20.40,0:35:23.93,Default,,0,0,0,,Pak, bisakah Anda melihat pancake saya?\NDApakah menurut Anda bagian dalamnya sudah matang?
Dialog: 0,0:35:23.95,0:35:25.39,Default,,0,0,0,,Kenapa kamu menanyakan itu padaku?
Dialog: 0,0:35:25.41,0:35:27.10,Default,,0,0,0,,Anda belajar kimia di Harvard,
Dialog: 0,0:35:27.12,0:35:29.32,Default,,0,0,0,,jadi saya pikir Anda akan tahu.
Dialog: 0,0:35:29.91,0:35:31.56,Default,,0,0,0,,Ya. Dilihat dari warnanya,
Dialogue: 0,0:35:31.58,0:35:33.52,Default,,0,0,0,,Saya yakin semuanya sudah matang. Balikkan.
Dialog: 0,0:35:33.54,0:35:36.04,Default,,0,0,0,,Ya pak. Aku akan melakukan pelapisannya.
Dialogue: 0,0:35:36.50,0:35:39.19,Default,,0,0,0,,Apakah kamu yang lulus\Ndari Parsons School of Design?
Dialogue: 0,0:35:39.22,0:35:40.73,Default,,0,0,0,,Bukan, itu aku.
Dialogue: 0,0:35:40.76,0:35:42.99,Default,,0,0,0,,Keluarganya telah menjadi arsitek selama beberapa generasi.
Dialogue: 0,0:35:43.01,0:35:44.91,Default,,0,0,0,,Keluarganya membuat patung besar...
Dialog: 0,0:35:44.93,0:35:46.87,Default,,0,0,0,,- di depan Louvre.\N- Jujur saja.
Dialogue: 0,0:35:46.89,0:35:49.59,Default,,0,0,0,,Aku cukup percaya diri dalam menumpuk makanan.
Dialogue: 0,0:35:52.35,0:35:54.97,Default,,0,0,0,,Sungguh menyia-nyiakan bakat.
Dialogue: 0,0:35:55.98,0:35:57.75,Default,,0,0,0,,Saudara iparku tersayang.
Dialog: 0,0:35:57.78,0:36:00.59,Default,,0,0,0,,Ini Tuan Choi. Dia\Nmenikah dengan Min-hee, kerabat kami.
Dialog: 0,0:36:00.61,0:36:01.71,Default,,0,0,0,,Saudara iparku.
Dialog: 0,0:36:01.74,0:36:03.05,Default,,0,0,0,,Halo.
Dialog: 0,0:36:03.07,0:36:04.47,Default,,0,0,0,,Halo.
Dialogue: 0,0:36:04.49,0:36:07.97,Default,,0,0,0,,Dulu, keluarga\N yang berkuasa seperti bangsawan...
Dialog: 0,0:36:07.99,0:36:11.14,Default,,0,0,0,,membuat anggota pria mempersiapkan\Apa pun untuk upacara peringatan.
Dialog: 0,0:36:11.16,0:36:14.23,Default,,0,0,0,,Ketua mempunyai minat yang besar\Npada tradisi kerajaan,
Dialog: 0,0:36:14.25,0:36:16.65,Default,,0,0,0,,jadi kami telah melakukan ini selama beberapa tahun sekarang.
Dialog: 0,0:36:16.67,0:36:19.33,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:36:19.63,0:36:20.77,Default,,0,0,0,,Benar.
Dialogue: 0,0:36:20.80,0:36:23.65,Default,,0,0,0,,Inilah sebabnya mengapa tradisi\Ndan masa depan berjalan dengan baik bersama-sama.
Dialogue: 0,0:36:23.68,0:36:26.41,Default,,0,0,0,,Ini tidak kuno.\NICukup progresif dan bagus.
Dialog: 0,0:36:26.43,0:36:28.24,Default,,0,0,0,,Sesuai dengan tren saat ini.
Dialogue: 0,0:36:28.26,0:36:31.03,Default,,0,0,0,,Jika sangat progresif, bagus, dan trendi,
Dialog: 0,0:36:31.06,0:36:32.72,Default,,0,0,0,,kenapa kamu tidak bergabung dengan kami?
Dialog: 0,0:36:33.23,0:36:34.50,Default,,0,0,0,,Kamu kenal aku.
Dialog: 0,0:36:34.52,0:36:36.46,Default,,0,0,0,,Saya sudah pergi ke gereja sejak tahun lalu,
Dialogue: 0,0:36:36.48,0:36:38.21,Default,,0,0,0,,jadi ini bertentangan dengan agamaku.
Dialog: 0,0:36:38.23,0:36:40.43,Default,,0,0,0,,Saya terlahir sebagai seorang Kristen.
Dialog: 0,0:36:41.28,0:36:43.88,Default,,0,0,0,,Sejak aku masih muda,
Dialog: 0,0:36:43.91,0:36:45.92,Default,,0,0,0,,Saya punya kondisi...
Dialog: 0,0:36:45.95,0:36:49.90,Default,,0,0,0,,di mana saya tidak bisa mencium bau minyak. Sayang sekali.
Dialog: 0,0:36:50.66,0:36:52.39,Default,,0,0,0,,Terima kasih atas kerja keras Anda.
Dialog: 0,0:36:52.41,0:36:54.70,Default,,0,0,0,,Semoga berhasil.
Dialog: 0,0:36:55.63,0:36:57.69,Default,,0,0,0,,- Astaga.\N- Serius?
Dialog: 0,0:36:57.71,0:36:59.73,Default,,0,0,0,,Ini adalah upacara peringatan keluarga Hong,
Dialog: 0,0:36:59.75,0:37:03.07,Default,,0,0,0,,tapi tidak ada seorang pun di sini yang memiliki nama keluarga itu.
Dialogue: 0,0:37:03.09,0:37:05.32,Default,,0,0,0,,Mereka harus mempersiapkan upacara peringatannya sendiri.
Dialog: 0,0:37:05.34,0:37:06.99,Default,,0,0,0,,- Astaga.\N- Aku anak tunggal kelima...
Dialog: 0,0:37:07.01,0:37:09.32,Default,,0,0,0,,dari keluarga Yu di\NPaechon County, generasi ke-39.
Dialogue: 0,0:37:09.35,0:37:12.83,Default,,0,0,0,,Apa yang akan ibuku katakan jika dia melihat\Naku menyelesaikan tusuk sate ini dalam sepuluh detik?
Dialog: 0,0:37:12.85,0:37:15.12,Default,,0,0,0,,Mari kita tidak membicarakan betapa berharganya kita...
Dialog: 0,0:37:15.14,0:37:17.14,Default,,0,0,0,,kepada keluarga kita.
Dialog: 0,0:37:18.98,0:37:20.29,Default,,0,0,0,,Selamat datang di Queens.
Dialog: 0,0:37:20.32,0:37:22.13,Default,,0,0,0,,- Selamat datang.\N- Selamat datang.
Dialog: 0,0:37:22.15,0:37:24.23,Default,,0,0,0,,Jika aku jadi kamu,
Dialogue: 0,0:37:24.82,0:37:26.98,Default,,0,0,0,,Aku akan kabur sekarang.
Dialogue: 0,0:37:30.62,0:37:33.70,Default,,0,0,0,,Belum terlambat, karena ini\Nupacara peringatannya yang pertama.
Dialogue: 0,0:37:33.91,0:37:37.28,Default,,0,0,0,,Bagaimana warnanya? Apakah itu terlihat terlalu membosankan?
Dialogue: 0,0:37:37.33,0:37:40.54,Default,,0,0,0,,Hijau giok bukanlah warna yang mudah.
Dialog: 0,0:37:40.59,0:37:44.69,Default,,0,0,0,,Saya hanya melihat dua orang\Nyang terlihat bagus dengan warna itu.
Dialog: 0,0:37:44.72,0:37:45.82,Default,,0,0,0,,Kamu...
Dialog: 0,0:37:45.84,0:37:49.67,Default,,0,0,0,,dan Yuna Kim di London Fashion Show.
Dialogue: 0,0:37:51.05,0:37:53.37,Default,,0,0,0,,Her? Ya, dia terlihat sangat baik.
Dialogue: 0,0:37:53.39,0:37:55.12,Default,,0,0,0,,Kamu juga begitu, Bu.
Dialogue: 0,0:37:55.14,0:37:58.01,Default,,0,0,0,,Kamu tahu cara menyenangkan orang lain.
Dialog: 0,0:38:01.69,0:38:03.34,Default,,0,0,0,,Ms. Moh.
Dialogue: 0,0:38:03.36,0:38:06.31,Default,,0,0,0,,Kenapa kamu tidak memakai\N{\i1}hanbok{\i0} yang dikirimkan padamu?
Dialog: 0,0:38:06.86,0:38:09.80,Default,,0,0,0,,Saya seharusnya tidak berada di upacara peringatan ini.
Dialogue: 0,0:38:09.82,0:38:12.15,Default,,0,0,0,,Keluarga bisa melakukannya tanpa aku.
Dialogue: 0,0:38:13.03,0:38:15.64,Default,,0,0,0,,Anda telah bersama kami selama lebih dari\N20 tahun, jadi Anda juga keluarga.
Dialogue: 0,0:38:15.66,0:38:17.66,Default,,0,0,0,,Itulah arti keluarga.
Dialogue: 0,0:38:17.71,0:38:21.65,Default,,0,0,0,,Anda baik sekali,\Ntapi saya diam saja di kamar saya.
Dialogue: 0,0:38:21.67,0:38:23.40,Default,,0,0,0,,Orang akan bicara...
Dialog: 0,0:38:23.42,0:38:27.03,Default,,0,0,0,,tentang bagaimana aku mendorongmu dan menganiayamu.
Dialog: 0,0:38:27.05,0:38:29.71,Default,,0,0,0,,"Mendorongmu berkeliling"? Siapa yang mendorong siapa?
Dialogue: 0,0:38:36.56,0:38:39.25,Default,,0,0,0,,Apakah kamu mendorongnya?
Dialog: 0,0:38:39.27,0:38:41.71,Default,,0,0,0,,Saya? Dorong dia?
Dialog: 0,0:38:41.73,0:38:44.04,Default,,0,0,0,,Tidak, Ayah. Tidak pernah.
Dialog: 0,0:38:44.07,0:38:45.54,Default,,0,0,0,,Lalu kenapa kamu mengatakan itu?
Dialogue: 0,0:38:45.57,0:38:49.38,Default,,0,0,0,,Kamu hanya mengatakan itu karena\Nbegitulah pendapatmu tentang dia.
Dialogue: 0,0:38:49.41,0:38:51.01,Default,,0,0,0,,Bukan itu alasannya.
Dialogue: 0,0:38:51.03,0:38:55.43,Default,,0,0,0,,Dia tidak mau memakai {\i1}hanbok.{\i0}
Dialog: 0,0:38:55.45,0:38:58.20,Default,,0,0,0,,- Kenapa tidak?\N- Saya tidak tahu.
Dialogue: 0,0:38:59.58,0:39:01.45,Default,,0,0,0,,Kamu tidak mau melakukannya?
Dialog: 0,0:39:01.71,0:39:03.99,Default,,0,0,0,,Tentu saja saya akan melakukannya.
Dialog: 0,0:39:08.05,0:39:09.96,Default,,0,0,0,,Anda mendengarnya.
Dialog: 0,0:39:10.63,0:39:12.34,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:39:21.73,0:39:24.47,Default,,0,0,0,,Gila sekali...!
Dialog: 0,0:39:25.19,0:39:27.23,Default,,0,0,0,,Astaga, aku stres sekali.
Dialogue: 0,0:39:28.53,0:39:30.42,Default,,0,0,0,,Dia licik.
Dialog: 0,0:39:30.45,0:39:35.57,Default,,0,0,0,,Dia akan dengan berani menghadiri\NM. Upacara peringatan Yang...
Dialog: 0,0:39:35.87,0:39:37.55,Default,,0,0,0,,karena ketua bersikeras.
Dialogue: 0,0:39:37.58,0:39:39.45,Default,,0,0,0,,Itu rencananya.
Dialogue: 0,0:39:41.33,0:39:45.24,Default,,0,0,0,,Siapa sangka pacar mertua\Nbisa lebih buruk dari ibu mertua?
Dialog: 0,0:40:04.02,0:40:06.47,Default,,0,0,0,,Beom-ja ada di sini!
Dialog: 0,0:40:19.75,0:40:21.40,Default,,0,0,0,,Hyun-woo.
Dialog: 0,0:40:28.46,0:40:29.98,Default,,0,0,0,,Kenapa dia keluar hari ini?
Dialogue: 0,0:40:30.01,0:40:32.78,Default,,0,0,0,,Kamu bilang dia akan sakit jika dia\Nterkurung dalam cuaca dingin ini.
Dialog: 0,0:40:32.80,0:40:34.69,Default,,0,0,0,,Benar.
Dialogue: 0,0:40:34.72,0:40:36.45,Default,,0,0,0,,Aku memang bilang begitu.
Dialogue: 0,0:40:36.47,0:40:40.17,Default,,0,0,0,,Tetap saja, kamu harus menunggu untuk mengeluarkan\Ndia setelah upacara peringatan.
Dialog: 0,0:40:42.73,0:40:44.91,Default,,0,0,0,,Apa? Lihatlah itu tidak ada gunanya.
Dialogue: 0,0:40:44.94,0:40:46.76,Default,,0,0,0,,Lihat saja dia.
Dialogue: 0,0:40:48.11,0:40:49.98,Default,,0,0,0,,Saya gegabah pak.
Dialog: 0,0:40:55.99,0:40:57.30,Default,,0,0,0,,Bu.
Dialog: 0,0:40:57.32,0:40:59.59,Default,,0,0,0,,Saya dikurung.
Dialog: 0,0:40:59.62,0:41:03.70,Default,,0,0,0,,Ayah memasukkan putrinya satu-satunya ke balik jeruji besi,
Dialogue: 0,0:41:04.37,0:41:07.81,Default,,0,0,0,,hanya karena aku menjambak rambut\Npacarnya dan menendangnya.
Dialog: 0,0:41:07.84,0:41:09.74,Default,,0,0,0,,Hei.
Dialog: 0,0:41:10.88,0:41:12.91,Default,,0,0,0,,Itu kenyataannya.
Dialogue: 0,0:41:13.01,0:41:15.74,Default,,0,0,0,,Kau jatuh cinta padanya.
Dialogue: 0,0:41:15.76,0:41:18.53,Default,,0,0,0,,Kamu tidak hanya jatuh cinta pada\Nwanita yang membunuh istrimu,
Dialogue: 0,0:41:18.55,0:41:20.53,Default,,0,0,0,,tapi kamu mengirim putrimu ke penjara.
Dialogue: 0,0:41:20.56,0:41:23.08,Default,,0,0,0,,Kamu benar-benar tidak berperasaan.
Dialog: 0,0:41:23.10,0:41:26.08,Default,,0,0,0,,Beom-ja, ini adalah layanan\N peringatan Ibu. Mari kita bicara nanti. Oke?
Dialogue: 0,0:41:26.10,0:41:28.83,Default,,0,0,0,,Kamu juga sama. Apakah\Nkamu lupa siapa dia?
Dialog: 0,0:41:28.86,0:41:30.67,Default,,0,0,0,,Ibu meninggal karena dia!
Dialogue: 0,0:41:30.69,0:41:32.21,Default,,0,0,0,,Ibu meninggal karena serangan jantung...
Dialog: 0,0:41:32.23,0:41:36.13,Default,,0,0,0,,Tepat! Menurut Anda mengapa dia memilikinya?
Dialogue: 0,0:41:36.16,0:41:39.23,Default,,0,0,0,,Jantungnya berhenti berdetak karena dia\Nmarah pada Moh Seul-hee!
Dialogue: 0,0:41:39.53,0:41:43.47,Default,,0,0,0,,Jadi bagaimana kamu bisa berdiri memandangi\Nat dia setiap siang dan malam?
Dialogue: 0,0:41:43.50,0:41:45.14,Default,,0,0,0,,Kamu tidak kesal?
Dialog: 0,0:41:45.16,0:41:48.83,Default,,0,0,0,,- Beom-ja, aku...\N- Astaga, Bu.
Dialogue: 0,0:41:49.00,0:41:51.15,Default,,0,0,0,,Apa gunanya punya anak laki-laki?
Dialog: 0,0:41:51.17,0:41:53.52,Default,,0,0,0,,Kamu bahkan tidak menyiapkan\Nskate, makanan favoritnya,
Dialog: 0,0:41:53.55,0:41:54.86,Default,,0,0,0,,jadi siapa yang harus kamu ajak bicara?
Dialog: 0,0:41:54.88,0:41:58.15,Default,,0,0,0,,Bibi Beom-ja, kami punya skate.\NRumahnya berbau busuk.
Dialogue: 0,0:41:58.18,0:42:00.36,Default,,0,0,0,,Enyahlah, brengsek!
Dialogue: 0,0:42:00.39,0:42:03.74,Default,,0,0,0,,Bagaimana mungkin kamu tidak pernah mengunjungi\Naku ketika aku sendiri yang membesarkanmu?
Dialog: 0,0:42:03.77,0:42:06.54,Default,,0,0,0,,Kamu tidak membesarkannya.
Dialog: 0,0:42:06.56,0:42:08.08,Default,,0,0,0,,Jangan konyol.
Dialog: 0,0:42:08.10,0:42:09.46,Default,,0,0,0,,Bibi Beom-ja.
Dialog: 0,0:42:09.48,0:42:11.46,Default,,0,0,0,,Kami baru saja menyajikan alkohol.
Dialog: 0,0:42:11.48,0:42:13.02,Default,,0,0,0,,Benarkah?
Dialog: 0,0:42:13.53,0:42:16.14,Default,,0,0,0,,Kalau begitu, kita harus melanjutkan. Berlangsung.
Dialog: 0,0:42:29.79,0:42:30.94,Default,,0,0,0,,Ada apa denganmu?
Dialog: 0,0:42:30.96,0:42:32.19,Default,,0,0,0,,Ayo.
Dialog: 0,0:42:32.21,0:42:34.48,Default,,0,0,0,,Hei, putar gelasnya perlahan.
Dialogue: 0,0:42:34.51,0:42:37.19,Default,,0,0,0,,Dia ringan.\NKamu akan membuatnya mabuk!
Dialog: 0,0:42:37.22,0:42:38.96,Default,,0,0,0,,Beom-ja.
Dialog: 0,0:42:39.09,0:42:40.32,Default,,0,0,0,,Ibu minum seperti ikan.
Dialogue: 0,0:42:40.34,0:42:44.71,Default,,0,0,0,,Itu fakta yang kita berdua tahu benar.
Dialogue: 0,0:42:45.35,0:42:46.91,Default,,0,0,0,,Menurutmu kenapa dia minum begitu banyak?
Dialogue: 0,0:42:46.93,0:42:49.93,Default,,0,0,0,,Karena wanita itu membuatnya stres!
Dialog: 0,0:42:50.23,0:42:51.33,Default,,0,0,0,,Paman.
Dialogue: 0,0:42:51.36,0:42:54.75,Default,,0,0,0,,Tidakkah kamu patah hati saat\Nmengetahui adikmu meninggal...
Dialogue: 0,0:42:54.78,0:42:57.71,Default,,0,0,0,,karena dia marah\Noleh wanita itu? Katakan sesuatu!
Dialogue: 0,0:42:57.74,0:43:00.13,Default,,0,0,0,,Beom-ja, bukan itu sebabnya dia meninggal.
Dialog: 0,0:43:00.16,0:43:03.30,Default,,0,0,0,,Dia meninggal karena serangan jantung.\NIitu terjadi dalam keluarga.
Dialog: 0,0:43:03.33,0:43:05.69,Default,,0,0,0,,- Anda juga harus berhati-hati.\N- Ya ampun.
Dialog: 0,0:43:05.83,0:43:07.53,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:43:08.12,0:43:10.12,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:43:15.13,0:43:16.27,Default,,0,0,0,,Bu.
Dialogue: 0,0:43:16.30,0:43:19.37,Default,,0,0,0,,Keluarga ini benar-benar bencana.
Dialog: 0,0:43:20.80,0:43:23.20,Default,,0,0,0,,Jangan repot-repot berkunjung.
Dialog: 0,0:43:23.22,0:43:26.05,Default,,0,0,0,,Saya akan minum alkohol.
Dialog: 0,0:43:26.72,0:43:28.68,Default,,0,0,0,,Kamu harus memutar balik.
Dialog: 0,0:43:29.94,0:43:33.15,Default,,0,0,0,,Tn. Hong, kamu akhirnya kembali setelah\N19 tahun. Maukah kamu bergabung kembali dengan Queens...?
Dialogue: 0,0:43:33.18,0:43:35.48,Default,,0,0,0,,Maukah kamu menghadiri upacara peringatan ibumu?
Dialogue: 0,0:43:35.51,0:43:37.09,Default,,0,0,0,,Maukah kamu bertemu Pimpinan Hong?
Dialogue: 0,0:43:37.11,0:43:39.44,Default,,0,0,0,,Sudahkah kalian berdamai?
Dialog: 0,0:43:49.79,0:43:52.18,Default,,0,0,0,,Silahkan duduk. Dia pada akhirnya akan pergi.
Dialogue: 0,0:43:52.21,0:43:54.20,Default,,0,0,0,,Itu sebabnya aku semakin membencinya.
Dialogue: 0,0:43:56.17,0:43:58.86,Default,,0,0,0,,Si brengsek itu tidak datang menemuiku.
Dialog: 0,0:43:58.88,0:44:01.07,Default,,0,0,0,,Dia datang untuk mengambil fotonya.
Dialog: 0,0:44:01.09,0:44:02.44,Default,,0,0,0,,Lihat dia.
Dialog: 0,0:44:02.47,0:44:06.24,Default,,0,0,0,,Dia sengaja berdiri\Ndi tengah hujan demi kamera.
Dialogue: 0,0:44:06.26,0:44:08.21,Default,,0,0,0,,Dasar brengsek.
Dialogue: 0,0:44:10.93,0:44:13.75,Default,,0,0,0,,Kamilah yang memasak semua pancake itu.
Dialogue: 0,0:44:13.77,0:44:15.08,Default,,0,0,0,,Apakah kamu melihat tanganku gemetar?
Dialogue: 0,0:44:15.11,0:44:17.32,Default,,0,0,0,,Tetapi mereka bahkan tidak mengizinkan\Nus untuk menghadiri kebaktian.
Dialogue: 0,0:44:17.35,0:44:20.26,Default,,0,0,0,,Akhir-akhir ini, aku menghabiskan banyak waktu\Non forum internet tentang ibu.
Dialog: 0,0:44:20.29,0:44:23.34,Default,,0,0,0,,Saya dapat memahami banyak postingan mereka.
Dialogue: 0,0:44:23.39,0:44:26.35,Default,,0,0,0,,Saya tidak ingat kapan terakhir kali\NI mengunjungi orang tua saya pada hari libur.
Dialogue: 0,0:44:26.37,0:44:28.41,Default,,0,0,0,,Mereka bilang akan membiarkan kita pergi setelah kita bersih-bersih.
Dialog: 0,0:44:28.44,0:44:30.16,Default,,0,0,0,,- "Tunggu bibi mertuamu."\N- Benar.
Dialog: 0,0:44:30.18,0:44:31.49,Default,,0,0,0,,"Tunggu paman mertuamu."
Dialog: 0,0:44:31.51,0:44:32.53,Default,,0,0,0,,"Potong beberapa apel."
Dialog: 0,0:44:32.56,0:44:33.73,Default,,0,0,0,,"Sajikan pancake."
Dialogue: 0,0:44:33.75,0:44:35.85,Default,,0,0,0,,Maksudku, bagaimana dengan keluarga kita?
Dialog: 0,0:44:35.88,0:44:38.06,Default,,0,0,0,,Hari ini adalah hari ulang tahun ayah Hyun-woo.
Dialog: 0,0:44:38.09,0:44:39.77,Default,,0,0,0,,Ini ulang tahunnya yang ke-60,
Dialog: 0,0:44:39.80,0:44:43.03,Default,,0,0,0,,tapi dia bisa mengunjunginya karena\Tidak ada upacara peringatan ini.
Dialogue: 0,0:44:43.05,0:44:45.95,Default,,0,0,0,,Pokoknya, aku paling kasihan padanya.
Dialogue: 0,0:44:45.97,0:44:47.20,Default,,0,0,0,,- Aku juga.\N- Aku juga.
Dialogue: 0,0:44:47.22,0:44:50.24,Default,,0,0,0,,Istri kita adalah sepupunya,\Ntapi dia menikah langsung. Astaga.
Dialogue: 0,0:44:50.27,0:44:51.97,Default,,0,0,0,,Mertuanya...
Dialogue: 0,0:44:52.14,0:44:53.20,Default,,0,0,0,,semuanya menakutkan.
Dialog: 0,0:44:53.23,0:44:55.35,Default,,0,0,0,,- {\i1}Ya.\N- Benar.{\i0}
Dialog: 0,0:44:55.44,0:44:57.22,Default,,0,0,0,,Direktur Jo.
Dialogue: 0,0:44:57.73,0:45:00.34,Default,,0,0,0,,Anda telah menghadiri\Nkebaktian peringatan selama 20 tahun hingga saat ini.
Dialogue: 0,0:45:00.36,0:45:03.96,Default,,0,0,0,,Dia selalu memperlakukanku dengan baik.\TTentu saja aku harus datang.
Dialog: 0,0:45:03.99,0:45:06.98,Default,,0,0,0,,Saya tahu Anda mengirimkan surat pengunduran diri Anda,
Dialog: 0,0:45:07.03,0:45:08.64,Default,,0,0,0,,tapi aku benar-benar tidak mau menerimanya.
Dialog: 0,0:45:08.67,0:45:11.60,Default,,0,0,0,,Saya berpikir panjang dan keras\Nsebelum mengambil keputusan itu.
Dialogue: 0,0:45:11.62,0:45:14.32,Default,,0,0,0,,Sebentar lagi aku akan terlalu tua untuk memulai awal yang baru.
Dialog: 0,0:45:14.67,0:45:17.53,Default,,0,0,0,,Oke. Kalau begitu, mau bagaimana lagi.
Dialogue: 0,0:45:19.09,0:45:20.69,Default,,0,0,0,,Aku akan selalu mendukungmu.
Dialog: 0,0:45:20.71,0:45:22.44,Default,,0,0,0,,Terima kasih banyak pak.
Dialog: 0,0:45:22.46,0:45:24.82,Default,,0,0,0,,Lihat dia. Aneh\Nbaginya untuk berhenti tiba-tiba.
Dialog: 0,0:45:24.84,0:45:26.28,Default,,0,0,0,,Saya yakin ada sesuatu yang terjadi.
Dialog: 0,0:45:26.30,0:45:28.46,Default,,0,0,0,,Aku akan memeriksanya diam-diam.
Dialog: 0,0:45:29.01,0:45:31.99,Default,,0,0,0,,Tidak, semua orang harus tahu tentang ini.
Dialog: 0,0:45:32.02,0:45:35.72,Default,,0,0,0,,Cari tahu apa yang dia lakukan dan biarkan\Nmedia melihatnya pergi ke pengadilan.
Dialogue: 0,0:45:35.81,0:45:38.01,Default,,0,0,0,,Tujuanku bukan untuk menghukumnya.
Dialog: 0,0:45:38.48,0:45:40.22,Default,,0,0,0,,Itu untuk mempermalukan dia.
Dialog: 0,0:45:41.36,0:45:44.85,Default,,0,0,0,,Mengapa kamu ingin melakukan itu?
Dialogue: 0,0:45:49.74,0:45:52.22,Default,,0,0,0,,Saya tidak pernah mengizinkan mereka yang\Nmengabaikan saya...
Dialog: 0,0:45:52.24,0:45:53.35,Default,,0,0,0,,untuk dibiarkan utuh.
Dialogue: 0,0:45:53.37,0:45:56.27,Default,,0,0,0,,Mereka harus menderita saat keluar,
Dialog: 0,0:45:56.29,0:45:59.12,Default,,0,0,0,,jadi tidak akan menimbulkan masalah lebih lanjut.
Dialog: 0,0:46:01.59,0:46:03.54,Default,,0,0,0,,Ada apa dengan wajahnya?
Dialogue: 0,0:46:04.05,0:46:06.25,Default,,0,0,0,,Ada yang ingin kamu sampaikan?
Dialog: 0,0:46:06.38,0:46:09.46,Default,,0,0,0,,Tapi dia mengabdikan bertahun-tahun padamu.
Dialog: 0,0:46:10.76,0:46:13.55,Default,,0,0,0,,Apakah benar memotongnya...
Dialogue: 0,0:46:14.18,0:46:16.51,Default,,0,0,0,,sangat brutal?
Dialog: 0,0:46:23.11,0:46:24.75,Default,,0,0,0,,Mungkin itu yang akan dia pikirkan,
Dialog: 0,0:46:24.78,0:46:26.09,Default,,0,0,0,,tapi itu pendapatnya.
Dialogue: 0,0:46:26.11,0:46:28.34,Default,,0,0,0,,Saya percaya sebuah organisasi harus mengikuti aturannya.
Dialog: 0,0:46:28.36,0:46:30.18,Default,,0,0,0,,Benar sekali.
Dialog: 0,0:46:30.20,0:46:34.26,Default,,0,0,0,,Bukan hanya dia. Saya mencari siapa saja\Nelse yang memiliki ide yang sama.
Dialog: 0,0:46:34.29,0:46:37.41,Default,,0,0,0,,Ini peringatan bagi mereka\Nyang ingin menikam saya dari belakang.
Dialog: 0,0:46:38.33,0:46:40.31,Default,,0,0,0,,- Ya, Pak.\N- Ingatlah hal itu.
Dialog: 0,0:46:40.33,0:46:43.87,Default,,0,0,0,,- Maaf?\N- Anda tidak boleh mengucapkan selamat tinggal...
Dialog: 0,0:46:43.96,0:46:45.71,Default,,0,0,0,,kepada mereka yang meninggalkanmu.
Dialogue: 0,0:46:47.42,0:46:49.88,Default,,0,0,0,,Kau harus menusuk mereka dari belakang.
Dialog: 0,0:46:50.84,0:46:52.55,Default,,0,0,0,,Ya pak.
Dialog: 0,0:46:53.43,0:46:55.13,Default,,0,0,0,,Bagus sekali.
Dialog: 0,0:46:55.35,0:46:57.09,Default,,0,0,0,,Istirahat.
Dialog: 0,0:47:00.48,0:47:01.62,Default,,0,0,0,,Ya pak.
Dialog: 0,0:47:01.65,0:47:03.35,Default,,0,0,0,,Selamat tinggal, kalau begitu.
Dialogue: 0,0:47:17.16,0:47:19.66,Default,,0,0,0,,{\i1}Aku tidak punya nafsu makan.{\i0}
Dialog: 0,0:47:20.25,0:47:24.41,Default,,0,0,0,,Rasanya nafsu makanku hilang sama sekali.
Dialogue: 0,0:47:24.71,0:47:28.08,Default,,0,0,0,,Sedih rasanya berada di dekat banyak orang.
Dialogue: 0,0:47:31.51,0:47:34.24,Default,,0,0,0,,Tingkat stresmu sepertinya sangat tinggi.
Dialog: 0,0:47:34.26,0:47:36.20,Default,,0,0,0,,Berdasarkan tes penyelesaian kalimatmu,
Dialogue: 0,0:47:36.22,0:47:38.70,Default,,0,0,0,,kamu menulis keinginan terbesarmu saat ini...
Dialog: 0,0:47:38.73,0:47:40.84,Default,,0,0,0,,akan bercerai.
Dialog: 0,0:47:40.89,0:47:44.10,Default,,0,0,0,,- Benar.\N- Begitu... Dan kenapa begitu?
Dialog: 0,0:47:44.65,0:47:49.48,Default,,0,0,0,,Saya tinggal bersama mertua saya...
Dialogue: 0,0:47:49.57,0:47:51.77,Default,,0,0,0,,dan kakek mertuaku.
Dialog: 0,0:47:52.07,0:47:53.22,Default,,0,0,0,,Dan dia.
Dialog: 0,0:47:53.24,0:47:55.26,Default,,0,0,0,,Serta bibi mertuaku yang baru saja keluar dari rumah sakit,
Dialog: 0,0:47:55.28,0:47:56.93,Default,,0,0,0,,dan keluarga kakak iparku.
Dialogue: 0,0:47:56.95,0:47:58.74,Default,,0,0,0,,Kita semua hidup...
Dialog: 0,0:47:59.54,0:48:01.45,Default,,0,0,0,,di bawah satu atap.
Dialog: 0,0:48:02.79,0:48:04.62,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:48:04.92,0:48:08.40,Default,,0,0,0,,Jarang melihat keluarga besar\Nhari-hari ini. Anda diberkati.
Dialogue: 0,0:48:08.42,0:48:11.11,Default,,0,0,0,,Kami sangat diberkati karena kami\Nmakan malam bersama setiap malam.
Dialog: 0,0:48:11.13,0:48:14.32,Default,,0,0,0,,Lalu kita berkumpul jam 9 malam. untuk berbicara.
Dialogue: 0,0:48:14.34,0:48:15.61,Default,,0,0,0,,Rapat akhir hari.
Dialog: 0,0:48:15.64,0:48:17.78,Default,,0,0,0,,Akhir pekan, hari libur,\Nulang tahun, dan Natal.
Dialogue: 0,0:48:17.81,0:48:21.58,Default,,0,0,0,,Kita habiskan bersama-sama sepanjang\Ntahun. Aman untuk mengatakan...
Dialog: 0,0:48:21.60,0:48:23.89,Default,,0,0,0,,Aku tidak punya waktu untuk diriku sendiri.
Dialog: 0,0:48:25.52,0:48:27.71,Default,,0,0,0,,Kami memiliki 15 upacara peringatan per tahun.
Dialogue: 0,0:48:27.73,0:48:29.54,Default,,0,0,0,,Mereka bilang keluarga bangsawan di masa lalu...
Dialog: 0,0:48:29.57,0:48:32.26,Default,,0,0,0,,membuat anggota laki-lakinya\Nbersiap untuk layanan,
Dialog: 0,0:48:32.28,0:48:35.68,Default,,0,0,0,,jadi menantu mempersiapkan\Nuntuk seluruh layanan,
Dialog: 0,0:48:35.70,0:48:39.69,Default,,0,0,0,,tapi putra mereka tidak pernah membantu.
Dialog: 0,0:48:41.20,0:48:43.03,Default,,0,0,0,,Rasanya seperti...
Dialogue: 0,0:48:43.37,0:48:46.87,Default,,0,0,0,,kamu memerlukan tempat di mana\Nkamu bisa jauh dari mereka.
Dialog: 0,0:48:47.38,0:48:49.73,Default,,0,0,0,,Apakah kamu punya pekerjaan?
Dialog: 0,0:48:49.76,0:48:51.82,Default,,0,0,0,,- Ya.\N- Bagus.
Dialogue: 0,0:48:51.84,0:48:52.98,Default,,0,0,0,,Bagaimana kehidupan kerjamu?
Dialog: 0,0:48:53.01,0:48:54.83,Default,,0,0,0,,Istriku adalah bosku,
Dialog: 0,0:48:55.89,0:48:58.00,Default,,0,0,0,,dan ayah mertuaku adalah bosnya.
Dialog: 0,0:48:58.31,0:49:00.41,Default,,0,0,0,,Lalu kakek mertuaku...
Dialog: 0,0:49:00.43,0:49:02.18,Default,,0,0,0,,adalah bosnya.
Dialogue: 0,0:49:02.68,0:49:05.25,Default,,0,0,0,,Jantungku berdebar kencang, dan tanganku gemetar...
Dialogue: 0,0:49:05.27,0:49:06.83,Default,,0,0,0,,setiap kali mertuaku menelepon.
Dialogue: 0,0:49:06.86,0:49:09.64,Default,,0,0,0,,Aku cemas dengan apa yang akan mereka minta dariku.
Dialogue: 0,0:49:09.86,0:49:13.09,Default,,0,0,0,,Mengapa kamu tidak menjauhkan diri\Ndari lingkungan yang penuh tekanan ini?
Dialog: 0,0:49:13.11,0:49:14.59,Default,,0,0,0,,Maka perceraian adalah satu-satunya pilihan.
Dialogue: 0,0:49:14.61,0:49:16.34,Default,,0,0,0,,Kamu bisa pindah bersama istrimu.
Dialogue: 0,0:49:16.37,0:49:19.32,Default,,0,0,0,,Memang benar aku tidak menyukai mertuaku. Namun...
Dialog: 0,0:49:19.62,0:49:21.72,Default,,0,0,0,,Aku semakin membenci istriku.
Dialog: 0,0:49:21.75,0:49:22.85,Default,,0,0,0,,Mengapa demikian?
Dialog: 0,0:49:22.87,0:49:24.66,Default,,0,0,0,,Dia tidak peduli...
Dialog: 0,0:49:24.79,0:49:27.94,Default,,0,0,0,,semua tentang saya, atau bagaimana keluarganya memperlakukan saya.
Dialogue: 0,0:49:27.96,0:49:31.11,Default,,0,0,0,,Dia hanya peduli pada dirinya sendiri. Bukankah dia egois?
Dialogue: 0,0:49:31.13,0:49:33.48,Default,,0,0,0,,Aku menikah dengan keluarga ini hanya karena dia,
Dialogue: 0,0:49:33.51,0:49:36.00,Default,,0,0,0,,dan menjalani perawatan ini selama tiga tahun,
Dialog: 0,0:49:36.76,0:49:38.45,Default,,0,0,0,,tapi dia tidak peduli.
Dialogue: 0,0:49:38.47,0:49:41.99,Default,,0,0,0,,Sebelum kita menikah,\Ndia bilang aku bisa mempercayainya.
Dialog: 0,0:49:42.02,0:49:43.93,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hanya aku yang kamu perlukan.{\c}{\i0}
Dialog: 0,0:49:43.98,0:49:45.68,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Percaya saja padaku.{\c}{\i0}
Dialogue: 0,0:49:45.73,0:49:48.01,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku tidak akan pernah...{\c}{\i0}
Dialog: 0,0:49:48.27,0:49:50.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}membuatmu menangis.{\c}{\i0}
Dialogue: 0,0:49:59.07,0:50:01.34,Default,,0,0,0,,Aku idiot karena memercayainya.
Dialogue: 0,0:50:01.37,0:50:04.07,Default,,0,0,0,,Apakah kamu terluka dan kesal padanya?
Dialog: 0,0:50:05.54,0:50:06.52,Default,,0,0,0,,Tidak.
Dialog: 0,0:50:06.54,0:50:08.52,Default,,0,0,0,,Saya tidak lagi merasa seperti itu.
Dialog: 0,0:50:08.54,0:50:10.20,Default,,0,0,0,,Aku hanya membencinya.
Dialogue: 0,0:50:10.38,0:50:12.08,Default,,0,0,0,,Aku benci dia...
Dialog: 0,0:50:12.34,0:50:13.98,Default,,0,0,0,,dengan penuh semangat.
Dialog: 0,0:50:14.01,0:50:15.53,Default,,0,0,0,,Dan itulah mengapa kamu ingin bercerai.
Dialogue: 0,0:50:15.55,0:50:17.28,Default,,0,0,0,,Itulah satu-satunya cara agar aku bisa hidup.
Dialog: 0,0:50:17.30,0:50:19.21,Default,,0,0,0,,Lalu kenapa belum?
Dialog: 0,0:50:20.60,0:50:22.41,Default,,0,0,0,,Karena aku bisa mati.
Dialog: 0,0:50:22.43,0:50:23.49,Default,,0,0,0,,Apa?
Dialogue: 0,0:50:23.52,0:50:25.20,Default,,0,0,0,,Ayah mertuaku...
Dialogue: 0,0:50:25.23,0:50:27.76,Default,,0,0,0,,paling benci kalau rakyatnya...
Dialogue: 0,0:50:28.69,0:50:31.29,Default,,0,0,0,,berpaling dari dia.
Dialog: 0,0:50:31.31,0:50:33.21,Default,,0,0,0,,Saat aku menceraikannya,
Dialog: 0,0:50:33.23,0:50:34.79,Default,,0,0,0,,dia akan menusukku dari belakang.
Dialogue: 0,0:50:34.82,0:50:35.88,Default,,0,0,0,,Menusukmu?
Dialogue: 0,0:50:35.90,0:50:38.48,Default,,0,0,0,,Tentu saja itu kiasan,
Dialogue: 0,0:50:40.37,0:50:43.28,Default,,0,0,0,,tapi ditusuk mungkin lebih baik.
Dialog: 0,0:50:55.13,0:50:59.42,Default,,0,0,0,,Saya akan meresepkan Anda sesuatu yang kuat, jadi ambillah.
Dialog: 0,0:50:59.97,0:51:01.67,Default,,0,0,0,,Bertahanlah.
Dialog: 0,0:51:13.32,0:51:15.06,Default,,0,0,0,,Selamat tinggal.
Dialog: 0,0:51:27.45,0:51:29.45,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Istri{\c}{\i0}
Dialog: 0,0:51:35.05,0:51:36.15,Default,,0,0,0,,Aku cinta kamu, Sayang.
Dialogue: 0,0:51:36.17,0:51:37.86,Default,,0,0,0,,Aku sungguh merasa bahagia.
Dialog: 0,0:51:37.88,0:51:40.25,Default,,0,0,0,,Saya tidak melakukan apa pun.
Dialogue: 0,0:51:40.47,0:51:42.53,Default,,0,0,0,,Aku sangat bersyukur...
Dialog: 0,0:51:42.55,0:51:44.25,Default,,0,0,0,,Halo?
Dialog: 0,0:51:50.81,0:51:52.51,Default,,0,0,0,,Saya sangat senang.
Dialog: 0,0:51:54.44,0:51:55.75,Default,,0,0,0,,Tunggu, Grace.
Dialogue: 0,0:51:55.77,0:51:58.09,Default,,0,0,0,,Kenapa kamu tidak mengatakan apa-apa?
Dialogue: 0,0:51:58.11,0:52:00.17,Default,,0,0,0,,Anda harus bertanggung jawab untuk mengatakan...
Dialog: 0,0:52:00.20,0:52:02.80,Default,,0,0,0,,pewaris ketiga Grup Jinseong adalah yang sebenarnya.
Dialog: 0,0:52:02.82,0:52:04.72,Default,,0,0,0,,Mengapa saya harus melakukan itu?
Dialogue: 0,0:52:04.74,0:52:07.93,Default,,0,0,0,,Kudengar kamu memilih putra tertua mereka.\NPergilah ke kencan buta itu.
Dialog: 0,0:52:07.95,0:52:09.43,Default,,0,0,0,,Tapi ketua tidak menyukainya,
Dialog: 0,0:52:09.46,0:52:11.24,Default,,0,0,0,,jadi bagaimana aku bisa menjodohkan putriku dengannya,
Dialog: 0,0:52:11.26,0:52:14.10,Default,,0,0,0,,ketika saya mendengar putra\Nketiganya akan mewarisi segalanya?
Dialogue: 0,0:52:14.13,0:52:16.35,Default,,0,0,0,,Kamu seharusnya datang kepadaku dulu.
Dialogue: 0,0:52:16.38,0:52:19.03,Default,,0,0,0,,Kamu sudah menyiapkan kencan buta\N dengan putra sulung, bajingan,
Dialog: 0,0:52:19.06,0:52:20.61,Default,,0,0,0,,jadi apa yang bisa kulakukan?
Dialog: 0,0:52:20.63,0:52:22.61,Default,,0,0,0,,Kamu harus pergi ke mak comblang itu.
Dialog: 0,0:52:22.63,0:52:24.49,Default,,0,0,0,,Saya berada dalam dilema.
Dialogue: 0,0:52:24.51,0:52:28.42,Default,,0,0,0,,Pilihan apa yang saya punya ketika\NI mendengar Anda tidak kompeten lagi?
Dialog: 0,0:52:34.40,0:52:35.46,Default,,0,0,0,,Apa katamu?
Dialogue: 0,0:52:35.48,0:52:37.58,Default,,0,0,0,,Jadi bagaimana jika kamu melayani para wanita Ratu?
Dialogue: 0,0:52:37.61,0:52:41.75,Default,,0,0,0,,Anda boleh mengawasi urusan rumah tangga mereka,\Ntapi putri Anda masih lajang.
Dialog: 0,0:52:41.78,0:52:43.63,Default,,0,0,0,,Itulah sebabnya...
Dialog: 0,0:52:43.66,0:52:47.05,Default,,0,0,0,,Hong Hae-in menyesal tidak mendengarkan\Naku, dan menikahi suaminya yang sekarang.
Dialog: 0,0:52:47.08,0:52:48.82,Default,,0,0,0,,Serius?
Dialogue: 0,0:52:48.91,0:52:51.03,Default,,0,0,0,,Apakah mereka akan bercerai?
Dialogue: 0,0:52:52.21,0:52:54.77,Default,,0,0,0,,Kamu tidak bisa bersama seseorang\Nyang berada di luar kemampuanmu.
Dialogue: 0,0:52:54.79,0:52:57.08,Default,,0,0,0,,Tiga tahun sudah cukup.
Dialog: 0,0:52:57.21,0:52:58.27,Default,,0,0,0,,Tunggu dan lihat saja.
Dialogue: 0,0:52:58.30,0:52:59.94,Default,,0,0,0,,Bahkan Hong Hae-in yang hebat...
Dialog: 0,0:52:59.96,0:53:03.75,Default,,0,0,0,,akan mendengarkanku saat dia ingin menikah lagi.
Dialog: 0,0:53:18.44,0:53:20.22,Default,,0,0,0,,Ms. Hong!
Dialog: 0,0:53:25.57,0:53:28.43,Default,,0,0,0,,Ibumu mampir ke spa kami pagi ini.
Dialog: 0,0:53:28.45,0:53:31.49,Default,,0,0,0,,Sudah kubilang mampir. Kenapa tidak?
Dialogue: 0,0:53:33.00,0:53:35.99,Default,,0,0,0,,Apakah kamu stres akhir-akhir ini?
Dialogue: 0,0:53:36.50,0:53:38.44,Default,,0,0,0,,Kulitmu terlihat kusam.
Dialogue: 0,0:53:38.46,0:53:41.86,Default,,0,0,0,,Kami punya serum dan mesin yang bagus.
Dialogue: 0,0:53:41.88,0:53:44.86,Default,,0,0,0,,Aku akan mengosongkan jadwal kita, jadi mampirlah.
Dialog: 0,0:53:44.88,0:53:46.94,Default,,0,0,0,,Anda pasti sibuk, jadi tidak perlu melakukan itu.
Dialog: 0,0:53:46.97,0:53:48.79,Default,,0,0,0,,Kami tidak sibuk.
Dialogue: 0,0:53:49.72,0:53:54.49,Default,,0,0,0,,Kamu sangat mengkhawatirkanku!
Dialog: 0,0:53:54.52,0:53:55.58,Default,,0,0,0,,Tidak, saya tidak.
Dialog: 0,0:53:55.60,0:53:57.39,Default,,0,0,0,,Apa?
Dialogue: 0,0:53:58.15,0:54:02.31,Default,,0,0,0,,Aku hanya bilang aku tidak akan pernah mengunjungi spamu.
Dialogue: 0,0:54:05.32,0:54:08.06,Default,,0,0,0,,Kamu kedinginan sekali.
Dialogue: 0,0:54:09.28,0:54:11.73,Default,,0,0,0,,Kau membuatku merasa jauh.
Dialogue: 0,0:54:13.04,0:54:16.03,Default,,0,0,0,,Kamu seharusnya merasa seperti itu.
Dialogue: 0,0:54:16.75,0:54:18.02,Default,,0,0,0,,Kamu pasti mentraktirku...
Dialog: 0,0:54:18.04,0:54:21.10,Default,,0,0,0,,seperti teman karena menurutmu kita dekat.
Dialog: 0,0:54:21.13,0:54:24.41,Default,,0,0,0,,Saya harap Anda lebih\Nberhati-hati. Ini tidak nyaman.
Dialog: 0,0:54:24.46,0:54:26.17,Default,,0,0,0,,Tapi...
Dialogue: 0,0:54:31.64,0:54:34.08,Default,,0,0,0,,{\i1}Dia pemarah.{\i0}
Dialogue: 0,0:54:34.10,0:54:38.05,Default,,0,0,0,,Dia sangat menjengkelkan. Apakah kamu tidak setuju?
Dialog: 0,0:54:39.60,0:54:41.71,Default,,0,0,0,,Pewaris ketiga Grup Jinseong...
Dialogue: 0,0:54:41.73,0:54:43.21,Default,,0,0,0,,adalah makanan vegan saat ini.
Dialogue: 0,0:54:43.23,0:54:46.81,Default,,0,0,0,,Sebuah forum vegan akan diadakan\Nat di hotel mereka Jumat depan.
Dialog: 0,0:54:46.99,0:54:48.34,Default,,0,0,0,,Bawa putrimu ke sana.
Dialog: 0,0:54:48.36,0:54:50.56,Default,,0,0,0,,- Saya akan mencoba menyiapkannya.\N- Benarkah?
Dialog: 0,0:54:50.82,0:54:52.53,Default,,0,0,0,,Kamu bisa pergi sekarang.
Dialog: 0,0:54:52.95,0:54:55.44,Default,,0,0,0,,Ada yang harus kulakukan.
Dialogue: 0,0:54:55.58,0:54:56.64,Default,,0,0,0,,Aku mengetahuinya.
Dialogue: 0,0:54:56.66,0:54:59.37,Default,,0,0,0,,Aku percaya padamu, Grace.
Dialog: 0,0:55:04.55,0:55:06.73,Default,,0,0,0,,Anda lihat,
Dialogue: 0,0:55:06.76,0:55:09.03,Default,,0,0,0,,Saya pernah berkecimpung di industri kecantikan...
Dialogue: 0,0:55:09.05,0:55:12.91,Default,,0,0,0,,dan menjodohkan keluarga kaya...
Dialog: 0,0:55:12.93,0:55:14.32,Default,,0,0,0,,sepanjang hidupku,
Dialog: 0,0:55:14.35,0:55:16.95,Default,,0,0,0,,jadi saya tidak tahu banyak tentang masalah hukum.
Dialog: 0,0:55:16.98,0:55:18.76,Default,,0,0,0,,Saya mengerti. Tentang apa ini?
Dialog: 0,0:55:21.60,0:55:22.67,Default,,0,0,0,,Saya yakin Anda pernah mendengarnya...
Dialogue: 0,0:55:22.69,0:55:26.29,Default,,0,0,0,,bahwa putra bungsu Daegyeong\Nmeninggal karena kecelakaan mobil.
Dialogue: 0,0:55:26.32,0:55:27.38,Default,,0,0,0,,Ya.
Dialog: 0,0:55:27.40,0:55:29.05,Default,,0,0,0,,Sepertinya...
Dialog: 0,0:55:29.07,0:55:32.43,Default,,0,0,0,,istrinya tidak akan mewarisi kekayaannya.
Dialog: 0,0:55:32.45,0:55:35.47,Default,,0,0,0,,Ternyata suaminya sudah menulis surat wasiat...
Dialogue: 0,0:55:35.49,0:55:37.51,Default,,0,0,0,,sebelum mereka menikah.
Dialogue: 0,0:55:37.54,0:55:40.64,Default,,0,0,0,,Dia bilang anak, keponakan, atau keponakannya...
Dialog: 0,0:55:40.67,0:55:43.06,Default,,0,0,0,,harus mewarisi kekayaannya jika dia meninggal,
Dialog: 0,0:55:43.08,0:55:45.79,Default,,0,0,0,,tapi pasangan itu tidak pernah punya anak.
Dialog: 0,0:55:46.00,0:55:47.02,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,0:55:47.05,0:55:48.86,Default,,0,0,0,,Dalam hal ini, istri dapat menuntut...
Dialog: 0,0:55:48.88,0:55:51.32,Default,,0,0,0,,cadangan sah\Ninheritance dan mengajukan gugatan.
Dialog: 0,0:55:51.34,0:55:54.75,Default,,0,0,0,,Saya bisa memperkenalkan Anda kepada seorang pengacara jika Anda mau.
Dialogue: 0,0:55:55.06,0:55:58.45,Default,,0,0,0,,Untuk apa? aku punya kamu.
Dialog: 0,0:55:58.48,0:55:59.95,Default,,0,0,0,,Anda berada di situasi yang sama.
Dialog: 0,0:55:59.98,0:56:01.20,Default,,0,0,0,,Maaf?
Dialog: 0,0:56:01.23,0:56:05.51,Default,,0,0,0,,Ms. Hong juga menulis surat wasiat sebelum dia menikah.
Dialog: 0,0:56:06.98,0:56:08.68,Default,,0,0,0,,Tahukah kamu?
Dialogue: 0,0:56:08.94,0:56:10.25,Default,,0,0,0,,Kamu pasti berpikir...
Dialogue: 0,0:56:10.28,0:56:12.01,Default,,0,0,0,,perjanjian pranikah itu.
Dialog: 0,0:56:12.03,0:56:14.38,Default,,0,0,0,,Aku tidak percaya dia tidak memberitahumu.
Dialogue: 0,0:56:14.41,0:56:17.14,Default,,0,0,0,,Dia tidak berperasaan.
Dialogue: 0,0:56:17.16,0:56:19.01,Default,,0,0,0,,{\i1}Surat wasiat mengatakan bahwa Ratu...{\i0}
Dialogue: 0,0:56:19.04,0:56:22.43,Default,,0,0,0,,{\i1}akan mewarisi seluruh uang tunai,\Nsaham, dan real estatnya...{\i0}
Dialog: 0,0:56:22.46,0:56:23.98,Default,,0,0,0,,jika sesuatu terjadi padanya.
Dialog: 0,0:56:24.00,0:56:26.98,Default,,0,0,0,,Dia bilang kamu tidak akan mendapatkan apa pun.
Dialog: 0,0:56:27.00,0:56:30.11,Default,,0,0,0,,Dia menulisnya dengan sangat detail.
Dialog: 0,0:56:30.13,0:56:34.92,Default,,0,0,0,,Kami menggunakannya sebagai templat untuk semua surat wasiat di masa depan.
Dialogue: 0,0:56:37.60,0:56:39.16,Default,,0,0,0,,Ada apa dengan wajah itu?
Dialogue: 0,0:56:39.18,0:56:42.16,Default,,0,0,0,,Apa menurutmu ini adalah\Npernikahan abad ini...
Dialog: 0,0:56:42.19,0:56:44.71,Default,,0,0,0,,yang melampaui semua latar belakang,
Dialog: 0,0:56:44.73,0:56:46.71,Default,,0,0,0,,seperti yang diklaim media?
Dialogue: 0,0:56:46.73,0:56:49.13,Default,,0,0,0,,Jangan terlalu naif.
Dialog: 0,0:56:49.15,0:56:52.76,Default,,0,0,0,,Ms. Hong tidak menginginkan seorang suami.
Dialogue: 0,0:56:52.78,0:56:55.76,Default,,0,0,0,,Dia menginginkan seorang budak yang bisa\Natambahkan ke daftar keluarga,
Dialogue: 0,0:56:55.78,0:56:57.97,Default,,0,0,0,,dan saat itulah kamu muncul.
Dialogue: 0,0:56:57.99,0:57:02.77,Default,,0,0,0,,Kamu tampan dan cerdas.\NIItu adalah PR terbaik yang bisa dia dapatkan.
Dialogue: 0,0:57:02.79,0:57:04.89,Default,,0,0,0,,Kamu patuh sesuai keinginannya.
Dialog: 0,0:57:04.92,0:57:07.90,Default,,0,0,0,,Satu-satunya masalah adalah perselisihan kekayaan,
Dialog: 0,0:57:07.92,0:57:11.16,Default,,0,0,0,,tapi itu terpecahkan, berkat kemauan.
Dialog: 0,0:57:11.42,0:57:13.12,Default,,0,0,0,,Cukup.
Dialog: 0,0:57:14.47,0:57:16.17,Default,,0,0,0,,Oke.
Dialog: 0,0:57:16.68,0:57:18.38,Default,,0,0,0,,Halo, Profesor.
Dialogue: 0,0:57:19.97,0:57:24.05,Default,,0,0,0,,Bisakah Anda mengirimkannya lewat email ke saya?\NI tidak punya waktu ke sana.
Dialogue: 0,0:57:43.91,0:57:45.99,Default,,0,0,0,,Kenapa kamu tidak mengangkatnya?
Dialog: 0,0:57:47.92,0:57:49.99,Default,,0,0,0,,Kita harus pergi ke suatu tempat.
Dialogue: 0,0:57:50.55,0:57:53.77,Default,,0,0,0,,Aku tahu kamu ada waktu luang hari ini. Saya sudah memeriksa.
Dialog: 0,0:57:53.80,0:57:55.79,Default,,0,0,0,,Mobil menunggu di bawah.
Dialog: 0,0:57:57.89,0:57:59.59,Default,,0,0,0,,Saya tidak akan pergi.
Dialog: 0,0:58:01.81,0:58:03.70,Default,,0,0,0,,Aku bahkan tidak memberitahumu kemana tujuan kita.
Dialog: 0,0:58:03.73,0:58:05.55,Default,,0,0,0,,Tidak masalah.
Dialog: 0,0:58:05.85,0:58:08.47,Default,,0,0,0,,Aku menolak pergi kemana pun bersamamu.
Dialogue: 0,0:58:41.64,0:58:43.53,Default,,0,0,0,,{\i1}{\c&HFFFF&}Si Keajaiban Yongdu-ri, Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:58:43.56,0:58:46.05,Default,,0,0,0,,"Keajaiban"? Itu sudah terjadi berabad-abad yang lalu.
Dialog: 0,0:58:52.48,0:58:54.13,Default,,0,0,0,,Jadi...
Dialogue: 0,0:58:54.15,0:58:55.79,Default,,0,0,0,,ini pendapat Yongdu-ri.
Dialogue: 0,0:58:55.82,0:58:57.84,Default,,0,0,0,,Mereka tidak keberatan Anda menjalani masa jabatan berturut-turut.
Dialog: 0,0:58:57.86,0:59:00.38,Default,,0,0,0,,Itu pendapat umum.
Dialog: 0,0:59:00.41,0:59:03.80,Default,,0,0,0,,Mampir ke tokoku nanti untuk camilan.\NT{\i1}makgeolli{\i0} yang baru rasanya enak.
Dialog: 0,0:59:03.83,0:59:04.89,Default,,0,0,0,,Lagi?
Dialog: 0,0:59:04.91,0:59:07.11,Default,,0,0,0,,- Kamu selalu murah hati.\N- Astaga.
Dialogue: 0,0:59:07.29,0:59:11.14,Default,,0,0,0,,Kuharap aku bisa memberimu\Nsesuatu yang lebih baik, tapi ada...
Dialog: 0,0:59:11.17,0:59:13.02,Default,,0,0,0,,Permintaan dan Tindakan Korupsi yang Tidak Benar.
Dialog: 0,0:59:13.04,0:59:14.69,Default,,0,0,0,,Kepala desa juga pekerjaan negara,
Dialog: 0,0:59:14.71,0:59:17.07,Default,,0,0,0,,jadi saya tidak bisa terlalu murah hati.
Dialog: 0,0:59:17.09,0:59:18.40,Default,,0,0,0,,Astaga, aku selalu bersyukur.
Dialogue: 0,0:59:18.42,0:59:19.74,Default,,0,0,0,,Kamu sudah melakukan cukup banyak.
Dialog: 0,0:59:19.76,0:59:21.33,Default,,0,0,0,,- Anda mengerti, kan?\N- Tentu saja.
Dialog: 0,0:59:21.35,0:59:23.22,Default,,0,0,0,,Ya ampun, Nona Jeon.
Dialog: 0,0:59:24.01,0:59:25.76,Default,,0,0,0,,Halo.
Dialog: 0,0:59:26.14,0:59:27.87,Default,,0,0,0,,- Astaga.\N- Hei.
Dialog: 0,0:59:27.89,0:59:29.58,Default,,0,0,0,,Apakah macet lagi?
Dialogue: 0,0:59:29.60,0:59:32.12,Default,,0,0,0,,Dasar idiot. Bagaimana Anda bisa menyebut diri Anda petani?
Dialog: 0,0:59:32.15,0:59:34.21,Default,,0,0,0,,Bagaimana caramu mendapatkan penggarap...
Dialog: 0,0:59:34.23,0:59:35.67,Default,,0,0,0,,macet setiap saat?
Dialogue: 0,0:59:35.69,0:59:37.13,Default,,0,0,0,,Kenapa lama sekali?
Dialog: 0,0:59:37.15,0:59:38.21,Default,,0,0,0,,Saya...
Dialogue: 0,0:59:38.24,0:59:41.06,Default,,0,0,0,,Aku bukan 119. Aku tidak selalu bisa langsung datang.
Dialog: 0,0:59:45.83,0:59:47.72,Default,,0,0,0,,Istri saya biasa mengemudikan seorang kultivator...
Dialog: 0,0:59:47.75,0:59:50.14,Default,,0,0,0,,dan tangkap gurita kecil di\NBeolgyo, Provinsi Jeolla...
Dialogue: 0,0:59:50.16,0:59:52.56,Default,,0,0,0,,sebelum menikah denganku.
Dialogue: 0,0:59:52.58,0:59:54.91,Default,,0,0,0,,Dia benar-benar hebat.
Dialogue: 0,0:59:57.88,0:59:59.83,Default,,0,0,0,,Berhasil!
Dialogue: 0,1:00:01.22,1:00:03.49,Default,,0,0,0,,Astaga, cuacanya bagus sekali.
Dialog: 0,1:00:03.51,1:00:05.30,Default,,0,0,0,,Apa? Hai.
Dialog: 0,1:00:05.56,1:00:08.70,Default,,0,0,0,,Yeong-cheol! Bagaimana kondisi lutut ibumu?
Dialogue: 0,1:00:08.73,1:00:10.04,Default,,0,0,0,,Mereka sama saja!
Dialog: 0,1:00:10.06,1:00:12.12,Default,,0,0,0,,Itulah sebabnya dia perlu mengonsumsi glukosamin!
Dialog: 0,1:00:12.15,1:00:14.64,Default,,0,0,0,,- Duduk!\N- Oke.
Dialogue: 0,1:00:15.36,1:00:17.75,Default,,0,0,0,,Bukankah anakmu akan segera mengikuti ujian tengah semester?
Dialog: 0,1:00:17.78,1:00:20.00,Default,,0,0,0,,Apa urusannya denganku? Itu pekerjaannya.
Dialog: 0,1:00:20.03,1:00:21.59,Default,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:00:21.61,1:00:25.09,Default,,0,0,0,,Meski begitu, kamu harus membantunya menghafal!
Dialog: 0,1:00:25.12,1:00:29.65,Default,,0,0,0,,Saat Hyun-woo pergi ke SNU,\NI membantunya siang dan malam...
Dialogue: 0,1:00:34.00,1:00:36.23,Default,,0,0,0,,Kenapa tiba-tiba kamu ngebut?
Dialogue: 0,1:00:36.25,1:00:38.58,Default,,0,0,0,,Sudah kubilang duduk ya?
Dialogue: 0,1:00:38.76,1:00:43.03,Default,,0,0,0,,Mereka mungkin terlihat seperti petani\N biasa, tapi mereka lebih dari itu.
Dialog: 0,1:00:43.05,1:00:45.70,Default,,0,0,0,,Mereka semua adalah pemilih.
Dialog: 0,1:00:45.72,1:00:48.49,Default,,0,0,0,,Pemilihan ulang sudah dekat\Nsudah dekat. Anda tidak tahu apa-apa.
Dialog: 0,1:00:48.51,1:00:50.20,Default,,0,0,0,,Pemilihan ulang, kakiku.
Dialog: 0,1:00:50.22,1:00:52.62,Default,,0,0,0,,Kita harus menjaga hutan dan toko kita.
Dialogue: 0,1:00:52.64,1:00:54.79,Default,,0,0,0,,Kita sudah banyak melakukan juggling.
Dialogue: 0,1:00:54.81,1:00:56.71,Default,,0,0,0,,Bukankah sudah kubilang berkali-kali...
Dialogue: 0,1:00:56.73,1:00:58.29,Default,,0,0,0,,untuk menyerahkan posisimu?
Dialog: 0,1:00:58.32,1:00:59.38,Default,,0,0,0,,Sayang.
Dialog: 0,1:00:59.40,1:01:01.42,Default,,0,0,0,,Saya hanya melakukan ini demi keseimbangan.
Dialogue: 0,1:01:01.44,1:01:03.60,Default,,0,0,0,,- Saldo berapa?\N- Dengarkan aku.
Dialog: 0,1:01:03.95,1:01:07.80,Default,,0,0,0,,Mertua Hyun-woo mungkin adalah\Npilar perekonomian negara ini,
Dialog: 0,1:01:07.83,1:01:10.01,Default,,0,0,0,,tetapi mereka tidak memiliki banyak kekuatan politik.
Dialogue: 0,1:01:10.04,1:01:12.01,Default,,0,0,0,,Keluarga kita hanya bisa memiliki keseimbangan...
Dialog: 0,1:01:12.04,1:01:13.93,Default,,0,0,0,,karena saya mempertahankan...
Dialog: 0,1:01:13.96,1:01:16.62,Default,,0,0,0,,jabatan penting saya sebagai kepala desa.
Dialog: 0,1:01:17.71,1:01:20.48,Default,,0,0,0,,Kenapa kamu berhenti sekarang?
Dialog: 0,1:01:20.51,1:01:22.87,Default,,0,0,0,,- Hyun-woo!\N- Apa?
Dialog: 0,1:01:29.72,1:01:31.49,Default,,0,0,0,,Kamu bahkan tidak menelepon.
Dialog: 0,1:01:31.52,1:01:32.83,Default,,0,0,0,,Saya pikir saya akan berkunjung.
Dialog: 0,1:01:32.85,1:01:34.37,Default,,0,0,0,,Di mana Hae-in?
Dialog: 0,1:01:34.39,1:01:36.68,Default,,0,0,0,,Apakah kamu di sini sendirian lagi?
Dialog: 0,1:01:39.69,1:01:41.50,Default,,0,0,0,,Apakah kamu sudah makan?
Dialog: 0,1:01:41.53,1:01:43.69,Default,,0,0,0,,Belum.
Dialog: 0,1:01:44.03,1:01:45.73,Default,,0,0,0,,Oke.
Dialog: 0,1:01:54.91,1:01:56.66,Default,,0,0,0,,Ini terlihat matang.
Dialog: 0,1:01:58.50,1:01:59.98,Default,,0,0,0,,Minggir.
Dialog: 0,1:02:00.00,1:02:02.36,Default,,0,0,0,,Mari kita lihat.
Dialog: 0,1:02:02.38,1:02:05.75,Default,,0,0,0,,Pindah. Putra bungsu saya ada di sini.
Dialog: 0,1:02:18.81,1:02:21.06,Default,,0,0,0,,Astaga, kamu pasti lapar.
Dialog: 0,1:02:29.57,1:02:31.28,Default,,0,0,0,,Luangkan waktumu.
Dialog: 0,1:02:39.21,1:02:41.16,Default,,0,0,0,,Baguskah?
Dialog: 0,1:03:20.37,1:03:22.16,Default,,0,0,0,,Ya, saya sibuk. Mengapa?
Dialog: 0,1:03:24.59,1:03:25.98,Default,,0,0,0,,Hyun-woo ada di sini?
Dialog: 0,1:03:26.01,1:03:27.87,Default,,0,0,0,,Satu menit.
Dialog: 0,1:03:28.59,1:03:31.24,Default,,0,0,0,,{\i1}{\c&HFFFF&}Salon Rambut Ratu{\c}{\i0}
Dialogue: 0,1:03:31.26,1:03:33.07,Default,,0,0,0,,Bajingan kecil itu.
Dialogue: 0,1:03:33.10,1:03:35.32,Default,,0,0,0,,Dia bahkan tidak datang pada ulang tahun Ayah yang ke-60.
Dialog: 0,1:03:35.35,1:03:37.05,Default,,0,0,0,,Jangan biarkan dia pergi.
Dialogue: 0,1:03:41.10,1:03:43.50,Default,,0,0,0,,Aku ingin menanyakan sesuatu padamu.
Dialogue: 0,1:03:43.52,1:03:45.75,Default,,0,0,0,,Aku kecewa padamu dan Hae-in.
Dialog: 0,1:03:45.78,1:03:49.25,Default,,0,0,0,,Saya mengerti bahwa Anda tidak bisa datang\Nsecara teratur atau bahkan pada hari libur,
Dialogue: 0,1:03:49.28,1:03:51.92,Default,,0,0,0,,tapi bukankah seharusnya kamu merayakan ulang tahun Ayah yang ke-60?
Dialog: 0,1:03:51.95,1:03:54.94,Default,,0,0,0,,- Itu sangat tidak berperasaan.\N- Ya, kamu benar.
Dialog: 0,1:03:55.58,1:03:56.80,Default,,0,0,0,,Aku tidak berperasaan.
Dialog: 0,1:03:56.83,1:03:58.68,Default,,0,0,0,,Setidaknya dia tahu dia salah.
Dialog: 0,1:03:58.70,1:04:01.20,Default,,0,0,0,,Itulah sebabnya aku bercerai.
Dialog: 0,1:04:01.96,1:04:04.69,Default,,0,0,0,,- Apa?\N- Ayah. Mama.
Dialogue: 0,1:04:04.71,1:04:07.12,Default,,0,0,0,,Aku akan menceraikan Hae-in.
Dialog: 0,1:04:09.01,1:04:11.17,Default,,0,0,0,,- Maaf.\N- Tunggu.
Dialog: 0,1:04:11.34,1:04:13.45,Default,,0,0,0,,Hei, jangan bilang...
Dialogue: 0,1:04:13.47,1:04:16.66,Default,,0,0,0,,kamu akan bercerai\Nhanya karena perkataanku.
Dialogue: 0,1:04:16.68,1:04:18.66,Default,,0,0,0,,Ada apa denganmu? Ulang tahun ke-60 bukanlah apa-apa.
Dialog: 0,1:04:18.68,1:04:20.29,Default,,0,0,0,,Ulang tahun datang setiap tahun.
Dialog: 0,1:04:20.31,1:04:23.25,Default,,0,0,0,,Memang. Siapa yang merayakan\Nulang tahun ke-60 hari ini?
Dialog: 0,1:04:23.27,1:04:25.62,Default,,0,0,0,,Lupakan juga yang ke-70. Kita\Diharapkan berumur lebih panjang.
Dialog: 0,1:04:25.65,1:04:27.08,Default,,0,0,0,,Bukan karena itu.
Dialog: 0,1:04:27.11,1:04:28.25,Default,,0,0,0,,Lalu?
Dialog: 0,1:04:28.28,1:04:31.48,Default,,0,0,0,,Apa itu? Saya yakin Anda punya alasan.
Dialogue: 0,1:04:33.11,1:04:35.30,Default,,0,0,0,,Jangan bilang kamu melihat yang lain...?
Dialog: 0,1:04:35.32,1:04:37.32,Default,,0,0,0,,Ayo.
Dialog: 0,1:04:37.74,1:04:38.97,Default,,0,0,0,,Tidak.
Dialog: 0,1:04:39.00,1:04:40.39,Default,,0,0,0,,Lalu apakah Hae-in punya...?
Dialog: 0,1:04:40.41,1:04:42.66,Default,,0,0,0,,Bisakah kamu berhenti?
Dialogue: 0,1:04:43.00,1:04:46.62,Default,,0,0,0,,Itu juga tidak benar.\NIItu terlalu berlebihan bagiku.
Dialog: 0,1:04:47.67,1:04:48.94,Default,,0,0,0,,Saya tidak senang.
Dialog: 0,1:04:48.96,1:04:51.86,Default,,0,0,0,,Itu alasan yang tidak masuk akal.
Dialog: 0,1:04:51.88,1:04:53.44,Default,,0,0,0,,Apakah menurutmu aku selalu bahagia?
Dialog: 0,1:04:53.47,1:04:54.86,Default,,0,0,0,,Dia benar.
Dialogue: 0,1:04:54.89,1:04:57.45,Default,,0,0,0,,Ayahmu juga tidak selalu bahagia\Ndalam pernikahan ini.
Dialog: 0,1:04:57.47,1:04:58.91,Default,,0,0,0,,Jika ada, aku sengsara,
Dialog: 0,1:04:58.93,1:05:00.66,Default,,0,0,0,,tapi aku hanya mampu menahannya...
Dialog: 0,1:05:00.68,1:05:02.58,Default,,0,0,0,,karena kebahagiaan terkecil...
Dialog: 0,1:05:02.60,1:05:05.21,Default,,0,0,0,,Aku merasa sekali di bulan biru.
Dialog: 0,1:05:05.23,1:05:08.58,Default,,0,0,0,,- Itu pernikahan. Itulah hidup.\N- Anda tahu apa yang Anda bicarakan.
Dialogue: 0,1:05:08.61,1:05:09.71,Default,,0,0,0,,Jujur saja.
Dialogue: 0,1:05:09.73,1:05:12.98,Default,,0,0,0,,Apa menurutmu aku bersama ibumu\N karena aku mencintainya?
Dialog: 0,1:05:15.53,1:05:17.36,Default,,0,0,0,,Apa katamu?
Dialog: 0,1:05:18.66,1:05:20.49,Default,,0,0,0,,Saya belum selesai.
Dialog: 0,1:05:21.00,1:05:22.43,Default,,0,0,0,,Tentu saja aku mencintaimu,
Dialog: 0,1:05:22.46,1:05:25.31,Default,,0,0,0,,tapi jika cinta adalah satu-satunya hal yang kamu rasakan,
Dialogue: 0,1:05:25.33,1:05:27.06,Default,,0,0,0,,maka itulah kematianmu.
Dialog: 0,1:05:27.08,1:05:30.04,Default,,0,0,0,,Tentu. Saya harap Anda berumur panjang.
Dialog: 0,1:05:30.42,1:05:31.69,Default,,0,0,0,,Lihat ini.
Dialogue: 0,1:05:31.71,1:05:36.11,Default,,0,0,0,,Kita masih gagal bertemu langsung,\Nwalau sudah menikah selama 40 tahun.
Dialog: 0,1:05:36.14,1:05:37.96,Default,,0,0,0,,Tidak sama sekali.
Dialog: 0,1:05:39.18,1:05:41.21,Default,,0,0,0,,Luar biasa.
Dialog: 0,1:05:41.27,1:05:43.79,Default,,0,0,0,,Saya mengerti,
Dialog: 0,1:05:43.81,1:05:45.51,Default,,0,0,0,,tapi...
Dialog: 0,1:05:45.94,1:05:50.43,Default,,0,0,0,,Saya berpikir panjang dan keras\Nsebelum mengambil keputusan ini.
Dialogue: 0,1:05:52.69,1:05:54.44,Default,,0,0,0,,Aku akan melakukannya.
Dialog: 0,1:05:57.74,1:05:59.48,Default,,0,0,0,,Maaf.
Dialog: 0,1:06:05.08,1:06:07.02,Default,,0,0,0,,Berhenti!
Dialog: 0,1:06:07.04,1:06:09.98,Default,,0,0,0,,Berhenti! Keluar, bajingan!
Dialog: 0,1:06:10.00,1:06:11.98,Default,,0,0,0,,Kamu egois sekali.
Dialog: 0,1:06:12.00,1:06:14.61,Default,,0,0,0,,Tahukah kamu aku harus berkorban untukmu?
Dialog: 0,1:06:14.63,1:06:16.44,Default,,0,0,0,,Pengorbanan apa?
Dialogue: 0,1:06:16.47,1:06:19.15,Default,,0,0,0,,Aku bahkan tidak bisa kuliah,\Nkarena orang tua kami menjual...
Dialog: 0,1:06:19.18,1:06:20.99,Default,,0,0,0,,semua sapi kami akan mengirimmu ke Seoul.
Dialog: 0,1:06:21.01,1:06:22.32,Default,,0,0,0,,Bagaimana kamu bisa melupakannya?
Dialogue: 0,1:06:22.35,1:06:24.74,Default,,0,0,0,,Kenapa kamu begitu tidak tahu malu?\NKamu tidak bisa kuliah...
Dialog: 0,1:06:24.77,1:06:27.14,Default,,0,0,0,,karena gagal hadir.
Dialogue: 0,1:06:29.48,1:06:32.10,Default,,0,0,0,,Anak ini naif sekali.
Dialogue: 0,1:06:34.28,1:06:37.55,Default,,0,0,0,,Menurut Anda mengapa Grand\NPangeran Yang-nyeong bertingkah?
Dialog: 0,1:06:37.57,1:06:39.01,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,1:06:39.03,1:06:40.59,Default,,0,0,0,,Itu adalah pengorbanan.
Dialogue: 0,1:06:40.62,1:06:43.64,Default,,0,0,0,,Dia mengorbankan dirinya dan bertindak\Nout demi saudaranya Se-jong.
Dialogue: 0,1:06:43.66,1:06:45.22,Default,,0,0,0,,Apakah menurutmu aku senang berakting?
Dialogue: 0,1:06:45.25,1:06:48.93,Default,,0,0,0,,Aku merelakan\Nharapan, harapan, dan sapi orang tua kita...
Dialog: 0,1:06:48.96,1:06:51.06,Default,,0,0,0,,hanya untuk Anda.
Dialogue: 0,1:06:51.09,1:06:52.10,Default,,0,0,0,,Benarkah?
Dialog: 0,1:06:52.13,1:06:53.48,Default,,0,0,0,,Ya, saya.
Dialog: 0,1:06:53.50,1:06:56.21,Default,,0,0,0,,Saya harus berkorban sebagai yang tertua.
Dialog: 0,1:06:57.51,1:07:00.61,Default,,0,0,0,,Saya mengerti, Nona Baek Mi-seon.\NThumbelina dari Geng Kereta Yongdu.
Dialog: 0,1:07:00.64,1:07:02.20,Default,,0,0,0,,Hei!
Dialog: 0,1:07:02.22,1:07:05.13,Default,,0,0,0,,Itu sudah lama sekali.
Dialogue: 0,1:07:07.73,1:07:09.55,Default,,0,0,0,,Aku pergi.
Dialog: 0,1:07:13.69,1:07:15.42,Default,,0,0,0,,Saya tidak ingin menekan Anda.
Dialogue: 0,1:07:15.44,1:07:17.56,Default,,0,0,0,,Kamu sudah melakukannya.
Dialog: 0,1:07:17.82,1:07:19.97,Default,,0,0,0,,- Aku hanya mengkhawatirkan Ayah.\N- Bagaimana dengan dia?
Dialogue: 0,1:07:19.99,1:07:23.05,Default,,0,0,0,,Tahukah kamu betapa bahagianya dia\Nmenikahkanmu dengan Ratu?
Dialog: 0,1:07:23.08,1:07:25.82,Default,,0,0,0,,Dia bilang dia tidak nafsu makan,\Ntapi menghabiskan semangkuk sup nasi...
Dialog: 0,1:07:25.84,1:07:28.50,Default,,0,0,0,,setiap kali harga saham Queens naik.
Dialog: 0,1:07:28.87,1:07:31.39,Default,,0,0,0,,Dia selalu menikmati sup nasi.
Dialog: 0,1:07:31.42,1:07:33.44,Default,,0,0,0,,Ya, itu benar.
Dialog: 0,1:07:33.46,1:07:34.60,Default,,0,0,0,,Benar, tapi...
Dialogue: 0,1:07:34.63,1:07:37.65,Default,,0,0,0,,Anak dari kota kecil ini bercerai?
Dialog: 0,1:07:37.67,1:07:40.40,Default,,0,0,0,,Dia akan dipermalukan! Bangun, idiot!
Dialog: 0,1:07:40.43,1:07:42.70,Default,,0,0,0,,Ini bukan Seoul atau Hollywood.
Dialog: 0,1:07:42.72,1:07:43.82,Default,,0,0,0,,Ini Yongdu-ri.
Dialogue: 0,1:07:43.85,1:07:45.99,Default,,0,0,0,,Temanmu Chang-sik\N bercerai dua tahun lalu,
Dialog: 0,1:07:46.02,1:07:48.33,Default,,0,0,0,,dan mereka masih membicarakannya.
Dialog: 0,1:07:48.35,1:07:50.33,Default,,0,0,0,,Dia benar.
Dialog: 0,1:07:50.35,1:07:52.29,Default,,0,0,0,,Semua wanita di salon rambutku...
Dialogue: 0,1:07:52.31,1:07:55.25,Default,,0,0,0,,masih penasaran kenapa dia bercerai.
Dialog: 0,1:07:55.27,1:07:56.75,Default,,0,0,0,,Benar. Namun...
Dialog: 0,1:07:56.78,1:08:00.40,Default,,0,0,0,,tidak ada yang akan membicarakan dia\Njika kamu bercerai juga.
Dialog: 0,1:08:02.36,1:08:04.59,Default,,0,0,0,,Apakah ini karena sewa gymmu?
Dialog: 0,1:08:04.62,1:08:06.80,Default,,0,0,0,,Dan karena Gyeong-jun yang belajar di luar negeri?
Dialog: 0,1:08:06.83,1:08:09.03,Default,,0,0,0,,Karena kamu perlu mengiriminya uang?
Dialog: 0,1:08:10.66,1:08:12.53,Default,,0,0,0,,Apakah Anda menggunakan saya untuk menjalani kehidupan yang nyaman,
Dialog: 0,1:08:12.56,1:08:15.15,Default,,0,0,0,,seperti bagaimana Sim-cheong\Ndijual seharga 300 karung beras?
Dialog: 0,1:08:15.17,1:08:17.27,Default,,0,0,0,,Astaga. Tidak, aku...
Dialog: 0,1:08:17.30,1:08:21.11,Default,,0,0,0,,Saya tidak akan menggunakan Anda jika sebanyak itu,
Dialog: 0,1:08:21.13,1:08:23.15,Default,,0,0,0,,- tapi bukan itu.\N- Sial.
Dialog: 0,1:08:23.18,1:08:25.07,Default,,0,0,0,,Hei, Hyun-woo.
Dialog: 0,1:08:25.10,1:08:26.49,Default,,0,0,0,,Hyun...
Dialog: 0,1:08:26.51,1:08:27.53,Default,,0,0,0,,Hyun-woo!
Dialog: 0,1:08:27.56,1:08:29.37,Default,,0,0,0,,- Baek Hyun-woo!\N- Hyun-woo!
Dialog: 0,1:08:29.39,1:08:31.34,Default,,0,0,0,,Menginaplah!
Dialog: 0,1:09:24.95,1:09:26.99,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Perjanjian Penyelesaian Perceraian{\c}{\i0}
Dialog: 0,1:10:08.12,1:10:09.82,Default,,0,0,0,,Saya punya...
Dialog: 0,1:10:10.91,1:10:12.61,Default,,0,0,0,,sesuatu untuk dikatakan.
Dialogue: 0,1:10:14.79,1:10:16.66,Default,,0,0,0,,Aku pergi dulu.
Dialog: 0,1:10:16.96,1:10:18.69,Default,,0,0,0,,Apa?
Dialog: 0,1:10:18.71,1:10:21.33,Default,,0,0,0,,Aku juga melakukannya, jadi biarkan aku pergi dulu.
Dialog: 0,1:10:23.17,1:10:26.33,Default,,0,0,0,,Oke. Berlangsung.
Dialog: 0,1:10:27.30,1:10:29.13,Default,,0,0,0,,Saya...
Dialog: 0,1:10:32.31,1:10:34.17,Default,,0,0,0,,sekarat.
Dialog: 0,1:10:38.60,1:10:40.72,Default,,0,0,0,,Saya punya waktu tiga bulan lagi.
Dialog: 0,1:10:46.57,1:10:48.27,Default,,0,0,0,,Apa katamu?
Dialogue: 0,1:10:54.45,1:10:56.35,Default,,0,0,0,,Aku bilang kita harus pergi ke suatu tempat hari ini.
Dialog: 0,1:10:56.37,1:10:58.24,Default,,0,0,0,,Saya pergi ke rumah sakit,
Dialog: 0,1:10:58.58,1:11:01.62,Default,,0,0,0,,dan dokter bilang aku sekarat,
Dialog: 0,1:11:01.71,1:11:03.83,Default,,0,0,0,,dan saya punya waktu tiga bulan.
Dialog: 0,1:11:05.21,1:11:06.92,Default,,0,0,0,,Apa...
Dialog: 0,1:11:06.97,1:11:08.71,Default,,0,0,0,, maksudmu?
Dialog: 0,1:11:09.76,1:11:12.00,Default,,0,0,0,,Persis seperti yang saya katakan.
Dialogue: 0,1:11:12.22,1:11:17.05,Default,,0,0,0,,Dokter bilang umurku hanya\Ntiga bulan lagi.
Dialog: 0,1:11:18.31,1:11:20.26,Default,,0,0,0,,Itu saja.
Dialog: 0,1:11:20.77,1:11:22.83,Default,,0,0,0,,- Apa yang ingin kamu katakan?\N- Apa?
Dialog: 0,1:11:22.86,1:11:26.23,Default,,0,0,0,,Ada yang ingin Anda katakan. Apa itu?
Dialog: 0,1:11:28.90,1:11:30.61,Default,,0,0,0,,Saya rasa tidak...
Dialog: 0,1:11:31.82,1:11:34.69,Default,,0,0,0,,itu penting saat ini.
Dialog: 0,1:11:39.87,1:11:42.85,Default,,0,0,0,,Katakan saja. Saya tahu Anda ingin mengatakan sesuatu.
Dialog: 0,1:11:42.88,1:11:46.40,Default,,0,0,0,,Baiklah, saya...
Dialog: 0,1:11:46.42,1:11:50.49,Default,,0,0,0,,- Jadi apa...\N- Ya?
Dialog: 0,1:11:50.51,1:11:53.34,Default,,0,0,0,,...Saya ingin mengatakan adalah...
Dialog: 0,1:11:54.89,1:11:56.59,Default,,0,0,0,,Saya...
Dialog: 0,1:11:57.56,1:11:58.66,Default,,0,0,0,,Ya?
Dialog: 0,1:11:58.68,1:12:00.59,Default,,0,0,0,,"Maaf."
Dialog: 0,1:12:02.48,1:12:05.43,Default,,0,0,0,,"Tentang hari ini,"
Dialog: 0,1:12:05.52,1:12:09.17,Default,,0,0,0,,"dan semua yang telah saya lakukan."
Dialog: 0,1:12:09.19,1:12:13.22,Default,,0,0,0,,"Ini tidak akan terjadi lagi.\NI akan memperlakukan Anda lebih baik."
Dialog: 0,1:12:13.24,1:12:17.19,Default,,0,0,0,,Itulah yang kuinginkan...
Dialog: 0,1:12:17.49,1:12:18.68,Default,,0,0,0,,untuk mengatakan,
Dialogue: 0,1:12:18.70,1:12:22.68,Default,,0,0,0,,tapi kamu hanya punya waktu tiga bulan\Nuntuk hidup? Bagaimana mungkin?
Dialog: 0,1:12:22.71,1:12:25.87,Default,,0,0,0,,Bagaimana aku bisa hidup tanpamu?
Dialog: 0,1:12:26.96,1:12:28.71,Default,,0,0,0,,Bagaimana mungkin?
Dialog: 0,1:12:28.80,1:12:31.44,Default,,0,0,0,,Saya sangat tercengang,
Dialog: 0,1:12:31.47,1:12:33.71,Default,,0,0,0,,Saya tidak tahu harus berkata apa.
Dialog: 0,1:12:38.27,1:12:39.33,Default,,0,0,0,,Apakah kamu serius?
Dialog: 0,1:12:39.35,1:12:42.39,Default,,0,0,0,,Ya, bodoh.
Dialog: 0,1:12:53.91,1:12:56.19,Default,,0,0,0,,Aku cinta kamu, Hong Hae-in.
Dialog: 0,1:12:57.24,1:12:59.11,Default,,0,0,0,,Aku cinta kamu.
Dialog: 0,1:13:15.26,1:13:17.36,Default,,0,0,0,,{\i1}Tolong beri mereka tepuk tangan...{\i0}
Dialog: 0,1:13:17.39,1:13:20.59,Default,,0,0,0,,{\i1}saat mereka memulai perjalanan baru.{\i0}
Dialogue: 0,1:13:25.69,1:13:27.42,Default,,0,0,0,,{\i1}Tolong bertepuk tangan dan bersorak lebih keras lagi...{\i0}
Dialogue: 0,1:13:27.44,1:13:30.35,Default,,0,0,0,,{\i1}untuk mendoakan yang terbaik bagi mereka.{\i0}
Dialog: 0,1:13:35.66,1:13:38.68,Default,,0,0,0,,Semuanya, silakan lihat ke kamera!
Dialog: 0,1:13:38.70,1:13:41.60,Default,,0,0,0,,Silakan tertawa dalam hitungan ketiga.
Dialog: 0,1:13:41.62,1:13:43.70,Default,,0,0,0,,Satu, dua, tiga.
Dialog: 0,1:14:00.76,1:14:03.62,Default,,0,0,0,,Tn. Baek, selamat atas pernikahannya.
Dialog: 0,1:14:03.64,1:14:05.95,Default,,0,0,0,,Tolong katakan sesuatu pada dirimu sendiri dalam sepuluh tahun.
Dialogue: 0,1:14:05.98,1:14:08.29,Default,,0,0,0,,Bagaimana kabarmu, Hyun-woo dari masa depan?
Dialog: 0,1:14:08.31,1:14:10.60,Default,,0,0,0,,Jangan bilang kamu sudah bercerai.
Dialog: 0,1:14:11.40,1:14:13.00,Default,,0,0,0,,Apakah kamu punya anak?
Dialog: 0,1:14:13.03,1:14:14.59,Default,,0,0,0,,Satu? Dua?
Dialogue: 0,1:14:14.61,1:14:16.59,Default,,0,0,0,,Tidak masalah,
Dialog: 0,1:14:16.61,1:14:20.48,Default,,0,0,0,,karena yang kubutuhkan hanyalah Hae-in.
Dialog: 0,1:14:21.45,1:14:23.72,Default,,0,0,0,,Saya harap Anda masih ingat...
Dialogue: 0,1:14:23.75,1:14:27.27,Default,,0,0,0,,betapa besarnya kamu mencintainya,
Dialog: 0,1:14:27.29,1:14:29.87,Default,,0,0,0,,bahkan hingga saat ini.
Dialogue: 0,1:14:32.05,1:14:34.00,Default,,0,0,0,,Jangan buat dia menangis.
Dialog: 0,1:14:34.17,1:14:36.21,Default,,0,0,0,,Buat dia bahagia.
Dialogue: 0,1:14:36.68,1:14:38.71,Default,,0,0,0,,Kenapa aku harus menjawabnya?
Dialog: 0,1:14:39.14,1:14:41.91,Default,,0,0,0,,Ini akan menjadi sesuatu yang menyenangkan untuk ditonton di masa depan.
Dialogue: 0,1:14:41.93,1:14:45.16,Default,,0,0,0,,Aku akan terlalu sibuk dengan kehidupan\Nuntuk menonton ini dalam sepuluh tahun.
Dialog: 0,1:14:45.18,1:14:47.30,Default,,0,0,0,,Apakah saya harus melakukan ini?
Dialog: 0,1:14:48.27,1:14:50.21,Default,,0,0,0,,Hae-in yang terhormat dari masa depan.
Dialog: 0,1:14:50.23,1:14:54.59,Default,,0,0,0,,Saya ragu Anda menonton ini,\Ntetapi jika ya, mengapa Anda menontonnya?
Dialog: 0,1:14:54.61,1:14:56.05,Default,,0,0,0,,Matikan ini dan mulai bekerja.
Dialogue: 0,1:14:56.07,1:14:59.84,Default,,0,0,0,,Aku tidak akan menanyakan kabarmu,\Nkarena aku tahu kamu akan baik-baik saja.
Dialog: 0,1:14:59.87,1:15:01.89,Default,,0,0,0,,Kamu akan sama cantik, sehat,
Dialog: 0,1:15:01.91,1:15:04.36,Default,,0,0,0,,dan yang paling sukses.
Dialog: 0,1:15:04.62,1:15:08.24,Default,,0,0,0,,Dengan Hyun-woo, tentu saja.
Dialog: 0,1:15:16.09,1:15:18.88,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialogue: 0,1:15:46.20,1:15:48.64,Default,,0,0,0,,{\an8}{\i1}Kamu hanya punya waktu tiga bulan\Nuntuk hidup? Bagaimana mungkin?{\i0}
Dialogue: 0,1:15:48.66,1:15:52.02,Default,,0,0,0,,{\an8}{\i1}Jika kamu tidak bisa hidup tanpaku...\NDApakah kamu ingin mati bersama?{\i0}
Dialog: 0,1:15:52.04,1:15:53.39,Default,,0,0,0,,{\an8}{\i1}Aku hanya senang...{\i0}
Dialog: 0,1:15:53.42,1:15:56.81,Default,,0,0,0,,{\an8}{\i1}bahwa saya dapat melarikan diri dari mereka dengan selamat.{\i0}
Dialogue: 0,1:15:56.84,1:15:59.98,Default,,0,0,0,,{\an8}{\i1}Tempatkan hati dan jiwamu untuk mencintainya.{\i0}
Dialog: 0,1:16:00.01,1:16:01.36,Default,,0,0,0,,{\an8}{\i1}Apakah aku materialistis itu?{\i0}
Dialog: 0,1:16:01.39,1:16:03.24,Default,,0,0,0,,{\an8}{\i1}Saya akan duduk di sini.{\i0}
