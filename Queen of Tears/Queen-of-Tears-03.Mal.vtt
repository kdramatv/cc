Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.85,0:01:06.44, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Empat Tahun Lalu{\c}{\i0}
Dialog: 0,0:01:09.98,0:01:10.96, Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 3{\c}{\i0}
Dialog: 0,0:01:10.98,0:01:16.44, Lalai,,0,0,0,,{\an8}Kami memiliki seluruh kebun ini.
Dialog: 0,0:01:22.33,0:01:24.90,Lalai,,0,0,0,,{\an8}Saya fikir ibu saya akan berada di sini.
Dialog: 0,0:01:25.04,0:01:26.60, Lalai,,0,0,0,,{\an8}Mungkin dia ada di kedai.
Dialog: 0,0:01:26.62,0:01:29.12, Lalai,,0,0,0,,{\an8}Dia juga menjalankan kedai.
Dialog: 0,0:01:30.59,0:01:34.52,Lalai,,0,0,0,,{\an8}Saya beritahu anda keluarga kami\Berpengaruh di bandar ini.
Dialog: 0,0:01:34.55,0:01:36.50, Lalai,,0,0,0,,{\an8}Betul.
Dialog: 0,0:01:59.36,0:02:01.32, Lalai,,0,0,0,,Mak!
Dialog: 0,0:02:02.78,0:02:04.26, Lalai,,0,0,0,,Ibu?
Dialog: 0,0:02:04.29,0:02:05.60, Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pasar Raya Yongdu-ri{\c}{\i0}
Dialog: 0,0:02:05.62,0:02:06.72, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:02:06.75,0:02:08.74, Lalai,,0,0,0,,Dia juga tiada di sini.
Dialog: 0,0:02:15.84,0:02:18.29, Lalai,,0,0,0,,Pilih apa sahaja yang anda mahu.
Dialog: 0,0:02:31.60,0:02:32.79, Lalai,,0,0,0,,Ada ini.
Dialog: 0,0:02:32.81,0:02:34.17, Lalai,,0,0,0,,Ini perisa baharu.
Dialog: 0,0:02:34.19,0:02:35.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ais Pop{\c}{\i0}
Dialog: 0,0:02:36.44,0:02:37.92, Lalai,,0,0,0,,Ia berperisa strawberi.
Dialog: 0,0:02:37.94,0:02:43.15, Lalai,,0,0,0,,Semua kanak-kanak membeli satu selepas\Nsekolah, kerana ia sangat popular.
Dialog: 0,0:02:59.84,0:03:01.86, Lalai,,0,0,0,,Ia bagus dan menyegarkan.
Dialog: 0,0:03:01.89,0:03:03.63, Lalai,,0,0,0,,Ini kali pertama saya.
Dialog: 0,0:03:07.35,0:03:10.26, Lalai,,0,0,0,,Ini kali pertama anda menikmati pop ais?
Dialog: 0,0:03:10.64,0:03:14.22, Lalai,,0,0,0,,Tunggu. Mungkin bukan sebagai orang dewasa, tetapi sebagai seorang kanak-kanak?
Dialog: 0,0:03:15.94,0:03:19.06, Lalai,,0,0,0,,Adakah ibu anda tidak pernah membelikan anda?
Dialog: 0,0:03:19.32,0:03:21.23, Lalai,,0,0,0,,Tidak, dia tidak.
Dialog: 0,0:03:27.49,0:03:31.12,Lalai,,0,0,0,,Sejujurnya, saya agak tahu.
Dialog: 0,0:03:31.15,0:03:32.14, Lalai,,0,0,0,, Tahu apa?
Dialog: 0,0:03:32.17,0:03:35.27, Lalai,,0,0,0,,Anda sentiasa memakai baju-t yang berlubang.
Dialog: 0,0:03:35.29,0:03:36.56,Lalai,,0,0,0,,Apa?
Dialog: 0,0:03:36.59,0:03:38.56, Lalai,,0,0,0,,Itu vintaj.
Dialog: 0,0:03:38.59,0:03:41.69,Lalai,,0,0,0,,- Saya buat di Eropah...\N- Apa yang anda pakai hari ini kelihatan seperti...
Dialog: 0,0:03:41.72,0:03:43.69, Lalai,,0,0,0,,sesuatu yang nenek saya akan pakai.
Dialog: 0,0:03:43.72,0:03:46.32, Lalai,,0,0,0,,Tidak, dengar saya dahulu.
Dialog: 0,0:03:46.35,0:03:49.01, Lalai,,0,0,0,,Anda pasti terkejut apabila mengetahui...
Dialog: 0,0:03:52.39,0:03:54.12,Lalai,,0,0,0,,harga cardigan ini.
Dialog: 0,0:03:54.15,0:03:57.33, Lalai,,0,0,0,,- Anda tidak perlu berpura-pura dengan saya.\N- Percayalah.
Dialog: 0,0:03:57.36,0:03:59.52, Lalai,,0,0,0,,Saya tidaklah miskin.
Dialog: 0,0:04:00.32,0:04:02.31, Lalai,,0,0,0,,Sungguh.
Dialog: 0,0:04:03.53,0:04:05.09, Lalai,,0,0,0,, Anda sepatutnya mempercayai saya.
Dialog: 0,0:04:05.11,0:04:07.69, Lalai,,0,0,0,,Saya beri kata-kata saya.
Dialog: 0,0:04:08.49,0:04:09.55, Lalai,,0,0,0,,Mulai detik ini,
Dialog: 0,0:04:09.58,0:04:14.62,Lalai,,0,0,0,,Saya akan membenarkan anda menikmati semua\Nperkara yang anda tidak dapat nikmati dalam hidup.
Dialog: 0,0:04:16.54,0:04:17.98, Lalai,,0,0,0,,Itu tidak akan mudah.
Dialog: 0,0:04:18.00,0:04:21.94, Lalai,,0,0,0,,Bukankah saya memberitahu anda pangsapuri saya telah dipajak?
Dialog: 0,0:04:21.97,0:04:23.67, Lalai,,0,0,0,,Anda lakukan.
Dialog: 0,0:04:25.89,0:04:27.84, Lalai,,0,0,0,,Tetapi ada lagi.
Dialog: 0,0:04:28.85,0:04:30.55, Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,0:04:34.85,0:04:36.93, Lalai,,0,0,0,,Saya simpan $2000 setiap bulan.
Dialog: 0,0:04:44.78,0:04:47.17,Lalai,,0,0,0,,Jangan pandang saya macam awak tak faham.
Dialog: 0,0:04:47.20,0:04:48.47,Lalai,,0,0,0,,Saya tidak bercakap besar.
Dialog: 0,0:04:48.49,0:04:50.78,Lalai,,0,0,0,,Saya cakap tak apa.
Dialog: 0,0:04:50.99,0:04:54.61,Lalai,,0,0,0,,Saya tidak kisah jika keluarga kamu mempunyai hutang.
Dialog: 0,0:04:57.04,0:04:58.78, Lalai,,0,0,0,,Jika kita mempunyai hutang?
Dialog: 0,0:05:00.00,0:05:03.12, Lalai,,0,0,0,, Walaupun terdapat lebih daripada itu,
Dialog: 0,0:05:03.67,0:05:05.54, Lalai,,0,0,0,,Saya tidak kisah.
Dialog: 0,0:05:08.59,0:05:10.30, Lalai,,0,0,0,, Kerana...
Dialog: 0,0:05:11.10,0:05:12.88, Lalai,,0,0,0,,Saya akan terus bersama anda.
Dialog: 0,0:05:16.10,0:05:19.16, Lalai,,0,0,0,,Anda akan bersama saya?
Dialog: 0,0:05:19.19,0:05:20.89, Lalai,,0,0,0,,Ya.
Dialog: 0,0:05:21.52,0:05:23.23, Lalai,,0,0,0,,Saya akan ke sana...
Dialog: 0,0:05:24.11,0:05:26.02, Lalai,,0,0,0,,untuk anda.
Dialog: 0,0:05:31.33,0:05:33.82, Lalai,,0,0,0,,{\i1}Mengapa ingatan ini muncul?{\i0}
Dialog: 0,0:05:37.58,0:05:40.66,Lalai,,0,0,0,,{\i1}Adakah anda orang terakhir dalam fikiran saya...{\i0}
Dialog: 0,0:05:40.79,0:05:43.95,Lalai,,0,0,0,,{\i1}jika saya mati sekarang?{\i0}
Dialog: 0,0:06:21.50,0:06:23.20,Lalai,,0,0,0,,Adakah anda okey?
Dialog: 0,0:06:30.26,0:06:32.13, Lalai,,0,0,0,, Hae-in.
Dialog: 0,0:06:35.60,0:06:37.59,Lalai,,0,0,0,,Adakah anda cedera?
Dialog: 0,0:06:39.60,0:06:41.16, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:06:41.19,0:06:42.75, Lalai,,0,0,0,,Bolehkah anda selesaikan di sini?
Dialog: 0,0:06:42.77,0:06:44.42, Lalai,,0,0,0,,Dia kelihatan terkejut.
Dialog: 0,0:06:44.44,0:06:46.68, Lalai,,0,0,0,,Dia perlukan rehat.
Dialog: 0,0:06:50.24,0:06:51.94, Lalai,,0,0,0,,Jom.
Dialog: 0,0:06:52.37,0:06:54.07, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:07:08.30,0:07:11.04, Lalai,,0,0,0,,Rasanya nyata di hospital,
Dialog: 0,0:07:12.05,0:07:14.96,Lalai,,0,0,0,,tetapi saya benar-benar fikir saya akan mati di sana.
Dialog: 0,0:07:19.52,0:07:21.89,Lalai,,0,0,0,,Saya memberitahu diri saya sekali lagi...
Dialog: 0,0:07:22.60,0:07:25.54, Lalai,,0,0,0,,bahawa saya tidak akan mati,
Dialog: 0,0:07:25.57,0:07:27.39,Lalai,,0,0,0,,kerana saya rasa...
Dialog: 0,0:07:28.48,0:07:30.31, Lalai,,0,0,0,, tersinggung.
Dialog: 0,0:07:35.96,0:07:37.66, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:07:42.58,0:07:44.74, Lalai,,0,0,0,,Saya rasa awak terseliuh.
Dialog: 0,0:07:57.14,0:07:59.72, Lalai,,0,0,0,,Adakah saya menjadi dramatik lagi?
Dialog: 0,0:08:02.10,0:08:04.16, Lalai,,0,0,0,,Ya, jika ini hari lain,
Dialog: 0,0:08:04.19,0:08:06.46, Lalai,,0,0,0,,tetapi kerana saya cedera,
Dialog: 0,0:08:06.48,0:08:09.18, Lalai,,0,0,0,,Saya rasa ia munasabah.
Dialog: 0,0:08:10.94,0:08:12.64, Lalai,,0,0,0,, Betul?
Dialog: 0,0:08:25.21,0:08:28.48,Lalai,,0,0,0,,Bukankah mudah untuk membakar kayu?
Dialog: 0,0:08:28.50,0:08:30.06, Lalai,,0,0,0,,Tetapi ini oak,
Dialog: 0,0:08:30.09,0:08:32.57, Lalai,,0,0,0,,- jadi adakah mustahil?\N- Tidak, bukan,
Dialog: 0,0:08:32.59,0:08:35.82, Lalai,,0,0,0,,tetapi pengembara seperti saya lebih suka pokok plum daripada oak.
Dialog: 0,0:08:35.84,0:08:39.76,Lalai,,0,0,0,,Bau plum yang membara meresap\Ni ke dalam daging dan menjadikannya sedap.
Dialog: 0,0:08:39.85,0:08:42.42, Lalai,,0,0,0,,Baiklah. Teruskan, kemudian.
Dialog: 0,0:08:43.68,0:08:46.75,Lalai,,0,0,0,,Aduh, ini membuatkan saya nostalgia.
Dialog: 0,0:08:46.77,0:08:49.25, Lalai,,0,0,0,,Saya teringat semasa saya pergi ke Afrika.
Dialog: 0,0:08:49.27,0:08:54.48, Lalai,,0,0,0,,Dua puluhan saya dipenuhi\Ndengan kebiadaban dan kebiadaban.
Dialog: 0,0:08:55.36,0:08:56.67, Lalai,,0,0,0,,Maksud anda bagaimana anda kekal...
Dialog: 0,0:08:56.70,0:09:00.44, Lalai,,0,0,0,,di dalam hotel sepanjang\Nminggu disebabkan nyamuk?
Dialog: 0,0:09:01.12,0:09:04.53, Lalai,,0,0,0,,Saya sudah cukup dengan hutan belantara\Nhanya melihat ke luar tingkap.
Dialog: 0,0:09:12.96,0:09:14.61, Lalai,,0,0,0,,Apa?
Dialog: 0,0:09:14.63,0:09:16.90,Lalai,,0,0,0,,- Hanya ada asap.\N- Betul.
Dialog: 0,0:09:16.93,0:09:19.28, Lalai,,0,0,0,,Saya rasa kayu ini lembap.
Dialog: 0,0:09:19.30,0:09:22.32, Lalai,,0,0,0,,Malah ahli perkhemahan yang paling mahir\N tidak boleh berbuat apa-apa tentang perkara ini.
Dialog: 0,0:09:22.35,0:09:25.26,Lalai,,0,0,0,,Hyun-woo tidak pernah memilih kayu.
Dialog: 0,0:09:25.89,0:09:27.54, Lalai,,0,0,0,,Dia dari luar bandar.
Dialog: 0,0:09:27.56,0:09:29.87,Lalai,,0,0,0,,Anda tidak boleh membandingkan saya dengan dia yang mungkin...
Dialog: 0,0:09:29.90,0:09:32.46, Lalai,,0,0,0,,bermain bola sepak di jalan yang tidak berturap dengan pundi babi.
Dialog: 0,0:09:32.48,0:09:33.71,Lalai,,0,0,0,,Dia mempunyai pengalaman.
Dialog: 0,0:09:33.73,0:09:37.13, Lalai,,0,0,0,,Aduh, awak dan alasan awak.
Dialog: 0,0:09:37.15,0:09:38.92,Lalai,,0,0,0,,Di manakah dia?
Dialog: 0,0:09:38.95,0:09:41.43, Lalai,,0,0,0,,Anda boleh berhenti. Cuma minta dia buat.
Dialog: 0,0:09:41.45,0:09:42.64, Lalai,,0,0,0,,Tidak, saya boleh melakukannya.
Dialog: 0,0:09:42.66,0:09:45.18,Lalai,,0,0,0,,Soo-cheol, cukuplah. Anda boleh berhenti.
Dialog: 0,0:10:14.23,0:10:15.88, Lalai,,0,0,0,,Chamomile?
Dialog: 0,0:10:15.90,0:10:17.00, Lalai,,0,0,0,,Ya.
Dialog: 0,0:10:17.03,0:10:20.77, Lalai,,0,0,0,,Boleh awak buat dua lagi untuk pengerusi dan saya?
Dialog: 0,0:10:21.49,0:10:22.72, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:10:22.74,0:10:26.10,Lalai,,0,0,0,,Mengapa Ayah pulang awal daripada memburu?
Dialog: 0,0:10:26.12,0:10:27.14,Lalai,,0,0,0,,Nah...
Dialog: 0,0:10:27.16,0:10:30.06,Lalai,,0,0,0,,Bomoh besar menghubungi saya.
Dialog: 0,0:10:30.08,0:10:31.18, Lalai,,0,0,0,,Mengenai apa?
Dialog: 0,0:10:31.21,0:10:34.44,Lalai,,0,0,0,,Bomoh itu tiba-tiba bertanya sama ada\Npengerusi pergi memburu.
Dialog: 0,0:10:34.46,0:10:37.37,Lalai,,0,0,0,,- Bagaimana dia tahu?\N- Tidak hairanlah dia hebat.
Dialog: 0,0:10:37.63,0:10:41.34, Lalai,,0,0,0,,Dia berkata pengerusi akan\Nin bahaya jika dia pergi memburu hari ini.
Dialog: 0,0:10:41.89,0:10:44.62,Lalai,,0,0,0,,Adakah itu sebabnya dia kembali serta-merta?
Dialog: 0,0:10:44.64,0:10:46.95,Lalai,,0,0,0,,Ya, tetapi sekurang-kurangnya ia berita baik untuk Hae-in.
Dialog: 0,0:10:46.97,0:10:49.05, Lalai,,0,0,0,,Dia perlu mengikuti kursusnya.
Dialog: 0,0:10:49.56,0:10:50.62, Lalai,,0,0,0,,Mak!
Dialog: 0,0:10:50.65,0:10:52.04, Lalai,,0,0,0,,Mak!
Dialog: 0,0:10:52.06,0:10:53.97, Lalai,,0,0,0,,Mak!
Dialog: 0,0:10:54.40,0:10:55.50,Lalai,,0,0,0,,Hae-in cedera.
Dialog: 0,0:10:55.52,0:10:56.59,Lalai,,0,0,0,,Apa? Bagaimana?
Dialog: 0,0:10:56.61,0:10:59.09,Lalai,,0,0,0,,Saya dengar dia bertemu dengan babi hutan semasa memburu,
Dialog: 0,0:10:59.11,0:11:02.47, Lalai,,0,0,0,,tetapi kecederaannya tidaklah teruk. Mereka tidak teruk.
Dialog: 0,0:11:02.49,0:11:05.23, Lalai,,0,0,0,,Kebaikan. Adakah dia baik-baik saja?
Dialog: 0,0:11:09.04,0:11:12.02, Lalai,,0,0,0,,Bagaimana anda tahu?
Dialog: 0,0:11:12.04,0:11:13.95, Lalai,,0,0,0,,Anda sememangnya yang terbaik.
Dialog: 0,0:11:17.09,0:11:18.23, Lalai,,0,0,0,,Apa yang dia katakan?
Dialog: 0,0:11:18.26,0:11:22.54,Lalai,,0,0,0,,Apa-apa pun, terima kasih banyak-banyak.\NI akan melawat anda dalam masa terdekat.
Dialog: 0,0:11:23.26,0:11:25.80, Lalai,,0,0,0,,Apa yang dia katakan?
Dialog: 0,0:11:29.85,0:11:32.70,Lalai,,0,0,0,,Bekas isteri kamu muncul dalam mimpinya.
Dialog: 0,0:11:32.73,0:11:34.96, Lalai,,0,0,0,,Dia sedang memegang pisau di tempat perburuan.
Dialog: 0,0:11:34.98,0:11:37.38,Lalai,,0,0,0,,Dia mahu membawa anda bersamanya.
Dialog: 0,0:11:37.40,0:11:41.48, Lalai,,0,0,0,,Anda mungkin berada dalam kubur\Nbahaya jika anda memburu hari ini.
Dialog: 0,0:11:42.36,0:11:43.38, Lalai,,0,0,0,, Nampak?
Dialog: 0,0:11:43.41,0:11:45.86,Lalai,,0,0,0,,Anda bijak mendengar saya dan kembali.
Dialog: 0,0:11:51.29,0:11:53.77, Lalai,,0,0,0,,Jangan abaikan tahyul.
Dialog: 0,0:11:53.79,0:11:56.98,Lalai,,0,0,0,,Daftar masuk dengan bomoh\Nsebelum membuat keputusan besar.
Dialog: 0,0:11:57.00,0:11:59.20,Lalai,,0,0,0,,Okey.
Dialog: 0,0:12:09.72,0:12:11.70, Lalai,,0,0,0,,Bukankah kita patut panggil Doktor Kim?
Dialog: 0,0:12:11.73,0:12:14.66, Lalai,,0,0,0,,Saya okay. Saya hanya terseliuh.
Dialog: 0,0:12:14.69,0:12:16.58,Lalai,,0,0,0,,Hyun-woo menyelamatkan nyawa awak.
Dialog: 0,0:12:16.61,0:12:19.54,Lalai,,0,0,0,,Saya fikir dia tidak boleh\Ntembak burung, tetapi babi?
Dialog: 0,0:12:19.57,0:12:21.25, Lalai,,0,0,0,,Dia berpura-pura selama ini.
Dialog: 0,0:12:21.28,0:12:23.85, Lalai,,0,0,0,,Dia mungkin mempunyai pengalaman.
Dialog: 0,0:12:25.03,0:12:27.76,Lalai,,0,0,0,,Adakah anda hanya memuji dia?
Dialog: 0,0:12:27.78,0:12:30.14, Lalai,,0,0,0,,Anda memerlukan banyak pengalaman untuk menangkapnya.
Dialog: 0,0:12:30.16,0:12:33.18, Lalai,,0,0,0,, Babi hutan berkulit tebal, jadi\Anda perlu pergi ke tempat yang betul.
Dialog: 0,0:12:33.21,0:12:34.98,Lalai,,0,0,0,,Jika tidak, ia boleh menjadi lebih berbahaya.
Dialog: 0,0:12:35.00,0:12:40.87,Lalai,,0,0,0,,Tepat sekali. Alhamdulillah dia\Nlucky. Bagaimana jika dia terlepas?
Dialog: 0,0:12:42.42,0:12:44.28, Lalai,,0,0,0,,Fikirkanlah.
Dialog: 0,0:12:44.30,0:12:47.70,Lalai,,0,0,0,,Dia tidak sepatutnya bersikap sembrono seperti orang baru.
Dialog: 0,0:12:47.72,0:12:50.62, Lalai,,0,0,0,,Dia seorang marin dalam pasukan pengawal khas.
Dialog: 0,0:12:50.64,0:12:53.09,Lalai,,0,0,0,,- Dia terkenal dengan penggambarannya.\N- Betul ke?
Dialog: 0,0:12:53.14,0:12:54.83, Lalai,,0,0,0,,Ya, sungguh.
Dialog: 0,0:12:54.85,0:12:57.29,Lalai,,0,0,0,,Adakah anda akhirnya faham\Nbetapa bodohnya anda...
Dialog: 0,0:12:57.31,0:12:59.85, Lalai,,0,0,0,,untuk menawarkan untuk mengajarnya cara menembak?
Dialog: 0,0:13:01.28,0:13:02.71, Lalai,,0,0,0,,Satu perkara yang pasti.
Dialog: 0,0:13:02.74,0:13:06.94,Lalai,,0,0,0,,Saya tidak akan berada di sini sekarang\Sekiranya dia teragak-agak walaupun sedikit.
Dialog: 0,0:13:10.28,0:13:11.72, Lalai,,0,0,0,,Awak bertuah.
Dialog: 0,0:13:11.74,0:13:15.11,Lalai,,0,0,0,,- Apa?\N- Saya boleh tahu dari lengannya yang berotot...
Dialog: 0,0:13:15.33,0:13:18.98,Lalai,,0,0,0,,bahawa dia tidak menghabiskan semua\N tahun dia hanya belajar.
Dialog: 0,0:13:19.00,0:13:20.70, Lalai,,0,0,0,,Bagaimana anda boleh tahu?
Dialog: 0,0:13:21.00,0:13:22.65, Lalai,,0,0,0,,Ketika saya di dalam penjara,
Dialog: 0,0:13:22.67,0:13:25.44,Lalai,,0,0,0,,dia menyerahkan perjanjian itu kepada saya\Ndengan lengan berotot itu,
Dialog: 0,0:13:25.47,0:13:28.04, Lalai,,0,0,0,,dan berkata, "Sila tandatangani ini,"
Dialog: 0,0:13:28.43,0:13:30.30,Lalai,,0,0,0,,dan hati saya...
Dialog: 0,0:13:30.47,0:13:31.53, Lalai,,0,0,0,,berkibar.
Dialog: 0,0:13:31.56,0:13:33.84,Lalai,,0,0,0,,- Makcik.\N- Makcik, jom.
Dialog: 0,0:13:37.65,0:13:40.50,Lalai,,0,0,0,,Kadang-kadang awak memukau saya, Hyun-woo.
Dialog: 0,0:13:40.52,0:13:42.92,Lalai,,0,0,0,,{\i1}Bagaimanakah anda membuat\Nkeputusan itu dalam masa yang singkat itu?{\i0}
Dialog: 0,0:13:42.94,0:13:44.96, Lalai,,0,0,0,,Saya tidak fikir.
Dialog: 0,0:13:44.99,0:13:47.13, Lalai,,0,0,0,,Ia adalah naluri.
Dialog: 0,0:13:47.15,0:13:50.59,Lalai,,0,0,0,,Naluri anda tahu anda tidak sepatutnya membiarkan dia mati.
Dialog: 0,0:13:50.62,0:13:55.36, Lalai,,0,0,0,,{\i1}Anda perlu menyelamatkannya supaya dia\N menyemak semula kehendaknya. Betul?{\i0}
Dialog: 0,0:13:56.75,0:13:58.57,Lalai,,0,0,0,,{\i1}Helo?{\i0}
Dialog: 0,0:14:18.52,0:14:20.22, Lalai,,0,0,0,,Di manakah Hae-in?
Dialog: 0,0:14:20.31,0:14:22.08, Lalai,,0,0,0,,Dia mengambil beberapa ubat dan tidur.
Dialog: 0,0:14:22.11,0:14:24.04, Lalai,,0,0,0,,Dia pasti terkejut.
Dialog: 0,0:14:24.07,0:14:26.04, Lalai,,0,0,0,,Saya tidak percaya ini.
Dialog: 0,0:14:26.07,0:14:29.34,Lalai,,0,0,0,,Sebenarnya, saya mengimbas kursus tadi.
Dialog: 0,0:14:29.36,0:14:31.72, Lalai,,0,0,0,,Saya perasan pagar itu terbuka.
Dialog: 0,0:14:31.74,0:14:35.18, Lalai,,0,0,0,,Saya percaya babi yang cedera\N telah masuk melalui lubang itu.
Dialog: 0,0:14:35.20,0:14:38.74, Lalai,,0,0,0,,Itu sepatutnya kursus Pengerusi Hong.
Dialog: 0,0:14:39.12,0:14:41.32, Lalai,,0,0,0,,Apa yang anda perolehi?
Dialog: 0,0:14:41.42,0:14:45.65,Lalai,,0,0,0,,Adakah anda mengatakan seseorang dengan sengaja\Mengumpan babi yang cedera untuk mencederakannya?
Dialog: 0,0:14:45.67,0:14:48.54,Lalai,,0,0,0,,Kami tidak akan tahu, walaupun itu yang berlaku.
Dialog: 0,0:14:50.55,0:14:54.82, Lalai,,0,0,0,,Saya akan menyemak kamera CCTV dan kamera pemuka berdekatan.
Dialog: 0,0:14:54.85,0:14:56.32, Lalai,,0,0,0,,Saya akan menyemaknya sendiri.
Dialog: 0,0:14:56.35,0:14:58.87, Lalai,,0,0,0,,Adakah anda mahu berbuat demikian?
Dialog: 0,0:14:58.89,0:15:00.79, Lalai,,0,0,0,,Baiklah, saya akan sediakan.
Dialog: 0,0:15:00.81,0:15:02.33, Lalai,,0,0,0,,Maaf...
Dialog: 0,0:15:02.35,0:15:06.04, Lalai,,0,0,0,,ini perlu berlaku semasa lawatan anda, Encik Yoon.
Dialog: 0,0:15:06.07,0:15:08.25, Lalai,,0,0,0,,Jangan risau, tuan.
Dialog: 0,0:15:08.28,0:15:10.01, Lalai,,0,0,0,, En. Yoon, cuba sup.
Dialog: 0,0:15:10.03,0:15:12.48, Lalai,,0,0,0,,Saya menangkap burung itu.
Dialog: 0,0:15:13.20,0:15:17.07, Lalai,,0,0,0,,Ayuh. Jangan berbohong, ayah.
Dialog: 0,0:15:17.37,0:15:19.90,Lalai,,0,0,0,,Kami membelinya di ladang berdekatan.
Dialog: 0,0:15:23.21,0:15:24.73, Lalai,,0,0,0,,Baiklah. Jom makan.
Dialog: 0,0:15:24.75,0:15:26.49, Lalai,,0,0,0,, Makan.
Dialog: 0,0:15:35.26,0:15:37.01, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:15:53.41,0:15:55.84, Lalai,,0,0,0,,Mengapa anda menyedapkan akar bunga loceng?
Dialog: 0,0:15:55.87,0:15:58.85, Lalai,,0,0,0,,Hyun-woo lebih suka mereka charbroiled.
Dialog: 0,0:15:58.87,0:16:01.24, Lalai,,0,0,0,,Tidak, saya juga suka ini.
Dialog: 0,0:16:01.41,0:16:02.47, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:16:02.50,0:16:04.57,Lalai,,0,0,0,,Ya.
Dialog: 0,0:16:04.83,0:16:06.23, Lalai,,0,0,0,, Makan.
Dialog: 0,0:16:06.25,0:16:08.41, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:16:11.05,0:16:12.11,Lalai,,0,0,0,,En. Yoon.
Dialog: 0,0:16:12.13,0:16:13.57, Lalai,,0,0,0,,Ini adalah daun lakuer.
Dialog: 0,0:16:13.59,0:16:15.61, Lalai,,0,0,0,,Ia agak jarang berlaku.
Dialog: 0,0:16:15.64,0:16:18.62, Lalai,,0,0,0,,Yang baka gunung adalah\Sangat sedap dan sukar dicari.
Dialog: 0,0:16:18.64,0:16:20.12,Lalai,,0,0,0,,Saya mempunyainya semasa saya masih muda.
Dialog: 0,0:16:20.14,0:16:21.88, Lalai,,0,0,0,,"Lebih muda"?
Dialog: 0,0:16:22.27,0:16:24.62,Lalai,,0,0,0,,Bukankah anda dibesarkan di A.S.?
Dialog: 0,0:16:24.65,0:16:29.27,Lalai,,0,0,0,,Tidak, saya pergi ke sana semasa saya berumur 13 tahun\Tidak. Saya berada di Korea sehingga itu.
Dialog: 0,0:16:29.36,0:16:32.38,Lalai,,0,0,0,,Adakah keluarga anda berhijrah ke sana\Anda juga tidak belajar di luar negara?
Dialog: 0,0:16:32.40,0:16:34.01, Lalai,,0,0,0,,Saya telah diterima pakai di luar negara.
Dialog: 0,0:16:34.03,0:16:38.02,Lalai,,0,0,0,,Ibu bapa angkat saya meninggal dunia\Sejurus sebelum saya menamatkan pengajian,
Dialog: 0,0:16:38.08,0:16:41.11, Lalai,,0,0,0,,jadi saya tiada keluarga sekarang.
Dialog: 0,0:16:41.66,0:16:44.68, Lalai,,0,0,0,,Saya kehilangan ibu bapa saya pada 15,
Dialog: 0,0:16:44.71,0:16:47.06, Lalai,,0,0,0,,dan saya datang sejauh ini sendirian.
Dialog: 0,0:16:47.08,0:16:49.87, Lalai,,0,0,0,,Saya tidak mengetahui sejarah keluarga anda.
Dialog: 0,0:16:49.92,0:16:52.82,Lalai,,0,0,0,,Anda tidak seperti generasi muda hari ini.
Dialog: 0,0:16:52.84,0:16:53.94,Lalai,,0,0,0,,Saya setuju.
Dialog: 0,0:16:53.97,0:16:57.07,Lalai,,0,0,0,,Saya bangga dengan awak seperti saya ibu awak.
Dialog: 0,0:16:57.09,0:17:01.74, Lalai,,0,0,0,,Anggap kami keluarga Korea anda.
Dialog: 0,0:17:01.77,0:17:03.03, Lalai,,0,0,0,,Saya menghargainya.
Dialog: 0,0:17:03.06,0:17:04.93, Lalai,,0,0,0,, Makan.
Dialog: 0,0:17:09.57,0:17:11.93, Lalai,,0,0,0,, Kemari. Ya, di sini.
Dialog: 0,0:17:14.74,0:17:16.44, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:17:17.61,0:17:19.72,Lalai,,0,0,0,,Adakah dia anjing Pungsan?
Dialog: 0,0:17:19.74,0:17:21.01, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:17:21.04,0:17:23.26,Lalai,,0,0,0,,Dia seorang yang kacak.
Dialog: 0,0:17:23.29,0:17:24.89,Lalai,,0,0,0,,Bukan sahaja dia kacak,
Dialog: 0,0:17:24.91,0:17:28.52,Lalai,,0,0,0,,tetapi dia menyelamatkan anak saya bertahun-tahun\N ketika rumah kami terbakar.
Dialog: 0,0:17:28.54,0:17:29.73, Lalai,,0,0,0,,- Adakah itu benar?\N- Ya, tuan.
Dialog: 0,0:17:29.75,0:17:31.23, Lalai,,0,0,0,,Anak saya seorang diri di rumah.
Dialog: 0,0:17:31.25,0:17:34.02, Lalai,,0,0,0,,Dia akan kehilangan nyawanya jika\anjing Nour tidak menyedarkannya...
Dialog: 0,0:17:34.05,0:17:36.21, Lalai,,0,0,0,,dan menyeretnya keluar.
Dialog: 0,0:17:36.93,0:17:41.30,Lalai,,0,0,0,,Dia bijak dan setia.
Dialog: 0,0:17:42.64,0:17:45.59, Lalai,,0,0,0,, Adakah anda sanggup menjualnya?
Dialog: 0,0:17:46.35,0:17:47.87,Lalai,,0,0,0,,Nah...
Dialog: 0,0:17:47.90,0:17:49.60,Lalai,,0,0,0,,Maaf, tuan.
Dialog: 0,0:17:50.06,0:17:52.14, Lalai,,0,0,0,,Dia keluarga.
Dialog: 0,0:18:03.54,0:18:06.78,Lalai,,0,0,0,,- Saya akan beri awak $100,000.\N- Maaf?
Dialog: 0,0:18:12.42,0:18:15.61,Lalai,,0,0,0,,Tetapi dia tidak mempunyai keturunan.
Dialog: 0,0:18:15.63,0:18:16.78, Lalai,,0,0,0,,Itu tidak penting.
Dialog: 0,0:18:16.80,0:18:19.13, Lalai,,0,0,0,,Saya akan tawarkan lebih sedikit mengikut masa.
Dialog: 0,0:18:21.68,0:18:23.67, Lalai,,0,0,0,,$90,000.
Dialog: 0,0:18:35.94,0:18:38.05, Lalai,,0,0,0,,- $80,000.\N- Tunggu.
Dialog: 0,0:18:38.07,0:18:39.76,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:18:39.78,0:18:41.05,Lalai,,0,0,0,,Saya akan jual dia,
Dialog: 0,0:18:41.07,0:18:42.59,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:18:42.62,0:18:44.94, Lalai,,0,0,0,,bolehkah anda memberi kami $100,000?
Dialog: 0,0:18:46.95,0:18:48.78, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:19:04.76,0:19:05.99, Lalai,,0,0,0,, Sayang.
Dialog: 0,0:19:06.01,0:19:08.45, Lalai,,0,0,0,,Hanya satu perkara yang saya tiada.
Dialog: 0,0:19:08.48,0:19:09.91,Lalai,,0,0,0,,Ini prasangka, bukan?
Dialog: 0,0:19:09.94,0:19:11.55, Lalai,,0,0,0,,Tetapi bagaimana pula?
Dialog: 0,0:19:11.81,0:19:13.25, Lalai,,0,0,0,,Ini mengenai Encik Yoon.
Dialog: 0,0:19:13.27,0:19:17.67, Lalai,,0,0,0,,Tidakkah dia kelihatan terlalu santai untuk\Nseseorang yang telah melalui begitu banyak dalam hidup?
Dialog: 0,0:19:17.69,0:19:20.00, Lalai,,0,0,0,,Dia pasti bekerja keras untuk menebusnya.
Dialog: 0,0:19:20.03,0:19:21.51, Lalai,,0,0,0,,Jangan nilai buku dari kulitnya.
Dialog: 0,0:19:21.53,0:19:24.34,Lalai,,0,0,0,,Anda tidak akan tahu apa yang\Nseseorang fikirkan jauh di lubuk hati.
Dialog: 0,0:19:24.37,0:19:25.85, Lalai,,0,0,0,,Adakah anda pasti anda berasal dari A.S.?
Dialog: 0,0:19:25.87,0:19:29.51,Lalai,,0,0,0,,Anda tahu bahasa kami dan\NKpepatah Korea lebih baik daripada saya.
Dialog: 0,0:19:29.54,0:19:30.85, Lalai,,0,0,0,,Saya sudah beritahu anda.
Dialog: 0,0:19:30.87,0:19:35.77,Lalai,,0,0,0,,Ayah membuatkan kami hanya bercakap\NKKorea dan membaca buku Korea di rumah.
Dialog: 0,0:19:35.79,0:19:36.86, Lalai,,0,0,0,, Sungguh lelaki yang bijak.
Dialog: 0,0:19:36.88,0:19:40.33, Lalai,,0,0,0,,Bukan semua orang boleh menjadi profesor Ivy League.
Dialog: 0,0:19:41.30,0:19:43.04, Lalai,,0,0,0,,Adakah anda mahukan beberapa?
Dialog: 0,0:19:45.85,0:19:49.22,Lalai,,0,0,0,,Betul. Malah bir terlalu pahit untuk anda.
Dialog: 0,0:19:53.73,0:19:57.29,Lalai,,0,0,0,,Awak tahu saya rasa sedih kerana\NI tidak boleh menjadi kawan minum awak, bukan?
Dialog: 0,0:19:57.32,0:19:59.75, Lalai,,0,0,0,,Apa maksud anda? Jangan rasa teruk.
Dialog: 0,0:19:59.78,0:20:01.52, Lalai,,0,0,0,,Saya perlukan tandas.
Dialog: 0,0:20:16.46,0:20:18.33, Lalai,,0,0,0,,Dia sangat cerewet.
Dialog: 0,0:20:29.39,0:20:32.26,Lalai,,0,0,0,,Bilik anda adalah yang terakhir\Tiada di tingkat dua.
Dialog: 0,0:20:33.10,0:20:35.00, Lalai,,0,0,0,,Ya, saya tahu.
Dialog: 0,0:20:35.02,0:20:37.01, Lalai,,0,0,0,,Selamat malam.
Dialog: 0,0:20:37.48,0:20:39.35, Lalai,,0,0,0,,Anda harus naik ke atas.
Dialog: 0,0:20:39.78,0:20:41.09, Lalai,,0,0,0,,Saya akan.
Dialog: 0,0:20:41.11,0:20:42.85, Lalai,,0,0,0,,Selamat malam, kalau begitu.
Dialog: 0,0:20:43.86,0:20:45.61, Lalai,,0,0,0,,Betul, Soo-cheol.
Dialog: 0,0:20:47.91,0:20:49.97, Lalai,,0,0,0,,Anda meminta nasihat saya kali terakhir...
Dialog: 0,0:20:49.99,0:20:52.76, Lalai,,0,0,0,, tentang cara untuk mendapatkan sisi baik ahli KFTC...
Dialog: 0,0:20:52.79,0:20:54.18, Lalai,,0,0,0,,apabila mereka memanggil anda.
Dialog: 0,0:20:54.21,0:20:56.03, Lalai,,0,0,0,, Betul.
Dialog: 0,0:20:56.50,0:20:57.69, Lalai,,0,0,0,,Apa kata anda?
Dialog: 0,0:20:57.71,0:21:00.52, Lalai,,0,0,0,,Adakah anda mahukan beberapa petua terperinci sekarang?
Dialog: 0,0:21:00.55,0:21:02.25, Lalai,,0,0,0,,Sekarang?
Dialog: 0,0:21:02.46,0:21:06.78,Lalai,,0,0,0,,Berdasarkan kepakaran undang-undang yang saya peroleh\Nsemasa sekolah undang-undang di SNU,
Dialog: 0,0:21:06.80,0:21:10.57, Lalai,,0,0,0,, dan bertahun-tahun bekerja di pasukan undang-undang,
Dialog: 0,0:21:10.60,0:21:15.51, Lalai,,0,0,0,,Saya boleh menawarkan penjelasan mudah\Nyet yang luas.
Dialog: 0,0:21:15.69,0:21:20.01, Lalai,,0,0,0,,Saya bebas sehingga larut malam.
Dialog: 0,0:21:20.36,0:21:22.81, Lalai,,0,0,0,,Saya tidak. Isteri saya sedang menunggu saya.
Dialog: 0,0:21:23.40,0:21:25.35, Lalai,,0,0,0,, Betulkah? Alangkah malunya.
Dialog: 0,0:21:26.32,0:21:29.77,Lalai,,0,0,0,,Maksud saya, ia memalukan anda.
Dialog: 0,0:21:29.91,0:21:32.24, Lalai,,0,0,0,,Ini adalah peluang yang hebat.
Dialog: 0,0:21:36.16,0:21:37.91, Lalai,,0,0,0,,Adakah anda takut?
Dialog: 0,0:21:38.71,0:21:40.58, Lalai,,0,0,0,, Daripada apa?
Dialog: 0,0:21:41.04,0:21:43.41, Lalai,,0,0,0,,Tidur dalam bilik yang sama dengan Hae-in.
Dialog: 0,0:21:55.35,0:21:57.22,Lalai,,0,0,0,,Soo-cheol.
Dialog: 0,0:21:57.48,0:21:59.66, Lalai,,0,0,0,,Itu tidak masuk akal.
Dialog: 0,0:21:59.69,0:22:00.79,Lalai,,0,0,0,,Kami sudah berkahwin.
Dialog: 0,0:22:00.81,0:22:03.84, Lalai,,0,0,0,,Mengapa saya takut\Ntidur di sebelah isteri saya?
Dialog: 0,0:22:03.86,0:22:05.73, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:22:10.28,0:22:13.11, Lalai,,0,0,0,,Nak ke mana? Bilik awak ada di atas sana.
Dialog: 0,0:22:16.29,0:22:18.03, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:22:21.67,0:22:23.45, Lalai,,0,0,0,, Pergi terus.
Dialog: 0,0:22:26.92,0:22:29.04, Lalai,,0,0,0,,Saya benar-benar...
Dialog: 0,0:22:30.01,0:22:31.71,Default,,0,0,0,,kesian dia.
Dialog: 0,0:22:42.86,0:22:45.63, Lalai,,0,0,0,,- Di manakah alkoholnya?\N- Apa yang anda maksudkan?
Dialog: 0,0:22:45.65,0:22:47.85, Lalai,,0,0,0,,Anda telah minum semuanya.
Dialog: 0,0:22:47.99,0:22:49.09, Lalai,,0,0,0,,Saya lakukan?
Dialog: 0,0:22:49.11,0:22:51.05,Lalai,,0,0,0,,Adakah anda sudah mabuk?
Dialog: 0,0:22:51.07,0:22:53.07, Lalai,,0,0,0,,Sungguh comel.
Dialog: 0,0:22:53.87,0:22:56.03, Lalai,,0,0,0,,- Jom tidur.\N- Okay.
Dialog: 0,0:22:58.25,0:23:00.74, Lalai,,0,0,0,,Saya minum semuanya.
Dialog: 0,0:23:40.54,0:23:42.37, Lalai,,0,0,0,,Apa yang menyebabkan anda terlalu lama?
Dialog: 0,0:23:43.00,0:23:45.12, Lalai,,0,0,0,,Anda tidak tidur?
Dialog: 0,0:23:45.34,0:23:47.20,Lalai,,0,0,0,,Saya bangun.
Dialog: 0,0:23:48.84,0:23:50.83, Lalai,,0,0,0,,Saya bertanyakan soalan kepada anda.
Dialog: 0,0:23:51.80,0:23:53.38,Lalai,,0,0,0,,Betul.
Dialog: 0,0:23:53.43,0:23:56.45,Lalai,,0,0,0,,Soo-cheol bertanya sesuatu kepada saya,\Njadi kami bercakap.
Dialog: 0,0:23:56.47,0:23:58.24,Lalai,,0,0,0,,Apa?
Dialog: 0,0:23:58.27,0:24:00.55, Lalai,,0,0,0,,Si gila itu.
Dialog: 0,0:24:00.68,0:24:03.18, Lalai,,0,0,0,,Adakah dia mengganggu anda pada jam ini?
Dialog: 0,0:24:04.06,0:24:06.08, Lalai,,0,0,0,, Sayang. Hae-in.
Dialog: 0,0:24:06.11,0:24:10.39, Lalai,,0,0,0,,Tolong jangan jadi panas baran.
Dialog: 0,0:24:10.49,0:24:12.96, Lalai,,0,0,0,, Patutkah saya kembali ke sana...
Dialog: 0,0:24:12.99,0:24:15.68, Lalai,,0,0,0,,dan beri dia amaran keras?
Dialog: 0,0:24:15.70,0:24:17.53, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:24:18.79,0:24:21.51,Lalai,,0,0,0,,Betul ke? Itu yang saya fikirkan.
Dialog: 0,0:24:21.54,0:24:23.39, Lalai,,0,0,0,,- Bantu saya menanggalkan baju atasan saya.\N- Apa?
Dialog: 0,0:24:23.42,0:24:26.89,Lalai,,0,0,0,,Saya rasa saya terseliuh jari.\NISakit untuk membuka butang itu.
Dialog: 0,0:24:26.92,0:24:28.62,Lalai,,0,0,0,,Bolehkah anda melakukannya?
Dialog: 0,0:24:33.80,0:24:35.84, Lalai,,0,0,0,,- Saya?\N- Ya.
Dialog: 0,0:24:36.01,0:24:39.28, Lalai,,0,0,0,,- Buka butang anda?\N- Ya, kembali ke sini.
Dialog: 0,0:24:39.31,0:24:41.01, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:24:57.99,0:24:59.55,Lalai,,0,0,0,,Cukuplah.
Dialog: 0,0:24:59.58,0:25:02.51, Lalai,,0,0,0,,Selebihnya saya boleh lakukan.
Dialog: 0,0:25:02.54,0:25:04.49,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:25:05.67,0:25:07.37,Lalai,,0,0,0,,Betul.
Dialog: 0,0:25:16.68,0:25:18.07, Lalai,,0,0,0,,Kenapa awak tak buka baju?
Dialog: 0,0:25:18.09,0:25:19.63, Lalai,,0,0,0,,Adakah saya perlu?
Dialog: 0,0:25:21.10,0:25:23.26, Lalai,,0,0,0,,Anda tidak mandi?
Dialog: 0,0:25:23.31,0:25:25.01, Lalai,,0,0,0,,Adakah saya perlu?
Dialog: 0,0:25:38.66,0:25:40.86,Lalai,,0,0,0,,Saya tidak patut keluar?
Dialog: 0,0:25:57.80,0:25:59.45, Lalai,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:25:59.47,0:26:02.80,Default,,0,0,0,,Jangan glamor dia. Dia tidak begitu kacak.
Dialog: 0,0:26:18.70,0:26:20.44,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey?{\c}{\i0}
Dialog: 0,0:26:20.78,0:26:22.72, Lalai,,0,0,0,,No. Hentikan.
Dialog: 0,0:26:22.74,0:26:25.95, Lalai,,0,0,0,,Jangan mainkan semula dalam gerakan perlahan.
Dialog: 0,0:26:30.88,0:26:32.70, Lalai,,0,0,0,,Jangan lakukannya.
Dialog: 0,0:26:33.09,0:26:34.83, Lalai,,0,0,0,,Jangan.
Dialog: 0,0:26:48.64,0:26:51.50, Lalai,,0,0,0,,Saya tidak dapat mencari...
Dialog: 0,0:26:51.52,0:26:53.26, Lalai,,0,0,0,,jubah mandi.
Dialog: 0,0:26:57.53,0:26:59.23,Lalai,,0,0,0,,Betul.
Dialog: 0,0:26:59.36,0:27:01.06, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:27:52.29,0:27:54.12, Lalai,,0,0,0,,Saya sangat terkedu.
Dialog: 0,0:27:55.29,0:27:57.08, Lalai,,0,0,0,,Adakah dia berfikir...
Dialog: 0,0:27:57.80,0:27:59.32,Lalai,,0,0,0,,dia seksi?
Dialog: 0,0:27:59.34,0:28:04.38, Lalai,,0,0,0,,Apa yang berlaku pada tubuhnya?
Dialog: 0,0:28:07.64,0:28:10.17, Lalai,,0,0,0,, Serius.
Dialog: 0,0:28:25.07,0:28:27.09,Lalai,,0,0,0,,Apa? apa yang awak nak?
Dialog: 0,0:28:27.12,0:28:28.82, Lalai,,0,0,0,,Saya...
Dialog: 0,0:28:29.79,0:28:32.78, Lalai,,0,0,0,,Ada banyak air di atas lantai.
Dialog: 0,0:28:34.33,0:28:37.62, Lalai,,0,0,0,,Anda tidak suka itu, jadi saya akan menghapuskannya.
Dialog: 0,0:28:38.38,0:28:40.06, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:28:40.09,0:28:41.91, Lalai,,0,0,0,,Keringkan sahaja rambut anda.
Dialog: 0,0:28:44.22,0:28:45.92,Lalai,,0,0,0,,Jangan beritahu saya...
Dialog: 0,0:28:47.26,0:28:49.41,Lalai,,0,0,0,,anda tidak mengeringkan rambut anda...
Dialog: 0,0:28:49.43,0:28:51.58,Lalai,,0,0,0,,kerana anda melihat cermin...
Dialog: 0,0:28:51.60,0:28:54.29, Lalai,,0,0,0,, dan fikir anda kelihatan seperti...
Dialog: 0,0:28:54.31,0:28:58.22, Lalai,,0,0,0,,Timothée Chalamet yang basah kuyup\Maupun Leonardo DiCaprio yang masih muda.
Dialog: 0,0:28:59.48,0:29:01.25, Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,0:29:01.28,0:29:03.19, Lalai,,0,0,0,,Jika bukan itu sebabnya,
Dialog: 0,0:29:03.86,0:29:05.86, Lalai,,0,0,0,,kemudian keringkan rambut anda.
Dialog: 0,0:29:06.78,0:29:08.47, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:29:08.49,0:29:10.19, Lalai,,0,0,0,,Saya akan.
Dialog: 0,0:29:17.17,0:29:18.56,Lalai,,0,0,0,,Sukar dipercayai.
Dialog: 0,0:29:18.59,0:29:20.74, Lalai,,0,0,0,,Adakah dia cuba memikat saya?
Dialog: 0,0:29:25.55,0:29:27.25,Lalai,,0,0,0,,Saya terlalu terangsang...
Dialog: 0,0:29:27.80,0:29:29.67, Lalai,,0,0,0,,untuk jam ini.
Dialog: 0,0:29:49.62,0:29:51.32, Lalai,,0,0,0,,Adakah anda sedang tidur?
Dialog: 0,0:29:56.04,0:29:57.95, Lalai,,0,0,0,,Belum.
Dialog: 0,0:29:58.17,0:30:01.08, Lalai,,0,0,0,,Katilnya kecil.
Dialog: 0,0:30:02.46,0:30:03.90, Lalai,,0,0,0,,Adakah ini bersaiz queen?
Dialog: 0,0:30:03.92,0:30:05.02, Lalai,,0,0,0,,Ini raja.
Dialog: 0,0:30:08.43,0:30:10.75, Lalai,,0,0,0,,Rasanya terlalu kecil...
Dialog: 0,0:30:11.39,0:30:12.66, Lalai,,0,0,0,,untuk bersaiz raja.
Dialog: 0,0:30:12.68,0:30:14.63, Lalai,,0,0,0,,Ada masa...
Dialog: 0,0:30:15.60,0:30:17.80, Lalai,,0,0,0,,ketika kami tidur bersama...
Dialog: 0,0:30:17.98,0:30:20.26, Lalai,,0,0,0,,di atas katil bujang.
Dialog: 0,0:30:21.31,0:30:23.06, Lalai,,0,0,0,,Bila?
Dialog: 0,0:30:23.57,0:30:25.27,Lalai,,0,0,0,,Tidakkah anda ingat?
Dialog: 0,0:30:25.74,0:30:27.94, Lalai,,0,0,0,,Lawatan pertama saya ke Yongdu-ri.
Dialog: 0,0:30:32.53,0:30:35.58,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sijil Anugerah\NDiligence Award{\c}{\i0}
Dialog: 0,0:30:53.39,0:30:56.51, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bermalam di sini.{\c}{\i0}
Dialog: 0,0:31:09.32,0:31:11.94, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sudah terlambat.{\c}{\i0}
Dialog: 0,0:31:14.83,0:31:16.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Pukul 9 malam{\c}{\i0}
Dialog: 0,0:31:16.41,0:31:20.03, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sudah agak lewat.{\c}{\i0}
Dialog: 0,0:31:20.16,0:31:23.14, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Memandu pada waktu malam berbahaya.\N- Betul.{\c}{\i0}
Dialog: 0,0:31:23.17,0:31:24.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Betul.{\c}{\i0}
Dialog: 0,0:31:25.96,0:31:27.11, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidur di sini.{\c}{\i0}
Dialog: 0,0:31:27.13,0:31:30.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan berada di dalam bilik itu.{\c}{\i0}
Dialog: 0,0:31:31.05,0:31:33.46,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan berada di sana...{\c}{\i0}
Dialog: 0,0:31:33.64,0:31:35.96,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jika anda memerlukan saya.{\c}{\i0}
Dialog: 0,0:31:37.27,0:31:38.97,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Selamat malam, kalau begitu.{\c}{\i0}
Dialog: 0,0:32:30.78,0:32:33.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bulan kelihatan cantik.{\c}{\i0}
Dialog: 0,0:32:34.53,0:32:37.15,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mungkin kita boleh melihatnya bersama-sama.{\c}{\i0}
Dialog: 0,0:32:40.16,0:32:41.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Masuk...{\c}{\i0}
Dialog: 0,0:32:44.17,0:32:45.95, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jika anda mahu.{\c}{\i0}
Dialog: 0,0:33:18.28,0:33:20.23,Lalai,,0,0,0,,- By the way...\N- Ya?
Dialog: 0,0:33:20.28,0:33:23.15, Lalai,,0,0,0,,Bagaimana kami tidur...
Dialog: 0,0:33:24.41,0:33:26.16, Lalai,,0,0,0,,di atas katil itu?
Dialog: 0,0:33:26.25,0:33:28.20, Lalai,,0,0,0,,Kami berpelukan.
Dialog: 0,0:33:28.42,0:33:30.02,Lalai,,0,0,0,,Betul.
Dialog: 0,0:33:30.04,0:33:31.75, Lalai,,0,0,0,,Adakah kita berpelukan?
Dialog: 0,0:33:32.05,0:33:35.37,Lalai,,0,0,0,,Adakah anda mahu berpelukan jika katil terlalu kecil?
Dialog: 0,0:33:38.39,0:33:41.26,Lalai,,0,0,0,,Saya okay.
Dialog: 0,0:33:41.47,0:33:43.22, Lalai,,0,0,0,,Ia tidak terlalu kecil.
Dialog: 0,0:33:43.39,0:33:45.63, Lalai,,0,0,0,,Saya ada sedikit ruang.
Dialog: 0,0:33:48.40,0:33:50.21,Lalai,,0,0,0,,- Betulkah?\N- Ya.
Dialog: 0,0:33:50.23,0:33:51.89,Lalai,,0,0,0,,Kemudian...
Dialog: 0,0:33:54.90,0:33:56.85,Default,,0,0,0,,nak peluk...
Dialog: 0,0:33:57.24,0:33:59.11, Lalai,,0,0,0,,tetapi?
Dialog: 0,0:34:14.42,0:34:16.08, Lalai,,0,0,0,,Saya cuma bergurau.
Dialog: 0,0:34:17.88,0:34:19.59,Lalai,,0,0,0,,Jangan takut sangat.
Dialog: 0,0:35:04.60,0:35:06.63, Lalai,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:35:07.23,0:35:08.37, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:35:08.39,0:35:10.08, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:35:10.10,0:35:13.60,Lalai,,0,0,0,,Saya tidak waras semalam.
Dialog: 0,0:35:15.23,0:35:16.46, Lalai,,0,0,0,,Saya ingin mengembalikan ini.
Dialog: 0,0:35:16.48,0:35:19.73, Lalai,,0,0,0,,Tolong bantu kami. Kami tidak dapat tidur semalam.
Dialog: 0,0:35:20.91,0:35:24.89,Lalai,,0,0,0,,Saya sudah menghadiahkan anjing itu\Nia, jadi saya tidak boleh berbuat demikian.
Dialog: 0,0:35:24.91,0:35:26.64, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:35:26.66,0:35:29.47,Lalai,,0,0,0,,Dia adalah keluarga kami, sejak dia menyelamatkan anak kami.
Dialog: 0,0:35:29.50,0:35:33.24,Lalai,,0,0,0,,Saya pasti gila kerana telah menjualnya.
Dialog: 0,0:35:33.38,0:35:34.90,Lalai,,0,0,0,,Baiklah. Saya akan ambil ini.
Dialog: 0,0:35:34.92,0:35:36.86, Lalai,,0,0,0,,- Terima kasih.\N- Terima kasih.
Dialog: 0,0:35:36.88,0:35:38.86, Lalai,,0,0,0,,Terima kasih banyak, tuan.
Dialog: 0,0:35:38.88,0:35:40.03, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:35:40.05,0:35:41.67, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:35:41.93,0:35:44.13,Lalai,,0,0,0,,Anda rasa bersalah kerana menjual dia.
Dialog: 0,0:35:46.26,0:35:48.26,Lalai,,0,0,0,,Jadi mari kita bunuh dia.
Dialog: 0,0:35:48.43,0:35:50.26, Lalai,,0,0,0,,Adakah itu lebih baik?
Dialog: 0,0:35:51.27,0:35:53.39, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:36:01.70,0:36:04.40,Lalai,,0,0,0,,Aduh, saya hampir tembak awak lagi.
Dialog: 0,0:36:07.62,0:36:09.32, Lalai,,0,0,0,,Saya bertanyakan soalan kepada anda.
Dialog: 0,0:36:10.87,0:36:12.82, Lalai,,0,0,0,,Saya hanya bergurau.
Dialog: 0,0:36:14.13,0:36:15.69, Lalai,,0,0,0,,Adakah itu gurauan kepada anda?
Dialog: 0,0:36:15.71,0:36:18.04, Lalai,,0,0,0,,Apa pendapat anda?
Dialog: 0,0:36:21.72,0:36:23.71,Lalai,,0,0,0,,Adakah anda memulangkan wang itu?
Dialog: 0,0:36:24.97,0:36:26.75,Lalai,,0,0,0,,Adakah anda faham?
Dialog: 0,0:36:27.18,0:36:29.21,Lalai,,0,0,0,,Saya saksi anda.
Dialog: 0,0:36:30.22,0:36:32.09,Lalai,,0,0,0,,Perjanjian telah tamat.
Dialog: 0,0:36:37.69,0:36:39.25, Lalai,,0,0,0,,Anda boleh pergi.
Dialog: 0,0:36:39.28,0:36:41.21,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:36:41.24,0:36:43.48, Lalai,,0,0,0,,Terima kasih. jom pergi.
Dialog: 0,0:36:43.65,0:36:45.65,Lalai,,0,0,0,,- Cepat.\N- By the way,
Dialog: 0,0:36:46.66,0:36:48.36, Lalai,,0,0,0,,kenapa saya tidak boleh membunuhnya?
Dialog: 0,0:36:48.53,0:36:49.89, Lalai,,0,0,0,,Anda mendengarnya.
Dialog: 0,0:36:49.91,0:36:51.64, Lalai,,0,0,0,,Dia menyayangi anjing itu.
Dialog: 0,0:36:51.66,0:36:53.35, Lalai,,0,0,0,,Anjing itu seperti keluarga.
Dialog: 0,0:36:55.21,0:36:59.75, Lalai,,0,0,0,,Dalam kes itu, adakah wajar untuk\Nbunuh anjing yang terbiar atau terbiar?
Dialog: 0,0:37:21.36,0:37:24.44,Lalai,,0,0,0,,Itulah pintu masuk ke hutan.
Dialog: 0,0:37:24.74,0:37:27.51,Lalai,,0,0,0,,Tiada orang lain yang masuk kecuali keluarga kami.
Dialog: 0,0:37:27.53,0:37:31.69, Lalai,,0,0,0,,Adakah ini bermakna ini adalah kerja dalaman?
Dialog: 0,0:37:33.37,0:37:34.91,Lalai,,0,0,0,,Tahan.
Dialog: 0,0:37:41.88,0:37:43.83, Lalai,,0,0,0,,Berhenti di situ.
Dialog: 0,0:37:49.80,0:37:50.86, Lalai,,0,0,0,,Siapa itu?
Dialog: 0,0:37:50.89,0:37:52.41, Lalai,,0,0,0,,Saya hanya boleh melihat belakangnya.
Dialog: 0,0:37:52.43,0:37:54.17,Lalai,,0,0,0,,Itu abang awak.
Dialog: 0,0:37:57.02,0:37:58.04, Lalai,,0,0,0,,Itu tidak boleh.
Dialog: 0,0:37:58.06,0:37:59.37,Lalai,,0,0,0,,Sayang.
Dialog: 0,0:37:59.40,0:38:00.58,Lalai,,0,0,0,,Kami tidak tahu pasti.
Dialog: 0,0:38:00.61,0:38:02.88, Lalai,,0,0,0,, Beom-seok tidak akan berbuat demikian.
Dialog: 0,0:38:02.90,0:38:05.21,Lalai,,0,0,0,,Ketahui sama ada dia masih di Korea.
Dialog: 0,0:38:05.24,0:38:06.38, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:38:06.40,0:38:08.11, Lalai,,0,0,0,, Kemaskan.
Dialog: 0,0:38:08.70,0:38:10.26,Lalai,,0,0,0,,- Sudah?\N- Hari ini rosak.
Dialog: 0,0:38:10.28,0:38:12.07,Lalai,,0,0,0,,Jom pulang.
Dialog: 0,0:38:12.70,0:38:15.70,Lalai,,0,0,0,,- Sayang, awak ingat budak tu?\N- Apa?
Dialog: 0,0:38:15.91,0:38:19.64, Lalai,,0,0,0,,Ia berlaku lebih dua dekad yang lalu.
Dialog: 0,0:38:19.67,0:38:22.19,Lalai,,0,0,0,,Kejadian di mana Jerman\NSGembala sebuah kilang bir meninggal dunia,
Dialog: 0,0:38:22.21,0:38:24.17,Lalai,,0,0,0,,dan pembunuhnya ternyata seorang budak kecil.
Dialog: 0,0:38:24.19,0:38:26.98, Lalai,,0,0,0,,Betul, yang dari\NEvergreen Hope Orphanage.
Dialog: 0,0:38:27.01,0:38:30.86,Lalai,,0,0,0,,Dia menerima biasiswa daripada\NQueens Group kerana dia sangat bijak.
Dialog: 0,0:38:30.89,0:38:33.41,Lalai,,0,0,0,,Saya memberinya makan beberapa kali apabila dia melawat.
Dialog: 0,0:38:33.43,0:38:34.49,Lalai,,0,0,0,,{\i1}Ya, dia.{\i0}
Dialog: 0,0:38:34.52,0:38:37.41,Lalai,,0,0,0,,{\i1}Ingat apa yang dia katakan kepada polis?{\i0}
Dialog: 0,0:38:37.44,0:38:39.68,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ini awak, bukan?{\c}{\i0}
Dialog: 0,0:38:41.40,0:38:43.83, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda membunuh anjing berharga seseorang?{\c}{\i0}
Dialog: 0,0:38:43.86,0:38:45.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak akan membiarkan ini berlalu.{\c}{\i0}
Dialog: 0,0:38:45.57,0:38:48.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda tahu berapa kosnya?{\c}{\i0}
Dialog: 0,0:38:48.24,0:38:49.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya minta maaf.{\c}{\i0}
Dialog: 0,0:38:49.78,0:38:52.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Minta maaf kepadanya seketika ini.{\c}{\i0}
Dialog: 0,0:38:53.49,0:38:56.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah yang membezakan anjing berharga?{\c}{\i0}
Dialog: 0,0:38:59.17,0:39:01.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kalau begitu, bolehkah membunuh...{\c}{\i0}
Dialog: 0,0:39:02.67,0:39:04.83, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anjing biasa?{\c}{\i0}
Dialog: 0,0:39:05.09,0:39:07.07,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apa yang salah dengan budak itu?{\c}{\i0}
Dialog: 0,0:39:07.09,0:39:08.83,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Aduh, apa yang dia cakap?{\c}{\i0}
Dialog: 0,0:39:09.47,0:39:10.74,Lalai,,0,0,0,,{\i1}Aduh, awak betul.{\i0}
Dialog: 0,0:39:10.76,0:39:12.79, Lalai,,0,0,0,,Dia bertanya soalan itu.
Dialog: 0,0:39:12.89,0:39:15.24, Lalai,,0,0,0,,Sungguh menyeramkan mendengar budak lelaki berkata begitu.
Dialog: 0,0:39:15.26,0:39:17.72,Lalai,,0,0,0,,- Bukankah dia kelihatan seperti dia?\N- Siapa?
Dialog: 0,0:40:02.35,0:40:04.97, Lalai,,0,0,0,,Hei, ini saya. Adakah anda pulang dengan selamat?
Dialog: 0,0:40:05.02,0:40:07.52,Lalai,,0,0,0,,Saya telah menempah pertemuan dengan En. Hermann.
Dialog: 0,0:40:07.94,0:40:09.68,Lalai,,0,0,0,,Adakah anda serius?
Dialog: 0,0:40:10.40,0:40:11.55, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:40:11.57,0:40:13.56, Lalai,,0,0,0,,Baiklah, jumpa lagi.
Dialog: 0,0:40:13.61,0:40:15.52,Lalai,,0,0,0,,Anda tidak akan kecewa.
Dialog: 0,0:40:26.50,0:40:27.48,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Semua Mel{\c}{\i0}
Dialog: 0,0:40:44.31,0:40:45.52,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kami memohon maaf...{\c}{\i0}
Dialog: 0,0:40:50.36,0:40:52.10, Lalai,,0,0,0,,Saya akan pergi...
Dialog: 0,0:40:53.11,0:40:54.17, Lalai,,0,0,0,,untuk mati?
Dialog: 0,0:40:54.20,0:40:56.68, Lalai,,0,0,0,,Apabila Hercyna hampir tiba?
Dialog: 0,0:40:56.70,0:40:59.32, Lalai,,0,0,0,,Apabila saya hampir dengan One Billion Club?
Dialog: 0,0:41:02.33,0:41:04.16, Lalai,,0,0,0,,Mustahil.
Dialog: 0,0:41:04.37,0:41:06.81, Lalai,,0,0,0,,Saya mempunyai begitu banyak edisi terhad\NI yang belum dipakai lagi.
Dialog: 0,0:41:06.83,0:41:10.33, Lalai,,0,0,0,,Saya membeli begitu banyak pulau,\Ntetapi belum melawatnya lagi.
Dialog: 0,0:41:11.17,0:41:13.02, Lalai,,0,0,0,,Namun saya akan mati?
Dialog: 0,0:41:13.05,0:41:15.67, Lalai,,0,0,0,,Tidak, itu satu pembaziran.
Dialog: 0,0:41:21.10,0:41:22.91, Lalai,,0,0,0,,Saya beli semua ini daripada artis...
Dialog: 0,0:41:22.93,0:41:25.41,Lalai,,0,0,0,,dalam usia 90-an, kerana\Nkerja-kerja anumerta meroket,
Dialog: 0,0:41:25.44,0:41:29.85,Lalai,,0,0,0,,jadi bagaimana saya boleh mati di hadapan mereka?
Dialog: 0,0:41:33.78,0:41:35.56, Lalai,,0,0,0,,Itu akan membazir.
Dialog: 0,0:41:52.92,0:41:55.12,Lalai,,0,0,0,,Anda akan menjadi pembaziran terbesar.
Dialog: 0,0:42:00.39,0:42:03.28,Lalai,,0,0,0,,Kalau begitu mari kita selesaikan kontrak kedai ini.
Dialog: 0,0:42:03.31,0:42:05.51, Lalai,,0,0,0,,Selamat bekerja, semua.
Dialog: 0,0:43:13.29,0:43:14.85,Default,,0,0,0,,- Setiausaha Na.\N- Ya, puan?
Dialog: 0,0:43:14.88,0:43:18.57,Lalai,,0,0,0,,Adakah wanita yang hatinya masih\Rasa apabila melihat suaminya,
Dialog: 0,0:43:18.59,0:43:20.78,Lalai,,0,0,0,,walaupun sudah berkahwin lebih tiga tahun?
Dialog: 0,0:43:20.80,0:43:22.95, Lalai,,0,0,0,,Mengapa hati mereka berdegup kencang?
Dialog: 0,0:43:22.97,0:43:25.32, Lalai,,0,0,0,,- Adakah mereka mengalami aritmia?\N- Tidak, bukan begitu.
Dialog: 0,0:43:25.35,0:43:26.99,Lalai,,0,0,0,,Mungkin...
Dialog: 0,0:43:27.02,0:43:28.72,Lalai,,0,0,0,,kerana...
Dialog: 0,0:43:28.81,0:43:30.34, Lalai,,0,0,0,, mereka kacak?
Dialog: 0,0:43:30.48,0:43:32.79,Lalai,,0,0,0,,- Suami mereka?\N- Ya.
Dialog: 0,0:43:32.81,0:43:35.18, Lalai,,0,0,0,,Mungkin dia sakit.
Dialog: 0,0:43:36.65,0:43:38.04,Lalai,,0,0,0,,Adakah anda mengenali seseorang seperti itu?
Dialog: 0,0:43:38.07,0:43:40.98, Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,0:43:42.36,0:43:46.61,Lalai,,0,0,0,,Pada beberapa hari, dia memandang matanya...
Dialog: 0,0:43:47.54,0:43:49.56,Lalai,,0,0,0,,dan mahu memeluknya.
Dialog: 0,0:43:49.58,0:43:51.45,Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:43:51.67,0:43:54.58, Lalai,,0,0,0,, Kerana dia kasihan kepadanya.
Dialog: 0,0:43:54.79,0:43:56.81,Lalai,,0,0,0,,Dia berasa teruk...
Dialog: 0,0:43:56.84,0:44:01.46,Lalai,,0,0,0,,bahawa jiwa yang lembut itu harus\Nmenghadapi dunia yang keras ini.
Dialog: 0,0:44:01.59,0:44:03.74, Lalai,,0,0,0,,- Tidak boleh.\N- Pada hari lain,
Dialog: 0,0:44:03.76,0:44:05.86, Lalai,,0,0,0,,bahunya kelihatan...
Dialog: 0,0:44:05.89,0:44:07.63, Lalai,,0,0,0,,sangat luas.
Dialog: 0,0:44:07.72,0:44:10.41, Lalai,,0,0,0,,Dia mahu lelaki itu memegangnya.
Dialog: 0,0:44:10.43,0:44:13.46, Lalai,,0,0,0,,Dia kelihatan seperti dinamit berjalan kaki.
Dialog: 0,0:44:13.48,0:44:16.33,Lalai,,0,0,0,,Dia tertanya-tanya sama ada dia harus membiarkan {\i1}homme maut...{\i0}
Dialog: 0,0:44:16.36,0:44:19.98, Lalai,,0,0,0,, berkeliaran dengan bebas di dunia ini.
Dialog: 0,0:44:20.44,0:44:25.61,Lalai,,0,0,0,,Sila beritahu dia berjumpa doktor. Dia sakit.
Dialog: 0,0:44:25.70,0:44:27.47,Lalai,,0,0,0,,- Adakah anda fikir begitu?\N- Saya memberitahu anda.
Dialog: 0,0:44:27.49,0:44:30.43, Lalai,,0,0,0,,Pastikan dia mendapat imbasan CT otak.
Dialog: 0,0:44:30.45,0:44:32.91, Lalai,,0,0,0,,Sesuatu yang teruk di atas sana.
Dialog: 0,0:44:33.33,0:44:35.03, Lalai,,0,0,0,,Setiausaha Na.
Dialog: 0,0:44:35.71,0:44:37.45,Lalai,,0,0,0,,Anda cukup bagus.
Dialog: 0,0:44:37.96,0:44:40.73, Lalai,,0,0,0,,- Saya sangat pelik hari ini.\N- Bagaimana?
Dialog: 0,0:44:40.76,0:44:43.00,Lalai,,0,0,0,,Saya rasa simpati...
Dialog: 0,0:44:43.09,0:44:45.00, Lalai,,0,0,0,,untuk yang lain.
Dialog: 0,0:44:45.14,0:44:48.05,Lalai,,0,0,0,,- Adakah itu pelik?\N- Saya tidak pernah begini.
Dialog: 0,0:44:48.22,0:44:50.59,Lalai,,0,0,0,,Saya sentiasa bersikap dingin,
Dialog: 0,0:44:51.10,0:44:52.80, Lalai,,0,0,0,,jadi pelik.
Dialog: 0,0:44:56.90,0:44:58.38, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Awak bising.{\c}{\i0}
Dialog: 0,0:44:58.40,0:45:01.50,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Berhenti menangis apabila saya mengorbankan tangan saya untuk awak.{\c}{\i0}
Dialog: 0,0:45:01.53,0:45:04.44, Lalai,,0,0,0,,Dan saya terus berempati...
Dialog: 0,0:45:04.49,0:45:06.19, Lalai,,0,0,0,,dengan yang lain.
Dialog: 0,0:45:19.71,0:45:20.69,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah itu?{\c}{\i0}
Dialog: 0,0:45:20.71,0:45:22.52,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Peguam cara tidak dibenarkan di sini.{\c}{\i0}
Dialog: 0,0:45:22.55,0:45:25.58,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya minta maaf. Dia suami kenalan saya.{\c}{\i0}
Dialog: 0,0:45:25.68,0:45:27.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi, anda sedang membantunya?{\c}{\i0}
Dialog: 0,0:45:27.55,0:45:29.24,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bayi mereka berada dalam inkubator.{\c}{\i0}
Dialog: 0,0:45:29.26,0:45:31.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya berasa teruk, jadi...{\c}{\i0}
Dialog: 0,0:45:31.35,0:45:32.33,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia tidak akan kembali.{\c}{\i0}
Dialog: 0,0:45:32.35,0:45:34.54,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Saya minta maaf.\N- Berapa lama bayi itu...?{\c}{\i0}
Dialog: 0,0:45:34.56,0:45:35.87,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Maaf?{\c}{\i0}
Dialog: 0,0:45:35.89,0:45:37.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}...perlu berada di sana?{\c}{\i0}
Dialog: 0,0:45:37.94,0:45:40.33, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Kira-kira tiga...\N- Lupakan. Seminggu? Dua?{\c}{\i0}
Dialog: 0,0:45:40.36,0:45:44.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya hanya biarkan dia datang sehingga itu.{\c}{\i0}
Dialog: 0,0:45:44.03,0:45:45.17,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda akan benarkan dia berbuat demikian?{\c}{\i0}
Dialog: 0,0:45:45.20,0:45:49.61, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Lebih baik saya tidak berjumpa dengannya\Setelah bayinya keluar.{\c}{\i0}
Dialog: 0,0:45:49.91,0:45:52.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tiada insurans akan melindunginya.{\c}{\i0}
Dialog: 0,0:45:52.20,0:45:54.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya mahu menggunakan deposit\N keselamatan kami untuk pembedahannya,{\c}{\i0}
Dialog: 0,0:45:54.58,0:45:55.93,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi ibu saya tidak mahu mendengar.{\c}{\i0}
Dialog: 0,0:45:55.96,0:45:59.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dia kata itu duit perkahwinan saya.{\c}{\i0}
Dialog: 0,0:46:00.00,0:46:01.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Wang sentiasa menjadi masalah.{\c}{\i0}
Dialog: 0,0:46:02.46,0:46:04.25,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya minta maaf.{\c}{\i0}
Dialog: 0,0:46:14.06,0:46:15.76, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sukar dipercayai.{\c}{\i0}
Dialog: 0,0:46:17.35,0:46:20.05,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bukan ibunya seorang sahaja yang sakit.{\c}{\i0}
Dialog: 0,0:46:20.56,0:46:23.73,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ibunya boleh dirawat,\Njadi kenapa dia menangis...?{\c}{\i0}
Dialog: 0,0:46:29.70,0:46:33.11,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapakah terdapat begitu ramai orang yang sakit?{\c}{\i0}
Dialog: 0,0:46:34.62,0:46:36.31, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sungguh menjengkelkan.{\c}{\i0}
Dialog: 0,0:46:36.33,0:46:37.97, Lalai,,0,0,0,,Saya tidak pernah begini.
Dialog: 0,0:46:38.00,0:46:40.02,Lalai,,0,0,0,,Saya tidak pernah peduli...
Dialog: 0,0:46:40.04,0:46:43.08,Lalai,,0,0,0,,tentang sakit orang, jadi kenapa saya jadi begini?
Dialog: 0,0:46:44.13,0:46:46.66,Lalai,,0,0,0,,Suami saya membuatkan jantung saya berdegup kencang.
Dialog: 0,0:46:47.38,0:46:51.61, Lalai,,0,0,0,,Saya percaya otak saya tidak berfungsi dengan baik.
Dialog: 0,0:46:51.64,0:46:53.57, Lalai,,0,0,0,,Adakah ini gejala penyakit saya?
Dialog: 0,0:46:53.60,0:46:55.20, Lalai,,0,0,0,,Tidak juga.
Dialog: 0,0:46:55.22,0:47:00.68,Lalai,,0,0,0,,Ramai pesakit yang tenat\Mengalami perubahan jantung sedemikian.
Dialog: 0,0:47:01.02,0:47:03.25,Lalai,,0,0,0,,Mereka menyedari perkara yang tidak mereka sedari...
Dialog: 0,0:47:03.27,0:47:04.54, Lalai,,0,0,0,, jika mereka tidak mati.
Dialog: 0,0:47:04.57,0:47:06.94, Lalai,,0,0,0, "Anda berubah kerana kematian."
Dialog: 0,0:47:07.53,0:47:08.96, Lalai,,0,0,0, "Anda akan mati tidak lama lagi."
Dialog: 0,0:47:08.99,0:47:11.38,Lalai,,0,0,0,,Saya rasa itu yang awak sindir,
Dialog: 0,0:47:11.41,0:47:12.88, Lalai,,0,0,0,,tetapi anda silap.
Dialog: 0,0:47:12.91,0:47:15.97,Lalai,,0,0,0,,Anda lihat, saya telah berada di ambang kematian berkali-kali,
Dialog: 0,0:47:15.99,0:47:17.99,Lalai,,0,0,0,,dan nasib ajaib saya...
Dialog: 0,0:47:18.29,0:47:20.62, Lalai,,0,0,0,, menyelamatkan saya setiap kali.
Dialog: 0,0:47:27.30,0:47:29.98,Lalai,,0,0,0,,Jika anda tidak cukup mahir untuk menyelamatkan saya,
Dialog: 0,0:47:30.01,0:47:32.21, Lalai,,0,0,0,,kemudian tonton sahaja.
Dialog: 0,0:47:32.72,0:47:34.63,Lalai,,0,0,0,,Satu lagi keajaiban...
Dialog: 0,0:47:35.06,0:47:36.88, Lalai,,0,0,0,, akan menyelamatkan saya.
Dialog: 0,0:47:42.27,0:47:44.26, Lalai,,0,0,0,,Hei, Hyun-woo.
Dialog: 0,0:47:47.82,0:47:49.44,Lalai,,0,0,0,,Sudah agak lama.
Dialog: 0,0:47:50.24,0:47:53.03, Lalai,,0,0,0,,Ya, saya pergi ke tempat memburu! Jadi apa?
Dialog: 0,0:47:53.06,0:47:54.09,Lalai,,0,0,0,,Kenapa awak?
Dialog: 0,0:47:54.12,0:47:57.14,Lalai,,0,0,0,,Untuk berjumpa Bapa. Dia ada di sana\Di sekitar masa tahun ini.
Dialog: 0,0:47:57.16,0:47:59.22,Lalai,,0,0,0,,Tetapi awak pergi tanpa melihat dia.
Dialog: 0,0:47:59.25,0:48:00.52,Lalai,,0,0,0,,Adakah anda...
Dialog: 0,0:48:00.54,0:48:01.56, Lalai,,0,0,0,, mengesyaki saya?
Dialog: 0,0:48:01.58,0:48:05.10,Lalai,,0,0,0,,Pagar dibuka\Namun terdapat umpan berdekatan.
Dialog: 0,0:48:05.13,0:48:09.12, Lalai,,0,0,0,,Kemudian babi hutan yang ditembak menyerang Hae-in.
Dialog: 0,0:48:09.63,0:48:11.79,Lalai,,0,0,0,,- Seseorang dengan sengaja...\N- Jadi?
Dialog: 0,0:48:14.68,0:48:16.92,Lalai,,0,0,0,,Anak perempuan saya hampir mati.
Dialog: 0,0:48:17.43,0:48:18.78, Lalai,,0,0,0,, Beritahu saya perkara sebenar.
Dialog: 0,0:48:18.81,0:48:21.22, Lalai,,0,0,0,,Ini adalah amaran terakhir anda.
Dialog: 0,0:48:23.06,0:48:25.60,Lalai,,0,0,0,,Awak kecewa sebab Hae-in terlibat.
Dialog: 0,0:48:25.65,0:48:29.10,Lalai,,0,0,0,,Mengapa anda tidak kecewa apabila saya\N dituduh palsu dan ditendang keluar?
Dialog: 0,0:48:32.32,0:48:34.02, Lalai,,0,0,0,,Baik, duduk.
Dialog: 0,0:48:36.07,0:48:40.65,Lalai,,0,0,0,,Saya pergi ke sana kerana saya tahu\Ni hari memburu keluarga,
Dialog: 0,0:48:40.91,0:48:43.39,Lalai,,0,0,0,,tetapi apabila saya pergi ke sana,\NMoh Seul-hee yang hebat berkata...
Dialog: 0,0:48:43.42,0:48:45.60,Lalai,,0,0,0,,dia sedang tidur dan tidak membenarkan saya melihatnya.
Dialog: 0,0:48:45.63,0:48:48.10,Lalai,,0,0,0,,Saya merayu padanya, tetapi tidak berjaya,
Dialog: 0,0:48:48.13,0:48:50.41,Lalai,,0,0,0,,jadi saya kembali. Itu sahaja.
Dialog: 0,0:48:51.47,0:48:53.04, Lalai,,0,0,0,, Baik.
Dialog: 0,0:48:53.09,0:48:54.74, Lalai,,0,0,0,, Beom-jun.
Dialog: 0,0:48:54.76,0:48:57.46,Lalai,,0,0,0,,Bantu saya berjumpa dia sekali sahaja.
Dialog: 0,0:48:58.39,0:49:02.01, Lalai,,0,0,0,,Itu sahaja yang saya perlukan. Saya mahu\Nmendamaikan sebelum terlambat.
Dialog: 0,0:49:02.10,0:49:03.93,Lalai,,0,0,0,,Kadang-kadang...
Dialog: 0,0:49:04.60,0:49:07.85,Lalai,,0,0,0,,lebih baik lepaskan.
Dialog: 0,0:49:24.79,0:49:26.62, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:49:26.75,0:49:28.60,Lalai,,0,0,0,,Bukankah keluarga saya begitu ganjil?
Dialog: 0,0:49:28.63,0:49:30.69,Lalai,,0,0,0,,Maaf? Tidak sama sekali, tuan.
Dialog: 0,0:49:30.71,0:49:33.44, Lalai,,0,0,0,,Kami mempunyai tujuh tuntutan mahkamah terhadap satu sama lain.
Dialog: 0,0:49:33.47,0:49:37.53, Lalai,,0,0,0,,Anda mesti telah berjalan di atas\Neggshells semasa anda menjaga...
Dialog: 0,0:49:37.55,0:49:40.09,Lalai,,0,0,0,, perkara remeh kami.
Dialog: 0,0:49:43.31,0:49:44.84,Lalai,,0,0,0,,Anda telah melakukan begitu banyak.
Dialog: 0,0:49:55.86,0:49:57.56, Lalai,,0,0,0,,Helo.
Dialog: 0,0:49:59.99,0:50:02.11,Lalai,,0,0,0,,Pengerusi sudah tidur.
Dialog: 0,0:50:02.24,0:50:03.85, Lalai,,0,0,0,,Sudah?
Dialog: 0,0:50:03.87,0:50:05.39, Lalai,,0,0,0,, Patutkah saya membangunkan dia?
Dialog: 0,0:50:05.41,0:50:06.52, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:50:06.54,0:50:08.56,Lalai,,0,0,0,,Saya baru sahaja datang untuk menyambutnya.
Dialog: 0,0:50:08.58,0:50:10.12, Lalai,,0,0,0,,Selamat tinggal, kemudian.
Dialog: 0,0:50:14.59,0:50:16.33, Lalai,,0,0,0,,Pn. Moh.
Dialog: 0,0:50:16.84,0:50:20.25,Lalai,,0,0,0,,Adakah Beom-seok datang ke tempat perburuan kami...
Dialog: 0,0:50:20.85,0:50:22.76, Lalai,,0,0,0,,dan minta berjumpa Bapa?
Dialog: 0,0:50:23.31,0:50:26.38, Lalai,,0,0,0,,Tidak, dia tidak.
Dialog: 0,0:50:26.98,0:50:28.85, Lalai,,0,0,0,,Adakah itu yang dia katakan?
Dialog: 0,0:50:31.61,0:50:33.31, Lalai,,0,0,0,, Tengok.
Dialog: 0,0:50:33.48,0:50:35.77, Lalai,,0,0,0,,Saya tidak suka mengatakan ini,
Dialog: 0,0:50:36.15,0:50:37.55, Lalai,,0,0,0,,tetapi berhati-hati dengan dia.
Dialog: 0,0:50:37.57,0:50:41.26,Lalai,,0,0,0,,Dia telah menyimpan dendam untuk\Na sementara selepas ditendang keluar.
Dialog: 0,0:50:41.28,0:50:44.65, Lalai,,0,0,0,,Mereka yang tidak mempunyai apa-apa\Nkan rugi adalah yang paling takut.
Dialog: 0,0:50:54.13,0:50:57.28,Lalai,,0,0,0,,Orang jenis apakah\NMr. Yoon Eun-sung? Adakah anda tahu?
Dialog: 0,0:50:57.30,0:50:58.48, Lalai,,0,0,0,, En. Yoon?
Dialog: 0,0:50:58.51,0:51:02.86, Lalai,,0,0,0,,Saya tahu bahagian perniagaannya,\Ntetapi bukan dia sebagai seorang.
Dialog: 0,0:51:02.89,0:51:07.62, Lalai,,0,0,0,,Anda tahu orang seperti kami\Ntidak sepatutnya mempercayai orang lain dengan mudah.
Dialog: 0,0:51:07.64,0:51:10.58, Lalai,,0,0,0,,Jika perjanjian ini juga sia-sia,
Dialog: 0,0:51:10.60,0:51:12.37, Lalai,,0,0,0,,Ayah akan meninggalkan Soo-cheol.
Dialog: 0,0:51:12.40,0:51:13.46, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:51:13.48,0:51:16.39, Lalai,,0,0,0,,Saya akan menyiasat dia secara berhemah.
Dialog: 0,0:51:53.02,0:51:54.21, Lalai,,0,0,0,,Mencari saya?
Dialog: 0,0:51:54.23,0:51:57.77, Lalai,,0,0,0,,Astaga, awak mengejutkan saya.
Dialog: 0,0:52:03.70,0:52:05.53, Lalai,,0,0,0,,Semakan latar belakang?
Dialog: 0,0:52:05.83,0:52:07.26, Lalai,,0,0,0,,Dia agak berhati-hati.
Dialog: 0,0:52:07.29,0:52:09.64, Lalai,,0,0,0,,Dia cuma takut,
Dialog: 0,0:52:09.66,0:52:12.06, Lalai,,0,0,0,,tetapi ia hanya pada mulanya.
Dialog: 0,0:52:12.08,0:52:15.95,Lalai,,0,0,0,,Orang suka dia mempercayainya dengan mudah\Tidakpun mereka mengecewakan mereka.
Dialog: 0,0:52:16.34,0:52:18.50,Lalai,,0,0,0,,Dia agak mengecewakan.
Dialog: 0,0:52:18.67,0:52:23.04,Lalai,,0,0,0,,By the way, adakah anda nampak harapan dengan Hae-in?
Dialog: 0,0:52:24.43,0:52:27.07,Lalai,,0,0,0,,Wang penting bagi saya pastinya,
Dialog: 0,0:52:27.10,0:52:30.34, Lalai,,0,0,0,,tetapi saya juga suka melihat pasangan itu berpisah.
Dialog: 0,0:52:30.39,0:52:31.37, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:52:31.39,0:52:36.83,Lalai,,0,0,0,,Adalah selamat untuk mengatakan bahawa saya mempelopori\N adegan mencari jodoh di negara ini.
Dialog: 0,0:52:36.86,0:52:39.67, Lalai,,0,0,0,,Namun saya gagal betul\Nkahwinkan anak perempuan Queens.
Dialog: 0,0:52:39.69,0:52:41.46, Lalai,,0,0,0,,Sungguh memalukan itu?
Dialog: 0,0:52:41.49,0:52:43.76, Lalai,,0,0,0,,Saya akan mengoyakkannya pada semua cara,
Dialog: 0,0:52:43.78,0:52:46.73, Lalai,,0,0,0,,dan dapatkan semula penghormatan dan prestasi saya yang hilang.
Dialog: 0,0:52:47.70,0:52:51.20,Lalai,,0,0,0,,Dalam kes itu, jangan ulangi apa yang anda lakukan.
Dialog: 0,0:52:51.50,0:52:53.68, Lalai,,0,0,0,,- Anda akan menghalang.\N- Itu tadi...
Dialog: 0,0:52:53.71,0:52:56.83, Lalai,,0,0,0,,Saya disuruh berbuat demikian,
Dialog: 0,0:52:57.25,0:53:01.15, Lalai,,0,0,0,,tetapi Hyun-woo melangkah masuk, membunuh babi hutan itu,
Dialog: 0,0:53:01.17,0:53:02.23, Lalai,,0,0,0,,dan menyimpan Hae-in.
Dialog: 0,0:53:02.26,0:53:05.59, Lalai,,0,0,0,,Saya tidak pernah melihat perkara itu datang.
Dialog: 0,0:53:06.80,0:53:09.74,Lalai,,0,0,0,,{\i1}Hyun-woo, awak dah naik level.{\i0}
Dialog: 0,0:53:09.76,0:53:13.12,Lalai,,0,0,0,,Dari Encik Cinderella yang\Nberkahwin dengan keluarga kaya,
Dialog: 0,0:53:13.14,0:53:16.30, Lalai,,0,0,0,,kepada penyelamat yang menyelamatkan nyawa anak perempuan mereka!
Dialog: 0,0:53:16.98,0:53:18.96, Lalai,,0,0,0,,Mereka melayan saya secara berbeza sekarang.
Dialog: 0,0:53:18.98,0:53:21.46, Lalai,,0,0,0,,Ini kali pertama saya makan kaki burung.
Dialog: 0,0:53:21.48,0:53:24.21,Lalai,,0,0,0,,Saya biasanya diberi leher atau potongan kurus,
Dialog: 0,0:53:24.24,0:53:26.94,Lalai,,0,0,0,,tetapi bapa mertua saya memberi saya kaki.
Dialog: 0,0:53:27.41,0:53:30.01, Lalai,,0,0,0,,Masih terlalu awal untuk berpuas hati.
Dialog: 0,0:53:30.04,0:53:32.36, Lalai,,0,0,0,,Teruskan kerja yang baik.
Dialog: 0,0:53:33.37,0:53:34.43, Lalai,,0,0,0,,Bagaimana?
Dialog: 0,0:53:34.46,0:53:38.39, Lalai,,0,0,0,"Saya hanya menjalankan tugas saya."
Dialog: 0,0:53:38.42,0:53:42.40,Lalai,,0,0,0,,Jangan rosakkan peluang ini\Ndengan bercakap yang bukan-bukan.
Dialog: 0,0:53:42.42,0:53:47.75,Lalai,,0,0,0,,"Ya, saya juga takut. Saya boleh\Nmati, tetapi saya melakukannya untuk Hae-in."
Dialog: 0,0:53:48.01,0:53:50.50, Lalai,,0,0,0,,Anda perlu mengambil kredit.
Dialog: 0,0:53:51.64,0:53:53.16, Lalai,,0,0,0,,- Adakah saya perlu?\N- Ya, anda lakukan.
Dialog: 0,0:53:53.18,0:53:56.04, Lalai,,0,0,0,,Mengambil kredit seperti mengumpul kupon kopi.
Dialog: 0,0:53:56.06,0:53:58.41, Lalai,,0,0,0,,Anda perlu mengumpul sepuluh kupon...
Dialog: 0,0:53:58.44,0:54:02.42,Lalai,,0,0,0,,untuk mereka sedar bahawa anda seorang\Nregular dan memberi anda hadiah percuma.
Dialog: 0,0:54:02.44,0:54:04.14,Lalai,,0,0,0,,Saya tidak perlu...
Dialog: 0,0:54:04.32,0:54:05.38, Lalai,,0,0,0,,sebarang hadiah percuma.
Dialog: 0,0:54:05.40,0:54:08.26, Lalai,,0,0,0,,Apa yang saya mahukan ialah bebas dan tidak terjejas.
Dialog: 0,0:54:08.28,0:54:10.13, Lalai,,0,0,0,,Bodoh betul.
Dialog: 0,0:54:10.16,0:54:11.72, Lalai,,0,0,0,, Katakan selamat tinggal jika anda pergi...
Dialog: 0,0:54:11.74,0:54:13.09, Lalai,,0,0,0,,- palsu.\N- Selamat tinggal apa?
Dialog: 0,0:54:13.12,0:54:14.93, Lalai,,0,0,0,,"Selamat tinggal, sut Itali saya."
Dialog: 0,0:54:14.96,0:54:16.81, Lalai,,0,0,0,,"Selamat tinggal, kasut pereka buatan tangan saya."
Dialog: 0,0:54:16.83,0:54:19.06, Lalai,,0,0,0,"Selamat tinggal, kereta asing saya."
Dialog: 0,0:54:19.08,0:54:22.48, Lalai,,0,0,0,"Selamat tinggal, jam tangan mewah di pergelangan tangan saya."
Dialog: 0,0:54:22.50,0:54:26.46, Lalai,,0,0,0,,"Selamat tinggal, nasib Hae-in."
Dialog: 0,0:54:27.13,0:54:30.99,Lalai,,0,0,0,,En. Cinderella kini akan kembali\Nke kebunnya di selatan,
Dialog: 0,0:54:31.01,0:54:36.18,Lalai,,0,0,0,,tetapi masalahnya, keluarganya\Ntidak akan menyambutnya dengan tangan terbuka.
Dialog: 0,0:54:38.14,0:54:39.96, Lalai,,0,0,0,,Maafkan saya, Jurulatih.
Dialog: 0,0:54:39.98,0:54:43.54,Lalai,,0,0,0,,Anak saya tidak berminat dalam tinju\Nand mahu melakukan Taekwondo sebaliknya.
Dialog: 0,0:54:43.57,0:54:46.35, Lalai,,0,0,0,,Tidak mengapa. Kanak-kanak memang begitu.
Dialog: 0,0:54:46.53,0:54:47.71, Lalai,,0,0,0,,Selamat tinggal, kemudian.
Dialog: 0,0:54:47.74,0:54:48.88, Lalai,,0,0,0,,Jom.
Dialog: 0,0:54:48.91,0:54:51.22,Lalai,,0,0,0,,By the way, Jae-hyeon,\Nkenapa awak suka Taekwondo?
Dialog: 0,0:54:51.24,0:54:53.59, Lalai,,0,0,0,,Mereka mempunyai tali pinggang.
Dialog: 0,0:54:53.62,0:54:55.14, Lalai,,0,0,0,, Tali Pinggang? Untuk pinggang anda?
Dialog: 0,0:54:55.16,0:54:57.24, Lalai,,0,0,0,,Itu sebabnya?
Dialog: 0,0:54:57.91,0:55:00.43,Lalai,,0,0,0,,Itu sebab dia nak pergi.
Dialog: 0,0:55:00.46,0:55:03.15, Lalai,,0,0,0,, Jae-hyeon, kami juga mempunyai tali pinggang.
Dialog: 0,0:55:03.17,0:55:04.27, Lalai,,0,0,0,,Lihat itu.
Dialog: 0,0:55:04.30,0:55:05.56, Lalai,,0,0,0,,Itu tali pinggang juara.
Dialog: 0,0:55:05.59,0:55:08.54,Lalai,,0,0,0,,Jurulatih, tidak mengapa.
Dialog: 0,0:55:10.18,0:55:11.40, Lalai,,0,0,0,,- Ta-da.\N- Astaga.
Dialog: 0,0:55:11.43,0:55:12.49, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:55:12.51,0:55:15.78, Lalai,,0,0,0,,Apa kata anda? Bukankah ia\Nlebih menarik daripada tali pinggang itu?
Dialog: 0,0:55:15.81,0:55:17.97, Lalai,,0,0,0,,Mereka juga menghancurkan sesuatu.
Dialog: 0,0:55:18.10,0:55:19.54, Lalai,,0,0,0,, Hancurkan?
Dialog: 0,0:55:19.56,0:55:21.87, Lalai,,0,0,0,,Kami juga menghancurkan sesuatu.
Dialog: 0,0:55:21.90,0:55:24.63, Lalai,,0,0,0,,Kami tidak sempat. Patutkah saya tunjukkan?
Dialog: 0,0:55:24.65,0:55:26.25, Lalai,,0,0,0,,Tidak, anda tidak perlu tunjukkan kepadanya.
Dialog: 0,0:55:26.28,0:55:27.25,Lalai,,0,0,0,,Tahan.
Dialog: 0,0:55:27.28,0:55:28.63, Lalai,,0,0,0,,Beri saya satu saat.
Dialog: 0,0:55:28.65,0:55:29.92, Lalai,,0,0,0,,Di mana papan?
Dialog: 0,0:55:29.95,0:55:31.65, Lalai,,0,0,0,, Itu dia.
Dialog: 0,0:55:31.87,0:55:32.93, Lalai,,0,0,0,,Okey. Tengok.
Dialog: 0,0:55:32.95,0:55:35.19, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:55:43.00,0:55:44.56, Lalai,,0,0,0,,Beginilah cara anda melakukannya.
Dialog: 0,0:55:44.59,0:55:46.27, Lalai,,0,0,0,,Saya akan menghancurkannya kali ini.
Dialog: 0,0:55:46.30,0:55:48.00, Lalai,,0,0,0,, Tonton saya.
Dialog: 0,0:55:57.68,0:55:59.33, Lalai,,0,0,0,, Astaga!
Dialog: 0,0:55:59.35,0:56:01.41, Lalai,,0,0,0,, Nampak? Saya telah menghancurkannya, bukan?
Dialog: 0,0:56:01.44,0:56:04.60,Lalai,,0,0,0,,- Bukankah tinju juga bagus?\N- Tapi...
Dialog: 0,0:56:04.81,0:56:06.46, Lalai,,0,0,0,,Apa? Apa pula kali ini?
Dialog: 0,0:56:06.48,0:56:09.13,Lalai,,0,0,0,,Saya mahu melakukan Taekwondo kerana Ji-seong melakukannya.
Dialog: 0,0:56:09.15,0:56:12.59,Lalai,,0,0,0,,Ji-seong ialah kawan baiknya.
Dialog: 0,0:56:14.57,0:56:15.84,Lalai,,0,0,0,,Puan.
Dialog: 0,0:56:15.87,0:56:19.76,Lalai,,0,0,0,,Saya hanya mengatakan ini kerana\NI sangat mengambil berat tentang Jae-hyeon.
Dialog: 0,0:56:19.79,0:56:22.96,Lalai,,0,0,0,,Tidakkah anda rasa dia sepatutnya mempunyai pelbagai kawan?
Dialog: 0,0:56:22.98,0:56:24.02, Lalai,,0,0,0,,Maaf?
Dialog: 0,0:56:24.04,0:56:26.66, Lalai,,0,0,0,,- Awak kenal Baek Ho-yeol?\N- Saya kenal.
Dialog: 0,0:56:26.84,0:56:30.36,Lalai,,0,0,0,,Dia anak saya, dan dia sama seperti awak.
Dialog: 0,0:56:30.38,0:56:32.49, Lalai,,0,0,0,,Dia suka permainan, sama seperti anda.
Dialog: 0,0:56:32.51,0:56:35.32,Lalai,,0,0,0,,Alangkah hebatnya datang ke sini untuk bertinju...
Dialog: 0,0:56:35.35,0:56:38.38, Lalai,,0,0,0,,dan bermain permainan dengannya selepas sekolah?
Dialog: 0,0:56:41.23,0:56:42.79,Lalai,,0,0,0,,Ho-yeol mempunyai gred terendah.
Dialog: 0,0:56:42.81,0:56:44.51, Lalai,,0,0,0,,Hei.
Dialog: 0,0:56:47.11,0:56:48.71, Lalai,,0,0,0,,Jurulatih.
Dialog: 0,0:56:48.73,0:56:50.48, Lalai,,0,0,0,,Anda berdarah.
Dialog: 0,0:56:52.11,0:56:53.71, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:56:53.74,0:56:55.34, Lalai,,0,0,0,,Kenapa saya...?
Dialog: 0,0:56:55.37,0:56:57.38,Lalai,,0,0,0,,Astaga, jangan risau tentang saya.
Dialog: 0,0:56:57.41,0:56:59.22, Lalai,,0,0,0,, Kayu itu pasti mengikis saya.
Dialog: 0,0:56:59.24,0:57:00.76, Lalai,,0,0,0,,Selamat tinggal, kemudian.
Dialog: 0,0:57:00.79,0:57:01.85, Lalai,,0,0,0,,Adakah anda akan pergi?
Dialog: 0,0:57:01.87,0:57:03.93,Default,,0,0,0,,- Jom.\N- Sampai rumah dengan selamat, puan.
Dialog: 0,0:57:03.96,0:57:05.35, Lalai,,0,0,0,,Selamat tinggal.
Dialog: 0,0:57:05.38,0:57:06.56, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:57:06.58,0:57:09.23,Lalai,,0,0,0,,Jae-hyeon, jumpa lagi!
Dialog: 0,0:57:09.25,0:57:10.31, Lalai,,0,0,0,,Bye.
Dialog: 0,0:57:10.34,0:57:12.21,Lalai,,0,0,0,,Selamat tinggal, puan.
Dialog: 0,0:57:28.86,0:57:30.79, Lalai,,0,0,0,,- Hei, awak berdarah.\N- Ia hanya goresan.
Dialog: 0,0:57:30.82,0:57:32.17, Lalai,,0,0,0,, Kayu itu mengikis saya.
Dialog: 0,0:57:32.19,0:57:34.05, Lalai,,0,0,0,,Kenapa awak jengkel sangat?
Dialog: 0,0:57:34.07,0:57:37.84, Lalai,,0,0,0,,Saya tidak banyak tidur kebelakangan ini,\Njadi saya tutup salun saya hari ini.
Dialog: 0,0:57:37.87,0:57:39.68,Lalai,,0,0,0,,Saya harus menutup gim ini tidak lama lagi,
Dialog: 0,0:57:39.70,0:57:42.22,Lalai,,0,0,0,,dan pertimbangkan untuk bekerja di bawah\Nseseorang sebaik sahaja Hyun-woo bercerai.
Dialog: 0,0:57:42.25,0:57:43.93,Lalai,,0,0,0,,Berhenti bercakap tentang perceraiannya.
Dialog: 0,0:57:43.96,0:57:47.62,Lalai,,0,0,0,,Saya harus menerima realiti dan mempersiapkan diri.
Dialog: 0,0:57:50.00,0:57:51.98,Lalai,,0,0,0,,- Patutkah kita pergi ke Seoul?\N- Dan buat apa?
Dialog: 0,0:57:52.01,0:57:54.28,Lalai,,0,0,0,,Saya telefon Hae-in, tetapi dia tidak angkat.
Dialog: 0,0:57:54.30,0:57:58.15,Lalai,,0,0,0,,Mari kita jumpa dia secara peribadi dan\Nhalang dia daripada bercerai.
Dialog: 0,0:57:58.18,0:57:59.61, Lalai,,0,0,0,,- Bersedia.\N- Apa?
Dialog: 0,0:57:59.64,0:58:00.95,Lalai,,0,0,0,,Jom.
Dialog: 0,0:58:00.97,0:58:08.01, Lalai,,0,0,0,,Anda sangat menentang keseluruhan rancangan ini,\Ntetapi saya rasa anda akhirnya berjaya melakukannya.
Dialog: 0,0:58:08.06,0:58:09.12, Lalai,,0,0,0,,Nah...
Dialog: 0,0:58:09.15,0:58:12.54,Lalai,,0,0,0,,Saya sentiasa melakukan yang terbaik apabila\NI menetapkan fikiran saya kepada sesuatu.
Dialog: 0,0:58:12.57,0:58:13.63, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:58:13.65,0:58:15.55,Lalai,,0,0,0,,Anda sentiasa melakukan sesuatu dengan sepenuh hati,
Dialog: 0,0:58:15.57,0:58:17.09, Lalai,,0,0,0,, tetapi inilah masalahnya.
Dialog: 0,0:58:17.11,0:58:19.88,Lalai,,0,0,0,,Tipu dia separuh hati, dan semuanya akan baik-baik saja,
Dialog: 0,0:58:19.91,0:58:22.23, Lalai,,0,0,0,,tetapi lakukan kerja yang cemerlang,
Dialog: 0,0:58:22.79,0:58:26.61, Lalai,,0,0,0,, dan dia akan marah jika dia mengetahuinya.
Dialog: 0,0:58:28.42,0:58:29.73, Lalai,,0,0,0,,- Mungkin, kan?\N- Betul,
Dialog: 0,0:58:29.75,0:58:34.46, Lalai,,0,0,0,,jadi anda tidak sepatutnya ditangkap. faham ke?
Dialog: 0,0:58:34.80,0:58:37.11, Lalai,,0,0,0,,Saya tidak akan ditangkap,
Dialog: 0,0:58:37.13,0:58:39.11,Lalai,,0,0,0,,selagi kita...
Dialog: 0,0:58:39.14,0:58:40.49,Lalai,,0,0,0,,rahsiakan perkara ini.
Dialog: 0,0:58:40.51,0:58:42.17, Lalai,,0,0,0,, Betul.
Dialog: 0,0:58:44.35,0:58:49.51,Lalai,,0,0,0,,By the way, bukankah kita patut beritahu\NHyun-woo kita akan jumpa Hae-in?
Dialog: 0,0:58:49.65,0:58:50.71,Lalai,,0,0,0,,Bodoh.
Dialog: 0,0:58:50.73,0:58:53.46, Lalai,,0,0,0,,Adakah anda fikir dia akan membenarkannya?\NKita tidak akan rugi sekarang.
Dialog: 0,0:58:53.48,0:58:56.64, Lalai,,0,0,0,,Kita patut cuba menghalangnya walau apa pun, bukan?
Dialog: 0,0:58:57.45,0:58:59.27,Lalai,,0,0,0,,Pijak.
Dialog: 0,0:59:06.04,0:59:08.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Pengambilan Berterusan{\c}{\i0}
Dialog: 0,0:59:22.43,0:59:24.63, Lalai,,0,0,0,,Apa yang perlu kita beritahu mereka?
Dialog: 0,0:59:24.89,0:59:27.24,Lalai,,0,0,0,,Kami tidak perlu memperkenalkan diri kami.
Dialog: 0,0:59:27.27,0:59:29.12, Lalai,,0,0,0,, Awak tak tengok drama ke?
Dialog: 0,0:59:29.14,0:59:32.16, Lalai,,0,0,0,,Pejabat setiausaha menguruskan keluarga VIP.
Dialog: 0,0:59:32.19,0:59:35.75,Lalai,,0,0,0,,Mereka akan terkejut apabila\Nmereka melihat wajah kita dan berkata,
Dialog: 0,0:59:35.78,0:59:38.00,Lalai,,0,0,0,,"Cik Hong, kakak ipar kamu ada di sini."
Dialog: 0,0:59:38.03,0:59:40.92, Lalai,,0,0,0,,Kemudian mereka akan membenarkan kami masuk serta-merta.
Dialog: 0,0:59:40.95,0:59:43.44,Lalai,,0,0,0,,Anda perlu menempah janji temu.
Dialog: 0,0:59:44.41,0:59:46.69, Lalai,,0,0,0,,Anda mesti baru di sini.
Dialog: 0,0:59:58.01,0:59:59.19, Lalai,,0,0,0,,Lihat ini.
Dialog: 0,0:59:59.22,1:00:00.57,Lalai,,0,0,0,,Itu saya.
Dialog: 0,1:00:00.59,1:00:03.11,Lalai,,0,0,0,,Lelaki berambut ikal ini ialah dia.
Dialog: 0,1:00:03.14,1:00:06.88,Lalai,,0,0,0,,Okey? Itulah kita. Nampak?
Dialog: 0,1:00:07.64,1:00:11.22,Lalai,,0,0,0,,Tinggalkan nama dan nombor anda,\Nand saya akan serahkan padanya.
Dialog: 0,1:00:11.73,1:00:13.43,Lalai,,0,0,0,,Lihat.
Dialog: 0,1:00:13.65,1:00:16.71,Lalai,,0,0,0,,Kami keluarga dia. Kami\N sebahagian daripada keluarga diraja.
Dialog: 0,1:00:16.73,1:00:19.67,Lalai,,0,0,0,,Mengapa kita mesti menempah\Temujanji untuk berjumpa keluarga kita?
Dialog: 0,1:00:19.69,1:00:20.96,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:00:20.99,1:00:25.27,Lalai,,0,0,0,,Sila tempah janji temu dan kembali...
Dialog: 0,1:00:28.91,1:00:30.01,Lalai,,0,0,0,,Hae-in!
Dialog: 0,1:00:30.04,1:00:31.93,Lalai,,0,0,0,,Sudah agak lama.
Dialog: 0,1:00:31.96,1:00:34.16,Lalai,,0,0,0,,Saya Hyeon-tae, abang Hyun-woo.
Dialog: 0,1:00:34.75,1:00:36.48,Lalai,,0,0,0,,Saya tahu.
Dialog: 0,1:00:36.50,1:00:39.06,Lalai,,0,0,0,,Saya tertanya-tanya sama ada itu awak, dan saya betul.
Dialog: 0,1:00:39.09,1:00:43.50,Lalai,,0,0,0,,Kita perlu bercakap. Malah Hyun-woo\Ntidak tahu kami berada di sini.
Dialog: 0,1:00:43.84,1:00:45.54,Lalai,,0,0,0,,Nah...
Dialog: 0,1:00:48.26,1:00:49.83, Lalai,,0,0,0,, Patutkah kita naik ke atas?
Dialog: 0,1:00:49.85,1:00:51.43,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:00:52.44,1:00:54.26,Lalai,,0,0,0,,- Dengan cara ini.\N- Okay.
Dialog: 0,1:01:00.94,1:01:02.21,Lalai,,0,0,0,,Adakah anda terkejut?
Dialog: 0,1:01:02.24,1:01:06.76,Lalai,,0,0,0,,Tetapi anda lihat, kami tidak akan menghukum\Nyou kerana tidak mengenali kami.
Dialog: 0,1:01:06.78,1:01:07.84,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:01:07.87,1:01:12.91,Lalai,,0,0,0,,Kami tidak menyalahgunakan kuasa kami dengan cara itu.
Dialog: 0,1:01:22.76,1:01:23.90,Lalai,,0,0,0,,Anda pasti sibuk.
Dialog: 0,1:01:23.93,1:01:26.36,Lalai,,0,0,0,,Maaf kami datang tanpa pemberitahuan.
Dialog: 0,1:01:26.39,1:01:30.12,Lalai,,0,0,0,,Saya sebenarnya telah menelefon beberapa kali,\Ntetapi saya tidak dapat menghubungi anda.
Dialog: 0,1:01:30.14,1:01:32.47, Lalai,,0,0,0,,Saya tidak mengambil nombor yang belum disimpan.
Dialog: 0,1:01:32.89,1:01:35.80,Lalai,,0,0,0,,Anda mesti tiada nombor saya.
Dialog: 0,1:01:36.35,1:01:37.79,Lalai,,0,0,0,,Apa yang membawa anda ke sini?
Dialog: 0,1:01:37.81,1:01:39.68,Lalai,,0,0,0,,Anda lihat...
Dialog: 0,1:01:41.19,1:01:44.19,Lalai,,0,0,0,,Di manakah saya harus bermula?
Dialog: 0,1:01:45.53,1:01:48.84,Lalai,,0,0,0,,Ia adalah hari lahir ayah kami yang ke-60 baru-baru ini.
Dialog: 0,1:01:48.87,1:01:52.37,Lalai,,0,0,0,,Anda mesti berada di sini kerana anda\N kecewa kerana saya tidak muncul.
Dialog: 0,1:01:52.40,1:01:53.43,Lalai,,0,0,0,,Aduh, tidak sama sekali.
Dialog: 0,1:01:53.45,1:01:54.45,Lalai,,0,0,0,,Tidak?
Dialog: 0,1:01:54.47,1:01:58.30,Lalai,,0,0,0,,Sudah tentu tidak, kerana kami tidak kecewa sama sekali.
Dialog: 0,1:02:01.00,1:02:03.87,Lalai,,0,0,0,,Saya tidak tahu bagaimana perasaan anda tentang perkara ini,
Dialog: 0,1:02:04.01,1:02:05.40,Lalai,,0,0,0,,tetapi Hyun-woo...
Dialog: 0,1:02:05.43,1:02:07.74,Lalai,,0,0,0,,- Ya?\N- Dia susah kan?
Dialog: 0,1:02:07.76,1:02:10.03,Lalai,,0,0,0,,- Maaf?\N- Astaga, saya faham.
Dialog: 0,1:02:10.05,1:02:11.12,Lalai,,0,0,0,,Faham apa?
Dialog: 0,1:02:11.14,1:02:14.99,Lalai,,0,0,0,,Orang yang bertentangan kutub dengan\Nyou tidak berada di seberang dunia.
Dialog: 0,1:02:15.02,1:02:20.17,Lalai,,0,0,0,,Ia ialah orang yang anda berkahwin,\N orang yang anda tidur dan makan di sebelah.
Dialog: 0,1:02:20.19,1:02:23.07,Lalai,,0,0,0,,Mereka paling gagal memahami anda.
Dialog: 0,1:02:23.09,1:02:24.13,Lalai,,0,0,0,,Betul.
Dialog: 0,1:02:24.15,1:02:26.92,Lalai,,0,0,0,,Saya dan suami bertengkar\Tinggalkan masa kerana AC.
Dialog: 0,1:02:26.95,1:02:29.72,Lalai,,0,0,0,,Dia akan menghidupkan AC pada\Nmusim panas, dan saya akan kesejukan.
Dialog: 0,1:02:29.74,1:02:32.90,Lalai,,0,0,0,,Kami malah mengutuk satu sama lain kerananya.
Dialog: 0,1:02:35.83,1:02:38.73,Lalai,,0,0,0,,Dulu dia sangat culas\Npada saya semasa kami berkahwin,
Dialog: 0,1:02:38.75,1:02:40.94,Lalai,,0,0,0,,namun dia tidak dapat mematikan AC untuk saya.
Dialog: 0,1:02:40.96,1:02:43.94,Lalai,,0,0,0,,Kami tidak berdebat tentang perkara sedemikian.
Dialog: 0,1:02:43.96,1:02:45.77,Lalai,,0,0,0,,Adakah itu benar?
Dialog: 0,1:02:45.80,1:02:47.15,Lalai,,0,0,0,,Maka itu bagus.
Dialog: 0,1:02:47.18,1:02:48.69,Lalai,,0,0,0,,Anda mempunyai hubungan yang baik.
Dialog: 0,1:02:48.72,1:02:51.80,Lalai,,0,0,0,,Kami tidur di bilik berasingan,\Njadi kami masing-masing mempunyai AC.
Dialog: 0,1:02:53.39,1:02:56.83,Lalai,,0,0,0,,Itu boleh difahami jika\Anda mempunyai banyak bilik ganti.
Dialog: 0,1:02:56.85,1:03:00.12,Lalai,,0,0,0,,Apa pun, inilah yang saya katakan kepadanya sepanjang masa.
Dialog: 0,1:03:00.15,1:03:02.49,Lalai,,0,0,0,,"Sekarang anda sudah berkahwin,\Anda bukan lagi salah seorang daripada kami."
Dialog: 0,1:03:02.52,1:03:06.00, Lalai,,0,0,0,,"Anggap diri anda sebahagian daripada Queens,\Nand kekal di sana walaupun selepas anda mati."
Dialog: 0,1:03:06.03,1:03:09.81,Lalai,,0,0,0,,"Jangan berani balik\Juga menjejakkan kaki ke rumah kami."
Dialog: 0,1:03:10.95,1:03:13.07,Lalai,,0,0,0,,Kalau bercakap tentang itu...
Dialog: 0,1:03:21.67,1:03:23.58,Lalai,,0,0,0,,Div...
Dialog: 0,1:03:24.71,1:03:27.32,Lalai,,0,0,0,,Saya minta maaf mengganggu,\Ntetapi anda akan terlambat...
Dialog: 0,1:03:27.34,1:03:29.44,Lalai,,0,0,0,,untuk pertemuan anda dengan En. Hermann.
Dialog: 0,1:03:29.47,1:03:31.24,Lalai,,0,0,0,,Saya minta maaf, tetapi saya perlu pergi.
Dialog: 0,1:03:31.26,1:03:32.99,Lalai,,0,0,0,,Saya ada makan malam penting hari ini.
Dialog: 0,1:03:33.01,1:03:34.70,Lalai,,0,0,0,,Baiklah, anda patut pergi.
Dialog: 0,1:03:34.72,1:03:37.41,Lalai,,0,0,0,,Saya akan menghantar mesej kepada anda sepanjang perbualan,
Dialog: 0,1:03:37.43,1:03:39.80,Lalai,,0,0,0,,jadi sila simpan nombor saya.
Dialog: 0,1:03:47.57,1:03:50.67,Lalai,,0,0,0,,- Saya akan melawat awak dalam masa terdekat.\N- Betul ke? Adakah anda akan melakukannya?
Dialog: 0,1:03:50.70,1:03:55.09,Lalai,,0,0,0,,Saya akui kita berjauhan\Selepas Hyun-woo berkahwin.
Dialog: 0,1:03:55.12,1:03:57.51,Lalai,,0,0,0,,Lagipun, anda telah memberikan kami sebuah bangunan.
Dialog: 0,1:03:57.54,1:03:58.51,Lalai,,0,0,0,,Sebuah bangunan?
Dialog: 0,1:03:58.54,1:04:00.60,Lalai,,0,0,0,,Ya, yang ada di bandar kami.
Dialog: 0,1:04:00.62,1:04:03.23,Lalai,,0,0,0,,Adakah saya membeli bangunan di sana?
Dialog: 0,1:04:03.25,1:04:06.83,Lalai,,0,0,0,,Ya, anda lakukan. Awak suruh saya\Ndapat satu bila awak dah kahwin.
Dialog: 0,1:04:09.09,1:04:10.15,Lalai,,0,0,0,,Adakah anda menggunakan itu?
Dialog: 0,1:04:10.17,1:04:12.08,Lalai,,0,0,0,,Ya,
Dialog: 0,1:04:12.22,1:04:13.61,Lalai,,0,0,0,,tetapi jangan risau.
Dialog: 0,1:04:13.64,1:04:15.70,Lalai,,0,0,0,,Saya melakukan pembersihan dan pembaikan.
Dialog: 0,1:04:15.72,1:04:16.91,Lalai,,0,0,0,,Saya melakukan segala-galanya.
Dialog: 0,1:04:16.93,1:04:20.68,Lalai,,0,0,0,,Jangan risau tentang bangunan itu,\Nmemandangkan saya mengawalnya.
Dialog: 0,1:04:24.40,1:04:27.42,Lalai,,0,0,0,,By the way, kenapa mertua awak melawat?
Dialog: 0,1:04:27.44,1:04:29.13,Lalai,,0,0,0,,Saya tidak pasti.
Dialog: 0,1:04:29.15,1:04:31.84,Lalai,,0,0,0,,Dia menyebut bagaimana saya tidak\Nattend ke-60 ayahnya.
Dialog: 0,1:04:31.86,1:04:33.55,Lalai,,0,0,0,,Jadi dia datang untuk nitpick?
Dialog: 0,1:04:33.57,1:04:34.68,Lalai,,0,0,0,,Dia berkata tidak.
Dialog: 0,1:04:34.70,1:04:36.23,Lalai,,0,0,0,,Kemudian?
Dialog: 0,1:04:37.37,1:04:42.35,Lalai,,0,0,0,,Dia berkata perkahwinan adalah seperti\Nmenghidupkan AC pada musim panas.
Dialog: 0,1:04:42.37,1:04:45.10,Lalai,,0,0,0,,Apa? Apakah maksudnya?
Dialog: 0,1:04:45.13,1:04:47.33,Lalai,,0,0,0,,Anda tidak pernah bersetuju tentang suhu.
Dialog: 0,1:04:48.67,1:04:51.00,Lalai,,0,0,0,,Itu masuk akal.
Dialog: 0,1:05:02.23,1:05:03.80,Lalai,,0,0,0,,Hei.
Dialog: 0,1:05:03.94,1:05:05.75,Lalai,,0,0,0,,- Di manakah Encik Hermann?\N- Betul.
Dialog: 0,1:05:05.77,1:05:09.13,Lalai,,0,0,0,,Dia pergi berjumpa bayi\Nanak perempuannya kerana dia terbalik.
Dialog: 0,1:05:09.15,1:05:12.75,Lalai,,0,0,0,,Dia menolak mesyuarat ini hanya\Nkerana bayinya terbalik?
Dialog: 0,1:05:12.78,1:05:14.05,Lalai,,0,0,0,,Dia seorang lelaki keluarga.
Dialog: 0,1:05:14.07,1:05:17.34,Lalai,,0,0,0,,Itulah sebabnya dia bercerai\Nempat kali dan mempunyai bayi pada usia 60 tahun.
Dialog: 0,1:05:17.37,1:05:19.18,Lalai,,0,0,0,,Sungguh menjengkelkan.
Dialog: 0,1:05:19.20,1:05:22.18,Lalai,,0,0,0,,Saya pun bawa pelan lantai,\Nmemandangkan dia nak tengok dulu.
Dialog: 0,1:05:22.20,1:05:24.02,Lalai,,0,0,0,,Ini sebenarnya lebih baik.
Dialog: 0,1:05:24.04,1:05:27.60,Lalai,,0,0,0,,Anda lihat, dia sudah mempunyai gambaran dalam fikiran.
Dialog: 0,1:05:27.63,1:05:30.61,Lalai,,0,0,0,,Mengetahui itu terlebih dahulu\Nakan memberi anda kelebihan.
Dialog: 0,1:05:30.63,1:05:32.50,Lalai,,0,0,0,,Apa yang dia mahukan?
Dialog: 0,1:05:34.30,1:05:36.15,Lalai,,0,0,0,,Apa? Awak dah balik?
Dialog: 0,1:05:36.18,1:05:38.03,Lalai,,0,0,0,,Saya fikir awak pulang ke rumah.
Dialog: 0,1:05:38.05,1:05:39.66,Lalai,,0,0,0,,Saya mempunyai lebih banyak dokumen untuk diperiksa.
Dialog: 0,1:05:39.68,1:05:42.05,Lalai,,0,0,0,,- Anda boleh pulang.\N- Ya, tuan.
Dialog: 0,1:05:42.27,1:05:46.20,Lalai,,0,0,0,,By the way, Setiausaha Na beritahu saya tadi...
Dialog: 0,1:05:46.23,1:05:48.29,Lalai,,0,0,0,,yang Cik Hong ada janji makan malam.
Dialog: 0,1:05:49.86,1:05:52.75,Lalai,,0,0,0,,Dia berkata Cik Hong sedang\Nberjumpa dengan Encik Yoon Eun-sung,
Dialog: 0,1:05:52.78,1:05:54.46,Lalai,,0,0,0,,dan mungkin pulang lewat, jadi tuan,
Dialog: 0,1:05:54.49,1:05:59.13,Lalai,,0,0,0,,Saya rasa selamat untuk anda pulang\Nrumah daripada tinggal di sini.
Dialog: 0,1:05:59.16,1:06:01.15,Lalai,,0,0,0,,Siapa dia jumpa lagi?
Dialog: 0,1:06:01.99,1:06:04.68,Lalai,,0,0,0,,{\an8}Hercyna mahukan dua tingkat.
Dialog: 0,1:06:04.71,1:06:06.57,Lalai,,0,0,0,,- Dua tingkat?\N- Ya.
Dialog: 0,1:06:07.00,1:06:09.48,Lalai,,0,0,0,,Anda memerlukan tangga mewah di sekitar sini.
Dialog: 0,1:06:09.50,1:06:11.10,Lalai,,0,0,0,,Bagaimana kita boleh melakukannya?
Dialog: 0,1:06:11.13,1:06:13.07, Lalai,,0,0,0,,Ini bukan pengubahsuaian yang mudah.
Dialog: 0,1:06:13.09,1:06:15.78,Lalai,,0,0,0,,Saya perlu menukar\Nstruktur dan mendapatkannya diluluskan.
Dialog: 0,1:06:15.80,1:06:19.49,Lalai,,0,0,0,,Tepat sekali. Dia akan membuat cadangan itu\Nand pilih sesiapa yang menyelesaikannya dahulu.
Dialog: 0,1:06:19.51,1:06:21.95,Lalai,,0,0,0,,Itu gila.
Dialog: 0,1:06:21.97,1:06:25.05,Lalai,,0,0,0,,Memang mengarut...
Dialog: 0,1:06:25.64,1:06:26.70,Lalai,,0,0,0,,tetapi hanya saya yang tahu ini?
Dialog: 0,1:06:26.73,1:06:29.01,Lalai,,0,0,0,,Betul.
Dialog: 0,1:06:37.78,1:06:42.78,Lalai,,0,0,0,,Tuan, adakah anda mendengar tentang adik-beradik anda\Nmelawat Cik Hong awal hari ini?
Dialog: 0,1:06:42.95,1:06:45.76,Lalai,,0,0,0,,- Siapa?\N- Kakak dan abang kamu.
Dialog: 0,1:06:45.79,1:06:48.02,Lalai,,0,0,0,,Setiausaha Na baru sahaja memberitahu saya mengenainya.
Dialog: 0,1:06:48.04,1:06:49.95,Lalai,,0,0,0,,Tahukah anda?
Dialog: 0,1:07:01.01,1:07:02.95,Lalai,,0,0,0,,Makan sebelum basah.
Dialog: 0,1:07:02.97,1:07:06.83,Lalai,,0,0,0,,Tahan. "Saya tahu ia sukar. Titik, titik, titik."
Dialog: 0,1:07:06.85,1:07:09.25,Lalai,,0,0,0,,"Tetapi anda masih tidak boleh bercerai."
Dialog: 0,1:07:09.27,1:07:12.04,Lalai,,0,0,0,,"Bolehkah anda mempertimbangkannya semula demi saya?"
Dialog: 0,1:07:12.06,1:07:14.88,Lalai,,0,0,0,,Mengapa dia berbuat demikian? Dia hampir tidak mengenali awak.
Dialog: 0,1:07:14.90,1:07:16.63,Lalai,,0,0,0,,Makan sahaja udon anda.
Dialog: 0,1:07:16.65,1:07:18.84,Lalai,,0,0,0,,Mengapa kamu menyebut\Nmembersihkan bangunan itu kepadanya?
Dialog: 0,1:07:18.86,1:07:20.51,Lalai,,0,0,0,,Saya sangat terkejut.
Dialog: 0,1:07:20.53,1:07:22.80,Lalai,,0,0,0,,Bagaimana dia tidak tahu tentang bangunannya sendiri?
Dialog: 0,1:07:22.83,1:07:24.68,Lalai,,0,0,0,,Adakah ini serupa dengan cara saya terlupa...
Dialog: 0,1:07:24.70,1:07:26.05,Lalai,,0,0,0,,kira-kira $10 yang saya tinggalkan...
Dialog: 0,1:07:26.08,1:07:27.47,Lalai,,0,0,0,,dalam kot musim sejuk saya?
Dialog: 0,1:07:27.50,1:07:28.72,Lalai,,0,0,0,,Adakah itu yang memiliki...
Dialog: 0,1:07:28.75,1:07:31.53,Lalai,,0,0,0,,- sebuah bangunan bagi mereka...?\N- Berhenti bercakap!
Dialog: 0,1:07:35.25,1:07:37.98,Lalai,,0,0,0,,"Walau apa pun sebab perceraian anda,"
Dialog: 0,1:07:38.01,1:07:40.69,Lalai,,0,0,0,,"Saya percaya Hyun-woo yang harus dipersalahkan,"
Dialog: 0,1:07:40.72,1:07:44.70,Lalai,,0,0,0,,"jadi bolehkah awak menjadi\Tidak faham sekali ini,"
Dialog: 0,1:07:44.72,1:07:47.67,Lalai,,0,0,0,"dan tidak bercerai? Emote menangis."
Dialog: 0,1:07:50.14,1:07:52.14,Lalai,,0,0,0,,Saya menghantarnya.
Dialog: 0,1:07:54.32,1:07:55.29,Lalai,,0,0,0,,Itu Hyun-woo!
Dialog: 0,1:07:55.32,1:07:56.38,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:07:56.40,1:07:59.48,Lalai,,0,0,0,,- Apa yang perlu saya buat?\N- Angkat.
Dialog: 0,1:08:00.99,1:08:02.72,Lalai,,0,0,0,,Apa? Ya, saya bertemu dengannya.
Dialog: 0,1:08:02.74,1:08:06.14,Lalai,,0,0,0,,Mengapa anda fikir saya melakukannya?\NTuntuk memberitahu dia supaya tidak menceraikan anda,
Dialog: 0,1:08:06.16,1:08:08.06,Lalai,,0,0,0,,tetapi dia terlalu sibuk,
Dialog: 0,1:08:08.08,1:08:09.91,Lalai,,0,0,0,,jadi saya menghantar mesej kepadanya.
Dialog: 0,1:08:10.33,1:08:11.93,Lalai,,0,0,0,,- Apa?\N- Apa?
Dialog: 0,1:08:11.96,1:08:13.44,Lalai,,0,0,0,,Mereka tidak berpisah.
Dialog: 0,1:08:13.46,1:08:15.99,Lalai,,0,0,0,,- Adakah mereka berdamai?\N- Adakah anda berdamai?
Dialog: 0,1:08:16.59,1:08:19.27,Lalai,,0,0,0,,Tidak, dia hanya tidak tahu bahawa dia mahu...
Dialog: 0,1:08:19.30,1:08:20.36,Lalai,,0,0,0,,- perceraian.\N- Apa?
Dialog: 0,1:08:20.38,1:08:22.25,Lalai,,0,0,0,,Dia tidak pernah membangkitkannya.
Dialog: 0,1:08:22.51,1:08:23.95,Lalai,,0,0,0,,Apa yang perlu saya lakukan?
Dialog: 0,1:08:23.97,1:08:25.05,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:08:37.23,1:08:38.53,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialog: 0,1:08:40.90,1:08:43.28,Lalai,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,1:08:49.50,1:08:50.97,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:08:51.00,1:08:52.70,Lalai,,0,0,0,,Ya.
Dialog: 0,1:08:53.67,1:08:55.37,Lalai,,0,0,0,,Jom.
Dialog: 0,1:08:59.84,1:09:01.48,Lalai,,0,0,0,,Orang macam mana...
Dialog: 0,1:09:01.51,1:09:02.73,Lalai,,0,0,0,,suami awak?
Dialog: 0,1:09:02.76,1:09:03.99,Lalai,,0,0,0,,Itu rawak.
Dialog: 0,1:09:04.01,1:09:06.40,Lalai,,0,0,0,,Anda sentiasa dingin dan curiga terhadap orang lain,
Dialog: 0,1:09:06.43,1:09:09.42,Lalai,,0,0,0,,jadi saya ingin tahu tentang orang itu...
Dialog: 0,1:09:09.89,1:09:11.59,Lalai,,0,0,0,,anda memilih untuk berkahwin.
Dialog: 0,1:09:12.02,1:09:13.97,Lalai,,0,0,0,,Biar saya fikir.
Dialog: 0,1:09:15.02,1:09:17.92,Lalai,,0,0,0,,Rasanya seperti anda berharap saya akan memburukkan dia,
Dialog: 0,1:09:17.94,1:09:20.63,Lalai,,0,0,0,,tetapi anda silap. Dia seorang lelaki yang baik.
Dialog: 0,1:09:20.65,1:09:24.73,Lalai,,0,0,0,,Anda melihat bagaimana dia melompat masuk untuk\Nselamatkan saya pada saat berbahaya itu.
Dialog: 0,1:09:26.62,1:09:28.36,Lalai,,0,0,0,,Anda silap.
Dialog: 0,1:09:28.83,1:09:31.18,Lalai,,0,0,0,,Saya nampak dia teragak-agak.
Dialog: 0,1:09:31.20,1:09:32.89,Lalai,,0,0,0,,Dia teragak-agak...
Dialog: 0,1:09:32.91,1:09:35.20,Lalai,,0,0,0,,untuk menyelamatkan anda.
Dialog: 0,1:09:38.71,1:09:40.41,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:09:44.13,1:09:45.51,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialog: 0,1:09:46.64,1:09:49.96,Lalai,,0,0,0,,{\i1}Nombor yang anda dail tidak tersedia...{\i0}
Dialog: 0,1:09:58.98,1:10:01.81,Lalai,,0,0,0,,Itulah perbezaan antara kamu berdua.
Dialog: 0,1:10:02.23,1:10:05.73,Lalai,,0,0,0,,Anda sedang memerhatikannya pada masa itu,
Dialog: 0,1:10:05.78,1:10:07.65,Lalai,,0,0,0,,tetapi dia memerhatikan saya.
Dialog: 0,1:10:11.87,1:10:13.93,Lalai,,0,0,0,,Anda sebenarnya percaya dia sayangkan awak.
Dialog: 0,1:10:13.95,1:10:15.81,Lalai,,0,0,0,,Ya, saya lakukan.
Dialog: 0,1:10:15.83,1:10:18.02,Lalai,,0,0,0,,Saya tidak tahu apa erti cinta bagi awak,
Dialog: 0,1:10:18.04,1:10:22.69,Lalai,,0,0,0,,tetapi bagi saya, ini bukan tentang menjadi\Ngembira dan berbisik yang tidak manis.
Dialog: 0,1:10:22.71,1:10:24.57,Lalai,,0,0,0,,Cinta adalah apabila...
Dialog: 0,1:10:24.59,1:10:26.32,Lalai,,0,0,0,,anda menahan kesakitan bersama-sama.
Dialog: 0,1:10:26.34,1:10:29.46,Lalai,,0,0,0,,Apabila anda memilih untuk kekal dan bukannya melarikan diri.
Dialog: 0,1:10:30.35,1:10:32.34,Lalai,,0,0,0,,Walaupun mereka mempunyai hutang,
Dialog: 0,1:10:32.85,1:10:34.83,Lalai,,0,0,0,,atau sesuatu yang lebih daripada itu,
Dialog: 0,1:10:34.85,1:10:36.84,Lalai,,0,0,0,,anda masih bersatu.
Dialog: 0,1:10:38.76,1:10:40.46,Lalai,,0,0,0,,Itulah cinta,
Dialog: 0,1:10:40.48,1:10:42.64,Lalai,,0,0,0,,dan dia melakukan perkara itu.
Dialog: 0,1:10:44.03,1:10:45.45,Lalai,,0,0,0,,Itu panjang.
Dialog: 0,1:10:45.47,1:10:46.50,Lalai,,0,0,0,,Apa?
Dialog: 0,1:10:46.53,1:10:49.19,Lalai,,0,0,0,,Orang ramai cenderung meracau apabila mereka tidak pasti.
Dialog: 0,1:10:49.53,1:10:52.61,Lalai,,0,0,0,,Anda kelihatan tidak yakin.
Dialog: 0,1:11:29.49,1:11:30.76,Lalai,,0,0,0,,Saya tidak tahu awak ada di sini.
Dialog: 0,1:11:30.78,1:11:31.88,Lalai,,0,0,0,,Di manakah Hae-in?
Dialog: 0,1:11:31.91,1:11:34.90,Lalai,,0,0,0,,Nah, anda nampak...
Dialog: 0,1:11:42.96,1:11:44.83,Lalai,,0,0,0,,Apa yang membawa anda ke sini?
Dialog: 0,1:11:44.92,1:11:46.96,Lalai,,0,0,0,,Hae-in minum banyak.
Dialog: 0,1:11:47.17,1:11:49.87,Lalai,,0,0,0,,Dia minum?
Dialog: 0,1:11:55.47,1:11:56.57,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:11:56.60,1:11:59.59,Lalai,,0,0,0,,- Hae-in.\N- Biarkan dia sahaja. Dia sedang tidur.
Dialog: 0,1:12:01.06,1:12:03.97,Lalai,,0,0,0,,Dia tidur apabila dia mabuk.
Dialog: 0,1:12:08.36,1:12:09.89,Lalai,,0,0,0,,Hong Hae-in.
Dialog: 0,1:12:11.61,1:12:15.05,Lalai,,0,0,0,,Dia telah tidur sepanjang masa,\Njadi beri dia sepuluh minit lagi,
Dialog: 0,1:12:15.08,1:12:17.43,Lalai,,0,0,0,,atau saya akan bawa dia masuk nanti,
Dialog: 0,1:12:17.45,1:12:18.60,Lalai,,0,0,0,,supaya anda boleh menunggu di dalam.
Dialog: 0,1:12:18.62,1:12:21.16,Lalai,,0,0,0,,Berapa banyak alkohol yang anda berikan kepadanya?
Dialog: 0,1:12:22.79,1:12:24.49,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:12:24.96,1:12:26.66,Lalai,,0,0,0,,Lihat.
Dialog: 0,1:12:27.34,1:12:30.53,Lalai,,0,0,0,,Dia biasanya tidak minum,\Ntetapi dia boleh menahan minuman kerasnya,
Dialog: 0,1:12:30.55,1:12:34.75,Lalai,,0,0,0,,jadi berapa banyak yang anda berikan kepadanya, agar dia...
Dialog: 0,1:12:36.72,1:12:38.62,Lalai,,0,0,0,,mabuk ini?
Dialog: 0,1:12:38.64,1:12:40.47,Lalai,,0,0,0,,Saya campurkan alkohol.
Dialog: 0,1:12:51.70,1:12:55.44,Lalai,,0,0,0,,Saya tidak boleh tidur, kerana awak terlalu bising.
Dialog: 0,1:12:57.91,1:12:59.74,Lalai,,0,0,0,,Terima kasih. Pulang dengan selamat.
Dialog: 0,1:12:59.95,1:13:01.82,Lalai,,0,0,0,,Okey. tidur lena.
Dialog: 0,1:13:02.12,1:13:05.12,Lalai,,0,0,0,,- Jumpa esok petang.\N- Kenapa dia...?
Dialog: 0,1:13:06.84,1:13:08.54,Lalai,,0,0,0,,Maksud saya...
Dialog: 0,1:13:08.67,1:13:10.98,Lalai,,0,0,0,,Saya dengar kamu berjumpa dengan En. Hermann hari ini,
Dialog: 0,1:13:11.01,1:13:13.28,Lalai,,0,0,0,,jadi untuk apa esok?
Dialog: 0,1:13:13.30,1:13:15.88,Lalai,,0,0,0,,En. Hermann tidak muncul hari ini.
Dialog: 0,1:13:16.24,1:13:17.84,Lalai,,0,0,0,,Hanya kami berdua,
Dialog: 0,1:13:18.39,1:13:20.09,Lalai,,0,0,0,,dan kami minum...
Dialog: 0,1:13:21.02,1:13:22.55,Lalai,,0,0,0,,oleh diri kita sendiri.
Dialog: 0,1:13:27.73,1:13:30.54,Lalai,,0,0,0,,Betul. Jangan lupa minum\Jus Norange pada waktu pagi.
Dialog: 0,1:13:30.57,1:13:32.21,Lalai,,0,0,0,,Itulah penawar mabuk anda.
Dialog: 0,1:13:32.24,1:13:34.70,Lalai,,0,0,0,,Apa sahaja. Okay.
Dialog: 0,1:13:34.72,1:13:35.72,Lalai,,0,0,0,,Okey.
Dialog: 0,1:13:35.74,1:13:39.18,Lalai,,0,0,0,,- Bye.\N- Selamat tinggal, kemudian.
Dialog: 0,1:13:39.20,1:13:42.15,Lalai,,0,0,0,,Tolong jaga dia baik-baik.
Dialog: 0,1:13:45.37,1:13:46.56,Lalai,,0,0,0,,- Encik Oh.\N- Ya, tuan?
Dialog: 0,1:13:46.58,1:13:49.52,Lalai,,0,0,0,,Sila bawa dia pulang dengan selamat.\Nampaknya dia sangat mabuk.
Dialog: 0,1:13:49.55,1:13:52.69,Lalai,,0,0,0,,Dia nampak sangat keluar,\Njadi bawa dia ke pintunya.
Dialog: 0,1:13:52.71,1:13:54.42,Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,1:13:54.88,1:13:57.54,Lalai,,0,0,0,,Apa yang kamu lakukan? masuk.
Dialog: 0,1:14:13.69,1:14:16.26,Lalai,,0,0,0,,Mengapa anda tiba-tiba minum begitu banyak?
Dialog: 0,1:14:16.28,1:14:18.57,Lalai,,0,0,0,,Kerana ia tidak seperti saya.
Dialog: 0,1:14:19.03,1:14:22.28,Lalai,,0,0,0,,Saya akan mencuba perkara baharu.
Dialog: 0,1:14:25.00,1:14:25.97,Lalai,,0,0,0,,Ia sangat tidak adil.
Dialog: 0,1:14:26.00,1:14:31.66,Lalai,,0,0,0,,Saya hidup berbeza daripada orang lain supaya\NI boleh hidup panjang dan sihat.
Dialog: 0,1:14:32.63,1:14:35.46,Lalai,,0,0,0,,Tetapi lihat saya sekarang. Itu semua tidak berguna.
Dialog: 0,1:14:36.72,1:14:39.28,Lalai,,0,0,0,,Saya akan luahkan fikiran saya,
Dialog: 0,1:14:39.30,1:14:42.80,Lalai,,0,0,0,,buat semua yang saya mahu,
Dialog: 0,1:14:45.60,1:14:48.80,Lalai,,0,0,0,,dan bunuh mereka yang layak menerimanya.
Dialog: 0,1:14:54.07,1:14:56.85,Lalai,,0,0,0,,Ada apa dengan yang terakhir?
Dialog: 0,1:14:58.70,1:15:00.30,Lalai,,0,0,0,,Saya akan bunuh...
Dialog: 0,1:15:00.32,1:15:02.47,Lalai,,0,0,0,,setiap bajingan yang mengkhianati...
Dialog: 0,1:15:02.49,1:15:04.78,Lalai,,0,0,0,,dan tikam saya dari belakang.
Dialog: 0,1:15:06.12,1:15:07.68,Lalai,,0,0,0,,Fikirkan tentang ini.
Dialog: 0,1:15:07.71,1:15:11.78,Lalai,,0,0,0,,Walaupun saya melakukan pembunuhan,
Dialog: 0,1:15:11.88,1:15:15.73,Lalai,,0,0,0,,Saya hanya perlu menghadiri perbicaraan\Beberapa kali sebelum saya mati...
Dialog: 0,1:15:15.76,1:15:17.75,Lalai,,0,0,0,,dalam tiga bulan.
Dialog: 0,1:15:19.34,1:15:23.55,Lalai,,0,0,0,,Betul. Awak boleh jadi peguam saya.
Dialog: 0,1:15:27.18,1:15:30.01,Lalai,,0,0,0,,Baiklah, berikan saya itu. Jom masuk dalam.
Dialog: 0,1:15:30.40,1:15:34.60,Lalai,,0,0,0,,Anda mempunyai kebolehan untuk\Nmengatakan perkara yang menakutkan itu.
Dialog: 0,1:15:46.33,1:15:48.11,Lalai,,0,0,0,,Jangan takut.
Dialog: 0,1:15:49.08,1:15:53.20,Lalai,,0,0,0,,Saya tahu awak tidak akan mengkhianati saya.
Dialog: 0,1:15:54.25,1:15:55.31,Lalai,,0,0,0,,Sudah tentu tidak.
Dialog: 0,1:15:55.34,1:15:59.12,Lalai,,0,0,0,,Saya tidak takut.
Dialog: 0,1:16:04.76,1:16:06.38,Lalai,,0,0,0,,By the way,
Dialog: 0,1:16:07.27,1:16:10.64,Lalai,,0,0,0,,telefon anda telah dimatikan.
Dialog: 0,1:16:11.31,1:16:12.37,Lalai,,0,0,0,,Di mana?
Dialog: 0,1:16:12.40,1:16:14.10,Lalai,,0,0,0,,Ia tiada di sana?
Dialog: 0,1:16:14.77,1:16:16.42,Lalai,,0,0,0,,Betul.
Dialog: 0,1:16:16.44,1:16:17.88,Lalai,,0,0,0,,Saya mesti meninggalkannya di dalam kereta.
Dialog: 0,1:16:17.90,1:16:19.60,Lalai,,0,0,0,,Dalam kereta?
Dialog: 0,1:16:20.36,1:16:23.06,Lalai,,0,0,0,,Masuklah. Saya akan ambil telefon awak.
Dialog: 0,1:16:27.62,1:16:29.93,Lalai,,0,0,0,,En. Oh, awak dah pergi? awak kat mana?
Dialog: 0,1:16:29.96,1:16:32.57,Lalai,,0,0,0,,Apa? Ini dia.
Dialog: 0,1:16:39.09,1:16:41.54,Lalai,,0,0,0,,Ia ada di dalam poket saya.
Dialog: 0,1:16:46.81,1:16:49.30,Lalai,,0,0,0,,Apa? Ia dimatikan.
Dialog: 0,1:16:55.31,1:16:57.81,Lalai,,0,0,0,,Hae-in, tunggu.
Dialog: 0,1:17:27.89,1:17:30.80,Lalai,,0,0,0,,- Apa yang awak buat?\N- Saya tidak pasti.
Dialog: 0,1:17:32.98,1:17:34.72,Lalai,,0,0,0,,Apa...
Dialog: 0,1:17:34.81,1:17:36.51,Lalai,,0,0,0,,adakah saya...
Dialog: 0,1:17:37.73,1:17:39.47, Lalai,,0,0,0,, sedang dilakukan sekarang?
Dialog: 0,1:17:39.78,1:17:41.52,Lalai,,0,0,0,,Saya gembira...
Dialog: 0,1:17:42.44,1:17:44.09,Lalai,,0,0,0,,anda jumpa...
Dialog: 0,1:17:44.11,1:17:45.86, Lalai,,0,0,0,,telefon anda.
Dialog: 0,1:17:46.45,1:17:48.15,Lalai,,0,0,0,,Boleh jadi...
Dialog: 0,1:17:48.41,1:17:50.36,Lalai,,0,0,0,,susah untuk mendapatkannya.
Dialog: 0,1:17:56.38,1:17:58.08,Lalai,,0,0,0,,Mengapa saya tidak...
Dialog: 0,1:18:01.88,1:18:03.79,Lalai,,0,0,0,,yakin?
Dialog: 0,1:18:04.05,1:18:05.92,Lalai,,0,0,0,,Apa?
Dialog: 0,1:18:06.76,1:18:08.75,Lalai,,0,0,0,,Apa yang anda katakan?
Dialog: 0,1:18:17.81,1:18:19.76,Lalai,,0,0,0,,Betul.
Dialog: 0,1:18:26.20,1:18:28.02,Lalai,,0,0,0,,Saya dah cakap kan?
Dialog: 0,1:18:28.41,1:18:30.07,Lalai,,0,0,0,,Saya akan cuba...
Dialog: 0,1:18:30.78,1:18:33.19,Lalai,,0,0,0,,perkara baharu.
Dialog: 0,1:19:05.94,1:19:08.49,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Istana Sanssouci, Potsdam, Jerman\NTTiga Tahun Lalu{\c}{\i0}
Dialog: 0,1:19:17.75,1:19:20.49,Lalai,,0,0,0,,Adakah anda kata tempat ini tidak perlu risau?
Dialog: 0,1:19:21.67,1:19:25.62,Lalai,,0,0,0,,"Sans souci" dalam bahasa Perancis bermaksud "riang".
Dialog: 0,1:19:26.88,1:19:28.44,Lalai,,0,0,0,,Itu mengarut.
Dialog: 0,1:19:28.47,1:19:30.75,Lalai,,0,0,0,,Bagaimana tempat sedemikian boleh wujud?
Dialog: 0,1:19:31.18,1:19:32.53,Lalai,,0,0,0,,Adakah anda tahu "Putera Bahagia"?
Dialog: 0,1:19:32.55,1:19:36.80,Lalai,,0,0,0,,Putera raja yang membuat burung walet mencucuk matanya?
Dialog: 0,1:19:39.02,1:19:40.80,Lalai,,0,0,0,,Ya.
Dialog: 0,1:19:42.06,1:19:45.52,Lalai,,0,0,0,,Putera raja pernah tinggal di istana ini.
Dialog: 0,1:19:47.07,1:19:49.55,Lalai,,0,0,0,,Saya hanya menyedari satu perkara\Selepas membaca buku itu...
Dialog: 0,1:19:49.57,1:19:50.97,Lalai,,0,0,0,,sebagai seorang kanak-kanak.
Dialog: 0,1:19:50.99,1:19:53.63, Lalai,,0,0,0, "Anda akan sentiasa menderita di luar rumah."
Dialog: 0,1:19:53.66,1:19:56.18,Lalai,,0,0,0,,Putera raja pun mungkin merindui rumahnya.
Dialog: 0,1:19:56.20,1:19:58.97,Lalai,,0,0,0,,Dia meninggalkan rumah hanya untuk menderita.
Dialog: 0,1:19:59.00,1:20:01.62,Lalai,,0,0,0,,Dia memberikan permata dan matanya.
Dialog: 0,1:20:04.34,1:20:06.25,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:20:08.30,1:20:10.19,Lalai,,0,0,0,,Itulah sebabnya dia adalah "putera yang bahagia."
Dialog: 0,1:20:10.22,1:20:14.11,Lalai,,0,0,0,,Sila. Dia tidak gembira. Dia\Nbaru berubah sebelum kematiannya.
Dialog: 0,1:20:14.14,1:20:16.24,Lalai,,0,0,0,,Kita harus berpegang teguh pada diri kita sendiri,
Dialog: 0,1:20:16.26,1:20:19.38,Lalai,,0,0,0,,dan tidak bertindak di luar watak\Nhanya kerana kita sedang mati.
Dialog: 0,1:20:36.99,1:20:39.22,Lalai,,0,0,0,,Saya ingin membina sesuatu.
Dialog: 0,1:20:39.25,1:20:41.59,Lalai,,0,0,0,,Pusat sokongan kanser\Nitu membantu keluarga pekerja.
Dialog: 0,1:20:41.62,1:20:42.77,Lalai,,0,0,0,,Maaf?
Dialog: 0,1:20:42.79,1:20:45.94,Lalai,,0,0,0,,Anda ingin menawarkan bantuan kewangan\N kepada keluarga mereka?
Dialog: 0,1:20:45.96,1:20:47.70,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:20:47.84,1:20:49.75,Lalai,,0,0,0,,Untuk kecekapan, sudah tentu.
Dialog: 0,1:20:49.92,1:20:51.48,Lalai,,0,0,0,,Apa maksud anda?
Dialog: 0,1:20:51.51,1:20:53.78,Lalai,,0,0,0,,Bayangkan jika ahli keluarga anda menghidap kanser.
Dialog: 0,1:20:53.80,1:20:55.28,Lalai,,0,0,0,,Bolehkah anda fokus pada kerja?
Dialog: 0,1:20:55.30,1:20:57.62,Lalai,,0,0,0,,- Mungkin tidak.\N- Betul?
Dialog: 0,1:20:57.64,1:21:00.37,Lalai,,0,0,0,,Maka anda tidak akan dapat menjual produk anda.
Dialog: 0,1:21:00.39,1:21:02.29,Lalai,,0,0,0,,Itu rugi saya,
Dialog: 0,1:21:02.31,1:21:05.62,Lalai,,0,0,0,,dan anda akan menangis di dalam tandas tentang\Nbagaimana anda memerlukan wang.
Dialog: 0,1:21:05.65,1:21:07.82,Lalai,,0,0,0,,Solekan anda akan rosak,\Mata anda akan bengkak.
Dialog: 0,1:21:07.85,1:21:10.71,Lalai,,0,0,0,,Ia hanya akan menjatuhkan reputasi kedai jabatan kami.
Dialog: 0,1:21:11.97,1:21:12.95,Lalai,,0,0,0,,Ya.
Dialog: 0,1:21:12.95,1:21:14.61,Lalai,,0,0,0,,Saya tidak cuba...
Dialog: 0,1:21:14.66,1:21:16.72,Lalai,,0,0,0,,untuk membantu orang lain atas dasar muhibah.
Dialog: 0,1:21:16.74,1:21:21.40,Lalai,,0,0,0,,Ini semua tentang kecekapan\Dan aspek kewangan.
Dialog: 0,1:21:24.04,1:21:26.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:21:55.11,1:21:56.76,Lalai,,0,0,0,,{\an8}{\i1}- Adakah anda akan tidur?\N- Mari lakukannya.{\i0}
Dialog: 0,1:21:56.78,1:22:00.01,Lalai,,0,0,0,,{\an8}{\i1}Itu kerana saya takut. Itulah\Nsebabnya jantung saya berdegup kencang.{\i0}
Dialog: 0,1:22:00.04,1:22:02.47,Lalai,,0,0,0,,{\an8}{\i1}Sekarang saya telah sembuh,{\i0}
Dialog: 0,1:22:02.50,1:22:04.52,Lalai,,0,0,0,,{\an8}{\i1}anda akan mengkhianati saya?{\i0}
Dialog: 0,1:22:04.54,1:22:05.89,Lalai,,0,0,0,,{\an8}{\i1}Awas!{\i0}
Dialog: 0,1:22:05.92,1:22:08.62,Lalai,,0,0,0,,{\an8}{\i1}Apakah jenis orang gila yang menjerit seperti itu di sini?{\i0}
Dialog: 0,1:22:08.96,1:22:11.36,Lalai,,0,0,0,,{\an8}{\i1}Awak bukan Eun-sung yang saya kenal.{\i0}
Dialog: 0,1:22:11.38,1:22:13.82,Lalai,,0,0,0,,{\an8}{\i1}Saya telah bekerja keras untuk mendengar ini daripada anda.{\i0}
Dialog: 0,1:22:13.84,1:22:17.63,Lalai,,0,0,0,,{\an8}{\i1}Saya tidak sukakan Hae-in pun.\NKenapa saya cemburu?{\i0}
Dialog: 0,1:22:18.51,1:22:20.20,Lalai,,0,0,0,,{\an8}{\i1}Saya ada sesuatu nak beritahu awak.{\i0}
Dialog: 0,1:22:20.22,1:22:23.26,Lalai,,0,0,0,,{\an8}{\i1}Jangan risau. Berita baik yang anda akan suka.{\i0}
