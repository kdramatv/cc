Dialog: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skenario: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sutradara: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:03.18,0:01:04.95,Default,,0,0,0,,Du-gwan!
Dialog: 0,0:01:04.98,0:01:06.96,Default,,0,0,0,,Lihat!
Dialog: 0,0:01:06.99,0:01:07.98,Default,,0,0,0,,Ya ampun!
Dialog: 0,0:01:08.00,0:01:09.96,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Mantan CEO Hong Hae-in Sakit Terminal{\c}{\i0}
Dialog: 0,0:01:12.57,0:01:14.34,Default,,0,0,0,,- Astaga!\N- Astaga, Du-gwan!
Dialog: 0,0:01:14.36,0:01:15.50,Default,,0,0,0,,Du-gwan!
Dialogue: 0,0:01:15.53,0:01:17.09,Default,,0,0,0,,Jangan lupakan sepatumu!
Dialog: 0,0:01:17.11,0:01:18.90,Default,,0,0,0,,Mi-seon!
Dialogue: 0,0:01:27.50,0:01:31.16,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Karena aku diberitahu...{\c}{\i0}
Dialogue: 0,0:01:32.17,0:01:34.21,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Waktuku tinggal sedikit...{\c}{\i0}
Dialogue: 0,0:01:34.26,0:01:36.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}untuk ditayangkan.{\c}{\i0}
Dialog: 0,0:01:41.81,0:01:43.62,Default,,0,0,0,,Kapan Anda didiagnosis?
Dialogue: 0,0:01:43.64,0:01:46.43,Default,,0,0,0,,Apakah Ketua Yoon juga mengetahui hal ini?
Dialog: 0,0:03:12.85,0:03:15.51,Default,,0,0,0,,Hae-in.
Dialogue: 0,0:03:17.11,0:03:18.68,Default,,0,0,0,,{\i1}Aku belum bisa mati.{\i0}
Dialog: 0,0:03:20.28,0:03:22.27,Default,,0,0,0,,{\i1}Saya belum...{\i0}
Dialog: 0,0:03:22.53,0:03:24.98,Default,,0,0,0,,{\i1}sudah kubilang.{\i0}
Dialog: 0,0:03:25.49,0:03:27.48,Default,,0,0,0,,Selesai!
Dialog: 0,0:03:29.41,0:03:31.03,Default,,0,0,0,,{\i1}Tidak apa-apa.{\i0}
Dialog: 0,0:03:35.08,0:03:38.15,Default,,0,0,0,,{\i1}Bahwa aku tidak pernah membencimu.{\i0}
Dialog: 0,0:03:38.17,0:03:39.65,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apa gunanya?{\c}{\i0}
Dialog: 0,0:03:39.67,0:03:41.62,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Itu hanya membuatku kesal.{\c}{\i0}
Dialogue: 0,0:03:42.30,0:03:45.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mari kita berpisah. Saya ingin bercerai.{\c}{\i0}
Dialogue: 0,0:03:45.55,0:03:49.17,Default,,0,0,0,,{\i1}Aku belum berterima kasih padamu karena\Ntetap bersamaku selama ini,{\i0}
Dialog: 0,0:03:57.07,0:04:00.17,Default,,0,0,0,,{\i1}terlepas dari semua kata-kata kasar...{\i0}
Dialogue: 0,0:04:00.19,0:04:01.34,Default,,0,0,0,,{\i1}Bukan maksudku.{\i0}
Dialog: 0,0:04:01.36,0:04:03.98,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku mencintainya.{\c}{\i0}
Dialog: 0,0:04:07.24,0:04:09.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku mencintaimu, Hae-in.{\c}{\i0}
Dialog: 0,0:04:11.25,0:04:13.16,Default,,0,0,0,,{\i1}Aku cinta kamu.{\i0}
Dialogue: 0,0:04:15.17,0:04:17.81,Default,,0,0,0,,{\i1}Kaulah alasanku ingin hidup lebih lama lagi.{\i0}
Dialog: 0,0:04:17.84,0:04:18.81,Default,,0,0,0,,Kamu tidak bisa masuk.
Dialog: 0,0:04:18.84,0:04:21.41,Default,,0,0,0,,Kamu tidak diperbolehkan masuk ke dalam.
Dialog: 0,0:04:28.64,0:04:31.51,Default,,0,0,0,,{\i1}Saya kira saya punya waktu lebih banyak.{\i0}
Dialog: 0,0:05:35.75,0:05:38.62,Default,,0,0,0,,Kami sedang mencari Hong Hae-in.
Dialog: 0,0:05:39.25,0:05:42.49,Default,,0,0,0,,Bu, di mana Hong Hae-in?
Dialog: 0,0:05:42.80,0:05:45.91,Default,,0,0,0,,{\i1}Saya belum meminta maaf kepada semua orang.{\i0}
Dialog: 0,0:05:50.26,0:05:53.89,Default,,0,0,0,,{\i1}{\c&HFFFF&}Unit Perawatan Intensif{\c}{\i0}
Dialogue: 0,0:06:22.38,0:06:24.24,Default,,0,0,0,,{\i1}Maafkan aku.{\i0}
Dialogue: 0,0:06:31.76,0:06:33.96,Default,,0,0,0,,{\i1}Aku minta maaf untuk semuanya.{\i0}
Dialog: 0,0:06:40.77,0:06:41.90,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 11{\c}{\i0}
Dialogue: 0,0:06:57.66,0:06:59.70,Default,,0,0,0,,{\an8}Saya pikir Anda belum menemukannya.
Dialog: 0,0:07:00.04,0:07:02.37,Default,,0,0,0,,{\an8}- Anda lihat...\N- Keluar.
Dialogue: 0,0:07:03.33,0:07:06.15,Default,,0,0,0,,{\an8}Apa yang memberi Anda hak?\NIni bukan rumah sakit Anda.
Dialogue: 0,0:07:06.17,0:07:10.15,Default,,0,0,0,,{\an8}Anda akan menemui ketua.\NGkeluar, karena saya tidak akan membiarkan Anda.
Dialog: 0,0:07:10.17,0:07:13.70,Default,,0,0,0,,Putramu mengkhianatimu dan memindahkannya ke sini,
Dialog: 0,0:07:13.72,0:07:16.82,Default,,0,0,0,,jadi apakah kamu masih menganggap kamu adalah wali sahnya?
Dialogue: 0,0:07:16.85,0:07:19.34,Default,,0,0,0,,Menurutmu aku akan membiarkannya begitu saja?
Dialogue: 0,0:07:21.23,0:07:23.79,Default,,0,0,0,,Aku akan keluar sendiri.
Dialog: 0,0:07:23.81,0:07:26.18,Default,,0,0,0,,Tolong jangan sentuh aku.
Dialog: 0,0:07:31.24,0:07:32.94,Default,,0,0,0,,Sialan.
Dialog: 0,0:07:34.03,0:07:37.11,Default,,0,0,0,,Hei! Sialan!
Dialog: 0,0:07:40.50,0:07:42.24,Default,,0,0,0,,Hei!
Dialog: 0,0:07:55.85,0:07:56.82,Default,,0,0,0,,{\i1}{\c&HFFFF&}Tangga Darurat{\c}{\i0}
Dialog: 0,0:08:10.74,0:08:13.21,Default,,0,0,0,,- Buka pintunya.\N- Maaf, tapi saya tidak bisa melakukan itu.
Dialog: 0,0:08:13.24,0:08:15.52,Default,,0,0,0,,Aku tidak berbicara denganmu. Buka itu.
Dialogue: 0,0:08:21.29,0:08:23.11,Default,,0,0,0,,Aku juga!
Dialog: 0,0:08:23.33,0:08:24.77,Default,,0,0,0,,Biarkan aku masuk juga!
Dialog: 0,0:08:24.79,0:08:28.02,Default,,0,0,0,,Lihat. aku mohon padamu.
Dialog: 0,0:08:28.04,0:08:31.73,Default,,0,0,0,,Tolong. Aku minta maaf karena bersikap\Nkasar padamu selama ini.
Dialog: 0,0:08:31.76,0:08:33.87,Default,,0,0,0,,Maafkan saya.
Dialogue: 0,0:08:34.01,0:08:37.86,Default,,0,0,0,,Tolong biarkan aku menemui ayahku sekali ini saja.
Dialog: 0,0:08:37.89,0:08:39.41,Default,,0,0,0,,Tolong.
Dialogue: 0,0:08:39.43,0:08:41.28,Default,,0,0,0,,Haruskah aku berlutut?
Dialog: 0,0:08:41.31,0:08:42.62,Default,,0,0,0,,Haruskah saya?
Dialog: 0,0:08:42.64,0:08:44.33,Default,,0,0,0,,Baik.
Dialog: 0,0:08:44.35,0:08:46.47,Default,,0,0,0,,Baik? Benar-benar?
Dialog: 0,0:08:47.23,0:08:49.22,Default,,0,0,0,,Maksudmu begitu?
Dialog: 0,0:08:50.44,0:08:54.90,Default,,0,0,0,,Saya ingin Anda segera pergi setelahnya.\NIJika tidak, Anda akan diseret keluar.
Dialog: 0,0:08:55.66,0:08:59.69,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:09:17.22,0:09:19.00,Default,,0,0,0,,Ayah?
Dialog: 0,0:09:22.10,0:09:24.62,Default,,0,0,0,,Ayah!
Dialog: 0,0:09:24.64,0:09:25.95,Default,,0,0,0,,Ayah!
Dialog: 0,0:09:25.98,0:09:28.21,Default,,0,0,0,,Ayah!
Dialog: 0,0:09:28.23,0:09:31.17,Default,,0,0,0,,Kamu bangun!
Dialog: 0,0:09:31.19,0:09:33.75,Default,,0,0,0,,Aku sangat bangga padamu!
Dialogue: 0,0:09:33.78,0:09:36.35,Default,,0,0,0,,Kamu melakukannya dengan baik!
Dialog: 0,0:09:43.12,0:09:45.22,Default,,0,0,0,,Ayo, sekarang.
Dialog: 0,0:09:45.25,0:09:48.37,Default,,0,0,0,,Apa kamu tidak tahu siapa aku?
Dialog: 0,0:09:50.08,0:09:51.81,Default,,0,0,0,,Astaga.
Dialog: 0,0:09:51.84,0:09:53.40,Default,,0,0,0,,{\i1}Ayah!{\i0}
Dialog: 0,0:09:53.42,0:09:56.58,Default,,0,0,0,,Apa? Apakah dia meninggal?
Dialog: 0,0:09:57.09,0:09:59.42,Default,,0,0,0,,Ayah!
Dialog: 0,0:09:59.93,0:10:04.63,Default,,0,0,0,,Ayah!
Dialogue: 0,0:10:14.90,0:10:16.89,Default,,0,0,0,,Dasar dara.
Dialog: 0,0:10:17.03,0:10:18.96,Default,,0,0,0,, Selesai.
Dialog: 0,0:10:18.99,0:10:21.55,Default,,0,0,0,,Dia menjadikanmu wali sahnya?
Dialog: 0,0:10:21.57,0:10:23.22,Default,,0,0,0,,Dia sudah bangun sekarang,
Dialog: 0,0:10:23.24,0:10:27.39,Default,,0,0,0,,jadi Anda kehilangan kuasa\Nof pengacara sekarang. Apakah saya benar?
Dialog: 0,0:10:27.41,0:10:29.95,Default,,0,0,0,,Ya, itu benar.
Dialog: 0,0:10:30.12,0:10:33.74,Default,,0,0,0,,- Tunggu. Ayo hubungi dokternya...\N- Diam!
Dialog: 0,0:10:34.00,0:10:36.50,Default,,0,0,0,,Hubungi polisi.
Dialog: 0,0:10:37.01,0:10:38.54,Default,,0,0,0,,Ayah.
Dialog: 0,0:10:38.72,0:10:40.61,Default,,0,0,0,,Itu dia, bukan?
Dialogue: 0,0:10:40.64,0:10:43.96,Default,,0,0,0,,Gadis itu menyakitimu, bukan?
Dialog: 0,0:10:56.65,0:10:58.69,Default,,0,0,0,,Siapa kamu?
Dialog: 0,0:11:11.58,0:11:13.33,Default,,0,0,0,,Ayah...
Dialogue: 0,0:11:41.32,0:11:43.26,Default,,0,0,0,,Sialan!
Dialogue: 0,0:11:43.28,0:11:45.57,Default,,0,0,0,,Kenapa kamu mengusirku juga?
Dialog: 0,0:11:46.58,0:11:48.28,Default,,0,0,0,,Sialan.
Dialog: 0,0:11:55.84,0:11:59.84,Default,,0,0,0,,{\i1}{\c&HFFFF&}Unit Perawatan Intensif{\c}{\i0}
Dialogue: 0,0:12:12.94,0:12:16.81,Default,,0,0,0,,Ada apa... yang salah dengannya?
Dialog: 0,0:12:17.44,0:12:19.06,Default,,0,0,0,,Ibu...
Dialog: 0,0:12:20.73,0:12:21.88,Default,,0,0,0,,Apa masalahnya?
Dialog: 0,0:12:21.90,0:12:25.55,Default,,0,0,0,,CT scan menunjukkan pembengkakan otak akut.
Dialogue: 0,0:12:25.57,0:12:28.01,Default,,0,0,0,,Sel tumor otak menekan\Njaringan di sekitarnya,
Dialog: 0,0:12:28.03,0:12:30.30,Default,,0,0,0,,dan untuk sementara meningkatkan\Ntekanan intrakranialnya.
Dialog: 0,0:12:30.33,0:12:31.56,Default,,0,0,0,,Kita turunkan dulu...
Dialogue: 0,0:12:31.58,0:12:33.52,Default,,0,0,0,,Tumor otak?
Dialog: 0,0:12:33.54,0:12:35.66,Default,,0,0,0,,Apa maksudmu?
Dialog: 0,0:12:36.63,0:12:41.15,Default,,0,0,0,,Apakah Anda mengetahui semua\NHae-in yang diumumkan? Benar-benar?
Dialog: 0,0:12:41.17,0:12:44.32,Default,,0,0,0,,- Sayang.\N- Lalu kenapa kamu tidak memberi tahu kami? Mengapa?
Dialog: 0,0:12:44.34,0:12:45.90,Default,,0,0,0,,Apa yang sedang kamu lakukan?
Dialogue: 0,0:12:45.93,0:12:48.22,Default,,0,0,0,,Kamu seharusnya memberitahu kami dia sakit.
Dialogue: 0,0:12:48.25,0:12:49.28,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:12:49.31,0:12:51.46,Default,,0,0,0,,- Berhenti.\N- Dia menipu kita lagi!
Dialog: 0,0:12:55.02,0:12:56.91,Default,,0,0,0,,Dia merahasiakannya dari kami.
Dialogue: 0,0:12:56.94,0:12:59.37,Default,,0,0,0,,Dia menipu kita saat\NHae-in sakit parah.
Dialog: 0,0:12:59.40,0:13:02.77,Default,,0,0,0,,- Apa rencanamu kali ini?\N- Sudah kubilang berhenti.
Dialog: 0,0:13:07.24,0:13:09.61,Default,,0,0,0,,Kami tidak punya hak untuk marah.
Dialog: 0,0:13:18.00,0:13:19.70,Default,,0,0,0,,Maaf.
Dialog: 0,0:13:20.34,0:13:22.73,Default,,0,0,0,,Kami tidak tahu,
Dialog: 0,0:13:22.76,0:13:25.54,Default,,0,0,0,,meskipun orang tuanya.
Dialog: 0,0:13:26.13,0:13:27.88,Default,,0,0,0,,Tolong jelaskan.
Dialogue: 0,0:13:28.51,0:13:30.67,Default,,0,0,0,,Mohon uraikan...
Dialog: 0,0:13:31.18,0:13:34.99,Default,,0,0,0,,pada kondisinya saat ini.
Dialog: 0,0:13:35.02,0:13:39.00,Default,,0,0,0,,Ms. Hong menderita Cloud Cytoma.
Dialogue: 0,0:13:39.02,0:13:41.81,Default,,0,0,0,,Itu sejenis tumor otak ganas.
Dialog: 0,0:13:41.90,0:13:45.63,Default,,0,0,0,,Tidak seperti tumor pada umumnya, di mana tumor berada...
Dialogue: 0,0:13:45.65,0:13:47.09,Default,,0,0,0,,benjolan besar,
Dialog: 0,0:13:47.11,0:13:50.84,Default,,0,0,0,,sel tumor ini telah menyebar\Nke seluruh saraf kranialnya seperti awan.
Dialogue: 0,0:13:50.87,0:13:55.15,Default,,0,0,0,,Kasusnya sangat langka di seluruh dunia,
Dialog: 0,0:13:55.25,0:13:57.91,Default,,0,0,0,,jadi sulit untuk mengobatinya.
Dialogue: 0,0:14:09.84,0:14:12.13,Default,,0,0,0,,maafkan aku, Bu.
Dialogue: 0,0:14:45.17,0:14:48.61,Default,,0,0,0,,Maafkan aku tidak memberitahumu lebih awal.
Dialogue: 0,0:14:48.63,0:14:51.54,Default,,0,0,0,,Dia mungkin menyuruhmu untuk tidak melakukannya.
Dialogue: 0,0:14:51.93,0:14:54.42,Default,,0,0,0,,Pasti menjadi beban yang berat.
Dialog: 0,0:14:59.02,0:15:01.54,Default,,0,0,0,,Hae-in tidak menginginkan orang tuanya...
Dialog: 0,0:15:01.56,0:15:03.42,Default,,0,0,0,,patah hati,
Dialog: 0,0:15:03.44,0:15:07.52,Default,,0,0,0,,jadi dia ingin memberitahumu\Nonce segalanya membaik.
Dialog: 0,0:15:08.15,0:15:11.23,Default,,0,0,0,,Saya harap Anda tidak salah paham.
Dialog: 0,0:15:33.26,0:15:35.09,Default,,0,0,0,,{\i1}{\c&HFFFF&}{\i1}{\c&HFFFF00&}Ayah.{\c&HFFFF&}{\i0}{\c}{\i0}
Dialog: 0,0:15:41.44,0:15:45.00,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Di tepi lautan yang luas dan tak berujung{\i0} ♫{\c}
Dialogue: 0,0:15:45.02,0:15:48.79,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}berdiri di sebuah pondok sederhana{\i0} ♫{\c}
Dialogue: 0,0:15:48.82,0:15:52.09,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Dulu tinggal seorang ayah nelayan{\i0} ♫{\c}
Dialog: 0,0:15:52.11,0:15:55.59,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}dan putri kecilnya{\i0} ♫{\c}
Dialogue: 0,0:15:55.62,0:15:58.85,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Ya ampun, oh cintaku{\i0} ♫{\c}
Dialog: 0,0:15:58.87,0:16:01.97,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Ya ampun, Clementine{\i0} ♫{\c}
Dialogue: 0,0:16:02.00,0:16:05.48,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Mengapa kamu meninggalkanku selamanya?{\i0} ♫{\c}
Dialogue: 0,0:16:05.50,0:16:09.04,Default,,0,0,0,,{\c&HFFFF00&}♫ {\i1}Meninggalkan ayahmu yang lama{\i0} ♫{\c}
Dialog: 0,0:16:21.89,0:16:23.27,Default,,0,0,0,,Dilihat dari hasil MRI,
Dialog: 0,0:16:23.29,0:16:26.64,Default,,0,0,0,,Saya yakin dia menderita demensia vaskular karena\Ncedera kepala dan pendarahan otak.
Dialog: 0,0:16:26.66,0:16:29.23,Default,,0,0,0,,Kerusakan signifikan pada\Nlobus frontal dan temporalnya...
Dialog: 0,0:16:29.25,0:16:32.26,Default,,0,0,0,,membuatnya sulit\Nberpikir rasional atau mengingat sesuatu.
Dialog: 0,0:16:32.28,0:16:37.55,Default,,0,0,0,,Untuk saat ini, kita tidak punya pilihan selain\Nmenunggu sampai otaknya pulih.
Dialog: 0,0:16:37.57,0:16:39.34,Default,,0,0,0,,Beri dia waktu dua minggu.
Dialogue: 0,0:16:39.37,0:16:41.14,Default,,0,0,0,,Apakah itu berarti dia bisa pulih?
Dialogue: 0,0:16:41.16,0:16:44.74,Default,,0,0,0,,Bervariasi tiap kasus, jadi\NI tidak bisa menjamin apa pun.
Dialog: 0,0:17:12.28,0:17:13.81,Default,,0,0,0,,Seon-hwa.
Dialog: 0,0:17:16.16,0:17:17.69,Default,,0,0,0,,Kamu pasti tercengang.
Dialog: 0,0:17:18.03,0:17:20.09,Default,,0,0,0,,Saya baru saja mendengarnya, dan...
Dialogue: 0,0:17:20.12,0:17:22.61,Default,,0,0,0,,Kamu tahu dia sakit.
Dialogue: 0,0:17:23.45,0:17:27.03,Default,,0,0,0,,Itulah sebabnya kamu menyuruhku\Njangan melakukan hal-hal yang akan aku sesali.
Dialogue: 0,0:17:31.75,0:17:33.62,Default,,0,0,0,,maafkan aku.
Dialog: 0,0:17:37.09,0:17:39.46,Default,,0,0,0,,Semua orang tahu.
Dialogue: 0,0:17:39.97,0:17:42.17,Default,,0,0,0,,Semua orang tahu kecuali aku.
Dialog: 0,0:17:46.44,0:17:48.09,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tapi Bu,{\c}{\i0}
Dialogue: 0,0:17:48.48,0:17:52.43,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku baru saja bilang padamu aku juga punya masalah serius.{\c}{\i0}
Dialog: 0,0:17:52.82,0:17:54.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah kamu tidak penasaran?{\c}{\i0}
Dialogue: 0,0:17:54.36,0:17:58.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anda selalu tahu apa yang harus dilakukan,\Nentah itu besar atau kecil.{\c}{\i0}
Dialog: 0,0:17:58.78,0:18:00.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Benar.{\c}{\i0}
Dialog: 0,0:18:01.03,0:18:02.94,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku akan berhati-hati...{\c}{\i0}
Dialogue: 0,0:18:03.37,0:18:05.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}urusanku.{\c}{\i0}
Dialogue: 0,0:18:07.25,0:18:09.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Astaga, jangan terlalu dramatis.{\c}{\i0}
Dialogue: 0,0:18:09.75,0:18:11.14,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku juga anemia.{\c}{\i0}
Dialogue: 0,0:18:11.17,0:18:14.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku juga pusing, karena\NI juga tidak bisa tidur banyak.{\c}{\i0}
Dialogue: 0,0:18:14.13,0:18:17.28,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sepertinya Soo-cheol juga tidak baik-baik saja.{\c}{\i0}
Dialogue: 0,0:18:17.30,0:18:19.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kita semua menderita di sini.{\c}{\i0}
Dialogue: 0,0:19:58.90,0:20:00.46,Default,,0,0,0,,- Apa?\N- {\i1}Ada apa dengan Hae-in?{\i0}
Dialogue: 0,0:20:00.49,0:20:02.76,Default,,0,0,0,,Benarkah? Apakah dia sakit?
Dialog: 0,0:20:02.78,0:20:04.22,Default,,0,0,0,,Aku ragu keluarganya tahu,
Dialog: 0,0:20:04.24,0:20:05.76,Default,,0,0,0,,bahkan Soo-cheol.
Dialogue: 0,0:20:05.78,0:20:07.98,Default,,0,0,0,,{\i1}Dia pasti kaget.{\i0}
Dialog: 0,0:20:12.21,0:20:13.85,Default,,0,0,0,,Itulah sebabnya kamu menelepon?
Dialog: 0,0:20:13.87,0:20:15.69,Default,,0,0,0,,Ini bantuan kecil.
Dialogue: 0,0:20:15.71,0:20:19.15,Default,,0,0,0,,Dia menderita gangguan kecemasan.\NIItu terjadi saat dia stres.
Dialogue: 0,0:20:19.17,0:20:21.36,Default,,0,0,0,,{\i1}Ini serius. Dia butuh obat.{\i0}
Dialogue: 0,0:20:21.38,0:20:23.57,Default,,0,0,0,,Menurutku dia tidak membawa apa-apa.
Dialog: 0,0:20:23.59,0:20:27.11,Default,,0,0,0,,Kami punya beberapa di rumah. Bisakah\NAnda memberitahu seseorang untuk mendapatkannya?
Dialogue: 0,0:20:27.14,0:20:28.24,Default,,0,0,0,,- Ini...\N- {\i1}Hai.{\i0}
Dialog: 0,0:20:28.26,0:20:31.08,Default,,0,0,0,,- Cheon Da-hye.\N- Dia mungkin pingsan dan mati!
Dialog: 0,0:20:31.10,0:20:34.47,Default,,0,0,0,,- Lalu biarkan dia mati.\N- Hei, bagaimana bisa kamu...?
Dialog: 0,0:20:35.19,0:20:37.37,Default,,0,0,0,,Apa yang kamu ingin aku lakukan?
Dialog: 0,0:20:37.40,0:20:39.38,Default,,0,0,0,,Haruskah aku membunuhnya?
Dialog: 0,0:20:39.40,0:20:42.35,Default,,0,0,0,,Jangan pernah meneleponku lagi\Jangan lakukan hal seperti ini,
Dialog: 0,0:20:42.69,0:20:45.02,Default,,0,0,0,,atau aku akan membunuhnya sendiri.
Dialog: 0,0:20:56.33,0:20:57.87,Default,,0,0,0,,Hyun-woo.
Dialog: 0,0:21:02.88,0:21:04.83,Default,,0,0,0,,Saya rasa inilah alasannya.
Dialog: 0,0:21:05.01,0:21:06.71,Default,,0,0,0,,Apa maksudmu?
Dialog: 0,0:21:10.01,0:21:11.74,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:21:11.77,0:21:14.38,Default,,0,0,0,,Aku disuruh membawa ini...
Dialogue: 0,0:21:16.44,0:21:18.75,Default,,0,0,0,,jadi itu akan melemahkan energinya.
Dialog: 0,0:21:18.77,0:21:21.06,Default,,0,0,0,,Saya tidak percaya.
Dialogue: 0,0:21:21.57,0:21:24.64,Default,,0,0,0,,Aku hanya ingin menjadi lebih baik darinya sekali saja,
Dialog: 0,0:21:25.65,0:21:27.56,Default,,0,0,0,,tapi...
Dialogue: 0,0:21:27.82,0:21:29.55,Default,,0,0,0,,bagaimana jika jimat malang ini...
Dialogue: 0,0:21:29.57,0:21:35.07,Default,,0,0,0,,apakah alasan dia sakit?
Dialogue: 0,0:21:35.37,0:21:36.81,Default,,0,0,0,,Ini semua salahku.
Dialogue: 0,0:21:36.83,0:21:39.91,Default,,0,0,0,,Seharusnya aku tidak membawa jimat bodoh ini.
Dialog: 0,0:22:00.06,0:22:01.76,Default,,0,0,0,,Hae-in.
Dialog: 0,0:22:01.98,0:22:03.81,Default,,0,0,0,,Hae-in!
Dialog: 0,0:22:07.65,0:22:10.86,Default,,0,0,0,,Bagaimana dengan jimat? Kamu gila.
Dialog: 0,0:22:13.58,0:22:17.31,Default,,0,0,0,,Apakah kamu melihatnya? Jimat\N ini pasti kuat.
Dialogue: 0,0:22:17.33,0:22:20.12,Default,,0,0,0,,Dia bangun setelah aku merobeknya.
Dialog: 0,0:22:20.46,0:22:22.08,Default,,0,0,0,,Soo-cheol.
Dialogue: 0,0:22:22.59,0:22:25.00,Default,,0,0,0,,maafkan aku...
Dialog: 0,0:22:26.51,0:22:28.04,Default,,0,0,0,,untuk semuanya.
Dialog: 0,0:22:29.51,0:22:33.92,Default,,0,0,0,,Hyun-woo, menurutku dia tidak waras.
Dialog: 0,0:22:35.64,0:22:37.33,Default,,0,0,0,,Panggil dokter dan keluarga.
Dialog: 0,0:22:37.35,0:22:39.14,Default,,0,0,0,,Keluarga kami...
Dialog: 0,0:22:53.45,0:22:55.90,Default,,0,0,0,,- Apakah kamu baik-baik saja?\N- Aku cinta kamu.
Dialog: 0,0:22:59.08,0:23:01.53,Default,,0,0,0,,Aku mencintaimu...
Dialog: 0,0:23:01.63,0:23:03.53,Default,,0,0,0,,dari saat kita bertemu...
Dialog: 0,0:23:04.29,0:23:05.83,Default,,0,0,0,,hingga sekarang.
Dialogue: 0,0:23:08.67,0:23:11.79,Default,,0,0,0,,Maaf aku tidak memperlakukanmu lebih baik.
Dialog: 0,0:23:12.55,0:23:15.67,Default,,0,0,0,,Aku juga minta maaf karena meninggalkanmu sendirian...
Dialog: 0,0:23:16.77,0:23:18.30,Default,,0,0,0,,dengan keluargaku.
Dialogue: 0,0:23:20.14,0:23:23.35,Default,,0,0,0,,Sepertinya sebagian dari diriku sudah mengetahuinya...
Dialog: 0,0:23:23.98,0:23:25.97,Default,,0,0,0,,kamu ingin bercerai.
Dialogue: 0,0:23:28.36,0:23:29.96,Default,,0,0,0,,Kamu sudah lama bersabar dengan kami,
Dialog: 0,0:23:29.99,0:23:31.90,Default,,0,0,0,,jadi...
Dialog: 0,0:23:32.74,0:23:35.57,Default,,0,0,0,,tidak apa-apa. Jangan merasa buruk.
Dialog: 0,0:23:43.29,0:23:45.12,Default,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:23:45.17,0:23:48.00,Default,,0,0,0,,Jika aku tidak mengatakan hal ini sebelum aku mati,
Dialogue: 0,0:23:49.17,0:23:52.50,Default,,0,0,0,,kamu tidak akan pernah tahu bagaimana perasaanku sebenarnya.
Dialog: 0,0:23:54.80,0:23:56.84,Default,,0,0,0,,Aku memberitahumu ini sekarang,
Dialog: 0,0:23:57.85,0:24:00.09,Default,,0,0,0,,karena aku tidak tahu kapan aku akan mati.
Dialog: 0,0:24:15.91,0:24:17.94,Default,,0,0,0,,Tadi malam,
Dialogue: 0,0:24:19.29,0:24:22.53,Default,,0,0,0,,Aku berdoa lebih banyak dari yang kulakukan sepanjang hidupku.
Dialog: 0,0:24:25.25,0:24:27.74,Default,,0,0,0,,Aku bilang aku tidak akan melakukan apa pun...
Dialog: 0,0:24:28.34,0:24:30.71,Default,,0,0,0,,tapi menangis setiap hari,
Dialog: 0,0:24:31.42,0:24:33.37,Default,,0,0,0,,minum banyak alkohol,
Dialog: 0,0:24:34.01,0:24:35.79,Default,,0,0,0,,tidur di jalan,
Dialog: 0,0:24:36.30,0:24:38.55,Default,,0,0,0,,dan hidup sembarangan...
Dialog: 0,0:24:39.51,0:24:41.59,Default,,0,0,0,,jika kamu mati.
Dialogue: 0,0:24:45.15,0:24:47.35,Default,,0,0,0,,Itu ancaman, bukan doa.
Dialog: 0,0:24:53.57,0:24:55.35,Default,,0,0,0,,Saya tidak peduli.
Dialog: 0,0:24:56.03,0:24:58.11,Default,,0,0,0,,Jika kamu mati,
Dialogue: 0,0:24:59.49,0:25:00.89,Default,,0,0,0,,Aku akan menyerah pada diriku sendiri.
Dialog: 0,0:25:00.91,0:25:01.97,Default,,0,0,0,,Tonton saja.
Dialogue: 0,0:25:02.00,0:25:04.43,Default,,0,0,0,,Bagaimana caranya aku menonton saat aku mati?
Dialog: 0,0:25:04.46,0:25:06.99,Default,,0,0,0,,Jadi, hentikan omong kosong itu.
Dialog: 0,0:25:07.17,0:25:09.45,Default,,0,0,0,,Aku membuka hatiku padamu.
Dialog: 0,0:25:12.05,0:25:13.87,Default,,0,0,0,,Aku bahkan takut...
Dialog: 0,0:25:13.92,0:25:16.67,Default,,0,0,0,,dalam tidurku, kalau-kalau aku tidak bisa...
Dialogue: 0,0:25:17.14,0:25:19.05,Default,,0,0,0,,untuk memberitahumu.
Dialog: 0,0:25:20.51,0:25:22.30,Default,,0,0,0,,Jangan takut.
Dialog: 0,0:25:23.89,0:25:26.01,Default,,0,0,0,,Kamu tidak akan mati.
Dialog: 0,0:25:34.28,0:25:36.60,Default,,0,0,0,,Kamu tidak akan mati.
Dialog: 0,0:25:37.86,0:25:39.94,Default,,0,0,0,,Aku tidak akan membiarkanmu.
Dialog: 0,0:25:58.64,0:26:00.15,Default,,0,0,0,,{\i1}{\c&HFFFF&}Endoskopi{\c}{\i0}
Dialog: 0,0:26:00.18,0:26:01.53,Default,,0,0,0,,Bu!
Dialog: 0,0:26:01.55,0:26:04.63,Default,,0,0,0,,Hae-in bangun! Ayo cepat!
Dialog: 0,0:26:21.62,0:26:24.15,Default,,0,0,0,,Kemana dia pergi?
Dialog: 0,0:26:25.75,0:26:28.93,Default,,0,0,0,,Kenapa kamu tidak memberitahu kami tentang ini?
Dialog: 0,0:26:28.96,0:26:31.98,Default,,0,0,0,,Tapi tidak apa-apa. Saya mengetahuinya sekarang.
Dialog: 0,0:26:32.00,0:26:36.02,Default,,0,0,0,,Jangan khawatir. Banyak teman dekat\Nsaya adalah dokter terkenal.
Dialogue: 0,0:26:36.05,0:26:37.65,Default,,0,0,0,,Mereka ada di seluruh dunia.
Dialog: 0,0:26:37.67,0:26:41.34,Default,,0,0,0,,Benarkah? Seharusnya aku memberitahumu lebih awal.
Dialog: 0,0:26:46.73,0:26:48.26,Default,,0,0,0,,Maaf.
Dialogue: 0,0:26:50.98,0:26:55.04,Default,,0,0,0,,Kenapa kamu minta maaf? Kamulah yang sakit.
Dialogue: 0,0:26:55.07,0:26:57.88,Default,,0,0,0,,Kamu seharusnya memberitahuku lebih awal.
Dialogue: 0,0:26:57.90,0:27:01.15,Default,,0,0,0,,Pasti sangat menyakitkan untuk merahasiakannya.
Dialog: 0,0:27:01.66,0:27:03.98,Default,,0,0,0,,Kamu baik-baik saja sekarang.
Dialog: 0,0:27:04.45,0:27:06.47,Default,,0,0,0,,Semuanya akan baik-baik saja. Oke?
Dialog: 0,0:27:06.49,0:27:08.03,Default,,0,0,0,,Oke.
Dialog: 0,0:27:15.59,0:27:17.33,Default,,0,0,0,,Di mana Ibu?
Dialog: 0,0:27:35.36,0:27:36.93,Default,,0,0,0,,Ibu.
Dialog: 0,0:27:37.32,0:27:39.34,Default,,0,0,0,,Biarkan aku sendiri.
Dialogue: 0,0:27:39.36,0:27:43.11,Default,,0,0,0,,Aku sungguh menyesal tidak memberitahumu...
Dialog: 0,0:27:43.37,0:27:45.11,Default,,0,0,0,,lebih cepat.
Dialogue: 0,0:27:46.53,0:27:48.15,Default,,0,0,0,,Lupakan saja.
Dialog: 0,0:27:48.20,0:27:50.49,Default,,0,0,0,,Ibu macam apa...
Dialog: 0,0:27:51.21,0:27:54.19,Default,,0,0,0,,tidak tahu anaknya sedang sekarat?
Dialog: 0,0:27:54.21,0:27:57.37,Default,,0,0,0,,Aku tidak tahu apa-apa tentang putriku sendiri.
Dialogue: 0,0:28:03.26,0:28:04.86,Default,,0,0,0,,Menyedihkan sekali.
Dialogue: 0,0:28:04.89,0:28:07.45,Default,,0,0,0,,Aku tak percaya aku menghilangkan rasa sakitku...
Dialog: 0,0:28:07.47,0:28:10.59,Default,,0,0,0,,pada putriku sendiri.
Dialogue: 0,0:28:12.48,0:28:15.30,Default,,0,0,0,,Setiap kali anak kecil itu menghubungiku...
Dialogue: 0,0:28:19.32,0:28:20.85,Default,,0,0,0,,{\i1}Aku tidak menggendongnya...{\i0}
Dialog: 0,0:28:21.82,0:28:24.02,Default,,0,0,0,,{\i1}bahkan sekali.{\i0}
Dialogue: 0,0:28:38.55,0:28:40.94,Default,,0,0,0,,{\i1}Bahkan aku tidak bisa hidup dengan diriku sendiri.{\i0}
Dialogue: 0,0:28:40.96,0:28:43.58,Default,,0,0,0,,Aku benci punya ibu sepertiku.
Dialog: 0,0:28:49.06,0:28:50.71,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:28:51.31,0:28:53.04,Default,,0,0,0,,Ini semua salahku.
Dialogue: 0,0:28:53.06,0:28:56.33,Default,,0,0,0,,Aku menyebabkan putriku...
Dialog: 0,0:28:56.35,0:28:59.85,Default,,0,0,0,,rasa sakit dan stres.
Dialog: 0,0:29:00.61,0:29:03.06,Default,,0,0,0,,Itulah sebabnya dia sakit.
Dialog: 0,0:29:24.42,0:29:26.50,Default,,0,0,0,,Apakah Anda seorang dokter?
Dialogue: 0,0:29:32.81,0:29:36.39,Default,,0,0,0,,Bagaimana kamu bisa mengetahui hal-hal\Na dokter bahkan tidak mengetahuinya?
Dialogue: 0,0:29:36.44,0:29:40.08,Default,,0,0,0,,Mereka tidak tahu penyebabnya,\Atau cara mencegah penyakitku.
Dialogue: 0,0:29:40.11,0:29:42.92,Default,,0,0,0,,Itu juga bukan disebabkan oleh stres.
Dialog: 0,0:29:42.94,0:29:45.10,Default,,0,0,0,,Apa kabar...
Dialog: 0,0:29:51.12,0:29:53.11,Default,,0,0,0,,naif sekali?
Dialogue: 0,0:29:53.66,0:29:55.70,Default,,0,0,0,,Kamu sangat menyebalkan.
Dialog: 0,0:29:59.83,0:30:01.37,Default,,0,0,0,,Dan...
Dialog: 0,0:30:03.59,0:30:05.33,Default,,0,0,0,,Saya akan kesulitan...
Dialogue: 0,0:30:06.22,0:30:08.50,Default,,0,0,0,,memiliki anak perempuan sepertiku juga,
Dialog: 0,0:30:08.55,0:30:10.67,Default,,0,0,0,,jadi itu semua bukan salahmu.
Dialog: 0,0:30:11.47,0:30:13.01,Default,,0,0,0,,Hae-in.
Dialog: 0,0:30:32.95,0:30:34.82,Default,,0,0,0,,Sakit...
Dialog: 0,0:30:35.45,0:30:37.61,Default,,0,0,0,,banyak?
Dialog: 0,0:30:43.04,0:30:45.08,Default,,0,0,0,,Yah...
Dialogue: 0,0:30:45.21,0:30:49.00,Default,,0,0,0,,Ada kalanya\Nsakit dan ada kalanya tidak.
Dialogue: 0,0:30:54.51,0:30:57.42,Default,,0,0,0,,Aku tidak menyangka kamu sakit.
Dialog: 0,0:30:57.77,0:30:59.55,Default,,0,0,0,,Maaf.
Dialogue: 0,0:31:00.10,0:31:02.05,Default,,0,0,0,,Ini semua salahku.
Dialog: 0,0:31:02.48,0:31:05.18,Default,,0,0,0,,Maaf.
Dialog: 0,0:31:05.23,0:31:07.69,Default,,0,0,0,,Saya salah.
Dialog: 0,0:31:09.07,0:31:11.15,Default,,0,0,0,,Sudah kubilang.
Dialog: 0,0:31:11.24,0:31:14.39,Default,,0,0,0,,Ini tidak ada hubungannya dengan caramu memperlakukanku.
Dialog: 0,0:31:14.41,0:31:17.28,Default,,0,0,0,,Aku tidak ingin memberitahumu, karena aku tahu...
Dialog: 0,0:31:19.41,0:31:21.66,Default,,0,0,0,,kamu tidak akan mengerti.
Dialog: 0,0:31:24.75,0:31:26.29,Default,,0,0,0,,Maaf.
Dialog: 0,0:31:26.38,0:31:27.98,Default,,0,0,0,,Saya...
Dialogue: 0,0:31:28.01,0:31:30.71,Default,,0,0,0,,Maafkan aku.
Dialog: 0,0:31:31.93,0:31:33.84,Default,,0,0,0,,Saya tidak bisa hidup...
Dialog: 0,0:31:34.26,0:31:36.34,Default,,0,0,0,,tanpamu.
Dialog: 0,0:31:36.51,0:31:38.87,Default,,0,0,0,,Tidak.
Dialog: 0,0:31:38.89,0:31:40.72,Default,,0,0,0,,Jangan mati.
Dialog: 0,0:31:43.10,0:31:47.31,Default,,0,0,0,,Tolong jangan mati, Hae-in. aku minta maaf...
Dialog: 0,0:32:00.87,0:32:02.99,Default,,0,0,0,,Hae-in sayang...
Dialog: 0,0:32:12.05,0:32:15.29,Default,,0,0,0,,Maaf...
Dialog: 0,0:32:30.65,0:32:34.72,Default,,0,0,0,,Keberuntungan hanya berpihak padanya, karena\Ngadis jahat itu pekerja keras.
Dialogue: 0,0:32:34.74,0:32:37.48,Default,,0,0,0,,Dia sungguh hebat.
Dialog: 0,0:32:48.29,0:32:49.44,Default,,0,0,0,,Ketua Hong.
Dialog: 0,0:32:49.46,0:32:52.08,Default,,0,0,0,,Apakah kamu mengenali di mana kita berada?
Dialog: 0,0:32:56.97,0:33:00.76,Default,,0,0,0,,Ayo, jangan takut. Kami di rumah.
Dialog: 0,0:33:01.89,0:33:03.88,Default,,0,0,0,,Ayo masuk ke dalam.
Dialogue: 0,0:33:10.86,0:33:15.52,Default,,0,0,0,,Bu, banyak kursi roda\Nlistrik yang bagus saat ini.
Dialog: 0,0:33:42.52,0:33:46.41,Default,,0,0,0,,Ketua mungkin tidak ikut serta,\Ntapi dia menolak diberi makan...
Dialog: 0,0:33:46.44,0:33:47.62,Default,,0,0,0,,oleh siapa pun kecuali aku,
Dialog: 0,0:33:47.65,0:33:51.08,Default,,0,0,0,,jadi aku tidak bisa meninggalkannya. Itu sebabnya aku memintamu datang ke sini.
Dialog: 0,0:33:51.11,0:33:54.80,Default,,0,0,0,,Kami mengerti. Hanya\Nberkat kamu dia terbangun.
Dialogue: 0,0:33:54.82,0:33:57.17,Default,,0,0,0,,Cukup dengan sanjungan. Jelaskan sendiri.
Dialogue: 0,0:33:57.20,0:33:59.76,Default,,0,0,0,,Bagaimana dia bisa mengadakan\Nkonferensi pers seperti itu sekarang?
Dialog: 0,0:33:59.78,0:34:02.55,Default,,0,0,0,,Kami juga tidak tahu.\NCketua Yoon tiba-tiba...
Dialogue: 0,0:34:02.58,0:34:04.05,Default,,0,0,0,,Kamu seharusnya tahu lebih baik.
Dialogue: 0,0:34:04.08,0:34:06.18,Default,,0,0,0,,Kamu hanya dibayar begitu banyak...
Dialogue: 0,0:34:06.21,0:34:09.27,Default,,0,0,0,,sehingga Anda dapat mencegah terjadinya bencana seperti itu.
Dialog: 0,0:34:09.29,0:34:11.40,Default,,0,0,0,,Ya ampun, bukankah seharusnya aku mengatakan itu?
Dialog: 0,0:34:11.42,0:34:13.73,Default,,0,0,0,,"Kamu tidak berhak mengatakan hal seperti itu kepada kami."
Dialog: 0,0:34:13.76,0:34:16.53,Default,,0,0,0,,"Apa yang kamu tahu, ketika kamu hanya\Nmemasak dan merawat ketua?"
Dialog: 0,0:34:16.55,0:34:19.49,Default,,0,0,0,,- Begitukah?\N- Tentu saja tidak, Bu.
Dialogue: 0,0:34:19.51,0:34:22.61,Default,,0,0,0,,Dalam hal ini, kirimkan semua\Ndraft kepada saya sebelum Anda memberikannya...
Dialog: 0,0:34:22.64,0:34:26.16,Default,,0,0,0,,kepada Ketua Yoon, dan suruh\tim NPR datang besok pagi.
Dialogue: 0,0:34:26.18,0:34:27.79,Default,,0,0,0,,Untuk apa?
Dialog: 0,0:34:27.81,0:34:30.12,Default,,0,0,0,,Apakah kamu tidak membaca beritanya? Masyarakat sangat marah.
Dialog: 0,0:34:30.15,0:34:33.73,Default,,0,0,0,,Mereka bersimpati dengan\Nmantan manajemen dan mengkritik kami.
Dialogue: 0,0:34:33.76,0:34:36.50,Default,,0,0,0,,Apakah hanya saya yang khawatir\Ntentang jatuhnya harga saham?
Dialog: 0,0:34:36.52,0:34:38.51,Default,,0,0,0,,Mitra terbatas jangkar sangat marah.
Dialogue: 0,0:34:38.53,0:34:39.76,Default,,0,0,0,,Mereka khawatir...
Dialog: 0,0:34:39.78,0:34:42.47,Default,,0,0,0,,titik keluar akan tertunda\Nkarena anjloknya stok.
Dialog: 0,0:34:42.49,0:34:45.94,Default,,0,0,0,,Rumor mengatakan mereka ingin menetapkan\Nup investor mitra umum.
Dialogue: 0,0:34:46.00,0:34:49.56,Default,,0,0,0,,Kita harus menemukan dana rahasia\Njika kita ingin mereka tutup mulut.
Dialogue: 0,0:34:49.58,0:34:50.77,Default,,0,0,0,,Sudahkah kamu mendalaminya?
Dialog: 0,0:34:50.79,0:34:53.27,Default,,0,0,0,,Ya, dipastikan bahwa Jamal Ibrahim,
Dialog: 0,0:34:53.29,0:34:56.98,Default,,0,0,0,,presiden bank LCC\NInvestment Bank di Labuan, Malaysia,
Dialog: 0,0:34:57.01,0:34:58.69,Default,,0,0,0,,mengelola akun.
Dialog: 0,0:34:58.72,0:35:01.36,Default,,0,0,0,,Saya pikir dia menarik\Nuang dan mentransfernya.
Dialog: 0,0:35:01.39,0:35:03.55,Default,,0,0,0,,- Berapa?\N- Hampir $900 juta.
Dialogue: 0,0:35:04.60,0:35:06.83,Default,,0,0,0,,Kirim seseorang ke Labuan sekarang juga.
Dialog: 0,0:35:06.85,0:35:09.64,Default,,0,0,0,,Cari tahu rute selanjutnya.
Dialogue: 0,0:35:09.81,0:35:13.51,Default,,0,0,0,,Restoran ini terkenal dengan {\i1}kal-guksu.{\i0}
Dialog: 0,0:35:13.82,0:35:16.56,Default,,0,0,0,,- Cobalah makan.\N- Maaf.
Dialog: 0,0:35:16.86,0:35:18.85,Default,,0,0,0,,Saya rasa saya tidak bisa.
Dialog: 0,0:35:19.82,0:35:23.36,Default,,0,0,0,,Kamu perlu makan enak di saat seperti ini.
Dialogue: 0,0:35:23.62,0:35:25.05,Default,,0,0,0,,Keluargamu bergantung padamu.
Dialogue: 0,0:35:25.08,0:35:29.14,Default,,0,0,0,,Kamu harus tetap kuat jika\Ningin anak-anakmu melakukan hal yang sama.
Dialogue: 0,0:35:29.16,0:35:32.07,Default,,0,0,0,,Mereka tidak mengandalkan kekuatanku.
Dialog: 0,0:35:32.46,0:35:34.35,Default,,0,0,0,,Aku bukan pilar keluarga kita.
Dialogue: 0,0:35:34.38,0:35:37.98,Default,,0,0,0,,Sebenarnya, itu adalah ayahku selama ini.
Dialogue: 0,0:35:38.01,0:35:41.88,Default,,0,0,0,,Itu kadang menyakitiku, tapi\NI juga merasa lega.
Dialogue: 0,0:35:43.43,0:35:45.03,Default,,0,0,0,,Menyedihkan bukan?
Dialogue: 0,0:35:45.05,0:35:47.70,Default,,0,0,0,,Aku lega anak-anakku tidak bergantung padaku.
Dialog: 0,0:35:47.72,0:35:50.88,Default,,0,0,0,,Putriku sedang sekarat,
Dialog: 0,0:35:52.65,0:35:55.93,Default,,0,0,0,,dan aku menyuruhnya untuk percaya padaku,
Dialogue: 0,0:35:56.02,0:35:59.55,Default,,0,0,0,,tapi aku ragu itu berarti apa-apa baginya.
Dialogue: 0,0:35:59.57,0:36:01.26,Default,,0,0,0,,Kamu salah.
Dialogue: 0,0:36:01.28,0:36:03.34,Default,,0,0,0,,Anak-anak kita tidak memandang kita seperti itu.
Dialog: 0,0:36:03.36,0:36:05.68,Default,,0,0,0,,Ayahku meninggal sebelum waktunya,
Dialog: 0,0:36:05.70,0:36:07.01,Default,,0,0,0,,tetapi bahkan sampai hari ini,
Dialogue: 0,0:36:07.03,0:36:09.35,Default,,0,0,0,,Aku memikirkan dia saat aku perlu\N mengambil keputusan sulit.
Dialog: 0,0:36:09.37,0:36:11.68,Default,,0,0,0,,"Apa yang akan dia lakukan?"
Dialog: 0,0:36:11.71,0:36:13.78,Default,,0,0,0,,Kamu...
Dialogue: 0,0:36:14.54,0:36:16.79,Default,,0,0,0,,mercusuar untuk anak-anakmu,
Dialog: 0,0:36:17.13,0:36:19.11,Default,,0,0,0,,tidak peduli siapa kamu,
Dialog: 0,0:36:19.13,0:36:21.40,Default,,0,0,0,,jadi makanlah dengan baik, tetap kuat,
Dialog: 0,0:36:21.42,0:36:25.21,Default,,0,0,0,,tegakkan kepalamu, dan sorotkan cahayamu.
Dialog: 0,0:36:26.35,0:36:28.17,Default,,0,0,0,,Di Sini.
Dialog: 0,0:36:28.35,0:36:29.88,Default,,0,0,0,,Di Sini.
Dialog: 0,0:36:30.64,0:36:32.16,Default,,0,0,0,,Ayo makan.
Dialogue: 0,0:36:32.19,0:36:34.62,Default,,0,0,0,,Bahkan {\i1}kal-guksu{\i0} terlezat pun tidak enak...
Dialog: 0,0:36:34.65,0:36:36.26,Default,,0,0,0,,jika basah.
Dialog: 0,0:36:50.58,0:36:52.64,Default,,0,0,0,,"Apa yang baru saja kutonton? Apa ini drama?"
Dialogue: 0,0:36:52.66,0:36:55.31,Default,,0,0,0,,"Dia masih bodohnya jatuh cinta pada mantan suaminya."
Dialogue: 0,0:36:55.33,0:36:57.20,Default,,0,0,0,,"Aku belum pernah melihat orang yang sakit parah..."
Dialog: 0,0:36:57.23,0:36:59.14,Default,,0,0,0,,- "sangat jatuh cinta."\N- Cukup.
Dialogue: 0,0:37:00.38,0:37:03.23,Default,,0,0,0,,Kamu menjadi perbincangan\Nkota saat kamu tertidur.
Dialog: 0,0:37:03.26,0:37:04.82,Default,,0,0,0,,Jangan konyol. Ini memalukan.
Dialog: 0,0:37:04.84,0:37:08.03,Default,,0,0,0,,Apa maksudmu? Anda\Nmengalami perubahan dramatis.
Dialogue: 0,0:37:08.05,0:37:10.41,Default,,0,0,0,,Anda berambisi\Nbergabung dengan Klub Satu Miliar.
Dialogue: 0,0:37:10.43,0:37:12.78,Default,,0,0,0,,Kemudian keluargamu bangkrut\Nan melarikan diri dalam satu hari,
Dialog: 0,0:37:12.81,0:37:15.47,Default,,0,0,0,,dan sekarang kamu adalah Juliet.
Dialogue: 0,0:37:15.73,0:37:18.50,Default,,0,0,0,,Sederhananya, orang berpikir\NI sedang jatuh cinta tanpa harapan...
Dialog: 0,0:37:18.52,0:37:22.31,Default,,0,0,0,,dengan mantan suamiku, dan itu\NI mengungkapkan penyakitku hanya untuk menyelamatkannya.
Dialogue: 0,0:37:22.57,0:37:24.98,Default,,0,0,0,,- Itu benar.\N- Itu sebabnya aku malu.
Dialog: 0,0:37:25.86,0:37:28.59,Default,,0,0,0,,Ada hal lain yang perlu dikhawatirkan.
Dialog: 0,0:37:28.62,0:37:30.32,Default,,0,0,0,,Seperti...?
Dialogue: 0,0:37:34.21,0:37:36.07,Default,,0,0,0,,Apa ini?
Dialogue: 0,0:37:37.29,0:37:38.56,Default,,0,0,0,,Saya membeli pakaian formal.
Dialog: 0,0:37:38.58,0:37:41.27,Default,,0,0,0,,Saya membelinya dengan harga penuh di department store.
Dialog: 0,0:37:41.30,0:37:43.57,Default,,0,0,0,,- Apa artinya ini?\N- Katakan padaku.
Dialog: 0,0:37:43.59,0:37:45.98,Default,,0,0,0,,Bahwa saya sangat bersemangat...
Dialogue: 0,0:37:46.01,0:37:48.17,Default,,0,0,0,,tentang pengembalianmu,
Dialog: 0,0:37:48.59,0:37:50.41,Default,,0,0,0,,tapi saya harus mendapatkan pengembalian dana.
Dialog: 0,0:37:50.43,0:37:51.87,Default,,0,0,0,,Jangan ganggu.
Dialogue: 0,0:37:51.89,0:37:54.03,Default,,0,0,0,,Mereka akan menugaskanmu ke orang lain.
Dialog: 0,0:37:54.06,0:37:55.70,Default,,0,0,0,,Kalau begitu, kamu bisa memakainya.
Dialogue: 0,0:37:55.73,0:37:57.45,Default,,0,0,0,,- Tidak, terima kasih.\N- Kenapa tidak?
Dialogue: 0,0:37:57.48,0:37:59.16,Default,,0,0,0,,Kau tahu aku malu dengan orang asing.
Dialogue: 0,0:37:59.19,0:38:02.81,Default,,0,0,0,,Mengingat pekerjaanku, aku tidak akan\Nmemiliki banyak peluang,
Dialog: 0,0:38:03.11,0:38:06.40,Default,,0,0,0,,jadi kembalilah. aku akan menunggu.
Dialog: 0,0:38:06.49,0:38:08.44,Default,,0,0,0,,Saya tidak bisa menjamin itu,
Dialog: 0,0:38:08.82,0:38:10.63,Default,,0,0,0,,tapi aku akan melakukan yang terbaik.
Dialog: 0,0:38:10.66,0:38:14.36,Default,,0,0,0,,Saya pikir itu tidak masalah.\NAnda selalu mengatakan untuk membuatnya berhasil,
Dialog: 0,0:38:14.66,0:38:16.70,Default,,0,0,0,,jadi saya akan mengatakan hal yang sama.
Dialog: 0,0:38:17.04,0:38:19.66,Default,,0,0,0,,Kembalilah sebelum saya membayar semua cicilannya.
Dialog: 0,0:38:21.42,0:38:23.19,Default,,0,0,0,,Dan kapan itu?
Dialog: 0,0:38:23.21,0:38:24.79,Default,,0,0,0,,Dalam enam bulan.
Dialogue: 0,0:38:25.67,0:38:28.13,Default,,0,0,0,,- Agak...\N- Baru saja kembali.
Dialog: 0,0:38:28.93,0:38:31.36,Default,,0,0,0,,Baik, saya akan melakukannya.
Dialogue: 0,0:38:31.39,0:38:33.05,Default,,0,0,0,,Kenapa kamu marah?
Dialog: 0,0:38:36.31,0:38:38.01,Default,,0,0,0,,Saya akan...
Dialog: 0,0:38:38.64,0:38:40.37,Default,,0,0,0,,peluk kamu hari ini,
Dialog: 0,0:38:40.40,0:38:42.51,Default,,0,0,0,,karena kamu akhirnya bangun.
Dialogue: 0,0:38:58.04,0:38:59.39,Default,,0,0,0,,Lihat ini.
Dialogue: 0,0:38:59.42,0:39:04.66,Default,,0,0,0,,Aku menjadi seorang janda cerai yang masih\Nmencintai mantannya dalam satu hari.
Dialog: 0,0:39:08.80,0:39:09.99,Default,,0,0,0,,Apakah ini lucu bagimu?
Dialogue: 0,0:39:10.01,0:39:13.25,Default,,0,0,0,,Mengapa kamu membiarkan hal itu mengganggumu?
Dialog: 0,0:39:14.56,0:39:16.26,Default,,0,0,0,,Lihat ke belakangmu.
Dialogue: 0,0:39:22.81,0:39:25.39,Default,,0,0,0,,Mereka mengasihaniku, bukan?
Dialogue: 0,0:39:26.57,0:39:28.52,Default,,0,0,0,,Belum pernah ada yang menatapku seperti itu sebelumnya.
Dialogue: 0,0:39:28.55,0:39:30.83,Default,,0,0,0,,Ini yang pertama.
Dialog: 0,0:39:31.32,0:39:33.73,Default,,0,0,0,,Ini tidak akan berhasil.
Dialog: 0,0:39:33.99,0:39:36.49,Default,,0,0,0,,Manjakan aku di depan mereka.
Dialog: 0,0:39:37.33,0:39:39.01,Default,,0,0,0,,"Di depan mereka"?
Dialog: 0,0:39:39.04,0:39:41.68,Default,,0,0,0,,- Bagaimana?\N- Pertama...
Dialog: 0,0:39:41.71,0:39:45.12,Default,,0,0,0,,- Tatap aku dengan penuh kasih.\N- "Dengan penuh kasih"?
Dialog: 0,0:39:53.39,0:39:54.92,Default,,0,0,0,,Seperti ini?
Dialog: 0,0:40:03.85,0:40:06.85,Default,,0,0,0,,Yah...
Dialog: 0,0:40:13.86,0:40:15.57,Default,,0,0,0,,Lumayan.
Dialogue: 0,0:40:27.67,0:40:29.87,Default,,0,0,0,,Berapa lama kamu akan terus mencari?
Dialog: 0,0:40:29.92,0:40:31.40,Default,,0,0,0,,Apa?
Dialogue: 0,0:40:31.42,0:40:33.25,Default,,0,0,0,,Apa yang dilakukan lengan kirimu?
Dialog: 0,0:40:34.34,0:40:36.04,Default,,0,0,0,,Benar.
Dialog: 0,0:40:36.26,0:40:37.84,Default,,0,0,0,,Seperti ini?
Dialog: 0,0:40:48.11,0:40:51.28,Default,,0,0,0,,{\i1}{\c&HFFFF&}Pusat Medis Universitas Sungmin{\c}{\i0}
Dialog: 0,0:41:09.67,0:41:11.36,Default,,0,0,0,,Saya terkejut Anda menelepon.
Dialogue: 0,0:41:11.38,0:41:13.02,Default,,0,0,0,,Ada yang ingin kukatakan.
Dialog: 0,0:41:13.05,0:41:14.57,Default,,0,0,0,,Bagaimana perasaanmu?
Dialogue: 0,0:41:14.59,0:41:15.78,Default,,0,0,0,,Aku lebih baik.
Dialog: 0,0:41:15.80,0:41:18.00,Default,,0,0,0,,Saya berangkat besok.
Dialog: 0,0:41:18.64,0:41:19.74,Default,,0,0,0,,Kenapa secepat ini?
Dialog: 0,0:41:19.76,0:41:23.12,Default,,0,0,0,,- Tidak banyak yang bisa mereka lakukan untukku.\N- Lalu kembali ke rumah.
Dialog: 0,0:41:23.14,0:41:24.41,Default,,0,0,0,,Akan lebih nyaman.
Dialog: 0,0:41:24.44,0:41:27.14,Default,,0,0,0,,Saya tidak menelepon untuk membicarakan hal itu.
Dialogue: 0,0:41:27.18,0:41:29.09,Default,,0,0,0,,- Aku mendengarkan.\N- Aku tahu kamu sedang bingung.
Dialogue: 0,0:41:29.12,0:41:30.96,Default,,0,0,0,,Kamu kesulitan menghadapi media.
Dialogue: 0,0:41:30.98,0:41:33.35,Default,,0,0,0,,Mitra terbatas jangkar\Npasti membebanimu.
Dialogue: 0,0:41:33.38,0:41:35.51,Default,,0,0,0,,Kamu tidak akan punya cukup stok untuk menghentikan mereka,
Dialog: 0,0:41:35.53,0:41:39.07,Default,,0,0,0,,meskipun mereka menginginkan partner umum yang baru.
Dialog: 0,0:41:40.03,0:41:41.64,Default,,0,0,0,,Jadi, Anda tahu.
Dialog: 0,0:41:41.66,0:41:42.89,Default,,0,0,0,,Semuanya berkat kamu,
Dialog: 0,0:41:42.91,0:41:44.74,Default,,0,0,0,,jadi...
Dialog: 0,0:41:46.00,0:41:47.39,Default,,0,0,0,,apakah kamu mengkhawatirkanku?
Dialog: 0,0:41:47.42,0:41:51.31,Default,,0,0,0,,Tidak. Saya tidak merasa buruk dengan situasi Anda.
Dialog: 0,0:41:51.34,0:41:55.71,Default,,0,0,0,,Provokasi saya lagi, dan Anda akan\Nkehilangan sesuatu yang lebih besar.
Dialog: 0,0:41:56.43,0:41:58.21,Default,,0,0,0,,Itu saja.
Dialog: 0,0:42:01.68,0:42:03.07,Default,,0,0,0,,Baik.
Dialogue: 0,0:42:03.10,0:42:05.43,Default,,0,0,0,,Mungkin itu sebabnya kamu menelepon,
Dialog: 0,0:42:06.35,0:42:08.51,Default,,0,0,0,,tapi jantungku berdetak kencang...
Dialogue: 0,0:42:09.73,0:42:13.31,Default,,0,0,0,,saat aku menerima teleponmu, meskipun\Nmeskipun aku tahu alasanmu menelepon.
Dialog: 0,0:42:14.32,0:42:16.19,Default,,0,0,0,,Kamu tidak tahu...
Dialogue: 0,0:42:16.90,0:42:19.17,Default,,0,0,0,,sudah berapa lama aku merasakan perasaan ini,
Dialog: 0,0:42:19.20,0:42:21.47,Default,,0,0,0,,atau saat pertama kali dikembangkan.
Dialog: 0,0:42:21.49,0:42:23.03,Default,,0,0,0,,Tidak, saya tidak,
Dialog: 0,0:42:27.16,0:42:28.87,Default,,0,0,0,,dan saya tidak perlu melakukannya.
Dialog: 0,0:42:29.79,0:42:31.58,Default,,0,0,0,,Apakah kamu ingat kenapa...
Dialogue: 0,0:42:31.71,0:42:33.94,Default,,0,0,0,,Aku memutuskan hubungan denganmu saat kuliah?
Dialog: 0,0:42:33.96,0:42:36.48,Default,,0,0,0,,Saya berterima kasih atas\Nbantuan Anda ketika saya kesulitan,
Dialogue: 0,0:42:36.51,0:42:39.67,Default,,0,0,0,,tapi kaulah alasanku berjuang...
Dialog: 0,0:42:39.89,0:42:41.75,Default,,0,0,0,,di tempat pertama.
Dialogue: 0,0:42:42.01,0:42:45.67,Default,,0,0,0,,Mungkin kamu seharusnya menyukaiku\Nkembali sebelum aku melakukan hal-hal itu.
Dialog: 0,0:42:46.06,0:42:47.54,Default,,0,0,0,,Saya hanya melakukan hal seperti itu...
Dialog: 0,0:42:47.56,0:42:50.66,Default,,0,0,0,,karena aku tidak bisa dekat denganmu,\Nsekeras apa pun aku berusaha.
Dialogue: 0,0:42:50.69,0:42:53.01,Default,,0,0,0,,Begitulah caramu memperlakukan orang lain.
Dialogue: 0,0:42:53.19,0:42:54.92,Default,,0,0,0,,Lihat dirimu sekarang juga.
Dialogue: 0,0:42:54.94,0:42:58.81,Default,,0,0,0,,Kamu mendorongku ke dalam selokan sehingga\Nkamu bisa mengeluarkanku dari situ,
Dialogue: 0,0:42:59.53,0:43:02.11,Default,,0,0,0,,jadi siapa yang mungkin menyukaimu?
Dialog: 0,0:43:02.16,0:43:04.65,Default,,0,0,0,,Lalu bagaimana dengan Hyun-woo?
Dialog: 0,0:43:05.54,0:43:07.61,Default,,0,0,0,,Apakah dia pantas mendapatkan cintamu?
Dialog: 0,0:43:07.83,0:43:10.23,Default,,0,0,0,,Dia akan meninggalkanmu.
Dialogue: 0,0:43:10.25,0:43:13.19,Default,,0,0,0,,Apakah tumormu mengganggu\Ningatanmu? Apakah kamu lupa?
Dialogue: 0,0:43:13.21,0:43:15.08,Default,,0,0,0,,Dia bersamaku sekarang.
Dialog: 0,0:43:18.17,0:43:20.04,Default,,0,0,0,,Dia bersamaku...
Dialog: 0,0:43:20.26,0:43:21.79,Default,,0,0,0,,saat ini.
Dialog: 0,0:43:24.31,0:43:26.26,Default,,0,0,0,,Haruskah saya jelaskan lebih lanjut?
Dialog: 0,0:43:42.78,0:43:45.69,Default,,0,0,0,,- Apakah Anda sudah selesai berbicara?\N- Tuan Baek.
Dialogue: 0,0:43:45.78,0:43:47.72,Default,,0,0,0,,Kenapa kamu masih bertahan dengannya?
Dialog: 0,0:43:47.75,0:43:49.89,Default,,0,0,0,,Kenapa aku harus memberitahumu?
Dialogue: 0,0:43:49.91,0:43:53.02,Default,,0,0,0,,Apakah perasaanmu berkembang\Nsetelah mengetahui dia sekarat,
Dialogue: 0,0:43:53.04,0:43:56.08,Default,,0,0,0,,atau kamu berharap dia akan meninggalkan sesuatu untukmu?
Dialog: 0,0:43:58.38,0:43:59.52,Default,,0,0,0,,Datang saja padaku.
Dialogue: 0,0:43:59.55,0:44:02.75,Default,,0,0,0,,Aku akan memberimu apa saja\Nyang kamu inginkan jika kamu meninggalkannya.
Dialog: 0,0:44:12.52,0:44:15.76,Default,,0,0,0,,Kamu benar-benar menguji kesabaranku, jadi pergilah.
Dialog: 0,0:44:21.65,0:44:23.19,Default,,0,0,0,,Hei.
Dialogue: 0,0:44:28.08,0:44:31.31,Default,,0,0,0,,Aku tidak ingin memberitahumu sesuatu\NI bahkan belum memberitahunya.
Dialog: 0,0:44:31.33,0:44:33.98,Default,,0,0,0,,Coba semua yang kamu mau. Aku tidak akan kemana-mana.
Dialogue: 0,0:44:34.00,0:44:37.06,Default,,0,0,0,,Aku akan tetap bersamanya selamanya.
Dialog: 0,0:44:37.09,0:44:38.66,Default,,0,0,0,,Aku akan bersamanya,
Dialogue: 0,0:44:38.92,0:44:41.92,Default,,0,0,0,,jadi jangan menahan nafasmu dan pergilah.
Dialogue: 0,0:44:57.90,0:44:59.72,Default,,0,0,0,,Kau sampai di rumah.
Dialog: 0,0:45:00.48,0:45:01.88,Default,,0,0,0,,Ketua ada di sini.
Dialog: 0,0:45:01.90,0:45:03.52,Default,,0,0,0,,Apakah kamu dengar?
Dialog: 0,0:45:06.91,0:45:08.57,Default,,0,0,0,,Kamu terlihat bahagia.
Dialog: 0,0:45:08.70,0:45:09.76,Default,,0,0,0,,Tentu saja tidak.
Dialogue: 0,0:45:09.79,0:45:14.24,Default,,0,0,0,,Bagaimana aku bisa, ketika cinta\Ndalam hidupmu menghancurkan hatimu?
Dialogue: 0,0:45:14.71,0:45:16.14,Default,,0,0,0,,Apa yang terjadi dengan wajahmu?
Dialogue: 0,0:45:16.17,0:45:18.62,Default,,0,0,0,,- Apakah kamu terluka?\N- Tidak ada...
Dialog: 0,0:45:19.59,0:45:21.66,Default,,0,0,0,,bisnis Anda.
Dialogue: 0,0:45:22.34,0:45:25.33,Default,,0,0,0,,Aku selalu menjalani kehidupan tanpa harapan.
Dialog: 0,0:45:25.51,0:45:27.74,Default,,0,0,0,,Tidak ada rasa sakit yang lebih besar dari yang lain,
Dialog: 0,0:45:27.76,0:45:30.30,Default,,0,0,0,,dan aku tidak peduli jika aku terluka,
Dialog: 0,0:45:30.56,0:45:32.58,Default,,0,0,0,,jadi berhentilah mencoba bertindak...
Dialog: 0,0:45:32.60,0:45:34.30,Default,,0,0,0,,seperti ibu pada umumnya.
Dialog: 0,0:45:36.65,0:45:38.35,Default,,0,0,0,,Anda kedatangan tamu.
Dialogue: 0,0:45:48.91,0:45:51.14,Default,,0,0,0,,Kenapa belum diangkat?
Dialogue: 0,0:45:51.16,0:45:55.74,Default,,0,0,0,,Apakah kamu tidak merasa bersalah atas apa yang terjadi padaku?
Dialog: 0,0:45:57.62,0:46:00.70,Default,,0,0,0,,Sudah kubilang jangan meneleponku, jadi kenapa kamu ada di sini?
Dialogue: 0,0:46:01.50,0:46:05.61,Default,,0,0,0,,Saya menghindari penangkapan, tapi\Nmereka tidak membiarkan saya lolos.
Dialog: 0,0:46:05.63,0:46:09.20,Default,,0,0,0,,- Baek Hyun-woo tidak mau duduk diam!\N- Jadi?
Dialogue: 0,0:46:09.22,0:46:12.12,Default,,0,0,0,,Akankah hanya aku yang terjatuh,\Njika dunia tahu...
Dialogue: 0,0:46:12.14,0:46:14.57,Default,,0,0,0,,tentang kontrak ganda\Ndan penipuan investasi tanah?
Dialog: 0,0:46:14.60,0:46:18.59,Default,,0,0,0,,Apakah menurut Anda Anda akan mempertahankan\Nposisi Anda, Pimpinan Yoon?
Dialogue: 0,0:46:18.94,0:46:22.08,Default,,0,0,0,,Ini adalah jumlah saham\NE yang dimiliki mitra komanditer Un-sung.
Dialogue: 0,0:46:22.11,0:46:23.44,Default,,0,0,0,,Aku sudah menanyakannya hari ini.
Dialogue: 0,0:46:23.47,0:46:25.24,Default,,0,0,0,,"Bukankah rekan komanditermu marah?"
Dialog: 0,0:46:25.26,0:46:27.01,Default,,0,0,0,,"Apakah mereka tidak menginginkan partner umum yang baru?"
Dialog: 0,0:46:27.03,0:46:29.09,Default,,0,0,0,,Dia setuju.
Dialogue: 0,0:46:29.11,0:46:30.22,Default,,0,0,0,,Artinya...
Dialogue: 0,0:46:30.24,0:46:33.14,Default,,0,0,0,,Dia masih belum menemukan\NChairman dana rahasia Hong.
Dialogue: 0,0:46:33.16,0:46:35.05,Default,,0,0,0,,Tahukah anda...
Dialog: 0,0:46:35.08,0:46:36.89,Default,,0,0,0,,dana rahasia di Swiss?
Dialog: 0,0:46:36.91,0:46:39.31,Default,,0,0,0,,Tiga perusahaan\Ndidirikan di Kepulauan Virgin,
Dialog: 0,0:46:39.33,0:46:40.89,Default,,0,0,0,,Moldova, dan Singapura.
Dialog: 0,0:46:40.92,0:46:44.15,Default,,0,0,0,,Dana rahasia di Swiss\Nis dipindahkan ke Singapura.
Dialog: 0,0:46:44.17,0:46:45.86,Default,,0,0,0,,Kemudian Kepulauan Virgin...
Dialog: 0,0:46:45.88,0:46:49.07,Default,,0,0,0,,{\an8}membuat seolah-olah mereka meminjamkan uang ke Moldova,
Dialog: 0,0:46:49.09,0:46:52.75,Default,,0,0,0,,dan Singapura menanggung utang Moldova.
Dialog: 0,0:46:53.18,0:46:55.66,Default,,0,0,0,,Lalu Moldova mengumumkan mereka tidak dapat membayarnya kembali?
Dialog: 0,0:46:55.68,0:46:57.12,Default,,0,0,0,,Benar.
Dialogue: 0,0:46:57.14,0:47:00.00,Default,,0,0,0,,{\an8}Kemudian Kepulauan Virgin mengajukan gugatan default,
Dialog: 0,0:47:00.02,0:47:02.60,Default,,0,0,0,,{\an8}dan pengadilan menuntut Singapura untuk membayarnya kembali.
Dialog: 0,0:47:03.48,0:47:06.50,Default,,0,0,0,,Pengadilan memungkinkan\N untuk memindahkan dana rahasia secara legal.
Dialog: 0,0:47:06.53,0:47:08.92,Default,,0,0,0,,Setelah semuanya selesai,\Nketiga perusahaan ini...
Dialogue: 0,0:47:08.95,0:47:11.63,Default,,0,0,0,,mematikan dan menyulitkan pelacakan dana.
Dialog: 0,0:47:11.66,0:47:13.59,Default,,0,0,0,,Mereka terus mencuci dengan cara ini,
Dialog: 0,0:47:13.62,0:47:18.15,Default,,0,0,0,,dan terakhir, mereka mengirim uang\Nke bank di Labuan, Malaysia.
Dialog: 0,0:47:19.04,0:47:20.10,Default,,0,0,0,,Luar Biasa.
Dialogue: 0,0:47:20.12,0:47:23.90,Default,,0,0,0,,Apakah itu berarti rahasia\Ndana ada di Malaysia saat ini?
Dialog: 0,0:47:23.92,0:47:27.36,Default,,0,0,0,,Saya kira tidak, karena\NEun-sung mengirim seseorang ke Labuan hari ini.
Dialog: 0,0:47:27.38,0:47:30.96,Default,,0,0,0,,Jadi dia juga tidak tahu\Ntujuan akhirnya.
Dialog: 0,0:47:33.97,0:47:36.09,Default,,0,0,0,,Omong-omong,
Dialog: 0,0:47:36.27,0:47:38.51,Default,,0,0,0,,bagaimana kamu tahu ini?
Dialogue: 0,0:47:39.35,0:47:42.54,Default,,0,0,0,,{\i1}Banyak orang yang tidak senang\Ndengan situasi saat ini,{\i0}
Dialog: 0,0:47:42.56,0:47:44.33,Default,,0,0,0,,{\i1}tetapi mereka tidak bisa mengungkapkannya.{\i0}
Dialogue: 0,0:47:44.36,0:47:48.85,Default,,0,0,0,,{\i1}Beberapa dari mereka telah bekerja\Nuntuk Queens selama lebih dari 30 tahun.{\i0}
Dialogue: 0,0:47:48.90,0:47:51.80,Default,,0,0,0,,{\i1}Sekretaris Jang telah menjadi\sekretaris Ketua Hong selama bertahun-tahun,{\i0}
Dialogue: 0,0:47:51.82,0:47:55.23,Default,,0,0,0,,{\i1}tapi dia menolak gaji yang besar dan mengundurkan diri.{\i0}
Dialog: 0,0:47:57.12,0:47:58.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sekretaris Jang.{\c}{\i0}
Dialogue: 0,0:47:59.29,0:48:00.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana kabarmu?{\c}{\i0}
Dialog: 0,0:48:00.79,0:48:02.04,Default,,0,0,0,,{\i1}Mereka bilang...{\i0}
Dialogue: 0,0:48:02.07,0:48:03.89,Default,,0,0,0,,hal-hal ini untuk kita?
Dialogue: 0,0:48:03.92,0:48:08.25,Default,,0,0,0,,Tidak, untuk perusahaan tempat mereka\N mendedikasikan seluruh hidupnya.
Dialog: 0,0:48:08.30,0:48:11.54,Default,,0,0,0,,Mereka tidak ingin melihat\Nperusahaan hancur lagi.
Dialog: 0,0:48:12.93,0:48:14.84,Default,,0,0,0,,Bagaimana denganmu?
Dialog: 0,0:48:15.72,0:48:17.95,Default,,0,0,0,,Mengapa kamu melakukan ini? Untuk perusahaan?
Dialog: 0,0:48:17.97,0:48:20.43,Default,,0,0,0,,Ya, ini untuk perusahaan,
Dialog: 0,0:48:22.73,0:48:26.54,Default,,0,0,0,,karena aku tahu betapa kamu mencintai...
Dialog: 0,0:48:26.57,0:48:28.10,Default,,0,0,0,,perusahaan Anda.
Dialogue: 0,0:48:39.08,0:48:42.14,Default,,0,0,0,,Kami telah mempertimbangkan\Pendapat masing-masing anggota kami.
Dialog: 0,0:48:42.16,0:48:44.56,Default,,0,0,0,,Anda telah melanggar kewajiban kerahasiaan Anda,
Dialog: 0,0:48:44.58,0:48:46.91,Default,,0,0,0,,dan informasi bocor...
Dialog: 0,0:48:51.51,0:48:53.40,Default,,0,0,0,,- Siapa kamu?\N- Benar.
Dialog: 0,0:48:53.43,0:48:56.45,Default,,0,0,0,,Kami di sini untuk membela\Nklien kami, Tuan Baek Hyun-woo.
Dialog: 0,0:48:56.47,0:48:59.74,Default,,0,0,0,,Lihat. Anda tidak berhak\Nikut campur dalam audit internal ini.
Dialog: 0,0:48:59.77,0:49:03.33,Default,,0,0,0,,Menurut Pasal 12, Paragraf 1,\NItem 3 dan Pasal 11, Paragraf 4...
Dialog: 0,0:49:03.35,0:49:06.54,Default,,0,0,0,,Undang-Undang Prosedur Administratif,\Klien kami berhak mempekerjakan...
Dialog: 0,0:49:06.56,0:49:08.68,Default,,0,0,0,,seorang pengacara yang mewakilinya.
Dialog: 0,0:49:11.90,0:49:13.00,Default,,0,0,0,,Ayo lanjutkan.
Dialog: 0,0:49:13.03,0:49:15.57,Default,,0,0,0,,Karena alasan ini,\Nkami memutuskan untuk memecat Anda...
Dialogue: 0,0:49:15.60,0:49:16.90,Default,,0,0,0,,Alasanmu memecatnya...
Dialog: 0,0:49:16.92,0:49:19.76,Default,,0,0,0,,adalah Anda menerima informasi\Ndari eksekutif perusahaan saingan,
Dialog: 0,0:49:19.79,0:49:22.31,Default,,0,0,0,,yang mengklaim bahwa Tuan Baek\N membocorkan informasi VIP kepada mereka,
Dialog: 0,0:49:22.33,0:49:25.60,Default,,0,0,0,,dan Anda mengonfirmasi bahwa dia mendapatkannya\Ndengan menggunakan ID perusahaannya.
Dialogue: 0,0:49:25.62,0:49:28.13,Default,,0,0,0,,- Ya, dan?\N- Kapan Anda menerima informasi itu?
Dialog: 0,0:49:28.15,0:49:29.19,Default,,0,0,0,,Pada 6 Agustus.
Dialog: 0,0:49:29.21,0:49:31.02,Default,,0,0,0,,Kapan Pak Baek mengekstrak daftar VIP?
Dialog: 0,0:49:31.05,0:49:32.19,Default,,0,0,0,,1 dan 2 Agustus.
Dialog: 0,0:49:32.21,0:49:33.78,Default,,0,0,0,,- Dua kesempatan berbeda.\N- Aneh sekali.
Dialog: 0,0:49:33.80,0:49:37.24,Default,,0,0,0,,ID intranetnya telah dihapus pada 28 Juli.
Dialog: 0,0:49:37.26,0:49:38.32,Default,,0,0,0,,Benar.
Dialogue: 0,0:49:38.35,0:49:41.12,Default,,0,0,0,,{\an8}{\i1}Saya mengembalikan KTP, kartu perusahaan, laptop,{\i0}
Dialog: 0,0:49:41.14,0:49:42.83,Default,,0,0,0,,{\an8}dan yang lainnya pada hari itu.
Dialogue: 0,0:49:42.85,0:49:45.87,Default,,0,0,0,,Mungkin itu bukan ID Anda.\NAnda bisa saja menggunakan ID orang lain.
Dialog: 0,0:49:45.89,0:49:47.00,Default,,0,0,0,,Seperti siapa?
Dialog: 0,0:49:47.02,0:49:49.12,Default,,0,0,0,,Mungkin salah satu anggota timnya.
Dialog: 0,0:49:49.15,0:49:54.38,Default,,0,0,0,,Itu berarti karyawan tetap mempunyai akses\Nke daftar VIP Queens Department Store.
Dialog: 0,0:49:54.40,0:49:55.88,Default,,0,0,0,,- Bukankah itu masalah?\N- Benar.
Dialogue: 0,0:49:55.90,0:49:59.05,Default,,0,0,0,,Perlu ada bukti bahwa\Ninformasi tertentu dibatasi...
Dialog: 0,0:49:59.07,0:50:00.68,Default,,0,0,0,,agar dianggap rahasia.
Dialog: 0,0:50:00.70,0:50:03.81,Default,,0,0,0,,Jika ada yang bisa mendapatkan akses\Ndan mengunduh materi,
Dialog: 0,0:50:03.83,0:50:06.06,Default,,0,0,0,,itu hanya menunjukkan bahwa toko...
Dialog: 0,0:50:06.08,0:50:08.64,Default,,0,0,0,,tidak merahasiakan daftar VIP.
Dialog: 0,0:50:08.67,0:50:13.19,Default,,0,0,0,,Masalah sebenarnya adalah penggelapan,\Ndan dia menandatangani semua dokumen terkait.
Dialog: 0,0:50:13.21,0:50:16.30,Default,,0,0,0,,Kami meminta otentikasi ke\Npemeriksa dokumen yang dulu...
Dialog: 0,0:50:16.32,0:50:20.11,Default,,0,0,0,,mantan Kepala Dokumen di\NNFS mengenai 27 tanda tangan itu.
Dialog: 0,0:50:20.14,0:50:22.41,Default,,0,0,0,,Ukuran dan detail tanda tangan...
Dialog: 0,0:50:22.43,0:50:24.99,Default,,0,0,0,,terbukti sama persis.
Dialog: 0,0:50:25.02,0:50:28.64,Default,,0,0,0,,Ini hanya mungkin jika\Ntanda tangannya diduplikasi.
Dialogue: 0,0:50:28.73,0:50:33.08,Default,,0,0,0,,Kami tidak dapat mempercayai hasil ini,\Nkarena Anda memintanya.
Dialog: 0,0:50:33.11,0:50:35.42,Default,,0,0,0,,Kalau begitu mari kita minta jaksa untuk menilainya.
Dialogue: 0,0:50:35.44,0:50:38.01,Default,,0,0,0,,Sebagai informasi,\Ntidak ada denda untuk pemalsuan dokumen.
Dialogue: 0,0:50:38.03,0:50:41.28,Default,,0,0,0,,Hanya pidana penjara paling lama tiga tahun.
Dialog: 0,0:50:44.08,0:50:45.26,Default,,0,0,0,,Kami harap...
Dialog: 0,0:50:45.29,0:50:48.41,Default,,0,0,0,,kamu akan membuat...
Dialog: 0,0:50:48.67,0:50:50.58,Default,,0,0,0,,keputusan yang bijak.
Dialog: 0,0:51:49.43,0:51:51.55,Default,,0,0,0,,- {\i1}Ini saya.{\i0}\N- Halo, Pak.
Dialog: 0,0:51:53.94,0:51:55.72,Default,,0,0,0,,Singkirkan...
Dialog: 0,0:51:55.94,0:51:57.64,Default,,0,0,0,,dari Baek Hyun-woo.
Dialogue: 0,0:51:58.53,0:52:00.34,Default,,0,0,0,,Dia mengganggu kita berdua.
Dialogue: 0,0:52:00.36,0:52:02.31,Default,,0,0,0,,Boracay, ya?
Dialog: 0,0:52:02.45,0:52:03.47,Default,,0,0,0,,Aku akan mengirimmu ke sana,
Dialogue: 0,0:52:03.49,0:52:05.16,Default,,0,0,0,,{\i1}dan membayarmu dengan mahal.{\i0}
Dialog: 0,0:52:05.18,0:52:06.22,Default,,0,0,0,,Ketua Yoon.
Dialogue: 0,0:52:06.24,0:52:09.51,Default,,0,0,0,,Terakhir kali terjadi gangguan,\Nkarena saya sedikit ceroboh.
Dialogue: 0,0:52:09.54,0:52:12.62,Default,,0,0,0,,{\i1}Saya akan mengurusnya dengan baik kali ini.{\i0}
Dialogue: 0,0:52:25.35,0:52:28.49,Default,,0,0,0,,Semakin banyak pengacara, semakin baik.\NISenang sekali Anda memiliki kami.
Dialog: 0,0:52:28.52,0:52:34.12,Default,,0,0,0,,Meskipun memiliki spesialisasi yang berbeda,\Nkami berkumpul untuk membantu seorang teman.
Dialogue: 0,0:52:34.15,0:52:35.62,Default,,0,0,0,,Kami seperti Avengers.
Dialog: 0,0:52:35.65,0:52:39.21,Default,,0,0,0,,Maaf, tapi saya juga di sini\Nkarena orang-orang terus bertanya...
Dialog: 0,0:52:39.23,0:52:41.84,Default,,0,0,0,,jika kamu kembali bersama mantanmu.
Dialog: 0,0:52:41.86,0:52:43.52,Default,,0,0,0,,Apakah kamu?
Dialogue: 0,0:52:49.83,0:52:51.31,Default,,0,0,0,,Itu bukan urusanmu.
Dialogue: 0,0:52:51.33,0:52:53.35,Default,,0,0,0,,Anda mengambil jurusan hukum komersial.
Dialogue: 0,0:52:53.37,0:52:57.60,Default,,0,0,0,,Dia benar. Anda unggul dalam\NBills of Exchange Act dan Check Act.
Dialog: 0,0:52:57.63,0:53:00.02,Default,,0,0,0,,Itu masa lalu. Saya menangani segala macam kasus sekarang.
Dialog: 0,0:53:00.05,0:53:02.44,Default,,0,0,0,,Lihat ini,
Dialog: 0,0:53:02.47,0:53:04.44,Default,,0,0,0,,dan lacak uangnya.
Dialog: 0,0:53:04.47,0:53:05.59,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}WSB Swiss Bank{\c}{\i0}
Dialog: 0,0:53:07.01,0:53:09.46,Default,,0,0,0,,Dari mana kamu mendapatkan ini?
Dialog: 0,0:53:13.44,0:53:14.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Halo.{\c}{\i0}
Dialogue: 0,0:53:15.23,0:53:16.54,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ambil ini.{\c}{\i0}
Dialogue: 0,0:53:16.56,0:53:18.88,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Aku akan membuang ini saat aku keluar.\N- Terima kasih.{\c}{\i0}
Dialogue: 0,0:53:18.90,0:53:20.20,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Lantai basement kedua?\N- Ya.{\c}{\i0}
Dialog: 0,0:53:20.23,0:53:21.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sekretaris Na, halo.{\c}{\i0}
Dialog: 0,0:53:21.99,0:53:23.52,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Halo.{\c}{\i0}
Dialog: 0,0:53:24.91,0:53:26.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Punya satu.{\c}{\i0}
Dialog: 0,0:53:26.41,0:53:27.94,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Terima kasih.{\c}{\i0}
Dialog: 0,0:53:49.96,0:53:52.27,Default,,0,0,0,,{\i1}Eun-sung sedang mencari\Ndana rahasia ketua...{\i0}
Dialog: 0,0:53:52.30,0:53:54.04,Default,,0,0,0,,jadi dia bisa membeli lebih banyak saham.
Dialogue: 0,0:53:54.06,0:53:55.75,Default,,0,0,0,,Dana rahasia? Berapa harganya?
Dialog: 0,0:53:55.77,0:53:57.60,Default,,0,0,0,,$900 juta.
Dialogue: 0,0:54:02.57,0:54:04.10,Default,,0,0,0,,Aku pergi...
Dialog: 0,0:54:05.03,0:54:06.94,Default,,0,0,0,,cari dulu.
Dialog: 0,0:54:07.28,0:54:10.18,Default,,0,0,0,,Bu, hati-hati dengan sinar UV.
Dialogue: 0,0:54:10.20,0:54:11.47,Default,,0,0,0,,Kenapa kamu terus datang?
Dialogue: 0,0:54:11.49,0:54:13.47,Default,,0,0,0,,Bukankah kamu memihak Beom-ja?
Dialog: 0,0:54:13.50,0:54:14.47,Default,,0,0,0,,Maaf?
Dialogue: 0,0:54:14.50,0:54:16.64,Default,,0,0,0,,Astaga, kamu salah sangka.
Dialog: 0,0:54:16.67,0:54:18.18,Default,,0,0,0,,Waktu itu,
Dialog: 0,0:54:18.21,0:54:20.31,Default,,0,0,0,,Aku merasa tidak enak karena dia memohon padaku...
Dialog: 0,0:54:20.34,0:54:23.40,Default,,0,0,0,,untuk membantunya melihat ayahnya sekali saja.
Dialogue: 0,0:54:23.42,0:54:25.02,Default,,0,0,0,,Kadang-kadang aku sangat lembut.
Dialog: 0,0:54:25.05,0:54:26.82,Default,,0,0,0,,Baik. Berpihaklah pada siapa pun yang Anda kasihani.
Dialogue: 0,0:54:26.84,0:54:29.40,Default,,0,0,0,,Astaga, Mbak Moh!
Dialog: 0,0:54:29.43,0:54:30.95,Default,,0,0,0,,Kamu kenal aku.
Dialog: 0,0:54:30.97,0:54:33.99,Default,,0,0,0,,Saya hanya berpihak pada uang dan kekuasaan.
Dialogue: 0,0:54:34.02,0:54:38.09,Default,,0,0,0,,Bagaimanapun, kaulah ratunya saat ini.
Dialogue: 0,0:54:38.52,0:54:42.00,Default,,0,0,0,,Saya tidak perlu menjadi\NCEO atau semacamnya.
Dialogue: 0,0:54:42.02,0:54:44.63,Default,,0,0,0,,Aku hanya akan tetap bersamamu...
Dialogue: 0,0:54:44.65,0:54:45.96,Default,,0,0,0,,seperti pembantumu.
Dialogue: 0,0:54:45.99,0:54:48.35,Default,,0,0,0,,Pembantu, kakiku.
Dialog: 0,0:54:48.91,0:54:49.88,Default,,0,0,0,,Kalau begitu, mari kita lihat.
Dialog: 0,0:54:49.91,0:54:51.22,Default,,0,0,0,,Tentu saja.
Dialog: 0,0:54:51.24,0:54:56.28,Default,,0,0,0,,Saya, Rahmat yang luar biasa, akan melayani Anda dengan luar biasa.
Dialog: 0,0:55:02.54,0:55:04.73,Default,,0,0,0,,Pak, apakah Anda ingat ruangan ini?
Dialog: 0,0:55:04.75,0:55:06.90,Default,,0,0,0,,Mereka bilang berada di lingkungan yang familiar...
Dialog: 0,0:55:06.92,0:55:08.92,Default,,0,0,0,,akan membantumu pulih, jadi aku membawamu ke sini.
Dialogue: 0,0:55:08.95,0:55:10.99,Default,,0,0,0,,Tidak mudah menjadi seorang caregiver.
Dialog: 0,0:55:11.01,0:55:13.28,Default,,0,0,0,,Biarkan aku memijatmu nanti.
Dialogue: 0,0:55:13.30,0:55:15.20,Default,,0,0,0,,Bagaimana kalau minyak kemenyan?
Dialog: 0,0:55:15.22,0:55:16.76,Default,,0,0,0,,Tentu.
Dialog: 0,0:55:40.12,0:55:41.68,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:55:41.71,0:55:44.79,Default,,0,0,0,,Kamu bisa pergi dan biarkan dia istirahat.
Dialogue: 0,0:55:59.64,0:56:01.12,Default,,0,0,0,,Jadi?
Dialogue: 0,0:56:01.14,0:56:02.71,Default,,0,0,0,,Apakah itu membawa kembali kenangan?
Dialog: 0,0:56:02.73,0:56:04.50,Default,,0,0,0,,Katakan padaku. Dimana uangku?
Dialogue: 0,0:56:04.52,0:56:08.35,Default,,0,0,0,,Di mana dana rahasia yang kamu\Nsimpan atas namaku?
Dialog: 0,0:56:35.26,0:56:37.96,Default,,0,0,0,,Terus awasi dia, apa pun yang terjadi.
Dialogue: 0,0:56:38.14,0:56:40.88,Default,,0,0,0,,Siapa yang tahu apa lagi yang akan dia lakukan padanya?
Dialog: 0,0:56:44.98,0:56:46.51,Default,,0,0,0,,Saya menutup telepon.
Dialog: 0,0:57:07.34,0:57:08.31,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:57:08.34,0:57:11.54,Default,,0,0,0,,Astaga, dia memperlihatkan\Nbanyak kulit di siang hari bolong.
Dialog: 0,0:57:26.98,0:57:28.46,Default,,0,0,0,,Apa itu?
Dialog: 0,0:57:28.48,0:57:30.14,Default,,0,0,0,,"Periksa saya."
Dialog: 0,0:57:30.32,0:57:32.17,Default,,0,0,0,,"Saya tampan."
Dialogue: 0,0:57:32.19,0:57:33.88,Default,,0,0,0,,"Tubuhku juga bagus."
Dialogue: 0,0:57:33.90,0:57:35.44,Default,,0,0,0,,Benarkah?
Dialog: 0,0:57:36.03,0:57:37.73,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:58:03.43,0:58:05.09,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:58:06.27,0:58:07.66,Default,,0,0,0,,Saya...
Dialog: 0,0:58:07.69,0:58:09.22,Default,,0,0,0,,Yah...
Dialog: 0,0:58:10.52,0:58:12.96,Default,,0,0,0,,Saya yakin Anda sedang mengintip.
Dialog: 0,0:58:12.98,0:58:15.75,Default,,0,0,0,,Tidak, saya tidak melakukannya. aku baru saja lewat...
Dialog: 0,0:58:15.78,0:58:18.27,Default,,0,0,0,,saat aku melihatmu di sana.
Dialogue: 0,0:58:22.12,0:58:23.69,Default,,0,0,0,,Apakah kamu mau?
Dialogue: 0,0:58:25.29,0:58:26.81,Default,,0,0,0,,- Apa itu?\N- Mulberry.
Dialog: 0,0:58:26.83,0:58:28.82,Default,,0,0,0,,Seperti di...
Dialogue: 0,0:58:30.42,0:58:32.31,Default,,0,0,0,,- beri?\N- Ya, kamu benar.
Dialogue: 0,0:58:32.34,0:58:34.79,Default,,0,0,0,,Itu bagus untuk wanita.
Dialogue: 0,0:58:37.84,0:58:39.61,Default,,0,0,0,,- Berapa harganya?\N- Tidak untuk dijual.
Dialog: 0,0:58:39.64,0:58:40.70,Default,,0,0,0,,Gratis.
Dialog: 0,0:58:40.72,0:58:42.38,Default,,0,0,0,,Kenapa kamu...?
Dialog: 0,0:58:44.68,0:58:47.34,Default,,0,0,0,,Asli sekali. Aku akan memberimu itu.
Dialog: 0,0:58:47.52,0:58:49.16,Default,,0,0,0,,Apa?
Dialogue: 0,0:58:49.19,0:58:53.21,Default,,0,0,0,,Kamu orang pertama yang membuat\Na bergerak menggunakan murbei,
Dialog: 0,0:58:53.23,0:58:55.29,Default,,0,0,0,,tapi biar jelas.
Dialog: 0,0:58:55.32,0:58:56.46,Default,,0,0,0,,Menerima ini...
Dialogue: 0,0:58:56.49,0:58:59.15,Default,,0,0,0,,bukan berarti aku menerima cintamu.
Dialog: 0,0:59:01.70,0:59:04.93,Default,,0,0,0,,- Apa MBTI-mu?\N- Apa?
Dialogue: 0,0:59:04.95,0:59:07.43,Default,,0,0,0,,Menurutku kamu seorang ISTJ.
Dialog: 0,0:59:07.46,0:59:09.89,Default,,0,0,0,,- Aku... Apa?\N- Kamu tidak bisa mengekspresikan emosi dengan baik.
Dialog: 0,0:59:09.92,0:59:14.31,Default,,0,0,0,,Kamu perfeksionis dengan ingatan yang baik.\NKamu terlihat dingin, namun sebenarnya kamu lembut.
Dialog: 0,0:59:14.34,0:59:18.25,Default,,0,0,0,,Baik Robert De Niro dan\NNatalie Portman adalah tipe ini.
Dialog: 0,0:59:20.93,0:59:22.75,Default,,0,0,0,,Apa yang dia katakan?
Dialog: 0,0:59:23.97,0:59:25.62,Default,,0,0,0,,Kenapa kamu di rumah?
Dialogue: 0,0:59:25.64,0:59:27.66,Default,,0,0,0,,Bukankah seharusnya kamu bekerja seperti yang lain?
Dialog: 0,0:59:27.68,0:59:29.39,Default,,0,0,0,,Saya tidak bekerja...
Dialog: 0,0:59:30.02,0:59:31.46,Default,,0,0,0,,sebanyak itu.
Dialog: 0,0:59:31.48,0:59:32.50,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:59:32.52,0:59:35.10,Default,,0,0,0,,Karena hidup ini terlalu singkat.
Dialogue: 0,0:59:35.19,0:59:38.06,Default,,0,0,0,,Saya hanya bekerja cukup untuk bisa mandiri.
Dialog: 0,0:59:45.79,0:59:48.45,Default,,0,0,0,,Jadi apa? Dia seorang petani mandiri?
Dialogue: 0,0:59:58.67,1:00:00.61,Default,,0,0,0,,Apakah dia menyimpan ini untukku?
Dialog: 0,1:00:00.63,1:00:02.33,Default,,0,0,0,,Astaga.
Dialog: 0,1:00:03.97,1:00:06.26,Default,,0,0,0,,Natalie Portman?
Dialog: 0,1:00:25.83,1:00:27.72,Default,,0,0,0,,Ya ampun!
Dialogue: 0,1:00:27.74,1:00:29.72,Default,,0,0,0,,Itu banyak!
Dialogue: 0,1:00:29.75,1:00:32.18,Default,,0,0,0,,Mereka dari Yeong-song.
Dialog: 0,1:00:32.21,1:00:33.98,Default,,0,0,0,,Dia memetik beberapa buah murbei.
Dialog: 0,1:00:34.00,1:00:35.44,Default,,0,0,0,,Dia bilang dia punya lebih banyak.
Dialogue: 0,1:00:35.46,1:00:37.10,Default,,0,0,0,,Dia memilih terlalu banyak,
Dialog: 0,1:00:37.13,1:00:39.62,Default,,0,0,0,,jadi dia membagikannya.
Dialog: 0,1:00:40.84,1:00:41.98,Default,,0,0,0,,Dia konyol.
Dialogue: 0,1:00:42.01,1:00:43.69,Default,,0,0,0,,Dia bisa saja menjual kelebihannya.
Dialogue: 0,1:00:43.72,1:00:46.36,Default,,0,0,0,,Dia selalu menyisihkan secukupnya untuk keluarganya,
Dialog: 0,1:00:46.39,1:00:48.32,Default,,0,0,0,,dan memberikan sisanya.
Dialog: 0,1:00:48.35,1:00:51.34,Default,,0,0,0,,Apa yang akan kita lakukan dengan semua ini?
Dialogue: 0,1:01:21.34,1:01:24.82,Default,,0,0,0,,Seseorang pernah bilang padaku bahwa\Nbijaksana makan daging saat keadaan sulit.
Dialog: 0,1:01:24.84,1:01:27.86,Default,,0,0,0,,Ya, kamu benar.
Dialogue: 0,1:01:27.89,1:01:31.95,Default,,0,0,0,,Tekad saja tidak bisa\Nmemperkuat tekadmu.
Dialogue: 0,1:01:31.97,1:01:33.99,Default,,0,0,0,,Kesehatanmu juga penting.
Dialog: 0,1:01:34.02,1:01:36.29,Default,,0,0,0,,- Usap tanganmu.\N- Oke.
Dialogue: 0,1:01:36.31,1:01:40.46,Default,,0,0,0,,Pikirkan juga tentang apa yang kamu makan\Non semua acara spesialmu.
Dialogue: 0,1:01:40.48,1:01:41.92,Default,,0,0,0,,Itu daging.
Dialog: 0,1:01:41.94,1:01:44.61,Default,,0,0,0,,Benar? Ulang tahun, wisuda,\Nhari Anda mendapat pekerjaan baru,
Dialog: 0,1:01:44.64,1:01:45.63,Default,,0,0,0,,dan lihat.
Dialogue: 0,1:01:45.66,1:01:49.05,Default,,0,0,0,,Kami juga merayakan kepulangannya sambil makan daging.
Dialog: 0,1:01:49.08,1:01:51.80,Default,,0,0,0,,Kami selalu menyajikan makanan Cina di hari ulang tahunku.
Dialogue: 0,1:01:51.83,1:01:54.95,Default,,0,0,0,,Apa itu daging babi asam manis?\NBagaimana dengan ayam cabai?
Dialogue: 0,1:01:56.37,1:01:58.41,Default,,0,0,0,,- Biarkan aku memanggangnya.\N- Kamu?
Dialog: 0,1:01:58.54,1:02:00.77,Default,,0,0,0,,Kamu hanya makan daging...
Dialog: 0,1:02:00.80,1:02:02.36,Default,,0,0,0,,itu disajikan di piring Anda.
Dialog: 0,1:02:02.38,1:02:05.07,Default,,0,0,0,,Saya akan memanggang daging keluarga saya mulai sekarang.
Dialog: 0,1:02:05.09,1:02:06.94,Default,,0,0,0,,Letakkan penjepitmu.
Dialog: 0,1:02:06.97,1:02:08.84,Default,,0,0,0,,- Izinkan saya.\N- Ya, Pak.
Dialogue: 0,1:02:15.48,1:02:16.66,Default,,0,0,0,,Hae-in, aku ingat...
Dialogue: 0,1:02:16.69,1:02:19.71,Default,,0,0,0,,kata dokter, WBC-mu adalah yang paling penting.
Dialogue: 0,1:02:19.73,1:02:21.75,Default,,0,0,0,,Dia bilang kamu harus mencapai...
Dialog: 0,1:02:21.77,1:02:25.10,Default,,0,0,0,,tingkat tertentu untuk menerima perawatan di Jerman.
Dialog: 0,1:02:25.40,1:02:26.46,Default,,0,0,0,,Benar.
Dialog: 0,1:02:26.49,1:02:27.97,Default,,0,0,0,,WBC saya harus...
Dialog: 0,1:02:27.99,1:02:31.89,Default,,0,0,0,,antara 4000 dan 10.000 sel per mikroliter.
Dialogue: 0,1:02:31.91,1:02:34.01,Default,,0,0,0,,Berapa tinggi di Jerman?
Dialog: 0,1:02:34.04,1:02:35.95,Default,,0,0,0,,Itu 1500 sel/µL.
Dialogue: 0,1:02:37.04,1:02:38.02,Default,,0,0,0,,Rendah sekali.
Dialogue: 0,1:02:38.04,1:02:40.64,Default,,0,0,0,,Tapi akhir-akhir ini naik banyak.
Dialog: 0,1:02:40.67,1:02:43.04,Default,,0,0,0,,Sekarang sekitar 3000.
Dialogue: 0,1:02:43.59,1:02:45.11,Default,,0,0,0,,Jumlahnya dua kali lipat.
Dialog: 0,1:02:45.13,1:02:46.82,Default,,0,0,0,,Aku bangga padamu.
Dialogue: 0,1:02:46.84,1:02:49.07,Default,,0,0,0,,Yah... Ini bukan masalah besar.
Dialog: 0,1:02:49.09,1:02:52.61,Default,,0,0,0,,- Saya masih memiliki lebih dari 1000 lagi.\N- Anda hampir sampai.
Dialog: 0,1:02:52.64,1:02:54.41,Default,,0,0,0,,Berusaha lebih keras.
Dialogue: 0,1:02:54.43,1:02:57.95,Default,,0,0,0,,Hei, ini tidak seperti belajar.\NI tidak bisa hanya "berusaha lebih keras".
Dialog: 0,1:02:57.98,1:03:01.04,Default,,0,0,0,,Kalau begitu, apa yang harus\NAnda lakukan? Dapatkan suntikan dan?
Dialog: 0,1:03:01.06,1:03:02.58,Default,,0,0,0,,Saya memeriksanya.
Dialog: 0,1:03:02.61,1:03:06.46,Default,,0,0,0,,Ini semua tentang stamina dan kekebalannya.
Dialogue: 0,1:03:06.49,1:03:09.76,Default,,0,0,0,,Dia perlu makan dengan baik dan mengonsumsi\Na banyak vitamin dan protein.
Dialogue: 0,1:03:09.78,1:03:11.13,Default,,0,0,0,,Dia butuh istirahat yang cukup juga.
Dialog: 0,1:03:11.16,1:03:14.33,Default,,0,0,0,,Kalau begitu dia perlu makan banyak daging...
Dialog: 0,1:03:14.35,1:03:15.35,Default,,0,0,0,,dan kacang.
Dialog: 0,1:03:15.37,1:03:18.03,Default,,0,0,0,,Saya akan merencanakan dietnya.
Dialog: 0,1:03:24.46,1:03:25.77,Default,,0,0,0,,- Beom-jun.\N- Ya?
Dialog: 0,1:03:25.80,1:03:27.50,Default,,0,0,0,,Balikkan.
Dialog: 0,1:03:27.72,1:03:29.83,Default,,0,0,0,,Benar.
Dialog: 0,1:03:31.05,1:03:32.03,Default,,0,0,0,,Tidak.
Dialogue: 0,1:03:32.05,1:03:33.78,Default,,0,0,0,,Mereka terbakar. Apa yang harus saya lakukan?
Dialog: 0,1:03:33.81,1:03:35.80,Default,,0,0,0,,Kita bisa memotongnya saja.
Dialog: 0,1:03:36.02,1:03:38.20,Default,,0,0,0,,- Bisakah Anda memberi saya guntingnya?\N- Tidak.
Dialogue: 0,1:03:38.23,1:03:39.80,Default,,0,0,0,,Aku akan melakukannya.
Dialog: 0,1:03:40.44,1:03:42.75,Default,,0,0,0,,Jadi dia butuh daging dan kacang-kacangan.
Dialog: 0,1:03:42.77,1:03:43.87,Default,,0,0,0,,Apa lagi?
Dialogue: 0,1:03:43.90,1:03:46.96,Default,,0,0,0,,Pisang dan kacang-kacangan...
Dialog: 0,1:03:46.98,1:03:49.51,Default,,0,0,0,,- Ini bagus.\N- Astaga.
Dialog: 0,1:03:49.53,1:03:51.81,Default,,0,0,0,,Ini enak.
Dialog: 0,1:03:52.03,1:03:53.73,Default,,0,0,0,,Bagus sekali.
Dialog: 0,1:03:53.83,1:03:56.11,Default,,0,0,0,,- Lihat.\N- Dia bersemangat.
Dialog: 0,1:03:57.87,1:03:59.78,Default,,0,0,0,,Ya ampun.
Dialog: 0,1:04:00.96,1:04:02.78,Default,,0,0,0,,Anda perlu membalik ini.
Dialog: 0,1:04:03.75,1:04:05.54,Default,,0,0,0,,Lihat ini.
Dialog: 0,1:04:06.67,1:04:08.36,Default,,0,0,0,,Dia membutuhkan banyak protein.
Dialog: 0,1:04:08.38,1:04:10.42,Default,,0,0,0,,Dia melakukannya.
Dialog: 0,1:04:14.22,1:04:16.28,Default,,0,0,0,,Makan sambil melakukannya.
Dialog: 0,1:04:16.31,1:04:19.13,Default,,0,0,0,,Hapus untuknya.
Dialog: 0,1:04:28.99,1:04:30.52,Default,,0,0,0,,Masuk.
Dialog: 0,1:04:35.28,1:04:37.78,Default,,0,0,0,,Ini tidak berfungsi lagi.
Dialog: 0,1:04:39.45,1:04:41.41,Default,,0,0,0,,Bukan?
Dialog: 0,1:04:45.29,1:04:47.27,Default,,0,0,0,,Anda hanya perlu menekan bagian ini.
Dialog: 0,1:04:47.30,1:04:50.75,Default,,0,0,0,,Aku tidak sebaik kamu.
Dialog: 0,1:04:51.76,1:04:53.82,Default,,0,0,0,,Haruskah saya membeli yang baru?
Dialog: 0,1:04:53.84,1:04:54.90,Default,,0,0,0,,Mengapa?
Dialog: 0,1:04:54.93,1:04:56.28,Default,,0,0,0,,Karena kamu kesulitan menggunakannya.
Dialog: 0,1:04:56.30,1:04:59.54,Default,,0,0,0,,Kalau begitu kamu bisa melakukannya untukku.\NLihat betapa hebatnya kamu.
Dialogue: 0,1:05:02.35,1:05:03.83,Default,,0,0,0,,menurutku...
Dialog: 0,1:05:03.85,1:05:05.51,Default,,0,0,0,,Saya menjadi lebih baik...
Dialog: 0,1:05:06.98,1:05:09.10,Default,,0,0,0,,semakin aku mengeringkan rambutmu.
Dialog: 0,1:05:11.74,1:05:12.71,Default,,0,0,0,,Kamu benar.
Dialogue: 0,1:05:12.74,1:05:15.06,Default,,0,0,0,,Kamu melakukan pekerjaan yang bagus pada rambut ikalnya.
Dialogue: 0,1:05:17.33,1:05:20.55,Default,,0,0,0,,Sekarang kamu sudah lebih baik,\Nterus keringkan rambutku untukku.
Dialog: 0,1:05:20.58,1:05:22.21,Default,,0,0,0,,Tentu. Itu bukan masalah.
Dialog: 0,1:05:22.23,1:05:23.22,Default,,0,0,0,,Apa lagi?
Dialog: 0,1:05:23.25,1:05:27.70,Default,,0,0,0,,Beri tahu saya apa lagi yang ingin\Nsaya lakukan, dan saya akan melakukannya.
Dialog: 0,1:05:29.09,1:05:30.69,Default,,0,0,0,,Saya senang,
Dialog: 0,1:05:30.71,1:05:34.58,Default,,0,0,0,,selama kamu mengeringkan rambutku\Ndengan pengering rambut yang rusak.
Dialogue: 0,1:05:36.14,1:05:37.78,Default,,0,0,0,,Jadi hanya ini saja?
Dialog: 0,1:05:37.80,1:05:39.45,Default,,0,0,0,,Ini bantuan besar.
Dialogue: 0,1:05:39.47,1:05:42.24,Default,,0,0,0,,Kamu harus bersamaku setiap hari.
Dialogue: 0,1:05:42.27,1:05:43.66,Default,,0,0,0,,Menurutku tidak...
Dialog: 0,1:05:43.68,1:05:46.72,Default,,0,0,0,,Saya seharusnya serakah untuk saat ini.
Dialog: 0,1:05:48.31,1:05:50.90,Default,,0,0,0,,Tidak, serakah.
Dialog: 0,1:05:50.93,1:05:51.96,Default,,0,0,0,,Anda bisa.
Dialogue: 0,1:05:51.98,1:05:54.34,Default,,0,0,0,,Jangan berusaha terlalu keras untuk memperlakukanku dengan baik.
Dialogue: 0,1:05:54.36,1:05:58.13,Default,,0,0,0,,Aku tidak menyatakan cintaku padamu\Nagar kamu memperlakukanku lebih baik.
Dialog: 0,1:05:58.16,1:05:59.69,Default,,0,0,0,,Saya hanya...
Dialog: 0,1:06:00.20,1:06:01.76,Default,,0,0,0,,mengungkapkan perasaanku.
Dialog: 0,1:06:01.79,1:06:03.49,Default,,0,0,0,,Hal yang sama berlaku untuk saya.
Dialog: 0,1:06:05.29,1:06:06.91,Default,,0,0,0,,Hatiku menginginkannya.
Dialog: 0,1:06:08.21,1:06:10.08,Default,,0,0,0,,Saya ingin berbuat lebih baik,
Dialog: 0,1:06:10.46,1:06:12.45,Default,,0,0,0,,kalau bisa.
Dialog: 0,1:06:13.21,1:06:14.96,Default,,0,0,0,,Itulah yang saya rasakan.
Dialog: 0,1:06:21.39,1:06:23.09,Default,,0,0,0,,Kemarin...
Dialog: 0,1:06:23.14,1:06:25.97,Default,,0,0,0,,Saya tidak bisa mengenali wajah Soo-cheol...
Dialog: 0,1:06:26.52,1:06:29.64,Default,,0,0,0,,selama beberapa detik.
Dialog: 0,1:06:30.06,1:06:33.52,Default,,0,0,0,,Saya juga tidak dapat mengingat nama dokter saya.
Dialog: 0,1:06:33.78,1:06:36.30,Default,,0,0,0,,Saya juga tersesat ke kamar rumah sakit...
Dialog: 0,1:06:36.32,1:06:39.27,Default,,0,0,0,,sebentar, dan hanya diam.
Dialog: 0,1:06:40.78,1:06:43.80,Default,,0,0,0,,Saat dokterku pertama kali memberitahuku tentang penyakitku,
Dialog: 0,1:06:43.83,1:06:45.60,Default,,0,0,0,,dia menyebutkan kehilangan memori,
Dialog: 0,1:06:45.62,1:06:48.60,Default,,0,0,0,,kehilangan sensorik, dan gangguan bicara,
Dialog: 0,1:06:48.62,1:06:50.87,Default,,0,0,0,,tapi aku tidak percaya padanya.
Dialog: 0,1:06:51.63,1:06:53.95,Default,,0,0,0,,Saya pikir itu hanya terjadi pada orang lain.
Dialog: 0,1:06:54.21,1:06:56.37,Default,,0,0,0,,Saya pikir saya berbeda,
Dialog: 0,1:06:57.05,1:07:01.49,Default,,0,0,0,,tapi itu terjadi dalam urutan yang persis seperti itu.
Dialogue: 0,1:07:01.51,1:07:06.01,Default,,0,0,0,,Saya memperkirakan gejala berikutnya,\Ndan itu menakutkan.
Dialog: 0,1:07:06.35,1:07:07.95,Default,,0,0,0,,Aku tidak menginginkanmu...
Dialog: 0,1:07:07.98,1:07:10.76,Default,,0,0,0,,berada di sampingku saat itu terjadi.
Dialog: 0,1:07:14.69,1:07:16.21,Default,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:07:16.24,1:07:18.81,Default,,0,0,0,,Mari berbahagia dengan keadaan kita saat ini,
Dialog: 0,1:07:20.07,1:07:21.72,Default,,0,0,0,,dan ketika penyakitku memburuk,
Dialog: 0,1:07:21.74,1:07:23.86,Default,,0,0,0,,Aku menginginkanmu...
Dialog: 0,1:07:24.37,1:07:26.61,Default,,0,0,0,,tinggalkan aku.
Dialog: 0,1:07:29.50,1:07:31.24,Default,,0,0,0,,Itu keinginanku.
Dialog: 0,1:07:50.52,1:07:52.29,Default,,0,0,0,,Apa? Kapan dia meninggalkan permainan?
Dialog: 0,1:07:52.31,1:07:53.46,Default,,0,0,0,,Apakah terjadi sesuatu?
Dialog: 0,1:07:53.48,1:07:54.46,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Anggota Dinonaktifkan{\c}{\i0}
Dialogue: 0,1:07:55.19,1:07:56.73,Default,,0,0,0,,Sialan.
Dialog: 0,1:08:18.30,1:08:19.83,Default,,0,0,0,,Minumlah.
Dialogue: 0,1:08:27.68,1:08:29.51,Default,,0,0,0,,Pahitkah itu?
Dialog: 0,1:08:33.27,1:08:36.26,Default,,0,0,0,,- Tidak sebanyak hidupku.\N- Sayang.
Dialogue: 0,1:08:40.57,1:08:42.42,Default,,0,0,0,,Master, tolong bicara santai padaku.
Dialog: 0,1:08:42.45,1:08:44.15,Default,,0,0,0,,"Master"?
Dialog: 0,1:08:47.37,1:08:49.68,Default,,0,0,0,,Tolong ajari aku cara bertinju.
Dialog: 0,1:08:49.70,1:08:52.14,Default,,0,0,0,,Saya tidak bisa mendaratkan satu pukulan pun...
Dialog: 0,1:08:52.16,1:08:56.58,Default,,0,0,0,,pada Eun-sung terakhir kali,\Ndan terjatuh dengan memalukan.
Dialog: 0,1:08:58.55,1:08:59.90,Default,,0,0,0,,Saya mengerti,
Dialog: 0,1:08:59.92,1:09:02.32,Default,,0,0,0,,tetapi jika Anda tiba-tiba mulai\Nberolahraga karena marah,
Dialogue: 0,1:09:02.34,1:09:04.57,Default,,0,0,0,,- persendianmu akan cedera...\N- Sendi?
Dialogue: 0,1:09:04.59,1:09:05.70,Default,,0,0,0,,Tidak masalah bagiku!
Dialog: 0,1:09:05.72,1:09:08.51,Default,,0,0,0,,Aku akan jadi gila jika terus begini!
Dialogue: 0,1:09:09.10,1:09:13.68,Default,,0,0,0,,Bagaimana jika saya perlu melindungi\Nkeluarga saya di masa mendatang, namun saya tidak bisa?
Dialogue: 0,1:09:15.06,1:09:16.25,Default,,0,0,0,,Aku takut.
Dialog: 0,1:09:16.27,1:09:18.31,Default,,0,0,0,,Ya ampun.
Dialog: 0,1:09:22.24,1:09:23.46,Default,,0,0,0,,Baik.
Dialog: 0,1:09:23.49,1:09:25.27,Default,,0,0,0,,Aku akan mengajarimu.
Dialog: 0,1:09:26.20,1:09:27.18,Default,,0,0,0,,Terima kasih.
Dialog: 0,1:09:27.20,1:09:28.43,Default,,0,0,0,,Duduk.
Dialog: 0,1:09:28.45,1:09:29.51,Default,,0,0,0,,Duduk.
Dialog: 0,1:09:29.54,1:09:31.32,Default,,0,0,0,,Duduk.
Dialog: 0,1:09:32.87,1:09:35.23,Default,,0,0,0,,Karena kita melakukan ini dengan tergesa-gesa,
Dialogue: 0,1:09:35.25,1:09:37.04,Default,,0,0,0,,Aku hanya bisa mengajarimu satu hal.
Dialog: 0,1:09:37.07,1:09:38.06,Default,,0,0,0,,Apa itu?
Dialog: 0,1:09:38.09,1:09:40.20,Default,,0,0,0,,Mendarat satu pukulan...
Dialog: 0,1:09:41.05,1:09:43.29,Default,,0,0,0,,pada seseorang yang kuat.
Dialog: 0,1:09:48.35,1:09:50.92,Default,,0,0,0,,Ada dua keterampilan inti.
Dialog: 0,1:09:51.31,1:09:52.84,Default,,0,0,0,,Soo-cheol.
Dialog: 0,1:09:53.68,1:09:55.43,Default,,0,0,0,,Pukul aku.
Dialog: 0,1:09:55.90,1:09:57.43,Default,,0,0,0,,Apakah kamu serius?
Dialogue: 0,1:10:02.57,1:10:04.48,Default,,0,0,0,,Apakah aku sekuat itu?
Dialog: 0,1:10:05.45,1:10:08.48,Default,,0,0,0,,Tidak, ini adalah keterampilan pertama.
Dialog: 0,1:10:08.58,1:10:09.55,Default,,0,0,0,,Berlebihan,
Dialog: 0,1:10:09.58,1:10:11.89,Default,,0,0,0,,jadi mereka akan merasa sombong dan berpikir,
Dialog: 0,1:10:11.91,1:10:13.89,Default,,0,0,0,,"Dia bukan tandinganku."
Dialogue: 0,1:10:13.91,1:10:15.56,Default,,0,0,0,,"Saya cukup menang."
Dialog: 0,1:10:15.58,1:10:18.16,Default,,0,0,0,,"Saya ternyata kuat."
Dialog: 0,1:10:18.97,1:10:20.62,Default,,0,0,0,,Oke, ayo.
Dialog: 0,1:10:25.22,1:10:27.03,Default,,0,0,0,,- Bagus sekali.\N- Sungguh menyakitkan!
Dialogue: 0,1:10:27.05,1:10:28.78,Default,,0,0,0,,- Maafkan aku.\N- Hidungku!
Dialog: 0,1:10:28.80,1:10:31.16,Default,,0,0,0,,Mengapa saya harus mempelajari ini?
Dialogue: 0,1:10:31.18,1:10:32.99,Default,,0,0,0,,Jadi mereka akan lengah.
Dialog: 0,1:10:33.02,1:10:36.16,Default,,0,0,0,,Kamu harus menunggu sampai mereka lengah,
Dialog: 0,1:10:36.19,1:10:38.21,Default,,0,0,0,,lalu mendaratkan pukulan kritismu.
Dialog: 0,1:10:38.23,1:10:39.96,Default,,0,0,0,,Tapi dipukuli sampai saat itu?
Dialog: 0,1:10:39.98,1:10:41.79,Default,,0,0,0,,Itu skill kedua.
Dialog: 0,1:10:41.82,1:10:43.29,Default,,0,0,0,,Daya Tahan.
Dialog: 0,1:10:43.32,1:10:46.09,Default,,0,0,0,,Kamu memerlukan stamina untuk menerima pukulan dengan baik.
Dialog: 0,1:10:46.11,1:10:48.31,Default,,0,0,0,,Menurutmu aku bisa melakukan itu?
Dialog: 0,1:10:54.95,1:10:57.22,Default,,0,0,0,,Muhammad Ali, mentor saya, mengatakan ini.
Dialog: 0,1:10:57.25,1:10:58.81,Default,,0,0,0,,"Mustahil..."
Dialog: 0,1:10:58.83,1:11:01.53,Default,,0,0,0,,"bukan fakta, ini opini."
Dialog: 0,1:11:06.72,1:11:08.78,Default,,0,0,0,,Kamu bisa melakukannya, Soo-cheol.
Dialog: 0,1:11:08.80,1:11:12.03,Default,,0,0,0,,Lakukan beberapa pukulan untuk saat ini\Ndan jadilah juara dalam hidup.
Dialog: 0,1:11:12.05,1:11:13.91,Default,,0,0,0,,Apakah mentormu juga mengatakan itu?
Dialogue: 0,1:11:13.93,1:11:15.58,Default,,0,0,0,,Tidak, ini aku yang bicara.
Dialog: 0,1:11:15.60,1:11:16.58,Default,,0,0,0,,Baiklah.
Dialogue: 0,1:11:16.60,1:11:18.16,Default,,0,0,0,,Ayo kita coba.
Dialog: 0,1:11:18.19,1:11:19.72,Default,,0,0,0,,Oke.
Dialog: 0,1:11:30.70,1:11:31.80,Default,,0,0,0,,Ya ampun.
Dialogue: 0,1:11:31.82,1:11:34.34,Default,,0,0,0,,Aku tidak tahu kamu\Nbersantai di tempat yang begitu indah...
Dialog: 0,1:11:34.37,1:11:36.68,Default,,0,0,0,,dan lingkungan bersih.
Dialogue: 0,1:11:36.70,1:11:37.97,Default,,0,0,0,,Santai, kakiku.
Dialog: 0,1:11:38.00,1:11:39.47,Default,,0,0,0,,Beraninya kamu datang ke sini?
Dialog: 0,1:11:39.50,1:11:41.57,Default,,0,0,0,,Ibu, saya mengundangnya.
Dialog: 0,1:11:41.67,1:11:43.02,Default,,0,0,0,,Benarkah? Mengapa?
Dialog: 0,1:11:43.04,1:11:45.23,Default,,0,0,0,,Ada sesuatu yang belum kukatakan padamu.
Dialog: 0,1:11:45.25,1:11:47.79,Default,,0,0,0,,Ini tentang dana rahasia Kakek.
Dialog: 0,1:11:49.68,1:11:51.07,Default,,0,0,0,,$900 juta?
Dialogue: 0,1:11:51.09,1:11:53.24,Default,,0,0,0,,Dan uang itu ada di Malaysia?
Dialog: 0,1:11:53.26,1:11:54.86,Default,,0,0,0,,Tidak, menurutku ada di sini.
Dialog: 0,1:11:54.89,1:11:55.95,Default,,0,0,0,,- Di Korea?\N- Ya, Pak.
Dialog: 0,1:11:55.97,1:11:58.70,Default,,0,0,0,,Dicuci di\NHong Kong sebelum datang ke sini.
Dialogue: 0,1:11:58.73,1:12:00.33,Default,,0,0,0,,Perusahaan kertas itu...
Dialog: 0,1:12:00.35,1:12:03.62,Default,,0,0,0,,meminjamkan uang ke lima\Nperusahaan investasi di Korea...
Dialog: 0,1:12:03.65,1:12:05.58,Default,,0,0,0,,sebelum dimatikan.
Dialog: 0,1:12:05.61,1:12:09.13,Default,,0,0,0,,Artinya kelima perusahaan\Ntidak perlu membayarnya kembali.
Dialogue: 0,1:12:09.15,1:12:11.34,Default,,0,0,0,,Apakah Ayah pemilik perusahaan itu?
Dialogue: 0,1:12:11.36,1:12:13.88,Default,,0,0,0,,Sebelum dia roboh,\Nkepemilikan dipindahkan...
Dialog: 0,1:12:13.91,1:12:15.68,Default,,0,0,0,,kepada Ibu Moh.
Dialog: 0,1:12:15.70,1:12:16.76,Default,,0,0,0,,Apa katamu?
Dialogue: 0,1:12:16.79,1:12:18.97,Default,,0,0,0,,Apakah maksudmu gadis itu mengambil semuanya?
Dialog: 0,1:12:19.00,1:12:21.14,Default,,0,0,0,,Saya kira tidak.
Dialogue: 0,1:12:21.17,1:12:23.41,Default,,0,0,0,,{\i1}Dia masih mencarinya.{\i0}
Dialog: 0,1:12:31.43,1:12:32.65,Default,,0,0,0,,{\i1}Katakan padaku.{\i0}
Dialog: 0,1:12:32.68,1:12:33.74,Default,,0,0,0,,{\i1}Di mana uangku?{\i0}
Dialogue: 0,1:12:33.76,1:12:36.74,Default,,0,0,0,,{\i1}Di mana dana rahasia yang kamu\Nsimpan atas namaku?{\i0}
Dialogue: 0,1:12:36.76,1:12:38.70,Default,,0,0,0,,Apakah kamu yakin Grace diperbolehkan...
Dialog: 0,1:12:38.72,1:12:40.37,Default,,0,0,0,,- mendengar ini?\N- Anda dapat mempercayai saya.
Dialog: 0,1:12:40.39,1:12:42.41,Default,,0,0,0,,Saya membelot.
Dialog: 0,1:12:42.44,1:12:43.71,Default,,0,0,0,,Ingat Lee Woong-pyung?
Dialogue: 0,1:12:43.73,1:12:45.46,Default,,0,0,0,,Aku juga pernah menerbangkan jetku...
Dialog: 0,1:12:45.48,1:12:48.08,Default,,0,0,0,,ke tanah kebebasan ini.
Dialog: 0,1:12:48.11,1:12:50.88,Default,,0,0,0,,Kita lihat saja nanti.\NMari kita lihat jet Anda.
Dialog: 0,1:12:50.90,1:12:52.01,Default,,0,0,0,,Beri tahu kami.
Dialog: 0,1:12:52.03,1:12:55.93,Default,,0,0,0,,Seseorang yang saya kenal di bisnis real-estate\N mengatakan sesuatu yang aneh.
Dialog: 0,1:12:55.95,1:12:58.68,Default,,0,0,0,,Direktur Jin dari Galeri Queens menyewa...
Dialogue: 0,1:12:58.70,1:13:01.39,Default,,0,0,0,,gudang seluas 4 hektar di\Noutskirts Provinsi Gyeonggi.
Dialog: 0,1:13:01.41,1:13:04.89,Default,,0,0,0,,Ini tidak seperti mereka sedang membuat lokasi syuting,
Dialogue: 0,1:13:04.92,1:13:06.48,Default,,0,0,0,,jadi mengapa mereka membutuhkan yang sebesar itu?
Dialog: 0,1:13:06.51,1:13:08.56,Default,,0,0,0,,Jadi menurut Anda uangnya ada di sana.
Dialog: 0,1:13:14.84,1:13:17.20,Default,,0,0,0,,Kamu menyuruhku membawakanmu semua surat yang dikirim...
Dialog: 0,1:13:17.22,1:13:18.74,Default,,0,0,0,,kepada mantan ketua.
Dialog: 0,1:13:18.76,1:13:20.30,Default,,0,0,0,,Bagus.
Dialogue: 0,1:13:25.73,1:13:27.29,Default,,0,0,0,,Aku bisa saja datang sendiri.
Dialog: 0,1:13:27.31,1:13:29.67,Default,,0,0,0,,Kamu tidak perlu berkerumun di sini.
Dialog: 0,1:13:29.69,1:13:33.38,Default,,0,0,0,,Kami tidak dapat mempercayai Anda. Ini seperti\Nmeninggalkan anak sendirian.
Dialogue: 0,1:13:33.40,1:13:35.80,Default,,0,0,0,,Kalian semua terekspos di media.
Dialogue: 0,1:13:35.82,1:13:38.93,Default,,0,0,0,,- Bagaimana jika mereka mengenalimu?\N- Kami menyamar.
Dialog: 0,1:13:38.95,1:13:41.78,Default,,0,0,0,,Kami akan mengambil alih dari sini, jadi kamu boleh pergi.
Dialogue: 0,1:13:42.20,1:13:44.39,Default,,0,0,0,,Kau menyakiti perasaanku.
Dialogue: 0,1:13:44.42,1:13:47.14,Default,,0,0,0,,Ini adalah misi penyamaran.
Dialogue: 0,1:13:47.17,1:13:49.52,Default,,0,0,0,,Apakah kamu pernah memalsukan sesuatu sebelumnya? Tidak.
Dialogue: 0,1:13:49.55,1:13:51.90,Default,,0,0,0,,Seluruh hidupku palsu,
Dialogue: 0,1:13:51.92,1:13:54.03,Default,,0,0,0,,jadi bagaimana bisa kau tidak melibatkanku dalam hal ini?
Dialog: 0,1:13:54.05,1:13:56.57,Default,,0,0,0,,Oke. Mohon perhatiannya.
Dialog: 0,1:13:56.59,1:13:58.45,Default,,0,0,0,,Saya agen real estat,
Dialog: 0,1:13:58.47,1:14:02.41,Default,,0,0,0,,dan Anda adalah pedagang grosir\Nyang membutuhkan gudang besar.
Dialog: 0,1:14:02.43,1:14:05.54,Default,,0,0,0,,Saya yang bicara, jadi jangan katakan apa pun.
Dialog: 0,1:14:08.15,1:14:09.89,Default,,0,0,0,,Ayo pergi.
Dialogue: 0,1:14:13.49,1:14:16.34,Default,,0,0,0,,Tidak ada tempat untuk menyimpan semua uang itu.
Dialog: 0,1:14:16.36,1:14:17.63,Default,,0,0,0,,Omong-omong,
Dialogue: 0,1:14:17.66,1:14:19.44,Default,,0,0,0,,apa yang akan mereka simpan?
Dialog: 0,1:14:22.79,1:14:24.99,Default,,0,0,0,,- Tongkat golf...\N- Pakaian...
Dialog: 0,1:14:26.17,1:14:27.64,Default,,0,0,0,,Dia mengimpor...
Dialog: 0,1:14:27.67,1:14:29.94,Default,,0,0,0,,peralatan golf,
Dialog: 0,1:14:29.96,1:14:32.61,Default,,0,0,0,,dan dia menjual pakaian di Dongdaemun.
Dialog: 0,1:14:32.63,1:14:34.90,Default,,0,0,0,,Dia dari Tiongkok.
Dialog: 0,1:14:34.92,1:14:37.40,Default,,0,0,0,,Dia mengerti bahasa Korea,
Dialog: 0,1:14:37.43,1:14:39.63,Default,,0,0,0,,tetapi tidak dapat mengucapkannya.
Dialog: 0,1:14:40.85,1:14:43.84,Default,,0,0,0,,Pak. Tidak ada ketumbar.
Dialog: 0,1:14:43.97,1:14:46.34,Default,,0,0,0,,Saya tidak bisa berbahasa Mandarin.
Dialog: 0,1:14:51.02,1:14:53.63,Default,,0,0,0,,Apakah suhu dan kelembapan di sini...
Dialogue: 0,1:14:53.65,1:14:54.71,Default,,0,0,0,,sedang diatur?
Dialog: 0,1:14:54.74,1:14:55.80,Default,,0,0,0,,Anda menyadarinya.
Dialog: 0,1:14:55.82,1:14:59.47,Default,,0,0,0,,Mantan pelanggan kami biasa mengimpor karya seni.
Dialog: 0,1:14:59.49,1:15:01.34,Default,,0,0,0,,Saya tahu sedikit tentang seni.
Dialog: 0,1:15:01.37,1:15:02.51,Default,,0,0,0,,Artis yang mana?
Dialogue: 0,1:15:02.53,1:15:04.55,Default,,0,0,0,,Mereka tidak terkenal.
Dialog: 0,1:15:04.58,1:15:06.68,Default,,0,0,0,,Mereka pemula, tapi sekarang mereka sangat terkenal.
Dialogue: 0,1:15:06.71,1:15:08.98,Default,,0,0,0,,Harga karya mereka melonjak 20 hingga 30 kali lipat.
Dialog: 0,1:15:09.00,1:15:11.19,Default,,0,0,0,,Tempat ini membawa energi baik.
Dialog: 0,1:15:11.21,1:15:14.61,Default,,0,0,0,,- Tolong, jangan ada daun ketumbar di piring saya.\N- Ya.
Dialogue: 0,1:15:14.63,1:15:17.01,Default,,0,0,0,,Dia ingin melihat karya seninya.
Dialogue: 0,1:15:17.03,1:15:18.03,Default,,0,0,0,,Tentu saja.
Dialog: 0,1:15:18.05,1:15:21.42,Default,,0,0,0,,Yang Mulia, apa yang terjadi dengan anak saya?
Dialogue: 0,1:15:24.10,1:15:25.62,Default,,0,0,0,,{\i1}Pintu utama terbuka.{\i0}
Dialogue: 0,1:15:25.64,1:15:27.62,Default,,0,0,0,,{\i1}Kita sedang menuju ke dalam, jadi periksalah kantornya.{\i0}
Dialog: 0,1:15:27.64,1:15:30.26,Default,,0,0,0,,Oke. Saya akan melakukan itu.
Dialog: 0,1:15:43.37,1:15:45.09,Default,,0,0,0,,Ini dianggap sebagai perjalanan bisnis.
Dialog: 0,1:15:45.12,1:15:47.53,Default,,0,0,0,,Saya akan membayar Anda ekstra.
Dialogue: 0,1:15:48.50,1:15:53.37,Default,,0,0,0,,Mereka seharusnya tidak memergokiku melakukan ini di sini.
Dialog: 0,1:16:04.18,1:16:08.24,Default,,0,0,0,,Ini cara yang salah untuk menyimpan karya seni.
Dialogue: 0,1:16:08.27,1:16:11.37,Default,,0,0,0,,Apakah menurut Anda karya seni\Nof ini harganya melonjak?
Dialog: 0,1:16:11.40,1:16:13.37,Default,,0,0,0,,Ya, itulah yang saya dengar.
Dialogue: 0,1:16:13.40,1:16:18.10,Default,,0,0,0,,Aku punya selera seni yang bagus, tapi\Nmereka tidak terlihat terlalu bagus bagiku.
Dialogue: 0,1:16:22.57,1:16:26.05,Default,,0,0,0,,Saya rasa uangnya ada di dalam karya seni.\NDi sinilah dia mencucinya.
Dialogue: 0,1:16:26.08,1:16:29.47,Default,,0,0,0,,Jadi dia membeli karya\Nartis pendatang baru dengan harga tinggi dengan uangnya?
Dialog: 0,1:16:29.50,1:16:31.43,Default,,0,0,0,,Ya, sepuluh hingga dua puluh kali lipat.
Dialog: 0,1:16:31.46,1:16:33.98,Default,,0,0,0,,Setelah mentransfer uang,\NI kira 90% atau lebih...
Dialog: 0,1:16:34.00,1:16:36.27,Default,,0,0,0,,diberikan kembali kepadanya melalui uang tunai.
Dialogue: 0,1:16:36.30,1:16:38.57,Default,,0,0,0,,Itu jumlah yang besar.
Dialog: 0,1:16:38.59,1:16:40.96,Default,,0,0,0,,Aku ingin tahu di mana semua uang itu.
Dialog: 0,1:16:43.89,1:16:45.01,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mendekripsi...{\c}{\i0}
Dialog: 0,1:16:50.43,1:16:52.04,Default,,0,0,0,,Kita harus pergi.
Dialog: 0,1:16:52.06,1:16:53.41,Default,,0,0,0,,Kita tidak punya waktu.
Dialog: 0,1:16:53.44,1:16:54.54,Default,,0,0,0,,Sialan.
Dialogue: 0,1:16:54.56,1:16:56.81,Default,,0,0,0,,Terlalu banyak data.
Dialog: 0,1:16:59.86,1:17:03.52,Default,,0,0,0,,Saya akan bertanya kepada klien saya dan\N segera menelepon Anda.
Dialog: 0,1:17:04.53,1:17:06.07,Default,,0,0,0,,Selamat tinggal.
Dialog: 0,1:17:14.96,1:17:16.71,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kantor\NHarap Ketuk{\c}{\i0}
Dialog: 0,1:17:21.80,1:17:23.96,Default,,0,0,0,,Apakah rusak?
Dialogue: 0,1:17:41.19,1:17:45.10,Default,,0,0,0,,Jangan sampai basah. Tunggu\Ndi sini sementara saya membawa mobilnya.
Dialog: 0,1:18:21.27,1:18:23.06,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:18:31.91,1:18:34.99,Default,,0,0,0,,Hyun-woo, cepat sekali.
Dialog: 0,1:18:35.79,1:18:37.23,Default,,0,0,0,,Kenapa kamu di sini?
Dialog: 0,1:18:37.25,1:18:39.16,Default,,0,0,0,,Bangun.
Dialog: 0,1:18:45.22,1:18:46.83,Default,,0,0,0,,Saya agak pusing.
Dialogue: 0,1:18:47.51,1:18:49.63,Default,,0,0,0,,Aku juga lapar.
Dialog: 0,1:18:52.64,1:18:55.59,Default,,0,0,0,,Ayo makan sesuatu yang enak sebelum pulang.
Dialog: 0,1:18:58.77,1:19:00.30,Default,,0,0,0,,Tentu.
Dialogue: 0,1:19:17.50,1:19:19.16,Default,,0,0,0,,Apakah aku absen lama?
Dialog: 0,1:19:20.96,1:19:23.04,Default,,0,0,0,,Tidak, tidak terlalu lama.
Dialog: 0,1:19:32.01,1:19:33.63,Default,,0,0,0,,Hae-in.
Dialog: 0,1:19:33.89,1:19:35.76,Default,,0,0,0,,Tunggu sebentar.
Dialog: 0,1:19:36.06,1:19:37.54,Default,,0,0,0,,Mengapa?
Dialog: 0,1:19:37.56,1:19:39.12,Default,,0,0,0,,Apakah kita dibuntuti lagi?
Dialog: 0,1:19:39.14,1:19:41.30,Default,,0,0,0,,Jangan khawatir. Saya bisa kehilangan dia.
Dialog: 0,1:21:04.81,1:21:06.33,Default,,0,0,0,,- Apakah kamu baik-baik saja?\N- Ya.
Dialog: 0,1:21:06.36,1:21:08.89,Default,,0,0,0,,Haruskah kita memanggil polisi?
Dialog: 0,1:21:09.15,1:21:10.46,Default,,0,0,0,,- Tunggu.\N- Kita harus melakukannya.
Dialogue: 0,1:21:10.49,1:21:13.31,Default,,0,0,0,,Kamu juga diserang oleh tiga orang terakhir kali.
Dialog: 0,1:22:51.21,1:22:53.25,Default,,0,0,0,,Hae-in!
Dialog: 0,1:23:09.61,1:23:10.58,Default,,0,0,0,,Astaga.
Dialog: 0,1:23:10.61,1:23:12.33,Default,,0,0,0,,Lihat komentar ini.
Dialog: 0,1:23:12.36,1:23:13.71,Default,,0,0,0,,Ini karena Eun-sung...
Dialog: 0,1:23:13.73,1:23:16.34,Default,,0,0,0,,menyebarkan rumor palsu tentang bagaimana\Nkamu sedang diselidiki...
Dialog: 0,1:23:16.37,1:23:18.38,Default,,0,0,0,,karena menggelapkan uang sebelum perceraian.
Dialog: 0,1:23:18.41,1:23:19.42,Default,,0,0,0,,Tidak apa-apa. Abaikan mereka.
Dialog: 0,1:23:19.45,1:23:21.63,Default,,0,0,0,,Bagaimana mungkin aku melakukan itu?
Dialog: 0,1:23:21.66,1:23:24.20,Default,,0,0,0,,"Mantan Hong Hae-in pasti\Nmenikahinya demi uang."
Dialog: 0,1:23:24.23,1:23:25.26,Default,,0,0,0,,"Dia penipu."
Dialogue: 0,1:23:25.29,1:23:27.52,Default,,0,0,0,,"Inilah sebabnya kamu harus\Nwaspada terhadap pria tampan."
Dialogue: 0,1:23:27.54,1:23:29.77,Default,,0,0,0,,Beraninya mereka mengutukmu?
Dialog: 0,1:23:29.79,1:23:31.10,Default,,0,0,0,,Ayo tuntut mereka semua.
Dialog: 0,1:23:31.13,1:23:33.49,Default,,0,0,0,,Lupakan saja. Ayo pergi.
Dialog: 0,1:23:33.96,1:23:36.07,Default,,0,0,0,,Tunggu. Seseorang juga menjelek-jelekkan Hae-in.
Dialogue: 0,1:23:36.09,1:23:39.28,Default,,0,0,0,,"Dia sudah pulih setelah\Nperceraian. Dia pasti mudah."
Dialog: 0,1:23:39.30,1:23:41.07,Default,,0,0,0,,Mereka tidak tahu apa-apa tentang dia.
Dialog: 0,1:23:41.09,1:23:44.17,Default,,0,0,0,,"Mungkin dia berbohong tentang kematian."
Dialog: 0,1:23:44.85,1:23:47.01,Default,,0,0,0,,Yang ini melewati batas...
Dialogue: 0,1:23:48.09,1:23:49.06,Default,,0,0,0,,Apa ID-nya?
Dialog: 0,1:23:49.09,1:23:50.12,Default,,0,0,0,,Tangkapan layar ini.
Dialog: 0,1:23:50.15,1:23:52.00,Default,,0,0,0,,Buat file PDF dan tuntut mereka.
Dialog: 0,1:23:52.02,1:23:53.42,Default,,0,0,0,,Saya tidak akan menyelesaikan atau bernegosiasi.
Dialogue: 0,1:23:53.44,1:23:55.33,Default,,0,0,0,,Ada apa dengan matamu? Kamu membuatku takut.
Dialogue: 0,1:23:55.36,1:23:57.98,Default,,0,0,0,,Mereka semua akan membayarnya.
Dialog: 0,1:24:03.49,1:24:06.33,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:24:36.65,1:24:38.96,Default,,0,0,0,,{\an8}{\i1}Saya hampir menemukan dana rahasia.{\i0}
Dialog: 0,1:24:38.99,1:24:40.88,Default,,0,0,0,,{\an8}{\i1}Itu dia!{\i0}
Dialogue: 0,1:24:40.90,1:24:42.34,Default,,0,0,0,,{\an8}{\i1}Keluar dari situ.{\i0}
Dialog: 0,1:24:42.36,1:24:44.88,Default,,0,0,0,,{\an8}{\i1}Kami punya cerita seperti film kami sendiri.{\i0}
Dialog: 0,1:24:44.91,1:24:47.14,Default,,0,0,0,,{\an8}{\i1}Sungguh mesra.{\i0}
Dialog: 0,1:24:47.16,1:24:49.64,Default,,0,0,0,,{\an8}{\i1}Di mana patungnya?{\i0}
Dialog: 0,1:24:49.66,1:24:51.10,Default,,0,0,0,,{\an8}{\i1}Da-hye!{\i0}
Dialog: 0,1:24:51.12,1:24:52.81,Default,,0,0,0,,{\an8}{\i1}Bajingan!{\i0}
Dialogue: 0,1:24:52.83,1:24:54.19,Default,,0,0,0,,{\an8}{\i1}Aku harus memeriksanya.{\i0}
Dialog: 0,1:24:54.21,1:24:56.81,Default,,0,0,0,,{\an8}{\i1}Aku tidak yakin apa pun lagi.{\i0}
Dialog: 0,1:24:56.84,1:24:59.19,Default,,0,0,0,,{\an8}{\i1}Akulah yang\Npertama kali mengembangkan perasaan padamu.{\i0}
Dialogue: 0,1:24:59.21,1:25:01.69,Default,,0,0,0,,{\an8}{\i1}Jadi dia tahu di mana uangnya?{\i0}
Dialog: 0,1:25:01.72,1:25:04.38,Default,,0,0,0,,{\an8}{\i1}Apakah ini nyata? Aku tidak sedang bermimpi?{\i0}
