Dialog: 0,0:00:19.47,0:00:23.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialog: 0,0:00:23.95,0:00:26.94,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialog: 0,0:00:31.55,0:00:33.50,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialog: 0,0:00:33.63,0:00:35.63,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialog: 0,0:00:35.66,0:00:37.66,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialog: 0,0:00:37.68,0:00:39.70,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialog: 0,0:00:39.73,0:00:41.88,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialog: 0,0:00:50.13,0:00:52.79,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Penulis Skrin: Park Ji-eun{\c}{\i0}
Dialog: 0,0:00:53.00,0:00:55.61,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Pengarah: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:15.70,0:01:17.48, Lalai,,0,0,0,, Berhenti.
Dialog: 0,0:01:31.96,0:01:34.37, Lalai,,0,0,0,,Saya mengenali trak itu.
Dialog: 0,0:01:39.55,0:01:40.78, Lalai,,0,0,0,,Saya rasa pelik...
Dialog: 0,0:01:40.80,0:01:43.53,Default,,0,0,0,,bila datuk tiba-tiba mahu...
Dialog: 0,0:01:43.56,0:01:46.45, Lalai,,0,0,0,,untuk menukar ventilator dan menyuruh kami pergi.
Dialog: 0,0:01:46.48,0:01:48.70, Lalai,,0,0,0,,Itu hari saya nampak trak itu.
Dialog: 0,0:01:48.73,0:01:51.17, Lalai,,0,0,0,,Jadi anda fikir trak itu membawa tabung rahsianya?
Dialog: 0,0:01:51.19,0:01:55.14,Lalai,,0,0,0,,Jika saya betul, bukankah wang itu ada di rumah?
Dialog: 0,0:02:04.24,0:02:05.36,Lalai,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episod 12{\c}{\i0}
Dialog: 0,0:02:16.67,0:02:17.90,Lalai,,0,0,0,,{\an8}Anda tidak sepatutnya basah.
Dialog: 0,0:02:17.92,0:02:21.00,Lalai,,0,0,0,,{\an8}Tunggu di sini sementara saya membawa kereta ke hadapan.
Dialog: 0,0:02:48.87,0:02:51.49,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda telah tiba di destinasi anda.{\c}{\i0}
Dialog: 0,0:03:14.27,0:03:15.97, Lalai,,0,0,0,,Hae-in.
Dialog: 0,0:03:20.28,0:03:21.94, Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,0:03:30.58,0:03:32.36, Lalai,,0,0,0,, Itu pantas.
Dialog: 0,0:03:36.92,0:03:38.27, Lalai,,0,0,0,,Kenapa awak di luar sini?
Dialog: 0,0:03:38.30,0:03:39.91, Lalai,,0,0,0,,Bangun.
Dialog: 0,0:03:48.10,0:03:49.80, Lalai,,0,0,0,,Saya agak pening.
Dialog: 0,0:03:52.10,0:03:54.22, Lalai,,0,0,0,,Saya pun lapar.
Dialog: 0,0:03:57.23,0:04:00.23,Lalai,,0,0,0,,Mari kita makan sesuatu yang sedap sebelum pulang.
Dialog: 0,0:04:07.41,0:04:08.94, Lalai,,0,0,0,, Pasti.
Dialog: 0,0:05:38.71,0:05:41.06, Lalai,,0,0,0,,- Adakah anda okay?\N- Ya.
Dialog: 0,0:05:41.09,0:05:42.40, Lalai,,0,0,0,, Patutkah kita menghubungi polis?
Dialog: 0,0:05:42.42,0:05:43.73, Lalai,,0,0,0,,- Tunggu.\N- Kita sepatutnya.
Dialog: 0,0:05:43.76,0:05:46.67, Lalai,,0,0,0,,Anda telah diserang oleh tiga lelaki lepas juga.
Dialog: 0,0:06:45.27,0:06:46.81, Lalai,,0,0,0,,Anda...
Dialog: 0,0:06:48.07,0:06:49.59, Lalai,,0,0,0,,Eun-sung.
Dialog: 0,0:06:49.61,0:06:52.77, Lalai,,0,0,0,,Apa? Adakah anda mengenali saya sekarang?
Dialog: 0,0:06:53.74,0:06:55.28,Lalai,,0,0,0,,Sungguh memalukan.
Dialog: 0,0:06:58.79,0:07:00.18, Lalai,,0,0,0,,Bagaimana saya boleh...?
Dialog: 0,0:07:00.21,0:07:02.73, Lalai,,0,0,0,, Tepat sekali. Bagaimana anda boleh silap saya...
Dialog: 0,0:07:02.75,0:07:04.79, Lalai,,0,0,0,,untuk Hyun-woo?
Dialog: 0,0:07:07.83,0:07:09.53, Lalai,,0,0,0,,Hae-in!
Dialog: 0,0:07:15.72,0:07:17.42, Lalai,,0,0,0,,Buka pintu.
Dialog: 0,0:07:18.93,0:07:20.47, Lalai,,0,0,0,,Dan jika saya lakukan?
Dialog: 0,0:07:21.06,0:07:22.93, Lalai,,0,0,0,,Apa yang anda akan beritahu dia?
Dialog: 0,0:07:23.19,0:07:24.87, Lalai,,0,0,0,,- Apa?\N- Adakah anda akan memberitahunya?
Dialog: 0,0:07:24.90,0:07:28.39, Lalai,,0,0,0,,Awak naik kereta saya\Selepas tersalah sangka saya untuk dia?
Dialog: 0,0:07:43.12,0:07:44.56, Lalai,,0,0,0,,Dia pasti terkejut.
Dialog: 0,0:07:44.58,0:07:47.54,Lalai,,0,0,0,,Bukankah lebih baik jika anda berkata...
Dialog: 0,0:07:47.71,0:07:49.71, Lalai,,0,0,0,,kita akan pergi ke suatu tempat?
Dialog: 0,0:07:51.42,0:07:53.13, Lalai,,0,0,0,, Hae-in.
Dialog: 0,0:07:58.85,0:08:00.84, Lalai,,0,0,0,,Buka kunci pintu.
Dialog: 0,0:08:03.73,0:08:05.68, Lalai,,0,0,0,,Buka kuncinya.
Dialog: 0,0:08:19.79,0:08:21.86, Lalai,,0,0,0,,Awak okay?
Dialog: 0,0:08:22.21,0:08:24.53, Lalai,,0,0,0,,Ya, saya tidak apa-apa.
Dialog: 0,0:08:25.67,0:08:27.49,Lalai,,0,0,0,,Kemudian saya lega.
Dialog: 0,0:08:32.38,0:08:35.38,Lalai,,0,0,0,,Saya fikir sesuatu telah berlaku kepada anda.
Dialog: 0,0:08:35.55,0:08:37.13, Lalai,,0,0,0,,Jom.
Dialog: 0,0:08:55.53,0:08:58.38,Lalai,,0,0,0,,Saya terserempak dengan Eun-sung tadi,
Dialog: 0,0:08:58.41,0:09:00.86, Lalai,,0,0,0,, dan dia menjemput saya pulang ke rumah.
Dialog: 0,0:09:02.20,0:09:05.24, Lalai,,0,0,0,,Anda tahu saya ingin berjumpa dengan Atuk.
Dialog: 0,0:09:11.30,0:09:13.33, Lalai,,0,0,0,,Saya akan kembali.
Dialog: 0,0:09:14.30,0:09:16.12, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:09:16.72,0:09:17.74, Lalai,,0,0,0,,Biar saya pergi dengan awak.
Dialog: 0,0:09:17.76,0:09:19.36, Lalai,,0,0,0,,Maafkan saya,
Dialog: 0,0:09:19.39,0:09:21.84, Lalai,,0,0,0,,tetapi saya hanya menjemputnya.
Dialog: 0,0:09:26.35,0:09:27.89, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:09:29.31,0:09:31.18, Lalai,,0,0,0,,Cukup angkat saya kemudian.
Dialog: 0,0:09:31.82,0:09:33.77, Lalai,,0,0,0,,Adakah anda pasti anda baik-baik saja?
Dialog: 0,0:09:35.61,0:09:38.15, Lalai,,0,0,0,,Ya, saya baik-baik saja.
Dialog: 0,0:10:43.43,0:10:44.41,Lalai,,0,0,0,,Kejutan.
Dialog: 0,0:10:44.43,0:10:46.26, Lalai,,0,0,0,,Bagaimana awak jumpa saya?
Dialog: 0,0:10:49.56,0:10:51.58, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:10:51.60,0:10:55.93, Lalai,,0,0,0,,- Adakah anda tidak gembira melihat saya?\N- Maksud saya, saya akan menelefon.
Dialog: 0,0:10:56.19,0:10:57.84, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:10:57.86,0:11:01.40, Lalai,,0,0,0,, Astaga, saya tidak tahu.
Dialog: 0,0:11:03.16,0:11:06.86,Lalai,,0,0,0,,Saya terfikir untuk membunuh awak\Sekali saya menjejaki awak.
Dialog: 0,0:11:13.75,0:11:15.79, Lalai,,0,0,0,,Geon-u.
Dialog: 0,0:11:16.21,0:11:20.46, Lalai,,0,0,0,,Adakah ini dia? Astaga, dia kelihatan lebih baik dalam foto.
Dialog: 0,0:11:20.84,0:11:22.36, Lalai,,0,0,0,,Hei, Dong-u.
Dialog: 0,0:11:22.39,0:11:24.32, Lalai,,0,0,0,,Sebut, "Ayah."
Dialog: 0,0:11:24.35,0:11:25.95, Lalai,,0,0,0,,- Nama dia Geon-u.\N- Hei.
Dialog: 0,0:11:25.97,0:11:28.74,Lalai,,0,0,0,,Saya menamakan anak saya "Dong-u," jadi itu namanya.
Dialog: 0,0:11:28.77,0:11:31.70, Lalai,,0,0,0,,Bagaimanapun, ia pasti sukar...
Dialog: 0,0:11:31.73,0:11:34.93, Lalai,,0,0,0,,untuk hidup dengan orang bodoh yang padat.
Dialog: 0,0:11:35.44,0:11:38.25,Lalai,,0,0,0,,Soo-cheol akan ditangkap tidak lama lagi.
Dialog: 0,0:11:38.28,0:11:40.63,Lalai,,0,0,0,,- Kenapa?\N- Saya melakukan beberapa perbuatan haram...
Dialog: 0,0:11:40.65,0:11:41.80, Lalai,,0,0,0,,sebagai pengarah kewangan.
Dialog: 0,0:11:41.82,0:11:45.05, Lalai,,0,0,0,,Saya telah merancangnya supaya dia akan disalahkan.
Dialog: 0,0:11:45.07,0:11:48.30, Lalai,,0,0,0,,Saya memberitahu pendakwa raya sebelum meninggalkan Korea.
Dialog: 0,0:11:48.33,0:11:50.18, Lalai,,0,0,0,,- Anda tidak perlu berbuat demikian...\N- Hei.
Dialog: 0,0:11:50.20,0:11:52.43, Lalai,,0,0,0,,Saya lakukan semuanya untuk anda.
Dialog: 0,0:11:52.46,0:11:56.20,Lalai,,0,0,0,,Bagaimana jika dia mahu membalas dendam\Nand datang mencari awak?
Dialog: 0,0:12:04.84,0:12:08.38,Lalai,,0,0,0,,Aduh, bisingnya dia. Hei!
Dialog: 0,0:12:08.64,0:12:10.72, Lalai,,0,0,0,,Lakukan itu di dalam bilik air.
Dialog: 0,0:12:13.52,0:12:15.79,Lalai,,0,0,0,,{\i1}Orang yang anda dail tidak tersedia.{\i0}
Dialog: 0,0:12:15.81,0:12:17.12,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Anak saya, Hyun-woo{\c}{\i0}
Dialog: 0,0:12:17.15,0:12:19.50,Lalai,,0,0,0,,Hyun-woo dan Hae-in tidak menjawab.
Dialog: 0,0:12:19.53,0:12:21.55,Lalai,,0,0,0,,Adakah mereka bermalam di Seoul?
Dialog: 0,0:12:21.57,0:12:24.48, Lalai,,0,0,0,,Itu lebih baik daripada memandu balik pada jam ini.
Dialog: 0,0:12:24.91,0:12:26.41,Lalai,,0,0,0,,Sayang, jangan awak fikir...
Dialog: 0,0:12:26.43,0:12:28.74, Lalai,,0,0,0,,- kami terlalu gaya Amerika?\N- Apa maksud awak?
Dialog: 0,0:12:28.76,0:12:30.47, Lalai,,0,0,0,,Lupakan tentang Hae-in.
Dialog: 0,0:12:30.49,0:12:33.31,Default,,0,0,0,,Hyun-woo tak pergi belajar pun ke luar negara.
Dialog: 0,0:12:33.33,0:12:35.27,Lalai,,0,0,0,,Tidakkah anda rasa dia terlalu berfikiran terbuka?
Dialog: 0,0:12:35.29,0:12:36.27, Lalai,,0,0,0,,Apa masalahnya?
Dialog: 0,0:12:36.29,0:12:38.90, Lalai,,0,0,0,,Mereka bukan orang asing.
Dialog: 0,0:12:38.92,0:12:44.17,Lalai,,0,0,0,,Pasangan bercerai\Nlebih jauh daripada orang yang tidak dikenali.
Dialog: 0,0:12:45.84,0:12:49.07, Lalai,,0,0,0,,- Betul ke?\N- Ini bukan rodeo pertama anda.
Dialog: 0,0:12:49.10,0:12:52.45,Lalai,,0,0,0,,Apa yang anda katakan apabila anda mendengar\NHyun-woo berkahwin dengan keluarga itu?
Dialog: 0,0:12:52.48,0:12:53.99, Lalai,,0,0,0, "Betul ke?"
Dialog: 0,0:12:54.02,0:12:55.75,Lalai,,0,0,0,,Dan bila dia memutuskan untuk bercerai?
Dialog: 0,0:12:55.77,0:12:57.08, Lalai,,0,0,0, "Betul ke?"
Dialog: 0,0:12:57.10,0:13:00.38, Lalai,,0,0,0,,Dan apabila dia mula-mula membawa\Nmertuanya tinggal di sini,
Dialog: 0,0:13:00.40,0:13:02.32,Lalai,,0,0,0,,bukankah anda mengatakan perkara yang sama?
Dialog: 0,0:13:02.34,0:13:03.34, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:13:03.36,0:13:05.26, Lalai,,0,0,0,,"Adakah ini betul? Adakah ini salah?"
Dialog: 0,0:13:05.28,0:13:08.22,Lalai,,0,0,0,,Tidak ada gunanya bimbang.\NHidup akan mengambil jalannya.
Dialog: 0,0:13:08.24,0:13:10.98, Lalai,,0,0,0,,- Biarkan sahaja.\N- Anda betul.
Dialog: 0,0:13:11.04,0:13:13.99,Lalai,,0,0,0,,Sayang, adakah awak melihat matanya kebelakangan ini?
Dialog: 0,0:13:14.29,0:13:17.03, Lalai,,0,0,0,,Tiada berpatah balik untuk dia sekarang.
Dialog: 0,0:13:17.46,0:13:20.29,Lalai,,0,0,0,,Tiada sesiapa boleh menghalangnya.
Dialog: 0,0:13:20.63,0:13:22.79, Lalai,,0,0,0,, Kemudian hentikan, sudah.
Dialog: 0,0:13:22.96,0:13:25.23,Lalai,,0,0,0,,- Apa?\N- Berhenti menghubunginya.
Dialog: 0,0:13:25.26,0:13:26.79,Lalai,,0,0,0,,Okey.
Dialog: 0,0:13:44.74,0:13:45.71,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Panggilan Terlepas\NFather{\c}{\i0}
Dialog: 0,0:13:50.07,0:13:52.69,Lalai,,0,0,0,,Apa? Apa yang berlaku?
Dialog: 0,0:13:53.66,0:13:55.26, Lalai,,0,0,0,,Hei.
Dialog: 0,0:13:55.29,0:13:57.71, Lalai,,0,0,0,,- Awak dah bangun.\N- Apa yang awak dah buat pada saya?
Dialog: 0,0:13:57.73,0:13:58.73, Lalai,,0,0,0,,Apakah ini?
Dialog: 0,0:13:58.75,0:14:01.23, Lalai,,0,0,0,,Aduh, bisingnya awak. Tidur balik, okay?
Dialog: 0,0:14:01.25,0:14:06.25,Lalai,,0,0,0,,Saya akan menyalakan briket untuk\Nmemastikan anda semasa anda tidur.
Dialog: 0,0:14:22.11,0:14:23.81, Lalai,,0,0,0,,Mengapa kita di sini?
Dialog: 0,0:14:24.15,0:14:28.44,Lalai,,0,0,0,,- Saya nak jumpa datuk saya.\N- Awak basah dan sejuk. tukar dulu,
Dialog: 0,0:14:28.57,0:14:30.31, Lalai,,0,0,0,,dan mari makan.
Dialog: 0,0:14:32.03,0:14:33.34, Lalai,,0,0,0,,Bukan itu sebab saya di sini.
Dialog: 0,0:14:33.37,0:14:35.74,Lalai,,0,0,0,,Itu sebab saya bawa awak ke sini.
Dialog: 0,0:14:37.41,0:14:39.77, Lalai,,0,0,0,,Berganti pakaian dan makan bersama saya.
Dialog: 0,0:14:39.79,0:14:41.95, Lalai,,0,0,0,, Kemudian anda boleh melihatnya.
Dialog: 0,0:15:01.60,0:15:04.71, Lalai,,0,0,0,,- Adakah stik hampir siap?\N- Ya, tuan. Saya membuat salad {\i1}yuzu{\i0}.
Dialog: 0,0:15:04.73,0:15:06.59,Lalai,,0,0,0,,Itu kegemarannya.
Dialog: 0,0:15:06.61,0:15:09.46, Lalai,,0,0,0,,Baik. Saya akan memilih wain.
Dialog: 0,0:15:09.49,0:15:11.56,Lalai,,0,0,0,,Bagi plat...
Dialog: 0,0:15:13.57,0:15:14.59, Lalai,,0,0,0,, Yang ini.
Dialog: 0,0:15:14.62,0:15:16.57, Lalai,,0,0,0,,- Okay.\N- Dan untuk wain...
Dialog: 0,0:15:19.12,0:15:20.66, Lalai,,0,0,0,,Gunakan ini.
Dialog: 0,0:15:42.23,0:15:43.35,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}En. Pyeon{\c}{\i0}
Dialog: 0,0:15:45.44,0:15:47.93,Lalai,,0,0,0,,- Apa itu?\N- Saya singkirkan Encik Baek.
Dialog: 0,0:15:50.03,0:15:52.60,Lalai,,0,0,0,,- Adakah anda pasti?\N- Ya. Apa yang perlu saya lakukan sekarang?
Dialog: 0,0:15:53.49,0:15:55.38, Lalai,,0,0,0,,Jangan hubungi saya, dan baring rendah buat masa ini.
Dialog: 0,0:15:55.41,0:15:57.54,Lalai,,0,0,0,,- {\i1}Wang dan tiket kapal terbang?{\i0}\N- Anda akan dapat,
Dialog: 0,0:15:57.56,0:16:00.51,Lalai,,0,0,0,,tetapi mereka akan mengesyaki kita jika\Nkita berjumpa atau saya membayar kamu sekarang.
Dialog: 0,0:16:00.54,0:16:02.45, Lalai,,0,0,0,,Tunggu sehingga saya menghubungi awak.
Dialog: 0,0:16:04.25,0:16:06.59,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan{\c}{\i0}
Dialog: 0,0:16:21.27,0:16:23.70, Lalai,,0,0,0,,Keluarkan lebih banyak bunga.
Dialog: 0,0:16:23.73,0:16:25.43, Lalai,,0,0,0,,Ya, tuan.
Dialog: 0,0:16:31.82,0:16:34.81, Lalai,,0,0,0,,Bagaimanakah rasanya pulang ke rumah?
Dialog: 0,0:16:35.49,0:16:38.02, Lalai,,0,0,0,,Rasanya tidak seperti di rumah.
Dialog: 0,0:16:38.74,0:16:40.72,Lalai,,0,0,0,,Ini wain kegemaran anda.
Dialog: 0,0:16:40.74,0:16:42.60, Lalai,,0,0,0,,- Betul?\N- Tidak, terima kasih.
Dialog: 0,0:16:42.62,0:16:44.14,Lalai,,0,0,0,,Adakah anda pasti?
Dialog: 0,0:16:44.16,0:16:46.53, Lalai,,0,0,0,,Stiknya sedap. Cubalah.
Dialog: 0,0:16:46.71,0:16:49.04, Lalai,,0,0,0,,Saya tidak mempunyai selera makan.
Dialog: 0,0:16:49.42,0:16:50.52,Lalai,,0,0,0,,Awak kata awak lapar.
Dialog: 0,0:16:50.55,0:16:52.48,Lalai,,0,0,0,,Saya dulu,
Dialog: 0,0:16:52.51,0:16:54.32, Lalai,,0,0,0,,tetapi tidak lagi.
Dialog: 0,0:16:54.34,0:16:56.21,Lalai,,0,0,0,,Jom pergi sekarang.
Dialog: 0,0:16:57.14,0:16:58.84, Lalai,,0,0,0,, Pergi ke mana?
Dialog: 0,0:17:02.68,0:17:04.62, Lalai,,0,0,0,,Beri saya sedikit masa.
Dialog: 0,0:17:04.64,0:17:07.29, Lalai,,0,0,0,,- Untuk apa?\N- Jadi saya boleh menyelesaikan salah faham.
Dialog: 0,0:17:07.31,0:17:09.18, Lalai,,0,0,0,,Apa salah faham?
Dialog: 0,0:17:10.90,0:17:12.13, Lalai,,0,0,0,,Anda berkata...
Dialog: 0,0:17:12.15,0:17:16.06,Lalai,,0,0,0,,Saya menolak kamu ke dalam parit hanya untuk menyelamatkan kamu,
Dialog: 0,0:17:16.82,0:17:19.07, Lalai,,0,0,0,,tetapi itu tidak benar.
Dialog: 0,0:17:21.54,0:17:23.36, Lalai,,0,0,0,,Adakah anda mengenali ini?
Dialog: 0,0:17:23.50,0:17:25.02, Lalai,,0,0,0,,Apa itu?
Dialog: 0,0:17:25.04,0:17:27.74,Lalai,,0,0,0,,Ia milik anda lama dahulu.
Dialog: 0,0:17:33.71,0:17:36.33, Lalai,,0,0,0,,Mengapa anda memilikinya?
Dialog: 0,0:17:45.81,0:17:46.79,Lalai,,0,0,0,,{\i1}Jangan beritahu saya...{\i0}
Dialog: 0,0:17:46.81,0:17:49.64, Lalai,,0,0,0,,- Itu awak?\N- Memang.
Dialog: 0,0:17:50.52,0:17:53.71,Lalai,,0,0,0,,Adakah itu ketika kita mula-mula bertemu?
Dialog: 0,0:17:53.73,0:17:56.85, Lalai,,0,0,0,,Tidak, sebelum itu.
Dialog: 0,0:17:57.36,0:17:58.90, Lalai,,0,0,0,,Sebelumnya?
Dialog: 0,0:17:58.95,0:18:00.48, Lalai,,0,0,0,,Bila?
Dialog: 0,0:18:10.63,0:18:13.61, Lalai,,0,0,0,,Awaklah yang menyelamatkan saya?
Dialog: 0,0:18:13.63,0:18:16.15,Lalai,,0,0,0,,Ya, sayalah yang menyelamatkan kamu...
Dialog: 0,0:18:16.17,0:18:18.00, Lalai,,0,0,0,,dari lemas pada hari itu.
Dialog: 0,0:18:18.59,0:18:20.25, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:18:21.22,0:18:25.20,Lalai,,0,0,0,,Saya tidak boleh tidur, jadi saya\Nmelihat beberapa album lama.
Dialog: 0,0:18:25.22,0:18:26.28,Lalai,,0,0,0,,Bolehkah saya menyertai anda?
Dialog: 0,0:18:26.31,0:18:29.30, Lalai,,0,0,0,,Sudah tentu. Sila duduk.
Dialog: 0,0:18:33.27,0:18:36.73,Lalai,,0,0,0,,Ya ampun, adakah ini Hyun-woo?
Dialog: 0,0:18:36.78,0:18:38.65, Lalai,,0,0,0,,Ya.
Dialog: 0,0:18:39.99,0:18:42.84,Lalai,,0,0,0,,Astaga, dia sentiasa kacak.
Dialog: 0,0:18:42.87,0:18:46.43,Lalai,,0,0,0,,Dia. Tidak semua orang tahu namanya,
Dialog: 0,0:18:46.45,0:18:48.43,Lalai,,0,0,0,,tetapi mereka semua mengenali anak lelaki yang comel itu...
Dialog: 0,0:18:48.46,0:18:50.28, Lalai,,0,0,0,,rumah pokok pir.
Dialog: 0,0:18:50.42,0:18:53.23,Lalai,,0,0,0,,Anda dikurniakan seorang anak lelaki yang kacak dan bijak.
Dialog: 0,0:18:53.25,0:18:57.07, Lalai,,0,0,0,,Ya. Dia juga pandai bertinju dan berenang.
Dialog: 0,0:18:57.09,0:18:59.23,Lalai,,0,0,0,,Betul. Tengok sini.
Dialog: 0,0:18:59.26,0:19:01.53,Lalai,,0,0,0,,Dia juga pergi ke Kem Kor Marin kanak-kanak.
Dialog: 0,0:19:01.55,0:19:05.09,Lalai,,0,0,0,,Dia pernah menyelamatkan seorang kanak-kanak daripada lemas.
Dialog: 0,0:19:12.56,0:19:14.26, Lalai,,0,0,0,,Apakah itu?
Dialog: 0,0:19:14.52,0:19:16.06, Lalai,,0,0,0,,Saya rasa...
Dialog: 0,0:19:16.32,0:19:19.46, Lalai,,0,0,0,,Saya mengenali pantai ini.
Dialog: 0,0:19:19.49,0:19:21.05,Lalai,,0,0,0,,{\i1}Mengapa anda berada di sana?{\i0}
Dialog: 0,0:19:21.07,0:19:24.18, Lalai,,0,0,0,,Untuk berjumpa dengan ibu saya. Itulah\Napabila saya melihat awak lemas.
Dialog: 0,0:19:24.20,0:19:26.59, Lalai,,0,0,0,,- Betulkah?\N- Ya.
Dialog: 0,0:19:26.62,0:19:31.95,Lalai,,0,0,0,,Saya adalah orang yang bertemu dengan kamu dan\Nmemupuk perasaan untuk kamu dahulu.
Dialog: 0,0:19:36.71,0:19:38.41, Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,0:19:39.13,0:19:41.29,Lalai,,0,0,0,,Anda sepatutnya memberitahu saya.
Dialog: 0,0:19:41.76,0:19:45.82,Lalai,,0,0,0,,Ibu saya tinggalkan saya di\rumah anak yatim Nan untuk merahsiakannya,
Dialog: 0,0:19:45.85,0:19:48.78, Lalai,,0,0,0,,jadi saya tidak dapat berkata apa-apa.
Dialog: 0,0:19:48.81,0:19:51.89, Lalai,,0,0,0,,- Mesti susah.\N- Memang, jadi...
Dialog: 0,0:19:53.10,0:19:54.93, Lalai,,0,0,0,,makan dengan saya.
Dialog: 0,0:19:55.94,0:19:58.17,Lalai,,0,0,0,,Saya selalu teringin nak makan dengan awak...
Dialog: 0,0:19:58.19,0:19:59.46, Lalai,,0,0,0,,pada jadual ini.
Dialog: 0,0:19:59.48,0:20:03.56,Lalai,,0,0,0,,Hyun-woo dengan berat hati makan dengan kamu setiap hari,
Dialog: 0,0:20:03.61,0:20:06.23, Lalai,,0,0,0,,tetapi ini selalu menjadi keinginan saya,
Dialog: 0,0:20:08.04,0:20:11.24, Lalai,,0,0,0,,jadi jangan pandang saya begitu.
Dialog: 0,0:20:14.00,0:20:15.53,Lalai,,0,0,0,,Jom makan.
Dialog: 0,0:20:36.81,0:20:39.18, Lalai,,0,0,0,,- Betulkah itu dia?\N- Astaga.
Dialog: 0,0:20:43.95,0:20:46.61, Lalai,,0,0,0,,Izinkan saya meluangkan masa bersamanya.
Dialog: 0,0:21:15.35,0:21:17.05, Lalai,,0,0,0,,Atuk.
Dialog: 0,0:21:17.31,0:21:18.85, Lalai,,0,0,0,,Adakah anda...
Dialog: 0,0:21:19.23,0:21:21.02, Lalai,,0,0,0,,kenali saya?
Dialog: 0,0:21:26.74,0:21:27.92, Lalai,,0,0,0,,Adakah anda sudah gila?
Dialog: 0,0:21:27.95,0:21:30.90, Lalai,,0,0,0,,Beraninya awak biarkan dia masuk? Adakah dia di sana seorang diri?
Dialog: 0,0:21:31.16,0:21:33.51, Lalai,,0,0,0,,- Biarkan dia sahaja.\N- Adakah anda seorang wali?
Dialog: 0,0:21:33.54,0:21:36.18, Lalai,,0,0,0,,Dia memalukan anda di hadapan semua orang.
Dialog: 0,0:21:36.21,0:21:37.43, Lalai,,0,0,0,,Alih!
Dialog: 0,0:21:37.46,0:21:39.77, Lalai,,0,0,0,,Dia bersama seorang kakek yang tidak waras.
Dialog: 0,0:21:39.79,0:21:42.16, Lalai,,0,0,0,,- Apa yang boleh berlaku?\N- Lepaskan.
Dialog: 0,0:21:49.89,0:21:51.91, Lalai,,0,0,0,,- Sudah lama.\N- Saya rasa.
Dialog: 0,0:21:51.93,0:21:53.66,Lalai,,0,0,0,,- Sudah sebulan?\N- Saya dengar.
Dialog: 0,0:21:53.68,0:21:56.62,Lalai,,0,0,0,,Saya minta maaf awak sakit pada usia yang begitu muda.
Dialog: 0,0:21:56.64,0:21:58.34,Lalai,,0,0,0,,Itulah sebabnya saya melawat datuk saya,
Dialog: 0,0:21:58.36,0:22:00.50,Lalai,,0,0,0,,- kerana saya mungkin mati pada bila-bila masa.\N- Hae-in.
Dialog: 0,0:22:00.52,0:22:03.42, Lalai,,0,0,0,,Apa yang anda cuba cari\Nout semasa anda hampir mati?
Dialog: 0,0:22:03.44,0:22:05.89, Lalai,,0,0,0,,Apa yang awak takut saya tahu?
Dialog: 0,0:22:05.94,0:22:09.42, Lalai,,0,0,0,,Inilah sebabnya dia\Memberi kepercayaan kepada saya dengan segala-galanya.
Dialog: 0,0:22:09.45,0:22:12.41,Lalai,,0,0,0,,Dia takut keluarganya akan\Nskema sesuatu pada masa seperti ini,
Dialog: 0,0:22:12.43,0:22:14.32,Lalai,,0,0,0,,- dan hanya mempercayai saya!\N- Cakap sesuka hati.
Dialog: 0,0:22:14.35,0:22:16.31,Lalai,,0,0,0,,Kami berdua tahu...
Dialog: 0,0:22:16.33,0:22:17.93, Lalai,,0,0,0,,- awak bohong.\N- Apa?
Dialog: 0,0:22:17.96,0:22:22.65,Lalai,,0,0,0,,Anda hanya mempunyai kuasa\Nattorney selagi dia masih hidup,
Dialog: 0,0:22:22.67,0:22:23.81, Lalai,,0,0,0,,jadi saya percaya...
Dialog: 0,0:22:23.84,0:22:27.42, Lalai,,0,0,0,, bahawa anda akan menjaganya dengan baik.
Dialog: 0,0:22:28.93,0:22:31.07, Lalai,,0,0,0,,Sejak bila awak ambil berat?
Dialog: 0,0:22:31.09,0:22:34.05,Lalai,,0,0,0,,Semua yang keluarga anda lakukan hanyalah bergaduh kerana wang.
Dialog: 0,0:22:34.89,0:22:38.16,Lalai,,0,0,0,,Saya tahu, tetapi keluarga kami menderita terima kasih kepada anda,
Dialog: 0,0:22:38.19,0:22:41.68, Lalai,,0,0,0,,dan kini kami menjadi agak rapat,
Dialog: 0,0:22:41.98,0:22:44.27, Lalai,,0,0,0,,tetapi saya tidak bersyukur.
Dialog: 0,0:22:45.40,0:22:47.14,Lalai,,0,0,0,,Saya akan kembali tidak lama lagi.
Dialog: 0,0:22:50.78,0:22:52.93, Lalai,,0,0,0,,- Jangan pergi.\N- Lepaskan saya.
Dialog: 0,0:22:52.95,0:22:54.57, Lalai,,0,0,0,,Apa yang anda akan lakukan?
Dialog: 0,0:23:39.58,0:23:41.70, Lalai,,0,0,0,,Di manakah pintu pagar utama?
Dialog: 0,0:23:42.25,0:23:44.24,Lalai,,0,0,0,,Pintu utama...
Dialog: 0,0:24:51.69,0:24:53.23, Lalai,,0,0,0,, Hae-in.
Dialog: 0,0:25:02.45,0:25:03.99,Lalai,,0,0,0,,Adakah anda okey?
Dialog: 0,0:25:06.92,0:25:08.62, Lalai,,0,0,0,,Apa yang salah?
Dialog: 0,0:25:15.84,0:25:17.54,Lalai,,0,0,0,,Hyun-woo?
Dialog: 0,0:25:18.51,0:25:19.57,Lalai,,0,0,0,,Adakah itu anda?
Dialog: 0,0:25:19.60,0:25:22.21, Lalai,,0,0,0,,Ya, ini saya.
Dialog: 0,0:25:22.72,0:25:24.51, Lalai,,0,0,0,,Ada apa?
Dialog: 0,0:25:28.77,0:25:29.75, Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:25:29.77,0:25:32.27,Lalai,,0,0,0,,Adakah anda dipukul lagi?
Dialog: 0,0:25:37.16,0:25:39.18, Lalai,,0,0,0,,Berapa kali perlu saya beritahu anda?
Dialog: 0,0:25:39.20,0:25:41.86, Lalai,,0,0,0,,Saya tidak dipukul.
Dialog: 0,0:25:42.95,0:25:45.45,Lalai,,0,0,0,,Saya juga boleh mengendalikan tiga lelaki sekaligus.
Dialog: 0,0:26:00.26,0:26:02.67, Lalai,,0,0,0,,Oleh kerana kamu sombong,
Dialog: 0,0:26:03.39,0:26:05.22,Lalai,,0,0,0,,anda mestilah Hyun-woo.
Dialog: 0,0:26:26.58,0:26:28.53, Lalai,,0,0,0,,Boleh awak maafkan saya?
Dialog: 0,0:26:36.46,0:26:38.69, Lalai,,0,0,0,,Apa yang berlaku? Saya fikir anda telah menyingkirkan dia.
Dialog: 0,0:26:38.72,0:26:41.20,Lalai,,0,0,0,,Tepat sekali. Anda tidak sepatutnya berbuat demikian.
Dialog: 0,0:26:41.22,0:26:42.24, Lalai,,0,0,0,,Selesai apa?
Dialog: 0,0:26:42.26,0:26:44.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Ayuh.\N- Semak dahulu.{\c}{\i0}
Dialog: 0,0:26:44.31,0:26:46.08, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa?\N- Anda boleh bunuh saya...{\c}{\i0}
Dialog: 0,0:26:46.10,0:26:49.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}selepas lima minit, dan\Nit tidak akan membuat perbezaan,{\c}{\i0}
Dialog: 0,0:26:49.48,0:26:52.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi hubungi orang yang mengupah anda untuk membunuh saya,{\c}{\i0}
Dialog: 0,0:26:52.19,0:26:55.81, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan lihat jika mereka menepati janji mereka.{\c}{\i0}
Dialog: 0,0:27:08.50,0:27:10.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya telah menyingkirkan Encik Baek.{\c}{\i0}
Dialog: 0,0:27:10.04,0:27:12.18, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Adakah anda pasti?\N- Ya. Apakah yang perlu saya lakukan sekarang?{\c}{\i0}
Dialog: 0,0:27:12.21,0:27:13.73, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan hubungi saya dan berdiam diri buat masa ini.{\c}{\i0}
Dialog: 0,0:27:13.75,0:27:15.89, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Wang dan tiket kapal terbang?\N- Anda akan dapat,{\c}{\i0}
Dialog: 0,0:27:15.91,0:27:18.19, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi mereka akan mengesyaki kami jika\Nkami bertemu atau saya membayar anda sekarang.{\c}{\i0}
Dialog: 0,0:27:18.21,0:27:19.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tunggu sehingga saya memanggil anda.{\c}{\i0}
Dialog: 0,0:27:19.63,0:27:21.96, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Helo? Tunggu, dengar...{\c}{\i0}
Dialog: 0,0:27:22.26,0:27:23.79,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Dash it.{\c}{\i0}
Dialog: 0,0:27:24.01,0:27:25.03, Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}En. Yoon Eun-sung 2{\c}{\i0}
Dialog: 0,0:27:25.81,0:27:28.74,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Nombor yang anda dail tidak tersedia...{\c}{\i0}
Dialog: 0,0:27:28.77,0:27:32.05, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Bajingan ini.{\c}{\i0}
Dialog: 0,0:27:36.78,0:27:39.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda hanya penipu hartanah buat masa ini,{\c}{\i0}
Dialog: 0,0:27:39.44,0:27:41.36,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi anda akan menjadi pembunuh sebaik sahaja anda membunuh saya.{\c}{\i0}
Dialog: 0,0:27:41.38,0:27:42.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan tarik satu pada saya.{\c}{\i0}
Dialog: 0,0:27:42.82,0:27:45.84,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Polis masih menyiasat\Kes serangan anda terhadap saya,{\c}{\i0}
Dialog: 0,0:27:45.87,0:27:49.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi jika saya mati, kes itu akan bertukar menjadi pembunuhan.{\c}{\i0}
Dialog: 0,0:27:49.16,0:27:51.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda akan menjadi suspek,{\c}{\i0}
Dialog: 0,0:27:51.16,0:27:53.35, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan dapatkan hukuman tambahan kerana merancangnya.{\c}{\i0}
Dialog: 0,0:27:53.38,0:27:55.56,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kemudian Interpol akan meletakkan anda pada Notis Merah mereka,{\c}{\i0}
Dialog: 0,0:27:55.59,0:27:57.75, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}senarai dikehendaki tertinggi mereka.{\c}{\i0}
Dialog: 0,0:27:58.13,0:28:00.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya suruh awak diam.{\c}{\i0}
Dialog: 0,0:28:00.96,0:28:05.28,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda akan mendapat sekurang-kurangnya 20 tahun untuk\Nmerancang pembunuhan balas dendam dan melarikan diri,{\c}{\i0}
Dialog: 0,0:28:05.30,0:28:08.63,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi jika anda tidak membunuh saya,{\c}{\i0}
Dialog: 0,0:28:08.81,0:28:11.37, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}anda hanya akan mendapat tiga tahun untuk penipuan.{\c}{\i0}
Dialog: 0,0:28:11.39,0:28:16.00,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda juga boleh mendapatkan percubaan jika saya meyakinkan\Npemilik tanah untuk menyelesaikan kes itu.{\c}{\i0}
Dialog: 0,0:28:16.02,0:28:19.17, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jadi? Saya akan ketepikan semuanya jika anda berhenti di sini.{\c}{\i0}
Dialog: 0,0:28:19.19,0:28:21.25,Lalai,,0,0,0,,Jadi awak biarkan dia pergi?
Dialog: 0,0:28:21.28,0:28:23.38,Lalai,,0,0,0,,- Awak bodoh?\N- Ya, saya dulu.
Dialog: 0,0:28:23.41,0:28:24.67, Lalai,,0,0,0,,{\i1}Bayar saya sekarang,{\i0}
Dialog: 0,0:28:24.70,0:28:28.94,Lalai,,0,0,0,, atau saya akan beritahu polis anda\N adalah orang yang mengupah saya.
Dialog: 0,0:28:37.17,0:28:40.20, Lalai,,0,0,0,,Di sinilah saya menginap.
Dialog: 0,0:28:58.61,0:29:00.56,Lalai,,0,0,0,,Astaga, awak mengejutkan saya!
Dialog: 0,0:29:05.53,0:29:06.80, Lalai,,0,0,0,,Tidak mengapa. Jangan bersihkan.
Dialog: 0,0:29:06.82,0:29:09.57, Lalai,,0,0,0,,Saya terlalu sibuk.
Dialog: 0,0:29:12.54,0:29:15.74,Lalai,,0,0,0,,Saya tertanya-tanya di mana awak\Nmenginap selepas bercerai.
Dialog: 0,0:29:15.79,0:29:17.49, Lalai,,0,0,0,,Anda berada di sini.
Dialog: 0,0:29:18.00,0:29:19.54,Lalai,,0,0,0,,Nah...
Dialog: 0,0:29:20.13,0:29:22.33, Lalai,,0,0,0,,Adakah ia tidak selesa?
Dialog: 0,0:29:23.34,0:29:24.87, Lalai,,0,0,0,,Nah...
Dialog: 0,0:29:25.43,0:29:28.00, Lalai,,0,0,0,,Tidak, ia adalah tempat yang bagus.
Dialog: 0,0:29:28.34,0:29:31.09, Lalai,,0,0,0,,Ia baru dibina dan dilengkapi sepenuhnya.
Dialog: 0,0:29:42.57,0:29:44.30,Lalai,,0,0,0,,Kenapa awak tidur di atas sofa?
Dialog: 0,0:29:44.32,0:29:46.19,Lalai,,0,0,0,,Nah...
Dialog: 0,0:29:47.11,0:29:49.61, Lalai,,0,0,0,,Anda tahu saya tidur lena.
Dialog: 0,0:29:49.70,0:29:52.69, Lalai,,0,0,0,,Saya boleh tidur...
Dialog: 0,0:29:52.79,0:29:54.95, Lalai,,0,0,0,, di mana sahaja saya meletakkan kepala saya.
Dialog: 0,0:29:55.46,0:29:58.27,Lalai,,0,0,0,,Saya rasa anda boleh tidur lena...
Dialog: 0,0:29:58.29,0:30:01.20,Lalai,,0,0,0,,selepas kita bercerai, tidak seperti saya.
Dialog: 0,0:30:01.34,0:30:03.27,Lalai,,0,0,0,,- Apa?\N- Adalah impian anda untuk bercerai.
Dialog: 0,0:30:03.30,0:30:06.69, Lalai,,0,0,0,,Sekarang ia menjadi kenyataan,\Anda pasti telah menemui kedamaian...
Dialog: 0,0:30:06.72,0:30:08.78, Lalai,,0,0,0,,di tempat yang baru dibina dan serba lengkap ini.
Dialog: 0,0:30:08.80,0:30:10.78, Lalai,,0,0,0,,Bukan itu yang saya maksudkan.
Dialog: 0,0:30:10.80,0:30:13.87, Lalai,,0,0,0,,Tidak mengapa. Sekurang-kurangnya salah seorang daripada kami\Ngembira selepas bercerai.
Dialog: 0,0:30:13.89,0:30:15.47, Lalai,,0,0,0,,Saya gembira.
Dialog: 0,0:30:18.48,0:30:20.87, Lalai,,0,0,0,,Saya langsung tidak selesa.
Dialog: 0,0:30:20.90,0:30:25.00, Lalai,,0,0,0,,Tempat ini membuatkan saya sakit\Nsindrom, jadi saya mengalami sakit kepala,
Dialog: 0,0:30:25.03,0:30:29.17, Lalai,,0,0,0,,dan lihat. Ruang tamu\Nis betul-betul di sebelah dapur,
Dialog: 0,0:30:29.20,0:30:32.18,Lalai,,0,0,0,,jadi bukan mudah untuk menyiarkan tempat ini,
Dialog: 0,0:30:32.20,0:30:33.73, Lalai,,0,0,0,,dan yang paling penting,
Dialog: 0,0:30:34.99,0:30:36.53, Lalai,,0,0,0,,anda tiada di sini.
Dialog: 0,0:30:42.96,0:30:44.36,Lalai,,0,0,0,,Bukankah itu lebih baik untuk anda?
Dialog: 0,0:30:44.38,0:30:45.48,Lalai,,0,0,0,,Tidak sama sekali.
Dialog: 0,0:30:45.51,0:30:48.73, Lalai,,0,0,0,,Ada kalanya, saya terfikir bagaimana perasaannya...
Dialog: 0,0:30:48.76,0:30:51.59,Lalai,,0,0,0,,jika kita pernah tinggal di sini sebagai pengantin baru.
Dialog: 0,0:30:51.85,0:30:55.63,Lalai,,0,0,0,,Alangkah bagus untuk\Ndiam di tempat kecil seperti ini,
Dialog: 0,0:30:56.10,0:30:59.47,Lalai,,0,0,0,,walaupun selepas bertengkar sesama sendiri.
Dialog: 0,0:31:03.77,0:31:06.68, Lalai,,0,0,0,,Fikiran saya akan melayang begitu,
Dialog: 0,0:31:07.24,0:31:09.27,Lalai,,0,0,0,,dan saya akan merindui awak.
Dialog: 0,0:31:10.45,0:31:12.23, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:31:20.17,0:31:21.14, Lalai,,0,0,0,,Saya lapar.
Dialog: 0,0:31:21.17,0:31:25.58,Lalai,,0,0,0,,Betulkah? Saya akan masakkan awak sesuatu. Berehatlah.
Dialog: 0,0:32:46.71,0:32:47.77, Lalai,,0,0,0,,Ini kelihatan bagus.
Dialog: 0,0:32:47.79,0:32:49.83,Lalai,,0,0,0,,Jom makan.
Dialog: 0,0:33:04.31,0:33:06.26, Lalai,,0,0,0,,Awak memang bagus.
Dialog: 0,0:33:06.48,0:33:08.64, Lalai,,0,0,0,,Kenapa awak tak pernah masak?
Dialog: 0,0:33:08.77,0:33:10.64, Lalai,,0,0,0,,Saya tidak pernah berpeluang.
Dialog: 0,0:33:18.37,0:33:19.84,Lalai,,0,0,0,,By the way...
Dialog: 0,0:33:19.87,0:33:22.40,Lalai,,0,0,0,,Adakah anda akan melihat wanita lain selepas saya mati?
Dialog: 0,0:33:25.62,0:33:26.68,Lalai,,0,0,0,,Apa?
Dialog: 0,0:33:26.71,0:33:30.40,Lalai,,0,0,0,,Adakah anda akan tinggal bersama seseorang di\N tempat kecil ini, walaupun selepas bertengkar?
Dialog: 0,0:33:30.42,0:33:34.16,Lalai,,0,0,0,,Adakah anda akan membuatnya rebus dan hidup bahagia...
Dialog: 0,0:33:34.34,0:33:36.13, Lalai,,0,0,0,,selepas itu?
Dialog: 0,0:33:37.01,0:33:38.88, Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:33:39.30,0:33:41.05, Lalai,,0,0,0,,Makan sahaja.
Dialog: 0,0:33:42.14,0:33:43.99,Lalai,,0,0,0,,Jawab saya.
Dialog: 0,0:33:44.02,0:33:45.62,Lalai,,0,0,0,,Jangan tukar subjek lagi.
Dialog: 0,0:33:45.64,0:33:47.45,Lalai,,0,0,0,,Adakah anda mahu mati sebelum saya?
Dialog: 0,0:33:47.48,0:33:49.08, Lalai,,0,0,0,,Anda terlalu risau.
Dialog: 0,0:33:49.11,0:33:50.54, Lalai,,0,0,0,,Siapa nak dating dengan saya?
Dialog: 0,0:33:50.57,0:33:54.42,Lalai,,0,0,0,,Semua orang fikir awak selamatkan saya,\Nkerana awak jatuh cinta tanpa daya.
Dialog: 0,0:33:54.44,0:33:56.63,Lalai,,0,0,0,,Mereka juga mengkritik\N saya kerana tidak mengetahuinya,
Dialog: 0,0:33:56.65,0:33:58.38, Lalai,,0,0,0,,dan meninggalkan anda,
Dialog: 0,0:33:58.41,0:33:59.84,Lalai,,0,0,0,,jadi perempuan macam mana...?
Dialog: 0,0:33:59.87,0:34:03.03,Lalai,,0,0,0,,Wanita jenis apa yang tidak mahu dating dengan awak?
Dialog: 0,0:34:04.29,0:34:06.85,Lalai,,0,0,0,,Awak kacak, baik hati,
Dialog: 0,0:34:06.87,0:34:08.93,Lalai,,0,0,0,,pintar, tetapi tidak sombong.
Dialog: 0,0:34:08.96,0:34:12.29, Lalai,,0,0,0,,Selain itu, anda seorang tukang masak yang mahir.
Dialog: 0,0:34:12.92,0:34:14.87,Lalai,,0,0,0,,Tiada lelaki seperti kamu.
Dialog: 0,0:34:15.42,0:34:18.61,Lalai,,0,0,0,,Walaupun saya dilahirkan semula seratus\Nkali, saya tetap akan berkahwin dengan awak...
Dialog: 0,0:34:18.63,0:34:20.54, Lalai,,0,0,0,,setiap masa.
Dialog: 0,0:34:31.86,0:34:34.25,Lalai,,0,0,0,,Bagaimana anda boleh berkata sedemikian,
Dialog: 0,0:34:34.28,0:34:36.39,Lalai,,0,0,0,,tanpa berkelip...
Dialog: 0,0:34:37.49,0:34:39.05, Lalai,,0,0,0,,mata awak?
Dialog: 0,0:34:39.07,0:34:40.69,Lalai,,0,0,0,,Memang benar,
Dialog: 0,0:34:41.07,0:34:43.06, Lalai,,0,0,0,,jadi mengapa saya teragak-agak?
Dialog: 0,0:34:45.91,0:34:50.20,Lalai,,0,0,0,,Anda tahu bagaimana untuk membuat jantung saya berdegup kencang.
Dialog: 0,0:35:13.40,0:35:15.52, Lalai,,0,0,0,,Adakah anda akhirnya mendapatnya?
Dialog: 0,0:35:16.07,0:35:18.05,Lalai,,0,0,0,,Hae-in tidak mempedulikan kamu.
Dialog: 0,0:35:18.07,0:35:19.84, Lalai,,0,0,0,,Dia sentiasa menggunakan anda.
Dialog: 0,0:35:19.86,0:35:22.19,Lalai,,0,0,0,,Saya sentiasa tahu itu.
Dialog: 0,0:35:22.32,0:35:24.98,Lalai,,0,0,0,,- Namun anda masih membenarkannya?\N- Ya.
Dialog: 0,0:35:25.33,0:35:26.86,Lalai,,0,0,0,,Sudah menjadi kebiasaan.
Dialog: 0,0:35:28.50,0:35:30.49, Lalai,,0,0,0,,Saya selalu digunakan...
Dialog: 0,0:35:30.75,0:35:32.37, Lalai,,0,0,0,, oleh anda juga.
Dialog: 0,0:35:40.72,0:35:45.55,Lalai,,0,0,0,,Awak marahkan saya kerana meninggalkan\Nyou di luar negara, bukan?
Dialog: 0,0:35:46.26,0:35:49.74,Lalai,,0,0,0,,Adakah anda fikir saya tidak tahu\Ibu bapa angkat anda mendera anda,
Dialog: 0,0:35:49.77,0:35:52.75,Lalai,,0,0,0,,walaupun dibayar lumayan?
Dialog: 0,0:35:52.77,0:35:54.21,Lalai,,0,0,0,,Adakah itu satu kebetulan...
Dialog: 0,0:35:54.23,0:35:57.31, Lalai,,0,0,0,, bahawa mereka yang bukan peminum mati semasa memandu dalam keadaan mabuk?
Dialog: 0,0:35:57.86,0:35:59.73, Lalai,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,0:36:00.99,0:36:03.67, Lalai,,0,0,0,,Bagaimana pula dengan rumah anak yatim\Npengarah yang menganiaya anda?
Dialog: 0,0:36:03.70,0:36:08.69, Lalai,,0,0,0,,Mereka ditutup kerana\N kebakaran secara tiba-tiba, dan pengarah meninggal dunia.
Dialog: 0,0:36:09.62,0:36:11.66, Lalai,,0,0,0,,Adakah itu satu kebetulan?
Dialog: 0,0:36:16.25,0:36:17.81,Lalai,,0,0,0,,Saya tidak pernah mengabaikan awak.
Dialog: 0,0:36:17.84,0:36:21.78,Lalai,,0,0,0,,Saya tidak hanya duduk di atas tangan saya apabila\Norang itu menyebabkan anda sakit,
Dialog: 0,0:36:21.80,0:36:23.90,Lalai,,0,0,0,,atau menghalang anda,
Dialog: 0,0:36:23.93,0:36:25.15, Lalai,,0,0,0,, dan itu tidak berubah.
Dialog: 0,0:36:25.18,0:36:27.03, Lalai,,0,0,0,,Menjadi pengerusi tidak mencukupi.
Dialog: 0,0:36:27.05,0:36:31.08,Lalai,,0,0,0,,Adalah matlamat saya untuk menjadikan segala-galanya milik anda,
Dialog: 0,0:36:31.10,0:36:33.30, Lalai,,0,0,0,, dan saya tidak akan duduk diam...
Dialog: 0,0:36:34.15,0:36:36.14,Lalai,,0,0,0,,jika ada sesiapa yang menghalang saya,
Dialog: 0,0:36:36.23,0:36:38.68,Lalai,,0,0,0,,sama ada Hae-in atau orang lain.
Dialog: 0,0:36:39.19,0:36:42.56,Lalai,,0,0,0,,Awak faham? Ini cara saya mencintai awak.
Dialog: 0,0:36:45.62,0:36:47.84,Lalai,,0,0,0,,Jika anda benar-benar mencintainya,
Dialog: 0,0:36:47.87,0:36:51.15,Lalai,,0,0,0,,dan tidak mahu dia terluka,
Dialog: 0,0:36:52.16,0:36:56.78, Lalai,,0,0,0,, maka jangan biarkan dia menggunakan anda.\NI tidak akan bertahan.
Dialog: 0,0:37:00.38,0:37:01.40,Lalai,,0,0,0,,Ayuh.
Dialog: 0,0:37:01.42,0:37:03.96, Lalai,,0,0,0,,Bagaimana anda boleh cedera lagi?
Dialog: 0,0:37:05.38,0:37:06.40, Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:37:06.43,0:37:09.25,Lalai,,0,0,0,,Saya sudah beritahu anda.
Dialog: 0,0:37:09.35,0:37:11.99, Lalai,,0,0,0,,Ia adalah kemalangan kereta kecil.
Dialog: 0,0:37:12.02,0:37:15.58, Lalai,,0,0,0,,Fikiran saya tidak berada di sana semasa saya memandu.
Dialog: 0,0:37:15.60,0:37:18.56,Lalai,,0,0,0,,Betul, adakah kamu sempat berjumpa dengan datuk kamu?
Dialog: 0,0:37:19.32,0:37:22.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Atuk, adakah kamu mengenali saya?{\c}{\i0}
Dialog: 0,0:37:25.40,0:37:29.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Cik, saya lapar.{\c}{\i0}
Dialog: 0,0:37:33.32,0:37:35.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Atuk...{\c}{\i0}
Dialog: 0,0:37:42.67,0:37:44.41,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Atuk.{\c}{\i0}
Dialog: 0,0:37:44.44,0:37:46.78,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tiada masa.{\c}{\i0}
Dialog: 0,0:37:50.81,0:37:53.37,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda ingat pen ini?{\c}{\i0}
Dialog: 0,0:37:53.39,0:37:55.30,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda menghadiahkannya kepada saya.{\c}{\i0}
Dialog: 0,0:37:55.56,0:37:58.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Malah anda mengukir huruf awal saya padanya.{\c}{\i0}
Dialog: 0,0:37:58.29,0:38:00.53, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia boleh merakam bunyi.{\c}{\i0}
Dialog: 0,0:38:08.82,0:38:10.22,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan letakkannya di sana,{\c}{\i0}
Dialog: 0,0:38:10.24,0:38:13.39,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jadi jika anda mempunyai apa-apa untuk dikatakan, rekodkannya.{\c}{\i0}
Dialog: 0,0:38:13.41,0:38:15.43,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan kembali tidak lama lagi.{\c}{\i0}
Dialog: 0,0:38:15.45,0:38:17.52,Lalai,,0,0,0,,{\i1}Dia akan mengenali pena sebaik sahaja dia datang...{\i0}
Dialog: 0,0:38:17.54,0:38:18.64, Lalai,,0,0,0,,pada derianya.
Dialog: 0,0:38:18.67,0:38:20.94, Lalai,,0,0,0,,Dia mendapatkannya yang dibuat khas dan menghadiahkannya kepada saya...
Dialog: 0,0:38:20.96,0:38:22.35, Lalai,,0,0,0,,semasa saya menjadi CEO.
Dialog: 0,0:38:22.38,0:38:24.54,Lalai,,0,0,0,,Ia hanya kita yang tahu.
Dialog: 0,0:38:29.72,0:38:31.57,Lalai,,0,0,0,,Apa yang Hae-in cakap?
Dialog: 0,0:38:31.60,0:38:34.55,Lalai,,0,0,0,,Saya pasti dia bertanya tentang tabung rahsia.
Dialog: 0,0:38:35.10,0:38:37.74,Lalai,,0,0,0,,Mengapa anda perlu menyembunyikan\Nit dan membuat kami semua menderita?
Dialog: 0,0:38:37.77,0:38:41.81,Lalai,,0,0,0,,Anda sepatutnya telah memindahkannya kepada saya,\Jika itu adalah rancangan anda selama ini.
Dialog: 0,0:38:42.06,0:38:44.21, Lalai,,0,0,0,,Apa yang anda akan lakukan? Bawa bersama anda apabila anda mati?
Dialog: 0,0:38:44.23,0:38:45.54,Lalai,,0,0,0,,Bodoh.
Dialog: 0,0:38:45.57,0:38:50.27,Lalai,,0,0,0,,Anda tidak boleh mati. Anda hanya hampir\Nalive kerana wang itu!
Dialog: 0,0:39:04.80,0:39:06.36, Lalai,,0,0,0,,Adakah anda pasti anda sudah selesai?
Dialog: 0,0:39:06.38,0:39:07.86,Lalai,,0,0,0,,Adakah Hae-in memberitahu kamu?
Dialog: 0,0:39:07.88,0:39:10.94, Lalai,,0,0,0,,Dia akan mati tidak lama lagi.
Dialog: 0,0:39:10.97,0:39:14.34, Lalai,,0,0,0,,Dia mempunyai kes tumor otak yang jarang berlaku dan tidak akan hidup lama.
Dialog: 0,0:39:15.43,0:39:18.55, Lalai,,0,0,0,,Lihat apa yang berlaku kepada Hong Man-dae yang hebat.
Dialog: 0,0:39:18.93,0:39:22.15, Lalai,,0,0,0,,Anda tidak boleh memproses fakta bahawa\Nyucu kesayangan anda sedang nazak.
Dialog: 0,0:39:22.18,0:39:24.00,Lalai,,0,0,0,,Memberikan kepada anda dengan betul.
Dialog: 0,0:39:51.88,0:39:53.65,Lalai,,0,0,0,,Saya kuat.
Dialog: 0,0:39:53.68,0:39:55.24,Lalai,,0,0,0,,Saya yang terbaik.
Dialog: 0,0:39:55.26,0:39:57.74, Lalai,,0,0,0,,Saya orang gila.
Dialog: 0,0:39:57.77,0:40:01.59,Lalai,,0,0,0,,Saya benar-benar gila. saya...
Dialog: 0,0:40:08.23,0:40:11.31,Lalai,,0,0,0,,Saya lelaki yang kuat...
Dialog: 0,0:40:20.70,0:40:22.27, Lalai,,0,0,0,,Bila anda sampai ke sini?
Dialog: 0,0:40:22.29,0:40:25.45, Lalai,,0,0,0,,Saya datang selepas berjoging pagi.
Dialog: 0,0:40:26.21,0:40:28.56, Lalai,,0,0,0,,Anda mengingatkan saya tentang diri saya\Nsemasa saya mula bertinju.
Dialog: 0,0:40:28.59,0:40:30.54,Lalai,,0,0,0,,Saya suka sikap awak ini.
Dialog: 0,0:40:33.22,0:40:34.61, Lalai,,0,0,0,,Dari mana kamu datang?
Dialog: 0,0:40:34.64,0:40:36.45,Lalai,,0,0,0,,Saya menurunkan Ho-yeol di sekolah.
Dialog: 0,0:40:36.47,0:40:38.17, Lalai,,0,0,0,,Oh, ya.
Dialog: 0,0:40:38.89,0:40:40.84,Lalai,,0,0,0,,By the way,
Dialog: 0,0:40:41.39,0:40:43.58,Lalai,,0,0,0,,adakah isteri anda bekerja di tempat yang jauh?
Dialog: 0,0:40:43.60,0:40:46.12,Lalai,,0,0,0,,- Adakah anda hanya bertemu pada hujung minggu?\N- Tidak, kita tinggal bersama.
Dialog: 0,0:40:46.15,0:40:47.96,Lalai,,0,0,0,,Saya faham. Saya tidak pernah bertemu dengannya.
Dialog: 0,0:40:47.98,0:40:49.25,Lalai,,0,0,0,,Anda lihat...
Dialog: 0,0:40:49.28,0:40:51.42,Lalai,,0,0,0,,Ketika kami mula-mula berkahwin,
Dialog: 0,0:40:51.44,0:40:54.26,Lalai,,0,0,0,,ibu saya memberitahunya perkara ini.\N"Anda menantu saya."
Dialog: 0,0:40:54.28,0:40:55.97, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda bukan anak perempuan saya.{\c}{\i0}
Dialog: 0,0:40:55.99,0:40:58.14,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Seorang menantu perempuan tidak boleh menjadi anak perempuan.{\c}{\i0}
Dialog: 0,0:40:58.16,0:41:00.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya memukul Mi-seon.{\c}{\i0}
Dialog: 0,0:41:00.12,0:41:02.20,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ayuh.{\c}{\i0}
Dialog: 0,0:41:02.37,0:41:05.68,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tetapi anda mempunyai ibu bapa anda sendiri,\Nand saya tidak boleh berbuat demikian kepada anda.{\c}{\i0}
Dialog: 0,0:41:05.71,0:41:09.06, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kita harus menonton apa yang kita\Nkatakan dan jangan sekali-kali menjadi fizikal...{\c}{\i0}
Dialog: 0,0:41:09.09,0:41:10.27,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}jika kita mertua.{\c}{\i0}
Dialog: 0,0:41:10.30,0:41:11.77, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, anda betul.{\c}{\i0}
Dialog: 0,0:41:11.80,0:41:13.51,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Sekarang anda sudah berkahwin,{\c}{\i0}
Dialog: 0,0:41:13.53,0:41:15.23,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- mari kita elakkan berjumpa antara satu sama lain.\N- Apa?{\c}{\i0}
Dialog: 0,0:41:15.25,0:41:16.32, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Serius?{\c}{\i0}
Dialog: 0,0:41:16.34,0:41:21.12,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda boleh melawat ibu bapa anda atau pergi\Nperjalanan semasa cuti kebangsaan jika anda mahu.{\c}{\i0}
Dialog: 0,0:41:21.14,0:41:22.53, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Terima kasih.{\c}{\i0}
Dialog: 0,0:41:22.56,0:41:25.45,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan bersusah payah memberikan saya hadiah hari jadi.{\c}{\i0}
Dialog: 0,0:41:25.48,0:41:28.97, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Memang tidak selesa. Jika anda mahu, hantarkan sahaja emoji kepada saya.{\c}{\i0}
Dialog: 0,0:41:30.36,0:41:33.88, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidakkah anda rasa itu terlalu sedikit?{\c}{\i0}
Dialog: 0,0:41:33.90,0:41:36.80, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Diam. Walau bagaimanapun, saya mempunyai satu syarat.{\c}{\i0}
Dialog: 0,0:41:36.82,0:41:39.26,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anak saya mempunyai banyak kelemahan,{\c}{\i0}
Dialog: 0,0:41:39.28,0:41:41.01,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}dan tiada apa yang boleh saya lakukan.{\c}{\i0}
Dialog: 0,0:41:41.04,0:41:43.81,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda boleh cuba membetulkannya,\Ntetapi jangan kembalikan dia kepada saya.{\c}{\i0}
Dialog: 0,0:41:43.83,0:41:45.61,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ayuh, Ibu.{\c}{\i0}
Dialog: 0,0:41:50.17,0:41:52.87, Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Saya akan melakukan yang terbaik.{\c}{\i0}
Dialog: 0,0:41:53.71,0:41:56.03, Lalai,,0,0,0,,Ibu awak sangat santai.
Dialog: 0,0:41:56.05,0:41:58.57,Lalai,,0,0,0,,Terima kasih kepadanya, rakan sekerja isteri saya semua berkata...
Dialog: 0,0:41:58.59,0:42:00.36,Lalai,,0,0,0,,dia mempunyai ibu mertua yang terbaik.
Dialog: 0,0:42:00.39,0:42:02.12, Lalai,,0,0,0,,Saya nampak itu.
Dialog: 0,0:42:02.14,0:42:03.70,Lalai,,0,0,0,,Memandangkan ibu saya melayannya dengan baik,
Dialog: 0,0:42:03.72,0:42:07.00,Lalai,,0,0,0,,isteri saya cenderung untuk mengalihkan\Nbuta mata kepada kebanyakan perkara...
Dialog: 0,0:42:07.02,0:42:08.93, Lalai,,0,0,0,,Saya lakukan.
Dialog: 0,0:42:09.02,0:42:10.85,Lalai,,0,0,0,,Begitulah kita hidup.
Dialog: 0,0:42:15.90,0:42:18.02,Lalai,,0,0,0,,Hei...
Dialog: 0,0:42:18.07,0:42:20.13,Lalai,,0,0,0,,- Saya tidak bermaksud untuk menyombong.\N- Tetapi awak betul.
Dialog: 0,0:42:20.16,0:42:22.36, Lalai,,0,0,0,,Saya tidak sengaja.
Dialog: 0,0:42:23.37,0:42:25.35,Default,,0,0,0,,Awak merajuk? Soo-cheol.
Dialog: 0,0:42:25.37,0:42:27.20,Lalai,,0,0,0,,Dark it.
Dialog: 0,0:42:29.83,0:42:30.81, Lalai,,0,0,0,,Ini dia?
Dialog: 0,0:42:30.83,0:42:34.56,Lalai,,0,0,0,,Saya tahu awak telah mencuri semua karya seni mereka yang mahal...
Dialog: 0,0:42:34.59,0:42:36.40,Lalai,,0,0,0,,- sebelum pergi.\N- Tidak, saya tidak.
Dialog: 0,0:42:36.42,0:42:38.07, Lalai,,0,0,0,,Saya baru ambil beberapa.
Dialog: 0,0:42:38.09,0:42:39.28,Lalai,,0,0,0,,Kemudian saya membeli sebuah apartmen.
Dialog: 0,0:42:39.30,0:42:42.61,Lalai,,0,0,0,,Saya tahu awak mencuri patung\NBuddha emas sebesar ini.
Dialog: 0,0:42:42.64,0:42:44.32, Lalai,,0,0,0,,Tidak, saya tidak.
Dialog: 0,0:42:44.35,0:42:47.18,Lalai,,0,0,0,,Anda tidak menipu saya.
Dialog: 0,0:43:00.78,0:43:02.82, Lalai,,0,0,0,,Geon-u, awak okay?
Dialog: 0,0:43:04.45,0:43:06.57, Lalai,,0,0,0,,Hei, apa yang awak buat?
Dialog: 0,0:43:08.28,0:43:10.49,Lalai,,0,0,0,,Dia adalah kelemahan awak.
Dialog: 0,0:43:11.92,0:43:12.89,Lalai,,0,0,0,,Adakah anda gila?
Dialog: 0,0:43:12.92,0:43:14.98, Lalai,,0,0,0,,Sentuh dia, dan anda mati.
Dialog: 0,0:43:15.00,0:43:17.25,Lalai,,0,0,0,,Di manakah patung itu?
Dialog: 0,0:43:17.92,0:43:19.82,Lalai,,0,0,0,,Saya tahu anda belum menjualnya.
Dialog: 0,0:43:19.84,0:43:23.38,Lalai,,0,0,0,,Saya sudah melihatnya, jadi jangan berbohong kepada saya.
Dialog: 0,0:43:28.31,0:43:30.34, Lalai,,0,0,0,,Ia ada dalam peti besi peribadi.
Dialog: 0,0:43:31.06,0:43:33.26,Lalai,,0,0,0,,Kami akan ke sana pagi esok.
Dialog: 0,0:43:34.94,0:43:37.59,Lalai,,0,0,0,,Okey. bagus.
Dialog: 0,0:43:37.61,0:43:39.35, Lalai,,0,0,0,,Gadis baik.
Dialog: 0,0:43:42.32,0:43:45.73, Lalai,,0,0,0,,Hei, tuangkan saya wain. Okay?
Dialog: 0,0:45:49.16,0:45:50.97,Lalai,,0,0,0,,Adakah anda tidur lena?
Dialog: 0,0:45:50.99,0:45:52.69,Lalai,,0,0,0,,Ya.
Dialog: 0,0:45:54.16,0:45:55.86,Lalai,,0,0,0,,Saya suka tempat ini.
Dialog: 0,0:45:56.37,0:45:59.74,Lalai,,0,0,0,,Saya tertidur serta-merta, sama seperti anda.
Dialog: 0,0:46:03.30,0:46:05.04, Lalai,,0,0,0,,Saya dah beritahu awak.
Dialog: 0,0:46:05.30,0:46:06.78, Lalai,,0,0,0,,Adakah anda mahu tidur lebih lama?
Dialog: 0,0:46:06.80,0:46:08.38, Lalai,,0,0,0,,No.
Dialog: 0,0:46:12.93,0:46:15.43, Lalai,,0,0,0,,Beri saya sepuluh minit.
Dialog: 0,0:46:17.81,0:46:20.14, Lalai,,0,0,0,,Tidak, hanya lima.
Dialog: 0,0:46:50.09,0:46:52.20,Lalai,,0,0,0,,Kami sudah lama tidak menikmati sarapan pagi yang enak.
Dialog: 0,0:46:52.22,0:46:55.38, Lalai,,0,0,0,,Saya patut makan salad dan kopi.
Dialog: 0,0:46:55.89,0:46:58.54,Lalai,,0,0,0,,Hyun-woo menyelinap masuk ke sini malam tadi.
Dialog: 0,0:46:58.56,0:47:00.09,Lalai,,0,0,0,,Apa?
Dialog: 0,0:47:00.35,0:47:02.00,Lalai,,0,0,0,,Kebaikan. Bagaimana?
Dialog: 0,0:47:02.02,0:47:05.04, Lalai,,0,0,0,,Dia tahu kamera pintu belakang\N rosak dan masuk melalui sana.
Dialog: 0,0:47:05.07,0:47:06.60, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:47:06.82,0:47:09.59,Lalai,,0,0,0,,- Dia sangat bijak dan teliti.\N- Tidak sama sekali.
Dialog: 0,0:47:09.61,0:47:13.61, Lalai,,0,0,0,,Dia tidak memadamkan dashcam\Nfootage di dalam kereta lain,
Dialog: 0,0:47:15.79,0:47:17.99,Lalai,,0,0,0,,jadi saya tahu bagaimana dia masuk.
Dialog: 0,0:47:30.26,0:47:33.25, Lalai,,0,0,0,,Kenapa awak masukkan saya dalam jeruk?
Dialog: 0,0:47:33.39,0:47:35.11,Lalai,,0,0,0,,Adakah anda sudah lupa siapa saya?
Dialog: 0,0:47:35.14,0:47:38.37, Lalai,,0,0,0,,Anda adalah heroin yang berpaling tadah yang menyertai kami.
Dialog: 0,0:47:38.39,0:47:41.41,Lalai,,0,0,0,,No. Teruskan ini, dan saya akan kembali.
Dialog: 0,0:47:41.44,0:47:45.27,Lalai,,0,0,0,,Pn. Moh akan bunuh saya jika dia tahu.
Dialog: 0,0:47:45.77,0:47:48.56,Lalai,,0,0,0,,Saya hampir mencari dana rahsia.
Dialog: 0,0:47:48.86,0:47:51.69,Lalai,,0,0,0,,Itulah sebab Hae-in datang ke sini.
Dialog: 0,0:47:52.41,0:47:54.94,Lalai,,0,0,0,,Aduh, ini membuatkan saya gila.
Dialog: 0,0:47:55.49,0:47:57.55,Lalai,,0,0,0,,Beri saya 3% daripada wang itu.
Dialog: 0,0:47:57.58,0:47:59.40, Lalai,,0,0,0,, Jadikan 5%.
Dialog: 0,0:47:59.75,0:48:00.72,Lalai,,0,0,0,,Adakah anda maksudkan itu?
Dialog: 0,0:48:00.75,0:48:05.56,Lalai,,0,0,0,,Saya mengkhianati mereka, dan\Nmereka masih marah tentangnya.
Dialog: 0,0:48:05.59,0:48:08.12, Lalai,,0,0,0,,Sudah tentu. Awak boleh percayakan saya.
Dialog: 0,0:48:09.76,0:48:10.90,Lalai,,0,0,0,,Jangan senyum pada saya.
Dialog: 0,0:48:10.92,0:48:14.46,Lalai,,0,0,0,,Lelaki kacak berbahaya.
Dialog: 0,0:48:24.48,0:48:26.71, Lalai,,0,0,0,,Seul-hee akan membunuh saya.
Dialog: 0,0:48:26.73,0:48:28.31,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:48:28.86,0:48:29.88,Lalai,,0,0,0,,{\i1}Saya maafkan awak sekali,{\i0}
Dialog: 0,0:48:29.90,0:48:32.59, Lalai,,0,0,0,, jadi beranikah anda berpihak kepada mereka semula seperti tikus?
Dialog: 0,0:48:32.61,0:48:35.84, Lalai,,0,0,0,,Anjing boleh menjadi haiwan peliharaan, tetapi bukan tikus.
Dialog: 0,0:48:35.87,0:48:38.85, Lalai,,0,0,0,,Mereka perlu dibunuh walau apa cara sekalipun.
Dialog: 0,0:48:38.87,0:48:43.03, Lalai,,0,0,0,,Kembalikan pas kereta anda, kad pengenalan,\kad syarikat Nand sebelum anda pergi.
Dialog: 0,0:48:43.33,0:48:46.81,Lalai,,0,0,0,,Ketamakan anda boleh merugikan anda\Semua wang yang anda ada, Grace.
Dialog: 0,0:48:46.84,0:48:49.86, Lalai,,0,0,0,,Lebih baik berbaring rendah demi keselamatan anda.
Dialog: 0,0:48:49.88,0:48:50.98,Lalai,,0,0,0,,- Cik Moh.\N- Sesat.
Dialog: 0,0:48:51.01,0:48:52.53, Lalai,,0,0,0,,Tidak, saya tidak boleh berbuat demikian.
Dialog: 0,0:48:52.55,0:48:55.65, Lalai,,0,0,0,,Bagaimana saya boleh, apabila terdapat salah faham yang besar?
Dialog: 0,0:48:55.68,0:48:59.28,Lalai,,0,0,0,,Saya mencari nafkah daripada maklumat,\Dan orang ramai sering silap saya sebagai tikus,
Dialog: 0,0:48:59.31,0:49:00.45, Lalai,,0,0,0,,tetapi apa yang boleh saya lakukan?
Dialog: 0,0:49:00.47,0:49:02.88, Lalai,,0,0,0,,Itulah saya.
Dialog: 0,0:49:05.35,0:49:06.41, Lalai,,0,0,0,,Salah faham?
Dialog: 0,0:49:06.44,0:49:10.00,Lalai,,0,0,0,,Kemudian terangkan mengapa anda membawa\NHyun-woo, semua orang,
Dialog: 0,0:49:10.03,0:49:11.56, Lalai,,0,0,0,,ke rumah saya.
Dialog: 0,0:49:12.36,0:49:15.59,Lalai,,0,0,0,,Hyun-woo menawarkan saya perjanjian.
Dialog: 0,0:49:15.61,0:49:18.40,Lalai,,0,0,0,,Dia menawarkan untuk memberi saya 10% daripada dana rahsia.
Dialog: 0,0:49:18.83,0:49:21.14,Lalai,,0,0,0,,Jadi dia tahu di mana wang itu?
Dialog: 0,0:49:21.16,0:49:22.89,Lalai,,0,0,0,,Itulah yang saya ingin tahu,
Dialog: 0,0:49:22.91,0:49:24.39,Lalai,,0,0,0,,jadi saya bersetuju untuk membantu.
Dialog: 0,0:49:24.41,0:49:26.16, Lalai,,0,0,0,,Dan di manakah ia?
Dialog: 0,0:49:26.67,0:49:31.37,Lalai,,0,0,0,,Hyun-woo menawarkan 10%,\Ntetapi saya tidak apa-apa dengan 7% daripada anda.
Dialog: 0,0:49:32.26,0:49:33.92,Lalai,,0,0,0,,Jangan main-main dengan saya.
Dialog: 0,0:49:35.18,0:49:37.28, Lalai,,0,0,0,,Kemudian sebuah bangunan kecil dan hanya 5%.
Dialog: 0,0:49:37.30,0:49:40.38, Lalai,,0,0,0,,Saya layak menerimanya.
Dialog: 0,0:49:44.52,0:49:46.30, Lalai,,0,0,0,, Beritahu saya.
Dialog: 0,0:49:49.11,0:49:50.58,Lalai,,0,0,0,,Dia fikir...
Dialog: 0,0:49:50.61,0:49:52.77, Lalai,,0,0,0,,ia ada di rumah ini.
Dialog: 0,0:50:04.75,0:50:06.39, Lalai,,0,0,0,,- Bolehkah saya salah?\N- Apa?
Dialog: 0,0:50:06.42,0:50:09.44, Lalai,,0,0,0,,Saya nampak beberapa lelaki mengambil\Nfoto saya di sebalik dinding itu.
Dialog: 0,0:50:09.46,0:50:11.44, Lalai,,0,0,0,, Astaga.
Dialog: 0,0:50:11.46,0:50:13.40,Lalai,,0,0,0,,Saya tidak percaya ini.
Dialog: 0,0:50:13.42,0:50:14.86,Lalai,,0,0,0,,Saya masih faham, bukan?
Dialog: 0,0:50:14.88,0:50:16.44, Lalai,,0,0,0,,- Biarkan sahaja.\N- Kenapa?
Dialog: 0,0:50:16.47,0:50:19.42,Lalai,,0,0,0,,Mereka akan pergi sebentar lagi.
Dialog: 0,0:50:22.39,0:50:24.09, Lalai,,0,0,0,,Adakah mereka pergi?
Dialog: 0,0:50:25.48,0:50:26.95, Lalai,,0,0,0,,Bang-sil.
Dialog: 0,0:50:26.98,0:50:29.41, Lalai,,0,0,0,,Mereka pergi. Anda tidak perlu\Nmengikatnya lagi.
Dialog: 0,0:50:29.44,0:50:30.46, Lalai,,0,0,0,,Begitulah.
Dialog: 0,0:50:30.48,0:50:32.83, Lalai,,0,0,0,,Saya rasa saya nampak mereka...
Dialog: 0,0:50:32.86,0:50:35.09, Lalai,,0,0,0,,- semalam juga.\N- Apa?
Dialog: 0,0:50:35.11,0:50:37.42, Lalai,,0,0,0,,Mereka terus datang dengan sebuah van hitam.
Dialog: 0,0:50:37.45,0:50:40.94, Lalai,,0,0,0,,Mereka terus mengambil gambar sesuatu.
Dialog: 0,0:50:42.58,0:50:44.69, Lalai,,0,0,0,,Di manakah saya meletakkan kasut tumit saya yang mahal?
Dialog: 0,0:50:49.75,0:50:51.14, Lalai,,0,0,0,,Hei.
Dialog: 0,0:50:51.17,0:50:53.16, Lalai,,0,0,0,,Kita perlu bercakap.
Dialog: 0,0:50:55.38,0:50:56.36, Lalai,,0,0,0,,Apa yang anda mahukan?
Dialog: 0,0:50:56.38,0:50:58.56, Lalai,,0,0,0,,Anda mengambil gambar rumah kami?\NGBeri saya kamera anda.
Dialog: 0,0:50:58.58,0:51:01.20, Lalai,,0,0,0,,- Kami tidak mengambil apa-apa. Jom pergi.\N- Saya nampak awak,
Dialog: 0,0:51:01.22,0:51:02.61, Lalai,,0,0,0,,jadi berikan kepada saya!
Dialog: 0,0:51:02.64,0:51:04.66, Lalai,,0,0,0,,Kebaikan.
Dialog: 0,0:51:04.68,0:51:06.03, Lalai,,0,0,0,,Hei, awak gila?
Dialog: 0,0:51:06.06,0:51:07.84, Lalai,,0,0,0,,Hei.
Dialog: 0,0:51:08.56,0:51:11.41,Lalai,,0,0,0,,- Awak pukul saya dulu.\N- Ya. Jadi apa?
Dialog: 0,0:51:11.44,0:51:14.31, Lalai,,0,0,0,,Adakah anda tahu jenis tumit yang saya pakai?
Dialog: 0,0:51:15.48,0:51:19.90, Lalai,,0,0,0,,Najis mereka,\Nanti saya akan pijak kamu dengan mereka!
Dialog: 0,0:51:25.87,0:51:27.95,Lalai,,0,0,0,,Kamu bajingan!
Dialog: 0,0:51:37.55,0:51:39.25,Lalai,,0,0,0,,Aduh, sakitnya.
Dialog: 0,0:51:39.38,0:51:41.32, Lalai,,0,0,0,,Hei, apa yang kamu lakukan di sana?
Dialog: 0,0:51:41.34,0:51:43.70, Lalai,,0,0,0,,- Ayah...\N- Awak tengah buat apa?
Dialog: 0,0:51:43.72,0:51:45.38, Lalai,,0,0,0,,Bantu kami...
Dialog: 0,0:51:45.64,0:51:47.58, Lalai,,0,0,0,,Sedia, tetapkan, pergi.
Dialog: 0,0:51:47.60,0:51:49.29, Lalai,,0,0,0,, Silang. Itu sahaja. salib.
Dialog: 0,0:51:49.31,0:51:51.16, Lalai,,0,0,0,, Silang.
Dialog: 0,0:51:51.19,0:51:55.21, Lalai,,0,0,0,,Satu kaki.
Dialog: 0,0:51:55.23,0:51:56.58, Lalai,,0,0,0,, Silang. Itu sahaja. salib.
Dialog: 0,0:51:56.61,0:51:57.59, Lalai,,0,0,0,,Ya. salib.
Dialog: 0,0:51:57.61,0:51:59.59, Lalai,,0,0,0,,Satu kaki.
Dialog: 0,0:51:59.61,0:52:00.61, Lalai,,0,0,0,,- Lompat.\N- Awak dengar?
Dialog: 0,0:52:00.64,0:52:01.63, Lalai,,0,0,0,, Lompat! apa?
Dialog: 0,0:52:01.66,0:52:03.88, Lalai,,0,0,0,,- Mereka sedang membentuk Yongdu-ri Quintet.\N- Betul.
Dialog: 0,0:52:03.91,0:52:06.82, Lalai,,0,0,0,,Maksud awak pasukan peronda kampung?\NI dengar tentang van misteri itu.
Dialog: 0,0:52:06.85,0:52:08.38, Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,0:52:08.75,0:52:10.70, Lalai,,0,0,0,,Teruskan. ulang.
Dialog: 0,0:52:11.08,0:52:12.77, Lalai,,0,0,0,,Saya akan mendaftar.
Dialog: 0,0:52:12.79,0:52:15.52,Lalai,,0,0,0,,Saya telah cepat membesarkan beberapa otot\Tidak juga. Saya kumpulkan. Sentuh ia.
Dialog: 0,0:52:15.54,0:52:17.62, Lalai,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:52:18.05,0:52:20.44, Lalai,,0,0,0,,Kuintet bermakna mereka akan memilih lima orang.
Dialog: 0,0:52:20.47,0:52:24.15,Lalai,,0,0,0,,Menjadi sebahagian daripadanya bermakna saya tidak akan menjadi\Tiada seorang pun daripada lima lelaki terkuat di sini.
Dialog: 0,0:52:24.18,0:52:27.57, Lalai,,0,0,0,,Adakah anda fikir saya boleh melakukannya? Saya mahu\Nmenumbuk sesuatu dan memecahkannya.
Dialog: 0,0:52:27.60,0:52:30.31, Lalai,,0,0,0,,Adakah anda mencadangkan bar kayu atau jubin bumbung?
Dialog: 0,0:52:30.33,0:52:31.33, Lalai,,0,0,0,,Soo-cheol...
Dialog: 0,0:52:31.35,0:52:33.04, Lalai,,0,0,0,,Saya tahu ia tidak akan mudah,
Dialog: 0,0:52:33.06,0:52:36.22,Lalai,,0,0,0,,tetapi saya bermimpi indah malam tadi.
Dialog: 0,0:52:36.32,0:52:37.29, Lalai,,0,0,0,,Saya berasa berharap.
Dialog: 0,0:52:37.32,0:52:39.68, Lalai,,0,0,0,,Akan ada kurang daripada lima peserta.
Dialog: 0,0:52:47.28,0:52:48.43, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:52:48.45,0:52:49.93, Lalai,,0,0,0,, Kita sudah selesai.
Dialog: 0,0:52:49.95,0:52:51.99, Lalai,,0,0,0,,Kami berlima.
Dialog: 0,0:52:52.50,0:52:54.39, Lalai,,0,0,0,,Tinggalkan saya daripada ini.
Dialog: 0,0:52:54.42,0:52:56.35, Lalai,,0,0,0,,Saya baru sahaja berundur dari jawatan.
Dialog: 0,0:52:56.38,0:52:59.31,Lalai,,0,0,0,,Orang mungkin mentafsirnya secara politik...
Dialog: 0,0:52:59.34,0:53:02.19, Lalai,,0,0,0,,jika mereka mengetahui saya membentuk kumpulan peribadi.
Dialog: 0,0:53:02.22,0:53:06.45,Lalai,,0,0,0,,Ia hanya akan mencetuskan konflik\Nantara kedua-dua pihak.
Dialog: 0,0:53:06.47,0:53:09.92,Lalai,,0,0,0,,Saya juga tidak boleh meninggalkan ibu saya.
Dialog: 0,0:53:10.43,0:53:13.29,Lalai,,0,0,0,,Anda sentiasa meninggalkan dia tanpa pengawasan apabila anda minum.
Dialog: 0,0:53:13.31,0:53:17.54,Lalai,,0,0,0,,- Mengapa kamu berpura-pura menjadi anak yang baik?\N- Ayuh, kawan.
Dialog: 0,0:53:17.56,0:53:19.67, Lalai,,0,0,0,,Kami memerlukan sekurang-kurangnya lima ahli...
Dialog: 0,0:53:19.69,0:53:22.92,Lalai,,0,0,0,,jika kita mahu kumpulan ini dibiayai.
Dialog: 0,0:53:22.94,0:53:24.48, Lalai,,0,0,0,,Adakah ini bermakna...
Dialog: 0,0:53:25.11,0:53:26.92, Lalai,,0,0,0,,Saya ikut?
Dialog: 0,0:53:26.95,0:53:29.23, Lalai,,0,0,0,,Ya, memang betul.
Dialog: 0,0:53:29.66,0:53:30.93, Lalai,,0,0,0,,Saya boleh menumbuk ini.
Dialog: 0,0:53:30.95,0:53:31.97, Lalai,,0,0,0,,Tidak mengapa.
Dialog: 0,0:53:32.00,0:53:34.43, Lalai,,0,0,0,,Menjadi salah seorang daripada kita bermakna ia akan kekal.
Dialog: 0,0:53:34.46,0:53:36.66, Lalai,,0,0,0,,Anda tidak boleh berundur kemudian.
Dialog: 0,0:53:36.96,0:53:38.27, Lalai,,0,0,0,, Nampak?
Dialog: 0,0:53:38.29,0:53:41.37,Lalai,,0,0,0,,Saya beritahu anda anda tidak perlu mencuba banyak.
Dialog: 0,0:54:04.03,0:54:05.00, Lalai,,0,0,0,,Adakah kita hampir sampai?
Dialog: 0,0:54:05.03,0:54:06.13, Lalai,,0,0,0,,Ya.
Dialog: 0,0:54:06.15,0:54:07.86, Lalai,,0,0,0,, Hampir.
Dialog: 0,0:54:08.49,0:54:10.32, Lalai,,0,0,0,,Bolehkah kita keluar?
Dialog: 0,0:54:26.51,0:54:28.03, Lalai,,0,0,0,, Ini bagus.
Dialog: 0,0:54:28.05,0:54:31.20,Lalai,,0,0,0,,Semua orang mengaku perasaan mereka di sini,
Dialog: 0,0:54:31.22,0:54:34.22,Lalai,,0,0,0,,dan tiada siapa yang gagal setakat ini.
Dialog: 0,0:54:34.72,0:54:38.04,Lalai,,0,0,0,,Cinta anda menjadi kenyataan jika anda mengaku di sini,
Dialog: 0,0:54:38.06,0:54:42.01, Lalai,,0,0,0,, dan ia berfungsi setiap masa.
Dialog: 0,0:54:42.19,0:54:43.81, Lalai,,0,0,0,,Itu tidak masuk akal.
Dialog: 0,0:54:45.11,0:54:47.09,Lalai,,0,0,0,,Bukan sahaja anda mendapat...
Dialog: 0,0:54:47.11,0:54:49.77, Lalai,,0,0,0,, matahari terbenam yang indah,
Dialog: 0,0:54:50.28,0:54:54.39,Lalai,,0,0,0,,tetapi cahaya juga memberikan wajah anda nada hangat,
Dialog: 0,0:54:54.41,0:54:56.22, Lalai,,0,0,0,,yang membuatkan anda kelihatan lebih cantik.
Dialog: 0,0:54:56.25,0:54:58.89,Lalai,,0,0,0,,Anda kelihatan cantik...
Dialog: 0,0:54:58.92,0:54:59.98, Lalai,,0,0,0,,sekarang.
Dialog: 0,0:55:00.00,0:55:01.83, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:55:02.21,0:55:04.75,Lalai,,0,0,0,,Jadi adakah anda akan mengaku cinta anda?
Dialog: 0,0:55:07.67,0:55:09.92, Lalai,,0,0,0,,Ia sebenarnya lebih...
Dialog: 0,0:55:10.26,0:55:11.96, Lalai,,0,0,0,, bagi permintaan.
Dialog: 0,0:55:12.80,0:55:14.51, Lalai,,0,0,0,,Apakah jenis?
Dialog: 0,0:55:24.77,0:55:27.98,Lalai,,0,0,0,,Pembuangan cerai.
Dialog: 0,0:55:30.86,0:55:34.09,Lalai,,0,0,0,,Meminta awak untuk berkahwin dengan saya lagi adalah terlalu banyak,
Dialog: 0,0:55:34.12,0:55:37.53, Lalai,,0,0,0,, jadi bolehkah anda sekurang-kurangnya menarik balik perceraian itu?
Dialog: 0,0:55:52.30,0:55:54.42, Lalai,,0,0,0,,Anda ingat saiz saya.
Dialog: 0,0:55:55.64,0:55:57.51,Lalai,,0,0,0,,Sudah tentu,
Dialog: 0,0:55:58.27,0:56:01.30, Lalai,,0,0,0,,tetapi saya patut meletakkannya pada awak.
Dialog: 0,0:56:14.95,0:56:16.65, Lalai,,0,0,0,,Dapatkan bayaran balik.
Dialog: 0,0:56:20.87,0:56:22.41, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:56:23.08,0:56:26.41,Lalai,,0,0,0,,Awak kata awak nak\Nkahwin dengan saya setiap masa.
Dialog: 0,0:56:26.46,0:56:29.71,Lalai,,0,0,0,,Itulah jika saya dilahirkan semula, tetapi bukan sekarang.
Dialog: 0,0:56:31.55,0:56:34.67, Lalai,,0,0,0,,Kenapa tidak, betul-betul?
Dialog: 0,0:56:35.01,0:56:36.59, Lalai,,0,0,0,,Kenapa?
Dialog: 0,0:56:43.27,0:56:45.26,Lalai,,0,0,0,,Semalam, saya fikir...
Dialog: 0,0:56:49.86,0:56:51.64, Lalai,,0,0,0,,itu anda.
Dialog: 0,0:56:53.03,0:56:54.90,Lalai,,0,0,0,,- Apa?\N- Saya...
Dialog: 0,0:56:55.16,0:56:56.98,Lalai,,0,0,0,,mengikut Eun-sung...
Dialog: 0,0:56:57.83,0:56:59.99,Lalai,,0,0,0,,kerana saya fikir itu awak.
Dialog: 0,0:57:02.16,0:57:04.16, Lalai,,0,0,0,,Sudah sampai sejauh ini.
Dialog: 0,0:57:04.21,0:57:06.10, Lalai,,0,0,0,, Ingatan saya tidak stabil.
Dialog: 0,0:57:06.13,0:57:08.74, Lalai,,0,0,0,,Saya lupa di mana saya berada,
Dialog: 0,0:57:09.25,0:57:13.04, Lalai,,0,0,0,, dan akhirnya, saya tidak dapat mengenali awak.
Dialog: 0,0:57:29.48,0:57:31.06,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hyun-woo?{\c}{\i0}
Dialog: 0,0:57:56.18,0:57:57.71,Lalai,,0,0,0,,Saya dah cakap...
Dialog: 0,0:57:58.39,0:58:00.28,Lalai,,0,0,0,,kita tidak sepatutnya bersama...
Dialog: 0,0:58:00.31,0:58:02.26, Lalai,,0,0,0,,jika penyakit saya bertambah teruk,
Dialog: 0,0:58:03.31,0:58:05.05, Lalai,,0,0,0,,tetapi...
Dialog: 0,0:58:05.69,0:58:07.89, Lalai,,0,0,0,,masa itu datang lebih awal daripada jangkaan.
Dialog: 0,0:58:12.73,0:58:14.94, Lalai,,0,0,0,, Matahari terbenam itu indah.
Dialog: 0,0:58:15.28,0:58:16.81, Lalai,,0,0,0,,Anda betul.
Dialog: 0,0:58:17.57,0:58:19.80, Lalai,,0,0,0,,Cahaya matahari...
Dialog: 0,0:58:19.82,0:58:22.90,Lalai,,0,0,0,,menjadikan anda kelihatan lebih kacak,
Dialog: 0,0:58:25.66,0:58:27.20,Lalai,,0,0,0,,tetapi...
Dialog: 0,0:58:29.88,0:58:33.04,Lalai,,0,0,0,,adakah anda benar-benar Baek Hyun-woo?
Dialog: 0,0:58:37.72,0:58:40.42,Lalai,,0,0,0,,Adakah ini nyata? Saya tidak bermimpi?
Dialog: 0,0:58:43.39,0:58:46.05, Lalai,,0,0,0,,Saya tidak dapat memastikan apa-apa lagi.
Dialog: 0,0:58:49.48,0:58:52.12,Lalai,,0,0,0,,Itulah sebabnya saya tidak boleh membuat apa-apa janji.
Dialog: 0,0:58:52.15,0:58:53.68, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:59:48.41,0:59:50.02, Lalai,,0,0,0,,Apa yang ada di tangannya?
Dialog: 0,0:59:50.04,0:59:51.64, Lalai,,0,0,0,,Tirai menghalang.
Dialog: 0,0:59:51.67,0:59:54.87, Lalai,,0,0,0,,Ia mempunyai peleraian rendah.\Adakah saya patut mendapatkan yang lebih tinggi?
Dialog: 0,0:59:59.88,1:00:01.49,Lalai,,0,0,0,,Awak pernah jumpa ibu saya?
Dialog: 0,1:00:01.51,1:00:03.59,Lalai,,0,0,0,,Tidak, saya belum.
Dialog: 0,1:00:04.89,1:00:08.05,Lalai,,0,0,0,,Anda tidak berbohong, bukan? Saya serius.
Dialog: 0,1:00:08.27,1:00:09.49,Lalai,,0,0,0,,Apa yang dia cakap?
Dialog: 0,1:00:09.52,1:00:11.20,Lalai,,0,0,0,,Saya juga serius.
Dialog: 0,1:00:11.23,1:00:13.30,Lalai,,0,0,0,,Hei! Yeong-song!
Dialog: 0,1:00:13.48,1:00:15.25,Lalai,,0,0,0,,- Adakah anda telah menemuinya?\N- Tidak.
Dialog: 0,1:00:15.27,1:00:16.63,Lalai,,0,0,0,,Dia juga tiada di bandar.
Dialog: 0,1:00:16.65,1:00:18.88,Lalai,,0,0,0,,Kita patut hubungi polis.
Dialog: 0,1:00:18.90,1:00:19.96,Lalai,,0,0,0,,Saya sudah melakukannya.
Dialog: 0,1:00:19.99,1:00:21.05,Lalai,,0,0,0,,Bagus.
Dialog: 0,1:00:21.07,1:00:24.55,Lalai,,0,0,0,,Anda tidak fikir dia berada di\Npergunungan lagi, bukan?
Dialog: 0,1:00:24.57,1:00:27.26,Lalai,,0,0,0,,- Baik.\N- Matahari akan terbenam tidak lama lagi.
Dialog: 0,1:00:27.29,1:00:28.39,Lalai,,0,0,0,,Saya akan semak.
Dialog: 0,1:00:28.41,1:00:29.99,Lalai,,0,0,0,,Tunggu.
Dialog: 0,1:00:31.08,1:00:34.49,Lalai,,0,0,0,,Saya rasa saya boleh membantu.
Dialog: 0,1:00:43.22,1:00:45.25,Lalai,,0,0,0,,Begitulah.
Dialog: 0,1:00:46.01,1:00:47.36,Lalai,,0,0,0,,Lebih sedikit ke kanan.
Dialog: 0,1:00:47.39,1:00:49.43,Lalai,,0,0,0,,Sedikit lagi, dan anda akan melihat mata air mineral.
Dialog: 0,1:00:49.46,1:00:51.29,Lalai,,0,0,0,,Sedikit lagi. Ya, di sana.
Dialog: 0,1:00:51.31,1:00:53.91,Lalai,,0,0,0,,Naik dari sana.
Dialog: 0,1:00:53.94,1:00:55.66,Lalai,,0,0,0,,Lagi.
Dialog: 0,1:00:55.69,1:00:57.85,Lalai,,0,0,0,,Teruskan.
Dialog: 0,1:01:00.86,1:01:03.60,Lalai,,0,0,0,,Terdapat puncak yang dipanggil "Puncak Fairy."
Dialog: 0,1:01:06.24,1:01:08.32,Lalai,,0,0,0,,Itu sahaja!
Dialog: 0,1:01:18.13,1:01:19.91,Lalai,,0,0,0,,Itu dia!
Dialog: 0,1:01:30.18,1:01:31.72,Lalai,,0,0,0,,Mak!
Dialog: 0,1:01:32.93,1:01:34.47,Lalai,,0,0,0,,Mak!
Dialog: 0,1:01:39.69,1:01:41.81,Lalai,,0,0,0,,- Adakah dia tidur?\N- Ya.
Dialog: 0,1:01:42.15,1:01:44.69,Lalai,,0,0,0,,Terima kasih banyak-banyak.
Dialog: 0,1:01:45.41,1:01:46.47,Lalai,,0,0,0,,Saya cemburu.
Dialog: 0,1:01:46.49,1:01:48.09,Lalai,,0,0,0,,Daripada apa?
Dialog: 0,1:01:48.12,1:01:50.82,Lalai,,0,0,0,,Ayah saya juga sakit,
Dialog: 0,1:01:51.04,1:01:53.14,Lalai,,0,0,0,,tapi saya tak boleh jaga dia.
Dialog: 0,1:01:53.16,1:01:54.78,Lalai,,0,0,0,,Betul.
Dialog: 0,1:01:55.12,1:01:56.82,Lalai,,0,0,0,,Saya dengar.
Dialog: 0,1:01:57.38,1:02:00.74,Lalai,,0,0,0,,Dia seorang yang kuat.
Dialog: 0,1:02:00.80,1:02:05.00,Lalai,,0,0,0,,Dia tidak akan berganjak, tidak kira\Sebanyak mana pun saya mencabarnya,
Dialog: 0,1:02:06.88,1:02:09.59,Lalai,,0,0,0,,jadi saya teruskan,
Dialog: 0,1:02:10.68,1:02:12.80,Lalai,,0,0,0,,tetapi saya tidak akan melakukannya...
Dialog: 0,1:02:13.22,1:02:15.55,Lalai,,0,0,0,,kalau saya tahu perkara ini akan berlaku.
Dialog: 0,1:02:15.89,1:02:19.60,Lalai,,0,0,0,,Adakah anda tahu apa\N perkara terakhir yang saya katakan kepadanya?
Dialog: 0,1:02:20.44,1:02:22.98,Lalai,,0,0,0, "Saya akan jumpa awak di pengebumian awak."
Dialog: 0,1:02:28.61,1:02:30.51, Lalai,,0,0,0,,Mulut saya yang sialan ini.
Dialog: 0,1:02:30.53,1:02:32.65,Lalai,,0,0,0,,Saya sepatutnya lebih berhati-hati.
Dialog: 0,1:02:36.37,1:02:39.70,Lalai,,0,0,0,,Saya tidak pernah mencabar ibu saya sebelum ini.
Dialog: 0,1:02:41.25,1:02:42.98,Lalai,,0,0,0,,Adakah anda bercakap besar sekarang?
Dialog: 0,1:02:43.00,1:02:44.83,Lalai,,0,0,0,,Ibu saya keluar rumah...
Dialog: 0,1:02:44.88,1:02:47.46,Lalai,,0,0,0,,ketika saya masih kecil.
Dialog: 0,1:02:48.13,1:02:51.38,Lalai,,0,0,0,,Ayah saya menganiaya dan menipunya,
Dialog: 0,1:02:53.39,1:02:55.63,Lalai,,0,0,0,,jadi saya membesar tanpa dia.
Dialog: 0,1:02:56.73,1:02:58.80,Lalai,,0,0,0,,Kemudian dia mengalami demensia,
Dialog: 0,1:02:59.31,1:03:02.85,Lalai,,0,0,0,,maka saya membawanya keluar dari rumah jagaan\N dan telah tinggal bersamanya.
Dialog: 0,1:03:03.94,1:03:06.61,Lalai,,0,0,0,,Adalah hasrat saya untuk berdebat dengannya apabila dia siuman.
Dialog: 0,1:03:06.64,1:03:07.63,Lalai,,0,0,0,,Saya...
Dialog: 0,1:03:07.65,1:03:10.34,Lalai,,0,0,0,,Saya tidak tahu.
Dialog: 0,1:03:10.36,1:03:12.07,Lalai,,0,0,0,,Kita semua...
Dialog: 0,1:03:12.24,1:03:15.53,Lalai,,0,0,0,,mempunyai beban yang mesti kita pikul dalam hidup.
Dialog: 0,1:03:15.70,1:03:18.68,Lalai,,0,0,0,,Malah mereka yang kelihatan paling riang...
Dialog: 0,1:03:18.71,1:03:21.66,Lalai,,0,0,0,,membawa batu berat di dalam poket mereka,
Dialog: 0,1:03:22.67,1:03:24.19,Lalai,,0,0,0,,jadi...
Dialog: 0,1:03:24.21,1:03:26.44,Lalai,,0,0,0,,jangan cemburu...
Dialog: 0,1:03:26.46,1:03:28.54,Lalai,,0,0,0,,atau salahkan diri sendiri.
Dialog: 0,1:03:28.63,1:03:31.50,Lalai,,0,0,0,,Saya pasti ayah awak tahu betapa awak mengambil berat.
Dialog: 0,1:05:03.10,1:05:04.62,Lalai,,0,0,0,,Saya mengesan trak itu.
Dialog: 0,1:05:04.65,1:05:08.28, Lalai,,0,0,0,,Ia pergi ke rumah anda di Hanil-dong dari\Ngudang di Wilayah Gyeonggi.
Dialog: 0,1:05:08.30,1:05:09.33,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:05:09.36,1:05:11.09,Lalai,,0,0,0,,Jadi semua wang itu ada di rumah?
Dialog: 0,1:05:11.11,1:05:13.01,Lalai,,0,0,0,,Itu mustahil.
Dialog: 0,1:05:13.03,1:05:15.59,Lalai,,0,0,0,,Walaupun peti epal mengandungi $600,000,
Dialog: 0,1:05:15.62,1:05:18.26,Lalai,,0,0,0,,dia memerlukan sejumlah 1500 peti.
Dialog: 0,1:05:18.28,1:05:22.26,Lalai,,0,0,0,,Dia memerlukan lebih daripada sekadar bilik simpanan.\NI memerlukan ruang kira-kira 3600 kaki persegi.
Dialog: 0,1:05:22.29,1:05:25.39,Lalai,,0,0,0,,Bolehkah ada ruang rahsia di rumah kita,
Dialog: 0,1:05:25.42,1:05:26.73, Lalai,,0,0,0,, atau gudang mungkin?
Dialog: 0,1:05:26.75,1:05:29.61,Lalai,,0,0,0,,Kami singgah ke daerah\Noffice untuk menyemak pelan lantai,
Dialog: 0,1:05:29.63,1:05:31.84,Lalai,,0,0,0,,tetapi kami tidak menemui apa-apa.
Dialog: 0,1:05:31.86,1:05:32.90,Lalai,,0,0,0,,Lalu apakah ini?
Dialog: 0,1:05:32.92,1:05:34.36,Lalai,,0,0,0,,Malam tadi,
Dialog: 0,1:05:34.38,1:05:37.75,Lalai,,0,0,0,,Datuk memberitahu saya sesuatu semasa kami bertemu.
Dialog: 0,1:05:39.56,1:05:40.53,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah itu?{\c}{\i0}
Dialog: 0,1:05:40.56,1:05:42.76,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda mempunyai sesuatu untuk dikatakan?{\c}{\i0}
Dialog: 0,1:05:43.35,1:05:46.91,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Puan, datang ke tempat saya jika perang meletus.{\c}{\i0}
Dialog: 0,1:05:46.94,1:05:50.29,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Kami mempunyai tempat perlindungan serangan udara.{\c}{\i0}
Dialog: 0,1:05:50.32,1:05:52.09,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda boleh bersembunyi di sana.{\c}{\i0}
Dialog: 0,1:05:52.11,1:05:53.90,Lalai,,0,0,0,,Dia menyebut tempat perlindungan serangan udara.
Dialog: 0,1:05:53.93,1:05:54.96, Lalai,,0,0,0,, Tempat perlindungan serangan udara?
Dialog: 0,1:05:54.99,1:05:56.26,Lalai,,0,0,0,,Di rumah kita?
Dialog: 0,1:05:56.28,1:05:57.63,Lalai,,0,0,0,,Itu tidak boleh.
Dialog: 0,1:05:57.66,1:05:59.01,Lalai,,0,0,0,,Dia mungkin meracau.
Dialog: 0,1:05:59.03,1:06:01.36,Lalai,,0,0,0,,Kami mempunyai sesuatu yang serupa.
Dialog: 0,1:06:03.41,1:06:05.35,Lalai,,0,0,0,,Dia memberitahu saya tentang cara dia membina...
Dialog: 0,1:06:05.37,1:06:07.31,Lalai,,0,0,0,,bilik panik.
Dialog: 0,1:06:07.33,1:06:08.98,Lalai,,0,0,0,,Anda betul. Saya juga mendengar,
Dialog: 0,1:06:09.00,1:06:10.27,Lalai,,0,0,0,,tetapi di mana?
Dialog: 0,1:06:10.29,1:06:11.90,Lalai,,0,0,0,,Kami hanya mendengar tentangnya.
Dialog: 0,1:06:11.92,1:06:14.27,Lalai,,0,0,0,,Tiada seorang pun daripada kita tahu di mana ia berada.
Dialog: 0,1:06:14.30,1:06:17.11,Lalai,,0,0,0,,Pelan lantai pun tidak menunjukkan apa-apa.
Dialog: 0,1:06:17.13,1:06:18.40,Lalai,,0,0,0,,Itu benar,
Dialog: 0,1:06:18.43,1:06:22.51,Lalai,,0,0,0,,tetapi mungkin terdapat pelan lantai rahsia.
Dialog: 0,1:06:24.23,1:06:26.75,Lalai,,0,0,0,,Jika wang itu ada di sini seperti yang Grace katakan,
Dialog: 0,1:06:26.77,1:06:28.00,Lalai,,0,0,0,,maka saya akan tahu.
Dialog: 0,1:06:28.02,1:06:31.72,Lalai,,0,0,0,,Semua wang itu tidak akan dimuatkan dalam beberapa peti besi.
Dialog: 0,1:06:32.48,1:06:33.88,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, dan kami juga mempunyai bilik itu.{\c}{\i0}
Dialog: 0,1:06:33.90,1:06:36.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anda tahu filem dengan\Nsecret room, "Shock Room"?{\c}{\i0}
Dialog: 0,1:06:36.19,1:06:38.72,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Ia "Bilik Panik", bodoh.{\c}{\i0}
Dialog: 0,1:06:39.62,1:06:42.19,Lalai,,0,0,0,,Saya dengar tempat ini mempunyai bilik panik.
Dialog: 0,1:06:44.75,1:06:47.03,Lalai,,0,0,0,,Adakah anda tahu mengenainya?
Dialog: 0,1:06:50.82,1:06:52.25,Lalai,,0,0,0,,Ini bukan Yongdu-ri Quintet.
Dialog: 0,1:06:52.28,1:06:53.27,Lalai,,0,0,0,,Ini trio.
Dialog: 0,1:06:53.30,1:06:57.08,Lalai,,0,0,0,,Mereka akan menyertai kami untuk minum\N kemudian selepas kami selesai membuat rondaan.
Dialog: 0,1:06:58.55,1:06:59.78,Lalai,,0,0,0,,Siapa itu, pada jam ini?
Dialog: 0,1:06:59.80,1:07:01.70,Lalai,,0,0,0,,Mungkin mereka lelaki itu dari awal hari ini.
Dialog: 0,1:07:01.72,1:07:05.34,Lalai,,0,0,0,,Kami sepatutnya membawa Taser atau sesuatu.
Dialog: 0,1:07:05.47,1:07:06.74,Lalai,,0,0,0,,- Ini teksi.\N- Teksi?
Dialog: 0,1:07:06.77,1:07:08.97,Lalai,,0,0,0,,Mereka memandu van hitam.
Dialog: 0,1:07:11.48,1:07:13.13,Lalai,,0,0,0,,Siapakah mereka?
Dialog: 0,1:07:13.15,1:07:16.04,Lalai,,0,0,0,,Mengapa mereka membawa\Nbeg pakaian ke sini pada jam ini?
Dialog: 0,1:07:16.07,1:07:17.85,Lalai,,0,0,0,,Bukankah ini yang mereka katakan tentang pembunuh...
Dialog: 0,1:07:17.88,1:07:19.56,Lalai,,0,0,0,,- pada berita?\N- Patutkah saya menghubungi mereka?
Dialog: 0,1:07:19.59,1:07:21.19,Lalai,,0,0,0,, Patutkah saya?
Dialog: 0,1:07:59.61,1:08:01.40,Lalai,,0,0,0,,Apa khabar?
Dialog: 0,1:08:02.74,1:08:04.61,Lalai,,0,0,0,,Saya pasti...
Dialog: 0,1:08:05.41,1:08:07.07,Lalai,,0,0,0,,mempunyai...
Dialog: 0,1:08:07.66,1:08:10.07,Lalai,,0,0,0,,mimpi yang indah malam tadi.
Dialog: 0,1:08:36.48,1:08:37.46,Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,1:08:37.48,1:08:40.59,Lalai,,0,0,0,,Ini adalah segala-galanya kecuali untuk\Nwang yang dibelanjakan untuk penerbangan dan hotel.
Dialog: 0,1:08:40.61,1:08:42.46,Lalai,,0,0,0,,Saya membeli sebuah kondo di A.S.
Dialog: 0,1:08:42.49,1:08:43.97,Lalai,,0,0,0,,tetapi saya akan dapatkan semula wang itu.
Dialog: 0,1:08:43.99,1:08:46.38,Lalai,,0,0,0,,Saya akan berikan kepada anda sebaik sahaja saya mendapatnya.
Dialog: 0,1:08:46.41,1:08:48.24,Lalai,,0,0,0,,Saya benar-benar minta maaf.
Dialog: 0,1:08:49.58,1:08:50.64,Lalai,,0,0,0,,Adakah anda tahu...
Dialog: 0,1:08:50.66,1:08:52.97,Lalai,,0,0,0,,apa yang telah anda lakukan?
Dialog: 0,1:08:53.00,1:08:55.23,Lalai,,0,0,0,,Memberi kembali wang itu tidak akan mengurangkannya.
Dialog: 0,1:08:55.25,1:08:56.81,Lalai,,0,0,0,,- Mak.\N- Saya sedar itu.
Dialog: 0,1:08:56.84,1:08:59.20,Lalai,,0,0,0,,Saya tahu ia tidak boleh dimaafkan.
Dialog: 0,1:09:00.21,1:09:01.75,Lalai,,0,0,0,,Saya benar-benar...
Dialog: 0,1:09:02.38,1:09:03.90,Lalai,,0,0,0,,maaf.
Dialog: 0,1:09:03.93,1:09:06.15,Lalai,,0,0,0,,Sudah lewat, dan kita semua perlu tidur.
Dialog: 0,1:09:06.18,1:09:07.96,Lalai,,0,0,0,,Tidurlah sekarang.
Dialog: 0,1:09:08.06,1:09:09.41,Lalai,,0,0,0,,Okey. awak boleh tidur...
Dialog: 0,1:09:09.43,1:09:11.80,Lalai,,0,0,0,,- di sana...\N- Jangan mengarut.
Dialog: 0,1:09:12.43,1:09:14.91,Lalai,,0,0,0,,Saya tidak mahu melihat awak atau perkara itu, jadi pergi.
Dialog: 0,1:09:14.94,1:09:18.31,Lalai,,0,0,0,,Namanya Geon-u,
Dialog: 0,1:09:18.98,1:09:21.88,Lalai,,0,0,0,,dan anda tiada hak untuk menyuruh mereka pergi.
Dialog: 0,1:09:21.90,1:09:24.48,Lalai,,0,0,0,,Ini bukan rumah kami.
Dialog: 0,1:09:25.49,1:09:27.40,Lalai,,0,0,0,,Dia betul, Seon-hwa.
Dialog: 0,1:09:29.87,1:09:32.35,Lalai,,0,0,0,,Jadi anda akan tinggal\Ndengan bayi orang lain?
Dialog: 0,1:09:32.37,1:09:33.81,Lalai,,0,0,0,,Dia anak saya!
Dialog: 0,1:09:33.83,1:09:36.44,Lalai,,0,0,0,,Saya memotong tali pusatnya,\Nsang lagu pengantar tidur kepadanya setiap malam,
Dialog: 0,1:09:36.46,1:09:37.52,Lalai,,0,0,0,,dan mandikan dia sendiri.
Dialog: 0,1:09:37.54,1:09:39.60,Lalai,,0,0,0,,Geon-u...
Dialog: 0,1:09:39.63,1:09:42.71,Lalai,,0,0,0,,kata "Ayah" sebelum dia sempat menyebut "Ibu"!
Dialog: 0,1:09:50.39,1:09:52.09,Lalai,,0,0,0,,Bangun.
Dialog: 0,1:10:04.45,1:10:06.44,Lalai,,0,0,0,,Tetapi...
Dialog: 0,1:10:16.87,1:10:19.58,Lalai,,0,0,0,,Kita perlu membersihkan beberapa perkara.
Dialog: 0,1:10:22.09,1:10:23.86,Lalai,,0,0,0,,Apa yang patut kita panggil antara satu sama lain?
Dialog: 0,1:10:23.88,1:10:26.27,Lalai,,0,0,0,,Anda tahu umur saya, jadi kita tidak boleh\Njadi seperti dulu.
Dialog: 0,1:10:26.30,1:10:27.61,Lalai,,0,0,0,,Saya tidak kisah.
Dialog: 0,1:10:27.64,1:10:29.45,Lalai,,0,0,0,,Saya peduli. Saya lebih tua daripada awak.
Dialog: 0,1:10:29.47,1:10:33.09,Lalai,,0,0,0,,Adakah anda mahu saya melayan anda seperti seorang?
Dialog: 0,1:10:33.60,1:10:35.13,Lalai,,0,0,0,,Puan?
Dialog: 0,1:10:36.52,1:10:39.55,Lalai,,0,0,0,,Saya tidak kembali supaya kita boleh hidup bersama semula.
Dialog: 0,1:10:40.73,1:10:43.35,Lalai,,0,0,0,,- Kemudian?\N- Saya datang untuk mengembalikan semuanya,
Dialog: 0,1:10:43.73,1:10:45.27,Lalai,,0,0,0,,dan Jun-ho...
Dialog: 0,1:10:47.40,1:10:51.61,Lalai,,0,0,0,,Si brengsek itu bercadang untuk\Mengurangi kamu sebagai kambing hitamnya.
Dialog: 0,1:10:51.87,1:10:53.72,Lalai,,0,0,0,,Hentikan dia, atau anda akan dipenjara.
Dialog: 0,1:10:53.74,1:10:56.24,Lalai,,0,0,0,,Jadi awak datang ke sini hanya untuk memberitahu saya perkara itu?
Dialog: 0,1:10:58.96,1:11:00.70,Lalai,,0,0,0,,Saya bimbang.
Dialog: 0,1:11:01.09,1:11:04.66,Lalai,,0,0,0,,Saya hanya berkahwin untuk mooch off...
Dialog: 0,1:11:05.13,1:11:07.87,Lalai,,0,0,0,, seorang lelaki yang bodoh dan kaya.
Dialog: 0,1:11:12.64,1:11:15.22,Lalai,,0,0,0,,Saya tak sangka awak...
Dialog: 0,1:11:16.73,1:11:18.51,Lalai,,0,0,0,,untuk menjaga...
Dialog: 0,1:11:19.31,1:11:21.14,Lalai,,0,0,0,, begitu banyak tentang saya.
Dialog: 0,1:11:25.32,1:11:27.42,Lalai,,0,0,0,,Tiada sesiapa yang pernah...
Dialog: 0,1:11:27.44,1:11:29.71,Lalai,,0,0,0,,melayan saya seperti yang anda lakukan.
Dialog: 0,1:11:29.74,1:11:32.77,Lalai,,0,0,0,,Saya tidak dapat melupakan betapa baiknya...
Dialog: 0,1:11:34.83,1:11:36.78,Lalai,,0,0,0,,awak layan saya.
Dialog: 0,1:11:37.45,1:11:40.57,Lalai,,0,0,0,,Saya tidak boleh makan dengan baik.
Dialog: 0,1:11:42.54,1:11:44.02,Lalai,,0,0,0,,Itulah sebabnya saya di sini.
Dialog: 0,1:11:44.04,1:11:45.56,Lalai,,0,0,0,,Anda datang ke sini untuk memberitahu saya perkara itu?
Dialog: 0,1:11:45.59,1:11:47.86,Lalai,,0,0,0,,Betulkah? Dan sebaik sahaja anda selesai,
Dialog: 0,1:11:47.88,1:11:49.79,Lalai,,0,0,0,,adakah anda akan pergi lagi?
Dialog: 0,1:11:53.35,1:11:55.42,Lalai,,0,0,0,,Saya juga berasa malu.
Dialog: 0,1:11:56.14,1:11:57.20,Lalai,,0,0,0,,Saya tidak boleh hidup dengan awak.
Dialog: 0,1:11:57.22,1:11:58.66,Lalai,,0,0,0,,No.
Dialog: 0,1:11:58.68,1:12:00.80,Lalai,,0,0,0,,Saya mesti tinggal dengan awak.
Dialog: 0,1:12:03.15,1:12:04.67,Lalai,,0,0,0,,Saya tidak kisah kenapa awak ada di sini.
Dialog: 0,1:12:04.69,1:12:07.23,Lalai,,0,0,0,,Saya akan tinggal bersama awak.
Dialog: 0,1:12:08.32,1:12:10.85,Lalai,,0,0,0,,Saya tidak akan benarkan awak atau anak saya pergi lagi.
Dialog: 0,1:12:13.49,1:12:15.22,Lalai,,0,0,0,, Pergi jika anda mahu.
Dialog: 0,1:12:15.24,1:12:17.10,Lalai,,0,0,0,,Saya akan mencari awak, tidak kira di mana sahaja anda berada.
Dialog: 0,1:12:17.12,1:12:18.65,Lalai,,0,0,0,,Awak memang...
Dialog: 0,1:12:18.95,1:12:21.41,Lalai,,0,0,0,,jangan dengar, kan?
Dialog: 0,1:12:22.71,1:12:25.20,Lalai,,0,0,0,,- Saya lebih tua daripada awak.\N- Diam.
Dialog: 0,1:12:36.43,1:12:37.49,Lalai,,0,0,0,,- Jadi...\N- Maafkan saya.
Dialog: 0,1:12:37.51,1:12:40.49,Lalai,,0,0,0,,Ada beberapa perkara ini.
Dialog: 0,1:12:40.52,1:12:41.70,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:12:41.73,1:12:43.43,Lalai,,0,0,0,,Terima kasih.
Dialog: 0,1:12:43.81,1:12:45.67,Lalai,,0,0,0,,Dia milik tuanku...
Dialog: 0,1:12:45.69,1:12:48.25,Lalai,,0,0,0,,- Dia tidak kelihatan seperti seorang ibu.\N- Berhenti merenung.
Dialog: 0,1:12:48.28,1:12:50.36,Lalai,,0,0,0,,Saya dengar dia masuk agak.
Dialog: 0,1:12:50.39,1:12:51.38,Lalai,,0,0,0,,Itu gila.
Dialog: 0,1:12:51.40,1:12:53.47,Lalai,,0,0,0,,Suami saya memberitahu saya mengenainya.
Dialog: 0,1:12:53.49,1:12:56.97,Lalai,,0,0,0,,Dia muncul di tengah\Malam sambil memegang kepala Buddha.
Dialog: 0,1:12:56.99,1:12:59.30,Lalai,,0,0,0,,Suami saya sangat terkejut.
Dialog: 0,1:12:59.33,1:13:02.60,Lalai,,0,0,0,,Dia terus mengalami lumpuh tidur...
Dialog: 0,1:13:02.62,1:13:03.68, Lalai,,0,0,0,,dan bangun.
Dialog: 0,1:13:03.71,1:13:04.77,Lalai,,0,0,0,,Saya beritahu awak.
Dialog: 0,1:13:04.79,1:13:07.35, Lalai,,0,0,0,,Chun-sik memerlukan sedikit ekstrak kambing hitam.
Dialog: 0,1:13:07.38,1:13:09.27,Lalai,,0,0,0,,- Kemudian beri dia makan.\N- Betul ke?
Dialog: 0,1:13:09.30,1:13:12.57,Lalai,,0,0,0,,Adakah Buddha emas itu benar-benar diperbuat daripada emas?
Dialog: 0,1:13:12.59,1:13:13.65,Lalai,,0,0,0,,Emas tulen?
Dialog: 0,1:13:13.68,1:13:15.63,Lalai,,0,0,0,,Beats saya.
Dialog: 0,1:13:18.51,1:13:22.08,Lalai,,0,0,0,,Apakah firasat anda? Kita harus\Nmemutuskan antara "suka" atau "tidak suka."
Dialog: 0,1:13:22.10,1:13:23.45,Lalai,,0,0,0,,- Apa maksud awak?\N- Maksud saya...
Dialog: 0,1:13:23.48,1:13:26.87,Lalai,,0,0,0,,Kami akan sering bertemu dengannya, jadi kami perlu tahu...
Dialog: 0,1:13:26.90,1:13:29.92,Lalai,,0,0,0,,pendirian apa yang perlu diambil.
Dialog: 0,1:13:29.94,1:13:31.63,Lalai,,0,0,0,,Adakah kami akan mengalu-alukan atau mengabaikannya?
Dialog: 0,1:13:31.65,1:13:32.71,Lalai,,0,0,0,,Tepat sekali.
Dialog: 0,1:13:32.74,1:13:34.26,Lalai,,0,0,0,,Adakah suka atau tidak suka?
Dialog: 0,1:13:34.28,1:13:36.56,Lalai,,0,0,0,,Kami akan lakukan seperti yang anda katakan.
Dialog: 0,1:13:37.91,1:13:40.11,Lalai,,0,0,0,,Saya belum pasti lagi.
Dialog: 0,1:13:41.91,1:13:43.35,Lalai,,0,0,0,,Anda tidak?
Dialog: 0,1:13:43.37,1:13:45.89,Lalai,,0,0,0,,Saya kasihan kepadanya,
Dialog: 0,1:13:45.92,1:13:47.85,Lalai,,0,0,0,,tetapi ada sesuatu yang terasa juga.
Dialog: 0,1:13:47.88,1:13:50.29,Lalai,,0,0,0,,Saya perlu mengawasinya lebih lama.
Dialog: 0,1:14:23.62,1:14:25.22,Lalai,,0,0,0,,Dia masih ingat...
Dialog: 0,1:14:25.25,1:14:27.74,Lalai,,0,0,0,,saiz saya.
Dialog: 0,1:14:29.79,1:14:33.20,Lalai,,0,0,0,,Potongan cemerlang bulat?
Dialog: 0,1:14:40.72,1:14:42.84,Lalai,,0,0,0,,Awak tak pergi kerja ke?
Dialog: 0,1:14:44.60,1:14:46.13,Lalai,,0,0,0,,Ya,
Dialog: 0,1:14:46.94,1:14:49.18,Lalai,,0,0,0,,tetapi saya terlupa sesuatu.
Dialog: 0,1:14:58.82,1:15:00.86,Lalai,,0,0,0,,Saya akan mengembalikannya.
Dialog: 0,1:15:02.03,1:15:04.01,Lalai,,0,0,0,,Saya fikir tentang apa yang anda katakan.
Dialog: 0,1:15:04.04,1:15:06.78,Lalai,,0,0,0,,Saya rasa saya terlalu maju.
Dialog: 0,1:15:07.46,1:15:10.58,Lalai,,0,0,0,,Saya akan mengembalikannya semasa dalam perjalanan ke tempat kerja hari ini.
Dialog: 0,1:15:13.46,1:15:15.27,Lalai,,0,0,0,,Hari ini?
Dialog: 0,1:15:15.30,1:15:18.12,Lalai,,0,0,0,,Ini bukan yang penting sekarang.
Dialog: 0,1:15:18.34,1:15:19.32,Lalai,,0,0,0,,Jangan berasa sedih.
Dialog: 0,1:15:19.34,1:15:21.92,Lalai,,0,0,0,,Saya betul-betul okay.
Dialog: 0,1:15:25.64,1:15:27.26,Lalai,,0,0,0,,Baiklah, kalau begitu.
Dialog: 0,1:15:43.74,1:15:45.61,Lalai,,0,0,0,,Apa?
Dialog: 0,1:15:46.04,1:15:47.64,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:15:47.66,1:15:48.89,Lalai,,0,0,0,,Saya cuma...
Dialog: 0,1:15:48.91,1:15:50.35,Lalai,,0,0,0,,mencubanya.
Dialog: 0,1:15:50.37,1:15:52.64,Lalai,,0,0,0,,Itu reka bentuk baharu.\NI ingin mengkaji arah aliran.
Dialog: 0,1:15:52.67,1:15:56.62,Lalai,,0,0,0,,Saya tidak boleh bermalas-malasan hanya\Nkerana saya sedang berehat.
Dialog: 0,1:15:58.55,1:16:01.28,Lalai,,0,0,0,,Itu benar.
Dialog: 0,1:16:01.30,1:16:02.90,Lalai,,0,0,0,,Saya suka cincin itu.
Dialog: 0,1:16:02.93,1:16:06.34,Lalai,,0,0,0,,Anda tahu cincin sangat sesuai dengan saya.
Dialog: 0,1:16:06.52,1:16:07.66,Lalai,,0,0,0,,Anda mempunyai mata yang baik.
Dialog: 0,1:16:07.68,1:16:08.91,Lalai,,0,0,0,,Saya akan berikan itu,
Dialog: 0,1:16:08.93,1:16:10.33,Lalai,,0,0,0,,tetapi...
Dialog: 0,1:16:10.35,1:16:12.75,Lalai,,0,0,0,,hanya saja,
Dialog: 0,1:16:12.77,1:16:15.85,Lalai,,0,0,0,,jadi jangan salah tafsir tindakan saya.
Dialog: 0,1:16:16.28,1:16:17.98,Lalai,,0,0,0,,Tunggu.
Dialog: 0,1:16:18.24,1:16:21.59,Lalai,,0,0,0,,Adakah anda pasti anda telah\Nselesai menganalisis arah aliran?
Dialog: 0,1:16:21.61,1:16:23.56,Lalai,,0,0,0,,Mungkin kaji lebih lanjut.
Dialog: 0,1:16:24.24,1:16:25.68,Lalai,,0,0,0,,Saya sudah selesai menganalisisnya.
Dialog: 0,1:16:25.70,1:16:27.49,Lalai,,0,0,0,,Saya akan pergi, kalau begitu.
Dialog: 0,1:16:36.17,1:16:37.69,Lalai,,0,0,0,,Hae-in.
Dialog: 0,1:16:37.71,1:16:38.94,Lalai,,0,0,0,,Saya tidak akan mengembalikannya.
Dialog: 0,1:16:38.96,1:16:41.86,Lalai,,0,0,0,,Saya akan biarkan ia seperti dahulu.
Dialog: 0,1:16:41.88,1:16:43.65,Lalai,,0,0,0,,{\i1}Anda perlu menganalisis arah aliran,{\i0}
Dialog: 0,1:16:43.68,1:16:46.09,Lalai,,0,0,0,,{\i1}jadi pakai bila-bila masa anda mahu.{\i0}
Dialog: 0,1:16:52.60,1:16:54.54,Lalai,,0,0,0,,Bilik panik? Macam dalam filem...
Dialog: 0,1:16:54.56,1:16:57.08,Lalai,,0,0,0,,apabila ada bom\N nuklear? Di mana ada senjata api...
Dialog: 0,1:16:57.11,1:16:59.09, Lalai,,0,0,0,,dan makanan bernilai bertahun-tahun?
Dialog: 0,1:16:59.11,1:17:02.67,Lalai,,0,0,0,,Saya tidak pasti tentang bahagian itu, tetapi\Npengerusi ada menyebut tentang bilik panik,
Dialog: 0,1:17:02.70,1:17:04.80,Lalai,,0,0,0,,tetapi tiada siapa yang tahu di mana ia terletak.
Dialog: 0,1:17:06.24,1:17:08.51,Lalai,,0,0,0,,- Bagaimana dengan daftar?\N- Ia tidak ada di sana.
Dialog: 0,1:17:08.54,1:17:10.39,Lalai,,0,0,0,,- Tanya pereka.\N- Dia meninggal dunia.
Dialog: 0,1:17:10.41,1:17:12.89,Lalai,,0,0,0,,Anak lelaki mengambil alih firma itu.
Dialog: 0,1:17:12.91,1:17:14.35,Lalai,,0,0,0,,Kemudian tanya dia.
Dialog: 0,1:17:14.37,1:17:15.77,Lalai,,0,0,0,,Saya lakukan,
Dialog: 0,1:17:15.79,1:17:16.77,Lalai,,0,0,0,,dan dia tidak tahu.
Dialog: 0,1:17:16.79,1:17:19.40,Lalai,,0,0,0,,Saya minta pelan lantai,\Ntetapi dia tiada.
Dialog: 0,1:17:19.42,1:17:22.07,Lalai,,0,0,0,,Saya terus menghubunginya, dan\Nkini dia tidak akan menjawab lagi.
Dialog: 0,1:17:22.09,1:17:23.48,Lalai,,0,0,0,,Betulkah?
Dialog: 0,1:17:23.51,1:17:24.69,Lalai,,0,0,0,,Apa yang akan anda lakukan?
Dialog: 0,1:17:24.72,1:17:26.57,Lalai,,0,0,0,,Tidak banyak yang boleh saya lakukan.
Dialog: 0,1:17:26.60,1:17:29.49,Lalai,,0,0,0,,Orang lain perlu meyakinkannya.
Dialog: 0,1:17:29.51,1:17:31.03,Lalai,,0,0,0,,Siapa?
Dialog: 0,1:17:31.06,1:17:32.08,Lalai,,0,0,0,,- Awak.\N- Saya?
Dialog: 0,1:17:32.10,1:17:34.66,Lalai,,0,0,0,,Ya ampun, kita berjumpa lagi.
Dialog: 0,1:17:34.69,1:17:36.62,Lalai,,0,0,0,,Anda tidak pernah tahu masa depan.
Dialog: 0,1:17:36.65,1:17:37.79,Lalai,,0,0,0,,Saya amat bersetuju.
Dialog: 0,1:17:37.81,1:17:40.38,Lalai,,0,0,0,,Saya telah bertemu penyelamat saya semula.
Dialog: 0,1:17:40.40,1:17:43.06,Lalai,,0,0,0,,Astaga, saya tidak layak mendapat gelaran itu.
Dialog: 0,1:17:45.07,1:17:46.38,Lalai,,0,0,0,,Bagaimana keadaan bangunan di Pangyo?
Dialog: 0,1:17:46.41,1:17:48.22,Lalai,,0,0,0,,Baik, dan ini semua terima kasih kepada anda.
Dialog: 0,1:17:48.24,1:17:50.18,Lalai,,0,0,0,,Saya hampir kehilangannya.
Dialog: 0,1:17:50.20,1:17:53.92,Lalai,,0,0,0,,By the way, saya dengar kawan saya di sini mengganggu awak.
Dialog: 0,1:17:53.94,1:17:54.93,Lalai,,0,0,0,,Saya minta maaf.
Dialog: 0,1:17:54.96,1:17:58.79,Lalai,,0,0,0,,Saya tidak mahu terlibat\Nin sesuatu yang rumit.
Dialog: 0,1:17:58.88,1:18:01.73,Lalai,,0,0,0,,Tidak, saya minta maaf kerana meminta bantuan sedemikian.
Dialog: 0,1:18:01.76,1:18:03.78,Lalai,,0,0,0,,Jika bilik panik ini dibuat untuk pemindahan,
Dialog: 0,1:18:03.80,1:18:07.20,Lalai,,0,0,0,,paip udara dan pemasangan elektrik\Nuntuk pengudaraan dan komunikasi...
Dialog: 0,1:18:07.22,1:18:08.66,Lalai,,0,0,0,,sepatutnya dipasang,
Dialog: 0,1:18:08.69,1:18:10.60,Lalai,,0,0,0,,tetapi saya tidak menemui sebarang pada pelan lantai.
Dialog: 0,1:18:10.62,1:18:13.28,Lalai,,0,0,0,,Bagaimanakah kita akan menemuinya? Kami sepatutnya membalikkan tempat itu.
Dialog: 0,1:18:13.30,1:18:14.29,Lalai,,0,0,0,,Apa yang menarik...
Dialog: 0,1:18:14.32,1:18:16.79,Lalai,,0,0,0,,{\i1}adalah lifnya yang\Nbersambung ke ruang bawah tanah...{\i0}
Dialog: 0,1:18:16.81,1:18:20.25,Lalai,,0,0,0,,{\i1}dibina khas tidak seperti yang lain.{\i0}
Dialog: 0,1:18:20.27,1:18:21.63,Lalai,,0,0,0,,{\i1}Lifnya?{\i0}
Dialog: 0,1:18:21.65,1:18:24.14,Lalai,,0,0,0,,Perasaan saya tidak pernah berbeza.
Dialog: 0,1:18:32.08,1:18:33.97,Lalai,,0,0,0,,{\i1}Ia mempunyai dua pintu.{\i0}
Dialog: 0,1:18:34.00,1:18:36.81,Lalai,,0,0,0,,{\i1}Bahagian belakang ialah pintu juga.{\i0}
Dialog: 0,1:18:36.83,1:18:39.48,Lalai,,0,0,0,,Pintu hadapan menghala ke bilik keluarga,
Dialog: 0,1:18:39.50,1:18:43.27,Lalai,,0,0,0,,{\i1}tetapi pintu belakang menghala ke\Nseluruh ruang yang berbeza. Adakah itu?{\i0}
Dialog: 0,1:18:43.30,1:18:44.69,Lalai,,0,0,0,,{\i1}Dan itulah bilik panik?{\i0}
Dialog: 0,1:18:44.72,1:18:47.49,Lalai,,0,0,0,,{\i1}Itu sangkaan saya, tetapi saya perlu menyemak.{\i0}
Dialog: 0,1:18:47.51,1:18:51.11, Lalai,,0,0,0,,- Tidak bolehkah kita serbu tempat itu?\N- Terdapat kawalan keselamatan yang ketat.
Dialog: 0,1:18:51.14,1:18:52.95,Lalai,,0,0,0,,Kami akan disaman kerana menceroboh.
Dialog: 0,1:18:52.97,1:18:56.41,Lalai,,0,0,0,,Tetapi bagaimana jika Seul-hee menemuinya sebelum kita melakukannya?
Dialog: 0,1:18:56.44,1:18:58.16,Lalai,,0,0,0,,Saya bercakap dengan doktornya hari ini.
Dialog: 0,1:18:58.19,1:19:00.33, Lalai,,0,0,0,,Doktornya memberitahu saya dia belum menerima...
Dialog: 0,1:19:00.36,1:19:02.29,Lalai,,0,0,0,,sebarang rawatan wajib,
Dialog: 0,1:19:02.32,1:19:04.09,Lalai,,0,0,0,,seperti latihan pemulihan atau ingatan,
Dialog: 0,1:19:04.11,1:19:05.92,Lalai,,0,0,0,,sejak dia bangun dan pulang ke rumah.
Dialog: 0,1:19:05.94,1:19:09.30,Lalai,,0,0,0,,Dia mungkin kehabisan ubat,\Ntetapi dia belum membuat temu janji lagi.
Dialog: 0,1:19:09.32,1:19:11.68,Lalai,,0,0,0,,Apa? Saya tahu ini akan berlaku.
Dialog: 0,1:19:11.70,1:19:13.80,Lalai,,0,0,0,,Apa yang perlu kita lakukan?
Dialog: 0,1:19:13.83,1:19:16.35,Lalai,,0,0,0,,Kami boleh melaporkannya untuk berpantang,
Dialog: 0,1:19:16.37,1:19:18.27, Lalai,,0,0,0,,dan masuk ke rumah...
Dialog: 0,1:19:18.29,1:19:19.95,Lalai,,0,0,0,,dengan polis.
Dialog: 0,1:19:20.21,1:19:22.48, Lalai,,0,0,0,,Dan lihat lif?
Dialog: 0,1:19:22.50,1:19:26.12,Lalai,,0,0,0,,Mari kita semua pergi perkara pertama pada waktu pagi.
Dialog: 0,1:20:05.63,1:20:07.66,Lalai,,0,0,0,,Anda kembali.
Dialog: 0,1:20:09.88,1:20:11.49,Lalai,,0,0,0,,Saya tahu.
Dialog: 0,1:20:11.51,1:20:13.59,Lalai,,0,0,0,,Anda kelihatan agak terkeluar...
Dialog: 0,1:20:13.64,1:20:17.26,Lalai,,0,0,0,,sejak Hae-in datang.
Dialog: 0,1:20:19.18,1:20:21.54,Lalai,,0,0,0,,Adakah anda sedar dari semasa ke semasa?
Dialog: 0,1:20:21.56,1:20:24.62,Lalai,,0,0,0,,Tetapi tempohnya terlalu\Npendek untuk anda melakukan apa sahaja.
Dialog: 0,1:20:24.65,1:20:26.46,Lalai,,0,0,0,,Anda tidak boleh meminta bantuan.
Dialog: 0,1:20:26.48,1:20:27.71,Lalai,,0,0,0,,Anda tidak boleh bergerak bebas.
Dialog: 0,1:20:27.73,1:20:29.17,Lalai,,0,0,0,,Anda juga tiada telefon.
Dialog: 0,1:20:29.19,1:20:31.94,Lalai,,0,0,0,,Tempat ni mesti neraka kan?
Dialog: 0,1:20:32.24,1:20:33.67,Lalai,,0,0,0,,Anda betul.
Dialog: 0,1:20:33.70,1:20:35.27,Lalai,,0,0,0,,Ini...
Dialog: 0,1:20:35.70,1:20:36.72,Lalai,,0,0,0,,neraka yang hidup,
Dialog: 0,1:20:36.74,1:20:38.44,Lalai,,0,0,0,,dan...
Dialog: 0,1:20:38.75,1:20:40.01,Lalai,,0,0,0,,Saya sedang dihukum.
Dialog: 0,1:20:40.04,1:20:41.93,Lalai,,0,0,0,,Itulah sebabnya saya memberi awak pil itu,
Dialog: 0,1:20:41.96,1:20:44.85,Lalai,,0,0,0,,supaya anda dapat tidur dengan tenang tanpa kerisauan,
Dialog: 0,1:20:44.88,1:20:46.60,Lalai,,0,0,0,,jadi mengapa anda tidak mengambilnya?
Dialog: 0,1:20:46.63,1:20:48.48,Lalai,,0,0,0,,Moh Seul-hee.
Dialog: 0,1:20:48.51,1:20:52.33,Lalai,,0,0,0,,Adakah ini selalu motif anda datang ke sini?
Dialog: 0,1:20:56.18,1:20:58.57,Lalai,,0,0,0,,Kemudian adakah anda fikir saya benar-benar mencintai anda...
Dialog: 0,1:20:58.60,1:21:00.72,Lalai,,0,0,0,,atau sesuatu?
Dialog: 0,1:21:02.98,1:21:04.46,Lalai,,0,0,0,,Bukankah saya hanya dahsyat?
Dialog: 0,1:21:04.48,1:21:05.79,Lalai,,0,0,0,,Tidakkah anda merindui anak-anak anda?
Dialog: 0,1:21:05.81,1:21:06.92,Lalai,,0,0,0,,Anda boleh pergi.
Dialog: 0,1:21:06.94,1:21:08.85,Lalai,,0,0,0,,Catat saya...
Dialog: 0,1:21:09.07,1:21:11.64,Lalai,,0,0,0,,di mana dana rahsia anda berada.
Dialog: 0,1:21:13.53,1:21:16.43,Lalai,,0,0,0,,Tiada apa yang boleh anda\Nlakukan apabila anda hanya waras...
Dialog: 0,1:21:16.45,1:21:18.39,Lalai,,0,0,0,,untuk seketika pada satu masa.
Dialog: 0,1:21:18.41,1:21:19.89,Lalai,,0,0,0,,Catat saya,
Dialog: 0,1:21:19.91,1:21:22.99, Lalai,,0,0,0,, dan semuanya akan baik-baik saja.
Dialog: 0,1:21:26.17,1:21:27.70, Lalai,,0,0,0,, Beritahu saya!
Dialog: 0,1:22:43.58,1:22:45.37,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:22:45.40,1:22:46.39,Lalai,,0,0,0,,Hyun-woo.
Dialog: 0,1:22:46.41,1:22:48.68,Lalai,,0,0,0,,Adakah anda memanggil ambulans juga?
Dialog: 0,1:22:48.71,1:22:50.94,Lalai,,0,0,0,,Tidak, pegawai yang saya hubungi belum sampai lagi.
Dialog: 0,1:22:50.96,1:22:52.02,Lalai,,0,0,0,,Kemudian apa yang berlaku?
Dialog: 0,1:22:52.05,1:22:54.08,Lalai,,0,0,0,,Adakah sesuatu berlaku?
Dialog: 0,1:22:58.39,1:23:00.42,Lalai,,0,0,0,,Apakah itu?
Dialog: 0,1:23:00.51,1:23:02.21,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:23:04.72,1:23:06.63, Lalai,,0,0,0,, Beritahu saya.
Dialog: 0,1:23:09.15,1:23:10.65,Lalai,,0,0,0,,- Alih.\N- Anda tidak boleh masuk.
Dialog: 0,1:23:10.67,1:23:11.67,Lalai,,0,0,0,,Astaga.
Dialog: 0,1:23:11.69,1:23:13.46,Lalai,,0,0,0,,{\i1}Hong Man-dae, umur 80 tahun, mengalami demensia.{\i0}
Dialog: 0,1:23:13.48,1:23:16.13,Lalai,,0,0,0,,{\i1}Kami percaya patah tulang belakang serviks\N adalah punca kematian.{\i0}
Dialog: 0,1:23:16.15,1:23:19.52,Lalai,,0,0,0,,{\i1}Dia akan dibawa ke Hospital Daemang tidak lama lagi.{\i0}
Dialog: 0,1:23:20.03,1:23:22.44,Lalai,,0,0,0,,Ayah!
Dialog: 0,1:23:26.00,1:23:29.62,Lalai,,0,0,0,,Ayah!
Dialog: 0,1:23:45.85,1:23:47.38,Lalai,,0,0,0,,Ayah?
Dialog: 0,1:23:47.52,1:23:49.05,Lalai,,0,0,0,,Bapa.
Dialog: 0,1:23:49.48,1:23:50.75,Lalai,,0,0,0,,Bapa.
Dialog: 0,1:23:50.77,1:23:52.62,Lalai,,0,0,0,,Kami di sini.
Dialog: 0,1:23:52.65,1:23:54.35,Lalai,,0,0,0,,Kami di sini sekarang.
Dialog: 0,1:23:55.48,1:23:57.02,Lalai,,0,0,0,,Ayah...
Dialog: 0,1:23:57.15,1:23:59.35,Lalai,,0,0,0,,Lakukan sesuatu...
Dialog: 0,1:24:00.41,1:24:01.94,Lalai,,0,0,0,,Beom-jun.
Dialog: 0,1:24:02.41,1:24:04.30,Lalai,,0,0,0,,Lakukan sesuatu.
Dialog: 0,1:24:04.33,1:24:07.82,Lalai,,0,0,0,,Tangannya masih hangat.
Dialog: 0,1:24:07.87,1:24:08.93,Lalai,,0,0,0,,No.
Dialog: 0,1:24:08.96,1:24:10.35,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:24:10.37,1:24:11.73,Lalai,,0,0,0,,Sayang.
Dialog: 0,1:24:11.75,1:24:13.56,Lalai,,0,0,0,,Tuan.
Dialog: 0,1:24:13.59,1:24:16.31,Lalai,,0,0,0,,Sila beri dia CPR atau sesuatu.
Dialog: 0,1:24:16.34,1:24:17.94,Lalai,,0,0,0,,- Ayah...\N- Saya minta maaf.
Dialog: 0,1:24:17.96,1:24:19.94,Lalai,,0,0,0,,Tolong buat sesuatu.
Dialog: 0,1:24:19.97,1:24:22.33,Lalai,,0,0,0,,Maafkan saya. Kita perlu memindahkannya.
Dialog: 0,1:24:22.68,1:24:24.82,Lalai,,0,0,0,,Kita perlu gerakkan dia. saya minta maaf.
Dialog: 0,1:24:24.85,1:24:27.51,Lalai,,0,0,0,,- Ayah!\N- Maafkan kami.
Dialog: 0,1:24:27.72,1:24:29.33,Lalai,,0,0,0,,Ayah!
Dialog: 0,1:24:29.35,1:24:30.66,Lalai,,0,0,0,,Tunggu!
Dialog: 0,1:24:30.69,1:24:32.12,Lalai,,0,0,0,,- Ayah!\N- Saya minta maaf.
Dialog: 0,1:24:32.15,1:24:34.67,Lalai,,0,0,0,,- Tunggu.\N- Kita perlu gerakkan dia. saya minta maaf.
Dialog: 0,1:24:34.69,1:24:36.50,Lalai,,0,0,0,,- Kita perlu bergerak. Saya minta maaf.\N- Ayah!
Dialog: 0,1:24:36.52,1:24:37.84,Lalai,,0,0,0,,- Saya minta maaf.\N- Ayah!
Dialog: 0,1:24:37.86,1:24:39.46,Lalai,,0,0,0,,Atuk.
Dialog: 0,1:24:39.49,1:24:41.10,Lalai,,0,0,0,,Atuk.
Dialog: 0,1:24:43.74,1:24:45.36,Lalai,,0,0,0,,Ayah...
Dialog: 0,1:24:46.08,1:24:48.53,Lalai,,0,0,0,,Ayah...
Dialog: 0,1:24:49.04,1:24:50.95,Lalai,,0,0,0,,Ayah...
Dialog: 0,1:25:00.34,1:25:03.69,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Seorang mogul perniagaan terkemuka\Nmeninggal dunia awal pagi ini.{\c}{\i0}
Dialog: 0,1:25:03.72,1:25:06.41,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Selepas bermula sebagai\Nshoes boy di jalanan,{\c}{\i0}
Dialog: 0,1:25:06.43,1:25:08.74,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}dan membina Queens Group\Ninto peneraju industri,{\c}{\i0}
Dialog: 0,1:25:08.77,1:25:11.16,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Man-dae, bekas pengerusi Kumpulan Queens,{\c}{\i0}
Dialog: 0,1:25:11.18,1:25:14.72,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}telah meninggal dunia pada usia 80 tahun.{\c}{\i0}
Dialog: 0,1:25:15.02,1:25:19.79,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia mengalami serangan jantung mengejut sebulan\N yang lalu dan telah koma.{\c}{\i0}
Dialog: 0,1:25:19.82,1:25:24.81,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Walaupun baru bangun tidur, dia\Nmenunjukkan tanda-tanda demensia vaskular.{\c}{\i0}
Dialog: 0,1:25:25.28,1:25:29.97,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Industri memantau rapi\NQueens Group situasi kepimpinan.{\c}{\i0}
Dialog: 0,1:25:29.99,1:25:33.93,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong menandatangani surat kuasa wakil kepada\N rakan kongsi domestiknya, Moh Seul-hee,{\c}{\i0}
Dialog: 0,1:25:33.96,1:25:37.70,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}yang memberikan haknya, seperti\Nkawalan saham dan rumahnya.{\c}{\i0}
Dialog: 0,1:25:37.92,1:25:40.23,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}Walau bagaimanapun, disebabkan pemergiannya,{\c}{\i0}
Dialog: 0,1:25:40.26,1:25:43.42,Lalai,,0,0,0,,{\i1}{\c&H7AA0FF&}haknya akan terbatal dan tidak sah.{\c}{\i0}
Dialog: 0,1:27:10.39,1:27:11.95,Lalai,,0,0,0,,Disebabkan kematian Pengerusi Hong,
Dialog: 0,1:27:11.97,1:27:14.78,Lalai,,0,0,0,,seluruh hartanya akan diserahkan...
Dialog: 0,1:27:14.81,1:27:16.41,Lalai,,0,0,0,,mengikut wasiat notarinya.
Dialog: 0,1:27:16.43,1:27:21.10,Lalai,,0,0,0,,Ini berkuat kuasa serta-merta\Tanpa memerlukan kelulusan mahkamah.
Dialog: 0,1:27:21.77,1:27:23.79,Lalai,,0,0,0,,Adakah anda faham?
Dialog: 0,1:27:23.82,1:27:25.13,Lalai,,0,0,0,,Kemas dan pergi.
Dialog: 0,1:27:25.15,1:27:26.89,Lalai,,0,0,0,,Bukankah kita patut fokus...
Dialog: 0,1:27:27.11,1:27:29.90, Lalai,,0,0,0,, untuk mendoakan dia selamat buat masa ini?
Dialog: 0,1:27:30.24,1:27:34.03,Lalai,,0,0,0,,Kita boleh membincangkan perkara sebegitu kemudian.
Dialog: 0,1:27:36.45,1:27:38.91,Lalai,,0,0,0,,Dia suka rumah ini.
Dialog: 0,1:27:40.63,1:27:42.41,Lalai,,0,0,0,,Tolong beri dia...
Dialog: 0,1:27:43.21,1:27:45.20,Lalai,,0,0,0,,satu lawatan terakhir.
Dialog: 0,1:27:46.05,1:27:47.87,Lalai,,0,0,0,,Awak kecik...!
Dialog: 0,1:29:01.37,1:29:02.47,Lalai,,0,0,0,,Anda diberkati...
Dialog: 0,1:29:02.50,1:29:04.46,Lalai,,0,0,0,,dengan seorang anak lelaki yang kacak dan bijak.
Dialog: 0,1:29:04.48,1:29:05.48,Lalai,,0,0,0,,Ya.
Dialog: 0,1:29:05.50,1:29:07.02,Default,,0,0,0,,Dia pandai bertinju...
Dialog: 0,1:29:07.05,1:29:08.73,Lalai,,0,0,0,,dan berenang juga.
Dialog: 0,1:29:08.76,1:29:10.01,Lalai,,0,0,0,,Betul.
Dialog: 0,1:29:10.03,1:29:11.03,Lalai,,0,0,0,,Lihat di sini.
Dialog: 0,1:29:11.05,1:29:13.99,Lalai,,0,0,0,,Dia juga pergi ke Kem Kor Marin kanak-kanak.
Dialog: 0,1:29:14.01,1:29:15.65,Lalai,,0,0,0,,Dia sekali...
Dialog: 0,1:29:15.68,1:29:18.42,Lalai,,0,0,0,,malah menyelamatkan seorang kanak-kanak daripada lemas.
Dialog: 0,1:29:20.93,1:29:23.16,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Jangan pergi ke sana.{\c}{\i0}
Dialog: 0,1:29:23.19,1:29:26.75,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Cepat!{\c}{\i0}
Dialog: 0,1:29:26.77,1:29:31.10,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Apa yang sedang berlaku?\N- Apa yang sedang berlaku?{\c}{\i0}
Dialog: 0,1:29:35.41,1:29:37.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in!{\c}{\i0}
Dialog: 0,1:29:37.74,1:29:39.90,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in!{\c}{\i0}
Dialog: 0,1:30:26.96,1:30:28.66,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Dua.\N- Dua.{\c}{\i0}
Dialog: 0,1:30:30.46,1:30:32.04,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}- Tiga.\N- Tiga.{\c}{\i0}
Dialog: 0,1:30:35.30,1:30:37.50,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Mengapa anda masuk ke sana?{\c}{\i0}
Dialog: 0,1:30:37.68,1:30:39.80,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Adakah anda okey? Marilah bersama.{\c}{\i0}
Dialog: 0,1:30:51.48,1:30:54.02,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan...{\c}{\i0}
Dialog: 0,1:30:54.32,1:30:57.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Tidak, Su-wan...{\c}{\i0}
Dialog: 0,1:30:57.95,1:31:00.48,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan, tolong!{\c}{\i0}
Dialog: 0,1:31:01.83,1:31:03.86,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Anakku yang malang!{\c}{\i0}
Dialog: 0,1:31:05.25,1:31:06.60,Lalai,,0,0,0,,{\i1}{\c&HFFFF00&}Su-wan!{\c}{\i0}
Dialog: 0,1:31:06.62,1:31:09.42,Lalai,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:31:39.78,1:31:42.55,Lalai,,0,0,0,,{\an8}{\i1}Hae-in. Terima kasih.{\i0}
Dialog: 0,1:31:42.58,1:31:43.72,Lalai,,0,0,0,,{\an8}{\i1}Itu awak, bukan?{\i0}
Dialog: 0,1:31:43.74,1:31:46.49,Lalai,,0,0,0,,{\an8}{\i1}Saya beritahu awak. Saya mahu dia hidup.{\i0}
Dialog: 0,1:31:46.66,1:31:48.89,Lalai,,0,0,0,,{\an8}{\i1}Saya akan pergi setelah saya selesai di sini.{\i0}
Dialog: 0,1:31:48.92,1:31:50.35,Lalai,,0,0,0,,{\an8}{\i1}Balsam?{\i0}
Dialog: 0,1:31:50.37,1:31:52.94,Lalai,,0,0,0,,{\an8}{\i1}Ia menandakan keterujaan saya\Nand berharap untuk salji pertama...{\i0}
Dialog: 0,1:31:52.96,1:31:54.40,Lalai,,0,0,0,,{\an8}{\i1}yang saya fikir saya tidak akan pernah lihat.{\i0}
Dialog: 0,1:31:54.42,1:31:56.32,Lalai,,0,0,0,,{\an8}{\i1}Ini...{\i0}
Dialog: 0,1:31:56.34,1:31:58.78,Lalai,,0,0,0,,{\an8}{\i1}apa yang anda panggil nasib sebenar.{\i0}
Dialog: 0,1:31:58.80,1:32:01.24,Lalai,,0,0,0,,{\an8}{\i1}Anda akan merosakkan ini\Nall hanya untuk Hong Hae-in?{\i0}
Dialog: 0,1:32:01.26,1:32:03.07,Lalai,,0,0,0,,{\an8}{\i1}Dia mengambil umpan.{\i0}
Dialog: 0,1:32:03.10,1:32:06.55,Lalai,,0,0,0,,{\an8}{\i1}Simpan Eun-sung dalam\Nloop supaya dia berasa cemas...{\i0}
Dialog: 0,1:32:07.10,1:32:08.41,Lalai,,0,0,0,,{\an8}{\i1}Hae-in!{\i0}
Dialog: 0,1:32:08.43,1:32:11.30,Lalai,,0,0,0,,{\an8}{\i1}Ada sesuatu yang saya tidak beritahu anda juga.{\i0}
