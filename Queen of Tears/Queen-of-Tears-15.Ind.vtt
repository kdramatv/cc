Dialog: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Sutradara: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialog: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,0:01:02.56,0:01:03.53,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 15{\c}{\i0}
Dialog: 0,0:01:36.38,0:01:38.29,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:39.22,0:01:41.38,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:41.81,0:01:43.88,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:49.73,0:01:52.68,Default,,0,0,0,,Jangan lupa nama itu.
Dialog: 0,0:01:53.86,0:01:55.64,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:56.90,0:01:58.90,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:01:59.11,0:02:01.07,Default,,0,0,0,,Baek Hyun-woo.
Dialog: 0,0:02:02.33,0:02:04.19,Default,,0,0,0,,Baek Hyun-woo.
Dialogue: 0,0:03:40.88,0:03:44.32,Default,,0,0,0,,Kenapa mereka tiba-tiba\Nmengganti dokter dan perawatnya?
Dialogue: 0,0:03:44.34,0:03:45.45,Default,,0,0,0,,Kalahkan aku.
Dialog: 0,0:03:45.47,0:03:49.58,Default,,0,0,0,,Orang itu adalah tunangan Nona Hong,\Ndan dia berbicara dengan sutradara.
Dialogue: 0,0:03:49.60,0:03:52.58,Default,,0,0,0,,Dia juga menyumbangkan banyak uang untuk yayasan.
Dialog: 0,0:03:52.60,0:03:54.83,Default,,0,0,0,,Sutradara menyuruh kami tutup mulut,
Dialogue: 0,0:03:54.85,0:03:56.62,Default,,0,0,0,,atau kami akan dituntut.
Dialogue: 0,0:03:56.65,0:03:58.08,Default,,0,0,0,,Bagaimana dengan yang satunya?
Dialogue: 0,0:03:58.11,0:04:00.00,Default,,0,0,0,,- Bukankah dia tunangannya?\N- Entahlah.
Dialog: 0,0:04:00.03,0:04:01.92,Default,,0,0,0,,Dia mengaku sebagai tunangannya juga.
Dialog: 0,0:04:01.95,0:04:04.56,Default,,0,0,0,,Aku penasaran siapa yang sebenarnya.
Dialog: 0,0:04:10.08,0:04:11.26,Default,,0,0,0,,Jadi...
Dialogue: 0,0:04:11.29,0:04:14.35,Default,,0,0,0,,mantan suamiku mengikutiku ke sini?
Dialog: 0,0:04:14.37,0:04:15.89,Default,,0,0,0,,Ya.
Dialog: 0,0:04:15.92,0:04:18.90,Default,,0,0,0,,Dia terus-menerus bertanya\Nkamu sebelum operasi...
Dialogue: 0,0:04:18.92,0:04:20.11,Default,,0,0,0,,untuk merevisi surat wasiatmu.
Dialog: 0,0:04:20.13,0:04:21.23,Default,,0,0,0,,Tentu saja Anda menolak.
Dialogue: 0,0:04:21.26,0:04:23.23,Default,,0,0,0,,Kita mengalami kecelakaan sebelum operasi.
Dialog: 0,0:04:23.26,0:04:26.28,Default,,0,0,0,,Sebuah truk menabrak kendaraan kami.
Dialog: 0,0:04:26.30,0:04:29.71,Default,,0,0,0,,Saya yakin dialah dalangnya.
Dialog: 0,0:04:29.76,0:04:31.59,Default,,0,0,0,,- Tidak mungkin.\N- Baek Hyun-woo tidak akan ragu...
Dialog: 0,0:04:31.62,0:04:34.08,Default,,0,0,0,,melakukan apa pun saat dia punya dendam.
Dialog: 0,0:04:34.10,0:04:36.50,Default,,0,0,0,,Dia mengancamku berkali-kali.
Dialogue: 0,0:04:36.52,0:04:39.33,Default,,0,0,0,,Bagaimana kita bisa selamat dari kecelakaan itu?
Dialog: 0,0:04:39.36,0:04:41.06,Default,,0,0,0,,Benar.
Dialog: 0,0:04:42.03,0:04:44.96,Default,,0,0,0,,Untungnya kami tidak berada di dalam mobil,
Dialogue: 0,0:04:44.99,0:04:47.34,Default,,0,0,0,,tapi kukira begitu, jadi tanganku terluka...
Dialog: 0,0:04:47.37,0:04:49.98,Default,,0,0,0,,mencoba memecahkan jendela.
Dialog: 0,0:04:54.46,0:04:56.32,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,0:04:58.42,0:05:00.37,Default,,0,0,0,,Bukan apa-apa.
Dialog: 0,0:05:01.00,0:05:05.75,Default,,0,0,0,,Aku hanya ingin berhenti melihatnya menyiksamu.
Dialog: 0,0:05:05.84,0:05:09.80,Default,,0,0,0,,Saat dia berselingkuh dan ingin menceraikanmu,
Dialog: 0,0:05:13.93,0:05:16.55,Default,,0,0,0,,kamu mencoba bunuh diri.
Dialogue: 0,0:05:18.98,0:05:22.43,Default,,0,0,0,,Aku mencoba bunuh diri karena\Npria yang selingkuh?
Dialogue: 0,0:05:23.44,0:05:25.46,Default,,0,0,0,,Aku menyedihkan.
Dialog: 0,0:05:25.49,0:05:28.65,Default,,0,0,0,,Tidak sama sekali. Kamu terlalu berhati lembut dan baik hati.
Dialog: 0,0:05:29.87,0:05:32.22,Default,,0,0,0,,Saya tidak bisa melakukan apa pun saat itu...
Dialog: 0,0:05:32.24,0:05:34.72,Default,,0,0,0,,karena kamu masih menikah, tapi sekarang tidak lagi.
Dialogue: 0,0:05:34.75,0:05:38.07,Default,,0,0,0,,Aku akan menjagamu tetap aman, apa pun yang terjadi.
Dialogue: 0,0:05:43.96,0:05:46.03,Default,,0,0,0,,Ini halte bus dekat Waduk Sambang.
Dialogue: 0,0:05:46.05,0:05:47.15,Default,,0,0,0,,Bukankah itu kamu?
Dialogue: 0,0:05:47.18,0:05:49.61,Default,,0,0,0,,Mengapa kamu ada di sana sekitar saat kematiannya?
Dialogue: 0,0:05:49.64,0:05:52.32,Default,,0,0,0,,Kita sudah sepakat untuk bertemu, tapi dia tidak pernah muncul.
Dialog: 0,0:05:52.34,0:05:53.32,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:05:53.34,0:05:55.41,Default,,0,0,0,,{\i1}Lalu kenapa rambutmu ditemukan...{\i0}
Dialog: 0,0:05:55.43,0:05:57.62,Default,,0,0,0,,di dalam mobil korban?
Dialog: 0,0:05:57.64,0:05:59.91,Default,,0,0,0,,Saya yakin itu ditanam.
Dialog: 0,0:05:59.94,0:06:01.72,Default,,0,0,0,,Baiklah.
Dialog: 0,0:06:02.02,0:06:03.00,Default,,0,0,0,,Bagaimana kalau ini?
Dialog: 0,0:06:03.02,0:06:05.25,Default,,0,0,0,,Kami menemukan pisau ini di dekat TKP.
Dialogue: 0,0:06:05.28,0:06:08.05,Default,,0,0,0,,Ada sidik jarimu dan darahnya.
Dialog: 0,0:06:08.07,0:06:10.63,Default,,0,0,0,,Luka tusukannya cocok dengan bilahnya.
Dialogue: 0,0:06:10.66,0:06:12.89,Default,,0,0,0,,- Apakah kamu masih akan berpura-pura bodoh?\N- Jika aku...
Dialog: 0,0:06:12.91,0:06:14.55,Default,,0,0,0,,benar-benar menggunakan pisau itu,
Dialogue: 0,0:06:14.58,0:06:17.32,Default,,0,0,0,,lalu apakah aku akan meninggalkannya?
Dialogue: 0,0:06:17.62,0:06:20.06,Default,,0,0,0,,Apakah kamu terluka karena menusuknya?
Dialog: 0,0:06:20.08,0:06:22.66,Default,,0,0,0,,Saya mengalami kecelakaan di Jerman.
Dialog: 0,0:06:22.75,0:06:25.27,Default,,0,0,0,,Saya melukai diri sendiri saat mencoba\N memecahkan jendela mobil.
Dialogue: 0,0:06:25.30,0:06:28.61,Default,,0,0,0,,Jika aku mendapatkan ini karena\Ntanganku terpeleset saat menggunakan pisau,
Dialogue: 0,0:06:28.63,0:06:31.61,Default,,0,0,0,,lukanya pasti ada di telapak tanganku,
Dialogue: 0,0:06:31.64,0:06:32.74,Default,,0,0,0,,bukan punggung tanganku.
Dialog: 0,0:06:32.76,0:06:33.95,Default,,0,0,0,,Saya tidak percaya padamu.
Dialog: 0,0:06:33.97,0:06:35.62,Default,,0,0,0,,Klaim tidak bersalah sesukamu,
Dialog: 0,0:06:35.64,0:06:38.99,Default,,0,0,0,,tapi itu tidak akan mudah dengan semua\Nbukti kuat yang kami miliki.
Dialogue: 0,0:06:39.02,0:06:41.41,Default,,0,0,0,,Berterus terang akan memberimu hukuman yang lebih ringan.
Dialogue: 0,0:06:41.44,0:06:43.97,Default,,0,0,0,,Bukankah seharusnya kamu sendiri yang mengenalnya sebagai pengacara?
Dialogue: 0,0:06:50.11,0:06:53.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hyun-woo, jika ini terjadi lagi,{\c}{\i0}
Dialogue: 0,0:06:53.87,0:06:55.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}jangan selamatkan aku.{\c}{\i0}
Dialogue: 0,0:07:21.35,0:07:25.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saat dia berselingkuh dan ingin menceraikanmu,{\c}{\i0}
Dialog: 0,0:07:25.31,0:07:27.64,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kamu mencoba bunuh diri.{\c}{\i0}
Dialog: 0,0:08:17.53,0:08:20.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo\NHae-in{\c}{\i0}
Dialog: 0,0:08:22.08,0:08:23.22,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Satu Bulan Kemudian{\c}{\i0}
Dialog: 0,0:08:23.25,0:08:25.39,Default,,0,0,0,,{\an8}- Hae-in!\N- Hae-in!
Dialogue: 0,0:08:25.42,0:08:27.85,Default,,0,0,0,,Ini aku, Bu. Apakah Anda mengenali saya?
Dialog: 0,0:08:27.88,0:08:29.98,Default,,0,0,0,,Ya ampun. Apa kabarmu?
Dialog: 0,0:08:30.00,0:08:30.98,Default,,0,0,0,,Apakah kamu baik-baik saja sekarang?
Dialogue: 0,0:08:31.01,0:08:33.71,Default,,0,0,0,,Hae-in, pasti kasar.
Dialog: 0,0:08:38.39,0:08:40.30,Default,,0,0,0,,Halo.
Dialog: 0,0:08:41.56,0:08:43.30,Default,,0,0,0,,Ayah.
Dialog: 0,0:08:43.98,0:08:46.09,Default,,0,0,0,,Ibu. Tante.
Dialog: 0,0:08:48.69,0:08:50.64,Default,,0,0,0,,Hong Soo-cheol, Bu.
Dialogue: 0,0:08:52.86,0:08:54.34,Default,,0,0,0,,Aku sudah mendengar banyak tentangmu.
Dialogue: 0,0:08:54.36,0:08:57.90,Default,,0,0,0,,Kita harus makan kapan-kapan.
Dialog: 0,0:08:59.66,0:09:00.64,Default,,0,0,0,,Hae-in?
Dialog: 0,0:09:00.66,0:09:02.69,Default,,0,0,0,,Hae-in...
Dialog: 0,0:09:02.79,0:09:05.78,Default,,0,0,0,,sedikit lelah karena terbang.
Dialog: 0,0:09:06.25,0:09:09.02,Default,,0,0,0,,Dia harus pulang dan istirahat.
Dialog: 0,0:09:09.04,0:09:11.02,Default,,0,0,0,,Anda tidak punya hak untuk terlibat.
Dialog: 0,0:09:11.05,0:09:12.62,Default,,0,0,0,,Tn. Hong.
Dialog: 0,0:09:12.96,0:09:15.48,Default,,0,0,0,,Harap jaga sopan santunmu di depan Tuan Yoon.
Dialog: 0,0:09:15.51,0:09:17.07,Default,,0,0,0,,- Hae-in.\N- Hae-in.
Dialogue: 0,0:09:17.30,0:09:21.17,Default,,0,0,0,,Apakah kamu tahu apa yang dia lakukan terhadap keluarga kita?
Dialogue: 0,0:09:21.47,0:09:25.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka akan mengklaim aku menendang mereka\Nout dan mengambil alih Queens,{\c}{\i0}
Dialog: 0,0:09:25.35,0:09:26.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi inilah kenyataannya.{\c}{\i0}
Dialogue: 0,0:09:26.46,0:09:29.12,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ketua muak dengan\Nkeluarganya yang berebut uang,{\c}{\i0}
Dialog: 0,0:09:29.15,0:09:31.33,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dan memberitahuku posisinya sebelum dia meninggal.{\c}{\i0}
Dialogue: 0,0:09:31.36,0:09:33.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia juga meminta ibuku untuk mengambil alih asetnya.{\c}{\i0}
Dialogue: 0,0:09:33.47,0:09:35.67,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia ingin kamu mewarisi segalanya,{\c}{\i0}
Dialogue: 0,0:09:35.70,0:09:39.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi dia tahu keluarga tidak akan mengizinkannya.{\c}{\i0}
Dialogue: 0,0:09:39.41,0:09:40.80,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Yang disebut anggota keluargamu...{\c}{\i0}
Dialog: 0,0:09:40.83,0:09:44.28,Default,,0,0,0,,{\i1}{\c&HFFFF00&}senang mendengar kamu akan segera sekarat.{\c}{\i0}
Dialog: 0,0:09:45.75,0:09:47.10,Default,,0,0,0,,Tentu.
Dialogue: 0,0:09:47.12,0:09:50.31,Default,,0,0,0,,Saya punya gambaran kasarnya.\NI membaca banyak artikel berita juga.
Dialogue: 0,0:09:50.33,0:09:54.40,Default,,0,0,0,,Saya yakin kita tidak pernah\Ncukup dekat untuk menjadi sebahagia ini...
Dialog: 0,0:09:54.42,0:09:55.73,Default,,0,0,0,,tentang bertemu satu sama lain.
Dialogue: 0,0:09:55.76,0:09:57.57,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah keluargaku pernah menghubungiku?{\c}{\i0}
Dialogue: 0,0:09:57.59,0:09:59.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, dan mereka membicarakan hal yang sama.{\c}{\i0}
Dialogue: 0,0:09:59.89,0:10:02.78,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka menginginkan hak suara Anda\Nuntuk rapat pemegang saham.{\c}{\i0}
Dialogue: 0,0:10:02.81,0:10:05.45,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka khawatir karena saya ingin mempekerjakanmu kembali.{\c}{\i0}
Dialogue: 0,0:10:05.47,0:10:07.83,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka ingin berbicara denganmu, tapi aku menolaknya.{\c}{\i0}
Dialogue: 0,0:10:07.85,0:10:10.80,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Anda meminta saya melakukan itu sebelum operasi.{\c}{\i0}
Dialogue: 0,0:10:11.27,0:10:14.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kedatanganku ke sini sendirian untuk\Noperasi besar ini menunjukkan...{\c}{\i0}
Dialog: 0,0:10:14.40,0:10:16.84,Default,,0,0,0,,{\i1}{\c&HFFFF00&}hubungan seperti apa yang kita miliki.{\c}{\i0}
Dialogue: 0,0:10:16.86,0:10:18.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku pasti pernah hidup...{\c}{\i0}
Dialog: 0,0:10:18.95,0:10:19.92,Default,,0,0,0,,{\i1}{\c&HFFFF00&}kehidupan yang sepi.{\c}{\i0}
Dialogue: 0,0:10:19.95,0:10:21.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ya.{\c}{\i0}
Dialogue: 0,0:10:21.41,0:10:23.57,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu selalu sendirian,{\c}{\i0}
Dialog: 0,0:10:24.37,0:10:26.45,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tetapi hal yang sama berlaku untuk saya.{\c}{\i0}
Dialogue: 0,0:10:28.79,0:10:32.58,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Itulah sebabnya yang kita miliki hanyalah satu sama lain.{\c}{\i0}
Dialogue: 0,0:10:33.75,0:10:36.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jangan percaya pada keluargamu.{\c}{\i0}
Dialogue: 0,0:10:37.76,0:10:40.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya tidak ingin mereka mengeksploitasi Anda...{\c}{\i0}
Dialog: 0,0:10:40.59,0:10:42.13,Default,,0,0,0,,{\i1}{\c&HFFFF00&}lagi.{\c}{\i0}
Dialogue: 0,0:10:44.64,0:10:45.62,Default,,0,0,0,,Kamu salah.
Dialog: 0,0:10:45.64,0:10:48.83,Default,,0,0,0,,Aku tidak tahu apa yang dia katakan padamu,\Ntapi jangan percaya padanya.
Dialogue: 0,0:10:48.85,0:10:50.25,Default,,0,0,0,,Percayalah pada keluargamu.
Dialog: 0,0:10:50.27,0:10:53.67,Default,,0,0,0,,Kudengar kau membawa-bawa\Na jimat di dompetmu,
Dialog: 0,0:10:53.69,0:10:56.60,Default,,0,0,0,,berharap itu akan melemahkan energiku.
Dialog: 0,0:10:57.23,0:10:58.55,Default,,0,0,0,,Wow.
Dialog: 0,0:10:58.57,0:11:01.15,Default,,0,0,0,,- Anda memberitahunya?\N- Saya menyatakan fakta.
Dialog: 0,0:11:01.24,0:11:03.52,Default,,0,0,0,,Ibu memberikannya padaku.
Dialog: 0,0:11:06.20,0:11:09.07,Default,,0,0,0,,Itu tidak penting saat ini.
Dialog: 0,0:11:09.54,0:11:11.37,Default,,0,0,0,,- Hae-in...\N- Saya dengar...
Dialog: 0,0:11:11.46,0:11:14.73,Default,,0,0,0,,Anda menggugat saya untuk\Ndepartment store di Gwanggyo.
Dialog: 0,0:11:14.75,0:11:17.27,Default,,0,0,0,,Lalu aku langsung membatalkan gugatannya.
Dialog: 0,0:11:17.30,0:11:19.15,Default,,0,0,0,,Saya tidak mencoba untuk berkonfrontasi dengan Anda.
Dialogue: 0,0:11:19.17,0:11:21.99,Default,,0,0,0,,Aku hanya berharap kamu tidak menganggap kami jahat...
Dialog: 0,0:11:22.01,0:11:24.95,Default,,0,0,0,,dapat dihapus hanya karena saya kehilangan ingatan.
Dialog: 0,0:11:24.97,0:11:28.53,Default,,0,0,0,,Hae-in. Memang benar keluarga kami mempunyai masalah,
Dialog: 0,0:11:28.56,0:11:30.91,Default,,0,0,0,,tapi kami bisa menjelaskan semuanya.
Dialog: 0,0:11:30.94,0:11:33.33,Default,,0,0,0,,Ya, dan dia seharusnya tidak berada di sini.
Dialogue: 0,0:11:33.35,0:11:35.50,Default,,0,0,0,,Suamimu seharusnya ada di sini.
Dialog: 0,0:11:35.52,0:11:38.50,Default,,0,0,0,,Benar. Maksudmu mantan suamiku?
Dialogue: 0,0:11:38.53,0:11:41.94,Default,,0,0,0,,Siapa yang diam-diam menyiapkan\surat cerai sebelum aku mengetahuinya?
Dialogue: 0,0:11:42.15,0:11:43.81,Default,,0,0,0,,Apa?
Dialog: 0,0:11:44.53,0:11:46.51,Default,,0,0,0,,Itu benar, tapi...
Dialog: 0,0:11:46.53,0:11:49.64,Default,,0,0,0,,Kamu membuatnya terdengar sangat jahat,
Dialog: 0,0:11:49.66,0:11:51.31,Default,,0,0,0,,tapi ceritanya panjang.
Dialog: 0,0:11:51.33,0:11:54.32,Default,,0,0,0,,Kudengar dia dipenjara karena pembunuhan.
Dialogue: 0,0:12:03.38,0:12:05.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu tidak akan kemana-mana, kan?{\c}{\i0}
Dialogue: 0,0:12:05.14,0:12:08.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu harus berada di sini saat aku membuka mata.{\c}{\i0}
Dialog: 0,0:12:23.11,0:12:24.80,Default,,0,0,0,,{\i1}Kenapa kamu ingin pulang?{\i0}
Dialogue: 0,0:12:24.82,0:12:27.55,Default,,0,0,0,,Aku sudah punya tempat dimana kamu bisa tinggal.
Dialogue: 0,0:12:27.58,0:12:30.51,Default,,0,0,0,,Aku ingin kembali ke rumah\Ndan hidup seperti dulu.
Dialogue: 0,0:12:30.54,0:12:33.86,Default,,0,0,0,,Ini mungkin bisa membantuku mendapatkan kembali ingatanku.
Dialog: 0,0:12:34.50,0:12:36.41,Default,,0,0,0,,Saya ingin melakukan itu.
Dialogue: 0,0:12:37.04,0:12:41.06,Default,,0,0,0,,Saya khawatir\Nkeluarga Anda akan menghalangi Anda.
Dialogue: 0,0:12:41.09,0:12:44.57,Default,,0,0,0,,Orang tuamu menyulitkanmu untuk diterima kembali.
Dialogue: 0,0:12:44.59,0:12:46.98,Default,,0,0,0,,Para direktur terus mengklaim\Nbagaimana Anda tidak kompeten...
Dialog: 0,0:12:47.01,0:12:48.61,Default,,0,0,0,,- karena kondisi Anda.\N- Saya tahu.
Dialog: 0,0:12:48.64,0:12:50.07,Default,,0,0,0,,Saya akan pastikan itu tidak terjadi.
Dialog: 0,0:12:50.10,0:12:51.45,Default,,0,0,0,,Terima kasih atas perhatian Anda.
Dialogue: 0,0:12:51.47,0:12:53.84,Default,,0,0,0,,Kamu sudah cukup berterima kasih padaku.
Dialog: 0,0:12:55.52,0:12:57.64,Default,,0,0,0,, Tepati janjimu.
Dialogue: 0,0:12:57.94,0:12:59.67,Default,,0,0,0,,Kamu bilang kita akan menikah...
Dialog: 0,0:12:59.69,0:13:02.23,Default,,0,0,0,,setelah operasi.
Dialog: 0,0:13:03.36,0:13:06.86,Default,,0,0,0,,Serahkan persiapan pernikahan padaku.
Dialog: 0,0:13:21.42,0:13:22.56,Default,,0,0,0,,Halo.
Dialog: 0,0:13:22.59,0:13:24.57,Default,,0,0,0,,- Sudah lama tidak bertemu.\N- Saya punya pertanyaan.
Dialog: 0,0:13:24.59,0:13:28.32,Default,,0,0,0,,Ada kecelakaan mobil sebelum operasi Hae-in.
Dialog: 0,0:13:28.34,0:13:30.63,Default,,0,0,0,,- Apakah Anda di baliknya?\N- Ya.
Dialogue: 0,0:13:38.31,0:13:40.08,Default,,0,0,0,,Tapi dia tidak mati,
Dialog: 0,0:13:40.11,0:13:41.81,Default,,0,0,0,,jadi apa masalahnya?
Dialogue: 0,0:13:46.28,0:13:48.17,Default,,0,0,0,,Ada apa dengan tampilan itu? Anda tahu.
Dialog: 0,0:13:48.20,0:13:50.01,Default,,0,0,0,,Saya sudah memperingatkan Anda bahwa...
Dialogue: 0,0:13:50.03,0:13:53.61,Default,,0,0,0,,dia bisa terluka lagi jika kamu terus bersamanya,
Dialog: 0,0:13:54.54,0:13:55.85,Default,,0,0,0,,dan itu tidak akan berubah.
Dialog: 0,0:13:55.87,0:13:57.72,Default,,0,0,0,,Apakah kamu sudah selesai mengancamku?
Dialog: 0,0:13:57.75,0:14:00.08,Default,,0,0,0,,Kalau begitu giliranku.
Dialogue: 0,0:14:03.59,0:14:05.44,Default,,0,0,0,,Itu ruangan ini, bukan?
Dialog: 0,0:14:05.46,0:14:08.17,Default,,0,0,0,,Di mana Ketua Hong pingsan.
Dialogue: 0,0:14:09.18,0:14:11.45,Default,,0,0,0,,Saya melihat apa yang kamu lakukan melalui lukisan itu...
Dialogue: 0,0:14:11.47,0:14:14.05,Default,,0,0,0,,Aku menghadiahkannya.
Dialog: 0,0:14:20.86,0:14:22.92,Default,,0,0,0,,Saya punya bukti,
Dialog: 0,0:14:22.94,0:14:26.63,Default,,0,0,0,,jadi sentuh Hae-in sekali lagi,
Dialogue: 0,0:14:26.65,0:14:30.01,Default,,0,0,0,,dan aku akan menempatkanmu di belakang\Nbar seperti yang kulakukan pada Hyun-woo.
Dialog: 0,0:14:30.03,0:14:32.01,Default,,0,0,0,,Bagaimana...?
Dialogue: 0,0:14:32.03,0:14:34.59,Default,,0,0,0,,Beraninya kamu?
Dialog: 0,0:14:34.62,0:14:35.60,Default,,0,0,0,,Benar.
Dialogue: 0,0:14:35.62,0:14:37.85,Default,,0,0,0,,Akulah penghalangmu sekarang.
Dialog: 0,0:14:37.87,0:14:41.41,Default,,0,0,0,,Singkirkan aku jika kamu berani.
Dialogue: 0,0:14:49.13,0:14:52.60,Default,,0,0,0,,Bagaimana jika dia bilang dia akan menikahi Eun-sung?
Dialogue: 0,0:14:52.62,0:14:54.59,Default,,0,0,0,,- Tidak mungkin.\N- Saya yakin itu akan terjadi,
Dialog: 0,0:14:54.61,0:14:55.83,Default,,0,0,0,,dilihat dari apa yang saya lihat hari ini.
Dialogue: 0,0:14:55.86,0:14:56.94,Default,,0,0,0,,Dia orang yang berbeda.
Dialog: 0,0:14:56.97,0:14:59.26,Default,,0,0,0,,Tidak, dia tidak akan melakukan itu.
Dialogue: 0,0:14:59.52,0:15:01.91,Default,,0,0,0,,Sebenarnya, aku sudah mengawasinya.
Dialogue: 0,0:15:01.94,0:15:04.79,Default,,0,0,0,,Agen Detektif Hong Gil-dong?
Dialog: 0,0:15:04.82,0:15:07.88,Default,,0,0,0,,Ya, Gil-dong adalah nenek moyang keluarga kami.
Dialog: 0,0:15:07.90,0:15:09.88,Default,,0,0,0,,Orang-orang juga memanggilku "satu-satunya..."
Dialog: 0,0:15:09.90,0:15:11.63,Default,,0,0,0,,dan memuji banyak bakatku,
Dialogue: 0,0:15:11.66,0:15:13.73,Default,,0,0,0,,jadi saya simpan nama itu.
Dialog: 0,0:15:13.78,0:15:14.93,Default,,0,0,0,,Apa?
Dialog: 0,0:15:14.95,0:15:17.43,Default,,0,0,0,,Kurangi $10 juta dan\NBerikan $1,5 juta kepada Tuan Kim.
Dialogue: 0,0:15:17.45,0:15:18.51,Default,,0,0,0,,Bangunan bisa bertahan.
Dialog: 0,0:15:18.54,0:15:21.52,Default,,0,0,0,,- Saya membelinya karena bosan.\N- Tidak apa-apa. Dia juga seorang detektif.
Dialogue: 0,0:15:22.84,0:15:24.49,Default,,0,0,0,,Menyamar adalah sifat keduaku.
Dialog: 0,0:15:25.34,0:15:27.29,Default,,0,0,0,,Tn. Nam, keluarlah.
Dialogue: 0,0:15:28.42,0:15:30.50,Default,,0,0,0,,Mengintai adalah sifat keduaku.
Dialogue: 0,0:15:31.01,0:15:34.57,Default,,0,0,0,,Itu tangan kanan dan kiriku.
Dialogue: 0,0:15:34.60,0:15:37.20,Default,,0,0,0,,Mereka terlihat biasa saja, seperti yang bisa kamu lihat,
Dialog: 0,0:15:37.22,0:15:38.58,Default,,0,0,0,,sehingga mereka bisa masuk ke mana saja.
Dialog: 0,0:15:38.60,0:15:41.24,Default,,0,0,0,,Detektif Hong adalah otak agensi kami.
Dialogue: 0,0:15:41.27,0:15:43.96,Default,,0,0,0,,Dia selalu menjadi kutu buku dan terbiasa...
Dialog: 0,0:15:43.98,0:15:45.29,Default,,0,0,0,,bisnis yang berhubungan dengan buku.
Dialog: 0,0:15:45.31,0:15:47.21,Default,,0,0,0,,Bisnis apa?
Dialogue: 0,0:15:47.23,0:15:49.25,Default,,0,0,0,,Saya menjalankan toko buku komik.
Dialogue: 0,0:15:49.28,0:15:53.05,Default,,0,0,0,,Buku komik adalah database\Nterhebat yang berisi...
Dialog: 0,0:15:53.07,0:15:54.09,Default,,0,0,0,,semua jenis kasus.
Dialogue: 0,0:15:54.11,0:15:56.34,Default,,0,0,0,,Itulah fondasi pekerjaanku.
Dialogue: 0,0:15:56.37,0:15:59.10,Default,,0,0,0,,Kasus manakah yang sudah Anda selidiki?
Dialogue: 0,0:15:59.12,0:16:01.36,Default,,0,0,0,,Ada yang terkenal?
Dialog: 0,0:16:01.75,0:16:04.48,Default,,0,0,0,,Itulah yang harus kamu ketahui.
Dialog: 0,0:16:04.50,0:16:08.61,Default,,0,0,0,,Detektif yang kompeten\Ntidak akan menanyakan pertanyaan seperti itu.
Dialogue: 0,0:16:08.63,0:16:12.36,Default,,0,0,0,,Omong-omong, berapa\Nbiaya yang Anda ganti?
Dialog: 0,0:16:12.38,0:16:13.44,Default,,0,0,0,,Bu.
Dialogue: 0,0:16:13.47,0:16:16.53,Default,,0,0,0,,Izinkan saya mengajukan pertanyaan sepele.\NBerapa kompensasi makanannya?
Dialogue: 0,0:16:16.55,0:16:18.82,Default,,0,0,0,,Kami mengenakan biaya $8 per makanan, tapi agak ketat.
Dialogue: 0,0:16:18.85,0:16:21.41,Default,,0,0,0,,Seafood {\i1}jajangmyeon{\i0} berharga\N$12 di lingkungan kami.
Dialogue: 0,0:16:21.43,0:16:24.25,Default,,0,0,0,,- Apa?\N- Harga jaman sekarang gila kan?
Dialogue: 0,0:16:24.27,0:16:27.81,Default,,0,0,0,,Kita harus fokus pada\Nekonomi daripada tersangkanya.
Dialogue: 0,0:16:30.73,0:16:32.21,Default,,0,0,0,,Dia bungkam.
Dialog: 0,0:16:32.24,0:16:35.13,Default,,0,0,0,,Bibir rapat. Tuliskan itu.
Dialogue: 0,0:16:35.16,0:16:37.05,Default,,0,0,0,,Ya ampun.
Dialog: 0,0:16:37.07,0:16:39.73,Default,,0,0,0,,- Anda sudah berada di sini.\N- Ya, Pak.
Dialog: 0,0:16:40.37,0:16:41.60,Default,,0,0,0,,Kerja bagus.
Dialog: 0,0:16:41.62,0:16:43.10,Default,,0,0,0,,Siapa mereka?
Dialog: 0,0:16:43.12,0:16:46.94,Default,,0,0,0,,Mereka mengikuti Hae-in ke\NJerman dan terus mengabari saya.
Dialog: 0,0:16:46.96,0:16:50.69,Default,,0,0,0,,Agen Detektif Hong Gil-dong kami\Nakan selalu memberi Anda diskon.
Dialog: 0,0:16:50.71,0:16:53.71,Default,,0,0,0,,Kita mengawasi target kita,\Menganalisis penyebab dan psikologinya,
Dialog: 0,0:16:53.74,0:16:56.15,Default,,0,0,0,,menawarkan solusi, dan bahkan memberi Anda garansi.
Dialog: 0,0:16:56.18,0:16:58.49,Default,,0,0,0,,Kami menawarkan paket lengkap\Nas kami mengikuti target kami.
Dialog: 0,0:16:58.51,0:16:59.86,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:16:59.89,0:17:01.99,Default,,0,0,0,,Lumayan, kawan.
Dialogue: 0,0:17:02.02,0:17:03.58,Default,,0,0,0,,- Jadi beritahu aku.\N- Apa?
Dialogue: 0,0:17:03.60,0:17:05.56,Default,,0,0,0,,- Apa yang kamu temukan?\N- Kami akan memberitahumu sekarang.
Dialogue: 0,0:17:05.58,0:17:09.74,Default,,0,0,0,,Kau akan terbebas dari semua kekhawatiranmu.
Dialogue: 0,0:17:42.77,0:17:44.88,Default,,0,0,0,,Kenapa kosong sekali?
Dialog: 0,0:17:52.94,0:17:55.48,Default,,0,0,0,,Kami tidur di kamar yang berbeda.
Dialogue: 0,0:17:55.65,0:17:57.35,Default,,0,0,0,,Benarkah?
Dialog: 0,0:18:32.31,0:18:34.68,Default,,0,0,0,,Kami memiliki selera musik yang serupa.
Dialog: 0,0:18:37.69,0:18:39.98,Default,,0,0,0,,Tentu, itu mungkin.
Dialog: 0,0:18:42.28,0:18:44.30,Default,,0,0,0,,Orang macam apa dia?
Dialogue: 0,0:18:44.33,0:18:47.64,Default,,0,0,0,,Aku takkan terkalahkan jika aku mengenal musuhku dan diriku sendiri,
Dialog: 0,0:18:47.66,0:18:49.97,Default,,0,0,0,,tapi saya sendiri tidak tahu.
Dialog: 0,0:18:50.00,0:18:51.70,Default,,0,0,0,,Dalam hal ini,
Dialogue: 0,0:18:51.88,0:18:54.70,Default,,0,0,0,,bukankah setidaknya aku harus mengetahui musuhku?
Dialog: 0,0:19:04.05,0:19:05.45,Default,,0,0,0,,Ya.
Dialog: 0,0:19:05.47,0:19:08.20,Default,,0,0,0,,Ini adalah tempat teraman untuk melihatnya.
Dialogue: 0,0:19:08.23,0:19:09.91,Default,,0,0,0,,Betapa kejinya dia,
Dialog: 0,0:19:09.94,0:19:11.96,Default,,0,0,0,,bahwa dia ada di sini setelah mengintai mantan istrinya,
Dialog: 0,0:19:11.98,0:19:14.76,Default,,0,0,0,,siapa yang dia selingkuh, dan membunuh seseorang?
Dialogue: 0,0:19:16.69,0:19:20.00,Default,,0,0,0,,Aku pasti penilai karakter yang buruk.
Dialogue: 0,0:19:20.03,0:19:22.65,Default,,0,0,0,,Kenapa aku bisa jatuh cinta padanya?
Dialog: 0,0:20:04.70,0:20:06.23,Default,,0,0,0,,Hae-in.
Dialog: 0,0:20:08.58,0:20:10.57,Default,,0,0,0,,Duduklah, Tuan Baek.
Dialog: 0,0:20:25.97,0:20:27.61,Default,,0,0,0,,Apakah kamu sehat sekarang?
Dialog: 0,0:20:27.64,0:20:30.05,Default,,0,0,0,,Jika tidak, mengapa saya harus berada di sini?
Dialog: 0,0:20:31.56,0:20:33.55,Default,,0,0,0,,Apakah operasinya berjalan dengan baik?
Dialogue: 0,0:20:33.77,0:20:37.12,Default,,0,0,0,,Apakah Anda masih mendapatkan\Npengobatan? Apa anda kesakitan?
Dialog: 0,0:20:37.15,0:20:39.52,Default,,0,0,0,,Apakah kamu mengkhawatirkanku?
Dialog: 0,0:20:44.66,0:20:46.36,Default,,0,0,0,,Saya...
Dialog: 0,0:20:48.87,0:20:50.68,Default,,0,0,0,,Saya sangat khawatir.
Dialogue: 0,0:20:50.70,0:20:52.24,Default,,0,0,0,,Itu lucu.
Dialogue: 0,0:20:52.83,0:20:55.81,Default,,0,0,0,,Kamu pasti mengira aku bodoh\Nkarena aku kehilangan ingatan.
Dialog: 0,0:20:55.83,0:20:57.66,Default,,0,0,0,,Aku juga merindukanmu.
Dialog: 0,0:21:04.51,0:21:06.17,Default,,0,0,0,,Saya tahu segalanya.
Dialog: 0,0:21:06.43,0:21:08.78,Default,,0,0,0,,Aku tahu kenapa kamu menikah denganku,
Dialog: 0,0:21:08.80,0:21:12.41,Default,,0,0,0,,bagaimana Anda mempersiapkan perceraian,\Ndan apa yang Anda lakukan setelahnya.
Dialog: 0,0:21:12.43,0:21:15.22,Default,,0,0,0,,Saya mendengar dan memastikan semuanya.
Dialog: 0,0:21:16.77,0:21:18.41,Default,,0,0,0,,Hae-in.
Dialog: 0,0:21:18.44,0:21:21.71,Default,,0,0,0,,Aku tidak tahu apa yang dikatakan Eun-sung padamu,
Dialog: 0,0:21:21.73,0:21:23.69,Default,,0,0,0,,tapi tidak satupun yang benar.
Dialogue: 0,0:21:23.86,0:21:26.40,Default,,0,0,0,,Aku tahu kamu bingung,
Dialog: 0,0:21:26.53,0:21:27.51,Default,,0,0,0,,tapi jika kamu percaya padaku...
Dialog: 0,0:21:27.53,0:21:29.01,Default,,0,0,0,,Saya hanya percaya apa yang saya lihat.
Dialog: 0,0:21:29.03,0:21:31.22,Default,,0,0,0,,Surat cerai yang kamu siapkan di belakangku,
Dialogue: 0,0:21:31.24,0:21:33.76,Default,,0,0,0,,dan fakta bahwa kamu berada di\Nhere sebagai tersangka pembunuhan,
Dialog: 0,0:21:33.79,0:21:35.77,Default,,0,0,0,,adalah yang sudah saya konfirmasi.
Dialog: 0,0:21:35.79,0:21:38.02,Default,,0,0,0,,Lalu kenapa kamu datang ke sini?
Dialog: 0,0:21:38.04,0:21:41.16,Default,,0,0,0,,Jika Anda mengonfirmasi dan mengetahui segalanya,
Dialog: 0,0:21:41.50,0:21:43.54,Default,,0,0,0,,lalu kenapa kamu ada di sini?
Dialogue: 0,0:21:43.67,0:21:46.25,Default,,0,0,0,,Bukankah karena kamu ragu?
Dialog: 0,0:21:47.01,0:21:48.71,Default,,0,0,0,,Saya datang ke sini...
Dialog: 0,0:21:51.89,0:21:53.42,Default,,0,0,0,,karena...
Dialog: 0,0:21:56.14,0:21:58.14,Default,,0,0,0,,Katakan saja...
Dialogue: 0,0:21:58.85,0:22:01.81,Default,,0,0,0,,agar kita tidak bertemu lagi.
Dialog: 0,0:22:02.86,0:22:04.54,Default,,0,0,0,,Jujur saja, aku penasaran,
Dialog: 0,0:22:04.57,0:22:06.48,Default,,0,0,0,,tapi sekarang kita sudah bertemu,
Dialog: 0,0:22:06.65,0:22:08.21,Default,,0,0,0,,kita tidak akan bertemu lagi.
Dialog: 0,0:22:08.24,0:22:09.94,Default,,0,0,0,,Tidak.
Dialog: 0,0:22:10.45,0:22:12.98,Default,,0,0,0,,Kita bertemu lagi,
Dialogue: 0,0:22:13.74,0:22:15.95,Default,,0,0,0,,karena aku tidak akan menyerah.
Dialog: 0,0:22:16.54,0:22:18.68,Default,,0,0,0,,Aku akan tetap bersamamu.
Dialogue: 0,0:22:18.71,0:22:22.41,Default,,0,0,0,,Itu kaya, datang dari\Nseseorang yang dikurung.
Dialog: 0,0:22:36.35,0:22:38.22,Default,,0,0,0,,Saya berjanji...
Dialog: 0,0:22:40.73,0:22:43.64,Default,,0,0,0,,untuk menemanimu saat kamu bangun.
Dialog: 0,0:22:44.86,0:22:46.64,Default,,0,0,0,,Maaf saya tidak ada di sana.
Dialogue: 0,0:22:47.65,0:22:50.15,Default,,0,0,0,,Aku benar-benar minta maaf...
Dialog: 0,0:22:50.74,0:22:52.57,Default,,0,0,0,,kamu harus datang ke sini,
Dialog: 0,0:22:52.95,0:22:54.57,Default,,0,0,0,,tapi...
Dialog: 0,0:22:54.91,0:22:57.15,Default,,0,0,0,,Aku akan keluar, apa pun yang terjadi.
Dialogue: 0,0:22:57.50,0:22:59.57,Default,,0,0,0,,Aku janji ini padamu.
Dialogue: 0,0:22:59.62,0:23:00.88,Default,,0,0,0,,Jadi kamu...
Dialog: 0,0:23:00.90,0:23:01.93,Default,,0,0,0,,Narapidana 9971.
Dialog: 0,0:23:01.96,0:23:03.79,Default,,0,0,0,,Waktumu habis.
Dialog: 0,0:23:03.96,0:23:06.52,Default,,0,0,0,,Makan enak, jangan khawatir tentang apa pun,
Dialog: 0,0:23:06.55,0:23:08.55,Default,,0,0,0,,dan lanjutkan perawatan.
Dialog: 0,0:23:08.57,0:23:09.57,Default,,0,0,0,,Narapidana 9971.
Dialog: 0,0:23:09.59,0:23:12.15,Default,,0,0,0,,Tetap sehat saja.
Dialogue: 0,0:23:12.18,0:23:16.01,Default,,0,0,0,,Tolong lakukan itu untukku. Oke?
Dialog: 0,0:23:16.06,0:23:17.97,Default,,0,0,0,,Hae-in.
Dialog: 0,0:23:36.83,0:23:40.00,Default,,0,0,0,,{\i1}{\c&HFFFF&}Layanan Pemasyarakatan Korea{\c}{\i0}
Dialogue: 0,0:23:43.17,0:23:45.28,Default,,0,0,0,,Aku hampir membalasnya.
Dialog: 0,0:23:46.84,0:23:48.52,Default,,0,0,0,,Dia sangat licik.
Dialogue: 0,0:23:48.55,0:23:51.29,Default,,0,0,0,,Bagaimana dia bisa begitu menipu, bahkan sebagai seorang narapidana?
Dialogue: 0,0:23:51.55,0:23:54.82,Default,,0,0,0,,Aku bisa mengerti bagaimana dia menipuku di masa lalu.
Dialogue: 0,0:23:54.85,0:23:58.42,Default,,0,0,0,,Dia sungguh fasih.
Dialogue: 0,0:24:08.32,0:24:11.06,Default,,0,0,0,,Saya butuh obat mual. Hatiku...
Dialogue: 0,0:24:11.49,0:24:13.67,Default,,0,0,0,,adalah balapan.
Dialogue: 0,0:24:13.70,0:24:15.17,Default,,0,0,0,,Aku merasa mual.
Dialogue: 0,0:24:15.20,0:24:17.97,Default,,0,0,0,,Aku kehabisan tenaga.
Dialog: 0,0:24:17.99,0:24:19.69,Default,,0,0,0,,Satu menit.
Dialog: 0,0:24:22.79,0:24:25.66,Default,,0,0,0,,Aku pusing sekali, aku ingin menangis.
Dialog: 0,0:24:31.01,0:24:32.71,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:24:42.98,0:24:45.39,Default,,0,0,0,,Dari mana saja kamu?
Dialog: 0,0:24:46.65,0:24:48.58,Default,,0,0,0,,Kenapa kamu ada di sini?
Dialogue: 0,0:24:48.61,0:24:51.56,Default,,0,0,0,,Jawab aku dulu. Kemana saja kamu?
Dialog: 0,0:24:53.20,0:24:55.15,Default,,0,0,0,,Saya tidak ingin menjawab.
Dialog: 0,0:24:55.28,0:24:56.97,Default,,0,0,0,,Bisakah kamu pergi?
Dialog: 0,0:24:56.99,0:25:00.69,Default,,0,0,0,,Saya tidak ingin siapa pun berada di sini\Ntanpa izin saya, meskipun itu Anda.
Dialog: 0,0:25:01.62,0:25:03.15,Default,,0,0,0,,Benar.
Dialog: 0,0:25:03.66,0:25:04.64,Default,,0,0,0,,Maaf,
Dialogue: 0,0:25:04.66,0:25:07.31,Default,,0,0,0,,tapi kamu masih menerima\Npengobatan, dan sudah kubilang.
Dialog: 0,0:25:07.33,0:25:09.94,Default,,0,0,0,,Kamu berada dalam bahaya berkali-kali.
Dialog: 0,0:25:09.96,0:25:10.98,Default,,0,0,0,,Saya tahu,
Dialog: 0,0:25:11.00,0:25:13.19,Default,,0,0,0,,dan Hyun-woo ada di belakang mereka,
Dialogue: 0,0:25:13.22,0:25:15.83,Default,,0,0,0,,tapi dia dikurung, jadi bukankah aku aman?
Dialogue: 0,0:25:18.26,0:25:20.05,Default,,0,0,0,,Aku hanya...
Dialog: 0,0:25:25.06,0:25:27.83,Default,,0,0,0,,cemas saat kamu tidak ada,
Dialog: 0,0:25:27.85,0:25:29.97,Default,,0,0,0,,karena hal-hal terus terjadi.
Dialogue: 0,0:25:31.61,0:25:34.73,Default,,0,0,0,,Maaf sudah membuatmu khawatir.
Dialog: 0,0:25:39.28,0:25:40.82,Default,,0,0,0,,Baiklah.
Dialog: 0,0:25:41.79,0:25:43.32,Default,,0,0,0,,Istirahat.
Dialog: 0,0:26:31.46,0:26:35.33,Default,,0,0,0,,Tidak mungkin. Saya kira rumor\Ntentang pernikahan mereka benar.
Dialog: 0,0:26:35.76,0:26:37.82,Default,,0,0,0,,Apakah Direktur Baek sudah selesai?
Dialog: 0,0:26:37.84,0:26:39.03,Default,,0,0,0,,Perhatikan apa yang kamu katakan.
Dialog: 0,0:26:39.05,0:26:40.99,Default,,0,0,0,,Kita semua menandatangani NDA,
Dialog: 0,0:26:41.01,0:26:43.57,Default,,0,0,0,,- terutama Anda.\N- Apa yang perlu dikhawatirkan?
Dialog: 0,0:26:43.60,0:26:45.80,Default,,0,0,0,,Saya tidak lagi bekerja untuknya.
Dialog: 0,0:26:46.52,0:26:48.43,Default,,0,0,0,,Kita tidak akan bertemu satu sama lain.
Dialog: 0,0:26:51.86,0:26:53.56,Default,,0,0,0,,Ms. Hong!
Dialog: 0,0:26:54.36,0:26:55.58,Default,,0,0,0,,Halo.
Dialog: 0,0:26:55.61,0:26:57.38,Default,,0,0,0,,Saya mendengar tentang Anda.
Dialogue: 0,0:26:57.40,0:26:59.41,Default,,0,0,0,,Apakah kamu sudah lebih baik sekarang?
Dialog: 0,0:26:59.43,0:27:00.42,Default,,0,0,0,,Ya.
Dialogue: 0,0:27:00.45,0:27:02.47,Default,,0,0,0,,Aku benar-benar lega. Benar-benar.
Dialog: 0,0:27:02.49,0:27:05.68,Default,,0,0,0,,Terima kasih atas pembayaran\Nbiaya operasi dan rumah sakit Anda,
Dialog: 0,0:27:05.70,0:27:06.76,Default,,0,0,0,,Cho-rong...
Dialog: 0,0:27:06.79,0:27:09.52,Default,,0,0,0,,Dia punya nama asli sekarang.
Dialogue: 0,0:27:09.54,0:27:10.98,Default,,0,0,0,,So-yul.
Dialogue: 0,0:27:11.00,0:27:13.66,Default,,0,0,0,,So-yul sehat sekarang.
Dialog: 0,0:27:15.00,0:27:16.19,Default,,0,0,0,,Saya senang.
Dialog: 0,0:27:16.21,0:27:18.87,Default,,0,0,0,,Terima kasih banyak. Saya tidak akan pernah melupakan ini.
Dialog: 0,0:27:27.18,0:27:28.91,Default,,0,0,0,,- Apa aku melakukannya?\N- Maaf?
Dialogue: 0,0:27:28.93,0:27:30.79,Default,,0,0,0,,Benarkah aku melakukan apa yang dia katakan?
Dialog: 0,0:27:30.81,0:27:34.01,Default,,0,0,0,,Saya tidak yakin. Itu sebelum saya dipekerjakan.
Dialog: 0,0:27:37.73,0:27:39.80,Default,,0,0,0,,Terima kasih telah menepati janjimu.
Dialog: 0,0:27:39.82,0:27:42.40,Default,,0,0,0,,Janji? Janji apa?
Dialogue: 0,0:27:42.78,0:27:47.61,Default,,0,0,0,,Anda berjanji akan mengembalikan sebelum saya selesai\Nmelunasi cicilan ini.
Dialogue: 0,0:27:48.37,0:27:49.81,Default,,0,0,0,,Jadi kamu sekretarisku?
Dialog: 0,0:27:49.83,0:27:50.93,Default,,0,0,0,,Ya.
Dialogue: 0,0:27:50.96,0:27:52.60,Default,,0,0,0,,Maka kamu pasti tahu banyak tentang aku.
Dialog: 0,0:27:52.62,0:27:56.31,Default,,0,0,0,,Tentu saja. Anggaplah saya sebagai hard drive eksternal\Nhuman.
Dialog: 0,0:27:57.88,0:27:59.44,Default,,0,0,0,,Dalam hal ini,
Dialogue: 0,0:27:59.46,0:28:01.37,Default,,0,0,0,,orang seperti apa saya ini?
Dialog: 0,0:28:02.09,0:28:03.78,Default,,0,0,0,,Yah...
Dialog: 0,0:28:03.80,0:28:04.86,Default,,0,0,0,,Kamu...
Dialog: 0,0:28:04.89,0:28:06.59,Default,,0,0,0,,Ms. Hong.
Dialog: 0,0:28:07.14,0:28:09.08,Default,,0,0,0,,Ms. Hong, aku sangat gembira mendengarnya...
Dialogue: 0,0:28:09.10,0:28:12.04,Default,,0,0,0,,kamu kembali. Apakah kamu baik-baik saja sekarang?
Dialogue: 0,0:28:12.06,0:28:14.81,Default,,0,0,0,,Dia karyawan yang kamu kenal.
Dialog: 0,0:28:14.84,0:28:15.83,Default,,0,0,0,,Halo.
Dialog: 0,0:28:15.86,0:28:17.42,Default,,0,0,0,,Terima kasih,
Dialogue: 0,0:28:17.44,0:28:21.13,Default,,0,0,0,,ibu saya menerima semua\Nperawatannya dan meninggal dunia dengan damai.
Dialog: 0,0:28:21.15,0:28:24.84,Default,,0,0,0,,Anda mengirim bunga kepadanya\Npemakaman, menanggung biayanya,
Dialog: 0,0:28:24.86,0:28:26.26,Default,,0,0,0,,dan bahkan datang.
Dialogue: 0,0:28:26.28,0:28:28.80,Default,,0,0,0,,Kamu mungkin tidak ingat, tapi aku akan selalu mengingatnya.
Dialog: 0,0:28:28.83,0:28:30.57,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:28:30.79,0:28:32.82,Default,,0,0,0,,Tidak masalah.
Dialogue: 0,0:28:38.59,0:28:42.86,Default,,0,0,0,,Saya mengirim bunga ke pemakaman\Nanggota keluarga karyawan saya?
Dialogue: 0,0:28:42.88,0:28:44.94,Default,,0,0,0,,Betapa sensitifnya aku.
Dialog: 0,0:28:44.97,0:28:48.21,Default,,0,0,0,,- Itu Direktur Baek...\N- Apa?
Dialogue: 0,0:28:48.68,0:28:49.66,Default,,0,0,0,,Bukan apa-apa.
Dialogue: 0,0:28:49.68,0:28:51.41,Default,,0,0,0,,Kamu orang baik.
Dialogue: 0,0:28:51.43,0:28:55.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sudah saatnya kita menghentikan semua merek...{\c}{\i0}
Dialog: 0,0:28:55.31,0:28:57.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}yang menghambat penjualan kami.{\c}{\i0}
Dialogue: 0,0:28:57.31,0:28:59.56,Default,,0,0,0,,Kamu berhati hangat.
Dialog: 0,0:29:00.73,0:29:03.31,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah ini kreatif? Bagian mana? Bagaimana caranya?{\c}{\i0}
Dialogue: 0,0:29:03.45,0:29:04.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku hanya penasaran saja.{\c}{\i0}
Dialog: 0,0:29:04.99,0:29:06.05,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Jawab aku.{\c}{\i0}
Dialogue: 0,0:29:06.07,0:29:08.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagian yang mana? Bagaimana? Kenapa?!{\c}{\i0}
Dialogue: 0,0:29:08.49,0:29:11.76,Default,,0,0,0,,- Kamu juga baik hati.\N- Apa aku benar-benar suka...
Dialogue: 0,0:29:11.79,0:29:14.70,Default,,0,0,0,,Bunda Teresa?
Dialog: 0,0:29:16.12,0:29:17.56,Default,,0,0,0,,Ya, saya kira.
Dialogue: 0,0:29:17.58,0:29:19.40,Default,,0,0,0,,Aku mengetahuinya.
Dialog: 0,0:29:19.42,0:29:21.48,Default,,0,0,0,,Saya melihat kucing liar dalam perjalanan ke sini,
Dialog: 0,0:29:21.50,0:29:24.23,Default,,0,0,0,,dan aku ingin memberinya camilan,
Dialog: 0,0:29:24.26,0:29:25.82,Default,,0,0,0,,jadi aku membeli beberapa dan memberinya makan.
Dialogue: 0,0:29:25.84,0:29:29.50,Default,,0,0,0,,Rasanya aku putus asa untuk berbuat baik.
Dialog: 0,0:29:29.72,0:29:32.20,Default,,0,0,0,,Saya mungkin kehilangan ingatan,
Dialog: 0,0:29:32.22,0:29:35.51,Default,,0,0,0,,tapi sifat asliku masih tetap ada.
Dialogue: 0,0:29:37.77,0:29:39.75,Default,,0,0,0,,Kuharap kita rukun.
Dialog: 0,0:29:39.77,0:29:41.79,Default,,0,0,0,,- Maaf?\N- Anda adalah hard drive eksternal saya.
Dialogue: 0,0:29:41.82,0:29:44.71,Default,,0,0,0,,Saya seperti motherboard yang\Nsudah menjalani reset pabrik.
Dialog: 0,0:29:44.74,0:29:48.06,Default,,0,0,0,,Saya memerlukan hard\Ndrive eksternal yang berisi data saya.
Dialog: 0,0:29:50.95,0:29:53.68,Default,,0,0,0,,Tapi saya di departemen lain.
Dialog: 0,0:29:53.70,0:29:55.61,Default,,0,0,0,,Aku akan mengurusnya.
Dialog: 0,0:29:58.29,0:30:00.98,Default,,0,0,0,,Lihat catatan bukti penuntut.
Dialog: 0,0:30:01.00,0:30:03.11,Default,,0,0,0,,- Apa? Mengapa?\N- Ini kasus pembunuhan.
Dialogue: 0,0:30:03.13,0:30:05.35,Default,,0,0,0,,Mereka ingin mengumpulkan\Nbukti sebanyak mungkin.
Dialog: 0,0:30:05.37,0:30:08.36,Default,,0,0,0,,Jika ada sesuatu yang\Ntidak mereka serahkan sebagai bukti,
Dialog: 0,0:30:08.38,0:30:10.50,Default,,0,0,0,,itu pasti menguntungkan kita.
Dialog: 0,0:30:14.10,0:30:17.20,Default,,0,0,0,,Jadi bukti yang tidak mereka serahkan...
Dialog: 0,0:30:17.23,0:30:20.18,Default,,0,0,0,,apakah ini analisis komponen\Njejak bukti di TKP?
Dialog: 0,0:30:20.21,0:30:22.12,Default,,0,0,0,,Ya, sepotong serat hijau.
Dialogue: 0,0:30:22.15,0:30:24.54,Default,,0,0,0,,- Jadi ini bukan milik Hyun-woo.\N- Itu sebabnya mereka menghilangkannya.
Dialog: 0,0:30:24.57,0:30:27.52,Default,,0,0,0,,Saya pikir itu dari pakaian pembunuh sebenarnya,
Dialog: 0,0:30:28.15,0:30:29.80,Default,,0,0,0,,dan kita perlu menemukannya.
Dialogue: 0,0:30:29.82,0:30:31.68,Default,,0,0,0,,{\i1}Pisau yang digunakan sebagai senjata pembunuh...{\i0}
Dialog: 0,0:30:31.70,0:30:33.68,Default,,0,0,0,, memang milikku.
Dialogue: 0,0:30:33.70,0:30:35.86,Default,,0,0,0,,Jadi kenapa ada disana?
Dialog: 0,0:30:36.25,0:30:37.81,Default,,0,0,0,,- Mungkin dicuri.\N- Saya yakin...
Dialog: 0,0:30:37.84,0:30:40.48,Default,,0,0,0,,hilang beberapa hari\Nsebelum kami berangkat ke Jerman.
Dialogue: 0,0:30:40.51,0:30:42.95,Default,,0,0,0,,- Tapi aku tidak terlalu memikirkannya.\N- Jadi itu dicuri.
Dialog: 0,0:30:42.98,0:30:44.37,Default,,0,0,0,,Saya akan memeriksa kamera CCTV.
Dialog: 0,0:30:44.40,0:30:46.40,Default,,0,0,0,,Satu lagi. Silakan periksa kamera dasbor bus...
Dialog: 0,0:30:46.42,0:30:49.11,Default,,0,0,0,,yang beroperasi di dekat lokasi\Nsekitar waktu pembunuhan.
Dialogue: 0,0:30:49.13,0:30:53.71,Default,,0,0,0,,Mungkin ada mobil yang mencurigakan,\Atau si pembunuh tidak bisa naik bus.
Dialog: 0,0:30:56.72,0:30:58.62,Default,,0,0,0,,Halo. Seberapa sering itu terhapus?
Dialog: 0,0:30:58.64,0:31:00.70,Default,,0,0,0,,Pak, bolehkah saya menanyakan sesuatu?
Dialog: 0,0:31:00.73,0:31:04.39,Default,,0,0,0,,Apakah ada kamera di dekat lokasi pemancingan?
Dialogue: 0,0:31:11.36,0:31:14.33,Default,,0,0,0,,Ayah, aku singkirkan semuanya dari atap.
Dialog: 0,0:31:14.35,0:31:15.39,Default,,0,0,0,,Singkirkan apa?
Dialogue: 0,0:31:15.41,0:31:16.85,Default,,0,0,0,,Burung gagak menangis sepanjang hari.
Dialog: 0,0:31:16.87,0:31:19.43,Default,,0,0,0,,Hei. Saya senang Anda melakukan\Nitu sebelum sidang hari ini.
Dialog: 0,0:31:19.46,0:31:20.60,Default,,0,0,0,,Maksudku...
Dialog: 0,0:31:20.62,0:31:23.52,Default,,0,0,0,,Saya tahu sidang akan berjalan dengan baik.
Dialog: 0,0:31:23.54,0:31:25.24,Default,,0,0,0,,Saya bersedia,
Dialog: 0,0:31:25.55,0:31:26.98,Default,,0,0,0,,tapi gagak tidak disukai.
Dialog: 0,0:31:27.01,0:31:29.12,Default,,0,0,0,,Astaga, sudah makan saja.
Dialog: 0,0:31:30.17,0:31:31.94,Default,,0,0,0,,Sayang.
Dialog: 0,0:31:31.97,0:31:34.96,Default,,0,0,0,,- Bukan bejana.\N- Kenapa tidak?
Dialogue: 0,0:31:35.14,0:31:36.87,Default,,0,0,0,,Anda akan membungkusnya.
Dialogue: 0,0:31:36.89,0:31:41.45,Default,,0,0,0,,Kalian semua dilarang\Nmembungkus, mencelupkan, atau mencampur...
Dialogue: 0,0:31:41.48,0:31:42.54,Default,,0,0,0,,makanan apa saja hari ini.
Dialogue: 0,0:31:42.56,0:31:45.08,Default,,0,0,0,,Jangan jatuhkan apa pun juga.
Dialogue: 0,0:31:45.11,0:31:47.59,Default,,0,0,0,,Rasanya tidak menyenangkan...
Dialog: 0,0:31:47.61,0:31:49.56,Default,,0,0,0,,jika ya.
Dialog: 0,0:31:50.65,0:31:52.01,Default,,0,0,0,,Selamat pagi.
Dialog: 0,0:31:52.03,0:31:53.47,Default,,0,0,0,,Aduh, dingin.
Dialogue: 0,0:31:53.49,0:31:57.23,Default,,0,0,0,,Da-hye lelah dan ingin tidur.
Dialog: 0,0:32:03.54,0:32:06.06,Default,,0,0,0,,Tidak, itu tidak dihitung.
Dialogue: 0,0:32:06.09,0:32:08.11,Default,,0,0,0,,Mereka tidak jatuh.
Dialog: 0,0:32:08.13,0:32:11.40,Default,,0,0,0,,Soo-cheol baru saja menempatkannya...
Dialog: 0,0:32:11.42,0:32:12.94,Default,,0,0,0,,di lantai...
Dialog: 0,0:32:12.97,0:32:15.79,Default,,0,0,0,,seperti ini.
Dialogue: 0,0:32:16.01,0:32:18.70,Default,,0,0,0,,Dia benar. Anda menempatkannya...
Dialog: 0,0:32:18.72,0:32:20.45,Default,,0,0,0,,di lantai, bukan?
Dialog: 0,0:32:20.48,0:32:22.49,Default,,0,0,0,,Tidak, saya menjatuhkannya,
Dialogue: 0,0:32:22.52,0:32:24.83,Default,,0,0,0,,tapi aku cukup santai dan tidak mempermasalahkannya.
Dialogue: 0,0:32:24.85,0:32:29.56,Default,,0,0,0,,Aku akan membungkusnya dengan bejana,\Nmencelupkannya ke dalam sup...
Dialogue: 0,0:32:30.36,0:32:33.02,Default,,0,0,0,,Sup ini enak banget bu.
Dialog: 0,0:32:36.82,0:32:39.80,Default,,0,0,0,,Terdakwa berada di dekat TKP\N sekitar perkiraan waktu...
Dialog: 0,0:32:39.83,0:32:43.27,Default,,0,0,0,,kematian korban antara jam 8 dan 9 malam.
Dialog: 0,0:32:43.29,0:32:46.77,Default,,0,0,0,,Ditambah lagi, rambut terdakwa\Nditemukan di dalam mobil korban.
Dialog: 0,0:32:46.79,0:32:49.14,Default,,0,0,0,,Darah korban dan\Nsidik jari terdakwa...
Dialog: 0,0:32:49.17,0:32:50.85,Default,,0,0,0,,juga ditemukan pada senjata pembunuh.
Dialog: 0,0:32:50.88,0:32:53.98,Default,,0,0,0,,Oleh karena itu, kami ingin\Nmendakwa Baek Hyun-woo atas pembunuhan.
Dialogue: 0,0:32:54.01,0:32:56.25,Default,,0,0,0,,Apakah Anda mengakui tuduhan ini?
Dialog: 0,0:32:57.47,0:32:58.45,Default,,0,0,0,,Tidak, Yang Mulia.
Dialogue: 0,0:32:58.47,0:33:02.66,Default,,0,0,0,,Memang benar aku sudah setuju untuk\Nbertemu korban hari itu,
Dialog: 0,0:33:02.68,0:33:04.24,Default,,0,0,0,,tapi dia tidak pernah muncul.
Dialog: 0,0:33:04.27,0:33:06.68,Default,,0,0,0,,Oleh karena itu, aku tidak pernah melihatnya.
Dialogue: 0,0:33:06.94,0:33:09.46,Default,,0,0,0,,Pembela boleh menyampaikan argumennya.
Dialog: 0,0:33:09.48,0:33:10.63,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:33:10.65,0:33:12.38,Default,,0,0,0,,Klien saya mengaku tidak bersalah...
Dialog: 0,0:33:12.40,0:33:15.13,Default,,0,0,0,,sejak awal penyelidikan ini.
Dialogue: 0,0:33:15.15,0:33:17.34,Default,,0,0,0,,Jika benar, pembunuh sebenarnya ada di luar sana.
Dialogue: 0,0:33:17.37,0:33:21.43,Default,,0,0,0,,Mari kita lihat pembunuhan\Nsenjata yang dituntut oleh penuntut...
Dialog: 0,0:33:21.45,0:33:23.14,Default,,0,0,0,,untuk menjadi bukti paling menentukan.
Dialogue: 0,0:33:23.16,0:33:24.77,Default,,0,0,0,,Pisau dapur ada bekasnya...
Dialog: 0,0:33:24.79,0:33:27.37,Default,,0,0,0,,sidik jari terdakwa, darah korban,
Dialog: 0,0:33:27.88,0:33:30.87,Default,,0,0,0,,serta sepotong akrilik hijau.
Dialogue: 0,0:33:31.05,0:33:33.82,Default,,0,0,0,,Seperti yang bisa kamu lihat,\Nterdakwa tidak mengenakan pakaian berwarna hijau.
Dialogue: 0,0:33:33.84,0:33:37.07,Default,,0,0,0,,Meski begitu, itu tidak bisa membuktikan\Nit itu milik orang lain.
Dialog: 0,0:33:37.09,0:33:38.49,Default,,0,0,0,,Saya setuju.
Dialogue: 0,0:33:38.51,0:33:42.01,Default,,0,0,0,,Namun, bagaimana jika seseorang berpakaian hijau...
Dialog: 0,0:33:42.39,0:33:46.20,Default,,0,0,0,,mencuri pisau dari rumahnya...
Dialog: 0,0:33:46.23,0:33:49.97,Default,,0,0,0,,yang ditemukan di dekat TKP?
Dialog: 0,0:34:05.08,0:34:06.35,Default,,0,0,0,,Itu pisau.
Dialogue: 0,0:34:06.37,0:34:08.45,Default,,0,0,0,,Ya, kamu benar.
Dialogue: 0,0:34:09.67,0:34:12.40,Default,,0,0,0,,Itu adalah pisau yang digunakan dalam pembunuhan.
Dialogue: 0,0:34:12.42,0:34:15.23,Default,,0,0,0,,Dia kebetulan juga memakai warna hijau.
Dialog: 0,0:34:15.26,0:34:17.21,Default,,0,0,0,,Tolong, cuplikan selanjutnya.
Dialog: 0,0:34:17.97,0:34:20.61,Default,,0,0,0,,{\i1}Orang yang sama terlihat terbakar...{\i0}
Dialog: 0,0:34:20.64,0:34:23.41,Default,,0,0,0,,Kaus, sarung tangan, dan\Npakaian lain yang jaraknya lebih dari satu mil...
Dialog: 0,0:34:23.43,0:34:24.99,Default,,0,0,0,,dari TKP.
Dialog: 0,0:34:25.02,0:34:28.20,Default,,0,0,0,,Saya meminta analisis\Nserat yang terbakar dan yang...
Dialog: 0,0:34:28.23,0:34:30.25,Default,,0,0,0,,ditemukan pada senjata pembunuh.
Dialog: 0,0:34:30.27,0:34:32.33,Default,,0,0,0,,Spektrofotometer inframerah menunjukkan...
Dialog: 0,0:34:32.36,0:34:34.96,Default,,0,0,0,,...bahwa serat-serat ini identik,
Dialog: 0,0:34:34.98,0:34:37.80,Default,,0,0,0,,dan darah korban dan\NDNA ditemukan di T-shirt.
Dialogue: 0,0:34:37.82,0:34:39.76,Default,,0,0,0,,Ini semua adalah bukti tidak langsung.
Dialog: 0,0:34:39.78,0:34:43.09,Default,,0,0,0,,Senjata pembunuh hanya memiliki\Njejak sidik jari terdakwa.
Dialogue: 0,0:34:43.12,0:34:46.06,Default,,0,0,0,,Bagaimana jika saya punya bukti yang lebih pasti?
Dialog: 0,0:34:46.08,0:34:48.34,Default,,0,0,0,,Misalnya, foto dan\Nvideo TKP...
Dialog: 0,0:34:48.36,0:34:50.81,Default,,0,0,0,,pembunuhnya mengambil dirinya sendiri.
Dialog: 0,0:34:50.83,0:34:53.40,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia pasti mengambil foto atau video.{\c}{\i0}
Dialog: 0,0:34:53.42,0:34:54.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kami membutuhkan ponselnya.{\c}{\i0}
Dialogue: 0,0:34:54.80,0:34:57.23,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah maksud Anda dia mencatat kejahatannya sendiri?{\c}{\i0}
Dialog: 0,0:34:57.26,0:35:00.63,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ya, jika dia pembunuh bayaran.{\c}{\i0}
Dialog: 0,0:35:01.05,0:35:02.78,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia memerlukan bukti untuk mendapatkan bayaran.{\c}{\i0}
Dialog: 0,0:35:02.80,0:35:05.21,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia perlu mengeklik URL ini.{\c}{\i0}
Dialog: 0,0:35:07.68,0:35:09.31,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Item Anda akan dikirimkan pada pukul 14.00{\c}{\i0}
Dialog: 0,0:35:09.34,0:35:10.33,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Menyalin...{\c}{\i0}
Dialogue: 0,0:35:10.35,0:35:13.17,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Dia berhasil. Sekarang saya dapat menduplikasi ponselnya!{\c}{\i0}
Dialog: 0,0:35:13.19,0:35:14.92,Default,,0,0,0,,Seseorang anonim...
Dialog: 0,0:35:14.94,0:35:16.16,Default,,0,0,0,,mengirimkan saya foto dan video...
Dialog: 0,0:35:16.18,0:35:18.63,Default,,0,0,0,,dari TKP yang\Nada di ponsel si pembunuh.
Dialog: 0,0:35:18.65,0:35:20.59,Default,,0,0,0,,- Saya akan serahkan ini sebagai bukti.\N- Keberatan.
Dialogue: 0,0:35:20.61,0:35:23.18,Default,,0,0,0,,Kami tidak menyetujui bukti ini sebelumnya.
Dialogue: 0,0:35:23.20,0:35:26.05,Default,,0,0,0,,Bisa saja diperoleh\Nillegal. Tolong abaikan itu.
Dialog: 0,0:35:26.08,0:35:30.16,Default,,0,0,0,,Bukti yang menentukan ini\Nakan sangat mempengaruhi persidangan!
Dialog: 0,0:35:42.76,0:35:44.57,Default,,0,0,0,,{\i1}{\c&HFFFF&}Bangku{\c}{\i0}
Dialogue: 0,0:35:44.60,0:35:46.13,Default,,0,0,0,,Saya terima.
Dialog: 0,0:36:06.45,0:36:09.15,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pembunuh sebenarnya dari Pembunuhan Waduk Yeongjin-gun\NSambang...{\c}{\i0}
Dialog: 0,0:36:09.17,0:36:10.22,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}telah ditangkap.{\c}{\i0}
Dialog: 0,0:36:10.25,0:36:12.39,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Penjaga Pantai Busan menangkap Yoo,{\c}{\i0}
Dialog: 0,0:36:12.42,0:36:14.73,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}yang mencoba\Nmenyembunyikan perahu nelayan...{\c}{\i0}
Dialog: 0,0:36:14.75,0:36:17.48,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jam 11 tadi malam sekitar 9 mil laut selatan.{\c}{\i0}
Dialog: 0,0:36:17.50,0:36:21.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoo mengaku dia melakukan\Nkejahatan itu seorang diri.{\c}{\i0}
Dialog: 0,0:36:21.38,0:36:24.24,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sementara itu, Baek yang\Ditangkap sebagai tersangka,{\c}{\i0}
Dialog: 0,0:36:24.26,0:36:26.86,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dibebaskan pada sidang pertama hari ini.{\c}{\i0}
Dialog: 0,0:36:26.89,0:36:29.17,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia segera dibebaskan.{\c}{\i0}
Dialog: 0,0:36:30.93,0:36:32.37,Default,,0,0,0,,Kenapa dia tidak keluar?
Dialogue: 0,0:36:32.39,0:36:34.20,Default,,0,0,0,,Apa terjadi sesuatu?
Dialog: 0,0:36:34.23,0:36:36.12,Default,,0,0,0,,Dia akan keluar saat waktunya tiba.
Dialog: 0,0:36:36.15,0:36:38.63,Default,,0,0,0,,Mengapa kita ada di sini?
Dialogue: 0,0:36:38.65,0:36:41.84,Default,,0,0,0,,Aku harus waspada,\Nkarena penguntitku yang berbahaya...
Dialog: 0,0:36:41.86,0:36:44.61,Default,,0,0,0,,- telah dibebaskan.\N- Dia tidak menguntit...
Dialog: 0,0:36:44.95,0:36:47.80,Default,,0,0,0,,Sejujurnya, kamu lebih seperti penguntit.
Dialog: 0,0:36:47.83,0:36:50.11,Default,,0,0,0,,- Aku tidak...\N- Itu dia.
Dialog: 0,0:36:55.88,0:36:57.70,Default,,0,0,0,,Di sini!
Dialogue: 0,0:36:57.96,0:36:59.91,Default,,0,0,0,,Adikku!
Dialogue: 0,0:37:04.68,0:37:06.78,Default,,0,0,0,,Aku tidak percaya ini.
Dialog: 0,0:37:06.80,0:37:08.53,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:37:08.55,0:37:09.57,Default,,0,0,0,,Saya baik-baik saja.
Dialog: 0,0:37:09.60,0:37:10.62,Default,,0,0,0,,Astaga.
Dialogue: 0,0:37:10.64,0:37:11.83,Default,,0,0,0,,Kamu pasti khawatir.
Dialogue: 0,0:37:11.85,0:37:14.54,Default,,0,0,0,,Saya kira setiap orang mempunyai sejumlah masalah dalam hidupnya.
Dialog: 0,0:37:14.56,0:37:16.96,Default,,0,0,0,,Hyeon-tae dan aku selalu menyebabkan masalah sepele,
Dialog: 0,0:37:16.98,0:37:18.46,Default,,0,0,0,,tapi tidak pernah sebesar ini.
Dialogue: 0,0:37:18.48,0:37:21.04,Default,,0,0,0,,Hyun-woo tidak melakukan apapun. Dia dijebak.
Dialogue: 0,0:37:21.07,0:37:23.69,Default,,0,0,0,,Ya, kamu benar.
Dialog: 0,0:37:23.78,0:37:26.52,Default,,0,0,0,,- Astaga.\N- Kamu aman sekarang, oke?
Dialog: 0,0:37:29.91,0:37:31.44,Default,,0,0,0,,Apa?
Dialogue: 0,0:37:31.58,0:37:33.53,Default,,0,0,0,,Sepertinya mereka sudah dekat.
Dialogue: 0,0:37:40.34,0:37:44.75,Default,,0,0,0,,"Keluarga yang bersahabat."
Dialog: 0,0:37:46.76,0:37:48.74,Default,,0,0,0,,- Makan ini.\N- Tidak, terima kasih.
Dialog: 0,0:37:48.76,0:37:50.66,Default,,0,0,0,,- Apa?\N- Tidak apa-apa.
Dialogue: 0,0:37:50.68,0:37:53.05,Default,,0,0,0,,Sepertinya dia tidak makan tahu.
Dialog: 0,0:37:53.72,0:37:56.09,Default,,0,0,0,,"Tidak makan tahu."
Dialogue: 0,0:37:57.56,0:37:59.72,Default,,0,0,0,,Apakah dia tidak menyukainya?
Dialog: 0,0:38:00.52,0:38:03.14,Default,,0,0,0,,- Mengapa? Enak.\N- Apa yang kamu lakukan?
Dialog: 0,0:38:10.57,0:38:12.61,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:38:13.12,0:38:14.60,Default,,0,0,0,,Apakah dia melihatku?
Dialog: 0,0:38:14.62,0:38:17.53,Default,,0,0,0,,- Benar, bukan?\N- Dia pergi.
Dialog: 0,0:38:19.13,0:38:20.66,Default,,0,0,0,,Benarkah?
Dialog: 0,0:38:28.01,0:38:30.95,Default,,0,0,0,,Bagus. Mari kita ikuti mereka secara diam-diam.
Dialog: 0,0:38:30.97,0:38:33.07,Default,,0,0,0,,Apa? Apakah kita serius menguntitnya?
Dialog: 0,0:38:33.10,0:38:35.74,Default,,0,0,0,,Tentu saja tidak. aku hanya ingin...
Dialog: 0,0:38:35.77,0:38:40.29,Default,,0,0,0,,untuk mengawasinya dan\Nmelihat apakah dia akan merencanakan hal lain.
Dialogue: 0,0:38:40.31,0:38:42.42,Default,,0,0,0,,Itulah yang dimaksud menguntit.
Dialogue: 0,0:38:42.44,0:38:44.85,Default,,0,0,0,,Lanjutkan saja.
Dialogue: 0,0:38:52.95,0:38:55.64,Default,,0,0,0,,Pastikan levelnya benar.
Dialogue: 0,0:38:55.66,0:38:57.47,Default,,0,0,0,,Aku sedang melakukannya sekarang.
Dialogue: 0,0:38:57.50,0:38:58.81,Default,,0,0,0,,Turunlah jika kamu takut.
Dialogue: 0,0:38:58.83,0:39:01.62,Default,,0,0,0,,Tapi aku perlu memeriksanya.
Dialog: 0,0:39:03.04,0:39:05.61,Default,,0,0,0,,Du-gwan, apakah kamu akan baik-baik saja?
Dialog: 0,0:39:05.63,0:39:09.19,Default,,0,0,0,,Tentu saja. Jika saya bisa, saya akan\Nmemberikan semuanya secara gratis.
Dialogue: 0,0:39:09.22,0:39:10.82,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Hyun-woo Dibebaskan\NPenjualan Setengah Harga!{\c}{\i0}
Dialogue: 0,0:39:10.84,0:39:13.17,Default,,0,0,0,,Apakah kamu ingin membelinya juga?
Dialogue: 0,0:39:14.10,0:39:17.08,Default,,0,0,0,,Ya ampun, kamu pasti suka {\i1}mandu.{\i0}
Dialog: 0,0:39:17.10,0:39:18.99,Default,,0,0,0,,Ini ada di rumah.
Dialogue: 0,0:39:19.02,0:39:20.95,Default,,0,0,0,,Wah, terima kasih.
Dialogue: 0,0:39:20.98,0:39:23.37,Default,,0,0,0,,- Aku lebih bersyukur.\N- Selamat juga.
Dialog: 0,0:39:23.40,0:39:25.18,Default,,0,0,0,,Terima kasih bu.
Dialog: 0,0:39:25.36,0:39:26.75,Default,,0,0,0,,Selamat tinggal.
Dialog: 0,0:39:26.78,0:39:29.02,Default,,0,0,0,,Selamat tinggal bu.
Dialogue: 0,0:39:30.15,0:39:32.97,Default,,0,0,0,,Apakah Anda akhirnya memahami filosofi pemasaran saya?
Dialog: 0,0:39:32.99,0:39:35.83,Default,,0,0,0,,Benar-benar. Saya harus meminta cinta kepada pelanggan saya,
Dialog: 0,0:39:35.85,0:39:36.89,Default,,0,0,0,,bukan uang.
Dialog: 0,0:39:36.91,0:39:37.95,Default,,0,0,0,,Tepat.
Dialogue: 0,0:39:37.97,0:39:40.06,Default,,0,0,0,,Saya mengikuti filosofi itu ketika saya kembali.
Dialog: 0,0:39:40.08,0:39:42.10,Default,,0,0,0,,Bagus.
Dialog: 0,0:39:42.12,0:39:43.70,Default,,0,0,0,,Semoga berhasil.
Dialogue: 0,0:39:43.83,0:39:46.06,Default,,0,0,0,,Pak, apakah roti kukus ini juga dipotong setengahnya?
Dialog: 0,0:39:46.09,0:39:48.32,Default,,0,0,0,,Roti kukus? Hai!
Dialogue: 0,0:39:48.34,0:39:49.86,Default,,0,0,0,,Separuh, kakiku!
Dialog: 0,0:39:49.88,0:39:51.83,Default,,0,0,0,,Minggir.
Dialog: 0,0:39:52.93,0:39:55.25,Default,,0,0,0,,Gratis. Hancurkan dirimu.
Dialogue: 0,0:39:57.72,0:39:59.79,Default,,0,0,0,,Es krimnya juga gratis!
Dialog: 0,0:39:59.81,0:40:01.29,Default,,0,0,0,,Apakah dia tidak akan menyesalinya besok?
Dialog: 0,0:40:01.31,0:40:04.22,Default,,0,0,0,,Besok? Dia akan menyesalinya malam ini.
Dialog: 0,0:40:05.48,0:40:06.71,Default,,0,0,0,,Hei, antri!
Dialogue: 0,0:40:06.73,0:40:08.60,Default,,0,0,0,,Itu pasti Hyun-woo.
Dialog: 0,0:40:09.44,0:40:11.05,Default,,0,0,0,,Ya ampun! Hai!
Dialog: 0,0:40:11.07,0:40:12.92,Default,,0,0,0,,{\i1}{\c&HFFFF&}Supermarket Yongdu-ri{\c}{\i0}
Dialog: 0,0:40:12.95,0:40:15.19,Default,,0,0,0,,- Ya ampun!\N- Sayang.
Dialogue: 0,0:40:15.91,0:40:17.44,Default,,0,0,0,,Ini Hyun-woo.
Dialog: 0,0:40:20.96,0:40:23.82,Default,,0,0,0,,Aku pulang, Ayah.
Dialog: 0,0:40:24.00,0:40:25.53,Default,,0,0,0,,Bagus.
Dialog: 0,0:40:25.63,0:40:27.29,Default,,0,0,0,,Selamat datang di rumah.
Dialog: 0,0:40:27.50,0:40:28.98,Default,,0,0,0,,maafkan aku.
Dialog: 0,0:40:29.00,0:40:30.87,Default,,0,0,0,,Jangan katakan itu.
Dialogue: 0,0:40:32.01,0:40:35.34,Default,,0,0,0,,Mengapa kamu meminta maaf\Npadahal kamu tidak melakukan kesalahan apa pun?
Dialog: 0,0:40:35.39,0:40:37.53,Default,,0,0,0,,- Bagus sekali, Hyun-woo.\N- Selamat.
Dialogue: 0,0:40:37.56,0:40:38.70,Default,,0,0,0,,Kamu melakukannya dengan baik.
Dialog: 0,0:40:38.72,0:40:40.53,Default,,0,0,0,,- Selamat.\N- Bagus sekali.
Dialogue: 0,0:40:40.56,0:40:42.79,Default,,0,0,0,,Pasti sulit.
Dialog: 0,0:40:42.81,0:40:44.64,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:40:51.19,0:40:53.52,Default,,0,0,0,,Selamat datang kembali, Hyun-woo.
Dialogue: 0,0:40:53.57,0:40:54.71,Default,,0,0,0,,Bukankah itu Soo-cheol?
Dialogue: 0,0:40:54.74,0:40:57.97,Default,,0,0,0,,Ya, dia telah tinggal di sini\Ndan menghindari ibunya.
Dialogue: 0,0:40:57.99,0:40:59.85,Default,,0,0,0,,Tapi kenapa disini?
Dialog: 0,0:40:59.87,0:41:03.18,Default,,0,0,0,,Ini rumah orang tua mantan suami saudara perempuannya.
Dialog: 0,0:41:03.21,0:41:04.99,Default,,0,0,0,,Apakah dia nyaman?
Dialogue: 0,0:41:05.17,0:41:06.99,Default,,0,0,0,,kurasa.
Dialogue: 0,0:41:07.17,0:41:09.16,Default,,0,0,0,,Lihat betapa bahagianya mereka.
Dialogue: 0,0:41:09.42,0:41:12.62,Default,,0,0,0,,Mereka keluarga yang aneh.
Dialogue: 0,0:41:14.51,0:41:16.42,Default,,0,0,0,,Salju turun!
Dialog: 0,0:41:16.68,0:41:19.09,Default,,0,0,0,,- Astaga!\N- Astaga!
Dialog: 0,0:41:36.57,0:41:38.11,Default,,0,0,0,,Sayang.
Dialog: 0,0:41:38.70,0:41:40.40,Default,,0,0,0,,Bu.
Dialogue: 0,0:41:41.08,0:41:42.61,Default,,0,0,0,,Kau kembali.
Dialog: 0,0:41:43.08,0:41:45.82,Default,,0,0,0,,Aku membuat bubur kacang merah manis, kesukaanmu.
Dialogue: 0,0:41:50.13,0:41:51.90,Default,,0,0,0,,Kamu pasti sangat khawatir.
Dialog: 0,0:41:51.92,0:41:54.66,Default,,0,0,0,,Hei, aku tidak khawatir...
Dialog: 0,0:41:54.72,0:41:56.50,Default,,0,0,0,,satu bit,
Dialog: 0,0:41:56.84,0:41:59.75,Default,,0,0,0,,karena keadilan akan selalu menang.
Dialog: 0,0:42:00.05,0:42:01.88,Default,,0,0,0,,Bukan saya.
Dialogue: 0,0:42:02.35,0:42:04.24,Default,,0,0,0,,Aku sangat khawatir.
Dialogue: 0,0:42:04.27,0:42:06.83,Default,,0,0,0,,- Aku juga.\N- Aku juga.
Dialogue: 0,0:42:06.85,0:42:10.17,Default,,0,0,0,,Kasihan sayangku mengalami begitu banyak hal.
Dialogue: 0,0:42:10.19,0:42:15.02,Default,,0,0,0,,Aku sangat khawatir!
Dialog: 0,0:42:15.49,0:42:17.85,Default,,0,0,0,,Orang tuanya terlihat baik.
Dialog: 0,0:42:19.91,0:42:23.30,Default,,0,0,0,,Dia pasti tidak suka tahu, tapi\Nmenikmati bubur kacang merah yang manis.
Dialog: 0,0:42:23.33,0:42:25.53,Default,,0,0,0,,Apakah dia masih kecil, atau apa?
Dialogue: 0,0:42:27.79,0:42:29.74,Default,,0,0,0,,"Senang makan..."
Dialogue: 0,0:42:31.71,0:42:33.31,Default,,0,0,0,,"bubur kacang merah manis."
Dialogue: 0,0:42:33.34,0:42:35.90,Default,,0,0,0,,Kau mengingatkanku pada diriku di masa lalu.
Dialog: 0,0:42:35.92,0:42:36.90,Default,,0,0,0,,Apa maksudmu?
Dialogue: 0,0:42:36.92,0:42:39.15,Default,,0,0,0,,Aku seperti kamu sebelum aku jatuh cinta pada BTS.
Dialogue: 0,0:42:39.18,0:42:41.28,Default,,0,0,0,,Cinta sejati bukan,
Dialog: 0,0:42:41.30,0:42:44.20,Default,,0,0,0,,"Astaga, aku sangat mencintainya."
Dialogue: 0,0:42:44.22,0:42:47.29,Default,,0,0,0,,Ini, "Apa ini? Apa urusannya?"
Dialog: 0,0:42:47.31,0:42:49.55,Default,,0,0,0,,Begitulah awalnya.
Dialogue: 0,0:42:50.52,0:42:53.83,Default,,0,0,0,,Apakah kamu selalu mengutarakan pendapatmu di hadapanku?
Dialog: 0,0:42:53.86,0:42:55.39,Default,,0,0,0,,Ya.
Dialogue: 0,0:42:56.53,0:42:58.34,Default,,0,0,0,,Saya adalah bos yang santai.
Dialog: 0,0:42:58.36,0:43:00.86,Default,,0,0,0,,Kamu tidak ingat apa pun?
Dialog: 0,0:43:01.20,0:43:02.18,Default,,0,0,0,,Lalu...
Dialogue: 0,0:43:02.20,0:43:05.32,Default,,0,0,0,,apakah kamu ingat pernah setuju memberiku $100,000?
Dialog: 0,0:43:06.75,0:43:08.61,Default,,0,0,0,,Tidak mungkin.
Dialog: 0,0:43:09.79,0:43:13.27,Default,,0,0,0,,Anda mungkin tidak ingat, tapi\NAnda masih memiliki penilaian yang jelas,
Dialog: 0,0:43:13.29,0:43:15.45,Default,,0,0,0,,jadi kenapa kamu tidak tahu?
Dialog: 0,0:43:15.63,0:43:17.33,Default,,0,0,0,,Tahu apa?
Dialog: 0,0:43:17.80,0:43:20.88,Default,,0,0,0,,Siapa yang benar-benar kamu cintai.
Dialog: 0,0:43:22.72,0:43:24.42,Default,,0,0,0,,Dan siapa itu?
Dialog: 0,0:43:25.76,0:43:29.76,Default,,0,0,0,,Saya tidak bisa mengatakannya, karena pekerjaan saya dipertaruhkan,
Dialog: 0,0:43:30.06,0:43:31.85,Default,,0,0,0,,tapi saya akan mengatakan ini.
Dialogue: 0,0:43:32.06,0:43:33.96,Default,,0,0,0,,Hatimu berbohong...
Dialog: 0,0:43:33.98,0:43:36.18,Default,,0,0,0,,ke mana tubuhmu pergi.
Dialog: 0,0:44:10.06,0:44:11.33,Default,,0,0,0,,Apa itu?
Dialog: 0,0:44:11.35,0:44:15.54,Default,,0,0,0,,Tn. Ivan menemukannya di tempat sampah dan\Nberkata kita harus mencari pemiliknya.
Dialog: 0,0:44:15.56,0:44:16.75,Default,,0,0,0,,Apakah ada namanya?
Dialog: 0,0:44:16.77,0:44:21.17,Default,,0,0,0,,Tidak, dan saya tidak bisa membacanya karena\Nit dalam bahasa asing.
Dialog: 0,0:44:21.20,0:44:22.59,Default,,0,0,0,,Lalu bagaimana kita menemukan pemiliknya?
Dialogue: 0,0:44:22.61,0:44:24.05,Default,,0,0,0,,Buang saja.
Dialogue: 0,0:44:24.07,0:44:25.26,Default,,0,0,0,,Mungkin buku catatan itu.
Dialog: 0,0:44:25.28,0:44:26.72,Default,,0,0,0,,Tn. Pengacara Baek...
Dialog: 0,0:44:26.74,0:44:32.27,Default,,0,0,0,,ditelepon dari Korea dan meminta\Nus mengembalikan buku catatan kepadanya.
Dialog: 0,0:44:32.29,0:44:34.57,Default,,0,0,0,,- Saya berangkat.\N- Oke, sampai jumpa.
Dialog: 0,0:44:37.34,0:44:38.31,Default,,0,0,0,,Yeong-song.
Dialogue: 0,0:44:38.34,0:44:40.46,Default,,0,0,0,,Dia kembali lagi.
Dialog: 0,0:45:08.49,0:45:11.44,Default,,0,0,0,,Bibi Beom-ja, apakah kamu tinggal di sini atau apa?
Dialog: 0,0:45:12.70,0:45:15.52,Default,,0,0,0,,Saya di sini untuk memberi selamat kepada Hyun-woo.
Dialog: 0,0:45:15.54,0:45:17.52,Default,,0,0,0,,Layanan katering akan segera tiba.
Dialogue: 0,0:45:17.54,0:45:19.59,Default,,0,0,0,,Haruskah aku menyuruh mereka pergi ke balai komunitas?
Dialog: 0,0:45:19.61,0:45:21.02,Default,,0,0,0,,Halo, Beom-ja.
Dialog: 0,0:45:21.05,0:45:24.00,Default,,0,0,0,,Ya ampun. Kamu juga ada di sini.
Dialogue: 0,0:45:24.47,0:45:27.36,Default,,0,0,0,,Aku menyiapkan banyak hadiah juga,\Nkarena suasana hatiku sedang bagus.
Dialog: 0,0:45:27.39,0:45:28.86,Default,,0,0,0,,- Datang lagi nanti.\N- Astaga, hadiah?
Dialog: 0,0:45:28.89,0:45:30.03,Default,,0,0,0,,Seperti...?
Dialog: 0,0:45:30.06,0:45:32.37,Default,,0,0,0,,Suplemen dan pemijat.
Dialog: 0,0:45:32.39,0:45:34.81,Default,,0,0,0,,Hadiah utamanya adalah mesin cuci muatan depan terbaru.
Dialogue: 0,0:45:34.84,0:45:35.83,Default,,0,0,0,,Astaga, mesin cuci?
Dialog: 0,0:45:35.85,0:45:37.62,Default,,0,0,0,,- Tidak mungkin.\N- Mesin cuci?
Dialogue: 0,0:45:37.65,0:45:40.77,Default,,0,0,0,,Ya ampun, kami berencana membeli yang baru.
Dialogue: 0,0:45:41.23,0:45:43.46,Default,,0,0,0,,Inikah cara orang kaya melenturkan uangnya?
Dialogue: 0,0:45:43.49,0:45:46.42,Default,,0,0,0,,Aku ingin hidup seperti dia di kehidupanku selanjutnya.
Dialog: 0,0:45:46.45,0:45:49.36,Default,,0,0,0,,Suka denganku? Dan apa itu?
Dialogue: 0,0:45:49.49,0:45:51.39,Default,,0,0,0,,Kamu punya uang. Kamu cantik,
Dialogue: 0,0:45:51.41,0:45:53.39,Default,,0,0,0,,dan yang terpenting, kamu menikah tiga kali.
Dialogue: 0,0:45:53.41,0:45:56.06,Default,,0,0,0,,Aku yang paling iri dengan itu.
Dialog: 0,0:45:56.08,0:45:57.92,Default,,0,0,0,,Anda tidak perlu menyebutkan itu.
Dialog: 0,0:45:57.94,0:45:58.94,Default,,0,0,0,,Kenapa tidak?
Dialog: 0,0:45:58.96,0:46:00.56,Default,,0,0,0,,Tidak semua orang bisa melakukan itu.
Dialog: 0,0:46:00.59,0:46:02.56,Default,,0,0,0,,Astaga, saya setuju.
Dialogue: 0,0:46:02.59,0:46:05.69,Default,,0,0,0,,Saya tidak bisa mengganti mesin cuci saya, apalagi suami saya.
Dialog: 0,0:46:05.72,0:46:09.03,Default,,0,0,0,,Jangan katakan itu di depan bujangan.
Dialogue: 0,0:46:09.05,0:46:10.97,Default,,0,0,0,,Ngomong-ngomong, apakah kamu benar-benar tidak akan menikah?
Dialog: 0,0:46:10.99,0:46:12.91,Default,,0,0,0,,Saya jamin guru TK itu.
Dialogue: 0,0:46:12.93,0:46:15.37,Default,,0,0,0,,Bang-sil benar. Dia benar-benar\Nmelompati rintangan.
Dialogue: 0,0:46:15.39,0:46:16.45,Default,,0,0,0,,Temui saja wanita itu.
Dialog: 0,0:46:16.48,0:46:17.87,Default,,0,0,0,,Teman-teman.
Dialog: 0,0:46:17.90,0:46:18.94,Default,,0,0,0,,Jangan biarkan dia...
Dialog: 0,0:46:18.96,0:46:20.21,Default,,0,0,0,,putuskan sendiri.
Dialogue: 0,0:46:20.23,0:46:21.58,Default,,0,0,0,,Kau harus mendesaknya.
Dialogue: 0,0:46:21.61,0:46:23.79,Default,,0,0,0,,Kamu harus terus maju.
Dialog: 0,0:46:23.82,0:46:24.84,Default,,0,0,0,,Bagaimana kalau minggu depan?
Dialogue: 0,0:46:24.86,0:46:26.67,Default,,0,0,0,,- Yeong-song...\N- Permisi.
Dialogue: 0,0:46:26.70,0:46:28.30,Default,,0,0,0,,Dimana balai komunitasnya lagi?
Dialog: 0,0:46:28.32,0:46:30.05,Default,,0,0,0,,{\i1}{\c&HFFFF&}Undian Berhadiah{\c}{\i0}
Dialog: 0,0:46:30.07,0:46:33.08,Default,,0,0,0,,{\i1}{\c&HFFFF&}Merayakan Pembebasan Baek Hyun-woo{\c}{\i0}
Dialog: 0,0:46:38.25,0:46:40.48,Default,,0,0,0,,Tepuk tangan!
Dialog: 0,0:46:40.50,0:46:43.98,Default,,0,0,0,,Semuanya! Saya ingin mengucapkan terima kasih kepada kalian semua...
Dialog: 0,0:46:44.00,0:46:47.44,Default,,0,0,0,,untuk menghadiri perayaan saudaraku...
Dialogue: 0,0:46:47.47,0:46:50.50,Default,,0,0,0,,Keluarnya Baek Hyun-woo!
Dialog: 0,0:46:52.47,0:46:54.99,Default,,0,0,0,,Inilah puncak pestanya.
Dialogue: 0,0:46:55.02,0:46:59.01,Default,,0,0,0,,Dia akan memotong tahunya. Tepuk tangan!
Dialog: 0,0:47:03.52,0:47:04.92,Default,,0,0,0,,Ayo kita lakukan bersama.
Dialog: 0,0:47:04.94,0:47:07.10,Default,,0,0,0,,Oke. Satu dua tiga.
Dialogue: 0,0:47:08.07,0:47:09.92,Default,,0,0,0,,Bagus sekali.
Dialog: 0,0:47:09.95,0:47:11.88,Default,,0,0,0,,- Selamat.\N- Terima kasih.
Dialog: 0,0:47:11.91,0:47:13.98,Default,,0,0,0,,Saya mengerti!
Dialog: 0,0:47:14.28,0:47:16.28,Default,,0,0,0,,Saya memenangkan TV!
Dialog: 0,0:47:17.45,0:47:21.16,Default,,0,0,0,,Hadiah berikutnya adalah suplemen.
Dialog: 0,0:47:22.21,0:47:25.65,Default,,0,0,0,,Adikku, Nona Baek Mi-seon,\Nakan memilih pemenangnya.
Dialog: 0,0:47:25.67,0:47:27.58,Default,,0,0,0,,Ayo keluar.
Dialog: 0,0:47:32.26,0:47:33.80,Default,,0,0,0,,Pilih satu.
Dialogue: 0,0:47:37.89,0:47:39.80,Default,,0,0,0,,Angka keberuntungannya adalah...
Dialog: 0,0:47:42.98,0:47:44.51,Default,,0,0,0,,17!
Dialog: 0,0:47:44.94,0:47:46.29,Default,,0,0,0,,Siapa itu?
Dialog: 0,0:47:46.32,0:47:47.96,Default,,0,0,0,,- Ini Bang-sil!\N- Ini aku!
Dialog: 0,0:47:47.99,0:47:49.80,Default,,0,0,0,,Ini aku!
Dialog: 0,0:47:49.82,0:47:51.65,Default,,0,0,0,,Bang-sil!
Dialog: 0,0:47:56.33,0:47:57.47,Default,,0,0,0,,Selamat.
Dialog: 0,0:47:57.49,0:48:00.78,Default,,0,0,0,,Terima kasih, Hyun-woo. Aku akan menjadi lebih cantik sekarang.
Dialog: 0,0:48:02.75,0:48:05.45,Default,,0,0,0,,Selamat.
Dialog: 0,0:48:05.75,0:48:08.65,Default,,0,0,0,,- Hadiah utama yang telah lama ditunggu-tunggu...\N- Aku ditakdirkan untuk tidak pernah kelaparan.
Dialogue: 0,0:48:08.67,0:48:10.73,Default,,0,0,0,,...hanya mesin cuci yang tersisa.
Dialog: 0,0:48:10.76,0:48:13.32,Default,,0,0,0,,Ms. Hong Beom-ja, yang menyiapkan semua hadiah ini,
Dialog: 0,0:48:13.34,0:48:16.67,Default,,0,0,0,,akan mengumumkan pemenangnya. Tepuk tangan!
Dialog: 0,0:48:35.70,0:48:37.57,Default,,0,0,0,,Pemenangnya adalah...
Dialog: 0,0:48:39.12,0:48:42.28,Default,,0,0,0,,Lima! Selamat!
Dialog: 0,0:48:42.41,0:48:44.37,Default,,0,0,0,,Siapa itu?
Dialogue: 0,0:48:46.88,0:48:48.23,Default,,0,0,0,,- Apa?\N- Astaga, ini Yeong-song!
Dialog: 0,0:48:48.25,0:48:50.15,Default,,0,0,0,,Yeong-song, kamu menang!
Dialogue: 0,0:48:50.17,0:48:52.63,Default,,0,0,0,,Ini Yeong-song!
Dialog: 0,0:48:52.66,0:48:53.65,Default,,0,0,0,,Yeong-song!
Dialog: 0,0:48:53.68,0:48:55.07,Default,,0,0,0,,Itu milikmu!
Dialogue: 0,0:48:55.09,0:48:56.49,Default,,0,0,0,,Kamu menang!
Dialog: 0,0:48:56.51,0:48:58.57,Default,,0,0,0,,- Astaga.\N- Anda dapat memilikinya.
Dialog: 0,0:48:58.60,0:48:59.66,Default,,0,0,0,,Apa?
Dialog: 0,0:48:59.68,0:49:01.16,Default,,0,0,0,,- Benarkah?\N- Mengapa?
Dialogue: 0,0:49:01.18,0:49:03.75,Default,,0,0,0,,Aku tidak membutuhkannya, tapi kalian membutuhkannya.
Dialog: 0,0:49:03.77,0:49:06.05,Default,,0,0,0,,- Serius?\N- Tidak mungkin!
Dialog: 0,0:49:17.16,0:49:18.86,Default,,0,0,0,,Terima kasih!
Dialog: 0,0:49:26.54,0:49:27.89,Default,,0,0,0,,{\i1}{\c&HFFFF&}Balai Komunitas Yongdu-ri{\c}{\i0}
Dialog: 0,0:49:27.92,0:49:30.16,Default,,0,0,0,,Tunggu, Tuan Kim!
Dialog: 0,0:49:31.51,0:49:32.48,Default,,0,0,0,,Ya, Beom-ja?
Dialogue: 0,0:49:32.51,0:49:34.44,Default,,0,0,0,,Bagaimana kabarmu yang begitu tidak mementingkan diri sendiri?
Dialogue: 0,0:49:34.47,0:49:36.09,Default,,0,0,0,,Anda memenangkan sebuah mesin cuci.
Dialog: 0,0:49:36.12,0:49:37.15,Default,,0,0,0,,Itu milikmu.
Dialogue: 0,0:49:37.18,0:49:39.78,Default,,0,0,0,,Tetapi mesin cuci saya berfungsi dengan baik.
Dialog: 0,0:49:39.81,0:49:43.20,Default,,0,0,0,,Saya tahu ini sangat tua dan tidak stabil. Saya melihatnya.
Dialog: 0,0:49:43.23,0:49:45.47,Default,,0,0,0,,Masih melakukan tugasnya.
Dialog: 0,0:49:45.94,0:49:47.91,Default,,0,0,0,,Yang ini model terbaru.
Dialogue: 0,0:49:47.94,0:49:51.50,Default,,0,0,0,,Memiliki sistem AI. Itu\Nbisa mencuci selimut dan sepatu.
Dialog: 0,0:49:52.63,0:49:54.32,Default,,0,0,0,,Ya.
Dialog: 0,0:49:54.65,0:49:57.27,Default,,0,0,0,,"Ya"?
Dialog: 0,0:49:57.36,0:49:59.80,Default,,0,0,0,,Anda harus memanfaatkan peluang.
Dialogue: 0,0:49:59.83,0:50:03.90,Default,,0,0,0,,Hal yang sama berlaku untuk mesin cuci dan orang.\NMengapa kamu tidak mengambilnya?
Dialog: 0,0:50:07.67,0:50:10.85,Default,,0,0,0,,Saya tidak akan kembali ke sini setelah saya berangkat hari ini.
Dialog: 0,0:50:10.88,0:50:12.90,Default,,0,0,0,,Kamu masih tidak mau menangkapku?
Dialog: 0,0:50:12.92,0:50:14.98,Default,,0,0,0,,Bagaimana jika kamu tidak pernah melihatku lagi?
Dialogue: 0,0:50:15.01,0:50:17.83,Default,,0,0,0,,Apa yang menghentikanku untuk menikah lagi?
Dialogue: 0,0:50:18.76,0:50:21.30,Default,,0,0,0,,Apakah kamu akan menikah lagi?
Dialogue: 0,0:50:21.89,0:50:24.51,Default,,0,0,0,,Bukan itu maksudku.
Dialog: 0,0:50:28.90,0:50:31.10,Default,,0,0,0,,Saya akan mengatakannya sekali.
Dialogue: 0,0:50:33.65,0:50:36.02,Default,,0,0,0,,Aku tertarik padamu.
Dialog: 0,0:50:36.15,0:50:37.46,Default,,0,0,0,,Tidak.
Dialog: 0,0:50:37.49,0:50:39.27,Default,,0,0,0,,Aku menyukaimu,
Dialog: 0,0:50:39.99,0:50:42.53,Default,,0,0,0,,jadi maukah kamu berbuat apa-apa?
Dialogue: 0,0:50:43.37,0:50:46.53,Default,,0,0,0,,Setelah aku pergi, aku tidak akan kembali.
Dialog: 0,0:50:53.30,0:50:54.48,Default,,0,0,0,,Ms. Hong...
Dialog: 0,0:50:54.50,0:50:55.69,Default,,0,0,0,,Satu menit.
Dialog: 0,0:50:55.71,0:50:57.97,Default,,0,0,0,,Saya punya pertanyaan untuk ditanyakan padanya.
Dialog: 0,0:50:57.99,0:50:58.99,Default,,0,0,0,,Saya akan segera masuk.
Dialog: 0,0:50:59.01,0:51:00.78,Default,,0,0,0,,- Bukan itu alasannya.\N- Apa?
Dialog: 0,0:51:00.80,0:51:02.57,Default,,0,0,0,,- Apa itu?\N- Baiklah...
Dialog: 0,0:51:02.60,0:51:03.70,Default,,0,0,0,,Itu...
Dialog: 0,0:51:03.72,0:51:05.30,Default,,0,0,0,,Benda ini...
Dialog: 0,0:51:07.23,0:51:08.62,Default,,0,0,0,,Nirkabel.
Dialog: 0,0:51:08.64,0:51:12.56,Default,,0,0,0,,Terhubung ke speaker dalam ruangan.
Dialog: 0,0:51:14.52,0:51:16.54,Default,,0,0,0,,{\i1}Hal yang sama berlaku untuk mesin cuci dan orang.{\i0}
Dialogue: 0,0:51:16.57,0:51:18.00,Default,,0,0,0,,{\i1}Kenapa kamu tidak mengambilnya?{\i0}
Dialogue: 0,0:51:18.03,0:51:19.63,Default,,0,0,0,,{\i1}Saya tidak akan kembali ke sini...{\i0}
Dialog: 0,0:51:19.65,0:51:21.01,Default,,0,0,0,,{\i1}setelah saya berangkat hari ini.{\i0}
Dialogue: 0,0:51:21.03,0:51:22.70,Default,,0,0,0,,{\i1}Kamu masih belum bisa menangkapku?{\i0}
Dialogue: 0,0:51:22.72,0:51:24.12,Default,,0,0,0,,{\i1}Bagaimana jika kamu tidak pernah melihatku lagi?{\i0}
Dialogue: 0,0:51:24.14,0:51:26.14,Default,,0,0,0,,{\i1}Apa yang menghalangiku untuk menikah lagi?{\i0}
Dialog: 0,0:51:26.17,0:51:27.15,Default,,0,0,0,,Ya ampun!
Dialogue: 0,0:51:27.18,0:51:28.47,Default,,0,0,0,,Dia keren sekali.
Dialog: 0,0:51:28.50,0:51:30.03,Default,,0,0,0,,Astaga.
Dialogue: 0,0:51:30.83,0:51:32.34,Default,,0,0,0,,{\i1}Apakah kamu akan menikah lagi?{\i0}
Dialog: 0,0:51:32.36,0:51:33.35,Default,,0,0,0,,Apakah dia bodoh?
Dialogue: 0,0:51:33.38,0:51:35.73,Default,,0,0,0,,Bukan itu maksudnya.
Dialogue: 0,0:51:35.75,0:51:38.41,Default,,0,0,0,,{\i1}Bukan itu maksudku.{\i0}
Dialog: 0,0:51:40.22,0:51:41.74,Default,,0,0,0,,{\i1}Saya akan mengatakannya sekali saja.{\i0}
Dialogue: 0,0:51:41.76,0:51:43.49,Default,,0,0,0,,{\i1}Aku tertarik padamu.{\i0}
Dialog: 0,0:51:43.51,0:51:44.53,Default,,0,0,0,,{\i1}Tidak.{\i0}
Dialogue: 0,0:51:44.55,0:51:46.09,Default,,0,0,0,,{\i1}Aku menyukaimu,{\i0}
Dialogue: 0,0:51:46.52,0:51:51.25,Default,,0,0,0,,{\i1}jadi apakah kamu tidak akan melakukan apa-apa?\NOSetelah aku pergi, aku tidak akan kembali.{\i0}
Dialog: 0,0:51:51.27,0:51:52.80,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:51:53.61,0:51:56.56,Default,,0,0,0,,Dia mempermalukan keluarga kami.
Dialog: 0,0:52:04.62,0:52:07.44,Default,,0,0,0,,Yeong-song! Jawablah dengan bijak!
Dialog: 0,0:52:07.62,0:52:08.60,Default,,0,0,0,,Bibi Beom-ja!
Dialog: 0,0:52:08.62,0:52:09.64,Default,,0,0,0,,Tidak apa-apa!
Dialog: 0,0:52:09.66,0:52:12.06,Default,,0,0,0,,- Tidak apa-apa!\N- Sial.
Dialog: 0,0:52:12.08,0:52:14.91,Default,,0,0,0,,Mau kemana? Tidak, tunggu!
Dialogue: 0,0:52:15.04,0:52:17.65,Default,,0,0,0,,Tidak, kamu harus terus menyenggolnya!
Dialogue: 0,0:52:17.67,0:52:19.23,Default,,0,0,0,,Lanjutkan!
Dialogue: 0,0:52:19.26,0:52:22.17,Default,,0,0,0,,Kejar dia! Buru-buru!
Dialog: 0,0:52:23.76,0:52:25.88,Default,,0,0,0,,Yeong-song!
Dialogue: 0,0:52:28.93,0:52:32.08,Default,,0,0,0,,Pak, Baek Hyun-woo meminta\Nkomite personalia untuk mempekerjakannya kembali.
Dialog: 0,0:52:32.10,0:52:33.75,Default,,0,0,0,,Tuduhan pembunuhannya dibatalkan,
Dialog: 0,0:52:33.77,0:52:35.77,Default,,0,0,0,,jadi tidak ada cara hukum untuk menolak permintaannya.
Dialog: 0,0:52:35.79,0:52:38.29,Default,,0,0,0,,Astaga, apakah dia zombie atau apa?
Dialogue: 0,0:52:38.32,0:52:39.92,Default,,0,0,0,,Dia ulet.
Dialogue: 0,0:52:39.94,0:52:42.17,Default,,0,0,0,,Kamu benar, tapi ada masalah yang lebih besar.
Dialog: 0,0:52:42.20,0:52:44.72,Default,,0,0,0,,Rapat mitra terbatas\Nakan berlangsung di New York.
Dialog: 0,0:52:44.74,0:52:47.90,Default,,0,0,0,,Mereka akan memberikan suara mengenai\Npemecatan ketua.
Dialog: 0,0:52:51.12,0:52:53.35,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:52:53.37,0:52:55.06,Default,,0,0,0,,Jika ketua gagal memberikan,
Dialogue: 0,0:52:55.08,0:52:58.19,Default,,0,0,0,,atau mengarang, dokumen\Nkeuangan kepada investor,
Dialog: 0,0:52:58.21,0:53:01.13,Default,,0,0,0,,mitra komanditer dapat mengadakan\Nrapat dan memberhentikan ketua...
Dialog: 0,0:53:01.15,0:53:02.98,Default,,0,0,0,,Tepat!
Dialogue: 0,0:53:03.17,0:53:06.57,Default,,0,0,0,,Siapa yang menyerahkan dokumen itu?
Dialog: 0,0:53:06.60,0:53:08.78,Default,,0,0,0,,Apakah itu Baek Hyun-woo? Apakah saya benar?
Dialog: 0,0:53:08.81,0:53:11.45,Default,,0,0,0,,Tidak, bukan itu.
Dialog: 0,0:53:11.47,0:53:15.00,Default,,0,0,0,,Bagaimana menurut anda? Saya memakai\Nini untuk pelantikan Ketua saya.
Dialog: 0,0:53:16.24,0:53:17.68,Default,,0,0,0,,Peresmian.
Dialog: 0,0:53:19.57,0:53:21.38,Default,,0,0,0,,Haruskah aku mengatakan sesuatu?
Dialogue: 0,0:53:21.40,0:53:23.46,Default,,0,0,0,,Sangat cocok untukmu.
Dialogue: 0,0:53:23.49,0:53:24.71,Default,,0,0,0,,Bukan?
Dialogue: 0,0:53:24.74,0:53:27.32,Default,,0,0,0,,Seharusnya aku segera menemukan tempatku.
Dialog: 0,0:53:32.33,0:53:33.56,Default,,0,0,0,,Hubungi bank.
Dialog: 0,0:53:33.58,0:53:34.62,Default,,0,0,0,,Suruh mereka menggandakan...
Dialog: 0,0:53:34.64,0:53:37.42,Default,,0,0,0,,transaksi sebelumnya dan\Njadikan 4,2% dengan kebijaksanaan yang cermat.
Dialog: 0,0:53:37.44,0:53:38.44,Default,,0,0,0,,Sekaligus?
Dialog: 0,0:53:38.46,0:53:41.63,Default,,0,0,0,,Saya tidak punya waktu. Saya perlu\Nmembeli saham sebanyak yang saya bisa,
Dialog: 0,0:53:41.71,0:53:44.50,Default,,0,0,0,,jadi mereka tidak akan bisa mengusirku.
Dialog: 0,0:53:44.80,0:53:46.50,Default,,0,0,0,,Baiklah.
Dialog: 0,0:53:46.59,0:53:49.16,Default,,0,0,0,,Dia membeli 4,2% sekaligus.
Dialogue: 0,0:53:49.18,0:53:50.20,Default,,0,0,0,,Dia pasti terburu-buru.
Dialog: 0,0:53:50.22,0:53:52.87,Default,,0,0,0,,Tentu saja. Dia akhirnya\Nmenghabiskan dana rahasianya.
Dialog: 0,0:53:52.89,0:53:56.45,Default,,0,0,0,,Sudahkah kita menemukan file yang seharusnya diserahkan Tuan Pyeon\N?
Dialog: 0,0:53:56.48,0:53:57.87,Default,,0,0,0,,Tidak, Pak.
Dialog: 0,0:53:57.90,0:54:00.21,Default,,0,0,0,,Namun, saya menerima sesuatu yang lain.
Dialogue: 0,0:54:00.23,0:54:02.67,Default,,0,0,0,,Ini akan membuktikan Eun-sung dan anak buahnya...
Dialogue: 0,0:54:02.69,0:54:06.01,Default,,0,0,0,,melakukan investasi $2 miliar\Npenipuan untuk mengambil alih Queens.
Dialog: 0,0:54:06.03,0:54:08.44,Default,,0,0,0,,Ya ampun. Siapa yang memberikannya padamu?
Dialog: 0,0:54:20.46,0:54:22.29,Default,,0,0,0,,Apakah kamu membawanya?
Dialog: 0,0:54:27.97,0:54:29.61,Default,,0,0,0,,Itu uang dari AS.
Dialog: 0,0:54:29.64,0:54:31.24,Default,,0,0,0,,- Itu saja.\N- Sial.
Dialogue: 0,0:54:31.26,0:54:33.12,Default,,0,0,0,,- Ayo, sekarang.\N- Apa maksudmu?
Dialogue: 0,0:54:33.14,0:54:36.43,Default,,0,0,0,,Aku memberimu semua uang\NI dapatkan dari Seul-hee. Itu saja.
Dialog: 0,0:54:37.52,0:54:39.75,Default,,0,0,0,,Dan uang yang kamu berikan kepada keluarga Hong?
Dialog: 0,0:54:39.77,0:54:42.01,Default,,0,0,0,,Itu milik mereka.
Dialog: 0,0:54:45.40,0:54:46.59,Default,,0,0,0,,Dan stik USB?
Dialogue: 0,0:54:46.61,0:54:49.17,Default,,0,0,0,,Da-hye yang memberikannya padamu?
Dialog: 0,0:54:49.20,0:54:50.26,Default,,0,0,0,,Ya.
Dialog: 0,0:54:50.28,0:54:51.43,Default,,0,0,0,,{\i1}Sudah kubilang.{\i0}
Dialogue: 0,0:54:51.45,0:54:53.18,Default,,0,0,0,,Itulah nyawaku, jadi aku menyembunyikannya.
Dialogue: 0,0:54:53.20,0:54:54.94,Default,,0,0,0,,Garis hidupmu?
Dialogue: 0,0:54:55.04,0:54:57.35,Default,,0,0,0,,Astaga, bodoh sekali.
Dialogue: 0,0:54:57.37,0:55:00.39,Default,,0,0,0,,Itulah sebabnya kamu akan mati.
Dialogue: 0,0:55:00.42,0:55:03.15,Default,,0,0,0,,- Apa?\N- Bu Moh sudah muak denganmu.
Dialogue: 0,0:55:03.17,0:55:05.52,Default,,0,0,0,,Aku memujamu, jadi aku bersikap lunak padamu.
Dialogue: 0,0:55:05.55,0:55:10.67,Default,,0,0,0,,Aku yakin kamu tahu dia membenci gadis manis.
Dialog: 0,0:55:11.93,0:55:13.16,Default,,0,0,0,,Diam.
Dialog: 0,0:55:13.18,0:55:14.99,Default,,0,0,0,,Sudah kubilang diam saja.
Dialog: 0,0:55:15.02,0:55:17.17,Default,,0,0,0,,- Buka!\N- Diam!
Dialog: 0,0:55:22.73,0:55:23.73,Default,,0,0,0,,Bodoh itu.
Dialog: 0,0:55:23.76,0:55:25.19,Default,,0,0,0,,- Hei, tancap gas.\N- Buka!
Dialog: 0,0:55:25.22,0:55:26.21,Default,,0,0,0,,Diam.
Dialog: 0,0:55:26.23,0:55:27.34,Default,,0,0,0,,Diam!
Dialog: 0,0:55:27.36,0:55:28.94,Default,,0,0,0,,Hentikan mobilnya!
Dialog: 0,0:55:29.49,0:55:31.02,Default,,0,0,0,,Diam!
Dialog: 0,0:55:33.16,0:55:34.18,Default,,0,0,0,,Hentikan mobilnya!
Dialogue: 0,0:55:34.20,0:55:36.11,Default,,0,0,0,,Lepaskan Da-hye!
Dialog: 0,0:55:38.66,0:55:40.14,Default,,0,0,0,,Soo-cheol.
Dialogue: 0,0:55:40.17,0:55:42.37,Default,,0,0,0,,Sialan! Buka pintunya!
Dialog: 0,0:55:57.22,0:55:58.88,Default,,0,0,0,,Sialan.
Dialog: 0,0:56:16.45,0:56:18.28,Default,,0,0,0,,Ada apa dengan dia?
Dialogue: 0,0:56:18.87,0:56:20.26,Default,,0,0,0,,Apakah dia sedang asyik dengan sesuatu?
Dialog: 0,0:56:20.29,0:56:21.99,Default,,0,0,0,,Apakah dia?
Dialog: 0,0:56:24.67,0:56:25.85,Default,,0,0,0,,Dasar bodoh!
Dialog: 0,0:56:25.88,0:56:27.77,Default,,0,0,0,,Sudah kubilang biarkan dia pergi!
Dialog: 0,0:56:27.80,0:56:29.27,Default,,0,0,0,,Diam.
Dialog: 0,0:56:29.30,0:56:30.86,Default,,0,0,0,,Soo-cheol! Berlari!
Dialog: 0,0:56:30.88,0:56:33.50,Default,,0,0,0,,Apakah kamu ingin mati?
Dialog: 0,0:56:37.14,0:56:38.12,Default,,0,0,0,,Soo-cheol!
Dialog: 0,0:56:38.14,0:56:39.67,Default,,0,0,0,,Soo-cheol!
Dialogue: 0,0:56:41.39,0:56:43.29,Default,,0,0,0,,- Oh, tidak!\N- Sialan.
Dialog: 0,0:56:43.31,0:56:44.54,Default,,0,0,0,,Tn. Hong.
Dialog: 0,0:56:44.56,0:56:46.96,Default,,0,0,0,,Pergi selagi aku masih bersikap baik.
Dialog: 0,0:56:46.98,0:56:48.52,Default,,0,0,0,,Oke?
Dialog: 0,0:56:49.98,0:56:52.69,Default,,0,0,0,,Berhenti dipukuli, dan lari!
Dialogue: 0,0:56:54.36,0:56:56.63,Default,,0,0,0,,Kenapa kamu mencoba menjadi pahlawan?
Dialog: 0,0:56:56.66,0:56:58.98,Default,,0,0,0,,- Lari!\N- Diam!
Dialog: 0,0:57:09.88,0:57:11.66,Default,,0,0,0,,Sialan.
Dialog: 0,0:57:15.30,0:57:17.38,Default,,0,0,0,,Soo-cheol!
Dialog: 0,0:57:20.97,0:57:21.99,Default,,0,0,0,,Mati!
Dialog: 0,0:57:22.02,0:57:24.01,Default,,0,0,0,,Mati!
Dialog: 0,0:57:25.40,0:57:27.60,Default,,0,0,0,,- Mati!\N- Lari!
Dialog: 0,0:57:39.99,0:57:41.01,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Da-hye!{\c}{\i0}
Dialog: 0,0:57:41.04,0:57:42.05,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Geon-u!{\c}{\i0}
Dialogue: 0,0:57:42.08,0:57:44.89,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bagaimana jika saya perlu melindungi\Nkeluarga saya di masa depan,{\c}{\i0}
Dialog: 0,0:57:44.91,0:57:46.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi saya tidak bisa?{\c}{\i0}
Dialogue: 0,0:57:46.75,0:57:49.16,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku takut.{\c}{\i0}
Dialog: 0,0:57:51.96,0:57:53.87,Default,,0,0,0,,Aduh...
Dialog: 0,0:57:54.63,0:57:55.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Berlebihan,{\c}{\i0}
Dialogue: 0,0:57:55.88,0:57:58.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}agar mereka merasa sombong dan berpikir,{\c}{\i0}
Dialogue: 0,0:57:58.18,0:58:00.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}"Dia bukan tandinganku."{\c}{\i0}
Dialogue: 0,0:58:00.14,0:58:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF00&}"Saya cukup menang."{\c}{\i0}
Dialogue: 0,0:58:02.06,0:58:03.74,Default,,0,0,0,,{\i1}{\c&HFFFF00&}"Saya ternyata sangat kuat."{\c}{\i0}
Dialog: 0,0:58:03.77,0:58:05.34,Default,,0,0,0,,Ayo pergi.
Dialog: 0,0:58:06.31,0:58:08.55,Default,,0,0,0,,- Sial!\N- Astaga.
Dialog: 0,0:58:09.31,0:58:10.71,Default,,0,0,0,,Soo-cheol!
Dialogue: 0,0:58:10.73,0:58:13.17,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu harus menunggu sampai mereka lengah,{\c}{\i0}
Dialog: 0,0:58:13.19,0:58:16.06,Default,,0,0,0,,{\i1}{\c&HFFFF00&}lalu mendaratkan pukulan kritismu.{\c}{\i0}
Dialog: 0,0:58:29.04,0:58:30.69,Default,,0,0,0,,Ayo pergi. Singkirkan sepedanya.
Dialog: 0,0:58:30.71,0:58:32.37,Default,,0,0,0,,Singkirkan...
Dialog: 0,0:59:06.25,0:59:07.35,Default,,0,0,0,,Apa...?
Dialogue: 0,0:59:07.37,0:59:09.28,Default,,0,0,0,,Apa itu?
Dialog: 0,0:59:11.88,0:59:13.23,Default,,0,0,0,,Soo-cheol.
Dialogue: 0,0:59:13.25,0:59:14.98,Default,,0,0,0,,Soo-cheol, buka matamu.
Dialog: 0,0:59:15.00,0:59:16.91,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:24.60,0:59:27.20,Default,,0,0,0,,Polisi? Kami berada di jalur kereta Yongdu-ri.
Dialog: 0,0:59:27.23,0:59:29.20,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:29.23,0:59:31.05,Default,,0,0,0,,Bangun.
Dialog: 0,0:59:31.44,0:59:32.97,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:34.19,0:59:35.93,Default,,0,0,0,,Apakah dia mati?
Dialog: 0,0:59:38.15,0:59:39.81,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:39.86,0:59:41.69,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:42.41,0:59:44.07,Default,,0,0,0,,Tidak, Soo-cheol.
Dialog: 0,0:59:44.62,0:59:45.89,Default,,0,0,0,,Soo-cheol.
Dialog: 0,0:59:45.91,0:59:47.64,Default,,0,0,0,,Aku cinta kamu. Jangan pergi.
Dialog: 0,0:59:47.66,0:59:49.78,Default,,0,0,0,,Tidak, Soo-cheol.
Dialog: 0,0:59:49.83,0:59:51.37,Default,,0,0,0,,Soo-cheol...
Dialog: 0,0:59:55.88,0:59:57.41,Default,,0,0,0,,Saya juga.
Dialog: 0,1:00:00.17,1:00:02.50,Default,,0,0,0,,Ayo.
Dialog: 0,1:00:06.39,1:00:08.84,Default,,0,0,0,,Mengapa kamu melakukan itu?
Dialog: 0,1:00:09.48,1:00:12.01,Default,,0,0,0,,Maaf, Soo-cheol...
Dialog: 0,1:00:27.83,1:00:30.22,Default,,0,0,0,,Tunggu. Mengapa saya menghindarinya?
Dialog: 0,1:00:30.25,1:00:31.82,Default,,0,0,0,,Saya CEO.
Dialogue: 0,1:00:32.58,1:00:34.78,Default,,0,0,0,,Lucu sekali.
Dialog: 0,1:00:35.00,1:00:38.33,Default,,0,0,0,,Siapa yang mengizinkan dia kembali ke sini?
Dialog: 0,1:00:39.55,1:00:41.25,Default,,0,0,0,,Saya harus bertanya.
Dialog: 0,1:00:58.40,1:01:00.60,Default,,0,0,0,,Saya perlu bicara dengan Anda.
Dialog: 0,1:01:03.32,1:01:05.15,Default,,0,0,0,,Demikian juga.
Dialog: 0,1:01:05.62,1:01:07.36,Default,,0,0,0,,Anda diaktifkan kembali?
Dialog: 0,1:01:07.45,1:01:08.43,Default,,0,0,0,,Ya.
Dialog: 0,1:01:08.45,1:01:10.36,Default,,0,0,0,,Mengapa?
Dialog: 0,1:01:10.66,1:01:11.76,Default,,0,0,0,,Apakah karena aku?
Dialogue: 0,1:01:11.79,1:01:13.99,Default,,0,0,0,,Ini tempat kerjaku.
Dialogue: 0,1:01:14.08,1:01:15.43,Default,,0,0,0,,Kamu bisa saja pergi ke tempat lain.
Dialog: 0,1:01:15.46,1:01:17.06,Default,,0,0,0,,Itu pilihanku.
Dialog: 0,1:01:17.09,1:01:18.74,Default,,0,0,0,,Saya merasa tidak nyaman.
Dialog: 0,1:01:21.55,1:01:23.23,Default,,0,0,0,,Saya tidak nyaman,
Dialog: 0,1:01:23.26,1:01:25.49,Default,,0,0,0,,jadi silakan mengundurkan diri dan mencari pekerjaan baru.
Dialog: 0,1:01:25.51,1:01:27.75,Default,,0,0,0,,Aku benar-benar tidak mau...
Dialog: 0,1:01:28.51,1:01:30.80,Default,,0,0,0,,sampai jumpa.
Dialogue: 0,1:01:33.06,1:01:35.18,Default,,0,0,0,,Ada apa dengan tampilan itu?
Dialogue: 0,1:01:35.52,1:01:38.00,Default,,0,0,0,,Kau meninggalkanku dalam keadaan mabuk.
Dialogue: 0,1:01:38.02,1:01:41.63,Default,,0,0,0,,Apakah kamu pikir kamu bisa merayu\Naku sekarang karena aku kehilangan ingatanku?
Dialog: 0,1:01:41.65,1:01:43.56,Default,,0,0,0,,Apakah itu?
Dialog: 0,1:01:46.16,1:01:48.30,Default,,0,0,0,,Kamu bilang aku akan selalu menjadi tipe idealmu,
Dialog: 0,1:01:48.32,1:01:49.72,Default,,0,0,0,,dan kamu akan jatuh cinta padaku lagi.
Dialog: 0,1:01:49.74,1:01:52.07,Default,,0,0,0,,Kamu sangat percaya diri,
Dialog: 0,1:01:52.75,1:01:55.78,Default,,0,0,0,,jadi kupikir kau akan segera mengenaliku.
Dialog: 0,1:01:56.42,1:01:57.39,Default,,0,0,0,,Tertarik padamu?
Dialog: 0,1:01:57.42,1:01:58.60,Default,,0,0,0,,Tapi tidak apa-apa.
Dialog: 0,1:01:58.63,1:02:00.62,Default,,0,0,0,,Saya melihat ini datang.
Dialog: 0,1:02:02.21,1:02:05.65,Default,,0,0,0,,Kamu lebih tak tahu malu dari yang kukira.
Dialog: 0,1:02:05.68,1:02:07.36,Default,,0,0,0,,Apakah keluargaku menjanjikan sesuatu padamu?
Dialogue: 0,1:02:07.39,1:02:08.56,Default,,0,0,0,,Kenapa kamu berusaha keras?
Dialog: 0,1:02:08.58,1:02:10.20,Default,,0,0,0,,- Hae-in...\N- Jangan sebutkan namaku.
Dialogue: 0,1:02:10.22,1:02:11.91,Default,,0,0,0,,Aku mungkin mudah terjatuh...
Dialog: 0,1:02:11.93,1:02:14.54,Default,,0,0,0,,untuk tatapan dan suaramu di masa lalu,
Dialog: 0,1:02:14.56,1:02:16.09,Default,,0,0,0,,tapi sekarang tidak lagi.
Dialog: 0,1:02:16.73,1:02:18.85,Default,,0,0,0,,Aku tidak ingin melihatmu lagi.
Dialog: 0,1:02:26.20,1:02:28.15,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:02:28.45,1:02:30.65,Default,,0,0,0,,Jangan lakukan ini.
Dialog: 0,1:02:35.29,1:02:37.02,Default,,0,0,0,,- Tidak...\N- Saya tidak ingin mendengarnya.
Dialog: 0,1:02:37.04,1:02:39.41,Default,,0,0,0,,Jangan pegang aku.
Dialog: 0,1:02:41.38,1:02:43.12,Default,,0,0,0,,Biarkan aku pergi.
Dialog: 0,1:03:28.76,1:03:30.38,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pengirim Pusat Medis Grünwald{\c}{\i0}
Dialog: 0,1:03:36.22,1:03:38.22,Default,,0,0,0,,Hae-in!
Dialog: 0,1:03:41.73,1:03:45.06,Default,,0,0,0,,Hei, ini aku. Berkah.
Dialog: 0,1:03:45.32,1:03:49.14,Default,,0,0,0,,Ya ampun. Kamu benar-benar tidak ingat apa pun.
Dialog: 0,1:03:50.99,1:03:52.80,Default,,0,0,0,,Aku adalah orang favoritmu...
Dialog: 0,1:03:52.82,1:03:55.94,Default,,0,0,0,,Anda paling tepercaya.
Dialog: 0,1:04:01.04,1:04:02.39,Default,,0,0,0,,Apa itu?
Dialog: 0,1:04:02.42,1:04:04.10,Default,,0,0,0,,Maaf.
Dialog: 0,1:04:04.13,1:04:07.73,Default,,0,0,0,,Menurutku kita tidak cukup dekat\Nuntuk berbicara santai dan berpelukan.
Dialog: 0,1:04:07.76,1:04:09.19,Default,,0,0,0,,Ada apa?
Dialogue: 0,1:04:09.22,1:04:11.63,Default,,0,0,0,,- Ini aku.\N- Permisi.
Dialog: 0,1:04:15.39,1:04:17.17,Default,,0,0,0,,Bagaimana dia tahu?
Dialog: 0,1:04:18.31,1:04:19.41,Default,,0,0,0,,Apa yang terjadi?
Dialog: 0,1:04:19.43,1:04:21.12,Default,,0,0,0,,Jika firasatnya sangat akurat,
Dialogue: 0,1:04:21.14,1:04:24.14,Default,,0,0,0,,kenapa dia masih membiarkan Eun-sung membodohinya?
Dialogue: 0,1:04:35.58,1:04:37.13,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda mempunyai email{\c}{\i0}
Dialog: 0,1:04:37.91,1:04:39.05,Default,,0,0,0,,Apa ini?
Dialog: 0,1:04:39.08,1:04:41.47,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pengirim Aqua: Hong Hae-in{\c}{\i0}
Dialog: 0,1:04:41.50,1:04:43.41,Default,,0,0,0,,Ini dari saya?
Dialog: 0,1:04:44.33,1:04:48.25,Default,,0,0,0,,Saya mengirim sendiri undangan?
Dialog: 0,1:04:56.89,1:04:59.17,Default,,0,0,0,,Anda boleh masuk.
Dialog: 0,1:04:59.56,1:05:01.09,Default,,0,0,0,,Oke.
Dialogue: 0,1:05:04.73,1:05:06.85,Default,,0,0,0,,Dia masuk sekarang.
Dialog: 0,1:05:10.61,1:05:13.35,Default,,0,0,0,,Mengapa tempat sebesar ini kosong?
Dialog: 0,1:05:52.99,1:05:54.38,Default,,0,0,0,,Mengapa kamu di sini?
Dialog: 0,1:05:54.40,1:05:56.40,Default,,0,0,0,,Saya ingin menanyakan hal itu kepada Anda.
Dialog: 0,1:06:00.95,1:06:03.49,Default,,0,0,0,,Anda mengirimi saya undangan.
Dialog: 0,1:06:19.60,1:06:20.99,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kita akan memulai pernikahannya...{\c}{\i0}
Dialog: 0,1:06:21.01,1:06:22.74,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dari Hong Hae-in, pengantin wanita,{\c}{\i0}
Dialog: 0,1:06:22.77,1:06:26.29,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dan Baek Hyun-woo, pengantin pria.{\c}{\i0}
Dialog: 0,1:06:26.31,1:06:28.14,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ini dia pengantin prianya.{\c}{\i0}
Dialog: 0,1:07:27.62,1:07:29.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baiklah...{\c}{\i0}
Dialog: 0,1:07:30.33,1:07:33.20,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana kabarmu, Hyun-woo dari masa depan?{\c}{\i0}
Dialogue: 0,1:07:33.59,1:07:35.69,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan bilang kamu sudah bercerai.{\c}{\i0}
Dialog: 0,1:07:35.71,1:07:37.57,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apakah kamu punya anak?{\c}{\i0}
Dialog: 0,1:07:37.59,1:07:38.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Satu? Dua?{\c}{\i0}
Dialog: 0,1:07:38.84,1:07:41.15,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tapi tidak masalah,{\c}{\i0}
Dialog: 0,1:07:41.18,1:07:44.76,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}karena yang kubutuhkan hanya Hae-in.{\c}{\i0}
Dialogue: 0,1:07:45.01,1:07:46.97,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan buat dia menangis.{\c}{\i0}
Dialogue: 0,1:07:47.10,1:07:48.88,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Buat dia bahagia.{\c}{\i0}
Dialog: 0,1:07:53.23,1:07:55.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in yang terhormat dari masa depan.{\c}{\i0}
Dialogue: 0,1:07:55.07,1:07:58.63,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya ragu Anda akan menontonnya, tapi jika ya,{\c}{\i0}
Dialog: 0,1:07:58.65,1:07:59.92,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}kenapa kamu?{\c}{\i0}
Dialog: 0,1:07:59.95,1:08:01.88,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Matikan ini dan mulai bekerja.{\c}{\i0}
Dialogue: 0,1:08:01.91,1:08:04.22,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku tidak akan menanyakan kabarmu, karena aku tahu...{\c}{\i0}
Dialog: 0,1:08:04.24,1:08:05.64,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}kamu akan baik-baik saja.{\c}{\i0}
Dialogue: 0,1:08:05.66,1:08:07.76,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kamu akan tetap cantik, sehat,{\c}{\i0}
Dialog: 0,1:08:07.79,1:08:10.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dan yang paling sukses.{\c}{\i0}
Dialog: 0,1:08:10.58,1:08:11.81,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dengan Hyun-woo...{\c}{\i0}
Dialog: 0,1:08:11.83,1:08:14.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dengan Anda, tentu saja.{\c}{\i0}
Dialog: 0,1:08:31.10,1:08:32.75,Default,,0,0,0,,Tn. Baek Hyun Woo?
Dialog: 0,1:08:32.77,1:08:34.30,Default,,0,0,0,,Ya.
Dialog: 0,1:08:35.36,1:08:39.77,Default,,0,0,0,,Ms. Hong menyewakan seluruh\Naquarium dan mengirimimu bunga-bunga ini.
Dialog: 0,1:08:40.61,1:08:42.19,Default,,0,0,0,,Saya menyewakan...
Dialogue: 0,1:08:42.24,1:08:44.34,Default,,0,0,0,,akuarium ini?
Dialog: 0,1:08:44.43,1:08:45.43,Default,,0,0,0,,Kapan?
Dialog: 0,1:08:45.45,1:08:46.43,Default,,0,0,0,,Sekitar sebulan yang lalu,
Dialog: 0,1:08:46.45,1:08:48.61,Default,,0,0,0,,dan empat tahun lalu juga.
Dialogue: 0,1:08:49.41,1:08:50.95,Default,,0,0,0,,Kalau begitu...
Dialogue: 0,1:08:52.08,1:08:54.56,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mereka bilang ini tempat kencan terbaik,{\c}{\i0}
Dialog: 0,1:08:54.58,1:08:56.66,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi kenapa kosong sekali?{\c}{\i0}
Dialog: 0,1:08:57.17,1:08:59.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ms. Hong, akhir-akhir ini...{\c}{\i0}
Dialog: 0,1:08:59.92,1:09:02.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}rasanya seperti seluruh alam semesta...{\c}{\i0}
Dialog: 0,1:09:02.76,1:09:05.63,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ada di pihak kita.{\c}{\i0}
Dialogue: 0,1:09:07.85,1:09:09.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu benar.{\c}{\i0}
Dialog: 0,1:09:12.23,1:09:13.93,Default,,0,0,0,,Saya mengerti.
Dialogue: 0,1:09:14.90,1:09:17.58,Default,,0,0,0,,Itu bukan alam semesta.
Dialog: 0,1:09:17.61,1:09:19.42,Default,,0,0,0,,Itu kamu.
Dialog: 0,1:09:19.44,1:09:20.75,Default,,0,0,0,,Saya tidak pernah tahu.
Dialogue: 0,1:09:20.78,1:09:24.19,Default,,0,0,0,,Saya tidak tahu tentang apa\Ni ini, tapi saya akan pergi.
Dialog: 0,1:09:35.29,1:09:36.27,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo.{\c}{\i0}
Dialogue: 0,1:09:36.29,1:09:37.89,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan coba-coba melewatkan pernikahannya...{\c}{\i0}
Dialog: 0,1:09:37.92,1:09:40.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}hanya karena aku kehilangan ingatanku.{\c}{\i0}
Dialogue: 0,1:09:40.67,1:09:43.73,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Karena ingatanku hilang, aku mungkin\Na sebaiknya memakai gaun pengantin lagi.{\c}{\i0}
Dialog: 0,1:09:43.76,1:09:45.32,Default,,0,0,0,,Apakah saya menulis ini?
Dialogue: 0,1:09:45.34,1:09:46.36,Default,,0,0,0,,Itu tidak mungkin.
Dialogue: 0,1:09:46.39,1:09:49.74,Default,,0,0,0,,Apa aku benar-benar ingin menikah lagi\Nlelaki yang berselingkuh...
Dialog: 0,1:09:49.76,1:09:51.97,Default,,0,0,0,,di belakangku?
Dialog: 0,1:09:52.23,1:09:53.20,Default,,0,0,0,,Tidak mungkin.
Dialog: 0,1:09:53.23,1:09:55.18,Default,,0,0,0,,Kamu benar.
Dialog: 0,1:09:55.27,1:09:57.14,Default,,0,0,0,,Kamu tidak akan melakukannya.
Dialog: 0,1:10:00.69,1:10:03.06,Default,,0,0,0,,Kamu tidak akan melakukan ini...
Dialog: 0,1:10:03.82,1:10:05.98,Default,,0,0,0,,kalau aku benar-benar selingkuh,
Dialog: 0,1:10:06.95,1:10:09.18,Default,,0,0,0,,jadi mulailah ragu.
Dialog: 0,1:10:09.20,1:10:11.34,Default,,0,0,0,,Kamu tidak perlu percaya padaku,
Dialog: 0,1:10:11.37,1:10:13.56,Default,,0,0,0,,tapi jangan percaya juga pada Eun-sung.
Dialog: 0,1:10:13.58,1:10:16.70,Default,,0,0,0,,Jangan percaya siapa pun. Meragukan segalanya.
Dialog: 0,1:10:17.79,1:10:19.49,Default,,0,0,0,,Eun-sung...
Dialogue: 0,1:10:19.54,1:10:21.79,Default,,0,0,0,,tidak pernah melindungimu.
Dialog: 0,1:10:22.92,1:10:27.50,Default,,0,0,0,,Dia telah mengisolasimu dari keluargamu dan aku.
Dialogue: 0,1:10:34.56,1:10:37.00,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Syukurlah kami tidak berada di dalam mobil,{\c}{\i0}
Dialogue: 0,1:10:37.02,1:10:40.12,Default,,0,0,0,,{\i1}{\c&HFFFF00&}tapi kukira begitu,{\c}{\i0}
Dialog: 0,1:10:40.15,1:10:43.52,Default,,0,0,0,,{\i1}{\c&HFFFF00&}jadi tanganku terluka saat mencoba memecahkan jendela.{\c}{\i0}
Dialog: 0,1:11:26.53,1:11:28.40,Default,,0,0,0,,Apakah ada yang salah?
Dialog: 0,1:11:30.66,1:11:32.44,Default,,0,0,0,,Ini bagus.
Dialog: 0,1:11:35.12,1:11:38.36,Default,,0,0,0,,Kamu mengkhawatirkanku.
Dialog: 0,1:11:38.96,1:11:41.28,Default,,0,0,0,,Saya punya pertanyaan.
Dialog: 0,1:11:41.63,1:11:43.49,Default,,0,0,0,,Tahan pikiran itu.
Dialogue: 0,1:11:44.42,1:11:48.11,Default,,0,0,0,,Aku mau makan\Nglass lagi. Apakah Anda menginginkannya?
Dialog: 0,1:11:48.13,1:11:49.96,Default,,0,0,0,,Saya baik-baik saja.
Dialog: 0,1:11:59.85,1:12:01.35,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Anda memiliki rekaman yang belum dibuka\NTonton sekarang{\c}{\i0}
Dialog: 0,1:12:12.16,1:12:13.13,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Percayai Kamera{\c}{\i0}
Dialog: 0,1:12:53.82,1:12:55.36,Default,,0,0,0,,Hae-in.
Dialogue: 0,1:12:56.74,1:12:58.51,Default,,0,0,0,,Haruskah kita pergi ke AS?
Dialogue: 0,1:12:58.54,1:13:00.22,Default,,0,0,0,,- Apa?\N- Kita berdua...
Dialog: 0,1:13:00.25,1:13:02.43,Default,,0,0,0,,ditinggalkan oleh keluarga kami,
Dialog: 0,1:13:02.46,1:13:04.35,Default,,0,0,0,,jadi...
Dialogue: 0,1:13:04.38,1:13:06.41,Default,,0,0,0,,mari kita...
Dialog: 0,1:13:08.25,1:13:09.95,Default,,0,0,0,,keluar.
Dialog: 0,1:13:10.34,1:13:13.58,Default,,0,0,0,,Kita bisa hidup bahagia di sana.
Dialog: 0,1:13:16.80,1:13:18.96,Default,,0,0,0,,Apakah kamu yakin aku ditinggalkan?
Dialog: 0,1:13:19.77,1:13:21.30,Default,,0,0,0,,Ada apa?
Dialog: 0,1:13:23.23,1:13:25.14,Default,,0,0,0,,Apakah menurutmu aku berbohong?
Dialogue: 0,1:13:28.90,1:13:30.77,Default,,0,0,0,,Bukan itu alasannya.
Dialog: 0,1:13:31.24,1:13:32.98,Default,,0,0,0,,Mari kita bicara lagi...
Dialog: 0,1:13:33.03,1:13:35.27,Default,,0,0,0,,saat kamu sadar.
Dialog: 0,1:13:40.74,1:13:43.45,Default,,0,0,0,,Anda punya pertanyaan untuk saya.
Dialog: 0,1:13:50.46,1:13:53.00,Default,,0,0,0,,Saya rasa saya tidak perlu bertanya.
Dialog: 0,1:13:55.30,1:13:57.13,Default,,0,0,0,,Sampai jumpa.
Dialog: 0,1:14:14.82,1:14:16.92,Default,,0,0,0,,Sekretaris Na, ini saya.
Dialog: 0,1:14:16.95,1:14:19.43,Default,,0,0,0,,Saya kehilangan ponsel lama saya,
Dialog: 0,1:14:19.45,1:14:20.98,Default,,0,0,0,,jadi...
Dialog: 0,1:14:21.12,1:14:23.32,Default,,0,0,0,,bisakah Anda memberi saya...
Dialog: 0,1:14:24.16,1:14:26.16,Default,,0,0,0,,Tn. Nomor Baek?
Dialog: 0,1:14:27.12,1:14:29.49,Default,,0,0,0,,Ya, kirim pesan ke saya.
Dialogue: 0,1:14:49.61,1:14:53.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sekretaris Na\NHIni nomor telepon Direktur Baek{\c}{\i0}
Dialog: 0,1:14:57.86,1:15:02.37,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Direktur Baek{\c}{\i0}
Dialog: 0,1:15:10.08,1:15:11.62,Default,,0,0,0,,Tn. Baek?
Dialogue: 0,1:15:11.67,1:15:13.27,Default,,0,0,0,,Ini aku, Hong Hae-in.
Dialog: 0,1:15:13.30,1:15:16.41,Default,,0,0,0,,Saya perlu bicara dengan Anda.
Dialog: 0,1:15:17.34,1:15:19.00,Default,,0,0,0,,Di mana kamu?
Dialog: 0,1:15:21.85,1:15:24.92,Default,,0,0,0,,Oke, saya akan segera ke sana.
Dialog: 0,1:15:42.74,1:15:43.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Penerima Hae-in Hong{\c}{\i0}
Dialog: 0,1:16:33.83,1:16:35.49,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kepada Baek Hyun-woo.{\c}{\i0}
Dialogue: 0,1:16:35.75,1:16:39.50,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Anda mungkin akan membaca\Nini saat saya sedang menjalani operasi.{\c}{\i0}
Dialog: 0,1:16:39.88,1:16:41.44,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika saya gagal...{\c}{\i0}
Dialog: 0,1:16:41.47,1:16:43.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}untuk bangun,{\c}{\i0}
Dialog: 0,1:16:43.84,1:16:46.17,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}maka ini bisa jadi keinginanku.{\c}{\i0}
Dialog: 0,1:16:47.31,1:16:50.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku tidak akan memintamu meratapiku\Nselama tiga tahun seperti dulu,{\c}{\i0}
Dialog: 0,1:16:50.85,1:16:53.96,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}tapi aku ingin kamu merindukanku...{\c}{\i0}
Dialog: 0,1:16:53.98,1:16:56.33,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}sepanjang empat musim,{\c}{\i0}
Dialog: 0,1:16:56.36,1:16:58.93,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dan panggil aku saat kamu mabuk,{\c}{\i0}
Dialogue: 0,1:16:59.15,1:17:01.48,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}tapi setelah itu,{\c}{\i0}
Dialog: 0,1:17:01.95,1:17:04.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}lupakan aku dan jalani hidupmu.{\c}{\i0}
Dialog: 0,1:17:06.28,1:17:08.93,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jatuh cinta dengan penuh gairah, menikah,{\c}{\i0}
Dialog: 0,1:17:08.95,1:17:11.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dan punya keluarga sendiri.{\c}{\i0}
Dialog: 0,1:17:11.79,1:17:13.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku berjanji tidak akan cemburu.{\c}{\i0}
Dialog: 0,1:17:18.05,1:17:20.62,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku sudah iri.{\c}{\i0}
Dialog: 0,1:17:23.30,1:17:24.94,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mengenai aset saya,{\c}{\i0}
Dialog: 0,1:17:24.97,1:17:27.92,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}belanjakan sesuai keinginan Anda.{\c}{\i0}
Dialogue: 0,1:17:28.72,1:17:31.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kupikir aku akan mati...{\c}{\i0}
Dialog: 0,1:17:31.10,1:17:33.05,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}membuatku terburu-buru.{\c}{\i0}
Dialogue: 0,1:17:33.52,1:17:36.29,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bisakah aku masuk surga jika aku terburu-buru\Nmelakukan beberapa perbuatan baik?{\c}{\i0}
Dialogue: 0,1:17:36.31,1:17:39.43,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dengan begitu aku bisa bertemu denganmu lagi.{\c}{\i0}
Dialog: 0,1:17:40.48,1:17:42.38,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baru memikirkan ini...{\c}{\i0}
Dialog: 0,1:17:42.40,1:17:44.40,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}membuatku sedih,{\c}{\i0}
Dialog: 0,1:17:45.07,1:17:46.77,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}tapi...{\c}{\i0}
Dialog: 0,1:17:47.87,1:17:50.72,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}bagaimana jika operasinya berhasil,{\c}{\i0}
Dialog: 0,1:17:50.74,1:17:53.61,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}tapi aku lupa siapa kamu?{\c}{\i0}
Dialogue: 0,1:17:54.67,1:17:57.20,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana jika aku memperlakukanmu seperti orang asing?{\c}{\i0}
Dialog: 0,1:17:59.25,1:18:00.90,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Atau lebih buruk lagi,{\c}{\i0}
Dialog: 0,1:18:00.92,1:18:03.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}bagaimana jika saya menganiaya Anda?{\c}{\i0}
Dialogue: 0,1:18:04.05,1:18:07.63,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bagaimana jika kamu tidak tahan\Nany lagi, dan muak padaku?{\c}{\i0}
Dialog: 0,1:18:07.84,1:18:09.96,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Apa yang harus saya lakukan selanjutnya?{\c}{\i0}
Dialog: 0,1:18:10.68,1:18:12.53,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bahkan jika itu terjadi,{\c}{\i0}
Dialog: 0,1:18:12.56,1:18:14.93,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jangan bosan denganku.{\c}{\i0}
Dialog: 0,1:18:15.77,1:18:17.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jangan sampai kehabisan tenaga.{\c}{\i0}
Dialog: 0,1:18:17.85,1:18:19.76,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tetap cintai aku.{\c}{\i0}
Dialog: 0,1:18:22.53,1:18:24.34,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Tipe idealku tidak akan pernah berubah,{\c}{\i0}
Dialog: 0,1:18:24.36,1:18:27.27,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi aku akan jatuh cinta padamu lagi.{\c}{\i0}
Dialogue: 0,1:18:27.53,1:18:29.30,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu bilang aku akan selalu menjadi tipe idealmu,{\c}{\i0}
Dialog: 0,1:18:29.32,1:18:30.72,Default,,0,0,0,,{\i1}{\c&HFFFF00&}dan kamu akan jatuh cinta padaku lagi.{\c}{\i0}
Dialog: 0,1:18:30.74,1:18:32.22,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamu sangat percaya diri,{\c}{\i0}
Dialog: 0,1:18:32.24,1:18:35.61,Default,,0,0,0,,{\i1}{\c&HFFFF00&}jadi kupikir kamu akan segera mengenaliku.{\c}{\i0}
Dialog: 0,1:18:36.37,1:18:38.53,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Harap bersabar sampai saat itu tiba.{\c}{\i0}
Dialog: 0,1:18:38.79,1:18:41.04,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kita tidak akan bertemu lagi.{\c}{\i0}
Dialogue: 0,1:18:41.17,1:18:43.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kita ketemu lagi,{\c}{\i0}
Dialog: 0,1:18:44.30,1:18:46.29,Default,,0,0,0,,{\i1}{\c&HFFFF00&}karena saya tidak akan menyerah.{\c}{\i0}
Dialog: 0,1:18:47.05,1:18:49.50,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku akan tetap bersamamu.{\c}{\i0}
Dialogue: 0,1:18:52.22,1:18:55.17,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saat aku akhirnya mengingatmu,{\c}{\i0}
Dialog: 0,1:18:57.44,1:18:59.47,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}ayo kita menikah lagi.{\c}{\i0}
Dialog: 0,1:19:12.49,1:19:14.19,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dan Hong Hae-in,{\c}{\i0}
Dialog: 0,1:19:14.41,1:19:16.14,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jika Anda membaca ini,{\c}{\i0}
Dialog: 0,1:19:16.16,1:19:21.16,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}itu pasti berarti operasinya berhasil\Ndan kamu tidak dapat mengingat apa pun,{\c}{\i0}
Dialog: 0,1:19:21.96,1:19:25.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi izinkan saya memperkenalkan dia kepada Anda.{\c}{\i0}
Dialog: 0,1:19:27.84,1:19:32.67,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hyun-woo bisa memperbaiki apa pun,{\c}{\i0}
Dialog: 0,1:19:33.43,1:19:35.58,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ini adalah baki. Kamu hanya perlu menariknya.{\c}{\i0}
Dialog: 0,1:19:35.60,1:19:37.08,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}- ...tapi dia banyak mengomel.{\c}{\i0}\N{\i1}{\c&HFFFF00&}- Nona Hong.{\c}{\i0}
Dialogue: 0,1:19:37.10,1:19:40.46,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Keluarkan kertas jika dikatakan macet.{\c}{\i0}
Dialogue: 0,1:19:40.48,1:19:41.87,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kenapa kamu menendangnya?{\c}{\i0}
Dialog: 0,1:19:41.90,1:19:43.67,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Karena kertasnya macet.{\c}{\i0}
Dialog: 0,1:19:43.69,1:19:46.38,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya sedang melakukan manuver Heimlich.{\c}{\i0}
Dialog: 0,1:19:46.40,1:19:48.90,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tolong jangan ditendang.{\c}{\i0}
Dialog: 0,1:19:49.20,1:19:51.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Minta saja bantuanku.{\c}{\i0}
Dialogue: 0,1:19:56.08,1:19:57.81,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah kakimu tidak sakit?{\c}{\i0}
Dialog: 0,1:19:57.83,1:19:59.82,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Yah...{\c}{\i0}
Dialog: 0,1:20:00.08,1:20:02.53,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Sedikit saja.{\c}{\i0}
Dialogue: 0,1:20:06.76,1:20:09.04,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Haruskah aku melihatnya?{\c}{\i0}
Dialog: 0,1:20:20.77,1:20:22.58,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia mudah dibodohi.{\c}{\i0}
Dialog: 0,1:20:22.60,1:20:24.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Tn. Baek, tahukah kamu?{\c}{\i0}
Dialog: 0,1:20:24.40,1:20:28.09,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Seekor rakun tinggal di taman atap kami.{\c}{\i0}
Dialog: 0,1:20:28.11,1:20:29.59,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Namanya Yeong-suk.{\c}{\i0}
Dialog: 0,1:20:29.61,1:20:31.44,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Yeong-suk.{\c}{\i0}
Dialogue: 0,1:20:32.41,1:20:35.43,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia bisa menjadi sangat manis saat\Ndia mabuk, jadi berhati-hatilah.{\c}{\i0}
Dialog: 0,1:20:35.45,1:20:37.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Aku yang minum, bukan dia.{\c}{\i0}
Dialogue: 0,1:20:37.79,1:20:40.24,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Apakah aku membuatmu tidak nyaman di sana?{\c}{\i0}
Dialog: 0,1:20:46.75,1:20:49.25,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Saya pikir kamu sudah mati.{\c}{\i0}
Dialogue: 0,1:20:49.34,1:20:51.25,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia menarik hati sanubarimu saat dia menangis,{\c}{\i0}
Dialog: 0,1:20:51.28,1:20:53.35,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi jangan buat dia menangis.{\c}{\i0}
Dialogue: 0,1:20:53.55,1:20:55.66,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dia sangat seksi dengan lengan baju terangkat,{\c}{\i0}
Dialog: 0,1:20:55.68,1:20:58.09,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}jadi lindungi dia.{\c}{\i0}
Dialog: 0,1:21:00.18,1:21:02.54,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Jika masih bingung,{\c}{\i0}
Dialog: 0,1:21:02.56,1:21:04.26,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}ingat saja ini.{\c}{\i0}
Dialogue: 0,1:21:04.90,1:21:06.89,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Dialah alasannya...{\c}{\i0}
Dialog: 0,1:21:07.52,1:21:10.85,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku tidak ingin kehilangan ingatanku,{\c}{\i0}
Dialog: 0,1:21:11.03,1:21:13.05,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dan bahkan jika saya melakukannya,{\c}{\i0}
Dialogue: 0,1:21:13.07,1:21:16.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}dialah alasanku ingin hidup.{\c}{\i0}
Dialog: 0,1:21:18.29,1:21:21.65,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo adalah orangnya...{\c}{\i0}
Dialog: 0,1:21:22.54,1:21:25.07,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku ingin mengingatnya selamanya.{\c}{\i0}
Dialog: 0,1:21:35.76,1:21:39.46,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Aku sangat senang dia bersamaku.{\c}{\i0}
Dialog: 0,1:21:41.22,1:21:43.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Saya berdoa dengan putus asa...{\c}{\i0}
Dialog: 0,1:21:43.85,1:21:46.18,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}bahwa dia akan tetap bersamamu...{\c}{\i0}
Dialog: 0,1:21:46.98,1:21:48.97,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}juga.{\c}{\i0}
Dialogue: 0,1:21:51.15,1:21:53.06,Default,,0,0,0,,Maafkan aku, Hyun-woo.
Dialogue: 0,1:21:54.70,1:21:56.61,Default,,0,0,0,,Maafkan aku.
Dialog: 0,1:22:14.34,1:22:16.59,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hae-in{\c}{\i0}
Dialog: 0,1:22:34.65,1:22:36.17,Default,,0,0,0,,Hae-in!
Dialog: 0,1:22:36.20,1:22:38.61,Default,,0,0,0,,Tetap disana! aku akan datang kepadamu!
Dialog: 0,1:23:11.27,1:23:12.97,Default,,0,0,0,,Hyun-woo.
Dialog: 0,1:23:14.44,1:23:16.56,Default,,0,0,0,,Maaf.
Dialogue: 0,1:24:15.55,1:24:19.50,Default,,0,0,0,,Saya mengikuti Mr. Yoon dan Ms. Hong di Jerman.
Dialogue: 0,1:24:24.39,1:24:28.88,Default,,0,0,0,,{\i1}Pertama-tama, dia merawatnya dengan rajin.{\i0}
Dialog: 0,1:24:38.44,1:24:40.30,Default,,0,0,0,,Haruskah kita masuk ke dalam jika kamu kedinginan?
Dialog: 0,1:24:40.32,1:24:41.34,Default,,0,0,0,,Tidak apa-apa.
Dialogue: 0,1:24:41.36,1:24:44.18,Default,,0,0,0,,{\i1}Mereka bisa dengan mudah melewati\Nas sebagai pasangan yang dibuat di surga,{\i0}
Dialog: 0,1:24:44.20,1:24:47.53,Default,,0,0,0,,tapi mereka tidak bisa menipu mataku yang tajam.
Dialog: 0,1:24:52.37,1:24:54.62,Default,,0,0,0,,Tidak apa-apa. Biarkan aku.
Dialog: 0,1:24:56.29,1:24:58.16,Default,,0,0,0,,Hae-in.
Dialog: 0,1:24:58.80,1:25:00.46,Default,,0,0,0,,Tidak apa-apa. Biarkan aku.
Dialog: 0,1:25:06.89,1:25:09.37,Default,,0,0,0,,Tidak apa-apa. Saya bisa berjalan sendiri.
Dialog: 0,1:25:09.39,1:25:11.91,Default,,0,0,0,,{\i1}Wanita tidak pernah menolak bantuan pria...{\i0}
Dialog: 0,1:25:11.94,1:25:14.46,Default,,0,0,0,,jika dia memiliki perasaan padanya.
Dialog: 0,1:25:14.48,1:25:15.83,Default,,0,0,0,,Dia mencoba melibatkannya,
Dialogue: 0,1:25:15.86,1:25:17.92,Default,,0,0,0,,tapi Ms. Hong bersikeras.
Dialogue: 0,1:25:17.94,1:25:21.05,Default,,0,0,0,,Hatinya masih tahu,\Nmeskipun dia kehilangan ingatannya.
Dialogue: 0,1:25:21.07,1:25:22.38,Default,,0,0,0,,"Aku tidak tertarik padanya."
Dialog: 0,1:25:22.40,1:25:24.05,Default,,0,0,0,,Akibatnya, Pak Yoon...
Dialog: 0,1:25:24.07,1:25:26.47,Default,,0,0,0,,merindu dengan cinta tak berbalas,
Dialog: 0,1:25:26.49,1:25:28.05,Default,,0,0,0,,jenis cinta yang paling sepi.
Dialog: 0,1:25:28.08,1:25:30.22,Default,,0,0,0,,Dia berurusan dengan cinta yang kesepian dan tak berbalas.
Dialogue: 0,1:25:30.25,1:25:32.57,Default,,0,0,0,,Itulah kesimpulanku.
Dialogue: 0,1:25:33.92,1:25:35.98,Default,,0,0,0,,Apa maksudmu mereka akan segera putus?
Dialog: 0,1:25:36.00,1:25:38.44,Default,,0,0,0,,Hubungan mereka pasti akan berakhir,
Dialog: 0,1:25:38.46,1:25:42.83,Default,,0,0,0,,tapi dia bisa bertindak serius\Nout begitu kenyataan mulai terjadi.
Dialogue: 0,1:25:42.92,1:25:45.04,Default,,0,0,0,,{\i1}Kita perlu waspada.{\i0}
Dialog: 0,1:26:02.86,1:26:07.47,Default,,0,0,0,,{\i1}Dia bisa menimbulkan bahaya bagi kita semua.{\i0}
Dialog: 0,1:26:07.49,1:26:10.37,Default,,0,0,0,,{\i1}{\c&HFFFF&}Ratu Air Mata{\c}{\i0}
Dialog: 0,1:26:41.69,1:26:43.43,Default,,0,0,0,,{\an8}{\i1}Apakah dia masih hidup?{\i0}
Dialog: 0,1:26:43.74,1:26:45.73,Default,,0,0,0,,{\an8}{\i1}Apakah dia sudah mati?{\i0}
Dialog: 0,1:26:46.28,1:26:47.51,Default,,0,0,0,,{\an8}{\i1}Terima kasih...{\i0}
Dialogue: 0,1:26:47.53,1:26:49.90,Default,,0,0,0,,{\an8}{\i1}karena selalu setia bersamaku.{\i0}
Dialog: 0,1:26:50.37,1:26:52.51,Default,,0,0,0,,{\an8}{\i1}Apa pun yang terjadi...{\i0}
Dialog: 0,1:26:52.54,1:26:54.01,Default,,0,0,0,,{\an8}{\i1}Baek Hyun-woo!{\i0}
Dialog: 0,1:26:54.04,1:26:56.24,Default,,0,0,0,,{\an8}{\i1}Aku akan melindunginya.{\i0}
