Dialogue: 0,0:00:19.47,0:00:23.86,Default,,0,0,0,,{\i1}{\c&HFFFF&}Kim Soo-hyun - Kim Ji-won{\c}{\i0}
Dialogue: 0,0:00:23.95,0:00:26.94,Default,,0,0,0,,{\i1}{\c&HFFFF&}Park Sung-hoon - Kwak Dong-yeon - Lee Joo-bin{\c}{\i0}
Dialogue: 0,0:00:31.55,0:00:33.50,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Gab-soo - Lee Mi-sook{\c}{\i0}
Dialogue: 0,0:00:33.63,0:00:35.63,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jung Jin-young - Na Young-hee{\c}{\i0}
Dialogue: 0,0:00:35.66,0:00:37.66,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jeon Bae-soo - Hwang Young-hee{\c}{\i0}
Dialogue: 0,0:00:37.68,0:00:39.70,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Kim Jung-nan - Kim Joo-ryoung{\c}{\i0}
Dialogue: 0,0:00:39.73,0:00:41.88,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Jang Yoon-ju - Kim Do-hyun{\c}{\i0}
Dialogue: 0,0:00:50.13,0:00:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Screenwriter: Park Ji-eun{\c}{\i0}
Dialogue: 0,0:00:53.00,0:00:55.61,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Mga Direktor: Jang Young-woo - Kim Hee-won{\c}{\i0}
Dialogue: 0,0:00:59.14,0:01:02.03,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,0:01:03.27,0:01:05.30,Default,,0,0,0,,Pasensya na sumigaw ako.
Dialogue: 0,0:01:13.19,0:01:14.89,Default,,0,0,0,,Ang totoo...
Dialogue: 0,0:01:16.74,0:01:18.52,Default,,0,0,0,,Hindi ko maalala.
Dialogue: 0,0:01:19.99,0:01:22.94,Default,,0,0,0,,Hindi ko talaga maalala kung bakit ako nandoon.
Dialogue: 0,0:01:27.12,0:01:29.24,Default,,0,0,0,,Nasa harap ako ng bahay mo,
Dialogue: 0,0:01:29.54,0:01:32.54,Default,,0,0,0,,tapos bigla akong nasa ibang lugar.
Dialogue: 0,0:01:36.47,0:01:39.08,Default,,0,0,0,,Hindi ko alam kung kailan ako pumunta doon,
Dialogue: 0,0:01:40.97,0:01:43.01,Default,,0,0,0,,o paano.
Dialogue: 0,0:01:46.18,0:01:47.89,Default,,0,0,0,,Wala akong ideya.
Dialogue: 0,0:01:49.48,0:01:51.26,Default,,0,0,0,,Ako ay...
Dialogue: 0,0:01:55.82,0:01:57.52,Default,,0,0,0,,nakakatakot.
Dialogue: 0,0:03:41.09,0:03:44.04,Default,,0,0,0,,Nga pala, bakit ka pumunta dito mag-isa?
Dialogue: 0,0:03:47.22,0:03:49.84,Default,,0,0,0,,Nag-text sa akin ang ate mo.
Dialogue: 0,0:03:50.06,0:03:53.18,Default,,0,0,0,,Natatalo daw ang tatay mo sa eleksyon.
Dialogue: 0,0:03:53.35,0:03:56.81,Default,,0,0,0,,Pinapanalo ng kanyang karibal ang mga botante sa pamamagitan ng pagkain.
Dialogue: 0,0:03:59.53,0:04:01.98,Default,,0,0,0,,Kaya ka pumunta?
Dialogue: 0,0:04:03.36,0:04:05.67,Default,,0,0,0,,Ibig sabihin, natatalo siya...
Dialogue: 0,0:04:05.70,0:04:08.01,Default,,0,0,0,,sa sopas ng baboy at bigas.
Dialogue: 0,0:04:08.03,0:04:09.43,Default,,0,0,0,,Paano ako uupo?
Dialogue: 0,0:04:09.45,0:04:13.74,Default,,0,0,0,,Kaya pala nag counterattack ka\Ngamit ang beef at lobster?
Dialogue: 0,0:04:14.50,0:04:16.44,Default,,0,0,0,,Dapat nasaksihan mo...
Dialogue: 0,0:04:16.46,0:04:19.66,Default,,0,0,0,,kung paano ko walang awang pinalo ang 200 bowl ng sopas.
Dialogue: 0,0:04:47.07,0:04:48.30,Default,,0,0,0,,{\i1}Hae-in!{\i0}
Dialogue: 0,0:04:48.32,0:04:50.43,Default,,0,0,0,,{\i1}- Hae-in!\N- Hae-in!{\i0}
Dialogue: 0,0:04:50.45,0:04:51.55,Default,,0,0,0,,{\i1}Hae-in!{\i0}
Dialogue: 0,0:04:51.58,0:04:53.57,Default,,0,0,0,,Nandiyan ba siya?
Dialogue: 0,0:04:53.83,0:04:54.85,Default,,0,0,0,,Hindi, hindi siya.
Dialogue: 0,0:04:54.87,0:04:56.68,Default,,0,0,0,,- Hae-in!\N- Hindi mo pa siya nahahanap?
Dialogue: 0,0:04:56.71,0:04:57.89,Default,,0,0,0,,Nasaan siya?
Dialogue: 0,0:04:57.92,0:04:59.27,Default,,0,0,0,,Nasaan kaya siya?
Dialogue: 0,0:04:59.29,0:05:00.48,Default,,0,0,0,,Kaawa-awa kong Hae-in!
Dialogue: 0,0:05:00.50,0:05:01.86,Default,,0,0,0,,Tumawag ng pulis!
Dialogue: 0,0:05:01.88,0:05:03.65,Default,,0,0,0,,- Kailangan natin!\N- Hae-in!
Dialogue: 0,0:05:03.67,0:05:05.23,Default,,0,0,0,,- Hae-in!\N- Nasaan ka?
Dialogue: 0,0:05:05.26,0:05:06.40,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:05:06.43,0:05:07.97,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialogue: 0,0:05:07.99,0:05:09.03,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:05:09.05,0:05:10.11,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialogue: 0,0:05:10.14,0:05:12.24,Default,,0,0,0,,- Hae-in!\N- Saan siya nagpunta?
Dialogue: 0,0:05:12.27,0:05:14.16,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialogue: 0,0:05:14.18,0:05:16.45,Default,,0,0,0,,- Hae-in!\N- Hae-in!
Dialogue: 0,0:05:16.48,0:05:18.05,Default,,0,0,0,,Hae-in!
Dialogue: 0,0:05:18.65,0:05:20.35,Default,,0,0,0,,Sus!
Dialogue: 0,0:05:20.40,0:05:21.92,Default,,0,0,0,,Kabutihan.
Dialogue: 0,0:05:21.94,0:05:23.84,Default,,0,0,0,,Goodness, my poor baby!
Dialogue: 0,0:05:23.86,0:05:27.02,Default,,0,0,0,,Goodness! Dito ka noon!
Dialogue: 0,0:05:31.91,0:05:32.89,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Episode 5{\c}{\i0}
Dialogue: 0,0:05:32.91,0:05:35.18,Default,,0,0,0,,{\an8}Nagulat talaga kami.
Dialogue: 0,0:05:35.20,0:05:37.82,Default,,0,0,0,,{\an8}Nasaan ka?
Dialogue: 0,0:05:39.96,0:05:42.73,Default,,0,0,0,,{\an8}Tigilan mo na ang pagtatanong sa kanya.
Dialogue: 0,0:05:42.75,0:05:44.36,Default,,0,0,0,,{\an8}Pare, matulog ka na.
Dialogue: 0,0:05:44.38,0:05:45.36,Default,,0,0,0,,{\an8}Okay.
Dialogue: 0,0:05:45.38,0:05:47.40,Default,,0,0,0,,{\an8}Huwag mo kaming pansinin.
Dialogue: 0,0:05:47.43,0:05:50.32,Default,,0,0,0,,{\an8}Maagang natutulog ang mga tao dito,
Dialogue: 0,0:05:50.34,0:05:52.45,Default,,0,0,0,,{\an8}- kaya mag-ayos ka sa bahay.\N- Tama siya.
Dialogue: 0,0:05:52.47,0:05:54.20,Default,,0,0,0,,{\an8}- Isipin mo kaming invisible.\N- Tama.
Dialogue: 0,0:05:54.22,0:05:55.49,Default,,0,0,0,,{\an8}Hindi kapani-paniwala.
Dialogue: 0,0:05:55.52,0:05:57.87,Default,,0,0,0,,{\an8}Paano ka magiging invisible kapag nandito ka? Pumunta ka.
Dialogue: 0,0:05:57.89,0:05:59.91,Default,,0,0,0,,{\an8}- Tara na. Gabi.\N- Gabi.
Dialogue: 0,0:05:59.94,0:06:01.64,Default,,0,0,0,,{\an8}Magandang gabi.
Dialogue: 0,0:06:19.12,0:06:20.95,Default,,0,0,0,,Kailangan kong patuyuin ang aking buhok.
Dialogue: 0,0:06:22.46,0:06:23.69,Default,,0,0,0,,May hair dryer ba?
Dialogue: 0,0:06:23.71,0:06:25.75,Default,,0,0,0,,Isang minuto.
Dialogue: 0,0:06:32.55,0:06:35.67, Default,,0,0,0,, Medyo luma na ito.
Dialogue: 0,0:06:36.06,0:06:37.76,Default,,0,0,0,,Okay lang.
Dialogue: 0,0:06:44.11,0:06:46.23,Default,,0,0,0,,Hindi ito gumagana.
Dialogue: 0,0:06:46.78,0:06:49.80,Default,,0,0,0,,Kailangan mong pindutin ang ibaba.
Dialogue: 0,0:06:49.82,0:06:51.94,Default,,0,0,0,,Ganito?
Dialogue: 0,0:06:53.07,0:06:54.82,Default,,0,0,0,,Hawakan ang cable.
Dialogue: 0,0:06:56.66,0:06:58.57,Default,,0,0,0,,Hayaan mo akong gawin ito.
Dialogue: 0,0:07:02.13,0:07:05.20,Default,,0,0,0,,May paraan para gawin ito.
Dialogue: 0,0:07:37.58,0:07:40.03,Default,,0,0,0,,- Tuyo na lahat ngayon.\N- Tama.
Dialogue: 0,0:07:40.54,0:07:42.70,Default,,0,0,0,,Sa tingin ko magaling ka.
Dialogue: 0,0:07:56.55,0:07:58.26,Default,,0,0,0,,Nay!
Dialogue: 0,0:07:59.60,0:08:01.24,Default,,0,0,0,,Tingnan ito.
Dialogue: 0,0:08:01.27,0:08:03.75,Default,,0,0,0,,Hindi iyon binabago ng mga tao\Neasily. Anong meron sa kanya?
Dialogue: 0,0:08:03.77,0:08:04.83,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:08:04.85,0:08:08.29,Default,,0,0,0,,Si Hae-in ay biglang bumisita sa kanyang in-laws.
Dialogue: 0,0:08:08.32,0:08:10.67,Default,,0,0,0,,- What for?\N- Kaya naman ako natulala.
Dialogue: 0,0:08:10.69,0:08:12.59,Default,,0,0,0,,Hindi kapani-paniwala ang mga Hillbillies.
Dialogue: 0,0:08:12.61,0:08:15.17,Default,,0,0,0,,Kinuha nila ito at in-upload.
Dialogue: 0,0:08:15.20,0:08:17.11,Default,,0,0,0,,Mag-upload ng ano?
Dialogue: 0,0:08:17.53,0:08:19.30,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Anong ginagawa mo dito?{\c}{\i0}
Dialogue: 0,0:08:19.33,0:08:21.56,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Natutuwa akong nandito kayong lahat.{\c}{\i0}
Dialogue: 0,0:08:21.58,0:08:23.64,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Na-miss ko ang huling kaarawan mo,{\c}{\i0}
Dialogue: 0,0:08:23.66,0:08:27.31,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}kaya pumunta ako para i-treat ang mga taganayon ng pagkain.{\c}{\i0}
Dialogue: 0,0:08:27.34,0:08:28.42,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Magandang CEO Hong Hae-in{\c}{\i0}
Dialogue: 0,0:08:28.45,0:08:31.57,Default,,0,0,0,,{\an8}Kahit kailan hindi niya ako sinurprise sa birthday ko.
Dialogue: 0,0:08:31.59,0:08:34.50,Default,,0,0,0,,Hindi kapani-paniwala.
Dialogue: 0,0:08:41.68,0:08:43.45,Default,,0,0,0,,Nagugutom ka ba?
Dialogue: 0,0:08:43.48,0:08:45.64,Default,,0,0,0,,May gusto ka bang kainin?
Dialogue: 0,0:08:47.10,0:08:48.81,Default,,0,0,0,,Kumain na ako ng marami.
Dialogue: 0,0:08:48.86,0:08:50.54,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mayroon ka ba nito, pwede ba?{\c}{\i0}
Dialogue: 0,0:08:50.57,0:08:52.79,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ito ay soy-sauce marinated crab.{\c}{\i0}
Dialogue: 0,0:08:52.82,0:08:54.67,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Puno ito ng roe.{\c}{\i0}
Dialogue: 0,0:08:54.70,0:08:57.38,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Kilala kami sa aming toyo.{\c}{\i0}
Dialogue: 0,0:08:57.41,0:08:59.80,Default,,0,0,0,,{\an8}{\i1}{\c&H7AA0FF&}Ito ay frozen na pork belly\Ngrilled over briquettes.{\c}{\i0}
Dialogue: 0,0:08:59.83,0:09:01.97,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kumain bago lumamig.{\c}{\i0}
Dialogue: 0,0:09:01.99,0:09:04.77,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Isa-isa ko silang kinakain, kaya pakihintay.{\c}{\i0}
Dialogue: 0,0:09:04.79,0:09:06.43,Default,,0,0,0,,{\i1}{\c&HFFFF00&}- Ano ang susunod?\N- Subukan din ito.{\c}{\i0}
Dialogue: 0,0:09:06.46,0:09:08.89,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Lumipat ka, pwede ba? Sinasakal mo ang baby ko.{\c}{\i0}
Dialogue: 0,0:09:08.92,0:09:10.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Huwag masyadong katawa-tawa.{\c}{\i0}
Dialogue: 0,0:09:10.71,0:09:13.61,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ngumunguya nang dahan-dahan, o magkakaroon ka ng sakit ng tiyan.{\c}{\i0}
Dialogue: 0,0:09:13.63,0:09:16.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Uminom din ng tubig.{\c}{\i0}
Dialogue: 0,0:09:18.47,0:09:20.36,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Bigyan siya ng ilan sa mga itlog.{\c}{\i0}
Dialogue: 0,0:09:20.39,0:09:22.74,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hayaan mo akong gawin ito.{\c}{\i0}
Dialogue: 0,0:09:22.77,0:09:26.09,Default,,0,0,0,,Bakit nila siya hindi komportable?
Dialogue: 0,0:09:26.56,0:09:29.04,Default,,0,0,0,,At bakit siya kumakain\Neverything they're giving her?
Dialogue: 0,0:09:29.06,0:09:30.87,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Pinakamainam ang frozen na tiyan ng baboy kapag mainit.{\c}{\i0}
Dialogue: 0,0:09:30.90,0:09:31.96,Default,,0,0,0,,{\an8}Ano?
Dialogue: 0,0:09:31.98,0:09:35.23,Default,,0,0,0,,{\an8}Paano nagkaroon ng mahigit 300,000 view ang video na ito?
Dialogue: 0,0:09:35.70,0:09:38.09,Default,,0,0,0,,Bakit ang dami niyang kinakain?
Dialogue: 0,0:09:38.11,0:09:42.80,Default,,0,0,0,,Beef, baboy, manok, pato, at isda.
Dialogue: 0,0:09:42.83,0:09:44.72,Default,,0,0,0,,Mayroon akong lahat ng uri ng karne.
Dialogue: 0,0:09:44.75,0:09:47.27,Default,,0,0,0,,Tumaba na yata ako.
Dialogue: 0,0:09:47.29,0:09:49.31,Default,,0,0,0,,- Talaga?\N- I mean...
Dialogue: 0,0:09:49.33,0:09:53.50,Default,,0,0,0,,Isang babae ang nag-alok sa akin ng manok na kahit kailan ay hindi niya ginawa para sa kanyang manugang.
Dialogue: 0,0:09:55.01,0:09:58.75,Default,,0,0,0,,I think the villagers like me.
Dialogue: 0,0:10:08.44,0:10:12.75,Default,,0,0,0,,Mukhang maganda ang lagay nila, kaya\Ndon't dare to mention the divorce.
Dialogue: 0,0:10:12.77,0:10:14.33,Default,,0,0,0,,Nakuha mo.
Dialogue: 0,0:10:14.36,0:10:15.88,Default,,0,0,0,,Nasabi mo na ba kahit kanino sa ngayon?
Dialogue: 0,0:10:15.90,0:10:19.73,Default,,0,0,0,,Halika, Nanay. Tulala ako kung gagawin ko.
Dialogue: 0,0:10:25.75,0:10:27.47,Default,,0,0,0,,- Bakit ang tahimik mo?\N- Ano?
Dialogue: 0,0:10:27.50,0:10:30.06,Default,,0,0,0,,Kabutihan. Sino ito? Sino ang sinabi mo?
Dialogue: 0,0:10:30.08,0:10:32.23,Default,,0,0,0,,Nagkaroon ako ng {\i1}makgeolli{\i0} kasama si Yeong-song at...
Dialogue: 0,0:10:32.25,0:10:33.23,Default,,0,0,0,,- Ano?\N- Ano?
Dialogue: 0,0:10:33.25,0:10:35.41,Default,,0,0,0,,Sinabi mo sa kanya na...
Dialogue: 0,0:10:35.63,0:10:38.44,Default,,0,0,0,,Sinabi mo sa kanya na muntik nang makipaghiwalay si Hyun-woo?
Dialogue: 0,0:10:38.47,0:10:43.92,Default,,0,0,0,,Well, si Yeong-song ay parang isang\Nmarriage counselor ng village na ito,
Dialogue: 0,0:10:44.60,0:10:46.47,Default,,0,0,0,,kaya kinunsulta ko siya.
Dialogue: 0,0:10:46.56,0:10:47.53,Default,,0,0,0,,Nalungkot ako.
Dialogue: 0,0:10:47.56,0:10:49.13,Default,,0,0,0,,Iyon lang.
Dialogue: 0,0:10:49.44,0:10:51.41,Default,,0,0,0,,Paano kung sinabi niya sa iba?
Dialogue: 0,0:10:51.44,0:10:53.76,Default,,0,0,0,,- Oo.\N- Mabilis kumalat ang salita.
Dialogue: 0,0:10:53.98,0:10:57.21,Default,,0,0,0,,Ang konsultasyon ay tungkol sa pagiging kumpidensyal.
Dialogue: 0,0:10:57.23,0:11:01.65,Default,,0,0,0,,Hindi niya kailangang ilihim,\Ndahil hindi siya lisensyadong doktor.
Dialogue: 0,0:11:04.87,0:11:07.26,Default,,0,0,0,,Sus. Kahit pa...
Dialogue: 0,0:11:07.29,0:11:10.49,Default,,0,0,0,,Ikaw at ang iyong malaking bibig.
Dialogue: 0,0:11:11.42,0:11:13.12,Default,,0,0,0,,Halika.
Dialogue: 0,0:11:19.76,0:11:22.61,Default,,0,0,0,,Nag-alala ka, kaya ka pumunta dito sa ganitong oras?
Dialogue: 0,0:11:22.64,0:11:24.82,Default,,0,0,0,,Sinabi mo ba kahit kanino?
Dialogue: 0,0:11:24.85,0:11:26.55,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,0:11:27.47,0:11:29.83,Default,,0,0,0,,nasabi ko lang sa nanay ko.
Dialogue: 0,0:11:29.85,0:11:31.62,Default,,0,0,0,,Bakit mo gagawin?
Dialogue: 0,0:11:31.64,0:11:34.08,Default,,0,0,0,,Du-gwan, siya lang ang pamilya ko.
Dialogue: 0,0:11:34.11,0:11:36.72,Default,,0,0,0,,Ibinabahagi namin ang lahat,
Dialogue: 0,0:11:37.19,0:11:40.60,Default,,0,0,0,,at alam mo ang kalagayan niya.
Dialogue: 0,0:11:48.33,0:11:51.99,Default,,0,0,0,,Kailan ka umuwi, Honey?\NBakit palagi kang wala?
Dialogue: 0,0:11:52.04,0:11:53.68,Default,,0,0,0,,Saan ka natutulog nitong mga araw na ito?
Dialogue: 0,0:11:53.71,0:11:55.31,Default,,0,0,0,,Nay, matulog ka na.
Dialogue: 0,0:11:55.33,0:11:57.54,Default,,0,0,0,,Sino ka?
Dialogue: 0,0:11:57.96,0:12:00.19,Default,,0,0,0,,See? Kaya huwag kang mag-alala sa kanya,
Dialogue: 0,0:12:00.21,0:12:02.44,Default,,0,0,0,,at mag-alala tungkol sa iyong anak at sa kanyang asawa.
Dialogue: 0,0:12:02.47,0:12:04.49,Default,,0,0,0,,Walang dapat ipag-alala.
Dialogue: 0,0:12:04.51,0:12:05.95,Default,,0,0,0,,Sa kabila ng pagiging abala,
Dialogue: 0,0:12:05.97,0:12:08.37,Default,,0,0,0,,Pumunta dito si Hae-in para tulungan ang aking kampanya.
Dialogue: 0,0:12:08.39,0:12:10.59,Default,,0,0,0,,- Ano ang ibig sabihin nito?\N- Ano?
Dialogue: 0,0:12:10.64,0:12:14.34,Default,,0,0,0,,Ibig sabihin baliw na baliw ang dalawa.
Dialogue: 0,0:12:18.48,0:12:21.18,Default,,0,0,0,,Ano ito? Ang cute.
Dialogue: 0,0:12:21.90,0:12:24.23,Default,,0,0,0,,Ito ay palaging paborito ko.
Dialogue: 0,0:12:29.45,0:12:31.28,Default,,0,0,0,,Ang iyong kamay.
Dialogue: 0,0:12:38.42,0:12:40.83,Default,,0,0,0,,Hindi ka na dapat mag-isa.
Dialogue: 0,0:12:41.96,0:12:43.96,Default,,0,0,0,,Lagi kang nasasaktan.
Dialogue: 0,0:13:00.23,0:13:02.77,Default,,0,0,0,,Balita ko ito ang iyong lifeline.
Dialogue: 0,0:13:04.11,0:13:05.63,Default,,0,0,0,,Bakit napakaikli ng akin?
Dialogue: 0,0:13:05.65,0:13:07.31,Default,,0,0,0,,Na-offend ako.
Dialogue: 0,0:13:08.03,0:13:09.63,Default,,0,0,0,,Halika.
Dialogue: 0,0:13:09.66,0:13:11.34,Default,,0,0,0,,Naniniwala ka ba sa pagbasa ng palad?
Dialogue: 0,0:13:11.37,0:13:14.22,Default,,0,0,0,,Hindi, ngunit hindi ito maganda sa pakiramdam.
Dialogue: 0,0:13:14.25,0:13:17.28,Default,,0,0,0,,May sakit na ako, at maikli ang lifeline ko.
Dialogue: 0,0:13:18.13,0:13:20.31,Default,,0,0,0,,Wala kang sakit na nakamamatay.
Dialogue: 0,0:13:20.34,0:13:22.15,Default,,0,0,0,,Hindi mo gustong maging pasyente.
Dialogue: 0,0:13:22.17,0:13:23.73,Default,,0,0,0,,Sabi mo gagaling ka.
Dialogue: 0,0:13:23.76,0:13:27.67,Default,,0,0,0,,Sabi mo ang Diyos ay kakampi mo,\Nand na may mangyayaring milagro.
Dialogue: 0,0:13:31.26,0:13:35.51,Default,,0,0,0,,Sabi mo ang pinakamahusay na cancer center\Nin Europe ang magagaling sa lahat!
Dialogue: 0,0:13:41.86,0:13:45.14,Default,,0,0,0,,Hindi ko sinabing gagamutin nila ang lahat.
Dialogue: 0,0:13:45.57,0:13:48.40,Default,,0,0,0,,Sinasabi ko lang.
Dialogue: 0,0:13:48.61,0:13:51.65,Default,,0,0,0,,May dahilan kung bakit sila ang pinakamahusay.
Dialogue: 0,0:13:52.20,0:13:53.90,Default,,0,0,0,,Sa tingin mo ba?
Dialogue: 0,0:14:00.79,0:14:02.62,Default,,0,0,0,,Magagawa mo bang...
Dialogue: 0,0:14:04.51,0:14:06.08,Default,,0,0,0,,samahan mo ako?
Dialogue: 0,0:14:09.93,0:14:12.75,Default,,0,0,0,,Hindi naman sa takot akong pumunta mag-isa.
Dialogue: 0,0:14:13.06,0:14:16.34,Default,,0,0,0,,Ikaw lang ang taong nakakaalam na may sakit ako.
Dialogue: 0,0:14:27.90,0:14:29.81,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:14:31.91,0:14:33.82,Default,,0,0,0,,Iyan ay ibinigay.
Dialogue: 0,0:14:40.42,0:14:42.12,Default,,0,0,0,,Nakakasakit pa rin ba?
Dialogue: 0,0:15:53.16,0:15:54.76,Default,,0,0,0,,Nabaliw ka na ba?
Dialogue: 0,0:15:54.78,0:15:56.64,Default,,0,0,0,,Ano ang sinusubukan mong gawin?
Dialogue: 0,0:15:56.66,0:15:58.39,Default,,0,0,0,,Huwag sabihin sa akin...
Dialogue: 0,0:15:58.41,0:16:00.70,Default,,0,0,0,,gusto mo siyang halikan.
Dialogue: 0,0:16:01.71,0:16:02.93,Default,,0,0,0,,My gosh.
Dialogue: 0,0:16:02.96,0:16:04.91,Default,,0,0,0,,Baliw ka.
Dialogue: 0,0:16:05.46,0:16:06.99,Default,,0,0,0,,Nababaliw ka.
Dialogue: 0,0:16:11.88,0:16:13.53,Default,,0,0,0,,Ngunit pa rin,
Dialogue: 0,0:16:13.55,0:16:16.54,Default,,0,0,0,,dapat hindi mo siya pinabayaang nakabitin.
Dialogue: 0,0:16:17.43,0:16:19.26,Default,,0,0,0,,Nagulat siya.
Dialogue: 0,0:16:23.10,0:16:24.62,Default,,0,0,0,,Babalik ka?
Dialogue: 0,0:16:24.65,0:16:27.93,Default,,0,0,0,,Ano ang sasabihin mo sa kanya? Anong gagawin mo?
Dialogue: 0,0:16:28.52,0:16:31.60,Default,,0,0,0,,Sa tingin mo ba makakabalik ka sa labas?
Dialogue: 0,0:16:33.53,0:16:35.23,Default,,0,0,0,,Hindi, hindi mo kaya.
Dialogue: 0,0:16:36.45,0:16:39.57,Default,,0,0,0,,Hindi. Hindi ako makakaalis...
Dialogue: 0,0:16:39.62,0:16:41.32,Default,,0,0,0,,kung babalik ako.
Dialogue: 0,0:16:41.91,0:16:43.86,Default,,0,0,0,,Hindi ko kaya.
Dialogue: 0,0:16:54.97,0:16:56.67,Default,,0,0,0,,Tumakas ba siya?
Dialogue: 0,0:16:58.35,0:17:00.09,Default,,0,0,0,,Hindi.
Dialogue: 0,0:17:00.18,0:17:01.74,Default,,0,0,0,,Sigurado ako...
Dialogue: 0,0:17:01.77,0:17:04.20,Default,,0,0,0,,may gagawin siya.
Dialogue: 0,0:17:04.23,0:17:07.97,Default,,0,0,0,,Siguro kailangan niyang pumunta sa banyo o tumawag.
Dialogue: 0,0:17:18.41,0:17:20.07,Default,,0,0,0,,Ngunit hanggang sa ganito katagal?
Dialogue: 0,0:17:24.29,0:17:25.93,Default,,0,0,0,,Pwede bang tumahimik ka?
Dialogue: 0,0:17:25.96,0:17:28.35,Default,,0,0,0,,Sus, ang ingay mo.
Dialogue: 0,0:17:28.38,0:17:30.03,Default,,0,0,0,,Shut up!
Dialogue: 0,0:17:31.71,0:17:32.98,Default,,0,0,0,,Nagtalo ba kayo ni Hae-in?
Dialogue: 0,0:17:33.01,0:17:34.75,Default,,0,0,0,,Hindi.
Dialogue: 0,0:17:35.05,0:17:36.57,Default,,0,0,0,,Ito ay ang kabaligtaran.
Dialogue: 0,0:17:36.59,0:17:39.15,Default,,0,0,0,,Tapos pinaparusahan ka?
Dialogue: 0,0:17:39.18,0:17:42.88,Default,,0,0,0,,Sinabi ba niya sa iyo na lumabas ka\Nand magmuni-muni nang isang oras?
Dialogue: 0,0:17:43.35,0:17:45.83,Default,,0,0,0,,- Nagawa mo na ba yun?\N- Maraming beses,
Dialogue: 0,0:17:45.85,0:17:49.58,Default,,0,0,0,,pero mas lalo siyang\Nupset kung gagawin mo ang sinasabi niya.
Dialogue: 0,0:17:49.61,0:17:54.14,Default,,0,0,0,,Patawarin ka niya kung\Nnagmadali kang bumalik at humingi ng tawad.
Dialogue: 0,0:17:54.57,0:17:57.19,Default,,0,0,0,,Iyan ay mainit.
Dialogue: 0,0:17:59.45,0:18:02.84,Default,,0,0,0,,Kaya humawak ka at bumalik sa loob.
Dialogue: 0,0:18:02.87,0:18:06.20,Default,,0,0,0,,Nandito lang ako...
Dialogue: 0,0:18:06.83,0:18:09.32,Default,,0,0,0,,para matauhan ako.
Dialogue: 0,0:18:09.88,0:18:11.77,Default,,0,0,0,,Hindi ako makapag-isip ng maayos sa bahay.
Dialogue: 0,0:18:11.79,0:18:13.45,Default,,0,0,0,,Bakit hindi?
Dialogue: 0,0:18:22.89,0:18:25.26,Default,,0,0,0,,Hindi ko alam. hindi ko lang kaya.
Dialogue: 0,0:18:45.12,0:18:46.10,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Baek Hyun-woo{\c}{\i0}
Dialogue: 0,0:18:53.09,0:18:54.99,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Nasaan ka?{\c}{\i0}
Dialogue: 0,0:19:02.14,0:19:04.38,Default,,0,0,0,,Bakit hindi niya ito binabasa?
Dialogue: 0,0:19:04.97,0:19:07.30,Default,,0,0,0,,Uy, binasa niya.
Dialogue: 0,0:19:20.90,0:19:22.09,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Matulog ka na.{\c}{\i0}
Dialogue: 0,0:19:22.11,0:19:25.11,Default,,0,0,0,,"Matulog ka na"?
Dialogue: 0,0:19:25.99,0:19:28.07,Default,,0,0,0,,Gusto niya akong matulog ngayon?
Dialogue: 0,0:19:29.33,0:19:30.86,Default,,0,0,0,,Sa aking sarili?
Dialogue: 0,0:19:40.05,0:19:41.53,Default,,0,0,0,,Fine.
Dialogue: 0,0:19:41.55,0:19:43.29,Default,,0,0,0,,Iyon ang gusto niya.
Dialogue: 0,0:19:44.47,0:19:45.78,Default,,0,0,0,,Matulog ka na.
Dialogue: 0,0:19:45.80,0:19:47.34,Default,,0,0,0,,Matulog ka na.
Dialogue: 0,0:19:51.60,0:19:53.29,Default,,0,0,0,,Darn it.
Dialogue: 0,0:19:53.31,0:19:54.50,Default,,0,0,0,,Kaya tumakas siya.
Dialogue: 0,0:19:54.52,0:19:58.81,Default,,0,0,0,,Bakit? Akala niya ba kakainin ko siya ng buhay? Natatakot ba siya sa akin?
Dialogue: 0,0:20:02.95,0:20:04.90,Default,,0,0,0,,Tumahimik!
Dialogue: 0,0:20:11.75,0:20:13.60,Default,,0,0,0,,Bakit siya natatakot sa akin?
Dialogue: 0,0:20:13.62,0:20:16.37,Default,,0,0,0,,Paano ako nakakatakot?
Dialogue: 0,0:20:17.21,0:20:19.73,Default,,0,0,0,,Maging ang mga aso ay natutulog.
Dialogue: 0,0:20:19.76,0:20:22.28,Default,,0,0,0,,Umuwi na tayo ngayon.
Dialogue: 0,0:20:22.30,0:20:24.40,Default,,0,0,0,,Mananatili ako sa labas nang kaunti.
Dialogue: 0,0:20:24.43,0:20:27.03,Default,,0,0,0,,Matutulog mag-isa si Hae-in, pagkatapos.
Dialogue: 0,0:20:27.05,0:20:29.63,Default,,0,0,0,,Oo, kaya nga.
Dialogue: 0,0:20:30.10,0:20:32.18,Default,,0,0,0,,Babalik ako kapag bumalik siya.
Dialogue: 0,0:20:34.60,0:20:38.08,Default,,0,0,0,,Sus, ang tanga mo.
Dialogue: 0,0:20:38.11,0:20:39.29,Default,,0,0,0,,Bakit?
Dialogue: 0,0:20:39.32,0:20:41.56,Default,,0,0,0,,Bakit ka maghihintay hanggang doon?
Dialogue: 0,0:20:47.20,0:20:48.90,Default,,0,0,0,,Dahil baka...
Dialogue: 0,0:20:50.29,0:20:51.82,Default,,0,0,0,,magkamali.
Dialogue: 0,0:20:52.04,0:20:53.01,Default,,0,0,0,,Ano ang ibig mong sabihin?
Dialogue: 0,0:20:53.04,0:20:55.06,Default,,0,0,0,,Nagkakamali ka lang kapag lasing ka.
Dialogue: 0,0:20:55.08,0:20:57.31,Default,,0,0,0,,Hindi ka dapat uminom kung ganoon.
Dialogue: 0,0:20:57.33,0:20:58.56,Default,,0,0,0,,Hindi.
Dialogue: 0,0:20:58.59,0:21:01.25,Default,,0,0,0,,Hindi ako magkakamali...
Dialogue: 0,0:21:01.76,0:21:03.19,Default,,0,0,0,,kung uminom ako at mahimatay.
Dialogue: 0,0:21:03.22,0:21:06.17,Default,,0,0,0,,Wala akong ideya sa sinasabi mo.
Dialogue: 0,0:21:07.55,0:21:09.20,Default,,0,0,0,,Makinig nang mabuti.
Dialogue: 0,0:21:09.22,0:21:12.92,Default,,0,0,0,,Iinom pa ako,
Dialogue: 0,0:21:13.35,0:21:16.05,Default,,0,0,0,,at tuluyang nasayang.
Dialogue: 0,0:21:16.81,0:21:18.04,Default,,0,0,0,,Just do me one favor.
Dialogue: 0,0:21:18.06,0:21:20.77,Default,,0,0,0,,- Ano ito?\N- Huwag...
Dialogue: 0,0:21:21.15,0:21:23.18,Default,,0,0,0,,ilagay mo ako...
Dialogue: 0,0:21:24.53,0:21:26.23,Default,,0,0,0,,balik sa kwarto ko.
Dialogue: 0,0:21:33.00,0:21:34.99,Default,,0,0,0,,Naliligaw na ako.
Dialogue: 0,0:21:36.29,0:21:38.81,Default,,0,0,0,,Gusto mo ba ng {\i1}ramyun?{\i0} Gagawa ako.
Dialogue: 0,0:21:40.59,0:21:45.33,Default,,0,0,0,,Takot na takot ako noon sa asawa ko.
Dialogue: 0,0:21:56.27,0:21:57.93,Default,,0,0,0,,Dati akong...
Dialogue: 0,0:21:58.52,0:22:00.43,Default,,0,0,0,,okay.
Dialogue: 0,0:22:02.73,0:22:05.44,Default,,0,0,0,,Sigurado akong hindi ako mabibigla,
Dialogue: 0,0:22:05.90,0:22:08.27,Default,,0,0,0,,kahit anong mangyari sa kanya.
Dialogue: 0,0:22:09.07,0:22:12.78,Default,,0,0,0,,Bakit? Dahil hindi ko siya nagustuhan.
Dialogue: 0,0:22:16.29,0:22:19.06,Default,,0,0,0,,Tulad ng nagawa ko sa ngayon,
Dialogue: 0,0:22:19.08,0:22:22.44,Default,,0,0,0,,Kailangan ko lang ipagpatuloy ang hindi pagkagusto,
Dialogue: 0,0:22:22.46,0:22:23.44,Default,,0,0,0,,naghihinanakit,
Dialogue: 0,0:22:23.46,0:22:25.19,Default,,0,0,0,,at pagod sa kanya.
Dialogue: 0,0:22:25.21,0:22:28.29,Default,,0,0,0,,I just need to anticipate the day we part ways.
Dialogue: 0,0:22:29.97,0:22:32.21,Default,,0,0,0,,Hindi ko kailangan magkagusto sa kanya.
Dialogue: 0,0:22:33.18,0:22:34.88,Default,,0,0,0,,Simple lang.
Dialogue: 0,0:22:35.27,0:22:37.43,Default,,0,0,0,,Ginagawa ko na ito sa buong panahon.
Dialogue: 0,0:23:00.54,0:23:02.24,Default,,0,0,0,,Pero...
Dialogue: 0,0:23:03.21,0:23:04.99,Default,,0,0,0,,kakaibang,
Dialogue: 0,0:23:07.13,0:23:09.33,Default,,0,0,0,,Hindi ko na kaya.
Dialogue: 0,0:23:22.98,0:23:24.51,Default,,0,0,0,,Fine.
Dialogue: 0,0:23:25.07,0:23:27.64,Default,,0,0,0,,Hindi namin kailangang matulog nang magkasama.
Dialogue: 0,0:23:27.78,0:23:30.56,Default,,0,0,0,,Magkahiwalay kaming natutulog sa loob ng maraming taon.
Dialogue: 0,0:23:33.03,0:23:34.24,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Dalawang Taon ang Nakaraan{\c}{\i0}
Dialogue: 0,0:23:37.45,0:23:38.89,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:23:38.91,0:23:42.16,Default,,0,0,0,,Ms. Sinabi sa amin ni Hong na linisin ang kwarto.
Dialogue: 0,0:23:47.67,0:23:50.78,Default,,0,0,0,,Ang team ng produkto ang namamahala\Hindi pumili at mag-alis ng mga brand.
Dialogue: 0,0:23:50.80,0:23:53.96,Default,,0,0,0,,Kailangang tumuon ang sales team\Non sa performance ng mga brand.
Dialogue: 0,0:23:57.43,0:23:59.38,Default,,0,0,0,,Maghintay.
Dialogue: 0,0:23:59.68,0:24:01.38,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:24:02.31,0:24:04.01,Default,,0,0,0,,Ang nursery.
Dialogue: 0,0:24:04.90,0:24:07.29,Default,,0,0,0,,- Naglilinis ka ba?\N- Ano ang silbi nito?
Dialogue: 0,0:24:07.32,0:24:09.64,Default,,0,0,0,,Nakakainis lang ako.
Dialogue: 0,0:24:13.53,0:24:15.97,Default,,0,0,0,,Nakakabalisa ka?
Dialogue: 0,0:24:15.99,0:24:18.36,Default,,0,0,0,,Hindi na namin ito kailangan.
Dialogue: 0,0:24:29.46,0:24:34.07,Default,,0,0,0,,Hindi maakit ng team ng produkto ang\Nmagandang brand na may mahinang performance.
Dialogue: 0,0:24:34.09,0:24:36.29,Default,,0,0,0,,Hindi ba obvious?
Dialogue: 0,0:24:39.64,0:24:41.34,Default,,0,0,0,,Oo.
Dialogue: 0,0:24:48.82,0:24:50.96,Default,,0,0,0,,Pakilipat ang mga gamit ko sa kwartong ito.
Dialogue: 0,0:24:50.98,0:24:52.21,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:24:52.24,0:24:54.10,Default,,0,0,0,,Kailangan ko rin ng kama.
Dialogue: 0,0:24:55.45,0:24:56.72,Default,,0,0,0,,Mananatili ako dito sa ngayon.
Dialogue: 0,0:24:56.74,0:24:58.32,Default,,0,0,0,,Oo, sir.
Dialogue: 0,0:27:32.85,0:27:34.60,Default,,0,0,0,,Huwag kang umiyak.
Dialogue: 0,0:27:36.27,0:27:38.23,Default,,0,0,0,,Wala kang karapatan.
Dialogue: 0,0:28:51.31,0:28:53.22,Default,,0,0,0,,Gising ka ng maaga.
Dialogue: 0,0:28:53.94,0:28:56.26,Default,,0,0,0,,Mukhang nakatulog ako?
Dialogue: 0,0:28:56.31,0:28:58.22,Default,,0,0,0,,Hindi ka man lang nakatulog?
Dialogue: 0,0:29:01.94,0:29:03.60,Default,,0,0,0,,Ano sa iyo?
Dialogue: 0,0:29:12.87,0:29:14.60,Default,,0,0,0,,Ho-yeol, di ba dapat pumasok ka sa school?
Dialogue: 0,0:29:14.62,0:29:17.48,Default,,0,0,0,,Tatay, bakit mahalaga iyon?
Dialogue: 0,0:29:17.50,0:29:19.66,Default,,0,0,0,,My life mentor...
Dialogue: 0,0:29:19.92,0:29:21.95,Default,,0,0,0,,nandito.
Dialogue: 0,0:29:22.80,0:29:24.98,Default,,0,0,0,,Ano ang ibig mong sabihin? Sino ang iyong mentor?
Dialogue: 0,0:29:25.01,0:29:27.28,Default,,0,0,0,,Siya ang haligi ng pamilya\Nna dumating sakay ng supercar.
Dialogue: 0,0:29:27.30,0:29:30.66,Default,,0,0,0,,Tita ko ito, isang gusali\Nowner at ang aking huwaran.
Dialogue: 0,0:29:30.68,0:29:33.51,Default,,0,0,0,,Ayan na siya.
Dialogue: 0,0:29:34.14,0:29:36.75,Default,,0,0,0,,- Lumabas ka na.\N- Gosh, Hae-in.
Dialogue: 0,0:29:36.77,0:29:38.93,Default,,0,0,0,,Salamat.
Dialogue: 0,0:29:39.44,0:29:40.71,Default,,0,0,0,,Napakarami mong ginawa.
Dialogue: 0,0:29:40.73,0:29:41.96,Default,,0,0,0,,Umuwi nang ligtas.
Dialogue: 0,0:29:41.98,0:29:43.98,Default,,0,0,0,,Paalam.
Dialogue: 0,0:29:45.61,0:29:47.51,Default,,0,0,0,,- Hyun-woo.\N- Hello, ma'am.
Dialogue: 0,0:29:47.53,0:29:49.65,Default,,0,0,0,,- Paalam.\N- Yes, ma'am.
Dialogue: 0,0:29:50.45,0:29:52.30,Default,,0,0,0,,Matino na naman ang nanay mo.
Dialogue: 0,0:29:52.33,0:29:54.60,Default,,0,0,0,,Yeong-song, mas magaling na siya ngayon.
Dialogue: 0,0:29:54.62,0:29:56.35,Default,,0,0,0,,Kabutihan, Ina.
Dialogue: 0,0:29:56.37,0:29:57.48,Default,,0,0,0,,Manatiling matatag.
Dialogue: 0,0:29:57.50,0:29:58.77,Default,,0,0,0,,Salamat.
Dialogue: 0,0:29:58.79,0:30:02.33,Default,,0,0,0,,Ang diborsyo ay wala.
Dialogue: 0,0:30:02.46,0:30:04.27,Default,,0,0,0,,Gusto ko ring makipagdiborsiyo.
Dialogue: 0,0:30:04.30,0:30:06.83,Default,,0,0,0,,Dapat, kapag nagkaroon ako ng pagkakataon.
Dialogue: 0,0:30:07.88,0:30:09.92,Default,,0,0,0,,Kabutihan, Ina.
Dialogue: 0,0:30:10.30,0:30:12.46,Default,,0,0,0,,Gosh, ma'am.
Dialogue: 0,0:30:12.56,0:30:14.70,Default,,0,0,0,,I think she's out of it again.
Dialogue: 0,0:30:14.72,0:30:16.66,Default,,0,0,0,,Dapat kang magmadaling umuwi.
Dialogue: 0,0:30:16.68,0:30:18.16,Default,,0,0,0,,Tara na.
Dialogue: 0,0:30:18.19,0:30:21.93,Default,,0,0,0,,Honey, dito ka ba natulog kagabi?
Dialogue: 0,0:30:22.61,0:30:26.52,Default,,0,0,0,,Ito mismo ang dahilan kung bakit gusto ko ng divorce.
Dialogue: 0,0:30:27.86,0:30:28.84,Default,,0,0,0,,Uwi na lang tayo.
Dialogue: 0,0:30:28.86,0:30:31.43,Default,,0,0,0,,- Dapat hiniwalayan na kita!\N- Tara na!
Dialogue: 0,0:30:31.45,0:30:33.59,Default,,0,0,0,,- You should go.\N- She's a villager.
Dialogue: 0,0:30:33.62,0:30:35.36,Default,,0,0,0,,Medyo demented siya.
Dialogue: 0,0:30:35.70,0:30:37.95,Default,,0,0,0,,Paalam, Mahal.
Dialogue: 0,0:30:43.21,0:30:45.40,Default,,0,0,0,,Pasensya na sa abala.
Dialogue: 0,0:30:45.42,0:30:46.98,Default,,0,0,0,,Sige, kung ganoon.
Dialogue: 0,0:30:47.01,0:30:50.25,Default,,0,0,0,,- Paalam.\N- Sus, hindi ka naging abala.
Dialogue: 0,0:30:51.55,0:30:52.70,Default,,0,0,0,,Hindi ito marami,
Dialogue: 0,0:30:52.72,0:30:56.26,Default,,0,0,0,,ngunit wala akong ginamit na pestisidyo,\Nkaya siguraduhing kainin mo ang mga ito.
Dialogue: 0,0:31:03.48,0:31:06.92,Default,,0,0,0,,Hae-in, alam kong mahalaga ang trabaho,
Dialogue: 0,0:31:06.94,0:31:09.23,Default,,0,0,0,,pero nauuna ang iyong kalusugan.
Dialogue: 0,0:31:11.11,0:31:12.68,Default,,0,0,0,,You should go.
Dialogue: 0,0:31:12.70,0:31:14.32,Default,,0,0,0,,Salamat.
Dialogue: 0,0:31:14.95,0:31:17.53,Default,,0,0,0,,Okay, makauwi ng ligtas.
Dialogue: 0,0:31:18.91,0:31:22.74,Default,,0,0,0,,- Tara na.\N- Salamat, Hae-in.
Dialogue: 0,0:31:23.17,0:31:25.33,Default,,0,0,0,,- Paalam.\N- Go.
Dialogue: 0,0:31:27.13,0:31:28.73,Default,,0,0,0,,Aalis na tayo, kung gayon.
Dialogue: 0,0:31:28.76,0:31:31.07,Default,,0,0,0,,- Okay.\N- Okay.
Dialogue: 0,0:31:31.09,0:31:33.67,Default,,0,0,0,,Tawagan mo ako.
Dialogue: 0,0:31:49.74,0:31:51.81,Default,,0,0,0,,May sigarilyo ka ba?
Dialogue: 0,0:31:53.78,0:31:55.32,Default,,0,0,0,,Hindi.
Dialogue: 0,0:31:59.37,0:32:00.64,Default,,0,0,0,,Sa tingin mo ba nahuli niya?
Dialogue: 0,0:32:00.66,0:32:02.22,Default,,0,0,0,,Sino ang nakakaalam?
Dialogue: 0,0:32:02.25,0:32:04.27,Default,,0,0,0,,Sa tingin ko hindi niya ginawa,
Dialogue: 0,0:32:04.29,0:32:07.31,Default,,0,0,0,,ngunit may malamig na hangin\Nsa pagitan nila kahit noon pa man.
Dialogue: 0,0:32:07.34,0:32:09.82,Default,,0,0,0,,Iniwasan pa nila ang eye contact bago tumalon.
Dialogue: 0,0:32:09.84,0:32:11.15,Default,,0,0,0,,Hindi ka dapat nag-usap...
Dialogue: 0,0:32:11.17,0:32:13.57,Default,,0,0,0,,tungkol sa kung paano siya nakatanggap ng mga love letter noong nakaraan,
Dialogue: 0,0:32:13.59,0:32:17.36,Default,,0,0,0,,at kung paano nagka-crush sa kanya ang anak ng principal. Lahat ng walang kwentang usapan.
Dialogue: 0,0:32:17.39,0:32:19.24,Default,,0,0,0,,- Siguradong nagalit ito sa kanya.\N- Ano?
Dialogue: 0,0:32:19.27,0:32:21.24,Default,,0,0,0,,Joke lang.
Dialogue: 0,0:32:21.27,0:32:22.45,Default,,0,0,0,,Nakakatawa ba?
Dialogue: 0,0:32:22.48,0:32:25.79,Default,,0,0,0,,- Seryoso ka?\N- Hindi siya natulog sa kwarto niya kagabi.
Dialogue: 0,0:32:25.81,0:32:27.12,Default,,0,0,0,,- Ano?\N- Ano?
Dialogue: 0,0:32:27.15,0:32:28.46,Default,,0,0,0,,Kung gayon ano ang ginawa niya?
Dialogue: 0,0:32:28.48,0:32:30.46,Default,,0,0,0,,Sabay kaming uminom sa tindahan.
Dialogue: 0,0:32:30.49,0:32:31.88,Default,,0,0,0,,Masakit yun.
Dialogue: 0,0:32:31.90,0:32:33.34,Default,,0,0,0,,Nagpumilit ka, di ba?
Dialogue: 0,0:32:33.36,0:32:35.05,Default,,0,0,0,,Hindi, ayaw niyang pumunta.
Dialogue: 0,0:32:35.07,0:32:38.07,Default,,0,0,0,,Sa palagay ko ang hiwalay na pagtulog ay naging awkward.
Dialogue: 0,0:32:42.21,0:32:44.93,Default,,0,0,0,,Paano mamatay ang kanilang pagmamahalan?
Dialogue: 0,0:32:44.96,0:32:48.16,Default,,0,0,0,,Dati silang baliw sa pag-ibig.
Dialogue: 0,0:32:48.34,0:32:50.83,Default,,0,0,0,,Ikinalulungkot ko ang biglaang pagpupulong na ito.
Dialogue: 0,0:32:51.01,0:32:53.92,Default,,0,0,0,,Sigurado kang nakabihis para sa isang intern.
Dialogue: 0,0:32:54.01,0:32:56.45,Default,,0,0,0,,{\an8}Dapat gusto mo ang mga luxury brand. ako din.
Dialogue: 0,0:32:56.47,0:32:58.05,Default,,0,0,0,,{\an8}{\i1}{\c&HFFFF&}Apat na Taon ang Nakaraan{\c}{\i0}
Dialogue: 0,0:32:59.06,0:33:01.87,Default,,0,0,0,,Mr. Pauwi na si Baek\N galing sa trabaho sa labas.
Dialogue: 0,0:33:01.89,0:33:05.05,Default,,0,0,0,,Alam ko. Kaya kita tinawagan.
Dialogue: 0,0:33:05.69,0:33:07.39,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:33:09.40,0:33:11.34,Default,,0,0,0,,Tungkol kay Hyun-woo...
Dialogue: 0,0:33:11.36,0:33:12.54,Default,,0,0,0,,Alam ko.
Dialogue: 0,0:33:12.57,0:33:14.76,Default,,0,0,0,,Disente siya. Sigurado akong gusto mo siya.
Dialogue: 0,0:33:14.78,0:33:17.73,Default,,0,0,0,,Matalino siya at gwapo.
Dialogue: 0,0:33:17.87,0:33:19.68,Default,,0,0,0,,Sinabi ba niya sa iyo kung ilang baka ang pag-aari natin?
Dialogue: 0,0:33:19.70,0:33:22.18,Default,,0,0,0,,- Oo.\N- Pati ang laki ng taniman natin?
Dialogue: 0,0:33:22.20,0:33:25.07,Default,,0,0,0,,At pagmamay-ari natin ang nag-iisang tindahan sa bayan?
Dialogue: 0,0:33:27.38,0:33:29.14,Default,,0,0,0,,Paano ang bahay niya sa Seoul?
Dialogue: 0,0:33:29.17,0:33:30.56,Default,,0,0,0,,Pumirma siya ng dalawang taong lease.
Dialogue: 0,0:33:30.59,0:33:33.83,Default,,0,0,0,,Kung gayon dapat mong malaman.
Dialogue: 0,0:33:34.76,0:33:39.67,Default,,0,0,0,,Hindi ko alam na materialistic pala ako,\Npero hindi ko mapigilan since kapamilya siya.
Dialogue: 0,0:33:41.47,0:33:43.37,Default,,0,0,0,,Balita ko mahirap ka,
Dialogue: 0,0:33:43.39,0:33:46.25,Default,,0,0,0,,at nagsusuot ka ng maruruming damit.
Dialogue: 0,0:33:46.27,0:33:49.10,Default,,0,0,0,,Hindi, lahat sila ay espesyal na vintage...
Dialogue: 0,0:33:49.94,0:33:52.63,Default,,0,0,0,,Ano ang alam niya, gayon pa man?
Dialogue: 0,0:33:52.65,0:33:54.75,Default,,0,0,0,,Totoo iyan. Anyway...
Dialogue: 0,0:33:54.78,0:33:56.30,Default,,0,0,0,,Pwede bang hindi mo na siya makita?
Dialogue: 0,0:33:56.32,0:33:58.73,Default,,0,0,0,,Hinding-hindi ako makikipaghiwalay sa kanya,
Dialogue: 0,0:33:59.20,0:34:00.18,Default,,0,0,0,,at iyon ang pangwakas.
Dialogue: 0,0:34:00.20,0:34:02.34,Default,,0,0,0,,Masyado kang makasarili.
Dialogue: 0,0:34:02.37,0:34:05.14,Default,,0,0,0,,Lahat ng babaeng gustong makipag-date\Nsiya ay matagumpay na mga indibidwal,
Dialogue: 0,0:34:05.16,0:34:08.02,Default,,0,0,0,,gaya ng mga civil servant at\Nmajor company employees.
Dialogue: 0,0:34:08.04,0:34:09.89,Default,,0,0,0,,Alam kong malupit ito, ngunit ito ay katotohanan.
Dialogue: 0,0:34:09.92,0:34:12.73,Default,,0,0,0,,- Mi-seon!\N- Goodness.
Dialogue: 0,0:34:12.75,0:34:14.15,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:34:14.17,0:34:16.46,Default,,0,0,0,,Ano ang sinabi mo kay Hae-in?
Dialogue: 0,0:34:16.97,0:34:18.74,Default,,0,0,0,,- Wala akong masyadong sinabi. Ako...\N- Sus.
Dialogue: 0,0:34:18.76,0:34:20.78,Default,,0,0,0,,Sabi ko sayong itigil mo na ang panonood ng mga drama!
Dialogue: 0,0:34:20.80,0:34:24.09,Default,,0,0,0,,Ang pera ay medyo maliit hindi katulad ng mga drama.
Dialogue: 0,0:34:24.43,0:34:27.87,Default,,0,0,0,,Uy, gusto ko lang maghiwalay kayo\Nbago kayo lumaki sa isa't isa,
Dialogue: 0,0:34:27.89,0:34:31.10,Default,,0,0,0,,at maging tapat tayo. Hindi mo siya type.
Dialogue: 0,0:34:36.44,0:34:38.31,Default,,0,0,0,,- Let me go.\N- Okay.
Dialogue: 0,0:34:41.91,0:34:45.39,Default,,0,0,0,,Ano nga ba ang type niya?
Dialogue: 0,0:34:45.41,0:34:47.36,Default,,0,0,0,, Malambot at dalisay na mga babae.
Dialogue: 0,0:34:47.41,0:34:49.22,Default,,0,0,0,,Hindi isang taong may ugali na tulad mo.
Dialogue: 0,0:34:49.25,0:34:51.44,Default,,0,0,0,,Isang taong nangangailangan ng proteksyon.
Dialogue: 0,0:34:51.46,0:34:54.52,Default,,0,0,0,,Lagi niyang sinasabi yan simula high school.
Dialogue: 0,0:34:54.55,0:34:56.71,Default,,0,0,0,,Totoo ba yan Mr. Baek?
Dialogue: 0,0:34:57.59,0:35:00.46,Default,,0,0,0,,Oo, type ko yan dati,
Dialogue: 0,0:35:02.05,0:35:03.75,Default,,0,0,0,,pero...
Dialogue: 0,0:35:04.31,0:35:06.55,Default,,0,0,0,,ang babaeng mahal ko ngayon...
Dialogue: 0,0:35:07.10,0:35:08.63,Default,,0,0,0,,ikaw ba,
Dialogue: 0,0:35:10.52,0:35:11.79,Default,,0,0,0,,kaya...
Dialogue: 0,0:35:11.81,0:35:14.52,Default,,0,0,0,,huwag kang abala sa pakikinig sa kanya.
Dialogue: 0,0:35:15.23,0:35:16.98,Default,,0,0,0,,Tara na.
Dialogue: 0,0:35:18.24,0:35:20.06,Default,,0,0,0,,Tara na.
Dialogue: 0,0:35:28.04,0:35:29.89,Default,,0,0,0,,Iyan ay kahanga-hanga.
Dialogue: 0,0:35:29.91,0:35:32.52,Default,,0,0,0,,Hindi ako makapaniwala na ginawa mo iyon.
Dialogue: 0,0:35:32.54,0:35:34.90,Default,,0,0,0,,Sa madaling salita, tinulungan ko silang magsama-sama.
Dialogue: 0,0:35:34.92,0:35:38.52,Default,,0,0,0,,Mukhang mas naging close sila pagkatapos ng insidenteng iyon.
Dialogue: 0,0:35:38.55,0:35:40.57,Default,,0,0,0,,Sus.
Dialogue: 0,0:35:40.59,0:35:42.58,Default,,0,0,0,,Ano sa mundo...
Dialogue: 0,0:35:42.72,0:35:44.88,Default,,0,0,0,,{\i1}nangyari sa kanila?{\i0}
Dialogue: 0,0:36:04.20,0:36:05.68,Default,,0,0,0,,Okay lang. Hayaan mo akong gawin ito.
Dialogue: 0,0:36:05.70,0:36:06.97,Default,,0,0,0,,- Oo, sir.\N- Salamat.
Dialogue: 0,0:36:06.99,0:36:08.69,Default,,0,0,0,,Walang problema.
Dialogue: 0,0:36:25.51,0:36:27.63,Default,,0,0,0,,Hindi ako naghintay.
Dialogue: 0,0:36:27.68,0:36:31.30,Default,,0,0,0,,Wag mong isipin na hinihintay ko si\Nyou dahil lang sa gising ko.
Dialogue: 0,0:36:31.85,0:36:34.72,Default,,0,0,0,,Hindi ako ganyan. Tara na sa loob.
Dialogue: 0,0:36:35.40,0:36:37.10,Default,,0,0,0,,Malamig.
Dialogue: 0,0:36:39.57,0:36:41.34,Default,,0,0,0,,Hindi lang ako makatulog.
Dialogue: 0,0:36:41.36,0:36:43.92,Default,,0,0,0,,Hindi ko ito sariling kama, ang mga aso ay tumatahol lahat,
Dialogue: 0,0:36:43.95,0:36:46.26,Default,,0,0,0,,at wala akong mga pampatulog. kaya lang.
Dialogue: 0,0:36:46.28,0:36:48.72,Default,,0,0,0,,Sige. Sa tingin ko hindi ka rin naghintay.
Dialogue: 0,0:36:48.74,0:36:51.56,Default,,0,0,0,,Hindi mo pa ako hinintay.
Dialogue: 0,0:36:51.58,0:36:54.73,Default,,0,0,0,,Tama ka. Hindi ako yung tipong maghihintay.
Dialogue: 0,0:36:54.75,0:36:57.70,Default,,0,0,0,,Oo, mas alam ko iyon kaysa sa iba.
Dialogue: 0,0:37:19.77,0:37:22.06,Default,,0,0,0,,Hawakan nang maayos ang payong.
Dialogue: 0,0:37:24.78,0:37:26.80,Default,,0,0,0,,Okay, so pasok na lang tayo sa loob.
Dialogue: 0,0:37:26.82,0:37:29.26,Default,,0,0,0,,Bumubuhos na. Lalamigin ka.
Dialogue: 0,0:37:29.28,0:37:30.59,Default,,0,0,0,,Makakausap tayo sa bahay.
Dialogue: 0,0:37:30.62,0:37:32.57,Default,,0,0,0,,Tapos na akong magsalita.
Dialogue: 0,0:37:43.09,0:37:44.65,Default,,0,0,0,,Nasaan ang payong mo?
Dialogue: 0,0:37:44.67,0:37:46.54,Default,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:37:47.51,0:37:49.54,Default,,0,0,0,,Mag-usap tayo sa loob.
Dialogue: 0,0:37:51.43,0:37:53.38,Default,,0,0,0,,Halika.
Dialogue: 0,0:38:27.55,0:38:28.94,Default,,0,0,0,,Hayaan mo akong magpalit.
Dialogue: 0,0:38:28.97,0:38:30.79,Default,,0,0,0,,Okay.
Dialogue: 0,0:38:34.31,0:38:36.13,Default,,0,0,0,,Gusto mo ba ng tsaa?
Dialogue: 0,0:38:36.31,0:38:38.01,Default,,0,0,0,,Hindi, salamat.
Dialogue: 0,0:38:39.15,0:38:41.51,Default,,0,0,0,,Pakiramdam ko ako ang may-ari dito.
Dialogue: 0,0:38:43.90,0:38:47.39,Default,,0,0,0,,Nga pala, bakit ka nandito?
Dialogue: 0,0:38:47.53,0:38:48.76,Default,,0,0,0,,Tama.
Dialogue: 0,0:38:48.78,0:38:50.63,Default,,0,0,0,,Inimbitahan ako ng nanay ni Hae-in.
Dialogue: 0,0:38:50.66,0:38:52.01,Default,,0,0,0,,Siguradong masama ang pakiramdam niya...
Dialogue: 0,0:38:52.03,0:38:53.97,Default,,0,0,0,,na kailangan kong kumain mag-isa sa hotel,
Dialogue: 0,0:38:53.99,0:38:55.85,Default,,0,0,0,,kaya inalok niya ako ng guest house.
Dialogue: 0,0:38:55.87,0:38:57.72,Default,,0,0,0,,May gagawin kami ni Hae-in,
Dialogue: 0,0:38:57.75,0:39:01.49,Default,,0,0,0,,kaya mas maginhawa para sa atin ang pananatili dito.
Dialogue: 0,0:39:02.46,0:39:06.06,Default,,0,0,0,,- Hindi ka ba komportable?\N- Aalis ka ba kung sinabi kong oo?
Dialogue: 0,0:39:06.09,0:39:07.62,Default,,0,0,0,,Hindi.
Dialogue: 0,0:39:10.47,0:39:12.92,Default,,0,0,0,,Kung gayon walang kwenta ang pagsagot.
Dialogue: 0,0:39:24.11,0:39:25.79,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:39:25.82,0:39:27.60,Default,,0,0,0,,Kailan ito nangyari?
Dialogue: 0,0:39:37.37,0:39:40.36,Default,,0,0,0,,Ano? Bakit hindi ito hugasan?
Dialogue: 0,0:39:46.92,0:39:49.50,Default,,0,0,0,,Inumin. Lalamigin ka.
Dialogue: 0,0:39:50.72,0:39:52.29,Default,,0,0,0,,Nasaan siya?
Dialogue: 0,0:39:52.39,0:39:53.57,Default,,0,0,0,,Mr. Baek?
Dialogue: 0,0:39:53.59,0:39:55.34,Default,,0,0,0,,Umakyat siya sa itaas.
Dialogue: 0,0:39:56.06,0:39:58.30,Default,,0,0,0,,- I see.\N- Wala ba siya sa kwarto?
Dialogue: 0,0:39:59.77,0:40:01.59,Default,,0,0,0,,Hindi.
Dialogue: 0,0:40:04.09,0:40:06.33,Default,,0,0,0,,Hiwalay ba kayong natutulog?
Dialogue: 0,0:40:10.36,0:40:11.55,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kamusta ang kasal nila?{\c}{\i0}
Dialogue: 0,0:40:11.57,0:40:13.72,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nakakatakot.{\c}{\i0}
Dialogue: 0,0:40:13.74,0:40:16.19,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hiwalay silang natutulog,{\c}{\i0}
Dialogue: 0,0:40:16.24,0:40:18.18,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero kakaiba.{\c}{\i0}
Dialogue: 0,0:40:18.20,0:40:22.56,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Halata naman na si Hyun-woo ay\Nsick at pagod sa kanyang in-laws,{\c}{\i0}
Dialogue: 0,0:40:22.58,0:40:24.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ngunit patuloy niyang sinasabi ang mga tamang bagay,{\c}{\i0}
Dialogue: 0,0:40:24.88,0:40:25.85,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at alam mo kung ano?{\c}{\i0}
Dialogue: 0,0:40:25.88,0:40:27.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Chairman Hong...{\c}{\i0}
Dialogue: 0,0:40:27.38,0:40:30.82,Default,,0,0,0,,{\i1}{\c&HFFFF00&}talagang nakikinig sa kanyang sasabihin.{\c}{\i0}
Dialogue: 0,0:40:30.84,0:40:34.07,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nagtatalo sina Hae-in at Hyun-woo\Nsa tuwing magkasama sila,{\c}{\i0}
Dialogue: 0,0:40:34.09,0:40:37.11,Default,,0,0,0,,{\i1}{\c&HFFFF00&}pero kakaiba, nakikinig din siya sa kanya.{\c}{\i0}
Dialogue: 0,0:40:37.14,0:40:41.59,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Kaya tinutulungan ni Hyun-woo\Nsila na mamulat?{\c}{\i0}
Dialogue: 0,0:40:41.81,0:40:43.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Eksakto.{\c}{\i0}
Dialogue: 0,0:40:44.23,0:40:47.12,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maaari siyang magdulot ng mga problema sa aming plano.{\c}{\i0}
Dialogue: 0,0:40:47.15,0:40:48.42,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mas maganda...{\c}{\i0}
Dialogue: 0,0:40:48.44,0:40:51.69,Default,,0,0,0,,{\i1}{\c&HFFFF00&}upang sipain siya palabas ng\Nhouse sa lalong madaling panahon.{\c}{\i0}
Dialogue: 0,0:40:52.20,0:40:53.95,Default,,0,0,0,,Okay lang ba kayo?
Dialogue: 0,0:40:55.16,0:40:56.22,Default,,0,0,0,,Ano?
Dialogue: 0,0:40:56.24,0:40:57.80,Default,,0,0,0,,Ito ay medyo hindi pangkaraniwan.
Dialogue: 0,0:40:57.83,0:41:02.56,Default,,0,0,0,,Maaabala ang asawa\Kung ang lalaking kaibigan ng kanyang asawa...
Dialogue: 0,0:41:02.58,0:41:04.68,Default,,0,0,0,,lumipat sa bahay nila.
Dialogue: 0,0:41:04.71,0:41:05.81,Default,,0,0,0,,Pero?
Dialogue: 0,0:41:05.83,0:41:07.60,Default,,0,0,0,,tanong ko sa kanya...
Dialogue: 0,0:41:07.63,0:41:10.83,Default,,0,0,0,,kung hindi siya kumportable sa pananatili ko dito,
Dialogue: 0,0:41:13.22,0:41:15.04,Default,,0,0,0,,at hindi niya pinansin.
Dialogue: 0,0:41:29.02,0:41:31.85,Default,,0,0,0,,Bakit siya lilipat ng hotel?
Dialogue: 0,0:41:31.98,0:41:35.31,Default,,0,0,0,,Ano ang iniisip ng biyenan ko?
Dialogue: 0,0:41:35.95,0:41:37.86,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Hae-in at Ako...{\c}{\i0}
Dialogue: 0,0:41:38.37,0:41:41.34,Default,,0,0,0,,{\i1}{\c&HFFFF00&}ay nagkaroon ng magandang relasyon sa nakaraan.{\c}{\i0}
Dialogue: 0,0:41:41.37,0:41:43.76,Default,,0,0,0,,Nagkaroon sila ng magandang relasyon.
Dialogue: 0,0:41:43.79,0:41:48.07,Default,,0,0,0,,Hindi siya dapat nandito.
Dialogue: 0,0:41:48.21,0:41:51.08,Default,,0,0,0,,Sus. Anong klaseng magandang relasyon?
Dialogue: 0,0:41:55.55,0:41:57.50,Default,,0,0,0,,Magmumukha ba akong kaawa-awa...
Dialogue: 0,0:41:59.18,0:42:01.30,Default,,0,0,0,,kung tatanungin ko siya ngayon?
Dialogue: 0,0:42:10.77,0:42:12.42,Default,,0,0,0,,Kaya lahat sila ay konektado dito.
Dialogue: 0,0:42:12.44,0:42:16.10,Default,,0,0,0,,Hindi pa namin ito isiniwalat sa media.
Dialogue: 0,0:42:16.74,0:42:18.88,Default,,0,0,0,,Maaaring magkahiwa-hiwalay ang ating mga bahay,
Dialogue: 0,0:42:18.91,0:42:22.05,Default,,0,0,0,,pero talagang lahat sila\Nkonektado sa basement.
Dialogue: 0,0:42:22.08,0:42:24.51,Default,,0,0,0,,Sadyang\Ndinisenyo ito ng aming lolo.
Dialogue: 0,0:42:24.54,0:42:25.76,Default,,0,0,0,,Nakikita ko,
Dialogue: 0,0:42:25.79,0:42:28.60,Default,,0,0,0,,para may access ka sa lahat ng bahay dito.
Dialogue: 0,0:42:28.62,0:42:30.64,Default,,0,0,0,,Oo, at mayroon din kaming kwartong iyon.
Dialogue: 0,0:42:30.67,0:42:32.93,Default,,0,0,0,,Alam mo ba ang pelikulang may\Nsecret room, "Shock Room"?
Dialogue: 0,0:42:32.95,0:42:34.65,Default,,0,0,0,,Ito ay "Panic Room," ang tanga mo.
Dialogue: 0,0:42:34.67,0:42:36.87,Default,,0,0,0,,- Alam ko.\N- Pagkatapos ay ayusin mo.
Dialogue: 0,0:42:39.97,0:42:42.24,Default,,0,0,0,,Huwag kang masyadong malupit sa kanya.
Dialogue: 0,0:42:42.26,0:42:45.74,Default,,0,0,0,,Ibaba nila ang mga hapunan natin\Ndito, kaya sabay tayong kumain.
Dialogue: 0,0:42:45.77,0:42:48.39,Default,,0,0,0,,Makakain na kayo. magpapahinga na ako.
Dialogue: 0,0:42:51.81,0:42:55.17,Default,,0,0,0,,Bakit? Napakasarap mong kumain sa iyong mga biyenan,
Dialogue: 0,0:42:55.19,0:42:56.80,Default,,0,0,0,,na bihira mong makilala.
Dialogue: 0,0:42:56.82,0:43:00.59,Default,,0,0,0,,Kumain ka ng lahat at ngumiti hanggang tainga.
Dialogue: 0,0:43:00.61,0:43:02.88,Default,,0,0,0,,Alam mo naging viral ang video na yan, di ba?
Dialogue: 0,0:43:02.91,0:43:06.51,Default,,0,0,0,,Nagsumikap ang aming PR team ngayon para harapin iyon.
Dialogue: 0,0:43:06.54,0:43:09.36,Default,,0,0,0,,Bakit ka ba nagagalit?
Dialogue: 0,0:43:09.58,0:43:10.68,Default,,0,0,0,,Dahil binisita ko sila?
Dialogue: 0,0:43:10.71,0:43:13.06,Default,,0,0,0,,Kasi kinain ko lahat at ngumiti ng sobra?
Dialogue: 0,0:43:13.09,0:43:14.31,Default,,0,0,0,,O...
Dialogue: 0,0:43:14.34,0:43:15.36,Default,,0,0,0,,video ba ito?
Dialogue: 0,0:43:15.38,0:43:18.08,Default,,0,0,0,,Dahil kinailangang takpan ako ng PR team?
Dialogue: 0,0:43:18.97,0:43:20.55,Default,,0,0,0,,Hindi ako nagagalit.
Dialogue: 0,0:43:20.58,0:43:21.61,Default,,0,0,0,,Oo naman.
Dialogue: 0,0:43:21.64,0:43:22.78,Default,,0,0,0,,Nabighani lang ako.
Dialogue: 0,0:43:22.80,0:43:24.42,Default,,0,0,0,,Sa ano?
Dialogue: 0,0:43:24.64,0:43:27.59,Default,,0,0,0,,Bihira kitang makitang ngumiti ng ganyan.
Dialogue: 0,0:43:28.56,0:43:31.47,Default,,0,0,0,,Bihira din kitang makitang ngumiti sa akin.
Dialogue: 0,0:43:33.98,0:43:37.73,Default,,0,0,0,,Wala na tayong dapat ngitian, di ba?
Dialogue: 0,0:43:37.78,0:43:39.21,Default,,0,0,0,,Eksakto,
Dialogue: 0,0:43:39.24,0:43:41.10,Default,,0,0,0,,kaya kumain ng wala ako.
Dialogue: 0,0:43:42.11,0:43:44.36,Default,,0,0,0,,Magkaroon ng magandang oras.
Dialogue: 0,0:43:56.75,0:43:58.91,Default,,0,0,0,,Siguro nagulat ka.
Dialogue: 0,0:43:59.80,0:44:02.00,Default,,0,0,0,,Humihingi ako ng paumanhin sa ngalan niya.
Dialogue: 0,0:44:02.34,0:44:04.04,Default,,0,0,0,,Okay lang yan.
Dialogue: 0,0:44:06.72,0:44:08.45,Default,,0,0,0,,Ito ay isang regular na bagay.
Dialogue: 0,0:44:08.47,0:44:10.95,Default,,0,0,0,,Nakikita mo ba kung gaano ako nahihirapan dito?
Dialogue: 0,0:44:10.98,0:44:13.01,Default,,0,0,0,,Tama.
Dialogue: 0,0:44:13.19,0:44:16.18,Default,,0,0,0,,Pero naiintindihan ko si Hae-in.
Dialogue: 0,0:44:16.86,0:44:20.67,Default,,0,0,0,,Sigurado akong alam mo na,\Npero grabe ang ugali niya.
Dialogue: 0,0:44:20.69,0:44:26.07,Default,,0,0,0,,Sigurado akong may papel ang insecurities niya\Ntoward me.
Dialogue: 0,0:44:27.20,0:44:29.68,Default,,0,0,0,,Hindi ko akalain na ganoon ang nararamdaman niya.
Dialogue: 0,0:44:29.70,0:44:34.78,Default,,0,0,0,,Wala siyang ideya na pinapabilis ko ang sarili ko para sa kanya.
Dialogue: 0,0:44:38.00,0:44:41.21,Default,,0,0,0,,Hindi ko alam na pinapabilis mo ang iyong sarili.
Dialogue: 0,0:44:41.30,0:44:45.54,Default,,0,0,0,,Hindi madaling umupo sa Queens'\Nthrone. Maraming dapat gawin.
Dialogue: 0,0:44:46.14,0:44:48.88,Default,,0,0,0,,Hindi mo ba nakikita kung ano ang nasa balikat ko?
Dialogue: 0,0:44:50.10,0:44:52.93,Default,,0,0,0,,Mga pasanin at responsibilidad.
Dialogue: 0,0:44:53.56,0:44:56.76,Default,,0,0,0,,Sila ang dahilan kung bakit mas maikli ako ng apat na pulgada.
Dialogue: 0,0:44:57.27,0:45:00.73,Default,,0,0,0,,Parehong binibigat ako ng kapalaran ko at ni Hae-in.
Dialogue: 0,0:45:01.32,0:45:03.35,Default,,0,0,0,,Binabigatan ka ni Hae-in?
Dialogue: 0,0:45:03.61,0:45:05.97,Default,,0,0,0,,Sinutok niya ako kamakailan sa tiyan,
Dialogue: 0,0:45:05.99,0:45:08.26,Default,,0,0,0,,at hindi ako makahinga ng ilang minuto.
Dialogue: 0,0:45:08.28,0:45:12.06,Default,,0,0,0,,Nabigla ang nanay ko, at labis silang nagtalo,
Dialogue: 0,0:45:12.08,0:45:15.49,Default,,0,0,0,,kaya may binisita ang nanay ko.
Dialogue: 0,0:45:15.92,0:45:17.62,Default,,0,0,0,,Sino?
Dialogue: 0,0:45:18.13,0:45:21.40,Default,,0,0,0,,Alam niya kung sino ang magiging Presidente\Nand kahit na hinulaan ang COVID-19.
Dialogue: 0,0:45:21.42,0:45:24.40,Default,,0,0,0,,Binalaan din niya ang aking\Ngrandfather na huwag manghuli.
Dialogue: 0,0:45:24.43,0:45:26.24,Default,,0,0,0,,Tama, ang dakilang shaman.
Dialogue: 0,0:45:26.26,0:45:27.24,Default,,0,0,0,,Oo, siya.
Dialogue: 0,0:45:27.26,0:45:32.30,Default,,0,0,0,,Nagbayad siya sa kanya ng malaking halaga, at nakuha niya ito.
Dialogue: 0,0:45:36.40,0:45:38.00,Default,,0,0,0,,Isang anting-anting?
Dialogue: 0,0:45:38.02,0:45:40.68,Default,,0,0,0,,{\an8}Mapapanatili akong ligtas nito.
Dialogue: 0,0:45:41.44,0:45:43.29,Default,,0,0,0,,Sabi ng shaman...
Dialogue: 0,0:45:43.32,0:45:47.30,Default,,0,0,0,,makakatulong ito sa akin na mapasuko si Hae-in,\Nupang maibuka ko ang aking mga pakpak at lumipad.
Dialogue: 0,0:45:47.32,0:45:48.80,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:45:48.82,0:45:52.10,Default,,0,0,0,,Sus, hindi ako naniniwala sa kanya.\NIto ay pamahiin,
Dialogue: 0,0:45:52.12,0:45:55.72,Default,,0,0,0,,pero tinitingnan ng nanay ko kung ilalagay ko ito sa akin.
Dialogue: 0,0:45:55.75,0:45:57.31,Default,,0,0,0,,Sa tingin ko, hindi ito gumagana.
Dialogue: 0,0:45:57.33,0:46:00.58,Default,,0,0,0,,Malakas pa rin si Hae-in.
Dialogue: 0,0:46:01.09,0:46:03.98,Default,,0,0,0,,{\i1}Ang paggamot na iminungkahi ng German lab...{\i0}
Dialogue: 0,0:46:04.01,0:46:05.32,Default,,0,0,0,,{\i1}gumagamit ng CAR-T cells...{\i0}
Dialogue: 0,0:46:05.34,0:46:08.36,Default,,0,0,0,,{\i1}upang gamutin ang mga immune cell.{\i0}
Dialogue: 0,0:46:08.39,0:46:11.26,Default,,0,0,0,,{\i1}Ito ay isang uri ng paggamot sa kanser\Nkung saan kinukuha nila ang mga immune cell...{\i0}
Dialogue: 0,0:46:11.28,0:46:15.12,Default,,0,0,0,,{\i1}mula sa iyong dugo, ibahin sila sa\NCAR-T cells na may kakayahan...{\i0}
Dialogue: 0,0:46:15.14,0:46:18.12,Default,,0,0,0,,{\i1}upang alisin ang mga tumor cell, at\Ninject ang mga ito pabalik sa iyong katawan.{\i0}
Dialogue: 0,0:46:18.15,0:46:20.67,Default,,0,0,0,,{\i1}Ang paggamot na ito ay madalas\Nnapatunayang epektibo...{\i0}
Dialogue: 0,0:46:20.69,0:46:22.75,Default,,0,0,0,,{\i1}para sa mga may leukemia,{\i0}
Dialogue: 0,0:46:22.77,0:46:26.02,Default,,0,0,0,,ngunit hindi pa sa mga tumor sa utak.
Dialogue: 0,0:46:27.36,0:46:29.13,Default,,0,0,0,,Pero...
Dialogue: 0,0:46:29.16,0:46:32.14,Default,,0,0,0,,sabi nila na ang success rate ay lampas 50%.
Dialogue: 0,0:46:32.16,0:46:35.81,Default,,0,0,0,,Naniniwala ako na ibinigay nila sa iyo ang\Nfigure pagkatapos makakita ng magagandang hula...
Dialogue: 0,0:46:35.83,0:46:38.18,Default,,0,0,0,,sa mga pasyenteng may tumor sa utak...
Dialogue: 0,0:46:38.21,0:46:42.15,Default,,0,0,0,,na binigyan ng paggamot na ito sa mga nakaraang taon,
Dialogue: 0,0:46:42.17,0:46:45.02,Default,,0,0,0,,ngunit hindi mo dapat ituring iyon bilang isang ganap na paggaling.
Dialogue: 0,0:46:45.05,0:46:47.00,Default,,0,0,0,,Gagawin ko.
Dialogue: 0,0:46:47.05,0:46:49.29,Default,,0,0,0,,Maraming beses ko nang sinabi sa iyo.
Dialogue: 0,0:46:49.55,0:46:51.57,Default,,0,0,0,,Hahanap ako ng paraan.
Dialogue: 0,0:46:51.60,0:46:54.21,Default,,0,0,0,,Kahit kailangan kong hanapin ang mundo,
Dialogue: 0,0:46:54.26,0:46:56.42,Default,,0,0,0,,Hahanap ako ng paraan para mabuhay,
Dialogue: 0,0:46:56.93,0:46:59.14,Default,,0,0,0,,kaya huwag mong sabihin sa akin...
Dialogue: 0,0:47:02.44,0:47:04.52,Default,,0,0,0,,hindi ito gagana.
Dialogue: 0,0:47:14.41,0:47:16.39,Default,,0,0,0,,{\i1}Nasa incubator ang kanilang sanggol.{\i0}
Dialogue: 0,0:47:16.41,0:47:18.45,Default,,0,0,0,,{\i1}Masama ang pakiramdam ko, kaya...{\i0}
Dialogue: 0,0:47:29.97,0:47:31.83,Default,,0,0,0,,Kumusta ang iyong sanggol?
Dialogue: 0,0:47:32.93,0:47:33.99,Default,,0,0,0,,Hello, ma'am.
Dialogue: 0,0:47:34.01,0:47:35.70,Default,,0,0,0,,Ano ang magdadala sa iyo sa ospital?
Dialogue: 0,0:47:35.72,0:47:37.20,Default,,0,0,0,,Nasa incubator pa ba?
Dialogue: 0,0:47:37.22,0:47:39.54,Default,,0,0,0,,Hindi, hindi na,
Dialogue: 0,0:47:39.56,0:47:42.12,Default,,0,0,0,,- pero nasa ICU ang baby namin.\N- Ano ang pangalan ng baby?
Dialogue: 0,0:47:42.15,0:47:45.47,Default,,0,0,0,,Hindi namin nairehistro ang kapanganakan,
Dialogue: 0,0:47:46.11,0:47:48.27,Default,,0,0,0,,pero Cho-rong ang palayaw.
Dialogue: 0,0:47:50.86,0:47:53.93,Default,,0,0,0,,Umiinom ako ng vegetable juice tuwing umaga,
Dialogue: 0,0:47:53.95,0:47:56.97,Default,,0,0,0,,pero busy ako lately,\Nkaya nakakalimutan ko.
Dialogue: 0,0:47:56.99,0:47:58.39,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:47:58.41,0:48:01.43,Default,,0,0,0,,Gusto kong mag-order ng juice mula sa iyo nang regular.
Dialogue: 0,0:48:01.46,0:48:03.24,Default,,0,0,0,,Salamat, ma'am.
Dialogue: 0,0:48:03.54,0:48:06.10,Default,,0,0,0,,Ihahatid kita ng isa, simula bukas...
Dialogue: 0,0:48:06.13,0:48:09.40,Default,,0,0,0,,Murang mura kung mayroon ako\Nng aking sarili, kaya magdala pa ng ilan.
Dialogue: 0,0:48:09.42,0:48:11.40,Default,,0,0,0,,Yes, ma'am. Ilan pa ang gusto mo?
Dialogue: 0,0:48:11.43,0:48:12.82,Default,,0,0,0,,Well...
Dialogue: 0,0:48:12.84,0:48:16.38,Default,,0,0,0,,Kung lahat ng empleyado ko ay\Nkukuha ng isa, mga 250.
Dialogue: 0,0:48:16.72,0:48:18.42,Default,,0,0,0,,Paumanhin?
Dialogue: 0,0:48:20.27,0:48:22.34,Default,,0,0,0,,Salamat, ma'am!
Dialogue: 0,0:48:22.94,0:48:24.97,Default,,0,0,0,,Salamat!
Dialogue: 0,0:48:26.52,0:48:29.09,Default,,0,0,0,,Sir, ito ang blueprint\NI na sinasabi sa iyo.
Dialogue: 0,0:48:29.11,0:48:33.30,Default,,0,0,0,,Ito ang kumplikadong resort na magiging\Nang palasyo ng ating Queens empire.
Dialogue: 0,0:48:33.32,0:48:36.72,Default,,0,0,0,,Kabilang dito ang dalawang five-star hotel,\Nduty-free na mga tindahan, casino para sa mga dayuhan,
Dialogue: 0,0:48:36.74,0:48:39.35,Default,,0,0,0,,isang arena, convention center,\Na family water park...
Dialogue: 0,0:48:39.37,0:48:41.65,Default,,0,0,0,,At magkano ang magagastos?
Dialogue: 0,0:48:41.96,0:48:43.87,Default,,0,0,0,,Isang bilyon...
Dialogue: 0,0:48:46.67,0:48:49.66,Default,,0,0,0,,- at 700 hanggang 900 million dollars.\N- Gawin mo...
Dialogue: 0,0:48:50.84,0:48:52.11,Default,,0,0,0,,Gamit ang iyong pera.
Dialogue: 0,0:48:52.13,0:48:54.19,Default,,0,0,0,,Lolo, hindi ko hinihingi ang pera mo.
Dialogue: 0,0:48:54.22,0:48:57.70,Default,,0,0,0,,Kailangan lang naming mag-secure ng site,\Mamumuhunan si Nand Eun-sung sa amin.
Dialogue: 0,0:48:57.72,0:48:58.82,Default,,0,0,0,,Sino?
Dialogue: 0,0:48:58.85,0:49:00.16,Default,,0,0,0,,Mr. Yoon Eun-sung.
Dialogue: 0,0:49:00.18,0:49:03.05,Default,,0,0,0,,Medyo naging close kami simula nung lumipat siya.
Dialogue: 0,0:49:03.19,0:49:05.33,Default,,0,0,0,,Sinasabi mo bang pumayag siya dito?
Dialogue: 0,0:49:05.35,0:49:08.83,Default,,0,0,0,,We're still in the early\Nstages, but you can say so.
Dialogue: 0,0:49:08.86,0:49:10.67,Default,,0,0,0,,Nahihiya akong sabihin ito,
Dialogue: 0,0:49:10.69,0:49:12.81,Default,,0,0,0,,pero head-over-heels siya para sa akin.
Dialogue: 0,0:49:12.94,0:49:14.60,Default,,0,0,0,,Hindi siya kasing cold-hearted gaya ng iniisip ko.
Dialogue: 0,0:49:14.62,0:49:17.13,Default,,0,0,0,,Sobrang mapagmahal\Nonce you grow on him.
Dialogue: 0,0:49:17.16,0:49:18.13,Default,,0,0,0,,Totoo ba iyon?
Dialogue: 0,0:49:18.16,0:49:20.14,Default,,0,0,0,, Siguradong nagustuhan ka niya.
Dialogue: 0,0:49:20.16,0:49:21.55,Default,,0,0,0,,Higit pa riyan.
Dialogue: 0,0:49:21.58,0:49:26.91,Default,,0,0,0,,Sabik siyang makinig sa gusto kong gawin.
Dialogue: 0,0:49:27.29,0:49:28.99,Default,,0,0,0,,Siya ba?
Dialogue: 0,0:49:29.13,0:49:32.52,Default,,0,0,0,,Pare, ang pondo ni Mr. Yoon ay nanggaling\Nmula sa perang langis ng Middle Eastern,
Dialogue: 0,0:49:32.55,0:49:34.19,Default,,0,0,0,,kaya maaasahan siya.
Dialogue: 0,0:49:34.22,0:49:35.23,Default,,0,0,0,,Totoo ba iyon?
Dialogue: 0,0:49:35.26,0:49:36.78,Default,,0,0,0,,- Kung ganoon...\N- Tahan na.
Dialogue: 0,0:49:36.80,0:49:39.36,Default,,0,0,0,,Sa tingin ko dapat muna tayong gumawa ng\Nsite validity check.
Dialogue: 0,0:49:39.39,0:49:42.95,Default,,0,0,0,,{\an8}Marami na kaming feasibility\Npag-aaral na ginawa sa aming mga site noong nakaraan.
Dialogue: 0,0:49:42.97,0:49:45.58,Default,,0,0,0,,{\an8}Gayunpaman, wala ni isa sa kanila ang naayos dahil sa ilang mga panganib.
Dialogue: 0,0:49:45.60,0:49:48.50,Default,,0,0,0,,Kailangan namin ng mga lisensya ng gobyerno\Npara sa mga duty-free na tindahan at casino.
Dialogue: 0,0:49:48.52,0:49:50.17,Default,,0,0,0,,Tungkol sa paglilisensya...
Dialogue: 0,0:49:50.19,0:49:53.50,Default,,0,0,0,,Alam mo na mayroon tayong tao\Nin ang Ministry of Land.
Dialogue: 0,0:49:53.53,0:49:57.61,Default,,0,0,0,,Maaari natin siyang pagkatiwalaan dahil natanggap niya ang ating mga scholarship.
Dialogue: 0,0:49:57.72,0:49:59.65,Default,,0,0,0,,Ngunit maaaring magbago ang mga tao.
Dialogue: 0,0:49:59.99,0:50:04.32,Default,,0,0,0,,Mapanganib na umasa sa kanya, at\Nmagsimula ng negosyong nagkakahalaga ng $1.9 bilyon.
Dialogue: 0,0:50:07.33,0:50:11.29,Default,,0,0,0,,Iyan ay isang patas na punto, hindi ba?
Dialogue: 0,0:50:11.71,0:50:14.69,Default,,0,0,0,,Oo, Ama. Alam niya kung ano ang mahalaga.
Dialogue: 0,0:50:14.72,0:50:16.42,Default,,0,0,0,,Ama?
Dialogue: 0,0:50:16.68,0:50:19.50,Default,,0,0,0,,Suriin muna ang mga panganib.
Dialogue: 0,0:50:21.97,0:50:25.63,Default,,0,0,0,,Walang masama sa pagre-review, Soo-cheol.
Dialogue: 0,0:50:33.82,0:50:35.52,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,0:50:35.61,0:50:37.27,Default,,0,0,0,,Hello, sir.
Dialogue: 0,0:50:43.49,0:50:47.16,Default,,0,0,0,,Sinabi mo sa akin na tumawag kung may naaalala ako.
Dialogue: 0,0:50:47.71,0:50:50.60,Default,,0,0,0,,May dumating na tagahatid ng gas noong araw na iyon.
Dialogue: 0,0:50:50.63,0:50:52.87,Default,,0,0,0,,Ang dashcam?
Dialogue: 0,0:50:53.00,0:50:56.02,Default,,0,0,0,,Oo, meron siya.
Dialogue: 0,0:50:56.05,0:50:57.98,Default,,0,0,0,,Natanggap ko ito,
Dialogue: 0,0:50:58.01,0:51:01.90,Default,,0,0,0,,pero maliit ang memory size nito,\Nso ang footage mula sa araw na iyon ay nawala.
Dialogue: 0,0:51:01.93,0:51:04.62,Default,,0,0,0,,Okay lang. Susubukan kong ibalik ito.
Dialogue: 0,0:51:04.64,0:51:08.22,Default,,0,0,0,,Magpapadala ako ng deliveryman para kunin ito.
Dialogue: 0,0:51:08.52,0:51:10.22,Default,,0,0,0,,Salamat.
Dialogue: 0,0:51:11.31,0:51:12.46,Default,,0,0,0,,Ito ay mula sa isang dashcam.
Dialogue: 0,0:51:12.48,0:51:14.71,Default,,0,0,0,,Na-delete na ang lumang footage.
Dialogue: 0,0:51:14.73,0:51:16.29,Default,,0,0,0,,Gaano katagal ang pag-restore?
Dialogue: 0,0:51:16.32,0:51:18.67,Default,,0,0,0,,Well, sasabihin ko kahit tatlo hanggang apat na araw,
Dialogue: 0,0:51:18.70,0:51:19.76,Default,,0,0,0,,ngunit walang mga garantiya.
Dialogue: 0,0:51:19.78,0:51:22.55,Default,,0,0,0,,Ito ay mahalagang footage,\Nkaya paki-restore ito ng maayos.
Dialogue: 0,0:51:22.57,0:51:24.28,Default,,0,0,0,,Okay.
Dialogue: 0,0:51:24.70,0:51:28.26,Default,,0,0,0,,Doktor, naging interesado ang ating chairman\Nin kamote nitong nakaraang linggo,
Dialogue: 0,0:51:28.29,0:51:30.68,Default,,0,0,0,,dahil iyon ang paboritong pagkain ni Lessie Brown...
Dialogue: 0,0:51:30.71,0:51:32.14, Default,,0,0,0,,hanggang sa kanyang kamatayan sa 114.
Dialogue: 0,0:51:32.17,0:51:36.27,Default,,0,0,0,,Nabalitaan kong interesado siya sa\Nberries noong nakaraang linggo, dahil sila ay...
Dialogue: 0,0:51:36.30,0:51:38.73,Default,,0,0,0,,Paborito\Npagkain ni Christina Wahara hanggang sa kanyang kamatayan sa 102.
Dialogue: 0,0:51:38.76,0:51:40.50,Default,,0,0,0,,Tama.
Dialogue: 0,0:51:40.80,0:51:46.16,Default,,0,0,0,,Ngunit dahil nabuhay si Brown ng 12\Ntaon na mas mahaba kaysa kay Wahara...
Dialogue: 0,0:51:46.18,0:51:49.08,Default,,0,0,0,,Tapos pinatuyong kamote? Mahilig siya sa matamis na pagkain.
Dialogue: 0,0:51:49.10,0:51:52.08,Default,,0,0,0,,Hindi, mataas ang blood sugar niya.\Ndapat mong pakuluan ang mga ito.
Dialogue: 0,0:51:52.10,0:51:53.41,Default,,0,0,0,,Hindi niya magugustuhan yun.
Dialogue: 0,0:51:53.44,0:51:54.42,Default,,0,0,0,,Hindi ito maaaring makatulong.
Dialogue: 0,0:51:54.44,0:51:59.88,Default,,0,0,0,,Pakihain sa kanya ang dibdib ng manok,\Nbeans, at puti ng itlog sa ngayon.
Dialogue: 0,0:51:59.90,0:52:01.69,Default,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:52:02.20,0:52:05.07,Default,,0,0,0,,Mga puti ng itlog, dibdib ng manok,
Dialogue: 0,0:52:05.28,0:52:06.68,Default,,0,0,0,,at beans? Halika na.
Dialogue: 0,0:52:06.70,0:52:09.47,Default,,0,0,0,,Ngumunguya siya ng tadyang sa tuwing naiinis siya.
Dialogue: 0,0:52:09.50,0:52:10.68,Default,,0,0,0,,Maaari din siyang mamatay.
Dialogue: 0,0:52:10.71,0:52:12.02,Default,,0,0,0,,Panoorin kung ano ang iyong sasabihin.
Dialogue: 0,0:52:12.04,0:52:13.10,Default,,0,0,0,,Ano ang iyong departamento?
Dialogue: 0,0:52:13.12,0:52:15.27,Default,,0,0,0,,- Family medicine, ma'am.\N- Mr. Jang.
Dialogue: 0,0:52:15.29,0:52:18.56,Default,,0,0,0,,Dapat nandito rin ang psychiatrist ng tatay ko,
Dialogue: 0,0:52:18.59,0:52:20.94,Default,,0,0,0,,para maisaalang-alang niya ang kanyang mental\Nstate.
Dialogue: 0,0:52:20.97,0:52:22.82,Default,,0,0,0,,Yes, ma'am.
Dialogue: 0,0:52:22.84,0:52:24.50,Default,,0,0,0,,Gayundin...
Dialogue: 0,0:52:28.60,0:52:30.88,Default,,0,0,0,,Hindi kita mapagkakatiwalaan...
Dialogue: 0,0:52:31.27,0:52:34.41,Default,,0,0,0,,kasama ang paghahanda ng mga pagkain ng aking ama.
Dialogue: 0,0:52:34.44,0:52:36.29,Default,,0,0,0,,Narinig kong ikaw mismo ang gumagawa ng mga pampalasa.
Dialogue: 0,0:52:36.31,0:52:40.59,Default,,0,0,0,,Soy sauce lang ang gusto niya.
Dialogue: 0,0:52:40.61,0:52:43.40,Default,,0,0,0,,Eksakto. Sino ang nakakaalam kung ano ang iyong inilagay sa loob?
Dialogue: 0,0:52:44.36,0:52:49.55,Default,,0,0,0,,Gusto kong subukan mo lahat ng pagkain niya sa\Nharap ko bago ihain sa kanya.
Dialogue: 0,0:52:49.58,0:52:51.43,Default,,0,0,0,,Tulad ng ginawa ng mga court ladies.
Dialogue: 0,0:52:51.45,0:52:54.24,Default,,0,0,0,,Hindi, ikaw ang magiging concubine niya.
Dialogue: 0,0:52:57.59,0:52:59.23,Default,,0,0,0,,Iyan na lang para sa araw na ito.
Dialogue: 0,0:52:59.25,0:53:01.46,Default,,0,0,0,,Maaari kang pumunta.
Dialogue: 0,0:53:04.09,0:53:05.36,Default,,0,0,0,,Ano ang gagawin natin?
Dialogue: 0,0:53:05.39,0:53:08.32,Default,,0,0,0,,Paano kung sinaktan ulit siya ni Beom-ja?
Dialogue: 0,0:53:08.35,0:53:11.51,Default,,0,0,0,,Dapat ko bang hintayin at tratuhin siya pagkatapos?
Dialogue: 0,0:53:13.52,0:53:14.91,Default,,0,0,0,,Bakit mo ito ni-lock?
Dialogue: 0,0:53:14.94,0:53:17.31,Default,,0,0,0,,Nagbabalak na magmakaawa sa akin o ano?
Dialogue: 0,0:53:18.44,0:53:20.47,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:53:28.70,0:53:30.53,Default,,0,0,0,,Ano iyon?
Dialogue: 0,0:53:32.00,0:53:33.10,Default,,0,0,0,,Beom-ja.
Dialogue: 0,0:53:33.12,0:53:34.18,Default,,0,0,0,,"Beom-ja"?
Dialogue: 0,0:53:34.21,0:53:37.18,Default,,0,0,0,,Naging bastos ka sa\Nakin sa nakalipas na 20 taon,
Dialogue: 0,0:53:37.21,0:53:38.56,Default,,0,0,0,,at patuloy na gagawin iyon.
Dialogue: 0,0:53:38.59,0:53:41.62,Default,,0,0,0,,Pero hulaan mo? Hindi na ako nagpapacute.
Dialogue: 0,0:53:42.21,0:53:44.78,Default,,0,0,0,,Nababaliw ka na ba? How dare\Nyou na kausapin ako ng ganyan?
Dialogue: 0,0:53:44.80,0:53:48.71,Default,,0,0,0,,"Cute"? Gusto mo pa ba ng mga slipped disc?
Dialogue: 0,0:53:50.18,0:53:52.91,Default,,0,0,0,,Teka! Masakit yun!
Dialogue: 0,0:53:52.93,0:53:56.55,Default,,0,0,0,,Nagbibilang ako ng tatlo. Isa, dalawa, tatlo!
Dialogue: 0,0:54:02.78,0:54:04.09,Default,,0,0,0,,Ikuyom ang iyong panga,
Dialogue: 0,0:54:04.11,0:54:06.44,Default,,0,0,0,,- Bakit?\N- ...o kakagatin mo ang dila mo.
Dialogue: 0,0:54:13.95,0:54:16.18,Default,,0,0,0,,Natamaan ako ng babaeng yun!
Dialogue: 0,0:54:16.21,0:54:18.18,Default,,0,0,0,,Sa tiyan ko! ganito!
Dialogue: 0,0:54:18.21,0:54:19.85,Default,,0,0,0,,Darn it.
Dialogue: 0,0:54:19.88,0:54:21.23,Default,,0,0,0,,I'll bet you hit her.
Dialogue: 0,0:54:21.25,0:54:23.40,Default,,0,0,0,,Hindi, hindi ko ginawa!
Dialogue: 0,0:54:23.42,0:54:25.48,Default,,0,0,0,,Sinaktan ko siya.
Dialogue: 0,0:54:25.51,0:54:29.63,Default,,0,0,0,,Natamaan ko siya sa galit.
Dialogue: 0,0:54:30.10,0:54:33.26,Default,,0,0,0,,- Sorry.\N- See? Narinig mo siya!
Dialogue: 0,0:54:35.48,0:54:38.12,Default,,0,0,0,,Sa tingin mo ba maniniwala ako sa kanya?
Dialogue: 0,0:54:38.14,0:54:39.12,Default,,0,0,0,,Bakit hindi?
Dialogue: 0,0:54:39.15,0:54:42.22,Default,,0,0,0,,Maaaring hindi ka naniniwala sa akin, ngunit naniniwala ka sa kanya.
Dialogue: 0,0:54:53.45,0:54:56.15,Default,,0,0,0,,Maniwala ka sa kanya!
Dialogue: 0,0:54:59.83,0:55:03.06,Default,,0,0,0,,Isang regular na decaf na may dagdag na shot. Tama?
Dialogue: 0,0:55:03.09,0:55:06.65,Default,,0,0,0,,- Hindi mo nakalimutan.\N- Syempre hindi. Ikaw ang aming tagapagligtas.
Dialogue: 0,0:55:06.67,0:55:10.03,Default,,0,0,0,,We're nothing but thugs 15 years ago,
Dialogue: 0,0:55:10.05,0:55:11.49,Default,,0,0,0,,pero mabilis kaming naging...
Dialogue: 0,0:55:11.51,0:55:13.78,Default,,0,0,0,,top-secret-affair na mga propesyonal, salamat sa inyo.
Dialogue: 0,0:55:13.81,0:55:15.41,Default,,0,0,0,,Tama ka.
Dialogue: 0,0:55:15.43,0:55:17.16,Default,,0,0,0,,Nakita ko kung paano lumaki ang opisina mo...
Dialogue: 0,0:55:17.18,0:55:18.83,Default,,0,0,0,,{\i1}{\c&HFFFF&}MZ Detective Agency{\c}{\i0}
Dialogue: 0,0:55:18.85,0:55:20.20,Default,,0,0,0,,...sa tuwing makikipagdivorce ako.
Dialogue: 0,0:55:20.23,0:55:24.56,Default,,0,0,0,,Hindi na kami simpleng detective\Nagency. Kami ay lisensyado at kahit na nagbabayad ng buwis.
Dialogue: 0,0:55:25.11,0:55:26.54,Default,,0,0,0,,Alam ko.
Dialogue: 0,0:55:26.57,0:55:28.71,Default,,0,0,0,,Nagbago ang sign mo, kaya\NI halos hindi ka mahanap,
Dialogue: 0,0:55:28.74,0:55:30.21,Default,,0,0,0,,so ano ka na ngayon?
Dialogue: 0,0:55:30.24,0:55:33.18,Default,,0,0,0,,Kami ay isang PIA na pumasa...
Dialogue: 0,0:55:33.20,0:55:35.18,Default,,0,0,0,,ang pagsubok na sertipikado ng estado.
Dialogue: 0,0:55:35.20,0:55:37.47,Default,,0,0,0,,Isang opisina ng pribadong imbestigasyon.
Dialogue: 0,0:55:37.50,0:55:38.81,Default,,0,0,0,,Kung gayon ano ang itatawag ko sa iyo?
Dialogue: 0,0:55:38.83,0:55:40.31,Default,,0,0,0,,Pwede ba kitang tawaging "Mr. Park"?
Dialogue: 0,0:55:40.33,0:55:42.62,Default,,0,0,0,,Tawagan mo akong "Conan." Conan Park.
Dialogue: 0,0:55:45.46,0:55:47.16,Default,,0,0,0,,Conan, ito ay.
Dialogue: 0,0:55:48.88,0:55:51.29,Default,,0,0,0,,Gumawa ng background check sa kanya.
Dialogue: 0,0:55:54.26,0:55:56.99,Default,,0,0,0,,Aling kategorya ito?
Dialogue: 0,0:55:57.02,0:56:00.62,Default,,0,0,0,,Naiiba ang paraan ng pagsisiyasat\Ndepende sa gusto mong hanapin.
Dialogue: 0,0:56:00.64,0:56:02.22,Default,,0,0,0,,Lahat.
Dialogue: 0,0:56:02.73,0:56:07.14,Default,,0,0,0,,Gusto kong malaman ang lahat tungkol sa kanya.
Dialogue: 0,0:56:07.65,0:56:10.94,Default,,0,0,0,,{\an8}Kainis lang ako sa kanya sa nakalipas na 20 taon.
Dialogue: 0,0:56:11.24,0:56:14.48,Default,,0,0,0,,Sa wakas natauhan na ako pagkatapos niya akong hampasin.
Dialogue: 0,0:56:14.53,0:56:16.61,Default,,0,0,0,,Kailangan kong malaman...
Dialogue: 0,0:56:16.70,0:56:18.32,Default,,0,0,0,,sino siya.
Dialogue: 0,0:56:20.16,0:56:22.66,Default,,0,0,0,,Darn it.
Dialogue: 0,0:56:33.13,0:56:35.39,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Yoon Eun-sung{\c}{\i0}
Dialogue: 0,0:56:36.93,0:56:38.24,Default,,0,0,0,,{\i1}Handa ka na ba?{\i0}
Dialogue: 0,0:56:38.26,0:56:40.49,Default,,0,0,0,,{\i1}Ang due-diligence ni Hercyna\Nteam ay narito sa lima.{\i0}
Dialogue: 0,0:56:40.52,0:56:43.20,Default,,0,0,0,,Oo, nandoon na ang mga tao ko.
Dialogue: 0,0:56:43.23,0:56:45.05,Default,,0,0,0,,Aalis na ako.
Dialogue: 0,0:57:56.51,0:57:58.84,Default,,0,0,0,,Hinihintay kita.
Dialogue: 0,0:57:59.51,0:58:00.70,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,0:58:00.72,0:58:02.51,Default,,0,0,0,,Oo, ayos lang ako.
Dialogue: 0,0:58:05.35,0:58:07.09,Default,,0,0,0,,Huli na tayo.
Dialogue: 0,0:58:08.10,0:58:10.42,Default,,0,0,0,,Paumanhin, naghihintay sila.
Dialogue: 0,0:58:10.44,0:58:13.25,Default,,0,0,0,,Hindi ka maganda. Gusto mo bang magpahinga ngayon?
Dialogue: 0,0:58:13.28,0:58:15.75,Default,,0,0,0,,Maaari kaming mag-reschedule.
Dialogue: 0,0:58:15.78,0:58:17.73,Default,,0,0,0,,Hindi, hindi na kailangan.
Dialogue: 0,0:58:19.53,0:58:21.07,Default,,0,0,0,,Tara na.
Dialogue: 0,0:58:22.16,0:58:23.69,Default,,0,0,0,,Okay.
Dialogue: 0,0:58:50.77,0:58:52.17,Default,,0,0,0,,Ano ang mali?
Dialogue: 0,0:58:52.19,0:58:53.93,Default,,0,0,0,,Wag mo akong pansinin.
Dialogue: 0,0:59:10.00,0:59:11.70,Default,,0,0,0,,Salamat.
Dialogue: 0,0:59:12.29,0:59:13.69,Default,,0,0,0,,Maputla pa rin ang mukha mo.
Dialogue: 0,0:59:13.71,0:59:16.02,Default,,0,0,0,,Kung may sakit ka...
Dialogue: 0,0:59:16.05,0:59:17.58,Default,,0,0,0,,Hindi ako,
Dialogue: 0,0:59:17.76,0:59:21.04,Default,,0,0,0,,pero sana ako, para makapagpahinga ako.
Dialogue: 0,0:59:37.24,0:59:43.27,Default,,0,0,0,,Kumusta, sa lahat. Salamat sa\Pagdating. Ang pangalan ko ay Hong Hae-in.
Dialogue: 0,0:59:47.20,0:59:50.41,Default,,0,0,0,,Nagpapa-medical checkup na ba si Hae-in?
Dialogue: 0,0:59:50.75,0:59:54.02,Default,,0,0,0,,Ang tagal na simula nung sumali siya sa pamilya niya...
Dialogue: 0,0:59:54.04,0:59:56.33,Default,,0,0,0,,kasama ang mga checkup.
Dialogue: 0,0:59:56.63,0:59:58.91,Default,,0,0,0,,Siguro ginagawa niya ito sa ibang lugar.
Dialogue: 0,0:59:59.84,1:00:01.94,Default,,0,0,0,,Paki-alam kung saan.
Dialogue: 0,1:00:01.97,1:00:03.50,Default,,0,0,0,,Okay.
Dialogue: 0,1:00:03.64,1:00:08.09,Default,,0,0,0,,Sa tingin ko dapat mong ipagpaliban\Ang iyong paglalakbay sa Germany.
Dialogue: 0,1:00:08.35,1:00:10.38,Default,,0,0,0,,Bakit? para saan?
Dialogue: 0,1:00:12.06,1:00:14.08,Default,,0,0,0,,Masyadong mababa ang bilang ng iyong white blood cell.
Dialogue: 0,1:00:14.11,1:00:16.58,Default,,0,0,0,,Kailangan nilang i-extract at i-transform ang iyong mga cell...
Dialogue: 0,1:00:16.61,1:00:18.54,Default,,0,0,0,,para sa immune-cell na paggamot,
Dialogue: 0,1:00:18.57,1:00:22.26,Default,,0,0,0,,{\an8}ngunit hindi nila magagawa iyon kapag masyadong mababa ang iyong WBC.
Dialogue: 0,1:00:22.28,1:00:27.53,Default,,0,0,0,,Ang lab na iyon sa Germany ay\N tatanggi na gawin ito sa resultang ito.
Dialogue: 0,1:00:27.99,1:00:30.60,Default,,0,0,0,,Sinasabi mo bang sumuko na ako?
Dialogue: 0,1:00:30.62,1:00:32.77,Default,,0,0,0,,Hindi iyon ang ibig kong sabihin.
Dialogue: 0,1:00:32.79,1:00:36.20,Default,,0,0,0,,Dapat kang maghintay hanggang sa tumaas ang iyong WBC...
Dialogue: 0,1:00:37.25,1:00:38.95,Default,,0,0,0,,"Maghintay"?
Dialogue: 0,1:00:40.26,1:00:42.92,Default,,0,0,0,,Wala akong oras para diyan.
Dialogue: 0,1:00:45.47,1:00:47.13,Default,,0,0,0,,Teka lang, Ms. Hong.
Dialogue: 0,1:00:52.81,1:00:55.76,Default,,0,0,0,,Sir, ayos lang ako.
Dialogue: 0,1:00:56.02,1:00:57.97,Default,,0,0,0,,Halos wala akong nararamdamang sakit.
Dialogue: 0,1:00:58.73,1:01:02.09,Default,,0,0,0,,Masusumpungan ko sana itong kahabag-habag\Ntumor nang mas maaga kung ako ay nasa sakit.
Dialogue: 0,1:01:02.11,1:01:04.15,Default,,0,0,0,,Pero...
Dialogue: 0,1:01:15.42,1:01:17.12,Default,,0,0,0,,I...
Dialogue: 0,1:01:17.63,1:01:20.16,Default,,0,0,0,,Pumunta ako para sa cast na ito.
Dialogue: 0,1:01:21.38,1:01:23.92,Default,,0,0,0,,Nga pala...
Dialogue: 0,1:01:24.22,1:01:25.43,Default,,0,0,0,,{\i1}{\c&HFFFF&}Brain Tumor Department{\c}{\i0}
Dialogue: 0,1:01:28.97,1:01:31.17,Default,,0,0,0,,Bakit ka nandoon?
Dialogue: 0,1:01:39.27,1:01:40.75,Default,,0,0,0,,Kilala mo ba si Mi-yeong?
Dialogue: 0,1:01:40.78,1:01:42.13,Default,,0,0,0,,Sino yun?
Dialogue: 0,1:01:42.15,1:01:43.42,Default,,0,0,0,, Kaibigan ko.
Dialogue: 0,1:01:43.44,1:01:45.21,Default,,0,0,0,,Nagkaroon din siya ng brain tumor.
Dialogue: 0,1:01:45.24,1:01:47.76,Default,,0,0,0,,Mga limang taon na ang nakalipas.
Dialogue: 0,1:01:47.78,1:01:51.26,Default,,0,0,0,,Tinawag niya ang kanyang mga kaibigan at\Numiiyak sa ilog nang malaman niya.
Dialogue: 0,1:01:51.29,1:01:52.60,Default,,0,0,0,,Pero paano siya?
Dialogue: 0,1:01:52.62,1:01:55.18,Default,,0,0,0,,Okay na siya ngayon. Siya ang\Npinakamalusog sa amin.
Dialogue: 0,1:01:55.21,1:01:57.48,Default,,0,0,0,,Naglalaro siya sa lahat ng oras. Siya ay mabuti.
Dialogue: 0,1:01:57.50,1:02:01.31,Default,,0,0,0,,Mayroon kaming higit sa sapat na pera.\Nwala na ang mga sakit na magagamot,
Dialogue: 0,1:02:01.34,1:02:04.46,Default,,0,0,0,,kaya huwag mag-alala tungkol sa isang bagay.
Dialogue: 0,1:02:04.72,1:02:10.41,Default,,0,0,0,,Tita, hindi ako nag-aalala na gumaling.\Nag-aalala lang ako na sasabihin mo sa iba.
Dialogue: 0,1:02:10.43,1:02:11.99,Default,,0,0,0,,Wala bang nakakaalam?
Dialogue: 0,1:02:12.01,1:02:14.22,Default,,0,0,0,,Hindi man ang asawa mo?
Dialogue: 0,1:02:14.31,1:02:16.43,Default,,0,0,0,,Siya lang ang nakakaalam.
Dialogue: 0,1:02:16.69,1:02:19.14,Default,,0,0,0,,Talaga? nakikita ko.
Dialogue: 0,1:02:20.19,1:02:24.25,Default,,0,0,0,,Uy, ayos lang basta't alam niya. Walang seryoso.
Dialogue: 0,1:02:24.28,1:02:26.45,Default,,0,0,0,,Eksakto. Hindi naman seryoso.
Dialogue: 0,1:02:26.47,1:02:27.45,Default,,0,0,0,,Tita.
Dialogue: 0,1:02:27.47,1:02:28.47,Default,,0,0,0,,Oo?
Dialogue: 0,1:02:28.49,1:02:29.47,Default,,0,0,0,,Pupunta ako sa Germany.
Dialogue: 0,1:02:29.49,1:02:32.43,Default,,0,0,0,,Nakahanap ang lab nila ng bagong uri\Nof treatment na makakapagpagaling sa akin.
Dialogue: 0,1:02:32.45,1:02:34.01,Default,,0,0,0,,Kaya ako pumunta dito ngayon.
Dialogue: 0,1:02:34.04,1:02:36.52,Default,,0,0,0,,Talaga? totoo ba yun?
Dialogue: 0,1:02:36.54,1:02:39.27,Default,,0,0,0,,Kaya huwag sabihin kahit kanino.
Dialogue: 0,1:02:39.29,1:02:40.94,Default,,0,0,0,,Hoy! hindi ko gagawin.
Dialogue: 0,1:02:40.96,1:02:43.33,Default,,0,0,0,,Ayokong magdulot ng eksena.
Dialogue: 0,1:02:44.88,1:02:46.61,Default,,0,0,0,,Pagtitiwalaan kita.
Dialogue: 0,1:02:46.63,1:02:48.69,Default,,0,0,0,,Oo, kaya mo.
Dialogue: 0,1:02:48.72,1:02:50.38,Default,,0,0,0,,Hindi ka ba aalis?
Dialogue: 0,1:02:50.47,1:02:52.42,Default,,0,0,0,,I should go now.
Dialogue: 0,1:03:02.57,1:03:03.71,Default,,0,0,0,,Hey.
Dialogue: 0,1:03:03.73,1:03:06.60,Default,,0,0,0,,Sigurado akong nabigla ka.
Dialogue: 0,1:03:07.11,1:03:12.73,Default,,0,0,0,,Alam kong walang seryoso,\Npero pustahan ka pa ring nabigla.
Dialogue: 0,1:03:27.55,1:03:28.52,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Mi-yeong{\c}{\i0}
Dialogue: 0,1:03:30.05,1:03:33.55,Default,,0,0,0,,{\i1}Kasalukuyang hindi available ang numero na iyong na-dial.{\i0}
Dialogue: 0,1:03:46.03,1:03:47.63,Default,,0,0,0,,Suk-hui.
Dialogue: 0,1:03:47.65,1:03:49.34,Default,,0,0,0,,Nagpalit ba ng number si Mi-yeong?
Dialogue: 0,1:03:49.36,1:03:52.17,Default,,0,0,0,,- {\i1}Sino?{\i0}\N- Mi-yeong. Jang Mi-yeong.
Dialogue: 0,1:03:52.20,1:03:54.86,Default,,0,0,0,,{\i1}Ano? Hindi mo ba narinig?{\i0}
Dialogue: 0,1:03:55.49,1:03:58.43,Default,,0,0,0,,{\i1}Tama. Nasa kulungan ka.{\i0}
Dialogue: 0,1:03:58.45,1:04:00.89,Default,,0,0,0,,Bakit? May nangyari ba sa kanya?
Dialogue: 0,1:04:00.92,1:04:02.68,Default,,0,0,0,,{\i1}Namatay siya.{\i0}
Dialogue: 0,1:04:02.71,1:04:03.85,Default,,0,0,0,,Namatay siya?
Dialogue: 0,1:04:03.88,1:04:05.23,Default,,0,0,0,,Bakit?
Dialogue: 0,1:04:05.25,1:04:08.66,Default,,0,0,0,,{\i1}Ano sa tingin mo? Nagbalik siya.{\i0}
Dialogue: 0,1:04:09.76,1:04:11.99,Default,,0,0,0,,Bakit?
Dialogue: 0,1:04:12.01,1:04:14.95,Default,,0,0,0,,Narinig kong naging maayos ang operasyon at maayos naman siya.
Dialogue: 0,1:04:14.97,1:04:19.51,Default,,0,0,0,,Narinig kong nag-golf siya sa lahat ng\Ntime, kaya bakit siya namatay?
Dialogue: 0,1:04:19.93,1:04:24.01,Default,,0,0,0,,{\i1}Paano ko malalaman? Sa palagay ko'y mahirap talunin si\Nit.{\i0}
Dialogue: 0,1:04:25.19,1:04:28.56,Default,,0,0,0,,Bakit siya mamamatay?
Dialogue: 0,1:04:29.61,1:04:32.09,Default,,0,0,0,,Bakit siya?
Dialogue: 0,1:04:32.11,1:04:34.68,Default,,0,0,0,,{\i1}Uy, umiiyak ka ba?{\i0}
Dialogue: 0,1:04:34.70,1:04:37.90,Default,,0,0,0,,{\i1}Ganyan ba kayo kalapit?{\i0}
Dialogue: 0,1:04:38.83,1:04:42.86,Default,,0,0,0,,Bakit siya mamamatay?
Dialogue: 0,1:04:50.51,1:04:54.28,Default,,0,0,0,,Noong 2014, ang royal family ng Monaco\Nauctioned off ang kanilang Napoleon relics...
Dialogue: 0,1:04:54.30,1:04:57.75,Default,,0,0,0,,bago ayusin ang kanilang palasyo.
Dialogue: 0,1:04:57.97,1:05:02.79,Default,,0,0,0,,{\an8}Ito ang dress sword na binili ni Chairman\NHong sa auction na iyon.
Dialogue: 0,1:05:02.81,1:05:04.25,Default,,0,0,0,,{\an8}Sus.
Dialogue: 0,1:05:04.27,1:05:08.14,Default,,0,0,0,,{\an8}Ang espadang ito ay nagkakahalaga ng mahigit $3 milyon.
Dialogue: 0,1:05:08.82,1:05:11.42,Default,,0,0,0,,Nakakita ako ng katulad na espada sa isang museo sa London,
Dialogue: 0,1:05:11.44,1:05:13.26,Default,,0,0,0,,ngunit hindi sa isang bahay.
Dialogue: 0,1:05:13.28,1:05:16.68,Default,,0,0,0,,Napoleon ang paborito kong pigura.
Dialogue: 0,1:05:16.70,1:05:20.01,Default,,0,0,0,,Hindi mo ba naisip na isang\Nhimala ang isang batang taga-bayan...
Dialogue: 0,1:05:20.04,1:05:21.76,Default,,0,0,0,,mula sa isang isla sa timog ng France...
Dialogue: 0,1:05:21.79,1:05:24.32,Default,,0,0,0,,naging emperador?
Dialogue: 0,1:05:25.83,1:05:29.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Ako ay mahirap at palaging gutom noong tinedyer ako.{\c}{\i0}
Dialogue: 0,1:05:29.50,1:05:33.15,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Doon ko nakita ang\NNapoleon's biography...{\c}{\i0}
Dialogue: 0,1:05:33.17,1:05:34.48,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at nagsimulang mangarap.{\c}{\i0}
Dialogue: 0,1:05:34.51,1:05:39.03,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nalampasan din niya ang kahirapan at nakamit niya ang kanyang pangarap.{\c}{\i0}
Dialogue: 0,1:05:39.06,1:05:40.78,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Magagawa mo rin.{\c}{\i0}
Dialogue: 0,1:05:40.81,1:05:43.37,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Mangarap kung gusto mong\Nmaging lubos na matagumpay.{\c}{\i0}
Dialogue: 0,1:05:43.39,1:05:45.55,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Pagbigyan natin siya.{\c}{\i0}
Dialogue: 0,1:05:53.65,1:05:55.53,Default,,0,0,0,,{\i1}{\c&HFFFF&}Welcome Chairman Hong ng Queens Group{\c}{\i0}
Dialogue: 0,1:06:16.97,1:06:19.40,Default,,0,0,0,,Mayroon akong Jacques-Louis David's\Nportrait of Napoleon...
Dialogue: 0,1:06:19.43,1:06:21.59,Default,,0,0,0,,sa bahay ko sa New York.
Dialogue: 0,1:06:21.81,1:06:25.37,Default,,0,0,0,,Ito ay isang painting niya sa\Nkanyang uniporme ng militar noong 1813.
Dialogue: 0,1:06:25.39,1:06:28.72,Default,,0,0,0,,Kung maaari, gusto kong iregalo ito sa iyo.
Dialogue: 0,1:06:32.07,1:06:33.60,Default,,0,0,0,,Sa akin?
Dialogue: 0,1:06:34.40,1:06:37.51,Default,,0,0,0,,Pakiramdam ko deserve mo ito.
Dialogue: 0,1:06:37.53,1:06:42.44,Default,,0,0,0,,Naranasan mo ang isang himala gaya ng ginawa niya.
Dialogue: 0,1:06:46.16,1:06:48.52,Default,,0,0,0,,Tama, noong una akong dumating sa Seoul,
Dialogue: 0,1:06:48.54,1:06:51.74,Default,,0,0,0,,Nagpapakinis ako ng sapatos sa\Nharap ng isang department store,
Dialogue: 0,1:06:51.92,1:06:54.73,Default,,0,0,0,,pero ngayon ako na ang may-ari ng department store na iyon.
Dialogue: 0,1:06:54.76,1:06:56.19,Default,,0,0,0,,Himala ito, di ba?
Dialogue: 0,1:06:56.22,1:06:57.92,Default,,0,0,0,,Siyempre.
Dialogue: 0,1:07:02.05,1:07:06.06,Default,,0,0,0,,{\i1}{\c&HFFFF&}Welcome Chairman Hong ng Queens Group{\c}{\i0}
Dialogue: 0,1:07:12.23,1:07:15.43,Default,,0,0,0,,Bigla kang aalis papuntang Germany mag-isa?
Dialogue: 0,1:07:15.90,1:07:18.52,Default,,0,0,0,,Bakit hindi dumarating si Hyun-woo?
Dialogue: 0,1:07:18.65,1:07:19.88,Default,,0,0,0,,Busy siya,
Dialogue: 0,1:07:19.91,1:07:21.61,Default,,0,0,0,,at ito ay wala.
Dialogue: 0,1:07:21.74,1:07:22.76,Default,,0,0,0,,Dapat ba akong sumama?
Dialogue: 0,1:07:22.78,1:07:25.99,Default,,0,0,0,,I just need my passport. Ta-tag ako.
Dialogue: 0,1:07:26.16,1:07:27.97,Default,,0,0,0,,- Tita.\N- Oo?
Dialogue: 0,1:07:28.00,1:07:30.24,Default,,0,0,0,,Mas gusto kong mag-isa.
Dialogue: 0,1:07:30.96,1:07:32.62,Default,,0,0,0,,Ayos lang ako.
Dialogue: 0,1:08:29.52,1:08:31.05,Default,,0,0,0,,Hyun-woo.
Dialogue: 0,1:08:31.85,1:08:34.64,Default,,0,0,0,,Bakit nag-isa si Hae-in sa Germany?
Dialogue: 0,1:08:34.98,1:08:36.17,Default,,0,0,0,,Paumanhin?
Dialogue: 0,1:08:36.19,1:08:38.48,Default,,0,0,0,,Hindi mo ba alam na umalis siya?
Dialogue: 0,1:08:38.98,1:08:41.65,Default,,0,0,0,,Ikaw lang daw ang nakakaalam ng sakit niya.
Dialogue: 0,1:08:43.95,1:08:45.59,Default,,0,0,0,,So bakit hindi ka pumunta?
Dialogue: 0,1:08:45.62,1:08:49.68,Default,,0,0,0,,Sabi niya ikaw lang dapat ang nakakaalam,\Nso bakit siya pumunta mag-isa?
Dialogue: 0,1:08:49.70,1:08:52.49,Default,,0,0,0,,Bakit mo siya hinayaang umalis mag-isa?
Dialogue: 0,1:09:09.93,1:09:13.14,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Power Off{\c}{\i0}
Dialogue: 0,1:09:31.16,1:09:32.79,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hong Hae-in{\c}{\i0}
Dialogue: 0,1:09:54.56,1:09:56.68,Default,,0,0,0,,Cheers!
Dialogue: 0,1:09:58.81,1:10:01.38,Default,,0,0,0,,May alam akong magandang stream sa Gapyeong.
Dialogue: 0,1:10:01.40,1:10:03.62,Default,,0,0,0,,Maganda ang tinutuluyan,\Nmay mga water sports activities,
Dialogue: 0,1:10:03.64,1:10:05.71,Default,,0,0,0,,kaya tara na at mag-barbecue tayo.
Dialogue: 0,1:10:05.74,1:10:06.80,Default,,0,0,0,,Mukhang maganda.
Dialogue: 0,1:10:06.82,1:10:08.91,Default,,0,0,0,,Maghintay. Hayaan akong imbitahin ang lahat.
Dialogue: 0,1:10:08.93,1:10:09.97,Default,,0,0,0,,Oo, dapat.
Dialogue: 0,1:10:09.99,1:10:12.53,Default,,0,0,0,,- Ipopost ko sa group chat natin.\N- Okay.
Dialogue: 0,1:10:14.29,1:10:16.20,Default,,0,0,0,,Darating si Seok-jun.
Dialogue: 0,1:10:17.00,1:10:19.48,Default,,0,0,0,,Kinakansela ni Dae-ho ang kanyang mga plano sa golf na darating.
Dialogue: 0,1:10:19.50,1:10:22.52,Default,,0,0,0,,Baliw ba si Cheol-seung?\Ngusto niyang isama ang asawa niya?
Dialogue: 0,1:10:22.55,1:10:24.15,Default,,0,0,0,,Ang tanga.
Dialogue: 0,1:10:24.17,1:10:25.87,Default,,0,0,0,,Na-block.
Dialogue: 0,1:10:28.47,1:10:29.53,Default,,0,0,0,,Nakikinig ka ba?
Dialogue: 0,1:10:29.55,1:10:32.42,Default,,0,0,0,,- Syempre.\N- Saka bakit hindi ka excited?
Dialogue: 0,1:10:32.64,1:10:35.76,Default,,0,0,0,,Hindi, nasasabik ako. Hindi ako makapaghintay.
Dialogue: 0,1:10:36.52,1:10:38.58,Default,,0,0,0,,Barbecue. Ay, oo.
Dialogue: 0,1:10:38.60,1:10:40.76,Default,,0,0,0,,Water sports. Nakuha ko.
Dialogue: 0,1:10:41.32,1:10:43.02,Default,,0,0,0,,Hindi ito tama.
Dialogue: 0,1:10:43.48,1:10:46.67,Default,,0,0,0,,Nasaan ang matandang Hyun-woo na gumamit\Nto ng tatlong tasa ng espresso...
Dialogue: 0,1:10:46.70,1:10:50.90,Default,,0,0,0,,ang magpuyat magdamag sa party\Nnung nag-abroad ang asawa niya?
Dialogue: 0,1:10:51.95,1:10:52.93,Default,,0,0,0,,Nandito ako.
Dialogue: 0,1:10:52.95,1:10:55.86,Default,,0,0,0,,Hindi, wala ka dito.
Dialogue: 0,1:10:56.12,1:10:57.56,Default,,0,0,0,,Nasa Germany ka.
Dialogue: 0,1:10:57.58,1:10:59.81,Default,,0,0,0,,Bakit mo tinitingnan ang kanilang lagay ng panahon?
Dialogue: 0,1:10:59.83,1:11:02.49,Default,,0,0,0,,Nag-aalala ka ba sa asawa mo?
Dialogue: 0,1:11:03.05,1:11:04.83,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,1:11:05.38,1:11:08.19,Default,,0,0,0,,Sinubukan mo bang magpanggap na gusto mo siya,
Dialogue: 0,1:11:08.22,1:11:10.84,Default,,0,0,0,,na talagang umibig ka?
Dialogue: 0,1:11:11.14,1:11:12.11,Default,,0,0,0,,No.
Dialogue: 0,1:11:12.14,1:11:14.53,Default,,0,0,0,,Naghinala na ako sa iyo mula noong\Nang insidente ng peanut-cake.
Dialogue: 0,1:11:14.56,1:11:16.45,Default,,0,0,0,,- Mali ka.\N- Tama?
Dialogue: 0,1:11:16.48,1:11:18.12,Default,,0,0,0,,Hindi, tama ba?
Dialogue: 0,1:11:18.14,1:11:20.04,Default,,0,0,0,,Oo, hawakan mo.
Dialogue: 0,1:11:20.06,1:11:22.17,Default,,0,0,0,,Huwag masyadong intindihin.
Dialogue: 0,1:11:22.19,1:11:23.21,Default,,0,0,0,,Okay?
Dialogue: 0,1:11:23.23,1:11:25.85,Default,,0,0,0,,Sige! Ulitin natin yan!
Dialogue: 0,1:11:28.22,1:11:29.25,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang Reyna{\c}{\i0}
Dialogue: 0,1:11:31.87,1:11:33.48,Default,,0,0,0,,Oo, Honey.
Dialogue: 0,1:11:33.66,1:11:34.97,Default,,0,0,0,,Hindi ito masaya.
Dialogue: 0,1:11:34.99,1:11:37.49,Default,,0,0,0,,Hindi talaga ito masaya.
Dialogue: 0,1:11:38.08,1:11:39.91,Default,,0,0,0,,Siyempre hindi.
Dialogue: 0,1:13:35.61,1:13:37.83,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Narito ang iyong panayam kay Ms. Hong{\c}{\i0}
Dialogue: 0,1:13:41.25,1:13:43.00,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ibinunyag ni Hong Hae-in...{\c}{\i0}
Dialogue: 0,1:13:46.50,1:13:50.87,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Anyway, romantiko na siya noon pa man.{\c}{\i0}
Dialogue: 0,1:13:51.63,1:13:54.62,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Doon nagsimula ang love story namin.{\c}{\i0}
Dialogue: 0,1:13:55.26,1:13:56.82,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Narito ang huli kong tanong.{\c}{\i0}
Dialogue: 0,1:13:56.84,1:13:59.50,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ano ang pangarap mo?{\c}{\i0}
Dialogue: 0,1:13:59.72,1:14:02.70,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Kailangan kong sabihin na lampas\N$1 bilyon ang benta...{\c}{\i0}
Dialogue: 0,1:14:02.72,1:14:04.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}sa aking department store.{\c}{\i0}
Dialogue: 0,1:14:04.94,1:14:07.46,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ginagawa ko ito, at mangyayari ito sa lalong madaling panahon.{\c}{\i0}
Dialogue: 0,1:14:07.48,1:14:09.04,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Congrats in advance.{\c}{\i0}
Dialogue: 0,1:14:09.06,1:14:10.79,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ano ang susunod mong pangarap?{\c}{\i0}
Dialogue: 0,1:14:10.82,1:14:15.71,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sa tingin ko ay maglalayon ako ng mas mataas na bilang sa mga benta.{\c}{\i0}
Dialogue: 0,1:14:15.74,1:14:19.05,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Paano kapag naabot mo ang lahat ng iyong layunin?{\c}{\i0}
Dialogue: 0,1:14:19.07,1:14:22.24,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Hindi ko kailanman naisip na ganoon kalayo.{\c}{\i0}
Dialogue: 0,1:14:25.25,1:14:26.95,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Noon...{\c}{\i0}
Dialogue: 0,1:14:28.21,1:14:30.70,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gusto kong magpahinga.{\c}{\i0}
Dialogue: 0,1:14:32.38,1:14:35.17,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gusto kong maglakbay kasama ang aking asawa.{\c}{\i0}
Dialogue: 0,1:14:35.59,1:14:39.25,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Ang una at huling biyahe namin ay ang aming honeymoon.{\c}{\i0}
Dialogue: 0,1:14:39.68,1:14:41.74,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Gusto kong pumunta...{\c}{\i0}
Dialogue: 0,1:14:41.76,1:14:43.59,Default,,0,0,0,,{\i1}{\c&HFFFF00&}sa mga paglalakad,{\c}{\i0}
Dialogue: 0,1:14:43.72,1:14:46.76,Default,,0,0,0,,{\i1}{\c&HFFFF00&}uminom ng tsaa, kumain, makipag-chat,{\c}{\i0}
Dialogue: 0,1:14:46.98,1:14:49.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}at gumawa ng ilang catch up muli.{\c}{\i0}
Dialogue: 0,1:14:51.48,1:14:53.35,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Maganda sana.{\c}{\i0}
Dialogue: 0,1:14:56.20,1:14:59.06,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sana magawa ko iyon...{\c}{\i0}
Dialogue: 0,1:15:00.32,1:15:02.11,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}araw-araw.{\c}{\i0}
Dialogue: 0,1:15:08.96,1:15:11.74,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}Sana magawa ko iyon...{\c}{\i0}
Dialogue: 0,1:15:13.09,1:15:14.91,Default,,0,0,0,,{\i1}{\c&H7AA0FF&}araw-araw.{\c}{\i0}
Dialogue: 0,1:16:45.01,1:16:47.59,Default,,0,0,0,,Bakit lahat sila gusto kong maghintay?
Dialogue: 0,1:16:47.97,1:16:50.80,Default,,0,0,0,,Bakit sila nagsasalita na parang nasa side ko ang oras?
Dialogue: 0,1:16:51.94,1:16:53.59,Default,,0,0,0,,Wala akong oras.
Dialogue: 0,1:16:56.19,1:16:57.89,Default,,0,0,0,,Ayoko.
Dialogue: 0,1:18:17.15,1:18:19.01,Default,,0,0,0,,"Huwag mag-alala"?
Dialogue: 0,1:18:19.48,1:18:22.35,Default,,0,0,0,,Nag-aalala na ako sa\Npagbaba sa hagdan na ito.
Dialogue: 0,1:18:27.95,1:18:30.15,Default,,0,0,0,,Bakit napakarami nila?
Dialogue: 0,1:18:45.72,1:18:47.33,Default,,0,0,0,,Hong Hae-in!
Dialogue: 0,1:18:53.22,1:18:54.92,Default,,0,0,0,,Ano iyon?
Dialogue: 0,1:18:56.85,1:18:59.55,Default,,0,0,0,,May naririnig na ba ako ngayon?
Dialogue: 0,1:19:33.97,1:19:36.63,Default,,0,0,0,,Diba sabi ko magsuot ka ng komportableng sapatos?
Dialogue: 0,1:19:38.27,1:19:40.43,Default,,0,0,0,,Hindi ka talaga nakikinig.
Dialogue: 0,1:19:53.74,1:19:55.05,Default,,0,0,0,,Paano mo nalaman na nandito ako?
Dialogue: 0,1:19:55.08,1:19:56.18,Default,,0,0,0,,Naka-off ang iyong telepono.
Dialogue: 0,1:19:56.20,1:19:59.47,Default,,0,0,0,,Sabi nila umalis ka sa\Nhospital pagkatapos mong tanggihan,
Dialogue: 0,1:19:59.50,1:20:02.83,Default,,0,0,0,,pero sinabi ni Secretary Na na hindi ka nakasakay pabalik,
Dialogue: 0,1:20:03.67,1:20:05.87,Default,,0,0,0,,kaya nag-isip ako ng matagal,
Dialogue: 0,1:20:07.38,1:20:09.58,Default,,0,0,0,,at naisip ko ang lugar na ito.
Dialogue: 0,1:20:11.22,1:20:13.46,Default,,0,0,0,,Nag-enjoy ka sa honeymoon natin dito.
Dialogue: 0,1:20:13.64,1:20:15.46,Default,,0,0,0,,Nagustuhan mo ang pangalan.
Dialogue: 0,1:20:20.48,1:20:21.75,Default,,0,0,0,,Hindi ko sinabi iyon.
Dialogue: 0,1:20:21.77,1:20:23.55,Default,,0,0,0,,Sinabi kong kasinungalingan.
Dialogue: 0,1:20:23.90,1:20:27.18,Default,,0,0,0,,"Isang lugar na walang pag-aalala o luha."
Dialogue: 0,1:20:27.73,1:20:30.35,Default,,0,0,0,,Nagsisinungaling lang sila para mang-akit ng mga turista.
Dialogue: 0,1:20:33.03,1:20:36.28,Default,,0,0,0,,Ikaw ang nagsinungaling.
Dialogue: 0,1:20:36.87,1:20:38.85,Default,,0,0,0,,- Anong ginawa ko?\N- Hindi mo ba naaalala?
Dialogue: 0,1:20:38.87,1:20:41.82,Default,,0,0,0,,Ano ang sinabi mo sa akin noong nag-propose ka?
Dialogue: 0,1:20:42.12,1:20:44.49,Default,,0,0,0,,Nangako kang hindi mo ako paiiyakin.
Dialogue: 0,1:20:44.79,1:20:46.62,Default,,0,0,0,,You told me to trust you,
Dialogue: 0,1:20:46.88,1:20:48.36,Default,,0,0,0,,pero hulaan mo?
Dialogue: 0,1:20:48.38,1:20:51.00,Default,,0,0,0,,Iyak ako ng iyak noong kasal namin.
Dialogue: 0,1:20:51.30,1:20:53.07,Default,,0,0,0,,Naiiyak ako habang nagmamaneho,
Dialogue: 0,1:20:53.09,1:20:55.07,Default,,0,0,0,,paghuhugas ng mukha,
Dialogue: 0,1:20:55.10,1:20:57.00,Default,,0,0,0,,at sa car wash.
Dialogue: 0,1:20:57.47,1:20:59.97,Default,,0,0,0,,Gusto kong matulog nang hiwalay,
Dialogue: 0,1:21:00.39,1:21:02.93,Default,,0,0,0,,dahil naiiyak ako sa pagtulog.
Dialogue: 0,1:21:06.90,1:21:08.60,Default,,0,0,0,,Noon...
Dialogue: 0,1:21:09.23,1:21:12.48,Default,,0,0,0,,Sinabi ko lang kahit ano, para pakasalan kita.
Dialogue: 0,1:21:13.32,1:21:15.31,Default,,0,0,0,,At kasal na kami,
Dialogue: 0,1:21:17.20,1:21:18.90,Default,,0,0,0,,kaya dapat...
Dialogue: 0,1:21:19.74,1:21:21.90,Default,,0,0,0,,stick with you...
Dialogue: 0,1:21:23.04,1:21:25.03,Default,,0,0,0,,sa mga panahong tulad nito.
Dialogue: 0,1:21:35.47,1:21:37.71,Default,,0,0,0,,Nasabi ko na ba sa iyo na huwag?
Dialogue: 0,1:21:38.93,1:21:40.84,Default,,0,0,0,,Gusto kita...
Dialogue: 0,1:21:41.18,1:21:43.34,Default,,0,0,0,,upang manatili sa akin.
Dialogue: 0,1:21:45.85,1:21:47.97,Default,,0,0,0,,Ayokong mag-isa.
Dialogue: 0,1:21:50.03,1:21:52.10,Default,,0,0,0,,Kailanman.
Dialogue: 0,1:21:57.41,1:21:59.11,Default,,0,0,0,,Pasensya na.
Dialogue: 0,1:22:03.79,1:22:05.70,Default,,0,0,0,,I'm really sorry.
Dialogue: 0,1:22:23.73,1:22:25.26,Default,,0,0,0,,Uwi na tayo.
Dialogue: 0,1:22:28.36,1:22:30.77,Default,,0,0,0,,Akala ko dito ko makikita.
Dialogue: 0,1:22:31.94,1:22:34.85,Default,,0,0,0,,Isang mahimalang paraan ng pamumuhay,
Dialogue: 0,1:22:35.57,1:22:38.40,Default,,0,0,0,,o isang lugar na walang kalungkutan...
Dialogue: 0,1:22:41.87,1:22:43.99,Default,,0,0,0,,Ngunit wala.
Dialogue: 0,1:22:45.00,1:22:46.78,Default,,0,0,0,,Lahat ng gusto ko...
Dialogue: 0,1:22:47.71,1:22:50.87,Default,,0,0,0,,ay uuwi na kasama ka.
Dialogue: 0,1:24:33.23,1:24:35.47,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Narinig kong ito ang iyong lifeline.{\c}{\i0}
Dialogue: 0,1:24:35.52,1:24:36.96,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Bakit napakaikli ng akin?{\c}{\i0}
Dialogue: 0,1:24:36.98,1:24:38.73,Default,,0,0,0,,{\i1}{\c&HFFFF00&}Nasaktan ako.{\c}{\i0}
Dialogue: 0,1:24:47.45,1:24:49.32,Default,,0,0,0,,Ito ba...
Dialogue: 0,1:24:50.12,1:24:51.99,Default,,0,0,0,,maikli?
Dialogue: 0,1:24:59.55,1:25:01.25,Default,,0,0,0,,I guess...
Dialogue: 0,1:25:02.05,1:25:04.17,Default,,0,0,0,,ito ay.
Dialogue: 0,1:25:21.82,1:25:23.73,Default,,0,0,0,,Kumusta naman ito?
Dialogue: 0,1:25:28.58,1:25:31.03,Default,,0,0,0,,Tungkol dito.
Dialogue: 0,1:25:57.61,1:26:00.53,Default,,0,0,0,,{\i1}{\c&HFFFF&}Reyna ng Luha{\c}{\i0}
Dialogue: 0,1:26:28.09,1:26:31.37,Default,,0,0,0,,{\an8}{\i1}Talagang pinagpala ako ng isang mabuting asawa.{\i0}
Dialogue: 0,1:26:31.39,1:26:34.33,Default,,0,0,0,,{\an8}- {\i1}Pwede ba akong matulog sa kwarto mo?{\i0}\N- Matulog ka na lang kung saan mo gusto.
Dialogue: 0,1:26:34.35,1:26:37.18,Default,,0,0,0,,{\an8}{\i1}Gawin ang gusto mo. Sundin ang iyong puso.{\i0}
Dialogue: 0,1:26:37.27,1:26:38.93,Default,,0,0,0,,{\an8}{\i1}Hindi kapani-paniwala.{\i0}
Dialogue: 0,1:26:39.23,1:26:41.10,Default,,0,0,0,,{\an8}{\i1}Bakit mo gagawin kung napakalakas na niya?{\i0}
Dialogue: 0,1:26:41.12,1:26:44.13,Default,,0,0,0,,{\an8}{\i1}Tigilan mo na ang pagiging gahaman kung matagal ka nang nag\Nit, hamak ka!{\i0}
Dialogue: 0,1:26:44.15,1:26:46.48,Default,,0,0,0,,{\an8}{\i1}Si Yongdu-ri ay sumikat.{\i0}
Dialogue: 0,1:26:46.82,1:26:49.88,Default,,0,0,0,,{\an8}{\i1}Ang isang relasyon ay nakatali\Nupang gumuho ng isang lihim.{\i0}
Dialogue: 0,1:26:49.91,1:26:51.84,Default,,0,0,0,,{\an8}- {\i1}May nakita lang ako.\N- Hae-in!{\i0}
Dialogue: 0,1:26:51.87,1:26:54.53,Default,,0,0,0,,{\an8}{\i1}Kapag malapit ka nang mamatay...{\i0}
Dialogue: 0,1:26:54.62,1:26:56.52,Default,,0,0,0,,{\an8}{\i1}Baka dumating siya...{\i0}
Dialogue: 0,1:26:56.54,1:26:58.57,Default,,0,0,0,,{\an8}{\i1}kasi oras na.{\i0}
