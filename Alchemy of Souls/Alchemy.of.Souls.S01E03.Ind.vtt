Dialog: 0,0:02:47.14,0:02:49.14,nicks,,0,0,0,,Koordinator proyek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.14,0:02:51.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Sana, Martini
Dialogue: 0,0:02:51.14,0:02:53.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:00:57.38,0:01:00.51,kenangan,,0,0,0,,Aku melarang siapa pun membuka gerbang ini
Dialog: 0,0:01:07.68,0:01:08.68,kenangan miring,,0,0,0,,Tetap di tempatmu berada!
Dialog: 0,0:01:11.06,0:01:13.10,kenangan miring,,0,0,0,,Kamu tidak bisa pergi begitu saja
Dialog: 0,0:01:13.69,0:01:15.40,kenangan,,0,0,0,,Bagaimana dengan anak itu?
Dialog: 0,0:01:15.94,0:01:19.28,kenangan,,0,0,0,,Pikirkan apa yang akan mereka katakan tentang Do Hwa dan bayi itu
Dialog: 0,0:01:19.82,0:01:21.65,kenangan,,0,0,0,,Mereka akan bergosip bahwa anak itu bukan milikmu,
Dialog: 0,0:01:22.53,0:01:24.99,kenangan,,0,0,0,,bahwa dia tidak sah
Dialog: 0,0:01:25.74,0:01:29.45,kenangan,,0,0,0,,Dia akan menyandang nama keluarga Chan, sejak istriku melahirkannya
Dialog: 0,0:01:30.08,0:01:32.50,kenangan,,0,0,0,,Aku akan mengirim seseorang untuk mengejarnya setelah pemakaman
Dialog: 0,0:01:32.58,0:01:34.04,kenangan,,0,0,0,,Apakah kamu meninggalkan dia?
Dialog: 0,0:01:35.42,0:01:36.58,kenangan,,0,0,0,,Dia benar
Dialog: 0,0:01:37.38,0:01:38.88,kenangan,,0,0,0,,bukan anakmu?
Dialog: 0,0:01:41.30,0:01:43.47,kenangan,,0,0,0,,Percayalah pada apa yang kamu inginkan
Dialog: 0,0:01:46.26,0:01:48.47,kenangan miring,,0,0,0,,Jika dia hanyalah masalah,
Dialog: 0,0:01:48.55,0:01:50.31,kenangan,,0,0,0,,mari kita singkirkan dia sekarang juga
Dialog: 0,0:02:00.02,0:02:02.48,kenangan,,0,0,0,,Lihat? Dia adalah putramu
Dialog: 0,0:02:02.57,0:02:07.41,kenangan,,0,0,0,,Putra yang ingin kau lindungi bahkan dengan mengorbankan nyawamu
Dialog: 0,0:02:07.99,0:02:09.74,kenangan,,0,0,0,,Aku hanya berusaha menjaga dia tetap aman
Dialog: 0,0:02:11.45,0:02:14.79,kenangan,,0,0,0,,Jika gerbang energinya tidak terbuka, dan dia hidup seperti anakku, dia akan selamat
Dialog: 0,0:02:15.29,0:02:18.42,kenangan,,0,0,0,,Tetapi jika dia memutuskan untuk mencoba peruntungannya,
Dialog: 0,0:02:20.00,0:02:21.67,kenangan,,0,0,0,,kematian menantinya
Dialogue: 0,0:02:23.76,0:02:26.26,kenangan,,0,0,0,,Siapa bapaknya
Dialog: 0,0:02:27.72,0:02:28.84,kenangan,,0,0,0,,anak?
Dialog: 0,0:02:33.39,0:02:35.52,kenangan,,0,0,0,,Ayahnya meninggal
Dialog: 0,0:02:39.02,0:02:41.11,kenangan miring,,0,0,0,,Kelahirannya tidak masuk akal, apalagi,
Dialog: 0,0:02:41.90,0:02:43.94, kenangan miring,,0,0,0,,dia seharusnya tidak dilahirkan sama sekali
Dialogue: 0,0:02:49.45,0:02:51.70,teks umum,,0,0,0,,Tuan Muda, kamu baik-baik saja?
Dialogue: 0,0:02:52.45,0:02:54.83,teks umum,,0,0,0,,Kenapa dilepas?
Dialog: 0,0:02:54.91,0:02:56.16,teks umum,,0,0,0,,Biarkan dia pergi
Dialog: 0,0:03:25.07,0:03:27.15,teks umum,,0,0,0,,Maaf telah menyebabkan masalah
Dialog: 0,0:03:27.24,0:03:29.41,miring,,0,0,0,,Kenapa kamu melepaskan ikatannya?
Dialog: 0,0:03:32.28,0:03:35.12,teks umum,,0,0,0,,Dia mencoba meracunimu
Dialog: 0,0:03:35.70,0:03:37.70,teks umum,,0,0,0,,Dia tidak mencoba
Dialog: 0,0:03:38.91,0:03:40.37,teks umum,,0,0,0,,Aku sendiri yang meminum racunnya
Dialog: 0,0:03:42.96,0:03:46.71,teks umum,,0,0,0,,Karena aku tidak bisa merapal mantra
Dialog: 0,0:03:47.46,0:03:50.34,teks umum,,0,0,0,,Pelayanku hanya melakukan apa yang diperintahkan. Dengan mengorbankan nyawanya
Dialog: 0,0:03:51.64,0:03:53.43,teks umum,,0,0,0,,Aku memerintahkannya
Dialog: 0,0:04:01.98,0:04:05.02,teks umum,,0,0,0,,- Chan Wook, bagaimana bisa?\N- Tunggu dengan ini
Dialog: 0,0:04:05.11,0:04:08.90,teks umum,,0,0,0,,Dia belum pulih sepenuhnya
Dialog: 0,0:04:08.99,0:04:12.49,teks umum,,0,0,0,,Hukum dia sesukamu, tapi setelah dia pulih
Dialogue: 0,0:04:12.57,0:04:14.37,teks umum,,0,0,0,,Uk hampir mati
Dialog: 0,0:04:14.45,0:04:16.70,teks umum,,0,0,0,,Tidak perlu memarahinya
Dialogue: 0,0:04:16.79,0:04:18.45,italic,,0,0,0,,Dia pucat pasi
Dialogue: 0,0:04:20.46,0:04:21.92,teks umum,,0,0,0,,Bawa dia pulang sampai jumpa
Dialog: 0,0:04:22.00,0:04:24.13,teks umum,,0,0,0,,Pak, ayo berangkat
Dialog: 0,0:04:24.21,0:04:26.00,teks umum,,0,0,0,,Pergi ke Sejukwon, kamu akan sembuh disana
Dialog: 0,0:04:26.09,0:04:27.63,teks umum,,0,0,0,,Mu Dok harus ke sana juga
Dialog: 0,0:04:28.21,0:04:29.80,teks umum,,0,0,0,,Sekarang bukan waktunya...
Dialog: 0,0:04:29.88,0:04:31.80,teks umum,,0,0,0,,Mu Dok juga butuh perawatan
Dialog: 0,0:04:31.88,0:04:33.47,teks umum,,0,0,0,,Kalau tidak, aku tidak akan pergi
Dialog: 0,0:04:33.55,0:04:34.76,teks umum,,0,0,0,,Tuan!
Dialog: 0,0:04:34.85,0:04:36.93,miring,,0,0,0,,Wah, bagus! Matilah kalau begitu
Dialog: 0,0:04:37.01,0:04:39.89,teks umum,,0,0,0,,- Kunci lagi!\N- Paman, tenanglah
Dialog: 0,0:04:39.98,0:04:42.06,teks umum,,0,0,0,,Jika Uk mengatakan yang sebenarnya, dia tidak bersalah
Dialog: 0,0:04:42.90,0:04:44.02,teks umum,,0,0,0,,Dia terluka parah
Dialog: 0,0:04:44.69,0:04:46.27,teks umum,,0,0,0,,Tanpa pengobatan dia akan mati
Dialog: 0,0:04:46.36,0:04:49.61,teks umum,,0,0,0,,Aku terkejut dia masih hidup setelah semua pemukulan
Dialog: 0,0:04:50.19,0:04:52.91,teks umum,,0,0,0,,Jika dia meninggal, aku akan membiarkanmu memimpin pemakamannya
Dialog: 0,0:05:10.46,0:05:11.80,teks umum,,0,0,0,,Tolong bantu
Dialog: 0,0:05:13.38,0:05:16.43,teks umum,,0,0,0,,Moo Dok mempertaruhkan nyawanya mengikuti perintahku
Dialog: 0,0:05:16.51,0:05:19.10,teks umum,,0,0,0,,Dia harus dibawa ke Sejukwon, kalau tidak dia tidak akan selamat
Dialog: 0,0:05:20.85,0:05:22.14,teks umum,,0,0,0,,Bantu dia
Dialog: 0,0:05:33.15,0:05:34.66,teks umum,,0,0,0,,Singkirkan mereka dari pandanganku
Dialog: 0,0:05:35.45,0:05:37.62,teks umum,,0,0,0,,Bawa mereka ke Saejukwon
Dialog: 0,0:05:40.62,0:05:41.54,miring,,0,0,0,,Ukraina...
Dialog: 0,0:05:44.21,0:05:47.21,teks umum,,0,0,0,,Tuan muda, ayo. Aku akan membawa Moo Deok
Dialog: 0,0:05:47.88,0:05:48.71,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:05:49.75,0:05:51.38,teks umum,,0,0,0,,Moo Dok, bangun
Dialog: 0,0:06:12.03,0:06:13.53,teks umum,,0,0,0,,- Aku akan menggendongnya\N- Tidak
Dialog: 0,0:06:14.99,0:06:16.41,teks umum,,0,0,0,,Saya Sendiri
Dialog: 0,0:06:16.49,0:06:17.95,teks umum,,0,0,0,,Kamu bahkan tidak bisa berdiri
Dialog: 0,0:06:18.82,0:06:21.70,teks umum,,0,0,0,,Saya bisa melakukannya. Dia pembantuku, aku akan menggendongnya sendiri
Dialog: 0,0:06:21.79,0:06:23.41,teks umum,,0,0,0,,Kamu sendiri hampir tidak bisa berjalan
Dialog: 0,0:06:23.50,0:06:25.16,teks umum,,0,0,0,,Kamu tidak bisa mendapatkannya di sana
Dialog: 0,0:06:27.12,0:06:29.17,teks umum,,0,0,0,,Menurutmu? Lalu...
Dialog: 0,0:06:30.34,0:06:32.84,teks umum,,0,0,0,,- Kamu akan menggendongnya di punggungmu\N- Apa?
Dialog: 0,0:06:32.92,0:06:34.21,teks umum,,0,0,0,,Ayo
Dialog: 0,0:06:34.84,0:06:36.80,teks umum,,0,0,0,,- Apakah kamu ingin aku menggendongnya?\N- Ya
Dialogue: 0,0:06:37.38,0:06:39.09,teks umum,,0,0,0,,Kenapa aku?
Dialog: 0,0:06:39.18,0:06:40.68,teks umum,,0,0,0,,- Kemari\N- Tuan Muda
Dialog: 0,0:06:41.18,0:06:43.35,teks umum,,0,0,0,,No. Tunggu. Surga...
Dialog: 0,0:06:43.93,0:06:45.06,teks umum,,0,0,0,,Surga suci
Dialog: 0,0:06:45.14,0:06:48.40,teks umum,,0,0,0,,Hei, Yul. Dengar...
Dialogue: 0,0:06:48.48,0:06:50.06,teks umum,,0,0,0,,Gendong aku, bukannya Moo Dok
Dialog: 0,0:06:52.19,0:06:54.74,teks umum,,0,0,0,,Tidak ada kekuatan sama sekali. Bawa aku ke Sejukwon
Dialog: 0,0:06:56.49,0:06:57.99,teks umum,,0,0,0,,Apakah kamu ingin aku menggendongnya?
Dialog: 0,0:06:59.74,0:07:02.28,teks umum,,0,0,0,,- Tidak\N- Oke terima kasih
Dialog: 0,0:07:02.37,0:07:04.12,teks umum,,0,0,0,,Hamba Kim, hati-hati!
Dialog: 0,0:07:04.20,0:07:05.75,teks umum,,0,0,0,,- Hati-hati dengan dia\N- Oke
Dialog: 0,0:07:05.83,0:07:06.71,teks umum,,0,0,0,,- Baiklah...\N- Apa...
Dialog: 0,0:07:07.46,0:07:08.79,teks umum,,0,0,0,,Perhatian
Dialog: 0,0:07:12.09,0:07:13.63,teks umum,,0,0,0,,Pada akhirnya, Inggris
Dialog: 0,0:07:15.09,0:07:17.63,teks umum,,0,0,0,,membuka gerbang energi
Dialog: 0,0:07:18.84,0:07:19.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:07:21.26,0:07:25.85,teks umum,,0,0,0,,Dia mempertaruhkan nyawanya. Saya tidak bisa hanya duduk dan menonton
Dialog: 0,0:07:26.64,0:07:29.44,teks umum,,0,0,0,,Saya pikir dia mengerti,
Dialog: 0,0:07:29.52,0:07:33.07,teks umum,,0,0,0,,bahwa kami tidak akan membiarkan dia bunuh diri
Dialog: 0,0:07:33.94,0:07:36.53,miring,,0,0,0,,Dia mungkin yang meminum racunnya sendiri,
Dialog: 0,0:07:36.61,0:07:38.28,teks umum,,0,0,0,,agar kita selamatkan dia
Dialog: 0,0:07:42.32,0:07:43.62,teks umum,,0,0,0,,Apakah semuanya baik-baik saja?
Dialogue: 0,0:07:45.87,0:07:48.79,teks umum,,0,0,0,,Membuka gerbang Uka dan perlakuannya
Dialog: 0,0:07:48.87,0:07:51.63,teks umum,,0,0,0,,mungkin menghabiskan energiku selama sepuluh tahun
Dialogue: 0,0:07:52.67,0:07:56.80,teks umum,,0,0,0,,Jadi kamu tidak hanya membuka gerbangnya, tapi juga memberinya energi?
Dialogue: 0,0:07:56.88,0:08:00.43,teks umum,,0,0,0,,Untuk apa aku, seorang lelaki tua, menyimpan energiku?
Dialog: 0,0:08:01.13,0:08:03.14,teks umum,,0,0,0,,Dia diracun,
Dialog: 0,0:08:03.22,0:08:05.85,teks umum,,0,0,0,,jadi aku memberinya kekuatan untuk pulih dengan cepat
Dialog: 0,0:08:05.93,0:08:09.85,teks umum,,0,0,0,,Saat Inggris dipulihkan, Anda harus mengembalikannya
Dialog: 0,0:08:10.81,0:08:14.15,teks umum,,0,0,0,,Apakah ini benar-benar diperlukan saat gerbangnya terbuka?
Dialog: 0,0:08:14.73,0:08:18.40,teks umum,,0,0,0,,Dia terlambat 20 tahun dalam mempelajari mantra
Dialog: 0,0:08:18.49,0:08:20.90,teks umum,,0,0,0,,Bahkan jika dia mulai belajar sekarang,
Dialog: 0,0:08:21.41,0:08:25.74,teks umum,,0,0,0,,pelajari sesuatu yang berharga di usia 60 tahun
Dialog: 0,0:08:25.83,0:08:28.66,teks umum,,0,0,0,,Begitulah nasibnya
Dialog: 0,0:08:30.54,0:08:32.04,teks umum,,0,0,0,,Kita perlu memastikan hal ini
Dialog: 0,0:08:33.79,0:08:37.09,teks umum,,0,0,0,,Jika kamu menginginkannya, aku akan mengambil kekuatanmu
Dialogue: 0,0:08:37.17,0:08:38.30,teks umum,,0,0,0,,Tahu tidak?
Dialog: 0,0:08:39.17,0:08:41.88,teks umum,,0,0,0,,Aku terlalu lelah. Saya ingin bersantai
Dialog: 0,0:08:42.63,0:08:44.85,teks umum,,0,0,0,,Bawakan aku anggur
Dialog: 0,0:08:48.64,0:08:49.93,teks umum,,0,0,0,,Anggur?
Dialog: 0,0:08:52.06,0:08:53.10,teks umum,,0,0,0,,Itu...
Dialog: 0,0:08:53.94,0:08:57.48,teks umum,,0,0,0,,Dari mana asal anggur di ruang latihan?
Dialog: 0,0:08:57.57,0:08:58.82,teks umum,,0,0,0,,Saya melihat
Dialog: 0,0:08:59.82,0:09:02.11,teks umum,,0,0,0,,Saya melihat Anda memasukkannya ke dalam diri Anda sendiri
Dialog: 0,0:09:02.70,0:09:05.53,teks umum,,0,0,0,,Ayo. Anggur yang kamu minum saat kamu kesepian
Dialog: 0,0:09:06.12,0:09:08.54,teks umum,,0,0,0,,- Aku tidak sendirian!\N- Benar
Dialog: 0,0:09:10.87,0:09:11.83,miring,,0,0,0,,Saya sepenuhnya...
Dialog: 0,0:09:11.91,0:09:13.12,teks umum,,0,0,0,,Kepala sakit
Dialog: 0,0:09:14.00,0:09:15.04,teks umum,,0,0,0,,Ini karena...
Dialogue: 0,0:09:15.13,0:09:16.71,teks umum,,0,0,0,,Apa judulnya?
Dialog: 0,0:09:16.79,0:09:18.30,teks umum,,0,0,0,,Tepat. susah tidur
Dialog: 0,0:09:18.92,0:09:20.71,teks umum,,0,0,0,,Aku menderita insomnia parah
Dialog: 0,0:09:22.97,0:09:24.68,teks umum,,0,0,0,,Saya minum anggur untuk insomnia
Dialog: 0,0:09:30.89,0:09:34.48,miring,,0,0,0,,Kesepian membuatmu tidak bisa tidur
Dialogue: 0,0:09:34.56,0:09:36.86,teks umum,,0,0,0,,Kamu seharusnya menikah di masa mudamu
Dialog: 0,0:09:37.65,0:09:42.57,teks umum,,0,0,0,,Apakah kamu sudah melupakan Do Hwa? Sangat kesepian?
Dialog: 0,0:09:54.33,0:09:55.42,teks umum,,0,0,0,,Kosong
Dialog: 0,0:09:56.29,0:09:57.46,teks umum,,0,0,0,,- Apa?\N- Kamu meminum semuanya
Dialog: 0,0:09:58.88,0:10:01.25,teks umum,,0,0,0,,Tidak mungkin. Apa?
Dialog: 0,0:10:05.34,0:10:06.51,teks umum,,0,0,0,,Apa...
Dialog: 0,0:10:06.59,0:10:09.22,teks umum,,0,0,0,,Menurutku kamu sangat kesepian
Dialog: 0,0:10:09.30,0:10:12.35,teks umum,,0,0,0,,Saya hanya minum satu gelas ketika saya tidak bisa tidur
Dialog: 0,0:10:12.97,0:10:14.56,teks umum,,0,0,0,,Hanya satu gelas setiap kali...
Dialog: 0,0:10:21.32,0:10:24.78,teks umum,,0,0,0,,Ini adalah anggur yang disembunyikan pamanku di tempatnya
Dialog: 0,0:10:24.86,0:10:26.49,teks umum,,0,0,0,,Rasanya enak
Dialog: 0,0:10:27.24,0:10:30.70,teks umum,,0,0,0,,Akhirnya, impian seumur hidup Uka menjadi kenyataan
Dialog: 0,0:10:30.78,0:10:32.04,teks umum,,0,0,0,,Mari kita rayakan
Dialog: 0,0:10:32.54,0:10:34.20,teks umum,,0,0,0,,Gadis itu, Mu Dok...
Dialogue: 0,0:10:34.29,0:10:36.33,teks umum,,0,0,0,,Dia baru saja membawanya dari rumah gisaeng, kan?
Dialog: 0,0:10:38.13,0:10:41.34,teks umum,,0,0,0,,Dia mempertaruhkan nyawanya demi dia, meskipun faktanya mereka baru saja bertemu
Dialog: 0,0:10:43.59,0:10:44.63,teks umum,,0,0,0,,Ini aneh
Dialog: 0,0:10:44.71,0:10:47.55,teks umum,,0,0,0,,Uk menyelamatkannya dari nasib menjadi kisaeng
Dialog: 0,0:10:47.63,0:10:50.93,teks umum,,0,0,0,,Dia tidak terlalu menginginkannya sehingga dia berpura-pura buta
Dialog: 0,0:10:51.01,0:10:52.68,teks umum,,0,0,0,,Minum
Dialog: 0,0:10:52.76,0:10:53.97,teks umum,,0,0,0,,"Buta"?
Dialog: 0,0:10:54.64,0:10:58.10,teks umum,,0,0,0,,Ya. Menurut Joo Wol, dia buta saat tiba,
Dialog: 0,0:10:58.19,0:11:00.06,teks umum,,0,0,0,,dan begitu aku pergi dari sana, aku langsung melihat cahaya
Dialogue: 0,0:11:00.15,0:11:02.07,teks umum,,0,0,0,,Anggurnya enak sekali
Dialog: 0,0:11:03.94,0:11:05.36,teks umum,,0,0,0,,Dia dengan mudah menipu orang
Dialog: 0,0:11:06.40,0:11:09.61,teks umum,,0,0,0,,Berbohong bahwa dia buta dan Uka diracun
Dialog: 0,0:11:10.95,0:11:13.24,teks umum,,0,0,0,,Diam, meski disiksa
Dialog: 0,0:11:13.79,0:11:15.45,miring,,0,0,0,,Ada yang lebih dari yang terlihat pada dirinya
Dialog: 0,0:11:15.54,0:11:18.08,teks umum,,0,0,0,,Dari luar, dia adalah gadis yang manis dan naif
Dialog: 0,0:11:18.17,0:11:20.42,teks umum,,0,0,0,,Tapi dia jelas menyembunyikan sesuatu
Dialog: 0,0:11:27.17,0:11:29.80,teks umum,,0,0,0,,- Kamu meminum semuanya\N- Apa? Apa yang kamu bicarakan?
Dialog: 0,0:11:31.18,0:11:33.56,teks umum,,0,0,0,,Pamanmu datang ke sini
Dialog: 0,0:11:33.64,0:11:35.14,teks umum,,0,0,0,,Saya pikir Anda sudah ditakdirkan
Dialog: 0,0:11:36.22,0:11:38.77,teks umum,,0,0,0,,- Aku tidak minum apa pun\N- Tunggu, Yul
Dialog: 0,0:11:38.85,0:11:39.94,teks umum,,0,0,0,,Yul!
Dialog: 0,0:11:42.69,0:11:44.07,teks umum,,0,0,0,,- Ibu\N- Dan Gu
Dialog: 0,0:11:46.15,0:11:47.49,teks umum,,0,0,0,,Aku sudah selesai
Dialog: 0,0:11:49.40,0:11:50.53,teks umum,,0,0,0,,Park Dan Gu
Dialog: 0,0:11:52.49,0:11:53.62,teks umum,,0,0,0,,Apakah itu kamu?
Dialog: 0,0:11:54.33,0:11:55.24,teks umum,,0,0,0,,Tidak
Dialog: 0,0:12:00.54,0:12:01.92,teks umum,,0,0,0,,Kemarilah
Dialog: 0,0:12:02.67,0:12:04.54,teks umum,,0,0,0,,- Dan Gu\N- Ya, paman?
Dialog: 0,0:12:14.18,0:12:15.56,teks umum,,0,0,0,,Apakah dia bernapas?
Dialog: 0,0:12:21.60,0:12:22.73,teks umum,,0,0,0,,Bangun
Dialog: 0,0:12:23.52,0:12:25.90,teks umum,,0,0,0,,Kamu tidak sadar, kukira kamu akan mati
Dialogue: 0,0:12:32.82,0:12:34.07,teks umum,,0,0,0,,Sakit?
Dialogue: 0,0:12:35.12,0:12:37.24,teks umum,,0,0,0,,Sepertinya tulangku patah
Dialog: 0,0:12:37.83,0:12:39.08,teks umum,,0,0,0,,Tidak ada yang rusak
Dialog: 0,0:12:40.12,0:12:41.71,teks umum,,0,0,0,,- Benarkah?\N- Ya
Dialogue: 0,0:12:42.25,0:12:44.63,teks umum,,0,0,0,,Lalu kenapa begitu menyakitkan?
Dialog: 0,0:12:44.71,0:12:46.21,teks umum,,0,0,0,,Tubuh tak berguna
Dialog: 0,0:12:48.09,0:12:49.21,teks umum,,0,0,0,,Hei
Dialogue: 0,0:12:51.30,0:12:53.18,teks umum,,0,0,0,,Kenapa kamu bilang kamu meracuniku?
Dialog: 0,0:12:54.30,0:12:56.64,teks umum,,0,0,0,,Jika kamu berpura-pura tidak tahu apa-apa,
Dialog: 0,0:12:56.72,0:12:58.47,teks umum,,0,0,0,,kamu tidak akan tersiksa
Dialog: 0,0:13:00.02,0:13:02.39,teks umum,,0,0,0,,Agar mereka percaya bahwa kamu sedang sekarat
Dialog: 0,0:13:02.94,0:13:05.52,teks umum,,0,0,0,,Jika tidak, mereka tidak akan membukakan gerbangmu
Dialog: 0,0:13:06.19,0:13:08.02,teks umum,,0,0,0,,Ayo buat penawarnya
Dialog: 0,0:13:09.57,0:13:11.61,teks umum,,0,0,0,,Jadi kamu benar-benar mempertaruhkan nyawamu
Dialog: 0,0:13:14.86,0:13:17.49,teks umum,,0,0,0,,Kupikir mereka akan memotong lengan atau kakiku
Dialog: 0,0:13:18.28,0:13:19.95,teks umum,,0,0,0,,Tapi aku baik-baik saja
Dialog: 0,0:13:20.04,0:13:22.46,teks umum,,0,0,0,,Orang Sosnovy Bor terlalu baik
Dialog: 0,0:13:22.54,0:13:24.33,teks umum,,0,0,0,,Jika mereka menyiksa orang seperti itu...
Dialogue: 0,0:13:27.34,0:13:28.42,teks umum,,0,0,0,,Dan kamu...
Dialog: 0,0:13:29.25,0:13:31.72,teks umum,,0,0,0,,Kamu terlihat agak sakit-sakitan
Dialog: 0,0:13:32.22,0:13:33.55,teks umum,,0,0,0,,Mengapa kamu ada di sini?
Dialog: 0,0:13:34.80,0:13:37.10,teks umum,,0,0,0,,Tentu saja, untuk menjagamu
Dialog: 0,0:13:37.97,0:13:40.18,teks umum,,0,0,0,,Semua siswa di sini adalah penyihir
Dialog: 0,0:13:40.27,0:13:41.85,teks umum,,0,0,0,,Mereka seharusnya tidak tahu tentangmu
Dialog: 0,0:13:42.43,0:13:46.02,teks umum,,0,0,0,,Jadi aku menutup pintu sementara tidak ada yang melihat,
Dialog: 0,0:13:46.10,0:13:49.61,teks umum,,0,0,0,,mengganti pakaianmu, mengoleskan salep pada lukamu
Dialog: 0,0:13:49.69,0:13:52.19,teks umum,,0,0,0,,Bahkan melakukan pijatan saat kamu kehilangan kesadaran
Dialog: 0,0:13:53.45,0:13:55.74,teks umum,,0,0,0,,- Benarkah?\N- Ya
Dialog: 0,0:14:00.16,0:14:03.96,teks umum,,0,0,0,,Kau hanya bisa membiarkanku begitu dekat denganmu
Dialog: 0,0:14:35.07,0:14:36.32,teks umum,,0,0,0,,Sepanjang hidupku
Dialog: 0,0:14:37.20,0:14:40.08,teks umum,,0,0,0,,tidak ada yang mengerti betapa putus asanya aku
Dialog: 0,0:14:42.95,0:14:44.91,teks umum,,0,0,0,,Dan tak seorang pun mempertaruhkan nyawanya demi aku,
Dialog: 0,0:14:46.08,0:14:47.42,teks umum,,0,0,0,,kecuali kamu
Dialog: 0,0:15:00.76,0:15:03.93,teks umum,,0,0,0,,Karena aku selamat, seperti yang dijanjikan,
Dialog: 0,0:15:04.02,0:15:06.18,teks umum,,0,0,0,,Saya akan memperlakukan Anda seperti seorang master
Dialog: 0,0:15:14.32,0:15:16.74,teks umum,,0,0,0,,Saya sudah mengganti 12 master
Dialog: 0,0:15:17.45,0:15:20.74,teks umum,,0,0,0,,Semua orang mengira guru meninggalkanku, tapi akulah yang pergi
Dialog: 0,0:15:23.12,0:15:25.87,teks umum,,0,0,0,,Dan sekarang aku telah menemukan guru sejati
Dialog: 0,0:15:26.45,0:15:28.87,teks umum,,0,0,0,,Jadi aku harus berlutut
Dialog: 0,0:15:28.96,0:15:31.21,teks umum,,0,0,0,,dan bersumpah bahwa aku akan selalu memperlakukanmu seperti seorang guru
Dialog: 0,0:15:33.34,0:15:34.71,teks umum,,0,0,0,,Dalam satu kondisi
Dialog: 0,0:15:37.42,0:15:40.01,teks umum,,0,0,0,,Jangan beri tahu siapa pun tentang hubungan kita
Dialog: 0,0:15:41.01,0:15:42.97,teks umum,,0,0,0,,Kamu akan tetap menjadi tuanku,
Dialog: 0,0:15:44.26,0:15:46.22,teks umum,,0,0,0,,dan aku adalah pelayanmu
Dialog: 0,0:15:49.81,0:15:50.90,teks umum,,0,0,0,,Dan juga,
Dialog: 0,0:15:51.65,0:15:55.73,teks umum,,0,0,0,,hubungan master-murid kita akan bertahan sampai kamu menjadi yang terbaik
Dialog: 0,0:15:55.82,0:15:58.19,teks umum,,0,0,0,,dan bantu aku mendapatkan energiku kembali
Dialog: 0,0:16:00.28,0:16:01.53,teks umum,,0,0,0,,Sampai saat itu
Dialog: 0,0:16:03.03,0:16:05.99,teks umum,,0,0,0,,Saat aku mendapatkan kekuatanku kembali dan menjadi Nak Su,
Dialog: 0,0:16:08.00,0:16:10.54,teks umum,,0,0,0,,kita tidak akan menjadi master dan murid
Dialog: 0,0:16:11.58,0:16:13.42,teks umum,,0,0,0,,Mengapa demikian?
Dialog: 0,0:16:16.84,0:16:18.09,teks umum,,0,0,0,,Lalu
Dialog: 0,0:16:19.09,0:16:21.47,teks umum,,0,0,0,,kamu tidak perlu melindungiku lagi,
Dialogue: 0,0:16:22.51,0:16:24.35,teks umum,,0,0,0,,dan aku tidak perlu seperti itu
Dialog: 0,0:16:27.64,0:16:29.06,teks umum,,0,0,0,,lembut bersamamu
Dialog: 0,0:16:38.07,0:16:40.70,teks umum,,0,0,0,,Apakah kamu ingin meninggalkanku setelah semuanya selesai?
Dialog: 0,0:16:41.36,0:16:42.41,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:16:45.33,0:16:46.41,teks umum,,0,0,0,,Oke
Dialog: 0,0:16:47.04,0:16:49.87,teks umum,,0,0,0,,Tinggalkan aku saat kamu tidak lagi membutuhkanku
Dialog: 0,0:16:49.95,0:16:52.58,teks umum,,0,0,0,,Kalau begitu aku akan menghormati keputusanmu dan melepaskanmu
Dialog: 0,0:16:59.09,0:17:01.55,teks umum,,0,0,0,,Dan sekarang berlutut di hadapan sang master
Dialog: 0,0:17:08.77,0:17:10.10,teks umum,,0,0,0,,Saya, Chan Wook, muridmu,
Dialog: 0,0:17:10.81,0:17:13.69,teks umum,,0,0,0,,Aku akan mengabdi dan melindungi tuanku Mu Dok
Dialog: 0,0:18:33.39,0:18:35.52,teks umum,,0,0,0,,Kamu telah mengembalikan penampilanmu
Dialog: 0,0:18:43.15,0:18:45.40,teks umum,,0,0,0,,Kamu tidak akan menjadi liar untuk sementara waktu
Dialogue: 0,0:18:45.95,0:18:49.28,teks umum,,0,0,0,,Lalu kita bertemu di istana
Dialog: 0,0:18:58.46,0:19:01.04,teks umum,,0,0,0,,Memberi makan jiwa yang menelan dengan jiwa manusia,
Dialog : 0,0:19:01.13,0:19:03.13,teks umum,,0,0,0,,supaya bermanfaat
Dialog: 0,0:19:05.30,0:19:08.22,teks umum,,0,0,0,,Kau membunuh gisaeng yang tubuhnya ditinggali Nak Soo
Dialog: 0,0:19:08.30,0:19:10.76,teks umum,,0,0,0,,Ya. Kami membuang mayatnya di Danau Gyeongjeongdaeho
Dialogue: 0,0:19:10.85,0:19:12.85,teks umum,,0,0,0,,Sudah dicentang tanda birunya?
Dialog: 0,0:19:18.23,0:19:19.77,kenangan,,0,0,0,,Tanpa tag
Dialog: 0,0:19:21.15,0:19:22.57,kenangan,,0,0,0,,Ini bukan Nak Soo
Dialog: 0,0:19:24.53,0:19:26.69,teks umum,,0,0,0,,Ya, dicentang
Dialog: 0,0:19:26.78,0:19:30.24,teks umum,,0,0,0,,Nak Su yang aku tahu tidak akan kalah darimu,
Dialog: 0,0:19:30.91,0:19:33.62,teks umum,,0,0,0,,tapi sepertinya kehilangan kekuatannya
Dialog: 0,0:19:34.16,0:19:37.46,teks umum,,0,0,0,,Bisakah pengembara kehilangan kekuatan?
Dialog: 0,0:19:38.58,0:19:39.87,teks umum,,0,0,0,,Jika jiwa kuat
Dialog: 0,0:19:39.96,0:19:44.42,teks umum,,0,0,0,,jatuh ke tubuh yang salah dan tidak dapat mengakses kekuatannya
Dialog: 0,0:19:44.50,0:19:46.26,teks umum,,0,0,0,,Pernahkah kamu melihat ini sebelumnya?
Dialog: 0,0:19:55.26,0:19:56.43,kenangan,,0,0,0,,Yang Mulia,
Dialog: 0,0:19:56.52,0:19:58.27,kenangan,,0,0,0,,Saya Jin Mu, murid Guru Chan
Dialogue: 0,0:19:58.35,0:20:00.19,kenangan,,0,0,0,,Dengar kau bertanya padaku
Dialog: 0,0:20:10.57,0:20:11.57,kenangan,,0,0,0,,Jin Mu
Dialog: 0,0:20:12.49,0:20:13.57,kenangan,,0,0,0,,Ya
Dialog: 0,0:20:13.66,0:20:16.79,kenangan,,0,0,0,,Aku bukan raja. Ini aku, Chang Gang
Dialog: 0,0:20:17.50,0:20:20.29,kenangan,,0,0,0,,Jiwa raja kini ada di tubuhku
Dialogue: 0,0:20:30.38,0:20:33.01,kenangan,,0,0,0,,Guru, apakah itu anda?
Dialog: 0,0:20:33.09,0:20:36.56,kenangan,,0,0,0,,Ya, raja dan aku bertukar tubuh
Dialog: 0,0:20:37.18,0:20:39.02,kenangan,,0,0,0,,Lalu dimana Yang Mulia?
Dialog: 0,0:20:39.10,0:20:40.89,kenangan,,0,0,0,,Jiwanya ada di tubuhku
Dialog: 0,0:20:41.48,0:20:43.56,kenangan,,0,0,0,,Aku harus mendapatkan tubuhku kembali
Dialog: 0,0:20:44.15,0:20:46.65,kenangan,,0,0,0,,Tapi aku tidak bisa menggunakan kekuatanku
Dialog: 0,0:20:46.73,0:20:49.49,kenangan,,0,0,0,,aku butuh bantuanmu
Dialog: 0,0:20:51.20,0:20:52.28,kenangan,,0,0,0,,Guru
Dialog: 0,0:20:52.82,0:20:55.74,kenangan,,0,0,0,,Aku tidak tahu cara kerja alkimia jiwa
Dialog: 0,0:20:56.58,0:21:00.58,kenangan,,0,0,0,,Pergi ke aula rahasia Jeonbugwan dan kembalikan Reflektor Jiwa
Dialog: 0,0:21:01.08,0:21:04.21,kenangan,,0,0,0,,Aku akan mengajarimu alkimia jiwa
Dialog: 0,0:21:06.92,0:21:10.01,di luar layar,,0,0,0,,Dia tidak bisa mendapatkan kembali kekuatannya karena tubuhnya yang lemah,
Dialog: 0,0:21:10.09,0:21:12.09,di belakang layar,,0,0,0,,jadi aku mendapat kesempatan
Dialog: 0,0:21:13.55,0:21:15.05,di belakang layar,,0,0,0,,aku beruntung
Dialog: 0,0:21:17.47,0:21:19.47,teks umum,,0,0,0,,Bakar semua mayat ini
Dialog: 0,0:21:38.28,0:21:43.12,teks umum,,0,0,0,,Cari rumah kisaeng tempat wanita yang dibunuh itu bekerja
Dialog: 0,0:21:43.71,0:21:46.13,teks umum,,0,0,0,,Cari pemilik jimat roh
Dialog: 0,0:21:47.21,0:21:48.71,teks umum,,0,0,0,,Yang penting tidak kentara
Dialog: 0,0:21:49.34,0:21:50.38,teks umum,,0,0,0,,Ya
Dialog: 0,0:22:05.14,0:22:06.48,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:22:08.56,0:22:09.57,teks umum,,0,0,0,,Dingin
Dialog: 0,0:22:10.27,0:22:12.24,teks umum,,0,0,0,,Airnya benar-benar sedingin es
Dialog: 0,0:22:12.32,0:22:15.07,teks umum,,0,0,0,,Tentu saja dingin. Mengapa kamu duduk di sana?
Dialog: 0,0:22:17.57,0:22:20.08,teks umum,,0,0,0,,Untuk pertama kalinya aku merasa kedinginan
Dialog: 0,0:22:20.74,0:22:23.91,teks umum,,0,0,0,,Dulu aku kehilangan kesadaran karena gerbang energi tertutup
Dialog: 0,0:22:24.00,0:22:26.21,teks umum,,0,0,0,,Dan sekarang, meski gemetar, aku bisa berdiri
Dialog: 0,0:22:26.29,0:22:28.96,teks umum,,0,0,0,,Jadi gerbangku memang terbuka
Dialog: 0,0:22:29.04,0:22:31.46,teks umum,,0,0,0,,Jika kamu menguasai mantranya, cuaca tidak akan dingin bahkan di atas es
Dialog: 0,0:22:31.55,0:22:33.01,teks umum,,0,0,0,,Dan apinya tidak akan menyala
Dialogue: 0,0:22:33.71,0:22:35.97,teks umum,,0,0,0,,Seperti apa dirimu sebelum mengubah tubuhmu?
Dialog: 0,0:22:36.05,0:22:38.47,teks umum,,0,0,0,,Ada banyak rumor tentangmu
Dialog: 0,0:22:39.26,0:22:40.56,teks umum,,0,0,0,,Tapi aku belum pernah melihatmu
Dialog: 0,0:22:40.64,0:22:42.93,teks umum,,0,0,0,,Kudengar kamu kuat
Dialog: 0,0:22:44.35,0:22:48.73,teks umum,,0,0,0,,Tidak hanya kuat, tapi sangat kuat
Dialog: 0,0:22:49.40,0:22:51.02,teks umum,,0,0,0,,"Sangat"? Saya mengerti
Dialogue: 0,0:22:51.11,0:22:54.65,teks umum,,0,0,0,,Untuk menjadi pesulap terbaik, kamu harus melalui beberapa tahapan
Dialog: 0,0:22:56.74,0:22:59.32,teks umum,,0,0,0,,Pertama ke Chipsu, kemampuan menggunakan energi air
Dialog: 0,0:23:05.16,0:23:08.17,teks umum,,0,0,0,,Langkah kedua - Ryusu, kemampuan mengendalikan energi aliran air
Dialog: 0,0:23:09.75,0:23:11.71,teks umum,,0,0,0,,Kemudian Chisu - pengendalian energi air
Dialog: 0,0:23:14.09,0:23:15.21,teks umum,,0,0,0,,di atmosfer
Dialog: 0,0:23:15.92,0:23:19.39,teks umum,,0,0,0,,Saya telah menguasai ketiga tahap
Dialog: 0,0:23:19.47,0:23:22.14,teks umum,,0,0,0,,Hanya sedikit orang di Deho yang mampu melakukan ini
Dialog: 0,0:23:22.72,0:23:25.93,teks umum,,0,0,0,,Guru, Anda sesuai dengan nama Anda
Dialog: 0,0:23:26.68,0:23:27.73,teks umum,,0,0,0,,Ya
Dialog: 0,0:23:28.52,0:23:30.77,teks umum,,0,0,0,,Aku bergerak tanpa suara, seperti bayangan,
Dialog: 0,0:23:31.48,0:23:35.44,teks umum,,0,0,0,,dan kepala musuhku jatuh ke tanah saat aku lewat
Dialog: 0,0:23:36.15,0:23:37.70,teks umum,,0,0,0,,Saya adalah Nak Su,
Dialog: 0,0:23:38.95,0:23:40.53,teks umum,,0,0,0,,prajurit bayangan
Dialog: 0,0:23:53.42,0:23:55.42,teks umum,,0,0,0,,Aku berjalan di atas air seolah-olah aku sedang terbang
Dialog: 0,0:23:56.38,0:23:58.72,teks umum,,0,0,0,,Kemana aku pergi - angin bertiup
Dialog: 0,0:24:16.32,0:24:19.86,teks umum,,0,0,0,,Dan aku akan melakukan ini - hujan turun
Dialog: 0,0:24:23.74,0:24:27.45,teks umum,,0,0,0,,Saya Nak Su, pesulap terbaik di dunia,
Dialog: 0,0:24:28.04,0:24:31.04,teks umum,,0,0,0,,yang dapat menciptakan salju dan hujan
Dialog: 0,0:24:35.09,0:24:36.42,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:24:38.59,0:24:40.05,teks umum,,0,0,0,,Hanya beberapa gerakan,
Dialog: 0,0:24:40.88,0:24:43.93,teks umum,,0,0,0,,dan paru-paruku siap meledak
Dialog: 0,0:24:48.81,0:24:49.73,teks umum,,0,0,0,,Apa itu?
Dialogue: 0,0:24:49.81,0:24:51.89,teks umum,,0,0,0,,Kakiku kram!
Dialog: 0,0:24:51.98,0:24:52.94,teks umum,,0,0,0,,Kejang?
Dialog: 0,0:24:53.02,0:24:56.23,teks umum,,0,0,0,,Kaki ini pendek, kurus, lemah dan tidak tahan dingin
Dialog: 0,0:24:57.02,0:24:58.86,teks umum,,0,0,0,,Tubuh tak berguna
Dialog: 0,0:25:00.90,0:25:04.74,teks umum,,0,0,0,,Hati-hati. Kamu bukan lagi Nak Soo, sang pejuang bayangan.
Dialog: 0,0:25:04.82,0:25:06.87,teks umum,,0,0,0,,Kamu adalah Mu Dok, pembantuku
Dialog: 0,0:25:06.95,0:25:10.08,teks umum,,0,0,0,,Jangan melompat-lompat seperti sekarang
Dialogue: 0,0:25:10.75,0:25:11.75,teks umum,,0,0,0,,Kau akan terluka
Dialog: 0,0:25:13.12,0:25:14.67,teks umum,,0,0,0,,Aku merasa tidak berarti
Dialog: 0,0:25:18.63,0:25:20.76,teks umum,,0,0,0,,Jangan sedih. Anda memiliki saya
Dialog: 0,0:25:20.84,0:25:23.80,teks umum,,0,0,0,,Ayo mulai latihan, gerbangku terbuka
Dialog: 0,0:25:23.88,0:25:26.14,teks umum,,0,0,0,,Tapi pertama-tama, kenakan sepatumu. Ini dingin
Dialog: 0,0:25:41.28,0:25:42.65,teks umum,,0,0,0,,Untuk apa?
Dialog: 0,0:25:43.24,0:25:44.53,teks umum,,0,0,0,,Tidak ada ketangkasan
Dialog: 0,0:25:45.91,0:25:46.74,teks umum,,0,0,0,,Pilih
Dialog: 0,0:25:50.16,0:25:51.29,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:25:52.29,0:25:55.71,teks umum,,0,0,0,,Mari kita lihat seberapa bagus muridku, maka aku akan melupakan kesedihan
Dialog: 0,0:25:55.79,0:25:56.96,teks umum,,0,0,0,,Apa?
Dialog: 0,0:26:10.35,0:26:11.64,teks umum,,0,0,0,,Mengapa mengalahkan?
Dialog: 0,0:26:11.72,0:26:13.73,teks umum,,0,0,0,,Kamu tidak menggunakan pedang
Dialog: 0,0:26:14.23,0:26:15.31,teks umum,,0,0,0,,Tunjukkan padaku bagaimana kamu bertarung
Dialog: 0,0:26:31.66,0:26:32.66,teks umum,,0,0,0,,Ini sedikit...
Dialog: 0,0:26:33.25,0:26:34.29,teks umum,,0,0,0,,Sakit!
Dialog: 0,0:26:46.80,0:26:48.34,teks umum,,0,0,0,,Pertarunganmu juga buruk
Dialogue: 0,0:26:50.05,0:26:52.56,teks umum,,0,0,0,,Kamu lebih buruk dari perkiraanku
Dialog: 0,0:26:52.64,0:26:55.48,teks umum,,0,0,0,,Saya tidak pernah benar-benar belajar!
Dialogue: 0,0:26:59.65,0:27:01.61,teks umum,,0,0,0,,Kamu mempunyai 12 guru
Dialog: 0,0:27:02.23,0:27:04.69,teks umum,,0,0,0,,Kamu belum belajar cara merapal mantra,
Dialog: 0,0:27:04.78,0:27:08.16,teks umum,,0,0,0,,tapi bisa menguasai seni bela diri
Dialogue: 0,0:27:08.24,0:27:10.41,teks umum,,0,0,0,,Aku tak berminat melakukannya
Dialog: 0,0:27:10.49,0:27:11.49,teks umum,,0,0,0,,Seperti yang Anda ketahui,
Dialog: 0,0:27:11.58,0:27:13.83,teks umum,,0,0,0,,Saya perlu bersiap untuk melakukan sesuatu
Dialog: 0,0:27:14.66,0:27:15.83,teks umum,,0,0,0,,Kamu hanya malas
Dialog: 0,0:27:16.33,0:27:20.08,teks umum,,0,0,0,,Saya perhatikan kamu tidak melakukan apa pun di rumah
Dialog: 0,0:27:20.17,0:27:22.29,teks umum,,0,0,0,,Ya, saya hafal semuanya. Periksa
Dialog: 0,0:27:22.38,0:27:24.00,teks umum,,0,0,0,,Menurutmu aku mengenalimu?
Dialog: 0,0:27:24.09,0:27:26.59,teks umum,,0,0,0,,Saya menyadari bahwa Anda menggunakan gaya Tansu
Dialog: 0,0:27:27.09,0:27:28.34,teks umum,,0,0,0,,Hanya obrolan
Dialog: 0,0:27:28.43,0:27:29.93,teks umum,,0,0,0,,Saya bisa melakukan lebih dari sekedar ngobrol
Dialog: 0,0:27:32.76,0:27:34.64,teks umum,,0,0,0,,Apakah kamu melihatnya?
Dialog: 0,0:27:34.72,0:27:36.35,teks umum,,0,0,0,,Saya pembelajar yang cepat
Dialog: 0,0:27:36.43,0:27:39.31,teks umum,,0,0,0,,Saya akan segera menguasai Chipsa. Berapa lama?
Dialog: 0,0:27:39.40,0:27:41.52,teks umum,,0,0,0,,Saya juga belajar dengan cepat, tapi butuh waktu lima tahun
Dialog: 0,0:27:41.61,0:27:43.40,teks umum,,0,0,0,,Dan untuk lainnya - 20 tahun
Dialogue: 0,0:27:43.48,0:27:44.61,teks umum,,0,0,0,,Dan kamu...
Dialogue: 0,0:27:46.15,0:27:48.11,teks umum,,0,0,0,,Mungkin kamu akan menguasainya lebih cepat lagi,
Dialog: 0,0:27:48.78,0:27:50.16,teks umum,,0,0,0,,karena kamu adalah putra Chang Gan
Dialogue: 0,0:27:51.20,0:27:53.12,teks umum,,0,0,0,,Di sisi manakah dia di sini?
Dialog: 0,0:27:53.20,0:27:56.08,teks umum,,0,0,0,,Dia jenius yang menguasai Chips dalam setahun
Dialog: 0,0:27:56.79,0:27:58.08,teks umum,,0,0,0,,Kamu akan menguasai Chips dalam setahun,
Dialog: 0,0:27:58.16,0:28:00.75,teks umum,,0,0,0,,rumor bahwa kamu bukan anaknya akan mereda
Dialog: 0,0:28:00.83,0:28:02.96,teks umum,,0,0,0,,Tapi, tentu saja, ini hampir tidak mungkin
Dialogue: 0,0:28:03.46,0:28:05.63,teks umum,,0,0,0,,Jika butuh waktu setahun, aku akan menguasainya dalam enam bulan
Dialog: 0,0:28:05.71,0:28:07.59,teks umum,,0,0,0,,Tidak, dalam tiga bulan
Dialog: 0,0:28:08.17,0:28:09.01,teks umum,,0,0,0,,Berbicara lagi
Dialog: 0,0:28:09.09,0:28:12.01,teks umum,,0,0,0,,Aku bertekad, jangan menjatuhkanku
Dialog: 0,0:28:15.93,0:28:18.18,teks umum,,0,0,0,,Pembantu Kim menyuruhku menyapu seluruh halaman
Dialog: 0,0:28:18.68,0:28:20.19,teks umum,,0,0,0,,Kamu menjadi lebih baik,
Dialog: 0,0:28:20.27,0:28:23.19,teks umum,,0,0,0,,dan kamu baik-baik saja, jadi bantu aku
Dialog: 0,0:28:26.15,0:28:27.03,teks umum,,0,0,0,,Apa...
Dialog: 0,0:28:28.82,0:28:30.11,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:28:30.20,0:28:34.58,teks umum,,0,0,0,,Saya orang malas yang tidak melakukan apa pun tanpa sikap yang pantas
Dialog: 0,0:28:36.45,0:28:37.58,teks umum,,0,0,0,,Semoga berhasil
Dialog: 0,0:28:38.83,0:28:39.91,teks umum,,0,0,0,,Bajingan...
Dialog: 0,0:28:40.00,0:28:42.08,teks umum,,0,0,0,,- Wow...\N- Keren sekali
Dialog: 0,0:28:42.17,0:28:44.50,teks umum,,0,0,0,,Orang pemalas tak berguna!
Dialog: 0,0:28:44.59,0:28:47.80,teks umum,,0,0,0,,Keren sekali, bahkan dingin
Dialog: 0,0:28:52.13,0:28:57.06,miring,,0,0,0,,Tuan Ho membuatkan obat untuk Uka
Dialog: 0,0:28:57.60,0:28:59.18,teks umum,,0,0,0,,Ternyata sangat efektif
Dialog: 0,0:28:59.27,0:29:03.06,teks umum,,0,0,0,,Terutama saat gerbangnya terbuka
Dialog: 0,0:29:04.19,0:29:08.40,teks umum,,0,0,0,,Hamba Kim, sepertinya kamu sangat senang
Dialog: 0,0:29:09.94,0:29:13.28,teks umum,,0,0,0,,Apakah kamu begitu kesal karena gerbangnya terbuka?
Dialog: 0,0:29:15.12,0:29:18.24,teks umum,,0,0,0,,Kamu tidak melakukan apa pun, bahkan ketika dia sedang sekarat
Dialog: 0,0:29:19.33,0:29:23.12,teks umum,,0,0,0,,Jika bukan karena Tuan Huo, tuan muda bisa saja mati
Dialog: 0,0:29:23.21,0:29:27.04,teks umum,,0,0,0,,Dia harus menemukan cara untuk menyelamatkannya tanpa membuka gerbang
Dialog: 0,0:29:27.13,0:29:28.38,teks umum,,0,0,0,,Betapa berbahayanya kamu
Dialog: 0,0:29:29.17,0:29:32.05,teks umum,,0,0,0,,Kamu selalu menjaga jarak dari tuan muda
Dialog: 0,0:29:32.13,0:29:33.13,teks umum,,0,0,0,,Ini...
Dialog: 0,0:29:34.22,0:29:35.47,teks umum,,0,0,0,,karena rumor?
Dialog: 0,0:29:41.43,0:29:43.39,teks umum,,0,0,0,,Rumor apa?
Dialog: 0,0:29:43.48,0:29:44.73,teks umum,,0,0,0,,Jangan pura-pura tidak tahu
Dialog: 0,0:29:45.52,0:29:47.52,teks umum,,0,0,0,,Kamu tahu kalau ada rumor,
Dialog: 0,0:29:47.61,0:29:50.90,teks umum,,0,0,0,,bahwa kamu adalah ayah dari Tuan Chan
Dialog: 0,0:29:52.36,0:29:54.95,teks umum,,0,0,0,,Jangan berani-berani menyebutkan
Dialog: 0,0:29:56.74,0:29:58.78,teks umum,,0,0,0,,rumor yang tidak masuk akal!
Dialog: 0,0:29:59.70,0:30:01.50,teks umum,,0,0,0,,Itu tidak terlalu absurd
Dialog: 0,0:30:01.58,0:30:04.71,teks umum,,0,0,0,,Jujur saja, kita berdua tahu
Dialog: 0,0:30:04.79,0:30:07.63,teks umum,,0,0,0,,bahwa kamu mencintai Nyonya Do Hwa sebelum menikah
Dialog: 0,0:30:08.21,0:30:11.92,teks umum,,0,0,0,,Kamu menulis puisinya dan memberinya hadiah
Dialog: 0,0:30:12.01,0:30:13.17,teks umum,,0,0,0,,Saya adalah saksi hidup
Dialog: 0,0:30:13.92,0:30:17.22,teks umum,,0,0,0,,Mereka bilang kamu masih belum menikah karena kamu belum melupakannya
Dialogue: 0,0:30:18.10,0:30:19.56,teks umum,,0,0,0,,Bagaimana denganmu, pembantu Kim?
Dialog: 0,0:30:20.22,0:30:22.93,teks umum,,0,0,0,,Apakah kamu masih mencintai Chang Gang?
Dialog: 0,0:30:23.52,0:30:27.23,teks umum,,0,0,0,,Itulah sebabnya kamu tidak menikah dan tinggal di rumahnya?
Dialog: 0,0:30:27.86,0:30:28.69,teks umum,,0,0,0,,Apa?
Dialog: 0,0:30:28.77,0:30:32.74,teks umum,,0,0,0,,Aku tahu betapa kamu menyukainya
Dialogue: 0,0:30:34.07,0:30:36.11,teks umum,,0,0,0,,Saat dia bilang padamu dia suka acorn jelly,
Dialog: 0,0:30:36.20,0:30:37.95,teks umum,,0,0,0,,kamu naik ke puncak gunung, seperti tupai,
Dialog: 0,0:30:38.03,0:30:39.95,teks umum,,0,0,0,,- mengumpulkan biji pohon ek\N- Tupai?
Dialogue: 0,0:30:40.03,0:30:42.41,teks umum,,0,0,0,,Aku melihatmu mengumpulkan biji pohon ek
Dialog: 0,0:30:46.54,0:30:47.54,teks umum,,0,0,0,,Jadi apa?
Dialog: 0,0:30:48.58,0:30:52.84,teks umum,,0,0,0,,Apakah kamu menertawakan kenyataan bahwa aku pergi mengumpulkan biji ek?
Dialog: 0,0:30:55.13,0:30:56.30,teks umum,,0,0,0,,Ya!
Dialog: 0,0:30:56.93,0:30:59.43,teks umum,,0,0,0,,Saya akui saya pergi mengambilnya
Dialog: 0,0:31:00.01,0:31:03.85,teks umum,,0,0,0,,Aku bisa mengungkapkan perasaanku hanya dengan menyiapkan jeli ini
Dialog: 0,0:31:04.73,0:31:07.06,teks umum,,0,0,0,,Kamu boleh menertawakanku sebanyak yang kamu mau
Dialog: 0,0:31:14.40,0:31:15.49,teks umum,,0,0,0,,Saya tidak tertawa
Dialog: 0,0:31:17.45,0:31:19.62,teks umum,,0,0,0,,Saat aku melihatmu membuat jeli ini,
Dialog: 0,0:31:21.53,0:31:22.83,teks umum,,0,0,0,,Aku merasa sedih
Dialog: 0,0:31:25.37,0:31:27.08,miring,,0,0,0,,Aku tahu bagaimana rasanya,
Dialog: 0,0:31:27.71,0:31:30.79,miring,,0,0,0,,saat kamu tidak bisa berbuat apa-apa
Dialog: 0,0:31:31.54,0:31:32.80,teks umum,,0,0,0,,untuk orang yang kamu cintai
Dialog: 0,0:31:35.17,0:31:36.30,teks umum,,0,0,0,,Lainnya
Dialog: 0,0:31:36.97,0:31:39.55,teks umum,,0,0,0,,mereka bisa memfitnah kita di belakang kita
Dialog: 0,0:31:40.22,0:31:43.64,teks umum,,0,0,0,,Tapi jangan lakukan ini satu sama lain
Dialog: 0,0:31:46.23,0:31:49.56,teks umum,,0,0,0,,Ternyata cinta yang kita rasakan
Dialog: 0,0:31:50.81,0:31:53.40,miring,,0,0,0,,saat kita masih muda,
Dialog: 0,0:31:54.98,0:31:56.90,teks umum,,0,0,0,,pada akhirnya meninggalkan bekas luka di hati kita
Dialog: 0,0:32:01.87,0:32:05.29,teks umum,,0,0,0,,Aku gelisah karena Pak Chan
Dialog: 0,0:32:06.16,0:32:08.25,teks umum,,0,0,0,,dan terlalu banyak bicara
Dialog: 0,0:32:08.33,0:32:09.62,teks umum,,0,0,0,,Maafkan saya
Dialogue: 0,0:32:11.08,0:32:13.92,teks umum,,0,0,0,,Aku sangat mengkhawatirkan Uka
Dialog: 0,0:32:14.00,0:32:17.67,teks umum,,0,0,0,,Saya hanya takut dengan membuka gerbang energi,
Dialog: 0,0:32:18.67,0:32:22.30,teks umum,,0,0,0,,kita bisa menghancurkan penghalang yang melindunginya
Dialog: 0,0:32:22.39,0:32:24.47,miring,,0,0,0,,Saya merasa tidak nyaman dengan hal ini
Dialog: 0,0:32:25.56,0:32:27.98,teks umum,,0,0,0,,Saya mungkin harus menekan keinginannya
Dialog: 0,0:32:29.81,0:32:32.44,teks umum,,0,0,0,,dan berhenti di masa depan
Dialog: 0,0:32:34.90,0:32:37.28,teks umum,,0,0,0,,Saya meminta Anda untuk tidak membenci saya karena ini
Dialog: 0,0:32:39.70,0:32:40.99,teks umum,,0,0,0,,Mari kita lihat bagaimana hasilnya
Dialog: 0,0:32:48.87,0:32:51.58,teks umum,,0,0,0,,Pak, ini teh ginseng liar
Dialog: 0,0:32:52.17,0:32:53.46,miring,,0,0,0,,Minumlah
Dialog: 0,0:32:53.54,0:32:54.67,teks umum,,0,0,0,,Ginseng liar?
Dialog: 0,0:32:55.29,0:32:57.00,teks umum,,0,0,0,,Aku akan minum saat aku kembali. Tinggalkan di sini
Dialog: 0,0:32:57.09,0:32:58.26,teks umum,,0,0,0,,Kamu lagi
Dialog: 0,0:32:58.84,0:33:00.42,teks umum,,0,0,0,,apakah kamu ingin memberikannya kepada Moo Deok?
Dialog: 0,0:33:01.01,0:33:03.64,teks umum,,0,0,0,,Di luar dingin. Dia pantas mendapatkan sesuatu yang hangat dan menyenangkan
Dialogue: 0,0:33:04.47,0:33:07.01,teks umum,,0,0,0,,Mengapa kamu menyuruhnya menyapu halaman dalam cuaca dingin seperti ini?
Dialog: 0,0:33:08.35,0:33:09.39,teks umum,,0,0,0,,Dengarkan
Dialog: 0,0:33:10.31,0:33:12.60,teks umum,,0,0,0,,Pembantu ini disembuhkan secara gratis
Dialog: 0,0:33:12.69,0:33:14.61,teks umum,,0,0,0,,Jadi aku memintanya melakukan setidaknya sesuatu sebagai tanggapan
Dialog: 0,0:33:14.69,0:33:17.48,teks umum,,0,0,0,,Kenapa dia? Tidak bisakah kamu melakukannya sendiri?
Dialog: 0,0:33:18.65,0:33:21.53,teks umum,,0,0,0,,Aku perlu membuatkan obat untukmu, memasak makan malam
Dialog: 0,0:33:21.61,0:33:22.74,teks umum,,0,0,0,,dan jaga dirimu
Dialog: 0,0:33:22.82,0:33:25.28,teks umum,,0,0,0,,Moo Dok akan menjagaku. Anda tidak perlu khawatir
Dialog: 0,0:33:28.45,0:33:29.70,miring,,0,0,0,,Hapus
Dialog: 0,0:33:29.79,0:33:32.00,teks umum,,0,0,0,,Kamu hanya mengkhawatirkan Moo Deok
Dialog: 0,0:33:33.50,0:33:35.08,teks umum,,0,0,0,,Karena aku menjadi tidak berguna,
Dialog: 0,0:33:35.17,0:33:38.92,teks umum,,0,0,0,,Aku akan menyapu halaman seperti Moo Deok
Dialogue: 0,0:33:41.76,0:33:46.39,teks umum,,0,0,0,,Menurutku aku terlalu membebanimu
Dialogue: 0,0:33:46.47,0:33:49.56,teks umum,,0,0,0,,Berapa lama kamu menyeduh ginseng liar ini?
Dialog: 0,0:33:49.64,0:33:51.52,teks umum,,0,0,0,,Aku memasaknya sepanjang hari
Dialogue: 0,0:33:51.60,0:33:54.14,teks umum,,0,0,0,,Itulah yang kubicarakan. Anda bahkan tidak bisa menutup mata
Dialogue: 0,0:33:54.23,0:33:56.90,teks umum,,0,0,0,,Menurutmu bagaimana perasaanku terhadap hal ini?
Dialog: 0,0:33:58.11,0:33:59.94,teks umum,,0,0,0,,- Tidak bagus\N- Tepat sekali
Dialog: 0,0:34:00.03,0:34:03.45,teks umum,,0,0,0,,Aku tahu kamu telah melalui banyak hal karena aku
Dialog: 0,0:34:04.82,0:34:08.91,teks umum,,0,0,0,,Dan dia terlihat lelah. Anda dulu memiliki kulit porselen
Dialog: 0,0:34:09.58,0:34:11.70,miring,,0,0,0,,Kamu harus minum teh ginseng liar
Dialogue: 0,0:34:11.79,0:34:15.04,teks umum,,0,0,0,,Mungkin kamu bisa berhenti mendapat masalah?
Dialog: 0,0:34:15.12,0:34:16.96,teks umum,,0,0,0,,Saya tidak tahu harus berkata apa kepada kepala
Dialog: 0,0:34:17.54,0:34:18.96,teks umum,,0,0,0,,Saya akan menerima hukumannya
Dialog: 0,0:34:19.55,0:34:22.88,teks umum,,0,0,0,,Sekarang gerbangku terbuka, artinya aku akan menjadi bagian dari Sosnovy Bor
Dialog: 0,0:34:25.63,0:34:29.10,teks umum,,0,0,0,,Apakah kamu begitu senang karena gerbangnya terbuka?
Dialog: 0,0:34:29.72,0:34:31.35,teks umum,,0,0,0,,Ya, sangat
Dialog: 0,0:34:32.10,0:34:35.14,teks umum,,0,0,0,,Saat aku memasuki Sosnovy Bor dan menjadi Julia dan Dan Gu yang lebih baik,
Dialog: 0,0:34:35.23,0:34:37.65,teks umum,,0,0,0,,mereka akan menyesal tidak menerimaku lebih awal
Dialog: 0,0:34:41.65,0:34:43.53,teks umum,,0,0,0,,Maiden Kim, kamu bisa makan ginseng ini
Dialog: 0,0:34:44.28,0:34:46.61,teks umum,,0,0,0,,Terima kasih untuk ginsengnya, saya sangat menghargainya
Dialog: 0,0:35:01.84,0:35:04.72,teks umum,,0,0,0,,Kamu pasti hamba jahat itu
Dialog: 0,0:35:04.80,0:35:06.76,teks umum,,0,0,0,,Apa yang kamu lakukan? Kami memberimu obat
Dialog: 0,0:35:06.84,0:35:08.01,teks umum,,0,0,0,,Kamu bisa tertular penyakit
Dialog: 0,0:35:08.09,0:35:10.80,teks umum,,0,0,0,,Saya sembuh gratis,
Dialog: 0,0:35:10.89,0:35:13.43,teks umum,,0,0,0,,jadi mereka bilang aku harus bekerja untuk menunjukkan rasa terima kasihku
Dialogue: 0,0:35:13.52,0:35:15.56,teks umum,,0,0,0,,Maiden Kim adalah wanita bijak
Dialog: 0,0:35:16.06,0:35:19.15,teks umum,,0,0,0,,Sapu halaman, lalu bawa pupuk ke kebun herbal
Dialog: 0,0:35:20.02,0:35:21.02,teks umum,,0,0,0,,Ya
Dialog: 0,0:35:22.32,0:35:23.57, sulih suara,,0,0,0,,Tunggu saja, Ho Yeom
Dialog: 0,0:35:23.65,0:35:26.03, sulih suara,,0,0,0,,Sekarang aku sedang menyapu halamanmu,
Dialog: 0,0:35:26.11,0:35:27.99,di luar layar,,0,0,0,,tapi suatu hari aku akan menyingkirkan Saejukwon
Dialog: 0,0:35:31.49,0:35:33.54,miring,,0,0,0,,Hei! Perhatikan ke mana Anda membidik
Dialog: 0,0:35:33.62,0:35:35.25,teks umum,,0,0,0,,Apakah kamu melakukan ini dengan sengaja?
Dialog: 0,0:35:35.87,0:35:36.75,teks umum,,0,0,0,,Tidak
Dialog: 0,0:35:36.83,0:35:38.71,teks umum,,0,0,0,,Dan menurutku begitu
Dialog: 0,0:35:38.79,0:35:39.96,teks umum,,0,0,0,,Beraninya aku
Dialog: 0,0:35:44.00,0:35:45.80,teks umum,,0,0,0,,Kamu sangat aneh
Dialog: 0,0:35:46.59,0:35:47.84,miring,,0,0,0,,Telinga ini...
Dialog: 0,0:35:47.92,0:35:50.80,teks umum,,0,0,0,,Aku pernah melihatnya sebelumnya
Dialogue: 0,0:35:53.31,0:35:56.81,teks umum,,0,0,0,,Bukankah aku pernah memperlakukanmu sebelumnya?
Dialogue: 0,0:35:58.39,0:36:01.48,teks umum,,0,0,0,,Di mana saya bisa mendapatkan uang untuk berobat di Sejukwon?
Dialog: 0,0:36:04.32,0:36:07.49,teks umum,,0,0,0,,Telinga ini terlihat familier
Dialog: 0,0:36:12.78,0:36:14.41,teks umum,,0,0,0,,Sapu bersih
Dialog: 0,0:36:17.58,0:36:18.91,teks umum,,0,0,0,,Dia hampir merobek telingaku
Dialog: 0,0:36:19.75,0:36:21.29,miring,,0,0,0,,Aku tahu kamu kesakitan, tapi bersabarlah
Dialogue: 0,0:36:21.38,0:36:24.71,teks umum,,0,0,0,,Dia marah pada Pak Chan, jadi dia melampiaskannya padamu
Dialogue: 0,0:36:24.80,0:36:28.92,teks umum,,0,0,0,,Penindasan terhadap yang lemah adalah hal yang normal, begitulah cara dunia bekerja
Dialog: 0,0:36:29.01,0:36:31.05,teks umum,,0,0,0,,Aku diam saja
Dialog: 0,0:36:31.13,0:36:33.18,teks umum,,0,0,0,,Cobalah untuk tidak membencinya
Dialog: 0,0:36:33.26,0:36:35.14,teks umum,,0,0,0,,Dia memberikan aliran energi yang membuatnya kehilangan sepuluh tahun,
Dialog: 0,0:36:35.22,0:36:37.18,teks umum,,0,0,0,,untuk membantu tuan muda pulih lebih cepat
Dialog: 0,0:36:37.93,0:36:39.81,miring,,0,0,0,,Istirahat setelah selesai
Dialogue: 0,0:36:43.69,0:36:45.73,teks umum,,0,0,0,,Aliran energi sepuluh tahun?
Dialogue: 0,0:36:57.37,0:36:59.00,teks umum,,0,0,0,,Kenapa lama sekali?
Dialog: 0,0:36:59.08,0:37:01.21,teks umum,,0,0,0,,Ayo, ini ginseng liar...
Dialog: 0,0:37:02.12,0:37:03.21,teks umum,,0,0,0,,Ada apa Mu Dok?
Dialog: 0,0:37:03.29,0:37:05.00,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:37:05.88,0:37:07.05,teks umum,,0,0,0,,Diam
Dialog: 0,0:37:07.92,0:37:09.92,teks umum,,0,0,0,,Aku tidak membawamu ke sini untuk ini
Dialog: 0,0:37:10.01,0:37:12.26,teks umum,,0,0,0,,Moo Dok, ini salah. Aku muridmu, hentikan
Dialog: 0,0:37:14.64,0:37:15.85,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:37:20.89,0:37:22.39,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:37:22.48,0:37:23.81,teks umum,,0,0,0,,Memeriksa inti energimu
Dialog: 0,0:37:25.90,0:37:27.02,teks umum,,0,0,0,,Bernapas lega
Dialog: 0,0:37:43.96,0:37:45.21,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:37:46.96,0:37:48.25,teks umum,,0,0,0,,Sebenarnya
Dialogue: 0,0:37:49.50,0:37:51.01,teks umum,,0,0,0,,Kamu sungguh spesial
Dialog: 0,0:37:51.67,0:37:52.88,teks umum,,0,0,0,,Hentikan
Dialog: 0,0:37:53.51,0:37:55.39,teks umum,,0,0,0,,Apa yang ada di dalam diriku?
Dialog: 0,0:37:55.47,0:37:56.93,teks umum,,0,0,0,,Aliran energi yang luar biasa
Dialog: 0,0:37:57.60,0:37:59.89,teks umum,,0,0,0,,Ho Yeom memberikan energi padamu
Dialog: 0,0:38:01.85,0:38:03.23,teks umum,,0,0,0,,Energi?
Dialog: 0,0:38:11.57,0:38:14.15,teks umum,,0,0,0,,Sepertinya Inggris sudah pulih
Dialog: 0,0:38:14.24,0:38:16.87,teks umum,,0,0,0,,Saatnya mengekstrak energi yang kamu masukkan ke dalamnya
Dialog: 0,0:38:16.95,0:38:20.04,teks umum,,0,0,0,,Jika semuanya berjalan salah, dia mungkin kehilangan akal sehatnya
Dialog: 0,0:38:20.74,0:38:23.58,teks umum,,0,0,0,,Inggris tidak akan bisa menggunakannya
Dialog: 0,0:38:24.46,0:38:26.63,teks umum,,0,0,0,,Gerbang energinya baru saja terbuka
Dialog: 0,0:38:26.71,0:38:29.13,teks umum,,0,0,0,,Intinya, dia tidak bisa berbuat apa-apa
Dialogue: 0,0:38:29.21,0:38:30.59,teks umum,,0,0,0,,Khawatirmu sia-sia
Dialog: 0,0:38:31.25,0:38:35.72,teks umum,,0,0,0,,Kemungkinan besar dia bahkan tidak tahu bahwa ada sesuatu yang begitu luar biasa di dalam dirinya
Dialog: 0,0:38:38.68,0:38:40.76,miring,,0,0,0,,Ayo curi energi Ho Yeom
Dialog: 0,0:38:42.85,0:38:46.31,teks umum,,0,0,0,,Inti energimu diisi dengan energi yang diberikan Ho Yeom padamu
Dialog: 0,0:38:47.27,0:38:49.36,teks umum,,0,0,0,,Sekarang kamu cukup kuat untuk menggunakan Chipsa dengan mudah
Dialog: 0,0:38:49.44,0:38:52.19,teks umum,,0,0,0,,Aku tak menyangka ada sesuatu yang begitu berharga dalam diriku
Dialog: 0,0:38:52.28,0:38:55.57,teks umum,,0,0,0,,Dibutuhkan sepuluh tahun untuk mengumpulkan energi seperti itu, dan kamu mendapatkannya secara gratis
Dialog: 0,0:38:55.65,0:38:57.86,teks umum,,0,0,0,,Lagi pula, ini adalah energi Ho Yeom, kamu tidak bisa meminta yang lebih baik
Dialog: 0,0:38:58.74,0:39:00.12,teks umum,,0,0,0,,Dasar bodoh
Dialog: 0,0:39:00.20,0:39:04.45,teks umum,,0,0,0,,Kupikir orang tua itu membenciku. Aku terkejut dia memberikannya padaku
Dialog: 0,0:39:04.54,0:39:07.54,teks umum,,0,0,0,,Dia memberikannya padamu untuk membantumu pulih
Dialog: 0,0:39:07.62,0:39:08.88,teks umum,,0,0,0,,Dia akan segera membawanya
Dialog: 0,0:39:08.96,0:39:12.34,teks umum,,0,0,0,,Dia tidak bisa melakukan itu. Apa yang ada di perutku adalah milikku
Dialog: 0,0:39:12.42,0:39:14.51,teks umum,,0,0,0,,Jika kamu tidak mempunyai kekuatan untuk mengendalikannya,
Dialog: 0,0:39:14.59,0:39:17.47,teks umum,,0,0,0,,kekuatanmu tidak akan ada dan dia akan mengambilnya
Dialog: 0,0:39:17.55,0:39:20.18,teks umum,,0,0,0,,Aku harus belajar mengendalikan energi agar bisa menyimpannya untuk diriku sendiri
Dialogue: 0,0:39:20.26,0:39:23.27,teks umum,,0,0,0,,Jadi aku harus bernafas sebagai sumber energi
Dialog: 0,0:39:24.06,0:39:27.10,teks umum,,0,0,0,,Saya kira 12 guru ini setidaknya mengajari Anda sesuatu
Dialog: 0,0:39:28.19,0:39:29.27,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:39:30.56,0:39:33.57,miring,,0,0,0,,Energi dari inti dikendalikan oleh pernapasan,
Dialogue: 0,0:39:33.65,0:39:35.86,italic,,0,0,0,,namun, semua penyihir bernapas dengan cara yang berbeda
Dialogue: 0,0:39:35.94,0:39:39.61,italic,,0,0,0,,Setiap orang menghirup dan menghembuskan jumlah udara yang berbeda
Dialog: 0,0:39:40.74,0:39:44.49,teks umum,,0,0,0,,Ini adalah energi Ho Yeom, jadi kamu perlu mengendalikannya dengan pernapasannya
Dialog: 0,0:39:45.41,0:39:47.37,teks umum,,0,0,0,,Aku ragu dia akan mengajariku
Dialog: 0,0:39:47.46,0:39:50.58,teks umum,,0,0,0,,Mungkin kita harus mencoba semuanya? Itu hanya bernapas
Dialog: 0,0:39:51.33,0:39:54.71,teks umum,,0,0,0,,Jika kamu menggunakan nafas seseorang, kamu bisa kehilangan kendali dan menjadi gila
Dialog: 0,0:39:55.46,0:39:59.63,teks umum,,0,0,0,,Darah akan tumpah dari seluruh bagian tubuhmu, dan kamu akan mati
Dialog: 0,0:39:59.72,0:40:01.01,teks umum,,0,0,0,,Baiklah, haruskah kita coba?
Dialog: 0,0:40:02.22,0:40:03.05,teks umum,,0,0,0,,Tidak
Dialog: 0,0:40:03.81,0:40:06.27,teks umum,,0,0,0,,Kamu bertindak ekstrem
Dialog: 0,0:40:07.14,0:40:10.31,teks umum,,0,0,0,,Guru, temukan cara yang akan membuatku tetap hidup dan memungkinkanku mengendalikan energi
Dialog: 0,0:40:11.56,0:40:15.98,teks umum,,0,0,0,,Teknik pernapasan dasar diturunkan dari generasi ke generasi
Dialog: 0,0:40:16.07,0:40:17.99,miring,,0,0,0,,Ho Yeom dari keluarga So
Dialog: 0,0:40:18.07,0:40:21.20,teks umum,,0,0,0,,Jadi, setiap anggota keluarga So akan menggunakan teknik yang sama
Dialog: 0,0:40:24.53,0:40:25.70,teks umum,,0,0,0,,- Jadi Yul\N- Jadi Yul
Dialog: 0,0:40:34.29,0:40:36.50,teks umum,,0,0,0,,Tanyakan padanya. Kamu bilang kamu dekat
Dialog: 0,0:40:36.59,0:40:38.13,teks umum,,0,0,0,,Yul berhati-hati
Dialog: 0,0:40:38.72,0:40:42.01,teks umum,,0,0,0,,Jika aku bertanya, dia akan mengerti semuanya dan memberitahu Ho Yeom
Dialog: 0,0:40:43.76,0:40:45.18,teks umum,,0,0,0,,Hanya sepuluh napas...
Dialog: 0,0:40:45.26,0:40:47.97,teks umum,,0,0,0,,Tidak, tujuh saja sudah cukup
Dialog: 0,0:40:48.06,0:40:50.89,teks umum,,0,0,0,,Aku bisa mengerti dengan meletakkan tanganku di inti energinya
Dialog: 0,0:40:51.69,0:40:53.86,teks umum,,0,0,0,,Dia akan mematahkan lenganmu sebelum dia menarik napas
Dialog: 0,0:40:54.52,0:40:57.28,teks umum,,0,0,0,,Kamu benar, dia tidak seperti kamu
Dialog: 0,0:40:58.61,0:40:59.69,teks umum,,0,0,0,,Saya?
Dialog: 0,0:41:00.99,0:41:01.99,teks umum,,0,0,0,,Ada apa denganku?
Dialog: 0,0:41:04.07,0:41:07.45,teks umum,,0,0,0,,Apa? Penampilan menghina macam apa ini?
Dialog: 0,0:41:07.54,0:41:10.87,teks umum,,0,0,0,,Lagi pula, aku rasa aku tidak bisa melakukan padanya seperti yang kulakukan padamu
Dialog: 0,0:41:10.96,0:41:12.42,teks umum,,0,0,0,,Tidak, tidak, Moo Deok
Dialog: 0,0:41:12.50,0:41:14.04,teks umum,,0,0,0,,Tatap mataku
Dialog: 0,0:41:14.13,0:41:17.46,teks umum,,0,0,0,,Tidak nyaman bagimu untuk menyentuhnya, tapi denganku satu atau dua?
Dialog: 0,0:41:17.55,0:41:20.13,teks umum,,0,0,0,,Seperti anak kecil. Apakah ini penting sekarang?
Dialog: 0,0:41:20.72,0:41:21.80,teks umum,,0,0,0,,Anak?
Dialog: 0,0:41:23.26,0:41:24.68,teks umum,,0,0,0,,Ya, sangat penting
Dialog: 0,0:41:24.76,0:41:26.68,teks umum,,0,0,0,,Apakah kamu gila? Apa yang sedang kamu lakukan?
Dialog: 0,0:41:26.76,0:41:27.60,teks umum,,0,0,0,,Saya dalam keadaan sehat sempurna
Dialog: 0,0:41:27.68,0:41:30.02,teks umum,,0,0,0,,- Tidak, anggap saja aku gila\N- Baiklah, biarkan aku pergi
Dialog: 0,0:41:32.89,0:41:33.77,teks umum,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:41:35.44,0:41:36.36,teks umum,,0,0,0,,Halo
Dialogue: 0,0:41:38.36,0:41:41.36,teks umum,,0,0,0,,Kenapa kamu terus menerus mengejek Moo Deok?
Dialog: 0,0:41:41.99,0:41:43.03,teks umum,,0,0,0,,Dia belum pulih
Dialog: 0,0:41:43.11,0:41:45.16,teks umum,,0,0,0,,Aku tidak mengejeknya
Dialog: 0,0:41:46.70,0:41:48.20,teks umum,,0,0,0,,- Apa?{\i1}\N- Ini kumbang
Dialog: 0,0:41:48.28,0:41:49.87,teks umum,,0,0,0,,Saya pikir kamu baik hati
Dialog: 0,0:41:51.20,0:41:52.79,miring,,0,0,0,,Moo Dok, kamu baik-baik saja?
Dialog: 0,0:41:54.67,0:41:57.25,miring,,0,0,0,,Tuanmu menuntut terlalu banyak darimu, bukan?
Dialog: 0,0:41:57.34,0:42:00.55,teks umum,,0,0,0,,Kamu tidak hanya menjaganya, tapi juga menghiburnya
Dialog: 0,0:42:00.63,0:42:02.84,miring,,0,0,0,,Dia minta air hangat, tapi saat aku bawakan,
Dialog: 0,0:42:02.92,0:42:04.34,teks umum,,0,0,0,,minta yang dingin lagi...
Dialog: 0,0:42:04.43,0:42:06.30,teks umum,,0,0,0,,- Hei, apa...{\i1}\N- Katanya makanannya asin,
Dialog: 0,0:42:06.39,0:42:08.05,teks umum,,0,0,0,,tapi kemudian mengeluh kalau dia hambar
Dialog: 0,0:42:08.14,0:42:10.43,teks umum,,0,0,0,,- Aku?{\i1}\N- Dia tidak dewasa dan berubah-ubah
Dialog: 0,0:42:10.52,0:42:12.89,teks umum,,0,0,0,,Malas, tapi dengan harga diri yang tinggi
Dialog: 0,0:42:13.77,0:42:15.06,miring,,0,0,0,,Tapi apa yang bisa kulakukan?
Dialog: 0,0:42:15.15,0:42:16.44,teks umum,,0,0,0,,Dia tuanku,
Dialog: 0,0:42:16.52,0:42:18.48,teks umum,,0,0,0,,jadi aku harus melayaninya
Dialog: 0,0:42:19.15,0:42:21.48,miring,,0,0,0,,Moo Dok, sepertinya kamu berhasil belajar banyak tentang dia
Dialog: 0,0:42:21.57,0:42:22.90,teks umum,,0,0,0,,Aku malu padamu
Dialog: 0,0:42:24.07,0:42:28.12,teks umum,,0,0,0,,Ngomong-ngomong, apa yang kamu lakukan di sini? Kenapa kamu tidak di Sejukwon?
Dialog: 0,0:42:31.87,0:42:34.50,teks umum,,0,0,0,,Kami datang ke Yul
Dialog: 0,0:42:34.58,0:42:35.79,teks umum,,0,0,0,,Moo Dok memintaku untuk datang
Dialog: 0,0:42:38.21,0:42:39.21,teks umum,,0,0,0,,Yul?
Dialogue: 0,0:42:40.17,0:42:42.92,teks umum,,0,0,0,,Kalau begitu, kenapa kamu tidak mendekatinya?
Dialog: 0,0:42:44.01,0:42:45.13,teks umum,,0,0,0,,Kami memata-matai dia
Dialog: 0,0:42:45.72,0:42:49.35,teks umum,,0,0,0,,Moo Dok malu mendekatinya,
Dialog: 0,0:42:49.43,0:42:50.56,teks umum,,0,0,0,,jadi aku tinggal bersamanya
Dialog: 0,0:42:53.73,0:42:57.15,teks umum,,0,0,0,,Moo Dok, kamu mungkin menyukai Yul
Dialog: 0,0:42:57.23,0:42:59.23,teks umum,,0,0,0,,- Tidak...{\i1}\N- Dan Gu,
Dialog: 0,0:42:59.31,0:43:01.19,teks umum,,0,0,0,,kamu memahami semuanya dengan cepat
Dialog: 0,0:43:01.27,0:43:03.11,teks umum,,0,0,0,,Saya sudah malu
Dialog: 0,0:43:03.19,0:43:06.61,teks umum,,0,0,0,,- Guru! Terjadi kesalahpahaman\N- Jangan malu-malu
Dialog: 0,0:43:06.70,0:43:09.62,teks umum,,0,0,0,,Banyak gadis menyukai Yul
Dialogue: 0,0:43:09.70,0:43:11.37,italic,,0,0,0,,- Perasaanmu normal{\i0}\N- Ini tidak...
Dialog: 0,0:43:11.45,0:43:13.58,miring,,0,0,0,,Saya akan membantu Moo Deok
Dialog: 0,0:43:13.66,0:43:15.25,teks umum,,0,0,0,,Uk, pergi ke resepsi
Dialog: 0,0:43:15.33,0:43:16.54,teks umum,,0,0,0,,Mengapa?
Dialog: 0,0:43:17.12,0:43:18.17,teks umum,,0,0,0,,Tuan Ho ingin bertemu denganmu
Dialog: 0,0:43:18.25,0:43:19.25,teks umum,,0,0,0,,Tuan Ho?
Dialog: 0,0:43:47.40,0:43:49.11,teks umum,,0,0,0,,Kudengar kau memanggilku
Dialog: 0,0:43:51.24,0:43:52.24,teks umum,,0,0,0,,Ya
Dialog: 0,0:43:52.87,0:43:55.37,miring,,0,0,0,,Suara batukmu enak dan jernih
Dialog: 0,0:43:55.45,0:43:57.21,teks umum,,0,0,0,,Menurutku kamu merasa jauh lebih baik
Dialogue: 0,0:43:57.29,0:43:59.67,teks umum,,0,0,0,,Aku masih pusing dan mual
Dialog: 0,0:44:00.33,0:44:01.88,teks umum,,0,0,0,,Lagipula, aku kehilangan kesadaran
Dialog: 0,0:44:02.50,0:44:05.00,teks umum,,0,0,0,,Tapi berkatmu aku menjadi lebih baik
Dialog: 0,0:44:05.09,0:44:07.17,miring,,0,0,0,,Aku melihatmu dan pembantumu
Dialog: 0,0:44:07.26,0:44:11.09,teks umum,,0,0,0,,senang jalan-jalan pagi ini
Dialog: 0,0:44:11.18,0:44:12.68,teks umum,,0,0,0,,Aneh bukan?
Dialog: 0,0:44:13.89,0:44:15.81,teks umum,,0,0,0,,Hei, ayolah, berdiri di sini
Dialog: 0,0:44:16.68,0:44:18.31,teks umum,,0,0,0,,Aku perlu mengambil sesuatu darimu
Dialog: 0,0:44:20.31,0:44:21.15,miring,,0,0,0,,Tapi pertama-tama
Dialog: 0,0:44:21.86,0:44:23.77,teks umum,,0,0,0,,Aku membawakan sesuatu untukmu
Dialogue: 0,0:44:25.61,0:44:26.57,teks umum,,0,0,0,,Untukku?
Dialog: 0,0:44:27.24,0:44:28.99,teks umum,,0,0,0,,Di masa kanak-kanak
Dialog: 0,0:44:29.07,0:44:31.32,teks umum,,0,0,0,,Aku membiarkan sekawanan domba ke kebunmu dengan tanaman obat
Dialog: 0,0:44:31.41,0:44:33.16,teks umum,,0,0,0,,Aku tahu kamu membenciku sejak saat itu
Dialog: 0,0:44:33.24,0:44:36.91,teks umum,,0,0,0,,Domba-domba itu memakan tanaman obat
Dialog: 0,0:44:37.00,0:44:38.91,teks umum,,0,0,0,,dan hidup hingga hari ini
Dialog: 0,0:44:39.00,0:44:41.29,teks umum,,0,0,0,,Meskipun demikian, kamu menyelamatkan hidupku
Dialog: 0,0:44:41.37,0:44:44.29,teks umum,,0,0,0,,dan dibiarkan hidup. Saya sangat berterima kasih kepada Anda untuk ini
Dialogue: 0,0:44:44.38,0:44:46.55,teks umum,,0,0,0,,Kupikir kamu benar-benar idiot,
Dialog: 0,0:44:46.63,0:44:49.72,teks umum,,0,0,0,,tapi sepertinya kamu telah belajar menunjukkan rasa syukur
Dialog: 0,0:44:49.80,0:44:51.84,teks umum,,0,0,0,,Aku sudah menyiapkan sesuatu untukmu
Dialog: 0,0:44:52.43,0:44:53.47,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:45:15.66,0:45:19.25,teks umum,,0,0,0,,Anggur ini terbuat dari air lelehan dari pulau gunung berapi di Deho Selatan
Dialog: 0,0:45:19.33,0:45:22.54,teks umum,,0,0,0,,Anggur hitam terbaik di wilayah Deho
Dialog: 0,0:45:24.13,0:45:26.34,teks umum,,0,0,0,,Pria itu berkata bahwa dia ingin mengucapkan terima kasih,
Dialog: 0,0:45:26.42,0:45:29.88,teks umum,,0,0,0,,jadi saya harus berusaha keras untuk mendapatkannya
Dialog: 0,0:45:34.59,0:45:36.18,teks umum,,0,0,0,,Ini adalah kelezatan yang langka
Dialog: 0,0:45:40.56,0:45:42.39,teks umum,,0,0,0,,Apakah hanya ada satu botol?
Dialog: 0,0:45:56.57,0:46:00.29,teks umum,,0,0,0,,Kamu pasti tahu banyak tentang rasa syukur!
Dialog: 0,0:46:01.62,0:46:04.87,teks umum,,0,0,0,,Hamba Kim, kamu membesarkannya dengan baik
Dialog: 0,0:46:04.96,0:46:06.42,miring,,0,0,0,,Terima kasih
Dialog: 0,0:46:06.96,0:46:08.42,teks umum,,0,0,0,,Bawa ke sini, lebih cepat
Dialog: 0,0:46:09.13,0:46:10.55,miring,,0,0,0,,Sungguh menyenangkan
Dialog: 0,0:46:14.22,0:46:16.26,teks umum,,0,0,0,,Tiga botol?
Dialog: 0,0:46:21.68,0:46:22.77,teks umum,,0,0,0,,Ibu
Dialog: 0,0:46:23.48,0:46:25.73,teks umum,,0,0,0,,Gerbang energi Uka terbuka
Dialog: 0,0:46:26.56,0:46:30.94,teks umum,,0,0,0,,Sampai saat ini, kami tidak dapat melakukan apa pun karena perintah Gwangju
Dialog: 0,0:46:32.07,0:46:35.66,teks umum,,0,0,0,,Apakah ini berarti sekarang kita bisa menerima dia ke dalam keluarga?
Dialog: 0,0:46:35.74,0:46:39.33,teks umum,,0,0,0,,Orang ini memutuskan pertunangannya setelah memanfaatkanmu
Dialog: 0,0:46:40.24,0:46:41.66,teks umum,,0,0,0,,Dan kamu masih mencintainya?
Dialog: 0,0:46:41.74,0:46:44.62,teks umum,,0,0,0,,Saya menggunakannya untuk tujuan saya sendiri
Dialog: 0,0:46:45.12,0:46:47.58,teks umum,,0,0,0,,Gerbang energinya ditutup, dan aku menggunakannya untuk melawannya,
Dialog: 0,0:46:47.67,0:46:49.38,teks umum,,0,0,0,,memaksa dia untuk tinggal bersama kita
Dialog: 0,0:46:49.46,0:46:51.05,teks umum,,0,0,0,,Jangan memutarbalikkan kebenaran
Dialog: 0,0:46:51.13,0:46:54.51,teks umum,,0,0,0,,Dia berkata bahwa dia akan tinggal bersama kita jika kita membantunya membuka gerbang energi
Dialog: 0,0:46:54.59,0:46:55.93,teks umum,,0,0,0,,Jadi dia merayumu
Dialog: 0,0:46:59.22,0:47:01.06,teks umum,,0,0,0,,Pada akhirnya terjadilah
Dialog: 0,0:47:01.14,0:47:04.27,teks umum,,0,0,0,,Jika kamu telah membuka gerbangnya,
Dialog: 0,0:47:04.35,0:47:06.44,teks umum,,0,0,0,,kamu akan mempunyai menantu,
Dialog: 0,0:47:06.52,0:47:10.65,teks umum,,0,0,0,,dan aku akan menikah dengan orang yang kuinginkan
Dialog: 0,0:47:12.98,0:47:14.11,teks umum,,0,0,0,,Cho Young
Dialog: 0,0:47:14.99,0:47:17.49,teks umum,,0,0,0,,Putra keluarga Chan, yang gerbang energinya terbuka,
Dialog: 0,0:47:17.57,0:47:19.74,teks umum,,0,0,0,,tidak akan pernah menjadi menantuku
Dialog: 0,0:47:21.12,0:47:23.87,teks umum,,0,0,0,,Kamu harus menggantikan adikmu
Dialog: 0,0:47:24.66,0:47:27.71,teks umum,,0,0,0,,dan menjadi kepala yang melindungi Jinyeowon demi keluarga
Dialog: 0,0:47:29.38,0:47:31.71,teks umum,,0,0,0,,Temukan pria yang akan mendukungmu
Dialog: 0,0:47:33.38,0:47:35.13,teks umum,,0,0,0,,Jika adikku tidak meninggal,
Dialogue: 0,0:47:35.92,0:47:38.09,teks umum,,0,0,0,,Aku akan menikahi kekasihku
Dialog: 0,0:47:45.10,0:47:46.89,teks umum,,0,0,0,,Maaf bu
Dialog: 0,0:47:48.69,0:47:52.19,teks umum,,0,0,0,,Periksa apakah guci Gwigu sudah diambil atau belum
Dialog: 0,0:47:53.48,0:47:54.69,teks umum,,0,0,0,,Oke
Dialog: 0,0:48:41.61,0:48:45.79,teks umum,,0,0,0,,Uk memecahkan guci Gwigu
Dialog: 0,0:48:50.62,0:48:52.79,teks umum,,0,0,0,,Bagaimana jika aku memintanya menikah denganku sebagai balasannya?
Dialog: 0,0:48:53.75,0:48:55.17,teks umum,,0,0,0,,Dia pasti akan menolak
Dialog: 0,0:49:01.09,0:49:04.89,teks umum,,0,0,0,,Mr. Yul tidur di kamar terjauh?
Dialog: 0,0:49:04.97,0:49:08.18,teks umum,,0,0,0,,Ya, dia menyukai kedamaian dan ketenangan
Dialogue: 0,0:49:09.89,0:49:11.39,teks umum,,0,0,0,,Kapan dia tidur?
Dialog: 0,0:49:11.89,0:49:13.35,teks umum,,0,0,0,,Jika tidak sibuk,
Dialog: 0,0:49:13.44,0:49:16.65,teks umum,,0,0,0,,tidur lebih awal dan bangun lebih awal
Dialog: 0,0:49:18.03,0:49:19.07,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:19.15,0:49:21.03,teks umum,,0,0,0,,Apakah kamu ingin mengunjungi kamar tidurnya?
Dialog: 0,0:49:22.41,0:49:24.49,teks umum,,0,0,0,,Tidak peduli seberapa besar kamu menyukainya, ini salah
Dialog: 0,0:49:27.54,0:49:28.79,teks umum,,0,0,0,,Petunjuk
Dialog: 0,0:49:28.87,0:49:31.79,teks umum,,0,0,0,,Dia selalu makan di waktu yang sama, kamu bisa melihatnya saat makan siang
Dialog: 0,0:49:33.00,0:49:34.25,teks umum,,0,0,0,,Oke
Dialog: 0,0:49:34.33,0:49:37.63,di belakang layar,,0,0,0,,Aku butuh lebih dari sekadar melihat. Saya perlu menyentuhnya
Dialog: 0,0:49:55.27,0:49:56.86,teks umum,,0,0,0,,Kami Dok, kamu baik-baik saja?
Dialog: 0,0:50:00.90,0:50:02.07,teks umum,,0,0,0,,Yul...
Dialog: 0,0:50:05.20,0:50:07.74,teks umum,,0,0,0,,Orang luar tidak diperbolehkan membaca buku di Jeongjingak
Dialog: 0,0:50:08.53,0:50:10.91,teks umum,,0,0,0,,Dia hanya membantu
Dialog: 0,0:50:11.00,0:50:12.87,teks umum,,0,0,0,,Ya, dan mantra tertulis di dalamnya
Dialog: 0,0:50:12.96,0:50:14.83,teks umum,,0,0,0,,Dia masih belum mengerti
Dialog: 0,0:50:16.71,0:50:17.96,teks umum,,0,0,0,,Apakah kamu cepat?
Dialog: 0,0:50:19.30,0:50:20.88,teks umum,,0,0,0,,Apakah kamu tahu seni bela diri?
Dialogue: 0,0:50:23.88,0:50:26.64,teks umum,,0,0,0,,Aku belajar menari di rumah gisaeng
Dialog: 0,0:50:29.81,0:50:31.43,teks umum,,0,0,0,,Itulah sebabnya aku cepat
Dialog: 0,0:50:35.77,0:50:38.90,teks umum,,0,0,0,,Di mana Don Yi? Harus menanyakan sesuatu
Dialogue: 0,0:50:41.48,0:50:44.36,teks umum,,0,0,0,,Don Dan tidak disini, tapi ada Mu Dok
Dialog: 0,0:50:44.99,0:50:47.37,teks umum,,0,0,0,,Moo Dok, bantu dia
Dialog: 0,0:50:47.45,0:50:48.74,teks umum,,0,0,0,,saya akan bantu
Dialog: 0,0:50:48.82,0:50:50.83,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:51:07.13,0:51:09.22,teks umum,,0,0,0,,Bantuan, tuan muda?
Dialogue: 0,0:51:13.06,0:51:15.94,teks umum,,0,0,0,,Pak, apakah anda lapar? Apa yang harus dibawa?
Dialog: 0,0:51:17.60,0:51:20.19,teks umum,,0,0,0,,Pak, saya...
Dialog: 0,0:51:32.74,0:51:36.33,teks umum,,0,0,0,,Para penyihir Chonjingak tinggal di sini. Jangan ikuti saya
Dialog: 0,0:51:41.75,0:51:45.13, sulih suara,,0,0,0,,Jika dia tidur lebih awal, berarti dia akan tidur
Dialog: 0,0:51:58.77,0:52:00.10,teks umum,,0,0,0,,Apakah ini toilet?
Dialog: 0,0:52:08.49,0:52:10.74,teks umum,,0,0,0,,Sudah kubilang pergi. Mengapa kamu di sini?
Dialog: 0,0:52:13.45,0:52:17.87,teks umum,,0,0,0,,Saya pikir mungkin saya bisa membantu sesuatu
Dialog: 0,0:52:18.91,0:52:19.75,teks umum,,0,0,0,,Untukmu
Dialog: 0,0:52:21.17,0:52:22.79,teks umum,,0,0,0,,apakah kamu membutuhkan sesuatu dariku?
Dialog: 0,0:52:27.88,0:52:30.51,di luar layar,,0,0,0,,Hanya untuk menyentuhmu. Dan ini adalah sebuah kesempatan
Dialogue: 0,0:52:31.39,0:52:34.14,teks umum,,0,0,0,,Kenapa kamu mengikutiku sampai ke toilet pria?
Dialog: 0,0:53:08.13,0:53:11.34, sulih suara,,0,0,0,,Ini kesempatanku. Enam napas dan saya akan mengerti bagaimana dia bernapas
Dialog: 0,0:53:14.22,0:53:15.18,di belakang layar,,0,0,0,,Satu
Dialog: 0,0:53:16.31,0:53:17.14,di belakang layar,,0,0,0,,Dua
Dialog: 0,0:53:20.02,0:53:21.19,di belakang layar,,0,0,0,,Tiga
Dialog: 0,0:53:21.89,0:53:23.02,di belakang layar,,0,0,0,,Empat
Dialog: 0,0:53:39.20,0:53:40.25,teks umum,,0,0,0,,Mengapa kamu melakukan itu?
Dialog: 0,0:53:40.83,0:53:43.00, sulih suara,,0,0,0,,Aku sangat dekat
Dialogue: 0,0:53:43.08,0:53:45.17,teks umum,,0,0,0,,Aku tahu kau dan Inggris melihatku dari jauh
Dialog: 0,0:53:45.25,0:53:46.71,teks umum,,0,0,0,,Mengapa kamu mengikutiku?
Dialog: 0,0:53:48.09,0:53:50.55,di belakang layar,,0,0,0,,Hanya satu nafas
Dialog: 0,0:53:51.59,0:53:52.47,teks umum,,0,0,0,,Jawaban
Dialog: 0,0:53:53.22,0:53:54.72,teks umum,,0,0,0,,Aku cinta kamu!
Dialog: 0,0:54:20.62,0:54:21.62,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:54:22.71,0:54:24.00,teks umum,,0,0,0,,Sakit
Dialog: 0,0:54:40.14,0:54:43.81,teks umum,,0,0,0,,Anda tertarik dengan teknik pernapasan saya. Mencoba mencapai inti energiku
Dialog: 0,0:54:44.56,0:54:46.40,teks umum,,0,0,0,,Sudah kubilang, aku cinta kamu
Dialog: 0,0:54:46.48,0:54:47.94,teks umum,,0,0,0,,Kamu berbohong dengan sangat terampil
Dialog: 0,0:54:48.81,0:54:50.82,teks umum,,0,0,0,,Dan sebelumnya tidak ada tarian, melainkan seni bela diri
Dialog: 0,0:54:51.40,0:54:53.03,teks umum,,0,0,0,,Hidupku sulit,
Dialog: 0,0:54:53.11,0:54:55.53,teks umum,,0,0,0,,jadi saya belajar beberapa gerakan untuk keselamatan
Dialog: 0,0:54:55.61,0:54:57.20,teks umum,,0,0,0,,Apakah ini untuk Uka?
Dialog: 0,0:54:59.49,0:55:02.41,teks umum,,0,0,0,,Saya pikir dia mencoba mengendalikan cadangan energi di dalam
Dialog: 0,0:55:02.50,0:55:05.41,teks umum,,0,0,0,,Tetapi dia tidak akan berhasil bahkan dengan bantuan teknikku
Dialog: 0,0:55:08.83,0:55:11.13,teks umum,,0,0,0,,Berhentilah membuang-buang waktu. Menjadi lebih baik dan pergi
Dialog: 0,0:55:31.07,0:55:32.98,teks umum,,0,0,0,,Jadi, apakah kamu ingat aku,
Dialog: 0,0:55:33.98,0:55:35.11,teks umum,,0,0,0,,Yul
Dialog: 0,0:57:01.36,0:57:05.12,teks umum,,0,0,0,,Aku tidak mengabaikanmu karena aku membencimu
Dialog: 0,0:57:05.20,0:57:08.75,teks umum,,0,0,0,,Ibumu Do Hwa seperti anak perempuan bagiku
Dialog: 0,0:57:09.33,0:57:11.67,teks umum,,0,0,0,,Aku seperti kakekmu
Dialogue: 0,0:57:13.96,0:57:15.34,teks umum,,0,0,0,,Bajingan muda
Dialog: 0,0:57:17.76,0:57:19.63,teks umum,,0,0,0,,Ya, kakek
Dialog: 0,0:57:22.84,0:57:27.01,teks umum,,0,0,0,,Ibumu sangat baik
Dialog: 0,0:57:28.77,0:57:30.06,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:57:30.73,0:57:34.23,teks umum,,0,0,0,,Ya! Anda harus mengetahui hal ini
Dialog: 0,0:57:34.31,0:57:37.44,teks umum,,0,0,0,,Ingat ini dan jangan perhatikan perkataan orang lain
Dialog: 0,0:57:40.95,0:57:42.20,teks umum,,0,0,0,,Anak malang ini...
Dialog: 0,0:57:45.28,0:57:49.16,di balik layar,,0,0,0,,Panjang dan kedalaman tarikan dan embusan napas
Dialog: 0,0:58:01.30,0:58:03.34,teks umum,,0,0,0,,Sulit untuk dimainkan. saya terkesan
Dialog: 0,0:58:04.84,0:58:06.76,teks umum,,0,0,0,,Saya bisa melakukan banyak hal
Dialog: 0,0:58:08.43,0:58:09.68,teks umum,,0,0,0,,Kembali
Dialog: 0,0:58:15.15,0:58:17.19,teks umum,,0,0,0,,Sepertinya sudah berumur bertahun-tahun
Dialogue: 0,0:58:17.27,0:58:19.73,teks umum,,0,0,0,,Mengapa kamu membutuhkan sesuatu yang begitu tua?
Dialog: 0,0:58:23.57,0:58:25.24,teks umum,,0,0,0,,Itu milik teman lama
Dialog: 0,0:58:31.37,0:58:34.21,teks umum,,0,0,0,,Alih-alih ada teman di dekatmu, kamu punya peluit
Dialog: 0,0:58:35.17,0:58:37.04,teks umum,,0,0,0,,Jadi temanmu meninggalkanmu
Dialog: 0,0:58:41.38,0:58:42.55,teks umum,,0,0,0,,Ya
Dialog: 0,0:58:43.38,0:58:44.88,teks umum,,0,0,0,,Ini milik teman itu
Dialog: 0,0:58:47.80,0:58:49.72,teks umum,,0,0,0,,Kembalikan aku, dia sangat berarti bagiku
Dialog: 0,0:58:51.31,0:58:55.31,teks umum,,0,0,0,,Sebagai imbalannya, ajari aku teknik pernapasanmu
Dialog: 0,0:58:57.90,0:59:00.40,teks umum,,0,0,0,,Kamu bilang itu tidak ada gunanya
Dialog: 0,0:59:00.48,0:59:02.69,teks umum,,0,0,0,,Ini juga tidak berguna bagiku
Dialog: 0,0:59:03.49,0:59:04.61,teks umum,,0,0,0,,Mari kita berubah
Dialog: 0,0:59:08.07,0:59:09.87,teks umum,,0,0,0,,Bagiku ini sampah,
Dialog: 0,0:59:10.83,0:59:12.37,teks umum,,0,0,0,,Saya bisa memecahkannya
Dialog: 0,0:59:29.76,0:59:31.26,teks umum,,0,0,0,,Hanya tiga napas
Dialog: 0,1:00:12.43,1:00:14.47,teks umum,,0,0,0,,Dimana dia?
Dialog: 0,1:00:40.92,1:00:43.17,teks umum,,0,0,0,,Ekspresi wajah seperti apa?
Dialog: 0,1:00:43.71,1:00:46.05,teks umum,,0,0,0,,Tidak seperti kamu
Dialog: 0,1:00:48.59,1:00:49.76,teks umum,,0,0,0,,Saya menyukainya
Dialog: 0,1:00:54.47,1:00:56.06,teks umum,,0,0,0,,Kamu memutarbalikkan semuanya seperti itu
Dialog: 0,1:00:56.89,1:01:00.31,teks umum,,0,0,0,,Aku mengikuti Yul dan mengulangi bahwa aku menyukainya, dan sekarang aku mengetahuinya
Dialog: 0,1:01:00.39,1:01:01.60,teks umum,,0,0,0,,Mengerti
Dialog: 0,1:01:02.44,1:01:05.44,teks umum,,0,0,0,,Kamu adalah orang sensitif yang membunuh semua orang di jalanmu,
Dialog: 0,1:01:05.52,1:01:08.78,teks umum,,0,0,0,,tapi aku memutuskan untuk menggoda pria itu demi muridku
Dialog: 0,1:01:09.82,1:01:11.03,teks umum,,0,0,0,,Dan kamu?
Dialog: 0,1:01:11.11,1:01:13.78,teks umum,,0,0,0,,Saya harap Anda tidak membiarkan Ho Yeom mengambil energinya
Dialog: 0,1:01:13.87,1:01:16.20,teks umum,,0,0,0,,Kekuatan ada di dalam diriku. Dan saya mempelajari teknik pernapasannya
Dialog: 0,1:01:16.29,1:01:17.74,teks umum,,0,0,0,,Jadi, kamu membuang-buang waktumu
Dialog: 0,1:01:17.83,1:01:20.37,teks umum,,0,0,0,,Apakah kamu mengetahuinya? Jangan berbohong padaku
Dialog: 0,1:01:21.00,1:01:22.29,teks umum,,0,0,0,,Saya yakin Anda berbohong,
Dialog: 0,1:01:22.37,1:01:24.54,teks umum,,0,0,0,,untuk berpura-pura bahwa Anda melakukan sesuatu yang bermanfaat
Dialog: 0,1:01:24.63,1:01:26.67,teks umum,,0,0,0,,Saya bernapas seperti ini. bagaimana kabarnya
Dialog: 0,1:01:26.75,1:01:29.05,teks umum,,0,0,0,,Dan, sepertinya, aku merasakan sesuatu bergerak dalam diriku
Dialog: 0,1:01:37.22,1:01:38.93,teks umum,,0,0,0,,Energi mendidih di dalam dirimu
Dialog: 0,1:01:40.35,1:01:41.69,teks umum,,0,0,0,,Berhasil
Dialogue: 0,1:01:44.44,1:01:46.15,teks umum,,0,0,0,,Apakah kamu sedekat itu dengan Yul?
Dialog: 0,1:01:47.77,1:01:49.86,teks umum,,0,0,0,,Perhatian. Aku masih melihat tanda di matamu
Dialog: 0,1:01:51.11,1:01:52.86,teks umum,,0,0,0,,Saya menggunakan obat tetes mata
Dialog: 0,1:01:53.82,1:01:56.49,teks umum,,0,0,0,,Saya tidak melihat tanda di cermin. Anda bisa melihatnya, bukan?
Dialog: 0,1:01:56.58,1:01:58.12,teks umum,,0,0,0,,Inilah penampilanmu
Dialog: 0,1:01:58.20,1:02:00.16,teks umum,,0,0,0,,Jika kamu benar-benar menyukainya, beginilah cara kamu harus mendekatinya
Dialog: 0,1:02:00.25,1:02:02.04,teks umum,,0,0,0,,Hati-hati dengan cinta
Dialog: 0,1:02:03.79,1:02:05.08,teks umum,,0,0,0,,Hanya kamu yang boleh membiarkanku masuk seperti itu
Dialog: 0,1:02:07.75,1:02:10.34,teks umum,,0,0,0,,Oke. Sekarang hanya Anda yang bisa
Dialog: 0,1:02:12.30,1:02:14.13,teks umum,,0,0,0,,Aku akan berusaha untuk tidak jatuh cinta pada Yulia
Dialog: 0,1:02:15.84,1:02:16.89,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:16.97,1:02:19.06,teks umum,,0,0,0,,Mengapa ini memerlukan usaha?
Dialog: 0,1:02:19.77,1:02:21.27,teks umum,,0,0,0,,Dia cantik
Dialog: 0,1:02:21.35,1:02:24.19,teks umum,,0,0,0,,Dibutuhkan usaha untuk tidak jatuh cinta pada pria tampan
Dialog: 0,1:02:24.27,1:02:25.48,teks umum,,0,0,0,,Dan aku?
Dialog: 0,1:02:25.56,1:02:28.73,teks umum,,0,0,0,,Menurutku jauh lebih sulit untuk tidak jatuh cinta padaku
Dialog: 0,1:02:28.82,1:02:29.94,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,1:02:30.94,1:02:32.82,teks umum,,0,0,0,,Bagaimana tidak? Itu tidak masuk akal
Dialog: 0,1:02:32.90,1:02:35.45,teks umum,,0,0,0,,- Katakanlah itu sulit\N- Ya, tuan
Dialog: 0,1:02:35.53,1:02:37.28,teks umum,,0,0,0,,- Katakan dengan serius\N - Ya
Dialog: 0,1:02:37.37,1:02:39.20,teks umum,,0,0,0,,- Jadi, maukah Anda mengatakan itu?\N- Ya
Dialog: 0,1:02:39.28,1:02:40.70,teks umum,,0,0,0,,Ayo, buat aku tertawa
Dialog: 0,1:04:15.55,1:04:16.72,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,1:04:17.63,1:04:19.89,teks umum,,0,0,0,,Dilihat dari energi pedangmu,
Dialog: 0,1:04:19.97,1:04:22.72,teks umum,,0,0,0,,kamu telah menguasai tingkat tertinggi Ryusu
Dialog: 0,1:04:25.68,1:04:27.31,teks umum,,0,0,0,,Semua terima kasih,
Dialog: 0,1:04:28.39,1:04:29.90,teks umum,,0,0,0,,Deputi Gyeongju
Dialog: 0,1:04:29.98,1:04:32.65,teks umum,,0,0,0,,Satu-satunya yang bisa bersaing denganmu,
Dialog: 0,1:04:32.73,1:04:34.98,teks umum,,0,0,0,,Menurutku hanya Seo Yul dari keluarga Seo
Dialog: 0,1:04:35.82,1:04:39.49,teks umum,,0,0,0,,Yang Mulia Ratu dan ayah Julia, Jenderal Jadi, kakak dan adik
Dialog: 0,1:04:39.57,1:04:41.70,teks umum,,0,0,0,,Yul dan aku sangat dekat saat masih anak-anak,
Dialog: 0,1:04:41.78,1:04:43.70,teks umum,,0,0,0,,tapi semuanya berubah saat dia memasuki Sosnovy Bor
Dialog: 0,1:04:46.12,1:04:49.96,teks umum,,0,0,0,,So Yul, Park Dan Gu, Chan Wook dan Jin Cho Young diketahui
Dialog: 0,1:04:50.04,1:04:51.79,teks umum,,0,0,0,,seperti Four Seasons
Dialog: 0,1:04:52.88,1:04:54.42,teks umum,,0,0,0,,Biarkan mereka bersenang-senang
Dialog: 0,1:04:55.13,1:04:56.05,miring,,0,0,0,,Tunggu
Dialog: 0,1:04:56.13,1:04:58.84,teks umum,,0,0,0,,Mengapa Chan Wook juga termasuk di antara mereka padahal dia tidak memiliki sihir?
Dialog: 0,1:04:59.80,1:05:01.39,teks umum,,0,0,0,,Sekarang dimiliki
Dialog: 0,1:05:02.09,1:05:03.51,teks umum,,0,0,0,,Gerbang energinya terbuka
Dialog: 0,1:05:04.30,1:05:05.97,teks umum,,0,0,0,,Apakah gerbangnya terbuka?
Dialog: 0,1:05:09.27,1:05:11.27,teks umum,,0,0,0,,Tapi dia tidak bisa berbuat banyak
Dialog: 0,1:05:11.35,1:05:13.77,teks umum,,0,0,0,,Dia adalah putra Chang Gan, gwangju Jeonbugwan
Dialog: 0,1:05:15.27,1:05:16.36,teks umum,,0,0,0,,Baru-baru ini
Dialog: 0,1:05:16.44,1:05:19.15,teks umum,,0,0,0,,dia datang dan bertanya tentang pedang Nak Su
Dialog: 0,1:05:21.32,1:05:22.16,teks umum,,0,0,0,,Dan?
Dialog: 0,1:05:25.20,1:05:27.20,kenangan,,0,0,0,,Apakah kamu takut aku akan berhasil?
Dialog: 0,1:05:27.29,1:05:28.58,miring,,0,0,0,,Jadi kamu memberikannya?
Dialog: 0,1:05:28.66,1:05:31.12,teks umum,,0,0,0,,Yang Mulia memerintahkan Anda untuk menyimpannya di Jeonbugwan
Dialog: 0,1:05:31.21,1:05:34.63,teks umum,,0,0,0,,postingan Gwangju milik keluarga Jang
Dialog: 0,1:05:35.29,1:05:36.55,teks umum,,0,0,0,,Tidak ada pilihan
Dialog: 0,1:05:38.88,1:05:40.51,teks umum,,0,0,0,, Kasar sekali
Dialog: 0,1:05:40.59,1:05:42.47,teks umum,,0,0,0,,Dia meremehkanku
Dialog: 0,1:05:43.30,1:05:45.55,teks umum,,0,0,0,,Tetap saja, aku adalah murid ayahnya
Dialog: 0,1:05:45.64,1:05:49.02,teks umum,,0,0,0,,Kalau dipikir-pikir seperti itu, aku resmi bukan muridnya
Dialog: 0,1:05:50.27,1:05:53.15,teks umum,,0,0,0,,Aku tidak punya tempat tujuan saat keluarga Jin mengusirku,
Dialog: 0,1:05:54.06,1:05:56.06,teks umum,,0,0,0,,dia menganggapku sebagai pelayan
Dialog: 0,1:05:56.86,1:05:59.19,teks umum,,0,0,0,,Kamu adalah guru Putra Mahkota negeri ini
Dialog: 0,1:05:59.28,1:06:01.03,teks umum,,0,0,0,,Beraninya dia?
Dialog: 0,1:06:01.11,1:06:02.99,teks umum,,0,0,0,,Rasanya seperti meremehkanku
Dialog: 0,1:06:03.07,1:06:05.20,teks umum,,0,0,0,,Saya minta maaf atas
Dialog: 0,1:06:06.16,1:06:09.29,teks umum,,0,0,0,,bahwa gurumu bukan berasal dari keluarga bangsawan
Dialog: 0,1:06:14.04,1:06:15.29,teks umum,,0,0,0,,Kita harus cepat
Dialog: 0,1:06:16.17,1:06:18.50,teks umum,,0,0,0,,letakkan Chan Wook di tempatnya
Dialog: 0,1:06:39.15,1:06:41.69,teks umum,,0,0,0,,Ini pedang Gwangju Chan, untuk ayah Chan Wook
Dialog: 0,1:06:43.20,1:06:44.28,teks umum,,0,0,0,,entah bagaimana...
Dialog: 0,1:06:45.36,1:06:47.74,teks umum,,0,0,0,,berjanji akan menerimanya jika dia mengungkap
Dialog: 0,1:06:48.49,1:06:50.12,teks umum,,0,0,0,,pedang ayahnya
Dialog: 0,1:06:50.20,1:06:52.79,teks umum,,0,0,0,,Sekarang gerbang energinya terbuka dan ini mungkin
Dialog: 0,1:06:53.37,1:06:56.54,teks umum,,0,0,0,,Maukah kamu mengizinkan dia menjadi penyihir Sosnovy Bor?
Dialog: 0,1:06:58.96,1:07:01.63,teks umum,,0,0,0,,Bawakan Uka
Dialog: 0,1:07:10.97,1:07:14.23,kenangan miring,,0,0,0,,Apa katamu? Siapa ayahnya?
Dialog: 0,1:07:15.02,1:07:16.44,kenangan,,0,0,0,,Mendiang raja
Dialog: 0,1:07:17.81,1:07:19.69,kenangan,,0,0,0,,Dia adalah putra seorang raja!
Dialog: 0,1:07:22.03,1:07:23.65,kenangan,,0,0,0,,Jadi dia adalah putra raja,
Dialog: 0,1:07:24.57,1:07:27.20,kenangan,,0,0,0,,siapa yang meninggal setahun yang lalu?
Dialog: 0,1:07:27.78,1:07:29.12,kenangan,,0,0,0,,Mendiang raja
Dialog: 0,1:07:29.78,1:07:32.62,kenangan,,0,0,0,,meninggal karena sakit, tidak bisa bergerak
Dialog: 0,1:07:32.70,1:07:33.87,kenangan,,0,0,0,,Bagaimana mungkin?
Dialog: 0,1:07:33.95,1:07:35.54,kenangan,,0,0,0,,Di hari ulang tahun bayi ini,
Dialog: 0,1:07:36.50,1:07:39.13,kenangan,,0,0,0,,bintang baru raja bersinar di langit
Dialog: 0,1:07:40.75,1:07:43.63,kenangan,,0,0,0,,Saudara laki-laki mendiang raja telah naik takhta,
Dialog: 0,1:07:44.34,1:07:46.47,kenangan,,0,0,0,,yang akan diwarisi putranya
Dialog: 0,1:07:46.55,1:07:49.68,kenangan,,0,0,0,,Jika keluarga kerajaan mengetahui bahwa ini adalah putra raja,
Dialog: 0,1:07:50.55,1:07:52.39,kenangan,,0,0,0,,mereka akan merasakannya
Dialog: 0,1:07:53.52,1:07:54.81,kenangan,,0,0,0,,sebagai ancaman
Dialog: 0,1:07:59.94,1:08:02.40,kenangan miring,,0,0,0,,Keberadaannya akan membawa kekacauan
Dialog: 0,1:08:03.40,1:08:06.03,kenangan miring,,0,0,0,,Dia seharusnya tidak menarik perhatian pada dirinya sendiri
Dialog: 0,1:08:08.03,1:08:10.53,kenangan miring,,0,0,0,,Orang pasti mengira tidak ada yang aneh pada dirinya
Dialog: 0,1:08:16.29,1:08:18.00,teks umum,,0,0,0,,Saya dengan tulus meminta maaf
Dialog: 0,1:08:18.67,1:08:21.25,teks umum,,0,0,0,,untuk semua soal yang saya buat
Dialog: 0,1:08:23.84,1:08:25.88,teks umum,,0,0,0,,Sosnovy Bor memutuskan
Dialog: 0,1:08:26.55,1:08:28.30,teks umum,,0,0,0,,buka gerbang energimu,
Dialog: 0,1:08:29.01,1:08:30.68,teks umum,,0,0,0,,oleh karena itu tanggung jawab bukan terletak pada anda
Dialog: 0,1:08:32.22,1:08:34.18,teks umum,,0,0,0,,Saya, Chan Wook, putra sulung keluarga Chan,
Dialog: 0,1:08:34.26,1:08:36.06,teks umum,,0,0,0,,siap belajar dan berlatih
Dialog: 0,1:08:36.89,1:08:39.27,teks umum,,0,0,0,,Jika Sosnovy Bor memberiku kesempatan, aku akan melakukan yang terbaik
Dialog: 0,1:08:40.52,1:08:42.65,teks umum,,0,0,0,,Sebagai tanda kesetiaanmu,
Dialog: 0,1:08:42.73,1:08:45.57,teks umum,,0,0,0,,Aku akan memberimu pedang Nak Su, yang aku ambil dari Jin Mu,
Dialog: 0,1:08:46.40,1:08:48.15,teks umum,,0,0,0,,sehingga disimpan di gudang senjata Sosnovy Bor
Dialog: 0,1:08:50.91,1:08:52.28,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,1:08:55.70,1:09:00.46,teks umum,,0,0,0,,Pedang itu milik keluarga Chan, biarlah disimpan bersamamu
Dialog: 0,1:09:07.21,1:09:10.43,teks umum,,0,0,0,,Kamu dapat mengambil pedang ayahmu
Dialog: 0,1:09:11.89,1:09:15.97,teks umum,,0,0,0,,Mulai sekarang, aku melarang Chan Wook memasuki Sosnovy Bor
Dialog: 0,1:09:22.02,1:09:23.61,teks umum,,0,0,0,,Anda bebas untuk datang,
Dialog: 0,1:09:24.15,1:09:26.73,teks umum,,0,0,0,,seperti anak seorang teman lama
Dialog: 0,1:09:27.78,1:09:32.70,teks umum,,0,0,0,,Tetapi Anda tidak berhak menjadi pesulap Sosnovy Bor
Dialog: 0,1:09:34.07,1:09:35.74,teks umum,,0,0,0,,Sekarang
Dialog: 0,1:09:35.83,1:09:39.62,teks umum,,0,0,0,,Chan Wook tidak akan memiliki akses ke apa pun di hutan
Dialog: 0,1:09:42.67,1:09:46.88,teks umum,,0,0,0,,Beri aku jimat yang memungkinkanmu lewat sini
Dialog: 0,1:09:51.97,1:09:53.22,teks umum,,0,0,0,,Saya tidak memilikinya
Dialog: 0,1:09:54.01,1:09:54.84,teks umum,,0,0,0,,Apa?
Dialog: 0,1:09:56.81,1:09:58.14,teks umum,,0,0,0,,Aku tersesat
Dialog: 0,1:10:00.85,1:10:02.02,teks umum,,0,0,0,,jimat roh
Dialog: 0,1:10:02.10,1:10:04.60,teks umum,,0,0,0,,Hukuman apa yang diberikan bagi mereka
Dialog: 0,1:10:05.56,1:10:07.27,teks umum,,0,0,0,,siapa yang akan kehilangan jimatnya?
Dialog: 0,1:10:08.53,1:10:10.53,teks umum,,0,0,0,,Menampar, 100 pukulan, menguasai
Dialog: 0,1:10:10.61,1:10:13.20,teks umum,,0,0,0,,Lalu aku memukul Chan Wook seratus pukulan
Dialog: 0,1:10:13.28,1:10:15.32,teks umum,,0,0,0,,atas hilangnya jimat
Dialog: 0,1:10:51.86,1:10:54.32,teks umum,,0,0,0,,Dia memiliki energi Master Ho, semuanya akan baik-baik saja
Dialog: 0,1:10:54.90,1:10:57.74,teks umum,,0,0,0,,Jika kamu masuk, dia akan mendapat lebih banyak masalah
Dialog: 0,1:11:42.29,1:11:44.37,miring,,0,0,0,,Chan Wook, tinggalkan Sosnovy Bor
Dialog: 0,1:11:44.45,1:11:46.46,teks umum,,0,0,0,,dan tidak muncul lagi disini
Dialog: 0,1:11:51.34,1:11:52.38,teks umum,,0,0,0,,Pergi
Dialog: 0,1:11:54.38,1:11:55.67,teks umum,,0,0,0,,Tidak
Dialog: 0,1:11:55.76,1:11:56.80,teks umum,,0,0,0,,Tidak...
Dialog: 0,1:11:57.63,1:11:58.84,teks umum,,0,0,0,,Saya tidak bisa pergi seperti ini
Dialog: 0,1:12:00.51,1:12:02.60,teks umum,,0,0,0,,Saya dipukul 99 kali
Dialog: 0,1:12:04.56,1:12:05.98,teks umum,,0,0,0,,Satu pukulan tersisa
Dialog: 0,1:12:08.52,1:12:10.02,teks umum,,0,0,0,,Dan yang terakhir ini
Dialog: 0,1:12:11.69,1:12:13.11,teks umum,,0,0,0,,terapkan sendiri
Dialog: 0,1:12:29.87,1:12:32.04,kenangan,,0,0,0,,Aku hanya berusaha menjaga dia tetap aman
Dialog: 0,1:12:32.63,1:12:36.38,kenangan,,0,0,0,,Jika gerbang energinya tidak terbuka, dan dia hidup seperti anakku, dia akan bertahan
Dialog: 0,1:12:36.46,1:12:39.59,kenangan,,0,0,0,,Tetapi jika dia memutuskan untuk mencoba peruntungannya,
Dialog: 0,1:12:41.80,1:12:43.93,kenangan,,0,0,0,,kematian menantinya
Dialog: 0,1:13:00.66,1:13:03.70, sulih suara,,0,0,0,,Uk, menyerah saja
Dialog: 0,1:13:04.99,1:13:06.95,di belakang layar,,0,0,0,,dan hidup dengan tenang
Dialog: 0,1:13:09.04,1:13:10.67,di belakang layar,,0,0,0,,Inilah satu-satunya cara agar kamu bisa bertahan
Dialog: 0,1:13:40.95,1:13:42.20,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:13:44.37,1:13:45.87,teks umum,,0,0,0,,ambil pedang
Dialog: 0,1:14:18.94,1:14:19.78,teks umum,,0,0,0,,Meninggalkan
Dialog: 0,1:15:15.71,1:15:18.08,pratinjau,,0,0,0,,Saya ingin membukanya dan menunjukkannya kepada mereka
Dialog: 0,1:15:18.17,1:15:19.96,pratinjau,,0,0,0,,- Apakah ini manifestasi kebodohan?\N- Tidak, kekuatan
Dialog: 0,1:15:20.04,1:15:21.05,pratinjau,,0,0,0,,Bertahanlah
Dialog: 0,1:15:21.13,1:15:23.26,pratinjau,,0,0,0,,Ada pedang lain yang tidak bisa kamu tarik
Dialog: 0,1:15:23.34,1:15:26.09,pratinjau,,0,0,0,,Tapi itu milik ayahnya
Dialog: 0,1:15:26.18,1:15:28.43,pratinjau,,0,0,0,,Aku harus menjemputnya
Dialog: 0,1:15:28.51,1:15:30.43,pratinjau,,0,0,0,,Siapa pun yang menang akan mengambilnya
Dialog: 0,1:15:30.51,1:15:33.56,pratinjau,,0,0,0,,Melawan pangeran adalah wujud kebodohan
Dialog: 0,1:15:33.64,1:15:37.06,pratinjau,,0,0,0,,Tetapi beberapa orang percaya bahwa ini adalah unjuk kekuatan. Saya harus mencoba
Dialog: 0,1:15:38.10,1:15:40.82,pratinjau,,0,0,0,,Muridku terlalu lemah untuk melawanmu
Dialog: 0,1:15:41.77,1:15:43.48,pratinjau,,0,0,0,,Dia harus berada dalam bahaya lagi
Dialog: 0,1:15:44.24,1:15:46.65,pratinjau,,0,0,0,,Dan dia akan mendapatkan apa yang diinginkannya
Dialog: 0,0:02:57.14,0:02:59.14, torehan,,0,0,0,,

Komentar: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Editor beta: {\c&HFFF4C5&} Sana
