ប្រសិនបើអ្នកធ្លាប់ទៅព្រៃហើយចាប់ផ្តើមងាកទៅរកថ្ម។

01:16:57.450 --> 01:16:59.290
យើងដឹងពីវិធីមួយដើម្បីជួយសង្រ្គោះអ្នក។

01:17:00.540 --> 01:17:01.830
តើ​មាន​ចំណុច​អ្វី?

01:17:02.370 --> 01:17:07.040
ខ្ញុំនឹងត្រូវរស់នៅក្នុងរូបកាយដ៏អាក្រក់នេះអស់មួយជីវិត។

01:17:09.170 --> 01:17:11.920
អ្នកអនុញ្ញាតឱ្យ Chan Wook រស់នៅទោះបីជាឪពុករបស់គាត់មានកំហុសក៏ដោយ។

01:17:12.010 --> 01:17:14.130
តើមានអ្វីកើតឡើងចំពោះខ្ញុំ

01:17:14.220 --> 01:17:15.510
ចាងហ្គាង

01:17:16.090 --> 01:17:18.600
ទទួលខុសត្រូវទាំងស្រុងដោយលះបង់ខ្លួនឯង

01:17:19.510 --> 01:17:21.470
យើងក៏បានដកហូតសិទ្ធិរបស់ Chan Wook ផងដែរ។

01:17:22.350 --> 01:17:25.940
ក្លាយជា gwangju jeonbugwan បន្ទាប់

01:17:27.150 --> 01:17:28.940
គាត់បានលាងជម្រះអំពើបាបរបស់គាត់។

01:17:29.820 --> 01:17:32.190
ដោយបានបាត់បង់អ្វីគ្រប់យ៉ាងដែលខ្ញុំមាន

01:17:34.030 --> 01:17:37.570
នៅពេលដែល Chang Gang ស្លាប់ គាត់បានសារភាពថា Wook មិនមែនជាកូនប្រុសរបស់គាត់ទេ។

01:17:37.660 --> 01:17:39.700
អ្នកមិនអាចទទួលខុសត្រូវលើគាត់ទេ។

01:17:39.780 --> 01:17:43.450
Chang Gang បានស្លាប់ដោយមិនបង្ហាញឈ្មោះឪពុកពិតរបស់ Wook ។

01:17:51.630 --> 01:17:53.260
លោកគ្រូ Chang Gang ចង់បាន

01:17:54.220 --> 01:17:56.510
ដូច្នេះខ្ញុំអាចផ្តល់ឱ្យអ្នក

01:18:01.350 --> 01:18:03.930
លោក​ថា​នឹង​លាតត្រដាង​ការពិត

01:18:04.930 --> 01:18:07.140
អំពី​ឪពុក​ពិត​របស់​លោក Chan Wook

01:18:30.420 --> 01:18:31.590
ខ្ញុំគិតថា

01:18:32.840 --> 01:18:35.880
ឥឡូវ​នេះ អ្នក​ស្រី Kim ដឹង​ការ​ពិត

01:18:37.510 --> 01:18:38.970
ខ្ញុំ​មិន​អាច​ជឿ​វា​បាន​ទេ។

01:18:40.010 --> 01:18:43.810
តើ Lady Do Hwa បានផ្តល់កំណើតដល់កូនប្រុសរបស់ស្តេចដែរឬទេ?

01:18:44.470 --> 01:18:47.640
Uka ត្រូវបានគេចាប់កំណើតនៅពេលដែលស្តេចចុងផ្ទេរព្រលឹងរបស់គាត់ ...

01:18:48.770 --> 01:18:51.480
ហើយដេកជាមួយ Do Hwa

01:18:52.190 --> 01:18:56.530
Chang Gang សម្តែង​អាឡោះអាល័យ និង​ប្តូរ​ព្រលឹង...

01:18:58.570 --> 01:19:00.200
ជាមួយស្តេចចុង

01:19:02.280 --> 01:19:07.120
ចៅហ្វាយ Chang Gan បំផ្លាញជីវិតកូនប្រុសរបស់គាត់។

01:19:08.960 --> 01:19:10.580
បើសុភាពបុរសដឹងរឿងនេះ...

01:19:12.080 --> 01:19:13.670
ខ្ញុំនឹងមិនបង្ហាញរឿងនេះទេ។

01:19:15.170 --> 01:19:18.800
មិនត្រឹមតែ Uku ប៉ុណ្ណោះទេ

01:19:19.970 --> 01:19:21.930
ខ្ញុំនឹងរក្សាការសម្ងាត់នេះពីអ្នករាល់គ្នា

01:19:25.930 --> 01:19:29.270
ផ្កាយដែលលេចឡើងនៅលើមេឃនៅពេលអ្នកបំផ្លាញថ្មទឹកកក

01:19:29.350 --> 01:19:31.730
ត្រូវបានឆ្លាក់នៅលើថេប្លេតក្រុមតារានិករ

01:19:31.810 --> 01:19:35.480
គ្រប់​គ្នា​ត្រេកអរ​នឹង​ទទួល​ព្រះរាជ​បុត្រ​ដែល​កើត​នៅ​ក្រោម​សញ្ញា​ផ្កាយ​របស់​ព្រះមហាក្សត្រ

01:19:35.570 --> 01:19:37.230
តើអ្នកចង់មើលសញ្ញាទេ?

01:19:39.150 --> 01:19:40.320
ទេ

01:19:52.710 --> 01:19:54.090
អនុប្រធាន Gwangju

01:19:55.130 --> 01:19:57.510
បានផ្លាស់ប្តូរព្រលឹងហើយបាត់ខ្លួន?

01:20:28.290 --> 01:20:30.500
តើអ្នកបានលាក់ខ្លួននៅ Jeonbugwan គ្រប់ពេលហើយឬនៅ?

01:20:31.000 --> 01:20:34.210
ខ្ញុំបានរង់ចាំឱកាសដើម្បីជួបអ្នក, សម្តេច

01:20:36.750 --> 01:20:39.170
តើអ្នកសុំឱ្យខ្ញុំជួយសង្គ្រោះជីវិតរបស់អ្នកទេ?

01:20:39.260 --> 01:20:41.880
មានតែអ្នកទេដែលអាចជួយសង្គ្រោះខ្ញុំបាន

01:20:41.970 --> 01:20:45.640
ហើយមានតែខ្ញុំទេដែលអាចការពារអ្នក។

01:20:46.390 --> 01:20:49.140
ការពារខ្ញុំ? មកពីអ្វី?

01:20:49.220 --> 01:20:52.140
ខ្ញុំនឹងការពារអ្នកពីអ្នកស្នងមរតកពិតប្រាកដនៃផ្កាយរបស់ស្តេច

01:20:53.190 --> 01:20:56.440
- តើអ្នកកំពុងនិយាយអំពីអ្វី?
- អ្នកស្គាល់ខ្លួនឯងរួចហើយ

01:20:56.520 --> 01:20:58.940
អ្នកមិនមែនជាអ្នកស្នងពិតទេ។

01:21:04.820 --> 01:21:08.740
បុរសដែលនឹងបំភ្លឺអ្នក... បុរសដែលនឹងត្រូវថ្វាយបង្គំ

01:21:08.830 --> 01:21:12.660
បុរសដែលនឹងបំផ្លាញអ្នក។

01:21:13.250 --> 01:21:14.670
អ្នកគឺជាអ្នកទីពីរនៅក្នុងជួរនៃបល្ល័ង្ក

01:21:14.750 --> 01:21:17.710
Chang Wook ដែលជាអ្នកស្នងមរតកតារា មិនគួរត្រូវបានអនុញ្ញាតទេ។

01:21:18.500 --> 01:21:19.750
កើនឡើងពីលើអ្នក។

01:21:21.920 --> 01:21:26.590
ខ្ញុំសន្យាថានឹងរំដោះអ្នកចេញពីពន្លឺដ៏អាក្រក់នេះ។

01:21:32.390 --> 01:21:34.640
រឿងតែមួយគត់ដែលខ្ញុំអស់សង្ឃឹម...

01:21:37.350 --> 01:21:39.110
តាមពិតជាកម្មសិទ្ធិរបស់ Chan Wook

01:22:07.010 --> 01:22:10.180
ផ្អែមប៉ុណ្ណា។ អ្នកគឺស្រស់ស្អាត

01:22:11.760 --> 01:22:14.480
អ្នកមើលទៅអស្ចារ្យណាស់។

01:22:16.640 --> 01:22:18.100
ជូតទឹកមាត់

01:22:18.690 --> 01:22:20.810
- អ្នកអាចយកវាចេញឥឡូវនេះ
- ហេតុអ្វីបានជាអ្នក ...

01:22:20.900 --> 01:22:23.650
តើនាងថែមទាំងសុំឱ្យខ្ញុំពាក់អាវនេះទេ? ហេតុអ្វីមិនកូនក្រមុំ?

01:22:23.730 --> 01:22:27.070
ឪពុក​របស់​នាង​មាន​សភាព​ធ្ងន់ធ្ងរ ដូច្នេះ​នាង​មិន​អាច​មក​បាន​ទេ។

01:22:27.150 --> 01:22:29.530
អ្នក​និង​នាង​មាន​រូប​រាង​ស្រដៀង​គ្នា​ដូច្នេះ

01:22:30.120 --> 01:22:31.330
អ្នកអាចផ្លាស់ប្តូរសម្លៀកបំពាក់របស់អ្នក។

01:22:32.870 --> 01:22:35.120
មក។ តោះទៅដើម្បីអោយនាងផ្លាស់ប្តូរសំលៀកបំពាក់

01:22:35.870 --> 01:22:38.790
- ឈប់សម្លឹងមើល។ តោះទៅ
- នាងជាស្រីស្អាតបំផុតដែលខ្ញុំធ្លាប់ឃើញ

01:22:38.870 --> 01:22:40.210
វាជាការពិត

01:22:44.000 --> 01:22:45.130
ខ្ញុំគិតថា

01:22:46.090 --> 01:22:47.720
ខ្ញុំមើលទៅគួរឱ្យស្រលាញ់

01:22:49.550 --> 01:22:50.640
រង់ចាំ

01:22:50.720 --> 01:22:52.470
តើ Moo Deok នៅទីនេះទេ? តើនាងនៅឯណា?

01:22:52.560 --> 01:22:53.810
ពេលនេះ Moo Deok...

01:22:56.640 --> 01:22:58.440
នាងនៅក្នុងបន្ទប់នោះ។

01:22:58.520 --> 01:22:59.980
- ចូលមក
- មិនអីទេ។

01:23:10.700 --> 01:23:11.950
អីយ៉ា...

01:23:12.740 --> 01:23:15.080
ខ្ញុំ​ឮ​គេ​រៀប​ការ​ឆាប់ៗ​នេះ។

01:23:15.870 --> 01:23:16.790
មែនទេ?

01:23:17.710 --> 01:23:18.710
ទេ

01:23:23.840 --> 01:23:25.710
មើល នេះជាគ្រូរបស់ខ្ញុំ

01:23:26.460 --> 01:23:28.590
ខ្ញុំបានប្រាប់អ្នកឱ្យរង់ចាំខ្ញុំនៅ Saejukwon

01:23:28.670 --> 01:23:31.510
- ហេតុអ្វីបានជាអ្នកនៅទីនេះ?
- Ho Yeom ផ្ញើស្រាឱ្យខ្ញុំ

01:23:31.590 --> 01:23:33.260
Ah Joo Wol បានសុំឱ្យអ្នកពាក់អាវនេះ។

01:23:33.350 --> 01:23:36.180
ខ្ញុំត្រូវផ្លាស់ប្តូរសម្លៀកបំពាក់។ រង់ចាំនៅខាងក្រៅ

01:23:36.270 --> 01:23:37.560
ទេ រង់ចាំ

01:23:37.640 --> 01:23:40.770
កន្លែងនេះគឺសមរម្យ។ នេះជាកន្លែងដែលយើងជួបគ្នាដំបូង

01:23:42.310 --> 01:23:43.980
សាកសមសម្រាប់អ្វី?

01:23:45.820 --> 01:23:48.190
សម្រាប់​ពិធី​នេះ​យើង​ត្រូវ​ធ្វើ

01:23:49.150 --> 01:23:50.820
ជាដំបូងនៃការទាំងអស់អង្គុយនៅទីនេះ

01:24:01.710 --> 01:24:03.170
តើមានអ្វីកើតឡើង?

01:24:04.000 --> 01:24:05.210
នេះជាជម្រើស

01:24:08.840 --> 01:24:12.260
បញ្ឈប់វា។ អ្នកធ្វើឱ្យខ្ញុំអាម៉ាស់។ តើអ្នកមានបញ្ហាអ្វី?

01:24:17.430 --> 01:24:19.310
វា​គ្រាន់​តែ​យល់​ច្រឡំ​ពី​ដំបូង

01:24:19.390 --> 01:24:21.190
ប៉ុន្តែបន្ទាប់ពីលើកទី 13 អ្នកស៊ាំនឹងវា។

01:24:22.480 --> 01:24:23.560
អ្វី?

01:24:24.190 --> 01:24:26.270
តើអ្នកបានស្នើ 13 ដងទេ?

01:24:28.780 --> 01:24:29.900
គ្រូ

01:24:30.610 --> 01:24:34.160
ថ្ងៃនេះខ្ញុំចង់បញ្ចប់ការសិក្សាជាមួយអ្នក

01:24:37.240 --> 01:24:40.250
អរគុណដែលធ្វើអោយខ្ញុំខំប្រឹង

01:24:40.830 --> 01:24:43.080
ទោះបីជាខ្ញុំជាមនុស្សឆ្កួតទាំងស្រុងក៏ដោយ។

01:24:45.250 --> 01:24:46.420
ខ្ញុំដឹង

01:24:46.500 --> 01:24:48.880
អ្នកបានចាកចេញពីឱកាសដើម្បីទទួលបានអំណាចរបស់អ្នកឡើងវិញ

01:24:49.670 --> 01:24:52.930
ដូច​ជា​ខ្ញុំ​បាន​លះបង់​ថាមពល​ដែល​ខ្ញុំ​ចង់​ធ្វើ​ជា​ម្ចាស់។

01:24:53.720 --> 01:24:57.760
ប៉ុន្តែ​ខ្ញុំ​មាន​អ្វី​មួយ​ដែល​ខ្ញុំ​ចង់​នៅ​ក្បែរ​ខ្ញុំ​ពេញ​មួយ​ជីវិត

01:25:01.560 --> 01:25:05.980
ខ្ញុំ​មិន​ចង់​ប្រើ​ហើយ​បោះ​ចោល​ទេ។ ខ្ញុំចង់ការពារ និងថែរក្សា

01:25:06.650 --> 01:25:09.610
ដូច្នេះ ... អនុញ្ញាតឱ្យខ្ញុំទៅ

01:25:14.990 --> 01:25:16.490
លោកគ្រូ អ្នកគ្រូ មូ ឌុក

01:25:17.570 --> 01:25:19.700
អនុញ្ញាតឱ្យសិស្សរបស់គាត់ Chan Wook ចាកចេញ

01:25:24.460 --> 01:25:25.500
មិនអីទេ...

01:25:26.710 --> 01:25:29.550
រៀបការជាមួយខ្ញុំ Moo Deok?

01:25:52.670 --> 01:25:56.970
សូមអរគុណសម្រាប់ការទស្សនាជាមួយពួកយើង!
ដូរ៉ាម៉ាម៉ានី

01:25:57.060 --> 01:26:00.100
Alchemy

01:25:57.060 --> 01:26:00.100
ផ្កាឈូក

01:26:01.830 --> 01:26:04.580
ខ្ញុំបានសម្រេចចិត្តរៀបការជាមួយម្ចាស់

01:26:04.660 --> 01:26:05.870
អ្នក​មិន​បាន​សូម្បី​តែ​មាន​មិត្ត​ស្រី​

01:26:05.960 --> 01:26:07.670
វាទាំងអស់សម្រាប់ Moo Deok

01:26:07.750 --> 01:26:08.670
មិនអាចទៅរួច!

01:26:08.750 --> 01:26:12.550
ខ្ញុំ​នឹង​រក​ឃើញ​ដាវ​មួយ​ដែល​អាច​ឱ្យ​អ្នក​សម្លាប់ Chan Wook

01:26:12.630 --> 01:26:14.970
Jin Mu ត្រូវតែស្លាប់

01:26:15.050 --> 01:26:18.590
តើ​អ្នក​និយាយ​ថា​ពួកគេ​ទាំង​អស់​គ្នា​បញ្ឆោត​ខ្ញុំ​ហើយ​ចំអក​ឱ្យ​ខ្ញុំ​?

01:26:18.680 --> 01:26:20.970
ពួកគេកំពុងព្យាយាមការពារ Chan Wook

01:26:21.050 --> 01:26:23.100
ឃាតករ​បង្ហាញ​ខ្លួន​នៅ​ Sejukwon

01:26:23.180 --> 01:26:25.100
ខ្ញុំគិតថាសាកសពរបស់ Moo Deok ដើមឡើយជារបស់...

01:26:25.180 --> 01:26:27.100
នរណាម្នាក់ដែលមានអំណាចដ៏ទេវភាព

01:26:28.270 --> 01:26:31.980
Nak Soo អ្នកបានផ្តល់ក្តីសង្ឃឹមឱ្យខ្ញុំ
