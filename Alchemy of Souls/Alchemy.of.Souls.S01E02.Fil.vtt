Dialogue: 0,0:02:47.34,0:02:49.34,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:49.34,0:02:51.34,nicks,,0,0,0,,Coordinator assistants:{\c&HFFF4C5&} Sana, Martini
Dialogue: 0,0:02:51.34,0:02:53.34,nicks,,0,0,0,,Mga tagasalin ng Typesetter: {\c&HFFF4C5&} Ria_Lee, tommo
Dialogue: 0,0:00:44.82,0:00:47.90,mga inskripsiyon,,0,0,0,,20 taon na ang nakalipas
Dialogue: 0,0:01:04.38,0:01:05.92,mga alaala na italics,,0,0,0,,Madam...
Dialogue: 0,0:01:09.84,0:01:11.97,mga alaala,,0,0,0,,Dapat maging akin si Do Hwa
Dialogue: 0,0:01:12.05,0:01:14.68,mga alaala,,0,0,0,,Kung mabuntis siya, akin na ang bata
Dialogue: 0,0:01:23.40,0:01:24.73,mga alaala,,0,0,0,,Mr...
Dialogue: 0,0:01:24.81,0:01:26.40,memories,,0,0,0,,Saan ka pupunta sir?
Dialogue: 0,0:01:37.08,0:01:38.79,mga alaala,,0,0,0,,Narinig ko ang tungkol kay Do Hwa
Dialogue: 0,0:01:39.37,0:01:41.00,mga alaala,,0,0,0,,Papunta lang kami doon
Dialogue: 0,0:01:41.08,0:01:45.00,mga alaala,,0,0,0,,Bakit nandito ka at wala sa libing?
Dialogue: 0,0:01:45.71,0:01:48.75,mga alaala,,0,0,0,,Nandito ako dahil ito lang ang paraan para mabago ang kanyang kapalaran
Dialogue: 0,0:02:08.32,0:02:09.32,mga alaala,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:02:35.43,0:02:37.34,mga alaala,,0,0,0,,Anong ginawa mo?
Dialogue: 0,0:02:37.43,0:02:39.47,memories,,0,0,0,,sinara ko ang energy gate niya
Dialogue: 0,0:02:40.31,0:02:42.77,mga alaala,,0,0,0,,Hindi siya makakapag-spell
Dialogue: 0,0:02:45.94,0:02:49.36,mga alaala,,0,0,0,,Pinagbabawalan ko ang sinuman na buksan ang gate na ito
Dialogue: 0,0:02:50.11,0:02:54.11,mga alaala,,0,0,0,,Paano mo ito magagawa sa iyong anak?
Dialogue: 0,0:02:56.03,0:02:57.24,mga alaala,,0,0,0,,Kasama ang iyong anak?
Dialogue: 0,0:03:06.54,0:03:08.71,memories,,0,0,0,,Bakit niya kontrolado ang destiny ko?
Dialogue: 0,0:03:10.00,0:03:12.21,mga alaala,,0,0,0,,Gayunpaman, walang nagtuturing sa kanya na aking tunay na ama
Dialogue: 0,0:03:13.01,0:03:14.17,mga alaala,,0,0,0,,I'll find someone
Dialogue: 0,0:03:14.80,0:03:16.63,mga alaala,,0,0,0,,Guro na maghahayag ng aking kapangyarihan
Dialogue: 0,0:03:16.72,0:03:18.72,mga alaala,,0,0,0,,at magturo ng mahika
Dialogue: 0,0:03:19.68,0:03:21.51,mga alaala,,0,0,0,,Ako mismo ang hahanapin niya
Dialogue: 0,0:03:22.76,0:03:25.23,mga alaala,,0,0,0,,At pagkatapos ay aalisin ko ang espadang ito at hahatiin ito sa dalawa
Dialogue: 0,0:03:30.40,0:03:34.23,behind the scenes,,0,0,0,,Nagpalit ako ng 12 teacher, pinalayas ako sa kung saan-saan
Dialogue: 0,0:03:36.03,0:03:39.45,behind the scenes,,0,0,0,,At sa wakas nahanap ko na ang magpapabago sa aking kapalaran
Dialogue: 0,0:03:51.08,0:03:52.92,general text,,0,0,0,,Naintindihan ko lahat sa una naming pagkikita
Dialogue: 0,0:03:54.67,0:03:56.05,pangkalahatang teksto,,0,0,0,,Ikaw ang aking guro
Dialogue: 0,0:04:06.93,0:04:10.48,general text,,0,0,0,,Sa tingin mo ba may kakaiba sa akin,
Dialogue: 0,0:04:10.56,0:04:11.61,pangkalahatang teksto,,0,0,0,,master?
Dialogue: 0,0:04:14.57,0:04:16.44,general text,,0,0,0,,Sabi ko sayo maganda ang mata
Dialogue: 0,0:04:16.53,0:04:18.86,general text,,0,0,0,,Ay, sorry. Tanging mata
Dialogue: 0,0:04:20.53,0:04:23.03,pangkalahatang teksto,,0,0,0,,Nakatatak sa kanila ang asul na marka ng nomad
Dialogue: 0,0:04:24.79,0:04:26.70,behind the scenes,,0,0,0,,Kaya ang marka ay nasa aking mga mata
Dialogue: 0,0:04:31.08,0:04:32.38,general text,,0,0,0,,Aawayin mo ba ako?
Dialogue: 0,0:04:32.46,0:04:34.17,pangkalahatang teksto,,0,0,0,,Hindi ka mahirap patayin
Dialogue: 0,0:04:34.75,0:04:36.05,pangkalahatang teksto,,0,0,0,,Ngunit ito si Sosnovy Bor
Dialogue: 0,0:04:36.80,0:04:38.22,general text,,0,0,0,,Mahuhuli ka
Dialogue: 0,0:04:50.73,0:04:52.81,pangkalahatang teksto,,0,0,0,,Sinusubukan kong iligtas ka
Dialogue: 0,0:04:52.90,0:04:55.94,general text,,0,0,0,,Kung mananatili ka sa akin, hindi ka mahuhuli
Dialogue: 0,0:05:09.91,0:05:12.12,general text,,0,0,0,,Paano mo ako dapat kontakin kung gusto mong mag-lay low?
Dialogue: 0,0:05:14.63,0:05:15.92,pangkalahatang teksto,,0,0,0,,"Master"
Dialogue: 0,0:05:29.10,0:05:30.10,pangkalahatang text,,0,0,0,,Chan Wook?
Dialogue: 0,0:05:30.77,0:05:31.98,pangkalahatang text,,0,0,0,,Oo, ako ito
Dialogue: 0,0:05:32.48,0:05:33.94,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:05:37.69,0:05:38.73,pangkalahatang teksto,,0,0,0,,At sino ito?
Dialogue: 0,0:05:40.11,0:05:40.94,pangkalahatang teksto,,0,0,0,,Ah, eksakto
Dialogue: 0,0:05:42.24,0:05:44.20,pangkalahatang teksto,,0,0,0,,Ito si Moo Deok, aking kasambahay
Dialogue: 0,0:05:46.83,0:05:48.04,pangkalahatang teksto,,0,0,0,,Mu Dok?
Dialogue: 0,0:05:50.70,0:05:54.96,general text,,0,0,0,,Yul, tinakot mo siya. Ibaba mo ang iyong espada
Dialogue: 0,0:05:59.80,0:06:01.72,general text,,0,0,0,,Moo Dok, okay ka lang?
Dialogue: 0,0:06:04.59,0:06:05.64,pangkalahatang teksto,,0,0,0,,Mu Dok?
Dialogue: 0,0:06:08.10,0:06:10.02,pangkalahatang teksto,,0,0,0,,Okay, master
Dialogue: 0,0:06:12.48,0:06:13.56,pangkalahatang teksto,,0,0,0,,Uk?
Dialogue: 0,0:06:14.35,0:06:15.27,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:06:16.61,0:06:19.19,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:06:19.27,0:06:22.82,general text,,0,0,0,,dumating ako sa chapter. Nakarinig ng away at nagtago dito
Dialogue: 0,0:06:23.53,0:06:26.32,general text,,0,0,0,,May mga mersenaryo doon, pero hindi ka makakalaban
Dialogue: 0,0:06:26.41,0:06:29.28,pangkalahatang text,,0,0,0,,Swerteng hindi ka nahuli
Dialogue: 0,0:06:29.37,0:06:30.83,pangkalahatang text,,0,0,0,,Hindi pwede...
Dialogue: 0,0:06:30.91,0:06:33.25,pangkalahatang teksto,,0,0,0,,Magaling sa pagtatago
Dialogue: 0,0:06:33.33,0:06:36.54,general text,,0,0,0,,Tumakbo ang maid ko, at sinundan ko siya, ikaw...
Dialogue: 0,0:06:36.63,0:06:37.88,general text,,0,0,0,,Masakit...
Dialogue: 0,0:06:38.63,0:06:40.34,pangkalahatang teksto,,0,0,0,,Sino ito?
Dialogue: 0,0:06:45.38,0:06:46.72,pangkalahatang teksto,,0,0,0,,At anong uri ng kutsilyo?
Dialogue: 0,0:06:53.43,0:06:54.27,pangkalahatang teksto,,0,0,0,,Ikaw...
Dialogue: 0,0:06:57.48,0:06:59.40,general text,,0,0,0,,sinubukan siyang protektahan kasama nila?
Dialogue: 0,0:07:00.36,0:07:02.15,pangkalahatang teksto,,0,0,0,,Proud of you
Dialogue: 0,0:07:02.23,0:07:05.53,pangkalahatang teksto,,0,0,0,,Tama. Ang iyong may-ari ay mahina pa rin,
Dialogue: 0,0:07:05.61,0:07:07.53,pangkalahatang teksto,,0,0,0,,dapat itong protektahan
Dialogue: 0,0:07:09.70,0:07:10.87,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:07:10.95,0:07:13.16,pangkalahatang teksto,,0,0,0,,poprotektahan ko ang aking panginoon
Dialogue: 0,0:07:14.20,0:07:16.50,pangkalahatang teksto,,0,0,0,,Hindi. Hindi salamat
Dialogue: 0,0:07:17.75,0:07:20.54,pangkalahatang teksto,,0,0,0,,dapat kitang protektahan
Dialogue: 0,0:07:22.00,0:07:23.34,pangkalahatang teksto,,0,0,0,,Ang ganda ng pagkakahawak...
Dialogue: 0,0:07:24.09,0:07:25.17,pangkalahatang teksto,,0,0,0,,Hayaan mo
Dialogue: 0,0:07:33.22,0:07:36.77,general text,,0,0,0,,Hoy Moo Deok, huwag kang ganyan!
Dialogue: 0,0:07:37.48,0:07:38.69,pangkalahatang teksto,,0,0,0,,Tumingin sa ibaba
Dialogue: 0,0:07:41.19,0:07:43.57,pangkalahatang teksto,,0,0,0,,Oo, master
Dialogue: 0,0:07:44.86,0:07:47.11,general text,,0,0,0,,Kaya ikaw ang tumakas sa akin
Dialogue: 0,0:07:47.20,0:07:48.53,general text,,0,0,0,,Moo Dok, tama ba?
Dialogue: 0,0:07:49.49,0:07:50.99,pangkalahatang teksto,,0,0,0,,Paumanhin sa pananakot
Dialogue: 0,0:08:03.30,0:08:04.88,general text,,0,0,0,,Hindi ka ba nasaktan?
Dialogue: 0,0:08:17.73,0:08:18.77,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,0:08:19.64,0:08:22.15,general text,,0,0,0,,Okay lang ako, master
Dialogue: 0,0:08:25.15,0:08:27.24,general text,,0,0,0,,- Natahimik na ba ang lahat?\N- Hindi
Dialogue: 0,0:08:27.32,0:08:28.49,general text,,0,0,0,,Panic pa rin ang lahat
Dialogue: 0,0:08:29.07,0:08:31.03,general text,,0,0,0,,Nawala ang katawan ng nomad na si Nak Su
Dialogue: 0,0:08:32.37,0:08:34.99,behind the scenes,,0,0,0,,As I thought, ang mga tao ni Dan Zhu
Dialogue: 0,0:08:35.08,0:08:37.70,behind the scenes,,0,0,0,,Ngayon ang kailangan ko lang gawin ay makaalis dito ng buhay
Dialogue: 0,0:08:38.41,0:08:40.17,pangkalahatang teksto,,0,0,0,,Sayang
Dialogue: 0,0:08:40.92,0:08:42.17,pangkalahatang teksto,,0,0,0,,Nomad
Dialogue: 0,0:08:42.25,0:08:44.29,pangkalahatang text,,0,0,0,,Mersenaryong Nak Su
Dialogue: 0,0:08:45.55,0:08:49.09,general text,,0,0,0,,Lagi kong iniisip kung ano ang hitsura niya
Dialogue: 0,0:08:51.22,0:08:53.51,voiceover,,0,0,0,,Kilala niya kung sino ako
Dialogue: 0,0:08:53.60,0:08:55.85,offscreen,,0,0,0,,Kailangan natin siyang patayin bago umalis
Dialogue: 0,0:09:00.48,0:09:03.56,pangkalahatang teksto,,0,0,0,,Malamang na sinira nila ang harang at nakatakas
Dialogue: 0,0:09:16.87,0:09:18.66,pangkalahatang teksto,,0,0,0,,Kaya nasira ang hadlang
Dialogue: 0,0:09:18.75,0:09:21.08,general text,,0,0,0,,- Nasa likod namin sila\N- Huli na
Dialogue: 0,0:09:22.62,0:09:25.13,pangkalahatang teksto,,0,0,0,,Maaari lamang masira ang hadlang gamit ang boron
Dialogue: 0,0:09:26.25,0:09:28.00,general text,,0,0,0,,May traydor sa atin
Dialogue: 0,0:09:29.71,0:09:31.93,general text,,0,0,0,,Dapat humingi tayo ng tulong sa pamilya Jin
Dialogue: 0,0:09:38.60,0:09:41.69,general text,,0,0,0,,Nasa secret room ang katawan ni Nak Su
Dialogue: 0,0:09:42.77,0:09:46.19,general text,,0,0,0,,Uk, wala ka bang nakitang kakaiba habang nagtatago ka?
Dialogue: 0,0:09:46.27,0:09:47.82,pangkalahatang teksto,,0,0,0,,Kakaiba?
Dialogue: 0,0:09:47.90,0:09:50.65,pangkalahatang teksto,,0,0,0,,Hindi. Pinapanood ko lang si Moo Deok
Dialogue: 0,0:09:55.12,0:09:58.66,general text,,0,0,0,,Sa tingin mo ba lumipat ang kaluluwa ni Nak Soo sa katawan ng ibang babae
Dialogue: 0,0:09:58.74,0:10:00.16,general text,,0,0,0,,at iyon ang dahilan kung bakit siya dumating para sa kanyang katawan?
Dialogue: 0,0:10:04.04,0:10:06.46,general text,,0,0,0,,Pwede bang babae lang ang lumipat sa babae?
Dialogue: 0,0:10:06.54,0:10:07.67,italics,,0,0,0,,Hindi talaga
Dialogue: 0,0:10:07.75,0:10:11.34,general text,,0,0,0,,Ngunit para maging maayos ang lahat, pinipili nila ang mga taong katulad nila
Dialogue: 0,0:10:11.42,0:10:14.22,pangkalahatang teksto,,0,0,0,, Kasarian, edad at pangangatawan. Dapat pareho ang lahat
Dialogue: 0,0:10:16.14,0:10:17.72,general text,,0,0,0,,I'm asking because I haven't seen her
Dialogue: 0,0:10:17.80,0:10:21.85,general text,,0,0,0,,Payat at maikli ba si Nak Su?
Dialogue: 0,0:10:21.93,0:10:24.60,general text,,0,0,0,,Na may bilog na mukha tulad ni Moo Deok?
Dialogue: 0,0:10:24.69,0:10:26.52,behind the scenes,,0,0,0,,Anong meron sa kanya?
Dialogue: 0,0:10:29.11,0:10:32.65,pangkalahatang teksto,,0,0,0,,Kung ganoon, hindi magiging “Nak Su” ang kanyang pangalan
Dialogue: 0,0:10:32.74,0:10:33.61,italics,,0,0,0,,Tingnan mo siya
Dialogue: 0,0:10:34.40,0:10:37.16,general text,,0,0,0,,Sino bang mersenaryo ang magiging cute na cute?
Dialogue: 0,0:10:38.03,0:10:39.03,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:10:39.12,0:10:41.37,general text,,0,0,0,,sa tingin ko halimaw siya
Dialogue: 0,0:10:41.45,0:10:43.62,pangkalahatang teksto,,0,0,0,,Hindi. Siya ay isang tao
Dialogue: 0,0:10:45.50,0:10:48.54,pangkalahatang teksto,,0,0,0,,Huwag nating pagsalitaan ng masama ang namatay, kahit na siya ay isang mamamatay-tao
Dialogue: 0,0:10:54.47,0:10:56.51,general text,,0,0,0,,Gusto kang makita ni Master Ho Yeom
Dialogue: 0,0:10:56.59,0:10:58.55,pangkalahatang text,,0,0,0,,Go without me. Hindi pa rin niya ako gusto
Dialogue: 0,0:10:58.64,0:11:00.35,pangkalahatang teksto,,0,0,0,, Eksakto. Manatili ka rito, mas ligtas
Dialogue: 0,0:11:00.43,0:11:01.60,general text,,0,0,0,,Let's go
Dialogue: 0,0:11:13.07,0:11:14.82,pangkalahatang teksto,,0,0,0,,Na-freeze ang katawan dito
Dialogue: 0,0:11:14.90,0:11:18.70,pangkalahatang teksto,,0,0,0,,Walang amoy nabubulok, ibig sabihin ay maayos ang iyong katawan
Dialogue: 0,0:11:20.66,0:11:21.70,pangkalahatang teksto,,0,0,0,,Nak Su
Dialogue: 0,0:11:23.33,0:11:24.50,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:11:25.33,0:11:27.67,general text,,0,0,0,,Ako ay isang assassin
Dialogue: 0,0:11:30.38,0:11:31.67,pangkalahatang teksto,,0,0,0,,Nak Su
Dialogue: 0,0:11:36.38,0:11:38.59,general text,,0,0,0,,Matagal kong sinubukang intindihin kung bakit mo ako tinulungan
Dialogue: 0,0:11:40.85,0:11:42.68,general text,,0,0,0,, pinadalhan ka rin ni Dan Zhu?
Dialogue: 0,0:11:42.76,0:11:45.18,general text,,0,0,0,,Hindi, walang nagpadala sa akin
Dialogue: 0,0:11:45.27,0:11:47.19,general text,,0,0,0,,Kung gayon bakit mo ako tinulungan?
Dialogue: 0,0:11:47.27,0:11:50.65,general text,,0,0,0,,Sinabi ko sa iyo, ngunit tila hindi mo ito nakuha
Dialogue: 0,0:11:53.40,0:11:54.73,mga alaala,,0,0,0,,You have beautiful eyes
Dialogue: 0,0:11:55.49,0:11:56.74,pangkalahatang teksto,,0,0,0,,Huwag magsalita,
Dialogue: 0,0:11:58.03,0:11:59.28,general text,,0,0,0,,na umibig ako
Dialogue: 0,0:12:01.57,0:12:02.62,pangkalahatang teksto,,0,0,0,,Huwag tumawa
Dialogue: 0,0:12:03.20,0:12:05.37,general text,,0,0,0,,Wala pa rin akong nakikitang ibang dahilan
Dialogue: 0,0:12:05.45,0:12:07.37,general text,,0,0,0,,Aaminin ko, tinawag kitang maganda ng higit sa isang beses
Dialogue: 0,0:12:08.37,0:12:10.21,pangkalahatang teksto,,0,0,0,,Ngunit dahil lamang sa ginawa ko ang aking mga layunin
Dialogue: 0,0:12:10.83,0:12:12.00,pangkalahatang teksto,,0,0,0,,At alin?
Dialogue: 0,0:12:12.67,0:12:16.97,pangkalahatang teksto,,0,0,0,,Naghahanap ako ng isang guro na sisira sa spell at tuturuan ako ng mahika
Dialogue: 0,0:12:17.76,0:12:19.22,pangkalahatang teksto,,0,0,0,,At nahanap kita,
Dialogue: 0,0:12:21.22,0:12:22.30,pangkalahatang teksto,,0,0,0,,Nak Su
Dialogue: 0,0:12:23.10,0:12:25.06,pangkalahatang teksto,,0,0,0,,Maging panginoon ko
Dialogue: 0,0:12:40.99,0:12:42.12,general text,,0,0,0,,Narinig ko,
Dialogue: 0,0:12:42.20,0:12:44.24,pangkalahatang teksto,,0,0,0,,hiniram mo ang espiritu ng Sapsari* ng pamilya Jin
Dialogue: 0,0:12:42.20,0:12:44.24,notes,,0,0,0,,*shaggy dog ng South Korean breed, pinaniniwalaan na ang mga asong ito ay nakapagpapalayas ng masasamang espiritu
Dialogue: 0,0:12:44.33,0:12:45.29,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:12:45.87,0:12:49.33,general text,,0,0,0,,Sigurado ka bang nasa Sosnovy Bor siya?
Dialogue: 0,0:12:49.41,0:12:50.50,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:12:51.54,0:12:55.25,pangkalahatang teksto,,0,0,0,,Nagtatago ang nomad sa isang lugar dito
Dialogue: 0,0:12:59.72,0:13:01.72,pangkalahatang teksto,,0,0,0,,Anak ni Chang Gan mula kay Sosnovy Bor
Dialogue: 0,0:13:01.80,0:13:04.26,general text,,0,0,0,,humihiling sa pumatay na maging mentor?
Dialogue: 0,0:13:05.93,0:13:07.68,pangkalahatang teksto,,0,0,0,,Anong kalokohan
Dialogue: 0,0:13:09.35,0:13:12.81,pangkalahatang teksto,,0,0,0,,Bubuksan mo ang mga pintuan ng lakas ng iyong estudyante at tutulungan siyang makabisado ang mga spelling
Dialogue: 0,0:13:13.40,0:13:16.23,general text,,0,0,0,,Bilang estudyante mo, tutulungan kitang magtago
Dialogue: 0,0:13:16.32,0:13:19.65,general text,,0,0,0,,Magkakaroon tayo ng magandang relasyon na mapapakinabangan nating dalawa
Dialogue: 0,0:13:19.74,0:13:21.61,pangkalahatang teksto,,0,0,0,,- Hindi interesado\N- Ayaw mong maging panginoon ko,
Dialogue: 0,0:13:21.70,0:13:23.41,general text,,0,0,0,,pwede kang maging asawa
Dialogue: 0,0:13:23.49,0:13:24.78,general text,,0,0,0,,- Sumasang-ayon ka ba?\N- Manahimik ka
Dialogue: 0,0:13:25.45,0:13:28.41,pangkalahatang teksto,,0,0,0,,Nabalitaan kong nagpunta ka sa isang grupo ng mga guro at tinanggihan ka ng lahat
Dialogue: 0,0:13:28.49,0:13:30.46,pangkalahatang teksto,,0,0,0,,Dahil ba ito sa isang pangit na karakter?
Dialogue: 0,0:13:34.42,0:13:37.75,pangkalahatang teksto,,0,0,0,,Hindi ko kayang takutin ang mga naunang master, wala silang kahinaan
Dialogue: 0,0:13:38.38,0:13:42.09,pangkalahatang teksto,,0,0,0,,Ngunit mayroon kang
Dialogue: 0,0:13:45.30,0:13:47.64,pangkalahatang teksto,,0,0,0,,Hindi ka makakaalis sa lugar na ito nang wala ang tulong ko
Dialogue: 0,0:13:48.39,0:13:50.31,pangkalahatang text,,0,0,0,,Mamamatay ka kung ibunyag ka nila
Dialogue: 0,0:13:51.23,0:13:52.35,general text,,0,0,0,,Ganun ba?
Dialogue: 0,0:13:53.19,0:13:54.65,pangkalahatang teksto,,0,0,0,,Sa kasong ito,
Dialogue: 0,0:13:58.07,0:13:59.40,general text,,0,0,0,,papatayin na lang kita
Dialogue: 0,0:14:01.86,0:14:04.78,pangkalahatang teksto,,0,0,0,,Napakawalang awa. Gayunpaman, tinulungan kita
Dialogue: 0,0:14:04.86,0:14:07.83,general text,,0,0,0,,Paumanhin sa pagiging walang awa, sa kabila ng iyong cute na mukha
Dialogue: 0,0:14:17.04,0:14:19.34,general text,,0,0,0,,Dinala kita sa bahay ko sa tulong ng jade jewelry,
Dialogue: 0,0:14:20.00,0:14:22.05,pangkalahatang teksto,,0,0,0,,at dito ito ay mas simple
Dialogue: 0,0:14:22.84,0:14:24.93,pangkalahatang teksto,,0,0,0,,At tingnan kung nasaan tayo
Dialogue: 0,0:14:32.73,0:14:34.31,pangkalahatang teksto,,0,0,0,,Ito ang sikretong silid ng Sosnovy Bor
Dialogue: 0,0:14:35.27,0:14:38.73,pangkalahatang teksto,,0,0,0,,Kapag nakasara na ang mga pinto, mabubuksan lang sila mula sa labas
Dialogue: 0,0:14:39.98,0:14:41.57,general text,,0,0,0,,Kami ay naka-lock dito nang magkasama
Dialogue: 0,0:14:43.82,0:14:44.99,pangkalahatang teksto,,0,0,0,,Huwag gumalaw!
Dialogue: 0,0:14:45.49,0:14:48.07,pangkalahatang teksto,,0,0,0,,Tapak sa maling slab at mahuhulog ang sahig
Dialogue: 0,0:14:51.37,0:14:55.50,general text,,0,0,0,,Patayin mo ako at papatayin ka ng mga mago na pumupunta rito
Dialogue: 0,0:14:55.58,0:14:58.96,pangkalahatang teksto,,0,0,0,,Ngunit kung sumasang-ayon ka, aalis kami nang walang pinsala
Dialogue: 0,0:15:02.38,0:15:05.47,offscreen,,0,0,0,,Wala akong lakas para sirain ang mga gate na ito ngayon
Dialogue: 0,0:15:05.97,0:15:07.84,offscreen,,0,0,0,,Maiintindihan niya lahat kung mananatili ako dito
Dialogue: 0,0:15:08.43,0:15:09.47,pangkalahatang teksto,,0,0,0,,Kailangan ko ang aking espada
Dialogue: 0,0:15:10.85,0:15:12.81,general text,,0,0,0,,Nanghina ako dahil sa paglipat ko sa ibang katawan
Dialogue: 0,0:15:12.89,0:15:15.73,pangkalahatang teksto,,0,0,0,,Kailangan ko ang aking espada na may lakas upang mabuksan ang iyong kapangyarihan
Dialogue: 0,0:15:16.27,0:15:17.44,pangkalahatang teksto,,0,0,0,,Kung wala ito
Dialogue: 0,0:15:18.06,0:15:20.73,general text,,0,0,0,,Wala akong magawa
Dialogue: 0,0:15:21.86,0:15:23.32,pangkalahatang teksto,,0,0,0,,At upang makuha ang espada,
Dialogue: 0,0:15:24.69,0:15:25.90,general text,,0,0,0,,Kailangan kong lumabas
Dialogue: 0,0:15:25.99,0:15:27.11,pangkalahatang text,,0,0,0,,Stop
Dialogue: 0,0:15:29.37,0:15:30.66,general text,,0,0,0,,Hindi mo ba naririnig?
Dialogue: 0,0:15:30.74,0:15:33.83,general text,,0,0,0,,Hindi ko kaya. Kailangan nating maghintay hanggang sa ganap silang magsara
Dialogue: 0,0:15:35.50,0:15:37.67,pangkalahatang teksto,,0,0,0,,Ikaw! Nagsinungaling ka sa akin!
Dialogue: 0,0:15:40.79,0:15:42.00,pangkalahatang text,,0,0,0,,Huwag gumalaw!
Dialogue: 0,0:15:42.09,0:15:44.26,general text,,0,0,0,,- Mabibigo ang sahig kung hindi!\N- Teka...
Dialogue: 0,0:15:47.34,0:15:48.97,pangkalahatang teksto,,0,0,0,,Kumapit ng mahigpit. babagsak ka
Dialogue: 0,0:15:49.84,0:15:52.47,general text,,0,0,0,,- Saan mo itinuro yang ilong mo?\N- Manahimik ka!
Dialogue: 0,0:15:52.56,0:15:54.27,general text,,0,0,0,,- Hoy!\N- Ikaw!
Dialogue: 0,0:15:54.35,0:15:55.31,pangkalahatang teksto,,0,0,0,,Gad...
Dialogue: 0,0:15:56.06,0:15:58.73,general text,,0,0,0,,- Masakit!\N- Hindi ko sinasadya
Dialogue: 0,0:15:58.81,0:16:00.94,general text,,0,0,0,,- Masakit\N- Teka
Dialogue: 0,0:16:01.52,0:16:02.40,pangkalahatang teksto,,0,0,0,,Hayaan mo
Dialogue: 0,0:16:08.20,0:16:10.45,pangkalahatang teksto,,0,0,0,,Paano namin mahahanap ang iyong espada?
Dialogue: 0,0:16:11.32,0:16:13.33,general text,,0,0,0,,Alam ko kung sino ang kumuha nito. Hahanapin ko siya
Dialogue: 0,0:16:14.62,0:16:16.54,pangkalahatang teksto,,0,0,0,,Mapanganib na umalis sa Sosnovy Bor
Dialogue: 0,0:16:16.62,0:16:18.25,general text,,0,0,0,,Dapat tayong manatili dito
Dialogue: 0,0:16:19.54,0:16:21.46,general text,,0,0,0,,Kailangan mo ba talaga ang espadang iyon?
Dialogue: 0,0:16:21.54,0:16:23.34,pangkalahatang teksto,,0,0,0,,Kumuha ng isa pang energy sword at tapusin ang trabaho
Dialogue: 0,0:16:23.42,0:16:25.55,general text,,0,0,0,,Hindi ko kaya. Dapat ay akin ang espada
Dialogue: 0,0:16:26.80,0:16:28.30,general text,,0,0,0,,Lumabas tayo at hanapin siya
Dialogue: 0,0:16:29.26,0:16:32.39,voiceover,,0,0,0,,Aakitin ko siya palabas at pagkatapos ay papatayin
Dialogue: 0,0:16:33.72,0:16:35.47,general text,,0,0,0,,Sabi mo mahina ka
Dialogue: 0,0:16:38.48,0:16:40.73,general text,,0,0,0,,At akala ko nagpapanggap ka
Dialogue: 0,0:16:42.11,0:16:43.27,pangkalahatang teksto,,0,0,0,,Gaano ka nanghina?
Dialogue: 0,0:16:46.36,0:16:47.78,pangkalahatang teksto,,0,0,0,,Darating ang mga salamangkero
Dialogue: 0,0:16:47.86,0:16:48.90,pangkalahatang teksto,,0,0,0,,Mag-ingat
Dialogue: 0,0:16:51.78,0:16:54.74,pangkalahatang teksto,,0,0,0,,Bakit? Nasa tabi ko sila
Dialogue: 0,0:16:56.24,0:16:58.75,general text,,0,0,0,,Sa side mo? Napaka isip bata!
Dialogue: 0,0:16:58.83,0:17:00.67,general text,,0,0,0,,Bakit kaswal mo akong kausap?
Dialogue: 0,0:17:00.75,0:17:01.96,pangkalahatang teksto,,0,0,0,,Okay, master
Dialogue: 0,0:17:02.04,0:17:03.29,general text,,0,0,0,,Titingin ako sa sahig
Dialogue: 0,0:17:12.43,0:17:13.47,pangkalahatang teksto,,0,0,0,,Sino ito?
Dialogue: 0,0:17:14.26,0:17:17.31,general text,,0,0,0,,Ako si Moo Deok, ang kanyang kasambahay
Dialogue: 0,0:17:19.81,0:17:21.81,general text,,0,0,0,,Narinig mo ba? Yung maid ko
Dialogue: 0,0:17:22.40,0:17:24.11,pangkalahatang teksto,,0,0,0,,Malinaw kang abala. Pumunta sa iyong negosyo
Dialogue: 0,0:17:24.19,0:17:26.61,general text,,0,0,0,,- Tara na, Moo Deok\N- Hindi ka makakaalis
Dialogue: 0,0:17:29.28,0:17:32.28,general text,,0,0,0,,Ang sabi ng head ay tipunin ang lahat sa training room
Dialogue: 0,0:17:34.62,0:17:36.03,general text,,0,0,0,,Hindi ako estudyante ng Sosnovy Bor
Dialogue: 0,0:17:36.12,0:17:38.37,pangkalahatang teksto,,0,0,0,,Gustong tipunin ng ulo ang lahat ng may buhay sa silid na iyon,
Dialogue: 0,0:17:39.00,0:17:41.25,pangkalahatang teksto,,0,0,0,,ano ang nasa gubat na ito
Dialogue: 0,0:17:49.84,0:17:51.34,pangkalahatang text,,0,0,0,,- Uk\N- Hey
Dialogue: 0,0:17:53.26,0:17:55.68,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari? Bakit tayo nagtipon dito?
Dialogue: 0,0:17:56.22,0:17:58.85,general text,,0,0,0,,Gusto nilang hulihin ang mga tao ni Nak Su
Dialogue: 0,0:18:01.02,0:18:02.27,general text,,0,0,0,,Nak Su?
Dialogue: 0,0:18:13.03,0:18:14.24,italics,,0,0,0,,Ilan sa inyo
Dialogue: 0,0:18:14.32,0:18:17.20,pangkalahatang teksto,,0,0,0,,nakatulong sa mga tao ni Nak Su na makarating dito ngayon
Dialogue: 0,0:18:18.03,0:18:19.04,italics,,0,0,0,,Kabanata,
Dialogue: 0,0:18:19.12,0:18:22.29,pangkalahatang teksto,,0,0,0,,kilala ng lahat ang isa't isa
Dialogue: 0,0:18:22.37,0:18:26.00,pangkalahatang teksto,,0,0,0,,Sa panlabas, lahat kayo ay tagasunod ni Sosnovy Bor
Dialogue: 0,0:18:28.25,0:18:30.17,general text,,0,0,0,,Kaya humingi ako ng tulong
Dialogue: 0,0:18:31.38,0:18:34.63,pangkalahatang text,,0,0,0,,Dala ni Miss Jin Cho Young si Gwiga
Dialogue: 0,0:19:10.29,0:19:11.34,general text,,0,0,0,,Dumating ka na
Dialogue: 0,0:19:25.31,0:19:27.44,general text,,0,0,0,,Bakit nandito si Chan Wook?
Dialogue: 0,0:19:28.52,0:19:29.56,general text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:19:40.20,0:19:43.16,general text,,0,0,0,,At ito ay malamang na si Gwigu, isang relic ng pamilya Jin
Dialogue: 0,0:19:43.24,0:19:44.29,pangkalahatang teksto,,0,0,0,,Gwigu?
Dialogue: 0,0:19:44.87,0:19:46.16,pangkalahatang text,,0,0,0,,- Aso?\N- Oo
Dialogue: 0,0:19:46.25,0:19:48.96,pangkalahatang teksto,,0,0,0,,Ito ang diwa ni Sapsari na tumutukoy sa mahika
Dialogue: 0,0:19:53.55,0:19:54.67,pangkalahatang teksto,,0,0,0,,Among Us
Dialogue: 0,0:19:55.76,0:19:57.01,pangkalahatang teksto,,0,0,0,,nomad
Dialogue: 0,0:19:58.47,0:20:02.56,general text,,0,0,0,,At hahanapin siya ni Gwigu
Dialogue: 0,0:20:03.22,0:20:05.85,pangkalahatang teksto,,0,0,0,,Sa panlabas ito ay isang taong kilala natin
Dialogue: 0,0:20:05.93,0:20:09.31,pangkalahatang teksto,,0,0,0,,At makakahanap si Gwigu ng isang taong may ibang kaluluwa
Dialogue: 0,0:20:15.48,0:20:17.24,pangkalahatang text,,0,0,0,,Isara ang lahat ng pinto
Dialogue: 0,0:20:17.32,0:20:18.20,italics,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:20:22.99,0:20:27.33,pangkalahatang teksto,,0,0,0,,Sinumang sumubok na umalis sa gusaling ito,
Dialogue: 0,0:20:27.41,0:20:30.67,pangkalahatang teksto,,0,0,0,,makikilala kaagad bilang isang taksil at papatayin
Dialogue: 0,0:20:32.13,0:20:33.25,italics,,0,0,0,,Simulan
Dialogue: 0,0:21:34.52,0:21:38.03,general text,,0,0,0,,Alchemy of souls, isang uri ng magic. Ngunit mayroong isang minus
Dialogue: 0,0:21:38.11,0:21:40.07,pangkalahatang teksto,,0,0,0,,Nalikha ang isang crack sa pagitan ng kaluluwa at katawan,
Dialogue: 0,0:21:40.15,0:21:42.57,pangkalahatang teksto,,0,0,0,,kung saan tumagas ang masamang enerhiya
Dialogue: 0,0:21:42.66,0:21:45.03,pangkalahatang teksto,,0,0,0,,At matukoy ito ni Gwigu
Dialogue: 0,0:22:13.77,0:22:16.77,general text,,0,0,0,,Chan Wook, pag nahuli ako, kunwari wala kang alam
Dialogue: 0,0:22:19.19,0:22:21.32,general text,,0,0,0,,- Katapatan mo ba?\N- Tungkulin ko
Dialogue: 0,0:22:27.49,0:22:29.95,general text,,0,0,0,,Ayokong maging katatawanan,
Dialogue: 0,0:22:30.62,0:22:32.58,general text,,0,0,0,,nang malaman nila na humingi ako ng tulong sa iyo
Dialogue: 0,0:22:32.66,0:22:34.17,general text,,0,0,0,,Tumayo ka sa tabi ko
Dialogue: 0,0:22:35.33,0:22:39.00,pangkalahatang teksto,,0,0,0,,Walang sinuman dito ang papayag na atakihin ako ng halimaw na ito
Dialogue: 0,0:23:10.12,0:23:11.49,pangkalahatang teksto,,0,0,0,,Nomad! Hulihin mo siya!
Dialogue: 0,0:24:40.12,0:24:43.21,general text,,0,0,0,,Narinig ko na nagiging bato ang mga nomad kapag tumakbo sila ng ligaw at nawawalan ng enerhiya
Dialogue: 0,0:24:43.29,0:24:44.50,italics,,0,0,0,,Totoo iyon
Dialogue: 0,0:25:13.07,0:25:15.53,pangkalahatang teksto,,0,0,0,,Nagpapasalamat kami sa iyong tulong
Dialogue: 0,0:25:16.91,0:25:19.16,general text,,0,0,0,,Sigurado akong darating ang araw na hihingi tayo ng tulong
Dialogue: 0,0:25:20.33,0:25:24.92,pangkalahatang teksto,,0,0,0,,Ang apat na dakilang pamilya ni Deho ay nagtipon dito
Dialogue: 0,0:25:25.00,0:25:27.09,general text,,0,0,0,,Narinig kong tinawag ka nilang Four Seasons
Dialogue: 0,0:25:27.67,0:25:30.84,pangkalahatang teksto,,0,0,0,,Nakikita kong magkasama kayong lahat at nagagalak ang aking kaluluwa
Dialogue: 0,0:25:31.59,0:25:33.30,general text,,0,0,0,,Madalas kaming magkasama,
Dialogue: 0,0:25:33.39,0:25:36.60,general text,,0,0,0,,pero ito ang unang pagkikita pagkatapos ng dissolution ng engagement nina Wook at Cho Young
Dialogue: 0,0:25:38.10,0:25:39.48,pangkalahatang teksto,,0,0,0,,Scoundrel...
Dialogue: 0,0:25:40.06,0:25:42.52,general text,,0,0,0,,humingi ako ng tsaa
Dialogue: 0,0:25:42.60,0:25:43.81,italics,,0,0,0,,Tara na
Dialogue: 0,0:25:50.49,0:25:52.28,general text,,0,0,0,,Nandito ka rin
Dialogue: 0,0:25:52.99,0:25:55.07,general text,,0,0,0,,Balita ko pinatalsik ka sa Kisan
Dialogue: 0,0:25:55.16,0:25:56.70,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:25:57.62,0:26:00.41,general text,,0,0,0,,Stop watching my every move
Dialogue: 0,0:26:03.17,0:26:06.09,pangkalahatang teksto,,0,0,0,,Nag-uusap ang lahat kung paano ka muling itinapon
Dialogue: 0,0:26:06.17,0:26:07.71,general text,,0,0,0,,narinig ko lang
Dialogue: 0,0:26:07.80,0:26:09.13,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:26:10.17,0:26:13.05,pangkalahatang teksto,,0,0,0,,Hindi gusto ng aming mahal na panauhin ang aking kumpanya,
Dialogue: 0,0:26:13.13,0:26:14.51,pangkalahatang teksto,,0,0,0,,at pagkatapos...
Dialogue: 0,0:26:17.97,0:26:19.22,pangkalahatang text,,0,0,0,,Scoundrel
Dialogue: 0,0:26:21.10,0:26:22.14,general text,,0,0,0,,Let's go
Dialogue: 0,0:26:24.35,0:26:25.44,general text,,0,0,0,,Let's go
Dialogue: 0,0:26:37.45,0:26:39.87,general text,,0,0,0,,Hoy, ayan... ikaw...
Dialogue: 0,0:26:40.95,0:26:42.91,general text,,0,0,0,,Nakita mo na ba ang kasambahay ko?
Dialogue: 0,0:26:43.50,0:26:46.13,pangkalahatang teksto,,0,0,0,,Maikli, may bilog na mukha
Dialogue: 0,0:26:46.21,0:26:47.50,pangkalahatang text,,0,0,0,,Damn
Dialogue: 0,0:26:48.38,0:26:50.00,general text,,0,0,0,,Saan siya nagpunta?
Dialogue: 0,0:26:51.76,0:26:54.84,offscreen,,0,0,0,,Nagpadala si Dan Zhu ng nomad dito
Dialogue: 0,0:26:56.51,0:26:58.18,behind the scenes,,0,0,0,,Kailangan nating mahanap si Dan Zhu
Dialogue: 0,0:27:09.31,0:27:11.73,pangkalahatang teksto,,0,0,0,,Hindi katapatan, ngunit tungkulin
Dialogue: 0,0:27:12.32,0:27:14.24,pangkalahatang teksto,,0,0,0,,Sasabihin mo ba iyan sa kasong ito?
Dialogue: 0,0:27:15.32,0:27:17.74,general text,,0,0,0,,Kaya aalis ako, iiwan ka
Dialogue: 0,0:27:17.82,0:27:20.24,pangkalahatang teksto,,0,0,0,,Sa una ay aakitin kita at papatayin
Dialogue: 0,0:27:20.33,0:27:21.29,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:27:22.08,0:27:23.45,pangkalahatang teksto,,0,0,0,,Makasalanan
Dialogue: 0,0:27:23.54,0:27:27.21,pangkalahatang teksto,,0,0,0,,Hindi ako ang iyong tapat na bilugang dalaga na si Moo Deok
Dialogue: 0,0:27:28.13,0:27:31.09,general text,,0,0,0,,You Nak Su. Walang awa na pumatay
Dialogue: 0,0:27:33.76,0:27:36.51,general text,,0,0,0,,Nagkaroon ka ng pagkakataon na patayin ako sa banyo
Dialogue: 0,0:27:36.59,0:27:38.80,pangkalahatang text,,0,0,0,,Itinaya ko ang buhay ko na dalhin ka dito
Dialogue: 0,0:27:40.05,0:27:42.18,general text,,0,0,0,,Bahala ka: patayin mo pa rin ako
Dialogue: 0,0:27:42.26,0:27:45.23,pangkalahatang teksto,,0,0,0,, o maging isang tagapayo, inilalantad ang aking kapangyarihan
Dialogue: 0,0:27:50.65,0:27:54.82,general text,,0,0,0,,Ugali mong tumitig sa mga tao
Dialogue: 0,0:27:54.90,0:27:57.15,pangkalahatang teksto,,0,0,0,,Ipagpatuloy ang ganito at mabilis kang mahuhuli
Dialogue: 0,0:27:58.28,0:28:00.45,pangkalahatang teksto,,0,0,0,,Nakikita mo ba ang marka mula doon?
Dialogue: 0,0:28:01.87,0:28:02.91,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:28:05.83,0:28:06.79,pangkalahatang teksto,,0,0,0,,At ngayon?
Dialogue: 0,0:28:09.63,0:28:11.04,general text,,0,0,0,,Nakikita ko dahil alam ko
Dialogue: 0,0:28:13.05,0:28:14.17,pangkalahatang teksto,,0,0,0,,At ngayon?
Dialogue: 0,0:28:21.60,0:28:23.31,pangkalahatang teksto,,0,0,0,,Malinaw kong nakikita
Dialogue: 0,0:28:23.39,0:28:26.06,pangkalahatang teksto,,0,0,0,,Ngunit hindi malamang na tatayo ka nang napakalapit sa ibang tao
Dialogue: 0,0:28:26.73,0:28:28.60,pangkalahatang teksto,,0,0,0,,Mag-ingat sa paghalik sa isang tao
Dialogue: 0,0:28:30.94,0:28:32.82,general text,,0,0,0,,Halika, tutulungan kitang makalabas
Dialogue: 0,0:28:32.90,0:28:35.36,pangkalahatang teksto,,0,0,0,,Mamamatay ang sinumang makalapit sa ganyan
Dialogue: 0,0:28:37.86,0:28:39.24,general text,,0,0,0,,Maaari kang mamatay ngayon
Dialogue: 0,0:28:40.61,0:28:41.82,pangkalahatang teksto,,0,0,0,,Espiritu ni Sapsari
Dialogue: 0,0:28:49.33,0:28:50.79,general text,,0,0,0,,Kung aatake ka niya,
Dialogue: 0,0:28:50.87,0:28:52.67,general text,,0,0,0,,magiging bato ka ba?
Dialogue: 0,0:28:54.59,0:28:55.71,pangkalahatang text,,0,0,0,,Run
Dialogue: 0,0:28:57.84,0:28:58.92,pangkalahatang text,,0,0,0,,Susubukan kong iligtas ka
Dialogue: 0,0:30:21.76,0:30:23.38,pangkalahatang teksto,,0,0,0,,Gwigu Urn
Dialogue: 0,0:30:23.47,0:30:25.59,pangkalahatang teksto,,0,0,0,,Ito ang pamana ng aming pamilya
Dialogue: 0,0:30:26.89,0:30:29.81,general text,,0,0,0,,Gusto ko lang makita
Dialogue: 0,0:30:29.89,0:30:32.98,pangkalahatang teksto,,0,0,0,,Bakit napakarupok ng isang pamana ng pamilya?
Dialogue: 0,0:30:33.06,0:30:34.39,pangkalahatang teksto,,0,0,0,,Chan Wook!
Dialogue: 0,0:30:38.11,0:30:39.86,general text,,0,0,0,,Mag-usap tayo. Dito
Dialogue: 0,0:30:40.53,0:30:41.61,pangkalahatang teksto,,0,0,0,,UK
Dialogue: 0,0:30:43.65,0:30:44.78,pangkalahatang teksto,,0,0,0,,UK
Dialogue: 0,0:30:46.62,0:30:49.83,pangkalahatang teksto,,0,0,0,,Hey, Uk! Chan Wook!
Dialogue: 0,0:30:54.54,0:30:55.62,pangkalahatang teksto,,0,0,0,,Uk!
Dialogue: 0,0:30:56.96,0:30:58.04,pangkalahatang teksto,,0,0,0,,Uk!
Dialogue: 0,0:30:58.67,0:31:00.00,pangkalahatang text,,0,0,0,,Chan Wook!
Dialogue: 0,0:31:00.59,0:31:01.96,italics,,0,0,0,,Bless you!
Dialogue: 0,0:31:03.30,0:31:04.26,italics,,0,0,0,,Uk!
Dialogue: 0,0:31:05.47,0:31:06.51,pangkalahatang teksto,,0,0,0,,Kolektahin ang mga fragment
Dialogue: 0,0:31:06.59,0:31:08.80,pangkalahatang teksto,,0,0,0,,Kailangan kong isama silang muli
Dialogue: 0,0:31:08.89,0:31:10.18,pangkalahatang teksto,,0,0,0,,- Oo madam\N- Oo madam
Dialogue: 0,0:31:25.40,0:31:26.70,pangkalahatang text,,0,0,0,,Mommies
Dialogue: 0,0:31:27.32,0:31:29.16,pangkalahatang teksto,,0,0,0,,Nagawa ng iyong panginoon ang mga bagay
Dialogue: 0,0:31:30.87,0:31:33.54,voiceover,,0,0,0,,Ganyan niya ako niligtas
Dialogue: 0,0:31:33.62,0:31:34.71,italics,,0,0,0,,Itong lalaking ito...
Dialogue: 0,0:31:34.79,0:31:37.33,general text,,0,0,0,,Naputol ang engagement ko sa kanila noong nakaraang taon
Dialogue: 0,0:31:37.42,0:31:39.84,pangkalahatang teksto,,0,0,0,,Sa pagkakataong ito ay sinira ko ang relic
Dialogue: 0,0:31:39.92,0:31:42.17,pangkalahatang text,,0,0,0,,- Engagement?\N- Oo
Dialogue: 0,0:31:43.38,0:31:45.26,pangkalahatang text,,0,0,0,,Kinansela ang kasal nila
Dialogue: 0,0:31:45.92,0:31:49.47,italics,,0,0,0,,12 mga guro ang tumanggi sa kanya, natapos ang kasal, ngayon ito rin
Dialogue: 0,0:31:49.55,0:31:51.01,pangkalahatang teksto,,0,0,0,,Sakuna sa paglalakad
Dialogue: 0,0:31:53.77,0:31:55.48,pangkalahatang teksto,,0,0,0,,Ano ang gagawin mo?
Dialogue: 0,0:31:56.39,0:31:57.56,general text,,0,0,0,,Nasaan ang may-ari?
Dialogue: 0,0:31:58.56,0:31:59.48,general text,,0,0,0,,Siya ay kinaladkad palayo
Dialogue: 0,0:32:00.15,0:32:03.48,general text,,0,0,0,,Natatakot akong mahaharap siya sa matinding parusa sa pagkakataong ito
Dialogue: 0,0:32:10.91,0:32:13.41,general text,,0,0,0,,pinadala kita kay Kisan
Dialogue: 0,0:32:14.49,0:32:16.71,general text,,0,0,0,,Pinalayas ka nila doon sa loob ng anim na buwan
Dialogue: 0,0:32:17.54,0:32:19.29,general text,,0,0,0,,Bakit ka pumunta dito ngayon?
Dialogue: 0,0:32:19.37,0:32:22.42,general text,,0,0,0,,Nabalitaan kong nagdulot ako ng gulo para sa iyo, kaya pumunta ako para humingi ng tawad
Dialogue: 0,0:32:23.00,0:32:24.38,general text,,0,0,0,,Ito ba ang iyong paghingi ng tawad?
Dialogue: 0,0:32:27.01,0:32:29.89,general text,,0,0,0,,Bakit mo nabasag ang urn?
Dialogue: 0,0:32:29.97,0:32:32.68,general text,,0,0,0,,Nabighani ako dito, gusto kong tingnang mabuti,
Dialogue: 0,0:32:32.76,0:32:34.93,pangkalahatang teksto,,0,0,0,,at dumulas ito sa aking mga kamay
Dialogue: 0,0:32:35.02,0:32:37.56,general text,,0,0,0,,Kung alam ko ang mga spells, hindi sana ito mangyayari
Dialogue: 0,0:32:37.64,0:32:39.10,pangkalahatang teksto,,0,0,0,,Wala akong sapat na kaalaman
Dialogue: 0,0:32:39.19,0:32:40.77,pangkalahatang teksto,,0,0,0,,Chan Wook!
Dialogue: 0,0:32:42.44,0:32:44.27,pangkalahatang teksto,,0,0,0,,Ganoon din ang ginawa niya
Dialogue: 0,0:32:44.36,0:32:46.53,pangkalahatang text,,0,0,0,,na may pinto sa secret room. Sinira ito
Dialogue: 0,0:32:47.03,0:32:50.16,general text,,0,0,0,,Ginawa niya ito ng kusa. Dahil sa inggit
Dialogue: 0,0:32:50.95,0:32:54.03,pangkalahatang teksto,,0,0,0,,Sa pagkakataong ito ay hindi na kita hahayaang makawala dito
Dialogue: 0,0:32:54.99,0:32:58.16,general text,,0,0,0,,Hanggang hindi ko payagan, bawal si Chan Wook
Dialogue: 0,0:32:58.25,0:33:01.92,pangkalahatang teksto,,0,0,0,,galaw o magsalita
Dialogue: 0,0:33:03.25,0:33:04.54,pangkalahatang teksto,,0,0,0,,Magsisi
Dialogue: 0,0:33:23.77,0:33:24.77,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:33:26.23,0:33:28.11,pangkalahatang teksto,,0,0,0,,Hindi siya mapaparusahan nang matagal
Dialogue: 0,0:33:29.65,0:33:32.16,general text,,0,0,0,,Muntik na siyang mamatay sa sipon pagkatapos ng kanyang huling parusa,
Dialogue: 0,0:33:32.24,0:33:33.37,pangkalahatang teksto,,0,0,0,,pinarusahan buong araw
Dialogue: 0,0:33:34.28,0:33:37.58,italics,,0,0,0,,Bukas ang kanyang mga tarangkahan ng enerhiya upang hindi siya mamatay
Dialogue: 0,0:33:37.66,0:33:40.25,pangkalahatang teksto,,0,0,0,,Maaaring patayin siya ng matinding lamig o init
Dialogue: 0,0:33:41.04,0:33:42.25,general text,,0,0,0,,At matagal na siyang may sakit
Dialogue: 0,0:33:42.83,0:33:46.71,pangkalahatang teksto,,0,0,0,,Pagkatapos buksan ang mga gate na ito. Gusto niya ito
Dialogue: 0,0:33:47.34,0:33:49.05,pangkalahatang teksto,,0,0,0,,Kayo ay kanyang mga kaibigan
Dialogue: 0,0:33:50.09,0:33:51.97,pangkalahatang teksto,,0,0,0,,Masyado kaming mahina
Dialogue: 0,0:33:53.30,0:33:54.76,pangkalahatang teksto,,0,0,0,,Ngunit walang sinuman sa Sosnovy Bor...
Dialogue: 0,0:33:54.85,0:33:58.47,pangkalahatang teksto,,0,0,0,,Hindi, walang sinuman sa Deho ang maglalakas-loob na gawin ito
Dialogue: 0,0:34:03.69,0:34:06.82,general text,,0,0,0,,Kaya siya ay pinarusahan sa buong buhay niya
Dialogue: 0,0:34:41.52,0:34:43.56,pangkalahatang text,,0,0,0,,Maaari kang uminom ng mainit na tsaa
Dialogue: 0,0:34:47.11,0:34:48.23,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:34:48.86,0:34:51.78,general text,,0,0,0,,Aalis ako at iiwan ka
Dialogue: 0,0:34:53.36,0:34:54.74,general text,,0,0,0,,Aalis ka nang wala ako?
Dialogue: 0,0:35:02.20,0:35:04.58,pangkalahatang teksto,,0,0,0,,Tapat ka at alam mo ang iyong mga responsibilidad
Dialogue: 0,0:35:05.46,0:35:07.83,general text,,0,0,0,,Kaya pinapasok mo ako, dinala mo ako dito
Dialogue: 0,0:35:08.92,0:35:11.09,pangkalahatang teksto,,0,0,0,,at ipinagtanggol
Dialogue: 0,0:35:12.17,0:35:15.47,pangkalahatang teksto,,0,0,0,,Dapat mong maunawaan na hindi mo maaaring sabihin sa sinuman ang tungkol dito
Dialogue: 0,0:35:28.36,0:35:30.86,pangkalahatang teksto,,0,0,0,,Ako ay buo salamat sa iyo
Dialogue: 0,0:35:41.87,0:35:44.87,general text,,0,0,0,,Gusto ng mga taong nakilala ko na patayin ako
Dialogue: 0,0:35:46.16,0:35:48.04,general text,,0,0,0,,Ikaw ang unang sumubok
Dialogue: 0,0:35:49.42,0:35:51.04,pangkalahatang teksto,,0,0,0,,iligtas mo ako
Dialogue: 0,0:35:57.38,0:36:00.01,pangkalahatang teksto,,0,0,0,,Kahit na muli tayong malapit sa isa't isa,
Dialogue: 0,0:36:00.64,0:36:02.18,general text,,0,0,0,,Ililibre kita
Dialogue: 0,0:36:59.28,0:37:02.16,italics,,0,0,0,,Magpapadala ako ng regalo kay Kisan bilang paghingi ng tawad
Dialogue: 0,0:37:02.24,0:37:06.41,general text,,0,0,0,,at magbabayad ako ng disenteng halaga sa pamilya Jin
Dialogue: 0,0:37:07.00,0:37:10.42,pangkalahatang teksto,,0,0,0,,Masyadong maraming pagkakamali ang Uk sa pagkakataong ito
Dialogue: 0,0:37:11.96,0:37:13.67,general text,,0,0,0,,kinailangan ko siyang parusahan
Dialogue: 0,0:37:13.75,0:37:15.59,general text,,0,0,0,,Natutuwa akong pinarusahan mo siya
Dialogue: 0,0:37:16.67,0:37:19.97,general text,,0,0,0,,Ngayong tapos ka na, iuuwi ko na
Dialogue: 0,0:37:20.72,0:37:21.89,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:37:23.60,0:37:24.72,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:37:30.64,0:37:33.73,general text,,0,0,0,,- Okay ka lang?\N- Hindi okay
Dialogue: 0,0:37:35.73,0:37:37.94,general text,,0,0,0,,Umuwi na ba si Mu Dok?
Dialogue: 0,0:37:38.53,0:37:40.53,pangkalahatang teksto,,0,0,0,,Bakit kailangan niya ito?
Dialogue: 0,0:37:41.40,0:37:45.08,general text,,0,0,0,,Speaking of her, nasaan siya noong pinarusahan ka?
Dialogue: 0,0:37:45.70,0:37:46.79,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:37:50.08,0:37:52.96,general text,,0,0,0,,Bakit mo sinira ang pinto?
Dialogue: 0,0:37:54.04,0:37:55.63,pangkalahatang text,,0,0,0,,Hindi pa magsasara ang pinto
Dialogue: 0,0:37:56.29,0:37:57.63,general text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:38:00.51,0:38:03.01,general text,,0,0,0,,- Bakit nasira ang ballot box?\N- I don't...
Dialogue: 0,0:38:05.01,0:38:06.60,general text,,0,0,0,,sabi ko, hindi ko alam
Dialogue: 0,0:38:07.22,0:38:08.56,pangkalahatang teksto,,0,0,0,,Huwag ka nang magtanong
Dialogue: 0,0:38:18.65,0:38:20.57,general text,,0,0,0,,Ang hinihingi mong paputok
Dialogue: 0,0:38:20.65,0:38:22.70,pangkalahatang teksto,,0,0,0,,Makikita ang mga ito sa napakalayo
Dialogue: 0,0:38:25.74,0:38:26.87,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:38:27.87,0:38:30.83,general text,,0,0,0,,Bakit kailangan sila ng master?
Dialogue: 0,0:38:30.91,0:38:33.29,general text,,0,0,0,,May mga tsismis na siya ay pinarusahan nang husto
Dialogue: 0,0:38:33.37,0:38:34.87,pangkalahatang teksto,,0,0,0,,Ano ang ginagawa niya sa oras na ito?
Dialogue: 0,0:38:36.88,0:38:37.88,pangkalahatang teksto,,0,0,0,,Sikreto
Dialogue: 0,0:38:38.75,0:38:40.55,pangkalahatang teksto,,0,0,0,,Huwag sabihin kahit kanino ang tungkol dito
Dialogue: 0,0:38:42.34,0:38:43.59,pangkalahatang teksto,,0,0,0,,Ju Wol
Dialogue: 0,0:38:45.47,0:38:47.51,pangkalahatang teksto,,0,0,0,,Mas mabuting huwag siyang makialam kahit saan
Dialogue: 0,0:38:54.27,0:38:55.65,pangkalahatang teksto,,0,0,0,,Ito ang anting-anting ni Sosnovy Bor
Dialogue: 0,0:38:56.23,0:38:58.11,general text,,0,0,0,,Punta ka na lang diyan?
Dialogue: 0,0:38:58.19,0:39:00.36,pangkalahatang teksto,,0,0,0,,Labis ang tiwala sa iyo ng young master
Dialogue: 0,0:39:01.11,0:39:03.19,pangkalahatang teksto,,0,0,0,,Ang mahal na bagay
Dialogue: 0,0:39:04.28,0:39:05.82,general text,,0,0,0,,Gusto niyang ibenta ko siya
Dialogue: 0,0:39:06.74,0:39:09.41,pangkalahatang text,,0,0,0,,Hindi ka basta basta magbebenta ng ganito
Dialogue: 0,0:39:09.49,0:39:10.49,general text,,0,0,0,,Ganun ba?
Dialogue: 0,0:39:11.04,0:39:13.33,general text,,0,0,0,,May ganoong lugar daw.
Dialogue: 0,0:39:13.91,0:39:14.96,pangkalahatang teksto,,0,0,0,,Ngunit mayroong
Dialogue: 0,0:39:15.04,0:39:18.42,general text,,0,0,0,,may isang mayaman na bumibili ng lahat sa black market
Dialogue: 0,0:39:20.00,0:39:22.42,pangkalahatang teksto,,0,0,0,,Ngunit hindi magiging madali ang pagpunta doon
Dialogue: 0,0:39:28.93,0:39:31.06,general text,,0,0,0,,Makakatanggap ka ng isang bundok ng pera
Dialogue: 0,0:39:31.14,0:39:33.06,italics,,0,0,0,,Pwede pa bang manok?
Dialogue: 0,0:39:33.14,0:39:35.73,pangkalahatang teksto,,0,0,0,,Oo. Ilalagay ko ito sa account ng iyong master
Dialogue: 0,0:39:35.81,0:39:37.73,italics,,0,0,0,,Kumain hangga't gusto mo
Dialogue: 0,0:39:44.99,0:39:49.28,italics,,0,0,0,,Narito ang katawan ni Nak Su, ngunit ang kaluluwa ay nasa ibang lugar
Dialogue: 0,0:39:50.16,0:39:54.08,pangkalahatang teksto,,0,0,0,,Bibigyan ka rin ng mga bagong katawan ng alchemy ng mga kaluluwa
Dialogue: 0,0:39:54.16,0:39:58.54,pangkalahatang teksto,,0,0,0,,Kaya huwag matakot na isakripisyo ang iyong sarili para sa akin
Dialogue: 0,0:39:58.63,0:39:59.79,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:40:19.94,0:40:20.86,pangkalahatang teksto,,0,0,0,,Sunog!
Dialogue: 0,0:40:39.54,0:40:41.04,mga alaala,,0,0,0,,Kailangan ko ang aking espada
Dialogue: 0,0:40:41.13,0:40:43.17,mga alaala,,0,0,0,,Nanghina ako dahil sa paglipat ko sa ibang katawan
Dialogue: 0,0:40:43.88,0:40:46.80,mga alaala,,0,0,0,,Kailangan ko ang aking espada na may lakas upang mabuksan ang iyong kapangyarihan
Dialogue: 0,0:40:46.88,0:40:49.51,mga alaala,,0,0,0,,Kahit na muli tayong malapit sa isa't isa,
Dialogue: 0,0:40:50.09,0:40:51.59,mga alaala,,0,0,0,,Ililibre kita
Dialogue: 0,0:40:56.39,0:40:58.85,pangkalahatang text,,0,0,0,,- Nawalan ng gana\N{\i1}- Mister
Dialogue: 0,0:41:01.06,0:41:02.86,general text,,0,0,0,,Mr, nahuli sila
Dialogue: 0,0:41:03.44,0:41:06.11,general text,,0,0,0,,- Mu Dok?\N- Bakit siya huhulihin?
Dialogue: 0,0:41:07.11,0:41:09.24,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:41:09.32,0:41:11.03,pangkalahatang teksto,,0,0,0,,Jin Mu, Deputy Head ng Jeonbugwan,
Dialogue: 0,0:41:11.11,0:41:13.53,general text,,0,0,0,,nahuli ang mga tao ni Nak Su na pumasok sa Sosnovy Bor
Dialogue: 0,0:41:14.16,0:41:15.16,general text,,0,0,0,,Talaga?
Dialogue: 0,0:41:17.75,0:41:21.62,pangkalahatang teksto,,0,0,0,,Inihatid ni Jin Mu ang mga bangkay sa palasyo
Dialogue: 0,0:41:21.71,0:41:23.84,italics,,0,0,0,,Nahuli namin si Nak Su
Dialogue: 0,0:41:23.92,0:41:26.71,italics,,0,0,0,,natatakot akong pagtawanan nila tayo
Dialogue: 0,0:41:26.80,0:41:29.80,general text,,0,0,0,,Totoo na hindi siya nagtitipid
Dialogue: 0,0:41:30.34,0:41:32.01,pangkalahatang teksto,,0,0,0,,walang sinuman?
Dialogue: 0,0:41:32.09,0:41:33.60,general text,,0,0,0,,Pinatay niya ang lahat
Dialogue: 0,0:41:35.10,0:41:37.93,pangkalahatang teksto,,0,0,0,,Hindi natin masusubaybayan ang alchemy ng mga kaluluwa
Dialogue: 0,0:41:40.06,0:41:42.40,general text,,0,0,0,,Nandito rin si Jin Ho Kyung mula sa Jinyouwon
Dialogue: 0,0:41:47.53,0:41:49.65,pangkalahatang teksto,,0,0,0,,Narinig ko, Jin Mu
Dialogue: 0,0:41:49.74,0:41:52.53,pangkalahatang teksto,,0,0,0,,nahuli ang mga mersenaryo na hindi nakuha ni Bor
Dialogue: 0,0:41:53.36,0:41:56.37,pangkalahatang teksto,,0,0,0,,Paano nila nabasag ang Pine Forest barrier nang dalawang beses?
Dialogue: 0,0:42:01.21,0:42:03.46,pangkalahatang teksto,,0,0,0,,May isang taksil sa kagubatan
Dialogue: 0,0:42:03.54,0:42:06.84,general text,,0,0,0,,Sa kabutihang palad, nahuli siya ni Gwigu
Dialogue: 0,0:42:07.80,0:42:09.09,pangkalahatang text,,0,0,0,,Gwigu?
Dialogue: 0,0:42:09.17,0:42:11.05,pangkalahatang teksto,,0,0,0,,Gusto ko rin itong makita
Dialogue: 0,0:42:11.13,0:42:13.43,general text,,0,0,0,,Natatakot akong hindi ko ito maipakita sa iyo ngayon
Dialogue: 0,0:42:13.51,0:42:16.35,general text,,0,0,0,,Nabasag ang kanyang urn
Dialogue: 0,0:42:17.43,0:42:19.68,pangkalahatang teksto,,0,0,0,,Paano magagawa ang gayong hangal na pagkakamali?
Dialogue: 0,0:42:21.14,0:42:22.39,pangkalahatang teksto,,0,0,0,,Paumanhin, Kamahalan
Dialogue: 0,0:42:23.44,0:42:27.61,pangkalahatang teksto,,0,0,0,,Dahil gumawa si Jin Mu ng ganoong kontribusyon, tinipon ko kayong lahat para pag-usapan
Dialogue: 0,0:42:27.69,0:42:29.94,general text,,0,0,0,,na itatalaga ko ito sa Gwangju
Dialogue: 0,0:42:31.15,0:42:32.40,pangkalahatang teksto,,0,0,0,,Pero imposible
Dialogue: 0,0:42:32.49,0:42:35.20,general text,,0,0,0,,Gwangju pa rin ang Chang Gang
Dialogue: 0,0:42:35.28,0:42:38.28,general text,,0,0,0,,Inabot sa kanya ng yumaong hari ang isang robe at isang espada
Dialogue: 0,0:42:38.37,0:42:40.25,pangkalahatang teksto,,0,0,0,,Jang Gang - Gwangju Jeonbugwan
Dialogue: 0,0:42:40.83,0:42:43.50,italics,,0,0,0,,At saka, may anak siya, si Chan Wook
Dialogue: 0,0:42:43.58,0:42:44.42,pangkalahatang teksto,,0,0,0,,Chan Gan,
Dialogue: 0,0:42:45.25,0:42:46.63,pangkalahatang teksto,,0,0,0,,nagtatago sa likod ng pagsasanay,
Dialogue: 0,0:42:46.71,0:42:48.34,pangkalahatang teksto,,0,0,0,,nawala nang ilang dekada
Dialogue: 0,0:42:48.42,0:42:51.46,italics,,0,0,0,,Ang kanyang anak na si Chang Wook ay pisikal na hindi marunong mag spell
Dialogue: 0,0:42:51.55,0:42:53.55,pangkalahatang teksto,,0,0,0,,Jin Mu, Gwangju Deputy,
Dialogue: 0,0:42:54.72,0:42:55.80,pangkalahatang teksto,,0,0,0,,ginagampanan ang kanyang mga tungkulin
Dialogue: 0,0:42:57.64,0:42:59.93,italics,,0,0,0,,Kamahalan, mga spelling na may kaugnayan sa dark magic,
Dialogue: 0,0:43:00.01,0:43:03.39,italics,,0,0,0,,ipinagbabawal sa mga salamangkero
Dialogue: 0,0:43:03.48,0:43:05.60,pangkalahatang teksto,,0,0,0,,At ang mga salamangkero ng Sosnovy Bor ay palaging
Dialogue: 0,0:43:06.15,0:43:07.98,pangkalahatang teksto,,0,0,0,,sinundan ito
Dialogue: 0,0:43:08.56,0:43:12.07,italics,,0,0,0,,Maaaring bumagsak si Sosnovy Bor dahil sa insidente sa mga nomad
Dialogue: 0,0:43:12.15,0:43:13.61,pangkalahatang teksto,,0,0,0,,Puwede nila siyang alisin
Dialogue: 0,0:43:15.24,0:43:19.12,pangkalahatang teksto,,0,0,0,,Ngunit pinatay ni Jin Mu ang bawat isa
Dialogue: 0,0:43:20.24,0:43:22.70,general text,,0,0,0,,Sa katunayan, sinira niya ang lahat
Dialogue: 0,0:43:22.79,0:43:24.41,pangkalahatang teksto,,0,0,0,,Nakakainis ka,
Dialogue: 0,0:43:25.25,0:43:28.08,general text,,0,0,0,,dahil nakuha ni Jeonbugwan ang lahat ng kaluwalhatian?
Dialogue: 0,0:43:28.17,0:43:30.30,pangkalahatang teksto,,0,0,0,,Nakuha ng Pine Forest Mages si Nak Su!
Dialogue: 0,0:43:30.38,0:43:32.26,pangkalahatang teksto,,0,0,0,,Ngunit kinuha mo ang kredito para sa gawaing ito
Dialogue: 0,0:43:34.59,0:43:36.51,pangkalahatang teksto,,0,0,0,,Hindi ito ang aming pinag-usapan
Dialogue: 0,0:43:39.01,0:43:42.68,pangkalahatang teksto,,0,0,0,,Tungkol sa posisyon ng Gwangju, tatawag tayo ng pulong ng mga salamangkero
Dialogue: 0,0:43:42.77,0:43:45.77,general text,,0,0,0,,at gagawa kami ng desisyon kapag bumalik si Chang Gang
Dialogue: 0,0:43:46.77,0:43:49.90,pangkalahatang teksto,,0,0,0,,Pakigantihan siya nang iba
Dialogue: 0,0:43:53.40,0:43:54.65,pangkalahatang teksto,,0,0,0,,Jin Mu
Dialogue: 0,0:43:56.61,0:43:58.41,pangkalahatang teksto,,0,0,0,,Sabihin sa akin kung ano ang gusto mo
Dialogue: 0,0:44:01.28,0:44:03.20,pangkalahatang teksto,,0,0,0,,Nag-aalala ang mga tao sa spell
Dialogue: 0,0:44:03.29,0:44:05.71,general text,,0,0,0,,Hayaan mo akong sunugin ang katawan ni Nak Soo sa harap ni Jeonbugwan
Dialogue: 0,0:44:05.79,0:44:06.96,pangkalahatang teksto,,0,0,0,,At ang espada ni Nak Su...
Dialogue: 0,0:44:08.04,0:44:11.38,general text,,0,0,0,,Kunin natin siya, dahil nagawa na nilang mawala siya sa Sosnovy Bor
Dialogue: 0,0:44:14.80,0:44:16.51,pangkalahatang teksto,,0,0,0,,Iyan ang gagawin natin
Dialogue: 0,0:44:25.73,0:44:29.90,italics,,0,0,0,,Ang pinakamahusay na mga espada ng mga salamangkero ay iniingatan
Dialogue: 0,0:44:29.98,0:44:32.73,pangkalahatang teksto,,0,0,0,,sa Chongjingak armory
Dialogue: 0,0:44:33.86,0:44:36.28,pangkalahatang teksto,,0,0,0,,Ngunit ngayon lahat ay nagbago
Dialogue: 0,0:44:37.74,0:44:39.91,general text,,0,0,0,,Kinuha ni Jin Mu mula sa Chonbugwan ang espada ni Nak Soo?
Dialogue: 0,0:44:39.99,0:44:43.58,general text,,0,0,0,,Oo, doon niya ililibing ang bangkay ni Nak Soo
Dialogue: 0,0:44:43.66,0:44:46.25,pangkalahatang teksto,,0,0,0,,At makikita niya ang kanyang katawan na nasusunog
Dialogue: 0,0:44:46.33,0:44:47.37,italics,,0,0,0,,Sino?
Dialogue: 0,0:44:47.46,0:44:48.37,general text,,0,0,0,,Nak Su?
Dialogue: 0,0:44:49.12,0:44:51.33,general text,,0,0,0,,Sa tingin mo ba ay nagawang baguhin ni Nak Soo ang kanyang katawan?
Dialogue: 0,0:44:52.50,0:44:55.00,general text,,0,0,0,,Seryoso ka bang nag-iisip tungkol sa paghiling na maging estudyante niya?
Dialogue: 0,0:44:56.17,0:44:57.30,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:44:58.22,0:44:59.55,pangkalahatang text,,0,0,0,,Ibuhos mo pa ako ng tsaa
Dialogue: 0,0:45:02.55,0:45:05.47,general text,,0,0,0,,May mga kamay ka rin,
Dialogue: 0,0:45:05.56,0:45:07.10,italics,,0,0,0,,tamad
Dialogue: 0,0:45:09.94,0:45:12.48,general text,,0,0,0,,Nasaan ang maid mo na si Moo Deok?
Dialogue: 0,0:45:13.86,0:45:17.65,general text,,0,0,0,,Hahanapin ko siya, pero kailangan ko muna ng espada
Dialogue: 0,0:45:24.74,0:45:27.33,voiceover,,0,0,0,,Simula nang tanggalin niya lahat ng gamit ko,
Dialogue: 0,0:45:27.83,0:45:30.41,voiceover,,0,0,0,,malamang iniisip niya na namatay ako, hindi makahanap ng bagong katawan
Dialogue: 0,0:45:31.96,0:45:34.84,offscreen,,0,0,0,,Hindi mahanap si Dan Zhu. Hindi ko alam kung sino siya
Dialogue: 0,0:45:43.47,0:45:46.22,italics,,0,0,0,,Hanapin ang merchant na nagbebenta nitong iginuhit na anting-anting,
Dialogue: 0,0:45:46.31,0:45:47.72,italics,,0,0,0,,at pagkatapos ay makikita mo ako
Dialogue: 0,0:45:48.31,0:45:49.60,italics,,0,0,0,,Maghihintay ako
Dialogue: 0,0:46:12.33,0:46:13.79,behind the scenes,,0,0,0,,Ito ay nasa Danhyangok
Dialogue: 0,0:46:16.92,0:46:20.42,mga inskripsiyon,,0,0,0,,Jeonbugwan
Dialogue: 0,0:46:20.51,0:46:22.22,pangkalahatang teksto,,0,0,0,,dumating ako para sa espada ni Nak Su
Dialogue: 0,0:46:22.93,0:46:24.22,pangkalahatang teksto,,0,0,0,,Bakit mo ito kailangan?
Dialogue: 0,0:46:24.30,0:46:27.35,general text,,0,0,0,,Nabalitaan ko na pinayagan siya ng Kanyang Kamahalan na itago sa Jeonbugwan
Dialogue: 0,0:46:27.43,0:46:30.93,pangkalahatang teksto,,0,0,0,,Chang Gang - Gwangju, sa tingin ko ay tama na ibigay ang espada sa kanyang pamilya
Dialogue: 0,0:46:31.02,0:46:32.27,pangkalahatang teksto,,0,0,0,,Dahil wala ang iyong ama,
Dialogue: 0,0:46:32.35,0:46:34.69,pangkalahatang teksto,,0,0,0,,mas tama para kay Deputy Gwangju na panatilihin ito
Dialogue: 0,0:46:38.15,0:46:41.74,pangkalahatang teksto,,0,0,0,,Wala ang aking ama, kaya ako, ang kanyang anak, ay dapat na panatilihin siya
Dialogue: 0,0:46:46.45,0:46:48.87,general text,,0,0,0,,Nabalitaan ko na naghahanap ka ng guro kahit saan
Dialogue: 0,0:46:49.62,0:46:51.33,pangkalahatang teksto,,0,0,0,,Gusto kitang tanggapin mismo,
Dialogue: 0,0:46:52.00,0:46:54.71,pangkalahatang teksto,,0,0,0,,ngunit hindi ako maaaring sumalungat sa kalooban ng iyong ama, aking guro
Dialogue: 0,0:46:56.38,0:46:59.46,general text,,0,0,0,,Bakit niya isinara ang energy gate ng sarili niyang anak?
Dialogue: 0,0:47:00.50,0:47:02.38,pangkalahatang teksto,,0,0,0,,Hindi ko talaga maintindihan ito
Dialogue: 0,0:47:07.05,0:47:09.47,italics,,0,0,0,,Ang enerhiya ng magician ay dumadaloy sa pamamagitan ng kanyang espada
Dialogue: 0,0:47:09.56,0:47:13.64,pangkalahatang teksto,,0,0,0,,Hindi ito mailantad ng isang ordinaryong tao na tulad mo
Dialogue: 0,0:47:37.38,0:47:39.17,general text,,0,0,0,,Natatakot ka ba na magtagumpay ako?
Dialogue: 0,0:47:42.09,0:47:44.67,general text,,0,0,0,,Kung kaya ko, makikilala ako bilang susunod na Gwangju
Dialogue: 0,0:47:44.76,0:47:47.64,pangkalahatang teksto,,0,0,0,,Na nangangahulugan na hindi ka makakapag-apply para sa posisyong ito
Dialogue: 0,0:47:53.06,0:47:54.10,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:47:54.89,0:47:56.27,general text,,0,0,0,,Hindi ko pa ito magagawa
Dialogue: 0,0:48:08.20,0:48:09.41,pangkalahatang text,,0,0,0,,Bye?
Dialogue: 0,0:48:13.29,0:48:15.96,general text,,0,0,0,,Nakita ko ang mga ilaw sa ibabaw ng Danhyangok
Dialogue: 0,0:48:16.04,0:48:17.87,general text,,0,0,0,,Sigurado ka bang taga-roon siya?
Dialogue: 0,0:48:17.96,0:48:18.79,italics,,0,0,0,,Oo
Dialogue: 0,0:48:18.87,0:48:21.42,pangkalahatang teksto,,0,0,0,,Siya ay nasa itaas ng lambak, ang dating tahanan ng Nak Su
Dialogue: 0,0:48:41.44,0:48:43.07,general text,,0,0,0,,Naghahanap ako ng lalaking may anting-anting
Dialogue: 0,0:48:52.53,0:48:54.33,general text,,0,0,0,,Madam, dumating na sila
Dialogue: 0,0:48:59.12,0:49:00.88,general text,,0,0,0,,May gustong bumili nito
Dialogue: 0,0:49:06.46,0:49:08.30,pangkalahatang teksto,,0,0,0,,Sa iyo sa pinakahuling silid
Dialogue: 0,0:49:14.22,0:49:16.02,general text,,0,0,0,,Paano mo siya mawawala?
Dialogue: 0,0:49:16.10,0:49:18.48,general text,,0,0,0,,Hindi ko nawala, may nagnakaw
Dialogue: 0,0:49:18.56,0:49:20.06,general text,,0,0,0,,Sigurado akong si Ah Hyang iyon
Dialogue: 0,0:49:22.52,0:49:24.52,italics,,0,0,0,,Dala mo ba ito?
Dialogue: 0,0:49:27.03,0:49:29.28,general text,,0,0,0,,Pumunta ako para bumili ng Sacred Amulet
Dialogue: 0,0:49:30.11,0:49:31.66,pangkalahatang teksto,,0,0,0,,Naabot mo ang tamang tao
Dialogue: 0,0:49:38.91,0:49:40.71,mga alaala na italics,,0,0,0,,Hindi na ito magiging kapaki-pakinabang
Dialogue: 0,0:49:40.79,0:49:42.63,mga alaala,,0,0,0,,Patayin siya para maiwasan ang mga problema
Dialogue: 0,0:49:55.05,0:49:55.97,general text,,0,0,0,,Kilala mo ako, di ba?
Dialogue: 0,0:49:56.06,0:49:58.27,general text,,0,0,0,,Sinabi ko sa iyo na ipaalam sa akin kung may magdadala ng drawing na ito
Dialogue: 0,0:49:58.93,0:49:59.77,pangkalahatang teksto,,0,0,0,,Ginawa ko iyon
Dialogue: 0,0:50:00.52,0:50:02.73,pangkalahatang text,,0,0,0,,Nakasalubong niya siya sa itaas
Dialogue: 0,0:50:03.60,0:50:05.86,pangkalahatang teksto,,0,0,0,,Kaya si Ah Hyang
Dialogue: 0,0:50:11.11,0:50:12.66,general text,,0,0,0,,Kami ay mga magician mula sa Jeonbugwan
Dialogue: 0,0:50:13.24,0:50:16.45,italics,,0,0,0,,Nahuli lang namin ng magnanakaw. Isipin ang iyong sariling negosyo
Dialogue: 0,0:50:22.67,0:50:23.83,voiceover,,0,0,0,,Pinatay niya siya
Dialogue: 0,0:50:24.88,0:50:26.42,voiceover,,0,0,0,,Napagpasyahan niyang ako iyon
Dialogue: 0,0:50:55.61,0:50:57.78,voiceover,,0,0,0,,Iniwan ako ni Dan Zhu
Dialogue: 0,0:51:25.14,0:51:27.44,voiceover,,0,0,0,,Ikaw ba talaga yan?
Dialogue: 0,0:51:32.15,0:51:34.24,italics,,0,0,0,,- Start\N- Oo
Dialogue: 0,0:52:00.55,0:52:03.22,italics,,0,0,0,,Nahuli ni Chonbugwan si Nak Soo, pero hindi kaya ng mga magician ng Pine Forest?
Dialogue: 0,0:52:03.31,0:52:05.68,italics,,0,0,0,,Si Sosnovy Bor ay napahiya
Dialogue: 0,0:52:05.77,0:52:09.19,italics,,0,0,0,,May deputy sa Gwangju
Dialogue: 0,0:52:09.27,0:52:10.23,italics,,0,0,0,,Eksakto
Dialogue: 0,0:52:26.41,0:52:28.42,voiceover,,0,0,0,,Kaya si Dan Zhu ay Jin Mu,
Dialogue: 0,0:52:28.50,0:52:32.17,behind the scenes,,0,0,0,,Gwangju Deputy of Royal Jeonbugwan
Dialogue: 0,0:52:44.47,0:52:46.31,voiceover,,0,0,0,,Nasusunog ako
Dialogue: 0,0:52:47.81,0:52:52.15,behind the scenes,,0,0,0,,Tulad ng nasunog ang bahay at magulang ko noong araw na iyon
Dialogue: 0,0:52:58.45,0:53:00.24,mga alaala,,0,0,0,,bibigyan kita ng lakas
Dialogue: 0,0:53:00.32,0:53:02.03,memories,,0,0,0,,Sasama ka ba sa akin?
Dialogue: 0,0:53:40.20,0:53:41.41,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:53:42.36,0:53:44.95,general text,,0,0,0,,Sa nakikita mo, wala akong magagawa,
Dialogue: 0,0:53:45.74,0:53:47.91,pangkalahatang text,,0,0,0,,panoorin mo lang na nasusunog ang katawan ko
Dialogue: 0,0:53:49.75,0:53:51.71,general text,,0,0,0,,Hindi rin kita matutulungan
Dialogue: 0,0:53:59.01,0:54:00.34,pangkalahatang teksto,,0,0,0,,Nahanap ko ang iyong espada
Dialogue: 0,0:54:07.85,0:54:10.18,general text,,0,0,0,,Sabi mo maibabalik mo ang iyong kapangyarihan kung makuha mo ang iyong espada
Dialogue: 0,0:54:17.19,0:54:20.24,general text,,0,0,0,,Bakit ka gising? Halika, subukan mong ilabas ito
Dialogue: 0,0:54:38.17,0:54:40.71,pangkalahatang teksto,,0,0,0,,Kinikilala ng hindi maunahang espada ang may-ari nito
Dialogue: 0,0:54:50.85,0:54:53.56,general text,,0,0,0,,Ngayon kailangan kong tanggapin ang kanyang lakas
Dialogue: 0,0:55:30.14,0:55:32.39,italics,,0,0,0,,Masyado kang mahina para maghubad
Dialogue: 0,0:55:33.48,0:55:34.94,italics,,0,0,0,,iyong sariling espada
Dialogue: 0,0:55:37.31,0:55:39.15,pangkalahatang teksto,,0,0,0,,Wala kang kapangyarihan gaya ko
Dialogue: 0,0:55:40.15,0:55:41.44,general text,,0,0,0,,Wala tayong silbi
Dialogue: 0,0:55:46.74,0:55:49.28,pangkalahatang teksto,,0,0,0,,Tama na, kalimutan mo na
Dialogue: 0,0:55:49.99,0:55:51.12,pangkalahatang teksto,,0,0,0,,Umalis ka
Dialogue: 0,0:55:56.83,0:56:00.67,general text,,0,0,0,,I doubt na banta ka kay Sosnovy Bor, at patay na si Nak Su
Dialogue: 0,0:56:02.00,0:56:04.13,pangkalahatang text,,0,0,0,,Mabuhay tulad ni Moo Dok
Dialogue: 0,0:56:09.01,0:56:10.68,general text,,0,0,0,,Mas gugustuhin ko pang mamatay,
Dialogue: 0,0:56:14.85,0:56:16.27,pangkalahatang teksto,,0,0,0,,paano ako mabubuhay ng ganito
Dialogue: 0,0:56:18.81,0:56:20.48,pangkalahatang teksto,,0,0,0,,Pagkatapos ay mamatay!
Dialogue: 0,0:57:12.66,0:57:14.62,mga alaala,,0,0,0,,Ito ang libingan ng mga nomadic soul swallowers
Dialogue: 0,0:57:15.70,0:57:18.21,memories italics,,0,0,0,,Ang nagturo sa akin ng spell na ito,
Dialogue: 0,0:57:18.29,0:57:20.83,mga alaala na italics,,0,0,0,,tinapon ang mga katawan dito
Dialogue: 0,0:57:31.76,0:57:32.89,pangkalahatang teksto,,0,0,0,,Kaya ito ay magiging
Dialogue: 0,0:57:34.30,0:57:36.14,pangkalahatang teksto,,0,0,0,,at ang libingan ko rin
Dialogue: 0,0:58:03.88,0:58:07.59,italics,,0,0,0,,Sir, kailan po natin mabubuksan ang lugar na ito?
Dialogue: 0,0:58:08.96,0:58:10.30,general text,,0,0,0,,tapos na ako
Dialogue: 0,0:58:10.97,0:58:12.68,general text,,0,0,0,,Ano ang nangyari kay Moo Deok?
Dialogue: 0,0:58:12.76,0:58:14.43,general text,,0,0,0,,Mukhang nawala siya
Dialogue: 0,0:58:18.64,0:58:19.89,italics,,0,0,0,,Nag-aalala lang ako
Dialogue: 0,0:58:20.81,0:58:23.10,general text,,0,0,0,,Pumunta siya sa Gyeongcheongdaeho Lake
Dialogue: 0,0:58:25.86,0:58:27.02,pangkalahatang teksto,,0,0,0,,Gyeongcheongdaeho Lake?
Dialogue: 0,0:58:30.32,0:58:31.99,mga alaala,,0,0,0,,mas gugustuhin kong mamatay,
Dialogue: 0,0:58:33.78,0:58:34.99,mga alaala,,0,0,0,,paano ako mabubuhay ng ganito
Dialogue: 0,0:58:35.07,0:58:36.53,mga alaala,,0,0,0,,Pagkatapos ay mamatay!
Dialogue: 0,0:59:50.19,0:59:51.32,pangkalahatang teksto,,0,0,0,,Moo Dok!
Dialogue: 0,0:59:52.28,0:59:53.36,pangkalahatang teksto,,0,0,0,,Moo Dok!
Dialogue: 0,1:00:57.38,1:01:00.84,mga inskripsiyon,,0,0,0,,Sejukwon, Pine Forest
Dialogue: 0,1:01:11.31,1:01:12.77,pangkalahatang teksto,,0,0,0,,Nasa Sejukwon ka
Dialogue: 0,1:01:13.73,1:01:15.53,general text,,0,0,0,,Sa ospital ni master Ho Yeom sa Sosnovy Bor
Dialogue: 0,1:01:16.65,1:01:19.61,general text,,0,0,0,,napapasok lang ako dito dahil sayo
Dialogue: 0,1:01:22.32,1:01:25.70,general text,,0,0,0,,Masakit ba mata mo? Binigyan kita ng mga patak
Dialogue: 0,1:01:26.58,1:01:29.54,italics,,0,0,0,,Sabi niya parang mga pasa ang mga blue spot sa mata mo
Dialogue: 0,1:01:29.62,1:01:32.17,pangkalahatang teksto,,0,0,0,,Ang mga patak na ito ay magpapagaan ng kanilang kulay
Dialogue: 0,1:01:32.79,1:01:33.88,pangkalahatang teksto,,0,0,0,,Patak-patak ang mga ito palagi
Dialogue: 0,1:01:41.76,1:01:43.39,pangkalahatang teksto,,0,0,0,,binunot ko ang aking espada
Dialogue: 0,1:01:45.14,1:01:46.26,general text,,0,0,0,,Ginawa ko talaga
Dialogue: 0,1:01:46.35,1:01:47.85,general text,,0,0,0,,Alam ko, nakita ko
Dialogue: 0,1:01:48.60,1:01:50.39,italics,,0,0,0,,Pero mahina ka pa rin
Dialogue: 0,1:01:50.48,1:01:52.73,pangkalahatang teksto,,0,0,0,,Nagtagumpay ka lamang salamat sa lakas ng lawa
Dialogue: 0,1:01:54.11,1:01:56.15,general text,,0,0,0,,Bumalik ang lakas ko noong nasa lawa ako
Dialogue: 0,1:01:57.78,1:01:59.07,general text,,0,0,0,,Kailangan kong bumalik doon
Dialogue: 0,1:01:59.15,1:02:02.61,pangkalahatang teksto,,0,0,0,,At? Mabubuhay ka ba sa ilalim ng tubig na parang isda?
Dialogue: 0,1:02:08.08,1:02:11.21,italics,,0,0,0,,Naramdaman ko ang pagdagsa ng enerhiya sa ilalim ng tubig
Dialogue: 0,1:02:11.29,1:02:12.92,italics,,0,0,0,,Kaya nabawi ko ang kapangyarihan ko
Dialogue: 0,1:02:13.50,1:02:14.67,pangkalahatang teksto,,0,0,0,,Ito na
Dialogue: 0,1:02:15.75,1:02:18.21,pangkalahatang teksto,,0,0,0,,Isang lalaki na may parehong malakas na enerhiya gaya ng lawa,
Dialogue: 0,1:02:18.88,1:02:21.63,pangkalahatang teksto,,0,0,0,,dapat gisingin ang enerhiya sa akin
Dialogue: 0,1:02:21.72,1:02:24.55,pangkalahatang teksto,,0,0,0,,At sino ito? Maghahanap ka rin ba ng guro?
Dialogue: 0,1:02:25.22,1:02:28.39,italics,,0,0,0,,Sa tingin mo ba may isang taong napakalakas?
Dialogue: 0,1:02:28.47,1:02:31.44,general text,,0,0,0,,Kahit meron, gusto ka ba niyang tulungan?
Dialogue: 0,1:02:32.60,1:02:34.27,general text,,0,0,0,,Ikaw si Nak Su, isang mersenaryong gumagala sa bawat katawan
Dialogue: 0,1:02:37.77,1:02:38.69,italics,,0,0,0,,Ano?
Dialogue: 0,1:02:38.78,1:02:41.36,pangkalahatang teksto,,0,0,0,,Wook sa Sejukwon?
Dialogue: 0,1:02:41.95,1:02:44.11,general text,,0,0,0,,Pumunta siya para ipakita ang sugatang kasambahay
Dialogue: 0,1:02:44.20,1:02:45.87,pangkalahatang text,,0,0,0,,Siya ang pumasok sa amin
Dialogue: 0,1:02:45.95,1:02:47.08,pangkalahatang teksto,,0,0,0,,Lingkod?
Dialogue: 0,1:02:48.49,1:02:49.91,general text,,0,0,0,,Moo Dok, I think?
Dialogue: 0,1:02:50.00,1:02:51.46,general text,,0,0,0,,Gaano siya nasaktan,
Dialogue: 0,1:02:52.00,1:02:54.92,general text,,0,0,0,,na siya mismo ang pumunta dito?
Dialogue: 0,1:03:11.06,1:03:13.19,general text,,0,0,0,,Narinig ko lang ang tungkol kay Saejukwon
Dialogue: 0,1:03:14.02,1:03:15.65,pangkalahatang teksto,,0,0,0,,Talagang kamangha-manghang ospital
Dialogue: 0,1:03:16.81,1:03:18.65,pangkalahatang teksto,,0,0,0,,Puno ng mga halamang gamot
Dialogue: 0,1:03:19.27,1:03:20.69,pangkalahatang teksto,,0,0,0,,Parang mga lason
Dialogue: 0,1:03:26.45,1:03:30.20,italics,,0,0,0,,Gagawing normal ng mga patak na ito ang kulay ng iyong mata
Dialogue: 0,1:03:30.29,1:03:31.83,pangkalahatang teksto,,0,0,0,,Higa, mamuhay tulad ni Moo Dok
Dialogue: 0,1:03:32.70,1:03:34.21,general text,,0,0,0,,Iyon lang ang magagawa ko para sa iyo
Dialogue: 0,1:03:34.29,1:03:35.58,pangkalahatang text,,0,0,0,,Mali ka
Dialogue: 0,1:03:36.75,1:03:39.29,pangkalahatang teksto,,0,0,0,,Nais kong ikaw ay maging aking Gyeongcheongdaeho Lake
Dialogue: 0,1:03:42.71,1:03:45.38,pangkalahatang text,,0,0,0,,Sabi mo hindi lang isang beses itinaya mo ang buhay mo dahil sa akin
Dialogue: 0,1:03:46.64,1:03:48.35,pangkalahatang teksto,,0,0,0,,Sumakay muli
Dialogue: 0,1:03:54.81,1:03:56.10,pangkalahatang teksto,,0,0,0,,Masakit ito
Dialogue: 0,1:04:03.49,1:04:04.86,general text,,0,0,0,,Ano ang idinagdag mo dito?
Dialogue: 0,1:04:07.20,1:04:09.20,pangkalahatang teksto,,0,0,0,,Isang nakakalason na halaman
Dialogue: 0,1:04:16.00,1:04:17.79,general text,,0,0,0,,pusta ko lahat sayo
Dialogue: 0,1:04:19.88,1:04:22.84,general text,,0,0,0,,Sana mabuhay ka
Dialogue: 0,1:04:39.31,1:04:40.61,pangkalahatang teksto,,0,0,0,,Kung kaya mo,
Dialogue: 0,1:04:43.94,1:04:45.90,general text,,0,0,0,,Ako ang magiging guro mo
Dialogue: 0,1:04:55.75,1:04:57.37,italics,,0,0,0,,Uk!
Dialogue: 0,1:04:58.33,1:05:00.38,pangkalahatang teksto,,0,0,0,,Ano ito? Uk
Dialogue: 0,1:05:00.46,1:05:01.54,pangkalahatang teksto,,0,0,0,,Uk!
Dialogue: 0,1:05:01.63,1:05:02.92,italics,,0,0,0,,Anong nangyari sa kanya?
Dialogue: 0,1:05:03.55,1:05:04.67,general text,,0,0,0,,Uminom siya ng lason
Dialogue: 0,1:05:06.38,1:05:07.88,pangkalahatang teksto,,0,0,0,,- Lason?{\i1}\N- Alin?
Dialogue: 0,1:05:07.97,1:05:11.51,pangkalahatang teksto,,0,0,0,,Hihinto ang kanyang puso sa loob ng anim na oras
Dialogue: 0,1:05:11.60,1:05:12.76,pangkalahatang teksto,,0,0,0,,Anong klaseng lason ito?
Dialogue: 0,1:05:12.85,1:05:15.27,italics,,0,0,0,,Hanggang sa maunawaan at maihanda mo ang panlunas,
Dialogue: 0,1:05:15.35,1:05:17.10,pangkalahatang teksto,,0,0,0,,huli na ang lahat
Dialogue: 0,1:05:17.18,1:05:19.73,general text,,0,0,0,,Isa lang ang paraan para mailigtas siya
Dialogue: 0,1:05:19.81,1:05:21.15,pangkalahatang teksto,,0,0,0,,Buksan ang pintuan ng kanyang lakas
Dialogue: 0,1:05:21.23,1:05:24.82,pangkalahatang teksto,,0,0,0,,at mag-isa mong alisin ang lason
Dialogue: 0,1:05:24.90,1:05:26.11,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:05:27.61,1:05:29.28,pangkalahatang teksto,,0,0,0,,Buksan ang pintuan ng kanyang lakas
Dialogue: 0,1:05:29.90,1:05:31.49,general text,,0,0,0,,Kung hindi ay mamamatay siya
Dialogue: 0,1:05:35.16,1:05:36.95,pangkalahatang teksto,,0,0,0,,Hulyo...
Dialogue: 0,1:05:37.70,1:05:39.46,pangkalahatang teksto,,0,0,0,,U-uk uminom ng lason
Dialogue: 0,1:05:40.29,1:05:41.54,general text,,0,0,0,,Mamamatay daw siya
Dialogue: 0,1:05:41.63,1:05:44.46,general text,,0,0,0,,- Ano?\N- Binigyan siya ni Mu Dok ng lason
Dialogue: 0,1:05:44.54,1:05:46.92,general text,,0,0,0,,Pero hindi niya sinasabi kung alin,
Dialogue: 0,1:05:47.01,1:05:49.80,general text,,0,0,0,,kaya pinapahirapan siya ngayon ng kanyang tiyuhin
Dialogue: 0,1:05:55.47,1:05:57.06,pangkalahatang teksto,,0,0,0,,Anong klaseng lason ito?
Dialogue: 0,1:06:01.39,1:06:03.15,pangkalahatang teksto,,0,0,0,,Magpatuloy
Dialogue: 0,1:06:03.23,1:06:05.61,pangkalahatang text,,0,0,0,,- Maaaring mamatay siya\N- Namamatay si Uk ngayon
Dialogue: 0,1:06:06.36,1:06:10.03,pangkalahatang teksto,,0,0,0,,Dapat nating alamin ang pangalan ng lason sa loob ng dalawang oras
Dialogue: 0,1:06:16.45,1:06:17.54,italics,,0,0,0,,Mr.
Dialogue: 0,1:06:18.37,1:06:19.50,pangkalahatang teksto,,0,0,0,,Mr...
Dialogue: 0,1:06:21.58,1:06:22.79,pangkalahatang text,,0,0,0,,Buksan ang gate
Dialogue: 0,1:06:24.00,1:06:25.88,pangkalahatang teksto,,0,0,0,,Ito ang tanging paraan
Dialogue: 0,1:06:28.34,1:06:29.76,general text,,0,0,0,,Wala tayong oras!
Dialogue: 0,1:06:30.38,1:06:31.51,pangkalahatang teksto,,0,0,0,,Mr...
Dialogue: 0,1:06:32.51,1:06:34.59,pangkalahatang teksto,,0,0,0,,Pakiligtas ang aming panginoon!
Dialogue: 0,1:06:49.32,1:06:50.78,general text,,0,0,0,,- Mister\N- Kumusta ang Uk?
Dialogue: 0,1:06:50.86,1:06:52.49,general text,,0,0,0,,May nangyari ba?
Dialogue: 0,1:06:52.57,1:06:54.49,general text,,0,0,0,,Inalis ni Masteo Ho Yeom ang lason
Dialogue: 0,1:06:55.12,1:06:56.62,italics,,0,0,0,,Mr. Ligtas si Chan
Dialogue: 0,1:06:57.20,1:06:59.79,general text,,0,0,0,,- Naghanda ba siya ng antidote?{\i1}\N- Hindi
Dialogue: 0,1:07:00.54,1:07:03.62,pangkalahatang teksto,,0,0,0,,Binuksan niya ang mga pintuan ng kanyang lakas
Dialogue: 0,1:07:29.19,1:07:31.99,general text,,0,0,0,,Sir, gising ka na ba?
Dialogue: 0,1:07:44.12,1:07:46.04,general text,,0,0,0,,Buhay ba ako o patay na?
Dialogue: 0,1:07:47.29,1:07:49.00,pangkalahatang text,,0,0,0,,Halos hindi ka nakaligtas
Dialogue: 0,1:07:49.09,1:07:50.63,general text,,0,0,0,,Iniligtas ka ni Master Ho Yeom,
Dialogue: 0,1:07:51.76,1:07:54.01,pangkalahatang teksto,,0,0,0,,pagbubukas ng mga pintuan ng enerhiya
Dialogue: 0,1:07:56.43,1:07:58.09,general text,,0,0,0,,Nabuksan ba niya?
Dialogue: 0,1:07:58.18,1:07:59.64,pangkalahatang text,,0,0,0,,Yung lokong Moo Dok
Dialogue: 0,1:08:00.35,1:08:03.35,general text,,0,0,0,,hindi sinabi kung anong lason ang ibinigay ko sa iyo
Dialogue: 0,1:08:03.43,1:08:07.23,general text,,0,0,0,,Kaya wala na siyang ibang choice
Dialogue: 0,1:08:11.32,1:08:13.57,mga alaala,,0,0,0,,pusta ko lahat sayo
Dialogue: 0,1:08:14.19,1:08:17.36,mga alaala,,0,0,0,,Sana mabuhay ka
Dialogue: 0,1:08:20.37,1:08:21.79,general text,,0,0,0,,Nasaan si Moo Dok?
Dialogue: 0,1:08:40.80,1:08:41.93,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,1:08:48.60,1:08:49.85,pangkalahatang text,,0,0,0,,Moo Dok!
Dialogue: 0,1:09:00.41,1:09:01.37,pangkalahatang text,,0,0,0,,Moo Dok
Dialogue: 0,1:09:04.87,1:09:06.04,pangkalahatang text,,0,0,0,,Moo Dok
Dialogue: 0,1:09:10.54,1:09:11.63,italics,,0,0,0,,Moo Dok
Dialogue: 0,1:09:26.22,1:09:27.93,pangkalahatang text,,0,0,0,,Mamatay na sana tayong dalawa
Dialogue: 0,1:09:28.81,1:09:29.94,pangkalahatang teksto,,0,0,0,,Ikaw...
Dialogue: 0,1:09:31.27,1:09:32.61,pangkalahatang teksto,,0,0,0,,baliw ang katotohanan
Dialogue: 0,1:09:35.78,1:09:37.28,general text,,0,0,0,,Kaya nakaligtas ka,
Dialogue: 0,1:09:39.03,1:09:40.41,general text,,0,0,0,,my student
Dialogue: 0,1:09:46.70,1:09:47.95,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:09:49.87,1:09:51.67,general text,,0,0,0,,muntik na akong mamatay salamat sa iyo,
Dialogue: 0,1:09:58.21,1:09:59.97,general text,,0,0,0,,ang baliw kong guro
Dialogue: 0,1:11:10.91,1:11:15.04,preview,,0,0,0,,Bilang resulta, binuksan ni Uk ang gate ng kanyang energy
Dialogue: 0,1:11:15.12,1:11:18.92,preview,,0,0,0,,Dahil nakaligtas ako gaya ng pangako, ituturing kitang guro
Dialogue: 0,1:11:19.00,1:11:22.59,preview,,0,0,0,,Upang maging pinakamahusay na mago, kailangan mong dumaan sa ilang yugto
Dialogue: 0,1:11:22.67,1:11:25.05,preview,,0,0,0,,Mas masama ka sa inaakala ko
Dialogue: 0,1:11:25.13,1:11:26.39,preview,,0,0,0,,Napatingin kami kay Yulia
Dialogue: 0,1:11:26.47,1:11:27.76,preview,,0,0,0,,Moo Dok asked me to come
Dialogue: 0,1:11:27.85,1:11:29.51,preview,,0,0,0,,Itong babaeng ito, Moo Dok...
Dialogue: 0,1:11:29.60,1:11:31.81,preview,,0,0,0,,Mukhang may tinatago siya
Dialogue: 0,1:11:31.89,1:11:33.64,preview,,0,0,0,,Mahal kita!
Dialogue: 0,1:11:33.73,1:11:37.73,preview,,0,0,0,,Mr, dumating ang Crown Prince para makita ka
Dialogue: 0,1:11:37.81,1:11:40.02,preview,,0,0,0,,May isa pang espada dito na hindi mo mabubunot
Dialogue: 0,1:11:40.11,1:11:42.44,preview,,0,0,0,,Hindi maganda para sa akin kung mawawala rin ang espadang ito
Dialogue: 0,1:11:42.53,1:11:43.36,preview,,0,0,0,,Walang gagawin
Dialogue: 0,1:11:43.44,1:11:45.36,preview,,0,0,0,,Sinumang manalo kukuha ng espada
Dialogue: 0,1:11:04.76,1:11:06.76,pamagat,,0,0,0,,

Komento: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Beta editor: {\c&HFFF4C5&} Sana
