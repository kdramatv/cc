Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:00:59.26,0:01:01.42,teks umum,,0,0,0,,Inilah pakaian para penyihir Jeonjingak
Dialog: 0,0:01:01.92,0:01:04.51,teks umum,,0,0,0,,Kamu akan meningkatkan martabatmu sebagai penyihir Jeonjingak
Dialog: 0,0:01:05.47,0:01:07.72,miring,,0,0,0,,Sukses dalam mempelajari mantra
Dialog: 0,0:01:14.52,0:01:17.23,teks umum,,0,0,0,,Ini adalah jimat para penyihir Jeonjingak
Dialog: 0,0:01:18.11,0:01:19.78,teks umum,,0,0,0,,Dia memberikan hak
Dialog: 0,0:01:19.86,0:01:23.32,teks umum,,0,0,0,,melangkah kemana saja di Hutan Pinus dan Jeonjingak
Dialog: 0,0:01:29.37,0:01:31.08,miring,,0,0,0,,Ini adalah seperangkat aturan
Dialog: 0,0:01:31.58,0:01:33.00,teks umum,,0,0,0,,Anda akan mengikutinya
Dialog: 0,0:01:33.58,0:01:37.50,teks umum,,0,0,0,,Dan jika Anda melanggar aturan, Anda akan dihukum sesuai
Dialog: 0,0:01:39.46,0:01:42.13,teks umum,,0,0,0,,Chan Wook, berdiri dan membungkukkan kepala
Dialog: 0,0:02:05.61,0:02:06.70,teks umum,,0,0,0,,Chan Wook, berbalik
Dialog: 0,0:02:06.78,0:02:09.62,teks umum,,0,0,0,,dan tunduk pada para penyihir lainnya
Dialog: 0,0:02:31.22,0:02:35.02,teks umum,,0,0,0,,Mulai sekarang, Chan Wook, putra sulung keluarga Chan,
Dialog: 0,0:02:35.73,0:02:38.31,teks umum,,0,0,0,,pesulap Jeonjingak
Dialog: 0,0:03:08.09,0:03:09.80,teks umum,,0,0,0,,Hei, Chan Wook
Dialog: 0,0:03:09.89,0:03:11.76,teks umum,,0,0,0,,- Selamat\N- Selamat!
Dialog: 0,0:03:11.85,0:03:14.77,teks umum,,0,0,0,,- Kamu telah menempuh perjalanan panjang\N- Jadi, jadi, jadi, teman-teman
Dialog: 0,0:03:16.60,0:03:21.77,teks umum,,0,0,0,,Hari ini kita akan mengadakan liburan untuk menghormati pesulap baru kita - Chan Wook
Dialog: 0,0:03:21.86,0:03:24.48,teks umum,,0,0,0,,Kami menunggu semua orang di Chwisongru
Dialog: 0,0:03:25.65,0:03:27.28,teks umum,,0,0,0,,Keluarga Chan sudah membayar
Dialog: 0,0:03:27.36,0:03:30.82,teks umum,,0,0,0,,makanan dan minuman di Chwiseonru
Dialog: 0,0:03:30.91,0:03:32.53,teks umum,,0,0,0,,Oleh karena itu
Dialog: 0,0:03:33.91,0:03:35.95,teks umum,,0,0,0,,setiap orang harus minum sampai terjatuh
Dialog: 0,0:03:42.88,0:03:44.09,teks umum,,0,0,0,,Chwisonru!
Dialog: 0,0:03:44.17,0:03:46.84,teks umum,,0,0,0,,- Chwisungru!\N- Chan Wook!
Dialog: 0,0:03:46.92,0:03:51.51,teks umum,,0,0,0,,Aku ingat bagaimana Chang Gan datang ke sini bersama Chan Wook kecil. Ini seperti baru kemarin
Dialog: 0,0:03:51.59,0:03:53.22,teks umum,,0,0,0,,Aku tidak percaya hari ini telah tiba
Dialog: 0,0:03:55.10,0:03:57.64,teks umum,,0,0,0,,Aku sendiri tidak percaya
Dialog: 0,0:04:00.10,0:04:01.15,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:04:02.15,0:04:02.98,teks umum,,0,0,0,,Makan
Dialog: 0,0:04:05.57,0:04:06.57,teks umum,,0,0,0,,Apa ini?
Dialog: 0,0:04:06.65,0:04:08.28,teks umum,,0,0,0,,Pil Govenium
Dialog: 0,0:04:08.36,0:04:10.28,teks umum,,0,0,0,,Makan sebelum minum
Dialog: 0,0:04:10.36,0:04:12.61,teks umum,,0,0,0,,Anak-anak akan minum sampai saat terakhir
Dialogue: 0,0:04:12.70,0:04:14.91,teks umum,,0,0,0,,Setidaknya kita harus berusaha mengimbangi mereka
Dialog: 0,0:04:16.16,0:04:18.50,teks umum,,0,0,0,,Aku tidak akan mabuk tanpa ini
Dialog: 0,0:04:18.58,0:04:20.71,teks umum,,0,0,0,,Aku harus memikirkan umurku
Dialog: 0,0:04:22.08,0:04:23.50,teks umum,,0,0,0,,Bagaimana dengan umurku?
Dialog: 0,0:04:23.58,0:04:25.88,teks umum,,0,0,0,,Jadi ada kunci abu-abu
Dialog: 0,0:04:27.38,0:04:29.05,teks umum,,0,0,0,,Sepertinya karena sinar matahari
Dialog: 0,0:04:29.13,0:04:30.34,teks umum,,0,0,0,,Lihat dia
Dialog: 0,0:04:30.42,0:04:33.64,teks umum,,0,0,0,,Lihat betapa halusnya rambutku
Dialog: 0,0:04:34.97,0:04:36.47,teks umum,,0,0,0,,Cantik sekali
Dialog: 0,0:04:41.77,0:04:43.44,teks umum,,0,0,0,,Aku akan menyimpannya sendiri
Dialog: 0,0:04:43.52,0:04:44.86,teks umum,,0,0,0,,Ya, ambillah
Dialog: 0,0:05:04.17,0:05:05.25,teks umum,,0,0,0,,Nona Do Hwa,
Dialog: 0,0:05:06.38,0:05:07.75,teks umum,,0,0,0,,tuan muda
Dialog: 0,0:05:08.71,0:05:13.43,teks umum,,0,0,0,,menjadi penyihir Jeongjingak, seperti ayahnya
Dialog: 0,0:05:15.84,0:05:17.43,miring,,0,0,0,,Apakah kamu bahagia?
Dialog: 0,0:05:37.41,0:05:38.99,di belakang layar,,0,0,0,,Kamu melakukan pekerjaan dengan baik
Dialog: 0,0:05:40.20,0:05:41.58,di belakang layar,,0,0,0,,sejak kita bertemu
Dialog: 0,0:05:48.71,0:05:50.21,kenangan miring,,0,0,0,,Saya mengerti pada pandangan pertama
Dialog: 0,0:05:52.09,0:05:53.51,kenangan,,0,0,0,,Kamu adalah tuanku,
Dialog: 0,0:05:54.17,0:05:55.38,kenangan,,0,0,0,,Nak Su
Dialog: 0,0:05:55.47,0:05:56.97,kenangan,,0,0,0,,Aku ingin kamu menjadi guruku
Dialog: 0,0:05:57.05,0:05:58.93,kenangan,,0,0,0,,Omong kosong apa?
Dialog: 0,0:05:59.01,0:06:00.76,kenangan,,0,0,0,,Jika kamu selamat,
Dialog: 0,0:06:00.85,0:06:02.68,kenangan,,0,0,0,,Aku akan menjadi tuanmu
Dialog: 0,0:06:03.81,0:06:04.89,kenangan,,0,0,0,,Guru
Dialog: 0,0:06:04.98,0:06:06.27,kenangan,,0,0,0,,akhirnya aku mengerti
Dialog: 0,0:06:42.18,0:06:43.39,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:06:43.97,0:06:46.31,teks umum,,0,0,0,,Jadi bagaimana caranya? Apakah itu cocok untukku?
Dialog: 0,0:06:46.89,0:06:50.27,teks umum,,0,0,0,,Bagaimana mengatakannya... Bagaimana saya tahu?
Dialogue: 0,0:06:51.94,0:06:54.82,teks umum,,0,0,0,,Guru, muridmu seperti apa?
Dialog: 0,0:06:56.78,0:07:00.16,teks umum,,0,0,0,,Pakaian ini cocok untuk So Yulyu dan Park Dan Gu,
Dialogue: 0,0:07:02.83,0:07:05.04,teks umum,,0,0,0,,tapi di muridku kelihatannya sempurna
Dialog: 0,0:07:12.13,0:07:13.25,teks umum,,0,0,0,,Cukup
Dialog: 0,0:07:14.42,0:07:15.71,teks umum,,0,0,0,,Aku tidak bisa bernapas
Dialog: 0,0:07:16.72,0:07:17.76,teks umum,,0,0,0,,Guru,
Dialog: 0,0:07:18.93,0:07:19.93,teks umum,,0,0,0,,terima kasih
Dialog: 0,0:07:25.06,0:07:27.98,teks umum,,0,0,0,,Oke, Moo Dok. Ayo kita minum
Dialog: 0,0:07:32.02,0:07:34.23,teks umum,,0,0,0,,Chan Wook, tunggu
Dialog: 0,0:07:34.86,0:07:37.78,teks umum,,0,0,0,,- Chan Wook...\N- Tuan, Anda terlihat sangat baik
Dialog: 0,0:07:38.82,0:07:39.66,teks umum,,0,0,0,,Host
Dialog: 0,0:07:41.57,0:07:43.03,teks umum,,0,0,0,,Terima ini
Dialog: 0,0:07:44.08,0:07:46.04,teks umum,,0,0,0,,Tuan Huo memberimu pil govenia
Dialog: 0,0:07:48.12,0:07:49.41,teks umum,,0,0,0,,Ah, govania?
Dialog: 0,0:07:49.50,0:07:51.33,teks umum,,0,0,0,,Perlu dibagi
Dialog: 0,0:07:53.71,0:07:55.92,teks umum,,0,0,0,,Sangat ideal untuk mabuk
Dialogue: 0,0:08:06.93,0:08:08.35,teks umum,,0,0,0,,Ini, pembantu Kim
Dialog: 0,0:08:09.73,0:08:10.89,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:08:10.98,0:08:13.52,teks umum,,0,0,0,,Tadinya aku akan memberikannya padamu. Benar
Dialog: 0,0:08:13.61,0:08:16.94,teks umum,,0,0,0,,Maiden Kim, kembalilah. Ambillah. Benar sekali
Dialog: 0,0:08:17.03,0:08:18.94,teks umum,,0,0,0,,Maiden Kim, tolong
Dialog: 0,0:08:25.91,0:08:30.00,teks umum,,0,0,0,,Lahir di bawah bintang raja memasuki Sosnovy Bor
Dialog: 0,0:08:30.58,0:08:33.79,teks umum,,0,0,0,,Ayahnya menggunakan batu es untuk merapal mantra
Dialog: 0,0:08:34.75,0:08:37.09,teks umum,,0,0,0,,Kelahiran Chan Wook adalah akibat dari ilmu sihir ini
Dialog: 0,0:08:37.17,0:08:39.88,teks umum,,0,0,0,,Anak ini adalah bencana bagi Sosnovy Bor
Dialogue: 0,0:08:39.97,0:08:42.26,teks umum,,0,0,0,,Menurutmu kenapa Chang Gang melakukan ini?
Dialogue: 0,0:08:42.76,0:08:45.35,teks umum,,0,0,0,,Dia bisa menjadikan putranya raja,
Dialog: 0,0:08:45.43,0:08:49.98,teks umum,,0,0,0,,gunakan batu untuk merasuki Hwansu. Dia akan menundukkan dunia pada dirinya sendiri
Dialogue: 0,0:08:50.06,0:08:52.56,teks umum,,0,0,0,,Mengapa dia menyegel gerbang putranya
Dialog: 0,0:08:52.64,0:08:54.90,teks umum,,0,0,0,,dan menyembunyikan batu es?
Dialog: 0,0:08:56.06,0:08:57.90,teks umum,,0,0,0,,Karena aku lemah
Dialog: 0,0:08:59.48,0:09:00.74,miring,,0,0,0,,Dia menyegel segalanya dan melarikan diri,
Dialog: 0,0:09:00.82,0:09:03.16,miring,,0,0,0,,karena dia tidak bisa mengatasinya
Dialog: 0,0:09:07.49,0:09:08.99,teks umum,,0,0,0,,Menurutmu, Kil Ju
Dialog: 0,0:09:09.95,0:09:11.71,teks umum,,0,0,0,,membunuh Chang Gan?
Dialog: 0,0:09:12.25,0:09:13.58,teks umum,,0,0,0,,Jika dia kembali...
Dialog: 0,0:09:13.67,0:09:17.42,teks umum,,0,0,0,,Chang Gan tidak akan melakukan hal seperti itu secara terbuka
Dialog: 0,0:09:19.05,0:09:21.17,teks umum,,0,0,0,,Saya curiga Guru Li
Dialog: 0,0:09:21.84,0:09:25.05,teks umum,,0,0,0,,Kita perlu menambah kekuatan sebelum Hutan Pinus mulai mendaki
Dialog: 0,0:09:27.97,0:09:29.89,teks umum,,0,0,0,,Sepuluh tahun yang lalu kita berhasil
Dialog: 0,0:09:29.97,0:09:33.31,teks umum,,0,0,0,,mendapatkan batu yang disegel oleh Chang Gan
Dialog: 0,0:09:47.07,0:09:48.99,kenangan,,0,0,0,,Kamu menemukannya
Dialog: 0,0:09:50.04,0:09:51.33,kenangan,,0,0,0,,Bu Muda,
Dialog: 0,0:09:51.41,0:09:53.12,kenangan,,0,0,0,,berikan aku batu esnya
Dialog: 0,0:10:04.38,0:10:07.01,miring,,0,0,0,,Dia masih sangat muda, tapi dia mampu menemukan batu itu
Dialog: 0,0:10:07.59,0:10:10.47,miring,,0,0,0,,Harus kita akui kalau kekuatannya sungguh menakjubkan
Dialog: 0,0:10:13.48,0:10:16.60,teks umum,,0,0,0,,Kudengar Jin Ho Kyung tidak percaya dengan kematian putrinya
Dialog: 0,0:10:16.69,0:10:18.36,teks umum,,0,0,0,,dan masih mencarinya
Dialog: 0,0:10:19.02,0:10:20.61,teks umum,,0,0,0,,Jadi aku ingin menemukannya
Dialog: 0,0:10:22.57,0:10:24.90,teks umum,,0,0,0,,Aku akan menemukan putri yang selama ini dia cari.
Dialog: 0,0:10:24.99,0:10:28.49,teks umum,,0,0,0,,dan aku akan menjadikan Jin Ho Kyung bonekaku
Dialog: 0,0:10:28.57,0:10:30.78,teks umum,,0,0,0,,Bagaimana cara menemukan gadis yang mati?
Dialog: 0,0:10:32.08,0:10:33.95,teks umum,,0,0,0,,Aku akan mencari seseorang
Dialog: 0,0:10:34.45,0:10:37.75,teks umum,,0,0,0,,Orang yang membuat Ho Kyung percaya bahwa itu adalah Boo Young
Dialog: 0,0:10:56.23,0:10:57.52,teks umum,,0,0,0,,Di Sini. Makan
Dialog: 0,0:11:03.11,0:11:06.11,teks umum,,0,0,0,,Apakah kamu sudah makan sesuatu sejak meninggalkan Desa Sari?
Dialog: 0,0:11:14.91,0:11:15.95,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:11:17.79,0:11:19.33,teks umum,,0,0,0,,Makan
Dialog: 0,0:11:28.30,0:11:29.55,teks umum,,0,0,0,,Luangkan waktumu
Dialogue: 0,0:11:30.18,0:11:32.93,teks umum,,0,0,0,,Mengapa gadis buta ini berlayar sendirian ke kota?
Dialog: 0,0:11:33.01,0:11:34.76,teks umum,,0,0,0,,Dia sedang mencari teman
Dialog: 0,0:11:35.43,0:11:38.73,teks umum,,0,0,0,,Temannya mencuri semua barangnya
Dialog: 0,0:11:38.81,0:11:40.81,teks umum,,0,0,0,,dan melarikan diri ke kota
Dialog: 0,0:11:40.90,0:11:42.90,teks umum,,0,0,0,,Gadis malang
Dialog: 0,0:11:43.48,0:11:46.61,teks umum,,0,0,0,,Apakah kamu tahu ke mana harus pergi? Siapa nama temanmu?
Dialog: 0,0:11:48.61,0:11:49.82,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:11:50.45,0:11:54.08,teks umum,,0,0,0,,Nama temanku adalah Moo Deok
Dialog: 0,0:11:55.08,0:11:57.79,teks umum,,0,0,0,,- “Moo Dok”?\N- Bagaimana dia menemukannya?
Dialog: 0,0:12:00.29,0:12:01.75,miring,,0,0,0,,Toffees manis!
Dialog: 0,0:12:01.83,0:12:04.29,miring,,0,0,0,,- Permen manis!\N- Cobalah kue kami!
Dialog: 0,0:12:04.38,0:12:06.42,teks umum,,0,0,0,,Kemarilah! Membeli!
Dialog: 0,0:12:06.50,0:12:08.34,miring,,0,0,0,,Pai manis!
Dialogue: 0,0:12:08.42,0:12:11.68,teks umum,,0,0,0,,Cuacanya bagus ya?
Dialog: 0,0:12:11.76,0:12:13.89,teks umum,,0,0,0,,Bu, beli pai
Dialog: 0,0:12:13.97,0:12:15.68,teks umum,,0,0,0,,Saya tidak punya uang
Dialog: 0,0:12:15.76,0:12:16.97,teks umum,,0,0,0,,Bu, belilah!
Dialog: 0,0:12:17.06,0:12:18.35,teks umum,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:12:18.43,0:12:20.14,teks umum,,0,0,0,,Oke, tunggu
Dialog: 0,0:12:22.23,0:12:24.15,teks umum,,0,0,0,,Oh, dimana mereka?
Dialog: 0,0:12:24.23,0:12:26.61,teks umum,,0,0,0,,- Di mana uangku?\N- Apa itu?
Dialog: 0,0:12:26.69,0:12:29.15,teks umum,,0,0,0,,Uang hilang
Dialog: 0,0:12:29.82,0:12:32.11,teks umum,,0,0,0,,- Apa yang harus dilakukan?\N- Cincinku...
Dialog: 0,0:12:33.11,0:12:35.20,teks umum,,0,0,0,,- Cincinnya hilang!\N- Surga...
Dialog: 0,0:13:05.56,0:13:06.90,teks umum,,0,0,0,,Apa?
Dialog: 0,0:13:08.40,0:13:10.74,teks umum,,0,0,0,,Hanya itu saja?
Dialog: 0,0:13:13.91,0:13:15.74,teks umum,,0,0,0,,Cincinnya juga murah
Dialogue: 0,0:13:17.66,0:13:21.50,teks umum,,0,0,0,,Aku menyalib diriku disana dan semuanya sia-sia
Dialogue: 0,0:14:26.48,0:14:28.31,teks umum,,0,0,0,,- Terima kasih\N- Tuangkan untukku
Dialog: 0,0:14:31.44,0:14:33.28,teks umum,,0,0,0,,- Selamat menikmati\N- Terima kasih
Dialog: 0,0:15:11.69,0:15:14.61,di balik layar,,0,0,0,,Kamu tahu siapa aku selama ini
Dialog: 0,0:15:16.36,0:15:18.66,kenangan miring,,0,0,0,,Daripada teman di dekatmu, kamu punya peluit
Dialogue: 0,0:15:20.03,0:15:21.91,kenangan miring,,0,0,0,,Jadi temanmu meninggalkanmu
Dialog: 0,0:15:39.63,0:15:40.93,teks umum,,0,0,0,,Mr. Yul?
Dialog: 0,0:15:44.18,0:15:45.35,teks umum,,0,0,0,,Ah, Moo Deok
Dialog: 0,0:15:46.14,0:15:48.35,teks umum,,0,0,0,,Kenapa kamu duduk di jalan?
Dialogue: 0,0:15:48.44,0:15:50.15,teks umum,,0,0,0,,Maukah kamu minum?
Dialog: 0,0:15:52.02,0:15:54.69,teks umum,,0,0,0,,No. Aku sudah muak
Dialog: 0,0:15:56.11,0:15:57.19,teks umum,,0,0,0,,Aku sudah mabuk
Dialog: 0,0:15:58.28,0:16:00.24,teks umum,,0,0,0,,Dan kamu terlihat baik
Dialog: 0,0:16:01.49,0:16:02.78,teks umum,,0,0,0,,aku mabuk,
Dialog: 0,0:16:03.74,0:16:05.41,teks umum,,0,0,0,,jadi aku tersesat
Dialog: 0,0:16:08.87,0:16:11.42,teks umum,,0,0,0,,Aku cepat tersesat jika kepalaku berkabut
Dialog: 0,0:16:13.63,0:16:17.01,teks umum,,0,0,0,,Bagaimana kamu bisa tersesat di sini?
Dialog: 0,0:16:20.43,0:16:23.09,teks umum,,0,0,0,,Bangun, aku akan mengantarmu pulang
Dialog: 0,0:16:25.51,0:16:26.76,teks umum,,0,0,0,,Kamu terluka
Dialog: 0,0:16:27.72,0:16:29.35,teks umum,,0,0,0,,Ini berbahaya
Dialog: 0,0:16:29.43,0:16:32.77,teks umum,,0,0,0,,Apakah kamu memarahiku lagi? Mungkin tidak hari ini?
Dialog: 0,0:16:34.77,0:16:36.44,teks umum,,0,0,0,,Bukan hakku untuk memarahimu
Dialog: 0,0:16:37.44,0:16:39.61,teks umum,,0,0,0,,Saya sendiri yang membuat kesalahan
Dialog: 0,0:16:40.95,0:16:42.16,teks umum,,0,0,0,,Apakah kamu?
Dialog: 0,0:16:43.20,0:16:44.16,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:45.74,0:16:49.08,teks umum,,0,0,0,,Saya selalu melakukan hal yang benar. Tidak tersesat
Dialog: 0,0:16:52.79,0:16:55.96,teks umum,,0,0,0,,Tapi aku tersesat
Dialog: 0,0:17:00.42,0:17:01.97,teks umum,,0,0,0,,Dan sekarang aku memegang tanganmu
Dialog: 0,0:17:07.06,0:17:09.22,teks umum,,0,0,0,,Aku tidak tahu kemana jalanku akan membawaku
Dialog: 0,0:17:14.60,0:17:16.31,teks umum,,0,0,0,,Dia akan menuntunmu mengejarku
Dialog: 0,0:17:35.33,0:17:36.58,teks umum,,0,0,0,,Kau memegang tanganku
Dialog: 0,0:17:38.67,0:17:39.84,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:17:42.92,0:17:46.22,teks umum,,0,0,0,,Kamu tersesat saat kepalamu berkabut
Dialog: 0,0:17:46.30,0:17:48.43,teks umum,,0,0,0,,Semua karena kamu banyak memikirkan
Dialog: 0,0:17:49.47,0:17:51.89,teks umum,,0,0,0,,Jika ini terjadi, pikirkan satu hal
Dialog: 0,0:17:51.98,0:17:55.56,teks umum,,0,0,0,,Misalnya, pikirkan tentang aku sekarang
Dialog: 0,0:18:04.90,0:18:08.03,teks umum,,0,0,0,,Oke. Sekarang aku akan memikirkanmu
Dialog: 0,0:18:15.54,0:18:19.63,teks umum,,0,0,0,,Mr. Jadi, bolehkah aku menanyakan sesuatu padamu?
Dialog: 0,0:18:20.17,0:18:21.13,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:18:21.88,0:18:24.97,teks umum,,0,0,0,,Kamu bilang kamu memimpikanku
Dialog: 0,0:18:25.05,0:18:26.38,teks umum,,0,0,0,,Apa yang dapat dilihat dari penglihatanku?
Dialog: 0,0:18:27.89,0:18:29.22,teks umum,,0,0,0,,Bahwa kamu menyukaiku
Dialog: 0,0:18:29.80,0:18:32.14,teks umum,,0,0,0,,- Apa?\N- Apa itu?
Dialog: 0,0:18:32.22,0:18:33.89,teks umum,,0,0,0,,Kamu sendiri yang sering mengulanginya
Dialog: 0,0:18:34.73,0:18:36.14,teks umum,,0,0,0,,Yah, itu karena...
Dialog: 0,0:18:40.06,0:18:42.40,teks umum,,0,0,0,,Apakah itu semua bohong?
Dialog: 0,0:18:44.36,0:18:46.40,teks umum,,0,0,0,,Aku menyukaimu, tapi...
Dialog: 0,0:18:47.28,0:18:49.74,teks umum,,0,0,0,,Ya, aku menyukaimu
Dialog: 0,0:19:18.48,0:19:20.10,teks umum,,0,0,0,,Terima kasihku
Dialog: 0,0:19:33.99,0:19:35.50,teks umum,,0,0,0,,Apakah dia benar-benar percaya?
Dialog: 0,0:19:37.50,0:19:39.17,teks umum,,0,0,0,,kuharap tidak
Dialog: 0,0:19:45.42,0:19:47.05,teks umum,,0,0,0,,Cukup
Dialog: 0,0:19:47.13,0:19:49.68,teks umum,,0,0,0,,Semua berkatmu, tuan
Dialog: 0,0:19:50.39,0:19:52.39,teks umum,,0,0,0,,Saya yakin Nyonya Do Hwa akan senang
Dialog: 0,0:19:52.89,0:19:54.22,teks umum,,0,0,0,,Akhirnya saya...
Dialog: 0,0:19:54.31,0:19:58.27,teks umum,,0,0,0,,merasa seperti aku melakukan sesuatu yang baik untuk Do Hwa sebagai permintaan maaf
Dialog: 0,0:19:58.98,0:20:01.56,teks umum,,0,0,0,,Kamu tidak melakukan kesalahan apa pun
Dialog: 0,0:20:01.65,0:20:04.94,teks umum,,0,0,0,,Akulah yang membawanya ke Sejukwon dari kampung halamanku
Dialog: 0,0:20:05.02,0:20:08.03,teks umum,,0,0,0,,Begitulah cara dia bertemu Chang Gan
Dialog: 0,0:20:08.90,0:20:11.11,teks umum,,0,0,0,,Do Hwa baik sekali
Dialog: 0,0:20:11.20,0:20:15.33,teks umum,,0,0,0,,Aku tidak percaya dia mempercayai semua gosip ini
Dialog: 0,0:20:15.41,0:20:18.12,teks umum,,0,0,0,,Chan Gan, bajingan sekali
Dialog: 0,0:20:19.00,0:20:21.71,teks umum,,0,0,0,,Tuan, kamu mabuk
Dialog: 0,0:20:21.79,0:20:23.21,teks umum,,0,0,0,,Ini salahmu!
Dialog: 0,0:20:24.96,0:20:26.92,teks umum,,0,0,0,,Apa yang kulakukan?
Dialog: 0,0:20:27.00,0:20:31.34,teks umum,,0,0,0,,Aku membawa Do Hwa ke Saejukwon untuk menjodohkanmu dengannya
Dialog: 0,0:20:31.43,0:20:32.34,teks umum,,0,0,0,,Jadi apa?
Dialog: 0,0:20:32.43,0:20:34.43,teks umum,,0,0,0,,Surga suci
Dialog: 0,0:20:35.05,0:20:37.22,teks umum,,0,0,0,,Dengan penampilan dan keterampilan seperti itu
Dialog: 0,0:20:37.31,0:20:40.18,teks umum,,0,0,0,,tidak bisa mendapatkan hati seorang gadis?
Dialog: 0,0:20:40.27,0:20:43.27,teks umum,,0,0,0,,Betapa menyebalkannya kamu!
Dialog: 0,0:20:45.48,0:20:46.65,teks umum,,0,0,0,,Ya, ya
Dialog: 0,0:20:46.73,0:20:49.32,teks umum,,0,0,0,,Guru Huo banyak membantu Anda,
Dialog: 0,0:20:49.40,0:20:51.20,teks umum,,0,0,0,,dan Anda tidak memanfaatkan satu peluang pun
Dialog: 0,0:20:52.70,0:20:53.87,teks umum,,0,0,0,,Saya melakukannya
Dialog: 0,0:20:55.28,0:20:56.41,teks umum,,0,0,0,,semua yang aku bisa
Dialog: 0,0:20:57.79,0:20:59.00,teks umum,,0,0,0,,Saya menulis puisi
Dialog: 0,0:21:01.21,0:21:02.33,teks umum,,0,0,0,,Diberi hadiah
Dialog: 0,0:21:03.62,0:21:05.63,teks umum,,0,0,0,,Tapi kamu tidak mengaku padanya
Dialog: 0,0:21:07.00,0:21:08.21,miring,,0,0,0,,"Aku cinta kamu"
Dialog: 0,0:21:08.30,0:21:09.67,teks umum,,0,0,0,,"Maukah kamu menjadi milikku?"
Dialog: 0,0:21:09.76,0:21:12.88,teks umum,,0,0,0,,Kami berjalan mengitari semak-semak, tapi tidak berkata apa-apa
Dialog: 0,0:21:12.97,0:21:16.01,teks umum,,0,0,0,,Tentu saja, kamu kalah dari orang yang mengatakan semuanya secara langsung
Dialog: 0,0:21:16.10,0:21:18.35,teks umum,,0,0,0,,Apakah perlu berbicara terbuka tentang perasaan?
Dialog: 0,0:21:20.35,0:21:23.39,teks umum,,0,0,0,,Cukup petunjuk
Dialog: 0,0:21:24.19,0:21:25.69,teks umum,,0,0,0,,Betapa menyebalkannya kamu
Dialog: 0,0:21:26.31,0:21:28.98,teks umum,,0,0,0,,Mereka menunjukkan ketertarikan, namun menjaga jarak
Dialog: 0,0:21:29.07,0:21:30.61,teks umum,,0,0,0,,Kemudian mereka mendekat lagi
Dialogue: 0,0:21:30.69,0:21:32.45,teks umum,,0,0,0,,Kita perlu bicara dengan seorang wanita tentang perasaan
Dialog: 0,0:21:32.53,0:21:36.57,teks umum,,0,0,0,,Jadi dia bisa memutuskan apakah akan menunggumu atau tidak
Dialog: 0,0:21:36.66,0:21:39.95,teks umum,,0,0,0,,Jika cinta begitu berubah-ubah hanya karena tidak diungkapkan dengan lantang,
Dialog: 0,0:21:41.08,0:21:42.21,teks umum,,0,0,0,,maka saya tidak membutuhkannya!
Dialog: 0,0:21:44.00,0:21:47.17,teks umum,,0,0,0,,Jika seorang wanita memutuskan untuk meninggalkanku dan pergi dengan orang lain,
Dialog: 0,0:21:47.67,0:21:49.13,teks umum,,0,0,0,, biarlah
Dialog: 0,0:21:49.88,0:21:50.84,teks umum,,0,0,0,,"Jadilah..."
Dialog: 0,0:21:59.35,0:22:00.64,teks umum,,0,0,0,,Lanjutkan tanpa aku
Dialog: 0,0:22:02.31,0:22:03.77,teks umum,,0,0,0,,Mau kemana?
Dialog: 0,0:22:03.85,0:22:05.90,teks umum,,0,0,0,,aku berangkat
Dialog: 0,0:22:06.56,0:22:08.02,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:22:08.90,0:22:11.98,teks umum,,0,0,0,,Tetap. Mari minum bersama kami...
Dialog: 0,0:22:12.07,0:22:13.53,teks umum,,0,0,0,,Tetap...
Dialog: 0,0:22:14.40,0:22:17.28,miring,,0,0,0,,Pembantu Kim, kembalilah, oke?
Dialog: 0,0:22:17.37,0:22:19.28,teks umum,,0,0,0,,- Saya akan menunggu\N- Benar...
Dialogue: 0,0:22:19.37,0:22:21.87,italic,,0,0,0,,- Maid Kim\N{\i0}- Suatu hari nanti dia akan menyesal
Dialog: 0,0:22:21.95,0:22:23.50,miring,,0,0,0,,Maiden Kim!
Dialog: 0,0:22:34.38,0:22:37.13,teks umum,,0,0,0,,Jadi di sinilah orang minum
Dialog: 0,0:22:37.22,0:22:39.76,teks umum,,0,0,0,,Semua orang menunggumu. Masuk
Dialog: 0,0:22:39.85,0:22:42.06,teks umum,,0,0,0,,Saya tidak bisa minum
Dialog: 0,0:22:42.14,0:22:45.73,teks umum,,0,0,0,,Aku kehabisan teh. Kita harus kembali ke Danhyangok
Dialogue: 0,0:22:45.81,0:22:47.56,teks umum,,0,0,0,,Ambilkan aku makanan
Dialog: 0,0:22:47.65,0:22:49.02,teks umum,,0,0,0,,Oke
Dialog: 0,0:22:55.11,0:22:58.61,teks umum,,0,0,0,,Bau parfum wanita dan bau minuman keras
Dialog: 0,0:23:00.91,0:23:02.79,teks umum,,0,0,0,,Ini bukan tempat untukku
Dialog: 0,0:23:08.50,0:23:09.79,teks umum,,0,0,0,,Cinta
Dialog: 0,0:23:11.96,0:23:13.59,teks umum,,0,0,0,,Tidak suka
Dialog: 0,0:23:15.09,0:23:16.38,teks umum,,0,0,0,,Cinta
Dialog: 0,0:23:17.72,0:23:20.55,teks umum,,0,0,0,,Tidak suka. Mencintai. Tidak suka...
Dialog: 0,0:23:20.64,0:23:23.56,teks umum,,0,0,0,,Apa yang aku lakukan?
Dialog: 0,0:23:23.64,0:23:25.18,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:23:30.27,0:23:33.44,teks umum,,0,0,0,,Bu! Apa yang harus dilakukan sekarang?
Dialog: 0,0:23:33.52,0:23:34.78,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:24:38.59,0:24:40.01,teks umum,,0,0,0,,Kamu seorang pesulap, kan?
Dialog: 0,0:24:45.55,0:24:46.56,teks umum,,0,0,0,,Guru Li?
Dialogue: 0,0:24:47.93,0:24:49.48,teks umum,,0,0,0,,Apakah kamu Master Li?
Dialog: 0,0:24:50.43,0:24:54.15,teks umum,,0,0,0,,Saya pembantu keluarga Chan. Melayani Tuan Chan
Dialog: 0,0:24:55.44,0:24:56.82,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:24:57.40,0:24:58.53,teks umum,,0,0,0,,Tidak layak
Dialog: 0,0:25:16.92,0:25:19.05,teks umum,,0,0,0,,Saya pikir itu tertangkap ketika Anda menangkap saya
Dialog: 0,0:25:19.13,0:25:21.88,teks umum,,0,0,0,,Tunggu, izinkan saya
Dialog: 0,0:25:22.55,0:25:24.93,teks umum,,0,0,0,,Maaf
Dialog: 0,0:25:31.68,0:25:32.94,teks umum,,0,0,0,,Selesai
Dialogue: 0,0:25:37.19,0:25:40.28,teks umum,,0,0,0,,Aku sudah menunggumu sepanjang malam,
Dialog: 0,0:25:40.36,0:25:42.57,teks umum,,0,0,0,,terima kasih
Dialog: 0,0:25:45.16,0:25:46.41,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:25:49.41,0:25:50.79,teks umum,,0,0,0,,Kemana dia pergi?
Dialog: 0,0:25:51.83,0:25:52.91,teks umum,,0,0,0,,Guru Li?
Dialog: 0,0:26:08.80,0:26:11.43,teks umum,,0,0,0,,Apakah karena aku sudah lama tidak minum teh?
Dialog: 0,0:26:14.60,0:26:17.90,prasasti,,0,0,0,,Saejukwon
Dialog: 0,0:26:19.61,0:26:21.90,miring,,0,0,0,,Tuan Huo tidak ada di sini sekarang
Dialog: 0,0:26:21.98,0:26:24.28,teks umum,,0,0,0,,Tapi dia menunggu kedatanganmu
Dialog: 0,0:26:24.99,0:26:26.36,teks umum,,0,0,0,,Ayo masuk
Dialog: 0,0:26:32.50,0:26:35.04,teks umum,,0,0,0,,Perayaan pesulap baru Jeonjingak?
Dialog: 0,0:26:35.12,0:26:36.71,teks umum,,0,0,0,,Tuan Ho akan kembali dalam keadaan mabuk
Dialog: 0,0:26:38.21,0:26:40.54,teks umum,,0,0,0,,Semua orang tahu bagaimana kakek suka minum
Dialog: 0,0:26:41.17,0:26:45.09,teks umum,,0,0,0,,Nyonya, mungkin kita harus pergi ke Chwisongru?
Dialog: 0,0:26:45.88,0:26:48.55,teks umum,,0,0,0,,Calon suamimu akan ada di sana
Dialog: 0,0:26:49.26,0:26:52.26,teks umum,,0,0,0,,- Apa?\N- Nyonya Ho memberitahuku semuanya
Dialog: 0,0:26:52.35,0:26:56.52,teks umum,,0,0,0,,Kudengar kakekmu memilih beberapa penyihir untuk menjadi suamimu
Dialog: 0,0:26:56.60,0:26:59.56,teks umum,,0,0,0,,Diantaranya adalah Park Dan Gu dari Sosnovy Bor
Dialog: 0,0:26:59.65,0:27:01.77,teks umum,,0,0,0,,dan Seo Yul dari keluarga Seo
Dialog: 0,0:27:01.86,0:27:04.03,teks umum,,0,0,0,,Aku di sini bukan untuk menikah
Dialog: 0,0:27:04.57,0:27:06.65,teks umum,,0,0,0,,Saya akan membantu di rumah sakit kerajaan
Dialog: 0,0:27:06.74,0:27:09.91,teks umum,,0,0,0,,Apakah menurut Anda Putra Mahkota juga ada dalam daftar?
Dialogue: 0,0:27:10.70,0:27:13.45,teks umum,,0,0,0,,- Kecantikanmu...\N- Song Yi!
Dialog: 0,0:27:13.54,0:27:15.66,teks umum,,0,0,0,,Alasanmu sudah membuatku malu sekali
Dialog: 0,0:27:17.41,0:27:18.83,teks umum,,0,0,0,,Sudah lupa?
Dialog: 0,0:27:18.92,0:27:21.71,teks umum,,0,0,0,,Apakah kamu berbicara tentang penyihir sombong itu?
Dialog: 0,0:27:22.38,0:27:25.46,teks umum,,0,0,0,,Saya harus menanyakan nama untuk memberi tahu Guru Ho
Dialog: 0,0:27:27.51,0:27:28.80,teks umum,,0,0,0,,Tepat sekali
Dialogue: 0,0:27:29.68,0:27:31.76,teks umum,,0,0,0,,Seharusnya aku tanya namanya
Dialog: 0,0:27:34.47,0:27:35.89,kenangan,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:27:39.19,0:27:41.06,teks umum,,0,0,0,,Saya ingin tahu apakah saya akan melihatnya...
Dialog: 0,0:27:43.77,0:27:45.15,teks umum,,0,0,0,,dia lagi
Dialog: 0,0:27:49.70,0:27:50.82,teks umum,,0,0,0,,Cukup
Dialog: 0,0:27:55.45,0:27:59.62,teks umum,,0,0,0,,Uk, kamu berhutang padaku,
Dialog: 0,0:27:59.71,0:28:01.46,teks umum,,0,0,0,,jadi berjanjilah
Dialog: 0,0:28:01.54,0:28:03.92,teks umum,,0,0,0,,- Janji apa?\N- Suatu hari nanti,
Dialogue: 0,0:28:04.00,0:28:08.59,teks umum,,0,0,0,,saat aku memintamu melakukan sesuatu, kamu akan melakukannya
Dialog: 0,0:28:09.72,0:28:10.97,teks umum,,0,0,0,,Oke, aku janji
Dialog: 0,0:28:11.72,0:28:13.47,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:28:13.55,0:28:16.81,teks umum,,0,0,0,,Pertama saya harus mengklarifikasi sesuatu
Dialog: 0,0:28:16.89,0:28:21.44,teks umum,,0,0,0,,Saya bertanya karena Anda mengenal Guru Li
Dialogue: 0,0:28:21.52,0:28:25.44,teks umum,,0,0,0,,Apakah kamu meminum teh kesuciannya?
Dialog: 0,0:28:26.53,0:28:29.74,teks umum,,0,0,0,,No. Tidak pernah. Tidak pernah minum
Dialogue: 0,0:28:30.36,0:28:32.16,teks umum,,0,0,0,,Jadi kamu tidak menjalankan selibat?
Dialog: 0,0:28:32.24,0:28:35.58,teks umum,,0,0,0,,Tidak, tentu saja. Saya ingin menikah suatu hari nanti
Dialog: 0,0:28:35.66,0:28:37.70,teks umum,,0,0,0,,Hebat. Di sini
Dialog: 0,0:28:41.08,0:28:43.08,teks umum,,0,0,0,,Anda sekarang juga seorang kandidat
Dialog: 0,0:28:43.17,0:28:45.67,teks umum,,0,0,0,,Kalian bertiga adalah kandidat
Dialog: 0,0:28:47.34,0:28:50.09,teks umum,,0,0,0,,Jangan lupa berterima kasih kepada Guru Li
Dialog: 0,0:28:50.17,0:28:53.68,teks umum,,0,0,0,,Jika dia tidak menjaminmu, akan ada masalah
Dialog: 0,0:28:53.76,0:28:55.01,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:28:55.10,0:28:58.56,teks umum,,0,0,0,,Kamu sudah menimbulkan keraguan pada orang-orang dengan menunjukkan Tansu,
Dialog: 0,0:28:58.64,0:29:00.81,teks umum,,0,0,0,,milik Nak Su
Dialog: 0,0:29:00.89,0:29:04.15,teks umum,,0,0,0,,Wook bahkan ingin menjadi murid Nak Soo
Dialog: 0,0:29:06.98,0:29:09.19,teks umum,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:29:10.32,0:29:11.15,teks umum,,0,0,0,,Apa?
Dialog: 0,0:29:13.70,0:29:17.49,teks umum,,0,0,0,,Dia kesal karena tidak ada yang bisa membukakan gerbangnya,
Dialog: 0,0:29:18.12,0:29:19.79,teks umum,,0,0,0,,jadi aku bercanda seperti ini
Dialog: 0,0:29:20.58,0:29:22.33,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:29:23.54,0:29:25.21,teks umum,,0,0,0,,bilang begitu?
Dialog: 0,0:29:25.29,0:29:27.34,teks umum,,0,0,0,,Ya, benar
Dialog: 0,0:29:28.46,0:29:30.80,teks umum,,0,0,0,,Yul, beritahu mereka,
Dialog: 0,0:29:30.88,0:29:34.47,teks umum,,0,0,0,,hukuman apa yang diberikan kepada penyihir yang menyukai ilmu hitam
Dialog: 0,0:29:34.55,0:29:36.97,teks umum,,0,0,0,,Kau bisa kehilangan seluruh energimu,
Dialog: 0,0:29:37.05,0:29:38.60,teks umum,,0,0,0,,tidak bisa merapal mantra
Dialog: 0,0:29:38.68,0:29:40.43,teks umum,,0,0,0,,Kemudian mereka akan diusir dari Dekho,
Dialog: 0,0:29:41.56,0:29:43.81,teks umum,,0,0,0,,dan keturunan tidak akan pernah bisa menjadi penyihir
Dialog: 0,0:29:43.89,0:29:45.10,teks umum,,0,0,0,,Ingat ini
Dialog: 0,0:29:48.02,0:29:51.57,teks umum,,0,0,0,,Jangan katakan itu lagi
Dialogue: 0,0:29:52.49,0:29:54.61,teks umum,,0,0,0,,Apa yang buruk tentang ilmu hitam?
Dialog: 0,0:29:55.36,0:29:56.37,teks umum,,0,0,0,,Apa?
Dialog: 0,0:29:56.45,0:29:58.45,teks umum,,0,0,0,,Mantra biasa juga membunuh orang
Dialogue: 0,0:29:58.53,0:30:00.95,teks umum,,0,0,0,,Dan ilmu hitam, terkadang, bisa menyelamatkan nyawa
Dialog: 0,0:30:01.83,0:30:03.83,teks umum,,0,0,0,,Cara memisahkan yang satu dengan yang lain,
Dialog: 0,0:30:03.91,0:30:07.79,teks umum,,0,0,0,,kita perlu memikirkan niat manusia, ini lebih penting
Dialogue: 0,0:30:07.88,0:30:11.17,teks umum,,0,0,0,,Jadi kamu akan menggunakan sihir ini,
Dialog: 0,0:30:12.46,0:30:14.97,teks umum,,0,0,0,,jika ini menyelamatkan nyawa seseorang?
Dialog: 0,0:30:15.05,0:30:17.01,teks umum,,0,0,0,,Jika sihir ini menyelamatkan seseorang,
Dialog: 0,0:30:18.68,0:30:21.22,teks umum,,0,0,0,,Saya tidak melihat ada masalah
Dialog: 0,0:30:27.90,0:30:31.15,teks umum,,0,0,0,,Anak Anjing! Beraninya kamu!
Dialog: 0,0:30:31.23,0:30:32.94,teks umum,,0,0,0,,Kamu adalah penyihir Jeonjingak
Dialog: 0,0:30:33.03,0:30:36.16,teks umum,,0,0,0,,Beraninya kamu mengatakan bahwa kamu akan menggunakan sihir ini?
Dialog: 0,0:30:36.24,0:30:38.49,teks umum,,0,0,0,,Jika kamu akan bersikap seperti ini,
Dialog: 0,0:30:38.57,0:30:41.12,teks umum,,0,0,0,,kembalikan energi yang kuberikan padamu
Dialog: 0,0:30:43.33,0:30:45.41,teks umum,,0,0,0,,- Bab\N- Apa itu?
Dialog: 0,0:30:45.50,0:30:48.54,teks umum,,0,0,0,,Putra Mahkota sedang menuju ke sini untuk menemui Chan Wook
Dialog: 0,0:30:53.96,0:30:55.26,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:30:57.43,0:30:58.51,teks umum,,0,0,0,,Halo
Dialog: 0,0:31:14.15,0:31:17.53,miring,,0,0,0,,Putra Mahkota! Sampaikan salam padanya!
Dialog: 0,0:31:35.34,0:31:37.59,teks umum,,0,0,0,,Saya datang ketika saya mendengar tentang perayaan itu
Dialog: 0,0:31:37.67,0:31:39.47,teks umum,,0,0,0,,Tapi sepertinya aku merusaknya
Dialog: 0,0:31:40.72,0:31:44.10,teks umum,,0,0,0,,Kalau dipikir-pikir, itu semua berkat aku,
Dialog: 0,0:31:45.22,0:31:47.56,teks umum,,0,0,0,,Saya harus menjadi tamu terhormat
Dialogue: 0,0:31:48.19,0:31:49.77,teks umum,,0,0,0,,Kenapa suasananya jadi buruk?
Dialog: 0,0:31:50.65,0:31:52.73,teks umum,,0,0,0,,Saya yakin, jauh di lubuk hati
Dialog: 0,0:31:52.82,0:31:55.61,teks umum,,0,0,0,,kamu berharap ini akan menjadi pemakamanku dan bukan hari libur
Dialog: 0,0:31:55.69,0:31:57.19,teks umum,,0,0,0,,Jadi satu-satunya yang bisa kulakukan adalah,
Dialog: 0,0:31:57.28,0:31:59.45,teks umum,,0,0,0,,dengan tenang menyapamu
Dialog: 0,0:32:05.45,0:32:07.16,teks umum,,0,0,0,,Pemakaman atau hari raya,
Dialog: 0,0:32:07.25,0:32:09.46,teks umum,,0,0,0,,selalu ada minuman di sana
Dialog: 0,0:32:10.25,0:32:13.21,teks umum,,0,0,0,,Jadi aku membawa beberapa
Dialog: 0,0:32:18.55,0:32:20.59,teks umum,,0,0,0,,Apakah akan ada pertarungan lagi?
Dialog: 0,0:32:20.68,0:32:22.22,teks umum,,0,0,0,,Bab, kamu harus turun
Dialog: 0,0:32:22.30,0:32:25.10,teks umum,,0,0,0,,Mari kita tunggu dan lihat
Dialog: 0,0:32:31.10,0:32:33.02,teks umum,,0,0,0,,Untuk mengucapkan selamat kepada Chang Wook atas kemenangannya,
Dialogue: 0,0:32:35.32,0:32:36.86,teks umum,,0,0,0,,Aku akan menuangkan minuman untuknya
Dialog: 0,0:32:39.15,0:32:42.11,teks umum,,0,0,0,,Kamu menguasai Ryusu dan menjadi penyihir Jeonjingak
Dialog: 0,0:32:42.20,0:32:44.37,teks umum,,0,0,0,,dalam waktu kurang dari dua bulan
Dialog: 0,0:32:45.87,0:32:47.16,teks umum,,0,0,0,,Selamat
Dialog: 0,0:32:52.08,0:32:55.17,teks umum,,0,0,0,,Aku kalah dalam pertarungan, tapi...
Dialogue: 0,0:32:55.25,0:32:57.67,teks umum,,0,0,0,,Aku senang menjadi Putra Mahkota
Dialog: 0,0:32:58.84,0:33:01.09,teks umum,,0,0,0,,Deho adalah pesulap yang hebat
Dialog: 0,0:33:01.68,0:33:03.93,miring,,0,0,0,,Ini patut dirayakan
Dialog: 0,0:33:04.51,0:33:05.80,teks umum,,0,0,0,,Minum
Dialog: 0,0:33:06.39,0:33:09.60,teks umum,,0,0,0,,dan jadilah pesulap terbaik di negeri ini
Dialog: 0,0:33:10.18,0:33:12.02,teks umum,,0,0,0,,Semoga Deho bangga padamu,
Dialog: 0,0:33:12.60,0:33:13.44,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:33:25.82,0:33:27.33,teks umum,,0,0,0,,Terima kasih, Yang Mulia
Dialog: 0,0:33:35.58,0:33:36.92,teks umum,,0,0,0,,Aku akan menuangkannya untukmu juga
Dialog: 0,0:33:48.60,0:33:51.68,teks umum,,0,0,0,,Saya harap kamu menjadi raja yang hebat
Dialog: 0,0:34:12.04,0:34:13.66,teks umum,,0,0,0,,Jadilah raja yang hebat, Yang Mulia
Dialog: 0,0:34:31.52,0:34:32.60,teks umum,,0,0,0,,Bagus sekali
Dialog: 0,0:34:32.68,0:34:36.14,teks umum,,0,0,0,,Putra Mahkota tidak menyimpan dendam
Dialog: 0,0:34:39.94,0:34:42.15,teks umum,,0,0,0,,Pangeran, pewaris takhta,
Dialog: 0,0:34:42.23,0:34:45.78,teks umum,,0,0,0,,dan pemuda yang lahir di bawah bintang raja
Dialog: 0,0:34:53.45,0:34:56.08,miring,,0,0,0,,Dua peninggalan Jinyeowon rusak
Dialogue: 0,0:34:56.87,0:34:59.59,teks umum,,0,0,0,,Mereka tak punya energi, tak berguna
Dialog: 0,0:34:59.67,0:35:01.96,teks umum,,0,0,0,,Bakar dan sebarkan abunya ke Danau Gyeongcheongdaeho
Dialog: 0,0:35:02.88,0:35:04.13,teks umum,,0,0,0,,Ya ibu
Dialog: 0,0:35:04.72,0:35:07.30,teks umum,,0,0,0,,Nyonya, pria itu kembali
Dialog: 0,0:35:08.14,0:35:09.22,teks umum,,0,0,0,,Ayah?
Dialog: 0,0:35:10.01,0:35:11.14,teks umum,,0,0,0,,Cho Young
Dialog: 0,0:35:12.18,0:35:13.18,teks umum,,0,0,0,,Istri
Dialog: 0,0:35:13.27,0:35:14.73,teks umum,,0,0,0,,Ayah!
Dialog: 0,0:35:15.23,0:35:16.31,teks umum,,0,0,0,,Ayah!
Dialog: 0,0:35:17.02,0:35:18.73,miring,,0,0,0,,My Cho Young
Dialog: 0,0:35:20.86,0:35:24.07,teks umum,,0,0,0,,Biar saya lihat. Kamu menjadi lebih cantik
Dialog: 0,0:35:33.54,0:35:34.66,teks umum,,0,0,0,,Aku kembali
Dialog: 0,0:35:38.04,0:35:40.00,teks umum,,0,0,0,,Saya menemukannya di Pulau Gunung Berapi di selatan
Dialog: 0,0:35:40.67,0:35:42.42,teks umum,,0,0,0,,Dia kehilangan orang tuanya di masa kanak-kanak,
Dialog: 0,0:35:42.50,0:35:45.67,teks umum,,0,0,0,,jadi tidak ingat apapun tentangnya
Dialog: 0,0:35:45.76,0:35:49.76,teks umum,,0,0,0,,Dia sepertinya seumuran dengan Boo Young
Dialog: 0,0:35:52.14,0:35:54.10,teks umum,,0,0,0,,Masih ada lagi
Dialog: 0,0:35:54.18,0:35:57.73,teks umum,,0,0,0,,sesuatu dari masa kanak-kanak?
Dialog: 0,0:36:01.31,0:36:05.23,teks umum,,0,0,0,,Tidak seperti Boo Young, dia tidak punya energi,
Dialog: 0,0:36:05.32,0:36:08.53,teks umum,,0,0,0,,dan dia tidak bisa merapal mantra
Dialog: 0,0:36:08.61,0:36:12.82,teks umum,,0,0,0,,Dia mungkin kehilangan kekuatannya saat jauh dari Jinyoewon
Dialog: 0,0:36:14.41,0:36:17.20,teks umum,,0,0,0,,Tetapi jika dia benar-benar anggota keluarga Jin,
Dialog: 0,0:36:18.58,0:36:20.67,teks umum,,0,0,0,,kekuatannya akan dengan mudah kembali
Dialog: 0,0:36:28.47,0:36:30.59,teks umum,,0,0,0,,Pintu ini akan menunjukkan kepada kita
Dialog: 0,0:36:31.39,0:36:34.18,teks umum,,0,0,0,,apakah kamu benar-benar anggota keluarga kami
Dialog: 0,0:37:01.75,0:37:05.09,teks umum,,0,0,0,,Aku bukan putri yang sudah lama kamu cari?
Dialog: 0,0:37:07.05,0:37:08.92,teks umum,,0,0,0,,Tidak, rupanya
Dialog: 0,0:37:10.47,0:37:15.26,teks umum,,0,0,0,,Tapi terima kasih sudah sampai sejauh ini. Mereka akan memberi Anda cukup uang untuk mendapatkan Anda kembali.
Dialog: 0,0:37:17.18,0:37:21.73,teks umum,,0,0,0,,Apakah menurutmu ibu akan marah karena kekecewaan lagi?
Dialogue: 0,0:37:22.81,0:37:24.40,teks umum,,0,0,0,,Apa yang harus aku lakukan ayah?
Dialog: 0,0:38:16.91,0:38:18.03,kenangan,,0,0,0,,Ibu
Dialogue: 0,0:38:19.83,0:38:21.70,kenangan,,0,0,0,,Burung dalam sangkar mati
Dialog: 0,0:38:25.54,0:38:28.25,kenangan,,0,0,0,,Kamu benar. Buruk
Dialog: 0,0:38:28.34,0:38:31.63,kenangan,,0,0,0,,Sampai kemarin aku merasakan energi hangat
Dialog: 0,0:38:33.05,0:38:34.63,kenangan,,0,0,0,,Dan sekarang tidak ada apa-apa
Dialog: 0,0:38:36.30,0:38:40.39,kenangan,,0,0,0,,Aku bisa mengerti, tapi kamu tetaplah orang pertama yang menyadarinya
Dialog: 0,0:38:40.47,0:38:43.23,kenangan,,0,0,0,,Semua makhluk hidup mempunyai energi
Dialog: 0,0:38:44.10,0:38:46.35,kenangan,,0,0,0,,Melalui energi ini aku melihat dunia
Dialog: 0,0:38:46.44,0:38:50.98,kenangan,,0,0,0,,Bu Young, semoga kamu tidak melihat apa yang dilihat orang lain
Dialog: 0,0:38:52.19,0:38:56.11,kenangan,,0,0,0,,Kamu spesial dan kamu melihat apa yang orang lain tidak bisa lihat
Dialog: 0,0:39:00.83,0:39:02.99,kenangan,,0,0,0,,Kau membuatkanku penutup mata baru
Dialog: 0,0:39:03.08,0:39:05.04,kenangan,,0,0,0,,Aku ingin mencobanya
Dialog: 0,0:39:25.43,0:39:26.60,teks umum,,0,0,0,,Istri
Dialog: 0,0:39:28.73,0:39:30.90,teks umum,,0,0,0,,Jangan marah
Dialog: 0,0:39:30.98,0:39:33.86,teks umum,,0,0,0,,Aku tidak berharap banyak saat membawanya ke sini
Dialogue: 0,0:39:35.82,0:39:38.03,teks umum,,0,0,0,,Jadi kamu membawa siapa saja?
Dialog: 0,0:39:38.11,0:39:41.24,teks umum,,0,0,0,,Jadi kamu hanya berusaha menyenangkanku
Dialog: 0,0:39:41.91,0:39:43.87,teks umum,,0,0,0,,Itulah sebabnya kami belum dapat menemukannya selama 10 tahun
Dialog: 0,0:39:47.08,0:39:48.29,teks umum,,0,0,0,,Saya...
Dialog: 0,0:39:49.04,0:39:51.96,teks umum,,0,0,0,,Saya akan mulai mencari lagi
Dialog: 0,0:39:53.00,0:39:54.34,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:39:54.42,0:39:57.51,teks umum,,0,0,0,,Jin Mu dari Jeonbugwan akan membantu menemukannya
Dialog: 0,0:39:57.59,0:40:01.64,teks umum,,0,0,0,,Kupikir kamu membenci saudara tirimu
Dialog: 0,0:40:01.72,0:40:05.06,teks umum,,0,0,0,,Aku benci itu. Tapi jika kita berbicara tentang Boo Young,
Dialog: 0,0:40:05.14,0:40:08.89,teks umum,,0,0,0,,Saya siap menggunakan bantuannya
Dialog: 0,0:40:14.82,0:40:15.90,teks umum,,0,0,0,,Keluar
Dialog: 0,0:40:16.44,0:40:19.40,teks umum,,0,0,0,,Saya mencari seseorang di sini
Dialog: 0,0:40:19.49,0:40:20.78,teks umum,,0,0,0,,Moo Dok ada di sini, kan?
Dialog: 0,0:40:20.86,0:40:23.12,teks umum,,0,0,0,,Ada banyak orang di sini sekarang, kembalilah besok
Dialog: 0,0:40:25.24,0:40:26.54,teks umum,,0,0,0,,Mendorongku
Dialog: 0,0:40:28.46,0:40:29.96,teks umum,,0,0,0,,Tahukah kamu siapa saya?
Dialog: 0,0:40:31.00,0:40:32.17,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:40:34.21,0:40:37.17,teks umum,,0,0,0,,Saya seorang penyihir dari salah satu keluarga tertinggi di negeri ini
Dialog: 0,0:40:39.59,0:40:42.34,teks umum,,0,0,0,,Tunjukkan keajaibanku?
Dialog: 0,0:40:48.60,0:40:49.98,teks umum,,0,0,0,,Anggap dirimu beruntung
Dialog: 0,0:40:50.52,0:40:53.15,teks umum,,0,0,0,,Jika aku menaruh energi di tanganku, kamu akan mati
Dialog: 0,0:40:53.86,0:40:56.48,teks umum,,0,0,0,,Maaf. aku minta maaf
Dialog: 0,0:40:57.11,0:41:00.24,teks umum,,0,0,0,,Itu hanya rumah gisaeng. Apakah Anda tidak mengizinkan pengunjung?
Dialog: 0,0:41:00.32,0:41:03.91,teks umum,,0,0,0,,Hari ini adalah festival para penyihir Jeonjingak
Dialog: 0,0:41:04.49,0:41:05.58,teks umum,,0,0,0,,- Sosnovy Bor?\N- Ya
Dialog: 0,0:41:05.66,0:41:08.75,teks umum,,0,0,0,,Bahkan Putra Mahkota ada di sini
Dialog: 0,0:41:09.62,0:41:12.25,teks umum,,0,0,0,,Kudengar dia dijual ke rumah gisaeng terbesar di Daeho
Dialog: 0,0:41:12.92,0:41:14.75,teks umum,,0,0,0,,Ini pasti rumah itu
Dialog: 0,0:41:14.83,0:41:17.92,teks umum,,0,0,0,,Jika kamu memberiku nama, aku akan memperkenalkanmu
Dialog: 0,0:41:19.09,0:41:21.88,teks umum,,0,0,0,,Tidak layak. Saya akan kembali besok
Dialog: 0,0:41:24.39,0:41:25.85,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:41:27.22,0:41:28.39,teks umum,,0,0,0,,Siapa disana?
Dialog: 0,0:41:28.97,0:41:31.35,miring,,0,0,0,,Dia bilang dia dari keluarga bangsawan
Dialog: 0,0:41:31.43,0:41:32.98,teks umum,,0,0,0,,Saya pikir ini Jinyeowon
Dialog: 0,0:41:33.06,0:41:36.40,teks umum,,0,0,0,,Dia mempunyai sesuatu di lehernya dengan lambang Jinyoewon
Dialog: 0,0:41:36.48,0:41:37.69,teks umum,,0,0,0,,Jinyeowon?
Dialog: 0,0:41:38.19,0:41:43.86,teks umum,,0,0,0,,Penyihir mereka selalu kasar dan pilih-pilih
Dialog: 0,0:41:44.70,0:41:46.24,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:41:46.32,0:41:50.12,teks umum,,0,0,0,,Tidak ada salahnya. Dia lemah untuk seorang penyihir
Dialog: 0,0:41:50.20,0:41:53.00,teks umum,,0,0,0,,Bagaimana jika dia berbohong dan lambangnya hanya palsu?
Dialog: 0,0:41:54.00,0:41:57.71,teks umum,,0,0,0,,Jika di Deho kamu berpura-pura menjadi seseorang dari keluarga tertinggi,
Dialog: 0,0:41:57.79,0:41:59.38,teks umum,,0,0,0,,kamu bisa mati
Dialog: 0,0:42:01.01,0:42:02.47,teks umum,,0,0,0,,Gadis aneh
Dialog: 0,0:42:11.35,0:42:15.10,miring,,0,0,0,,Di Benteng Deho, penyihir sebenarnya punya banyak keistimewaan
Dialog: 0,0:42:16.86,0:42:18.52,teks umum,,0,0,0,,Moo Dok pasti ada di suatu tempat
Dialog: 0,0:42:28.58,0:42:30.91,teks umum,,0,0,0,,Kita harus hidup demi uangnya setidaknya sedikit
Dialog: 0,0:42:32.58,0:42:34.54,teks umum,,0,0,0,,Jika kubilang aku datang untuk mengembalikan ini,
Dialog: 0,0:42:35.54,0:42:38.75,teks umum,,0,0,0,,Aku yakin dia akan membiarkanku tinggal, dia baik hati
Dialog: 0,0:42:40.42,0:42:42.38,teks umum,,0,0,0,,- Hei, siapa kamu?\N- Takut
Dialog: 0,0:42:49.60,0:42:50.68,teks umum,,0,0,0,,Tunggu aku di luar
Dialog: 0,0:42:51.26,0:42:52.43,teks umum,,0,0,0,,Ya, Yang Mulia
Dialog: 0,0:42:59.94,0:43:01.61,teks umum,,0,0,0,,Dia harus keluar
Dialog: 0,0:43:02.98,0:43:06.11,teks umum,,0,0,0,,Satu, dua, tiga
Dialog: 0,0:43:08.70,0:43:10.58,teks umum,,0,0,0,,Empat, lima...
Dialog: 0,0:43:11.49,0:43:12.66,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:43:14.45,0:43:15.79,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:43:19.88,0:43:25.17,teks umum,,0,0,0,,Sekali lagi aku tersentuh
Dialog: 0,0:43:25.76,0:43:27.26,teks umum,,0,0,0,,kemurahan hatimu yang tak ada habisnya
Dialog: 0,0:43:29.22,0:43:32.47,teks umum,,0,0,0,,Ya, saya berpura-pura baik dan murah hati
Dialog: 0,0:43:32.56,0:43:34.68,teks umum,,0,0,0,,Bisa saja menjungkirbalikkan tempat ini
Dialog: 0,0:43:34.77,0:43:37.94,teks umum,,0,0,0,,Tapi, seperti yang sudah aku katakan, aku tidak ingin penyihir menjadi musuhku
Dialog: 0,0:43:39.23,0:43:41.61,teks umum,,0,0,0,,Apa? Apakah kamu pikir aku bodoh?
Dialog: 0,0:43:42.52,0:43:45.32,teks umum,,0,0,0,,Kamu bertindak sangat bijak dan cerdik,
Dialog: 0,0:43:45.40,0:43:49.07,teks umum,,0,0,0,,menyembunyikan kepicikan dan emosimu
Dialog: 0,0:43:49.95,0:43:52.74,teks umum,,0,0,0,,Aku memutuskan untuk menunjukkan kepicikan hanya padamu, Won Moo Deok
Dialog: 0,0:43:52.83,0:43:57.16,teks umum,,0,0,0,,Aku bisa membayangkan betapa sulitnya menuangkan minuman untuknya,
Dialog: 0,0:43:57.25,0:43:59.58,teks umum,,0,0,0,,ketika kamu ingin meracuni
Dialog: 0,0:43:59.67,0:44:02.54,teks umum,,0,0,0,,Jadi aku bergegas ke sini secepat mungkin
Dialog: 0,0:44:03.29,0:44:05.51,teks umum,,0,0,0,,Aku benci tuanmu sampai mual
Dialog: 0,0:44:05.59,0:44:06.71,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:44:06.80,0:44:08.63,teks umum,,0,0,0,,Hatiku membara karena kebencian padanya
Dialog: 0,0:44:08.72,0:44:10.47,teks umum,,0,0,0,,Saya tidak ragu
Dialog: 0,0:44:10.55,0:44:12.26,teks umum,,0,0,0,,Dan kamu... kamu mendukungnya...
Dialog: 0,0:44:13.72,0:44:15.39,teks umum,,0,0,0,,Aku juga tidak menyukaimu
Dialog: 0,0:44:21.23,0:44:23.52,teks umum,,0,0,0,,Kemurahan hati saya ditujukan untuk Anda, bukan untuk dia
Dialog: 0,0:44:26.48,0:44:27.99,teks umum,,0,0,0,,Won Moo Deok
Dialog: 0,0:44:28.07,0:44:31.36,teks umum,,0,0,0,,Jika kamu bertengkar atau bertengkar lagi di antara kita,
Dialogue: 0,0:44:32.49,0:44:34.33,teks umum,,0,0,0,,Aku bunuh kamu dulu
Dialog: 0,0:44:39.04,0:44:42.96,teks umum,,0,0,0,,Yang Mulia, jika saya mati oleh pedang Anda,
Dialog: 0,0:44:44.84,0:44:46.63,teks umum,,0,0,0,,Aku tidak akan menyimpan dendam padamu
Dialogue: 0,0:44:47.76,0:44:50.09,teks umum,,0,0,0,,Maukah kamu melayani masternya?
Dialog: 0,0:44:50.18,0:44:51.59,teks umum,,0,0,0,,Sungguh hamba yang setia
Dialog: 0,0:44:51.68,0:44:53.76,teks umum,,0,0,0,,Mungkin kami harus membangun monumen untukmu?
Dialog: 0,0:44:53.85,0:44:57.43,teks umum,,0,0,0,,Saya merasa sangat terhormat menerima pengakuan Anda
Dialog: 0,0:44:57.52,0:44:59.02,teks umum,,0,0,0,,Lupakan. Menghilang
Dialog: 0,0:44:59.10,0:45:01.48,teks umum,,0,0,0,,Sampai aku kehilangan seluruh kemurahan hatiku dan menjadi picik lagi
Dialog: 0,0:45:02.48,0:45:04.69,teks umum,,0,0,0,,- Yang Mulia\N- Apa? Apa lagi?
Dialog: 0,0:45:04.77,0:45:07.11,teks umum,,0,0,0,,Keinginan mati muncul?
Dialogue: 0,0:45:08.19,0:45:11.03,teks umum,,0,0,0,,Bagaimana lukamu? Apakah kamu baik-baik saja?
Dialog: 0,0:45:14.12,0:45:16.74,teks umum,,0,0,0,,Seharusnya ditanyakan lebih awal
Dialog: 0,0:45:16.83,0:45:19.20,teks umum,,0,0,0,,Jangan khawatir. Serangannya tidak kuat
Dialog: 0,0:45:19.29,0:45:21.16,teks umum,,0,0,0,,Ya, dan Ho Yeom telah menyembuhkanku
Dialog: 0,0:45:22.12,0:45:25.79,teks umum,,0,0,0,,Kamu terkejut karena kamu tidak mengharapkan ini dari tuanku
Dialog: 0,0:45:25.88,0:45:29.34,teks umum,,0,0,0,,Tapi kamu, tentu saja, lebih kuat dari dia
Dialog: 0,0:45:29.42,0:45:32.80,teks umum,,0,0,0,,Tentu saja. Siapa yang tahu dia menggunakan Tansu?
Dialog: 0,0:45:32.88,0:45:34.01,teks umum,,0,0,0,,Penipu
Dialog: 0,0:45:34.89,0:45:36.10,kenangan,,0,0,0,,Oh, maksudmu bungkusan itu,
Dialog: 0,0:45:36.89,0:45:40.10,kenangan,,0,0,0,,yang dia gantung di lubang jamban untuk mengusir lalat?
Dialog: 0,0:45:42.89,0:45:45.23,teks umum,,0,0,0,,Di mana sachet yang kuberikan padamu?
Dialog: 0,0:45:45.31,0:45:46.19,teks umum,,0,0,0,,Apa?
Dialog: 0,0:45:47.11,0:45:50.07,teks umum,,0,0,0,,Tiba-tiba kamu menggantungnya di lubang jamban untuk mengusir lalat
Dialog: 0,0:45:53.32,0:45:54.45,teks umum,,0,0,0,,Di Sini
Dialogue: 0,0:45:55.11,0:45:58.53,teks umum,,0,0,0,,Mengapa menggantung harta karun di dekat jamban?
Dialog: 0,0:45:58.62,0:46:01.33,teks umum,,0,0,0,,Tepat. Aku tahu kamu tidak akan melakukannya
Dialog: 0,0:46:02.29,0:46:03.21,teks umum,,0,0,0,,Baiklah, oke
Dialog: 0,0:46:05.92,0:46:07.79,teks umum,,0,0,0,,Semoga perjalananmu menyenangkan, Yang Mulia
Dialog: 0,0:46:20.10,0:46:22.43,miring,,0,0,0,,- Cukup\N- Itu saja
Dialog: 0,0:46:22.52,0:46:24.52,teks umum,,0,0,0,,- Guru\N- Tinggalkan aku sendiri
Dialog: 0,0:46:24.60,0:46:26.65,teks umum,,0,0,0,,Bangun, tuan
Dialog: 0,0:46:28.02,0:46:29.32,teks umum,,0,0,0,,- Hei\N- Lihat itu
Dialogue: 0,0:46:30.36,0:46:32.53,teks umum,,0,0,0,,Dia baru sadar besok pagi
Dialog: 0,0:46:32.61,0:46:34.24,miring,,0,0,0,,Cepat mabuk
Dialog: 0,0:46:34.32,0:46:37.20,teks umum,,0,0,0,,Dia meminum semua yang ditawarkan Putra Mahkota padanya
Dialogue: 0,0:46:37.28,0:46:40.12,teks umum,,0,0,0,,Kita seharusnya membantunya kalau begitu. Anda satu-satunya yang sadar di sini
Dialog: 0,0:46:40.20,0:46:43.00,teks umum,,0,0,0,,Aku sibuk, aku bernyanyi
Dialog: 0,0:46:44.54,0:46:46.08,miring,,0,0,0,,Letakkan tandu
Dialog: 0,0:46:49.29,0:46:52.05,teks umum,,0,0,0,,Hanya mereka yang diizinkan lewat sini yang bisa
Dialog: 0,0:46:52.63,0:46:54.92,teks umum,,0,0,0,,Jika Anda bukan dari Sosnovy Bor, keluarlah
Dialog: 0,0:47:02.52,0:47:03.89,teks umum,,0,0,0,,Kamu juga tidak bisa
Dialog: 0,0:47:05.27,0:47:06.60,teks umum,,0,0,0,,Saya Moo Dok
Dialog: 0,0:47:07.40,0:47:09.36,teks umum,,0,0,0,,Tn. Pembantu Chan
Dialog: 0,0:47:09.44,0:47:10.69,teks umum,,0,0,0,,Kau tahu
Dialog: 0,0:47:12.11,0:47:15.70,teks umum,,0,0,0,,Kamu hanya diperbolehkan masuk karena Chang Wook pernah menjadi tamu di sini sebelumnya
Dialog: 0,0:47:15.78,0:47:16.82,teks umum,,0,0,0,,Tapi sekarang semuanya berbeda
Dialog: 0,0:47:16.90,0:47:19.49,teks umum,,0,0,0,,Dia adalah anggota Sosnovy Bor, dan kamu bukan
Dialog: 0,0:47:20.24,0:47:21.37,teks umum,,0,0,0,,Jadi kamu tidak bisa
Dialog: 0,0:47:21.45,0:47:23.45,teks umum,,0,0,0,,Apa yang akan terjadi pada pemiliknya?
Dialog: 0,0:47:23.54,0:47:26.91,teks umum,,0,0,0,,Dia sangat mabuk. Saya harus menjaganya
Dialogue: 0,0:47:27.00,0:47:30.21,teks umum,,0,0,0,,pelayan Chongjingak akan menjaganya
Dialog: 0,0:47:33.17,0:47:34.38,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:47:35.88,0:47:38.72,teks umum,,0,0,0,,Aku harus dekat dengan pemiliknya
Dialog: 0,0:47:38.80,0:47:40.05,teks umum,,0,0,0,,Biarkan aku masuk
Dialog: 0,0:47:40.14,0:47:42.81,teks umum,,0,0,0,,Biarkan dia masuk
Dialogue: 0,0:47:42.89,0:47:45.48,teks umum,,0,0,0,,Uk akan melakukan sesuatu jika dia tidak ada
Dialog: 0,0:47:45.56,0:47:49.56,teks umum,,0,0,0,,Tidak ada satu pun penyihir Jeongjingak yang memiliki hak istimewa atas pembantunya sendiri
Dialog: 0,0:47:51.11,0:47:54.32,teks umum,,0,0,0,,Chan Wook masuk Sosnovy Bor, jadi dia harus mengikuti aturan kita
Dialog: 0,0:47:55.15,0:47:57.24,teks umum,,0,0,0,,Jadi saya benar-benar tidak bisa masuk?
Dialog: 0,0:47:57.32,0:47:58.78,teks umum,,0,0,0,,Ini aturannya
Dialog: 0,0:47:59.41,0:48:01.62,teks umum,,0,0,0,,Pulanglah sekarang
Dialog: 0,0:48:01.70,0:48:03.58,teks umum,,0,0,0,,Aku akan membawa pulang Uk saat dia bangun
Dialog: 0,0:48:03.66,0:48:05.08,teks umum,,0,0,0,,Chan Wook tidak bisa pergi
Dialog: 0,0:48:05.75,0:48:09.25,teks umum,,0,0,0,,Dia tidak bisa meninggalkan Sosnovy Bor sampai dia menyelesaikan pelatihannya
Dialog: 0,0:48:09.33,0:48:10.83,teks umum,,0,0,0,,Ini juga sebuah aturan
Dialog: 0,0:48:13.29,0:48:15.59,teks umum,,0,0,0,,Tepat. Kami juga tinggal di sini
Dialog: 0,0:48:16.38,0:48:17.34,teks umum,,0,0,0,,Yaitu,
Dialog: 0,0:48:17.42,0:48:20.38,teks umum,,0,0,0,,Saya tidak bisa masuk dan tuan saya tidak bisa keluar?
Dialog: 0,0:48:20.47,0:48:22.35,teks umum,,0,0,0,,Dan kita tidak bisa bersama?
Dialog: 0,0:48:22.43,0:48:25.47,teks umum,,0,0,0,,Setelah aku mengerti, pulanglah bersama mereka
Dialog: 0,0:48:26.93,0:48:28.14,teks umum,,0,0,0,,Tunggu...
Dialog: 0,0:48:44.66,0:48:46.62,teks umum,,0,0,0,,Ini hari pertama Chan Wook di Jeonjingak
Dialogue: 0,0:48:46.70,0:48:49.21,teks umum,,0,0,0,,Apakah kamu ingin dia melanggar peraturan di hari pertamanya?
Dialog: 0,0:48:56.80,0:48:59.76,teks umum,,0,0,0,,Biarkan aku masuk!
Dialog: 0,0:49:02.26,0:49:05.05,miring,,0,0,0,,Jika kamu berdiri di sana, dia tidak akan pergi
Dialog: 0,0:49:05.14,0:49:07.77,miring,,0,0,0,,Jika kepala mengetahuinya, aku akan menghukumnya
Dialog: 0,0:49:07.85,0:49:09.02,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:49:10.31,0:49:14.40,teks umum,,0,0,0,,Moo Dok, pulanglah. Kami akan menemukan jalannya
Dialog: 0,0:49:22.36,0:49:23.70,teks umum,,0,0,0,,Guru!
Dialog: 0,0:49:28.49,0:49:30.29,teks umum,,0,0,0,,Bawa aku bersamamu!
Dialog: 0,0:49:31.58,0:49:32.87,teks umum,,0,0,0,,Guru!
Dialog: 0,0:49:48.31,0:49:50.52,teks umum,,0,0,0,,Kakek, bagaimana kabarmu?
Dialog: 0,0:49:50.60,0:49:51.60,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:49:52.69,0:49:56.23,teks umum,,0,0,0,,Kamu telah tumbuh menjadi gadis cantik
Dialog: 0,0:49:57.27,0:50:00.15,teks umum,,0,0,0,,Tuan Huo, seorang penyihir mabuk telah diantarkan
Dialog: 0,0:50:00.23,0:50:01.61,teks umum,,0,0,0,,karena nafasnya yang berat
Dialog: 0,0:50:01.69,0:50:05.32,teks umum,,0,0,0,,Dia hanya mabuk, jagalah dia sendiri
Dialog: 0,0:50:05.41,0:50:08.87,teks umum,,0,0,0,,Ini Chan Wook. Anda memberinya energi Anda
Dialog: 0,0:50:08.95,0:50:11.58,teks umum,,0,0,0,,Apa? Chan Wook?
Dialog: 0,0:50:11.66,0:50:12.83,teks umum,,0,0,0,,Uk?
Dialog: 0,0:50:35.48,0:50:37.27,di belakang layar,,0,0,0,,Itu pesulapnya
Dialog: 0,0:50:39.98,0:50:42.32,teks umum,,0,0,0,,Yoon Ok, kemarilah
Dialog: 0,0:50:42.40,0:50:43.57,teks umum,,0,0,0,,Oke
Dialog: 0,0:50:48.99,0:50:52.70,teks umum,,0,0,0,,Gerbang energinya tertutup selama bertahun-tahun, dan saya membukakannya untuknya
Dialog: 0,0:50:53.29,0:50:56.04,teks umum,,0,0,0,,Aku bahkan memberinya energiku. Namanya Chan Wook
Dialog: 0,0:50:57.96,0:50:59.04,teks umum,,0,0,0,,Chang Wook?
Dialog: 0,0:50:59.13,0:51:02.67,teks umum,,0,0,0,,Ya. Baru sebulan berlalu dan dia sudah menguasai Ryusu
Dialog: 0,0:51:02.76,0:51:03.92,teks umum,,0,0,0,,Dia jenius
Dialog: 0,0:51:04.42,0:51:05.55,teks umum,,0,0,0,,Selama sebulan?
Dialog: 0,0:51:06.88,0:51:09.47,teks umum,,0,0,0,,Benar-benar jenius
Dialog: 0,0:51:23.23,0:51:25.57,teks umum,,0,0,0,,Yah, aku sangat mabuk
Dialog: 0,0:51:25.65,0:51:28.66,teks umum,,0,0,0,,Aku akan ke kamarku dan tidur
Dialog: 0,0:51:28.74,0:51:30.37,teks umum,,0,0,0,,Jaga dia
Dialog: 0,0:51:30.95,0:51:32.70,teks umum,,0,0,0,,Ayo
Dialog: 0,0:51:32.79,0:51:34.37,teks umum,,0,0,0,,Oke, kakek
Dialog: 0,0:51:50.97,0:51:52.72,teks umum,,0,0,0,,Kita bertemu lagi
Dialog: 0,0:51:54.64,0:51:56.85,teks umum,,0,0,0,,Mr. Chang Wook
Dialog: 0,0:52:13.28,0:52:15.66,teks umum,,0,0,0,,Aku datang sejauh ini bukan untuk menyerah
Dialog: 0,0:52:18.21,0:52:19.96,teks umum,,0,0,0,,Saya akan masuk ke dalam dengan cara apa pun yang diperlukan
Dialog: 0,0:52:36.27,0:52:37.52,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:52:45.40,0:52:46.61,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:52:47.78,0:52:51.82,teks umum,,0,0,0,,Tuanmu sedang sekarat. Kepalaku berputar
Dialog: 0,0:53:32.49,0:53:33.57,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:53:35.74,0:53:37.28,teks umum,,0,0,0,,jika kau tinggalkan aku,
Dialog: 0,0:53:39.45,0:53:41.37,teks umum,,0,0,0,,Aku bersumpah akan membunuhmu
Dialog: 0,0:54:07.86,0:54:09.28,teks umum,,0,0,0,,Mr. Yul?
Dialog: 0,0:54:11.61,0:54:13.65,teks umum,,0,0,0,,Kupikir mungkin kamu masih di sini
Dialogue: 0,0:54:14.74,0:54:15.99,teks umum,,0,0,0,,Dan aku benar
Dialog: 0,0:54:18.12,0:54:19.91,teks umum,,0,0,0,,Aku tidak akan pernah pergi
Dialog: 0,0:54:22.08,0:54:24.62,teks umum,,0,0,0,,Aku harus bersama pemiliknya
Dialog: 0,0:54:27.46,0:54:29.71,teks umum,,0,0,0,,Duduk di sini tidak akan menyelesaikan masalah
Dialog: 0,0:54:29.80,0:54:32.47,teks umum,,0,0,0,,Buat saja Uka melanggar aturan
Dialog: 0,0:54:32.55,0:54:35.09,teks umum,,0,0,0,,Maka semua jerih payahnya akan sia-sia
Dialog: 0,0:54:37.34,0:54:38.64,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:54:39.85,0:54:41.56,teks umum,,0,0,0,,Pulanglah, tunggu disana
Dialog: 0,0:54:42.39,0:54:43.85,teks umum,,0,0,0,,Aku akan menemanimu
Dialog: 0,0:54:54.57,0:54:56.57,teks umum,,0,0,0,,Beri tahu tuanku,
Dialog: 0,0:54:57.95,0:54:59.66,teks umum,,0,0,0,,bahwa aku akan menemukan jalan
Dialog: 0,0:55:00.45,0:55:02.95,teks umum,,0,0,0,,sampai ke Sosnovy Bor ke pemiliknya
Dialog: 0,0:55:05.33,0:55:07.37,teks umum,,0,0,0,,Suruh dia bertahan sampai saat itu
Dialog: 0,0:55:09.79,0:55:12.55,teks umum,,0,0,0,,Oke. aku akan memberitahumu
Dialogue: 0,0:56:07.69,0:56:09.81,teks umum,,0,0,0,,Kepalaku sakit sekali
Dialog: 0,0:56:12.65,0:56:14.40,teks umum,,0,0,0,,Itu semua pangeran
Dialog: 0,0:56:16.36,0:56:17.65,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:56:18.49,0:56:21.37,teks umum,,0,0,0,,- Bawakan air\N{\i1}- Siapakah Moo Deok?
Dialog: 0,0:56:24.29,0:56:25.37,teks umum,,0,0,0,,Siapa kamu?
Dialog: 0,0:56:25.45,0:56:28.33,teks umum,,0,0,0,,Tidak ingat? Kami bertemu di penginapan
Dialogue: 0,0:56:30.62,0:56:31.88,kenangan miring,,0,0,0,,Jangan berbohong
Dialog: 0,0:56:31.96,0:56:34.92,kenangan,,0,0,0,,Kamu menatapnya sepanjang waktu!
Dialog: 0,0:56:35.92,0:56:38.38,teks umum,,0,0,0,,Ah, Ta Sun ada sesuatu disana
Dialog: 0,0:56:39.13,0:56:40.59,teks umum,,0,0,0,,Tepat sekali, Song Yi
Dialog: 0,0:56:41.68,0:56:42.80,teks umum,,0,0,0,,Mengapa kamu ada di sini?
Dialog: 0,0:56:42.89,0:56:47.31,teks umum,,0,0,0,,Nyonya Ho adalah cucu dari Tuan Ho Yeom
Dialog: 0,0:56:47.39,0:56:48.56,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:56:50.02,0:56:51.44,teks umum,,0,0,0,,Hanya itu saja?
Dialog: 0,0:56:51.52,0:56:52.81,teks umum,,0,0,0,,Jika dia memberitahu Guru Huo,
Dialog: 0,0:56:52.90,0:56:55.73, teks umum,,0,0,0,, betapa kasarnya kamu padanya, tuan akan marah padamu
Dialog: 0,0:56:56.48,0:56:58.65,teks umum,,0,0,0,,Lagipula dia tidak pernah menyukaiku
Dialog: 0,0:56:58.74,0:56:59.86,teks umum,,0,0,0,,Biarkan dia berkata
Dialog: 0,0:57:03.32,0:57:04.74,teks umum,,0,0,0,,Yah, setidaknya berterima kasih padanya
Dialog: 0,0:57:04.83,0:57:06.54,teks umum,,0,0,0,,Nyonya menjagamu sepanjang malam
Dialog: 0,0:57:06.62,0:57:07.91,teks umum,,0,0,0,,Nona?
Dialog: 0,0:57:16.71,0:57:18.21,teks umum,,0,0,0,,Lebih baik jangan katakan ini padanya
Dialog: 0,0:57:20.13,0:57:23.26,teks umum,,0,0,0,,Apakah kamu sudah bertemu Inggris belum?
Dialog: 0,0:57:24.01,0:57:24.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:57:25.01,0:57:29.98,teks umum,,0,0,0,,Chan Wook membantu Yoon Ok ketika dia dalam kesulitan
Dialog: 0,0:57:30.06,0:57:31.39,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:57:31.48,0:57:34.69,teks umum,,0,0,0,,Inggris bukan orang yang hanya membantu orang
Dialog: 0,0:57:35.94,0:57:37.86,teks umum,,0,0,0,,Apa yang kamu bicarakan tentang dia?
Dialog: 0,0:57:40.15,0:57:41.78,teks umum,,0,0,0,,Kudengar kamu tiba dari benteng Vol
Dialogue: 0,0:57:42.61,0:57:46.33,teks umum,,0,0,0,,Saya dan ibu pria tersebut berasal dari sana
Dialog: 0,0:57:47.33,0:57:50.66,teks umum,,0,0,0,,- Begitu\N - Mungkin itu sebabnya
Dialog: 0,0:57:50.75,0:57:52.92,teks umum,,0,0,0,,kamu mengingatkanku pada Ny. Do Hwa
Dialog: 0,0:57:54.46,0:57:57.42,teks umum,,0,0,0,,Menurutku kau dan tuanku ditakdirkan untuk bersama
Dialog: 0,0:57:59.71,0:58:02.09,teks umum,,0,0,0,,Jika orang dari kota yang sama harus serupa,
Dialog: 0,0:58:02.68,0:58:04.93,teks umum,,0,0,0,,maka kalian juga pasti mirip satu sama lain
Dialog: 0,0:58:06.93,0:58:08.89,teks umum,,0,0,0,,Tapi kalian tidak punya kesamaan
Dialog: 0,0:58:11.02,0:58:12.48,teks umum,,0,0,0,,Saya tidak mengerti maksud Anda
Dialogue: 0,0:58:13.73,0:58:15.31,italic,,0,0,0,,Maiden Kim, kamu hebat,
Dialog: 0,0:58:15.40,0:58:19.69,teks umum,,0,0,0,,tapi terkadang kamu melebih-lebihkan dan mengambil kesimpulan terburu-buru
Dialogue: 0,0:58:20.57,0:58:23.07,teks umum,,0,0,0,,Apa maksudmu aku berbohong?
Dialog: 0,0:58:24.20,0:58:25.53,teks umum,,0,0,0,,Saya tidak mengatakan itu
Dialog: 0,0:58:26.12,0:58:27.66,miring,,0,0,0,,Di sini dan saat ini
Dialog: 0,0:58:27.74,0:58:31.12,teks umum,,0,0,0,,Mereka kesal dan bahkan menyebut diri mereka pembohong
Dialog: 0,0:58:31.20,0:58:32.29,teks umum,,0,0,0,,Ya, ya, tentu saja
Dialogue: 0,0:58:32.37,0:58:35.71,teks umum,,0,0,0,,Aku pembohong yang mudah marah
Dialog: 0,0:58:35.79,0:58:37.88,teks umum,,0,0,0,,Kapan aku menyebutmu pembohong?
Dialog: 0,0:58:37.96,0:58:40.21,teks umum,,0,0,0,,Itulah yang kamu katakan
Dialogue: 0,0:58:40.30,0:58:41.55,teks umum,,0,0,0,,Ini kata-katamu
Dialogue: 0,0:58:41.63,0:58:42.92,italic,,0,0,0,,- Ada apa denganmu?\N- Ini salahmu...
Dialog: 0,0:58:43.01,0:58:45.84,teks umum,,0,0,0,,Hubungan seperti apa yang mereka miliki?
Dialog: 0,0:58:48.89,0:58:51.52,teks umum,,0,0,0,,Mereka mempunyai hubungan yang aneh dan ganjil,
Dialog: 0,0:58:51.60,0:58:53.77,teks umum,,0,0,0,,terlampir
Dialog: 0,0:58:53.85,0:58:56.23,miring,,0,0,0,,- Kamu yang pertama kesal\N- Kamu bilang aku berbohong
Dialog: 0,0:58:56.31,0:58:58.27,teks umum,,0,0,0,,Sepertinya dekat, tapi tidak ada yang istimewa di sana
Dialog: 0,0:58:58.36,0:59:00.52,teks umum,,0,0,0,,- Anda sendiri duduk di sini, mengulangi...\N-{\i1} Tapi Anda tahu,
Dialog: 0,0:59:00.61,0:59:03.82,teks umum,,0,0,0,,- dia terlalu bodoh\N- {\i1}Terus panggil aku pembohong
Dialog: 0,0:59:03.90,0:59:05.32,teks umum,,0,0,0,,Dan itu menjengkelkan
Dialog: 0,0:59:05.40,0:59:06.41,teks umum,,0,0,0,,Tanpa kata
Dialog: 0,0:59:06.49,0:59:08.66,teks umum,,0,0,0,,Kami punya bukti dan saksi
Dialog: 0,0:59:08.74,0:59:10.70,teks umum,,0,0,0,,Saksi? Betapa menyebalkannya kamu!
Dialog: 0,0:59:12.75,0:59:15.75,teks umum,,0,0,0,,Bagaimana kamu dan Inggris bertemu?
Dialog: 0,0:59:18.04,0:59:19.59,teks umum,,0,0,0,,- Baiklah...\N{\i1}- Nyonya
Dialog: 0,0:59:22.76,0:59:24.17,teks umum,,0,0,0,,Maaf mengganggu
Dialog: 0,0:59:25.30,0:59:26.59,teks umum,,0,0,0,,Bisakah kita bicara?
Dialog: 0,0:59:27.84,0:59:29.39,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:59:30.51,0:59:31.97,teks umum,,0,0,0,,Anda dapat berbicara di sini
Dialog: 0,0:59:32.89,0:59:34.93,teks umum,,0,0,0,,Ini masalah pribadi!
Dialog: 0,0:59:35.64,0:59:36.64,teks umum,,0,0,0,,Ayo pergi
Dialog: 0,0:59:38.23,0:59:40.44,teks umum,,0,0,0,,Apa yang terjadi dengan mereka?
Dialog: 0,0:59:42.65,0:59:45.82,teks umum,,0,0,0,,Pria itu nampaknya sangat serius
Dialog: 0,0:59:45.90,0:59:47.45,teks umum,,0,0,0,,Itu saja
Dialog: 0,0:59:47.53,0:59:50.62,teks umum,,0,0,0,,Dilihat dari cara Yoon Ok mengikuti,
Dialog: 0,0:59:50.70,0:59:52.24,teks umum,,0,0,0,,ada sesuatu di antara keduanya
Dialog: 0,0:59:52.95,0:59:54.79,teks umum,,0,0,0,,- Apa ini?\N- Siapa yang tahu?
Dialog: 0,1:00:01.29,1:00:03.17,teks umum,,0,0,0,,Saya akan mengikuti mereka dan mencari tahu
Dialog: 0,1:00:03.25,1:00:04.38,teks umum,,0,0,0,,Segera duduk!
Dialog: 0,1:00:05.13,1:00:06.47,teks umum,,0,0,0,,Duduk sekarang!
Dialog: 0,1:00:07.17,1:00:10.47,teks umum,,0,0,0,,Tapi ini menarik bagi Anda
Dialog: 0,1:00:10.55,1:00:12.30,teks umum,,0,0,0,,Bagaimana kamu bisa menjadi orang yang lamban?
Dialog: 0,1:00:12.97,1:00:14.22,teks umum,,0,0,0,,Dia putus asa
Dialog: 0,1:00:14.81,1:00:16.39,miring,,0,0,0,,Ini seperti penyakit yang tidak dapat disembuhkan
Dialog: 0,1:00:16.48,1:00:17.39,teks umum,,0,0,0,,Duduk
Dialogue: 0,1:00:21.27,1:00:24.53,teks umum,,0,0,0,,Kenapa mereka selalu memarahiku?
Dialog: 0,1:00:30.57,1:00:32.12,teks umum,,0,0,0,,Apa itu?
Dialog: 0,1:00:33.12,1:00:36.20,teks umum,,0,0,0,,Apakah kamu sudah memberi tahu semua orang tentang apa yang terjadi hari itu?
Dialog: 0,1:00:38.75,1:00:40.75,kenangan,,0,0,0,,Aku merasa tidak nyaman jika kamu mengikutiku,
Dialog: 0,1:00:40.83,1:00:42.42,kenangan,,0,0,0,,dan itu juga tidak sopan di pihakmu
Dialog: 0,1:00:42.50,1:00:43.88,kenangan,,0,0,0,,Kecantikan tidak mengesankan
Dialog: 0,1:00:44.67,1:00:46.88,kenangan,,0,0,0,,Dan aku tidak mengikutimu
Dialog: 0,1:00:48.34,1:00:49.55,teks umum,,0,0,0,,Tidak
Dialog: 0,1:00:50.26,1:00:52.85,teks umum,,0,0,0,,Saya tidak akan menyebutkan sesuatu yang begitu memalukan
Dialog: 0,1:00:53.55,1:00:55.14,teks umum,,0,0,0,,Menurutmu aku tidak manis
Dialog: 0,1:00:55.22,1:00:58.56,teks umum,,0,0,0,,Kecantikanku tidak membuatmu terkesan dan kamu tidak mengikutiku
Dialog: 0,1:00:59.14,1:01:00.89,teks umum,,0,0,0,,Aku malu memikirkannya
Dialog: 0,1:01:00.98,1:01:02.44,teks umum,,0,0,0,,Jadi aku akan diam
Dialog: 0,1:01:02.52,1:01:03.36,teks umum,,0,0,0,,Saya punya
Dialog: 0,1:01:04.11,1:01:06.69,teks umum,,0,0,0,,akal sehat
Dialog: 0,1:01:07.32,1:01:09.70,teks umum,,0,0,0,,Tidak, bukan itu yang saya bicarakan
Dialog: 0,1:01:10.36,1:01:11.28,teks umum,,0,0,0,,Saya berbicara tentang penelan jiwa
Dialog: 0,1:01:11.36,1:01:14.12,teks umum,,0,0,0,,Penelan jiwa yang mencoba membunuhmu
Dialog: 0,1:01:14.70,1:01:17.79,teks umum,,0,0,0,,Jadi itu benar-benar penelan jiwa?
Dialog: 0,1:01:17.87,1:01:20.37,teks umum,,0,0,0,,Ya. Tapi Anda tidak bisa membicarakannya
Dialog: 0,1:01:20.46,1:01:23.83,teks umum,,0,0,0,,Tolong aku. Rahasiakan itu
Dialog: 0,1:01:25.42,1:01:29.17,teks umum,,0,0,0,,Kamu menyelamatkan hidupku, aku akan memenuhi permintaanmu
Dialog: 0,1:01:30.01,1:01:31.09,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:01:31.18,1:01:34.26,teks umum,,0,0,0,,Karena kita berbagi satu rahasia, setidaknya kita harus memperkenalkan diri
Dialog: 0,1:01:34.97,1:01:36.56,teks umum,,0,0,0,,Saya Ho Yoon Ok
Dialog: 0,1:01:37.18,1:01:38.35,teks umum,,0,0,0,,Saya Chang Wook
Dialog: 0,1:01:38.93,1:01:40.85,teks umum,,0,0,0,,Saya tahu. Saya sudah banyak mendengar
Dialog: 0,1:01:40.93,1:01:42.73,teks umum,,0,0,0,,Aku juga. Orang tua ini...
Dialog: 0,1:01:42.81,1:01:44.10,teks umum,,0,0,0,,Itu...
Dialog: 0,1:01:44.19,1:01:47.32,teks umum,,0,0,0,,Tuan Ho selalu membual tentang cucunya
Dialog: 0,1:01:47.40,1:01:50.24,teks umum,,0,0,0,,Apakah kakek memberitahumu sesuatu tentang aku?
Dialog: 0,1:01:52.40,1:01:54.03,teks umum,,0,0,0,,Kamu akan malu
Dialog: 0,1:01:54.62,1:01:55.78,teks umum,,0,0,0,,Sungguh...
Dialog: 0,1:01:56.78,1:01:59.75,teks umum,,0,0,0,,dia berjalan dan mengulangi cucunya itu
Dialog: 0,1:01:59.83,1:02:02.08,teks umum,,0,0,0,,"cantik, seperti peri cantik." Tidak, kan?
Dialog: 0,1:02:02.66,1:02:06.04,teks umum,,0,0,0,,Ya, dia memberi tahu semua orang bahwa kamu terpesona dengan kecantikanmu
Dialog: 0,1:02:06.79,1:02:07.92,teks umum,,0,0,0,,Sayangnya bukan saya
Dialogue: 0,1:02:12.47,1:02:13.97,teks umum,,0,0,0,,Canggung banget
Dialog: 0,1:02:14.68,1:02:16.22,teks umum,,0,0,0,,Saya tidak percaya...
Dialog: 0,1:02:16.30,1:02:17.14,teks umum,,0,0,0,,Orang tua ini...
Dialog: 0,1:02:17.22,1:02:20.72,teks umum,,0,0,0,,Artinya, Guru Huo menunjukkan kasih sayang seperti itu
Dialog: 0,1:02:20.81,1:02:22.81,teks umum,,0,0,0,,Dia membicarakan ibuku dengan cara yang sama
Dialog: 0,1:02:23.69,1:02:26.36,teks umum,,0,0,0,,Aku diberitahu kalau aku mirip ibumu
Dialog: 0,1:02:27.44,1:02:31.19,teks umum,,0,0,0,,Menurutku beginilah rupa peri bagi kakek
Dialog: 0,1:02:37.41,1:02:38.58,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:39.87,1:02:41.45,teks umum,,0,0,0,,Tidak mirip?
Dialog: 0,1:02:44.25,1:02:45.50,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,1:02:47.92,1:02:49.42,teks umum,,0,0,0,,Aku belum pernah melihatnya
Dialogue: 0,1:02:58.43,1:03:00.18,teks umum,,0,0,0,,Dan bagaimana caranya aku bertemu peri?
Dialog: 0,1:03:00.26,1:03:01.64,teks umum,,0,0,0,,Sulit diucapkan
Dialog: 0,1:03:03.93,1:03:05.85,teks umum,,0,0,0,,Apakah kamu sadar?
Dialog: 0,1:03:05.94,1:03:09.73,teks umum,,0,0,0,,Ya. Kudengar kau ada di sana sepanjang malam
Dialog: 0,1:03:11.11,1:03:12.40,teks umum,,0,0,0,,Ya
Dialog: 0,1:03:12.48,1:03:15.82,teks umum,,0,0,0,,Saya pikir itu Moo Deok. Maaf
Dialog: 0,1:03:19.28,1:03:22.33,teks umum,,0,0,0,,Saya membuat teh dengan herbal
Dialog: 0,1:03:34.01,1:03:35.72,teks umum,,0,0,0,,Saya berharap dia akan minum
Dialog: 0,1:03:37.76,1:03:39.34,prasasti,,0,0,0,,Saejukwon
Dialog: 0,1:03:39.43,1:03:41.56,teks umum,,0,0,0,,Tunggu
Dialog: 0,1:03:43.22,1:03:44.68,teks umum,,0,0,0,,Apakah kamu melihat Moo Dok?
Dialog: 0,1:03:44.77,1:03:47.14,teks umum,,0,0,0,,Dia ikut denganku kemarin, tapi dia tak bisa ditemukan
Dialog: 0,1:03:47.73,1:03:48.73,teks umum,,0,0,0,,Dia pulang
Dialogue: 0,1:03:50.90,1:03:53.57,teks umum,,0,0,0,,Kenapa dia pergi tanpa aku?
Dialog: 0,1:03:54.53,1:03:57.07,teks umum,,0,0,0,,Meninggalkan pemilikmu yang mabuk dan pulang?
Dialog: 0,1:03:57.15,1:04:00.07,teks umum,,0,0,0,,Sekarang para pelayan Sosnovy Bor akan menjagamu
Dialog: 0,1:04:00.16,1:04:03.24,teks umum,,0,0,0,,Moo Dok bukan milik kita, dia tidak bisa datang ke sini
Dialog: 0,1:04:05.75,1:04:06.96,teks umum,,0,0,0,,Tunggu...
Dialog: 0,1:04:10.63,1:04:12.09,miring,,0,0,0,,pikir Moo Dok,
Dialog: 0,1:04:12.17,1:04:15.71,teks umum,,0,0,0,,dia bisa mengikuti Inggris ke Sosnovy Bor
Dialog: 0,1:04:16.92,1:04:19.89,teks umum,,0,0,0,,Aku yakin dia membayangkan bagaimana dia akan melihatmu setiap hari
Dialog: 0,1:04:19.97,1:04:21.47,teks umum,,0,0,0,,Mungkin kesal
Dialog: 0,1:04:34.40,1:04:37.61,teks umum,,0,0,0,,Ya. Semoga dia baik-baik saja
Dialog: 0,1:04:41.07,1:04:42.49,teks umum,,0,0,0,,Rupanya, Inggris ketahuan
Dialog: 0,1:04:43.33,1:04:44.74,miring,,0,0,0,,Pasti dia pergi ke pamannya
Dialog: 0,1:04:44.83,1:04:46.87,teks umum,,0,0,0,,Paman tidak mengizinkan ini
Dialog: 0,1:04:50.75,1:04:54.67,teks umum,,0,0,0,,Tidak ada satu pun penyihir yang memiliki pelayan pribadi
Dialog: 0,1:04:55.55,1:04:58.01,teks umum,,0,0,0,,Dan Anda tidak terkecuali
Dialog: 0,1:04:58.09,1:04:59.13,teks umum,,0,0,0,,Mengapa?
Dialogue: 0,1:04:59.72,1:05:02.43,teks umum,,0,0,0,,Sebagai pengecualian, kamu mengusirku dari sini 20 tahun yang lalu
Dialog: 0,1:05:04.26,1:05:05.97,teks umum,,0,0,0,,Mengapa tidak membuat pengecualian lain?
Dialog: 0,1:05:07.35,1:05:10.52,teks umum,,0,0,0,,Semua karena Tansu mengajarimu
Dialog: 0,1:05:12.69,1:05:14.11,teks umum,,0,0,0,,di luar tembok ini?
Dialog: 0,1:05:17.07,1:05:18.74,teks umum,,0,0,0,,Anda memerlukan Moo Dok,
Dialog: 0,1:05:19.40,1:05:22.28,teks umum,,0,0,0,,untuk tetap berhubungan dengan guru?
Dialog: 0,1:05:23.57,1:05:26.37,teks umum,,0,0,0,,Guru Li telah memastikan bahwa saya melatih diri saya sendiri
Dialog: 0,1:05:27.58,1:05:30.21,teks umum,,0,0,0,,Dia menyelamatkanmu, tapi orang-orang masih bergosip
Dialog: 0,1:05:30.71,1:05:32.12,teks umum,,0,0,0,,Bahkan ada yang berpikir,
Dialog: 0,1:05:32.96,1:05:35.71,teks umum,,0,0,0,,apa yang ayahmu, Chang Gan, ajarkan padamu
Dialog: 0,1:05:38.05,1:05:40.51,teks umum,,0,0,0,,Awalnya orang bilang aku bukan anaknya
Dialog: 0,1:05:41.88,1:05:43.89,teks umum,,0,0,0,,Sekarang mereka berceloteh bahwa ayahku mengajariku?
Dialog: 0,1:05:45.76,1:05:49.52,teks umum,,0,0,0,,Saat pengecualian terjadi, orang-orang mulai mengobrol
Dialog: 0,1:05:50.43,1:05:53.52,teks umum,,0,0,0,,Kamu dengan cepat menguasai Ryusu dan menggunakan Tansu
Dialog: 0,1:05:54.48,1:05:56.52,teks umum,,0,0,0,,Ini terlalu tidak biasa
Dialog: 0,1:05:59.48,1:06:00.69,teks umum,,0,0,0,,Kamu...
Dialog: 0,1:06:01.65,1:06:03.86,teks umum,,0,0,0,,berusaha menarik perhatian,
Dialog: 0,1:06:05.32,1:06:07.12,teks umum,,0,0,0,,memaksa orang membicarakan diri mereka sendiri?
Dialog: 0,1:06:09.91,1:06:13.00,di luar layar,,0,0,0,,Jangan biarkan kepala mencurigai Moo Deok
Dialog: 0,1:06:13.08,1:06:14.92,di luar layar,,0,0,0,,Jika tidak, dia akan mengetahui bahwa dia adalah seorang pengembara
Dialog: 0,1:06:16.46,1:06:19.30,teks umum,,0,0,0,,Oke, saya mengerti Anda menentang
Dialog: 0,1:06:21.30,1:06:24.72,teks umum,,0,0,0,,Jadi, maukah kamu mengikuti aturannya saja?
Dialog: 0,1:06:24.80,1:06:25.80,teks umum,,0,0,0,,Ya
Dialog: 0,1:06:26.47,1:06:28.26,teks umum,,0,0,0,,Saya sampai di sini dengan susah payah
Dialogue: 0,1:06:28.35,1:06:32.39,teks umum,,0,0,0,,Aku tidak bisa mengambil risiko demi pembantu
Dialog: 0,1:06:46.82,1:06:49.87,teks umum,,0,0,0,,Saya ingin membeli jimat roh di pasar gelap
Dialog: 0,1:06:50.99,1:06:52.25,teks umum,,0,0,0,,Cari aku satu
Dialog: 0,1:06:52.33,1:06:55.42,teks umum,,0,0,0,,Bagaimana kamu bisa meminta ini ketika seseorang terbunuh karena jimat?
Dialog: 0,1:06:55.50,1:06:59.59,teks umum,,0,0,0,,Jika kamu tertangkap, mereka akan membunuhmu juga
Dialog: 0,1:06:59.67,1:07:03.84,teks umum,,0,0,0,,Saya harus berada di sampingnya. Pemiliknya membutuhkan saya
Dialog: 0,1:07:03.92,1:07:06.80,teks umum,,0,0,0,,Tidak sama sekali. Dia tidak membutuhkanmu lagi
Dialog: 0,1:07:07.55,1:07:10.72,teks umum,,0,0,0,,Kamu dibutuhkan saat dia kabur sendirian dan berlatih
Dialog: 0,1:07:10.81,1:07:13.39,teks umum,,0,0,0,,Dan sekarang dia ada di Jeonjingak
Dialog: 0,1:07:13.48,1:07:15.56,teks umum,,0,0,0,,Ada banyak pelayan lain di sana
Dialog: 0,1:07:16.14,1:07:17.85,teks umum,,0,0,0,,Para penyihir Sosnovy Bor juga akan membantunya
Dialog: 0,1:07:17.94,1:07:20.36,teks umum,,0,0,0,,Kamu tidak bisa berbuat apa-apa lagi untuknya
Dialog: 0,1:07:20.44,1:07:22.11,teks umum,,0,0,0,,Mengapa dia membutuhkanmu?
Dialog: 0,1:07:28.87,1:07:31.99,teks umum,,0,0,0,,Kepala mempercayakanku untuk mengajarimu dasar-dasarnya
Dialog: 0,1:07:32.08,1:07:35.37,teks umum,,0,0,0,,Saya merasa terhormat menjadi gurumu
Dialog: 0,1:07:36.54,1:07:39.00,teks umum,,0,0,0,,Andalkan kamu
Dialog: 0,1:07:42.13,1:07:44.13,teks umum,,0,0,0,,Ini adalah seperangkat aturan untuk Jeongjingak
Dialog: 0,1:07:44.21,1:07:48.18,teks umum,,0,0,0,,Dari buku-buku ini Anda akan belajar tentang keutamaan penyihir, serta segala larangannya
Dialog: 0,1:07:48.80,1:07:50.01,teks umum,,0,0,0,,Kamu tidak bisa
Dialog: 0,1:07:50.10,1:07:52.89,teks umum,,0,0,0,,tinggalkan tempat ini sampai kamu mempelajari semuanya
Dialog: 0,1:07:54.98,1:07:57.14,teks umum,,0,0,0,,Ya. Saya akan mengikuti aturannya
Dialog: 0,1:07:57.77,1:07:59.02,teks umum,,0,0,0,,Anda dapat memulai
Dialog: 0,1:08:00.06,1:08:01.23,teks umum,,0,0,0,,baca
Dialog: 0,1:08:08.61,1:08:09.66,teks umum,,0,0,0,,Mr.
Dialog: 0,1:08:11.95,1:08:13.03,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:08:13.66,1:08:15.20,teks umum,,0,0,0,,Bagaimana kamu bisa masuk?
Dialog: 0,1:08:18.16,1:08:19.75,teks umum,,0,0,0,,Saya kira kamu sudah tutup lagi
Dialog: 0,1:08:19.83,1:08:22.34,teks umum,,0,0,0,,di ruang rahasia ketidaktaatan pada kepala
Dialog: 0,1:08:23.21,1:08:25.42,teks umum,,0,0,0,,Tapi di sini Anda berada di ruang pelatihan
Dialog: 0,1:08:26.46,1:08:28.43,teks umum,,0,0,0,,aku bangga padamu
Dialog: 0,1:08:28.51,1:08:31.47,teks umum,,0,0,0,,Hamba Kim, kamu boleh bangga pada dirimu sendiri
Dialog: 0,1:08:32.22,1:08:33.72,teks umum,,0,0,0,,Kamu membesarkan pria ini dengan baik
Dialog: 0,1:08:36.60,1:08:39.89,teks umum,,0,0,0,,Perlu dicatat bahwa tabelnya rendah
Dialog: 0,1:08:42.86,1:08:44.52,teks umum,,0,0,0,,Dan kursinya tidak nyaman
Dialog: 0,1:08:45.23,1:08:47.03,teks umum,,0,0,0,,Saya di atas yang lain
Dialog: 0,1:08:47.11,1:08:48.82,teks umum,,0,0,0,,dan saya merasa tidak nyaman
Dialog: 0,1:08:48.90,1:08:52.12,teks umum,,0,0,0,,Tapi tidak ada yang bisa dilakukan, ini aturannya
Dialog: 0,1:08:55.12,1:08:59.75,teks umum,,0,0,0,,Apa hubunganmu dengan Nyonya Ho?
Dialog: 0,1:08:59.83,1:09:01.71,teks umum,,0,0,0,,Apa yang kamu bicarakan dengannya?
Dialog: 0,1:09:01.79,1:09:04.29,teks umum,,0,0,0,,Tidak ada yang istimewa
Dialog: 0,1:09:07.13,1:09:10.51,teks umum,,0,0,0,,Saya perlu membaca semua buku ini. Ini waktunya untukmu, pembantu Kim
Dialog: 0,1:09:10.59,1:09:13.85,teks umum,,0,0,0,,Apakah kamu memerlukan tinta sebelum kelas?
Dialog: 0,1:09:14.43,1:09:17.72,teks umum,,0,0,0,,Tidak, aku harus melakukan semuanya sendiri
Dialog: 0,1:09:17.81,1:09:19.02,teks umum,,0,0,0,,Ini aturannya
Dialog: 0,1:09:19.10,1:09:20.77,teks umum,,0,0,0,,Aturan. Saya mengerti
Dialog: 0,1:09:21.73,1:09:22.94,teks umum,,0,0,0,,Oke
Dialog: 0,1:09:24.06,1:09:27.19,teks umum,,0,0,0,,Aku pergi. Sampai jumpa lagi
Dialog: 0,1:09:28.11,1:09:29.28,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,1:09:31.11,1:09:34.70,teks umum,,0,0,0,,jaga Moo Deok. Dia mungkin khawatir
Dialog: 0,1:09:34.78,1:09:37.29,teks umum,,0,0,0,,Mengapa dia harus khawatir jika kamu baik-baik saja?
Dialog: 0,1:09:37.37,1:09:38.37,teks umum,,0,0,0,,Menurutku dia bahagia
Dialog: 0,1:09:40.00,1:09:42.67,teks umum,,0,0,0,,Dia sangat menderita karenamu
Dialog: 0,1:09:42.75,1:09:46.21,teks umum,,0,0,0,,Kamu pilih-pilih makanan, dia harus memasak tiga kali,
Dialog: 0,1:09:46.29,1:09:49.17,teks umum,,0,0,0,,saat dia bersamamu di pegunungan. Membawa air untuk mandi
Dialog: 0,1:09:49.26,1:09:52.43,teks umum,,0,0,0,,Cuci pakaianmu. Tahukah Anda berapa banyak pekerjaan ini?
Dialog: 0,1:09:55.14,1:09:57.10,teks umum,,0,0,0,,Moo Dok benar-benar menderita
Dialog: 0,1:09:57.18,1:10:01.39,teks umum,,0,0,0,,Aku akan mengajaknya melihat bunga dan membeli sesuatu yang enak
Dialog: 0,1:10:01.98,1:10:03.69,teks umum,,0,0,0,,Aku akan menjaganya
Dialog: 0,1:10:03.77,1:10:06.31,teks umum,,0,0,0,,Dia akan tenang jika kamu tidak ada
Dialog: 0,1:10:09.98,1:10:11.19,teks umum,,0,0,0,,Menurutmu?
Dialog: 0,1:10:19.62,1:10:21.87,di belakang layar,,0,0,0,,Chan Wook telah mencapai tujuannya
Dialog: 0,1:10:22.37,1:10:24.87,sulih suara,,0,0,0,,Mungkin dia benar-benar tidak membutuhkanku lagi
Dialog: 0,1:10:25.58,1:10:27.54,di belakang layar,,0,0,0,,Dia meninggalkan 12 guru
Dialog: 0,1:10:28.34,1:10:31.46,teks umum,,0,0,0,,Kita seharusnya meracuninya dan menemukan sesuatu untuk memerasnya
Dialog: 0,1:10:32.05,1:10:33.93,teks umum,,0,0,0,,Aku terlalu percaya padanya
Dialog: 0,1:10:34.51,1:10:36.55,miring,,0,0,0,,Moo Dok!
Dialog: 0,1:10:37.39,1:10:38.39,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:10:38.97,1:10:40.35,teks umum,,0,0,0,,Apakah kamu punya jimat?
Dialog: 0,1:10:40.43,1:10:43.35,teks umum,,0,0,0,,Saya tidak bisa melakukan ini. Tapi sekarang kamu bisa lulus ujian
Dialog: 0,1:10:44.06,1:10:46.02,teks umum,,0,0,0,,Apakah kamu ingin aku lulus ujian pesulap?
Dialog: 0,1:10:46.65,1:10:48.69,teks umum,,0,0,0,,Apakah kamu gila? Jangan bicara omong kosong
Dialog: 0,1:10:49.44,1:10:52.40,teks umum,,0,0,0,,Sosnovy Bor mengadakan ujian bukan untuk pesulap
Dialog: 0,1:10:52.49,1:10:55.45,teks umum,,0,0,0,,Mereka bahkan berkompetisi di sana karena persaingan yang ketat
Dialog: 0,1:10:55.53,1:10:56.91,teks umum,,0,0,0,,Kompetisi?
Dialog: 0,1:10:56.99,1:10:58.74,teks umum,,0,0,0,,Mempekerjakan pelayan di Sosnovy Bor
Dialog: 0,1:10:58.83,1:11:01.54,teks umum,,0,0,0,,Jadi mereka hanya mempekerjakan pelayan
Dialog: 0,1:11:01.62,1:11:03.96,teks umum,,0,0,0,,Moo Dok, kamu adalah pelayannya
Dialog: 0,1:11:04.79,1:11:08.13,teks umum,,0,0,0,,Ya, saya tahu. Tapi aku bukan pembantu biasa
Dialog: 0,1:11:08.21,1:11:09.46,teks umum,,0,0,0,,Saya menolak
Dialog: 0,1:11:10.09,1:11:12.34,teks umum,,0,0,0,,Kenapa marah?
Dialog: 0,1:11:12.42,1:11:14.26,teks umum,,0,0,0,,Tahukah kamu betapa sulitnya menuju ke sana?
Dialog: 0,1:11:17.18,1:11:19.26,teks umum,,0,0,0,,Moo Dok, kamu terlihat lelah
Dialog: 0,1:11:19.35,1:11:20.93,teks umum,,0,0,0,,Makan sebelum berangkat
Dialog: 0,1:11:26.81,1:11:27.98,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:11:28.06,1:11:30.52,teks umum,,0,0,0,,Apakah Anda dari Sosnovy Bor? Pernahkah Anda melihat pemiliknya?
Dialog: 0,1:11:30.61,1:11:33.49,teks umum,,0,0,0,,Ya. Saya melihatnya. Dia baik-baik saja
Dialog: 0,1:11:34.19,1:11:36.65,teks umum,,0,0,0,,Apa yang dia ingin aku lakukan sekarang?
Dialog: 0,1:11:36.74,1:11:37.99,teks umum,,0,0,0,,Kapan dia akan datang untukku?
Dialog: 0,1:11:38.07,1:11:40.16,teks umum,,0,0,0,,Ingin kamu hidup dengan baik di sini
Dialog: 0,1:11:40.24,1:11:42.41,teks umum,,0,0,0,,Mengagumi bunga, makan yang manis-manis
Dialog: 0,1:11:43.33,1:11:47.79,teks umum,,0,0,0,,Dia bilang mengagumi bunga dan makan yang manis-manis?
Dialog: 0,1:11:47.87,1:11:48.96,teks umum,,0,0,0,,Ya
Dialogue: 0,1:11:53.30,1:11:55.88,teks umum,,0,0,0,,Bukankah dia bilang kapan dia akan datang menemuiku?
Dialog: 0,1:11:55.97,1:11:58.26,teks umum,,0,0,0,,Menurut aturan, dia tidak bisa pergi
Dialog: 0,1:11:59.09,1:12:01.51,teks umum,,0,0,0,,Dia bertekad untuk mengikuti aturan,
Dialog: 0,1:12:01.60,1:12:04.18,teks umum,,0,0,0,,Aku tidak mengkhawatirkannya lagi
Dialog: 0,1:12:06.94,1:12:09.98,di belakang layar,,0,0,0,,Menurutku Uku tidak membutuhkanku lagi
Dialog: 0,1:12:12.19,1:12:13.27,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:12:14.53,1:12:18.95,teks umum,,0,0,0,,dan kamu tidak tahu siapa yang disukai tuan kita?
Dialog: 0,1:12:20.74,1:12:22.74,teks umum,,0,0,0,,Mungkin ini gadis yang kulihat di Sosnovy Bor
Dialog: 0,1:12:22.83,1:12:25.91,teks umum,,0,0,0,,Cewek? Apakah dia berkencan dengan seseorang?
Dialog: 0,1:12:26.00,1:12:27.96,teks umum,,0,0,0,,Nah, dia bilang padaku,
Dialog: 0,1:12:28.54,1:12:30.75,teks umum,,0,0,0,,bahwa hatinya milik seorang gadis,
Dialog: 0,1:12:30.83,1:12:34.09,teks umum,,0,0,0,,yang seperti telur burung di atas pohon
Dialog: 0,1:12:43.18,1:12:46.77,miring,,0,0,0,,Dan juga dia tidak memiliki siapa pun selain dia
Dialog: 0,1:12:48.27,1:12:51.15,miring,,0,0,0,,Aku bisa membayangkan betapa dia khawatir dan peduli padanya
Dialog: 0,1:12:51.23,1:12:54.07,teks umum,,0,0,0,,Ketika seorang pria merawat seorang wanita, menurut Anda apa maksudnya?
Dialog: 0,1:12:56.32,1:12:57.69,teks umum,,0,0,0,,Artinya dia sedang jatuh cinta
Dialog: 0,1:13:01.24,1:13:03.37,teks umum,,0,0,0,,Tapi ini aku
Dialog: 0,1:13:09.16,1:13:10.42,kenangan miring,,0,0,0,,Ada telur burung
Dialog: 0,1:13:10.50,1:13:14.63,kenangan,,0,0,0,,Guru, mari kita tetap saling berbakti
Dialog: 0,1:13:21.05,1:13:22.76,kenangan miring,,0,0,0,,Aku hampir mati berkatmu,
Dialog: 0,1:13:22.84,1:13:24.18,kenangan,,0,0,0,,tuanku yang gila
Dialogue: 0,1:13:28.10,1:13:31.85,memori miring,,0,0,0,,Hubungan guru-murid kita akan langgeng sampai kamu menjadi yang terbaik,
Dialog: 0,1:13:31.94,1:13:34.48, kenangan miring,,0,0,0,,untuk membantuku mendapatkan kembali energiku
Dialog: 0,1:13:35.61,1:13:38.53,kenangan miring,,0,0,0,,Saat aku mendapatkan kembali kekuatanku dan menjadi Nak Su lagi,
Dialog: 0,1:13:39.03,1:13:40.99,kenangan,,0,0,0,,kita takkan lagi menjadi guru dan murid
Dialog: 0,1:13:42.45,1:13:44.45,kenangan miring,,0,0,0,,Boleh tahu alasannya?
Dialog: 0,1:13:45.66,1:13:48.70,kenangan miring,,0,0,0,,Karena dengan begitu kamu tidak lagi punya alasan untuk melindungiku
Dialog: 0,1:13:50.12,1:13:51.71,kenangan miring,,0,0,0,,Dan aku tidak punya alasan
Dialog: 0,1:13:55.08,1:13:56.34, kenangan miring,,0,0,0,, bersikap lunak terhadapmu
Dialog: 0,1:13:57.38,1:13:59.34,kenangan,,0,0,0,,Guru! Ini aku, Chan Wook
Dialog: 0,1:14:17.15,1:14:18.82,teks umum,,0,0,0,,Jadi apa yang harus dilakukan?
Dialog: 0,1:14:20.03,1:14:21.53,teks umum,,0,0,0,,Semuanya buruk
Dialog: 0,1:14:27.16,1:14:28.16,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:14:30.08,1:14:31.37,teks umum,,0,0,0,,Aku merindukanmu
Dialog: 0,1:15:06.44,1:15:08.24,pratinjau,,0,0,0,,Saya tidak akan mengajari Uka
Dialog: 0,1:15:08.32,1:15:12.04,pratinjau,,0,0,0,,Jadi kamu tidak membawanya ke bawah sayapmu, kamu hanya menguncinya di sini
Dialog: 0,1:15:12.12,1:15:13.62,pratinjau,,0,0,0,,Bantuan!
Dialog: 0,1:15:15.08,1:15:16.71,pratinjau,,0,0,0,,Itu pasti Moo Deok!
Dialog: 0,1:15:16.79,1:15:19.25,pratinjau,,0,0,0,,Kenapa dia harus selalu berada di tempat lain?
Dialog: 0,1:15:19.34,1:15:20.42,pratinjau,,0,0,0,,Master!
Dialog: 0,1:15:21.34,1:15:25.38,pratinjau,,0,0,0,,Kenapa surat? Selama itu menyampaikan perasaanmu...
Dialog: 0,1:15:25.47,1:15:30.14,pratinjau,,0,0,0,,Pria itu sudah jatuh cinta dengan seseorang
Dialog: 0,1:15:30.22,1:15:32.02,pratinjau,,0,0,0,,Ini lebih sulit dari yang kukira
Dialog: 0,1:15:32.10,1:15:34.02,pratinjau,,0,0,0,,Yang Mulia!
Dialog: 0,1:15:34.10,1:15:36.02,pratinjau,,0,0,0,,Dia selalu di sebelah Inggris
Dialog: 0,1:15:36.10,1:15:39.31,pratinjau,,0,0,0,,Kamu harus mencoba membaca apa yang tidak dapat kamu lihat
Dialog: 0,1:15:39.40,1:15:40.82,pratinjau,,0,0,0,,Moo Dok
Dialog: 0,0:02:55.14,0:02:57.14, torehan,,0,0,0,,

