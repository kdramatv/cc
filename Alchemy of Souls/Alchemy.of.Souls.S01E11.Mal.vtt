Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, Tommo, Zero Amamiya
Dialog: 0,0:00:43.53,0:00:45.95, inskripsi,,0,0,0,,Kami sedang mengupah pekerja di Sosnovy Bor
Dialog: 0,0:00:46.03,0:00:47.49,teks umum,,0,0,0,,Ini bukan surat
Dialog: 0,0:00:48.54,0:00:49.75,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:00:49.83,0:00:52.83,teks umum,,0,0,0,,Jika ia menyampaikan perasaan anda, ini adalah surat
Dialog: 0,0:00:57.80,0:01:00.05,teks umum,,0,0,0,,Saya mungkin kelihatan menyedihkan dalam percubaan saya
Dialog: 0,0:01:00.84,0:01:02.38,teks umum,,0,0,0,,sampai ke sini sebagai hamba
Dialog: 0,0:01:03.43,0:01:06.35,teks umum,,0,0,0,,Anda seorang guru yang sangat berpengalaman
Dialog: 0,0:01:06.43,0:01:08.18,teks umum,,0,0,0,,Saya kasihan kepada awak
Dialog: 0,0:01:09.18,0:01:11.60,teks umum,,0,0,0,,Sekurang-kurangnya anda belajar kesetiaan\N dan menunaikan kewajipan anda
Dialog: 0,0:01:11.68,0:01:13.85,teks umum,,0,0,0,,Guru saya berusaha keras untuk saya
Dialog: 0,0:01:13.94,0:01:17.19,teks umum,,0,0,0,,Saya fikir saya harus memberikan yang terbaik
Dialog: 0,0:01:19.44,0:01:20.86,teks umum,,0,0,0,,Adakah ini membuatkan anda tertekan?
Dialog: 0,0:01:20.94,0:01:23.65,teks umum,,0,0,0,,Tidak juga. Tetapi saya ragu-ragu
Dialog: 0,0:01:24.49,0:01:29.29,teks umum,,0,0,0,,Jawab anda sebagai pelajar atau sebagai sarjana
Dialog: 0,0:01:29.87,0:01:32.54,teks umum,,0,0,0,,Atau jawab mengikut gaya apa yang anda baca
Dialog: 0,0:01:33.66,0:01:35.33,teks umum,,0,0,0,,Dan apakah yang anda baca?
Dialog: 0,0:01:36.13,0:01:39.96,teks umum,,0,0,0,,Kemudian jawab sama?
Dialog: 0,0:01:41.46,0:01:43.01,teks umum,,0,0,0,,Sama? apa yang awak cakap ni?
Dialog: 0,0:01:44.05,0:01:45.26,teks umum,,0,0,0,,Tertulis di sana
Dialog: 0,0:01:45.34,0:01:47.76,teks umum,,0,0,0,,"Saya akan melalui segalanya hanya untuk berjumpa dengan awak"
Dialog: 0,0:01:48.39,0:01:51.64,teks umum,,0,0,0,,"Saya boleh buat apa sahaja, hanya untuk berpeluang berjumpa dengan awak"
Dialog: 0,0:01:52.31,0:01:53.81,teks umum,,0,0,0,,Dan ini jawapan saya
Dialog: 0,0:02:05.11,0:02:06.57,teks umum,,0,0,0,,Saya juga merindui awak
Dialog: 0,0:02:10.45,0:02:11.79,teks umum,,0,0,0,,Ini jawapan saya
Dialog: 0,0:02:41.40,0:02:43.23,teks umum,,0,0,0,,Saya akan berpura-pura saya tidak mendengar ini
Dialog: 0,0:02:43.86,0:02:45.28,teks umum,,0,0,0,,Dan lupakan surat itu
Dialog: 0,0:02:50.45,0:02:51.95,teks umum,,0,0,0,,Anda tidak boleh menyingkirkan sesuatu,
Dialog: 0,0:02:52.79,0:02:54.50,teks umum,,0,0,0,,jika sudah dikongsi dengan seseorang
Dialog: 0,0:02:57.00,0:02:58.33,teks umum,,0,0,0,,Anda boleh menyingkirkan
Dialog: 0,0:03:01.04,0:03:02.63,teks umum,,0,0,0,,Boleh dibakar,
Dialog: 0,0:03:03.96,0:03:05.67,teks umum,,0,0,0,,seolah-olah ia tidak pernah berlaku
Dialog: 0,0:03:07.05,0:03:09.22,teks umum,,0,0,0,,Anda fikir anda akan membakarnya dan surat itu tidak wujud?
Dialog: 0,0:03:10.14,0:03:11.39,teks umum,,0,0,0,,Baru sekarang, cikgu,
Dialog: 0,0:03:12.14,0:03:13.47,teks umum,,0,0,0,,pelajar anda
Dialog: 0,0:03:14.22,0:03:16.77,teks umum,,0,0,0,,belajar melihat perkara yang tidak boleh dilihat
Dialog: 0,0:03:19.06,0:03:22.48,teks umum,,0,0,0,,Saya membaca "Perkataan Hati." Adakah anda ingin menyemak?
Dialog: 0,0:03:24.57,0:03:26.32,teks umum,,0,0,0,,Kita perlu menumpukan perhatian,
Dialog: 0,0:03:26.40,0:03:29.32,teks umum,,0,0,0,,untuk membaca perkara yang anda tidak dapat lihat
Dialog: 0,0:03:30.70,0:03:31.82,teks umum,,0,0,0,,Dan kemudian...
Dialog: 0,0:03:35.20,0:03:37.33,teks umum,,0,0,0,,sebut nama penerima
Dialog: 0,0:03:39.87,0:03:41.00,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:03:42.71,0:03:44.67,luar skrin,,0,0,0,,Isyarat yang jelas tetapi berbahaya
Dialog: 0,0:03:45.42,0:03:48.30,suara,,0,0,0,,Saya jatuh cinta dengan dia
Dialog: 0,0:03:51.59,0:03:52.97,teks umum,,0,0,0,,Nah, begitulah. saya baca
Dialog: 0,0:03:54.51,0:03:56.85,teks umum,,0,0,0,,Sesuatu yang sukar dibaca kerana ia tersembunyi,
Dialog: 0,0:03:56.93,0:03:58.06,teks umum,,0,0,0,,tetapi ada
Dialog: 0,0:04:03.31,0:04:06.19,teks umum,,0,0,0,,Anda melihat tanda di mata saya, anda mengetahui bahawa saya seorang nomad,
Dialog: 0,0:04:07.82,0:04:09.36,teks umum,,0,0,0,,yang menarik perhatian saya
Dialog: 0,0:04:11.24,0:04:13.16,teks umum,,0,0,0,,Sekarang saya nampak kelemahan saya yang lain
Dialog: 0,0:04:13.24,0:04:15.12,teks umum,,0,0,0,,Jika ini adalah kelemahan anda,
Dialog: 0,0:04:15.99,0:04:17.33,teks umum,,0,0,0,,kemudian saya juga
Dialog: 0,0:04:19.37,0:04:21.71,teks umum,,0,0,0,,Surat anda adalah jawapan saya
Dialog: 0,0:04:21.79,0:04:23.46,teks umum,,0,0,0,,Jadi kita mempunyai satu kelemahan
Dialog: 0,0:04:24.79,0:04:28.26,teks umum,,0,0,0,,Saya rasa saya tidak keberatan berkongsi kelemahan anda
Dialog: 0,0:04:30.76,0:04:33.18,teks umum,,0,0,0,,Sejujurnya, saya bimbang
Dialog: 0,0:04:33.84,0:04:35.89,teks umum,,0,0,0,,Anda akhirnya menemui apa yang anda mahukan
Dialog: 0,0:04:36.51,0:04:40.68,teks umum,,0,0,0,,Dan saya tidak dapat berbuat apa-apa walaupun anda meninggalkan saya
Dialog: 0,0:04:41.35,0:04:44.94,teks umum,,0,0,0,,Saya pun terfikir untuk meracuni awak
Dialog: 0,0:04:45.02,0:04:46.77,teks umum,,0,0,0,,dan cari sesuatu untuk dihina
Dialog: 0,0:04:48.19,0:04:49.32,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:04:50.74,0:04:53.28,teks umum,,0,0,0,,rupa-rupanya anda sudah diracun
Dialog: 0,0:04:54.91,0:04:55.99,teks umum,,0,0,0,,Diracun?
Dialog: 0,0:04:56.07,0:04:58.20,teks umum,,0,0,0,,Anda akan menjadi lemah dan lemah
Dialog: 0,0:04:58.70,0:05:01.25,teks umum,,0,0,0,,Tiada jalan keluar dari racun ini
Dialog: 0,0:05:02.21,0:05:04.33,teks umum,,0,0,0,,Penawarnya ialah orang yang meracuni anda
Dialog: 0,0:05:04.42,0:05:07.00,teks umum,,0,0,0,,Jadi, saya merindui awak kerana,
Dialog: 0,0:05:07.88,0:05:09.55,teks umum,,0,0,0,,apa yang diracuni?
Dialog: 0,0:05:10.46,0:05:11.55,teks umum,,0,0,0,,Ya
Dialog: 0,0:05:12.17,0:05:14.64,teks umum,,0,0,0,,Anda tanpa belas kasihan diracuni oleh pahlawan bayangan
Dialog: 0,0:05:15.26,0:05:16.60,teks umum,,0,0,0,,Fikir dengan cara ini
Dialog: 0,0:05:17.72,0:05:19.35,teks umum,,0,0,0,,Ini tidak jauh dari kebenaran
Dialog: 0,0:05:20.68,0:05:22.06,teks umum,,0,0,0,,Jadi itu racun?
Dialog: 0,0:05:23.64,0:05:26.44,teks umum,,0,0,0,,Ya, pelik bahawa di kalangan semua orang
Dialog: 0,0:05:27.82,0:05:28.86,teks umum,,0,0,0,,Saya merindui awak
Dialog: 0,0:05:29.94,0:05:32.28,teks umum,,0,0,0,,Awak selalu mengugut untuk membunuh saya
Dialog: 0,0:05:32.36,0:05:34.15,teks umum,,0,0,0,,Dia juga melemparkan pisau ke arah saya
Dialog: 0,0:05:34.24,0:05:36.62,teks umum,,0,0,0,,Dia ketawakan saya, saya hampir putus lengan
Dialog: 0,0:05:36.70,0:05:38.41,teks umum,,0,0,0,,Dan anda berani berbohong
Dialog: 0,0:05:38.99,0:05:40.74,teks umum,,0,0,0,,Anda kejam terhadap saya,
Dialog: 0,0:05:40.83,0:05:43.00,teks umum,,0,0,0,,tetapi saya tidak dapat mengelak daripada memikirkan anda
Dialog: 0,0:05:43.08,0:05:44.96,teks umum,,0,0,0,,Buka mata saya - Saya sudah merindui awak
Dialog: 0,0:05:45.04,0:05:48.54,teks umum,,0,0,0,,Saya merindui awak sepanjang hari, walaupun saya hendak tidur
Dialog: 0,0:05:48.63,0:05:50.00,teks umum,,0,0,0,,- Berhenti\N- Kenapa?
Dialog: 0,0:05:50.09,0:05:52.46,teks umum,,0,0,0,,Saya mengaku perasaan saya, dan awak membandingkannya dengan racun
Dialog: 0,0:05:52.55,0:05:55.43,teks umum,,0,0,0,,Jadi sekurang-kurangnya dengar apa gejala saya
Dialog: 0,0:05:55.51,0:05:57.01,teks umum,,0,0,0,,Anda penawar saya
Dialog: 0,0:05:58.35,0:06:02.98,teks umum,,0,0,0,,Saya baru sahaja berkata bahawa saya merindui awak, awak pahlawan bayangan yang dahsyat
Dialog: 0,0:06:03.06,0:06:04.56,teks umum,,0,0,0,,Dan awak kata saya diracun
Dialog: 0,0:06:04.64,0:06:07.19,teks umum,,0,0,0,,Sekarang bersabarlah dengan aduan saya tentang gejala
Dialog: 0,0:06:07.27,0:06:08.56,teks umum,,0,0,0,,Saya telah diracun, lagipun
Dialog: 0,0:06:08.65,0:06:11.02,teks umum,,0,0,0,,Saya tiada apa yang perlu dimalukan
Dialog: 0,0:06:11.11,0:06:13.90,teks umum,,0,0,0,,Oleh kerana anda adalah penawar, itu bermakna anda mempunyai kaitan dengan keracunan
Dialog: 0,0:06:26.75,0:06:30.25,teks umum,,0,0,0,,Ini adalah anak saudara ketua Sosnovy Bor
Dialog: 0,0:06:30.34,0:06:33.55,teks umum,,0,0,0,,dan bab seterusnya kami
Dialog: 0,0:06:38.22,0:06:41.72,teks umum,,0,0,0,,Saya datang untuk menyambut anda bagi pihak ketua
Dialog: 0,0:06:42.51,0:06:44.60,teks umum,,0,0,0,,Tahniah kerana menyertai Sosnovy Bor
Dialog: 0,0:06:45.68,0:06:46.69,teks umum,,0,0,0,,Syabas
Dialog: 0,0:06:48.98,0:06:52.36,teks umum,,0,0,0,,Anda melakukan kerja yang baik hari ini
Dialog: 0,0:06:52.90,0:06:56.74,teks umum,,0,0,0,,Hari ini anda akan ditawarkan minuman keras dan daging
Dialog: 0,0:06:57.49,0:06:58.86,teks umum,,0,0,0,,Anda boleh berseronok
Dialog: 0,0:07:00.57,0:07:02.70,teks umum,,0,0,0,,Pergi, makan, minum
Dialog: 0,0:07:04.08,0:07:05.54,teks umum,,0,0,0,,Ikuti saya
Dialog: 0,0:07:08.46,0:07:09.33,teks umum,,0,0,0,,En.
Dialog: 0,0:07:10.17,0:07:12.34,teks umum,,0,0,0,,adakah anda biasa dengan Moo Deok?
Dialog: 0,0:07:12.42,0:07:14.25,teks umum,,0,0,0,,Dia lulus peperiksaan hari ini
Dialog: 0,0:07:15.34,0:07:18.26,teks umum,,0,0,0,,Hamba yang datang terakhir
Dialog: 0,0:07:20.05,0:07:23.01, inskripsi,,0,0,0,,Seratus dua puluh lima
Dialog: 0,0:07:38.90,0:07:40.78,kenangan,,0,0,0,,Nombor 125, Moo Deok
Dialog: 0,0:07:43.20,0:07:44.53,kenangan,,0,0,0,,Lulus!
Dialog: 0,0:07:53.46,0:07:55.55,teks umum,,0,0,0,,Saya mengenali Mu Dok dengan baik
Dialog: 0,0:07:56.63,0:07:59.34,teks umum,,0,0,0,,Dia tidak sedarkan diri dan dibawa ke Sejukwon
Dialog: 0,0:07:59.42,0:08:01.89,teks umum,,0,0,0,,saya kena pulangkan barang dia
Dialog: 0,0:08:03.39,0:08:06.85,teks umum,,0,0,0,,dan berikan azimat untuk masuk
Dialog: 0,0:08:07.43,0:08:09.52,teks umum,,0,0,0,,Adakah dia masih di Saejukwon?
Dialog: 0,0:08:10.52,0:08:12.40,teks umum,,0,0,0,,Berikan kepada saya. Saya akan menyampaikannya
Dialog: 0,0:08:13.40,0:08:14.82,teks umum,,0,0,0,,Anda melakukan kerja yang baik hari ini
Dialog: 0,0:08:20.61,0:08:22.20,teks umum,,0,0,0,,Jom
Dialog: 0,0:08:46.97,0:08:48.18,kenangan,,0,0,0,,Mu Dok...
Dialog: 0,0:09:08.41,0:09:11.96,kenangan,,0,0,0,,Anda hilang kerana dalam kepala anda
Dialog: 0,0:09:12.04,0:09:14.46,kenangan,,0,0,0,,terlalu banyak fikiran
Dialog: 0,0:09:15.63,0:09:18.17,kenangan,,0,0,0,,Apabila ini berlaku, fikirkan satu perkara
Dialog: 0,0:09:19.80,0:09:23.68,suara,,0,0,0,,Nak Soo, satu-satunya yang anda fikirkan ialah Chan Wook
Dialog: 0,0:09:39.15,0:09:40.23,teks umum,,0,0,0,,Dengar, Yul
Dialog: 0,0:09:41.03,0:09:43.82,teks umum,,0,0,0,,Saya secara tidak sengaja melihat ke dalam beg Moo Deok
Dialog: 0,0:09:45.32,0:09:48.20,teks umum,,0,0,0,,dan mendapati sesuatu yang pelik
Dialog: 0,0:09:50.04,0:09:52.75,teks umum,,0,0,0,,Ini wisel awak, bukan?
Dialog: 0,0:09:53.66,0:09:55.29,teks umum,,0,0,0,,Yang anda kalah dalam Danhyangok
Dialog: 0,0:09:56.88,0:09:58.38,teks umum,,0,0,0,,Ya, saya
Dialog: 0,0:09:59.17,0:10:01.55,teks umum,,0,0,0,,Lalu mengapa Moo Dok memilikinya?
Dialog: 0,0:10:14.18,0:10:16.06,teks umum,,0,0,0,,Pernah jumpa Encik Dan Gu?
Dialog: 0,0:10:16.69,0:10:19.23,teks umum,,0,0,0,,Dia mempunyai barang-barang saya dan azimat untuk masuk
Dialog: 0,0:10:23.74,0:10:25.32,teks umum,,0,0,0,,Dia memberikannya kepada saya
Dialog: 0,0:10:25.90,0:10:26.74,teks umum,,0,0,0,,Faham
Dialog: 0,0:10:27.36,0:10:28.70,teks umum,,0,0,0,,Saya akan ambil
Dialog: 0,0:10:37.92,0:10:41.80,teks umum,,0,0,0,,Saya kehilangan dia di Danhyangok. Adakah anda menemuinya di sana?
Dialog: 0,0:10:44.92,0:10:46.05,teks umum,,0,0,0,,Ya
Dialog: 0,0:10:46.55,0:10:49.47,teks umum,,0,0,0,,Saya ambil kerana...
Dialog: 0,0:10:52.72,0:10:54.47,teks umum,,0,0,0,,Jatuh cinta dengan saya
Dialog: 0,0:10:57.85,0:10:59.77,teks umum,,0,0,0,,Anda sendiri yang berkata demikian
Dialog: 0,0:11:01.27,0:11:03.48,teks umum,,0,0,0,,Penjelasan ini sudah memadai
Dialog: 0,0:11:09.87,0:11:11.49,teks umum,,0,0,0,,Saya akan mengambil barang saya,
Dialog: 0,0:11:12.12,0:11:13.54,teks umum,,0,0,0,,dan anda menerima wisel
Dialog: 0,0:11:18.21,0:11:21.21,teks umum,,0,0,0,,Saya memberitahu Dan Gu bahawa saya memberikannya kepada anda
Dialog: 0,0:11:22.54,0:11:23.96,teks umum,,0,0,0,,Tidak boleh mengambilnya kembali
Dialog: 0,0:11:26.59,0:11:28.26,teks umum,,0,0,0,,Mengapa anda memberikannya kepada saya?
Dialog: 0,0:11:28.34,0:11:30.93,teks umum,,0,0,0,,Anda tidak percaya apabila saya mengaku cinta saya
Dialog: 0,0:11:32.51,0:11:34.64,teks umum,,0,0,0,,Maka anda terpaksa membuat saya percaya
Dialog: 0,0:11:42.19,0:11:46.32,teks umum,,0,0,0,,Saya hanya mengejek mereka
Dialog: 0,0:11:46.90,0:11:49.61,teks umum,,0,0,0,,Dan Moo Dok sangat menyayangi Yulia
Dialog: 0,0:11:50.20,0:11:52.20,teks umum,,0,0,0,,Dan mempertimbangkan hadiah Julia,
Dialog: 0,0:11:52.28,0:11:54.78,teks umum,,0,0,0,,Saya rasa dia juga bernafas tidak sekata ke arahnya
Dialog: 0,0:11:55.70,0:11:57.83,teks umum,,0,0,0,,Dia mungkin meminta wisel ini
Dialog: 0,0:11:58.41,0:11:59.92,teks umum,,0,0,0,,Apabila dia memerlukan sesuatu,
Dialog: 0,0:12:00.00,0:12:02.00,teks umum,,0,0,0,,dia berbohong dan mengelak dengan mudah
Dialog: 0,0:12:03.34,0:12:06.71,teks umum,,0,0,0,,Yul pun tahu tentang penyertaannya dalam peperiksaan
Dialog: 0,0:12:06.80,0:12:09.30,teks umum,,0,0,0,,Dia menjawab semua soalan demi dia
Dialog: 0,0:12:09.38,0:12:12.43,teks umum,,0,0,0,,Dia pasti meminta dia untuk membantu,
Dialog: 0,0:12:12.51,0:12:14.68,teks umum,,0,0,0,,kerana saya sendiri terlalu bodoh
Dialog: 0,0:12:15.89,0:12:17.43,teks umum,,0,0,0,,Dia sentiasa mendapat apa yang dia mahu
Dialog: 0,0:12:18.48,0:12:19.81,teks umum,,0,0,0,,Lebih penting lagi,
Dialog: 0,0:12:20.73,0:12:24.36,teks umum,,0,0,0,,Saya melihat mereka berjalan bersama dengan baik
Dialog: 0,0:12:24.98,0:12:26.15,teks umum,,0,0,0,,Apa?
Dialog: 0,0:12:27.15,0:12:28.19,teks umum,,0,0,0,,Sedap?
Dialog: 0,0:12:34.53,0:12:38.04,italic,,0,0,0,,Moo Deok dan Yul bertemu sekali
Dialog: 0,0:12:38.12,0:12:42.08,teks umum,,0,0,0,,Saya rasa awak tidak tahu kerana awak dikurung dalam bilik latihan
Dialog: 0,0:12:42.62,0:12:43.58,teks umum,,0,0,0,,Betul
Dialog: 0,0:12:47.75,0:12:50.01,teks umum,,0,0,0,,Ya, saya tidak tahu
Dialog: 0,0:13:16.12,0:13:17.74,teks umum,,0,0,0,,Bagaimana jika ini benar?
Dialog: 0,0:13:18.33,0:13:19.45,kenangan miring,,0,0,0,,Saya juga merindui awak
Dialog: 0,0:13:19.54,0:13:20.66,kenangan,,0,0,0,,Ini jawapan saya
Dialog: 0,0:13:31.13,0:13:33.34,teks umum,,0,0,0,,Dia menolak kerana dia tidak suka saya
Dialog: 0,0:13:34.30,0:13:36.18,teks umum,,0,0,0,,Dia tidak merinduinya seperti saya
Dialog: 0,0:13:38.22,0:13:40.06,teks umum,,0,0,0,,Hanya saya merindui awak
Dialog: 0,0:13:46.06,0:13:47.11,teks umum,,0,0,0,,Saya...
Dialog: 0,0:13:47.73,0:13:50.36,teks umum,,0,0,0,,Saya mahu minum racun dan mati
Dialog: 0,0:13:58.41,0:13:59.70,teks umum,,0,0,0,,Sungguh memalukan
Dialog: 0,0:14:12.55,0:14:13.88,teks umum,,0,0,0,,Saya suka awak
Dialog: 0,0:14:14.59,0:14:17.34,teks umum,,0,0,0,,Saya memberitahu anda tentang perkara ini beratus kali
Dialog: 0,0:14:23.73,0:14:25.35,teks umum,,0,0,0,,Saya tidak tahu banyak tentang cinta,
Dialog: 0,0:14:26.60,0:14:30.02,teks umum,,0,0,0,,tetapi apabila anda menyukai seseorang, anda tidak mengulanginya berulang kali
Dialog: 0,0:14:32.03,0:14:34.11,teks umum,,0,0,0,, Kerana sukar untuk mengaku walaupun sekali
Dialog: 0,0:14:39.66,0:14:41.08,teks umum,,0,0,0,,Wisel ini
Dialog: 0,0:14:42.74,0:14:46.04,teks umum,,0,0,0,,kepunyaan seorang kawan yang saya tidak pernah boleh mengaku
Dialog: 0,0:14:54.42,0:14:56.05,teks umum,,0,0,0,,Saya sangat sukakan awak
Dialog: 0,0:15:05.31,0:15:08.60,teks umum,,0,0,0,,Saya benar-benar ingin memberitahunya tentang perkara ini
Dialog: 0,0:15:14.03,0:15:15.69,kenangan miring,,0,0,0,,Saya mahu mencubanya juga
Dialog: 0,0:15:16.61,0:15:18.45,kenangan,,0,0,0,,Bolehkah saya?
Dialog: 0,0:15:56.28,0:15:59.70,teks umum,,0,0,0,,Anda kini telah memasuki Sosnovy Bor. Kami akan berjumpa lebih kerap
Dialog: 0,0:16:02.49,0:16:04.66,teks umum,,0,0,0,,Anda boleh datang kepada saya jika anda memerlukan apa-apa
Dialog: 0,0:16:09.83,0:16:11.46,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:16:39.74,0:16:42.16,teks umum,,0,0,0,,Chan Wook membaca “Words of the Heart”
Dialog: 0,0:16:43.36,0:16:45.03,teks umum,,0,0,0,,Awak tolong dia kan?
Dialog: 0,0:16:46.16,0:16:49.37,teks umum,,0,0,0,,Saya dapati dia boleh, jadi saya datang untuk memberitahu anda
Dialog: 0,0:16:50.25,0:16:54.54,teks umum,,0,0,0,,Suruh Jin hantar buku ini kepada Jinyeowon
Dialog: 0,0:16:55.88,0:16:57.05,teks umum,,0,0,0,,Tulang
Dialog: 0,0:16:57.80,0:16:58.63,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:16:59.76,0:17:02.76,teks umum,,0,0,0,,Chan Wook marah kerana semua orang membaca "surat" ini
Dialog: 0,0:17:03.34,0:17:06.97,teks umum,,0,0,0,,Saya rasa Cikgu Seo Kyung akan merasakan perkara yang sama
Dialog: 0,0:17:07.06,0:17:10.27,teks umum,,0,0,0,,Nampaknya awak sangat sukakan Chan Wook
Dialog: 0,0:17:11.64,0:17:14.81,teks umum,,0,0,0,,Dia istimewa, sebab itu saya perhatikan dia
Dialog: 0,0:17:14.90,0:17:16.86,teks umum,,0,0,0,,Dia sangat bijak,
Dialog: 0,0:17:16.94,0:17:20.36,teks umum,,0,0,0,,tetapi Jin mahu mengurungnya di sini
Dialog: 0,0:17:23.45,0:17:24.99,kenangan,,0,0,0,,Adakah anda pasti,
Dialog: 0,0:17:25.62,0:17:27.78,kenangan,,0,0,0,,bahawa batu ais itu tiada di Sosnovy Bor?
Dialog: 0,0:17:28.79,0:17:30.54,kenangan,,0,0,0,,Mengapa anda memutuskan perkara itu?
Dialog: 0,0:17:31.29,0:17:32.66,kenangan,,0,0,0,,20 tahun yang lalu
Dialog: 0,0:17:33.62,0:17:36.04,kenangan,,0,0,0,,gwangju Chang Gang menguasai alkimia jiwa
Dialog: 0,0:17:38.00,0:17:39.30,kenangan,,0,0,0,,Disebabkan ini
Dialog: 0,0:17:39.38,0:17:42.01,kenangan,,0,0,0,,seorang anak dilahirkan yang tidak sepatutnya
Dialog: 0,0:17:43.01,0:17:46.47,kenangan,,0,0,0,,Dan malam itu bintang Raja bersinar di langit
Dialog: 0,0:17:47.51,0:17:49.26,kenangan,,0,0,0,,Adakah ini Chan Wook?
Dialog: 0,0:17:50.10,0:17:51.22,kenangan,,0,0,0,,Ya
Dialog: 0,0:17:51.31,0:17:55.69,kenangan,,0,0,0,,Ahli silap mata membuka kedap batu di Sosnovy Bor
Dialog: 0,0:17:56.44,0:17:59.61,kenangan,,0,0,0,,dan melalui alkimia jiwa anak raja dilahirkan
Dialog: 0,0:18:01.86,0:18:05.82,kenangan,,0,0,0,,Jin Moo dari Jeonbugwan tahu tentang ini
Dialog: 0,0:18:07.70,0:18:11.16,kenangan,,0,0,0,,Jika mereka sudah memiliki batu itu, apa alasannya
Dialog: 0,0:18:11.83,0:18:14.04,kenangan,,0,0,0,,cipta Hutan Pine,
Dialog: 0,0:18:16.17,0:18:17.83,kenangan,,0,0,0,,untuk membawanya?
Dialog: 0,0:18:23.46,0:18:27.39,teks umum,,0,0,0,,Jin tidak mempunyai cara lain untuk melindungi Hutan Pine kecuali untuk menyembunyikan Uka
Dialog: 0,0:18:28.05,0:18:28.89,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:18:28.97,0:18:32.72,teks umum,,0,0,0,,Adakah sesuatu yang saya tidak tahu?
Dialog: 0,0:18:42.03,0:18:43.23,teks umum,,0,0,0,,Oh, awak kecil...
Dialog: 0,0:18:43.32,0:18:47.45,teks umum,,0,0,0,,Bagaimanakah anda boleh mempercayai seorang pemuda yang cuai dan tidak berhemat dengan rahsia?!
Dialog: 0,0:18:48.74,0:18:50.58,teks umum,,0,0,0,,Bagaimana anda boleh...
Dialog: 0,0:18:51.91,0:18:53.62,teks umum,,0,0,0,,Saya harap ia hilang
Dialog: 0,0:18:57.00,0:18:58.42,teks umum,,0,0,0,,Dia sangat...
Dialog: 0,0:18:58.50,0:19:00.79,teks umum,,0,0,0,,tidak marah, walaupun saya berkata ada lagi
Dialog: 0,0:19:00.88,0:19:02.50,teks umum,,0,0,0,,Saya tidak akan minum teh kesucian
Dialog: 0,0:19:05.09,0:19:08.93,teks umum,,0,0,0,,Tunggu, selendang itu hadiah daripada pembantu rumah Kim
Dialog: 0,0:19:29.70,0:19:32.20,teks umum,,0,0,0,,Pembersihan mesti diselesaikan sebelum
Dialog: 0,0:19:32.28,0:19:34.62,teks umum,,0,0,0,,bagaimana ahli silap mata akan memulakan kelas mereka. Lebih pantas
Dialog: 0,0:19:34.70,0:19:35.54,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:19:56.64,0:19:57.93,teks umum,,0,0,0,,Di manakah pemiliknya?
Dialog: 0,0:19:58.02,0:20:00.06,teks umum,,0,0,0,,- Dia takkan datang?\N- Nah...
Dialog: 0,0:20:00.14,0:20:01.40,teks umum,,0,0,0,,Saya pergi untuk membangunkan dia,
Dialog: 0,0:20:01.48,0:20:03.73,teks umum,,0,0,0,,tetapi dia berkata bahawa dia tidak tidur kejap semalam
Dialog: 0,0:20:03.82,0:20:06.07,teks umum,,0,0,0,,Dan dia akan melangkau? Pada hari pertama?
Dialog: 0,0:20:07.90,0:20:09.15,teks umum,,0,0,0,,Jumpa, Moo Deok
Dialog: 0,0:20:26.92,0:20:28.01,teks umum,,0,0,0,,Hos
Dialog: 0,0:20:28.09,0:20:29.55,teks umum,,0,0,0,,Kita perlu bangkit
Dialog: 0,0:20:31.26,0:20:32.43,teks umum,,0,0,0,,Tuan!
Dialog: 0,0:20:36.14,0:20:37.52,teks umum,,0,0,0,,Bangun
Dialog: 0,0:20:37.60,0:20:39.02,teks umum,,0,0,0,,Kalau tidak saya akan pukul awak
Dialog: 0,0:20:39.10,0:20:40.27,teks umum,,0,0,0,,Bangun!
Dialog: 0,0:20:49.53,0:20:51.82,teks umum,,0,0,0,,Jangan buat bising dan pergi, saya akan tidur
Dialog: 0,0:20:54.20,0:20:56.66,teks umum,,0,0,0,,Adakah anda gila? Adakah anda mahukan kematian?
Dialog: 0,0:20:59.37,0:21:01.04,teks umum,,0,0,0,,Ya, saya gila dan saya mahu mati
Dialog: 0,0:21:01.75,0:21:03.75,teks umum,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:21:03.83,0:21:06.38,teks umum,,0,0,0,,Ini adalah simptom keracunan saya
Dialog: 0,0:21:07.71,0:21:10.67,teks umum,,0,0,0,,Chan Wook, berhenti menjadi degil dan marah
Dialog: 0,0:21:13.13,0:21:14.72,teks umum,,0,0,0,,Saya kata sayalah penawarnya
Dialog: 0,0:21:16.22,0:21:17.05,teks umum,,0,0,0,,Di sini
Dialog: 0,0:21:18.14,0:21:20.10,teks umum,,0,0,0,,Ini saya
Dialog: 0,0:21:31.57,0:21:32.82,teks umum,,0,0,0,,Maaf
Dialog: 0,0:21:47.29,0:21:48.34,teks umum,,0,0,0,,Hei, Chan Wook
Dialog: 0,0:21:49.30,0:21:52.09,teks umum,,0,0,0,,Saya mendengar anda membaca "Perkataan Hati." saya terkejut
Dialog: 0,0:21:52.17,0:21:53.84,teks umum,,0,0,0,,Tiada apa yang perlu dihairankan
Dialog: 0,0:21:53.93,0:21:56.26,teks umum,,0,0,0,,Saya lihat anda sedang membaca tentang teknik Hyonggon
Dialog: 0,0:21:56.34,0:21:58.55,teks umum,,0,0,0,,Saya menguasai gaya ilmu pedang ini semasa kecil
Dialog: 0,0:21:59.68,0:22:02.02,teks umum,,0,0,0,,Jika anda mengajar membaca “Perkataan Hati”,
Dialog: 0,0:22:02.10,0:22:03.81,teks umum,,0,0,0,,Saya akan membantu anda menguasai Hyonggon
Dialog: 0,0:22:06.52,0:22:07.36,teks umum,,0,0,0,,Kita perlu berfikir
Dialog: 0,0:22:09.94,0:22:12.07,contact,,0,0,0,,Setuju. Katakan anda bersetuju
Dialog: 0,0:22:13.74,0:22:16.16,teks umum,,0,0,0,,Dengar, saya bosan dengan sesuatu
Dialog: 0,0:22:17.45,0:22:20.49,teks umum,,0,0,0,,Minta bantuan Cikgu Li
Dialog: 0,0:22:29.34,0:22:30.38,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:22:31.09,0:22:33.55,teks umum,,0,0,0,,Saya menguasai Ryusu dalam masa yang sama dengan anda
Dialog: 0,0:22:34.17,0:22:37.05,teks umum,,0,0,0,,Awak nak lawan saya?
Dialog: 0,0:22:37.13,0:22:39.43,teks umum,,0,0,0,, Kemudian saya akan meminjamkan permaidani nilam
Dialog: 0,0:22:39.51,0:22:41.47,teks umum,,0,0,0,,untuk latihan
Dialog: 0,0:22:42.52,0:22:45.23,teks umum,,0,0,0,,Dengan bantuannya, tenaga boleh digandakan
Dialog: 0,0:22:45.31,0:22:48.60,teks umum,,0,0,0,,Permaidani nilam? Ini sangat jarang berlaku
Dialog: 0,0:22:50.02,0:22:51.90,teks umum,,0,0,0,,Cikgu, ini peluang yang baik
Dialog: 0,0:22:54.24,0:22:56.57,teks umum,,0,0,0,,Tetapi permaidani seperti itu sejuk, bukan?
Dialog: 0,0:22:57.36,0:22:59.28,teks umum,,0,0,0,,Saya cepat sakit
Dialog: 0,0:23:00.37,0:23:02.41,teks umum,,0,0,0,,Jadi saya tidak perlukan ini
Dialog: 0,0:23:10.54,0:23:11.84,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:23:13.21,0:23:16.84,teks umum,,0,0,0,,Saya tidak tidur lena hari ini, saya akan tidur sebentar
Dialog: 0,0:23:18.59,0:23:21.72,teks umum,,0,0,0,,Terlepas peluang untuk menguasai Hyonggon
Dialog: 0,0:23:21.80,0:23:22.81,teks umum,,0,0,0,,Adakah anda benar-benar gila?
Dialog: 0,0:23:22.89,0:23:25.64,teks umum,,0,0,0,,Dan semalam. Permaidani nilam sukar didapati,
Dialog: 0,0:23:25.73,0:23:27.14,teks umum,,0,0,0,,dan anda kata dia sejuk
Dialog: 0,0:23:27.23,0:23:29.77,teks umum,,0,0,0,,Saya terpaksa bersetuju walaupun saya boleh mati di atasnya
Dialog: 0,0:23:29.85,0:23:32.48,teks umum,,0,0,0,,Luar biasa. "Gila. Matilah"
Dialog: 0,0:23:32.57,0:23:34.40,teks umum,,0,0,0,,Itu sahaja yang anda beritahu saya
Dialog: 0,0:23:36.28,0:23:37.70,teks umum,,0,0,0,,Berikan di sini
Dialog: 0,0:23:47.83,0:23:48.75,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:23:48.83,0:23:50.37,teks umum,,0,0,0,,Anda tidak boleh muat di sini bersama-sama
Dialog: 0,0:23:51.29,0:23:53.13,teks umum,,0,0,0,,Anda hanya akan tidur jika saya bangun
Dialog: 0,0:23:56.80,0:23:57.97,teks umum,,0,0,0,,Bangun
Dialog: 0,0:23:59.05,0:24:00.22,teks umum,,0,0,0,,Dan anda membuat
Dialog: 0,0:24:00.30,0:24:03.18,teks umum,,0,0,0,,Ia tidak sukar
Dialog: 0,0:24:17.28,0:24:19.07,teks umum,,0,0,0,,Saya kata saya rindu awak,
Dialog: 0,0:24:19.15,0:24:22.74,teks umum,,0,0,0,,dan awak kata saya keracunan, jadi saya perlu tidur dan sedar
Dialog: 0,0:24:22.82,0:24:24.83,teks umum,,0,0,0,,Berhenti mengacau saya, sekurang-kurangnya untuk seketika
Dialog: 0,0:24:28.95,0:24:31.62,teks umum,,0,0,0,,Awak cuma nak marah saya
Dialog: 0,0:24:33.00,0:24:35.09,teks umum,,0,0,0,,Saya dah cakap, kalau saya mati, awak pun akan mati
Dialog: 0,0:24:35.88,0:24:38.63,teks umum,,0,0,0,,Saya dalam penderitaan, anda harus merasakan sekurang-kurangnya sesuatu juga
Dialog: 0,0:24:38.71,0:24:41.88,teks umum,,0,0,0,,Apabila saya tidur, saya juga mengalami kekejangan
Dialog: 0,0:24:48.35,0:24:49.81,teks umum,,0,0,0,,Dan untuk berapa lama?
Dialog: 0,0:24:51.02,0:24:51.85,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:24:52.48,0:24:54.11,teks umum,,0,0,0,,Apa? Menyusahkan?
Dialog: 0,0:24:54.73,0:24:56.40,teks umum,,0,0,0,,Kemudian bantu saya menjadikan diri saya lebih selesa
Dialog: 0,0:25:05.62,0:25:09.54,teks umum,,0,0,0,,Pemilik sentiasa tidur
Dialog: 0,0:25:09.62,0:25:12.08,teks umum,,0,0,0,,Suruh dia berlatih
Dialog: 0,0:25:12.16,0:25:14.04,teks umum,,0,0,0,,Kereta api Mages of Jeonjingak sesuka hati
Dialog: 0,0:25:14.13,0:25:17.21,teks umum,,0,0,0,,Setiap orang menguasai tenaganya secara berbeza
Dialog: 0,0:25:17.29,0:25:19.67,teks umum,,0,0,0,,Saya tidak akan campur selagi dia tidak melanggar peraturan
Dialog: 0,0:25:21.09,0:25:22.01,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:25:22.09,0:25:24.47,teks umum,,0,0,0,,Jangan risau. Ini dia
Dialog: 0,0:25:30.47,0:25:33.14,teks umum,,0,0,0,,Saya sakit kepala,
Dialog: 0,0:25:33.23,0:25:34.52,teks umum,,0,0,0,,Saya akan pulang
Dialog: 0,0:25:34.60,0:25:37.11,teks umum,,0,0,0,,dan saya akan sedar, berendam dalam air
Dialog: 0,0:25:39.32,0:25:41.65,teks umum,,0,0,0,,Adakah kepala anda sakit? Awak tak buat apa-apa
Dialog: 0,0:25:42.24,0:25:45.24,teks umum,,0,0,0,,Dan anda tidak boleh pulang ke rumah. Ia tidak mengikut peraturan
Dialog: 0,0:25:45.32,0:25:46.41,teks umum,,0,0,0,,Ya?
Dialog: 0,0:25:46.49,0:25:49.16,teks umum,,0,0,0,,Pengecualian Chan Wook. Dia ada kebenaran ketua
Dialog: 0,0:25:49.74,0:25:50.70,teks umum,,0,0,0,,Kenapa dia?
Dialog: 0,0:25:50.79,0:25:53.79,teks umum,,0,0,0,,Sibuk dengan pelbagai hiburan, anda tiada masa untuk itu,
Dialog: 0,0:25:53.87,0:25:56.79,teks umum,,0,0,0,,tetapi saya membuat perjanjian dengan kepala semasa saya dikunci di sini
Dialog: 0,0:25:59.59,0:26:00.59,teks umum,,0,0,0,,Saya akan kembali tidak lama lagi
Dialog: 0,0:26:05.05,0:26:06.59,teks umum,,0,0,0,,Saya akan ikut dia
Dialog: 0,0:26:08.05,0:26:09.97,teks umum,,0,0,0,,Jika anda pergi, anda akan dihalau keluar dari sini
Dialog: 0,0:26:10.06,0:26:13.35,teks umum,,0,0,0,,Anda berusaha keras untuk sampai ke sini. Adakah anda bersedia untuk pergi begitu sahaja?
Dialog: 0,0:26:23.99,0:26:26.07,teks umum,,0,0,0,,Chan Wook pulang ke rumah
Dialog: 0,0:26:26.16,0:26:27.66,teks umum,,0,0,0,,Adakah anda pasti ini betul?
Dialog: 0,0:26:27.74,0:26:31.08,teks umum,,0,0,0,,Biarkan dia pergi ke mana sahaja dia mahu
Dialog: 0,0:26:32.79,0:26:34.50,teks umum,,0,0,0,,Maka dia akan menjadi malas
Dialog: 0,0:26:35.12,0:26:36.00,contact,,0,0,0,,Bab
Dialog: 0,0:26:39.96,0:26:42.46,teks umum,,0,0,0,,Wanita itu meminta anda menunggu sebentar
Dialog: 0,0:26:43.30,0:26:46.22,teks umum,,0,0,0,,Adakah dia mengacarakan seseorang?
Dialog: 0,0:26:52.39,0:26:55.14,teks umum,,0,0,0,,Saya melihat hamba Jeonbugwan dalam perjalanan ke sini
Dialog: 0,0:26:55.23,0:26:58.31,teks umum,,0,0,0,,Mungkin Timbalan Jin Mu ada di sini?
Dialog: 0,0:26:58.40,0:27:02.98,teks umum,,0,0,0,,Mereka tidak cukup rapat untuk berjumpa seperti itu
Dialog: 0,0:27:04.15,0:27:07.66,teks umum,,0,0,0,,Untuk berjaga-jaga, pergi dan semak siapa yang akan pergi
Dialog: 0,0:27:18.83,0:27:20.46,teks umum,,0,0,0,,Jika Cikgu Li mahu begitu,
Dialog: 0,0:27:20.54,0:27:23.59,teks umum,,0,0,0,,kami akan menyembunyikan "Kata Hati" dalam Jinyeowon
Dialog: 0,0:27:25.34,0:27:28.30,teks umum,,0,0,0,,Adakah anda melihat orang lain hari ini?
Dialog: 0,0:27:29.18,0:27:30.64,teks umum,,0,0,0,,Saudara jauh
Dialog: 0,0:27:32.81,0:27:37.06,teks umum,,0,0,0,,Jin Cho Young akan mewarisi Jinyoung?
Dialog: 0,0:27:39.06,0:27:40.52,teks umum,,0,0,0,,Ini belum diputuskan lagi
Dialog: 0,0:27:41.40,0:27:43.82,teks umum,,0,0,0,,Anak perempuan sulung saya mungkin masih hidup
Dialog: 0,0:27:46.03,0:27:48.24,teks umum,,0,0,0,,Sepuluh tahun telah berlalu sejak itu
Dialog: 0,0:27:49.45,0:27:51.37,teks umum,,0,0,0,,Dan walaupun dia buta,
Dialog: 0,0:27:51.45,0:27:55.41,teks umum,,0,0,0,,dia dapat merasakan tenaga dan mengawal peninggalan seperti orang lain
Dialog: 0,0:27:55.49,0:27:57.20,teks umum,,0,0,0,,Ia adalah seorang kanak-kanak yang sangat pintar
Dialog: 0,0:27:57.29,0:27:58.71,teks umum,,0,0,0,,Tidak seperti kanak-kanak lain,
Dialog: 0,0:27:59.62,0:28:02.92,teks umum,,0,0,0,,dia dilahirkan pada 13 bulan
Dialog: 0,0:28:04.46,0:28:07.92,teks umum,,0,0,0,,Dia dilahirkan pada hari Chang Gang menamakan Gwangju
Dialog: 0,0:28:08.01,0:28:09.47,teks umum,,0,0,0,,diberkati oleh syurga
Dialog: 0,0:28:11.72,0:28:15.47,teks umum,,0,0,0,,Dia lahir pada hari yang Chang Gang pilih untuk awak?
Dialog: 0,0:28:16.93,0:28:18.10,teks umum,,0,0,0,,Adakah mungkin
Dialog: 0,0:28:18.18,0:28:22.23,teks umum,,0,0,0,,pilih tarikh dan masa kelahiran kanak-kanak itu?
Dialog: 0,0:28:23.36,0:28:24.90,teks umum,,0,0,0,,Ia adalah satu kebetulan
Dialog: 0,0:28:26.57,0:28:29.90,teks umum,,0,0,0,,Saya ingin menjemput Master Lee ke Jinyeowon
Dialog: 0,0:28:30.49,0:28:31.78,teks umum,,0,0,0,,Beritahu dia ini
Dialog: 0,0:28:33.03,0:28:34.12,teks umum,,0,0,0,,Okay
Dialog: 0,0:28:49.88,0:28:51.93,kenangan condong,,0,0,0,,Saya menggendongnya selama 13 bulan
Dialog: 0,0:28:52.01,0:28:55.05,kenangan,,0,0,0,,Saya tidak boleh melepaskannya dengan mudah
Dialog: 0,0:28:56.68,0:28:58.56,kenangan,,0,0,0,,Saya dengar batu itu mempunyai kuasa
Dialog: 0,0:28:58.64,0:29:01.56,kenangan,,0,0,0,,menghidupkan kembali jiwa yang telah mati
Dialog: 0,0:29:08.19,0:29:09.32,kenangan,,0,0,0,,Gwangju
Dialog: 0,0:29:11.36,0:29:12.57,kenangan,,0,0,0,,Tolong saya
Dialog: 0,0:29:22.87,0:29:27.50,suara,,0,0,0,,Saya datang sejauh ini untuk melindungi anak saya
Dialog: 0,0:29:38.85,0:29:40.10,teks umum,,0,0,0,,Saya akan cari awak
Dialog: 0,0:29:42.52,0:29:44.69,teks umum,,0,0,0,,Saya akan melakukan yang terbaik,
Dialog: 0,0:29:46.52,0:29:47.86,teks umum,,0,0,0,,untuk mencari anda
Dialog: 0,0:29:59.79,0:30:02.83,teks umum,,0,0,0,,- Adakah anda menyemak siapa tetamu penting ini?\N- Ya
Dialog: 0,0:30:04.37,0:30:07.84,italic,,0,0,0,,Itu Timbalan Jin Mu
Dialog: 0,0:30:10.17,0:30:12.30,teks umum,,0,0,0,,Sejak bila ketua Jinyeowon
Dialog: 0,0:30:12.38,0:30:15.63,teks umum,,0,0,0,, menganggap dia ahli keluarga dan menerima dia?
Dialog: 0,0:30:15.72,0:30:17.55,teks umum,,0,0,0,,Dia keluar secara senyap-senyap melalui pintu pagar belakang
Dialog: 0,0:30:18.30,0:30:21.02,teks umum,,0,0,0,,Jadi pertemuan itu adalah rahsia
Dialog: 0,0:30:22.18,0:30:24.89,teks umum,,0,0,0,,Saya tertanya-tanya apakah helah yang dia gunakan
Dialog: 0,0:30:24.98,0:30:27.94,teks umum,,0,0,0,, Jin Mu yang licin untuk melawat Jinyoewon?
Dialog: 0,0:30:45.29,0:30:48.67,italic,,0,0,0,,Anda buta, jadi anda tidak tahu di mana anda berada
Dialog: 0,0:30:49.79,0:30:52.80,miring,,0,0,0,,Anda akan diam dan melakukan apa yang mereka minta,
Dialog: 0,0:30:53.38,0:30:54.92,contact,,0,0,0,,selamatkan nyawa anda
Dialog: 0,0:30:55.55,0:30:57.38,miring,,0,0,0,,Tiada bunyi
Dialog: 0,0:30:57.47,0:30:58.55,teks umum,,0,0,0,,Bangun
Dialog: 0,0:32:18.88,0:32:20.05,teks umum,,0,0,0,,Duduk
Dialog: 0,0:32:28.31,0:32:30.94,teks umum,,0,0,0,,Tinggalkan dia, yang lain boleh pergi
Dialog: 0,0:32:34.48,0:32:36.73,luar skrin,,0,0,0,,Mereka sedang mencari gadis dari potret itu
Dialog: 0,0:32:36.82,0:32:38.32,luar skrin,,0,0,0,,Rupa-rupanya dia buta
Dialog: 0,0:32:39.36,0:32:42.32,luar skrin,,0,0,0,,Dia kata yang lain boleh pergi, kenapa tiada bunyi?
Dialog: 0,0:33:11.89,0:33:13.40,teks umum,,0,0,0,,Anda boleh lihat
Dialog: 0,0:33:15.98,0:33:18.90,teks umum,,0,0,0,,Sayang sekali. Saya fikir saya telah menemui gadis yang betul
Dialog: 0,0:33:19.44,0:33:20.36,teks umum,,0,0,0,,Bunuh dia
Dialog: 0,0:33:24.24,0:33:25.87,teks umum,,0,0,0,,Saya boleh melakukannya!
Dialog: 0,0:33:27.74,0:33:31.33,teks umum,,0,0,0,,Saya boleh jadi gadis dari potret itu
Dialog: 0,0:33:37.29,0:33:38.50,teks umum,,0,0,0,,Lepaskan saya
Dialog: 0,0:33:39.21,0:33:40.88,teks umum,,0,0,0,,Anda kata saya akan datang
Dialog: 0,0:33:42.09,0:33:43.97,teks umum,,0,0,0,,Jika anda perlu buta,
Dialog: 0,0:33:47.10,0:33:49.18,teks umum,,0,0,0,,maka saya akan menjadi seorang
Dialog: 0,0:34:03.78,0:34:06.99,teks umum,,0,0,0,,Gadis penghibur. bangun
Dialog: 0,0:34:12.91,0:34:15.08,teks umum,,0,0,0,,Jadi awak boleh berpura-pura buta?
Dialog: 0,0:34:15.92,0:34:17.58,teks umum,,0,0,0,,Saya sudah buta
Dialog: 0,0:34:21.13,0:34:23.59,teks umum,,0,0,0,,Nah, mari kita semak
Dialog: 0,0:35:01.96,0:35:04.80,teks umum,,0,0,0,,Nampaknya saya benar-benar menemui apa yang saya perlukan
Dialog: 0,0:35:24.40,0:35:25.86,teks umum,,0,0,0,,Jadi begitu
Dialog: 0,0:35:25.94,0:35:29.95,teks umum,,0,0,0,,Mulai sekarang, anda adalah Jin Bu Young, anak perempuan Jinyoung yang hilang
Dialog: 0,0:35:31.07,0:35:32.12,teks umum,,0,0,0,,Ya
Dialog: 0,0:35:33.29,0:35:35.12,teks umum,,0,0,0,,Saya Jin Bu Young
Dialog: 0,0:35:47.30,0:35:49.30,suara,,0,0,0,,Chan Wook berhenti latihan lagi
Dialog: 0,0:35:53.76,0:35:57.27,suara,,0,0,0,,Bagaimanakah saya harus menghukumnya kali ini?
Dialog: 0,0:36:02.56,0:36:04.73,teks umum,,0,0,0,,Terima kasih kepada saya, anda bekerja keras
Dialog: 0,0:36:09.20,0:36:10.11,teks umum,,0,0,0,,Ya
Dialog: 0,0:36:10.70,0:36:13.95,teks umum,,0,0,0,,Terima kasih kepada anda, saya perlu menyapu halaman sekali lagi
Dialog: 0,0:36:21.38,0:36:22.63,teks umum,,0,0,0,,Adakah anda bertengkar dengan saya?
Dialog: 0,0:36:23.67,0:36:24.84,teks umum,,0,0,0,,Maka saya akan tolong awak pergi
Dialog: 0,0:36:24.92,0:36:26.25,teks umum,,0,0,0,,Anda menipu
Dialog: 0,0:36:26.80,0:36:28.92,teks umum,,0,0,0,,Jika saya bercakap tentang ini, anda akan dibuang dari sini serta-merta
Dialog: 0,0:36:31.22,0:36:32.80,teks umum,,0,0,0,,Maaf, Yang Amat Mulia
Dialog: 0,0:36:33.89,0:36:36.97,teks umum,,0,0,0,,Saya berterima kasih atas daun yang gugur dengan bantuan anda
Dialog: 0,0:36:37.06,0:36:39.60,teks umum,,0,0,0,,Anda boleh terus menggoncang pokok itu
Dialog: 0,0:36:41.40,0:36:43.06,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:36:44.02,0:36:46.48,teks umum,,0,0,0,,untuk jawapan, bukan untuk daun
Dialog: 0,0:36:48.53,0:36:53.45,teks umum,,0,0,0,,Jadi anda tidak datang untuk merungut, tetapi untuk berterima kasih
Dialog: 0,0:36:53.53,0:36:56.24,teks umum,,0,0,0,,Saya mengambil masa yang lama untuk memahami, Yang Amat Mulia
Dialog: 0,0:36:56.33,0:36:58.25,teks umum,,0,0,0,,Saya amat berterima kasih kepada anda
Dialog: 0,0:36:59.04,0:37:02.12,teks umum,,0,0,0,,Sudah tentu anda bersyukur. Saya menulis sendiri jawapannya
Dialog: 0,0:37:03.67,0:37:06.09,teks umum,,0,0,0,,Adakah anda tahu cara mencuci dakwat?
Dialog: 0,0:37:07.46,0:37:10.59,teks umum,,0,0,0,,Adakah anda telah menulis jawapan?
Dialog: 0,0:37:11.22,0:37:14.01,teks umum,,0,0,0,,Ya. Saya Putera Mahkota
Dialog: 0,0:37:14.09,0:37:16.60,teks umum,,0,0,0,,Saya mengetahui bahawa pes beras menghilangkan dakwat
Dialog: 0,0:37:17.22,0:37:20.31,teks umum,,0,0,0,,Malah mencuba sendiri, ia berkesan
Dialog: 0,0:37:21.02,0:37:22.39,teks umum,,0,0,0,,Tiada perkataan
Dialog: 0,0:37:23.98,0:37:26.11,teks umum,,0,0,0,,Saya selamanya berhutang dengan awak
Dialog: 0,0:37:27.69,0:37:28.82,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:37:29.74,0:37:31.24,teks umum,,0,0,0,,Senang dapat bersama tuanmu?
Dialog: 0,0:37:32.65,0:37:34.28,teks umum,,0,0,0,,Saya mendengar dia membaca "Kata-Kata Hati"
Dialog: 0,0:37:34.36,0:37:35.49,teks umum,,0,0,0,,Ya
Dialog: 0,0:37:35.57,0:37:38.95,teks umum,,0,0,0,,Antara ahli silap mata Jeongjingak, dia paling pantas melakukannya
Dialog: 0,0:37:42.08,0:37:44.00,teks umum,,0,0,0,,Tidak mungkin ia hanya bakat dan kemahiran
Dialog: 0,0:37:44.58,0:37:46.25,teks umum,,0,0,0,,Mungkin bertuah lagi
Dialog: 0,0:37:47.29,0:37:50.09,teks umum,,0,0,0,,Tetapi dia mengalahkan kamu dalam pertarungan
Dialog: 0,0:37:53.30,0:37:56.93,teks umum,,0,0,0,,Saya tahu apa yang Chan Wook mampu kerana saya melawannya
Dialog: 0,0:37:58.31,0:38:01.10,teks umum,,0,0,0,,Kemahiran pedang yang lemah, mantera yang lemah
Dialog: 0,0:38:01.18,0:38:04.90,teks umum,,0,0,0,,Dia bernasib baik kerana menggunakan Tansu. Ia bukan tentang kemahiran
Dialog: 0,0:38:06.19,0:38:08.23,di sebalik tabir,,0,0,0,,Dia betul tentang sesuatu
Dialog: 0,0:38:08.98,0:38:12.61,teks umum,,0,0,0,,Jadi dia datang ke Jeonjingak. Menjadi ahli silap mata yang kuat
Dialog: 0,0:38:12.69,0:38:15.82,teks umum,,0,0,0,,Malah, dia tidak mempunyai kemahiran untuk menyertai Jeonjingak
Dialog: 0,0:38:16.49,0:38:19.91,teks umum,,0,0,0,,Jika dia mengalahkan sesiapa di sini,
Dialog: 0,0:38:20.66,0:38:22.29,teks umum,,0,0,0,,Saya mengenalinya
Dialog: 0,0:38:23.58,0:38:26.63,suara,,0,0,0,,Alangkah baiknya menggunakan Putera Mahkota
Dialog: 0,0:38:26.71,0:38:27.79,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:38:28.34,0:38:31.71,teks umum,,0,0,0,,Atau mungkin kita boleh berhujah?
Dialog: 0,0:38:32.55,0:38:33.72,teks umum,,0,0,0,,Bolehkah kita bertaruh?
Dialog: 0,0:38:35.05,0:38:37.18,teks umum,,0,0,0,,Apa yang saya akan dapat daripada berdebat dengan awak?
Dialog: 0,0:38:38.39,0:38:42.22,teks umum,,0,0,0,,Saya akan memberikan anda perkara paling berharga yang saya ada
Dialog: 0,0:38:50.48,0:38:51.86,kenangan condong,,0,0,0,,Saya akan menjadi orang pertama yang memilih
Dialog: 0,0:38:51.94,0:38:53.82,kenangan,,0,0,0,,Saya akan ambil merah, awak ambil biru
Dialog: 0,0:38:59.03,0:39:01.83,kenangan condong,,0,0,0,,Tunggu. Saya akan datang ke sana
Dialog: 0,0:39:02.49,0:39:03.87,kenangan miring,,0,0,0,,Saya juga merindui awak
Dialog: 0,0:39:05.33,0:39:06.67,kenangan,,0,0,0,,Ini jawapan saya
Dialog: 0,0:39:16.76,0:39:18.39,teks umum,,0,0,0,,- Tuan\N- Ya
Dialog: 0,0:39:19.01,0:39:21.10,teks umum,,0,0,0,,Saya membeli kuki kegemaran anda
Dialog: 0,0:39:21.93,0:39:23.39,teks umum,,0,0,0,,Adakah anda tinggal untuk makan tengah hari?
Dialog: 0,0:39:23.47,0:39:25.48,teks umum,,0,0,0,,Saya pulang ke rumah selama beberapa hari
Dialog: 0,0:39:26.43,0:39:29.65,teks umum,,0,0,0,,- Adakah ini boleh?\N- Ketua memberi kebenaran
Dialog: 0,0:39:29.73,0:39:31.98,teks umum,,0,0,0,,Menjadikan saya pengecualian dalam segala hal
Dialog: 0,0:39:32.07,0:39:33.36,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:39:33.44,0:39:36.19,teks umum,,0,0,0,,Anda membaca "Kata Hati" dalam beberapa hari
Dialog: 0,0:39:36.28,0:39:39.45,teks umum,,0,0,0,,Adalah bodoh untuk memaksa anda mengikut peraturan yang sama seperti ahli silap mata biasa
Dialog: 0,0:39:40.49,0:39:42.91,teks umum,,0,0,0,,Adakah anda gembira dengan kejayaan saya?
Dialog: 0,0:39:42.99,0:39:44.83,teks umum,,0,0,0,,Saya bukan sekadar gembira
Dialog: 0,0:39:44.91,0:39:47.21,teks umum,,0,0,0,,Anda tidak tahu betapa bangganya saya
Dialog: 0,0:39:49.04,0:39:50.46,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,0:39:50.54,0:39:54.17,teks umum,,0,0,0,,Saya sentiasa mengecewakan anda, dan kini anda boleh berbangga
Dialog: 0,0:39:54.25,0:39:57.09,teks umum,,0,0,0,, Patutkah saya belikan awak gaun yang cantik?
Dialog: 0,0:39:57.17,0:39:58.59,teks umum,,0,0,0,,Anda lihat
Dialog: 0,0:39:58.68,0:40:02.72,teks umum,,0,0,0,,Saya tidak perlukan apa-apa. Saya rasa saya ada segalanya
Dialog: 0,0:40:03.97,0:40:05.43,teks umum,,0,0,0,,Orang datang
Dialog: 0,0:40:05.52,0:40:08.94,teks umum,,0,0,0,,dan mereka memberitahu saya bahawa anda adalah anak bapa anda
Dialog: 0,0:40:10.77,0:40:11.77,teks umum,,0,0,0,,Ya?
Dialog: 0,0:40:12.36,0:40:14.65,teks umum,,0,0,0,,Ayah kamu digelar genius
Dialog: 0,0:40:14.73,0:40:18.24,teks umum,,0,0,0,,Dan kini mereka mengatakan bahawa anda berbakat seperti bapa anda
Dialog: 0,0:40:20.24,0:40:22.62,teks umum,,0,0,0,,Orang berkata bahawa saya tidak kelihatan seperti dia sama sekali
Dialog: 0,0:40:25.99,0:40:27.62,teks umum,,0,0,0,,Anda akan membuat kemajuan,
Dialog: 0,0:40:28.29,0:40:31.96,teks umum,,0,0,0,,dan orang tidak akan mengatakan apa-apa seperti itu tentang anda lagi
Dialog: 0,0:40:32.04,0:40:35.21,teks umum,,0,0,0,,Bagaimana jika tiada kejayaan? Adakah mereka akan mula menyebarkan khabar angin lagi?
Dialog: 0,0:40:37.09,0:40:38.21,teks umum,,0,0,0,,Tidak, bukan begitu...
Dialog: 0,0:40:39.55,0:40:42.64,teks umum,,0,0,0,,Beritahu mereka bahawa mereka bebas untuk mengatakan apa sahaja yang mereka mahu
Dialog: 0,0:40:42.72,0:40:44.01,teks umum,,0,0,0,,Ia tidak mengganggu saya lagi
Dialog: 0,0:40:45.06,0:40:47.89,teks umum,,0,0,0,,Ya. Anda tidak boleh risau tentang perkara ini lagi
Dialog: 0,0:40:49.94,0:40:54.90,teks umum,,0,0,0,,Dan selain itu, kejayaan anda adalah merit anda
Dialog: 0,0:40:54.98,0:40:56.36,teks umum,,0,0,0,,Bapak di sini sebelah mana?
Dialog: 0,0:40:57.07,0:40:59.44,teks umum,,0,0,0,,Dia tidak pernah ada
Dialog: 0,0:41:00.03,0:41:03.70,teks umum,,0,0,0,,Dan secara umum, semuanya kerana saya
Dialog: 0,0:41:03.78,0:41:05.16,teks umum,,0,0,0,,membesarkan anda dengan baik
Dialog: 0,0:41:11.96,0:41:15.00,teks umum,,0,0,0,,Anda akan sentiasa menjadi tuan saya,
Dialog: 0,0:41:15.92,0:41:18.55,teks umum,,0,0,0,,dengan atau tanpa kejayaan
Dialog: 0,0:41:20.01,0:41:21.05,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:41:22.55,0:41:26.05,teks umum,,0,0,0,, Kemudian anda boleh pulang ke rumah dan bermalas-malasan?
Dialog: 0,0:41:27.81,0:41:29.77,teks umum,,0,0,0,,Ya, jika anda mahukannya
Dialog: 0,0:41:30.56,0:41:33.02,teks umum,,0,0,0,,Tetapi saya fikir awak membencinya
Dialog: 0,0:41:34.56,0:41:38.23,teks umum,,0,0,0,,Jika anda bandingkan semasa anda pulang dari Danhyangok,
Dialog: 0,0:41:38.32,0:41:41.53,teks umum,,0,0,0,,kelihatan jauh lebih gembira berbanding ketika mereka baru sahaja
Dialog: 0,0:41:42.53,0:41:44.16,teks umum,,0,0,0,,bertenang di rumah
Dialog: 0,0:41:45.49,0:41:48.41,teks umum,,0,0,0,,Itulah sebabnya saya tidak dapat menghalang anda, walaupun semua bahaya
Dialog: 0,0:41:49.04,0:41:50.08,teks umum,,0,0,0,,Saya mahu,
Dialog: 0,0:41:50.62,0:41:55.42,teks umum,,0,0,0,,supaya anda berjaya dalam apa sahaja yang anda pilih untuk diri sendiri
Dialog: 0,0:41:58.04,0:41:59.17,teks umum,,0,0,0,,Ya
Dialog: 0,0:42:03.17,0:42:04.51,teks umum,,0,0,0,,Saya mesti kembali
Dialog: 0,0:42:05.59,0:42:07.26,teks umum,,0,0,0,,Adakah anda akan pergi?
Dialog: 0,0:42:07.35,0:42:10.89,teks umum,,0,0,0,,Ya. Jika anda meminta saya pergi, saya akan melakukan sebaliknya
Dialog: 0,0:42:10.97,0:42:13.06,teks umum,,0,0,0,,Tetapi selepas ucapan sedemikian, kita perlu kembali
Dialog: 0,0:42:13.14,0:42:16.77,teks umum,,0,0,0,,Saya mesti melakukan segala yang mungkin untuk membuat anda bangga
Dialog: 0,0:42:18.23,0:42:20.53,teks umum,,0,0,0,,Dan kepala? Tak sakit lagi ke?
Dialog: 0,0:42:21.23,0:42:22.36,teks umum,,0,0,0,,Tidak
Dialog: 0,0:42:23.24,0:42:25.24,teks umum,,0,0,0,,Orang apa, kuda apa
Dialog: 0,0:42:25.32,0:42:27.57,teks umum,,0,0,0,,ajar dengan lobak merah dan batang kayu
Dialog: 0,0:42:28.78,0:42:31.87,teks umum,,0,0,0,,Mereka hanya menyebat saya
Dialog: 0,0:42:32.45,0:42:35.33,teks umum,,0,0,0,,Siapa yang berani pukul awak?
Dialog: 0,0:42:35.42,0:42:37.88,teks umum,,0,0,0,,Jangan risau, saya tidak akan berdiri di situ sahaja semasa mereka mengalahkan saya
Dialog: 0,0:42:39.84,0:42:41.34,teks umum,,0,0,0,, Bungkus saya gula-gula
Dialog: 0,0:42:41.42,0:42:42.84,teks umum,,0,0,0,,Sekumpulan kuki
Dialog: 0,0:42:43.80,0:42:46.51,teks umum,,0,0,0,,- Seronok\N- Adakah anda pasti?
Dialog: 0,0:42:47.59,0:42:48.68,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:42:49.97,0:42:51.10,teks umum,,0,0,0,,Anda akhirnya di sini
Dialog: 0,0:42:51.81,0:42:52.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:42:53.02,0:42:55.81,teks umum,,0,0,0,,Rasanya anda semua sedang menunggu saya
Dialog: 0,0:42:56.44,0:42:58.90,teks umum,,0,0,0,,Adakah semua orang mahukan kuki yang saya bawa?
Dialog: 0,0:42:58.98,0:43:02.07,teks umum,,0,0,0,,Pergi ke bilik latihan. Ia akan menjadi menyeronokkan
Dialog: 0,0:43:13.54,0:43:15.62,teks umum,,0,0,0,,- Adakah anda menunggu saya?\N- Ya
Dialog: 0,0:43:15.71,0:43:18.46,teks umum,,0,0,0,,Saya akan menjadi lawan pertama kamu
Dialog: 0,0:43:19.96,0:43:20.79,teks umum,,0,0,0,,Apa?
Dialog: 0,0:43:21.54,0:43:23.34,teks umum,,0,0,0,,Mari kita mulakan perjuangan
Dialog: 0,0:43:24.09,0:43:26.13,teks umum,,0,0,0,,Jika anda menolak, anda kalah
Dialog: 0,0:43:27.01,0:43:28.47,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:43:32.47,0:43:34.10,teks umum,,0,0,0,,Ambil
Dialog: 0,0:44:03.63,0:44:04.71,italic,,0,0,0,,Chan Wook kalah
Dialog: 0,0:44:06.51,0:44:09.43,teks umum,,0,0,0,,Gyo Ho, pemenang, boleh mengambil katak emasnya
Dialog: 0,0:44:37.29,0:44:38.66,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:44:38.75,0:44:40.00,teks umum,,0,0,0,,Saya bertaruh
Dialog: 0,0:44:40.08,0:44:42.38,teks umum,,0,0,0,,Saya tidak berdebat dengan tuan tentang apa-apa, Yang Amat Mulia
Dialog: 0,0:44:42.46,0:44:45.21,teks umum,,0,0,0,,Bukan dengan awak, dengan pembantu rumah awak
Dialog: 0,0:44:49.30,0:44:52.51,teks umum,,0,0,0,,Saya memberitahunya bahawa anda tidak boleh mengalahkan seorang ahli silap mata di sini
Dialog: 0,0:44:52.59,0:44:53.97,teks umum,,0,0,0,,anda tidak boleh
Dialog: 0,0:44:54.05,0:44:57.06,teks umum,,0,0,0,,Dan pembantu rumah kamu berkata bahawa kamu akan mengalahkan sekurang-kurangnya satu
Dialog: 0,0:44:57.97,0:44:59.81,teks umum,,0,0,0,,Mu Dok cakap macam tu?
Dialog: 0,0:45:01.77,0:45:04.11,teks umum,,0,0,0,,Anda akan bertarung setiap hari selama sepuluh hari
Dialog: 0,0:45:04.19,0:45:06.02,teks umum,,0,0,0,,Jika anda tidak pernah menang,
Dialog: 0,0:45:06.11,0:45:08.57,teks umum,,0,0,0,,dia akan memberikan saya perkara paling berharga yang dia ada
Dialog: 0,0:45:10.28,0:45:11.36,teks umum,,0,0,0,, Sayang?
Dialog: 0,0:45:12.53,0:45:14.24,teks umum,,0,0,0,,Apakah yang sangat berharga bagi anda?
Dialog: 0,0:45:14.87,0:45:16.62,teks umum,,0,0,0,,Apa yang anda berikan kepada saya
Dialog: 0,0:45:18.70,0:45:20.16,teks umum,,0,0,0,,Ia dipertaruhkan
Dialog: 0,0:45:29.67,0:45:32.30,teks umum,,0,0,0,,Jed ini kelihatan mahal, saya mahukannya untuk diri saya sendiri
Dialog: 0,0:45:34.51,0:45:36.30,teks umum,,0,0,0,,Jadi saya membawa kodok emas
Dialog: 0,0:45:36.39,0:45:37.97,teks umum,,0,0,0,,sebagai hadiah
Dialog: 0,0:45:44.65,0:45:48.44,teks umum,,0,0,0,,Jika anda tidak menang sebelum kodok berakhir,
Dialog: 0,0:45:48.52,0:45:49.94,teks umum,,0,0,0,,ini akan menjadi milik saya
Dialog: 0,0:45:50.57,0:45:52.82,teks umum,,0,0,0,,Saya kurang berminat dengan pertikaian sedemikian
Dialog: 0,0:45:53.66,0:45:56.41,teks umum,,0,0,0,,Saya tidak berdebat dengan awak, tetapi dengan dia
Dialog: 0,0:45:58.16,0:45:59.49,teks umum,,0,0,0,,Jika anda berputus asa,
Dialog: 0,0:45:59.58,0:46:02.08,teks umum,,0,0,0,,yang bermaksud dia tidak memenangi satu pertarungan, yang bermaksud dia kalah
Dialog: 0,0:46:02.96,0:46:04.08,teks umum,,0,0,0,,Dan ini akan menjadi milik saya
Dialog: 0,0:46:08.80,0:46:09.92,teks umum,,0,0,0,,Hos
Dialog: 0,0:46:11.17,0:46:13.84,teks umum,,0,0,0,,Ini adalah perkara paling berharga yang saya terima
Dialog: 0,0:46:15.80,0:46:19.31,teks umum,,0,0,0,,Sila bawa dia balik
Dialog: 0,0:46:30.44,0:46:31.48,teks umum,,0,0,0,,Tonton lagi
Dialog: 0,0:46:32.11,0:46:33.74,teks umum,,0,0,0,,Anda benar-benar mendapat katak emas
Dialog: 0,0:46:33.82,0:46:37.37,teks umum,,0,0,0,,Biar Uk baca "Kata Hati",
Dialog: 0,0:46:37.45,0:46:39.78,teks umum,,0,0,0,,- tetapi dia tidak menggunakan pedang dengan baik\N- Apa yang berlaku?
Dialog: 0,0:46:41.70,0:46:44.54,teks umum,,0,0,0,,Putera dan Moo Deok berhujah
Dialog: 0,0:46:45.54,0:46:48.84,teks umum,,0,0,0,,Putera Mahkota membawa kodok emas, jadi semua orang mahu mengambil bahagian
Dialog: 0,0:46:50.25,0:46:53.17,teks umum,,0,0,0,,Barisan ahli silap mata yang kuat
Dialog: 0,0:46:55.17,0:46:56.80,teks umum,,0,0,0,,Letakkan
Dialog: 0,0:47:04.23,0:47:06.73,teks umum,,0,0,0,,Yang Mulia mentertawakan anda
Dialog: 0,0:47:07.27,0:47:09.27,teks umum,,0,0,0,,Sebagai guru kamu, saya tidak boleh berdiam diri
Dialog: 0,0:47:09.36,0:47:12.28,teks umum,,0,0,0,,Jangan berbohong. saya kenal awak
Dialog: 0,0:47:13.53,0:47:15.24,teks umum,,0,0,0,,Saya malas beberapa hari ini,
Dialog: 0,0:47:15.32,0:47:17.70,teks umum,,0,0,0,,jadi anda membuat taruhan untuk saya berlatih
Dialog: 0,0:47:20.20,0:47:21.12,teks umum,,0,0,0,,Ya
Dialog: 0,0:47:22.66,0:47:26.96,teks umum,,0,0,0,,Anda perlu bertarung dengan sedozen ahli silap mata, sama ada anda suka atau tidak
Dialog: 0,0:47:28.46,0:47:31.63,teks umum,,0,0,0,,Pertarungan pertama lebih mengecewakan
Dialog: 0,0:47:32.25,0:47:34.34,teks umum,,0,0,0,,Langkahnya berat, kamu gerakkan pedang perlahan-lahan
Dialog: 0,0:47:34.42,0:47:37.68,teks umum,,0,0,0,,- Esok bertanding dengan...\N- Saya menolak
Dialog: 0,0:47:40.97,0:47:43.26,teks umum,,0,0,0,,Walaupun anda kalah, anda akan ingat apa yang anda lihat,
Dialog: 0,0:47:43.35,0:47:44.56,teks umum,,0,0,0,,ini akan membantu anda
Dialog: 0,0:47:44.64,0:47:47.64,teks umum,,0,0,0,,- Saya tidak akan melawan\N- Sepuluh pergaduhan -
Dialog: 0,0:47:47.73,0:47:50.23,teks umum,,0,0,0,,sepuluh gaya berbeza
Dialog: 0,0:47:51.06,0:47:52.57,teks umum,,0,0,0,,- Mu Dok...\N- Cikgu,
Dialog: 0,0:47:52.65,0:47:54.82,teks umum,,0,0,0,,anda boleh pulang dengan selamat untuk berendam
Dialog: 0,0:47:54.90,0:47:57.20,teks umum,,0,0,0,,Maka kamu tidak akan mengembalikan jed itu
Dialog: 0,0:47:58.78,0:47:59.91,teks umum,,0,0,0,,Okay, okay
Dialog: 0,0:48:00.95,0:48:02.53,teks umum,,0,0,0,,Anda bertaruh
Dialog: 0,0:48:03.12,0:48:04.12,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:48:05.29,0:48:07.00,teks umum,,0,0,0,,Kenapa awak letak hadiah saya?
Dialog: 0,0:48:07.71,0:48:08.83,teks umum,,0,0,0,,Anda tahu
Dialog: 0,0:48:09.33,0:48:12.79,teks umum,,0,0,0,,Ini adalah satu-satunya cara untuk membuat anda bertarung dan menang
Dialog: 0,0:48:15.55,0:48:16.71,teks umum,,0,0,0,,Apabila saya berkata bahawa saya merindui awak,
Dialog: 0,0:48:16.80,0:48:19.34,teks umum,,0,0,0,, adakah ini yang anda maksudkan dengan kelemahan saya?
Dialog: 0,0:48:22.18,0:48:23.30,teks umum,,0,0,0,,Ya
Dialog: 0,0:48:24.68,0:48:26.47,teks umum,,0,0,0,,Anda mungkin benci saya sekarang,
Dialog: 0,0:48:27.68,0:48:30.52,teks umum,,0,0,0,,tetapi anda tidak boleh kehilangan apa yang menjadi milik kita berdua
Dialog: 0,0:48:35.32,0:48:37.61,teks umum,,0,0,0,,Adakah itu sebab awak kata saya diracun?
Dialog: 0,0:48:37.69,0:48:39.99,teks umum,,0,0,0,,Jika awak pulangkan dia, saya akan senyum lebar kepada awak
Dialog: 0,0:48:40.91,0:48:42.28,teks umum,,0,0,0,,Bukan penawar
Dialog: 0,0:48:46.79,0:48:47.91,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:48:49.25,0:48:50.75,teks umum,,0,0,0,,Kembalikan dalam apa jua cara
Dialog: 0,0:48:51.83,0:48:54.21,teks umum,,0,0,0,,Ini adalah perkara paling berharga yang pernah saya miliki
Dialog: 0,0:48:55.67,0:48:57.30,teks umum,,0,0,0,,diterima sepanjang hidup saya
Dialog: 0,0:49:00.01,0:49:01.55,teks umum,,0,0,0,,Adakah dia benar-benar sayang kepada anda?
Dialog: 0,0:49:02.43,0:49:03.68,teks umum,,0,0,0,,Atau...
Dialog: 0,0:49:05.14,0:49:06.64,teks umum,,0,0,0,, adakah ia sangat mahal?
Dialog: 0,0:49:12.19,0:49:14.23,teks umum,,0,0,0,,Saya akan mengambilnya daripada Putera Mahkota
Dialog: 0,0:49:15.15,0:49:17.19,teks umum,,0,0,0,,Pelik mempunyai persamaan dengannya
Dialog: 0,0:49:24.24,0:49:26.49,teks umum,,0,0,0,,Tetapi ia tidak berbaloi untuk dikongsi dengan anda juga
Dialog: 0,0:49:48.35,0:49:50.98,teks umum,,0,0,0,,Saya dengar awak sering melawat Saejukwon
Dialog: 0,0:49:51.60,0:49:54.81,teks umum,,0,0,0,,Mungkin anda ingin melantik Cikgu Huo sebagai guru anda
Dialog: 0,0:49:55.40,0:49:57.65,teks umum,,0,0,0,,dan belajar sihir daripada dia?
Dialog: 0,0:49:58.94,0:50:00.15,teks umum,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:50:00.90,0:50:02.74,teks umum,,0,0,0,,Anda adalah guru saya
Dialog: 0,0:50:03.82,0:50:05.57,italic,,0,0,0,,Saya hanya pergi ke sana untuk rawatan
Dialog: 0,0:50:05.66,0:50:09.29,teks umum,,0,0,0,,Menghirup udara segar. Tambahan pula, perkara lucu sering berlaku di sana
Dialog: 0,0:50:09.37,0:50:13.04,teks umum,,0,0,0,,Anda mesti menikmati menghabiskan masa dengan ahli silap mata Sosnovy Bor
Dialog: 0,0:50:13.12,0:50:15.29,teks umum,,0,0,0,,Saya bercakap dengan Yul, sepupu saya
Dialog: 0,0:50:15.37,0:50:17.54,teks umum,,0,0,0,,Park Dan Gu juga menyeronokkan
Dialog: 0,0:50:17.63,0:50:20.88,teks umum,,0,0,0,,Ah Chang Wook... Saya ingin memberi pengajaran kepadanya, tetapi ia tidak semudah itu
Dialog: 0,0:50:21.42,0:50:23.97,teks umum,,0,0,0,,Dia nampaknya gembira kerana membaca “Kata-Kata Hati”
Dialog: 0,0:50:24.05,0:50:26.01,teks umum,,0,0,0,,jadi hari ini saya meletakkannya di tempatnya
Dialog: 0,0:50:26.09,0:50:28.60,miring,,0,0,0,,Dia kalah kepada ahli silap mata yang baru menguasai Ryusu
Dialog: 0,0:50:28.68,0:50:30.81,teks umum,,0,0,0,,Sekarang orang tahu kuasanya yang sebenar
Dialog: 0,0:50:30.89,0:50:32.60,teks umum,,0,0,0,,Tiada siapa yang mengaguminya lagi
Dialog: 0,0:50:39.61,0:50:40.94,teks umum,,0,0,0,,Jed yang cantik
Dialog: 0,0:50:41.65,0:50:43.82,teks umum,,0,0,0,,Saya menukarnya dengan sepuluh ekor kodok emas
Dialog: 0,0:50:44.82,0:50:47.62,teks umum,,0,0,0,,- Adakah dia begitu berharga?\N- Dia mempunyai tenaga Yin
Dialog: 0,0:50:48.32,0:50:50.24,teks umum,,0,0,0,,Di manakah separuh masa kedua?
Dialog: 0,0:50:50.33,0:50:51.37,teks umum,,0,0,0,,Separuh masa kedua?
Dialog: 0,0:50:51.45,0:50:53.87,teks umum,,0,0,0,,Objek dengan tenaga bertentangan sentiasa mempunyai pasangan
Dialog: 0,0:50:53.96,0:50:56.21,contact,,0,0,0,,Mesti ada jed merah
Dialog: 0,0:50:56.96,0:50:59.09,teks umum,,0,0,0,,Mereka hanya mempunyai nilai secara berpasangan
Dialog: 0,0:51:03.84,0:51:05.59,italic,,0,0,0,,Jadi dia ada dating?
Dialog: 0,0:51:06.09,0:51:07.26,teks umum,,0,0,0,,Kasim O
Dialog: 0,0:51:08.05,0:51:10.60,teks umum,,0,0,0,,Jika orang telah memasangkan sesuatu, apakah maksudnya?
Dialog: 0,0:51:10.68,0:51:12.77,teks umum,,0,0,0,,Ini bermakna mereka sudah berkahwin atau berkencan
Dialog: 0,0:51:15.23,0:51:16.69,teks umum,,0,0,0,,Sial
Dialog: 0,0:51:17.31,0:51:20.36,teks umum,,0,0,0,,Anda tidak suka jed ini, Yang Amat Mulia?
Dialog: 0,0:51:20.44,0:51:23.86,teks umum,,0,0,0,,Ya, dia marahkan saya. Mengganggu saya
Dialog: 0,0:51:24.36,0:51:27.28,teks umum,,0,0,0,,Ambil dan pecahkan kepada kepingan kecil
Dialog: 0,0:51:27.36,0:51:29.99,miring,,0,0,0,,Anda tidak boleh berbuat demikian
Dialog: 0,0:51:30.07,0:51:31.74,teks umum,,0,0,0,,Chan Wook boleh memenanginya semula
Dialog: 0,0:51:34.20,0:51:36.00,teks umum,,0,0,0,,Jika dia mengembalikannya,
Dialog: 0,0:51:36.87,0:51:38.29,teks umum,,0,0,0,,maka mereka akan menjadi pasangan semula
Dialog: 0,0:51:39.71,0:51:40.88,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:51:53.18,0:51:54.35,miring,,0,0,0,,- Cikgu Li\N{\i0}- Ya...
Dialog: 0,0:51:57.48,0:51:59.94,teks umum,,0,0,0,,Apa yang membawa anda ke sini?
Dialog: 0,0:52:02.27,0:52:04.98,teks umum,,0,0,0,,Saya memakai pakaian rami sepanjang tahun dan tidak pernah berasa sejuk
Dialog: 0,0:52:05.82,0:52:06.65,miring,,0,0,0,,Tetapi
Dialog: 0,0:52:07.65,0:52:09.36,teks umum,,0,0,0,,berbaloi memakai selendang ini,
Dialog: 0,0:52:10.24,0:52:12.41,teks umum,,0,0,0,,Saya sedar betapa sejuknya saya
Dialog: 0,0:52:14.91,0:52:16.54,teks umum,,0,0,0,,Apa yang ada di sana?
Dialog: 0,0:52:19.12,0:52:20.12,teks umum,,0,0,0,,Apa...
Dialog: 0,0:52:25.00,0:52:28.67,teks umum,,0,0,0,,Tidak pernah dalam hidup saya bunga kelihatan indah bagi saya,
Dialog: 0,0:52:30.09,0:52:33.89,teks umum,,0,0,0,,tetapi sebaik sahaja saya melihat ini, saya ingin memberikannya kepada anda
Dialog: 0,0:52:41.15,0:52:42.69,teks umum,,0,0,0,,Beauty
Dialog: 0,0:52:43.69,0:52:46.23,teks umum,,0,0,0,,Adakah ini untuk saya?
Dialog: 0,0:52:53.66,0:52:55.99,teks umum,,0,0,0,,Buku-buku ini...
Dialog: 0,0:52:56.08,0:52:57.45,teks umum,,0,0,0,,Anda mempunyai buku yang bagus di sini
Dialog: 0,0:52:58.62,0:53:00.37,teks umum,,0,0,0,,Buku Cemerlang
Dialog: 0,0:53:07.42,0:53:08.92,teks umum,,0,0,0,,Maiden Kim...
Dialog: 0,0:53:10.01,0:53:11.18,teks umum,,0,0,0,,sakit?
Dialog: 0,0:53:11.26,0:53:13.30,teks umum,,0,0,0,,Dia sudah lama tidak muncul dalam Sosnovy Bor
Dialog: 0,0:53:13.39,0:53:14.93,teks umum,,0,0,0,,Dia pergi ke sana semalam
Dialog: 0,0:53:15.55,0:53:17.64,miring,,0,0,0,,Dia sering melawat Encik Chan
Dialog: 0,0:53:18.72,0:53:19.89,teks umum,,0,0,0,,Begini caranya
Dialog: 0,0:53:22.02,0:53:24.48,teks umum,,0,0,0,,Dia tidak datang berjumpa saya
Dialog: 0,0:53:26.52,0:53:28.78,teks umum,,0,0,0,,Dia mempunyai tetamu sekarang
Dialog: 0,0:53:28.86,0:53:30.65,teks umum,,0,0,0,,Tetamu? WHO?
Dialog: 0,0:53:30.74,0:53:34.16,teks umum,,0,0,0,,Saya tidak kenal dia, tetapi dia seorang lelaki muda
Dialog: 0,0:53:34.95,0:53:36.37,teks umum,,0,0,0,,Anak muda?
Dialog: 0,0:53:37.37,0:53:41.04,teks umum,,0,0,0,,Setahu saya, pembantu rumah Kim tidak mengenali mana-mana lelaki muda
Dialog: 0,0:53:50.97,0:53:52.59,contact,,0,0,0,,Maiden Kim
Dialog: 0,0:53:58.18,0:53:59.52,teks umum,,0,0,0,,Helo
Dialog: 0,0:54:01.35,0:54:03.06,teks umum,,0,0,0,,Apakah jenis rumpai ini?
Dialog: 0,0:54:03.14,0:54:04.94,teks umum,,0,0,0,,Ini adalah bunga
Dialog: 0,0:54:05.81,0:54:08.02,teks umum,,0,0,0,,- Apa lagi rumpai?{\i1}\N- Maid Kim
Dialog: 0,0:54:08.52,0:54:12.11,teks umum,,0,0,0,,Adakah anda tersinggung kerana saya kurang ajar pada hari itu?
Dialog: 0,0:54:12.90,0:54:14.41,teks umum,,0,0,0,,Jadi mereka berhenti datang?
Dialog: 0,0:54:15.45,0:54:18.95,italic,,0,0,0,,Saya betul-betul tidak tahu. Fikir awak sakit
Dialog: 0,0:54:19.03,0:54:21.08,teks umum,,0,0,0,,Saya bimbang dan datang ke sini
Dialog: 0,0:54:21.16,0:54:22.87,teks umum,,0,0,0,,Anda tidak sepatutnya datang
Dialog: 0,0:54:23.50,0:54:25.58,teks umum,,0,0,0,,Awak kata awak takkan datang ke sini
Dialog: 0,0:54:25.67,0:54:27.67,teks umum,,0,0,0,,Bila saya berkata begitu?
Dialog: 0,0:54:27.75,0:54:29.17,teks umum,,0,0,0,,Anda salah
Dialog: 0,0:54:30.59,0:54:32.17,miring,,0,0,0,,Tetapi masih
Dialog: 0,0:54:32.26,0:54:34.55,teks umum,,0,0,0,,Saya gembira anda sihat
Dialog: 0,0:54:40.43,0:54:42.60,teks umum,,0,0,0,,Jika mereka sangat bimbang tentang kesihatan saya,
Dialog: 0,0:54:43.77,0:54:46.73,teks umum,,0,0,0,,sekurang-kurangnya mereka boleh membawa rumpai
Dialog: 0,0:54:46.81,0:54:48.65,teks umum,,0,0,0,,Adakah anda memerlukan rumpai?
Dialog: 0,0:54:49.23,0:54:50.36,teks umum,,0,0,0,,Saya akan bawa mereka
Dialog: 0,0:54:52.11,0:54:53.82,teks umum,,0,0,0,,Saya tidak memerlukannya
Dialog: 0,0:54:53.90,0:54:57.91,teks umum,,0,0,0,,Saya tidak meminta anda untuk rumpai, tetapi untuk bunga
Dialog: 0,0:55:00.03,0:55:01.62,miring,,0,0,0,,Saya mahu anda tunjukkan
Dialog: 0,0:55:01.70,0:55:03.29,teks umum,,0,0,0,,kebimbangan anda,
Dialog: 0,0:55:04.37,0:55:06.17,teks umum,,0,0,0,,memberi saya sesuatu yang indah
Dialog: 0,0:55:12.96,0:55:16.05,teks umum,,0,0,0,,Tetamu saya masih di sini, lebih baik awak pergi
Dialog: 0,0:55:17.22,0:55:18.47,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:55:19.30,0:55:20.51,teks umum,,0,0,0,,Nah...
Dialog: 0,0:55:21.81,0:55:25.39,teks umum,,0,0,0,,Apabila anda datang melawat Uka,
Dialog: 0,0:55:27.19,0:55:29.73,teks umum,,0,0,0,,harap anda akan datang berjumpa saya
Dialog: 0,0:55:32.53,0:55:34.49,teks umum,,0,0,0,,Berhenti...
Dialog: 0,0:55:38.24,0:55:39.99,teks umum,,0,0,0,,Mendorong saya kerana,
Dialog: 0,0:55:41.16,0:55:43.20,teks umum,,0,0,0,, bahawa saya datang dengan tangan kosong?
Dialog: 0,0:55:44.87,0:55:46.08,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:55:48.33,0:55:49.75,teks umum,,0,0,0,,Betapa berdarah dingin
Dialog: 0,0:56:14.61,0:56:17.44,teks umum,,0,0,0,,Oleh kerana kasutnya lebih kecil daripada kasut saya,
Dialog: 0,0:56:18.90,0:56:20.78,teks umum,,0,0,0,,itu bermakna dia lebih pendek
Dialog: 0,0:56:35.63,0:56:37.92,teks umum,,0,0,0,,Adakah anda suka gula-gula?
Dialog: 0,0:56:38.01,0:56:38.88,teks umum,,0,0,0,,Ya
Dialog: 0,0:56:45.22,0:56:46.39,teks umum,,0,0,0,,Sedap
Dialog: 0,0:56:47.64,0:56:49.44,teks umum,,0,0,0,,Kemudian ambil
Dialog: 0,0:56:51.40,0:56:52.52,teks umum,,0,0,0,,Ini untuk saya
Dialog: 0,0:57:06.95,0:57:09.00,teks umum,,0,0,0,,- Bagaimana rupa saya?\N- Sangat cantik
Dialog: 0,0:57:09.08,0:57:10.75,teks umum,,0,0,0,,- Cuba pada\N- Saya?
Dialog: 0,0:57:10.83,0:57:11.75,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:57:11.83,0:57:13.71,teks umum,,0,0,0,,Mereka gantung dia di sini
Dialog: 0,0:57:26.76,0:57:30.56,teks umum,,0,0,0,,Lihat, bunga
Dialog: 0,0:57:31.23,0:57:33.27,teks umum,,0,0,0,,Awak cakap yang awak patut beli bunga
Dialog: 0,0:57:33.35,0:57:36.57,teks umum,,0,0,0,,saya perlu menghiasi bilik Boo Young unnie dengan mereka
Dialog: 0,0:57:38.07,0:57:41.86,teks umum,,0,0,0,,Kali ini, nampaknya, mereka menemuinya
Dialog: 0,0:57:49.20,0:57:52.08,teks umum,,0,0,0,,Betulkah? Adakah Jin Mu menjumpainya?
Dialog: 0,0:57:53.54,0:57:55.08,teks umum,,0,0,0,,Ia masih rahsia
Dialog: 0,0:57:56.25,0:57:59.42,teks umum,,0,0,0,,saya harap unnie kembali
Dialog: 0,0:57:59.51,0:58:03.26,teks umum,,0,0,0,,Maka kamu tidak akan menjadi Jinyowon
Dialog: 0,0:58:03.34,0:58:06.55,teks umum,,0,0,0,,Tetapi saya boleh berkahwin dengan yang saya mahu
Dialog: 0,0:58:07.68,0:58:10.93,teks umum,,0,0,0,,Anda boleh berkahwin dengan orang yang anda sayangi
Dialog: 0,0:58:13.44,0:58:14.77,teks umum,,0,0,0,,Gembira mendengar
Dialog: 0,0:58:16.73,0:58:19.27,teks umum,,0,0,0,,Maka kita perlu memutuskan pertunangan palsu kita
Dialog: 0,0:58:19.36,0:58:22.74,teks umum,,0,0,0,,Terima kasih kerana berpura-pura menjadi tunangan saya
Dialog: 0,0:58:25.41,0:58:26.87,teks umum,,0,0,0,,Saya tidak berpura-pura
Dialog: 0,0:58:28.66,0:58:29.79,contact,,0,0,0,,Perasaan saya
Dialog: 0,0:58:31.29,0:58:32.75,teks umum,,0,0,0,,ikhlas
Dialog: 0,0:58:36.42,0:58:37.84,contact,,0,0,0,,Anda akan menjadi ketua tidak lama lagi
Dialog: 0,0:58:37.92,0:58:41.71,teks umum,,0,0,0,,Sudikah awak berkahwin dengan saya? Adakah anda akan menyertai keluarga kami dan meninggalkan segala-galanya?
Dialog: 0,0:58:43.01,0:58:44.13,teks umum,,0,0,0,,Ya
Dialog: 0,0:58:44.97,0:58:46.68,teks umum,,0,0,0,,Saya rasa saya bimbang untuk apa-apa
Dialog: 0,0:58:46.76,0:58:49.14,teks umum,,0,0,0,,Saya juga sedang bersiap untuk ini,
Dialog: 0,0:58:49.97,0:58:51.43,teks umum,,0,0,0,,bahawa saya akan ditendang keluar daripada keluarga
Dialog: 0,0:58:53.14,0:58:54.48,teks umum,,0,0,0,,Adakah anda serius?
Dialog: 0,0:58:55.31,0:58:58.98,teks umum,,0,0,0,,Mahu melepaskan status ketua Sosnovy Bor demi saya?
Dialog: 0,0:58:59.06,0:59:01.73,teks umum,,0,0,0,,Anda berkata bahawa anda tidak mahu perkahwinan tanpa cinta
Dialog: 0,0:59:02.74,0:59:04.61,contact,,0,0,0,,Kemudian saya fikir, jika kita berkahwin,
Dialog: 0,0:59:04.70,0:59:06.82,teks umum,,0,0,0,,anda akan mendapat suami yang penyayang
Dialog: 0,0:59:09.37,0:59:10.53,teks umum,,0,0,0,,Oleh itu...
Dialog: 0,0:59:11.74,0:59:15.41,teks umum,,0,0,0,,Nah, anda masih belum bertemu dengan orang yang anda sayang
Dialog: 0,0:59:42.36,0:59:44.23,teks umum,,0,0,0,,Nampaknya saya sudah
Dialog: 0,0:59:45.94,0:59:47.15,teks umum,,0,0,0,,jumpa dia
Dialog: 0,0:59:53.70,0:59:55.95,teks umum,,0,0,0,,Jika anda berpegang pada saya seperti itu,
Dialog: 0,1:00:00.75,1:00:02.59,teks umum,,0,0,0,,Saya tidak akan lepaskan
Dialog: 0,1:00:03.63,1:00:05.42,contact,,0,0,0,,Perasaan saya terlalu kuat
Dialog: 0,1:00:06.72,1:00:08.63,teks umum,,0,0,0,,Jangan berpatah balik
Dialog: 0,1:00:18.35,1:00:21.61,teks umum,,0,0,0,,Kita perlu membeli bunga untuk meminang dengan betul
Dialog: 0,1:00:25.44,1:00:26.65,teks umum,,0,0,0,,Jom
Dialog: 0,1:00:33.91,1:00:37.58,teks umum,,0,0,0,,Hantar bunga ini kepada keluarga Chan
Dialog: 0,1:00:37.66,1:00:40.75,teks umum,,0,0,0,,Adakah seseorang meninggal dunia?
Dialog: 0,1:00:40.83,1:00:42.88,teks umum,,0,0,0,,Mengapa anda menghantar mereka kekwa?
Dialog: 0,1:00:46.59,1:00:48.67,teks umum,,0,0,0,,Saya hampir membuat kesilapan besar
Dialog: 0,1:00:48.76,1:00:49.80,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,1:00:51.01,1:00:52.26,teks umum,,0,0,0,,Dari sini
Dialog: 0,1:00:53.39,1:00:54.89,teks umum,,0,0,0,,ke sini
Dialog: 0,1:00:54.97,1:00:56.47,teks umum,,0,0,0,,Hantar semuanya
Dialog: 0,1:00:56.56,1:00:59.14,teks umum,,0,0,0,,- Semua bunga ini?\N- Ya, semua
Dialog: 0,1:00:59.23,1:01:01.90,teks umum,,0,0,0,,- Saya pasti dia akan menyukai sekurang-kurangnya sesuatu{\i1}\N- Ia tidak boleh
Dialog: 0,1:01:01.98,1:01:04.23,teks umum,,0,0,0,,Terima kasih banyak
Dialog: 0,1:01:06.90,1:01:09.19,teks umum,,0,0,0,,- Mana yang anda suka?\N- Ini adalah ini
Dialog: 0,1:01:09.90,1:01:12.03,teks umum,,0,0,0,,Saya boleh beli semuanya jika anda mahu
Dialog: 0,1:01:36.64,1:01:38.68,teks umum,,0,0,0,,Anda adalah ketua masa depan Sosnovy Bor
Dialog: 0,1:01:39.85,1:01:42.23,teks umum,,0,0,0,,Kenapa awak berjumpa dengan ketua masa depan Jinyeowon?
Dialog: 0,1:01:42.73,1:01:43.81,teks umum,,0,0,0,,Kenapa?
Dialog: 0,1:01:44.48,1:01:47.52,teks umum,,0,0,0,,Adakah anda mahu melepaskan warisan anda dan menyertai keluarga mereka?
Dialog: 0,1:01:47.61,1:01:51.20,teks umum,,0,0,0,,Pakcik, kami saling menyayangi
Dialog: 0,1:01:51.86,1:01:53.91,teks umum,,0,0,0,,Tidak lama dahulu Cho Young
Dialog: 0,1:01:54.82,1:01:56.28,teks umum,,0,0,0,,Uka yang dikasihi
Dialog: 0,1:01:56.91,1:01:58.95,teks umum,,0,0,0,,No. Hari ini dia membuktikannya kepada saya
Dialog: 0,1:01:59.04,1:02:03.00,teks umum,,0,0,0,,Cho Young berkata bahawa dia akan melepaskan gelaran kepala demi cinta
Dialog: 0,1:02:03.08,1:02:04.58,teks umum,,0,0,0,,Mereka hanya mempunyai seorang anak perempuan
Dialog: 0,1:02:04.67,1:02:06.21,teks umum,,0,0,0,,Siapa yang akan menjadi ketua Jinyowon?
Dialog: 0,1:02:06.79,1:02:09.25,teks umum,,0,0,0,,Dia akan menjadi anak perempuan sulung
Dialog: 0,1:02:09.34,1:02:12.80,teks umum,,0,0,0,,Ahli silap mata Jeonbugwan membantu mereka mencari kakaknya yang hilang
Dialog: 0,1:02:14.22,1:02:15.14,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:15.22,1:02:17.93,teks am,,0,0,0,,Timbalan Jin Mu datang berjumpa mereka setiap hari
Dialog: 0,1:02:19.64,1:02:20.97,teks umum,,0,0,0,,Jin Mu?
Dialog: 0,1:02:22.60,1:02:24.56,teks umum,,0,0,0,,Kalaulah saya ada abang,
Dialog: 0,1:02:24.65,1:02:27.44,teks umum,,0,0,0,,yang akan menjadi ketua bukannya saya
Dialog: 0,1:02:28.86,1:02:31.32,contact,,0,0,0,,Saya bertanya semata-mata kerana ingin tahu
Dialog: 0,1:02:32.11,1:02:35.99,teks umum,,0,0,0,,Pakcik, adakah anda pasti anda tidak mempunyai anak di sebelah anda?
Dialog: 0,1:02:39.91,1:02:40.83,teks umum,,0,0,0,,Tiada?
Dialog: 0,1:02:42.45,1:02:43.62,teks umum,,0,0,0,,Sama sekali?
Dialog: 0,1:02:46.17,1:02:47.00,teks umum,,0,0,0,,Keluar
Dialog: 0,1:02:48.75,1:02:50.09,teks umum,,0,0,0,,Keluar
Dialog: 0,1:02:50.17,1:02:51.30,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:51.38,1:02:52.46,teks umum,,0,0,0,,Keluar!
Dialog: 0,1:02:54.63,1:02:57.26,teks umum,,0,0,0,,Masih belum terlambat, anda boleh mempunyai anak sekarang
Dialog: 0,1:02:57.34,1:02:58.30,teks umum,,0,0,0,,Anda...
Dialog: 0,1:02:58.39,1:03:00.22,teks umum,,0,0,0,,Maksud saya, anda masih penuh kekuatan
Dialog: 0,1:03:02.14,1:03:04.23,teks umum,,0,0,0,,Tangkap bajingan ini!
Dialog: 0,1:03:08.65,1:03:09.90,teks umum,,0,0,0,,Nah, baik
Dialog: 0,1:03:20.83,1:03:23.16,teks umum,,0,0,0,,Mengapa terdapat banyak warna di sini?
Dialog: 0,1:03:23.83,1:03:27.17,teks umum,,0,0,0,,Saya bergaduh dengan seorang. Jadi dia cuba berdamai
Dialog: 0,1:03:28.71,1:03:32.25,teks umum,,0,0,0,,saya harap awak maafkan dia. Bunga-bunga ini cantik
Dialog: 0,1:03:34.67,1:03:36.55,teks umum,,0,0,0,,Anda sangat baik
Dialog: 0,1:03:37.68,1:03:39.72,teks umum,,0,0,0,,Ibu Tuan Muda Chan...
Dialog: 0,1:03:40.30,1:03:42.76,teks umum,,0,0,0,,sama baik seperti anda
Dialog: 0,1:03:43.77,1:03:45.10,teks umum,,0,0,0,,Nampaknya, Uk masuk ke dalamnya
Dialog: 0,1:03:47.31,1:03:48.31,teks umum,,0,0,0,,Encik?
Dialog: 0,1:03:49.69,1:03:53.07,teks umum,,0,0,0,,Apa yang membuatkan anda berfikir begitu?
Dialog: 0,1:03:55.36,1:03:57.36,teks umum,,0,0,0,,Apabila dia bercakap tentang ibunya,
Dialog: 0,1:03:57.45,1:03:59.20,teks umum,,0,0,0,,Saya rasa kehangatan
Dialog: 0,1:04:00.24,1:04:01.45,teks umum,,0,0,0,,Saya nampak di matanya
Dialog: 0,1:04:02.83,1:04:03.66,teks umum,,0,0,0,,Tunggu sebentar...
Dialog: 0,1:04:04.41,1:04:07.41,teks umum,,0,0,0,,Adakah dia bercakap dengan anda tentang ibunya?
Dialog: 0,1:04:08.71,1:04:10.54,teks umum,,0,0,0,,Anda mesti sangat rapat dengannya
Dialog: 0,1:04:11.75,1:04:13.63,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,1:04:13.71,1:04:15.71,teks umum,,0,0,0,,Hanya Tuan Muda Chan mahu mendekatkan diri
Dialog: 0,1:04:15.80,1:04:19.18,teks umum,,0,0,0,,Kali terakhir dia menghabiskan masa selama 4 jam dengan wanita itu
Dialog: 0,1:04:20.30,1:04:21.22,teks umum,,0,0,0,,Adakah ia benar?
Dialog: 0,1:04:22.43,1:04:24.22,teks umum,,0,0,0,,Kami hanya bercakap sedikit
Dialog: 0,1:04:26.68,1:04:29.44,teks umum,,0,0,0,,Ternyata itu awak. Kuntul
Dialog: 0,1:04:30.69,1:04:33.77,teks umum,,0,0,0,,Lelaki itu mungkin dingin, dia pernah menderita pada masa lalu
Dialog: 0,1:04:33.86,1:04:37.57,teks umum,,0,0,0,,Dan cara terbuka kepada seseorang - baik hati dan penyayang
Dialog: 0,1:04:39.53,1:04:41.45,teks umum,,0,0,0,,Lawati kami lebih kerap
Dialog: 0,1:04:41.53,1:04:43.78,teks umum,,0,0,0,,Anggap tempat ini sarang anda
Dialog: 0,1:04:43.87,1:04:46.29,teks umum,,0,0,0,,dan kerap datang ke sini
Dialog: 0,1:04:47.50,1:04:48.66,teks umum,,0,0,0,,Okey
Dialog: 0,1:04:55.38,1:04:58.88,teks umum,,0,0,0,,Jin Mu membantu Jin Ho Kyung mencari anak perempuannya?
Dialog: 0,1:04:58.97,1:05:01.22,teks umum,,0,0,0,,Saya rasa ini hanya alasan
Dialog: 0,1:05:01.30,1:05:03.14,teks umum,,0,0,0,,lawati Jinyeowon
Dialog: 0,1:05:03.93,1:05:07.81,teks umum,,0,0,0,,Saya rasa Jin Mu mahu mendapatkan sokongan Jinyeowon
Dialog: 0,1:05:09.10,1:05:11.65,teks umum,,0,0,0,,Jika dia berjaya,
Dialog: 0,1:05:12.44,1:05:15.19,teks umum,,0,0,0,,dia boleh menahan Hutan Pine
Dialog: 0,1:05:15.27,1:05:16.27,teks umum,,0,0,0,,Dan kemudian...
Dialog: 0,1:05:18.28,1:05:20.65,teks umum,,0,0,0,,dia dan rakyatnya tanpa rasa takut dan menyesal
Dialog: 0,1:05:22.66,1:05:26.20,teks umum,,0,0,0,,akan mendedahkan kuasa batu ais kepada dunia
Dialog: 0,1:05:34.04,1:05:38.26,contact,,0,0,0,,Salah seorang daripada kaum Jin Mu mempunyai batu itu
Dialog: 0,1:05:40.01,1:05:43.22,contact,,0,0,0,,Semua orang menyangka batu itu diperbuat daripada ais,
Dialog: 0,1:05:43.76,1:05:48.39,miring,,0,0,0,,tetapi kuasa api, air dan angin tertumpu di dalamnya
Dialog: 0,1:05:49.31,1:05:51.52,italic,,0,0,0,,200 tahun yang lalu, seorang ahli silap mata daripada keluarga Choi mencipta reflektor
Dialog: 0,1:05:52.23,1:05:56.40,contact,,0,0,0,,Dan kini seseorang menggunakan kuasa batu untuk mengulangi perkara ini
Dialog: 0,1:06:07.78,1:06:11.50,contact,,0,0,0,,Batch reflektor baharu yang dibuat oleh ratu
Dialog: 0,1:06:16.67,1:06:19.42,contact,,0,0,0,,Kejahatan tidak terletak pada kuasa batu ais
Dialog: 0,1:06:19.50,1:06:23.63,contact,,0,0,0,,Reflektor ialah apa yang digunakan untuk tujuan jahat
Dialog: 0,1:06:26.93,1:06:30.10,contact,,0,0,0,,Kuasa yang di luar kawalan orang biasa,
Dialog: 0,1:06:30.18,1:06:32.43,miring,,0,0,0,, akan mahu memiliki segala-galanya jika ia tersedia
Dialog: 0,1:06:33.64,1:06:36.19,contact,,0,0,0,,Kuasa untuk meninggalkan badan lama
Dialog: 0,1:06:36.27,1:06:38.02,miring,,0,0,0,,dan ambil yang baharu
Dialog: 0,1:06:39.77,1:06:44.07,miring,,0,0,0,,Badan tua sebagai ganti yang muda, yang hodoh dengan yang cantik
Dialog: 0,1:06:45.36,1:06:49.03,contact,,0,0,0,,Kuasa untuk menghentikan kematian dan menjadikan hidup kekal
Dialog: 0,1:07:04.72,1:07:07.89,teks umum,,0,0,0,,Dia seorang lelaki muda yang sihat dan hebat
Dialog: 0,1:07:08.47,1:07:09.47,teks umum,,0,0,0,,Ia telah dipilih...
Dialog: 0,1:07:10.39,1:07:13.64,teks umum,,0,0,0,,oleh pengganti saya
Dialog: 0,1:07:14.43,1:07:16.56,teks umum,,0,0,0,,saya ingin berhijrah ke badannya
Dialog: 0,1:07:17.85,1:07:19.27,teks umum,,0,0,0,,Guru
Dialog: 0,1:07:20.27,1:07:22.65,teks umum,,0,0,0,,Apakah mantera yang ingin anda tunjukkan kepada saya?
Dialog: 0,1:07:23.24,1:07:24.57,teks umum,,0,0,0,,Alkimia jiwa
Dialog: 0,1:07:25.15,1:07:26.40,teks umum,,0,0,0,,Alkimia jiwa?
Dialog: 0,1:07:28.07,1:07:32.83,teks umum,,0,0,0,,Saya masih mempunyai banyak perkara untuk dilakukan,
Dialog: 0,1:07:33.45,1:07:37.21,teks umum,,0,0,0,,tetapi badan ini tidak baik, penyakit itu semakin mendekatkan kematiannya.
Dialog: 0,1:07:38.46,1:07:39.54,teks umum,,0,0,0,,Oleh itu...
Dialog: 0,1:07:40.96,1:07:43.21,teks umum,,0,0,0,,Saya perlukan badan awak
Dialog: 0,1:07:47.55,1:07:48.72,teks umum,,0,0,0,,Apa?
Dialog: 0,1:08:05.99,1:08:09.20,teks umum,,0,0,0,,Mari kita mulakan dengan alkimia jiwa
Dialog: 0,1:08:17.21,1:08:19.25,teks umum,,0,0,0,,Cikgu, saya tidak mahu bertukar badan
Dialog: 0,1:08:19.83,1:08:22.25,teks umum,,0,0,0,,Jika saya bertukar badan dengan awak, saya akan mati tidak lama lagi
Dialog: 0,1:08:22.34,1:08:24.30,teks umum,,0,0,0,,Tetapi badan anda akan hidup
Dialog: 0,1:08:35.39,1:08:36.52,condong,,0,0,0,,Bantuan
Dialog: 0,1:08:37.14,1:08:38.44,teks umum,,0,0,0,,Selamatkan saya
Dialog: 0,1:08:39.23,1:08:42.15,teks umum,,0,0,0,,Tolong saya! Tolong!
Dialog: 0,1:08:44.61,1:08:46.32,teks umum,,0,0,0,,Cikgu!
Dialog: 0,1:10:33.84,1:10:35.01,teks umum,,0,0,0,,Guru
Dialog: 0,1:10:36.01,1:10:37.01,teks umum,,0,0,0,,Tubuh saya...
Dialog: 0,1:10:37.10,1:10:38.93,teks umum,,0,0,0,,Kembalikan semuanya
Dialog: 0,1:10:39.51,1:10:41.73,teks umum,,0,0,0,,Sila. Saya tidak mahu mati
Dialog: 0,1:10:41.81,1:10:44.31,teks umum,,0,0,0,,Tuan! Berikan badan saya
Dialog: 0,1:10:44.39,1:10:47.11,teks umum,,0,0,0,,Tuan! Saya mahu kembali ke badan saya
Dialog: 0,1:10:47.19,1:10:49.11,condong,,0,0,0,,Cikgu!
Dialog: 0,1:10:50.57,1:10:54.86,teks umum,,0,0,0,,Alkimia jiwa membantu menyelamatkan nyawa orang lain
Dialog: 0,1:10:55.70,1:10:56.91,teks umum,,0,0,0,,ahli silap mata yang berharga
Dialog: 0,1:11:06.71,1:11:07.92,teks umum,,0,0,0,,Sementara kami
Dialog: 0,1:11:08.92,1:11:10.67,teks umum,,0,0,0,,kita mempunyai kuasa batu itu,
Dialog: 0,1:11:10.75,1:11:14.30,teks umum,,0,0,0,,jiwa kita akan dapat hidup selama-lamanya, dan tidak membusuk dalam badan ini
Dialog: 0,1:11:15.34,1:11:18.47,contact,,0,0,0,,Kini kuasa batu itu dilarang,
Dialog: 0,1:11:18.55,1:11:21.97,teks umum,,0,0,0,,jadi anda perlu melakukan alkimia secara rahsia
Dialog: 0,1:11:22.06,1:11:26.27,teks umum,,0,0,0,,Tetapi lambat laun akan tiba masanya kekuatan kita akan bertambah kuat
Dialog: 0,1:11:26.35,1:11:29.77,teks umum,,0,0,0,,Kami akan menunjukkan kepada semua orang bahawa kami betul. Kerja keras kita akan membuahkan hasil
Dialog: 0,1:11:31.15,1:11:32.40,teks umum,,0,0,0,,Dan pada hari ini
Dialog: 0,1:11:33.53,1:11:35.11,teks umum,,0,0,0,,semua yang hadir di sini...
Dialog: 0,1:11:35.65,1:11:39.03,teks umum,,0,0,0,,akan mengalahkan maut dan memperoleh kehidupan kekal
Dialog: 0,1:12:02.35,1:12:03.93,teks umum,,0,0,0,,Adakah anda melihat segala-galanya?
Dialog: 0,1:12:06.89,1:12:07.98,teks umum,,0,0,0,,Ya
Dialog: 0,1:12:08.06,1:12:12.48,teks umum,,0,0,0,,Anda mesti membawa seorang ke sini
Dialog: 0,1:12:13.98,1:12:17.82,teks umum,,0,0,0,,Jin Ho Kyung akan menjadi ibu awak. Dekati dia
Dialog: 0,1:12:17.90,1:12:20.74,teks umum,,0,0,0,,Dan kemudian bawa dia ke sini
Dialog: 0,1:12:22.62,1:12:24.04,teks umum,,0,0,0,,Bolehkah anda mengatasinya?
Dialog: 0,1:12:27.79,1:12:28.87,teks umum,,0,0,0,,Ya
Dialog: 0,1:12:38.88,1:12:40.30,contact,,0,0,0,,Dia sesuai
Dialog: 0,1:12:41.34,1:12:43.72,italic,,0,0,0,,Kalau awak boleh bawa Jin Ho Kyung ke sini,
Dialog: 0,1:12:45.01,1:12:49.02,teks umum,,0,0,0,, lebih mudah untuk mendedahkan kuasa batu itu kepada seluruh dunia
Dialog: 0,1:13:40.65,1:13:42.28,teks umum,,0,0,0,,Kenapa awak belum tidur lagi?
Dialog: 0,1:13:53.50,1:13:55.46,contact,,0,0,0,,Jin Mu boleh menjadi
Dialog: 0,1:13:55.54,1:13:59.71,teks umum,,0,0,0,,lebih kuat dan lebih berpengaruh daripada yang kita fikirkan
Dialog: 0,1:14:00.97,1:14:05.01,teks umum,,0,0,0,,Pasti bintang Raja muncul untuk menghapuskan kekacauan yang disebabkan oleh batu
Dialog: 0,1:14:07.47,1:14:10.10,teks umum,,0,0,0,,Adakah anda bercakap tentang Uke?
Dialog: 0,1:14:10.18,1:14:13.94,teks umum,,0,0,0,,Cikgu So Kyung, yang menghalang kengerian dua ratus tahun yang lalu,
Dialog: 0,1:14:14.02,1:14:16.23,teks umum,,0,0,0,,juga dilahirkan di bawah bintang yang serupa
Dialog: 0,1:14:16.31,1:14:18.11,teks umum,,0,0,0,,Bintang ini dicipta oleh sihir
Dialog: 0,1:14:18.19,1:14:20.07,teks umum,,0,0,0,,Dia tidak boleh dibandingkan dengan bintang Master Seo Kyung
Dialog: 0,1:14:21.36,1:14:24.20,teks umum,,0,0,0,,Adakah saya menyebut bahawa bintang itu sama?
Dialog: 0,1:14:26.03,1:14:27.70,teks umum,,0,0,0,,Jadi saya ingin tahu
Dialog: 0,1:14:30.79,1:14:34.92,teks umum,,0,0,0,,Saya tertanya-tanya jika bintang ini akan padam secara perlahan
Dialog: 0,1:14:36.29,1:14:37.88,teks umum,,0,0,0,,atau adakah ia akan bersinar terang?
Dialog: 0,1:15:16.08,1:15:17.13,condong,,0,0,0,,Kemenangan!
Dialog: 0,1:15:17.21,1:15:19.67,contact,,0,0,0,,- Cemerlang\N- Kerja bagus
Dialog: 0,1:15:19.75,1:15:20.84,miring,,0,0,0,,saya tahu
Dialog: 0,1:16:03.76,1:16:05.38,teks umum,,0,0,0,,Saya tahu tentang Tansu
Dialog: 0,1:16:06.13,1:16:08.22,contact,,0,0,0,,Putera raja tidak tahu, jadi anda melakukannya
Dialog: 0,1:16:08.30,1:16:11.22,teks umum,,0,0,0,,Dan juga air dari lopak yang dilihat semua orang
Dialog: 0,1:16:11.30,1:16:12.51,teks umum,,0,0,0,,Mudah seperti pai
Dialog: 0,1:16:26.69,1:16:27.95,contact,,0,0,0,,Kemenangan!
Dialog: 0,1:16:29.78,1:16:32.62,contact,,0,0,0,,- Cemerlang!\N- Hebat!
Dialog: 0,1:16:52.05,1:16:54.26,teks umum,,0,0,0,,Hanya tinggal tiga ekor kodok?
Dialog: 0,1:16:54.35,1:16:55.60,teks umum,,0,0,0,,Ya
Dialog: 0,1:16:56.56,1:16:59.69,teks umum,,0,0,0,,Jadi dia telah berjuang selama tujuh hari berturut-turut?
Dialog: 0,1:16:59.77,1:17:01.85,teks umum,,0,0,0,,Dan sentiasa hilang
Dialog: 0,1:17:03.36,1:17:06.19,teks umum,,0,0,0,,Saya fikir dia akan berhenti jika dia terus kalah
Dialog: 0,1:17:09.07,1:17:11.07,teks umum,,0,0,0,,Nampaknya, dia cuba untuk ini
Dialog: 0,1:17:11.16,1:17:14.70,teks umum,,0,0,0,,Seperti yang anda katakan, dia tidak menggunakan pedang dengan baik, manteranya lemah
Dialog: 0,1:17:14.78,1:17:16.20,teks umum,,0,0,0,,Tetapi dia terus melawan...
Dialog: 0,1:17:16.29,1:17:18.83,teks umum,,0,0,0,,hanya kerana dia gigih
Dialog: 0,1:17:19.33,1:17:22.96,teks umum,,0,0,0,,Ini hanyalah pertarungan, tetapi dia bertarung dengan ahli silap mata lain setiap hari
Dialog: 0,1:17:23.04,1:17:24.59,miring,,0,0,0,,Dia pasti keletihan
Dialog: 0,1:17:24.67,1:17:27.67,teks umum,,0,0,0,,Yang Mulia, saya percaya pada kemenangan anda
Dialog: 0,1:17:27.76,1:17:30.72,teks umum,,0,0,0,,Malah saya tidak berpeluang untuk melawan ahli silap mata Jeonjingak
Dialog: 0,1:17:30.80,1:17:33.26,teks umum,,0,0,0,,Tetapi saya biarkan Chan Wook melakukannya...
Dialog: 0,1:17:33.34,1:17:35.60,teks umum,,0,0,0,,untuk katak emas anda sendiri
Dialog: 0,1:17:35.68,1:17:37.68,teks umum,,0,0,0,,Won Mu Deok menipu saya lagi?
Dialog: 0,1:17:57.87,1:18:00.79,di sebalik tabir,,0,0,0,,Berlawan dan kalah, Chan Wook
Dialog: 0,1:18:15.30,1:18:18.22,di sebalik tabir,,0,0,0,,Semua yang tidak membunuh anda,
Dialog: 0,1:18:23.19,1:18:26.15,di sebalik tabir,,0,0,0,,hanya menjadikan anda lebih kuat
Dialog: 0,1:18:59.56,1:19:01.77,pratonton,,0,0,0,,- Chan Wook!\N- Adakah anda telah datang kepada pemiliknya?
Dialog: 0,1:19:01.85,1:19:04.10,pratonton,,0,0,0,,Biar dia kalah, dia menjadi lebih kuat
Dialog: 0,1:19:05.69,1:19:06.52,pratonton,,0,0,0,,Jangan pergi
Dialog: 0,1:19:06.60,1:19:08.40,pratonton,,0,0,0,,Jangan pergi ke bilik anda, tinggal di sini
Dialog: 0,1:19:08.48,1:19:11.07,pratonton,,0,0,0,,Sungguh ngeri! Tengok kasut. Semua basah
Dialog: 0,1:19:11.15,1:19:12.40,pratonton,,0,0,0,,Anda cedera
Dialog: 0,1:19:13.99,1:19:17.49,pratonton,,0,0,0,,Kecoh di ibu kota. Malam tadi dia diserang oleh beberapa pembunuh upahan
Dialog: 0,1:19:18.57,1:19:20.83,pratonton,,0,0,0,,- Jangan bunuh dia!\N- Bunuh dia!
Dialog: 0,1:19:21.79,1:19:23.87,pratonton,,0,0,0,,- Dia seorang nomad\N- Keluar!
Dialog: 0,1:19:23.96,1:19:25.58,pratonton,,0,0,0,,- Saya datang\N- Chan Wook
Dialog: 0,1:19:25.67,1:19:29.96,pratonton,,0,0,0,,Saya rasa tidak betul untuk melepaskan ahli silap mata yang baru sahaja sampai ke sini dengan mudah
Dialog: 0,1:19:30.04,1:19:32.13,pratonton,,0,0,0,,Sebaik sahaja anda menjadi liar, anda tidak boleh kembali
Dialog: 0,1:19:32.21,1:19:34.22,pratonton,,0,0,0,,Anda tidak boleh menjadi lelaki, hanya raksasa
Dialog: 0,1:19:34.30,1:19:36.88,pratonton,,0,0,0,,Kita boleh melindungi raksasa dunia ini
Dialog: 0,1:19:39.60,1:19:44.60,pratonton,,0,0,0,,
Dialog: 0,1:19:44.60,1:19:46.60,teks umum,,0,0,0,,
