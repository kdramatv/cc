Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, tommo, Zero_Amamiya
Dialog: 0,0:00:59.00,0:01:00.71,contact,,0,0,0,,Anda boleh menyembuhkan nomad
Dialog: 0,0:01:00.80,0:01:03.84,teks umum,,0,0,0,,dan jadikan dia manusia, walaupun dia menjadi liar?
Dialog: 0,0:01:05.18,0:01:08.18,teks umum,,0,0,0,,Kami tidak cuba menjadikan dia manusia lagi
Dialog: 0,0:01:08.68,0:01:12.73,teks umum,,0,0,0,,Kami cuba memastikan dia sedar supaya dia boleh bercakap
Dialog: 0,0:01:16.15,0:01:18.73,teks umum,,0,0,0,,Jadi anda tidak cuba menyelamatkannya
Dialog: 0,0:01:18.82,0:01:21.99,teks umum,,0,0,0,,Apabila seorang nomad bertukar menjadi pemakan jiwa, tiada jalan untuk berpatah balik
Dialog: 0,0:01:22.95,0:01:24.24,teks umum,,0,0,0,,Mereka adalah raksasa
Dialog: 0,0:01:26.12,0:01:29.03,contact,,0,0,0,,Sama ada ia akan memakan tenaga manusia,
Dialog: 0,0:01:29.12,0:01:31.29,italik,,0,0,0,,atau ia akan membatu. Satu daripada dua
Dialog: 0,0:01:38.54,0:01:40.30,teks umum,,0,0,0,,Kami tidak dapat menghalang perkara ini
Dialog: 0,0:01:44.72,0:01:45.72,teks umum,,0,0,0,,Ais batu
Dialog: 0,0:01:47.85,0:01:50.26,teks umum,,0,0,0,,Saya dengar dia ada kuasa Hwangsu
Dialog: 0,0:01:50.35,0:01:52.35,teks umum,,0,0,0,,Bolehkah batu menghentikan peredaran?
Dialog: 0,0:01:53.98,0:01:55.98,teks umum,,0,0,0,,Mungkin. Tetapi...
Dialog: 0,0:01:57.19,0:02:01.03,teks umum,,0,0,0,,orang tidak boleh menggunakan kuasa sedemikian dalam apa jua keadaan
Dialog: 0,0:02:14.58,0:02:16.37,teks umum,,0,0,0,,Nampaknya hujan akan turun
Dialog: 0,0:02:18.50,0:02:21.30,teks umum,,0,0,0,,Dan saya tidak dapat menggunakan kuasa pemantul
Dialog: 0,0:02:21.38,0:02:24.34,teks umum,,0,0,0,,Nampaknya semuanya akan dihanyutkan oleh hujan
Dialog: 0,0:02:24.42,0:02:27.38,teks umum,,0,0,0,,Apabila hujan, adakah kuasa pemantul hilang?
Dialog: 0,0:02:27.47,0:02:30.05,teks umum,,0,0,0,,Kuasa batu ais datang dari syurga
Dialog: 0,0:02:30.14,0:02:32.72,teks umum,,0,0,0,,Jadi syurga boleh mengambil kuasa ini
Dialog: 0,0:02:53.91,0:02:56.62,suara,,0,0,0,,Adakah dia cuba menyeru kepada kuasa syurga,
Dialog: 0,0:02:56.71,0:02:59.17,luar skrin,,0,0,0,,untuk menyembunyikan batu?
Dialog: 0,0:03:03.92,0:03:05.46,teks umum,,0,0,0,,Jin Bu Young
Dialog: 0,0:03:06.80,0:03:09.97,teks umum,,0,0,0,,Jika dia masih hidup, dia akan menjadi paderi wanita yang berkuasa,
Dialog: 0,0:03:10.51,0:03:13.22,teks umum,,0,0,0,,yang boleh mengawal kuasa syurga
Dialog: 0,0:03:37.37,0:03:38.83,teks umum,,0,0,0,,Awak okay
Dialog: 0,0:03:39.46,0:03:42.38,teks umum,,0,0,0,,Saya juga baik. Anda tidak menjadi liar
Dialog: 0,0:04:01.15,0:04:03.02,teks umum,,0,0,0,,Gerbang di atas mangkuk buruj telah terbuka
Dialog: 0,0:04:03.69,0:04:05.98,teks umum,,0,0,0,,- Dan silingnya tidak selalu begini?\N- Tidak
Dialog: 0,0:04:06.53,0:04:08.03,teks umum,,0,0,0,,Semua orang berpendapat begitu,
Dialog: 0,0:04:08.99,0:04:10.78,teks umum,,0,0,0,,tetapi saya diberitahu bahawa ini tidak begitu
Dialog: 0,0:04:10.86,0:04:13.12,teks umum,,0,0,0,,Siapa? ayah awak?
Dialog: 0,0:04:14.62,0:04:17.75,teks umum,,0,0,0,,Dia berkata untuk membuka pintu pagar di atas mangkuk
Dialog: 0,0:04:17.83,0:04:20.29,teks umum,,0,0,0,,hanya ahli nujum yang boleh
Dialog: 0,0:04:20.91,0:04:22.67,teks umum,,0,0,0,,Bagaimana ini berlaku?
Dialog: 0,0:04:22.75,0:04:26.00,teks umum,,0,0,0,,Nampaknya kita melakukan sesuatu yang tidak sepatutnya kita lakukan
Dialog: 0,0:04:26.09,0:04:27.42,italic,,0,0,0,,Tetapi bagaimana?
Dialog: 0,0:04:29.42,0:04:30.51,italic,,0,0,0,,Ini saya
Dialog: 0,0:04:32.59,0:04:33.97,teks umum,,0,0,0,,Saya membuka pintu pagar
Dialog: 0,0:04:35.05,0:04:36.85,teks umum,,0,0,0,,Tenaga saya bocor ke dalam air
Dialog: 0,0:04:37.68,0:04:39.43,teks umum,,0,0,0,,Seperti di Tasik Gyeongcheongdaeho
Dialog: 0,0:04:40.27,0:04:41.89,teks umum,,0,0,0,,dan dalam cermin Tosca
Dialog: 0,0:04:43.77,0:04:46.02,teks umum,,0,0,0,,Tenaga saya kembali berkat air ini
Dialog: 0,0:05:05.13,0:05:06.46,teks umum,,0,0,0,,Apa maksud anda kilat disambar?
Dialog: 0,0:05:06.54,0:05:08.59,teks umum,,0,0,0,,Bunyi kuat datang dari bilik rakaman
Dialog: 0,0:05:09.38,0:05:12.42,teks umum,,0,0,0,,Eunuch Kim dan Chan Wook berada di sana sekarang
Dialog: 0,0:05:20.47,0:05:22.35,teks umum,,0,0,0,,Ini adalah kuasa reflektor
Dialog: 0,0:05:23.02,0:05:25.94,teks umum,,0,0,0,,Tenaga gelap yang sama seperti ketika Kil Ju cuba bertukar mayat
Dialog: 0,0:05:28.36,0:05:29.61,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:05:30.19,0:05:33.28,teks umum,,0,0,0,,Saya tidak nampak apa-apa, seperti dalam kes cermin
Dialog: 0,0:05:33.78,0:05:35.36,teks umum,,0,0,0,,Pening dan loya
Dialog: 0,0:05:35.45,0:05:37.53,teks umum,,0,0,0,,Jin Mu akan datang tidak lama lagi, kita mesti pergi
Dialog: 0,0:05:49.96,0:05:51.34,teks umum,,0,0,0,,Tepat sekali. pintu
Dialog: 0,0:05:53.84,0:05:56.39,teks umum,,0,0,0,,Dia menutup pintu dengan tenaga, mangkuk buruj pecah,
Dialog: 0,0:05:56.47,0:05:57.89,teks umum,,0,0,0,,dan pemakan jiwa sudah mati
Dialog: 0,0:05:59.39,0:06:00.39,teks umum,,0,0,0,,Kami menghadapi masalah
Dialog: 0,0:06:01.18,0:06:03.64,teks umum,,0,0,0,,Terdapat pintu keluar untuk pelayan di sebelah mangkuk buruj
Dialog: 0,0:06:04.69,0:06:06.85,teks umum,,0,0,0,,Ayah memimpin saya melalui pintu ini
Dialog: 0,0:06:07.44,0:06:09.44,teks umum,,0,0,0,,Tetapi kami masih berada di Jeonbugwan
Dialog: 0,0:06:13.74,0:06:16.61,teks umum,,0,0,0,,Anda tidak nampak, dan saya tidak tahu jalannya
Dialog: 0,0:06:17.99,0:06:21.37,teks umum,,0,0,0,,Jika kita tersesat, kita akan ditangkap
Dialog: 0,0:06:21.45,0:06:23.70,teks umum,,0,0,0,,Kami tinggal di sini - Jin Mu akan datang dan membunuh kami
Dialog: 0,0:06:23.79,0:06:25.54,teks umum,,0,0,0,,Saya tidak akan menang menentangnya
Dialog: 0,0:06:29.21,0:06:31.96,teks umum,,0,0,0,,Kita mesti memanggil penyelamat saya
Dialog: 0,0:06:33.26,0:06:35.09,teks umum,,0,0,0,,- Penyelamat?\N- Ada satu
Dialog: 0,0:06:37.05,0:06:40.64,teks umum,,0,0,0,,Hatinya akan bergetar, dan dia akan datang serta-merta
Dialog: 0,0:06:41.31,0:06:42.76,teks umum,,0,0,0,,Penyelamat saya
Dialog: 0,0:07:06.91,0:07:09.25,teks umum,,0,0,0,,Chan Wook, awak bergurau ke saya
Dialog: 0,0:07:14.84,0:07:16.55,teks umum,,0,0,0,,Adakah anda mendengar bunyi yang kuat?
Dialog: 0,0:07:16.63,0:07:19.68,teks umum,,0,0,0,,Ya, tetapi awak kata jangan masuk, jadi kami tunggu
Dialog: 0,0:07:19.76,0:07:22.47,teks umum,,0,0,0,,Yom Soo, ikut saya. Yang lain jaga pintu
Dialog: 0,0:07:38.20,0:07:40.36,teks umum,,0,0,0,,Chan Wook memecahkan halangan dan melarikan diri
Dialog: 0,0:07:40.45,0:07:41.28,miring,,0,0,0,,Timbalan
Dialog: 0,0:07:42.07,0:07:43.37,teks umum,,0,0,0,,Semangkuk buruj...
Dialog: 0,0:07:44.53,0:07:46.41,teks umum,,0,0,0,,Apa yang berlaku kepadanya?
Dialog: 0,0:07:47.45,0:07:49.00,teks umum,,0,0,0,,Kita perlu mencarinya
Dialog: 0,0:07:49.08,0:07:50.96,teks umum,,0,0,0,,Kita tidak boleh biarkan dia keluar dari sini hidup-hidup
Dialog: 0,0:07:51.58,0:07:53.34,teks umum,,0,0,0,,Alihkan mayat ke bilik rahsia
Dialog: 0,0:07:53.42,0:07:56.05,teks umum,,0,0,0,,- Tiada siapa patut melihat anda\N{\i1}- Ya
Dialog: 0,0:08:02.64,0:08:04.81,teks umum,,0,0,0,,Tutup semua pintu keluar
Dialog: 0,0:08:04.89,0:08:06.68,teks umum,,0,0,0,,Cari Chan Wook dan pembantu rumahnya
Dialog: 0,0:08:07.31,0:08:09.77,teks umum,,0,0,0,,Jika sesuatu berlaku, anda boleh membunuh mereka
Dialog: 0,0:08:09.85,0:08:10.81,miring,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:08:25.49,0:08:29.16,teks umum,,0,0,0,,Chan Wook tidak akan pernah keluar dari labirin ini
Dialog: 0,0:08:30.46,0:08:31.96,teks umum,,0,0,0,,Dia akan tersesat dan akan ditangkap
Dialog: 0,0:08:34.29,0:08:35.29,teks umum,,0,0,0,,Atau mungkin...
Dialog: 0,0:08:36.25,0:08:40.17,teks umum,,0,0,0,,dia tahu dia akan tersesat, jadi dia hanya bersembunyi di dalam
Dialog: 0,0:08:43.51,0:08:45.26,teks umum,,0,0,0,,Anda hampir mendapatnya
Dialog: 0,0:08:46.47,0:08:47.76,teks umum,,0,0,0,,Adakah anda di sini?
Dialog: 0,0:08:48.85,0:08:51.52,teks umum,,0,0,0,,Anda memecahkan halangan yang saya buat
Dialog: 0,0:08:51.60,0:08:53.65,teks umum,,0,0,0,,Mari kita buat satu lagi. berapi-api
Dialog: 0,0:08:55.44,0:08:58.07,teks umum,,0,0,0,,Jika saya membakar tempat ini,
Dialog: 0,0:08:58.15,0:09:00.90,teks umum,,0,0,0,,mungkin agak panas,
Dialog: 0,0:09:01.61,0:09:03.28,teks umum,,0,0,0,,untuk membuatkan anda kelihatan
Dialog: 0,0:09:03.36,0:09:07.41,contact,,0,0,0,,Cuba yakinkan saya seperti dahulu, tanpa ugutan
Dialog: 0,0:09:09.58,0:09:11.62,teks umum,,0,0,0,,Kenapa, jika saya tiada apa-apa kerugian?
Dialog: 0,0:09:12.21,0:09:15.96,teks umum,,0,0,0,,Anda adalah penjenayah yang masuk ke sini tanpa kebenaran dan juga memecahkan cawan
Dialog: 0,0:09:16.04,0:09:18.09,teks umum,,0,0,0,,Dan tugas saya ialah menangkap penjenayah
Dialog: 0,0:09:18.17,0:09:20.13,teks umum,,0,0,0,,Saya timbalan Gwangju
Dialog: 0,0:09:23.47,0:09:26.26,teks umum,,0,0,0,,Anda terlalu kejam terhadap tetamu yang datang membawa hadiah
Dialog: 0,0:09:26.34,0:09:29.81,teks umum,,0,0,0,,Marah kerana kami menjadikan rakan anda seperti batu?
Dialog: 0,0:09:29.89,0:09:30.97,teks umum,,0,0,0,,Kawan yang mana?
Dialog: 0,0:09:31.77,0:09:36.19,teks umum,,0,0,0,,Tiada sesiapa di sini kecuali kamu berdua dan saya
Dialog: 0,0:09:36.86,0:09:39.07,teks am,,0,0,0,,Ah-ah... nak sorok badan batu?
Dialog: 0,0:09:40.07,0:09:41.36,contact,,0,0,0,,Tetapi apa yang perlu dilakukan?
Dialog: 0,0:09:42.69,0:09:45.36,teks umum,,0,0,0,,- Anda akan ditangkap\N- {\u0\i1}Ini tidak akan berlaku
Dialog: 0,0:09:45.86,0:09:48.74,teks umum,,0,0,0,,Sebab awak dan pembantu rumah awak akan mati
Dialog: 0,0:09:49.79,0:09:50.91,miring,,0,0,0,,Keluar
Dialog: 0,0:09:51.50,0:09:52.62,teks umum,,0,0,0,,Keluar!
Dialog: 0,0:10:20.02,0:10:21.73,teks umum,,0,0,0,,Adakah anda lihat?
Dialog: 0,0:10:21.82,0:10:24.11,teks umum,,0,0,0,,Petir menyambar berhampiran Jeonbugwan
Dialog: 0,0:10:24.19,0:10:26.78,teks umum,,0,0,0,,Jeonbugwan di sebelah istana
Dialog: 0,0:10:26.86,0:10:29.53,teks umum,,0,0,0,,Kita perlu menyemak sama ada semuanya baik-baik saja
Dialog: 0,0:10:29.62,0:10:31.45,teks umum,,0,0,0,,Petir menyambar begitu kuat
Dialog: 0,0:10:31.54,0:10:33.95,teks umum,,0,0,0,,Saya harap, terus dari Jin Mu
Dialog: 0,0:10:49.30,0:10:50.47,teks umum,,0,0,0,,Sungguh memalukan
Dialog: 0,0:10:51.47,0:10:54.10,teks umum,,0,0,0,,Saya mungkin datang ke sini dengan gembira,
Dialog: 0,0:10:54.18,0:10:56.39,teks umum,,0,0,0,,membayangkan anda akan menjadi Gwangju
Dialog: 0,0:10:56.48,0:10:58.06,teks umum,,0,0,0,,Tetapi sebaliknya anda akan mati
Dialog: 0,0:10:58.15,0:10:59.90,miring,,0,0,0,,Anda kurang bernasib baik
Dialog: 0,0:11:01.48,0:11:02.40,teks umum,,0,0,0,,Ini tidak akan berfungsi
Dialog: 0,0:11:03.15,0:11:04.28,teks umum,,0,0,0,,Jika saya mati,
Dialog: 0,0:11:04.36,0:11:06.61,teks umum,,0,0,0,,anda boleh menjadi Gwangju dengan mudah
Dialog: 0,0:11:06.70,0:11:08.28,teks umum,,0,0,0,,Dan ini tidak sepatutnya dibenarkan
Dialog: 0,0:11:08.36,0:11:09.36,teks umum,,0,0,0,,Apa?
Dialog: 0,0:11:11.95,0:11:13.62,teks umum,,0,0,0,,Pernahkah anda mendengar tentang jed yin-yang?
Dialog: 0,0:11:15.12,0:11:17.62,teks umum,,0,0,0,,Ini adalah sepasang jed merah dan biru
Dialog: 0,0:11:17.71,0:11:20.29,teks umum,,0,0,0,,Jika anda menuangkan tenaga ke dalam satu batu, batu kedua akan merasakannya
Dialog: 0,0:11:20.38,0:11:21.71,teks umum,,0,0,0,,Jika mereka berdekatan,
Dialog: 0,0:11:22.50,0:11:24.55,teks umum,,0,0,0,,mereka akan mencari satu sama lain
Dialog: 0,0:11:25.80,0:11:26.76,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:11:26.84,0:11:28.30,teks umum,,0,0,0,,Satu daripada dua batu, biru,
Dialog: 0,0:11:29.18,0:11:31.14,teks umum,,0,0,0,,kini bersama Putera Mahkota
Dialog: 0,0:11:33.22,0:11:34.35,kenangan miring,,0,0,0,,Jed sayang
Dialog: 0,0:11:34.43,0:11:36.98,kenangan,,0,0,0,,Saya menerimanya sebagai pertukaran dengan kodok
Dialog: 0,0:11:37.06,0:11:38.23,kenangan,,0,0,0,,Adakah dia berharga?
Dialog: 0,0:11:40.23,0:11:42.02,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:11:42.11,0:11:44.32,teks umum,,0,0,0,,saya merah
Dialog: 0,0:11:44.40,0:11:46.94,teks umum,,0,0,0,,Saya mencurahkan tenaga kepadanya, yang bermaksud Yang Amat Mulia
Dialog: 0,0:11:47.82,0:11:49.40,teks umum,,0,0,0,,dalam perjalanan ke sini sekarang
Dialog: 0,0:11:59.33,0:12:01.04,teks umum,,0,0,0,,Adakah anda akan membunuh saya dan mengambil batu itu?
Dialog: 0,0:12:02.46,0:12:05.17,teks umum,,0,0,0,,Saya fikir begitu, jadi saya menyembunyikan batu itu
Dialog: 0,0:12:07.67,0:12:10.13,teks umum,,0,0,0,,Mengisinya dengan tenaga dan menyembunyikannya
Dialog: 0,0:12:10.22,0:12:12.18,teks umum,,0,0,0,,dalam jubah penelan jiwa kasim
Dialog: 0,0:12:21.90,0:12:25.65,contact,,0,0,0,,Yang Mulia mungkin sekarang sedang tergesa-gesa ke badan batu
Dialog: 0,0:12:28.99,0:12:31.32,teks umum,,0,0,0,,Bayangkan reaksinya apabila dia melihat ini
Dialog: 0,0:12:32.20,0:12:34.82,teks umum,,0,0,0,,Dia akan lebih daripada terkejut
Dialog: 0,0:12:47.30,0:12:48.30,teks umum,,0,0,0,,Jeonbugwan
Dialog: 0,0:12:50.84,0:12:52.88,teks umum,,0,0,0,,Chan Wook di suatu tempat di Jeonbugwan
Dialog: 0,0:13:00.39,0:13:02.02,teks umum,,0,0,0,,Jangan buang masa anda membunuh saya,
Dialog: 0,0:13:02.85,0:13:04.90,teks umum,,0,0,0,,lebih baik hentikan Putera Mahkota
Dialog: 0,0:13:09.57,0:13:11.11,teks umum,,0,0,0,,Saya akan kembali tidak lama lagi
Dialog: 0,0:13:12.20,0:13:14.70,teks umum,,0,0,0,,Anda masih tidak akan dapat melarikan diri dari sini
Dialog: 0,0:13:26.46,0:13:28.46,teks umum,,0,0,0,,- Di manakah mayat?\N- Di dalam bilik rahsia
Dialog: 0,0:13:28.55,0:13:31.09,teks umum,,0,0,0,,Jika anda memesan, saya akan mengeluarkannya dari sana
Dialog: 0,0:13:40.85,0:13:42.06,teks umum,,0,0,0,,Di mana...
Dialog: 0,0:13:45.10,0:13:48.61,teks umum,,0,0,0,,Dia tiada di sini. Bajingan ini menipu saya
Dialog: 0,0:13:51.57,0:13:53.03,teks umum,,0,0,0,,Timbalan
Dialog: 0,0:13:53.11,0:13:55.91,teks umum,,0,0,0,,Anda telah mengarahkan untuk tidak membenarkan sesiapa masuk, tetapi tiada pilihan
Dialog: 0,0:13:56.49,0:13:59.16,teks umum,,0,0,0,,Apa? Putera Mahkota ada di sini?
Dialog: 0,0:13:59.24,0:14:00.20,teks umum,,0,0,0,,Ya
Dialog: 0,0:14:02.33,0:14:04.50,teks umum,,0,0,0,,Jadi dia tidak berbohong tentang jed
Dialog: 0,0:14:21.18,0:14:22.22,teks umum,,0,0,0,,Timbalan
Dialog: 0,0:14:22.31,0:14:25.39,teks umum,,0,0,0,,Sida-sida diraja bertukar menjadi penelan jiwa?
Dialog: 0,0:14:28.56,0:14:31.19,teks umum,,0,0,0,,Dan awak cuba membunuh Chan Wook secara rahsia?
Dialog: 0,0:14:31.27,0:14:33.19,teks umum,,0,0,0,,Ini adalah salah faham, Yang Amat Mulia
Dialog: 0,0:15:10.31,0:15:11.52,teks umum,,0,0,0,,Anda cuba
Dialog: 0,0:15:11.61,0:15:14.23,teks umum,,0,0,0,,beri makan pembantu rumah saya kepada penelan jiwa ini
Dialog: 0,0:15:14.32,0:15:18.24,teks umum,,0,0,0,,Lebih baik berikan penjelasan biasa tentang apa yang berlaku
Dialog: 0,0:15:30.50,0:15:33.50,teks umum,,0,0,0,,Anda bertanya tentang Cho Chun, yang bekerja
Dialog: 0,0:15:33.59,0:15:35.80,teks umum,,0,0,0,,astrogazer dalam Jeonbugwan?
Dialog: 0,0:15:36.30,0:15:40.05,teks umum,,0,0,0,,Saya dengar Chang Gang dan Cho Chun rapat
Dialog: 0,0:15:40.14,0:15:41.18,teks umum,,0,0,0,,Ya
Dialog: 0,0:15:41.93,0:15:43.60,teks umum,,0,0,0,,Mereka adalah kawan baik
Dialog: 0,0:15:44.26,0:15:45.93,teks umum,,0,0,0,,Cho Chun sering melawat kami
Dialog: 0,0:15:46.52,0:15:50.06,teks umum,,0,0,0,,Dia seorang yang ceria dan baik hati
Dialog: 0,0:15:51.19,0:15:52.86,teks umum,,0,0,0,,Cho Chun menggunakan sihir gelap,
Dialog: 0,0:15:52.94,0:15:55.57,teks umum,,0,0,0,,yang memusnahkan seluruh keluarganya
Dialog: 0,0:15:55.65,0:15:57.24,teks umum,,0,0,0,,Dia seorang yang baik
Dialog: 0,0:15:57.94,0:16:01.41,teks umum,,0,0,0,,Saya masih tidak percaya bahawa ini berlaku
Dialog: 0,0:16:02.82,0:16:06.66,teks umum,,0,0,0,,Dia mempunyai seorang anak perempuan. Adakah anda mengenalinya?
Dialog: 0,0:16:07.54,0:16:09.00,teks umum,,0,0,0,,Ya, saya ingat dia
Dialog: 0,0:16:09.50,0:16:13.25,teks umum,,0,0,0,,Dia sentiasa bersama ayahnya, mereka rapat
Dialog: 0,0:16:13.33,0:16:15.38,teks umum,,0,0,0,,Saya dengar dia hilang
Dialog: 0,0:16:16.25,0:16:17.17,teks umum,,0,0,0,,Saya rasa,
Dialog: 0,0:16:18.09,0:16:19.47,teks umum,,0,0,0,,dia sudah mati
Dialog: 0,0:16:20.47,0:16:22.76,teks umum,,0,0,0,,Mengapa anda memutuskan perkara ini?
Dialog: 0,0:16:22.84,0:16:26.76,teks umum,,0,0,0,,Cikgu Chang Gan mencari gadis ini untuk masa yang lama
Dialog: 0,0:16:27.77,0:16:30.98,teks umum,,0,0,0,,Jika dia masih hidup, dia pasti sudah menemuinya
Dialog: 0,0:16:31.06,0:16:33.02,teks umum,,0,0,0,,Melainkan ia disembunyikan
Dialog: 0,0:16:34.27,0:16:35.69,teks umum,,0,0,0,,Cik Do Hwa meninggal dunia
Dialog: 0,0:16:36.61,0:16:38.69,teks umum,,0,0,0,,Ini berlaku kepada kawan baiknya
Dialog: 0,0:16:38.78,0:16:41.99,teks umum,,0,0,0,,Master Chan bukan dirinya ketika itu
Dialog: 0,0:16:42.53,0:16:45.91,teks umum,,0,0,0,,Dia menyalahkan dirinya untuk kedua-dua kematian
Dialog: 0,0:16:46.58,0:16:48.16,teks umum,,0,0,0,,dan banyak menderita
Dialog: 0,0:16:49.37,0:16:51.83,teks umum,,0,0,0,,Dia meninggalkan rumah untuk mencari anak perempuan kawannya
Dialog: 0,0:16:51.92,0:16:54.13,teks umum,,0,0,0,,Saya fikir dia akan kembali apabila dia menemuinya
Dialog: 0,0:16:54.67,0:16:55.67,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:16:56.42,0:17:00.26,teks umum,,0,0,0,,Peliknya dia meninggalkan rumah selama 20 tahun untuk mencari seorang gadis
Dialog: 0,0:17:01.05,0:17:03.72,teks umum,,0,0,0,,Saya mula mengesyaki dia pergi
Dialog: 0,0:17:03.80,0:17:05.26,teks umum,,0,0,0,,atas sebab lain
Dialog: 0,0:17:05.76,0:17:09.47,teks umum,,0,0,0,,Jika dia telah menemui gadis itu 20 tahun lalu,
Dialog: 0,0:17:10.27,0:17:12.89,teks umum,,0,0,0,,hidupnya tidak akan begitu sukar
Dialog: 0,0:17:12.98,0:17:16.94,teks umum,,0,0,0,,Dan Chang Gan tidak akan rasa bersalah
Dialog: 0,0:17:17.02,0:17:18.57,teks umum,,0,0,0,,"Salahkan"?
Dialog: 0,0:17:18.65,0:17:22.61,teks umum,,0,0,0,,Adakah anda membayangkan bahawa Cikgu Chan berkelakuan tidak betul terhadap rakannya?
Dialog: 0,0:17:23.24,0:17:25.32,contact,,0,0,0,,Dia menghukumnya kerana sihir gelap
Dialog: 0,0:17:25.41,0:17:27.37,teks umum,,0,0,0,,Sebagai ahli silap mata, dia terpaksa
Dialog: 0,0:17:27.45,0:17:31.54,teks umum,,0,0,0,,Tidak kira betapa rapatnya mereka, mustahil sebaliknya
Dialog: 0,0:17:31.62,0:17:35.88,teks umum,,0,0,0,,Anda tidak boleh menilai apa yang benar dan apa yang tidak berdasarkan apa yang telah anda lihat
Dialog: 0,0:17:36.46,0:17:38.96,teks umum,,0,0,0,,Ada cerita di sebalik segalanya
Dialog: 0,0:17:39.05,0:17:42.26,teks umum,,0,0,0,,Nasib terjalin daripada cerita dan perhubungan
Dialog: 0,0:17:42.34,0:17:44.22,teks umum,,0,0,0,,Iaitu, hubungan yang menyakitkan
Dialog: 0,0:17:44.30,0:17:49.22,teks umum,,0,0,0,,keluarga Cho dan Chan belum berakhir?
Dialog: 0,0:17:50.89,0:17:51.89,teks umum,,0,0,0,,Atau anda...
Dialog: 0,0:17:52.93,0:17:56.90,teks umum,,0,0,0,,adakah anda mengatakan bahawa gadis itu berada di rumah ini sekarang?
Dialog: 0,0:17:57.90,0:18:00.19,teks umum,,0,0,0,,Sosnovy Bor jumpa dia?
Dialog: 0,0:18:02.74,0:18:04.07,teks umum,,0,0,0,,Gadis itu
Dialog: 0,0:18:06.36,0:18:07.53,teks umum,,0,0,0,,mati
Dialog: 0,0:18:13.00,0:18:14.08,teks umum,,0,0,0,,Faham
Dialog: 0,0:18:14.91,0:18:16.08,teks umum,,0,0,0,,Sayangnya
Dialog: 0,0:18:17.29,0:18:19.25,teks umum,,0,0,0,,Kita perlu menahan dia bangun
Dialog: 0,0:18:22.59,0:18:23.76,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:18:24.88,0:18:26.43,teks umum,,0,0,0,,Anda sangat baik
Dialog: 0,0:18:26.51,0:18:28.47,contact,,0,0,0,,Ini bukan isyarat kebaikan
Dialog: 0,0:18:28.55,0:18:31.72,teks umum,,0,0,0,,Saya hanya tidak mahu rohnya berakhir di dunia ini
Dialog: 0,0:18:32.27,0:18:33.73,teks umum,,0,0,0,,dan menyeksa tuan muda
Dialog: 0,0:18:34.31,0:18:38.61,teks umum,,0,0,0,,Bagaimana jika rohnya menghantui Chan Wook?
Dialog: 0,0:18:38.69,0:18:41.65,teks umum,,0,0,0,,Kita perlu menyingkirkannya. Ini mesti roh jahat
Dialog: 0,0:18:41.73,0:18:43.57,teks umum,,0,0,0,,Saya tidak akan benarkan dia mengejarnya
Dialog: 0,0:18:45.19,0:18:46.95,teks umum,,0,0,0,,Roh jahat?
Dialog: 0,0:18:50.99,0:18:52.54,teks umum,,0,0,0,,Di manakah Moo Dok?
Dialog: 0,0:18:52.62,0:18:53.83,teks umum,,0,0,0,,Mu Dok?
Dialog: 0,0:18:54.41,0:18:57.50,teks umum,,0,0,0,,Saya menghantarnya kepada Jeonbugwan atas urusan
Dialog: 0,0:19:04.63,0:19:06.05,teks umum,,0,0,0,,Adakah anda okey? boleh nampak?
Dialog: 0,0:19:06.80,0:19:08.64,teks umum,,0,0,0,,Ya, saya faham
Dialog: 0,0:19:09.22,0:19:10.30,teks umum,,0,0,0,,Dan awak, cikgu?
Dialog: 0,0:19:10.39,0:19:12.64,teks umum,,0,0,0,,Adakah anda cedera di mana-mana?
Dialog: 0,0:19:12.72,0:19:13.85,miring,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:19:13.93,0:19:16.31,kenangan,,0,0,0,,Apakah maksudnya jika dua orang menyimpan item yang sepadan?
Dialog: 0,0:19:16.39,0:19:18.60,kenangan,,0,0,0,,Bahawa mereka berkahwin atau berpacaran
Dialog: 0,0:19:22.02,0:19:25.19,teks umum,,0,0,0,,Ketua Sosnovy Bor telah tiba atas pesanan anda
Dialog: 0,0:19:45.84,0:19:47.51,teks umum,,0,0,0,,Anda telah tiba di Jeonbugwan
Dialog: 0,0:19:48.26,0:19:50.93,teks am,,0,0,0,,luluskan biskut madu kepada timbalan??
Dialog: 0,0:19:51.01,0:19:54.85,teks umum,,0,0,0,,Ya. Saya dengar awak bergaduh kerana mereka
Dialog: 0,0:19:55.52,0:19:57.77,teks umum,,0,0,0,,Hamba Kim tidak mahu dia kecewa,
Dialog: 0,0:19:57.85,0:19:59.85,teks umum,,0,0,0,,jadi saya datang untuk menghantar bungkusannya
Dialog: 0,0:19:59.94,0:20:01.35,teks umum,,0,0,0,,Alasan yang menyedihkan
Dialog: 0,0:20:02.40,0:20:03.56,teks umum,,0,0,0,,Ketua Sosnovy Bor
Dialog: 0,0:20:03.65,0:20:06.65,teks umum,,0,0,0,,dan timbalan Gwangju bergaduh kerana biskut?
Dialog: 0,0:20:08.24,0:20:10.70,teks umum,,0,0,0,,Walaupun ini benar, ia patut berdiam diri mengenainya
Dialog: 0,0:20:10.78,0:20:12.99,teks umum,,0,0,0,,Apa yang kamu lakukan di dalam bilik rakaman?
Dialog: 0,0:20:13.07,0:20:15.41,teks umum,,0,0,0,,Saya ingin melihat mangkuk buruj
Dialog: 0,0:20:15.49,0:20:18.29,teks umum,,0,0,0,,Tetapi akhirnya saya melihat sesuatu yang tidak sepatutnya saya miliki
Dialog: 0,0:20:19.58,0:20:23.13,teks umum,,0,0,0,,Adakah anda pasti anda melihat penelan jiwa?
Dialog: 0,0:20:23.21,0:20:26.67,teks umum,,0,0,0,,Ya. Dia meletakkan penghadang di sekeliling saya untuk menyembunyikannya
Dialog: 0,0:20:26.75,0:20:29.30,teks umum,,0,0,0,,dan melemparkan Moo Dok kepadanya supaya dia dapat kenyang
Dialog: 0,0:20:29.38,0:20:30.84,teks umum,,0,0,0,,Dia berbohong
Dialog: 0,0:20:32.47,0:20:35.51,teks umum,,0,0,0,,Chan Wook memasuki bilik rakaman tanpa kebenaran
Dialog: 0,0:20:35.60,0:20:37.52,teks umum,,0,0,0,,dan memecahkan mangkuk buruj
Dialog: 0,0:20:37.60,0:20:39.93,teks umum,,0,0,0,,Dan apabila dia ditangkap,
Dialog: 0,0:20:40.02,0:20:42.94,teks umum,,0,0,0,,mula muncul dengan pelbagai perkara tentang penelan jiwa
Dialog: 0,0:20:44.81,0:20:46.52,teks umum,,0,0,0,,Saya pasti ia adalah penelan jiwa
Dialog: 0,0:20:46.61,0:20:48.57,teks umum,,0,0,0,,Dia berubah menjadi batu
Dialog: 0,0:20:48.65,0:20:50.78,teks umum,,0,0,0,,Pembantu rumah saya juga melihatnya
Dialog: 0,0:20:50.86,0:20:52.95,teks umum,,0,0,0,,Apabila saya tiba, saya tidak nampak mayat
Dialog: 0,0:20:53.03,0:20:54.62,teks umum,,0,0,0,,Dia mungkin menyembunyikannya
Dialog: 0,0:20:54.70,0:20:56.45,teks umum,,0,0,0,, Tutup semua pintu keluar
Dialog: 0,0:20:56.53,0:20:59.37,teks umum,,0,0,0,,dan temui penelan jiwa sebelum dia membawanya keluar
Dialog: 0,0:21:02.37,0:21:06.59,teks umum,,0,0,0,,Saya rasa kebenaran akan terbongkar apabila kita menjumpai mayat
Dialog: 0,0:21:09.51,0:21:12.43,teks umum,,0,0,0,,Saya akan memanggil ahli silap mata untuk memeriksa Jeonbugwan
Dialog: 0,0:21:12.51,0:21:15.93,teks umum,,0,0,0,,Anda tidak boleh berbuat demikian. Saya tidak boleh membiarkan mereka melakukan ini
Dialog: 0,0:21:16.01,0:21:18.35,teks umum,,0,0,0,,kerana pembohongan tidak berasas seseorang
Dialog: 0,0:21:23.98,0:21:25.31,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:21:26.48,0:21:28.52,teks umum,,0,0,0,,adakah sida diraja yang menelan jiwa?
Dialog: 0,0:21:28.61,0:21:29.48,teks umum,,0,0,0,,Ya
Dialog: 0,0:21:29.57,0:21:33.20,teks umum,,0,0,0,,Saya melihat dia bersama permaisuri ketika kami berduel
Dialog: 0,0:21:33.28,0:21:35.82,teks umum,,0,0,0,,Kasim Oh, siapa yang ada pada hari itu?
Dialog: 0,0:21:35.91,0:21:38.49,teks umum,,0,0,0,,Eunuch Kim. Dia berkhidmat untuk permaisuri
Dialog: 0,0:21:39.79,0:21:42.83,teks umum,,0,0,0,,Jadi, kita perlu menyemak sama ada dia berada di istana sekarang atau tidak
Dialog: 0,0:21:43.41,0:21:45.04,contact,,0,0,0,,Pergi semak
Dialog: 0,0:21:45.12,0:21:47.17,teks umum,,0,0,0,,Ini tidak perlu
Dialog: 0,0:22:10.36,0:22:11.61,italic,,0,0,0,,Permaisuri telah tiba!
Dialog: 0,0:22:11.69,0:22:13.28,miring,,0,0,0,,Sambut dia
Dialog: 0,0:22:20.91,0:22:21.99,teks umum,,0,0,0,,Ibu
Dialog: 0,0:22:23.33,0:22:25.62,teks umum,,0,0,0,,Timbalan timbalan memberitahu saya tentang apa yang berlaku
Dialog: 0,0:22:25.71,0:22:27.63,teks umum,,0,0,0,,Saya terkejut, jadi saya datang sendiri
Dialog: 0,0:22:31.25,0:22:34.22,teks umum,,0,0,0,,Adakah mereka benar-benar menemui penelan jiwa di sini?
Dialog: 0,0:22:34.88,0:22:37.26,contact,,0,0,0,,Sida yang berkhidmat kepada kamu adalah seorang nomad
Dialog: 0,0:22:37.34,0:22:39.93,teks umum,,0,0,0,,Dia telah menjadi liar dan membatu di sini
Dialog: 0,0:22:41.72,0:22:44.02,teks umum,,0,0,0,,- Adakah begitu?\N- Ini tidak benar
Dialog: 0,0:22:44.60,0:22:46.98,teks umum,,0,0,0,,Tiada seorang pun di sini menjadi batu
Dialog: 0,0:22:47.06,0:22:48.27,teks umum,,0,0,0,,Ini adalah pembohongan,
Dialog: 0,0:22:49.56,0:22:51.23,teks umum,,0,0,0,,yang dicipta oleh Chan Wook
Dialog: 0,0:22:51.32,0:22:55.95,teks umum,,0,0,0,,Kita akan tahu sama ada ini benar atau salah apabila kita mengetahui di mana sida itu berada
Dialog: 0,0:22:58.78,0:23:02.62,teks umum,,0,0,0,,Siapakah sida yang didakwa menjadi batu?
Dialog: 0,0:23:03.70,0:23:05.00,teks umum,,0,0,0,,Eunuch Kim
Dialog: 0,0:23:12.59,0:23:15.97,teks umum,,0,0,0,,Eunuch Kim tiba di sini bersama saya
Dialog: 0,0:23:26.73,0:23:28.52,teks umum,,0,0,0,,Eunuch Kim, masukkan
Dialog: 0,0:24:01.68,0:24:03.22,teks umum,,0,0,0,,Sida-sida ini
Dialog: 0,0:24:04.30,0:24:06.22,teks umum,,0,0,0,,anda lihat
Dialog: 0,0:24:06.81,0:24:08.47,teks umum,,0,0,0,, membatu?
Dialog: 0,0:24:10.23,0:24:11.27,teks umum,,0,0,0,,Ya
Dialog: 0,0:24:11.35,0:24:13.98,miring,,0,0,0,,Kamu kata dia menjadi liar
Dialog: 0,0:24:14.06,0:24:16.40,teks umum,,0,0,0,,Tetapi dia berdiri di sini hidup dan sihat
Dialog: 0,0:24:17.82,0:24:19.07,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:24:23.07,0:24:24.62,teks umum,,0,0,0,,Dia baik-baik saja
Dialog: 0,0:24:33.29,0:24:35.46,contact,,0,0,0,,Satu-satunya cara untuk menyelesaikan masalah ini ialah,
Dialog: 0,0:24:38.46,0:24:41.01,teks umum,,0,0,0,,hidupkan dia kembali
Dialog: 0,0:24:57.15,0:24:58.77,luar skrin,,0,0,0,,Dia baik-baik saja, baik-baik saja
Dialog: 0,0:24:59.90,0:25:01.94,suara,,0,0,0,,Jika ini adalah kuasa batu ais,
Dialog: 0,0:25:02.03,0:25:04.49,suara,,0,0,0,,yang bermakna saya boleh menyelamatkan Moo Deok, walaupun dia menjadi liar
Dialog: 0,0:25:05.41,0:25:06.41,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,0:25:07.70,0:25:09.58,teks umum,,0,0,0,,kita pasti telah membuat kesilapan
Dialog: 0,0:25:11.41,0:25:12.79,teks umum,,0,0,0,,Mungkin pemiliknya
Dialog: 0,0:25:15.04,0:25:17.63,teks umum,,0,0,0,,Anda tidak silap. Awak tipu
Dialog: 0,0:25:17.71,0:25:19.80,teks umum,,0,0,0,,Dia berdiri di sini hidup-hidup,
Dialog: 0,0:25:20.67,0:25:22.84,teks umum,,0,0,0,,ternyata saya betul-betul berbohong
Dialog: 0,0:25:27.30,0:25:29.26,teks umum,,0,0,0,,Dia cuba menipu semua orang,
Dialog: 0,0:25:29.35,0:25:32.56,teks umum,,0,0,0,,kerana saya memecahkan cawan buruj
Dialog: 0,0:25:32.64,0:25:33.85,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:25:35.23,0:25:36.98,teks umum,,0,0,0,,adakah ini benar?
Dialog: 0,0:25:38.61,0:25:42.23,teks umum,,0,0,0,,Ya. Semua yang saya katakan adalah pembohongan
Dialog: 0,0:25:45.07,0:25:48.28,teks umum,,0,0,0,,Saya pergi ke Jeonbugwan, memecahkan peninggalan itu,
Dialog: 0,0:25:48.37,0:25:52.20,teks umum,,0,0,0,,dan kemudian berbohong untuk menyembunyikannya?
Dialog: 0,0:25:52.29,0:25:55.00,teks umum,,0,0,0,,Maaf, saya minta maaf
Dialog: 0,0:25:57.71,0:25:59.46,teks umum,,0,0,0,,Dia adalah ahli silap mata Sosnovy Bor,
Dialog: 0,0:25:59.54,0:26:02.38,teks umum,,0,0,0,,Saya secara peribadi memohon maaf atasnya
Dialog: 0,0:26:04.09,0:26:07.01,teks umum,,0,0,0,,Saya memohon maaf kepada Timbalan Jin Mu
Dialog: 0,0:26:11.18,0:26:15.81,teks umum,,0,0,0,,Hutan pain akan membetulkan mangkuk
Dialog: 0,0:26:18.19,0:26:19.40,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:26:19.48,0:26:20.69,condong,,0,0,0,,Jangan tolak
Dialog: 0,0:26:20.77,0:26:23.23,teks umum,,0,0,0,,Ini adalah satu-satunya cara kita boleh bertanggungjawab atas perkara ini
Dialog: 0,0:26:24.94,0:26:26.40,teks umum,,0,0,0,,- Tidak bernilai\N- Yang Amat Mulia
Dialog: 0,0:26:26.99,0:26:29.66,teks umum,,0,0,0,,Biar Sosnovy Bor membetulkan ralat
Dialog: 0,0:26:31.95,0:26:33.49,teks umum,,0,0,0,,Biarlah ibu
Dialog: 0,0:26:35.54,0:26:37.41,teks umum,,0,0,0,,Lakukan sesuka hati
Dialog: 0,0:26:38.54,0:26:40.63,teks umum,,0,0,0,,Sudah tiba masanya untuk saya kembali
Dialog: 0,0:27:03.44,0:27:06.40,teks umum,,0,0,0,,Saya akan menghantar orang saya esok,
Dialog: 0,0:27:06.49,0:27:08.36,teks umum,,0,0,0,,untuk membaiki mangkuk yang pecah
Dialog: 0,0:27:09.11,0:27:12.41,teks umum,,0,0,0,,Dan sekarang saya mesti kembali untuk menghukum ahli silap mata dengan betul,
Dialog: 0,0:27:12.49,0:27:15.70,teks umum,,0,0,0,,yang berbohong kepada putera raja dan rakyat Jeonbugwan
Dialog: 0,0:27:16.75,0:27:18.21,teks umum,,0,0,0,,- Maju\N- Ini tidak akan berfungsi
Dialog: 0,0:27:18.91,0:27:22.21,teks umum,,0,0,0,,Chan Wook akan kekal dan dihukum di sini
Dialog: 0,0:27:27.46,0:27:29.26,teks umum,,0,0,0,,Saya juga fikir begitu...
Dialog: 0,0:27:30.26,0:27:32.09,teks umum,,0,0,0,,Apa yang sedang berlaku, Yang Amat Mulia
Dialog: 0,0:27:32.89,0:27:34.60,teks umum,,0,0,0,,Selamatkan tuanku
Dialog: 0,0:27:35.22,0:27:37.39,teks umum,,0,0,0,,Jika dia dibawa ke Sosnovy Bor,
Dialog: 0,0:27:40.06,0:27:43.81,teks umum,,0,0,0,,dia akan dipukul hingga mati di sana
Dialog: 0,0:27:46.19,0:27:47.69,miring,,0,0,0,,Kali terakhir
Dialog: 0,0:27:47.78,0:27:49.90,teks umum,,0,0,0,,dia menerima seratus tamparan
Dialog: 0,0:27:50.61,0:27:52.70,teks umum,,0,0,0,,Kali ini akan menjadi lebih teruk
Dialog: 0,0:27:52.78,0:27:54.91,teks umum,,0,0,0,,Jangan biarkan ini berlaku
Dialog: 0,0:27:56.91,0:27:58.12,teks umum,,0,0,0,,Moo Dok, cukuplah
Dialog: 0,0:28:00.12,0:28:03.25,teks umum,,0,0,0,,Saya melakukan salah dan akan dihukum
Dialog: 0,0:28:06.88,0:28:09.05,teks umum,,0,0,0,,Saya tidak menunjukkan rasa hormat yang sewajarnya kepada Baginda
Dialog: 0,0:28:11.63,0:28:13.43,teks umum,,0,0,0,,Saya tidak berani meminta belas kasihan
Dialog: 0,0:28:13.51,0:28:17.35,teks umum,,0,0,0,, Kemudian biarkan mereka menangkap kamu dan membunuh kamu?
Dialog: 0,0:28:18.06,0:28:20.27,teks umum,,0,0,0,,Jika ketua mahukannya, ya
Dialog: 0,0:28:23.15,0:28:23.98,teks umum,,0,0,0,,Syurga...
Dialog: 0,0:28:29.94,0:28:31.40,teks umum,,0,0,0,,Anda boleh jemput saya
Dialog: 0,0:28:33.82,0:28:35.57,teks umum,,0,0,0,,Begitulah, tuan!
Dialog: 0,0:28:35.66,0:28:37.28,teks umum,,0,0,0,,Anda akan mati!
Dialog: 0,0:28:37.91,0:28:41.96,teks umum,,0,0,0,,Anda akan mati jika anda kembali ke Sosnovy Bor!
Dialog: 0,0:28:44.58,0:28:49.05,teks umum,,0,0,0,,Saya akan menghukum dia seperti yang dikehendaki oleh set peraturan
Dialog: 0,0:28:53.26,0:28:54.93,teks umum,,0,0,0,,Hei, awak. Tunggu
Dialog: 0,0:28:59.47,0:29:01.52,teks umum,,0,0,0,,Chan Wook akan dihukum,
Dialog: 0,0:29:01.60,0:29:03.23,teks umum,,0,0,0,,lupakan apa yang berlaku
Dialog: 0,0:29:04.27,0:29:05.81,teks umum,,0,0,0,,Ini hanya lucu
Dialog: 0,0:29:05.90,0:29:06.94,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:29:07.48,0:29:09.98,teks umum,,0,0,0,,kisah kuki lebih teruk
Dialog: 0,0:29:10.69,0:29:13.32,teks umum,,0,0,0,,Ketua Hutan Pine dan Timbalan Gwangju
Dialog: 0,0:29:13.40,0:29:15.03,teks umum,,0,0,0,,bergaduh kerana kuki?
Dialog: 0,0:29:15.99,0:29:16.99,teks umum,,0,0,0,,Hanya ketawa
Dialog: 0,0:29:17.74,0:29:19.16,teks umum,,0,0,0,,Alasan paling bodoh
Dialog: 0,0:29:20.99,0:29:21.83,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:29:24.25,0:29:26.17,teks umum,,0,0,0,,Tetapi bagaimana mangkuk buruj itu pecah?
Dialog: 0,0:29:29.13,0:29:31.09,teks umum,,0,0,0,,Jika kilat menyambar,
Dialog: 0,0:29:31.17,0:29:33.63,teks umum,,0,0,0,,bermaksud pintu pagar di atas mangkuk telah dibuka
Dialog: 0,0:29:33.72,0:29:36.93,teks umum,,0,0,0,,Tetapi hanya mereka yang telah menguasai Chisa boleh melakukan ini
Dialog: 0,0:29:37.93,0:29:39.14,teks umum,,0,0,0,,Itu sahaja
Dialog: 0,0:29:42.27,0:29:44.69,teks umum,,0,0,0,,Chan Wook tidak memiliki Chisu
Dialog: 0,0:29:48.98,0:29:51.02,teks umum,,0,0,0,,Bagaimanakah cawan itu pecah?
Dialog: 0,0:29:56.99,0:30:00.95,luar skrin,,0,0,0,,Adakah orang lain di sini yang memiliki Chisu?
Dialog: 0,0:30:01.70,0:30:03.37,di sebalik tabir,,0,0,0,,Ini mustahil
Dialog: 0,0:30:19.89,0:30:23.14,teks umum,,0,0,0,,Kami keluar dari situ terima kasih kepada anda, Moo Deok
Dialog: 0,0:30:23.22,0:30:25.02,teks umum,,0,0,0,,Jika anda cuba pergi, mereka akan menghalang anda
Dialog: 0,0:30:25.10,0:30:27.27,teks umum,,0,0,0,,Dan jika anda memutuskan untuk kekal, mereka akan cuba menghalau anda
Dialog: 0,0:30:27.35,0:30:31.15,teks umum,,0,0,0,,Jadi anda sengaja mengadakan persembahan ini? Pintar
Dialog: 0,0:30:31.23,0:30:34.15,teks umum,,0,0,0,,Saya memutuskan bahawa anda tidak akan meyakinkan mereka,
Dialog: 0,0:30:34.23,0:30:36.45,teks umum,,0,0,0,,jadi saya campur tangan tanpa kebenaran
Dialog: 0,0:30:36.53,0:30:38.57,teks umum,,0,0,0,,Maaf kerana menceroboh
Dialog: 0,0:30:39.41,0:30:42.49,teks umum,,0,0,0,,Saya tidak sangka ini, jadi saya terkejut
Dialog: 0,0:30:44.49,0:30:45.66,teks umum,,0,0,0,,Tetapi anda hebat
Dialog: 0,0:30:47.33,0:30:48.54,teks umum,,0,0,0,,Bab
Dialog: 0,0:30:48.62,0:30:50.58,teks umum,,0,0,0,,Kami tidak berbohong
Dialog: 0,0:30:50.67,0:30:54.34,teks umum,,0,0,0,,Kami melihat bagaimana sida Kim menjadi liar dan membatu
Dialog: 0,0:30:54.42,0:30:55.71,teks umum,,0,0,0,,Saya tahu mereka tidak berbohong
Dialog: 0,0:30:56.34,0:30:58.72,miring,,0,0,0,,Kadang-kadang saya tidak berfikir dengan jelas,
Dialog: 0,0:30:58.80,0:31:00.68,teks umum,,0,0,0,,tetapi saya boleh membezakan pembohongan daripada kebenaran
Dialog: 0,0:31:01.64,0:31:03.39,miring,,0,0,0,,Dia membatu, tetapi dia sedar
Dialog: 0,0:31:03.47,0:31:07.10,teks umum,,0,0,0,,Jadi mereka ada batu ais?
Dialog: 0,0:31:07.89,0:31:09.56,teks umum,,0,0,0,,Sosnovy Bor lama dahulu
Dialog: 0,0:31:10.52,0:31:13.27,teks umum,,0,0,0,,menonton Jin Mu
Dialog: 0,0:31:13.94,0:31:15.44,teks umum,,0,0,0,,Semuanya seperti yang kita jangkakan
Dialog: 0,0:31:17.74,0:31:19.70,teks umum,,0,0,0,,Saya rasa mereka mempunyai batu itu
Dialog: 0,0:31:25.70,0:31:29.58,teks umum,,0,0,0,,Adakah anda menggunakan batu itu untuk menghidupkan saya?
Dialog: 0,0:31:29.66,0:31:32.00,teks umum,,0,0,0,,Kekuatannya sungguh menakjubkan
Dialog: 0,0:31:33.00,0:31:35.42,teks umum,,0,0,0,,Saya benar-benar berasa hidup
Dialog: 0,0:31:36.76,0:31:40.13,teks umum,,0,0,0,,Chan Wook menjadikan awak jadi batu?
Dialog: 0,0:31:41.05,0:31:44.10,teks umum,,0,0,0,,Tenaga tiba-tiba mula meninggalkan badan saya,
Dialog: 0,0:31:44.76,0:31:48.68,teks umum,,0,0,0,,ketika saya hampir kenyang dengan pembantu rumahnya
Dialog: 0,0:31:49.60,0:31:50.98,teks umum,,0,0,0,,Kemudian saya tidak sedarkan diri
Dialog: 0,0:31:52.15,0:31:55.65,teks umum,,0,0,0,,Pernahkah anda melihat bagaimana Chang Wook membuka bumbung di atas mangkuk buruj?
Dialog: 0,0:31:56.36,0:31:57.57,teks umum,,0,0,0,,Tidak, saya tidak melihatnya
Dialog: 0,0:31:58.82,0:32:01.36,teks umum,,0,0,0,,Mungkin ada ahli silap mata lain di sana selain Chan Wook?
Dialog: 0,0:32:02.32,0:32:03.57,teks umum,,0,0,0,,Tiada
Dialog: 0,0:32:04.74,0:32:06.91,teks umum,,0,0,0,,Bagaimana jika Chang Wook sudah memiliki Chisu?
Dialog: 0,0:32:07.66,0:32:08.95,teks umum,,0,0,0,,Mungkin dia hanya menyembunyikannya
Dialog: 0,0:32:10.66,0:32:14.29,teks umum,,0,0,0,,Apabila dia menyerang saya, dia tidak kelihatan sangat mahir
Dialog: 0,0:32:14.38,0:32:17.50,teks umum,,0,0,0,,Dia menguasai Ryusu dalam masa yang sangat singkat
Dialog: 0,0:32:18.34,0:32:19.67,teks umum,,0,0,0,,Jadi mungkin
Dialog: 0,0:32:22.63,0:32:24.68,contact,,0,0,0,,Sekarang ada batu ais dalam diri saya,
Dialog: 0,0:32:24.76,0:32:27.97,teks umum,,0,0,0,, adakah ini bermakna saya memiliki Hwansu?
Dialog: 0,0:32:31.23,0:32:33.40,teks umum,,0,0,0,,Anda benar-benar mempunyai kuasa sedemikian
Dialog: 0,0:32:34.44,0:32:37.32,teks umum,,0,0,0,,Tetapi anda tidak tahu bagaimana untuk menggunakan mantra,
Dialog: 0,0:32:37.40,0:32:40.28,teks umum,,0,0,0,,jadi anda tidak boleh menggunakan kuasa ini
Dialog: 0,0:32:45.95,0:32:48.79,teks umum,,0,0,0,,Tetapi batu ais itu milik saya sekarang
Dialog: 0,0:32:48.87,0:32:51.83,teks umum,,0,0,0,,Saya menghidupkan awak untuk seketika kerana kita tiada pilihan lain
Dialog: 0,0:33:45.76,0:33:47.76,teks umum,,0,0,0,,Jadi, batu
Dialog: 0,0:33:47.84,0:33:50.35,teks umum,,0,0,0,,boleh menghalang transformasi nomad
Dialog: 0,0:33:51.31,0:33:52.85,teks umum,,0,0,0,,Kita mesti cari dia dan musnahkan dia
Dialog: 0,0:33:53.64,0:33:57.27,teks umum,,0,0,0,,Kita mesti memusnahkan semua nomad, dan dia menghidupkan mereka kembali
Dialog: 0,0:33:57.35,0:33:59.19,teks umum,,0,0,0,,Kuasanya sungguh dahsyat
Dialog: 0,0:34:00.86,0:34:01.90,teks umum,,0,0,0,,Tetapi ini...
Dialog: 0,0:34:03.74,0:34:07.24,italic,,0,0,0,,Uk, mereka akan segera mengetahui tentang hukuman anda,
Dialog: 0,0:34:07.32,0:34:09.16,teks umum,,0,0,0,,jadi anda tidak boleh kembali
Dialog: 0,0:34:09.87,0:34:11.24,teks umum,,0,0,0,,Duduk di rumah buat seketika
Dialog: 0,0:34:11.33,0:34:15.16,teks umum,,0,0,0,,Baiklah, saya dan Moo Deok akan pulang
Dialog: 0,0:34:15.25,0:34:19.58,teks umum,,0,0,0,,Cuba untuk tidak menarik perhatian Jin Mu
Dialog: 0,0:34:20.84,0:34:21.84,teks umum,,0,0,0,,Ya
Dialog: 0,0:34:23.88,0:34:25.01,teks umum,,0,0,0,,Jom
Dialog: 0,0:34:33.27,0:34:35.39,teks umum,,0,0,0,,Dia akan menyingkirkan batu itu sebaik sahaja dia menerimanya
Dialog: 0,0:34:35.48,0:34:37.39,teks umum,,0,0,0,,Kita perlu mencarinya lebih awal
Dialog: 0,0:34:37.48,0:34:39.06,teks umum,,0,0,0,,Kil Ju betul
Dialog: 0,0:34:39.77,0:34:42.48,teks umum,,0,0,0,,Batu di istana
Dialog: 0,0:34:43.02,0:34:46.19,teks umum,,0,0,0,,Jadi Dan Zhu, yang memiliki batu itu...
Dialog: 0,0:34:47.15,0:34:48.45,teks umum,,0,0,0,,inilah orang itu
Dialog: 0,0:34:52.74,0:34:55.12,teks umum,,0,0,0,,Hadapi segalanya dengan senyap
Dialog: 0,0:34:55.20,0:34:57.79,teks umum,,0,0,0,,Saya akan menghantar wanita mahkamah Khan sebaliknya
Dialog: 0,0:34:57.87,0:35:00.08,teks umum,,0,0,0,,Anda akan menghantar mesej melaluinya
Dialog: 0,0:35:00.75,0:35:01.92,teks umum,,0,0,0,,Saya faham awak
Dialog: 0,0:35:02.63,0:35:06.80,teks umum,,0,0,0,,Disebabkan apa yang berlaku, Sosnovy Bor kini akan mengesyaki saya
Dialog: 0,0:35:07.38,0:35:12.01,teks umum,,0,0,0,,Ini berlaku kerana anda memandang rendah Chan Wook
Dialog: 0,0:35:12.60,0:35:15.43,teks umum,,0,0,0,,Saya tidak sangka dia akan membebaskan dirinya secepat itu
Dialog: 0,0:35:15.52,0:35:17.77,teks umum,,0,0,0,,Dia seorang genius yang menguasai Ryusu serta-merta
Dialog: 0,0:35:17.85,0:35:20.02,teks umum,,0,0,0,,Dia dilahirkan dengan tenaga bintang Raja
Dialog: 0,0:35:20.10,0:35:21.73,teks umum,,0,0,0,,Saya tidak serta-merta mula memandang rendah dia
Dialog: 0,0:35:22.69,0:35:24.32,contact,,0,0,0,,Saya fikir dia istimewa,
Dialog: 0,0:35:24.40,0:35:27.19,teks umum,,0,0,0,,sejak dia dilahirkan di bawah tanda bintang sedemikian
Dialog: 0,0:35:27.28,0:35:30.53,teks umum,,0,0,0,,Namun, Chan Wook ternyata benar-benar mengecewakan
Dialog: 0,0:35:30.61,0:35:33.33,teks umum,,0,0,0,,Dia seorang budak yang sederhana, tiada yang luar biasa
Dialog: 0,0:35:36.41,0:35:40.08,teks umum,,0,0,0,,Marah pada dunia, dia menyembunyikan ketidakberdayaan dan kemalasannya
Dialog: 0,0:35:40.17,0:35:44.29,teks umum,,0,0,0,,bertopengkan ketenangan. Dia tidak pernah mempunyai matlamat
Dialog: 0,0:35:44.88,0:35:47.34,contact,,0,0,0,,Dia hanyalah seorang pemuda yang mulia dengan harga diri yang tinggi,
Dialog: 0,0:35:47.92,0:35:50.26,teks umum,,0,0,0,,jadi cukuplah untuk melayaninya
Dialog: 0,0:35:51.22,0:35:53.14,teks umum,,0,0,0,,Jadi ia telah berubah
Dialog: 0,0:35:54.22,0:35:55.85,teks umum,,0,0,0,,Saya fikir dia lemah
Dialog: 0,0:35:55.93,0:35:58.73,teks umum,,0,0,0,,Tetapi dia membuka pintu tenaga dengan meminum racun
Dialog: 0,0:35:58.81,0:36:02.15,teks umum,,0,0,0,,Saya fikir dia hanya seorang bangang, tetapi dia benar-benar mengalahkan Putera Mahkota
Dialog: 0,0:36:03.19,0:36:05.27,teks umum,,0,0,0,,Apa yang membuatkan dia berubah sangat?
Dialog: 0,0:36:05.36,0:36:07.19,teks umum,,0,0,0,,Orang berubah
Dialog: 0,0:36:08.69,0:36:10.15,teks umum,,0,0,0,,demi orang lain
Dialog: 0,0:36:11.45,0:36:14.20,teks umum,,0,0,0,,Cari orang yang muncul dalam hidupnya sejurus sebelum semua perubahan
Dialog: 0,0:36:17.24,0:36:18.41,teks umum,,0,0,0,,Inilah jawapannya
Dialog: 0,0:36:22.29,0:36:25.84,teks umum,,0,0,0,,Chan Wook ditolak oleh dua belas guru, tetapi dia masih menemui jalannya
Dialog: 0,0:36:29.46,0:36:31.13,teks umum,,0,0,0,,Siapa yang boleh membantunya dengan ini?
Dialog: 0,0:36:34.89,0:36:37.47,teks umum,,0,0,0,,Cikgu, boleh kami pergi ke Danhyangok segera?
Dialog: 0,0:36:38.81,0:36:41.43,teks umum,,0,0,0,,Terima kasih kepada hukuman saya, kita ada masa
Dialog: 0,0:36:42.02,0:36:43.77,teks umum,,0,0,0,,Jom berlatih di Danhyangk
Dialog: 0,0:36:43.85,0:36:46.65,teks umum,,0,0,0,,Kita boleh cuba memanjat pokok itu
Dialog: 0,0:36:50.78,0:36:52.74,teks umum,,0,0,0,,Sangat sejuk di Danhyangk sekarang
Dialog: 0,0:36:53.66,0:36:56.12,teks umum,,0,0,0,,Jika kita terperangkap di sana kerana salji,
Dialog: 0,0:36:57.12,0:36:58.58,teks umum,,0,0,0,,kita mungkin mati kelaparan
Dialog: 0,0:36:58.66,0:37:01.66,teks umum,,0,0,0,,Saya fikir di sana panas pada musim sejuk dan terdapat banyak makanan
Dialog: 0,0:37:01.75,0:37:04.08,teks umum,,0,0,0,,Kamu berkata begitu kepada Yulia kali terakhir
Dialog: 0,0:37:08.00,0:37:11.34,teks umum,,0,0,0,,Saya berkata begitu untuk menenangkannya
Dialog: 0,0:37:15.84,0:37:19.22,teks umum,,0,0,0,,Dia bimbang burung peliharaannya mengalami kesukaran pada musim sejuk,
Dialog: 0,0:37:19.31,0:37:20.72,teks umum,,0,0,0,,jadi saya berbohong
Dialog: 0,0:37:21.56,0:37:25.94,teks umum,,0,0,0,,Adakah anda bercakap tentang burung yang dia panggil dengan wisel semasa dia berada di Danhyangok?
Dialog: 0,0:37:47.79,0:37:50.96,teks umum,,0,0,0,,Jin Mu hampir membunuh Wook?
Dialog: 0,0:37:52.38,0:37:56.38,teks umum,,0,0,0,,Saya meminta maaf untuk Uka dan membawanya pergi dari sana
Dialog: 0,0:37:56.47,0:37:59.22,teks umum,,0,0,0,,Tetapi Jin Mu mungkin cuba mencederakannya
Dialog: 0,0:38:02.35,0:38:05.60,teks umum,,0,0,0,,Nasib baik, saya berkeras untuk membaiki mangkuk buruj,
Dialog: 0,0:38:05.69,0:38:07.40,teks umum,,0,0,0,,jadi kami akan mendapat akses kepada Jeonbugwan
Dialog: 0,0:38:09.81,0:38:13.03,teks umum,,0,0,0,,Anda akan pergi ke Jeonbugwan bersama pekerja Sosnovy Bor
Dialog: 0,0:38:13.74,0:38:15.36,teks umum,,0,0,0,,dan anda akan menjaga Jin Mu
Dialog: 0,0:38:16.74,0:38:18.07,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:38:27.42,0:38:28.67,teks umum,,0,0,0,,Sang Ho
Dialog: 0,0:38:29.58,0:38:32.34,teks umum,,0,0,0,,Saya mendengar bahawa Moo Deok juga berada di Jeonbugwan
Dialog: 0,0:38:32.42,0:38:34.09,teks umum,,0,0,0,,Adakah dia okay?
Dialog: 0,0:38:34.17,0:38:35.47,teks umum,,0,0,0,,Ya
Dialog: 0,0:38:38.97,0:38:42.64,teks umum,,0,0,0,,Perantau yang menjadi liar dan berubah menjadi batu,
Dialog: 0,0:38:42.72,0:38:44.56,teks umum,,0,0,0,, benar-benar kembali hidup?
Dialog: 0,0:38:44.64,0:38:48.10,teks umum,,0,0,0,,Jadi bab itu terpaksa kembali tanpa berkata apa-apa
Dialog: 0,0:38:50.61,0:38:52.40,teks umum,,0,0,0,,Bagaimanakah reaksi Uk terhadap perkara ini?
Dialog: 0,0:38:52.98,0:38:54.86,teks umum,,0,0,0,,Nampaknya dia tidak terkejut
Dialog: 0,0:38:55.40,0:38:58.20,teks umum,,0,0,0,,Dia bertanya kepada kepala jika batu ais
Dialog: 0,0:38:58.28,0:39:00.91,teks umum,,0,0,0,,hidupkan semula jiwa yang ditelan
Dialog: 0,0:39:00.99,0:39:03.03,teks umum,,0,0,0,,Nampaknya dia sudah tahu mengenainya
Dialog: 0,0:39:05.54,0:39:08.54,teks umum,,0,0,0,,Jadi, dia sendiri melihat bagaimana nomad itu hidup
Dialog: 0,0:39:08.62,0:39:11.08,teks umum,,0,0,0,,Ketua memberitahunya bahawa mereka perlu dimusnahkan
Dialog: 0,0:39:12.25,0:39:14.25,contact,,0,0,0,,Dan nomad dan batu
Dialog: 0,0:39:14.34,0:39:16.51,teks umum,,0,0,0,,Singkirkan segala yang jahat
Dialog: 0,0:39:19.43,0:39:21.80,teks umum,,0,0,0,,Dan apakah jawapan Uk untuk perkara ini?
Dialog: 0,0:39:21.89,0:39:23.81,italic,,0,0,0,,Ini cuma tekaan saya,
Dialog: 0,0:39:24.76,0:39:26.31,teks umum,,0,0,0,,tetapi nampaknya dia tidak bersetuju dengannya
Dialog: 0,0:39:27.14,0:39:30.40,contact,,0,0,0,,Chan Wook sentiasa riang dan riang
Dialog: 0,0:39:30.48,0:39:34.44,teks umum,,0,0,0,,Tetapi anda tidak boleh merawat sihir gelap seperti itu
Dialog: 0,0:39:35.53,0:39:37.49,italic,,0,0,0,,Anda dan Uk rapat
Dialog: 0,0:39:37.57,0:39:39.57,teks umum,,0,0,0,,Anda harus memberi amaran kepadanya
Dialog: 0,0:39:51.75,0:39:54.25,teks umum,,0,0,0,,Ia bukan sahaja sejuk di Danhyangk,
Dialog: 0,0:39:54.34,0:39:56.67,teks umum,,0,0,0,,tiada sesiapa pun di sana
Dialog: 0,0:39:57.55,0:39:59.88,teks umum,,0,0,0,,Kita tidak boleh bersendirian sekarang
Dialog: 0,0:40:00.72,0:40:02.22,teks umum,,0,0,0,,Mengapa ini tiba-tiba?
Dialog: 0,0:40:04.97,0:40:06.14,teks umum,,0,0,0,,Saya takut,
Dialog: 0,0:40:08.77,0:40:10.31,teks umum,,0,0,0,,bahawa saya akan menyerap tenaga anda
Dialog: 0,0:40:10.89,0:40:14.15,teks umum,,0,0,0,,Anda tidak menjadi liar. Tiada apa-apa yang berlaku, walaupun selepas hubungan kami
Dialog: 0,0:40:14.23,0:40:16.57,teks umum,,0,0,0,, Kerana saya menyerap tenaga sida-sida itu
Dialog: 0,0:40:17.15,0:40:18.57,contact,,0,0,0,,Semuanya baik sekarang,
Dialog: 0,0:40:18.65,0:40:21.11,teks umum,,0,0,0,,tetapi kita tidak tahu bila perkara ini mungkin berlaku lagi
Dialog: 0,0:40:22.95,0:40:24.41,teks umum,,0,0,0,,Jika perlu,
Dialog: 0,0:40:25.20,0:40:26.95,teks umum,,0,0,0,,anda boleh lari atau bunuh saya
Dialog: 0,0:40:29.41,0:40:31.33,teks umum,,0,0,0,,Tetapi jika saya menyerap tenaga anda,
Dialog: 0,0:40:33.54,0:40:35.04,teks umum,,0,0,0,,Saya tidak tahan ini
Dialog: 0,0:40:44.09,0:40:45.30,teks umum,,0,0,0,,Apa yang kelakar?
Dialog: 0,0:40:45.97,0:40:47.47,teks umum,,0,0,0,,Adakah anda berseronok?
Dialog: 0,0:40:48.26,0:40:49.60,teks umum,,0,0,0,,Tidak, bukan itu maksudnya
Dialog: 0,0:40:52.56,0:40:53.73,teks umum,,0,0,0,,Hati saya berdebar-debar
Dialog: 0,0:40:56.36,0:40:57.90,teks umum,,0,0,0,,Ini adalah kata-kata anda
Dialog: 0,0:40:59.19,0:41:01.57,teks umum,,0,0,0,,membawa makna yang lebih daripada "Saya merindui awak"
Dialog: 0,0:41:04.61,0:41:06.99,teks umum,,0,0,0,,Shadow Warrior akhirnya menjawab
Dialog: 0,0:41:08.33,0:41:10.95,teks umum,,0,0,0,,kepada pengisytiharan cinta saya yang naif dan ikhlas
Dialog: 0,0:41:20.17,0:41:22.05,teks umum,,0,0,0,,Saya akan jumpa batu,
Dialog: 0,0:41:22.76,0:41:26.01,teks umum,,0,0,0,,jadi anda tidak perlu menyerap tenaga saya
Dialog: 0,0:41:33.06,0:41:35.19,teks umum,,0,0,0,,Anda perlu menentang Park Jin
Dialog: 0,0:41:35.27,0:41:38.11,teks umum,,0,0,0,,Maka saya akan menjadi sekuat
Dialog: 0,0:41:42.49,0:41:45.49,teks umum,,0,0,0,,Anda kalah sembilan pertempuran berturut-turut kepada ahli silap mata Jeonjingak
Dialog: 0,0:41:46.78,0:41:48.12,teks umum,,0,0,0,,Angkuh
Dialog: 0,0:41:51.41,0:41:54.96,teks umum,,0,0,0,,Tepat sekali, jed yin-yang. Saya perlu mengembalikannya
Dialog: 0,0:41:56.12,0:41:59.71,teks umum,,0,0,0,,Tetapi bagaimana anda memanggil Putera Mahkota?
Dialog: 0,0:42:01.59,0:42:03.80,teks umum,,0,0,0,,Ada satu cara...
Dialog: 0,0:42:04.88,0:42:06.59,teks umum,,0,0,0,,Dia membuat jantung saya berdegup kencang
Dialog: 0,0:42:26.74,0:42:29.41,contact,,0,0,0,,Chan Wook, yang didakwa pesalah, tidak mempunyai pedang
Dialog: 0,0:42:30.87,0:42:33.83,teks umum,,0,0,0,,Tetapi Jin Mu mempunyainya, walaupun dia menegaskan dia tidak bersalah
Dialog: 0,0:42:46.67,0:42:48.13,teks umum,,0,0,0,,En.
Dialog: 0,0:42:48.22,0:42:51.10,teks umum,,0,0,0,,Cikgu Li, apa yang membawa anda ke sini?
Dialog: 0,0:42:51.18,0:42:53.22,teks umum,,0,0,0,,Mengapa anda tidak berada di Sosnovy Bor, tetapi di rumah?
Dialog: 0,0:42:54.47,0:42:56.06,teks umum,,0,0,0,,Dia dihukum
Dialog: 0,0:42:58.48,0:43:00.19,teks umum,,0,0,0,,Dihukum? Untuk apa?
Dialog: 0,0:43:00.94,0:43:02.77,teks umum,,0,0,0,,Apa yang telah anda lakukan kali ini?
Dialog: 0,0:43:02.86,0:43:04.23,teks umum,,0,0,0,,Tidak, bukan begitu
Dialog: 0,0:43:04.32,0:43:07.15,teks umum,,0,0,0,,Hamba Kim, jangan risau sangat
Dialog: 0,0:43:07.24,0:43:08.57,contact,,0,0,0,,Ia seperti...
Dialog: 0,0:43:09.99,0:43:11.99,teks umum,,0,0,0,,bukan hukuman sebenar
Dialog: 0,0:43:12.08,0:43:15.20,teks umum,,0,0,0,,Ia lebih kepada percutian yang menyamar sebagai hukuman
Dialog: 0,0:43:18.50,0:43:19.83,teks umum,,0,0,0,,Memang benar
Dialog: 0,0:43:21.33,0:43:22.38,miring,,0,0,0,,Selamat mendengar
Dialog: 0,0:43:23.63,0:43:26.80,teks umum,,0,0,0,,Kemudian kami akan memancing di Tasik Gyeongcheongdaeho
Dialog: 0,0:43:28.26,0:43:29.51,miring,,0,0,0,,Idea yang bagus
Dialog: 0,0:43:29.59,0:43:33.93,teks umum,,0,0,0,,Anda patut berehat di sini selepas meluangkan masa bersama Encik Chan
Dialog: 0,0:43:35.06,0:43:38.64,teks umum,,0,0,0,,Mustahil, pembantu Kim. Saya tidak boleh mengendur sekarang
Dialog: 0,0:43:38.73,0:43:40.10,contact,,0,0,0,,Cikgu Li, maaf
Dialog: 0,0:43:40.19,0:43:42.73,teks umum,,0,0,0,,Saya sudah kalah sembilan daripada sepuluh
Dialog: 0,0:43:42.81,0:43:44.61,teks umum,,0,0,0,,Peluang terakhir tinggal untuk menang
Dialog: 0,0:43:45.27,0:43:48.03,teks umum,,0,0,0,,Saya akan berlatih. Saya berharap untuk pemahaman anda
Dialog: 0,0:43:49.36,0:43:52.41,teks umum,,0,0,0,,Anda tiba-tiba menjadi begitu rajin
Dialog: 0,0:43:52.49,0:43:55.66,teks umum,,0,0,0,,Ya, matlamat saya adalah untuk membuat pembantu rumah Kim bangga dengan saya
Dialog: 0,0:43:55.74,0:43:57.70,teks umum,,0,0,0,,Saya tidak boleh duduk dan memancing
Dialog: 0,0:43:58.96,0:44:02.83,teks umum,,0,0,0,,Kebelakangan ini kata-kata awak menyentuh jiwa saya
Dialog: 0,0:44:03.63,0:44:04.59,contact,,0,0,0,,Okay
Dialog: 0,0:44:04.67,0:44:06.13,teks umum,,0,0,0,,Maju ke latihan
Dialog: 0,0:44:06.21,0:44:09.05,teks umum,,0,0,0,,Dan saya akan menyediakan gula-gula untuk anda
Dialog: 0,0:44:17.81,0:44:20.98,teks umum,,0,0,0,,Beritahu perkara sebenar, mengapa anda dihukum?
Dialog: 0,0:44:25.02,0:44:27.28,teks umum,,0,0,0,,Saya memecahkan cawan buruj di Jeonbugwan
Dialog: 0,0:44:28.36,0:44:30.19,teks umum,,0,0,0,,Jangan beritahu itu kepada pembantu rumah Kim
Dialog: 0,0:44:30.28,0:44:33.24,teks umum,,0,0,0,,Saya nampak kilat sabung-menyabung betul-betul di atas Jeonbugwan
Dialog: 0,0:44:33.32,0:44:34.78,teks umum,,0,0,0,,Saya rasa dia menyentuh cawan
Dialog: 0,0:44:35.66,0:44:39.37,teks umum,,0,0,0,,Kami tidak boleh memberitahu anda butirannya, tetapi pemilik tidak boleh dipersalahkan untuk apa-apa
Dialog: 0,0:44:40.87,0:44:43.33,teks umum,,0,0,0,,Ketua Sosnovy Bor akan memberitahu anda selebihnya
Dialog: 0,0:44:45.08,0:44:46.54,italic,,0,0,0,,saya pinjamkan pancing saya
Dialog: 0,0:44:46.63,0:44:48.46,teks umum,,0,0,0,,Saya dulu suka memancing
Dialog: 0,0:44:48.55,0:44:51.13,teks umum,,0,0,0,,Saya mempunyai beberapa yang sangat bagus
Dialog: 0,0:44:51.22,0:44:52.09,teks umum,,0,0,0,,saya bawa sekarang
Dialog: 0,0:44:57.43,0:44:58.64,teks umum,,0,0,0,,Maaf
Dialog: 0,0:45:00.35,0:45:04.10,teks umum,,0,0,0,,Saya ingin mengajarnya cara menangkap Ikan Emas
Dialog: 0,0:45:05.06,0:45:06.11,teks umum,,0,0,0,,Ikan emas?
Dialog: 0,0:45:06.69,0:45:10.19,teks umum,,0,0,0,,Anda bercakap tentang yang hanya boleh ditangkap
Dialog: 0,0:45:10.28,0:45:11.86,miring,,0,0,0,,di Tasik Gyeongcheongdaeho?
Dialog: 0,0:45:12.57,0:45:13.82,teks umum,,0,0,0,,Adakah anda tahu apa ini?
Dialog: 0,0:45:13.91,0:45:17.12,teks umum,,0,0,0,,Saya mendengar tentang dia. Ikan yang terbentuk daripada tenaga tasik
Dialog: 0,0:45:17.20,0:45:21.41,teks umum,,0,0,0,,Saya dengar hanya ahli silap mata yang telah menguasai Chisu atau lebih tinggi boleh menangkapnya
Dialog: 0,0:45:21.50,0:45:23.66,teks umum,,0,0,0,,Anda benar-benar tahu banyak
Dialog: 0,0:45:24.25,0:45:26.29,teks umum,,0,0,0,,Apabila anda menangkap ikan ini dan mengawalnya
Dialog: 0,0:45:26.38,0:45:28.00,contact,,0,0,0,,tenaga Tasik Gyeongcheongdaeho...
Dialog: 0,0:45:29.55,0:45:30.76,teks umum,,0,0,0,,Perasaan yang menyenangkan
Dialog: 0,0:45:32.13,0:45:35.76,teks umum,,0,0,0,,Kongsi ini dengan pemilik
Dialog: 0,0:45:35.84,0:45:36.84,teks umum,,0,0,0,,Dia sibuk
Dialog: 0,0:45:37.60,0:45:39.22,contact,,0,0,0,,Cikgu Li
Dialog: 0,0:45:39.31,0:45:41.18,teks umum,,0,0,0,,Cikgu Li, sila lihat
Dialog: 0,0:45:41.27,0:45:43.35,teks umum,,0,0,0,,Ini adalah pancing terbaik, ia diperbuat daripada buluh...
Dialog: 0,0:45:43.43,0:45:45.98,teks umum,,0,0,0,,Dia tidak sibuk, mulai esok
Dialog: 0,0:45:46.06,0:45:48.94,teks umum,,0,0,0,,dia akan memancing bersama kamu
Dialog: 0,0:45:50.48,0:45:52.49,teks umum,,0,0,0,,Apa yang awak cakapkan? Saya perlu berlatih
Dialog: 0,0:45:52.57,0:45:55.86,teks umum,,0,0,0,,Sekarang anda tidak sepatutnya memegang pedang, tetapi joran
Dialog: 0,0:45:57.16,0:46:00.24,teks umum,,0,0,0,,Pergi ke Tasik Gyeongcheongdaeho dan tangkap Ikan Emas
Dialog: 0,0:46:00.91,0:46:02.08,teks umum,,0,0,0,,Apa?
Dialog: 0,0:46:14.63,0:46:16.09,teks umum,,0,0,0,,Nampak seperti tempat yang bagus
Dialog: 0,0:46:16.72,0:46:18.14,teks umum,,0,0,0,,Tidak, tidak, Cikgu Li
Dialog: 0,0:46:18.84,0:46:22.52,teks umum,,0,0,0,,Saya pernah memancing di sini. Airnya sangat sejuk
Dialog: 0,0:46:22.60,0:46:25.35,miring,,0,0,0,,Tiada ikan di sini kerana mereka tiada apa-apa untuk dimakan
Dialog: 0,0:46:25.89,0:46:28.90,teks umum,,0,0,0,,Dan kami mengambil pancing yang buruk
Dialog: 0,0:46:28.98,0:46:32.40,teks umum,,0,0,0,,Ikan emas mesti ditangkap dengan pancing yang mudah bengkok
Dialog: 0,0:46:33.40,0:46:34.99,teks umum,,0,0,0,,Sama seperti ini
Dialog: 0,0:46:36.65,0:46:38.86,teks umum,,0,0,0,,Adakah ini umpan ikan?
Dialog: 0,0:46:39.45,0:46:40.62,teks umum,,0,0,0,,Ini adalah gula-gula
Dialog: 0,0:46:40.70,0:46:44.12,teks umum,,0,0,0,,Maiden Kim mengumpulnya untuk Master Lee
Dialog: 0,0:46:44.83,0:46:47.75,teks umum,,0,0,0,,Pembantu rumah Kim adalah seorang wanita yang sangat baik
Dialog: 0,0:46:48.33,0:46:50.25,teks umum,,0,0,0,,Di manakah umpannya?
Dialog: 0,0:46:50.33,0:46:52.42,teks umum,,0,0,0,,Kami memerlukan cacing atau ikan kecil
Dialog: 0,0:46:52.50,0:46:53.92,teks umum,,0,0,0,,Apa?
Dialog: 0,0:46:55.63,0:46:57.68,teks umum,,0,0,0,,Adakah anda memancing tanpa umpan?
Dialog: 0,0:46:57.76,0:47:01.05,teks umum,,0,0,0,,Saya memberitahu anda bahawa Ikan Emas memakan tenaga
Dialog: 0,0:47:01.80,0:47:04.47,contact,,0,0,0,,Tenaga saya akan pergi sepanjang batang buluh
Dialog: 0,0:47:05.10,0:47:07.02,teks umum,,0,0,0,,dan akan berfungsi sebagai umpan
Dialog: 0,0:47:08.60,0:47:09.60,teks umum,,0,0,0,, Tenaga anda?
Dialog: 0,0:47:10.69,0:47:13.77,teks umum,,0,0,0,,Guru, ulang selepas tuan
Dialog: 0,0:47:14.36,0:47:15.36,teks umum,,0,0,0,,Sekarang
Dialog: 0,0:47:22.32,0:47:26.37,teks umum,,0,0,0,,Kini anda hanya perlu mengawal tenaga tasik
Dialog: 0,0:47:26.45,0:47:28.66,teks umum,,0,0,0,,dan tunggu Ikan Emas menggigit
Dialog: 0,0:47:36.17,0:47:37.26,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:47:37.84,0:47:40.93,teks umum,,0,0,0,,Saya rasa seperti orang bodoh. Adakah saya perlu meneruskan?
Dialog: 0,0:47:48.56,0:47:49.52,teks umum,,0,0,0,,Pecked!
Dialog: 0,0:48:00.65,0:48:02.36,teks umum,,0,0,0,,Inilah Ikan Emas
Dialog: 0,0:48:03.03,0:48:06.66,teks umum,,0,0,0,,Ini adalah segumpal air yang terbentuk daripada tenaga tasik
Dialog: 0,0:48:07.33,0:48:10.58,teks umum,,0,0,0,,Hanya mereka yang telah menguasai Chisu atau lebih tinggi dapat mengawal air,
Dialog: 0,0:48:10.66,0:48:12.33,teks umum,,0,0,0,,boleh menangkapnya
Dialog: 0,0:48:15.04,0:48:16.46,contact,,0,0,0,,Sudah lama saya tidak memancing
Dialog: 0,0:48:16.55,0:48:19.84,teks umum,,0,0,0,,Tetapi saya harus akui, masih menarik untuk menangkap Ikan Emas
Dialog: 0,0:48:22.13,0:48:24.68,teks umum,,0,0,0,,Jadi ini bukan ikan sebenar?
Dialog: 0,0:48:25.26,0:48:27.56,teks umum,,0,0,0,,Cikgu Li tidak membawa kamu ke sini untuk memancing
Dialog: 0,0:48:28.27,0:48:31.31,teks umum,,0,0,0,,Dia di sini untuk membantu anda menguasai Chisu
Dialog: 0,0:48:32.23,0:48:33.56,contact,,0,0,0,,Hanya mereka yang mempunyai kekuatan,
Dialog: 0,0:48:33.65,0:48:36.52,contact,,0,0,0,,boleh menangkap segumpal tenaga dari Tasik Gyeongcheongdaeho
Dialog: 0,0:48:37.61,0:48:39.36,teks umum,,0,0,0,,dan master Chisu
Dialog: 0,0:48:41.15,0:48:42.45,teks umum,,0,0,0,,Chisu?
Dialog: 0,0:48:50.91,0:48:53.21,teks umum,,0,0,0,,Lambat
Dialog: 0,0:48:53.29,0:48:54.17,teks umum,,0,0,0,,Perlahan
Dialog: 0,0:48:54.25,0:48:57.25,teks umum,,0,0,0,,Tidak, anda terlalu tergesa-gesa. Perlahan-lahan
Dialog: 0,0:48:57.96,0:48:59.46,teks umum,,0,0,0,,- Perlahan\N- Tidak
Dialog: 0,0:49:12.52,0:49:14.73,teks umum,,0,0,0,,Jeonbugwan pasti telah menemui seorang lagi gadis buta
Dialog: 0,0:49:14.81,0:49:17.23,teks umum,,0,0,0,,Cho Young berkata mereka membawa gadis buta
Dialog: 0,0:49:17.31,0:49:19.19,teks umum,,0,0,0,,dari seluruh pelusuk negara setiap hari
Dialog: 0,0:49:21.78,0:49:23.65,teks umum,,0,0,0,,- Jom masuk\N- Ya
Dialog: 0,0:49:36.08,0:49:38.13,italic,,0,0,0,,Jadi anda berkata,
Dialog: 0,0:49:38.21,0:49:41.09,teks umum,,0,0,0,,bahawa mungkin ada orang nomad dalam setiap keluarga,
Dialog: 0,0:49:41.17,0:49:43.22,teks umum,,0,0,0,,yang mengambil bahagian dalam pembunuhan bapa Nak Soo,
Dialog: 0,0:49:43.30,0:49:45.30,teks umum,,0,0,0,,dan kita perlu menggunakan peninggalan Jinyeowon,
Dialog: 0,0:49:46.34,0:49:47.51,teks umum,,0,0,0,,untuk mencari mereka?
Dialog: 0,0:49:47.60,0:49:49.81,teks umum,,0,0,0,,Kami akan menunggu sehingga perantau,
Dialog: 0,0:49:49.89,0:49:52.31,teks umum,,0,0,0,,dari Degantongun akan sedar,
Dialog: 0,0:49:52.39,0:49:54.19,teks umum,,0,0,0,,tetapi kita tidak boleh menunggu lagi
Dialog: 0,0:49:54.27,0:49:55.69,teks umum,,0,0,0,,Hakikatnya
Dialog: 0,0:49:56.60,0:49:58.77,teks umum,,0,0,0,,semalam kami jumpa yang lain
Dialog: 0,0:50:00.02,0:50:01.36,teks umum,,0,0,0,,Saya dengar
Dialog: 0,0:50:01.44,0:50:05.03,teks umum,,0,0,0,,Seorang nomad yang merupakan seorang kasim ditemui di Chonbugwan
Dialog: 0,0:50:05.11,0:50:08.41,teks umum,,0,0,0,,Jin Mu pasti sudah melawat awak
Dialog: 0,0:50:09.37,0:50:13.87,teks umum,,0,0,0,,Abang saya Jin Mu berkata bahawa Sosnovy Bor menghantar pencuri kepada Jeonbugwan,
Dialog: 0,0:50:14.50,0:50:17.75,teks umum,,0,0,0,,yang cuba menetapkan dia. Dia sangat kecewa
Dialog: 0,0:50:17.83,0:50:20.96,teks umum,,0,0,0,,Untuk mengetahui sama ada Jin Mu bersalah atau tidak,
Dialog: 0,0:50:21.67,0:50:25.67,teks umum,,0,0,0,,kita memerlukan peninggalan dan kuasa ketua Jinyeowon
Dialog: 0,0:50:25.76,0:50:27.09,teks umum,,0,0,0,,Bantu kami
Dialog: 0,0:50:28.89,0:50:29.93,teks umum,,0,0,0,,Maaf,
Dialog: 0,0:50:31.43,0:50:32.81,teks umum,,0,0,0,,tetapi saya menolak
Dialog: 0,0:50:34.81,0:50:38.56,teks umum,,0,0,0,,Tiada yang lebih memalukan bagi ahli silap mata selain tuduhan menggunakan sihir gelap
Dialog: 0,0:50:39.40,0:50:40.86,teks umum,,0,0,0,,Jika kita
Dialog: 0,0:50:40.94,0:50:45.19,contact,,0,0,0,,uji ahli silap mata dengan peninggalan mereka tanpa sebarang bukti,
Dialog: 0,0:50:46.15,0:50:48.91,teks umum,,0,0,0,,kami hanya akan membuat orang membenci Jinyeowon
Dialog: 0,0:50:48.99,0:50:50.32,teks umum,,0,0,0,,Saya dengar, Jin Mu
Dialog: 0,0:50:51.20,0:50:53.91,teks umum,,0,0,0,,mencari anak perempuan sulung anda
Dialog: 0,0:50:54.83,0:50:58.17,teks umum,,0,0,0,,Dia meminta anda untuk tidak membantu Sosnovy Bor
Dialog: 0,0:50:58.67,0:51:00.92,teks umum,,0,0,0,, sebagai pertukaran untuk membantu mencari anak perempuan anda?
Dialog: 0,0:51:01.50,0:51:03.38,teks umum,,0,0,0,,- Ini tiada kena mengena...{\i1}\N- Tidak, ia ada
Dialog: 0,0:51:03.46,0:51:07.97,teks umum,,0,0,0,,Tingkah laku anda mengenai Sosnovy Bor tiba-tiba berubah
Dialog: 0,0:51:08.05,0:51:11.51,teks umum,,0,0,0,,Adakah anda mahu saya sentiasa melakukan apa yang anda minta?
Dialog: 0,0:51:11.60,0:51:12.97,teks umum,,0,0,0,,Adakah ini tingkah laku yang anda jangkakan?
Dialog: 0,0:51:14.39,0:51:18.31,teks umum,,0,0,0,,Jinyoungwon tidak patuh
Dialog: 0,0:51:18.39,0:51:19.90,teks umum,,0,0,0,,Sosnovoy Bor
Dialog: 0,0:51:19.98,0:51:21.81,teks umum,,0,0,0,,- Bab Jin!\N- Pergi
Dialog: 0,0:51:22.40,0:51:25.48,teks umum,,0,0,0,,Saya ada janji temu
Dialog: 0,0:51:36.29,0:51:39.25,teks umum,,0,0,0,,Apabila mereka menemui kakak anda,
Dialog: 0,0:51:39.33,0:51:42.75,teks umum,,0,0,0,,tidak akan ada lagi halangan untuk cinta kita
Dialog: 0,0:51:42.84,0:51:46.17,teks umum,,0,0,0,,Kerana Sosnovy Bor dan Jinyovon mempunyai hubungan baik
Dialog: 0,0:51:46.76,0:51:48.01,teks umum,,0,0,0,,Oh, betul-betul...
Dialog: 0,0:51:50.59,0:51:51.72,teks umum,,0,0,0,,Di sini
Dialog: 0,0:51:53.22,0:51:55.81,teks umum,,0,0,0,,Ini adalah hiasan yang saya suka kali terakhir
Dialog: 0,0:51:56.47,0:51:58.77,teks umum,,0,0,0,,Seseorang sudah berjaya membelinya
Dialog: 0,0:51:58.85,0:52:00.44,teks umum,,0,0,0,,Bagaimana anda mendapatkannya?
Dialog: 0,0:52:00.52,0:52:03.61,teks umum,,0,0,0,,Membayar orang itu empat kali ganda jumlah
Dialog: 0,0:52:03.69,0:52:05.40,teks umum,,0,0,0,,Fikirkan anda mahukannya
Dialog: 0,0:52:05.48,0:52:07.57,teks umum,,0,0,0,,Saya sangat menyukainya
Dialog: 0,0:52:08.49,0:52:11.24,teks umum,,0,0,0,,Senyuman gembira anda
Dialog: 0,0:52:11.32,0:52:15.03,teks umum,,0,0,0,,membuat saya paling gembira di dunia
Dialog: 0,0:52:26.13,0:52:28.05,teks umum,,0,0,0,,Kenapa pakcik kamu kelihatan sangat kecewa?
Dialog: 0,0:52:28.13,0:52:29.47,teks umum,,0,0,0,,Adakah sesuatu berlaku?
Dialog: 0,0:52:30.51,0:52:33.14,teks umum,,0,0,0,,Saya rasa dia bergaduh besar dengan ketua Jinyeowon
Dialog: 0,0:52:52.95,0:52:55.32,teks umum,,0,0,0,,Saya melukis tahi lalat merah gelap di belakang telinganya
Dialog: 0,0:52:56.99,0:53:01.08,teks umum,,0,0,0,,Boo Young jatuh semasa kecil. Dia mempunyai parut di lengan kirinya
Dialog: 0,0:53:03.58,0:53:06.04,teks umum,,0,0,0,,Kira-kira satu pertiga daripada jari panjang
Dialog: 0,0:53:38.41,0:53:41.58,teks umum,,0,0,0,,Adalah perlu untuk anda menjadi Jin Bu Young, sabar
Dialog: 0,0:53:42.66,0:53:44.50,teks umum,,0,0,0,,Setiap parut, setiap tahi lalat...
Dialog: 0,0:53:44.58,0:53:47.75,teks umum,,0,0,0,,Sebarang perkara kecil yang ibunya boleh ingat
Dialog: 0,0:53:49.67,0:53:50.75,teks umum,,0,0,0,,Okay
Dialog: 0,0:53:50.84,0:53:54.38,teks umum,,0,0,0,,Saya akan tuangkan asid pada kulit anda untuk membuat parut lebih kelihatan
Dialog: 0,0:54:38.09,0:54:41.51,teks umum,,0,0,0,,Apakah jenis ikan yang cuba ditangkap oleh Encik Chan?
Dialog: 0,0:54:41.60,0:54:43.35,teks umum,,0,0,0,,Apa yang dia lakukan hanyalah pergi ke tasik
Dialog: 0,0:54:43.93,0:54:46.48,teks umum,,0,0,0,,Saya perlu membawa mereka makanan
Dialog: 0,0:54:46.56,0:54:48.56,teks umum,,0,0,0,,Saya akan meminta hamba Li untuk membawa
Dialog: 0,0:54:48.65,0:54:50.77,teks umum,,0,0,0,,Dan awak tinggal dan bantu saya
Dialog: 0,0:54:52.61,0:54:56.53,teks umum,,0,0,0,,Kami perlu membersihkan rumah dan menyediakan makanan untuk upacara peringatan
Dialog: 0,0:54:58.03,0:54:59.28,teks umum,,0,0,0,,Untuk siapa?
Dialog: 0,0:54:59.36,0:55:01.58,teks umum,,0,0,0,,Seorang gadis muda yang meninggal dunia dengan kematian yang mengerikan
Dialog: 0,0:55:02.08,0:55:04.33,teks umum,,0,0,0,,Dia tersinggung dengan keluarga kami,
Dialog: 0,0:55:04.41,0:55:06.41,teks umum,,0,0,0,,jadi saya mahu bangunkan dia
Dialog: 0,0:55:07.96,0:55:09.29,contact,,0,0,0,,Maiden Kim
Dialog: 0,0:55:09.37,0:55:10.88,teks umum,,0,0,0,,Saya pulang dari kuil
Dialog: 0,0:55:10.96,0:55:12.13,teks umum,,0,0,0,,- Okay\N- Sini
Dialog: 0,0:55:12.21,0:55:14.55,teks umum,,0,0,0,,Seorang sami Buddha menulis ucapan
Dialog: 0,0:55:15.88,0:55:17.59,teks umum,,0,0,0,,Sungguh hebat ucapan
Dialog: 0,0:55:18.68,0:55:20.30,teks umum,,0,0,0,,Tetapi di manakah nama mereka?
Dialog: 0,0:55:20.39,0:55:22.55,teks umum,,0,0,0,,Saya sepatutnya menulis nama arwah
Dialog: 0,0:55:22.64,0:55:23.93,contact,,0,0,0,,Ini dia
Dialog: 0,0:55:24.01,0:55:26.81,teks umum,,0,0,0,,Di sini. Cho Chun dan Cho Young
Dialog: 0,0:55:28.14,0:55:30.35,di sebalik tabir,,0,0,0,,Cho Young? Ini nama saya
Dialog: 0,0:55:30.94,0:55:32.94,condong,,0,0,0,,Ah, itu sahaja. Sekarang saya nampak
Dialog: 0,0:55:33.02,0:55:34.57,teks umum,,0,0,0,,Cho Chun dan Cho Young
Dialog: 0,0:55:35.98,0:55:37.32,miring,,0,0,0,,Ucapan yang indah
Dialog: 0,0:55:37.40,0:55:39.78,teks umum,,0,0,0,,Hamba Li, ikut saya
Dialog: 0,0:55:40.32,0:55:41.91,teks umum,,0,0,0,,Bawa makanan kepada tuan
Dialog: 0,0:55:41.99,0:55:43.12,miring,,0,0,0,,Ya, sudah tentu
Dialog: 0,0:55:44.62,0:55:46.70,di sebalik tabir,,0,0,0,,Maiden Kim berjaga
Dialog: 0,0:55:47.54,0:55:49.62,di sebalik tabir,,0,0,0,,tentang saya dan ayah saya?
Dialog: 0,0:56:28.16,0:56:30.54,teks umum,,0,0,0,,Mereka membawa kami nasi dengan cendawan. kegemaran saya
Dialog: 0,0:56:30.62,0:56:33.88,teks umum,,0,0,0,,Maid Kim ialah tukang masak yang hebat
Dialog: 0,0:56:41.09,0:56:42.51,teks umum,,0,0,0,,Pecks! Saya menangkapnya!
Dialog: 0,0:56:53.02,0:56:55.48,teks umum,,0,0,0,,Saya mengaitkan cacing. Dia jatuh cinta kepadanya
Dialog: 0,0:56:56.65,0:56:58.23,teks umum,,0,0,0,,Kita boleh makan dia
Dialog: 0,0:57:03.78,0:57:05.16,teks umum,,0,0,0,,Nah...
Dialog: 0,0:57:23.01,0:57:24.01,teks umum,,0,0,0,,Tahan
Dialog: 0,0:57:29.93,0:57:31.64,teks umum,,0,0,0,,Luangkan masa anda
Dialog: 0,0:57:33.23,0:57:35.81,teks umum,,0,0,0,,Suatu hari nanti anda akan rasa perasaan ini,
Dialog: 0,0:57:35.90,0:57:38.27,teks umum,,0,0,0,,apabila ikan emas menggigit
Dialog: 0,0:57:38.36,0:57:41.94,teks umum,,0,0,0,,Ini akan menjadi Chisu - keupayaan untuk mengawal tenaga
Dialog: 0,0:57:43.65,0:57:44.66,teks umum,,0,0,0,,Saya faham
Dialog: 0,0:57:45.74,0:57:48.70,teks umum,,0,0,0,,Cikgu Li, anda mengajar saya membaca “Kata-Kata Hati”
Dialog: 0,0:57:49.41,0:57:51.70,teks umum,,0,0,0,,Mengapa awak terus membantu saya?
Dialog: 0,0:57:52.96,0:57:55.83,teks umum,,0,0,0,, Secara tidak sengaja tanpa sebab,
Dialog: 0,0:57:56.33,0:57:59.38,teks umum,,0,0,0,,yang mana perlu dirahsiakan?
Dialog: 0,0:58:01.30,0:58:02.76,teks umum,,0,0,0,,Ini bukan urusan anda
Dialog: 0,0:58:02.84,0:58:04.51,teks umum,,0,0,0,,Adakah anda fikir saya tidak akan mengetahuinya?
Dialog: 0,0:58:07.05,0:58:08.51,teks umum,,0,0,0,,Ini menyangkut keluarga saya
Dialog: 0,0:58:13.52,0:58:15.10,teks umum,,0,0,0,,Ini kerana pembantu rumah Kim, kan?
Dialog: 0,0:58:17.02,0:58:20.32,teks umum,,0,0,0,,Anda sentiasa menghujaninya dengan pujian
Dialog: 0,0:58:20.40,0:58:22.73,teks umum,,0,0,0,,Dan anda juga mempunyai selendang di leher anda...
Dialog: 0,0:58:22.82,0:58:25.11,teks umum,,0,0,0,,Dia dari kedai yang dia pergi
Dialog: 0,0:58:26.15,0:58:27.36,teks umum,,0,0,0,,Ini hadiah dia, kan?
Dialog: 0,0:58:28.41,0:58:29.62,teks umum,,0,0,0,,Dan yang paling penting,
Dialog: 0,0:58:29.70,0:58:33.41,teks umum,,0,0,0,,Saya melihat bunga liar kering di dalam bilik pembantu rumah Kim
Dialog: 0,0:58:33.50,0:58:35.75,teks umum,,0,0,0,,Danhyangok penuh dengannya
Dialog: 0,0:58:35.83,0:58:37.37,teks umum,,0,0,0,,Dan ini hadiah awak, bukan?
Dialog: 0,0:58:38.96,0:58:41.59,teks umum,,0,0,0,,- Ya, memang benar\N- Itu yang saya tahu
Dialog: 0,0:58:42.92,0:58:44.97,teks umum,,0,0,0,,Tetapi kamu mengamalkan kesucian...
Dialog: 0,0:58:45.05,0:58:48.30,teks umum,,0,0,0,,Saya tidak mempunyai perasaan "itu" untuknya!
Dialog: 0,0:58:48.89,0:58:51.51,teks umum,,0,0,0,,Saya rasa dia cantik dan baik hati
Dialog: 0,0:58:51.60,0:58:53.02,teks umum,,0,0,0,,Itu sahaja
Dialog: 0,0:58:53.56,0:58:56.60,teks umum,,0,0,0,,Ia sama seperti menyatakan perasaan anda terhadapnya
Dialog: 0,0:58:56.69,0:58:58.73,teks umum,,0,0,0,,Hubungan antara lelaki dan wanita sentiasa "begini"
Dialog: 0,0:58:59.31,0:59:00.19,teks umum,,0,0,0,,Dan bagaimana pula dengan diri anda?
Dialog: 0,0:59:00.86,0:59:03.90,teks umum,,0,0,0,,Anda seorang lelaki, dan Moo Dok ialah seorang wanita. Ada apa antara awak?
Dialog: 0,0:59:05.90,0:59:07.49,teks umum,,0,0,0,,Bagi saya...
Dialog: 0,0:59:09.11,0:59:10.28,teks umum,,0,0,0,,Saya suka dia
Dialog: 0,0:59:15.75,0:59:18.71,teks umum,,0,0,0,,Saya tidak percaya saya mengatakan ini kepada seseorang yang mengamalkan kesucian
Dialog: 0,0:59:18.79,0:59:22.25,teks umum,,0,0,0,,Hanya pembantu rumah Kim sudah menyukai seseorang
Dialog: 0,0:59:22.34,0:59:23.71,teks umum,,0,0,0,,saya harap saya tidak menyakiti perasaan awak
Dialog: 0,0:59:23.80,0:59:25.38,teks umum,,0,0,0,,Saya juga perlu katakan
Dialog: 0,0:59:26.21,0:59:28.84,teks umum,,0,0,0,,Saya dengar Moo Deok suka Yul
Dialog: 0,0:59:28.93,0:59:31.51,teks umum,,0,0,0,,Dan Gu memberitahu anda ini? Apakah jenis perbualan duniawi ini?
Dialog: 0,0:59:31.60,0:59:33.51,teks umum,,0,0,0,,Saya bukan main main dengan awak di sini
Dialog: 0,0:59:35.64,0:59:37.31,teks umum,,0,0,0,,Saya menyedari bahawa perbualan duniawi...
Dialog: 0,0:59:38.14,0:59:40.02,teks umum,,0,0,0,,kadang-kadang berguna
Dialog: 0,0:59:42.15,0:59:44.23,teks umum,,0,0,0,,Terima kasih kepada kisah cinta pertama Julia,
Dialog: 0,0:59:44.32,0:59:47.24,teks umum,,0,0,0,,Saya dapat mengetahui tentang Nak Su, si pembunuh
Dialog: 0,0:59:50.24,0:59:53.24,teks umum,,0,0,0,,Gadis yang ditemuinya di Danhyangok,
Dialog: 0,0:59:54.33,0:59:55.70,teks umum,,0,0,0,,ternyata Nak Su
Dialog: 0,0:59:56.83,0:59:58.29,teks umum,,0,0,0,,Dia menyedari bahawa itu adalah dia...
Dialog: 0,0:59:58.37,1:00:01.08,teks umum,,0,0,0,,kerana wisel diberikan. Dia baring di sebelah badannya
Dialog: 0,1:00:03.29,1:00:07.34,teks umum,,0,0,0,,Saya tahu awak mendengar perbualan saya dengan Jin di Sejukwon
Dialog: 0,1:00:10.09,1:00:12.72,teks umum,,0,0,0,,Jadi anda sendiri tahu tentang sejarah Nak Su
Dialog: 0,1:00:16.52,1:00:18.39,teks umum,,0,0,0,,Pulang awal hari ini
Dialog: 0,1:00:19.35,1:00:20.94,teks umum,,0,0,0,,Maiden Kim terus bangun...
Dialog: 0,1:00:21.73,1:00:25.11,teks umum,,0,0,0,,tentang seorang gadis kecil yang meninggal dunia dengan kematian yang mengerikan
Dialog: 0,1:00:41.58,1:00:42.96,teks umum,,0,0,0,,Itu sahaja
Dialog: 0,1:00:43.54,1:00:44.88,teks umum,,0,0,0,, Mangkuk buruj dipasang
Dialog: 0,1:00:44.96,1:00:47.92,teks umum,,0,0,0,,Bawa hambamu kembali ke Sosnovy Bor
Dialog: 0,1:00:48.00,1:00:51.13,teks umum,,0,0,0,,Tidak, belum sempurna lagi
Dialog: 0,1:00:51.22,1:00:52.68,teks umum,,0,0,0,,Kami suka segala-galanya
Dialog: 0,1:00:52.76,1:00:54.01,teks umum,,0,0,0,,Apa pendapat anda?
Dialog: 0,1:00:54.09,1:00:55.47,teks umum,,0,0,0,,Lihat sahaja
Dialog: 0,1:00:55.55,1:00:59.35,teks umum,,0,0,0,,Warna mangkuk dan batang berbeza
Dialog: 0,1:00:59.93,1:01:01.98,teks umum,,0,0,0,,Kita perlu menukar kaki
Dialog: 0,1:01:02.06,1:01:04.10,teks umum,,0,0,0,,Kami telah mengubahnya berkali-kali
Dialog: 0,1:01:04.60,1:01:05.94,teks umum,,0,0,0,,Kami suka segala-galanya
Dialog: 0,1:01:06.02,1:01:07.44,teks umum,,0,0,0,,Ketua Sosnovy Bor berjanji,
Dialog: 0,1:01:07.52,1:01:10.40,teks umum,,0,0,0,,yang akan mengembalikan segala-galanya seperti semula
Dialog: 0,1:01:10.99,1:01:12.78,teks umum,,0,0,0,,Kesilapan tidak boleh dilakukan
Dialog: 0,1:01:14.28,1:01:16.87,teks umum,,0,0,0,,Biasanya ia mengambil masa tidak lebih daripada dua hari
Dialog: 0,1:01:17.58,1:01:19.20,teks umum,,0,0,0,,Tetapi kali ini segala-galanya entah bagaimana tertangguh
Dialog: 0,1:01:19.29,1:01:21.66,teks umum,,0,0,0,,Anda tidak suka kami datang ke sini?
Dialog: 0,1:01:21.75,1:01:23.67,teks umum,,0,0,0,,Mengapa ini berlaku?
Dialog: 0,1:01:23.75,1:01:28.38,teks umum,,0,0,0,,Saya hanya fikir bahawa Sosnovy Bor membuang masa dan wang
Dialog: 0,1:01:32.22,1:01:35.43,teks umum,,0,0,0,,Jangan risau tentang wang Sosnovy Bor
Dialog: 0,1:01:37.68,1:01:40.39,teks umum,,0,0,0,,Yul, kali terakhir kita berjumpa saya perhatikan kemahiran awak
Dialog: 0,1:01:40.47,1:01:42.14,italic,,0,0,0,,Sudah kuasai Chisu?
Dialog: 0,1:01:43.98,1:01:45.06,teks umum,,0,0,0,,Ya
Dialog: 0,1:01:46.15,1:01:48.40,teks umum,,0,0,0,,Ternyata anda adalah ahli silap mata pertama Jeonjingak,
Dialog: 0,1:01:48.48,1:01:50.65,teks umum,,0,0,0,,dirasuk Chisu
Dialog: 0,1:01:51.28,1:01:54.32,teks umum,,0,0,0,,Semuanya seperti ayah saya. Seo Il pasti sangat berbangga dengan awak
Dialog: 0,1:01:55.32,1:01:57.07,teks umum,,0,0,0,,Adakah dia ahli silap mata Jeonjingak?
Dialog: 0,1:01:58.74,1:02:00.79,kenangan miring,,0,0,0,,Anda tidak boleh mengheret seseorang melawan kehendaknya
Dialog: 0,1:02:06.25,1:02:07.92,kenangan,,0,0,0,,Bolehkah awak berdiri?
Dialog: 0,1:02:10.17,1:02:11.30,miring,,0,0,0,,Apa yang anda lihat?
Dialog: 0,1:02:14.55,1:02:16.64,teks umum,,0,0,0,,Adakah dia ahli silap mata Jeonjingak?
Dialog: 0,1:02:16.72,1:02:19.18,teks umum,,0,0,0,,- Nama dia Seo Yul?\N- Ya
Dialog: 0,1:02:19.26,1:02:21.93,teks umum,,0,0,0,,Mereka adalah anak-anak keluarga bangsawan, buah beri bukan dari ladangmu
Dialog: 0,1:02:22.52,1:02:24.43,teks umum,,0,0,0,,Berhenti merayau di sini, duduk diam
Dialog: 0,1:02:30.90,1:02:33.78,teks umum,,0,0,0,,Mungkin pencuri So And bukan tandingannya
Dialog: 0,1:02:37.03,1:02:39.95,teks umum,,0,0,0,,Tetapi sebaik sahaja saya menjadi Jin Bu Young, ketua masa depan Jinyoung,
Dialog: 0,1:02:41.62,1:02:43.16,teks umum,,0,0,0,,semuanya boleh berubah
Dialog: 0,1:02:51.92,1:02:54.63,teks umum,,0,0,0,,Ini untuk rakan Master Chan dan anak perempuannya
Dialog: 0,1:02:56.97,1:02:58.72,contact,,0,0,0,,Mayat mereka tidak dikebumikan,
Dialog: 0,1:02:59.72,1:03:02.22,contact,,0,0,0,,dan hampir tidak ada yang mengingatinya
Dialog: 0,1:03:02.97,1:03:04.81,teks umum,,0,0,0,,Jadi saya akan mengadakan sekurang-kurangnya satu perkhidmatan
Dialog: 0,1:03:06.73,1:03:07.85,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:03:10.73,1:03:11.98,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:03:13.02,1:03:14.32,teks umum,,0,0,0,,Apa?
Dialog: 0,1:03:16.44,1:03:17.90,teks umum,,0,0,0,,Mereka akan sangat berterima kasih kepada anda
Dialog: 0,1:03:18.99,1:03:21.41,teks umum,,0,0,0,,Saya pasti mereka amat berterima kasih
Dialog: 0,1:03:23.12,1:03:24.79,teks umum,,0,0,0,,Gembira mendengarnya
Dialog: 0,1:03:26.41,1:03:28.75,teks am,,0,0,0,,Jangan padamkan batang kemenyan sehingga hangus
Dialog: 0,1:03:56.69,1:03:58.90,prasasti,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:04:15.50,1:04:19.47,kapsyen,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:04:27.60,1:04:28.81,teks umum,,0,0,0,,Bapa...
Dialog: 0,1:04:41.15,1:04:43.28,teks umum,,0,0,0,,En. Chan pergi memancing
Dialog: 0,1:04:43.37,1:04:46.08,teks umum,,0,0,0,,Dia akan kembali tidak lama lagi, anda boleh tunggu di dalam
Dialog: 0,1:04:47.58,1:04:49.41,teks umum,,0,0,0,,Moo Dok pergi bersamanya?
Dialog: 0,1:04:49.50,1:04:51.71,teks umum,,0,0,0,,Tidak, dia pulang
Dialog: 0,1:04:51.79,1:04:53.33,teks umum,,0,0,0,,Dibantu dengan bangun
Dialog: 0,1:05:07.81,1:05:10.23,kapsyen,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:05:12.81,1:05:14.15,luar skrin,,0,0,0,,Jika saya tidak meninggalkan awak...
Dialog: 0,1:05:15.48,1:05:17.07,di sebalik tabir,,0,0,0,,sendirian di pergunungan,
Dialog: 0,1:05:20.90,1:05:25.03,di sebalik tabir,,0,0,0,,anda tidak perlu menahan air mata anda sekarang
Dialog: 0,1:05:25.87,1:05:28.24,luar skrin,,0,0,0,,dan berpura-pura menjadi orang lain
Dialog: 0,1:05:33.58,1:05:35.17,di sebalik tabir,,0,0,0,,Tetapi sekarang,
Dialog: 0,1:05:37.17,1:05:39.63,luar skrin,,0,0,0,,Saya tidak boleh mendekati...
Dialog: 0,1:05:40.59,1:05:42.63,suara,,0,0,0,,dan memberitahu anda bahawa saya tahu siapa anda
Dialog: 0,1:05:55.69,1:05:57.31,kapsyen,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:06:03.40,1:06:04.65,teks umum,,0,0,0,,Adakah batang kayu hangus?
Dialog: 0,1:06:06.28,1:06:07.32,teks umum,,0,0,0,,Ya
Dialog: 0,1:06:07.99,1:06:09.03,teks umum,,0,0,0,,Habis
Dialog: 0,1:06:09.62,1:06:10.54,teks umum,,0,0,0,,Awak pernah duduk di sini?
Dialog: 0,1:06:14.04,1:06:15.37,teks umum,,0,0,0,,Mari kita bersihkan semuanya
Dialog: 0,1:06:55.29,1:06:58.21,teks umum,,0,0,0,,Bila awak balik? Saya dengar awak pergi memancing
Dialog: 0,1:06:58.29,1:07:00.34,teks umum,,0,0,0,,Ya, baru dikembalikan
Dialog: 0,1:07:00.42,1:07:01.75,teks umum,,0,0,0,,Adakah anda bersendirian? Di manakah Dan Gu?
Dialog: 0,1:07:01.84,1:07:04.59,teks umum,,0,0,0,,Dia ada sesuatu nak dibuat. Saya rasa dia sedang dating dengan seseorang
Dialog: 0,1:07:04.67,1:07:05.92,teks umum,,0,0,0,,Begitukah?
Dialog: 0,1:07:07.18,1:07:08.43,teks umum,,0,0,0,,Kenapa awak datang?
Dialog: 0,1:07:08.51,1:07:11.51,teks umum,,0,0,0,,Ketua kata awak boleh balik
Dialog: 0,1:07:12.10,1:07:14.52,teks umum,,0,0,0,,Lebih pantas daripada yang saya sangka
Dialog: 0,1:07:15.48,1:07:18.69,teks umum,,0,0,0,,Duduk dan minum. Saya masih perlu bercakap dengan awak
Dialog: 0,1:07:18.77,1:07:20.40,teks umum,,0,0,0,,Saya tidak boleh, maaf
Dialog: 0,1:07:21.15,1:07:23.69,teks umum,,0,0,0,,- Saya perlu kembali ke Sosnovy Bor\N- Ya?
Dialog: 0,1:07:23.78,1:07:26.90,teks umum,,0,0,0,,Kemudian kita akan bercakap kemudian, di Jeonjingak
Dialog: 0,1:07:27.45,1:07:29.16,teks umum,,0,0,0,,Anda akan sangat terkejut
Dialog: 0,1:07:30.82,1:07:34.41,teks umum,,0,0,0,,Uk, saya akan kembali ke Kubu Soho tidak lama lagi
Dialog: 0,1:07:36.16,1:07:38.04,teks umum,,0,0,0,,Saya berjanji dengan ayah saya bahawa saya akan tinggal di Jeonjingak
Dialog: 0,1:07:38.12,1:07:40.71,teks umum,,0,0,0,,sehingga saya menguasai Chisu
Dialog: 0,1:07:41.42,1:07:43.88,teks umum,,0,0,0,,Cikgu Ho menulis surat kepada bapanya,
Dialog: 0,1:07:43.96,1:07:45.84,teks umum,,0,0,0,, tak lama lagi dia akan suruh saya balik
Dialog: 0,1:07:46.42,1:07:47.51,teks umum,,0,0,0,,Maka saya perlu pergi
Dialog: 0,1:07:47.59,1:07:49.18,teks umum,,0,0,0,,Tetapi kubu Soho sangat jauh
Dialog: 0,1:07:50.05,1:07:52.97,teks umum,,0,0,0,,Dan Gu dan saya akan sangat merindui awak
Dialog: 0,1:07:54.64,1:07:56.31,teks umum,,0,0,0,,Saya mahu membawanya bersama saya
Dialog: 0,1:07:58.02,1:07:59.85,teks umum,,0,0,0,,seseorang
Dialog: 0,1:08:02.56,1:08:04.52,teks umum,,0,0,0,,- Siapa?\N- Saya belum boleh katakan lagi
Dialog: 0,1:08:06.65,1:08:07.90,teks umum,,0,0,0,,Saya akan memberitahu anda apabila tiba masanya
Dialog: 0,1:08:10.15,1:08:11.86,teks umum,,0,0,0,,Saya akan pergi. jumpa esok
Dialog: 0,1:08:12.99,1:08:14.08,teks umum,,0,0,0,,Okay. Selamat tinggal
Dialog: 0,1:08:48.36,1:08:49.78,kenangan miring,,0,0,0,,Sebab saya bosan
Dialog: 0,1:08:49.86,1:08:51.95,kenangan,,0,0,0,,Saya sangat menyukai orang ini
Dialog: 0,1:08:55.74,1:08:58.75,kenangan miring,,0,0,0,,Perantau hanya boleh pulih dengan menyedut tenaga orang lain
Dialog: 0,1:08:58.83,1:09:00.12,kenangan miring,,0,0,0,,Setelah melakukan ini sekali,
Dialog: 0,1:09:01.21,1:09:02.79,kenangan miring,,0,0,0,,ia bertukar menjadi raksasa
Dialog: 0,1:09:04.00,1:09:05.92,kenangan miring,,0,0,0,,Dan tugas kita ialah
Dialog: 0,1:09:06.88,1:09:08.21,kenangan miring,,0,0,0,,lindungi dunia daripada mereka
Dialog: 0,1:09:11.26,1:09:14.43,di sebalik tabir,,0,0,0,,Adakah Yul benar-benar tahu tentang segala-galanya?
Dialog: 0,1:09:15.72,1:09:17.56,kenangan condong,,0,0,0,,Saya mahu membawanya bersama saya
Dialog: 0,1:09:18.14,1:09:20.02,kenangan,,0,0,0,,seseorang
Dialog: 0,1:09:26.56,1:09:27.90,teks umum,,0,0,0,,Hos
Dialog: 0,1:09:27.98,1:09:29.11,teks umum,,0,0,0,,Apa?
Dialog: 0,1:09:32.15,1:09:35.03,teks umum,,0,0,0,,Adakah So Yul sudah pergi? Pembantu rumah Kim memberikannya kepadanya
Dialog: 0,1:09:42.33,1:09:43.83,teks umum,,0,0,0,,Nampaknya dia bercakap tentang anda
Dialog: 0,1:09:44.71,1:09:47.67,teks umum,,0,0,0,,Siapa? Adakah Seo Yul berkata sesuatu?
Dialog: 0,1:09:51.21,1:09:52.84,teks umum,,0,0,0,,Saya boleh kembali
Dialog: 0,1:09:53.72,1:09:55.05,teks umum,,0,0,0,,Adakah itu sebabnya anda sangat kecewa?
Dialog: 0,1:09:55.84,1:09:57.93,teks umum,,0,0,0,,Apabila anda kembali ke hutan,
Dialog: 0,1:09:58.47,1:10:00.93,teks umum,,0,0,0,,pertarungan anda dengan Cha Bum akan berlaku
Dialog: 0,1:10:01.02,1:10:02.14,teks umum,,0,0,0,,Adakah anda takut kalah?
Dialog: 0,1:10:03.02,1:10:04.52,teks umum,,0,0,0,,Saya tidak akan kalah esok
Dialog: 0,1:10:07.27,1:10:08.48,teks umum,,0,0,0,,Akhirnya saya dapat
Dialog: 0,1:10:27.83,1:10:30.00,teks umum,,0,0,0,,Hari ini adalah pertarungan terakhir Chan Wook
Dialog: 0,1:10:33.17,1:10:35.43,teks umum,,0,0,0,,Kami telah mengubah sedikit syarat pertaruhan
Dialog: 0,1:10:35.51,1:10:37.26,teks umum,,0,0,0,,Pemenang perlawanan hari ini
Dialog: 0,1:10:38.09,1:10:40.39,teks umum,,0,0,0,,tidak akan menerima katak emas, tetapi sesuatu yang lain
Dialog: 0,1:10:54.82,1:10:56.36,teks umum,,0,0,0,,Pemenang
Dialog: 0,1:10:57.78,1:10:59.07,teks umum,,0,0,0,,akan memenangi pembantu rumah
Dialog: 0,1:11:05.41,1:11:07.08,teks umum,,0,0,0,,Saya bersetuju untuk menyampaikannya,
Dialog: 0,1:11:09.00,1:11:11.21,teks umum,,0,0,0,,siapa yang akan menang hari ini
Dialog: 0,1:11:20.85,1:11:23.01,teks umum,,0,0,0,,- Apa yang sedang berlaku?\N{\i1} - Cemerlang
Dialog: 0,1:11:23.68,1:11:25.31,teks umum,,0,0,0,,Lawan terakhir Chang Wook,
Dialog: 0,1:11:26.06,1:11:27.02,teks umum,,0,0,0,,kehadapan
Dialog: 0,1:11:55.46,1:11:56.38,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:11:58.30,1:12:00.09,teks umum,,0,0,0,,Hari ini bertarung dengan kamu
Dialog: 0,1:12:01.30,1:12:02.60,teks umum,,0,0,0,,Saya akan ke sana
Dialog: 0,1:12:57.02,1:13:01.99,pratonton,,0,0,0,,Uk boleh membawa huru-hara kepada dunia ini
Dialog: 0,1:13:02.07,1:13:04.28,pratonton,,0,0,0,,Apa yang berlaku jika dia menarik perhatian?
Dialog: 0,1:13:04.37,1:13:06.20,pratonton,,0,0,0,,Kita mesti pilih yang pasti menang
Dialog: 0,1:13:06.28,1:13:08.79,pratonton,,0,0,0,,Saya akan menang dan membawanya bersama saya sebagai pembantu rumah
Dialog: 0,1:13:08.87,1:13:12.75,pratonton,,0,0,0,,Adakah dia menguasai teknik sembilan lawan sebelum ini?
Dialog: 0,1:13:12.83,1:13:13.79,pratonton,,0,0,0,,saya kena cari dia
Dialog: 0,1:13:13.88,1:13:15.00,pratonton,,0,0,0,,Maka anda perlu kehilangan sesuatu
Dialog: 0,1:13:15.08,1:13:17.09,pratonton,,0,0,0,,Kasih hormatmu tidak menyerah kepada sesiapa
Dialog: 0,1:13:17.17,1:13:20.01,pratonton,,0,0,0,,Barulah saya dapat menatap matanya tanpa rasa malu
Dialog: 0,1:13:20.09,1:13:23.84,pratonton,,0,0,0,,Tanya sekitar tentang Moo Deok. Perempuan jenis apa dia
Dialog: 0,1:13:23.93,1:13:26.10,pratonton,,0,0,0,,"Pandangan yang penuh dengan kelembutan", sama dengan saya
Dialog: 0,1:13:26.18,1:13:27.35,pratonton,,0,0,0,,Anda tidak menganggap saya seorang wanita
Dialog: 0,1:13:27.43,1:13:29.93,pratonton,,0,0,0,,- Jangan menyesal kemudiannya\N- Okay, teruskan!
Dialog: 0,1:13:31.14,1:13:34.81,pratonton,,0,0,0,,Saya sangat suka kamu, tuan
Dialog: 0,0:02:57.14,0:02:59.14,nicks,,0,0,0,,

