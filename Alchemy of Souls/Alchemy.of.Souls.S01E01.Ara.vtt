Dialogue: 0,0:02:49.14,0:02:51.14,الألقاب,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} سانا، مارتيني
Dialogue: 0,0:02:51.14,0:02:53.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، تومو
Dialogue: 0,0:01:36.44,0:01:37.94,نص عام,,0,0,0,,طفل مسكين
Dialogue: 0,0:01:38.74,0:01:41.03,نص عام,,0,0,0,,هنا، تناول القليل من الطعام
Dialogue: 0,0:01:41.11,0:01:42.28,نص عام,,0,0,0,,عزيزتي,
Dialogue: 0,0:01:44.87,0:01:45.95,نص عام,,0,0,0,,تناول الطعام
Dialogue: 0,0:01:50.33,0:01:51.87,نص عام,,0,0,0,,سأحضر لك المزيد من اللحوم
Dialogue: 0,0:01:52.46,0:01:53.88,نص عام,,0,0,0,,امضغ ببطء
Dialogue: 0,0:02:34.46,0:02:35.46,نص عام,,0,0,0,,أمي
Dialogue: 0,0:03:28.35,0:03:29.43,نص عام,,0,0,0,,غون!
Dialogue: 0,0:03:33.10,0:03:35.98,النص العام,,0,0,0,,طلبت منك أن تخبرني إذا حدث له شيء
Dialogue: 0,0:03:36.06,0:03:37.81,نص عام,,0,0,0,,كيف تسمح بحدوث هذا؟
Dialogue: 0,0:03:37.90,0:03:40.44,النص العام,,0,0,0,,يعود إلى رشده مشبعاً بالطاقة البشرية
Dialogue: 0,0:03:40.52,0:03:42.03,نص عام,,0,0,0,,يعود طبيعياً مرة أخرى
Dialogue: 0,0:03:42.11,0:03:43.99,النص العام,,0,0,0,,ابنك أصبح جامحًا
Dialogue: 0,0:03:47.82,0:03:49.32,نص عام,,0,0,0,,سوف آخذ روحه
Dialogue: 0,0:03:50.28,0:03:51.99,نص عام,,0,0,0,,لن أسمح بذلك!
Dialogue: 0,0:03:52.08,0:03:54.54,general text,,0,0,0,,لقد حولت ابني إلى ابتلاع روح!
Dialogue: 0,0:03:54.62,0:03:56.79,نص عام,,0,0,0,,احصلي له على جسد جديد،
Dialogue: 0,0:03:56.87,0:03:59.13,نص عام,,0,0,0,,أو تتغذى على أرواح البشر!
Dialogue: 0,0:03:59.88,0:04:01.17,نص عام,,0,0,0,,أعد ابني!
Dialogue: 0,0:04:01.71,0:04:03.42,نص عام,,0,0,0,,أعيديه لي!
Dialogue: 0,0:04:04.09,0:04:06.17,general text,,0,0,0,,إذا تبين أن I\N استخدم السحر المحرم،
Dialogue: 0,0:04:07.18,0:04:08.76,نص عام,,0,0,0,,النهاية لكلينا
Dialogue: 0,0:04:09.39,0:04:11.01,نص عام,,0,0,0,,لا...
Dialogue: 0,0:04:11.10,0:04:11.93,نص عام,,0,0,0,,من فضلك...
Dialogue: 0,0:04:16.31,0:04:18.69,نص عام,,0,0,0,,لا، من فضلك! غون!
Dialogue: 0,0:04:19.56,0:04:22.19,نص عام,,0,0,0,,ابق معي لفترة أطول قليلاً
Dialogue: 0,0:04:22.82,0:04:23.94,نص عام,,0,0,0,,يا بني...
Dialogue: 0,0:05:36.43,0:05:39.98,italics,,0,0,0,,لماذا تتحول أجساد مبتلع الأرواح إلى حجارة عندما توحش؟
Dialogue: 0,0:05:40.06,0:05:43.36,النص العام,,0,0,0,,تتشكل الشقوق عندما تتعارض الأرواح الممتصة مع الجسد
Dialogue: 0,0:05:44.44,0:05:46.48,النص العام,,0,0,0,,وهذا يؤدي إلى فقدان الطاقة
Dialogue: 0,0:05:47.07,0:05:49.74,نص عام,,0,0,0,,هذا بالفعل الوحشي الثامن
Dialogue: 0,0:05:50.28,0:05:52.70,نص عام,,0,0,0,,يبدو أن الوقت قد حان لوقف هذا
Dialogue: 0,0:05:53.32,0:05:55.12,نص عام,,0,0,0,,يجب أن تذهب إلى القصر
Dialogue: 0,0:05:56.37,0:05:59.91,general text,,0,0,0,,جلالة الملك مهتم بتعويذة جديدة،
Dialogue: 0,0:06:00.00,0:06:01.67,نص عام,,0,0,0,,الذي حاولت إتقانه
Dialogue: 0,0:06:36.58,0:06:37.66,نص عام,,0,0,0,,سمعت...
Dialogue: 0,0:06:38.70,0:06:41.54,نص عام,,0,0,0,,أنت تتعلم تعويذة جديدة
Dialogue: 0,0:06:42.04,0:06:45.71,نص عام,,0,0,0,,لا يوجد شيء مهم. نعم، فقط من أجل المتعة
Dialogue: 0,0:06:46.33,0:06:49.59,النص العام,,0,0,0,,أعلم أنني لا أستطيع أن أطلب العيش لفترة أطول
Dialogue: 0,0:06:49.67,0:06:50.84,نص عام,,0,0,0,,هذا فقط...
Dialogue: 0,0:06:50.92,0:06:54.09,نص عام,,0,0,0,,يزعجني أنني لا أملك وريثاً
Dialogue: 0,0:06:54.93,0:06:56.93,نص عام,,0,0,0,,أتمنى لك الشفاء العاجل
Dialogue: 0,0:06:57.72,0:07:00.22,النص العام,,0,0,0,,هذا الجسد الضعيف لا يقوى على شيء
Dialogue: 0,0:07:01.02,0:07:03.19,نص عام,,0,0,0,,سأحظى بفرصة،
Dialogue: 0,0:07:04.27,0:07:07.94,نص عام,,0,0,0,,دمي سليماً وشاباً
Dialogue: 0,0:07:09.90,0:07:12.86,نص عام,,0,0,0,,تبادل الجسد غير ممكن
Dialogue: 0,0:07:16.16,0:07:18.41,نص عام,,0,0,0,,لكنك تستطيع
Dialogue: 0,0:07:22.54,0:07:23.66,نص عام,,0,0,0,,كيمياء النفوس
Dialogue: 0,0:07:32.13,0:07:34.01,نص عام,,0,0,0,,هذا سحر حرام
Dialogue: 0,0:07:34.09,0:07:37.39,general text,,0,0,0,,إذا لم يندمج الجسد والروح، فمن الممكن أن تتحول إلى روح شريرة
Dialogue: 0,0:07:37.47,0:07:39.05,نص عام,,0,0,0,,كيف أجرؤ
Dialogue: 0,0:07:39.14,0:07:41.68,نص عام,,0,0,0,,نقل روح الملك إلى جسد شخص آخر؟
Dialogue: 0,0:07:41.77,0:07:44.18,نص عام,,0,0,0,,ماذا عن جسمك؟
Dialogue: 0,0:07:47.35,0:07:49.36,نص عام,,0,0,0,,لسبعة أيام فقط
Dialogue: 0,0:07:49.90,0:07:51.82,نص عام,,0,0,0,,دعونا نتبادل الجثث لمدة أسبوع
Dialogue: 0,0:07:54.99,0:07:58.07,مائل,,0,0,0,,سمعت أنك نقلت روحًا إلى جسد رجل ميت
Dialogue: 0,0:07:58.87,0:08:01.49,النص العام,,0,0,0,,وعاشت هذه الروح في جسد جديد ستة أشهر
Dialogue: 0,0:08:02.70,0:08:06.87,general text,,0,0,0,,أنا ملك، السماء تحميني. وأنت أفضل ساحر في البلاد
Dialogue: 0,0:08:06.96,0:08:08.46,نص عام,,0,0,0,,فما الذي يدعو للقلق؟
Dialogue: 0,0:08:09.67,0:08:13.05,نص عام,,0,0,0,,وخلال أسبوع ستعود كل شيء كما كان
Dialogue: 0,0:08:16.34,0:08:19.30,نص عام,,0,0,0,,يمكنك أن تفعل ما بوسعك
Dialogue: 0,0:08:19.39,0:08:20.89,نص عام,,0,0,0,,الأقوى فقط
Dialogue: 0,0:08:22.18,0:08:24.02,نص عام,,0,0,0,,الآن أنت تضيع وقتك.
Dialogue: 0,0:08:24.10,0:08:26.06,نص عام,,0,0,0,,نقل الأرواح إلى أجساد الموتى
Dialogue: 0,0:08:30.98,0:08:32.11,نص عام,,0,0,0,,شان غان,
Dialogue: 0,0:08:32.82,0:08:34.53,نص عام,,0,0,0,,امنح الملك جسدًا جديدًا
Dialogue: 0,0:11:15.44,0:11:18.02,نص عام,,0,0,0,,تبادلنا أنا والملك الجثث
Dialogue: 0,0:11:26.74,0:11:28.99,مائل,,0,0,0,,يجب أن أجعل دو هوا ملكي
Dialogue: 0,0:11:29.08,0:11:31.58,مائل,,0,0,0,,إذا حملت فالطفل لي
Dialogue: 0,0:11:34.08,0:11:35.33,نص عام,,0,0,0,,للحمد...
Dialogue: 0,0:11:39.75,0:11:40.88,نص عام,,0,0,0,,دو هوا,
Dialogue: 0,0:11:42.21,0:11:43.84,نص عام,,0,0,0,,أنت جميلة جداً
Dialogue: 0,0:11:54.98,0:11:57.52,نص عام,,0,0,0,,لا، لا يجوز هذا
Dialogue: 0,0:12:02.07,0:12:04.90,نص عام,,0,0,0,,هذا لا يمكن السماح به!
الحوار: 0,0:12:05.57,0:12:06.78,نص عام,,0,0,0,,لا!
Dialogue: 0,0:12:29.09,0:12:32.18,مائل,,0,0,0,,قوة السماء تحرك الرياح والسحب والمطر
Dialogue: 0,0:12:32.68,0:12:34.31,مائل,,0,0,0,,بعد أن وصلت إلى الأرض، هذه القوة
Dialogue: 0,0:12:35.89,0:12:38.10,خط مائل,,0,0,0,,خلق طاقة هائلة
Dialogue: 0,0:12:38.19,0:12:40.56,مائل,,0,0,0,,تم بناء دولة بأكملها على بحيرة جيونج تشونج دايهو
Dialogue: 0,0:12:40.65,0:12:42.61,مائل,,0,0,0,,على البحيرة التي جسدت هذه الطاقة
Dialogue: 0,0:12:42.69,0:12:46.32,مائل,,0,0,0,,كانت البلاد تسمى ديهو نسبة إلى البحيرة التي تقف عليها
Dialogue: 0,0:12:48.40,0:12:51.66,مائل,,0,0,0,,الأشخاص الذين يمكنهم التحكم في هذه الطاقة،
Dialogue: 0,0:12:51.74,0:12:53.41,خط مائل,,0,0,0,,يُطلق عليهم السحرة
Dialogue: 0,0:12:55.37,0:12:58.50,italics,,0,0,0,,هذه القصة تدور حول سحرة ديهو، مكان غير موجود
Dialogue: 0,0:12:58.58,0:13:00.54,خط مائل,,0,0,0,,لا في الكتب المدرسية ولا في الخرائط
Dialogue: 0,0:13:16.43,0:13:20.19,نقوش,,0,0,0,,بعد 20 سنة
Dialogue: 0,0:13:29.61,0:13:31.03,خط مائل,,0,0,0,,إذاً أنت ناك سو،
Dialogue: 0,0:13:31.11,0:13:33.12,خط مائل,,0,0,0,,محارب يجوب المدينة
Dialogue: 0,0:13:33.74,0:13:35.16,خط مائل,,0,0,0,,ويقتل السحرة
Dialogue: 0,0:13:35.24,0:13:36.83,نص عام,,0,0,0,,اسمي ناك سو لأنه،
Dialogue: 0,0:13:36.91,0:13:39.21,نص عام,,0,0,0,,حيث لن أذهب،
Dialogue: 0,0:13:39.29,0:13:40.46,نص عام,,0,0,0,,الرؤوس تطير من الأكتاف*
Dialogue: 0,0:13:39.29,0:13:40.46,ملاحظات,,0,0,0,,*اسمها مشابه للتعبير
Dialogue: 0,0:13:41.21,0:13:42.92,نص عام,,0,0,0,,اسم عظيم، أليس كذلك؟
Dialogue: 0,0:13:44.13,0:13:45.17,النص العام,,0,0,0,,اقتلها
Dialogue: 0,0:13:47.63,0:13:48.51,نص عام,,0,0,0,,أطلق النار!
Dialogue: 0,0:16:46.81,0:16:48.27,نص عام,,0,0,0,,لا تدعها تفلت من أيدينا
Dialogue: 0,0:16:48.94,0:16:50.44,نص عام,,0,0,0,,- أمسكها\N- نعم!
Dialogue: 0,0:17:03.33,0:17:05.04,مائل,,0,0,0,,هناك. اتبعني
Dialogue: 0,0:17:15.59,0:17:16.84,نص عام,,0,0,0,,هناك!
Dialogue: 0,0:18:06.93,0:18:08.31,نص عام,,0,0,0,,لن أموت هنا
Dialogue: 0,0:18:09.14,0:18:10.35,نص عام,,0,0,0,,لا أستطيع
Dialogue: 0,0:18:19.19,0:18:23.28,خط مائل,,0,0,0,,كم نفد صبرنا. نعم اذهب
Dialogue: 0,0:18:39.38,0:18:40.63,نص عام,,0,0,0,,ماذا تريد؟
Dialogue: 0,0:18:43.72,0:18:45.89,خط مائل,,0,0,0,,الجنة!
Dialogue: 0,0:19:10.58,0:19:11.87,نقوش,,0,0,0,,نزل
Dialogue: 0,0:19:19.46,0:19:20.63,النص العام,,0,0,0,,ميت
Dialogue: 0,0:19:41.98,0:19:43.69,نص عام,,0,0,0,,ليس هناك علامة زرقاء عليها
Dialogue: 0,0:19:47.49,0:19:50.08,general text,,0,0,0,,العلامة تثبت أن روحها انتقلت إلى جسد آخر
Dialogue: 0,0:19:51.49,0:19:52.95,النص العام,,0,0,0,,اتضح أنها لا تستطيع ذلك
Dialogue: 0,0:19:54.12,0:19:55.50,نص عام,,0,0,0,,الاندماج مع جسد آخر؟
Dialogue: 0,0:20:24.40,0:20:29.24,نقوش,,0,0,0,,سوسنوفي بور
Dialogue: 0,0:20:32.70,0:20:33.62,خط مائل,,0,0,0,,مرات
Dialogue: 0,0:20:36.04,0:20:36.87,خط مائل,,0,0,0,,اثنان
Dialogue: 0,0:20:38.67,0:20:39.71,خط مائل,,0,0,0,,ثلاثة
Dialogue: 0,0:20:59.06,0:21:01.61,نص عام,,0,0,0,,يول، تعال
Dialogue: 0,0:21:05.82,0:21:07.36,نص عام,,0,0,0,,هل هذا ناك سو؟
Dialogue: 0,0:21:08.20,0:21:09.16,نص عام,,0,0,0,,نعم
Dialogue: 0,0:21:10.57,0:21:13.70,general text,,0,0,0,,هذه العلامة تدل على خروج الروح من الجسد
Dialogue: 0,0:21:14.29,0:21:17.16,نص عام,,0,0,0,,تذكريها. إذا قام شخص ما بتبديل الجثث،
Dialogue: 0,0:21:17.25,0:21:20.96,النص العام,,0,0,0,,تبقى هذه الكدمة فوق القلب مباشرة
Dialogue: 0,0:21:22.08,0:21:24.96,general text,,0,0,0,,فهربت روحها؟
Dialogue: 0,0:21:25.05,0:21:28.55,نص عام,,0,0,0,,على ما يبدو أنني حاولت، لكني لم أستطع
Dialogue: 0,0:21:29.30,0:21:31.51,general text,,0,0,0,,هذا يعني أن الروح قد تركتها،
Dialogue: 0,0:21:31.59,0:21:35.43,نص عام,,0,0,0,,لكننا لم نعثر على أي أثر لانتقالها إلى جثة أخرى
Dialogue: 0,0:21:45.57,0:21:47.94,general text,,0,0,0,,- هل هذه صفارة\N- صفارة؟
Dialogue: 0,0:21:48.03,0:21:50.91,النص العام,,0,0,0,,كان لدي نفس الشيء عندما كنت أربي طائرًا في المنزل
Dialogue: 0,0:21:52.87,0:21:55.28,النص العام,,0,0,0,,هل كان لديها طائر؟
Dialogue: 0,0:21:55.37,0:21:57.37,نص عام,,0,0,0,,أعتقد أنه كان لفترة من الوقت
Dialogue: 0,0:21:58.16,0:21:59.96,النص العام,,0,0,0,,يبدو أنه مهم بالنسبة لها
Dialogue: 0,0:22:00.79,0:22:03.92,general text,,0,0,0,,هي محاربة تقتل الناس يميناً ويساراً،
Dialogue: 0,0:22:04.00,0:22:08.38,نص عام,,0,0,0,,لكنها لا تزال شخصًا. ربما كانت لديها قصتها الخاصة.
Dialogue: 0,0:22:16.31,0:22:18.89,نص عام,,0,0,0,,شاهدت مجموعة من الناس جثة ناك سو
Dialogue: 0,0:22:18.98,0:22:21.19,نص عام,,0,0,0,,تنتشر الشائعات حول كيمياء النفوس
Dialogue: 0,0:22:21.85,0:22:24.86,نص عام,,0,0,0,,20 سنة مرت منذ أن رأينا آخر بدو
Dialogue: 0,0:22:25.40,0:22:26.40,نص عام,,0,0,0,,نعم
Dialogue: 0,0:22:27.48,0:22:30.90,general text,,0,0,0,,تحول إلى ابتلاع أرواح وقتل الكثير من الناس
Dialogue: 0,0:22:31.90,0:22:35.24,نص عام,,0,0,0,,أخشى أن يتكرر الأمر مرة أخرى
Dialogue: 0,0:22:35.83,0:22:38.20,نص عام,,0,0,0,,عمي!
Dialogue: 0,0:22:40.04,0:22:42.79,general text,,0,0,0,,عمي، سمعت أن ناك سو كان بدوياً
Dialogue: 0,0:22:43.37,0:22:45.29,general text,,0,0,0,,سيد هيو، هل رأيتها أيضًا؟
Dialogue: 0,0:22:45.38,0:22:48.84,نص عام,,0,0,0,,وأنت قلق للغاية بشأن الشائعات
Dialogue: 0,0:22:48.92,0:22:51.59,نص عام,,0,0,0,,لقد انتشرت الشائعات بالفعل. جئت أركض بمجرد أن سمعت
Dialogue: 0,0:22:52.22,0:22:54.05,general text,,0,0,0,,- أين سمعت ذلك؟\N- إلى Chwisongru
Dialogue: 0,0:22:54.14,0:22:55.85,نص عام,,0,0,0,,يمكنك جيونجينجاك
Dialogue: 0,0:22:55.93,0:22:59.72,general text,,0,0,0,,وبدلاً من الدراسة ركضت إلى الشعراء لالتقاط الشائعات
Dialogue: 0,0:23:01.27,0:23:05.77,general text,,0,0,0,,في غابة الصنوبر في تشونجينجاك، لا يتم إلقاء التعويذات فحسب،
Dialogue: 0,0:23:05.86,0:23:07.73,نص عام,,0,0,0,,لكنهم يجمعون المعلومات أيضًا
Dialogue: 0,0:23:08.77,0:23:11.15,النص العام,,0,0,0,,وسيذهب دان غو الخاص بنا
Dialogue: 0,0:23:11.24,0:23:13.40,نص عام,,0,0,0,,على خطاك
Dialogue: 0,0:23:13.49,0:23:15.57,النص العام,,0,0,0,,وسوف يصبح رئيس سوسنوفي بور
Dialogue: 0,0:23:15.66,0:23:17.49,نص عام,,0,0,0,,يجب أن يكون قادرًا على الشرب
Dialogue: 0,0:23:17.58,0:23:18.62,نص عام,,0,0,0,,الآن أخبرني،
Dialogue: 0,0:23:19.33,0:23:21.62,general text,,0,0,0,,ما هو أفضل شيء للشرب في جويسيونرو؟
Dialogue: 0,0:23:22.58,0:23:25.54,general text,,0,0,0,,لا أذهب إلى هناك كثيرًا الآن، لأن أوكا ليست هنا
Dialogue: 0,0:23:25.62,0:23:27.63,نص عام,,0,0,0,,المملكة المتحدة؟ ابن تشانغ غان؟
Dialogue: 0,0:23:27.71,0:23:32.09,general text,,0,0,0,,هل يدرس الكتابة في مدرسة قرية يونغتشوندان؟
Dialogue: 0,0:23:32.17,0:23:34.26,general text,,0,0,0,,لقد طردوه من هناك منذ زمن طويل.
Dialogue: 0,0:23:34.34,0:23:36.26,نص عام,,0,0,0,,الآن هو في كيسان
Dialogue: 0,0:23:36.34,0:23:40.06,general text,,0,0,0,,أرسلته ليدرس مع الراهب البوذي هو يونغ
Dialogue: 0,0:23:41.52,0:23:45.23,general text,,0,0,0,,هل ذهبت المملكة المتحدة إلى المعبد البوذي في وقت كذا وكذا؟
Dialogue: 0,0:23:46.85,0:23:49.69,نص عام,,0,0,0,,اليوم أتخرج
Dialogue: 0,0:23:51.19,0:23:53.86,النص العام,,0,0,0,,لكنك لم تتقن كل شيء
Dialogue: 0,0:23:53.94,0:23:57.07,النص العام,,0,0,0,,كيف تجرؤ على فعل ذلك دون إذني؟!
Dialogue: 0,0:23:57.16,0:23:58.53,النص العام,,0,0,0,,لقد طلبت توسيع معرفتي،
Dialogue: 0,0:23:58.62,0:24:01.45,نص عام,,0,0,0,,لذلك قرأت وحفظت المئات من كتب التعويذة
Dialogue: 0,0:24:01.54,0:24:03.29,نص عام,,0,0,0,,لقد طلبت تدريب عقلك،
Dialogue: 0,0:24:03.37,0:24:05.92,النص العام,,0,0,0,,فشحذت بصبر مئات السيوف
Dialogue: 0,0:24:06.00,0:24:09.92,نص عام,,0,0,0,,فقط أنت لم تعلمني تعويذة واحدة
Dialogue: 0,0:24:10.54,0:24:12.88,نص عام,,0,0,0,,الشيء الوحيد الذي تعلمته هنا هو
Dialogue: 0,0:24:12.96,0:24:17.47,نص عام,,0,0,0,,لن تعلمني التعاويذ
Dialogue: 0,0:24:18.05,0:24:20.51,نص عام,,0,0,0,,والآن بعد أن تعلمت هذا الدرس،
Dialogue: 0,0:24:20.60,0:24:22.26,نص عام,,0,0,0,,أريد مغادرة هذا المكان
Dialogue: 0,0:24:22.77,0:24:25.98,general text,,0,0,0,,قال رئيس سوسنوفي بور أن يبقيك هنا لمدة ثلاث سنوات
Dialogue: 0,0:24:26.06,0:24:29.36,النص العام,,0,0,0,,أعلم أنك تبني معبدًا بالمال الذي دفعته لك.
Dialogue: 0,0:24:29.44,0:24:32.32,نص عام,,0,0,0,,لن أطلب تعويضاً، أتمنى أن يكتمل المعبد
Dialogue: 0,0:24:34.24,0:24:37.45,نص عام,,0,0,0,,إلى أين أنت ذاهب؟ لم أسمح لك بالمغادرة
Dialogue: 0,0:24:39.32,0:24:42.74,general text,,0,0,0,,ومن أين جاءتك فكرة أنني طلبت الإذن؟
Dialogue: 0,0:24:45.33,0:24:47.41,مائل,,0,0,0,,حمل بسبب علاقة عرضية بين الأم،
Dialogue: 0,0:24:47.50,0:24:49.17,خط مائل,,0,0,0,,تركه والده،
Dialogue: 0,0:24:49.25,0:24:51.75,مائل,,0,0,0,,ماذا تعرف عن احترام السيد؟
Dialogue: 0,0:24:51.84,0:24:54.59,النص العام,,0,0,0,,أنا أرفض تعليم شخص مثلك
Dialogue: 0,0:24:55.63,0:24:57.80,نص عام,,0,0,0,,طالبة محترمة، أنا لست جيدة،
Dialogue: 0,0:24:57.88,0:24:59.51,نص عام,,0,0,0,,لكنني أعرف كيفية تحصيل الديون
Dialogue: 0,0:24:59.59,0:25:01.18,نص عام,,0,0,0,,كلمة أخرى،
Dialogue: 0,0:25:01.26,0:25:03.47,نص عام,,0,0,0,,ولن تكمل المعبد أبدًا
Dialogue: 0,0:25:05.10,0:25:06.89,نص عام,,0,0,0,,سأطالب باستعادة أموالي
Dialogue: 0,0:25:07.60,0:25:12.36,general text,,0,0,0,,لن يعلمك أحد في العالم التعاويذ بسبب والدك
Dialogue: 0,0:25:12.44,0:25:14.98,نص عام,,0,0,0,,حسنًا، شكرًا لك على اهتمامك.
Dialogue: 0,0:25:16.03,0:25:19.53,نص عام,,0,0,0,,سوف أجد سيدي
Dialogue: 0,0:25:20.28,0:25:23.41,النص العام,,0,0,0,,شخص قوي وماهر بشكل لا يصدق
Dialogue: 0,0:25:40.68,0:25:42.34,النص العام,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,0:26:43.24,0:26:46.16,خلف الكواليس,,0,0,0,,لماذا انتهى بي الأمر في مثل هذا الجسد؟
Dialogue: 0,0:26:49.16,0:26:51.37,التعليق الصوتي,,0,0,0,,أنا متأكد من أنها كانت عمياء
Dialogue: 0,0:26:56.50,0:26:58.30,خلف الكواليس,,0,0,0,,ولكن ماذا أرى؟
Dialogue: 0,0:26:58.96,0:27:00.67,خلف الكواليس,,0,0,0,,لأن الروح مختلفة؟
Dialogue: 0,0:27:03.47,0:27:06.26,خارج الشاشة,,0,0,0,,ليس لديها حتى علامة زرقاء
Dialogue: 0,0:27:06.35,0:27:07.76,خلف الكواليس,,0,0,0,,كم هو غير عادي
Dialogue: 0,0:27:08.85,0:27:11.89,general text,,0,0,0,,اصبر قليلاً يا مو دوك. قريبًا لن تشعر بدوار الحركة، فأنت على وشك الانتهاء
Dialogue: 0,0:27:14.44,0:27:15.40,خلف الكواليس,,0,0,0,"مو دوك"
Dialogue: 0,0:27:15.48,0:27:18.98,التعليق الصوتي,,0,0,0,,هذه فتاة عمياء من القرية تم بيعها للحصن
Dialogue: 0,0:27:22.53,0:27:23.90,نص عام,,0,0,0,,اجلس ستسقط
Dialogue: 0,0:27:34.87,0:27:36.33,نص عام,,0,0,0,,شكرًا على الرحلة
Dialogue: 0,0:27:37.21,0:27:38.21,نص عام,,0,0,0,,سأنزل من هنا
Dialogue: 0,0:27:50.64,0:27:51.93,خلف الكواليس,,0,0,0,,ما خطبي؟
Dialogue: 0,0:27:52.47,0:27:53.85,خلف الكواليس,,0,0,0,,لقد غادرت القوات
Dialogue: 0,0:27:54.60,0:27:57.02,خارج الإطار,,0,0,0,,ألا يستطيع هذا الجسد حتى النهوض هنا؟
Dialogue: 0,0:27:59.11,0:28:00.27,خلف الكواليس,,0,0,0,,الأيدي ضعيفة جدًا
Dialogue: 0,0:28:01.19,0:28:02.44,نص عام,,0,0,0,,اجاشي!
Dialogue: 0,0:28:03.03,0:28:04.65,نص عام,,0,0,0,,- مساعدة!\N- ماذا...
Dialogue: 0,0:28:04.74,0:28:06.49,نص عام,,0,0,0,,- اجاشي\N- القديسون...
Dialogue: 0,0:28:06.57,0:28:07.91,نص عام,,0,0,0,,مو دوك، انتظر
Dialogue: 0,0:28:07.99,0:28:08.87,نص عام,,0,0,0,,اجاشي!
Dialogue: 0,0:28:08.95,0:28:11.62,نص عام,,0,0,0,,اقلب القارب. خلف!
Dialogue: 0,0:28:11.70,0:28:13.29,النص العام,,0,0,0,,- الجنة...\N- مو دوك!
Dialogue: 0,0:28:13.37,0:28:14.46,التعليق الصوتي,,0,0,0,,سوف أسقط
Dialogue: 0,0:28:14.54,0:28:15.58,نص عام,,0,0,0,,اجاشي!
Dialogue: 0,0:28:27.47,0:28:31.56,general text,,0,0,0,,لماذا أنت معلق هناك إذا كنت لا تستطيع حتى الرؤية؟
Dialogue: 0,0:28:31.64,0:28:32.97,نص عام,,0,0,0,,كان من الممكن أن تتأذى
Dialogue: 0,0:28:34.81,0:28:36.27,خلف الكواليس,,0,0,0,,كل شيء سيء للغاية
Dialogue: 0,0:28:36.35,0:28:38.19,خلف الكواليس,,0,0,0,,قوتي تركتني
Dialogue: 0,0:28:43.69,0:28:45.15,نص عام,,0,0,0,,هل تشعر بالمرض مرة أخرى؟
Dialogue: 0,0:28:45.82,0:28:49.03,نص عام,,0,0,0,,أنا قلقة جدًا بشأن ضعفك
Dialogue: 0,0:28:49.62,0:28:51.08,خلف الكواليس,,0,0,0,,ضعف
Dialogue: 0,0:28:51.16,0:28:53.54,التعليق الصوتي,,0,0,0,,هذا الجسد ضعيف جدًا وغير صحي
Dialogue: 0,0:28:54.24,0:28:57.37,خلف الكواليس,,0,0,0,,لا يمكنك تغيير أجسادك كثيرًا. دعونا نبقى قليلا مو دوك
Dialogue: 0,0:28:58.00,0:29:00.29,نص عام,,0,0,0,,عذراً اجاشي
Dialogue: 0,0:29:00.38,0:29:01.63,نص عام,,0,0,0,,لا شيء
Dialogue: 0,0:29:01.71,0:29:03.38,نص عام,,0,0,0,,كل هذا بسبب ضعف الجسد
Dialogue: 0,0:29:04.13,0:29:05.30,نص عام,,0,0,0,,هيا بنا نأكل
Dialogue: 0,0:29:18.14,0:29:18.98,نص عام,,0,0,0,,- طعامك\N- شكرًا لك
Dialogue: 0,0:29:19.06,0:29:20.81,نص عام,,0,0,0,,اليوم سنأكل
Dialogue: 0,0:29:20.90,0:29:22.27,نص عام,,0,0,0,,هذه دجاجة. أكل
Dialogue: 0,0:29:23.61,0:29:26.11,التعليق الصوتي,,0,0,0,,كمحارب، أنا حساس لرائحة الدم
Dialogue: 0,0:29:26.19,0:29:30.07,التعليق الصوتي,,0,0,0,,أنا لا آكل لحم الحيوانات التي دمها نفس لون الإنسان
Dialogue: 0,0:29:30.16,0:29:31.82,النص العام,,0,0,0,,- لا أريد\N- آكل فقط
Dialogue: 0,0:29:39.79,0:29:42.42,خلف الكواليس,,0,0,0,,لأول مرة...آكل اللحم
Dialogue: 0,0:29:43.75,0:29:44.92,خلف الكواليس,,0,0,0,,لذيذ
Dialogue: 0,0:29:49.68,0:29:50.76,نص عام,,0,0,0,,أنت تنظر
Dialogue: 0,0:29:50.84,0:29:54.47,نص عام,,0,0,0,,أنا حقًا لا أريد أن أرسلك إلى هناك،
Dialogue: 0,0:29:54.56,0:29:57.35,general text,,0,0,0,,ولكن هذا هو المكان الوحيد الذي اتفقوا فيه على قبول شخص أعمى
Dialogue: 0,0:29:59.77,0:30:02.90,نص عام,,0,0,0,"أين"؟ أين؟
Dialogue: 0,0:30:05.69,0:30:08.82,مائل,,0,0,0,,أخذتها امرأة بعد وفاة والديها
Dialogue: 0,0:30:08.90,0:30:11.07,النص العام,,0,0,0,,لكنها مرضت وماتت
Dialogue: 0,0:30:11.16,0:30:13.66,general text,,0,0,0,,انتقل إليها دينها بسبب المرض،
Dialogue: 0,0:30:13.74,0:30:15.62,نص عام,,0,0,0,,لذلك يتم بيعه هنا
Dialogue: 0,0:30:15.70,0:30:16.66,نص عام,,0,0,0,,سأذهب
Dialogue: 0,0:30:17.66,0:30:19.91,general text,,0,0,0,,لا يمكنك بيع هذه الروح لمنزل كيسينغ
Dialogue: 0,0:30:20.00,0:30:22.37,نص عام,,0,0,0,,- حظاً موفقاً\N- لكن...
Dialogue: 0,0:30:24.54,0:30:27.50,التعليق الصوتي,,0,0,0,,لا أستطيع أن أصدق أنه أطعمني دجاجًا حتى يتمكن من بيعي هنا لاحقًا
Dialogue: 0,0:30:27.59,0:30:30.72,التعليق الصوتي,,0,0,0,,سأمزقك إلى أشلاء بمجرد أن أستعيد قوتي
Dialogue: 0,0:30:31.22,0:30:33.30,نص عام,,0,0,0,,رقيق جدًا
Dialogue: 0,0:30:33.39,0:30:36.22,general text,,0,0,0,,ربما تصبح أجمل إذا ملأت خديك
Dialogue: 0,0:30:36.31,0:30:38.72,نص عام,,0,0,0,,أسقطه. لن يساعدني
Dialogue: 0,0:30:39.31,0:30:41.89,general text,,0,0,0,,أنا عديم الفائدة وغير مناسب لدور الجيسينغ
Dialogue: 0,0:30:41.98,0:30:43.35,نص عام,,0,0,0,,أرسلني إلى مكان آخر
Dialogue: 0,0:30:43.44,0:30:45.56,نص عام,,0,0,0,,وأنت تتحدث بشكل جميل
Dialogue: 0,0:30:46.15,0:30:47.32,نص عام,,0,0,0,,سمعتك مازلت تغني
Dialogue: 0,0:30:47.40,0:30:49.78,نص عام,,0,0,0,,آمل أن يكون جيدًا كما تقول
Dialogue: 0,0:30:52.53,0:30:55.41,نص عام,,0,0,0,,أولاً، اغتسل وارتدي ملابسك
Dialogue: 0,0:31:09.76,0:31:11.51,نص عام,,0,0,0,,هل يمكنك حتى الرقص؟
Dialogue: 0,0:31:12.09,0:31:13.22,نص عام,,0,0,0,,هل كانت مثل الرقصة؟
Dialogue: 0,0:31:14.13,0:31:17.30,خارج الشاشة,,0,0,0,,لو كان لدي نفس القوة، فلن يتبقى من يدي شيء
Dialogue: 0,0:31:20.52,0:31:23.19,نص عام,,0,0,0,,أنا أكبر سناً، فتكلم باحترام
Dialogue: 0,0:31:23.27,0:31:25.60,نص عام,,0,0,0,,ومع الضيوف أيضاً
Dialogue: 0,0:31:25.69,0:31:28.07,خارج الشاشة,,0,0,0,,انتظر. سأقتلك أيضا
Dialogue: 0,0:31:29.32,0:31:33.15,نص عام,,0,0,0,,يأتي العديد من الأشخاص المؤثرين لزيارتنا
Dialogue: 0,0:31:33.74,0:31:36.91,general text,,0,0,0,,أربعة مواسم من Daeho هي أيضًا منتظمة في Jwisungru
Dialogue: 0,0:31:38.08,0:31:39.20,نص عام,,0,0,0,,أربعة ماذا؟
Dialogue: 0,0:31:39.28,0:31:42.58,النص العام,,0,0,0,,هناك أربعة أنواع من الأشخاص الجميلين في ديهو
Dialogue: 0,0:31:42.66,0:31:44.75,نص عام,,0,0,0,,يطلق عليهم اسم الفصول الأربعة
Dialogue: 0,0:31:59.51,0:32:02.81,مائل,,0,0,0,,ابنة عائلة جين التي تمتلك قوة حياة الربيع
Dialogue: 0,0:32:03.64,0:32:04.56,خط مائل,,0,0,0,,جين تشو يونغ
Dialogue: 0,0:32:20.08,0:32:22.95,مائل,,0,0,0,,وريث عائلة باك بطاقة صيف حار
Dialogue: 0,0:32:23.04,0:32:24.29,خط مائل,,0,0,0,,باك داك غو
Dialogue: 0,0:32:36.09,0:32:39.43,مائل,,0,0,0,,عبقرية عائلة سو، نبيلة مثل غروب الشمس في الخريف
Dialogue: 0,0:32:40.26,0:32:41.26,خط مائل,,0,0,0,,لذا يول
Dialogue: 0,0:32:59.20,0:33:03.24,مائل,,0,0,0,,والأخير هو تشان ووك، خليفة عائلة تشان،
Dialogue: 0,0:33:03.33,0:33:06.83,مائل,,0,0,0,,مبهر كالثلج في الشتاء
Dialogue: 0,0:33:14.55,0:33:17.30,خط مائل,,0,0,0,,عائلات جين وبارك وسيو وتشان
Dialogue: 0,0:33:17.38,0:33:20.39,النص العام,,0,0,0,,أشهر العائلات السحرية في ديهو
Dialogue: 0,0:33:20.47,0:33:22.47,النص العام,,0,0,0,,يُطلق على أطفالهم اسم الفصول الأربعة
Dialogue: 0,0:33:23.60,0:33:26.22,general text,,0,0,0,,هل هذا ما يسمونهم به في المدينة؟
Dialogue: 0,0:33:28.44,0:33:31.40,نص عام,,0,0,0,,لقد وصل أمير الصيف الخاص بي
Dialogue: 0,0:33:36.28,0:33:38.36,التعليق الصوتي,,0,0,0,,إذا كان وريث عائلة بارك،
Dialogue: 0,0:33:38.95,0:33:40.74,خلف الكواليس,,0,0,0,,إذًا، ابن أخ بارك جين
Dialogue: 0,0:33:43.37,0:33:44.28,خلف الكواليس,,0,0,0,,بارك جين
Dialogue: 0,0:33:47.83,0:33:50.29,خارج الإطار,,0,0,0,,لقد كان هناك تلك الليلة أيضًا
Dialogue: 0,0:33:59.80,0:34:00.84,خلف الكواليس,,0,0,0,,جين
Dialogue: 0,0:34:01.80,0:34:02.93,خلف الكواليس,,0,0,0,,لذا
Dialogue: 0,0:34:03.64,0:34:04.85,خلف الكواليس,,0,0,0,,تشان
Dialogue: 0,0:34:05.56,0:34:06.77,خلف الكواليس,,0,0,0,,باك
Dialogue: 0,0:34:16.11,0:34:17.11,خلف الكواليس,,0,0,0,,أربعة مواسم
Dialogue: 0,0:34:18.57,0:34:22.36,نص عام,,0,0,0,,عندما أصل إليك، ستكون النهاية
Dialogue: 0,0:34:25.37,0:34:27.87,نص عام,,0,0,0,,واجه موتك بنبل
Dialogue: 0,0:34:31.96,0:34:34.63,نص عام,,0,0,0,,من تريد أن تقابل اليوم؟
Dialogue: 0,0:34:34.71,0:34:38.55,نص عام,,0,0,0,,قال العم أحضر أحداً
Dialogue: 0,0:34:39.13,0:34:41.30,نص عام,,0,0,0,,أحضر أحداً؟ مَن؟
Dialogue: 0,0:34:41.38,0:34:44.01,نص عام,,0,0,0,,طالب في كيسان,
Dialogue: 0,0:34:44.09,0:34:47.01,النص العام,,0,0,0,,الذي أذل السيد ونفي
Dialogue: 0,0:34:48.14,0:34:50.64,نص عام,,0,0,0,,أنا متأكد من أنه مختبئ هنا
Dialogue: 0,0:34:51.52,0:34:53.15,نص عام,,0,0,0,,أنت تنظر
Dialogue: 0,0:34:53.23,0:34:56.48,نص عام,,0,0,0,,كنت أشتاق للمأكولات البحرية
Dialogue: 0,0:34:56.57,0:34:58.57,نص عام,,0,0,0,,بعد الحياة في الجبال
Dialogue: 0,0:34:58.65,0:35:00.53,نص عام,,0,0,0,,أعتقد أنه هناك
Dialogue: 0,0:35:22.55,0:35:24.80,النص العام,,0,0,0,,بفضلك كان على عمي أن
Dialogue: 0,0:35:24.89,0:35:27.89,نص عام,,0,0,0,,اذهب إلى كيسان لطلب المغفرة من الراهب
Dialogue: 0,0:35:27.97,0:35:32.73,نص عام,,0,0,0,,وفي هذا الوقت أنت تأكل السرطان هنا
Dialogue: 0,0:35:32.81,0:35:34.48,نص عام,,0,0,0,,لا لن آكل
Dialogue: 0,0:35:34.56,0:35:35.90,نص عام,,0,0,0,,مزعج للغاية
Dialogue: 0,0:35:36.48,0:35:38.82,نص عام,,0,0,0,,سعيد بقدومك. كسر القشرة بالتعويذة
Dialogue: 0,0:35:39.82,0:35:41.07,نص عام,,0,0,0,,لا أصدق ذلك
Dialogue: 0,0:35:41.15,0:35:45.11,النص العام,,0,0,0,,يمكنني كسر القشرة والحصول على اللحم
Dialogue: 0,0:35:45.20,0:35:47.87,نص عام,,0,0,0,,ولكن بدلاً من السلطعون أريد تجربته عليك
Dialogue: 0,0:35:47.95,0:35:51.37,general text,,0,0,0,,دان جو، لو كان هذا الراهب كريمًا جدًا حتى يعلمني هذا على الأقل،
Dialogue: 0,0:35:51.45,0:35:53.46,نص عام,,0,0,0,,لن أغادر هكذا
Dialogue: 0,0:35:53.54,0:35:55.21,نص عام,,0,0,0,,ما الفائدة إذا لم تستطع؟
Dialogue: 0,0:35:55.29,0:35:57.21,النص العام,,0,0,0,,أبوك منعك من السحر
Dialogue: 0,0:35:57.29,0:35:58.88,general text,,0,0,0,,إذن عليه أن يساعدني في هذا.
Dialogue: 0,0:35:58.96,0:36:02.46,نص عام,,0,0,0,,هذا ما يفعله المعلمون. إنهم يساعدون الطلاب
Dialogue: 0,0:36:02.55,0:36:05.22,النص العام,,0,0,0,,ليس هناك أحد في ديهو شجاع جدًا،
Dialogue: 0,0:36:05.30,0:36:07.47,النص العام,,0,0,0,,للوقوف ضد والدك
Dialogue: 0,0:36:07.55,0:36:09.14,النص العام,,0,0,0,,لكن هناك من يعيش بلا خوف
Dialogue: 0,0:36:09.22,0:36:10.43,نص عام,,0,0,0,,على سبيل المثال،
Dialogue: 0,0:36:11.39,0:36:13.31,نص عام,,0,0,0,,ذلك المحارب ناك سو
Dialogue: 0,0:36:17.69,0:36:18.81,نص عام,,0,0,0,,لا تكن سخيفاً
Dialogue: 0,0:36:18.90,0:36:22.15,general text,,0,0,0,,سمعت أنها قوية جدًا حتى أن القائدة قاسية جدًا
Dialogue: 0,0:36:23.44,0:36:24.78,نص عام,,0,0,0,,لقد ماتت
Dialogue: 0,0:36:25.45,0:36:28.28,general text,,0,0,0,,روحها غادرت جسدها مما يعني أنها يمكن أن تكون على قيد الحياة
Dialogue: 0,0:36:29.78,0:36:31.08,نص عام,,0,0,0,,من أخبرك؟
Dialogue: 0,0:36:31.79,0:36:34.37,نص عام,,0,0,0,,هل تعتقد أنني أتيت إلى هنا لأكل السرطان؟
Dialogue: 0,0:36:34.45,0:36:35.71,نص عام,,0,0,0,,إنه الأسرع هنا
Dialogue: 0,0:36:35.79,0:36:37.96,نص عام,,0,0,0,,تعرف على أخبار بلادنا
Dialogue: 0,0:36:38.50,0:36:39.92,نص عام,,0,0,0,,احصل على اللحم بالفعل
Dialogue: 0,0:36:40.00,0:36:42.80,النص العام,,0,0,0,,استخدم التعويذة لصالحك واحصل على اللحم
Dialogue: 0,0:36:42.88,0:36:46.13,general text,,0,0,0,,ألا تستطيع أن تفعل ذلك بنفسك، هل أنت كسول جدًا؟
Dialogue: 0,0:36:49.64,0:36:52.14,نص عام,,0,0,0,,استحممت وتفتحت للتو
Dialogue: 0,0:36:52.22,0:36:53.39,نص عام,,0,0,0,,دعني أرسمك
Dialogue: 0,0:36:54.60,0:36:57.10,نص عام,,0,0,0,,أوني أنا نفسي
Dialogue: 0,0:36:57.19,0:36:59.90,نص عام,,0,0,0,,لكن كيف؟ أنت أعمى
Dialogue: 0,0:37:01.19,0:37:03.11,نص عام,,0,0,0,,لم أفعل هذا من قبل،
Dialogue: 0,0:37:03.19,0:37:05.28,نص عام,,0,0,0,,أنا بحاجة للاستعداد
Dialogue: 0,0:37:06.74,0:37:08.82,نص عام,,0,0,0,,أريد أن أكون وحدي لبعض الوقت
Dialogue: 0,0:37:10.78,0:37:13.03,نص عام,,0,0,0,,بالطبع. اخرج عندما تكون مستعدًا
Dialogue: 0,0:37:24.17,0:37:26.42,general text,,0,0,0,,من الأسهل خداع الناس بالتظاهر بأنك أعمى
Dialogue: 0,0:37:27.59,0:37:29.22,النص العام,,0,0,0,,أحتاج إلى المال للهروب
Dialogue: 0,0:37:31.76,0:37:33.22,النص العام,,0,0,0,,هل هذا ذهب حقيقي؟
Dialogue: 0,0:37:34.76,0:37:36.27,نص عام,,0,0,0,,هذا اليشم
Dialogue: 0,0:37:37.10,0:37:40.19,general text,,0,0,0,,مو دوك، جرب أحمر الخدود الجديد هذا
Dialogue: 0,0:37:41.81,0:37:42.69,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:37:44.23,0:37:46.57,نص عام,,0,0,0,,أوني، ما هذا؟
Dialogue: 0,0:37:49.45,0:37:51.11,نص عام,,0,0,0,,هل ترى؟
Dialogue: 0,0:38:00.58,0:38:03.00,نص عام,,0,0,0,,امسك مو دوك! القبض على اللص!
Dialogue: 0,0:38:08.80,0:38:10.09,خارج الشاشة,,0,0,0,,مرتفع جدًا
Dialogue: 0,0:38:18.48,0:38:19.35,خط مائل,,0,0,0,,هناك!
Dialogue: 0,0:38:43.12,0:38:44.58,نص عام,,0,0,0,,أين تنظر؟
Dialogue: 0,0:39:02.39,0:39:03.52,نص عام,,0,0,0,,أنت...
Dialogue: 0,0:39:11.44,0:39:12.82,نص عام,,0,0,0,,بدون صوت
Dialogue: 0,0:39:14.66,0:39:17.53,نص عام,,0,0,0,,سمعت أن الفتاة العمياء وصلت اليوم
Dialogue: 0,0:39:18.16,0:39:19.20,نص عام,,0,0,0,,وأنت ترى
Dialogue: 0,0:39:22.21,0:39:23.96,نص عام,,0,0,0,,قالوا لي اسمك
Dialogue: 0,0:39:24.04,0:39:26.08,نص عام,,0,0,0,,على "D" أو شيء من هذا القبيل
Dialogue: 0,0:39:26.17,0:39:27.25,نص عام,,0,0,0,,لا
Dialogue: 0,0:39:28.59,0:39:29.80,نص عام,,0,0,0,,تذكرت
Dialogue: 0,0:39:30.71,0:39:31.59,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:39:33.38,0:39:35.68,نص عام,,0,0,0,,نعم، أنا مو دوك
Dialogue: 0,0:39:36.55,0:39:39.26,نص عام,,0,0,0,,أعرف كيف تبدو،
Dialogue: 0,0:39:39.35,0:39:41.64,نص عام,,0,0,0,,إذا لم تصمت حتى أغادر،
Dialogue: 0,0:39:41.73,0:39:43.52,نص عام,,0,0,0,,سآتي إليك
Dialogue: 0,0:39:47.44,0:39:48.48,نص عام,,0,0,0,,ما المضحك؟
Dialogue: 0,0:39:50.48,0:39:51.82,نص عام,,0,0,0,,عيناك جميلتان
Dialogue: 0,0:39:54.65,0:39:55.66,نص عام,,0,0,0,,كفى
Dialogue: 0,0:39:56.78,0:39:59.78,نص عام,,0,0,0,,نعم آسف. وحدها العيون جميلة
Dialogue: 0,0:40:01.75,0:40:02.87,نص عام,,0,0,0,,معتوه
Dialogue: 0,0:40:09.84,0:40:10.67,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:40:11.38,0:40:12.67,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:40:14.30,0:40:16.89,نص عام,,0,0,0,,أوه هذا شيء صغير
Dialogue: 0,0:40:18.85,0:40:20.01,نص عام,,0,0,0,,فقط
Dialogue: 0,0:40:21.06,0:40:22.02,نص عام,,0,0,0,,خذ هذا
Dialogue: 0,0:40:25.44,0:40:26.52,نص عام,,0,0,0,,مرحبًا...
Dialogue: 0,0:40:45.62,0:40:48.46,نص عام,,0,0,0,,- ماذا هناك؟\N- لا شيء
Dialogue: 0,0:40:53.84,0:40:54.80,نص عام,,0,0,0,,دان جو,
Dialogue: 0,0:40:56.38,0:40:59.26,نص عام,,0,0,0,,سمعت أن ناك سو يستخدم تانسو
Dialogue: 0,0:40:59.34,0:41:01.26,نص عام,,0,0,0,,ماذا تعرف عن تانسو؟
Dialogue: 0,0:41:01.35,0:41:03.85,نص عام,,0,0,0,,كفى. اقرأ في وقت فراغي
Dialogue: 0,0:41:04.35,0:41:05.27,نقوش,,0,0,0,,تانسو
Dialogue: 0,0:41:05.98,0:41:07.69,نص عام,,0,0,0,,كما ترى يا تانسو
Dialogue: 0,0:41:07.77,0:41:11.11,general text,,0,0,0,,فن استخدام السيف، الذي لا يتقنه إلا أفضل السحرة
Dialogue: 0,0:41:11.19,0:41:13.98,general text,,0,0,0,,تضرب النصل بالطاقة، كما لو كنت تسكب الماء.
Dialogue: 0,0:41:14.07,0:41:16.53,النص العام,,0,0,0,,ضربة واحدة تكفي للقتل
Dialogue: 0,0:41:26.29,0:41:28.62,نص عام,,0,0,0,,لماذا تسأل؟
Dialogue: 0,0:41:29.29,0:41:32.75,general text,,0,0,0,,فقط أتساءل عما إذا كان هذا السلطعون قد قتلني
Dialogue: 0,0:41:32.84,0:41:35.67,نص عام,,0,0,0,,تعال هنا. أعطني إياها وسأحضر لك اللحم
Dialogue: 0,0:41:37.22,0:41:40.34,نص عام,,0,0,0,,المملكة المتحدة، هذه نقطة حيوية
Dialogue: 0,0:41:41.93,0:41:43.18,نص عام,,0,0,0,,قد أموت
Dialogue: 0,0:41:43.26,0:41:45.43,نص عام,,0,0,0,,نعم. كما أنها تهدف إلى هذه النقطة
Dialogue: 0,0:41:48.56,0:41:51.56,general text,,0,0,0,,ولكن لماذا تراجعت إذن؟
Dialogue: 0,0:41:57.19,0:42:00.57,التعليق الصوتي,,0,0,0,,لماذا هذا الجسد الضعيف جائع دائمًا؟
Dialogue: 0,0:42:00.66,0:42:02.91,نص عام,,0,0,0,,إذا لم آكل سأضعف
Dialogue: 0,0:42:03.45,0:42:04.78,نص عام,,0,0,0,,ممنوع الخروج
Dialogue: 0,0:42:15.46,0:42:17.76,خارج الشاشة,,0,0,0,,لا يمكنك القتال الآن، عليك التراجع
Dialogue: 0,0:42:23.51,0:42:25.14,النص العام,,0,0,0,,سحرة جيونجينغاك هنا
Dialogue: 0,0:42:30.56,0:42:32.90,general text,,0,0,0,,سمعت أن القاتل دخل جيونججينجاك في سوسنوفي بور
Dialogue: 0,0:42:32.98,0:42:35.06,general text,,0,0,0,,أي أحمق قد يخاطر بالتسلل إلى جيونجينغاك؟
Dialogue: 0,0:42:35.15,0:42:37.36,مائل,,0,0,0,,هاجمت رأسها ولكن تم القبض عليها
Dialogue: 0,0:42:37.44,0:42:38.90,مائل,,0,0,0,,كانت فتاة صغيرة
Dialogue: 0,0:43:12.19,0:43:14.60,خارج الشاشة,,0,0,0,,كان يجب أن يرى جثتي
Dialogue: 0,0:43:14.69,0:43:16.15,خارج الشاشة,,0,0,0,,على الأرجح أنه لم يتعرف علي
Dialogue: 0,0:43:17.27,0:43:20.90,خارج الشاشة,,0,0,0,,أنا متأكد من أنه لم يتعرف على الصافرة أيضًا
Dialogue: 0,0:43:30.29,0:43:33.00,نص عام,,0,0,0,,لا يوجد أي أثر لناك سو هنا أيضًا
Dialogue: 0,0:43:33.71,0:43:36.50,نص عام,,0,0,0,,أعتقد أنها لم تتمكن من العثور على جسد جديد
Dialogue: 0,0:43:37.59,0:43:40.34,general text,,0,0,0,,حتى لو نجحت، فهي على الأرجح مختبئة،
Dialogue: 0,0:43:40.42,0:43:42.72,نص عام,,0,0,0,,لأنني واجهت مشكلة
Dialogue: 0,0:43:42.80,0:43:45.59,general text,,0,0,0,,المحارب الذي كشف عن نفسه يجب تدميره
Dialogue: 0,0:43:48.05,0:43:50.01,general text,,0,0,0,,سنحتاج إلى سرقة جسدها وسيفها.
Dialogue: 0,0:43:50.10,0:43:52.35,نص عام,,0,0,0,,تخلص من كل آثارها
Dialogue: 0,0:43:52.43,0:43:56.40,general text,,0,0,0,,ماذا لو كانت لا تزال على قيد الحياة؟
Dialogue: 0,0:43:57.98,0:44:00.36,general text,,0,0,0,,أو ستُقتل لأنها غيرت جسدها،
Dialogue: 0,0:44:00.44,0:44:02.69,general text,,0,0,0,,وإلا فإن روحها لن تتماشى مع الجسد الجديد،
Dialogue: 0,0:44:02.78,0:44:04.40,نص عام,,0,0,0,,وسيتحول إلى حجر
Dialogue: 0,0:44:04.99,0:44:07.45,النص العام,,0,0,0,,ربيتها لتكون أفضل مرتزقة
Dialogue: 0,0:44:08.32,0:44:09.58,نص عام,,0,0,0,,يا للأسف
Dialogue: 0,0:44:17.96,0:44:19.54,نص عام,,0,0,0,,إلى متى ستبدو؟
Dialogue: 0,0:44:19.63,0:44:23.59,نص عام,,0,0,0,,عزيزي الشيء الصغير، نحن بحاجة إلى النظر بعناية
Dialogue: 0,0:44:23.67,0:44:26.97,نص عام,,0,0,0,,أنا لا أطلب الكثير. اسم السعر الخاص بك والدفع
Dialogue: 0,0:44:29.35,0:44:30.22,نص عام,,0,0,0,,هنا!
Dialogue: 0,0:44:31.14,0:44:32.72,نص عام,,0,0,0,,- ها هي{\i0}\N- ما هذا؟
Dialogue: 0,0:44:32.81,0:44:33.93,خط مائل,,0,0,0,,خذها بعيدًا
Dialogue: 0,0:44:49.57,0:44:52.08,خلف الكواليس,,0,0,0,,أين أنا؟ هل تم القبض علي؟
Dialogue: 0,0:44:53.29,0:44:54.83,خلف الكواليس,,0,0,0,,إذًا هذه سوسنوفي بور؟
Dialogue: 0,0:44:58.04,0:44:59.42,نص عام,,0,0,0,,هل أنت مستيقظ؟
Dialogue: 0,0:44:59.50,0:45:01.84,نص عام,,0,0,0,,من أنت؟ أين أنا؟
Dialogue: 0,0:45:05.88,0:45:08.80,النص العام,,0,0,0,,هذا هو منزل السيد تشانغ غان، رئيس جيونبوغوان
Dialogue: 0,0:45:09.39,0:45:12.56,خلف الكواليس,,0,0,0,,تشان غان؟ إذن هذا هو منزل عائلة تشان؟
Dialogue: 0,0:45:16.98,0:45:21.44,general text,,0,0,0,,لماذا فكر السيد الشاب في إحضارك إلى هنا؟
Dialogue: 0,0:45:21.52,0:45:24.03,نص عام,,0,0,0,,- أستاذ؟{\i1}\N- نعم
Dialogue: 0,0:45:24.11,0:45:27.90,نص عام,,0,0,0,,سيد. لقد اشترىك تشان ووك من منزل الجيسينج
Dialogue: 0,0:45:27.99,0:45:31.53,نص عام,,0,0,0,,سمعت أنك سرقت تميمة العنبر الخاصة به
Dialogue: 0,0:45:33.53,0:45:34.83,ذكريات بخط مائل,,0,0,0,,فقط خذها
Dialogue: 0,0:45:36.87,0:45:38.08,ذكريات,,0,0,0,,مرحبًا...
Dialogue: 0,0:45:39.00,0:45:40.75,خارج الإطار,,0,0,0,,لماذا أحضرني إلى هنا؟
Dialogue: 0,0:45:40.83,0:45:43.75,general text,,0,0,0,,شعرت بالخوف عندما قال أنه سيحضر فتاة إلى المنزل،
Dialogue: 0,0:45:44.38,0:45:46.17,نص عام,,0,0,0,,لكن عندما رأيتك هدأت
Dialogue: 0,0:45:46.26,0:45:47.92,النص العام,,0,0,0,,لقد ساعدك من باب الشفقة
Dialogue: 0,0:45:48.72,0:45:51.01,نص عام,,0,0,0,,هنا غير ملابسك
Dialogue: 0,0:45:51.09,0:45:52.30,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:45:52.39,0:45:54.39,النص العام,,0,0,0,,- ما هذا؟{\i1}\N- ما رأيك؟
Dialogue: 0,0:45:54.47,0:45:56.27,نص عام,,0,0,0,,ملابس خادمة السيد
Dialogue: 0,0:45:56.35,0:46:00.39,نص عام,,0,0,0,,فضلًا عن ذلك، يجب أن تخاطبني باحترام
Dialogue: 0,0:46:01.98,0:46:03.56,نص عام,,0,0,0,,السيد الشاب ضعيف،
Dialogue: 0,0:46:03.65,0:46:05.53,نص عام,,0,0,0,,يتعب بسرعة
Dialogue: 0,0:46:05.61,0:46:07.86,النص العام,,0,0,0,,افعل كل شيء بسرعة بمجرد أن يطلب منك ذلك
Dialogue: 0,0:46:08.44,0:46:12.07,نص عام,,0,0,0,,وابتسم دائماً مهما كان الأمر.
Dialogue: 0,0:46:13.28,0:46:14.37,نص عام,,0,0,0,,هل ستجيب؟
Dialogue: 0,0:46:15.54,0:46:17.62,نص عام,,0,0,0,,- نعم{\i1}\N- جيد
Dialogue: 0,0:46:18.20,0:46:21.62,general text,,0,0,0,,أراد رؤيتك في أقرب وقت ممكن، بدل ملابسك واذهب إليه
Dialogue: 0,0:46:21.71,0:46:22.79,نص عام,,0,0,0,,لا أستطيع أن أسمع
Dialogue: 0,0:46:23.50,0:46:24.63,نص عام,,0,0,0,,نعم...
Dialogue: 0,0:46:25.80,0:46:26.63,نص عام,,0,0,0,,أوني
Dialogue: 0,0:46:28.34,0:46:30.22,نص عام,,0,0,0,,ناديني يا سيدتي
Dialogue: 0,0:46:34.55,0:46:35.72,خلف الكواليس,,0,0,0,,أيها الرئيس؟
Dialogue: 0,0:46:36.93,0:46:38.60,خارج الإطار,,0,0,0,,لماذا أحضرني إلى هنا؟
Dialogue: 0,0:46:41.81,0:46:43.19,ذكريات,,0,0,0,,لديك عيون جميلة
Dialogue: 0,0:46:44.27,0:46:45.65,نص عام,,0,0,0,,هل وقعت في الحب؟
Dialogue: 0,0:46:47.11,0:46:48.53,نص عام,,0,0,0,,هذا الوجه؟
Dialogue: 0,0:46:50.19,0:46:51.82,النص العام,,0,0,0,,لديه ذوق سيء
Dialogue: 0,0:46:59.50,0:47:01.71,خارج الشاشة,,0,0,0,,على أية حال، سيكون الأمر أكثر أمانًا بالنسبة لي
Dialogue: 0,0:47:01.79,0:47:04.21,خلف الكواليس,,0,0,0,,أعيش هنا حتى أتعافى
Dialogue: 0,0:47:05.67,0:47:09.71,التعليق الصوتي,,0,0,0,,إذا وقع في حبي فسوف يعاملني بشكل جيد
Dialogue: 0,0:47:10.88,0:47:12.47,خلف الكواليس,,0,0,0,,ثم...
Dialogue: 0,0:47:12.55,0:47:16.35,التعليق الصوتي,,0,0,0,,أعتقد أنني سأضطر إلى العيش هنا بشخصية مو دوك.
Dialogue: 0,0:47:17.72,0:47:20.64,نص عام,,0,0,0,,سيدتي، هذا أنا مو دوك
Dialogue: 0,0:47:21.60,0:47:22.73,خط مائل,,0,0,0,,أدخل
Dialogue: 0,0:47:33.78,0:47:34.70,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:47:34.78,0:47:36.82,نص عام,,0,0,0,,شكرًا جزيلاً لك على إنقاذي
Dialogue: 0,0:47:36.91,0:47:39.33,نص عام,,0,0,0,,وجلبت هنا
Dialogue: 0,0:47:40.37,0:47:42.46,النص العام,,0,0,0,,كان هناك شخصان كافيان لإحضارك إلى هنا
Dialogue: 0,0:47:44.17,0:47:46.88,general text,,0,0,0,,- أشعر بخيبة أمل\N- أعلم أن ذلك كان وقاحة مني
Dialogue: 0,0:47:46.96,0:47:51.01,general text,,0,0,0,,أهددك بساق السلطعون، لكن أتمنى أن تنساه
Dialogue: 0,0:47:51.09,0:47:52.59,النص العام,,0,0,0,,أنت أكثر أدبًا الآن
Dialogue: 0,0:47:52.67,0:47:54.72,نص عام,,0,0,0,,سوف أخدمك جيدًا
Dialogue: 0,0:47:55.43,0:47:56.93,نص عام,,0,0,0,,رائع، حاول
Dialogue: 0,0:47:57.01,0:47:59.39,النص العام,,0,0,0,,مو دوك، أحضر لي بعض الماء
Dialogue: 0,0:48:00.14,0:48:01.31,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:48:08.56,0:48:09.40,نص عام,,0,0,0,,السماء المقدسة
Dialogue: 0,0:48:10.02,0:48:11.90,النص العام,,0,0,0,,لا أريد أن أشرب، بل أن أغتسل
Dialogue: 0,0:48:12.65,0:48:14.74,نص عام,,0,0,0,,آه فهمتك يا معلم
Dialogue: 0,0:48:19.28,0:48:21.54,نص عام,,0,0,0,,قررت أنه من الأفضل أن أستحم
Dialogue: 0,0:48:28.25,0:48:29.63,نص عام,,0,0,0,,آه حار
Dialogue: 0,0:48:29.71,0:48:31.67,نص عام,,0,0,0,,حار جدًا
Dialogue: 0,0:48:33.34,0:48:34.76,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:48:41.06,0:48:42.56,نص عام,,0,0,0,,والآن الجو بارد
Dialogue: 0,0:48:43.14,0:48:45.02,نص عام,,0,0,0,,ماء مثلج
Dialogue: 0,0:48:48.02,0:48:49.19,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,0:48:49.27,0:48:51.65,نص عام,,0,0,0,,جليدية. سأمرض إذا اغتسلت بالماء البارد
Dialogue: 0,0:48:53.48,0:48:55.28,نص عام,,0,0,0,,- الجو بارد جداً
Dialogue: 0,0:48:53.48,0:48:55.28,التعليق الصوتي,,0,0,0,,- ما خطبه؟
Dialogue: 0,0:48:55.36,0:48:56.53,التعليق الصوتي,,0,0,0,,ألم يقع في حبي؟
Dialogue: 0,0:48:56.61,0:48:58.07,general text,,0,0,0,,لماذا تم تجميد مو دوك؟
Dialogue: 0,0:48:59.28,0:49:02.49,نص عام,,0,0,0,,نعم يا معلم. سأحضر المزيد من الماء الساخن
Dialogue: 0,0:49:08.33,0:49:09.17,نص عام,,0,0,0,,مالح
Dialogue: 0,0:49:10.04,0:49:11.04,نص عام,,0,0,0,,حلو. حار
Dialogue: 0,0:49:11.13,0:49:12.67,نص عام,,0,0,0,,طويل. أي نوع من الذوق هذا؟
Dialogue: 0,0:49:12.75,0:49:14.01,نص عام,,0,0,0,,لن آكل هذا
Dialogue: 0,0:49:17.47,0:49:19.18,نص عام,,0,0,0,,للماء رائحة غريبة
Dialogue: 0,0:49:19.89,0:49:20.80,نص عام,,0,0,0,,أشم؟
Dialogue: 0,0:49:21.80,0:49:23.10,نص عام,,0,0,0,,أحضر دلوًا آخر
Dialogue: 0,0:49:26.18,0:49:27.10,نص عام,,0,0,0,,أحضر بطانية جديدة
Dialogue: 0,0:49:28.06,0:49:30.35,نص عام,,0,0,0,,اليوم أريد أن أغطي نفسي باللون الأزرق
Dialogue: 0,0:49:52.71,0:49:56.59,general text,,0,0,0,,لا يفعل شيئاً سوى أن يغتسل ثلاث مرات في اليوم.
Dialogue: 0,0:50:00.51,0:50:01.68,نص عام,,0,0,0,,سأقتله
Dialogue: 0,0:50:01.76,0:50:05.39,general text,,0,0,0,,بمجرد أن تعود قوتي سأقتله أولاً
Dialogue: 0,0:50:09.56,0:50:12.36,نص عام,,0,0,0,,يا معلمة لقد أحضرت الماء البارد
Dialogue: 0,0:50:13.06,0:50:15.48,general text,,0,0,0,,- لقد أحضرت...\N- انسى، الماء بارد.
Dialogue: 0,0:50:15.57,0:50:17.03,نص عام,,0,0,0,,إلى درجة الحرارة المطلوبة
Dialogue: 0,0:50:18.49,0:50:19.57,نص عام,,0,0,0,,أحسنت...
Dialogue: 0,0:50:19.65,0:50:22.03,نص عام,,0,0,0,,آه، لا. لقد حاولت عبثًا يا مو دوك
Dialogue: 0,0:50:33.21,0:50:34.63,التعليق الصوتي,,0,0,0,,ليتني أملك القوة...
Dialogue: 0,0:50:35.42,0:50:38.67,خلف الكواليس,,0,0,0,,على الأقل ذرة من القوة السابقة...
Dialogue: 0,0:50:50.81,0:50:52.02,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:50:52.73,0:50:55.98,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:51:13.00,0:51:14.17,خط مائل,,0,0,0,,هل تستمتع؟
Dialogue: 0,0:51:15.58,0:51:16.50,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:51:17.55,0:51:19.17,نص عام,,0,0,0,,لماذا تبتسم؟
Dialogue: 0,0:51:20.17,0:51:21.26,نص عام,,0,0,0,,تمامًا هكذا
Dialogue: 0,0:51:21.34,0:51:22.93,نص عام,,0,0,0,,الماء لطيف
Dialogue: 0,0:51:23.88,0:51:25.18,نص عام,,0,0,0,,أشيائي
Dialogue: 0,0:51:25.26,0:51:26.51,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:51:35.44,0:51:36.27,نص عام,,0,0,0,,ما الأمر؟
Dialogue: 0,0:51:37.98,0:51:39.32,نص عام,,0,0,0,,أشيائك
Dialogue: 0,0:51:41.69,0:51:43.65,نص عام,,0,0,0,,يمكنك الذهاب والراحة
Dialogue: 0,0:51:44.32,0:51:45.57,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:51:57.33,0:52:01.42,general text,,0,0,0,,هذه التميمة ستسمح لي بتدمير الحاجز والدخول إلى سوسنوفي بور
Dialogue: 0,0:52:03.34,0:52:04.97,نص عام,,0,0,0,,ولكن الآن لا أستطيع فعل ذلك،
Dialogue: 0,0:52:05.05,0:52:07.14,نص عام,,0,0,0,,لا قوة لإلقاء التعويذة
Dialogue: 0,0:52:08.76,0:52:10.01,نص عام,,0,0,0,,عليك أن تجد سيفك
Dialogue: 0,0:52:11.56,0:52:14.48,مائل,,0,0,0,,ربما ستعود قوتي إذا وجدته
Dialogue: 0,0:52:17.94,0:52:19.40,نص عام,,0,0,0,,مع هذه التميمة
Dialogue: 0,0:52:20.32,0:52:22.78,نص عام,,0,0,0,,يمكنني الوصول إلى سوسنوفي بور
Dialogue: 0,0:52:26.95,0:52:30.78,نقوش,,0,0,0,,سوسنوفي بور
Dialogue: 0,0:52:31.95,0:52:35.21,general text,,0,0,0,,إلى متى تخطط للاحتفاظ بجثة ناك سو في جيونغجينجاك؟
Dialogue: 0,0:52:35.87,0:52:37.96,نص عام,,0,0,0,,إذا تمكنت من العثور على جسد جديد،
Dialogue: 0,0:52:38.50,0:52:39.59,نص عام,,0,0,0,,ناك سو...
Dialogue: 0,0:52:40.59,0:52:42.00,النص العام,,0,0,0,,سيعود للسيف
Dialogue: 0,0:52:43.76,0:52:47.01,نص عام,,0,0,0,,سوف تأتي إلى هنا من أجل جسدها
Dialogue: 0,0:52:48.34,0:52:50.43,نص عام,,0,0,0,,دعونا نرى كيف سينتهي كل شيء
Dialogue: 0,0:52:57.10,0:53:00.23,النص العام,,0,0,0,,غرفة والدك فارغة دائمًا،
Dialogue: 0,0:53:01.07,0:53:02.69,نص عام,,0,0,0,,لكن الجو هنا ليس مغبرًا أبدًا
Dialogue: 0,0:53:03.78,0:53:05.57,نص عام,,0,0,0,,أتساءل متى سيعود
Dialogue: 0,0:53:09.53,0:53:12.99,خط مائل,,0,0,0,,بدأت صورة والدتك تتلاشى
Dialogue: 0,0:53:13.62,0:53:16.08,مائل,,0,0,0,,نحن بحاجة إلى استدعاء فنان لاستعادة
Dialogue: 0,0:53:38.77,0:53:41.23,ذكريات بخط مائل,,0,0,0,,تعلمت كل الكتب التي طلبت مني قراءتها
Dialogue: 0,0:53:41.81,0:53:43.86,ذكريات بخط مائل,,0,0,0,,علمني الآن كيفية إلقاء التعويذات،
Dialogue: 0,0:53:43.94,0:53:46.03,ذكريات بخط مائل,,0,0,0,,كما يدرسها يوليا ودان جو
Dialogue: 0,0:53:54.62,0:53:57.33,ذكريات,,0,0,0,,هذا السيف لأبيك
Dialogue: 0,0:53:57.41,0:53:58.71,ذكريات,,0,0,0,,خذها
Dialogue: 0,0:54:11.84,0:54:13.93,ذكريات,,0,0,0,,لقد ألقيت عليّ تعويذة،
Dialogue: 0,0:54:14.01,0:54:16.52,ذكريات,,0,0,0,,بسببها لا أستطيع أخذ السيف المسحور
Dialogue: 0,0:54:17.02,0:54:19.27,ذكريات,,0,0,0,,ألا تستطيع حتى أن تلتقط سيف أبيك؟
Dialogue: 0,0:54:19.35,0:54:21.02,ذكريات,,0,0,0,,كيف تريد أن تتعلم التعاويذ؟
Dialogue: 0,0:54:21.10,0:54:23.98,ذكريات,,0,0,0,,لماذا لا تستطيع أن تفتح باب طاقتي حتى أتمكن من التدرب؟
Dialogue: 0,0:54:24.06,0:54:24.98,ذكريات,,0,0,0,,أنا...
Dialogue: 0,0:54:26.19,0:54:27.57,الذكريات,,0,0,0,,لا أستطيع فعل هذا
Dialogue: 0,0:54:28.94,0:54:32.36,ذكريات,,0,0,0,,ثم ابحث لي عن معلم آخر
Dialogue: 0,0:54:33.07,0:54:34.49,ذكريات,,0,0,0,,لا أحد يستطيع فعل هذا
Dialogue: 0,0:54:35.41,0:54:37.87,ذكريات,,0,0,0,,لا أحد في دايهو يستطيع مقاومة والدك
Dialogue: 0,0:54:37.95,0:54:39.87,ذكريات,,0,0,0,,وافتح أبواب طاقتك
Dialogue: 0,0:54:39.96,0:54:41.42,ذكريات,,0,0,0,,إذًا تقصد،
Dialogue: 0,0:54:42.37,0:54:44.25,ذكريات,,0,0,0,,ألن أتمكن أبدًا من إتقان التعويذات؟
Dialogue: 0,0:54:44.34,0:54:45.29,ذكريات,,0,0,0,,هذا هو القدر،
Dialogue: 0,0:54:45.38,0:54:49.55,ذكريات,,0,0,0,,التي أعطاها لك والدك
Dialogue: 0,0:54:50.51,0:54:52.38,ذكريات,,0,0,0,,لماذا؟!
Dialogue: 0,0:54:52.47,0:54:54.39,ذكريات,,0,0,0,,لماذا يتحكم في مصيري؟
Dialogue: 0,0:54:55.64,0:54:58.02,ذكريات,,0,0,0,,رغم ذلك لا أحد يعتبره والدي الحقيقي
Dialogue: 0,0:54:59.56,0:55:01.02,ذكريات,,0,0,0,,سأجد شخصًا ما
Dialogue: 0,0:55:02.10,0:55:06.11,ذكريات,,0,0,0,,المعلم الذي سيكشف عن قوتي ويعلمني السحر
Dialogue: 0,0:55:06.94,0:55:08.73,ذكريات,,0,0,0,,سأجده بنفسي
Dialogue: 0,0:55:10.11,0:55:12.49,ذكريات,,0,0,0,,ثم سأخرج هذا السيف وأقسمه إلى قسمين
Dialogue: 0,0:55:38.72,0:55:41.18,مائل,,0,0,0,,سمعت أن السيد تشان طُرد مرة أخرى
Dialogue: 0,0:55:41.85,0:55:45.06,general text,,0,0,0,,لماذا يقع ابن المعلم العظيم تشان في المشاكل دائمًا؟
Dialogue: 0,0:55:45.15,0:55:46.86,نص عام,,0,0,0,,لأنه ليس ابنه
Dialogue: 0,0:55:46.94,0:55:49.27,general text,,0,0,0,,دو هوا، أجمل امرأة في دايهو،
Dialogue: 0,0:55:49.36,0:55:51.74,general text,,0,0,0,,خونه مع رجل آخر وأنجبا تشان ووك
Dialogue: 0,0:55:52.32,0:55:53.95,خط مائل,,0,0,0,,أشك في صحة هذا الأمر
Dialogue: 0,0:55:54.03,0:55:57.12,italics,,0,0,0,,فلماذا حرم ابنه من القدرة على استخدام السحر
Dialogue: 0,0:55:57.20,0:55:59.12,خط مائل,,0,0,0,,ومحكوم عليه بحياة المتهرب؟
Dialogue: 0,0:56:00.12,0:56:04.16,italics,,0,0,0,,أتساءل عما إذا كان ضعيفًا حقًا بسبب تعويذة والده؟
Dialogue: 0,0:56:13.88,0:56:15.84,خارج الشاشة,,0,0,0,,يجب أن تكون التميمة هنا في مكان ما
Dialogue: 0,0:56:30.15,0:56:31.61,خلف الكواليس,,0,0,0,,أين هو؟
Dialogue: 0,0:56:56.65,0:56:58.48,خارج الشاشة,,0,0,0,,لماذا أنا مختبئ هنا؟
Dialogue: 0,0:56:58.65,0:57:01.11,خارج الشاشة,,0,0,0,,ماذا سيفكر بي؟
Dialogue: 0,0:57:01.65,0:57:03.11,التعليق الصوتي,,0,0,0,,ماذا يجب أن أقول له؟
Dialogue: 0,0:57:08.97,0:57:11.64,نص عام,,0,0,0,,لم أحضرك إلى هنا من أجل هذا
Dialogue: 0,0:57:13.64,0:57:14.48,نص عام,,0,0,0,,ماجستير...
Dialogue: 0,0:57:15.19,0:57:17.77,النص العام,,0,0,0,,ظللت تكرر أنك كنت بارداً،
Dialogue: 0,0:57:17.86,0:57:19.90,نص عام,,0,0,0,,لذلك قررت أن أدفئ سريرك
Dialogue: 0,0:57:19.98,0:57:22.86,general text,,0,0,0,,إذا استلقيت الآن، سوف تشعر بالدفء طوال الليل
Dialogue: 0,0:57:22.94,0:57:24.11,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:57:25.70,0:57:26.86,نص عام,,0,0,0,,جميل منك
Dialogue: 0,0:57:31.29,0:57:33.50,نص عام,,0,0,0,,- تصبح على خير\N- إلى أين أنت ذاهب؟
Dialogue: 0,0:57:35.66,0:57:37.04,النص العام,,0,0,0,,لقد أتيت لتدفئني هذه الليلة
Dialogue: 0,0:57:38.79,0:57:40.09,نص عام,,0,0,0,,افعل هذا,
Dialogue: 0,0:57:40.75,0:57:41.88,نص عام,,0,0,0,,إلى سريري
Dialogue: 0,0:57:43.21,0:57:44.34,نص عام,,0,0,0,,كان دافئاً طوال الليل
Dialogue: 0,0:57:46.43,0:57:47.59,نص عام,,0,0,0,,دفئها
Dialogue: 0,0:57:51.85,0:57:55.02,خلف الكواليس,,0,0,0,,ماذا؟ هل هو حقا معجب بي؟
Dialogue: 0,0:57:55.10,0:57:56.69,خلف الكواليس,,0,0,0,,هل وقعت في فخ حيله؟
Dialogue: 0,0:58:05.07,0:58:05.95,نص عام,,0,0,0,,المضيف,
Dialogue: 0,0:58:06.90,0:58:09.49,النص العام,,0,0,0,,حرارة جسدي ليست كافية لتدفئتك
Dialogue: 0,0:58:09.57,0:58:11.58,مائل,,0,0,0,,منذ طفولتي أشعر بالبرد المستمر،
Dialogue: 0,0:58:11.66,0:58:14.41,نص عام,,0,0,0,,لهذا السبب لدي انخفاض في درجة حرارة الجسم
Dialogue: 0,0:58:21.42,0:58:22.63,نص عام,,0,0,0,,مثل هذا
Dialogue: 0,0:58:36.27,0:58:39.31,نص عام,,0,0,0,,لن أفعل ما تريد مني أن أفعله
Dialogue: 0,0:58:49.15,0:58:51.53,نص عام,,0,0,0,,حرك الموقد أقرب
Dialogue: 0,0:58:55.41,0:58:56.58,نص عام,,0,0,0,,برازير؟
Dialogue: 0,0:58:57.16,0:59:00.21,النص العام,,0,0,0,,أردت فقط أن تضع الموقد بالقرب من السرير
Dialogue: 0,0:59:00.29,0:59:01.38,نص عام,,0,0,0,,وأبقى النار مشتعلة هناك
Dialogue: 0,0:59:05.71,0:59:07.17,نص عام,,0,0,0,,لا تدع الأمر يخرج
Dialogue: 0,0:59:13.80,0:59:14.68,نص عام,,0,0,0,,هنا
Dialogue: 0,0:59:15.26,0:59:17.14,نص عام,,0,0,0,,قريب جدًا
Dialogue: 0,0:59:18.48,0:59:19.94,نص عام,,0,0,0,,سيكون الجو ساخناً
Dialogue: 0,0:59:20.81,0:59:22.81,نص عام,,0,0,0,,نعم بالضبط. حار جدا
Dialogue: 0,0:59:26.78,0:59:28.65,النص العام,,0,0,0,,سأبيعك إذا انطفأت النار
Dialogue: 0,0:59:28.74,0:59:30.36,نص عام,,0,0,0,,ابقِه مستيقظًا طوال الليل
Dialogue: 0,0:59:30.45,0:59:31.57,نص عام,,0,0,0,,نعم
Dialogue: 0,0:59:43.46,0:59:46.80,خط مائل,,0,0,0,,ها هو دان جو
Dialogue: 0,0:59:50.30,0:59:52.51,نص عام,,0,0,0,,ما هذا؟ صافرة
Dialogue: 0,0:59:53.26,0:59:54.09,نص عام,,0,0,0,,نعم
Dialogue: 0,0:59:55.05,0:59:56.72,نص عام,,0,0,0,,أنا متأكد من أنني نجحت.
Dialogue: 0,0:59:56.81,1:00:00.02,نص عام,,0,0,0,,أوه بالضبط. تذكرت. كان لديك طائر
Dialogue: 0,1:00:00.10,1:00:01.94,نص عام,,0,0,0,,هل ستبدأ بواحدة أخرى؟
Dialogue: 0,1:00:03.27,1:00:04.48,نص عام,,0,0,0,,لا، ليس هذا هو الهدف
Dialogue: 0,1:00:04.56,1:00:06.48,نص عام,,0,0,0,,لقد وجدته في مكان غير متوقع
Dialogue: 0,1:00:07.65,1:00:09.90,نص عام,,0,0,0,,أتساءل لماذا امتلكتها؟
Dialogue: 0,1:00:09.99,1:00:11.20,مائل,,0,0,0,,ربما أعطيتها لها بنفسك
Dialogue: 0,1:00:11.78,1:00:13.86,نص عام,,0,0,0,,يمكنك نسيان الأمر فحسب
Dialogue: 0,1:00:13.95,1:00:15.03,نص عام,,0,0,0,,لا
Dialogue: 0,1:00:15.91,1:00:18.20,نص عام,,0,0,0,,أتذكر بوضوح من أهديتها إليه
Dialogue: 0,1:00:35.30,1:00:38.10,نص عام,,0,0,0,,ثم اسألها
Dialogue: 0,1:00:44.94,1:00:47.69,النص العام,,0,0,0,,هل ستراها في هذه الساعة؟
Dialogue: 0,1:00:47.77,1:00:49.19,نص عام,,0,0,0,,أحتاج إلى التحقق من شيء ما
Dialogue: 0,1:02:44.43,1:02:45.89,نص عام,,0,0,0,,من هؤلاء الأشخاص؟
Dialogue: 0,1:03:01.62,1:03:02.87,خط مائل,,0,0,0,,غزو!
Dialogue: 0,1:03:03.58,1:03:05.29,خط مائل,,0,0,0,,نحن نتعرض للهجوم!
Dialogue: 0,1:03:05.37,1:03:06.66,خط مائل,,0,0,0,,مجرمون
Dialogue: 0,1:04:05.14,1:04:06.39,نص عام,,0,0,0,,مغادرة
Dialogue: 0,1:04:37.42,1:04:38.46,نص عام,,0,0,0,,ابتعد عن الطريق!
Dialogue: 0,1:05:19.00,1:05:21.59,نص عام,,0,0,0,,يول، ماذا يحدث؟
Dialogue: 0,1:05:25.18,1:05:26.64,نص عام,,0,0,0,,الفصل الدراسي مشتعل
Dialogue: 0,1:05:34.60,1:05:36.31,نص عام,,0,0,0,,من في جيونجينغاك الآن؟
Dialogue: 0,1:05:36.40,1:05:37.90,نص عام,,0,0,0,,السيد يول ودان جو
Dialogue: 0,1:05:41.11,1:05:42.48,نص عام,,0,0,0,,عمي هل أنت بخير؟
Dialogue: 0,1:05:43.69,1:05:44.90,general text,,0,0,0,,هرب المهاجمون
Dialogue: 0,1:05:47.07,1:05:48.78,نص عام,,0,0,0,,جونجينجاك فارغ
Dialogue: 0,1:05:59.54,1:06:00.96,نص عام,,0,0,0,,- ابحث عنهم\N- نعم
Dialogue: 0,1:06:11.43,1:06:13.06,خلف الكواليس,,0,0,0,,من كانوا؟
Dialogue: 0,1:06:14.06,1:06:15.98,general text,,0,0,0,,هل أرسلهم دان تشو حقًا؟
Dialogue: 0,1:06:19.06,1:06:22.44,ذكريات,,0,0,0,,هذه المرة يجب عليك إحضار روح باك جين، رئيس سوسنوفي بور
Dialogue: 0,1:06:26.24,1:06:27.36,نص عام,,0,0,0,,نعم
Dialogue: 0,1:06:28.45,1:06:30.66,general text,,0,0,0,,لا بد أنه أرسلهم لاستعادة جسدي
Dialogue: 0,1:06:38.54,1:06:39.79,نص عام,,0,0,0,,من هنا؟
Dialogue: 0,1:07:12.99,1:07:13.87,نص عام,,0,0,0,,أيها الرئيس؟
Dialogue: 0,1:07:28.09,1:07:29.55,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,1:07:32.97,1:07:34.26,نص عام,,0,0,0,,بسبب عينيك
Dialogue: 0,1:07:35.43,1:07:36.31,نص عام,,0,0,0,,العين؟
Dialogue: 0,1:07:59.00,1:08:00.62,نص عام,,0,0,0,,فهمت كل شيء في لقائنا الأول
Dialogue: 0,1:08:03.29,1:08:04.71,نص عام,,0,0,0,,أنت أستاذي
Dialogue: 0,1:08:48.46,1:08:51.84,معاينة,,0,0,0,,بدوي، محارب مرتزق، ناك سو
Dialogue: 0,1:08:51.92,1:08:56.14,preview,,0,0,0,,كنت أبحث عن رجل يكسر التعويذة ويصبح سيدي.
Dialogue: 0,1:08:56.22,1:08:57.76,preview,,0,0,0,,أريدك أن تصبح هو.
Dialogue: 0,1:08:57.85,1:08:59.47,معاينة,,0,0,0,,ما هذا الهراء؟
Dialogue: 0,1:09:00.14,1:09:02.93,معاينة,,0,0,0,,يريدون الاستيلاء على ناك سو، إنها في أحد هؤلاء الأشخاص
Dialogue: 0,1:09:03.02,1:09:06.48,معاينة,,0,0,0,,سوف نجد هذا البدوي
Dialogue: 0,1:09:07.19,1:09:08.69,preview,,0,0,0,,إذا قبضوا علي، فتظاهر بأنك لا تعرف شيئًا
Dialogue: 0,1:09:10.48,1:09:12.24,معاينة,,0,0,0,,قف بجانبي
Dialogue: 0,1:09:12.32,1:09:15.86,preview,,0,0,0,,الأشخاص الذين التقيت بهم على طول الطريق أرادوا موتي فقط
Dialogue: 0,1:09:17.16,1:09:21.66,preview,,0,0,0,,أنت أول شخص حاول إنقاذي
Dialogue: 0,1:09:21.75,1:09:24.00,preview,,0,0,0,,إذا التقينا وجهاً لوجه مرة أخرى،
Dialogue: 0,1:09:24.08,1:09:25.17,معاينة,,0,0,0,,سأتركك على قيد الحياة
Dialogue: 0,1:11:04.26,1:11:06.26,العنوان,,0,0,0,,

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
