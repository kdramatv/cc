Dialogue: 0,0:02:47.14,0:02:49.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:49.14,0:02:51.14,الألقاب,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} سانا، مارتيني
Dialogue: 0,0:02:51.14,0:02:53.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، تومو
Dialogue: 0,0:00:57.38,0:01:00.51,ذكريات,,0,0,0,,أمنع أحداً من فتح هذه البوابة
Dialogue: 0,0:01:07.68,0:01:08.68,ذكريات بخط مائل,,0,0,0,,ابقَ حيث أنت!
Dialogue: 0,0:01:11.06,0:01:13.10,ذكريات بخط مائل,,0,0,0,,لا يمكنك المغادرة فحسب
Dialogue: 0,0:01:13.69,0:01:15.40,ذكريات,,0,0,0,,ماذا عن الطفل؟
Dialogue: 0,0:01:15.94,0:01:19.28,ذكريات,,0,0,0,,فكر فيما سيقولونه عن دو هوا وذلك الطفل
Dialogue: 0,0:01:19.82,0:01:21.65,ذكريات,,0,0,0,,سوف يثرثرون أن الابن ليس لك،
Dialogue: 0,0:01:22.53,0:01:24.99,ذكريات,,0,0,0,,أنه غير شرعي
Dialogue: 0,0:01:25.74,0:01:29.45,ذكريات,,0,0,0,,سيحمل لقب تشان، منذ أن أنجبته زوجتي
Dialogue: 0,0:01:30.08,0:01:32.50,ذكريات,,0,0,0,,سأرسل شخصًا خلفه بعد الجنازة
Dialogue: 0,0:01:32.58,0:01:34.04,ذكريات,,0,0,0,,هل ستتركينه؟
Dialogue: 0,0:01:35.42,0:01:36.58,ذكريات,,0,0,0,,إنه صحيح
Dialogue: 0,0:01:37.38,0:01:38.88,ذكريات,,0,0,0,,ليس ابنك؟
Dialogue: 0,0:01:41.30,0:01:43.47,ذكريات,,0,0,0,,صدق ما تريد
Dialogue: 0,0:01:46.26,0:01:48.47,ذكريات بخط مائل,,0,0,0,,إن لم يكن سوى مشاكل،
Dialogue: 0,0:01:48.55,0:01:50.31,ذكريات,,0,0,0,,دعونا نتخلص منه هنا والآن
Dialogue: 0,0:02:00.02,0:02:02.48,ذكريات,,0,0,0,,أرأيت؟ هو ابنك
Dialogue: 0,0:02:02.57,0:02:07.41,ذكريات,,0,0,0,,الابن الذي تريد حمايته حتى على حساب حياتك
Dialogue: 0,0:02:07.99,0:02:09.74,ذكريات,,0,0,0,,أنا فقط أحاول الحفاظ على سلامته
Dialogue: 0,0:02:11.45,0:02:14.79,ذكريات,,0,0,0,,إذا لم تُفتح أبواب طاقته، ويعيش مثل ابني، فسوف ينجو
Dialogue: 0,0:02:15.29,0:02:18.42,ذكريات,,0,0,0,,ولكن إذا قرر أن يجرب حظه،
Dialogue: 0,0:02:20.00,0:02:21.67,ذكريات,,0,0,0,,الموت ينتظره
Dialogue: 0,0:02:23.76,0:02:26.26,ذكريات,,0,0,0,,من هو الأب
Dialogue: 0,0:02:27.72,0:02:28.84,ذكريات,,0,0,0,,طفل؟
Dialogue: 0,0:02:33.39,0:02:35.52,ذكريات,,0,0,0,,والده مات
Dialogue: 0,0:02:39.02,0:02:41.11,ذكريات بخط مائل,,0,0,0,,ولادته لا معنى لها، علاوة على ذلك،
Dialogue: 0,0:02:41.90,0:02:43.94,ذكريات بخط مائل,,0,0,0,,كان ينبغي ألا يولد أصلاً
Dialogue: 0,0:02:49.45,0:02:51.70,النص العام,,0,0,0,,أيها السيد الشاب، هل أنت بخير؟
Dialogue: 0,0:02:52.45,0:02:54.83,نص عام,,0,0,0,,لماذا أطلقت سراحه؟
Dialogue: 0,0:02:54.91,0:02:56.16,نص عام,,0,0,0,,دعها تذهب
Dialogue: 0,0:03:25.07,0:03:27.15,نص عام,,0,0,0,,آسف على التسبب في المتاعب
Dialogue: 0,0:03:27.24,0:03:29.41,مائل,,0,0,0,,لماذا فككت قيودها؟
Dialogue: 0,0:03:32.28,0:03:35.12,النص العام,,0,0,0,,لقد حاولت تسميمك
Dialogue: 0,0:03:35.70,0:03:37.70,نص عام,,0,0,0,,لم تحاول
Dialogue: 0,0:03:38.91,0:03:40.37,نص عام,,0,0,0,,شربت السم بنفسي
Dialogue: 0,0:03:42.96,0:03:46.71,نص عام,,0,0,0,,لأنني لم أتمكن من إلقاء التعويذات
Dialogue: 0,0:03:47.46,0:03:50.34,general text,,0,0,0,,خادمتي لم تفعل إلا ما قيل لها. على حساب حياته
Dialogue: 0,0:03:51.64,0:03:53.43,نص عام,,0,0,0,,أمرتها
Dialogue: 0,0:04:01.98,0:04:05.02,general text,,0,0,0,,- تشان ووك، كيف يمكنك ذلك؟\N- انتظر هذا
Dialogue: 0,0:04:05.11,0:04:08.90,النص العام,,0,0,0,,لم يتعاف تمامًا بعد
Dialogue: 0,0:04:08.99,0:04:12.49,general text,,0,0,0,,عاقبه كما تريد ولكن بعد أن يتعافى
Dialogue: 0,0:04:12.57,0:04:14.37,نص عام,,0,0,0,,المملكة المتحدة كادت أن تموت
Dialogue: 0,0:04:14.45,0:04:16.70,نص عام,,0,0,0,,لا داعي لتوبيخه
Dialogue: 0,0:04:16.79,0:04:18.45,خط مائل,,0,0,0,,إنه شاحب تمامًا
Dialogue: 0,0:04:20.46,0:04:21.92,نص عام,,0,0,0,,خذه إلى المنزل إلى اللقاء
Dialogue: 0,0:04:22.00,0:04:24.13,نص عام,,0,0,0,,سيدي، دعنا نذهب
Dialogue: 0,0:04:24.21,0:04:26.00,النص العام,,0,0,0,,اذهب إلى سيجوكون، ستُشفى هناك
Dialogue: 0,0:04:26.09,0:04:27.63,نص عام,,0,0,0,,يحتاج مو دوك للذهاب إلى هناك أيضًا
Dialogue: 0,0:04:28.21,0:04:29.80,نص عام,,0,0,0,,الآن ليس الوقت المناسب...
Dialogue: 0,0:04:29.88,0:04:31.80,نص عام,,0,0,0,,مو دوك يحتاج أيضًا إلى العلاج
Dialogue: 0,0:04:31.88,0:04:33.47,نص عام,,0,0,0,,وإلا فلن أذهب
الحوار: 0,0:04:33.55,0:04:34.76,نص عام,,0,0,0,,سيد!
Dialogue: 0,0:04:34.85,0:04:36.93,خط مائل,,0,0,0,,حسنًا، عظيم! يموت بعد ذلك
Dialogue: 0,0:04:37.01,0:04:39.89,general text,,0,0,0,,- احبسهم مرة أخرى!\N- يا عم، اهدأ
Dialogue: 0,0:04:39.98,0:04:42.06,general text,,0,0,0,,إذا كانت المملكة المتحدة تقول الحقيقة، فهي غير مذنبة
Dialogue: 0,0:04:42.90,0:04:44.02,النص العام,,0,0,0,,إنها مصابة بجروح خطيرة
Dialogue: 0,0:04:44.69,0:04:46.27,النص العام,,0,0,0,,بدون علاج ستموت
Dialogue: 0,0:04:46.36,0:04:49.61,general text,,0,0,0,,أنا متفاجئ أنها لا تزال على قيد الحياة بعد كل الضرب.
Dialogue: 0,0:04:50.19,0:04:52.91,general text,,0,0,0,,إذا ماتت سأدعك تشيع جنازتها
Dialogue: 0,0:05:10.46,0:05:11.80,نص عام,,0,0,0,,الرجاء المساعدة
Dialogue: 0,0:05:13.38,0:05:16.43,general text,,0,0,0,,مو دوك خاطرت بحياتها بعد طلبي
Dialogue: 0,0:05:16.51,0:05:19.10,general text,,0,0,0,,يجب أخذها إلى سيجوكون، وإلا فلن تنجو
Dialogue: 0,0:05:20.85,0:05:22.14,نص عام,,0,0,0,,ساعدها
Dialogue: 0,0:05:33.15,0:05:34.66,نص عام,,0,0,0,,أبعدوهم عن عيني
Dialogue: 0,0:05:35.45,0:05:37.62,نص عام,,0,0,0,,خذهم إلى سايجوكون
Dialogue: 0,0:05:40.62,0:05:41.54,خط مائل,,0,0,0,,الأوكرانية...
Dialogue: 0,0:05:44.21,0:05:47.21,نص عام,,0,0,0,,سيدي الشاب، اذهب. سأحضر مو دوك
Dialogue: 0,0:05:47.88,0:05:48.71,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:05:49.75,0:05:51.38,النص العام,,0,0,0,,مو دوك، استيقظ
Dialogue: 0,0:06:12.03,0:06:13.53,نص عام,,0,0,0,,- سأحملها\N- لا
Dialogue: 0,0:06:14.99,0:06:16.41,نص عام,,0,0,0,,نفسي
Dialogue: 0,0:06:16.49,0:06:17.95,نص عام,,0,0,0,,لا يمكنك حتى الوقوف على قدميك
Dialogue: 0,0:06:18.82,0:06:21.70,نص عام,,0,0,0,,أستطيع أن أفعل ذلك. إنها خادمتي، سأحملها بنفسي
Dialogue: 0,0:06:21.79,0:06:23.41,نص عام,,0,0,0,,بالكاد تستطيع المشي بنفسك
Dialogue: 0,0:06:23.50,0:06:25.16,نص عام,,0,0,0,,لا يمكنك الوصول إلى هناك
Dialogue: 0,0:06:27.12,0:06:29.17,نص عام,,0,0,0,,هل تعتقد؟ ثم...
Dialogue: 0,0:06:30.34,0:06:32.84,النص العام,,0,0,0,,- ستحملها على ظهرك\N- ماذا؟
Dialogue: 0,0:06:32.92,0:06:34.21,نص عام,,0,0,0,,هيا
Dialogue: 0,0:06:34.84,0:06:36.80,general text,,0,0,0,,- هل تريدني أن أحملها؟\N- نعم
Dialogue: 0,0:06:37.38,0:06:39.09,نص عام,,0,0,0,,لماذا أنا؟
Dialogue: 0,0:06:39.18,0:06:40.68,نص عام,,0,0,0,,- تعال هنا\N- السيد الشاب
Dialogue: 0,0:06:41.18,0:06:43.35,نص عام,,0,0,0,,لا. انتظر. الجنة...
Dialogue: 0,0:06:43.93,0:06:45.06,نص عام,,0,0,0,,السماء المقدسة
Dialogue: 0,0:06:45.14,0:06:48.40,نص عام,,0,0,0,,مرحبًا يول. استمع...
Dialogue: 0,0:06:48.48,0:06:50.06,نص عام,,0,0,0,,احملني بدلاً من مو دوك
Dialogue: 0,0:06:52.19,0:06:54.74,نص عام,,0,0,0,,لا قوة على الإطلاق. خذني إلى سيجوكون
Dialogue: 0,0:06:56.49,0:06:57.99,نص عام,,0,0,0,,هل تريدني أن أحمله؟
Dialogue: 0,0:06:59.74,0:07:02.28,نص عام,,0,0,0,,- لا\N- حسنًا، شكرًا
Dialogue: 0,0:07:02.37,0:07:04.12,نص عام,,0,0,0,,الخادم كيم، كن حذرًا!
Dialogue: 0,0:07:04.20,0:07:05.75,نص عام,,0,0,0,,- كن حذراً معها\N- حسناً
Dialogue: 0,0:07:05.83,0:07:06.71,نص عام,,0,0,0,,- حسنًا...\N- ماذا...
Dialogue: 0,0:07:07.46,0:07:08.79,نص عام,,0,0,0,,الحذر
Dialogue: 0,0:07:12.09,0:07:13.63,نص عام,,0,0,0,,في النهاية، المملكة المتحدة
Dialogue: 0,0:07:15.09,0:07:17.63,نص عام,,0,0,0,,فتح أبواب الطاقة
Dialogue: 0,0:07:18.84,0:07:19.93,نص عام,,0,0,0,,نعم
Dialogue: 0,0:07:21.26,0:07:25.85,general text,,0,0,0,,لقد خاطر بحياته. لم أستطع الجلوس والمشاهدة فحسب
Dialogue: 0,0:07:26.64,0:07:29.44,نص عام,,0,0,0,,أعتقد أنه فهم،
Dialogue: 0,0:07:29.52,0:07:33.07,نص عام,,0,0,0,,أننا لن نسمح له بقتل نفسه
Dialogue: 0,0:07:33.94,0:07:36.53,مائل,,0,0,0,,من المحتمل أنه شرب السم بنفسه،
Dialogue: 0,0:07:36.61,0:07:38.28,نص عام,,0,0,0,,حتى ننقذه
Dialogue: 0,0:07:42.32,0:07:43.62,نص عام,,0,0,0,,هل كل شيء على ما يرام؟
Dialogue: 0,0:07:45.87,0:07:48.79,نص عام,,0,0,0,,فتح أبواب أوكا وعلاجه
Dialogue: 0,0:07:48.87,0:07:51.63,النص العام,,0,0,0,,ربما يكلفني عشر سنوات من الطاقة
Dialogue: 0,0:07:52.67,0:07:56.80,general text,,0,0,0,,إذًا لم تفتحي أبوابه فحسب، بل منحته الطاقة أيضًا؟
Dialogue: 0,0:07:56.88,0:08:00.43,general text,,0,0,0,,لماذا يجب علي كرجل عجوز أن أخزن طاقتي؟
Dialogue: 0,0:08:01.13,0:08:03.14,نص عام,,0,0,0,,لقد مات مسموماً،
Dialogue: 0,0:08:03.22,0:08:05.85,النص العام,,0,0,0,,فمنحته القوة ليتعافى بسرعة
Dialogue: 0,0:08:05.93,0:08:09.85,general text,,0,0,0,,عندما تتم استعادة المملكة المتحدة، يجب عليك إعادتها
Dialogue: 0,0:08:10.81,0:08:14.15,general text,,0,0,0,,هل هذا ضروري حقًا عندما تكون أبوابه مفتوحة؟
Dialogue: 0,0:08:14.73,0:08:18.40,النص العام,,0,0,0,,لقد تأخر 20 عامًا في تعلم التعويذات
Dialogue: 0,0:08:18.49,0:08:20.90,النص العام,,0,0,0,,حتى لو بدأ الدراسة الآن،
Dialogue: 0,0:08:21.41,0:08:25.74,نص عام,,0,0,0,,تعلم شيئًا مفيدًا في سن الستين
Dialogue: 0,0:08:25.83,0:08:28.66,النص العام,,0,0,0,,هذا هو مصيره
Dialogue: 0,0:08:30.54,0:08:32.04,نص عام,,0,0,0,,علينا أن نتأكد من ذلك
Dialogue: 0,0:08:33.79,0:08:37.09,النص العام,,0,0,0,,إذا كنت تريد ذلك، سأأخذ صلاحياتك
Dialogue: 0,0:08:37.17,0:08:38.30,نص عام,,0,0,0,,أتعرف ماذا؟
Dialogue: 0,0:08:39.17,0:08:41.88,نص عام,,0,0,0,,أنا متعب جدًا. أريد الاسترخاء
Dialogue: 0,0:08:42.63,0:08:44.85,نص عام,,0,0,0,,أحضر لي النبيذ
Dialogue: 0,0:08:48.64,0:08:49.93,نص عام,,0,0,0,,النبيذ؟
Dialogue: 0,0:08:52.06,0:08:53.10,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:08:53.94,0:08:57.48,النص العام,,0,0,0,,من أين يأتي النبيذ في قاعة التدريب؟
Dialogue: 0,0:08:57.57,0:08:58.82,نص عام,,0,0,0,,رأيت
Dialogue: 0,0:08:59.82,0:09:02.11,نص عام,,0,0,0,,رأيت أنك حشرته في نفسك
Dialogue: 0,0:09:02.70,0:09:05.53,نص عام,,0,0,0,,هيا. النبيذ الذي تشربه عندما تكون وحيدا
Dialogue: 0,0:09:06.12,0:09:08.54,النص العام,,0,0,0,,- لست وحدي!\N- هذا صحيح
Dialogue: 0,0:09:10.87,0:09:11.83,خط مائل,,0,0,0,,أنا تمامًا...
Dialogue: 0,0:09:11.91,0:09:13.12,نص عام,,0,0,0,,الرأس يؤلمني
Dialogue: 0,0:09:14.00,0:09:15.04,نص عام,,0,0,0,,هذا لأن...
Dialogue: 0,0:09:15.13,0:09:16.71,نص عام,,0,0,0,,ماذا كان اسمها؟
Dialogue: 0,0:09:16.79,0:09:18.30,نص عام,,0,0,0,,بالضبط. الأرق
Dialogue: 0,0:09:18.92,0:09:20.71,نص عام,,0,0,0,,أعاني من أرق رهيب
Dialogue: 0,0:09:22.97,0:09:24.68,نص عام,,0,0,0,,أشرب الخمر من أجل الأرق
Dialogue: 0,0:09:30.89,0:09:34.48,خط مائل,,0,0,0,,الوحدة تمنعك من النوم
Dialogue: 0,0:09:34.56,0:09:36.86,نص عام,,0,0,0,,كان ينبغي أن تتزوج في شبابك
Dialogue: 0,0:09:37.65,0:09:42.57,النص العام,,0,0,0,,هل نسيت دو هوا بعد؟ وحيدا جدا؟
Dialogue: 0,0:09:54.33,0:09:55.42,نص عام,,0,0,0,,إنه فارغ
Dialogue: 0,0:09:56.29,0:09:57.46,النص العام,,0,0,0,,- ماذا؟\N- لقد شربت كل شيء
Dialogue: 0,0:09:58.88,0:10:01.25,نص عام,,0,0,0,,لا يمكن أن يكون كذلك. ماذا؟
Dialogue: 0,0:10:05.34,0:10:06.51,نص عام,,0,0,0,,ماذا...
Dialogue: 0,0:10:06.59,0:10:09.22,نص عام,,0,0,0,,أعتقد أنك كنت وحيدًا بشكل لا يصدق
Dialogue: 0,0:10:09.30,0:10:12.35,النص العام,,0,0,0,,شربت كأسًا واحدًا فقط عندما لم أستطع النوم
Dialogue: 0,0:10:12.97,0:10:14.56,نص عام,,0,0,0,,كأس واحد فقط في كل مرة...
Dialogue: 0,0:10:21.32,0:10:24.78,النص العام,,0,0,0,,هذا هو النبيذ الذي خبأه عمي في مكانه
Dialogue: 0,0:10:24.86,0:10:26.49,نص عام,,0,0,0,,طعمه لطيف
Dialogue: 0,0:10:27.24,0:10:30.70,general text,,0,0,0,,أخيرًا، أصبح حلم أوكا مدى الحياة حقيقة
Dialogue: 0,0:10:30.78,0:10:32.04,نص عام,,0,0,0,,دعونا نحتفل
Dialogue: 0,0:10:32.54,0:10:34.20,نص عام,,0,0,0,,تلك الفتاة مو دوك...
Dialogue: 0,0:10:34.29,0:10:36.33,general text,,0,0,0,,لقد أحضرها مؤخرًا من منزل الجيسينغ، أليس كذلك؟
Dialogue: 0,0:10:38.13,0:10:41.34,general text,,0,0,0,,خاطرت بحياتها من أجله، على الرغم من أنهما التقيا للتو.
Dialogue: 0,0:10:43.59,0:10:44.63,نص عام,,0,0,0,,هذا غريب
Dialogue: 0,0:10:44.71,0:10:47.55,general text,,0,0,0,,أنقذتها المملكة المتحدة من مصير أن تصبح كيسينغ
Dialogue: 0,0:10:47.63,0:10:50.93,general text,,0,0,0,,لم تكن تريد ذلك كثيرًا لدرجة أنها تظاهرت بالعمى
Dialogue: 0,0:10:51.01,0:10:52.68,نص عام,,0,0,0,,اشرب
Dialogue: 0,0:10:52.76,0:10:53.97,نص عام,,0,0,0,"أعمى"؟
Dialogue: 0,0:10:54.64,0:10:58.10,نص عام,,0,0,0,,نعم. وفقاً لجو وول، كانت عمياء عندما وصلت،
Dialogue: 0,0:10:58.19,0:11:00.06,نص عام,,0,0,0,,وبمجرد أن غادرت هناك، رأيت النور على الفور
Dialogue: 0,0:11:00.15,0:11:02.07,نص عام,,0,0,0,,النبيذ رائع
Dialogue: 0,0:11:03.94,0:11:05.36,النص العام,,0,0,0,,إنها تخدع الناس بسهولة
Dialogue: 0,0:11:06.40,0:11:09.61,general text,,0,0,0,,كذبت أنها كانت عمياء وأن أوكا مسمومة
Dialogue: 0,0:11:10.95,0:11:13.24,النص العام,,0,0,0,,صامت رغم التعذيب
Dialogue: 0,0:11:13.79,0:11:15.45,مائل,,0,0,0,,هناك ما هو أكثر مما تراه العين.
Dialogue: 0,0:11:15.54,0:11:18.08,نص عام,,0,0,0,,ظاهريًا هي فتاة لطيفة وساذجة
Dialogue: 0,0:11:18.17,0:11:20.42,نص عام,,0,0,0,,لكن من الواضح أنها تخفي شيئًا ما
Dialogue: 0,0:11:27.17,0:11:29.80,النص العام,,0,0,0,,- لقد شربته بالكامل\N- ماذا؟ ما الذي تتحدث عنه؟
Dialogue: 0,0:11:31.18,0:11:33.56,نص عام,,0,0,0,,عمك قادم إلى هنا
Dialogue: 0,0:11:33.64,0:11:35.14,نص عام,,0,0,0,,أعتقد أنك محكوم عليك بالهلاك
Dialogue: 0,0:11:36.22,0:11:38.77,النص العام,,0,0,0,,- لم أشرب أي شيء\N- انتظر يول
Dialogue: 0,0:11:38.85,0:11:39.94,نص عام,,0,0,0,,يول!
Dialogue: 0,0:11:42.69,0:11:44.07,نص عام,,0,0,0,,- Mommies\N- Dan Gu
Dialogue: 0,0:11:46.15,0:11:47.49,نص عام,,0,0,0,,لقد انتهيت
Dialogue: 0,0:11:49.40,0:11:50.53,نص عام,,0,0,0,,بارك دان جو
Dialogue: 0,0:11:52.49,0:11:53.62,نص عام,,0,0,0,,هل هذا أنت؟
Dialogue: 0,0:11:54.33,0:11:55.24,نص عام,,0,0,0,,لا
Dialogue: 0,0:12:00.54,0:12:01.92,نص عام,,0,0,0,,تعال هنا
Dialogue: 0,0:12:02.67,0:12:04.54,النص العام,,0,0,0,,- دان غو\N- نعم يا عمي؟
Dialogue: 0,0:12:14.18,0:12:15.56,نص عام,,0,0,0,,هل هي تتنفس؟
Dialogue: 0,0:12:21.60,0:12:22.73,نص عام,,0,0,0,,استيقظت
Dialogue: 0,0:12:23.52,0:12:25.90,general text,,0,0,0,,لم تعد إلى رشدك، ظننت أنك قد تموت
Dialogue: 0,0:12:32.82,0:12:34.07,نص عام,,0,0,0,,هل يؤلمك؟
Dialogue: 0,0:12:35.12,0:12:37.24,نص عام,,0,0,0,,أعتقد أن عظامي تحطمت
Dialogue: 0,0:12:37.83,0:12:39.08,نص عام,,0,0,0,,لم ينكسر شيء
Dialogue: 0,0:12:40.12,0:12:41.71,نص عام,,0,0,0,,- حقاً؟\N- نعم
Dialogue: 0,0:12:42.25,0:12:44.63,النص العام,,0,0,0,,إذن لماذا يؤلمني هذا القدر؟
Dialogue: 0,0:12:44.71,0:12:46.21,نص عام,,0,0,0,,جسد عديم الفائدة
Dialogue: 0,0:12:48.09,0:12:49.21,نص عام,,0,0,0,,يا
Dialogue: 0,0:12:51.30,0:12:53.18,النص العام,,0,0,0,,لماذا قلت أنك تسممني؟
Dialogue: 0,0:12:54.30,0:12:56.64,النص العام,,0,0,0,,إذا تظاهرت بأنك لا تعرف شيئاً،
Dialogue: 0,0:12:56.72,0:12:58.47,نص عام,,0,0,0,,لن تتعذب
Dialogue: 0,0:13:00.02,0:13:02.39,نص عام,,0,0,0,,حتى يصدقوا أنك تحتضر
Dialogue: 0,0:13:02.94,0:13:05.52,general text,,0,0,0,,وإلا ما فتحوا أبوابك
Dialogue: 0,0:13:06.19,0:13:08.02,نص عام,,0,0,0,,دعونا نصنع الترياق
Dialogue: 0,0:13:09.57,0:13:11.61,النص العام,,0,0,0,,لقد خاطرت بحياتك حقًا
Dialogue: 0,0:13:14.86,0:13:17.49,النص العام,,0,0,0,,ظننت أنهم سيقطعون ذراعي أو ساقي
Dialogue: 0,0:13:18.28,0:13:19.95,نص عام,,0,0,0,,لكنني بخير
Dialogue: 0,0:13:20.04,0:13:22.46,النص العام,,0,0,0,,أهل سوسنوفي بور طيبون للغاية
Dialogue: 0,0:13:22.54,0:13:24.33,نص عام,,0,0,0,,إذا كانوا يعذبون الناس بهذه الطريقة...
Dialogue: 0,0:13:27.34,0:13:28.42,نص عام,,0,0,0,,وأنت...
Dialogue: 0,0:13:29.25,0:13:31.72,نص عام,,0,0,0,,تبدو مريضًا إلى حد ما
Dialogue: 0,0:13:32.22,0:13:33.55,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:13:34.80,0:13:37.10,نص عام,,0,0,0,,من الواضح أن أعتني بك
Dialogue: 0,0:13:37.97,0:13:40.18,النص العام,,0,0,0,,جميع الطلاب هنا سحرة
Dialogue: 0,0:13:40.27,0:13:41.85,النص العام,,0,0,0,,لا ينبغي لهم أن يعرفوا عنك
Dialogue: 0,0:13:42.43,0:13:46.02,general text,,0,0,0,,فأغلقت الباب ولم يرى أحد،
Dialogue: 0,0:13:46.10,0:13:49.61,النص العام,,0,0,0,,غيرت ملابسك، ووضعت مرهماً على جراحك
Dialogue: 0,0:13:49.69,0:13:52.19,general text,,0,0,0,,حتى لو قمت بالتدليك عندما فقدت الوعي
Dialogue: 0,0:13:53.45,0:13:55.74,نص عام,,0,0,0,,- حقاً؟\N- نعم
Dialogue: 0,0:14:00.16,0:14:03.96,نص عام,,0,0,0,,يمكنك فقط أن تجعلني أقترب منك كثيرًا
Dialogue: 0,0:14:35.07,0:14:36.32,نص عام,,0,0,0,,طوال حياتي
Dialogue: 0,0:14:37.20,0:14:40.08,نص عام,,0,0,0,,لم يفهم أحد مدى يأسي
Dialogue: 0,0:14:42.95,0:14:44.91,general text,,0,0,0,,ولم يخاطر أحد بحياته من أجلي،
Dialogue: 0,0:14:46.08,0:14:47.42,نص عام,,0,0,0,,إلا أنت
Dialogue: 0,0:15:00.76,0:15:03.93,النص العام,,0,0,0,,منذ أن نجوت كما وعدت،
Dialogue: 0,0:15:04.02,0:15:06.18,نص عام,,0,0,0,,سأعاملك كالسيد
Dialogue: 0,0:15:14.32,0:15:16.74,نص عام,,0,0,0,,لقد قمت بالفعل بتغيير 12 شريحة رئيسية
Dialogue: 0,0:15:17.45,0:15:20.74,general text,,0,0,0,,الجميع يظن أن الأساتذة تخلوا عني، لكني أنا من رحل
Dialogue: 0,0:15:23.12,0:15:25.87,نص عام,,0,0,0,,والآن وجدت المعلم الحقيقي
Dialogue: 0,0:15:26.45,0:15:28.87,نص عام,,0,0,0,,لذا يجب أن أركع
Dialogue: 0,0:15:28.96,0:15:31.21,نص عام,,0,0,0,,وأقسم أنني سأعاملك دائمًا كمعلم
Dialogue: 0,0:15:33.34,0:15:34.71,نص عام,,0,0,0,,بشرط واحد
Dialogue: 0,0:15:37.42,0:15:40.01,نص عام,,0,0,0,,لا تخبر أحداً عن علاقتنا
Dialogue: 0,0:15:41.01,0:15:42.97,النص العام,,0,0,0,,ستبقى سيدي،
Dialogue: 0,0:15:44.26,0:15:46.22,نص عام,,0,0,0,,وأنا خادمك
Dialogue: 0,0:15:49.81,0:15:50.90,نص عام,,0,0,0,,وأيضاً,
Dialogue: 0,0:15:51.65,0:15:55.73,النص العام,,0,0,0,,ستستمر علاقتنا بين المعلم والطالب حتى تصبح الأفضل
Dialogue: 0,0:15:55.82,0:15:58.19,نص عام,,0,0,0,,وساعدني في استعادة طاقتي
Dialogue: 0,0:16:00.28,0:16:01.53,نص عام,,0,0,0,,حتى ذلك الحين
Dialogue: 0,0:16:03.03,0:16:05.99,general text,,0,0,0,,عندما أستعيد قوتي وأصبح ناك سو،
Dialogue: 0,0:16:08.00,0:16:10.54,نص عام,,0,0,0,,لن نكون أستاذاً وطالباً
Dialogue: 0,0:16:11.58,0:16:13.42,نص عام,,0,0,0,,لماذا هذا؟
Dialogue: 0,0:16:16.84,0:16:18.09,نص عام,,0,0,0,,ثم
Dialogue: 0,0:16:19.09,0:16:21.47,النص العام,,0,0,0,,لن تضطر إلى حمايتي بعد الآن،
Dialogue: 0,0:16:22.51,0:16:24.35,نص عام,,0,0,0,,وليس من الضروري أن أكون كذلك
Dialogue: 0,0:16:27.64,0:16:29.06,نص عام,,0,0,0,,لطيف معك
Dialogue: 0,0:16:38.07,0:16:40.70,general text,,0,0,0,,هل تريد أن تتركني عندما ينتهي كل شيء؟
Dialogue: 0,0:16:41.36,0:16:42.41,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:16:45.33,0:16:46.41,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:16:47.04,0:16:49.87,النص العام,,0,0,0,,اتركني عندما لا تعود بحاجة إلي
Dialogue: 0,0:16:49.95,0:16:52.58,النص العام,,0,0,0,,إذن سأحترم قرارك وأطلق سراحك
Dialogue: 0,0:16:59.09,0:17:01.55,نص عام,,0,0,0,,والآن ركع أمام السيد
Dialogue: 0,0:17:08.77,0:17:10.10,نص عام,,0,0,0,,أنا تشان ووك، تلميذك،
Dialogue: 0,0:17:10.81,0:17:13.69,النص العام,,0,0,0,,سأخدم وأحمي سيدي مو دوك
Dialogue: 0,0:18:33.39,0:18:35.52,نص عام,,0,0,0,,لقد عدت بمظهرك
Dialogue: 0,0:18:43.15,0:18:45.40,نص عام,,0,0,0,,لن تصاب بالجنون لبعض الوقت
Dialogue: 0,0:18:45.95,0:18:49.28,نص عام,,0,0,0,,ثم سنلتقي في القصر
Dialogue: 0,0:18:58.46,0:19:01.04,نص عام,,0,0,0,,أطعم النفس المبتلع بالأرواح البشرية،
Dialogue: 0,0:19:01.13,0:19:03.13,نص عام,,0,0,0,,حتى يكون مفيدًا
Dialogue: 0,0:19:05.30,0:19:08.22,general text,,0,0,0,,لقد قتلت الجيسينغ الذي هرب ناك سو إلى جسده
Dialogue: 0,0:19:08.30,0:19:10.76,نص عام,,0,0,0,,نعم. لقد ألقينا بالجثة في بحيرة جيونججيونجدايهو
Dialogue: 0,0:19:10.85,0:19:12.85,نص عام,,0,0,0,,هل تحققت من العلامة الزرقاء؟
Dialogue: 0,0:19:18.23,0:19:19.77,الذكريات,,0,0,0,,لا توجد علامات
Dialogue: 0,0:19:21.15,0:19:22.57,ذكريات,,0,0,0,,هذا ليس ناك سو
Dialogue: 0,0:19:24.53,0:19:26.69,نص عام,,0,0,0,,نعم، محدد
Dialogue: 0,0:19:26.78,0:19:30.24,general text,,0,0,0,,الناك سو الذي كنت أعلم أنه لن يخسر أمامك،
Dialogue: 0,0:19:30.91,0:19:33.62,النص العام,,0,0,0,,لكن يبدو أنه فقد قوته
Dialogue: 0,0:19:34.16,0:19:37.46,النص العام,,0,0,0,,هل يمكن للبدو أن يفقدوا قوتهم؟
Dialogue: 0,0:19:38.58,0:19:39.87,نص عام,,0,0,0,,إذا كانت النفس قوية
Dialogue: 0,0:19:39.96,0:19:44.42,general text,,0,0,0,,يقع في الجسد الخطأ ولا يستطيع الوصول إلى قوته
Dialogue: 0,0:19:44.50,0:19:46.26,نص عام,,0,0,0,,هل رأيت هذا من قبل؟
Dialogue: 0,0:19:55.26,0:19:56.43,ذكريات,,0,0,0,,جلالة الملك,
Dialogue: 0,0:19:56.52,0:19:58.27,ذكريات,,0,0,0,,أنا جين مو، طالب المعلم تشان
Dialogue: 0,0:19:58.35,0:20:00.19,ذكريات,,0,0,0,,سمعت أنك سألتني
Dialogue: 0,0:20:10.57,0:20:11.57,ذكريات,,0,0,0,,جين مو
Dialogue: 0,0:20:12.49,0:20:13.57,ذكريات,,0,0,0,,نعم
Dialogue: 0,0:20:13.66,0:20:16.79,ذكريات,,0,0,0,,أنا لست ملكًا. هذا أنا، تشانغ جانج
Dialogue: 0,0:20:17.50,0:20:20.29,ذكريات,,0,0,0,,روح الملك الآن في جسدي
Dialogue: 0,0:20:30.38,0:20:33.01,ذكريات,,0,0,0,,هل هذه أنت يا معلمة؟
Dialogue: 0,0:20:33.09,0:20:36.56,ذكريات,,0,0,0,,نعم، أنا والملك تبادلنا الأجساد
Dialogue: 0,0:20:37.18,0:20:39.02,ذكريات,,0,0,0,,أين جلالته إذن؟
Dialogue: 0,0:20:39.10,0:20:40.89,ذكريات,,0,0,0,,روحه في جسدي
Dialogue: 0,0:20:41.48,0:20:43.56,ذكريات,,0,0,0,,يجب أن أستعيد جسدي
Dialogue: 0,0:20:44.15,0:20:46.65,ذكريات,,0,0,0,,لكنني لا أستطيع استخدام قوتي
Dialogue: 0,0:20:46.73,0:20:49.49,ذكريات,,0,0,0,,أحتاج لمساعدتك
Dialogue: 0,0:20:51.20,0:20:52.28,ذكريات,,0,0,0,,ماستر
Dialogue: 0,0:20:52.82,0:20:55.74,ذكريات,,0,0,0,,لا أعرف كيف تعمل كيمياء الروح
Dialogue: 0,0:20:56.58,0:21:00.58,الذكريات,,0,0,0,,اذهب إلى القاعة السرية لجيونبوغوان وأعد عاكس الروح
Dialogue: 0,0:21:01.08,0:21:04.21,ذكريات,,0,0,0,,سأعلمك كيمياء النفوس
Dialogue: 0,0:21:06.92,0:21:10.01,خارج الشاشة,,0,0,0,,لم يستطع استعادة قوته بسبب ضعف جسده،
Dialogue: 0,0:21:10.09,0:21:12.09,خلف الكواليس,,0,0,0,,لذلك حصلت على فرصة
Dialogue: 0,0:21:13.55,0:21:15.05,خلف الكواليس,,0,0,0,,أنا محظوظ
Dialogue: 0,0:21:17.47,0:21:19.47,نص عام,,0,0,0,,احرق كل هذه الجثث
Dialogue: 0,0:21:38.28,0:21:43.12,general text,,0,0,0,,فتش منزل كيسينغ الذي كانت تعمل فيه المرأة المقتولة
Dialogue: 0,0:21:43.71,0:21:46.13,نص عام,,0,0,0,,البحث عن صاحب تميمة الروح
Dialogue: 0,0:21:47.21,0:21:48.71,نص عام,,0,0,0,,الشيء الرئيسي غير ملحوظ
Dialogue: 0,0:21:49.34,0:21:50.38,نص عام,,0,0,0,,نعم
Dialogue: 0,0:22:05.14,0:22:06.48,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:22:08.56,0:22:09.57,نص عام,,0,0,0,,بارد
Dialogue: 0,0:22:10.27,0:22:12.24,النص العام,,0,0,0,,الماء متجمد تمامًا
Dialogue: 0,0:22:12.32,0:22:15.07,نص عام,,0,0,0,,بالطبع الجو بارد. لماذا تجلس هناك؟
Dialogue: 0,0:22:17.57,0:22:20.08,نص عام,,0,0,0,,لأول مرة أشعر بهذا البرد
Dialogue: 0,0:22:20.74,0:22:23.91,general text,,0,0,0,,كنت أفقد الوعي لأن بوابة الطاقة كانت مغلقة
Dialogue: 0,0:22:24.00,0:22:26.21,general text,,0,0,0,,والآن، على الرغم من أنني أرتجف، إلا أنني أستطيع الوقوف
Dialogue: 0,0:22:26.29,0:22:28.96,النص العام,,0,0,0,,فإن أبوابي مفتوحة بالفعل
Dialogue: 0,0:22:29.04,0:22:31.46,general text,,0,0,0,,إذا أتقنت التعويذات، فلن يكون الجو باردًا حتى على الجليد
Dialogue: 0,0:22:31.55,0:22:33.01,نص عام,,0,0,0,,والنار لن تحرق
Dialogue: 0,0:22:33.71,0:22:35.97,general text,,0,0,0,,كيف كنت قبل أن تغير جسمك؟
Dialogue: 0,0:22:36.05,0:22:38.47,نص عام,,0,0,0,,كان هناك الكثير من الشائعات عنك
Dialogue: 0,0:22:39.26,0:22:40.56,نص عام,,0,0,0,,لكنني لم أرك قط
Dialogue: 0,0:22:40.64,0:22:42.93,نص عام,,0,0,0,,سمعت أنك قوي
Dialogue: 0,0:22:44.35,0:22:48.73,نص عام,,0,0,0,,ليست قوية فحسب، بل قوية جدًا
Dialogue: 0,0:22:49.40,0:22:51.02,نص عام,,0,0,0,"جداً"؟ أرى
Dialogue: 0,0:22:51.11,0:22:54.65,general text,,0,0,0,,لكي تصبح أفضل ساحر، عليك أن تمر بعدة مراحل
Dialogue: 0,0:22:56.74,0:22:59.32,general text,,0,0,0,,أولاً إلى شيبسو، القدرة على استخدام الطاقة المائية
Dialogue: 0,0:23:05.16,0:23:08.17,general text,,0,0,0,,الخطوة الثانية - ريوسو، القدرة على التحكم في طاقة تدفق المياه
Dialogue: 0,0:23:09.75,0:23:11.71,النص العام,,0,0,0,,ثم تشيسو - التحكم في الطاقة المائية
Dialogue: 0,0:23:14.09,0:23:15.21,نص عام,,0,0,0,,في الجو
Dialogue: 0,0:23:15.92,0:23:19.39,النص العام,,0,0,0,,لقد أتقنت المراحل الثلاث
Dialogue: 0,0:23:19.47,0:23:22.14,general text,,0,0,0,,قليل من الناس في ديهو قادرون على هذا
Dialogue: 0,0:23:22.72,0:23:25.93,نص عام,,0,0,0,,سيدتي، أنت ترقى إلى مستوى اسمك
Dialogue: 0,0:23:26.68,0:23:27.73,نص عام,,0,0,0,,نعم
Dialogue: 0,0:23:28.52,0:23:30.77,النص العام,,0,0,0,,تحركت بصمت كالظل،
Dialogue: 0,0:23:31.48,0:23:35.44,general text,,0,0,0,,وسقطت رؤوس أعدائي على الأرض أثناء مروري
Dialogue: 0,0:23:36.15,0:23:37.70,نص عام,,0,0,0,,كنت ناك سو،
Dialogue: 0,0:23:38.95,0:23:40.53,نص عام,,0,0,0,,محارب الظل
Dialogue: 0,0:23:53.42,0:23:55.42,النص العام,,0,0,0,,مشيت على الماء كأني أطير
Dialogue: 0,0:23:56.38,0:23:58.72,نص عام,,0,0,0,,أين أذهب - ارتفعت الريح
Dialogue: 0,0:24:16.32,0:24:19.86,نص عام,,0,0,0,,وسأفعل هذا - كانت السماء تمطر
Dialogue: 0,0:24:23.74,0:24:27.45,general text,,0,0,0,,أنا ناك سو، أفضل ساحر في العالم،
Dialogue: 0,0:24:28.04,0:24:31.04,نص عام,,0,0,0,,يمكن أن يتسبب في تساقط الثلوج والمطر
Dialogue: 0,0:24:35.09,0:24:36.42,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:24:38.59,0:24:40.05,نص عام,,0,0,0,,فقط بضع حركات،
Dialogue: 0,0:24:40.88,0:24:43.93,النص العام,,0,0,0,,ورئتي جاهزة للانفجار
Dialogue: 0,0:24:48.81,0:24:49.73,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:24:49.81,0:24:51.89,نص عام,,0,0,0,,رجلي متشنجة!
Dialogue: 0,0:24:51.98,0:24:52.94,نص عام,,0,0,0,,تشنج؟
Dialogue: 0,0:24:53.02,0:24:56.23,general text,,0,0,0,,هذه الأرجل قصيرة ونحيفة وضعيفة ولا تتحمل البرد
Dialogue: 0,0:24:57.02,0:24:58.86,نص عام,,0,0,0,,جسد عديم الفائدة
Dialogue: 0,0:25:00.90,0:25:04.74,نص عام,,0,0,0,,كن حذراً. أنت لم تعد ناك سو، محارب الظل.
Dialogue: 0,0:25:04.82,0:25:06.87,النص العام,,0,0,0,,أنت مو دوك خادمتي
Dialogue: 0,0:25:06.95,0:25:10.08,نص عام,,0,0,0,,لا تقفز كما أنت الآن
Dialogue: 0,0:25:10.75,0:25:11.75,نص عام,,0,0,0,,سوف تتأذى
Dialogue: 0,0:25:13.12,0:25:14.67,نص عام,,0,0,0,,أشعر بأنني عديم الأهمية
Dialogue: 0,0:25:18.63,0:25:20.76,نص عام,,0,0,0,,لا تحزن. لديك لي
Dialogue: 0,0:25:20.84,0:25:23.80,نص عام,,0,0,0,,لنبدأ التدريب، أبوابي مفتوحة
Dialogue: 0,0:25:23.88,0:25:26.14,نص عام,,0,0,0,,ولكن أولاً، ارتدي حذائك. الجو بارد
Dialogue: 0,0:25:41.28,0:25:42.65,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:25:43.24,0:25:44.53,نص عام,,0,0,0,,بدون خفة الحركة
Dialogue: 0,0:25:45.91,0:25:46.74,نص عام,,0,0,0,,اختر
Dialogue: 0,0:25:50.16,0:25:51.29,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:25:52.29,0:25:55.71,general text,,0,0,0,,دعونا نرى مدى جودة تلميذي، ثم سأنسى الحزن
Dialogue: 0,0:25:55.79,0:25:56.96,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:26:10.35,0:26:11.64,نص عام,,0,0,0,,لماذا نتغلب؟
Dialogue: 0,0:26:11.72,0:26:13.73,نص عام,,0,0,0,,أنت لا تحمل سيفاً
Dialogue: 0,0:26:14.23,0:26:15.31,نص عام,,0,0,0,,أرني كيف تقاتل
Dialogue: 0,0:26:31.66,0:26:32.66,نص عام,,0,0,0,,إليك واحدة صغيرة...
Dialogue: 0,0:26:33.25,0:26:34.29,نص عام,,0,0,0,,هذا مؤلم!
Dialogue: 0,0:26:46.80,0:26:48.34,النص العام,,0,0,0,,أنت تقاتل بشكل سيء أيضًا
Dialogue: 0,0:26:50.05,0:26:52.56,النص العام,,0,0,0,,أنت أسوأ مما ظننت
Dialogue: 0,0:26:52.64,0:26:55.48,نص عام,,0,0,0,,لم أدرس حقًا!
Dialogue: 0,0:26:59.65,0:27:01.61,نص عام,,0,0,0,,كان لديك 12 معلمًا
Dialogue: 0,0:27:02.23,0:27:04.69,النص العام,,0,0,0,,أنت لم تتعلم كيفية إلقاء التعويذات،
Dialogue: 0,0:27:04.78,0:27:08.16,نص عام,,0,0,0,,لكنه يستطيع إتقان الفنون القتالية
Dialogue: 0,0:27:08.24,0:27:10.41,نص عام,,0,0,0,,لم يكن لدي مزاج لذلك
Dialogue: 0,0:27:10.49,0:27:11.49,نص عام,,0,0,0,,كما تعلمون،
Dialogue: 0,0:27:11.58,0:27:13.83,نص عام,,0,0,0,,أحتاج إلى ضبط النفس لأفعل شيئًا ما
Dialogue: 0,0:27:14.66,0:27:15.83,نص عام,,0,0,0,,أنت مجرد كسول
Dialogue: 0,0:27:16.33,0:27:20.08,نص عام,,0,0,0,,لاحظت أنك لا تفعل أي شيء في المنزل
Dialogue: 0,0:27:20.17,0:27:22.29,general text,,0,0,0,,نعم، حفظت كل شيء عن ظهر قلب. تحقق
Dialogue: 0,0:27:22.38,0:27:24.00,general text,,0,0,0,,هل تعتقد أنني تعرفت عليك؟
Dialogue: 0,0:27:24.09,0:27:26.59,general text,,0,0,0,,أدركت أنك تستخدم أسلوب Tansu
Dialogue: 0,0:27:27.09,0:27:28.34,نص عام,,0,0,0,,ثرثرة فقط
Dialogue: 0,0:27:28.43,0:27:29.93,نص عام,,0,0,0,,أستطيع أن أفعل أكثر من مجرد الدردشة
Dialogue: 0,0:27:32.76,0:27:34.64,نص عام,,0,0,0,,هل رأيته؟
Dialogue: 0,0:27:34.72,0:27:36.35,نص عام,,0,0,0,,أنا سريع التعلم
Dialogue: 0,0:27:36.43,0:27:39.31,النص العام,,0,0,0,,سوف أتقن تشيبسا بسرعة. كم من الوقت تستغرق؟
Dialogue: 0,0:27:39.40,0:27:41.52,النص العام,,0,0,0,,أنا أيضًا أتعلم بسرعة، لكن الأمر استغرق مني خمس سنوات
Dialogue: 0,0:27:41.61,0:27:43.40,نص عام,,0,0,0,,وللآخرين - 20 سنة
Dialogue: 0,0:27:43.48,0:27:44.61,نص عام,,0,0,0,,وأنت...
Dialogue: 0,0:27:46.15,0:27:48.11,النص العام,,0,0,0,,ربما تتقنها بشكل أسرع،
Dialogue: 0,0:27:48.78,0:27:50.16,نص عام,,0,0,0,,بما أنك ابن تشانغ جانج
Dialogue: 0,0:27:51.20,0:27:53.12,النص العام,,0,0,0,,أي جانب هو هنا؟
Dialogue: 0,0:27:53.20,0:27:56.08,general text,,0,0,0,,إنه عبقري أتقن الرقائق في عام واحد
Dialogue: 0,0:27:56.79,0:27:58.08,general text,,0,0,0,,سوف تتقن الرقائق في عام واحد،
Dialogue: 0,0:27:58.16,0:28:00.75,النص العام,,0,0,0,,سوف تهدأ الشائعات بأنك لست ابنه
Dialogue: 0,0:28:00.83,0:28:02.96,نص عام,,0,0,0,,لكن بالطبع هذا غير ممكن
Dialogue: 0,0:28:03.46,0:28:05.63,النص العام,,0,0,0,,إذا استغرق الأمر عامًا، فسوف أتقنه في ستة أشهر
Dialogue: 0,0:28:05.71,0:28:07.59,نص عام,,0,0,0,,لا، خلال ثلاثة أشهر
Dialogue: 0,0:28:08.17,0:28:09.01,نص عام,,0,0,0,,الحديث مرة أخرى
Dialogue: 0,0:28:09.09,0:28:12.01,النص العام,,0,0,0,,أنا عازم فلا تهزمني
Dialogue: 0,0:28:15.93,0:28:18.18,نص عام,,0,0,0,,أخبرتني الخادمة كيم أن أكنس الفناء بأكمله
Dialogue: 0,0:28:18.68,0:28:20.19,نص عام,,0,0,0,,لقد تحسنت،
Dialogue: 0,0:28:20.27,0:28:23.19,النص العام,,0,0,0,,وأنت بخير فساعدني
Dialogue: 0,0:28:26.15,0:28:27.03,نص عام,,0,0,0,,ماذا...
Dialogue: 0,0:28:28.82,0:28:30.11,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:28:30.20,0:28:34.58,general text,,0,0,0,,أنا شخص كسول لا يفعل أي شيء دون التصرف المناسب
Dialogue: 0,0:28:36.45,0:28:37.58,نص عام,,0,0,0,,بالتوفيق
Dialogue: 0,0:28:38.83,0:28:39.91,نص عام,,0,0,0,,أيها اللقيط...
Dialogue: 0,0:28:40.00,0:28:42.08,النص العام,,0,0,0,,- واو...\N- رائع جدًا
Dialogue: 0,0:28:42.17,0:28:44.50,النص العام,,0,0,0,,رجل كسول عديم الفائدة!
Dialogue: 0,0:28:44.59,0:28:47.80,نص عام,,0,0,0,,رائع جدًا، حتى بارد
Dialogue: 0,0:28:52.13,0:28:57.06,خط مائل,,0,0,0,,السيد هو صنع الدواء لأوكا
Dialogue: 0,0:28:57.60,0:28:59.18,نص عام,,0,0,0,,يبدو أنه فعال جدًا
Dialogue: 0,0:28:59.27,0:29:03.06,نص عام,,0,0,0,,خاصة عندما تكون أبوابه مفتوحة
Dialogue: 0,0:29:04.19,0:29:08.40,النص العام,,0,0,0,,الخادم كيم، يبدو أنك مسرور جدًا
Dialogue: 0,0:29:09.94,0:29:13.28,general text,,0,0,0,,هل أنت منزعج جدًا لأن أبوابه مفتوحة؟
Dialogue: 0,0:29:15.12,0:29:18.24,general text,,0,0,0,,لم تفعل شيئًا، حتى وهو يحتضر
Dialogue: 0,0:29:19.33,0:29:23.12,general text,,0,0,0,,لولا السيد هوو، لكان السيد الشاب قد مات
Dialogue: 0,0:29:23.21,0:29:27.04,general text,,0,0,0,,كان عليه أن يجد طريقة لإنقاذه دون أن يفتح البوابة.
Dialogue: 0,0:29:27.13,0:29:28.38,نص عام,,0,0,0,,كم أنت مضر
Dialogue: 0,0:29:29.17,0:29:32.05,general text,,0,0,0,,لقد حافظت دائمًا على مسافة من السيد الشاب
Dialogue: 0,0:29:32.13,0:29:33.13,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:29:34.22,0:29:35.47,نص عام,,0,0,0,,بسبب الشائعات؟
Dialogue: 0,0:29:41.43,0:29:43.39,نص عام,,0,0,0,,أي إشاعات؟
Dialogue: 0,0:29:43.48,0:29:44.73,نص عام,,0,0,0,,لا تتظاهر بأنك لا تعرف
Dialogue: 0,0:29:45.52,0:29:47.52,نص عام,,0,0,0,,تعلم أن هناك شائعات،
Dialogue: 0,0:29:47.61,0:29:50.90,نص عام,,0,0,0,,أنت والد السيد تشان
Dialogue: 0,0:29:52.36,0:29:54.95,نص عام,,0,0,0,,لا تجرؤ على الذكر
Dialogue: 0,0:29:56.74,0:29:58.78,نص عام,,0,0,0,,مثل هذه الشائعات السخيفة!
Dialogue: 0,0:29:59.70,0:30:01.50,نص عام,,0,0,0,,إنها ليست سخيفة إلى هذا الحد
Dialogue: 0,0:30:01.58,0:30:04.71,نص عام,,0,0,0,,لنكن صادقين، كلانا يعلم
Dialogue: 0,0:30:04.79,0:30:07.63,نص عام,,0,0,0,,أنك أحببت السيدة دو هوا قبل زواجها
Dialogue: 0,0:30:08.21,0:30:11.92,النص العام,,0,0,0,,كتبت لها قصائد وأهديتها الهدايا
Dialogue: 0,0:30:12.01,0:30:13.17,نص عام,,0,0,0,,أنا الشاهد الحي
Dialogue: 0,0:30:13.92,0:30:17.22,النص العام,,0,0,0,,يقولون أنك لم تتزوج بعد لأنك لم تنساها
Dialogue: 0,0:30:18.10,0:30:19.56,نص عام,,0,0,0,,ماذا عنك أيتها الخادمة كيم؟
Dialogue: 0,0:30:20.22,0:30:22.93,general text,,0,0,0,,هل مازلت تحب تشانغ جانج؟
Dialogue: 0,0:30:23.52,0:30:27.23,النص العام,,0,0,0,,لهذا السبب لم تتزوجي وتعيشي في منزله؟
Dialogue: 0,0:30:27.86,0:30:28.69,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:30:28.77,0:30:32.74,نص عام,,0,0,0,,أعلم كم أعجبك
Dialogue: 0,0:30:34.07,0:30:36.11,نص عام,,0,0,0,,عندما أخبرك أنه يحب هلام البلوط،
Dialogue: 0,0:30:36.20,0:30:37.95,general text,,0,0,0,,صعدت إلى قمة الجبل مثل السنجاب،
Dialogue: 0,0:30:38.03,0:30:39.95,النص العام,,0,0,0,,- لجمع الجوز\N- السنجاب؟
Dialogue: 0,0:30:40.03,0:30:42.41,نص عام,,0,0,0,,رأيتك تجمع الجوز
Dialogue: 0,0:30:46.54,0:30:47.54,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:30:48.58,0:30:52.84,general text,,0,0,0,,هل تضحك على حقيقة أنني ذهبت لجمع الجوز؟
Dialogue: 0,0:30:55.13,0:30:56.30,نص عام,,0,0,0,,نعم!
Dialogue: 0,0:30:56.93,0:30:59.43,نص عام,,0,0,0,,أعترف أنني ذهبت لجمعهم
Dialogue: 0,0:31:00.01,0:31:03.85,النص العام,,0,0,0,,لا أستطيع التعبير عن مشاعري إلا بإعداد هذا الجيلي
Dialogue: 0,0:31:04.73,0:31:07.06,النص العام,,0,0,0,,يمكنك أن تضحك علي بقدر ما تريد
Dialogue: 0,0:31:14.40,0:31:15.49,نص عام,,0,0,0,,أنا لا أضحك
Dialogue: 0,0:31:17.45,0:31:19.62,نص عام,,0,0,0,,عندما رأيتك تصنع هذا الجيلي،
Dialogue: 0,0:31:21.53,0:31:22.83,نص عام,,0,0,0,,شعرت بالحزن
Dialogue: 0,0:31:25.37,0:31:27.08,خط مائل,,0,0,0,,أعرف ما هو الشعور،
Dialogue: 0,0:31:27.71,0:31:30.79,خط مائل,,0,0,0,,عندما لا تستطيع فعل أي شيء
Dialogue: 0,0:31:31.54,0:31:32.80,نص عام,,0,0,0,,للشخص الذي تحبه
Dialogue: 0,0:31:35.17,0:31:36.30,نص عام,,0,0,0,,أخرى
Dialogue: 0,0:31:36.97,0:31:39.55,النص العام,,0,0,0,,يمكنهم الافتراء علينا خلف ظهورنا
Dialogue: 0,0:31:40.22,0:31:43.64,النص العام,,0,0,0,,لكن دعونا لا نفعل هذا ببعضنا البعض
Dialogue: 0,0:31:46.23,0:31:49.56,النص العام,,0,0,0,,من الواضح أن الحب الذي شعرنا به
Dialogue: 0,0:31:50.81,0:31:53.40,خط مائل,,0,0,0,,عندما كنا صغاراً،
Dialogue: 0,0:31:54.98,0:31:56.90,النص العام,,0,0,0,,في النهاية ترك ندبة في قلوبنا
Dialogue: 0,0:32:01.87,0:32:05.29,النص العام,,0,0,0,,كنت متوتراً بسبب السيد تشان
Dialogue: 0,0:32:06.16,0:32:08.25,نص عام,,0,0,0,,وقال الكثير
Dialogue: 0,0:32:08.33,0:32:09.62,نص عام,,0,0,0,,سامحوني
Dialogue: 0,0:32:11.08,0:32:13.92,نص عام,,0,0,0,,أنا قلقة جدًا على أوكا
Dialogue: 0,0:32:14.00,0:32:17.67,general text,,0,0,0,,أخشى فقط أنه من خلال فتح أبواب الطاقة،
Dialogue: 0,0:32:18.67,0:32:22.30,النص العام,,0,0,0,,يمكننا كسر الحاجز الذي كان يحميه
Dialogue: 0,0:32:22.39,0:32:24.47,خط مائل,,0,0,0,,أشعر بعدم الارتياح حيال هذا الأمر
Dialogue: 0,0:32:25.56,0:32:27.98,general text,,0,0,0,,قد أضطر إلى قمع إرادته
Dialogue: 0,0:32:29.81,0:32:32.44,نص عام,,0,0,0,,وتوقف في المستقبل
Dialogue: 0,0:32:34.90,0:32:37.28,النص العام,,0,0,0,,أطلب منك ألا تحتقرني بسبب هذا
Dialogue: 0,0:32:39.70,0:32:40.99,نص عام,,0,0,0,,دعونا نرى كيف سينتهي كل شيء
Dialogue: 0,0:32:48.87,0:32:51.58,النص العام,,0,0,0,,سيدي، هذا شاي الجينسنغ البري.
Dialogue: 0,0:32:52.17,0:32:53.46,مائل,,0,0,0,,اشربه
Dialogue: 0,0:32:53.54,0:32:54.67,نص عام,,0,0,0,,الجينسنغ البري؟
Dialogue: 0,0:32:55.29,0:32:57.00,نص عام,,0,0,0,,سأتناول مشروبًا عندما أعود. اتركه هنا
Dialogue: 0,0:32:57.09,0:32:58.26,نص عام,,0,0,0,,أنت مرة أخرى
Dialogue: 0,0:32:58.84,0:33:00.42,النص العام,,0,0,0,,هل تريد أن تعطيها لمو ديوك؟
Dialogue: 0,0:33:01.01,0:33:03.64,نص عام,,0,0,0,,الجو بارد في الخارج. إنها تستحق شيئًا دافئًا ولطيفًا
Dialogue: 0,0:33:04.47,0:33:07.01,general text,,0,0,0,,لماذا جعلتها تكنس الفناء في مثل هذا الطقس البارد؟
Dialogue: 0,0:33:08.35,0:33:09.39,نص عام,,0,0,0,,استمع
Dialogue: 0,0:33:10.31,0:33:12.60,نص عام,,0,0,0,,تم علاج هذه الخادمة مجاناً
Dialogue: 0,0:33:12.69,0:33:14.61,general text,,0,0,0,,لذلك طلبت منها أن تفعل شيئاً على الأقل رداً على ذلك.
Dialogue: 0,0:33:14.69,0:33:17.48,نص عام,,0,0,0,,لماذا هي؟ لا يمكنك أن تفعل ذلك بنفسك؟
Dialogue: 0,0:33:18.65,0:33:21.53,النص العام,,0,0,0,,كنت بحاجة لإعداد بعض الدواء لك، وطهي العشاء.
Dialogue: 0,0:33:21.61,0:33:22.74,نص عام,,0,0,0,,واعتني بك
Dialogue: 0,0:33:22.82,0:33:25.28,general text,,0,0,0,,مو دوك سوف يعتني بي. لا داعي للقلق
Dialogue: 0,0:33:28.45,0:33:29.70,خط مائل,,0,0,0,,مسح
Dialogue: 0,0:33:29.79,0:33:32.00,النص العام,,0,0,0,,أنت قلق فقط على مو دوك
Dialogue: 0,0:33:33.50,0:33:35.08,نص عام,,0,0,0,,منذ أن أصبحت عديم الفائدة،
Dialogue: 0,0:33:35.17,0:33:38.92,النص العام,,0,0,0,,سأذهب لكنس الفناء مثل مو دوك
Dialogue: 0,0:33:41.76,0:33:46.39,نص عام,,0,0,0,,أعتقد أنني أثقلت عليك كثيرًا
Dialogue: 0,0:33:46.47,0:33:49.56,general text,,0,0,0,,كم من الوقت قمت بتخمير هذا الجينسنغ البري؟
Dialogue: 0,0:33:49.64,0:33:51.52,نص عام,,0,0,0,,لقد طبختها طوال اليوم
Dialogue: 0,0:33:51.60,0:33:54.14,نص عام,,0,0,0,,هذا ما أتحدث عنه. لم تتمكن حتى من إغلاق عينيك
Dialogue: 0,0:33:54.23,0:33:56.90,النص العام,,0,0,0,,كيف تعتقد أن هذا يجعلني أشعر؟
Dialogue: 0,0:33:58.11,0:33:59.94,نص عام,,0,0,0,,- ليس جيدًا\N- بالضبط
Dialogue: 0,0:34:00.03,0:34:03.45,نص عام,,0,0,0,,أعلم أنك مررت بالكثير بسببي
Dialogue: 0,0:34:04.82,0:34:08.91,نص عام,,0,0,0,,ويبدو متعباً. كان لديك جلد خزفي
Dialogue: 0,0:34:09.58,0:34:11.70,مائل,,0,0,0,,يجب أن تشرب شاي الجينسنغ البري
Dialogue: 0,0:34:11.79,0:34:15.04,general text,,0,0,0,,ربما بعد ذلك يمكنك التوقف عن الوقوع في المشاكل؟
Dialogue: 0,0:34:15.12,0:34:16.96,نص عام,,0,0,0,,لا أعرف ماذا أقول للرأس
Dialogue: 0,0:34:17.54,0:34:18.96,النص العام,,0,0,0,,سأقبل عقوبته
Dialogue: 0,0:34:19.55,0:34:22.88,general text,,0,0,0,,الآن أبوابي مفتوحة، مما يعني أنني سأصبح جزءًا من سوسنوفي بور
Dialogue: 0,0:34:25.63,0:34:29.10,general text,,0,0,0,,هل أنت سعيد جدًا لأن البوابة مفتوحة؟
Dialogue: 0,0:34:29.72,0:34:31.35,نص عام,,0,0,0,,نعم جداً
Dialogue: 0,0:34:32.10,0:34:35.14,general text,,0,0,0,,عندما أدخل سوسنوفي بور وأصبح جوليا ودان جو أفضل،
Dialogue: 0,0:34:35.23,0:34:37.65,general text,,0,0,0,,سوف يندمون على عدم قبولي عاجلاً
Dialogue: 0,0:34:41.65,0:34:43.53,النص العام,,0,0,0,,عذراء كيم، يمكنك أن تأكل هذا الجينسنغ
Dialogue: 0,0:34:44.28,0:34:46.61,النص العام,,0,0,0,,شكرًا لك على الجينسنغ، أنا أقدر ذلك حقًا
Dialogue: 0,0:35:01.84,0:35:04.72,النص العام,,0,0,0,,لا بد أنك ذلك الخادم الشرير
Dialogue: 0,0:35:04.80,0:35:06.76,نص عام,,0,0,0,,ماذا تفعل؟ أعطيناك الدواء
Dialogue: 0,0:35:06.84,0:35:08.01,نص عام,,0,0,0,,قد تصاب بالمرض
Dialogue: 0,0:35:08.09,0:35:10.80,نص عام,,0,0,0,,لقد شفيت مجاناً،
Dialogue: 0,0:35:10.89,0:35:13.43,النص العام,,0,0,0,,فقالوا عليّ أن أعمل لإظهار امتناني
Dialogue: 0,0:35:13.52,0:35:15.56,نص عام,,0,0,0,,البكر كيم امرأة حكيمة
Dialogue: 0,0:35:16.06,0:35:19.15,النص العام,,0,0,0,,كنس الفناء ثم أحضر الأسمدة إلى حديقة الأعشاب
Dialogue: 0,0:35:20.02,0:35:21.02,نص عام,,0,0,0,,نعم
Dialogue: 0,0:35:22.32,0:35:23.57,التعليق الصوتي,,0,0,0,,فقط انتظر، هو يوم
Dialogue: 0,0:35:23.65,0:35:26.03,التعليق الصوتي,,0,0,0,,الآن أنا أكنس حديقتك،
Dialogue: 0,0:35:26.11,0:35:27.99,خارج الإطار,,0,0,0,,ولكن يومًا ما سأتخلص من سايجوكون
Dialogue: 0,0:35:31.49,0:35:33.54,خط مائل,,0,0,0,,مرحبًا! انتبه إلى المكان الذي تهدف إليه
Dialogue: 0,0:35:33.62,0:35:35.25,general text,,0,0,0,,هل تفعل هذا عن عمد؟
Dialogue: 0,0:35:35.87,0:35:36.75,نص عام,,0,0,0,,لا
Dialogue: 0,0:35:36.83,0:35:38.71,نص عام,,0,0,0,,وأعتقد ذلك
Dialogue: 0,0:35:38.79,0:35:39.96,نص عام,,0,0,0,,كيف أجرؤ
Dialogue: 0,0:35:44.00,0:35:45.80,نص عام,,0,0,0,,أنت غريب جدًا
Dialogue: 0,0:35:46.59,0:35:47.84,خط مائل,,0,0,0,,هذه الآذان...
Dialogue: 0,0:35:47.92,0:35:50.80,نص عام,,0,0,0,,لقد رأيتهم من قبل
Dialogue: 0,0:35:53.31,0:35:56.81,general text,,0,0,0,,ألم أعاملك في الماضي؟
Dialogue: 0,0:35:58.39,0:36:01.48,general text,,0,0,0,,من أين أحصل على المال للعلاج في سيجوكون؟
Dialogue: 0,0:36:04.32,0:36:07.49,نص عام,,0,0,0,,تبدو هذه الآذان مألوفة
Dialogue: 0,0:36:12.78,0:36:14.41,نص عام,,0,0,0,,اكتسح جيدًا
Dialogue: 0,0:36:17.58,0:36:18.91,نص عام,,0,0,0,,كاد أن يمزق أذني
Dialogue: 0,0:36:19.75,0:36:21.29,مائل,,0,0,0,,أعلم أنك تتألم، لكن تحلى بالصبر فقط.
Dialogue: 0,0:36:21.38,0:36:24.71,general text,,0,0,0,,إنه غاضب من السيد تشان، فغضب عليك
Dialogue: 0,0:36:24.80,0:36:28.92,general text,,0,0,0,,التنمر على الضعفاء أمر طبيعي، هكذا يعمل العالم
Dialogue: 0,0:36:29.01,0:36:31.05,نص عام,,0,0,0,,سألتزم الصمت فحسب
Dialogue: 0,0:36:31.13,0:36:33.18,نص عام,,0,0,0,,حاول ألا تكرهه
Dialogue: 0,0:36:33.26,0:36:35.14,general text,,0,0,0,,لقد تخلى عن تدفق الطاقة الذي كلفه عشر سنوات،
Dialogue: 0,0:36:35.22,0:36:37.18,نص عام,,0,0,0,,لمساعدة السيد الشاب على التعافي بشكل أسرع
Dialogue: 0,0:36:37.93,0:36:39.81,خط مائل,,0,0,0,,استرح عندما تنتهي
Dialogue: 0,0:36:43.69,0:36:45.73,نص عام,,0,0,0,,تدفق الطاقة لمدة عشر سنوات؟
Dialogue: 0,0:36:57.37,0:36:59.00,نص عام,,0,0,0,,ما الذي استغرقك كل هذا الوقت؟
Dialogue: 0,0:36:59.08,0:37:01.21,النص العام,,0,0,0,,تعالوا، هذا الجينسنغ البري...
Dialogue: 0,0:37:02.12,0:37:03.21,نص عام,,0,0,0,,ما الأمر يا مو دوك؟
Dialogue: 0,0:37:03.29,0:37:05.00,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:37:05.88,0:37:07.05,نص عام,,0,0,0,,اصمت
Dialogue: 0,0:37:07.92,0:37:09.92,نص عام,,0,0,0,,لم أحضرك إلى هنا من أجل هذا
Dialogue: 0,0:37:10.01,0:37:12.26,general text,,0,0,0,,مو دوك، هذا خطأ. أنا تلميذك، توقف عن ذلك
Dialogue: 0,0:37:14.64,0:37:15.85,نص عام,,0,0,0,,تفضل
Dialogue: 0,0:37:20.89,0:37:22.39,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:37:22.48,0:37:23.81,نص عام,,0,0,0,,التحقق من مصدر الطاقة لديك
Dialogue: 0,0:37:25.90,0:37:27.02,نص عام,,0,0,0,,تنفس الصعداء
Dialogue: 0,0:37:43.96,0:37:45.21,نص عام,,0,0,0,,ها هو
Dialogue: 0,0:37:46.96,0:37:48.25,نص عام,,0,0,0,,الحقيقة هي
Dialogue: 0,0:37:49.50,0:37:51.01,نص عام,,0,0,0,,أنت مميز حقًا
Dialogue: 0,0:37:51.67,0:37:52.88,نص عام,,0,0,0,,توقف
Dialogue: 0,0:37:53.51,0:37:55.39,نص عام,,0,0,0,,ماذا بداخلي؟
Dialogue: 0,0:37:55.47,0:37:56.93,نص عام,,0,0,0,,تدفق لا يصدق من الطاقة
Dialogue: 0,0:37:57.60,0:37:59.89,النص العام,,0,0,0,,هو يوم يضخ الطاقة فيك
Dialogue: 0,0:38:01.85,0:38:03.23,نص عام,,0,0,0,,الطاقة؟
Dialogue: 0,0:38:11.57,0:38:14.15,النص العام,,0,0,0,,يبدو أن المملكة المتحدة قد تعافت بالفعل
Dialogue: 0,0:38:14.24,0:38:16.87,نص عام,,0,0,0,,حان الوقت لاستخراج الطاقة التي تضعها فيه.
Dialogue: 0,0:38:16.95,0:38:20.04,النص العام,,0,0,0,,إذا سارت الأمور على نحو خاطئ، فقد يفقد عقله
Dialogue: 0,0:38:20.74,0:38:23.58,general text,,0,0,0,,لن تتمكن المملكة المتحدة من استخدامه
Dialogue: 0,0:38:24.46,0:38:26.63,general text,,0,0,0,,لقد انفتحت للتو أبواب طاقته
Dialogue: 0,0:38:26.71,0:38:29.13,النص العام,,0,0,0,,في الجوهر، لا يستطيع فعل أي شيء
Dialogue: 0,0:38:29.21,0:38:30.59,نص عام,,0,0,0,,أنت تقلق عبثاً
Dialogue: 0,0:38:31.25,0:38:35.72,general text,,0,0,0,,على الأرجح أنه لا يعرف أن هناك شيئًا لا يصدق بداخله
Dialogue: 0,0:38:38.68,0:38:40.76,خط مائل,,0,0,0,,دعونا نسرق طاقة هو يوم
Dialogue: 0,0:38:42.85,0:38:46.31,general text,,0,0,0,,جوهر طاقتك مليء بالطاقة التي أعطاها لك Ho Yeom
Dialogue: 0,0:38:47.27,0:38:49.36,general text,,0,0,0,,الآن أنت قوي بما يكفي لاستخدام Chipsa بسهولة
Dialogue: 0,0:38:49.44,0:38:52.19,النص العام,,0,0,0,,لم يكن لدي أي فكرة عن وجود شيء قيم جدًا بداخلي
Dialogue: 0,0:38:52.28,0:38:55.57,general text,,0,0,0,,يستغرق جمع هذه الطاقة عشر سنوات، وقد حصلت عليها مجاناً
Dialogue: 0,0:38:55.65,0:38:57.86,general text,,0,0,0,,إلى جانب ذلك، هذه هي طاقة Ho Yeom، لا يمكنك أن تطلب أي شيء أفضل.
Dialogue: 0,0:38:58.74,0:39:00.12,نص عام,,0,0,0,,أيها الأحمق المحظوظ
Dialogue: 0,0:39:00.20,0:39:04.45,النص العام,,0,0,0,,كنت أعتقد أن الرجل العجوز يكرهني. أنا مندهش أنه أعطاها لي
Dialogue: 0,0:39:04.54,0:39:07.54,general text,,0,0,0,,أعطاك إياها لتساعدك على التعافي
Dialogue: 0,0:39:07.62,0:39:08.88,النص العام,,0,0,0,,سوف يأخذها قريباً
Dialogue: 0,0:39:08.96,0:39:12.34,النص العام,,0,0,0,,لا يستطيع أن يفعل ذلك. ما في بطني هو لي
Dialogue: 0,0:39:12.42,0:39:14.51,general text,,0,0,0,,إذا لم تكن لديك القوة للسيطرة عليها،
Dialogue: 0,0:39:14.59,0:39:17.47,general text,,0,0,0,,قوتك لن تزول وسيأخذها منك.
Dialogue: 0,0:39:17.55,0:39:20.18,general text,,0,0,0,,يجب أن أتعلم التحكم في الطاقة حتى أحتفظ بها لنفسي.
Dialogue: 0,0:39:20.26,0:39:23.27,general text,,0,0,0,,لذا يجب أن أتنفس كمصدر للطاقة.
Dialogue: 0,0:39:24.06,0:39:27.10,general text,,0,0,0,,أعتقد أن هؤلاء المعلمين الـ12 علموك شيئًا ما على الأقل
Dialogue: 0,0:39:28.19,0:39:29.27,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:39:30.56,0:39:33.57,مائل,,0,0,0,,يتم التحكم في الطاقة من القلب عن طريق التنفس،
Dialogue: 0,0:39:33.65,0:39:35.86,مائل,,0,0,0,,لكن كل السحرة يتنفسون بشكل مختلف
Dialogue: 0,0:39:35.94,0:39:39.61,مائل,,0,0,0,,الجميع يستنشق ويزفر كميات مختلفة من الهواء
Dialogue: 0,0:39:40.74,0:39:44.49,general text,,0,0,0,,هذه هي طاقة Ho Yeom، لذا عليك التحكم بها من خلال تنفسه.
Dialogue: 0,0:39:45.41,0:39:47.37,نص عام,,0,0,0,,أشك أنه سيعلمني
Dialogue: 0,0:39:47.46,0:39:50.58,النص العام,,0,0,0,,ربما ينبغي علينا تجربة كل شيء؟ إنه مجرد تنفس
Dialogue: 0,0:39:51.33,0:39:54.71,general text,,0,0,0,,إذا استخدمت أنفاس شخص ما، فقد تفقد السيطرة وتصاب بالجنون.
Dialogue: 0,0:39:55.46,0:39:59.63,general text,,0,0,0,,سينزف الدم من جميع أجزاء جسدك، وستموت
Dialogue: 0,0:39:59.72,0:40:01.01,نص عام,,0,0,0,,حسنًا، هل نحاول؟
Dialogue: 0,0:40:02.22,0:40:03.05,نص عام,,0,0,0,,لا
Dialogue: 0,0:40:03.81,0:40:06.27,نص عام,,0,0,0,,سوف تبالغ في التطرف
Dialogue: 0,0:40:07.14,0:40:10.31,general text,,0,0,0,,يا معلم، ابتكر طريقة من شأنها أن تبقيني على قيد الحياة وتسمح لي بالتحكم في طاقتي.
Dialogue: 0,0:40:11.56,0:40:15.98,نص عام,,0,0,0,,تقنيات التنفس الأساسية تنتقل من جيل إلى جيل
Dialogue: 0,0:40:16.07,0:40:17.99,خط مائل,,0,0,0,,هو يوم من عائلة سو
Dialogue: 0,0:40:18.07,0:40:21.20,general text,,0,0,0,,لذا فإن أي عضو في عائلة So سيستخدم نفس الأسلوب
Dialogue: 0,0:40:24.53,0:40:25.70,نص عام,,0,0,0,,- إذن يول\N- إذن يول
Dialogue: 0,0:40:34.29,0:40:36.50,نص عام,,0,0,0,,اذهب واسأله. قلت أنك قريب
Dialogue: 0,0:40:36.59,0:40:38.13,نص عام,,0,0,0,,يول حذر
Dialogue: 0,0:40:38.72,0:40:42.01,general text,,0,0,0,,إذا سألته سيفهم كل شيء ويخبر هو يوم
Dialogue: 0,0:40:43.76,0:40:45.18,نص عام,,0,0,0,,عشرة أنفاس فقط...
Dialogue: 0,0:40:45.26,0:40:47.97,نص عام,,0,0,0,,لا، سبعة ستكون كافية
Dialogue: 0,0:40:48.06,0:40:50.89,general text,,0,0,0,,أستطيع أن أفهم بوضع يدي على جوهر طاقته
Dialogue: 0,0:40:51.69,0:40:53.86,general text,,0,0,0,,سوف يكسر ذراعك قبل أن يلتقط أنفاسه
Dialogue: 0,0:40:54.52,0:40:57.28,النص العام,,0,0,0,,أنت على حق، فهو ليس مثلك
Dialogue: 0,0:40:58.61,0:40:59.69,نص عام,,0,0,0,,أنا؟
Dialogue: 0,0:41:00.99,0:41:01.99,نص عام,,0,0,0,,ما خطبي؟
Dialogue: 0,0:41:04.07,0:41:07.45,نص عام,,0,0,0,,ماذا؟ أي نوع من النظرة الازدراء هذه؟
Dialogue: 0,0:41:07.54,0:41:10.87,general text,,0,0,0,,على أية حال، لا أعتقد أنني أستطيع أن أفعل به ما فعلته بك.
Dialogue: 0,0:41:10.96,0:41:12.42,نص عام,,0,0,0,,لا لا مو دوك
Dialogue: 0,0:41:12.50,0:41:14.04,نص عام,,0,0,0,,انظر في عيني
Dialogue: 0,0:41:14.13,0:41:17.46,general text,,0,0,0,,من غير المناسب أن تلمسيه، لكن معي واحدًا أو اثنين؟
Dialogue: 0,0:41:17.55,0:41:20.13,نص عام,,0,0,0,,كالطفل. هل هذا مهم الآن؟
Dialogue: 0,0:41:20.72,0:41:21.80,نص عام,,0,0,0,,طفل؟
Dialogue: 0,0:41:23.26,0:41:24.68,نص عام,,0,0,0,,نعم مهم جداً
Dialogue: 0,0:41:24.76,0:41:26.68,نص عام,,0,0,0,,هل أنت مجنون؟ ماذا تفعل؟
Dialogue: 0,0:41:26.76,0:41:27.60,نص عام,,0,0,0,,أنا بصحة مثالية
Dialogue: 0,0:41:27.68,0:41:30.02,general text,,0,0,0,,- لا، لنفترض أنني مجنون\N- حسنًا، دعني أذهب
Dialogue: 0,0:41:32.89,0:41:33.77,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:41:35.44,0:41:36.36,نص عام,,0,0,0,,مرحباً
Dialogue: 0,0:41:38.36,0:41:41.36,general text,,0,0,0,,لماذا تسخر باستمرار من مو دوك؟
Dialogue: 0,0:41:41.99,0:41:43.03,نص عام,,0,0,0,,لم تتعاف بعد
Dialogue: 0,0:41:43.11,0:41:45.16,نص عام,,0,0,0,,لم أسخر منها
Dialogue: 0,0:41:46.70,0:41:48.20,النص العام,,0,0,0,,- ماذا؟{\i1}\N- هذه خنفساء
Dialogue: 0,0:41:48.28,0:41:49.87,نص عام,,0,0,0,,ظننتك لطيفاً
Dialogue: 0,0:41:51.20,0:41:52.79,مائل,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,0:41:54.67,0:41:57.25,مائل,,0,0,0,,سيدك يطلب منك الكثير، أليس كذلك؟
Dialogue: 0,0:41:57.34,0:42:00.55,general text,,0,0,0,,لا تعتني به فحسب، بل تسليه أيضًا
Dialogue: 0,0:42:00.63,0:42:02.84,مائل,,0,0,0,,يطلب الماء الدافئ، لكن عندما أحضره،
Dialogue: 0,0:42:02.92,0:42:04.34,نص عام,,0,0,0,,يطلب البرد مرة أخرى...
Dialogue: 0,0:42:04.43,0:42:06.30,general text,,0,0,0,,- يا ماذا...{\i1}\N- يقول الطعام مالح،
Dialogue: 0,0:42:06.39,0:42:08.05,نص عام,,0,0,0,,لكنها تشكو بعد ذلك من أنها لطيفة
Dialogue: 0,0:42:08.14,0:42:10.43,general text,,0,0,0,,- أنا؟{\i1}\N- إنه غير ناضج ومتقلب المزاج
Dialogue: 0,0:42:10.52,0:42:12.89,نص عام,,0,0,0,,كسول ولكن مع احترام الذات العالي
Dialogue: 0,0:42:13.77,0:42:15.06,مائل,,0,0,0,,ولكن ماذا يمكنني أن أفعل؟
Dialogue: 0,0:42:15.15,0:42:16.44,نص عام,,0,0,0,,إنه سيدي،
Dialogue: 0,0:42:16.52,0:42:18.48,نص عام,,0,0,0,,لذلك يجب أن أخدمه
Dialogue: 0,0:42:19.15,0:42:21.48,مائل,,0,0,0,,مو دوك، يبدو أنك تمكنت من معرفة الكثير عنه
Dialogue: 0,0:42:21.57,0:42:22.90,نص عام,,0,0,0,,أشعر بالخجل منك
Dialogue: 0,0:42:24.07,0:42:28.12,نص عام,,0,0,0,,بالمناسبة، ماذا تفعل هنا؟ لماذا لست في سيجوكون؟
Dialogue: 0,0:42:31.87,0:42:34.50,نص عام,,0,0,0,,لقد جئنا إلى يول
Dialogue: 0,0:42:34.58,0:42:35.79,النص العام,,0,0,0,,طلب مني مو دوك الحضور
Dialogue: 0,0:42:38.21,0:42:39.21,نص عام,,0,0,0,,يول؟
Dialogue: 0,0:42:40.17,0:42:42.92,general text,,0,0,0,,لماذا لا تقترب منه إذن؟
Dialogue: 0,0:42:44.01,0:42:45.13,نص عام,,0,0,0,,لقد تجسسنا عليه
Dialogue: 0,0:42:45.72,0:42:49.35,general text,,0,0,0,,كان مو دوك محرجًا من الاقتراب منه،
Dialogue: 0,0:42:49.43,0:42:50.56,نص عام,,0,0,0,,فبقيت معها
Dialogue: 0,0:42:53.73,0:42:57.15,النص العام,,0,0,0,,مو دوك، ربما تحب يول
Dialogue: 0,0:42:57.23,0:42:59.23,نص عام,,0,0,0,,- لا...{\i1}\N- دان جو،
Dialogue: 0,0:42:59.31,0:43:01.19,نص عام,,0,0,0,,أنت تفهم كل شيء بسرعة
Dialogue: 0,0:43:01.27,0:43:03.11,نص عام,,0,0,0,,لقد كنت محرجًا بالفعل
Dialogue: 0,0:43:03.19,0:43:06.61,نص عام,,0,0,0,,- يا معلم! كان هناك سوء فهم\N- لا تخجل
Dialogue: 0,0:43:06.70,0:43:09.62,نص عام,,0,0,0,,كثير من الفتيات مثل يول
Dialogue: 0,0:43:09.70,0:43:11.37,خط مائل,,0,0,0,,- مشاعرك طبيعية{\i0}\N- هذا ليس...
Dialogue: 0,0:43:11.45,0:43:13.58,خط مائل,,0,0,0,,سوف أساعد مو ديوك
Dialogue: 0,0:43:13.66,0:43:15.25,نص عام,,0,0,0,,المملكة المتحدة، اذهب إلى حفل الاستقبال
Dialogue: 0,0:43:15.33,0:43:16.54,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:43:17.12,0:43:18.17,نص عام,,0,0,0,,السيد هو يريد رؤيتك
Dialogue: 0,0:43:18.25,0:43:19.25,نص عام,,0,0,0,,سيد هو؟
Dialogue: 0,0:43:47.40,0:43:49.11,نص عام,,0,0,0,,سمعتك تناديني
Dialogue: 0,0:43:51.24,0:43:52.24,نص عام,,0,0,0,,نعم
Dialogue: 0,0:43:52.87,0:43:55.37,مائل,,0,0,0,,صوت سعالك لطيف وواضح
Dialogue: 0,0:43:55.45,0:43:57.21,نص عام,,0,0,0,,أعتقد أنك تشعر بتحسن كبير
Dialogue: 0,0:43:57.29,0:43:59.67,النص العام,,0,0,0,,مازلت أشعر بالدوار والغثيان
Dialogue: 0,0:44:00.33,0:44:01.88,النص العام,,0,0,0,,إلى جانب ذلك، أنا أفقد الوعي
Dialogue: 0,0:44:02.50,0:44:05.00,نص عام,,0,0,0,,ولكن بفضلك أصبحت أفضل
Dialogue: 0,0:44:05.09,0:44:07.17,مائل,,0,0,0,,لقد رأيتك أنت وخادمتك
Dialogue: 0,0:44:07.26,0:44:11.09,نص عام,,0,0,0,,استمتعت بالمشي هذا الصباح
Dialogue: 0,0:44:11.18,0:44:12.68,نص عام,,0,0,0,,أليس هذا غريباً؟
Dialogue: 0,0:44:13.89,0:44:15.81,نص عام,,0,0,0,,هيا، قف هنا
Dialogue: 0,0:44:16.68,0:44:18.31,نص عام,,0,0,0,,أحتاج إلى أخذ شيء منك
Dialogue: 0,0:44:20.31,0:44:21.15,خط مائل,,0,0,0,,لكن أولاً
Dialogue: 0,0:44:21.86,0:44:23.77,نص عام,,0,0,0,,لقد أحضرت لك شيئاً
Dialogue: 0,0:44:25.61,0:44:26.57,نص عام,,0,0,0,,بالنسبة لي؟
Dialogue: 0,0:44:27.24,0:44:28.99,نص عام,,0,0,0,,في الطفولة
Dialogue: 0,0:44:29.07,0:44:31.32,general text,,0,0,0,,لقد سمحت لقطيع من الأغنام بالدخول إلى حديقتك مع الأعشاب الطبية
Dialogue: 0,0:44:31.41,0:44:33.16,النص العام,,0,0,0,,أعلم أنك تكرهني منذ ذلك الحين
Dialogue: 0,0:44:33.24,0:44:36.91,نص عام,,0,0,0,,تلك الأغنام أكلت الأعشاب الطبية
Dialogue: 0,0:44:37.00,0:44:38.91,نص عام,,0,0,0,,ويعيش حتى يومنا هذا
Dialogue: 0,0:44:39.00,0:44:41.29,النص العام,,0,0,0,,رغم هذا أنقذت حياتي
Dialogue: 0,0:44:41.37,0:44:44.29,نص عام,,0,0,0,,وسمح له بالعيش. وأنا ممتن للغاية لك على هذا
Dialogue: 0,0:44:44.38,0:44:46.55,النص العام,,0,0,0,,اعتقدت أنك أحمق حقيقي،
Dialogue: 0,0:44:46.63,0:44:49.72,نص عام,,0,0,0,,ولكن يبدو أنك تعلمت إظهار الامتنان
Dialogue: 0,0:44:49.80,0:44:51.84,نص عام,,0,0,0,,لقد أعددت لك شيئاً
Dialogue: 0,0:44:52.43,0:44:53.47,نص عام,,0,0,0,,عذراء كيم
Dialogue: 0,0:45:15.66,0:45:19.25,general text,,0,0,0,,هذا النبيذ مصنوع من المياه الذائبة من جزيرة البراكين في جنوب ديهو.
Dialogue: 0,0:45:19.33,0:45:22.54,النص العام,,0,0,0,,أفضل نبيذ داكن في إقليم ديهو
Dialogue: 0,0:45:24.13,0:45:26.34,general text,,0,0,0,,قال السيد إنه يريد أن يشكرك،
Dialogue: 0,0:45:26.42,0:45:29.88,نص عام,,0,0,0,,لذلك كان علي أن أبذل الكثير من الجهد للحصول عليه
Dialogue: 0,0:45:34.59,0:45:36.18,نص عام,,0,0,0,,هذه أطعمة نادرة
Dialogue: 0,0:45:40.56,0:45:42.39,نص عام,,0,0,0,,هل هناك زجاجة واحدة فقط؟
Dialogue: 0,0:45:56.57,0:46:00.29,نص عام,,0,0,0,,بالتأكيد أنت تعرف الكثير عن الامتنان!
Dialogue: 0,0:46:01.62,0:46:04.87,نص عام,,0,0,0,,الخادم كيم، لقد أحسنت تربيته
Dialogue: 0,0:46:04.96,0:46:06.42,خط مائل,,0,0,0,,شكرًا لك
Dialogue: 0,0:46:06.96,0:46:08.42,نص عام,,0,0,0,,أحضره هنا بسرعة أكبر
Dialogue: 0,0:46:09.13,0:46:10.55,خط مائل,,0,0,0,,يا لها من فرحة
Dialogue: 0,0:46:14.22,0:46:16.26,نص عام,,0,0,0,,ثلاث زجاجات؟
Dialogue: 0,0:46:21.68,0:46:22.77,نص عام,,0,0,0,,الأم
Dialogue: 0,0:46:23.48,0:46:25.73,نص عام,,0,0,0,,فتحت أبواب الطاقة في أوكا
Dialogue: 0,0:46:26.56,0:46:30.94,general text,,0,0,0,,حتى هذه اللحظة، لم نتمكن من فعل أي شيء بسبب أمر غوانغجو
Dialogue: 0,0:46:32.07,0:46:35.66,general text,,0,0,0,,هل هذا يعني أنه يمكننا الآن قبوله في العائلة؟
Dialogue: 0,0:46:35.74,0:46:39.33,general text,,0,0,0,,هذا الرجل فسخ خطوبته بعد استغلالك.
Dialogue: 0,0:46:40.24,0:46:41.66,النص العام,,0,0,0,,ومازلت تحبينه؟
Dialogue: 0,0:46:41.74,0:46:44.62,نص عام,,0,0,0,,لقد استخدمته لأغراضي الخاصة
Dialogue: 0,0:46:45.12,0:46:47.58,general text,,0,0,0,,أغلقت بوابة طاقته، واستخدمتها ضده،
Dialogue: 0,0:46:47.67,0:46:49.38,النص العام,,0,0,0,,إجباره على العيش معنا
Dialogue: 0,0:46:49.46,0:46:51.05,نص عام,,0,0,0,,لا تحرف الحقيقة
Dialogue: 0,0:46:51.13,0:46:54.51,general text,,0,0,0,,قال إنه سيعيش معنا إذا ساعدناه على فتح أبواب الطاقة
Dialogue: 0,0:46:54.59,0:46:55.93,النص العام,,0,0,0,,فأغواك
Dialogue: 0,0:46:59.22,0:47:01.06,نص عام,,0,0,0,,وفي النهاية حدث ما حدث.
Dialogue: 0,0:47:01.14,0:47:04.27,general text,,0,0,0,,لو فتحت أبوابه إذن،
Dialogue: 0,0:47:04.35,0:47:06.44,نص عام,,0,0,0,,سيكون لديك صهر،
Dialogue: 0,0:47:06.52,0:47:10.65,نص عام,,0,0,0,,وسأتزوج من أريد
Dialogue: 0,0:47:12.98,0:47:14.11,نص عام,,0,0,0,,تشو يونغ
Dialogue: 0,0:47:14.99,0:47:17.49,general text,,0,0,0,,ابن عائلة تشان التي أبواب طاقتها مفتوحة،
Dialogue: 0,0:47:17.57,0:47:19.74,نص عام,,0,0,0,,لن يكون صهري أبدًا
Dialogue: 0,0:47:21.12,0:47:23.87,نص عام,,0,0,0,,يجب أن تأخذ مكان أختك
Dialogue: 0,0:47:24.66,0:47:27.71,general text,,0,0,0,,وأصبح الرأس الذي يحمي جينيوون من أجل العائلة
Dialogue: 0,0:47:29.38,0:47:31.71,النص العام,,0,0,0,,ابحثي عن الرجل الذي سيدعمك
Dialogue: 0,0:47:33.38,0:47:35.13,نص عام,,0,0,0,,لو لم تمت أختي
Dialogue: 0,0:47:35.92,0:47:38.09,نص عام,,0,0,0,,سأتزوج حبيبتي
Dialogue: 0,0:47:45.10,0:47:46.89,نص عام,,0,0,0,,عذراً يا أمي
Dialogue: 0,0:47:48.69,0:47:52.19,general text,,0,0,0,,تحقق مما إذا كان قد تم جمع جرة غويغو أم لا
Dialogue: 0,0:47:53.48,0:47:54.69,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:48:41.61,0:48:45.79,general text,,0,0,0,,المملكة المتحدة كسرت جرة غويغو
Dialogue: 0,0:48:50.62,0:48:52.79,general text,,0,0,0,,ماذا لو طلبت منه أن يتزوجني في المقابل؟
Dialogue: 0,0:48:53.75,0:48:55.17,النص العام,,0,0,0,,سيرفض بالتأكيد
Dialogue: 0,0:49:01.09,0:49:04.89,نص عام,,0,0,0,,سيدي. يول ينام في أبعد غرفة؟
Dialogue: 0,0:49:04.97,0:49:08.18,النص العام,,0,0,0,,نعم يحب السلام والهدوء
Dialogue: 0,0:49:09.89,0:49:11.39,النص العام,,0,0,0,,متى يذهب للنوم؟
Dialogue: 0,0:49:11.89,0:49:13.35,نص عام,,0,0,0,,إذا لم يكن مشغولاً،
Dialogue: 0,0:49:13.44,0:49:16.65,نص عام,,0,0,0,,النوم مبكرًا والاستيقاظ مبكرًا
Dialogue: 0,0:49:18.03,0:49:19.07,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:49:19.15,0:49:21.03,نص عام,,0,0,0,,هل تريدين زيارة غرفة نومه؟
Dialogue: 0,0:49:22.41,0:49:24.49,نص عام,,0,0,0,,بغض النظر عن مدى إعجابك به، فهذا خطأ
Dialogue: 0,0:49:27.54,0:49:28.79,نص عام,,0,0,0,,تلميح
Dialogue: 0,0:49:28.87,0:49:31.79,general text,,0,0,0,,يأكل دائمًا في نفس الوقت، يمكنك رؤيته في الغداء
Dialogue: 0,0:49:33.00,0:49:34.25,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:49:34.33,0:49:37.63,خلف الكواليس,,0,0,0,,أحتاج إلى أكثر من أن أرى. أحتاج للمسها
Dialogue: 0,0:49:55.27,0:49:56.86,general text,,0,0,0,,نحن دكتور، هل أنت بخير؟
Dialogue: 0,0:50:00.90,0:50:02.07,نص عام,,0,0,0,,يول...
Dialogue: 0,0:50:05.20,0:50:07.74,النص العام,,0,0,0,,لا يُسمح للغرباء بقراءة الكتب في جيونججينجاك
Dialogue: 0,0:50:08.53,0:50:10.91,نص عام,,0,0,0,,إنها تساعد فقط
Dialogue: 0,0:50:11.00,0:50:12.87,نص عام,,0,0,0,,نعم والتعاويذ مكتوبة فيها
Dialogue: 0,0:50:12.96,0:50:14.83,نص عام,,0,0,0,,ما زالت لا تفهم
Dialogue: 0,0:50:16.71,0:50:17.96,نص عام,,0,0,0,,هل أنت سريع؟
Dialogue: 0,0:50:19.30,0:50:20.88,نص عام,,0,0,0,,هل تعرف الفنون القتالية؟
Dialogue: 0,0:50:23.88,0:50:26.64,نص عام,,0,0,0,,تعلمت الرقص في منزل الجيسينغ
Dialogue: 0,0:50:29.81,0:50:31.43,نص عام,,0,0,0,,لهذا السبب أنا سريع
Dialogue: 0,0:50:35.77,0:50:38.90,نص عام,,0,0,0,,أين دون يي؟ يجب أن أسأل شيئا
Dialogue: 0,0:50:41.48,0:50:44.36,general text,,0,0,0,,دون وليس هنا، ولكن هناك مو دوك
Dialogue: 0,0:50:44.99,0:50:47.37,النص العام,,0,0,0,,مو دوك ساعده
Dialogue: 0,0:50:47.45,0:50:48.74,نص عام,,0,0,0,,سأساعدك
Dialogue: 0,0:50:48.82,0:50:50.83,نص عام,,0,0,0,,لا حاجة
Dialogue: 0,0:51:07.13,0:51:09.22,نص عام,,0,0,0,,المساعدة أيها السيد الشاب؟
Dialogue: 0,0:51:13.06,0:51:15.94,النص العام,,0,0,0,,سيدي، هل أنت جائع؟ ما يجب إحضاره؟
Dialogue: 0,0:51:17.60,0:51:20.19,نص عام,,0,0,0,,سيدي، أنا...
Dialogue: 0,0:51:32.74,0:51:36.33,النص العام,,0,0,0,,يعيش هنا سحرة تشونجينجاك. لا تتبعني
Dialogue: 0,0:51:41.75,0:51:45.13,التعليق الصوتي,,0,0,0,,إذا ذهب إلى النوم مبكراً، فهذا يعني أنه سينام
Dialogue: 0,0:51:58.77,0:52:00.10,نص عام,,0,0,0,,هل هذه مرحاض؟
Dialogue: 0,0:52:08.49,0:52:10.74,نص عام,,0,0,0,,لقد طلبت منك الرحيل. لماذا أنت هنا؟
Dialogue: 0,0:52:13.45,0:52:17.87,نص عام,,0,0,0,,اعتقدت أنه ربما يمكنني المساعدة في شيء ما
Dialogue: 0,0:52:18.91,0:52:19.75,نص عام,,0,0,0,,إليكم
Dialogue: 0,0:52:21.17,0:52:22.79,نص عام,,0,0,0,,هل تريد شيئًا مني؟
Dialogue: 0,0:52:27.88,0:52:30.51,خارج الشاشة,,0,0,0,,فقط لألمسك. وهذه فرصة
Dialogue: 0,0:52:31.39,0:52:34.14,general text,,0,0,0,,لماذا تبعتني طوال الطريق إلى حمام الرجال؟
Dialogue: 0,0:53:08.13,0:53:11.34,التعليق الصوتي,,0,0,0,,هذه فرصتي. ستة أنفاس وسوف أفهم كيف يتنفس
Dialogue: 0,0:53:14.22,0:53:15.18,خلف الكواليس,,0,0,0,,واحد
Dialogue: 0,0:53:16.31,0:53:17.14,خلف الكواليس,,0,0,0,,اثنان
Dialogue: 0,0:53:20.02,0:53:21.19,خلف الكواليس,,0,0,0,,ثلاثة
Dialogue: 0,0:53:21.89,0:53:23.02,خلف الكواليس,,0,0,0,,أربعة
Dialogue: 0,0:53:39.20,0:53:40.25,النص العام,,0,0,0,,لماذا فعلت ذلك؟
Dialogue: 0,0:53:40.83,0:53:43.00,التعليق الصوتي,,0,0,0,,لقد كنت قريبًا جدًا
Dialogue: 0,0:53:43.08,0:53:45.17,general text,,0,0,0,,أعلم أنك وبريطانيا كنتما تنظران إلي من بعيد.
Dialogue: 0,0:53:45.25,0:53:46.71,النص العام,,0,0,0,,لماذا تتابعني؟
Dialogue: 0,0:53:48.09,0:53:50.55,خلف الكواليس,,0,0,0,,نفس واحد فقط
Dialogue: 0,0:53:51.59,0:53:52.47,نص عام,,0,0,0,,الإجابة
Dialogue: 0,0:53:53.22,0:53:54.72,نص عام,,0,0,0,,أحبك!
Dialogue: 0,0:54:20.62,0:54:21.62,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:54:22.71,0:54:24.00,نص عام,,0,0,0,,إنه مؤلم
Dialogue: 0,0:54:40.14,0:54:43.81,general text,,0,0,0,,أنت مهتم بتقنية التنفس الخاصة بي. أحاول الوصول إلى جوهر طاقتي
Dialogue: 0,0:54:44.56,0:54:46.40,نص عام,,0,0,0,,أقول لك أحبك
Dialogue: 0,0:54:46.48,0:54:47.94,نص عام,,0,0,0,,أنت تكذب بمهارة كبيرة
Dialogue: 0,0:54:48.81,0:54:50.82,النص العام,,0,0,0,,وقبل ذلك لم يكن هناك رقص بل فنون قتالية
Dialogue: 0,0:54:51.40,0:54:53.03,نص عام,,0,0,0,,كانت حياتي صعبة،
Dialogue: 0,0:54:53.11,0:54:55.53,نص عام,,0,0,0,,لذلك تعلمت بضع حركات للسلامة
Dialogue: 0,0:54:55.61,0:54:57.20,النص العام,,0,0,0,,هل هذا لأوكا؟
Dialogue: 0,0:54:59.49,0:55:02.41,general text,,0,0,0,,أعتقد أنه يحاول التحكم في احتياطي الطاقة بالداخل
Dialogue: 0,0:55:02.50,0:55:05.41,general text,,0,0,0,,لكنه لن ينجح حتى بمساعدة تقنيتي
Dialogue: 0,0:55:08.83,0:55:11.13,نص عام,,0,0,0,,توقف عن إضاعة الوقت. تتحسن وتذهب بعيدا
Dialogue: 0,0:55:31.07,0:55:32.98,نص عام,,0,0,0,,فهل تتذكرني؟
Dialogue: 0,0:55:33.98,0:55:35.11,نص عام,,0,0,0,,يول
Dialogue: 0,0:57:01.36,0:57:05.12,نص عام,,0,0,0,,لم أتجاهلك لأنني كرهتك
Dialogue: 0,0:57:05.20,0:57:08.75,general text,,0,0,0,,والدتك دو هوا كانت بمثابة ابنتي
Dialogue: 0,0:57:09.33,0:57:11.67,النص العام,,0,0,0,,أنا مثل جدك
Dialogue: 0,0:57:13.96,0:57:15.34,نص عام,,0,0,0,,الشاب الوغد
Dialogue: 0,0:57:17.76,0:57:19.63,نص عام,,0,0,0,,نعم يا جدي
Dialogue: 0,0:57:22.84,0:57:27.01,نص عام,,0,0,0,,كانت والدتك لطيفة جدًا
Dialogue: 0,0:57:28.77,0:57:30.06,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:57:30.73,0:57:34.23,نص عام,,0,0,0,,نعم! يجب أن تعرف هذا
Dialogue: 0,0:57:34.31,0:57:37.44,النص العام,,0,0,0,,تذكر هذا ولا تلتفت إلى كلام الآخرين
Dialogue: 0,0:57:40.95,0:57:42.20,نص عام,,0,0,0,,هذا الطفل المسكين...
Dialogue: 0,0:57:45.28,0:57:49.16,خلف الكواليس,,0,0,0,,طول وعمق الشهيق والزفير
Dialogue: 0,0:58:01.30,0:58:03.34,نص عام,,0,0,0,,من الصعب اللعب. أنا معجب
Dialogue: 0,0:58:04.84,0:58:06.76,نص عام,,0,0,0,,أستطيع أن أفعل الكثير
Dialogue: 0,0:58:08.43,0:58:09.68,نص عام,,0,0,0,,العودة
Dialogue: 0,0:58:15.15,0:58:17.19,نص عام,,0,0,0,,يبدو أن عمرها سنوات عديدة
Dialogue: 0,0:58:17.27,0:58:19.73,نص عام,,0,0,0,,لماذا تحتاج إلى شيء قديم جدًا؟
Dialogue: 0,0:58:23.57,0:58:25.24,نص عام,,0,0,0,,إنه لصديق قديم
Dialogue: 0,0:58:31.37,0:58:34.21,general text,,0,0,0,,بدلاً من وجود صديق قريب لديك صفارة
Dialogue: 0,0:58:35.17,0:58:37.04,نص عام,,0,0,0,,فتركك صديقك
Dialogue: 0,0:58:41.38,0:58:42.55,نص عام,,0,0,0,,نعم
Dialogue: 0,0:58:43.38,0:58:44.88,نص عام,,0,0,0,,هذا يخص ذلك الصديق
Dialogue: 0,0:58:47.80,0:58:49.72,general text,,0,0,0,,أرجعني فهو يعني لي الكثير
Dialogue: 0,0:58:51.31,0:58:55.31,النص العام,,0,0,0,,في المقابل علمني أسلوبك في التنفس
Dialogue: 0,0:58:57.90,0:59:00.40,نص عام,,0,0,0,,قلت أنه لا فائدة منه على أية حال
Dialogue: 0,0:59:00.48,0:59:02.69,نص عام,,0,0,0,,هذا أيضًا عديم الفائدة بالنسبة لي
Dialogue: 0,0:59:03.49,0:59:04.61,نص عام,,0,0,0,,دعونا نتغير
Dialogue: 0,0:59:08.07,0:59:09.87,نص عام,,0,0,0,,بالنسبة لي هذا قمامة،
Dialogue: 0,0:59:10.83,0:59:12.37,نص عام,,0,0,0,,يمكنني كسره
Dialogue: 0,0:59:29.76,0:59:31.26,نص عام,,0,0,0,,ثلاثة أنفاس فقط
Dialogue: 0,1:00:12.43,1:00:14.47,نص عام,,0,0,0,,أين هي؟
Dialogue: 0,1:00:40.92,1:00:43.17,نص عام,,0,0,0,,أي نوع من تعابير الوجه؟
Dialogue: 0,1:00:43.71,1:00:46.05,نص عام,,0,0,0,,ليس مثلك
Dialogue: 0,1:00:48.59,1:00:49.76,نص عام,,0,0,0,,أعجبني
Dialogue: 0,1:00:54.47,1:00:56.06,نص عام,,0,0,0,,لقد حرفت كل شيء هكذا
Dialogue: 0,1:00:56.89,1:01:00.31,general text,,0,0,0,,تابعت يول وكررت أنني أحببته والآن اكتشفت ذلك
Dialogue: 0,1:01:00.39,1:01:01.60,نص عام,,0,0,0,,فهمت
Dialogue: 0,1:01:02.44,1:01:05.44,general text,,0,0,0,,أنت شخص حساس تقتل كل من في طريقك،
Dialogue: 0,1:01:05.52,1:01:08.78,النص العام,,0,0,0,,لكنني قررت أن أغازل الرجل من أجل تلميذي
Dialogue: 0,1:01:09.82,1:01:11.03,نص عام,,0,0,0,,وأنت؟
Dialogue: 0,1:01:11.11,1:01:13.78,نص عام,,0,0,0,,أتمنى أنك لم تدع Ho Yeom يأخذ طاقته
Dialogue: 0,1:01:13.87,1:01:16.20,نص عام,,0,0,0,,القوة بداخلي. وتعلمت أسلوبه في التنفس
Dialogue: 0,1:01:16.29,1:01:17.74,نص عام,,0,0,0,,فأضاعت وقتك
Dialogue: 0,1:01:17.83,1:01:20.37,نص عام,,0,0,0,,هل اكتشفت ذلك؟ لا تكذب علي
Dialogue: 0,1:01:21.00,1:01:22.29,نص عام,,0,0,0,,أنا متأكد أنك تكذب،
Dialogue: 0,1:01:22.37,1:01:24.54,نص عام,,0,0,0,,للتظاهر بأنك فعلت شيئًا جديرًا بالاهتمام
Dialogue: 0,1:01:24.63,1:01:26.67,نص عام,,0,0,0,,كنت أتنفس هكذا. كيف هو
Dialogue: 0,1:01:26.75,1:01:29.05,النص العام,,0,0,0,,ويبدو أنني شعرت بشيء يتحرك بداخلي
Dialogue: 0,1:01:37.22,1:01:38.93,نص عام,,0,0,0,,الطاقة تغلي بداخلك
Dialogue: 0,1:01:40.35,1:01:41.69,نص عام,,0,0,0,,نجحت
Dialogue: 0,1:01:44.44,1:01:46.15,general text,,0,0,0,,هل كنت قريبًا إلى هذا الحد من يول؟
Dialogue: 0,1:01:47.77,1:01:49.86,نص عام,,0,0,0,,الحذر. ما زلت أرى العلامة في عينيك
Dialogue: 0,1:01:51.11,1:01:52.86,نص عام,,0,0,0,,لقد استخدمت قطرات العين
Dialogue: 0,1:01:53.82,1:01:56.49,نص عام,,0,0,0,,لم أر العلامة في المرآة. يمكنك رؤيته، أليس كذلك؟
Dialogue: 0,1:01:56.58,1:01:58.12,نص عام,,0,0,0,,هكذا تبدو
Dialogue: 0,1:01:58.20,1:02:00.16,general text,,0,0,0,,إذا كنت معجبًا به حقًا، فهذه هي الطريقة التي يجب أن تتعامل معه بها
Dialogue: 0,1:02:00.25,1:02:02.04,نص عام,,0,0,0,,كن حذراً مع الحب
Dialogue: 0,1:02:03.79,1:02:05.08,نص عام,,0,0,0,,أنت فقط من يستطيع السماح لي بالدخول بهذه الطريقة
Dialogue: 0,1:02:07.75,1:02:10.34,نص عام,,0,0,0,,حسنًا. الآن فقط يمكنك
Dialogue: 0,1:02:12.30,1:02:14.13,نص عام,,0,0,0,,سأحاول ألا أقع في حب يوليا
Dialogue: 0,1:02:15.84,1:02:16.89,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:02:16.97,1:02:19.06,general text,,0,0,0,,لماذا يتطلب هذا جهداً؟
Dialogue: 0,1:02:19.77,1:02:21.27,نص عام,,0,0,0,,إنه جميل
Dialogue: 0,1:02:21.35,1:02:24.19,النص العام,,0,0,0,,يتطلب الأمر جهدًا حتى لا تقع في حب رجل وسيم
Dialogue: 0,1:02:24.27,1:02:25.48,نص عام,,0,0,0,,وأنا؟
Dialogue: 0,1:02:25.56,1:02:28.73,النص العام,,0,0,0,,أعتقد أنه كان من الصعب جدًا عدم الوقوع في حبي
Dialogue: 0,1:02:28.82,1:02:29.94,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,1:02:30.94,1:02:32.82,نص عام,,0,0,0,,كيف لا؟ هذا غير منطقي
Dialogue: 0,1:02:32.90,1:02:35.45,نص عام,,0,0,0,,- قل أنه كان صعباً\N- نعم يا معلم
Dialogue: 0,1:02:35.53,1:02:37.28,نص عام,,0,0,0,,- قل بجدية\N - نعم
Dialogue: 0,1:02:37.37,1:02:39.20,النص العام,,0,0,0,,- إذن هل ستقول ذلك؟\N- نعم
Dialogue: 0,1:02:39.28,1:02:40.70,نص عام,,0,0,0,,هيا أضحكني
Dialogue: 0,1:04:15.55,1:04:16.72,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,1:04:17.63,1:04:19.89,نص عام,,0,0,0,,بالحكم على الطاقة الموجودة في سيفك،
Dialogue: 0,1:04:19.97,1:04:22.72,النص العام,,0,0,0,,لقد أتقنت أعلى درجة من ريوسو
Dialogue: 0,1:04:25.68,1:04:27.31,نص عام,,0,0,0,,لكم كل الشكر،
Dialogue: 0,1:04:28.39,1:04:29.90,نص عام,,0,0,0,,النائب جيونجو
Dialogue: 0,1:04:29.98,1:04:32.65,general text,,0,0,0,,الوحيد الذي يستطيع منافستك،
Dialogue: 0,1:04:32.73,1:04:34.98,نص عام,,0,0,0,,أعتقد أن سيو يول فقط من عائلة سيو
Dialogue: 0,1:04:35.82,1:04:39.49,general text,,0,0,0,,جلالة الملكة والأب جوليا، الجنرال لذا، أخي وأختي
Dialogue: 0,1:04:39.57,1:04:41.70,general text,,0,0,0,,كنت أنا ويول قريبين جدًا عندما كنا أطفالًا،
Dialogue: 0,1:04:41.78,1:04:43.70,النص العام,,0,0,0,,لكن كل شيء تغير عندما دخل سوسنوفي بور
Dialogue: 0,1:04:46.12,1:04:49.96,general text,,0,0,0,,سو يول وبارك دان جو وتشان ووك وجين تشو يونغ معروفون
Dialogue: 0,1:04:50.04,1:04:51.79,نص عام,,0,0,0,,مثل فور سيزونز
Dialogue: 0,1:04:52.88,1:04:54.42,نص عام,,0,0,0,,دعهم يستمتعون
Dialogue: 0,1:04:55.13,1:04:56.05,خط مائل,,0,0,0,,انتظر
Dialogue: 0,1:04:56.13,1:04:58.84,general text,,0,0,0,,لماذا تشان ووك بينهم أيضًا وهو لا يملك السحر؟
Dialogue: 0,1:04:59.80,1:05:01.39,نص عام,,0,0,0,,تملك الآن
Dialogue: 0,1:05:02.09,1:05:03.51,نص عام,,0,0,0,,أبواب طاقته مفتوحة
Dialogue: 0,1:05:04.30,1:05:05.97,نص عام,,0,0,0,,هل البوابة مفتوحة؟
Dialogue: 0,1:05:09.27,1:05:11.27,نص عام,,0,0,0,,لكنه لا يستطيع فعل الكثير
Dialogue: 0,1:05:11.35,1:05:13.77,نص عام,,0,0,0,,هو ابن تشانغ غان، غوانغجو جيونبوغوان
Dialogue: 0,1:05:15.27,1:05:16.36,نص عام,,0,0,0,,مؤخراً
Dialogue: 0,1:05:16.44,1:05:19.15,نص عام,,0,0,0,,جاء وسأل عن سيف ناك سو
Dialogue: 0,1:05:21.32,1:05:22.16,نص عام,,0,0,0,,و؟
Dialogue: 0,1:05:25.20,1:05:27.20,ذكريات,,0,0,0,,هل أنت خائف من أن أنجح؟
Dialogue: 0,1:05:27.29,1:05:28.58,مائل,,0,0,0,,إذن تخليت عنها؟
Dialogue: 0,1:05:28.66,1:05:31.12,general text,,0,0,0,,أمرك جلالته بالاحتفاظ بها في جيونبوغوان
Dialogue: 0,1:05:31.21,1:05:34.63,نص عام,,0,0,0,,منشور غوانغجو ينتمي إلى عائلة جانغ
Dialogue: 0,1:05:35.29,1:05:36.55,نص عام,,0,0,0,,لم يكن هناك خيار
Dialogue: 0,1:05:38.88,1:05:40.51,نص عام,,0,0,0,,يا لها من وقاحة
Dialogue: 0,1:05:40.59,1:05:42.47,نص عام,,0,0,0,,ينظر إلي بازدراء
Dialogue: 0,1:05:43.30,1:05:45.55,نص عام,,0,0,0,,ومع ذلك كنت تلميذاً لوالده
Dialogue: 0,1:05:45.64,1:05:49.02,general text,,0,0,0,,إذا كنت تفكر في الأمر بهذه الطريقة، فأنا لم أكن تلميذه رسميًا
Dialogue: 0,1:05:50.27,1:05:53.15,general text,,0,0,0,,لم يكن لدي مكان أذهب إليه عندما طردتني عائلة جين،
Dialogue: 0,1:05:54.06,1:05:56.06,نص عام,,0,0,0,,اتخذني خادماً
Dialogue: 0,1:05:56.86,1:05:59.19,نص عام,,0,0,0,,أنت معلم ولي عهد هذا البلد
Dialogue: 0,1:05:59.28,1:06:01.03,نص عام,,0,0,0,,كيف يجرؤ؟
Dialogue: 0,1:06:01.11,1:06:02.99,نص عام,,0,0,0,,يبدو الأمر وكأنني أنظر باستخفاف إليّ
Dialogue: 0,1:06:03.07,1:06:05.20,نص عام,,0,0,0,,أعتذر عن ذلك
Dialogue: 0,1:06:06.16,1:06:09.29,نص عام,,0,0,0,,أن معلمك لا يأتي من عائلة نبيلة
Dialogue: 0,1:06:14.04,1:06:15.29,نص عام,,0,0,0,,علينا أن نسرع
Dialogue: 0,1:06:16.17,1:06:18.50,نص عام,,0,0,0,,ضع تشان ووك في مكانه
Dialogue: 0,1:06:39.15,1:06:41.69,general text,,0,0,0,,هذا هو سيف غوانغجو تشان لوالد تشان ووك.
Dialogue: 0,1:06:43.20,1:06:44.28,نص عام,,0,0,0,,أنا بطريقة ما...
Dialogue: 0,1:06:45.36,1:06:47.74,نص عام,,0,0,0,,وعدته بقبوله إذا فضح
Dialogue: 0,1:06:48.49,1:06:50.12,نص عام,,0,0,0,,سيف والده
Dialogue: 0,1:06:50.20,1:06:52.79,general text,,0,0,0,,الآن فتحت أبواب طاقته وهذا ممكن
Dialogue: 0,1:06:53.37,1:06:56.54,general text,,0,0,0,,هل تسمح له بأن يصبح ساحر سوسنوفي بور؟
Dialogue: 0,1:06:58.96,1:07:01.63,نص عام,,0,0,0,,أحضر أوكا
Dialogue: 0,1:07:10.97,1:07:14.23,ذكريات بخط مائل,,0,0,0,,ماذا قلت؟ من هو والده؟
Dialogue: 0,1:07:15.02,1:07:16.44,ذكريات,,0,0,0,,الملك الراحل
Dialogue: 0,1:07:17.81,1:07:19.69,ذكريات,,0,0,0,,إنه ابن ملك!
Dialogue: 0,1:07:22.03,1:07:23.65,ذكريات,,0,0,0,,فهو ابن الملك،
Dialogue: 0,1:07:24.57,1:07:27.20,ذكريات,,0,0,0,,من مات قبل عام؟
Dialogue: 0,1:07:27.78,1:07:29.12,ذكريات,,0,0,0,,الملك الراحل
Dialogue: 0,1:07:29.78,1:07:32.62,ذكريات,,0,0,0,,مات بسبب المرض ولم يتمكن من الحركة
Dialogue: 0,1:07:32.70,1:07:33.87,ذكريات,,0,0,0,,كيف يكون هذا ممكنًا؟
Dialogue: 0,1:07:33.95,1:07:35.54,ذكريات,,0,0,0,,في عيد ميلاد هذا الطفل،
Dialogue: 0,1:07:36.50,1:07:39.13,ذكريات,,0,0,0,,نجم الملك الجديد أشرق في السماء
Dialogue: 0,1:07:40.75,1:07:43.63,ذكريات,,0,0,0,,لقد تولى شقيق الملك المتوفى العرش بالفعل،
Dialogue: 0,1:07:44.34,1:07:46.47,ذكريات,,0,0,0,,التي سيرثها ابنه
Dialogue: 0,1:07:46.55,1:07:49.68,ذكريات,,0,0,0,,إذا اكتشفت العائلة المالكة أن هذا هو ابن الملك،
Dialogue: 0,1:07:50.55,1:07:52.39,ذكريات,,0,0,0,,سوف يدركونها
Dialogue: 0,1:07:53.52,1:07:54.81,ذكريات,,0,0,0,,كتهديد
Dialogue: 0,1:07:59.94,1:08:02.40,ذكريات بخط مائل,,0,0,0,,وجوده سيجلب الفوضى
Dialogue: 0,1:08:03.40,1:08:06.03,ذكريات بخط مائل,,0,0,0,,لا ينبغي أن يلفت الانتباه إلى نفسه
Dialogue: 0,1:08:08.03,1:08:10.53,ذكريات بخط مائل,,0,0,0,,يجب أن يعتقد الناس أنه لا يوجد شيء غير عادي فيه
Dialogue: 0,1:08:16.29,1:08:18.00,نص عام,,0,0,0,,أعتذر بشدة
Dialogue: 0,1:08:18.67,1:08:21.25,نص عام,,0,0,0,,لكل المشاكل التي خلقتها
Dialogue: 0,1:08:23.84,1:08:25.88,نص عام,,0,0,0,,قررت سوسنوفي بور
Dialogue: 0,1:08:26.55,1:08:28.30,نص عام,,0,0,0,,افتح أبواب طاقتك،
Dialogue: 0,1:08:29.01,1:08:30.68,نص عام,,0,0,0,,لذلك المسؤولية لا تقع على عاتقك
Dialogue: 0,1:08:32.22,1:08:34.18,النص العام,,0,0,0,,أنا تشان ووك، الابن الأكبر لعائلة تشان،
Dialogue: 0,1:08:34.26,1:08:36.06,نص عام,,0,0,0,,جاهز للتعلم والممارسة
Dialogue: 0,1:08:36.89,1:08:39.27,general text,,0,0,0,,إذا أعطتني سوسنوفي بور فرصة، سأبذل قصارى جهدي
Dialogue: 0,1:08:40.52,1:08:42.65,النص العام,,0,0,0,,دليلاً على وفائك،
Dialogue: 0,1:08:42.73,1:08:45.57,general text,,0,0,0,,سأعطيك سيف ناك سو الذي أخذته من جين مو،
Dialogue: 0,1:08:46.40,1:08:48.15,نص عام,,0,0,0,,بحيث يتم تخزينه في مستودع أسلحة سوسنوفي بور
Dialogue: 0,1:08:50.91,1:08:52.28,نص عام,,0,0,0,,لا حاجة
Dialogue: 0,1:08:55.70,1:09:00.46,general text,,0,0,0,,السيف لعائلة تشان، فليحتفظ به معك.
Dialogue: 0,1:09:07.21,1:09:10.43,نص عام,,0,0,0,,يمكنك أن تأخذ سيف والدك
Dialogue: 0,1:09:11.89,1:09:15.97,general text,,0,0,0,,من الآن فصاعدا، أمنع تشان ووك من دخول سوسنوفي بور
Dialogue: 0,1:09:22.02,1:09:23.61,نص عام,,0,0,0,,أنت حر في الحضور،
Dialogue: 0,1:09:24.15,1:09:26.73,نص عام,,0,0,0,,مثل ابن صديق قديم
Dialogue: 0,1:09:27.78,1:09:32.70,general text,,0,0,0,,لكن ليس لديك الحق في أن تصبح ساحرًا في سوسنوفي بور
Dialogue: 0,1:09:34.07,1:09:35.74,نص عام,,0,0,0,,الآن
Dialogue: 0,1:09:35.83,1:09:39.62,general text,,0,0,0,,لن يتمكن تشان ووك من الوصول إلى أي شيء في الغابة
Dialogue: 0,1:09:42.67,1:09:46.88,general text,,0,0,0,,أعطني التميمة التي تسمح لك بالمرور من هنا
Dialogue: 0,1:09:51.97,1:09:53.22,نص عام,,0,0,0,,ليس لدي
Dialogue: 0,1:09:54.01,1:09:54.84,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:09:56.81,1:09:58.14,نص عام,,0,0,0,,أنا تائه
Dialogue: 0,1:10:00.85,1:10:02.02,نص عام,,0,0,0,,تميمة الروح
Dialogue: 0,1:10:02.10,1:10:04.60,general text,,0,0,0,,ما العقوبة المقررة لهؤلاء؟
Dialogue: 0,1:10:05.56,1:10:07.27,نص عام,,0,0,0,,من سيفقد التميمة؟
Dialogue: 0,1:10:08.53,1:10:10.53,نص عام,,0,0,0,,الضرب 100 ضربة يا سيد
Dialogue: 0,1:10:10.61,1:10:13.20,نص عام,,0,0,0,,ثم أعطي تشان ووك مائة ضربة
Dialogue: 0,1:10:13.28,1:10:15.32,نص عام,,0,0,0,,لفقدان التميمة
Dialogue: 0,1:10:51.86,1:10:54.32,general text,,0,0,0,,لديه طاقة المعلم هو، كل شيء سيكون على ما يرام.
Dialogue: 0,1:10:54.90,1:10:57.74,نص عام,,0,0,0,,إذا دخلت ستواجه المزيد من المشاكل
Dialogue: 0,1:11:42.29,1:11:44.37,مائل,,0,0,0,,شان ووك، غادر سوسنوفي بور
Dialogue: 0,1:11:44.45,1:11:46.46,نص عام,,0,0,0,,ولا تظهر هنا مرة أخرى
Dialogue: 0,1:11:51.34,1:11:52.38,نص عام,,0,0,0,,ارحل
Dialogue: 0,1:11:54.38,1:11:55.67,نص عام,,0,0,0,,لا
Dialogue: 0,1:11:55.76,1:11:56.80,نص عام,,0,0,0,,لا...
Dialogue: 0,1:11:57.63,1:11:58.84,نص عام,,0,0,0,,لا أستطيع المغادرة بهذه الطريقة
Dialogue: 0,1:12:00.51,1:12:02.60,نص عام,,0,0,0,,لقد ضربت 99 مرة
Dialogue: 0,1:12:04.56,1:12:05.98,نص عام,,0,0,0,,ضربة واحدة متبقية
Dialogue: 0,1:12:08.52,1:12:10.02,نص عام,,0,0,0,,وهذا الأخير
Dialogue: 0,1:12:11.69,1:12:13.11,نص عام,,0,0,0,,طبقه بنفسك
Dialogue: 0,1:12:29.87,1:12:32.04,ذكريات,,0,0,0,,أنا فقط أحاول الحفاظ على سلامته
Dialogue: 0,1:12:32.63,1:12:36.38,memories,,0,0,0,,إذا لم تُفتح أبواب طاقته، ويعيش مثل ابني، فسوف ينجو.
Dialogue: 0,1:12:36.46,1:12:39.59,ذكريات,,0,0,0,,ولكن إذا قرر أن يجرب حظه،
Dialogue: 0,1:12:41.80,1:12:43.93,ذكريات,,0,0,0,,الموت ينتظره
Dialogue: 0,1:13:00.66,1:13:03.70,تعليق صوتي,,0,0,0,,المملكة المتحدة، استسلم فحسب
Dialogue: 0,1:13:04.99,1:13:06.95,خلف الكواليس,,0,0,0,,وعيش بهدوء
Dialogue: 0,1:13:09.04,1:13:10.67,خلف الكواليس,,0,0,0,,هذه هي الطريقة الوحيدة التي ستنجو بها
Dialogue: 0,1:13:40.95,1:13:42.20,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,1:13:44.37,1:13:45.87,نص عام,,0,0,0,,خذ السيف
Dialogue: 0,1:14:18.94,1:14:19.78,نص عام,,0,0,0,,مغادرة
Dialogue: 0,1:15:15.71,1:15:18.08,معاينة,,0,0,0,,أريد أن أكشفها وأريهم إياها
Dialogue: 0,1:15:18.17,1:15:19.96,preview,,0,0,0,,- هل هذا مظهر من مظاهر الغباء؟\N- لا، القوة
Dialogue: 0,1:15:20.04,1:15:21.05,معاينة,,0,0,0,,قف بثبات
Dialogue: 0,1:15:21.13,1:15:23.26,preview,,0,0,0,,هناك سيف آخر لا يمكنك سحبه
Dialogue: 0,1:15:23.34,1:15:26.09,معاينة,,0,0,0,,ولكنها لأبيه
Dialogue: 0,1:15:26.18,1:15:28.43,معاينة,,0,0,0,,لا بد لي من اصطحابه
Dialogue: 0,1:15:28.51,1:15:30.43,معاينة,,0,0,0,,من يفوز يأخذها
Dialogue: 0,1:15:30.51,1:15:33.56,preview,,0,0,0,,مخالفة الأمير مظهر من مظاهر الغباء
Dialogue: 0,1:15:33.64,1:15:37.06,preview,,0,0,0,,لكن البعض يعتقد أن هذا استعراض للقوة. يجب أن أحاول
Dialogue: 0,1:15:38.10,1:15:40.82,preview,,0,0,0,,تلميذي أضعف من أن يقاتلك
Dialogue: 0,1:15:41.77,1:15:43.48,معاينة,,0,0,0,,يجب أن يتعرض للخطر مرة أخرى
Dialogue: 0,1:15:44.24,1:15:46.65,معاينة,,0,0,0,,وسوف يحصل على ما يريد
الحوار: 0,0:02:57.14,0:02:59.14,النكات,,0,0,0,,

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
