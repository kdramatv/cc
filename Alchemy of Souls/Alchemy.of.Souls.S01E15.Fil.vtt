Dialogue: 0,0:01:00.80,0:01:03.72,mga alaala,,0,0,0,,Guro, ako ito, Yom
Dialogue: 0,0:01:03.80,0:01:06.93,mga alaala,,0,0,0,,Kahapon ay isang daang araw mula nang ikaw ay magnilay
Dialogue: 0,0:01:07.01,0:01:08.31,mga alaala,,0,0,0,,Oras na para lumabas
Dialogue: 0,0:01:13.98,0:01:15.10,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:01:20.69,0:01:21.94,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:01:25.70,0:01:26.74,mga alaala,,0,0,0,,Guro...
Dialogue: 0,0:01:27.87,0:01:28.78,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:01:30.95,0:01:31.87,mga alaala,,0,0,0,,Guro!
Dialogue: 0,0:01:32.71,0:01:33.79,mga alaala,,0,0,0,,Guro...
Dialogue: 0,0:01:35.67,0:01:36.58,mga alaala,,0,0,0,,Guro!
Dialogue: 0,0:01:42.55,0:01:45.55,memories italics,,0,0,0,,- Poor boy\N- Poor thing
Dialogue: 0,0:01:45.63,0:01:48.10,mga alaala na italiko,,0,0,0,,- Banal na langit\N- Hindi kapani-paniwala
Dialogue: 0,0:01:48.18,0:01:50.81,memories italics,,0,0,0,,- Siguradong nagyelo siya sa kamatayan\N- Parang ganun
Dialogue: 0,0:01:50.89,0:01:53.64,memories italics,,0,0,0,,- Naaawa ako sa kanya\N- Poor baby
Dialogue: 0,0:01:53.73,0:01:54.94,memories italics,,0,0,0,,- Sayang\N- Paano?
Dialogue: 0,0:01:55.02,0:01:56.69,mga alaala,,0,0,0,,Ano ang nangyayari dito? Ano ito?
Dialogue: 0,0:01:56.77,0:01:58.94,mga alaala na italics,,0,0,0,,Namatay ang isang batang walang tirahan
Dialogue: 0,0:01:59.02,0:02:01.61,memories,,0,0,0,,Bata pa lang siya. Naaawa ako sa kanya
Dialogue: 0,0:02:01.69,0:02:04.74,memories italics,,0,0,0,,Paano ito magiging?
Dialogue: 0,0:02:26.51,0:02:29.09,sa likod ng mga eksena,,0,0,0,,Gaya ng dati mong gusto,
Dialogue: 0,0:02:30.35,0:02:33.35,behind the scenes,,0,0,0,,Tahimik akong magpapaalam sa iyo, master
Dialogue: 0,0:02:40.81,0:02:42.98,memories italics,,0,0,0,,Naaawa ako sa kanya
Dialogue: 0,0:02:43.69,0:02:45.74,memories italics,,0,0,0,,Mukhang ulila na siya
Dialogue: 0,0:02:45.82,0:02:47.32,mga alaala,,0,0,0,,Magdaraos ba tayo ng libing para sa kanya?
Dialogue: 0,0:02:47.40,0:02:48.57,mga alaala,,0,0,0,,- Oo\N- Tayo
Dialogue: 0,0:02:48.66,0:02:49.70,memories italics,,0,0,0,,Siguro cremate...
Dialogue: 0,0:02:49.78,0:02:51.95,mga alaala na italics,,0,0,0,,at ikakalat ang abo sa Gyeongcheongdaeho Lake?
Dialogue: 0,0:02:53.49,0:02:54.95,mga alaala na italics,,0,0,0,,Boy...
Dialogue: 0,0:02:55.04,0:02:56.00,memories,,0,0,0,,ayos ka lang?
Dialogue: 0,0:02:58.62,0:03:00.50,memories italics,,0,0,0,,- Iyon lang...\N- Paano...
Dialogue: 0,0:03:00.58,0:03:03.63,memories,,0,0,0,,- Saan siya pupunta?\N- Saan ka pupunta?
Dialogue: 0,0:03:11.85,0:03:13.35,mga alaala,,0,0,0,,Stop!
Dialogue: 0,0:03:24.69,0:03:25.78,mga alaala na italics,,0,0,0,,Bata
Dialogue: 0,0:03:25.86,0:03:28.20,memories,,0,0,0,,Kakasabi mo lang na itigil ko na?
Dialogue: 0,0:03:30.32,0:03:31.45,mga alaala,,0,0,0,,Ang tanga!
Dialogue: 0,0:03:32.12,0:03:34.62,mga alaala,,0,0,0,,Hindi ako makapaniwala na sinunog mo na ang katawan ko
Dialogue: 0,0:03:37.16,0:03:39.16,mga alaala,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:03:41.17,0:03:44.59,mga alaala,,0,0,0,,Kung dumating ako maya-maya, sinunog mo rin ang tungkod ko
Dialogue: 0,0:03:45.71,0:03:47.26,mga alaala,,0,0,0,,Tanga!
Dialogue: 0,0:03:49.97,0:03:51.14,mga alaala,,0,0,0,,Tanga!
Dialogue: 0,0:03:51.76,0:03:54.43,mga alaala,,0,0,0,,Tanga!
Dialogue: 0,0:03:55.47,0:03:57.52,mga alaala,,0,0,0,,Tanga!
Dialogue: 0,0:04:04.44,0:04:05.94,mga alaala,,0,0,0,,M-master?
Dialogue: 0,0:04:06.02,0:04:08.49,mga alaala,,0,0,0,,pansamantala lang akong umalis sa aking katawan,
Dialogue: 0,0:04:08.57,0:04:10.36,mga alaala,,0,0,0,,para tingnan kung nakarating ako sa Hwansu
Dialogue: 0,0:04:10.45,0:04:12.82,mga alaala,,0,0,0,,pagkatapos ng isang daang araw ng pagmumuni-muni
Dialogue: 0,0:04:13.41,0:04:17.20,memories,,0,0,0,,Pero napansin kong nasusunog ang katawan ko, kaya dali-dali akong lumipat sa isa pa.
Dialogue: 0,0:04:18.29,0:04:19.50,mga alaala,,0,0,0,,Ngunit huli na ang lahat
Dialogue: 0,0:04:22.04,0:04:25.84,memories,,0,0,0,,So nasa katawan ka ng batang ito?
Dialogue: 0,0:04:25.92,0:04:28.13,memories,,0,0,0,,Ikaw ba talaga master?
Dialogue: 0,0:04:28.71,0:04:29.55,mga alaala,,0,0,0,,Eksakto
Dialogue: 0,0:04:29.63,0:04:32.63,mga alaala,,0,0,0,,Ako si Lee Chul, ang iyong panginoon
Dialogue: 0,0:04:33.22,0:04:34.05,mga alaala,,0,0,0,,Oh...
Dialogue: 0,0:04:35.93,0:04:37.56,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:04:38.81,0:04:39.81,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:04:50.69,0:04:52.95,pangkalahatang teksto,,0,0,0,,Ako ay isang lagalag,
Dialogue: 0,0:05:03.21,0:05:04.29,italics,,0,0,0,,Kamahalan
Dialogue: 0,0:05:04.79,0:05:08.63,general text,,0,0,0,,Hindi mo ba ako tinawagan para hanapin ang nomad?
Dialogue: 0,0:05:09.25,0:05:10.51,pangkalahatang text,,0,0,0,,Iyan mismo ang gagawin ko
Dialogue: 0,0:05:11.30,0:05:12.38,pangkalahatang teksto,,0,0,0,,Kaya ko
Dialogue: 0,0:05:12.47,0:05:14.38,pangkalahatang teksto,,0,0,0,,kilalanin ang mga nomad
Dialogue: 0,0:05:48.75,0:05:50.88,pangkalahatang text,,0,0,0,,May nakakita na ba sa iyong mukha?
Dialogue: 0,0:05:55.34,0:05:56.34,mga alaala,,0,0,0,,Ito ay isang payong
Dialogue: 0,0:05:57.43,0:05:58.93,mga alaala,,0,0,0,,Maaaring gamitin bilang isang tungkod
Dialogue: 0,0:06:01.68,0:06:02.68,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:06:02.77,0:06:06.02,general text,,0,0,0,,Sa kabisera walang ibang nakakaalam na nakikita ako
Dialogue: 0,0:06:07.19,0:06:10.23,general text,,0,0,0,,Aakalain ng mga tao na dito nakipaglaban ang mga bandido
Dialogue: 0,0:06:18.78,0:06:20.74,general text,,0,0,0,,Dapat tumigil ka na sa paghahanap sa akin
Dialogue: 0,0:06:25.62,0:06:26.58,mga alaala,,0,0,0,,Kaya ako
Dialogue: 0,0:06:29.84,0:06:31.42,memories,,0,0,0,,So Yi, ikaw ba yan?
Dialogue: 0,0:06:31.50,0:06:33.05,mga alaala,,0,0,0,,Ako si Kim mula sa nayon ng Sari
Dialogue: 0,0:06:34.34,0:06:35.55,mga alaala,,0,0,0,,Nagkamali ka
Dialogue: 0,0:06:43.14,0:06:45.98,mga alaala,,0,0,0,,Halos hindi kami magkakilala. Halos hindi niya ako kilala
Dialogue: 0,0:06:46.06,0:06:47.10,mga alaala,,0,0,0,,Tungkol sa lalaking iyon
Dialogue: 0,0:06:47.73,0:06:49.15,mga alaala,,0,0,0,,kailangan pangalagaan
Dialogue: 0,0:07:00.82,0:07:02.87,general text,,0,0,0,,Hindi na kailangang patayin siya
Dialogue: 0,0:07:02.95,0:07:05.50,general text,,0,0,0,,Kung pumunta siya kay Sari, hindi na kami magkikita.
Dialogue: 0,0:07:05.58,0:07:06.66,general text,,0,0,0,,Pero nagkita kayo
Dialogue: 0,0:07:08.58,0:07:09.67,pangkalahatang teksto,,0,0,0,,Sari Village?
Dialogue: 0,0:07:12.34,0:07:13.88,general text,,0,0,0,,Diyan ka ba nag-stay?
Dialogue: 0,0:07:17.01,0:07:18.18,general text,,0,0,0,,Nagtago ako doon
Dialogue: 0,0:07:19.18,0:07:22.39,pangkalahatang teksto,,0,0,0,,Nakatago mula sa mga thug na ito
Dialogue: 0,0:07:24.06,0:07:27.68,general text,,0,0,0,,May natitira ba diyan na makakakilala sa iyo?
Dialogue: 0,0:07:28.69,0:07:31.73,general text,,0,0,0,,Hindi ako napalapit kahit kanino para hindi nila ako makilala
Dialogue: 0,0:07:32.94,0:07:34.48,general text,,0,0,0,,Magnanakaw ako doon
Dialogue: 0,0:07:34.57,0:07:36.23,pangkalahatang teksto,,0,0,0,,- Ano ito?\N- Pera
Dialogue: 0,0:07:36.32,0:07:39.49,general text,,0,0,0,,Magiging kahina-hinala kung hindi mawawala ang pera
Dialogue: 0,0:07:40.95,0:07:42.16,pangkalahatang teksto,,0,0,0,,Itago ito para sa iyong sarili
Dialogue: 0,0:07:56.80,0:07:59.26,pangkalahatang teksto,,0,0,0,,Hindi ko nais na saktan ang sinuman mula sa nayon ng Sari
Dialogue: 0,0:08:11.77,0:08:13.52,behind the scenes,,0,0,0,,Moo Dok sa kabisera
Dialogue: 0,0:08:13.61,0:08:15.98,offscreen,,0,0,0,,Kung magkita tayo, kailangan ba natin siyang patayin?
Dialogue: 0,0:08:18.94,0:08:21.20,general text,,0,0,0,,Nandito na si Trader Kim mula sa Sari Village?
Dialogue: 0,0:08:21.78,0:08:23.78,general text,,0,0,0,,Oo, kararating lang niya
Dialogue: 0,0:08:23.87,0:08:25.91,general text,,0,0,0,,Nasa huling kwarto siya sa ikalawang palapag
Dialogue: 0,0:08:56.98,0:08:57.98,italics,,0,0,0,,Madam?
Dialogue: 0,0:09:05.62,0:09:09.70,pangkalahatang teksto,,0,0,0,,Ano ang nagdala sa iyo sa lugar na ito?
Dialogue: 0,0:09:09.79,0:09:12.25,pangkalahatang text,,0,0,0,,Wala sa iyong negosyo. Hindi mo ako nakita dito
Dialogue: 0,0:09:13.46,0:09:14.83,general text,,0,0,0,,Madam, naglalaro ka ba talaga
Dialogue: 0,0:09:17.46,0:09:18.50,pangkalahatang teksto,,0,0,0,,sa pagsusugal?
Dialogue: 0,0:09:18.59,0:09:20.46,pangkalahatang teksto,,0,0,0,,Ano? Pagsusugal?
Dialogue: 0,0:09:21.13,0:09:24.09,general text,,0,0,0,,Para kanino mo ako kinukuha? Ako ba ay isang uri ng simpleng tao, sa iyong opinyon?
Dialogue: 0,0:09:24.18,0:09:25.72,pangkalahatang teksto,,0,0,0,,Hindi, siyempre
Dialogue: 0,0:09:26.72,0:09:29.51,general text,,0,0,0,,Ngunit nagsinungaling ka sa akin noong sinabi mong hindi nasira ang jade
Dialogue: 0,0:09:29.60,0:09:33.52,pangkalahatang teksto,,0,0,0,,Dahil sa iyong kakayahang magsinungaling nang walang konsensya,
Dialogue: 0,0:09:34.14,0:09:36.19,general text,,0,0,0,,Akala ko baka may talent ka sa pagsusugal
Dialogue: 0,0:09:40.53,0:09:42.24,pangkalahatang teksto,,0,0,0,,Pumunta ako sa merchant para sa mga tiket
Dialogue: 0,0:09:43.40,0:09:45.32,pangkalahatang text,,0,0,0,,Naubos na ang mga tiket para sa palabas
Dialogue: 0,0:09:45.41,0:09:46.74,general text,,0,0,0,,Kaya ako pumunta dito
Dialogue: 0,0:09:46.82,0:09:48.78,mga inskripsiyon,,0,0,0,,Tiket sa pagpasok\N Magi ng Seochon
Dialogue: 0,0:09:49.70,0:09:52.50,general text,,0,0,0,,- Dalawa ang ticket mo\N- Sasama ako sa nanay ko
Dialogue: 0,0:09:52.58,0:09:54.33,pangkalahatang text,,0,0,0,,Huwag sabihin kahit kanino na nakita mo ako dito
Dialogue: 0,0:09:54.41,0:09:56.79,general text,,0,0,0,,Ayoko ng hindi pagkakaunawaan
Dialogue: 0,0:09:56.88,0:09:58.17,pangkalahatang teksto,,0,0,0,,Sino ang nakakaalam
Dialogue: 0,0:09:58.25,0:10:00.80,general text,,0,0,0,,You see, hindi ako kasing galing sa pagsisinungaling mo
Dialogue: 0,0:10:00.88,0:10:03.42,pangkalahatang text,,0,0,0,,Kung may magtanong, hindi ako sigurado kung kaya kong magsinungaling
Dialogue: 0,0:10:04.76,0:10:07.64,general text,,0,0,0,,Pero para sa kapakanan mo susubukan ko
Dialogue: 0,0:10:12.35,0:10:14.14,italics,,0,0,0,,Nakasalubong ko lang siya dito
Dialogue: 0,0:10:27.32,0:10:28.99,general text,,0,0,0,,Bakit nandito ang head ng Sosnovy Bor?
Dialogue: 0,0:10:32.33,0:10:36.29,general text,,0,0,0,,sana wala siya dito for tickets
Dialogue: 0,0:10:38.42,0:10:41.25,pangkalahatang text,,0,0,0,,Kung gayon hindi ako makakapunta sa palabas kasama si Dong Gu
Dialogue: 0,0:11:22.21,0:11:23.50,pangkalahatang teksto,,0,0,0,,Ikaw ito
Dialogue: 0,0:11:24.63,0:11:26.17,general text,,0,0,0,,pinatay siya
Dialogue: 0,0:11:28.01,0:11:29.22,pangkalahatang text,,0,0,0,,Hindi ako
Dialogue: 0,0:11:29.97,0:11:31.51,general text,,0,0,0,,Bakit mo siya pinatay?
Dialogue: 0,0:11:31.60,0:11:32.97,general text,,0,0,0,,It's really not me
Dialogue: 0,0:11:33.05,0:11:35.02,general text,,0,0,0,,Patay na siya pagdating ko
Dialogue: 0,0:11:40.02,0:11:41.52,general text,,0,0,0,,Siya ay pinatay kamakailan lang
Dialogue: 0,0:11:42.27,0:11:43.36,italics,,0,0,0,,Siya ay pinatay ng isang suntok
Dialogue: 0,0:11:44.57,0:11:45.94,pangkalahatang teksto,,0,0,0,,Sanay na eskrimador
Dialogue: 0,0:11:46.61,0:11:49.07,general text,,0,0,0,,I swear it wasn't me
Dialogue: 0,0:11:49.95,0:11:51.87,general text,,0,0,0,,Wala man lang akong espada
Dialogue: 0,0:12:12.84,0:12:14.80,pangkalahatang teksto,,0,0,0,,Sa tingin ko isang tao ang pumatay sa kanila
Dialogue: 0,0:12:16.10,0:12:17.39,pangkalahatang teksto,,0,0,0,,Sino ang mga lalaking ito?
Dialogue: 0,0:12:17.47,0:12:22.44,general text,,0,0,0,,Ito ang mga magnanakaw na dumating sa kabisera kamakailan.
Dialogue: 0,0:12:22.52,0:12:24.52,general text,,0,0,0,,Dumating na sila
Dialogue: 0,0:12:24.61,0:12:28.57,pangkalahatang teksto,,0,0,0,,kasama ang mangangalakal na si Kim mula sa nayon ng Sari?
Dialogue: 0,0:12:28.65,0:12:29.95,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:12:30.03,0:12:34.57,general text,,0,0,0,,Ngunit naalala ko kung paano siya sinimulan ng mga thug na iyon ilang araw na ang nakakaraan.
Dialogue: 0,0:12:36.08,0:12:40.96,general text,,0,0,0,,Nais nilang malaman kung saan matatagpuan ang manloloko na nakatira sa Sari.
Dialogue: 0,0:12:41.04,0:12:42.62,pangkalahatang teksto,,0,0,0,,Sari Panloloko?
Dialogue: 0,0:12:42.71,0:12:44.50,general text,,0,0,0,,Baka si Moo Dok ito?
Dialogue: 0,0:12:46.50,0:12:48.76,general text,,0,0,0,,Nasaan siya?
Dialogue: 0,0:12:53.47,0:12:55.14,general text,,0,0,0,,Nandito siya
Dialogue: 0,0:12:57.68,0:12:58.97,general text,,0,0,0,,Tumakas siya
Dialogue: 0,0:13:09.61,0:13:10.82,behind the scenes,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:13:11.82,0:13:13.41,offscreen,,0,0,0,,Ano ang mga katawan na ito?
Dialogue: 0,0:13:14.24,0:13:18.83,memories,,0,0,0,,Gusto nilang malaman kung nasaan ang manloloko na nakatira sa Sari.
Dialogue: 0,0:13:19.79,0:13:21.16,voiceover,,0,0,0,,Pwede ba nila akong ibig sabihin?
Dialogue: 0,0:13:22.29,0:13:25.33,behind the scenes,,0,0,0,,Anong klaseng buhay nabuhay si Moo Deok?
Dialogue: 0,0:13:25.92,0:13:28.55,memories,,0,0,0,,Nagkita na ba kayo ni So Yi?
Dialogue: 0,0:13:28.63,0:13:30.80,memories,,0,0,0,,I wonder what she did this time
Dialogue: 0,0:13:30.88,0:13:32.67,mga alaala,,0,0,0,,Huwag mo siyang pakialaman
Dialogue: 0,0:13:34.84,0:13:35.89,pangkalahatang teksto,,0,0,0,,Kaya ako...
Dialogue: 0,0:13:37.68,0:13:39.10,pangkalahatang teksto,,0,0,0,,Sino si So Yi?
Dialogue: 0,0:13:42.02,0:13:44.14,pangkalahatang text,,0,0,0,,Hindi ko siya nakita mismo
Dialogue: 0,0:13:44.85,0:13:47.94,general text,,0,0,0,,Ngunit nakipag-away siya sa lahat ng mga bantay, at sinampal pa ang isa sa mukha
Dialogue: 0,0:13:48.02,0:13:49.94,italics,,0,0,0,,Sigurado akong naalala nila ang kanyang mukha
Dialogue: 0,0:13:50.86,0:13:54.03,general text,,0,0,0,,Madam, wala ni isang guard na dumating ngayon
Dialogue: 0,0:13:54.11,0:13:56.16,italics,,0,0,0,,- Pareho silang hindi dumating?\N- Oo
Dialogue: 0,0:13:56.24,0:13:58.74,pangkalahatang teksto,,0,0,0,,Kakaiba. Hindi sila nawawalan ng trabaho
Dialogue: 0,0:14:04.54,0:14:07.25,pangkalahatang teksto,,0,0,0,,Paumanhin. Hindi natin dapat tratuhin ng ganoon ang salamangkero
Dialogue: 0,0:14:07.75,0:14:10.38,general text,,0,0,0,,Ngunit kailangan ba talaga ito?
Dialogue: 0,0:14:10.46,0:14:11.88,italics,,0,0,0,,"Magu"?
Dialogue: 0,0:14:11.96,0:14:13.38,general text,,0,0,0,,Nagsinungaling ka ba tungkol sa pagiging magician?
Dialogue: 0,0:14:14.88,0:14:16.09,general text,,0,0,0,,malapit na akong maging siya
Dialogue: 0,0:14:16.68,0:14:20.68,pangkalahatang teksto,,0,0,0,,At mas makapangyarihan pa kaysa sa iyo
Dialogue: 0,0:14:23.06,0:14:26.48,general text,,0,0,0,,How dare a fake talk to me like that?
Dialogue: 0,0:14:26.98,0:14:28.98,general text,,0,0,0,, kakausapin kita,
Dialogue: 0,0:14:29.94,0:14:32.78,pangkalahatang teksto,,0,0,0,,at tatawagin mo ako nang may paggalang. hindi ba?
Dialogue: 0,0:14:39.74,0:14:41.24,pangkalahatang teksto,,0,0,0,,Sumunod ka sa kanya
Dialogue: 0,0:14:41.33,0:14:42.74,general text,,0,0,0,,Ito ang trabaho mo
Dialogue: 0,0:14:49.67,0:14:53.09,pangkalahatang teksto,,0,0,0,,May isang batang babae na nagngangalang Moo Deok mula sa nayon ng Sari sa Jwiseonru?
Dialogue: 0,0:14:53.17,0:14:56.51,general text,,0,0,0,,Oo, kilala ko siya. Hinanap mo ba siya noong gabing iyon?
Dialogue: 0,0:14:57.47,0:15:00.64,general text,,0,0,0,,Gusto kong humingi ng pabor sa kanya at may ibalik
Dialogue: 0,0:15:00.72,0:15:02.76,pangkalahatang teksto,,0,0,0,,Wala si Moo Deok sa Jwiseonru
Dialogue: 0,0:15:02.85,0:15:06.02,general text,,0,0,0,,Siya ay isang katulong sa pamilya Jang, ito ang pamilya ni Gwangju Jeonbugwan
Dialogue: 0,0:15:06.68,0:15:08.06,general text,,0,0,0,,Maid ba siya?
Dialogue: 0,0:15:09.35,0:15:11.31,general text,,0,0,0,,Mukhang nakikita na niya ngayon
Dialogue: 0,0:15:12.19,0:15:14.28,general text,,0,0,0,,Malamang niloko ka rin niya
Dialogue: 0,0:15:14.36,0:15:16.03,general text,,0,0,0,,Dinala nila siya sa Chwisonra, akala nila bulag siya,
Dialogue: 0,0:15:16.11,0:15:18.53,general text,,0,0,0,,Ngunit nagulat ang lahat nang imulat niya ang kanyang mga mata at tumakbo palayo
Dialogue: 0,0:15:20.12,0:15:22.12,general text,,0,0,0,,Pero hindi siya manloloko tulad ko
Dialogue: 0,0:15:23.24,0:15:24.74,general text,,0,0,0,,Paano niya nakikita?
Dialogue: 0,0:15:28.46,0:15:30.25,pangkalahatang text,,0,0,0,,Huwag mo akong patayin
Dialogue: 0,0:15:31.17,0:15:32.38,pangkalahatang text,,0,0,0,,I'm sorry
Dialogue: 0,0:15:32.96,0:15:35.17,general text,,0,0,0,,Nakita mo ang mukha ko, hindi kita kayang iwan ng buhay
Dialogue: 0,0:15:36.38,0:15:37.59,pangkalahatang teksto,,0,0,0,,Pakiusap...
Dialogue: 0,0:16:01.74,0:16:05.29,general text,,0,0,0,,Kung nakikita niya, makikilala niya ako
Dialogue: 0,0:16:07.66,0:16:09.58,general text,,0,0,0,,Mad ba siya ng pamilya Chan?
Dialogue: 0,0:16:11.37,0:16:12.92,general text,,0,0,0,,Kailangan ko siyang bisitahin
Dialogue: 0,0:16:15.50,0:16:17.30,general text,,0,0,0,,Nakagawa ba ng pagpatay si Mu Dok?
Dialogue: 0,0:16:17.88,0:16:21.05,pangkalahatang teksto,,0,0,0,,Napatay ang ilang lalaki sa inn
Dialogue: 0,0:16:21.13,0:16:23.80,pangkalahatang text,,0,0,0,,Nandoon si Moo Dok
Dialogue: 0,0:16:23.89,0:16:27.64,pangkalahatang teksto,,0,0,0,,Pero hindi sapat si Moo Deok para pumatay ng tao
Dialogue: 0,0:16:27.72,0:16:29.60,pangkalahatang teksto,,0,0,0,,Lalo na ang ilang lalaki
Dialogue: 0,0:16:29.68,0:16:31.90,pangkalahatang teksto,,0,0,0,,Ginawa ito ng isang bihasang eskrimador
Dialogue: 0,0:16:32.48,0:16:33.90,pangkalahatang teksto,,0,0,0,,Kung hindi siya,
Dialogue: 0,0:16:34.56,0:16:36.61,general text,,0,0,0,,siguro tinulungan siya ng magician
Dialogue: 0,0:16:38.11,0:16:39.28,pangkalahatang teksto,,0,0,0,,Huwag sabihin sa akin,
Dialogue: 0,0:16:40.03,0:16:41.95,pangkalahatang teksto,,0,0,0,,na pinaghihinalaan mo ang aming panginoon
Dialogue: 0,0:16:43.07,0:16:44.32,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:16:44.41,0:16:47.87,general text,,0,0,0,,Nasa palasyo ngayon si Woook kasama si Master Li
Dialogue: 0,0:16:49.79,0:16:51.37,pangkalahatang teksto,,0,0,0,,Salamat sa langit
Dialogue: 0,0:16:51.46,0:16:53.88,pangkalahatang teksto,,0,0,0,,Hindi maaaring si Moo Deok
Dialogue: 0,0:16:53.96,0:16:56.21,general text,,0,0,0,,Wala siyang dahilan para pumatay
Dialogue: 0,0:16:56.29,0:16:57.46,pangkalahatang teksto,,0,0,0,,Dalagang Kim,
Dialogue: 0,0:16:57.55,0:17:00.92,general text,,0,0,0,,gaano mo kakilala si Moo Deok?
Dialogue: 0,0:17:02.51,0:17:03.80,pangkalahatang teksto,,0,0,0,,Alam mo,
Dialogue: 0,0:17:03.89,0:17:09.02,general text,,0,0,0,,anong klaseng buhay ang pinangunahan niya bago siya magtrabaho dito?
Dialogue: 0,0:17:11.06,0:17:11.94,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:17:12.02,0:17:13.73,pangkalahatang teksto,,0,0,0,,Pinatay -
Dialogue: 0,0:17:13.81,0:17:16.44,general text,,0,0,0,,yung lalaking tinanong ko tungkol sa nakaraan ni Moo Deok
Dialogue: 0,0:17:18.15,0:17:20.11,general text,,0,0,0,,Mga bandido na maaaring naghahanap sa kanya,
Dialogue: 0,0:17:20.99,0:17:22.61,pangkalahatang teksto,,0,0,0,,patay din
Dialogue: 0,0:17:25.49,0:17:28.24,pangkalahatang teksto,,0,0,0,,Malinaw na magdududa siya,
Dialogue: 0,0:17:28.33,0:17:30.87,pangkalahatang teksto,,0,0,0,,ngunit tumakas siya sa halip na patunayan ang kanyang pagiging inosente
Dialogue: 0,0:17:31.37,0:17:32.50,pangkalahatang teksto,,0,0,0,,Ano ang sigurado ako -
Dialogue: 0,0:17:32.58,0:17:37.21,pangkalahatang text,,0,0,0,,May tinatago si Moo Dok,
Dialogue: 0,0:17:37.29,0:17:40.71,pangkalahatang teksto,,0,0,0,,kung ano ang hindi maaaring ibunyag
Dialogue: 0,0:17:50.77,0:17:53.27,general text,,0,0,0,,Doon nakatira ang mga bantay
Dialogue: 0,0:17:53.35,0:17:55.19,pangkalahatang teksto,,0,0,0,,Ito ay magiging mas mabilis
Dialogue: 0,0:17:55.27,0:17:58.44,pangkalahatang teksto,,0,0,0,,iguhit ang kanyang larawan at hanapin ito mismo
Dialogue: 0,0:17:58.52,0:18:00.11,general text,,0,0,0,,Hindi ko alam kung ano ang hitsura niya
Dialogue: 0,0:18:00.19,0:18:03.03,general text,,0,0,0,,- Nakilala ko siya noong bulag pa ako\N- Akala ko hindi ka
Dialogue: 0,0:18:04.28,0:18:08.32,general text,,0,0,0,,Sabi mo bulag ka, tapos sasabihin mo hindi ka
Dialogue: 0,0:18:09.53,0:18:12.45,pangkalahatang teksto,,0,0,0,,Hindi ko alam kung ano ang nangyayari doon, ngunit ang iyong buhay ay malinaw na hindi asukal
Dialogue: 0,0:18:14.75,0:18:18.00,general text,,0,0,0,,So hindi mo siya kilala sa paningin, pero kilala ka niya?
Dialogue: 0,0:18:18.96,0:18:21.17,general text,,0,0,0,,Baka delikado hanapin siya?
Dialogue: 0,0:18:21.25,0:18:23.97,general text,,0,0,0,,Paano kung pinatay niya ang mga taong iyon?
Dialogue: 0,0:18:24.05,0:18:25.55,pangkalahatang teksto,,0,0,0,,At bigla kang makakasama nito
Dialogue: 0,0:18:26.88,0:18:29.72,pangkalahatang teksto,,0,0,0,,Mas delikado ang maging pinaghihinalaang pinuno
Dialogue: 0,0:18:32.60,0:18:35.23,general text,,0,0,0,,Pwede ka ring masaktan, pero binayaran mo ang merchant
Dialogue: 0,0:18:35.31,0:18:36.56,pangkalahatang teksto,,0,0,0,,Iyon ay?
Dialogue: 0,0:18:37.56,0:18:39.73,pangkalahatang teksto,,0,0,0,,Hindi ko maintindihan ang ibig mong sabihin
Dialogue: 0,0:18:40.52,0:18:41.57,pangkalahatang teksto,,0,0,0,, Eksakto
Dialogue: 0,0:18:42.44,0:18:44.74,pangkalahatang text,,0,0,0,,Magpanggap na wala kang alam
Dialogue: 0,0:18:45.70,0:18:47.32,italics,,0,0,0,,May namatay!
Dialogue: 0,0:19:06.88,0:19:09.01,italics,,0,0,0,,Guardian Li at Guard Chan!
Dialogue: 0,0:19:17.06,0:19:20.56,general text,,0,0,0,,Hwangsu ay magbibigay ng hindi kapani-paniwalang lakas
Dialogue: 0,0:19:21.23,0:19:24.86,general text,,0,0,0,,Akala ko lahat ng nomad ay halimaw
Dialogue: 0,0:19:25.49,0:19:27.57,pangkalahatang teksto,,0,0,0,,Ngunit nakamit mo ang kabataan at imortalidad
Dialogue: 0,0:19:29.11,0:19:31.16,pangkalahatang teksto,,0,0,0,,Maliwanag na ngayon,
Dialogue: 0,0:19:31.24,0:19:33.87,general text,,0,0,0,,bakit gusto ng lahat ng ice stone para sa alchemy
Dialogue: 0,0:19:34.62,0:19:37.41,general text,,0,0,0,,Lahat gusto siya ng lahat, lumaban sila ng walang hanggan
Dialogue: 0,0:19:37.50,0:19:39.29,pangkalahatang teksto,,0,0,0,,Samakatuwid, ang mahika na ito ay ipinagbabawal
Dialogue: 0,0:19:39.37,0:19:40.75,pangkalahatang teksto,,0,0,0,,Okay, Master Li
Dialogue: 0,0:19:41.67,0:19:43.59,pangkalahatang teksto,,0,0,0,,Makikilala mo sila
Dialogue: 0,0:19:43.67,0:19:45.09,pangkalahatang teksto,,0,0,0,,Tingnan ang paligid
Dialogue: 0,0:19:45.63,0:19:48.51,general text,,0,0,0,,May mga nomad ba sa palasyo?
Dialogue: 0,0:20:02.31,0:20:05.19,general text,,0,0,0,,Hindi sapat ang pagtingin lang sa isang tao
Dialogue: 0,0:20:05.27,0:20:07.44,pangkalahatang teksto,,0,0,0,,Kung hindi nakikita ang asul na marka
Dialogue: 0,0:20:07.53,0:20:09.45,pangkalahatang teksto,,0,0,0,, o mga palatandaan ng kabangisan,
Dialogue: 0,0:20:09.53,0:20:11.61,pangkalahatang teksto,,0,0,0,,hindi sila makikilala sa mga ordinaryong tao
Dialogue: 0,0:20:12.53,0:20:15.33,pangkalahatang teksto,,0,0,0,,Kung gayon paano mo sila nakikilala?
Dialogue: 0,0:20:16.24,0:20:18.20,pangkalahatang teksto,,0,0,0,,Takot na mahuli
Dialogue: 0,0:20:20.29,0:20:22.46,pangkalahatang teksto,,0,0,0,,Takot sa petrification
Dialogue: 0,0:20:26.67,0:20:28.46,pangkalahatang teksto,,0,0,0,,Kailangan nating ilabas ang takot na ito
Dialogue: 0,0:20:29.05,0:20:31.84,general text,,0,0,0,,So nagtanim ka ng takot sa kanila?
Dialogue: 0,0:20:31.93,0:20:33.72,general text,,0,0,0,,Paumanhin kung binigo kita
Dialogue: 0,0:20:34.30,0:20:35.35,pangkalahatang teksto,,0,0,0,,Sa halip
Dialogue: 0,0:20:36.64,0:20:38.81,general text,,0,0,0,,bibigyan kita ng regalo
Dialogue: 0,0:20:38.89,0:20:40.94,pangkalahatang teksto,,0,0,0,,Regalo? Anong meron?
Dialogue: 0,0:20:42.19,0:20:43.35,pangkalahatang teksto,,0,0,0,,Aso
Dialogue: 0,0:20:44.36,0:20:45.31,pangkalahatang teksto,,0,0,0,,Aso?
Dialogue: 0,0:20:45.40,0:20:48.07,general text,,0,0,0,,Siya ay napakatalino at masunurin
Dialogue: 0,0:20:48.15,0:20:50.36,general text,,0,0,0,,Nakatayo siya ngayon sa pintuan ng palasyo
Dialogue: 0,0:20:50.45,0:20:52.49,pangkalahatang teksto,,0,0,0,,Pwede ko bang i-quote ito?
Dialogue: 0,0:20:52.57,0:20:54.70,general text,,0,0,0,,Dahil regalo ito, siyempre
Dialogue: 0,0:20:55.49,0:20:56.66,pangkalahatang teksto,,0,0,0,,Dalhin ang aso
Dialogue: 0,0:20:57.58,0:20:58.45,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:20:59.16,0:21:00.83,general text,,0,0,0,,Gusto kong dalhin mo siya
Dialogue: 0,0:21:02.87,0:21:06.34,pangkalahatang teksto,,0,0,0,,Kung pinamamahalaan mo ito, gagantimpalaan kita
Dialogue: 0,0:21:36.62,0:21:39.08,voiceover,,0,0,0,,Baka tumakas na lang ako kasama si Moo Deok?
Dialogue: 0,0:21:40.66,0:21:42.71,behind the scenes,,0,0,0,,Then everyone will understand
Dialogue: 0,0:21:43.75,0:21:47.17,voiceover,,0,0,0,,At ngayon mahina ako at hindi ko poprotektahan ang aking guro
Dialogue: 0,0:21:52.17,0:21:54.22,voiceover,,0,0,0,,I wonder kung ano ang gagawin ni Master Li?
Dialogue: 0,0:22:23.00,0:22:24.21,pangkalahatang teksto,,0,0,0,,Deputy
Dialogue: 0,0:22:25.25,0:22:26.62,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:22:30.13,0:22:34.67,pangkalahatang teksto,,0,0,0,,Ito ba ay malambot na regalo mula sa panginoon sa hari?
Dialogue: 0,0:22:34.76,0:22:38.47,general text,,0,0,0,,Sinabi ni Master Li na susundan ka ng aso
Dialogue: 0,0:22:39.05,0:22:40.64,pangkalahatang teksto,,0,0,0,,Ngunit mag-ingat
Dialogue: 0,0:22:41.56,0:22:44.73,general text,,0,0,0,,Ano ang panganib na dalhin siya sa palasyo?
Dialogue: 0,0:22:45.31,0:22:46.48,pangkalahatang teksto,,0,0,0,,Ano ang problema?
Dialogue: 0,0:22:48.02,0:22:48.98,pangkalahatang teksto,,0,0,0,,Ito si Gwigu
Dialogue: 0,0:22:49.77,0:22:51.32,general text,,0,0,0,,Dinala niya si Gwiga sa palasyo
Dialogue: 0,0:22:52.65,0:22:53.94,pangkalahatang teksto,,0,0,0,,Ngunit si Gwigu ay isang halimaw
Dialogue: 0,0:22:54.86,0:22:56.70,general text,,0,0,0,,Paano niya siya dadalhin sa palasyo?
Dialogue: 0,0:22:58.78,0:23:02.20,pangkalahatang teksto,,0,0,0,,Ginamit ng guro kong si Seo Kyung ang Gwiga
Dialogue: 0,0:23:02.29,0:23:05.04,pangkalahatang teksto,,0,0,0,,para sa paghahanap ng mga relic na nilikha ng dark magic
Dialogue: 0,0:23:05.12,0:23:07.87,pangkalahatang teksto,,0,0,0,,gamit ang isang batong yelo
Dialogue: 0,0:23:07.96,0:23:09.67,pangkalahatang teksto,,0,0,0,,Oo, narinig ko
Dialogue: 0,0:23:09.75,0:23:12.71,general text,,0,0,0,,Pero akala ko hindi na magagamit,
Dialogue: 0,0:23:12.80,0:23:14.71,general text,,0,0,0,,kasi sira ang kanyang urn
Dialogue: 0,0:23:14.80,0:23:15.76,pangkalahatang teksto,,0,0,0,,Samakatuwid
Dialogue: 0,0:23:16.63,0:23:20.85,general text,,0,0,0,,Inilipat ko ang kaluluwa ni Gwigu sa katawan ng isang patay na aso
Dialogue: 0,0:23:23.14,0:23:24.68,general text,,0,0,0,,Ang asong dinala ko,
Dialogue: 0,0:23:25.73,0:23:26.98,pangkalahatang teksto,,0,0,0,,ito si Gwigu
Dialogue: 0,0:23:29.90,0:23:30.94,pangkalahatang teksto,,0,0,0,,Gwigu?
Dialogue: 0,0:23:35.48,0:23:36.57,pangkalahatang teksto,,0,0,0,,Ano ang dapat nating gawin?
Dialogue: 0,0:23:38.11,0:23:39.95,general text,,0,0,0,,Ilan tayo sa palasyo?
Dialogue: 0,0:23:40.53,0:23:41.70,pangkalahatang teksto,,0,0,0,,Higit sa sampu
Dialogue: 0,0:23:42.28,0:23:43.66,pangkalahatang text,,0,0,0,,Inilipat kay Jeonbugwan?
Dialogue: 0,0:23:43.74,0:23:46.62,general text,,0,0,0,,Nagpadala ng lalaki, malapit na silang dumating
Dialogue: 0,0:24:12.44,0:24:16.82,pangkalahatang teksto,,0,0,0,,Ang pagpupulong na ito ay inorganisa upang magkaroon ng kapayapaan sa pagitan ng mga salamangkero at ng palasyo
Dialogue: 0,0:24:17.49,0:24:20.82,pangkalahatang teksto,,0,0,0,,Binisita ng Crown Prince si Sosnovy Bor, at pinarangalan ka niya sa pamamagitan ng pag-imbita sa iyo dito
Dialogue: 0,0:24:20.91,0:24:22.45,pangkalahatang teksto,,0,0,0,,At gusto mong dalhin dito
Dialogue: 0,0:24:22.53,0:24:24.70,pangkalahatang teksto,,0,0,0,,halimaw, nang hindi humihingi ng pahintulot ng Kanyang Kamahalan?
Dialogue: 0,0:24:24.78,0:24:26.79,pangkalahatang teksto,,0,0,0,,Ibinigay niya ang kanyang pahintulot
Dialogue: 0,0:24:26.87,0:24:28.66,pangkalahatang teksto,,0,0,0,,At ngayon Gwigu
Dialogue: 0,0:24:28.75,0:24:31.46,general text,,0,0,0,,hindi halimaw, dahil sa katawan ng isang ordinaryong aso
Dialogue: 0,0:24:31.54,0:24:34.67,general text,,0,0,0,,So, hindi niya magagawang saktan ang nomad, kahit na mahanap niya siya?
Dialogue: 0,0:24:34.75,0:24:38.26,general text,,0,0,0,,Magsisimula na siyang tumahol, para maintindihan natin
Dialogue: 0,0:24:39.55,0:24:40.59,pangkalahatang teksto,,0,0,0,,Woof
Dialogue: 0,0:24:41.80,0:24:42.80,pangkalahatang teksto,,0,0,0,,Woof!
Dialogue: 0,0:25:00.57,0:25:01.99,behind the scenes,,0,0,0,,Ito ay isang nomad
Dialogue: 0,0:25:02.86,0:25:05.95,behind the scenes,,0,0,0,,As we thought, nomads sa palasyo
Dialogue: 0,0:25:12.46,0:25:13.58,pangkalahatang teksto,,0,0,0,,Ano ang tunog na iyon?
Dialogue: 0,0:25:14.33,0:25:17.55,general text,,0,0,0,,So may mga nomad sa palasyo ko?
Dialogue: 0,0:25:19.34,0:25:20.38,pangkalahatang teksto,,0,0,0,,Parang ito
Dialogue: 0,0:25:21.09,0:25:23.59,general text,,0,0,0,,Kung gayon bakit nakatayo ka lang dito?
Dialogue: 0,0:25:23.68,0:25:26.43,general text,,0,0,0,,Pumunta ka at hulihin mo siya!
Dialogue: 0,0:25:26.51,0:25:29.39,general text,,0,0,0,,Gaya ng sinabi ko, regalo ang aso
Dialogue: 0,0:25:29.47,0:25:32.35,pangkalahatang text,,0,0,0,,Iiwan ko dito
Dialogue: 0,0:25:32.44,0:25:34.65,pangkalahatang teksto,,0,0,0,,Sa paggamit nito makikita mo ang lahat
Dialogue: 0,0:25:34.73,0:25:36.36,pangkalahatang teksto,,0,0,0,,mga nomad sa palasyo
Dialogue: 0,0:25:37.19,0:25:38.98,general text,,0,0,0,,Kunin mo siya, hindi natin siya kailangan
Dialogue: 0,0:25:39.61,0:25:42.19,general text,,0,0,0,,How dare you bring this monster here?!
Dialogue: 0,0:25:42.28,0:25:43.90,pangkalahatang teksto,,0,0,0,,Ang hari ay dumaranas ng pagkabalisa
Dialogue: 0,0:25:43.99,0:25:46.87,general text,,0,0,0,,Sinusubukan mo bang saktan siya ng halimaw na ito?
Dialogue: 0,0:25:49.24,0:25:52.87,general text,,0,0,0,,Inay, kami mismo ang nag-imbita kay Master Li sa palasyo
Dialogue: 0,0:25:52.96,0:25:54.67,pangkalahatang teksto,,0,0,0,,Huwag makisali dito
Dialogue: 0,0:25:55.54,0:25:59.13,pangkalahatang teksto,,0,0,0,,Responsibilidad ni Jeonbugwan na protektahan ang palasyo
Dialogue: 0,0:25:59.21,0:26:01.46,pangkalahatang teksto,,0,0,0,,Kung ginamit ang dark magic sa palasyo,
Dialogue: 0,0:26:01.55,0:26:03.38,pangkalahatang teksto,,0,0,0,,malalaman nila ito
Dialogue: 0,0:26:03.47,0:26:06.01,general text,,0,0,0,,Ayokong makakita ng halimaw sa katawan ng aso,
Dialogue: 0,0:26:06.09,0:26:07.89,pangkalahatang teksto,,0,0,0,,ni ang mga tao ng Sosnovy Bor
Dialogue: 0,0:26:08.43,0:26:11.31,pangkalahatang text,,0,0,0,,Sinisikap mo kaming ipahiya
Dialogue: 0,0:26:13.35,0:26:15.23,pangkalahatang teksto,,0,0,0,,Tigilan mo sila, Kamahalan
Dialogue: 0,0:26:43.09,0:26:45.67,pangkalahatang teksto,,0,0,0,,Dapat protektahan ng anak ni Gwangju Jeonbugwan ang palasyo,
Dialogue: 0,0:26:45.76,0:26:47.72,pangkalahatang text,,0,0,0,,at dinala mo rito ang halimaw na ito
Dialogue: 0,0:26:49.60,0:26:51.68,general text,,0,0,0,,Ito ay regalo ni Master Li sa hari
Dialogue: 0,0:26:51.76,0:26:53.31,pangkalahatang teksto,,0,0,0,,Tara sa loob
Dialogue: 0,0:26:53.39,0:26:55.73,general text,,0,0,0,,Inutusan akong dalhin siya
Dialogue: 0,0:27:01.36,0:27:02.36,general text,,0,0,0,,Ganun ba?
Dialogue: 0,0:27:02.44,0:27:04.36,pangkalahatang teksto,,0,0,0,,Pagkatapos ay subukang mag-log in
Dialogue: 0,0:27:04.94,0:27:06.82,general text,,0,0,0,,Patayin itong halimaw na pumasok sa palasyo
Dialogue: 0,0:27:09.32,0:27:12.28,mga alaala,,0,0,0,,Kung hahawakan mo, gagantimpalaan kita
Dialogue: 0,0:27:12.87,0:27:15.62,voiceover,,0,0,0,,So pinadala niya sa akin yung aso?
Dialogue: 0,0:27:44.07,0:27:45.69,italics,,0,0,0,,Kamahalan, ito si Jin Mu
Dialogue: 0,0:27:46.28,0:27:48.90,pangkalahatang teksto,,0,0,0,,Aalisin ko ang mga walang galang na taong ito mula kay Sosnovy Bor
Dialogue: 0,0:27:49.45,0:27:52.45,general text,,0,0,0,,Nandito kami sa imbitasyon niya, at hindi pa kami tapos mag-usap
Dialogue: 0,0:27:52.53,0:27:54.58,general text,,0,0,0,,Jin Mu, hindi ka dapat makisali dito
Dialogue: 0,0:27:54.66,0:27:56.95,general text,,0,0,0,,How dare you bring this monster here without permission?!
Dialogue: 0,0:27:57.04,0:27:58.66,general text,,0,0,0,,Anong klaseng pag-uugali ito?!
Dialogue: 0,0:27:58.75,0:27:59.96,pangkalahatang teksto,,0,0,0,,Katahimikan
Dialogue: 0,0:28:16.39,0:28:18.68,pangkalahatang teksto,,0,0,0,,Guards! Wag kang tumayo dyan! Pigilan mo siya!
Dialogue: 0,0:28:23.27,0:28:24.40,pangkalahatang teksto,,0,0,0,,Ama
Dialogue: 0,0:28:24.48,0:28:26.07,pangkalahatang teksto,,0,0,0,,Itigil pareho
Dialogue: 0,0:28:26.15,0:28:28.40,general text,,0,0,0,,Kung magsisimula ang away, matatapos ang relasyon natin
Dialogue: 0,0:28:28.99,0:28:29.95,general text,,0,0,0,,Dapat tayong lumaban!
Dialogue: 0,0:28:30.03,0:28:32.95,general text,,0,0,0,,Pine forest ang nagdala sa halimaw na ito dito!
Dialogue: 0,0:28:33.03,0:28:34.62,pangkalahatang teksto,,0,0,0,,Dapat protektahan tayo ni Chonbugwan
Dialogue: 0,0:28:35.37,0:28:37.20,pangkalahatang teksto,,0,0,0,,- Ama!\N- Kamahalan
Dialogue: 0,0:28:41.87,0:28:42.96,general text,,0,0,0,,Inuutusan ko ang lahat...
Dialogue: 0,0:28:45.00,0:28:46.09,pangkalahatang text,,0,0,0,,stop
Dialogue: 0,0:29:05.36,0:29:06.65,pangkalahatang text,,0,0,0,,Stop!
Dialogue: 0,0:29:21.33,0:29:22.58,pangkalahatang teksto,,0,0,0,,Master Li,
Dialogue: 0,0:29:22.67,0:29:25.46,general text,,0,0,0,,Inimbitahan kita in a friendly manner, kailangan bang takutin ako ng ganun?
Dialogue: 0,0:29:26.13,0:29:27.67,pangkalahatang text,,0,0,0,,Paumanhin
Dialogue: 0,0:29:28.63,0:29:32.01,pangkalahatang teksto,,0,0,0,,Kamahalan, kung ang batong yelo ay nabuksan,
Dialogue: 0,0:29:32.09,0:29:34.55,pangkalahatang teksto,,0,0,0,,magsisimula muli ang pagdanak ng dugo
Dialogue: 0,0:29:35.14,0:29:36.22,pangkalahatang teksto,,0,0,0,,Ice stone?
Dialogue: 0,0:29:36.30,0:29:37.97,italics,,0,0,0,,Dahil ba sa mga nomad?
Dialogue: 0,0:29:38.06,0:29:39.64,pangkalahatang teksto,,0,0,0,,Mga taong ginamit
Dialogue: 0,0:29:39.72,0:29:42.73,pangkalahatang teksto,,0,0,0,,relectors para sa alchemy ng mga kaluluwa pagkatapos ng Great Chaos
Dialogue: 0,0:29:43.44,0:29:47.40,general text,,0,0,0,,Mukhang may gumagawa na naman ng reflector
Dialogue: 0,0:29:49.32,0:29:52.70,pangkalahatang teksto,,0,0,0,,Ice stone printed
Dialogue: 0,0:29:58.87,0:29:59.91,italics,,0,0,0,,At?
Dialogue: 0,0:29:59.99,0:30:02.16,general text,,0,0,0,,Nasaan siya? Sa kaninong kamay?
Dialogue: 0,0:30:02.96,0:30:04.71,pangkalahatang teksto,,0,0,0,,Marahil ay kasama sa mga iyon
Dialogue: 0,0:30:04.79,0:30:08.29,pangkalahatang teksto,,0,0,0,,na nagpadala kay Nak Su at ginawang nomad ang mago ni Sosnovy Bor
Dialogue: 0,0:30:08.88,0:30:10.55,general text,,0,0,0,,Narinig ko si Master So Kyung
Dialogue: 0,0:30:10.63,0:30:12.92,pangkalahatang teksto,,0,0,0,, winasak ang lahat ng mga batong yelo 200 taon na ang nakakaraan
Dialogue: 0,0:30:13.01,0:30:13.92,pangkalahatang teksto,,0,0,0,,Malamang,
Dialogue: 0,0:30:14.01,0:30:17.93,pangkalahatang teksto,,0,0,0,,hindi lahat ay nawasak, ang ilan ay nanatili sa Sosnovy Bor
Dialogue: 0,0:30:18.01,0:30:21.56,pangkalahatang teksto,,0,0,0,,Hindi madaling pigilan ang pagnanasa ng tao
Dialogue: 0,0:30:21.64,0:30:22.68,pangkalahatang teksto,,0,0,0,,Ngunit
Dialogue: 0,0:30:24.02,0:30:25.73,pangkalahatang teksto,,0,0,0,,pagbabalik ng yelong bato
Dialogue: 0,0:30:25.81,0:30:29.06,pangkalahatang teksto,,0,0,0,,nagpapahiwatig ng pagdating ng isang lalaking katulad ni Master So Kyung
Dialogue: 0,0:30:32.28,0:30:35.32,pangkalahatang teksto,,0,0,0,,Isinilang si Master So Kyung sa ilalim ng bituin ng Hari
Dialogue: 0,0:30:35.90,0:30:38.03,general text,,0,0,0,,Gayunpaman, hindi siya naging hari
Dialogue: 0,0:30:39.74,0:30:41.12,pangkalahatang teksto,,0,0,0,,Gusto mo bang sabihin,
Dialogue: 0,0:30:41.91,0:30:44.37,general text,,0,0,0,,may iba pa bang ipinanganak sa ilalim ng bituing ito?
Dialogue: 0,0:30:49.21,0:30:51.63,italics,,0,0,0,,Kahit na ito ay umiiral, ang liwanag nito ay mahina
Dialogue: 0,0:30:51.71,0:30:55.92,italics,,0,0,0,,At ang enerhiya ng pitong bituin na nakapaligid sa kanya ay hindi pa nagpapakita ng sarili
Dialogue: 0,0:30:57.01,0:30:59.22,pangkalahatang teksto,,0,0,0,,Isang puwersa na kayang labanan ang kalikasan,
Dialogue: 0,0:30:59.30,0:31:03.18,pangkalahatang teksto,,0,0,0,,at nagdadala ng kaguluhan sa mundo, nagising muli
Dialogue: 0,0:31:03.27,0:31:05.35,italics,,0,0,0,,Lalabas ang pipigilan nito
Dialogue: 0,0:31:06.23,0:31:07.31,pangkalahatang teksto,,0,0,0,,Gaya nito
Dialogue: 0,0:31:08.60,0:31:11.65,pangkalahatang teksto,,0,0,0,,papanatilihin ang balanse sa mundo
Dialogue: 0,0:31:17.65,0:31:22.41,general text,,0,0,0,,Ang gusto kong sabihin, walang kwenta ang mag-alala
Dialogue: 0,0:31:23.87,0:31:27.46,pangkalahatang teksto,,0,0,0,,Sana ay magdulot ito sa iyo ng kapayapaan
Dialogue: 0,0:31:32.71,0:31:35.09,pangkalahatang teksto,,0,0,0,,Salamat sa iyong mga salita
Dialogue: 0,0:31:35.92,0:31:38.51,italics,,0,0,0,,Ngayon kailangan ko nang umalis
Dialogue: 0,0:31:39.22,0:31:41.55,general text,,0,0,0,,Tumanggi ka sa regalo ko,
Dialogue: 0,0:31:41.64,0:31:44.35,general text,,0,0,0,,kaya isasama ko si Gviga
Dialogue: 0,0:31:46.06,0:31:48.06,pangkalahatang teksto,,0,0,0,,- Kamahalan\N- Gawin mo ang gusto mo
Dialogue: 0,0:32:07.41,0:32:09.54,pangkalahatang teksto,,0,0,0,,Hindi, maghintay
Dialogue: 0,0:32:10.37,0:32:12.21,general text,,0,0,0,,Aalis na ba tayo?
Dialogue: 0,0:32:12.29,0:32:13.84,general text,,0,0,0,,Nakita ko lahat ng gusto ko
Dialogue: 0,0:32:16.30,0:32:19.01,memories italics,,0,0,0,,So may mga nomad sa palasyo ko?
Dialogue: 0,0:32:19.51,0:32:21.14,mga alaala,,0,0,0,,Kunin mo siya, hindi natin siya kailangan
Dialogue: 0,0:32:21.22,0:32:23.80,memories,,0,0,0,,How dare you bring this monster here?!
Dialogue: 0,0:32:25.18,0:32:26.93,general text,,0,0,0,,Nagpakita sila ng sarili nila noong nagtanim ako ng takot sa kanila
Dialogue: 0,0:32:30.60,0:32:32.31,pangkalahatang teksto,,0,0,0,,Natatakot?
Dialogue: 0,0:32:32.40,0:32:33.98,general text,,0,0,0,,Hindi nasaktan?
Dialogue: 0,0:32:34.06,0:32:35.86,general text,,0,0,0,,Paano ka nasaktan?
Dialogue: 0,0:32:37.07,0:32:40.03,general text,,0,0,0,,Mabuti ang aso, ngunit hindi ako, dahil sa iyo
Dialogue: 0,0:32:41.78,0:32:42.82,general text,,0,0,0,,Nasaktan?
Dialogue: 0,0:32:43.49,0:32:45.99,general text,,0,0,0,,Nasaktan ako nung nakipag-away ako sa mga bandidong ito diba?
Dialogue: 0,0:32:46.08,0:32:47.87,general text,,0,0,0,,Malayo pa ang mararating niya, di ba?
Dialogue: 0,0:32:50.25,0:32:52.04,general text,,0,0,0,,Teka, dugo ito. Nasaktan?
Dialogue: 0,0:32:52.88,0:32:54.04,pangkalahatang teksto,,0,0,0,,Ito ang aking dugo
Dialogue: 0,0:32:54.13,0:32:55.42,general text,,0,0,0,,Hindi man lang siya nasaktan...
Dialogue: 0,0:32:56.13,0:32:58.17,general text,,0,0,0,,- Dugo...\N- Nasasakupan ka
Dialogue: 0,0:32:58.84,0:33:00.76,pangkalahatang teksto,,0,0,0,,Well, mabuti
Dialogue: 0,0:33:06.18,0:33:07.47,general text,,0,0,0,,Masakit ba?
Dialogue: 0,0:33:09.27,0:33:10.43,pangkalahatang teksto,,0,0,0,,Mukhang oo
Dialogue: 0,0:33:11.06,0:33:13.40,general text,,0,0,0,,Masakit...
Dialogue: 0,0:33:22.95,0:33:25.12,offscreen,,0,0,0,,Gwigu ay kay Master Li
Dialogue: 0,0:33:25.62,0:33:28.54,voiceover,,0,0,0,,Ang dami niyang alam tungkol kay Moo Deok?
Dialogue: 0,0:33:29.54,0:33:31.50,behind the scenes,,0,0,0,,At ano ang gagawin ni Uk,
Dialogue: 0,0:33:31.58,0:33:33.37,voiceover,,0,0,0,,kailan niya malalaman si Nak Soo?
Dialogue: 0,0:33:42.05,0:33:43.09,general text,,0,0,0,,Okay ka lang?
Dialogue: 0,0:33:44.59,0:33:45.72,pangkalahatang teksto,,0,0,0,,Lahat sa mga hiwa
Dialogue: 0,0:33:45.80,0:33:47.55,general text,,0,0,0,,Okay lang ako
Dialogue: 0,0:33:47.64,0:33:50.35,pangkalahatang teksto,,0,0,0,,Nahanap mo na ba ang mga nomad? Ano ang tungkol sa bato?
Dialogue: 0,0:33:51.52,0:33:52.98,pangkalahatang teksto,,0,0,0,,Wala kang ideya...
Dialogue: 0,0:33:53.69,0:33:56.02,pangkalahatang teksto,,0,0,0,,Muntik nang gumalaw ang kaluluwa ko sa takot
Dialogue: 0,0:33:56.61,0:33:59.11,general text,,0,0,0,,Gumawa sila ng eksena, pero wala silang nakitang tao?
Dialogue: 0,0:33:59.19,0:34:02.61,pangkalahatang teksto,,0,0,0,,Hayaan ang aso na kumagat ng isang tao
Dialogue: 0,0:34:03.24,0:34:04.32,italics,,0,0,0,,Uk
Dialogue: 0,0:34:04.40,0:34:06.57,pangkalahatang teksto,,0,0,0,,Hanapin ang nomad sa palasyo
Dialogue: 0,0:34:06.66,0:34:08.99,pangkalahatang teksto,,0,0,0,,mas mahirap kaysa sa Sosnovy Bor o Jeonbugwan
Dialogue: 0,0:34:10.20,0:34:11.70,pangkalahatang teksto,,0,0,0,,Kung mawawalan ng kontrol ang mga bagay,
Dialogue: 0,0:34:11.79,0:34:14.29,pangkalahatang teksto,,0,0,0,,may hidwaan sa pagitan ng palasyo at Sosnovy Bor
Dialogue: 0,0:34:17.42,0:34:18.38,italics,,0,0,0,,Tara na
Dialogue: 0,0:34:18.46,0:34:19.80,pangkalahatang text,,0,0,0,,Kailangan mong i-patch up
Dialogue: 0,0:34:20.50,0:34:21.51,italics,,0,0,0,,Master
Dialogue: 0,0:34:25.05,0:34:27.05,pangkalahatang teksto,,0,0,0,,Maghintay ng kaunti
Dialogue: 0,0:34:27.14,0:34:30.22,general text,,0,0,0,,Hiniling ng Crown Prince na ihatid ka sa kanyang palasyo
Dialogue: 0,0:34:30.81,0:34:33.10,general text,,0,0,0,,- Crown Prince?\N- Umuulan
Dialogue: 0,0:34:33.18,0:34:35.56,general text,,0,0,0,,Gusto niyang hintayin mo siya
Dialogue: 0,0:34:37.81,0:34:38.90,pangkalahatang teksto,,0,0,0,,Lead
Dialogue: 0,0:34:47.74,0:34:50.49,pangkalahatang text,,0,0,0,,Uk, ipadala muna
Dialogue: 0,0:34:50.58,0:34:52.08,pangkalahatang teksto,,0,0,0,,sa Sosnovy Bor
Dialogue: 0,0:34:53.25,0:34:54.41,pangkalahatang teksto,,0,0,0,,Halika rito
Dialogue: 0,0:34:55.83,0:34:56.96,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:35:09.18,0:35:12.81,general text,,0,0,0,,Dapat sinabi mo sa akin na imbitado sila sa palasyo!
Dialogue: 0,0:35:12.89,0:35:14.06,pangkalahatang teksto,,0,0,0,,Akala ko ito ay
Dialogue: 0,0:35:14.81,0:35:16.52,pangkalahatang teksto,,0,0,0,,regular na pagpupulong
Dialogue: 0,0:35:17.02,0:35:18.06,pangkalahatang teksto,,0,0,0,,Kung ang reyna
Dialogue: 0,0:35:18.15,0:35:20.52,general text,,0,0,0,,magdurusa, magiging bato ka, parang eunuch Kim
Dialogue: 0,0:35:20.61,0:35:22.32,pangkalahatang teksto,,0,0,0,,Walang silbi na piraso ng karne!
Dialogue: 0,0:35:34.45,0:35:36.54,pangkalahatang teksto,,0,0,0,,Isang ipinanganak sa ilalim ng bituin ng Hari,
Dialogue: 0,0:35:36.62,0:35:38.92,general text,,0,0,0,,ano ang mauulit sa kapalaran ni Master So Kyung?
Dialogue: 0,0:35:41.25,0:35:43.84,general text,,0,0,0,,Kung lumabas na ang bituin na ito ay bunga ng dark magic,
Dialogue: 0,0:35:44.80,0:35:46.72,pangkalahatang teksto,,0,0,0,,Ang dulo ng Pine Forest
Dialogue: 0,0:35:50.68,0:35:53.97,general text,,0,0,0,,Ipinadala ko si Gviga kay Sosnovy Bor
Dialogue: 0,0:35:55.06,0:35:57.10,general text,,0,0,0,,Paumanhin sa pananakot sa iyo
Dialogue: 0,0:35:57.18,0:35:59.44,pangkalahatang teksto,,0,0,0,,Nang matagpuan ang nomad sa Sosnovy Bor,
Dialogue: 0,0:35:59.52,0:36:01.90,general text,,0,0,0,,Naisip ko na baka nasa palasyo din sila
Dialogue: 0,0:36:02.94,0:36:06.15,general text,,0,0,0,,Kamakailan ay sinubukan pa niyang pumunta dito
Dialogue: 0,0:36:06.90,0:36:09.03,pangkalahatang teksto,,0,0,0,,Nabalitaan ko na siya ang lumikha nito
Dialogue: 0,0:36:09.11,0:36:10.86,general text,,0,0,0,,at pinatay si Nak Su
Dialogue: 0,0:36:15.29,0:36:16.37,general text,,0,0,0,,Nak Su?
Dialogue: 0,0:36:18.25,0:36:21.08,general text,,0,0,0,,Isang mersenaryong pumatay ng maraming mandirigma
Dialogue: 0,0:36:21.75,0:36:23.59,pangkalahatang teksto,,0,0,0,,Ang mga ulo ay lumilipad sa mga balikat kung saan siya naroon
Dialogue: 0,0:36:23.67,0:36:25.55,general text,,0,0,0,,Kaya siya tinawag na
Dialogue: 0,0:36:25.63,0:36:29.22,general text,,0,0,0,,May mga tsismis na siya ay isang nomad at siya ay buhay
Dialogue: 0,0:36:32.43,0:36:34.05,pangkalahatang teksto,,0,0,0,,Nomad Nak Su?
Dialogue: 0,0:36:35.64,0:36:37.39,pangkalahatang teksto,,0,0,0,,Mga kawili-wiling tsismis
Dialogue: 0,0:37:11.63,0:37:15.26,general text,,0,0,0,,Sana mahuli si Mu Deok bago bumalik ang master
Dialogue: 0,0:37:22.52,0:37:24.19,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,0:37:26.48,0:37:27.86,general text,,0,0,0,,Bakit ka nanginginig?
Dialogue: 0,0:37:28.48,0:37:30.82,general text,,0,0,0,,Naniniwala ka ba talaga na nakapatay ako ng tao?
Dialogue: 0,0:37:32.82,0:37:34.82,pangkalahatang teksto,,0,0,0,,Pumasok
Dialogue: 0,0:37:40.25,0:37:41.71,general text,,0,0,0,,Bakit ka dumating?
Dialogue: 0,0:37:42.66,0:37:44.00,general text,,0,0,0,,Kunin ang mga bagay at tumakas?
Dialogue: 0,0:37:44.08,0:37:46.13,general text,,0,0,0,,Pumunta ako para humingi ng isang bagay
Dialogue: 0,0:37:46.71,0:37:48.92,pangkalahatang text,,0,0,0,,Sabi ng ulo sasaluhin ka sa sandaling lumitaw ka
Dialogue: 0,0:37:49.92,0:37:51.09,pangkalahatang teksto,,0,0,0,,Moo Dok,
Dialogue: 0,0:37:51.17,0:37:52.47,general text,,0,0,0,,hindi mo ginawa ito?
Dialogue: 0,0:37:53.18,0:37:56.01,general text,,0,0,0,,- Not me\N- Saka bakit ka tumakas
Dialogue: 0,0:37:56.68,0:37:58.10,pangkalahatang teksto,,0,0,0,,kinailangan kong
Dialogue: 0,0:37:59.47,0:38:00.77,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:38:01.52,0:38:02.60,pangkalahatang teksto,,0,0,0,,Mayroon kang
Dialogue: 0,0:38:03.52,0:38:05.40,pangkalahatang text,,0,0,0,,anumang sikreto?
Dialogue: 0,0:38:10.90,0:38:12.24,pangkalahatang teksto,,0,0,0,,Young Master
Dialogue: 0,0:38:13.32,0:38:15.03,pangkalahatang teksto,,0,0,0,,alam sa kanila?
Dialogue: 0,0:38:21.04,0:38:24.62,general text,,0,0,0,,Moo Dok, kailangan mong tumakas
Dialogue: 0,0:38:25.21,0:38:26.29,general text,,0,0,0,,Bibigyan kita ng pera
Dialogue: 0,0:38:26.37,0:38:27.96,pangkalahatang text,,0,0,0,,Tumakbo at huwag nang bumalik
Dialogue: 0,0:38:28.04,0:38:29.17,pangkalahatang text,,0,0,0,,Hindi ko kaya
Dialogue: 0,0:38:30.38,0:38:32.71,pangkalahatang teksto,,0,0,0,,Hindi ko maiiwan ang aking panginoon
Dialogue: 0,0:38:32.80,0:38:34.05,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:38:35.30,0:38:38.43,general text,,0,0,0,,Kung mananatili kayong malapit, magdududa din siya
Dialogue: 0,0:38:38.51,0:38:39.85,general text,,0,0,0,,Kung nag-aalala ka sa kanya,
Dialogue: 0,0:38:40.64,0:38:42.10,pangkalahatang text,,0,0,0,,tapos tulungan mo ako
Dialogue: 0,0:38:42.18,0:38:45.10,general text,,0,0,0,,Ayaw mong makipag-usap sa ulo, ayaw mo ring tumakas
Dialogue: 0,0:38:45.69,0:38:47.02,general text,,0,0,0,,Ano ang gagawin mo?
Dialogue: 0,0:38:48.69,0:38:50.52,pangkalahatang teksto,,0,0,0,,Kailangan nating mahanap ang pumatay
Dialogue: 0,0:38:51.98,0:38:56.36,pangkalahatang teksto,,0,0,0,,Pinapatay ng pumatay ang mga nakakakilala sa kanya sa pamamagitan ng paningin
Dialogue: 0,0:39:01.41,0:39:03.45,general text,,0,0,0,,Dito ba nakatira si Gwangju Jeongbugwan?
Dialogue: 0,0:39:04.29,0:39:06.16,pangkalahatang teksto,,0,0,0,,Mukhang isang maimpluwensyang pamilya
Dialogue: 0,0:39:08.12,0:39:11.42,general text,,0,0,0,,May nakakakilala ba sa iyo mula sa pamilya Chan?
Dialogue: 0,0:39:14.13,0:39:17.34,pangkalahatang teksto,,0,0,0,,Maghintay sa kanto. Dadalhin ko ang lalaking ito
Dialogue: 0,0:39:28.14,0:39:30.31,pangkalahatang text,,0,0,0,,Gusto kong hilingin sa isang tao na kumpirmahin,
Dialogue: 0,0:39:30.40,0:39:33.98,general text,,0,0,0,,na wala ako sa kwarto nung pinatay yung mga yun.
Dialogue: 0,0:39:35.36,0:39:36.65,pangkalahatang teksto,,0,0,0,,At sino?
Dialogue: 0,0:39:37.24,0:39:38.61,pangkalahatang teksto,,0,0,0,,Mistress Jin mula sa Jinyeowon
Dialogue: 0,0:39:39.61,0:39:41.20,general text,,0,0,0,,Nabangga ko siya doon
Dialogue: 0,0:39:42.20,0:39:44.37,general text,,0,0,0,,Hindi papayag itong sissy na makipagkita sa iyo
Dialogue: 0,0:39:45.62,0:39:46.83,pangkalahatang teksto,,0,0,0,,Maiden Kim
Dialogue: 0,0:39:47.96,0:39:50.21,general text,,0,0,0,,Dalhin mo ako sa Jinyeowon
Dialogue: 0,0:39:52.42,0:39:53.42,pangkalahatang text,,0,0,0,,Jinyeowon?
Dialogue: 0,0:40:18.03,0:40:21.45,general text,,0,0,0,,Excuse me, pwede mo ba akong tulungang buhatin ang saklay?
Dialogue: 0,0:40:27.91,0:40:28.87,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:40:29.75,0:40:32.29,general text,,0,0,0,,Maaari mo bang sabihin sa akin kung nasaan ako?
Dialogue: 0,0:40:33.04,0:40:37.01,pangkalahatang teksto,,0,0,0,,Sa bahay ni Gwangju Jeonbugwan
Dialogue: 0,0:40:38.80,0:40:39.97,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:40:41.01,0:40:42.09,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:40:55.36,0:40:56.61,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:40:56.69,0:40:57.73,pangkalahatang text,,0,0,0,,Tara na
Dialogue: 0,0:41:05.53,0:41:07.49,behind the scenes,,0,0,0,,Mukhang nakikita na ni Moo Deok ngayon
Dialogue: 0,0:41:08.12,0:41:10.08,offscreen,,0,0,0,,Pero hindi niya ako nakilala
Dialogue: 0,0:41:10.87,0:41:12.54,behind the scenes,,0,0,0,,I hope this is for the better
Dialogue: 0,0:41:16.17,0:41:17.42,general text,,0,0,0,,Bakit mag-isa ka?
Dialogue: 0,0:41:18.21,0:41:21.13,general text,,0,0,0,,Nagkamali ako. Hindi namin siya kilala
Dialogue: 0,0:41:22.55,0:41:24.97,general text,,0,0,0,,Tapos na tayo. Balik tayo kay Jeonbugwan
Dialogue: 0,0:41:37.15,0:41:38.69,general text,,0,0,0,,Pwede ko bang subukan?
Dialogue: 0,0:41:38.78,0:41:39.65,pangkalahatang teksto,,0,0,0,,- Hindi\N- Hindi
Dialogue: 0,0:41:39.73,0:41:41.86,pangkalahatang teksto,,0,0,0,,Itigil mo na
Dialogue: 0,0:41:41.95,0:41:43.86,italics,,0,0,0,,Basa ako
Dialogue: 0,0:41:43.95,0:41:45.57,pangkalahatang teksto,,0,0,0,,Ito ang payong
Dialogue: 0,0:41:46.20,0:41:47.12,mga alaala,,0,0,0,,Ito ay isang payong
Dialogue: 0,0:41:48.08,0:41:49.95,mga alaala,,0,0,0,,Maaaring gamitin bilang isang tungkod
Dialogue: 0,0:41:52.96,0:41:55.50,general text,,0,0,0,,Papagalitan ako ni nanay tumigil ka na.
Dialogue: 0,0:41:55.58,0:41:56.50,pangkalahatang teksto,,0,0,0,,Sapat na
Dialogue: 0,0:41:57.17,0:41:59.42,pangkalahatang text,,0,0,0,,- Hindi po\N- Hoy
Dialogue: 0,0:42:00.71,0:42:03.72,general text,,0,0,0,,Gusto mo bang makipagpalitan ng payong sa akin?
Dialogue: 0,0:42:07.60,0:42:11.89,general text,,0,0,0,,Narinig kong gumalaw si Nak Soo
Dialogue: 0,0:42:11.98,0:42:15.73,pangkalahatang teksto,,0,0,0,,sa katawan ng isang matangkad, magandang hubog na binata
Dialogue: 0,0:42:15.81,0:42:19.32,pangkalahatang teksto,,0,0,0,,Maaari siyang lumipat sa katawan ng isang maliit at mahinang babae
Dialogue: 0,0:42:21.40,0:42:26.03,pangkalahatang teksto,,0,0,0,,Sa mahinang katawan, walang saysay na hawakan siya
Dialogue: 0,0:42:28.91,0:42:30.04,pangkalahatang teksto,,0,0,0,,Pero hindi
Dialogue: 0,0:42:30.58,0:42:32.79,pangkalahatang teksto,,0,0,0,,Si Nak Su sa asul ay talagang isang lalaki
Dialogue: 0,0:42:33.58,0:42:35.00,general text,,0,0,0,,"Nak Su in blue"
Dialogue: 0,0:42:35.08,0:42:38.46,general text,,0,0,0,,- Nabalitaan ko\N- Naka-blue siya
Dialogue: 0,0:42:38.54,0:42:42.63,pangkalahatang teksto,,0,0,0,,Kumalat ito kung saan-saan, nagsimulang maglakad-lakad ang mga tao na naka-asul
Dialogue: 0,0:42:42.71,0:42:45.09,general text,,0,0,0,,Akala nila noon
Dialogue: 0,0:42:45.18,0:42:48.22,pangkalahatang teksto,,0,0,0,,Nak Su sa asul ay magpoprotekta sa kanila mula sa alchemy ng mga kaluluwa
Dialogue: 0,0:42:49.93,0:42:51.72,pangkalahatang teksto,,0,0,0,,Si Nak Su ay isang mersenaryo,
Dialogue: 0,0:42:53.22,0:42:56.14,general text,,0,0,0,,pero hindi niya pinatay ang mga ordinaryong tao, at wala siyang lakas
Dialogue: 0,0:43:01.78,0:43:04.65,pangkalahatang teksto,,0,0,0,,Ang mga tao ay maaaring maging napakatanga
Dialogue: 0,0:43:04.74,0:43:06.32,pangkalahatang teksto,,0,0,0,,Hindi ito katangahan
Dialogue: 0,0:43:07.20,0:43:08.45,pangkalahatang teksto,,0,0,0,,Ito ay takot
Dialogue: 0,0:43:11.20,0:43:13.79,general text,,0,0,0,,Nasunog ang katawan ni Nak Su, alam ng lahat
Dialogue: 0,0:43:14.66,0:43:17.46,pangkalahatang teksto,,0,0,0,,Ito ang gawain ng makapangyarihan at maimpluwensyang
Dialogue: 0,0:43:19.25,0:43:20.71,pangkalahatang teksto,,0,0,0,,Tawagin silang mga tanga,
Dialogue: 0,0:43:21.67,0:43:23.84,general text,,0,0,0,,kapag natatakot lang sila, mali
Dialogue: 0,0:43:33.10,0:43:36.73,pangkalahatang teksto,,0,0,0,,Tinapon kita sa pag-asang makahanap ng solusyon,
Dialogue: 0,0:43:36.81,0:43:40.02,general text,,0,0,0,,pero may lakas ng loob kang umupo dito at punahin ako
Dialogue: 0,0:43:43.27,0:43:46.99,pangkalahatang teksto,,0,0,0,,Naiintindihan ko, gusto mong ipahiya ang isa't isa,
Dialogue: 0,0:43:47.07,0:43:50.24,general text,,0,0,0,,pero sana magkaayos na tayong lahat
Dialogue: 0,0:43:51.16,0:43:53.41,pangkalahatang teksto,,0,0,0,,Kasama rin natin si Master Li
Dialogue: 0,0:43:53.49,0:43:54.66,italics,,0,0,0,,Uminom tayo ng tsaa
Dialogue: 0,0:43:57.75,0:43:59.04,italics,,0,0,0,,Your Highness
Dialogue: 0,0:44:00.04,0:44:01.38,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:44:04.80,0:44:07.55,pangkalahatang text,,0,0,0,,Humiling ng audience si Mistress Ho
Dialogue: 0,0:44:07.63,0:44:08.63,pangkalahatang teksto,,0,0,0,,Papasukin siya
Dialogue: 0,0:44:17.14,0:44:18.43,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:44:18.52,0:44:20.98,general text,,0,0,0,,Narinig kong may nasaktan pagkatapos ng laban
Dialogue: 0,0:44:21.56,0:44:23.19,pangkalahatang text,,0,0,0,,Pumunta ako para tingnan
Dialogue: 0,0:44:25.32,0:44:27.61,italics,,0,0,0,,Isa lang ang nasaktan dito
Dialogue: 0,0:44:27.69,0:44:30.57,general text,,0,0,0,,- Alisin mo siya at pagalingin\N- ayos lang ako
Dialogue: 0,0:44:30.66,0:44:32.16,pangkalahatang text,,0,0,0,,Hindi na magtatagal
Dialogue: 0,0:44:32.24,0:44:33.45,italics,,0,0,0,,Lakad kasama ko
Dialogue: 0,0:44:45.84,0:44:48.51,general text,,0,0,0,,Mukhang engaged na ulit si Chan Wook
Dialogue: 0,0:44:48.59,0:44:49.63,general text,,0,0,0,,Muli?
Dialogue: 0,0:44:49.72,0:44:51.72,general text,,0,0,0,,- Ano ang ibig sabihin nito?\N{\i1}- Hindi mo ba alam?
Dialogue: 0,0:44:51.80,0:44:54.01,general text,,0,0,0,,Wala ka ba talagang alam?
Dialogue: 0,0:44:54.10,0:44:56.10,italics,,0,0,0,,Kumakalat ang mga tsismis sa Saejukwon
Dialogue: 0,0:44:56.18,0:44:59.89,general text,,0,0,0,,Kayong tatlo ay mga potensyal na kandidato para sa papel na manugang ni Master Ho Yeom
Dialogue: 0,0:45:00.48,0:45:02.15,pangkalahatang teksto,,0,0,0,,Ang UK ay pangatlo sa listahan
Dialogue: 0,0:45:02.23,0:45:04.06,general text,,0,0,0,,Ngunit para sa kanya, tila, siya ang una
Dialogue: 0,0:45:05.02,0:45:06.98,italics,,0,0,0,,Gusto siyang pakasalan ni Ho Yeom ngayong taon
Dialogue: 0,0:45:07.07,0:45:09.78,general text,,0,0,0,,Malapit na silang mag-usap tungkol sa engagement. Tinitiyak ko sa iyo
Dialogue: 0,0:45:15.87,0:45:19.79,general text,,0,0,0,,Hindi malalim ang mga sugat. Pipigilan ng mga tabletang ito ang pagdurugo
Dialogue: 0,0:45:19.87,0:45:22.71,general text,,0,0,0,,Dapat binigay mo agad sa akin
Dialogue: 0,0:45:22.79,0:45:24.63,pangkalahatang teksto,,0,0,0,,Narinig ko ang tungkol sa mga sugat
Dialogue: 0,0:45:24.71,0:45:29.09,pangkalahatang text,,0,0,0,,Gusto kong suriin ang sarili ko para huminahon
Dialogue: 0,0:45:31.80,0:45:32.88,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,0:45:33.55,0:45:37.89,pangkalahatang teksto,,0,0,0,,Nasugatan ka ng higit sa isang beses, kaya't lumitaw ang kaisipang ito...
Dialogue: 0,0:45:39.02,0:45:40.27,general text,,0,0,0,,Okay lang ako
Dialogue: 0,0:45:40.98,0:45:42.23,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:45:48.44,0:45:52.53,pangkalahatang teksto,,0,0,0,,Oh, eksakto. Binigay sa akin ni Maid Kim
Dialogue: 0,0:45:52.61,0:45:55.24,general text,,0,0,0,,Hindi ko pa siya pinasalamatan
Dialogue: 0,0:45:57.03,0:45:58.33,pangkalahatang teksto,,0,0,0,,Siya ay pareho
Dialogue: 0,0:46:03.62,0:46:04.62,pangkalahatang text,,0,0,0,,Pareho?
Dialogue: 0,0:46:06.63,0:46:08.96,pangkalahatang teksto,,0,0,0,,Isang hairpin na nakita ko dalawampung taon na ang nakakaraan
Dialogue: 0,0:46:09.59,0:46:11.63,pangkalahatang teksto,,0,0,0,,Oh, ito ba ay isang bagay na mahalaga?
Dialogue: 0,0:46:16.34,0:46:17.80,pangkalahatang teksto,,0,0,0,,Mukhang bago
Dialogue: 0,0:46:17.89,0:46:19.89,pangkalahatang teksto,,0,0,0,,Marahil hindi sa atin
Dialogue: 0,0:46:20.68,0:46:22.52,pangkalahatang teksto,,0,0,0,,Ngunit ito ay ginawa na katulad nito
Dialogue: 0,0:46:23.85,0:46:24.69,italics,,0,0,0,,Iyon lang
Dialogue: 0,0:46:25.35,0:46:27.31,pangkalahatang teksto,,0,0,0,,Mukhang tama ang prinsipe
Dialogue: 0,0:46:28.44,0:46:30.61,general text,,0,0,0,,Malapit na nating marinig ang tungkol sa engagement ni Uka
Dialogue: 0,0:46:30.69,0:46:32.65,general text,,0,0,0,,Ngunit para kay Master Huo siya ang pangatlo sa listahan
Dialogue: 0,0:46:34.99,0:46:37.32,general text,,0,0,0,,Ikaw mismo ang magpapakasal sa kanya, dahil ikaw ang una sa listahang ito?
Dialogue: 0,0:46:38.37,0:46:41.41,general text,,0,0,0,,Kung ikakasal ka, kailangan mong bumalik sa Seho
Dialogue: 0,0:46:42.00,0:46:45.00,general text,,0,0,0,,Yul, wag ka na lang magpakasal. Mag-iisa ako
Dialogue: 0,0:46:46.62,0:46:48.92,memories italics,,0,0,0,,Nakikilala ko ang mga nomad
Dialogue: 0,0:46:57.51,0:47:00.05,pangkalahatang teksto,,0,0,0,,Kailangan nating dalhin ito sa Seho sa lalong madaling panahon
Dialogue: 0,0:47:00.14,0:47:01.18,pangkalahatang teksto,,0,0,0,,Sino?
Dialogue: 0,0:47:02.06,0:47:02.93,pangkalahatang text,,0,0,0,,Ako?
Dialogue: 0,0:47:09.11,0:47:10.44,pangkalahatang teksto,,0,0,0,,Binabawi ko ang aking mga salita
Dialogue: 0,0:47:11.15,0:47:15.74,pangkalahatang text,,0,0,0,,Naramdaman kong mas kalmado ang pakiramdam ko pagkatapos kong makita ang iyong reaksyon ngayon
Dialogue: 0,0:47:16.32,0:47:17.95,pangkalahatang teksto,,0,0,0,,Natutuwa akong marinig iyon
Dialogue: 0,0:47:18.87,0:47:20.91,general text,,0,0,0,,Ano ang gusto mong itanong sa akin ng personal?
Dialogue: 0,0:47:23.08,0:47:25.66,general text,,0,0,0,,Alam kong nasa iyo ang espada Nak Su
Dialogue: 0,0:47:25.75,0:47:27.75,general text,,0,0,0,,Pwede ko bang kunin?
Dialogue: 0,0:47:36.42,0:47:39.64,general text,,0,0,0,,Napanood ko ang palabas noong nakaraang taon
Dialogue: 0,0:47:40.22,0:47:41.47,pangkalahatang teksto,,0,0,0,,May mga elepante doon
Dialogue: 0,0:47:41.97,0:47:45.18,general text,,0,0,0,,Pero kapag sumama ako kay Dan Gu, kailangan kong magpanggap na first time ko doon
Dialogue: 0,0:47:45.27,0:47:47.81,general text,,0,0,0,,So para sa inyo ni Mr. Dan Gu ang mga ticket na iyon?
Dialogue: 0,0:47:47.89,0:47:50.06,pangkalahatang text,,0,0,0,,Natatakot. Anong ginagawa mo dito?
Dialogue: 0,0:47:50.15,0:47:52.69,general text,,0,0,0,,Pumunta ako para humingi ng pabor
Dialogue: 0,0:47:52.77,0:47:53.90,pangkalahatang teksto,,0,0,0,,Tungkol sa serbisyo?
Dialogue: 0,0:47:54.94,0:47:56.32,pangkalahatang teksto,,0,0,0,,Huwag kang mag-abala
Dialogue: 0,0:47:56.40,0:47:59.49,pangkalahatang teksto,,0,0,0,,Walang gustong tulungan ka
Dialogue: 0,0:47:59.57,0:48:01.20,general text,,0,0,0,,Ako ay inakusahan ng pagpatay
Dialogue: 0,0:48:01.95,0:48:03.08,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:48:03.16,0:48:05.41,pangkalahatang teksto,,0,0,0,,Maaari kang pumunta sa pinuno ng Sosnovy Bor
Dialogue: 0,0:48:06.12,0:48:08.54,general text,,0,0,0,,at sabihin na nakita mo ako?
Dialogue: 0,0:48:09.67,0:48:13.92,general text,,0,0,0,,Gusto mo bang pumunta ako sa ulo at aminin na pumunta ako
Dialogue: 0,0:48:14.50,0:48:15.76,pangkalahatang teksto,,0,0,0,,sa ganoong lugar?
Dialogue: 0,0:48:16.46,0:48:18.30,general text,,0,0,0,,Hindi ako baliw
Dialogue: 0,0:48:20.18,0:48:21.80,general text,,0,0,0,,Ikaw lang ang pag-asa ko
Dialogue: 0,0:48:22.47,0:48:24.35,pangkalahatang teksto,,0,0,0,,Pakiusap
Dialogue: 0,0:48:27.43,0:48:28.60,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:48:28.68,0:48:30.60,general text,,0,0,0,,Sinabi ko kay Dan Gu na may extra ticket ako
Dialogue: 0,0:48:30.69,0:48:32.56,general text,,0,0,0,,ayokong malaman niya kung saan ko binili
Dialogue: 0,0:48:32.65,0:48:35.27,pangkalahatang teksto,,0,0,0,,Ang iyong kahihiyan ay pansamantala,
Dialogue: 0,0:48:35.36,0:48:37.36,general text,,0,0,0,,at maaari nila akong patayin
Dialogue: 0,0:48:38.36,0:48:40.40,general text,,0,0,0,,Pag nalaman ni nanay, hindi na rin ako mabubuhay
Dialogue: 0,0:48:40.49,0:48:43.24,general text,,0,0,0,,Hinding-hindi niya papatayin ang kanyang anak!
Dialogue: 0,0:48:43.32,0:48:45.54,general text,,0,0,0,,Bakit ka sumisigaw pagdating mo para humingi ng tulong?
Dialogue: 0,0:48:48.29,0:48:51.58,pangkalahatang teksto,,0,0,0,,Kung gayon, ako mismo ang magsasabi sa iyong ina ng lahat.
Dialogue: 0,0:48:52.08,0:48:53.71,pangkalahatang text,,0,0,0,,at humingi ng tulong sa kanya
Dialogue: 0,0:48:53.79,0:48:55.42,general text,,0,0,0,,Tanungin ko ba ang aking ina?
Dialogue: 0,0:48:56.84,0:48:58.38,pangkalahatang teksto,,0,0,0,,Narito siya
Dialogue: 0,0:49:00.76,0:49:03.80,pangkalahatang teksto,,0,0,0,,Hindi ka dapat nag-abala sa mga regalo bilang paghingi ng tawad sa nakaraan
Dialogue: 0,0:49:05.10,0:49:08.77,pangkalahatang teksto,,0,0,0,,Sa tuwing iniisip ko ito, mas gusto kong humingi ng tawad
Dialogue: 0,0:49:10.18,0:49:12.73,pangkalahatang text,,0,0,0,,pupunta ako at tatanungin ko siya mismo
Dialogue: 0,0:49:12.81,0:49:13.73,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:49:13.81,0:49:16.90,general text,,0,0,0,,Pag-iisipan ko. Samahan mo muna ako
Dialogue: 0,0:49:25.74,0:49:27.79,general text,,0,0,0,,Babalik ako kaagad. Maghintay dito
Dialogue: 0,0:49:28.37,0:49:29.83,general text,,0,0,0,,Kung hindi ka bumalik, sisigaw ako
Dialogue: 0,0:49:29.91,0:49:31.41,general text,,0,0,0,,- Babalik ako\N-{\i1} Cho Young
Dialogue: 0,0:49:32.21,0:49:33.33,pangkalahatang teksto,,0,0,0,,Oo, nanay
Dialogue: 0,0:49:34.13,0:49:34.96,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:50:06.28,0:50:07.66,pangkalahatang teksto,,0,0,0,,Napakabata
Dialogue: 0,0:50:08.99,0:50:10.16,general text,,0,0,0,,I wonder kung sino ito?
Dialogue: 0,0:50:39.61,0:50:41.23,general text,,0,0,0,,Dahil ba sa insenso?
Dialogue: 0,0:50:45.24,0:50:46.53,pangkalahatang teksto,,0,0,0,,Magandang plorera
Dialogue: 0,0:50:47.57,0:50:51.54,general text,,0,0,0,,Kung maglalagay ka ng mga bulaklak sa plorera na ito, mas maamoy ang mga ito
Dialogue: 0,0:50:52.79,0:50:54.71,general text,,0,0,0,,- Talaga?\N- Oo
Dialogue: 0,0:50:54.79,0:50:58.00,general text,,0,0,0,,Matagal ko nang gustong palitan ang plorera sa kwarto ng aking anak.
Dialogue: 0,0:50:59.04,0:50:59.96,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:51:03.67,0:51:06.72,general text,,0,0,0,,Nay, maglalagay ka ba ng vase sa kwarto ni Boo Young unnie?
Dialogue: 0,0:51:06.80,0:51:08.72,pangkalahatang teksto,,0,0,0,,Lalong mabango ang mga bulaklak
Dialogue: 0,0:51:08.80,0:51:12.47,general text,,0,0,0,,Bulag ang ate mo, kaya atleast ma-enjoy niya ang amoy ng bulaklak
Dialogue: 0,0:51:56.77,0:51:58.10,general text,,0,0,0,,How dare you?!
Dialogue: 0,0:51:58.19,0:52:00.02,general text,,0,0,0,,Anong ginagawa mo sa kwarto ng anak ko?
Dialogue: 0,0:52:04.90,0:52:06.32,general text,,0,0,0,,Siya ay sumama sa akin
Dialogue: 0,0:52:06.40,0:52:07.86,pangkalahatang teksto,,0,0,0,,Malamang nawala
Dialogue: 0,0:52:08.45,0:52:10.70,general text,,0,0,0,,Moo Dok, anong ginagawa mo dito?
Dialogue: 0,0:52:12.99,0:52:14.16,pangkalahatang text,,0,0,0,,Paumanhin
Dialogue: 0,0:52:15.95,0:52:18.12,italics,,0,0,0,,Tulong minsan
Dialogue: 0,0:52:19.46,0:52:21.04,italics,,0,0,0,,Umalis ka na
Dialogue: 0,0:52:21.13,0:52:22.96,general text,,0,0,0,,At huwag ka nang babalik
Dialogue: 0,0:52:23.04,0:52:24.75,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:52:28.34,0:52:30.18,italics,,0,0,0,,Sasama ako. pangako ko
Dialogue: 0,0:52:32.64,0:52:33.72,pangkalahatang teksto,,0,0,0,,Cho Young,
Dialogue: 0,0:52:34.39,0:52:37.98,general text,,0,0,0,,sabihin sa mga katulong na linisin muli ang kwarto ng ate mo
Dialogue: 0,0:52:38.73,0:52:40.52,pangkalahatang teksto,,0,0,0,,Oo, nanay
Dialogue: 0,0:53:08.26,0:53:09.26,pangkalahatang teksto,,0,0,0,,Kaya ako
Dialogue: 0,0:53:10.26,0:53:12.05,pangkalahatang teksto,,0,0,0,,Ang lalaking ito ang magiging ama mo
Dialogue: 0,0:53:13.01,0:53:14.14,pangkalahatang teksto,,0,0,0,,Ama?
Dialogue: 0,0:53:15.05,0:53:17.47,general text,,0,0,0,,Gusto ng isang ama na magsama ng pekeng anak sa bahay?
Dialogue: 0,0:53:20.85,0:53:24.48,general text,,0,0,0,,Hindi ako ang ama ni Jin Bu Young sa dugo
Dialogue: 0,0:53:25.98,0:53:29.03,general text,,0,0,0,,Ibang tao ang tunay niyang ama
Dialogue: 0,0:53:41.66,0:53:44.38,pangkalahatang teksto,,0,0,0,,Upang kilalanin bilang anak ng pamilya Jin,
Dialogue: 0,0:53:44.46,0:53:46.34,pangkalahatang teksto,,0,0,0,,kailangan mong buksan ang mga pinto ng Jinyeowon
Dialogue: 0,0:53:46.42,0:53:49.84,pangkalahatang teksto,,0,0,0,,At para dito, dapat dumaloy ang kanilang dugo sa iyong mga ugat
Dialogue: 0,0:53:53.72,0:53:55.05,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:53:55.14,0:53:58.47,pangkalahatang teksto,,0,0,0,,Isang uod na naglalaman ng dugo ng isang miyembro ng pamilya Jin
Dialogue: 0,0:54:20.45,0:54:22.37,pangkalahatang teksto,,0,0,0,,Ito ang dugo ni Cho Young,
Dialogue: 0,0:54:23.37,0:54:24.92,pangkalahatang teksto,,0,0,0,,paborito ko
Dialogue: 0,0:54:26.79,0:54:28.96,pangkalahatang teksto,,0,0,0,,At ano ang iyong gagawin tungkol dito?
Dialogue: 0,0:54:29.04,0:54:30.46,pangkalahatang teksto,,0,0,0,,Iabot ang iyong kamay
Dialogue: 0,0:54:32.63,0:54:34.22,pangkalahatang text,,0,0,0,,Huwag mo akong hintayin
Dialogue: 0,0:55:17.68,0:55:20.85,voiceover,,0,0,0,,Ngayon nasa iyo na ang dugo ng pamilya Jin
Dialogue: 0,0:55:21.93,0:55:24.35,voiceover,,0,0,0,,Kung hindi ako gumamit ng dark magic,
Dialogue: 0,0:55:24.43,0:55:27.31,voiceover,,0,0,0,,kakainin ka ng uod na ito mula sa loob
Dialogue: 0,0:55:28.65,0:55:30.23,italics,,0,0,0,,Sinusubukang tumakas,
Dialogue: 0,0:55:31.07,0:55:33.36,italics,,0,0,0,,kakainin ka ng uod na ito ng buhay
Dialogue: 0,0:55:40.45,0:55:43.12,general text,,0,0,0,,Ito ang kwarto ng kanyang anak na babae, na namatay 10 taon na ang nakakaraan
Dialogue: 0,0:55:44.29,0:55:45.87,general text,,0,0,0,,Nalunod yata siya,
Dialogue: 0,0:55:46.62,0:55:49.17,general text,,0,0,0,,pero iniisip pa rin ni Mrs. Jin na babalik siya
Dialogue: 0,0:55:50.75,0:55:51.96,general text,,0,0,0,,naaawa ako sa kanya
Dialogue: 0,0:55:52.92,0:55:54.59,general text,,0,0,0,,Patawarin mo siya sa sampal
Dialogue: 0,0:55:57.72,0:56:00.76,general text,,0,0,0,,At ang kanyang anak na babae ay bulag?
Dialogue: 0,0:56:01.68,0:56:03.97,pangkalahatang teksto,,0,0,0,,Oo, ito ay
Dialogue: 0,0:56:05.27,0:56:07.48,offscreen,,0,0,0,,Bulag din ang may-ari ng katawan na ito
Dialogue: 0,0:56:08.27,0:56:10.60,offscreen,,0,0,0,,Siguro kaya may naramdaman akong kakaiba?
Dialogue: 0,0:56:28.08,0:56:31.21,pangkalahatang teksto,,0,0,0,,Gustong pag-usapan ni Master Li ang tungkol sa prinsipe na mag-isa
Dialogue: 0,0:56:31.83,0:56:32.84,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:56:38.01,0:56:40.97,pangkalahatang teksto,,0,0,0,,Hiniling ng ulo na samahan ka sa Sosnovy Bor
Dialogue: 0,0:56:41.55,0:56:43.55,pangkalahatang teksto,,0,0,0,,Ako? Bakit?
Dialogue: 0,0:56:43.64,0:56:44.64,italics,,0,0,0,,Sumama ka sa amin
Dialogue: 0,0:56:55.15,0:56:56.73,general text,,0,0,0,,Ikukulong na naman nila ako dito ha?
Dialogue: 0,0:56:57.23,0:56:59.07,general text,,0,0,0,,- Anong nangyayari?\N- Ito...
Dialogue: 0,0:56:59.78,0:57:01.11,general text,,0,0,0,,Inutusan kaming manahimik
Dialogue: 0,0:57:01.91,0:57:03.12,italics,,0,0,0,,Hintayin mo siya dito
Dialogue: 0,0:57:12.83,0:57:16.09,general text,,0,0,0,,Nakita si Mu Dok sa tabi ng mga bangkay, malinaw kung bakit siya dinala
Dialogue: 0,0:57:16.17,0:57:18.67,general text,,0,0,0,,Pero bakit, sir? Nasa palasyo siya
Dialogue: 0,0:57:20.05,0:57:22.59,pangkalahatang teksto,,0,0,0,,Ano ang iniisip ng ulo?
Dialogue: 0,0:57:22.68,0:57:23.68,general text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:57:26.31,0:57:27.35,pangkalahatang teksto,,0,0,0,,Yul,
Dialogue: 0,0:57:27.43,0:57:29.56,pangkalahatang teksto,,0,0,0,,Hindi papatayin ni Moo Dok ang sinuman
Dialogue: 0,0:57:30.18,0:57:31.27,italics,,0,0,0,,Talaga?
Dialogue: 0,0:57:34.36,0:57:36.52,general text,,0,0,0,,Pwede ko bang tingnan ang mga katawan?
Dialogue: 0,0:57:49.41,0:57:51.29,pangkalahatang teksto,,0,0,0,,Mahusay na humawak ng espada ang pumatay
Dialogue: 0,0:57:51.91,0:57:53.54,pangkalahatang teksto,,0,0,0,,Hindi ito maaaring si Moo Deok
Dialogue: 0,0:57:55.17,0:57:56.75,offscreen,,0,0,0,,Pero siya si Nak Soo
Dialogue: 0,0:57:57.71,0:57:59.46,offscreen,,0,0,0,,Puwede niya silang patayin
Dialogue: 0,0:58:04.64,0:58:07.55,mga alaala na italics,,0,0,0,,Mayroon akong mga dahilan,
Dialogue: 0,0:58:07.64,0:58:09.06,memories italics,,0,0,0,,wag mo akong abalahin
Dialogue: 0,0:58:12.64,0:58:15.48,general text,,0,0,0,,- Ito yung mga bandido\N- Kilala mo ba sila?
Dialogue: 0,0:58:17.77,0:58:20.03,pangkalahatang text,,0,0,0,,Nakipag-away ako sa kanila kanina lang
Dialogue: 0,0:58:25.28,0:58:27.83,pangkalahatang teksto,,0,0,0,,Maaari ko bang kunin ang kanilang mga katawan at magsagawa ng libing?
Dialogue: 0,0:58:34.37,0:58:36.50,general text,,0,0,0,,Ano ang nagdala kay Chief Chwisonra dito?
Dialogue: 0,0:58:36.58,0:58:38.09,general text,,0,0,0,,May namatay ba?
Dialogue: 0,0:58:38.17,0:58:40.63,general text,,0,0,0,,Napatay ang mga guards namin
Dialogue: 0,0:58:53.93,0:58:55.31,pangkalahatang teksto,,0,0,0,,Dan Gu
Dialogue: 0,0:58:55.39,0:58:57.31,pangkalahatang text,,0,0,0,,Kinuwento ni Servant Kim ang nangyari
Dialogue: 0,0:58:59.23,0:59:00.61,pangkalahatang teksto,,0,0,0,,Cho Young,
Dialogue: 0,0:59:01.61,0:59:03.24,pangkalahatang text,,0,0,0,,tulungan si Moo Dok
Dialogue: 0,0:59:11.12,0:59:13.87,general text,,0,0,0,,Pumunta ako doon para bumili ng ticket
Dialogue: 0,0:59:15.71,0:59:17.58,pangkalahatang text,,0,0,0,,Nandoon si Moo Deok
Dialogue: 0,0:59:19.67,0:59:20.71,pangkalahatang teksto,,0,0,0,,Siyempre,
Dialogue: 0,0:59:20.79,0:59:24.59,general text,,0,0,0,,first time ko sa ganung lugar
Dialogue: 0,0:59:25.17,0:59:26.26,pangkalahatang teksto,,0,0,0,,Alam ko
Dialogue: 0,0:59:27.09,0:59:30.85,general text,,0,0,0,,Nag-usap kami ng konti, tapos pumasok si Moo Deok
Dialogue: 0,0:59:30.93,0:59:32.89,general text,,0,0,0,,Nakita rin kita pagpasok mo
Dialogue: 0,0:59:33.81,0:59:38.27,general text,,0,0,0,,Siyempre, hindi ko akalain na makikita kita sa ganoong lugar
Dialogue: 0,0:59:39.94,0:59:41.11,pangkalahatang teksto,,0,0,0,,Alam ko
Dialogue: 0,0:59:44.57,0:59:45.99,general text,,0,0,0,,Ito ang nangyayari...
Dialogue: 0,0:59:47.03,0:59:51.12,pangkalahatang teksto,,0,0,0,,Hindi kailanman magkakaroon ng sapat na oras si Moo Dok para patayin ang mga lalaking iyon
Dialogue: 0,0:59:52.16,0:59:55.37,pangkalahatang teksto,,0,0,0,,Kamakailan ay may isang batang babae ang pumunta sa Chwisung-ru, hinahanap si Moo Deok
Dialogue: 0,0:59:55.45,0:59:56.91,pangkalahatang teksto,,0,0,0,,Nagpanggap siyang isang salamangkero
Dialogue: 0,0:59:57.00,0:59:58.50,pangkalahatang teksto,,0,0,0,,Sa tingin ni Chwisongru,
Dialogue: 0,0:59:58.58,1:00:02.54,pangkalahatang teksto,,0,0,0,,maaaring si So Yi, ang babaeng binalaan ng mangangalakal kay Moo Deok
Dialogue: 0,1:00:02.63,1:00:05.01,general text,,0,0,0,,Nakita ko minsan ang isang batang babae na hinihila ng mga bandidong ito
Dialogue: 0,1:00:06.34,1:00:07.59,pangkalahatang teksto,,0,0,0,, Mangangalakal,
Dialogue: 0,1:00:07.67,1:00:08.97,pangkalahatang teksto,,0,0,0,,mga bandido at guwardiya
Dialogue: 0,1:00:09.84,1:00:12.10,pangkalahatang teksto,,0,0,0,,Nakipag-intersect silang lahat dito Kaya ako
Dialogue: 0,1:00:12.18,1:00:14.01,general text,,0,0,0,,Itong scammer na si So Yi ay napakahinala
Dialogue: 0,1:00:14.89,1:00:17.14,pangkalahatang teksto,,0,0,0,,Ibig sabihin hindi si Moo Deok ang dapat sisihin
Dialogue: 0,1:00:18.69,1:00:19.73,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,1:00:20.73,1:00:25.32,general text,,0,0,0,,Ako mismo ay nag-alinlangan na si Moo Dok ay maaaring pumatay ng isang tao
Dialogue: 0,1:00:25.40,1:00:29.53,general text,,0,0,0,,Iyon lang. Alam mo, tito, na hindi kaya ni Moo Deok ang ganito, di ba?
Dialogue: 0,1:00:29.61,1:00:33.16,general text,,0,0,0,,Pwede mo bang pabayaan sina Wook at Moo Deok ngayon?
Dialogue: 0,1:00:33.24,1:00:35.49,general text,,0,0,0,,Ini-lock ko sila para
Dialogue: 0,1:00:36.37,1:00:38.33,pangkalahatang teksto,,0,0,0,,magtanong ng isang bagay
Dialogue: 0,1:00:39.37,1:00:40.87,italics,,0,0,0,,ako na ang bahala sa iba
Dialogue: 0,1:00:40.96,1:00:42.08,pangkalahatang text,,0,0,0,,Maaari kang pumunta
Dialogue: 0,1:00:42.17,1:00:43.34,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,1:01:02.27,1:01:03.52,pangkalahatang teksto,,0,0,0,,Kabanata
Dialogue: 0,1:01:04.27,1:01:06.90,pangkalahatang text,,0,0,0,,Sabihin man lang sa akin kung ano ang mali
Dialogue: 0,1:01:07.69,1:01:10.15,pangkalahatang teksto,,0,0,0,,Nakagawa ng pagpatay si Moo Dok
Dialogue: 0,1:01:13.28,1:01:14.28,pangkalahatang teksto,,0,0,0,,Ano...
Dialogue: 0,1:01:14.37,1:01:17.45,general text,,0,0,0,,Pinatay niya ang mga nakakakilala sa kanya noon
Dialogue: 0,1:01:20.62,1:01:24.67,general text,,0,0,0,,Sabihin mo sa akin kung ano ang itinatago ninyo ni Moo Deok
Dialogue: 0,1:01:25.84,1:01:28.30,pangkalahatang teksto,,0,0,0,,Kung ang iyong mga salita ay hindi tumutugma sa mga salita ni Moo Deok,
Dialogue: 0,1:01:28.88,1:01:31.22,general text,,0,0,0,,hindi ka aalis sa kwartong ito
Dialogue: 0,1:01:32.05,1:01:33.80,general text,,0,0,0,,At si Moo Deok ay mamamatay
Dialogue: 0,1:01:55.12,1:01:56.66,pangkalahatang teksto,,0,0,0,,Kabanata, makinig...
Dialogue: 0,1:01:56.74,1:01:58.08,pangkalahatang teksto,,0,0,0,,Hindi ito tungkol sa pagpatay
Dialogue: 0,1:02:00.04,1:02:02.00,general text,,0,0,0,,Ibinunyag sa akin ng UK ang iyong sikreto
Dialogue: 0,1:02:03.29,1:02:04.54,general text,,0,0,0,,Sinabi niya ang lahat
Dialogue: 0,1:02:08.13,1:02:12.05,general text,,0,0,0,,Kung magsasabi ka rin ng totoo, I will save your life
Dialogue: 0,1:02:13.18,1:02:14.34,pangkalahatang teksto,,0,0,0,,Pero kung,
Dialogue: 0,1:02:14.43,1:02:17.51,pangkalahatang teksto,,0,0,0,,magkaiba ang iyong mga salita,
Dialogue: 0,1:02:19.43,1:02:20.89,general text,,0,0,0,,mamamatay ka
Dialogue: 0,1:02:29.82,1:02:31.69,voiceover,,0,0,0,,Kung alam niya na siya ay isang nomad,
Dialogue: 0,1:02:31.78,1:02:33.74,behind the scenes,,0,0,0,,hindi mag-aaksaya ng oras ng ganito
Dialogue: 0,1:02:33.82,1:02:36.41,offscreen,,0,0,0,,Sinusubukan niya kaming paghiwalayin sa pamamagitan ng pagtatanong sa amin nang hiwalay
Dialogue: 0,1:02:37.24,1:02:39.58,behind the scenes,,0,0,0,,Iisa ang dapat nating sabihin
Dialogue: 0,1:02:41.37,1:02:44.62,voiceover,,0,0,0,,Ano ang isasagot ni Chan Wook?
Dialogue: 0,1:02:44.71,1:02:48.54,behind the scenes,,0,0,0,,Isang sikreto na garantisadong mabubunyag nating dalawa
Dialogue: 0,1:02:48.63,1:02:53.22,behind the scenes,,0,0,0,,Isang sikreto, ang pagsisiwalat nito ay hindi hahantong sa aking kamatayan
Dialogue: 0,1:02:56.30,1:02:57.76,pangkalahatang text,,0,0,0,,Sasabihin ko sa iyo
Dialogue: 0,1:02:57.84,1:02:59.22,pangkalahatang teksto,,0,0,0,,Aaminin ko sa iyo
Dialogue: 0,1:03:06.90,1:03:08.36,general text,,0,0,0,,Ano ang nangyari?
Dialogue: 0,1:03:09.36,1:03:11.32,pangkalahatang teksto,,0,0,0,,Moo Deok at Chan Wook
Dialogue: 0,1:03:12.19,1:03:13.32,pangkalahatang text,,0,0,0,,maari kang bumitaw
Dialogue: 0,1:03:13.82,1:03:16.86,general text,,0,0,0,,Ano ang sinabi nila? Isa at pareho?
Dialogue: 0,1:03:20.08,1:03:23.08,general text,,0,0,0,,Sabi nila... the same thing
Dialogue: 0,1:03:52.57,1:03:55.44,general text,,0,0,0,,- Umalis ka\N- Ikaw din
Dialogue: 0,1:03:56.03,1:03:58.91,general text,,0,0,0,,- Buti na okay ka\N- Ako din
Dialogue: 0,1:03:58.99,1:04:00.82,general text,,0,0,0,,Sa kabutihang palad, pareho kami ng sinabi
Dialogue: 0,1:04:02.37,1:04:03.87,general text,,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,1:04:03.95,1:04:05.66,general text,,0,0,0,,Umalis kaming dalawa...
Dialogue: 0,1:04:07.04,1:04:09.04,pangkalahatang teksto,,0,0,0,,kaya sinabi mo ang parehong bagay
Dialogue: 0,1:04:14.00,1:04:17.47,general text,,0,0,0,,Ini-lock mo sila para malaman kung ano ang tinatago nila
Dialogue: 0,1:04:17.55,1:04:19.47,general text,,0,0,0,,Sa tingin ko may nalaman ka
Dialogue: 0,1:04:19.55,1:04:20.39,pangkalahatang teksto,,0,0,0,,Sabihin
Dialogue: 0,1:04:20.47,1:04:22.85,general text,,0,0,0,,Ano ang sikreto nila?
Dialogue: 0,1:04:23.76,1:04:25.18,pangkalahatang teksto,,0,0,0,,Sila...
Dialogue: 0,1:04:26.27,1:04:29.73,pangkalahatang text,,0,0,0,,literal na hindi ako nakaimik
Dialogue: 0,1:04:32.56,1:04:35.19,pangkalahatang teksto,,0,0,0,,Ipinakita nila ang parehong bagay
Dialogue: 0,1:04:37.11,1:04:38.49,memories italics,,0,0,0,,Sasabihin ko ang totoo
Dialogue: 0,1:04:39.40,1:04:41.03,mga alaala,,0,0,0,,Sinubukan kong hindi mahuli
Dialogue: 0,1:04:42.28,1:04:44.08,memories,,0,0,0,,Ito ang tinatago ko
Dialogue: 0,1:05:01.72,1:05:03.22,mga alaala,,0,0,0,,Nakikita mo, ako...
Dialogue: 0,1:05:03.72,1:05:06.10,mga alaala,,0,0,0,,Actually ako...
Dialogue: 0,1:05:13.06,1:05:14.69,mga alaala,,0,0,0,,pag-ibig Moo Deok
Dialogue: 0,1:05:18.53,1:05:20.36,mga alaala,,0,0,0,,mahal na mahal ko ang may-ari
Dialogue: 0,1:05:26.74,1:05:29.20,general text,,0,0,0,,Akala ko aaminin mo
Dialogue: 0,1:05:31.04,1:05:33.42,pangkalahatang teksto,,0,0,0,,Hindi nila ako papatayin para dito
Dialogue: 0,1:05:33.50,1:05:37.25,pangkalahatang teksto,,0,0,0,,Oo, at walang tungkol dito sa Sosnovy Bor rule book
Dialogue: 0,1:05:37.34,1:05:39.71,pangkalahatang teksto,,0,0,0,,Walang pagbabawal sa isang lalaki na mahalin ang isang babae
Dialogue: 0,1:05:42.88,1:05:43.72,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:05:43.80,1:05:47.85,pangkalahatang teksto,,0,0,0,,At ang pag-ibig ng alipin sa kanyang amo ay hindi hahantong sa kamatayan
Dialogue: 0,1:05:49.93,1:05:53.23,general text,,0,0,0,,Iyan ba ang sinabi mo? Bakit mahal mo ako hanggang kamatayan?
Dialogue: 0,1:05:54.98,1:05:56.11,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,1:05:56.82,1:06:00.03,general text,,0,0,0,,exaggerated ko para maniwala siya
Dialogue: 0,1:06:03.28,1:06:04.82,pangkalahatang teksto,,0,0,0,,Walang ibang pagpipilian
Dialogue: 0,1:06:06.20,1:06:09.70,general text,,0,0,0,,Walang choice kundi aminin na mahal mo ako hanggang kamatayan
Dialogue: 0,1:06:10.91,1:06:12.62,general text,,0,0,0,,I'm somehow sorry even
Dialogue: 0,1:06:13.33,1:06:15.71,pangkalahatang teksto,,0,0,0,,Hindi ako naglagay ng labis na damdamin sa aking pagtatapat
Dialogue: 0,1:06:16.25,1:06:17.54,pangkalahatang teksto,,0,0,0,,Kailangan naming subukan
Dialogue: 0,1:06:17.63,1:06:18.80,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,1:06:20.59,1:06:24.59,pangkalahatang teksto,,0,0,0,,Huwag ilagay ang lahat sa linya para sa isang bagay na pabagu-bago ng pag-ibig
Dialogue: 0,1:06:25.93,1:06:27.85,pangkalahatang teksto,,0,0,0,,Kung maulit ito,
Dialogue: 0,1:06:28.60,1:06:30.89,pangkalahatang teksto,,0,0,0,,at ang buhay ay nakasalalay sa pagpili,
Dialogue: 0,1:06:31.98,1:06:33.23,general text,,0,0,0,,betray love
Dialogue: 0,1:06:34.52,1:06:35.73,pangkalahatang teksto,,0,0,0,,at piliin ang buhay
Dialogue: 0,1:06:38.11,1:06:39.73,italics,,0,0,0,,Maliban kung, siyempre, gusto mong mamatay
Dialogue: 0,1:06:40.65,1:06:42.19,pangkalahatang teksto,,0,0,0,,Ito ang utos ng guro
Dialogue: 0,1:06:47.24,1:06:48.37,pangkalahatang teksto,,0,0,0,,Guro,
Dialogue: 0,1:06:49.08,1:06:50.62,pangkalahatang teksto,,0,0,0,,paano kung hindi ko iniisip na mamatay?
Dialogue: 0,1:06:51.41,1:06:53.83,general text,,0,0,0,,Pwede ba kitang patuloy na mahalin?
Dialogue: 0,1:06:56.29,1:06:58.42,pangkalahatang teksto,,0,0,0,,Sa madaling salita, handa akong ipagsapalaran ang lahat,
Dialogue: 0,1:06:59.38,1:07:01.17,general text,,0,0,0,,para tayo ay magkasama
Dialogue: 0,1:07:02.55,1:07:04.17,general text,,0,0,0,,Gagawin ko
Dialogue: 0,1:07:04.72,1:07:09.18,general text,,0,0,0,,Gawin mo rin, manatili sa iyong pag-amin
Dialogue: 0,1:07:10.72,1:07:12.31,pangkalahatang teksto,,0,0,0,,Mahalin mo ako hanggang kamatayan
Dialogue: 0,1:07:51.81,1:07:55.73,preview,,0,0,0,,Kung mahal ni Uk ang isang tao ay hindi dapat,
Dialogue: 0,1:07:55.81,1:07:57.23,preview,,0,0,0,,ano ang gagawin mo?
Dialogue: 0,1:07:57.31,1:08:01.27,preview,,0,0,0,,Kung kasama kita, kailangan kong siguraduhin na akin ka
Dialogue: 0,1:08:01.36,1:08:03.23,preview,,0,0,0,,How dare you disgrace Jinyeowon?
Dialogue: 0,1:08:03.98,1:08:05.03,preview,,0,0,0,,- Salty\N- Dalawang bota - isang pares
Dialogue: 0,1:08:05.11,1:08:06.40,preview,,0,0,0,,Bakit hindi ka nagpakasal?
Dialogue: 0,1:08:06.49,1:08:08.24,preview,,0,0,0,,Naghahanap ako ng shaman Choi
Dialogue: 0,1:08:08.32,1:08:11.16,preview,,0,0,0,,Kung ang shaman ay tinugis ng mga magician ni Jeonbugwan...
Dialogue: 0,1:08:11.24,1:08:14.08,preview,,0,0,0,,Hinahanap mo ba siya dahil nagtatanim siya ng sama ng loob sa iyong ama?
Dialogue: 0,1:08:14.16,1:08:16.87,preview,,0,0,0,,Kung dumating siya, report agad
Dialogue: 0,1:08:16.96,1:08:18.54,preview,,0,0,0,,Kahit patay, ito si Gwigu
Dialogue: 0,1:08:18.62,1:08:20.50,preview,,0,0,0,,Magkunwaring hindi mo alam, di ba?
Dialogue: 0,1:08:21.17,1:08:23.75,preview,,0,0,0,,Naging mahirap para sa iyo, tama ba?
Dialogue: 0,1:08:23.84,1:08:26.17,preview,,0,0,0,,Kung kailangan mong gumuhit ng espada at ituro ito sa isang tao,
Dialogue: 0,1:08:26.26,1:08:28.55,preview,,0,0,0,,hayaan mo muna ako
Dialogue: 0,0:02:55.14,0:02:57.14,nicks,,0,0,0,,

