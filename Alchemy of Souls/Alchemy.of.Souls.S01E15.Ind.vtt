Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, Alina
Dialog: 0,0:01:00.80,0:01:03.72,kenangan,,0,0,0,,Tuan, ini aku, Yom
Dialog: 0,0:01:03.80,0:01:06.93,kenangan,,0,0,0,,Kemarin adalah seratus hari sejak kamu bermeditasi
Dialog: 0,0:01:07.01,0:01:08.31,kenangan,,0,0,0,,Saatnya keluar
Dialog: 0,0:01:13.98,0:01:15.10,kenangan,,0,0,0,,Guru
Dialog: 0,0:01:20.69,0:01:21.94,kenangan,,0,0,0,,Guru
Dialog: 0,0:01:25.70,0:01:26.74,kenangan,,0,0,0,,Guru...
Dialog: 0,0:01:27.87,0:01:28.78,kenangan,,0,0,0,,Guru
Dialog: 0,0:01:30.95,0:01:31.87,kenangan,,0,0,0,,Guru!
Dialog: 0,0:01:32.71,0:01:33.79,kenangan,,0,0,0,,Guru...
Dialog: 0,0:01:35.67,0:01:36.58,kenangan,,0,0,0,,Guru!
Dialogue: 0,0:01:42.55,0:01:45.55,kenangan miring,,0,0,0,,- Kasihan\N- Kasihan
Dialog: 0,0:01:45.63,0:01:48.10,kenangan miring,,0,0,0,,- Surga suci\N- Luar biasa
Dialog: 0,0:01:48.18,0:01:50.81,kenangan miring,,0,0,0,,- Dia pasti mati beku\N- Sepertinya begitu
Dialog: 0,0:01:50.89,0:01:53.64,kenangan miring,,0,0,0,,- Aku kasihan sekali padanya\N- Kasihan sayang
Dialog: 0,0:01:53.73,0:01:54.94,kenangan miring,,0,0,0,,- Sayang sekali\N- Bagaimana bisa?
Dialogue: 0,0:01:55.02,0:01:56.69,kenangan,,0,0,0,,Apa yang terjadi disini? Apa ini?
Dialog: 0,0:01:56.77,0:01:58.94,kenangan miring,,0,0,0,,Seorang anak tunawisma meninggal
Dialogue: 0,0:01:59.02,0:02:01.61,kenangan,,0,0,0,,Dia masih anak-anak. Saya merasa kasihan padanya
Dialogue: 0,0:02:01.69,0:02:04.74,kenangan miring,,0,0,0,,Bagaimana ini bisa terjadi?
Dialog: 0,0:02:26.51,0:02:29.09,di belakang layar,,0,0,0,,Seperti yang selalu kau inginkan,
Dialog: 0,0:02:30.35,0:02:33.35,di belakang layar,,0,0,0,,Aku diam-diam akan mengucapkan selamat tinggal padamu, tuan
Dialogue: 0,0:02:40.81,0:02:42.98,kenangan miring,,0,0,0,,aku kasihan sekali padanya
Dialog: 0,0:02:43.69,0:02:45.74,kenangan miring,,0,0,0,,Sepertinya dia yatim piatu
Dialog: 0,0:02:45.82,0:02:47.32,kenangan,,0,0,0,,Haruskah kita mengadakan pemakaman untuknya?
Dialog: 0,0:02:47.40,0:02:48.57,kenangan,,0,0,0,,- Ya\N- Ayo
Dialogue: 0,0:02:48.66,0:02:49.70,kenangan miring,,0,0,0,,Mungkin kremasi...
Dialog: 0,0:02:49.78,0:02:51.95,kenangan miring,,0,0,0,,dan menebarkan abunya ke Danau Gyeongcheongdaeho?
Dialog: 0,0:02:53.49,0:02:54.95,kenangan miring,,0,0,0,,Wah...
Dialog: 0,0:02:55.04,0:02:56.00,kenangan,,0,0,0,,apakah kamu baik-baik saja?
Dialog: 0,0:02:58.62,0:03:00.50,kenangan miring,,0,0,0,,- Itu dia...\N- Bagaimana...
Dialog: 0,0:03:00.58,0:03:03.63,kenangan,,0,0,0,,- Kemana dia pergi?\N- Kamu mau ke mana?
Dialog: 0,0:03:11.85,0:03:13.35,kenangan,,0,0,0,,Berhenti!
Dialog: 0,0:03:24.69,0:03:25.78,kenangan miring,,0,0,0,,Anak
Dialog: 0,0:03:25.86,0:03:28.20,kenangan,,0,0,0,,Apakah kamu baru saja menyuruhku berhenti?
Dialog: 0,0:03:30.32,0:03:31.45,kenangan,,0,0,0,,Bodoh sekali!
Dialog: 0,0:03:32.12,0:03:34.62,kenangan,,0,0,0,,Aku tidak percaya kamu sudah membakar tubuhku
Dialog: 0,0:03:37.16,0:03:39.16,kenangan,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:03:41.17,0:03:44.59,kenangan,,0,0,0,,Jika aku datang terlambat, kamu pasti sudah membakar tongkatku juga
Dialog: 0,0:03:45.71,0:03:47.26,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:49.97,0:03:51.14,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:51.76,0:03:54.43,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:55.47,0:03:57.52,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:04:04.44,0:04:05.94,kenangan,,0,0,0,,M-master?
Dialog: 0,0:04:06.02,0:04:08.49,kenangan,,0,0,0,,Aku hanya meninggalkan tubuhku untuk sementara,
Dialog: 0,0:04:08.57,0:04:10.36,kenangan,,0,0,0,,untuk memeriksa apakah aku sudah sampai di Hwansu
Dialog: 0,0:04:10.45,0:04:12.82,kenangan,,0,0,0,,setelah seratus hari meditasi
Dialog: 0,0:04:13.41,0:04:17.20,kenangan,,0,0,0,,Tapi kulihat tubuhku terbakar, jadi aku segera pindah ke tempat lain
Dialog: 0,0:04:18.29,0:04:19.50,kenangan,,0,0,0,,Tapi sudah terlambat
Dialog: 0,0:04:22.04,0:04:25.84,kenangan,,0,0,0,,Jadi kamu ada di dalam tubuh anak ini?
Dialog: 0,0:04:25.92,0:04:28.13,kenangan,,0,0,0,,Benarkah itu kamu, tuan?
Dialog: 0,0:04:28.71,0:04:29.55,kenangan,,0,0,0,,Tepat sekali
Dialog: 0,0:04:29.63,0:04:32.63,kenangan,,0,0,0,,Saya Lee Chul, tuanmu
Dialog: 0,0:04:33.22,0:04:34.05,kenangan,,0,0,0,,Oh...
Dialog: 0,0:04:35.93,0:04:37.56,kenangan,,0,0,0,,Guru
Dialog: 0,0:04:38.81,0:04:39.81,kenangan,,0,0,0,,Guru
Dialog: 0,0:04:50.69,0:04:52.95,teks umum,,0,0,0,,Saya pengembara,
Dialog: 0,0:05:03.21,0:05:04.29,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:05:04.79,0:05:08.63,teks umum,,0,0,0,,Tidakkah kamu memanggilku untuk mencari pengembara itu?
Dialog: 0,0:05:09.25,0:05:10.51,teks umum,,0,0,0,,Itulah yang akan kulakukan
Dialog: 0,0:05:11.30,0:05:12.38,teks umum,,0,0,0,,Saya bisa
Dialog: 0,0:05:12.47,0:05:14.38,teks umum,,0,0,0,,kenali pengembara
Dialog: 0,0:05:48.75,0:05:50.88,teks umum,,0,0,0,,Apakah ada orang lain yang melihat wajahmu?
Dialog: 0,0:05:55.34,0:05:56.34,kenangan,,0,0,0,,Ini payung
Dialog: 0,0:05:57.43,0:05:58.93,kenangan,,0,0,0,,Dapat digunakan sebagai tongkat
Dialog: 0,0:06:01.68,0:06:02.68,teks umum,,0,0,0,,Tidak
Dialog: 0,0:06:02.77,0:06:06.02,teks umum,,0,0,0,,Di ibukota tidak ada orang lain yang tahu kalau aku bisa melihat
Dialog: 0,0:06:07.19,0:06:10.23,teks umum,,0,0,0,,Orang-orang akan mengira bandit bertempur di sini
Dialog: 0,0:06:18.78,0:06:20.74,teks umum,,0,0,0,,Kamu seharusnya berhenti mencariku
Dialog: 0,0:06:25.62,0:06:26.58,kenangan,,0,0,0,,Jadi aku
Dialog: 0,0:06:29.84,0:06:31.42,kenangan,,0,0,0,,Jadi Yi, apakah itu kamu?
Dialog: 0,0:06:31.50,0:06:33.05,kenangan,,0,0,0,,Saya Kim dari desa Sari
Dialog: 0,0:06:34.34,0:06:35.55,kenangan,,0,0,0,,Kamu melakukan kesalahan
Dialog: 0,0:06:43.14,0:06:45.98,kenangan,,0,0,0,,Kami hampir tidak mengenal satu sama lain. Dia hampir tidak mengenalku
Dialog: 0,0:06:46.06,0:06:47.10,kenangan,,0,0,0,,Tentang pria itu
Dialog: 0,0:06:47.73,0:06:49.15,kenangan,,0,0,0,,perlu dijaga
Dialog: 0,0:07:00.82,0:07:02.87,teks umum,,0,0,0,,Tidak perlu membunuhnya
Dialog: 0,0:07:02.95,0:07:05.50,teks umum,,0,0,0,,Jika dia pergi ke Sari, kita tidak akan pernah bertemu lagi
Dialog: 0,0:07:05.58,0:07:06.66,teks umum,,0,0,0,,Tapi kamu bertemu
Dialog: 0,0:07:08.58,0:07:09.67,teks umum,,0,0,0,,Desa Sari?
Dialog: 0,0:07:12.34,0:07:13.88,teks umum,,0,0,0,,Di situkah kamu tinggal?
Dialog: 0,0:07:17.01,0:07:18.18,teks umum,,0,0,0,,Saya bersembunyi di sana
Dialog: 0,0:07:19.18,0:07:22.39,teks umum,,0,0,0,,Tersembunyi dari preman ini
Dialog: 0,0:07:24.06,0:07:27.68,teks umum,,0,0,0,,Apakah masih ada orang yang bisa mengenalimu?
Dialog: 0,0:07:28.69,0:07:31.73,teks umum,,0,0,0,,Aku tidak mendekati siapa pun agar mereka tidak mengenaliku
Dialog: 0,0:07:32.94,0:07:34.48,teks umum,,0,0,0,,Saya adalah seorang pencuri di sana
Dialog: 0,0:07:34.57,0:07:36.23,teks umum,,0,0,0,,- Apa ini?\N- Uang
Dialog: 0,0:07:36.32,0:07:39.49,teks umum,,0,0,0,,Akan mencurigakan jika uangnya tidak hilang
Dialog: 0,0:07:40.95,0:07:42.16,teks umum,,0,0,0,,Simpan sendiri
Dialog: 0,0:07:56.80,0:07:59.26,teks umum,,0,0,0,,Saya tidak ingin menyakiti siapa pun dari desa Sari
Dialog: 0,0:08:11.77,0:08:13.52,di belakang layar,,0,0,0,,Moo Dok di ibu kota
Dialog: 0,0:08:13.61,0:08:15.98,di luar layar,,0,0,0,,Jika kita bertemu, apakah kita harus membunuhnya?
Dialog: 0,0:08:18.94,0:08:21.20,teks umum,,0,0,0,,Pedagang Kim dari Desa Sari ada di sini?
Dialog: 0,0:08:21.78,0:08:23.78,teks umum,,0,0,0,,Ya, dia baru saja tiba
Dialog: 0,0:08:23.87,0:08:25.91,teks umum,,0,0,0,,Dia ada di ruangan terakhir di lantai dua
Dialog: 0,0:08:56.98,0:08:57.98,miring,,0,0,0,,Nyonya?
Dialog: 0,0:09:05.62,0:09:09.70,teks umum,,0,0,0,,Apa yang membawamu ke tempat ini?
Dialog: 0,0:09:09.79,0:09:12.25,teks umum,,0,0,0,,Bukan urusanmu. Anda belum melihat saya di sini
Dialog: 0,0:09:13.46,0:09:14.83,teks umum,,0,0,0,,Nyonya, apakah Anda benar-benar sedang bermain-main
Dialog: 0,0:09:17.46,0:09:18.50,teks umum,,0,0,0,,dalam perjudian?
Dialog: 0,0:09:18.59,0:09:20.46,teks umum,,0,0,0,,Apa? Berjudi?
Dialog: 0,0:09:21.13,0:09:24.09,teks umum,,0,0,0,,Kamu menganggapku untuk siapa? Apakah menurut Anda saya termasuk orang yang bodoh?
Dialog: 0,0:09:24.18,0:09:25.72,teks umum,,0,0,0,,Tidak, tentu saja
Dialog: 0,0:09:26.72,0:09:29.51,teks umum,,0,0,0,,Tapi kamu berbohong padaku saat kamu bilang gioknya tidak rusak
Dialog: 0,0:09:29.60,0:09:33.52,teks umum,,0,0,0,,Mengingat kemampuanmu untuk berbohong tanpa sedikit pun hati nurani,
Dialog: 0,0:09:34.14,0:09:36.19,teks umum,,0,0,0,,Kupikir mungkin kamu punya bakat berjudi
Dialog: 0,0:09:40.53,0:09:42.24,teks umum,,0,0,0,,Saya datang ke pedagang untuk membeli tiket
Dialog: 0,0:09:43.40,0:09:45.32,teks umum,,0,0,0,,Tiket pertunjukan terjual habis
Dialog: 0,0:09:45.41,0:09:46.74,teks umum,,0,0,0,,Itulah sebabnya aku datang ke sini
Dialog: 0,0:09:46.82,0:09:48.78,prasasti,,0,0,0,,Tiket masuk\N Magi dari Seochon
Dialog: 0,0:09:49.70,0:09:52.50,teks umum,,0,0,0,,- Kamu punya dua tiket\N- Aku berangkat bersama ibuku
Dialog: 0,0:09:52.58,0:09:54.33,teks umum,,0,0,0,,Jangan beritahu siapa pun bahwa kamu melihatku di sini
Dialog: 0,0:09:54.41,0:09:56.79,teks umum,,0,0,0,,Saya tidak ingin ada kesalahpahaman
Dialog: 0,0:09:56.88,0:09:58.17,teks umum,,0,0,0,,Siapa tahu
Dialog: 0,0:09:58.25,0:10:00.80,teks umum,,0,0,0,,Soalnya, aku tidak pandai berbohong seperti kamu
Dialog: 0,0:10:00.88,0:10:03.42,teks umum,,0,0,0,,Jika ada yang bertanya, aku tidak yakin aku bisa berbohong
Dialog: 0,0:10:04.76,0:10:07.64,teks umum,,0,0,0,,Tapi demi kamu, aku akan mencoba
Dialog: 0,0:10:12.35,0:10:14.14,miring,,0,0,0,,Aku kebetulan bertemu dengannya di sini
Dialog: 0,0:10:27.32,0:10:28.99,teks umum,,0,0,0,,Mengapa kepala Sosnovy Bor ada di sini?
Dialog: 0,0:10:32.33,0:10:36.29,teks umum,,0,0,0,,Kuharap dia tidak di sini untuk membeli tiket
Dialog: 0,0:10:38.42,0:10:41.25,teks umum,,0,0,0,,Kalau begitu aku tidak bisa pergi ke pertunjukan bersama Dong Gu
Dialog: 0,0:11:22.21,0:11:23.50,teks umum,,0,0,0,,Itu kamu
Dialog: 0,0:11:24.63,0:11:26.17,teks umum,,0,0,0,,bunuh dia
Dialog: 0,0:11:28.01,0:11:29.22,teks umum,,0,0,0,,Itu bukan aku
Dialogue: 0,0:11:29.97,0:11:31.51,teks umum,,0,0,0,,Kenapa kamu membunuhnya?
Dialog: 0,0:11:31.60,0:11:32.97,teks umum,,0,0,0,,Ini benar-benar bukan aku
Dialog: 0,0:11:33.05,0:11:35.02,teks umum,,0,0,0,,Dia sudah mati saat aku tiba
Dialog: 0,0:11:40.02,0:11:41.52,teks umum,,0,0,0,,Dia terbunuh belum lama ini
Dialog: 0,0:11:42.27,0:11:43.36,miring,,0,0,0,,Dia terbunuh dengan satu pukulan
Dialog: 0,0:11:44.57,0:11:45.94,teks umum,,0,0,0,,Pendekar pedang terampil
Dialog: 0,0:11:46.61,0:11:49.07,teks umum,,0,0,0,,Aku bersumpah itu bukan aku
Dialog: 0,0:11:49.95,0:11:51.87,teks umum,,0,0,0,,Aku bahkan tidak punya pedang
Dialog: 0,0:12:12.84,0:12:14.80,teks umum,,0,0,0,,Saya pikir satu orang membunuh mereka
Dialogue: 0,0:12:16.10,0:12:17.39,teks umum,,0,0,0,,Siapakah orang-orang ini?
Dialog: 0,0:12:17.47,0:12:22.44,teks umum,,0,0,0,,Ini adalah preman yang tiba di ibukota baru-baru ini
Dialog: 0,0:12:22.52,0:12:24.52,teks umum,,0,0,0,,Mereka telah tiba
Dialog: 0,0:12:24.61,0:12:28.57,teks umum,,0,0,0,,dengan pedagang Kim dari desa Sari?
Dialog: 0,0:12:28.65,0:12:29.95,teks umum,,0,0,0,,Tidak
Dialog: 0,0:12:30.03,0:12:34.57,teks umum,,0,0,0,,Tapi aku ingat bagaimana preman itu memulai perkelahian dengannya beberapa hari yang lalu
Dialog: 0,0:12:36.08,0:12:40.96,teks umum,,0,0,0,,Mereka ingin tahu dimana letak penipu yang tinggal di Sari itu berada
Dialogue: 0,0:12:41.04,0:12:42.62,teks umum,,0,0,0,,Sari Penipuan?
Dialog: 0,0:12:42.71,0:12:44.50,teks umum,,0,0,0,,Mungkin ini Moo Dok?
Dialog: 0,0:12:46.50,0:12:48.76,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,0:12:53.47,0:12:55.14,teks umum,,0,0,0,,Dia ada di sini
Dialogue: 0,0:12:57.68,0:12:58.97,teks umum,,0,0,0,,Dia kabur
Dialog: 0,0:13:09.61,0:13:10.82,di belakang layar,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:13:11.82,0:13:13.41,di luar layar,,0,0,0,,Mayat apakah ini?
Dialog: 0,0:13:14.24,0:13:18.83,kenangan,,0,0,0,,Mereka ingin tahu keberadaan penipu yang tinggal di Sari itu
Dialogue: 0,0:13:19.79,0:13:21.16,sulih suara,,0,0,0,,Mungkinkah maksudnya aku?
Dialog: 0,0:13:22.29,0:13:25.33,di balik layar,,0,0,0,,Kehidupan seperti apa yang dijalani Moo Deok?
Dialog: 0,0:13:25.92,0:13:28.55,kenangan,,0,0,0,,Apakah kamu pernah bertemu So Yi?
Dialog: 0,0:13:28.63,0:13:30.80,kenangan,,0,0,0,,Aku penasaran apa yang dia lakukan kali ini
Dialog: 0,0:13:30.88,0:13:32.67,kenangan,,0,0,0,,Jangan main-main dengannya
Dialog: 0,0:13:34.84,0:13:35.89,teks umum,,0,0,0,,Jadi saya...
Dialog: 0,0:13:37.68,0:13:39.10,teks umum,,0,0,0,,Siapa So Yi?
Dialog: 0,0:13:42.02,0:13:44.14,teks umum,,0,0,0,,Aku sendiri belum pernah melihatnya
Dialogue: 0,0:13:44.85,0:13:47.94,teks umum,,0,0,0,,Tapi dia bertengkar dengan semua penjaga, dan bahkan menampar salah satu wajahnya
Dialog: 0,0:13:48.02,0:13:49.94,miring,,0,0,0,,Aku yakin mereka ingat wajahnya
Dialog: 0,0:13:50.86,0:13:54.03,teks umum,,0,0,0,,Nyonya, tidak ada satu pun penjaga yang datang hari ini
Dialog: 0,0:13:54.11,0:13:56.16,miring,,0,0,0,,- Keduanya tidak datang?\N- Ya
Dialog: 0,0:13:56.24,0:13:58.74,teks umum,,0,0,0,,Aneh. Mereka tidak pernah bolos kerja
Dialog: 0,0:14:04.54,0:14:07.25,teks umum,,0,0,0,,Maaf. Kita seharusnya tidak memperlakukan penyihir seperti itu
Dialog: 0,0:14:07.75,0:14:10.38,teks umum,,0,0,0,,Tetapi apakah ini benar-benar diperlukan?
Dialog: 0,0:14:10.46,0:14:11.88,miring,,0,0,0,,"Magu"?
Dialogue: 0,0:14:11.96,0:14:13.38,teks umum,,0,0,0,,Apakah kamu berbohong tentang menjadi seorang penyihir?
Dialog: 0,0:14:14.88,0:14:16.09,teks umum,,0,0,0,,Aku akan segera menjadi dia
Dialog: 0,0:14:16.68,0:14:20.68,teks umum,,0,0,0,,Dan bahkan lebih kuat darimu
Dialogue: 0,0:14:23.06,0:14:26.48,teks umum,,0,0,0,,Beraninya orang palsu bicara seperti itu padaku?
Dialog: 0,0:14:26.98,0:14:28.98,teks umum,,0,0,0,,Aku akan merendahkanmu,
Dialog: 0,0:14:29.94,0:14:32.78,teks umum,,0,0,0,,dan Anda akan memanggil saya dengan hormat. Bukan?
Dialog: 0,0:14:39.74,0:14:41.24,teks umum,,0,0,0,,Kejar dia
Dialog: 0,0:14:41.33,0:14:42.74,teks umum,,0,0,0,,Ini tugasmu
Dialog: 0,0:14:49.67,0:14:53.09,teks umum,,0,0,0,,Ada seorang gadis bernama Moo Deok dari desa Sari di Jwiseonru?
Dialog: 0,0:14:53.17,0:14:56.51,teks umum,,0,0,0,,Ya, saya kenal dia. Apakah kamu mencarinya malam itu?
Dialog: 0,0:14:57.47,0:15:00.64,teks umum,,0,0,0,,Aku ingin meminta bantuannya dan mengembalikan sesuatu
Dialog: 0,0:15:00.72,0:15:02.76,teks umum,,0,0,0,,Moo Deok tidak ada di Jwiseonru
Dialog: 0,0:15:02.85,0:15:06.02,teks umum,,0,0,0,,Dia adalah pembantu di keluarga Jang, ini adalah keluarga Gwangju Jeonbugwan
Dialog: 0,0:15:06.68,0:15:08.06,teks umum,,0,0,0,,Apakah dia seorang pembantu?
Dialog: 0,0:15:09.35,0:15:11.31,teks umum,,0,0,0,,Sepertinya dia benar-benar bisa melihat sekarang
Dialog: 0,0:15:12.19,0:15:14.28,teks umum,,0,0,0,,Dia mungkin juga membodohimu
Dialogue: 0,0:15:14.36,0:15:16.03,teks umum,,0,0,0,,Mereka membawanya ke Chwisonra, mereka mengira dia buta,
Dialog: 0,0:15:16.11,0:15:18.53,teks umum,,0,0,0,,Tapi semua orang terkejut saat dia membuka matanya dan lari
Dialog: 0,0:15:20.12,0:15:22.12,teks umum,,0,0,0,,Tapi dia bukan penipu seperti saya
Dialog: 0,0:15:23.24,0:15:24.74,teks umum,,0,0,0,,Bagaimana dia bisa melihat?
Dialog: 0,0:15:28.46,0:15:30.25,teks umum,,0,0,0,,Tolong jangan bunuh aku
Dialog: 0,0:15:31.17,0:15:32.38,teks umum,,0,0,0,,maafkan aku
Dialog: 0,0:15:32.96,0:15:35.17,teks umum,,0,0,0,,Kamu melihat wajahku, aku tidak bisa membiarkanmu hidup
Dialog: 0,0:15:36.38,0:15:37.59,teks umum,,0,0,0,,Tolong...
Dialog: 0,0:16:01.74,0:16:05.29,teks umum,,0,0,0,,Jika dia bisa melihat, berarti dia bisa mengenaliku
Dialogue: 0,0:16:07.66,0:16:09.58,teks umum,,0,0,0,,Apakah dia pembantu keluarga Chan?
Dialog: 0,0:16:11.37,0:16:12.92,teks umum,,0,0,0,,Aku harus mengunjunginya
Dialog: 0,0:16:15.50,0:16:17.30,teks umum,,0,0,0,,Apakah Mu Dok melakukan pembunuhan?
Dialog: 0,0:16:17.88,0:16:21.05,teks umum,,0,0,0,,Beberapa orang terbunuh di penginapan
Dialog: 0,0:16:21.13,0:16:23.80,teks umum,,0,0,0,,Moo Dok ada disana
Dialog: 0,0:16:23.89,0:16:27.64,teks umum,,0,0,0,,Tapi Moo Deok tidak cukup kuat untuk membunuh seseorang
Dialog: 0,0:16:27.72,0:16:29.60,teks umum,,0,0,0,,Terutama beberapa pria
Dialog: 0,0:16:29.68,0:16:31.90,teks umum,,0,0,0,,Itu dilakukan oleh pendekar pedang yang terampil
Dialog: 0,0:16:32.48,0:16:33.90,teks umum,,0,0,0,,Jika bukan dia,
Dialog: 0,0:16:34.56,0:16:36.61,teks umum,,0,0,0,,pesulap pasti membantunya
Dialog: 0,0:16:38.11,0:16:39.28,teks umum,,0,0,0,,Jangan bilang padaku,
Dialog: 0,0:16:40.03,0:16:41.95,teks umum,,0,0,0,,bahwa kamu mencurigai tuan kami
Dialog: 0,0:16:43.07,0:16:44.32,teks umum,,0,0,0,,Tidak
Dialog: 0,0:16:44.41,0:16:47.87,teks umum,,0,0,0,,Wook kini berada di istana bersama Guru Li
Dialog: 0,0:16:49.79,0:16:51.37,teks umum,,0,0,0,,Syukurlah
Dialog: 0,0:16:51.46,0:16:53.88,teks umum,,0,0,0,,Tidak mungkin Moo Deok
Dialog: 0,0:16:53.96,0:16:56.21,teks umum,,0,0,0,,Dia tidak punya alasan untuk membunuh
Dialog: 0,0:16:56.29,0:16:57.46,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,0:16:57.55,0:17:00.92,teks umum,,0,0,0,,seberapa baik kamu mengenal Moo Deok?
Dialog: 0,0:17:02.51,0:17:03.80,teks umum,,0,0,0,,Kau tahu,
Dialog: 0,0:17:03.89,0:17:09.02,teks umum,,0,0,0,,kehidupan seperti apa yang dia jalani sebelum dia mulai bekerja di sini?
Dialog: 0,0:17:11.06,0:17:11.94,teks umum,,0,0,0,,Apa?
Dialog: 0,0:17:12.02,0:17:13.73,teks umum,,0,0,0,,Terbunuh -
Dialog: 0,0:17:13.81,0:17:16.44,teks umum,,0,0,0,,pria yang kutanyakan tentang masa lalu Moo Deok
Dialog: 0,0:17:18.15,0:17:20.11,teks umum,,0,0,0,,Bandit yang mungkin mencarinya,
Dialog: 0,0:17:20.99,0:17:22.61,teks umum,,0,0,0,,juga mati
Dialog: 0,0:17:25.49,0:17:28.24,teks umum,,0,0,0,,Jelas, dia akan dicurigai,
Dialog: 0,0:17:28.33,0:17:30.87,teks umum,,0,0,0,,tapi dia malah kabur bukannya membuktikan dia tidak bersalah
Dialog: 0,0:17:31.37,0:17:32.50,teks umum,,0,0,0,,Apa yang saya yakini -
Dialog: 0,0:17:32.58,0:17:37.21,teks umum,,0,0,0,,Moo Dok menyembunyikan sesuatu,
Dialog: 0,0:17:37.29,0:17:40.71,teks umum,,0,0,0,,apa yang tidak bisa diungkapkan
Dialog: 0,0:17:50.77,0:17:53.27,teks umum,,0,0,0,,Para penjaga tinggal di sana
Dialog: 0,0:17:53.35,0:17:55.19,teks umum,,0,0,0,,Akan lebih cepat
Dialog: 0,0:17:55.27,0:17:58.44,teks umum,,0,0,0,,gambar potretnya dan cari sendiri
Dialog: 0,0:17:58.52,0:18:00.11,teks umum,,0,0,0,,Saya tidak tahu seperti apa rupanya
Dialog: 0,0:18:00.19,0:18:03.03,teks umum,,0,0,0,,- Aku bertemu dengannya saat aku masih buta\N- Kukira kamu tidak buta
Dialog: 0,0:18:04.28,0:18:08.32,teks umum,,0,0,0,,Kamu bilang kamu buta, lalu kamu bilang kamu tidak buta
Dialog: 0,0:18:09.53,0:18:12.45,teks umum,,0,0,0,,Aku tidak tahu apa yang terjadi di sana, tapi hidupmu jelas bukan gula
Dialog: 0,0:18:14.75,0:18:18.00,teks umum,,0,0,0,,Jadi kamu tidak mengenalnya secara langsung, tapi dia mengenalmu?
Dialogue: 0,0:18:18.96,0:18:21.17,teks umum,,0,0,0,,Mungkin berbahaya mencarinya?
Dialogue: 0,0:18:21.25,0:18:23.97,teks umum,,0,0,0,,Bagaimana jika dia membunuh orang-orang itu?
Dialog: 0,0:18:24.05,0:18:25.55,teks umum,,0,0,0,,Dan tiba-tiba itu akan merugikanmu
Dialog: 0,0:18:26.88,0:18:29.72,teks umum,,0,0,0,,Lebih berbahaya jika dicurigai sebagai pemimpin
Dialog: 0,0:18:32.60,0:18:35.23,teks umum,,0,0,0,,Kamu juga bisa terluka, tapi kamu membayar pedagangnya
Dialog: 0,0:18:35.31,0:18:36.56,teks umum,,0,0,0,,Itu?
Dialog: 0,0:18:37.56,0:18:39.73,teks umum,,0,0,0,,Saya tidak mengerti maksud Anda
Dialog: 0,0:18:40.52,0:18:41.57,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:18:42.44,0:18:44.74,teks umum,,0,0,0,,Berpura-pura tidak tahu apa-apa
Dialog: 0,0:18:45.70,0:18:47.32,miring,,0,0,0,,Seseorang meninggal!
Dialog: 0,0:19:06.88,0:19:09.01,miring,,0,0,0,,Penjaga Li dan Penjaga Chan!
Dialog: 0,0:19:17.06,0:19:20.56,teks umum,,0,0,0,,Hwangsu akan memberikan kekuatan yang luar biasa
Dialog: 0,0:19:21.23,0:19:24.86,teks umum,,0,0,0,,Saya pikir semua pengembara adalah monster
Dialog: 0,0:19:25.49,0:19:27.57,teks umum,,0,0,0,,Tetapi kamu telah memperoleh masa muda dan keabadian
Dialog: 0,0:19:29.11,0:19:31.16,teks umum,,0,0,0,,Sudah jelas sekarang,
Dialog: 0,0:19:31.24,0:19:33.87,teks umum,,0,0,0,,mengapa semua orang menginginkan batu es untuk alkimia
Dialogue: 0,0:19:34.62,0:19:37.41,teks umum,,0,0,0,,Semua orang sangat menginginkannya, mereka bertarung selamanya
Dialog: 0,0:19:37.50,0:19:39.29,teks umum,,0,0,0,,Oleh karena itu, sihir ini dilarang
Dialog: 0,0:19:39.37,0:19:40.75,teks umum,,0,0,0,,Oke, Guru Li
Dialog: 0,0:19:41.67,0:19:43.59,teks umum,,0,0,0,,Anda dapat mengenalinya
Dialog: 0,0:19:43.67,0:19:45.09,teks umum,,0,0,0,,Lihat sekeliling
Dialog: 0,0:19:45.63,0:19:48.51,teks umum,,0,0,0,,Apakah ada pengembara di istana?
Dialog: 0,0:20:02.31,0:20:05.19,teks umum,,0,0,0,,Hanya melihat seseorang saja tidak cukup
Dialog: 0,0:20:05.27,0:20:07.44,teks umum,,0,0,0,,Jika tanda biru tidak terlihat
Dialog: 0,0:20:07.53,0:20:09.45,teks umum,,0,0,0,,atau tanda-tanda kebiadaban,
Dialog: 0,0:20:09.53,0:20:11.61,teks umum,,0,0,0,,mereka tidak bisa dibedakan dengan orang biasa
Dialog: 0,0:20:12.53,0:20:15.33,teks umum,,0,0,0,,Lalu bagaimana cara mengenalinya?
Dialogue: 0,0:20:16.24,0:20:18.20,teks umum,,0,0,0,,Takut ketahuan
Dialogue: 0,0:20:20.29,0:20:22.46,teks umum,,0,0,0,,Takut membatu
Dialogue: 0,0:20:26.67,0:20:28.46,teks umum,,0,0,0,,Kita perlu menghilangkan rasa takut ini
Dialogue: 0,0:20:29.05,0:20:31.84,teks umum,,0,0,0,,Jadi kamu menanamkan rasa takut pada mereka?
Dialog: 0,0:20:31.93,0:20:33.72,teks umum,,0,0,0,,Maaf jika aku mengecewakanmu
Dialog: 0,0:20:34.30,0:20:35.35,teks umum,,0,0,0,,Sebagai gantinya
Dialog: 0,0:20:36.64,0:20:38.81,teks umum,,0,0,0,,Aku akan memberimu hadiah
Dialog: 0,0:20:38.89,0:20:40.94,teks umum,,0,0,0,,Hadiah? Apa yang ada disana?
Dialog: 0,0:20:42.19,0:20:43.35,teks umum,,0,0,0,,Anjing
Dialog: 0,0:20:44.36,0:20:45.31,teks umum,,0,0,0,,Anjing?
Dialog: 0,0:20:45.40,0:20:48.07,teks umum,,0,0,0,,Dia sangat cerdas dan penurut
Dialog: 0,0:20:48.15,0:20:50.36,teks umum,,0,0,0,,Dia sekarang berdiri di gerbang istana
Dialog: 0,0:20:50.45,0:20:52.49,teks umum,,0,0,0,,Bolehkah saya mengutipnya?
Dialog: 0,0:20:52.57,0:20:54.70,teks umum,,0,0,0,,Karena ini adalah hadiah, maka tentu saja
Dialog: 0,0:20:55.49,0:20:56.66,teks umum,,0,0,0,,Bawa anjingnya
Dialog: 0,0:20:57.58,0:20:58.45,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:20:59.16,0:21:00.83,teks umum,,0,0,0,,Aku ingin kamu membawanya
Dialog: 0,0:21:02.87,0:21:06.34,teks umum,,0,0,0,,Jika kamu berhasil, aku akan membalasmu
Dialogue: 0,0:21:36.62,0:21:39.08,sulih suara,,0,0,0,,Mungkin sebaiknya aku kabur saja bersama Moo Deok?
Dialog: 0,0:21:40.66,0:21:42.71,di belakang layar,,0,0,0,,Maka semua orang akan mengerti
Dialog: 0,0:21:43.75,0:21:47.17, sulih suara,,0,0,0,,Dan sekarang aku lemah dan tidak akan melindungi guruku
Dialogue: 0,0:21:52.17,0:21:54.22, sulih suara,,0,0,0,,Aku ingin tahu apa yang akan Guru Li lakukan?
Dialog: 0,0:22:23.00,0:22:24.21,teks umum,,0,0,0,,Deputi
Dialog: 0,0:22:25.25,0:22:26.62,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:22:30.13,0:22:34.67,teks umum,,0,0,0,,Apakah ini hadiah lembut dari tuan untuk raja?
Dialog: 0,0:22:34.76,0:22:38.47,teks umum,,0,0,0,,Guru Li berkata anjing itu akan mengikutimu
Dialog: 0,0:22:39.05,0:22:40.64,teks umum,,0,0,0,,Tapi hati-hati
Dialog: 0,0:22:41.56,0:22:44.73,teks umum,,0,0,0,,Apa bahayanya membawanya ke istana?
Dialog: 0,0:22:45.31,0:22:46.48,teks umum,,0,0,0,,Ada apa?
Dialog: 0,0:22:48.02,0:22:48.98,teks umum,,0,0,0,,Ini Gwigu
Dialog: 0,0:22:49.77,0:22:51.32,teks umum,,0,0,0,,Dia membawa Gwiga ke istana
Dialog: 0,0:22:52.65,0:22:53.94,teks umum,,0,0,0,,Tapi Gwigu adalah monster
Dialog: 0,0:22:54.86,0:22:56.70,teks umum,,0,0,0,,Bagaimana dia bisa membawanya ke istana?
Dialog: 0,0:22:58.78,0:23:02.20,teks umum,,0,0,0,,Guruku Seo Kyung menggunakan Gwiga
Dialog: 0,0:23:02.29,0:23:05.04,teks umum,,0,0,0,,untuk mencari peninggalan yang diciptakan oleh ilmu hitam
Dialog: 0,0:23:05.12,0:23:07.87,teks umum,,0,0,0,,menggunakan batu es
Dialog: 0,0:23:07.96,0:23:09.67,teks umum,,0,0,0,,Ya, saya dengar
Dialog: 0,0:23:09.75,0:23:12.71,teks umum,,0,0,0,,Tapi saya pikir itu tidak bisa digunakan lagi,
Dialog: 0,0:23:12.80,0:23:14.71,teks umum,,0,0,0,,karena gucinya rusak
Dialog: 0,0:23:14.80,0:23:15.76,teks umum,,0,0,0,,Oleh karena itu
Dialog: 0,0:23:16.63,0:23:20.85,teks umum,,0,0,0,,Aku memindahkan jiwa Gwigu ke dalam tubuh seekor anjing mati
Dialog: 0,0:23:23.14,0:23:24.68,teks umum,,0,0,0,,Anjing yang kubawa,
Dialog: 0,0:23:25.73,0:23:26.98,teks umum,,0,0,0,,ini Gwigu
Dialog: 0,0:23:29.90,0:23:30.94,teks umum,,0,0,0,,Gwigu?
Dialog: 0,0:23:35.48,0:23:36.57,teks umum,,0,0,0,,Apa yang harus kita lakukan?
Dialog: 0,0:23:38.11,0:23:39.95,teks umum,,0,0,0,,Berapa banyak dari kita yang ada di istana?
Dialog: 0,0:23:40.53,0:23:41.70,teks umum,,0,0,0,,Lebih dari sepuluh
Dialog: 0,0:23:42.28,0:23:43.66,teks umum,,0,0,0,,Ditransfer ke Jeonbugwan?
Dialog: 0,0:23:43.74,0:23:46.62,teks umum,,0,0,0,,Mengirim seseorang, mereka akan segera tiba
Dialog: 0,0:24:12.44,0:24:16.82,teks umum,,0,0,0,,Pertemuan ini diadakan untuk membangun perdamaian antara para penyihir dan istana
Dialog: 0,0:24:17.49,0:24:20.82,teks umum,,0,0,0,,Putra Mahkota mengunjungi Sosnovy Bor, dan dia menghormatimu dengan mengundangmu ke sini
Dialog: 0,0:24:20.91,0:24:22.45,teks umum,,0,0,0,,Dan Anda ingin membawanya ke sini
Dialog: 0,0:24:22.53,0:24:24.70,teks umum,,0,0,0,,monster, tanpa meminta izin Yang Mulia?
Dialog: 0,0:24:24.78,0:24:26.79,teks umum,,0,0,0,,Dia memberikan izinnya
Dialog: 0,0:24:26.87,0:24:28.66,teks umum,,0,0,0,,Dan sekarang Gwigu
Dialog: 0,0:24:28.75,0:24:31.46,teks umum,,0,0,0,,bukan monster, karena berbadan anjing biasa
Dialog: 0,0:24:31.54,0:24:34.67,teks umum,,0,0,0,,Jadi, dia tidak akan bisa menyakiti pengembara itu, bahkan jika dia menemukannya?
Dialog: 0,0:24:34.75,0:24:38.26,teks umum,,0,0,0,,Dia akan mulai menggonggong, jadi kita akan mengerti
Dialog: 0,0:24:39.55,0:24:40.59,teks umum,,0,0,0,,Woof
Dialog: 0,0:24:41.80,0:24:42.80,teks umum,,0,0,0,,Woof!
Dialog: 0,0:25:00.57,0:25:01.99,di belakang layar,,0,0,0,,Ini pengembara
Dialog: 0,0:25:02.86,0:25:05.95,di belakang layar,,0,0,0,,Seperti yang kita duga, pengembara di istana
Dialog: 0,0:25:12.46,0:25:13.58,teks umum,,0,0,0,,Suara apa itu?
Dialog: 0,0:25:14.33,0:25:17.55,teks umum,,0,0,0,,Jadi ada pengembara di istanaku?
Dialog: 0,0:25:19.34,0:25:20.38,teks umum,,0,0,0,,Sepertinya begitu
Dialog: 0,0:25:21.09,0:25:23.59,teks umum,,0,0,0,,Lalu kenapa kamu hanya berdiri di sini?
Dialog: 0,0:25:23.68,0:25:26.43,teks umum,,0,0,0,,Pergi dan tangkap dia!
Dialog: 0,0:25:26.51,0:25:29.39,teks umum,,0,0,0,,Seperti yang saya katakan, seekor anjing adalah hadiah
Dialog: 0,0:25:29.47,0:25:32.35,teks umum,,0,0,0,,Saya tinggalkan di sini
Dialog: 0,0:25:32.44,0:25:34.65,teks umum,,0,0,0,,Dengan menggunakannya Anda akan menemukan semua orang
Dialog: 0,0:25:34.73,0:25:36.36,teks umum,,0,0,0,,pengembara di istana
Dialog: 0,0:25:37.19,0:25:38.98,teks umum,,0,0,0,,Bawa dia, kita tidak membutuhkannya
Dialog: 0,0:25:39.61,0:25:42.19,teks umum,,0,0,0,,Beraninya kamu membawa monster ini ke sini?!
Dialog: 0,0:25:42.28,0:25:43.90,teks umum,,0,0,0,,Raja menderita kecemasan
Dialog: 0,0:25:43.99,0:25:46.87,teks umum,,0,0,0,,Apakah kamu mencoba menyakitinya dengan monster ini?
Dialog: 0,0:25:49.24,0:25:52.87,teks umum,,0,0,0,,Ibu, kami sendiri yang mengundang Guru Li ke istana
Dialog: 0,0:25:52.96,0:25:54.67,teks umum,,0,0,0,,Jangan terlibat dalam hal ini
Dialogue: 0,0:25:55.54,0:25:59.13,teks umum,,0,0,0,,Jeonbugwan bertanggung jawab melindungi istana
Dialog: 0,0:25:59.21,0:26:01.46,teks umum,,0,0,0,,Jika ilmu hitam digunakan di istana,
Dialog: 0,0:26:01.55,0:26:03.38,teks umum,,0,0,0,,mereka akan mengetahuinya
Dialog: 0,0:26:03.47,0:26:06.01,teks umum,,0,0,0,,Saya tidak ingin melihat monster dalam tubuh anjing,
Dialog: 0,0:26:06.09,0:26:07.89,teks umum,,0,0,0,,atau orang-orang Sosnovy Bor
Dialog: 0,0:26:08.43,0:26:11.31,teks umum,,0,0,0,,Anda mencoba mempermalukan kami
Dialog: 0,0:26:13.35,0:26:15.23,teks umum,,0,0,0,,Hentikan mereka, Yang Mulia
Dialog: 0,0:26:43.09,0:26:45.67,teks umum,,0,0,0,,Putra Gwangju Jeonbugwan harus melindungi istana,
Dialog: 0,0:26:45.76,0:26:47.72,teks umum,,0,0,0,,dan kamu membawa monster ini ke sini
Dialog: 0,0:26:49.60,0:26:51.68,teks umum,,0,0,0,,Ini adalah hadiah dari Guru Li untuk raja
Dialog: 0,0:26:51.76,0:26:53.31,teks umum,,0,0,0,,Biarkan kami masuk
Dialog: 0,0:26:53.39,0:26:55.73,teks umum,,0,0,0,,Aku diperintahkan untuk membawanya
Dialog: 0,0:27:01.36,0:27:02.36,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:27:02.44,0:27:04.36,teks umum,,0,0,0,,Lalu coba masuk
Dialog: 0,0:27:04.94,0:27:06.82,teks umum,,0,0,0,,Bunuh binatang buas yang memasuki istana ini
Dialog: 0,0:27:09.32,0:27:12.28,kenangan,,0,0,0,,Jika kamu menanganinya, aku akan memberimu hadiah
Dialogue: 0,0:27:12.87,0:27:15.62,sulih suara,,0,0,0,,Jadi dia memintaku untuk membawa anjingnya?
Dialog: 0,0:27:44.07,0:27:45.69,miring,,0,0,0,,Yang Mulia, ini Jin Mu
Dialog: 0,0:27:46.28,0:27:48.90,teks umum,,0,0,0,,Saya akan menyingkirkan orang-orang kurang ajar ini dari Sosnovy Bor
Dialog: 0,0:27:49.45,0:27:52.45,teks umum,,0,0,0,,Kami di sini atas undangannya, dan kami belum selesai berbicara
Dialog: 0,0:27:52.53,0:27:54.58,teks umum,,0,0,0,,Jin Mu, kamu tidak boleh terlibat dalam hal ini
Dialog: 0,0:27:54.66,0:27:56.95,teks umum,,0,0,0,,Beraninya kamu membawa monster ini ke sini tanpa izin?!
Dialog: 0,0:27:57.04,0:27:58.66,teks umum,,0,0,0,,Perilaku macam apa ini?!
Dialog: 0,0:27:58.75,0:27:59.96,teks umum,,0,0,0,,Diam
Dialog: 0,0:28:16.39,0:28:18.68,teks umum,,0,0,0,,Penjaga! Jangan berdiri disana! Hentikan dia!
Dialog: 0,0:28:23.27,0:28:24.40,teks umum,,0,0,0,,Ayah
Dialog: 0,0:28:24.48,0:28:26.07,teks umum,,0,0,0,,Hentikan keduanya
Dialog: 0,0:28:26.15,0:28:28.40,teks umum,,0,0,0,,Jika pertengkaran dimulai, hubungan kita akan berakhir
Dialog: 0,0:28:28.99,0:28:29.95,teks umum,,0,0,0,,Kita harus bertarung!
Dialog: 0,0:28:30.03,0:28:32.95,teks umum,,0,0,0,,Hutan pinus membawa binatang ini ke sini!
Dialog: 0,0:28:33.03,0:28:34.62,teks umum,,0,0,0,,Chonbugwan harus melindungi kita
Dialog: 0,0:28:35.37,0:28:37.20,teks umum,,0,0,0,,- Ayah!\N- Yang Mulia
Dialog: 0,0:28:41.87,0:28:42.96,teks umum,,0,0,0,,Saya perintahkan semuanya...
Dialog: 0,0:28:45.00,0:28:46.09,teks umum,,0,0,0,,berhenti
Dialog: 0,0:29:05.36,0:29:06.65,teks umum,,0,0,0,,Berhenti!
Dialog: 0,0:29:21.33,0:29:22.58,teks umum,,0,0,0,,Guru Li,
Dialog: 0,0:29:22.67,0:29:25.46,teks umum,,0,0,0,,Saya mengundang Anda dengan ramah, apakah perlu menakuti saya seperti itu?
Dialog: 0,0:29:26.13,0:29:27.67,teks umum,,0,0,0,,Maaf
Dialog: 0,0:29:28.63,0:29:32.01,teks umum,,0,0,0,,Yang Mulia, jika batu es itu dibuka segelnya,
Dialog: 0,0:29:32.09,0:29:34.55,teks umum,,0,0,0,,pertumpahan darah akan dimulai lagi
Dialog: 0,0:29:35.14,0:29:36.22,teks umum,,0,0,0,,Batu es?
Dialog: 0,0:29:36.30,0:29:37.97,miring,,0,0,0,,Apakah karena perantau?
Dialog: 0,0:29:38.06,0:29:39.64,teks umum,,0,0,0,,Orang yang digunakan
Dialog: 0,0:29:39.72,0:29:42.73,teks umum,,0,0,0,,reflektor untuk alkimia jiwa setelah Kekacauan Besar
Dialog: 0,0:29:43.44,0:29:47.40,teks umum,,0,0,0,,Rupanya ada yang membuat reflektor lagi
Dialog: 0,0:29:49.32,0:29:52.70,teks umum,,0,0,0,,Batu es dicetak
Dialog: 0,0:29:58.87,0:29:59.91,miring,,0,0,0,,Dan?
Dialog: 0,0:29:59.99,0:30:02.16,teks umum,,0,0,0,,Di mana dia? Di tangan siapa?
Dialog: 0,0:30:02.96,0:30:04.71,teks umum,,0,0,0,,Mungkin dengan itu
Dialog: 0,0:30:04.79,0:30:08.29,teks umum,,0,0,0,,siapa yang mengirim Nak Su dan mengubah penyihir Sosnovy Bor menjadi pengembara
Dialog: 0,0:30:08.88,0:30:10.55,teks umum,,0,0,0,,Saya mendengar Guru So Kyung
Dialog: 0,0:30:10.63,0:30:12.92,teks umum,,0,0,0,,menghancurkan semua batu es 200 tahun yang lalu
Dialog: 0,0:30:13.01,0:30:13.92,teks umum,,0,0,0,,Rupanya,
Dialog: 0,0:30:14.01,0:30:17.93,teks umum,,0,0,0,,tidak semuanya hancur, sebagian tetap di Sosnovy Bor
Dialog: 0,0:30:18.01,0:30:21.56,teks umum,,0,0,0,,Tidak mudah mengekang nafsu manusia
Dialog: 0,0:30:21.64,0:30:22.68,teks umum,,0,0,0,,Tapi
Dialog: 0,0:30:24.02,0:30:25.73,teks umum,,0,0,0,,kembalinya batu es
Dialogue: 0,0:30:25.81,0:30:29.06,teks umum,,0,0,0,,menandai kedatangan pria seperti Master So Kyung
Dialog: 0,0:30:32.28,0:30:35.32,teks umum,,0,0,0,,Tuan So Kyung lahir di bawah bintang Raja
Dialog: 0,0:30:35.90,0:30:38.03,teks umum,,0,0,0,,Namun, dia tidak menjadi raja
Dialog: 0,0:30:39.74,0:30:41.12,teks umum,,0,0,0,,Apakah kamu ingin mengatakan,
Dialog: 0,0:30:41.91,0:30:44.37,teks umum,,0,0,0,,apakah ada orang lain yang lahir di bawah bintang ini?
Dialog: 0,0:30:49.21,0:30:51.63,miring,,0,0,0,,Kalaupun ada, cahayanya akan lemah
Dialog: 0,0:30:51.71,0:30:55.92,miring,,0,0,0,,Dan energi tujuh bintang yang mengelilinginya belum terwujud
Dialog: 0,0:30:57.01,0:30:59.22,teks umum,,0,0,0,,Kekuatan yang mampu melawan alam,
Dialog: 0,0:30:59.30,0:31:03.18,teks umum,,0,0,0,,dan membawa kekacauan ke dunia, terbangun kembali
Dialog: 0,0:31:03.27,0:31:05.35,miring,,0,0,0,,Orang yang menghentikan ini akan muncul
Dialog: 0,0:31:06.23,0:31:07.31,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:31:08.60,0:31:11.65,teks umum,,0,0,0,,keseimbangan dunia akan tetap terjaga
Dialog: 0,0:31:17.65,0:31:22.41,teks umum,,0,0,0,,Apa yang ingin saya katakan, tidak ada gunanya khawatir
Dialog: 0,0:31:23.87,0:31:27.46,teks umum,,0,0,0,,Saya harap ini memberi Anda kedamaian
Dialog: 0,0:31:32.71,0:31:35.09,teks umum,,0,0,0,,Terima kasih atas kata-katamu
Dialog: 0,0:31:35.92,0:31:38.51,miring,,0,0,0,,Sekarang aku harus pergi
Dialog: 0,0:31:39.22,0:31:41.55,teks umum,,0,0,0,,Kamu menolak hadiahku,
Dialog: 0,0:31:41.64,0:31:44.35,teks umum,,0,0,0,,jadi aku akan membawa Gviga bersamaku
Dialog: 0,0:31:46.06,0:31:48.06,teks umum,,0,0,0,,- Yang Mulia\N- Lakukan sesukamu
Dialog: 0,0:32:07.41,0:32:09.54,teks umum,,0,0,0,,Tidak, tunggu
Dialog: 0,0:32:10.37,0:32:12.21,teks umum,,0,0,0,,Apakah kita akan berangkat?
Dialog: 0,0:32:12.29,0:32:13.84,teks umum,,0,0,0,,Saya melihat semua yang saya inginkan
Dialog: 0,0:32:16.30,0:32:19.01,kenangan miring,,0,0,0,,Jadi ada pengembara di istanaku?
Dialog: 0,0:32:19.51,0:32:21.14,kenangan,,0,0,0,,Bawa dia, kita tidak membutuhkannya
Dialog: 0,0:32:21.22,0:32:23.80,kenangan,,0,0,0,,Beraninya kamu membawa monster ini kemari?!
Dialog: 0,0:32:25.18,0:32:26.93,teks umum,,0,0,0,,Mereka menampakkan diri saat aku menanamkan rasa takut pada mereka
Dialog: 0,0:32:30.60,0:32:32.31,teks umum,,0,0,0,,Takut?
Dialog: 0,0:32:32.40,0:32:33.98,teks umum,,0,0,0,,Tidak terluka?
Dialog: 0,0:32:34.06,0:32:35.86,teks umum,,0,0,0,,Bagaimana kamu terluka?
Dialog: 0,0:32:37.07,0:32:40.03,teks umum,,0,0,0,,Anjingnya baik-baik saja, tapi aku tidak, karena kamu
Dialog: 0,0:32:41.78,0:32:42.82,teks umum,,0,0,0,,Sakit?
Dialog: 0,0:32:43.49,0:32:45.99,teks umum,,0,0,0,,Aku terluka saat bertarung dengan bandit-bandit ini, kan?
Dialogue: 0,0:32:46.08,0:32:47.87,teks umum,,0,0,0,,Perjalanannya masih panjang, kan?
Dialog: 0,0:32:50.25,0:32:52.04,teks umum,,0,0,0,,Tunggu, ini darah. Terluka?
Dialog: 0,0:32:52.88,0:32:54.04,teks umum,,0,0,0,,Ini darahku
Dialog: 0,0:32:54.13,0:32:55.42,teks umum,,0,0,0,,Dia tidak terluka sama sekali...
Dialog: 0,0:32:56.13,0:32:58.17,teks umum,,0,0,0,,- Darah...\N- Kamu tercakup di dalamnya
Dialog: 0,0:32:58.84,0:33:00.76,teks umum,,0,0,0,,Baiklah, bagus
Dialog: 0,0:33:06.18,0:33:07.47,teks umum,,0,0,0,,Sakit?
Dialog: 0,0:33:09.27,0:33:10.43,teks umum,,0,0,0,,Rupanya iya
Dialog: 0,0:33:11.06,0:33:13.40,teks umum,,0,0,0,,Sakit...
Dialog: 0,0:33:22.95,0:33:25.12,di luar layar,,0,0,0,,Gwigu milik Master Li
Dialog: 0,0:33:25.62,0:33:28.54, sulih suara,,0,0,0,,Berapa banyak yang dia ketahui tentang Moo Deok?
Dialog: 0,0:33:29.54,0:33:31.50,di belakang layar,,0,0,0,,Dan apa yang akan dilakukan Inggris,
Dialog: 0,0:33:31.58,0:33:33.37,sulih suara,,0,0,0,,kapan dia akan mengetahui tentang Nak Soo?
Dialog: 0,0:33:42.05,0:33:43.09,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:33:44.59,0:33:45.72,teks umum,,0,0,0,,Semua terpotong
Dialog: 0,0:33:45.80,0:33:47.55,teks umum,,0,0,0,,Saya baik-baik saja
Dialog: 0,0:33:47.64,0:33:50.35,teks umum,,0,0,0,,Sudahkah kamu menemukan pengembara? Bagaimana dengan batunya?
Dialog: 0,0:33:51.52,0:33:52.98,teks umum,,0,0,0,,Anda tidak tahu...
Dialog: 0,0:33:53.69,0:33:56.02,teks umum,,0,0,0,,Jiwaku hampir berpindah dari kengerian
Dialog: 0,0:33:56.61,0:33:59.11,teks umum,,0,0,0,,Mereka membuat keributan, tetapi tidak menemukan siapa pun?
Dialog: 0,0:33:59.19,0:34:02.61,teks umum,,0,0,0,,Biarkan anjing menggigit seseorang
Dialog: 0,0:34:03.24,0:34:04.32,miring,,0,0,0,,Uk
Dialog: 0,0:34:04.40,0:34:06.57,teks umum,,0,0,0,,Cari pengembara di istana
Dialog: 0,0:34:06.66,0:34:08.99,teks umum,,0,0,0,,lebih sulit daripada di Sosnovy Bor atau Jeonbugwan
Dialog: 0,0:34:10.20,0:34:11.70,teks umum,,0,0,0,,Jika keadaan menjadi tidak terkendali,
Dialog: 0,0:34:11.79,0:34:14.29,teks umum,,0,0,0,,konflik akan muncul antara istana dan Sosnovy Bor
Dialog: 0,0:34:17.42,0:34:18.38,miring,,0,0,0,,Ayo berangkat
Dialog: 0,0:34:18.46,0:34:19.80,teks umum,,0,0,0,,Anda perlu memperbaiki
Dialog: 0,0:34:20.50,0:34:21.51,miring,,0,0,0,,Master
Dialog: 0,0:34:25.05,0:34:27.05,teks umum,,0,0,0,,Tunggu sebentar
Dialog: 0,0:34:27.14,0:34:30.22,teks umum,,0,0,0,,Putra Mahkota telah meminta untuk mengantarmu ke istananya
Dialog: 0,0:34:30.81,0:34:33.10,teks umum,,0,0,0,,- Putra Mahkota?\N- Akan turun hujan
Dialog: 0,0:34:33.18,0:34:35.56,teks umum,,0,0,0,,Dia ingin kamu menunggunya
Dialog: 0,0:34:37.81,0:34:38.90,teks umum,,0,0,0,,Pimpin
Dialog: 0,0:34:47.74,0:34:50.49,teks umum,,0,0,0,,Uk, kirim dulu
Dialog: 0,0:34:50.58,0:34:52.08,teks umum,,0,0,0,,di Sosnovy Bor
Dialog: 0,0:34:53.25,0:34:54.41,teks umum,,0,0,0,,Kemarilah
Dialog: 0,0:34:55.83,0:34:56.96,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:35:09.18,0:35:12.81,teks umum,,0,0,0,,Kamu seharusnya memberitahuku bahwa mereka diundang ke istana!
Dialog: 0,0:35:12.89,0:35:14.06,teks umum,,0,0,0,,Saya kira ini akan terjadi
Dialog: 0,0:35:14.81,0:35:16.52,teks umum,,0,0,0,,pertemuan rutin
Dialog: 0,0:35:17.02,0:35:18.06,teks umum,,0,0,0,,Jika ratu
Dialog: 0,0:35:18.15,0:35:20.52,teks umum,,0,0,0,,akan menderita, kamu akan berubah menjadi batu, seperti kasim Kim
Dialog: 0,0:35:20.61,0:35:22.32,teks umum,,0,0,0,,Sepotong daging tak berguna!
Dialog: 0,0:35:34.45,0:35:36.54,teks umum,,0,0,0,,Seseorang yang lahir di bawah bintang Raja,
Dialog: 0,0:35:36.62,0:35:38.92,teks umum,,0,0,0,,apa yang akan mengulangi nasib Guru So Kyung?
Dialog: 0,0:35:41.25,0:35:43.84,teks umum,,0,0,0,,Jika ternyata bintang ini adalah buah ilmu hitam,
Dialogue: 0,0:35:44.80,0:35:46.72,teks umum,,0,0,0,,Akhir dari Hutan Pinus
Dialog: 0,0:35:50.68,0:35:53.97,teks umum,,0,0,0,,Saya mengirim Gviga ke Sosnovy Bor
Dialog: 0,0:35:55.06,0:35:57.10,teks umum,,0,0,0,,Maaf membuatmu takut
Dialog: 0,0:35:57.18,0:35:59.44,teks umum,,0,0,0,,Saat pengembara ditemukan di Sosnovy Bor,
Dialog: 0,0:35:59.52,0:36:01.90,teks umum,,0,0,0,,Kupikir mereka mungkin ada di istana juga
Dialog: 0,0:36:02.94,0:36:06.15,teks umum,,0,0,0,,Baru-baru ini dia bahkan mencoba untuk sampai ke sini
Dialog: 0,0:36:06.90,0:36:09.03,teks umum,,0,0,0,,Kudengar dia yang menciptakannya
Dialog: 0,0:36:09.11,0:36:10.86,teks umum,,0,0,0,,dan membunuh Nak Su
Dialog: 0,0:36:15.29,0:36:16.37,teks umum,,0,0,0,,Nak Su?
Dialog: 0,0:36:18.25,0:36:21.08,teks umum,,0,0,0,,Seorang tentara bayaran yang membunuh banyak pejuang
Dialog: 0,0:36:21.75,0:36:23.59,teks umum,,0,0,0,,Kepala terbang dari bahu tempat dia berada
Dialog: 0,0:36:23.67,0:36:25.55,teks umum,,0,0,0,,Itulah mengapa dia disebut demikian
Dialog: 0,0:36:25.63,0:36:29.22,teks umum,,0,0,0,,Ada rumor bahwa dia pengembara dan dia masih hidup
Dialog: 0,0:36:32.43,0:36:34.05,teks umum,,0,0,0,,Nomad Nak Su?
Dialog: 0,0:36:35.64,0:36:37.39,teks umum,,0,0,0,,Rumor menarik
Dialog: 0,0:37:11.63,0:37:15.26,teks umum,,0,0,0,,Kuharap Mu Deok tertangkap sebelum majikannya kembali
Dialog: 0,0:37:22.52,0:37:24.19,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:37:26.48,0:37:27.86,teks umum,,0,0,0,,Kenapa kamu gemetar?
Dialog: 0,0:37:28.48,0:37:30.82,teks umum,,0,0,0,,Apakah kamu yakin aku membunuh seseorang?
Dialog: 0,0:37:32.82,0:37:34.82,teks umum,,0,0,0,,Masuk
Dialogue: 0,0:37:40.25,0:37:41.71,teks umum,,0,0,0,,Kenapa kamu datang?
Dialog: 0,0:37:42.66,0:37:44.00,teks umum,,0,0,0,,Ambil barang dan kabur?
Dialog: 0,0:37:44.08,0:37:46.13,teks umum,,0,0,0,,Saya datang untuk meminta sesuatu
Dialog: 0,0:37:46.71,0:37:48.92,teks umum,,0,0,0,,Kepala berkata untuk menangkapmu segera setelah kamu muncul
Dialog: 0,0:37:49.92,0:37:51.09,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:37:51.17,0:37:52.47,teks umum,,0,0,0,,kamu tidak melakukan ini?
Dialogue: 0,0:37:53.18,0:37:56.01,teks umum,,0,0,0,,- Bukan aku\N- Lalu kenapa kamu kabur
Dialog: 0,0:37:56.68,0:37:58.10,teks umum,,0,0,0,,aku harus
Dialog: 0,0:37:59.47,0:38:00.77,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:38:01.52,0:38:02.60,teks umum,,0,0,0,,Anda punya
Dialog: 0,0:38:03.52,0:38:05.40,teks umum,,0,0,0,,ada rahasia?
Dialog: 0,0:38:10.90,0:38:12.24,teks umum,,0,0,0,,Tuan Muda
Dialog: 0,0:38:13.32,0:38:15.03,teks umum,,0,0,0,,mengetahuinya?
Dialog: 0,0:38:21.04,0:38:24.62,teks umum,,0,0,0,,Moo Dok, kamu harus lari
Dialog: 0,0:38:25.21,0:38:26.29,teks umum,,0,0,0,,Aku akan memberimu uang
Dialog: 0,0:38:26.37,0:38:27.96,teks umum,,0,0,0,,Lari dan jangan kembali
Dialog: 0,0:38:28.04,0:38:29.17,teks umum,,0,0,0,,Saya tidak bisa
Dialog: 0,0:38:30.38,0:38:32.71,teks umum,,0,0,0,,Aku tidak bisa meninggalkan tuanku
Dialog: 0,0:38:32.80,0:38:34.05,teks umum,,0,0,0,,Mengapa?
Dialog: 0,0:38:35.30,0:38:38.43,teks umum,,0,0,0,,Jika kamu tetap dekat, dia juga akan dicurigai
Dialog: 0,0:38:38.51,0:38:39.85,teks umum,,0,0,0,,Jika kamu mengkhawatirkan dia,
Dialog: 0,0:38:40.64,0:38:42.10,teks umum,,0,0,0,,lalu bantu aku
Dialogue: 0,0:38:42.18,0:38:45.10,teks umum,,0,0,0,,Kamu gak mau ngomong ke kepala, kamu juga gak mau lari
Dialog: 0,0:38:45.69,0:38:47.02,teks umum,,0,0,0,,Apa yang akan kamu lakukan?
Dialog: 0,0:38:48.69,0:38:50.52,teks umum,,0,0,0,,Kita harus menemukan pembunuhnya
Dialog: 0,0:38:51.98,0:38:56.36,teks umum,,0,0,0,,Pembunuhnya membunuh orang yang mengenalnya secara langsung
Dialogue: 0,0:39:01.41,0:39:03.45,teks umum,,0,0,0,,Apakah Gwangju Jeongbugwan tinggal di sini?
Dialog: 0,0:39:04.29,0:39:06.16,teks umum,,0,0,0,,Rupanya keluarga yang berpengaruh
Dialogue: 0,0:39:08.12,0:39:11.42,teks umum,,0,0,0,,Apakah ada anggota keluarga Chan yang mengenalmu?
Dialog: 0,0:39:14.13,0:39:17.34,teks umum,,0,0,0,,Tunggu di pojokan. Aku akan membawa pria ini
Dialog: 0,0:39:28.14,0:39:30.31,teks umum,,0,0,0,,Saya ingin meminta seseorang untuk mengonfirmasi,
Dialog: 0,0:39:30.40,0:39:33.98,teks umum,,0,0,0,,bahwa saya tidak ada di ruangan ketika orang-orang itu dibunuh
Dialog: 0,0:39:35.36,0:39:36.65,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:39:37.24,0:39:38.61,teks umum,,0,0,0,,Nyonya Jin dari Jinyeowon
Dialog: 0,0:39:39.61,0:39:41.20,teks umum,,0,0,0,,Aku bertemu dengannya di sana
Dialog: 0,0:39:42.20,0:39:44.37,teks umum,,0,0,0,,Banci ini tidak akan setuju untuk bertemu denganmu
Dialog: 0,0:39:45.62,0:39:46.83,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:39:47.96,0:39:50.21,teks umum,,0,0,0,,Bawa aku ke Jinyeowon
Dialog: 0,0:39:52.42,0:39:53.42,teks umum,,0,0,0,,Jinyeowon?
Dialogue: 0,0:40:18.03,0:40:21.45,teks umum,,0,0,0,,Permisi, bisakah anda membantu saya mengangkat kruknya?
Dialog: 0,0:40:27.91,0:40:28.87,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:40:29.75,0:40:32.29,teks umum,,0,0,0,,Bisakah kamu memberitahuku di mana aku berada?
Dialog: 0,0:40:33.04,0:40:37.01,teks umum,,0,0,0,,Di rumah Gwangju Jeonbugwan
Dialog: 0,0:40:38.80,0:40:39.97,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:40:41.01,0:40:42.09,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:40:55.36,0:40:56.61,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:40:56.69,0:40:57.73,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:41:05.53,0:41:07.49,di balik layar,,0,0,0,,Rupanya Moo Deok bisa melihat sekarang
Dialog: 0,0:41:08.12,0:41:10.08,di luar layar,,0,0,0,,Tapi dia tidak mengenaliku
Dialog: 0,0:41:10.87,0:41:12.54,di belakang layar,,0,0,0,,kuharap ini menjadi lebih baik
Dialog: 0,0:41:16.17,0:41:17.42,teks umum,,0,0,0,,Kenapa kamu sendirian?
Dialog: 0,0:41:18.21,0:41:21.13,teks umum,,0,0,0,,Saya salah. Kami tidak mengenalnya sama sekali
Dialog: 0,0:41:22.55,0:41:24.97,teks umum,,0,0,0,,Kita sudah selesai. Ayo kembali ke Jeonbugwan
Dialog: 0,0:41:37.15,0:41:38.69,teks umum,,0,0,0,,Bolehkah aku mencobanya?
Dialog: 0,0:41:38.78,0:41:39.65,teks umum,,0,0,0,,- Tidak\N- Tidak
Dialog: 0,0:41:39.73,0:41:41.86,teks umum,,0,0,0,,Hentikan
Dialog: 0,0:41:41.95,0:41:43.86,miring,,0,0,0,,aku basah
Dialogue: 0,0:41:43.95,0:41:45.57,teks umum,,0,0,0,,Ini payungnya
Dialog: 0,0:41:46.20,0:41:47.12,kenangan,,0,0,0,,Ini payung
Dialog: 0,0:41:48.08,0:41:49.95,kenangan,,0,0,0,,Dapat digunakan sebagai tongkat
Dialog: 0,0:41:52.96,0:41:55.50,teks umum,,0,0,0,,Ibu akan memarahiku, hentikan
Dialog: 0,0:41:55.58,0:41:56.50,teks umum,,0,0,0,,Cukup
Dialog: 0,0:41:57.17,0:41:59.42,teks umum,,0,0,0,,- Tidak mungkin\N- Hai
Dialog: 0,0:42:00.71,0:42:03.72,teks umum,,0,0,0,,Mau bertukar payung denganku?
Dialogue: 0,0:42:07.60,0:42:11.89,teks umum,,0,0,0,,Kudengar Nak Soo tergerak
Dialog: 0,0:42:11.98,0:42:15.73,teks umum,,0,0,0,,ke dalam tubuh seorang pemuda tinggi tegap
Dialog: 0,0:42:15.81,0:42:19.32,teks umum,,0,0,0,,Dia bisa berpindah ke tubuh wanita kecil dan lemah
Dialog: 0,0:42:21.40,0:42:26.03,teks umum,,0,0,0,,Dengan tubuh lemah seperti itu, tidak ada gunanya menyentuhnya
Dialog: 0,0:42:28.91,0:42:30.04,teks umum,,0,0,0,,Tapi tidak
Dialog: 0,0:42:30.58,0:42:32.79,teks umum,,0,0,0,,Nak Su berbaju biru pastinya laki-laki
Dialog: 0,0:42:33.58,0:42:35.00,teks umum,,0,0,0,,"Nak Su berbaju biru"
Dialog: 0,0:42:35.08,0:42:38.46,teks umum,,0,0,0,,- Aku mendengarnya\N- Dia berbaju biru
Dialog: 0,0:42:38.54,0:42:42.63,teks umum,,0,0,0,,Menyebar kemana-mana, orang-orang mulai berjalan berkeliling dengan warna biru
Dialog: 0,0:42:42.71,0:42:45.09,teks umum,,0,0,0,,Mereka berpikir begitu
Dialog: 0,0:42:45.18,0:42:48.22,teks umum,,0,0,0,,Nak Su dengan warna biru akan melindungi mereka dari alkimia jiwa
Dialog: 0,0:42:49.93,0:42:51.72,teks umum,,0,0,0,,Nak Su adalah seorang tentara bayaran,
Dialog: 0,0:42:53.22,0:42:56.14,teks umum,,0,0,0,,tapi dia tidak membunuh orang biasa, dan dia tidak memiliki kekuatan
Dialog: 0,0:43:01.78,0:43:04.65,teks umum,,0,0,0,,Orang bisa begitu bodoh
Dialog: 0,0:43:04.74,0:43:06.32,teks umum,,0,0,0,,Ini bukan kebodohan
Dialog: 0,0:43:07.20,0:43:08.45,teks umum,,0,0,0,,Ini adalah ketakutan
Dialogue: 0,0:43:11.20,0:43:13.79,teks umum,,0,0,0,,Tubuh Nak Su dibakar, semua orang mengetahuinya
Dialog: 0,0:43:14.66,0:43:17.46,teks umum,,0,0,0,,Ini adalah karya orang yang berkuasa dan berpengaruh
Dialog: 0,0:43:19.25,0:43:20.71,teks umum,,0,0,0,,Sebut mereka bodoh,
Dialog: 0,0:43:21.67,0:43:23.84,teks umum,,0,0,0,,ketika mereka hanya takut, salah
Dialog: 0,0:43:33.10,0:43:36.73,teks umum,,0,0,0,,Saya mengumpulkan Anda dengan harapan menemukan solusi,
Dialog: 0,0:43:36.81,0:43:40.02,teks umum,,0,0,0,,tapi kamu berani duduk di sini dan mengkritikku
Dialog: 0,0:43:43.27,0:43:46.99,teks umum,,0,0,0,,Saya mengerti, Anda ingin saling mempermalukan,
Dialog: 0,0:43:47.07,0:43:50.24,teks umum,,0,0,0,,tapi kuharap kita semua mulai akur
Dialog: 0,0:43:51.16,0:43:53.41,teks umum,,0,0,0,,Guru Li juga bersama kita
Dialog: 0,0:43:53.49,0:43:54.66,miring,,0,0,0,,Ayo minum teh
Dialog: 0,0:43:57.75,0:43:59.04,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:44:00.04,0:44:01.38,teks umum,,0,0,0,,Apa?
Dialog: 0,0:44:04.80,0:44:07.55,teks umum,,0,0,0,,Nyonya Ho meminta audiensi
Dialog: 0,0:44:07.63,0:44:08.63,teks umum,,0,0,0,,Biarkan dia masuk
Dialog: 0,0:44:17.14,0:44:18.43,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:44:18.52,0:44:20.98,teks umum,,0,0,0,,Kudengar seseorang terluka setelah pertarungan
Dialog: 0,0:44:21.56,0:44:23.19,teks umum,,0,0,0,,Saya datang untuk memeriksa
Dialog: 0,0:44:25.32,0:44:27.61,miring,,0,0,0,,Hanya satu yang terluka di sini
Dialog: 0,0:44:27.69,0:44:30.57,teks umum,,0,0,0,,- Bawa dia pergi dan sembuhkan\N- Aku baik-baik saja
Dialog: 0,0:44:30.66,0:44:32.16,teks umum,,0,0,0,,Tidak akan lama
Dialog: 0,0:44:32.24,0:44:33.45,miring,,0,0,0,,Berjalanlah bersamaku
Dialog: 0,0:44:45.84,0:44:48.51,teks umum,,0,0,0,,Sepertinya Chan Wook akan bertunangan lagi
Dialog: 0,0:44:48.59,0:44:49.63,teks umum,,0,0,0,,Sekali lagi?
Dialog: 0,0:44:49.72,0:44:51.72,teks umum,,0,0,0,,- Apa maksudnya?\N{\i1}- Apa kamu tidak tahu?
Dialog: 0,0:44:51.80,0:44:54.01,teks umum,,0,0,0,,Apakah kamu benar-benar tidak tahu apa-apa?
Dialog: 0,0:44:54.10,0:44:56.10,miring,,0,0,0,,Rumor beredar di Saejukwon
Dialog: 0,0:44:56.18,0:44:59.89,teks umum,,0,0,0,,Kalian bertiga adalah kandidat potensial untuk peran menantu Tuan Ho Yeom
Dialog: 0,0:45:00.48,0:45:02.15,teks umum,,0,0,0,,Inggris berada di urutan ketiga dalam daftar
Dialog: 0,0:45:02.23,0:45:04.06,teks umum,,0,0,0,,Tapi baginya, rupanya, dialah yang pertama
Dialog: 0,0:45:05.02,0:45:06.98,miring,,0,0,0,,Ho Yeom ingin menikahkannya tahun ini
Dialog: 0,0:45:07.07,0:45:09.78,teks umum,,0,0,0,,Sebentar lagi mereka akan membicarakan tentang pertunangan. Saya jamin
Dialog: 0,0:45:15.87,0:45:19.79,teks umum,,0,0,0,,Lukanya tidak dalam. Pil ini akan menghentikan pendarahan
Dialog: 0,0:45:19.87,0:45:22.71,teks umum,,0,0,0,,Kamu seharusnya segera memberikannya kepadaku
Dialog: 0,0:45:22.79,0:45:24.63,teks umum,,0,0,0,,Saya mendengar tentang luka
Dialog: 0,0:45:24.71,0:45:29.09,teks umum,,0,0,0,,Aku ingin memeriksanya sendiri untuk menenangkan diri
Dialog: 0,0:45:31.80,0:45:32.88,teks umum,,0,0,0,,Yah...
Dialog: 0,0:45:33.55,0:45:37.89,teks umum,,0,0,0,,Kamu terluka lebih dari sekali, jadi pemikiran ini muncul...
Dialog: 0,0:45:39.02,0:45:40.27,teks umum,,0,0,0,,Saya baik-baik saja
Dialog: 0,0:45:40.98,0:45:42.23,teks umum,,0,0,0,,Oke
Dialog: 0,0:45:48.44,0:45:52.53,teks umum,,0,0,0,,Oh, tepat sekali. Pembantu Kim memberikannya padaku
Dialogue: 0,0:45:52.61,0:45:55.24,teks umum,,0,0,0,,Aku belum mengucapkan terima kasih padanya
Dialogue: 0,0:45:57.03,0:45:58.33,teks umum,,0,0,0,,Dia sama saja
Dialog: 0,0:46:03.62,0:46:04.62,teks umum,,0,0,0,,Sama?
Dialog: 0,0:46:06.63,0:46:08.96,teks umum,,0,0,0,,Jepit rambut yang kulihat dua puluh tahun lalu
Dialog: 0,0:46:09.59,0:46:11.63,teks umum,,0,0,0,,Oh, apakah ini sesuatu yang berharga?
Dialog: 0,0:46:16.34,0:46:17.80,teks umum,,0,0,0,,Tampak baru
Dialog: 0,0:46:17.89,0:46:19.89,teks umum,,0,0,0,,Mungkin bukan milik kita
Dialogue: 0,0:46:20.68,0:46:22.52,teks umum,,0,0,0,,Tapi cara kerjanya mirip sekali
Dialog: 0,0:46:23.85,0:46:24.69,miring,,0,0,0,,Itu dia
Dialog: 0,0:46:25.35,0:46:27.31,teks umum,,0,0,0,,Ternyata sang pangeran benar
Dialog: 0,0:46:28.44,0:46:30.61,teks umum,,0,0,0,,Segera kita akan mendengar tentang pertunangan Uka
Dialog: 0,0:46:30.69,0:46:32.65,teks umum,,0,0,0,,Tetapi untuk Master Huo dia berada di urutan ketiga dalam daftar
Dialog: 0,0:46:34.99,0:46:37.32,teks umum,,0,0,0,,Maukah kamu menikahinya sendiri, karena kamu yang pertama dalam daftar ini?
Dialog: 0,0:46:38.37,0:46:41.41,teks umum,,0,0,0,,Jika kamu menikah, kamu harus kembali ke Seho
Dialog: 0,0:46:42.00,0:46:45.00,teks umum,,0,0,0,,Yul, asal jangan menikah. aku akan kesepian
Dialog: 0,0:46:46.62,0:46:48.92,kenangan miring,,0,0,0,,Saya bisa mengenali pengembara
Dialog: 0,0:46:57.51,0:47:00.05,teks umum,,0,0,0,,Kita harus membawanya ke Seho sesegera mungkin
Dialog: 0,0:47:00.14,0:47:01.18,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:47:02.06,0:47:02.93,teks umum,,0,0,0,,Saya?
Dialog: 0,0:47:09.11,0:47:10.44,teks umum,,0,0,0,,Aku menarik kembali kata-kataku
Dialog: 0,0:47:11.15,0:47:15.74,teks umum,,0,0,0,,Aku merasa lebih tenang setelah melihat reaksimu hari ini
Dialog: 0,0:47:16.32,0:47:17.95,teks umum,,0,0,0,,Senang mendengarnya
Dialogue: 0,0:47:18.87,0:47:20.91,teks umum,,0,0,0,,Apa yang ingin kamu tanyakan secara pribadi padaku?
Dialog: 0,0:47:23.08,0:47:25.66,teks umum,,0,0,0,,Aku tahu kamu punya pedang Nak Su
Dialog: 0,0:47:25.75,0:47:27.75,teks umum,,0,0,0,,Bolehkah saya mengambilnya?
Dialog: 0,0:47:36.42,0:47:39.64,teks umum,,0,0,0,,Saya menonton pertunjukannya tahun lalu
Dialogue: 0,0:47:40.22,0:47:41.47,teks umum,,0,0,0,,Ada gajah disana
Dialogue: 0,0:47:41.97,0:47:45.18,teks umum,,0,0,0,,Tapi saat aku pergi bersama Dan Gu, aku harus berpura-pura ini pertama kalinya aku ke sana
Dialogue: 0,0:47:45.27,0:47:47.81,teks umum,,0,0,0,,Jadi tiket itu untukmu dan Tuan Dan Gu?
Dialog: 0,0:47:47.89,0:47:50.06,teks umum,,0,0,0,,Takut. Apa yang kamu lakukan di sini?
Dialog: 0,0:47:50.15,0:47:52.69,teks umum,,0,0,0,,Saya datang untuk meminta bantuan
Dialog: 0,0:47:52.77,0:47:53.90,teks umum,,0,0,0,,Tentang layanan ini?
Dialog: 0,0:47:54.94,0:47:56.32,teks umum,,0,0,0,,Jangan ganggu
Dialog: 0,0:47:56.40,0:47:59.49,teks umum,,0,0,0,,Tidak ada keinginan untuk membantumu
Dialog: 0,0:47:59.57,0:48:01.20,teks umum,,0,0,0,,Saya dituduh melakukan pembunuhan
Dialog: 0,0:48:01.95,0:48:03.08,teks umum,,0,0,0,,Apa?
Dialog: 0,0:48:03.16,0:48:05.41,teks umum,,0,0,0,,Anda bisa pergi ke kepala Sosnovy Bor
Dialog: 0,0:48:06.12,0:48:08.54,teks umum,,0,0,0,,dan bilang kamu melihatku?
Dialog: 0,0:48:09.67,0:48:13.92,teks umum,,0,0,0,,Apakah kamu ingin aku langsung ke kepala dan mengakui bahwa aku pergi
Dialog: 0,0:48:14.50,0:48:15.76,teks umum,,0,0,0,,ke tempat seperti itu?
Dialogue: 0,0:48:16.46,0:48:18.30,teks umum,,0,0,0,,Aku tidak gila
Dialog: 0,0:48:20.18,0:48:21.80,teks umum,,0,0,0,,Kamulah satu-satunya harapanku
Dialog: 0,0:48:22.47,0:48:24.35,teks umum,,0,0,0,,Tolong
Dialog: 0,0:48:27.43,0:48:28.60,teks umum,,0,0,0,,Tidak
Dialog: 0,0:48:28.68,0:48:30.60,teks umum,,0,0,0,,Saya memberi tahu Dan Gu bahwa saya memiliki tiket tambahan
Dialog: 0,0:48:30.69,0:48:32.56,teks umum,,0,0,0,,Saya tidak ingin dia tahu di mana saya membelinya
Dialog: 0,0:48:32.65,0:48:35.27,teks umum,,0,0,0,,Rasa malumu hanya sementara,
Dialog: 0,0:48:35.36,0:48:37.36,teks umum,,0,0,0,,dan mereka bisa membunuhku
Dialog: 0,0:48:38.36,0:48:40.40,teks umum,,0,0,0,,Jika ibu tahu, aku juga tidak akan hidup
Dialog: 0,0:48:40.49,0:48:43.24,teks umum,,0,0,0,,Dia tidak akan pernah membunuh putrinya!
Dialog: 0,0:48:43.32,0:48:45.54,teks umum,,0,0,0,,Kenapa kamu berteriak saat datang meminta bantuan?
Dialog: 0,0:48:48.29,0:48:51.58,teks umum,,0,0,0,,Kalau begitu, aku sendiri yang harus menceritakan semuanya pada ibumu
Dialog: 0,0:48:52.08,0:48:53.71,teks umum,,0,0,0,,dan minta bantuannya
Dialogue: 0,0:48:53.79,0:48:55.42,teks umum,,0,0,0,,Haruskah aku bertanya pada ibuku?
Dialog: 0,0:48:56.84,0:48:58.38,teks umum,,0,0,0,,Ini dia datang
Dialog: 0,0:49:00.76,0:49:03.80,teks umum,,0,0,0,,Kamu seharusnya tidak repot dengan hadiah sebagai permintaan maaf atas masa lalu
Dialog: 0,0:49:05.10,0:49:08.77,teks umum,,0,0,0,,Semakin aku memikirkannya, semakin aku ingin meminta maaf
Dialog: 0,0:49:10.18,0:49:12.73,teks umum,,0,0,0,,Aku sendiri yang akan bertanya padanya
Dialog: 0,0:49:12.81,0:49:13.73,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:49:13.81,0:49:16.90,teks umum,,0,0,0,,Saya akan memikirkannya. Ikutlah dulu denganku
Dialog: 0,0:49:25.74,0:49:27.79,teks umum,,0,0,0,,Saya akan segera kembali. Tunggu di sini
Dialog: 0,0:49:28.37,0:49:29.83,teks umum,,0,0,0,,Jika kamu tidak kembali, aku akan berteriak
Dialog: 0,0:49:29.91,0:49:31.41,teks umum,,0,0,0,,- Aku akan kembali\N-{\i1} Cho Young
Dialog: 0,0:49:32.21,0:49:33.33,teks umum,,0,0,0,,Ya ibu
Dialog: 0,0:49:34.13,0:49:34.96,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:50:06.28,0:50:07.66,teks umum,,0,0,0,,Sangat muda
Dialog: 0,0:50:08.99,0:50:10.16,teks umum,,0,0,0,,Aku ingin tahu siapa itu?
Dialog: 0,0:50:39.61,0:50:41.23,teks umum,,0,0,0,,Apakah karena dupa?
Dialogue: 0,0:50:45.24,0:50:46.53,teks umum,,0,0,0,,Vas cantik
Dialog: 0,0:50:47.57,0:50:51.54,teks umum,,0,0,0,,Jika kamu memasukkan bunga ke dalam vas ini, baunya akan lebih kuat
Dialog: 0,0:50:52.79,0:50:54.71,teks umum,,0,0,0,,- Benarkah?\N- Ya
Dialog: 0,0:50:54.79,0:50:58.00,teks umum,,0,0,0,,Saya sudah lama ingin mengganti vas di kamar putri saya
Dialog: 0,0:50:59.04,0:50:59.96,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:51:03.67,0:51:06.72,teks umum,,0,0,0,,Ibu, maukah ibu meletakkan vas bunga di kamar Boo Young unnie?
Dialog: 0,0:51:06.80,0:51:08.72,teks umum,,0,0,0,,Bunganya akan berbau lebih kuat
Dialog: 0,0:51:08.80,0:51:12.47,teks umum,,0,0,0,,Adikmu buta, jadi setidaknya dia bisa menikmati aroma bunga
Dialog: 0,0:51:56.77,0:51:58.10,teks umum,,0,0,0,,Beraninya kamu?!
Dialog: 0,0:51:58.19,0:52:00.02,teks umum,,0,0,0,,Apa yang kamu lakukan di kamar putriku?
Dialog: 0,0:52:04.90,0:52:06.32,teks umum,,0,0,0,,Dia ikut denganku
Dialog: 0,0:52:06.40,0:52:07.86,teks umum,,0,0,0,,Mungkin hilang
Dialog: 0,0:52:08.45,0:52:10.70,teks umum,,0,0,0,,Moo Dok, apa yang kamu lakukan di sini?
Dialog: 0,0:52:12.99,0:52:14.16,teks umum,,0,0,0,,Maaf
Dialog: 0,0:52:15.95,0:52:18.12,miring,,0,0,0,,Bantuan sekali
Dialog: 0,0:52:19.46,0:52:21.04,miring,,0,0,0,,Pergi
Dialog: 0,0:52:21.13,0:52:22.96,teks umum,,0,0,0,,Dan jangan kembali lagi
Dialog: 0,0:52:23.04,0:52:24.75,teks umum,,0,0,0,,Ya
Dialog: 0,0:52:28.34,0:52:30.18,miring,,0,0,0,,Aku akan datang. Saya berjanji
Dialog: 0,0:52:32.64,0:52:33.72,teks umum,,0,0,0,,Cho Young,
Dialog: 0,0:52:34.39,0:52:37.98,teks umum,,0,0,0,,suruh pelayan membersihkan kamar adikmu lagi
Dialog: 0,0:52:38.73,0:52:40.52,teks umum,,0,0,0,,Ya ibu
Dialog: 0,0:53:08.26,0:53:09.26,teks umum,,0,0,0,,Jadi saya
Dialogue: 0,0:53:10.26,0:53:12.05,teks umum,,0,0,0,,Pria ini akan menjadi ayahmu
Dialog: 0,0:53:13.01,0:53:14.14,teks umum,,0,0,0,,Ayah?
Dialogue: 0,0:53:15.05,0:53:17.47,teks umum,,0,0,0,,Seorang ayah ingin membawa putri palsu ke dalam rumah?
Dialog: 0,0:53:20.85,0:53:24.48,teks umum,,0,0,0,,Aku bukan ayah sedarah Jin Bu Young
Dialog: 0,0:53:25.98,0:53:29.03,teks umum,,0,0,0,,Ayah kandungnya adalah orang lain
Dialog: 0,0:53:41.66,0:53:44.38,teks umum,,0,0,0,,Untuk diakui sebagai putri keluarga Jin,
Dialog: 0,0:53:44.46,0:53:46.34,teks umum,,0,0,0,,kamu harus membuka pintu Jinyeowon
Dialog: 0,0:53:46.42,0:53:49.84,teks umum,,0,0,0,,Dan untuk ini, darah mereka harus mengalir melalui pembuluh darahmu
Dialog: 0,0:53:53.72,0:53:55.05,teks umum,,0,0,0,,Apa ini?
Dialog: 0,0:53:55.14,0:53:58.47,teks umum,,0,0,0,,Cacing yang mengandung darah anggota keluarga Jin
Dialogue: 0,0:54:20.45,0:54:22.37,teks umum,,0,0,0,,Inilah darah Cho Young,
Dialog: 0,0:54:23.37,0:54:24.92,teks umum,,0,0,0,,favoritku
Dialog: 0,0:54:26.79,0:54:28.96,teks umum,,0,0,0,,Dan apa yang akan kamu lakukan?
Dialog: 0,0:54:29.04,0:54:30.46,teks umum,,0,0,0,,Ulurkan tanganmu
Dialog: 0,0:54:32.63,0:54:34.22,teks umum,,0,0,0,,Jangan biarkan aku menunggu
Dialog: 0,0:55:17.68,0:55:20.85, sulih suara,,0,0,0,,Sekarang kamu memiliki darah keluarga Jin
Dialog: 0,0:55:21.93,0:55:24.35, sulih suara,,0,0,0,,Jika aku tidak menggunakan ilmu hitam,
Dialog: 0,0:55:24.43,0:55:27.31, sulih suara,,0,0,0,,cacing ini akan memakanmu dari dalam
Dialog: 0,0:55:28.65,0:55:30.23,miring,,0,0,0,,Mencoba melarikan diri,
Dialog: 0,0:55:31.07,0:55:33.36,miring,,0,0,0,,cacing ini akan memakanmu hidup-hidup
Dialog: 0,0:55:40.45,0:55:43.12,teks umum,,0,0,0,,Ini kamar putrinya, yang meninggal 10 tahun lalu
Dialog: 0,0:55:44.29,0:55:45.87,teks umum,,0,0,0,,Rupanya dia tenggelam,
Dialog: 0,0:55:46.62,0:55:49.17,teks umum,,0,0,0,,tapi Nyonya Jin masih berpikir dia akan kembali
Dialog: 0,0:55:50.75,0:55:51.96,teks umum,,0,0,0,,Aku kasihan padanya
Dialog: 0,0:55:52.92,0:55:54.59,teks umum,,0,0,0,,Maafkan dia atas tamparannya
Dialogue: 0,0:55:57.72,0:56:00.76,teks umum,,0,0,0,,Dan putrinya buta?
Dialog: 0,0:56:01.68,0:56:03.97,teks umum,,0,0,0,,Ya, tadi
Dialog: 0,0:56:05.27,0:56:07.48,di luar layar,,0,0,0,,Pemilik tubuh ini juga buta
Dialog: 0,0:56:08.27,0:56:10.60,di luar layar,,0,0,0,,Mungkin itu sebabnya aku merasakan sesuatu yang aneh?
Dialog: 0,0:56:28.08,0:56:31.21,teks umum,,0,0,0,,Guru Li ingin membicarakan sesuatu dengan pangeran sendirian
Dialog: 0,0:56:31.83,0:56:32.84,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:56:38.01,0:56:40.97,teks umum,,0,0,0,,Kepala meminta untuk menemanimu ke Sosnovy Bor
Dialog: 0,0:56:41.55,0:56:43.55,teks umum,,0,0,0,,Saya? Mengapa?
Dialog: 0,0:56:43.64,0:56:44.64,miring,,0,0,0,,Ikutlah dengan kami
Dialog: 0,0:56:55.15,0:56:56.73,teks umum,,0,0,0,,Mereka akan mengurungku di sini lagi, kan?
Dialog: 0,0:56:57.23,0:56:59.07,teks umum,,0,0,0,,- Apa yang terjadi?\N- Ini...
Dialog: 0,0:56:59.78,0:57:01.11,teks umum,,0,0,0,,Kita disuruh diam
Dialog: 0,0:57:01.91,0:57:03.12,miring,,0,0,0,,Tunggu dia di sini
Dialog: 0,0:57:12.83,0:57:16.09,teks umum,,0,0,0,,Mu Dok terlihat di samping mayat, jelas kenapa dia dibawa pergi
Dialog: 0,0:57:16.17,0:57:18.67,teks umum,,0,0,0,,Tapi kenapa pak? Dia berada di istana
Dialog: 0,0:57:20.05,0:57:22.59,teks umum,,0,0,0,,Apa yang dipikirkan kepala?
Dialog: 0,0:57:22.68,0:57:23.68,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:57:26.31,0:57:27.35,teks umum,,0,0,0,,Yul,
Dialog: 0,0:57:27.43,0:57:29.56,teks umum,,0,0,0,,Moo Dok tidak akan membunuh siapa pun
Dialog: 0,0:57:30.18,0:57:31.27,miring,,0,0,0,,Benarkah?
Dialogue: 0,0:57:34.36,0:57:36.52,teks umum,,0,0,0,,Bolehkah aku melihat mayatnya?
Dialog: 0,0:57:49.41,0:57:51.29,teks umum,,0,0,0,,Pembunuh mengayunkan pedang dengan terampil
Dialog: 0,0:57:51.91,0:57:53.54,teks umum,,0,0,0,,Ini tidak mungkin Moo Deok
Dialog: 0,0:57:55.17,0:57:56.75,di luar layar,,0,0,0,,Tapi dia adalah Nak Soo
Dialog: 0,0:57:57.71,0:57:59.46,di luar layar,,0,0,0,,Dia bisa saja membunuh mereka
Dialog: 0,0:58:04.64,0:58:07.55, kenangan miring,,0,0,0,,Saya punya alasan tersendiri,
Dialog: 0,0:58:07.64,0:58:09.06, kenangan miring,,0,0,0,,jangan ganggu aku
Dialogue: 0,0:58:12.64,0:58:15.48,teks umum,,0,0,0,,- Ini dia para bandit\N- Tahukah kamu mereka?
Dialog: 0,0:58:17.77,0:58:20.03,teks umum,,0,0,0,,Aku melawan mereka belum lama ini
Dialog: 0,0:58:25.28,0:58:27.83,teks umum,,0,0,0,,Bolehkah saya mengambil jenazah mereka dan mengadakan pemakaman?
Dialog: 0,0:58:34.37,0:58:36.50,teks umum,,0,0,0,,Apa yang membawa Kepala Chwisonra ke sini?
Dialog: 0,0:58:36.58,0:58:38.09,teks umum,,0,0,0,,Apakah ada yang mati?
Dialog: 0,0:58:38.17,0:58:40.63,teks umum,,0,0,0,,Penjaga kami terbunuh
Dialog: 0,0:58:53.93,0:58:55.31,teks umum,,0,0,0,,Dan Gu
Dialog: 0,0:58:55.39,0:58:57.31,teks umum,,0,0,0,,Hamba Kim bercerita tentang apa yang terjadi
Dialog: 0,0:58:59.23,0:59:00.61,teks umum,,0,0,0,,Cho Young,
Dialog: 0,0:59:01.61,0:59:03.24,teks umum,,0,0,0,,bantu Moo Dok
Dialog: 0,0:59:11.12,0:59:13.87,teks umum,,0,0,0,,Saya pergi ke sana untuk membeli tiket
Dialog: 0,0:59:15.71,0:59:17.58,teks umum,,0,0,0,,Moo Deok ada disana
Dialog: 0,0:59:19.67,0:59:20.71,teks umum,,0,0,0,,Tentu saja,
Dialog: 0,0:59:20.79,0:59:24.59,teks umum,,0,0,0,,ini pertama kalinya aku berada di tempat seperti itu
Dialog: 0,0:59:25.17,0:59:26.26,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:59:27.09,0:59:30.85,teks umum,,0,0,0,,Kami berbicara sedikit, lalu Moo Deok masuk
Dialog: 0,0:59:30.93,0:59:32.89,teks umum,,0,0,0,,Aku juga melihatmu saat kamu masuk
Dialog: 0,0:59:33.81,0:59:38.27,teks umum,,0,0,0,,Tentu saja, aku tak menyangka akan melihatmu di tempat seperti ini
Dialog: 0,0:59:39.94,0:59:41.11,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:59:44.57,0:59:45.99,teks umum,,0,0,0,,Inilah yang terjadi...
Dialogue: 0,0:59:47.03,0:59:51.12,teks umum,,0,0,0,,Moo Dok tidak akan pernah punya cukup waktu untuk membunuh orang-orang itu
Dialog: 0,0:59:52.16,0:59:55.37,teks umum,,0,0,0,,Baru-baru ini seorang gadis datang ke Chwisung-ru, mencari Moo Deok
Dialog: 0,0:59:55.45,0:59:56.91,teks umum,,0,0,0,,Dia berpura-pura menjadi pesulap
Dialog: 0,0:59:57.00,0:59:58.50,teks umum,,0,0,0,,Chwisongru berpikir,
Dialog: 0,0:59:58.58,1:00:02.54,teks umum,,0,0,0,,ini bisa jadi So Yi, gadis yang diperingatkan oleh saudagar itu kepada Moo Deok
Dialog: 0,1:00:02.63,1:00:05.01,teks umum,,0,0,0,,Saya pernah melihat seorang gadis diseret oleh bandit-bandit ini
Dialog: 0,1:00:06.34,1:00:07.59,teks umum,,0,0,0,,Pedagang,
Dialog: 0,1:00:07.67,1:00:08.97,teks umum,,0,0,0,,bandit dan penjaga
Dialog: 0,1:00:09.84,1:00:12.10,teks umum,,0,0,0,,Semuanya bersinggungan dengan ini Jadi aku
Dialog: 0,1:00:12.18,1:00:14.01,teks umum,,0,0,0,,Penipu ini So Yi sangat mencurigakan
Dialog: 0,1:00:14.89,1:00:17.14,teks umum,,0,0,0,,Ini berarti Moo Deok tidak bisa disalahkan
Dialog: 0,1:00:18.69,1:00:19.73,teks umum,,0,0,0,,Oke
Dialog: 0,1:00:20.73,1:00:25.32,teks umum,,0,0,0,,Saya sendiri ragu kalau Moo Dok bisa membunuh seseorang
Dialog: 0,1:00:25.40,1:00:29.53,teks umum,,0,0,0,,Itu saja. Anda tahu, paman, bahwa Moo Deok tidak mampu melakukan ini, bukan?
Dialog: 0,1:00:29.61,1:00:33.16,teks umum,,0,0,0,,Bisakah kamu melepaskan Wook dan Moo Deok sekarang?
Dialog: 0,1:00:33.24,1:00:35.49,teks umum,,0,0,0,,Saya menguncinya sehingga
Dialog: 0,1:00:36.37,1:00:38.33,teks umum,,0,0,0,,tanyakan sesuatu
Dialogue: 0,1:00:39.37,1:00:40.87,italic,,0,0,0,,Aku urus sendiri sisanya
Dialog: 0,1:00:40.96,1:00:42.08,teks umum,,0,0,0,,Kamu bisa pergi
Dialog: 0,1:00:42.17,1:00:43.34,teks umum,,0,0,0,,Oke
Dialog: 0,1:01:02.27,1:01:03.52,teks umum,,0,0,0,,Bab
Dialog: 0,1:01:04.27,1:01:06.90,teks umum,,0,0,0,,Setidaknya beritahu aku ada apa
Dialog: 0,1:01:07.69,1:01:10.15,teks umum,,0,0,0,,Moo Dok melakukan pembunuhan
Dialog: 0,1:01:13.28,1:01:14.28,teks umum,,0,0,0,,Apa...
Dialog: 0,1:01:14.37,1:01:17.45,teks umum,,0,0,0,,Dia membunuh orang-orang yang mengenalnya di masa lalu
Dialog: 0,1:01:20.62,1:01:24.67,teks umum,,0,0,0,,Katakan padaku apa yang kamu dan Moo Deok sembunyikan
Dialog: 0,1:01:25.84,1:01:28.30,teks umum,,0,0,0,,Jika perkataanmu tidak sesuai dengan perkataan Moo Deok,
Dialog: 0,1:01:28.88,1:01:31.22,teks umum,,0,0,0,,kamu tidak akan meninggalkan ruangan ini
Dialog: 0,1:01:32.05,1:01:33.80,teks umum,,0,0,0,,Dan Moo Deok akan mati
Dialog: 0,1:01:55.12,1:01:56.66,teks umum,,0,0,0,,Bab, dengarkan...
Dialog: 0,1:01:56.74,1:01:58.08,teks umum,,0,0,0,,Ini bukan tentang pembunuhan
Dialog: 0,1:02:00.04,1:02:02.00,teks umum,,0,0,0,,Inggris mengungkapkan rahasiamu kepadaku
Dialog: 0,1:02:03.29,1:02:04.54,teks umum,,0,0,0,,Dia menceritakan semuanya
Dialog: 0,1:02:08.13,1:02:12.05,teks umum,,0,0,0,,Jika kamu juga mengatakan yang sebenarnya, aku akan mengampuni nyawamu
Dialog: 0,1:02:13.18,1:02:14.34,teks umum,,0,0,0,,Tetapi jika,
Dialog: 0,1:02:14.43,1:02:17.51,teks umum,,0,0,0,,kata-katamu akan berbeda,
Dialog: 0,1:02:19.43,1:02:20.89,teks umum,,0,0,0,,kamu akan mati
Dialog: 0,1:02:29.82,1:02:31.69, sulih suara,,0,0,0,,Jika dia tahu bahwa dia adalah seorang pengembara,
Dialog: 0,1:02:31.78,1:02:33.74,di belakang layar,,0,0,0,,tidak akan membuang waktu seperti ini
Dialog: 0,1:02:33.82,1:02:36.41,di luar layar,,0,0,0,,Dia mencoba memisahkan kita dengan menginterogasi kita secara terpisah
Dialog: 0,1:02:37.24,1:02:39.58,di belakang layar,,0,0,0,,Kita harus mengatakan hal yang sama
Dialog: 0,1:02:41.37,1:02:44.62,sulih suara,,0,0,0,,Apa yang akan dijawab Chan Wook?
Dialog: 0,1:02:44.71,1:02:48.54,di balik layar,,0,0,0,,Rahasia yang dijamin akan kami berdua ungkapkan
Dialog: 0,1:02:48.63,1:02:53.22,di balik layar,,0,0,0,,Sebuah rahasia, pengungkapannya tidak akan menyebabkan kematianku
Dialog: 0,1:02:56.30,1:02:57.76,teks umum,,0,0,0,,aku beritahu kamu
Dialog: 0,1:02:57.84,1:02:59.22,teks umum,,0,0,0,,Aku mengaku padamu
Dialog: 0,1:03:06.90,1:03:08.36,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,1:03:09.36,1:03:11.32,teks umum,,0,0,0,,Moo Deok dan Chan Wook
Dialog: 0,1:03:12.19,1:03:13.32,teks umum,,0,0,0,,kamu boleh melepaskannya
Dialog: 0,1:03:13.82,1:03:16.86,teks umum,,0,0,0,,Apa yang mereka katakan? Satu dan sama?
Dialogue: 0,1:03:20.08,1:03:23.08,teks umum,,0,0,0,,Mereka bilang... hal yang sama
Dialog: 0,1:03:52.57,1:03:55.44,teks umum,,0,0,0,,- Anda meninggalkan\N- Anda juga
Dialog: 0,1:03:56.03,1:03:58.91,teks umum,,0,0,0,,- Senang kamu baik-baik saja\N- Aku juga
Dialog: 0,1:03:58.99,1:04:00.82,teks umum,,0,0,0,,Syukurlah, kami mengatakan hal yang sama
Dialog: 0,1:04:02.37,1:04:03.87,teks umum,,0,0,0,,Apa katamu?
Dialog: 0,1:04:03.95,1:04:05.66,teks umum,,0,0,0,,Kami berdua pergi...
Dialog: 0,1:04:07.04,1:04:09.04,teks umum,,0,0,0,,jadi kamu mengatakan hal yang sama
Dialogue: 0,1:04:14.00,1:04:17.47,teks umum,,0,0,0,,Kau mengurung mereka untuk mencari tahu apa yang mereka sembunyikan
Dialog: 0,1:04:17.55,1:04:19.47,teks umum,,0,0,0,,Saya pikir Anda menemukan sesuatu
Dialog: 0,1:04:19.55,1:04:20.39,teks umum,,0,0,0,,Beri tahu
Dialog: 0,1:04:20.47,1:04:22.85,teks umum,,0,0,0,,Apa rahasianya?
Dialog: 0,1:04:23.76,1:04:25.18,teks umum,,0,0,0,,Mereka...
Dialog: 0,1:04:26.27,1:04:29.73,teks umum,,0,0,0,,benar-benar membuatku terdiam
Dialog: 0,1:04:32.56,1:04:35.19,teks umum,,0,0,0,,Mereka menunjukkan hal yang sama
Dialog: 0,1:04:37.11,1:04:38.49,kenangan miring,,0,0,0,,Saya akan mengatakan yang sebenarnya
Dialog: 0,1:04:39.40,1:04:41.03,kenangan,,0,0,0,,Aku berusaha untuk tidak ketahuan
Dialog: 0,1:04:42.28,1:04:44.08,kenangan,,0,0,0,,Inilah yang aku sembunyikan
Dialog: 0,1:05:01.72,1:05:03.22,kenangan,,0,0,0,,Kau tahu, aku...
Dialog: 0,1:05:03.72,1:05:06.10,kenangan,,0,0,0,,Sebenarnya aku...
Dialog: 0,1:05:13.06,1:05:14.69,kenangan,,0,0,0,,cinta Moo Deok
Dialog: 0,1:05:18.53,1:05:20.36,kenangan,,0,0,0,,Aku sangat mencintai pemiliknya
Dialog: 0,1:05:26.74,1:05:29.20,teks umum,,0,0,0,,Saya pikir Anda mungkin akan mengakuinya
Dialog: 0,1:05:31.04,1:05:33.42,teks umum,,0,0,0,,Mereka tidak akan membunuhku karena ini
Dialog: 0,1:05:33.50,1:05:37.25,teks umum,,0,0,0,,Ya, dan tidak ada apa pun tentang ini di buku peraturan Sosnovy Bor
Dialog: 0,1:05:37.34,1:05:39.71,teks umum,,0,0,0,,Tidak ada larangan bagi laki-laki untuk mencintai perempuan
Dialog: 0,1:05:42.88,1:05:43.72,teks umum,,0,0,0,,Ya
Dialog: 0,1:05:43.80,1:05:47.85,teks umum,,0,0,0,,Dan cinta seorang hamba kepada tuannya tidak akan membawa pada kematian
Dialog: 0,1:05:49.93,1:05:53.23,teks umum,,0,0,0,,Itukah yang kamu katakan? Mengapa kamu mencintaiku sampai mati?
Dialog: 0,1:05:54.98,1:05:56.11,teks umum,,0,0,0,,Yah...
Dialog: 0,1:05:56.82,1:06:00.03,teks umum,,0,0,0,,Saya membesar-besarkan agar dia percaya
Dialog: 0,1:06:03.28,1:06:04.82,teks umum,,0,0,0,,Tidak ada pilihan lain
Dialog: 0,1:06:06.20,1:06:09.70,teks umum,,0,0,0,,Tidak ada pilihan selain mengakui bahwa kamu mencintaiku sampai mati
Dialogue: 0,1:06:10.91,1:06:12.62,teks umum,,0,0,0,,Aku malah minta maaf
Dialog: 0,1:06:13.33,1:06:15.71,teks umum,,0,0,0,,Aku tidak terlalu menaruh perasaan pada pengakuanku
Dialog: 0,1:06:16.25,1:06:17.54,teks umum,,0,0,0,,Kami harus mencoba
Dialog: 0,1:06:17.63,1:06:18.80,teks umum,,0,0,0,,Lupakan
Dialog: 0,1:06:20.59,1:06:24.59,teks umum,,0,0,0,,Jangan pertaruhkan segalanya untuk sesuatu yang berubah-ubah seperti cinta
Dialog: 0,1:06:25.93,1:06:27.85,teks umum,,0,0,0,,Jika ini terjadi lagi,
Dialog: 0,1:06:28.60,1:06:30.89,teks umum,,0,0,0,,dan hidup akan tergantung pada pilihan,
Dialog: 0,1:06:31.98,1:06:33.23,teks umum,,0,0,0,,mengkhianati cinta
Dialog: 0,1:06:34.52,1:06:35.73,teks umum,,0,0,0,,dan pilih kehidupan
Dialog: 0,1:06:38.11,1:06:39.73,miring,,0,0,0,,Kecuali, tentu saja, kamu ingin mati
Dialog: 0,1:06:40.65,1:06:42.19,teks umum,,0,0,0,,Ini perintah guru
Dialog: 0,1:06:47.24,1:06:48.37,teks umum,,0,0,0,,Guru,
Dialog: 0,1:06:49.08,1:06:50.62,teks umum,,0,0,0,,bagaimana jika saya tidak keberatan mati?
Dialog: 0,1:06:51.41,1:06:53.83,teks umum,,0,0,0,,Bolehkah aku terus mencintaimu?
Dialog: 0,1:06:56.29,1:06:58.42,teks umum,,0,0,0,,Dengan kata lain, saya siap mempertaruhkan segalanya,
Dialog: 0,1:06:59.38,1:07:01.17,teks umum,,0,0,0,,agar kita bisa bersama
Dialog: 0,1:07:02.55,1:07:04.17,teks umum,,0,0,0,,saya akan melakukannya
Dialog: 0,1:07:04.72,1:07:09.18,teks umum,,0,0,0,,Lakukan hal yang sama, pertahankan pengakuanmu
Dialog: 0,1:07:10.72,1:07:12.31,teks umum,,0,0,0,,Cintai aku sampai mati
Dialog: 0,1:07:51.81,1:07:55.73,pratinjau,,0,0,0,,Jika Uk mencintai seseorang yang tidak seharusnya,
Dialog: 0,1:07:55.81,1:07:57.23,pratinjau,,0,0,0,,apa yang akan kamu lakukan?
Dialog: 0,1:07:57.31,1:08:01.27,pratinjau,,0,0,0,,Jika aku bersamamu, aku perlu memastikan bahwa kamu milikku
Dialog: 0,1:08:01.36,1:08:03.23,pratinjau,,0,0,0,,Beraninya kau mempermalukan Jinyeowon?
Dialog: 0,1:08:03.98,1:08:05.03,pratinjau,,0,0,0,,- Asin\N- Dua sepatu bot - sepasang
Dialog: 0,1:08:05.11,1:08:06.40,pratinjau,,0,0,0,,Kenapa kamu tidak menikah?
Dialog: 0,1:08:06.49,1:08:08.24,pratinjau,,0,0,0,,Saya mencari dukun Choi
Dialog: 0,1:08:08.32,1:08:11.16,pratinjau,,0,0,0,,Jika dukun itu diburu oleh para penyihir Jeonbugwan...
Dialog: 0,1:08:11.24,1:08:14.08,pratinjau,,0,0,0,,Apakah kamu mencarinya karena dia menyimpan dendam terhadap ayahmu?
Dialog: 0,1:08:14.16,1:08:16.87,pratinjau,,0,0,0,,Kalau dia datang segera lapor
Dialog: 0,1:08:16.96,1:08:18.54,pratinjau,,0,0,0,,Bahkan mati, ini Gwigu
Dialog: 0,1:08:18.62,1:08:20.50,pratinjau,,0,0,0,,Pura-pura tidak tahu ya?
Dialog: 0,1:08:21.17,1:08:23.75,pratinjau,,0,0,0,,Sulit bagimu, bukan?
Dialog: 0,1:08:23.84,1:08:26.17,pratinjau,,0,0,0,,Jika kamu harus menghunus pedang dan mengarahkannya ke seseorang,
Dialog: 0,1:08:26.26,1:08:28.55,pratinjau,,0,0,0,,biarkan aku menjadi yang pertama
Dialog: 0,0:02:55.14,0:02:57.14, torehan,,0,0,0,,

