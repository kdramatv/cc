Dialogue: 0,0:02:47.14,0:02:52.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,النكات,,0,0,0,,مترجمو الطباعة:{\c&HFFF4C5&} Ria_Lee، ألينا، زيرو أماميا
Dialogue: 0,0:00:43.74,0:00:45.28,نص عام,,0,0,0,,ماذا لو لم يكن لدي مانع من الموت؟
Dialogue: 0,0:00:46.03,0:00:48.41,نص عام,,0,0,0,,هل يمكنني الاستمرار في حبك إذن؟
Dialogue: 0,0:00:50.87,0:00:53.00,general text,,0,0,0,,بمعنى آخر، أنا مستعد للمخاطرة بكل شيء،
Dialogue: 0,0:00:53.96,0:00:55.75,نص عام,,0,0,0,,حتى نتمكن من أن نكون معًا
Dialogue: 0,0:00:57.09,0:00:59.21,نص عام,,0,0,0,,سأفعل ذلك
Dialogue: 0,0:00:59.30,0:01:03.76,نص عام,,0,0,0,,افعل نفس الشيء، وتمسك باعترافك
Dialogue: 0,0:01:05.34,0:01:07.30,نص عام,,0,0,0,,أحبني حتى الموت
Dialogue: 0,0:01:21.19,0:01:23.95,النص العام,,0,0,0,,مو دوك، لا تنظر إلي بهذه الطريقة
Dialogue: 0,0:01:24.03,0:01:27.24,general text,,0,0,0,,إذا نظرت للأمر بهذه الطريقة، فلن يصدق أحد كلامك.
Dialogue: 0,0:01:28.41,0:01:29.95,نص عام,,0,0,0,,ثم يا معلم,
Dialogue: 0,0:01:30.04,0:01:34.00,النص العام,,0,0,0,,كيف يمكنني التأكد من أن الجميع يؤمنون بحبي؟
Dialogue: 0,0:01:35.58,0:01:36.83,نص عام,,0,0,0,,حسنًا، أولاً...
Dialogue: 0,0:01:38.25,0:01:40.46,نص عام,,0,0,0,,وجهة نظرك غير مناسبة على الإطلاق
Dialogue: 0,0:01:41.76,0:01:44.13,نص عام,,0,0,0,,يجب أن يكون هناك حنان في النظرة
Dialogue: 0,0:01:46.55,0:01:47.76,نص عام,,0,0,0,,أعتقد أن هذا مستحيل
Dialogue: 0,0:01:48.97,0:01:50.93,النص العام,,0,0,0,,لماذا قلت أنك تحبني؟
Dialogue: 0,0:01:51.02,0:01:54.31,نص عام,,0,0,0,,كان يجب أن أقول أنك معجب بي
Dialogue: 0,0:01:55.94,0:01:58.31,نص عام,,0,0,0,,لنفترض أنني أبدو بحنان
Dialogue: 0,0:01:58.40,0:02:00.52,نص عام,,0,0,0,,وأحبك
Dialogue: 0,0:02:00.61,0:02:02.69,نص عام,,0,0,0,,وماذا بعد ذلك؟
Dialogue: 0,0:02:02.78,0:02:04.07,نص عام,,0,0,0,,لاحقاً؟
Dialogue: 0,0:02:04.15,0:02:07.03,نص عام,,0,0,0,,أحبك عمياء،
Dialogue: 0,0:02:07.11,0:02:09.91,general text,,0,0,0,,بينما الخادمة كيم تحاول يائسة الزواج منك؟
Dialogue: 0,0:02:10.99,0:02:14.16,نص عام,,0,0,0,,ماذا سيحدث لي؟
Dialogue: 0,0:02:14.83,0:02:18.00,نص عام,,0,0,0,,لا تقلق، لن أتزوج
Dialogue: 0,0:02:18.08,0:02:19.75,نص عام,,0,0,0,,لن يفعل
Dialogue: 0,0:02:19.84,0:02:22.67,general text,,0,0,0,,هل هذا سبب رفضك لشاي العفة؟
Dialogue: 0,0:02:25.05,0:02:28.22,نص عام,,0,0,0,,أفهم بشكل صحيح ما تطلبه
Dialogue: 0,0:02:28.30,0:02:31.31,نص عام,,0,0,0,,نوع من الوعد أو شيء من هذا القبيل؟
Dialogue: 0,0:02:31.39,0:02:33.27,نص عام,,0,0,0,,إذا أحببتك,
Dialogue: 0,0:02:34.43,0:02:36.81,نص عام,,0,0,0,,مما يعني أنني يجب أن أتأكد من أنك ملكي
Dialogue: 0,0:02:39.06,0:02:43.03,نص عام,,0,0,0,,دعونا لا نتعجل الأمور
Dialogue: 0,0:02:43.11,0:02:44.03,نص عام,,0,0,0,,رفض
Dialogue: 0,0:02:45.94,0:02:48.82,نص عام,,0,0,0,,لماذا الأمر صعب معك إلى هذه الدرجة؟
Dialogue: 0,0:02:48.91,0:02:51.45,نص عام,,0,0,0,,لقد طلبت منك فقط عدم التسرع
Dialogue: 0,0:02:51.53,0:02:54.54,نص عام,,0,0,0,,أريد التحدث مع الخادمة كيم
Dialogue: 0,0:02:54.62,0:02:55.62,نص عام,,0,0,0,,ألقي نظرة
Dialogue: 0,0:02:56.54,0:02:57.37,نص عام,,0,0,0,,انسى
Dialogue: 0,0:02:58.46,0:03:00.17,نص عام,,0,0,0,,نظرة حنونة حتى تتمكن من
Dialogue: 0,0:03:00.25,0:03:02.84,النص العام,,0,0,0,,سأنظر إليك وكأنك كلب رديء
Dialogue: 0,0:03:02.92,0:03:04.00,نص عام,,0,0,0,,كلب؟
Dialogue: 0,0:03:04.92,0:03:05.96,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:03:06.05,0:03:09.51,نص عام,,0,0,0,,نسيت أن أقول شيئًا مهمًا
Dialogue: 0,0:03:10.14,0:03:11.93,نص عام,,0,0,0,,كان كلباً
Dialogue: 0,0:03:12.51,0:03:14.06,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:03:14.14,0:03:17.35,general text,,0,0,0,,الكلب الذي كان مع السيد لي في دانهيانغك. هل تذكر؟
Dialogue: 0,0:03:18.14,0:03:19.23,نص عام,,0,0,0,,سابساري؟
Dialogue: 0,0:03:19.31,0:03:20.65,نص عام,,0,0,0,,نعم
Dialogue: 0,0:03:21.77,0:03:23.02,نص عام,,0,0,0,,هذا غويغو
Dialogue: 0,0:03:26.07,0:03:30.66,general text,,0,0,0,,علم السيد "لي" منذ البداية أنك بدويّ.
Dialogue: 0,0:03:30.74,0:03:31.91,نص عام,,0,0,0,,ربما
Dialogue: 0,0:03:32.83,0:03:34.62,نص عام,,0,0,0,,حتى أنه يعرف أنك ناك سو
Dialogue: 0,0:03:48.17,0:03:51.76,general text,,0,0,0,,ما الذي أتى برأس جينيوون في مثل هذه الساعة؟
Dialogue: 0,0:03:57.27,0:03:58.98,نص عام,,0,0,0,,ربما جئت من أجلك
Dialogue: 0,0:03:59.98,0:04:01.10,نص عام,,0,0,0,,سمعت,
Dialogue: 0,0:04:01.19,0:04:04.65,general text,,0,0,0,,لقد أخذت غويغا، أحد بقايا جينيفون، إلى القصر
Dialogue: 0,0:04:04.73,0:04:07.53,نص عام,,0,0,0,,كنا نبحث عن آثار السحر الأسود
Dialogue: 0,0:04:07.61,0:04:12.11,نص عام,,0,0,0,,أنا أحذرك: من الأفضل عدم إشراك جينيوون في أي عمل مع البدو
Dialogue: 0,0:04:12.20,0:04:14.37,نص عام,,0,0,0,,لماذا تستخدم غابة باين جينيوون؟
Dialogue: 0,0:04:16.66,0:04:18.58,نص عام,,0,0,0,,سحرة المجلس الموحد
Dialogue: 0,0:04:18.66,0:04:20.33,نص عام,,0,0,0,,يجب منع السحر الأسود
Dialogue: 0,0:04:20.41,0:04:24.21,general text,,0,0,0,,ويجب على جينيوون أن يساعد سوسنوفي بور في هذا الأمر.
Dialogue: 0,0:04:24.79,0:04:26.46,نص عام,,0,0,0,,هل تعتقد؟
Dialogue: 0,0:04:26.55,0:04:29.51,نص عام,,0,0,0,,إذن أنت تستخدمنا مرة أخرى
Dialogue: 0,0:04:30.22,0:04:33.09,نص عام,,0,0,0,,ثم سأخذ جفيجا
Dialogue: 0,0:04:34.34,0:04:35.55,مائل,,0,0,0,,أحضروه إليّ
Dialogue: 0,0:04:36.31,0:04:39.98,general text,,0,0,0,,أم يجب أن أذهب لإحضاره بنفسي؟
Dialogue: 0,0:04:40.73,0:04:42.19,خط مائل,,0,0,0,,غويغو هنا
Dialogue: 0,0:04:52.61,0:04:55.82,general text,,0,0,0,,غويغو هو بقايا أنشأها المعلم سو كيونغ
Dialogue: 0,0:04:55.91,0:04:57.49,general text,,0,0,0,,لسوسنوفي بور نفس الحقوق فيه
Dialogue: 0,0:04:57.58,0:04:59.87,general text,,0,0,0,,ما هي حقوقك في بقايا جينيوون؟
Dialogue: 0,0:04:59.95,0:05:03.58,general text,,0,0,0,,هل تريد أن تقول أن جينيوون هو مخزن غابة الصنوبر؟
Dialogue: 0,0:05:03.67,0:05:05.42,نص عام,,0,0,0,,ليس هذا ما قصده
Dialogue: 0,0:05:05.50,0:05:09.09,general text,,0,0,0,,أنت تعتقد بلا خجل أن كل كنوز جينيوون ملك لك
Dialogue: 0,0:05:09.17,0:05:11.55,general text,,0,0,0,,تأخذ الأشياء دون أن تسألها ولا تردها
Dialogue: 0,0:05:12.13,0:05:13.93,نص عام,,0,0,0,,هؤلاء هم أهل سوسنوفي بور
Dialogue: 0,0:05:16.39,0:05:20.06,نص عام,,0,0,0,,لقد قلت هذا من قبل
Dialogue: 0,0:05:21.77,0:05:25.98,general text,,0,0,0,,أن ساحر سوسنوفي بور أخذ منك شيئاً
Dialogue: 0,0:05:33.49,0:05:34.95,نص عام,,0,0,0,,من كان؟
Dialogue: 0,0:05:46.12,0:05:48.92,نص عام,,0,0,0,,إنه أمامي مباشرة
Dialogue: 0,0:05:49.96,0:05:52.59,النص العام,,0,0,0,,لقد تسلل إلى جينيوون
Dialogue: 0,0:05:52.67,0:05:54.34,النص العام,,0,0,0,,وسرقوا غويجا
Dialogue: 0,0:05:55.43,0:05:59.72,النص العام,,0,0,0,,كيف تجرؤ على وصف السيد "لي" باللص؟!
Dialogue: 0,0:05:59.81,0:06:02.68,general text,,0,0,0,,ماذا تسمي الشخص الذي يسرق ممتلكات شخص آخر؟
Dialogue: 0,0:06:03.35,0:06:05.69,نص عام,,0,0,0,,أمي من فضلك
Dialogue: 0,0:06:05.77,0:06:09.86,general text,,0,0,0,,لقد نقل السيد "لي" روح "غويجو" من الجرة المكسورة
Dialogue: 0,0:06:09.94,0:06:11.65,نص عام,,0,0,0,,في جسد كلب
Dialogue: 0,0:06:11.73,0:06:13.57,مائل,,0,0,0,,وحطموا سلة المهملات تلك في سوسنوفي بور
Dialogue: 0,0:06:13.65,0:06:14.82,خط مائل,,0,0,0,,انظر!
Dialogue: 0,0:07:16.55,0:07:18.26,نص عام,,0,0,0,,لقد مات يا سيدي.
Dialogue: 0,0:07:22.14,0:07:23.72,نص عام,,0,0,0,,لقد قمت بحماية ابنتي
Dialogue: 0,0:07:23.81,0:07:27.18,general text,,0,0,0,,سيد لي، هل أمرت جويج بمهاجمتنا؟
Dialogue: 0,0:07:27.27,0:07:29.85,general text,,0,0,0,,هاجم غويغو لأنه شعر بالسحر الأسود
Dialogue: 0,0:07:33.98,0:07:35.32,نص عام,,0,0,0,,هذا يعني،
Dialogue: 0,0:07:37.15,0:07:39.11,نص عام,,0,0,0,,أن الآنسة جين الصغيرة مرتبطة بها بطريقة أو بأخرى
Dialogue: 0,0:07:47.29,0:07:50.00,خارج الشاشة,,0,0,0,,ربما كل ذلك بسبب تلك الدودة ذات السحر الأسود
Dialogue: 0,0:07:56.96,0:07:58.05,نص عام,,0,0,0,,الآنسة جين,
Dialogue: 0,0:07:59.01,0:08:00.13,نص عام,,0,0,0,,أنت
Dialogue: 0,0:08:00.93,0:08:02.59,نص عام,,0,0,0,,هل استخدمت السحر الأسود؟
Dialogue: 0,0:08:08.81,0:08:11.02,نص عام,,0,0,0,,سحر مظلم؟ يا له من هراء!
Dialogue: 0,0:08:11.10,0:08:12.35,نص عام,,0,0,0,,إن لم يكن كذلك,
Dialogue: 0,0:08:12.44,0:08:14.77,general text,,0,0,0,,لماذا هاجمتها غويغو؟
Dialogue: 0,0:08:15.36,0:08:18.40,general text,,0,0,0,,سوسنوفي بور تحاول الآن التشهير بابنتي
Dialogue: 0,0:08:18.49,0:08:19.99,نص عام,,0,0,0,,توقف!
Dialogue: 0,0:08:20.65,0:08:22.41,نص عام,,0,0,0,,السيد لي على حق
Dialogue: 0,0:08:25.99,0:08:27.20,نص عام,,0,0,0,,مؤخراً
Dialogue: 0,0:08:28.00,0:08:31.54,نص عام,,0,0,0,,لقد استخدمت السحر الأسود
Dialogue: 0,0:08:37.63,0:08:41.38,نص عام,,0,0,0,,لكنني لم أؤذي أحداً
Dialogue: 0,0:08:49.56,0:08:51.60,نص عام,,0,0,0,,هذا شائع جدًا الآن
Dialogue: 0,0:08:52.98,0:08:56.57,general text,,0,0,0,,هذه تعويذة لتعويذة حب حتى يحبك حبيبك
Dialogue: 0,0:09:02.53,0:09:04.53,نص عام,,0,0,0,,أعتقد أن هذا هو بيت القصيد
Dialogue: 0,0:09:12.04,0:09:15.13,نص عام,,0,0,0,,يبدو أن ابنتنا تسببت في سوء فهم
Dialogue: 0,0:09:15.21,0:09:16.29,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:09:40.07,0:09:43.86,النص العام,,0,0,0,,لقد عشت في جسد هذا الكلب،
Dialogue: 0,0:09:44.78,0:09:46.49,النص العام,,0,0,0,,والآن رحل عنا
Dialogue: 0,0:09:55.25,0:09:58.67,النص العام,,0,0,0,,غويغو لم يعد معنا
Dialogue: 0,0:10:00.67,0:10:02.09,نص عام,,0,0,0,,ماذا أفعل؟
Dialogue: 0,0:10:02.84,0:10:06.55,general text,,0,0,0,,هل ذنبي أن غويغو مات؟
Dialogue: 0,0:10:06.64,0:10:07.51,نص عام,,0,0,0,,جين تشو يونغ!
Dialogue: 0,0:10:08.26,0:10:10.64,النص العام,,0,0,0,,كيف تجرؤ على فضح جينيوون؟
Dialogue: 0,0:10:35.04,0:10:36.58,النص العام,,0,0,0,,غويغو مات؟
Dialogue: 0,0:10:37.50,0:10:38.54,نص عام,,0,0,0,,نعم
Dialogue: 0,0:10:38.63,0:10:41.46,نص عام,,0,0,0,,قال السيد "لي" إنه سيدفنه غدًا
Dialogue: 0,0:10:42.88,0:10:44.71,تعليق صوتي,,0,0,0,,لذا كان غويغو
Dialogue: 0,0:10:48.26,0:10:51.14,تعليق صوتي,,0,0,0,,لقد عرف منذ البداية أنني بدويّ
Dialogue: 0,0:10:51.93,0:10:54.18,التعليق الصوتي,,0,0,0,,لكنه لم يزمجر في وجهي أبدًا
Dialogue: 0,0:10:55.18,0:10:58.60,خارج الشاشة,,0,0,0,,هل غطاني بهذه الطريقة؟
Dialogue: 0,0:11:03.23,0:11:04.86,النص العام,,0,0,0,,حتى ميت، هذا غويغو
Dialogue: 0,0:11:05.86,0:11:08.57,general text,,0,0,0,,من غير المحتمل أن تكون كل الطاقة قد غادرت الجسم. لا تلمس
Dialogue: 0,0:11:16.87,0:11:19.33,النص العام,,0,0,0,,هل ذهب أهل جينيوون؟
Dialogue: 0,0:11:19.42,0:11:21.04,نص عام,,0,0,0,,إنهم يناقشون مشكلة أخرى
Dialogue: 0,0:11:21.63,0:11:22.63,نص عام,,0,0,0,,مشكلة أخرى
Dialogue: 0,0:11:23.34,0:11:24.84,النص العام,,0,0,0,,اتضح أن دان جو وتشو يونغ
Dialogue: 0,0:11:25.88,0:11:27.09,نص عام,,0,0,0,,حدث
Dialogue: 0,0:11:28.34,0:11:29.59,نص عام,,0,0,0,,- ماذا؟\N- ماذا؟
Dialogue: 0,0:11:30.64,0:11:33.93,النص العام,,0,0,0,,لقد دمرت بقايا جينيوون،
Dialogue: 0,0:11:34.01,0:11:35.89,نص عام,,0,0,0,,ليس خطأك
Dialogue: 0,0:11:36.47,0:11:38.39,نص عام,,0,0,0,,حان الوقت لنا
Dialogue: 0,0:11:39.44,0:11:41.65,نص عام,,0,0,0,,- هيا بنا\N- نعم
Dialogue: 0,0:11:41.73,0:11:42.98,نص عام,,0,0,0,,الآنسة جين
Dialogue: 0,0:11:43.06,0:11:45.32,نص عام,,0,0,0,,اشرب بعض الشاي قبل الرحيل
Dialogue: 0,0:11:45.90,0:11:48.11,نص عام,,0,0,0,,علينا توضيح كل شيء وتحسين العلاقات
Dialogue: 0,0:11:48.78,0:11:49.95,نص عام,,0,0,0,,العلاقات؟
Dialogue: 0,0:11:50.03,0:11:51.99,نص عام,,0,0,0,,إنهم واقعون في الحب
Dialogue: 0,0:11:52.07,0:11:54.45,general text,,0,0,0,,كانت تلك التعويذة مخصصة لدان غو،
Dialogue: 0,0:11:54.53,0:11:57.16,نص عام,,0,0,0,,هل أنا على حق؟
Dialogue: 0,0:11:59.54,0:12:01.79,نص عام,,0,0,0,,نعم. أنا السبب في كل شيء
Dialogue: 0,0:12:02.38,0:12:04.13,النص العام,,0,0,0,,تشو يونغ لم يرتكب أي خطأ
Dialogue: 0,0:12:04.21,0:12:05.21,نص عام,,0,0,0,,كن هادئًا
Dialogue: 0,0:12:07.84,0:12:09.55,نص عام,,0,0,0,,لقد اكتشفت ذلك مؤخرًا
Dialogue: 0,0:12:09.63,0:12:11.43,نص عام,,0,0,0,,لقد تكلم هراء
Dialogue: 0,0:12:11.51,0:12:14.26,نص عام,,0,0,0,,حول ما سيكونان عليه معًا عندما تعود ابنتك المتوفاة،
Dialogue: 0,0:12:14.35,0:12:16.10,نص عام,,0,0,0,,فأخبرته بذلك
Dialogue: 0,0:12:16.18,0:12:19.23,نص عام,,0,0,0,,ابنة متوفاة؟ بو يونغ على قيد الحياة وسنجدها قريبًا
Dialogue: 0,0:12:20.69,0:12:23.31,general text,,0,0,0,,هل تعتقد حقًا أن جين مو سيجدها؟
Dialogue: 0,0:12:23.94,0:12:26.82,النص العام,,0,0,0,,إنه يخدعك
Dialogue: 0,0:12:27.40,0:12:29.78,general text,,0,0,0,,أعطاك فكرة البحث في سوسنوفي بور
Dialogue: 0,0:12:29.86,0:12:31.70,نص عام,,0,0,0,,في هذه الساعة لالتقاط غفيجا؟
Dialogue: 0,0:12:31.78,0:12:33.99,النص العام,,0,0,0,,قلت لك ألا تتدخل في أعمال جينيون
Dialogue: 0,0:12:34.57,0:12:37.41,نص عام,,0,0,0,,دعونا لا نتشاجر
Dialogue: 0,0:12:37.49,0:12:40.62,النص العام,,0,0,0,,سيكون من الرائع أن يتم العثور على بو يونغ
Dialogue: 0,0:12:40.71,0:12:44.25,general text,,0,0,0,,العشيقة جين لا تريد أن تكون في عداوة مع سوسنوفي بور
Dialogue: 0,0:12:45.34,0:12:48.76,نص عام,,0,0,0,,دعونا نعمل معًا
Dialogue: 0,0:12:48.84,0:12:50.30,نص عام,,0,0,0,,من يدري؟
Dialogue: 0,0:12:50.38,0:12:54.01,general text,,0,0,0,,ربما يوحد دان غو وتشو يونغ عائلتين
Dialogue: 0,0:12:54.09,0:12:55.43,نص عام,,0,0,0,,أنا ضد
Dialogue: 0,0:12:55.51,0:12:58.22,general text,,0,0,0,,سيجد تشو يونغ حفلة أفضل
Dialogue: 0,0:12:59.72,0:13:03.65,general text,,0,0,0,,أين يمكنك العثور على عريس أفضل من رئيس سوسنوفي بور المستقبلي؟
Dialogue: 0,0:13:03.73,0:13:05.27,نص عام,,0,0,0,,ابنة عائلة جين
Dialogue: 0,0:13:05.36,0:13:08.11,نص عام,,0,0,0,,تستحق الزواج من ولي العهد
Dialogue: 0,0:13:09.65,0:13:10.61,نص عام,,0,0,0,,الأم,
Dialogue: 0,0:13:10.69,0:13:12.28,نص عام,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:13:13.24,0:13:14.45,نص عام,,0,0,0,,لا أريد
Dialogue: 0,0:13:15.24,0:13:17.33,نص عام,,0,0,0,,الأمير الشرير
Dialogue: 0,0:13:17.41,0:13:19.87,النص العام,,0,0,0,,- وأنا لا أحبه\N- جين تشو يونغ
Dialogue: 0,0:13:20.54,0:13:22.50,نص عام,,0,0,0,,سأتزوج من أحب
Dialogue: 0,0:13:24.04,0:13:24.87,نص عام,,0,0,0,,نعم
Dialogue: 0,0:13:25.50,0:13:27.42,نص عام,,0,0,0,,أنا حبيبها
Dialogue: 0,0:13:27.50,0:13:28.55,نص عام,,0,0,0,,بارك دان جو!
Dialogue: 0,0:13:34.47,0:13:35.64,نص عام,,0,0,0,,دعونا نتحدث في المنزل
Dialogue: 0,0:13:39.01,0:13:40.72,نص عام,,0,0,0,,اترك يدها ودعنا نذهب
Dialogue: 0,0:13:42.81,0:13:44.52,نص عام,,0,0,0,,دعها تذهب الآن
Dialogue: 0,0:13:44.60,0:13:46.44,نص عام,,0,0,0,,اترك يدها حتى تتمكن من المغادرة
Dialogue: 0,0:13:47.73,0:13:49.27,نص عام,,0,0,0,,دعه يذهب!
Dialogue: 0,0:13:49.36,0:13:50.44,نص عام,,0,0,0,,دعنا نذهب الآن!
Dialogue: 0,0:13:59.58,0:14:00.58,نص عام,,0,0,0,,جين تشو يونغ,
Dialogue: 0,0:14:00.66,0:14:03.58,النص العام,,0,0,0,,إذا كنت لا تريد الطاعة فلا تعد إلى المنزل
Dialogue: 0,0:14:12.76,0:14:15.55,نص عام,,0,0,0,,أعتقد أنه من الأفضل لنا أن نغادر
Dialogue: 0,0:14:18.26,0:14:19.89,نص عام,,0,0,0,,هل ستعود معنا إلى المنزل؟
Dialogue: 0,0:14:19.97,0:14:22.43,نص عام,,0,0,0,,هذه المرة لن أستسلم لأمي
Dialogue: 0,0:14:23.68,0:14:25.23,نص عام,,0,0,0,,افهم يا أبي
Dialogue: 0,0:14:27.73,0:14:30.40,نص عام,,0,0,0,,سأخبرك عندما تهدأ والدتك
Dialogue: 0,0:14:32.61,0:14:33.99,نص عام,,0,0,0,,اعتني بها الآن
Dialogue: 0,0:14:34.74,0:14:35.65,نص عام,,0,0,0,,نعم
Dialogue: 0,0:14:45.08,0:14:47.87,نص عام,,0,0,0,,عمي، آسف على الإزعاج،
Dialogue: 0,0:14:47.96,0:14:49.54,نص عام,,0,0,0,,لكنني سأحمي صديقتي
Dialogue: 0,0:14:49.63,0:14:50.46,نص عام,,0,0,0,,أنت أيضًا تضيع!
Dialogue: 0,0:15:00.68,0:15:03.85,نص عام,,0,0,0,,أين نذهب الآن؟
Dialogue: 0,0:15:05.98,0:15:07.23,نص عام,,0,0,0,,لا أعلم
Dialogue: 0,0:15:10.73,0:15:12.77,نص عام,,0,0,0,,قال ألا تعود إلى البيت،
Dialogue: 0,0:15:12.86,0:15:15.69,نص عام,,0,0,0,,يمكننا الذهاب إلى النزل و...
Dialogue: 0,0:15:16.36,0:15:18.24,نص عام,,0,0,0,,- أستأجر غرفة؟\N- ماذا؟
Dialogue: 0,0:15:20.62,0:15:21.78,نص عام,,0,0,0,,ليس هذا ما قصدته!
Dialogue: 0,0:15:21.87,0:15:24.70,نص عام,,0,0,0,,ليست واحدة، بل اثنتين مختلفتين
Dialogue: 0,0:15:27.96,0:15:30.33,نص عام,,0,0,0,,أنا لا أحب النزل
Dialogue: 0,0:15:32.09,0:15:35.00,نص عام,,0,0,0,,ليس هناك مكان آخر للذهاب إليه بعد
Dialogue: 0,0:15:35.09,0:15:36.59,نص عام,,0,0,0,,والجو يزداد برودة
Dialogue: 0,0:15:37.34,0:15:38.38,نص عام,,0,0,0,,بارد...
Dialogue: 0,0:15:40.89,0:15:42.18,نص عام,,0,0,0,,إلى أين نذهب؟
Dialogue: 0,0:15:42.26,0:15:43.64,خط مائل,,0,0,0,,سيد. حديقة!
Dialogue: 0,0:15:45.06,0:15:48.39,general text,,0,0,0,,قيل لي أنه تم إطلاق سراح السيد تشان، لكنه ليس في الغرفة
Dialogue: 0,0:15:48.48,0:15:49.81,نص عام,,0,0,0,,هل رأيته؟
Dialogue: 0,0:15:54.73,0:15:56.73,نص عام,,0,0,0,,هل هناك خطأ ما؟
Dialogue: 0,0:15:59.86,0:16:01.95,النص العام,,0,0,0,,- الخادمة كيم...\N- ماذا؟
Dialogue: 0,0:16:02.03,0:16:03.03,نص عام,,0,0,0,,العذراء كيم...
Dialogue: 0,0:16:03.12,0:16:05.03,نص عام,,0,0,0,,اترك يا سيد بارك
Dialogue: 0,0:16:05.79,0:16:08.33,نص عام,,0,0,0,,آنسة جين، ما هذا؟
Dialogue: 0,0:16:08.41,0:16:10.04,نص عام,,0,0,0,,العذراء كيم...
Dialogue: 0,0:16:10.12,0:16:12.58,general text,,0,0,0,,غويغو الذي نظم مذبحة في القصر،
Dialogue: 0,0:16:12.67,0:16:16.38,general text,,0,0,0,,دمرته السيدة جين في محاولة لمنعه
Dialogue: 0,0:16:16.46,0:16:18.21,النص العام,,0,0,0,,هل دمرت غويغو؟
Dialogue: 0,0:16:18.30,0:16:20.18,general text,,0,0,0,,لماذا ندمر ما سيحدد السحر الأسود؟
Dialogue: 0,0:16:20.26,0:16:22.64,نص عام,,0,0,0,,تعريف السحر الأسود
Dialogue: 0,0:16:22.72,0:16:25.68,general text,,0,0,0,,كان مجرد ذريعة لسوسنوفي بور لتهديد القصر
Dialogue: 0,0:16:26.26,0:16:27.89,خط مائل,,0,0,0,,جين مو على حق
Dialogue: 0,0:16:27.97,0:16:31.52,general text,,0,0,0,,حاولت سوسنوفي بور إظهار أنها أكثر تأثيراً منا
Dialogue: 0,0:16:32.81,0:16:34.69,general text,,0,0,0,,بحجة القضاء على الشر،
Dialogue: 0,0:16:34.77,0:16:37.28,النص العام,,0,0,0,,يمكن لغابة الصنوبر أن تجمع سحرة المجلس الموحد
Dialogue: 0,0:16:37.36,0:16:39.32,نص عام,,0,0,0,,وحرك الملك
Dialogue: 0,0:16:40.03,0:16:42.28,النص العام,,0,0,0,,لهذا ذكروا نجم الملك؟
Dialogue: 0,0:16:42.36,0:16:45.41,general text,,0,0,0,,تحذير من أن يتمكنوا من الإطاحة بي؟
Dialogue: 0,0:16:46.37,0:16:49.20,general text,,0,0,0,,بدأ السيد "لي" يتحدث عن النجم ليشرحه،
Dialogue: 0,0:16:49.29,0:16:52.83,general text,,0,0,0,,أن شخصًا مثل المعلمة سو كيونغ سيظهر ليحمينا في الأوقات الصعبة
Dialogue: 0,0:16:52.92,0:16:54.79,النص العام,,0,0,0,,لم يهددنا أحد
Dialogue: 0,0:16:54.88,0:16:58.17,general text,,0,0,0,,ماذا لو أراد المنقذ أن يحكم علينا؟
Dialogue: 0,0:16:59.05,0:17:00.42,نص عام,,0,0,0,,هل تستطيع إيقافه؟
Dialogue: 0,0:17:02.01,0:17:03.59,نص عام,,0,0,0,,غوانغجو تشانغ جانج
Dialogue: 0,0:17:03.68,0:17:05.39,نص عام,,0,0,0,,تنبأ بظهور نجم
Dialogue: 0,0:17:05.97,0:17:07.47,خط مائل,,0,0,0,,قال السيد "لي" نفس الشيء
Dialogue: 0,0:17:08.97,0:17:11.89,general text,,0,0,0,,هل يعرف سوسنوفي بور هذا أيضاً؟
Dialogue: 0,0:17:19.32,0:17:23.91,general text,,0,0,0,,في البداية اتخذ محظيات ليحمل ابناً تحت هذا النجم
Dialogue: 0,0:17:23.99,0:17:26.49,general text,,0,0,0,,الآن أحاول العثور عليه في سوسنوفي بور
Dialogue: 0,0:17:27.28,0:17:29.58,general text,,0,0,0,,من الطبيعي أن يكون الملك في حالة حراسة دائمة
Dialogue: 0,0:17:30.75,0:17:32.25,نص عام,,0,0,0,,لعائلة غو المالكة
Dialogue: 0,0:17:32.33,0:17:35.46,النص العام,,0,0,0,,وجود نجمة الملك علامة الخيانة
Dialogue: 0,0:17:42.59,0:17:43.68,نص عام,,0,0,0,"خيانة"؟
Dialogue: 0,0:17:44.55,0:17:47.43,general text,,0,0,0,,يؤمن أهل ديهو بقوة السماء ويقدسونها،
Dialogue: 0,0:17:48.10,0:17:50.77,النص العام,,0,0,0,,لكن سلالة عمرها قرون لا تتغير بهذه السهولة
Dialogue: 0,0:17:50.85,0:17:53.52,general text,,0,0,0,,من الغباء الاعتقاد بأن شخصًا ما سيصبح ملكًا
Dialogue: 0,0:17:53.60,0:17:54.94,نص عام,,0,0,0,,فقط بسبب النجم
Dialogue: 0,0:17:55.02,0:17:57.73,نص عام,,0,0,0,,إذا كان من سوسنوفي بور فمن الممكن
Dialogue: 0,0:17:58.90,0:18:01.90,general text,,0,0,0,,السيد سو كيونغ أنقذ العالم قبل مائتي عام.
Dialogue: 0,0:18:02.49,0:18:06.74,النص العام,,0,0,0,,ما زالوا يكرمونه في ديهو
Dialogue: 0,0:18:08.20,0:18:10.87,general text,,0,0,0,,إذا ولد شخص ما تحت نفس النجم الذي ولد فيه المعلم سو كيونغ،
Dialogue: 0,0:18:10.95,0:18:15.62,النص العام,,0,0,0,,هذا سيكون كافياً لأخذ العرش
Dialogue: 0,0:18:17.50,0:18:19.04,نص عام,,0,0,0,,هل تعتقد,
Dialogue: 0,0:18:19.96,0:18:23.09,النص العام,,0,0,0,,أليست تجارب الملك لا أساس لها من الصحة؟
Dialogue: 0,0:18:25.63,0:18:27.05,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:18:27.93,0:18:32.56,النص العام,,0,0,0,,طالما أنا هنا، لن يحدث هذا
Dialogue: 0,0:18:37.40,0:18:38.56,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:18:38.65,0:18:43.19,general text,,0,0,0,,لن أكون غبيًا مثل والدي وأعيش في خوف أبدي
Dialogue: 0,0:18:47.53,0:18:49.91,النص العام,,0,0,0,,عندما أحضرت غويجا إلى القصر،
Dialogue: 0,0:18:50.66,0:18:52.58,نص عام,,0,0,0,,أدركت أنك كنت على حق
Dialogue: 0,0:18:52.66,0:18:55.91,نص عام,,0,0,0,,الملكة إلى جانب جين مو
Dialogue: 0,0:18:56.00,0:18:59.96,general text,,0,0,0,,لا يمكننا استفزاز العائلة المالكة بعد
Dialogue: 0,0:19:00.04,0:19:02.38,نص عام,,0,0,0,,إذا حاولنا أن نفعل أي شيء،
Dialogue: 0,0:19:02.46,0:19:05.55,general text,,0,0,0,,سيكشف جين مو بالتأكيد سر ميلاد ووك
Dialogue: 0,0:19:05.63,0:19:07.97,النص العام,,0,0,0,,وسيجعله عدواً للقصر
Dialogue: 0,0:19:08.72,0:19:11.68,general text,,0,0,0,,وبعد ذلك سيصبح الجميع في سوسنوفي بور أعداء،
Dialogue: 0,0:19:11.76,0:19:13.35,نص عام,,0,0,0,,لأنهم قبلوه
Dialogue: 0,0:19:14.22,0:19:15.77,نص عام,,0,0,0,,نحن بحاجة إلى تشانغ غان
Dialogue: 0,0:19:17.10,0:19:19.52,نص عام,,0,0,0,,فقط هو الذي يعرف الحقيقة كاملة
Dialogue: 0,0:19:20.15,0:19:22.57,نص عام,,0,0,0,,مثل نقاط ضعف جين مو
Dialogue: 0,0:19:22.65,0:19:27.03,general text,,0,0,0,,كيف تجد شخصًا مختبئًا منذ عقدين من الزمن؟
Dialogue: 0,0:19:27.61,0:19:30.11,نص عام,,0,0,0,,لننتظر حتى يعود بنفسه
Dialogue: 0,0:19:31.16,0:19:35.08,general text,,0,0,0,,انتشار الشائعات حول البدو إلى ما هو أبعد من أسوار قلعة ديهو
Dialogue: 0,0:19:35.16,0:19:38.25,general text,,0,0,0,,سيعود عندما يسمعهم،
Dialogue: 0,0:19:38.33,0:19:43.17,general text,,0,0,0,,خوفاً على سوسنوفي بور وعلى ابنه
Dialogue: 0,0:20:21.92,0:20:23.67,نص عام,,0,0,0,,سمعت أنهم يبحثون عني
Dialogue: 0,0:20:23.75,0:20:25.25,نص عام,,0,0,0,,أين السيد لي؟
Dialogue: 0,0:20:27.17,0:20:29.38,general text,,0,0,0,,ذهب إلى دانهيانغك عند الفجر،
Dialogue: 0,0:20:29.88,0:20:31.34,نص عام,,0,0,0,,لحرق السابساري
Dialogue: 0,0:20:31.93,0:20:32.84,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:20:33.43,0:20:36.39,نص عام,,0,0,0,,إنه ليس هناك؟ أليس هو من اتصل بي؟
Dialogue: 0,0:20:36.47,0:20:37.89,نص عام,,0,0,0,,هو
Dialogue: 0,0:20:39.68,0:20:41.48,نص عام,,0,0,0,,أخبرني أن أخبرك بهذا
Dialogue: 0,0:20:44.19,0:20:48.44,general text,,0,0,0,,هذا سيف ناك سو الذي أخذه من ولي العهد
Dialogue: 0,0:20:49.61,0:20:52.11,general text,,0,0,0,,وبحسب قوله أنت الوحيد الذي يستطيع تخزينه،
Dialogue: 0,0:20:52.20,0:20:53.91,نص عام,,0,0,0,,فطلبت إعادتها
Dialogue: 0,0:20:54.87,0:20:56.49,نص عام,,0,0,0,,اتركت السيف؟
Dialogue: 0,0:20:57.41,0:20:59.83,general text,,0,0,0,,ولم يقل شيئاً قبل الرحيل؟
Dialogue: 0,0:20:59.91,0:21:03.08,النص العام,,0,0,0,,أنت لست تلميذته، لماذا إذن؟
Dialogue: 0,0:21:03.17,0:21:06.38,النص العام,,0,0,0,,إنه يهتم بك كثيراً، لا أفهم
Dialogue: 0,0:21:06.88,0:21:08.67,general text,,0,0,0,,أنتم حتى لم تمارسوا العفة!
Dialogue: 0,0:21:10.88,0:21:14.22,general text,,0,0,0,,قال باك جين أنك زير نساء.
Dialogue: 0,0:21:14.84,0:21:16.55,النص العام,,0,0,0,,إذا كنت تحب مو دوك،
Dialogue: 0,0:21:16.64,0:21:18.39,general text,,0,0,0,,لماذا تلفظت على يونغ أوك؟
Dialogue: 0,0:21:19.89,0:21:22.27,نص عام,,0,0,0,,- لم أتحدث- لا؟
Dialogue: 0,0:21:22.35,0:21:23.69,النص العام,,0,0,0,,لقد سحرتها
Dialogue: 0,0:21:23.77,0:21:26.65,general text,,0,0,0,,كيف سحرت السيد "لي"؟
Dialogue: 0,0:21:26.73,0:21:28.48,نص عام,,0,0,0,,لم أفعل شيئًا
Dialogue: 0,0:21:28.57,0:21:31.61,النص العام,,0,0,0,,أن يكون شخص ما لطيفًا معي،
Dialogue: 0,0:21:31.69,0:21:33.78,نص عام,,0,0,0,,لا يعني أنني سحرتهم
Dialogue: 0,0:21:35.07,0:21:38.12,نص عام,,0,0,0,,كن حذراً مع يونغ أوك في المستقبل
Dialogue: 0,0:21:38.20,0:21:39.83,نص عام,,0,0,0,,ومع احترامي للسيد لي
Dialogue: 0,0:21:39.91,0:21:40.95,نص عام,,0,0,0,,نعم
Dialogue: 0,0:21:41.04,0:21:44.62,نص عام,,0,0,0,,المعلم "لي" ليس ضيق الأفق مثل المعلمين الآخرين
Dialogue: 0,0:21:44.71,0:21:47.88,نص عام,,0,0,0,,إنه ليس متحيزًا ولطيفًا
Dialogue: 0,0:21:47.96,0:21:49.55,نص عام,,0,0,0,,أنا أحترمه
Dialogue: 0,0:21:50.38,0:21:53.51,النص العام,,0,0,0,,لا يمكنك حتى أن تتخيل مدى الصرامة التي يمكن أن يكون عليها
Dialogue: 0,0:21:54.43,0:21:58.60,النص العام,,0,0,0,,إنه لا يرحم البطاطس المقلية
Dialogue: 0,0:21:58.68,0:22:01.43,نص عام,,0,0,0,,لذا كن على أهبة الاستعداد دائمًا
Dialogue: 0,0:22:01.52,0:22:02.64,نص عام,,0,0,0,,خذها وانطلق
Dialogue: 0,0:22:09.69,0:22:10.78,نص عام,,0,0,0,,لقد نسيت تماماً
Dialogue: 0,0:22:10.86,0:22:12.44,نص عام,,0,0,0,,كدت أقع في المشاكل مرة أخرى
Dialogue: 0,0:22:12.53,0:22:14.57,نص عام,,0,0,0,,لقد طُلب مني أن أنقل رسالة،
Dialogue: 0,0:22:14.65,0:22:17.20,نص عام,,0,0,0,,عندما أعطيك السيف ناك سو
Dialogue: 0,0:22:29.25,0:22:31.30,general text,,0,0,0,,لماذا أعطاك سيفي؟
Dialogue: 0,0:22:31.88,0:22:34.09,نص عام,,0,0,0,,لأنك لي،
Dialogue: 0,0:22:34.84,0:22:36.68,نص عام,,0,0,0,,وهذا يعني السيف أيضاً
Dialogue: 0,0:22:37.59,0:22:40.64,general text,,0,0,0,,على كل حال هذا يعني أنه سيظل صامتاً
Dialogue: 0,0:22:40.72,0:22:42.06,نص عام,,0,0,0,,هذا جيد
Dialogue: 0,0:22:47.52,0:22:50.27,ذكريات بخط مائل,,0,0,0,,لقد طُلب مني أن أنقل رسالة
Dialogue: 0,0:22:55.11,0:22:57.49,ذكريات,,0,0,0,,يجب على تشان ووك أن يعتني به
Dialogue: 0,0:22:57.57,0:23:01.45,ذكريات,,0,0,0,,إذا حاول أحد استخدام السيف فعليه أن يقتله
Dialogue: 0,0:23:03.58,0:23:05.41,ذكريات,,0,0,0,,إذا لم يفعل ذلك،
Dialogue: 0,0:23:07.67,0:23:09.50,ذكريات,,0,0,0,,سيموت أيضاً
Dialogue: 0,0:23:12.67,0:23:16.67,التعليق الصوتي,,0,0,0,,كان تحذيرًا بأنه سيقتلنا إذا استخدم مو دوك السيف
Dialogue: 0,0:23:17.59,0:23:19.01,خلف الكواليس,,0,0,0,,بشخصية المرتزق ناك سو
Dialogue: 0,0:23:23.56,0:23:25.73,general text,,0,0,0,,سيفي لكن الأحاسيس غريبة
Dialogue: 0,0:23:27.02,0:23:29.60,general text,,0,0,0,,أعتقد أنه تركني أعيش لأنه يعلم أنني لا أستطيع استخدامه
Dialogue: 0,0:23:30.69,0:23:33.27,النص العام,,0,0,0,,لذا، بصفتك مو دوك، ستكون آمنًا
Dialogue: 0,0:23:34.07,0:23:36.36,النص العام,,0,0,0,,إذا أصبحت "ناك سو" فسوف أكون في خطر
Dialogue: 0,0:23:37.40,0:23:39.66,general text,,0,0,0,,حالما أجد حجر الجليد وأستعيد طاقتي،
Dialogue: 0,0:23:40.36,0:23:42.45,النص العام,,0,0,0,,سوف أجد أعداء أيضًا
Dialogue: 0,0:23:44.33,0:23:45.83,النص العام,,0,0,0,,ماذا سيحدث لي حينها،
Dialogue: 0,0:23:46.45,0:23:47.96,نص عام,,0,0,0,,لا ينبغي أن يعنيك
Dialogue: 0,0:23:48.04,0:23:49.00,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:23:49.71,0:23:51.88,نص عام,,0,0,0,,لأننا لن نكون معلمين وطالبين بعد الآن؟
Dialogue: 0,0:23:51.96,0:23:54.30,general text,,0,0,0,,لن تحتاج إلى حمايتي بعد الآن،
Dialogue: 0,0:23:54.38,0:23:56.34,نص عام,,0,0,0,,ولن أضطر إلى الاستسلام
Dialogue: 0,0:23:57.72,0:24:00.13,نص عام,,0,0,0,,هذا كان اتفاقنا
Dialogue: 0,0:24:07.81,0:24:09.39,نص عام,,0,0,0,,عدني بشيء آخر
Dialogue: 0,0:24:10.10,0:24:12.40,نص عام,,0,0,0,,من منطلق الواجب والوفاء،
Dialogue: 0,0:24:12.48,0:24:16.53,نص عام,,0,0,0,,وما يسمى بالحب، هل يمكنك أن تعدني بشيء آخر؟
Dialogue: 0,0:24:18.07,0:24:19.86,نص عام,,0,0,0,,حسنًا. ماذا تريد؟
Dialogue: 0,0:24:20.57,0:24:22.11,النص العام,,0,0,0,,إذا رجعت الطاقة،
Dialogue: 0,0:24:22.74,0:24:25.28,النص العام,,0,0,0,,سيتعين عليك توجيه سيفك نحو شخص ما،
Dialogue: 0,0:24:26.37,0:24:28.12,نص عام,,0,0,0,,دعني أكون الأول
Dialogue: 0,0:24:31.17,0:24:32.21,نص عام,,0,0,0,,إذا مت,
Dialogue: 0,0:24:32.83,0:24:37.63,النص العام,,0,0,0,,يعني أن القاتل أخذ حياتي
Dialogue: 0,0:24:41.38,0:24:42.72,نص عام,,0,0,0,,إن لم يكن كذلك,
Dialogue: 0,0:24:43.64,0:24:45.76,نص عام,,0,0,0,,سأعطيك وعداً آخر
Dialogue: 0,0:24:47.52,0:24:49.39,نص عام,,0,0,0,,شيء مثل الوعد،
Dialogue: 0,0:24:49.48,0:24:53.77,نص عام,,0,0,0,,الذي أردت أن تسمعه مني عن مستقبلنا
Dialogue: 0,0:25:02.20,0:25:05.53,general text,,0,0,0,,سوف أجد حجر الجليد ولن تتوحشي،
Dialogue: 0,0:25:06.95,0:25:08.54,نص عام,,0,0,0,,لأني وعدتك
Dialogue: 0,0:25:19.71,0:25:21.42,نص عام,,0,0,0,,زوجان هاربان
Dialogue: 0,0:25:22.47,0:25:23.93,النص العام,,0,0,0,,سيبقى
Dialogue: 0,0:25:25.76,0:25:28.01,نص عام,,0,0,0,,هل دان جو هنا؟
Dialogue: 0,0:25:30.56,0:25:34.69,نص عام,,0,0,0,,لماذا سمحت لهم بالدخول؟
Dialogue: 0,0:25:34.77,0:25:35.94,نص عام,,0,0,0,,كان ضرورياً
Dialogue: 0,0:25:36.02,0:25:37.86,نص عام,,0,0,0,,دعهم يذهبون إلى المدينة،
Dialogue: 0,0:25:37.94,0:25:41.36,general text,,0,0,0,,حتى يبنوا عش الحب لتسلية المدينة كلها؟
Dialogue: 0,0:25:43.40,0:25:44.61,نص عام,,0,0,0,,العذراء كيم,
Dialogue: 0,0:25:44.70,0:25:47.78,نص عام,,0,0,0,,أشعر بالحرج والامتنان
Dialogue: 0,0:25:47.87,0:25:50.29,نص عام,,0,0,0,,إنهما ثنائي لطيف للغاية
Dialogue: 0,0:25:50.37,0:25:52.12,general text,,0,0,0,,لماذا أنت ضد ذلك إلى هذا الحد؟
Dialogue: 0,0:25:52.20,0:25:54.46,نص عام,,0,0,0,,لا يمكنهم الزواج
Dialogue: 0,0:25:54.54,0:25:56.33,النص العام,,0,0,0,,ولهذا طردتهم؟
Dialogue: 0,0:25:56.92,0:25:58.75,نص عام,,0,0,0,,اترك هذه العادة الرهيبة
Dialogue: 0,0:25:59.88,0:26:03.34,general text,,0,0,0,,الليلة الماضية احتجزت مو دوك والسيد ماستر بدون سبب.
Dialogue: 0,0:26:03.42,0:26:05.63,النص العام,,0,0,0,,عليك أن تصبح أكثر تسامحاً مع التقدم في السن
Dialogue: 0,0:26:06.22,0:26:07.34,نص عام,,0,0,0,,نفس الشيء بالنسبة لي...
Dialogue: 0,0:26:09.18,0:26:11.35,ذكريات بخط مائل,,0,0,0,,أنا أحب مو ديوك
Dialogue: 0,0:26:11.43,0:26:14.35,ذكريات بخط مائل,,0,0,0,,أنا أحب المالك كثيرًا
Dialogue: 0,0:26:15.23,0:26:16.15,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:26:16.90,0:26:19.36,نص عام,,0,0,0,,إذا ووك، مثل دان غو،
Dialogue: 0,0:26:20.73,0:26:23.53,النص العام,,0,0,0,,سوف يحب من لا ينبغي له،
Dialogue: 0,0:26:24.20,0:26:25.15,نص عام,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,0:26:25.24,0:26:27.24,نص عام,,0,0,0,,هل ستكون متسامحاً؟
Dialogue: 0,0:26:31.79,0:26:35.33,نص عام,,0,0,0,,سأدعم أي اختيار للسيد.
Dialogue: 0,0:26:35.41,0:26:37.17,نص عام,,0,0,0,,- حقاً؟\N- بالطبع
Dialogue: 0,0:26:40.09,0:26:41.13,نص عام,,0,0,0,,ليس لدي أدنى شك
Dialogue: 0,0:26:41.75,0:26:43.84,نص عام,,0,0,0,,أعلم جيدًا ما الذي يزعجك
Dialogue: 0,0:26:43.92,0:26:46.88,نص عام,,0,0,0,,تاريخ الميلاد والمظهر والعمر وكل ذلك
Dialogue: 0,0:26:46.97,0:26:48.55,نص عام,,0,0,0,,القلب هو الأهم
Dialogue: 0,0:26:49.14,0:26:52.06,النص العام,,0,0,0,,إذا كنت واقعًا في الحب فلا يهم المظهر
Dialogue: 0,0:26:52.81,0:26:55.18,نص عام,,0,0,0,,حتى لو لم تكن جميلة
Dialogue: 0,0:26:55.27,0:26:57.65,نص عام,,0,0,0,,أو إذا كان لديهم فارق كبير في العمر
Dialogue: 0,0:27:03.82,0:27:07.32,نص عام,,0,0,0,,هذا ما تعتقده،
Dialogue: 0,0:27:08.49,0:27:09.62,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:27:09.70,0:27:10.87,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:27:14.25,0:27:17.71,general text,,0,0,0,,أي شخص ليس وسيمًا مثل تشانغ غان
Dialogue: 0,0:27:18.62,0:27:20.25,نص عام,,0,0,0,,ومن هو أكبر سناً بكثير،
Dialogue: 0,0:27:20.33,0:27:23.84,نص عام,,0,0,0,,لا تزال هناك فرصة،
Dialogue: 0,0:27:25.34,0:27:26.72,نص عام,,0,0,0,,إذا لامس قلبك؟
Dialogue: 0,0:27:28.47,0:27:29.59,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:27:33.01,0:27:34.56,نص عام,,0,0,0,,إذا لامس قلبي،
Dialogue: 0,0:27:36.27,0:27:39.14,نص عام,,0,0,0,,سيكون أجمل بكثير
Dialogue: 0,0:27:39.23,0:27:40.52,نص عام,,0,0,0,,وأصغر في عيني
Dialogue: 0,0:27:53.28,0:27:56.04,نص عام,,0,0,0,,أرى يا خادمة كيم
Dialogue: 0,0:27:57.33,0:27:58.58,نص عام,,0,0,0,,أنا أفهمك
Dialogue: 0,0:28:16.31,0:28:21.19,general text,,0,0,0,,كان صريحاً جداً عندما سألني عن مشاعري تجاهه
Dialogue: 0,0:28:22.61,0:28:24.82,نص عام,,0,0,0,,وماذا تعني كلمة "ليست جميلة"؟
Dialogue: 0,0:28:24.90,0:28:26.90,نص عام,,0,0,0,,يكبره بسنتين فقط
Dialogue: 0,0:28:30.07,0:28:31.78,نص عام,,0,0,0,,القلق من العدم
Dialogue: 0,0:28:42.42,0:28:46.55,نص عام,,0,0,0,,كيف يمكنها أن تخبرني بهذه السهولة،
Dialogue: 0,0:28:46.63,0:28:48.38,نص عام,,0,0,0,,ماذا يحب السيد "لي"؟
Dialogue: 0,0:28:52.43,0:28:54.14,نص عام,,0,0,0,,هل هو وسيم؟
Dialogue: 0,0:28:56.06,0:28:59.48,general text,,0,0,0,,هو أكبر منها بأكثر من مائة عام.
Dialogue: 0,0:29:09.94,0:29:11.11,نص عام,,0,0,0,,باك دان غو...
Dialogue: 0,0:29:11.78,0:29:13.70,نص عام,,0,0,0,,أيها الوغد الصغير!
Dialogue: 0,0:29:17.49,0:29:18.83,نص عام,,0,0,0,,الآن
Dialogue: 0,0:29:20.20,0:29:23.96,general text,,0,0,0,,أفضل النبيذ المخفي لدى عمي
Dialogue: 0,0:29:25.13,0:29:26.38,نص عام,,0,0,0,,الشاي بدلاً من ذلك
Dialogue: 0,0:29:26.46,0:29:28.92,نص عام,,0,0,0,,ماذا؟ هل تندم بالفعل على ذلك؟
Dialogue: 0,0:29:29.51,0:29:30.55,نص عام,,0,0,0,,لا!
Dialogue: 0,0:29:31.22,0:29:34.55,نص عام,,0,0,0,,ظننت أنني أستطيع التخلي عن كل شيء
Dialogue: 0,0:29:34.64,0:29:37.39,النص العام,,0,0,0,,فأخذت يدها إذن
Dialogue: 0,0:29:39.64,0:29:42.94,مائل,,0,0,0,,لم أتوقع أن يمسك بيدي بهذه السرعة
Dialogue: 0,0:29:43.69,0:29:46.61,general text,,0,0,0,,كنت منزعجًا لأنهم كانوا يتحدثون عن ولي العهد
Dialogue: 0,0:29:46.69,0:29:49.11,النص العام,,0,0,0,,وقلت أنني لا أحبه
Dialogue: 0,0:29:49.73,0:29:52.11,general text,,0,0,0,,وفجأة أمسك بيدي واعترف بحبه
Dialogue: 0,0:29:52.19,0:29:53.45,نص عام,,0,0,0,,تحرك قليلاً
Dialogue: 0,0:29:56.49,0:29:58.66,نص عام,,0,0,0,,لم أستطع ترك يده
Dialogue: 0,0:29:58.74,0:30:00.83,نص عام,,0,0,0,,أنا فقط في حيرة من أمري
Dialogue: 0,0:30:01.75,0:30:04.42,النص العام,,0,0,0,,لم أفكر قط في الهروب من المنزل
Dialogue: 0,0:30:06.04,0:30:07.71,نص عام,,0,0,0,,كم ستبقى هنا؟
Dialogue: 0,0:30:09.25,0:30:11.76,general text,,0,0,0,,لقد قيل لي أن أخدمكما أثناء وجودكما هنا
Dialogue: 0,0:30:14.01,0:30:15.47,نص عام,,0,0,0,,لا فكرة
Dialogue: 0,0:30:15.55,0:30:17.68,نص عام,,0,0,0,,لا أريد أن أطيل هنا
Dialogue: 0,0:30:18.55,0:30:21.81,نص عام,,0,0,0,,إذا قلت أنه يجب علينا العودة إلى المنزل،
Dialogue: 0,0:30:21.89,0:30:24.06,نص عام,,0,0,0,,إذن سأبدو غير مسؤول، أليس كذلك؟
Dialogue: 0,0:30:24.14,0:30:27.06,general text,,0,0,0,,إذا قلت أنني أريد العودة إلى المنزل فسأكسر قلبه، أليس كذلك؟
Dialogue: 0,0:30:28.11,0:30:29.77,general text,,0,0,0,,- ماذا علي أن أفعل؟\N- ماذا علي أن أفعل؟
Dialogue: 0,0:30:31.48,0:30:33.03,نص عام,,0,0,0,,كل شيء للأفضل
Dialogue: 0,0:30:33.11,0:30:35.20,نص عام,,0,0,0,,اخدم السيدة جين هنا
Dialogue: 0,0:30:35.28,0:30:37.66,النص العام,,0,0,0,,أفضل من مقابلة باك جين في سوسنوفي بور
Dialogue: 0,0:30:37.74,0:30:42.24,general text,,0,0,0,,إذا كان "سو يي" وراء جرائم القتل المتهم بها،
Dialogue: 0,0:30:42.87,0:30:44.00,نص عام,,0,0,0,,فهذا أمر خطير
Dialogue: 0,0:30:44.08,0:30:47.79,general text,,0,0,0,,أنت لا تعرفها، لكنها تعرف مو دوك.
Dialogue: 0,0:30:49.71,0:30:52.67,general text,,0,0,0,,لماذا تتجول "سو يي" وتقتل الناس؟
Dialogue: 0,0:30:56.55,0:30:58.72,مائل,,0,0,0,,إذا كانت الفتاة العمياء التي يبحث عنها قطاع الطرق،
Dialogue: 0,0:30:58.80,0:31:00.68,نص عام,,0,0,0,,هذا هو نفسه لذا أنا،
Dialogue: 0,0:31:01.18,0:31:02.93,النص العام,,0,0,0,,ثم لم تستطع قتلهم بنفسها
Dialogue: 0,0:31:03.02,0:31:04.52,نص عام,,0,0,0,,أعتقد أن لديها شريكًا
Dialogue: 0,0:31:04.60,0:31:07.81,general text,,0,0,0,,إذا أخذت السلطات هذه الجثث فسوف تقبض على القاتل
Dialogue: 0,0:31:08.60,0:31:10.27,نص عام,,0,0,0,,مو ديوك كان يعرف سو يي
Dialogue: 0,0:31:10.36,0:31:12.61,نص عام,,0,0,0,,يجب أن تساعد في التحقيق
Dialogue: 0,0:31:13.82,0:31:15.53,التعليق الصوتي,,0,0,0,,إنها لا تتعرف على سو يي
Dialogue: 0,0:31:15.61,0:31:18.07,خلف الكواليس,,0,0,0,,إنها ليست نفس مو دوك الذي عاش في قرية ساري
Dialogue: 0,0:31:18.16,0:31:21.08,general text,,0,0,0,,سوف تُتهم زورا وتعاني
Dialogue: 0,0:31:21.16,0:31:24.04,نص عام,,0,0,0,,إذا لزم الأمر سأسألها بنفسي
Dialogue: 0,0:31:31.13,0:31:34.38,نص عام,,0,0,0,,من الأفضل عدم التدخل. يول يعرف ما يفعله
Dialogue: 0,0:31:41.80,0:31:44.60,general text,,0,0,0,,ستكون هناك مشكلة إذا اكتشف النائب أنك لست في المنزل
Dialogue: 0,0:31:45.10,0:31:47.85,النص العام,,0,0,0,,كل من عرفني قُتل
Dialogue: 0,0:31:47.94,0:31:50.19,النص العام,,0,0,0,,سأصل إلى جينيوون - لا يزال يتعين علي الخروج
Dialogue: 0,0:31:50.27,0:31:52.40,النص العام,,0,0,0,,علينا أن نتدرب حتى يصدقوني
Dialogue: 0,0:31:53.52,0:31:54.98,نص عام,,0,0,0,,اشتري ما تريد
Dialogue: 0,0:31:55.07,0:31:56.99,نص عام,,0,0,0,,لقد أعطيتك الكثير من المال
Dialogue: 0,0:31:58.53,0:32:00.11,نص عام,,0,0,0,,دعونا نعود قريباً
Dialogue: 0,0:32:01.45,0:32:02.70,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:32:03.58,0:32:05.83,نص عام,,0,0,0,,لماذا تستخدم المظلة بدلاً من العصا؟
Dialogue: 0,0:32:07.83,0:32:09.00,نص عام,,0,0,0,,لا تلمس
Dialogue: 0,0:32:11.00,0:32:12.38,نص عام,,0,0,0,,أعجبني كثيراً
Dialogue: 0,0:32:24.35,0:32:27.22,نص عام,,0,0,0,,لقد ساعدت في مسح اسمي
Dialogue: 0,0:32:27.31,0:32:29.60,نص عام,,0,0,0,,أتمنى أن تستمتع به هنا
Dialogue: 0,0:32:29.69,0:32:31.94,general text,,0,0,0,,هل تأكل عائلة تشان بهذه الطريقة دائمًا؟
Dialogue: 0,0:32:33.19,0:32:34.40,نص عام,,0,0,0,,جريء جدًا
Dialogue: 0,0:32:37.73,0:32:40.65,نص عام,,0,0,0,,حسنًا سيدتي. سأطبخ شيئًا آخر
Dialogue: 0,0:32:49.91,0:32:51.67,نص عام,,0,0,0,,مالح جدًا!
Dialogue: 0,0:32:54.08,0:32:56.04,النص العام,,0,0,0,,- طازج؟\N- مالح
Dialogue: 0,0:32:56.13,0:32:58.34,النص العام,,0,0,0,,معدتي منتفخة من الطعام المالح
Dialogue: 0,0:33:01.05,0:33:02.30,نص عام,,0,0,0,,حسنًا سيدتي
Dialogue: 0,0:33:05.35,0:33:06.43,نص عام,,0,0,0,,صعب جدًا
Dialogue: 0,0:33:06.51,0:33:08.35,نص عام,,0,0,0,,حلو جدًا
Dialogue: 0,0:33:09.56,0:33:10.85,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:33:12.10,0:33:13.94,نص عام,,0,0,0,,أنا قلقة جدًا لدرجة أنني فقدت شهيتي
Dialogue: 0,0:33:15.98,0:33:19.19,التعليق الصوتي,,0,0,0,,لماذا تتصرف مثل المملكة المتحدة؟
Dialogue: 0,0:33:19.90,0:33:21.20,نص عام,,0,0,0,,ليس لدي شهية
Dialogue: 0,0:33:21.28,0:33:22.78,النص العام,,0,0,0,,هل هناك شيء للشرب؟
Dialogue: 0,0:33:22.86,0:33:24.45,النص العام,,0,0,0,,شاي القرفة أو سيخي*
Dialogue: 0,0:33:22.86,0:33:24.45,ملاحظات,,0,0,0,,*مشروب الأرز الحلو
Dialogue: 0,0:33:29.95,0:33:32.54,general text,,0,0,0,,إنهما ببساطة مصنوعان لبعضهما البعض. كان يجب أن نتزوج!
Dialogue: 0,0:33:32.62,0:33:36.13,general text,,0,0,0,,فمن المؤكد أن أحدهم سيموت في القتال
Dialogue: 0,0:33:40.92,0:33:42.09,نص عام,,0,0,0,,مو دوك، سيخ...
Dialogue: 0,0:33:42.17,0:33:44.30,نص عام,,0,0,0,,حلو؟ بارد جدا؟
Dialogue: 0,0:33:44.93,0:33:47.05,نص عام,,0,0,0,,هكذا ينبغي أن يكون
Dialogue: 0,0:33:47.76,0:33:49.43,نص عام,,0,0,0,,لماذا تصرخ؟
Dialogue: 0,0:33:49.52,0:33:51.06,نص عام,,0,0,0,,هل سئمت من خدمتي؟
Dialogue: 0,0:33:51.93,0:33:54.10,نص عام,,0,0,0,,هل تعتقد أنه من السهل إرضائك؟
Dialogue: 0,0:33:56.52,0:33:58.77,النص العام,,0,0,0,,أصبح سريع الانفعال عندما أشعر بالقلق
Dialogue: 0,0:33:58.86,0:34:00.82,نص عام,,0,0,0,,البعد عن المنزل متعب جداً
Dialogue: 0,0:34:00.90,0:34:02.69,نص عام,,0,0,0,,ثم اذهب للمنزل
Dialogue: 0,0:34:03.74,0:34:06.49,نص عام,,0,0,0,,لا أنا خائف
Dialogue: 0,0:34:06.57,0:34:08.53,نص عام,,0,0,0,,أمي غاضبة جداً مني
Dialogue: 0,0:34:10.04,0:34:13.41,نص عام,,0,0,0,,أي نوع من البنات أنت؟
Dialogue: 0,0:34:13.50,0:34:15.42,نص عام,,0,0,0,,لم أكن المفضلة لديها أبدًا
Dialogue: 0,0:34:16.58,0:34:18.75,النص العام,,0,0,0,,أختي كانت فخرها وبهجتها
Dialogue: 0,0:34:20.63,0:34:22.63,النص العام,,0,0,0,,رغم أنها كانت عمياء،
Dialogue: 0,0:34:22.71,0:34:24.72,نص عام,,0,0,0,,رأيت الطاقة وتواصلت مع الآثار
Dialogue: 0,0:34:24.80,0:34:27.55,general text,,0,0,0,,لم تكن أقل قوة من والدتها حتى في سن مبكرة
Dialogue: 0,0:34:27.64,0:34:30.47,general text,,0,0,0,,حسنًا، سمعت أن معظم أفراد عائلة جين هم
Dialogue: 0,0:34:30.56,0:34:33.35,النص العام,,0,0,0,,تحكم في قوة السماء ولا تلقي التعويذات
Dialogue: 0,0:34:33.93,0:34:36.10,general text,,0,0,0,,لقد رأيت كيف أعامل غويغو، أليس كذلك؟
Dialogue: 0,0:34:36.77,0:34:38.31,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:34:38.40,0:34:40.19,نص عام,,0,0,0,,كاهنة قوية
Dialogue: 0,0:34:40.27,0:34:43.69,general text,,0,0,0,,يستطيع السيطرة على نفوس الناس وإيقاعهم في الفخاخ
Dialogue: 0,0:34:44.61,0:34:46.95,النص العام,,0,0,0,,- استدرج إلى الفخاخ؟\N- نعم
Dialogue: 0,0:34:47.03,0:34:49.07,general text,,0,0,0,,إذا حاصرت الكاهنة القوات،
Dialogue: 0,0:34:49.16,0:34:52.66,النص العام,,0,0,0,,حتى أقوى الساحر لا يستطيع الهروب
Dialogue: 0,0:34:54.58,0:34:57.00,نص عام,,0,0,0,,سمعت أن الشامان يمكنهم
Dialogue: 0,0:34:57.08,0:34:59.25,نص عام,,0,0,0,,محو وتغيير الذكريات
Dialogue: 0,0:34:59.33,0:35:02.05,نص عام,,0,0,0,,كاهنات جينيوون على مستوى آخر
Dialogue: 0,0:35:02.13,0:35:05.26,النص العام,,0,0,0,,وكيف ماتت مثل هذه الفتاة؟
Dialogue: 0,0:35:06.80,0:35:08.34,نص عام,,0,0,0,,إنها حقًا لا تصدق
Dialogue: 0,0:35:10.05,0:35:12.06,نص عام,,0,0,0,,إنها بالتأكيد على قيد الحياة
Dialogue: 0,0:35:13.89,0:35:15.52,نص عام,,0,0,0,,وسوف نراها مرة أخرى
Dialogue: 0,0:35:21.77,0:35:23.19,نص عام,,0,0,0,,إن كانت على قيد الحياة،
Dialogue: 0,0:35:24.15,0:35:25.57,نص عام,,0,0,0,,سترى بلا شك
Dialogue: 0,0:35:34.41,0:35:37.37,نص عام,,0,0,0,,عم سأل عن مو ديوك
Dialogue: 0,0:35:37.96,0:35:40.88,general text,,0,0,0,,هل سأل التاجر عنها؟
Dialogue: 0,0:35:41.75,0:35:43.50,نص عام,,0,0,0,,نعم. قال مو دوك
Dialogue: 0,0:35:45.51,0:35:47.92,النص العام,,0,0,0,,كل ذلك بسبب تلك الحادثة مع البدو
Dialogue: 0,0:35:48.51,0:35:49.43,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:35:49.51,0:35:53.81,general text,,0,0,0,,إذا كان هناك بدو في القصر، فقد يكونون في سوسنوفي بور أيضًا
Dialogue: 0,0:35:54.68,0:35:58.52,general text,,0,0,0,,لماذا يشعر خليفة سوسنوفي بور المنفي بالقلق من هذا الأمر؟
Dialogue: 0,0:35:58.60,0:36:02.73,general text,,0,0,0,,- أنا لست منفياً\N- لقد ندم بالفعل على ذلك
Dialogue: 0,0:36:02.81,0:36:03.65,نص عام,,0,0,0,,يا
Dialogue: 0,0:36:03.73,0:36:06.07,نص عام,,0,0,0,,كنت متأكداً بالأمس
Dialogue: 0,0:36:08.40,0:36:10.03,نص عام,,0,0,0,,أوكا يتم طردها دائمًا
Dialogue: 0,0:36:10.11,0:36:11.53,نص عام,,0,0,0,,ماذا أفعل هنا؟
Dialogue: 0,0:36:11.62,0:36:13.74,نص عام,,0,0,0,,سوف تعتاد عليه
Dialogue: 0,0:36:13.83,0:36:17.04,نص عام,,0,0,0,,حسنًا، سيكون الأمر حزينًا في البداية
Dialogue: 0,0:36:18.66,0:36:20.58,نص عام,,0,0,0,,يول فقط لم يمر بهذا
Dialogue: 0,0:36:20.67,0:36:21.83,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:36:21.92,0:36:23.00,نص عام,,0,0,0,,تم طرد يوليا أيضًا
Dialogue: 0,0:36:23.09,0:36:24.17,نص عام,,0,0,0,,لا يمكن أن يكون
Dialogue: 0,0:36:24.88,0:36:27.05,النص العام,,0,0,0,,تذكر أنني كسرت حجر الحبر المذهّب،
Dialogue: 0,0:36:27.13,0:36:28.63,النص العام,,0,0,0,,وجميعنا كذبنا؟
Dialogue: 0,0:36:33.76,0:36:37.14,ذكريات,,0,0,0,,عمي سيكون غاضباً جداً مني
Dialogue: 0,0:36:37.72,0:36:38.60,ذكريات,,0,0,0,,دعونا نخفي الأمر
Dialogue: 0,0:36:39.56,0:36:41.65,ذكريات,,0,0,0,,دعونا ندفنه ونتظاهر بأننا لا نعرف شيئاً
Dialogue: 0,0:36:42.23,0:36:43.44,ذكريات,,0,0,0,,هذا خطأ
Dialogue: 0,0:36:44.27,0:36:46.57,ذكريات,,0,0,0,,يجب أن نقول الحقيقة ونطلب المغفرة
Dialogue: 0,0:36:46.65,0:36:49.74,ذكريات,,0,0,0,,ثم سيكون دان جو في ورطة كبيرة
Dialogue: 0,0:36:52.78,0:36:54.78,ذكريات,,0,0,0,,لا أستطيع الكذب
Dialogue: 0,0:36:56.33,0:36:58.08,ذكريات,,0,0,0,,كل شيء سيكون على ما يرام، دان جو
Dialogue: 0,0:36:58.95,0:37:00.58,ذكريات,,0,0,0,,يمكننا التعامل مع الأمر
Dialogue: 0,0:37:02.79,0:37:06.46,مائل,,0,0,0,,اتفقنا جميعًا على إخفاء الأمر
Dialogue: 0,0:37:06.55,0:37:08.96,مائل,,0,0,0,,لكن بعد ذلك مرض يول
Dialogue: 0,0:37:09.55,0:37:12.51,ذكريات,,0,0,0,,أعتقد أن يول مريض جدًا
Dialogue: 0,0:37:12.59,0:37:13.80,ذكريات,,0,0,0,,أعتقد ذلك أيضًا
Dialogue: 0,0:37:15.72,0:37:20.06,ذكريات,,0,0,0,,لماذا مرض يول إلى هذا الحد؟ ماذا حدث؟
Dialogue: 0,0:37:20.64,0:37:24.15,ذكريات,,0,0,0,,سمعت أنه يأكل بشكل سيئ وينام بشكل سيئ
Dialogue: 0,0:37:24.23,0:37:25.31,ذكريات بخط مائل,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:37:26.69,0:37:29.74,خط مائل,,0,0,0,,يول لم يرتكب أي خطأ أبدًا
Dialogue: 0,0:37:29.82,0:37:32.24,مائل,,0,0,0,,لقد مرض، وكان يخشى أن يتم القبض علينا
Dialogue: 0,0:37:33.07,0:37:36.45,general text,,0,0,0,,اعترفنا للحوت لأننا ظننا أن يول سيموت
Dialogue: 0,0:37:36.53,0:37:38.66,نص عام,,0,0,0,,وتم طردنا جميعاً
Dialogue: 0,0:37:38.74,0:37:42.04,النص العام,,0,0,0,,لقد تم طردي مرات عديدة لدرجة أنني لا أتذكر حتى
Dialogue: 0,0:37:42.12,0:37:45.67,general text,,0,0,0,,لكنني أشك في أن يول كان مريضاً خوفاً من القبض عليه
Dialogue: 0,0:37:47.09,0:37:49.80,general text,,0,0,0,,لقد عانى لأنه فهم أنه تصرف بشكل سيء
Dialogue: 0,0:37:50.46,0:37:53.63,النص العام,,0,0,0,,وكان من الصعب عليه أن يتقبل هذه الحقيقة
Dialogue: 0,0:37:57.97,0:38:00.14,النص العام,,0,0,0,,يضيع إذا أخذ على حين غرة
Dialogue: 0,0:38:01.85,0:38:04.81,general text,,0,0,0,,لا بد أنه كان قلقًا وخائفًا من القيام...
Dialogue: 0,0:38:05.60,0:38:07.11,نص عام,,0,0,0,,هناك خطأ ما
Dialogue: 0,0:38:08.69,0:38:10.19,نص عام,,0,0,0,,من أجل أصدقائك
Dialogue: 0,0:38:15.32,0:38:17.78,نص عام,,0,0,0,,نعم. أتذكر ذلك جيدا
Dialogue: 0,0:38:19.12,0:38:20.54,نص عام,,0,0,0,,لقد عذبني
Dialogue: 0,0:38:21.62,0:38:23.54,general text,,0,0,0,,عاقب نفسك بشدة،
Dialogue: 0,0:38:23.62,0:38:26.50,نص عام,,0,0,0,,من الآخرين
Dialogue: 0,0:38:26.58,0:38:28.84,general text,,0,0,0,,هل هذا نوع من الحس الأخلاقي العالي؟
Dialogue: 0,0:38:29.54,0:38:32.30,general text,,0,0,0,,هل كنت هكذا عندما كنت طفلاً؟
Dialogue: 0,0:38:32.38,0:38:33.42,نص عام,,0,0,0,,لا يصدق
Dialogue: 0,0:38:35.09,0:38:37.84,general text,,0,0,0,,تخيل كيف شعرت بدفن ذلك الحجر معي
Dialogue: 0,0:38:37.93,0:38:39.35,نص عام,,0,0,0,,أصدقاء غير مسؤولين؟
Dialogue: 0,0:38:40.68,0:38:43.18,نص عام,,0,0,0,,لم نتمكن حتى من دفنها حقًا. تم اكتشافنا بسرعة
Dialogue: 0,0:38:43.27,0:38:44.56,نص عام,,0,0,0,,- ماذا؟\N- ماذا؟
Dialogue: 0,0:38:44.64,0:38:47.35,نص عام,,0,0,0,,هل انكشفنا؟ لقد قلت أننا اعترفنا بأنفسنا
Dialogue: 0,0:38:47.94,0:38:49.94,خط مائل,,0,0,0,,دان غو لا يتذكر بشكل صحيح تمامًا
Dialogue: 0,0:38:50.02,0:38:51.44,نص عام,,0,0,0,,لم نعترف
Dialogue: 0,0:38:52.48,0:38:55.90,general text,,0,0,0,,عثر سان هو على حجر نصف مدفون. هكذا تم اكتشافنا
Dialogue: 0,0:38:56.53,0:38:57.66,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:38:58.24,0:38:59.74,نص عام,,0,0,0,,يبدو أنني زيّنته قليلاً
Dialogue: 0,0:39:01.12,0:39:03.41,نص عام,,0,0,0,,أعتقد أننا تصرفنا بشرف
Dialogue: 0,0:39:03.50,0:39:05.08,نص عام,,0,0,0,,يا له من عار...
Dialogue: 0,0:39:05.16,0:39:08.00,نص عام,,0,0,0,,ما الذي تخجل منه؟
Dialogue: 0,0:39:08.08,0:39:10.21,نص عام,,0,0,0,,لقد تم طردك مؤخرًا
Dialogue: 0,0:39:10.29,0:39:13.00,general text,,0,0,0,,من سيكون الرئيس التالي بدلاً من دان جو؟
Dialogue: 0,0:39:14.26,0:39:15.17,نص عام,,0,0,0,,ربما سانغ هو؟
Dialogue: 0,0:39:15.26,0:39:16.63,خط مائل,,0,0,0,,هل تعتقد ذلك؟
Dialogue: 0,0:39:16.72,0:39:19.01,نص عام,,0,0,0,,إذن سأكون إلى جانبه
Dialogue: 0,0:39:19.97,0:39:22.22,النص العام,,0,0,0,,لا يمكنك التخلي عني بهذه الطريقة
Dialogue: 0,0:39:22.31,0:39:24.22,نص عام,,0,0,0,,يجب أن تكون بجانبي في الواقع
Dialogue: 0,0:39:24.31,0:39:26.18,نص عام,,0,0,0,,هيا يا المملكة المتحدة
Dialogue: 0,0:39:26.27,0:39:28.81,نص عام,,0,0,0,,لا أستطيع المساعدة حقًا
Dialogue: 0,0:39:29.65,0:39:32.61,النص العام,,0,0,0,,- يا يول\N- أنا لست بليغًا جدًا
Dialogue: 0,0:39:33.11,0:39:34.32,نص عام,,0,0,0,,خاصة في الحب
Dialogue: 0,0:39:42.91,0:39:44.41,نص عام,,0,0,0,,بالطبع أنتما الاثنان بجانبي
Dialogue: 0,0:40:02.76,0:40:05.56,مائل,,0,0,0,,يول، هل كنت تنام بشكل سيئ مؤخرًا؟
Dialogue: 0,0:40:05.64,0:40:08.64,نص عام,,0,0,0,,اليوم يمكنك أن تشرب بقدر ما تريد
Dialogue: 0,0:40:08.73,0:40:10.73,نص عام,,0,0,0,,وبعد ذلك نم جيدًا
Dialogue: 0,0:40:12.06,0:40:14.07,general text,,0,0,0,,هل تعاني من مشاكل في النوم؟
Dialogue: 0,0:40:14.69,0:40:15.69,نص عام,,0,0,0,,لا
Dialogue: 0,0:40:15.78,0:40:17.36,نص عام,,0,0,0,,لقد رأيتك تتجول حتى وقت متأخر
Dialogue: 0,0:40:17.44,0:40:19.24,نص عام,,0,0,0,,عادة ما تذهب إلى النوم مبكراً
Dialogue: 0,0:40:19.32,0:40:22.62,general text,,0,0,0,,هل أنت قلق بشأن ما يحدث في قلعة سوهو؟
Dialogue: 0,0:40:29.92,0:40:32.38,ذكريات بخط مائل,,0,0,0,,لقد قتلت للتو بدويًا
Dialogue: 0,0:40:33.75,0:40:35.84,ذكريات بخط مائل,,0,0,0,,احمي العالم من الوحوش -
Dialogue: 0,0:40:36.84,0:40:38.34,ذكريات بخط مائل,,0,0,0,,مسؤوليتنا
Dialogue: 0,0:40:39.97,0:40:41.89,ذكريات بخط مائل,,0,0,0,,حتى ميت، هذا غويغو
Dialogue: 0,0:40:42.43,0:40:43.85,ذكريات,,0,0,0,,من غير المحتمل أن تكون كل الطاقة قد غادرت الجسم
Dialogue: 0,0:40:43.93,0:40:45.43,ذكريات,,0,0,0,,لا تلمس
Dialogue: 0,0:40:52.56,0:40:54.61,general text,,0,0,0,,هل تتظاهر بأنك لا تعرف شيئًا؟
Dialogue: 0,0:40:58.07,0:41:00.03,نص عام,,0,0,0,,كما في الطفولة عندما دفنوا حجراً
Dialogue: 0,0:41:01.36,0:41:04.37,نص عام,,0,0,0,,لابد أن الأمر صعب عليك
Dialogue: 0,0:41:22.59,0:41:24.80,التعليق الصوتي,,0,0,0,,إذا عادت قوتي واستل سيفي،
Dialogue: 0,0:41:26.85,0:41:30.89,التعليق الصوتي,,0,0,0,,هل سأتمكن من القتل مرة أخرى بلا رحمة كما كان من قبل؟
Dialogue: 0,0:41:35.69,0:41:37.44,النص العام,,0,0,0,,أهذا سيف القاتل؟
Dialogue: 0,0:41:39.03,0:41:41.32,general text,,0,0,0,,لماذا أحضره السيد إلى هنا مرة أخرى؟
Dialogue: 0,0:41:42.32,0:41:45.82,نص عام,,0,0,0,,يصيبني بالقشعريرة
Dialogue: 0,0:41:46.91,0:41:48.95,نص عام,,0,0,0,,شرير جدًا. سيكون من الأفضل لو لم يكن هنا
Dialogue: 0,0:41:51.33,0:41:54.33,general text,,0,0,0,,لقد نام الضيوف بالفعل. اذهب إلى السرير
Dialogue: 0,0:41:55.00,0:41:56.63,النص العام,,0,0,0,,ربما يجب أن أصنع تعويذة...
Dialogue: 0,0:42:06.80,0:42:08.18,نص عام,,0,0,0,,أنت تصيبني بالقشعريرة...
Dialogue: 0,0:42:11.22,0:42:12.43,النص العام,,0,0,0,,ويبدو أنك شرير
Dialogue: 0,0:42:42.80,0:42:44.88,مائل,,0,0,0,,بعد ما حدث في جيونبوغوان،
Dialogue: 0,0:42:44.97,0:42:46.72,خط مائل,,0,0,0,,الخصي كيم لم يُرى مع الملكة
Dialogue: 0,0:42:47.68,0:42:49.05,نص عام,,0,0,0,,هل تعرف شيئاً عن هذا؟
Dialogue: 0,0:42:49.14,0:42:52.39,general text,,0,0,0,,يقولون إنه مريض ويستريح. ولكن لا أحد يعرف بالضبط أين هو
Dialogue: 0,0:42:54.18,0:42:56.39,نص عام,,0,0,0,,تعرف على أكبر قدر ممكن عنه
Dialogue: 0,0:42:56.48,0:42:57.98,نص عام,,0,0,0,,عندما ظهر في القصر،
Dialogue: 0,0:42:58.06,0:43:01.11,النص العام,,0,0,0,,عندما بدأ بخدمة الملكة حدثت معه بعض الأمور الغريبة
Dialogue: 0,0:43:01.94,0:43:03.36,نص عام,,0,0,0,,كن حذراً
Dialogue: 0,0:43:04.07,0:43:04.99,نص عام,,0,0,0,,حسنًا يا صاحب السمو
Dialogue: 0,0:43:11.03,0:43:14.50,general text,,0,0,0,,هل تتذكر ما قاله الخصي كيم عندما التقينا به في جيونبوغوان؟
Dialogue: 0,0:43:16.75,0:43:18.92,ذكريات,,0,0,0,,هذا الشامان تشوي...
Dialogue: 0,0:43:19.58,0:43:21.54,ذكريات,,0,0,0,,قلت لك أن تقتلني؟
Dialogue: 0,0:43:22.09,0:43:23.80,نص عام,,0,0,0,,شامان تشوي...
Dialogue: 0,0:43:23.88,0:43:26.97,general text,,0,0,0,,يجب أن يكون منصبها أعلى من جين مو، فتعطيه الأوامر
Dialogue: 0,0:43:28.01,0:43:29.72,نص عام,,0,0,0,,الملكة؟
Dialogue: 0,0:43:29.80,0:43:32.51,النص العام,,0,0,0,,ناك سو في جسد مو دوك
Dialogue: 0,0:43:32.60,0:43:34.27,نص عام,,0,0,0,,ربما في جسد الملكة
Dialogue: 0,0:43:35.31,0:43:37.02,نص عام,,0,0,0,,روح الشامان تشوي؟
Dialogue: 0,0:43:37.10,0:43:37.98,نص عام,,0,0,0,,محتمل جدًا
Dialogue: 0,0:43:39.40,0:43:42.27,نص عام,,0,0,0,,ولكن فقط إذا كانت الملكة بدوية
Dialogue: 0,0:43:43.36,0:43:47.32,نص عام,,0,0,0,,لم ألاحظ أي شيء يوحي بأن الملكة بدوية
Dialogue: 0,0:43:47.40,0:43:50.41,general text,,0,0,0,,التحقق من قلب طاقتها أثناء التفتيش،
Dialogue: 0,0:43:50.49,0:43:53.41,نص عام,,0,0,0,,لم ألاحظ أي شيء غير عادي. إنها شخص عادي
Dialogue: 0,0:43:55.70,0:44:00.13,النص العام,,0,0,0,,لذلك قد يبدو الأمر كما لو كان لديها حجر ثلج
Dialogue: 0,0:44:01.75,0:44:05.67,general text,,0,0,0,,الملكة هي الأخت الصغرى للجنرال سو
Dialogue: 0,0:44:05.76,0:44:07.17,نص عام,,0,0,0,,إنها العمة جوليا
Dialogue: 0,0:44:07.26,0:44:10.84,general text,,0,0,0,,ليست مرتبطة بأي حال من الأحوال بعائلة Ho، ولكنها تنتمي إلى عائلة So.
Dialogue: 0,0:44:10.93,0:44:12.39,النص العام,,0,0,0,,إذا انتقلت روحها،
Dialogue: 0,0:44:13.39,0:44:17.23,النص العام,,0,0,0,,الآن في جسدها روح شخص آخر
Dialogue: 0,0:44:17.31,0:44:20.48,نص عام,,0,0,0,,اتضح أن روح الملكة ماتت؟
Dialogue: 0,0:44:21.06,0:44:22.52,نص عام,,0,0,0,,هذا مستحيل
Dialogue: 0,0:44:22.61,0:44:25.82,general text,,0,0,0,,كل فرد في عائلة "سو" لديه فانوس الحياة
Dialogue: 0,0:44:27.19,0:44:30.74,general text,,0,0,0,,قلعة سوهو الواقعة على الحدود، تخضع لحراسة عائلة سو. يتشاجرون في كثير من الأحيان
Dialogue: 0,0:44:30.82,0:44:34.66,مائل,,0,0,0,,لكل فرد فانوس خاص به، والذي يحترق بسبب الطاقة الحيوية لصاحبه.
Dialogue: 0,0:44:34.74,0:44:36.45,مائل,,0,0,0,,حتى يعرفوا على وجه اليقين من هو على قيد الحياة ومن ليس على قيد الحياة
Dialogue: 0,0:44:37.58,0:44:39.79,نص عام,,0,0,0,,إذا ماتت الملكة،
Dialogue: 0,0:44:40.29,0:44:42.83,general text,,0,0,0,,سيعرفون ذلك على الفور بسبب فانوس حياتها.
Dialogue: 0,0:44:43.84,0:44:46.96,نص عام,,0,0,0,,بالضبط أتذكر تلك الفوانيس
Dialogue: 0,0:44:47.05,0:44:51.09,general text,,0,0,0,,روحها يمكن أن تعيش في جسد آخر
Dialogue: 0,0:44:52.80,0:44:57.77,مائل,,0,0,0,,كما في حالة السيد كانغ من دايغانتونغون، فهو الآن في سيجوكون
Dialogue: 0,0:45:00.69,0:45:05.06,النص العام,,0,0,0,,هل أنت متأكد من أن الملكة بدوية؟
Dialogue: 0,0:45:06.65,0:45:08.32,نص عام,,0,0,0,,إذا علمنا بهذا الأمر يقينًا،
Dialogue: 0,0:45:09.32,0:45:12.74,النص العام,,0,0,0,,هذا يعني أننا وجدنا أكبر نقاط ضعف جين مو
Dialogue: 0,0:45:15.99,0:45:18.20,مائل,,0,0,0,,إنهم يشتبهون بي في سوسنوفي بور
Dialogue: 0,0:45:18.29,0:45:21.25,general text,,0,0,0,,سيحاولون إثبات أن الملكة بدوية
Dialogue: 0,0:45:21.33,0:45:22.87,general text,,0,0,0,,إذن ما الذي يجب أن نقلق بشأنه؟
Dialogue: 0,0:45:23.92,0:45:27.21,general text,,0,0,0,,لقد اخترنا بالفعل الجسد الذي سننقل روحها إليه
Dialogue: 0,0:45:32.43,0:45:36.35,general text,,0,0,0,,هل يمكنك اصطحابها إلى جينيوون دون أي مشاكل؟
Dialogue: 0,0:45:37.60,0:45:39.31,نص عام,,0,0,0,,سأحضرها إلى هناك اليوم
Dialogue: 0,0:45:39.97,0:45:42.23,نص عام,,0,0,0,,إذا سار كل شيء حسب الخطة،
Dialogue: 0,0:45:42.81,0:45:45.36,general text,,0,0,0,,جينيوون سوف يستعيد ابنتهم المفقودة
Dialogue: 0,0:45:46.02,0:45:48.52,نص عام,,0,0,0,,وستكون الجنازة في القصر
Dialogue: 0,0:45:50.57,0:45:53.78,نص عام,,0,0,0,,لأن الملكة تكرم
Dialogue: 0,0:45:56.49,0:46:01.12,general text,,0,0,0,,ماذا سنفعل بجسدي السابق الذي فيه روح الملكة؟
Dialogue: 0,0:46:03.25,0:46:06.08,نص عام,,0,0,0,,لسنا بحاجة إليه بعد الآن. سوف نعتني به
Dialogue: 0,0:46:48.67,0:46:51.84,general text,,0,0,0,,جلالتك اليوم أتيت إليك بدلاً من الخصي كيم
Dialogue: 0,0:47:00.47,0:47:01.85,نص عام,,0,0,0,,يا له من عار
Dialogue: 0,0:47:02.68,0:47:06.56,general text,,0,0,0,,سيكون الأمر أسهل عليك بكثير لو تركك عقلك
Dialogue: 0,0:47:28.62,0:47:30.33,نص عام,,0,0,0,,لابد أن هذه قرية جيما
Dialogue: 0,0:47:31.13,0:47:33.21,ذكريات بخط مائل,,0,0,0,,هل تبحث عن شامان؟
Dialogue: 0,0:47:33.30,0:47:34.30,ذكريات,,0,0,0,,نعم
Dialogue: 0,0:47:35.13,0:47:37.01,ذكريات,,0,0,0,,ثم أنظر في قرية جيما
Dialogue: 0,0:47:37.59,0:47:40.93,الذكريات,,0,0,0,,يعيش العديد من الشامان هناك
Dialogue: 0,0:47:41.51,0:47:44.10,ذكريات,,0,0,0,,أعرف أقدم الشامان
Dialogue: 0,0:47:44.68,0:47:47.48,ذكريات,,0,0,0,,إذا كنت تبحث عن شخص ما فاسأله
Dialogue: 0,0:47:50.90,0:47:52.27,النص العام,,0,0,0,,- كاهنة النار...\N- لا، شكرًا لك.
Dialogue: 0,0:47:54.48,0:47:58.49,general text,,0,0,0,,عذراً، هل تعرف أين يقع منزل الشامان بون؟
Dialogue: 0,0:47:58.57,0:47:59.91,نص عام,,0,0,0,,شامان بون؟
Dialogue: 0,0:47:59.99,0:48:02.24,النص العام,,0,0,0,,لقد فقد قواه
Dialogue: 0,0:48:02.33,0:48:03.99,نص عام,,0,0,0,,من الأفضل أن تذهب إلى كاهنة النار
Dialogue: 0,0:48:04.08,0:48:06.87,general text,,0,0,0,,- سآخذك إليها\N- لا، أنا أبحث عن الشامان بون.
Dialogue: 0,0:48:06.95,0:48:10.00,general text,,0,0,0,,- أقول لك، إنه لا يصلح لشيء\N- لكني أحتاجه
Dialogue: 0,0:48:10.92,0:48:11.92,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:48:24.06,0:48:26.02,نص عام,,0,0,0,,أين أنا؟
Dialogue: 0,0:48:26.56,0:48:28.64,نص عام,,0,0,0,,كل الشوارع متشابهة
Dialogue: 0,0:48:32.40,0:48:35.36,مائل,,0,0,0,,لم أكن أذهب إلى كاهنة النار!
Dialogue: 0,0:48:35.44,0:48:38.19,general text,,0,0,0,,ولكن لا يزال يتعين عليك الدفع، لأنك حصلت على ثروتك.
Dialogue: 0,0:48:38.28,0:48:40.70,النص العام,,0,0,0,,- إلى أين أنت ذاهب؟\N- لا تلمس!
Dialogue: 0,0:48:41.20,0:48:43.45,النص العام,,0,0,0,,لم تقل كلمة صحيحة. ما الذي يجب دفع ثمنه؟
Dialogue: 0,0:48:49.91,0:48:51.62,النص العام,,0,0,0,,هل ذهبت إلى الشامان بون؟
Dialogue: 0,0:48:51.71,0:48:53.00,النص العام,,0,0,0,,إنه سيء، أليس كذلك؟
Dialogue: 0,0:48:53.08,0:48:56.05,general text,,0,0,0,,كاهنة النار هي الأفضل. نعم؟
Dialogue: 0,0:48:56.13,0:48:57.76,نص عام,,0,0,0,"كاهنة النار" نعم بالطبع
Dialogue: 0,0:48:57.84,0:48:58.92,نص عام,,0,0,0,,توقف
Dialogue: 0,0:49:04.05,0:49:06.43,general text,,0,0,0,,هل أتيت للتنبؤ؟
Dialogue: 0,0:49:07.39,0:49:09.39,نص عام,,0,0,0,,وماذا عن نفسك؟ هل تريد تنفيذ طرد الارواح الشريرة؟
Dialogue: 0,0:49:10.02,0:49:12.81,general text,,0,0,0,,ماذا قالت كاهنة النار لتغضبك إلى هذا الحد؟
Dialogue: 0,0:49:13.44,0:49:16.90,general text,,0,0,0,,لا أرى أي حظ في الحكم، فمن الأفضل أن أمارس المهنة
Dialogue: 0,0:49:16.98,0:49:18.36,نص عام,,0,0,0,,أنا ولي العهد
Dialogue: 0,0:49:19.82,0:49:21.53,نص عام,,0,0,0,,ماذا قال لك الشامان بون؟
Dialogue: 0,0:49:21.61,0:49:23.95,نص عام,,0,0,0,,سأذهب إليه فحسب. لدي الكثير من الأسئلة
Dialogue: 0,0:49:26.74,0:49:27.79,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:49:30.96,0:49:33.17,general text,,0,0,0,,هل تبحث أيضًا عن الخصي كيم؟
Dialogue: 0,0:49:36.42,0:49:38.34,نص عام,,0,0,0,,لماذا تبحث عنه هنا؟
Dialogue: 0,0:49:42.05,0:49:45.39,general text,,0,0,0,,بعد تلك الحادثة في جيونبوغوان اختفى من القصر
Dialogue: 0,0:49:46.22,0:49:48.18,النص العام,,0,0,0,,آثاره قادتني إلى هنا
Dialogue: 0,0:49:48.26,0:49:51.60,general text,,0,0,0,,إذن أتيت إلى هنا بمفردك، بدون أمن؟
Dialogue: 0,0:49:53.39,0:49:55.23,نص عام,,0,0,0,,لا أريد أن يعرف أحد،
Dialogue: 0,0:49:56.19,0:49:57.90,نص عام,,0,0,0,,أني أشك فيه
Dialogue: 0,0:50:00.94,0:50:02.99,النص العام,,0,0,0,,فأنت توافق على أنه بدوي،
Dialogue: 0,0:50:04.07,0:50:06.95,general text,,0,0,0,,والملكة تتصرف بغرابة، تحاول إخفاء ذلك؟
Dialogue: 0,0:50:08.87,0:50:09.95,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:50:11.16,0:50:13.12,خط مائل,,0,0,0,,وأنت؟ ما الذي تبحث عنه؟
Dialogue: 0,0:50:13.79,0:50:16.63,نص عام,,0,0,0,,أعتقد أننا جئنا إلى هنا لنفس الشيء
Dialogue: 0,0:50:16.71,0:50:17.88,نص عام,,0,0,0,,هل نتبادل المعلومات؟
Dialogue: 0,0:50:18.71,0:50:20.00,نص عام,,0,0,0,,القليل من كل منهما؟
Dialogue: 0,0:50:20.80,0:50:22.80,نص عام,,0,0,0,,ممتاز. إذن أنت الأول
Dialogue: 0,0:50:22.88,0:50:24.80,نص عام,,0,0,0,,إذا قلت أولاً،
Dialogue: 0,0:50:24.88,0:50:27.60,general text,,0,0,0,,لن تخبرني بأي شيء، بدعوى أنك أمير
Dialogue: 0,0:50:27.68,0:50:28.64,نص عام,,0,0,0,,كيف تفهم؟
Dialogue: 0,0:50:30.56,0:50:31.56,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:50:33.18,0:50:36.81,general text,,0,0,0,,أثناء البحث عن كيم الخصي عثرت على شيء غريب.
Dialogue: 0,0:50:36.90,0:50:39.44,نص عام,,0,0,0,,كان يغادر القصر كل شهر ويذهب إلى مكان ما
Dialogue: 0,0:50:40.23,0:50:42.57,نص عام,,0,0,0,,جاء إلى هنا
Dialogue: 0,0:50:43.36,0:50:45.53,نص عام,,0,0,0,,أنا أبحث عن شامان تشوي
Dialogue: 0,0:50:46.11,0:50:47.03,نص عام,,0,0,0,,من هذا أيضًا؟
Dialogue: 0,0:50:47.11,0:50:49.58,نص عام,,0,0,0,,سأقول ذلك مرة أخرى. لهذا...
Dialogue: 0,0:50:50.41,0:50:51.62,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:50:52.70,0:50:55.83,نص عام,,0,0,0,,ماذا تقول لي كلماتك برأيك؟
Dialogue: 0,0:50:55.92,0:50:57.67,نص عام,,0,0,0,,لم أعد أعرف
Dialogue: 0,0:51:00.50,0:51:03.51,general text,,0,0,0,,- لماذا تتابعني؟\N- إلى الشامان بون
Dialogue: 0,0:51:03.59,0:51:05.22,نص عام,,0,0,0,,قد لا نذهب معًا
Dialogue: 0,0:51:05.30,0:51:08.64,general text,,0,0,0,,لكنني سأجعله يخبرك بكل ما قاله لك.
Dialogue: 0,0:51:09.30,0:51:10.43,نص عام,,0,0,0,,لأني أمير
Dialogue: 0,0:51:15.73,0:51:18.90,general text,,0,0,0,,- لا أعرف أين هو\N{\i1} - أنت تعرف كل شيء
Dialogue: 0,0:51:18.98,0:51:20.44,خط مائل,,0,0,0,,أنا حقًا لا أعرف
Dialogue: 0,0:51:23.36,0:51:28.41,نص عام,,0,0,0,,لقد تحدثت مع عمك وأمك
Dialogue: 0,0:51:28.49,0:51:30.28,نص عام,,0,0,0,,ماذا قالت؟
Dialogue: 0,0:51:30.37,0:51:32.74,general text,,0,0,0,,هل ما زالت غاضبة جدًا مني؟
Dialogue: 0,0:51:33.62,0:51:35.66,general text,,0,0,0,,هل سيطردني حقًا من سوسنوفي بور؟
Dialogue: 0,0:51:36.96,0:51:41.21,النص العام,,0,0,0,,قالوا إنهم سيسامحونك إذا وافقت على التوقيع على الرسالة
Dialogue: 0,0:51:41.29,0:51:44.13,النص العام,,0,0,0,,إذن فإنكما توافقان على عدم رؤية بعضكما مرة أخرى أبدًا
Dialogue: 0,0:51:47.51,0:51:48.34,نص عام,,0,0,0,,ها هو
Dialogue: 0,0:51:50.59,0:51:52.05,نص عام,,0,0,0,,كل شيء مكتوب هناك بالفعل
Dialogue: 0,0:51:52.14,0:51:54.35,نص عام,,0,0,0,,كل ما عليك فعله هو التوقيع عليها
Dialogue: 0,0:51:54.43,0:51:56.23,نص عام,,0,0,0,,ثم يمكنك العودة إلى المنزل
Dialogue: 0,0:51:56.77,0:51:58.52,خط مائل,,0,0,0,,يمكنك مناقشة كل شيء أولاً
Dialogue: 0,0:51:59.35,0:52:03.32,general text,,0,0,0,,سأتمكن من توفير الطعام والمأوى لك لفترة من الوقت،
Dialogue: 0,0:52:03.40,0:52:06.40,مائل,,0,0,0,,إذا قررت البقاء معًا
Dialogue: 0,0:52:06.49,0:52:07.32,خط مائل,,0,0,0,,الآن سأذهب
Dialogue: 0,0:52:18.75,0:52:19.96,نص عام,,0,0,0,,تشو يونغ...
Dialogue: 0,0:52:25.00,0:52:26.17,نص عام,,0,0,0,,بصراحة,
Dialogue: 0,0:52:29.51,0:52:31.26,نص عام,,0,0,0,,أنا آسف قليلاً
Dialogue: 0,0:52:34.01,0:52:36.10,نص عام,,0,0,0,,كنت أخشى أن أفعل...
Dialogue: 0,0:52:38.52,0:52:40.06,نص عام,,0,0,0,,متهورة للغاية
Dialogue: 0,0:52:43.86,0:52:45.11,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:52:51.53,0:52:53.66,النص العام,,0,0,0,,مجرد فكرة أنني لن أراك مرة أخرى...
Dialogue: 0,0:52:56.70,0:52:58.45,نص عام,,0,0,0,,هذا كل ما يقلقني
Dialogue: 0,0:53:00.50,0:53:02.21,نص عام,,0,0,0,,لا أستطيع التوقيع على الرسالة
Dialogue: 0,0:53:02.29,0:53:03.96,نص عام,,0,0,0,,لا أستطيع العيش بدونك
Dialogue: 0,0:53:06.25,0:53:08.38,caption,,0,0,0,,يتعهد جين تشو يونغ بعدم رؤية بارك دان غو مرة أخرى
Dialogue: 0,0:53:09.26,0:53:11.43,نص عام,,0,0,0,,في البداية أزعجني أيضًا
Dialogue: 0,0:53:14.47,0:53:16.31,نص عام,,0,0,0,,لكنني أريد أن أستمر في رؤيتك
Dialogue: 0,0:53:52.68,0:53:54.64,نص عام,,0,0,0,,اكتملت المفاوضات
Dialogue: 0,0:53:54.72,0:53:57.51,نص عام,,0,0,0,,مو دوك، اضبط الطاولة
Dialogue: 0,0:54:04.06,0:54:05.90,نص عام,,0,0,0,,تناول السمك
Dialogue: 0,0:54:12.32,0:54:13.90,نص عام,,0,0,0,,واللحوم أيضاً
Dialogue: 0,0:54:25.96,0:54:30.05,النص العام,,0,0,0,,هل ستبقى هنا حقًا؟
Dialogue: 0,0:54:30.13,0:54:31.34,نص عام,,0,0,0,,نعم
Dialogue: 0,0:54:31.42,0:54:35.51,نص عام,,0,0,0,,سوف نذهب إلى المنزل لإحضار بعض الأشياء
Dialogue: 0,0:54:35.59,0:54:38.35,general text,,0,0,0,,هل ستبني عشًا هنا لقضاء شهر العسل؟
Dialogue: 0,0:54:41.43,0:54:42.64,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,0:54:42.73,0:54:44.60,نص عام,,0,0,0,,لكننا بحاجة إلى تغيير الملابس
Dialogue: 0,0:54:44.69,0:54:47.40,general text,,0,0,0,,هل يمكنك الذهاب مع تشو يونغ وإحضار أغراضها؟
Dialogue: 0,0:54:58.20,0:54:59.91,general text,,0,0,0,,هل رميت الورقة التي كانت ملقاة هنا؟
Dialogue: 0,0:55:00.49,0:55:01.33,نص عام,,0,0,0,,كل شيء هنا
Dialogue: 0,0:55:08.63,0:55:09.63,caption,,0,0,0,,يتعهد جين تشو يونغ بعدم رؤية بارك دان غو مرة أخرى
Dialogue: 0,0:55:09.71,0:55:11.25,نص عام,,0,0,0,,أحتاج إلى التفكير في كل شيء
Dialogue: 0,0:55:12.46,0:55:15.67,النص العام,,0,0,0,,إذا حزمت أمتعتي وغادرت، فقد يطردونني حقًا
Dialogue: 0,0:55:17.76,0:55:19.09,نص عام,,0,0,0,,هل تأذيت؟
Dialogue: 0,0:55:21.35,0:55:22.52,نص عام,,0,0,0,,هل يؤلمك؟
Dialogue: 0,0:55:23.10,0:55:24.60,نص عام,,0,0,0,,بالطبع هذا مؤلم!
Dialogue: 0,0:55:29.77,0:55:30.81,نص عام,,0,0,0,,ماذا؟ هل لديك ندبة؟
Dialogue: 0,0:55:30.90,0:55:32.44,نص عام,,0,0,0,,من أين حصلت عليه؟
Dialogue: 0,0:55:33.15,0:55:34.44,نص عام,,0,0,0,,ليس لدي أي فكرة
Dialogue: 0,0:55:34.53,0:55:36.61,النص العام,,0,0,0,,أعاني منه منذ الصغر، فلا أتذكر
Dialogue: 0,0:55:37.61,0:55:39.62,نص عام,,0,0,0,,يبقى هكذا بعد القطع
Dialogue: 0,0:55:39.70,0:55:42.79,general text,,0,0,0,,أختي أصيبت بنفس الشيء بسببي
Dialogue: 0,0:55:44.12,0:55:47.04,النص العام,,0,0,0,,سقطت كما أنت الآن
Dialogue: 0,0:55:54.84,0:55:57.34,نص عام,,0,0,0,,ظهرت ندبة في مكان القطع
Dialogue: 0,0:56:02.26,0:56:03.68,نص عام,,0,0,0,,فقط ما تحتاجه
Dialogue: 0,0:56:05.52,0:56:08.69,نص عام,,0,0,0,,سأبذل قصارى جهدي يا أبي
Dialogue: 0,0:56:11.11,0:56:13.23,نص عام,,0,0,0,,لا تناديني بهذا إلا للضرورة
Dialogue: 0,0:56:14.44,0:56:15.82,نص عام,,0,0,0,,قشعريرة
Dialogue: 0,0:56:25.33,0:56:27.87,نص عام,,0,0,0,,لم يكن من الضروري أن تكون وقحًا
Dialogue: 0,0:56:28.62,0:56:31.67,general text,,0,0,0,,ولماذا رمى مثل هذا الوشاح الحريري الجميل؟
Dialogue: 0,0:56:33.29,0:56:34.38,نص عام,,0,0,0,,ماذا...
Dialogue: 0,0:56:42.51,0:56:45.06,نص عام,,0,0,0,,لها نفس نمط عصابة رأس مو ديوك
Dialogue: 0,0:56:49.35,0:56:51.81,general text,,0,0,0,,- هل غادر السيد جينيون؟\N- نعم
Dialogue: 0,0:56:54.77,0:56:56.32,نص عام,,0,0,0,,ما نوع هذا النمط؟
Dialogue: 0,0:56:56.40,0:56:59.15,نص عام,,0,0,0,,شعار عائلة جين
Dialogue: 0,0:56:59.90,0:57:02.03,نص عام,,0,0,0,,أنت ذاهب إلى هناك اليوم. استعد
Dialogue: 0,0:57:02.70,0:57:03.87,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:57:06.62,0:57:08.41,التعليق الصوتي,,0,0,0,,أهذا ما كان عليه الحال؟
Dialogue: 0,0:57:17.00,0:57:19.63,خلف الكواليس,,0,0,0,,لماذا كان لدى مو دوك شيء ما...
Dialogue: 0,0:57:19.72,0:57:22.09,خلف الكواليس,,0,0,0,,مع شعار جينيوون؟
Dialogue: 0,0:57:29.60,0:57:32.10,النص العام,,0,0,0,,أجمع أغراضي حتى لا تكتشف أمي أي شيء
Dialogue: 0,0:57:32.19,0:57:33.27,نص عام,,0,0,0,,اتبعني
Dialogue: 0,0:57:34.52,0:57:37.15,نص عام,,0,0,0,,أريدها أن تعود إلى المنزل وتبقى هناك
Dialogue: 0,0:57:45.20,0:57:48.12,النص العام,,0,0,0,,هل يمكن الوثوق به حقًا؟ يبدو وكأنه عملية احتيال
Dialogue: 0,0:57:48.95,0:57:50.79,نص عام,,0,0,0,,ربما يكون مميزًا
Dialogue: 0,0:57:51.37,0:57:55.21,general text,,0,0,0,,هناك مثل هذه النار بينكم. هناك شيء أكثر هنا
Dialogue: 0,0:57:55.79,0:57:56.96,النص العام,,0,0,0,,هل أنتم عشاق؟
Dialogue: 0,0:57:59.25,0:58:00.67,نص عام,,0,0,0,,واو...
Dialogue: 0,0:58:02.72,0:58:05.93,نص عام,,0,0,0,,قاعدتي: لا تعلن ما تسمعه هنا للعامة
Dialogue: 0,0:58:06.01,0:58:07.68,نص عام,,0,0,0,,يمكنك الاعتماد عليّ
Dialogue: 0,0:58:07.76,0:58:12.52,general text,,0,0,0,,هناك شيء مهم بينكما، هل أنا على حق؟
Dialogue: 0,0:58:14.02,0:58:14.90,نص عام,,0,0,0,,وهو جيد
Dialogue: 0,0:58:16.27,0:58:17.19,نص عام,,0,0,0,,هيا...
Dialogue: 0,0:58:19.36,0:58:22.19,general text,,0,0,0,,سمعت أنك عشت أطول مدة في قرية جيما
Dialogue: 0,0:58:22.28,0:58:24.70,نص عام,,0,0,0,,هل تعرف الشامان تشوي؟
Dialogue: 0,0:58:27.99,0:58:29.24,نص عام,,0,0,0,,شامان تشوي؟
Dialogue: 0,0:58:29.33,0:58:32.25,general text,,0,0,0,,هل تتعقب استخدام السحر الأسود؟
Dialogue: 0,0:58:35.62,0:58:39.80,نص عام,,0,0,0,,إطلاقاً. لقد سمعت للتو أنها كانت جيدة جدًا في حرفتها.
Dialogue: 0,0:58:39.88,0:58:41.76,نص عام,,0,0,0,,لذا أود أن أجدها
Dialogue: 0,0:58:45.34,0:58:46.55,نص عام,,0,0,0,,لقد كانت جيدة
Dialogue: 0,0:58:47.14,0:58:49.05,النص العام,,0,0,0,,لكن مضى أكثر من 20 عامًا منذ ذلك الحين
Dialogue: 0,0:58:56.48,0:58:57.81,مائل,,0,0,0,,شامان تشوي كان مشهوراً
Dialogue: 0,0:58:57.90,0:59:01.86,خط مائل,,0,0,0,,يلقي السحر على الناس
Dialogue: 0,0:59:02.44,0:59:04.40,مائل,,0,0,0,,كان يا مكان لسحرة جيونبوغوان
Dialogue: 0,0:59:04.49,0:59:08.37,مائل,,0,0,0,,كاد أن يمسك بها
Dialogue: 0,0:59:09.28,0:59:10.83,مائل,,0,0,0,,لكنها تمكنت من القفز في النار
Dialogue: 0,0:59:13.08,0:59:16.62,مائل,,0,0,0,,يقولون إنها ماتت في ذلك اللهب
Dialogue: 0,0:59:17.29,0:59:21.21,general text,,0,0,0,,ويعتقد آخرون أنها أصيبت بحروق بالغة، لكنها نجت
Dialogue: 0,0:59:21.88,0:59:23.01,نص عام,,0,0,0,,ثم والدك تشانغ غان...
Dialogue: 0,0:59:23.09,0:59:26.01,نص عام,,0,0,0,,كان غوانغجو جيونبوغوان
Dialogue: 0,0:59:28.80,0:59:31.93,general text,,0,0,0,,أنت تبحث عن الشامان تشوي لأنها تحمل ضغينة ضد والدك
Dialogue: 0,0:59:33.06,0:59:35.39,general text,,0,0,0,,بسبب اضطهاد جيونبوغوان؟
Dialogue: 0,0:59:35.48,0:59:37.77,نص عام,,0,0,0,,لا أتذكر والدي حتى
Dialogue: 0,0:59:38.40,0:59:40.61,general text,,0,0,0,,كيف أعرف من يحمل ضغينة ضده؟
Dialogue: 0,0:59:44.19,0:59:47.24,caption,,0,0,0,,يتعهد بارك دان غو بعدم رؤية جين جو يونغ مرة أخرى
Dialogue: 0,0:59:49.36,0:59:51.62,نص عام,,0,0,0,,أنت لم توقع
Dialogue: 0,0:59:51.70,0:59:54.24,النص العام,,0,0,0,,كنت أفكر في التوقيع على الورقة والعودة إلى المنزل،
Dialogue: 0,0:59:55.16,0:59:57.25,نص عام,,0,0,0,,لكن هذا سيكون كذبًا
Dialogue: 0,0:59:57.33,0:59:59.29,نص عام,,0,0,0,,لا أستطيع العيش بدونها
Dialogue: 0,1:00:02.50,1:00:05.05,نص عام,,0,0,0,,مشاعري لم تظهر بين عشية وضحاها
Dialogue: 0,1:00:05.92,1:00:09.05,general text,,0,0,0,,لقد أحببتها منذ زمن طويل، لكن لم تتح لي الفرصة للاعتراف بذلك
Dialogue: 0,1:00:09.13,1:00:11.10,نص عام,,0,0,0,,لم أستطع أن أمسك بيدها إلا الآن
Dialogue: 0,1:00:11.68,1:00:13.18,نص عام,,0,0,0,,لا تسمي مشاعرنا طفولية...
Dialogue: 0,1:00:13.26,1:00:15.81,نص عام,,0,0,0,,واعطينا فرصة
Dialogue: 0,1:00:15.89,1:00:18.19,نص عام,,0,0,0,,خذ أمتعتك...
Dialogue: 0,1:00:18.27,1:00:19.90,نص عام,,0,0,0,,واذهب إلى منزل أوكو
Dialogue: 0,1:00:20.90,1:00:22.61,نص عام,,0,0,0,,- عم...\N- أحتاج،
Dialogue: 0,1:00:23.52,1:00:25.07,خط مائل,,0,0,0,,لكي تفعل شيئًا هناك
Dialogue: 0,1:00:34.79,1:00:36.70,مائل,,0,0,0,,إذا جاء هذا الرجل إلى منزله،
الحوار: 0,1:00:36.79,1:00:38.46,نص عام,,0,0,0,,أخبرني على الفور
Dialogue: 0,1:00:38.54,1:00:40.58,نص عام,,0,0,0,,من هذا؟
Dialogue: 0,1:00:41.75,1:00:43.59,النص العام,,0,0,0,,جانغ جانج، غوانغجو جيونبوغوان
Dialogue: 0,1:00:44.34,1:00:45.59,نص عام,,0,0,0,,الأب أوكا
Dialogue: 0,1:00:49.22,1:00:50.80,مائل,,0,0,0,,إذا جاء،
الحوار: 0,1:00:52.76,1:00:54.01,نص عام,,0,0,0,,أخبرني
Dialogue: 0,1:00:55.10,1:00:56.27,نص عام,,0,0,0,,فوراً
Dialogue: 0,1:00:58.93,1:01:00.85,نص عام,,0,0,0,,بالضبط، لقد نسيت تمامًا
Dialogue: 0,1:01:00.94,1:01:04.44,النص العام,,0,0,0,,كان لشامان تشوي أخ أصغر
Dialogue: 0,1:01:05.40,1:01:08.11,نص عام,,0,0,0,,هل تعرف أين هو؟
Dialogue: 0,1:01:08.19,1:01:12.32,نص عام,,0,0,0,,من تلك الحادثة لم أره مرة أخرى
Dialogue: 0,1:01:12.99,1:01:16.54,نص عام,,0,0,0,,ولكن كانت هناك شائعات عن زواجه...
Dialogue: 0,1:01:16.62,1:01:18.91,نص عام,,0,0,0,,عن امرأة من عائلة مؤثرة
Dialogue: 0,1:01:43.60,1:01:46.57,نص عام,,0,0,0,,قيل لي أنها قد تكون هي
Dialogue: 0,1:01:47.48,1:01:49.32,نص عام,,0,0,0,,لماذا ترتدي الخرق؟
Dialogue: 0,1:01:49.40,1:01:51.86,general text,,0,0,0,,عندما كانت طفلة، جرفتها الأمواج إلى شاطئ بحيرة جيونج تشيونج دايهو.
Dialogue: 0,1:01:51.95,1:01:54.62,general text,,0,0,0,,كانت بالكاد تتنفس عندما أنقذها الصياد
Dialogue: 0,1:01:55.53,1:01:58.70,general text,,0,0,0,,بعد تلك الحادثة فقدت ذاكرتها،
Dialogue: 0,1:01:59.33,1:02:04.29,general text,,0,0,0,,لكنه بالرغم من عماه إلا أنه يستطيع الإحساس بالأشياء من حوله
Dialogue: 0,1:02:27.31,1:02:30.32,نص عام,,0,0,0,,لديك شامة هنا...
Dialogue: 0,1:02:39.33,1:02:41.04,نص عام,,0,0,0,,والندبة في نفس المكان
Dialogue: 0,1:02:42.37,1:02:47.83,general text,,0,0,0,,لهذا السبب قالوا إنك على الأرجح بو يونغ لدينا
Dialogue: 0,1:02:47.92,1:02:49.42,نص عام,,0,0,0,,هذا فقط
Dialogue: 0,1:02:49.50,1:02:53.59,نص عام,,0,0,0,,قد يكون هذا مجرد صدفة. تحتاج إلى التحقق للتأكد
Dialogue: 0,1:03:00.51,1:03:02.68,نص عام,,0,0,0,,دعونا نذهب ونرى...
Dialogue: 0,1:03:03.98,1:03:05.77,نص عام,,0,0,0,,هل ستتمكن من فتح أبواب جينيوون
Dialogue: 0,1:03:15.78,1:03:17.86,النص العام,,0,0,0,,الناس من جيونبوغوان هنا مرة أخرى
Dialogue: 0,1:03:17.95,1:03:20.24,general text,,0,0,0,,ربما أحضروا الفتاة مرة أخرى ليكتشفوا ما إذا كانت بو يونغ
Dialogue: 0,1:03:30.29,1:03:33.71,التعليق الصوتي,,0,0,0,,هناك دم في جسدك جين تشو يونغ،
Dialogue: 0,1:03:33.80,1:03:36.34,خلف الكواليس,,0,0,0,,يجب أن تكون قادرًا على فتح أبواب جينيوون
Dialogue: 0,1:03:38.30,1:03:40.89,خلف الكواليس,,0,0,0,,حاول أن تفتحها قليلاً على الأقل
Dialogue: 0,1:03:41.47,1:03:43.18,خلف الكواليس,,0,0,0,,هذا سيكون كافياً
Dialogue: 0,1:03:53.19,1:03:55.69,نص عام,,0,0,0,,لقد كان الكثيرون هنا،
Dialogue: 0,1:03:56.40,1:03:57.86,نص عام,,0,0,0,,لكن لم يفتح أحد الباب
Dialogue: 0,1:04:41.28,1:04:42.45,نص عام,,0,0,0,,بو يونغ!
Dialogue: 0,1:04:43.74,1:04:45.04,نص عام,,0,0,0,,بونا يونغ
Dialogue: 0,1:04:48.50,1:04:52.25,خلف الكواليس,,0,0,0,,مرة أخرى. في كل مرة يحدث ذلك، الأمر يستحق المجيء إلى هنا
Dialogue: 0,1:05:08.31,1:05:09.85,نص عام,,0,0,0,,إذا حدث هذا قبل 20 عامًا،
Dialogue: 0,1:05:10.39,1:05:13.23,نص عام,,0,0,0,,لذلك كان جين مو تلميذ والدك
Dialogue: 0,1:05:14.36,1:05:16.65,نص عام,,0,0,0,,ربما يعرف جين مو شيئًا ما. هل يجب أن أسأله؟
Dialogue: 0,1:05:16.73,1:05:18.44,نص عام,,0,0,0,,مستحيل
Dialogue: 0,1:05:18.53,1:05:21.86,نص عام,,0,0,0,,احتفظ بسرية ما سمعته اليوم
Dialogue: 0,1:05:23.95,1:05:27.33,نص عام,,0,0,0,,لا يبدو أننا تعلمنا شيئًا مهمًا، لكن حسنًا
Dialogue: 0,1:05:30.79,1:05:34.04,general text,,0,0,0,,صاحب السمو، أتيت إلى هنا بمفردك، أليس كذلك؟
Dialogue: 0,1:05:34.13,1:05:35.13,خط مائل,,0,0,0,,هكذا كان
Dialogue: 0,1:05:35.21,1:05:38.63,النص العام,,0,0,0,,ولكن يبدو أن هناك من يتابعنا
Dialogue: 0,1:05:42.09,1:05:45.26,general text,,0,0,0,,هل يجب أن نفترق لنعرف من منا يتبع؟
Dialogue: 0,1:06:25.39,1:06:26.60,نص عام,,0,0,0,,أمي!
Dialogue: 0,1:07:08.72,1:07:10.68,general text,,0,0,0,,من أنت ولماذا تلاحقني؟
Dialogue: 0,1:07:13.73,1:07:14.64,نص عام,,0,0,0,,أنا أسأل...
Dialogue: 0,1:07:18.06,1:07:19.15,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,1:08:11.41,1:08:14.95,preview,,0,0,0,,بو يونغ، ما أحضره جين مو هو محتال اسمه سونغ يي
Dialogue: 0,1:08:15.04,1:08:16.25,preview,,0,0,0,,لماذا هذا هنا؟
Dialogue: 0,1:08:16.33,1:08:17.75,معاينة,,0,0,0,,الابنة الحقيقية - مو ديوك
Dialogue: 0,1:08:17.83,1:08:19.79,preview,,0,0,0,,ماذا سيحدث لي إذا اكتشفت كل شيء؟
Dialogue: 0,1:08:19.87,1:08:22.38,preview,,0,0,0,,جين مو لديه شيء لن يسمح حتى لجين هو كيونغ بفتح فمه،
Dialogue: 0,1:08:22.46,1:08:25.13,معاينة,,0,0,0,,إذا اكتشفت أمر الاستبدال
Dialogue: 0,1:08:25.71,1:08:26.76,معاينة,,0,0,0,,ماذا تريد؟
Dialogue: 0,1:08:26.84,1:08:31.34,معاينة,,0,0,0,,عليك تدمير غابة الصنوبر لحماية حجر الجليد
Dialogue: 0,1:08:32.68,1:08:34.60,معاينة,,0,0,0,,اهدأ من فضلك!
Dialogue: 0,1:08:34.68,1:08:37.14,preview,,0,0,0,,هل تريد أن تصبح بطلاً بمصير نجم ملكي،
Dialogue: 0,1:08:37.23,1:08:39.48,preview,,0,0,0,,تدمير كل حجر جليدي وإنقاذ العالم من الفوضى؟
Dialogue: 0,1:08:39.56,1:08:40.85,preview,,0,0,0,,هل يول هنا؟
Dialogue: 0,1:08:40.94,1:08:42.56,preview,,0,0,0,,سيكون أول من أقتله
الحوار: 0,1:08:43.27,1:08:44.52,معاينة,,0,0,0,,سيد!
Dialogue: 0,1:08:45.98,1:08:46.94,معاينة,,0,0,0,,ها هو البدو!
Dialogue: 0,1:08:47.03,1:08:48.32,معاينة,,0,0,0,,يجب أن يموت تشان ووك
Dialogue: 0,1:08:48.40,1:08:50.41,preview,,0,0,0,,تشان ووك، تلميذي...
Dialogue: 0,1:08:50.41,1:08:52.41,نص عام,,0,0,0,,

