Dialogue: 0,0:02:47.39,0:02:49.39,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:49.39,0:02:51.39,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:51.39,0:02:53.39,nicks,,0,0,0,,Mga tagasalin ng Typesetter: {\c&HFFF4C5&} Ria_Lee, Zero_Amamiya
Dialogue: 0,0:01:04.34,0:01:06.39,mga alaala,,0,0,0,,Yul mula sa pamilyang So
Dialogue: 0,0:01:08.10,0:01:09.68,mga alaala,,0,0,0,,Huwag ka nang babalik dito
Dialogue: 0,0:01:16.06,0:01:17.48,mga alaala,,0,0,0,,Darating ka ulit -
Dialogue: 0,0:01:18.90,0:01:20.53,mga alaala,,0,0,0,,papatayin kita
Dialogue: 0,0:01:25.99,0:01:26.82,mga alaala,,0,0,0,,Teka...
Dialogue: 0,0:01:52.85,0:01:55.69,voiceover,,0,0,0,,Hindi ko siya napigilan
Dialogue: 0,0:01:57.10,0:01:58.94,behind the scenes,,0,0,0,,Hindi ko matanong kung bakit
Dialogue: 0,0:02:00.19,0:02:03.44,voiceover,,0,0,0,,Nang pinutol niya ang sinseridad ko,
Dialogue: 0,0:02:04.86,0:02:07.53,behind the scenes,,0,0,0,,Tumigil ako sa pagpapahalaga sa ating mga alaala
Dialogue: 0,0:02:08.82,0:02:11.45,voiceover,,0,0,0,,Naging sikreto ang lahat na kailangan kong itago sa puso ko
Dialogue: 0,0:02:17.79,0:02:21.21,general text,,0,0,0,,Maaga kang gumising. Anong ginagawa mo dito?
Dialogue: 0,0:02:25.51,0:02:26.80,general text,,0,0,0,,Bakit ka
Dialogue: 0,0:02:27.80,0:02:29.26,general text,,0,0,0,,pumunta dito?
Dialogue: 0,0:02:32.01,0:02:34.35,pangkalahatang teksto,,0,0,0,,Hulihin ang ibon. Ihahanda ko ito para sa iyo
Dialogue: 0,0:02:37.23,0:02:38.73,pangkalahatang teksto,,0,0,0,,Hindi nagdudulot sa akin ng kagalakan ang pagkain
Dialogue: 0,0:02:38.81,0:02:40.77,general text,,0,0,0,,Magluluto ako ng kanin na may kastanyas
Dialogue: 0,0:02:41.90,0:02:44.15,pangkalahatang teksto,,0,0,0,,Napakatamis ng mga kastanyas dito
Dialogue: 0,0:02:48.03,0:02:50.82,pangkalahatang teksto,,0,0,0,,May napakatamis na mga kastanyas sa Danhyangk
Dialogue: 0,0:03:04.00,0:03:05.46,general text,,0,0,0,,At hindi rin ako mahilig sa matamis
Dialogue: 0,0:03:08.80,0:03:11.01,general text,,0,0,0,,Maaari kang tumanggi
Dialogue: 0,0:03:11.09,0:03:13.47,general text,,0,0,0,,Sa lakas mo, namatay na sana ako
Dialogue: 0,0:03:16.02,0:03:17.43,pangkalahatang teksto,,0,0,0,,Huwag mag-overact
Dialogue: 0,0:03:18.39,0:03:21.73,general text,,0,0,0,,Itinulak kita, pero hindi ko sinasadyang patayin ka
Dialogue: 0,0:03:21.81,0:03:23.40,pangkalahatang teksto,,0,0,0,,Pero itinulak nila
Dialogue: 0,0:03:24.02,0:03:25.94,pangkalahatang teksto,,0,0,0,,Hindi na kailangang mag-abala sa almusal
Dialogue: 0,0:03:26.03,0:03:27.49,general text,,0,0,0,,Aalis ako kapag nagising si Dan Gu
Dialogue: 0,0:03:27.57,0:03:30.11,pangkalahatang teksto,,0,0,0,,Ayoko, ayon sa gusto mo
Dialogue: 0,0:03:46.76,0:03:48.13,general text,,0,0,0,,Bakit nandito ka pa?
Dialogue: 0,0:03:50.01,0:03:51.26,general text,,0,0,0,,Kakain muna ako bago umalis
Dialogue: 0,0:03:51.84,0:03:52.93,pangkalahatang teksto,,0,0,0,,Magluto ng pagkain
Dialogue: 0,0:03:53.01,0:03:54.64,general text,,0,0,0,,Akala ko ayaw mo
Dialogue: 0,0:03:55.22,0:03:57.52,general text,,0,0,0,,Hindi ko sinabi yun. Huwag kang maninira
Dialogue: 0,0:04:00.23,0:04:04.56,general text,,0,0,0,,Masyado kang uminom kahapon, akala ko masama ang pakiramdam mo sa umaga
Dialogue: 0,0:04:04.65,0:04:07.19,general text,,0,0,0,,Tumanggi ako para hindi ka maabala
Dialogue: 0,0:04:08.28,0:04:09.49,pangkalahatang teksto,,0,0,0,,Naiintindihan
Dialogue: 0,0:04:10.28,0:04:11.45,pangkalahatang teksto,,0,0,0,,Pagkatapos
Dialogue: 0,0:04:11.53,0:04:14.12,general text,,0,0,0,,- kailangan pa nating maghugas ng bigas\N- Asan na?
Dialogue: 0,0:04:14.78,0:04:17.49,general text,,0,0,0,,- Maghuhugas ako\N- Nagluto ka na ba ng kanin?
Dialogue: 0,0:04:17.58,0:04:20.87,general text,,0,0,0,,Hindi, pero kaya ko kung tuturuan mo ako
Dialogue: 0,0:04:22.00,0:04:23.42,pangkalahatang teksto,,0,0,0,,Napakasimple nito
Dialogue: 0,0:04:24.08,0:04:27.55,pangkalahatang teksto,,0,0,0,, Banlawan ang bigas sa tubig, magdagdag ng sapat na tubig
Dialogue: 0,0:04:27.63,0:04:29.09,pangkalahatang text,,0,0,0,,at lutuin sa sobrang init
Dialogue: 0,0:04:29.92,0:04:32.09,pangkalahatang teksto,,0,0,0,,At pagkatapos ay hayaan itong tumayo
Dialogue: 0,0:04:33.43,0:04:35.14,pangkalahatang teksto,,0,0,0,,Medyo simple
Dialogue: 0,0:04:43.85,0:04:46.31,general text,,0,0,0,,Sabi mo kaya mo kung magpaliwanag ako
Dialogue: 0,0:04:46.40,0:04:48.11,general text,,0,0,0,,Sila mismo ang nagsabi na madali lang
Dialogue: 0,0:04:49.65,0:04:52.74,general text,,0,0,0,,Nagkamali ako. pasensya na po
Dialogue: 0,0:04:53.49,0:04:55.95,pangkalahatang teksto,,0,0,0,,Tingnan mo ito
Dialogue: 0,0:04:56.03,0:04:57.62,pangkalahatang teksto,,0,0,0,,Nasunog niya ang buong
Dialogue: 0,0:04:58.41,0:05:00.50,pangkalahatang teksto,,0,0,0,,Hayaan akong gumawa ng mga pagbabago
Dialogue: 0,0:05:02.08,0:05:03.62,pangkalahatang teksto,,0,0,0,,At ang mga gulay na iyon
Dialogue: 0,0:05:03.71,0:05:05.13,pangkalahatang teksto,,0,0,0,,Turuan kung paano maghiwa ng gulay
Dialogue: 0,0:05:09.96,0:05:12.72,general text,,0,0,0,,- Itapon mo na lang\N- Wow
Dialogue: 0,0:05:19.60,0:05:20.93,pangkalahatang teksto,,0,0,0,,Dan Gu
Dialogue: 0,0:05:22.06,0:05:22.93,pangkalahatang text,,0,0,0,,Hey
Dialogue: 0,0:05:23.52,0:05:25.19,pangkalahatang text,,0,0,0,,Lungoy bago umalis
Dialogue: 0,0:05:25.27,0:05:27.15,pangkalahatang teksto,,0,0,0,,Ang mineral na tubig ay gagawing mas malambot ang iyong balat
Dialogue: 0,0:05:27.23,0:05:28.82,pangkalahatang text,,0,0,0,,At mag-almusal
Dialogue: 0,0:05:28.90,0:05:30.23,pangkalahatang teksto,,0,0,0,, Eksakto
Dialogue: 0,0:05:30.32,0:05:32.44,pangkalahatang teksto,,0,0,0,,Sabay na naghahanda ng almusal sina Moo Deok at Yul
Dialogue: 0,0:05:33.36,0:05:34.74,pangkalahatang teksto,,0,0,0,,- Magkasama?\N- Oo
Dialogue: 0,0:05:34.82,0:05:37.12,general text,,0,0,0,,Nagluto si Yul ng kanin kasama si Moo Deok
Dialogue: 0,0:05:49.54,0:05:53.17,general text,,0,0,0,,Sabi ko sayong gupitin mo ang sibuyas sa malalaking piraso
Dialogue: 0,0:05:58.18,0:05:59.26,pangkalahatang teksto,,0,0,0,,- Malalaki ba ito?\N- Hindi
Dialogue: 0,0:05:59.93,0:06:02.47,pangkalahatang teksto,,0,0,0,,Hindi mo alam ang kahulugan ng salitang "malaki"?
Dialogue: 0,0:06:02.56,0:06:04.14,pangkalahatang teksto,,0,0,0,,Malalaking piraso
Dialogue: 0,0:06:06.56,0:06:08.27,pangkalahatang teksto,,0,0,0,,Malaki...
Dialogue: 0,0:06:08.36,0:06:09.65,pangkalahatang teksto,,0,0,0,,Hindi pareho
Dialogue: 0,0:06:09.73,0:06:11.44,pangkalahatang teksto,,0,0,0,,Maliit din ang mga ito
Dialogue: 0,0:06:13.19,0:06:14.15,pangkalahatang teksto,,0,0,0,,Gaya nito
Dialogue: 0,0:06:14.82,0:06:18.16,pangkalahatang teksto,,0,0,0,,Malalaking piraso. ganito
Dialogue: 0,0:06:19.32,0:06:22.29,general text,,0,0,0,,Dapat ay naipaliwanag ko ito ng maayos
Dialogue: 0,0:06:22.37,0:06:25.29,pangkalahatang teksto,,0,0,0,,Paano ko maiintindihan ang iyong "malaking piraso"?
Dialogue: 0,0:06:25.37,0:06:27.71,pangkalahatang teksto,,0,0,0,,Akala ko ikaw ang pinakamahusay na mago ng Jeonjingak
Dialogue: 0,0:06:27.79,0:06:31.25,pangkalahatang teksto,,0,0,0,,Hindi masasabi ang malaki sa maliit?
Dialogue: 0,0:06:32.46,0:06:33.38,italics,,0,0,0,,Kalimutan
Dialogue: 0,0:06:33.46,0:06:35.88,pangkalahatang teksto,,0,0,0,,Ibuhos ang tubig sa isang mangkok
Dialogue: 0,0:06:43.72,0:06:44.68,pangkalahatang text,,0,0,0,,Teka...
Dialogue: 0,0:06:45.48,0:06:47.44,general text,,0,0,0,,Aling bowl ang sinasabi mo?
Dialogue: 0,0:06:49.48,0:06:50.48,pangkalahatang teksto,,0,0,0,,Ito?
Dialogue: 0,0:06:54.03,0:06:55.07,pangkalahatang teksto,,0,0,0,,O ito?
Dialogue: 0,0:06:55.82,0:06:56.70,pangkalahatang teksto,,0,0,0,,Ito?
Dialogue: 0,0:06:59.45,0:07:00.74,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:07:06.91,0:07:09.83,general text,,0,0,0,,Bakit parang pinapagalitan siya ni Moo Deok?
Dialogue: 0,0:07:10.63,0:07:12.09,general text,,0,0,0,,Sigurado ka bang gusto niya siya?
Dialogue: 0,0:07:12.17,0:07:13.63,general text,,0,0,0,,Ito ang ganitong uri ng babae
Dialogue: 0,0:07:14.13,0:07:17.84,pangkalahatang teksto,,0,0,0,,Hindi siya nagpapakita ng pagmamahal o kahihiyan sa harap ng iba
Dialogue: 0,0:07:21.14,0:07:24.31,general text,,0,0,0,,Tingnan mo na lang si Yulia
Dialogue: 0,0:07:25.10,0:07:27.81,general text,,0,0,0,,Pinagalitan nila siya, pero nag-aaral pa rin.
Dialogue: 0,0:07:30.60,0:07:32.31,general text,,0,0,0,,- Nag-aaral?\N- Look
Dialogue: 0,0:07:33.02,0:07:34.82,general text,,0,0,0,,sabi ko sapat na
Dialogue: 0,0:07:36.19,0:07:37.65,general text,,0,0,0,,Ayoko ng maalat na pagkain
Dialogue: 0,0:07:41.28,0:07:42.66,italics,,0,0,0,,Hindi siya ganyan
Dialogue: 0,0:07:42.74,0:07:45.66,general text,,0,0,0,,- Try it yourself\N- {\i1}Kahit sa harap ni Master Ho o ng tito ko
Dialogue: 0,0:07:45.74,0:07:46.95,pangkalahatang teksto,,0,0,0,,Nakakatawa
Dialogue: 0,0:07:47.54,0:07:50.46,italics,,0,0,0,,Para siyang takot na estudyante, di ba?
Dialogue: 0,0:07:50.54,0:07:51.92,italics,,0,0,0,,Bland, huh?
Dialogue: 0,0:07:52.00,0:07:55.75,pangkalahatang teksto,,0,0,0,,Narito. Tumigil na sana ako nung sinabi ko
Dialogue: 0,0:07:55.84,0:07:59.26,general text,,0,0,0,,- I'm sorry\N- {\i1}Mahal na master at ang kanyang masunuring estudyante
Dialogue: 0,0:08:00.38,0:08:02.68,pangkalahatang text,,0,0,0,,Umalis. Kailangang tapusin ang pagluluto
Dialogue: 0,0:08:02.76,0:08:04.89,pangkalahatang teksto,,0,0,0,,- Guro at disipulo?\N{\i1}- Umupo
Dialogue: 0,0:08:04.97,0:08:07.27,general text,,0,0,0,,Bakit ba ang tigas ng ulo mo,
Dialogue: 0,0:08:07.35,0:08:09.48,pangkalahatang text,,0,0,0,,kung nagluluto ka sa unang pagkakataon?
Dialogue: 0,0:08:16.65,0:08:17.61,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:08:17.69,0:08:21.32,general text,,0,0,0,,Tingnan natin kung paano mo siya tinuruan, at kung paano ka natuto
Dialogue: 0,0:08:21.86,0:08:23.41,pangkalahatang teksto,,0,0,0,,Subukan natin
Dialogue: 0,0:08:28.79,0:08:30.08,pangkalahatang teksto,,0,0,0,,Masarap
Dialogue: 0,0:08:30.16,0:08:31.46,pangkalahatang teksto,,0,0,0,,Masarap?
Dialogue: 0,0:08:33.88,0:08:36.09,general text,,0,0,0,,Ginawa ko ang lahat gaya ng sinabi ni Moo Deok
Dialogue: 0,0:08:39.13,0:08:40.26,pangkalahatang teksto,,0,0,0,,Magaling
Dialogue: 0,0:08:41.34,0:08:44.14,pangkalahatang teksto,,0,0,0,,Natutuwa, sa palagay ko, pagkatapos ng papuri ng guro
Dialogue: 0,0:08:44.72,0:08:48.01,general text,,0,0,0,,Akala ko magaling ako sa lahat ng bagay dahil henyo ang tawag sa akin ng mga tao
Dialogue: 0,0:08:48.81,0:08:50.98,pangkalahatang teksto,,0,0,0,,Pero may isang bagay na hindi ko magawa
Dialogue: 0,0:08:51.06,0:08:52.02,pangkalahatang teksto,,0,0,0,,Mu Dok,
Dialogue: 0,0:08:52.10,0:08:53.73,pangkalahatang teksto,,0,0,0,,salamat sa pagtulong sa akin na maunawaan ito
Dialogue: 0,0:08:53.81,0:08:57.98,general text,,0,0,0,,Hindi madali dahil hindi niya naintindihan ang sinasabi ko
Dialogue: 0,0:08:58.07,0:09:00.74,general text,,0,0,0,,Ngunit patuloy pa rin siyang sumubok
Dialogue: 0,0:09:01.40,0:09:03.07,general text,,0,0,0,,Kaya nagpatuloy ako sa pagtuturo sa kanya
Dialogue: 0,0:09:04.61,0:09:05.99,pangkalahatang teksto,,0,0,0,,Nagmamalabis
Dialogue: 0,0:09:06.62,0:09:08.91,pangkalahatang teksto,,0,0,0,,Para bang ang royal table ay inilagay dito
Dialogue: 0,0:09:08.99,0:09:11.79,general text,,0,0,0,,Marami kang matututunan habang nagluluto
Dialogue: 0,0:09:11.87,0:09:13.46,general text,,0,0,0,,- Dapat matuto ka rin\N- Sayang,
Dialogue: 0,0:09:13.54,0:09:16.25,general text,,0,0,0,,Wala akong teacher na katulad niya
Dialogue: 0,0:09:18.17,0:09:20.17,general text,,0,0,0,,Sorry, pero medyo nasunog yung bigas
Dialogue: 0,0:09:20.26,0:09:22.92,pangkalahatang text,,0,0,0,,- Oo\N{\i1}- Maaari mong subukang muli
Dialogue: 0,0:09:23.01,0:09:26.47,pangkalahatang text,,0,0,0,,Moo Dok, sa tingin mo ba mas gagawa siya sa susunod?
Dialogue: 0,0:09:26.55,0:09:29.10,pangkalahatang teksto,,0,0,0,,Hindi siya ganap na walang pag-asa
Dialogue: 0,0:09:29.18,0:09:30.85,italics,,0,0,0,,Salamat sa mga salitang iyon
Dialogue: 0,0:09:45.82,0:09:47.24,general text,,0,0,0,,Bakit ikaw mismo ang naglalaba nito?
Dialogue: 0,0:09:47.32,0:09:49.45,pangkalahatang teksto,,0,0,0,,Hingin sa iyong kamangha-manghang estudyante na tumulong
Dialogue: 0,0:09:49.53,0:09:53.25,general text,,0,0,0,,Nagluto siya ng pagkain, kaya lilinisin ko lahat
Dialogue: 0,0:09:54.62,0:09:56.17,general text,,0,0,0,,Masaya bang turuan siya?
Dialogue: 0,0:09:56.83,0:09:58.04,general text,,0,0,0,,Gusto mo ba siya
Dialogue: 0,0:09:58.71,0:09:59.79,general text,,0,0,0,,studyante mo ba?
Dialogue: 0,0:09:59.88,0:10:01.88,general text,,0,0,0,,Mas madali kung ganito
Dialogue: 0,0:10:02.46,0:10:04.55,general text,,0,0,0,,Siya ay masipag, masunurin
Dialogue: 0,0:10:05.34,0:10:07.51,pangkalahatang teksto,,0,0,0,,Hindi tamad at walang ingat tulad mo
Dialogue: 0,0:10:07.59,0:10:10.10,pangkalahatang teksto,,0,0,0,,Guro, huwag mo akong dayain
Dialogue: 0,0:10:11.68,0:10:12.52,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:10:12.60,0:10:14.89,general text,,0,0,0,,Naiintindihan ko na gusto mo ang kanyang sipag at tiyaga
Dialogue: 0,0:10:14.98,0:10:17.31,general text,,0,0,0,,Ngunit ako lang ang iyong estudyante
Dialogue: 0,0:10:17.40,0:10:20.86,pangkalahatang teksto,,0,0,0,,Ang isang guro ay hindi dapat magkaroon ng maraming estudyante at vice versa
Dialogue: 0,0:10:20.94,0:10:24.15,general text,,0,0,0,,Galit dahil tinuruan kong magluto si Yulia?
Dialogue: 0,0:10:24.24,0:10:26.15,pangkalahatang teksto,,0,0,0,,Oo. Eksakto. Paano ka magtuturo sa iba
Dialogue: 0,0:10:26.24,0:10:28.28,general text,,0,0,0,,nung nasa harap mo ang estudyante mo?
Dialogue: 0,0:10:28.87,0:10:31.03,italics,,0,0,0,,Gusto mo bang turuan ang isang tao kung paano magluto? Hayaan mo na ako
Dialogue: 0,0:10:31.12,0:10:32.74,pangkalahatang teksto,,0,0,0,,Ang pagtuturo sa iba ay pagtataksil at pagtataksil
Dialogue: 0,0:10:33.87,0:10:36.54,pangkalahatang teksto,,0,0,0,,Naiintindihan ko ang bahagi tungkol sa pagtataksil
Dialogue: 0,0:10:36.62,0:10:37.83,general text,,0,0,0,,Pero pagtataksil?
Dialogue: 0,0:10:37.92,0:10:39.38,pangkalahatang teksto,,0,0,0,,Walang salita
Dialogue: 0,0:10:42.42,0:10:43.55,pangkalahatang teksto,,0,0,0,,Sigurado ako,
Dialogue: 0,0:10:44.51,0:10:46.47,pangkalahatang teksto,,0,0,0,,na naramdaman kong pinagtaksilan
Dialogue: 0,0:10:53.81,0:10:55.02,general text,,0,0,0,,Ano pa ito?
Dialogue: 0,0:10:56.06,0:10:56.98,general text,,0,0,0,,Well, ano pa?
Dialogue: 0,0:10:57.06,0:10:58.81,general text,,0,0,0,,Moo Dok, huwag mo akong dayain
Dialogue: 0,0:10:58.90,0:11:00.31,general text,,0,0,0,,Masakit at nagagalit ito sa akin
Dialogue: 0,0:11:00.40,0:11:03.19,general text,,0,0,0,,Hindi ko alam na sobrang obsessed na pala ang estudyante ko.
Dialogue: 0,0:11:03.90,0:11:05.78,general text,,0,0,0,,Okay, ikaw lang
Dialogue: 0,0:11:05.86,0:11:08.95,pangkalahatang text,,0,0,0,,isang estudyanteng walang kwenta sa umaga. Nasiyahan ka ba?
Dialogue: 0,0:11:09.03,0:11:10.66,general text,,0,0,0,,- Pero...\N{\i1}- Mu Dok!
Dialogue: 0,0:11:11.70,0:11:12.66,italics,,0,0,0,,Moo Dok!
Dialogue: 0,0:11:14.29,0:11:15.16,pangkalahatang teksto,,0,0,0,,Host,
Dialogue: 0,0:11:15.91,0:11:19.58,pangkalahatang teksto,,0,0,0,,pagtataksil kung tatawagin kong master ang iba
Dialogue: 0,0:11:20.21,0:11:21.54,general text,,0,0,0,,at sagutin ang tawag nila?
Dialogue: 0,0:11:21.63,0:11:23.38,general text,,0,0,0,,Walang magagawa dito, syempre
Dialogue: 0,0:11:23.46,0:11:25.96,general text,,0,0,0,,Pero kapag tinawagan mo sila,
Dialogue: 0,0:11:26.05,0:11:28.47,general text,,0,0,0,,tawagan mo akong masters
Dialogue: 0,0:11:30.26,0:11:31.59,pangkalahatang teksto,,0,0,0,,Tawanan at wala nang iba pa
Dialogue: 0,0:11:33.97,0:11:37.60,general text,,0,0,0,,Master Pak, sasama na ako!
Dialogue: 0,0:11:37.68,0:11:40.73,general text,,0,0,0,,Moo Dok, nasaktan mo ang damdamin ko. Sabi ko tawagin mo akong master!
Dialogue: 0,0:11:49.40,0:11:51.16,pangkalahatang teksto,,0,0,0,,Napakataas
Dialogue: 0,0:11:53.16,0:11:55.62,general text,,0,0,0,,Yul, gusto mo bang makita itong puno?
Dialogue: 0,0:11:56.95,0:11:58.20,pangkalahatang teksto,,0,0,0,,Uri ng
Dialogue: 0,0:11:59.62,0:12:01.67,pangkalahatang teksto,,0,0,0,,Hindi ako makapaniwalang umiiral ito
Dialogue: 0,0:12:09.76,0:12:12.76,memories,,0,0,0,,Paano mo nalaman na nasaktan ako?
Dialogue: 0,0:12:13.47,0:12:16.26,mga alaala,,0,0,0,,May isang mataas na puno sa malapit,
Dialogue: 0,0:12:18.02,0:12:21.39,mga alaala,,0,0,0,,lahat ng Danhyangok ay makikita mula sa itaas
Dialogue: 0,0:12:26.86,0:12:29.78,pangkalahatang teksto,,0,0,0,,Ang kabuuan ng Danhyangok ay makikita mula sa itaas
Dialogue: 0,0:12:33.32,0:12:35.24,general text,,0,0,0,,Kaya umakyat ka
Dialogue: 0,0:12:36.41,0:12:37.66,pangkalahatang teksto,,0,0,0,,sa pinakatuktok?
Dialogue: 0,0:12:41.66,0:12:44.63,pangkalahatang teksto,,0,0,0,,Akala ko, dahil mataas ito
Dialogue: 0,0:12:46.50,0:12:48.67,general text,,0,0,0,,Gusto mo bang umakyat?
Dialogue: 0,0:12:48.76,0:12:50.42,general text,,0,0,0,,Tulungan kang umakyat?
Dialogue: 0,0:12:51.09,0:12:53.72,pangkalahatang teksto,,0,0,0,,Dan Gu, hindi mo ito maakyat
Dialogue: 0,0:12:53.80,0:12:57.14,pangkalahatang text,,0,0,0,,Kailangan mo man lang master si Chisa para makaakyat doon
Dialogue: 0,0:12:58.39,0:12:59.39,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:13:00.02,0:13:01.52,general text,,0,0,0,,Siguro dapat kong subukan?
Dialogue: 0,0:13:02.10,0:13:03.10,italics,,0,0,0,,Eksakto
Dialogue: 0,0:13:03.19,0:13:05.10,general text,,0,0,0,,Siguro kaya mo
Dialogue: 0,0:13:05.69,0:13:06.98,general text,,0,0,0,,Moo Dok, samahan na natin siya
Dialogue: 0,0:13:10.69,0:13:11.78,general text,,0,0,0,,Gusto mo bang umakyat?
Dialogue: 0,0:13:17.08,0:13:18.37,general text,,0,0,0,,Ayoko
Dialogue: 0,0:13:18.45,0:13:21.58,pangkalahatang text,,0,0,0,,Ayokong umakyat sa puno na ito kasama ng kahit sino
Dialogue: 0,0:13:26.50,0:13:27.34,pangkalahatang teksto,,0,0,0,, "Sa kahit sino lang"?
Dialogue: 0,0:13:30.51,0:13:33.72,general text,,0,0,0,,I think she's too afraid
Dialogue: 0,0:13:33.80,0:13:35.13,pangkalahatang text,,0,0,0,,Tara na
Dialogue: 0,0:13:46.52,0:13:48.52,general text,,0,0,0,,Aral ko ang core ng kanyang energy
Dialogue: 0,0:13:49.77,0:13:52.57,pangkalahatang teksto,,0,0,0,,Siya ay isang karaniwang tao, hindi isang salamangkero
Dialogue: 0,0:13:53.57,0:13:56.74,general text,,0,0,0,,I'm sure marami pang biktima
Dialogue: 0,0:13:56.82,0:14:00.20,pangkalahatang teksto,,0,0,0,,May nomad sa atin
Dialogue: 0,0:14:00.79,0:14:02.70,pangkalahatang teksto,,0,0,0,,Ano ang gagawin, Master Li?
Dialogue: 0,0:14:02.79,0:14:05.62,pangkalahatang teksto,,0,0,0,,Mas mahirap kilalanin ang pinagmulan ng mahikang ito,
Dialogue: 0,0:14:05.71,0:14:07.21,pangkalahatang teksto,,0,0,0,,paano mahuli ang isang nomad
Dialogue: 0,0:14:08.04,0:14:09.59,pangkalahatang text,,0,0,0,,Sinala ko si Jeonbugwan
Dialogue: 0,0:14:11.42,0:14:14.42,pangkalahatang teksto,,0,0,0,,Itong nomad na sumalakay kay Sosnovy Bor,
Dialogue: 0,0:14:15.34,0:14:17.30,general text,,0,0,0,,may mga astrologo doon
Dialogue: 0,0:14:18.26,0:14:21.06,pangkalahatang teksto,,0,0,0,,Sa karagdagan, ito ay Jin Mu
Dialogue: 0,0:14:21.14,0:14:23.02,pangkalahatang teksto,,0,0,0,, winasak si Nak Su sa panahon ng paglipat ng kaluluwa,
Dialogue: 0,0:14:23.81,0:14:25.73,pangkalahatang teksto,,0,0,0,,at pagkatapos ay lahat ng kanyang mga tao
Dialogue: 0,0:14:27.19,0:14:28.90,pangkalahatang teksto,,0,0,0,,Nak Su...
Dialogue: 0,0:14:35.86,0:14:38.62,general text,,0,0,0,,Nalaman namin kung sino siya
Dialogue: 0,0:14:38.70,0:14:39.82,pangkalahatang teksto,,0,0,0,,At sino?
Dialogue: 0,0:14:39.91,0:14:42.29,pangkalahatang teksto,,0,0,0,,Isa sa mga katulong ni Jeonbugwan
Dialogue: 0,0:14:42.37,0:14:45.83,pangkalahatang teksto,,0,0,0,,Ano? Kasama na naman si Jeonbugwan
Dialogue: 0,0:14:45.91,0:14:48.58,general text,,0,0,0,,Pupuntahan ko agad si Jin Mu!
Dialogue: 0,0:14:48.67,0:14:50.25,general text,,0,0,0,,Lahat ay nasa likod ko
Dialogue: 0,0:14:50.34,0:14:51.54,pangkalahatang teksto,,0,0,0,,Yom
Dialogue: 0,0:14:52.21,0:14:53.17,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:14:53.84,0:14:54.96,pangkalahatang teksto,,0,0,0,,Huwag gawin
Dialogue: 0,0:14:56.84,0:14:59.97,general text,,0,0,0,,Na minsan, ang iyong kawalang-ingat ay nasira ng husto
Dialogue: 0,0:15:00.05,0:15:02.14,general text,,0,0,0,,Ngayon lumaki ka na, pero ang ugali mo ay ganoon pa rin
Dialogue: 0,0:15:03.06,0:15:04.72,pangkalahatang teksto,,0,0,0,,Paumanhin, guro
Dialogue: 0,0:15:05.31,0:15:06.43,pangkalahatang teksto,,0,0,0,,Hindi pa oras
Dialogue: 0,0:15:06.52,0:15:10.48,pangkalahatang teksto,,0,0,0,,Kailangan nating bantayang mabuti si Jeonbugwan
Dialogue: 0,0:15:10.56,0:15:11.86,pangkalahatang teksto,,0,0,0,,Jin
Dialogue: 0,0:15:12.86,0:15:14.40,pangkalahatang teksto,,0,0,0,,Lumaki kang matalino
Dialogue: 0,0:15:15.69,0:15:17.82,pangkalahatang teksto,,0,0,0,,Tumatakbo ka sa iyong salawal
Dialogue: 0,0:15:17.90,0:15:21.16,general text,,0,0,0,,Hindi ako makapaniwala na lumaki ka ng ganyan at namumuno sa mga tao
Dialogue: 0,0:15:25.95,0:15:27.04,pangkalahatang teksto,,0,0,0,,Guro
Dialogue: 0,0:15:33.29,0:15:34.92,pangkalahatang teksto,,0,0,0,,Sino siya?
Dialogue: 0,0:15:36.38,0:15:37.59,general text,,0,0,0,,Siya ay isang estudyante
Dialogue: 0,0:15:38.13,0:15:41.55,pangkalahatang teksto,,0,0,0,,Master So Kyung, tagapagtatag ng Sosnovy Bor
Dialogue: 0,0:15:42.60,0:15:44.06,general text,,0,0,0,,Pero napakabata niya
Dialogue: 0,0:15:45.18,0:15:46.52,pangkalahatang teksto,,0,0,0,,Hindi naman
Dialogue: 0,0:15:47.39,0:15:49.10,general text,,0,0,0,,Naaalala ko pa ang pagkanta
Dialogue: 0,0:15:51.35,0:15:53.19,pangkalahatang teksto,,0,0,0,,sa pagdiriwang ng kanyang sentenaryo
Dialogue: 0,0:15:56.86,0:15:58.32,general text,,0,0,0,,Nagsayaw pa ako
Dialogue: 0,0:16:02.07,0:16:04.95,general text,,0,0,0,,Itong aso... si Gwigu ba?
Dialogue: 0,0:16:07.16,0:16:11.62,general text,,0,0,0,,Kaya kinuha mo si Gwiga kay Jinyeowon
Dialogue: 0,0:16:12.63,0:16:14.96,pangkalahatang teksto,,0,0,0,,Makahanap siya ng nomad
Dialogue: 0,0:16:15.75,0:16:18.21,general text,,0,0,0,,Namatay si Nak Su noong soul transfer diba?
Dialogue: 0,0:16:18.30,0:16:19.13,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:16:19.22,0:16:22.68,pangkalahatang teksto,,0,0,0,,Siya ay isang sikat na mersenaryo at isang mahuhusay na salamangkero
Dialogue: 0,0:16:25.05,0:16:27.60,general text,,0,0,0,,Diba kaluluwa niya ang naramdaman ko?
Dialogue: 0,0:16:39.99,0:16:42.45,pangkalahatang teksto,,0,0,0,,Ang Espada ni Chang Gan ngayon
Dialogue: 0,0:16:42.53,0:16:44.70,general text,,0,0,0,,- anak niya diba?\N- Oo
Dialogue: 0,0:16:44.78,0:16:48.62,general text,,0,0,0,,Nakilala mo na ba siya?
Dialogue: 0,0:16:48.70,0:16:50.58,general text,,0,0,0,,Nakita ko ang isang binata na may hawak na bracelet
Dialogue: 0,0:16:50.66,0:16:53.83,general text,,0,0,0,,at ang katulong na sumunod sa kanya
Dialogue: 0,0:16:55.59,0:16:56.88,pangkalahatang teksto,,0,0,0,,Kawili-wili
Dialogue: 0,0:17:03.97,0:17:06.51,pangkalahatang teksto,,0,0,0,,Nangolekta si Moo Dok ng ilang mga kastanyas
Dialogue: 0,0:17:06.60,0:17:09.22,general text,,0,0,0,,Ang sweet nila, oo. Bigyan mo rin si Kim ng maid
Dialogue: 0,0:17:09.31,0:17:10.18,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:17:19.19,0:17:20.74,general text,,0,0,0,,Bakit mo kinuha ang espada ng iyong ama?
Dialogue: 0,0:17:21.36,0:17:23.61,pangkalahatang teksto,,0,0,0,,Oh, ito? Kinuha ito ni Moo Deok
Dialogue: 0,0:17:23.70,0:17:26.78,general text,,0,0,0,,Hindi ka magsasanay, bakit mo dinala dito?
Dialogue: 0,0:17:27.53,0:17:28.91,general text,,0,0,0,,Dalhin mo sa maid Kim?
Dialogue: 0,0:17:30.83,0:17:31.70,mga alaala na italics,,0,0,0,,Ikaw...
Dialogue: 0,0:17:32.75,0:17:34.04,mga alaala,,0,0,0,,hindi anak
Dialogue: 0,0:17:35.33,0:17:36.54,mga alaala,,0,0,0,,Chan Gan
Dialogue: 0,0:17:40.05,0:17:41.17,pangkalahatang teksto,,0,0,0,,Sa gusto mo
Dialogue: 0,0:17:45.38,0:17:46.55,general text,,0,0,0,,- Tara na\N- Oo
Dialogue: 0,0:17:49.26,0:17:51.89,general text,,0,0,0,,Sabi mo madalas kang mangolekta ng mga halamang gamot dito
Dialogue: 0,0:17:53.23,0:17:57.10,general text,,0,0,0,,May nakita ka bang nakatira dito?
Dialogue: 0,0:17:57.19,0:18:00.19,pangkalahatang teksto,,0,0,0,,Hindi. Sino ang maninirahan dito?
Dialogue: 0,0:18:01.57,0:18:02.82,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:18:07.53,0:18:08.74,pangkalahatang teksto,,0,0,0,,At higit pa
Dialogue: 0,0:18:10.79,0:18:12.91,pangkalahatang teksto,,0,0,0,,Napakalamig ba sa taglamig?
Dialogue: 0,0:18:14.37,0:18:15.79,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:18:17.92,0:18:19.67,pangkalahatang teksto,,0,0,0,,Hindi pa ako nakapunta dito sa taglamig
Dialogue: 0,0:18:22.67,0:18:24.67,pangkalahatang teksto,,0,0,0,,Nag-aalala sa tuwing bumabagsak ang snow
Dialogue: 0,0:18:26.47,0:18:28.26,pangkalahatang teksto,,0,0,0,,Nag-aalala kung ito ay masyadong malamig
Dialogue: 0,0:18:29.85,0:18:32.10,general text,,0,0,0,,Okay lang ba
Dialogue: 0,0:18:42.40,0:18:44.11,pangkalahatang teksto,,0,0,0,,Lalong umiinit dito,
Dialogue: 0,0:18:45.19,0:18:47.20,pangkalahatang teksto,,0,0,0,,kaysa sa tila
Dialogue: 0,0:18:50.28,0:18:53.29,pangkalahatang teksto,,0,0,0,,Mabilis na natutunaw ang snow sa maaraw na lugar
Dialogue: 0,0:18:56.21,0:18:58.17,pangkalahatang teksto,,0,0,0,,Oo? natutuwa ako
Dialogue: 0,0:19:04.30,0:19:06.72,pangkalahatang teksto,,0,0,0,,Oo, maraming pagkain dito kahit taglamig
Dialogue: 0,0:19:07.68,0:19:10.34,pangkalahatang teksto,,0,0,0,,May isang lugar upang magtago mula sa snow
Dialogue: 0,0:19:13.22,0:19:15.60,general text,,0,0,0,,- I'm sure masarap ito\N- Very
Dialogue: 0,0:19:18.56,0:19:19.98,general text,,0,0,0,,Dapat ba tayong manatili sa ibang araw?
Dialogue: 0,0:19:21.40,0:19:23.90,italics,,0,0,0,,Mukhang gusto talaga siya ni Moo Deok
Dialogue: 0,0:19:28.45,0:19:30.20,general text,,0,0,0,,Sinabi niya sa kanya
Dialogue: 0,0:19:31.32,0:19:32.66,pangkalahatang teksto,,0,0,0,,ayaw nito
Dialogue: 0,0:19:32.74,0:19:35.24,general text,,0,0,0,,sabi ko gusto mo!
Dialogue: 0,0:19:35.95,0:19:36.87,pangkalahatang teksto,,0,0,0,,Tingnan
Dialogue: 0,0:19:36.95,0:19:41.04,general text,,0,0,0,,Hindi niya kami tinitingnan sa paraan ng pagtingin niya sa kanya
Dialogue: 0,0:19:49.51,0:19:51.18,pangkalahatang teksto,,0,0,0,,Ihip ng hangin
Dialogue: 0,0:19:59.85,0:20:01.56,general text,,0,0,0,,Sa kanya ba galing?
Dialogue: 0,0:20:05.32,0:20:06.28,general text,,0,0,0,,Dan Gu, tara na
Dialogue: 0,0:20:06.90,0:20:07.99,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:20:12.28,0:20:14.03,italics,,0,0,0,,Bye, Moo Deok
Dialogue: 0,0:20:19.50,0:20:20.54,italics,,0,0,0,,Tara na
Dialogue: 0,0:20:27.92,0:20:29.47,general text,,0,0,0,,Ipapakita ko sila
Dialogue: 0,0:20:42.23,0:20:44.40,general text,,0,0,0,,- Have a nice trip\N- See you later
Dialogue: 0,0:20:45.31,0:20:47.53,pangkalahatang teksto,,0,0,0,,Subukang alalahanin kung saan nawala ang spirit amulet
Dialogue: 0,0:20:48.11,0:20:50.19,general text,,0,0,0,,- Okay\N- And keep your head down
Dialogue: 0,0:20:50.70,0:20:52.86,general text,,0,0,0,,Dahil sa inyo, pati ang Unified Council ay pinatawag
Dialogue: 0,0:20:52.95,0:20:55.87,pangkalahatang teksto,,0,0,0,,Sa tingin ko nandoon lahat ng 12 dati kong guro
Dialogue: 0,0:20:55.95,0:20:58.79,pangkalahatang teksto,,0,0,0,,Lahat sila ay walang puso sa iyo
Dialogue: 0,0:20:59.45,0:21:02.33,pangkalahatang teksto,,0,0,0,,Nag-alok pa sila na i-seal ang lahat ng iyong lakas
Dialogue: 0,0:21:03.08,0:21:05.33,general text,,0,0,0,,- Bakit nila sasabihin iyon?\N- Ano?
Dialogue: 0,0:21:07.84,0:21:09.59,general text,,0,0,0,,Dahil tumakas ka sa laban
Dialogue: 0,0:21:11.26,0:21:13.05,italics,,0,0,0,,Ngunit ito ay katangahan lamang
Dialogue: 0,0:21:13.13,0:21:14.97,general text,,0,0,0,,Hindi mo rin ginustong mangyari
Dialogue: 0,0:21:15.05,0:21:17.26,italics,,0,0,0,,Walang umaasa na lalabas ka
Dialogue: 0,0:21:17.35,0:21:21.02,general text,,0,0,0,,Kaya manatili ka lang dito at mamuhay ng tahimik
Dialogue: 0,0:21:23.39,0:21:25.10,italics,,0,0,0,,May gustong malaman ang ulo
Dialogue: 0,0:21:26.65,0:21:28.73,general text,,0,0,0,,Tinanong niya kung ginagawa mo ang sinabi sa iyo
Dialogue: 0,0:21:30.99,0:21:31.99,mga alaala na italics,,0,0,0,,Ikaw
Dialogue: 0,0:21:32.49,0:21:35.53,mga alaala,,0,0,0,,ang bunga ng pagtataksil ng iyong ina
Dialogue: 0,0:21:35.61,0:21:38.16,mga alaala,,0,0,0,,Ngunit hindi namin hahayaan na ikaw ang maging pinuno ng Jeonbugwan
Dialogue: 0,0:21:38.24,0:21:41.41,mga alaala,,0,0,0,,Kaya itigil ang pangangarap na sumunod sa yapak
Dialogue: 0,0:21:44.54,0:21:45.75,mga alaala,,0,0,0,,ng kanyang ama
Dialogue: 0,0:21:46.33,0:21:48.38,mga alaala,,0,0,0,,Manatiling isang walang alam na tagapagmana
Dialogue: 0,0:21:49.75,0:21:52.47,mga alaala,,0,0,0,,Chan family
Dialogue: 0,0:21:55.84,0:21:58.18,general text,,0,0,0,,Maaari ko ba siyang bigyan ng positibong sagot?
Dialogue: 0,0:21:58.26,0:22:00.18,general text,,0,0,0,,Naging masunurin ba ako?
Dialogue: 0,0:22:00.81,0:22:03.68,pangkalahatang teksto,,0,0,0,,Sabihin sa kanya na ginagawa ko ang eksaktong kabaligtaran, pagiging walang ingat
Dialogue: 0,0:22:06.94,0:22:08.11,pangkalahatang teksto,,0,0,0,,Dan Gu, iwanan ang espada dito
Dialogue: 0,0:22:09.11,0:22:10.02,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:22:10.90,0:22:13.19,pangkalahatang text,,0,0,0,,Gusto kong tulungan si Mu Deok na makahuli ng pheasant
Dialogue: 0,0:22:17.62,0:22:18.82,pangkalahatang teksto,,0,0,0,,Bye
Dialogue: 0,0:22:24.29,0:22:26.87,general text,,0,0,0,,Nasaktan ba natin ang pride niya?
Dialogue: 0,0:22:26.96,0:22:27.83,italics,,0,0,0,,Iwan mo siya
Dialogue: 0,0:22:27.92,0:22:30.42,pangkalahatang teksto,,0,0,0,,Hindi natin maaaring hilingin sa kanya na bumalik at mamatay na may dignidad doon
Dialogue: 0,0:22:38.39,0:22:40.72,general text,,0,0,0,,Bumalik ka ba dala ang espadang ibinigay mo?
Dialogue: 0,0:22:43.27,0:22:45.27,general text,,0,0,0,,Naging katatawanan ako at nakakasakit ng pride
Dialogue: 0,0:22:47.39,0:22:50.15,general text,,0,0,0,,Kung ganoon, magsanay tayo na parang dito nakasalalay ang ating buhay
Dialogue: 0,0:22:51.48,0:22:52.61,general text,,0,0,0,,Mukhang kinikilig ka sa,
Dialogue: 0,0:22:54.32,0:22:56.11,pangkalahatang teksto,,0,0,0,,na naging katatawanan ang iyong estudyante
Dialogue: 0,0:22:56.90,0:22:59.32,pangkalahatang teksto,,0,0,0,,Bukod dito, idadagdag ko
Dialogue: 0,0:23:00.57,0:23:03.87,pangkalahatang text,,0,0,0,,Hindi ka hiniling ng iyong mga kaibigan na umuwi kasama nila
Dialogue: 0,0:23:03.95,0:23:06.71,general text,,0,0,0,,Kung sila sayo, lalaban sila hanggang kamatayan
Dialogue: 0,0:23:06.79,0:23:09.71,general text,,0,0,0,,At sinabihan kang tumakbo at magtago
Dialogue: 0,0:23:10.79,0:23:11.92,general text,,0,0,0,,Alam mo ba kung bakit?
Dialogue: 0,0:23:14.38,0:23:16.97,general text,,0,0,0,,Dahil wala kang silbi
Dialogue: 0,0:23:18.88,0:23:20.85,pangkalahatang teksto,,0,0,0,,Ang iyong dila ay matalas kaysa sa espada
Dialogue: 0,0:23:21.72,0:23:24.72,general text,,0,0,0,,Kaya masakit ang mga salita. Walang awa
Dialogue: 0,0:23:24.81,0:23:27.06,general text,,0,0,0,,Hindi ako magdadalawang isip na saksakin ka ng espada,
Dialogue: 0,0:23:27.14,0:23:29.14,pangkalahatang teksto,,0,0,0,,kung iyon ang magpapabalik sa iyo sa landas
Dialogue: 0,0:23:29.23,0:23:30.27,pangkalahatang teksto,,0,0,0,,Oo, master
Dialogue: 0,0:23:30.35,0:23:32.61,pangkalahatang teksto,,0,0,0,,Bugbugin hanggang mamatay ang walang kwentang estudyante mo
Dialogue: 0,0:23:35.32,0:23:37.36,pangkalahatang teksto,,0,0,0,,Bakit hindi ka natuwa pagkatapos ng aking mga salita?
Dialogue: 0,0:23:37.44,0:23:38.74,general text,,0,0,0,,Bakit sira?
Dialogue: 0,0:23:41.24,0:23:43.45,pangkalahatang teksto,,0,0,0,,Ang iyong mga masasamang salita ay nagpagalit sa akin sa huli
Dialogue: 0,0:23:44.20,0:23:45.66,general text,,0,0,0,,kailangan kong maligo at magpahinga
Dialogue: 0,0:23:47.45,0:23:49.42,general text,,0,0,0,,Bakit siya madalas maligo?
Dialogue: 0,0:23:49.50,0:23:51.00,pangkalahatang teksto,,0,0,0,,Walang kwenta at tamad na tulala
Dialogue: 0,0:23:51.08,0:23:52.42,general text,,0,0,0,,sana magpakulo ka sa kumukulong tubig!
Dialogue: 0,0:23:53.79,0:23:57.26,pangkalahatang teksto,,0,0,0,,Hindi kapani-paniwala! Anong klaseng guro ang nagsasabi niyan sa kanyang estudyante?
Dialogue: 0,0:24:02.47,0:24:06.64,general text,,0,0,0,,Hindi maalala ni Uk kung paano nawala ang kanyang spirit amulet?
Dialogue: 0,0:24:07.60,0:24:09.73,pangkalahatang text,,0,0,0,,Baka may nagbenta pagkatapos itong ihulog ng Uk
Dialogue: 0,0:24:09.81,0:24:12.06,general text,,0,0,0,,Kaya nakarating sa kanila ang anting-anting
Dialogue: 0,0:24:12.15,0:24:14.11,general text,,0,0,0,,Balita ko may lugar kung saan nagbebenta sila ng mga ganyang anting-anting
Dialogue: 0,0:24:15.32,0:24:18.11,pangkalahatang teksto,,0,0,0,,Kung ganoon, subukang alamin ang lahat
Dialogue: 0,0:24:19.28,0:24:20.57,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:24:20.65,0:24:21.91,pangkalahatang teksto,,0,0,0,,Paano...
Dialogue: 0,0:24:24.03,0:24:26.33,general text,,0,0,0,,ginagawa ba ni Uka?
Dialogue: 0,0:24:28.95,0:24:31.50,general text,,0,0,0,,Lahat ay maayos sa kanya, siya ay pinakain at malusog
Dialogue: 0,0:24:32.58,0:24:34.71,general text,,0,0,0,,Hindi pa rin niya natatanggal ang bracelet
Dialogue: 0,0:24:37.05,0:24:38.13,pangkalahatang text,,0,0,0,,Maaari kang pumunta
Dialogue: 0,0:24:59.40,0:25:00.86,general text,,0,0,0,,Hindi na masyadong mabigat
Dialogue: 0,0:25:00.95,0:25:02.49,pangkalahatang teksto,,0,0,0,,At hindi ito nakakasagabal sa paglalakad
Dialogue: 0,0:25:02.57,0:25:05.16,pangkalahatang teksto,,0,0,0,,Nagsasanay ang ilang salamangkero gamit ang mga pabigat na bakal,
Dialogue: 0,0:25:05.24,0:25:07.28,pangkalahatang teksto,,0,0,0,,upang palakasin ang iyong mga kamay at mas mahusay na gumamit ng espada
Dialogue: 0,0:25:07.79,0:25:10.96,italics,,0,0,0,,You unknowingly naging stronger,
Dialogue: 0,0:25:11.04,0:25:13.25,pangkalahatang teksto,,0,0,0,,habang suot ang mabigat na pulseras na ito buong araw
Dialogue: 0,0:25:13.33,0:25:14.75,pangkalahatang teksto,,0,0,0,,Hindi sinasadya,
Dialogue: 0,0:25:14.83,0:25:17.13,pangkalahatang teksto,,0,0,0,,ngunit nakakita ka ng isang mahusay na tool sa pagsasanay para sa iyong sarili
Dialogue: 0,0:25:18.42,0:25:19.96,pangkalahatang teksto,,0,0,0,,Napakaswerte mo
Dialogue: 0,0:25:20.05,0:25:23.43,pangkalahatang teksto,,0,0,0,,Kung tatanggalin ko ito, ako ay magiging mas mabilis at mas malakas
Dialogue: 0,0:25:24.01,0:25:27.47,general text,,0,0,0,,Ngunit kung hindi mo matutunang pigilan ang iyong sarili, lalo kang magiging kaawa-awa
Dialogue: 0,0:25:29.22,0:25:30.27,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,0:25:30.93,0:25:31.93,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:25:35.85,0:25:38.94,general text,,0,0,0,,Ano ang pinag-usapan niyo ni Yul?
Dialogue: 0,0:25:41.36,0:25:42.86,pangkalahatang teksto,,0,0,0,,Tungkol kay Danhyangok
Dialogue: 0,0:25:44.86,0:25:47.87,general text,,0,0,0,,Tinanong niya kung kumusta dito sa taglamig
Dialogue: 0,0:25:52.04,0:25:53.91,italics,,0,0,0,,Nakilala mo si Naxu,
Dialogue: 0,0:25:54.67,0:25:56.33,general text,,0,0,0,,nung bata ka pa?
Dialogue: 0,0:25:58.29,0:26:01.34,general text,,0,0,0,,Hindi ako sigurado noong nakita ko ang katawan niya
Dialogue: 0,0:26:01.42,0:26:03.97,pangkalahatang text,,0,0,0,,Ngunit ang isang paglalakbay sa Danhyangk ay nakatulong sa akin na kumpirmahin ito
Dialogue: 0,0:26:04.05,0:26:05.13,general text,,0,0,0,,Kaya ngayon ko lang ito sinasabi
Dialogue: 0,0:26:06.22,0:26:10.01,pangkalahatang teksto,,0,0,0,,Danhyangok - isang malalim at mapanganib na lambak
Dialogue: 0,0:26:10.10,0:26:12.77,pangkalahatang teksto,,0,0,0,,Hindi makakaligtas doon ang batang babae nang walang tulong ng isang tao
Dialogue: 0,0:26:12.85,0:26:15.56,general text,,0,0,0,,Doon siya nakatira, parang nagtatago sa isang tao
Dialogue: 0,0:26:16.98,0:26:19.36,italics,,0,0,0,,Nang malaman niya kung sino ako at saang pamilya ako galing,
Dialogue: 0,0:26:20.11,0:26:22.03,italics,,0,0,0,,Hindi ko na siya nakita
Dialogue: 0,0:26:23.24,0:26:25.70,italics,,0,0,0,,Kaya nalaman ko ang pangalan mo...
Dialogue: 0,0:26:26.49,0:26:29.58,pangkalahatang teksto,,0,0,0,,Sabihin ang lahat ng nalalaman mo tungkol sa kanya
Dialogue: 0,0:26:32.37,0:26:33.75,general text,,0,0,0,,Wala akong alam
Dialogue: 0,0:26:34.37,0:26:36.12,pangkalahatang teksto,,0,0,0,,Walang pangalan, walang edad
Dialogue: 0,0:26:36.79,0:26:38.67,general text,,0,0,0,,Maliban sa bangin kung saan namin pinagmamasdan ang mga ibon...
Dialogue: 0,0:26:38.75,0:26:40.42,general text,,0,0,0,,Hindi ko nakita kung saan siya nakatira
Dialogue: 0,0:26:44.55,0:26:45.51,pangkalahatang teksto,,0,0,0,,Isa lamang
Dialogue: 0,0:26:48.43,0:26:50.35,general text,,0,0,0,,Minsan nabanggit niya ang kanyang ama
Dialogue: 0,0:27:01.40,0:27:05.15,mga alaala,,0,0,0,,Inilarawan ng aking ama ang mga bituin
Dialogue: 0,0:27:07.07,0:27:09.49,italics,,0,0,0,,Tapos hindi ko ito pinansin
Dialogue: 0,0:27:09.57,0:27:12.20,general text,,0,0,0,,Ngunit ito ang ginagawa ng mga stargazer
Dialogue: 0,0:27:12.28,0:27:13.87,pangkalahatang teksto,,0,0,0,,mula kay Jeonbugwan
Dialogue: 0,0:27:15.25,0:27:16.37,italics,,0,0,0,,Guro,
Dialogue: 0,0:27:16.87,0:27:18.92,pangkalahatang teksto,,0,0,0,,sa mga stargazer magicians
Dialogue: 0,0:27:20.00,0:27:21.92,general text,,0,0,0,,may nagalit ba sa iyo?
Dialogue: 0,0:27:24.92,0:27:26.22,pangkalahatang teksto,,0,0,0,,Stargazer
Dialogue: 0,0:27:27.55,0:27:28.88,pangkalahatang text,,0,0,0,,mula kay Jeonbugwan?
Dialogue: 0,0:27:30.89,0:27:31.97,pangkalahatang teksto,,0,0,0,,Mage?
Dialogue: 0,0:27:36.81,0:27:40.48,italics,,0,0,0,,Dalawampung taon na ang nakalipas may isang astrologo na namatay...
Dialogue: 0,0:27:41.11,0:27:43.82,italics,,0,0,0,,sa kamay ng apat na pamilya
Dialogue: 0,0:27:45.69,0:27:48.99,general text,,0,0,0,,Napatay ang buong pamilya niya noong araw na iyon
Dialogue: 0,0:27:49.66,0:27:51.07,pangkalahatang teksto,,0,0,0,,Maliban sa isang tao
Dialogue: 0,0:27:51.16,0:27:53.95,pangkalahatang teksto,,0,0,0,,Hindi natagpuan ang kanyang anak noong gabing iyon
Dialogue: 0,0:28:20.35,0:28:22.23,italics,,0,0,0,,Nagkasala pala ang pamilya namin
Dialogue: 0,0:28:23.19,0:28:25.11,pangkalahatang teksto,,0,0,0,,sa pagkamatay ng kanyang ama
Dialogue: 0,0:28:25.69,0:28:27.40,pangkalahatang teksto,,0,0,0,,Tiyak na may sama ng loob siya sa iyo,
Dialogue: 0,0:28:27.48,0:28:29.82,pangkalahatang teksto,,0,0,0,,mula nang nakibahagi ang iyong pamilya dito
Dialogue: 0,0:28:29.90,0:28:32.82,general text,,0,0,0,,May naaalala ka pa ba?
Dialogue: 0,0:28:33.41,0:28:35.08,pangkalahatang teksto,,0,0,0,,Matagal na ang nakalipas
Dialogue: 0,0:28:36.12,0:28:37.83,pangkalahatang teksto,,0,0,0,,Malamang na wala na akong maalala
Dialogue: 0,0:29:00.81,0:29:02.52,memories italics,,0,0,0,,Dahil gusto ko silang makita
Dialogue: 0,0:29:03.81,0:29:06.02,mga alaala na italics,,0,0,0,,Hindi ako naabala ng bali ng binti
Dialogue: 0,0:29:06.11,0:29:07.90,memories italics,,0,0,0,,At hindi ako natakot na pagalitan nila ako
Dialogue: 0,0:29:12.32,0:29:14.16,mga alaala,,0,0,0,,mahal na mahal ko sila
Dialogue: 0,0:29:23.37,0:29:27.50,memories italics,,0,0,0,,Nakita kong ginamit mo ito para tawagan ang iyong ibon
Dialogue: 0,0:29:29.42,0:29:30.67,mga alaala,,0,0,0,,gusto ko rin subukan
Dialogue: 0,0:29:31.67,0:29:33.59,memories,,0,0,0,,Pwede ko ba?
Dialogue: 0,0:30:29.48,0:30:31.11,behind the scenes,,0,0,0,,Malakas ang Crown Prince
Dialogue: 0,0:30:31.73,0:30:36.15,voiceover,,0,0,0,,Iisa lang ang paraan para matalo siya ni Uka at manatiling buhay
Dialogue: 0,0:30:37.07,0:30:38.45,pangkalahatang teksto,,0,0,0,,Tansu
Dialogue: 0,0:31:12.48,0:31:14.23,general text,,0,0,0,,Ano ang gusto mo sa akin?
Dialogue: 0,0:31:15.94,0:31:17.86,pangkalahatang teksto,,0,0,0,,Putulin ang mga patak ng tubig habang nahuhulog ang mga ito
Dialogue: 0,0:31:19.28,0:31:20.57,pangkalahatang teksto,,0,0,0,,Hindi patak ng ulan
Dialogue: 0,0:31:20.66,0:31:23.04,pangkalahatang teksto,,0,0,0,,Kahit isang malas na gaya mo
Dialogue: 0,0:31:23.12,0:31:25.58,pangkalahatang teksto,,0,0,0,,magagawang putulin ang mga patak na tumutulo nang napakabagal
Dialogue: 0,0:31:26.25,0:31:27.12,pangkalahatang teksto,,0,0,0,,Ipasa
Dialogue: 0,0:31:48.44,0:31:50.31,pangkalahatang teksto,,0,0,0,,Tatlong patak lang sa isang upuan
Dialogue: 0,0:31:51.19,0:31:52.36,italics,,0,0,0,,Hindi mahalaga
Dialogue: 0,0:31:52.44,0:31:55.98,pangkalahatang teksto,,0,0,0,,Ang sayaw na matututunan mo ay nangangailangan na mag-cut ka ng isa lang
Dialogue: 0,0:31:56.07,0:31:57.19,pangkalahatang teksto,,0,0,0,,Tansu?
Dialogue: 0,0:31:58.74,0:31:59.91,pangkalahatang teksto,,0,0,0,,Guro...
Dialogue: 0,0:32:00.41,0:32:03.91,pangkalahatang teksto,,0,0,0,,Naiintindihan ko, medyo mabilis akong matuto,
Dialogue: 0,0:32:03.99,0:32:05.33,general text,,0,0,0,,pero Tansu... hindi masyado?
Dialogue: 0,0:32:05.41,0:32:08.00,general text,,0,0,0,,Mukhang may itinuro sa iyo ang iyong mga guro
Dialogue: 0,0:32:08.08,0:32:09.08,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:32:09.16,0:32:11.96,pangkalahatang teksto,,0,0,0,,Maaari mo lamang matutunan ang Tansu pagkatapos ma-master ang Chisu
Dialogue: 0,0:32:12.63,0:32:14.59,pangkalahatang teksto,,0,0,0,,Halos kabisado mo si Ryusu
Dialogue: 0,0:32:14.67,0:32:17.30,general text,,0,0,0,,Hindi mo pa rin kontrolado ang iyong enerhiya
Dialogue: 0,0:32:17.38,0:32:19.22,pangkalahatang teksto,,0,0,0,,Hindi ito matututuhan ng isang estudyante sa iyong antas
Dialogue: 0,0:32:20.55,0:32:21.68,pangkalahatang teksto,,0,0,0,,Pero?
Dialogue: 0,0:32:22.30,0:32:23.64,pangkalahatang teksto,,0,0,0,,Ngunit sa ganitong paraan lamang
Dialogue: 0,0:32:25.31,0:32:29.60,general text,,0,0,0,,matatalo mo ang crown prince at mananatiling buhay
Dialogue: 0,0:33:04.09,0:33:07.18,behind the scenes,,0,0,0,,Tansu ay ang paggalaw ng enerhiya gamit ang isang espada
Dialogue: 0,0:33:07.26,0:33:09.06,voiceover,,0,0,0,,Mahina ang kanang kamay mo,
Dialogue: 0,0:33:09.77,0:33:12.35,behind the scenes,,0,0,0,,pero pinalakas salamat sa bracelet
Dialogue: 0,0:33:13.48,0:33:14.35,behind the scenes,,0,0,0,,Isang patak lang
Dialogue: 0,0:33:15.44,0:33:18.44,behind the scenes,,0,0,0,,Pindutin ang isang patak para makakolekta ka at makapagdirekta ng enerhiya
Dialogue: 0,0:33:30.79,0:33:32.54,pangkalahatang teksto,,0,0,0,,Hindi mo ma-master ng ganoon kabilis ang Tansu
Dialogue: 0,0:33:33.21,0:33:34.67,general text,,0,0,0,,Kumain na tayo at magpatuloy
Dialogue: 0,0:34:22.84,0:34:24.01,pangkalahatang teksto,,0,0,0,,Tansu?
Dialogue: 0,0:34:24.80,0:34:26.59,pangkalahatang teksto,,0,0,0,,Oo, hinding-hindi niya ito ma-master
Dialogue: 0,0:34:29.30,0:34:32.14,italics,,0,0,0,,Hindi ito isang katulong at ang kanyang amo
Dialogue: 0,0:34:32.85,0:34:34.89,pangkalahatang teksto,,0,0,0,,Magmadali guro at estudyante
Dialogue: 0,0:36:14.16,0:36:15.33,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:36:17.41,0:36:19.58,italics,,0,0,0,,Kaya sinasanay mo siya
Dialogue: 0,0:36:22.63,0:36:24.50,general text,,0,0,0,,Nakita ko siyang nagsasanay ng Tansu
Dialogue: 0,0:36:25.38,0:36:26.59,pangkalahatang teksto,,0,0,0,,Saan mo ito natutunan?
Dialogue: 0,0:36:27.17,0:36:31.18,general text,,0,0,0,,Matalino ang may-ari, nagkaroon siya ng 12 guro
Dialogue: 0,0:36:31.26,0:36:33.30,general text,,0,0,0,,Sinusubukan niyang tumakbo nang hindi talaga natutong maglakad
Dialogue: 0,0:36:33.39,0:36:35.51,pangkalahatang teksto,,0,0,0,,Malayo pa ang kanyang mararating
Dialogue: 0,0:36:35.60,0:36:37.85,pangkalahatang teksto,,0,0,0,,Ito ay hindi bababa sa sulit na subukan
Dialogue: 0,0:36:38.43,0:36:41.14,pangkalahatang teksto,,0,0,0,,Ang kanyang susunod na hakbang ay maaaring humantong sa kanyang kamatayan
Dialogue: 0,0:36:45.15,0:36:47.36,pangkalahatang teksto,,0,0,0,,Alam ba ito ng iyong amo?
Dialogue: 0,0:37:22.73,0:37:24.73,general text,,0,0,0,,Bakit hindi ka umiwas?
Dialogue: 0,0:37:24.81,0:37:25.90,pangkalahatang teksto,,0,0,0,,Seryoso
Dialogue: 0,0:37:41.75,0:37:44.00,pangkalahatang teksto,,0,0,0,,Ito ang resulta ng pagpapakawala mo ng enerhiya palabas
Dialogue: 0,0:37:45.17,0:37:47.21,pangkalahatang text,,0,0,0,,Baka pumutok ang braso mo kung magpapatuloy ka
Dialogue: 0,0:37:53.38,0:37:56.72,general text,,0,0,0,,Magsisimula na siyang mabulok. Pagkatapos ay kailangan mong putulin ito
Dialogue: 0,0:37:57.39,0:37:58.51,pangkalahatang teksto,,0,0,0,,Talaga?
Dialogue: 0,0:38:02.68,0:38:05.77,pangkalahatang teksto,,0,0,0,,Kung kumalat ang bulok na enerhiya sa iyong katawan,
Dialogue: 0,0:38:06.40,0:38:07.65,general text,,0,0,0,,mamamatay ka
Dialogue: 0,0:38:27.38,0:38:29.63,general text,,0,0,0,,Hinaba na ang init. okay ka lang ba
Dialogue: 0,0:38:29.71,0:38:31.34,pangkalahatang text,,0,0,0,,Sleep. Ang pagtulog ay ang pinakamahusay na gamot
Dialogue: 0,0:38:32.13,0:38:33.13,pangkalahatang teksto,,0,0,0,,Sinungaling
Dialogue: 0,0:38:35.30,0:38:37.09,general text,,0,0,0,,Totoo ba yung sinabi niya?
Dialogue: 0,0:38:37.64,0:38:39.47,italics,,0,0,0,,Hindi mahalaga kung mamatay ako sa lason,
Dialogue: 0,0:38:39.55,0:38:42.35,pangkalahatang teksto,,0,0,0,,paghahampas, suntok ng espada o mula sa pagsabog ng iyong braso
Dialogue: 0,0:38:43.06,0:38:46.44,pangkalahatang teksto,,0,0,0,,Walang pakialam ang aking guro sa kanyang estudyante
Dialogue: 0,0:38:48.02,0:38:49.44,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:38:50.36,0:38:54.36,general text,,0,0,0,,Ito ay dahil napakaswerte at maswerte mo
Dialogue: 0,0:38:55.11,0:38:57.45,pangkalahatang text,,0,0,0,,Ang pagsisinungaling ba ang iyong middle name?
Dialogue: 0,0:39:00.62,0:39:02.70,general text,,0,0,0,,Ayoko lang matakot ka
Dialogue: 0,0:39:03.29,0:39:06.46,pangkalahatang teksto,,0,0,0,,Nakuha ko. Salamat sa walang awa kong guro
Dialogue: 0,0:39:06.54,0:39:09.13,general text,,0,0,0,,Pero lumayo ka kapag hawak ko ulit ang espada
Dialogue: 0,0:39:09.21,0:39:10.79,general text,,0,0,0,,muntik na kitang saksakin ngayon
Dialogue: 0,0:39:10.88,0:39:14.26,general text,,0,0,0,,Tumayo ako dahil gusto kong ikaw mismo ang magkontrol ng enerhiya
Dialogue: 0,0:39:14.88,0:39:16.17,general text,,0,0,0,,Hindi ko sinasadyang makialam
Dialogue: 0,0:39:16.26,0:39:19.01,general text,,0,0,0,,Hindi ka nakialam. Nag-alala lang ako sayo
Dialogue: 0,0:39:25.64,0:39:27.69,pangkalahatang teksto,,0,0,0,,Isipin mo akong isang inang ibon na nag-aalala...
Dialogue: 0,0:39:27.77,0:39:29.81,pangkalahatang text,,0,0,0,,na masisira ang kanyang mga itlog. Maaari mong isipin?
Dialogue: 0,0:39:29.90,0:39:32.44,pangkalahatang teksto,,0,0,0,,Hindi mahalaga. Ito ay halos hindi makapinsala sa akin
Dialogue: 0,0:39:32.52,0:39:33.65,pangkalahatang teksto,,0,0,0,,kaya kong umiwas
Dialogue: 0,0:39:34.40,0:39:35.61,pangkalahatang teksto,,0,0,0,,Hindi ba mapanganib?
Dialogue: 0,0:39:35.69,0:39:37.90,general text,,0,0,0,,Paano ka makakaiwas kung napakabilis ko?
Dialogue: 0,0:39:37.99,0:39:39.66,pangkalahatang teksto,,0,0,0,,Hindi ganoon kabilis
Dialogue: 0,0:39:40.32,0:39:41.70,pangkalahatang teksto,,0,0,0,,Scoundrel...
Dialogue: 0,0:39:43.54,0:39:45.12,general text,,0,0,0,,Mabilis, tama? Huwag umiwas
Dialogue: 0,0:39:45.20,0:39:46.70,general text,,0,0,0,,You attacked without warning!
Dialogue: 0,0:39:46.79,0:39:48.54,pangkalahatang teksto,,0,0,0,,Oo? Tapos dito
Dialogue: 0,0:39:48.62,0:39:49.71,pangkalahatang teksto,,0,0,0,,Mu Dok, mga mata
Dialogue: 0,0:39:52.34,0:39:53.38,pangkalahatang text,,0,0,0,,Bastard
Dialogue: 0,0:39:53.46,0:39:55.46,general text,,0,0,0,,Binili mo ulit, hindi ako makapaniwala
Dialogue: 0,0:40:00.43,0:40:01.68,pangkalahatang teksto,,0,0,0,,Halika muli
Dialogue: 0,0:40:02.72,0:40:04.18,pangkalahatang teksto,,0,0,0,,Mula sa distansyang ito?
Dialogue: 0,0:40:04.26,0:40:05.85,general text,,0,0,0,,- Seryoso?\N- Halika
Dialogue: 0,0:40:10.56,0:40:11.69,pangkalahatang teksto,,0,0,0,,Moo Dok,
Dialogue: 0,0:40:12.94,0:40:15.11,pangkalahatang teksto,,0,0,0,,ang asul na marka ay nakikita sa mga mata
Dialogue: 0,0:40:15.98,0:40:17.32,pangkalahatang teksto,,0,0,0,,At napakaganda nito
Dialogue: 0,0:40:21.20,0:40:24.78,general text,,0,0,0,,At mas mabuting huwag mo akong guluhin sa pagiging malapit
Dialogue: 0,0:40:25.45,0:40:26.74,pangkalahatang teksto,,0,0,0,,Isipin mo na kaya ko
Dialogue: 0,0:40:26.83,0:40:28.25,pangkalahatang teksto,,0,0,0,,mula sa distansyang ito
Dialogue: 0,0:40:32.50,0:40:34.50,pangkalahatang teksto,,0,0,0,,Sa tingin ko ay naunawaan mo nang tama ang aking mga salita
Dialogue: 0,0:40:35.38,0:40:37.51,general text,,0,0,0,,Baka may maituro ako sayo
Dialogue: 0,0:40:41.97,0:40:43.14,pangkalahatang teksto,,0,0,0,,Chang Wook
Dialogue: 0,0:40:46.39,0:40:50.10,general text,,0,0,0,,Sa tingin mo ba wala akong muwang kung nakatira ako dito mag-isa?
Dialogue: 0,0:40:51.52,0:40:52.81,pangkalahatang teksto,,0,0,0,,Well, yes
Dialogue: 0,0:40:54.77,0:40:57.78,general text,,0,0,0,,Gusto kong malaman mo na marami akong maituturo sa iyo
Dialogue: 0,0:40:58.99,0:41:00.11,pangkalahatang teksto,,0,0,0,,Halimbawa?
Dialogue: 0,0:41:07.24,0:41:08.54,pangkalahatang teksto,,0,0,0,,Hoy! Ikaw...
Dialogue: 0,0:41:08.62,0:41:10.79,pangkalahatang teksto,,0,0,0,,Ang mga tunay na epektibong pag-atake ay
Dialogue: 0,0:41:10.87,0:41:14.00,pangkalahatang teksto,,0,0,0,,kapag hindi ito inaasahan ng kaaway
Dialogue: 0,0:41:14.54,0:41:16.38,pangkalahatang teksto,,0,0,0,,Tandaan mo ito, aking estudyante
Dialogue: 0,0:41:17.59,0:41:21.05,general text,,0,0,0,,Halos hindi kita nahawakan, at ibinigay mo ang lahat!
Dialogue: 0,0:41:21.13,0:41:22.76,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:41:24.43,0:41:26.76,pangkalahatang teksto,,0,0,0,,Hey, Moo Deok
Dialogue: 0,0:41:36.98,0:41:38.78,italics,,0,0,0,,Bagong concubine?
Dialogue: 0,0:41:39.61,0:41:42.70,general text,,0,0,0,,Ngayon hindi na niya sinusunod ang mga pormalidad
Dialogue: 0,0:41:43.32,0:41:45.57,italics,,0,0,0,,Siya ay mula sa isang maliit na pamilya ng mga salamangkero sa silangan
Dialogue: 0,0:41:45.66,0:41:48.91,italics,,0,0,0,,Sa kanyang kaarawan, isang kometa ang dumaan sa Big Dipper
Dialogue: 0,0:41:48.99,0:41:52.71,pangkalahatang teksto,,0,0,0,,Kaya titipunin niya ang lahat ng babaeng ipinanganak sa mga hindi pangkaraniwang gabi
Dialogue: 0,0:41:52.79,0:41:55.42,italics,,0,0,0,,Gusto niyang mahuli ang bituin ng Hari
Dialogue: 0,0:42:06.43,0:42:08.35,pangkalahatang teksto,,0,0,0,,Nang ang yumaong hari ay umakyat sa trono,
Dialogue: 0,0:42:08.43,0:42:12.64,pangkalahatang teksto,,0,0,0,,nahulaan na ang susunod ay ipanganak sa ilalim ng bituin ng Hari
Dialogue: 0,0:42:13.77,0:42:16.52,pangkalahatang teksto,,0,0,0,,Natuwa ang mga taga-Deho
Dialogue: 0,0:42:16.60,0:42:17.48,pangkalahatang teksto,,0,0,0,,Ngunit
Dialogue: 0,0:42:17.56,0:42:20.69,pangkalahatang teksto,,0,0,0,,ang trono ay kinuha ng iyong ama, ipinanganak sa isang ordinaryong gabi
Dialogue: 0,0:42:20.78,0:42:22.57,pangkalahatang teksto,,0,0,0,,Kung hindi, tulad mo
Dialogue: 0,0:42:23.36,0:42:24.90,pangkalahatang teksto,,0,0,0,,Kaya nagsimula ang mga pag-uusap
Dialogue: 0,0:42:25.78,0:42:27.62,pangkalahatang teksto,,0,0,0,,Hindi tama ang hula
Dialogue: 0,0:42:27.70,0:42:31.41,general text,,0,0,0,,Gwangju Chang Gang nakatakas matapos gumawa ng nakakatawang hula
Dialogue: 0,0:42:31.49,0:42:33.54,pangkalahatang teksto,,0,0,0,,Naniniwala sa kanya ang iyong ama
Dialogue: 0,0:42:34.12,0:42:35.87,general text,,0,0,0,,Kaya natatakot ka
Dialogue: 0,0:42:38.33,0:42:39.79,pangkalahatang teksto,,0,0,0,,Hindi ako natatakot
Dialogue: 0,0:42:39.88,0:42:42.67,pangkalahatang teksto,,0,0,0,,Natatakot kang may lilitaw na may ganoong lakas,
Dialogue: 0,0:42:42.76,0:42:44.92,pangkalahatang teksto,,0,0,0,,o na ang iyong ama ay magkakaroon ng isang anak na lalaki
Dialogue: 0,0:42:45.80,0:42:47.64,italics,,0,0,0,,alam ko yan
Dialogue: 0,0:42:51.06,0:42:53.81,general text,,0,0,0,,Malapit na ang away mo kay Chan Wook
Dialogue: 0,0:42:53.89,0:42:57.23,pangkalahatang teksto,,0,0,0,,Siralin ang anak ng gumawa ng hulang ito
Dialogue: 0,0:42:58.86,0:43:01.65,general text,,0,0,0,,Alisin ang iyong mga takot ngayong may pagkakataon ka na
Dialogue: 0,0:43:04.28,0:43:05.45,pangkalahatang teksto,,0,0,0,,Sa tingin mo,
Dialogue: 0,0:43:06.32,0:43:07.78,general text,,0,0,0,,lilitaw ba ito?
Dialogue: 0,0:43:08.78,0:43:09.87,general text,,0,0,0,,Narinig kong tumatakbo siya
Dialogue: 0,0:43:10.78,0:43:14.25,general text,,0,0,0,,May mga tsismis na handa pa raw siyang magpakasal, huwag lang makipag-away.
Dialogue: 0,0:43:15.41,0:43:16.71,pangkalahatang teksto,,0,0,0,,Kasal?
Dialogue: 0,0:43:16.79,0:43:20.71,general text,,0,0,0,,Balita ko sasama siya sa pamilya Jin para gamitin ang family amulet nila
Dialogue: 0,0:43:27.13,0:43:29.14,general text,,0,0,0,,Ikakasal na ba sina Wook at Jo Young?
Dialogue: 0,0:43:29.93,0:43:31.76,general text,,0,0,0,,Nag-break sila ng engagement minsan
Dialogue: 0,0:43:32.68,0:43:34.64,general text,,0,0,0,,Kaya mas madaling maghanda para sa kasal
Dialogue: 0,0:43:35.43,0:43:38.64,general text,,0,0,0,,May mga regalo pa siyang kasal
Dialogue: 0,0:43:38.73,0:43:40.90,pangkalahatang teksto,,0,0,0,,mula sa huling pagkakataon
Dialogue: 0,0:43:43.94,0:43:45.03,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:43:45.53,0:43:48.40,italics,,0,0,0,,Pagkatapos ng kasal ni Chan Wook...
Dialogue: 0,0:43:48.49,0:43:51.45,general text,,0,0,0,,Ibig sabihin, lilipat ang asawa ko dito
Dialogue: 0,0:43:51.95,0:43:54.45,general text,,0,0,0,,Pero maliit ang kwarto ko para sa aming dalawa
Dialogue: 0,0:43:54.54,0:43:59.00,general text,,0,0,0,,Pwede ba nating gamitin ang malaking kwarto sa east wing?
Dialogue: 0,0:43:59.58,0:44:02.34,general text,,0,0,0,,Ito ang kwarto ng ate mo
Dialogue: 0,0:44:03.84,0:44:06.38,pangkalahatang text,,0,0,0,,Ito ang aming pinakamagandang kwarto
Dialogue: 0,0:44:06.46,0:44:09.51,pangkalahatang teksto,,0,0,0,,Nakakalungkot na panatilihin itong walang laman sa loob ng maraming taon
Dialogue: 0,0:44:10.51,0:44:11.97,pangkalahatang teksto,,0,0,0,,Hindi ito walang laman
Dialogue: 0,0:44:12.68,0:44:14.39,pangkalahatang teksto,,0,0,0,,Babalik si Boo Young
Dialogue: 0,0:44:15.81,0:44:17.56,pangkalahatang teksto,,0,0,0,,Paumanhin, nanay
Dialogue: 0,0:44:20.31,0:44:22.19,general text,,0,0,0,,Hinahanap siya ng tatay mo
Dialogue: 0,0:44:23.36,0:44:26.44,general text,,0,0,0,,Malapit nang umuwi ang ate mo
Dialogue: 0,0:44:28.86,0:44:31.24,general text,,0,0,0,,Dalhin mo sa akin ang jade Yin-and-Yang mula sa Jinyeowon
Dialogue: 0,0:44:33.66,0:44:34.95,pangkalahatang teksto,,0,0,0,,Yin-and-Yang?
Dialogue: 0,0:44:35.03,0:44:36.41,general text,,0,0,0,,Gusto mo siya
Dialogue: 0,0:44:37.95,0:44:41.00,general text,,0,0,0,,Sinasabi nila na kung ang mag-asawa ay nagsusuot ng mga singsing na gawa sa naturang jade,
Dialogue: 0,0:44:41.08,0:44:42.79,pangkalahatang teksto,,0,0,0,,lalakas lamang ang pag-ibig
Dialogue: 0,0:44:44.92,0:44:47.92,pangkalahatang teksto,,0,0,0,,Hayaan silang gumawa ng mga singsing mula dito
Dialogue: 0,0:44:49.34,0:44:51.09,general text,,0,0,0,,Salamat, nanay
Dialogue: 0,0:45:14.62,0:45:16.99,pangkalahatang text,,0,0,0,,Nakakainis na urn. ikaw ba yan
Dialogue: 0,0:45:17.49,0:45:19.04,pangkalahatang teksto,,0,0,0,,Nakakagalit
Dialogue: 0,0:45:26.00,0:45:27.25,general text,,0,0,0,,Galit ka yata,
Dialogue: 0,0:45:27.34,0:45:29.42,general text,,0,0,0,,na ikakasal na ako
Dialogue: 0,0:45:29.51,0:45:30.55,pangkalahatang teksto,,0,0,0,,Makikita mo
Dialogue: 0,0:45:30.63,0:45:32.22,general text,,0,0,0,,Magagalit ka,
Dialogue: 0,0:45:32.30,0:45:34.05,pangkalahatang text,,0,0,0,,nang isuot ko itong jade ring
Dialogue: 0,0:45:46.36,0:45:47.94,pangkalahatang teksto,,0,0,0,,Kumain
Dialogue: 0,0:45:48.94,0:45:50.23,pangkalahatang teksto,,0,0,0,,So
Dialogue: 0,0:45:52.61,0:45:55.11,general text,,0,0,0,,Nagdala ako ng pheasant
Dialogue: 0,0:45:55.20,0:45:57.16,general text,,0,0,0,,Bakit puro halaman ang meron dito?
Dialogue: 0,0:45:57.24,0:45:58.66,general text,,0,0,0,,Nandiyan siya...
Dialogue: 0,0:45:59.33,0:46:00.24,general text,,0,0,0,,Nasa sabaw siya
Dialogue: 0,0:46:00.33,0:46:02.08,pangkalahatang teksto,,0,0,0,,Napakaliit ng pheasant
Dialogue: 0,0:46:02.16,0:46:03.92,general text,,0,0,0,,Kaunti na lang ang natitira noong inihanda ko ang sabaw.
Dialogue: 0,0:46:14.84,0:46:16.93,pangkalahatang teksto,,0,0,0,,Ang lasa ay napakahina
Dialogue: 0,0:46:21.93,0:46:24.73,general text,,0,0,0,,May narinig ako habang nagbebenta ng mga halamang gamot sa Sosnovy Bor
Dialogue: 0,0:46:24.81,0:46:27.19,pangkalahatang teksto,,0,0,0,,Dalawang marangal na pamilya ang ikinasal sa kanilang mga anak
Dialogue: 0,0:46:27.77,0:46:29.69,pangkalahatang teksto,,0,0,0,,At sino ito?
Dialogue: 0,0:46:29.77,0:46:32.69,general text,,0,0,0,,Ikakasal na ang anak ni Mistress Jin
Dialogue: 0,0:46:33.40,0:46:36.45,pangkalahatang teksto,,0,0,0,,Nahanap na ba ni Young ang kanyang sarili na isang lalaking ikakasal? Sino siya?
Dialogue: 0,0:46:36.53,0:46:38.66,pangkalahatang teksto,,0,0,0,,Anak ni Gwangju Jeonbugwan
Dialogue: 0,0:46:40.95,0:46:42.33,general text,,0,0,0,,Hindi ba ikaw yan?
Dialogue: 0,0:46:53.26,0:46:56.47,general text,,0,0,0,,Hindi ko sinabi na ikakasal ako. anong nangyayari?
Dialogue: 0,0:46:56.55,0:46:58.22,general text,,0,0,0,,Anong ginagawa ng maid Kim doon?
Dialogue: 0,0:46:58.30,0:47:01.06,pangkalahatang teksto,,0,0,0,,Nangyayari ang madaliang pag-aasawa dahil sa hitsura ng isang bata
Dialogue: 0,0:47:01.14,0:47:02.18,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:47:02.77,0:47:04.35,general text,,0,0,0,,Engaged ka na
Dialogue: 0,0:47:05.02,0:47:06.60,pangkalahatang text,,0,0,0,,Siguro hindi mo mapigilan ang iyong sarili
Dialogue: 0,0:47:06.69,0:47:09.90,general text,,0,0,0,,We have never been so close, paano siya nabuntis?
Dialogue: 0,0:47:10.73,0:47:12.86,general text,,0,0,0,,Well, yes, ang galing mo lang magsalita
Dialogue: 0,0:47:12.94,0:47:14.11,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:47:14.19,0:47:16.07,general text,,0,0,0,,Kung gayon bakit ka tumanggi na uminom ng chastity tea?
Dialogue: 0,0:47:16.15,0:47:17.15,pangkalahatang teksto,,0,0,0,,Ito ay dahil...
Dialogue: 0,0:47:19.57,0:47:21.24,general text,,0,0,0,,na kailangan mong magpakasal
Dialogue: 0,0:47:23.08,0:47:24.83,general text,,0,0,0,,So, gusto kong magpakasal
Dialogue: 0,0:47:26.12,0:47:27.67,pangkalahatang teksto,,0,0,0,,Oo, gusto kong
Dialogue: 0,0:47:27.75,0:47:28.87,general text,,0,0,0,,Gusto ko
Dialogue: 0,0:47:29.63,0:47:32.17,general text,,0,0,0,,Ikakasal talaga ako
Dialogue: 0,0:47:32.25,0:47:33.50,pangkalahatang teksto,,0,0,0,,Makikita mo
Dialogue: 0,0:47:48.73,0:47:50.44,italics,,0,0,0,,Bakit mo ako gustong makita?
Dialogue: 0,0:47:51.23,0:47:54.65,general text,,0,0,0,,Kailan kaya darating ang mother-of-pearl cabinet na inorder ko kay Sosnovy Bor?
Dialogue: 0,0:47:55.28,0:47:56.53,pangkalahatang teksto,,0,0,0,,Siya ay para sa amin ni Uk
Dialogue: 0,0:47:56.61,0:48:00.61,pangkalahatang teksto,,0,0,0,,Darating ang mga kalakal mula sa timog sa isang araw ng linggo
Dialogue: 0,0:48:01.37,0:48:02.66,pangkalahatang text,,0,0,0,,Gabi na
Dialogue: 0,0:48:03.66,0:48:05.12,pangkalahatang teksto,,0,0,0,,Dapat ay nag-order nang mas maaga
Dialogue: 0,0:48:05.20,0:48:07.08,pangkalahatang teksto,,0,0,0,,Kalimutan ang tungkol sa closet
Dialogue: 0,0:48:07.62,0:48:09.54,pangkalahatang teksto,,0,0,0,,Dapat kong sabihin kay Uku
Dialogue: 0,0:48:10.88,0:48:12.21,general text,,0,0,0,,Hindi niya alam
Dialogue: 0,0:48:14.30,0:48:16.92,general text,,0,0,0,,Kaya sinulatan ko siya ng sulat
Dialogue: 0,0:48:17.72,0:48:19.18,pangkalahatang teksto,,0,0,0,,Basahin at ibahagi ang iyong mga saloobin
Dialogue: 0,0:48:20.89,0:48:22.01,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:48:25.72,0:48:26.85,pangkalahatang text,,0,0,0,,Mabango
Dialogue: 0,0:48:26.93,0:48:29.23,pangkalahatang teksto,,0,0,0,,Ito ang insenso na nagdadala ng pag-ibig
Dialogue: 0,0:48:30.14,0:48:31.60,pangkalahatang teksto,,0,0,0,,Jinyeowon's Treasure
Dialogue: 0,0:48:33.36,0:48:35.98,pangkalahatang teksto,,0,0,0,,Mabango ang amoy
Dialogue: 0,0:48:57.80,0:48:59.55,general text,,0,0,0,,Bakit mo inaamoy?
Dialogue: 0,0:48:59.63,0:49:00.59,pangkalahatang text,,0,0,0,,Tumigil ka!
Dialogue: 0,0:49:01.72,0:49:03.64,general text,,0,0,0,,At isara mo ang iyong ilong!
Dialogue: 0,0:49:15.98,0:49:17.82,general text,,0,0,0,,halos nasayang ko lahat
Dialogue: 0,0:49:21.03,0:49:22.74,pangkalahatang teksto,,0,0,0,,Ibigay ang liham kay Uku
Dialogue: 0,0:49:23.32,0:49:26.53,general text,,0,0,0,,At siguraduhin mong walang malapit na babae kapag nagbukas siya
Dialogue: 0,0:49:29.33,0:49:30.16,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:49:35.50,0:49:36.63,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:49:36.71,0:49:41.38,general text,,0,0,0,,Magkahawak ang kamay ni Uk, di ba?
Dialogue: 0,0:49:43.38,0:49:44.59,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:49:45.39,0:49:47.89,general text,,0,0,0,,Sumama ka sa akin para bumili ng wedding rings
Dialogue: 0,0:49:47.97,0:49:49.31,pangkalahatang teksto,,0,0,0,,Hayaan mo ako
Dialogue: 0,0:49:50.06,0:49:52.52,general text,,0,0,0,,Bakit ako pupunta doon kasama mo?
Dialogue: 0,0:49:52.60,0:49:53.77,pangkalahatang text,,0,0,0,,Sumama ka sa fiance mo
Dialogue: 0,0:49:54.81,0:49:58.94,pangkalahatang teksto,,0,0,0,,Ang kasal ay dapat tapusin sa pamamagitan ng mutual na pahintulot
Dialogue: 0,0:49:59.57,0:50:02.32,general text,,0,0,0,,Nakakalungkot na ganito ang ugali mo
Dialogue: 0,0:50:03.61,0:50:04.45,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:50:06.03,0:50:07.99,general text,,0,0,0,,Sa tingin mo ba minamadali ko ang mga bagay-bagay?
Dialogue: 0,0:50:08.70,0:50:10.74,general text,,0,0,0,,O tatanggi na naman siya?
Dialogue: 0,0:50:15.71,0:50:18.42,general text,,0,0,0,,Nagmamadali ka ba o hindi,
Dialogue: 0,0:50:19.96,0:50:21.38,general text,,0,0,0,,Tutulong ako
Dialogue: 0,0:50:22.21,0:50:23.38,pangkalahatang teksto,,0,0,0,,Kung gumana lang
Dialogue: 0,0:50:28.43,0:50:30.18,pangkalahatang teksto,,0,0,0,,At bibigyan din kita ng tulong
Dialogue: 0,0:50:39.36,0:50:40.94,italics,,0,0,0,,Kung iisipin mo,
Dialogue: 0,0:50:41.03,0:50:43.65,general text,,0,0,0,,maid Kim ay tutol sa akin na nakatira kasama ang pamilya ng aking asawa,
Dialogue: 0,0:50:43.74,0:50:45.82,general text,,0,0,0,,kailan namin huling napag-usapan ang kasal ni Cho Young
Dialogue: 0,0:50:47.20,0:50:50.49,general text,,0,0,0,,Isa lang ang dahilan kung bakit napag-usapan muli ang kasal
Dialogue: 0,0:50:50.99,0:50:52.20,pangkalahatang teksto,,0,0,0,,Ang aking pagtatanggol
Dialogue: 0,0:50:52.79,0:50:55.04,general text,,0,0,0,,Nakipag-deal siya sa pamilya Jin,
Dialogue: 0,0:50:55.12,0:50:57.46,pangkalahatang teksto,,0,0,0,,upang matulungan kang maiwasan ang away
Dialogue: 0,0:50:57.54,0:50:59.54,general text,,0,0,0,,Malamang kailangan niya ng impluwensya ni Madam Jin
Dialogue: 0,0:51:01.00,0:51:02.63,pangkalahatang teksto,,0,0,0,,Sa kasong ito,
Dialogue: 0,0:51:03.67,0:51:05.09,general text,,0,0,0,,ikakasal?
Dialogue: 0,0:51:06.84,0:51:09.85,pangkalahatang teksto,,0,0,0,,Ano ang dapat kong gawin, guro? Magpakasal?
Dialogue: 0,0:51:12.22,0:51:13.35,pangkalahatang teksto,,0,0,0,,Sulit ba ito?
Dialogue: 0,0:51:15.18,0:51:18.90,general text,,0,0,0,,Kung ganoon, wala nang dahilan para manatili pa rito
Dialogue: 0,0:51:19.48,0:51:21.40,pangkalahatang teksto,,0,0,0,, Eksakto. Kailangan na nating umuwi
Dialogue: 0,0:51:21.48,0:51:23.69,general text,,0,0,0,,Pero ang relasyon natin, syempre, hindi mabubuhay
Dialogue: 0,0:51:23.78,0:51:26.65,pangkalahatang teksto,,0,0,0,,Bakit? Pwede mo pa akong maging maid
Dialogue: 0,0:51:28.86,0:51:31.53,general text,,0,0,0,,Hindi kasama sa mga plano ko ang pagiging forever niya
Dialogue: 0,0:51:49.76,0:51:51.39,pangkalahatang teksto,,0,0,0,,Pagkatapos ay maglayag ka nang mag-isa
Dialogue: 0,0:51:51.47,0:51:52.97,pangkalahatang teksto,,0,0,0,,Pupunta ako sa Chwisongru
Dialogue: 0,0:51:54.31,0:51:57.39,pangkalahatang text,,0,0,0,,Kung hindi ka pupunta para sa akin, aalis akong mag-isa
Dialogue: 0,0:52:12.12,0:52:13.87,pangkalahatang teksto,,0,0,0,,Chwisongru
Dialogue: 0,0:52:19.33,0:52:20.33,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:52:20.42,0:52:22.08,general text,,0,0,0,,We are from Jeonbugwan
Dialogue: 0,0:52:22.17,0:52:24.04,general text,,0,0,0,,Dadalhin ka namin doon
Dialogue: 0,0:52:24.13,0:52:24.96,general text,,0,0,0,,Let's go
Dialogue: 0,0:52:28.38,0:52:30.30,italics,,0,0,0,,Ito ang sachet ng Kanyang Kamahalan
Dialogue: 0,0:52:30.38,0:52:34.05,pangkalahatang teksto,,0,0,0,,Ako ay nasa ilalim ng proteksyon ng prinsipe mismo, hindi ka nangahas na hawakan ako
Dialogue: 0,0:52:37.27,0:52:39.73,general text,,0,0,0,,Anong ginagawa mo? Hayaan mo na!
Dialogue: 0,0:52:39.81,0:52:41.69,general text,,0,0,0,,Ito ang sachet ng Crown Prince
Dialogue: 0,0:52:53.70,0:52:55.91,pangkalahatang teksto,,0,0,0,,Inihatid namin ito mula sa Chwisongru
Dialogue: 0,0:52:56.54,0:52:58.33,pangkalahatang teksto,,0,0,0,,Chwisongru?
Dialogue: 0,0:53:07.13,0:53:09.55,general text,,0,0,0,,Dumating na ang babaeng tinanong mo
Dialogue: 0,0:53:10.17,0:53:11.30,general text,,0,0,0,,Nasaan siya?
Dialogue: 0,0:53:15.01,0:53:16.10,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:53:18.43,0:53:19.39,general text,,0,0,0,,Siya?
Dialogue: 0,0:53:19.93,0:53:21.52,pangkalahatang teksto,,0,0,0,,Itaas ang iyong ulo
Dialogue: 0,0:53:33.07,0:53:34.70,general text,,0,0,0,,Bakit ganyan ang suot mo?
Dialogue: 0,0:53:35.28,0:53:36.78,pangkalahatang teksto,,0,0,0,,Walang ideya
Dialogue: 0,0:53:37.32,0:53:40.53,general text,,0,0,0,,Pinalitan niya agad ako ng damit nang dinala nila ako dito.
Dialogue: 0,0:53:41.49,0:53:43.66,pangkalahatang teksto,,0,0,0,,Gawa mo ba ito?
Dialogue: 0,0:53:43.75,0:53:45.83,general text,,0,0,0,,Kisaeng siya di ba...
Dialogue: 0,0:53:46.71,0:53:47.96,pangkalahatang teksto,,0,0,0,,mula sa Chwisongru?
Dialogue: 0,0:53:49.13,0:53:50.29,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:53:51.84,0:53:54.26,general text,,0,0,0,,- She Stink Mu Dok\N- V-Stink?
Dialogue: 0,0:53:56.34,0:53:57.59,pangkalahatang text,,0,0,0,,Lumabas
Dialogue: 0,0:53:58.51,0:53:59.76,pangkalahatang teksto,,0,0,0,,Go
Dialogue: 0,0:54:02.89,0:54:04.14,pangkalahatang teksto,,0,0,0,,Tingnan mo lang ang iyong sarili
Dialogue: 0,0:54:08.35,0:54:10.36,general text,,0,0,0,,Bakit mo ako gustong makita?
Dialogue: 0,0:54:10.44,0:54:14.28,general text,,0,0,0,,May gusto sana akong sabihin, kaya inutusan kitang ihatid
Dialogue: 0,0:54:14.36,0:54:16.36,general text,,0,0,0,,Ngunit ngayon hindi ka na si Won Moo Deok
Dialogue: 0,0:54:16.45,0:54:18.07,pangkalahatang teksto,,0,0,0,,Ang baho at seda ay hindi magkasabay
Dialogue: 0,0:54:18.78,0:54:21.37,pangkalahatang teksto,,0,0,0,,Sa iyong diksyunaryo ito ay napaka
Dialogue: 0,0:54:22.41,0:54:23.79,general text,,0,0,0,,Kaka-snap mo lang?
Dialogue: 0,0:54:23.87,0:54:25.41,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:54:25.50,0:54:28.46,general text,,0,0,0,,Nagpapasalamat ako na binihisan nila ako ng seda
Dialogue: 0,0:54:30.08,0:54:33.34,pangkalahatang teksto,,0,0,0,,Katanggap-tanggap. Ang bagong hitsura na ito...
Dialogue: 0,0:54:35.21,0:54:36.59,pangkalahatang teksto,,0,0,0,,ay hindi bagay sa iyo
Dialogue: 0,0:54:39.38,0:54:42.85,general text,,0,0,0,,Hindi mo gusto, hindi ako komportable dito,
Dialogue: 0,0:54:42.93,0:54:44.18,general text,,0,0,0,,Magpapalit ako ng damit
Dialogue: 0,0:54:44.26,0:54:45.35,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:54:46.52,0:54:49.10,pangkalahatang teksto,,0,0,0,,Hindi mahalaga. Iwanan ito bilang ay
Dialogue: 0,0:54:51.56,0:54:55.65,general text,,0,0,0,,Say what you want and I'll do it
Dialogue: 0,0:54:55.73,0:54:58.03,pangkalahatang teksto,,0,0,0,,Sabihin sa iyong panginoon...
Dialogue: 0,0:54:58.65,0:54:59.95,pangkalahatang text,,0,0,0,,huwag kang pumunta sa araw na iyon
Dialogue: 0,0:55:01.11,0:55:02.45,general text,,0,0,0,,ayokong patayin siya
Dialogue: 0,0:55:02.53,0:55:05.70,italics,,0,0,0,,at naging kaaway ng Pine Forest at ng pamilya Chan
Dialogue: 0,0:55:06.41,0:55:08.71,pangkalahatang teksto,,0,0,0,,Mas maganda kung tatakbo siya at iiwan ang lahat ng ganito
Dialogue: 0,0:55:10.25,0:55:12.71,general text,,0,0,0,,Ibig sabihin, kailangan lang niyang manatiling isang katatawanan
Dialogue: 0,0:55:13.38,0:55:14.42,italics,,0,0,0,,Tama
Dialogue: 0,0:55:15.05,0:55:18.34,pangkalahatang teksto,,0,0,0,,Kung matigas ang ulo niya, kausapin mo siya.
Dialogue: 0,0:55:18.42,0:55:20.34,general text,,0,0,0,,Hindi siya makakaligtas sa pakikipaglaban sa akin
Dialogue: 0,0:55:22.93,0:55:26.06,general text,,0,0,0,,Hayaan siyang maupo ng tahimik at pagkatapos ay pakasalan si Jin Cho Young
Dialogue: 0,0:55:27.35,0:55:30.44,general text,,0,0,0,,Kaya totoo na ang kasal ang magliligtas sa kanyang buhay
Dialogue: 0,0:55:33.19,0:55:35.48,general text,,0,0,0,,Ano ang mangyayari sa iyo kung magpakasal siya?
Dialogue: 0,0:55:35.57,0:55:36.69,general text,,0,0,0,,Mananatili ka ba sa kanya?
Dialogue: 0,0:55:37.36,0:55:38.65,general text,,0,0,0,,Hindi ako mananatili
Dialogue: 0,0:55:39.28,0:55:41.95,pangkalahatang teksto,,0,0,0,,Bakit? Sumuko na ba siya sayo?
Dialogue: 0,0:55:44.37,0:55:47.24,pangkalahatang teksto,,0,0,0,,At handa kang uminom ng tubig mula sa palayok ng silid para sa kanyang kapakanan
Dialogue: 0,0:55:47.33,0:55:49.00,italics,,0,0,0,,Wala siyang loyalty,
Dialogue: 0,0:55:49.08,0:55:50.41,pangkalahatang teksto,,0,0,0,,walang dignidad
Dialogue: 0,0:55:51.62,0:55:55.84,pangkalahatang teksto,,0,0,0,,Meron po, Your Highness
Dialogue: 0,0:55:55.92,0:55:58.34,general text,,0,0,0,,Pinoprotektahan mo ba siya? At kadalasan ay nagsasabi siya ng mga masasamang bagay
Dialogue: 0,0:55:58.42,0:56:00.22,pangkalahatang teksto,,0,0,0,,Patawarin mo ako
Dialogue: 0,0:56:01.17,0:56:03.47,general text,,0,0,0,,Masisiyahan kang makarinig ng mga masasakit na bagay tungkol sa kanya,
Dialogue: 0,0:56:04.30,0:56:08.06,general text,,0,0,0,,pero wala na akong lakas para magsalita
Dialogue: 0,0:56:09.60,0:56:12.23,general text,,0,0,0,,Ikaw ay isang maruming mongrel na iiwanan ng iyong may-ari
Dialogue: 0,0:56:23.57,0:56:24.61,general text,,0,0,0,,Gusto mo bang dalhin ko sa iyo?
Dialogue: 0,0:56:26.74,0:56:27.99,pangkalahatang teksto,,0,0,0,,Kaya ko
Dialogue: 0,0:56:28.58,0:56:30.87,general text,,0,0,0,,Makakakita ka rin ng trabaho dito
Dialogue: 0,0:56:32.21,0:56:33.08,general text,,0,0,0,,Ayoko
Dialogue: 0,0:56:34.50,0:56:37.38,general text,,0,0,0,,Let me be Won Mu Deok, na iniiwasan ng lahat,
Dialogue: 0,0:56:37.96,0:56:40.76,general text,,0,0,0,,pero hindi ko pinaglilingkuran ang lahat
Dialogue: 0,0:56:44.26,0:56:46.89,pangkalahatang teksto,,0,0,0,,Kalimutan. Hindi mo rin ako binitawan
Dialogue: 0,0:56:47.51,0:56:49.56,italics,,0,0,0,,- You can go\N-{\i0} Oo
Dialogue: 0,0:56:55.10,0:56:56.65,pangkalahatang teksto,,0,0,0,,Pagkatapos ay pupunta ako,
Dialogue: 0,0:56:57.23,0:56:58.48,pangkalahatang teksto,,0,0,0,,Your Highness
Dialogue: 0,0:57:08.03,0:57:09.41,pangkalahatang teksto,,0,0,0,,"Sa lahat"?
Dialogue: 0,0:57:10.74,0:57:12.04,pangkalahatang teksto,,0,0,0,,Ako ay isang prinsipe
Dialogue: 0,0:57:12.12,0:57:14.12,general text,,0,0,0,,Hindi maintindihan ni Won Moo Deok,
Dialogue: 0,0:57:14.21,0:57:15.75,pangkalahatang teksto,,0,0,0,,kung sino ang kanyang kausap
Dialogue: 0,0:57:33.23,0:57:35.98,pangkalahatang teksto,,0,0,0,,- Mag-ingat. Huwag magmadali\N- Yes, madam
Dialogue: 0,0:57:38.11,0:57:38.94,pangkalahatang teksto,,0,0,0,,Maiden Kim
Dialogue: 0,0:57:40.36,0:57:41.23,general text,,0,0,0,,Kumusta ka?
Dialogue: 0,0:57:42.48,0:57:43.57,pangkalahatang teksto,,0,0,0,,Young Master!
Dialogue: 0,0:57:44.19,0:57:45.70,pangkalahatang teksto,,0,0,0,,Mahal!
Dialogue: 0,0:57:47.70,0:57:49.57,general text,,0,0,0,,- Young Master!\N- Nag-aalala ka ba?
Dialogue: 0,0:57:49.66,0:57:50.87,general text,,0,0,0,,Kumain ka ba ng maayos?
Dialogue: 0,0:57:50.95,0:57:52.58,pangkalahatang teksto,,0,0,0,,Oo, mabuti
Dialogue: 0,0:57:52.66,0:57:54.12,pangkalahatang teksto,,0,0,0,,Anong kaligayahan
Dialogue: 0,0:57:54.20,0:57:55.71,general text,,0,0,0,,Ang iyong balat ay kumikinang
Dialogue: 0,0:57:55.79,0:57:56.92,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo!
Dialogue: 0,0:57:57.00,0:57:58.29,general text,,0,0,0,,Tara na sa loob
Dialogue: 0,0:58:01.96,0:58:03.80,pangkalahatang text,,0,0,0,,Sinusubukan niyang ibenta ito
Dialogue: 0,0:58:06.47,0:58:07.84,pangkalahatang teksto,,0,0,0,,anting-anting mula kay Sosnovy Bor?
Dialogue: 0,0:58:15.77,0:58:17.85,pangkalahatang text,,0,0,0,,Hindi ako iyon. Si Moo Deok lang
Dialogue: 0,0:58:18.65,0:58:20.86,general text,,0,0,0,,Sinubukan ni Moo Dok na ibenta ang agimat ni Wook?
Dialogue: 0,0:58:20.94,0:58:23.19,general text,,0,0,0,,Ipinakilala ko lang siya sa nagbebenta
Dialogue: 0,0:58:23.28,0:58:25.28,general text,,0,0,0,,Sa huli, ninakaw ito ni Ah Hyang
Dialogue: 0,0:58:25.36,0:58:27.32,general text,,0,0,0,,Kaya wala kaming kinalaman ni Moo Deok.
Dialogue: 0,0:58:45.05,0:58:46.34,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:58:47.72,0:58:49.97,general text,,0,0,0,,Bakit ganyan ang suot niya?
Dialogue: 0,0:58:50.72,0:58:52.43,pangkalahatang teksto,,0,0,0,,Mahabang kwento
Dialogue: 0,0:58:52.51,0:58:55.27,general text,,0,0,0,,Nakabalik ka na ba sa Chwisong-ra?
Dialogue: 0,0:58:56.14,0:58:58.39,general text,,0,0,0,,Ibinenta ka ba pabalik ni Uk dahil ikakasal na siya?
Dialogue: 0,0:58:58.48,0:58:59.77,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:58:59.85,0:59:03.77,general text,,0,0,0,,Kahit mabenta, hindi na ako babalik dito
Dialogue: 0,0:59:03.86,0:59:05.86,general text,,0,0,0,,Sa wakas ay sumuko na si Joo Wol at sinabi sa akin,
Dialogue: 0,0:59:05.94,0:59:07.65,pangkalahatang text,,0,0,0,,na sinubukan mong ibenta ang agimat ni Uka
Dialogue: 0,0:59:10.99,0:59:12.82,pangkalahatang teksto,,0,0,0,,Oo, sinubukan ko
Dialogue: 0,0:59:13.70,0:59:14.62,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:59:15.74,0:59:17.50,general text,,0,0,0,,Dahil kailangan ko ng pera
Dialogue: 0,0:59:17.58,0:59:20.29,pangkalahatang teksto,,0,0,0,,Gusto kong magsuot ng sutla, kumain ng matatamis,
Dialogue: 0,0:59:20.37,0:59:22.88,pangkalahatang teksto,,0,0,0,,at magsaya sa mga ganoong lugar
Dialogue: 0,0:59:22.96,0:59:26.46,general text,,0,0,0,,Kaya pala nalasing ka last time
Dialogue: 0,0:59:27.38,0:59:30.63,pangkalahatang teksto,,0,0,0,,Oo. Ninakaw ko ang pera ng may-ari ko at nalasing
Dialogue: 0,0:59:35.22,0:59:37.27,general text,,0,0,0,,Naguguluhan talaga ako
Dialogue: 0,0:59:38.98,0:59:41.48,general text,,0,0,0,,Hindi lang kita maintindihan
Dialogue: 0,0:59:44.90,0:59:47.19,pangkalahatang teksto,,0,0,0,,At hindi mo ito kailangan
Dialogue: 0,0:59:47.28,0:59:49.07,pangkalahatang teksto,,0,0,0,,Iwanan ang lahat ng ito ay
Dialogue: 0,0:59:51.15,0:59:52.78,general text,,0,0,0,,Papasok ako
Dialogue: 0,0:59:52.86,0:59:54.53,general text,,0,0,0,,Gusto mo bang sumama sa akin?
Dialogue: 0,0:59:55.33,0:59:56.24,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:59:57.49,0:59:58.62,pangkalahatang teksto,,0,0,0,,Paalam
Dialogue: 0,1:00:11.80,1:00:13.26,pangkalahatang text,,0,0,0,,Amulet...
Dialogue: 0,1:00:14.64,1:00:17.81,pangkalahatang teksto,,0,0,0,,Kaya ikaw, Nak Su
Dialogue: 0,1:00:27.94,1:00:29.07,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,1:00:30.86,1:00:32.86,general text,,0,0,0,,bakit ayaw mong magpakasal?
Dialogue: 0,1:00:34.70,1:00:36.24,general text,,0,0,0,,Ayaw mo kay Mrs. Jin?
Dialogue: 0,1:00:36.32,1:00:38.66,general text,,0,0,0,,Hindi naman sa ayaw ko sa kanya
Dialogue: 0,1:00:39.70,1:00:41.58,general text,,0,0,0,,Hindi lang ako interesado
Dialogue: 0,1:00:42.21,1:00:44.33,general text,,0,0,0,,May gusto ka bang iba?
Dialogue: 0,1:00:45.71,1:00:46.92,pangkalahatang teksto,,0,0,0,,Sino?
Dialogue: 0,1:00:47.50,1:00:49.00,general text,,0,0,0,,Kilala ko ba siya?
Dialogue: 0,1:00:50.01,1:00:52.05,pangkalahatang text,,0,0,0,,Hindi, hindi mo siya kilala
Dialogue: 0,1:00:52.63,1:00:53.84,general text,,0,0,0,,Kaya may tao
Dialogue: 0,1:00:53.93,1:00:55.18,pangkalahatang teksto,,0,0,0,,alam ko
Dialogue: 0,1:00:55.26,1:00:56.30,general text,,0,0,0,,Sino siya?
Dialogue: 0,1:00:57.85,1:00:58.89,pangkalahatang text,,0,0,0,,Well...
Dialogue: 0,1:00:58.97,1:01:01.89,pangkalahatang teksto,,0,0,0,,Siya ay tulad ng isang malungkot na itlog sa isang pugad wala sa tuktok ng isang puno
Dialogue: 0,1:01:02.52,1:01:06.06,general text,,0,0,0,,Wala siyang iba kundi ako, kaya paano ako magpakasal sa iba?
Dialogue: 0,1:01:06.15,1:01:09.07,pangkalahatang text,,0,0,0,,Ang mga ganyang babae ang pinaka-delikado!
Dialogue: 0,1:01:09.15,1:01:11.40,general text,,0,0,0,,Wala silang maipagyayabang, pero mananatili silang mahigpit!
Dialogue: 0,1:01:11.48,1:01:12.99,general text,,0,0,0,,Hindi siya ganyan
Dialogue: 0,1:01:13.07,1:01:15.53,general text,,0,0,0,,Sino siya? Magsalita
Dialogue: 0,1:01:15.61,1:01:16.91,general text,,0,0,0,,ako na ang bahala sa kanya
Dialogue: 0,1:01:16.99,1:01:18.16,pangkalahatang teksto,,0,0,0,,Paano eksakto?
Dialogue: 0,1:01:18.24,1:01:20.70,general text,,0,0,0,,Bibigyan ko siya ng isang bag ng pera,
Dialogue: 0,1:01:20.79,1:01:23.37,pangkalahatang teksto,,0,0,0,,siya ay mapisa mula sa itlog at lilipad
Dialogue: 0,1:01:23.46,1:01:26.88,pangkalahatang teksto,,0,0,0,,Hindi siya makakalipad, hindi ganoon kadali
Dialogue: 0,1:01:28.17,1:01:30.30,general text,,0,0,0,,Sa anumang kaso, hindi ako makakapag-asawa
Dialogue: 0,1:01:30.38,1:01:31.59,pangkalahatang teksto,,0,0,0,, Harapin mo ito
Dialogue: 0,1:01:32.55,1:01:34.72,general text,,0,0,0,,Alamin mo lang. ayos lang?
Dialogue: 0,1:01:35.51,1:01:36.84,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,1:01:39.35,1:01:42.06,pangkalahatang teksto,,0,0,0,,Ano ito? Nasugatan ka ba?
Dialogue: 0,1:01:42.14,1:01:43.39,pangkalahatang teksto,,0,0,0,,Ipakita
Dialogue: 0,1:01:45.56,1:01:47.48,pangkalahatang teksto,,0,0,0,,Ano ang mali sa kamay?
Dialogue: 0,1:01:49.27,1:01:50.94,pangkalahatang teksto,,0,0,0,,Hindi nakontrol muli?
Dialogue: 0,1:01:58.16,1:01:59.78,pangkalahatang text,,0,0,0,,Ibenta ang damit na ito
Dialogue: 0,1:01:59.87,1:02:03.50,pangkalahatang teksto,,0,0,0,,- Ito ay seda, ibenta ito sa mas mataas na presyo\N- Mabuti
Dialogue: 0,1:02:04.08,1:02:06.54,general text,,0,0,0,,May bisita na ang ginang
Dialogue: 0,1:02:06.62,1:02:08.33,general text,,0,0,0,,Young Miss Jin from Jinyeowon is here
Dialogue: 0,1:02:09.08,1:02:12.63,italics,,0,0,0,,Naghahanap siya ng master na gagawa ng wedding rings para sa kanya.
Dialogue: 0,1:02:12.71,1:02:14.55,pangkalahatang teksto,,0,0,0,,Nagpakasal siya sa salamangkero mula sa Sosnovy Bor
Dialogue: 0,1:02:18.51,1:02:20.76,pangkalahatang teksto,,0,0,0,,Ano ang gusto mo sa singsing na ito?
Dialogue: 0,1:02:23.77,1:02:27.48,pangkalahatang teksto,,0,0,0,,Ito ang mga gawa ng pinakamahusay na artisan mula sa Deho
Dialogue: 0,1:02:29.27,1:02:32.15,general text,,0,0,0,,Maganda sila, pero medyo walang lasa
Dialogue: 0,1:02:33.78,1:02:36.03,general text,,0,0,0,,Pwede ko bang tingnan ang yin-yang jade?
Dialogue: 0,1:02:36.11,1:02:38.78,pangkalahatang teksto,,0,0,0,,Na nakita ko ito sa aking sarili, maaari akong pumili ng mas mahusay na mga pagpipilian
Dialogue: 0,1:02:43.62,1:02:45.62,general text,,0,0,0,,Sabi nila kapag nagsusuot ng jade ring ang magkasintahan,
Dialogue: 0,1:02:45.70,1:02:48.21,pangkalahatang teksto,,0,0,0,,lumalakas ang kanilang pagmamahalan
Dialogue: 0,1:03:02.43,1:03:04.14,behind the scenes,,0,0,0,,Bakit pumutok ang jade?
Dialogue: 0,1:03:04.97,1:03:07.35,voiceover,,0,0,0,,Noong kinuha ko, okay na ang lahat
Dialogue: 0,1:03:13.15,1:03:15.86,voiceover,,0,0,0,,Nasira ba siya noon?
Dialogue: 0,1:03:18.86,1:03:19.95,italics,,0,0,0,,Moo Dok
Dialogue: 0,1:03:26.62,1:03:27.87,italics,,0,0,0,,Ms.
Dialogue: 0,1:03:28.46,1:03:30.75,general text,,0,0,0,,Bakit bigla kang aalis?
Dialogue: 0,1:03:30.83,1:03:33.92,general text,,0,0,0,,Si Moo Dok ba ito? Nandito din si Uk?
Dialogue: 0,1:03:34.00,1:03:35.21,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,1:03:36.55,1:03:39.17,general text,,0,0,0,,- Ganun ba?\N- Sinundan niya ito ng buntot,
Dialogue: 0,1:03:39.26,1:03:41.05,pangkalahatang teksto,,0,0,0,,dapat siya ay nasa isang lugar sa lungsod
Dialogue: 0,1:03:41.13,1:03:42.93,pangkalahatang teksto,,0,0,0,,Naglalakad gamit ang buntot nito?
Dialogue: 0,1:03:43.01,1:03:44.72,pangkalahatang teksto,,0,0,0,,Siya ay kanyang lingkod!
Dialogue: 0,1:03:45.85,1:03:47.27,pangkalahatang teksto,,0,0,0,,Panoorin ang iyong wika
Dialogue: 0,1:03:48.73,1:03:52.31,general text,,0,0,0,,Si Moo Dok ay hindi lang isang utusan para sa kanya
Dialogue: 0,1:03:53.48,1:03:56.94,pangkalahatang text,,0,0,0,,Nalasing si Moo Dok kamakailan, at lumapit siya sa kanya
Dialogue: 0,1:03:57.61,1:03:59.40,italics,,0,0,0,,Natutuwa siya sa kanya
Dialogue: 0,1:03:59.49,1:04:01.99,general text,,0,0,0,,binuhat ko lang sa likod
Dialogue: 0,1:04:02.66,1:04:03.57,italics,,0,0,0,,Sigurado
Dialogue: 0,1:04:03.66,1:04:07.37,general text,,0,0,0,,kinuha mula dito dahil nagustuhan ko
Dialogue: 0,1:04:07.91,1:04:11.21,general text,,0,0,0,,Mu Dok from here? Gisaeng ba siya?
Dialogue: 0,1:04:11.29,1:04:12.75,pangkalahatang teksto,,0,0,0,,Siya ay isang mahirap na babae
Dialogue: 0,1:04:13.42,1:04:16.71,pangkalahatang text,,0,0,0,,Hindi kataka-taka na masyado siyang pinagkakaabalahan
Dialogue: 0,1:04:31.06,1:04:32.10,pangkalahatang text,,0,0,0,,Hey
Dialogue: 0,1:04:32.73,1:04:34.52,general text,,0,0,0,,Alam mo naman kung sino ako diba?
Dialogue: 0,1:04:35.90,1:04:38.02,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,1:04:38.11,1:04:40.57,general text,,0,0,0,,You are young Miss Jin from Jinyeowon
Dialogue: 0,1:04:42.57,1:04:45.70,general text,,0,0,0,,Soon tatawagin mo akong mistress
Dialogue: 0,1:04:46.91,1:04:50.58,general text,,0,0,0,,Dahil ikakasal na kami ni Uk
Dialogue: 0,1:04:52.12,1:04:54.83,pangkalahatang teksto,,0,0,0,,Binabati kita
Dialogue: 0,1:04:54.92,1:04:58.13,general text,,0,0,0,,Ako ang magiging asawa niya, at ikaw ang magiging kasambahay ko
Dialogue: 0,1:04:59.55,1:05:01.09,pangkalahatang teksto,,0,0,0,,Gumawa ng isang bagay ngayon
Dialogue: 0,1:05:03.34,1:05:05.05,pangkalahatang text,,0,0,0,,Kunin ang kahon
Dialogue: 0,1:05:06.09,1:05:07.72,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,1:05:14.56,1:05:15.85,behind the scenes,,0,0,0,,Ano ang problema?
Dialogue: 0,1:05:17.02,1:05:18.69,behind the scenes,,0,0,0,,Sirang bato
Dialogue: 0,1:05:21.28,1:05:23.70,pangkalahatang teksto,,0,0,0,,Ito ay isang mahalagang bagay
Dialogue: 0,1:05:23.78,1:05:25.91,pangkalahatang teksto,,0,0,0,,Kung masira ito,
Dialogue: 0,1:05:25.99,1:05:28.03,general text,,0,0,0,,ikaw ang sisihin
Dialogue: 0,1:05:29.16,1:05:31.83,voiceover,,0,0,0,,Sabihin mo ito kapag nasira na siya
Dialogue: 0,1:05:32.75,1:05:33.79,pangkalahatang text,,0,0,0,,Kunin mo at sundan mo ako
Dialogue: 0,1:05:35.04,1:05:36.17,pangkalahatang teksto,,0,0,0,,Ms.
Dialogue: 0,1:05:36.92,1:05:38.75,pangkalahatang teksto,,0,0,0,,Habang hindi kita pinaglilingkuran
Dialogue: 0,1:05:39.38,1:05:42.09,general text,,0,0,0,,Panahon na para pumunta ako sa master ko. Paalam
Dialogue: 0,1:05:46.38,1:05:48.93,general text,,0,0,0,,Mababa ba siya sa akin?
Dialogue: 0,1:05:56.69,1:05:59.23,general text,,0,0,0,,Hindi ko akalain?
Dialogue: 0,1:06:09.82,1:06:12.20,behind the scenes,,0,0,0,,Mas mabuting huwag na lang akong magkrus ng landas sa kanya.
Dialogue: 0,1:06:14.33,1:06:16.37,pangkalahatang teksto,,0,0,0,,Hoy! Ikaw!
Dialogue: 0,1:06:18.46,1:06:19.38,behind the scenes,,0,0,0,,Mapanganib na tao
Dialogue: 0,1:06:21.21,1:06:22.67,behind the scenes,,0,0,0,,o ang hamak na brat na ito?
Dialogue: 0,1:06:24.26,1:06:25.34,pangkalahatang text,,0,0,0,,My lady
Dialogue: 0,1:06:26.13,1:06:28.51,general text,,0,0,0,,Ibigay mo sa akin. dadalhin ko
Dialogue: 0,1:06:31.72,1:06:32.85,pangkalahatang text,,0,0,0,,Okay
Dialogue: 0,1:06:32.93,1:06:35.48,pangkalahatang teksto,,0,0,0,,Mag-ingat
Dialogue: 0,1:06:40.06,1:06:41.56,offscreen,,0,0,0,,Oo, sira na
Dialogue: 0,1:06:42.15,1:06:44.36,voiceover,,0,0,0,,Gusto niya akong sisihin dito?
Dialogue: 0,1:07:13.26,1:07:15.26,voiceover,,0,0,0,,So ibig sabihin dito nakatira ang pamilya Jin?
Dialogue: 0,1:07:48.05,1:07:49.51,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,1:08:01.77,1:08:02.81,pangkalahatang teksto,,0,0,0,,Ina
Dialogue: 0,1:08:24.50,1:08:26.13,italics,,0,0,0,,Hindi ka pwedeng umalis na lang
Dialogue: 0,1:08:27.42,1:08:30.80,general text,,0,0,0,,Isumpa mo sa harap ng portrait ng yumaong ina na ikakasal ka
Dialogue: 0,1:08:30.88,1:08:33.43,general text,,0,0,0,,Ito lang ang paraan para maprotektahan ang katayuan ng iyong ama
Dialogue: 0,1:08:35.85,1:08:37.18,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,1:08:37.26,1:08:38.47,pangkalahatang teksto,,0,0,0,,Sa tingin mo...
Dialogue: 0,1:08:39.52,1:08:41.64,general text,,0,0,0,,na siya ang tatay ko?
Dialogue: 0,1:08:45.19,1:08:46.56,pangkalahatang text,,0,0,0,,Alam mo...
Dialogue: 0,1:08:47.86,1:08:49.53,general text,,0,0,0,,sino ang tunay kong ama?
Dialogue: 0,1:08:51.19,1:08:52.86,general text,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,1:08:53.78,1:08:55.99,general text,,0,0,0,,Anak ka ni Gwangju Chang Gang
Dialogue: 0,1:08:57.91,1:09:00.12,pangkalahatang teksto,,0,0,0,,Oo, iyon ang pinaniwalaan ko sa buong buhay ko
Dialogue: 0,1:09:00.20,1:09:02.04,italics,,0,0,0,,Ayokong tanggihan ngayon
Dialogue: 0,1:09:02.12,1:09:03.08,italics,,0,0,0,,So...
Dialogue: 0,1:09:05.17,1:09:07.17,pangkalahatang teksto,,0,0,0,,Hindi ako uupo
Dialogue: 0,1:09:08.63,1:09:10.00,general text,,0,0,0,,Huwag mo akong pigilan,
Dialogue: 0,1:09:11.13,1:09:12.47,pangkalahatang text,,0,0,0,,kahit anong gawin ko
Dialogue: 0,1:09:20.47,1:09:23.60,general text,,0,0,0,,Maiden Kim, may pinadala ang pamilya Jin
Dialogue: 0,1:09:24.19,1:09:26.52,pangkalahatang text,,0,0,0,,Mula kay Jinyeowon? Ano ang problema?
Dialogue: 0,1:09:26.60,1:09:28.06,general text,,0,0,0,,May nangyari doon
Dialogue: 0,1:09:28.94,1:09:32.03,general text,,0,0,0,,Gusto nilang magmadali si Young Master Chan sa kanila
Dialogue: 0,1:10:12.90,1:10:14.19,general text,,0,0,0,,Hinahanap mo ba ako?
Dialogue: 0,1:10:14.28,1:10:15.57,pangkalahatang teksto,,0,0,0,,Ano ang ibig sabihin ng lahat ng ito?
Dialogue: 0,1:10:16.15,1:10:18.87,pangkalahatang teksto,,0,0,0,,Nawala ang pamana ng aming pamilya
Dialogue: 0,1:10:19.66,1:10:20.78,general text,,0,0,0,,At ang katulong...
Dialogue: 0,1:10:22.12,1:10:24.25,pangkalahatang teksto,,0,0,0,,nawala kasama niya
Dialogue: 0,1:10:31.59,1:10:34.34,voiceover,,0,0,0,,Ganun siya, Jinyoewon
Dialogue: 0,1:10:42.81,1:10:43.89,pangkalahatang text,,0,0,0,,Hey
Dialogue: 0,1:10:51.15,1:10:52.65,pangkalahatang teksto,,0,0,0,,Kaya ikaw
Dialogue: 0,1:10:56.78,1:10:58.36,pangkalahatang teksto,,0,0,0,,Matagal nang hindi nagkita
Dialogue: 0,1:11:28.64,1:11:29.94,italics,,0,0,0,,Sabi mo Mu Dok...
Dialogue: 0,1:11:30.81,1:11:33.48,general text,,0,0,0,,- nawawala dito?\N- Oo
Dialogue: 0,1:11:34.07,1:11:35.48,general text,,0,0,0,,Your maid, Moo Deok,
Dialogue: 0,1:11:36.19,1:11:38.61,general text,,0,0,0,,ninakaw ang yin-yang jade at tumakas
Dialogue: 0,1:12:10.81,1:12:13.10,preview,,0,0,0,,Iniisip mo ako, Your Highness,
Dialogue: 0,1:12:13.19,1:12:14.65,preview,,0,0,0,,kaya ako dumating
Dialogue: 0,1:12:14.73,1:12:17.36,preview,,0,0,0,,Namiss mo yung nakilala mo sa Danhyangok
Dialogue: 0,1:12:17.44,1:12:18.78,preview,,0,0,0,,Na-miss ba kita?
Dialogue: 0,1:12:18.86,1:12:20.11,preview,,0,0,0,,Walang ganyan
Dialogue: 0,1:12:20.19,1:12:21.45,preview,,0,0,0,,Buksan ang pinto
Dialogue: 0,1:12:21.53,1:12:24.49,preview,,0,0,0,,Buksan ang pinto kay Jinyeowon, kung saan nakalagay ang mga relics
Dialogue: 0,1:12:24.57,1:12:26.66,preview,,0,0,0,,Maaaring sinapian ka ng kulam at hindi na makabalik
Dialogue: 0,1:12:26.74,1:12:28.49,preview,,0,0,0,,Natatakot kang hawakan man lang sila
Dialogue: 0,1:12:30.00,1:12:31.25,preview,,0,0,0,,Ano iyon?
Dialogue: 0,1:12:31.33,1:12:32.92,preview,,0,0,0,,Dalhin si Chan Wook
Dialogue: 0,1:12:33.00,1:12:35.08,preview,,0,0,0,,Dapat kitang isuko para mabuhay
Dialogue: 0,1:12:35.17,1:12:36.13,preview,,0,0,0,,Ganito dapat
Dialogue: 0,1:12:37.34,1:12:39.88,preview,,0,0,0,,So si Moo Deok ay Nak Soo
Dialogue: 0,1:12:43.01,1:12:45.26,preview,,0,0,0,,Labanan na parang buhay mo ang nakasalalay dito
Dialogue: 0,0:20:53.07,0:20:55.07,pangkalahatang teksto,,0,0,0,,

Komento: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Beta editor: {\c&HFFF4C5&} Sana
