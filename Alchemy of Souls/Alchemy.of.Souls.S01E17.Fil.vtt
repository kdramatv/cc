Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter:{\c&HFFF4C5&} Ria_Lee, Alina, Zero Amamiya
Dialogue: 0,0:00:44.10,0:00:45.98,general text,,0,0,0,,Sino ka at bakit mo ako hinahabol?
Dialogue: 0,0:00:46.77,0:00:47.73,general text,,0,0,0,,I'm asking...
Dialogue: 0,0:00:49.90,0:00:51.15,pangkalahatang teksto,,0,0,0,,Sino ka?
Dialogue: 0,0:01:11.17,0:01:13.05,pangkalahatang teksto,,0,0,0,,Sa paghusga sa katotohanan na nakilala mo ang espada,
Dialogue: 0,0:01:13.63,0:01:14.84,pangkalahatang teksto,,0,0,0,,dapat isa kang salamangkero
Dialogue: 0,0:01:17.43,0:01:19.22,pangkalahatang teksto,,0,0,0,,Ibaba mo ang iyong espada
Dialogue: 0,0:01:21.22,0:01:24.94,pangkalahatang teksto,,0,0,0,,Delikado ang paglabas ng espada ni Jeonbugwan dito
Dialogue: 0,0:01:27.94,0:01:29.98,pangkalahatang teksto,,0,0,0,,Ito ang nayon ng Gema
Dialogue: 0,0:01:31.07,0:01:34.15,pangkalahatang teksto,,0,0,0,,Ang mga salamangkero ni Jeonbugwan na dumating para sa mahika ay itinuturing na mga kaaway dito
Dialogue: 0,0:01:35.90,0:01:37.07,general text,,0,0,0,,Kung napaaway ka
Dialogue: 0,0:01:37.16,0:01:39.62,pangkalahatang teksto,,0,0,0,,at malalaman ng mga tao na narito ka,
Dialogue: 0,0:01:40.66,0:01:42.70,pangkalahatang teksto,,0,0,0,,malalagay ka sa panganib
Dialogue: 0,0:01:50.59,0:01:51.71,pangkalahatang teksto,,0,0,0,,Parang ganito,
Dialogue: 0,0:01:52.71,0:01:54.47,general text,,0,0,0,,parang kilala mo kung sino ako
Dialogue: 0,0:01:56.34,0:01:58.64,general text,,0,0,0,,Dala mo ang gwangju sword ni Jeonbugwan
Dialogue: 0,0:02:00.31,0:02:01.90,general text,,0,0,0,,I think you are his son
Dialogue: 0,0:02:09.03,0:02:12.24,italics,,0,0,0,,Alam ba niya kung ano ang hitsura ng kanyang ama?
Dialogue: 0,0:02:14.79,0:02:18.46,general text,,0,0,0,,Walang portrait ang tatay niya gaya ng nanay niya?
Dialogue: 0,0:02:18.54,0:02:20.92,pangkalahatang teksto,,0,0,0,,Wala kaming mga larawan ng Gwangju
Dialogue: 0,0:02:21.88,0:02:23.84,general text,,0,0,0,,At hindi nagtanong ang ginoo tungkol sa kanya
Dialogue: 0,0:02:24.71,0:02:28.01,general text,,0,0,0,,Nakita niya lang ang kanyang ama noong bata, kaya hindi niya naaalala ang kanyang mukha.
Dialogue: 0,0:02:29.18,0:02:31.39,general text,,0,0,0,,Hindi niya nakikilala ang kanyang ama,
Dialogue: 0,0:02:31.47,0:02:33.14,general text,,0,0,0,,kahit na nabangga siya
Dialogue: 0,0:02:36.56,0:02:39.60,general text,,0,0,0,,Sinundan lang kita dahil nakilala ko ang espada
Dialogue: 0,0:02:44.19,0:02:45.94,general text,,0,0,0,,Kilala mo ba ang may-ari ng espada?
Dialogue: 0,0:02:48.53,0:02:51.28,general text,,0,0,0,, Baliw ang lalaking nag-iwan ng ganyang espada
Dialogue: 0,0:02:52.91,0:02:54.95,general text,,0,0,0,,Niloko siya ng kanyang asawa at namatay
Dialogue: 0,0:02:56.16,0:02:59.16,general text,,0,0,0,,Pagkatapos ay iniwan niya ang kanyang sariling anak, nagbitiw sa kanyang posisyon at nawala
Dialogue: 0,0:03:01.08,0:03:02.92,pangkalahatang text,,0,0,0,,Ang lokong ito ay si Chang Gang
Dialogue: 0,0:03:07.05,0:03:08.84,general text,,0,0,0,,Ganito ang sinasabi nila tungkol sa kanya sa likod niya
Dialogue: 0,0:03:09.63,0:03:11.80,general text,,0,0,0,,Wala pang nagsabi nito sa mukha ko
Dialogue: 0,0:03:13.10,0:03:14.93,general text,,0,0,0,,May sarili ka bang scores para makipag-ayos sa kanya?
Dialogue: 0,0:03:17.77,0:03:18.89,pangkalahatang teksto,,0,0,0,,Paano kung oo?
Dialogue: 0,0:03:19.99,0:03:22.95,general text,,0,0,0,,Ipaghiganti mo ako para sa iyong ama?
Dialogue: 0,0:03:26.99,0:03:28.41,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:03:28.50,0:03:30.46,pangkalahatang teksto,,0,0,0,,Hindi ko gagawin, kahit na ang kanyang anak
Dialogue: 0,0:03:31.58,0:03:33.00,general text,,0,0,0,,Hindi niya gusto iyon
Dialogue: 0,0:03:35.21,0:03:38.09,general text,,0,0,0,,Kung gayon bakit mo dala ang espada ng iyong ama?
Dialogue: 0,0:03:38.17,0:03:40.17,general text,,0,0,0,,Kung itatanggi ko na siya ang aking ama,
Dialogue: 0,0:03:41.13,0:03:42.26,pangkalahatang teksto,,0,0,0,,ang aking ina
Dialogue: 0,0:03:43.14,0:03:44.72,pangkalahatang teksto,,0,0,0,,magmumukhang kaawa-awa
Dialogue: 0,0:03:48.81,0:03:49.93,pangkalahatang teksto,,0,0,0,,Bago Hva...
Dialogue: 0,0:03:53.65,0:03:56.11,pangkalahatang teksto,,0,0,0,,Si Do Hwa ang pinakamalaking biktima
Dialogue: 0,0:04:05.95,0:04:07.62,general text,,0,0,0,,Kilala mo rin ba ang nanay ko?
Dialogue: 0,0:04:09.70,0:04:13.12,general text,,0,0,0,,Si Do Hwa ang pinakamagandang babae sa buong Daeho
Dialogue: 0,0:04:15.04,0:04:18.05,pangkalahatang teksto,,0,0,0,,Kilala siya ng lahat sa Deho
Dialogue: 0,0:04:18.63,0:04:21.72,general text,,0,0,0,,Parang lahat ng tao sa pamilya ko ay sikat sa isang bagay
Dialogue: 0,0:04:23.34,0:04:24.72,pangkalahatang teksto,,0,0,0,,Dapat kong sabihin,
Dialogue: 0,0:04:24.80,0:04:28.35,pangkalahatang text,,0,0,0,,Hindi ko akalain na makakatagpo ako ng isang tao dito na makakakilala sa akin
Dialogue: 0,0:04:56.43,0:04:58.85,pangkalahatang teksto,,0,0,0,,Ito ay isang lugar kung saan ang mga tao ay lihim na nagsasanay ng mahika,
Dialogue: 0,0:04:58.93,0:05:00.81,pangkalahatang teksto,,0,0,0,,sa kabila ng pagbabawal ni Sosnovy Bor
Dialogue: 0,0:05:01.47,0:05:05.27,general text,,0,0,0,,Ano ang ginagawa ng anak ni Gwangju Jeonbugwan sa ganoong lugar?
Dialogue: 0,0:05:05.35,0:05:06.90,general text,,0,0,0,,Well, sinabi nila sa akin na kaya ko
Dialogue: 0,0:05:06.98,0:05:10.07,pangkalahatang teksto,,0,0,0,,tingnan dito ang mahika ng mga sumpa at kaluluwa
Dialogue: 0,0:05:10.15,0:05:11.86,pangkalahatang teksto,,0,0,0,,Ikaw ang salamangkero ng Jeonjingak,
Dialogue: 0,0:05:12.40,0:05:14.40,general text,,0,0,0,,at interesado ka ba sa dark magic?
Dialogue: 0,0:05:15.70,0:05:16.78,pangkalahatang teksto,,0,0,0,,Hindi talaga
Dialogue: 0,0:05:17.91,0:05:20.49,general text,,0,0,0,,Nandito ako para hanapin ang shaman na gumagamit ng magic na ito
Dialogue: 0,0:05:22.49,0:05:23.58,pangkalahatang teksto,,0,0,0,,"Shaman"?
Dialogue: 0,0:05:24.45,0:05:27.04,pangkalahatang teksto,,0,0,0,,Ang shaman na ito ay nagtataglay ng mahika ng kaluluwa,
Dialogue: 0,0:05:27.67,0:05:29.63,pangkalahatang teksto,,0,0,0,,na nangungulam at nagpabaliw sa mga tao
Dialogue: 0,0:05:31.63,0:05:33.17,italics,,0,0,0,,Dalawampung taon na ang nakararaan nahuli siya
Dialogue: 0,0:05:33.26,0:05:36.51,general text,,0,0,0,,magicians of Jeonbugwan, pero nakatakas siya matapos masunog ang kanyang bahay
Dialogue: 0,0:05:38.93,0:05:40.93,general text,,0,0,0,,Ano ang kailangan mo sa shaman Choi?
Dialogue: 0,0:05:41.43,0:05:43.52,general text,,0,0,0,,Paano mo nalaman na tungkol ito sa kanya?
Dialogue: 0,0:05:45.98,0:05:49.56,pangkalahatang teksto,,0,0,0,,At ikaw, kung nagkataon, ay hindi ang mago ni Jeonbugwan,
Dialogue: 0,0:05:50.31,0:05:51.94,pangkalahatang teksto,,0,0,0,,sino ang nagtrabaho sa aking ama?
Dialogue: 0,0:05:53.86,0:05:56.15,pangkalahatang teksto,,0,0,0,,Ang pamilyang Choi ay isang pamilya ng mga salamangkero,
Dialogue: 0,0:05:57.24,0:06:00.50,general text,,0,0,0,,na winasak ni Master So Kyung matagal na ang nakalipas
Dialogue: 0,0:06:02.92,0:06:04.67,pangkalahatang teksto,,0,0,0,,Huwag mausisa
Dialogue: 0,0:06:05.42,0:06:08.13,italics,,0,0,0,,Kung kumonsumo ka ng ganoong interes,
Dialogue: 0,0:06:09.26,0:06:12.22,pangkalahatang teksto,,0,0,0,,aagawin ng kadiliman ng mahikang ito ang iyong kaluluwa,
Dialogue: 0,0:06:12.30,0:06:14.18,pangkalahatang text,,0,0,0,,at kalaunan ay mawawala sa iyo ang lahat
Dialogue: 0,0:06:16.35,0:06:17.81,pangkalahatang teksto,,0,0,0,,Kapag nangyari ito,
Dialogue: 0,0:06:18.98,0:06:20.69,pangkalahatang teksto,,0,0,0,,walang babalikan
Dialogue: 0,0:06:27.53,0:06:30.32,pangkalahatang teksto,,0,0,0,,Huwag hanapin ang mga nagsasagawa ng dark magic
Dialogue: 0,0:06:31.24,0:06:33.49,pangkalahatang teksto,,0,0,0,,Hindi sinasang-ayunan ng mundo ang mga ganitong bagay,
Dialogue: 0,0:06:34.53,0:06:35.99,pangkalahatang teksto,,0,0,0,,at hindi ka mapapatawad
Dialogue: 0,0:06:42.79,0:06:43.88,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:06:49.30,0:06:50.47,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:06:56.10,0:06:57.43,general text,,0,0,0,,Nasugatan ka ba?
Dialogue: 0,0:06:58.14,0:07:00.23,pangkalahatang teksto,,0,0,0,,Oo, sugatan
Dialogue: 0,0:07:02.02,0:07:04.61,pangkalahatang teksto,,0,0,0,,Nasugatan ako hanggang sa kaibuturan ng aking kaluluwa
Dialogue: 0,0:07:17.79,0:07:19.88,general text,,0,0,0,,Ganito ba talaga siya dahil sa dark magic?
Dialogue: 0,0:07:51.08,0:07:52.21,pangkalahatang teksto,,0,0,0,,Bu Young!
Dialogue: 0,0:07:53.62,0:07:54.79,pangkalahatang teksto,,0,0,0,,Bu Young!
Dialogue: 0,0:08:16.44,0:08:19.07,voiceover,,0,0,0,,Nakatingin lang ba siya sa akin?
Dialogue: 0,0:08:21.57,0:08:23.03,mga alaala na italics,,0,0,0,,Paumanhin
Dialogue: 0,0:08:23.11,0:08:25.24,memories,,0,0,0,,Maari mo ba akong tulungang buhatin ang saklay?
Dialogue: 0,0:08:26.28,0:08:28.58,voiceover,,0,0,0,,Ito yung babaeng nasagasaan ko sa bahay
Dialogue: 0,0:08:47.10,0:08:48.40,italics,,0,0,0,,Ina!
Dialogue: 0,0:08:54.07,0:08:55.03,pangkalahatang teksto,,0,0,0,,Ina
Dialogue: 0,0:08:56.40,0:08:57.78,general text,,0,0,0,,Siya ba talaga si Boo Young unnie?
Dialogue: 0,0:08:58.70,0:09:01.12,general text,,0,0,0,,Oo, kapatid mo ito
Dialogue: 0,0:09:02.33,0:09:03.75,pangkalahatang text,,0,0,0,,Onnie
Dialogue: 0,0:09:09.04,0:09:12.00,general text,,0,0,0,,Boo Young, ihahatid na kita sa kwarto mo
Dialogue: 0,0:09:44.12,0:09:47.21,general text,,0,0,0,,Ikaw ang kasambahay ni Chan Wook
Dialogue: 0,0:09:47.87,0:09:49.96,general text,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:09:51.92,0:09:55.21,general text,,0,0,0,,Pumunta ako para tulungan si Mrs. Jin na makatakas sa bahay
Dialogue: 0,0:09:55.30,0:09:57.81,general text,,0,0,0,,Pero parang mas mabuting umalis na ako
Dialogue: 0,0:09:57.89,0:09:59.52,general text,,0,0,0,,Aalis na ako
Dialogue: 0,0:10:10.24,0:10:11.87,behind the scenes,,0,0,0,,Ano ang ginagawa ni Moo Deok dito?
Dialogue: 0,0:10:12.45,0:10:14.28,offscreen,,0,0,0,,Sigurado ako na hindi niya ako nakilala
Dialogue: 0,0:10:15.41,0:10:17.20,offscreen,,0,0,0,,Pinatay ko na lang ba siya?
Dialogue: 0,0:10:18.71,0:10:21.88,general text,,0,0,0,,Bu Young, walang nagbago sa kwarto mo
Dialogue: 0,0:10:22.63,0:10:25.88,pangkalahatang teksto,,0,0,0,,Alam kong darating ang araw na ito
Dialogue: 0,0:10:37.22,0:10:38.43,general text,,0,0,0,,Pumasok na tayo
Dialogue: 0,0:10:55.70,0:10:57.95,pangkalahatang teksto,,0,0,0,,Lahat ng gamit mo
Dialogue: 0,0:10:59.00,0:11:00.54,pangkalahatang teksto,,0,0,0,,narito pa rin
Dialogue: 0,0:11:01.62,0:11:04.17,general text,,0,0,0,,Mula nang mamatay ako sa lawa,
Dialogue: 0,0:11:05.63,0:11:09.46,general text,,0,0,0,,tuwing gabi kailangan kong gumala sa paghahanap ng matutuluyan para sa gabi
Dialogue: 0,0:11:10.22,0:11:11.93,general text,,0,0,0,,At ngayon may kwarto na ako
Dialogue: 0,0:11:15.64,0:11:18.32,general text,,0,0,0,,Hindi ko alam na may ina pala akong naghihintay sa akin.
Dialogue: 0,0:11:21.15,0:11:25.28,pangkalahatang teksto,,0,0,0,,Araw-araw akong nagdusa at nagdusa
Dialogue: 0,0:11:30.50,0:11:31.91,pangkalahatang teksto,,0,0,0,,Kaawa-awa kong anak
Dialogue: 0,0:11:33.33,0:11:35.71,general text,,0,0,0,,Ngayon magiging masaya ka araw-araw
Dialogue: 0,0:11:37.13,0:11:38.55,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:11:42.42,0:11:43.59,pangkalahatang teksto,,0,0,0,,Nanay
Dialogue: 0,0:12:00.03,0:12:04.28,italics,,0,0,0,,Nahanap nga ba ni Jin Mu ang kanyang anak?
Dialogue: 0,0:12:06.53,0:12:09.62,pangkalahatang teksto,,0,0,0,,Oo. Binuksan ng dalaga si Jinyoung
Dialogue: 0,0:12:10.66,0:12:12.58,general text,,0,0,0,,- Ano?\N- Binuksan mo ba ang mga pinto?
Dialogue: 0,0:12:12.66,0:12:16.04,pangkalahatang teksto,,0,0,0,,Ang mga pintong ito ay hindi mabubuksan ng anumang mga panlilinlang
Dialogue: 0,0:12:16.12,0:12:19.54,pangkalahatang teksto,,0,0,0,,Tanging ang anak na babae ng pamilya Jin ang may kakayahan nito
Dialogue: 0,0:12:22.63,0:12:27.22,general text,,0,0,0,,So bumalik na si Jin Bu Young?
Dialogue: 0,0:12:36.82,0:12:40.45,general text,,0,0,0,,Bakit ang sakit ng mata ko tuwing pupunta ako kay Jinyeowon?
Dialogue: 0,0:12:47.71,0:12:49.63,voiceover,,0,0,0,,Dahil ba sa relics nila?
Dialogue: 0,0:13:09.31,0:13:10.86,general text,,0,0,0,,Moo Dok, anong ginagawa mo dito?
Dialogue: 0,0:13:11.98,0:13:13.78,general text,,0,0,0,,Tumingin ka ba sa salamin?
Dialogue: 0,0:13:17.74,0:13:19.28,general text,,0,0,0,,Gusto mo bang maging mas mabait sa akin?
Dialogue: 0,0:13:20.53,0:13:21.91,pangkalahatang teksto,,0,0,0,,Huwag magsalita ng walang kapararakan
Dialogue: 0,0:13:22.58,0:13:23.70,pangkalahatang text,,0,0,0,,Oh teka
Dialogue: 0,0:13:23.79,0:13:25.58,general text,,0,0,0,,Gusto kong maging mas mabait
Dialogue: 0,0:13:26.20,0:13:29.17,pangkalahatang teksto,,0,0,0,,Pumili ng bagay na angkop para sa iyong may-ari
Dialogue: 0,0:13:31.96,0:13:33.42,pangkalahatang teksto,,0,0,0,,Ako mismo ang pipili nito
Dialogue: 0,0:13:38.30,0:13:39.93,general text,,0,0,0,,So paano? Nababagay sa akin
Dialogue: 0,0:13:40.01,0:13:42.97,pangkalahatang teksto,,0,0,0,,Oo. Ang galing mo
Dialogue: 0,0:13:43.51,0:13:45.64,general text,,0,0,0,,Syempre bagay sa akin
Dialogue: 0,0:13:46.52,0:13:47.89,pangkalahatang teksto,,0,0,0,,Tingnan natin
Dialogue: 0,0:13:50.06,0:13:51.65,pangkalahatang teksto,,0,0,0,,Oh, at akma iyon
Dialogue: 0,0:13:51.73,0:13:53.61,pangkalahatang teksto,,0,0,0,,Mahirap pumili. Lahat bagay sa akin
Dialogue: 0,0:13:59.16,0:14:00.50,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:14:01.00,0:14:04.04,general text,,0,0,0,,Ibigay mo sa akin. Ngayon, pipintahan kita
Dialogue: 0,0:14:09.92,0:14:13.22,general text,,0,0,0,,Tingnan mo ang cute niya
Dialogue: 0,0:14:13.72,0:14:16.10,general text,,0,0,0,,cute na ako,
Dialogue: 0,0:14:16.18,0:14:17.68,pangkalahatang teksto,,0,0,0,,ngayon na ang iyong turn
Dialogue: 0,0:14:23.31,0:14:25.19,pangkalahatang text,,0,0,0,,Ang cute ng ating Moo Deok
Dialogue: 0,0:14:27.28,0:14:30.32,pangkalahatang teksto,,0,0,0,,Pagkabata. Akala ko mata ko lang ang gusto mo
Dialogue: 0,0:14:30.40,0:14:33.07,pangkalahatang teksto,,0,0,0,, Eksakto. Akala ko mata lang ang maganda
Dialogue: 0,0:14:34.45,0:14:37.04,general text,,0,0,0,,Ngunit ang lason mo ay nagbiro sa akin ng malupit
Dialogue: 0,0:14:37.12,0:14:38.95,pangkalahatang text,,0,0,0,,Ngayon gusto pa rin kita
Dialogue: 0,0:14:48.96,0:14:52.59,pangkalahatang text,,0,0,0,,Nakikita ko kung paano mo sinusubukan na huwag mahulog sa akin
Dialogue: 0,0:14:52.68,0:14:53.68,pangkalahatang teksto,,0,0,0,,Mahirap para sa iyo
Dialogue: 0,0:14:58.18,0:15:00.48,pangkalahatang teksto,,0,0,0,,Pero hindi. Hindi naman
Dialogue: 0,0:15:03.98,0:15:07.57,general text,,0,0,0,,Kung magsisinungaling ka sa harapan ko, maglaro man lang
Dialogue: 0,0:15:07.65,0:15:10.24,general text,,0,0,0,,Namula ang buong lugar
Dialogue: 0,0:15:12.99,0:15:15.96,general text,,0,0,0,,Ang blush kasi eh!
Dialogue: 0,0:15:16.04,0:15:17.17,pangkalahatang text,,0,0,0,,Hayaan mo
Dialogue: 0,0:15:19.92,0:15:22.30,general text,,0,0,0,,Kumbaga, masyado akong lumayo. Hindi lumalabas
Dialogue: 0,0:15:25.43,0:15:26.89,pangkalahatang teksto,,0,0,0,,Ikaw na ngayon
Dialogue: 0,0:15:27.64,0:15:30.27,general text,,0,0,0,,para kang lasing na aso
Dialogue: 0,0:15:33.64,0:15:36.94,general text,,0,0,0,,Wag kang ganyan, para siyang asong kakagatin
Dialogue: 0,0:15:37.02,0:15:39.36,general text,,0,0,0,,Makakagat talaga ako
Dialogue: 0,0:15:41.57,0:15:43.78,general text,,0,0,0,,Hindi ako kakagatin. Umupo ka
Dialogue: 0,0:15:47.28,0:15:49.83,general text,,0,0,0,,Halika, tama na
Dialogue: 0,0:15:53.08,0:15:55.42,general text,,0,0,0,,kinailangan kong bilhin ito dahil sa iyo
Dialogue: 0,0:15:56.50,0:15:59.79,pangkalahatang text,,0,0,0,,Kung hindi mo gusto, huwag mong gamitin. Itatago ko ito para sa sarili ko
Dialogue: 0,0:16:01.38,0:16:03.13,general text,,0,0,0,,Ang cute din niyan
Dialogue: 0,0:17:05.24,0:17:06.12,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,0:17:23.22,0:17:24.85,general text,,0,0,0,,Muntik kang masagasaan
Dialogue: 0,0:17:34.32,0:17:35.69,pangkalahatang teksto,,0,0,0,,Mu Dok,
Dialogue: 0,0:17:35.78,0:17:38.82,general text,,0,0,0,,lasing ka ba talaga? Uminom ka ba ng wala ako?
Dialogue: 0,0:17:41.53,0:17:44.41,general text,,0,0,0,,uminom din ako. Baka magkasama ngayon?
Dialogue: 0,0:17:45.16,0:17:46.74,general text,,0,0,0,,Hindi ako lasing
Dialogue: 0,0:17:47.66,0:17:49.12,general text,,0,0,0,,Nag-inom ka ba?
Dialogue: 0,0:17:49.21,0:17:52.00,general text,,0,0,0,,Nasa village ako ng Gema, doon nila ako ginagamot.
Dialogue: 0,0:17:52.58,0:17:54.97,general text,,0,0,0,,Nakilala si shaman Choi doon?
Dialogue: 0,0:17:56.47,0:17:58.93,pangkalahatang teksto,,0,0,0,,Nakahanap ng koneksyon sa pagitan niya at ni Jin Mu
Dialogue: 0,0:17:59.02,0:18:01.85,general text,,0,0,0,,At nabangga ko rin ang crown prince doon
Dialogue: 0,0:18:02.60,0:18:03.69,pangkalahatang teksto,,0,0,0,,Kasama ang prinsipe?
Dialogue: 0,0:18:03.77,0:18:07.19,pangkalahatang teksto,,0,0,0,,Siya rin ay pinaghihinalaan si Jin Mu at ang reyna
Dialogue: 0,0:18:15.03,0:18:16.03,general text,,0,0,0,,Your Highness
Dialogue: 0,0:18:17.45,0:18:19.25,general text,,0,0,0,,Babalik ka ba mula sa village ng Gema?
Dialogue: 0,0:18:20.33,0:18:21.25,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:18:21.83,0:18:24.67,general text,,0,0,0,,Ang palasyo ay parang labirint. Halos hindi ko mahanap ang aking paraan
Dialogue: 0,0:18:25.38,0:18:26.38,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:18:26.92,0:18:29.84,general text,,0,0,0,,- May nangyari ba?\N- Nandito si Deputy Jin Mu
Dialogue: 0,0:18:50.65,0:18:54.70,general text,,0,0,0,,Saan ka nagpunta mag-isa, walang bantay?
Dialogue: 0,0:18:55.36,0:18:58.58,general text,,0,0,0,,Nahihiya ako na hindi napapansin ang aking pag-atake. Iwanan na natin ito
Dialogue: 0,0:19:01.00,0:19:03.00,general text,,0,0,0,,Nakita ko ang Kanyang Kamahalan
Dialogue: 0,0:19:03.71,0:19:05.67,pangkalahatang teksto,,0,0,0,, Binanggit niyang muli ang bituin ng Hari
Dialogue: 0,0:19:07.59,0:19:09.00,general text,,0,0,0,,Nahuhumaling siya sa kanya
Dialogue: 0,0:19:09.09,0:19:12.72,pangkalahatang teksto,,0,0,0,,Bigyan siya ng kahit man lang pekeng tablet na may ganitong bituin
Dialogue: 0,0:19:12.80,0:19:15.14,pangkalahatang teksto,,0,0,0,,Pagkatapos ay kailangan niyang hanapin ang lahat ng ipinanganak sa araw na iyon
Dialogue: 0,0:19:15.23,0:19:16.73,pangkalahatang teksto,,0,0,0,,at pumatay
Dialogue: 0,0:19:18.44,0:19:19.65,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:19:20.15,0:19:22.07,pangkalahatang teksto,,0,0,0,,Ito ay maaaring isang bayani
Dialogue: 0,0:19:22.15,0:19:25.07,general text,,0,0,0,,hawig to Master So Kyung, at hindi traydor at conspirator
Dialogue: 0,0:19:25.15,0:19:27.66,general text,,0,0,0,,Sabi nila, iniligtas ni Seo Kyung ang mundo gamit ang isang ice stone
Dialogue: 0,0:19:27.74,0:19:28.70,pangkalahatang teksto,,0,0,0,,Ngunit hindi ganito
Dialogue: 0,0:19:30.49,0:19:33.00,pangkalahatang teksto,,0,0,0,,Sa pangkalahatan, kinokontrol niya ang mundo, ipinagbabawal ang lahat
Dialogue: 0,0:19:33.08,0:19:34.62,pangkalahatang teksto,,0,0,0,,gamitin ang napakalaking kapangyarihang ito
Dialogue: 0,0:19:35.62,0:19:38.42,pangkalahatang teksto,,0,0,0,,Ang batong ito ay lumilikha ng dark magic, at ito ay mapanganib
Dialogue: 0,0:19:38.50,0:19:40.67,pangkalahatang teksto,,0,0,0,,Kaya naisip ni Sosnovy Bor
Dialogue: 0,0:19:41.55,0:19:45.05,pangkalahatang teksto,,0,0,0,,Ang batong yelo ay maaaring magdala ng kawalang-hanggan sa ating buhay
Dialogue: 0,0:19:46.26,0:19:47.76,general text,,0,0,0,,Tumigil na tayo sa pagtanda at pagkamatay
Dialogue: 0,0:19:47.84,0:19:51.51,pangkalahatang teksto,,0,0,0,,Ang Kanyang kapangyarihan ay gagawin tayong bata at maganda magpakailanman
Dialogue: 0,0:19:51.60,0:19:53.31,pangkalahatang teksto,,0,0,0,,Ang pinag-uusapan mo ba ay ang alchemy ng mga kaluluwa?
Dialogue: 0,0:19:53.39,0:19:55.31,pangkalahatang teksto,,0,0,0,,Pinagbawalan ni Sosnovy Bor ang magic na ito
Dialogue: 0,0:19:55.39,0:19:56.94,pangkalahatang teksto,,0,0,0,,At kung inalis ang pagbabawal
Dialogue: 0,0:19:57.02,0:19:58.94,pangkalahatang teksto,,0,0,0,,at pinapayagan kang gamitin ang batong yelo?
Dialogue: 0,0:19:59.02,0:20:00.11,pangkalahatang teksto,,0,0,0,,Kamahalan,
Dialogue: 0,0:20:00.90,0:20:02.61,general text,,0,0,0,,ano kaya ang mangyayari, ano sa tingin mo?
Dialogue: 0,0:20:06.03,0:20:09.49,pangkalahatang teksto,,0,0,0,,Ang may bato ay mabubuhay magpakailanman
Dialogue: 0,0:20:10.70,0:20:13.83,pangkalahatang teksto,,0,0,0,,Ngunit mapanganib na magbigay ng ganoong kapangyarihan sa lahat
Dialogue: 0,0:20:13.91,0:20:15.79,pangkalahatang teksto,,0,0,0,,Hindi para sa lahat
Dialogue: 0,0:20:15.87,0:20:18.62,pangkalahatang teksto,,0,0,0,,Maglalabas kami ng isang kautusan ayon sa kung saan ang mga napili lamang,
Dialogue: 0,0:20:18.71,0:20:20.96,pangkalahatang teksto,,0,0,0,,paano, halimbawa, magagamit mo ang magic na ito
Dialogue: 0,0:20:24.80,0:20:26.63,pangkalahatang teksto,,0,0,0,,Kung gayon kailangan mong hanapin ang bato,
Dialogue: 0,0:20:26.72,0:20:29.34,pangkalahatang teksto,,0,0,0,,upang gawin itong posible
Dialogue: 0,0:20:30.01,0:20:32.81,general text,,0,0,0,,Jin Bu Young, ang nawawalang anak ni Jinyoung, ay bumalik
Dialogue: 0,0:20:32.89,0:20:34.90,general text,,0,0,0,,- Jinyoewon?\N- Babae,
Dialogue: 0,0:20:34.98,0:20:39.20,pangkalahatang teksto,,0,0,0,,na tumulong kay Master Seo Kyung na mahanap ang bato, ay ang unang kabanata ng Jinyoewon
Dialogue: 0,0:20:39.28,0:20:41.49,pangkalahatang teksto,,0,0,0,,At napakalakas ni Jin Bu Young,
Dialogue: 0,0:20:41.57,0:20:43.37,pangkalahatang teksto,,0,0,0,,tulad ng unang kabanata
Dialogue: 0,0:20:48.21,0:20:51.13,pangkalahatang teksto,,0,0,0,,Kung lumitaw ang batong yelo, tulad ng dalawang daang taon na ang nakalipas,
Dialogue: 0,0:20:51.21,0:20:53.04,pangkalahatang teksto,,0,0,0,,manamana ni Jinyeowon
Dialogue: 0,0:20:54.25,0:20:56.30,pangkalahatang teksto,,0,0,0,, mahahanap ito kaagad
Dialogue: 0,0:21:00.26,0:21:02.55,italics,,0,0,0,,Buhay na buhay ang panganay na anak ni Jinyeowon
Dialogue: 0,0:21:03.05,0:21:05.93,general text,,0,0,0,,Para siyang ordinaryong bulag na babae
Dialogue: 0,0:21:06.64,0:21:08.43,pangkalahatang teksto,,0,0,0,,Akala ko siya ay hindi kapani-paniwalang malakas
Dialogue: 0,0:21:09.27,0:21:10.69,general text,,0,0,0,,Bakit siya nawalan ng lakas?
Dialogue: 0,0:21:10.77,0:21:12.15,pangkalahatang teksto,,0,0,0,,Bagaman,
Dialogue: 0,0:21:12.23,0:21:15.23,general text,,0,0,0,,hindi siya makahanap ng bahay sa loob ng sampung taon, kaya posible
Dialogue: 0,0:21:18.15,0:21:21.74,general text,,0,0,0,,Dinala siya ni Jin Mu, hindi malinis ang lahat doon
Dialogue: 0,0:21:21.82,0:21:23.41,general text,,0,0,0,,May napansin ka bang kakaiba?
Dialogue: 0,0:21:26.83,0:21:29.54,general text,,0,0,0,,Minsan ko siyang nasagasaan sa bahay niyo
Dialogue: 0,0:21:31.54,0:21:34.29,italics,,0,0,0,,Naalala ko kasi tinulungan ko siyang buhatin ang saklay niya.
Dialogue: 0,0:21:36.59,0:21:37.92,general text,,0,0,0,,Sa bahay ko?
Dialogue: 0,0:21:38.01,0:21:40.26,general text,,0,0,0,,Wala akong napansing kakaiba sa kanya noon
Dialogue: 0,0:21:40.34,0:21:41.97,pangkalahatang teksto,,0,0,0,,Ngayon din
Dialogue: 0,0:21:45.76,0:21:46.72,pangkalahatang teksto,,0,0,0,,Payong...
Dialogue: 0,0:21:50.43,0:21:52.44,general text,,0,0,0,,May payong siya
Dialogue: 0,0:21:52.52,0:21:54.45,general text,,0,0,0,,Nakita ko na ito somewhere
Dialogue: 0,0:21:55.03,0:21:57.91,pangkalahatang teksto,,0,0,0,,Payong? Ano ang espesyal sa isang payong?
Dialogue: 0,0:21:57.99,0:21:59.04,pangkalahatang teksto,,0,0,0,,Hindi iyon ang punto
Dialogue: 0,0:21:59.12,0:22:01.91,pangkalahatang teksto,,0,0,0,,Ang payong na ito ay gawa sa de-kalidad na balat ng tupa at kawayan
Dialogue: 0,0:22:02.71,0:22:04.21,pangkalahatang text,,0,0,0,,Napakamahal noon
Dialogue: 0,0:22:05.42,0:22:07.67,general text,,0,0,0,,- Paano niya nakuha?\N{\i1}- Ano?{\i0}
Dialogue: 0,0:22:07.75,0:22:09.34,pangkalahatang teksto,,0,0,0,,Sino ang nagmamay-ari nito dati?
Dialogue: 0,0:22:11.59,0:22:12.63,italics,,0,0,0,,Payong?
Dialogue: 0,0:22:13.22,0:22:15.01,pangkalahatang teksto,,0,0,0,,Wala ako nito
Dialogue: 0,0:22:15.59,0:22:17.05,pangkalahatang teksto,,0,0,0,,Ibinigay sa isang tao
Dialogue: 0,0:22:17.14,0:22:18.47,pangkalahatang teksto,,0,0,0,,Para kanino at saan?
Dialogue: 0,0:22:19.27,0:22:20.98,general text,,0,0,0,,Hindi ko sinasadya
Dialogue: 0,0:22:21.06,0:22:22.89,general text,,0,0,0,,Paumanhin, binili mo ito para sa akin
Dialogue: 0,0:22:23.52,0:22:25.10,pangkalahatang text,,0,0,0,,Hindi ko kailangan ng sorry
Dialogue: 0,0:22:25.60,0:22:27.52,general text,,0,0,0,,Binigay mo ba sa babae?
Dialogue: 0,0:22:28.15,0:22:30.15,pangkalahatang teksto,,0,0,0,,Oo, sa isang babae
Dialogue: 0,0:22:30.23,0:22:31.24,general text,,0,0,0,,Huwag lang magagalit
Dialogue: 0,0:22:32.95,0:22:35.24,general text,,0,0,0,,Bakit ako magagalit?
Dialogue: 0,0:22:35.32,0:22:36.74,general text,,0,0,0,,Sino ang babaeng ito?
Dialogue: 0,0:22:37.32,0:22:38.33,pangkalahatang teksto,,0,0,0,,Huh?
Dialogue: 0,0:22:38.41,0:22:40.87,pangkalahatang teksto,,0,0,0,,Sagutin na! Nakakapagod maghintay
Dialogue: 0,0:22:40.95,0:22:42.79,general text,,0,0,0,,Kanino mo binigay?
Dialogue: 0,0:22:46.29,0:22:47.84,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:22:47.92,0:22:50.34,pangkalahatang teksto,,0,0,0,,Hindi ito ang tamang paraan ng pagtatanong. Yul...
Dialogue: 0,0:22:51.71,0:22:53.92,general text,,0,0,0,,Namutla siya sa takot
Dialogue: 0,0:22:54.01,0:22:56.30,general text,,0,0,0,,Pagalitan mo siya na parang asawang nahuli siyang niloloko.
Dialogue: 0,0:22:56.39,0:22:59.05,general text,,0,0,0,,Hindi ka pwedeng magtanong sa ganyang tono... demanding
Dialogue: 0,0:22:59.89,0:23:01.72,italics,,0,0,0,,Panoorin at tandaan. Yul,
Dialogue: 0,0:23:01.81,0:23:04.69,general text,,0,0,0,,binigay mo ba yung payong sa bulag na babae?
Dialogue: 0,0:23:05.44,0:23:06.44,pangkalahatang teksto,,0,0,0,,Paano mo nalaman?
Dialogue: 0,0:23:07.73,0:23:10.69,general text,,0,0,0,,Siguro ito si So Yi, na nabanggit na dati?
Dialogue: 0,0:23:11.98,0:23:14.16,general text,,0,0,0,,Oo, binigay ko sa kanya ang payong
Dialogue: 0,0:23:14.25,0:23:15.37,italics,,0,0,0,,Ano?
Dialogue: 0,0:23:16.42,0:23:17.67,general text,,0,0,0,,Ngayon ay nasa Jinyeowon ako
Dialogue: 0,0:23:18.54,0:23:20.67,general text,,0,0,0,,Doon ko nakita ang nawawala nilang anak na si Jin Bu Young
Dialogue: 0,0:23:20.75,0:23:22.34,pangkalahatang teksto,,0,0,0,,Siya ay bulag,
Dialogue: 0,0:23:22.42,0:23:24.67,pangkalahatang teksto,,0,0,0,,ngunit sa halip na saklay ay mayroon siyang payong
Dialogue: 0,0:23:25.59,0:23:26.76,general text,,0,0,0,,Yung payong din?
Dialogue: 0,0:23:30.30,0:23:31.18,italics,,0,0,0,,Guys!
Dialogue: 0,0:23:32.43,0:23:34.06,italics,,0,0,0,,Narinig mo ba ang balita?
Dialogue: 0,0:23:34.14,0:23:37.44,pangkalahatang teksto,,0,0,0,,Nahanap na ang nakatatandang kapatid na si Cho Young. Nahanap nila si Jin Bu Young!
Dialogue: 0,0:23:39.23,0:23:40.27,pangkalahatang teksto,,0,0,0,,Huh?
Dialogue: 0,0:23:40.98,0:23:42.73,pangkalahatang teksto,,0,0,0,,Ano itong mga maasim na mukha?
Dialogue: 0,0:23:43.32,0:23:44.78,pangkalahatang teksto,,0,0,0,,Ano ang pinag-uusapan mo?
Dialogue: 0,0:23:44.86,0:23:47.40,general text,,0,0,0,,About So I, na hinahanap namin
Dialogue: 0,0:23:48.03,0:23:48.86,general text,,0,0,0,,So ako?
Dialogue: 0,0:23:49.91,0:23:51.12,general text,,0,0,0,,Scanmer na yan?
Dialogue: 0,0:23:51.70,0:23:52.66,general text,,0,0,0,,Nahanap mo ba siya?
Dialogue: 0,0:23:52.74,0:23:55.04,pangkalahatang teksto,,0,0,0,,Jin Bu Young, dala ni Jin Mu,
Dialogue: 0,0:23:55.91,0:23:57.12,general text,,0,0,0,,ito ay isang scammer na si So Yi
Dialogue: 0,0:23:57.92,0:23:59.79,pangkalahatang teksto,,0,0,0,,Malamang, lahat ng taong iyon ay pinatay,
Dialogue: 0,0:23:59.88,0:24:01.79,pangkalahatang text,,0,0,0,,upang itago kung sino siya
Dialogue: 0,0:24:17.52,0:24:18.73,pangkalahatang teksto,,0,0,0,,Jin Bu Young
Dialogue: 0,0:24:22.73,0:24:25.15,pangkalahatang teksto,,0,0,0,,Ako ang magiging eksaktong kopya mo
Dialogue: 0,0:24:42.76,0:24:45.14,pangkalahatang teksto,,0,0,0,,Ang headband ay kapareho ng kay Moo Deok
Dialogue: 0,0:24:48.31,0:24:49.98,general text,,0,0,0,,Bakit siya nandito?
Dialogue: 0,0:24:51.90,0:24:53.02,italics,,0,0,0,,Boo Young!
Dialogue: 0,0:25:01.20,0:25:02.36,general text,,0,0,0,,Nalaman mo...
Dialogue: 0,0:25:03.49,0:25:04.53,pangkalahatang text,,0,0,0,,ang bandage na ito?
Dialogue: 0,0:25:11.75,0:25:13.79,italics,,0,0,0,,Jinyowon Coat of Arms
Dialogue: 0,0:25:13.88,0:25:17.13,general text,,0,0,0,,Burdahan ko lahat ng headbands
Dialogue: 0,0:25:17.88,0:25:20.05,general text,,0,0,0,,Nag-aalala ako na baka may mangyari sa iyo,
Dialogue: 0,0:25:20.13,0:25:23.09,general text,,0,0,0,,dahil bulag ka
Dialogue: 0,0:25:23.18,0:25:27.51,general text,,0,0,0,,Kaya pinasuot kita ng headband na may crest ng pamilya natin
Dialogue: 0,0:25:30.06,0:25:31.31,general text,,0,0,0,,Ganun ba?
Dialogue: 0,0:25:35.56,0:25:37.90,mga alaala,,0,0,0,,Luma na ang benda, ngunit sutla
Dialogue: 0,0:25:38.57,0:25:41.28,memories,,0,0,0,,Malamang mayaman ang tunay mong magulang
Dialogue: 0,0:25:43.78,0:25:45.78,memories,,0,0,0,,Bulag ka ba talaga?
Dialogue: 0,0:25:46.70,0:25:48.70,mga alaala,,0,0,0,,Nakikita ko lahat, ngunit hindi ko mahanap ang stream
Dialogue: 0,0:25:48.79,0:25:50.91,mga alaala,,0,0,0,,Ngunit para sa iyo hindi ito mahirap
Dialogue: 0,0:25:53.55,0:25:58.22,italics,,0,0,0,,Bu Young, mula pagkabata mayroon kang kakayahang makadama ng enerhiya
Dialogue: 0,0:25:58.93,0:26:03.02,pangkalahatang teksto,,0,0,0,,Nakahanap ka ng mga bagay nang mas mabilis kaysa sa mga nakikitang tao
Dialogue: 0,0:26:03.60,0:26:06.44,general text,,0,0,0,,Hindi nalilito sa kalsada, hindi naligaw
Dialogue: 0,0:26:07.73,0:26:10.15,behind the scenes,,0,0,0,,Like Moo Dok sa Sari Village
Dialogue: 0,0:26:10.23,0:26:13.20,behind the scenes,,0,0,0,,Madali niyang nahanap ang mga bagay at laging alam kung saan pupunta
Dialogue: 0,0:26:13.28,0:26:15.11,pangkalahatang text,,0,0,0,,Parehas lang ang suot mong benda...
Dialogue: 0,0:26:16.74,0:26:19.58,general text,,0,0,0,,yung araw na nawala ka
Dialogue: 0,0:26:20.74,0:26:24.21,general text,,0,0,0,,Kaya umaasa akong gagamitin mo ito,
Dialogue: 0,0:26:25.58,0:26:26.92,pangkalahatang text,,0,0,0,,upang mahanap ang daan pauwi
Dialogue: 0,0:26:28.04,0:26:30.38,offscreen,,0,0,0,,Palagi niyang tinatrato ang benda na ito nang may kaba
Dialogue: 0,0:26:30.46,0:26:32.92,voiceover,,0,0,0,,Sabi niya ito lang daw ang paraan para makahanap ng bahay
Dialogue: 0,0:26:34.68,0:26:36.47,pangkalahatang teksto,,0,0,0,,Kung nai-save mo ito,
Dialogue: 0,0:26:37.85,0:26:40.93,general text,,0,0,0,,makikilala kita kaagad
Dialogue: 0,0:26:42.02,0:26:45.48,behind the scenes,,0,0,0,,Itong babaeng ito ang nagpatahi ng headband na ninakaw ko kay Moo Deok
Dialogue: 0,0:26:46.60,0:26:48.19,italics,,0,0,0,,Maraming salamat,
Dialogue: 0,0:26:48.27,0:26:52.07,pangkalahatang teksto,,0,0,0,,na bumalik siya nang ligtas at maayos, Boo Young
Dialogue: 0,0:26:58.95,0:27:01.54,behind the scenes,,0,0,0,,Ang totoong Boo Young, ang anak ng babaeng ito...
Dialogue: 0,0:27:02.29,0:27:04.37,behind the scenes,,0,0,0,,kaibigan kong si Moo Deok
Dialogue: 0,0:27:27.45,0:27:28.66,mga alaala,,0,0,0,,Boo Young!
Dialogue: 0,0:27:31.58,0:27:35.08,offscreen,,0,0,0,,Bumukas ba ang pinto ni Jinyoewon dahil sa kanya?
Dialogue: 0,0:27:37.21,0:27:38.71,pangkalahatang teksto,,0,0,0,,Si Moo Deok ang tunay na Jin Bu Young
Dialogue: 0,0:27:40.25,0:27:42.71,general text,,0,0,0,,Ano ang mangyayari sa akin kapag nalaman niya ito?
Dialogue: 0,0:27:45.55,0:27:47.01,general text,,0,0,0,,Papatayin ba nila ako?
Dialogue: 0,0:27:52.97,0:27:54.22,italics,,0,0,0,,Onnie
Dialogue: 0,0:27:55.43,0:27:56.93,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:27:57.60,0:27:59.02,general text,,0,0,0,,Gusto mo bang buksan muli ang mga pinto?
Dialogue: 0,0:27:59.10,0:28:00.27,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:28:03.40,0:28:06.61,general text,,0,0,0,,Hindi lang ako makapaniwala na ikaw talaga ang pamilya ko
Dialogue: 0,0:28:07.82,0:28:09.36,pangkalahatang text,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:28:10.03,0:28:11.20,pangkalahatang teksto,,0,0,0,,Maniwala ka
Dialogue: 0,0:28:11.28,0:28:14.20,general text,,0,0,0,,Nakita naming lahat kung paano mo binuksan ang mga pinto
Dialogue: 0,0:28:17.87,0:28:21.88,general text,,0,0,0,,Yung babaeng kasama mo kagabi...
Dialogue: 0,0:28:21.96,0:28:23.09,general text,,0,0,0,,Si Moo Deok ba ang pinag-uusapan mo?
Dialogue: 0,0:28:23.84,0:28:25.30,pangkalahatang teksto,,0,0,0,,Hindi niya pinaglilingkuran si Jinyoewon
Dialogue: 0,0:28:25.38,0:28:28.63,general text,,0,0,0,,Madalas ba siyang pumunta dito? Mukhang kilala rin siya ni nanay
Dialogue: 0,0:28:28.72,0:28:30.43,pangkalahatang teksto,,0,0,0,,Hindi siya gusto ni Inay
Dialogue: 0,0:28:30.51,0:28:32.60,general text,,0,0,0,,You see, she's nothing but problems
Dialogue: 0,0:28:32.69,0:28:33.98,general text,,0,0,0,,Talaga?
Dialogue: 0,0:28:36.28,0:28:37.61,pangkalahatang teksto,,0,0,0,,Malamang kaya...
Dialogue: 0,0:28:37.69,0:28:39.70,pangkalahatang text,,0,0,0,,Nakaramdam ako ng negatibong enerhiya
Dialogue: 0,0:28:40.74,0:28:43.20,pangkalahatang teksto,,0,0,0,,Negatibong enerhiya?
Dialogue: 0,0:28:43.28,0:28:47.20,pangkalahatang teksto,,0,0,0,,Ang lakas na naramdaman ko ay madilim at hindi kasiya-siya
Dialogue: 0,0:28:48.08,0:28:51.08,pangkalahatang teksto,,0,0,0,,Layuan ang mga taong may ganoong uri ng enerhiya
Dialogue: 0,0:28:51.67,0:28:54.79,pangkalahatang teksto,,0,0,0,,Hindi siya masamang tao
Dialogue: 0,0:28:55.88,0:28:57.21,italics,,0,0,0,,Nandito ka na, girls
Dialogue: 0,0:28:59.38,0:29:00.38,pangkalahatang teksto,,0,0,0,,Tatay
Dialogue: 0,0:29:00.47,0:29:01.38,pangkalahatang teksto,,0,0,0,,Ama
Dialogue: 0,0:29:02.22,0:29:03.93,general text,,0,0,0,,Cho Young, hinahanap ka ni nanay
Dialogue: 0,0:29:04.51,0:29:05.60,pangkalahatang teksto,,0,0,0,,Ina?
Dialogue: 0,0:29:07.01,0:29:09.10,general text,,0,0,0,,Akala ko hindi na siya galit
Dialogue: 0,0:29:10.48,0:29:12.98,general text,,0,0,0,,- Alis na ako\N- Okay
Dialogue: 0,0:29:17.98,0:29:20.53,general text,,0,0,0,,Sabi ko sayong layuan mo ang anak ko
Dialogue: 0,0:29:21.28,0:29:22.40,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:29:23.32,0:29:25.82,general text,,0,0,0,,Sa huling araw ng buwan hinihintay nila tayo sa Jeonbugwan
Dialogue: 0,0:29:25.91,0:29:27.91,general text,,0,0,0,,- Humanda\N- Okay
Dialogue: 0,0:29:29.33,0:29:30.58,pangkalahatang teksto,,0,0,0,,Ama, maghintay
Dialogue: 0,0:29:33.12,0:29:34.37,general text,,0,0,0,,Sigurado ka ba,
Dialogue: 0,0:29:37.00,0:29:39.46,general text,,0,0,0,,na patay na si Jin Bu Young?
Dialogue: 0,0:29:40.92,0:29:43.34,general text,,0,0,0,,Ano ang mangyayari sa akin kung babalik siya?
Dialogue: 0,0:29:44.59,0:29:46.55,pangkalahatang teksto,,0,0,0,,Huwag istorbohin ang iyong ulo sa mga ganitong kaisipan
Dialogue: 0,0:29:48.97,0:29:50.14,pangkalahatang teksto,,0,0,0,,Patay na siya
Dialogue: 0,0:29:59.70,0:30:01.70,general text,,0,0,0,,Kahit na si Moo Deok ang tunay nilang anak,
Dialogue: 0,0:30:01.79,0:30:03.46,pangkalahatang teksto,,0,0,0,,wala sa kanila ang nakakaalam tungkol dito
Dialogue: 0,0:30:04.62,0:30:06.54,pangkalahatang text,,0,0,0,,Hindi natin sila hahayaang malaman
Dialogue: 0,0:30:09.92,0:30:11.38,pangkalahatang teksto,,0,0,0,,Ako si Jin Bu Young
Dialogue: 0,0:30:23.56,0:30:25.14,pangkalahatang text,,0,0,0,,Buong gabi ko itong iniisip
Dialogue: 0,0:30:25.77,0:30:28.06,pangkalahatang teksto,,0,0,0,,Ito ay maaaring malagay sa panganib ang aking pag-ibig,
Dialogue: 0,0:30:28.15,0:30:31.65,general text,,0,0,0,,pero tutuparin ko ang aking tungkulin bilang tagapagmana ni Sosnovy Bor
Dialogue: 0,0:30:31.73,0:30:34.28,general text,,0,0,0,,- Pupunta ako at sasabihin ko sa tito ko ang lahat\N- Hindi
Dialogue: 0,0:30:34.36,0:30:37.66,general text,,0,0,0,,Naalala mo ba kung paano siya nag-away ni Mrs. Jin?
Dialogue: 0,0:30:37.74,0:30:39.53,pangkalahatang teksto,,0,0,0,,Kung wala tayong ebidensya
Dialogue: 0,0:30:39.62,0:30:42.24,pangkalahatang teksto,,0,0,0,,ipahayag natin na ang kanyang anak na babae ay isang huwad na Bu Young at isang mamamatay-tao,
Dialogue: 0,0:30:42.74,0:30:45.00,pangkalahatang teksto,,0,0,0,,ang mga relasyon kay Jinyeowon ay ganap na masisira
Dialogue: 0,0:30:46.21,0:30:47.33,general text,,0,0,0,,Tama ka
Dialogue: 0,0:30:47.42,0:30:51.34,pangkalahatang teksto,,0,0,0,,Kung lalabas ang katotohanan, sumiklab ang digmaan sa pagitan ni Jin Mu at Jinyowon
Dialogue: 0,0:30:52.00,0:30:54.51,pangkalahatang text,,0,0,0,,Hindi kami makikialam hangga't hindi namin nalaman ang lahat
Dialogue: 0,0:30:56.47,0:30:59.05,general text,,0,0,0,,Pero bakit dinala nila ang manloloko...
Dialogue: 0,0:30:59.14,0:31:00.85,general text,,0,0,0,,at sinabi nila na isa siyang heiress?
Dialogue: 0,0:31:00.93,0:31:03.02,general text,,0,0,0,,Dahil kailangan nila ang lalaki nila sa Jinyeowon
Dialogue: 0,0:31:03.93,0:31:05.06,general text,,0,0,0,,Paano kung mahuli siya?
Dialogue: 0,0:31:05.14,0:31:07.14,pangkalahatang teksto,,0,0,0,,Kinikilala ng ina ang kanyang anak
Dialogue: 0,0:31:07.23,0:31:10.66,general text,,0,0,0,,Sa huli, mahuhuli siya. Bakit kumuha ng ganoong panganib?
Dialogue: 0,0:31:11.45,0:31:13.20,general text,,0,0,0,,Dahil para sa kanya wala lang
Dialogue: 0,0:31:15.45,0:31:17.04,pangkalahatang text,,0,0,0,,Si Jin Mu siguro ay may something,
Dialogue: 0,0:31:17.12,0:31:19.92,pangkalahatang teksto,,0,0,0,,na hindi papayag na gawin ni Jin Ho Kyung ang anumang bagay,
Dialogue: 0,0:31:21.08,0:31:23.17,pangkalahatang teksto,,0,0,0,,kahit na kinikilala nito ang pagpapalit
Dialogue: 0,0:31:30.93,0:31:32.51,offscreen,,0,0,0,,May mali sa kanya
Dialogue: 0,0:31:33.18,0:31:38.06,voiceover,,0,0,0,,Siya ay may parehong peklat at nunal na mayroon si Boo Young
Dialogue: 0,0:31:39.44,0:31:41.02,behind the scenes,,0,0,0,,Pero iba ang hugis ng tenga
Dialogue: 0,0:31:42.77,0:31:45.23,offscreen,,0,0,0,,Hindi nagbabago ang mga tainga
Dialogue: 0,0:31:47.74,0:31:49.74,pangkalahatang teksto,,0,0,0,,Ang aking memorya ay nabigo sa akin?
Dialogue: 0,0:31:51.87,0:31:53.08,pangkalahatang teksto,,0,0,0,,Ate
Dialogue: 0,0:32:11.13,0:32:12.84,pangkalahatang teksto,,0,0,0,,Para sa tulong sa paghahanap kay Boo Young
Dialogue: 0,0:32:13.39,0:32:16.52,general text,,0,0,0,,humingi ka ng permiso na pumasok sa Jinyeowon, nagulat ako
Dialogue: 0,0:32:17.18,0:32:19.98,general text,,0,0,0,,Hindi ako pinayagan dito,
Dialogue: 0,0:32:20.06,0:32:22.23,general text,,0,0,0,,kahit miyembro ako ng Jin family
Dialogue: 0,0:32:22.31,0:32:24.56,pangkalahatang teksto,,0,0,0,,pinarusahan kita ng mabigat sa bawat pagkakataon,
Dialogue: 0,0:32:25.40,0:32:27.15,general text,,0,0,0,,nung nilapitan mo si Jinyoewon
Dialogue: 0,0:32:28.90,0:32:30.79,general text,,0,0,0,,I was really too strict with you
Dialogue: 0,0:32:31.54,0:32:34.21,general text,,0,0,0,,kinasusuklaman kita, bagama't lumitaw ka dahil sa pakikipagsapalaran ng iyong ama
Dialogue: 0,0:32:34.29,0:32:36.67,pangkalahatang teksto,,0,0,0,, Hinamak para sa lahat ng iyong masigasig na pagtatangka
Dialogue: 0,0:32:36.75,0:32:38.67,pangkalahatang teksto,,0,0,0,,pakiusap at pakiusap ang lahat sa paligid
Dialogue: 0,0:32:39.42,0:32:40.76,pangkalahatang teksto,,0,0,0,,Patawarin mo ako
Dialogue: 0,0:32:44.55,0:32:46.30,pangkalahatang teksto,,0,0,0,,Ang lahat ng ito ay nakaraan na
Dialogue: 0,0:33:04.41,0:33:06.16,pangkalahatang teksto,,0,0,0,,Ngayon si Boo Young ay bumalik
Dialogue: 0,0:33:09.24,0:33:12.25,pangkalahatang teksto,,0,0,0,,Mabilis na ideklara siyang tagapagmana mo
Dialogue: 0,0:33:14.08,0:33:17.79,general text,,0,0,0,,Appoint Boo Young as the next head of Jinyoung?
Dialogue: 0,0:33:18.30,0:33:22.80,pangkalahatang teksto,,0,0,0,,Ang bagong kabanata ay muling magbibigay buhay kay Jinyeowon
Dialogue: 0,0:33:22.88,0:33:24.01,pangkalahatang teksto,,0,0,0,,At pagkatapos
Dialogue: 0,0:33:24.09,0:33:28.10,general text,,0,0,0,,Gagawin kong crown princess si Cho Yeon
Dialogue: 0,0:33:32.31,0:33:33.69,pangkalahatang teksto,,0,0,0,,Hindi kailangang magmadali
Dialogue: 0,0:33:33.77,0:33:35.98,pangkalahatang teksto,,0,0,0,,Hindi pa bumabalik ang alaala ni Boo Young
Dialogue: 0,0:33:36.69,0:33:39.15,general text,,0,0,0,,At nakontrol ko pa rin si Jinyeowon
Dialogue: 0,0:33:39.23,0:33:43.78,pangkalahatang teksto,,0,0,0,,Hindi sapat ang iyong lakas upang mahanap ang batong yelo
Dialogue: 0,0:33:46.03,0:33:48.16,pangkalahatang teksto,,0,0,0,,Nang dinala mo si Boo Young sa ilalim ng iyong puso,
Dialogue: 0,0:33:48.24,0:33:51.17,general text,,0,0,0,,kinuha mo ang bato kay Jinyoung at ibinigay kay Chang Gang...
Dialogue: 0,0:33:51.80,0:33:53.13,pangkalahatang teksto,,0,0,0,,upang iligtas ang kanyang buhay
Dialogue: 0,0:33:55.38,0:33:57.93,pangkalahatang teksto,,0,0,0,,Paano mo nalaman ang tungkol dito?
Dialogue: 0,0:33:58.01,0:33:59.22,pangkalahatang teksto,,0,0,0,,Hindi kailangang matakot
Dialogue: 0,0:33:59.30,0:34:01.56,pangkalahatang teksto,,0,0,0,,Hindi ko sinusubukan na hatulan ka ng mga krimen
Dialogue: 0,0:34:02.93,0:34:05.98,pangkalahatang text,,0,0,0,,Sigurado akong pinilit ni Chang Gang na selyuhan ang bato sa ibang lugar
Dialogue: 0,0:34:06.06,0:34:07.60,general text,,0,0,0,,Hindi niya ibinalik sa iyo
Dialogue: 0,0:34:08.52,0:34:11.15,general text,,0,0,0,,Alam mo ba kung saan siya nagtago...
Dialogue: 0,0:34:11.23,0:34:12.90,pangkalahatang text,,0,0,0,,ice stone mula kay Jinyeowon?
Dialogue: 0,0:34:12.98,0:34:14.69,general text,,0,0,0,,Nandito na ang heiress ni Jinyeowon,
Dialogue: 0,0:34:14.78,0:34:18.91,general text,,0,0,0,,kaya ibabalik ko ang bato kung saan ito nararapat
Dialogue: 0,0:34:20.03,0:34:22.45,pangkalahatang teksto,,0,0,0,,Jin Mu, ikaw...
Dialogue: 0,0:34:22.54,0:34:23.45,italics,,0,0,0,,Ate,
Dialogue: 0,0:34:23.54,0:34:25.37,general text,,0,0,0,,sabi ko lang ibabalik ko
Dialogue: 0,0:34:26.12,0:34:28.08,pangkalahatang teksto,,0,0,0,,Huwag maghanap ng huli
Dialogue: 0,0:34:28.17,0:34:30.88,pangkalahatang teksto,,0,0,0,,Isaalang-alang ito bilang isang regalo na kasama ni Boo Young
Dialogue: 0,0:34:30.96,0:34:34.59,pangkalahatang teksto,,0,0,0,,Ang kailangan lang ay tanggapin ito nang may pasasalamat
Dialogue: 0,0:34:54.15,0:34:56.49,general text,,0,0,0,,Parang nagtatanong ka
Dialogue: 0,0:34:57.07,0:35:01.07,general text,,0,0,0,,blindly admit Boo Young kung gusto kong makuha ang bato
Dialogue: 0,0:35:01.16,0:35:04.62,pangkalahatang teksto,,0,0,0,,Alisin ang mga pagdududa at pagdududa, pagkatapos ay makikita mo ang lahat
Dialogue: 0,0:35:05.70,0:35:09.12,pangkalahatang teksto,,0,0,0,,At ang bato at ang nawawalang anak na babae
Dialogue: 0,0:35:10.84,0:35:12.47,pangkalahatang teksto,,0,0,0,,Ano ang gusto mo?
Dialogue: 0,0:35:16.60,0:35:19.02,pangkalahatang teksto,,0,0,0,,Upang protektahan ang yelong bato,
Dialogue: 0,0:35:19.64,0:35:21.77,pangkalahatang teksto,,0,0,0,,crush Sosnovy Bor
Dialogue: 0,0:35:23.48,0:35:25.86,general text,,0,0,0,,Gusto mo bang sirain ko si Sosnovy Bor?
Dialogue: 0,0:35:25.94,0:35:27.57,pangkalahatang teksto,,0,0,0,,Ang Pagbagsak ni Sosnovy Bor
Dialogue: 0,0:35:28.61,0:35:32.16,pangkalahatang teksto,,0,0,0,, ay magbibigay-daan sa amin upang sakupin ang buong kapangyarihan ng batong yelo
Dialogue: 0,0:35:48.84,0:35:50.84,memories italics,,0,0,0,,Ang pinag-uusapan mo ba ay ang alchemy ng mga kaluluwa?
Dialogue: 0,0:35:50.93,0:35:53.01,mga alaala,,0,0,0,,Pine Forest pinagbawalan ang magic na ito
Dialogue: 0,0:35:54.22,0:35:55.72,mga alaala,,0,0,0,,At kung inalis ang pagbabawal
Dialogue: 0,0:35:55.81,0:35:57.81,mga alaala,,0,0,0,,at pinapayagan kang gamitin ang yelong bato?
Dialogue: 0,0:35:57.89,0:35:59.02,mga alaala,,0,0,0,,Kamahalan,
Dialogue: 0,0:35:59.77,0:36:01.60,mga alaala,,0,0,0,,ano kaya ang mangyayari, ano sa tingin mo?
Dialogue: 0,0:36:04.48,0:36:06.32,pangkalahatang teksto,,0,0,0,,Buhay na walang hanggan?
Dialogue: 0,0:36:13.03,0:36:15.45,general text,,0,0,0,,Nahinto na ba ang proseso ng petrification?
Dialogue: 0,0:36:15.53,0:36:17.99,general text,,0,0,0,,Ngayon ay nakahinga na siya
Dialogue: 0,0:36:19.12,0:36:21.00,pangkalahatang teksto,,0,0,0,,At igalaw ang iyong mga daliri
Dialogue: 0,0:36:21.83,0:36:24.33,pangkalahatang teksto,,0,0,0,,Si Master Kan ay isang salamangkero na may malawak na karanasan
Dialogue: 0,0:36:25.13,0:36:27.34,general text,,0,0,0,,Kailan siya naging interesado sa kulam?
Dialogue: 0,0:36:27.42,0:36:30.60,general text,,0,0,0,,Kung sinabi sa akin ni Jin Mu na kaya kong ilipat ang kaluluwa
Dialogue: 0,0:36:30.68,0:36:33.52,pangkalahatang teksto,,0,0,0,,sa isang bata at magandang katawan, masusuka ako
Dialogue: 0,0:36:35.69,0:36:39.61,general text,,0,0,0,,Biro lang. Pero sigurado akong marami ang mahuhulog dito
Dialogue: 0,0:36:39.69,0:36:41.19,pangkalahatang teksto,,0,0,0,,Hindi ito hayagang pinag-uusapan ng mga tao
Dialogue: 0,0:36:41.28,0:36:42.82,pangkalahatang teksto,,0,0,0,,dahil lang kay Sosnovy Bor
Dialogue: 0,0:36:44.78,0:36:47.70,pangkalahatang teksto,,0,0,0,,Una, si Jeonbugwan at ang palasyo
Dialogue: 0,0:36:47.78,0:36:52.08,pangkalahatang teksto,,0,0,0,,Ngayon, tila, ang mga kamay ni Jin Mu ay umabot na kay Jinyoewon
Dialogue: 0,0:36:52.16,0:36:53.29,pangkalahatang teksto,,0,0,0,,Ngunit kaya natin
Dialogue: 0,0:36:53.37,0:36:56.71,pangkalahatang teksto,,0,0,0,,patunayan na gumamit siya ng soul alchemy
Dialogue: 0,0:36:56.79,0:36:59.09,pangkalahatang teksto,,0,0,0,,Sa sandaling i-interrogate namin si Master Kahn,
Dialogue: 0,0:36:59.17,0:37:01.42,pangkalahatang text,,0,0,0,,mahuli na natin si Jin Mu
Dialogue: 0,0:37:02.01,0:37:04.01,general text,,0,0,0,,Hindi siya natatakot na mahuli
Dialogue: 0,0:37:04.88,0:37:06.68,general text,,0,0,0,,Sa kabaligtaran, may binabalak na naman siya
Dialogue: 0,0:37:08.14,0:37:10.22,italics,,0,0,0,,Hindi ko maisip,
Dialogue: 0,0:37:10.89,0:37:13.35,pangkalahatang teksto,,0,0,0,,kung gaano siya handang pumunta
Dialogue: 0,0:37:14.81,0:37:16.27,pangkalahatang teksto,,0,0,0,,At natatakot ako
Dialogue: 0,0:37:24.07,0:37:27.49,general text,,0,0,0,,Bakit ako pupunta sa Jeonbugwan sa pagkakataong ito?
Dialogue: 0,0:37:27.57,0:37:30.62,general text,,0,0,0,,Kailangan mo bang magdusa muli dahil sa isa pang uod?
Dialogue: 0,0:37:30.70,0:37:32.70,pangkalahatang teksto,,0,0,0,,Gawin mo lang ang sinasabi nila
Dialogue: 0,0:37:34.66,0:37:37.92,general text,,0,0,0,,Maraming tao doon. Panoorin kung ano ang iyong sasabihin at gawin
Dialogue: 0,0:38:03.24,0:38:07.42,pangkalahatang teksto,,0,0,0,,Ngayon sa wakas ay ipapakita ko sa iyo
Dialogue: 0,0:38:09.08,0:38:10.84,pangkalahatang teksto,,0,0,0,,aming danzhu
Dialogue: 0,0:38:15.51,0:38:19.30,pangkalahatang teksto,,0,0,0,,Halika at ipakita ang iyong sarili sa lahat
Dialogue: 0,0:38:37.90,0:38:40.62,pangkalahatang teksto,,0,0,0,,Ang aming Danzhu ay hindi lamang ang pinakamakapangyarihang pari ng Deho,
Dialogue: 0,0:38:40.70,0:38:43.79,pangkalahatang teksto,,0,0,0,,kundi pati na rin ang hinaharap na kabanata ng Jinyeowon. Ang kanyang pangalan ay Jin Bu Young
Dialogue: 0,0:38:46.33,0:38:48.71,pangkalahatang teksto,,0,0,0,, Yumuko kay Danzhu
Dialogue: 0,0:39:04.14,0:39:07.06,pangkalahatang teksto,,0,0,0,,Gagamitin ko ito para ipakita sa mundo ang batong yelo
Dialogue: 0,0:39:08.36,0:39:10.24,general text,,0,0,0,,At pagkatapos ay ililipat ko ang aking kaluluwa sa kanyang katawan
Dialogue: 0,0:39:10.91,0:39:14.03,pangkalahatang teksto,,0,0,0,,Kung gayon maaari akong lumapit at paglingkuran ka,
Dialogue: 0,0:39:15.12,0:39:16.37,pangkalahatang teksto,,0,0,0,,ate
Dialogue: 0,0:39:31.34,0:39:34.89,pangkalahatang teksto,,0,0,0,,Nagpulong ng Unified Council ang pinuno ng Jinyeowon
Dialogue: 0,0:39:34.97,0:39:36.97,general text,,0,0,0,,- Hindi man lang napag-usapan ni Sosnovy Bor?\N- Oo
Dialogue: 0,0:39:37.06,0:39:40.27,general text,,0,0,0,,Nagpadala siya ng mga sulat sa lahat ng pamilya. Papunta sila dito ngayon
Dialogue: 0,0:39:43.81,0:39:44.98,italics,,0,0,0,,What this time...
Dialogue: 0,0:39:45.06,0:39:48.86,general text,,0,0,0,,pupunta ba si Jinyeowon?
Dialogue: 0,0:39:54.37,0:39:58.49,general text,,0,0,0,,Nasa Sejukwon na ngayon ang kanyang anak
Dialogue: 0,0:40:02.12,0:40:03.54,general text,,0,0,0,,Bakit nandito ang lahat?
Dialogue: 0,0:40:05.29,0:40:07.80,pangkalahatang teksto,,0,0,0,,Nagpulong si Jinyeowon ng Unified Council
Dialogue: 0,0:40:11.42,0:40:12.84,italics,,0,0,0,,Andito rin si Cho Young
Dialogue: 0,0:40:13.59,0:40:16.22,italics,,0,0,0,,Ang bulag na babae sa tabi mo ay si Boo Young?
Dialogue: 0,0:40:17.35,0:40:18.31,general text,,0,0,0,,So ako?
Dialogue: 0,0:40:19.60,0:40:20.52,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:40:23.90,0:40:25.56,italics,,0,0,0,,Lahat ay nangyayari nang mas mabilis kaysa sa aming inakala
Dialogue: 0,0:40:25.65,0:40:28.16,general text,,0,0,0,,Gagamitin nila ang pekeng Bu Young,
Dialogue: 0,0:40:28.24,0:40:30.12,italics,,0,0,0,,upang gumawa ng isang bagay ngayon
Dialogue: 0,0:40:38.42,0:40:40.67,general text,,0,0,0,,Ito ay dapat na Jin Bu Young
Dialogue: 0,0:41:08.87,0:41:11.29,italics,,0,0,0,,Inimbitahan ng pinuno ni Jinyeowon ang royal family
Dialogue: 0,0:41:11.37,0:41:14.66,pangkalahatang teksto,,0,0,0,,at Jeonbugwan sa Unified Council
Dialogue: 0,0:41:14.75,0:41:16.37,pangkalahatang teksto,,0,0,0,,Pinag-isang payo?
Dialogue: 0,0:41:18.21,0:41:19.34,pangkalahatang teksto,,0,0,0,,Para saan?
Dialogue: 0,0:41:19.42,0:41:21.34,pangkalahatang teksto,,0,0,0,,Upang ipahayag ang isang mahalagang desisyon,
Dialogue: 0,0:41:21.42,0:41:24.38,pangkalahatang teksto,,0,0,0,,na magtatakda ng kinabukasan ng lahat ng Deho
Dialogue: 0,0:41:33.68,0:41:37.19,pangkalahatang teksto,,0,0,0,,Naganap ang totoong kaguluhan sa kabisera dahil sa maraming kaso,
Dialogue: 0,0:41:37.27,0:41:39.31,pangkalahatang teksto,,0,0,0,,na may kaugnayan sa mga nomad,
Dialogue: 0,0:41:39.40,0:41:41.02,pangkalahatang teksto,,0,0,0,,sa kabila ng pagbabalik ni Nak Soo
Dialogue: 0,0:41:41.82,0:41:45.65,pangkalahatang teksto,,0,0,0,,Kaya sinubukan ni Jinyeowon na tulungan si Sosnovy Bor,
Dialogue: 0,0:41:45.74,0:41:47.58,pangkalahatang teksto,,0,0,0,,upang mahanap ang pinagmulan ng pangkukulam
Dialogue: 0,0:41:48.71,0:41:49.67,pangkalahatang teksto,,0,0,0,,Gayunpaman...
Dialogue: 0,0:41:51.21,0:41:54.01,pangkalahatang teksto,,0,0,0,,Ang aming suporta ay ipinagwalang-bahala
Dialogue: 0,0:41:55.01,0:41:59.97,pangkalahatang teksto,,0,0,0,,at mayabang na naghain ng hindi makatwirang mga kahilingan at kahilingan
Dialogue: 0,0:42:02.14,0:42:05.43,italics,,0,0,0,,Nakipagbreak sila kay Jinyeowon sa parehong paraan na nakipagbreak sila kay Jeonbugwan,
Dialogue: 0,0:42:05.52,0:42:08.73,italics,,0,0,0,,nagpapawalang-sala sa kanilang sarili sa pagsasabing naghahanap sila ng bakas ng dark magic
Dialogue: 0,0:42:08.81,0:42:12.23,italics,,0,0,0,,Bukod dito, sinubukan nilang gamitin ang mga relics ni Jinyaewon,
Dialogue: 0,0:42:12.32,0:42:14.15,pangkalahatang teksto,,0,0,0,,upang suriin ang lahat ng pamilya ng magician
Dialogue: 0,0:42:14.23,0:42:17.03,pangkalahatang teksto,,0,0,0,,Para bang lahat ng nasa labas ng pader ng Sosnovy Bor ay gumagamit ng pangkukulam
Dialogue: 0,0:42:18.96,0:42:20.07,italics,,0,0,0,,Bukod dito,
Dialogue: 0,0:42:20.16,0:42:24.08,general text,,0,0,0,,dinala nila ang isa sa mga relic natin sa palasyo
Dialogue: 0,0:42:24.58,0:42:26.58,pangkalahatang text,,0,0,0,,Walang tiwala sa amin si Sosnovy Bor?
Dialogue: 0,0:42:26.66,0:42:28.00,italics,,0,0,0,,Sobra ito
Dialogue: 0,0:42:31.83,0:42:33.71,italics,,0,0,0,,Chief Jin, pinatawag mo ang Unified Council,
Dialogue: 0,0:42:33.80,0:42:36.92,pangkalahatang teksto,,0,0,0,,upang magsalita at magreklamo tungkol kay Sosnovy Bor?
Dialogue: 0,0:42:37.01,0:42:37.97,italics,,0,0,0,,Nakikita mo sa iyong sarili
Dialogue: 0,0:42:38.05,0:42:40.34,pangkalahatang teksto,,0,0,0,,Sa sandaling nagsimula akong magsalita,
Dialogue: 0,0:42:40.43,0:42:42.30,general text,,0,0,0,,kung paano niya ako sinugod agad para tumahimik.
Dialogue: 0,0:42:42.89,0:42:44.93,italics,,0,0,0,,Ako, Jin Ho Kyung, pinuno ng Jinyoewon
Dialogue: 0,0:42:45.01,0:42:49.77,pangkalahatang teksto,,0,0,0,,Gusto kong itigil ang kabalbalan na ito, na sinasabing nakatuon sa paghahanap ng dark magic
Dialogue: 0,0:42:49.85,0:42:52.48,pangkalahatang teksto,,0,0,0,,Kaugnay ng paglabag ko sa panuntunang ipinakilala 200 taon na ang nakakaraan,
Dialogue: 0,0:42:52.56,0:42:57.53,pangkalahatang teksto,,0,0,0,,oobserbahan hanggang ngayon. Kaya ko kayong lahat dito tinipon
Dialogue: 0,0:43:01.28,0:43:02.20,pangkalahatang teksto,,0,0,0,,Boo Young
Dialogue: 0,0:43:12.51,0:43:16.97,italics,,0,0,0,,Ito si Jin Bu Young, tagapagmana ni Jinyoung,
Dialogue: 0,0:43:17.06,0:43:18.43,pangkalahatang teksto,,0,0,0,,babalik pagkatapos ng 10 taon
Dialogue: 0,0:43:22.02,0:43:23.27,italics,,0,0,0,,Nabalitaan kong natagpuan niya ang kanyang anak na babae
Dialogue: 0,0:43:23.86,0:43:24.73,general text,,0,0,0,,Malamang, ito siya
Dialogue: 0,0:43:28.48,0:43:31.53,italics,,0,0,0,,May ipapakita ako sa iyo, at ang aking anak na babae
Dialogue: 0,0:43:31.61,0:43:34.20,pangkalahatang text,,0,0,0,,tutulungan ako nito
Dialogue: 0,0:43:46.13,0:43:50.88,pangkalahatang teksto,,0,0,0,,Ang pine forest ay naghahanap ng batong yelo sa lahat ng dako,
Dialogue: 0,0:43:50.97,0:43:52.88,pangkalahatang teksto,,0,0,0,,na siyang pinagmulan ng alchemy ng mga kaluluwa
Dialogue: 0,0:43:52.97,0:43:55.68,general text,,0,0,0,,Gayunpaman, all this time, nasa Jinyeowon siya
Dialogue: 0,0:44:43.57,0:44:45.49,italics,,0,0,0,,So yun ang plano ni Jin Mu
Dialogue: 0,0:44:46.03,0:44:49.33,pangkalahatang teksto,,0,0,0,,Gamitin si Jinyeowon para ipakilala ang yelong bato sa mundo
Dialogue: 0,0:44:49.41,0:44:50.91,general text,,0,0,0,,Ito ay simula pa lamang
Dialogue: 0,0:44:51.83,0:44:55.29,pangkalahatang teksto,,0,0,0,,Ang mga pinaghihinalaan ay susubukan na ilipat ang mga kaluluwa
Dialogue: 0,0:44:58.21,0:44:59.38,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:45:00.00,0:45:01.00,general text,,0,0,0,,Hindi mo maintindihan?
Dialogue: 0,0:45:01.59,0:45:04.30,pangkalahatang teksto,,0,0,0,,Ang reyna ay may batong yelo, ngunit ngayon ay kay Jinyeowon
Dialogue: 0,0:45:04.38,0:45:06.26,general text,,0,0,0,,So, aalis na si shaman Choi sa katawan ng reyna
Dialogue: 0,0:45:07.34,0:45:09.51,italics,,0,0,0,,at ililipat sa katawan ng isang tao mula sa Jinyowon
Dialogue: 0,0:45:12.31,0:45:14.18,general text,,0,0,0,,Aalis siya sa katawan ng reyna
Dialogue: 0,0:45:16.02,0:45:19.73,pangkalahatang teksto,,0,0,0,,at lilipat sa katawan ng magiging pinuno ng Jinyeowon,
Dialogue: 0,0:45:21.02,0:45:22.48,pangkalahatang teksto,,0,0,0,,gamit ang soul alchemy
Dialogue: 0,0:45:35.50,0:45:37.21,italics,,0,0,0,,Napakaganda ng una
Dialogue: 0,0:45:37.92,0:45:39.33,general text,,0,0,0,,Isang pinag-isang konseho ang ipinatawag, sabi nila
Dialogue: 0,0:45:39.42,0:45:41.88,pangkalahatang teksto,,0,0,0,,Mag-uusap sila tungkol sa mga nomad
Dialogue: 0,0:45:41.96,0:45:43.67,pangkalahatang teksto,,0,0,0,,Mukhang
Dialogue: 0,0:45:44.80,0:45:47.64,pangkalahatang teksto,,0,0,0,,Huwag bumili ng hindi kinakailangang alahas. Mas mabuting kumuha ng ginto
Dialogue: 0,0:45:47.73,0:45:50.23,pangkalahatang teksto,,0,0,0,,Sa madilim na panahon, ginto lang ang aasahan mo
Dialogue: 0,0:45:50.31,0:45:53.15,pangkalahatang teksto,,0,0,0,,Maraming gawaing gagawin kapag natapos na ang konseho
Dialogue: 0,0:45:53.23,0:45:54.07,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:45:54.15,0:45:56.57,general text,,0,0,0,,Matatapos na sila at agad na uminom ang lahat.
Dialogue: 0,0:45:56.65,0:45:59.32,pangkalahatang teksto,,0,0,0,,- Ang mga tao ay magsasabi ng mga masasamang bagay tungkol kay Sosnovy Bor \N-{\i1} Hey{\i0}
Dialogue: 0,0:45:59.41,0:46:01.95,pangkalahatang teksto,,0,0,0,,Itigil ang pagsubok sa lahat, bilhin mo na
Dialogue: 0,0:46:02.03,0:46:04.54,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari sa iyo? Bigyan mo siya ng oras
Dialogue: 0,0:46:04.62,0:46:06.08,italics,,0,0,0,,gusto kong bilhin lahat
Dialogue: 0,0:46:06.16,0:46:08.16,italics,,0,0,0,,- Let me try\N- This one?
Dialogue: 0,0:46:12.84,0:46:15.42,pangkalahatang teksto,,0,0,0,,Ang pinag-uusapan ng lahat sa kabisera ay tungkol sa Unified Council
Dialogue: 0,0:46:15.50,0:46:17.30,pangkalahatang teksto,,0,0,0,,oo tungkol sa maharlikang pamilya
Dialogue: 0,0:46:18.30,0:46:21.51,general text,,0,0,0,,Kailangan niyang bumalik dahil sa lahat ng kaguluhang ito
Dialogue: 0,0:46:22.97,0:46:24.72,general text,,0,0,0,,Si Master Chan ba ang pinag-uusapan mo?
Dialogue: 0,0:46:25.85,0:46:30.23,general text,,0,0,0,,Naisip ko rin, kakaibang tinatanong ako ni Dan Gu
Dialogue: 0,0:46:30.31,0:46:32.02,pangkalahatang teksto,,0,0,0,,tungkol kay Mr. Chang Gan
Dialogue: 0,0:46:32.10,0:46:35.65,pangkalahatang teksto,,0,0,0,,Mukhang hinihintay ng pinuno ni Sosnovy Bor ang kanyang hitsura
Dialogue: 0,0:46:43.24,0:46:44.91,pangkalahatang teksto,,0,0,0,,Kunin ito
Dialogue: 0,0:46:44.99,0:46:46.79,italics,,0,0,0,,Ibigay kay Chang Gun kapag nagpakita siya
Dialogue: 0,0:46:47.75,0:46:48.83,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:46:49.66,0:46:50.79,general text,,0,0,0,,Makikita ko ba ito?
Dialogue: 0,0:47:01.68,0:47:03.14,pangkalahatang teksto,,0,0,0,,Agad na walang laman
Dialogue: 0,0:47:03.22,0:47:07.02,pangkalahatang teksto,,0,0,0,,Ginamit mo ba ang parehong spell tulad ng sa "Words of the Heart"?
Dialogue: 0,0:47:09.07,0:47:12.61,general text,,0,0,0,,Kapag nabasa ito ni Chang Gang, gagawin niya ang sinasabi nito
Dialogue: 0,0:47:19.04,0:47:23.42,general text,,0,0,0,,By the way, hindi ba kailangan mong dumalo sa council?
Dialogue: 0,0:47:24.00,0:47:26.09,general text,,0,0,0,,Isa akong estudyante ng teacher na si Seo Kyung
Dialogue: 0,0:47:27.59,0:47:29.17,general text,,0,0,0,,Kung pupunta ako doon,
Dialogue: 0,0:47:29.26,0:47:34.22,pangkalahatang teksto,,0,0,0,,Hindi ko kayang suportahan o kondenahin ang mga aksyon ng aking guro
Dialogue: 0,0:47:40.31,0:47:44.52,italics,,0,0,0,,So si Master So Kyung ang nagtago ng ice stone?
Dialogue: 0,0:47:44.60,0:47:46.98,italics,,0,0,0,,Akala ko winasak niya silang lahat
Dialogue: 0,0:47:47.06,0:47:48.77,pangkalahatang teksto,,0,0,0,,Alam ito ni Sosnovy Bor?
Dialogue: 0,0:47:48.86,0:47:51.11,pangkalahatang teksto,,0,0,0,,Kung gayon, lahat ng ginawa ni Sosnovy Bor,
Dialogue: 0,0:47:51.19,0:47:54.16,general text,,0,0,0,,justified by the words of Master So Kyung, panlilinlang?
Dialogue: 0,0:47:54.24,0:47:56.74,pangkalahatang text,,0,0,0,,- Kalokohan!\N-{\i1} Oo, isa itong tunay na scam{\i0}
Dialogue: 0,0:47:56.82,0:47:58.78,italics,,0,0,0,,Napakaraming tuntunin ang ipinakilala para sa mga pamilya ng mga salamangkero,
Dialogue: 0,0:47:58.87,0:48:01.37,general text,,0,0,0,,explaining everything by saying that dark magic is being watched
Dialogue: 0,0:48:01.45,0:48:02.66,general text,,0,0,0,,Mali ba ako?
Dialogue: 0,0:48:02.75,0:48:05.00,general text,,0,0,0,,- Exact\N- Lahat ay tama
Dialogue: 0,0:48:05.08,0:48:07.00,italics,,0,0,0,, Pinangunahan tayo ng pine forest sa ilong?
Dialogue: 0,0:48:07.08,0:48:08.42,general text,,0,0,0,,Naloloko ba tayo?
Dialogue: 0,0:48:08.50,0:48:10.88,italics,,0,0,0,,- Naloko ka ba talaga?\N{\i0}- Huminahon ka!
Dialogue: 0,0:48:12.42,0:48:13.63,pangkalahatang teksto,,0,0,0,,Hindi naghinala ang aming mga salamangkero...
Dialogue: 0,0:48:13.72,0:48:17.60,pangkalahatang teksto,,0,0,0,,na ang yelong bato ay nakatago sa Jinyeowon
Dialogue: 0,0:48:18.30,0:48:20.35,italics,,0,0,0,,Hindi namin gustong makinig sa iyong mga dahilan
Dialogue: 0,0:48:20.43,0:48:21.77,pangkalahatang teksto,,0,0,0,,Kailangan nating magpasya kung ano ang susunod
Dialogue: 0,0:48:21.85,0:48:25.70,pangkalahatang teksto,,0,0,0,,gawin sa batong natitira
Dialogue: 0,0:48:25.78,0:48:28.82,pangkalahatang teksto,,0,0,0,,Dapat itong sirain. Ito ang pinanggagalingan ng kulam
Dialogue: 0,0:48:29.33,0:48:31.20,general text,,0,0,0,,Ito ang ipinamana ni Master So Kyung
Dialogue: 0,0:48:31.95,0:48:33.45,pangkalahatang teksto,,0,0,0,,Dapat nating sirain ang bato...
Dialogue: 0,0:48:34.29,0:48:36.46,pangkalahatang teksto,,0,0,0,,sa harap ng lahat ng naroroon
Dialogue: 0,0:48:36.96,0:48:39.79,general text,,0,0,0,,Siya mismo ang nag-iwan ng ice stone sa Jinyeowon
Dialogue: 0,0:48:39.88,0:48:42.71,general text,,0,0,0,,Sundin natin ang kanyang desisyon at iwanan ang bato doon
Dialogue: 0,0:48:42.80,0:48:46.09,pangkalahatang teksto,,0,0,0,,Kung gayon hindi na kailangang dalhin ito dito
Dialogue: 0,0:48:46.18,0:48:49.68,italics,,0,0,0,,Paano ka uupo ngayon na ipinakita mo sa lahat na ito ay umiiral?
Dialogue: 0,0:48:49.76,0:48:52.56,pangkalahatang teksto,,0,0,0,,Sinusubukan mo bang gawing katatawanan si Sosnovy Bor?
Dialogue: 0,0:48:52.64,0:48:55.43,pangkalahatang teksto,,0,0,0,,Sinabi ng pinuno ni Jinyeowon ang lahat
Dialogue: 0,0:48:55.52,0:48:56.98,pangkalahatang teksto,,0,0,0,,Sinusunod niya ang kalooban ng amo,
Dialogue: 0,0:48:57.06,0:48:59.10,pangkalahatang teksto,,0,0,0,,kung ano ang naiwan ng yelong bato sa Jinyeowon
Dialogue: 0,0:48:59.19,0:49:03.90,pangkalahatang teksto,,0,0,0,,Wala nang karapatan si Sosnovy Bor na sabihin sa amin kung ano ang gagawin sa ice stone
Dialogue: 0,0:49:03.98,0:49:07.74,pangkalahatang teksto,,0,0,0,,Kabalbalan! Wala ka na bang pakialam sa opinyon ni Sosnovy Bor?
Dialogue: 0,0:49:08.32,0:49:09.91,general text,,0,0,0,,Pumunta kami dito para pag-usapan...
Dialogue: 0,0:49:09.99,0:49:12.83,pangkalahatang teksto,,0,0,0,,paano gamitin ang bato, batay sa kalooban ni Master Seo Kyung
Dialogue: 0,0:49:12.91,0:49:15.29,general text,,0,0,0,,Kung may ayaw si Sosnovy Bor, umalis ka
Dialogue: 0,0:49:15.37,0:49:16.91,italics,,0,0,0,,- Tama ka\N - Eksakto
Dialogue: 0,0:49:17.00,0:49:19.33,italics,,0,0,0,,Nagsinungaling ka sa amin, kaya hindi sa iyo ang magdesisyon ngayon
Dialogue: 0,0:49:19.42,0:49:22.09,italics,,0,0,0,,- Eksakto, wala kang karapatang bumoto\N- Huwag makialam
Dialogue: 0,0:49:22.17,0:49:23.38,italics,,0,0,0,,Kung tutol ka, umalis ka
Dialogue: 0,0:49:23.46,0:49:25.84,italics,,0,0,0,,- Umalis ka na lang!\N- Lumabas ka!
Dialogue: 0,0:49:25.92,0:49:27.30,behind the scenes,,0,0,0,,Kaya si Jin Mu...
Dialogue: 0,0:49:27.38,0:49:30.64,offscreen,,0,0,0,,ipinakita ang yelong bato sa lahat
Dialogue: 0,0:49:30.72,0:49:33.64,pangkalahatang teksto,,0,0,0,,Ngayon ang opinyon ni Sosnovy Bor ay hindi makatwiran,
Dialogue: 0,0:49:33.72,0:49:36.10,italics,,0,0,0,,walang gustong makinig sa kanila
Dialogue: 0,0:49:43.15,0:49:44.48,italics,,0,0,0,,Anong ginagawa mo diyan?
Dialogue: 0,0:49:45.08,0:49:46.33,italics,,0,0,0,,If Sosnovy Bor
Dialogue: 0,0:49:46.41,0:49:49.04,italics,,0,0,0,,laban sa batong natitira sa Jinyowon,
Dialogue: 0,0:49:49.58,0:49:52.63,pangkalahatang text,,0,0,0,,ibibigay ba natin ito sa isang third party para sa storage?
Dialogue: 0,0:49:53.59,0:49:54.96,pangkalahatang teksto,,0,0,0,,Narito ang aking panukala
Dialogue: 0,0:49:55.05,0:49:56.96,general text,,0,0,0,,Ililipat ba natin ito kay Zhisan?
Dialogue: 0,0:49:57.55,0:49:59.38,general text,,0,0,0,,Anong kalokohan?
Dialogue: 0,0:49:59.47,0:50:01.34,general text,,0,0,0,,Bakit ito dumiretso sa Zhisan?
Dialogue: 0,0:50:01.43,0:50:03.10,pangkalahatang teksto,,0,0,0,,Ikaw at ang iyong pamilya ay mababang antas ng mga salamangkero!
Dialogue: 0,0:50:03.18,0:50:04.14,general text,,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,0:50:04.22,0:50:07.02,pangkalahatang teksto,,0,0,0,,Walang karapatan ang iyong pamilya na panatilihin ang batong yelo
Dialogue: 0,0:50:07.10,0:50:09.02,general text,,0,0,0,,- Tutol kami\N- Wala ba kaming karapatan?
Dialogue: 0,0:50:09.60,0:50:12.81,general text,,0,0,0,,Ang pamilya namin ang pinakamatanda sa Deho
Dialogue: 0,0:50:12.90,0:50:15.15,pangkalahatang teksto,,0,0,0,,Mayroon kaming lahat ng karapatan na protektahan ang yelong bato
Dialogue: 0,0:50:15.23,0:50:17.32,general text,,0,0,0,,Saan mo hinihila ang iyong mga kamay?
Dialogue: 0,0:50:17.40,0:50:20.03,general text,,0,0,0,,-Naghahanap ka ba ng away? \N- At ang aking sarili!
Dialogue: 0,0:50:20.11,0:50:22.57,italics,,0,0,0,,- Ano ang ginagawa mo?\N- Panoorin ang iyong wika
Dialogue: 0,0:50:23.16,0:50:25.16,italics,,0,0,0,,Sino ka sa tingin mo?
Dialogue: 0,0:50:25.24,0:50:27.29,pangkalahatang teksto,,0,0,0,,Maliit na morel!
Dialogue: 0,0:50:27.37,0:50:28.83,pangkalahatang teksto,,0,0,0,,Ako ba ang morel?
Dialogue: 0,0:50:28.91,0:50:30.33,general text,,0,0,0,,Hoy, itigil mo na!
Dialogue: 0,0:50:30.41,0:50:31.37,pangkalahatang text,,0,0,0,,Out of the way!
Dialogue: 0,0:50:35.34,0:50:37.50,pangkalahatang text,,0,0,0,,Saktan mo ako?
Dialogue: 0,0:50:37.59,0:50:39.63,italics,,0,0,0,,Damn you, old man!
Dialogue: 0,0:50:41.47,0:50:42.80,pangkalahatang teksto,,0,0,0,,Oh ikaw...
Dialogue: 0,0:50:42.89,0:50:45.35,general text,,0,0,0,,Bitawan mo ako, tanga!
Dialogue: 0,0:50:49.31,0:50:50.48,general text,,0,0,0,,Ako ba ang pinupuntirya mo?
Dialogue: 0,0:50:50.56,0:50:52.81,pangkalahatang teksto,,0,0,0,,Mahusay. Halika, atake
Dialogue: 0,0:50:55.06,0:50:55.98,italics,,0,0,0,,Ikaw...
Dialogue: 0,0:50:56.07,0:50:58.19,general text,,0,0,0,,Sa tingin mo hindi ko kaya?
Dialogue: 0,0:50:58.28,0:50:59.65,pangkalahatang teksto,,0,0,0,,Kasing walang pakundangan sa iyo
Dialogue: 0,0:50:59.74,0:51:01.74,pangkalahatang teksto,,0,0,0,,Kaninong baka ang magmumura!
Dialogue: 0,0:51:02.57,0:51:04.83,italics,,0,0,0,,Lolo sa Unified Council?
Dialogue: 0,0:51:04.92,0:51:05.75,italics,,0,0,0,,Oo
Dialogue: 0,0:51:06.34,0:51:09.42,pangkalahatang text,,0,0,0,,Hindi ko nahanap sa Jeonjingak ang textbook na hiniling mo
Dialogue: 0,0:51:10.17,0:51:12.34,general text,,0,0,0,,Pupunta ako doon at ako mismo ang hahanapin
Dialogue: 0,0:51:13.55,0:51:15.72,pangkalahatang teksto,,0,0,0,,May importanteng tinatalakay ang konseho, malamang
Dialogue: 0,0:51:15.80,0:51:18.68,general text,,0,0,0,,Lahat ng magicians ng Sejukwon ay pumunta doon
Dialogue: 0,0:51:22.60,0:51:26.11,general text,,0,0,0,,Buhay pa daw ang anak ko
Dialogue: 0,0:51:51.30,0:51:52.38,pangkalahatang teksto,,0,0,0,,Ji Ho...
Dialogue: 0,0:52:11.40,0:52:12.74,pangkalahatang teksto,,0,0,0,,Buhay ka
Dialogue: 0,0:52:21.45,0:52:22.49,pangkalahatang teksto,,0,0,0,,Ji Ho?
Dialogue: 0,0:52:49.49,0:52:51.58,pangkalahatang teksto,,0,0,0,,Kumalma at maupo!
Dialogue: 0,0:52:55.00,0:52:56.37,pangkalahatang teksto,,0,0,0,,Ngayon na ang oras
Dialogue: 0,0:52:56.46,0:52:59.21,pangkalahatang teksto,,0,0,0,,Panahon na para makialam si Jin Ho Kyung at lutasin ang hindi pagkakaunawaan
Dialogue: 0,0:53:08.59,0:53:11.68,pangkalahatang teksto,,0,0,0,,Sapat na!
Dialogue: 0,0:53:14.06,0:53:16.60,italics,,0,0,0,,- I'll deal with you later!\N- Well, tara na!
Dialogue: 0,0:53:16.68,0:53:18.23,italics,,0,0,0,,Isaalang-alang ang iyong sarili na masuwerte
Dialogue: 0,0:53:19.02,0:53:19.90,italics,,0,0,0,,Ipagpapatuloy ko
Dialogue: 0,0:53:21.10,0:53:23.02,pangkalahatang teksto,,0,0,0,,Batay sa pangkalahatang opinyon,
Dialogue: 0,0:53:23.11,0:53:25.15,pangkalahatang teksto,,0,0,0,,mas mabuting gamitin natin ang batong yelo
Dialogue: 0,0:53:25.23,0:53:29.20,pangkalahatang teksto,,0,0,0,,Para sa kapakinabangan ng lahat ng naroroon
Dialogue: 0,0:53:30.41,0:53:31.49,italics,,0,0,0,,Kaya ako,
Dialogue: 0,0:53:31.57,0:53:36.12,pangkalahatang teksto,,0,0,0,,Jin Ho Kyung, pinuno ng Jinyoewon, nais kong imungkahi ang sumusunod
Dialogue: 0,0:53:36.20,0:53:39.58,pangkalahatang teksto,,0,0,0,,Mula ngayon, ang karapatang magpulong ng Unified Council
Dialogue: 0,0:53:40.25,0:53:44.18,pangkalahatang teksto,,0,0,0,,Jinyeowon, hindi Sosnovy Bor, ang magkakaroon
Dialogue: 0,0:53:49.23,0:53:51.94,italics,,0,0,0,,Kung sang-ayon ang lahat sa panukalang ito,
Dialogue: 0,0:53:52.02,0:53:53.86,pangkalahatang text,,0,0,0,,matatapos tayo dito
Dialogue: 0,0:53:53.94,0:53:57.53,pangkalahatang teksto,,0,0,0,,Ngayon si Jinyeowon ang magsasagawa ng lahat ng mga talakayan tungkol sa bato,
Dialogue: 0,0:53:58.40,0:54:00.95,pangkalahatang teksto,,0,0,0,,hindi Sosnovy Bor
Dialogue: 0,0:54:06.66,0:54:08.16,italics,,0,0,0,,Ituturing ko ito bilang kasunduan
Dialogue: 0,0:54:08.25,0:54:10.00,general text,,0,0,0,,at tatapusin ko ang meeting ngayong araw
Dialogue: 0,0:54:11.87,0:54:15.25,pangkalahatang teksto,,0,0,0,,Mananatili ang yelong bato sa Jinyeowon
Dialogue: 0,0:54:16.46,0:54:18.01,pangkalahatang teksto,,0,0,0,,Dapat nating sirain ang bato
Dialogue: 0,0:54:18.92,0:54:22.97,pangkalahatang teksto,,0,0,0,,Sa ganitong paraan maiiwasan natin ang mga pag-aaway sa hinaharap
Dialogue: 0,0:54:23.05,0:54:25.51,pangkalahatang teksto,,0,0,0,,Ano ang nagbibigay sa iyo ng karapatang gumawa ng ganoong desisyon?
Dialogue: 0,0:54:25.60,0:54:26.93,pangkalahatang teksto,,0,0,0,,Lahat ng naroroon ay laban
Dialogue: 0,0:54:27.01,0:54:30.06,pangkalahatang teksto,,0,0,0,,Isang kaso ng soul alchemy ang naitala
Dialogue: 0,0:54:30.14,0:54:32.52,pangkalahatang teksto,,0,0,0,,At lahat dahil sa mga reflector na gawa sa bato
Dialogue: 0,0:54:32.60,0:54:34.73,general text,,0,0,0,,Noong una ay nagduda sila kay Jeonbugwan at sa royal family
Dialogue: 0,0:54:34.81,0:54:37.15,pangkalahatang teksto,,0,0,0,,Ganyan din ang ginagawa mo ngayon kay Jinyeowon
Dialogue: 0,0:54:38.73,0:54:42.03,general text,,0,0,0,,Hindi ko hahayaang matapos ng ganito ang Unified Council
Dialogue: 0,0:54:43.57,0:54:44.74,pangkalahatang teksto,,0,0,0,,Kabanata Jin,
Dialogue: 0,0:54:44.82,0:54:50.83,pangkalahatang teksto,,0,0,0,,Pinagbabawalan kitang kunin ang batong yelo sa Sosnovy Bor
Dialogue: 0,0:54:50.91,0:54:54.04,pangkalahatang teksto,,0,0,0,,Lalaban ka ba sa lahat?
Dialogue: 0,0:54:54.12,0:54:55.50,pangkalahatang teksto,,0,0,0,,Walang sinuman
Dialogue: 0,0:54:56.67,0:54:59.05,pangkalahatang teksto,,0,0,0,,hindi kukunin ang batong yelo kay Sosnovy Bor
Dialogue: 0,0:55:08.23,0:55:09.65,italics,,0,0,0,,Gagamit kami ng puwersa laban sa sinuman,
Dialogue: 0,0:55:11.07,0:55:13.28,pangkalahatang teksto,,0,0,0,,sino ang susubukan na gawin ito
Dialogue: 0,0:55:17.24,0:55:19.28,pangkalahatang teksto,,0,0,0,,Pagkatapos ay magsisimula na ang digmaan
Dialogue: 0,0:55:27.58,0:55:29.29,pangkalahatang teksto,,0,0,0,,Naabot na ng sitwasyon ang rurok nito
Dialogue: 0,0:55:29.38,0:55:31.21,pangkalahatang teksto,,0,0,0,,Kamahalan, dapat kang makialam
Dialogue: 0,0:55:31.92,0:55:34.26,pangkalahatang teksto,,0,0,0,,Tama si Master Li
Dialogue: 0,0:55:34.34,0:55:37.05,mga alaala,,0,0,0,,Gustong makuha ng lahat ang bato, kaya nagsimula ang labanan
Dialogue: 0,0:55:37.14,0:55:38.72,mga alaala,,0,0,0,,Kaya nawasak ang mga bato
Dialogue: 0,0:55:40.68,0:55:42.60,italics,,0,0,0,,Lahat ay nag-aaway dahil sa isang bato
Dialogue: 0,0:55:43.27,0:55:44.48,italics,,0,0,0,,Kaya ang bituin ng Hari...
Dialogue: 0,0:55:44.56,0:55:46.90,pangkalahatang teksto,,0,0,0,,totoo din
Dialogue: 0,0:56:31.53,0:56:34.41,general text,,0,0,0,,Nakikita kong nandito lahat ng dati kong guro
Dialogue: 0,0:56:35.20,0:56:38.04,pangkalahatang teksto,,0,0,0,,Hayaan ang dati mong estudyante na batiin ka
Dialogue: 0,0:56:39.00,0:56:40.75,italics,,0,0,0,,Sino ang binatang ito?
Dialogue: 0,0:56:40.83,0:56:42.09,italics,,0,0,0,,Ito si Chan Wook
Dialogue: 0,0:56:42.17,0:56:44.96,pangkalahatang teksto,,0,0,0,,Ignorante mula sa pamilya Chan. Naging estudyante ko rin siya
Dialogue: 0,0:56:45.84,0:56:48.26,italics,,0,0,0,,Kung hindi ako nalilito, sinubukan ng pamilya mo na turuan siya
Dialogue: 0,0:56:48.88,0:56:51.30,pangkalahatang teksto,,0,0,0,, Eksakto. Tumakas siya pagkatapos ng tatlong araw
Dialogue: 0,0:56:51.39,0:56:54.51,pangkalahatang teksto,,0,0,0,,Paumanhin sa pag-abala sa iyong marubdob na talakayan
Dialogue: 0,0:56:55.10,0:56:57.85,italics,,0,0,0,,beat of the drum
Dialogue: 0,0:57:00.60,0:57:03.36,general text,,0,0,0,,- Dapat ko ba siyang pigilan?\N- Hayaan siyang magsalita
Dialogue: 0,0:57:03.94,0:57:06.99,general text,,0,0,0,,Nagawa niyang ihinto ang kanilang mga laban
Dialogue: 0,0:57:07.69,0:57:09.32,pangkalahatang teksto,,0,0,0,,Chang Wook, anak ni Chang Gang
Dialogue: 0,0:57:11.41,0:57:14.49,general text,,0,0,0,,Sana magkaroon ka ng magandang dahilan para mag-ranting ng ganyan
Dialogue: 0,0:57:14.58,0:57:16.83,pangkalahatang teksto,,0,0,0,, bago ang Kanyang Kamahalan
Dialogue: 0,0:57:21.04,0:57:23.46,general text,,0,0,0,,Naparito ako upang ipahayag ang kalooban ni Master So Kyung
Dialogue: 0,0:57:34.64,0:57:37.10,general text,,0,0,0,,Ibinunyag ko sa kanya ang tunay na intensyon ng guro
Dialogue: 0,0:57:37.18,0:57:38.93,general text,,0,0,0,,Sana ay kumilos siya nang matalino
Dialogue: 0,0:57:45.03,0:57:48.66,pangkalahatang teksto,,0,0,0,,Nagsasalita ako sa ngalan ni Master Lee, isang estudyante ng So Kyung
Dialogue: 0,0:57:48.75,0:57:51.04,general text,,0,0,0,,Kaya sana lahat ay magpakita ng respeto...
Dialogue: 0,0:57:51.12,0:57:53.00,pangkalahatang teksto,,0,0,0,,at makinig sa kalooban ni Master So
Dialogue: 0,0:58:01.68,0:58:03.76,pangkalahatang teksto,,0,0,0,,Ayon kay Master Li,
Dialogue: 0,0:58:03.84,0:58:06.30,pangkalahatang teksto,,0,0,0,,ang kalooban ni master Seo Kyung tungkol sa bato
Dialogue: 0,0:58:06.39,0:58:08.10,pangkalahatang teksto,,0,0,0,,nakasulat sa “Words of the Heart”
Dialogue: 0,0:58:10.60,0:58:12.98,general text,,0,0,0,,Doon niya sinabi kung bakit hindi niya sinira ang bato,
Dialogue: 0,0:58:13.06,0:58:15.65,pangkalahatang teksto,,0,0,0,,at iniwan ang libro sa lahat ng mago, para malaman ng lahat
Dialogue: 0,0:58:15.73,0:58:18.94,pangkalahatang teksto,,0,0,0,,Walang itinago ang pine forest
Dialogue: 0,0:58:22.07,0:58:25.57,pangkalahatang teksto,,0,0,0,,Karamihan sa mga naroroon ay nagbabasa ng "Mga Salita ng Puso"
Dialogue: 0,0:58:26.07,0:58:29.79,pangkalahatang teksto,,0,0,0,,Ang tungkulin natin ay hanapin ang kalooban ni Master So Kyung sa aklat
Dialogue: 0,0:58:32.62,0:58:34.29,pangkalahatang teksto,,0,0,0,,Naaalala mo ba kung tungkol saan ito?
Dialogue: 0,0:58:34.37,0:58:37.04,general text,,0,0,0,,Hindi, matagal ko nang nabasa ito
Dialogue: 0,0:58:37.13,0:58:38.80,italics,,0,0,0,,Gusto mo bang sabihin, sa tulang ito...
Dialogue: 0,0:58:38.88,0:58:40.92,general text,,0,0,0,,sinulat niya, bakit niya iniwan ang bato?
Dialogue: 0,0:58:42.72,0:58:43.80,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:58:43.88,0:58:47.47,general text,,0,0,0,,Sinabi sa akin na lahat ay sumusunod sa postulates ni Master So Kyung
Dialogue: 0,0:58:47.55,0:58:50.02,pangkalahatang teksto,,0,0,0,,Kaya hindi mo kailangang makipagtalo tungkol sa yelong bato,
Dialogue: 0,0:58:50.10,0:58:52.35,pangkalahatang teksto,,0,0,0,,at tungkol sa kahulugan ng "Mga Salita ng Puso"
Dialogue: 0,0:58:52.43,0:58:55.56,general text,,0,0,0,,Nasaan na ang mga “Words of the Heart” na sinasabi niya?
Dialogue: 0,0:58:56.27,0:58:58.06,pangkalahatang teksto,,0,0,0,,Ang tulang ito ay itinago sa Sosnovy Bor,
Dialogue: 0,0:58:58.15,0:59:02.04,general text,,0,0,0,,pero sa utos ni Master Lee, ipinadala namin siya kamakailan sa Jinyeowon
Dialogue: 0,0:59:03.75,0:59:06.33,pangkalahatang teksto,,0,0,0,,Ito ay itinatago sa Jinyeowon
Dialogue: 0,0:59:06.42,0:59:08.54,pangkalahatang teksto,,0,0,0,,Pagkatapos ay dalhin ang aklat dito
Dialogue: 0,0:59:10.67,0:59:11.84,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:59:20.26,0:59:21.93,pangkalahatang teksto,,0,0,0,,Ako si Jin Cho Young mula kay Jinyoung
Dialogue: 0,0:59:22.72,0:59:24.60,general text,,0,0,0,,Magdadala ako ng "Words of the Heart"
Dialogue: 0,0:59:25.27,0:59:27.02,pangkalahatang teksto,,0,0,0,,Ang aklat ay dating itinago sa amin,
Dialogue: 0,0:59:27.10,0:59:29.27,general text,,0,0,0,,may ipapadala din ako
Dialogue: 0,0:59:30.02,0:59:32.57,general text,,0,0,0,,Pak Dan Gu, samahan mo siya
Dialogue: 0,0:59:38.49,0:59:39.66,general text,,0,0,0,,Let's go
Dialogue: 0,0:59:55.55,0:59:56.68,general text,,0,0,0,,Matagal na ako
Dialogue: 0,0:59:57.59,1:00:01.35,pangkalahatang teksto,,0,0,0,,"Words of the Heart" ay hindi muling binasa
Dialogue: 0,1:00:01.43,1:00:03.56,pangkalahatang teksto,,0,0,0,,Maaari mo bang ipaalala sa akin kung tungkol saan ito?
Dialogue: 0,1:00:03.64,1:00:05.85,pangkalahatang teksto,,0,0,0,,Isang maikling tula
Dialogue: 0,1:00:07.06,1:00:09.48,general text,,0,0,0,,Nagsisinungaling pala si Uk?
Dialogue: 0,1:00:09.56,1:00:11.65,pangkalahatang teksto,,0,0,0,,Wala itong sinasabi tungkol sa ice stone
Dialogue: 0,1:00:12.40,1:00:16.49,general text,,0,0,0,,Hindi ko maintindihan kung bakit bigla nalang siyang nagsalita tungkol sa "Words of the Heart"
Dialogue: 0,1:00:19.53,1:00:22.04,pangkalahatang teksto,,0,0,0,,Ano ang nasa "Mga Salita ng Puso" na ito?
Dialogue: 0,1:00:22.13,1:00:23.50,general text,,0,0,0,,Hindi ko rin alam
Dialogue: 0,1:00:24.59,1:00:28.38,general text,,0,0,0,,Na-bluff yata siya. Gustong bumili ng oras
Dialogue: 0,1:00:28.93,1:00:31.22,pangkalahatang teksto,,0,0,0,,Ngunit ang aklat na ito ay isinulat mismo ni Seo Kyung
Dialogue: 0,1:00:31.93,1:00:34.64,pangkalahatang teksto,,0,0,0,,Halos masira namin ang tiwala kay Sosnovy Bor
Dialogue: 0,1:00:34.72,1:00:37.06,pangkalahatang teksto,,0,0,0,,Paano kung ang lahat ay naging walang kabuluhan?
Dialogue: 0,1:00:39.69,1:00:42.94,general text,,0,0,0,,Master parang galit sila
Dialogue: 0,1:00:43.02,1:00:45.19,pangkalahatang teksto,,0,0,0,,At sa lalong madaling panahon sila ay labis na magugulat
Dialogue: 0,1:00:46.07,1:00:47.28,pangkalahatang teksto,,0,0,0,,Ngunit para dito
Dialogue: 0,1:00:48.28,1:00:49.53,general text,,0,0,0,,Kailangan ko ng tulong niya
Dialogue: 0,1:01:02.29,1:01:04.50,general text,,0,0,0,,Ito ay isang tula lamang
Dialogue: 0,1:01:05.59,1:01:07.46,pangkalahatang teksto,,0,0,0,,May nakatagong kahulugan ba dito?
Dialogue: 0,1:01:08.88,1:01:10.05,pangkalahatang text,,0,0,0,,Hindi ko alam
Dialogue: 0,1:01:11.09,1:01:13.76,voiceover,,0,0,0,,Siguro ginamit niya ang libro para bumili ng oras
Dialogue: 0,1:01:14.39,1:01:16.35,behind the scenes,,0,0,0,,Kung ganito ang kaso,
Dialogue: 0,1:01:16.85,1:01:18.64,voiceover,,0,0,0,,Kailangan ko siyang tulungan
Dialogue: 0,1:01:19.31,1:01:20.27,general text,,0,0,0,,Bilisan natin
Dialogue: 0,1:01:20.94,1:01:22.10,pangkalahatang text,,0,0,0,,Teka...
Dialogue: 0,1:01:22.19,1:01:25.02,general text,,0,0,0,,gutom na gutom na ako. May makakain ba dito?
Dialogue: 0,1:01:26.11,1:01:27.82,pangkalahatang text,,0,0,0,,Hindi man lang nagkaroon ng oras para mag-almusal
Dialogue: 0,1:01:28.49,1:01:31.74,pangkalahatang teksto,,0,0,0,,Sinasadya mo bang bumili ng oras para kay Sosnovy Bor?
Dialogue: 0,1:01:34.82,1:01:37.74,general text,,0,0,0,,Gusto mo bang bumalik at panoorin ang lahat na nabaliw muli?
Dialogue: 0,1:01:37.83,1:01:39.87,general text,,0,0,0,,Wala akong oras para makipagtalo
Dialogue: 0,1:01:39.95,1:01:41.47,pangkalahatang text,,0,0,0,,Naghihintay ang ina at kapatid na babae
Dialogue: 0,1:01:42.30,1:01:43.76,pangkalahatang teksto,,0,0,0,,Cho Young
Dialogue: 0,1:01:45.30,1:01:46.81,general text,,0,0,0,,Sigurado ka ba,
Dialogue: 0,1:01:47.85,1:01:49.68,general text,,0,0,0,,ano ba itong tunay mong kapatid?
Dialogue: 0,1:01:51.35,1:01:52.39,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:01:52.48,1:01:57.77,general text,,0,0,0,,Ang tunay na salarin ng mga pagpatay na inakusahan ni Moo Deok,
Dialogue: 0,1:01:57.86,1:01:59.57,pangkalahatang teksto,,0,0,0,,isang batang babae na nagngangalang So Yi
Dialogue: 0,1:02:02.03,1:02:03.95,general text,,0,0,0,,Ang babaeng tinatawag mong ate,
Dialogue: 0,1:02:05.32,1:02:06.62,pangkalahatang text,,0,0,0,,the same So I
Dialogue: 0,1:02:08.91,1:02:10.08,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:02:29.39,1:02:33.18,general text,,0,0,0,,Narinig ko sinabi mo kay Cho Young na hindi mo gusto ang babaeng ito
Dialogue: 0,1:02:35.90,1:02:37.02,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:02:38.90,1:02:40.98,pangkalahatang teksto,,0,0,0,,Nanggagaling sa kanya ang masamang enerhiya
Dialogue: 0,1:02:41.07,1:02:43.86,general text,,0,0,0,,ayokong lumapit siya ulit sa akin
Dialogue: 0,1:02:49.87,1:02:52.29,general text,,0,0,0,,Sisiguraduhin kong lagi kang ligtas
Dialogue: 0,1:02:53.12,1:02:54.41,general text,,0,0,0,,Aalisin ko na siya
Dialogue: 0,1:03:00.68,1:03:02.27,pangkalahatang teksto,,0,0,0,,Salamat, nanay
Dialogue: 0,1:03:30.04,1:03:31.34,behind the scenes,,0,0,0,,Nagbago na siya
Dialogue: 0,1:03:32.21,1:03:33.88,voiceover,,0,0,0,,Alam ba niya na substitution ito?
Dialogue: 0,1:03:35.30,1:03:37.30,offscreen,,0,0,0,,Gamitin siya kung alam niyang peke siya?
Dialogue: 0,1:03:39.55,1:03:42.31,pangkalahatang teksto,,0,0,0,,Bakit ka humihinto ng oras, nagtatago sa likod ng tula?
Dialogue: 0,1:03:46.31,1:03:49.31,mga inskripsiyon,,0,0,0,,Chronicle of Jeonbugwan
Dialogue: 0,1:03:52.02,1:03:53.69,italics,,0,0,0,,Ikalimang ng Mayo
Dialogue: 0,1:03:53.78,1:03:55.94,italics,,0,0,0,,Nang sinubukan ni Gwangju Chang Gan na hulihin ang shaman na si Choi,
Dialogue: 0,1:03:56.03,1:03:58.70,italics,,0,0,0,,upang mahatulan siya ng paggamit ng dark magic,
Dialogue: 0,1:03:58.78,1:04:01.28,italics,,0,0,0,,tumalon siya sa apoy
Dialogue: 0,1:04:01.37,1:04:03.12,italics,,0,0,0,,Patay
Dialogue: 0,1:04:04.58,1:04:06.58,pangkalahatang teksto,,0,0,0,,Ang kwento ng shaman Bon mula sa nayon ng Gema
Dialogue: 0,1:04:07.33,1:04:08.67,pangkalahatang teksto,,0,0,0,,naka-save sa mga talaan
Dialogue: 0,1:04:09.25,1:04:13.09,pangkalahatang text,,0,0,0,,Marahil nagkita noon si shaman Choi at Jin Mu
Dialogue: 0,1:04:13.17,1:04:16.30,pangkalahatang text,,0,0,0,,Bakit ba paulit-ulit mong hinahanap itong shaman Choi?
Dialogue: 0,1:04:16.38,1:04:19.80,general text,,0,0,0,,Nahanap mo ba ang bahay na binisita ni Eunuch Kim sa Gema?
Dialogue: 0,1:04:21.19,1:04:22.52,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:04:23.02,1:04:25.69,general text,,0,0,0,,Madalas siyang pumunta sa isang tindahan na may mga halamang gamot
Dialogue: 0,1:04:25.78,1:04:27.15,pangkalahatang teksto,,0,0,0,,Isang tindahan, kung gayon?
Dialogue: 0,1:04:27.78,1:04:30.36,general text,,0,0,0,,Ibinahagi ko ito sa iyo. Ngayon ay iyong turn
Dialogue: 0,1:04:31.95,1:04:33.12,pangkalahatang teksto,,0,0,0,,Eunuch Kim
Dialogue: 0,1:04:33.95,1:04:36.37,general text,,0,0,0,,tawag sa taong pinagsilbihan niya bilang shaman Choi
Dialogue: 0,1:04:40.25,1:04:42.17,pangkalahatang teksto,,0,0,0,,Ang lalaking pinagsilbihan ng bating Kim...
Dialogue: 0,1:04:42.25,1:04:44.00,pangkalahatang teksto,,0,0,0,,Her Majesty the Queen
Dialogue: 0,1:04:46.55,1:04:48.67,italics,,0,0,0,,Alam ko, ikaw mismo ang nagduda sa kanya
Dialogue: 0,1:04:48.76,1:04:51.63,general text,,0,0,0,,Buhay pa ang kaluluwa ng tunay na reyna
Dialogue: 0,1:04:52.47,1:04:55.31,general text,,0,0,0,,Malamang na siya ang pinuntahan ni eunuch Kim
Dialogue: 0,1:04:56.26,1:04:58.10,general text,,0,0,0,,Paano mo malalaman na buhay siya?
Dialogue: 0,1:05:03.15,1:05:05.61,pangkalahatang teksto,,0,0,0,,Nasusunog pa rin ang Lantern ng Buhay ng Reyna
Dialogue: 0,1:05:05.69,1:05:07.53,pangkalahatang teksto,,0,0,0,,Siya ay miyembro ng pamilyang So
Dialogue: 0,1:05:08.19,1:05:09.53,general text,,0,0,0,,Hahanapin ko ang tunay na reyna...
Dialogue: 0,1:05:09.61,1:05:12.66,pangkalahatang teksto,,0,0,0,,at ibubunyag ko ang tunay na diwa ng nakaupo ngayon sa Unified Council
Dialogue: 0,1:05:17.66,1:05:20.04,general text,,0,0,0,,Gusto mo bang isali ako dito?
Dialogue: 0,1:05:20.12,1:05:22.29,pangkalahatang teksto,,0,0,0,,Ito ay may kinalaman sa iyong ina
Dialogue: 0,1:05:28.00,1:05:29.30,pangkalahatang teksto,,0,0,0,,A na may bato
Dialogue: 0,1:05:29.38,1:05:31.51,general text,,0,0,0,,ano ang gagawin mo?
Dialogue: 0,1:05:31.59,1:05:33.47,pangkalahatang teksto,,0,0,0,,Tulad ng ipinamana ni Master Seo Kyung
Dialogue: 0,1:05:33.55,1:05:35.47,pangkalahatang teksto,,0,0,0,,Gagawin ko ang nakasulat sa “Words of the Heart”
Dialogue: 0,1:05:35.55,1:05:36.43,italics,,0,0,0,,Uk
Dialogue: 0,1:05:37.39,1:05:39.61,pangkalahatang teksto,,0,0,0,,Words of the Heart doesn't talk about the stone
Dialogue: 0,1:05:39.69,1:05:43.32,general text,,0,0,0,,Akala ko nagsisinungaling ka para bumili ng oras
Dialogue: 0,1:05:43.40,1:05:44.74,general text,,0,0,0,,Hindi ako nagsinungaling
Dialogue: 0,1:05:45.45,1:05:47.12,general text,,0,0,0,,Ang dahilan talaga
Dialogue: 0,1:05:47.20,1:05:50.12,pangkalahatang teksto,,0,0,0,,isinulat sa tula ni master So Kyung
Dialogue: 0,1:05:55.46,1:05:58.13,pangkalahatang teksto,,0,0,0,,Ang batong yelo ay naglalaman ng kapangyarihan ng Hwangsu. tama?
Dialogue: 0,1:05:58.21,1:06:00.84,pangkalahatang teksto,,0,0,0,,Naglalaman ito ng mga puwersang kumokontrol sa tubig, apoy at hangin
Dialogue: 0,1:06:00.92,1:06:03.84,pangkalahatang teksto,,0,0,0,,At din ang kapangyarihang kumokontrol sa mga kaluluwa ng mga tao
Dialogue: 0,1:06:04.80,1:06:05.89,italics,,0,0,0,,Kaya ang lakas niya
Dialogue: 0,1:06:05.97,1:06:08.18,pangkalahatang teksto,,0,0,0,,dapat ipagbawal para sa sangkatauhan
Dialogue: 0,1:06:08.26,1:06:11.56,pangkalahatang teksto,,0,0,0,,Mahirap paniwalaan na sa napakaliit na piraso ng yelo
Dialogue: 0,1:06:11.64,1:06:12.81,pangkalahatang teksto,,0,0,0,,sobrang lakas
Dialogue: 0,1:06:12.89,1:06:14.39,pangkalahatang teksto,,0,0,0,,Gusto kong makita para sa aking sarili
Dialogue: 0,1:06:18.48,1:06:21.28,pangkalahatang teksto,,0,0,0,,Nakita na ba ng sinuman sa inyo ang pagkilos ng bato?
Dialogue: 0,1:06:24.32,1:06:27.95,general text,,0,0,0,,Nag-away ba talaga kayo sa isang piraso ng yelo na hindi mo man lang nakita ang lakas?
Dialogue: 0,1:06:31.04,1:06:32.66,general text,,0,0,0,,Tapos... baka titingnan natin,
Dialogue: 0,1:06:33.79,1:06:36.08,general text,,0,0,0,,suriin natin ang lakas nito sa harap ng lahat?
Dialogue: 0,1:06:36.87,1:06:38.92,pangkalahatang teksto,,0,0,0,,Paano mo gustong gawin ito?
Dialogue: 0,1:06:39.00,1:06:40.21,pangkalahatang teksto,,0,0,0,,Kung kinokontrol niya ang mga kaluluwa,
Dialogue: 0,1:06:40.92,1:06:43.59,pangkalahatang teksto,,0,0,0,,para mabuhay muli ang patay?
Dialogue: 0,1:06:45.09,1:06:47.80,general text,,0,0,0,,Hindi kulam ang Hwangsu, walang pagbabawal dito
Dialogue: 0,1:06:47.89,1:06:49.60,general text,,0,0,0,,Oo, ibabalik natin ang mga patay, ito ay isang magandang bagay
Dialogue: 0,1:06:51.35,1:06:52.85,general text,,0,0,0,,Chief Jin, nagdala ka ng bato dito,
Dialogue: 0,1:06:54.14,1:06:55.60,pangkalahatang teksto,,0,0,0,,ipakita ang kanyang kapangyarihan
Dialogue: 0,1:06:57.06,1:06:58.40,pangkalahatang teksto,,0,0,0,,Kamahalan,
Dialogue: 0,1:06:58.48,1:07:01.53,pangkalahatang teksto,,0,0,0,,buhay ang lahat dito. Sino ang ipinapanukala mong buhaying muli?
Dialogue: 0,1:07:02.95,1:07:04.62,pangkalahatang teksto,,0,0,0,,Pagkatapos ay pumatay ng isang tao
Dialogue: 0,1:07:10.54,1:07:11.42,general text,,0,0,0,,Nandito ka na
Dialogue: 0,1:07:14.88,1:07:17.05,pangkalahatang teksto,,0,0,0,,Halika rito
Dialogue: 0,1:07:19.34,1:07:20.26,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:07:25.60,1:07:27.23,pangkalahatang teksto,,0,0,0,,Patayin siya at buhayin
Dialogue: 0,1:07:27.81,1:07:29.35,general text,,0,0,0,,Siya ay isang katulong, wala siyang alam na spells
Dialogue: 0,1:07:29.94,1:07:33.15,italics,,0,0,0,,Kaya hindi mo kailangang mag-alala tungkol sa paglapit sa kanya sa bato ng yelo
Dialogue: 0,1:07:33.23,1:07:34.07,italics,,0,0,0,,Kamahalan,
Dialogue: 0,1:07:34.15,1:07:36.53,pangkalahatang text,,0,0,0,,hindi ka makakapatay ng tao dahil lang sa curiosity
Dialogue: 0,1:07:36.61,1:07:38.49,general text,,0,0,0,,Gusto ko lang makita siyang mabuhay
Dialogue: 0,1:07:39.07,1:07:39.95,pangkalahatang teksto,,0,0,0,,gamit ito
Dialogue: 0,1:07:40.03,1:07:42.08,italics,,0,0,0,,Paano ka magtatanong sa isang mahinang babae...
Dialogue: 0,1:07:42.16,1:07:44.45,pangkalahatang text,,0,0,0,,ranasan mo ito?
Dialogue: 0,1:07:48.08,1:07:49.17,pangkalahatang teksto,,0,0,0,,Sagot
Dialogue: 0,1:07:50.25,1:07:51.54,general text,,0,0,0,,Natatakot ka ba?
Dialogue: 0,1:07:55.09,1:07:56.59,general text,,0,0,0,,Babayaran kita ng 100 gold nannies
Dialogue: 0,1:07:57.30,1:07:58.63,pangkalahatang teksto,,0,0,0,,Anong masasabi mo?
Dialogue: 0,1:08:02.01,1:08:03.10,pangkalahatang text,,0,0,0,,Okay
Dialogue: 0,1:08:03.89,1:08:05.06,pangkalahatang teksto,,0,0,0,,Sumasang-ayon ako
Dialogue: 0,1:08:06.47,1:08:07.60,italics,,0,0,0,,Isasakripisyo ko ang sarili ko,
Dialogue: 0,1:08:08.35,1:08:11.90,pangkalahatang teksto,,0,0,0,,upang ipakita ang kapangyarihan na gusto nilang makita
Dialogue: 0,1:08:12.98,1:08:14.86,pangkalahatang teksto,,0,0,0,,lahat ng naroroon
Dialogue: 0,1:08:43.31,1:08:45.69,voiceover,,0,0,0,,Narito ang pagkakataon kong makuha ang ice stone
Dialogue: 0,1:08:47.44,1:08:51.95,voiceover,,0,0,0,,Para dito kailangan ko munang mamatay
Dialogue: 0,1:08:53.66,1:08:57.66,offscreen,,0,0,0,,Walang nagmamalasakit kung mamatay ako o hindi
Dialogue: 0,1:08:58.91,1:09:01.50,behind the scenes,,0,0,0,, Curious lang silang makita
Dialogue: 0,1:09:02.00,1:09:03.96,sa likod ng mga eksena,,0,0,0,,ang kapangyarihan ng bato
Dialogue: 0,1:09:24.35,1:09:26.52,voiceover,,0,0,0,,Hindi ko alam kung mamamatay ako...
Dialogue: 0,1:09:27.02,1:09:30.82,behind the scenes,,0,0,0,,o babawiin ko ang kapangyarihan ko salamat sa bato
Dialogue: 0,1:09:32.07,1:09:34.16,offscreen,,0,0,0,,Nakatayo ako sa gilid ng bangin,
Dialogue: 0,1:09:35.11,1:09:38.16,offscreen,,0,0,0,,at sa harap ko ay isang batong yelo
Dialogue: 0,1:09:38.24,1:09:39.75,memories italics,,0,0,0,,I missed you too
Dialogue: 0,1:09:43.05,1:09:44.05,mga alaala,,0,0,0,,Narito ang sagot ko
Dialogue: 0,1:09:45.22,1:09:48.64,voiceover,,0,0,0,,Natutuwa akong wala ka rito
Dialogue: 0,1:09:49.81,1:09:52.56,italics,,0,0,0,,Words of the Heart talks about the desire to save a loved one
Dialogue: 0,1:09:53.14,1:09:55.19,pangkalahatang teksto,,0,0,0,,Ito ay isang liham mula kay Master Seo Kyung
Dialogue: 0,1:09:55.27,1:09:57.69,pangkalahatang text,,0,0,0,,dedikasyon sa isang namamatay na mahal sa buhay
Dialogue: 0,1:09:57.77,1:10:00.61,general text,,0,0,0,,Isinulat niya na may iniwan siyang isang bagay na makakatulong na mapanatiling malapit ang kanyang minamahal
Dialogue: 0,1:10:00.69,1:10:02.44,general text,,0,0,0,,Gusto mo bang sabihin na ang dakilang bayani,
Dialogue: 0,1:10:03.36,1:10:05.78,pangkalahatang teksto,,0,0,0,,pagsira ng mga bato upang iligtas ang mundo,
Dialogue: 0,1:10:05.86,1:10:09.08,pangkalahatang text,,0,0,0,,gusto mo bang gamitin ito para iligtas ang isang tao?
Dialogue: 0,1:10:09.16,1:10:11.24,pangkalahatang teksto,,0,0,0,,Ang sulat ay sumasalamin sa kabaliwan at sakit ng isang tao,
Dialogue: 0,1:10:11.91,1:10:14.54,pangkalahatang teksto,,0,0,0,,handang sumalungat sa mga batas ng kalikasan, mailigtas lamang ang kanyang minamahal
Dialogue: 0,1:10:15.37,1:10:20.38,general text,,0,0,0,,"Words of the Heart" ang pag-amin ni Master So Kyung
Dialogue: 0,1:10:25.26,1:10:28.01,general text,,0,0,0,,Ayoko rin
Dialogue: 0,1:10:29.80,1:10:32.18,general text,,0,0,0,,Kaya papatayin kita ng walang sakit
Dialogue: 0,1:10:33.89,1:10:36.23,pangkalahatang teksto,,0,0,0,,Hindi ito para ipakita ang aking kamatayan
Dialogue: 0,1:10:37.52,1:10:39.56,general text,,0,0,0,,Ginagawa namin ito para ipakita kung paano ako bubuhayin
Dialogue: 0,1:10:43.19,1:10:44.61,pangkalahatang teksto,,0,0,0,,Buhayin mo ako
Dialogue: 0,1:10:45.65,1:10:47.24,pangkalahatang teksto,,0,0,0,,At huwag biguin ang sinuman
Dialogue: 0,1:10:49.28,1:10:50.99,pangkalahatang teksto,,0,0,0,,Kung gayon, huwag nating biguin ang sinuman
Dialogue: 0,1:10:54.66,1:10:56.79,offscreen,,0,0,0,,Papatayin ng ina ang sarili niyang anak
Dialogue: 0,1:11:52.94,1:11:54.11,mga alaala,,0,0,0,,Ang aking kagandahan
Dialogue: 0,1:11:55.61,1:11:57.40,mga alaala,,0,0,0,,My Boo Young
Dialogue: 0,1:12:06.24,1:12:07.37,pangkalahatang teksto,,0,0,0,,Ina
Dialogue: 0,1:13:06.90,1:13:08.36,preview,,0,0,0,,May nangyaring mali
Dialogue: 0,1:13:08.44,1:13:09.94,preview,,0,0,0,,May nangyari sa ice stone?
Dialogue: 0,1:13:10.03,1:13:13.40,preview,,0,0,0,,Nang malapit na kami sa gate, napahinto kami ng malakas na hangin.
Dialogue: 0,1:13:13.49,1:13:15.20,preview,,0,0,0,,Tiyak na nangyari ito dahil kay Moo Deok
Dialogue: 0,1:13:16.07,1:13:17.70,preview,,0,0,0,,Nandiyan na ang mga bata!
Dialogue: 0,1:13:17.78,1:13:18.83,preview,,0,0,0,,Young Ok!
Dialogue: 0,1:13:18.91,1:13:21.08,preview,,0,0,0,,Kakalabas lang ng energy ko sa espada
Dialogue: 0,1:13:21.16,1:13:23.29,preview,,0,0,0,,Sa tingin ko ang buong problema ay ang hadlang
Dialogue: 0,1:13:23.37,1:13:25.25,preview,,0,0,0,,Nawala na si Master Kahn?
Dialogue: 0,1:13:26.42,1:13:30.09,preview,,0,0,0,,Walang sinuman sa amin ang makakapag-spell dito. Bakit siya nagtagumpay?
Dialogue: 0,1:13:30.17,1:13:31.92,preview,,0,0,0,,Hindi lahat tayo pwedeng mamatay
Dialogue: 0,1:13:32.01,1:13:34.01,preview,,0,0,0,,Aakitin ko siya at ikulong sa isang secret room
Dialogue: 0,1:13:34.09,1:13:35.68,preview,,0,0,0,,Maaaring mamatay si Chan Wook
Dialogue: 0,1:13:36.22,1:13:39.36,preview,,0,0,0,,Kung sarado ang kwarto, malamang patay na siya.
Dialogue: 0,1:13:41.07,1:13:42.69,preview,,0,0,0,,Chan Wook, estudyante ko...
