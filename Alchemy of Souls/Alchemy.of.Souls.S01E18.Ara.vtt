Dialogue: 0,0:00:45.24,0:00:47.66,نص عام,,0,0,0,,هذا نوع من الجنون!
Dialogue: 0,0:00:47.74,0:00:51.04,general text,,0,0,0,,هل قتل الإنسان وإحياؤه هو تسلية؟
Dialogue: 0,0:00:51.12,0:00:53.00,نص عام,,0,0,0,,لا يمكننا التدخل،
Dialogue: 0,0:00:53.08,0:00:55.79,نص عام,,0,0,0,,لأن مو دوك وافق بحماقة
Dialogue: 0,0:00:57.09,0:00:58.30,نص عام,,0,0,0,,هذه الفتاة
Dialogue: 0,0:01:00.76,0:01:02.05,نص عام,,0,0,0,,ابتسم
Dialogue: 0,0:01:02.13,0:01:04.68,ذكريات,,0,0,0,,حسنًا. أنا أوافق
Dialogue: 0,0:01:09.60,0:01:11.39,نص عام,,0,0,0,,وافقت
Dialogue: 0,0:01:11.48,0:01:14.31,نص عام,,0,0,0,,بسبب الذهب الذي سيحصل عليه
Dialogue: 0,0:01:14.90,0:01:17.11,نص عام,,0,0,0,,هل هو حقاً بسبب الذهب
Dialogue: 0,0:01:19.53,0:01:21.61,نص عام,,0,0,0,,هل كانت تبتسم؟
Dialogue: 0,0:01:33.71,0:01:35.96,نص عام,,0,0,0,,أنا لا أحب ذلك أيضًا
Dialogue: 0,0:01:37.04,0:01:39.30,نص عام,,0,0,0,,لذلك سأقتلك دون ألم
Dialogue: 0,0:01:39.38,0:01:41.80,نص عام,,0,0,0,,هذا ليس لإظهار موتي
Dialogue: 0,0:01:42.88,0:01:45.05,general text,,0,0,0,,نحن نفعل هذا لنبين كيف سأقوم من الموت
Dialogue: 0,0:01:47.30,0:01:51.64,general text,,0,0,0,,بمساعدة الكتاب يحاولون كسب الوقت لفضحك.
Dialogue: 0,0:01:52.22,0:01:54.73,italics,,0,0,0,,عندما تموت، سوف يستعينون بقوة الحجر،
Dialogue: 0,0:01:54.81,0:01:58.44,مائل,,0,0,0,,استغل هذا الوقت للانتقال إلى جسدها
Dialogue: 0,0:01:58.52,0:02:02.19,نص عام,,0,0,0,,سينتهي المجلس بوفاة الملكة
Dialogue: 0,0:02:03.11,0:02:07.03,نص عام,,0,0,0,,وسنغادر غابة الصنوبر بهدوء بحجر
Dialogue: 0,0:02:09.78,0:02:13.37,general text,,0,0,0,,أتساءل لماذا اختارها جلالة الملك من بين الجميع؟
Dialogue: 0,0:02:13.45,0:02:16.25,النص العام,,0,0,0,,إنها الأضعف بيننا
Dialogue: 0,0:02:16.33,0:02:17.96,خط مائل,,0,0,0,,لقد قام بالاختيار الصحيح
Dialogue: 0,0:03:26.11,0:03:27.32,ذكريات,,0,0,0,,جميلتي
Dialogue: 0,0:03:28.57,0:03:30.36,ذكريات,,0,0,0,,يا بو يونغ
Dialogue: 0,0:03:39.21,0:03:40.33,نص عام,,0,0,0,,الأم
Dialogue: 0,0:04:10.49,0:04:12.87,نص عام,,0,0,0,,لا أحد ينظر إليك
Dialogue: 0,0:04:12.95,0:04:14.70,نص عام,,0,0,0,,حرك روحك
Dialogue: 0,0:04:15.53,0:04:17.08,نص عام,,0,0,0,,هذا ليس أنا
Dialogue: 0,0:04:17.16,0:04:20.00,نص عام,,0,0,0,,أنا لا أتحكم في الحجر
Dialogue: 0,0:04:20.58,0:04:21.75,نص عام,,0,0,0,,ثم من؟
Dialogue: 0,0:05:08.34,0:05:09.63,نص عام,,0,0,0,,أوقف هذا
Dialogue: 0,0:05:21.39,0:05:23.81,نص عام,,0,0,0,,أمي، هل أنت بخير؟
Dialogue: 0,0:05:28.02,0:05:29.11,نص عام,,0,0,0,,بو يونغ...
Dialogue: 0,0:05:33.15,0:05:35.70,خارج الشاشة,,0,0,0,,هل تعرفت عليها؟ هذا سيء
Dialogue: 0,0:05:36.28,0:05:38.20,خلف الكواليس,,0,0,0,,سوف تعود إلى الحياة الآن
Dialogue: 0,0:05:38.78,0:05:40.12,خلف الكواليس,,0,0,0,,هذا لا يجوز
Dialogue: 0,0:05:40.20,0:05:41.54,التعليق الصوتي,,0,0,0,,يجب أن تموت
Dialogue: 0,0:06:27.08,0:06:28.33,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:06:28.83,0:06:30.59,نص عام,,0,0,0,,أين الحجر؟
Dialogue: 0,0:06:34.46,0:06:35.59,نص عام,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:06:48.31,0:06:49.56,مائل,,0,0,0,,هل رأيته؟
Dialogue: 0,0:06:49.65,0:06:52.82,النص العام,,0,0,0,,لقد اتحدت قوى الحجر والسماء
Dialogue: 0,0:06:52.90,0:06:55.99,نص عام,,0,0,0,,يبدو أن السماء أخذت الحجر
Dialogue: 0,0:06:57.07,0:06:58.61,نص عام,,0,0,0,,الحجر لم يؤخذ
Dialogue: 0,0:07:03.29,0:07:04.45,نص عام,,0,0,0,,ما زال
Dialogue: 0,0:07:05.41,0:07:06.50,نص عام,,0,0,0,,في مكان ما هنا
Dialogue: 0,0:07:06.58,0:07:10.50,نص عام,,0,0,0,,أين هو بالضبط؟
Dialogue: 0,0:07:36.03,0:07:40.24,النص العام,,0,0,0,,رعد وبرق والآن أيضًا ضباب في منتصف النهار؟
Dialogue: 0,0:07:40.32,0:07:41.95,نص عام,,0,0,0,,هذا ليس كل شيء
Dialogue: 0,0:07:42.03,0:07:43.41,نص عام,,0,0,0,,حدث خطأ ما
Dialogue: 0,0:07:50.71,0:07:53.34,general text,,0,0,0,,- هل هذا ما كانوا يغطون به الحجر؟\N- نعم
Dialogue: 0,0:07:53.42,0:07:54.59,النص العام,,0,0,0,,هل حدث شيء للحجر؟
Dialogue: 0,0:07:56.00,0:07:57.46,النص العام,,0,0,0,,هل هذا حلم أم ماذا؟
Dialogue: 0,0:07:57.55,0:08:00.63,النص العام,,0,0,0,,- الزهور في كل مكان\N - كل شيء غير واقعي إلى حد ما
Dialogue: 0,0:08:01.34,0:08:03.35,نص عام,,0,0,0,,هل أمتنا؟
Dialogue: 0,0:08:03.97,0:08:06.43,general text,,0,0,0,,- أهذه هي الحياة الآخرة؟\N- مهلا!
Dialogue: 0,0:08:06.52,0:08:08.14,نص عام,,0,0,0,,توقف عن الكلام الفارغ
Dialogue: 0,0:08:08.23,0:08:11.06,general text,,0,0,0,,إذن أنا الإمبراطور اليشم، وهو جنية؟
Dialogue: 0,0:08:12.94,0:08:14.36,نص عام,,0,0,0,,جنية!
Dialogue: 0,0:08:24.32,0:08:25.62,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:08:26.49,0:08:27.95,نص عام,,0,0,0,,بالتأكيد ليست جنية
Dialogue: 0,0:08:28.83,0:08:30.00,نص عام,,0,0,0,,شبح؟
Dialogue: 0,0:08:39.13,0:08:41.68,النص العام,,0,0,0,,هل أنتم سحرة؟
Dialogue: 0,0:08:42.38,0:08:44.64,النص العام,,0,0,0,,نعم سحرة جيونجينغاك
Dialogue: 0,0:08:48.64,0:08:50.02,نص عام,,0,0,0,,أنت هنا أيضًا يا سيدة هو
Dialogue: 0,0:08:54.31,0:08:55.56,نص عام,,0,0,0,,دعني أذهب
Dialogue: 0,0:08:58.53,0:09:01.78,general text,,0,0,0,,شان ووك، لا تذهب إلى أي مكان، احرس هذا المكان
Dialogue: 0,0:09:02.49,0:09:03.82,نص عام,,0,0,0,,أنتم الثلاثة
Dialogue: 0,0:09:04.61,0:09:05.62,نص عام,,0,0,0,,انظر حولك في المنطقة
Dialogue: 0,0:09:05.70,0:09:09.37,النص العام,,0,0,0,,- سأذهب إلى غرفة التدريب\N- سنرافقك
Dialogue: 0,0:09:12.12,0:09:13.87,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:09:13.96,0:09:15.21,نص عام,,0,0,0,,سمعت الرعد
Dialogue: 0,0:09:15.29,0:09:17.42,نص عام,,0,0,0,,لا نعرف أيضًا
Dialogue: 0,0:09:18.21,0:09:21.21,نص عام,,0,0,0,,سنكتشف ذلك عندما ينقشع الضباب
Dialogue: 0,0:09:21.88,0:09:23.63,النص العام,,0,0,0,,إذا لم يكن هذا حلماً أو حياة آخرة،
Dialogue: 0,0:09:24.22,0:09:26.09,نص عام,,0,0,0,,من أين تأتي كل هذه الزهور؟
Dialogue: 0,0:09:27.18,0:09:28.76,نص عام,,0,0,0,,هل الضباب حقيقي؟
Dialogue: 0,0:10:04.72,0:10:06.18,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:10:06.26,0:10:07.18,نص عام,,0,0,0,,لم تفهم
Dialogue: 0,0:10:07.26,0:10:10.72,general text,,0,0,0,,حاولنا الخروج من البوابة لكن هبت الرياح رجعتنا
Dialogue: 0,0:10:10.81,0:10:11.93,نص عام,,0,0,0,,الريح؟
Dialogue: 0,0:10:13.31,0:10:14.56,نص عام,,0,0,0,,ليس هناك ريح
Dialogue: 0,0:10:18.23,0:10:20.48,نص عام,,0,0,0,,لا تقترب. نحن لا نرى
Dialogue: 0,0:10:20.57,0:10:22.44,نص عام,,0,0,0,,لكن الطاقة المذهلة تحيط بنا
Dialogue: 0,0:10:22.53,0:10:24.78,نص عام,,0,0,0,,ماذا يحدث هنا؟
Dialogue: 0,0:10:24.86,0:10:25.82,نص عام,,0,0,0,,هذا حاجز
Dialogue: 0,0:10:27.24,0:10:29.95,نص عام,,0,0,0,,أعتقد أن هناك حاجزًا حول جيونججينجاك
Dialogue: 0,0:10:30.95,0:10:32.04,نص عام,,0,0,0,,العائق؟
Dialogue: 0,0:10:32.12,0:10:33.62,نص عام,,0,0,0,,من بناها هنا؟
Dialogue: 0,0:10:33.70,0:10:34.87,خط مائل,,0,0,0,,صاحب السمو
Dialogue: 0,0:10:37.08,0:10:38.33,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,0:10:38.42,0:10:40.71,نص عام,,0,0,0,,وريثة جينيوون هنا
Dialogue: 0,0:10:41.46,0:10:43.80,general text,,0,0,0,,جين بو يونغ الذي أحضر حجر الجليد
Dialogue: 0,0:10:43.88,0:10:45.55,نص عام,,0,0,0,,أغمي عليه
Dialogue: 0,0:10:56.89,0:10:57.77,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:11:14.12,0:11:17.79,نص عام,,0,0,0,,طاقة الحجر اخترقت جيونجينغاك
Dialogue: 0,0:11:17.87,0:11:19.88,نص عام,,0,0,0,,وخلق حاجزًا
Dialogue: 0,0:11:21.33,0:11:23.75,نص عام,,0,0,0,,من بالداخل الآن؟
Dialogue: 0,0:11:24.67,0:11:26.59,general text,,0,0,0,,لم يتم العثور على تشان ووك وسيو يول في أي مكان
Dialogue: 0,0:11:26.67,0:11:27.97,نص عام,,0,0,0,,هم على الأرجح هناك
Dialogue: 0,0:11:28.93,0:11:30.51,نص عام,,0,0,0,,الآنسة هو موجودة أيضًا
Dialogue: 0,0:11:30.59,0:11:33.10,النص العام,,0,0,0,,- يا صغيري حسنًا!\N-{\i1} ولي العهد
Dialogue: 0,0:11:33.18,0:11:34.72,النص العام,,0,0,0,,سموه موجود أيضًا
Dialogue: 0,0:11:35.47,0:11:38.94,general text,,0,0,0,,- ماذا؟\N- هل بوم هناك أيضاً؟
Dialogue: 0,0:11:39.02,0:11:41.15,نص عام,,0,0,0,,أين جين هو؟
Dialogue: 0,0:11:42.11,0:11:43.11,خط مائل,,0,0,0,,الرئيس جين,
Dialogue: 0,0:11:43.19,0:11:44.40,نص عام,,0,0,0,,افعل شيئاً
Dialogue: 0,0:11:44.48,0:11:47.69,general text,,0,0,0,,الحجر ابتلع ابنتك أيضاً، ربما تكون هناك أيضاً
Dialogue: 0,0:11:48.32,0:11:50.32,نص عام,,0,0,0,,لا يمكنك التسرع
Dialogue: 0,0:11:50.41,0:11:53.78,general text,,0,0,0,,رأينا ما حدث بعد تدخل جين بو يونغ
Dialogue: 0,0:11:55.08,0:11:57.83,نص عام,,0,0,0,,إنه خطأ جينيوون
Dialogue: 0,0:11:59.29,0:12:01.83,نص عام,,0,0,0,,أردت أن ترى قوة حجر الجليد
Dialogue: 0,0:12:01.92,0:12:03.71,نص عام,,0,0,0,,الآن تريد أن تلومنا؟
Dialogue: 0,0:12:04.75,0:12:07.30,النص العام,,0,0,0,,هل ستتشاجر مرة أخرى؟
Dialogue: 0,0:12:07.38,0:12:10.05,نص عام,,0,0,0,,كفى بالفعل. الاطفال هناك
Dialogue: 0,0:12:10.13,0:12:11.72,نص عام,,0,0,0,,يونغ أوك!
Dialogue: 0,0:12:28.90,0:12:31.15,نص عام,,0,0,0,,يمكنك فعل شيء ما
Dialogue: 0,0:12:31.24,0:12:33.99,نص عام,,0,0,0,,مع حاجز حول جيونجينغاك؟
Dialogue: 0,0:12:34.07,0:12:35.87,نص عام,,0,0,0,,ماذا حدث في قاعة التدريب؟
Dialogue: 0,0:12:37.16,0:12:38.20,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:12:47.96,0:12:50.30,التعليق الصوتي,,0,0,0,,هذا بالتأكيد بسبب مو دوك
Dialogue: 0,0:12:50.38,0:12:53.76,خلف الكواليس,,0,0,0,,لا تزال هي جين بو يونغ الحقيقية من جينيونغ
Dialogue: 0,0:12:54.34,0:12:56.26,خلف الكواليس,,0,0,0,,والجميع يظن أنه أنا
Dialogue: 0,0:12:56.35,0:12:58.60,خارج الشاشة,,0,0,0,,لا أستطيع أن أقول إنها هي
Dialogue: 0,0:12:58.68,0:12:59.56,خلف الكواليس,,0,0,0,,ماذا علي أن أفعل؟
Dialogue: 0,0:13:00.52,0:13:01.85,نص عام,,0,0,0,,الإجابة
Dialogue: 0,0:13:01.94,0:13:03.19,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:13:04.69,0:13:05.98,نص عام,,0,0,0,,لا أعلم
Dialogue: 0,0:13:06.06,0:13:09.32,نص عام,,0,0,0,,أنا أعمى فلم أرى ما حدث
Dialogue: 0,0:13:09.40,0:13:12.15,general text,,0,0,0,,لقد فقدت الوعي عندما ارتفعت الريح واستيقظت للتو.
Dialogue: 0,0:13:12.24,0:13:14.16,نص عام,,0,0,0,,ألا تعرف كيف انتهى بك الأمر هنا؟
Dialogue: 0,0:13:14.24,0:13:16.70,نص عام,,0,0,0,,لا أعرف حتى أين أنا
Dialogue: 0,0:13:16.78,0:13:19.58,نص عام,,0,0,0,,كيف أعرف كيف وصلت إلى هنا؟
Dialogue: 0,0:13:24.00,0:13:26.21,نص عام,,0,0,0,,إنها لا تبدو جيدة جدًا
Dialogue: 0,0:13:27.25,0:13:29.92,النص العام,,0,0,0,,شاحب بالكامل، والعرق على جبهتي
Dialogue: 0,0:13:30.01,0:13:31.59,نص عام,,0,0,0,,ماذا تقول؟
Dialogue: 0,0:13:33.38,0:13:36.22,النص العام,,0,0,0,,إنها بحاجة إلى الراحة أولاً يا صاحب السمو
Dialogue: 0,0:13:39.68,0:13:40.68,نص عام,,0,0,0,,دعه يرتاح
Dialogue: 0,0:13:42.02,0:13:43.02,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:13:48.57,0:13:49.94,نص عام,,0,0,0,,كله كذب
Dialogue: 0,0:13:51.40,0:13:52.69,نص عام,,0,0,0,,ماذا تخفي؟
Dialogue: 0,0:13:52.78,0:13:54.15,نص عام,,0,0,0,,ربما مو دوك يعرف
Dialogue: 0,0:13:54.90,0:13:56.57,general text,,0,0,0,,مو دوك، هل كنت معها؟
Dialogue: 0,0:13:59.20,0:14:00.87,general text,,0,0,0,,مو دوك، كيف وصلت إلى هنا؟
Dialogue: 0,0:14:02.12,0:14:04.79,نص عام,,0,0,0,,كنت هنا طوال الوقت
Dialogue: 0,0:14:07.92,0:14:09.00,نص عام,,0,0,0,,هل كنت هنا؟
Dialogue: 0,0:14:10.05,0:14:12.51,النص العام,,0,0,0,,ألم تسكب الشاي في قاعة الدراسة؟
Dialogue: 0,0:14:13.47,0:14:16.89,general text,,0,0,0,,نعم، ولكن بعد ذلك تبعتك على الفور
Dialogue: 0,0:14:16.97,0:14:19.97,نص عام,,0,0,0,,لا أعرف ماذا حدث حينها
Dialogue: 0,0:14:20.93,0:14:23.85,النص العام,,0,0,0,,ماذا يمكنك أن تسأل خادمة لا تعرف إلا كيف
Dialogue: 0,0:14:24.43,0:14:28.23,النص العام,,0,0,0,,تركض خلف سيدك كالكلب الصغير؟
Dialogue: 0,0:14:28.31,0:14:29.86,خط مائل,,0,0,0,,لا تقلق
Dialogue: 0,0:14:30.36,0:14:32.82,general text,,0,0,0,,وراء الحاجز أفضل سحرة المجلس الموحد
Dialogue: 0,0:14:32.90,0:14:35.28,النص العام,,0,0,0,,سينقذوننا بسرعة
Dialogue: 0,0:14:36.45,0:14:38.28,نص عام,,0,0,0,,أحضروا لسموه الشاي
Dialogue: 0,0:14:38.37,0:14:39.45,نص عام,,0,0,0,,نعم
Dialogue: 0,0:14:51.92,0:14:55.34,نص عام,,0,0,0,,كلب يجري خلف صاحبه
Dialogue: 0,0:14:55.42,0:14:57.38,نص عام,,0,0,0,,خادم لا يعرف شيئاً
Dialogue: 0,0:14:58.93,0:15:00.64,نص عام,,0,0,0,,هذا مو دوك
Dialogue: 0,0:15:06.94,0:15:08.31,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:15:08.40,0:15:10.11,نص عام,,0,0,0,,ولا يوجد ماء
Dialogue: 0,0:16:09.79,0:16:12.75,النص العام,,0,0,0,,الشاي المغلي بالتعويذة ألذ
Dialogue: 0,0:16:14.50,0:16:15.80,نص عام,,0,0,0,,لقد مر وقت طويل
Dialogue: 0,0:16:18.51,0:16:22.97,التعليق الصوتي,,0,0,0,,لقد استعدت قوتي أخيرًا بفضل الحجر
Dialogue: 0,0:16:32.06,0:16:34.81,ذكريات,,0,0,0,,ماذا يحدث؟ أين أنا؟
Dialogue: 0,0:16:36.57,0:16:38.86,ذكريات,,0,0,0,,لن نخسر هذه المرة
Dialogue: 0,0:16:39.69,0:16:41.70,ذكريات,,0,0,0,,نحن في حجر الجليد
Dialogue: 0,0:16:43.32,0:16:45.20,ذكريات,,0,0,0,,هل هذا حجر؟
Dialogue: 0,0:16:45.78,0:16:48.95,ذكريات,,0,0,0,,حجر الجليد لا يقتصر على الحجم أو الشكل
Dialogue: 0,0:16:49.58,0:16:51.79,ذكريات,,0,0,0,,يمكن أن يكون الماء أو النار
Dialogue: 0,0:16:51.87,0:16:53.54,ذكريات,,0,0,0,,أو الريح
Dialogue: 0,0:16:57.67,0:17:00.01,ذكريات,,0,0,0,,إذن الحجر لي الآن؟
Dialogue: 0,0:17:06.97,0:17:09.60,ذكريات,,0,0,0,,لا أحد يستطيع أن يمتلك الحجر
Dialogue: 0,0:17:10.98,0:17:13.06,ذكريات,,0,0,0,,يمكنك فقط استخدام قوتها
Dialogue: 0,0:17:13.14,0:17:15.77,ذكريات,,0,0,0,,إنه مثل الأخذ والعطاء
Dialogue: 0,0:17:15.86,0:17:17.90,ذكريات,,0,0,0,,تكسب شيئًا وتخسر شيئًا
Dialogue: 0,0:17:17.98,0:17:20.94,ذكريات,,0,0,0,,هذا حمل يجب أن تتحمله
Dialogue: 0,0:17:21.03,0:17:23.53,ذكريات,,0,0,0,,سأقبلها بفرح
Dialogue: 0,0:17:23.61,0:17:25.20,ذكريات,,0,0,0,,حسنًا، جربها
Dialogue: 0,0:17:25.28,0:17:27.33,ذكريات,,0,0,0,,الطاقة الزائدة تؤدي إلى
Dialogue: 0,0:17:27.95,0:17:30.66,ذكريات,,0,0,0,,أنك لا تستطيع التحكم في الطاقة التي تستخدمها
Dialogue: 0,0:17:31.45,0:17:34.00,ذكريات,,0,0,0,,إذا أردت المطر سيأتيك الفيضان
Dialogue: 0,0:17:34.83,0:17:37.54,ذكريات,,0,0,0,,إذا أردت الريح سيأتيك إعصار
Dialogue: 0,0:17:38.50,0:17:39.59,ذكريات,,0,0,0,,حاول التأقلم
Dialogue: 0,0:17:40.09,0:17:41.30,ذكريات,,0,0,0,,ماذا أنت؟
Dialogue: 0,0:17:41.88,0:17:43.51,ذكريات,,0,0,0,,بقايا جينيوون؟
Dialogue: 0,0:17:44.43,0:17:46.84,ذكريات,,0,0,0,,كيف تجرؤ الروح التي تعيش في جسدي،
Dialogue: 0,0:17:47.76,0:17:49.22,ذكريات,,0,0,0,,تناديني بقايا؟
Dialogue: 0,0:18:17.96,0:18:19.17,ذكريات,,0,0,0,,جونجينجاك؟
Dialogue: 0,0:18:25.47,0:18:26.88,خلف الكواليس,,0,0,0,,ماذا كان ذلك؟
Dialogue: 0,0:18:28.05,0:18:31.26,خلف الكواليس,,0,0,0,,بقايا جينيوون المعلقة على الحجر؟
Dialogue: 0,0:18:37.56,0:18:39.81,نص عام,,0,0,0,,مو دوك، ما هذا؟
Dialogue: 0,0:18:39.90,0:18:42.57,general text,,0,0,0,,أحضرت للأمير كأسًا مكسورًا؟
Dialogue: 0,0:18:42.65,0:18:44.36,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:18:44.44,0:18:45.53,نص عام,,0,0,0,,سأتغير
Dialogue: 0,0:18:46.07,0:18:49.41,خارج الشاشة,,0,0,0,,توقف. لست بحاجة للخدمة بعد الآن
Dialogue: 0,0:18:49.49,0:18:50.95,نص عام,,0,0,0,,- مو دوك\N- نعم
Dialogue: 0,0:18:51.53,0:18:53.95,نص عام,,0,0,0,,مائة قذرة. امسحها
Dialogue: 0,0:18:54.04,0:18:56.16,خارج الإطار,,0,0,0,,لا داعي للطاعة
Dialogue: 0,0:18:56.75,0:18:58.33,خلف الكواليس,,0,0,0,,هل أصبحت مو دوك حتى النخاع؟
Dialogue: 0,0:19:04.13,0:19:05.76,التعليق الصوتي,,0,0,0,,لم أعد مو دوك بعد الآن
Dialogue: 0,0:19:05.84,0:19:06.76,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:19:12.01,0:19:14.93,نص عام,,0,0,0,,لم نأكل شيئًا منذ بداية المجلس
Dialogue: 0,0:19:15.02,0:19:16.43,نص عام,,0,0,0,,هل لديك شيء لتأكله؟
Dialogue: 0,0:19:17.10,0:19:19.73,نص عام,,0,0,0,,سجيبي سيكون مناسبًا لنا*
Dialogue: 0,0:19:17.10,0:19:19.73,ملاحظات,,0,0,0,,*الحساء الكوري التقليدي مع قطع العجين
Dialogue: 0,0:19:19.81,0:19:20.73,نص عام,,0,0,0,,هل يمكنك فعل ذلك؟
Dialogue: 0,0:19:27.49,0:19:29.95,النص العام,,0,0,0,,آي مو دوك حتى أنتهي من الطبخ
Dialogue: 0,0:19:30.66,0:19:34.29,النص العام,,0,0,0,,وبعد ذلك سأتوقف عن كوني هي
Dialogue: 0,0:19:35.37,0:19:37.71,general text,,0,0,0,,عندما أستطيع توطين روحي من جديد،
Dialogue: 0,0:19:37.79,0:19:40.17,نص عام,,0,0,0,,سأختار أي هيئة
Dialogue: 0,0:19:42.42,0:19:43.96,النص العام,,0,0,0,,يمكنني حتى أن أصبح ملكًا
Dialogue: 0,0:19:51.64,0:19:53.18,general text,,0,0,0,,أو من الأفضل قتل العدو
Dialogue: 0,0:19:53.26,0:19:55.60,النص العام,,0,0,0,,وتأخذ جثته لنفسك؟
Dialogue: 0,0:20:04.77,0:20:05.98,نص عام,,0,0,0,,لا أريد
Dialogue: 0,0:20:07.24,0:20:09.45,النص العام,,0,0,0,,من الأفضل أن تصبح بارك جين
Dialogue: 0,0:20:19.46,0:20:21.37,نص عام,,0,0,0,,يمكنك اختيار أي شخص
Dialogue: 0,0:20:21.96,0:20:23.50,نص عام,,0,0,0,,علينا أن نفكر
Dialogue: 0,0:20:24.96,0:20:26.71,نص عام,,0,0,0,,ممتاز
Dialogue: 0,0:20:26.80,0:20:29.09,general text,,0,0,0,,من المؤسف السماح له بالذهاب إلى سوزهيبي*
Dialogue: 0,0:20:26.80,0:20:29.09,ملاحظات,,0,0,0,,*تُمزق عجينة الحساء باليد
Dialogue: 0,0:20:29.17,0:20:30.76,النص العام,,0,0,0,,ربما ينبغي لنا أن نصنع بعض الكوكسا؟*
Dialogue: 0,0:20:29.17,0:20:30.76,ملاحظات,,0,0,0,,* حساء المعكرونة الباردة
Dialogue: 0,0:20:30.84,0:20:32.80,النص العام,,0,0,0,,تشان ووك يحب الكوكسو
Dialogue: 0,0:20:38.56,0:20:40.64,ذكريات,,0,0,0,,الرائحة ضعيفة جداً
Dialogue: 0,0:20:47.40,0:20:51.32,النص العام,,0,0,0,,هذه هي الوجبة الأخيرة التي يعدها مو ديوك للمالك
Dialogue: 0,0:21:01.29,0:21:02.87,نص عام,,0,0,0,,- السيد\N- نعم؟
Dialogue: 0,0:21:04.25,0:21:07.04,نص عام,,0,0,0,,صنعت الكوكسو فكله
Dialogue: 0,0:21:07.13,0:21:08.34,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:21:12.05,0:21:15.43,النص العام,,0,0,0,,الآن ستتركك خادمتك
Dialogue: 0,0:21:17.35,0:21:18.51,نص عام,,0,0,0,,والمزيد...
Dialogue: 0,0:21:20.39,0:21:22.56,نص عام,,0,0,0,,هنا سأتوقف عن كوني معلمتك
Dialogue: 0,0:21:24.27,0:21:25.31,نص عام,,0,0,0,,هل ستتوقف؟
Dialogue: 0,0:21:27.02,0:21:29.07,نص عام,,0,0,0,,ربما لم تفهم،
Dialogue: 0,0:21:29.82,0:21:31.44,نص عام,,0,0,0,,نحن داخل حجر الجليد
Dialogue: 0,0:21:32.15,0:21:34.32,general text,,0,0,0,,لقد استعدت القوة كما حدث في بحيرة جيونج تشونج دايهو.
Dialogue: 0,0:21:36.95,0:21:38.79,النص العام,,0,0,0,,وأنا أستخدم هذا الحجر في الكيمياء،
Dialogue: 0,0:21:39.74,0:21:41.37,نص عام,,0,0,0,,لمغادرة هذه الهيئة
Dialogue: 0,0:21:43.37,0:21:44.67,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:21:45.71,0:21:47.38,نص عام,,0,0,0,,لن نرى بعضنا البعض مرة أخرى؟
Dialogue: 0,0:21:47.46,0:21:49.34,النص العام,,0,0,0,,لقد التزمنا بإنهاء كل شيء،
Dialogue: 0,0:21:49.92,0:21:51.88,نص عام,,0,0,0,,عندما أستعيد قوتي
Dialogue: 0,0:21:51.96,0:21:54.84,general text,,0,0,0,,ثم التزموا بمناقشة مستقبلنا
Dialogue: 0,0:22:01.85,0:22:03.35,نص عام,,0,0,0,,ليس لنا
Dialogue: 0,0:22:05.52,0:22:06.77,نص عام,,0,0,0,,مستقبل آخر
Dialogue: 0,0:22:15.82,0:22:17.87,ذكريات مائلة,,0,0,0,,تكسب شيئًا وتخسر شيئًا
Dialogue: 0,0:22:17.95,0:22:20.83,ذكريات,,0,0,0,,هذا عبء عليك أن تتحمله
Dialogue: 0,0:22:22.29,0:22:24.41,general text,,0,0,0,,إذا كنت بحاجة إلى خسارتك مقابل السلطة،
Dialogue: 0,0:22:26.00,0:22:27.42,نص عام,,0,0,0,,فليكن
Dialogue: 0,0:22:39.68,0:22:41.60,نص عام,,0,0,0,,- السيد\N- نعم؟
Dialogue: 0,0:22:41.68,0:22:43.77,النص العام,,0,0,0,,صنعت الكوكسو، أكله
Dialogue: 0,0:22:44.52,0:22:46.06,نص عام,,0,0,0,,- و...\N- مو دوك
Dialogue: 0,0:22:46.14,0:22:48.23,نص عام,,0,0,0,,أعتقد أن الحاجز حول جيونجينغاك
Dialogue: 0,0:22:48.31,0:22:50.19,نص عام,,0,0,0,,هذا حجر جليدي
Dialogue: 0,0:22:50.77,0:22:51.61,خلف الكواليس,,0,0,0,,ماذا؟
Dialogue: 0,0:22:52.23,0:22:54.69,خارج الشاشة,,0,0,0,,لم يكن عليه أن يفهم ذلك
Dialogue: 0,0:22:56.20,0:22:58.49,النص العام,,0,0,0,,يقولون الحجر ماء ونار وريح
Dialogue: 0,0:22:59.03,0:23:01.03,نص عام,,0,0,0,,أعتقد أن قوة الريح تغلفنا
Dialogue: 0,0:23:01.91,0:23:04.37,مائل,,0,0,0,,إذا كنا داخل حجر،
Dialogue: 0,0:23:04.91,0:23:08.25,النص العام,,0,0,0,,هل يمكن أخذها دون أن يفهمها أحد؟
Dialogue: 0,0:23:10.96,0:23:12.17,نص عام,,0,0,0,,لا أعلم
Dialogue: 0,0:23:12.25,0:23:13.88,نص عام,,0,0,0,,لقد أتقنت تشيسا
Dialogue: 0,0:23:14.63,0:23:16.47,general text,,0,0,0,,ربما أستطيع الإمساك به مثل السمكة الذهبية؟
Dialogue: 0,0:23:16.55,0:23:19.01,general text,,0,0,0,,قوتك الحالية لا يمكن حتى مقارنتها
Dialogue: 0,0:23:19.59,0:23:20.80,نص عام,,0,0,0,,مع حجر الجليد
Dialogue: 0,0:23:23.10,0:23:26.39,النص العام,,0,0,0,,آمل أن تتمكن من استعادة قوتك، كما فعلت في البحيرة.
Dialogue: 0,0:23:29.19,0:23:30.56,نص عام,,0,0,0,,أعتقد أنك تستطيع فعل ذلك
Dialogue: 0,0:23:33.73,0:23:35.44,نص عام,,0,0,0,,إذا رجعت الكهرباء
Dialogue: 0,0:23:36.11,0:23:38.28,general text,,0,0,0,,وتهرب بالحجر؟
Dialogue: 0,0:23:40.24,0:23:42.99,النص العام,,0,0,0,,قد تُقتل إذا قُبض عليك
Dialogue: 0,0:23:44.20,0:23:45.41,نص عام,,0,0,0,,ألا تخافين؟
Dialogue: 0,0:23:45.49,0:23:48.21,النص العام,,0,0,0,,احتمال أن تهرب بالحجر
Dialogue: 0,0:23:48.29,0:23:50.21,نص عام,,0,0,0,,لطالما كانت موجودة
Dialogue: 0,0:23:51.17,0:23:55.05,النص العام,,0,0,0,,ولقد قلت بالفعل أنني سأتحمل المسؤولية كاملة
Dialogue: 0,0:24:00.09,0:24:01.18,نص عام,,0,0,0,,ولكن
Dialogue: 0,0:24:02.01,0:24:03.55,نص عام,,0,0,0,,أنا خائف قليلاً
Dialogue: 0,0:24:04.93,0:24:09.39,general text,,0,0,0,,أخشى أن تخالف وعدنا وتتركني دون أن تقول وداعًا.
Dialogue: 0,0:24:11.48,0:24:12.44,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,0:24:12.52,0:24:16.23,نص عام,,0,0,0,,لا تتركني وإلا سأبكي كالمجنون
Dialogue: 0,0:24:18.99,0:24:22.66,general text,,0,0,0,,أنت تقول مثل هذه الأشياء المحرجة بسهولة
Dialogue: 0,0:24:23.99,0:24:25.99,النص العام,,0,0,0,,ثم ستندم
Dialogue: 0,0:24:28.33,0:24:31.25,general text,,0,0,0,,قول شيء كهذا ليس بالأمر الصعب، أستطيع تحمل الإحراج
Dialogue: 0,0:24:31.33,0:24:34.92,النص العام,,0,0,0,,لكنني لن أرجع الزمن إلى الوراء ولو ندمت على شيء
Dialogue: 0,0:24:36.59,0:24:39.30,نص عام,,0,0,0,,يا معلم تجنب الإحراج
Dialogue: 0,0:24:39.38,0:24:40.88,نص عام,,0,0,0,,وكن صادقاً مع نفسك
Dialogue: 0,0:24:40.97,0:24:43.89,النص العام,,0,0,0,,إذن فلن تندم على شيء
Dialogue: 0,0:24:49.73,0:24:52.02,النص العام,,0,0,0,,- تشان ووك، أنا...\N{\i1}- السيد
Dialogue: 0,0:24:55.65,0:24:56.73,نص عام,,0,0,0,,سأكون هناك على الفور
Dialogue: 0,0:24:57.48,0:24:59.57,النص العام,,0,0,0,,لديها مفتاح القاعة التي بها كتب محرمة
Dialogue: 0,0:24:59.65,0:25:02.32,نص عام,,0,0,0,,بما أننا هنا، أريد أن أبحث عن شيء ما
Dialogue: 0,0:25:03.36,0:25:04.45,خط مائل,,0,0,0,,بالمناسبة
Dialogue: 0,0:25:10.29,0:25:11.87,نص عام,,0,0,0,,تناولها بنفسك. لا تشارك مع أي شخص
Dialogue: 0,0:25:37.69,0:25:41.28,نص عام,,0,0,0,,هل تبحث عن كتب عن السحر الأسود؟
Dialogue: 0,0:25:41.36,0:25:43.49,نص عام,,0,0,0,,نعم سمعت أن والدي غادر هنا
Dialogue: 0,0:25:43.57,0:25:47.03,نص عام,,0,0,0,,جميع الكتب عن السحر الأسود التي وصلتني من الشامان
Dialogue: 0,0:25:48.83,0:25:50.33,نص عام,,0,0,0,,أريد العثور عليهم
Dialogue: 0,0:25:53.41,0:25:55.42,نص عام,,0,0,0,,هذه هي كتب غوانغجو تشانغ جانج
Dialogue: 0,0:25:56.50,0:25:57.96,نص عام,,0,0,0,,سأساعدك
Dialogue: 0,0:25:58.04,0:26:01.51,نص عام,,0,0,0,,يمكنني التعامل مع الأمر بنفسي. يمكنك أن تترك لي المفتاح وتذهب
Dialogue: 0,0:26:02.92,0:26:05.38,نص عام,,0,0,0,,لقد عهدني بها جدي
Dialogue: 0,0:26:05.47,0:26:07.43,general text,,0,0,0,,كيف أتأكد أنك لن تخسره؟
Dialogue: 0,0:26:07.51,0:26:11.52,نص عام,,0,0,0,,حسنًا، نعم. لا يوجد إيمان بي. شكرا لمساعدتكم
Dialogue: 0,0:26:29.33,0:26:31.41,نص عام,,0,0,0,,فإنتبه
Dialogue: 0,0:26:32.12,0:26:36.75,النص العام,,0,0,0,,هناك ما يكفي من الغرف والطعام المجاني في جيونغجينجاك
Dialogue: 0,0:26:36.83,0:26:40.25,خط مائل,,0,0,0,,فلا تقلق كثيرًا
Dialogue: 0,0:26:40.34,0:26:41.42,خط مائل,,0,0,0,,دعونا نحافظ على هدوئنا
Dialogue: 0,0:26:41.50,0:26:42.63,نص عام,,0,0,0,,حسنًا؟
Dialogue: 0,0:26:51.64,0:26:54.60,نص عام,,0,0,0,,اذهب إلى كيسان وأرسل الجميع هنا
Dialogue: 0,0:26:54.68,0:26:57.44,general text,,0,0,0,,لدينا أيضًا حقوق في قوة حجر الجليد
Dialogue: 0,0:26:57.52,0:26:58.60,نص عام,,0,0,0,,نعم
Dialogue: 0,0:27:01.73,0:27:03.94,نص عام,,0,0,0,,اجمع كل من يستطيع إلقاء التعويذات
Dialogue: 0,0:27:04.03,0:27:05.90,نص عام,,0,0,0,,حتى الأطفال وكبار السن
Dialogue: 0,0:27:05.99,0:27:07.24,نص عام,,0,0,0,,- نعم سيدي\N- حسنًا
Dialogue: 0,0:27:15.16,0:27:18.29,general text,,0,0,0,,اجمع كل سحرة جيونبوجوان وأرسلهم إلى سوسنوفي بور
Dialogue: 0,0:27:18.37,0:27:20.92,general text,,0,0,0,,قد يندلع قتال على حجر الجليد
Dialogue: 0,0:27:21.42,0:27:22.92,نص عام,,0,0,0,,يجب أن نكون مستعدين
Dialogue: 0,0:27:23.00,0:27:24.21,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:27:31.97,0:27:32.85,نص عام,,0,0,0,,جلالتك
Dialogue: 0,0:27:32.93,0:27:34.77,نص عام,,0,0,0,,تبدو مريضًا
Dialogue: 0,0:27:34.85,0:27:36.85,نص عام,,0,0,0,,عليك العودة إلى القصر
Dialogue: 0,0:27:37.69,0:27:40.73,نص عام,,0,0,0,,يجب أن أرى هذا بأم عيني
Dialogue: 0,0:27:41.77,0:27:43.27,نص عام,,0,0,0,,رأينا حجرًا جليديًا،
Dialogue: 0,0:27:44.36,0:27:46.28,نص عام,,0,0,0,,مما يعني أن نجم الملك ليس بعيداً
Dialogue: 0,0:28:01.50,0:28:04.96,general text,,0,0,0,,ربما الجميع ينتظر منا أن نحضر "كلمات من القلب"
Dialogue: 0,0:28:06.51,0:28:07.84,نص عام,,0,0,0,,فلنسرع
Dialogue: 0,0:28:16.39,0:28:17.43,نص عام,,0,0,0,,سيدي.
Dialogue: 0,0:28:17.52,0:28:18.89,نص عام,,0,0,0,,جلبنا "كلمات من القلب"
Dialogue: 0,0:28:18.98,0:28:20.81,نص عام,,0,0,0,,لا وقت لهم الآن
Dialogue: 0,0:28:20.90,0:28:22.69,النص العام,,0,0,0,,ظهر حاجز حول جيونججينجاك
Dialogue: 0,0:28:23.27,0:28:24.40,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:28:32.32,0:28:34.12,خارج الشاشة,,0,0,0,,هل سيتم القبض علي؟
Dialogue: 0,0:28:36.29,0:28:38.33,خارج الشاشة,,0,0,0,,إذن سيقتلون حتماً
Dialogue: 0,0:29:00.02,0:29:01.35,نص عام,,0,0,0,,هذه كعكات العسل
Dialogue: 0,0:29:02.19,0:29:05.06,النص العام,,0,0,0,,لم تأكل شيئًا تقريبًا. ساعد نفسك
Dialogue: 0,0:29:09.61,0:29:11.28,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:29:13.16,0:29:16.24,general text,,0,0,0,,هل تفاجأت كثيراً عندما علمت أنني ابنة عائلة جين؟
Dialogue: 0,0:29:16.78,0:29:19.75,نص عام,,0,0,0,,عندما التقينا للمرة الأولى، لم أكن أعرف والديّ بعد
Dialogue: 0,0:29:21.12,0:29:22.54,نص عام,,0,0,0,,هذه مظلتك
Dialogue: 0,0:29:24.17,0:29:26.42,نص عام,,0,0,0,,حملته معي في كل مكان
Dialogue: 0,0:29:26.50,0:29:28.71,نص عام,,0,0,0,,كنت أتمنى أن تتعرف علي إذا التقينا مرة أخرى
Dialogue: 0,0:29:32.01,0:29:35.14,general text,,0,0,0,,مساعد غوانغجو جين مو ساعدك في العثور على والديك؟
Dialogue: 0,0:29:35.22,0:29:36.22,نص عام,,0,0,0,,نعم
Dialogue: 0,0:29:38.18,0:29:42.43,نص عام,,0,0,0,,من فضلك لا تخبره أننا التقينا من قبل
Dialogue: 0,0:29:44.60,0:29:46.69,نص عام,,0,0,0,,إذا اكتشفت الأم الأمر،
Dialogue: 0,0:29:46.77,0:29:49.40,general text,,0,0,0,,ما مررت به سوف يكسر قلبها
Dialogue: 0,0:29:51.15,0:29:53.11,نص عام,,0,0,0,,فلا تخبريه
Dialogue: 0,0:29:54.53,0:29:56.66,خارج الشاشة,,0,0,0,,قُتل كل من عرفها
Dialogue: 0,0:29:57.24,0:29:58.66,التعليق الصوتي,,0,0,0,,لقد أنقذتني؟
Dialogue: 0,0:30:01.37,0:30:04.50,ذكريات,,0,0,0,,جين مو ليس لديه أي فكرة أننا نعرف من هي
Dialogue: 0,0:30:05.04,0:30:06.29,ذكريات,,0,0,0,,هذه نقطة ضعفه
Dialogue: 0,0:30:06.79,0:30:10.42,ذكريات,,0,0,0,,لا بد أنه قتل الجميع لإخفاء هويتها
Dialogue: 0,0:30:10.50,0:30:13.26,ذكريات,,0,0,0,,وفي النهاية ستموت هي أيضاً
Dialogue: 0,0:30:13.88,0:30:16.64,ذكريات,,0,0,0,,إذا كانت الملكة تخطط لنقل الروح إلى جسدها...
Dialogue: 0,0:30:17.22,0:30:18.55,ذكريات,,0,0,0,,لقد أحضرت إلى هنا لتقتل
Dialogue: 0,0:30:18.64,0:30:21.31,ذكريات,,0,0,0,,ليس لديها أدنى فكرة عن أي شيء وتفعل كل ما في وسعها
Dialogue: 0,0:30:21.39,0:30:23.06,الذكريات,,0,0,0,,جين مو يستخدمها
Dialogue: 0,0:30:24.27,0:30:26.23,ذكريات,,0,0,0,,تمامًا مثل ناك سو
Dialogue: 0,0:30:29.94,0:30:32.15,ذكريات,,0,0,0,,لذا فإن "يي" أيضًا مجرد فتاة فقيرة
Dialogue: 0,0:30:34.61,0:30:35.78,نص عام,,0,0,0,,سيد.
Dialogue: 0,0:30:36.36,0:30:37.61,نص عام,,0,0,0,,هل تعلم,
Dialogue: 0,0:30:37.70,0:30:40.03,نص عام,,0,0,0,,أن هذه المظلة لا تقوم بعملها؟
Dialogue: 0,0:30:42.08,0:30:45.29,نص عام,,0,0,0,,انظر. انها ممزقة بالفعل
Dialogue: 0,0:30:46.96,0:30:48.04,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:30:48.13,0:30:50.38,النص العام,,0,0,0,,إنه غالي الثمن، قال البائع أنه عالي الجودة
Dialogue: 0,0:30:50.46,0:30:52.25,نص عام,,0,0,0,,لابد أنك مخدوع
Dialogue: 0,0:30:58.47,0:31:00.01,نص عام,,0,0,0,,أنا واثق جدًا
Dialogue: 0,0:31:00.93,0:31:02.18,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:31:42.55,0:31:44.68,خط مائل,,0,0,0,,هل السيد خان مفقود؟
Dialogue: 0,0:31:45.35,0:31:48.23,النص العام,,0,0,0,,امتص طاقتها وغادر
Dialogue: 0,0:31:48.73,0:31:51.23,نص عام,,0,0,0,,لم نتمكن من العثور عليه سايجوكون
Dialogue: 0,0:31:51.31,0:31:54.36,نص عام,,0,0,0,,انعقد المجلس الموحد بجوار قاعات التدريب
Dialogue: 0,0:31:54.44,0:31:55.65,نص عام,,0,0,0,,من غير المرجح أنه ذهب إلى هناك
Dialogue: 0,0:31:55.73,0:31:57.65,نص عام,,0,0,0,,كان هناك ارتباك طوال اليوم،
Dialogue: 0,0:31:57.74,0:31:59.45,نص عام,,0,0,0,,لكننا لاحظنا ذلك
Dialogue: 0,0:31:59.53,0:32:02.78,النص العام,,0,0,0,,هناك مكان يمكن أن يختبئ فيه
Dialogue: 0,0:32:03.45,0:32:04.83,نص عام,,0,0,0,,وتمر مرور الكرام
Dialogue: 0,0:32:07.54,0:32:09.37,نص عام,,0,0,0,,داخل الحاجز
Dialogue: 0,0:32:10.46,0:32:12.42,نص عام,,0,0,0,,قد يكون هناك
Dialogue: 0,0:32:50.33,0:32:51.62,نص عام,,0,0,0,,بدوي
Dialogue: 0,0:32:54.59,0:32:56.00,نص عام,,0,0,0,,أنا مع جين مو
Dialogue: 0,0:33:00.84,0:33:02.09,نص عام,,0,0,0,,أنا أعرفك
Dialogue: 0,0:33:02.76,0:33:04.72,general text,,0,0,0,,لقد رأيتك تحرك روحك في جيونبوغوان
Dialogue: 0,0:33:04.80,0:33:07.10,النص العام,,0,0,0,,لقد غادرت روحك جسدك القديم
Dialogue: 0,0:33:17.82,0:33:20.99,نص عام,,0,0,0,,نحن في نفس الجانب. أنقذني
Dialogue: 0,0:33:23.41,0:33:25.41,نص عام,,0,0,0,,الآن أنا بحاجة للطاقة البشرية
Dialogue: 0,0:33:25.49,0:33:27.12,نص عام,,0,0,0,,سأحضر لك شخصًا
Dialogue: 0,0:33:27.20,0:33:28.99,النص العام,,0,0,0,,طاقة سحرة جيونجينغاك
Dialogue: 0,0:33:29.08,0:33:31.58,النص العام,,0,0,0,,سيكون أفضل مني
Dialogue: 0,0:33:32.21,0:33:33.75,خط مائل,,0,0,0,,انتظر هنا،
Dialogue: 0,0:33:33.83,0:33:35.79,نص عام,,0,0,0,,سأجذب شخصًا ما إلى هنا
Dialogue: 0,0:33:37.50,0:33:39.59,النص العام,,0,0,0,,- مجوس جيونجينغاك؟\N- {\i1}نعم
Dialogue: 0,0:33:39.67,0:33:41.34,نص عام,,0,0,0,,بسبب الحاجز لا أحد يستطيع
Dialogue: 0,0:33:41.42,0:33:43.72,نص عام,,0,0,0,,لا تغادر ولا تدخل تشونغجينجاك
Dialogue: 0,0:33:44.34,0:33:46.09,نص عام,,0,0,0,,العائق؟
Dialogue: 0,0:34:01.65,0:34:03.03,نص عام,,0,0,0,,آنسة جين؟
Dialogue: 0,0:34:03.61,0:34:05.28,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:34:05.36,0:34:07.28,نص عام,,0,0,0,,كنت أبحث عن شيء ما،
Dialogue: 0,0:34:07.37,0:34:09.91,نص عام,,0,0,0,,ولكن بعد ذلك أسقطت مظلتي، لا أستطيع المشي بدونها
Dialogue: 0,0:34:11.66,0:34:12.91,نص عام,,0,0,0,,ها هو ذا
Dialogue: 0,0:34:49.24,0:34:50.53,خط مائل,,0,0,0,,لن أقتلك
Dialogue: 0,0:34:50.62,0:34:53.12,نص عام,,0,0,0,,أحضروا المزيد من السحرة
Dialogue: 0,0:34:53.70,0:34:54.79,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:34:58.50,0:34:59.96,نص عام,,0,0,0,,لذا يول...
Dialogue: 0,0:35:00.67,0:35:02.21,نص عام,,0,0,0,,أيضًا في جيونجينغاك؟
Dialogue: 0,0:35:04.88,0:35:05.80,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:35:09.30,0:35:10.93,مائل,,0,0,0,,جرحني بالسيف
Dialogue: 0,0:35:11.51,0:35:13.10,نص عام,,0,0,0,,سأقتله أولاً
Dialogue: 0,0:35:14.43,0:35:15.60,نص عام,,0,0,0,,ها هو
Dialogue: 0,0:35:16.48,0:35:17.64,نص عام,,0,0,0,,لا
Dialogue: 0,0:35:21.11,0:35:22.48,نص عام,,0,0,0,,إذا رفضت،
Dialogue: 0,0:35:24.19,0:35:25.53,نص عام,,0,0,0,,سأقتلك
Dialogue: 0,0:35:25.61,0:35:26.61,نص عام,,0,0,0,,سأفعل كل شيء
Dialogue: 0,0:35:28.20,0:35:30.74,نص عام,,0,0,0,,هناك شخص أريد التخلص منه
Dialogue: 0,0:35:32.16,0:35:33.83,نص عام,,0,0,0,,سأعطيه
Dialogue: 0,0:35:35.33,0:35:37.00,نص عام,,0,0,0,,من فضلك اقتلها
Dialogue: 0,0:35:50.89,0:35:53.18,النص العام,,0,0,0,,الوجبات الخفيفة ليست لذيذة
Dialogue: 0,0:35:53.26,0:35:54.47,نص عام,,0,0,0,,كوكسو أيضًا
Dialogue: 0,0:35:56.02,0:35:57.77,التعليق الصوتي,,0,0,0,,لم أتحدث إلى تشان ووك بعد،
Dialogue: 0,0:35:58.35,0:36:00.10,خلف الكواليس,,0,0,0,,لذا سأبقى مع مو دوك لفترة أطول قليلاً
Dialogue: 0,0:36:01.15,0:36:02.69,نص عام,,0,0,0,,أنا آسف
Dialogue: 0,0:36:03.94,0:36:05.86,النص العام,,0,0,0,,هذا هو نبيذ الفصل الذي أخفاه دان غو
Dialogue: 0,0:36:13.62,0:36:14.95,نص عام,,0,0,0,,كيف تحب الطعم؟
Dialogue: 0,0:36:16.24,0:36:17.79,نص عام,,0,0,0,,ليس سيئًا
Dialogue: 0,0:36:18.37,0:36:20.04,خط مائل,,0,0,0,,أتساءل ماذا يفعلون في الخارج،
Dialogue: 0,0:36:20.12,0:36:22.67,general text,,0,0,0,,- بما أن هذه المشكلة لم تحل بعد\N{\i1}- ما زال,
Dialogue: 0,0:36:22.75,0:36:26.21,نص عام,,0,0,0,,هناك زهور في الجوار، والطقس جميل،
Dialogue: 0,0:36:26.30,0:36:28.97,نص عام,,0,0,0,,كل شيء عطر. انها ليست بهذا السوء
Dialogue: 0,0:36:30.13,0:36:31.05,نص عام,,0,0,0,,جلالتك
Dialogue: 0,0:36:31.13,0:36:32.89,نص عام,,0,0,0,,الإعجاب بالزهور أمر ممل
Dialogue: 0,0:36:32.97,0:36:34.93,النص العام,,0,0,0,,هل تريد رؤية تقنية Hyonggon؟
Dialogue: 0,0:36:35.56,0:36:38.14,نص عام,,0,0,0,,هذه تقنية مثيرة للاهتمام للغاية
Dialogue: 0,0:36:38.23,0:36:39.27,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:36:40.06,0:36:41.19,نص عام,,0,0,0,,حسنًا أرني
Dialogue: 0,0:36:41.77,0:36:42.94,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:37:28.86,0:37:29.90,خط مائل,,0,0,0,,ماذا؟..
Dialogue: 0,0:37:29.99,0:37:31.78,النص العام,,0,0,0,,- بوم!\N - بوم!
Dialogue: 0,0:37:32.90,0:37:34.41,نص عام,,0,0,0,,بوم، استيقظ
Dialogue: 0,0:37:34.49,0:37:35.70,خط مائل,,0,0,0,,- هيا!\N- مرحبًا
Dialogue: 0,0:37:35.78,0:37:37.91,خط مائل,,0,0,0,,- فلنرفعه\N- بوم
Dialogue: 0,0:37:40.45,0:37:42.54,general text,,0,0,0,,بعد التعويذة هل فارقتك طاقتك؟
Dialogue: 0,0:37:42.62,0:37:43.46,نص عام,,0,0,0,,نعم
Dialogue: 0,0:37:43.54,0:37:45.75,النص العام,,0,0,0,,شعرت بالطاقة التي تتركني
Dialogue: 0,0:37:45.83,0:37:46.92,نص عام,,0,0,0,,كأنه
Dialogue: 0,0:37:48.13,0:37:50.30,نص عام,,0,0,0,,الطاقة تنسكب كأنها من مزهرية مكسورة
Dialogue: 0,0:37:51.17,0:37:52.72,نص عام,,0,0,0,,لقد تحققت من قلب طاقته،
Dialogue: 0,0:37:52.80,0:37:54.55,نص عام,,0,0,0,,فقد معظمه
Dialogue: 0,0:37:56.34,0:37:57.85,النص العام,,0,0,0,,كيف يمكن أن أفقد الطاقة؟
Dialogue: 0,0:38:08.40,0:38:09.86,نص عام,,0,0,0,,ربما هو السيف؟
Dialogue: 0,0:38:27.75,0:38:30.17,النص العام,,0,0,0,,طاقتي خرجت للتو من خلال السيف
Dialogue: 0,0:38:30.75,0:38:32.76,نص عام,,0,0,0,,أعتقد أن المشكلة في العائق
Dialogue: 0,0:38:34.80,0:38:36.76,general text,,0,0,0,,يبدو أنه يستهلك الطاقة،
Dialogue: 0,0:38:38.97,0:38:40.51,نص عام,,0,0,0,,عند استخدام التعويذات
Dialogue: 0,0:38:54.53,0:38:56.32,نص عام,,0,0,0,,لا يمكنك استخدام التعويذات
Dialogue: 0,0:38:56.40,0:38:58.03,نص عام,,0,0,0,,وسحب السيوف
Dialogue: 0,0:38:58.82,0:39:00.41,نص عام,,0,0,0,,دعونا نترك السيوف هنا
Dialogue: 0,0:39:09.13,0:39:11.63,النص العام,,0,0,0,,هذا هو سيف ناك سو. أخذها المعلم لي مني
Dialogue: 0,0:39:12.17,0:39:13.30,نص عام,,0,0,0,,هل حصلت عليه؟
Dialogue: 0,0:39:13.38,0:39:15.97,نص عام,,0,0,0,,نعم. وطلب مني الاحتفاظ به
Dialogue: 0,0:39:16.05,0:39:17.84,نص عام,,0,0,0,,لكن الخادمة كيم لم يعجبها وجوده في المنزل
Dialogue: 0,0:39:17.93,0:39:19.34,نص عام,,0,0,0,,لذلك تركته هنا
Dialogue: 0,0:39:34.03,0:39:35.86,ذكريات بخط مائل,,0,0,0,,خذ هذا
Dialogue: 0,0:39:35.94,0:39:37.61,ذكريات,,0,0,0,,واعطيه إياها عندما يعود
Dialogue: 0,0:39:39.57,0:39:42.16,النص العام,,0,0,0,,لا أستطيع المغادرة وقد تم تكليفي بهذا الأمر
Dialogue: 0,0:39:43.29,0:39:44.49,خط مائل,,0,0,0,,عذراء كيم
Dialogue: 0,0:39:45.62,0:39:46.87,نص عام,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:39:46.96,0:39:49.42,نص عام,,0,0,0,,هل سار المجلس الموحد على ما يرام؟
Dialogue: 0,0:39:49.50,0:39:50.83,نص عام,,0,0,0,,بالكاد
Dialogue: 0,0:39:50.92,0:39:54.17,general text,,0,0,0,,السحرة من جميع العائلات يتجهون الآن إلى سوسنوفي بور
Dialogue: 0,0:39:55.09,0:39:57.05,نص عام,,0,0,0,,لا بد أن شيئًا ما قد حدث
Dialogue: 0,0:39:58.63,0:40:01.93,ذكريات بخط مائل,,0,0,0,,سيعود بسبب كل هذا الاضطراب
Dialogue: 0,0:40:09.23,0:40:11.98,general text,,0,0,0,,هل يعود "غوانغجو تشانغ جانج" حقًا؟
Dialogue: 0,0:40:36.09,0:40:38.13,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:40:41.22,0:40:42.43,نص عام,,0,0,0,,غوانغجو
Dialogue: 0,0:40:47.43,0:40:51.65,general text,,0,0,0,,من هو مساعد النائب جين مو الآن؟
Dialogue: 0,0:41:16.54,0:41:19.76,ذكريات,,0,0,0,,هدد تشو تشان بالكشف عن حقيقة السيد الشاب تشان
Dialogue: 0,0:41:19.84,0:41:23.09,ذكريات,,0,0,0,,لم يكن لدي خيار سوى أن أعلمه كيمياء النفوس
Dialogue: 0,0:41:23.64,0:41:27.10,الذكريات,,0,0,0,,لقد أصبح جامحًا ومات، فانتهى الأمر؟
Dialogue: 0,0:41:27.93,0:41:31.27,ذكريات بخط مائل,,0,0,0,,فعلت هذا من أجلك أنت وابنك فقط
Dialogue: 0,0:41:32.10,0:41:35.94,ذكريات,,0,0,0,,بسبب السحر فقدت زوجتي وصديقًا مقربًا
Dialogue: 0,0:41:37.19,0:41:39.28,ذكريات,,0,0,0,,سأتخلص من كل العواكس المتبقية
Dialogue: 0,0:41:39.90,0:41:42.15,ذكريات,,0,0,0,,سأغلق حجر الجليد في بحيرة جيونج تشونج دايهو
Dialogue: 0,0:41:42.78,0:41:43.91,ذكريات,,0,0,0,,لا...
Dialogue: 0,0:41:44.86,0:41:47.49,ذكريات,,0,0,0,,لقد بذلت الكثير لتحصل عليها...
Dialogue: 0,0:41:47.58,0:41:49.45,ذكريات,,0,0,0,,كيف يمكنك التخلص من الحجر؟
Dialogue: 0,0:41:49.54,0:41:50.66,ذكريات,,0,0,0,,لا يمكنك فعل ذلك!
Dialogue: 0,0:41:52.21,0:41:54.29,ذكريات,,0,0,0,,أنت تعرف أيضًا الكيمياء،
Dialogue: 0,0:41:55.13,0:41:57.96,ذكريات,,0,0,0,,لذلك سأدمر جوهر طاقتك
Dialogue: 0,0:41:58.04,0:41:59.46,ذكريات,,0,0,0,,هل تدمر النواة؟
Dialogue: 0,0:42:00.71,0:42:02.17,ذكريات,,0,0,0,,لا تفعل ذلك
Dialogue: 0,0:42:09.22,0:42:12.02,ذكريات بخط مائل,,0,0,0,,من فضلك لا تدمرها
Dialogue: 0,0:42:12.10,0:42:15.27,ذكريات,,0,0,0,,أقسم ألا أستخدم كيمياء الروح أبدًا،
Dialogue: 0,0:42:15.77,0:42:19.11,ذكريات,,0,0,0,,التي علمتني إياها. أعدك!
Dialogue: 0,0:42:37.58,0:42:40.84,خلف الكواليس,,0,0,0,,كان الأمر يستحق تدمير جوهره إذن
Dialogue: 0,0:42:43.13,0:42:46.34,خارج الشاشة,,0,0,0,,بدلاً من إخفاء حجر الجليد،
Dialogue: 0,0:42:46.93,0:42:48.85,خارج الشاشة,,0,0,0,,كان يجب أن أدمره أيضًا
Dialogue: 0,0:42:51.18,0:42:53.89,خلف الكواليس,,0,0,0,,كيف تمكن من الحصول عليها
Dialogue: 0,0:42:55.27,0:42:57.23,خلف الكواليس,,0,0,0,,من بحيرة جيونج تشونج دايهو؟
Dialogue: 0,0:42:58.31,0:42:59.90,خارج الشاشة,,0,0,0,,هل ساعده أحد؟
Dialogue: 0,0:43:31.68,0:43:33.43,نص عام,,0,0,0,,أنا بخير
Dialogue: 0,0:43:35.14,0:43:37.56,نص عام,,0,0,0,,ولكن بيننا فرق واحد
Dialogue: 0,0:43:38.94,0:43:40.19,نص عام,,0,0,0,,أنا
Dialogue: 0,0:43:42.44,0:43:43.94,نص عام,,0,0,0,,بدوي
Dialogue: 0,0:43:47.32,0:43:48.66,نص عام,,0,0,0,,يا بوم
Dialogue: 0,0:43:49.53,0:43:50.91,النص العام,,0,0,0,,التمارين الرياضية ستعيدك إلى لياقتك البدنية
Dialogue: 0,0:43:51.49,0:43:54.16,مائل,,0,0,0,,إنه على حق، كل شيء سيكون على ما يرام
Dialogue: 0,0:43:54.24,0:43:55.45,نص عام,,0,0,0,,ابتهج
Dialogue: 0,0:43:55.54,0:43:58.62,خارج الشاشة,,0,0,0,,حجر الجليد يمتص طاقتهم
Dialogue: 0,0:43:58.71,0:44:01.67,خارج الشاشة,,0,0,0,,إذا غيرت جسدي وأخذت الحجر،
Dialogue: 0,0:44:02.25,0:44:04.92,التعليق الصوتي,,0,0,0,,هل سأستنزف طاقتهم أيضًا؟
Dialogue: 0,0:44:05.63,0:44:08.01,ذكريات مائلة,,0,0,0,,تكسب شيئًا وتخسر شيئًا
Dialogue: 0,0:44:08.09,0:44:10.84,ذكريات,,0,0,0,,هذا عبء يجب أن تتحمله
Dialogue: 0,0:44:11.89,0:44:13.72,نص عام,,0,0,0,,إذا كنت أريد استعادة قوتي،
Dialogue: 0,0:44:15.85,0:44:18.14,النص العام,,0,0,0,,سأضطر إلى استيعاب طاقتهم
Dialogue: 0,0:44:19.44,0:44:20.35,خط مائل,,0,0,0,,ثم
Dialogue: 0,0:44:21.02,0:44:22.48,النص العام,,0,0,0,,سيموتون جميعاً
Dialogue: 0,0:44:33.58,0:44:35.20,نص عام,,0,0,0,,سأكون مسؤولاً
Dialogue: 0,0:44:36.16,0:44:38.04,نص عام,,0,0,0,,في وفاتهم
Dialogue: 0,0:44:41.79,0:44:44.54,general text,,0,0,0,,وون مو ديوك، ماذا تفعل هنا؟
Dialogue: 0,0:44:50.80,0:44:52.34,خارج الشاشة,,0,0,0,,سوف يموت أيضاً
Dialogue: 0,0:44:53.14,0:44:54.47,خط مائل,,0,0,0,,الوضع خطير هنا
Dialogue: 0,0:44:54.55,0:44:56.60,نص عام,,0,0,0,,إذا لمست الحاجز،
Dialogue: 0,0:44:56.68,0:44:58.64,النص العام,,0,0,0,,سوف تكسر كل عظامك
Dialogue: 0,0:44:58.73,0:45:00.23,نص عام,,0,0,0,,ابتعد
Dialogue: 0,0:45:04.40,0:45:06.11,نص عام,,0,0,0,,هل تود أن تشكرني؟
Dialogue: 0,0:45:07.94,0:45:10.24,نص عام,,0,0,0,,لقد أظهرت الاهتمام بك
Dialogue: 0,0:45:13.28,0:45:15.33,نص عام,,0,0,0,,لقد فقدت طاقتك في وقت سابق
Dialogue: 0,0:45:16.24,0:45:17.54,نص عام,,0,0,0,,كيف تشعر؟
Dialogue: 0,0:45:19.70,0:45:22.17,general text,,0,0,0,,هل تعبر عن الامتنان بالقلق عليّ؟
Dialogue: 0,0:45:23.25,0:45:24.38,نص عام,,0,0,0,,ليس سيئًا
Dialogue: 0,0:45:25.50,0:45:27.25,نص عام,,0,0,0,,أنا بخير
Dialogue: 0,0:45:28.42,0:45:29.59,نص عام,,0,0,0,,سامحوني
Dialogue: 0,0:45:29.67,0:45:30.92,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:45:31.01,0:45:34.51,نص عام,,0,0,0,,لتحضير الوجبات الخفيفة الرهيبة والكوكسا
Dialogue: 0,0:45:35.05,0:45:36.72,نص عام,,0,0,0,,لم تتمكن حتى من تناول الطعام
Dialogue: 0,0:45:42.35,0:45:43.94,نص عام,,0,0,0,,خذ هذا
Dialogue: 0,0:45:48.36,0:45:49.98,نص عام,,0,0,0,,ملفات تعريف الارتباط المفضلة لدى تشان ووك
Dialogue: 0,0:45:50.49,0:45:52.86,general text,,0,0,0,,هل تشاركني ما أعطاك إياه؟
Dialogue: 0,0:45:52.95,0:45:55.45,مائل,,0,0,0,,لا حاجة، احتفظ بها لنفسك
Dialogue: 0,0:45:57.37,0:46:00.37,نص عام,,0,0,0,,أعلم أنه يجب أن آخذهم
Dialogue: 0,0:46:01.87,0:46:05.67,النص العام,,0,0,0,,لكنني قررت أن أعطيك إياهم. الكل
Dialogue: 0,0:46:08.63,0:46:10.25,نص عام,,0,0,0,,أعطيتهم لك
Dialogue: 0,0:46:11.80,0:46:14.88,التعليق الصوتي,,0,0,0,,إنه ليس ألطف شخص، لكنه كان يعتني بي طوال هذا الوقت
Dialogue: 0,0:46:18.47,0:46:19.35,خط مائل,,0,0,0,,خذ
Dialogue: 0,0:46:19.43,0:46:21.56,نص عام,,0,0,0,,أريد أن أشكرك بصدق
Dialogue: 0,0:46:22.93,0:46:24.89,نص عام,,0,0,0,,- مع خالص التقدير؟{\i1}\N- نعم
Dialogue: 0,0:46:25.56,0:46:26.94,نص عام,,0,0,0,,من أعماق قلبي
Dialogue: 0,0:46:28.40,0:46:30.23,نص عام,,0,0,0,,أنا ممتن لك دائمًا
Dialogue: 0,0:46:34.65,0:46:37.28,نص عام,,0,0,0,,إذا كنت تريد أن تشكرني بصدق،
Dialogue: 0,0:46:38.12,0:46:41.33,نص عام,,0,0,0,,أعطني شيئًا أكثر
Dialogue: 0,0:46:42.79,0:46:44.33,نص عام,,0,0,0,,شيء أكثر أهمية
Dialogue: 0,0:46:51.63,0:46:52.92,نص عام,,0,0,0,,فقط اقبلها
Dialogue: 0,0:46:54.42,0:46:56.34,نص عام,,0,0,0,,هذا ما تحتاجه
Dialogue: 0,0:47:00.22,0:47:02.14,نص عام,,0,0,0,,أنت مذهل
Dialogue: 0,0:47:04.18,0:47:07.15,النص العام,,0,0,0,,اجرؤ دائمًا وحقق هدفك
Dialogue: 0,0:47:07.73,0:47:10.52,مائل,,0,0,0,,لكن في كل مرة أتواصل معك تتراجع
Dialogue: 0,0:47:13.65,0:47:16.45,نص عام,,0,0,0,,السبب الذي يجعلني لا أحاول إعاقتك هو،
Dialogue: 0,0:47:17.11,0:47:19.49,general text,,0,0,0,,ماذا لو كنت في النهاية لا تزال ترفضني، أنا...
Dialogue: 0,0:47:24.79,0:47:27.54,general text,,0,0,0,,انس الأمر، لن أقبل امتنانك بهذا القدر
Dialogue: 0,0:47:41.01,0:47:43.77,النص العام,,0,0,0,,سأشعر بأنني أقل فظاعة إذا قبل ذلك
Dialogue: 0,0:47:47.77,0:47:48.90,خلف الكواليس,,0,0,0,,هذا أفضل
Dialogue: 0,0:47:49.69,0:47:52.15,التعليق الصوتي,,0,0,0,,لا ينبغي أن أشعر بالذنب
Dialogue: 0,0:48:16.46,0:48:17.30,خط مائل,,0,0,0,,مو دوك
Dialogue: 0,0:48:20.18,0:48:21.64,نص عام,,0,0,0,,لدي طلب لك
Dialogue: 0,0:48:22.35,0:48:24.60,general text,,0,0,0,,هل يمكنك الذهاب إلى جناح السحرة من أجلي؟
Dialogue: 0,0:48:25.89,0:48:27.06,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:48:27.14,0:48:30.14,نص عام,,0,0,0,,الجو بارد هنا. هل يمكنك أن تحضر لي بطانية؟
Dialogue: 0,0:48:31.06,0:48:32.65,نص عام,,0,0,0,,سمعت أنهم مخزنون هناك
Dialogue: 0,0:48:46.83,0:48:48.04,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:49:08.18,0:49:09.85,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:49:09.93,0:49:12.06,نص عام,,0,0,0,,محاولة إبقاء النار مشتعلة في الموقد
Dialogue: 0,0:49:31.00,0:49:32.00,نص عام,,0,0,0,,واو
Dialogue: 0,0:49:32.92,0:49:34.21,نص عام,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:49:34.79,0:49:36.04,النص العام,,0,0,0,,هل أنت غبي تمامًا؟
Dialogue: 0,0:49:38.71,0:49:39.92,نص عام,,0,0,0,,توقف
Dialogue: 0,0:49:43.01,0:49:45.80,النص العام,,0,0,0,,لقد وصفتني للتو بالأحمق؟
Dialogue: 0,0:49:45.89,0:49:47.56,نص عام,,0,0,0,,هناك مئات الكتب هنا
Dialogue: 0,0:49:47.64,0:49:49.22,النص العام,,0,0,0,,يمكنك حرقهم جميعًا
Dialogue: 0,0:49:49.31,0:49:51.27,النص العام,,0,0,0,,سيطرت على النار بالتعويذة
Dialogue: 0,0:49:51.35,0:49:52.77,النص العام,,0,0,0,,لا أستطيع استخدام القوة،
Dialogue: 0,0:49:54.02,0:49:55.31,نص عام,,0,0,0,,محتار جدًا
Dialogue: 0,0:49:55.40,0:49:58.77,نص عام,,0,0,0,,لكن يمكنك تغطيته بغطاء فقط
Dialogue: 0,0:49:58.86,0:50:00.57,خط مائل,,0,0,0,,الناس يسمونك بالعبقري
Dialogue: 0,0:50:00.65,0:50:02.57,النص العام,,0,0,0,,لكنك تفقد السيطرة في المواقف الصعبة
Dialogue: 0,0:50:02.65,0:50:05.03,general text,,0,0,0,,- أنت مجرد أحمق{\i1}\N- لا تهينني
Dialogue: 0,0:50:05.11,0:50:06.66,نص عام,,0,0,0,,سأشعر بالإهانة
Dialogue: 0,0:50:08.49,0:50:10.08,نص عام,,0,0,0,,حتى تعرف كيف تشعر بالإهانة
Dialogue: 0,0:50:11.37,0:50:13.54,النص العام,,0,0,0,,أنت دائمًا هادئ كالماء
Dialogue: 0,0:50:14.04,0:50:16.79,النص العام,,0,0,0,,حتى الماء يمكن أن يغلي أو يتجمد
Dialogue: 0,0:50:17.67,0:50:19.17,خط مائل,,0,0,0,,إنها لا تظل هادئة دائمًا
Dialogue: 0,0:50:27.43,0:50:29.85,النص العام,,0,0,0,,أصبحت رطبة بسبب الضباب
Dialogue: 0,0:50:29.93,0:50:32.48,general text,,0,0,0,,هل أشعلت حريقاً لأن ساقك تؤلمك؟
Dialogue: 0,0:50:34.85,0:50:37.40,نص عام,,0,0,0,,هل تتذكر هذا
Dialogue: 0,0:50:38.86,0:50:40.02,خط مائل,,0,0,0,,أنا بخير
Dialogue: 0,0:50:40.11,0:50:41.28,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:50:45.28,0:50:47.66,النص العام,,0,0,0,,هل تحب شاي إبرة الصنوبر
Dialogue: 0,0:50:49.66,0:50:51.16,نص عام,,0,0,0,,لكنني لم أتمكن من تحضيرها لك
Dialogue: 0,0:50:52.20,0:50:53.70,نص عام,,0,0,0,,أنت تتذكر هذا أيضًا
Dialogue: 0,0:50:55.54,0:50:57.08,نص عام,,0,0,0,,وما الفائدة من هذا؟
Dialogue: 0,0:50:57.79,0:50:59.54,نص عام,,0,0,0,,فقط تذكر
Dialogue: 0,0:51:00.42,0:51:02.67,نص عام,,0,0,0,,اصنعه في المرة القادمة
Dialogue: 0,0:51:05.72,0:51:07.30,خلف الكواليس,,0,0,0,,لن يكون هناك مرة قادمة
Dialogue: 0,0:51:07.39,0:51:11.51,التعليق الصوتي,,0,0,0,,إذا غيرت جسدي، فسوف يموت أيضًا
Dialogue: 0,0:51:11.60,0:51:12.47,خط مائل,,0,0,0,,أو أفضل
Dialogue: 0,0:51:12.56,0:51:14.85,نص عام,,0,0,0,,علمني
Dialogue: 0,0:51:14.93,0:51:17.90,نص عام,,0,0,0,,ثم سأقوم بإعداده بنفسي. مثل المرة الماضية
Dialogue: 0,0:51:18.56,0:51:19.86,خط مائل,,0,0,0,,تذكر؟
Dialogue: 0,0:51:27.11,0:51:28.24,نص عام,,0,0,0,,أقدر ذلك
Dialogue: 0,0:51:29.12,0:51:31.12,نص عام,,0,0,0,,كل الذكريات من دانهيانغوك
Dialogue: 0,0:51:40.79,0:51:43.75,خارج الشاشة,,0,0,0,,لذلك سيموت يول
Dialogue: 0,0:51:48.63,0:51:51.60,general text,,0,0,0,,ذهبت إلى جناح السحرة للحصول على بطانية
Dialogue: 0,0:51:51.68,0:51:53.06,نص عام,,0,0,0,,سأذهب
Dialogue: 0,0:52:01.15,0:52:04.07,نص عام,,0,0,0,,سأذهب وأنت تذهب إلى أوكو
Dialogue: 0,0:52:13.58,0:52:15.33,نص عام,,0,0,0,,إنه يبحث عنك في كل مكان
Dialogue: 0,0:52:27.92,0:52:29.63,التعليق الصوتي,,0,0,0,,أريد فقط أن أكون ناك سو مرة أخرى
Dialogue: 0,0:52:30.89,0:52:33.18,التعليق الصوتي,,0,0,0,,لقد قطعت الاتصال به بالفعل في الماضي
Dialogue: 0,0:52:35.22,0:52:36.97,التعليق الصوتي,,0,0,0,,سأفعل الشيء نفسه مع الجميع
Dialogue: 0,0:52:50.24,0:52:53.12,النص العام,,0,0,0,,لن ينكسر الحاجز عن بصرك
Dialogue: 0,0:52:59.71,0:53:00.79,نص عام,,0,0,0,,هل رأيت؟
Dialogue: 0,0:53:01.62,0:53:03.21,نص عام,,0,0,0,,مر الحجر من خلاله
Dialogue: 0,0:53:04.04,0:53:05.09,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:53:06.00,0:53:08.21,general text,,0,0,0,,ربما الأشياء المصنوعة من الماء فقط هي التي لا يمكنها المرور
Dialogue: 0,0:53:08.30,0:53:09.80,مائل,,0,0,0,,يا له من حاجز غريب
Dialogue: 0,0:53:09.88,0:53:12.76,نص عام,,0,0,0,,يقرر ما يجب تخطيه
Dialogue: 0,0:53:12.84,0:53:14.30,نص عام,,0,0,0,,ما نوع هذا الحاجز؟
Dialogue: 0,0:53:15.01,0:53:16.68,نص عام,,0,0,0,,وماذا يفعل الآخرون؟
Dialogue: 0,0:53:16.76,0:53:20.52,general text,,0,0,0,,هناك الكثير من السحرة العظماء هناك، لكنهم ما زالوا غير قادرين على كسره
Dialogue: 0,0:53:21.94,0:53:23.69,general text,,0,0,0,,هل لأن حجر الجليد خلقه؟
Dialogue: 0,0:53:23.77,0:53:27.61,general text,,0,0,0,,ربما يكونان مشغولين بالجدال حول من سيحصل على الحجر
Dialogue: 0,0:53:27.69,0:53:30.82,نص عام,,0,0,0,,لكنهم يعلمون أنني محبوس هنا
Dialogue: 0,0:53:32.45,0:53:37.20,general text,,0,0,0,,ربما لست بهذه الأهمية بالنسبة للملكة التي لديها حجر الجليد
Dialogue: 0,0:53:38.66,0:53:40.12,مائل,,0,0,0,,كيف يمكن للأم أن تتصرف هكذا؟
Dialogue: 0,0:53:41.12,0:53:43.04,النص العام,,0,0,0,,أم أنها تشبه والدي؟
Dialogue: 0,0:53:45.21,0:53:46.71,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:53:46.79,0:53:50.46,general text,,0,0,0,,كما تعلمين، هي ليست أمي الحقيقية
Dialogue: 0,0:53:51.55,0:53:53.47,النص العام,,0,0,0,,مثل والدك لك
Dialogue: 0,0:53:55.64,0:53:57.14,نص عام,,0,0,0,,الجميع يتحدث عنها
Dialogue: 0,0:53:57.97,0:53:59.89,النص العام,,0,0,0,,لن أعتذر حتى لو جرحتك
Dialogue: 0,0:54:00.60,0:54:02.48,نص عام,,0,0,0,,إذن لن أتجول في الأدغال أيضًا
Dialogue: 0,0:54:03.19,0:54:06.90,general text,,0,0,0,,إذا عرضت عليك الملكة وجين مو قوة حجر الجليد،
Dialogue: 0,0:54:06.98,0:54:08.36,نص عام,,0,0,0,,هل تستطيع التخلص منهم؟
Dialogue: 0,0:54:11.36,0:54:15.66,general text,,0,0,0,,سيكون من الصعب رفض مثل هذه القوة المذهلة
Dialogue: 0,0:54:16.62,0:54:17.83,نص عام,,0,0,0,,أنت شجاع
Dialogue: 0,0:54:19.33,0:54:21.95,general text,,0,0,0,,الاعتراف بجشعك يتطلب الشجاعة
Dialogue: 0,0:54:26.29,0:54:29.80,نص عام,,0,0,0,,وأنت؟ ماذا ستفعل لو كان لديك؟
Dialogue: 0,0:54:33.30,0:54:35.18,نص عام,,0,0,0,,سأتصرف مثل المعلمة سو كيونغ
Dialogue: 0,0:54:35.26,0:54:36.43,نص عام,,0,0,0,,إذن كيونغ؟
Dialogue: 0,0:54:38.01,0:54:40.76,general text,,0,0,0,,هل تريد أن تصبح بطلاً بمصير نجم ملكي،
Dialogue: 0,0:54:40.85,0:54:42.77,general text,,0,0,0,,تدمير كل الحجارة وإنقاذ العالم؟
Dialogue: 0,0:54:42.85,0:54:46.44,نص عام,,0,0,0,,أنا متأكد من أنه فعل ذلك بأفضل النوايا.
Dialogue: 0,0:54:47.52,0:54:50.86,general text,,0,0,0,,وأعتقد أنه ترك حجراً واحداً لإنقاذ من أحب.
Dialogue: 0,0:54:51.48,0:54:53.11,نص عام,,0,0,0,,أيضًا مع أفضل النوايا
Dialogue: 0,0:54:53.61,0:54:56.07,النص العام,,0,0,0,,كما ترى، هذا الجزء يتردد صداه أكثر بالنسبة لي
Dialogue: 0,0:54:59.41,0:55:01.91,نص عام,,0,0,0,,هذا ما كتبه في كتابه
Dialogue: 0,0:55:01.99,0:55:05.29,النص العام,,0,0,0,,هذا مجرد عذر لعدم القدرة على التخلص من الحجر
Dialogue: 0,0:55:06.08,0:55:07.37,نص عام,,0,0,0,,من سيصدق هذا؟
Dialogue: 0,0:55:07.46,0:55:08.83,نص عام,,0,0,0,,أعتقد
Dialogue: 0,0:55:10.79,0:55:13.46,نص عام,,0,0,0,,لأنني سأفعل نفس الشيء
Dialogue: 0,0:55:31.02,0:55:32.19,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:55:32.27,0:55:34.07,نص عام,,0,0,0,,أحجار تمر عبر الحاجز
Dialogue: 0,0:55:34.15,0:55:36.61,نص عام,,0,0,0,,أرسل لهم رسالة حتى يتمكنوا من إنقاذك بسرعة
Dialogue: 0,0:55:39.82,0:55:40.66,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:55:42.12,0:55:43.24,نص عام,,0,0,0,,أنت عبقري
Dialogue: 0,0:55:47.25,0:55:48.33,نص عام,,0,0,0,,دعونا نرى
Dialogue: 0,0:55:51.67,0:55:53.84,النص العام,,0,0,0,,- الحاجز{\i1}\N- مرحبًا تشان ووك
Dialogue: 0,0:55:54.59,0:55:56.42,النص العام,,0,0,0,,هل هناك حجر أكبر؟
Dialogue: 0,0:55:56.51,0:55:58.30,نص عام,,0,0,0,,عليهم فقط قراءة رسالتك
Dialogue: 0,0:55:58.38,0:56:00.09,نص عام,,0,0,0,,لست بحاجة إلى حجر كبير
Dialogue: 0,0:56:00.18,0:56:01.68,مائل,,0,0,0,,يجب كتابته بأحرف كبيرة
Dialogue: 0,0:56:02.39,0:56:04.56,النص العام,,0,0,0,,هذا الحجر لا يمكن رفعه؟
Dialogue: 0,0:56:07.43,0:56:08.69,النص العام,,0,0,0,,- دعونا نشرب\N- دعونا نشرب
Dialogue: 0,0:56:09.69,0:56:12.27,نص عام,,0,0,0,,بالمناسبة، لماذا لم يخبرنا دان جو أبدًا
Dialogue: 0,0:56:12.36,0:56:14.86,خط مائل,,0,0,0,,عن مخزونك السري من الكحول؟
Dialogue: 0,0:56:14.94,0:56:17.28,مائل,,0,0,0,,يجب أن نشرب كل شيء هنا، نشرب
Dialogue: 0,0:56:17.36,0:56:19.78,خط مائل,,0,0,0,,- دعنا نشرب\N- دعنا نشرب
Dialogue: 0,0:56:24.49,0:56:25.87,نص عام,,0,0,0,,لقد أحضرت مجمرة أخرى
Dialogue: 0,0:56:28.25,0:56:29.46,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:56:30.04,0:56:31.83,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:56:31.92,0:56:33.00,نص عام,,0,0,0,,بأي معنى؟
Dialogue: 0,0:56:35.00,0:56:37.59,نص عام,,0,0,0,,سيد. ذهب يول لإحضار البطانية بنفسه
Dialogue: 0,0:56:40.84,0:56:42.64,ذكريات بخط مائل,,0,0,0,,يول موجود أيضًا في جيونجينغاك
Dialogue: 0,0:56:42.72,0:56:44.60,ذكريات,,0,0,0,,سأقتله أولاً
Dialogue: 0,0:57:15.09,0:57:17.59,نص عام,,0,0,0,,سيدي. يول، غير مسموح لك بالدخول هناك
Dialogue: 0,0:57:18.84,0:57:21.18,النص العام,,0,0,0,,- ماذا حدث؟\N- ارجع للخلف
Dialogue: 0,0:57:22.89,0:57:25.30,نص عام,,0,0,0,,هل تستطيع رؤيتي؟
Dialogue: 0,0:57:25.89,0:57:27.43,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:58:00.18,0:58:01.72,نص عام,,0,0,0,,سيد!
Dialogue: 0,0:58:32.17,0:58:33.38,خط مائل,,0,0,0,,سيد.
Dialogue: 0,0:58:35.34,0:58:38.55,نص عام,,0,0,0,,سيدي ماذا علينا أن نفعل؟
Dialogue: 0,0:58:56.99,0:58:58.15,خط مائل,,0,0,0,,ماذا أفعل؟
Dialogue: 0,0:59:22.22,0:59:23.47,خط مائل,,0,0,0,,ما هذا؟
Dialogue: 0,0:59:23.55,0:59:25.64,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:59:54.29,0:59:55.71,نص عام,,0,0,0,,يول!
Dialogue: 0,0:59:55.79,0:59:56.63,نص عام,,0,0,0,,يول!
Dialogue: 0,1:00:03.09,1:00:05.47,نص عام,,0,0,0,,- سيد\N- هل أنت بخير؟
Dialogue: 0,1:00:37.25,1:00:38.38,نص عام,,0,0,0,,يول
Dialogue: 0,1:00:40.05,1:00:41.84,نص عام,,0,0,0,,- ماذا حدث؟{\i1}\N- Nomad
Dialogue: 0,1:00:41.92,1:00:43.09,نص عام,,0,0,0,,هناك بدوي هنا
Dialogue: 0,1:00:43.18,1:00:44.43,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:00:47.93,1:00:49.26,نص عام,,0,0,0,,هناك بدوي
Dialogue: 0,1:00:49.35,1:00:51.98,مائل,,0,0,0,,لقد امتص طاقة يون سو وجين هو
Dialogue: 0,1:01:07.62,1:01:10.79,general text,,0,0,0,,البدوي هو سيد كان ديجانتونجون، وهو قوي جدًا
Dialogue: 0,1:01:10.87,1:01:14.21,نص عام,,0,0,0,,واستخدم الطاقة في إلقاء التعويذة
Dialogue: 0,1:01:14.29,1:01:16.54,نص عام,,0,0,0,,لا أحد منا يستطيع استخدام القوة هنا
Dialogue: 0,1:01:17.21,1:01:18.63,general text,,0,0,0,,لماذا ينجح؟
Dialogue: 0,1:01:18.71,1:01:21.09,نص عام,,0,0,0,,هذا المكان يمتص طاقتنا،
Dialogue: 0,1:01:21.17,1:01:22.63,نص عام,,0,0,0,,ولكن بالنسبة لهم فإن الأمر على العكس من ذلك، على ما يبدو
Dialogue: 0,1:01:25.59,1:01:27.43,ذكريات بخط مائل,,0,0,0,,إذا استعدت قوتي
Dialogue: 0,1:01:28.05,1:01:30.22,ذكريات,,0,0,0,,وهرب بالحجر؟
Dialogue: 0,1:01:30.89,1:01:33.64,ذكريات,,0,0,0,,إذا تم القبض عليك، فقد تُقتل
Dialogue: 0,1:01:35.10,1:01:36.31,ذكريات,,0,0,0,,ألا تخافين؟
Dialogue: 0,1:01:36.40,1:01:38.48,ذكريات,,0,0,0,,أنا خائفة قليلاً
Dialogue: 0,1:01:38.56,1:01:41.07,ذكريات,,0,0,0,,أخشى أن تخالف وعدنا
Dialogue: 0,1:01:41.15,1:01:42.99,ذكريات,,0,0,0,,وتركتني دون حتى أن تقول وداعاً
Dialogue: 0,1:01:45.40,1:01:47.70,ذكريات,,0,0,0,,- تشان ووك، أنا...\N{\i1}- السيد
Dialogue: 0,1:01:52.16,1:01:55.12,نص عام,,0,0,0,,أين مو دوك؟
Dialogue: 0,1:01:55.71,1:01:57.50,نص عام,,0,0,0,,كانت هنا منذ وقت ليس ببعيد
Dialogue: 0,1:01:58.13,1:01:59.38,مائل,,0,0,0,,أين ذهبت؟
Dialogue: 0,1:02:06.09,1:02:07.97,نص عام,,0,0,0,,لقد ظهرت المشكلة
Dialogue: 0,1:02:18.44,1:02:20.77,general text,,0,0,0,,إذا لم يتم إيقافه فسوف يموتون جميعًا
Dialogue: 0,1:02:22.82,1:02:25.69,general text,,0,0,0,,سيظلون يموتون إذا غيرت أجسادهم
Dialogue: 0,1:02:25.78,1:02:27.70,نص عام,,0,0,0,,من المضحك أن ننقذهم الآن
Dialogue: 0,1:02:28.82,1:02:30.70,نص عام,,0,0,0,,لذلك سأقطع الاتصال بهم
Dialogue: 0,1:02:35.50,1:02:37.75,نص عام,,0,0,0,,لكنني مازلت غير مرتاح
Dialogue: 0,1:02:38.33,1:02:41.08,النص العام,,0,0,0,,ستكون هذه آخر مرة أحفظهم فيها
Dialogue: 0,1:02:42.00,1:02:43.17,نص عام,,0,0,0,,مرة أخرى
Dialogue: 0,1:02:45.63,1:02:46.72,نص عام,,0,0,0,,أنت...
Dialogue: 0,1:02:48.01,1:02:50.72,النص العام,,0,0,0,,- أين كنت؟\N- جئت
Dialogue: 0,1:02:51.22,1:02:52.30,نص عام,,0,0,0,,المملكة المتحدة...
Dialogue: 0,1:02:52.93,1:02:54.14,النص العام,,0,0,0,,يمكن أن يموت تشان ووك!
Dialogue: 0,1:03:15.58,1:03:17.37,ذكريات بخط مائل,,0,0,0,,لا أحد يستطيع هزيمته الآن
Dialogue: 0,1:03:18.08,1:03:19.71,ذكريات بخط مائل,,0,0,0,,لا يمكن أن نموت جميعًا
Dialogue: 0,1:03:19.79,1:03:22.25,ذكريات بخط مائل,,0,0,0,,سأحاول استدراجه إلى الغرفة السرية
Dialogue: 0,1:03:25.92,1:03:28.92,مائل,,0,0,0,,عندما يحبس البدو معه في الغرفة السرية،
Dialogue: 0,1:03:29.01,1:03:30.34,النص العام,,0,0,0,,المملكة المتحدة ستموت أيضًا
Dialogue: 0,1:03:30.88,1:03:31.97,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,1:03:32.72,1:03:34.30,general text,,0,0,0,,لماذا ذهب بمفرده؟
Dialogue: 0,1:03:35.22,1:03:37.60,مائل,,0,0,0,,قال إنه يجب عليه ذلك
Dialogue: 0,1:03:37.68,1:03:39.10,نص عام,,0,0,0,,قال إنها مسؤوليته
Dialogue: 0,1:03:46.48,1:03:49.07,النص العام,,0,0,0,,- إلى أين أنت ذاهب؟\N- إلى الغرفة السرية
Dialogue: 0,1:03:50.45,1:03:52.45,نص عام,,0,0,0,,إذا كان باب الغرفة السرية مفتوحاً،
Dialogue: 0,1:03:53.87,1:03:56.41,النص العام,,0,0,0,,مما يعني أن أوك مات ولم يتمكن من استدراجه إلى هناك
Dialogue: 0,1:03:56.49,1:03:57.99,مائل,,0,0,0,,إذا كان الباب مغلقاً،
Dialogue: 0,1:03:58.91,1:04:00.54,مائل,,0,0,0,,فمن المحتمل أنه مات بالفعل
Dialogue: 0,1:04:01.29,1:04:02.50,نص عام,,0,0,0,,هذا غير منطقي
Dialogue: 0,1:04:04.79,1:04:07.67,نص عام,,0,0,0,,قلت أنك لن تحاول إعاقتي
Dialogue: 0,1:04:08.63,1:04:10.38,نص عام,,0,0,0,,لن تستطيع إيقافي
Dialogue: 0,1:04:11.38,1:04:12.76,نص عام,,0,0,0,,أرجو أن تسمحوا لي بالرحيل
Dialogue: 0,1:05:11.40,1:05:14.99,ذكريات بخط مائل,,0,0,0,,إذا كان الباب مغلقًا، فمن المحتمل أنه مات بالفعل
Dialogue: 0,1:05:19.33,1:05:22.87,ذكريات مائلة,,0,0,0,,لكنني لن أعود بالزمن إلى الوراء ولو ندمت على شيء
Dialogue: 0,1:05:24.33,1:05:25.54,نص عام,,0,0,0,,شان ووك
Dialogue: 0,1:08:19.42,1:08:20.84,نص عام,,0,0,0,,أنت حي،
Dialogue: 0,1:08:23.01,1:08:24.43,نص عام,,0,0,0,,يا طالبتي
Dialogue: 0,1:08:43.61,1:08:45.24,general text,,0,0,0,,لماذا أخفيت هذا عني؟
Dialogue: 0,1:08:49.49,1:08:50.62,نص عام,,0,0,0,,لأنه
Dialogue: 0,1:08:52.62,1:08:53.87,نص عام,,0,0,0,,أريدك أن تموت
Dialogue: 0,1:08:55.67,1:08:56.84,نص عام,,0,0,0,,ثم
Dialogue: 0,1:08:58.09,1:08:59.38,نص عام,,0,0,0,,لماذا أتيت؟
Dialogue: 0,1:09:02.72,1:09:03.84,نص عام,,0,0,0,,لأنه
Dialogue: 0,1:09:08.05,1:09:09.56,نص عام,,0,0,0,,كان من الممكن أن تموت
Dialogue: 0,1:09:16.23,1:09:17.98,نص عام,,0,0,0,,منذ أن التقطت السيف،
Dialogue: 0,1:09:19.36,1:09:20.69,نص عام,,0,0,0,,حدد اختيارك
Dialogue: 0,1:09:23.65,1:09:25.41,نص عام,,0,0,0,,أعلم أنك كنت تتجنبني
Dialogue: 0,1:09:25.49,1:09:28.12,نص عام,,0,0,0,,أعلم أن حياتنا بين يديك
Dialogue: 0,1:09:32.54,1:09:33.87,نص عام,,0,0,0,,كما وعدتكم,
Dialogue: 0,1:09:34.96,1:09:36.54,نص عام,,0,0,0,,وجه سيفك نحوي أولاً
Dialogue: 0,1:09:50.93,1:09:51.97,ذكريات,,0,0,0,,سوف تقتل,
Dialogue: 0,1:09:52.68,1:09:55.27,ذكريات,,0,0,0,,سأصبح أنا من مات،
Dialogue: 0,1:09:56.02,1:09:57.40,ذكريات,,0,0,0,,تحرير المرتزق
Dialogue: 0,1:09:59.56,1:10:00.86,ذكريات,,0,0,0,,ارحموا -
Dialogue: 0,1:10:01.69,1:10:03.69,ذكريات,,0,0,0,,سأقطع لك وعداً آخر
Dialogue: 0,1:10:27.09,1:10:28.22,نص عام,,0,0,0,,الآن,
Dialogue: 0,1:10:32.68,1:10:34.56,نص عام,,0,0,0,,كما قلت،
Dialogue: 0,1:10:36.14,1:10:37.98,نص عام,,0,0,0,,أعطني وعدًا آخر
Dialogue: 0,1:11:51.42,1:11:54.60,preview,,0,0,0,,أي نوع من الأشخاص يمكن أن يرفض مثل هذه القوة المذهلة؟
Dialogue: 0,1:11:54.68,1:11:56.97,preview,,0,0,0,,لحماية ما يجب علينا...
Dialogue: 0,1:11:57.06,1:11:58.47,preview,,0,0,0,,ماذا لو بذلت كل ما في وسعي؟
Dialogue: 0,1:11:58.56,1:12:00.35,preview,,0,0,0,,أحاول حمايتك أيضًا
Dialogue: 0,1:12:01.10,1:12:02.94,preview,,0,0,0,,ماذا يفعل هنا؟
Dialogue: 0,1:12:03.02,1:12:05.52,preview,,0,0,0,,القوة الإلهية المذهلة لجين بو يونغ
Dialogue: 0,1:12:05.61,1:12:07.69,preview,,0,0,0,,لم تحصل عليها من والدتها فقط، أحد أفراد عائلة جين
Dialogue: 0,1:12:07.78,1:12:11.07,preview,,0,0,0,,بارك جين! لقد أخفيت الحقيقة، وأنت تعرف كل شيء جيدًا
Dialogue: 0,1:12:12.99,1:12:17.49,preview,,0,0,0,,والآن من يجب أن يرحل سيرحل ومن يجب أن يعود سيعود
Dialogue: 0,1:12:17.58,1:12:20.16,معاينة,,0,0,0,,سيدي، افعل ما تراه ضروريًا
Dialogue: 0,1:12:20.25,1:12:23.42,preview,,0,0,0,,سأحاول أن أفعل هذا ليس بدافع الغباء، ولكن بدافع الحماس
Dialogue: 0,1:12:23.50,1:12:25.00,معاينة,,0,0,0,,علمني معلمي هذا
Dialogue: 0,1:12:25.08,1:12:27.42,معاينة,,0,0,0,,- يبدو جيدًا\N- واو
Dialogue: 0,1:12:27.50,1:12:29.84,preview,,0,0,0,,سمعت أن هناك عروسًا هنا وحفل زفافها قريبًا
Dialogue: 0,0:02:56.94,0:02:58.94,النيكس,,0,0,0,,

