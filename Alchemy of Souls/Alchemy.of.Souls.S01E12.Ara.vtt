Dialogue: 0,0:01:18.77,0:01:21.19,نص عام,,0,0,0,,سوف يثرثر الناس إذا اختفيت فجأة
Dialogue: 0,0:01:21.28,0:01:23.49,نص عام,,0,0,0,,الموت أمام الشهود
Dialogue: 0,0:01:23.57,0:01:25.78,نص عام,,0,0,0,,سيبسط كل شيء
Dialogue: 0,0:01:27.91,0:01:29.66,نص عام,,0,0,0,,أريد حفظ ماء الوجه
Dialogue: 0,0:01:30.66,0:01:32.62,نص عام,,0,0,0,,أتمنى أن يكون الموت مستحقاً
Dialogue: 0,0:01:37.71,0:01:39.88,نص عام,,0,0,0,,- معلمة!\N- معلمة!
Dialogue: 0,0:01:43.26,0:01:44.34,نص عام,,0,0,0,,ماذا يقول؟
Dialogue: 0,0:01:44.43,0:01:46.34,نص عام,,0,0,0,,- ما هذا؟\N- انظر!
Dialogue: 0,0:01:47.05,0:01:48.93,نص عام,,0,0,0,,مرتزقة!
Dialogue: 0,0:02:18.46,0:02:20.42,نص عام,,0,0,0,,ماستر
Dialogue: 0,0:02:29.09,0:02:32.31,نص عام,,0,0,0,,أنا أستخدم جسدك بكرامة
Dialogue: 0,0:03:25.94,0:03:26.82,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:03:30.07,0:03:32.24,نص عام,,0,0,0,,يا إلهي
Dialogue: 0,0:03:38.83,0:03:40.00,نص عام,,0,0,0,,كل شيء على ما يرام
Dialogue: 0,0:03:40.96,0:03:41.96,نص عام,,0,0,0,,لا تأتي
Dialogue: 0,0:03:46.84,0:03:47.76,خط مائل,,0,0,0,,عار
Dialogue: 0,0:03:47.84,0:03:50.47,النص العام,,0,0,0,,اليوم عانى أكثر
Dialogue: 0,0:03:50.55,0:03:52.80,النص العام,,0,0,0,,- بقي اثنان آخران؟\N- نعم
Dialogue: 0,0:03:54.18,0:03:56.43,النص العام,,0,0,0,,غداً تشا بوم
Dialogue: 0,0:03:56.52,0:03:58.52,general text,,0,0,0,,لا أريد أن أرى المملكة المتحدة تخسر أمامه
Dialogue: 0,0:03:59.18,0:04:00.56,النص العام,,0,0,0,,ربما يجب أن أقاتل؟
Dialogue: 0,0:04:01.27,0:04:03.23,مائل,,0,0,0,,سأدع "أوكو" يفوز وينتهي الأمر
Dialogue: 0,0:04:03.31,0:04:04.77,نص عام,,0,0,0,,المملكة المتحدة ستكون سعيدة بذلك
Dialogue: 0,0:04:05.27,0:04:07.36,نص عام,,0,0,0,,خلاف مع ولي العهد
Dialogue: 0,0:04:07.44,0:04:09.03,نص عام,,0,0,0,,علينا أن نخدعه
Dialogue: 0,0:04:12.20,0:04:14.12,general text,,0,0,0,,المملكة المتحدة تخسر ولكنها تكتسب الخبرة
Dialogue: 0,0:04:16.20,0:04:17.20,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:04:17.29,0:04:19.96,نص عام,,0,0,0,,اذهب إلى غرفتك، سأحضر المناشف
Dialogue: 0,0:04:28.09,0:04:30.88,النص العام,,0,0,0,,لا أعرف من آخر من يقاتله،
Dialogue: 0,0:04:32.89,0:04:34.85,النص العام,,0,0,0,,لكن هزيمة أوكا لن تكون بهذه السهولة
Dialogue: 0,0:04:49.32,0:04:50.32,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,0:04:54.53,0:04:55.78,نص عام,,0,0,0,,أين المالك؟
Dialogue: 0,0:04:56.37,0:04:57.87,النص العام,,0,0,0,,أوه، هل تبحث عنه؟
Dialogue: 0,0:04:58.66,0:04:59.66,نص عام,,0,0,0,,نعم
Dialogue: 0,0:05:00.45,0:05:02.21,نص عام,,0,0,0,,ربما أنت مو دوك
Dialogue: 0,0:05:03.42,0:05:05.58,نص عام,,0,0,0,,- نعم\N- فهمت
Dialogue: 0,0:05:05.67,0:05:08.63,النص العام,,0,0,0,,الشخص الذي يكون دائمًا بجانب تشان ووك
Dialogue: 0,0:05:09.21,0:05:12.42,خلف الكواليس,,0,0,0,,ذلك مالك الحزين الذي كانت الخادمة كيم تتحدث عنه
Dialogue: 0,0:05:12.93,0:05:15.76,مائل,,0,0,0,,جئت لرؤيته قبل الرحيل
Dialogue: 0,0:05:15.84,0:05:17.26,نص عام,,0,0,0,,أدخل. أ...
Dialogue: 0,0:05:17.35,0:05:20.31,نص عام,,0,0,0,,أحضرت وجبات خفيفة. يريد؟
Dialogue: 0,0:05:21.14,0:05:22.14,نص عام,,0,0,0,,لا، شكرًا
Dialogue: 0,0:05:30.65,0:05:33.78,النص العام,,0,0,0,,إنها رشيقة ولطيفة كما قالت الخادمة كيم.
Dialogue: 0,0:06:34.01,0:06:36.30,نص عام,,0,0,0,,لماذا تقف هنا مبللاً؟
Dialogue: 0,0:06:38.30,0:06:39.68,نص عام,,0,0,0,,مهلا، انظر
Dialogue: 0,0:06:57.45,0:06:59.07,general text,,0,0,0,,هذا الرجل فعل ذلك، أليس كذلك؟
Dialogue: 0,0:06:59.66,0:07:01.83,نص عام,,0,0,0,,يجب أن نحاول بالسيف
Dialogue: 0,0:07:02.74,0:07:05.62,نص عام,,0,0,0,,ظننتك منزعجاً من سقوطك في الماء
Dialogue: 0,0:07:06.50,0:07:08.42,النص العام,,0,0,0,,وقدّرت معركتك
Dialogue: 0,0:07:08.92,0:07:11.75,نص عام,,0,0,0,,أول مرتين كان الأمر هكذا
Dialogue: 0,0:07:11.84,0:07:13.84,نص عام,,0,0,0,,أنا غاضب فقط لأنني خسرت ثماني مرات
Dialogue: 0,0:07:15.92,0:07:19.38,نص عام,,0,0,0,,أنت معتاد على المشي نظيفاً ومكوياً،
Dialogue: 0,0:07:19.47,0:07:22.35,general text,,0,0,0,,والآن أنت واقف في مكان مبلل وقذر، مما يعني،
Dialogue: 0,0:07:23.47,0:07:24.85,نص عام,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:07:28.10,0:07:29.65,نص عام,,0,0,0,,إنه أمر قذر حقًا
Dialogue: 0,0:07:34.82,0:07:36.82,نص عام,,0,0,0,,كنت في عجلة من أمرك اليوم
Dialogue: 0,0:07:36.90,0:07:40.24,general text,,0,0,0,,لم تكن هناك حاجة للهجوم عندما كان يدافع
Dialogue: 0,0:07:40.32,0:07:43.28,general text,,0,0,0,,كان يستحق الانتظار حتى يضعف دفاعه
Dialogue: 0,0:07:44.33,0:07:45.49,نص عام,,0,0,0,,نعم
Dialogue: 0,0:07:45.58,0:07:48.33,نص عام,,0,0,0,,إذا تراجعت خطوة إلى الوراء بعد الضربات،
Dialogue: 0,0:07:48.41,0:07:51.79,النص العام,,0,0,0,,سوف يرتاح ويضعف
Dialogue: 0,0:07:51.88,0:07:53.34,نص عام,,0,0,0,,الحماية
Dialogue: 0,0:07:54.09,0:07:56.13,النص العام,,0,0,0,,القتال لعبة شد الحبل
Dialogue: 0,0:07:56.76,0:07:59.51,general text,,0,0,0,,العدو سيسحبك عندما يقرر إضعافك
Dialogue: 0,0:08:00.68,0:08:02.64,نص عام,,0,0,0,,فأنت بحاجة للهجوم
Dialogue: 0,0:08:04.30,0:08:06.14,نص عام,,0,0,0,,شكرًا على النصيحة يا أستاذ
Dialogue: 0,0:08:11.56,0:08:12.52,نص عام,,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:08:14.06,0:08:16.07,نص عام,,0,0,0,,السباحة وتغيير الملابس
Dialogue: 0,0:08:16.15,0:08:17.78,نص عام,,0,0,0,,أنا أشم رائحة بالفعل
Dialogue: 0,0:08:19.19,0:08:21.36,ذكريات,,0,0,0,,آه، أنت تبحث عنه
Dialogue: 0,0:08:28.91,0:08:30.21,نص عام,,0,0,0,,لا تذهب
Dialogue: 0,0:08:33.88,0:08:35.88,نص عام,,0,0,0,,لا تذهب إلى مكانك، ابق هنا
Dialogue: 0,0:08:36.75,0:08:39.30,نص عام,,0,0,0,,- سأحضر الملابس\N- لماذا؟
Dialogue: 0,0:08:39.38,0:08:41.22,نص عام,,0,0,0,,يمكنني التغيير
Dialogue: 0,0:08:42.18,0:08:43.93,النص العام,,0,0,0,,لماذا ترهق نفسك مثل الأحمق؟
Dialogue: 0,0:08:49.31,0:08:50.39,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:08:52.48,0:08:54.10,نص عام,,0,0,0,,التصرف كالأحمق
Dialogue: 0,0:08:58.48,0:08:59.40,نص عام,,0,0,0,,انطلق
Dialogue: 0,0:09:04.07,0:09:05.12,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:09:05.20,0:09:06.62,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:09:08.45,0:09:09.49,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:09:16.59,0:09:17.75,نص عام,,0,0,0,,اجلس
Dialogue: 0,0:09:18.59,0:09:19.76,نص عام,,0,0,0,,نعم اجلس
Dialogue: 0,0:09:25.68,0:09:27.85,نص عام,,0,0,0,,أنظر إلى الحذاء. كل الرطب
Dialogue: 0,0:09:31.14,0:09:31.98,نص عام,,0,0,0,,لماذا...
Dialogue: 0,0:09:33.23,0:09:35.94,general text,,0,0,0,,لماذا تبعتني حتى في الماء؟
Dialogue: 0,0:09:38.82,0:09:43.03,نص عام,,0,0,0,,أحيانًا تعمل بجهد غير معقول
Dialogue: 0,0:09:43.11,0:09:45.74,نص عام,,0,0,0,,لماذا تحاول جاهداً التنظيف؟
Dialogue: 0,0:09:45.82,0:09:48.20,نص عام,,0,0,0,,استرح، تشير إليّ
Dialogue: 0,0:09:50.45,0:09:53.41,النص العام,,0,0,0,,أرسلت الخادمة كيم آذانًا مجففة إلى كوروين
Dialogue: 0,0:09:53.50,0:09:56.37,النص العام,,0,0,0,,تناول لنفسك أيضًا، ولا تترك كل شيء لي
Dialogue: 0,0:09:57.67,0:09:58.88,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:10:00.96,0:10:03.67,general text,,0,0,0,,يعاملونني جيدًا لأنني قريب من Dan Gu،
Dialogue: 0,0:10:03.76,0:10:05.18,نص عام,,0,0,0,,وريث سوسنوفي بور
Dialogue: 0,0:10:07.26,0:10:08.39,نص عام,,0,0,0,,إليك الطريقة
Dialogue: 0,0:10:09.51,0:10:13.60,النص العام,,0,0,0,,كنت أعلم أنك تستخدم القوة لصالحك
Dialogue: 0,0:10:20.65,0:10:22.07,نص عام,,0,0,0,,أنت مجروح
Dialogue: 0,0:10:24.49,0:10:26.36,نص عام,,0,0,0,,لقد حاربت لمدة ثمانية أيام متتالية
Dialogue: 0,0:10:27.45,0:10:28.87,نص عام,,0,0,0,,ليس هذا هو الجرح الوحيد
Dialogue: 0,0:10:31.37,0:10:32.74,نص عام,,0,0,0,,أين آخر؟
Dialogue: 0,0:10:33.58,0:10:35.50,نص عام,,0,0,0,,يجب أن نذهب إلى سيجوكون
Dialogue: 0,0:10:35.58,0:10:37.17,نص عام,,0,0,0,,لا تزال هناك معارك متبقية
Dialogue: 0,0:10:39.63,0:10:41.46,النص العام,,0,0,0,,يجب أن نعاني كثيرًا،
Dialogue: 0,0:10:42.80,0:10:44.55,نص عام,,0,0,0,,بقدر ما ينتظر سيدي
Dialogue: 0,0:11:00.86,0:11:02.23,نص عام,,0,0,0,,سوف تتجمد الأقدام
Dialogue: 0,0:11:03.36,0:11:04.78,نص عام,,0,0,0,,أنت تغير ملابسك أيضًا
Dialogue: 0,0:11:46.53,0:11:47.65,نص عام,,0,0,0,,عذراء كيم؟
Dialogue: 0,0:12:01.54,0:12:03.25,نص عام,,0,0,0,,تم يا صاحب السمو
Dialogue: 0,0:12:03.34,0:12:06.34,النص العام,,0,0,0,,الدواء مر. أي حلويات؟
Dialogue: 0,0:12:06.42,0:12:08.59,نص عام,,0,0,0,,سأحضر شيئًا ما
Dialogue: 0,0:12:19.35,0:12:21.56,ذكريات بخط مائل,,0,0,0,,يجب أن يكون هناك أيضًا يشم أحمر
Dialogue: 0,0:12:22.44,0:12:24.48,الذكريات بخط مائل,,0,0,0,,ليس لها قيمة إلا في أزواج
Dialogue: 0,0:12:26.19,0:12:27.82,general text,,0,0,0,,ربما يجب أن أرميها بعيدًا؟
Dialogue: 0,0:13:07.23,0:13:08.57,نص عام,,0,0,0,,ماذا؟..
Dialogue: 0,0:13:09.15,0:13:10.36,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:13:18.87,0:13:21.00,خلف الكواليس,,0,0,0,,ما هذا؟
Dialogue: 0,0:13:33.22,0:13:37.64,خارج الإطار,,0,0,0,,شيء ما يجذبني بقوة لا تصدق
Dialogue: 0,0:13:41.47,0:13:43.10,خلف الكواليس,,0,0,0,,جاذبية لا يمكن تفسيرها...
Dialogue: 0,0:13:44.23,0:13:45.19,التعليق الصوتي,,0,0,0,,إنه يناديني
Dialogue: 0,0:14:37.53,0:14:39.03,نص عام,,0,0,0,,- اللعنة\N- هذا صحيح
Dialogue: 0,0:14:39.12,0:14:41.45,النص العام,,0,0,0,,لماذا كان من الضروري صب الطاقة في اليشم
Dialogue: 0,0:14:41.53,0:14:43.54,نص عام,,0,0,0,,وهذا ما يربكني؟
Dialogue: 0,0:14:43.62,0:14:45.50,نص عام,,0,0,0,,هذا مسيء للغاية
Dialogue: 0,0:14:45.58,0:14:46.41,نص عام,,0,0,0,,نفس الشيء
Dialogue: 0,0:14:46.50,0:14:51.04,general text,,0,0,0,,أشعر بالإهانة لأن قلبي ينبض بشدة بسببك!
Dialogue: 0,0:14:55.88,0:14:56.93,نص عام,,0,0,0,,وأنت...
Dialogue: 0,0:14:57.97,0:14:59.14,نص عام,,0,0,0,,هل شعرت بذلك أيضًا؟
Dialogue: 0,0:15:00.51,0:15:03.93,نص عام,,0,0,0,,كان قلبي ينبض بشدة...
Dialogue: 0,0:15:06.56,0:15:08.31,نص عام,,0,0,0,,- أوه...\N- لا تقل
Dialogue: 0,0:15:11.02,0:15:12.15,نص عام,,0,0,0,,انسى
Dialogue: 0,0:15:12.94,0:15:14.15,نص عام,,0,0,0,,أنت متفاجئ جدًا،
Dialogue: 0,0:15:14.98,0:15:17.03,نص عام,,0,0,0,,مما يعني أنني لم أستخدمه قط
Dialogue: 0,0:15:17.86,0:15:18.78,نص عام,,0,0,0,,نعم
Dialogue: 0,0:15:18.86,0:15:20.41,النص العام,,0,0,0,,مو دوك ليس لديه سحر
Dialogue: 0,0:15:21.07,0:15:22.70,نص عام,,0,0,0,,لا يمكنك تبادل الطاقة
Dialogue: 0,0:15:22.78,0:15:23.87,نص عام,,0,0,0,,نعم
Dialogue: 0,0:15:24.41,0:15:27.08,نص عام,,0,0,0,,لم أكن أعلم أن هذا اليشم يتمتع بهذه القوة
Dialogue: 0,0:15:42.68,0:15:44.39,نص عام,,0,0,0,,كفى
Dialogue: 0,0:15:45.77,0:15:47.77,نص عام,,0,0,0,,على أية حال,
Dialogue: 0,0:15:48.56,0:15:50.06,نص عام,,0,0,0,,تعلمت شيئاً جديداً
Dialogue: 0,0:15:50.90,0:15:52.81,نص عام,,0,0,0,,- شكراً\N- ماذا؟
Dialogue: 0,0:15:52.90,0:15:53.98,النص العام,,0,0,0,,هل تعتقد أنه يجب علي استخدامه؟
Dialogue: 0,0:15:55.02,0:15:56.36,نص عام,,0,0,0,,من غير المرجح أن تتمكن من ذلك
Dialogue: 0,0:15:57.78,0:15:59.15,general text,,0,0,0,,مو دوك لن يستعيدها
Dialogue: 0,0:15:59.24,0:16:01.20,النص العام,,0,0,0,,لدي معركتان أخريان
Dialogue: 0,0:16:01.74,0:16:03.78,نص عام,,0,0,0,,سأعيده وأستخدمه
Dialogue: 0,0:16:03.87,0:16:05.83,نص عام,,0,0,0,,احفظ حتى ذلك الحين
Dialogue: 0,0:16:07.33,0:16:08.83,نص عام,,0,0,0,,ورجاءً،
Dialogue: 0,0:16:09.50,0:16:10.92,نص عام,,0,0,0,,لا تلعب بالطاقة
Dialogue: 0,0:16:12.88,0:16:14.42,نص عام,,0,0,0,,وأنت أيضاً
Dialogue: 0,0:16:19.80,0:16:22.18,النص العام,,0,0,0,,صاحب السمو، أين كنت؟
Dialogue: 0,0:16:23.60,0:16:24.76,ذكريات بخط مائل,,0,0,0,,هل تأخذك؟
Dialogue: 0,0:16:26.26,0:16:27.31,ذكريات,,0,0,0,,أستطيع
Dialogue: 0,0:16:27.93,0:16:30.23,ذكريات,,0,0,0,,ستجد وظيفة هنا
Dialogue: 0,0:16:31.64,0:16:32.77,ذكريات,,0,0,0,,لا أريد
Dialogue: 0,0:16:33.86,0:16:35.69,نص عام,,0,0,0,,- الخصي O\N- نعم؟
Dialogue: 0,0:16:35.77,0:16:38.69,general text,,0,0,0,,اكتشف من التالي الذي سيقاتل أوكا
Dialogue: 0,0:16:39.28,0:16:40.24,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:40.86,0:16:42.03,نص عام,,0,0,0,,لا تخطئوا
Dialogue: 0,0:16:42.70,0:16:43.87,نقوش,,0,0,0,,فن هيونغون
Dialogue: 0,0:16:43.95,0:16:44.82,نص عام,,0,0,0,,مهلا,
Dialogue: 0,0:16:44.91,0:16:46.83,نص عام,,0,0,0,,كيف تحب القتال؟
Dialogue: 0,0:16:46.91,0:16:50.04,نص عام,,0,0,0,,مع تشان ووك؟ سهلة مثل قصف الكمثرى
Dialogue: 0,0:16:50.96,0:16:53.17,خط مائل,,0,0,0,,- هل أنت مستعد لرحلتك؟\N- بالطبع
Dialogue: 0,0:16:53.25,0:16:55.71,نص عام,,0,0,0,,أنا أستخدم Hyunggon، بعد كل شيء...
Dialogue: 0,0:16:59.38,0:17:02.05,خلف الكواليس,,0,0,0,,ساحر من عائلة تشا التي تمتلك هيونغون
Dialogue: 0,0:17:02.72,0:17:04.76,خارج الشاشة,,0,0,0,,كان يشاهد "يو كيه" طوال الوقت
Dialogue: 0,0:17:04.84,0:17:08.68,خلف الكواليس,,0,0,0,,جبان قرر القتال فقط بعد خسارة تشان ووك
Dialogue: 0,0:17:09.56,0:17:11.48,خط مائل,,0,0,0,,المملكة المتحدة قادرة على هزيمته
Dialogue: 0,0:17:15.10,0:17:18.15,النص العام,,0,0,0,,هيونجون فن رائع
Dialogue: 0,0:17:18.82,0:17:21.19,نص عام,,0,0,0,,ولكنه غير مفيد إذا كنت تفتقر إلى المهارات
Dialogue: 0,0:17:22.11,0:17:24.16,النص العام,,0,0,0,,يبدو تشا بوم مخيفًا جدًا،
Dialogue: 0,0:17:24.24,0:17:25.66,نص عام,,0,0,0,,لكن هذه مجرد واجهة
Dialogue: 0,0:17:26.70,0:17:29.16,التعليق الصوتي,,0,0,0,,لذلك يقرأ يول الآخرين بسهولة، فلا عجب
Dialogue: 0,0:17:29.66,0:17:30.75,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:17:31.29,0:17:33.67,النص العام,,0,0,0,,ويتجول ليخبر الجميع بمدى سهولة الأمر
Dialogue: 0,0:17:34.21,0:17:35.96,نص عام,,0,0,0,,اهزم المالك
Dialogue: 0,0:17:36.04,0:17:37.13,نص عام,,0,0,0,,إنه خائف فقط
Dialogue: 0,0:17:38.00,0:17:40.42,general text,,0,0,0,,لقد تحسنت المملكة المتحدة بشكل ملحوظ هذه الأيام
Dialogue: 0,0:17:41.05,0:17:43.63,general text,,0,0,0,,يخشى بوم أن تهزمه المملكة المتحدة
Dialogue: 0,0:17:44.84,0:17:49.10,general text,,0,0,0,,لقد تحسن سيدي كثيرًا لدرجة أنه يثير قلق الآخرين
Dialogue: 0,0:17:51.85,0:17:54.10,general text,,0,0,0,,هل أنت سعيد للغاية لأن المملكة المتحدة أصبحت أقوى؟
Dialogue: 0,0:17:54.19,0:17:57.11,نص عام,,0,0,0,,بالطبع. الفخر مباشرة إلى السماء
Dialogue: 0,0:17:58.52,0:18:01.48,التعليق الصوتي,,0,0,0,,ناك سو يدرب ووك
Dialogue: 0,0:18:01.57,0:18:02.65,خط مائل,,0,0,0,,يول
Dialogue: 0,0:18:05.53,0:18:06.91,نص عام,,0,0,0,,هل سمعت؟
Dialogue: 0,0:18:06.99,0:18:08.70,النص العام,,0,0,0,,هناك هياج في العاصمة
Dialogue: 0,0:18:09.58,0:18:10.74,نص عام,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:18:10.83,0:18:14.46,general text,,0,0,0,,مات السيد كانغ من ديغانتونغون بسبب المرض.
Dialogue: 0,0:18:15.83,0:18:16.87,نص عام,,0,0,0,,لكن هناك شائعات،
Dialogue: 0,0:18:17.54,0:18:19.67,نص عام,,0,0,0,,تعرض لهجوم من قبل المرتزقة الليلة الماضية
Dialogue: 0,0:18:20.96,0:18:23.84,خط مائل,,0,0,0,,ذهب العم والمعلم هوو إلى الجنازة
Dialogue: 0,0:18:24.42,0:18:27.18,general text,,0,0,0,,وإذا كان هؤلاء هم نفس المرتزقة مثل ناك سو؟
Dialogue: 0,0:18:39.19,0:18:41.73,نقوش,,0,0,0,,المتوفى كانغ مان جونغ
Dialogue: 0,0:18:43.69,0:18:46.03,مائل,,0,0,0,,لماذا لا نستطيع التعبير عن تعازينا؟
Dialogue: 0,0:18:47.82,0:18:50.78,النص العام,,0,0,0,,عائلتنا تنقل البضائع باهظة الثمن
Dialogue: 0,0:18:50.87,0:18:53.45,نص عام,,0,0,0,,إذا عرف الناس أن رب البيت
Dialogue: 0,0:18:53.54,0:18:57.25,general text,,0,0,0,,قتل على يد المرتزقة وستفقد العائلة وظائفها
Dialogue: 0,0:18:57.96,0:18:59.54,general text,,0,0,0,,أعلن عن وفاته بمرض معدٍ.
Dialogue: 0,0:19:00.13,0:19:01.46,نص عام,,0,0,0,,حتى لا يتمكن أحد من الدخول
Dialogue: 0,0:19:04.76,0:19:06.42,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:19:06.51,0:19:09.30,النص الرئيسي,,0,0,0,,هل من الممكن أن تجد أسماء؟
Dialogue: 0,0:19:11.26,0:19:12.93,النص العام,,0,0,0,,هل قمت بتشريح الجثة؟
Dialogue: 0,0:19:14.64,0:19:18.06,general text,,0,0,0,,السيد خان طعن حتى الموت بالسيف أمام أعيننا
Dialogue: 0,0:19:18.65,0:19:19.98,نص عام,,0,0,0,,لم تكن هناك حاجة
Dialogue: 0,0:19:21.61,0:19:23.40,نص عام,,0,0,0,,سيتم حرق جثته الليلة
Dialogue: 0,0:19:23.48,0:19:25.03,نص عام,,0,0,0,,قريباً؟
Dialogue: 0,0:19:25.61,0:19:26.74,نص عام,,0,0,0,,هذا مؤسف،
Dialogue: 0,0:19:26.82,0:19:28.66,نص عام,,0,0,0,,لكن يجب أن نسرع قبل أن تنتشر الشائعات
Dialogue: 0,0:19:28.74,0:19:32.66,نص عام,,0,0,0,,أنا متأكد من أن السيد كان يريد نفس الشيء
Dialogue: 0,0:19:32.74,0:19:33.79,نص عام,,0,0,0,,هذا غير مقبول
Dialogue: 0,0:19:33.87,0:19:36.00,نص عام,,0,0,0,,إذا أحرقته،
Dialogue: 0,0:19:36.66,0:19:39.25,نص عام,,0,0,0,,لن يكون هناك دليل على جريمة قتل
Dialogue: 0,0:19:41.67,0:19:43.13,نص عام,,0,0,0,,إنها مسألة عائلية
Dialogue: 0,0:19:44.46,0:19:46.30,نص عام,,0,0,0,,أتفهم أنك قلقة
Dialogue: 0,0:19:47.30,0:19:50.30,general text,,0,0,0,,لكن رئيس سوسنوفي بور لا يحتاج إلى التدخل في هذا الأمر
Dialogue: 0,0:19:51.59,0:19:54.01,نص عام,,0,0,0,,تشريح الجثة ضروري
Dialogue: 0,0:19:54.10,0:19:55.81,نص عام,,0,0,0,,تأجيل حرق الجثة
Dialogue: 0,0:19:57.18,0:20:01.02,general text,,0,0,0,,هل وصلت سوسنوفي بور إلى درجة أنها تتدخل في جنازات الآخرين؟
Dialogue: 0,0:20:04.40,0:20:05.73,نص عام,,0,0,0,,لا نتدخل
Dialogue: 0,0:20:06.48,0:20:10.74,نص عام,,0,0,0,,أحاول تحذير رئيس المنزل الجديد
Dialogue: 0,0:20:10.82,0:20:12.74,نص عام,,0,0,0,,من خطأ لا يمكن إصلاحه
Dialogue: 0,0:20:12.82,0:20:14.87,نص عام,,0,0,0,,لماذا أنت ضده؟
Dialogue: 0,0:20:14.95,0:20:16.49,نص عام,,0,0,0,,ما هو حقك؟
Dialogue: 0,0:20:16.58,0:20:20.12,مائل,,0,0,0,,منذ وقت ليس ببعيد، تعرض السحرة لهجوم من قبل ناك سو
Dialogue: 0,0:20:20.21,0:20:22.29,نص عام,,0,0,0,,الآن ظهر مرتزقة جدد
Dialogue: 0,0:20:23.04,0:20:25.75,general text,,0,0,0,,قد يكون هناك صلة بين هذه الحالة وسحر ناك سو
Dialogue: 0,0:20:26.42,0:20:27.63,نص عام,,0,0,0,,لذلك أنا أتدخل
Dialogue: 0,0:20:28.84,0:20:30.68,نص عام,,0,0,0,,لم يكن هناك سحر
Dialogue: 0,0:20:30.76,0:20:31.68,نص عام,,0,0,0,,يمكنني التأكيد
Dialogue: 0,0:20:31.76,0:20:33.64,general text,,0,0,0,,من أين تأتي هذه الثقة دون تشريح الجثة؟!
Dialogue: 0,0:20:35.05,0:20:38.47,النص العام,,0,0,0,,الرأس لا يريد تشريح الجثة
Dialogue: 0,0:20:38.56,0:20:40.77,نص عام,,0,0,0,,جين مو، اصمت فحسب
Dialogue: 0,0:20:41.35,0:20:43.40,النص العام,,0,0,0,,من حقنا التدخل،
Dialogue: 0,0:20:43.48,0:20:45.06,نص عام,,0,0,0,,إذا كنا نتحدث عن السحر
Dialogue: 0,0:20:45.15,0:20:47.61,نص عام,,0,0,0,,هل توافقينني الرأي يا سيدة جين؟
Dialogue: 0,0:20:49.57,0:20:50.95,نص عام,,0,0,0,,أعتقد,
Dialogue: 0,0:20:52.53,0:20:55.12,نص عام,,0,0,0,,هذه المرة النائب على حق
Dialogue: 0,0:20:58.95,0:21:01.50,general text,,0,0,0,,الرئيس الجديد أكد وفاة السيد خان
Dialogue: 0,0:21:01.58,0:21:05.13,النص العام,,0,0,0,,وليس أمامه إلا إخفاء السبب الحقيقي
Dialogue: 0,0:21:07.00,0:21:09.96,نص عام,,0,0,0,,لا يوجد دليل يشير إلى السحر
Dialogue: 0,0:21:11.30,0:21:15.14,general text,,0,0,0,,لذا أشك في أن سوسنوفي بور لديه ما يجده هنا
Dialogue: 0,0:21:21.98,0:21:24.19,النص العام,,0,0,0,,أريد فقط الحفاظ على كرامة السيد
Dialogue: 0,0:21:24.27,0:21:27.73,نص عام,,0,0,0,,فلنكمل الجنازة
Dialogue: 0,0:21:50.71,0:21:53.93,النص العام,,0,0,0,,جين مو يهملنا علانية
Dialogue: 0,0:21:56.93,0:21:59.22,general text,,0,0,0,,لماذا كانوا ضدها إلى هذا الحد؟
Dialogue: 0,0:22:00.39,0:22:02.56,نص عام,,0,0,0,,- غريب\N- وأيضاً،
Dialogue: 0,0:22:02.64,0:22:06.77,نص عام,,0,0,0,,لم أكن أعتقد أن السيدة جين ستقف إلى جانبه
Dialogue: 0,0:22:07.36,0:22:09.69,نص عام,,0,0,0,,كانت تكره الأخ غير الشقيق
Dialogue: 0,0:22:13.90,0:22:17.11,نص عام,,0,0,0,,كنت سعيدًا عندما وقفت بجانبي
Dialogue: 0,0:22:18.99,0:22:20.03,نص عام,,0,0,0,,احكم بنفسك
Dialogue: 0,0:22:20.12,0:22:24.33,general text,,0,0,0,,بمجرد أن اتحدنا، كان على سوسنوفني بور أن يستسلم
Dialogue: 0,0:22:26.08,0:22:28.04,general text,,0,0,0,,كيف يسير البحث عن Boo Young؟
Dialogue: 0,0:22:30.55,0:22:32.96,نص عام,,0,0,0,,فتشنا كل المناطق المحيطة بالبحيرة
Dialogue: 0,0:22:33.05,0:22:36.09,نص عام,,0,0,0,,أبحث عن فتاة عمياء في نفس عمرها
Dialogue: 0,0:22:37.68,0:22:41.26,نص عام,,0,0,0,,أنا أفعل هذا طوال السنوات العشر الماضية
Dialogue: 0,0:22:41.35,0:22:42.39,نص عام,,0,0,0,,بصراحة،
Dialogue: 0,0:22:43.18,0:22:45.81,نص عام,,0,0,0,,أعتقد أنني أعرف ما حدث لبو يونغ
Dialogue: 0,0:22:47.27,0:22:50.52,general text,,0,0,0,,قبل عشر سنوات، جرفت الأمواج فتاة صغيرة على ضفة النهر.
Dialogue: 0,0:22:52.19,0:22:54.15,نص عام,,0,0,0,,- نعم؟\N- هنا فقط
Dialogue: 0,0:22:56.07,0:22:57.78,general text,,0,0,0,,لقد ماتت منذ زمن طويل.
Dialogue: 0,0:23:04.70,0:23:08.54,نص عام,,0,0,0,,أمي، أنا متأكد أنها ليست هي
Dialogue: 0,0:23:08.62,0:23:11.25,نص عام,,0,0,0,,قلت لشعبي أن ينبشوا القبر
Dialogue: 0,0:23:12.09,0:23:14.46,النص العام,,0,0,0,,إذا كان بو يونغ قد مات فعلاً،
Dialogue: 0,0:23:14.55,0:23:18.13,النص العام,,0,0,0,,سأحضر لك جسدها بأي ثمن
Dialogue: 0,0:23:18.97,0:23:20.51,نص عام,,0,0,0,,هذا لن ينجح
Dialogue: 0,0:23:21.39,0:23:24.06,نص عام,,0,0,0,,أعيدوا لي ابنتي إلى الحياة
Dialogue: 0,0:23:25.22,0:23:27.39,نص عام,,0,0,0,,بالتأكيد فقط اهدأ
Dialogue: 0,0:23:28.56,0:23:30.52,النص العام,,0,0,0,,سوف نجدها على قيد الحياة
Dialogue: 0,0:23:46.41,0:23:48.04,مائل,,0,0,0,,هل نظرت إليها جيداً؟
Dialogue: 0,0:23:48.91,0:23:51.21,نص عام,,0,0,0,,أمك وأختك المستقبلية
Dialogue: 0,0:23:51.92,0:23:53.04,نص عام,,0,0,0,,هل تعتقد,
Dialogue: 0,0:23:53.92,0:23:56.17,general text,,0,0,0,,هل سيصدقون أنني ابنتهم؟
Dialogue: 0,0:23:56.26,0:23:57.59,نص عام,,0,0,0,,هل ترتدي ملابسك؟
Dialogue: 0,0:23:58.92,0:24:01.80,نص عام,,0,0,0,,مثل بو يونغ عندما كان طفلاً
Dialogue: 0,0:24:01.89,0:24:03.89,النص العام,,0,0,0,,لكنني لا أعتقد أن هو كيونغ سيشتريها
Dialogue: 0,0:24:06.35,0:24:08.60,نص عام,,0,0,0,,ثم الملابس الجميلة
Dialogue: 0,0:24:10.39,0:24:12.23,نص عام,,0,0,0,,لن يصب في صالحنا
Dialogue: 0,0:24:12.81,0:24:15.36,نص عام,,0,0,0,,يجب أن أبدو مثيرًا للشفقة
Dialogue: 0,0:24:16.65,0:24:18.69,نص عام,,0,0,0,,لقد فقدت ابنتها
Dialogue: 0,0:24:18.78,0:24:22.82,general text,,0,0,0,,إذا أشفقت علي فلن أكسب إلا قلبها
Dialogue: 0,0:24:25.66,0:24:26.79,نص عام,,0,0,0,,نعم
Dialogue: 0,0:24:27.75,0:24:29.46,نص عام,,0,0,0,,أنت على حق، لذا أنا
Dialogue: 0,0:24:33.71,0:24:34.96,نص عام,,0,0,0,,سأفعل ذلك بالتأكيد
Dialogue: 0,0:24:37.67,0:24:40.55,النص العام,,0,0,0,,سأصبح ابنة عائلة جين
Dialogue: 0,0:24:53.69,0:24:55.31,نص عام,,0,0,0,,تبدو أفضل
Dialogue: 0,0:24:55.98,0:24:58.23,نص عام,,0,0,0,,نعم، أتعافى بسرعة
Dialogue: 0,0:25:09.62,0:25:11.79,نص عام,,0,0,0,,فن هيونغون
Dialogue: 0,0:25:12.75,0:25:14.13,نص عام,,0,0,0,,مفصل
Dialogue: 0,0:25:20.13,0:25:23.93,نص عام,,0,0,0,,لدي شكوك بشأن وفاة السيد خان
Dialogue: 0,0:25:36.31,0:25:40.07,النص العام,,0,0,0,,كان قوياً، وكان ماهراً في التعويذات
Dialogue: 0,0:25:40.15,0:25:42.82,general text,,0,0,0,,لكنه كان يموت بالفعل بسبب المرض
Dialogue: 0,0:25:43.61,0:25:46.99,النص العام,,0,0,0,,لم تكن هناك حاجة لإرسال كمرتزق
Dialogue: 0,0:25:47.07,0:25:49.20,general text,,0,0,0,,ربما كان هناك من يضمره ضغينة
Dialogue: 0,0:25:49.99,0:25:52.08,النص العام,,0,0,0,,وأردت أن أقتل نفسي
Dialogue: 0,0:25:52.16,0:25:53.08,خط مائل,,0,0,0,,لا
Dialogue: 0,0:25:53.16,0:25:55.00,نص عام,,0,0,0,,لا نعرف بعد،
Dialogue: 0,0:25:56.21,0:25:58.79,نص عام,,0,0,0,,ولكن لابد من وجود سبب للهجوم
Dialogue: 0,0:26:01.80,0:26:05.09,general text,,0,0,0,,عندما تنتقل الروح إلى جسد جديد فلا حاجة للجسد القديم
Dialogue: 0,0:26:05.68,0:26:07.72,نص عام,,0,0,0,,لكن التخلص منه ليس بالأمر السهل
Dialogue: 0,0:26:07.80,0:26:11.27,general text,,0,0,0,,كان هذا في عيون الناس ساحراً قوياً،
Dialogue: 0,0:26:11.35,0:26:13.23,نص عام,,0,0,0,,مسؤول أو تاجر
Dialogue: 0,0:26:13.89,0:26:16.52,general text,,0,0,0,,إذا اختفى فجأة ستظهر الشكوك
Dialogue: 0,0:26:18.31,0:26:23.03,نص عام,,0,0,0,,لقد اهتم ناك سو بهذا الأمر
Dialogue: 0,0:26:23.11,0:26:25.15,general text,,0,0,0,,هل تتحدث عن محارب الظلام؟
Dialogue: 0,0:26:27.49,0:26:30.08,النص العام,,0,0,0,,شكرًا لهذا المحارب،
Dialogue: 0,0:26:30.66,0:26:34.96,general text,,0,0,0,,سوسنوفي بور لم يعتقد حتى أنني كنت أقوم بإنشاء البدو
Dialogue: 0,0:26:36.29,0:26:38.58,خط مائل,,0,0,0,,عندما اصطدت ناك سو،
Dialogue: 0,0:26:38.67,0:26:42.17,general text,,0,0,0,,كنت أظنها مجنونة تريد إثبات نفسها
Dialogue: 0,0:26:42.25,0:26:46.22,النص العام,,0,0,0,,لذلك لم أنظر قط إلى من قتلت
Dialogue: 0,0:26:48.84,0:26:50.76,النص العام,,0,0,0,,أي أنها قتلت هؤلاء
Dialogue: 0,0:26:51.51,0:26:53.81,نص عام,,0,0,0,,من تحركت أرواح جين مو؟
Dialogue: 0,0:26:53.89,0:26:55.31,نص عام,,0,0,0,,بتعبير أدق تلك،
Dialogue: 0,0:26:56.39,0:26:59.48,النص العام,,0,0,0,,الذي لم يكن ضروريًا بعد النقلة
Dialogue: 0,0:26:59.56,0:27:02.19,نص عام,,0,0,0,,قلت أنها ابنة تشو تشون
Dialogue: 0,0:27:02.98,0:27:07.78,general text,,0,0,0,,فأخذ الطفلة الصغيرة وجعلها مرتزقة؟
Dialogue: 0,0:27:09.57,0:27:11.99,مائل,,0,0,0,,لهذا السبب لم أكشف لها عن هويتي
Dialogue: 0,0:27:12.74,0:27:14.95,النص العام,,0,0,0,,وأجبروني على العيش وحدي في الجبال
Dialogue: 0,0:27:16.46,0:27:18.71,general text,,0,0,0,,لم أعطها أكثر مما تحتاج لتعيش
Dialogue: 0,0:27:19.54,0:27:23.46,النص العام,,0,0,0,,لكنها كانت مصممة وكبرت بقوة
Dialogue: 0,0:27:25.01,0:27:26.55,نص عام,,0,0,0,,لأن...
Dialogue: 0,0:27:27.13,0:27:29.97,general text,,0,0,0,,ظنت أن هذه هي الطريقة التي تنتقم بها من عائلتها.
Dialogue: 0,0:27:30.05,0:27:31.55,نص عام,,0,0,0,,لذلك أطعت جين مو
Dialogue: 0,0:27:33.47,0:27:35.93,خط مائل,,0,0,0,,كانت مفيدة
Dialogue: 0,0:27:36.52,0:27:39.44,general text,,0,0,0,,ثم تحول أحد البدو إلى ابتلاع الروح
Dialogue: 0,0:27:40.10,0:27:41.40,نص عام,,0,0,0,,لهذا السبب
Dialogue: 0,0:27:42.44,0:27:44.69,النص العام,,0,0,0,,سوسنوفي بور يشتبه في كيمياء النفوس
Dialogue: 0,0:27:45.73,0:27:47.90,general text,,0,0,0,,عندما اكتشفت جين مو أننا كنا نبحث عنها،
Dialogue: 0,0:27:48.74,0:27:51.45,نص عام,,0,0,0,,كان يخشى أن يتم القبض عليه
Dialogue: 0,0:27:52.24,0:27:57.16,general text,,0,0,0,,أكيد أرسلها إلى سوسنوفي بور، وهو يعلم أنها ستموت
Dialogue: 0,0:28:10.47,0:28:12.76,النص العام,,0,0,0,,مو دوك، أحضر بعض الماء
Dialogue: 0,0:28:12.85,0:28:13.89,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:28:22.44,0:28:25.69,general text,,0,0,0,,مو دوك، ألم تستمع إلي؟
Dialogue: 0,0:28:25.77,0:28:27.82,نص عام,,0,0,0,,قلت لك استريحي
Dialogue: 0,0:28:30.82,0:28:32.41,نص عام,,0,0,0,,وماذا عن نفسك؟
Dialogue: 0,0:28:32.49,0:28:34.45,نص عام,,0,0,0,,قلت لك تضمد الجراح
Dialogue: 0,0:28:34.53,0:28:37.75,نص عام,,0,0,0,,ذهبت إلى سيجوكون. لقد استمعت لك
Dialogue: 0,0:28:41.46,0:28:42.67,نص عام,,0,0,0,,يمكنك التحقق
Dialogue: 0,0:28:45.96,0:28:47.17,نص عام,,0,0,0,,رائحة الشيح
Dialogue: 0,0:28:54.35,0:28:55.68,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:28:55.76,0:28:59.10,general text,,0,0,0,,لدي شجار كل يوم. فقط متعب
Dialogue: 0,0:29:06.32,0:29:07.65,نص عام,,0,0,0,,دفء
Dialogue: 0,0:29:10.32,0:29:12.45,general text,,0,0,0,,هل فركوك بالشيح الدافئ؟
Dialogue: 0,0:29:13.24,0:29:15.37,نص عام,,0,0,0,,أنا دافئ، أليس كذلك؟
Dialogue: 0,0:29:16.83,0:29:19.37,نص عام,,0,0,0,,نعم. دافئ
Dialogue: 0,0:29:23.67,0:29:27.46,ذكريات بخط مائل,,0,0,0,,لقد خدعت وأُرسلت إلى موت محقق
Dialogue: 0,0:29:28.50,0:29:29.51,ذكريات بخط مائل,,0,0,0,,ناك سو...
Dialogue: 0,0:29:29.59,0:29:32.42,ذكريات بخط مائل,,0,0,0,,أشعر بالأسف حقًا على هذا الطفل
Dialogue: 0,0:29:41.85,0:29:43.48,النص العام,,0,0,0,,لقد هدأت. اترك
Dialogue: 0,0:29:46.36,0:29:49.40,النص العام,,0,0,0,,- هل غيرت حذائك؟\N- نعم
Dialogue: 0,0:29:49.48,0:29:51.15,general text,,0,0,0,,هل أكلت ما أحضرته الخادمة كيم؟
Dialogue: 0,0:29:51.24,0:29:54.53,نص عام,,0,0,0,,نعم. في الواقع، لقد أكلت قبل أن تقترح.
Dialogue: 0,0:29:55.11,0:29:57.07,نص عام,,0,0,0,,أحسنت يا مو ديوك
Dialogue: 0,0:29:59.12,0:30:01.75,نص عام,,0,0,0,,لم أكن أعلم أن هذا الحجر يمكن أن
Dialogue: 0,0:30:04.50,0:30:05.58,نص عام,,0,0,0,,يشم يين يانغ؟
Dialogue: 0,0:30:05.67,0:30:07.67,نص عام,,0,0,0,,لم أفهم إلا لأنك أعطيتها للأمير
Dialogue: 0,0:30:08.42,0:30:10.00,نص عام,,0,0,0,,وماذا يستطيع أن يفعل؟
Dialogue: 0,0:30:10.09,0:30:12.05,نص عام,,0,0,0,,- Show\N- لا أستطيع
Dialogue: 0,0:30:12.13,0:30:13.72,نص عام,,0,0,0,,سأعرض,
Dialogue: 0,0:30:13.80,0:30:15.93,نص عام,,0,0,0,,متى سأعيد لك
Dialogue: 0,0:30:17.43,0:30:18.72,نص عام,,0,0,0,,سوف تعطيني إياه
Dialogue: 0,0:30:19.72,0:30:21.14,نص عام,,0,0,0,,متى ستستلمه؟
Dialogue: 0,0:30:22.89,0:30:25.31,نص عام,,0,0,0,,ماذا؟ لن تقبل؟
Dialogue: 0,0:30:28.98,0:30:32.65,نص عام,,0,0,0,,سأعيده وأضعه بين يديك
Dialogue: 0,0:30:32.74,0:30:35.53,نص عام,,0,0,0,,لديها الكثير من القوة
Dialogue: 0,0:30:35.61,0:30:36.95,نص عام,,0,0,0,,الحمد لله أننا لم نعلم بذلك
Dialogue: 0,0:30:37.03,0:30:39.58,نص عام,,0,0,0,,سوف تتفاجأ عندما ترى
Dialogue: 0,0:30:43.66,0:30:45.83,نص عام,,0,0,0,,أي نوع من القوة؟ أرني
Dialogue: 0,0:30:46.50,0:30:49.38,general text,,0,0,0,,سقط ولي العهد على الأرض ويزبد من فمه
Dialogue: 0,0:30:49.96,0:30:51.38,نص عام,,0,0,0,,كان الأمر فظيعًا
Dialogue: 0,0:30:51.46,0:30:53.96,نص عام,,0,0,0,,هذا منطقي. إنه من جينيوون
Dialogue: 0,0:30:54.05,0:30:56.05,النص العام,,0,0,0,,قد يكون هذا سلاحًا خطيرًا
Dialogue: 0,0:31:18.74,0:31:20.32,نص عام,,0,0,0,,مرحباً أيها النائب
Dialogue: 0,0:31:25.75,0:31:27.33,خط مائل,,0,0,0,,رئيس سوسنوفي بور
Dialogue: 0,0:31:27.41,0:31:30.54,نص عام,,0,0,0,,عدت لمراقبة حرق الجثة شخصيًا
Dialogue: 0,0:31:31.21,0:31:33.34,نص عام,,0,0,0,,ما خطبك هذه المرة؟
Dialogue: 0,0:31:33.42,0:31:36.17,نص عام,,0,0,0,,جئت لأنظر فقط
Dialogue: 0,0:31:37.13,0:31:40.09,نص عام,,0,0,0,,مازلت أرى السيد خان للمرة الأخيرة
Dialogue: 0,0:31:40.18,0:31:42.60,النص العام,,0,0,0,,أنا مضطر لإجرائه
Dialogue: 0,0:32:15.42,0:32:18.47,ذكريات بخط مائل,,0,0,0,,هل رأيت البدو بالفعل،
Dialogue: 0,0:32:18.55,0:32:20.47,ذكريات,,0,0,0,,حتى تتعرف على العلامة الزرقاء
Dialogue: 0,0:32:21.39,0:32:24.76,ذكريات,,0,0,0,,أنظر إن كان السيد "كان" لديه مثل هذه العلامة على جسده
Dialogue: 0,0:32:24.85,0:32:27.10,ذكريات,,0,0,0,,حتى لو كشفنا كيمياء النفوس،
Dialogue: 0,0:32:27.18,0:32:29.35,ذكريات,,0,0,0,,لا نعرف جسده الذي انتقل إليه
Dialogue: 0,0:32:30.73,0:32:34.69,ذكريات,,0,0,0,,عليك أن تفعل شيئًا للمساعدة في اكتشاف ذلك
Dialogue: 0,0:33:06.31,0:33:09.73,ذكريات,,0,0,0,,أعلم أنك أتقنت تشيسا بالفعل
Dialogue: 0,0:33:10.85,0:33:12.85,ذكريات,,0,0,0,,لم أتعمد الصمت عن هذا الأمر
Dialogue: 0,0:33:12.94,0:33:14.35,ذكريات,,0,0,0,,أنا لا أوبخك
Dialogue: 0,0:33:15.27,0:33:16.98,ذكريات,,0,0,0,,ما أطلب منك أن تفعله،
Dialogue: 0,0:33:17.07,0:33:19.61,ذكريات,,0,0,0,,خطير جداً ويمكن أن يحرمك من الطاقة
Dialogue: 0,0:33:20.40,0:33:22.74,ذكريات,,0,0,0,,ولكن فقط أولئك الذين يملكون تشيسو هم من يستطيعون فعل هذا
Dialogue: 0,0:33:23.82,0:33:26.95,ذكريات بخط مائل,,0,0,0,,يتحول البدوي إلى ابتلاع روح عندما يفقد الطاقة
Dialogue: 0,0:33:27.70,0:33:30.12,ذكريات مائلة,,0,0,0,,جسده لا يزال دافئًا
Dialogue: 0,0:33:30.87,0:33:33.17,ذكريات بخط مائل,,0,0,0,,اسكب طاقتك فيها،
Dialogue: 0,0:33:33.75,0:33:36.34,ذكريات بخط مائل,,0,0,0,,لجعله جامحًا
Dialogue: 0,0:34:03.53,0:34:05.20,نص عام,,0,0,0,,سيد...
Dialogue: 0,0:34:08.78,0:34:10.12,نص عام,,0,0,0,,ما هو؟
Dialogue: 0,0:34:10.20,0:34:12.83,نص عام,,0,0,0,,هو...
Dialogue: 0,0:34:27.14,0:34:29.72,نص عام,,0,0,0,,سأجمع العظام، ليتراجع الجميع
Dialogue: 0,0:34:32.81,0:34:35.73,نص عام,,0,0,0,,هذا بدوي،
Dialogue: 0,0:34:35.81,0:34:38.98,نص عام,,0,0,0,,الذي تحول إلى حجر
Dialogue: 0,0:34:41.65,0:34:45.03,النص العام,,0,0,0,,لا أحد يشك في وجود السحر هنا
Dialogue: 0,0:34:46.41,0:34:48.66,general text,,0,0,0,,هل تستطيع سوسنوفي بور التدخل الآن؟
Dialogue: 0,0:34:56.12,0:35:00.54,general text,,0,0,0,,لست منزعجاً، بل حاولت إخفاء ذلك
Dialogue: 0,0:35:01.13,0:35:03.59,نص عام,,0,0,0,,إذن أنت على علم بالأمر
Dialogue: 0,0:35:05.92,0:35:06.97,خط مائل,,0,0,0,,كنت تعلم,
Dialogue: 0,0:35:07.63,0:35:12.51,نص عام,,0,0,0,,هذا بدوي أصبح جامحًا
Dialogue: 0,0:35:36.25,0:35:38.04,نص عام,,0,0,0,,مهاراتك تشير إلى ذلك
Dialogue: 0,0:35:38.12,0:35:41.25,نص عام,,0,0,0,,أن روح المعلم كان موجودة في هذا الجسد
Dialogue: 0,0:35:42.92,0:35:44.80,نص عام,,0,0,0,,فروحه
Dialogue: 0,0:35:44.88,0:35:46.97,النص العام,,0,0,0,,ماتت في جسدك
Dialogue: 0,0:35:47.05,0:35:48.76,نص عام,,0,0,0,,هراء!
Dialogue: 0,0:36:08.24,0:36:09.45,نص عام,,0,0,0,,أنت متوحش،
Dialogue: 0,0:36:10.03,0:36:11.99,نص عام,,0,0,0,,خالي من الدم والطاقة
Dialogue: 0,0:36:15.24,0:36:18.50,general text,,0,0,0,,كلما زادت الطاقة التي تستخدمها، أصبحت أسرع في التحول إلى حجر.
Dialogue: 0,0:36:19.12,0:36:20.42,نص عام,,0,0,0,,توقف
Dialogue: 0,0:36:26.88,0:36:29.09,نص عام,,0,0,0,,من الأفضل ألا تتحرك!
Dialogue: 0,0:36:35.35,0:36:37.35,النص العام,,0,0,0,,- لا تقتله\N- اقتله
Dialogue: 0,0:38:22.87,0:38:25.21,النص العام,,0,0,0,,بدوي وحشي خطير
Dialogue: 0,0:38:25.71,0:38:27.50,النص العام,,0,0,0,,والحمد لله أن جيونبوغوان تعامل معه
Dialogue: 0,0:38:28.08,0:38:29.59,نص عام,,0,0,0,,لقد ساعدتنا،
Dialogue: 0,0:38:29.67,0:38:32.92,نص عام,,0,0,0,,حتى تأخذ بعض المجد
Dialogue: 0,0:38:37.01,0:38:39.01,نص عام,,0,0,0,,سيد.
Dialogue: 0,0:38:49.06,0:38:51.57,النص العام,,0,0,0,,بما أننا جزء من المجد،
Dialogue: 0,0:38:51.65,0:38:53.69,نص عام,,0,0,0,,سنأخذ الجسد وندرسه
Dialogue: 0,0:38:56.15,0:38:57.57,نص عام,,0,0,0,,من فضلك
Dialogue: 0,0:39:10.92,0:39:12.59,النص العام,,0,0,0,,أغلقت أبوابه،
Dialogue: 0,0:39:12.67,0:39:15.38,نص عام,,0,0,0,,حتى لا تتسرب الطاقة إلى الخارج
Dialogue: 0,0:39:16.13,0:39:18.22,general text,,0,0,0,,أعيدوه إلى الحياة لاستجوابه
Dialogue: 0,0:39:19.22,0:39:20.55,نص عام,,0,0,0,,هل هذا ممكن؟
Dialogue: 0,0:39:21.60,0:39:25.48,النص العام,,0,0,0,,اعتبره حجر التنفس. هل تريده أن يتحدث؟
Dialogue: 0,0:39:25.56,0:39:27.02,نص عام,,0,0,0,,لن يكون الأمر سهلاً
Dialogue: 0,0:39:35.36,0:39:38.45,general text,,0,0,0,,هل أنت خائف من أنه قد يكون على قيد الحياة؟
Dialogue: 0,0:39:40.87,0:39:42.66,النص العام,,0,0,0,,ومع ذلك، لن ينجحوا
Dialogue: 0,0:39:43.58,0:39:46.16,النص العام,,0,0,0,,سيكون هذا ممكنًا بحجر الجليد
Dialogue: 0,0:39:46.66,0:39:48.25,نص عام,,0,0,0,,لكنهم لا يملكونها
Dialogue: 0,0:39:48.92,0:39:52.04,النص العام,,0,0,0,,فهل يمكن إحياؤه بالحجر؟
Dialogue: 0,0:39:52.13,0:39:53.13,نص عام,,0,0,0,,نعم
Dialogue: 0,0:39:54.13,0:39:56.67,النص العام,,0,0,0,,وعندك هذا الحجر؟
Dialogue: 0,0:39:57.80,0:39:59.26,نص عام,,0,0,0,,ليس من الضروري أن تعرف
Dialogue: 0,0:40:00.64,0:40:02.47,نص عام,,0,0,0,,جهزوا المرتزقة
Dialogue: 0,0:40:03.22,0:40:04.76,نص عام,,0,0,0,,سأجد طريقة،
Dialogue: 0,0:40:04.85,0:40:07.39,النص العام,,0,0,0,,حتى لو اضطررت إلى نقل الروح إلى جسد الساحر جيونجينجاك
Dialogue: 0,0:40:14.48,0:40:16.69,نص عام,,0,0,0,,- أهلاً يا بو\N- ماذا؟
Dialogue: 0,0:40:16.78,0:40:17.74,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:40:26.12,0:40:27.37,نقوش,,0,0,0,,فن هيونغون
Dialogue: 0,0:40:27.45,0:40:29.04,نقوش,,0,0,0,,الموقف الصحفي لرأس النمر
Dialogue: 0,0:40:29.12,0:40:30.96,نقوش,,0,0,0,,موقف الهجوم المباشر
Dialogue: 0,0:42:04.30,0:42:05.47,نص عام,,0,0,0,,يول
Dialogue: 0,0:42:07.22,0:42:08.64,نص عام,,0,0,0,,المملكة المتحدة
Dialogue: 0,0:42:09.60,0:42:10.97,نص عام,,0,0,0,,هل ستذهب للتدريب؟
Dialogue: 0,0:42:12.14,0:42:13.10,نص عام,,0,0,0,,نعم
Dialogue: 0,0:42:13.89,0:42:14.81,نص عام,,0,0,0,,وأنت؟
Dialogue: 0,0:42:20.86,0:42:22.19,نص عام,,0,0,0,,وقاتلت
Dialogue: 0,0:42:24.15,0:42:25.49,نص عام,,0,0,0,,مع بدوي
Dialogue: 0,0:42:29.41,0:42:32.54,نص عام,,0,0,0,,السيد المتوفى كان كان بدوياً
Dialogue: 0,0:42:34.04,0:42:35.37,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:42:35.46,0:42:37.29,نص عام,,0,0,0,,كيف عرفت؟
Dialogue: 0,0:42:38.63,0:42:40.30,نص عام,,0,0,0,,إذا قمت بإخفاء العلامة الزرقاء،
Dialogue: 0,0:42:40.38,0:42:42.55,النص العام,,0,0,0,,ليس هناك طريقة لتمييزهم عن الآخرين
Dialogue: 0,0:42:43.47,0:42:45.22,النص العام,,0,0,0,,ولكن بمجرد أن يصبحوا جامحين،
Dialogue: 0,0:42:46.43,0:42:47.93,نص عام,,0,0,0,,لا رجعة إلى الوراء
Dialogue: 0,0:42:54.73,0:42:57.56,النص العام,,0,0,0,,بفقد طاقتهم يتحولون إلى حجر
Dialogue: 0,0:42:58.44,0:43:01.48,general text,,0,0,0,,ولا يمكنك التعافي إلا من خلال امتصاص طاقة شخص آخر
Dialogue: 0,0:43:02.98,0:43:04.49,نص عام,,0,0,0,,لقد فعلت هذا مرة واحدة،
Dialogue: 0,0:43:06.61,0:43:08.57,النص العام,,0,0,0,,يتحولون إلى وحوش
Dialogue: 0,0:43:11.79,0:43:12.95,نص عام,,0,0,0,,وحوش؟
Dialogue: 0,0:43:28.01,0:43:30.39,نص عام,,0,0,0,,ومهمتنا هي حماية العالم
Dialogue: 0,0:43:34.52,0:43:36.10,نص عام,,0,0,0,,منهم
Dialogue: 0,0:43:44.78,0:43:47.36,النص العام,,0,0,0,,يمكننا حماية هذه الوحوش من العالم
Dialogue: 0,0:43:49.28,0:43:50.91,نص عام,,0,0,0,,سنراقب ذلك،
Dialogue: 0,0:43:51.74,0:43:53.62,النص العام,,0,0,0,,وسيحل السلام في العالم
Dialogue: 0,0:43:54.83,0:43:57.50,general text,,0,0,0,,الجميع يعلق عليك آمالاً كبيرة منذ الصغر،
Dialogue: 0,0:43:57.58,0:44:00.54,نص عام,,0,0,0,,لذلك تعتقد أنك يجب أن تفعل شيئًا مفيدًا
Dialogue: 0,0:44:00.63,0:44:01.96,نص عام,,0,0,0,,حسنًا، قالوا لي،
Dialogue: 0,0:44:03.21,0:44:05.26,نص عام,,0,0,0,,حتى لا أخرج رأسي
Dialogue: 0,0:44:07.72,0:44:08.93,نص عام,,0,0,0,,أنا
Dialogue: 0,0:44:10.47,0:44:12.26,نص عام,,0,0,0,,اتبع قلبي
Dialogue: 0,0:44:38.83,0:44:42.13,نص عام,,0,0,0,,سمح جين مو لإغلاق غابة الصنوبر
Dialogue: 0,0:44:42.21,0:44:44.92,general text,,0,0,0,,ماذا لو بدأوا في الشك بالقصر؟
Dialogue: 0,0:44:45.67,0:44:46.96,نص عام,,0,0,0,,القصر...
Dialogue: 0,0:44:47.96,0:44:52.43,نص عام,,0,0,0,,ليس مكانًا يمكن أن يقتحمه بارك جين، كما هو الحال في دايجانتونججن
Dialogue: 0,0:44:52.51,0:44:55.56,النص العام,,0,0,0,,ولكن إذا ظهر سأكون في خطر
Dialogue: 0,0:44:56.14,0:44:57.97,نص عام,,0,0,0,,منذ وفاة كيل جو
Dialogue: 0,0:44:58.06,0:44:59.85,نص عام,,0,0,0,,لم آكل الطاقة
Dialogue: 0,0:45:01.64,0:45:04.27,نص عام,,0,0,0,,أخشى أن أكون جامحًا
Dialogue: 0,0:45:07.65,0:45:10.11,نص عام,,0,0,0,,يمكنك المشاركة معي
Dialogue: 0,0:45:11.03,0:45:12.61,نص عام,,0,0,0,,بقوة حجر الجليد؟
Dialogue: 0,0:45:13.95,0:45:14.95,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:45:15.03,0:45:18.45,general text,,0,0,0,,الوحيد الذي يستطيع خدمتك، بمعرفة وجهك الحقيقي،
Dialogue: 0,0:45:22.67,0:45:24.33,نص عام,,0,0,0,,هذا أنا، ألا توافقينني الرأي؟
Dialogue: 0,0:45:25.54,0:45:26.75,نص عام,,0,0,0,,شامان
Dialogue: 0,0:45:28.00,0:45:29.63,نص عام,,0,0,0,,أيها اللقيط...
Dialogue: 0,0:45:29.71,0:45:32.22,النص العام,,0,0,0,,قلت لك ألا تخاطبني بهذه الطريقة
Dialogue: 0,0:45:34.26,0:45:36.51,general text,,0,0,0,,هل تريد أن تتحول إلى حجر في أسرع وقت ممكن؟
Dialogue: 0,0:45:39.10,0:45:40.31,نص عام,,0,0,0,,أعلم أنك لا تستطيع ذلك
Dialogue: 0,0:45:41.98,0:45:44.52,النص العام,,0,0,0,,أنا الوحيد في القصر الذي يعرف،
Dialogue: 0,0:45:44.60,0:45:47.52,نص عام,,0,0,0,,أنت الشامان تشوي،
Dialogue: 0,0:45:47.61,0:45:50.65,نص عام,,0,0,0,,هاجر إلى جسد الملكة
Dialogue: 0,0:45:52.07,0:45:53.53,نص عام,,0,0,0,,إذا مت,
Dialogue: 0,0:45:53.61,0:45:57.83,النص العام,,0,0,0,,هل يمكنك نقل أختك من جينيوون إلى هنا؟
Dialogue: 0,0:46:02.16,0:46:03.37,نص عام,,0,0,0,,بالإضافة إلى ذلك,
Dialogue: 0,0:46:04.12,0:46:09.09,نص عام,,0,0,0,,ملكة حقيقية في جسدك
Dialogue: 0,0:46:11.13,0:46:15.39,general text,,0,0,0,,هل أتوقف عن زيارتها؟
Dialogue: 0,0:46:15.97,0:46:17.01,نص عام,,0,0,0,,هاه؟
Dialogue: 0,0:46:21.56,0:46:23.69,نص عام,,0,0,0,,الأمر يزداد صعوبة بالنسبة لي
Dialogue: 0,0:46:24.73,0:46:26.65,نص عام,,0,0,0,,عيش في هذا الجسد
Dialogue: 0,0:46:28.65,0:46:30.86,نص عام,,0,0,0,,أخبر جين مو
Dialogue: 0,0:46:30.94,0:46:34.78,نص عام,,0,0,0,,انقل روحي إلى جسد آخر
Dialogue: 0,0:46:36.49,0:46:37.74,نص عام,,0,0,0,,جلالتك
Dialogue: 0,0:46:41.16,0:46:42.41,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:46:43.50,0:46:44.87,نص عام,,0,0,0,,يمكنك الذهاب
Dialogue: 0,0:47:10.94,0:47:12.23,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:47:13.19,0:47:15.40,النص العام,,0,0,0,,سأستسلم لك وسينتهي كل شيء
Dialogue: 0,0:47:20.32,0:47:22.16,نص عام,,0,0,0,,أنا أستسلم
Dialogue: 0,0:47:22.74,0:47:24.04,نص عام,,0,0,0,,مرحبًا، المملكة المتحدة... المملكة المتحدة!
Dialogue: 0,0:47:31.29,0:47:32.84,نص عام,,0,0,0,,أردت الرحيل قبلي
Dialogue: 0,0:47:32.92,0:47:34.17,نص عام,,0,0,0,,ولقد فزت
Dialogue: 0,0:47:41.18,0:47:43.60,general text,,0,0,0,,أراد دان غو أن يسمح لك بالفوز
Dialogue: 0,0:47:43.68,0:47:45.06,النص العام,,0,0,0,,كيف يمكنك أن ترفض؟
Dialogue: 0,0:47:45.14,0:47:47.52,نص عام,,0,0,0,,لم أعلم أنك فخور بنفسك إلى هذه الدرجة
Dialogue: 0,0:47:47.60,0:47:50.52,general text,,0,0,0,,لقد فعلت شيئًا كهذا لتجعلني أرفض
Dialogue: 0,0:47:50.61,0:47:51.69,نص عام,,0,0,0,,متى هذا؟
Dialogue: 0,0:47:51.77,0:47:53.61,نص عام,,0,0,0,,كانت نظرة ارتياح
Dialogue: 0,0:47:53.69,0:47:55.44,نص عام,,0,0,0,,كان ينبغي أن يظهر
Dialogue: 0,0:47:56.11,0:47:57.03,نص عام,,0,0,0,,أعجبني هذا
Dialogue: 0,0:47:57.11,0:47:58.40,نص عام,,0,0,0,,لقد فعلت ذلك بالضبط
Dialogue: 0,0:47:59.49,0:48:02.78,نص عام,,0,0,0,,وكيف كان يمكن فهم ذلك؟ لو فهمت سأوافق
Dialogue: 0,0:48:04.33,0:48:05.91,نص عام,,0,0,0,,بقيت معركة واحدة
Dialogue: 0,0:48:06.62,0:48:07.87,نص عام,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,0:48:07.96,0:48:09.46,النص العام,,0,0,0,,انتظر، هل تلومني؟
Dialogue: 0,0:48:10.04,0:48:12.67,general text,,0,0,0,,أنت بنفسك أعطيته اليشم، وهل أنت غاضب مني؟
Dialogue: 0,0:48:12.75,0:48:15.30,general text,,0,0,0,,هل تحرك الأسهم الآن؟
Dialogue: 0,0:48:15.38,0:48:16.84,نص عام,,0,0,0,,كم هو طفولي
Dialogue: 0,0:48:16.92,0:48:19.43,نص عام,,0,0,0,,طفولية؟ إظهار السلوك الطفولي حقا؟
Dialogue: 0,0:48:19.51,0:48:20.47,نص عام,,0,0,0,,سأتخلى عن كل شيء
Dialogue: 0,0:48:21.59,0:48:22.60,general text,,0,0,0,,هل يجب أن أتصرف هكذا؟
Dialogue: 0,0:48:32.69,0:48:35.48,general text,,0,0,0,,السحرة يحرسون سايجوكون منذ الليلة الماضية
Dialogue: 0,0:48:36.57,0:48:39.49,النص العام,,0,0,0,,أكيد جسد مبتلع الروح موجود
Dialogue: 0,0:48:39.57,0:48:42.32,general text,,0,0,0,,إذا مات يؤخذ الجثمان إلى الغرفة السرية
Dialogue: 0,0:48:42.82,0:48:45.54,general text,,0,0,0,,لماذا تم وضعه في سيجوكون، وهو للأحياء؟
Dialogue: 0,0:48:54.59,0:48:58.05,النص العام,,0,0,0,,جئت لمعرفة ما حدث للجثة
Dialogue: 0,0:48:58.13,0:49:00.38,نص عام,,0,0,0,,انتظر. سأبلغ الرأس
Dialogue: 0,0:49:17.07,0:49:20.49,general text,,0,0,0,,سمعت أن الرأس في سايجوكون، فجئت لرؤيته
Dialogue: 0,0:49:20.57,0:49:23.07,نص عام,,0,0,0,,لا يُسمح لأحد بدخول سيجوكون بعد
Dialogue: 0,0:49:23.16,0:49:25.45,نص عام,,0,0,0,,ثم أولاً سألتقي بالسيد.
Dialogue: 0,0:49:25.53,0:49:27.62,نص عام,,0,0,0,,أخبر الرئيس أنني هنا
Dialogue: 0,0:49:29.20,0:49:30.45,النص العام,,0,0,0,,لقد وصل جين مو
Dialogue: 0,0:49:31.83,0:49:34.83,نص عام,,0,0,0,,تحقق مما إذا كان آكل الروح قد مات بالفعل
Dialogue: 0,0:49:35.96,0:49:38.34,نص عام,,0,0,0,,قل لي أن أغادر بينما لا نزال نحقق
Dialogue: 0,0:49:38.42,0:49:41.51,نص عام,,0,0,0,,نعم. لقد جاء شخص آخر لرؤيتك
Dialogue: 0,0:49:42.34,0:49:43.47,نص عام,,0,0,0,,دعه يذهب
Dialogue: 0,0:49:43.55,0:49:46.14,نص عام,,0,0,0,,لا تسمح لأحد بالدخول إلى سايجوكون
Dialogue: 0,0:49:46.22,0:49:47.18,نص عام,,0,0,0,,نعم
Dialogue: 0,0:49:47.26,0:49:49.72,نص عام,,0,0,0,,سأطلب من الخادمة كيم أن تغادر
Dialogue: 0,0:49:51.02,0:49:52.14,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:49:53.23,0:49:54.40,نص عام,,0,0,0,,عذراء كيم؟
Dialogue: 0,0:49:54.48,0:49:57.36,general text,,0,0,0,,سأخبرها أن الرأس لا يقبل أحداً
Dialogue: 0,0:50:00.28,0:50:01.49,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:50:02.78,0:50:06.20,نص عام,,0,0,0,,يمكنها استثناءً
Dialogue: 0,0:50:15.88,0:50:18.25,النص العام,,0,0,0,,لم أرك منذ وقت طويل أيتها الخادمة كيم
Dialogue: 0,0:50:37.56,0:50:40.98,general text,,0,0,0,,لقد مكثت في منزل غوانغجو تشانغ غان عندما خدمته،
Dialogue: 0,0:50:41.65,0:50:44.61,نص عام,,0,0,0,,ولقد قمت بطهي الطعام اللذيذ
Dialogue: 0,0:50:45.74,0:50:47.20,نص عام,,0,0,0,,لقد أكلت كثيراً،
Dialogue: 0,0:50:47.70,0:50:51.12,نص عام,,0,0,0,,أن وعاء الأرز الخاص بك كان الأكبر
Dialogue: 0,0:50:52.25,0:50:53.37,نص عام,,0,0,0,,هل تتذكر؟
Dialogue: 0,0:50:53.45,0:50:56.62,نص عام,,0,0,0,,كان لديك وعاء ضخم حقًا
Dialogue: 0,0:50:56.71,0:50:59.67,النص العام,,0,0,0,,كنت جائعًا دائمًا حينها
Dialogue: 0,0:51:00.59,0:51:04.17,نص عام,,0,0,0,,ربما قمت بطهي شيء لذيذ مرة أخرى
Dialogue: 0,0:51:04.76,0:51:07.89,نص عام,,0,0,0,,نعم. لقد أعددتهم بنفسي
Dialogue: 0,0:51:12.06,0:51:15.64,نص عام,,0,0,0,,كعكة العسل. لقد أحببتهم كثيرًا من قبل
Dialogue: 0,0:51:15.73,0:51:16.94,نص عام,,0,0,0,,هذا كل شيء
Dialogue: 0,0:51:17.02,0:51:20.02,نص عام,,0,0,0,,طلبت منك أن تنقل غوانغجو،
Dialogue: 0,0:51:20.11,0:51:23.15,نص عام,,0,0,0,,وتضع زوجين في جيوبك
Dialogue: 0,0:51:24.36,0:51:28.03,النص العام,,0,0,0,,لأنني لم أتمكن من تناول الطعام\N إلا عندما ينتهي
Dialogue: 0,0:51:28.86,0:51:32.99,general text,,0,0,0,,على أية حال، لقد ربحت الكثير من خلال متابعة غوانغجو.
Dialogue: 0,0:51:33.08,0:51:35.12,نص عام,,0,0,0,,أكلت لذيذاً,
Dialogue: 0,0:51:36.08,0:51:38.54,نص عام,,0,0,0,,تعليم تعاويذ خاصة
Dialogue: 0,0:51:43.71,0:51:47.13,general text,,0,0,0,,مذاقها أفضل عندما تأكلها سراً، أليس كذلك؟
Dialogue: 0,0:51:53.93,0:51:55.14,نص عام,,0,0,0,,لذلك
Dialogue: 0,0:51:56.10,0:51:58.56,النص العام,,0,0,0,,الحلويات دائماً خطيرة جداً
Dialogue: 0,0:51:58.64,0:52:02.65,نص عام,,0,0,0,,بمجرد تجربتها، لن تتمكن من التوقف
Dialogue: 0,0:52:06.03,0:52:07.61,نص عام,,0,0,0,,لا تفرق،
Dialogue: 0,0:52:09.16,0:52:10.74,نص عام,,0,0,0,,ماذا يمكنك أن تأكل,
Dialogue: 0,0:52:12.45,0:52:14.16,نص عام,,0,0,0,,وما لا
Dialogue: 0,0:52:16.25,0:52:19.00,general text,,0,0,0,,لقد جرحتني بعدم السماح لي حتى بالمحاولة
Dialogue: 0,0:52:21.00,0:52:24.55,نص عام,,0,0,0,,لا تكن جشعًا جدًا
Dialogue: 0,0:52:28.76,0:52:32.05,النص العام,,0,0,0,,غوانغجو أحب ملفات تعريف الارتباط هذه حقًا
Dialogue: 0,0:52:32.14,0:52:34.01,نص عام,,0,0,0,,وإبنه؟
Dialogue: 0,0:52:34.10,0:52:37.14,النص العام,,0,0,0,,السيد الشاب يحبهم أيضًا
Dialogue: 0,0:52:37.22,0:52:39.69,نص عام,,0,0,0,,إذن عليك مشاركته معه
Dialogue: 0,0:52:40.85,0:52:45.15,نص عام,,0,0,0,,يمكنني أن أحكي له الكثير من القصص عن والدي
Dialogue: 0,0:52:52.74,0:52:56.04,النص العام,,0,0,0,,ليس لديك أنت وبريطانيا ما تتحدثان عنه
Dialogue: 0,0:52:56.12,0:52:57.83,نص عام,,0,0,0,,يمكنك الذهاب
Dialogue: 0,0:52:57.91,0:53:00.75,general text,,0,0,0,,أراد ملفات تعريف الارتباط فقط. ما مشكلتك؟
Dialogue: 0,0:53:01.46,0:53:04.63,نص عام,,0,0,0,,لا تدعني أشاركه الذكريات
Dialogue: 0,0:53:04.71,0:53:05.67,نص عام,,0,0,0,,يجب أن يكون كذلك،
Dialogue: 0,0:53:07.46,0:53:09.92,نص عام,,0,0,0,,مرة أخرى، لا تريدني أن أتطرق إليك
Dialogue: 0,0:53:12.76,0:53:13.89,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:53:14.76,0:53:17.97,نص عام,,0,0,0,,هذا للسيد،
Dialogue: 0,0:53:18.06,0:53:19.60,نص عام,,0,0,0,,ولكن يمكنك أن تأخذ
Dialogue: 0,0:53:20.14,0:53:21.23,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:53:22.14,0:53:23.35,نص عام,,0,0,0,,لا تعطه
Dialogue: 0,0:53:24.27,0:53:26.32,نص عام,,0,0,0,,لو أردت ذلك حقًا،
Dialogue: 0,0:53:26.86,0:53:29.32,نص عام,,0,0,0,,كنت قد سرقت زوجين بالفعل
Dialogue: 0,0:53:29.99,0:53:32.20,نص عام,,0,0,0,,لكنني سأدعك تفوز
Dialogue: 0,0:53:34.66,0:53:38.91,النص العام,,0,0,0,,لم نرى بعضنا البعض منذ فترة طويلة. من المؤسف أن نقول وداعا
Dialogue: 0,0:53:47.80,0:53:49.05,general text,,0,0,0,,اعتاد جين مو على الانتقام،
Dialogue: 0,0:53:49.13,0:53:52.01,نص عام,,0,0,0,,إذا وبخ على الأكل
Dialogue: 0,0:53:52.68,0:53:54.26,نص عام,,0,0,0,,إنها مجرد ملفات تعريف الارتباط
Dialogue: 0,0:53:54.34,0:53:55.97,نص عام,,0,0,0,,كان يجب أن أعطيه القليل
Dialogue: 0,0:53:56.05,0:53:58.14,النص العام,,0,0,0,,أنا فقط لا أريده أن يأكل ذلك،
Dialogue: 0,0:53:59.52,0:54:03.31,نص عام,,0,0,0,,ما واجهت صعوبة في تحضيره
Dialogue: 0,0:54:05.15,0:54:06.27,نص عام,,0,0,0,,اجلس
Dialogue: 0,0:54:06.36,0:54:08.48,نص عام,,0,0,0,,لم نرى بعضنا البعض منذ فترة طويلة
Dialogue: 0,0:54:08.57,0:54:11.99,نص عام,,0,0,0,,دعونا نتحدث أثناء تناول كوب من الشاي
Dialogue: 0,0:54:15.61,0:54:17.32,نص عام,,0,0,0,,هل هناك خطأ ما؟
Dialogue: 0,0:54:18.16,0:54:19.70,نص عام,,0,0,0,,تبدو متعبًا
Dialogue: 0,0:54:23.71,0:54:25.00,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:54:26.17,0:54:30.46,النص العام,,0,0,0,,سآكل البسكويت الخاص بك وأعود إلى صوابي على الفور
Dialogue: 0,0:54:40.43,0:54:41.72,خط مائل,,0,0,0,,مو دوك
Dialogue: 0,0:54:42.89,0:54:44.52,نص عام,,0,0,0,,لدي مهمة
Dialogue: 0,0:54:44.60,0:54:46.56,نص عام,,0,0,0,,الطلب؟ أيّ؟
Dialogue: 0,0:54:46.65,0:54:47.86,نص عام,,0,0,0,,اذهب إلى جيونبوغوان
Dialogue: 0,0:54:49.06,0:54:52.36,نص عام,,0,0,0,,لا يزال هذا خطأ. مرر هذا
Dialogue: 0,0:54:53.69,0:54:54.95,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:54:59.70,0:55:01.62,النص العام,,0,0,0,,هل حدث شيء ما في سيجوكون؟
Dialogue: 0,0:55:02.70,0:55:05.21,نص عام,,0,0,0,,لا أعرف كل شيء
Dialogue: 0,0:55:05.29,0:55:08.79,general text,,0,0,0,,لكن يبدو أن هذا مرتبط بما حدث مع ديجانتونجون
Dialogue: 0,0:55:09.59,0:55:11.75,general text,,0,0,0,,سمعت أن جيونبوغوان وسوسنوفي بور كانا يتقاتلان
Dialogue: 0,0:55:17.22,0:55:18.09,نص عام,,0,0,0,,أين يول؟
Dialogue: 0,0:55:18.18,0:55:19.89,نص عام,,0,0,0,,لم أره منذ الليلة الماضية
Dialogue: 0,0:55:19.97,0:55:21.89,نص عام,,0,0,0,,ربما تنفيذ التعليمات من الرأس
Dialogue: 0,0:55:23.14,0:55:24.27,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:55:25.85,0:55:27.14,ذكريات بخط مائل,,0,0,0,,وقاتلت
Dialogue: 0,0:55:29.27,0:55:30.69,ذكريات,,0,0,0,,مع بدوي
Dialogue: 0,0:55:43.29,0:55:45.45,نص عام,,0,0,0,,يجب علينا تعزيز الحدود
Dialogue: 0,0:55:45.54,0:55:48.37,النص العام,,0,0,0,,ممنوع عليك مغادرة سوسنوفي بور
Dialogue: 0,0:55:50.29,0:55:52.04,مائل,,0,0,0,,أولئك الذين يملكون ريوسو وأكثر،
Dialogue: 0,0:55:52.13,0:55:55.55,نص عام,,0,0,0,,اذهب إلى سايجوكون واتبع أوامر سانغ هو.
Dialogue: 0,0:55:55.63,0:55:56.76,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:55:57.63,0:55:58.55,خط مائل,,0,0,0,,تشانغ ووك
Dialogue: 0,0:55:59.89,0:56:00.89,نص عام,,0,0,0,,ابقى
Dialogue: 0,0:56:02.30,0:56:04.01,نص عام,,0,0,0,,الجميع باستثناء تشان ووك،
Dialogue: 0,0:56:04.10,0:56:06.89,نص عام,,0,0,0,,تابع سانغ هو إلى سايجوكون
Dialogue: 0,0:56:06.98,0:56:08.27,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:56:13.82,0:56:14.98,نص عام,,0,0,0,,الفصل
Dialogue: 0,0:56:15.86,0:56:17.78,نص عام,,0,0,0,,لماذا لن أذهب؟
Dialogue: 0,0:56:17.86,0:56:20.66,النص العام,,0,0,0,,لست بحاجة إليه لأنه ليس هناك حاجة إليك هناك
Dialogue: 0,0:56:21.91,0:56:23.78,النص العام,,0,0,0,,هل هناك شيء خطير هناك؟
Dialogue: 0,0:56:24.83,0:56:26.20,النص العام,,0,0,0,,هل يوجد بدو هناك؟
Dialogue: 0,0:56:26.79,0:56:28.87,نص عام,,0,0,0,,ليس من شأنك
Dialogue: 0,0:56:29.62,0:56:31.04,نص عام,,0,0,0,,لا تهتم حتى
Dialogue: 0,0:56:31.13,0:56:33.92,general text,,0,0,0,,لماذا تخفي عني كل شيء؟ أنا ساحر هنا أيضًا
Dialogue: 0,0:56:34.00,0:56:37.34,نص عام,,0,0,0,,أنت الاستثناء لجميع القواعد
Dialogue: 0,0:56:37.92,0:56:40.72,النص العام,,0,0,0,,إذا كنت تشعر بالملل، يمكنك مغادرة سوسنوفي بور
Dialogue: 0,0:56:40.80,0:56:44.18,نص عام,,0,0,0,,اذهب إلى بيتك وافعل ما يحلو لك
Dialogue: 0,0:56:46.85,0:56:50.35,نص عام,,0,0,0,,نعم. شكرا لك على القلق
Dialogue: 0,0:57:08.45,0:57:09.62,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:57:10.79,0:57:13.00,النص العام,,0,0,0,,دعونا نذهب إلى تشويسونرا ونأكل شيئًا لذيذًا
Dialogue: 0,0:57:14.63,0:57:18.09,النص العام,,0,0,0,,جميع السحرة في سيجوكون. لماذا لا؟
Dialogue: 0,0:57:19.67,0:57:21.13,نص عام,,0,0,0,,قيل لي ألا أتدخل
Dialogue: 0,0:57:21.22,0:57:24.22,نص عام,,0,0,0,,وهذا ليس من شأني
Dialogue: 0,0:57:24.80,0:57:27.43,general text,,0,0,0,,- هيا بنا\N- الخادمة كيم أعطتني مهمة
Dialogue: 0,0:57:28.14,0:57:30.60,نص عام,,0,0,0,,حسنًا. دعونا نذهب معا. أين يجب أن أذهب؟
Dialogue: 0,0:57:31.44,0:57:32.56,نص عام,,0,0,0,,جونبوغوان
Dialogue: 0,0:57:34.31,0:57:35.23,نص عام,,0,0,0,,هيا بنا إذن
Dialogue: 0,0:57:39.99,0:57:44.66,general text,,0,0,0,,سمعتك أخبرتها أنك تريد جسداً آخر.
Dialogue: 0,0:57:46.78,0:57:48.12,النص العام,,0,0,0,,هل ستعطيني إياها؟
Dialogue: 0,0:57:48.91,0:57:53.17,general text,,0,0,0,,إذن أريد جسد الفتاة التي ستنضم إلى جينيونغ بدور بو يونغ.
Dialogue: 0,0:57:55.54,0:57:57.25,نص عام,,0,0,0,,بعد أن كنت في جسد الخصي،
Dialogue: 0,0:57:58.00,0:57:59.71,النص العام,,0,0,0,,لا أمانع أن أكون في جسد امرأة
Dialogue: 0,0:58:00.51,0:58:05.43,النص العام,,0,0,0,,أريد جسمًا قويًا، مثل جسد الشامان.
Dialogue: 0,0:58:07.10,0:58:08.35,نص عام,,0,0,0,"شامان"؟
Dialogue: 0,0:58:09.60,0:58:11.93,النص العام,,0,0,0,,كانت منزعجة لأنك ذكرتها بها
Dialogue: 0,0:58:12.02,0:58:15.15,نص عام,,0,0,0,,أنها كانت شامان، عرافة.
Dialogue: 0,0:58:15.77,0:58:17.36,نص عام,,0,0,0,,لم أكذب
Dialogue: 0,0:58:19.82,0:58:24.49,general text,,0,0,0,,وتذكرت أيضًا كيف طلبت الطعام وسرقت الحلوى
Dialogue: 0,0:58:26.16,0:58:30.20,general text,,0,0,0,,لم تكن كذبة، لكنني لم أكن سعيدًا بسماع شيء كهذا
Dialogue: 0,0:58:40.05,0:58:43.22,النص العام,,0,0,0,,أراد جين مو أن يأكل البسكويت،
Dialogue: 0,0:58:43.30,0:58:45.09,نص عام,,0,0,0,,لكن بارك جين لم يسمح له بذلك
Dialogue: 0,0:58:45.72,0:58:47.72,general text,,0,0,0,,كانت مايدن كيم قلقة من أن جي مو سيشعر بالإهانة،
Dialogue: 0,0:58:47.80,0:58:49.76,النص العام,,0,0,0,,لذلك طلبت منك أن تعطيه هذه
Dialogue: 0,0:58:49.85,0:58:52.81,general text,,0,0,0,,إذن، كانوا يتجادلون مثل الأطفال حول الطعام؟
Dialogue: 0,0:58:52.89,0:58:55.64,نص عام,,0,0,0,,الفصل أحيانًا تافه جدًا
Dialogue: 0,0:58:55.73,0:58:58.56,نص عام,,0,0,0,,تجادلون حول بسكويت العسل؟!
Dialogue: 0,0:58:58.65,0:59:00.94,نص عام,,0,0,0,,حقك هذا تافه
Dialogue: 0,0:59:08.07,0:59:09.62,ذكريات بخط مائل,,0,0,0,,هنا في جيونبوغوان
Dialogue: 0,0:59:09.70,0:59:12.49,ذكريات بخط مائل,,0,0,0,,نكتب كل النجوم
Dialogue: 0,0:59:35.73,0:59:39.19,النص العام,,0,0,0,,سأخبر النائب أن هذا من عائلة تشان
Dialogue: 0,0:59:39.98,0:59:43.61,نص عام,,0,0,0,,قل له إنها من الخادمة كيم
Dialogue: 0,0:59:44.90,0:59:47.24,نص عام,,0,0,0,,وكذلك أنها تحتوي على الكثير من الزيت
Dialogue: 0,0:59:47.32,0:59:49.62,النص العام,,0,0,0,,ويجب غسله بالشاي الأخضر.
Dialogue: 0,0:59:49.70,0:59:50.78,نص عام,,0,0,0,,نعم يا سيدي
Dialogue: 0,0:59:50.87,0:59:53.49,النص العام,,0,0,0,,وهناك بالطبع العسل
Dialogue: 0,0:59:53.58,0:59:55.87,general text,,0,0,0,,يجب تخزينها في البرد وإلا ستلتصق ببعضها البعض.
Dialogue: 0,0:59:55.95,0:59:58.37,general text,,0,0,0,,- نعم يا سيدي\N- ومنذ أن أحضرناهم،
Dialogue: 0,0:59:58.46,1:00:00.42,نص عام,,0,0,0,,- هل يمكنني الدخول؟\N- نعم...
Dialogue: 0,1:00:00.50,1:00:02.92,نص عام,,0,0,0,,- ماذا؟\N- شكرًا لك. لن نصمد طويلا
Dialogue: 0,1:00:03.00,1:00:03.92,نص عام,,0,0,0,,لنذهب
Dialogue: 0,1:00:05.59,1:00:06.55,نص عام,,0,0,0,,لكن...
Dialogue: 0,1:00:14.39,1:00:16.31,نص عام,,0,0,0,,لطالما أردت الزيارة هنا
Dialogue: 0,1:00:16.39,1:00:19.85,general text,,0,0,0,,رغم أن والدي هو غوانغجو، لم يُسمح لي بالتواجد هنا
Dialogue: 0,1:00:24.36,1:00:26.65,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,1:00:28.45,1:00:31.03,نص عام,,0,0,0,,كنت هنا، أليس كذلك؟
Dialogue: 0,1:00:31.12,1:00:33.24,نص عام,,0,0,0,,كان والدك منجمًا هنا
Dialogue: 0,1:00:34.41,1:00:36.33,نص عام,,0,0,0,,هل أتيت إلى هنا من أجلي؟
Dialogue: 0,1:00:38.96,1:00:42.04,نص عام,,0,0,0,,كان من الممكن أن تطلب من شخص ما تسليم ملفات تعريف الارتباط
Dialogue: 0,1:00:42.71,1:00:45.75,general text,,0,0,0,,لكنني أتيت بمفردي لأنني أردت ذلك، هل أنا على حق؟
Dialogue: 0,1:00:50.43,1:00:53.47,general text,,0,0,0,,عندما كنت طفلاً، كثيرًا ما كان والدي يحضرني إلى هنا
Dialogue: 0,1:00:54.60,1:00:58.02,نص عام,,0,0,0,,حتى أنني أراني تسجيلاً لليوم الذي ولدت فيه
Dialogue: 0,1:00:59.48,1:01:01.10,نص عام,,0,0,0,,كان أباً صالحاً
Dialogue: 0,1:01:04.61,1:01:06.15,نص عام,,0,0,0,,إذا فكرت في الأمر،
Dialogue: 0,1:01:06.23,1:01:09.32,نص عام,,0,0,0,,بالتأكيد هناك تسجيل هنا من عيد ميلادك أيضًا
Dialogue: 0,1:01:11.70,1:01:13.20,نص عام,,0,0,0,,هل تعتقد؟
Dialogue: 0,1:01:14.53,1:01:18.04,نص عام,,0,0,0,,لذا، التسجيل من ذلك اليوم يجب أن يكون هنا في مكان ما
Dialogue: 0,1:01:31.38,1:01:33.93,نص عام,,0,0,0,,لقد وعدتني بجسد جديد
Dialogue: 0,1:01:34.47,1:01:37.10,النص العام,,0,0,0,,ولكن بدلاً من ذلك تتحول إلى حجر
Dialogue: 0,1:01:37.76,1:01:39.18,نص عام,,0,0,0,,لم تعد هناك حاجة إليك
Dialogue: 0,1:01:39.85,1:01:42.27,نص عام,,0,0,0,,وستتحول إلى حجر
Dialogue: 0,1:01:57.99,1:01:59.29,نص عام,,0,0,0,,أيها اللقيط...
Dialogue: 0,1:02:18.22,1:02:20.47,النص العام,,0,0,0,,عندما يأتي الليل سيأتي السحرة
Dialogue: 0,1:02:21.10,1:02:22.64,نص عام,,0,0,0,,دعونا نرى كيف يدونون الملاحظات؟
Dialogue: 0,1:02:22.73,1:02:24.81,نص عام,,0,0,0,,يقولون إنه مشهد مذهل
Dialogue: 0,1:02:27.02,1:02:30.73,النص العام,,0,0,0,,سيكون الأمر رائعًا، ولكن ستكون هناك مشاكل إذا تم القبض علينا
Dialogue: 0,1:02:30.82,1:02:31.94,نص عام,,0,0,0,,دعونا نعود للمنزل
Dialogue: 0,1:02:45.58,1:02:47.25,نص عام,,0,0,0,,الخصي كيم أصبح جامحًا
Dialogue: 0,1:02:47.33,1:02:49.71,نص عام,,0,0,0,,لا ينبغي لأحد أن يعرف أنه بدوي
Dialogue: 0,1:02:50.30,1:02:53.72,general text,,0,0,0,,لا يزال في جيونبوغوان. يجب أن نجده قبل الفجر
Dialogue: 0,1:02:53.80,1:02:54.97,نص عام,,0,0,0,,نعم
Dialogue: 0,1:03:38.39,1:03:39.85,نص عام,,0,0,0,,أعلم أنك هنا
Dialogue: 0,1:03:40.39,1:03:42.68,نص عام,,0,0,0,,لا داعي لخلق المشاكل، اخرج
Dialogue: 0,1:03:42.76,1:03:44.31,نص عام,,0,0,0,,سأعطيك ما تريد
Dialogue: 0,1:03:52.40,1:03:53.65,نص عام,,0,0,0,,اخرج
Dialogue: 0,1:03:55.94,1:03:57.86,نص عام,,0,0,0,,- الآن!\N- سأغادر
Dialogue: 0,1:04:02.91,1:04:04.87,نص عام,,0,0,0,,- تشان ووك\N- نعم
Dialogue: 0,1:04:10.42,1:04:12.04,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,1:04:12.54,1:04:14.21,نص عام,,0,0,0,,عذراً. أنا في مهمة
Dialogue: 0,1:04:14.30,1:04:15.84,نص عام,,0,0,0,,حسنًا، أردت المشاهدة
Dialogue: 0,1:04:20.14,1:04:21.30,نص عام,,0,0,0,,الطلب؟
Dialogue: 0,1:04:21.93,1:04:25.52,نص عام,,0,0,0,,سمعت أنك تريد كعك العسل
Dialogue: 0,1:04:26.68,1:04:28.06,نص عام,,0,0,0,,ملفات تعريف الارتباط؟
Dialogue: 0,1:04:28.14,1:04:30.19,نص عام,,0,0,0,,لاحظت الخادمة كيم أنك منزعجة،
Dialogue: 0,1:04:30.27,1:04:32.02,نص عام,,0,0,0,,وطلبت مني أن أعطيك بعضًا منها
Dialogue: 0,1:04:34.65,1:04:37.07,نص عام,,0,0,0,,شكرًا لك. أخبرها أنني ممتن
Dialogue: 0,1:04:37.82,1:04:38.95,خط مائل,,0,0,0,,ماذا؟
Dialogue: 0,1:04:40.36,1:04:43.28,نص عام,,0,0,0,,ظننتك ستغضب لأنني دخلت دون إذن
Dialogue: 0,1:04:44.03,1:04:44.91,نص عام,,0,0,0,,ألست غاضبًا؟
Dialogue: 0,1:04:44.99,1:04:48.29,النص العام,,0,0,0,,لقد جئت لتعطيني ملفات تعريف الارتباط. يمكنك الذهاب
Dialogue: 0,1:04:49.58,1:04:51.58,نص عام,,0,0,0,,جيد. لنكون صادقين...
Dialogue: 0,1:04:53.13,1:04:54.13,نص عام,,0,0,0,,لست وحدي
Dialogue: 0,1:04:55.55,1:04:57.42,نص عام,,0,0,0,,مو دوك، اخرج. انه ليس غاضبا
Dialogue: 0,1:04:58.55,1:05:00.47,نص عام,,0,0,0,,هذه خادمتي
Dialogue: 0,1:05:02.01,1:05:03.80,نص عام,,0,0,0,,أنا مو دوك،
Dialogue: 0,1:05:03.89,1:05:05.43,نص عام,,0,0,0,,خادمته
Dialogue: 0,1:05:07.97,1:05:09.52,نص عام,,0,0,0,,أنت هنا أيضًا
Dialogue: 0,1:05:10.23,1:05:12.23,نص عام,,0,0,0,,ظننتك ستغضب
Dialogue: 0,1:05:12.31,1:05:15.44,نص عام,,0,0,0,,شكرًا على حسن ضيافتكم.
Dialogue: 0,1:05:15.52,1:05:16.82,نص عام,,0,0,0,,تناول البسكويت
Dialogue: 0,1:05:16.90,1:05:19.24,نص عام,,0,0,0,,إذا كنت تريد المزيد، فقط أخبرني
Dialogue: 0,1:05:21.99,1:05:23.24,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,1:05:23.32,1:05:24.45,نص عام,,0,0,0,,لنذهب
Dialogue: 0,1:05:39.63,1:05:42.84,ذكريات,,0,0,0,,هذا هو الخصي الملكي
Dialogue: 0,1:05:43.89,1:05:45.30,ذكريات بخط مائل,,0,0,0,,ما خطبه؟
Dialogue: 0,1:05:46.56,1:05:47.97,ذكريات,,0,0,0,,إنه بدوي
Dialogue: 0,1:05:48.85,1:05:51.44,ذكريات,,0,0,0,,انظر. لقد ذهب إلى البرية
Dialogue: 0,1:05:59.40,1:06:01.82,ذكريات بخط مائل,,0,0,0,,لا أستطيع أن أصدق أن البدوي كان في القصر
Dialogue: 0,1:06:01.90,1:06:02.95,ذكريات,,0,0,0,,ربما
Dialogue: 0,1:06:03.82,1:06:05.12,ذكريات,,0,0,0,,هذا هو عمله
Dialogue: 0,1:06:08.45,1:06:09.83,ذكريات بخط مائل,,0,0,0,,أعلم أنك هنا
Dialogue: 0,1:06:10.33,1:06:12.71,ذكريات,,0,0,0,,لا داعي لخلق المشاكل، اخرج
Dialogue: 0,1:06:12.79,1:06:14.54,ذكريات,,0,0,0,,سأعطيك ما تريد
Dialogue: 0,1:06:21.34,1:06:22.76,ذكريات بخط مائل,,0,0,0,,اخرج!
Dialogue: 0,1:06:31.35,1:06:32.60,ذكريات,,0,0,0,,سأرحل
Dialogue: 0,1:06:58.50,1:06:59.71,نص عام,,0,0,0,,تشغيل
Dialogue: 0,1:07:02.84,1:07:04.09,نص عام,,0,0,0,,وراءنا باب آخر
Dialogue: 0,1:07:17.10,1:07:18.73,نص عام,,0,0,0,,لماذا لا تسمح لنا بالذهاب؟
Dialogue: 0,1:07:19.73,1:07:23.82,general text,,0,0,0,,ليس من الصواب التخلي عن ساحر وصل إلى هنا بهذه السهولة
Dialogue: 0,1:07:23.90,1:07:26.07,نص عام,,0,0,0,,ستواجه مشاكل،
Dialogue: 0,1:07:27.07,1:07:28.53,نص عام,,0,0,0,,إذا اختفيت في جيونبوغوان
Dialogue: 0,1:07:28.62,1:07:30.08,نص عام,,0,0,0,,ولن أؤذيك
Dialogue: 0,1:07:31.24,1:07:33.45,نص عام,,0,0,0,,سيكون جسدك آمنًا
Dialogue: 0,1:07:42.96,1:07:43.96,نص عام,,0,0,0,,تشان أوك...
Dialogue: 0,1:08:46.61,1:08:48.90,مائل,,0,0,0,,أنت داخل الحاجز الذي خلقته
Dialogue: 0,1:08:53.49,1:08:54.62,خط مائل,,0,0,0,,لا تقلق
Dialogue: 0,1:08:55.49,1:08:57.62,النص العام,,0,0,0,,قف ساكناً ولن تتأذى
Dialogue: 0,1:08:59.25,1:09:01.17,نص عام,,0,0,0,,انتظر هنا
Dialogue: 0,1:09:14.72,1:09:16.22,نص عام,,0,0,0,,هل كان اسمك مو دوك؟
Dialogue: 0,1:09:17.89,1:09:19.85,نص عام,,0,0,0,,نفس الخادمة،
Dialogue: 0,1:09:19.93,1:09:24.15,general text,,0,0,0,,من معه دائمًا ومنه دائمًا في مشكلة
Dialogue: 0,1:09:27.40,1:09:29.40,نص عام,,0,0,0,,هناك شخص هنا
Dialogue: 0,1:09:29.94,1:09:32.07,نص عام,,0,0,0,,اخرج واستعيد طاقتك
Dialogue: 0,1:09:43.75,1:09:45.21,نص عام,,0,0,0,,وبعد ذلك
Dialogue: 0,1:09:45.79,1:09:49.71,general text,,0,0,0,,سأنقلك إلى جسد السيد الشاب كما أردت
Dialogue: 0,1:10:03.69,1:10:05.23,نص عام,,0,0,0,,هذه الساحرة... الشامان تشوي
Dialogue: 0,1:10:06.69,1:10:08.82,نص عام,,0,0,0,,قال لتقتلني؟
Dialogue: 0,1:10:09.86,1:10:11.82,نص عام,,0,0,0,,أحتاج لمساعدتك
Dialogue: 0,1:10:12.57,1:10:15.45,نص عام,,0,0,0,,إذا كنت لا تصدقني سأغادر
Dialogue: 0,1:10:17.37,1:10:19.58,نص عام,,0,0,0,,يمكنك تناول وجبة خفيفة معها
Dialogue: 0,1:11:11.25,1:11:12.84,نص عام,,0,0,0,,علينا أن نخرج من هنا
Dialogue: 0,1:12:07.77,1:12:10.69,نص عام,,0,0,0,,يا معلم ساعدني مرة أخرى
Dialogue: 0,1:12:11.44,1:12:13.82,نص عام,,0,0,0,,امنح تلميذك الثقة
Dialogue: 0,1:12:25.33,1:12:26.50,نص عام,,0,0,0,,شان ووك
Dialogue: 0,1:13:06.62,1:13:07.66,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,1:13:10.21,1:13:11.37,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,1:13:44.24,1:13:45.37,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,1:14:13.77,1:14:14.98,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,1:14:18.27,1:14:19.44,نص عام,,0,0,0,,أنا...
Dialogue: 0,1:14:21.74,1:14:23.70,نص عام,,0,0,0,,لقد استنزفت طاقته للتو
Dialogue: 0,1:14:30.91,1:14:32.12,نص عام,,0,0,0,,أنا...
Dialogue: 0,1:14:33.75,1:14:35.29,نص عام,,0,0,0,,هل أنت مجنون؟
Dialogue: 0,1:14:49.64,1:14:51.56,النص العام,,0,0,0,,- مو دوك..\N- لا تقترب
الحوار: 0,1:15:04.95,1:15:06.49,نص عام,,0,0,0,,لا. كل شيء على ما يرام
Dialogue: 0,1:15:07.24,1:15:08.62,نص عام,,0,0,0,,هل أنت بخير
Dialogue: 0,1:15:10.37,1:15:12.20,نص عام,,0,0,0,,- وستكون بخير\N- لا
Dialogue: 0,1:15:13.20,1:15:14.25,نص عام,,0,0,0,,لا تلمسني
Dialogue: 0,1:15:16.33,1:15:17.96,نص عام,,0,0,0,,إذا أصبحت جامحًا,
Dialogue: 0,1:15:20.17,1:15:22.01,نص عام,,0,0,0,,من الأفضل ألا تلمسني
Dialogue: 0,1:15:25.51,1:15:27.22,النص العام,,0,0,0,,وإلا سأستنزف طاقتك أيضاً
Dialogue: 0,1:15:28.09,1:15:29.22,النص العام,,0,0,0,,وستموت
Dialogue: 0,1:17:10.36,1:17:12.53,معاينة,,0,0,0,,كانت بعض الضوضاء تأتي من غرفة التسجيل
Dialogue: 0,1:17:12.62,1:17:13.99,معاينة,,0,0,0,,اخرج!
Dialogue: 0,1:17:14.08,1:17:17.04,preview,,0,0,0,,هل أنت غاضب لأننا حولنا صديقك إلى حجر؟
Dialogue: 0,1:17:17.12,1:17:19.87,معاينة,,0,0,0,,لن تغادر هذا المكان أبدًا
Dialogue: 0,1:17:19.96,1:17:23.00,preview,,0,0,0,,إذن، هذا فرد من عائلة تشو؟
Dialogue: 0,1:17:23.08,1:17:26.92,preview,,0,0,0,,وإذا كانت روحها ملتصقة بأوكا، فماذا بعد؟
Dialogue: 0,1:17:27.00,1:17:30.93,preview,,0,0,0,,لو لم أتركك في الجبال،
Dialogue: 0,1:17:31.01,1:17:32.93,معاينة,,0,0,0,,لن يحدث هذا لك
Dialogue: 0,1:17:33.01,1:17:34.43,preview,,0,0,0,,هل تضع حياتك على المحك؟
Dialogue: 0,1:17:34.51,1:17:36.51,معاينة,,0,0,0,,عرض نفسك في المقابل هذه المرة
Dialogue: 0,1:17:36.60,1:17:38.22,معاينة,,0,0,0,,سأفوز غدًا بالتأكيد
Dialogue: 0,1:17:38.31,1:17:40.39,معاينة,,0,0,0,,أحتاج إلى شخص متأكد من الفوز
Dialogue: 0,1:17:40.48,1:17:43.06,preview,,0,0,0,,إن كان يبحث عن حجر ليحميها...
Dialogue: 0,1:17:43.15,1:17:44.15,معاينة,,0,0,0,,لا يمكن أن يكونوا معًا
Dialogue: 0,1:17:44.23,1:17:46.69,معاينة,,0,0,0,,لقد ظهر كل شيء عنك
الحوار: 0,0:02:55.14,0:02:57.14,النكات,,0,0,0,,

