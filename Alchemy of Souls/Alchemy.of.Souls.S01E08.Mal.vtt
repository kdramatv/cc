Dialog: 0,0:00:59.50,0:01:00.67,di sebalik tabir,,0,0,0,,Adakah ini alkimia jiwa?
Dialog: 0,0:01:15.52,0:01:19.98,suara,,0,0,0,,Jiwa saya bergerak sekarang?
Dialog: 0,0:03:07.92,0:03:09.34,teks umum,,0,0,0,,Jiwa belum bergerak
Dialog: 0,0:03:10.89,0:03:12.26,teks umum,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:03:20.02,0:03:21.06,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:03:22.11,0:03:23.23,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:03:26.44,0:03:27.69,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:03:28.86,0:03:30.03,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:03:45.17,0:03:48.84,teks umum,,0,0,0,,Kil Ju, awak bertukar badan dengan pelajar saya
Dialog: 0,0:03:50.63,0:03:51.72,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:03:55.47,0:03:58.02,teks umum,,0,0,0,,Saya lemah untuk melindungi dia daripada awak
Dialog: 0,0:03:58.89,0:04:01.35,teks umum,,0,0,0,,Tetapi saya pasti akan menghabisi kamu
Dialog: 0,0:04:07.19,0:04:08.44,teks umum,,0,0,0,,Saya tidak tahu,
Dialog: 0,0:04:09.24,0:04:11.24,teks umum,,0,0,0,,kenapa awak risau sangat tentang Chan Wook
Dialog: 0,0:04:11.99,0:04:13.20,teks umum,,0,0,0,,Diam!
Dialog: 0,0:04:15.33,0:04:16.49,teks umum,,0,0,0,,Cikgu!
Dialog: 0,0:04:17.58,0:04:18.70,teks umum,,0,0,0,,Ini saya, Chan Wook
Dialog: 0,0:04:19.62,0:04:20.87,teks umum,,0,0,0,,Kami tidak berubah
Dialog: 0,0:04:23.21,0:04:25.21,teks umum,,0,0,0,,Lihat mata saya
Dialog: 0,0:04:26.34,0:04:27.80,teks umum,,0,0,0,,Ini saya
Dialog: 0,0:04:32.30,0:04:35.05,teks umum,,0,0,0,,Satu-satunya orang yang boleh melihat anda dari jarak sedemikian
Dialog: 0,0:04:38.77,0:04:40.10,teks umum,,0,0,0,,Adakah anda mengenali saya?
Dialog: 0,0:06:01.68,0:06:04.02,teks umum,,0,0,0,,Dia mempunyai tanda di bahunya
Dialog: 0,0:06:05.81,0:06:08.69,teks umum,,0,0,0,,Jiwanya nampaknya kembali semula ke tubuhnya
Dialog: 0,0:06:09.77,0:06:11.07,teks umum,,0,0,0,,Kalau begitu kenapa saya okay?
Dialog: 0,0:06:11.15,0:06:12.11,teks umum,,0,0,0,,Tidak juga
Dialog: 0,0:06:12.82,0:06:14.40,teks umum,,0,0,0,,Anda juga telah berubah. Tengok
Dialog: 0,0:06:15.70,0:06:17.91,teks umum,,0,0,0,,Anda tidak memakai gelang, tetapi tangan anda tidak bergetar
Dialog: 0,0:06:20.41,0:06:23.45,teks umum,,0,0,0,,Anda betul. Saya boleh menggerakkannya dengan bebas
Dialog: 0,0:06:23.54,0:06:25.91,teks umum,,0,0,0,,Reflektor membantu mendapatkan tenaga
Dialog: 0,0:06:26.00,0:06:29.71,teks umum,,0,0,0,,Racun membuka pintu anda, mencerminkan peningkatan tenaga
Dialog: 0,0:06:30.79,0:06:34.09,teks umum,,0,0,0,,Chan Wook, anda amat bertuah
Dialog: 0,0:06:40.76,0:06:43.60,teks umum,,0,0,0,,Saya pasti saya nampak awak di sana
Dialog: 0,0:06:44.52,0:06:45.64,teks umum,,0,0,0,,Apa?
Dialog: 0,0:07:05.91,0:07:07.29,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:07:08.25,0:07:09.79,teks umum,,0,0,0,,Kenapa awak okay?
Dialog: 0,0:07:09.87,0:07:12.84,teks umum,,0,0,0,,Anda gagal kerana tenaga anda yang lemah
Dialog: 0,0:07:12.92,0:07:15.05,teks umum,,0,0,0,,Anda juga seorang nomad
Dialog: 0,0:07:15.13,0:07:16.97,teks umum,,0,0,0,,Nak Su awak juga
Dialog: 0,0:07:17.88,0:07:19.93,teks umum,,0,0,0,,anda akan membatu dan mati
Dialog: 0,0:07:21.05,0:07:23.05,teks umum,,0,0,0,,Bagaimana saya
Dialog: 0,0:07:24.26,0:07:25.89,teks umum,,0,0,0,,Seperti bapa awak
Dialog: 0,0:07:30.81,0:07:31.90,teks umum,,0,0,0,,Ayah saya?
Dialog: 0,0:07:32.56,0:07:33.57,miring,,0,0,0,,Ya
Dialog: 0,0:07:34.07,0:07:36.90,teks umum,,0,0,0,,Stargazer Mage
Dialog: 0,0:07:37.53,0:07:38.70,teks umum,,0,0,0,,Cho Chun!
Dialog: 0,0:07:40.57,0:07:42.03,teks umum,,0,0,0,,Ayah saya...
Dialog: 0,0:07:44.87,0:07:46.29,teks umum,,0,0,0,,adakah seorang nomad?
Dialog: 0,0:07:49.21,0:07:53.67,teks umum,,0,0,0,,Keluarga anda tidak dibunuh oleh keluarga utama Deho
Dialog: 0,0:07:55.13,0:07:59.26,teks umum,,0,0,0,,Itu ayah awak. Dia berubah menjadi penelan jiwa dan membunuh semua orang
Dialog: 0,0:08:01.38,0:08:03.39,kenangan condong,,0,0,0,,Kekal di dalam dan jangan keluar
Dialog: 0,0:08:03.47,0:08:06.39,kenangan,,0,0,0,,Jika kamu melihat ayah kamu, lari
Dialog: 0,0:08:06.47,0:08:08.10,kenangan,,0,0,0,,Jangan biarkan dia menangkap anda
Dialog: 0,0:08:11.48,0:08:15.69,teks umum,,0,0,0,,Kamu dan bapa kamu telah digunakan
Dialog: 0,0:08:16.44,0:08:18.78,teks umum,,0,0,0,,Anda akan membatu dan mati
Dialog: 0,0:08:19.74,0:08:21.74,teks umum,,0,0,0,,Ayah saya seorang nomad
Dialog: 0,0:08:23.11,0:08:24.28,teks umum,,0,0,0,,adakah Dan Zhu?
Dialog: 0,0:08:25.37,0:08:27.37,teks umum,,0,0,0,,Jin Moo dari Jeonbugwan?
Dialog: 0,0:08:27.95,0:08:30.91,teks umum,,0,0,0,,Jin Mu bukan Dan Zhu yang sebenar
Dialog: 0,0:08:31.66,0:08:34.54,teks umum,,0,0,0,,Benar Dan Zhu adalah orang lain
Dialog: 0,0:08:35.46,0:08:37.67,teks umum,,0,0,0,,- Dan siapa ini?\N- Nyata
Dialog: 0,0:08:38.88,0:08:41.34,teks umum,,0,0,0,,boleh menghentikan petrifikasi
Dialog: 0,0:08:42.34,0:08:45.51,teks umum,,0,0,0,,Sebab dia ada batu ais
Dialog: 0,0:08:45.60,0:08:47.85,teks umum,,0,0,0,,Siapakah Dan Zhu yang sebenar?
Dialog: 0,0:09:12.62,0:09:14.71,teks umum,,0,0,0,,Moo Dok, awak okay?
Dialog: 0,0:09:15.92,0:09:17.17,teks umum,,0,0,0,,OK
Dialog: 0,0:09:18.04,0:09:19.96,teks umum,,0,0,0,,Lari kejar dia. Lebih cepat!
Dialog: 0,0:09:56.71,0:09:59.04,di sebalik tabir,,0,0,0,,Kita perlu keluar dari sini,
Dialog: 0,0:09:59.71,0:10:01.71,di sebalik tabir,,0,0,0,,sehingga racun sihir merebak
Dialog: 0,0:10:26.15,0:10:27.32,miring,,0,0,0,,Lihat semua
Dialog: 0,0:10:27.41,0:10:28.66,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:10:52.26,0:10:53.22,teks umum,,0,0,0,,Tiada sesiapa
Dialog: 0,0:10:58.81,0:11:00.69,teks umum,,0,0,0,,Saya merasakan tenaga sihir
Dialog: 0,0:11:00.77,0:11:03.86,teks umum,,0,0,0,,Cikgu Ho betul. Sapsari ini ialah Gwigu
Dialog: 0,0:11:04.48,0:11:06.78,teks umum,,0,0,0,,Adakah benar-benar alkimia jiwa di sini?
Dialog: 0,0:11:15.87,0:11:16.79,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:11:17.37,0:11:18.75,teks umum,,0,0,0,,Terbaring di atas tanah
Dialog: 0,0:11:19.87,0:11:21.13,teks umum,,0,0,0,,Mungkin ia adalah pemantul
Dialog: 0,0:11:26.96,0:11:28.13,teks umum,,0,0,0,,Gelang ini...
Dialog: 0,0:11:29.01,0:11:31.01,teks umum,,0,0,0,,Ini gelang Encik Chan Wook?
Dialog: 0,0:11:31.09,0:11:32.76,teks umum,,0,0,0,,Kenapa dia ada di sini?
Dialog: 0,0:11:33.39,0:11:34.97,teks umum,,0,0,0,,Jadi Uk ada di sini?
Dialog: 0,0:11:39.77,0:11:40.98,teks umum,,0,0,0,,Mereka bergaduh
Dialog: 0,0:11:41.06,0:11:43.23,teks umum,,0,0,0,,Adakah anda rasa sesuatu telah berlaku kepadanya?
Dialog: 0,0:11:46.57,0:11:49.11,teks umum,,0,0,0,,Kembali ke Sosnovy Bor dan laporkan perkara yang anda lihat
Dialog: 0,0:11:49.78,0:11:52.03,teks umum,,0,0,0,,Dan Gu, datang dan cari Uka
Dialog: 0,0:11:52.12,0:11:54.03,teks umum,,0,0,0,,- Saya akan lihat di kawasan itu\N- Okay
Dialog: 0,0:12:29.90,0:12:32.41,teks umum,,0,0,0,,Bagaimana ahli silap mata Sosnovy Bor mengetahuinya?
Dialog: 0,0:12:49.55,0:12:51.30,kenangan miring,,0,0,0,,Anda juga seorang perantau
Dialog: 0,0:12:51.88,0:12:53.59,kenangan,,0,0,0,,Nak Su, awak juga
Dialog: 0,0:12:54.51,0:12:56.72,kenangan,,0,0,0,,anda akan membatu dan mati
Dialog: 0,0:12:56.80,0:12:58.81,kenangan,,0,0,0,,Macam saya
Dialog: 0,0:12:59.47,0:13:01.06,kenangan,,0,0,0,,Seperti bapa awak
Dialog: 0,0:13:04.77,0:13:05.98,teks umum,,0,0,0,,Bapa...
Dialog: 0,0:13:30.34,0:13:31.96,kenangan miring,,0,0,0,,Dan anda dan bapa anda
Dialog: 0,0:13:33.67,0:13:36.22,kenangan condong,,0,0,0,,digunakan. Anda akan bertukar menjadi batu
Dialog: 0,0:13:37.68,0:13:39.81,kenangan miring,,0,0,0,,dan anda mati
Dialog: 0,0:15:26.41,0:15:27.58,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:15:28.58,0:15:29.96,teks umum,,0,0,0,,Kenapa awak lagi?
Dialog: 0,0:15:36.38,0:15:39.22,teks umum,,0,0,0,,Adakah ini seorang nomad?
Dialog: 0,0:15:39.30,0:15:41.30,teks umum,,0,0,0,,Tidak, pembantu rumah Uka
Dialog: 0,0:15:42.35,0:15:44.64,teks umum,,0,0,0,,Saya secara tidak sengaja mencederakannya, dia harus dibawa ke pakar perubatan
Dialog: 0,0:15:51.56,0:15:54.07,teks umum,,0,0,0,,Alangkah indahnya hari ini
Dialog: 0,0:15:54.15,0:15:56.82,teks umum,,0,0,0,,Perdagangan berjalan lancar
Dialog: 0,0:16:02.87,0:16:05.08,di sebalik tabir,,0,0,0,,saya perlu menambah tenaga saya, jika tidak, saya akan membatu sepenuhnya
Dialog: 0,0:16:07.75,0:16:09.79,contact,,0,0,0,,- Selesai?\N- Itu sudah
Dialog: 0,0:16:10.37,0:16:12.21,teks umum,,0,0,0,,Bolehkah kita minum?
Dialog: 0,0:16:12.88,0:16:13.92,contact,,0,0,0,,- Okay\N- Lebih cepat
Dialog: 0,0:16:14.00,0:16:15.17,miring,,0,0,0,,Jom
Dialog: 0,0:16:16.84,0:16:19.13,di sebalik tabir,,0,0,0,,Saya tidak akan dapat kembali jika saya membuat kekecohan
Dialog: 0,0:16:19.22,0:16:22.13,di sebalik tabir,,0,0,0,,Saya perlu mencari tempat yang tenang di mana saya boleh merasa cukup
Dialog: 0,0:17:12.85,0:17:14.65,contact,,0,0,0,,Alih pergi
Dialog: 0,0:17:16.73,0:17:17.98,teks umum,,0,0,0,,Ah, oh, masuklah
Dialog: 0,0:17:18.90,0:17:19.86,teks umum,,0,0,0,,En.
Dialog: 0,0:17:19.94,0:17:22.19,teks umum,,0,0,0,,Anda tidak akan menipu kami dengan helah ini
Dialog: 0,0:17:23.45,0:17:25.99,teks umum,,0,0,0,,Anda telah mengikutinya sejak anda memasuki ibu kota
Dialog: 0,0:17:33.50,0:17:35.83,kenangan,,0,0,0,,Lelaki ini menghantui kita
Dialog: 0,0:17:39.59,0:17:42.97,teks umum,,0,0,0,,Anda mengikutinya sehingga ke rumah penginapan
Dialog: 0,0:17:45.13,0:17:47.43,teks umum,,0,0,0,,Kami hanya dalam satu arah
Dialog: 0,0:17:47.51,0:17:48.64,teks umum,,0,0,0,,Jangan berbohong
Dialog: 0,0:17:48.72,0:17:51.52,teks umum,,0,0,0,,Anda merenungnya sepanjang masa!
Dialog: 0,0:17:51.60,0:17:52.73,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,0:17:52.81,0:17:53.81,miring,,0,0,0,,Song Yi
Dialog: 0,0:17:54.52,0:17:56.19,teks umum,,0,0,0,,Jangan malukan dia
Dialog: 0,0:18:00.15,0:18:03.57,teks umum,,0,0,0,,Saya tidak selesa dengan anda mengikuti saya, dan ia juga tidak sopan di pihak anda
Dialog: 0,0:18:04.15,0:18:07.11,teks umum,,0,0,0,,Jika anda tidak mahu saya mencari penginapan lain,
Dialog: 0,0:18:07.20,0:18:08.32,teks umum,,0,0,0,,pergi
Dialog: 0,0:18:09.87,0:18:11.16,teks umum,,0,0,0,,Gadis
Dialog: 0,0:18:11.99,0:18:14.33,teks umum,,0,0,0,,Mengapa anda memutuskan bahawa saya mengikuti anda?
Dialog: 0,0:18:14.91,0:18:16.79,teks umum,,0,0,0,,Anda tidak berhutang apa-apa kepada saya,
Dialog: 0,0:18:16.87,0:18:20.13,teks umum,,0,0,0,,Saya tidak kenal awak pun, kenapa saya perlu kejar awak?
Dialog: 0,0:18:20.21,0:18:23.17,teks umum,,0,0,0,,- Kerana dia sangat...\N- Diamlah, Sun Yi
Dialog: 0,0:18:24.72,0:18:26.34,teks umum,,0,0,0,,Biar dia jawab
Dialog: 0,0:18:28.51,0:18:32.72,teks umum,,0,0,0,,Saya mempunyai banyak masalah kerana lelaki yang mengikuti saya kerana kecantikan saya
Dialog: 0,0:18:32.81,0:18:33.97,teks umum,,0,0,0,,Jadi saya memutuskan,
Dialog: 0,0:18:35.18,0:18:36.81,teks umum,,0,0,0,,bahawa anda adalah salah seorang daripada mereka
Dialog: 0,0:18:37.39,0:18:38.23,teks umum,,0,0,0,,Faham
Dialog: 0,0:18:39.15,0:18:39.98,teks umum,,0,0,0,,Tetapi ini tidak begitu
Dialog: 0,0:18:42.36,0:18:43.73,teks umum,,0,0,0,,Beauty tidak menarik perhatian
Dialog: 0,0:18:44.44,0:18:46.20,teks umum,,0,0,0,,Dan saya tidak mengikuti awak
Dialog: 0,0:18:47.86,0:18:49.20,teks umum,,0,0,0,,Kalau begitu,
Dialog: 0,0:18:51.20,0:18:52.54,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:18:52.62,0:18:54.54,teks umum,,0,0,0,,Bolehkah saya naik?
Dialog: 0,0:19:07.05,0:19:09.47,teks umum,,0,0,0,,- Puan Ho\N- Ya?
Dialog: 0,0:19:09.55,0:19:11.18,teks umum,,0,0,0,,Anda mesti makan
Dialog: 0,0:19:13.22,0:19:14.39,teks umum,,0,0,0,,Bajingan ini...
Dialog: 0,0:19:15.35,0:19:16.43,teks umum,,0,0,0,,Itulah...
Dialog: 0,0:19:17.02,0:19:19.90,teks umum,,0,0,0,,Adakah anda malu kerana anda mungkin bertembung dengannya lagi?
Dialog: 0,0:19:21.15,0:19:22.44,teks umum,,0,0,0,,Tidak
Dialog: 0,0:19:23.40,0:19:24.90,teks umum,,0,0,0,,Saya rasa tidak sedap hati
Dialog: 0,0:19:25.48,0:19:27.24,teks umum,,0,0,0,,Tukar kepada pakaian kering
Dialog: 0,0:19:27.32,0:19:29.74,teks umum,,0,0,0,,Saya akan bawakan bubur untuk anda
Dialog: 0,0:21:10.38,0:21:11.59,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:21:14.97,0:21:17.72,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:21:19.01,0:21:20.56,teks umum,,0,0,0,,Adakah anda mengikutinya?
Dialog: 0,0:21:21.43,0:21:22.60,teks umum,,0,0,0,,Ya
Dialog: 0,0:21:24.48,0:21:26.11,teks umum,,0,0,0,,Saya gembira anda tidak cedera
Dialog: 0,0:21:26.94,0:21:28.07,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:21:29.73,0:21:30.73,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:21:31.24,0:21:32.78,teks umum,,0,0,0,,Jika anda berasa tidak sihat,
Dialog: 0,0:21:33.57,0:21:35.32,teks umum,,0,0,0,,pergi ke Sejukwon di Sosnovy Bor
Dialog: 0,0:21:35.41,0:21:36.95,teks umum,,0,0,0,,Adakah anda tahu tentang Saejukwon?
Dialog: 0,0:21:37.03,0:21:38.74,teks umum,,0,0,0,,Saya dari Sejukwon...
Dialog: 0,0:21:42.87,0:21:44.58,teks umum,,0,0,0,,Saya Ho Young Ok
Dialog: 0,0:22:03.89,0:22:06.98,kenangan miring,,0,0,0,,Daripada rakan yang berdekatan, anda mempunyai wisel
Dialog: 0,0:22:08.23,0:22:10.11,kenangan miring,,0,0,0,,Jadi rakan anda meninggalkan anda
Dialog: 0,0:22:13.65,0:22:14.90,teks umum,,0,0,0,,Anda tahu
Dialog: 0,0:22:16.95,0:22:18.45,teks umum,,0,0,0,,siapa saya selama ini
Dialog: 0,0:23:19.72,0:23:20.97,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:23:21.05,0:23:22.76,teks umum,,0,0,0,,Hei, apa khabar di sana?
Dialog: 0,0:23:22.85,0:23:25.68,teks umum,,0,0,0,,Cuba bangun. Perlahan-lahan
Dialog: 0,0:23:29.27,0:23:30.81,teks umum,,0,0,0,,Raksasa!
Dialog: 0,0:23:32.90,0:23:33.94,teks umum,,0,0,0,, Penelan Jiwa!
Dialog: 0,0:23:34.02,0:23:35.11,teks umum,,0,0,0,,Ia adalah penelan jiwa!
Dialog: 0,0:23:35.19,0:23:37.44,teks umum,,0,0,0,,- Telan Jiwa\N- Penelan Jiwa!
Dialog: 0,0:24:10.64,0:24:13.44,kenangan,,0,0,0,,Benar Dan Zhu adalah orang lain
Dialog: 0,0:24:14.44,0:24:18.11,kenangan,,0,0,0,,Yang sebenar boleh menghentikan membatu
Dialog: 0,0:24:18.19,0:24:20.95,suara,,0,0,0,,Ya, pergi ke Dan Zhu anda
Dialog: 0,0:24:23.24,0:24:24.83,teks umum,,0,0,0,,Adakah Kil Zhu hilang?
Dialog: 0,0:24:24.91,0:24:28.66,teks umum,,0,0,0,,Kami tidak tahu di mana dia berada sejak dia pergi mengejar pembantu rumah Chan Wook
Dialog: 0,0:24:30.21,0:24:31.79,teks am,,0,0,0,,Pembantu rumah Chang Wook?
Dialog: 0,0:24:32.42,0:24:34.17,teks umum,,0,0,0,,Mengapa dia memerlukannya?
Dialog: 0,0:24:34.25,0:24:37.92,teks umum,,0,0,0,,Sejujurnya, dia mengikuti Chan Wook
Dialog: 0,0:24:38.96,0:24:42.68,teks umum,,0,0,0,,Azimat semangat yang tinggal selepas Nak Soo adalah milik Chan Wook
Dialog: 0,0:24:43.43,0:24:46.56,teks umum,,0,0,0,,Dia mungkin menyangka Chan Wook entah bagaimana berhubung dengannya
Dialog: 0,0:24:46.64,0:24:48.89,teks umum,,0,0,0,,Anda sepatutnya memberitahu saya lebih awal!
Dialog: 0,0:24:49.52,0:24:50.77,teks umum,,0,0,0,,Dia berkata supaya diam
Dialog: 0,0:24:50.85,0:24:53.15,teks umum,,0,0,0,,Mungkin mahu mencari bukti kukuh
Dialog: 0,0:24:53.77,0:24:55.90,teks umum,,0,0,0,, Beritahu semua ahli silap mata untuk mencari Kil Ju
Dialog: 0,0:25:02.15,0:25:03.82,teks umum,,0,0,0,,Gelang tangan Chan Wook
Dialog: 0,0:25:03.91,0:25:06.37,teks umum,,0,0,0,, didapati di mana mereka melakukan alkimia jiwa?
Dialog: 0,0:25:06.45,0:25:07.95,teks umum,,0,0,0,,Dan Gu sedang mencari En.
Dialog: 0,0:25:08.04,0:25:10.08,teks umum,,0,0,0,,Master So meneliti persekitaran kuil
Dialog: 0,0:25:10.16,0:25:12.79,teks umum,,0,0,0,,- Mereka berada di dalam kuil?\N- Ya
Dialog: 0,0:25:12.87,0:25:16.92,teks umum,,0,0,0,,Saya ragu bahawa Uk mampu alkimia
Dialog: 0,0:25:17.00,0:25:18.34,teks umum,,0,0,0,,Tuan Li,
Dialog: 0,0:25:18.42,0:25:20.92,teks umum,,0,0,0,,bagaimana jika roh seseorang berhijrah ke jasad Uka?
Dialog: 0,0:25:21.01,0:25:23.76,teks umum,,0,0,0,,Jangan risau. Saya pasti dia baik-baik saja
Dialog: 0,0:25:28.39,0:25:30.56,teks umum,,0,0,0,,Dia akan melindunginya
Dialog: 0,0:25:30.64,0:25:31.81,italic,,0,0,0,,Di mana
Dialog: 0,0:25:31.89,0:25:35.60,teks umum,,0,0,0,,kepala kita, bilakah berlaku huru-hara di sini?
Dialog: 0,0:25:36.52,0:25:38.23,teks umum,,0,0,0,,Sebelum Uk dilahirkan...
Dialog: 0,0:25:39.98,0:25:42.03,teks umum,,0,0,0,,20 tahun lalu...
Dialog: 0,0:25:42.61,0:25:43.61,teks umum,,0,0,0,,Chan Gan
Dialog: 0,0:25:44.49,0:25:46.32,teks umum,,0,0,0,,menjalankan alkimia jiwa?
Dialog: 0,0:25:51.58,0:25:53.83,teks umum,,0,0,0,,Gwangju Jeonbugwan dan ilmu sihir?
Dialog: 0,0:25:54.67,0:25:56.00,teks umum,,0,0,0,,Ini hanya lucu!
Dialog: 0,0:25:56.08,0:25:57.29,teks umum,,0,0,0,,Jin Mu memberitahu saya tentang perkara ini
Dialog: 0,0:25:58.92,0:26:00.96,teks umum,,0,0,0,,Saya tidak berani bertanya kepadanya,
Dialog: 0,0:26:02.38,0:26:03.97,teks umum,,0,0,0,, itulah sebabnya saya datang kepada anda
Dialog: 0,0:26:08.43,0:26:09.81,teks umum,,0,0,0,,Cik Do Hwa
Dialog: 0,0:26:11.06,0:26:12.77,teks umum,,0,0,0,,bimbang Gwangju
Dialog: 0,0:26:13.77,0:26:16.69,teks umum,,0,0,0,,berminat dengan beberapa mantra pelik
Dialog: 0,0:26:17.52,0:26:20.82,teks umum,,0,0,0,,Tetapi ia tidak bertahan lama
Dialog: 0,0:26:21.40,0:26:23.65,teks umum,,0,0,0,,Gwangju sudah setahun tidak pulang
Dialog: 0,0:26:24.28,0:26:27.82,teks umum,,0,0,0,,Mantra terlatih dengan Jin Moo di bilik rahsia Jeonbugwan
Dialog: 0,0:26:27.91,0:26:28.87,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:26:28.95,0:26:32.74,teks umum,,0,0,0,,dia berhenti apabila isterinya hamil
Dialog: 0,0:26:36.67,0:26:40.54,kenangan miring,,0,0,0,,Beliau adalah anak kepada raja yang telah meninggal dunia
Dialog: 0,0:26:41.21,0:26:42.30,kenangan,,0,0,0,,Raja
Dialog: 0,0:26:43.09,0:26:45.80,kenangan,,0,0,0,,mati kerana sakit, tidak boleh bergerak
Dialog: 0,0:26:45.88,0:26:47.26,kenangan,,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,0:26:49.22,0:26:52.68,kenangan,,0,0,0,,Ini mungkin disebabkan oleh alkimia jiwa
Dialog: 0,0:26:54.64,0:26:56.02,teks umum,,0,0,0,,Menjadi ahli silap mata,
Dialog: 0,0:26:57.35,0:26:59.52,teks umum,,0,0,0,,dia sedang membara dengan minat yang mudah dalam perkara sebegitu
Dialog: 0,0:26:59.60,0:27:00.52,teks umum,,0,0,0,,Tidak
Dialog: 0,0:27:01.86,0:27:03.15,teks umum,,0,0,0,,Dia melakukan
Dialog: 0,0:27:04.65,0:27:05.90,teks umum,,0,0,0,,sesuatu yang tidak boleh diperbaiki
Dialog: 0,0:27:06.70,0:27:10.70,teks umum,,0,0,0,,dengan kehidupan Do Hwa dan Wook
Dialog: 0,0:27:21.00,0:27:24.38,teks umum,,0,0,0,,Ahli silap mata dari Chongjingak sedang mencari tuan kami dengan segera
Dialog: 0,0:27:34.18,0:27:35.89,teks umum,,0,0,0,,saya tidak tahu awak ada di sini, pakcik
Dialog: 0,0:27:35.97,0:27:37.27,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:27:38.44,0:27:39.64,teks umum,,0,0,0,,Saya rasa,
Dialog: 0,0:27:40.48,0:27:42.27,teks umum,,0,0,0,,Uk menjadi mangsa alkimia jiwa
Dialog: 0,0:27:43.36,0:27:44.44,teks umum,,0,0,0,,Apa?
Dialog: 0,0:28:08.84,0:28:10.22,miring,,0,0,0,,Ini Jeonbugwan
Dialog: 0,0:28:10.76,0:28:13.72,di sebalik tabir,,0,0,0,,Dan Zhu yang sebenar ada di sebalik dinding ini?
Dialog: 0,0:28:36.91,0:28:39.50,teks umum,,0,0,0,,Ini adalah jalan ke istana
Dialog: 0,0:28:40.33,0:28:43.17,teks umum,,0,0,0,,Adakah Dan Zhu yang sebenar di sana?
Dialog: 0,0:28:52.97,0:28:54.14,teks umum,,0,0,0,,Saya dari Jeonbugwan
Dialog: 0,0:28:54.85,0:28:56.60,teks umum,,0,0,0,,Ini mungkin mendesak
Dialog: 0,0:29:04.77,0:29:06.02,teks umum,,0,0,0,,Tunjukkan muka anda
Dialog: 0,0:29:06.11,0:29:08.02,teks umum,,0,0,0,,Ini penting. Keluar dari jalan
Dialog: 0,0:29:08.11,0:29:09.40,teks umum,,0,0,0,,Tunjukkan muka anda dahulu
Dialog: 0,0:29:31.92,0:29:32.97,teks umum,,0,0,0,, Penelan Jiwa
Dialog: 0,0:29:35.93,0:29:37.05,teks umum,,0,0,0,,Di belakangnya
Dialog: 0,0:31:26.70,0:31:28.79,teks umum,,0,0,0,, Nyata di istana
Dialog: 0,0:31:31.42,0:31:32.75,teks umum,,0,0,0,,Ais batu, bukan?
Dialog: 0,0:31:33.92,0:31:35.46,teks umum,,0,0,0,,Anda menyebut dia
Dialog: 0,0:31:37.13,0:31:40.26,teks umum,,0,0,0,,Saya akan cari dia dan selamatkan dia daripada nasib yang serupa dengan awak
Dialog: 0,0:32:11.50,0:32:12.92,teks umum,,0,0,0,,Tunggu, dia...
Dialog: 0,0:32:13.88,0:32:15.25,teks umum,,0,0,0,,Lihat
Dialog: 0,0:32:15.34,0:32:16.88,teks umum,,0,0,0,,Adakah dia benar-benar mati?
Dialog: 0,0:32:16.96,0:32:18.76,teks umum,,0,0,0,,- Sentuh\N- Adakah ia berbaloi?
Dialog: 0,0:32:36.86,0:32:38.86,teks umum,,0,0,0,,Dia cuba masuk ke dalam istana sehingga dia menjadi batu
Dialog: 0,0:32:40.74,0:32:41.95,teks umum,,0,0,0,,Adakah anda membunuhnya?
Dialog: 0,0:32:42.99,0:32:44.45,teks umum,,0,0,0,,Beraninya kita?
Dialog: 0,0:32:44.53,0:32:47.37,teks umum,,0,0,0,,Tiba-tiba beberapa ahli silap mata yang tidak dikenali muncul dan membunuhnya
Dialog: 0,0:32:48.12,0:32:50.37,teks umum,,0,0,0,,Dia berasal dari keluarga apa? Dah nampak muka?
Dialog: 0,0:32:50.45,0:32:52.00,teks umum,,0,0,0,,Tidak, ia disembunyikan
Dialog: 0,0:32:52.08,0:32:54.75,teks umum,,0,0,0,,Tetapi saya nampak dia menggunakan
Dialog: 0,0:33:01.21,0:33:02.38,contact,,0,0,0,,Itu Tansu
Dialog: 0,0:33:05.84,0:33:08.72,teks umum,,0,0,0,,- Tansu?\N- Ya, saya pasti
Dialog: 0,0:33:09.85,0:33:11.39,teks umum,,0,0,0,,Dia memukul dengan tenaga daripada pedang
Dialog: 0,0:33:14.10,0:33:17.19,luar skrin,,0,0,0,,Tangsu dimiliki oleh Nak Soo
Dialog: 0,0:33:17.27,0:33:20.27,luar skrin,,0,0,0,,Adakah orang lain yang menguasainya?
Dialog: 0,0:33:29.33,0:33:31.79,teks umum,,0,0,0,,Saya dengar awak menangkap penelan jiwa
Dialog: 0,0:33:32.45,0:33:35.75,teks umum,,0,0,0,,Kami datang untuk melihat siapa dia
Dialog: 0,0:33:37.04,0:33:39.96,teks umum,,0,0,0,,Sudah tentu. awak boleh tengok
Dialog: 0,0:34:03.86,0:34:04.99,teks umum,,0,0,0,,Ini Kil Ju,
Dialog: 0,0:34:05.86,0:34:08.66,teks umum,,0,0,0,,salah seorang daripada orang anda
Dialog: 0,0:34:10.58,0:34:12.74,teks umum,,0,0,0,,Betul
Dialog: 0,0:34:15.20,0:34:17.83,teks umum,,0,0,0,,Bawa masuk badan dan bawa semua orang keluar
Dialog: 0,0:34:17.92,0:34:18.79,teks umum,,0,0,0,,Ya
Dialog: 0,0:34:24.42,0:34:27.59,di sebalik tabir,,0,0,0,,Jin Mu ada bersama saya ketika mereka melakukan alkimia
Dialog: 0,0:34:28.43,0:34:30.01,luar skrin,,0,0,0,,Dia juga keliru
Dialog: 0,0:34:31.01,0:34:34.47,luar skrin,,0,0,0,,Dia tidak tahu bahawa mereka telah melakukan alkimia
Dialog: 0,0:34:36.18,0:34:39.56,teks umum,,0,0,0,,Saya akan uruskan kerana semuanya berlaku di Jeonbugwan
Dialog: 0,0:34:39.65,0:34:41.36,teks umum,,0,0,0,,Tiada kaitan dengan Sosnovy Bor
Dialog: 0,0:34:42.07,0:34:43.15,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:34:43.90,0:34:46.86,teks umum,,0,0,0,,Jika perlu, kami akan memberikan bantuan
Dialog: 0,0:34:47.45,0:34:49.78,teks umum,,0,0,0,,Jika perlu
Dialog: 0,0:34:52.37,0:34:54.83,huruf miring,,0,0,0,,Seorang lagi nomad bertukar menjadi penelan jiwa?
Dialog: 0,0:34:55.41,0:34:58.54,teks umum,,0,0,0,,Syukurlah, dia ditangkap dan dibunuh
Dialog: 0,0:34:58.62,0:35:00.63,teks umum,,0,0,0,,Dan siapakah itu?
Dialog: 0,0:35:00.71,0:35:01.92,teks umum,,0,0,0,,Kil Ju,
Dialog: 0,0:35:02.00,0:35:05.21,teks umum,,0,0,0,,ahli silap mata Jeonbugwan
Dialog: 0,0:35:07.05,0:35:09.18,contact,,0,0,0,,Kil Zhu jadi nomad?
Dialog: 0,0:35:10.18,0:35:13.26,teks umum,,0,0,0,,Jonbugwan menangkapnya?
Dialog: 0,0:35:13.35,0:35:15.35,teks umum,,0,0,0,,Dia ditangkap di hadapan istana
Dialog: 0,0:35:15.43,0:35:18.48,teks umum,,0,0,0,,Dia cuba masuk ke istana ketika dia berlari liar
Dialog: 0,0:35:19.44,0:35:21.15,teks umum,,0,0,0,,Adakah dia datang ke sini?
Dialog: 0,0:35:21.23,0:35:23.40,teks umum,,0,0,0,,Tiba-tiba seorang ahli silap mata muncul,
Dialog: 0,0:35:23.48,0:35:25.61,teks umum,,0,0,0,,yang Tansu gunakan
Dialog: 0,0:35:28.95,0:35:30.99,teks umum,,0,0,0,,Dan siapakah itu?
Dialog: 0,0:35:32.53,0:35:34.66,teks umum,,0,0,0,,Kil Ju membunuh Nak Soo
Dialog: 0,0:35:34.74,0:35:35.99,teks umum,,0,0,0,,- Apa?\N- Nak Su?
Dialog: 0,0:35:36.08,0:35:37.50,teks umum,,0,0,0,,Dia kembali!
Dialog: 0,0:35:37.58,0:35:39.46,teks am,,0,0,0,,- Nak Su?\N- Mercenary?
Dialog: 0,0:35:40.00,0:35:44.04,teks umum,,0,0,0,,Seorang ahli silap mata memegang Tansu yang muncul di hadapan istana
Dialog: 0,0:35:44.13,0:35:45.92,teks umum,,0,0,0,,Nak Su memilikinya
Dialog: 0,0:35:46.00,0:35:47.71,italic,,0,0,0,,- Betul ke?\N- Hebat
Dialog: 0,0:35:47.80,0:35:49.17,teks umum,,0,0,0,,- Adakah dia?\N- Dia?
Dialog: 0,0:35:49.26,0:35:50.55,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:35:50.63,0:35:51.97,teks umum,,0,0,0,,Nak Su meninggal dunia
Dialog: 0,0:35:52.05,0:35:52.93,miring,,0,0,0,,Tepat sekali!
Dialog: 0,0:35:53.01,0:35:55.93,teks umum,,0,0,0,,Semua orang di sini melihat bagaimana tubuhnya dibakar
Dialog: 0,0:35:56.01,0:35:58.35,teks umum,,0,0,0,,Saya melihatnya sendiri
Dialog: 0,0:35:58.43,0:35:59.60,teks umum,,0,0,0,,- Ya\N- Tepat
Dialog: 0,0:35:59.68,0:36:02.10,teks umum,,0,0,0,,Tubuh dibakar, tetapi jiwa masih hidup
Dialog: 0,0:36:02.19,0:36:05.57,teks umum,,0,0,0,,Pahlawan bayangan telah menjadi nomad!
Dialog: 0,0:36:05.65,0:36:07.32,teks umum,,0,0,0,,- Apa?\N- Betul ke?
Dialog: 0,0:36:07.40,0:36:09.32,teks umum,,0,0,0,,- Tak boleh jadi\N- Serius?
Dialog: 0,0:36:09.40,0:36:11.28,teks umum,,0,0,0,,Tetapi Nak Soo seorang perempuan
Dialog: 0,0:36:11.36,0:36:13.41,teks umum,,0,0,0,,Dan Kil Ju dibunuh oleh seorang lelaki muda
Dialog: 0,0:36:13.49,0:36:16.66,teks umum,,0,0,0,,Lelaki muda tinggi berjubah biru
Dialog: 0,0:36:17.33,0:36:19.33,teks umum,,0,0,0,,Nak Su perantau kan?
Dialog: 0,0:36:19.41,0:36:22.08,teks umum,,0,0,0,,Dia boleh berhijrah ke dalam tubuh lelaki muda ini
Dialog: 0,0:36:23.88,0:36:25.79,teks umum,,0,0,0,,Dan kemudian saya menjadi lebih kuat
Dialog: 0,0:36:27.30,0:36:28.96,teks umum,,0,0,0,,Dia kuat
Dialog: 0,0:36:29.05,0:36:32.51,teks umum,,0,0,0,,Tetapi dalam tubuh lelaki ia menjadi lebih kuat
Dialog: 0,0:36:34.72,0:36:36.14,teks umum,,0,0,0,,Pembunuhan Kil Ju adalah balas dendamnya
Dialog: 0,0:36:36.22,0:36:38.68,teks umum,,0,0,0,,Jeonbugwan untuk mayat yang terbakar
Dialog: 0,0:36:39.35,0:36:40.85,teks umum,,0,0,0,,dan pembunuhan rakyatnya
Dialog: 0,0:36:40.93,0:36:42.35,teks umum,,0,0,0,,Kenapa kita perlu membalas dendam?
Dialog: 0,0:36:42.44,0:36:44.31,teks umum,,0,0,0,,Hutan Pine membunuh Nak Su
Dialog: 0,0:36:45.31,0:36:50.07,teks umum,,0,0,0,,"Berpakaian biru, Nak Soo yang luar biasa telah kembali"
Dialog: 0,0:36:50.15,0:36:52.74,teks umum,,0,0,0,,"Hutan Pine ialah matlamat seterusnya"
Dialog: 0,0:36:52.82,0:36:55.99,teks umum,,0,0,0,,Ini adalah khabar angin
Dialog: 0,0:36:56.07,0:36:58.95,teks umum,,0,0,0,, Penelan jiwa ditangkap hanya beberapa jam yang lalu
Dialog: 0,0:36:59.04,0:37:00.83,teks umum,,0,0,0,,dan khabar angin yang tidak masuk akal?
Dialog: 0,0:37:01.41,0:37:05.21,teks umum,,0,0,0,,Khabar angin sebegitu sepantas kebakaran
Dialog: 0,0:37:05.29,0:37:06.96,teks umum,,0,0,0,,Dan khabar angin itu tidak berasas
Dialog: 0,0:37:07.04,0:37:10.00,teks umum,,0,0,0,,Ahli silap mata menggunakan Tansa,
Dialog: 0,0:37:10.09,0:37:12.47,teks umum,,0,0,0,,seperti Nak Su
Dialog: 0,0:37:12.55,0:37:14.47,teks umum,,0,0,0,,Dan dia seorang sahaja yang memilikinya?
Dialog: 0,0:37:16.05,0:37:18.76,teks umum,,0,0,0,,Saya mahu, saya telah menguasainya sekarang
Dialog: 0,0:37:20.56,0:37:23.27,teks umum,,0,0,0,,Jika khabar angin ini tersebar di seluruh Sosnovy Bor,
Dialog: 0,0:37:23.35,0:37:26.44,teks umum,,0,0,0,,anda akan jawab. Pastikan ini tidak berlaku
Dialog: 0,0:37:27.23,0:37:28.27,teks umum,,0,0,0,,Ya
Dialog: 0,0:37:31.65,0:37:34.65,teks umum,,0,0,0,,Alangkah bahagianya anda menjadi penelan jiwa
Dialog: 0,0:37:34.74,0:37:36.16,teks umum,,0,0,0,,bukan tuan muda
Dialog: 0,0:37:37.07,0:37:40.28,teks umum,,0,0,0,,Tetapi kenapa kita jumpa gelang dia di situ?
Dialog: 0,0:37:41.95,0:37:44.16,teks umum,,0,0,0,,Kami akan tahu apabila kami menemuinya
Dialog: 0,0:37:50.21,0:37:52.76,teks umum,,0,0,0,,Anda kelihatan buruk
Dialog: 0,0:38:00.05,0:38:01.39,teks umum,,0,0,0,,Anda sepatutnya
Dialog: 0,0:38:02.14,0:38:04.48,teks umum,,0,0,0,,pulang dan tunggu dia di sana
Dialog: 0,0:38:14.82,0:38:16.53,teks umum,,0,0,0,,Adakah anda berasa tidak sihat?
Dialog: 0,0:38:17.15,0:38:20.20,teks umum,,0,0,0,,Saya sangat terkejut kerana biskut madu yang saya makan semalam
Dialog: 0,0:38:20.28,0:38:22.29,teks umum,,0,0,0,,masih di kerongkong saya
Dialog: 0,0:38:24.33,0:38:27.29,teks umum,,0,0,0,,Saya sangat takut apabila saya mendengar tentang penelan jiwa,
Dialog: 0,0:38:27.37,0:38:29.71,teks umum,,0,0,0,,bahawa roh mula-mula meninggalkan jasad dan kemudian kembali
Dialog: 0,0:38:37.84,0:38:40.26,teks umum,,0,0,0,,Adakah kebenaran kembali?
Dialog: 0,0:38:43.18,0:38:44.52,teks umum,,0,0,0,,Adakah itu awak, pembantu rumah Kim?
Dialog: 0,0:38:45.35,0:38:47.85,teks umum,,0,0,0,,Tidak, bab. Saya pembantu rumah Pak
Dialog: 0,0:38:49.06,0:38:52.69,teks umum,,0,0,0,,Saya boleh memukul belakang tuan muda, yang sangat menakutkan saya
Dialog: 0,0:38:54.78,0:38:56.19,teks umum,,0,0,0,,Pukul saya sebaliknya
Dialog: 0,0:38:58.57,0:39:01.16,teks umum,,0,0,0,,Saya beri kebenaran kepada Maid Pak
Dialog: 0,0:39:01.74,0:39:02.83,teks umum,,0,0,0,,Ayuh
Dialog: 0,0:39:02.91,0:39:04.66,teks umum,,0,0,0,,Tangan saya kuat
Dialog: 0,0:39:04.74,0:39:06.70,teks umum,,0,0,0,,Ia akan menyakitkan
Dialog: 0,0:39:07.58,0:39:09.79,teks umum,,0,0,0,,Saya tidak akan menangis,
Dialog: 0,0:39:09.87,0:39:11.17,teks umum,,0,0,0,,pukul
Dialog: 0,0:39:14.80,0:39:17.72,teks umum,,0,0,0,,Pertimbangkan bahawa anda telah memukul saya sekali
Dialog: 0,0:39:19.05,0:39:20.34,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:39:21.05,0:39:23.18,teks umum,,0,0,0,,Adakah anda akan melakukan sesuatu yang tidak menyenangkan kepada saya sebagai tindak balas?
Dialog: 0,0:39:23.26,0:39:25.77,teks umum,,0,0,0,,Kemudian saya membatalkan pukulan ini
Dialog: 0,0:39:25.85,0:39:27.18,teks umum,,0,0,0,,Pukul saya juga
Dialog: 0,0:39:28.02,0:39:29.14,teks umum,,0,0,0,,Ayuh
Dialog: 0,0:39:30.10,0:39:31.56,teks umum,,0,0,0,,Cepat
Dialog: 0,0:39:37.23,0:39:38.44,teks umum,,0,0,0,,Saya...
Dialog: 0,0:39:40.20,0:39:41.86,teks umum,,0,0,0,,Saya tidak mahu menyakiti awak
Dialog: 0,0:39:44.24,0:39:46.20,teks umum,,0,0,0,,Sebagai ketua Sosnovy Bor,
Dialog: 0,0:39:47.45,0:39:50.41,teks umum,,0,0,0,,Saya perlu bersikap dingin dan tidak berhati perut
Dialog: 0,0:39:51.08,0:39:52.42,teks umum,,0,0,0,,Tetapi saya benar-benar
Dialog: 0,0:39:53.54,0:39:55.21,teks umum,,0,0,0,,Saya tidak mahu menyakiti awak
Dialog: 0,0:40:00.88,0:40:02.22,teks umum,,0,0,0,,Adakah anda bimbang tentang
Dialog: 0,0:40:02.76,0:40:06.22,teks umum,,0,0,0,,apa yang mereka tanya saya tentang Guru Chang Gan semalam?
Dialog: 0,0:40:06.81,0:40:08.77,teks umum,,0,0,0,,Banyak yang telah berlaku
Dialog: 0,0:40:08.85,0:40:10.85,teks umum,,0,0,0,,Sebagai ketua, saya tidak boleh
Dialog: 0,0:40:11.85,0:40:13.81,teks umum,,0,0,0,,bersifat objektif
Dialog: 0,0:40:14.77,0:40:16.90,teks umum,,0,0,0,,Pukulan awak membuatkan saya sedar
Dialog: 0,0:40:17.73,0:40:20.95,teks umum,,0,0,0,,Sekarang kita mesti bertindak dengan bijak
Dialog: 0,0:40:25.12,0:40:27.03,teks umum,,0,0,0,,Anda boleh mengalahkan saya dengan tenang
Dialog: 0,0:40:28.37,0:40:29.95,teks umum,,0,0,0,,sebagai pembantu rumah Pak
Dialog: 0,0:40:31.87,0:40:33.04,teks umum,,0,0,0,,Daripada anda
Dialog: 0,0:40:34.04,0:40:35.63,teks umum,,0,0,0,,Saya akan terima
Dialog: 0,0:40:51.81,0:40:53.14,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:40:53.23,0:40:55.77,teks umum,,0,0,0,,Tuan Ho berkata untuk mengetahui dari mana datangnya sihir itu
Dialog: 0,0:40:55.86,0:40:58.15,teks umum,,0,0,0,,Dan di tempat itu saya dapati ini
Dialog: 0,0:40:59.15,0:41:01.28,teks umum,,0,0,0,,Hilang, nampaknya
Dialog: 0,0:41:02.70,0:41:04.24,teks umum,,0,0,0,,Anda tidak memerlukannya lagi?
Dialog: 0,0:41:05.28,0:41:07.07,teks umum,,0,0,0,,Tidak, tidak lagi
Dialog: 0,0:41:07.78,0:41:10.24,teks umum,,0,0,0,,Hampir kehilangan harta keluarga Jin
Dialog: 0,0:41:11.33,0:41:12.58,teks umum,,0,0,0,,Terima kasih kerana menemuinya
Dialog: 0,0:41:14.00,0:41:15.71,teks umum,,0,0,0,,Anda telah kehilangan sesuatu yang lain
Dialog: 0,0:41:17.00,0:41:18.84,teks umum,,0,0,0,,Awak tak nak cari Mu Dok?
Dialog: 0,0:41:20.88,0:41:21.92,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,0:41:23.67,0:41:25.30,teks umum,,0,0,0,,Saya jumpa dia ketika dia bersembunyi di dalam hutan
Dialog: 0,0:41:26.76,0:41:29.68,teks umum,,0,0,0,,Dia cedera dan berdarah
Dialog: 0,0:41:44.99,0:41:45.91,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:41:47.62,0:41:48.78,teks umum,,0,0,0,,Hos,
Dialog: 0,0:41:49.33,0:41:51.79,teks umum,,0,0,0,,bagaimana awak boleh tinggalkan saya?
Dialog: 0,0:41:51.87,0:41:52.87,teks umum,,0,0,0,,Apa?
Dialog: 0,0:41:54.62,0:41:58.08,teks umum,,0,0,0,,Awak lari, tinggalkan saya
Dialog: 0,0:41:58.92,0:42:00.42,teks umum,,0,0,0,,Main bersama saya
Dialog: 0,0:42:04.13,0:42:07.22,teks umum,,0,0,0,,Ya... Saya lari
Dialog: 0,0:42:07.80,0:42:08.76,teks umum,,0,0,0,,Tepat sekali!
Dialog: 0,0:42:08.84,0:42:12.14,teks umum,,0,0,0,,Kami bertemu dengan seorang penelan jiwa semasa bersembunyi dari hujan
Dialog: 0,0:42:12.22,0:42:13.52,teks umum,,0,0,0,,Terima kasih kepada anda
Dialog: 0,0:42:13.60,0:42:16.89,teks umum,,0,0,0,,penelan jiwa ini hampir membaham saya
Dialog: 0,0:42:19.40,0:42:20.44,teks umum,,0,0,0,,Maaf
Dialog: 0,0:42:22.02,0:42:25.74,teks umum,,0,0,0,,Saya sangat takut sehingga saya tidak dapat memikirkan apa-apa dan melarikan diri
Dialog: 0,0:42:27.32,0:42:30.70,teks umum,,0,0,0,,Yul menyangka Moo Deok sebagai penelan jiwa dan hampir membunuhnya
Dialog: 0,0:42:31.37,0:42:34.41,teks umum,,0,0,0,,Jika dia tidak menjaganya, Moo Deok akan mati
Dialog: 0,0:42:39.96,0:42:41.42,teks umum,,0,0,0,,Yul,
Dialog: 0,0:42:41.50,0:42:45.42,teks umum,,0,0,0,,terima kasih kerana menyelamatkan Moo Deok dan menjaganya
Dialog: 0,0:42:51.30,0:42:53.10,teks umum,,0,0,0,,Adakah anda benar-benar melarikan diri, meninggalkan dia?
Dialog: 0,0:42:58.89,0:43:00.73,teks umum,,0,0,0,,Jika tidak saya akan mati
Dialog: 0,0:43:01.36,0:43:02.82,teks umum,,0,0,0,,Kadang-kadang anda hanya perlu memikirkan tentang diri anda sendiri
Dialog: 0,0:43:04.32,0:43:06.40,teks umum,,0,0,0,,Apa yang anda tonton? Tidak setuju?
Dialog: 0,0:43:07.78,0:43:10.03,teks umum,,0,0,0,,Walau apa pun, saya gembira,
Dialog: 0,0:43:10.11,0:43:12.83,teks umum,,0,0,0,,bahawa kami berdua baik-baik saja
Dialog: 0,0:43:22.42,0:43:23.25,teks umum,,0,0,0,,Ya
Dialog: 0,0:43:29.55,0:43:31.39,teks umum,,0,0,0,,Saya dengar awak bersembunyi di Danhyangok
Dialog: 0,0:43:31.97,0:43:33.85,teks umum,,0,0,0,,Adakah anda mendengar apa yang pemimpin kami katakan?
Dialog: 0,0:43:33.93,0:43:36.06,teks umum,,0,0,0,,Hutan pain akan menanggung malu anda
Dialog: 0,0:43:36.14,0:43:37.64,teks umum,,0,0,0,,Saya sangat letih
Dialog: 0,0:43:38.39,0:43:40.81,teks umum,,0,0,0,,Kenapa, jika saya bukan ahli Sosnovy Bor?
Dialog: 0,0:43:40.89,0:43:43.02,teks umum,,0,0,0,,Tanding dengan putera raja dalam masa dua minggu
Dialog: 0,0:43:43.65,0:43:47.23,teks umum,,0,0,0,,Jangan muncul di bandar sehingga itu, jangan menimbulkan masalah
Dialog: 0,0:43:47.32,0:43:48.53,teks umum,,0,0,0,,Tundukkan kepala anda
Dialog: 0,0:43:54.53,0:43:56.79,teks umum,,0,0,0,,Terima kasih kerana menjaga saya
Dialog: 0,0:43:56.87,0:43:58.95,teks umum,,0,0,0,,Nampaknya, Uk mengatasi dengan baik tanpa gelang
Dialog: 0,0:44:00.04,0:44:02.25,teks umum,,0,0,0,,Saya rasa dia boleh mengawal tenaga sekarang
Dialog: 0,0:44:04.54,0:44:07.42,teks umum,,0,0,0,,Dia mempertaruhkan nyawanya semula dan mendapat apa yang dia mahu
Dialog: 0,0:44:07.50,0:44:09.01,teks umum,,0,0,0,,Dan anda berada di sana lagi
Dialog: 0,0:44:11.80,0:44:15.60,teks umum,,0,0,0,,Jika ia menyusahkan awak, awak akan meninggalkan saya untuk mati
Dialog: 0,0:44:16.22,0:44:17.35,teks umum,,0,0,0,,Mungkin
Dialog: 0,0:44:19.10,0:44:20.48,teks umum,,0,0,0,,lain kali
Dialog: 0,0:44:27.36,0:44:28.57,contact,,0,0,0,,Moo Dok
Dialog: 0,0:44:29.65,0:44:30.90,teks umum,,0,0,0,,Saya datang, tuan
Dialog: 0,0:44:33.66,0:44:34.70,teks umum,,0,0,0,,Kami pergi
Dialog: 0,0:44:40.58,0:44:42.62,teks umum,,0,0,0,,Uk tidak cedera
Dialog: 0,0:44:43.54,0:44:44.46,teks umum,,0,0,0,,Baguslah
Dialog: 0,0:44:45.38,0:44:47.29,teks umum,,0,0,0,,Dia melihat
Dialog: 0,0:44:47.38,0:44:49.88,teks umum,,0,0,0,,siapa yang bersama Kil Ju ketika dia berubah jiwa?
Dialog: 0,0:44:49.96,0:44:52.88,teks umum,,0,0,0,,Mungkin lelaki berbaju biru
Dialog: 0,0:44:52.97,0:44:55.39,teks umum,,0,0,0,,Uk terlalu sibuk berlari untuk melihat
Dialog: 0,0:44:55.47,0:44:57.18,teks umum,,0,0,0,,Adakah anda bertanya kepada pembantu rumahnya?
Dialog: 0,0:44:58.60,0:45:00.35,teks umum,,0,0,0,,Dia pasti pernah melihat mantera itu
Dialog: 0,0:45:03.35,0:45:04.60,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:45:10.61,0:45:12.78,teks umum,,0,0,0,,Jika dia melihatnya, dia tidak tahu apa itu
Dialog: 0,0:45:13.99,0:45:16.74,teks umum,,0,0,0,,Ini adalah pembantu rumah biasa yang tahu sedikit tentang sihir
Dialog: 0,0:45:19.41,0:45:21.58,teks umum,,0,0,0,,Bagaimana dengan tangan?
Dialog: 0,0:45:23.33,0:45:24.16,teks umum,,0,0,0,,Sakit?
Dialog: 0,0:45:26.71,0:45:29.75,teks umum,,0,0,0,,Terdapat racun dari ilmu sihir dalam reflektor yang saya sentuh
Dialog: 0,0:45:30.59,0:45:31.67,teks umum,,0,0,0,,Tetapi saya baik-baik saja
Dialog: 0,0:45:33.34,0:45:34.72,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:46:12.84,0:46:14.67,teks umum,,0,0,0,,Kenapa awak nak jumpa saya?
Dialog: 0,0:46:16.55,0:46:20.76,teks umum,,0,0,0,,Saya dengar awak ambil hadiah perkahwinan saya
Dialog: 0,0:46:21.39,0:46:22.72,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:46:22.81,0:46:25.93,teks umum,,0,0,0,,Takut saya akan memusnahkan mereka?
Dialog: 0,0:46:26.02,0:46:30.02,teks umum,,0,0,0,,Saya akan simpan mereka sehingga perkahwinan anda yang seterusnya
Dialog: 0,0:46:30.56,0:46:31.98,teks umum,,0,0,0,,Buang mereka
Dialog: 0,0:46:32.07,0:46:34.40,teks umum,,0,0,0,,Perkahwinan bukan lagi keutamaan saya
Dialog: 0,0:46:35.40,0:46:37.53,teks umum,,0,0,0,,Jangan terlalu malu
Dialog: 0,0:46:37.61,0:46:42.12,teks umum,,0,0,0,,Perkahwinan itu disediakan secara rahsia, hanya sedikit orang yang mengetahuinya
Dialog: 0,0:46:44.16,0:46:45.12,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:46:47.37,0:46:49.50,contact,,0,0,0,,Cho Young!
Dialog: 0,0:46:53.13,0:46:54.88,teks umum,,0,0,0,,Mereka kata anda akan berkahwin
Dialog: 0,0:46:55.67,0:46:58.80,teks umum,,0,0,0,,Saya mendengar tentang hadiah, dan saya menemui seorang tukang membuat cincin
Dialog: 0,0:46:59.34,0:47:02.10,teks umum,,0,0,0,,Nampaknya, khabar angin telah tersebar
Dialog: 0,0:47:02.18,0:47:03.10,teks umum,,0,0,0,,Tahniah
Dialog: 0,0:47:03.18,0:47:05.43,teks umum,,0,0,0,,Tahniah, tuan muda Pak
Dialog: 0,0:47:06.10,0:47:08.77,teks umum,,0,0,0,,- Saya?\N- Saya tahu awak yang akan berkahwin
Dialog: 0,0:47:08.85,0:47:10.69,contact,,0,0,0,,Dia menerima hadiah
Dialog: 0,0:47:10.77,0:47:12.61,contact,,0,0,0,,Saya ikut kamu mencuba cincin
Dialog: 0,0:47:12.69,0:47:13.82,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:47:13.90,0:47:16.74,teks umum,,0,0,0,,Terdapat khabar angin yang tidak masuk akal bahawa anda telah berkahwin dengan Chan Wook
Dialog: 0,0:47:17.32,0:47:18.28,miring,,0,0,0,,Tidak?
Dialog: 0,0:47:18.36,0:47:20.03,contact,,0,0,0,,Kamu berdua akan berkahwin
Dialog: 0,0:47:21.70,0:47:22.74,teks umum,,0,0,0,,Ya, betul
Dialog: 0,0:47:22.82,0:47:24.74,teks umum,,0,0,0,,Tetapi jangan bercakap mengenainya
Dialog: 0,0:47:24.83,0:47:26.25,teks umum,,0,0,0,,Ia masih rahsia
Dialog: 0,0:47:26.87,0:47:28.00,teks umum,,0,0,0,,Okay
Dialog: 0,0:47:28.62,0:47:29.79,teks umum,,0,0,0,,Jumpa
Dialog: 0,0:47:31.04,0:47:33.42,teks umum,,0,0,0,,Saya beritahu awak itu Dan Gu
Dialog: 0,0:47:33.50,0:47:36.59,teks umum,,0,0,0,,Tepat sekali. Dia tak gila nak kahwin dengan Uka lagi
Dialog: 0,0:47:36.67,0:47:38.26,contact,,0,0,0,,Jangan sebut
Dialog: 0,0:47:40.93,0:47:42.01,teks umum,,0,0,0,,Dan Gu
Dialog: 0,0:47:42.09,0:47:43.89,teks umum,,0,0,0,,Mengapa anda mengesahkan kata-kata mereka?
Dialog: 0,0:47:44.47,0:47:46.77,teks umum,,0,0,0,,Ini lebih baik daripada mengaku bahawa Uk menolak anda dua kali
Dialog: 0,0:47:47.39,0:47:50.19,teks umum,,0,0,0,,Katakanlah kali ini awak enggan berkahwin dengan saya
Dialog: 0,0:47:50.27,0:47:52.06,teks umum,,0,0,0,,Namun, ini hanya khabar angin
Dialog: 0,0:47:53.69,0:47:55.98,teks umum,,0,0,0,,Adakah anda bersetuju dengan pengaturan ini?
Dialog: 0,0:47:56.94,0:47:58.49,teks umum,,0,0,0,,Anda akan malu
Dialog: 0,0:47:59.74,0:48:00.95,teks umum,,0,0,0,,Saya setuju
Dialog: 0,0:48:28.93,0:48:29.89,teks umum,,0,0,0,,Stink Mu Deok?
Dialog: 0,0:48:31.48,0:48:33.94,teks umum,,0,0,0,,Adakah anda kembali ke sini lagi? Adakah anda tidak terluka?
Dialog: 0,0:48:34.94,0:48:35.94,teks umum,,0,0,0,,Apa?
Dialog: 0,0:48:38.86,0:48:40.40,teks umum,,0,0,0,,Lupakan. Bergerak pergi
Dialog: 0,0:48:45.53,0:48:47.70,teks umum,,0,0,0,,Mencari Moo Deok lagi?
Dialog: 0,0:48:47.78,0:48:50.54,teks umum,,0,0,0,,No. Pakaian itu kelihatan biasa
Dialog: 0,0:48:51.87,0:48:54.33,teks umum,,0,0,0,,Moo Dok menjualnya kepada kami
Dialog: 0,0:48:55.08,0:48:57.09,teks umum,,0,0,0,,- Dijual?\N- Ya
Dialog: 0,0:48:57.17,0:49:00.09,teks umum,,0,0,0,,Dia berkata ia adalah hadiah daripada seorang lelaki yang remeh
Dialog: 0,0:49:00.17,0:49:01.59,teks umum,,0,0,0,,Dan juga ia disediakan
Dialog: 0,0:49:01.67,0:49:03.63,teks umum,,0,0,0,,dan tidak memerlukan pakaian itu kembali
Dialog: 0,0:49:05.26,0:49:07.89,teks umum,,0,0,0,,Adakah dia benar-benar berkata demikian?
Dialog: 0,0:49:07.97,0:49:11.77,teks umum,,0,0,0,,Ya. Bau Moo Deok dan sutera tidak boleh seiring
Dialog: 0,0:49:12.73,0:49:13.98,teks umum,,0,0,0,,Tonton bahasa anda
Dialog: 0,0:49:14.73,0:49:15.60,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:15.69,0:49:19.07,teks umum,,0,0,0,,Saya memberinya nama ini dan hanya saya yang boleh memanggilnya begitu
Dialog: 0,0:49:19.15,0:49:20.28,teks umum,,0,0,0,,Bukan anda
Dialog: 0,0:49:21.23,0:49:22.28,teks umum,,0,0,0,,Maaf
Dialog: 0,0:49:23.99,0:49:25.07,teks umum,,0,0,0,,Dan juga
Dialog: 0,0:49:27.16,0:49:29.45,teks umum,,0,0,0,,dia kelihatan baik dalam pakaian itu
Dialog: 0,0:49:30.16,0:49:32.54,teks umum,,0,0,0,,Lebih baik daripada kamu berjubah biru itu
Dialog: 0,0:49:33.12,0:49:34.79,teks umum,,0,0,0,,Nampaknya anda tidak menyukainya
Dialog: 0,0:49:36.38,0:49:37.63,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:49:37.71,0:49:40.34,teks umum,,0,0,0,,Semuanya seperti ini
Dialog: 0,0:49:40.42,0:49:42.46,teks umum,,0,0,0,,Ini jubah Nak Su
Dialog: 0,0:49:42.55,0:49:43.59,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:49:43.67,0:49:47.05,teks umum,,0,0,0,,Nomad Nak Su membunuh ahli silap mata Jeonbugwan di hadapan istana
Dialog: 0,0:49:47.64,0:49:49.81,teks umum,,0,0,0,,Dia memakai jubah yang serupa
Dialog: 0,0:49:49.89,0:49:53.52,teks umum,,0,0,0,,Sekarang semua orang di ibu negara mempunyai ini
Dialog: 0,0:49:59.06,0:50:02.32,teks umum,,0,0,0,,- Jom beli jubah Nak Su\N- Saya ada satu
Dialog: 0,0:50:02.40,0:50:04.15,teks umum,,0,0,0,,Ini akan melindungi jiwa anda daripada diserap
Dialog: 0,0:50:04.24,0:50:05.65,teks umum,,0,0,0,,- Ini\N- Ambil
Dialog: 0,0:50:05.74,0:50:08.16,italic,,0,0,0,,Saya mahu yang ini
Dialog: 0,0:50:08.24,0:50:10.45,teks umum,,0,0,0,,- Cape Nak Su\N- Cubalah
Dialog: 0,0:50:15.12,0:50:17.21,teks umum,,0,0,0,,Nomad dalam Biru
Dialog: 0,0:50:18.33,0:50:20.59,teks umum,,0,0,0,,Semua orang menyangka Nak Soo telah kembali dari kematian
Dialog: 0,0:50:22.30,0:50:26.13,teks umum,,0,0,0,,Tetapi terima kasih kepada "Nak Su in Blue",
Dialog: 0,0:50:26.22,0:50:28.89,teks umum,,0,0,0,,tiada siapa yang ingat pergaduhan antara Uka dan putera raja
Dialog: 0,0:50:30.05,0:50:32.01,teks umum,,0,0,0,,Saya tertanya-tanya di mana Wook dan Moo Deok
Dialog: 0,0:50:33.14,0:50:34.52,teks umum,,0,0,0,,Mereka tiada di Danhyangok
Dialog: 0,0:50:35.39,0:50:36.85,teks umum,,0,0,0,,Saya pasti mereka baik-baik saja
Dialog: 0,0:50:37.56,0:50:40.19,teks umum,,0,0,0,,Mereka akan kembali dalam masa dua minggu
Dialog: 0,0:50:42.65,0:50:44.28,teks umum,,0,0,0,,By the way, Yul
Dialog: 0,0:50:46.86,0:50:48.57,teks umum,,0,0,0,,Saya juga membelinya untuk diri saya sendiri. Adakah anda ingin mencubanya?
Dialog: 0,0:50:54.29,0:50:55.25,teks umum,,0,0,0,,Okey
Dialog: 0,0:50:59.83,0:51:02.38,teks umum,,0,0,0,,Siapakah itu?
Dialog: 0,0:51:02.46,0:51:05.63,teks umum,,0,0,0,,Nak Su berbaju biru, memiliki Tansu?
Dialog: 0,0:51:13.64,0:51:15.77,teks umum,,0,0,0,,Anda kata ini kubur orang yang menelan jiwa
Dialog: 0,0:51:17.35,0:51:18.94,teks umum,,0,0,0,,Jadi sepatutnya ada di sini
Dialog: 0,0:51:20.81,0:51:21.94,teks umum,,0,0,0,,Ayah kamu
Dialog: 0,0:51:23.90,0:51:25.48,teks umum,,0,0,0,,Bayi
Dialog: 0,0:51:26.03,0:51:29.78,teks umum,,0,0,0,,Saya fikir dia dibunuh oleh ahli silap mata empat keluarga
Dialog: 0,0:51:31.49,0:51:34.12,teks umum,,0,0,0,,Jin Mu membawa saya kepadanya, saya memanggilnya Dan Zhu
Dialog: 0,0:51:34.20,0:51:35.24,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:51:36.87,0:51:39.37,teks umum,,0,0,0,,ayah saya seorang nomad, dia digunakan
Dialog: 0,0:51:41.08,0:51:43.38,teks umum,,0,0,0,,Dan mereka menggunakan saya, kemudian meninggalkan saya
Dialog: 0,0:51:46.96,0:51:48.51,teks umum,,0,0,0,,Seperti yang Kil Ju katakan,
Dialog: 0,0:51:49.63,0:51:51.38,teks umum,,0,0,0,,Saya akan membatu dan mati
Dialog: 0,0:51:56.22,0:51:57.64,teks umum,,0,0,0,,Apabila saya bertukar menjadi batu,
Dialog: 0,0:52:02.06,0:52:03.73,teks umum,,0,0,0,,sudikah awak menguburkan saya di sini?
Dialog: 0,0:52:15.24,0:52:19.33,teks umum,,0,0,0,,Saya dapati di mana Dan Zhu yang sebenar
Dialog: 0,0:52:21.00,0:52:24.04,teks umum,,0,0,0,,Di dalam istana. Yang sebenar ada
Dialog: 0,0:52:28.51,0:52:31.38,teks umum,,0,0,0,,Beritahu saya tentang batu ais
Dialog: 0,0:52:33.05,0:52:34.34,teks umum,,0,0,0,,Adakah anda pasti,
Dialog: 0,0:52:34.93,0:52:38.18,teks umum,,0,0,0,,bahawa ia telah dimusnahkan
Dialog: 0,0:52:39.56,0:52:43.27,teks umum,,0,0,0,,Cikgu Seo Kyung dan ketua Jinyeowon 200 tahun lalu?
Dialog: 0,0:52:46.06,0:52:47.65,teks umum,,0,0,0,,Kami yakin bahawa dia
Dialog: 0,0:52:49.23,0:52:50.69,teks umum,,0,0,0,,bukan dalam Sosnovy Bor
Dialog: 0,0:53:11.88,0:53:13.80,teks umum,,0,0,0,,Hello, Dan Zhu
Dialog: 0,0:53:30.11,0:53:33.78,teks umum,,0,0,0,,Kil Ju mahukan batu ais, jadi dia datang ke istana untuk berjumpa saya
Dialog: 0,0:53:34.95,0:53:36.11,teks umum,,0,0,0,,Saya tidak tahu,
Dialog: 0,0:53:37.07,0:53:39.58,teks umum,,0,0,0,, bahawa Kil Ju tahu siapa Dan Ju yang sebenar
Dialog: 0,0:53:40.29,0:53:42.20,teks umum,,0,0,0,,Hari keluarga Choi kembali berkuasa,
Dialog: 0,0:53:42.83,0:53:46.75,teks umum,,0,0,0,,dan Sosnovy Bor, punca kejatuhan kita, telah dimusnahkan
Dialog: 0,0:53:48.75,0:53:51.96,teks umum,,0,0,0,,sudah sangat dekat. Kemudian saya akan mula memerintah di Daeho
Dialog: 0,0:53:53.72,0:53:56.26,teks umum,,0,0,0,,Saya menantikan hari ini tidak kurang daripada anda
Dialog: 0,0:53:57.68,0:54:01.10,teks umum,,0,0,0,,Kita mesti mencari dan membunuh orang yang berurusan dengan Kil Ju
Dialog: 0,0:54:02.60,0:54:05.06,teks umum,,0,0,0,,Lelaki ini mungkin menunggu sehingga Kil Ju
Dialog: 0,0:54:05.14,0:54:07.90,teks umum,,0,0,0,,akan datang ke istana untuk mendapatkan batu
Dialog: 0,0:54:07.98,0:54:10.57,teks umum,,0,0,0,,Jika dia tahu di mana batu itu,
Dialog: 0,0:54:11.07,0:54:12.44,teks umum,,0,0,0,,anda mesti cari
Dialog: 0,0:54:13.57,0:54:14.86,teks umum,,0,0,0,,dan bunuh dia
Dialog: 0,0:54:19.45,0:54:20.91,teks umum,,0,0,0,,Saya tidak tahu siapa itu,
Dialog: 0,0:54:21.95,0:54:23.91,teks umum,,0,0,0,,tetapi Dan Zhu yang sebenar berada di dalam istana dan mempunyai batu
Dialog: 0,0:54:24.00,0:54:26.71,teks umum,,0,0,0,,Dengan bantuannya, nomad tidak berubah menjadi penelan jiwa
Dialog: 0,0:54:28.79,0:54:32.05,teks umum,,0,0,0,,Jadi, kita perlu masuk ke dalam istana dan cari Dan Zhu?
Dialog: 0,0:54:32.13,0:54:34.13,teks umum,,0,0,0,,Ini adalah mustahil sekarang
Dialog: 0,0:54:34.92,0:54:37.38,teks umum,,0,0,0,,Saya seorang ahli silap mata lemah yang ditolak oleh Jeongjingak
Dialog: 0,0:54:38.01,0:54:40.60,teks umum,,0,0,0,,Tetapi saya akan teruskan
Dialog: 0,0:54:41.72,0:54:44.22,teks umum,,0,0,0,,Dan saya pasti akan sampai ke istana
Dialog: 0,0:54:45.81,0:54:46.85,teks umum,,0,0,0,,Guru,
Dialog: 0,0:54:48.10,0:54:49.35,teks umum,,0,0,0,,Saya akan cari
Dialog: 0,0:54:50.40,0:54:51.77,teks umum,,0,0,0,,batu untuk anda
Dialog: 0,0:54:57.28,0:54:58.32,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:54:59.20,0:55:01.53,teks umum,,0,0,0,,Guru anda tidak cukup kuat untuk menarik anda ke atas
Dialog: 0,0:55:02.62,0:55:05.29,teks umum,,0,0,0,,atau penutup dari belakang
Dialog: 0,0:55:06.96,0:55:10.13,teks umum,,0,0,0,,Anda tidak pernah begini
Dialog: 0,0:55:10.67,0:55:12.25,teks umum,,0,0,0,,Sentiasa menolak saya hingga mati
Dialog: 0,0:55:15.76,0:55:19.68,miring,,0,0,0,,Tetapi selepas setiap kali saya menjadi lebih baik dan lebih kuat daripada sebelumnya
Dialog: 0,0:55:23.47,0:55:25.31,teks umum,,0,0,0,,Terus letakkan saya dalam bahaya
Dialog: 0,0:55:25.89,0:55:27.52,teks umum,,0,0,0,,Perkara utama adalah dekat
Dialog: 0,0:55:37.49,0:55:38.70,teks umum,,0,0,0,,Okey
Dialog: 0,0:55:39.65,0:55:41.78,teks umum,,0,0,0,,Saya akan berada di sana dan menolak awak sampai mati,
Dialog: 0,0:55:41.87,0:55:44.20,teks umum,,0,0,0,,jika anda berhenti
Dialog: 0,0:56:11.73,0:56:14.81,teks umum,,0,0,0,,Saya akan cari Uka dan pastikan dia tidak datang bergaduh
Dialog: 0,0:56:16.65,0:56:17.94,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:56:18.49,0:56:20.82,teks umum,,0,0,0,,Jika dia mahu datang,
Dialog: 0,0:56:21.70,0:56:22.66,teks umum,,0,0,0,,let
Dialog: 0,0:56:22.74,0:56:25.41,teks umum,,0,0,0,,Ini adalah pertarungan rasmi antara ahli silap mata
Dialog: 0,0:56:26.16,0:56:28.37,teks umum,,0,0,0,,Kami tidak akan dapat campur tangan walaupun seseorang mati
Dialog: 0,0:56:30.50,0:56:32.25,teks umum,,0,0,0,,Jika seseorang meninggal dunia,
Dialog: 0,0:56:34.21,0:56:35.71,teks umum,,0,0,0,,jadi begitulah
Dialog: 0,0:56:40.13,0:56:41.67,teks umum,,0,0,0,,Anda tidak akan menghentikan ini?
Dialog: 0,0:56:45.64,0:56:48.31,teks umum,,0,0,0,,Dewan Bersatu menuntut daripada Uka
Dialog: 0,0:56:48.39,0:56:50.48,teks umum,,0,0,0,,berjuang bagi pihak Sosnovy Bor
Dialog: 0,0:56:51.39,0:56:53.31,teks umum,,0,0,0,,Dia akan lari dari pengecut
Dialog: 0,0:56:54.02,0:56:56.11,teks umum,,0,0,0,,dan akan mati dengan penuh kehormatan,
Dialog: 0,0:56:56.90,0:57:01.78,teks umum,,0,0,0,,Saya hanya akan menonton sebagai ketua Sosnovy Bor
Dialog: 0,0:58:33.91,0:58:38.21,teks umum,,0,0,0,,Yang Mulia Raja dan Permaisuri telah tiba
Dialog: 0,0:59:11.28,0:59:14.08,teks umum,,0,0,0,,Sebulan yang lalu Go Won, pewaris keluarga diraja Daeho,
Dialog: 0,0:59:14.16,0:59:17.71,teks umum,,0,0,0,,mencabar anak sulung keluarga Chan untuk bertanding
Dialog: 0,0:59:17.79,0:59:21.33,teks umum,,0,0,0,,Sosnovy Bor menerima cabaran bagi pihak Chan Wook
Dialog: 0,0:59:22.13,0:59:24.17,contact,,0,0,0,,Dengan menandatangani kertas ini,
Dialog: 0,0:59:24.25,0:59:26.46,teks umum,,0,0,0,,anda bersetuju untuk tidak membuat sebarang tuntutan
Dialog: 0,0:59:27.42,0:59:30.47,teks umum,,0,0,0,,walaupun seseorang meninggal dunia
Dialog: 0,0:59:32.18,0:59:35.97,teks umum,,0,0,0,,Perlawanan akan bermula pada tengah hari
Dialog: 0,0:59:36.64,0:59:38.73,teks umum,,0,0,0,,Jika Chang Wook tidak muncul sebelum itu,
Dialog: 0,0:59:39.52,0:59:41.52,teks umum,,0,0,0,,kita akan menganggap ini sebagai kekalahan
Dialog: 0,0:59:44.23,0:59:49.24,teks umum,,0,0,0,,Anda harus menyebut hukuman yang akan dia terima jika dia tidak hadir
Dialog: 0,0:59:52.53,0:59:57.12,teks umum,,0,0,0,,Jika Chang Wook tidak datang hari ini,
Dialog: 0,0:59:57.91,1:00:02.00,teks umum,,0,0,0,,dia akan kehilangan hak untuk menjadi Gwangju seterusnya
Dialog: 0,1:00:03.92,1:00:05.34,teks umum,,0,0,0,,Jeonbugwan
Dialog: 0,1:00:26.44,1:00:27.36,teks umum,,0,0,0,,Datang kepada saya
Dialog: 0,1:00:29.11,1:00:30.95,teks umum,,0,0,0,,Apa yang ada dalam jag itu?
Dialog: 0,1:00:32.74,1:00:34.41,teks umum,,0,0,0,,Air
Dialog: 0,1:00:34.99,1:00:36.53,teks umum,,0,0,0,,Air?
Dialog: 0,1:01:09.23,1:01:11.19,teks umum,,0,0,0,,Bab, sudah tengah hari
Dialog: 0,1:01:11.28,1:01:13.24,teks umum,,0,0,0,,Tutup pintu dewan
Dialog: 0,1:01:14.45,1:01:15.62,teks umum,,0,0,0,,Saya mesti
Dialog: 0,1:01:16.87,1:01:18.37,teks umum,,0,0,0,,mengumumkan kehilangannya
Dialog: 0,1:01:38.43,1:01:39.35,teks umum,,0,0,0,,Tutup
Dialog: 0,1:01:54.40,1:01:55.66,teks umum,,0,0,0,,Chan Wook telah tiba!
Dialog: 0,1:02:05.00,1:02:05.92,teks umum,,0,0,0,,Encik...
Dialog: 0,1:02:36.61,1:02:37.61,teks umum,,0,0,0,,En.
Dialog: 0,1:02:39.20,1:02:40.20,teks umum,,0,0,0,,Semuanya akan baik-baik saja
Dialog: 0,1:02:44.75,1:02:47.08,prasasti,,0,0,0,,Chan Wook
Dialog: 0,1:03:07.39,1:03:09.35,teks umum,,0,0,0,,Anda menandatangani kertas
Dialog: 0,1:03:09.44,1:03:10.94,teks umum,,0,0,0,,Sekarang tiada siapa yang akan campur tangan,
Dialog: 0,1:03:11.69,1:03:13.69,teks umum,,0,0,0,,walaupun anda mati semasa pertarungan
Dialog: 0,1:03:14.90,1:03:16.07,teks umum,,0,0,0,,Faham
Dialog: 0,1:03:19.78,1:03:20.99,teks umum,,0,0,0,,Ibu,
Dialog: 0,1:03:21.07,1:03:23.70,teks umum,,0,0,0,,hentikan pergaduhan ini
Dialog: 0,1:03:24.45,1:03:27.25,teks umum,,0,0,0,,Dia akan mati di tangan Putera Mahkota
Dialog: 0,1:03:27.33,1:03:29.33,teks umum,,0,0,0,,Dia datang kerana dia sudah bersedia untuk mati
Dialog: 0,1:03:30.42,1:03:32.13,teks umum,,0,0,0,,Perkahwinan kamu telah dibubarkan lagi
Dialog: 0,1:03:32.21,1:03:34.96,teks umum,,0,0,0,,Nasib dia tiada kena mengena dengan kita
Dialog: 0,1:03:48.48,1:03:49.85,teks umum,,0,0,0,,Anda boleh mula
Dialog: 0,1:04:19.05,1:04:21.26,kenangan miring,,0,0,0,,Pertama: jangan serang, pertahankan diri sendiri
Dialog: 0,1:04:21.34,1:04:23.51,kenangan,,0,0,0,,Serang dia dengan kemahiran anda -
Dialog: 0,1:04:25.05,1:04:26.22,kenangan,,0,0,0,,anda akan mati
Dialog: 0,1:04:28.14,1:04:30.06,kenangan,,0,0,0,,Anda hanya boleh menyerang apabila dia
Dialog: 0,1:04:31.23,1:04:32.81,kenangan,,0,0,0,,hilang tumpuan
Dialog: 0,1:05:10.85,1:05:12.81,di sebalik tabir,,0,0,0,,Saya pasti dia meletakkannya
Dialog: 0,1:05:12.89,1:05:15.61,kenangan miring,,0,0,0,,Bolehkah anda pergi ke Sosnovy Bor bila-bila masa anda mahu?
Dialog: 0,1:05:16.65,1:05:17.82,kenangan,,0,0,0,,Ya. Dan apa?
Dialog: 0,1:05:18.86,1:05:20.40,kenangan,,0,0,0,,Saya ada permintaan
Dialog: 0,1:05:20.99,1:05:22.82,kenangan,,0,0,0,,Anda boleh letak air di dalam bilik latihan,
Dialog: 0,1:05:22.90,1:05:24.99,kenangan,,0,0,0,,jadi dia boleh guna Tansu?
Dialog: 0,1:05:39.17,1:05:42.17,kenangan,,0,0,0,,Tempayan air ini mengelirukan saya
Dialog: 0,1:05:43.88,1:05:44.84,kenangan,,0,0,0,,Hancurkan mereka
Dialog: 0,1:06:44.65,1:06:45.70,teks umum,,0,0,0,,Hos
Dialog: 0,1:06:57.37,1:06:58.50,teks umum,,0,0,0,,Tansu
Dialog: 0,1:07:16.43,1:07:17.39,teks umum,,0,0,0,,Putera...
Dialog: 0,1:07:17.48,1:07:18.56,teks umum,,0,0,0,,Duel
Dialog: 0,1:07:19.10,1:07:20.27,teks umum,,0,0,0,,over
Dialog: 0,1:07:25.32,1:07:27.65,teks umum,,0,0,0,,Tidak adil. Tidak dikira!
Dialog: 0,1:07:37.50,1:07:39.04,teks umum,,0,0,0,,Itu Tansu
Dialog: 0,1:07:39.96,1:07:42.92,teks umum,,0,0,0,,Hanya mereka yang telah menguasai Chisu boleh menguasainya
Dialog: 0,1:07:43.79,1:07:47.55,teks umum,,0,0,0,,Bagaimanakah Chan Wook, yang pintu pagarnya dibuka baru-baru ini, boleh mengambil alih dia?
Dialog: 0,1:07:47.63,1:07:48.97,teks umum,,0,0,0,,Saya pasti,
Dialog: 0,1:07:49.05,1:07:52.30,teks umum,,0,0,0,, bahawa salah seorang tuan membantunya
Dialog: 0,1:07:52.39,1:07:55.51,contact,,0,0,0,,Bagaimana mereka akan membantunya,
Dialog: 0,1:07:55.60,1:07:57.43,teks umum,,0,0,0,,jika semua orang menonton?
Dialog: 0,1:07:57.52,1:07:58.98,teks umum,,0,0,0,,Jangan cakap kosong!
Dialog: 0,1:07:59.60,1:08:01.56,condong,,0,0,0,,Chan Wook, jawab
Dialog: 0,1:08:01.65,1:08:04.19,teks umum,,0,0,0,,Anda benar-benar menguasai Chisa, dan kemudian Tansa
Dialog: 0,1:08:04.27,1:08:05.98,teks umum,,0,0,0,,dalam masa yang singkat?
Dialog: 0,1:08:07.53,1:08:08.86,teks umum,,0,0,0,,Tidak juga
Dialog: 0,1:08:09.78,1:08:11.78,teks umum,,0,0,0,,Saya mempunyai kawalan tenaga yang lemah
Dialog: 0,1:08:11.86,1:08:14.12,teks umum,,0,0,0,,Saya hanya boleh menggunakan Tansa jika ada air
Dialog: 0,1:08:14.70,1:08:17.41,teks umum,,0,0,0,,Saya hanya tahu memotong air
Dialog: 0,1:08:17.50,1:08:19.79,teks umum,,0,0,0,,Siapa yang ajar kamu ini?
Dialog: 0,1:08:21.58,1:08:23.79,teks umum,,0,0,0,,Seseorang sepatutnya membantu anda
Dialog: 0,1:08:26.96,1:08:28.01,teks umum,,0,0,0,,Tiada sesiapa
Dialog: 0,1:08:29.92,1:08:30.97,teks umum,,0,0,0,,Awak nampak
Dialog: 0,1:08:31.68,1:08:33.14,teks umum,,0,0,0,,Ini hanya lucu
Dialog: 0,1:08:33.22,1:08:35.76,teks umum,,0,0,0,,Dakwaan bahawa dia telah menguasai kemahiran ini sendiri
Dialog: 0,1:08:38.85,1:08:41.44,teks umum,,0,0,0,,Saya perhatikan jag air di sini
Dialog: 0,1:08:43.15,1:08:45.19,teks umum,,0,0,0,,Siapa yang meletakkannya?
Dialog: 0,1:08:46.86,1:08:48.69,teks umum,,0,0,0,,Guru awak?
Dialog: 0,1:08:50.57,1:08:52.03,teks umum,,0,0,0,,Saya belajar sendiri
Dialog: 0,1:08:52.11,1:08:53.49,teks umum,,0,0,0,,Saya tidak akan jatuh hati untuk ini!
Dialog: 0,1:08:53.57,1:08:55.45,teks umum,,0,0,0,,Chan Wook, jelaskan sendiri
Dialog: 0,1:08:58.91,1:09:02.04,teks umum,,0,0,0,,Siapa yang membantu anda berlatih?
Dialog: 0,1:09:12.17,1:09:13.26,italic,,0,0,0,,Saya letak jag
Dialog: 0,1:09:25.90,1:09:27.48,teks umum,,0,0,0,,Dan saya bersamanya
Dialog: 0,1:09:28.27,1:09:31.44,teks umum,,0,0,0,,Semua yang dia katakan adalah benar
Dialog: 0,1:09:35.11,1:09:36.28,teks umum,,0,0,0,,Dan siapa kamu?
Dialog: 0,1:09:37.20,1:09:39.12,teks umum,,0,0,0,,Beraninya awak campur tangan?
Dialog: 0,1:09:39.20,1:09:40.29,teks umum,,0,0,0,,Diam!
Dialog: 0,1:09:41.04,1:09:43.71,teks umum,,0,0,0,,Ini ialah Hemp Master Li
Dialog: 0,1:09:43.79,1:09:45.50,teks umum,,0,0,0,,Perantis Cikgu Seo Kyung
Dialog: 0,1:09:45.58,1:09:47.42,teks umum,,0,0,0,,Salam dia!
Dialog: 0,1:09:50.80,1:09:52.63,teks umum,,0,0,0,,Hello, tuan
Dialog: 0,1:09:55.47,1:09:58.89,teks umum,,0,0,0,,Saya bersamanya di Danhyangk dan melihat segala-galanya
Dialog: 0,1:09:58.97,1:10:01.68,teks umum,,0,0,0,,Dia menghabiskan masa berhari-hari belajar mencincang titisan air
Dialog: 0,1:10:04.89,1:10:06.44,teks umum,,0,0,0,,Dan bersamanya
Dialog: 0,1:10:07.94,1:10:10.32,teks umum,,0,0,0,,hanya ada pembantu rumahnya
Dialog: 0,1:10:12.36,1:10:15.40,teks umum,,0,0,0,,Cikgu Li menjaminnya
Dialog: 0,1:10:17.45,1:10:21.91,teks umum,,0,0,0,,Adakah ada bantahan lain?
Dialog: 0,1:10:56.86,1:10:58.49,teks umum,,0,0,0,,Mari pergi, Yang Mulia
Dialog: 0,1:11:15.59,1:11:18.34,teks umum,,0,0,0,,Biarkan Chan Wook memasuki Jeonbugwan
Dialog: 0,1:11:31.48,1:11:34.90,teks umum,,0,0,0,,Tidak hairanlah anak lelaki Gwangju Chang Gan begitu berbakat
Dialog: 0,1:11:34.98,1:11:40.03,teks umum,,0,0,0,,Memandangkan anda belum mempunyai guru, Jeonbugwan dengan senang hati akan menerima anda
Dialog: 0,1:11:40.82,1:11:42.70,teks umum,,0,0,0,,Saya tidak memerlukannya di sini!
Dialog: 0,1:11:42.78,1:11:45.12,teks umum,,0,0,0,,Saya sepatutnya menjadi gurunya
Dialog: 0,1:11:45.20,1:11:48.33,teks umum,,0,0,0,,Saya membuka pintu pagarnya, dan sayalah yang memberinya tenaga saya
Dialog: 0,1:11:48.41,1:11:50.83,teks umum,,0,0,0,,Uk, ikut saya ke Sejukwon
Dialog: 0,1:11:50.92,1:11:53.21,teks umum,,0,0,0,,Saya akan mengajar anda semua yang saya tahu
Dialog: 0,1:11:53.29,1:11:55.55,teks umum,,0,0,0,,Atau mungkin dalam Jinyoewon?
Dialog: 0,1:11:57.30,1:11:59.13,teks umum,,0,0,0,,Pertunangan dengan Cho Young rosak,
Dialog: 0,1:11:59.22,1:12:02.47,teks umum,,0,0,0,,tetapi kami akan menganggap anda keluarga dan mengajar anda mantera kami
Dialog: 0,1:12:06.93,1:12:08.14,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,1:12:09.02,1:12:11.27,teks umum,,0,0,0,,jika anda mahu, anda boleh menyertai Jeonjingak
Dialog: 0,1:12:12.98,1:12:14.27,teks umum,,0,0,0,,Kami akan menerima anda
Dialog: 0,1:12:33.46,1:12:34.59,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:12:34.67,1:12:38.42,teks umum,,0,0,0,,semua orang memanggil saya. nak pergi mana?
Dialog: 0,1:12:50.89,1:12:52.69,teks umum,,0,0,0,,Masukkan Sosnovy Bor,
Dialog: 0,1:12:53.56,1:12:54.69,teks umum,,0,0,0,,hos
Dialog: 0,1:13:04.70,1:13:06.78,teks umum,,0,0,0,,Saya, Chan Wook, anak lelaki sulung keluarga Chan,
Dialog: 0,1:13:07.58,1:13:09.66,teks umum,,0,0,0,,Saya akan memasuki Jeonjingak
Dialog: 0,1:14:06.79,1:14:09.92,pratonton,,0,0,0,,Tuan menjadi ahli silap mata Jeonjingak
Dialog: 0,1:14:10.01,1:14:13.22,pratonton,,0,0,0,,Selamat datang ahli silap mata baharu kami Chan Wook
Dialog: 0,1:14:13.88,1:14:16.05,pratonton,,0,0,0,,Saya benci tuan awak sehingga saya mengetap gigi
Dialog: 0,1:14:16.14,1:14:17.05,pratonton,,0,0,0,,Sudah tentu
Dialog: 0,1:14:19.81,1:14:22.06,pratonton,,0,0,0,,Jika cinta ini berubah-ubah, maka saya tidak memerlukannya!
Dialog: 0,1:14:22.14,1:14:23.10,pratonton,,0,0,0,,Izinkan saya masuk
Dialog: 0,1:14:23.19,1:14:24.02,pratonton,,0,0,0,,Moo Dok
Dialog: 0,1:14:24.10,1:14:26.44,pratonton,,0,0,0,,Saya mesti bersama pemiliknya
Dialog: 0,1:14:26.52,1:14:27.65,pratonton,,0,0,0,,Pulang, tunggu di sana
Dialog: 0,1:14:27.73,1:14:30.07,pratonton,,0,0,0,,En. Chan keluar dan pulang ke rumah
Dialog: 0,1:14:30.82,1:14:32.70,pratonton,,0,0,0,,Cikgu! Tunggu sana
Dialog: 0,1:14:32.78,1:14:34.95,pratonton,,0,0,0,,- Saya datang kepada anda\N- Saya jumpa soalan untuk peperiksaan
Dialog: 0,1:14:35.61,1:14:36.87,pratonton,,0,0,0,,Apa sahaja yang berlaku,
Dialog: 0,1:14:36.95,1:14:39.37,pratonton,,0,0,0,,Saya akan sampai ke Sosnovy Bor kepada pemilik
Dialog: 0,1:14:39.45,1:14:40.66,pratonton,,0,0,0,,Moo Dok
Dialog: 0,1:14:40.74,1:14:43.75,pratonton,,0,0,0,,Saya boleh menangani apa sahaja hanya untuk berjumpa dengan anda
Dialog: 0,0:02:57.14,0:02:59.14,pratonton,,0,0,0,,

