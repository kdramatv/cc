Dialog: 0,0:02:47.14,0:02:49.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.14,0:02:51.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Sana, Martini
Dialog: 0,0:02:51.14,0:02:53.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:00:57.38,0:01:00.51,kenangan,,0,0,0,,Saya melarang sesiapa membuka pintu pagar ini
Dialog: 0,0:01:07.68,0:01:08.68,kenangan condong,,0,0,0,,Kekal di mana anda berada!
Dialog: 0,0:01:11.06,0:01:13.10,kenangan miring,,0,0,0,,Anda tidak boleh pergi begitu sahaja
Dialog: 0,0:01:13.69,0:01:15.40,kenangan,,0,0,0,,Bagaimana dengan kanak-kanak itu?
Dialog: 0,0:01:15.94,0:01:19.28,kenangan,,0,0,0,,Fikirkan apa yang mereka akan katakan tentang Do Hwa dan bayi itu
Dialog: 0,0:01:19.82,0:01:21.65,kenangan,,0,0,0,,Mereka akan mengumpat bahawa anak lelaki itu bukan milik kamu,
Dialog: 0,0:01:22.53,0:01:24.99,kenangan,,0,0,0,,bahawa dia tidak sah
Dialog: 0,0:01:25.74,0:01:29.45,kenangan,,0,0,0,,Dia akan menggunakan nama keluarga Chan, sejak isteri saya melahirkannya
Dialog: 0,0:01:30.08,0:01:32.50,kenangan,,0,0,0,,Saya akan menghantar seseorang selepas dia selepas pengebumian
Dialog: 0,0:01:32.58,0:01:34.04,kenangan,,0,0,0,,Awak tinggalkan dia?
Dialog: 0,0:01:35.42,0:01:36.58,kenangan,,0,0,0,,Dia benar
Dialog: 0,0:01:37.38,0:01:38.88,kenangan,,0,0,0,,bukan anak awak?
Dialog: 0,0:01:41.30,0:01:43.47,kenangan,,0,0,0,,Percaya apa yang anda mahu
Dialog: 0,0:01:46.26,0:01:48.47,kenangan miring,,0,0,0,,Jika dia hanyalah masalah,
Dialog: 0,0:01:48.55,0:01:50.31,kenangan,,0,0,0,,mari kita singkirkan dia di sini dan sekarang
Dialog: 0,0:02:00.02,0:02:02.48,kenangan,,0,0,0,,Nampak? Dia anak awak
Dialog: 0,0:02:02.57,0:02:07.41,kenangan,,0,0,0,,Anak lelaki yang anda ingin lindungi walaupun dengan kos nyawa anda
Dialog: 0,0:02:07.99,0:02:09.74,kenangan,,0,0,0,,Saya hanya cuba memastikan dia selamat
Dialog: 0,0:02:11.45,0:02:14.79,kenangan,,0,0,0,,Jika pintu tenaganya tidak dibuka, dan dia hidup seperti anak saya, dia akan bertahan
Dialog: 0,0:02:15.29,0:02:18.42,kenangan,,0,0,0,,Tetapi jika dia memutuskan untuk mencuba nasib,
Dialog: 0,0:02:20.00,0:02:21.67,kenangan,,0,0,0,,kematian menantinya
Dialog: 0,0:02:23.76,0:02:26.26,kenangan,,0,0,0,,Siapa bapanya
Dialog: 0,0:02:27.72,0:02:28.84,kenangan,,0,0,0,,anak?
Dialog: 0,0:02:33.39,0:02:35.52,kenangan,,0,0,0,,Ayahnya sudah meninggal
Dialog: 0,0:02:39.02,0:02:41.11,kenangan miring,,0,0,0,,Kelahirannya tidak masuk akal, tambahan pula,
Dialog: 0,0:02:41.90,0:02:43.94,kenangan miring,,0,0,0,,dia tidak sepatutnya dilahirkan sama sekali
Dialog: 0,0:02:49.45,0:02:51.70,teks umum,,0,0,0,,Tuan Muda, awak okey?
Dialog: 0,0:02:52.45,0:02:54.83,teks umum,,0,0,0,,Mengapa anda mengeluarkannya?
Dialog: 0,0:02:54.91,0:02:56.16,teks umum,,0,0,0,,Biarkan dia pergi
Dialog: 0,0:03:25.07,0:03:27.15,teks umum,,0,0,0,,Maaf kerana menimbulkan masalah
Dialog: 0,0:03:27.24,0:03:29.41,contact,,0,0,0,,Kenapa awak buka ikatan dia?
Dialog: 0,0:03:32.28,0:03:35.12,teks umum,,0,0,0,,Dia cuba meracuni awak
Dialog: 0,0:03:35.70,0:03:37.70,teks umum,,0,0,0,,Dia tidak mencuba
Dialog: 0,0:03:38.91,0:03:40.37,teks umum,,0,0,0,,saya sendiri minum racun itu
Dialog: 0,0:03:42.96,0:03:46.71,teks umum,,0,0,0,,Kerana saya tidak dapat mengucapkan mantra
Dialog: 0,0:03:47.46,0:03:50.34,teks umum,,0,0,0,,Pembantu rumah saya hanya melakukan apa yang disuruh. Dengan kos nyawanya
Dialog: 0,0:03:51.64,0:03:53.43,teks umum,,0,0,0,,Saya pesan dia
Dialog: 0,0:04:01.98,0:04:05.02,teks umum,,0,0,0,,- Chan Wook, bagaimana boleh?\N- Tunggu dengan ini
Dialog: 0,0:04:05.11,0:04:08.90,teks umum,,0,0,0,,Dia masih belum pulih sepenuhnya
Dialog: 0,0:04:08.99,0:04:12.49,teks umum,,0,0,0,,Hukum dia sesuka hati, tetapi selepas dia sembuh
Dialog: 0,0:04:12.57,0:04:14.37,teks umum,,0,0,0,,Uk hampir mati
Dialog: 0,0:04:14.45,0:04:16.70,teks umum,,0,0,0,,Tidak perlu memarahinya
Dialog: 0,0:04:16.79,0:04:18.45,contact,,0,0,0,,Dia pucat semua
Dialog: 0,0:04:20.46,0:04:21.92,teks umum,,0,0,0,,Bawa dia pulang selamat tinggal
Dialog: 0,0:04:22.00,0:04:24.13,teks umum,,0,0,0,,Tuan, mari kita pergi
Dialog: 0,0:04:24.21,0:04:26.00,teks umum,,0,0,0,,Pergi ke Sejukwon, anda akan sembuh di sana
Dialog: 0,0:04:26.09,0:04:27.63,teks umum,,0,0,0,,Mu Dok perlu ke sana juga
Dialog: 0,0:04:28.21,0:04:29.80,teks umum,,0,0,0,,Sekarang bukan masanya...
Dialog: 0,0:04:29.88,0:04:31.80,teks umum,,0,0,0,,Mu Dok juga perlukan rawatan
Dialog: 0,0:04:31.88,0:04:33.47,teks umum,,0,0,0,,Jika tidak, saya tidak akan pergi
Dialog: 0,0:04:33.55,0:04:34.76,teks umum,,0,0,0,,En!
Dialog: 0,0:04:34.85,0:04:36.93,contact,,0,0,0,,Baiklah! Matilah kemudian
Dialog: 0,0:04:37.01,0:04:39.89,teks umum,,0,0,0,,- Kunci mereka semula!\N- Pakcik, bertenang
Dialog: 0,0:04:39.98,0:04:42.06,teks umum,,0,0,0,,Jika Uk bercakap benar, dia tidak bersalah
Dialog: 0,0:04:42.90,0:04:44.02,teks umum,,0,0,0,,Dia cedera parah
Dialog: 0,0:04:44.69,0:04:46.27,teks umum,,0,0,0,,Tanpa rawatan dia akan mati
Dialog: 0,0:04:46.36,0:04:49.61,teks umum,,0,0,0,,Saya terkejut dia masih hidup selepas semua pukulan
Dialog: 0,0:04:50.19,0:04:52.91,teks umum,,0,0,0,,Jika dia meninggal dunia, saya akan benarkan kamu menguruskan pengebumiannya
Dialog: 0,0:05:10.46,0:05:11.80,teks umum,,0,0,0,,Tolong bantu
Dialog: 0,0:05:13.38,0:05:16.43,teks umum,,0,0,0,,Moo Dok mempertaruhkan nyawanya mengikut perintah saya
Dialog: 0,0:05:16.51,0:05:19.10,teks umum,,0,0,0,,Dia mesti dibawa ke Sejukwon, jika tidak dia tidak akan bertahan
Dialog: 0,0:05:20.85,0:05:22.14,teks umum,,0,0,0,,Tolong dia
Dialog: 0,0:05:33.15,0:05:34.66,teks umum,,0,0,0,,Singkirkan mereka dari pandangan saya
Dialog: 0,0:05:35.45,0:05:37.62,teks umum,,0,0,0,,Bawa mereka ke Saejukwon
Dialog: 0,0:05:40.62,0:05:41.54,contact,,0,0,0,,Ukraine...
Dialog: 0,0:05:44.21,0:05:47.21,teks umum,,0,0,0,,Tuan muda, pergi. Saya akan bawa Moo Deok
Dialog: 0,0:05:47.88,0:05:48.71,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:05:49.75,0:05:51.38,teks umum,,0,0,0,,Moo Dok, bangun
Dialog: 0,0:06:12.03,0:06:13.53,teks umum,,0,0,0,,- Saya akan menggendongnya\N- Tidak
Dialog: 0,0:06:14.99,0:06:16.41,teks umum,,0,0,0,,Saya Sendiri
Dialog: 0,0:06:16.49,0:06:17.95,teks umum,,0,0,0,,Anda tidak boleh berdiri di atas kaki anda
Dialog: 0,0:06:18.82,0:06:21.70,teks umum,,0,0,0,,Saya boleh melakukannya. Dia pembantu rumah saya, saya akan membawanya sendiri
Dialog: 0,0:06:21.79,0:06:23.41,teks umum,,0,0,0,,Anda hampir tidak boleh berjalan sendiri
Dialog: 0,0:06:23.50,0:06:25.16,teks umum,,0,0,0,,Anda tidak boleh mendapatkannya di sana
Dialog: 0,0:06:27.12,0:06:29.17,teks umum,,0,0,0,,Adakah anda fikir? Kemudian...
Dialog: 0,0:06:30.34,0:06:32.84,teks umum,,0,0,0,,- Anda akan menggendongnya di belakang anda\N- Apa?
Dialog: 0,0:06:32.92,0:06:34.21,teks umum,,0,0,0,,Ayuh
Dialog: 0,0:06:34.84,0:06:36.80,teks umum,,0,0,0,,- Adakah anda mahu saya menggendongnya?\N- Ya
Dialog: 0,0:06:37.38,0:06:39.09,teks umum,,0,0,0,,Kenapa saya?
Dialog: 0,0:06:39.18,0:06:40.68,teks umum,,0,0,0,,- Kemari\N- Tuan Muda
Dialog: 0,0:06:41.18,0:06:43.35,teks umum,,0,0,0,,No. Tunggu. Syurga...
Dialog: 0,0:06:43.93,0:06:45.06,teks umum,,0,0,0,,Syurga suci
Dialog: 0,0:06:45.14,0:06:48.40,teks umum,,0,0,0,,Hei, Yul. Dengar...
Dialog: 0,0:06:48.48,0:06:50.06,teks umum,,0,0,0,,Bawa saya bukannya Moo Dok
Dialog: 0,0:06:52.19,0:06:54.74,teks umum,,0,0,0,,Tiada kekuatan langsung. Bawa saya ke Sejukwon
Dialog: 0,0:06:56.49,0:06:57.99,teks umum,,0,0,0,,Awak nak saya bawa dia?
Dialog: 0,0:06:59.74,0:07:02.28,teks umum,,0,0,0,,- Tidak\N- Okay, terima kasih
Dialog: 0,0:07:02.37,0:07:04.12,teks umum,,0,0,0,,Hamba Kim, berhati-hati!
Dialog: 0,0:07:04.20,0:07:05.75,teks umum,,0,0,0,,- Hati-hati dengan dia\N- Okay
Dialog: 0,0:07:05.83,0:07:06.71,teks umum,,0,0,0,,- Nah...\N- Apa...
Dialog: 0,0:07:07.46,0:07:08.79,teks umum,,0,0,0,,Awas
Dialog: 0,0:07:12.09,0:07:13.63,teks umum,,0,0,0,,Pada akhirnya, UK
Dialog: 0,0:07:15.09,0:07:17.63,teks umum,,0,0,0,,membuka pintu tenaga
Dialog: 0,0:07:18.84,0:07:19.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:07:21.26,0:07:25.85,teks umum,,0,0,0,,Dia mempertaruhkan nyawanya. Saya tidak boleh hanya duduk dan menonton
Dialog: 0,0:07:26.64,0:07:29.44,teks umum,,0,0,0,,Saya rasa dia faham,
Dialog: 0,0:07:29.52,0:07:33.07,teks umum,,0,0,0,,bahawa kita tidak akan membiarkan dia membunuh diri
Dialog: 0,0:07:33.94,0:07:36.53,contact,,0,0,0,,Dia mungkin minum racun itu sendiri,
Dialog: 0,0:07:36.61,0:07:38.28,teks umum,,0,0,0,,supaya kita selamatkan dia
Dialog: 0,0:07:42.32,0:07:43.62,teks umum,,0,0,0,,Adakah semuanya baik-baik saja?
Dialog: 0,0:07:45.87,0:07:48.79,teks umum,,0,0,0,,Membuka pintu Uka dan rawatannya
Dialog: 0,0:07:48.87,0:07:51.63,teks umum,,0,0,0,,mungkin memerlukan tenaga saya selama sepuluh tahun
Dialog: 0,0:07:52.67,0:07:56.80,teks umum,,0,0,0,,Jadi anda bukan sahaja membuka pintunya, tetapi juga memberinya tenaga?
Dialog: 0,0:07:56.88,0:08:00.43,teks umum,,0,0,0,,Untuk apa saya, orang tua, menyimpan tenaga saya?
Dialog: 0,0:08:01.13,0:08:03.14,teks umum,,0,0,0,,Dia diracun,
Dialog: 0,0:08:03.22,0:08:05.85,teks umum,,0,0,0,,jadi saya memberi dia kekuatan untuk pulih dengan cepat
Dialog: 0,0:08:05.93,0:08:09.85,teks umum,,0,0,0,,Apabila Uk dipulihkan, anda mesti mengembalikannya
Dialog: 0,0:08:10.81,0:08:14.15,teks umum,,0,0,0,,Adakah ini benar-benar perlu apabila pintu pagarnya terbuka?
Dialog: 0,0:08:14.73,0:08:18.40,teks umum,,0,0,0,,Dia lewat 20 tahun belajar mantera
Dialog: 0,0:08:18.49,0:08:20.90,teks umum,,0,0,0,,Walaupun dia mula belajar sekarang,
Dialog: 0,0:08:21.41,0:08:25.74,teks umum,,0,0,0,,belajar sesuatu yang berfaedah menjelang umur 60 tahun
Dialog: 0,0:08:25.83,0:08:28.66,teks umum,,0,0,0,,Begitulah nasibnya
Dialog: 0,0:08:30.54,0:08:32.04,teks umum,,0,0,0,,Kita perlu memastikan perkara ini
Dialog: 0,0:08:33.79,0:08:37.09,teks umum,,0,0,0,,Jika anda mahu, saya akan mengambil kuasa anda
Dialog: 0,0:08:37.17,0:08:38.30,teks umum,,0,0,0,,Anda tahu apa?
Dialog: 0,0:08:39.17,0:08:41.88,teks umum,,0,0,0,,Saya terlalu letih. Saya mahu berehat
Dialog: 0,0:08:42.63,0:08:44.85,teks umum,,0,0,0,,Bawakan saya wain
Dialog: 0,0:08:48.64,0:08:49.93,teks umum,,0,0,0,,Wain?
Dialog: 0,0:08:52.06,0:08:53.10,teks umum,,0,0,0,,Itulah...
Dialog: 0,0:08:53.94,0:08:57.48,teks umum,,0,0,0,,Dari manakah wain itu berasal di dewan latihan?
Dialog: 0,0:08:57.57,0:08:58.82,teks umum,,0,0,0,,saya nampak
Dialog: 0,0:08:59.82,0:09:02.11,teks umum,,0,0,0,,Saya nampak anda terperangkap dalam diri anda
Dialog: 0,0:09:02.70,0:09:05.53,teks umum,,0,0,0,,Ayuh. Wain yang anda minum apabila anda kesepian
Dialog: 0,0:09:06.12,0:09:08.54,teks umum,,0,0,0,,- Saya tidak bersendirian!\N- Betul
Dialog: 0,0:09:10.87,0:09:11.83,miring,,0,0,0,,Saya benar-benar...
Dialog: 0,0:09:11.91,0:09:13.12,teks umum,,0,0,0,,Sakit kepala
Dialog: 0,0:09:14.00,0:09:15.04,teks umum,,0,0,0,,Ini kerana...
Dialog: 0,0:09:15.13,0:09:16.71,teks umum,,0,0,0,,Apakah nama itu?
Dialog: 0,0:09:16.79,0:09:18.30,teks umum,,0,0,0,,Tepat sekali. Insomnia
Dialog: 0,0:09:18.92,0:09:20.71,teks umum,,0,0,0,,Saya mengalami insomnia yang teruk
Dialog: 0,0:09:22.97,0:09:24.68,teks umum,,0,0,0,,Saya minum wain untuk insomnia
Dialog: 0,0:09:30.89,0:09:34.48,miring,,0,0,0,,Kesepian menghalang anda daripada tidur
Dialog: 0,0:09:34.56,0:09:36.86,teks umum,,0,0,0,,Anda sepatutnya berkahwin semasa muda
Dialog: 0,0:09:37.65,0:09:42.57,teks umum,,0,0,0,,Awak dah lupa ke belum Do Hwa? sangat sunyi?
Dialog: 0,0:09:54.33,0:09:55.42,teks umum,,0,0,0,,Kosong
Dialog: 0,0:09:56.29,0:09:57.46,teks umum,,0,0,0,,- Apa?\N- Awak dah minum semuanya
Dialog: 0,0:09:58.88,0:10:01.25,teks umum,,0,0,0,,Tidak boleh. apa?
Dialog: 0,0:10:05.34,0:10:06.51,teks umum,,0,0,0,,Apa...
Dialog: 0,0:10:06.59,0:10:09.22,teks umum,,0,0,0,,Saya rasa anda sangat kesepian
Dialog: 0,0:10:09.30,0:10:12.35,teks umum,,0,0,0,,Saya hanya minum satu gelas apabila saya tidak boleh tidur
Dialog: 0,0:10:12.97,0:10:14.56,teks umum,,0,0,0,,Hanya satu gelas setiap kali...
Dialog: 0,0:10:21.32,0:10:24.78,teks umum,,0,0,0,,Ini adalah wain yang pakcik saya sembunyikan di tempatnya
Dialog: 0,0:10:24.86,0:10:26.49,teks umum,,0,0,0,,Rasa sedap
Dialog: 0,0:10:27.24,0:10:30.70,teks umum,,0,0,0,,Akhirnya, impian seumur hidup Uka telah menjadi kenyataan
Dialog: 0,0:10:30.78,0:10:32.04,teks umum,,0,0,0,,Mari kita raikan
Dialog: 0,0:10:32.54,0:10:34.20,teks umum,,0,0,0,,Gadis itu, Mu Dok...
Dialog: 0,0:10:34.29,0:10:36.33,teks umum,,0,0,0,,Dia baru-baru ini membawanya dari rumah gisaeng, bukan?
Dialog: 0,0:10:38.13,0:10:41.34,teks umum,,0,0,0,,Dia mempertaruhkan nyawanya untuknya, walaupun pada hakikatnya mereka baru sahaja bertemu
Dialog: 0,0:10:43.59,0:10:44.63,teks umum,,0,0,0,,Ini pelik
Dialog: 0,0:10:44.71,0:10:47.55,teks umum,,0,0,0,,Uk menyelamatkannya daripada nasib menjadi kisaeng
Dialog: 0,0:10:47.63,0:10:50.93,teks umum,,0,0,0,,Dia tidak begitu menginginkannya sehingga dia berpura-pura buta
Dialog: 0,0:10:51.01,0:10:52.68,teks umum,,0,0,0,,Minum
Dialog: 0,0:10:52.76,0:10:53.97,teks umum,,0,0,0,,"Buta"?
Dialog: 0,0:10:54.64,0:10:58.10,teks umum,,0,0,0,,Ya. Menurut Joo Wol, dia buta ketika dia tiba,
Dialog: 0,0:10:58.19,0:11:00.06,teks umum,,0,0,0,,dan sebaik sahaja saya pergi dari situ, saya serta-merta melihat cahaya
Dialog: 0,0:11:00.15,0:11:02.07,teks umum,,0,0,0,,Wainnya sedap
Dialog: 0,0:11:03.94,0:11:05.36,teks umum,,0,0,0,,Dia mudah menipu orang
Dialog: 0,0:11:06.40,0:11:09.61,teks umum,,0,0,0,,Berbohong bahawa dia buta dan Uka diracun
Dialog: 0,0:11:10.95,0:11:13.24,teks umum,,0,0,0,,Senyap, walaupun diseksa
Dialog: 0,0:11:13.79,0:11:15.45,contact,,0,0,0,,Ada lebih daripada yang dapat dilihat
Dialog: 0,0:11:15.54,0:11:18.08,teks umum,,0,0,0,,Dari segi luaran, dia seorang gadis yang manis dan naif
Dialog: 0,0:11:18.17,0:11:20.42,teks umum,,0,0,0,,Tetapi dia jelas menyembunyikan sesuatu
Dialog: 0,0:11:27.17,0:11:29.80,teks umum,,0,0,0,,- Awak minum semuanya\N- Apa? apa yang awak cakap ni?
Dialog: 0,0:11:31.18,0:11:33.56,teks umum,,0,0,0,,Pakcik kamu datang ke sini
Dialog: 0,0:11:33.64,0:11:35.14,teks umum,,0,0,0,,Saya rasa anda sudah ditakdirkan
Dialog: 0,0:11:36.22,0:11:38.77,teks umum,,0,0,0,,- Saya tidak minum apa-apa\N- Tunggu, Yul
Dialog: 0,0:11:38.85,0:11:39.94,teks umum,,0,0,0,,Yul!
Dialog: 0,0:11:42.69,0:11:44.07,teks umum,,0,0,0,,- Mommies\N- Dan Gu
Dialog: 0,0:11:46.15,0:11:47.49,teks umum,,0,0,0,,Saya sudah selesai
Dialog: 0,0:11:49.40,0:11:50.53,teks umum,,0,0,0,,Park Dan Gu
Dialog: 0,0:11:52.49,0:11:53.62,teks umum,,0,0,0,,Adakah itu anda?
Dialog: 0,0:11:54.33,0:11:55.24,teks umum,,0,0,0,,Tidak
Dialog: 0,0:12:00.54,0:12:01.92,teks umum,,0,0,0,,Datang ke sini
Dialog: 0,0:12:02.67,0:12:04.54,teks umum,,0,0,0,,- Dan Gu\N- Ya, pakcik?
Dialog: 0,0:12:14.18,0:12:15.56,teks umum,,0,0,0,,Adakah dia bernafas?
Dialog: 0,0:12:21.60,0:12:22.73,teks umum,,0,0,0,,Bangun
Dialog: 0,0:12:23.52,0:12:25.90,teks umum,,0,0,0,,Anda tidak sedarkan diri, saya fikir anda mungkin mati
Dialog: 0,0:12:32.82,0:12:34.07,teks umum,,0,0,0,,Adakah ia menyakitkan?
Dialog: 0,0:12:35.12,0:12:37.24,teks umum,,0,0,0,,Saya rasa tulang saya patah
Dialog: 0,0:12:37.83,0:12:39.08,teks umum,,0,0,0,,Tiada yang rosak
Dialog: 0,0:12:40.12,0:12:41.71,teks umum,,0,0,0,,- Betul ke?\N- Ya
Dialog: 0,0:12:42.25,0:12:44.63,teks umum,,0,0,0,,Lalu mengapa ia sangat menyakitkan?
Dialog: 0,0:12:44.71,0:12:46.21,teks umum,,0,0,0,,Badan tidak berguna
Dialog: 0,0:12:48.09,0:12:49.21,teks umum,,0,0,0,,Hei
Dialog: 0,0:12:51.30,0:12:53.18,teks umum,,0,0,0,,Kenapa awak kata awak racun saya?
Dialog: 0,0:12:54.30,0:12:56.64,teks umum,,0,0,0,,Jika anda berpura-pura tidak tahu apa-apa,
Dialog: 0,0:12:56.72,0:12:58.47,teks umum,,0,0,0,,anda tidak akan diseksa
Dialog: 0,0:13:00.02,0:13:02.39,teks umum,,0,0,0,,Supaya mereka percaya bahawa anda sedang mati
Dialog: 0,0:13:02.94,0:13:05.52,teks umum,,0,0,0,,Jika tidak mereka tidak akan membuka pintu gerbang anda
Dialog: 0,0:13:06.19,0:13:08.02,teks umum,,0,0,0,,Mari kita buat penawar
Dialog: 0,0:13:09.57,0:13:11.61,teks umum,,0,0,0,,Jadi anda benar-benar mempertaruhkan nyawa anda
Dialog: 0,0:13:14.86,0:13:17.49,teks umum,,0,0,0,,Saya fikir mereka akan memotong lengan atau kaki saya
Dialog: 0,0:13:18.28,0:13:19.95,teks umum,,0,0,0,,Tetapi saya baik-baik saja
Dialog: 0,0:13:20.04,0:13:22.46,teks umum,,0,0,0,,Penduduk Sosnovy Bor terlalu baik
Dialog: 0,0:13:22.54,0:13:24.33,teks umum,,0,0,0,,Jika mereka menyeksa orang seperti itu...
Dialog: 0,0:13:27.34,0:13:28.42,teks umum,,0,0,0,,Dan anda...
Dialog: 0,0:13:29.25,0:13:31.72,teks umum,,0,0,0,,Anda kelihatan agak sakit
Dialog: 0,0:13:32.22,0:13:33.55,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:13:34.80,0:13:37.10,teks umum,,0,0,0,,Jelas sekali, untuk menjaga anda
Dialog: 0,0:13:37.97,0:13:40.18,teks umum,,0,0,0,,Semua pelajar di sini adalah ahli silap mata
Dialog: 0,0:13:40.27,0:13:41.85,teks umum,,0,0,0,,Mereka tidak sepatutnya tahu tentang anda
Dialog: 0,0:13:42.43,0:13:46.02,teks umum,,0,0,0,,Jadi saya menutup pintu sementara tiada siapa yang melihat,
Dialog: 0,0:13:46.10,0:13:49.61,teks am,,0,0,0,,tukar pakaian, sapukan salap pada luka anda
Dialog: 0,0:13:49.69,0:13:52.19,teks umum,,0,0,0,,Malah melakukan urutan ketika anda tidak sedarkan diri
Dialog: 0,0:13:53.45,0:13:55.74,teks umum,,0,0,0,,- Betulkah?\N- Ya
Dialog: 0,0:14:00.16,0:14:03.96,teks umum,,0,0,0,,Anda hanya boleh benarkan saya dekat dengan anda
Dialog: 0,0:14:35.07,0:14:36.32,teks umum,,0,0,0,,Sepanjang hidup saya
Dialog: 0,0:14:37.20,0:14:40.08,teks umum,,0,0,0,,tiada siapa yang memahami betapa terdesaknya saya
Dialog: 0,0:14:42.95,0:14:44.91,teks umum,,0,0,0,,Dan tiada siapa yang mempertaruhkan nyawa mereka untuk saya,
Dialog: 0,0:14:46.08,0:14:47.42,teks umum,,0,0,0,,kecuali anda
Dialog: 0,0:15:00.76,0:15:03.93,teks umum,,0,0,0,,Sejak saya terselamat, seperti yang dijanjikan,
Dialog: 0,0:15:04.02,0:15:06.18,teks umum,,0,0,0,,Saya akan melayan kamu seperti seorang tuan
Dialog: 0,0:15:14.32,0:15:16.74,teks umum,,0,0,0,,Saya sudah menukar 12 master
Dialog: 0,0:15:17.45,0:15:20.74,teks umum,,0,0,0,,Semua orang menyangka bahawa guru telah meninggalkan saya, tetapi saya yang pergi
Dialog: 0,0:15:23.12,0:15:25.87,teks umum,,0,0,0,,Dan kini saya telah menemui seorang guru sejati
Dialog: 0,0:15:26.45,0:15:28.87,teks umum,,0,0,0,,Jadi saya mesti berlutut
Dialog: 0,0:15:28.96,0:15:31.21,teks umum,,0,0,0,,dan bersumpah bahawa saya akan sentiasa melayan kamu seperti seorang guru
Dialog: 0,0:15:33.34,0:15:34.71,teks umum,,0,0,0,,Di bawah satu syarat
Dialog: 0,0:15:37.42,0:15:40.01,teks umum,,0,0,0,,Jangan beritahu sesiapa tentang hubungan kita
Dialog: 0,0:15:41.01,0:15:42.97,teks umum,,0,0,0,,Engkau akan kekal tuanku,
Dialog: 0,0:15:44.26,0:15:46.22,teks umum,,0,0,0,,dan saya adalah hambamu
Dialog: 0,0:15:49.81,0:15:50.90,teks umum,,0,0,0,,Dan juga,
Dialog: 0,0:15:51.65,0:15:55.73,teks umum,,0,0,0,,hubungan tuan-pelajar kami akan kekal sehingga anda menjadi yang terbaik
Dialog: 0,0:15:55.82,0:15:58.19,teks umum,,0,0,0,,dan bantu saya mendapatkan semula tenaga saya
Dialog: 0,0:16:00.28,0:16:01.53,teks umum,,0,0,0,,Sehingga itu
Dialog: 0,0:16:03.03,0:16:05.99,teks umum,,0,0,0,,Apabila saya mendapat semula kuasa saya dan menjadi Nak Su,
Dialog: 0,0:16:08.00,0:16:10.54,teks umum,,0,0,0,,kita tidak akan menjadi tuan dan pelajar
Dialog: 0,0:16:11.58,0:16:13.42,teks umum,,0,0,0,,Kenapa ini?
Dialog: 0,0:16:16.84,0:16:18.09,teks umum,,0,0,0,,Kemudian
Dialog: 0,0:16:19.09,0:16:21.47,teks umum,,0,0,0,,anda tidak perlu melindungi saya lagi,
Dialog: 0,0:16:22.51,0:16:24.35,teks umum,,0,0,0,,dan saya tidak perlu
Dialog: 0,0:16:27.64,0:16:29.06,teks umum,,0,0,0,,lembut dengan anda
Dialog: 0,0:16:38.07,0:16:40.70,teks umum,,0,0,0,,Adakah anda mahu meninggalkan saya apabila semuanya sudah berakhir?
Dialog: 0,0:16:41.36,0:16:42.41,teks umum,,0,0,0,,Faham
Dialog: 0,0:16:45.33,0:16:46.41,teks umum,,0,0,0,,Okey
Dialog: 0,0:16:47.04,0:16:49.87,teks umum,,0,0,0,,Tinggalkan saya apabila anda tidak memerlukan saya lagi
Dialog: 0,0:16:49.95,0:16:52.58,teks umum,,0,0,0,,Maka saya akan menghormati keputusan anda dan melepaskan anda pergi
Dialog: 0,0:16:59.09,0:17:01.55,teks umum,,0,0,0,,Dan sekarang berlutut di hadapan tuan
Dialog: 0,0:17:08.77,0:17:10.10,teks umum,,0,0,0,,Saya, Chan Wook, pelajar anda,
Dialog: 0,0:17:10.81,0:17:13.69,teks umum,,0,0,0,,Saya akan berkhidmat dan melindungi tuan saya Mu Dok
Dialog: 0,0:18:33.39,0:18:35.52,teks umum,,0,0,0,,Anda telah mengembalikan penampilan anda
Dialog: 0,0:18:43.15,0:18:45.40,teks umum,,0,0,0,,Anda tidak akan menjadi liar untuk seketika
Dialog: 0,0:18:45.95,0:18:49.28,teks umum,,0,0,0,,Kalau begitu kita jumpa di istana
Dialog: 0,0:18:58.46,0:19:01.04,teks umum,,0,0,0,,Beri makan kepada penelan jiwa dengan jiwa manusia,
Dialog: 0,0:19:01.13,0:19:03.13,teks umum,,0,0,0,,supaya ia berguna
Dialog: 0,0:19:05.30,0:19:08.22,teks umum,,0,0,0,,Kamu membunuh gisaeng ke dalam tubuhnya Nak Soo melarikan diri
Dialog: 0,0:19:08.30,0:19:10.76,teks umum,,0,0,0,,Ya. Kami membuang mayat di Tasik Gyeongjeongdaeho
Dialog: 0,0:19:10.85,0:19:12.85,teks umum,,0,0,0,,Semak tanda biru?
Dialog: 0,0:19:18.23,0:19:19.77,kenangan,,0,0,0,,Tiada tag
Dialog: 0,0:19:21.15,0:19:22.57,kenangan,,0,0,0,,Ini bukan Nak Soo
Dialog: 0,0:19:24.53,0:19:26.69,teks umum,,0,0,0,,Ya, disemak
Dialog: 0,0:19:26.78,0:19:30.24,teks umum,,0,0,0,,Nak Su yang saya tahu tidak akan kalah dengan awak,
Dialog: 0,0:19:30.91,0:19:33.62,teks umum,,0,0,0,,tetapi nampaknya ia kehilangan kuasanya
Dialog: 0,0:19:34.16,0:19:37.46,teks umum,,0,0,0,,Bolehkah nomad kehilangan kekuatan?
Dialog: 0,0:19:38.58,0:19:39.87,teks umum,,0,0,0,,Jika jiwa yang kuat
Dialog: 0,0:19:39.96,0:19:44.42,teks umum,,0,0,0,, jatuh ke dalam badan yang salah dan tidak dapat mengakses kuasanya
Dialog: 0,0:19:44.50,0:19:46.26,teks umum,,0,0,0,,Pernahkah anda melihat ini sebelum ini?
Dialog: 0,0:19:55.26,0:19:56.43,kenangan,,0,0,0,,Yang Mulia,
Dialog: 0,0:19:56.52,0:19:58.27,kenangan,,0,0,0,,Saya Jin Mu, pelajar Master Chan
Dialog: 0,0:19:58.35,0:20:00.19,kenangan,,0,0,0,,Dengar awak tanya saya
Dialog: 0,0:20:10.57,0:20:11.57,kenangan,,0,0,0,,Jin Mu
Dialog: 0,0:20:12.49,0:20:13.57,kenangan,,0,0,0,,Ya
Dialog: 0,0:20:13.66,0:20:16.79,kenangan,,0,0,0,,Saya bukan raja. Ini saya, Chang Gang
Dialog: 0,0:20:17.50,0:20:20.29,kenangan,,0,0,0,,Jiwa raja kini berada di dalam tubuhku
Dialog: 0,0:20:30.38,0:20:33.01,kenangan,,0,0,0,,Cikgu, adakah itu anda?
Dialog: 0,0:20:33.09,0:20:36.56,kenangan,,0,0,0,,Ya, raja dan saya bertukar badan
Dialog: 0,0:20:37.18,0:20:39.02,kenangan,,0,0,0,,Lalu di manakah Baginda?
Dialog: 0,0:20:39.10,0:20:40.89,kenangan,,0,0,0,,Jiwanya ada dalam badan saya
Dialog: 0,0:20:41.48,0:20:43.56,kenangan,,0,0,0,,Saya perlu mendapatkan semula badan saya
Dialog: 0,0:20:44.15,0:20:46.65,kenangan,,0,0,0,,Tetapi saya tidak boleh menggunakan kuasa saya
Dialog: 0,0:20:46.73,0:20:49.49,kenangan,,0,0,0,,saya perlukan bantuan awak
Dialog: 0,0:20:51.20,0:20:52.28,kenangan,,0,0,0,,Tuan
Dialog: 0,0:20:52.82,0:20:55.74,kenangan,,0,0,0,,Saya tidak tahu bagaimana alkimia jiwa berfungsi
Dialog: 0,0:20:56.58,0:21:00.58,kenangan,,0,0,0,,Pergi ke dewan rahsia Jeonbugwan dan bawa balik Soul Reflector
Dialog: 0,0:21:01.08,0:21:04.21,kenangan,,0,0,0,,Saya akan mengajar anda alkimia jiwa
Dialog: 0,0:21:06.92,0:21:10.01,luar skrin,,0,0,0,,Dia tidak dapat memulihkan kekuatannya kerana badannya yang lemah,
Dialog: 0,0:21:10.09,0:21:12.09,di sebalik tabir,,0,0,0,,jadi saya mendapat peluang
Dialog: 0,0:21:13.55,0:21:15.05,di sebalik tabir,,0,0,0,,Saya bertuah
Dialog: 0,0:21:17.47,0:21:19.47,teks umum,,0,0,0,,Bakar semua mayat ini
Dialog: 0,0:21:38.28,0:21:43.12,teks umum,,0,0,0,,Cari rumah kisaeng tempat wanita yang dibunuh itu bekerja
Dialog: 0,0:21:43.71,0:21:46.13,teks umum,,0,0,0,,Cari pemilik azimat semangat
Dialog: 0,0:21:47.21,0:21:48.71,teks umum,,0,0,0,,Perkara utama tidak dapat dilihat
Dialog: 0,0:21:49.34,0:21:50.38,teks umum,,0,0,0,,Ya
Dialog: 0,0:22:05.14,0:22:06.48,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:22:08.56,0:22:09.57,teks umum,,0,0,0,,Sejuk
Dialog: 0,0:22:10.27,0:22:12.24,teks umum,,0,0,0,,Airnya benar-benar berais
Dialog: 0,0:22:12.32,0:22:15.07,teks umum,,0,0,0,,Sudah tentu, ia sejuk. Kenapa awak duduk di sana?
Dialog: 0,0:22:17.57,0:22:20.08,teks umum,,0,0,0,,Buat pertama kali saya rasa sejuk
Dialog: 0,0:22:20.74,0:22:23.91,teks umum,,0,0,0,,Saya pernah tidak sedarkan diri kerana pintu tenaga ditutup
Dialog: 0,0:22:24.00,0:22:26.21,teks umum,,0,0,0,,Dan sekarang, walaupun saya menggeletar, saya boleh berdiri
Dialog: 0,0:22:26.29,0:22:28.96,teks umum,,0,0,0,,Jadi pintu gerbang saya memang terbuka
Dialog: 0,0:22:29.04,0:22:31.46,teks umum,,0,0,0,,Jika anda menguasai mantera, ia tidak akan sejuk walaupun di atas ais
Dialog: 0,0:22:31.55,0:22:33.01,teks umum,,0,0,0,,Dan api tidak akan menyala
Dialog: 0,0:22:33.71,0:22:35.97,teks umum,,0,0,0,,Apakah keadaan anda sebelum menukar badan?
Dialog: 0,0:22:36.05,0:22:38.47,teks umum,,0,0,0,,Terdapat banyak khabar angin tentang anda
Dialog: 0,0:22:39.26,0:22:40.56,teks umum,,0,0,0,,Tetapi saya tidak pernah melihat awak
Dialog: 0,0:22:40.64,0:22:42.93,teks umum,,0,0,0,,Saya dengar awak kuat
Dialog: 0,0:22:44.35,0:22:48.73,teks umum,,0,0,0,,Bukan sahaja kuat, tetapi sangat kuat
Dialog: 0,0:22:49.40,0:22:51.02,teks umum,,0,0,0,,"Sangat"? saya nampak
Dialog: 0,0:22:51.11,0:22:54.65,teks umum,,0,0,0,,Untuk menjadi ahli silap mata yang terbaik, anda perlu melalui beberapa peringkat
Dialog: 0,0:22:56.74,0:22:59.32,teks umum,,0,0,0,,Pertama kepada Chipsu, keupayaan untuk menggunakan tenaga air
Dialog: 0,0:23:05.16,0:23:08.17,teks umum,,0,0,0,,Langkah kedua - Ryusu, keupayaan untuk mengawal tenaga aliran air
Dialog: 0,0:23:09.75,0:23:11.71,teks umum,,0,0,0,,Kemudian Chisu - kawalan tenaga air
Dialog: 0,0:23:14.09,0:23:15.21,teks umum,,0,0,0,,di atmosfera
Dialog: 0,0:23:15.92,0:23:19.39,teks umum,,0,0,0,,Saya telah menguasai ketiga-tiga peringkat
Dialog: 0,0:23:19.47,0:23:22.14,teks umum,,0,0,0,,Sedikit orang di Deho mampu melakukan ini
Dialog: 0,0:23:22.72,0:23:25.93,teks umum,,0,0,0,,Cikgu, anda memenuhi nama anda
Dialog: 0,0:23:26.68,0:23:27.73,teks umum,,0,0,0,,Ya
Dialog: 0,0:23:28.52,0:23:30.77,teks umum,,0,0,0,,Saya bergerak senyap, seperti bayang-bayang,
Dialog: 0,0:23:31.48,0:23:35.44,teks umum,,0,0,0,,dan kepala musuh saya jatuh ke tanah semasa saya melalui
Dialog: 0,0:23:36.15,0:23:37.70,teks umum,,0,0,0,,Saya Nak Su,
Dialog: 0,0:23:38.95,0:23:40.53,teks umum,,0,0,0,,pahlawan bayangan
Dialog: 0,0:23:53.42,0:23:55.42,teks umum,,0,0,0,,Saya berjalan di atas air seolah-olah saya sedang terbang
Dialog: 0,0:23:56.38,0:23:58.72,teks umum,,0,0,0,,Ke mana saya pergi - angin naik
Dialog: 0,0:24:16.32,0:24:19.86,teks umum,,0,0,0,,Dan saya akan lakukan ini - hujan turun
Dialog: 0,0:24:23.74,0:24:27.45,teks umum,,0,0,0,,Saya Nak Su, ahli silap mata terbaik di dunia,
Dialog: 0,0:24:28.04,0:24:31.04,teks umum,,0,0,0,,yang boleh mencipta salji dan hujan
Dialog: 0,0:24:35.09,0:24:36.42,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:24:38.59,0:24:40.05,teks umum,,0,0,0,,Hanya beberapa pergerakan,
Dialog: 0,0:24:40.88,0:24:43.93,teks umum,,0,0,0,,dan paru-paru saya sedia untuk meletup
Dialog: 0,0:24:48.81,0:24:49.73,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:24:49.81,0:24:51.89,teks umum,,0,0,0,,Kaki saya kejang!
Dialog: 0,0:24:51.98,0:24:52.94,teks umum,,0,0,0,,Kejang?
Dialog: 0,0:24:53.02,0:24:56.23,teks umum,,0,0,0,,Kaki ini pendek, kurus, lemah dan tidak tahan sejuk
Dialog: 0,0:24:57.02,0:24:58.86,teks umum,,0,0,0,,Badan tidak berguna
Dialog: 0,0:25:00.90,0:25:04.74,teks umum,,0,0,0,,Berhati-hati. Anda bukan lagi Nak Soo, pahlawan bayangan.
Dialog: 0,0:25:04.82,0:25:06.87,teks umum,,0,0,0,,Awak Mu Dok, pembantu rumah saya
Dialog: 0,0:25:06.95,0:25:10.08,teks umum,,0,0,0,,Jangan melompat-lompat seperti anda sekarang
Dialog: 0,0:25:10.75,0:25:11.75,teks umum,,0,0,0,,Anda akan terluka
Dialog: 0,0:25:13.12,0:25:14.67,teks umum,,0,0,0,,Saya rasa seperti tidak penting
Dialog: 0,0:25:18.63,0:25:20.76,teks umum,,0,0,0,,Jangan bersedih. Awak ada saya
Dialog: 0,0:25:20.84,0:25:23.80,teks umum,,0,0,0,,Mari mulakan latihan, pintu gerbang saya terbuka
Dialog: 0,0:25:23.88,0:25:26.14,teks umum,,0,0,0,,Tetapi pertama, pakai kasut anda. Ia sejuk
Dialog: 0,0:25:41.28,0:25:42.65,teks umum,,0,0,0,,Untuk apa?
Dialog: 0,0:25:43.24,0:25:44.53,teks umum,,0,0,0,,Tiada ketangkasan
Dialog: 0,0:25:45.91,0:25:46.74,teks umum,,0,0,0,,Pilih
Dialog: 0,0:25:50.16,0:25:51.29,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:25:52.29,0:25:55.71,teks umum,,0,0,0,,Mari kita lihat betapa baiknya pelajar saya, maka saya akan melupakan kesedihan
Dialog: 0,0:25:55.79,0:25:56.96,teks umum,,0,0,0,,Apa?
Dialog: 0,0:26:10.35,0:26:11.64,teks umum,,0,0,0,,Kenapa pukul?
Dialog: 0,0:26:11.72,0:26:13.73,teks umum,,0,0,0,,Anda tidak menggunakan pedang
Dialog: 0,0:26:14.23,0:26:15.31,teks umum,,0,0,0,,Tunjukkan saya cara anda berlawan
Dialog: 0,0:26:31.66,0:26:32.66,teks umum,,0,0,0,,Ini adalah yang kecil...
Dialog: 0,0:26:33.25,0:26:34.29,teks umum,,0,0,0,,Sakit!
Dialog: 0,0:26:46.80,0:26:48.34,teks umum,,0,0,0,,Kamu bergaduh teruk juga
Dialog: 0,0:26:50.05,0:26:52.56,teks umum,,0,0,0,,Anda lebih teruk daripada yang saya sangka
Dialog: 0,0:26:52.64,0:26:55.48,teks umum,,0,0,0,,Saya tidak pernah belajar!
Dialog: 0,0:26:59.65,0:27:01.61,teks umum,,0,0,0,,Anda mempunyai 12 guru
Dialog: 0,0:27:02.23,0:27:04.69,teks umum,,0,0,0,,Anda belum belajar cara membaca mantera,
Dialog: 0,0:27:04.78,0:27:08.16,teks umum,,0,0,0,,tetapi boleh menguasai seni mempertahankan diri
Dialog: 0,0:27:08.24,0:27:10.41,teks umum,,0,0,0,,Saya tidak mempunyai mood untuk itu
Dialog: 0,0:27:10.49,0:27:11.49,teks umum,,0,0,0,,Seperti yang anda tahu,
Dialog: 0,0:27:11.58,0:27:13.83,teks umum,,0,0,0,,Saya perlu menyesuaikan diri untuk melakukan sesuatu
Dialog: 0,0:27:14.66,0:27:15.83,teks umum,,0,0,0,,Anda hanya malas
Dialog: 0,0:27:16.33,0:27:20.08,teks umum,,0,0,0,,Saya perasan anda tidak melakukan apa-apa di rumah
Dialog: 0,0:27:20.17,0:27:22.29,teks umum,,0,0,0,,Ya, saya mempelajari segala-galanya dengan hati. Semak
Dialog: 0,0:27:22.38,0:27:24.00,teks umum,,0,0,0,,Adakah anda fikir saya mengenali anda?
Dialog: 0,0:27:24.09,0:27:26.59,teks umum,,0,0,0,,Saya menyedari bahawa anda menggunakan gaya Tansu
Dialog: 0,0:27:27.09,0:27:28.34,teks umum,,0,0,0,,Hanya sembang
Dialog: 0,0:27:28.43,0:27:29.93,teks umum,,0,0,0,,Saya boleh melakukan lebih daripada sekadar berbual
Dialog: 0,0:27:32.76,0:27:34.64,teks umum,,0,0,0,, Pernahkah anda melihatnya?
Dialog: 0,0:27:34.72,0:27:36.35,teks umum,,0,0,0,,Saya seorang yang cepat belajar
Dialog: 0,0:27:36.43,0:27:39.31,teks umum,,0,0,0,,Saya akan cepat menguasai Chipsa. Berapa lama masa yang diambil?
Dialog: 0,0:27:39.40,0:27:41.52,teks umum,,0,0,0,,Saya juga belajar dengan cepat, tetapi saya mengambil masa lima tahun
Dialog: 0,0:27:41.61,0:27:43.40,teks umum,,0,0,0,,Dan untuk yang lain - 20 tahun
Dialog: 0,0:27:43.48,0:27:44.61,teks umum,,0,0,0,,Dan anda...
Dialog: 0,0:27:46.15,0:27:48.11,teks umum,,0,0,0,,Mungkin anda akan menguasainya dengan lebih cepat,
Dialog: 0,0:27:48.78,0:27:50.16,teks umum,,0,0,0,,memandangkan kamu adalah anak kepada Chang Gang
Dialog: 0,0:27:51.20,0:27:53.12,teks umum,,0,0,0,,Di sebelah mana dia di sini?
Dialog: 0,0:27:53.20,0:27:56.08,teks umum,,0,0,0,,Dia seorang genius yang menguasai Cip dalam masa setahun
Dialog: 0,0:27:56.79,0:27:58.08,teks umum,,0,0,0,,Anda akan menguasai Cip dalam masa setahun,
Dialog: 0,0:27:58.16,0:28:00.75,teks umum,,0,0,0,, khabar angin bahawa anda bukan anaknya akan reda
Dialog: 0,0:28:00.83,0:28:02.96,teks umum,,0,0,0,,Tetapi, sudah tentu, ini hampir tidak mungkin
Dialog: 0,0:28:03.46,0:28:05.63,teks umum,,0,0,0,,Jika dia mengambil masa setahun, saya akan menguasainya dalam masa enam bulan
Dialog: 0,0:28:05.71,0:28:07.59,teks umum,,0,0,0,,Tidak, dalam masa tiga bulan
Dialog: 0,0:28:08.17,0:28:09.01,teks umum,,0,0,0,,Bercakap lagi
Dialog: 0,0:28:09.09,0:28:12.01,teks umum,,0,0,0,,Saya berazam, jangan tumbangkan saya
Dialog: 0,0:28:15.93,0:28:18.18,teks umum,,0,0,0,,Maid Kim menyuruh saya menyapu seluruh halaman
Dialog: 0,0:28:18.68,0:28:20.19,teks umum,,0,0,0,,Anda telah menjadi lebih baik,
Dialog: 0,0:28:20.27,0:28:23.19,teks umum,,0,0,0,,dan anda berjaya, jadi bantu saya
Dialog: 0,0:28:26.15,0:28:27.03,teks umum,,0,0,0,,Apa...
Dialog: 0,0:28:28.82,0:28:30.11,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:28:30.20,0:28:34.58,teks umum,,0,0,0,,Saya seorang pemalas yang tidak melakukan apa-apa tanpa sikap yang sesuai
Dialog: 0,0:28:36.45,0:28:37.58,teks umum,,0,0,0,,Semoga berjaya
Dialog: 0,0:28:38.83,0:28:39.91,teks umum,,0,0,0,,Bajingan...
Dialog: 0,0:28:40.00,0:28:42.08,teks umum,,0,0,0,,- Wah...\N- Sangat bagus
Dialog: 0,0:28:42.17,0:28:44.50,teks umum,,0,0,0,,Malas yang tak guna!
Dialog: 0,0:28:44.59,0:28:47.80,teks umum,,0,0,0,,Sangat sejuk, malah sejuk
Dialog: 0,0:28:52.13,0:28:57.06,contact,,0,0,0,,Master Ho buat ubat untuk Uka
Dialog: 0,0:28:57.60,0:28:59.18,teks umum,,0,0,0,,Nampaknya ia sangat berkesan
Dialog: 0,0:28:59.27,0:29:03.06,teks umum,,0,0,0,,Terutama apabila pintu pagarnya terbuka
Dialog: 0,0:29:04.19,0:29:08.40,teks umum,,0,0,0,,Hamba Kim, awak nampaknya sangat gembira
Dialog: 0,0:29:09.94,0:29:13.28,teks umum,,0,0,0,,Adakah anda sangat kecewa sehingga pintu pagarnya terbuka?
Dialog: 0,0:29:15.12,0:29:18.24,teks umum,,0,0,0,,Anda tidak melakukan apa-apa, walaupun ketika dia hampir mati
Dialog: 0,0:29:19.33,0:29:23.12,teks umum,,0,0,0,,Jika bukan kerana Cikgu Huo, tuan muda itu boleh mati
Dialog: 0,0:29:23.21,0:29:27.04,teks umum,,0,0,0,,Dia terpaksa mencari jalan untuk menyelamatkannya tanpa membuka pintu pagar
Dialog: 0,0:29:27.13,0:29:28.38,teks umum,,0,0,0,,Betapa bahayanya anda
Dialog: 0,0:29:29.17,0:29:32.05,teks umum,,0,0,0,,Anda sentiasa menjaga jarak dengan tuan muda
Dialog: 0,0:29:32.13,0:29:33.13,teks umum,,0,0,0,,Ini...
Dialog: 0,0:29:34.22,0:29:35.47,teks umum,,0,0,0,,kerana khabar angin?
Dialog: 0,0:29:41.43,0:29:43.39,teks umum,,0,0,0,, Khabar angin apa?
Dialog: 0,0:29:43.48,0:29:44.73,teks umum,,0,0,0,,Jangan pura-pura tidak tahu
Dialog: 0,0:29:45.52,0:29:47.52,teks umum,,0,0,0,,Anda tahu bahawa terdapat khabar angin,
Dialog: 0,0:29:47.61,0:29:50.90,teks umum,,0,0,0,,bahawa anda adalah bapa kepada Encik Chan
Dialog: 0,0:29:52.36,0:29:54.95,teks umum,,0,0,0,,Jangan berani sebut
Dialog: 0,0:29:56.74,0:29:58.78,teks umum,,0,0,0,,khabar angin yang tidak masuk akal!
Dialog: 0,0:29:59.70,0:30:01.50,teks umum,,0,0,0,,Mereka tidak begitu mengarut
Dialog: 0,0:30:01.58,0:30:04.71,teks umum,,0,0,0,,Jujurlah, kita berdua tahu
Dialog: 0,0:30:04.79,0:30:07.63,teks umum,,0,0,0,,bahawa anda menyayangi Puan Do Hwa sebelum perkahwinannya
Dialog: 0,0:30:08.21,0:30:11.92,teks umum,,0,0,0,,Anda menulis puisinya dan memberinya hadiah
Dialog: 0,0:30:12.01,0:30:13.17,teks umum,,0,0,0,,Saya saksi hidup
Dialog: 0,0:30:13.92,0:30:17.22,teks umum,,0,0,0,,Mereka mengatakan bahawa anda masih belum berkahwin kerana anda tidak melupakannya
Dialog: 0,0:30:18.10,0:30:19.56,teks umum,,0,0,0,,Bagaimana dengan awak, pembantu rumah Kim?
Dialog: 0,0:30:20.22,0:30:22.93,teks umum,,0,0,0,,Adakah anda masih jatuh cinta dengan Chang Gang?
Dialog: 0,0:30:23.52,0:30:27.23,teks umum,,0,0,0,,Sebab itu kamu tidak berkahwin dan tinggal di rumahnya?
Dialog: 0,0:30:27.86,0:30:28.69,teks umum,,0,0,0,,Apa?
Dialog: 0,0:30:28.77,0:30:32.74,teks umum,,0,0,0,,Saya tahu betapa awak menyukainya
Dialog: 0,0:30:34.07,0:30:36.11,teks umum,,0,0,0,,Apabila dia memberitahu anda dia suka jeli acorn,
Dialog: 0,0:30:36.20,0:30:37.95,teks umum,,0,0,0,,anda naik ke puncak gunung, seperti tupai,
Dialog: 0,0:30:38.03,0:30:39.95,teks umum,,0,0,0,,- untuk mengumpul acorn\N- Tupai?
Dialog: 0,0:30:40.03,0:30:42.41,teks umum,,0,0,0,,Saya nampak awak sedang mengumpul acorn
Dialog: 0,0:30:46.54,0:30:47.54,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:30:48.58,0:30:52.84,teks umum,,0,0,0,,Adakah anda ketawa dengan fakta bahawa saya pergi mengumpul biji ek?
Dialog: 0,0:30:55.13,0:30:56.30,teks umum,,0,0,0,,Ya!
Dialog: 0,0:30:56.93,0:30:59.43,teks umum,,0,0,0,,Saya mengakui bahawa saya pergi untuk mengambilnya
Dialog: 0,0:31:00.01,0:31:03.85,teks umum,,0,0,0,,Saya boleh meluahkan perasaan saya hanya dengan menyediakan jeli ini
Dialog: 0,0:31:04.73,0:31:07.06,teks umum,,0,0,0,,Anda boleh ketawakan saya sesuka hati
Dialog: 0,0:31:14.40,0:31:15.49,teks umum,,0,0,0,,Saya tidak ketawa
Dialog: 0,0:31:17.45,0:31:19.62,teks umum,,0,0,0,,Apabila saya melihat awak membuat jeli ini,
Dialog: 0,0:31:21.53,0:31:22.83,teks umum,,0,0,0,,Saya berasa sedih
Dialog: 0,0:31:25.37,0:31:27.08,contact,,0,0,0,,Saya tahu bagaimana rasanya,
Dialog: 0,0:31:27.71,0:31:30.79,italic,,0,0,0,,apabila anda tidak boleh berbuat apa-apa
Dialog: 0,0:31:31.54,0:31:32.80,teks umum,,0,0,0,,untuk orang yang anda sayang
Dialog: 0,0:31:35.17,0:31:36.30,teks umum,,0,0,0,,Lain-lain
Dialog: 0,0:31:36.97,0:31:39.55,teks umum,,0,0,0,,mereka boleh memfitnah kita di belakang kita
Dialog: 0,0:31:40.22,0:31:43.64,teks umum,,0,0,0,,Tetapi jangan kita lakukan ini antara satu sama lain
Dialog: 0,0:31:46.23,0:31:49.56,teks umum,,0,0,0,,Jelas sekali bahawa cinta yang kami rasai
Dialog: 0,0:31:50.81,0:31:53.40,contact,,0,0,0,,masa kita masih muda,
Dialog: 0,0:31:54.98,0:31:56.90,teks umum,,0,0,0,,akhirnya meninggalkan parut di hati kita
Dialog: 0,0:32:01.87,0:32:05.29,teks umum,,0,0,0,,Saya gelisah kerana Encik Chan
Dialog: 0,0:32:06.16,0:32:08.25,teks umum,,0,0,0,,dan terlalu banyak cakap
Dialog: 0,0:32:08.33,0:32:09.62,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:32:11.08,0:32:13.92,teks umum,,0,0,0,,Saya sangat risau tentang Uka
Dialog: 0,0:32:14.00,0:32:17.67,teks umum,,0,0,0,,Saya cuma takut dengan membuka pintu tenaga,
Dialog: 0,0:32:18.67,0:32:22.30,teks umum,,0,0,0,,kita boleh memecahkan halangan yang melindunginya
Dialog: 0,0:32:22.39,0:32:24.47,contact,,0,0,0,,Saya rasa tidak senang tentang perkara ini
Dialog: 0,0:32:25.56,0:32:27.98,teks umum,,0,0,0,,Saya mungkin terpaksa menahan kehendaknya
Dialog: 0,0:32:29.81,0:32:32.44,teks umum,,0,0,0,,dan berhenti pada masa hadapan
Dialog: 0,0:32:34.90,0:32:37.28,teks umum,,0,0,0,,Saya meminta anda untuk tidak menghina saya untuk ini
Dialog: 0,0:32:39.70,0:32:40.99,teks umum,,0,0,0,,Mari kita lihat bagaimana semuanya berubah
Dialog: 0,0:32:48.87,0:32:51.58,teks umum,,0,0,0,,Tuan, ini teh ginseng liar
Dialog: 0,0:32:52.17,0:32:53.46,contact,,0,0,0,,Minumlah
Dialog: 0,0:32:53.54,0:32:54.67,teks umum,,0,0,0,,Ginseng liar?
Dialog: 0,0:32:55.29,0:32:57.00,teks umum,,0,0,0,,Saya akan minum apabila saya kembali. Tinggalkan di sini
Dialog: 0,0:32:57.09,0:32:58.26,teks umum,,0,0,0,,Awak lagi
Dialog: 0,0:32:58.84,0:33:00.42,teks umum,,0,0,0,, adakah anda mahu memberikannya kepada Moo Deok?
Dialog: 0,0:33:01.01,0:33:03.64,teks umum,,0,0,0,,Sejuk di luar. Dia berhak mendapat sesuatu yang hangat dan baik
Dialog: 0,0:33:04.47,0:33:07.01,teks umum,,0,0,0,,Kenapa awak suruh dia menyapu halaman dalam cuaca sejuk begini?
Dialog: 0,0:33:08.35,0:33:09.39,teks umum,,0,0,0,,Dengar
Dialog: 0,0:33:10.31,0:33:12.60,teks umum,,0,0,0,,Pembantu rumah ini disembuhkan secara percuma
Dialog: 0,0:33:12.69,0:33:14.61,teks umum,,0,0,0,,Jadi saya meminta dia melakukan sekurang-kurangnya sesuatu sebagai tindak balas
Dialog: 0,0:33:14.69,0:33:17.48,teks umum,,0,0,0,,Kenapa dia? Tidak bolehkah anda melakukannya sendiri?
Dialog: 0,0:33:18.65,0:33:21.53,teks am,,0,0,0,,Saya perlu membancuh ubat untuk awak, memasak makan malam
Dialog: 0,0:33:21.61,0:33:22.74,teks umum,,0,0,0,,dan jaga awak
Dialog: 0,0:33:22.82,0:33:25.28,teks umum,,0,0,0,,Moo Dok akan menjaga saya. Anda tidak perlu risau
Dialog: 0,0:33:28.45,0:33:29.70,condong,,0,0,0,,Jelas
Dialog: 0,0:33:29.79,0:33:32.00,teks umum,,0,0,0,,Anda hanya bimbang tentang Moo Deok
Dialog: 0,0:33:33.50,0:33:35.08,teks umum,,0,0,0,,Sejak saya menjadi tidak berguna,
Dialog: 0,0:33:35.17,0:33:38.92,teks umum,,0,0,0,,Saya akan pergi menyapu halaman seperti Moo Deok
Dialog: 0,0:33:41.76,0:33:46.39,teks umum,,0,0,0,,Saya rasa saya sudah terlalu banyak memberi anda
Dialog: 0,0:33:46.47,0:33:49.56,teks umum,,0,0,0,,Berapa lama anda membancuh ginseng liar ini?
Dialog: 0,0:33:49.64,0:33:51.52,teks umum,,0,0,0,,Saya memasaknya sepanjang hari
Dialog: 0,0:33:51.60,0:33:54.14,teks umum,,0,0,0,,Itulah yang saya bincangkan. Anda tidak dapat menutup mata anda
Dialog: 0,0:33:54.23,0:33:56.90,teks umum,,0,0,0,,Apa yang anda rasa ini membuatkan saya rasa?
Dialog: 0,0:33:58.11,0:33:59.94,teks umum,,0,0,0,,- Tidak bagus\N- Betul
Dialog: 0,0:34:00.03,0:34:03.45,teks umum,,0,0,0,,Saya tahu awak telah melalui banyak perkara kerana saya
Dialog: 0,0:34:04.82,0:34:08.91,teks umum,,0,0,0,,Dan dia kelihatan letih. Anda pernah mempunyai kulit porselin
Dialog: 0,0:34:09.58,0:34:11.70,miring,,0,0,0,,Anda harus minum teh ginseng liar
Dialog: 0,0:34:11.79,0:34:15.04,teks umum,,0,0,0,,Mungkin kemudian anda boleh berhenti menghadapi masalah?
Dialog: 0,0:34:15.12,0:34:16.96,teks umum,,0,0,0,,Saya tidak tahu apa yang hendak diberitahu kepada kepala
Dialog: 0,0:34:17.54,0:34:18.96,teks umum,,0,0,0,,Saya akan terima hukumannya
Dialog: 0,0:34:19.55,0:34:22.88,teks umum,,0,0,0,,Sekarang pintu pagar saya terbuka, bermakna saya akan menjadi sebahagian daripada Sosnovy Bor
Dialog: 0,0:34:25.63,0:34:29.10,teks umum,,0,0,0,,Adakah anda sangat gembira kerana pintu pagar terbuka?
Dialog: 0,0:34:29.72,0:34:31.35,teks umum,,0,0,0,,Ya, sangat
Dialog: 0,0:34:32.10,0:34:35.14,teks umum,,0,0,0,,Apabila saya memasuki Sosnovy Bor dan menjadi lebih baik Julia dan Dan Gu,
Dialog: 0,0:34:35.23,0:34:37.65,teks umum,,0,0,0,,mereka akan menyesal kerana tidak menerima saya lebih awal
Dialog: 0,0:34:41.65,0:34:43.53,teks am,,0,0,0,,Maiden Kim, awak boleh makan ginseng ini
Dialog: 0,0:34:44.28,0:34:46.61,teks umum,,0,0,0,,Terima kasih atas ginseng, saya sangat menghargainya
Dialog: 0,0:35:01.84,0:35:04.72,teks umum,,0,0,0,,Anda mesti hamba yang jahat itu
Dialog: 0,0:35:04.80,0:35:06.76,teks umum,,0,0,0,,Apa yang kamu lakukan? Kami memberi anda ubat
Dialog: 0,0:35:06.84,0:35:08.01,teks umum,,0,0,0,,Anda boleh dijangkiti penyakit
Dialog: 0,0:35:08.09,0:35:10.80,teks umum,,0,0,0,,Saya telah sembuh secara percuma,
Dialog: 0,0:35:10.89,0:35:13.43,teks umum,,0,0,0,,jadi mereka berkata bahawa saya harus berusaha untuk menunjukkan rasa terima kasih saya
Dialog: 0,0:35:13.52,0:35:15.56,teks umum,,0,0,0,,Maiden Kim ialah seorang wanita yang bijak
Dialog: 0,0:35:16.06,0:35:19.15,teks am,,0,0,0,,Sapu halaman, kemudian bawa baja ke taman herba
Dialog: 0,0:35:20.02,0:35:21.02,teks umum,,0,0,0,,Ya
Dialog: 0,0:35:22.32,0:35:23.57,suara,,0,0,0,,Tunggu, Ho Yeom
Dialog: 0,0:35:23.65,0:35:26.03,suara,,0,0,0,,Sekarang saya sedang menyapu halaman rumah anda,
Dialog: 0,0:35:26.11,0:35:27.99,luar skrin,,0,0,0,,tetapi satu hari nanti saya akan singkirkan Saejukwon
Dialog: 0,0:35:31.49,0:35:33.54,contact,,0,0,0,,Hei! Perhatikan tempat yang anda tuju
Dialog: 0,0:35:33.62,0:35:35.25,teks umum,,0,0,0,,Adakah anda melakukan ini dengan sengaja?
Dialog: 0,0:35:35.87,0:35:36.75,teks umum,,0,0,0,,Tidak
Dialog: 0,0:35:36.83,0:35:38.71,teks umum,,0,0,0,,Dan saya rasa begitu
Dialog: 0,0:35:38.79,0:35:39.96,teks umum,,0,0,0,,Beraninya saya
Dialog: 0,0:35:44.00,0:35:45.80,teks umum,,0,0,0,,Anda sangat pelik
Dialog: 0,0:35:46.59,0:35:47.84,condong,,0,0,0,,Telinga ini...
Dialog: 0,0:35:47.92,0:35:50.80,teks umum,,0,0,0,,Saya pernah melihatnya sebelum ini
Dialog: 0,0:35:53.31,0:35:56.81,teks umum,,0,0,0,,Adakah saya tidak melayan kamu pada masa lalu?
Dialog: 0,0:35:58.39,0:36:01.48,teks umum,,0,0,0,,Di manakah saya boleh mendapatkan wang untuk rawatan di Sejukwon?
Dialog: 0,0:36:04.32,0:36:07.49,teks umum,,0,0,0,,Telinga ini kelihatan biasa
Dialog: 0,0:36:12.78,0:36:14.41,teks umum,,0,0,0,,Sapu dengan teliti
Dialog: 0,0:36:17.58,0:36:18.91,teks umum,,0,0,0,,Dia hampir tercabut telinga saya
Dialog: 0,0:36:19.75,0:36:21.29,italic,,0,0,0,,Saya tahu awak sedang sakit, tapi bersabarlah
Dialog: 0,0:36:21.38,0:36:24.71,teks umum,,0,0,0,,Dia marah kepada Encik Chan, jadi dia meluahkannya kepada anda
Dialog: 0,0:36:24.80,0:36:28.92,teks umum,,0,0,0,,Membuli yang lemah adalah perkara biasa, begitulah cara dunia berfungsi
Dialog: 0,0:36:29.01,0:36:31.05,teks umum,,0,0,0,,Saya hanya diam
Dialog: 0,0:36:31.13,0:36:33.18,teks umum,,0,0,0,,Cuba jangan benci dia
Dialog: 0,0:36:33.26,0:36:35.14,teks umum,,0,0,0,,Dia memberikan aliran tenaga yang menelan belanja selama sepuluh tahun,
Dialog: 0,0:36:35.22,0:36:37.18,teks umum,,0,0,0,,untuk membantu tuan muda pulih lebih cepat
Dialog: 0,0:36:37.93,0:36:39.81,miring,,0,0,0,,Rehat apabila anda selesai
Dialog: 0,0:36:43.69,0:36:45.73,teks umum,,0,0,0,, Aliran tenaga selama sepuluh tahun?
Dialog: 0,0:36:57.37,0:36:59.00,teks umum,,0,0,0,,Apa yang menyebabkan anda terlalu lama?
Dialog: 0,0:36:59.08,0:37:01.21,teks umum,,0,0,0,,Ayuh, ini ginseng liar...
Dialog: 0,0:37:02.12,0:37:03.21,teks umum,,0,0,0,,Apa itu, Mu Dok?
Dialog: 0,0:37:03.29,0:37:05.00,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:37:05.88,0:37:07.05,teks umum,,0,0,0,,Diam
Dialog: 0,0:37:07.92,0:37:09.92,teks umum,,0,0,0,,Saya tidak membawa anda ke sini untuk ini
Dialog: 0,0:37:10.01,0:37:12.26,teks umum,,0,0,0,,Moo Dok, ini salah. Saya pelajar awak, hentikan
Dialog: 0,0:37:14.64,0:37:15.85,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:37:20.89,0:37:22.39,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:37:22.48,0:37:23.81,teks umum,,0,0,0,,Menyemak teras tenaga anda
Dialog: 0,0:37:25.90,0:37:27.02,teks umum,,0,0,0,,Bernafas dengan mudah
Dialog: 0,0:37:43.96,0:37:45.21,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:37:46.96,0:37:48.25,teks umum,,0,0,0,,Sebenarnya
Dialog: 0,0:37:49.50,0:37:51.01,teks umum,,0,0,0,,Anda benar-benar istimewa
Dialog: 0,0:37:51.67,0:37:52.88,teks umum,,0,0,0,,Hentikan
Dialog: 0,0:37:53.51,0:37:55.39,teks umum,,0,0,0,,Apa yang ada dalam diri saya?
Dialog: 0,0:37:55.47,0:37:56.93,teks umum,,0,0,0,,Aliran tenaga yang luar biasa
Dialog: 0,0:37:57.60,0:37:59.89,teks umum,,0,0,0,,Ho Yeom memberikan tenaga kepada anda
Dialog: 0,0:38:01.85,0:38:03.23,teks umum,,0,0,0,, Tenaga?
Dialog: 0,0:38:11.57,0:38:14.15,teks umum,,0,0,0,,Nampaknya Uk sudah pulih
Dialog: 0,0:38:14.24,0:38:16.87,teks umum,,0,0,0,,Sudah tiba masanya untuk mengekstrak tenaga yang anda masukkan ke dalamnya
Dialog: 0,0:38:16.95,0:38:20.04,teks umum,,0,0,0,,Jika semuanya salah, dia mungkin hilang akal
Dialog: 0,0:38:20.74,0:38:23.58,teks umum,,0,0,0,,UK tidak akan dapat menggunakannya
Dialog: 0,0:38:24.46,0:38:26.63,teks umum,,0,0,0,,Pintu tenaganya baru sahaja dibuka
Dialog: 0,0:38:26.71,0:38:29.13,teks umum,,0,0,0,,Pada dasarnya, dia tidak boleh berbuat apa-apa
Dialog: 0,0:38:29.21,0:38:30.59,teks umum,,0,0,0,,Anda bimbang sia-sia
Dialog: 0,0:38:31.25,0:38:35.72,teks umum,,0,0,0,,Kemungkinan besar dia tidak tahu bahawa ada sesuatu yang luar biasa dalam dirinya
Dialog: 0,0:38:38.68,0:38:40.76,contact,,0,0,0,,Jom curi tenaga Ho Yeom
Dialog: 0,0:38:42.85,0:38:46.31,teks umum,,0,0,0,,Inti tenaga anda dipenuhi dengan tenaga yang Ho Yeom berikan kepada anda
Dialog: 0,0:38:47.27,0:38:49.36,teks umum,,0,0,0,,Kini anda cukup kuat untuk menggunakan Chipsa dengan mudah
Dialog: 0,0:38:49.44,0:38:52.19,teks umum,,0,0,0,,Saya tidak tahu bahawa ada sesuatu yang sangat berharga dalam diri saya
Dialog: 0,0:38:52.28,0:38:55.57,teks umum,,0,0,0,,Ia mengambil masa sepuluh tahun untuk mengumpul tenaga sedemikian, dan anda mendapatnya secara percuma
Dialog: 0,0:38:55.65,0:38:57.86,teks umum,,0,0,0,,Selain itu, ini adalah tenaga Ho Yeom, anda tidak boleh meminta sesuatu yang lebih baik
Dialog: 0,0:38:58.74,0:39:00.12,teks umum,,0,0,0,,Bodoh bertuah
Dialog: 0,0:39:00.20,0:39:04.45,teks umum,,0,0,0,,Saya fikir orang tua itu benci saya. Saya terkejut dia memberikannya kepada saya
Dialog: 0,0:39:04.54,0:39:07.54,teks umum,,0,0,0,,Dia memberikannya kepada anda untuk membantu anda pulih
Dialog: 0,0:39:07.62,0:39:08.88,teks umum,,0,0,0,,Dia akan mengambilnya tidak lama lagi
Dialog: 0,0:39:08.96,0:39:12.34,teks umum,,0,0,0,,Dia tidak boleh berbuat demikian. Apa yang ada dalam perut saya adalah milik saya
Dialog: 0,0:39:12.42,0:39:14.51,teks umum,,0,0,0,,Jika anda tidak mempunyai kekuatan untuk mengawalnya,
Dialog: 0,0:39:14.59,0:39:17.47,teks umum,,0,0,0,,kekuatan anda tidak akan ada dan dia akan mengambilnya
Dialog: 0,0:39:17.55,0:39:20.18,teks umum,,0,0,0,,Saya mesti belajar mengawal tenaga untuk menyimpannya untuk diri saya sendiri
Dialog: 0,0:39:20.26,0:39:23.27,teks umum,,0,0,0,,Jadi saya perlu bernafas sebagai sumber tenaga
Dialog: 0,0:39:24.06,0:39:27.10,teks umum,,0,0,0,,Saya rasa 12 guru ini mengajar anda sekurang-kurangnya sesuatu
Dialog: 0,0:39:28.19,0:39:29.27,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:39:30.56,0:39:33.57,contact,,0,0,0,,Tenaga daripada teras dikawal oleh pernafasan,
Dialog: 0,0:39:33.65,0:39:35.86,miring,,0,0,0,,namun, semua ahli silap mata bernafas secara berbeza
Dialog: 0,0:39:35.94,0:39:39.61,miring,,0,0,0,,Semua orang menyedut dan menghembus jumlah udara yang berbeza
Dialog: 0,0:39:40.74,0:39:44.49,teks umum,,0,0,0,,Ini adalah tenaga Ho Yeom, jadi anda perlu mengawalnya dengan pernafasannya
Dialog: 0,0:39:45.41,0:39:47.37,teks umum,,0,0,0,,Saya ragu bahawa dia akan mengajar saya
Dialog: 0,0:39:47.46,0:39:50.58,teks umum,,0,0,0,,Mungkin kita patut mencuba segala-galanya? Ia hanya bernafas
Dialog: 0,0:39:51.33,0:39:54.71,teks umum,,0,0,0,,Jika anda menggunakan nafas seseorang, anda boleh hilang kawalan dan menjadi gila
Dialog: 0,0:39:55.46,0:39:59.63,teks umum,,0,0,0,,Darah akan tumpah dari semua bahagian badan anda, dan anda akan mati
Dialog: 0,0:39:59.72,0:40:01.01,teks umum,,0,0,0,,Nah, boleh kita cuba?
Dialog: 0,0:40:02.22,0:40:03.05,teks umum,,0,0,0,,Tidak
Dialog: 0,0:40:03.81,0:40:06.27,teks umum,,0,0,0,,Anda akan melampau
Dialog: 0,0:40:07.14,0:40:10.31,teks umum,,0,0,0,,Cikgu, wujudkan cara yang akan membuatkan saya terus hidup dan membolehkan saya mengawal tenaga
Dialog: 0,0:40:11.56,0:40:15.98,teks umum,,0,0,0,,Teknik asas pernafasan diturunkan dari generasi ke generasi
Dialog: 0,0:40:16.07,0:40:17.99,contact,,0,0,0,,Ho Yeom daripada keluarga So
Dialog: 0,0:40:18.07,0:40:21.20,teks umum,,0,0,0,,Jadi, mana-mana ahli keluarga So akan menggunakan teknik yang sama
Dialog: 0,0:40:24.53,0:40:25.70,teks umum,,0,0,0,,- So Yul\N- So Yul
Dialog: 0,0:40:34.29,0:40:36.50,teks umum,,0,0,0,,Pergi tanya dia. Awak kata awak dekat
Dialog: 0,0:40:36.59,0:40:38.13,teks umum,,0,0,0,,Yul berhati-hati
Dialog: 0,0:40:38.72,0:40:42.01,teks umum,,0,0,0,,Kalau saya tanya, dia akan faham semuanya dan beritahu Ho Yeom
Dialog: 0,0:40:43.76,0:40:45.18,teks umum,,0,0,0,,Hanya sepuluh nafas...
Dialog: 0,0:40:45.26,0:40:47.97,teks umum,,0,0,0,,Tidak, tujuh sudah memadai
Dialog: 0,0:40:48.06,0:40:50.89,teks umum,,0,0,0,,Saya boleh faham dengan meletakkan tangan saya pada teras tenaganya
Dialog: 0,0:40:51.69,0:40:53.86,teks umum,,0,0,0,,Dia akan patahkan lengan awak sebelum dia menarik nafas
Dialog: 0,0:40:54.52,0:40:57.28,teks umum,,0,0,0,,Kamu betul, dia bukan seperti kamu
Dialog: 0,0:40:58.61,0:40:59.69,teks umum,,0,0,0,,Saya?
Dialog: 0,0:41:00.99,0:41:01.99,teks umum,,0,0,0,,Apa salah saya?
Dialog: 0,0:41:04.07,0:41:07.45,teks umum,,0,0,0,,Apa? Apa jenis pandangan menghina ini?
Dialog: 0,0:41:07.54,0:41:10.87,teks umum,,0,0,0,,Bagaimanapun, saya rasa saya tidak boleh lakukan kepadanya seperti yang saya lakukan kepada awak
Dialog: 0,0:41:10.96,0:41:12.42,teks umum,,0,0,0,,Tidak, tidak, Moo Deok
Dialog: 0,0:41:12.50,0:41:14.04,teks umum,,0,0,0,,Pandang saya di mata
Dialog: 0,0:41:14.13,0:41:17.46,teks umum,,0,0,0,,Menyusahkan awak untuk menyentuhnya, tetapi dengan saya satu atau dua?
Dialog: 0,0:41:17.55,0:41:20.13,teks umum,,0,0,0,,Seperti kanak-kanak. Adakah ini penting sekarang?
Dialog: 0,0:41:20.72,0:41:21.80,teks umum,,0,0,0,,Anak?
Dialog: 0,0:41:23.26,0:41:24.68,teks umum,,0,0,0,,Ya, sangat penting
Dialog: 0,0:41:24.76,0:41:26.68,teks umum,,0,0,0,,Awak gila? awak buat apa?
Dialog: 0,0:41:26.76,0:41:27.60,teks umum,,0,0,0,,Saya dalam keadaan sihat
Dialog: 0,0:41:27.68,0:41:30.02,teks umum,,0,0,0,,- Tidak, katakan saya gila\N- Baiklah, lepaskan saya
Dialog: 0,0:41:32.89,0:41:33.77,teks umum,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:41:35.44,0:41:36.36,teks umum,,0,0,0,,Helo
Dialog: 0,0:41:38.36,0:41:41.36,teks umum,,0,0,0,,Kenapa awak sentiasa mengejek Moo Deok?
Dialog: 0,0:41:41.99,0:41:43.03,teks umum,,0,0,0,,Dia belum pulih lagi
Dialog: 0,0:41:43.11,0:41:45.16,teks umum,,0,0,0,,Saya tidak mengejeknya
Dialog: 0,0:41:46.70,0:41:48.20,teks umum,,0,0,0,,- Apa?{\i1}\N- Ini kumbang
Dialog: 0,0:41:48.28,0:41:49.87,teks umum,,0,0,0,,Saya fikir awak baik hati
Dialog: 0,0:41:51.20,0:41:52.79,italic,,0,0,0,,Moo Dok, awak okay?
Dialog: 0,0:41:54.67,0:41:57.25,italic,,0,0,0,,Tuan kamu terlalu banyak menuntut daripada kamu, bukan?
Dialog: 0,0:41:57.34,0:42:00.55,teks umum,,0,0,0,,Bukan sahaja anda menjaganya, tetapi juga menghiburkannya
Dialog: 0,0:42:00.63,0:42:02.84,italic,,0,0,0,,Dia minta air suam, tapi bila saya bawa,
Dialog: 0,0:42:02.92,0:42:04.34,teks umum,,0,0,0,,minta yang sejuk lagi...
Dialog: 0,0:42:04.43,0:42:06.30,teks umum,,0,0,0,,- Hei, apa...{\i1}\N- Dia kata makanan itu masin,
Dialog: 0,0:42:06.39,0:42:08.05,teks umum,,0,0,0,,tetapi kemudian mengadu bahawa dia hambar
Dialog: 0,0:42:08.14,0:42:10.43,teks umum,,0,0,0,,- Saya?{\i1}\N- Dia tidak matang dan berubah-ubah
Dialog: 0,0:42:10.52,0:42:12.89,teks umum,,0,0,0,,Malas, tetapi mempunyai harga diri yang tinggi
Dialog: 0,0:42:13.77,0:42:15.06,contact,,0,0,0,,Tetapi apa yang boleh saya lakukan?
Dialog: 0,0:42:15.15,0:42:16.44,teks umum,,0,0,0,,Dia tuan saya,
Dialog: 0,0:42:16.52,0:42:18.48,teks umum,,0,0,0,,jadi saya kena layan dia
Dialog: 0,0:42:19.15,0:42:21.48,contact,,0,0,0,,Moo Dok, nampaknya anda berjaya belajar banyak tentang dia
Dialog: 0,0:42:21.57,0:42:22.90,teks umum,,0,0,0,,Saya malu dengan awak
Dialog: 0,0:42:24.07,0:42:28.12,teks umum,,0,0,0,,By the way, apa yang awak buat di sini? Kenapa awak tidak berada di Sejukwon?
Dialog: 0,0:42:31.87,0:42:34.50,teks umum,,0,0,0,,Kami datang ke Yul
Dialog: 0,0:42:34.58,0:42:35.79,teks umum,,0,0,0,,Moo Dok minta saya datang
Dialog: 0,0:42:38.21,0:42:39.21,teks umum,,0,0,0,,Yul?
Dialog: 0,0:42:40.17,0:42:42.92,teks umum,,0,0,0,,Kenapa anda tidak mendekatinya?
Dialog: 0,0:42:44.01,0:42:45.13,teks umum,,0,0,0,,Kami mengintip dia
Dialog: 0,0:42:45.72,0:42:49.35,teks umum,,0,0,0,,Moo Dok berasa malu untuk mendekatinya,
Dialog: 0,0:42:49.43,0:42:50.56,teks umum,,0,0,0,,jadi saya tinggal bersamanya
Dialog: 0,0:42:53.73,0:42:57.15,teks umum,,0,0,0,,Moo Dok, anda mungkin suka Yul
Dialog: 0,0:42:57.23,0:42:59.23,teks umum,,0,0,0,,- Tidak...{\i1}\N- Dan Gu,
Dialog: 0,0:42:59.31,0:43:01.19,teks umum,,0,0,0,,anda memahami semuanya dengan cepat
Dialog: 0,0:43:01.27,0:43:03.11,teks umum,,0,0,0,,Saya sudah malu
Dialog: 0,0:43:03.19,0:43:06.61,teks umum,,0,0,0,,- Cikgu! Berlaku salah faham\N- Jangan malu
Dialog: 0,0:43:06.70,0:43:09.62,teks umum,,0,0,0,,Ramai gadis suka Yul
Dialog: 0,0:43:09.70,0:43:11.37,italic,,0,0,0,,- Perasaan awak normal{\i0}\N- Ini bukan...
Dialog: 0,0:43:11.45,0:43:13.58,italic,,0,0,0,,Saya akan bantu Moo Deok
Dialog: 0,0:43:13.66,0:43:15.25,teks umum,,0,0,0,,Uk, pergi ke resepsi
Dialog: 0,0:43:15.33,0:43:16.54,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:43:17.12,0:43:18.17,teks umum,,0,0,0,,Cikgu Ho ingin berjumpa dengan anda
Dialog: 0,0:43:18.25,0:43:19.25,teks umum,,0,0,0,,Tuan Ho?
Dialog: 0,0:43:47.40,0:43:49.11,teks umum,,0,0,0,,saya dengar awak panggil saya
Dialog: 0,0:43:51.24,0:43:52.24,teks umum,,0,0,0,,Ya
Dialog: 0,0:43:52.87,0:43:55.37,miring,,0,0,0,,Bunyi batuk anda menyenangkan dan jelas
Dialog: 0,0:43:55.45,0:43:57.21,teks umum,,0,0,0,,Saya rasa anda berasa lebih baik
Dialog: 0,0:43:57.29,0:43:59.67,teks umum,,0,0,0,,Saya masih pening dan loya
Dialog: 0,0:44:00.33,0:44:01.88,teks umum,,0,0,0,,Selain itu, saya tidak sedarkan diri
Dialog: 0,0:44:02.50,0:44:05.00,teks umum,,0,0,0,,Tetapi terima kasih kepada anda saya semakin baik
Dialog: 0,0:44:05.09,0:44:07.17,italic,,0,0,0,,Saya nampak awak dan pembantu rumah awak
Dialog: 0,0:44:07.26,0:44:11.09,teks umum,,0,0,0,,seronok berjalan pagi ini
Dialog: 0,0:44:11.18,0:44:12.68,teks umum,,0,0,0,,Bukankah ia pelik?
Dialog: 0,0:44:13.89,0:44:15.81,teks umum,,0,0,0,,Hei, ayuh, berdiri di sini
Dialog: 0,0:44:16.68,0:44:18.31,teks umum,,0,0,0,,Saya perlu mengambil sesuatu daripada kamu
Dialog: 0,0:44:20.31,0:44:21.15,contact,,0,0,0,,Tetapi pertama
Dialog: 0,0:44:21.86,0:44:23.77,teks umum,,0,0,0,,Saya bawakan sesuatu untuk awak
Dialog: 0,0:44:25.61,0:44:26.57,teks umum,,0,0,0,,Untuk saya?
Dialog: 0,0:44:27.24,0:44:28.99,teks umum,,0,0,0,,Pada zaman kanak-kanak
Dialog: 0,0:44:29.07,0:44:31.32,teks am,,0,0,0,,Saya biarkan sekawan biri-biri ke taman anda dengan herba perubatan
Dialog: 0,0:44:31.41,0:44:33.16,teks umum,,0,0,0,,Saya tahu awak benci saya sejak itu
Dialog: 0,0:44:33.24,0:44:36.91,teks am,,0,0,0,,Kambing biri-biri itu makan herba perubatan
Dialog: 0,0:44:37.00,0:44:38.91,teks umum,,0,0,0,,dan hidup sehingga hari ini
Dialog: 0,0:44:39.00,0:44:41.29,teks umum,,0,0,0,,Walaupun begitu, awak menyelamatkan nyawa saya
Dialog: 0,0:44:41.37,0:44:44.29,teks umum,,0,0,0,, dan dibenarkan untuk hidup. Saya amat berterima kasih kepada anda untuk ini
Dialog: 0,0:44:44.38,0:44:46.55,teks umum,,0,0,0,,Saya fikir awak seorang yang bodoh,
Dialog: 0,0:44:46.63,0:44:49.72,teks umum,,0,0,0,,tetapi nampaknya anda telah belajar untuk menunjukkan rasa terima kasih
Dialog: 0,0:44:49.80,0:44:51.84,teks umum,,0,0,0,,Saya sediakan sesuatu untuk anda
Dialog: 0,0:44:52.43,0:44:53.47,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:45:15.66,0:45:19.25,teks umum,,0,0,0,,Wain ini diperbuat daripada air cair dari pulau gunung berapi di South Deho
Dialog: 0,0:45:19.33,0:45:22.54,teks umum,,0,0,0,,Wain gelap terbaik di wilayah Deho
Dialog: 0,0:45:24.13,0:45:26.34,teks umum,,0,0,0,, Lelaki itu berkata bahawa dia ingin mengucapkan terima kasih,
Dialog: 0,0:45:26.42,0:45:29.88,teks umum,,0,0,0,,jadi saya terpaksa berusaha keras untuk mendapatkannya
Dialog: 0,0:45:34.59,0:45:36.18,teks umum,,0,0,0,,Ini adalah makanan istimewa yang jarang ditemui
Dialog: 0,0:45:40.56,0:45:42.39,teks umum,,0,0,0,,Adakah hanya ada satu botol?
Dialog: 0,0:45:56.57,0:46:00.29,teks umum,,0,0,0,,Anda pasti tahu banyak tentang kesyukuran!
Dialog: 0,0:46:01.62,0:46:04.87,teks umum,,0,0,0,,Hamba Kim, kamu membesarkannya dengan baik
Dialog: 0,0:46:04.96,0:46:06.42,italic,,0,0,0,,Terima kasih
Dialog: 0,0:46:06.96,0:46:08.42,teks umum,,0,0,0,,Bawa ke sini, lebih cepat
Dialog: 0,0:46:09.13,0:46:10.55,contact,,0,0,0,,Alangkah gembiranya
Dialog: 0,0:46:14.22,0:46:16.26,teks am,,0,0,0,,Tiga botol?
Dialog: 0,0:46:21.68,0:46:22.77,teks umum,,0,0,0,,Ibu
Dialog: 0,0:46:23.48,0:46:25.73,teks umum,,0,0,0,,Pintu tenaga Uka dibuka
Dialog: 0,0:46:26.56,0:46:30.94,teks umum,,0,0,0,,Setakat ini, kami tidak dapat berbuat apa-apa kerana perintah Gwangju
Dialog: 0,0:46:32.07,0:46:35.66,teks umum,,0,0,0,,Adakah ini bermakna kini kita boleh menerima dia dalam keluarga?
Dialog: 0,0:46:35.74,0:46:39.33,teks umum,,0,0,0,,Lelaki ini memutuskan pertunangannya selepas menggunakan awak
Dialog: 0,0:46:40.24,0:46:41.66,teks umum,,0,0,0,,Dan awak masih sayangkan dia?
Dialog: 0,0:46:41.74,0:46:44.62,teks umum,,0,0,0,,Saya menggunakannya untuk tujuan saya sendiri
Dialog: 0,0:46:45.12,0:46:47.58,teks umum,,0,0,0,,Pintu tenaganya ditutup, dan saya menggunakannya untuk melawannya,
Dialog: 0,0:46:47.67,0:46:49.38,teks umum,,0,0,0,,memaksa dia tinggal bersama kita
Dialog: 0,0:46:49.46,0:46:51.05,teks umum,,0,0,0,,Jangan putar belit kebenaran
Dialog: 0,0:46:51.13,0:46:54.51,teks umum,,0,0,0,,Dia berkata bahawa dia akan tinggal bersama kita jika kita membantunya membuka pintu tenaga
Dialog: 0,0:46:54.59,0:46:55.93,teks umum,,0,0,0,,Jadi dia menggoda awak
Dialog: 0,0:46:59.22,0:47:01.06,teks umum,,0,0,0,,Akhirnya ia berlaku
Dialog: 0,0:47:01.14,0:47:04.27,teks umum,,0,0,0,,Jika anda telah membuka pintu gerbangnya,
Dialog: 0,0:47:04.35,0:47:06.44,teks umum,,0,0,0,,anda akan mempunyai menantu,
Dialog: 0,0:47:06.52,0:47:10.65,teks umum,,0,0,0,,dan saya akan berkahwin dengan yang saya mahu
Dialog: 0,0:47:12.98,0:47:14.11,teks umum,,0,0,0,,Cho Young
Dialog: 0,0:47:14.99,0:47:17.49,teks umum,,0,0,0,,Anak kepada keluarga Chan, yang pintu tenaganya terbuka,
Dialog: 0,0:47:17.57,0:47:19.74,teks umum,,0,0,0,,tidak akan pernah menjadi menantu saya
Dialog: 0,0:47:21.12,0:47:23.87,teks umum,,0,0,0,,Awak mesti ambil tempat kakak awak
Dialog: 0,0:47:24.66,0:47:27.71,teks umum,,0,0,0,,dan menjadi ketua yang melindungi Jinyeowon demi keluarga
Dialog: 0,0:47:29.38,0:47:31.71,teks umum,,0,0,0,,Cari lelaki yang akan menyokong anda
Dialog: 0,0:47:33.38,0:47:35.13,teks umum,,0,0,0,,Jika kakak saya tidak meninggal dunia,
Dialog: 0,0:47:35.92,0:47:38.09,teks umum,,0,0,0,,Saya akan berkahwin dengan kekasih saya
Dialog: 0,0:47:45.10,0:47:46.89,teks umum,,0,0,0,,Maaf, ibu
Dialog: 0,0:47:48.69,0:47:52.19,teks umum,,0,0,0,,Periksa sama ada guci Gwigu telah dikumpul atau tidak
Dialog: 0,0:47:53.48,0:47:54.69,teks umum,,0,0,0,,Okay
Dialog: 0,0:48:41.61,0:48:45.79,teks umum,,0,0,0,,Uk memecahkan guci Gwigu
Dialog: 0,0:48:50.62,0:48:52.79,teks umum,,0,0,0,,Bagaimana jika saya meminta dia berkahwin dengan saya sebagai balasan?
Dialog: 0,0:48:53.75,0:48:55.17,teks umum,,0,0,0,,Dia pasti akan menolak
Dialog: 0,0:49:01.09,0:49:04.89,teks umum,,0,0,0,,En. Yul tidur di bilik paling jauh?
Dialog: 0,0:49:04.97,0:49:08.18,teks umum,,0,0,0,,Ya, dia sukakan kedamaian dan ketenangan
Dialog: 0,0:49:09.89,0:49:11.39,teks umum,,0,0,0,,Bila dia hendak tidur?
Dialog: 0,0:49:11.89,0:49:13.35,teks umum,,0,0,0,,Jika tidak sibuk,
Dialog: 0,0:49:13.44,0:49:16.65,teks umum,,0,0,0,,tidur awal dan bangun awal
Dialog: 0,0:49:18.03,0:49:19.07,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:19.15,0:49:21.03,teks umum,,0,0,0,,Adakah anda mahu melawat bilik tidurnya?
Dialog: 0,0:49:22.41,0:49:24.49,teks umum,,0,0,0,,Tidak kira betapa anda menyukainya, ini salah
Dialog: 0,0:49:27.54,0:49:28.79,teks umum,,0,0,0,,Petunjuk
Dialog: 0,0:49:28.87,0:49:31.79,teks umum,,0,0,0,,Dia selalu makan pada masa yang sama, anda boleh melihatnya semasa makan tengah hari
Dialog: 0,0:49:33.00,0:49:34.25,teks umum,,0,0,0,,Okey
Dialog: 0,0:49:34.33,0:49:37.63,di sebalik tabir,,0,0,0,,Saya perlukan lebih daripada melihat. Saya perlu menyentuhnya
Dialog: 0,0:49:55.27,0:49:56.86,teks umum,,0,0,0,,Kami Doc, awak okay?
Dialog: 0,0:50:00.90,0:50:02.07,teks umum,,0,0,0,,Yul...
Dialog: 0,0:50:05.20,0:50:07.74,teks umum,,0,0,0,,Orang luar tidak dibenarkan membaca buku di Jeongjingak
Dialog: 0,0:50:08.53,0:50:10.91,teks umum,,0,0,0,,Dia hanya membantu
Dialog: 0,0:50:11.00,0:50:12.87,teks umum,,0,0,0,,Ya, dan mantra ditulis di dalamnya
Dialog: 0,0:50:12.96,0:50:14.83,teks umum,,0,0,0,,Dia masih tidak faham
Dialog: 0,0:50:16.71,0:50:17.96,teks umum,,0,0,0,,Adakah anda pantas?
Dialog: 0,0:50:19.30,0:50:20.88,teks am,,0,0,0,,Adakah anda tahu seni mempertahankan diri?
Dialog: 0,0:50:23.88,0:50:26.64,teks umum,,0,0,0,,Saya belajar menari di rumah gisaeng
Dialog: 0,0:50:29.81,0:50:31.43,teks umum,,0,0,0,,Sebab itu saya cepat
Dialog: 0,0:50:35.77,0:50:38.90,teks umum,,0,0,0,,Di manakah Don Yi? Kena tanya sesuatu
Dialog: 0,0:50:41.48,0:50:44.36,teks umum,,0,0,0,,Don Dan tiada di sini, tetapi ada Mu Dok
Dialog: 0,0:50:44.99,0:50:47.37,teks umum,,0,0,0,,Moo Dok, tolong dia
Dialog: 0,0:50:47.45,0:50:48.74,teks umum,,0,0,0,,Saya akan membantu
Dialog: 0,0:50:48.82,0:50:50.83,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:51:07.13,0:51:09.22,teks umum,,0,0,0,,Tolong, tuan muda?
Dialog: 0,0:51:13.06,0:51:15.94,teks umum,,0,0,0,,Tuan, adakah anda lapar? Apa yang perlu dibawa?
Dialog: 0,0:51:17.60,0:51:20.19,teks umum,,0,0,0,,Tuan, saya...
Dialog: 0,0:51:32.74,0:51:36.33,teks umum,,0,0,0,,Ahli silap mata Chonjingak tinggal di sini. Jangan ikut saya
Dialog: 0,0:51:41.75,0:51:45.13,suara,,0,0,0,,Jika dia tidur awal, bermakna dia akan tidur
Dialog: 0,0:51:58.77,0:52:00.10,teks umum,,0,0,0,,Adakah ini tandas?
Dialog: 0,0:52:08.49,0:52:10.74,teks umum,,0,0,0,,Saya suruh awak pergi. Kenapa awak ada di sini?
Dialog: 0,0:52:13.45,0:52:17.87,teks umum,,0,0,0,,Saya fikir mungkin saya boleh membantu dengan sesuatu
Dialog: 0,0:52:18.91,0:52:19.75,teks umum,,0,0,0,,Kepada anda
Dialog: 0,0:52:21.17,0:52:22.79,teks umum,,0,0,0,,adakah anda perlukan sesuatu daripada saya?
Dialog: 0,0:52:27.88,0:52:30.51,luar skrin,,0,0,0,,Hanya untuk menyentuh anda. Dan ini adalah peluang
Dialog: 0,0:52:31.39,0:52:34.14,teks umum,,0,0,0,,Kenapa awak ikut saya sehingga ke bilik lelaki?
Dialog: 0,0:53:08.13,0:53:11.34,suara,,0,0,0,,Ini peluang saya. Enam nafas dan saya akan faham bagaimana dia bernafas
Dialog: 0,0:53:14.22,0:53:15.18,sebalik tabir,,0,0,0,,Satu
Dialog: 0,0:53:16.31,0:53:17.14,sebalik tabir,,0,0,0,,Dua
Dialog: 0,0:53:20.02,0:53:21.19,sebalik tabir,,0,0,0,,Tiga
Dialog: 0,0:53:21.89,0:53:23.02,di sebalik tabir,,0,0,0,,Empat
Dialog: 0,0:53:39.20,0:53:40.25,teks umum,,0,0,0,,Kenapa awak buat begitu?
Dialog: 0,0:53:40.83,0:53:43.00,suara,,0,0,0,,Saya sangat rapat
Dialog: 0,0:53:43.08,0:53:45.17,teks umum,,0,0,0,,Saya tahu awak dan Uk memandang saya dari jauh
Dialog: 0,0:53:45.25,0:53:46.71,teks umum,,0,0,0,,Kenapa awak ikut saya?
Dialog: 0,0:53:48.09,0:53:50.55,di sebalik tabir,,0,0,0,,Hanya satu nafas
Dialog: 0,0:53:51.59,0:53:52.47,teks umum,,0,0,0,,Jawapan
Dialog: 0,0:53:53.22,0:53:54.72,teks umum,,0,0,0,,Saya sayang awak!
Dialog: 0,0:54:20.62,0:54:21.62,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:54:22.71,0:54:24.00,teks umum,,0,0,0,,Sakit
Dialog: 0,0:54:40.14,0:54:43.81,teks umum,,0,0,0,,Anda berminat dengan teknik pernafasan saya. Cuba mencapai teras tenaga saya
Dialog: 0,0:54:44.56,0:54:46.40,teks umum,,0,0,0,,Saya beritahu awak, saya sayang awak
Dialog: 0,0:54:46.48,0:54:47.94,teks umum,,0,0,0,,Anda berbohong dengan begitu mahir
Dialog: 0,0:54:48.81,0:54:50.82,teks umum,,0,0,0,,Dan sebelum ini tidak ada tarian, tetapi seni mempertahankan diri
Dialog: 0,0:54:51.40,0:54:53.03,teks umum,,0,0,0,,Hidup saya susah,
Dialog: 0,0:54:53.11,0:54:55.53,teks umum,,0,0,0,,jadi saya belajar beberapa langkah untuk keselamatan
Dialog: 0,0:54:55.61,0:54:57.20,teks umum,,0,0,0,,Adakah ini untuk Uka?
Dialog: 0,0:54:59.49,0:55:02.41,teks umum,,0,0,0,,Saya rasa dia cuba mengawal rizab tenaga di dalam
Dialog: 0,0:55:02.50,0:55:05.41,teks umum,,0,0,0,,Tetapi dia tidak akan berjaya walaupun dengan bantuan teknik saya
Dialog: 0,0:55:08.83,0:55:11.13,teks umum,,0,0,0,,Berhenti membuang masa. Dapatkan lebih baik dan pergi
Dialog: 0,0:55:31.07,0:55:32.98,teks umum,,0,0,0,,Jadi awak ingat saya,
Dialog: 0,0:55:33.98,0:55:35.11,teks umum,,0,0,0,,Yul
Dialog: 0,0:57:01.36,0:57:05.12,teks umum,,0,0,0,,Saya tidak mengabaikan awak kerana saya membenci awak
Dialog: 0,0:57:05.20,0:57:08.75,teks umum,,0,0,0,,Ibu awak Do Hwa seperti anak perempuan kepada saya
Dialog: 0,0:57:09.33,0:57:11.67,teks umum,,0,0,0,,Saya sama seperti datuk kamu
Dialog: 0,0:57:13.96,0:57:15.34,teks umum,,0,0,0,,Bajingan muda
Dialog: 0,0:57:17.76,0:57:19.63,teks umum,,0,0,0,,Ya, datuk
Dialog: 0,0:57:22.84,0:57:27.01,teks umum,,0,0,0,,Ibu awak sangat baik
Dialog: 0,0:57:28.77,0:57:30.06,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:57:30.73,0:57:34.23,teks umum,,0,0,0,,Ya! Anda sepatutnya tahu ini
Dialog: 0,0:57:34.31,0:57:37.44,teks umum,,0,0,0,,Ingat ini dan jangan hiraukan kata-kata orang lain
Dialog: 0,0:57:40.95,0:57:42.20,teks umum,,0,0,0,,Anak malang ini...
Dialog: 0,0:57:45.28,0:57:49.16,di belakang tabir,,0,0,0,,Panjang dan kedalaman penyedutan dan hembusan nafas
Dialog: 0,0:58:01.30,0:58:03.34,teks umum,,0,0,0,,Sukar untuk dimainkan. Saya kagum
Dialog: 0,0:58:04.84,0:58:06.76,teks umum,,0,0,0,,Saya boleh melakukan banyak
Dialog: 0,0:58:08.43,0:58:09.68,teks umum,,0,0,0,,Kembali
Dialog: 0,0:58:15.15,0:58:17.19,teks umum,,0,0,0,,Nampaknya sudah bertahun-tahun lamanya
Dialog: 0,0:58:17.27,0:58:19.73,teks umum,,0,0,0,,Mengapa anda memerlukan sesuatu yang lama?
Dialog: 0,0:58:23.57,0:58:25.24,teks umum,,0,0,0,,Ia milik kawan lama
Dialog: 0,0:58:31.37,0:58:34.21,teks umum,,0,0,0,,Alih-alih rakan berdekatan, anda mempunyai wisel
Dialog: 0,0:58:35.17,0:58:37.04,teks umum,,0,0,0,,Jadi rakan anda meninggalkan anda
Dialog: 0,0:58:41.38,0:58:42.55,teks umum,,0,0,0,,Ya
Dialog: 0,0:58:43.38,0:58:44.88,teks umum,,0,0,0,,Ini milik rakan itu
Dialog: 0,0:58:47.80,0:58:49.72,teks umum,,0,0,0,,Kembalikan saya, dia amat bermakna bagi saya
Dialog: 0,0:58:51.31,0:58:55.31,teks umum,,0,0,0,,Sebagai balasan, ajar saya teknik pernafasan anda
Dialog: 0,0:58:57.90,0:59:00.40,teks umum,,0,0,0,,Awak kata ia tidak berguna pula
Dialog: 0,0:59:00.48,0:59:02.69,teks umum,,0,0,0,,Ini juga tidak berguna untuk saya
Dialog: 0,0:59:03.49,0:59:04.61,teks umum,,0,0,0,,Mari kita tukar
Dialog: 0,0:59:08.07,0:59:09.87,teks umum,,0,0,0,,Bagi saya ini adalah sampah,
Dialog: 0,0:59:10.83,0:59:12.37,teks umum,,0,0,0,,Saya boleh memecahkannya
Dialog: 0,0:59:29.76,0:59:31.26,teks umum,,0,0,0,,Hanya tiga nafas
Dialog: 0,1:00:12.43,1:00:14.47,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,1:00:40.92,1:00:43.17,teks umum,,0,0,0,, Apakah jenis ekspresi muka?
Dialog: 0,1:00:43.71,1:00:46.05,teks umum,,0,0,0,,Tidak seperti anda
Dialog: 0,1:00:48.59,1:00:49.76,teks umum,,0,0,0,,Saya suka
Dialog: 0,1:00:54.47,1:00:56.06,teks umum,,0,0,0,,Awak putar belit macam tu
Dialog: 0,1:00:56.89,1:01:00.31,teks umum,,0,0,0,,Saya mengikuti Yul dan mengulangi bahawa saya menyukainya, dan sekarang saya tahu
Dialog: 0,1:01:00.39,1:01:01.60,teks umum,,0,0,0,,Faham
Dialog: 0,1:01:02.44,1:01:05.44,teks umum,,0,0,0,,Anda seorang yang sensitif yang membunuh semua orang di laluan anda,
Dialog: 0,1:01:05.52,1:01:08.78,teks umum,,0,0,0,,tetapi saya memutuskan untuk menggoda lelaki itu demi pelajar saya
Dialog: 0,1:01:09.82,1:01:11.03,teks umum,,0,0,0,,Dan awak?
Dialog: 0,1:01:11.11,1:01:13.78,teks umum,,0,0,0,,Saya harap awak tidak biarkan Ho Yeom mengambil tenaganya
Dialog: 0,1:01:13.87,1:01:16.20,teks umum,,0,0,0,,Kuasa ada pada saya. Dan saya belajar teknik pernafasannya
Dialog: 0,1:01:16.29,1:01:17.74,teks umum,,0,0,0,,Jadi anda membuang masa anda
Dialog: 0,1:01:17.83,1:01:20.37,teks umum,,0,0,0,,Adakah anda mengetahuinya? Jangan tipu saya
Dialog: 0,1:01:21.00,1:01:22.29,teks umum,,0,0,0,,Saya pasti anda berbohong,
Dialog: 0,1:01:22.37,1:01:24.54,teks umum,,0,0,0,,untuk berpura-pura bahawa anda melakukan sesuatu yang berfaedah
Dialog: 0,1:01:24.63,1:01:26.67,teks umum,,0,0,0,,Saya bernafas seperti ini. apa khabar dia
Dialog: 0,1:01:26.75,1:01:29.05,teks umum,,0,0,0,,Dan, nampaknya, saya merasakan sesuatu bergerak dalam diri saya
Dialog: 0,1:01:37.22,1:01:38.93,teks umum,,0,0,0,,Tenaga sedang mendidih dalam diri anda
Dialog: 0,1:01:40.35,1:01:41.69,teks umum,,0,0,0,,Berfungsi
Dialog: 0,1:01:44.44,1:01:46.15,teks umum,,0,0,0,,Adakah anda begitu rapat dengan Yul?
Dialog: 0,1:01:47.77,1:01:49.86,teks umum,,0,0,0,,Awas. Saya masih nampak tanda di mata awak
Dialog: 0,1:01:51.11,1:01:52.86,teks umum,,0,0,0,,Saya menggunakan ubat titis mata
Dialog: 0,1:01:53.82,1:01:56.49,teks umum,,0,0,0,,Saya tidak nampak tanda di cermin. Anda boleh melihatnya, bukan?
Dialog: 0,1:01:56.58,1:01:58.12,teks umum,,0,0,0,,Beginilah rupa anda
Dialog: 0,1:01:58.20,1:02:00.16,teks umum,,0,0,0,,Jika anda benar-benar menyukainya, beginilah cara anda mendekatinya
Dialog: 0,1:02:00.25,1:02:02.04,teks umum,,0,0,0,,Berhati-hati dengan cinta
Dialog: 0,1:02:03.79,1:02:05.08,teks umum,,0,0,0,,Hanya anda boleh benarkan saya masuk seperti itu
Dialog: 0,1:02:07.75,1:02:10.34,teks umum,,0,0,0,,Okay. Sekarang hanya anda yang boleh
Dialog: 0,1:02:12.30,1:02:14.13,teks umum,,0,0,0,,Saya akan cuba untuk tidak jatuh cinta dengan Yulia
Dialog: 0,1:02:15.84,1:02:16.89,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:16.97,1:02:19.06,teks umum,,0,0,0,,Mengapa ini memerlukan usaha?
Dialog: 0,1:02:19.77,1:02:21.27,teks umum,,0,0,0,,Dia cantik
Dialog: 0,1:02:21.35,1:02:24.19,teks umum,,0,0,0,,Perlu usaha untuk tidak jatuh cinta dengan lelaki kacak
Dialog: 0,1:02:24.27,1:02:25.48,teks umum,,0,0,0,,Dan saya?
Dialog: 0,1:02:25.56,1:02:28.73,teks umum,,0,0,0,,Saya rasa lebih sukar untuk tidak jatuh cinta dengan saya
Dialog: 0,1:02:28.82,1:02:29.94,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,1:02:30.94,1:02:32.82,teks umum,,0,0,0,,Bagaimana tidak? Ia tidak masuk akal
Dialog: 0,1:02:32.90,1:02:35.45,teks umum,,0,0,0,,- Katakan sukar\N- Ya, tuan
Dialog: 0,1:02:35.53,1:02:37.28,teks umum,,0,0,0,,- Katakan dengan serius\N - Ya
Dialog: 0,1:02:37.37,1:02:39.20,teks umum,,0,0,0,,- Jadi adakah anda akan berkata begitu?\N- Ya
Dialog: 0,1:02:39.28,1:02:40.70,teks umum,,0,0,0,,Ayuh, buat saya ketawa
Dialog: 0,1:04:15.55,1:04:16.72,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,1:04:17.63,1:04:19.89,teks umum,,0,0,0,,Berdasarkan tenaga pada pedangmu,
Dialog: 0,1:04:19.97,1:04:22.72,teks umum,,0,0,0,,anda telah menguasai tahap tertinggi Ryusu
Dialog: 0,1:04:25.68,1:04:27.31,teks umum,,0,0,0,,Semua terima kasih kepada anda,
Dialog: 0,1:04:28.39,1:04:29.90,teks umum,,0,0,0,,Timbalan Gyeongju
Dialog: 0,1:04:29.98,1:04:32.65,teks umum,,0,0,0,,Satu-satunya yang boleh bersaing dengan anda,
Dialog: 0,1:04:32.73,1:04:34.98,teks umum,,0,0,0,,Saya rasa hanya Seo Yul daripada keluarga Seo
Dialog: 0,1:04:35.82,1:04:39.49,teks am,,0,0,0,,Yang Mulia Permaisuri dan bapa Julia, Jeneral So, abang dan kakak
Dialog: 0,1:04:39.57,1:04:41.70,teks umum,,0,0,0,,Saya dan Yul sangat rapat semasa kecil,
Dialog: 0,1:04:41.78,1:04:43.70,teks umum,,0,0,0,,tetapi semuanya berubah apabila dia memasuki Sosnovy Bor
Dialog: 0,1:04:46.12,1:04:49.96,teks umum,,0,0,0,,So Yul, Park Dan Gu, Chan Wook dan Jin Cho Young dikenali
Dialog: 0,1:04:50.04,1:04:51.79,teks umum,,0,0,0,,seperti Four Seasons
Dialog: 0,1:04:52.88,1:04:54.42,teks umum,,0,0,0,,Biar mereka berseronok
Dialog: 0,1:04:55.13,1:04:56.05,contact,,0,0,0,,Tunggu
Dialog: 0,1:04:56.13,1:04:58.84,teks umum,,0,0,0,,Kenapa Chan Wook juga antara mereka sedangkan dia tidak mempunyai sihir?
Dialog: 0,1:04:59.80,1:05:01.39,teks umum,,0,0,0,,Sekarang memiliki
Dialog: 0,1:05:02.09,1:05:03.51,teks umum,,0,0,0,,Pintu tenaganya terbuka
Dialog: 0,1:05:04.30,1:05:05.97,teks umum,,0,0,0,,Adakah pintu pagar terbuka?
Dialog: 0,1:05:09.27,1:05:11.27,teks umum,,0,0,0,,Tetapi dia tidak boleh berbuat banyak
Dialog: 0,1:05:11.35,1:05:13.77,teks umum,,0,0,0,,Dia anak kepada Chang Gan, gwangju Jeonbugwan
Dialog: 0,1:05:15.27,1:05:16.36,teks umum,,0,0,0,,Baru-baru ini
Dialog: 0,1:05:16.44,1:05:19.15,teks umum,,0,0,0,,dia datang bertanya tentang pedang Nak Su
Dialog: 0,1:05:21.32,1:05:22.16,teks umum,,0,0,0,,Dan?
Dialog: 0,1:05:25.20,1:05:27.20,kenangan,,0,0,0,,Adakah anda takut saya akan berjaya?
Dialog: 0,1:05:27.29,1:05:28.58,contact,,0,0,0,,Jadi awak berikannya?
Dialog: 0,1:05:28.66,1:05:31.12,teks umum,,0,0,0,,Baginda titah untuk menyimpannya di Jeonbugwan
Dialog: 0,1:05:31.21,1:05:34.63,teks umum,,0,0,0,,Siaran Gwangju milik keluarga Jang
Dialog: 0,1:05:35.29,1:05:36.55,teks umum,,0,0,0,,Tiada pilihan
Dialog: 0,1:05:38.88,1:05:40.51,teks umum,,0,0,0,,Betapa biadapnya
Dialog: 0,1:05:40.59,1:05:42.47,teks umum,,0,0,0,,Dia memandang rendah saya
Dialog: 0,1:05:43.30,1:05:45.55,teks umum,,0,0,0,,Namun, saya adalah pelajar bapanya
Dialog: 0,1:05:45.64,1:05:49.02,teks umum,,0,0,0,,Jika anda fikirkan seperti itu, saya bukan pelajarnya secara rasmi
Dialog: 0,1:05:50.27,1:05:53.15,teks umum,,0,0,0,,Saya tiada tempat untuk pergi apabila keluarga Jin menghalau saya,
Dialog: 0,1:05:54.06,1:05:56.06,teks umum,,0,0,0,,dia mengambil saya sebagai hamba
Dialog: 0,1:05:56.86,1:05:59.19,teks umum,,0,0,0,,Anda adalah guru Putera Mahkota negara ini
Dialog: 0,1:05:59.28,1:06:01.03,teks umum,,0,0,0,,Beraninya dia?
Dialog: 0,1:06:01.11,1:06:02.99,teks umum,,0,0,0,,Ia seperti memandang rendah saya
Dialog: 0,1:06:03.07,1:06:05.20,teks umum,,0,0,0,,Saya minta maaf kerana
Dialog: 0,1:06:06.16,1:06:09.29,teks am,,0,0,0,,bahawa guru kamu bukan berasal dari keluarga bangsawan
Dialog: 0,1:06:14.04,1:06:15.29,teks umum,,0,0,0,,Kita perlu cepat
Dialog: 0,1:06:16.17,1:06:18.50,teks umum,,0,0,0,,letakkan Chan Wook di tempatnya
Dialog: 0,1:06:39.15,1:06:41.69,teks umum,,0,0,0,,Ini adalah pedang Gwangju Chan, kepada bapa Chan Wook
Dialog: 0,1:06:43.20,1:06:44.28,teks umum,,0,0,0,,Saya entah bagaimana...
Dialog: 0,1:06:45.36,1:06:47.74,teks umum,,0,0,0,,berjanji untuk menerima dia jika dia mendedahkan
Dialog: 0,1:06:48.49,1:06:50.12,teks umum,,0,0,0,,pedang bapanya
Dialog: 0,1:06:50.20,1:06:52.79,teks umum,,0,0,0,,Kini pintu tenaganya terbuka dan ini mungkin
Dialog: 0,1:06:53.37,1:06:56.54,teks umum,,0,0,0,,Adakah anda akan membenarkan dia menjadi ahli silap mata Sosnovy Bor?
Dialog: 0,1:06:58.96,1:07:01.63,teks umum,,0,0,0,,Bawa Uka
Dialog: 0,1:07:10.97,1:07:14.23,kenangan condong,,0,0,0,,Apa yang anda katakan? Siapa bapanya?
Dialog: 0,1:07:15.02,1:07:16.44,kenangan,,0,0,0,,Raja mangkat
Dialog: 0,1:07:17.81,1:07:19.69,kenangan,,0,0,0,,Dia anak raja!
Dialog: 0,1:07:22.03,1:07:23.65,kenangan,,0,0,0,,Jadi dia anak raja,
Dialog: 0,1:07:24.57,1:07:27.20,kenangan,,0,0,0,,siapa yang meninggal setahun yang lalu?
Dialog: 0,1:07:27.78,1:07:29.12,kenangan,,0,0,0,,Almarhum raja
Dialog: 0,1:07:29.78,1:07:32.62,kenangan,,0,0,0,,mati kerana sakit, tidak boleh bergerak
Dialog: 0,1:07:32.70,1:07:33.87,kenangan,,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,1:07:33.95,1:07:35.54,kenangan,,0,0,0,,Pada hari lahir bayi ini,
Dialog: 0,1:07:36.50,1:07:39.13,kenangan,,0,0,0,,bintang baru raja bersinar di langit
Dialog: 0,1:07:40.75,1:07:43.63,kenangan,,0,0,0,,Adik kepada almarhum raja telah pun menaiki takhta,
Dialog: 0,1:07:44.34,1:07:46.47,kenangan,,0,0,0,,yang akan diwarisi anaknya
Dialog: 0,1:07:46.55,1:07:49.68,kenangan,,0,0,0,,Jika kerabat diraja mengetahui bahawa ini adalah anak raja,
Dialog: 0,1:07:50.55,1:07:52.39,kenangan,,0,0,0,,mereka akan melihatnya
Dialog: 0,1:07:53.52,1:07:54.81,kenangan,,0,0,0,,sebagai ancaman
Dialog: 0,1:07:59.94,1:08:02.40,kenangan miring,,0,0,0,,Kewujudannya akan membawa huru-hara
Dialog: 0,1:08:03.40,1:08:06.03,kenangan miring,,0,0,0,,Dia tidak sepatutnya menarik perhatian kepada dirinya sendiri
Dialog: 0,1:08:08.03,1:08:10.53,kenangan miring,,0,0,0,,Orang mesti berfikir bahawa tidak ada yang luar biasa tentang dia
Dialog: 0,1:08:16.29,1:08:18.00,teks umum,,0,0,0,,Saya mohon maaf
Dialog: 0,1:08:18.67,1:08:21.25,teks umum,,0,0,0,,untuk semua masalah yang saya buat
Dialog: 0,1:08:23.84,1:08:25.88,teks umum,,0,0,0,,Sosnovy Bor memutuskan
Dialog: 0,1:08:26.55,1:08:28.30,teks umum,,0,0,0,,buka pintu tenaga anda,
Dialog: 0,1:08:29.01,1:08:30.68,teks umum,,0,0,0,,oleh itu tanggungjawab bukan terletak pada anda
Dialog: 0,1:08:32.22,1:08:34.18,teks am,,0,0,0,,Saya, Chan Wook, anak lelaki sulung keluarga Chan,
Dialog: 0,1:08:34.26,1:08:36.06,teks umum,,0,0,0,,sedia untuk belajar dan berlatih
Dialog: 0,1:08:36.89,1:08:39.27,teks umum,,0,0,0,,Jika Sosnovy Bor memberi saya peluang, saya akan melakukan yang terbaik
Dialog: 0,1:08:40.52,1:08:42.65,teks umum,,0,0,0,,Sebagai tanda kesetiaan anda,
Dialog: 0,1:08:42.73,1:08:45.57,teks umum,,0,0,0,,Saya akan berikan kamu pedang Nak Su, yang saya ambil daripada Jin Mu,
Dialog: 0,1:08:46.40,1:08:48.15,teks umum,,0,0,0,,supaya ia disimpan dalam gudang senjata Sosnovy Bor
Dialog: 0,1:08:50.91,1:08:52.28,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,1:08:55.70,1:09:00.46,teks umum,,0,0,0,,Pedang itu milik keluarga Chan, biarkan ia disimpan bersama anda
Dialog: 0,1:09:07.21,1:09:10.43,teks umum,,0,0,0,,Awak boleh ambil pedang ayah awak
Dialog: 0,1:09:11.89,1:09:15.97,teks umum,,0,0,0,,Mulai sekarang, saya melarang Chan Wook daripada memasuki Sosnovy Bor
Dialog: 0,1:09:22.02,1:09:23.61,teks umum,,0,0,0,,Anda bebas untuk datang,
Dialog: 0,1:09:24.15,1:09:26.73,teks umum,,0,0,0,,seperti anak kawan lama
Dialog: 0,1:09:27.78,1:09:32.70,teks umum,,0,0,0,,Tetapi anda tidak mempunyai hak untuk menjadi ahli silap mata Sosnovy Bor
Dialog: 0,1:09:34.07,1:09:35.74,teks umum,,0,0,0,,Sekarang
Dialog: 0,1:09:35.83,1:09:39.62,teks umum,,0,0,0,,Chan Wook tidak akan mempunyai akses kepada apa-apa di dalam hutan
Dialog: 0,1:09:42.67,1:09:46.88,teks umum,,0,0,0,,Beri saya azimat yang membolehkan anda melintas di sini
Dialog: 0,1:09:51.97,1:09:53.22,teks umum,,0,0,0,,Saya tidak memilikinya
Dialog: 0,1:09:54.01,1:09:54.84,teks umum,,0,0,0,,Apa?
Dialog: 0,1:09:56.81,1:09:58.14,teks umum,,0,0,0,,Saya sesat
Dialog: 0,1:10:00.85,1:10:02.02,teks umum,,0,0,0,,jimat semangat
Dialog: 0,1:10:02.10,1:10:04.60,teks umum,,0,0,0,,Apakah hukuman yang disediakan untuk mereka
Dialog: 0,1:10:05.56,1:10:07.27,teks umum,,0,0,0,,siapa yang akan kehilangan azimat?
Dialog: 0,1:10:08.53,1:10:10.53,teks umum,,0,0,0,,Pukulan, 100 pukulan, tuan
Dialog: 0,1:10:10.61,1:10:13.20,teks umum,,0,0,0,,Lalu saya berikan Chan Wook seratus pukulan
Dialog: 0,1:10:13.28,1:10:15.32,teks umum,,0,0,0,,untuk kehilangan azimat
Dialog: 0,1:10:51.86,1:10:54.32,teks umum,,0,0,0,,Dia mempunyai tenaga Master Ho, semuanya akan baik-baik saja
Dialog: 0,1:10:54.90,1:10:57.74,teks umum,,0,0,0,,Jika anda masuk, dia akan menghadapi lebih banyak masalah
Dialog: 0,1:11:42.29,1:11:44.37,contact,,0,0,0,,Chan Wook, tinggalkan Sosnovy Bor
Dialog: 0,1:11:44.45,1:11:46.46,teks umum,,0,0,0,,dan jangan muncul di sini lagi
Dialog: 0,1:11:51.34,1:11:52.38,teks umum,,0,0,0,,Pergi
Dialog: 0,1:11:54.38,1:11:55.67,teks umum,,0,0,0,,Tidak
Dialog: 0,1:11:55.76,1:11:56.80,teks umum,,0,0,0,,Tidak...
Dialog: 0,1:11:57.63,1:11:58.84,teks umum,,0,0,0,,Saya tidak boleh pergi seperti ini
Dialog: 0,1:12:00.51,1:12:02.60,teks umum,,0,0,0,,Saya dipukul 99 kali
Dialog: 0,1:12:04.56,1:12:05.98,teks umum,,0,0,0,,Tinggal satu pukulan
Dialog: 0,1:12:08.52,1:12:10.02,teks umum,,0,0,0,,Dan yang terakhir ini
Dialog: 0,1:12:11.69,1:12:13.11,teks umum,,0,0,0,,guna pakai sendiri
Dialog: 0,1:12:29.87,1:12:32.04,kenangan,,0,0,0,,Saya hanya cuba memastikan dia selamat
Dialog: 0,1:12:32.63,1:12:36.38,kenangan,,0,0,0,,Jika pintu tenaganya tidak dibuka, dan dia hidup seperti anak saya, dia akan bertahan
Dialog: 0,1:12:36.46,1:12:39.59,kenangan,,0,0,0,,Tetapi jika dia memutuskan untuk mencuba nasib,
Dialog: 0,1:12:41.80,1:12:43.93,kenangan,,0,0,0,,kematian menantinya
Dialog: 0,1:13:00.66,1:13:03.70,suara,,0,0,0,,Uk, menyerah sahaja
Dialog: 0,1:13:04.99,1:13:06.95,di sebalik tabir,,0,0,0,,dan hidup dengan tenang
Dialog: 0,1:13:09.04,1:13:10.67,di sebalik tabir,,0,0,0,,Ini adalah satu-satunya cara anda akan bertahan
Dialog: 0,1:13:40.95,1:13:42.20,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:13:44.37,1:13:45.87,teks umum,,0,0,0,,ambil pedang
Dialog: 0,1:14:18.94,1:14:19.78,teks umum,,0,0,0,,Meninggalkan
Dialog: 0,1:15:15.71,1:15:18.08,pratonton,,0,0,0,,Saya mahu memaparkannya dan menunjukkan kepada mereka
Dialog: 0,1:15:18.17,1:15:19.96,pratonton,,0,0,0,,- Adakah ini manifestasi kebodohan?\N- Tidak, kekuatan
Dialog: 0,1:15:20.04,1:15:21.05,pratonton,,0,0,0,,Teguhkan pendirian anda
Dialog: 0,1:15:21.13,1:15:23.26,pratonton,,0,0,0,,Ada pedang lain yang anda tidak boleh lukis
Dialog: 0,1:15:23.34,1:15:26.09,pratonton,,0,0,0,,Tetapi ia milik bapanya
Dialog: 0,1:15:26.18,1:15:28.43,pratonton,,0,0,0,,saya kena jemput dia
Dialog: 0,1:15:28.51,1:15:30.43,pratonton,,0,0,0,,Siapa yang menang akan mengambilnya
Dialog: 0,1:15:30.51,1:15:33.56,pratonton,,0,0,0,,Melawan putera raja adalah manifestasi kebodohan
Dialog: 0,1:15:33.64,1:15:37.06,pratonton,,0,0,0,,Tetapi ada yang percaya bahawa ini adalah tunjuk kekerasan. saya kena cuba
Dialog: 0,1:15:38.10,1:15:40.82,pratonton,,0,0,0,,Pelajar saya terlalu lemah untuk melawan anda
Dialog: 0,1:15:41.77,1:15:43.48,pratonton,,0,0,0,,Dia perlu diletakkan dalam bahaya sekali lagi
Dialog: 0,1:15:44.24,1:15:46.65,pratonton,,0,0,0,,Dan dia akan dapat apa yang dia mahu
Dialog: 0,0:02:57.14,0:02:59.14,nicks,,0,0,0,,

