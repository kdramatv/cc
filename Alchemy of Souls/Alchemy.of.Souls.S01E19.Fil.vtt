Dialogue: 0,0:02:47.24,0:02:52.24,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.24,0:02:57.24,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.24,0:03:02.24,nicks,,0,0,0,,Mga tagasalin ng Typesetter:{\c&HFFF4C5&} Ria_Lee, Mina_Mi, Zero Amamiya
Dialogue: 0,0:00:51.18,0:00:56.44,general text,,0,0,0,,Bu Young, saan mo naramdaman ang kapangyarihan ng ice stone?
Dialogue: 0,0:00:56.52,0:00:57.64,pangkalahatang teksto,,0,0,0,,Ama
Dialogue: 0,0:00:57.73,0:00:58.94,general text,,0,0,0,,Malapit na tayo
Dialogue: 0,0:01:00.27,0:01:03.57,pangkalahatang teksto,,0,0,0,,Bato sa isang lugar na malapit sa ilalim ng tubig
Dialogue: 0,0:01:10.12,0:01:13.29,pangkalahatang teksto,,0,0,0,,Sa tingin mo ba ay natagpuan niya ang batong yelo?
Dialogue: 0,0:01:13.87,0:01:14.95,general text,,0,0,0,,Oo, dapat siya
Dialogue: 0,0:01:15.91,0:01:17.58,pangkalahatang teksto,,0,0,0,,10 taon na ang nakakaraan ang aking guro na si Chang Gan
Dialogue: 0,0:01:17.67,0:01:20.29,pangkalahatang teksto,,0,0,0,,itinago ang bato dito sa Gyeongcheongdaeho Lake
Dialogue: 0,0:01:20.38,0:01:23.30,pangkalahatang teksto,,0,0,0,,At ngayon ang bato ay natagpuan ng isang batang babae na ipinanganak
Dialogue: 0,0:01:23.88,0:01:25.67,pangkalahatang teksto,,0,0,0,,gamit ang kapangyarihan ng bato
Dialogue: 0,0:01:27.01,0:01:30.76,general text,,0,0,0,,Sigurado akong anak ni Chang Gun si Boo Young
Dialogue: 0,0:01:31.64,0:01:34.10,pangkalahatang teksto,,0,0,0,,Ito ay nagpapaliwanag kung bakit niya iniligtas siya sa pamamagitan ng mahika
Dialogue: 0,0:01:35.77,0:01:37.43,general text,,0,0,0,,Hindi mo ba siya gusto?
Dialogue: 0,0:01:46.94,0:01:48.57,pangkalahatang teksto,,0,0,0,,Salamat sa babaeng ito
Dialogue: 0,0:01:48.65,0:01:51.78,general text,,0,0,0,,walang kwenta, nakapag-asawa ako
Dialogue: 0,0:01:52.87,0:01:55.24,pangkalahatang teksto,,0,0,0,,mga anak na babae ng pamilya Jin
Dialogue: 0,0:01:57.33,0:01:59.04,pangkalahatang teksto,,0,0,0,,dapat yata akong magpasalamat
Dialogue: 0,0:02:02.17,0:02:05.96,pangkalahatang teksto,,0,0,0,,Narito. Nasa ibaba namin ang bato
Dialogue: 0,0:02:17.85,0:02:20.60,behind the scenes,,0,0,0,,Mga kumplikado at selos ng Ama,
Dialogue: 0,0:02:20.69,0:02:23.44,offscreen,,0,0,0,,na humantong sa kamatayan ni Jin Bu Young
Dialogue: 0,0:02:25.90,0:02:27.15,pangkalahatang teksto,,0,0,0,,Bagay sa iyo
Dialogue: 0,0:02:28.19,0:02:31.41,pangkalahatang teksto,,0,0,0,,Kung gusto mo, gusto ko ito, nanay
Dialogue: 0,0:02:33.37,0:02:35.16,italics,,0,0,0,,Subukan natin ang iba
Dialogue: 0,0:02:38.75,0:02:40.37,behind the scenes,,0,0,0,,Ang hindi kapani-paniwalang lakas ni Jin Bu Young
Dialogue: 0,0:02:40.96,0:02:43.50,behind the scenes,,0,0,0,,nakuha niya ito hindi lamang sa kanyang ina, isang miyembro ng pamilya Jin
Dialogue: 0,0:02:44.42,0:02:48.88,behind the scenes,,0,0,0,,Malakas din siya salamat sa dugo ng kanyang ama, isang inapo ng fallen Choi family
Dialogue: 0,0:02:52.26,0:02:55.26,behind the scenes,,0,0,0,,Magkapatid na Choi, na nabuhay sa pagkukuwento,
Dialogue: 0,0:02:55.85,0:02:58.72,behind the scenes,,0,0,0,,ay ang mga inapo ng magician na si Choi, ang unang gumawa
Dialogue: 0,0:02:58.81,0:03:00.56,behind the scenes,,0,0,0,,alchemy of souls
Dialogue: 0,0:03:03.27,0:03:05.56,voiceover,,0,0,0,,Si Jin Bu Young ay inapo ng magkabilang pamilya,
Dialogue: 0,0:03:05.65,0:03:09.32,voiceover,,0,0,0,,na siyang naging pinakamalakas na priestess na nakita ng mundo
Dialogue: 0,0:03:10.69,0:03:12.24,pangkalahatang text,,0,0,0,,Nahanap mo na siya sa wakas
Dialogue: 0,0:03:13.32,0:03:14.16,pangkalahatang teksto,,0,0,0,,Boo Young,
Dialogue: 0,0:03:14.74,0:03:16.12,pangkalahatang teksto,,0,0,0,,bigyan mo ako ng bato
Dialogue: 0,0:03:28.30,0:03:29.46,pangkalahatang teksto,,0,0,0,,Ibalik ito!
Dialogue: 0,0:03:34.76,0:03:35.80,pangkalahatang teksto,,0,0,0,,Bu Young...
Dialogue: 0,0:03:36.39,0:03:38.18,pangkalahatang teksto,,0,0,0,,Boo Young
Dialogue: 0,0:03:40.06,0:03:41.14,pangkalahatang teksto,,0,0,0,,Bu Young!
Dialogue: 0,0:04:07.17,0:04:08.84,pangkalahatang teksto,,0,0,0,,Kumain
Dialogue: 0,0:04:09.92,0:04:11.34,general text,,0,0,0,,Eto, hawakan mo ang kutsara
Dialogue: 0,0:04:12.51,0:04:14.63,general text,,0,0,0,,Sayang na bulag ka
Dialogue: 0,0:04:14.72,0:04:17.43,pangkalahatang teksto,,0,0,0,,Ang pinakamasama ay hindi mo na matandaan ang iyong pangalan
Dialogue: 0,0:04:19.89,0:04:22.02,general text,,0,0,0,,Gusto mo bang tumira sa akin?
Dialogue: 0,0:04:22.89,0:04:26.65,pangkalahatang teksto,,0,0,0,,Ang pangalan ng namatay kong apo ay Mu Dok
Dialogue: 0,0:04:26.73,0:04:27.90,general text,,0,0,0,,Pwede ba kitang tawagan?
Dialogue: 0,0:04:30.48,0:04:31.98,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:04:32.07,0:04:33.61,general text,,0,0,0,,Mula ngayon ikaw na si Moo Deok
Dialogue: 0,0:04:34.53,0:04:36.15,pangkalahatang teksto,,0,0,0,,Napakatamis
Dialogue: 0,0:04:36.24,0:04:38.12,italics,,0,0,0,,Kain na tayo
Dialogue: 0,0:04:44.16,0:04:45.54,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,0:05:28.17,0:05:29.33,pangkalahatang teksto,,0,0,0,,Ina
Dialogue: 0,0:05:36.76,0:05:38.30,mga alaala,,0,0,0,,Bu Young...
Dialogue: 0,0:05:53.77,0:05:54.98,pangkalahatang teksto,,0,0,0,,Paano ito posible?
Dialogue: 0,0:05:56.78,0:05:59.74,general text,,0,0,0,,Nangyari ito noong araw na nawala si Bu Young
Dialogue: 0,0:06:12.75,0:06:14.25,pangkalahatang text,,0,0,0,,Hindi na bumalik si Moo Dok
Dialogue: 0,0:06:14.34,0:06:17.71,general text,,0,0,0,,Malamang na pinatay siya ng nomad at si Chan Wook
Dialogue: 0,0:06:17.80,0:06:20.13,pangkalahatang teksto,,0,0,0,,Pagkatapos ay mamamatay tayong lahat
Dialogue: 0,0:06:26.56,0:06:27.68,pangkalahatang teksto,,0,0,0,,Jin Bu Young
Dialogue: 0,0:06:27.77,0:06:30.48,general text,,0,0,0,,Ikaw mismo ang nagdala ng bato kay Jinyeowon
Dialogue: 0,0:06:31.23,0:06:33.48,general text,,0,0,0,,Ikaw ay isang pari, ngunit hindi mo siya makontrol?
Dialogue: 0,0:06:34.90,0:06:37.73,general text,,0,0,0,,Sinunod ko ang utos ng aking ina
Dialogue: 0,0:06:38.61,0:06:39.82,general text,,0,0,0,,Nakakaawa ka
Dialogue: 0,0:06:41.36,0:06:44.20,general text,,0,0,0,,Kaya nawalan ng maraming dugo si Yul
Dialogue: 0,0:06:45.03,0:06:47.54,pangkalahatang teksto,,0,0,0,,Kung walang pagsasalin ng dugo maaari siyang mamatay
Dialogue: 0,0:06:48.41,0:06:50.71,pangkalahatang teksto,,0,0,0,,Kung kailangan mo ng dugo, maaari mong kunin ang akin
Dialogue: 0,0:06:50.79,0:06:53.08,pangkalahatang teksto,,0,0,0,,Hindi ka maaaring mag-spell dito,
Dialogue: 0,0:06:53.17,0:06:55.00,general text,,0,0,0,,para hindi magamit ang dugo mo
Dialogue: 0,0:07:02.55,0:07:03.93,mga alaala na italics,,0,0,0,,Iabot ang iyong kamay
Dialogue: 0,0:07:13.65,0:07:16.69,mga alaala,,0,0,0,,Isang uod mula sa dugo ng aking anak na si Cho Young
Dialogue: 0,0:07:16.77,0:07:19.57,memories italics,,0,0,0,,ay magbibigay sa iyo ng kapangyarihan ng pamilya Jin
Dialogue: 0,0:07:22.82,0:07:26.41,italics,,0,0,0,,Niloko tayong lahat ni Chan Wook
Dialogue: 0,0:07:28.74,0:07:32.04,pangkalahatang teksto,,0,0,0,,Halili sa pagbabasa ng "Words of the Heart", Mages of the Unified Council.
Dialogue: 0,0:07:32.12,0:07:34.12,pangkalahatang teksto,,0,0,0,,ngunit walang salita tungkol sa bato
Dialogue: 0,0:07:34.21,0:07:36.84,pangkalahatang teksto,,0,0,0,,Walang higit sa isang tula
Dialogue: 0,0:07:40.38,0:07:42.26,pangkalahatang teksto,,0,0,0,,Ano ang sasabihin ni Sosnovy Bor dito?
Dialogue: 0,0:07:45.30,0:07:46.72,pangkalahatang teksto,,0,0,0,,Nabasa ito ng lahat ng salamangkero,
Dialogue: 0,0:07:47.68,0:07:49.81,pangkalahatang teksto,,0,0,0,,ngunit walang nakakaalam
Dialogue: 0,0:07:57.11,0:07:59.98,mga alaala,,0,0,0,,"Salita ng puso" - isang love letter
Dialogue: 0,0:08:00.07,0:08:01.40,mga alaala,,0,0,0,,Master Seo Kyung
Dialogue: 0,0:08:01.49,0:08:04.20,mga alaala,,0,0,0,,Mensahe?
Dialogue: 0,0:08:04.78,0:08:08.33,mga alaala,,0,0,0,,Liham ng Pag-ibig kay Jin Seol Ran,
Dialogue: 0,0:08:08.41,0:08:09.87,mga alaala,,0,0,0,,ang unang kabanata ng Jinyeowon
Dialogue: 0,0:08:11.29,0:08:15.37,general text,,0,0,0,,Ito ay isang pag-amin na hindi niya sinira ang bato dahil
Dialogue: 0,0:08:16.12,0:08:19.50,general text,,0,0,0,,na hindi ko kayang bitawan ang mahal kong naghihingalo.
Dialogue: 0,0:08:21.59,0:08:23.51,general text,,0,0,0,,So, Master So Kyung
Dialogue: 0,0:08:23.59,0:08:26.93,general text,,0,0,0,,hindi nasira ang bato dahil sa pag-ibig?
Dialogue: 0,0:08:27.89,0:08:29.55,general text,,0,0,0,,Sinusubukan ka niyang lokohin
Dialogue: 0,0:08:30.14,0:08:33.73,general text,,0,0,0,,mapapatunayan kong love letter ito
Dialogue: 0,0:08:35.56,0:08:38.11,pangkalahatang teksto,,0,0,0,,Sapat na pangalanan ang pangalan ng tatanggap sa iyong isip
Dialogue: 0,0:08:38.69,0:08:42.07,pangkalahatang teksto,,0,0,0,,at mababasa mo mismo ang liham na ito, Kamahalan
Dialogue: 0,0:08:42.15,0:08:43.86,general text,,0,0,0,,Nababasa ko ang tula
Dialogue: 0,0:08:44.99,0:08:46.66,pangkalahatang teksto,,0,0,0,,kahit hindi isang salamangkero?
Dialogue: 0,0:08:47.36,0:08:48.70,italics,,0,0,0,,Pangalan ng tatanggap
Dialogue: 0,0:08:48.78,0:08:53.08,pangkalahatang teksto,,0,0,0,, ay magpapaalala sa iyo ng "isang bulaklak ng orchid na nababalutan ng niyebe"
Dialogue: 0,0:08:55.00,0:08:56.50,pangkalahatang teksto,,0,0,0,,Ito si Sol Ran
Dialogue: 0,0:08:57.87,0:08:59.21,pangkalahatang teksto,,0,0,0,,"Salt Ran"?
Dialogue: 0,0:09:31.53,0:09:34.95,general text,,0,0,0,,"Nakikita ko ang asul na kalangitan. Isang tahimik na buntong-hininga ang narinig"
Dialogue: 0,0:09:43.42,0:09:46.88,general text,,0,0,0,,"Alam kong mapupuno na naman ng luha ang mga mata ko"
Dialogue: 0,0:09:47.97,0:09:49.13,pangkalahatang text,,0,0,0,,"Ngunit ako ay isang tanga,"
Dialogue: 0,0:09:49.72,0:09:53.01,pangkalahatang text,,0,0,0,, "hindi dumaloy sa pisngi ko"
Dialogue: 0,0:09:54.22,0:09:56.39,italics,,0,0,0,,"wala ni isang luha"
Dialogue: 0,0:09:58.73,0:10:00.40,general text,,0,0,0,,Ito ang kanyang pagtatapat
Dialogue: 0,0:10:00.48,0:10:03.90,general text,,0,0,0,,na hindi niya sinira ang bato alang-alang sa kanyang minamahal
Dialogue: 0,0:10:07.49,0:10:09.53,pangkalahatang teksto,,0,0,0,,Ngunit namatay ang ulo na si Jin Seol Ran
Dialogue: 0,0:10:09.61,0:10:11.62,pangkalahatang teksto,,0,0,0,,pagkalipas ng halos anim na buwan
Dialogue: 0,0:10:11.70,0:10:16.08,pangkalahatang teksto,,0,0,0,,pagkatapos ng pagkakatatag ng Jinyaewon dahil sa mga pinsalang natanggap sa panahon ng Great Chaos
Dialogue: 0,0:10:16.16,0:10:17.58,pangkalahatang teksto,,0,0,0,,Kung para sa kanya ang bato,
Dialogue: 0,0:10:17.66,0:10:19.83,general text,,0,0,0,,bakit hindi niya ito ginamit at iligtas ang sarili?
Dialogue: 0,0:10:20.46,0:10:24.25,pangkalahatang teksto,,0,0,0,,Sigurado ako na ito ay para hindi malaman ng mundo
Dialogue: 0,0:10:24.92,0:10:26.67,pangkalahatang teksto,,0,0,0,,gayong mapanganib na kapangyarihan
Dialogue: 0,0:10:27.84,0:10:31.30,pangkalahatang teksto,,0,0,0,,Sino ang tatanggi sa gayong kapangyarihan?
Dialogue: 0,0:10:31.38,0:10:32.80,pangkalahatang teksto,,0,0,0,,Ang taong katulad mo
Dialogue: 0,0:10:33.85,0:10:36.31,pangkalahatang teksto,,0,0,0,, hindi kailanman magiging katulad niya
Dialogue: 0,0:10:36.39,0:10:39.10,pangkalahatang teksto,,0,0,0,,At ginawa niya ito para sa kapakanan ng sangkatauhan
Dialogue: 0,0:10:40.48,0:10:41.73,pangkalahatang teksto,,0,0,0,,Ginawa ang tama
Dialogue: 0,0:10:43.44,0:10:45.90,pangkalahatang teksto,,0,0,0,,Upang protektahan ang nararapat
Dialogue: 0,0:10:48.36,0:10:53.62,pangkalahatang teksto,,0,0,0,,minsan kailangan ng isang tao na isuko ang lahat
Dialogue: 0,0:11:10.42,0:11:12.26,pangkalahatang teksto,,0,0,0,,Mula nang kinuha mo ang espada,
Dialogue: 0,0:11:13.68,0:11:15.39,pangkalahatang teksto,,0,0,0,,piliin mo
Dialogue: 0,0:11:20.14,0:11:21.64,general text,,0,0,0,,Alam kong iniiwasan mo ako
Dialogue: 0,0:11:21.73,0:11:24.73,pangkalahatang teksto,,0,0,0,,Alam kong nasa iyong mga kamay ang aming buhay
Dialogue: 0,0:11:27.07,0:11:30.74,general text,,0,0,0,,Tulad ng pangako, ituro mo muna ang iyong espada sa akin
Dialogue: 0,0:11:43.12,0:11:45.08,mga alaala na italics,,0,0,0,,Ang sobrang enerhiya ay hahantong sa
Dialogue: 0,0:11:45.17,0:11:47.84,mga alaala na italics,,0,0,0,,na hindi mo makontrol ang kapangyarihang ginagamit mo
Dialogue: 0,0:11:48.80,0:11:51.42,memories,,0,0,0,,Kung gusto mo ng ulan, magkakaroon ka ng baha
Dialogue: 0,0:11:52.17,0:11:54.76,memories,,0,0,0,,Kung gusto mo ng hangin, magkakaroon ka ng bagyo
Dialogue: 0,0:11:54.84,0:11:56.51,mga alaala,,0,0,0,,Subukan mong makayanan
Dialogue: 0,0:11:56.59,0:11:59.47,memories,,0,0,0,,So, hindi ko makokontrol ang kapangyarihang ito?
Dialogue: 0,0:12:00.77,0:12:03.60,mga alaala,,0,0,0,,Isang bagay na magagawa mo ng sarili mong kusang loob
Dialogue: 0,0:12:05.85,0:12:07.02,mga alaala,,0,0,0,,Huwag gamitin ito
Dialogue: 0,0:12:08.36,0:12:11.65,mga alaala,,0,0,0,,Nasa iyo ang pagpipilian: gumamit ng puwersa o hindi
Dialogue: 0,0:12:25.37,0:12:27.33,pangkalahatang teksto,,0,0,0,,Ngayon, gaya ng sinabi mo,
Dialogue: 0,0:12:29.42,0:12:31.05,general text,,0,0,0,,bigyan mo ako ng isa pang pangako
Dialogue: 0,0:12:47.77,0:12:49.11,italics,,0,0,0,,Sa mga bituin
Dialogue: 0,0:12:49.19,0:12:52.48,italics,,0,0,0,,mayroong pinakamalungkot - the King's star
Dialogue: 0,0:12:54.61,0:12:56.78,pangkalahatang teksto,,0,0,0,,Anong uri ng bituin ito?
Dialogue: 0,0:12:57.49,0:12:58.82,pangkalahatang teksto,,0,0,0,,Ipinanganak sa ilalim ng kanyang tanda
Dialogue: 0,0:12:58.91,0:13:01.20,pangkalahatang teksto,,0,0,0,,makokontrol ang enerhiya ng langit
Dialogue: 0,0:13:01.28,0:13:03.87,general text,,0,0,0,,So magiging strong yung tao?
Dialogue: 0,0:13:03.95,0:13:05.62,pangkalahatang teksto,,0,0,0,,Mabuti iyan
Dialogue: 0,0:13:06.50,0:13:09.96,pangkalahatang teksto,,0,0,0,,Paano sasabihin... Ito ay hindi palaging isang bagay na mabuti
Dialogue: 0,0:13:10.04,0:13:12.00,pangkalahatang teksto,,0,0,0,,Ang mas malaki ang kapangyarihan -
Dialogue: 0,0:13:12.09,0:13:14.05,pangkalahatang teksto,,0,0,0,,mas malaki ang responsibilidad
Dialogue: 0,0:13:14.13,0:13:16.09,pangkalahatang teksto,,0,0,0,,Ano ang "responsibilidad"?
Dialogue: 0,0:13:16.17,0:13:18.64,general text,,0,0,0,,Ito ay kapag kailangan mong gawin ang isang bagay na hindi mo gustong gawin,
Dialogue: 0,0:13:18.72,0:13:20.97,pangkalahatang teksto,,0,0,0,,kahit na malungkot at nalulungkot ka mamaya
Dialogue: 0,0:13:21.05,0:13:24.60,general text,,0,0,0,,Ajusshi, pwede ba akong kumain nito?
Dialogue: 0,0:13:25.81,0:13:26.77,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:13:27.81,0:13:30.73,general text,,0,0,0,,- Dapat binigay ko kanina\N- Salamat
Dialogue: 0,0:13:30.81,0:13:34.48,general text,,0,0,0,,Wag mo lang silang awayin
Dialogue: 0,0:13:34.57,0:13:36.15,pangkalahatang teksto,,0,0,0,,Okay. Pumunta kami
Dialogue: 0,0:13:46.54,0:13:48.25,pangkalahatang teksto,,0,0,0,,Malapit nang lumitaw ang bituin
Dialogue: 0,0:13:49.37,0:13:52.29,general text,,0,0,0,,Tapos yung mga dapat mawala,
Dialogue: 0,0:13:52.38,0:13:54.92,pangkalahatang teksto,,0,0,0,,at babalik ang mga nangangailangan nito
Dialogue: 0,0:14:01.93,0:14:05.77,pangkalahatang teksto,,0,0,0,,Hinahanap ng Crown Prince ang lugar na ito
Dialogue: 0,0:14:06.43,0:14:08.48,pangkalahatang teksto,,0,0,0,,Ang tindahan kung saan bawat buwan
Dialogue: 0,0:14:08.56,0:14:10.94,pangkalahatang teksto,,0,0,0,,naglakad si eunuch Kim, ang alipin ng reyna
Dialogue: 0,0:14:11.02,0:14:13.27,pangkalahatang teksto,,0,0,0,,Alam mo ang iyong paraan sa paligid
Dialogue: 0,0:14:13.98,0:14:16.44,general text,,0,0,0,,At ang anting-anting na iyon, upang ang minamahal ay umibig...
Dialogue: 0,0:14:16.53,0:14:17.86,general text,,0,0,0,,Nakuha mo ba dito?
Dialogue: 0,0:14:19.07,0:14:22.16,general text,,0,0,0,,Hindi man lang gumana, itigil mo na ang pagpapatawa sa akin
Dialogue: 0,0:14:22.74,0:14:26.20,pangkalahatang teksto,,0,0,0,,Paano ito "hindi gumana"? Magkasama kami ngayon
Dialogue: 0,0:14:27.54,0:14:28.50,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,0:14:28.58,0:14:31.33,general text,,0,0,0,,We're not on a date
Dialogue: 0,0:14:39.88,0:14:43.01,general text,,0,0,0,,Bakit siya nandito?
Dialogue: 0,0:14:45.01,0:14:47.27,mga inskripsiyon,,0,0,0,,Tindahan ng Herbalist
Dialogue: 0,0:14:48.31,0:14:49.48,pangkalahatang teksto,,0,0,0,,Ama?
Dialogue: 0,0:15:27.51,0:15:29.77,pangkalahatang teksto,,0,0,0,,Mamulat ka
Dialogue: 0,0:15:29.85,0:15:32.44,pangkalahatang teksto,,0,0,0,,Sinubukan nilang saktan muli ang kanilang sarili, Kamahalan
Dialogue: 0,0:15:32.52,0:15:34.60,general text,,0,0,0,,Bakit mo ako binubuhay?
Dialogue: 0,0:15:35.36,0:15:37.52,general text,,0,0,0,,Patay na lang
Dialogue: 0,0:15:37.61,0:15:40.82,pangkalahatang teksto,,0,0,0,,Hindi pa. Queen's Lantern of Life
Dialogue: 0,0:15:41.65,0:15:44.49,general text,,0,0,0,,dapat masunog habang nabubuhay pa ang katawan ng reyna
Dialogue: 0,0:15:47.78,0:15:50.45,general text,,0,0,0,,Nakakatakot na tingnan mo ako ng ganyan
Dialogue: 0,0:15:51.58,0:15:53.96,pangkalahatang text,,0,0,0,,na may mukha ng kapatid ko
Dialogue: 0,0:15:54.04,0:15:56.29,general text,,0,0,0,,Hindi ka dapat magalit sa akin
Dialogue: 0,0:15:56.38,0:15:58.17,general text,,0,0,0,,Ang naglagay nito ang may kasalanan
Dialogue: 0,0:15:59.34,0:16:01.38,general text,,0,0,0,,kami ng kapatid ko ang nasa ganitong sitwasyon
Dialogue: 0,0:16:13.31,0:16:15.81,mga alaala,,0,0,0,,Shaman Choi, sinumpa at sinaktan mo ang mga tao
Dialogue: 0,0:16:15.90,0:16:17.94,mga alaala,,0,0,0,,gamit ang mga ipinagbabawal na spell
Dialogue: 0,0:16:18.90,0:16:20.40,mga alaala,,0,0,0,,Aminin mo ba ang iyong mga kasalanan?
Dialogue: 0,0:16:25.99,0:16:29.78,mga alaala,,0,0,0,,Ginawa ko para sa pera ang hiniling ng mga tao
Dialogue: 0,0:16:29.87,0:16:33.50,memories,,0,0,0,,Kasalanan ng mga humiling sa akin na sumpain ang isang tao
Dialogue: 0,0:16:33.58,0:16:35.42,mga alaala,,0,0,0,,Ang sumpa mo ay humantong sa kamatayan!
Dialogue: 0,0:16:36.46,0:16:38.33,memories,,0,0,0,,Nagpapanggap ka bang inosente?
Dialogue: 0,0:16:42.01,0:16:44.72,mga alaala,,0,0,0,,Mga spelling na maaaring pumatay...
Dialogue: 0,0:16:44.80,0:16:46.34,mga alaala,,0,0,0,,Namangha sa iyong lakas
Dialogue: 0,0:16:46.97,0:16:48.09,mga alaala,,0,0,0,,Ang kapangyarihang ito
Dialogue: 0,0:16:49.01,0:16:53.47,mga alaala,,0,0,0,,maaaring sapat na para patayin ka
Dialogue: 0,0:16:58.73,0:17:02.78,mga alaala,,0,0,0,,Hanapin ang lahat ng spell book, lahat ng ginamit niya!
Dialogue: 0,0:17:02.86,0:17:03.78,mga alaala,,0,0,0,,- Oo!\N- Oo!
Dialogue: 0,0:17:21.25,0:17:22.92,mga alaala,,0,0,0,,Hindi, hindi iyon!
Dialogue: 0,0:17:23.80,0:17:25.05,mga alaala,,0,0,0,,Kami ay isang mahirap na pamilya,
Dialogue: 0,0:17:25.13,0:17:27.13,mga alaala,,0,0,0,,pero ito ang pamana ng aming pamilya
Dialogue: 0,0:17:27.22,0:17:29.51,memories,,0,0,0,,Hindi ako nanghula sa kanya!
Dialogue: 0,0:17:29.59,0:17:30.76,mga alaala,,0,0,0,,Huwag masunog
Dialogue: 0,0:17:31.35,0:17:32.51,mga inskripsiyon,,0,0,0,,Chongan
Dialogue: 0,0:17:32.60,0:17:33.77,mga alaala,,0,0,0,,Ito ay isang libro ng mga spells
Dialogue: 0,0:17:33.85,0:17:34.89,mga alaala,,0,0,0,,Hindi...
Dialogue: 0,0:17:35.68,0:17:36.60,mga alaala,,0,0,0,,Paso
Dialogue: 0,0:17:39.52,0:17:43.27,mga alaala,,0,0,0,,Hindi!
Dialogue: 0,0:17:43.78,0:17:45.19,mga inskripsiyon,,0,0,0,,Chongan
Dialogue: 0,0:18:01.54,0:18:03.13,pangkalahatang teksto,,0,0,0,,Patayin ang apoy. Magmadali!
Dialogue: 0,0:18:03.21,0:18:04.25,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:18:10.05,0:18:15.10,mga inskripsiyon,,0,0,0,,Chongan
Dialogue: 0,0:18:23.11,0:18:25.40,mga inskripsiyon,,0,0,0,,Alchemy of souls
Dialogue: 0,0:18:25.98,0:18:27.53,mga alaala,,0,0,0,,"Alchemy of Souls"?
Dialogue: 0,0:18:41.71,0:18:43.04,mga alaala,,0,0,0,,Pasensya na ate
Dialogue: 0,0:19:01.39,0:19:03.27,italics,,0,0,0,,Sa kanya nagsimula ang lahat
Dialogue: 0,0:19:03.35,0:19:04.90,general text,,0,0,0,,Iniwan niya ang mga peklat na ito
Dialogue: 0,0:19:04.98,0:19:08.15,general text,,0,0,0,,Dahil sa kanya, inilipat ng kapatid ko ang kanyang kaluluwa sa iyong katawan
Dialogue: 0,0:19:08.23,0:19:10.24,general text,,0,0,0,,Kasalanan niya
Dialogue: 0,0:19:11.65,0:19:12.82,pangkalahatang teksto,,0,0,0,,Chan Gan
Dialogue: 0,0:19:14.62,0:19:15.66,pangkalahatang teksto,,0,0,0,,Chan...
Dialogue: 0,0:19:16.53,0:19:18.16,pangkalahatang teksto,,0,0,0,,Gan...
Dialogue: 0,0:19:19.50,0:19:21.16,general text,,0,0,0,,Hindi ka pa pwedeng mamatay
Dialogue: 0,0:19:21.96,0:19:23.83,pangkalahatang text,,0,0,0,,Tumira sa katawan ng kapatid ko
Dialogue: 0,0:19:25.04,0:19:26.34,pangkalahatang teksto,,0,0,0,,konti na lang,
Dialogue: 0,0:19:27.34,0:19:28.38,general text,,0,0,0,,Your Highness
Dialogue: 0,0:19:33.76,0:19:36.26,pangkalahatang teksto,,0,0,0,,Mahigit sampung taon na ang nakalipas mula nang makuha ko ang katawan na ito
Dialogue: 0,0:19:37.43,0:19:40.77,general text,,0,0,0,,Pero sa tuwing nagkakamalay siya, naaapektuhan ako
Dialogue: 0,0:19:41.73,0:19:44.73,general text,,0,0,0,,Kung hindi dahil sa parol ng Buhay, pinatay ko na siya
Dialogue: 0,0:19:44.81,0:19:47.36,general text,,0,0,0,,Dalhan siya ng iyong kapatid ng gamot
Dialogue: 0,0:19:48.44,0:19:50.36,pangkalahatang teksto,,0,0,0,,Malapit ka nang bumuti
Dialogue: 0,0:19:51.78,0:19:52.78,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,0:19:54.20,0:19:56.82,pangkalahatang teksto,,0,0,0,,Paano napunta ang bato sa Chongjingak?
Dialogue: 0,0:19:56.91,0:19:58.62,general text,,0,0,0,,Malamang nagkamali si Jin Ho Kyung,
Dialogue: 0,0:19:58.70,0:20:00.75,pangkalahatang teksto,,0,0,0,,dahil ginamit ko ang bato sa unang pagkakataon
Dialogue: 0,0:20:01.75,0:20:03.21,pangkalahatang teksto,,0,0,0,,Pagdating ng oras,
Dialogue: 0,0:20:04.00,0:20:07.04,pangkalahatang teksto,,0,0,0,,Ginagamit ko ang kapangyarihan ng bato para sa alchemy ng mga kaluluwa
Dialogue: 0,0:20:09.30,0:20:12.63,pangkalahatang teksto,,0,0,0,,Kung gagawin mo ito ngayon, mamamatay ang lahat sa Jeongjingak
Dialogue: 0,0:20:12.72,0:20:13.84,pangkalahatang teksto,,0,0,0,,Oo, alam ko
Dialogue: 0,0:20:14.38,0:20:15.97,general text,,0,0,0,,Nandoon din ang Crown Prince
Dialogue: 0,0:20:17.80,0:20:18.97,pangkalahatang teksto,,0,0,0,,Ano kaya?
Dialogue: 0,0:20:20.52,0:20:23.06,general text,,0,0,0,,Dapat nating hintayin na mailigtas siya mula doon
Dialogue: 0,0:20:23.14,0:20:24.56,pangkalahatang teksto,,0,0,0,,Pagkatapos ay maaari mong kolektahin ang kapangyarihan ng bato
Dialogue: 0,0:20:24.64,0:20:26.02,general text,,0,0,0,,Paano kung hindi nila siya iligtas?
Dialogue: 0,0:20:27.10,0:20:29.15,general text,,0,0,0,,Uupo na lang ba ako at maghintay?
Dialogue: 0,0:20:29.23,0:20:32.74,pangkalahatang teksto,,0,0,0,,Paano kung may mas nauna sa akin?
Dialogue: 0,0:20:32.82,0:20:36.41,general text,,0,0,0,,Sa kabutihang palad, walang ginagawa, naka-alerto lang ang lahat
Dialogue: 0,0:20:37.66,0:20:41.58,general text,,0,0,0,,Kailangan nating humanap ng paraan para mailigtas ang Crown Prince
Dialogue: 0,0:20:55.72,0:20:56.88,mga alaala,,0,0,0,,Ina
Dialogue: 0,0:21:03.43,0:21:04.81,general text,,0,0,0,,narinig ko
Dialogue: 0,0:21:05.56,0:21:07.23,general text,,0,0,0,,Bakit niya ako tatawagin ng ganyan?
Dialogue: 0,0:21:08.10,0:21:09.27,pangkalahatang teksto,,0,0,0,,Tawanan at wala na
Dialogue: 0,0:21:16.15,0:21:17.20,pangkalahatang teksto,,0,0,0,,Lahat
Dialogue: 0,0:21:18.78,0:21:21.03,pangkalahatang teksto,,0,0,0,,mas nag-aalala tungkol sa batong yelo,
Dialogue: 0,0:21:23.04,0:21:25.54,pangkalahatang teksto,,0,0,0,,kaysa sa mga bata na naka-lock doon
Dialogue: 0,0:21:27.21,0:21:30.04,pangkalahatang teksto,,0,0,0,,Ikaw at ako ay dapat subukang sirain ang hadlang
Dialogue: 0,0:21:31.75,0:21:34.67,pangkalahatang teksto,,0,0,0,,Gumawa tayo ng walang pahintulot ng konseho,
Dialogue: 0,0:21:35.38,0:21:37.09,general text,,0,0,0,,may eskandalo na naman
Dialogue: 0,0:21:39.01,0:21:41.35,pangkalahatang teksto,,0,0,0,,Ang bato ay kay Jinyeowon
Dialogue: 0,0:21:41.43,0:21:44.06,pangkalahatang teksto,,0,0,0,,Walang karapatan si Sosnovy Bor na magdesisyon
Dialogue: 0,0:21:44.14,0:21:45.18,pangkalahatang teksto,,0,0,0,,Kabanata Jin,
Dialogue: 0,0:21:45.73,0:21:49.56,pangkalahatang teksto,,0,0,0,,hindi talaga umalis ang bato sa mga dingding ng Jinyeowon
Dialogue: 0,0:21:49.65,0:21:51.94,pangkalahatang teksto,,0,0,0,,sa nakalipas na 200 taon?
Dialogue: 0,0:21:54.57,0:21:57.28,italics,,0,0,0,,Sabi mo minsan napasok na ng magician ni Sosnovy Bor si Jinyeowon
Dialogue: 0,0:21:57.78,0:21:59.07,pangkalahatang teksto,,0,0,0,,Ito ay random
Dialogue: 0,0:22:01.07,0:22:02.33,pangkalahatang teksto,,0,0,0,,hindi ba si Chang Gan?
Dialogue: 0,0:22:06.33,0:22:08.04,general text,,0,0,0,,Nagtanong ako
Dialogue: 0,0:22:09.04,0:22:12.79,general text,,0,0,0,,Nagamit na ba ni Chang Gang ang bato?
Dialogue: 0,0:22:24.31,0:22:26.22,mga alaala,,0,0,0,,Hindi gumagalaw ang sanggol sa loob
Dialogue: 0,0:22:26.31,0:22:28.02,mga alaala,,0,0,0,, binuhat ko siya sa loob ng 13 buwan
Dialogue: 0,0:22:28.89,0:22:30.02,mga alaala,,0,0,0,,Hindi ko siya kayang bitawan
Dialogue: 0,0:22:32.36,0:22:33.61,mga alaala,,0,0,0,,Kailangan ko siyang iligtas
Dialogue: 0,0:22:34.23,0:22:35.94,mga alaala,,0,0,0,,I'm sorry
Dialogue: 0,0:22:36.98,0:22:38.69,mga alaala,,0,0,0,,Patay na siya
Dialogue: 0,0:22:43.87,0:22:45.20,mga alaala,,0,0,0,,Sa Jinyeowon
Dialogue: 0,0:22:46.91,0:22:47.87,mga alaala,,0,0,0,,may yelong bato
Dialogue: 0,0:22:49.83,0:22:51.17,mga alaala,,0,0,0,,Ice stone?
Dialogue: 0,0:22:51.25,0:22:53.67,mga alaala,,0,0,0,,Bakit surprise? Naghinala ka na
Dialogue: 0,0:22:53.75,0:22:57.09,mga alaala,,0,0,0,,Maraming beses mong hiniling na pumunta kay Jinyeowon
Dialogue: 0,0:22:57.92,0:23:00.55,mga alaala,,0,0,0,,Alam kong gusto mong humanap ng bato doon
Dialogue: 0,0:23:04.14,0:23:05.76,mga alaala,,0,0,0,,Sabi nila kaya ng bato
Dialogue: 0,0:23:05.85,0:23:09.89,mga alaala,,0,0,0,,buhayin ang patay
Dialogue: 0,0:23:11.31,0:23:12.48,mga alaala,,0,0,0,,Wala akong sapat na lakas
Dialogue: 0,0:23:14.19,0:23:15.90,mga alaala,,0,0,0,,kontrolin ang bato
Dialogue: 0,0:23:16.73,0:23:17.82,mga alaala,,0,0,0,,Pero sa iyo, Chang Gan
Dialogue: 0,0:23:18.69,0:23:20.78,mga alaala,,0,0,0,,maaaring sapat na ang lakas
Dialogue: 0,0:23:22.95,0:23:25.03,memories,,0,0,0,,Hinihiling mo bang gumamit ng dark magic?
Dialogue: 0,0:23:25.12,0:23:27.79,mga alaala,,0,0,0,,Gagawin ko ang lahat para mailigtas ang anak ko
Dialogue: 0,0:23:30.58,0:23:31.54,mga alaala,,0,0,0,,Pakiusap
Dialogue: 0,0:23:32.75,0:23:34.92,mga alaala,,0,0,0,,Tulungan mo akong iligtas siya
Dialogue: 0,0:23:45.68,0:23:49.39,voiceover,,0,0,0,,Noong gabing iyon binuksan ko ang pinto ni Jinyoewon at pinapasok siya.
Dialogue: 0,0:23:50.02,0:23:52.31,voiceover,,0,0,0,, umaasa na ililigtas niya ang aking anak na babae
Dialogue: 0,0:23:53.35,0:23:56.98,behind the scenes,,0,0,0,,At bilang resulta, nawala ang yelong bato ni Jinyeowon
Dialogue: 0,0:24:05.36,0:24:06.66,pangkalahatang teksto,,0,0,0,,Kahit na,
Dialogue: 0,0:24:07.66,0:24:09.91,pangkalahatang teksto,,0,0,0,,may higit na pagkakasala sa likod ni Sosnovy Bor
Dialogue: 0,0:24:09.99,0:24:13.54,pangkalahatang teksto,,0,0,0,,Ang iyong salamangkero ay palaging naglalarawan ng mga matuwid, ngunit pa rin
Dialogue: 0,0:24:13.62,0:24:15.46,pangkalahatang teksto,,0,0,0,,kinuha ang yelong bato
Dialogue: 0,0:24:15.54,0:24:18.96,pangkalahatang teksto,,0,0,0,,Gumawa ng alchemy ng mga kaluluwa at nagdulot ng kaguluhan sa mundo
Dialogue: 0,0:24:21.59,0:24:23.76,general text,,0,0,0,,Kaya gusto kong itago ito
Dialogue: 0,0:24:25.18,0:24:26.22,pangkalahatang teksto,,0,0,0,,Ngunit
Dialogue: 0,0:24:27.43,0:24:30.64,general text,,0,0,0,,Gagawin ko ang lahat para ibunyag ang katotohanan at itama ang lahat,
Dialogue: 0,0:24:31.77,0:24:34.23,pangkalahatang teksto,,0,0,0,,kahit kailangan mong ibunyag ang mga kasalanan ni Sosnovy Bor
Dialogue: 0,0:24:35.98,0:24:37.40,pangkalahatang teksto,,0,0,0,,at parusahan ang nagkasala
Dialogue: 0,0:24:41.11,0:24:44.82,pangkalahatang teksto,,0,0,0,,Pagkatapos ay kailangan mong humatol sa taong mahal mo
Dialogue: 0,0:24:47.20,0:24:48.53,pangkalahatang teksto,,0,0,0,,Hindi ito magiging madali
Dialogue: 0,0:24:50.58,0:24:51.79,pangkalahatang teksto,,0,0,0,,Alam ko
Dialogue: 0,0:24:54.16,0:24:55.12,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,0:24:55.87,0:25:00.09,general text,,0,0,0,,kung ito lang ang paraan para maayos ang sitwasyon,
Dialogue: 0,0:25:03.30,0:25:05.67,general text,,0,0,0,,Gagawin ko
Dialogue: 0,0:25:15.52,0:25:17.69,pangkalahatang teksto,,0,0,0,,Papalitan ng kaluluwa ng kapatid ko ang iyong katawan
Dialogue: 0,0:25:17.77,0:25:21.69,general text,,0,0,0,,sa katawan ng isang batang babae na nagpapanggap na panganay kong anak.
Dialogue: 0,0:25:22.48,0:25:24.07,italics,,0,0,0,,Pagkatapos
Dialogue: 0,0:25:24.15,0:25:27.74,general text,,0,0,0,,Papatayin kita, gaya ng hinihiling mo
Dialogue: 0,0:25:43.00,0:25:44.05,pangkalahatang teksto,,0,0,0,,Cho Young,
Dialogue: 0,0:25:46.09,0:25:47.30,italics,,0,0,0,,ano...
Dialogue: 0,0:25:47.38,0:25:48.72,general text,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:25:51.51,0:25:52.72,pangkalahatang teksto,,0,0,0,,Ama,
Dialogue: 0,0:25:53.81,0:25:54.93,pangkalahatang teksto,,0,0,0,,what the..
Dialogue: 0,0:25:56.23,0:25:58.06,general text,,0,0,0,,kalokohan... Ako lang
Dialogue: 0,0:25:59.23,0:26:00.48,pangkalahatang teksto,,0,0,0,,narinig?
Dialogue: 0,0:26:04.86,0:26:07.86,general text,,0,0,0,,Sino ang babaeng ito?
Dialogue: 0,0:26:09.03,0:26:11.28,italics,,0,0,0,,Nakulong sa katawan na ito
Dialogue: 0,0:26:13.58,0:26:15.54,pangkalahatang teksto,,0,0,0,,kaluluwa ng isang tunay na reyna?
Dialogue: 0,0:26:45.11,0:26:47.40,pangkalahatang teksto,,0,0,0,,Ama, huminto ka
Dialogue: 0,0:27:49.25,0:27:50.30,pangkalahatang teksto,,0,0,0,,Gwangju,
Dialogue: 0,0:27:51.30,0:27:52.55,general text,,0,0,0,,ikaw ba yan?
Dialogue: 0,0:28:02.27,0:28:03.35,pangkalahatang teksto,,0,0,0,,Dalagang Kim,
Dialogue: 0,0:28:04.35,0:28:05.77,pangkalahatang teksto,,0,0,0,,matagal nang hindi nakikita
Dialogue: 0,0:28:10.07,0:28:11.28,pangkalahatang teksto,,0,0,0,,Master Chang Gang
Dialogue: 0,0:28:51.32,0:28:52.69,pangkalahatang teksto,,0,0,0,,Ito ay lumulunok ng kaluluwa
Dialogue: 0,0:28:55.65,0:28:57.87,italics,,0,0,0,,Tiyak na pinatay siya ni Chan Wook
Dialogue: 0,0:28:58.45,0:28:59.53,pangkalahatang teksto,,0,0,0,,Natalo sa isang suntok
Dialogue: 0,0:29:01.04,0:29:03.95,pangkalahatang teksto,,0,0,0,,Hindi maaaring i-cast dito ang mga spell. Paano niya ito nagawa?
Dialogue: 0,0:29:06.33,0:29:08.00,general text,,0,0,0,,Nasaan sina Chan Wook at Moo Deok?
Dialogue: 0,0:29:08.08,0:29:09.17,pangkalahatang teksto,,0,0,0,,Hanapin sila
Dialogue: 0,0:29:09.88,0:29:11.13,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:29:21.89,0:29:25.02,pangkalahatang teksto,,0,0,0,,Nakita ko nang maramdaman ko ang lakas ng batong yelo
Dialogue: 0,0:29:26.06,0:29:28.56,general text,,0,0,0,,Sabi ng dalaga walang sinuman ang maaaring magmay-ari ng bato
Dialogue: 0,0:29:28.65,0:29:30.31,pangkalahatang teksto,,0,0,0,,Maaari ka lamang gumamit ng puwersa
Dialogue: 0,0:29:31.44,0:29:33.07,pangkalahatang teksto,,0,0,0,,Dahil ito ang enerhiya ng langit
Dialogue: 0,0:29:33.82,0:29:35.49,pangkalahatang teksto,,0,0,0,,Dapat tayong magsanay,
Dialogue: 0,0:29:36.07,0:29:39.24,pangkalahatang teksto,,0,0,0,,upang kontrolin maging ang enerhiya sa loob natin
Dialogue: 0,0:29:39.32,0:29:42.20,pangkalahatang teksto,,0,0,0,,Ang lakas ng langit, siyempre, ay lampas sa ating mga kakayahan
Dialogue: 0,0:29:42.28,0:29:46.62,pangkalahatang teksto,,0,0,0,,Hindi natin ito magagamit nang malaya dahil hindi ito sa atin
Dialogue: 0,0:29:49.42,0:29:50.83,pangkalahatang teksto,,0,0,0,,Kung hindi mo ito ma-master?
Dialogue: 0,0:29:51.92,0:29:53.50,pangkalahatang text,,0,0,0,,Paano kung ibigay ko lahat ng akin?
Dialogue: 0,0:29:54.21,0:29:55.59,pangkalahatang text,,0,0,0,,Ibigay mo sa akin ang iyo?
Dialogue: 0,0:29:55.67,0:29:59.30,pangkalahatang teksto,,0,0,0,,Paano kung ilagay ko ang lahat ng lakas ko sa langit?
Dialogue: 0,0:30:00.01,0:30:02.35,pangkalahatang teksto,,0,0,0,,Kung gayon ang aking enerhiya ay magiging enerhiya ng langit
Dialogue: 0,0:30:05.93,0:30:08.06,pangkalahatang teksto,,0,0,0,,Nabasa ko ang mga tala tungkol sa ice stone
Dialogue: 0,0:30:08.14,0:30:10.02,pangkalahatang teksto,,0,0,0,,sa lihim na aklatan ng Jeonjingak
Dialogue: 0,0:30:11.81,0:30:14.73,italics,,0,0,0,,Sabi nila walang hugis ang ice stone
Dialogue: 0,0:30:14.82,0:30:17.65,italics,,0,0,0,,Maaaring tubig, apoy o hangin
Dialogue: 0,0:30:17.74,0:30:19.95,italics,,0,0,0,,Hindi malaman ang laki nito
Dialogue: 0,0:30:20.03,0:30:23.37,italics,,0,0,0,,Maaari itong maliit o malaki
Dialogue: 0,0:30:25.41,0:30:28.37,pangkalahatang teksto,,0,0,0,,Ito ay nangangahulugan na ang hadlang na nakapalibot sa Jeonjingak
Dialogue: 0,0:30:28.46,0:30:30.29,pangkalahatang teksto,,0,0,0,,hindi ang tunay na anyo ng batong yelo
Dialogue: 0,0:30:30.83,0:30:32.88,pangkalahatang teksto,,0,0,0,,Maaari siyang maging tubig o apoy,
Dialogue: 0,0:30:32.96,0:30:35.67,pangkalahatang teksto,,0,0,0,, nagiging mas malaki o mas maliit kaysa ngayon
Dialogue: 0,0:30:36.42,0:30:37.46,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:30:37.55,0:30:41.09,general text,,0,0,0,,Sa tingin mo kaya nating gawing ulan ang fog?
Dialogue: 0,0:30:41.72,0:30:42.72,general text,,0,0,0,,Sa ulan?
Dialogue: 0,0:30:42.80,0:30:45.64,general text,,0,0,0,,Sabi mo walang kabuluhan ang lakas ko kumpara sa kapangyarihan ng bato
Dialogue: 0,0:30:46.27,0:30:48.14,pangkalahatang teksto,,0,0,0,,Isang patak lang ng tubig ang nasa aking kapangyarihan
Dialogue: 0,0:30:48.23,0:30:52.73,pangkalahatang teksto,,0,0,0,,At kung ang patak na ito ay gagawing libu-libong patak ng ulan?
Dialogue: 0,0:30:54.69,0:30:56.82,pangkalahatang teksto,,0,0,0,,Uulan
Dialogue: 0,0:30:56.90,0:30:58.44,pangkalahatang teksto,,0,0,0,,Maaaring gumana ito
Dialogue: 0,0:30:59.32,0:31:01.24,pangkalahatang teksto,,0,0,0,,Ngunit para dito kailangan mong gumamit ng Tansu
Dialogue: 0,0:31:01.32,0:31:03.66,general text,,0,0,0,,- Tapos...\N- Tapos mawawala lahat ng energy ko
Dialogue: 0,0:31:04.70,0:31:07.83,general text,,0,0,0,,Kaya sabi ko kailangan kong ibigay lahat
Dialogue: 0,0:31:12.00,0:31:13.00,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:31:13.08,0:31:14.79,pangkalahatang teksto,,0,0,0,,Bumuo ng ibang paraan
Dialogue: 0,0:31:14.88,0:31:17.75,general text,,0,0,0,,Dapat tayong magmadali, kung hindi, titipunin ng reyna ang lahat ng kapangyarihan ng bato
Dialogue: 0,0:31:18.76,0:31:19.92,pangkalahatang teksto,,0,0,0,,Pagkatapos ay mamamatay tayong lahat
Dialogue: 0,0:31:20.01,0:31:23.76,general text,,0,0,0,,Binabantayan siya ng council, hindi siya gagawa ng padalus-dalos.
Dialogue: 0,0:31:24.39,0:31:26.89,pangkalahatang teksto,,0,0,0,,Chan Wook, hindi na kailangan
Dialogue: 0,0:31:27.51,0:31:29.14,pangkalahatang teksto,,0,0,0,,Bilang guro mo, utos ko
Dialogue: 0,0:31:37.90,0:31:40.53,general text,,0,0,0,,Sumuko ako sa pagsisikap na mabawi ang aking kapangyarihan,
Dialogue: 0,0:31:40.61,0:31:42.32,general text,,0,0,0,,pero hindi ko hahayaang sayangin mo ang akin
Dialogue: 0,0:31:43.74,0:31:45.82,pangkalahatang teksto,,0,0,0,,Malayo na ang narating mo at ako
Dialogue: 0,0:31:46.66,0:31:48.24,general text,,0,0,0,,I spurred you on so much,
Dialogue: 0,0:31:48.33,0:31:50.91,pangkalahatang teksto,,0,0,0,,at itinaya mo ang iyong buhay nang maraming beses
Dialogue: 0,0:31:56.50,0:31:59.96,general text,,0,0,0,,At handa ka bang isuko ang lahat para sa isang patak?
Dialogue: 0,0:32:03.51,0:32:05.18,general text,,0,0,0,,Malubhang nasugatan si Yul
Dialogue: 0,0:32:05.26,0:32:07.89,general text,,0,0,0,,Kung walang nagawa, mamamatay siya
Dialogue: 0,0:32:13.60,0:32:14.94,italics,,0,0,0,,Moo Dok
Dialogue: 0,0:32:15.56,0:32:18.73,general text,,0,0,0,,Ibinigay mo ang lahat para protektahan ako
Dialogue: 0,0:32:22.19,0:32:23.61,general text,,0,0,0,,Gusto rin kitang protektahan
Dialogue: 0,0:32:24.49,0:32:28.53,general text,,0,0,0,,At pinrotektahan ka rin ni Yul all this time
Dialogue: 0,0:32:39.13,0:32:42.13,mga alaala na italics,,0,0,0,,Kung walang pagsasalin ng dugo maaari siyang mamatay
Dialogue: 0,0:32:45.51,0:32:48.05,italics,,0,0,0,,Ang uod na ito ay mula sa dugo ng pamilya Jin...
Dialogue: 0,0:32:48.14,0:32:49.76,general text,,0,0,0,,Kung ibibigay mo sa kanya...
Dialogue: 0,0:33:26.38,0:33:28.09,pangkalahatang teksto,,0,0,0,,Huwag mamatay, ginoo
Dialogue: 0,0:33:29.60,0:33:31.10,pangkalahatang teksto,,0,0,0,,Manatiling buhay
Dialogue: 0,0:34:01.63,0:34:04.09,pangkalahatang teksto,,0,0,0,,Alisin ang reflector. Paano kung may makakita?
Dialogue: 0,0:34:04.67,0:34:06.72,general text,,0,0,0,,Hindi ko na kaya
Dialogue: 0,0:34:07.22,0:34:09.09,pangkalahatang teksto,,0,0,0,,Dapat kong ibalik ang bato
Dialogue: 0,0:34:09.18,0:34:11.35,pangkalahatang teksto,,0,0,0,,gamit ang reflector
Dialogue: 0,0:34:13.76,0:34:15.02,general text,,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:34:15.10,0:34:16.85,pangkalahatang teksto,,0,0,0,,Hindi ka maaaring mag-magic gamit ang reflector,
Dialogue: 0,0:34:16.93,0:34:18.60,pangkalahatang teksto,,0,0,0,,habang narito ang Unified Council
Dialogue: 0,0:34:20.15,0:34:21.31,pangkalahatang teksto,,0,0,0,, Conjure?
Dialogue: 0,0:34:24.73,0:34:27.19,pangkalahatang teksto,,0,0,0,,Ang reflector na ito ay gawa sa yelong bato
Dialogue: 0,0:34:27.28,0:34:30.11,pangkalahatang teksto,,0,0,0,,Ngunit ang bato ay itinuturing na mabuti, at ang sumasalamin ay masama
Dialogue: 0,0:34:30.20,0:34:32.32,pangkalahatang teksto,,0,0,0,,Ito ay katawa-tawa
Dialogue: 0,0:34:32.41,0:34:36.41,pangkalahatang teksto,,0,0,0,,Isipin itong katawa-tawa, ngunit ito ang ayos ng mundong ito
Dialogue: 0,0:34:36.50,0:34:39.25,general text,,0,0,0,,Ginagawa namin ito para makalabas ka sa dilim
Dialogue: 0,0:34:39.33,0:34:41.79,pangkalahatang teksto,,0,0,0,,nang walang mantsa ng mangkukulam
Dialogue: 0,0:34:42.54,0:34:43.54,pangkalahatang teksto,,0,0,0,,Nakakahiya stigma?
Dialogue: 0,0:34:45.13,0:34:48.01,general text,,0,0,0,,Nakarating ka na hanggang dito gamit ang alchemy ng pamilya ko
Dialogue: 0,0:34:48.09,0:34:50.63,pangkalahatang teksto,,0,0,0,,Gaano ka kalakas ng loob na tratuhin ito nang may paghamak?
Dialogue: 0,0:34:53.55,0:34:58.35,general text,,0,0,0,,Sinasabi ko lang na ang alchemy ng mga kaluluwa ay isang hindi nakikilalang pangkukulam
Dialogue: 0,0:34:59.81,0:35:02.19,pangkalahatang teksto,,0,0,0,,Bakit dapat aminin ito ng mundo?
Dialogue: 0,0:35:02.90,0:35:06.07,general text,,0,0,0,,Nang matagpuan namin ang yelong bato sa Gyeongcheongdaeho Lake sampung taon na ang nakararaan,
Dialogue: 0,0:35:06.15,0:35:09.78,pangkalahatang teksto,,0,0,0,,magagamit natin ang kanyang kapangyarihan para itaas ang pamilya Choi
Dialogue: 0,0:35:09.86,0:35:10.86,pangkalahatang teksto,,0,0,0,,Gayunpaman,
Dialogue: 0,0:35:10.95,0:35:14.03,general text,,0,0,0,,pinilit mong pumasok ako sa katawan ng reyna,
Dialogue: 0,0:35:14.12,0:35:16.41,pangkalahatang teksto,,0,0,0,,lumikha ng isang lihim na organisasyon sa Jeonbugwan,
Dialogue: 0,0:35:16.49,0:35:17.66,pangkalahatang teksto,,0,0,0,,at ngayon
Dialogue: 0,0:35:18.54,0:35:22.46,pangkalahatang teksto,,0,0,0,,hinihiling mong ibunyag ang batong yelo sa mundo sa pamamagitan ni Jinyeowon
Dialogue: 0,0:35:23.79,0:35:27.84,pangkalahatang teksto,,0,0,0,,Masyadong mapanganib na lumaban sa mundo sa tulong ng pangkukulam
Dialogue: 0,0:35:27.92,0:35:31.76,pangkalahatang teksto,,0,0,0,,Hindi ito tungkol sa panganib, ngunit tungkol sa iyong paghamak
Dialogue: 0,0:35:32.26,0:35:34.72,general text,,0,0,0,,Ayokong ma-brand para sa pangkukulam
Dialogue: 0,0:35:34.80,0:35:38.93,general text,,0,0,0,,Nais kong gumamit ng kapangyarihan upang sambahin ka ng lahat
Dialogue: 0,0:35:42.27,0:35:44.77,pangkalahatang teksto,,0,0,0,,Bakit ka desperado na naghahanap ng pagkilala?
Dialogue: 0,0:35:46.77,0:35:50.03,pangkalahatang teksto,,0,0,0,,Dahil hindi mo matanggap ang katotohanan na
Dialogue: 0,0:35:50.90,0:35:53.99,pangkalahatang teksto,,0,0,0,,ipinanganak dahil sa kapakanan ng kanyang ama at hindi nakilala
Dialogue: 0,0:35:54.61,0:35:59.45,general text,,0,0,0,,miyembro ng pamilya Jin, bakit kailangan mong iwaglit ang iyong buntot na parang aso sa harap ng lahat?
Dialogue: 0,0:36:13.05,0:36:18.10,general text,,0,0,0,,Kumbaga, naging pabigat sa kanya ang posisyon ng reyna,
Dialogue: 0,0:36:18.18,0:36:22.39,pangkalahatang teksto,,0,0,0,,na dati siyang nakatanggap ng mga pennies para sa kanyang pagsasabi ng kapalaran
Dialogue: 0,0:36:26.73,0:36:31.53,pangkalahatang teksto,,0,0,0,,Kung napakahirap, bibigyan kita ng dalawang biktima ng tao
Dialogue: 0,0:36:31.61,0:36:36.11,pangkalahatang teksto,,0,0,0,,Magkaroon ng sapat sa kanilang mga kaluluwa at pagsamahin ang iyong sarili
Dialogue: 0,0:37:03.39,0:37:06.48,italics,,0,0,0,,Nahanap mo na ba ang tunay na reyna?
Dialogue: 0,0:37:07.73,0:37:11.27,general text,,0,0,0,,Dinala mo ba siya sa Sosnovy Bor?
Dialogue: 0,0:37:11.36,0:37:12.32,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:37:12.40,0:37:14.24,general text,,0,0,0,,Kasama niya si Jin Cho Young
Dialogue: 0,0:37:17.07,0:37:18.82,general text,,0,0,0,,Dalhin siya sa scientific hall
Dialogue: 0,0:37:18.91,0:37:20.45,general text,,0,0,0,,Ibubunyag ko ang katotohanan sa lahat
Dialogue: 0,0:37:21.16,0:37:22.29,pangkalahatang teksto,,0,0,0,,Hindi, kabanata
Dialogue: 0,0:37:22.95,0:37:26.12,pangkalahatang teksto,,0,0,0,,Sabihin lamang ito sa maharlikang pamilya at sa mga tao ng Jinyeowon
Dialogue: 0,0:37:27.50,0:37:31.71,pangkalahatang teksto,,0,0,0,,Ikaw ang magiging pinuno ng Sosnovy Bor,
Dialogue: 0,0:37:31.80,0:37:35.59,general text,,0,0,0,,pero tumayo ka dito at nag-aalala tungkol sa reputasyon ni Jinyoewon?
Dialogue: 0,0:37:37.30,0:37:38.89,pangkalahatang text,,0,0,0,,Hindi ko itinatanggi
Dialogue: 0,0:37:40.68,0:37:43.89,pangkalahatang teksto,,0,0,0,,Ngunit si Sosnovy Bor ay may pananagutan din para dito
Dialogue: 0,0:37:45.60,0:37:49.27,pangkalahatang teksto,,0,0,0,,Ang Mage ni Sosnovy Bor ang simula ng lahat
Dialogue: 0,0:37:49.35,0:37:52.36,pangkalahatang teksto,,0,0,0,,Mage mula kay Sosnovy Bor? WHO?
Dialogue: 0,0:37:53.15,0:37:56.95,general text,,0,0,0,,Ama ni Jang Wook, Gwangju Chang Gang
Dialogue: 0,0:38:16.63,0:38:18.38,italics,,0,0,0,,Sa kahilingan ni Sosnovy Bor
Dialogue: 0,0:38:18.47,0:38:21.64,general text,,0,0,0,,Pinaalis ko lahat maliban sa mga magician na sina Jeonbugwan at Jinyeowon
Dialogue: 0,0:38:23.05,0:38:24.68,general text,,0,0,0,,Ano ang gusto mong sabihin sa amin?
Dialogue: 0,0:38:26.18,0:38:30.73,general text,,0,0,0,,Nabalitaan kong may hinahanap ang Crown Prince kamakailan.
Dialogue: 0,0:38:31.48,0:38:33.52,italics,,0,0,0,,Pak Dan Gu, ang mago ni Jeonjingak,
Dialogue: 0,0:38:33.61,0:38:36.78,general text,,0,0,0,,at Jin Cho Young, ang priestess ni Jinyoung, natagpuan ang lalaking ito
Dialogue: 0,0:38:38.24,0:38:40.16,general text,,0,0,0,,May hinahanap ba ang Crown Prince?
Dialogue: 0,0:38:41.28,0:38:42.57,pangkalahatang teksto,,0,0,0,,At sino ito?
Dialogue: 0,0:38:44.20,0:38:46.75,pangkalahatang teksto,,0,0,0,,Narito ngayon ang taong ito
Dialogue: 0,0:38:51.71,0:38:53.00,general text,,0,0,0,,Narinig kong may bumato,
Dialogue: 0,0:38:53.08,0:38:55.80,pangkalahatang teksto,,0,0,0,, kung saan nakasulat na ang batong yelo ay nag-aalis ng lakas kapag nag-iislam
Dialogue: 0,0:38:55.88,0:38:58.84,pangkalahatang teksto,,0,0,0,,Hindi sila makapag-spells?
Dialogue: 0,0:38:58.92,0:39:01.30,pangkalahatang teksto,,0,0,0,,Ang parehong kapangyarihan ay ginagamit sa alchemy ng mga kaluluwa
Dialogue: 0,0:39:01.38,0:39:04.76,pangkalahatang teksto,,0,0,0,,Sa tingin ko ang bato ay nag-aalis ng lakas sa parehong paraan na sinisipsip nito ang mga kaluluwa
Dialogue: 0,0:39:04.85,0:39:08.43,general text,,0,0,0,,Kung gayon ano ang mangyayari sa ating mga anak?
Dialogue: 0,0:39:08.52,0:39:10.73,pangkalahatang text,,0,0,0,,Lahat kayo gustong pumatay ng tao,
Dialogue: 0,0:39:10.81,0:39:13.40,pangkalahatang teksto,,0,0,0,,upang makita ang kapangyarihan ng bato
Dialogue: 0,0:39:13.48,0:39:15.36,general text,,0,0,0,,Natatakot ka ba ngayon?
Dialogue: 0,0:39:15.94,0:39:19.86,pangkalahatang teksto,,0,0,0,,Ang kapangyarihan ng batong yelo ay lampas sa kontrol ng mga tao
Dialogue: 0,0:39:19.95,0:39:22.78,pangkalahatang teksto,,0,0,0,,Kaya iginiit ni Sosnovy Bor na sirain ito
Dialogue: 0,0:39:22.86,0:39:24.91,pangkalahatang teksto,,0,0,0,,Kung gayon dapat kumilos si Sosnovy Bor
Dialogue: 0,0:39:25.45,0:39:27.41,general text,,0,0,0,,Nandoon ang anak ko
Dialogue: 0,0:39:27.49,0:39:28.95,general text,,0,0,0,,Apo ko rin
Dialogue: 0,0:39:29.45,0:39:32.33,general text,,0,0,0,,Kung alam ko lang ang gagawin, hindi na lang ako tatayo dito
Dialogue: 0,0:39:33.67,0:39:35.21,pangkalahatang teksto,,0,0,0,,Nauuhaw ang lahat dito
Dialogue: 0,0:39:35.29,0:39:37.63,pangkalahatang teksto,,0,0,0,,ang kapangyarihan ng langit, at tingnan kung saan ito humantong
Dialogue: 0,0:39:38.42,0:39:40.84,pangkalahatang teksto,,0,0,0,,Paano kung humantong ito sa Chaos,
Dialogue: 0,0:39:40.92,0:39:43.68,general text,,0,0,0,,like 200 years ago?
Dialogue: 0,0:39:44.26,0:39:45.35,general text,,0,0,0,,So Kyung...
Dialogue: 0,0:39:46.35,0:39:48.35,general text,,0,0,0,,Si Master So Kyung ang winasak ang mga yelong bato
Dialogue: 0,0:39:49.47,0:39:52.31,pangkalahatang teksto,,0,0,0,,Wala siyang iniwan kundi "Mga Salita ng Puso"?
Dialogue: 0,0:39:52.39,0:39:56.27,pangkalahatang teksto,,0,0,0,,Ang tulang ito ang tanging bagay na mayroon tayo
Dialogue: 0,0:39:57.32,0:39:59.57,pangkalahatang teksto,,0,0,0,,Nanawagan kami sa kapangyarihan ng batong yelo,
Dialogue: 0,0:39:59.65,0:40:02.28,general text,,0,0,0,,isa sa atin ang kailangang ayusin ito,
Dialogue: 0,0:40:03.24,0:40:05.78,pangkalahatang teksto,,0,0,0,,tulad ni Master So Kyung maraming taon na ang nakalipas
Dialogue: 0,0:40:12.21,0:40:15.04,pangkalahatang teksto,,0,0,0,,Tumawag ng ulan para mawala ang kapangyarihan ng bato?
Dialogue: 0,0:40:16.13,0:40:17.92,pangkalahatang teksto,,0,0,0,,Hindi sigurado kung uulan,
Dialogue: 0,0:40:18.00,0:40:21.17,pangkalahatang teksto,,0,0,0,,at maaalis ba tayo ng ulan na ito sa hadlang
Dialogue: 0,0:40:22.01,0:40:23.55,pangkalahatang teksto,,0,0,0,,Isang bagay ang sigurado
Dialogue: 0,0:40:24.47,0:40:26.05,pangkalahatang text,,0,0,0,,Kung gagamit ka ng Tansu dito...
Dialogue: 0,0:40:27.01,0:40:28.10,pangkalahatang teksto,,0,0,0,,Chan Uk...
Dialogue: 0,0:40:29.01,0:40:31.02,general text,,0,0,0,,mawawala lahat ng energy mo
Dialogue: 0,0:40:32.14,0:40:33.52,pangkalahatang teksto,,0,0,0,,Alam ko
Dialogue: 0,0:40:33.60,0:40:35.10,pangkalahatang teksto,,0,0,0,,At gusto mo pa ring subukan?
Dialogue: 0,0:40:38.02,0:40:40.28,pangkalahatang teksto,,0,0,0,,Siguro hindi ka top-level na magician,
Dialogue: 0,0:40:40.86,0:40:43.82,general text,,0,0,0,,pero marami ka pa ring pinagdaanan para makarating dito
Dialogue: 0,0:40:44.49,0:40:46.03,general text,,0,0,0,,At pumayag kang mawala ang lahat?
Dialogue: 0,0:40:49.12,0:40:50.79,pangkalahatang teksto,,0,0,0,,Haharapin ko ito
Dialogue: 0,0:40:51.37,0:40:53.46,general text,,0,0,0,,Ngunit gusto kong tulungan mo ako sa isang bagay
Dialogue: 0,0:40:55.12,0:40:57.79,pangkalahatang teksto,,0,0,0,,Kung mawala ang yelong bato,
Dialogue: 0,0:40:58.46,0:41:01.30,pangkalahatang teksto,,0,0,0,,bahala na ang iba
Dialogue: 0,0:41:03.97,0:41:06.55,pangkalahatang teksto,,0,0,0,,Ang mga nagnanais ng kanyang kapangyarihan ay magagalit
Dialogue: 0,0:41:06.63,0:41:10.31,pangkalahatang teksto,,0,0,0,,Maaari silang maghinala na may mali at iniisip na ito ay nakatago sa isang lugar
Dialogue: 0,0:41:10.39,0:41:14.60,pangkalahatang teksto,,0,0,0,,Ibig sabihin, kumilos na parang sinira ko ang bato
Dialogue: 0,0:41:14.68,0:41:16.81,pangkalahatang teksto,,0,0,0,,at harapin ang mga kahihinatnan?
Dialogue: 0,0:41:16.90,0:41:20.15,pangkalahatang teksto,,0,0,0,, Pananagutan mo ang iyong ginawa?
Dialogue: 0,0:41:20.23,0:41:22.28,pangkalahatang teksto,,0,0,0,,Hinihiling kong ayusin mo ang lahat
Dialogue: 0,0:41:22.36,0:41:25.07,pangkalahatang text,,0,0,0,,pagkatapos ng gulo na ginagawa ko
Dialogue: 0,0:41:30.16,0:41:31.24,pangkalahatang teksto,,0,0,0,,Chan Wook,
Dialogue: 0,0:41:31.95,0:41:34.20,pangkalahatang teksto,,0,0,0,,bilang karagdagan sa enerhiya, maaari kang mawalan ng iyong buhay
Dialogue: 0,0:41:34.29,0:41:36.08,general text,,0,0,0,,Wag kang tanga, kalimutan mo na lang
Dialogue: 0,0:41:39.08,0:41:41.00,pangkalahatang teksto,,0,0,0,,Ang aking kamangha-manghang guro
Dialogue: 0,0:41:41.54,0:41:44.76,general text,,0,0,0,,laging itinulak ako sa gilid ng bangin at sinabi ang sumusunod:
Dialogue: 0,0:41:45.30,0:41:48.76,italics,,0,0,0,,"Mas mabuti pang mamatay kaysa walang ginagawa"
Dialogue: 0,0:41:51.10,0:41:54.85,pangkalahatang teksto,,0,0,0,,Susubukan kong hindi dahil sa katangahan, kundi dahil sa katigasan ng ulo
Dialogue: 0,0:41:55.73,0:41:57.64,general text,,0,0,0,,Ito ang itinuro sa akin ng aking guro
Dialogue: 0,0:42:01.90,0:42:03.82,general text,,0,0,0,,Hindi ko alam na may teacher ka
Dialogue: 0,0:42:03.90,0:42:07.74,pangkalahatang teksto,,0,0,0,,Sino ito? Master Lee Chul?
Dialogue: 0,0:42:09.78,0:42:10.78,italics,,0,0,0,,Host
Dialogue: 0,0:42:14.58,0:42:15.75,general text,,0,0,0,,Nagdala ako ng espada
Dialogue: 0,0:42:22.54,0:42:23.50,pangkalahatang teksto,,0,0,0,,Won Moo Deok
Dialogue: 0,0:42:24.96,0:42:27.63,general text,,0,0,0,,Hindi mo ba siya kakausapin mula sa kawalang-ingat na ito?
Dialogue: 0,0:42:29.01,0:42:32.76,pangkalahatang teksto,,0,0,0,,Mas mabuting mamatay kaysa walang ginagawa
Dialogue: 0,0:42:36.60,0:42:37.56,pangkalahatang teksto,,0,0,0,,Host,
Dialogue: 0,0:42:39.06,0:42:40.60,pangkalahatang teksto,,0,0,0,,gawin mo ang dapat mong gawin
Dialogue: 0,0:42:41.19,0:42:42.23,pangkalahatang teksto,,0,0,0,,At...
Dialogue: 0,0:42:43.15,0:42:44.73,pangkalahatang teksto,,0,0,0,,Naniniwala ako sa iyo
Dialogue: 0,0:43:03.21,0:43:08.21,pangkalahatang teksto,,0,0,0,,Nasa kahila-hilakbot na kalagayan ang taong papasok dito
Dialogue: 0,0:43:08.80,0:43:10.13,pangkalahatang teksto,,0,0,0,,20 taon na ang nakakaraan
Dialogue: 0,0:43:10.22,0:43:13.60,general text,,0,0,0,,itinapon niya ang sarili sa apoy para magtago kay Jeonbugwan
Dialogue: 0,0:43:19.43,0:43:21.64,general text,,0,0,0,,Ito ay isang shaman, siya ay nagsasabi ng kapalaran
Dialogue: 0,0:43:22.81,0:43:24.15,pangkalahatang teksto,,0,0,0,,at sinumpaang mga tao
Dialogue: 0,0:43:27.28,0:43:28.53,pangkalahatang teksto,,0,0,0,, Shaman?
Dialogue: 0,0:43:29.28,0:43:33.07,pangkalahatang teksto,,0,0,0,,Naka-lock siya na parang hayop sa napakatagal na panahon,
Dialogue: 0,0:43:33.16,0:43:36.74,pangkalahatang teksto,,0,0,0,,sa isang maliit na piitan sa tindahan ng herbalista sa nayon ng Gema
Dialogue: 0,0:43:39.20,0:43:42.04,general text,,0,0,0,,Bakit siya naka-lock?
Dialogue: 0,0:43:42.12,0:43:44.29,general text,,0,0,0,,Hiniling ko sa iyo na ipatawag ang pulong na ito
Dialogue: 0,0:43:45.00,0:43:47.42,pangkalahatang teksto,,0,0,0,, umaasang malaman, Kamahalan
Dialogue: 0,0:43:49.17,0:43:50.72,italics,,0,0,0,,Lahat ng naririto,
Dialogue: 0,0:43:50.80,0:43:56.26,general text,,0,0,0,,connected with Shaman Choi, isang babaeng malapit nang pumasok sa kwartong ito
Dialogue: 0,0:43:58.06,0:44:00.31,pangkalahatang teksto,,0,0,0,,- Iyon lang?\N- {\i1}Kamahalan
Dialogue: 0,0:44:00.39,0:44:02.73,pangkalahatang teksto,,0,0,0,,Hindi ngayon ang oras para dito
Dialogue: 0,0:44:03.31,0:44:04.85,italics,,0,0,0,,Mas mahalaga ang yelong bato
Dialogue: 0,0:44:04.94,0:44:06.90,pangkalahatang teksto,,0,0,0,,Mas mahalaga na iligtas ang Crown Prince
Dialogue: 0,0:44:13.40,0:44:18.20,general text,,0,0,0,,Head Pak, dalhin mo dito ang shaman
Dialogue: 0,0:44:23.75,0:44:25.08,pangkalahatang teksto,,0,0,0,,Pumasok
Dialogue: 0,0:45:12.55,0:45:16.13,general text,,0,0,0,,Shaman Choi, ipakita mo ang iyong mukha
Dialogue: 0,0:45:43.62,0:45:45.08,pangkalahatang teksto,,0,0,0,,Kamahalan
Dialogue: 0,0:45:46.75,0:45:51.59,general text,,0,0,0,,Kahit sa panaginip ko hindi ko akalain na makikita ko ulit ang mukha mo
Dialogue: 0,0:45:52.67,0:45:55.42,general text,,0,0,0,,Kilala mo ba ako?
Dialogue: 0,0:45:55.51,0:45:58.43,general text,,0,0,0,,Ako ang asawa mo, Your Highness
Dialogue: 0,0:45:58.97,0:46:02.18,pangkalahatang teksto,,0,0,0,,Ako, So Ha Sun, Queen Daeho
Dialogue: 0,0:46:03.14,0:46:04.14,italics,,0,0,0,,Shut up!
Dialogue: 0,0:46:04.22,0:46:07.35,general text,,0,0,0,,How dare you say my name with your dirty mouth?
Dialogue: 0,0:46:08.02,0:46:09.77,pangkalahatang teksto,,0,0,0,,Ako ang reyna ng bansang ito!
Dialogue: 0,0:46:09.85,0:46:11.44,general text,,0,0,0,,How dare you?
Dialogue: 0,0:46:12.19,0:46:13.78,general text,,0,0,0,,Ginawa mo ito sa akin
Dialogue: 0,0:46:14.36,0:46:17.70,pangkalahatang teksto,,0,0,0,,Ikaw, nakakaawa na shaman, ginamit na soul alchemy
Dialogue: 0,0:46:17.78,0:46:20.32,pangkalahatang teksto,,0,0,0,,para ilipat ang iyong maruming kaluluwa...
Dialogue: 0,0:46:21.57,0:46:25.91,pangkalahatang teksto,,0,0,0,,sa aking sagradong katawan, ang katawan ng reyna!
Dialogue: 0,0:46:26.00,0:46:27.83,general text,,0,0,0,,Sapat na sa mga kasinungalingan mo
Dialogue: 0,0:46:28.50,0:46:30.12,general text,,0,0,0,,Deputy Gwangju, huwag kang tumayo diyan!
Dialogue: 0,0:46:30.21,0:46:32.29,italics,,0,0,0,,Shut up that crazy woman right now!
Dialogue: 0,0:46:34.34,0:46:38.47,italics,,0,0,0,,Una, kailangan nating suriin
Dialogue: 0,0:46:38.55,0:46:40.84,general text,,0,0,0,,nagsisinungaling ba siya o hindi
Dialogue: 0,0:46:42.35,0:46:43.39,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:46:44.47,0:46:46.27,pangkalahatang teksto,,0,0,0,,Sabi niya, inilipat ang kanyang kaluluwa
Dialogue: 0,0:46:46.35,0:46:49.56,general text,,0,0,0,,Tingnan natin kung may asul na marka ang Reyna sa kanyang katawan
Dialogue: 0,0:46:54.23,0:46:58.15,pangkalahatang teksto,,0,0,0,,Ikinagagalak kong ipakita ito sa iyo upang makatulong na maalis ang mga hinala
Dialogue: 0,0:47:08.58,0:47:12.21,general text,,0,0,0,,Dapat ko bang ilantad ang aking balikat dito?
Dialogue: 0,0:47:12.29,0:47:16.50,pangkalahatang teksto,,0,0,0,,Madaling maalis ang asul na marka
Dialogue: 0,0:47:16.59,0:47:18.09,pangkalahatang teksto,,0,0,0,,Kung hindi, walang mapapatunayan
Dialogue: 0,0:47:21.80,0:47:23.30,pangkalahatang teksto,,0,0,0,,Mayroon kaming Gwigu
Dialogue: 0,0:47:32.35,0:47:33.69,italics,,0,0,0,,Mayroon akong abo
Dialogue: 0,0:47:33.77,0:47:38.90,pangkalahatang teksto,,0,0,0,,cremated dog kung saan nakatira ang kaluluwa ni Gwigu
Dialogue: 0,0:47:40.61,0:47:43.03,pangkalahatang teksto,,0,0,0,,Ang natitira sa pwersa ni Gwigu ay makakatulong sa atin...
Dialogue: 0,0:47:48.54,0:47:49.41,pangkalahatang teksto,,0,0,0,,ihayag ang katotohanan
Dialogue: 0,0:47:54.21,0:47:56.00,pangkalahatang teksto,,0,0,0,,Hindi!
Dialogue: 0,0:47:59.84,0:48:02.26,pangkalahatang teksto,,0,0,0,,Hindi!
Dialogue: 0,0:48:09.27,0:48:10.52,pangkalahatang teksto,,0,0,0,,Nakikita mo,
Dialogue: 0,0:48:11.48,0:48:12.60,pangkalahatang teksto,,0,0,0,,ito ay...
Dialogue: 0,0:48:13.90,0:48:15.61,pangkalahatang teksto,,0,0,0,,kakakolekta lang ng abo
Dialogue: 0,0:48:16.56,0:48:18.07,pangkalahatang teksto,,0,0,0,,mula sa brazier
Dialogue: 0,0:48:32.00,0:48:33.83,general text,,0,0,0,,Ikaw lang mismo ang nagpatunay,
Dialogue: 0,0:48:34.42,0:48:37.92,pangkalahatang teksto,,0,0,0,,na ikaw ay isang lagalag
Dialogue: 0,0:48:47.35,0:48:49.14,pangkalahatang teksto,,0,0,0,,Grab shaman Choi,
Dialogue: 0,0:48:49.22,0:48:53.43,pangkalahatang teksto,,0,0,0,,na gumamit ng soul alchemy upang agawin ang kapangyarihan
Dialogue: 0,0:48:53.52,0:48:54.81,pangkalahatang teksto,,0,0,0,,sa katawan ng reyna!
Dialogue: 0,0:48:54.89,0:48:55.98,italics,,0,0,0,,- Oo!\N- Oo!
Dialogue: 0,0:48:56.60,0:48:57.73,pangkalahatang teksto,,0,0,0,,Hindi!
Dialogue: 0,0:49:00.27,0:49:04.03,general text,,0,0,0,,Huwag mo siyang saktan. Ito ang aking katawan
Dialogue: 0,0:49:04.78,0:49:08.03,general text,,0,0,0,,Dapat bumalik ang kaluluwa ko sa katawan na ito. Huwag mo siyang saktan
Dialogue: 0,0:49:09.12,0:49:10.74,pangkalahatang teksto,,0,0,0,,Huwag kang lalapit
Dialogue: 0,0:49:12.20,0:49:16.37,pangkalahatang teksto,,0,0,0,,Kung hindi ay pirapiraso ko ang katawan na ito
Dialogue: 0,0:49:16.96,0:49:18.83,pangkalahatang teksto,,0,0,0,,Siya ay isang inapo ng salamangkero na si Choi,
Dialogue: 0,0:49:18.92,0:49:22.17,pangkalahatang teksto,,0,0,0,,na naging sanhi ng Great Chaos 200 taon na ang nakakaraan
Dialogue: 0,0:49:23.59,0:49:26.80,pangkalahatang teksto,,0,0,0,,At ang mga reflector ay malamang na kanyang gawa
Dialogue: 0,0:49:27.72,0:49:30.22,pangkalahatang teksto,,0,0,0,,Ito ay nagpapaliwanag sa kamakailang paglitaw ng mga lumulunok ng kaluluwa
Dialogue: 0,0:49:31.26,0:49:33.22,italics,,0,0,0,,Isa itong masamang mangkukulam
Dialogue: 0,0:49:33.31,0:49:35.89,italics,,0,0,0,,nagpakita ng ice stone sa harap ng Unified Council
Dialogue: 0,0:49:36.48,0:49:38.44,pangkalahatang teksto,,0,0,0,,at ginawa ang lahat na parang ganap na tanga
Dialogue: 0,0:49:39.61,0:49:41.44,pangkalahatang teksto,,0,0,0,,Lahat ng salamangkero sa Deho
Dialogue: 0,0:49:42.57,0:49:45.86,pangkalahatang teksto,,0,0,0,,Royal family, Jeonbugwan at Jinyeowon
Dialogue: 0,0:49:46.45,0:49:48.49,italics,,0,0,0,,Lahat ay naloko
Dialogue: 0,0:49:48.57,0:49:53.62,pangkalahatang teksto,,0,0,0,,kapatid na lalaki at babae ng pamilyang Choi
Dialogue: 0,0:49:55.04,0:49:56.21,pangkalahatang teksto,,0,0,0,,"Magkapatid na babae"?
Dialogue: 0,0:50:03.30,0:50:04.67,pangkalahatang teksto,,0,0,0,,So,
Dialogue: 0,0:50:05.80,0:50:09.22,general text,,0,0,0,,magkapatid ba kayo ng shaman na ito?
Dialogue: 0,0:50:13.76,0:50:15.56,general text,,0,0,0,,Miyembro ka ba ng pamilyang Choi?
Dialogue: 0,0:50:23.52,0:50:24.98,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:50:29.36,0:50:30.61,pangkalahatang text,,0,0,0,,Paumanhin
Dialogue: 0,0:50:34.04,0:50:36.41,italics,,0,0,0,,Ang anak na babae na natagpuan mo kamakailan, Jin Bu Young,
Dialogue: 0,0:50:36.50,0:50:38.12,pangkalahatang teksto,,0,0,0,,peke rin,
Dialogue: 0,0:50:39.33,0:50:40.46,pangkalahatang teksto,,0,0,0,,na kanilang kinuha
Dialogue: 0,0:50:41.83,0:50:45.96,general text,,0,0,0,,Ang susunod niyang plano ay lumipat sa katawan
Dialogue: 0,0:50:46.05,0:50:48.38,pangkalahatang teksto,,0,0,0,,mga tagapagmana ni Jinyeowon
Dialogue: 0,0:51:00.52,0:51:01.73,italics,,0,0,0,,Shaman Choi,
Dialogue: 0,0:51:01.81,0:51:03.40,pangkalahatang teksto,,0,0,0,,ibaba ang punyal
Dialogue: 0,0:51:03.48,0:51:06.44,pangkalahatang teksto,,0,0,0,,at ibalik ang katawan na ito sa Her Royal Highness
Dialogue: 0,0:51:06.53,0:51:07.74,pangkalahatang teksto,,0,0,0,,Gawin ang sinasabi ko,
Dialogue: 0,0:51:08.65,0:51:13.49,pangkalahatang teksto,,0,0,0,,at ililigtas ko ang buhay ng iyong kapatid
Dialogue: 0,0:51:25.80,0:51:27.51,general text,,0,0,0,,Sabi mo masama ako
Dialogue: 0,0:51:30.17,0:51:31.80,general text,,0,0,0,,Pero walang tao dito
Dialogue: 0,0:51:32.84,0:51:35.89,pangkalahatang text,,0,0,0,,walang karapatang tawagan ako ng ganyan
Dialogue: 0,0:51:37.39,0:51:38.85,italics,,0,0,0,,Gustong malaman
Dialogue: 0,0:51:38.93,0:51:42.73,pangkalahatang teksto,,0,0,0,,paano ko nagawang angkinin ang sagradong katawan ng reyna?
Dialogue: 0,0:51:44.61,0:51:49.07,general text,,0,0,0,,Masaya niyang ibinigay sa akin ang kanyang katawan dahil gusto niyang ilipat ang kanyang kaluluwa
Dialogue: 0,0:51:49.15,0:51:51.74,pangkalahatang teksto,,0,0,0,,sa isang bata at magandang katawan
Dialogue: 0,0:51:51.82,0:51:52.78,general text,,0,0,0,,Jin Ho Kyung!
Dialogue: 0,0:51:54.07,0:51:56.95,general text,,0,0,0,,Hindi ba ikaw ang nagpahayag ng ice stone sa buong mundo?
Dialogue: 0,0:51:58.12,0:52:01.37,italics,,0,0,0,,Ikaw ang pinuno ni Jinyoewon, ang tagapagtanggol ng kanyang mga labi
Dialogue: 0,0:52:01.46,0:52:02.79,pangkalahatang teksto,,0,0,0,,At hinayaan mo ang bato
Dialogue: 0,0:52:02.87,0:52:06.25,pangkalahatang text,,0,0,0,,iwanan si Jinyeowon para gamitin ito para sa alchemy
Dialogue: 0,0:52:07.84,0:52:11.76,pangkalahatang teksto,,0,0,0,,At ang nagsagawa ng alchemy ng mga kaluluwa,
Dialogue: 0,0:52:13.22,0:52:15.01,pangkalahatang teksto,,0,0,0,,ay isang salamangkero ni Sosnovy Bor
Dialogue: 0,0:52:16.05,0:52:17.56,italics,,0,0,0,,Park Jin!
Dialogue: 0,0:52:17.64,0:52:20.35,general text,,0,0,0,,Itinago mo ang katotohanan sa kabila ng katotohanang alam mo ang lahat
Dialogue: 0,0:52:21.06,0:52:25.27,pangkalahatang teksto,,0,0,0,,Kumilos na parang hindi ka makapaghintay na hulihin ang lahat ng gumagawa ng kulam
Dialogue: 0,0:52:25.35,0:52:30.23,general text,,0,0,0,,Ngunit sinusubukan mo lang itago ang kasalanan ng salamangkero na iyon
Dialogue: 0,0:52:39.95,0:52:41.41,pangkalahatang teksto,,0,0,0,,Ikaw naman, Jin Mu
Dialogue: 0,0:52:42.83,0:52:46.63,general text,,0,0,0,,Bakit nakatayo ka lang at walang ginagawa?
Dialogue: 0,0:52:48.59,0:52:52.80,pangkalahatang teksto,,0,0,0,,Ako lang ang masama, humahatol sa iyong lohika at mga katwiran,
Dialogue: 0,0:52:54.26,0:52:56.09,pangkalahatang teksto,,0,0,0,,na iyong naisip
Dialogue: 0,0:53:07.35,0:53:09.40,pangkalahatang teksto,,0,0,0,,Ang lohika ay tinutukoy ng kapangyarihan
Dialogue: 0,0:53:09.48,0:53:14.36,pangkalahatang teksto,,0,0,0,,Nawalan ka ng kapangyarihan at ginagawa kang masama niyan
Dialogue: 0,0:53:18.20,0:53:20.16,pangkalahatang teksto,,0,0,0,,Jin Mu, hindi ka mabibigo
Dialogue: 0,0:53:21.20,0:53:25.08,pangkalahatang teksto,,0,0,0,,Ang iyong debosyon ay pabagu-bago ng hangin
Dialogue: 0,0:53:25.16,0:53:27.21,pangkalahatang teksto,,0,0,0,,Ipasa ang natitirang mga reflector
Dialogue: 0,0:53:28.00,0:53:29.50,general text,,0,0,0,,Ibabalik namin ang katawan ng reyna,
Dialogue: 0,0:53:29.59,0:53:31.67,pangkalahatang teksto,,0,0,0,,at hindi ka matatakot
Dialogue: 0,0:53:32.88,0:53:37.13,general text,,0,0,0,,Ipinapayo ko sa iyo na sundin mo ang aking mga salita kung gusto mong mabuhay ang iyong kapatid
Dialogue: 0,0:53:38.22,0:53:39.72,italics,,0,0,0,,Ate
Dialogue: 0,0:53:39.80,0:53:42.52,pangkalahatang teksto,,0,0,0,,Gamitin ang natitirang reflector para makatakas
Dialogue: 0,0:53:44.60,0:53:47.39,general text,,0,0,0,,Ito lang ang magagawa ko para sa iyo
Dialogue: 0,0:53:49.94,0:53:51.02,pangkalahatang text,,0,0,0,,I'm so sorry
Dialogue: 0,0:53:54.53,0:53:55.86,pangkalahatang teksto,,0,0,0,,Ama!
Dialogue: 0,0:53:55.95,0:53:57.07,italics,,0,0,0,,Ama!
Dialogue: 0,0:53:58.61,0:53:59.57,italics,,0,0,0,,Ama!
Dialogue: 0,0:54:07.46,0:54:08.62,italics,,0,0,0,,Ama...
Dialogue: 0,0:54:20.84,0:54:22.30,italics,,0,0,0,,Ama...
Dialogue: 0,0:54:42.41,0:54:46.58,general text,,0,0,0,,Gagawin ko ang gusto mo at aalisin ko ang masamang batong yelo!
Dialogue: 0,0:54:46.66,0:54:47.87,pangkalahatang teksto,,0,0,0,,Gayunpaman,
Dialogue: 0,0:54:48.58,0:54:50.54,pangkalahatang teksto,,0,0,0,,sa sandaling mawala ang yelong bato,
Dialogue: 0,0:54:51.38,0:54:56.34,general text,,0,0,0,,mamamatay din kayong lahat
Dialogue: 0,0:56:31.39,0:56:32.89,italics,,0,0,0,,- Look\N- Ano ito?
Dialogue: 0,0:57:31.83,0:57:32.66,pangkalahatang teksto,,0,0,0,,Chan Gan?
Dialogue: 0,0:57:33.33,0:57:34.29,italics,,0,0,0,,Chang Gan ba ito?
Dialogue: 0,0:57:35.00,0:57:37.79,general text,,0,0,0,,Jang Gang, Jeongbugwan's gwangju?
Dialogue: 0,0:57:38.38,0:57:41.05,italics,,0,0,0,,Chan Gang, ikaw ba talaga yan?
Dialogue: 0,0:57:41.63,0:57:43.46,general text,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:58:07.86,0:58:09.20,pangkalahatang teksto,,0,0,0,, Soul reflector...
Dialogue: 0,0:58:19.46,0:58:21.59,pangkalahatang teksto,,0,0,0,,Nawala ang enerhiya ng reflector
Dialogue: 0,0:58:22.46,0:58:25.30,general text,,0,0,0,,May huminto nito
Dialogue: 0,0:58:29.05,0:58:30.51,pangkalahatang text,,0,0,0,,Gwangju Chang Gang dito
Dialogue: 0,0:58:47.32,0:58:48.74,pangkalahatang teksto,,0,0,0,,Chan Gan...
Dialogue: 0,0:58:49.95,0:58:52.83,pangkalahatang teksto,,0,0,0,,Na-absorb mo ang enerhiya ng reflector...
Dialogue: 0,0:58:54.16,0:58:55.70,pangkalahatang teksto,,0,0,0,,sa iyong katawan?
Dialogue: 0,0:59:02.54,0:59:05.71,italics,,0,0,0,,Huwag kang lalapit sa kanya
Dialogue: 0,0:59:05.80,0:59:08.09,general text,,0,0,0,,Si Chan Gan ay isang lagalag at siya ay naging ligaw
Dialogue: 0,0:59:08.80,0:59:10.05,italics,,0,0,0,,Tingnan mo
Dialogue: 0,0:59:10.13,0:59:13.01,italics,,0,0,0,,Nagiging bato ang buong katawan niya
Dialogue: 0,0:59:15.64,0:59:16.52,general text,,0,0,0,,Tama siya
Dialogue: 0,0:59:17.85,0:59:20.98,pangkalahatang teksto,,0,0,0,,Ginawa ko ang ipinagbabawal na alchemy ng mga kaluluwa at naging nomad
Dialogue: 0,0:59:21.69,0:59:22.90,pangkalahatang teksto,,0,0,0,,Ngayon ako ay tumatakbo ng ligaw
Dialogue: 0,0:59:24.40,0:59:26.11,pangkalahatang teksto,,0,0,0,,Ikaw ang gwangju ni Jeonbugwan
Dialogue: 0,0:59:26.19,0:59:28.15,general text,,0,0,0,,At gumamit ka ng pangkukulam?
Dialogue: 0,0:59:28.24,0:59:31.07,pangkalahatang teksto,,0,0,0,,Master Lee Chul, disipulo ni Master So Kyung,
Dialogue: 0,0:59:32.36,0:59:35.99,general text,,0,0,0,,inutusan akong ipagtapat ang aking mga kasalanan sa Unified Council
Dialogue: 0,0:59:37.24,0:59:38.91,general text,,0,0,0,,Kaya ako nandito
Dialogue: 0,0:59:43.67,0:59:46.21,memories italics,,0,0,0,,Kung may lakas ka pang basahin ang liham na ito,
Dialogue: 0,0:59:46.30,0:59:49.26,memories italics,,0,0,0,,gamitin mo ang natitirang lakas mo para tulungan ang mga nagdurusa
Dialogue: 0,0:59:49.34,0:59:51.01,mga alaala na italics,,0,0,0,,ang gulo na ginawa mo
Dialogue: 0,0:59:52.47,0:59:55.26,memories italics,,0,0,0,,Ito ay isang pagkakataon para matapos mo ang iyong nasimulan
Dialogue: 0,0:59:56.10,0:59:58.93,mga alaala na italics,,0,0,0,,Pagkatapos ay sumisikat ang isang bituin,
Dialogue: 0,0:59:59.02,1:00:01.06,mga alaala na italics,,0,0,0,,at lulubog ang bato
Dialogue: 0,1:00:05.52,1:00:07.32,pangkalahatang teksto,,0,0,0,,ako ang may pananagutan
Dialogue: 0,1:00:08.40,1:00:11.49,pangkalahatang teksto,,0,0,0,,para sa lahat ng pagkakamali nina Sosnovy Bor, Jinyeowon at Jeonbugwan
Dialogue: 0,1:00:12.99,1:00:15.03,general text,,0,0,0,,Kinuha ko yung ice stone kay Jinyeowon
Dialogue: 0,1:00:16.12,1:00:18.12,italics,,0,0,0,,at gumawa siya ng pangkukulam
Dialogue: 0,1:00:19.54,1:00:22.25,italics,,0,0,0,,Sinubukan kong ilihim ito
Dialogue: 0,1:00:23.75,1:00:26.67,pangkalahatang teksto,,0,0,0,,Ako ay masisindak dito upang tubusin ang lahat ng aking mga kasalanan
Dialogue: 0,1:00:29.17,1:00:32.05,general text,,0,0,0,,Si Gwangju Chang Gang ang nagsimula ng lahat,
Dialogue: 0,1:00:32.13,1:00:34.68,general text,,0,0,0,,kaya hahayaan ko siyang tapusin ito
Dialogue: 0,1:00:35.76,1:00:37.05,pangkalahatang teksto,,0,0,0,,kamatayan
Dialogue: 0,1:00:44.94,1:00:47.73,pangkalahatang teksto,,0,0,0,,Saksi ang kalunos-lunos na pagbagsak ng tao,
Dialogue: 0,1:00:48.69,1:00:50.11,pangkalahatang teksto,,0,0,0,,na nagsagawa ng pangkukulam
Dialogue: 0,1:00:50.19,1:00:52.19,general text,,0,0,0,,Siguro siya ay isang nomad,
Dialogue: 0,1:00:52.28,1:00:53.99,general text,,0,0,0,,pero hindi mo siya pwedeng iwanan na mamatay ng ganyan
Dialogue: 0,1:00:54.07,1:00:56.57,pangkalahatang teksto,,0,0,0,,Ang kanyang anak, si Chan Wook, sa loob ng Jeonjingak
Dialogue: 0,1:00:56.66,1:00:59.74,italics,,0,0,0,,Maghintay hanggang makaalis si Chang Wook doon
Dialogue: 0,1:00:59.83,1:01:03.21,general text,,0,0,0,,Nararapat siyang magpaalam sa kanyang ama
Dialogue: 0,1:01:03.29,1:01:05.00,general text,,0,0,0,,Hindi ko siya anak!
Dialogue: 0,1:01:05.62,1:01:07.67,general text,,0,0,0,,Alam niyo lahat na tinatakan ko ang energy gate niya,
Dialogue: 0,1:01:07.75,1:01:10.00,general text,,0,0,0,,para hindi siya sumunod sa mga yapak ko
Dialogue: 0,1:01:13.84,1:01:15.55,general text,,0,0,0,,Ang kanyang pagkabata ay malungkot na
Dialogue: 0,1:01:16.80,1:01:19.10,pangkalahatang teksto,,0,0,0,,Huwag siyang kilalanin bilang anak ng isang makasalanan
Dialogue: 0,1:02:26.87,1:02:28.33,behind the scenes,,0,0,0,,Nasaan ako?
Dialogue: 0,1:02:34.09,1:02:36.80,behind the scenes,,0,0,0,,Ano ang nangyayari? patay na ba ako?
Dialogue: 0,1:02:49.52,1:02:50.69,general text,,0,0,0,,Well, nangyari na
Dialogue: 0,1:02:51.77,1:02:53.52,general text,,0,0,0,,Nawala ang energy ko
Dialogue: 0,1:03:14.29,1:03:15.59,pangkalahatang teksto,,0,0,0,,Ice stone ba ito?
Dialogue: 0,1:03:16.80,1:03:20.84,general text,,0,0,0,,Natagpuan ko siya nang mawala ang lahat ng lakas ko
Dialogue: 0,1:03:22.39,1:03:23.68,pangkalahatang text,,0,0,0,,Para sa akin ngayon
Dialogue: 0,1:03:24.89,1:03:26.64,pangkalahatang teksto,,0,0,0,,ito ay walang iba kundi isang bato lamang
Dialogue: 0,1:03:51.21,1:03:53.00,italics,,0,0,0,,Ito ang bituin ng Hari!
Dialogue: 0,1:03:53.08,1:03:55.63,pangkalahatang teksto,,0,0,0,,Nagliwanag sa langit ang Bituin ng Hari
Dialogue: 0,1:04:32.12,1:04:35.00,pangkalahatang teksto,,0,0,0,,Ang bituin ng Hari ay nagningning sa kalangitan, at ang hadlang ay natulog
Dialogue: 0,1:04:49.81,1:04:51.56,italics,,0,0,0,,Nawala ang yelong bato,
Dialogue: 0,1:04:52.52,1:04:54.69,italics,,0,0,0,,at lumitaw ang bituin ng Hari
Dialogue: 0,1:04:55.90,1:04:58.23,general text,,0,0,0,,Nang ihinto ni Master So Kyung ang Great Chaos
Dialogue: 0,1:04:58.32,1:05:00.69,general text,,0,0,0,,lumabas din ang star ng Hari
Dialogue: 0,1:05:01.53,1:05:04.70,italics,,0,0,0,,Kaya may tao sa loob ng Jeonjingak
Dialogue: 0,1:05:04.78,1:05:07.82,italics,,0,0,0,,isinilang na kapareho ng kapalaran ni Master Seo Kyung?
Dialogue: 0,1:05:27.93,1:05:29.76,pangkalahatang teksto,,0,0,0,,Ang Bituin ng Hari sa itaas niya
Dialogue: 0,1:05:29.85,1:05:31.77,general text,,0,0,0,,Siya nga!
Dialogue: 0,1:05:46.70,1:05:48.53,pangkalahatang text,,0,0,0,,Crown Prince
Dialogue: 0,1:05:49.12,1:05:52.20,pangkalahatang teksto,,0,0,0,,Ang Bituin ng Hari ay sumikat para sa iyo!
Dialogue: 0,1:05:52.29,1:05:54.50,general text,,0,0,0,,- Your Highness!\N- Your Highness!
Dialogue: 0,1:06:09.09,1:06:12.01,behind the scenes,,0,0,0,,Si Chan Wook ay ipinanganak sa ilalim ng tanda ng King's star
Dialogue: 0,1:06:13.31,1:06:16.10,voiceover,,0,0,0,,Natanggal ba niya yung ice stone?
Dialogue: 0,1:06:44.30,1:06:46.38,voiceover,,0,0,0,,Estudyante ko, nawala lahat ng lakas mo
Dialogue: 0,1:06:48.22,1:06:52.22,behind the scenes,,0,0,0,,Teacher, naging Moo Deok ka lang
Dialogue: 0,1:06:54.85,1:06:56.39,general text,,0,0,0,,I don't mind
Dialogue: 0,1:06:57.39,1:06:58.98,general text,,0,0,0,,habang tayo ay magkasama
Dialogue: 0,1:07:35.51,1:07:38.10,general text,,0,0,0,,Nabalitaan ko na ang kasal ay magaganap sa Sosnovy Bor
Dialogue: 0,1:07:38.18,1:07:40.94,pangkalahatang teksto,,0,0,0,,Siyempre. Groom - salamangkero ng Sosnovy Bor
Dialogue: 0,1:07:41.44,1:07:43.23,general text,,0,0,0,,Hindi ako approve sa kasal nila
Dialogue: 0,1:07:43.31,1:07:45.73,general text,,0,0,0,,Hindi ako makapaniwalang ikakasal na sila
Dialogue: 0,1:07:45.82,1:07:47.78,general text,,0,0,0,,Ilang beses ko na silang nakitang magkasama
Dialogue: 0,1:07:47.86,1:07:49.53,general text,,0,0,0,,Maganda silang magkasama
Dialogue: 0,1:07:49.61,1:07:52.41,pangkalahatang teksto,,0,0,0,,Ano? Maaari silang pumili ng isang mas mahusay na nobyo
Dialogue: 0,1:07:52.49,1:07:53.87,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,1:07:53.95,1:07:55.87,italics,,0,0,0,,Gayundin ang masasabi tungkol sa nobya
Dialogue: 0,1:07:55.95,1:07:57.66,general text,,0,0,0,,Nag-uusap lang ang mga tao
Dialogue: 0,1:07:57.74,1:08:00.08,pangkalahatang teksto,,0,0,0,,tungkol sa United Council at star ng Hari
Dialogue: 0,1:08:00.16,1:08:03.00,general text,,0,0,0,,At ngayon ay pinag-uusapan nila ang nalalapit na kasal
Dialogue: 0,1:08:04.63,1:08:07.88,general text,,0,0,0,,Kaya naman nagpumilit ang ulo sa kasal
Dialogue: 0,1:08:07.96,1:08:11.34,general text,,0,0,0,,I have to admit, I still can't believe na ikakasal na itong dalawa
Dialogue: 0,1:08:14.01,1:08:17.39,pangkalahatang teksto,,0,0,0,,Mr. Yul, balita ko hindi ka pa nakakain
Dialogue: 0,1:08:18.06,1:08:19.97,general text,,0,0,0,,Kakain ako kapag nagugutom ako
Dialogue: 0,1:08:20.06,1:08:21.77,pangkalahatang text,,0,0,0,,Hayaan mo akong maghanda ng kuksa para sa iyo
Dialogue: 0,1:08:22.39,1:08:24.02,general text,,0,0,0,,At kailangan mong uminom ng gamot
Dialogue: 0,1:08:26.11,1:08:29.15,general text,,0,0,0,,Hindi ko na kailangan ng gamot. Tigilan mo na ako sa panggugulo sa kanila
Dialogue: 0,1:08:29.73,1:08:31.61,pangkalahatang teksto,,0,0,0,,Babalik ka sa Soho Fortress sa lalong madaling panahon
Dialogue: 0,1:08:31.70,1:08:33.66,general text,,0,0,0,,Kailangan mong kumain ng maayos habang nandito ka...
Dialogue: 0,1:08:40.04,1:08:41.54,general text,,0,0,0,,Naghilom na ang sugat ko
Dialogue: 0,1:08:42.54,1:08:43.92,general text,,0,0,0,,Bumalik na rin ang enerhiya
Dialogue: 0,1:08:45.46,1:08:47.67,general text,,0,0,0,,Narinig kitang umuungol sa sakit sa iyong pagtulog
Dialogue: 0,1:08:48.59,1:08:50.00,general text,,0,0,0,,Alam kong nagsisinungaling ka
Dialogue: 0,1:08:52.59,1:08:54.09,general text,,0,0,0,,Halos masakit ang sugat
Dialogue: 0,1:09:00.06,1:09:03.39,general text,,0,0,0,,Isa kang masamang sinungaling
Dialogue: 0,1:09:05.19,1:09:08.23,general text,,0,0,0,,Malinis ang puso mo, kaya sa tuwing magsisinungaling ka,
Dialogue: 0,1:09:08.82,1:09:10.82,pangkalahatang teksto,,0,0,0,,halata ito
Dialogue: 0,1:09:12.78,1:09:14.53,pangkalahatang teksto,,0,0,0,,Ito ay nakasulat mismo sa iyong mukha
Dialogue: 0,1:09:16.70,1:09:19.62,general text,,0,0,0,,Siguro mahirap para sa iyo na itago ito nang matagal
Dialogue: 0,1:09:27.25,1:09:28.42,pangkalahatang text,,0,0,0,,Paumanhin
Dialogue: 0,1:09:30.55,1:09:32.01,pangkalahatang teksto,,0,0,0,,At salamat,
Dialogue: 0,1:09:33.88,1:09:35.09,general text,,0,0,0,,kung ano ang kanilang ipinagtanggol
Dialogue: 0,1:09:41.68,1:09:45.14,memories italics,,0,0,0,,Protektahan ka ni Yul all this time
Dialogue: 0,1:09:48.77,1:09:50.82,mga alaala,,0,0,0,,Alam niya kung sino ka
Dialogue: 0,1:09:52.19,1:09:53.69,mga alaala,,0,0,0,,Alam na ikaw ay isang lagalag
Dialogue: 0,1:09:53.78,1:09:55.65,mga alaala,,0,0,0,,Alam na ikaw si Nak Soo
Dialogue: 0,1:09:56.53,1:09:58.32,mga alaala,,0,0,0,,Sinubukan niyang huwag ipakita ito
Dialogue: 0,1:10:03.70,1:10:07.46,memories,,0,0,0,,Gusto niya talagang protektahan ang babaeng nakilala niya sa Danhyangok
Dialogue: 0,1:10:15.92,1:10:17.38,pangkalahatang teksto,,0,0,0,,Ito
Dialogue: 0,1:10:17.47,1:10:20.60,pangkalahatang teksto,,0,0,0,,pag-aari ng iyong kaibigan mula sa Danhyangk
Dialogue: 0,1:10:22.10,1:10:23.22,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:10:25.31,1:10:27.60,general text,,0,0,0,,Gusto ko siyang isama
Dialogue: 0,1:10:27.69,1:10:29.77,pangkalahatang teksto,,0,0,0,,sa kuta ng Soho
Dialogue: 0,1:10:35.53,1:10:39.07,general text,,0,0,0,,May sikreto siya na itinago niya sa lahat
Dialogue: 0,1:10:41.16,1:10:43.45,general text,,0,0,0,,Kaya gusto ko siyang dalhin doon at itago
Dialogue: 0,1:10:48.25,1:10:49.92,general text,,0,0,0,,Nangako ako sa iyo na tutulungan kita
Dialogue: 0,1:10:50.75,1:10:53.67,pangkalahatang text,,0,0,0,,isama mo siya
Dialogue: 0,1:10:55.71,1:10:59.59,pangkalahatang teksto,,0,0,0,,Ngunit ang taong ito ay umiiral lamang sa iyong mga alaala
Dialogue: 0,1:11:00.55,1:11:02.43,general text,,0,0,0,,Wala na siya sa mundong ito
Dialogue: 0,1:11:11.65,1:11:13.15,general text,,0,0,0,,Akala ko noong una,
Dialogue: 0,1:11:13.23,1:11:16.48,pangkalahatang teksto,,0,0,0,,buburahin siya ng cremation sa iyong memorya
Dialogue: 0,1:11:17.94,1:11:20.57,general text,,0,0,0,,Pero sabi mo pinahahalagahan mo ang mga alaala mula kay Danhyangok
Dialogue: 0,1:11:26.33,1:11:27.66,general text,,0,0,0,,Isama mo siya
Dialogue: 0,1:11:41.05,1:11:43.18,pangkalahatang teksto,,0,0,0,,Gusto kong matiyak na ikaw ay nasa maayos na
Dialogue: 0,1:11:44.14,1:11:46.39,general text,,0,0,0,,Kaya gusto kong maramdaman ang iyong tatlong paghinga
Dialogue: 0,1:12:07.20,1:12:09.16,general text,,0,0,0,,Magpaalam na tayo sa isa't isa
Dialogue: 0,1:12:12.00,1:12:14.79,pangkalahatang teksto,,0,0,0,,habang tumatagal ang tatlong hiningang ito
Dialogue: 0,1:12:27.31,1:12:29.68,pangkalahatang teksto,,0,0,0,,Ang mga alaala ay mahal din sa akin
Dialogue: 0,1:12:31.73,1:12:33.60,pangkalahatang teksto,,0,0,0,,mula sa Danhyanggok
Dialogue: 0,1:12:40.74,1:12:42.07,pangkalahatang teksto,,0,0,0,,Salamat sa lahat
Dialogue: 0,1:13:22.94,1:13:25.53,general text,,0,0,0,,Mukhang gumagaling na ang sugat mo
Dialogue: 0,1:13:26.91,1:13:31.37,general text,,0,0,0,,Alam kong mapait ang gamot, pero regular na inumin
Dialogue: 0,1:13:38.38,1:13:39.50,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,1:13:41.17,1:13:43.38,general text,,0,0,0,,Iinom ako, gaano man ito kapait
Dialogue: 0,1:13:48.18,1:13:49.89,general text,,0,0,0,,Sa pagkakataong ito ay gagaling ang buong sugat
Dialogue: 0,1:14:29.26,1:14:32.60,pangkalahatang teksto,,0,0,0,,Sakripisyo ng aking buhay,
Dialogue: 0,1:14:32.68,1:14:38.02,general text,,0,0,0,,sinagot ng tatay mo ang nangyari
Dialogue: 0,1:14:38.90,1:14:42.07,italics,,0,0,0,,Salamat sa kanyang sakripisyo, hindi pinarusahan sina Sosnovy Bor at Jinyeowon
Dialogue: 0,1:14:49.95,1:14:52.49,general text,,0,0,0,,Marahil tinanggihan niya na anak ka niya,
Dialogue: 0,1:14:53.20,1:14:57.62,general text,,0,0,0,,dahil ayaw niyang sisihin ka sa kanyang mga kasalanan
Dialogue: 0,1:15:01.29,1:15:02.63,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,1:15:03.13,1:15:07.26,general text,,0,0,0,,Wala na akong pakialam sa katotohanang maaaring hindi ko siya ama
Dialogue: 0,1:15:11.43,1:15:14.89,general text,,0,0,0,,Kilala mo ba ang iyong ama?
Dialogue: 0,1:15:15.77,1:15:17.89,pangkalahatang text,,0,0,0,,Hindi pa kayo nagkikita
Dialogue: 0,1:15:20.52,1:15:21.90,general text,,0,0,0,,Nagkita kami minsan
Dialogue: 0,1:15:23.31,1:15:24.73,pangkalahatang teksto,,0,0,0,,Marahil pagkatapos
Dialogue: 0,1:15:26.03,1:15:27.49,general text,,0,0,0,,nakilala niya ako
Dialogue: 0,1:15:28.57,1:15:29.86,memories italics,,0,0,0,,Mukhang ikaw
Dialogue: 0,1:15:30.57,1:15:32.24,mga alaala,,0,0,0,,alam mo kung sino ako
Dialogue: 0,1:15:32.91,1:15:35.24,mga alaala,,0,0,0,,Ikaw ang may espada ni Gwangju Jeonbugwan
Dialogue: 0,1:15:35.33,1:15:36.83,mga alaala,,0,0,0,,Anak ka niya
Dialogue: 0,1:16:08.73,1:16:12.11,general text,,0,0,0,,Ito ang espada at robe na ibinigay ng royal family kay Chang Gan,
Dialogue: 0,1:16:12.20,1:16:15.49,general text,,0,0,0,,dating gwangju ni Jeonbugwan, na namatay dahil sa kulam
Dialogue: 0,1:16:15.58,1:16:20.29,pangkalahatang teksto,,0,0,0,,Nais naming magpasya ka kung ano ang dapat naming gawin sa kanyang mga bagay
Dialogue: 0,1:16:20.87,1:16:22.33,pangkalahatang teksto,,0,0,0,,Umalis sa Sosnovy Bor
Dialogue: 0,1:16:23.75,1:16:25.84,general text,,0,0,0,,Nahanap mo na ba si Deputy Jin Mu?
Dialogue: 0,1:16:26.59,1:16:27.71,general text,,0,0,0,,Hinahanap pa namin siya
Dialogue: 0,1:16:28.71,1:16:31.51,general text,,0,0,0,,Sigurado kaming hindi pa siya nakakaalis ng kabisera
Dialogue: 0,1:16:31.59,1:16:33.30,pangkalahatang teksto,,0,0,0,,Maaari siyang magkaroon ng ibang katawan
Dialogue: 0,1:16:34.55,1:16:36.97,pangkalahatang teksto,,0,0,0,,Kung gagawin niya sa kanyang sarili ang parehong bagay tulad ng sa akin,
Dialogue: 0,1:16:37.05,1:16:38.64,general text,,0,0,0,,Kilala ba siya ni Sosnovy Bor?
Dialogue: 0,1:16:39.77,1:16:41.98,pangkalahatang teksto,,0,0,0,,Naloko ka nitong mga taon
Dialogue: 0,1:16:45.90,1:16:47.23,italics,,0,0,0,,Your Highness
Dialogue: 0,1:16:47.32,1:16:51.03,pangkalahatang teksto,,0,0,0,,Si Master Kang mula sa Degangtongun ay nabaliw at natakot,
Dialogue: 0,1:16:51.11,1:16:53.20,pangkalahatang text,,0,0,0,,pero nailigtas siya ni Saejukwon
Dialogue: 0,1:16:53.82,1:16:57.37,pangkalahatang teksto,,0,0,0,,Kung sakaling magwala at magsisimulang maging bato,
Dialogue: 0,1:16:57.45,1:16:59.29,pangkalahatang text,,0,0,0,,may alam kaming paraan para iligtas ka
Dialogue: 0,1:17:00.54,1:17:01.83,pangkalahatang teksto,,0,0,0,,Ano ang punto?
Dialogue: 0,1:17:02.37,1:17:07.04,pangkalahatang teksto,,0,0,0,,Kailangan kong mabuhay sa kakila-kilabot na katawan na ito sa natitirang bahagi ng aking mga araw
Dialogue: 0,1:17:09.17,1:17:11.92,general text,,0,0,0,,Pinayagan mong mabuhay si Chan Wook, bagama't ang kanyang ama ay nagkasala ng
Dialogue: 0,1:17:12.01,1:17:14.13,general text,,0,0,0,,anong nangyari sa akin
Dialogue: 0,1:17:14.22,1:17:15.51,italics,,0,0,0,,Chang Gan
Dialogue: 0,1:17:16.09,1:17:18.60,pangkalahatang teksto,,0,0,0,, kinuha ang buong responsibilidad, isinakripisyo ang kanyang sarili
Dialogue: 0,1:17:19.51,1:17:21.47,general text,,0,0,0,,Inalis din namin si Chan Wook ng kanyang mga karapatan
Dialogue: 0,1:17:22.35,1:17:25.94,pangkalahatang text,,0,0,0,,maging susunod na gwangju ni Jeonbugwan
Dialogue: 0,1:17:27.15,1:17:28.94,pangkalahatang teksto,,0,0,0,,Inhugasan niya ang kanyang mga kasalanan,
Dialogue: 0,1:17:29.82,1:17:32.19,pangkalahatang teksto,,0,0,0,,nawawala ang lahat ng mayroon ako
Dialogue: 0,1:17:34.03,1:17:37.57,general text,,0,0,0,,Nang mamatay si Chang Gang, inamin niyang hindi niya anak si Wook
Dialogue: 0,1:17:37.66,1:17:39.70,pangkalahatang teksto,,0,0,0,,Hindi namin maaaring ilipat ang responsibilidad sa kanya
Dialogue: 0,1:17:39.78,1:17:43.45,general text,,0,0,0,,Namatay si Chang Gang nang hindi isiniwalat ang pangalan ng tunay na ama ni Wook
Dialogue: 0,1:17:51.63,1:17:53.26,mga alaala,,0,0,0,,Gusto ni Master Chang Gan,
Dialogue: 0,1:17:54.22,1:17:56.51,mga alaala,,0,0,0,,para ibigay ko ito sa iyo
Dialogue: 0,1:18:01.35,1:18:03.93,mga alaala,,0,0,0,,Sabi niya ihahayag nito ang katotohanan
Dialogue: 0,1:18:04.93,1:18:07.14,mga alaala,,0,0,0,,tungkol sa tunay na ama ni Mr. Chan Wook
Dialogue: 0,1:18:30.42,1:18:31.59,mga alaala,,0,0,0,,Sa tingin ko,
Dialogue: 0,1:18:32.84,1:18:35.88,alaala,,0,0,0,,ngayon, maid Kim, alam mo na ang totoo
Dialogue: 0,1:18:37.51,1:18:38.97,mga alaala,,0,0,0,,Hindi ako makapaniwala
Dialogue: 0,1:18:40.01,1:18:43.81,memories,,0,0,0,,Isinilang ni Lady Do Hwa ang anak ng yumaong hari?
Dialogue: 0,1:18:44.47,1:18:47.64,mga alaala,,0,0,0,,Si Uka ay ipinaglihi nang galawin ng yumaong hari ang kanyang kaluluwa...
Dialogue: 0,1:18:48.77,1:18:51.48,mga alaala,,0,0,0,,at humiga kasama si Do Hwa
Dialogue: 0,1:18:52.19,1:18:56.53,mga alaala,,0,0,0,,Nagsagawa si Chan Gan ng alchemy at nagpapalitan ng mga kaluluwa...
Dialogue: 0,1:18:58.57,1:19:00.20,mga alaala,,0,0,0,,kasama ang yumaong hari
Dialogue: 0,1:19:02.28,1:19:07.12,mga alaala,,0,0,0,,Si Master Chang Gan ay sumira sa buhay ng kanyang anak
Dialogue: 0,1:19:08.96,1:19:10.58,general text,,0,0,0,,Kung malalaman ito ng ginoo...
Dialogue: 0,1:19:12.08,1:19:13.67,general text,,0,0,0,,Hindi ko ito ibubunyag
Dialogue: 0,1:19:15.17,1:19:18.80,pangkalahatang teksto,,0,0,0,,Hindi lang Uku,
Dialogue: 0,1:19:19.97,1:19:21.93,pangkalahatang teksto,,0,0,0,,Ililihim ko ito sa lahat
Dialogue: 0,1:19:25.93,1:19:29.27,pangkalahatang teksto,,0,0,0,,Ang bituin na lumitaw sa langit nang sirain mo ang yelong bato,
Dialogue: 0,1:19:29.35,1:19:31.73,pangkalahatang teksto,,0,0,0,,ay nakaukit sa constellation tablet
Dialogue: 0,1:19:31.81,1:19:35.48,pangkalahatang teksto,,0,0,0,,Masaya ang lahat na tanggapin ang hari, ipinanganak sa ilalim ng batas ng bituin ng Hari
Dialogue: 0,1:19:35.57,1:19:37.23,italics,,0,0,0,,Gusto mo bang tingnan ang sign?
Dialogue: 0,1:19:39.15,1:19:40.32,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,1:19:52.71,1:19:54.09,pangkalahatang teksto,,0,0,0,,Gwangju Deputy
Dialogue: 0,1:19:55.13,1:19:57.51,pangkalahatang teksto,,0,0,0,,nilipat ang kaluluwa at nawala?
Dialogue: 0,1:20:28.29,1:20:30.50,pangkalahatang teksto,,0,0,0,, Nakatago sa Jeonbugwan sa lahat ng oras na ito?
Dialogue: 0,1:20:31.00,1:20:34.21,general text,,0,0,0,,Naghintay ako ng pagkakataon na makilala ka, Your Highness
Dialogue: 0,1:20:36.75,1:20:39.17,general text,,0,0,0,,Hinihiling mo ba na iligtas ko ang iyong buhay?
Dialogue: 0,1:20:39.26,1:20:41.88,general text,,0,0,0,,Ikaw lang ang makakapagligtas sa akin,
Dialogue: 0,1:20:41.97,1:20:45.64,pangkalahatang text,,0,0,0,,at ako lang ang makakapagprotekta sa iyo
Dialogue: 0,1:20:46.39,1:20:49.14,pangkalahatang text,,0,0,0,,Protektahan mo ako? mula saan?
Dialogue: 0,1:20:49.22,1:20:52.14,pangkalahatang teksto,,0,0,0,,poprotektahan kita mula sa tunay na tagapagmana ng bituin ng Hari
Dialogue: 0,1:20:53.19,1:20:56.44,general text,,0,0,0,,- Ano ang pinagsasabi mo?\N{\i1}- Alam mo na,
Dialogue: 0,1:20:56.52,1:20:58.94,general text,,0,0,0,,hindi ikaw ang tunay na tagapagmana
Dialogue: 0,1:21:04.82,1:21:08.74,general text,,0,0,0,,Ang lalaking hihigit sa iyo... Ang taong sasambahin
Dialogue: 0,1:21:08.83,1:21:12.66,general text,,0,0,0,,Yung lalaking magpapatalo sayo
Dialogue: 0,1:21:13.25,1:21:14.67,pangkalahatang teksto,,0,0,0,,Pangalawa ka lang sa linya ng trono
Dialogue: 0,1:21:14.75,1:21:17.71,pangkalahatang teksto,,0,0,0,,Si Chan Wook, ang tagapagmana ng bituin, ay hindi dapat payagan,
Dialogue: 0,1:21:18.50,1:21:19.75,pangkalahatang teksto,,0,0,0,,itaas sa iyo
Dialogue: 0,1:21:21.92,1:21:26.59,pangkalahatang teksto,,0,0,0,,Nangangako akong ililigtas ka sa nagbabantang liwanag na ito
Dialogue: 0,1:21:32.39,1:21:34.64,pangkalahatang teksto,,0,0,0,,Ang tanging bagay na lubos kong pinagsisikapan...
Dialogue: 0,1:21:37.35,1:21:39.11,pangkalahatang teksto,,0,0,0,,actually kay Chan Wook
Dialogue: 0,1:22:07.01,1:22:10.18,pangkalahatang text,,0,0,0,,Ang cute. maganda ka
Dialogue: 0,1:22:11.76,1:22:14.48,pangkalahatang text,,0,0,0,,Ang ganda mo
Dialogue: 0,1:22:16.64,1:22:18.10,pangkalahatang text,,0,0,0,,Punasan mo ang iyong laway
Dialogue: 0,1:22:18.69,1:22:20.81,general text,,0,0,0,,- Pwede mo nang tanggalin\N- Bakit ka...
Dialogue: 0,1:22:20.90,1:22:23.65,general text,,0,0,0,,actually hiniling sa akin na isuot ito? Bakit hindi ang nobya?
Dialogue: 0,1:22:23.73,1:22:27.07,general text,,0,0,0,,Napakasama ng kalagayan ng kanyang ama, kaya hindi siya nakarating
Dialogue: 0,1:22:27.15,1:22:29.53,general text,,0,0,0,,Ikaw at siya ay may katulad na pangangatawan, kaya
Dialogue: 0,1:22:30.12,1:22:31.33,general text,,0,0,0,,Pwede kang magpalit ng damit
Dialogue: 0,1:22:32.87,1:22:35.12,pangkalahatang teksto,,0,0,0,,Halika. Tara na para makapagpalit na siya ng damit
Dialogue: 0,1:22:35.87,1:22:38.79,italics,,0,0,0,,- Tumigil sa pagtitig. Let's go\N- Siya ang pinakamagandang babae na nakita ko
Dialogue: 0,1:22:38.87,1:22:40.21,pangkalahatang teksto,,0,0,0,,Totoo
Dialogue: 0,1:22:44.00,1:22:45.13,pangkalahatang teksto,,0,0,0,,Sa tingin ko,
Dialogue: 0,1:22:46.09,1:22:47.72,general text,,0,0,0,,cute ako
Dialogue: 0,1:22:49.55,1:22:50.64,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,1:22:50.72,1:22:52.47,general text,,0,0,0,,Nandito ba si Mu Dok? Nasaan siya?
Dialogue: 0,1:22:52.56,1:22:53.81,pangkalahatang teksto,,0,0,0,,Mu Dok ngayon...
Dialogue: 0,1:22:56.64,1:22:58.44,general text,,0,0,0,,Nasa kwarto siya
Dialogue: 0,1:22:58.52,1:22:59.98,pangkalahatang text,,0,0,0,,- Pasok\N- Okay
Dialogue: 0,1:23:10.70,1:23:11.95,pangkalahatang teksto,,0,0,0,,Wow...
Dialogue: 0,1:23:12.74,1:23:15.08,general text,,0,0,0,,Balita ko may ikakasal na malapit na
Dialogue: 0,1:23:15.87,1:23:16.79,general text,,0,0,0,,Hindi ba ikaw yan?
Dialogue: 0,1:23:17.71,1:23:18.71,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,1:23:23.84,1:23:25.71,pangkalahatang teksto,,0,0,0,,Tingnan mo, ito ang aking guro
Dialogue: 0,1:23:26.46,1:23:28.59,general text,,0,0,0,,Sabi ko hintayin mo ako sa Sejukwon
Dialogue: 0,1:23:28.67,1:23:31.51,general text,,0,0,0,,- Bakit ka nandito?\N- Pinadalhan ako ng alak ni Ho Yeom
Dialogue: 0,1:23:31.59,1:23:33.26,general text,,0,0,0,,Ah Joo Wol asked to wear this
Dialogue: 0,1:23:33.35,1:23:36.18,general text,,0,0,0,,Kailangan kong magpalit ng damit. Maghintay sa labas
Dialogue: 0,1:23:36.27,1:23:37.56,pangkalahatang teksto,,0,0,0,,Hindi, maghintay
Dialogue: 0,1:23:37.64,1:23:40.77,pangkalahatang teksto,,0,0,0,,Angkop ang lugar na ito. Dito tayo unang nagkakilala
Dialogue: 0,1:23:42.31,1:23:43.98,pangkalahatang teksto,,0,0,0,,Angkop para sa ano?
Dialogue: 0,1:23:45.82,1:23:48.19,pangkalahatang teksto,,0,0,0,,Para sa ritwal na dapat nating gawin
Dialogue: 0,1:23:49.15,1:23:50.82,italics,,0,0,0,,Umupo ka muna dito
Dialogue: 0,1:24:01.71,1:24:03.17,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,1:24:04.00,1:24:05.21,pangkalahatang text,,0,0,0,,Opsyonal ito
Dialogue: 0,1:24:08.84,1:24:12.26,pangkalahatang text,,0,0,0,,Stop. Pinahiya mo ako. Ano bang problema mo?
Dialogue: 0,1:24:17.43,1:24:19.31,pangkalahatang teksto,,0,0,0,,Nakakagulo lang ito sa una
Dialogue: 0,1:24:19.39,1:24:21.19,pangkalahatang teksto,,0,0,0,,Pero pagkatapos ng ika-13 beses masanay ka na
Dialogue: 0,1:24:22.48,1:24:23.56,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:24:24.19,1:24:26.27,general text,,0,0,0,,Nag-propose ka na ba ng 13 beses?
Dialogue: 0,1:24:28.78,1:24:29.90,pangkalahatang teksto,,0,0,0,,Guro,
Dialogue: 0,1:24:30.61,1:24:34.16,pangkalahatang teksto,,0,0,0,,ngayon gusto kong tapusin ang aking pagsasanay kasama ka
Dialogue: 0,1:24:37.24,1:24:40.25,pangkalahatang teksto,,0,0,0,,Salamat sa pagpapahirap sa akin
Dialogue: 0,1:24:40.83,1:24:43.08,pangkalahatang teksto,,0,0,0,,Kahit ako ay isang ganap na tulala
Dialogue: 0,1:24:45.25,1:24:46.42,italics,,0,0,0,,Alam ko,
Dialogue: 0,1:24:46.50,1:24:48.88,general text,,0,0,0,,iniwanan mo ang pagkakataong mabawi ang iyong kapangyarihan
Dialogue: 0,1:24:49.67,1:24:52.93,pangkalahatang teksto,,0,0,0,,Tulad ng pagsuko ko ng lakas na gusto kong angkinin
Dialogue: 0,1:24:53.72,1:24:57.76,pangkalahatang teksto,,0,0,0,,Ngunit mayroon akong isang bagay na nais kong panatilihin sa tabi ko sa buong buhay ko
Dialogue: 0,1:25:01.56,1:25:05.98,general text,,0,0,0,,Ayokong gamitin at itapon. Gusto kong protektahan at alagaan
Dialogue: 0,1:25:06.65,1:25:09.61,general text,,0,0,0,,So... bitawan mo ako
Dialogue: 0,1:25:14.99,1:25:16.49,pangkalahatang teksto,,0,0,0,,Ang iyong guro, Moo Deok,
Dialogue: 0,1:25:17.57,1:25:19.70,general text,,0,0,0,,pinapayagan ang kanyang estudyante na si Chan Wook na umalis
Dialogue: 0,1:25:24.46,1:25:25.50,pangkalahatang teksto,,0,0,0,,Okay, kung gayon...
Dialogue: 0,1:25:26.71,1:25:29.55,general text,,0,0,0,,Marry me, Moo Deok?
Dialogue: 0,1:26:01.83,1:26:04.58,preview,,0,0,0,,Nagpasya akong pakasalan ang may-ari
Dialogue: 0,1:26:04.66,1:26:05.87,preview,,0,0,0,,Wala ka man lang naging girlfriend
Dialogue: 0,1:26:05.96,1:26:07.67,preview,,0,0,0,,Para kay Moo Deok lang yan
Dialogue: 0,1:26:07.75,1:26:08.67,preview,,0,0,0,,Imposible!
Dialogue: 0,1:26:08.75,1:26:12.55,preview,,0,0,0,,Hahanap ako ng espada na papayag na tamaan mo si Chan Wook
Dialogue: 0,1:26:12.63,1:26:14.97,preview,,0,0,0,,Dapat mamatay si Jin Mu
Dialogue: 0,1:26:15.05,1:26:18.59,preview,,0,0,0,,Sinasabi mo bang lahat sila ay niloko at kinukutya ako?
Dialogue: 0,1:26:18.68,1:26:20.97,preview,,0,0,0,,Sinusubukan nilang protektahan si Chan Wook
Dialogue: 0,1:26:21.05,1:26:23.10,preview,,0,0,0,,May lumitaw na mamamatay-tao sa Saejukwon
Dialogue: 0,1:26:23.18,1:26:25.10,preview,,0,0,0,,Sa tingin ko ang katawan ni Moo Deok ay orihinal na kabilang sa...
Dialogue: 0,1:26:25.18,1:26:27.10,preview,,0,0,0,,sa isang taong may dakilang banal na kapangyarihan
Dialogue: 0,1:26:28.27,1:26:31.98,preview,,0,0,0,,Nak Soo, binigyan mo ako ng pag-asa
Dialogue: 0,0:02:55.24,0:02:57.24,nicks,,0,0,0,,

