Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, tommo, Zero_Amamiya
Dialog: 0,0:00:54.21,0:00:57.38,miring,,0,0,0,,Suatu hari, Deho dilanda kekeringan yang parah
Dialog: 0,0:01:00.26,0:01:02.72,miring,,0,0,0,,Begitu kuat hingga Danau Gyeongcheongdaeho
Dialog: 0,0:01:02.80,0:01:04.55,miring,,0,0,0,,habis
Dialog: 0,0:01:11.89,0:01:15.56,miring,,0,0,0,,Para penyihir Deho melakukan upacara besar,
Dialog: 0,0:01:15.65,0:01:17.36,miring,,0,0,0,,untuk mengisi danau dengan energi
Dialog: 0,0:01:23.24,0:01:26.62,miring,,0,0,0,,Ritual menyebabkan hujan es lebat
Dialog: 0,0:01:38.04,0:01:39.67,miring,,0,0,0,,Diantara semua hujan es
Dialog: 0,0:01:39.75,0:01:42.63,miring,,0,0,0,,ada yang tidak meleleh
Dialog: 0,0:01:44.72,0:01:49.55,miring,,0,0,0,,Hujan es ini mula-mula berubah menjadi api,
Dialog: 0,0:01:50.22,0:01:51.52,miring,,0,0,0,,lalu batu,
Dialog: 0,0:01:52.02,0:01:53.81,miring,,0,0,0,,lalu ke dalam air
Dialog: 0,0:01:54.77,0:01:58.23,miring,,0,0,0,,Lalu dia kembali ke awal lagi - dia menjadi es
Dialog: 0,0:01:59.11,0:02:01.78,miring,,0,0,0,,Pada saat yang sama, debu hitam keluar
Dialog: 0,0:02:03.69,0:02:07.49,miring,,0,0,0,,Debu ini disebut Reflektor dan digunakan dalam alkimia jiwa
Dialog: 0,0:02:11.08,0:02:14.04,miring,,0,0,0,,Kekuatan reflektor sungguh menakjubkan
Dialog: 0,0:02:15.91,0:02:19.79,miring,,0,0,0,,Kamu bisa menghidupkan kembali orang mati dengan memanggil jiwanya
Dialog: 0,0:02:20.38,0:02:23.30,miring,,0,0,0,,Kita bisa bertukar tubuh
Dialog: 0,0:02:25.17,0:02:27.26,miring,,0,0,0,,Kamu bahkan bisa mengeluarkan jiwa dari tubuh
Dialog: 0,0:02:27.34,0:02:29.85,miring,,0,0,0,,dan tangkap energinya
Dialog: 0,0:02:36.23,0:02:41.02,miring,,0,0,0,,Akibatnya, kekuatan tak terbatas ini menciptakan kekacauan
Dialog: 0,0:02:49.99,0:02:54.12,miring,,0,0,0,,Negeri berubah menjadi kekacauan berdarah karena para penyihir,
Dialog: 0,0:02:54.87,0:02:59.79,miring,,0,0,0,,yang melancarkan pembantaian pada reflektor
Dialog: 0,0:03:08.93,0:03:11.60,miring,,0,0,0,,Orang yang menghentikan kekacauan ini,
Dialog: 0,0:03:13.31,0:03:17.31,miring,,0,0,0,,adalah master So Kyung, pendiri Sosnovy Bor
Dialog: 0,0:03:27.07,0:03:28.86,teks umum,,0,0,0,,Saya adalah muridnya
Dialog: 0,0:03:28.95,0:03:31.62,teks umum,,0,0,0,,Batu es yang menakjubkan
Dialog: 0,0:03:31.70,0:03:34.66,teks umum,,0,0,0,,Di mana dia sekarang? Saya ingin melihat
Dialog: 0,0:03:34.74,0:03:37.29,teks umum,,0,0,0,,Ini batu yang sangat menakutkan
Dialog: 0,0:03:37.37,0:03:39.08,teks umum,,0,0,0,,Keajaiban batu ini
Dialog: 0,0:03:39.16,0:03:42.79,teks umum,,0,0,0,,menciptakan hal-hal buruk yang dapat melukai orang
Dialog: 0,0:03:43.63,0:03:46.55,teks umum,,0,0,0,,Sayang, di mana kamu menemukan boneka ini?
Dialog: 0,0:03:46.63,0:03:48.51,teks umum,,0,0,0,,Di pegunungan
Dialogue: 0,0:03:52.30,0:03:54.39,teks umum,,0,0,0,,Maukah kamu menukarnya dengan ini?
Dialog: 0,0:03:54.97,0:03:55.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:04:04.52,0:04:07.15,teks umum,,0,0,0,,Ini peninggalan terkutuk
Dialog: 0,0:04:16.24,0:04:17.58,teks umum,,0,0,0,,- Apa itu tadi?\N- Apa itu tadi?
Dialog: 0,0:04:17.66,0:04:20.71,teks umum,,0,0,0,,Benda berbahaya yang diciptakan oleh sihir
Dialog: 0,0:04:20.79,0:04:23.04,teks umum,,0,0,0,,Saya tahu apa itu. Peninggalan
Dialog: 0,0:04:24.25,0:04:25.46,teks umum,,0,0,0,,Jinyeowon penuh dengan mereka
Dialog: 0,0:04:27.17,0:04:28.38,teks umum,,0,0,0,,Ya
Dialog: 0,0:04:28.46,0:04:31.30,teks umum,,0,0,0,,Masih banyak objek yang lebih berbahaya di Jinyeowon
Dialog: 0,0:04:32.63,0:04:34.97,miring,,0,0,0,,Ada banyak benda aneh disana,
Dialog: 0,0:04:35.05,0:04:37.35,miring,,0,0,0,,diciptakan oleh kekuatan batu es
Dialog: 0,0:04:44.19,0:04:48.69,teks umum,,0,0,0,,Mereka menunggu kesempatan untuk keluar lagi
Dialogue: 0,0:05:02.25,0:05:03.79,kenangan miring,,0,0,0,,Mau aku bawa?
Dialogue: 0,0:05:04.62,0:05:05.75,kenangan miring,,0,0,0,,aku tak mau
Dialog: 0,0:05:06.96,0:05:09.67,kenangan,,0,0,0,,Biarkan aku menjadi Won Mu Deok, yang dihindari semua orang,
Dialog: 0,0:05:10.30,0:05:13.13,kenangan,,0,0,0,,tapi aku tidak melayani semua orang
Dialog: 0,0:05:13.22,0:05:15.39,teks umum,,0,0,0,,Beraninya dia?
Dialog: 0,0:05:16.30,0:05:17.89,teks umum,,0,0,0,,Dia seharusnya bersyukur
Dialog: 0,0:05:17.97,0:05:21.60,teks umum,,0,0,0,,Anggur kayu manis dan jahe ini memiliki aroma kayu manis yang sangat kuat
Dialog: 0,0:05:22.43,0:05:23.94,kenangan miring,,0,0,0,,Terima kasih, Yang Mulia
Dialog: 0,0:05:26.98,0:05:28.61,kenangan,,0,0,0,,Baunya seperti kayu manis
Dialog: 0,0:05:32.32,0:05:33.53,teks umum,,0,0,0,,Kurang ajar sekali
Dialog: 0,0:05:33.61,0:05:35.11,teks umum,,0,0,0,,Apakah ada yang mengganggumu?
Dialogue: 0,0:05:35.20,0:05:37.91,teks umum,,0,0,0,,Rupanya, aku jadi kotor soal Won Moo Deok
Dialog: 0,0:05:38.49,0:05:40.37,teks umum,,0,0,0,,Bau tak kunjung hilang
Dialog: 0,0:05:41.41,0:05:42.91,teks umum,,0,0,0,,Baunya enak
Dialog: 0,0:05:46.42,0:05:47.83,teks umum,,0,0,0,,Lupakan. Pergi
Dialog: 0,0:05:48.88,0:05:49.84,teks umum,,0,0,0,,Pergilah
Dialog: 0,0:05:49.92,0:05:51.42,teks umum,,0,0,0,,Ya, Yang Mulia
Dialog: 0,0:05:58.85,0:06:01.85,teks umum,,0,0,0,,Aku penyayang, menyelamatkannya dari masalah
Dialog: 0,0:06:01.93,0:06:04.02,teks umum,,0,0,0,,Memberinya bungkusan dan gaun sutra
Dialog: 0,0:06:12.73,0:06:14.07,teks umum,,0,0,0,,Sangat tidak berterima kasih
Dialog: 0,0:06:19.03,0:06:21.74,teks umum,,0,0,0,,- Aku bersyukur\N- Aku sudah menyuruhmu pergi...
Dialog: 0,0:06:28.37,0:06:29.75,teks umum,,0,0,0,,Stink Mu Deok?
Dialog: 0,0:06:29.83,0:06:31.29,teks umum,,0,0,0,,Bagaimana kamu sampai di sini?
Dialog: 0,0:06:32.46,0:06:35.30,teks umum,,0,0,0,,Aku punya sachetmu
Dialog: 0,0:06:36.93,0:06:40.26,teks umum,,0,0,0,,Aku datang karena kamu membutuhkan sesuatu dariku lagi
Dialog: 0,0:06:40.35,0:06:42.93,teks umum,,0,0,0,,Saya memikirkan tentang saya, Yang Mulia,
Dialog: 0,0:06:43.01,0:06:44.10,teks umum,,0,0,0,,itulah sebabnya aku datang
Dialogue: 0,0:06:44.18,0:06:46.31,teks umum,,0,0,0,,Apa maksudmu kamu membaca pikiranku?
Dialog: 0,0:06:49.81,0:06:50.86,teks umum,,0,0,0,,Luar biasa
Dialogue: 0,0:06:52.23,0:06:56.49,teks umum,,0,0,0,,Minumlah anggur kayu manis dan jahe. Aromanya lebih kuat dari sebelumnya
Dialog: 0,0:07:05.41,0:07:07.54,teks umum,,0,0,0,,Baunya harum sekali
Dialog: 0,0:07:09.37,0:07:10.42,teks umum,,0,0,0,,Ya?
Dialog: 0,0:07:14.71,0:07:18.47,teks umum,,0,0,0,,Harus kukatakan, aku suka tempat ini
Dialog: 0,0:07:20.30,0:07:23.68,teks umum,,0,0,0,,Saya harap Anda akan terus memikirkan saya seperti yang Anda lakukan hari ini
Dialog: 0,0:07:24.26,0:07:26.14,teks umum,,0,0,0,,Aku akan datang kepadamu setiap saat
Dialog: 0,0:07:38.19,0:07:40.24,teks umum,,0,0,0,,Istana adalah tempat yang bagus
Dialog: 0,0:07:43.99,0:07:45.70,teks umum,,0,0,0,,Kamu memakai sutra,
Dialog: 0,0:07:47.50,0:07:50.17,teks umum,,0,0,0,,minum anggur harum
Dialog: 0,0:07:52.00,0:07:54.46,teks umum,,0,0,0,,Tahukah kamu kenapa aku memikirkanmu?
Dialog: 0,0:07:58.47,0:08:00.13,teks umum,,0,0,0,,Karena kamu adalah Won Moo Deok
Dialog: 0,0:08:03.18,0:08:05.26,teks umum,,0,0,0,,Tapi sekarang baumu tidak busuk
Dialog: 0,0:08:06.76,0:08:08.68,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:08:08.77,0:08:09.64,teks umum,,0,0,0,,Siapa kamu?
Dialogue: 0,0:08:19.32,0:08:20.86,teks umum,,0,0,0,,Kau menangkapku
Dialog: 0,0:08:34.58,0:08:36.21,teks umum,,0,0,0,,Penjahat menyelinap ke sini
Dialog: 0,0:08:36.29,0:08:37.75,teks umum,,0,0,0,,- Cari semuanya\N{\i1}- Ya, Yang Mulia
Dialog: 0,0:08:42.84,0:08:44.68,teks umum,,0,0,0,,Tapi kenapa menyamar sebagai Moo Dok?
Dialog: 0,0:08:52.64,0:08:54.06,teks umum,,0,0,0,,Lihat setiap sudut
Dialog: 0,0:08:54.15,0:08:55.44,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:08:59.53,0:09:01.24,teks umum,,0,0,0,,Putra Mahkota ada di sini
Dialog: 0,0:09:02.03,0:09:03.28,teks umum,,0,0,0,,Pangeran?
Dialog: 0,0:09:10.25,0:09:11.96,teks umum,,0,0,0,,Saya mencari seseorang
Dialog: 0,0:09:12.04,0:09:13.79,teks umum,,0,0,0,,Mereka bilang aku akan menemukannya di sini
Dialogue: 0,0:09:15.42,0:09:18.46,teks umum,,0,0,0,,Apa terjadi sesuatu? Terlihat khawatir
Dialog: 0,0:09:19.05,0:09:22.30,teks umum,,0,0,0,,Pembantu itu membuat masalah dan menghilang, kami mencarinya
Dialog: 0,0:09:22.38,0:09:23.38,teks umum,,0,0,0,,Hamba?
Dialog: 0,0:09:23.47,0:09:25.22,teks umum,,0,0,0,,Dia tidak bekerja untuk kita
Dialog: 0,0:09:25.30,0:09:27.47,teks umum,,0,0,0,,Mu Doc. Pembantu keluarga Chan
Dialog: 0,0:09:27.55,0:09:29.18,teks umum,,0,0,0,,Itu yang kucari
Dialogue: 0,0:09:30.18,0:09:31.72,teks umum,,0,0,0,,Apa terjadi sesuatu?
Dialog: 0,0:09:33.48,0:09:34.48,teks umum,,0,0,0,,Pelayan ini...
Dialog: 0,0:09:35.94,0:09:38.90,teks umum,,0,0,0,,tidak sengaja memecahkan giok yin-yang yang dimaksudkan
Dialog: 0,0:09:39.52,0:09:40.82,teks umum,,0,0,0,,untuk cincin kawin
Dialog: 0,0:09:45.66,0:09:47.74,kenangan,,0,0,0,,Sudah kubilang hati-hati
Dialog: 0,0:09:47.82,0:09:49.16,kenangan,,0,0,0,,Apa yang akan kamu lakukan sekarang?
Dialog: 0,0:09:49.87,0:09:51.08,kenangan,,0,0,0,,Maaf nyonya
Dialog: 0,0:09:51.70,0:09:52.95,kenangan,,0,0,0,,Maafkan aku
Dialog: 0,0:09:53.50,0:09:55.29,kenangan,,0,0,0,,Saya akan memanggil pemiliknya di sini
Dialog: 0,0:09:55.37,0:09:57.46,kenangan,,0,0,0,,Kunci dia di paviliun
Dialog: 0,0:10:00.63,0:10:01.59,kenangan,,0,0,0,,Maaf
Dialog: 0,0:10:02.42,0:10:03.46,kenangan,,0,0,0,,Maaf!
Dialog: 0,0:10:03.55,0:10:05.76,miring,,0,0,0,,Mungkin takut hukuman
Dialog: 0,0:10:05.84,0:10:09.05,miring,,0,0,0,,Saat dia dikurung, dia mencuri giok dan melarikan diri
Dialog: 0,0:10:13.18,0:10:15.35,teks umum,,0,0,0,,Mengingat kita belum menemukannya,
Dialog: 0,0:10:15.44,0:10:18.27,teks umum,,0,0,0,,Saya pikir dia sudah meninggalkan tempat ini
Dialogue: 0,0:10:20.15,0:10:21.73,teks umum,,0,0,0,,Takut dan kabur?
Dialogue: 0,0:10:22.61,0:10:24.11,teks umum,,0,0,0,,Gadis pemberani?
Dialog: 0,0:10:26.78,0:10:28.74,teks umum,,0,0,0,,Penyihir Jeonjingak telah tiba
Dialog: 0,0:10:37.17,0:10:40.17,teks umum,,0,0,0,,Yang Mulia, apa yang membawa Anda ke sini?
Dialog: 0,0:10:40.25,0:10:41.84,teks umum,,0,0,0,,Dan kamu, Yul?
Dialog: 0,0:10:42.42,0:10:43.42,teks umum,,0,0,0,,Mencari seseorang
Dialog: 0,0:10:44.34,0:10:46.97,teks umum,,0,0,0,,Apakah kamu juga mencari Moo Dok?
Dialog: 0,0:10:47.68,0:10:48.51,teks umum,,0,0,0,,Ya
Dialogue: 0,0:10:49.76,0:10:50.97,teks umum,,0,0,0,,Aku datang karena dia
Dialog: 0,0:10:58.98,0:11:01.19,teks umum,,0,0,0,,Dia memecahkan gioknya,
Dialog: 0,0:11:01.27,0:11:03.57,teks umum,,0,0,0,,lalu kabur agar tidak dihukum
Dialogue: 0,0:11:04.23,0:11:07.70,teks umum,,0,0,0,,Kenapa kamu tidak membuat cincin hari itu?
Dialog: 0,0:11:08.32,0:11:12.58,teks umum,,0,0,0,,Aku datang ke Chwisongru untuk "meminjamkan" tanganku, tapi mereka menyuruhku pergi
Dialog: 0,0:11:14.16,0:11:16.45,teks umum,,0,0,0,,Saya memutuskan untuk melakukannya nanti
Dialog: 0,0:11:18.71,0:11:20.42,teks umum,,0,0,0,,Yul, kenapa kamu mencari Moo Deok?
Dialog: 0,0:11:21.04,0:11:24.88,teks umum,,0,0,0,,Saya melihat penglihatan yang sama seperti Anda, Yang Mulia
Dialog: 0,0:11:44.69,0:11:46.32,teks umum,,0,0,0,,Bagaimana kamu sampai di sini?
Dialog: 0,0:11:48.95,0:11:51.49,teks umum,,0,0,0,,Aku datang karena kamu merindukanku
Dialog: 0,0:11:54.66,0:11:55.91,teks umum,,0,0,0,,Apa maksudnya ini?
Dialog: 0,0:11:57.25,0:11:59.58,teks umum,,0,0,0,,Kamu melewatkan yang kamu temui di Danhyangok
Dialog: 0,0:11:59.66,0:12:01.08,teks umum,,0,0,0,,Berhenti membodohiku
Dialog: 0,0:12:01.17,0:12:02.46,teks umum,,0,0,0,,Merindukanmu?
Dialog: 0,0:12:03.17,0:12:05.00,teks umum,,0,0,0,,- Tidak ada yang semacam itu\N- {\i1}Salah
Dialog: 0,0:12:05.09,0:12:06.92,teks umum,,0,0,0,,Kamu bersiul
Dialog: 0,0:12:11.43,0:12:13.18,teks umum,,0,0,0,,Patah kaki tidak mengganggumu
Dialog: 0,0:12:14.76,0:12:16.85,teks umum,,0,0,0,,Dan kamu tidak takut mereka akan memarahimu
Dialog: 0,0:12:19.06,0:12:20.89,teks umum,,0,0,0,,Karena kamu menyukainya
Dialog: 0,0:12:26.73,0:12:28.78,teks umum,,0,0,0,,Terus pikirkan dia
Dialog: 0,0:12:36.74,0:12:38.12,teks umum,,0,0,0,,Kalau begitu aku akan menemuimu lagi
Dialog: 0,0:12:44.08,0:12:45.08,teks umum,,0,0,0,,Kamu...
Dialog: 0,0:12:45.96,0:12:46.96,teks umum,,0,0,0,,bukan manusia
Dialog: 0,0:12:58.10,0:12:59.81,teks umum,,0,0,0,,Maukah kamu menyingkirkanku?
Dialog: 0,0:13:01.23,0:13:03.27,teks umum,,0,0,0,,Maka kita tidak akan bertemu lagi
Dialog: 0,0:13:34.47,0:13:36.39,teks umum,,0,0,0,,Itu bukan dia. Hanya sebuah visi
Dialogue: 0,0:13:37.97,0:13:40.64,teks umum,,0,0,0,,Jadi itu sebuah visi?
Dialogue: 0,0:13:40.72,0:13:43.52,teks umum,,0,0,0,,Aneh, jadi aku datang ke Jwiseonru untuk mencari Moo Deok
Dialog: 0,0:13:44.10,0:13:45.65,teks umum,,0,0,0,,Saya diberitahu bahwa dia diseret ke sini
Dialog: 0,0:13:46.52,0:13:49.11,teks umum,,0,0,0,,Mereka tidak menyeretnya. Dia ada urusan
Dialog: 0,0:13:49.90,0:13:52.53,teks umum,,0,0,0,,Dan dia menghilang dengan peninggalan penting
Dialog: 0,0:13:53.36,0:13:56.11,teks umum,,0,0,0,,Kami mencari pencuri, bukan penglihatan
Dialog: 0,0:14:01.79,0:14:02.91,teks umum,,0,0,0,,Dan inilah pemiliknya
Dialogue: 0,0:14:18.47,0:14:21.35,teks umum,,0,0,0,,Guru Li tidak datang lagi hari ini?
Dialog: 0,0:14:21.85,0:14:24.14,teks umum,,0,0,0,,Orang ini seperti angin
Dialog: 0,0:14:24.85,0:14:26.35,teks umum,,0,0,0,,Dia meninggalkan anjingku dan pergi
Dialog: 0,0:14:27.10,0:14:30.06,teks umum,,0,0,0,,Apakah Gwigu juga tercipta dari batu es?
Dialog: 0,0:14:30.15,0:14:33.94,teks umum,,0,0,0,,Tuan So Kyung membuatnya dari energi batu,
Dialog: 0,0:14:34.03,0:14:36.15,teks umum,,0,0,0,,untuk menemukan jejak ilmu sihir
Dialog: 0,0:14:37.28,0:14:39.91,teks umum,,0,0,0,,Uk memecahkan guci Gwiga,
Dialog: 0,0:14:39.99,0:14:42.99,teks umum,,0,0,0,,jadi Tuan Lee mengembalikan jiwanya dari Jinyowon
Dialog: 0,0:14:43.70,0:14:45.33,teks umum,,0,0,0,,dan taruh di anjing ini
Dialog: 0,0:14:45.41,0:14:48.71,teks umum,,0,0,0,,Kamu benar-benar tidak tahu di mana Tuan Seo Kyung berada
Dialog: 0,0:14:49.88,0:14:51.13,teks umum,,0,0,0,,menyegel batunya?
Dialog: 0,0:14:53.00,0:14:53.96,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:14:54.96,0:14:57.84,teks umum,,0,0,0,,Apakah menurut Anda alkimia jiwa telah menyebar lagi,
Dialogue: 0,0:14:57.93,0:15:00.09,teks umum,,0,0,0,,karena ada yang menemukan batu?
Dialog: 0,0:15:01.64,0:15:04.97,teks umum,,0,0,0,,Satu-satunya cara untuk mentransmigrasi jiwa tanpa menguasai Hwangsu adalah
Dialog: 0,0:15:05.73,0:15:07.23,teks umum,,0,0,0,,gunakan batu
Dialogue: 0,0:15:07.77,0:15:10.56,teks umum,,0,0,0,,Saya yakin ada yang mencetaknya
Dialog: 0,0:15:11.23,0:15:12.77,teks umum,,0,0,0,,dan kembali ke cahaya
Dialog: 0,0:15:14.03,0:15:16.07,teks umum,,0,0,0,,Yah, ini tidak bagus
Dialog: 0,0:15:16.15,0:15:20.28,teks umum,,0,0,0,,Kengerian 200 tahun lalu tidak bisa dibiarkan terulang kembali
Dialog: 0,0:15:21.78,0:15:24.91,teks umum,,0,0,0,,Kita perlu menemukan batu es
Dialog: 0,0:15:34.59,0:15:37.09,teks umum,,0,0,0,,Aku disuruh memberikan ini padamu
Dialog: 0,0:15:47.39,0:15:50.14,miring,,0,0,0,,Kupikir kamu akan merendah untuk saat ini
Dialogue: 0,0:15:50.23,0:15:53.61,teks umum,,0,0,0,,Bisakah kamu membantu orang lain bermigrasi?
Dialog: 0,0:15:57.53,0:15:59.36,teks umum,,0,0,0,,Beri tahu saya bahwa saya menerima parselnya
Dialog: 0,0:16:00.45,0:16:01.49,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:08.20,0:16:10.92,teks umum,,0,0,0,,Cepat carikan aku seorang kasim untuk menggantikannya
Dialog: 0,0:16:13.04,0:16:16.84,teks umum,,0,0,0,,Jiwamu akan berpindah ke tubuhnya, pilihlah dengan bijak
Dialog: 0,0:16:16.92,0:16:18.09,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:19.38,0:16:21.18, sulih suara,,0,0,0,,Saya melayani Dan Zhu
Dialog: 0,0:16:21.26,0:16:23.26,di luar layar,,0,0,0,,tidak bermigrasi ke tubuh kasim
Dialog: 0,0:16:25.35,0:16:27.35, sulih suara,,0,0,0,,saya pakai Nak Su,
Dialog: 0,0:16:27.93,0:16:29.77,di belakang layar,,0,0,0,,untuk mendapatkan tubuh yang kuinginkan
Dialog: 0,0:16:38.90,0:16:41.20,teks umum,,0,0,0,,Pelayanku melakukan hal yang buruk
Dialog: 0,0:16:41.70,0:16:43.70,teks umum,,0,0,0,,Sebagai pemiliknya, saya akan memikul tanggung jawab penuh
Dialog: 0,0:16:45.03,0:16:46.16,teks umum,,0,0,0,,Maaf
Dialog: 0,0:16:49.50,0:16:53.08,teks umum,,0,0,0,,Kamu mungkin kesal karena giok untuk cincinnya rusak
Dialog: 0,0:16:54.29,0:16:56.63,teks umum,,0,0,0,,Aku memohon pada ibuku untuk batu giok ini,
Dialog: 0,0:16:57.75,0:16:59.59,teks umum,,0,0,0,,karena cincinnya terbuat dari itu
Dialog: 0,0:16:59.67,0:17:01.84,teks umum,,0,0,0,,akan membuat pernikahan langgeng dan bahagia
Dialog: 0,0:17:02.80,0:17:04.18,teks umum,,0,0,0,,Tapi rusak
Dialog: 0,0:17:04.26,0:17:06.43,teks umum,,0,0,0,,Aku tidak tahu kalau itu mempunyai arti yang begitu dalam
Dialog: 0,0:17:07.22,0:17:08.89,teks umum,,0,0,0,,Saya harus mengatakan bahwa saya juga kesal
Dialogue: 0,0:17:10.39,0:17:14.48,teks umum,,0,0,0,,Kita akan mencari batu giok yang lebih cocok untuk cincinnya
Dialog: 0,0:17:17.23,0:17:19.86,teks umum,,0,0,0,,Saya menerima permintaan maaf Anda
Dialog: 0,0:17:20.48,0:17:22.65,teks umum,,0,0,0,,- Anda dapat pergi\N- Terima kasih
Dialog: 0,0:17:22.74,0:17:23.65,teks umum,,0,0,0,,Saya tidak bisa
Dialog: 0,0:17:25.95,0:17:27.20,teks umum,,0,0,0,,Aku harus menemukan Moo Deok
Dialog: 0,0:17:30.08,0:17:32.41,teks umum,,0,0,0,,Saya ingin menemukan pelayan jahat ini,
Dialog: 0,0:17:32.91,0:17:35.12,teks umum,,0,0,0,,sehingga dia mengembalikan giok yin-yang
Dialog: 0,0:17:35.96,0:17:39.71,teks umum,,0,0,0,,Dia lemah, kakinya pendek, dia tidak bisa pergi jauh
Dialog: 0,0:17:41.01,0:17:44.34,teks umum,,0,0,0,,Izinkan saya mencarinya sendiri
Dialog: 0,0:17:48.97,0:17:50.31,teks umum,,0,0,0,,saya izinkan
Dialog: 0,0:17:51.22,0:17:52.27,teks umum,,0,0,0,,Terima kasih
Dialogue: 0,0:17:52.93,0:17:56.27,teks umum,,0,0,0,,Sekarang aku ingin kamu membuka pintunya
Dialog: 0,0:17:58.56,0:18:00.15,teks umum,,0,0,0,,Pintu ke Jinyeowon,
Dialog: 0,0:18:01.36,0:18:02.99,teks umum,,0,0,0,,tempat relik disimpan
Dialog: 0,0:18:22.67,0:18:26.09,teks umum,,0,0,0,,Hanya anggota keluarga Jin yang bisa membuka pintu ini
Dialog: 0,0:18:26.18,0:18:30.14,teks umum,,0,0,0,,Sekarang hanya Cho Young dan aku yang mampu melakukan ini
Dialog: 0,0:18:30.93,0:18:33.06,teks umum,,0,0,0,,Dia tidak bisa berada di sana
Dialog: 0,0:18:33.14,0:18:34.64,teks umum,,0,0,0,,Saya melihat sebuah penglihatan
Dialog: 0,0:18:37.52,0:18:39.02,teks umum,,0,0,0,,Mungkin kamu sedang bermimpi
Dialog: 0,0:18:39.81,0:18:42.98,teks umum,,0,0,0,,Mengapa kamu begitu yakin bahwa penglihatan itu diciptakan oleh sebuah peninggalan?
Dialog: 0,0:18:43.07,0:18:44.03,teks umum,,0,0,0,,Saya juga melihatnya
Dialog: 0,0:18:45.95,0:18:47.78,teks umum,,0,0,0,,Visi pada gambar Moo Deok
Dialogue: 0,0:18:49.74,0:18:53.12,teks umum,,0,0,0,,Semua relik yang bisa diciptakan oleh vision ada di Jinyowon
Dialog: 0,0:18:53.20,0:18:54.50,teks umum,,0,0,0,,Mari kita periksa
Dialog: 0,0:18:55.62,0:18:57.92,teks umum,,0,0,0,,Oke, aku akan buka pintunya
Dialog: 0,0:18:59.46,0:19:03.25,teks umum,,0,0,0,,Tempat ini penuh dengan peninggalan berbahaya
Dialog: 0,0:19:04.67,0:19:06.84,teks umum,,0,0,0,,Kejahatan dapat menguasaimu sehingga kamu tidak dapat kembali
Dialog: 0,0:19:08.26,0:19:10.64,teks umum,,0,0,0,,Pak, ini terlalu berbahaya
Dialog: 0,0:19:11.80,0:19:13.51,miring,,0,0,0,,Aku ikut dia
Dialogue: 0,0:19:17.27,0:19:18.27,teks umum,,0,0,0,,aku ikut juga
Dialog: 0,0:19:23.07,0:19:24.32,teks umum,,0,0,0,,Kedengarannya menyenangkan
Dialogue: 0,0:19:24.94,0:19:27.44,teks umum,,0,0,0,,Kapan lagi kamu punya kesempatan ke Jinyeowon?
Dialog: 0,0:19:51.80,0:19:53.18,teks umum,,0,0,0,,Enter
Dialogue: 0,0:19:53.26,0:19:54.81,teks umum,,0,0,0,,Kamu punya waktu satu jam
Dialog: 0,0:20:10.15,0:20:11.95,teks umum,,0,0,0,,Saya harus memberitahu kepala
Dialog: 0,0:20:15.99,0:20:17.12,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:20:18.00,0:20:19.33,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:20:24.42,0:20:26.88,teks umum,,0,0,0,,Jadi ini Jinyeowon
Dialog: 0,0:20:27.67,0:20:31.76,teks umum,,0,0,0,,Mereka bilang semua yang ada di sini mahal. Uang sebanyak apa pun tidak dapat membeli Anda
Dialog: 0,0:20:31.84,0:20:34.22,teks umum,,0,0,0,,Bisakah kamu diam? Kami tidak sedang berjalan-jalan
Dialog: 0,0:20:35.43,0:20:36.47,teks umum,,0,0,0,,Apakah kamu pemiliknya?
Dialog: 0,0:20:37.56,0:20:40.68,teks umum,,0,0,0,,Meskipun demikian, begini jadinya jika kamu menikah dengan Jin Cho Young
Dialog: 0,0:20:42.56,0:20:43.65,teks umum,,0,0,0,,Beruntung
Dialog: 0,0:20:43.73,0:20:46.40,teks umum,,0,0,0,,Semua permata ini akan menjadi milikmu, Jin Wook
Dialog: 0,0:20:47.36,0:20:50.65,teks umum,,0,0,0,,Jika kamu sangat iri padaku, kamu bisa menikahinya sendiri
Dialog: 0,0:20:51.45,0:20:54.99,teks umum,,0,0,0,,Tetapi bahkan setelah menjadi pemilik, bagaimana kamu mengendalikan semua ini?
Dialog: 0,0:20:55.07,0:20:56.33,teks umum,,0,0,0,,Penyihir tingkat rendah
Dialog: 0,0:20:56.41,0:20:58.74,teks umum,,0,0,0,,Jika kamu keren sekali, bisakah kamu menyentuh sesuatu di sini?
Dialog: 0,0:20:59.62,0:21:02.62,teks umum,,0,0,0,,Kepala Jinyeowon berkata jangan menyentuh apa pun di sini
Dialog: 0,0:21:02.71,0:21:05.71,teks umum,,0,0,0,,Pembenaran. Kamu hanya takut
Dialog: 0,0:21:11.72,0:21:13.05,teks umum,,0,0,0,,- Itu dia\N- Apa ini?
Dialog: 0,0:21:13.13,0:21:14.55,teks umum,,0,0,0,,Saya tidak tahu. Apa itu tadi?
Dialog: 0,0:21:16.47,0:21:17.43,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:21:18.18,0:21:19.60,teks umum,,0,0,0,,Ada yang aneh di sini
Dialog: 0,0:21:20.64,0:21:22.18,teks umum,,0,0,0,,Apakah kamu tidak takut?
Dialogue: 0,0:21:23.44,0:21:24.77,teks umum,,0,0,0,,Takut
Dialog: 0,0:21:25.94,0:21:27.77,teks umum,,0,0,0,,Di sini gelap, hati-hati
Dialog: 0,0:21:30.86,0:21:32.32,teks umum,,0,0,0,,Apakah dia benar-benar takut?
Dialog: 0,0:21:32.40,0:21:34.86,teks umum,,0,0,0,,Ya. Saat Yul ketakutan, dia bingung arah
Dialog: 0,0:21:34.95,0:21:36.16,teks umum,,0,0,0,,Yul, salah jalan!
Dialog: 0,0:21:37.87,0:21:38.83,teks umum,,0,0,0,,Lewat sini
Dialog: 0,0:21:39.58,0:21:41.62,teks umum,,0,0,0,,Di sana, ya
Dialog: 0,0:21:46.08,0:21:47.54,teks umum,,0,0,0,,Mari kita semua berhati-hati
Dialog: 0,0:21:50.80,0:21:52.17,miring,,0,0,0,,Yul selalu tenang,
Dialog: 0,0:21:52.88,0:21:55.34,miring,,0,0,0,,dan begitu linglung saat dia takut
Dialog: 0,0:21:55.93,0:21:57.01,teks umum,,0,0,0,,Semacam ini
Dialog: 0,0:22:02.68,0:22:04.18,teks umum,,0,0,0,,Jadi mari berhati-hati
Dialog: 0,0:22:04.94,0:22:06.69,teks umum,,0,0,0,,Jadilah dirimu sendiri
Dialog: 0,0:22:08.19,0:22:09.61,teks umum,,0,0,0,,Ayo pergi bersama
Dialog: 0,0:22:46.73,0:22:48.48,teks umum,,0,0,0,,Bagaimana aku bisa terkunci di sini?
Dialog: 0,0:23:00.20,0:23:01.70,teks umum,,0,0,0,,Aku harus menahan diri
Dialog: 0,0:23:03.37,0:23:05.37,teks umum,,0,0,0,,Tidak perlu memprovokasi dia
Dialogue: 0,0:23:07.33,0:23:08.87,kenangan miring,,0,0,0,,Sudah kubilang hati-hati
Dialog: 0,0:23:08.96,0:23:12.00,kenangan,,0,0,0,,Tunggu di sini. Tuanmu akan segera datang
Dialog: 0,0:23:12.59,0:23:15.21,kenangan,,0,0,0,,Nyonya, apa yang akan terjadi padaku sekarang?
Dialog: 0,0:23:15.30,0:23:18.38,kenangan,,0,0,0,,Apa lagi? Anda akan dihukum
Dialog: 0,0:23:19.18,0:23:21.43,kenangan,,0,0,0,,Bukan itu yang aku khawatirkan
Dialog: 0,0:23:21.51,0:23:24.22,kenangan,,0,0,0,,Mereka bilang kalau kamu memecahkan giok yin-yang,
Dialog: 0,0:23:24.31,0:23:27.06,kenangan,,0,0,0,,kamu tidak akan pernah bahagia dalam pernikahan
Dialog: 0,0:23:29.10,0:23:30.94,kenangan,,0,0,0,,Apa yang harus aku lakukan sekarang?
Dialog: 0,0:23:32.11,0:23:33.98,kenangan,,0,0,0,,Apa maksudnya ini?
Dialog: 0,0:23:34.07,0:23:35.40,kenangan,,0,0,0,,Jangan bicara omong kosong
Dialog: 0,0:23:36.53,0:23:38.28,kenangan,,0,0,0,,Mereka bilang kalau kamu memecahkan giok ini,
Dialog: 0,0:23:38.36,0:23:41.41,kenangan,,0,0,0,,orang yang kamu cintai tidak akan pernah membalas cintamu
Dialog: 0,0:23:42.03,0:23:44.91,kenangan,,0,0,0,,Semua gisaeng di Jwiseonru bilang begitu
Dialog: 0,0:23:44.99,0:23:47.50,kenangan,,0,0,0,,Apakah ini benar?
Dialog: 0,0:23:47.58,0:23:48.71,kenangan,,0,0,0,,Ya
Dialog: 0,0:23:49.37,0:23:53.17,kenangan,,0,0,0,,Anda tidak tahu, Bu?
Dialog: 0,0:23:53.79,0:23:55.34,kenangan,,0,0,0,,Ini tidak mungkin
Dialog: 0,0:23:57.71,0:23:59.51,kenangan,,0,0,0,,Lalu apa yang akan terjadi padaku?
Dialog: 0,0:24:03.22,0:24:04.89,kenangan,,0,0,0,,Kenapa kamu khawatir,
Dialog: 0,0:24:05.60,0:24:07.35,kenangan,,0,0,0,,jika aku memecahkannya?
Dialog: 0,0:24:11.81,0:24:13.77,kenangan,,0,0,0,,Kaulah yang merusaknya, kan?
Dialog: 0,0:24:14.69,0:24:17.78,kenangan,,0,0,0,,Mereka membuatku menggendongnya untuk menyalahkannya atas hal ini
Dialog: 0,0:24:18.65,0:24:19.61,kenangan,,0,0,0,,Benarkah?
Dialogue: 0,0:24:20.86,0:24:24.45,kenangan,,0,0,0,,Kasihan. Seharusnya aku mengatakan setidaknya sesuatu pada ibuku saat itu.
Dialog: 0,0:24:25.12,0:24:27.41,kenangan,,0,0,0,,Jika aku mempermalukan putrinya di depan semua orang,
Dialog: 0,0:24:28.20,0:24:30.37,kenangan,,0,0,0,,dia tidak akan memaafkanku
Dialog: 0,0:24:30.96,0:24:32.25,kenangan,,0,0,0,,Aku tidak takut padamu,
Dialog: 0,0:24:32.92,0:24:36.46,kenangan,,0,0,0,,tapi aku takut pada ibumu, kepala Jinyoung
Dialog: 0,0:24:39.76,0:24:41.26,kenangan,,0,0,0,,Apakah kamu begitu takut pada ibumu?
Dialog: 0,0:24:41.84,0:24:44.76,kenangan,,0,0,0,,Aku mungkin takut pada ibu, tapi aku membencimu
Dialog: 0,0:24:45.89,0:24:46.93,kenangan,,0,0,0,,Aku akan menjualmu
Dialog: 0,0:24:47.81,0:24:50.23,kenangan miring,,0,0,0,,Seperti katamu, ibuku sangat menakutkan
Dialog: 0,0:24:50.31,0:24:53.69,kenangan,,0,0,0,,Kamu akan dijual karena memecahkan giok
Dialog: 0,0:24:54.27,0:24:55.48,kenangan,,0,0,0,,Sangat jauh!
Dialog: 0,0:25:36.40,0:25:38.40,teks umum,,0,0,0,,Apakah dia melarikan diri?
Dialogue: 0,0:26:09.97,0:26:12.14,teks umum,,0,0,0,,Mungkin sebaiknya aku mencoba memanjat tembok?
Dialog: 0,0:26:50.72,0:26:52.76, sulih suara,,0,0,0,,Bagaimana dia bisa membuka pintu Jinyoewon?
Dialog: 0,0:27:00.31,0:27:02.98, sulih suara,,0,0,0,,Jadi ini Jinyeowon
Dialog: 0,0:27:06.57,0:27:10.12,teks umum,,0,0,0,,Jika kamu menguncinya di dalam, dia mungkin mati
Dialog: 0,0:27:36.93,0:27:38.06,teks umum,,0,0,0,,Hei
Dialog: 0,0:27:45.36,0:27:46.82,teks umum,,0,0,0,,Jadi itu kamu
Dialog: 0,0:27:51.03,0:27:52.53,teks umum,,0,0,0,,Lama tidak bertemu
Dialog: 0,0:28:20.02,0:28:21.19,miring,,0,0,0,,Kamu tidak akan bisa keluar
Dialogue: 0,0:28:23.19,0:28:24.44,italic,,0,0,0,,Tak akan rusak
Dialog: 0,0:28:26.27,0:28:27.61,teks umum,,0,0,0,,Tidak akan berhasil!
Dialog: 0,0:28:31.82,0:28:32.99,teks umum,,0,0,0,,Diam
Dialog: 0,0:28:43.42,0:28:46.92,di luar layar,,0,0,0,,Apakah dia benar-benar mati karena dia tidak memiliki sihir?
Dialog: 0,0:28:48.09,0:28:49.97,sulih suara,,0,0,0,,Bagaimana jika dia hanya sebuah penglihatan...
Dialog: 0,0:28:54.05,0:28:55.14,teks umum,,0,0,0,,Cho Young
Dialog: 0,0:28:56.39,0:29:00.31,teks umum,,0,0,0,,Aku mendengar suara setiap gerakanmu
Dialog: 0,0:29:02.19,0:29:03.31,teks umum,,0,0,0,,Suara seperti ini,
Dialog: 0,0:29:03.81,0:29:06.06,teks umum,,0,0,0,,seperti dua batu giok yang saling bertabrakan
Dialog: 0,0:29:20.25,0:29:21.08,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:29:29.55,0:29:31.63,teks umum,,0,0,0,,Satu jam telah berlalu, kita harus pergi
Dialog: 0,0:29:31.72,0:29:34.01,teks umum,,0,0,0,,Aku tidak ke mana-mana, aku harus menemukannya
Dialog: 0,0:29:34.09,0:29:37.47,teks umum,,0,0,0,,Tempat ini terlalu besar, kita bertiga tidak akan bisa menemukannya
Dialogue: 0,0:29:37.55,0:29:40.81,teks umum,,0,0,0,,Kamu tetap datang ke sini untuk melihat-lihat, jadi kamu boleh pergi
Dialog: 0,0:29:42.68,0:29:44.48,teks umum,,0,0,0,,Kapan penglihatan Moo Deok datang padamu?
Dialog: 0,0:29:45.52,0:29:47.31,teks umum,,0,0,0,,Saya tidak tahu bagaimana dia muncul
Dialog: 0,0:29:47.81,0:29:49.02,teks umum,,0,0,0,,Tapi...
Dialog: 0,0:29:51.74,0:29:54.45,kenangan,,0,0,0,,Aku datang karena kamu merindukanku
Dialog: 0,0:29:54.53,0:29:55.61,miring,,0,0,0,,Tepat sekali
Dialog: 0,0:29:55.70,0:29:56.87,teks umum,,0,0,0,,Dia juga memberitahuku hal itu
Dialog: 0,0:29:57.49,0:29:58.99,teks umum,,0,0,0,,Bahwa dia datang karena aku memikirkannya
Dialogue: 0,0:29:59.08,0:30:02.83,teks umum,,0,0,0,,Jadi visinya muncul saat memikirkannya?
Dialog: 0,0:30:03.58,0:30:04.83,teks umum,,0,0,0,,Jadi kamu belum melihatnya
Dialog: 0,0:30:05.50,0:30:07.08,miring,,0,0,0,,Dia mendatangiku dan Yulia,
Dialog: 0,0:30:07.17,0:30:09.75,teks umum,,0,0,0,,tetapi tidak untuk Anda, meskipun Anda adalah pemiliknya
Dialogue: 0,0:30:09.84,0:30:12.63,teks umum,,0,0,0,,Kenapa kamu malah memikirkan Moo Deok?
Dialog: 0,0:30:16.51,0:30:18.68,teks umum,,0,0,0,,Saya minum anggur kayu manis dan jahe
Dialogue: 0,0:30:18.76,0:30:21.77,teks umum,,0,0,0,,Apakah kamu kemudian membuatnya mabuk hingga dia mencium bau kayu manis dari jarak satu meter?
Dialog: 0,0:30:21.85,0:30:22.81,teks umum,,0,0,0,,Ya
Dialog: 0,0:30:23.81,0:30:25.77,teks umum,,0,0,0,,Aku memberinya Sasha lagi hari itu
Dialog: 0,0:30:25.85,0:30:28.69,teks umum,,0,0,0,,Bau kayu manis pasti berasal dari dia
Dialog: 0,0:30:29.69,0:30:30.94,teks umum,,0,0,0,,Oh, maksudmu bungkusan itu,
Dialog: 0,0:30:31.73,0:30:34.40,teks umum,,0,0,0,,yang dia gantung di dekat toilet untuk mengusir lalat?
Dialog: 0,0:30:35.07,0:30:36.49,teks umum,,0,0,0,,Dekat toilet?
Dialog: 0,0:30:36.57,0:30:39.87,teks umum,,0,0,0,,Terima kasih, Yang Mulia. Ia mengusir lalat dengan baik
Dialogue: 0,0:30:41.79,0:30:44.33,teks umum,,0,0,0,,Yul, apa yang kamu lakukan saat penglihatan itu datang kepadamu?
Dialog: 0,0:30:47.25,0:30:48.33,teks umum,,0,0,0,,Cermin
Dialog: 0,0:30:49.63,0:30:52.09,teks umum,,0,0,0,,- Cerminku pecah\N- Cerminku juga
Dialog: 0,0:30:54.92,0:30:56.76,teks umum,,0,0,0,,Terlihat dari cermin?
Dialog: 0,0:30:59.09,0:31:00.26,teks umum,,0,0,0,,Cermin?
Dialog: 0,0:31:05.64,0:31:06.77,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:31:18.03,0:31:20.16,miring,,0,0,0,,Itu bukan kamu, itu palsu
Dialog: 0,0:31:20.24,0:31:21.45,teks umum,,0,0,0,,Visi
Dialog: 0,0:31:30.42,0:31:31.84,teks umum,,0,0,0,,Jadi itu kamu
Dialog: 0,0:31:37.92,0:31:39.72,teks umum,,0,0,0,,Apakah dia terkunci di cermin?
Dialog: 0,0:31:40.68,0:31:41.80,teks umum,,0,0,0,,Ya
Dialog: 0,0:31:41.89,0:31:44.97,teks umum,,0,0,0,,Kami tidak bisa melihat apa yang ada di dalamnya, tapi kami yakin dia ada di sana
Dialog: 0,0:31:45.64,0:31:46.85,teks umum,,0,0,0,,Dia ditelan oleh cermin Tosca
Dialogue: 0,0:31:48.02,0:31:49.27,teks umum,,0,0,0,,Cermin Rindu?
Dialog: 0,0:31:49.35,0:31:51.73,teks umum,,0,0,0,,Peninggalan ini menciptakan visi
Dialog: 0,0:31:52.36,0:31:53.69,miring,,0,0,0,,menggunakan cermin lain,
Dialog: 0,0:31:53.77,0:31:56.36,teks umum,,0,0,0,,untuk menunjukkan apa yang ingin dilihat seseorang
Dialog: 0,0:31:57.65,0:32:00.20,teks umum,,0,0,0,,Dia tidak punya sihir, jadi sihir itu pasti memakan dirinya,
Dialog: 0,0:32:00.28,0:32:01.66,teks umum,,0,0,0,,ketika dia melihatnya
Dialog: 0,0:32:03.37,0:32:05.70,teks umum,,0,0,0,,Kita perlu mengekstrak Moo Dok dari cermin
Dialog: 0,0:32:05.79,0:32:09.25,teks umum,,0,0,0,,Mantra kita tidak akan berfungsi karena energi di dalamnya terlalu kuat
Dialog: 0,0:32:10.67,0:32:12.46,teks umum,,0,0,0,,Tolong ambil cermin Tosca dari Jinewon
Dialog: 0,0:32:13.50,0:32:14.67,teks umum,,0,0,0,,Ini tidak mungkin
Dialog: 0,0:32:16.00,0:32:17.96,teks umum,,0,0,0,,Relik menelan seorang pria
Dialog: 0,0:32:18.05,0:32:20.01,teks umum,,0,0,0,,Terlalu berbahaya untuk mengeluarkan cermin dari sana
Dialog: 0,0:32:21.47,0:32:23.26,teks umum,,0,0,0,,Aku perintahkan kamu sebagai Putra Mahkota
Dialog: 0,0:32:23.35,0:32:24.47,teks umum,,0,0,0,,Bawa cermin keluar
Dialog: 0,0:32:26.93,0:32:30.73,teks umum,,0,0,0,,Dewan Terpadu memberi kami jimat untuk melindungi Jinyowon
Dialog: 0,0:32:30.81,0:32:32.94,teks umum,,0,0,0,,tepatnya dalam situasi seperti itu
Dialog: 0,0:32:35.86,0:32:39.15,teks umum,,0,0,0,,Aku tidak tahan bahkan atas perintah raja
Dialog: 0,0:32:41.99,0:32:43.49,teks umum,,0,0,0,,Inggris tidak akan berfungsi
Dialog: 0,0:32:44.66,0:32:45.95,teks umum,,0,0,0,,tanpa Moo Dok
Dialog: 0,0:32:46.03,0:32:48.50,teks umum,,0,0,0,,Maka dia harus tetap di dalam
Dialog: 0,0:32:49.33,0:32:51.71,teks umum,,0,0,0,,Saat waktunya habis,
Dialog: 0,0:32:51.79,0:32:53.67,teks umum,,0,0,0,,Aku akan menutup pintunya
Dialog: 0,0:32:56.80,0:32:57.71,teks umum,,0,0,0,,Ibu
Dialog: 0,0:32:58.59,0:33:00.59,teks umum,,0,0,0,,Saya menemukan giok yin-yang
Dialog: 0,0:33:04.43,0:33:05.97,teks umum,,0,0,0,,Moo Dok tidak mencurinya
Dialog: 0,0:33:07.01,0:33:08.56,miring,,0,0,0,,Saya menemukannya,
Dialog: 0,0:33:08.64,0:33:11.14,miring,,0,0,0,,jadi keluarkan cermin Melankolis dan selamatkan Moo Deok
Dialog: 0,0:33:11.23,0:33:13.94,teks umum,,0,0,0,,Chan Wook akan mati jika dia terkunci di dalam
Dialog: 0,0:33:14.73,0:33:15.81,teks umum,,0,0,0,,Jangan ikut campur
Dialogue: 0,0:33:17.77,0:33:20.86,teks umum,,0,0,0,,Segera setelah waktu yang dijanjikan habis, aku akan menutup pintunya
Dialog: 0,0:33:36.58,0:33:38.09,miring,,0,0,0,,Jangan buang energi
Dialog: 0,0:33:38.17,0:33:40.26,teks umum,,0,0,0,,Kamu tahu kamu tidak bisa memecahkannya
Dialog: 0,0:33:40.34,0:33:42.26,teks umum,,0,0,0,,Diam! Kamu hanyalah sebuah visi
Dialog: 0,0:33:42.34,0:33:44.84,teks umum,,0,0,0,,Ya, saya adalah sebuah visi
Dialog: 0,0:33:46.09,0:33:47.93,teks umum,,0,0,0,,Visi yang menunjukkan dirimu yang sebenarnya
Dialog: 0,0:33:52.52,0:33:55.31,teks umum,,0,0,0,,Orang tidak bisa melihat dirinya dari luar
Dialog: 0,0:33:55.40,0:33:57.77,teks umum,,0,0,0,,Hanya cermin yang dapat membantu mereka dalam hal ini
Dialog: 0,0:33:58.94,0:34:01.44,teks umum,,0,0,0,,Oleh karena itu, gagasanmu tentang dirimu sendiri
Dialog: 0,0:34:02.57,0:34:04.24,teks umum,,0,0,0,,juga hanya sebuah visi
Dialog: 0,0:34:07.95,0:34:10.99,teks umum,,0,0,0,,Beginilah cara orang lain memandangmu
Dialog: 0,0:34:11.87,0:34:15.87,teks umum,,0,0,0,,Mereka hanya melihat apa yang mereka inginkan, dan mereka sendiri yang menciptakan gambar yang mereka butuhkan
Dialog: 0,0:34:18.54,0:34:19.88,teks umum,,0,0,0,,Ini juga sebuah visi
Dialogue: 0,0:34:20.55,0:34:21.92,teks umum,,0,0,0,,Jika kamu berkata sejujurnya,
Dialog: 0,0:34:23.09,0:34:25.59,teks umum,,0,0,0,,yang berarti orang hanya melihat penglihatan dan tidak lebih
Dialog: 0,0:34:26.84,0:34:27.84,teks umum,,0,0,0,,Tepat
Dialog: 0,0:34:28.68,0:34:31.72,teks umum,,0,0,0,,Aku berubah menjadi apa yang paling ingin mereka lihat dan tunjukkan pada mereka
Dialog: 0,0:34:36.06,0:34:37.73,teks umum,,0,0,0,,Aku akan melakukan hal yang sama untukmu
Dialog: 0,0:34:45.15,0:34:46.70,teks umum,,0,0,0,,Beri aku energimu
Dialog: 0,0:34:46.78,0:34:47.82,teks umum,,0,0,0,,Lalu aku
Dialog: 0,0:34:49.03,0:34:51.41,teks umum,,0,0,0,,Aku akan berubah menjadi versi dirimu yang paling ideal
Dialog: 0,0:34:57.04,0:34:58.21,teks umum,,0,0,0,,Tapi...
Dialog: 0,0:34:59.71,0:35:02.71,teks umum,,0,0,0,,Anda memerlukan refleksi saya untuk menciptakan visi seperti itu
Dialog: 0,0:35:03.96,0:35:05.13,teks umum,,0,0,0,,Apa?
Dialog: 0,0:35:05.72,0:35:07.51,teks umum,,0,0,0,,Jika tidak ada yang perlu direnungkan,
Dialog: 0,0:35:09.39,0:35:10.93,teks umum,,0,0,0,,cermin akan menjadi tidak berguna
Dialog: 0,0:35:31.28,0:35:33.83,teks umum,,0,0,0,,Kamu hanya sepotong kaca
Dialog: 0,0:35:35.58,0:35:37.16,teks umum,,0,0,0,,Cukup bicara
Dialog: 0,0:35:38.33,0:35:39.58,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:35:40.75,0:35:42.34,teks umum,,0,0,0,,Apakah kamu disana?
Dialog: 0,0:35:44.00,0:35:45.13,miring,,0,0,0,,Moo Dok!
Dialog: 0,0:35:46.71,0:35:47.88,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:35:50.64,0:35:51.68,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:35:53.56,0:35:55.31,miring,,0,0,0,,Chan Wook, aku di sini
Dialog: 0,0:35:57.52,0:35:58.77,teks umum,,0,0,0,,Ditemukan
Dialog: 0,0:36:06.19,0:36:07.82,miring,,0,0,0,,Waktu habis
Dialog: 0,0:36:08.49,0:36:10.66,teks umum,,0,0,0,,Cho Young, tutup pintunya
Dialog: 0,0:36:10.74,0:36:11.82,teks umum,,0,0,0,,Ibu
Dialog: 0,0:36:12.82,0:36:15.41,teks umum,,0,0,0,,- Sekarang{\i1}\N- Harap tunggu
Dialog: 0,0:36:27.30,0:36:28.88,teks umum,,0,0,0,,Saya ingin masuk
Dialog: 0,0:36:30.34,0:36:32.30,miring,,0,0,0,,Jika relik tidak bisa dibawa keluar,
Dialog: 0,0:36:32.39,0:36:36.76,teks umum,,0,0,0,,lalu aku sendiri yang akan masuk ke sana dan menariknya keluar dari cermin
Dialogue: 0,0:36:36.85,0:36:39.93,teks umum,,0,0,0,,Bagaimana caranya mengizinkan penyihir kuat masuk?
Dialog: 0,0:36:40.02,0:36:41.31,teks umum,,0,0,0,,Percayalah padaku
Dialog: 0,0:36:42.10,0:36:44.69,teks umum,,0,0,0,,Saya tidak akan menyentuh satu pun artefak
Dialog: 0,0:36:44.77,0:36:46.15,teks umum,,0,0,0,,Aku bahkan tidak tahu
Dialog: 0,0:36:46.23,0:36:49.53,teks umum,,0,0,0,,Pesulap dari Sosnovy Bor telah mengecewakan kepercayaanku
Dialog: 0,0:36:51.65,0:36:55.07,teks umum,,0,0,0,,Apakah kamu sudah membiarkan penyihir Hutan Pinus masuk ke Jinyeowon?
Dialogue: 0,0:36:57.99,0:36:59.70,teks umum,,0,0,0,,Jika kamu ingin menyelamatkan Chan Wook,
Dialog: 0,0:36:59.79,0:37:03.54,teks umum,,0,0,0,,kamu harus meminta penyihir Jeonjingak untuk mengeluarkannya dari sana
Dialog: 0,0:37:07.71,0:37:08.76,teks umum,,0,0,0,,Bab,
Dialog: 0,0:37:08.84,0:37:10.01,teks umum,,0,0,0,,kita tidak punya banyak waktu
Dialog: 0,0:37:13.55,0:37:15.93,teks umum,,0,0,0,,Yul, aku ingin kamu masuk
Dialog: 0,0:37:16.68,0:37:18.26,teks umum,,0,0,0,,dan membawa Uka keluar dari sana
Dialog: 0,0:37:23.81,0:37:24.94,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:37:26.02,0:37:27.36,teks umum,,0,0,0,,Saat kamu pergi,
Dialog: 0,0:37:28.61,0:37:30.24,teks umum,,0,0,0,,Aku sedang memikirkan tentang
Dialog: 0,0:37:31.95,0:37:33.24,teks umum,,0,0,0,,apa yang bisa kulakukan,
Dialog: 0,0:37:34.57,0:37:36.66,miring,,0,0,0,,untuk membuatmu tetap dekat
Dialog: 0,0:37:39.95,0:37:41.83,teks umum,,0,0,0,,Jika aku menjadi gwangju Jeonbugwan,
Dialog: 0,0:37:43.75,0:37:45.42,teks umum,,0,0,0,,kamu bisa menjadi wakilku
Dialog: 0,0:37:46.33,0:37:48.00,teks umum,,0,0,0,,Mengapa saya membutuhkan ini?
Dialog: 0,0:37:48.09,0:37:50.76,miring,,0,0,0,,Kamu bilang kamu tidak ingin tetap menjadi pelayanku
Dialog: 0,0:37:50.84,0:37:53.68,teks umum,,0,0,0,,Kami tidak bisa memberitahu siapa pun bahwa kamu adalah guruku
Dialog: 0,0:37:53.76,0:37:56.30,teks umum,,0,0,0,,Tapi kamu bisa tinggal jika kamu menjadi asistenku
Dialogue: 0,0:37:56.39,0:37:59.51,teks umum,,0,0,0,,Akankah Gwangju Jeongbugwan memiliki pengembara di sampingnya?
Dialog: 0,0:38:01.47,0:38:02.68,teks umum,,0,0,0,,Apakah kamu gila?
Dialog: 0,0:38:05.90,0:38:08.27,teks umum,,0,0,0,,Aku memikirkan hal ini saat mendengar berita tentang pernikahanku
Dialog: 0,0:38:09.27,0:38:11.23,teks umum,,0,0,0,,"Dia akhirnya punya jalan keluar"
Dialog: 0,0:38:12.32,0:38:14.07,teks umum,,0,0,0,,"Bagaimana aku bisa hidup tanpa dia?"
Dialogue: 0,0:38:15.82,0:38:17.74,teks umum,,0,0,0,,Saya yakin kamu merasa tersesat
Dialogue: 0,0:38:23.71,0:38:25.33,teks umum,,0,0,0,,Saat kamu tidak ada, aku juga tidak
Dialog: 0,0:38:27.67,0:38:28.96,teks umum,,0,0,0,,merasa tersesat
Dialog: 0,0:38:43.89,0:38:45.06,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:38:47.15,0:38:48.44,teks umum,,0,0,0,,Aku merindukanmu
Dialog: 0,0:39:22.43,0:39:24.18,kenangan miring,,0,0,0,,Jika mereka menangkapku, anggap saja kamu tidak tahu apa-apa
Dialog: 0,0:39:25.02,0:39:27.85,kenangan,,0,0,0,,Tak seorang pun di sini akan membiarkan binatang ini menyerangku
Dialogue: 0,0:39:34.19,0:39:35.90,kenangan miring,,0,0,0,,Kalau begitu bantu aku
Dialog: 0,0:39:35.99,0:39:37.86, kenangan miring,,0,0,0,,pergi ke sana
Dialog: 0,0:39:38.53,0:39:39.36,kenangan,,0,0,0,,Oke
Dialog: 0,0:39:39.45,0:39:42.91,kenangan,,0,0,0,,Aku akan membawamu ke puncak pohon ini
Dialog: 0,0:40:15.78,0:40:16.69,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:40:17.19,0:40:18.19,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:40:20.49,0:40:21.66,miring,,0,0,0,,Dia disini
Dialog: 0,0:40:21.74,0:40:22.95,miring,,0,0,0,,Siapa?
Dialog: 0,0:40:23.53,0:40:25.49,miring,,0,0,0,,Itu dia, gadis buta!
Dialog: 0,0:40:26.33,0:40:27.70,miring,,0,0,0,,Itu batu es!
Dialog: 0,0:40:32.00,0:40:33.50,teks umum,,0,0,0,,Cermin akan pecah berkeping-keping
Dialog: 0,0:40:34.21,0:40:35.13,teks umum,,0,0,0,,Menjauh
Dialog: 0,0:41:38.86,0:41:39.90,miring,,0,0,0,,Tn.
Dialog: 0,0:41:40.40,0:41:41.65,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:41:41.74,0:41:44.07,teks umum,,0,0,0,,- Apakah kamu baik-baik saja?\N- Semuanya baik-baik saja
Dialog: 0,0:41:44.16,0:41:46.07,teks umum,,0,0,0,,- Apakah Mu Dok aman?\N- Tentu saja
Dialog: 0,0:42:15.31,0:42:17.90,teks umum,,0,0,0,,Aku tersandung saat membawa giok yin-yang
Dialog: 0,0:42:19.02,0:42:21.36,teks umum,,0,0,0,,Saya pikir itu rusak saat itu
Dialog: 0,0:42:22.65,0:42:25.49,teks umum,,0,0,0,,Jadi kamu mencoba menyalahkan pelayan atas batu giok yang sudah rusak
Dialog: 0,0:42:27.32,0:42:28.57,teks umum,,0,0,0,,Dan cermin Tosca?
Dialog: 0,0:42:29.78,0:42:31.70,teks umum,,0,0,0,,Itu berdiri di dekatnya,
Dialog: 0,0:42:31.79,0:42:33.50,teks umum,,0,0,0,,tapi aku bahkan tidak menyentuhnya
Dialog: 0,0:42:34.12,0:42:37.17,teks umum,,0,0,0,,Uk tidak cukup kuat untuk memecahkannya
Dialogue: 0,0:42:38.08,0:42:39.54,italic,,0,0,0,,Pasti begitu,
Dialog: 0,0:42:39.63,0:42:42.80,teks umum,,0,0,0,,Aku merusak cermin saat terjatuh
Dialog: 0,0:42:46.93,0:42:48.26,teks umum,,0,0,0,,A Mu Deok
Dialog: 0,0:42:49.05,0:42:51.97,teks umum,,0,0,0,,apakah kamu juga mengunci diri di Jinewon?
Dialog: 0,0:42:52.06,0:42:55.69,teks umum,,0,0,0,,Akulah yang menyegel pintu, tapi dia masuk sendiri
Dialog: 0,0:42:55.77,0:42:59.52,teks umum,,0,0,0,,Hanya anggota keluarga Jin yang bisa membuka pintu Jinyeowon
Dialog: 0,0:43:01.19,0:43:02.69,teks umum,,0,0,0,,Apakah maksudmu Moo Dok bisa membukanya?
Dialog: 0,0:43:04.78,0:43:06.20,teks umum,,0,0,0,,Lalu mungkin,
Dialog: 0,0:43:07.15,0:43:08.78,teks umum,,0,0,0,,Saya membukanya
Dialog: 0,0:43:09.57,0:43:12.45,teks umum,,0,0,0,,Aku baru saja melihatnya masuk ke sana dan menutup pintu dengan marah
Dialog: 0,0:43:15.12,0:43:16.16,teks umum,,0,0,0,,Maaf
Dialog: 0,0:43:17.71,0:43:19.08,teks umum,,0,0,0,,Saya akan bilang,
Dialog: 0,0:43:20.67,0:43:23.59,teks umum,,0,0,0,,sehingga tidak ada yang membicarakan apa yang terjadi
Dialog: 0,0:43:26.13,0:43:29.14,teks umum,,0,0,0,,Saya juga tidak akan mengatakan apa pun,\Nagar tidak merusak reputasi Anda
Dialogue: 0,0:43:30.39,0:43:32.14,teks umum,,0,0,0,,Mohon maaf yang tulus
Dialog: 0,0:43:36.06,0:43:37.31,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:43:38.06,0:43:39.40,teks umum,,0,0,0,,Masih tidak melihat apa pun?
Dialog: 0,0:43:41.23,0:43:42.15,teks umum,,0,0,0,,Tidak
Dialog: 0,0:43:42.73,0:43:44.98,teks umum,,0,0,0,,Saat cermin pecah, cahayanya sangat terang
Dialog: 0,0:43:45.61,0:43:47.15,teks umum,,0,0,0,,Aku tidak bisa membuka mataku
Dialog: 0,0:43:50.45,0:43:52.37,teks umum,,0,0,0,,Kita harus menutup matamu
Dialog: 0,0:43:56.00,0:43:57.12,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:44:01.54,0:44:05.34,teks umum,,0,0,0,,Jika kamu melihat matahari dalam waktu lama, kamu bisa kehilangan penglihatanmu untuk sementara waktu
Dialog: 0,0:44:06.09,0:44:07.30,teks umum,,0,0,0,,Kamu akan segera sembuh
Dialog: 0,0:44:09.05,0:44:10.55,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:44:11.14,0:44:12.60,teks umum,,0,0,0,,Itu bukan salahmu
Dialog: 0,0:44:13.39,0:44:14.97,teks umum,,0,0,0,,Ini semua salah Nyonya Jin
Dialog: 0,0:44:25.65,0:44:27.49,miring,,0,0,0,,Moo Dok, kamu baik-baik saja?
Dialog: 0,0:44:28.32,0:44:30.78,teks umum,,0,0,0,,Apa yang kamu lakukan di sini, Tuan Dan Gu?
Dialog: 0,0:44:32.57,0:44:33.99,teks umum,,0,0,0,,Saya khawatir
Dialog: 0,0:44:34.62,0:44:35.99,miring,,0,0,0,,Mataku sakit
Dialog: 0,0:44:36.58,0:44:38.20,teks umum,,0,0,0,,Mr. Yul, apakah kamu ikut juga?
Dialog: 0,0:44:42.71,0:44:45.84,teks umum,,0,0,0,,Biarkan mereka memeriksamu di Sejukwon, aku akan mengantarmu ke sana
Dialog: 0,0:44:45.92,0:44:47.84,miring,,0,0,0,,Istananya tidak jauh, dia bisa pergi kesana
Dialog: 0,0:44:48.34,0:44:50.59,teks umum,,0,0,0,,Yang Mulia, apakah Anda juga di sini?
Dialog: 0,0:44:56.10,0:44:57.85,teks umum,,0,0,0,,Aku akan memberimu penyembuh raja
Dialog: 0,0:44:58.47,0:44:59.85,miring,,0,0,0,,Tidak perlu
Dialog: 0,0:44:59.93,0:45:03.19,teks umum,,0,0,0,,Dia dibutakan oleh cahaya, matanya tidak rusak
Dialog: 0,0:45:04.23,0:45:07.36,teks umum,,0,0,0,,Aku tahu ini bukan salahmu,\Ntapi mereka datang ke sini karenamu
Dialog: 0,0:45:07.44,0:45:10.15,teks umum,,0,0,0,,Jadi mohon maaf dan terima kasih semuanya
Dialog: 0,0:45:13.20,0:45:14.66,teks umum,,0,0,0,,Maaf mengganggu anda
Dialog: 0,0:45:15.32,0:45:16.83,teks umum,,0,0,0,,Terima kasih banyak
Dialog: 0,0:45:29.30,0:45:30.42,teks umum,,0,0,0,,Master...
Dialog: 0,0:45:32.01,0:45:33.05,teks umum,,0,0,0,,Ayo pulang
Dialog: 0,0:45:57.24,0:45:59.20,teks umum,,0,0,0,,Setelah apa yang terjadi
Dialog: 0,0:46:00.41,0:46:03.21,teks umum,,0,0,0,,Saya tidak tahu apa yang akan terjadi pada pernikahannya
Dialog: 0,0:46:03.29,0:46:04.67,teks umum,,0,0,0,,Apakah kamu mendengar apa yang dia katakan?
Dialog: 0,0:46:05.50,0:46:08.50,teks umum,,0,0,0,,Dia siap menutup pintu, meskipun tuannya ada di dalam
Dialog: 0,0:46:09.13,0:46:10.25,teks umum,,0,0,0,,Mengerikan sekali
Dialog: 0,0:46:10.34,0:46:13.34,teks umum,,0,0,0,,Khawatir dia akan memiliki ibu mertua seperti itu
Dialog: 0,0:46:13.42,0:46:15.51,teks umum,,0,0,0,,Dia melakukan ini untuk melindungi Jinyeowon
Dialog: 0,0:46:16.26,0:46:18.26,miring,,0,0,0,,Saat kamu punya sesuatu untuk dilindungi,
Dialog: 0,0:46:18.35,0:46:21.47,teks umum,,0,0,0,,terkadang kamu harus membuat keputusan sulit
Dialog: 0,0:46:22.14,0:46:23.31,teks umum,,0,0,0,,Jadi...
Dialog: 0,0:46:24.31,0:46:25.94,teks umum,,0,0,0,,apakah kamu akan melakukan hal yang sama?
Dialogue: 0,0:46:27.35,0:46:30.23,teks umum,,0,0,0,,Aku berani bilang kalau kamu dan aku dekat
Dialog: 0,0:46:30.32,0:46:33.74,teks umum,,0,0,0,,Jika saya ada di dalam? Maukah Anda menutup pintunya?
Dialogue: 0,0:46:34.61,0:46:35.53,teks umum,,0,0,0,,Sangat kejam?
Dialog: 0,0:46:40.16,0:46:41.29,teks umum,,0,0,0,,Sungguh...
Dialog: 0,0:46:42.16,0:46:43.37,teks umum,,0,0,0,,Sepertinya kamu akan melakukan ini
Dialogue: 0,0:46:44.75,0:46:46.87,teks umum,,0,0,0,,Bahkan jika nyawaku dipertaruhkan?
Dialog: 0,0:46:46.96,0:46:49.42,teks umum,,0,0,0,,Jangan tempatkan aku dalam posisi yang sulit
Dialog: 0,0:46:50.63,0:46:52.25,teks umum,,0,0,0,,karena kejadian fiktif
Dialog: 0,0:46:52.34,0:46:54.17,teks umum,,0,0,0,,Saya tidak terlalu terkunci
Dialog: 0,0:46:54.92,0:46:57.30,miring,,0,0,0,,Sulit untuk berbohong dan berkata,
Dialogue: 0,0:46:57.38,0:46:59.60,teks umum,,0,0,0,,- bahwa kamu tidak akan pernah menutup pintunya?{\i1}\N- Aku tidak bisa
Dialog: 0,0:47:00.10,0:47:03.64,teks umum,,0,0,0,,berbohong padamu
Dialog: 0,0:47:05.60,0:47:06.77,teks umum,,0,0,0,,Tepat
Dialog: 0,0:47:07.81,0:47:09.86,teks umum,,0,0,0,,Ini yang harus kamu lakukan
Dialog: 0,0:47:14.36,0:47:16.45,teks umum,,0,0,0,,Kamu harus menyapa Tn.
Dialog: 0,0:47:17.11,0:47:20.91,teks umum,,0,0,0,,Tidak layak, tidak ada yang perlu kukatakan padanya
Dialog: 0,0:47:22.12,0:47:24.29,teks umum,,0,0,0,,Aku tidak bisa bersikap seolah semuanya baik-baik saja
Dialog: 0,0:47:25.08,0:47:28.17,teks umum,,0,0,0,,Begitu. Terima kasih untuk semuanya
Dialog: 0,0:47:28.75,0:47:29.58,miring,,0,0,0,,Ini waktunya untukmu
Dialogue: 0,0:47:39.09,0:47:40.34,teks umum,,0,0,0,,Tapi tetap saja, pembantu Kim,
Dialog: 0,0:47:42.72,0:47:44.31,teks umum,,0,0,0,,jika aku harus menutup pintu,
Dialog: 0,0:47:45.81,0:47:47.43,teks umum,,0,0,0,,itu akan menghancurkan hatiku
Dialog: 0,0:47:50.15,0:47:51.52,teks umum,,0,0,0,, berkeping-keping
Dialog: 0,0:47:59.15,0:48:01.95,teks umum,,0,0,0,,Tidak fleksibel dan lamban
Dialog: 0,0:48:04.16,0:48:06.79,teks umum,,0,0,0,,"Bagaimana cara menutup pintu jika kamu di dalam?"
Dialogue: 0,0:48:08.25,0:48:10.37,teks umum,,0,0,0,,Tidak bisa bilang begitu saja?
Dialog: 0,0:48:25.68,0:48:26.93,teks umum,,0,0,0,,Itu berbahaya
Dialog: 0,0:48:28.68,0:48:30.44,miring,,0,0,0,,Masukkan Jinyeowon
Dialog: 0,0:48:30.52,0:48:33.11,teks umum,,0,0,0,,adalah tindakan kekanak-kanakan yang tidak bijaksana
Dialog: 0,0:48:33.19,0:48:34.77,teks umum,,0,0,0,,Jangan terlalu marah
Dialogue: 0,0:48:36.36,0:48:38.36,teks umum,,0,0,0,,Kamu mungkin mengira aku menyedihkan,
Dialog: 0,0:48:39.45,0:48:40.57,teks umum,,0,0,0,,tapi ini hanya visimu
Dialog: 0,0:48:42.62,0:48:43.45,teks umum,,0,0,0,,Apa?
Dialog: 0,0:48:43.53,0:48:45.70,teks umum,,0,0,0,,Cermin di Jinyowon memberitahuku,
Dialog: 0,0:48:46.29,0:48:48.16,teks umum,,0,0,0,,bahwa orang hanya melihat apa
Dialog: 0,0:48:48.25,0:48:50.50,teks umum,,0,0,0,,apa yang mereka inginkan
Dialog: 0,0:48:51.46,0:48:52.50,teks umum,,0,0,0,,Ini adalah sebuah visi
Dialog: 0,0:48:52.58,0:48:54.75,teks umum,,0,0,0,,Apakah kamu ingin mengatakan bahwa kamu seperti sebuah visi bagiku?
Dialog: 0,0:48:54.84,0:48:55.92,teks umum,,0,0,0,,Jika tidak demikian,
Dialog: 0,0:48:57.13,0:48:59.17,teks umum,,0,0,0,,mengapa kamu ingin aku duduk diam?
Dialog: 0,0:49:02.55,0:49:04.26,teks umum,,0,0,0,,Sepanjang hidupku aku berusaha mati-matian
Dialog: 0,0:49:05.26,0:49:07.64,teks umum,,0,0,0,,buktikan kepada semua orang bahwa aku adalah anak ayahku
Dialog: 0,0:49:07.72,0:49:08.68,teks umum,,0,0,0,,Tapi
Dialogue: 0,0:49:09.98,0:49:11.23,teks umum,,0,0,0,,kamu bilang itu tidak benar
Dialog: 0,0:49:11.31,0:49:13.27,teks umum,,0,0,0,,Itu menyakitiku, tapi membantuku menghilangkan ilusi
Dialog: 0,0:49:13.98,0:49:15.48,miring,,0,0,0,,Tapi meski begitu,
Dialogue: 0,0:49:15.56,0:49:17.73,teks umum,,0,0,0,,mengapa kamu ingin aku tetap menjadi sebuah visi?
Dialog: 0,0:49:17.82,0:49:19.32,teks umum,,0,0,0,,Saya tidak peduli siapa Anda
Dialog: 0,0:49:20.65,0:49:22.32,teks umum,,0,0,0,,Aku hanya ingin satu hal
Dialogue: 0,0:49:23.41,0:49:24.78,teks umum,,0,0,0,,jaga keamananmu...
Dialog: 0,0:49:26.28,0:49:27.83,teks umum,,0,0,0,,dari bahaya
Dialog: 0,0:49:32.16,0:49:35.63,teks umum,,0,0,0,,Tujuanku kini kehilangan makna
Dialog: 0,0:49:37.92,0:49:39.34,teks umum,,0,0,0,,Jadi mulai sekarang...
Dialog: 0,0:49:40.84,0:49:42.34,teks umum,,0,0,0,,saya akan coba
Dialog: 0,0:49:43.80,0:49:45.18,teks umum,,0,0,0,,cari tahu siapa aku
Dialog: 0,0:49:46.72,0:49:48.22,teks umum,,0,0,0,,dan siapa yang harus menjadi
Dialog: 0,0:50:19.59,0:50:20.88,teks umum,,0,0,0,,Sekarang kamu paham?
Dialog: 0,0:50:21.76,0:50:23.76,teks umum,,0,0,0,,Ya. Saya mengerti
Dialog: 0,0:50:28.60,0:50:29.51,teks umum,,0,0,0,,Apa?
Dialog: 0,0:50:29.60,0:50:31.89,teks umum,,0,0,0,,Saya diberitahu bahwa cermin itu bermain dengan imajinasi
Dialog: 0,0:50:31.97,0:50:34.81,teks umum,,0,0,0,,Aku harus memeriksa apakah aku benar-benar menyelamatkanmu
Dialog: 0,0:50:36.19,0:50:38.61,teks umum,,0,0,0,,Kamu tidak menyelamatkanku. Saya memecahkannya dan keluar sendiri
Dialog: 0,0:50:39.48,0:50:40.32,teks umum,,0,0,0,,Apa?
Dialog: 0,0:50:40.40,0:50:42.15,teks umum,,0,0,0,,Saat aku terjebak di cermin,
Dialog: 0,0:50:42.82,0:50:45.07,teks umum,,0,0,0,,sejenak kekuatanku kembali,
Dialog: 0,0:50:45.15,0:50:46.91,teks umum,,0,0,0,,seperti di Danau Gyeongcheongdaeho
Dialogue: 0,0:50:47.91,0:50:50.20,teks umum,,0,0,0,,Aku yakin aku memecahkan cermin itu dengan kekuatanku sendiri
Dialog: 0,0:50:50.28,0:50:51.87,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:50:51.95,0:50:54.04,teks umum,,0,0,0,,Aku sangat senang, kupikir aku menyelamatkanmu
Dialog: 0,0:50:54.12,0:50:55.21,teks umum,,0,0,0,,Meluncurkan bibirku
Dialog: 0,0:50:55.29,0:50:57.92,teks umum,,0,0,0,,Kamu seharusnya bersyukur kamu tidak terseret ke dalamnya
Dialog: 0,0:50:58.00,0:51:01.00,teks umum,,0,0,0,,Kamu di dalam, aku sedang memikirkannya
Dialog: 0,0:51:01.09,0:51:02.63,teks umum,,0,0,0,,Omong kosong
Dialogue: 0,0:51:03.13,0:51:05.05,teks umum,,0,0,0,,Itu tidak akan menukarmu denganku
Dialog: 0,0:51:05.13,0:51:07.47,teks umum,,0,0,0,,Bagaimana jika itu membuatku tersedot? Jadi itu tidak bohong?
Dialog: 0,0:51:07.55,0:51:08.93,teks umum,,0,0,0,,Kalau begitu aku akan selamat
Dialog: 0,0:51:09.01,0:51:10.35,teks umum,,0,0,0,,Dan aku akan mati!
Dialog: 0,0:51:12.10,0:51:15.10,teks umum,,0,0,0,,Dengar, pelajar. Ketika situasinya tidak ada harapan,
Dialog: 0,0:51:15.18,0:51:18.40,teks umum,,0,0,0,,solusi terbaik adalah mengorbankan dirimu dan menyelamatkanku
Dialog: 0,0:51:18.48,0:51:19.81,teks umum,,0,0,0,,Ya, sekarang juga!
Dialog: 0,0:51:21.27,0:51:22.65,teks umum,,0,0,0,,Jika aku mati, kamu juga harus mati
Dialog: 0,0:51:22.73,0:51:24.40,teks umum,,0,0,0,,Kamu tidak bisa hidup nyaman tanpaku
Dialog: 0,0:51:26.07,0:51:27.74,teks umum,,0,0,0,,Dan tidak ada yang lain!
Dialogue: 0,0:51:27.82,0:51:31.03,teks umum,,0,0,0,,Jika kau membahayakan nyawa murid, maka kau harus mempertaruhkan nyawamu sendiri
Dialog: 0,0:51:31.95,0:51:34.04,teks umum,,0,0,0,,Oke. Saya akan mengingat hal ini untuk masa depan
Dialog: 0,0:51:34.91,0:51:36.83,teks umum,,0,0,0,,Apa yang akan kamu lakukan jika kamu menikahi seorang wanita,
Dialog: 0,0:51:36.91,0:51:39.63,teks umum,,0,0,0,,siapa yang hampir membunuh gurumu?
Dialog: 0,0:51:40.67,0:51:44.13,teks umum,,0,0,0,,Menikahinya adalah jaminan keselamatanku
Dialog: 0,0:51:46.80,0:51:48.76,teks umum,,0,0,0,,Tapi kamu hampir kehilangan nyawamu,
Dialog: 0,0:51:49.38,0:51:51.18,teks umum,,0,0,0,,jadi aku juga harus mempertaruhkan nyawaku
Dialog: 0,0:51:57.64,0:51:59.56,miring,,0,0,0,,Ini adalah perkawinan kenyamanan
Dialog: 0,0:52:00.19,0:52:03.23,teks umum,,0,0,0,,Kami akan menyelesaikan semua kesalahpahaman setelah pernikahan
Dialog: 0,0:52:03.32,0:52:05.86,teks umum,,0,0,0,,Kamu menganggapku sebagai menantu,
Dialog: 0,0:52:06.65,0:52:08.28,teks umum,,0,0,0,,karena saya adalah pewaris keluarga Chan
Dialog: 0,0:52:08.36,0:52:10.36,teks umum,,0,0,0,,dan kemungkinan kandidat untuk jabatan Gwangju Jeonbugwan
Dialogue: 0,0:52:11.24,0:52:13.37,teks umum,,0,0,0,,Keluarga kita akan bersatu dan menjadi lebih berpengaruh
Dialog: 0,0:52:14.33,0:52:17.37,teks umum,,0,0,0,,Karena ini adalah pernikahan kenyamanan,
Dialog: 0,0:52:18.16,0:52:20.62,teks umum,,0,0,0,,kita harus berbicara secara terbuka tentang kekuatan dan kelemahan kita
Dialog: 0,0:52:21.42,0:52:23.92,teks umum,,0,0,0,,Mungkin saya bukan putra Gwangju Chang Gang
Dialog: 0,0:52:26.80,0:52:28.80,teks umum,,0,0,0,,Rumor seperti itu tidak menggangguku
Dialogue: 0,0:52:31.26,0:52:33.10,teks umum,,0,0,0,,Tapi bagaimana jika rumor ini...
Dialog: 0,0:52:34.30,0:52:35.35,teks umum,,0,0,0,,benarkah?
Dialog: 0,0:52:38.27,0:52:40.19,teks umum,,0,0,0,,Apakah kamu siap mengambil risiko...
Dialog: 0,0:52:40.94,0:52:43.81,teks umum,,0,0,0,,dan terima aku sebagai menantumu?
Dialog: 0,0:52:56.03,0:52:58.54,teks umum,,0,0,0,,Sepertinya kamu masih memakai gelang itu
Dialog: 0,0:53:01.46,0:53:02.58,teks umum,,0,0,0,,Ya
Dialog: 0,0:53:05.54,0:53:07.67,teks umum,,0,0,0,, Kurang ajar seperti biasanya
Dialogue: 0,0:53:16.89,0:53:20.73,teks umum,,0,0,0,,Mengapa kamu memutuskan menikahi Cho Young tanpa mendiskusikannya denganku?
Dialog: 0,0:53:21.85,0:53:25.23,teks umum,,0,0,0,,Siapakah kamu hingga ikut campur dalam urusan keluarga kita?
Dialog: 0,0:53:25.31,0:53:26.44,teks umum,,0,0,0,,Suster,
Dialog: 0,0:53:28.36,0:53:30.07,teks umum,,0,0,0,,Saya juga anggota keluarga Jin
Dialog: 0,0:53:31.82,0:53:36.45,teks umum,,0,0,0,,Nama keluarga Jin hanya diberikan kepada mereka yang ibunya berasal dari klan Jin
Dialog: 0,0:53:37.70,0:53:41.41,teks umum,,0,0,0,,Ibuku bodoh, memberikan nama belakang itu,
Dialog: 0,0:53:42.08,0:53:44.25,teks umum,,0,0,0,,yang dikandung ayah kami di luar nikah
Dialog: 0,0:53:44.96,0:53:47.88,teks umum,,0,0,0,,Kamu akan menyingkirkanku segera setelah kamu menjadi kepala Jinyeowon
Dialogue: 0,0:53:49.13,0:53:51.51,teks umum,,0,0,0,,Masih marah padaku?
Dialog: 0,0:53:51.59,0:53:52.72,teks umum,,0,0,0,,Ini bukan soal pelanggaran
Dialog: 0,0:53:53.84,0:53:55.39,teks umum,,0,0,0,,Aku membencimu
Dialog: 0,0:53:58.35,0:54:01.06,teks umum,,0,0,0,,Kamu pengkhianat, karena ini aku membencimu
Dialog: 0,0:54:04.94,0:54:08.11,teks umum,,0,0,0,,Kepala Jinyeowon tidak boleh membuat keputusan berdasarkan preferensi pribadi
Dialog: 0,0:54:09.40,0:54:11.90,teks umum,,0,0,0,,Memilih Chan Wook, kamu membuat kesalahan
Dialogue: 0,0:54:11.99,0:54:13.40,teks umum,,0,0,0,,Jangan nikahkan Cho Young dengan Wook
Dialog: 0,0:54:13.49,0:54:14.70,teks umum,,0,0,0,,Apa?
Dialog: 0,0:54:15.41,0:54:19.24,teks umum,,0,0,0,,Aku tahu yang paling cocok untuknya
Dialog: 0,0:54:19.99,0:54:21.37,teks umum,,0,0,0,,Bagaimana kamu menyukai Putra Mahkota...
Dialog: 0,0:54:22.20,0:54:23.83,teks umum,,0,0,0,,sebagai menantu?
Dialogue: 0,0:54:27.79,0:54:31.09,teks umum,,0,0,0,,Apakah kamu ingin Putra Mahkota bergabung dengan keluarga kita dan kita hidup bersama?
Dialog: 0,0:54:31.84,0:54:33.51,teks umum,,0,0,0,,Cho Young adalah putri kedua dalam keluarga
Dialog: 0,0:54:33.59,0:54:36.13,teks umum,,0,0,0,,Bu Young adalah yang tertua, dia akan memimpin keluarga
Dialog: 0,0:54:37.01,0:54:39.22,miring,,0,0,0,,Calon suaminya akan bergabung dengan keluarga,
Dialog: 0,0:54:39.30,0:54:40.89,teks umum,,0,0,0,,agar Cho Young bisa tinggal bersama pangeran di istana
Dialog: 0,0:54:42.43,0:54:46.60,teks umum,,0,0,0,,Apa yang sedang kamu lakukan? Beraninya kamu berbicara tentang Boo Young
Dialog: 0,0:54:51.36,0:54:54.90,teks umum,,0,0,0,,Aku tahu suamimu masih mencari Boo Young
Dialog: 0,0:54:55.53,0:54:58.20,teks umum,,0,0,0,,Sebagai wakil Gwangju Jeonbugwan,
Dialog: 0,0:54:58.28,0:55:01.08,teks umum,,0,0,0,,Saya akan melakukan segala kemungkinan untuk membantu Anda menemukan putri Anda,
Dialog: 0,0:55:01.83,0:55:03.16,teks umum,,0,0,0,,yang sangat kamu cari
Dialog: 0,0:55:05.00,0:55:08.92,teks umum,,0,0,0,,Aku akan menjadikan Boo Young kepala Jinyoung, dan Jo Young akan menjadi ratu
Dialog: 0,0:55:09.00,0:55:10.00,teks umum,,0,0,0,,Jadi tolong,
Dialog: 0,0:55:10.09,0:55:11.92,teks umum,,0,0,0,,jangan anggap dia sebagai Uka
Dialog: 0,0:55:14.46,0:55:15.72,teks umum,,0,0,0,,Bagaimana kabar saudaramu,
Dialogue: 0,0:55:16.47,0:55:19.93,teks umum,,0,0,0,,menjadi Gwangju Jeonbugwan, aku akan mendukung Jinyeowon
Dialog: 0,0:55:21.39,0:55:23.47,teks umum,,0,0,0,,Bagaimanapun, saya adalah anggota keluarga Jin
Dialog: 0,0:55:38.70,0:55:41.66,teks umum,,0,0,0,,Dengar Yul, itu yang aneh
Dialogue: 0,0:55:42.37,0:55:44.37,teks umum,,0,0,0,,Kenapa kamu memikirkan Moo Deok?
Dialog: 0,0:55:45.70,0:55:47.41,teks umum,,0,0,0,,Aku tidak memikirkannya
Dialog: 0,0:55:48.58,0:55:51.42,teks umum,,0,0,0,,Saya juga tidak mengerti mengapa cermin menunjukkan Moo Dok...
Dialogue: 0,0:55:52.17,0:55:54.21,teks umum,,0,0,0,,- Dan kata-katanya itu...\N- Apa yang dia katakan?
Dialog: 0,0:55:54.96,0:55:56.13,teks umum,,0,0,0,,Hei, Yul
Dialogue: 0,0:55:56.21,0:55:57.59,teks umum,,0,0,0,,Kita sebenarnya menuju ke sana
Dialog: 0,0:55:58.22,0:56:00.97,teks umum,,0,0,0,,Apa yang kamu pikirkan di sana? Apa yang membuatmu takut?
Dialog: 0,0:56:05.64,0:56:07.02,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:56:09.85,0:56:11.27,teks umum,,0,0,0,,Roh Kudus
Dialog: 0,0:56:14.52,0:56:15.90,teks umum,,0,0,0,,Keranjang berisi parsel
Dialog: 0,0:56:16.65,0:56:20.91,teks umum,,0,0,0,,Rupanya, hadiah pernikahan Cho Young akan diantar ke Sosnovy Bor hari ini
Dialog: 0,0:56:21.70,0:56:23.58,teks umum,,0,0,0,,Tidak ada yang bisa melihatnya
Dialog: 0,0:56:24.66,0:56:26.12,teks umum,,0,0,0,,Kita perlu membantunya
Dialog: 0,0:56:39.09,0:56:41.55,miring,,0,0,0,,Burung! Tangkap burung itu!
Dialog: 0,0:56:41.64,0:56:42.93,teks umum,,0,0,0,,- Apa ini?\N- Tangkap dia!
Dialog: 0,0:56:43.60,0:56:44.97,miring,,0,0,0,,- Apa ini!\N- Ke mana dia terbang?
Dialog: 0,0:56:45.64,0:56:48.18,miring,,0,0,0,,- Di sana! \N- Dia di sana!
Dialog: 0,0:56:49.27,0:56:50.81,miring,,0,0,0,,- Bagaimana ini bisa terjadi?\N- Yah...
Dialog: 0,0:56:51.77,0:56:53.94,miring,,0,0,0,,- Hai\N- Di sana
Dialogue: 0,0:57:28.10,0:57:29.98,kenangan miring,,0,0,0,,Nak Su menguasai alkimia jiwa
Dialog: 0,0:57:33.27,0:57:36.15,kenangan miring,,0,0,0,,Jika jiwanya meninggalkan tubuhnya, dia mungkin masih hidup
Dialog: 0,0:57:43.99,0:57:46.12,kenangan,,0,0,0,,Kau rindu yang kau temui di Danhyangok
Dialogue: 0,0:57:47.87,0:57:49.70,kenangan,,0,0,0,,Terus pikirkan dia
Dialog: 0,0:57:51.46,0:57:52.79,kenangan,,0,0,0,,Kalau begitu aku akan datang kepadamu lagi
Dialog: 0,0:57:54.37,0:57:58.17,kenangan,,0,0,0,,Musim dingin di Danhyangok lebih hangat dari yang kamu kira
Dialog: 0,0:57:59.17,0:58:02.47,kenangan,,0,0,0,,Di mana matahari bersinar, salju mencair dengan cepat
Dialog: 0,0:58:09.60,0:58:10.89,teks umum,,0,0,0,,Jadi, Mu Dok...
Dialog: 0,0:58:12.18,0:58:13.52,teks umum,,0,0,0,,ini Nak Su
Dialog: 0,0:59:15.87,0:59:18.96,teks umum,,0,0,0,,Kaulah yang meninggalkan jimat roh di Danhyangok
Dialog: 0,0:59:24.30,0:59:26.63,teks umum,,0,0,0,,Jadi kamu masih hidup, Nak Soo
Dialog: 0,0:59:49.07,0:59:50.16,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:59:50.74,0:59:52.41,teks umum,,0,0,0,,Aku lelah menunggumu
Dialog: 0,0:59:53.03,0:59:54.62,teks umum,,0,0,0,,Hamba Kim tidak memberitahumu?
Dialog: 0,0:59:54.70,0:59:56.25,teks umum,,0,0,0,,Kamu seharusnya sudah tiba siang hari
Dialog: 0,0:59:58.12,1:00:00.96,teks umum,,0,0,0,,Ayo cepat. Kita harus sampai ke Danhyangok sebelum matahari terbenam
Dialog: 0,1:00:01.04,1:00:02.38,teks umum,,0,0,0,,Alih-alih Danhyangok,
Dialog: 0,1:00:04.42,1:00:05.84,teks umum,,0,0,0,,ayo pergi ke tempat lain
Dialog: 0,1:00:07.01,1:00:08.09,teks umum,,0,0,0,,Di mana?
Dialog: 0,1:00:09.13,1:00:11.72,teks umum,,0,0,0,,Di timur ada kuil kosong di dekat hutan bambu
Dialog: 0,1:00:12.22,1:00:13.43,teks umum,,0,0,0,,Kita bisa pergi ke sana
Dialog: 0,1:00:19.64,1:00:21.98,kenangan,,0,0,0,,Bawa Chan Wook kesana
Dialogue: 0,1:00:22.06,1:00:23.61,kenangan,,0,0,0,,Maka aku akan mengampuni nyawamu
Dialog: 0,1:00:29.45,1:00:31.28, sulih suara,,0,0,0,,Aku harus meneruskanmu untuk hidup
Dialog: 0,1:00:32.07,1:00:33.28,di belakang layar,,0,0,0,,Begitulah seharusnya
Dialog: 0,1:00:36.08,1:00:37.54,teks umum,,0,0,0,,Saya tidak akan menikah
Dialog: 0,1:00:38.54,1:00:40.54,teks umum,,0,0,0,,Saya memberi mereka alasan untuk menolak pencalonan saya
Dialog: 0,1:00:41.50,1:00:42.63,teks umum,,0,0,0,,Benarkah?
Dialog: 0,1:00:43.38,1:00:44.42,teks umum,,0,0,0,,Tapi...
Dialog: 0,1:00:47.59,1:00:50.30,teks umum,,0,0,0,,pelayan Kim telah menerima giok yin-yang
Dialog: 0,1:00:50.97,1:00:52.68,teks umum,,0,0,0,,Jadi aku membuat sesuatu darinya
Dialog: 0,1:01:00.10,1:01:01.85,teks umum,,0,0,0,,- Ini telur burung\N- Benar
Dialog: 0,1:01:02.52,1:01:03.98,teks umum,,0,0,0,,Ambil satu. Kita akan punya masing-masing satu
Dialog: 0,1:01:07.94,1:01:10.24,teks umum,,0,0,0,,Kami memiliki hubungan yang agak aneh
Dialog: 0,1:01:10.32,1:01:13.03,teks umum,,0,0,0,,Tuan muda dan pelayan. Guru dan murid
Dialog: 0,1:01:13.11,1:01:15.83,teks umum,,0,0,0,,Jadi kupikir mereka bisa mengingatkan kita akan hal itu
Dialog: 0,1:01:16.95,1:01:18.50,teks umum,,0,0,0,,agar kita tetap setia satu sama lain
Dialog: 0,1:01:22.21,1:01:23.46,teks umum,,0,0,0,,Saya yang pertama memilih
Dialog: 0,1:01:23.54,1:01:25.38,teks umum,,0,0,0,,Aku ambil merah, kamu ambil biru
Dialog: 0,1:01:29.76,1:01:33.80,teks umum,,0,0,0,,Guru, mari tetap mengabdi satu sama lain
Dialog: 0,1:01:40.81,1:01:42.81,teks umum,,0,0,0,,- Chan Wook\N- Ya?
Dialog: 0,1:01:45.36,1:01:46.98,teks umum,,0,0,0,,Di sini kita mengucapkan selamat tinggal
Dialog: 0,1:01:51.36,1:01:53.32,teks umum,,0,0,0,,Saya akan kembali ke tempat asal saya
Dialog: 0,1:01:55.57,1:01:58.49,teks umum,,0,0,0,,- Tapi mereka meninggalkanmu\N{\i1}- Hari ini aku bertemu mereka lagi
Dialogue: 0,1:01:59.12,1:02:00.62,teks umum,,0,0,0,,Mereka tahu siapa aku
Dialog: 0,1:02:01.45,1:02:03.21,teks umum,,0,0,0,,Jadi mereka memintaku untuk kembali kepada mereka
Dialog: 0,1:02:03.29,1:02:06.13,teks umum,,0,0,0,,- Saya pikir mereka ingin membunuh Anda\N- Seperti yang Anda lihat, saya masih hidup
Dialog: 0,1:02:06.75,1:02:09.13,teks umum,,0,0,0,,Jika mereka ingin membunuh, mereka pasti sudah membunuh sejak lama
Dialog: 0,1:02:09.80,1:02:13.84,teks umum,,0,0,0,,Jika aku kembali, aku dapat memulihkan energiku
Dialog: 0,1:02:21.56,1:02:22.93,teks umum,,0,0,0,,Saya berjanji akan membantu Anda...
Dialog: 0,1:02:23.02,1:02:25.65,teks umum,,0,0,0,,Dan aku bilang aku akan mendorongmu dari tebing
Dialog: 0,1:02:26.86,1:02:30.11,teks umum,,0,0,0,,Aku tahu aku melatihmu terlalu keras,
Dialog: 0,1:02:32.19,1:02:33.36,teks umum,,0,0,0,,dan kamu melakukan segala dayamu
Dialog: 0,1:02:34.70,1:02:37.12,teks umum,,0,0,0,,- Kita bisa melanjutkan...\N- Tidak
Dialog: 0,1:02:37.20,1:02:40.24,teks umum,,0,0,0,,Jika kita bersatu, kamu akan mati
Dialog: 0,1:02:40.99,1:02:42.58,teks umum,,0,0,0,,Dan aku akan ketahuan
Dialog: 0,1:03:03.89,1:03:08.06,teks umum,,0,0,0,,Apa yang membuat kepala Sosnovy Bor diam-diam datang jauh-jauh ke sini?
Dialog: 0,1:03:08.15,1:03:09.61,teks umum,,0,0,0,,Saya ingin bertanya
Dialog: 0,1:03:10.27,1:03:14.32,teks umum,,0,0,0,,tentang penyihir Jeonbugwan bernama Cho Chun, yang meninggal 20 tahun lalu
Dialog: 0,1:03:19.74,1:03:21.53,miring,,0,0,0,,Pastor Nak Soo, Cho Chun,
Dialog: 0,1:03:22.45,1:03:23.62,teks umum,,0,0,0,,menguasai alkimia jiwa
Dialog: 0,1:03:25.62,1:03:27.58,teks umum,,0,0,0,,Saat kami menemukannya,
Dialog: 0,1:03:28.08,1:03:30.34,teks umum,,0,0,0,,dia sudah menjadi liar
Dialog: 0,1:03:30.42,1:03:34.34,teks umum,,0,0,0,,dan membunuh seluruh keluarganya
Dialog: 0,1:03:41.30,1:03:43.43,miring,,0,0,0,,Empat keluarga harus menyesuaikan diri,
Dialog: 0,1:03:44.14,1:03:45.77,miring,,0,0,0,,untuk menghentikan pertumpahan darah
Dialog: 0,1:03:53.11,1:03:55.86,teks umum,,0,0,0,,Ayah Nak Su juga seorang pengembara?
Dialog: 0,1:03:56.53,1:03:58.20,teks umum,,0,0,0,,Di mata seorang anak kecil,
Dialog: 0,1:03:58.28,1:04:01.78,teks umum,,0,0,0,,mungkin kami adalah pembunuh ayahnya
Dialog: 0,1:04:03.99,1:04:07.08,teks umum,,0,0,0,,Tentunya dia menyalahkan kita atas kematiannya
Dialog: 0,1:04:07.87,1:04:10.46,teks umum,,0,0,0,,dan itulah alasan saya datang ke Sosnovy Bor
Dialog: 0,1:04:12.75,1:04:15.67,teks umum,,0,0,0,,Masalah penting apa yang ingin Anda diskusikan?
Dialog: 0,1:04:15.76,1:04:18.55,teks umum,,0,0,0,,Ingat sesuatu tentang Nak Su?
Dialog: 0,1:04:22.76,1:04:25.89,kenangan,,0,0,0,,Jika kita bertemu lagi, aku akan membunuhmu
Dialog: 0,1:04:30.98,1:04:32.86,teks umum,,0,0,0,,Petunjuk,
Dialog: 0,1:04:32.94,1:04:36.23,teks umum,,0,0,0,,bahwa aku mengambil putri Cho Chun di bawah pengawasanku dan menjadikannya tentara bayaran?
Dialog: 0,1:04:36.32,1:04:39.61,teks umum,,0,0,0,,Kamu membakar tubuhnya segera setelah kamu menemukannya
Dialog: 0,1:04:39.70,1:04:42.70,teks umum,,0,0,0,,Tidak untuk menyembunyikan identitasnya?
Dialog: 0,1:04:44.66,1:04:48.41,teks umum,,0,0,0,,Daripada menjawab, aku akan bercerita tentang apa yang terjadi 20 tahun lalu
Dialog: 0,1:04:52.04,1:04:53.96,teks umum,,0,0,0,,Di sini, di Jeonbugwan kami merekam bintang-bintang...
Dialog: 0,1:04:54.04,1:04:56.30,teks umum,,0,0,0,,dari jam satu pagi hingga jam tiga, saat energi berada pada puncaknya
Dialog: 0,1:04:57.42,1:05:00.93,teks umum,,0,0,0,,Gwangju memeriksa rekaman pada siang hari, tanda disimpan di sini
Dialog: 0,1:05:02.30,1:05:07.27,teks umum,,0,0,0,,Suatu hari tanda yang tertulis pagi itu menghilang
Dialog: 0,1:05:09.27,1:05:12.56,teks umum,,0,0,0,,Untungnya, kami berhasil menemukannya
Dialog: 0,1:05:15.19,1:05:17.86,teks umum,,0,0,0,,Kapan ini?
Dialog: 0,1:05:21.70,1:05:25.58,teks umum,,0,0,0,,Hari istri Chang Gang, Do Hwa, meninggal dan Chang Wook lahir
Dialog: 0,1:05:26.74,1:05:28.79,teks umum,,0,0,0,,Cho Chun menuliskan bintang-bintang hari itu,
Dialog: 0,1:05:28.87,1:05:32.42,teks umum,,0,0,0,,dan akulah yang menemukan tanda yang hilang itu
Dialog: 0,1:05:46.72,1:05:49.22,kenangan miring,,0,0,0,,Saya berhasil mencuri tanda aslinya
Dialog: 0,1:05:49.31,1:05:52.60,kenangan,,0,0,0,,Di Jeonbugwan, palsu tanpa bintang Raja
Dialog: 0,1:05:58.19,1:05:59.78,teks umum,,0,0,0,,Apakah kamu ingin mengatakan,
Dialog: 0,1:06:00.46,1:06:01.90,teks umum,,0,0,0,,apa yang kamu ketahui
Dialog: 0,1:06:03.03,1:06:04.99,teks umum,,0,0,0,,tentang apa yang terjadi ketika...
Dialog: 0,1:06:06.87,1:06:08.24,teks umum,,0,0,0,,Apakah Chan Wook lahir?
Dialog: 0,1:06:11.83,1:06:15.17,teks umum,,0,0,0,,Sebuah bintang yang siap mengubah dunia telah muncul di langit
Dialog: 0,1:06:20.34,1:06:23.01,teks umum,,0,0,0,,Tahukah kamu tentang bintang Raja?
Dialog: 0,1:06:23.09,1:06:25.97,teks umum,,0,0,0,,Apakah menurutmu rahasianya akan mati bersama Cho Chun?
Dialog: 0,1:06:27.55,1:06:30.97,teks umum,,0,0,0,,Menurutmu siapa yang mengubahnya menjadi pemakan jiwa?
Dialog: 0,1:06:34.02,1:06:36.77,teks umum,,0,0,0,,Jangan ajukan pertanyaan yang kamu tidak ingin tahu jawabannya
Dialog: 0,1:06:36.85,1:06:40.02,teks umum,,0,0,0,,Inilah satu-satunya cara kamu melindungi Sosnovy Bor dan penduduknya
Dialog: 0,1:06:52.83,1:06:56.00,kenangan miring,,0,0,0,,Dan Joo tidak tahu kamu masih hidup, Nak Soo
Dialog: 0,1:06:57.88,1:06:59.38,kenangan,,0,0,0,,Aku tidak memberitahunya
Dialog: 0,1:07:00.21,1:07:01.67,kenangan,,0,0,0,,Bawakan Chan Wook
Dialog: 0,1:07:01.75,1:07:03.72,kenangan,,0,0,0,,Kalau begitu aku akan tutup mulut
Dialog: 0,1:07:08.26,1:07:10.72,kenangan,,0,0,0,,Aku akan memindahkan jiwaku ke tubuhnya
Dialog: 0,1:07:30.24,1:07:31.58,teks umum,,0,0,0,,Dimana Chan Wook?
Dialog: 0,1:07:32.37,1:07:33.75,teks umum,,0,0,0,,Dia akan segera datang
Dialog: 0,1:07:40.42,1:07:43.00,teks umum,,0,0,0,,Apa yang membawamu ke sini selarut ini?
Dialog: 0,1:07:46.47,1:07:47.97,teks umum,,0,0,0,,Sebelum Inggris lahir...
Dialog: 0,1:07:49.09,1:07:51.35,teks umum,,0,0,0,,Sekitar 20 tahun yang lalu...
Dialog: 0,1:07:51.43,1:07:52.72,teks umum,,0,0,0,,Bisakah Chang Gan...
Dialog: 0,1:07:53.97,1:07:56.06,teks umum,,0,0,0,,menguasai jenis sihir tertentu?
Dialog: 0,1:07:59.40,1:08:00.77,teks umum,,0,0,0,,Chan Gan mampu...
Dialog: 0,1:08:02.27,1:08:04.11,teks umum,,0,0,0,,memindahkan jiwa?
Dialogue: 0,1:08:19.58,1:08:21.04,teks umum,,0,0,0,,Kenapa lama sekali?
Dialog: 0,1:08:24.55,1:08:26.01,teks umum,,0,0,0,,Akhirnya hujan mulai turun
Dialog: 0,1:08:26.96,1:08:28.26,teks umum,,0,0,0,,Dia akan berada di sini sekarang
Dialogue: 0,1:08:32.55,1:08:33.89,teks umum,,0,0,0,,Sudahkah kamu membodohiku?
Dialog: 0,1:08:36.22,1:08:38.27,teks umum,,0,0,0,,Tunggu apa lagi?
Dialog: 0,1:08:39.81,1:08:42.90,teks umum,,0,0,0,,Karena Dan Zhu masih belum muncul,
Dialog: 0,1:08:42.98,1:08:45.57,teks umum,,0,0,0,,jadi kamu benar-benar tidak memberitahunya apa pun
Dialog: 0,1:08:47.28,1:08:48.57,teks umum,,0,0,0,,Oh kamu...
Dialog: 0,1:09:12.97,1:09:14.30,kenangan miring,,0,0,0,,Di sini kita ucapkan selamat tinggal
Dialog: 0,1:09:16.35,1:09:18.56,kenangan,,0,0,0,,Bagaimana dengan kuil kosong di hutan?
Dialog: 0,1:09:20.23,1:09:22.85,kenangan,,0,0,0,,Kenapa kamu tidak mau mengajakku bersamamu?
Dialog: 0,1:09:22.94,1:09:25.02,kenangan,,0,0,0,,Tadinya aku akan menyingkirkanmu di sana demi menyelamatkan diriku sendiri
Dialog: 0,1:09:26.86,1:09:28.90,kenangan,,0,0,0,,Sekarang kamu tahu, jangan pernah berpikir untuk mengikutiku
Dialog: 0,1:09:29.65,1:09:32.49,kenangan,,0,0,0,,Kalau begitu kamu seharusnya tidak memberitahuku tentang kuil itu
Dialog: 0,1:09:33.70,1:09:35.74,kenangan,,0,0,0,,Biarkan kamu pergi sendiri,
Dialog: 0,1:09:36.53,1:09:38.54,kenangan,,0,0,0,,mengetahui bahwa di sana berbahaya?
Dialog: 0,1:09:41.79,1:09:43.29,kenangan,,0,0,0,,Sekarang aku merasa lebih buruk daripada kamu
Dialog: 0,1:09:43.37,1:09:45.92,kenangan,,0,0,0,,Aku melewatkan kesempatan hidupku karena telur burung
Dialogue: 0,1:09:46.00,1:09:48.13,kenangan,,0,0,0,,Aku senang bisa mengingatkanmu akan pengabdian
Dialog: 0,1:09:48.21,1:09:49.76,kenangan,,0,0,0,,Aku benar-benar bisa saja mati
Dialog: 0,1:09:53.68,1:09:55.72,kenangan,,0,0,0,,Aku membantumu menghindari kematian,
Dialog: 0,1:09:56.97,1:09:59.10,kenangan,,0,0,0,,jadi bertarung sampai mati
Dialog: 0,1:10:00.18,1:10:03.85,kenangan,,0,0,0,,Berbicara seolah-olah kamu menyelamatkanku
Dialog: 0,1:10:05.35,1:10:08.02,kenangan,,0,0,0,,Jika langit mendung memberkati kita dengan hujan,
Dialog: 0,1:10:09.69,1:10:11.74,kenangan,,0,0,0,,maka kita berdua bisa hidup
Dialog: 0,1:10:20.54,1:10:22.29,teks umum,,0,0,0,,Keberuntungan dan kebenaran ada di pihakmu, Uk
Dialog: 0,1:10:22.83,1:10:24.58,teks umum,,0,0,0,,Di luar sedang hujan lebat
Dialog: 0,1:10:25.50,1:10:27.71,teks umum,,0,0,0,,Saya pikir lawan saya tidak lebih kuat dari saya
Dialog: 0,1:10:28.96,1:10:30.59,teks umum,,0,0,0,,Dia adalah pesulap dari Jeonbugwan
Dialog: 0,1:10:30.67,1:10:32.26,teks umum,,0,0,0,,Halo. Apakah kamu ingat aku?
Dialog: 0,1:12:46.27,1:12:48.68,di balik layar,,0,0,0,,Ini dia. Sekarang waktunya menggunakan tansu
Dialog: 0,1:12:48.77,1:12:52.06,di luar layar,,0,0,0,,Jangan mencoba membagi tetesan dengan pedang yang tidak terkendali,
Dialog: 0,1:12:52.15,1:12:54.44,di luar layar,,0,0,0,,pegang pedang hingga jatuh ke atasnya
Dialog: 0,1:13:52.58,1:13:53.79,teks umum,,0,0,0,,Tidak...
Dialog: 0,1:13:57.50,1:13:58.80,teks umum,,0,0,0,,Ada apa?
Dialog: 0,1:13:58.88,1:13:59.84,teks umum,,0,0,0,,Alkimia Jiwa
Dialog: 0,1:14:51.10,1:14:53.43,di balik layar,,0,0,0,,Jiwaku...
Dialog: 0,1:14:54.02,1:14:55.52,di luar layar,,0,0,0,,bergerak sekarang?
Dialog: 0,1:15:17.00,1:15:18.42,pratinjau,,0,0,0,,Chan Wook
Dialog: 0,1:15:19.75,1:15:23.46,pratinjau,,0,0,0,,Jadi kamu bertukar tubuh dengan muridku, Gil Joo
Dialog: 0,1:15:23.55,1:15:26.09,pratinjau,,0,0,0,,Saya kira Inggris menjadi korban transmigrasi jiwa
Dialog: 0,1:15:26.18,1:15:27.09,pratinjau,,0,0,0,,Apa?
Dialog: 0,1:15:27.18,1:15:29.68,pratinjau,,0,0,0,,Pria yang memindahkan jiwa ayahku...
Dialog: 0,1:15:29.76,1:15:31.89,pratinjau,,0,0,0,,apakah ini Jin Moo dari Jeonbugwan?
Dialog: 0,1:15:33.93,1:15:36.44,pratinjau,,0,0,0,,Apakah itu kamu? Bukankah itu kamu?
Dialog: 0,1:15:36.52,1:15:39.69,pratinjau,,0,0,0,,Apakah kamu yakin batu es itu hancur?
Dialog: 0,1:15:40.31,1:15:42.65,pratinjau,,0,0,0,,Suruh semua penyihir kita menemukan Gil Zhu
Dialog: 0,1:15:42.73,1:15:45.15,pratinjau,,0,0,0,,Harus tetap menjadi rahasia kalau mereka pengembara
Dialog: 0,1:15:45.15,1:15:47.15,teks umum,,0,0,0,,
Dialog: 0,0:02:55.14,0:02:57.14, torehan,,0,0,0,,

