Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, tommo, Zero_Amamiya
Dialog: 0,0:00:59.00,0:01:00.71,miring,,0,0,0,,Kamu bisa menyembuhkan pengembara
Dialog: 0,0:01:00.80,0:01:03.84,teks umum,,0,0,0,,dan menjadikannya manusia, meskipun dia menjadi liar?
Dialog: 0,0:01:05.18,0:01:08.18,teks umum,,0,0,0,,Kami tidak mencoba menjadikannya manusia lagi
Dialog: 0,0:01:08.68,0:01:12.73,teks umum,,0,0,0,,Kami berusaha membuatnya tetap sadar agar dia bisa berbicara
Dialog: 0,0:01:16.15,0:01:18.73,teks umum,,0,0,0,,Jadi kamu tidak mencoba menyelamatkannya
Dialog: 0,0:01:18.82,0:01:21.99,teks umum,,0,0,0,,Ketika pengembara berubah menjadi pemakan jiwa, tak ada jalan untuk kembali
Dialog: 0,0:01:22.95,0:01:24.24,teks umum,,0,0,0,,Mereka adalah monster
Dialog: 0,0:01:26.12,0:01:29.03,miring,,0,0,0,,Entah mereka akan memakan energi manusia,
Dialog: 0,0:01:29.12,0:01:31.29,miring,,0,0,0,,atau akan membatu. Satu dari dua
Dialog: 0,0:01:38.54,0:01:40.30,teks umum,,0,0,0,,Kami tidak dapat mencegah hal ini
Dialog: 0,0:01:44.72,0:01:45.72,teks umum,,0,0,0,,Batu es
Dialogue: 0,0:01:47.85,0:01:50.26,teks umum,,0,0,0,,Kudengar dia punya kekuatan Hwangsu
Dialogue: 0,0:01:50.35,0:01:52.35,teks umum,,0,0,0,,Bisakah batu menghentikan sirkulasi?
Dialog: 0,0:01:53.98,0:01:55.98,teks umum,,0,0,0,,Mungkin. Tapi...
Dialog: 0,0:01:57.19,0:02:01.03,teks umum,,0,0,0,,orang tidak boleh menggunakan kekuatan seperti itu dalam keadaan apa pun
Dialog: 0,0:02:14.58,0:02:16.37,teks umum,,0,0,0,,Sepertinya akan turun hujan
Dialog: 0,0:02:18.50,0:02:21.30,teks umum,,0,0,0,,Dan aku tidak bisa menggunakan kekuatan reflektor
Dialog: 0,0:02:21.38,0:02:24.34,teks umum,,0,0,0,,Sepertinya semuanya akan tersapu oleh hujan
Dialog: 0,0:02:24.42,0:02:27.38,teks umum,,0,0,0,,Saat hujan, apakah kekuatan reflektornya hilang?
Dialog: 0,0:02:27.47,0:02:30.05,teks umum,,0,0,0,,Kekuatan batu es datang dari surga
Dialogue: 0,0:02:30.14,0:02:32.72,teks umum,,0,0,0,,Jadi surga bisa mengambil kekuatan ini
Dialog: 0,0:02:53.91,0:02:56.62, sulih suara,,0,0,0,,Apakah dia mencoba memanggil kekuatan surga,
Dialogue: 0,0:02:56.71,0:02:59.17,di luar layar,,0,0,0,,untuk menyembunyikan batunya?
Dialog: 0,0:03:03.92,0:03:05.46,teks umum,,0,0,0,,Jin Bu Young
Dialog: 0,0:03:06.80,0:03:09.97,teks umum,,0,0,0,,Jika dia masih hidup, dia akan menjadi pendeta yang kuat,
Dialog: 0,0:03:10.51,0:03:13.22,teks umum,,0,0,0,,yang dapat mengendalikan kekuatan surga
Dialog: 0,0:03:37.37,0:03:38.83,teks umum,,0,0,0,,Apakah kamu baik-baik saja
Dialogue: 0,0:03:39.46,0:03:42.38,teks umum,,0,0,0,,Aku juga baik-baik saja. Anda belum menjadi liar
Dialog: 0,0:04:01.15,0:04:03.02,teks umum,,0,0,0,,Gerbang di atas mangkuk konstelasi telah terbuka
Dialog: 0,0:04:03.69,0:04:05.98,teks umum,,0,0,0,,- Dan langit-langitnya tidak selalu seperti ini?\N- Tidak
Dialog: 0,0:04:06.53,0:04:08.03,teks umum,,0,0,0,,Semua orang berpikir begitu,
Dialog: 0,0:04:08.99,0:04:10.78,teks umum,,0,0,0,,tapi saya diberitahu bahwa ini tidak benar
Dialog: 0,0:04:10.86,0:04:13.12,teks umum,,0,0,0,,Siapa? Ayahmu?
Dialog: 0,0:04:14.62,0:04:17.75,teks umum,,0,0,0,,Dia bilang buka gerbang di atas mangkuk
Dialog: 0,0:04:17.83,0:04:20.29,teks umum,,0,0,0,,hanya penyihir astrolog yang bisa
Dialog: 0,0:04:20.91,0:04:22.67,teks umum,,0,0,0,,Bagaimana ini bisa terjadi?
Dialog: 0,0:04:22.75,0:04:26.00,teks umum,,0,0,0,,Sepertinya kita melakukan sesuatu yang tidak seharusnya kita lakukan
Dialog: 0,0:04:26.09,0:04:27.42,miring,,0,0,0,,Tapi bagaimana caranya?
Dialog: 0,0:04:29.42,0:04:30.51,miring,,0,0,0,,Ini aku
Dialog: 0,0:04:32.59,0:04:33.97,teks umum,,0,0,0,,Aku membuka gerbangnya
Dialog: 0,0:04:35.05,0:04:36.85,teks umum,,0,0,0,,Energiku bocor ke dalam air
Dialog: 0,0:04:37.68,0:04:39.43,teks umum,,0,0,0,,Seperti di Danau Gyeongcheongdaeho
Dialog: 0,0:04:40.27,0:04:41.89,teks umum,,0,0,0,,dan di cermin Tosca
Dialog: 0,0:04:43.77,0:04:46.02,teks umum,,0,0,0,,Energiku kembali berkat air ini
Dialog: 0,0:05:05.13,0:05:06.46,teks umum,,0,0,0,,Apa maksudnya petir menyambar?
Dialog: 0,0:05:06.54,0:05:08.59,teks umum,,0,0,0,,Suara keras datang dari ruang rekaman
Dialog: 0,0:05:09.38,0:05:12.42,teks umum,,0,0,0,,Kasim Kim dan Chan Wook ada di sana sekarang
Dialog: 0,0:05:20.47,0:05:22.35,teks umum,,0,0,0,,Inilah kekuatan reflektor
Dialog: 0,0:05:23.02,0:05:25.94,teks umum,,0,0,0,,Energi gelap yang sama seperti saat Kil Ju mencoba bertukar tubuh
Dialog: 0,0:05:28.36,0:05:29.61,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:05:30.19,0:05:33.28,teks umum,,0,0,0,,Saya tidak melihat apa pun, seperti dalam kasus cermin
Dialog: 0,0:05:33.78,0:05:35.36,teks umum,,0,0,0,,Pusing dan mual
Dialog: 0,0:05:35.45,0:05:37.53,teks umum,,0,0,0,,Jin Mu akan segera datang, kita harus pergi
Dialog: 0,0:05:49.96,0:05:51.34,teks umum,,0,0,0,,Tepat. pintu
Dialog: 0,0:05:53.84,0:05:56.39,teks umum,,0,0,0,,Dia menutup pintu dengan energi, mangkuk rasi bintang pecah,
Dialog: 0,0:05:56.47,0:05:57.89,teks umum,,0,0,0,,dan pemakan jiwa sudah mati
Dialog: 0,0:05:59.39,0:06:00.39,teks umum,,0,0,0,,Kami punya masalah
Dialog: 0,0:06:01.18,0:06:03.64,teks umum,,0,0,0,,Ada jalan keluar untuk pelayan di sebelah mangkuk konstelasi
Dialog: 0,0:06:04.69,0:06:06.85,teks umum,,0,0,0,,Ayah membawaku melewati pintu ini
Dialog: 0,0:06:07.44,0:06:09.44,teks umum,,0,0,0,,Tapi kita akan tetap berada di Jeonbugwan
Dialog: 0,0:06:13.74,0:06:16.61,teks umum,,0,0,0,,Kamu tidak melihat, dan aku tidak tahu jalannya
Dialog: 0,0:06:17.99,0:06:21.37,teks umum,,0,0,0,,Jika kita tersesat, kita akan tertangkap
Dialog: 0,0:06:21.45,0:06:23.70,teks umum,,0,0,0,,Kita diam di sini - Jin Mu akan datang dan membunuh kita
Dialog: 0,0:06:23.79,0:06:25.54,teks umum,,0,0,0,,Aku tidak akan menang melawan dia
Dialog: 0,0:06:29.21,0:06:31.96,teks umum,,0,0,0,,Kita harus memanggil penyelamatku
Dialog: 0,0:06:33.26,0:06:35.09,teks umum,,0,0,0,,- Penyelamat?\N- Ada satu
Dialog: 0,0:06:37.05,0:06:40.64,teks umum,,0,0,0,,Hatinya akan bergetar, dan dia akan segera datang
Dialog: 0,0:06:41.31,0:06:42.76,teks umum,,0,0,0,,Penyelamatku
Dialog: 0,0:07:06.91,0:07:09.25,teks umum,,0,0,0,,Chan Wook, apakah kamu bercanda?
Dialog: 0,0:07:14.84,0:07:16.55,teks umum,,0,0,0,,Apakah kamu mendengar suara keras?
Dialog: 0,0:07:16.63,0:07:19.68,teks umum,,0,0,0,,Ya, tapi kamu bilang jangan masuk, jadi kami menunggu
Dialog: 0,0:07:19.76,0:07:22.47,teks umum,,0,0,0,,Yom Soo, ikuti aku. Yang lain menjaga pintu
Dialog: 0,0:07:38.20,0:07:40.36,teks umum,,0,0,0,,Chan Wook memecahkan penghalang dan melarikan diri
Dialog: 0,0:07:40.45,0:07:41.28,miring,,0,0,0,,Deputi
Dialog: 0,0:07:42.07,0:07:43.37,teks umum,,0,0,0,,Mangkuk konstelasi...
Dialog: 0,0:07:44.53,0:07:46.41,teks umum,,0,0,0,,Apa yang terjadi padanya?
Dialog: 0,0:07:47.45,0:07:49.00,teks umum,,0,0,0,,Kita perlu menemukannya
Dialog: 0,0:07:49.08,0:07:50.96,teks umum,,0,0,0,,Kita tidak bisa membiarkan dia keluar dari sini hidup-hidup
Dialog: 0,0:07:51.58,0:07:53.34,teks umum,,0,0,0,,Pindahkan tubuh ke ruang rahasia
Dialog: 0,0:07:53.42,0:07:56.05,teks umum,,0,0,0,,- Tak seorang pun akan melihatmu\N{\i1}- Ya
Dialog: 0,0:08:02.64,0:08:04.81,teks umum,,0,0,0,,Tutup semua pintu keluar
Dialog: 0,0:08:04.89,0:08:06.68,teks umum,,0,0,0,,Temukan Chan Wook dan pembantunya
Dialog: 0,0:08:07.31,0:08:09.77,teks umum,,0,0,0,,Jika terjadi sesuatu, kamu bisa membunuh mereka
Dialog: 0,0:08:09.85,0:08:10.81,miring,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:08:25.49,0:08:29.16,teks umum,,0,0,0,,Chan Wook tidak akan pernah keluar dari labirin ini
Dialogue: 0,0:08:30.46,0:08:31.96,teks umum,,0,0,0,,Dia akan tersesat dan tertangkap
Dialog: 0,0:08:34.29,0:08:35.29,teks umum,,0,0,0,,Atau mungkin...
Dialog: 0,0:08:36.25,0:08:40.17,teks umum,,0,0,0,,dia tahu dia akan tersesat, jadi dia bersembunyi di dalam
Dialog: 0,0:08:43.51,0:08:45.26,teks umum,,0,0,0,,Kamu hampir mengerti
Dialog: 0,0:08:46.47,0:08:47.76,teks umum,,0,0,0,,Apakah kamu di sini?
Dialog: 0,0:08:48.85,0:08:51.52,teks umum,,0,0,0,,Kamu memecahkan penghalang yang aku buat
Dialog: 0,0:08:51.60,0:08:53.65,teks umum,,0,0,0,,Ayo lakukan yang lain. Berapi-api
Dialog: 0,0:08:55.44,0:08:58.07,teks umum,,0,0,0,,Jika aku membakar tempat ini,
Dialog: 0,0:08:58.15,0:09:00.90,teks umum,,0,0,0,,mungkin akan cukup panas,
Dialog: 0,0:09:01.61,0:09:03.28,teks umum,,0,0,0,,untuk membuatmu tampil
Dialog: 0,0:09:03.36,0:09:07.41,miring,,0,0,0,,Coba yakinkan aku seperti dulu, tanpa ancaman
Dialog: 0,0:09:09.58,0:09:11.62,teks umum,,0,0,0,,Mengapa, jika tidak ada ruginya?
Dialog: 0,0:09:12.21,0:09:15.96,teks umum,,0,0,0,,Kamu adalah penjahat yang masuk ke sini tanpa izin dan juga memecahkan cangkir
Dialog: 0,0:09:16.04,0:09:18.09,teks umum,,0,0,0,,Dan tugasku adalah menangkap penjahatnya
Dialog: 0,0:09:18.17,0:09:20.13,teks umum,,0,0,0,,Saya wakil Gwangju
Dialog: 0,0:09:23.47,0:09:26.26,teks umum,,0,0,0,,Kamu terlalu kejam terhadap tamu yang datang membawa hadiah
Dialogue: 0,0:09:26.34,0:09:29.81,teks umum,,0,0,0,,Kesal karena kami mengubah temanmu menjadi batu?
Dialog: 0,0:09:29.89,0:09:30.97,teks umum,,0,0,0,,Teman yang mana?
Dialog: 0,0:09:31.77,0:09:36.19,teks umum,,0,0,0,,Tidak ada seorang pun di sini kecuali kalian berdua dan aku
Dialogue: 0,0:09:36.86,0:09:39.07,teks umum,,0,0,0,,Ah-ah... ingin menyembunyikan badan batu?
Dialog: 0,0:09:40.07,0:09:41.36,miring,,0,0,0,,Tapi apa yang harus dilakukan?
Dialog: 0,0:09:42.69,0:09:45.36,teks umum,,0,0,0,,- Anda akan tertangkap\N- {\u0\i1}Ini tidak akan terjadi
Dialog: 0,0:09:45.86,0:09:48.74,teks umum,,0,0,0,,Karena kamu dan pelayanmu akan mati
Dialog: 0,0:09:49.79,0:09:50.91,miring,,0,0,0,,Keluar
Dialog: 0,0:09:51.50,0:09:52.62,teks umum,,0,0,0,,Keluar!
Dialog: 0,0:10:20.02,0:10:21.73,teks umum,,0,0,0,,Apakah kamu melihatnya?
Dialog: 0,0:10:21.82,0:10:24.11,teks umum,,0,0,0,,Petir menyambar dekat Jeonbugwan
Dialog: 0,0:10:24.19,0:10:26.78,teks umum,,0,0,0,,Jeonbugwan di sebelah istana
Dialog: 0,0:10:26.86,0:10:29.53,teks umum,,0,0,0,,Kita perlu memeriksa apakah semuanya baik-baik saja
Dialog: 0,0:10:29.62,0:10:31.45,teks umum,,0,0,0,,Petir menyambar begitu keras
Dialog: 0,0:10:31.54,0:10:33.95,teks umum,,0,0,0,,Saya harap, langsung dari Jin Mu
Dialog: 0,0:10:49.30,0:10:50.47,teks umum,,0,0,0,,Sayang sekali
Dialog: 0,0:10:51.47,0:10:54.10,teks umum,,0,0,0,,Saya mungkin datang ke sini dengan senang hati,
Dialog: 0,0:10:54.18,0:10:56.39,teks umum,,0,0,0,,membayangkan kamu akan menjadi Gwangju
Dialog: 0,0:10:56.48,0:10:58.06,teks umum,,0,0,0,,Tetapi kamu malah mati
Dialog: 0,0:10:58.15,0:10:59.90,miring,,0,0,0,,Kamu kurang beruntung
Dialog: 0,0:11:01.48,0:11:02.40,teks umum,,0,0,0,,Ini tidak akan berhasil
Dialog: 0,0:11:03.15,0:11:04.28,teks umum,,0,0,0,,Jika aku mati,
Dialog: 0,0:11:04.36,0:11:06.61,teks umum,,0,0,0,,kamu bisa dengan mudah menjadi Gwangju
Dialog: 0,0:11:06.70,0:11:08.28,teks umum,,0,0,0,,Dan ini tidak boleh dibiarkan
Dialog: 0,0:11:08.36,0:11:09.36,teks umum,,0,0,0,,Apa?
Dialog: 0,0:11:11.95,0:11:13.62,teks umum,,0,0,0,,Pernahkah Anda mendengar tentang giok yin-yang?
Dialogue: 0,0:11:15.12,0:11:17.62,teks umum,,0,0,0,,Ini sepasang batu giok merah dan biru
Dialog: 0,0:11:17.71,0:11:20.29,teks umum,,0,0,0,,Jika kamu menuangkan energi ke dalam satu batu, batu kedua akan merasakannya
Dialog: 0,0:11:20.38,0:11:21.71,teks umum,,0,0,0,,Jika mereka dekat,
Dialog: 0,0:11:22.50,0:11:24.55,teks umum,,0,0,0,,mereka akan menemukan satu sama lain
Dialog: 0,0:11:25.80,0:11:26.76,teks umum,,0,0,0,,Jadi apa?
Dialog: 0,0:11:26.84,0:11:28.30,teks umum,,0,0,0,,Salah satu dari dua batu, biru,
Dialog: 0,0:11:29.18,0:11:31.14,teks umum,,0,0,0,,sekarang bersama Putra Mahkota
Dialog: 0,0:11:33.22,0:11:34.35, kenangan miring,,0,0,0,, Giok sayang
Dialog: 0,0:11:34.43,0:11:36.98,kenangan,,0,0,0,,Aku menerimanya dengan imbalan kodok
Dialog: 0,0:11:37.06,0:11:38.23,kenangan,,0,0,0,,Apakah dia berharga?
Dialog: 0,0:11:40.23,0:11:42.02,teks umum,,0,0,0,,Jadi apa?
Dialog: 0,0:11:42.11,0:11:44.32,teks umum,,0,0,0,,Saya punya warna merah
Dialog: 0,0:11:44.40,0:11:46.94,teks umum,,0,0,0,,Saya mencurahkan energi padanya, yang artinya Yang Mulia
Dialog: 0,0:11:47.82,0:11:49.40,teks umum,,0,0,0,,dalam perjalanan ke sini sekarang
Dialog: 0,0:11:59.33,0:12:01.04,teks umum,,0,0,0,,Maukah kamu membunuhku dan mengambil batunya?
Dialog: 0,0:12:02.46,0:12:05.17,teks umum,,0,0,0,,Saya pikir begitu, jadi saya menyembunyikan batunya
Dialogue: 0,0:12:07.67,0:12:10.13,teks umum,,0,0,0,,Mengisinya dengan energi dan menyembunyikannya
Dialog: 0,0:12:10.22,0:12:12.18,teks umum,,0,0,0,,dalam jubah penelan jiwa kasim
Dialog: 0,0:12:21.90,0:12:25.65,miring,,0,0,0,,Yang Mulia mungkin sedang terburu-buru menuju tubuh batu
Dialog: 0,0:12:28.99,0:12:31.32,teks umum,,0,0,0,,Bayangkan reaksinya saat melihat ini
Dialog: 0,0:12:32.20,0:12:34.82,teks umum,,0,0,0,,Dia akan sangat terkejut
Dialog: 0,0:12:47.30,0:12:48.30,teks umum,,0,0,0,,Jeonbugwan
Dialog: 0,0:12:50.84,0:12:52.88,teks umum,,0,0,0,,Chan Wook di suatu tempat di Jeonbugwan
Dialog: 0,0:13:00.39,0:13:02.02,teks umum,,0,0,0,,Jangan buang waktumu untuk membunuhku,
Dialog: 0,0:13:02.85,0:13:04.90,teks umum,,0,0,0,,lebih baik hentikan Putra Mahkota
Dialog: 0,0:13:09.57,0:13:11.11,teks umum,,0,0,0,,Saya akan segera kembali
Dialog: 0,0:13:12.20,0:13:14.70,teks umum,,0,0,0,,Kamu tetap tidak bisa kabur dari sini
Dialog: 0,0:13:26.46,0:13:28.46,teks umum,,0,0,0,,- Di mana mayatnya?\N- Di ruang rahasia
Dialog: 0,0:13:28.55,0:13:31.09,teks umum,,0,0,0,,Jika Anda memesan, saya akan mengeluarkannya dari sana
Dialog: 0,0:13:40.85,0:13:42.06,teks umum,,0,0,0,,Di mana...
Dialog: 0,0:13:45.10,0:13:48.61,teks umum,,0,0,0,,Dia tidak ada di sini. ini membodohiku
Dialog: 0,0:13:51.57,0:13:53.03,teks umum,,0,0,0,,Deputi
Dialog: 0,0:13:53.11,0:13:55.91,teks umum,,0,0,0,,Kamu memerintahkan untuk tidak membiarkan siapa pun masuk, tapi tidak ada pilihan
Dialog: 0,0:13:56.49,0:13:59.16,teks umum,,0,0,0,,Apa? Apakah Putra Mahkota ada di sini?
Dialog: 0,0:13:59.24,0:14:00.20,teks umum,,0,0,0,,Ya
Dialog: 0,0:14:02.33,0:14:04.50,teks umum,,0,0,0,,Jadi dia tidak berbohong tentang giok
Dialog: 0,0:14:21.18,0:14:22.22,teks umum,,0,0,0,,Deputi
Dialog: 0,0:14:22.31,0:14:25.39,teks umum,,0,0,0,,Kasim kerajaan berubah menjadi burung layang-layang?
Dialogue: 0,0:14:28.56,0:14:31.19,teks umum,,0,0,0,,Dan kamu mencoba membunuh Chan Wook secara diam-diam?
Dialog: 0,0:14:31.27,0:14:33.19,teks umum,,0,0,0,,Ini salah paham, Yang Mulia
Dialog: 0,0:15:10.31,0:15:11.52,teks umum,,0,0,0,,Anda mencoba
Dialog: 0,0:15:11.61,0:15:14.23,teks umum,,0,0,0,,beri makan pelayanku pada penelan jiwa ini
Dialog: 0,0:15:14.32,0:15:18.24,teks umum,,0,0,0,,Lebih baik berikan penjelasan normal tentang apa yang terjadi
Dialog: 0,0:15:30.50,0:15:33.50,teks umum,,0,0,0,,Anda bertanya tentang Cho Chun, yang bekerja
Dialog: 0,0:15:33.59,0:15:35.80,teks umum,,0,0,0,,astrogazer di Jeonbugwan?
Dialogue: 0,0:15:36.30,0:15:40.05,teks umum,,0,0,0,,Kudengar Chang Gang dan Cho Chun dekat
Dialog: 0,0:15:40.14,0:15:41.18,teks umum,,0,0,0,,Ya
Dialog: 0,0:15:41.93,0:15:43.60,teks umum,,0,0,0,,Mereka adalah teman baik
Dialog: 0,0:15:44.26,0:15:45.93,teks umum,,0,0,0,,Cho Chun sering mengunjungi kami
Dialog: 0,0:15:46.52,0:15:50.06,teks umum,,0,0,0,,Dia adalah orang yang ceria dan baik hati
Dialog: 0,0:15:51.19,0:15:52.86,teks umum,,0,0,0,,Cho Chun menggunakan ilmu hitam,
Dialog: 0,0:15:52.94,0:15:55.57,teks umum,,0,0,0,,yang menghancurkan seluruh keluarganya
Dialogue: 0,0:15:55.65,0:15:57.24,teks umum,,0,0,0,,Dia orang baik
Dialog: 0,0:15:57.94,0:16:01.41,teks umum,,0,0,0,,Aku masih tidak percaya ini terjadi
Dialog: 0,0:16:02.82,0:16:06.66,teks umum,,0,0,0,,Dia mempunyai seorang putri. Tahukah kamu dia?
Dialog: 0,0:16:07.54,0:16:09.00,teks umum,,0,0,0,,Ya, saya ingat dia
Dialog: 0,0:16:09.50,0:16:13.25,teks umum,,0,0,0,,Dia selalu bersama ayahnya, mereka dekat
Dialog: 0,0:16:13.33,0:16:15.38,teks umum,,0,0,0,,Kudengar dia hilang
Dialog: 0,0:16:16.25,0:16:17.17,teks umum,,0,0,0,,menurutku,
Dialog: 0,0:16:18.09,0:16:19.47,teks umum,,0,0,0,,dia sudah mati
Dialogue: 0,0:16:20.47,0:16:22.76,teks umum,,0,0,0,,Mengapa kamu memutuskan ini?
Dialog: 0,0:16:22.84,0:16:26.76,teks umum,,0,0,0,,Tuan Chang Gan sudah lama mencari gadis ini
Dialog: 0,0:16:27.77,0:16:30.98,teks umum,,0,0,0,,Jika dia masih hidup, dia pasti sudah menemukannya
Dialog: 0,0:16:31.06,0:16:33.02,teks umum,,0,0,0,,Kecuali disembunyikan
Dialog: 0,0:16:34.27,0:16:35.69,teks umum,,0,0,0,,Nona Do Hwa meninggal
Dialog: 0,0:16:36.61,0:16:38.69,teks umum,,0,0,0,,Ini terjadi pada sahabatnya
Dialogue: 0,0:16:38.78,0:16:41.99,teks umum,,0,0,0,,Master Chan bukanlah dirinya saat itu
Dialogue: 0,0:16:42.53,0:16:45.91,teks umum,,0,0,0,,Dia menyalahkan dirinya sendiri atas kedua kematian tersebut
Dialog: 0,0:16:46.58,0:16:48.16,teks umum,,0,0,0,,dan sangat menderita
Dialog: 0,0:16:49.37,0:16:51.83,teks umum,,0,0,0,,Dia meninggalkan rumah untuk mencari putri temannya
Dialog: 0,0:16:51.92,0:16:54.13,teks umum,,0,0,0,,Saya pikir dia akan kembali ketika dia menemukannya
Dialog: 0,0:16:54.67,0:16:55.67,teks umum,,0,0,0,,Tapi...
Dialog: 0,0:16:56.42,0:17:00.26,teks umum,,0,0,0,,Aneh rasanya dia meninggalkan rumah selama 20 tahun untuk mencari seorang gadis
Dialog: 0,0:17:01.05,0:17:03.72,teks umum,,0,0,0,,Aku mulai curiga dia pergi
Dialog: 0,0:17:03.80,0:17:05.26,teks umum,,0,0,0,,untuk alasan lain
Dialog: 0,0:17:05.76,0:17:09.47,teks umum,,0,0,0,,Jika dia menemukan gadis itu 20 tahun yang lalu,
Dialog: 0,0:17:10.27,0:17:12.89,teks umum,,0,0,0,,hidupnya tidak akan sesulit ini
Dialog: 0,0:17:12.98,0:17:16.94,teks umum,,0,0,0,,Dan Chang Gan tidak akan merasa bersalah
Dialog: 0,0:17:17.02,0:17:18.57,teks umum,,0,0,0,,"Salahkan"?
Dialog: 0,0:17:18.65,0:17:22.61,teks umum,,0,0,0,,Apakah maksudmu Tuan Chan berperilaku salah terhadap temannya?
Dialog: 0,0:17:23.24,0:17:25.32,miring,,0,0,0,,Dia menghukumnya karena ilmu hitam
Dialog: 0,0:17:25.41,0:17:27.37,teks umum,,0,0,0,,Sebagai seorang pesulap, dia harus
Dialog: 0,0:17:27.45,0:17:31.54,teks umum,,0,0,0,,Tidak peduli seberapa dekat mereka, tidak mungkin sebaliknya
Dialog: 0,0:17:31.62,0:17:35.88,teks umum,,0,0,0,,Kamu tidak bisa menilai mana yang benar dan mana yang tidak berdasarkan apa yang telah kamu lihat
Dialog: 0,0:17:36.46,0:17:38.96,teks umum,,0,0,0,,Ada cerita di balik segalanya
Dialog: 0,0:17:39.05,0:17:42.26,teks umum,,0,0,0,,Nasib dijalin dari cerita dan hubungan
Dialog: 0,0:17:42.34,0:17:44.22,teks umum,,0,0,0,,Artinya, hubungan yang menyakitkan
Dialog: 0,0:17:44.30,0:17:49.22,teks umum,,0,0,0,,keluarga Cho dan Chan belum berakhir?
Dialogue: 0,0:17:50.89,0:17:51.89,teks umum,,0,0,0,,Atau kamu...
Dialog: 0,0:17:52.93,0:17:56.90,teks umum,,0,0,0,,apa maksudmu gadis itu ada di rumah ini sekarang?
Dialog: 0,0:17:57.90,0:18:00.19,teks umum,,0,0,0,,Sosnovy Bor menemukannya?
Dialog: 0,0:18:02.74,0:18:04.07,teks umum,,0,0,0,,Gadis itu
Dialog: 0,0:18:06.36,0:18:07.53,teks umum,,0,0,0,,meninggal
Dialog: 0,0:18:13.00,0:18:14.08,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:18:14.91,0:18:16.08,teks umum,,0,0,0,,Kasihan sekali
Dialogue: 0,0:18:17.29,0:18:19.25,teks umum,,0,0,0,,Kita harus menjaganya tetap terjaga
Dialog: 0,0:18:22.59,0:18:23.76,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:18:24.88,0:18:26.43,teks umum,,0,0,0,,Kamu baik sekali
Dialog: 0,0:18:26.51,0:18:28.47,miring,,0,0,0,,Ini bukan isyarat kebaikan
Dialog: 0,0:18:28.55,0:18:31.72,teks umum,,0,0,0,,Aku hanya tidak ingin arwahnya berakhir di dunia ini
Dialog: 0,0:18:32.27,0:18:33.73,teks umum,,0,0,0,,dan menyiksa tuan muda
Dialog: 0,0:18:34.31,0:18:38.61,teks umum,,0,0,0,,Bagaimana jika arwahnya menghantui Chan Wook?
Dialog: 0,0:18:38.69,0:18:41.65,teks umum,,0,0,0,,Kita harus menyingkirkannya. Ini pasti roh jahat
Dialog: 0,0:18:41.73,0:18:43.57,teks umum,,0,0,0,,Aku tidak akan membiarkan dia mengejarnya
Dialog: 0,0:18:45.19,0:18:46.95,teks umum,,0,0,0,,Roh jahat?
Dialog: 0,0:18:50.99,0:18:52.54,teks umum,,0,0,0,,Di mana Moo Dok?
Dialog: 0,0:18:52.62,0:18:53.83,teks umum,,0,0,0,,Mu Dok?
Dialog: 0,0:18:54.41,0:18:57.50,teks umum,,0,0,0,,Saya mengirimnya ke Jeonbugwan untuk suatu keperluan
Dialog: 0,0:19:04.63,0:19:06.05,teks umum,,0,0,0,,Apakah kamu baik-baik saja? Bisakah kamu melihat?
Dialog: 0,0:19:06.80,0:19:08.64,teks umum,,0,0,0,,Ya, begitu
Dialog: 0,0:19:09.22,0:19:10.30,teks umum,,0,0,0,,Dan kamu, tuan?
Dialog: 0,0:19:10.39,0:19:12.64,teks umum,,0,0,0,,Apakah kamu terluka di mana saja?
Dialog: 0,0:19:12.72,0:19:13.85,miring,,0,0,0,,Aku baik-baik saja
Dialog: 0,0:19:13.93,0:19:16.31,kenangan,,0,0,0,,Apa artinya jika dua orang menyimpan barang yang serasi?
Dialog: 0,0:19:16.39,0:19:18.60,kenangan,,0,0,0,,Bahwa mereka sudah menikah atau berpacaran
Dialog: 0,0:19:22.02,0:19:25.19,teks umum,,0,0,0,,Kepala Sosnovy Bor telah tiba atas pesanan Anda
Dialog: 0,0:19:45.84,0:19:47.51,teks umum,,0,0,0,,Anda telah tiba di Jeonbugwan
Dialog: 0,0:19:48.26,0:19:50.93,teks umum,,0,0,0,,memberikan kue madu ke deputi??
Dialog: 0,0:19:51.01,0:19:54.85,teks umum,,0,0,0,,Ya. Saya mendengar Anda berebut mereka
Dialog: 0,0:19:55.52,0:19:57.77,teks umum,,0,0,0,,Hamba Kim tidak ingin dia kesal,
Dialog: 0,0:19:57.85,0:19:59.85,teks umum,,0,0,0,,jadi saya datang untuk mengantarkan paketnya
Dialog: 0,0:19:59.94,0:20:01.35,teks umum,,0,0,0,,Alasan menyedihkan
Dialog: 0,0:20:02.40,0:20:03.56,teks umum,,0,0,0,,Kepala Sosnovy Bor
Dialog: 0,0:20:03.65,0:20:06.65,teks umum,,0,0,0,,dan wakil Gwangju bertengkar soal kue?
Dialog: 0,0:20:08.24,0:20:10.70,teks umum,,0,0,0,,Bahkan jika ini benar, ada baiknya tetap diam mengenai hal itu
Dialog: 0,0:20:10.78,0:20:12.99,teks umum,,0,0,0,,Apa yang kamu lakukan di ruang rekaman?
Dialog: 0,0:20:13.07,0:20:15.41,teks umum,,0,0,0,,Saya ingin melihat mangkuk konstelasi
Dialog: 0,0:20:15.49,0:20:18.29,teks umum,,0,0,0,,Tetapi pada akhirnya saya melihat sesuatu yang seharusnya tidak saya lihat
Dialog: 0,0:20:19.58,0:20:23.13,teks umum,,0,0,0,,Apakah kamu yakin melihat jiwa yang menelan?
Dialog: 0,0:20:23.21,0:20:26.67,teks umum,,0,0,0,,Ya. Dia memasang penghalang di sekelilingku untuk menyembunyikannya
Dialog: 0,0:20:26.75,0:20:29.30,teks umum,,0,0,0,,dan melemparkan Moo Dok kepadanya sehingga dia merasa cukup
Dialog: 0,0:20:29.38,0:20:30.84,teks umum,,0,0,0,,Dia berbohong
Dialog: 0,0:20:32.47,0:20:35.51,teks umum,,0,0,0,,Chan Wook memasuki ruang rekaman tanpa izin
Dialog: 0,0:20:35.60,0:20:37.52,teks umum,,0,0,0,,dan memecahkan mangkuk konstelasi
Dialog: 0,0:20:37.60,0:20:39.93,teks umum,,0,0,0,,Dan ketika dia tertangkap,
Dialog: 0,0:20:40.02,0:20:42.94,teks umum,,0,0,0,,mulai mengemukakan segala macam hal tentang penelan jiwa
Dialog: 0,0:20:44.81,0:20:46.52,teks umum,,0,0,0,,Saya yakin itu adalah penelan jiwa
Dialog: 0,0:20:46.61,0:20:48.57,teks umum,,0,0,0,,Dia berubah menjadi batu
Dialog: 0,0:20:48.65,0:20:50.78,teks umum,,0,0,0,,Pelayanku juga melihatnya
Dialog: 0,0:20:50.86,0:20:52.95,teks umum,,0,0,0,,Ketika saya tiba, saya tidak melihat mayatnya
Dialog: 0,0:20:53.03,0:20:54.62,teks umum,,0,0,0,,Dia mungkin menyembunyikannya
Dialog: 0,0:20:54.70,0:20:56.45,teks umum,,0,0,0,,Segel semua pintu keluar
Dialog: 0,0:20:56.53,0:20:59.37,teks umum,,0,0,0,,dan temukan sang penelan jiwa sebelum dia membawanya keluar
Dialog: 0,0:21:02.37,0:21:06.59,teks umum,,0,0,0,,Saya pikir kebenaran akan terungkap ketika kita menemukan mayatnya
Dialog: 0,0:21:09.51,0:21:12.43,teks umum,,0,0,0,,Saya akan memanggil para penyihir untuk memeriksa Jeonbugwan
Dialog: 0,0:21:12.51,0:21:15.93,teks umum,,0,0,0,,Kamu tidak bisa melakukan itu. Saya tidak bisa membiarkan mereka melakukan ini
Dialog: 0,0:21:16.01,0:21:18.35,teks umum,,0,0,0,,karena kebohongan seseorang yang tidak berdasar
Dialog: 0,0:21:23.98,0:21:25.31,teks umum,,0,0,0,,Chan Wook,
Dialogue: 0,0:21:26.48,0:21:28.52,teks umum,,0,0,0,,apakah sida-sida kerajaan itu penelan jiwa?
Dialog: 0,0:21:28.61,0:21:29.48,teks umum,,0,0,0,,Ya
Dialog: 0,0:21:29.57,0:21:33.20,teks umum,,0,0,0,,Aku melihatnya bersama ratu saat kita berduel
Dialog: 0,0:21:33.28,0:21:35.82,teks umum,,0,0,0,,Kasim Oh, siapa yang ada di sana hari itu?
Dialog: 0,0:21:35.91,0:21:38.49,teks umum,,0,0,0,,Kasim Kim. Dia melayani ratu
Dialog: 0,0:21:39.79,0:21:42.83,teks umum,,0,0,0,,Jadi, kita perlu memeriksa apakah dia ada di istana sekarang atau tidak
Dialog: 0,0:21:43.41,0:21:45.04,miring,,0,0,0,,Periksa
Dialog: 0,0:21:45.12,0:21:47.17,teks umum,,0,0,0,,Ini tidak perlu
Dialog: 0,0:22:10.36,0:22:11.61,miring,,0,0,0,,Sang Ratu telah tiba!
Dialog: 0,0:22:11.69,0:22:13.28,miring,,0,0,0,,Sapa dia
Dialog: 0,0:22:20.91,0:22:21.99,teks umum,,0,0,0,,Ibu
Dialog: 0,0:22:23.33,0:22:25.62,teks umum,,0,0,0,,Deputi memberitahuku tentang apa yang terjadi
Dialog: 0,0:22:25.71,0:22:27.63,teks umum,,0,0,0,,Saya terkejut, jadi saya datang sendiri
Dialog: 0,0:22:31.25,0:22:34.22,teks umum,,0,0,0,,Apakah mereka benar-benar menemukan penelan jiwa di sini?
Dialog: 0,0:22:34.88,0:22:37.26,miring,,0,0,0,,Kasim yang melayanimu adalah seorang pengembara
Dialog: 0,0:22:37.34,0:22:39.93,teks umum,,0,0,0,,Dia menjadi liar dan membatu di sini
Dialog: 0,0:22:41.72,0:22:44.02,teks umum,,0,0,0,,- Begitukah?\N- Ini tidak benar
Dialog: 0,0:22:44.60,0:22:46.98,teks umum,,0,0,0,,Tak seorang pun di sini berubah menjadi batu
Dialog: 0,0:22:47.06,0:22:48.27,teks umum,,0,0,0,,Ini bohong,
Dialog: 0,0:22:49.56,0:22:51.23,teks umum,,0,0,0,,yang ditemukan oleh Chan Wook
Dialog: 0,0:22:51.32,0:22:55.95,teks umum,,0,0,0,,Kita akan tahu apakah ini benar atau salah ketika kita mengetahui di mana si kasim berada
Dialog: 0,0:22:58.78,0:23:02.62,teks umum,,0,0,0,,Siapakah kasim yang diduga berubah menjadi batu ini?
Dialog: 0,0:23:03.70,0:23:05.00,teks umum,,0,0,0,,Kasim Kim
Dialog: 0,0:23:12.59,0:23:15.97,teks umum,,0,0,0,,Kasim Kim tiba di sini bersamaku
Dialog: 0,0:23:26.73,0:23:28.52,teks umum,,0,0,0,,Kasim Kim, masuk
Dialog: 0,0:24:01.68,0:24:03.22,teks umum,,0,0,0,,Kasim ini
Dialog: 0,0:24:04.30,0:24:06.22,teks umum,,0,0,0,,Anda lihat
Dialog: 0,0:24:06.81,0:24:08.47,teks umum,,0,0,0,,membatu?
Dialog: 0,0:24:10.23,0:24:11.27,teks umum,,0,0,0,,Ya
Dialogue: 0,0:24:11.35,0:24:13.98,italic,,0,0,0,,Kamu bilang dia jadi liar
Dialog: 0,0:24:14.06,0:24:16.40,teks umum,,0,0,0,,Tapi dia berdiri di sini dalam keadaan hidup dan sehat
Dialog: 0,0:24:17.82,0:24:19.07,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:24:23.07,0:24:24.62,teks umum,,0,0,0,,Dia baik-baik saja
Dialog: 0,0:24:33.29,0:24:35.46,miring,,0,0,0,,Satu-satunya cara untuk menyelesaikan masalah ini adalah,
Dialog: 0,0:24:38.46,0:24:41.01,teks umum,,0,0,0,,menghidupkannya kembali
Dialog: 0,0:24:57.15,0:24:58.77,di luar layar,,0,0,0,,Dia baik-baik saja, baik-baik saja
Dialog: 0,0:24:59.90,0:25:01.94, sulih suara,,0,0,0,,Jika ini kekuatan batu es,
Dialog: 0,0:25:02.03,0:25:04.49, sulih suara,,0,0,0,,yang berarti aku bisa menyelamatkan Moo Deok, meski dia menjadi liar
Dialog: 0,0:25:05.41,0:25:06.41,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,0:25:07.70,0:25:09.58,teks umum,,0,0,0,,kita pasti melakukan kesalahan
Dialog: 0,0:25:11.41,0:25:12.79,teks umum,,0,0,0,,Mungkin pemiliknya
Dialog: 0,0:25:15.04,0:25:17.63,teks umum,,0,0,0,,Anda tidak salah. Anda berbohong
Dialog: 0,0:25:17.71,0:25:19.80,teks umum,,0,0,0,,Dia berdiri di sini hidup-hidup,
Dialog: 0,0:25:20.67,0:25:22.84,teks umum,,0,0,0,,ternyata aku memang berbohong
Dialog: 0,0:25:27.30,0:25:29.26,teks umum,,0,0,0,,Dia mencoba membodohi semua orang,
Dialogue: 0,0:25:29.35,0:25:32.56,teks umum,,0,0,0,,karena aku memecahkan cawan konstelasi
Dialog: 0,0:25:32.64,0:25:33.85,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:25:35.23,0:25:36.98,teks umum,,0,0,0,,apakah ini benar?
Dialog: 0,0:25:38.61,0:25:42.23,teks umum,,0,0,0,,Ya. Semua yang saya katakan adalah bohong
Dialog: 0,0:25:45.07,0:25:48.28,teks umum,,0,0,0,,Aku pergi ke Jeonbugwan, memecahkan reliknya,
Dialog: 0,0:25:48.37,0:25:52.20,teks umum,,0,0,0,,lalu berbohong untuk menyembunyikannya?
Dialog: 0,0:25:52.29,0:25:55.00,teks umum,,0,0,0,,Maaf, maafkan aku
Dialog: 0,0:25:57.71,0:25:59.46,teks umum,,0,0,0,,Dia adalah penyihir dari Sosnovy Bor,
Dialog: 0,0:25:59.54,0:26:02.38,teks umum,,0,0,0,,Saya pribadi minta maaf karenanya
Dialog: 0,0:26:04.09,0:26:07.01,teks umum,,0,0,0,,Saya minta maaf kepada Deputi Jin Mu
Dialog: 0,0:26:11.18,0:26:15.81,teks umum,,0,0,0,,Hutan pinus akan memperbaiki mangkuk
Dialog: 0,0:26:18.19,0:26:19.40,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:26:19.48,0:26:20.69,miring,,0,0,0,,Jangan menolak
Dialog: 0,0:26:20.77,0:26:23.23,teks umum,,0,0,0,,Ini adalah satu-satunya cara agar kita dapat bertanggung jawab atas hal ini
Dialog: 0,0:26:24.94,0:26:26.40,teks umum,,0,0,0,,- Tidak layak\N- Yang Mulia
Dialog: 0,0:26:26.99,0:26:29.66,teks umum,,0,0,0,,Biarkan Sosnovy Bor memperbaiki kesalahannya
Dialog: 0,0:26:31.95,0:26:33.49,teks umum,,0,0,0,,Biarkan saja, ibu
Dialog: 0,0:26:35.54,0:26:37.41,teks umum,,0,0,0,,Lakukan sesukamu
Dialog: 0,0:26:38.54,0:26:40.63,teks umum,,0,0,0,,Sudah waktunya aku kembali
Dialog: 0,0:27:03.44,0:27:06.40,teks umum,,0,0,0,,Saya akan mengirimkan orang-orang saya besok,
Dialog: 0,0:27:06.49,0:27:08.36,teks umum,,0,0,0,,untuk memperbaiki mangkuk yang pecah
Dialogue: 0,0:27:09.11,0:27:12.41,teks umum,,0,0,0,,Dan sekarang aku harus kembali untuk menghukum si penyihir dengan benar,
Dialog: 0,0:27:12.49,0:27:15.70,teks umum,,0,0,0,,yang berbohong kepada pangeran dan rakyat Jeonbugwan
Dialog: 0,0:27:16.75,0:27:18.21,teks umum,,0,0,0,,- Maju\N- Ini tidak akan berhasil
Dialog: 0,0:27:18.91,0:27:22.21,teks umum,,0,0,0,,Chan Wook akan tinggal dan dihukum di sini
Dialog: 0,0:27:27.46,0:27:29.26,teks umum,,0,0,0,,Menurutku juga begitu...
Dialog: 0,0:27:30.26,0:27:32.09,teks umum,,0,0,0,,Apa yang terjadi, Yang Mulia
Dialog: 0,0:27:32.89,0:27:34.60,teks umum,,0,0,0,,Selamatkan tuanku
Dialog: 0,0:27:35.22,0:27:37.39,teks umum,,0,0,0,,Jika dia dibawa ke Sosnovy Bor,
Dialog: 0,0:27:40.06,0:27:43.81,teks umum,,0,0,0,,dia akan dipukuli sampai mati di sana
Dialog: 0,0:27:46.19,0:27:47.69,miring,,0,0,0,,Terakhir kali
Dialog: 0,0:27:47.78,0:27:49.90,teks umum,,0,0,0,,dia menerima seratus pukulan
Dialog: 0,0:27:50.61,0:27:52.70,teks umum,,0,0,0,,Kali ini akan lebih buruk
Dialog: 0,0:27:52.78,0:27:54.91,teks umum,,0,0,0,,Jangan biarkan ini terjadi
Dialog: 0,0:27:56.91,0:27:58.12,teks umum,,0,0,0,,Moo Dok, cukup
Dialog: 0,0:28:00.12,0:28:03.25,teks umum,,0,0,0,,Saya berbuat salah dan akan dihukum
Dialog: 0,0:28:06.88,0:28:09.05,teks umum,,0,0,0,,Saya tidak menunjukkan rasa hormat kepada Yang Mulia
Dialogue: 0,0:28:11.63,0:28:13.43,teks umum,,0,0,0,,Aku tak berani minta ampun
Dialog: 0,0:28:13.51,0:28:17.35,teks umum,,0,0,0,,Lalu biarkan mereka membawamu dan membunuhmu?
Dialog: 0,0:28:18.06,0:28:20.27,teks umum,,0,0,0,,Jika kepala menginginkannya, maka ya
Dialog: 0,0:28:23.15,0:28:23.98,teks umum,,0,0,0,,Surga...
Dialog: 0,0:28:29.94,0:28:31.40,teks umum,,0,0,0,,Kamu bisa menjemputku
Dialog: 0,0:28:33.82,0:28:35.57,teks umum,,0,0,0,,Bagaimana bisa, tuan!
Dialog: 0,0:28:35.66,0:28:37.28,teks umum,,0,0,0,,Kamu akan mati!
Dialog: 0,0:28:37.91,0:28:41.96,teks umum,,0,0,0,,Kamu akan mati jika kembali ke Sosnovy Bor!
Dialog: 0,0:28:44.58,0:28:49.05,teks umum,,0,0,0,,Saya akan menghukumnya sesuai aturan yang ditetapkan
Dialog: 0,0:28:53.26,0:28:54.93,teks umum,,0,0,0,,Hei, kamu. Tunggu
Dialog: 0,0:28:59.47,0:29:01.52,teks umum,,0,0,0,,Chan Wook akan dihukum,
Dialog: 0,0:29:01.60,0:29:03.23,teks umum,,0,0,0,,lupakan apa yang terjadi
Dialog: 0,0:29:04.27,0:29:05.81,teks umum,,0,0,0,,Ini lucu sekali
Dialog: 0,0:29:05.90,0:29:06.94,teks umum,,0,0,0,,Tapi
Dialog: 0,0:29:07.48,0:29:09.98,teks umum,,0,0,0,,cerita kuenya bahkan lebih buruk lagi
Dialog: 0,0:29:10.69,0:29:13.32,teks umum,,0,0,0,,Kepala Hutan Pinus dan Wakil Gwangju
Dialog: 0,0:29:13.40,0:29:15.03,teks umum,,0,0,0,,bertengkar soal kue?
Dialog: 0,0:29:15.99,0:29:16.99,teks umum,,0,0,0,,Hanya tertawa
Dialog: 0,0:29:17.74,0:29:19.16,teks umum,,0,0,0,,Alasan paling bodoh
Dialog: 0,0:29:20.99,0:29:21.83,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:29:24.25,0:29:26.17,teks umum,,0,0,0,,Tapi bagaimana mangkuk konstelasi itu pecah?
Dialog: 0,0:29:29.13,0:29:31.09,teks umum,,0,0,0,,Jika petir menyambar,
Dialog: 0,0:29:31.17,0:29:33.63,teks umum,,0,0,0,,berarti gerbang di atas mangkuk telah terbuka
Dialog: 0,0:29:33.72,0:29:36.93,teks umum,,0,0,0,,Tetapi hanya mereka yang sudah menguasai Chisa yang bisa melakukan ini
Dialog: 0,0:29:37.93,0:29:39.14,teks umum,,0,0,0,,Itu dia
Dialog: 0,0:29:42.27,0:29:44.69,teks umum,,0,0,0,,Chan Wook tidak memiliki Chisu
Dialog: 0,0:29:48.98,0:29:51.02,teks umum,,0,0,0,,Bagaimana cangkirnya pecah?
Dialog: 0,0:29:56.99,0:30:00.95,di luar layar,,0,0,0,,Apakah ada orang lain di sini yang memiliki Chisu?
Dialog: 0,0:30:01.70,0:30:03.37,di belakang layar,,0,0,0,,Ini tidak mungkin
Dialog: 0,0:30:19.89,0:30:23.14,teks umum,,0,0,0,,Kami keluar dari sana berkatmu, Moo Deok
Dialog: 0,0:30:23.22,0:30:25.02,teks umum,,0,0,0,,Jika kamu mencoba pergi, mereka akan menghentikanmu
Dialog: 0,0:30:25.10,0:30:27.27,teks umum,,0,0,0,,Dan jika kamu memutuskan untuk tetap tinggal, mereka akan mencoba mengusirmu
Dialogue: 0,0:30:27.35,0:30:31.15,teks umum,,0,0,0,,Jadi kamu sengaja mementaskan pertunjukan ini? Cerdas
Dialog: 0,0:30:31.23,0:30:34.15,teks umum,,0,0,0,,Saya memutuskan bahwa Anda tidak akan meyakinkan mereka,
Dialog: 0,0:30:34.23,0:30:36.45,teks umum,,0,0,0,,jadi saya turun tangan tanpa izin
Dialog: 0,0:30:36.53,0:30:38.57,teks umum,,0,0,0,,Maaf mengganggu
Dialog: 0,0:30:39.41,0:30:42.49,teks umum,,0,0,0,,Saya tidak menyangka ini, jadi saya terkejut
Dialog: 0,0:30:44.49,0:30:45.66,teks umum,,0,0,0,,Tapi kamu hebat
Dialog: 0,0:30:47.33,0:30:48.54,teks umum,,0,0,0,,Bab
Dialog: 0,0:30:48.62,0:30:50.58,teks umum,,0,0,0,,Kami tidak berbohong
Dialog: 0,0:30:50.67,0:30:54.34,teks umum,,0,0,0,,Kami melihat bagaimana kasim Kim menjadi liar dan membatu
Dialog: 0,0:30:54.42,0:30:55.71,teks umum,,0,0,0,,Saya tahu mereka tidak berbohong
Dialog: 0,0:30:56.34,0:30:58.72,miring,,0,0,0,,Terkadang aku tidak berpikir jernih,
Dialog: 0,0:30:58.80,0:31:00.68,teks umum,,0,0,0,,tapi aku bisa membedakan kebohongan dan kebenaran
Dialog: 0,0:31:01.64,0:31:03.39,miring,,0,0,0,,Dia ketakutan, tapi sadar
Dialogue: 0,0:31:03.47,0:31:07.10,teks umum,,0,0,0,,Jadi mereka punya batu es?
Dialog: 0,0:31:07.89,0:31:09.56,teks umum,,0,0,0,,Sosnovy Bor dahulu kala
Dialog: 0,0:31:10.52,0:31:13.27,teks umum,,0,0,0,,menonton Jin Mu
Dialog: 0,0:31:13.94,0:31:15.44,teks umum,,0,0,0,,Semuanya seperti yang kita harapkan
Dialog: 0,0:31:17.74,0:31:19.70,teks umum,,0,0,0,,Saya rasa mereka punya batunya
Dialogue: 0,0:31:25.70,0:31:29.58,teks umum,,0,0,0,,Apakah kamu menggunakan batu itu untuk menyadarkanku?
Dialog: 0,0:31:29.66,0:31:32.00,teks umum,,0,0,0,,Kekuatannya sungguh menakjubkan
Dialog: 0,0:31:33.00,0:31:35.42,teks umum,,0,0,0,,Saya benar-benar merasa hidup
Dialog: 0,0:31:36.76,0:31:40.13,teks umum,,0,0,0,,Chan Wook mengubahmu menjadi batu?
Dialog: 0,0:31:41.05,0:31:44.10,teks umum,,0,0,0,,Energi tiba-tiba mulai meninggalkan tubuhku,
Dialog: 0,0:31:44.76,0:31:48.68,teks umum,,0,0,0,,ketika aku hendak merasa muak dengan pembantunya
Dialog: 0,0:31:49.60,0:31:50.98,teks umum,,0,0,0,,Lalu aku kehilangan kesadaran
Dialog: 0,0:31:52.15,0:31:55.65,teks umum,,0,0,0,,Pernahkah kamu melihat bagaimana Chang Wook membuka atap di atas mangkuk konstelasi?
Dialog: 0,0:31:56.36,0:31:57.57,teks umum,,0,0,0,,Tidak, saya belum melihatnya
Dialog: 0,0:31:58.82,0:32:01.36,teks umum,,0,0,0,,Mungkin ada penyihir lain di sana selain Chan Wook?
Dialog: 0,0:32:02.32,0:32:03.57,teks umum,,0,0,0,,Tidak ada
Dialog: 0,0:32:04.74,0:32:06.91,teks umum,,0,0,0,,Bagaimana jika Chang Wook sudah merasuki Chisu?
Dialog: 0,0:32:07.66,0:32:08.95,teks umum,,0,0,0,,Mungkin dia hanya menyembunyikannya
Dialog: 0,0:32:10.66,0:32:14.29,teks umum,,0,0,0,,Saat dia menyerangku, dia tidak terlihat sangat ahli
Dialog: 0,0:32:14.38,0:32:17.50,teks umum,,0,0,0,,Dia menguasai Ryusu dalam waktu yang sangat singkat
Dialog: 0,0:32:18.34,0:32:19.67,teks umum,,0,0,0,,Jadi mungkin saja
Dialog: 0,0:32:22.63,0:32:24.68,miring,,0,0,0,,Sekarang ada batu es di dalam diriku,
Dialogue: 0,0:32:24.76,0:32:27.97,teks umum,,0,0,0,,apakah ini berarti aku pemilik Hwansu?
Dialog: 0,0:32:31.23,0:32:33.40,teks umum,,0,0,0,,Kamu benar-benar mempunyai kekuatan seperti itu
Dialog: 0,0:32:34.44,0:32:37.32,teks umum,,0,0,0,,Tapi kamu tidak tahu cara merapal mantra,
Dialog: 0,0:32:37.40,0:32:40.28,teks umum,,0,0,0,,jadi kamu tidak bisa menggunakan kekuatan ini
Dialog: 0,0:32:45.95,0:32:48.79,teks umum,,0,0,0,,Tapi batu es itu milikku sekarang
Dialog: 0,0:32:48.87,0:32:51.83,teks umum,,0,0,0,,Aku menghidupkanmu kembali untuk sementara karena kita tidak punya pilihan lain
Dialog: 0,0:33:45.76,0:33:47.76,teks umum,,0,0,0,,Jadi, batu
Dialog: 0,0:33:47.84,0:33:50.35,teks umum,,0,0,0,,dapat mencegah transformasi pengembara
Dialog: 0,0:33:51.31,0:33:52.85,teks umum,,0,0,0,,Kita harus menemukannya dan menghancurkannya
Dialog: 0,0:33:53.64,0:33:57.27,teks umum,,0,0,0,,Kita harus menghancurkan semua pengembara, dan dia menghidupkan mereka kembali
Dialog: 0,0:33:57.35,0:33:59.19,teks umum,,0,0,0,,Kekuatannya sungguh mengerikan
Dialog: 0,0:34:00.86,0:34:01.90,teks umum,,0,0,0,,Tapi ini...
Dialog: 0,0:34:03.74,0:34:07.24,miring,,0,0,0,,Uk, mereka akan segera mengetahui hukumanmu,
Dialog: 0,0:34:07.32,0:34:09.16,teks umum,,0,0,0,,jadi kamu tidak bisa kembali lagi
Dialog: 0,0:34:09.87,0:34:11.24,teks umum,,0,0,0,,Diam di rumah sebentar
Dialog: 0,0:34:11.33,0:34:15.16,teks umum,,0,0,0,,Oke, Moo Deok dan aku akan pulang
Dialog: 0,0:34:15.25,0:34:19.58,teks umum,,0,0,0,,Cobalah untuk tidak menarik perhatian Jin Mu
Dialog: 0,0:34:20.84,0:34:21.84,teks umum,,0,0,0,,Ya
Dialog: 0,0:34:23.88,0:34:25.01,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:34:33.27,0:34:35.39,teks umum,,0,0,0,,Dia akan menyingkirkan batu itu segera setelah dia menerimanya
Dialog: 0,0:34:35.48,0:34:37.39,teks umum,,0,0,0,,Kita harus menemukannya lebih awal
Dialog: 0,0:34:37.48,0:34:39.06,teks umum,,0,0,0,,Kil Ju benar
Dialog: 0,0:34:39.77,0:34:42.48,teks umum,,0,0,0,,Batu di istana
Dialog: 0,0:34:43.02,0:34:46.19,teks umum,,0,0,0,,Jadi Dan Zhu, pemilik batu itu...
Dialog: 0,0:34:47.15,0:34:48.45,teks umum,,0,0,0,,ini orangnya
Dialog: 0,0:34:52.74,0:34:55.12,teks umum,,0,0,0,,Atasi semuanya dengan tenang
Dialog: 0,0:34:55.20,0:34:57.79,teks umum,,0,0,0,,Aku akan mengirim nyonya istana Khan sebagai gantinya
Dialog: 0,0:34:57.87,0:35:00.08,teks umum,,0,0,0,,Anda akan mengirim pesan melaluinya
Dialog: 0,0:35:00.75,0:35:01.92,teks umum,,0,0,0,,Saya memahamimu
Dialog: 0,0:35:02.63,0:35:06.80,teks umum,,0,0,0,,Karena apa yang terjadi, Sosnovy Bor sekarang akan mencurigaiku
Dialog: 0,0:35:07.38,0:35:12.01,teks umum,,0,0,0,,Ini terjadi karena kamu meremehkan Chan Wook
Dialog: 0,0:35:12.60,0:35:15.43,teks umum,,0,0,0,,Aku tak mengira dia akan membebaskan dirinya secepat ini
Dialog: 0,0:35:15.52,0:35:17.77,teks umum,,0,0,0,,Dia adalah seorang jenius yang langsung menguasai Ryusu
Dialog: 0,0:35:17.85,0:35:20.02,teks umum,,0,0,0,,Dia terlahir dengan energi bintang Raja
Dialog: 0,0:35:20.10,0:35:21.73,teks umum,,0,0,0,,Saya tidak langsung meremehkannya
Dialog: 0,0:35:22.69,0:35:24.32,miring,,0,0,0,,Menurutku dia spesial,
Dialog: 0,0:35:24.40,0:35:27.19,teks umum,,0,0,0,,karena dia lahir di bawah tanda bintang seperti itu
Dialog: 0,0:35:27.28,0:35:30.53,teks umum,,0,0,0,,Namun, Chan Wook ternyata benar-benar mengecewakan
Dialog: 0,0:35:30.61,0:35:33.33,teks umum,,0,0,0,,Dia anak yang sederhana, tidak ada yang luar biasa
Dialog: 0,0:35:36.41,0:35:40.08,teks umum,,0,0,0,,Marah pada dunia, dia menyembunyikan ketidakberdayaan dan kemalasannya
Dialog: 0,0:35:40.17,0:35:44.29,teks umum,,0,0,0,,dengan kedok ketenangan. Dia tidak pernah punya tujuan
Dialog: 0,0:35:44.88,0:35:47.34,miring,,0,0,0,,Dia hanyalah seorang pemuda bangsawan dengan harga diri yang tinggi,
Dialog: 0,0:35:47.92,0:35:50.26,teks umum,,0,0,0,,jadi cukup untuk melayaninya
Dialog: 0,0:35:51.22,0:35:53.14,teks umum,,0,0,0,,Jadi sudah berubah
Dialog: 0,0:35:54.22,0:35:55.85,teks umum,,0,0,0,,Saya pikir dia lemah
Dialog: 0,0:35:55.93,0:35:58.73,teks umum,,0,0,0,,Tapi dia membuka gerbang energi dengan meminum racun
Dialog: 0,0:35:58.81,0:36:02.15,teks umum,,0,0,0,,Kupikir dia hanya seorang pembual, tapi dia benar-benar mengalahkan Putra Mahkota
Dialogue: 0,0:36:03.19,0:36:05.27,teks umum,,0,0,0,,Apa yang membuatnya begitu berubah?
Dialog: 0,0:36:05.36,0:36:07.19,teks umum,,0,0,0,,Orang berubah
Dialog: 0,0:36:08.69,0:36:10.15,teks umum,,0,0,0,,demi orang lain
Dialog: 0,0:36:11.45,0:36:14.20,teks umum,,0,0,0,,Temukan orang yang muncul dalam hidupnya sesaat sebelum semua perubahan
Dialog: 0,0:36:17.24,0:36:18.41,teks umum,,0,0,0,,Inilah jawabannya
Dialog: 0,0:36:22.29,0:36:25.84,teks umum,,0,0,0,,Chan Wook ditolak oleh dua belas guru, tapi dia masih menemukan jalannya
Dialog: 0,0:36:29.46,0:36:31.13,teks umum,,0,0,0,,Siapa yang bisa membantunya dalam hal ini?
Dialog: 0,0:36:34.89,0:36:37.47,teks umum,,0,0,0,,Guru, bisakah kita segera ke Danhyangok?
Dialog: 0,0:36:38.81,0:36:41.43,teks umum,,0,0,0,,Berkat hukumanku, kita punya waktu
Dialog: 0,0:36:42.02,0:36:43.77,teks umum,,0,0,0,,Ayo latihan di Danhyangk
Dialog: 0,0:36:43.85,0:36:46.65,teks umum,,0,0,0,,Kita bisa mencoba memanjat pohon itu
Dialogue: 0,0:36:50.78,0:36:52.74,teks umum,,0,0,0,,Di Danhyangk sekarang sangat dingin
Dialog: 0,0:36:53.66,0:36:56.12,teks umum,,0,0,0,,Jika kita terjebak disana karena salju,
Dialog: 0,0:36:57.12,0:36:58.58,teks umum,,0,0,0,,kita mungkin mati kelaparan
Dialog: 0,0:36:58.66,0:37:01.66,teks umum,,0,0,0,,Kupikir di sana hangat di musim dingin dan ada banyak makanan
Dialog: 0,0:37:01.75,0:37:04.08,teks umum,,0,0,0,,Kamu mengatakan itu pada Yulia terakhir kali
Dialog: 0,0:37:08.00,0:37:11.34,teks umum,,0,0,0,,Aku mengatakan itu untuk menenangkannya
Dialog: 0,0:37:15.84,0:37:19.22,teks umum,,0,0,0,,Dia khawatir burung peliharaannya kesulitan di musim dingin,
Dialog: 0,0:37:19.31,0:37:20.72,teks umum,,0,0,0,,jadi aku berbohong
Dialog: 0,0:37:21.56,0:37:25.94,teks umum,,0,0,0,,Apakah kamu berbicara tentang burung yang dia panggil dengan peluitnya ketika dia berada di Danhyangok?
Dialog: 0,0:37:47.79,0:37:50.96,teks umum,,0,0,0,,Jin Mu hampir membunuh Wook?
Dialog: 0,0:37:52.38,0:37:56.38,teks umum,,0,0,0,,Aku minta maaf pada Uka dan membawanya pergi dari sana
Dialog: 0,0:37:56.47,0:37:59.22,teks umum,,0,0,0,,Tapi Jin Mu mungkin mencoba menyakitinya
Dialog: 0,0:38:02.35,0:38:05.60,teks umum,,0,0,0,,Untungnya, saya bersikeras agar kita memperbaiki mangkuk konstelasi,
Dialog: 0,0:38:05.69,0:38:07.40,teks umum,,0,0,0,,jadi kita akan memiliki akses ke Jeonbugwan
Dialog: 0,0:38:09.81,0:38:13.03,teks umum,,0,0,0,,Kamu akan pergi ke Jeonbugwan bersama para pekerja Sosnovy Bor
Dialog: 0,0:38:13.74,0:38:15.36,teks umum,,0,0,0,,dan kamu akan menjaga Jin Mu
Dialog: 0,0:38:16.74,0:38:18.07,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:38:27.42,0:38:28.67,teks umum,,0,0,0,,Sang Ho
Dialog: 0,0:38:29.58,0:38:32.34,teks umum,,0,0,0,,Kudengar Moo Deok juga ada di Jeonbugwan
Dialog: 0,0:38:32.42,0:38:34.09,teks umum,,0,0,0,,Apakah dia baik-baik saja?
Dialog: 0,0:38:34.17,0:38:35.47,teks umum,,0,0,0,,Ya
Dialog: 0,0:38:38.97,0:38:42.64,teks umum,,0,0,0,,Pengembara yang menjadi liar dan berubah menjadi batu,
Dialog: 0,0:38:42.72,0:38:44.56,teks umum,,0,0,0,,benarkah hidup kembali?
Dialog: 0,0:38:44.64,0:38:48.10,teks umum,,0,0,0,,Jadi bab ini harus kembali tanpa mengatakan apa pun
Dialogue: 0,0:38:50.61,0:38:52.40,teks umum,,0,0,0,,Bagaimana reaksi Inggris terhadap hal ini?
Dialog: 0,0:38:52.98,0:38:54.86,teks umum,,0,0,0,,Sepertinya dia tidak terkejut
Dialog: 0,0:38:55.40,0:38:58.20,teks umum,,0,0,0,,Dia bertanya pada kepala apakah batu es itu
Dialogue: 0,0:38:58.28,0:39:00.91,teks umum,,0,0,0,,menghidupkan kembali jiwa-jiwa yang ditelan
Dialog: 0,0:39:00.99,0:39:03.03,teks umum,,0,0,0,,Sepertinya dia sudah mengetahuinya
Dialog: 0,0:39:05.54,0:39:08.54,teks umum,,0,0,0,,Jadi, dia secara pribadi melihat bagaimana pengembara itu hidup kembali
Dialog: 0,0:39:08.62,0:39:11.08,teks umum,,0,0,0,,Kepala mengatakan kepadanya bahwa mereka perlu dihancurkan
Dialog: 0,0:39:12.25,0:39:14.25,miring,,0,0,0,,Dan pengembara dan batu
Dialog: 0,0:39:14.34,0:39:16.51,teks umum,,0,0,0,,Singkirkan segala sesuatu yang jahat
Dialogue: 0,0:39:19.43,0:39:21.80,teks umum,,0,0,0,,Dan apa jawaban Uk soal ini?
Dialog: 0,0:39:21.89,0:39:23.81,miring,,0,0,0,,Ini hanya dugaanku,
Dialog: 0,0:39:24.76,0:39:26.31,teks umum,,0,0,0,,tapi sepertinya dia tidak setuju dengan itu
Dialog: 0,0:39:27.14,0:39:30.40,miring,,0,0,0,,Chan Wook selalu riang dan tanpa beban
Dialog: 0,0:39:30.48,0:39:34.44,teks umum,,0,0,0,,Tapi kamu tidak bisa memperlakukan ilmu hitam seperti itu
Dialog: 0,0:39:35.53,0:39:37.49,miring,,0,0,0,,Kamu dan Inggris dekat
Dialog: 0,0:39:37.57,0:39:39.57,teks umum,,0,0,0,,Kamu harus memperingatkan dia
Dialog: 0,0:39:51.75,0:39:54.25,teks umum,,0,0,0,,Tidak hanya dingin di Danhyangk,
Dialog: 0,0:39:54.34,0:39:56.67,teks umum,,0,0,0,,tidak ada seorang pun di sana sama sekali
Dialog: 0,0:39:57.55,0:39:59.88,teks umum,,0,0,0,,Kita tidak bisa sendirian sekarang
Dialogue: 0,0:40:00.72,0:40:02.22,teks umum,,0,0,0,,Kenapa tiba-tiba begini?
Dialog: 0,0:40:04.97,0:40:06.14,teks umum,,0,0,0,,aku takut,
Dialog: 0,0:40:08.77,0:40:10.31,teks umum,,0,0,0,,bahwa aku akan menyerap energimu
Dialog: 0,0:40:10.89,0:40:14.15,teks umum,,0,0,0,,Kamu belum menjadi liar. Tidak ada yang terjadi, bahkan setelah kontak kami
Dialog: 0,0:40:14.23,0:40:16.57,teks umum,,0,0,0,,Karena aku menyerap energi kasim itu
Dialog: 0,0:40:17.15,0:40:18.57,miring,,0,0,0,,Semuanya baik-baik saja sekarang,
Dialog: 0,0:40:18.65,0:40:21.11,teks umum,,0,0,0,,tapi kita tidak tahu kapan ini akan terjadi lagi
Dialog: 0,0:40:22.95,0:40:24.41,teks umum,,0,0,0,,Jika perlu,
Dialog: 0,0:40:25.20,0:40:26.95,teks umum,,0,0,0,,kamu bisa lari atau membunuhku
Dialog: 0,0:40:29.41,0:40:31.33,teks umum,,0,0,0,,Tetapi jika aku menyerap energimu,
Dialog: 0,0:40:33.54,0:40:35.04,teks umum,,0,0,0,,Aku tidak tahan dengan ini
Dialog: 0,0:40:44.09,0:40:45.30,teks umum,,0,0,0,,Apa yang lucu?
Dialog: 0,0:40:45.97,0:40:47.47,teks umum,,0,0,0,,Apakah kamu bersenang-senang?
Dialog: 0,0:40:48.26,0:40:49.60,teks umum,,0,0,0,,Tidak, bukan itu intinya
Dialog: 0,0:40:52.56,0:40:53.73,teks umum,,0,0,0,,Hatiku berdebar-debar
Dialog: 0,0:40:56.36,0:40:57.90,teks umum,,0,0,0,,Ini kata-katamu
Dialog: 0,0:40:59.19,0:41:01.57,teks umum,,0,0,0,,memiliki arti lebih dari “Aku merindukanmu”
Dialog: 0,0:41:04.61,0:41:06.99,teks umum,,0,0,0,,Prajurit Bayangan akhirnya terjawab
Dialog: 0,0:41:08.33,0:41:10.95,teks umum,,0,0,0,,untuk pernyataan cintaku yang naif dan tulus
Dialog: 0,0:41:20.17,0:41:22.05,teks umum,,0,0,0,,Saya akan menemukan batu,
Dialog: 0,0:41:22.76,0:41:26.01,teks umum,,0,0,0,,jadi kamu tidak perlu menyerap energiku
Dialog: 0,0:41:33.06,0:41:35.19,teks umum,,0,0,0,,Kamu harus melawan Park Jin
Dialog: 0,0:41:35.27,0:41:38.11,teks umum,,0,0,0,,Maka aku akan menjadi kuat
Dialog: 0,0:41:42.49,0:41:45.49,teks umum,,0,0,0,,Kamu kalah sembilan pertarungan berturut-turut dari para penyihir Jeonjingak
Dialog: 0,0:41:46.78,0:41:48.12,teks umum,,0,0,0,,Sombong
Dialog: 0,0:41:51.41,0:41:54.96,teks umum,,0,0,0,,Tepat sekali, giok yin-yang. Saya harus mengembalikannya
Dialog: 0,0:41:56.12,0:41:59.71,teks umum,,0,0,0,,Tapi bagaimana kamu memanggil Putra Mahkota?
Dialog: 0,0:42:01.59,0:42:03.80,teks umum,,0,0,0,,Ada satu cara...
Dialog: 0,0:42:04.88,0:42:06.59,teks umum,,0,0,0,,Dia membuat jantungku berdebar kencang
Dialog: 0,0:42:26.74,0:42:29.41,miring,,0,0,0,,Chan Wook, tersangka pelaku, tidak memiliki pedang
Dialog: 0,0:42:30.87,0:42:33.83,teks umum,,0,0,0,,Tapi Jin Mu memilikinya, meskipun dia bersikeras bahwa dia tidak bersalah
Dialog: 0,0:42:46.67,0:42:48.13,teks umum,,0,0,0,,Mr.
Dialog: 0,0:42:48.22,0:42:51.10,teks umum,,0,0,0,,Guru Li, apa yang membawamu ke sini?
Dialogue: 0,0:42:51.18,0:42:53.22,teks umum,,0,0,0,,Kenapa kamu bukan di Sosnovy Bor, tapi di rumah?
Dialog: 0,0:42:54.47,0:42:56.06,teks umum,,0,0,0,,Dia dihukum
Dialog: 0,0:42:58.48,0:43:00.19,teks umum,,0,0,0,,Dihukum? Untuk apa?
Dialog: 0,0:43:00.94,0:43:02.77,teks umum,,0,0,0,,Apa yang kamu lakukan kali ini?
Dialog: 0,0:43:02.86,0:43:04.23,teks umum,,0,0,0,,Tidak, bukan seperti itu
Dialog: 0,0:43:04.32,0:43:07.15,teks umum,,0,0,0,,Hamba Kim, jangan terlalu khawatir
Dialog: 0,0:43:07.24,0:43:08.57,miring,,0,0,0,,Seperti...
Dialog: 0,0:43:09.99,0:43:11.99,teks umum,,0,0,0,,bukan hukuman sebenarnya
Dialog: 0,0:43:12.08,0:43:15.20,teks umum,,0,0,0,,Ini lebih seperti liburan yang disamarkan sebagai hukuman
Dialog: 0,0:43:18.50,0:43:19.83,teks umum,,0,0,0,,Itu benar
Dialog: 0,0:43:21.33,0:43:22.38,miring,,0,0,0,,Senang mendengarnya
Dialog: 0,0:43:23.63,0:43:26.80,teks umum,,0,0,0,,Lalu kita akan memancing di Danau Gyeongcheongdaeho
Dialog: 0,0:43:28.26,0:43:29.51,miring,,0,0,0,,Ide bagus
Dialog: 0,0:43:29.59,0:43:33.93,teks umum,,0,0,0,,Kamu sebaiknya beristirahat di sini setelah menghabiskan waktu bersama Tuan Chan
Dialog: 0,0:43:35.06,0:43:38.64,teks umum,,0,0,0,,Mustahil, pembantu Kim. Aku tidak bisa bermalas-malasan sekarang
Dialog: 0,0:43:38.73,0:43:40.10,miring,,0,0,0,,Guru Li, maaf
Dialog: 0,0:43:40.19,0:43:42.73,teks umum,,0,0,0,,Saya telah kalah sembilan dari sepuluh pertempuran
Dialog: 0,0:43:42.81,0:43:44.61,teks umum,,0,0,0,,Kesempatan terakhir tersisa untuk menang
Dialog: 0,0:43:45.27,0:43:48.03,teks umum,,0,0,0,,Saya akan berlatih. Saya berharap atas pengertian Anda
Dialog: 0,0:43:49.36,0:43:52.41,teks umum,,0,0,0,,Kamu tiba-tiba jadi rajin sekali
Dialog: 0,0:43:52.49,0:43:55.66,teks umum,,0,0,0,,Ya, tujuanku adalah membuat pelayan Kim bangga padaku
Dialog: 0,0:43:55.74,0:43:57.70,teks umum,,0,0,0,,Aku tidak bisa duduk santai dan memancing
Dialog: 0,0:43:58.96,0:44:02.83,teks umum,,0,0,0,,Akhir-akhir ini kata-katamu menyentuh jiwaku
Dialog: 0,0:44:03.63,0:44:04.59,miring,,0,0,0,,Oke
Dialog: 0,0:44:04.67,0:44:06.13,teks umum,,0,0,0,,Teruskan untuk berlatih
Dialog: 0,0:44:06.21,0:44:09.05,teks umum,,0,0,0,,Dan aku akan menyiapkan manisan untukmu
Dialog: 0,0:44:17.81,0:44:20.98,teks umum,,0,0,0,,Katakan sejujurnya, kenapa kamu dihukum?
Dialogue: 0,0:44:25.02,0:44:27.28,teks umum,,0,0,0,,Aku memecahkan cawan konstelasi di Jeonbugwan
Dialogue: 0,0:44:28.36,0:44:30.19,teks umum,,0,0,0,,Jangan katakan itu pada pelayan Kim
Dialog: 0,0:44:30.28,0:44:33.24,teks umum,,0,0,0,,Saya melihat sambaran petir tepat di atas Jeonbugwan
Dialogue: 0,0:44:33.32,0:44:34.78,teks umum,,0,0,0,,Sepertinya dia menyentuh cangkirnya
Dialog: 0,0:44:35.66,0:44:39.37,teks umum,,0,0,0,,Kami tidak dapat memberi tahu Anda detailnya, tetapi pemiliknya tidak dapat disalahkan atas apa pun
Dialog: 0,0:44:40.87,0:44:43.33,teks umum,,0,0,0,,Kepala Sosnovy Bor akan memberitahumu sisanya
Dialog: 0,0:44:45.08,0:44:46.54,miring,,0,0,0,,Aku akan meminjamkan pancingku padamu
Dialog: 0,0:44:46.63,0:44:48.46,teks umum,,0,0,0,,Dulu aku suka memancing
Dialog: 0,0:44:48.55,0:44:51.13,teks umum,,0,0,0,,Saya punya beberapa yang sangat bagus
Dialogue: 0,0:44:51.22,0:44:52.09,teks umum,,0,0,0,,saya bawakan sekarang
Dialog: 0,0:44:57.43,0:44:58.64,teks umum,,0,0,0,,Maaf
Dialog: 0,0:45:00.35,0:45:04.10,teks umum,,0,0,0,,Saya ingin mengajarinya cara menangkap Ikan Mas
Dialog: 0,0:45:05.06,0:45:06.11,teks umum,,0,0,0,,Ikan Mas?
Dialogue: 0,0:45:06.69,0:45:10.19,teks umum,,0,0,0,,Maksudmu yang hanya bisa ditangkap
Dialog: 0,0:45:10.28,0:45:11.86,miring,,0,0,0,,di Danau Gyeongcheongdaeho?
Dialog: 0,0:45:12.57,0:45:13.82,teks umum,,0,0,0,,Tahukah kamu apa ini?
Dialog: 0,0:45:13.91,0:45:17.12,teks umum,,0,0,0,,Saya mendengar tentang dia. Ikan yang terbentuk dari energi danau
Dialog: 0,0:45:17.20,0:45:21.41,teks umum,,0,0,0,,Kudengar hanya penyihir yang menguasai Chisu atau lebih tinggi yang bisa menangkapnya
Dialog: 0,0:45:21.50,0:45:23.66,teks umum,,0,0,0,,Kamu benar-benar tahu banyak
Dialog: 0,0:45:24.25,0:45:26.29,teks umum,,0,0,0,,Saat kamu menangkap ikan ini dan mengendalikannya
Dialog: 0,0:45:26.38,0:45:28.00,miring,,0,0,0,,energi Danau Gyeongcheongdaeho...
Dialog: 0,0:45:29.55,0:45:30.76,teks umum,,0,0,0,,Perasaan menyenangkan
Dialog: 0,0:45:32.13,0:45:35.76,teks umum,,0,0,0,,Bagikan ini dengan pemiliknya
Dialog: 0,0:45:35.84,0:45:36.84,teks umum,,0,0,0,,Dia sibuk
Dialog: 0,0:45:37.60,0:45:39.22,miring,,0,0,0,,Master Li
Dialog: 0,0:45:39.31,0:45:41.18,teks umum,,0,0,0,,Guru Li, lihatlah
Dialog: 0,0:45:41.27,0:45:43.35,teks umum,,0,0,0,,Ini pancing terbaik, terbuat dari bambu...
Dialog: 0,0:45:43.43,0:45:45.98,teks umum,,0,0,0,,Dia tidak sibuk, mulai besok
Dialog: 0,0:45:46.06,0:45:48.94,teks umum,,0,0,0,,dia akan memancing bersamamu
Dialog: 0,0:45:50.48,0:45:52.49,teks umum,,0,0,0,,Apa yang kamu bicarakan? Saya perlu berlatih
Dialog: 0,0:45:52.57,0:45:55.86,teks umum,,0,0,0,,Sekarang kamu seharusnya tidak memegang pedang, tapi pancing
Dialog: 0,0:45:57.16,0:46:00.24,teks umum,,0,0,0,,Pergi ke Danau Gyeongcheongdaeho dan tangkap Ikan Emas
Dialog: 0,0:46:00.91,0:46:02.08,teks umum,,0,0,0,,Apa?
Dialog: 0,0:46:14.63,0:46:16.09,teks umum,,0,0,0,,Sepertinya tempat yang bagus
Dialog: 0,0:46:16.72,0:46:18.14,teks umum,,0,0,0,,Tidak, tidak, Guru Li
Dialog: 0,0:46:18.84,0:46:22.52,teks umum,,0,0,0,,Saya biasa memancing di sini. Airnya sangat dingin
Dialog: 0,0:46:22.60,0:46:25.35,miring,,0,0,0,,Tidak ada ikan di sini karena tidak ada yang bisa dimakan
Dialog: 0,0:46:25.89,0:46:28.90,teks umum,,0,0,0,,Dan kami mengambil pancing yang buruk
Dialog: 0,0:46:28.98,0:46:32.40,teks umum,,0,0,0,,Ikan mas harus ditangkap dengan joran yang mudah ditekuk
Dialog: 0,0:46:33.40,0:46:34.99,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:46:36.65,0:46:38.86,teks umum,,0,0,0,,Apakah ini umpan ikan?
Dialog: 0,0:46:39.45,0:46:40.62,teks umum,,0,0,0,,Ini manisan
Dialog: 0,0:46:40.70,0:46:44.12,teks umum,,0,0,0,,Maiden Kim mengumpulkannya untuk Tuan Lee
Dialog: 0,0:46:44.83,0:46:47.75,teks umum,,0,0,0,,Pembantu Kim adalah wanita yang sangat baik
Dialog: 0,0:46:48.33,0:46:50.25,teks umum,,0,0,0,,Di mana umpannya?
Dialog: 0,0:46:50.33,0:46:52.42,teks umum,,0,0,0,,Kita butuh cacing atau ikan kecil
Dialog: 0,0:46:52.50,0:46:53.92,teks umum,,0,0,0,,Apa?
Dialogue: 0,0:46:55.63,0:46:57.68,teks umum,,0,0,0,,Apakah kamu memancing tanpa umpan?
Dialog: 0,0:46:57.76,0:47:01.05,teks umum,,0,0,0,,Sudah kubilang Ikan Emas memakan energi
Dialog: 0,0:47:01.80,0:47:04.47,miring,,0,0,0,,Energiku akan mengalir sepanjang batang bambu
Dialog: 0,0:47:05.10,0:47:07.02,teks umum,,0,0,0,,dan akan berfungsi sebagai umpan
Dialog: 0,0:47:08.60,0:47:09.60,teks umum,,0,0,0,,Energimu?
Dialog: 0,0:47:10.69,0:47:13.77,teks umum,,0,0,0,,Master, ulangi setelah master
Dialog: 0,0:47:14.36,0:47:15.36,teks umum,,0,0,0,,Sekarang
Dialog: 0,0:47:22.32,0:47:26.37,teks umum,,0,0,0,,Sekarang kamu hanya perlu mengendalikan energi danau
Dialog: 0,0:47:26.45,0:47:28.66,teks umum,,0,0,0,,dan tunggu Ikan Emas menggigit
Dialog: 0,0:47:36.17,0:47:37.26,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:47:37.84,0:47:40.93,teks umum,,0,0,0,,Aku merasa seperti orang bodoh. Apakah saya harus melanjutkan?
Dialog: 0,0:47:48.56,0:47:49.52,teks umum,,0,0,0,,Dipatok!
Dialog: 0,0:48:00.65,0:48:02.36,teks umum,,0,0,0,,Ini Ikan Emas
Dialog: 0,0:48:03.03,0:48:06.66,teks umum,,0,0,0,,Ini adalah segumpal air yang terbentuk dari energi danau
Dialog: 0,0:48:07.33,0:48:10.58,teks umum,,0,0,0,,Hanya mereka yang menguasai Chisu atau lebih tinggi yang mampu mengendalikan air,
Dialog: 0,0:48:10.66,0:48:12.33,teks umum,,0,0,0,,bisa menangkapnya
Dialog: 0,0:48:15.04,0:48:16.46,miring,,0,0,0,,Sudah lama aku tidak memancing
Dialog: 0,0:48:16.55,0:48:19.84,teks umum,,0,0,0,,Tapi harus kuakui, menangkap Ikan Mas tetap seru
Dialog: 0,0:48:22.13,0:48:24.68,teks umum,,0,0,0,,Jadi ini bukan ikan sungguhan?
Dialog: 0,0:48:25.26,0:48:27.56,teks umum,,0,0,0,,Guru Li tidak membawamu ke sini untuk memancing
Dialog: 0,0:48:28.27,0:48:31.31,teks umum,,0,0,0,,Dia ada di sini untuk membantumu menguasai Chisu
Dialog: 0,0:48:32.23,0:48:33.56,miring,,0,0,0,,Hanya mereka yang mempunyai kekuatan,
Dialog: 0,0:48:33.65,0:48:36.52,miring,,0,0,0,,dapat menangkap segumpal energi dari Danau Gyeongcheongdaeho
Dialog: 0,0:48:37.61,0:48:39.36,teks umum,,0,0,0,,dan master Chisu
Dialog: 0,0:48:41.15,0:48:42.45,teks umum,,0,0,0,,Chisu?
Dialog: 0,0:48:50.91,0:48:53.21,teks umum,,0,0,0,,Lambat
Dialog: 0,0:48:53.29,0:48:54.17,teks umum,,0,0,0,,Lambat
Dialog: 0,0:48:54.25,0:48:57.25,teks umum,,0,0,0,,Tidak, kamu terlalu terburu-buru. Perlahan
Dialog: 0,0:48:57.96,0:48:59.46,teks umum,,0,0,0,,- Lambat\N- Tidak
Dialog: 0,0:49:12.52,0:49:14.73,teks umum,,0,0,0,,Jeonbugwan pasti menemukan gadis buta lainnya
Dialogue: 0,0:49:14.81,0:49:17.23,teks umum,,0,0,0,,Cho Young bilang mereka membawa gadis buta
Dialog: 0,0:49:17.31,0:49:19.19,teks umum,,0,0,0,,dari seluruh pelosok negeri setiap hari
Dialog: 0,0:49:21.78,0:49:23.65,teks umum,,0,0,0,,- Ayo masuk\N- Ya
Dialog: 0,0:49:36.08,0:49:38.13,miring,,0,0,0,,Jadi maksudmu,
Dialog: 0,0:49:38.21,0:49:41.09,teks umum,,0,0,0,,bahwa mungkin ada pengembara di setiap keluarga,
Dialog: 0,0:49:41.17,0:49:43.22,teks umum,,0,0,0,,yang berpartisipasi dalam pembunuhan ayah Nak Soo,
Dialog: 0,0:49:43.30,0:49:45.30,teks umum,,0,0,0,,dan kita perlu menggunakan peninggalan Jinyeowon,
Dialog: 0,0:49:46.34,0:49:47.51,teks umum,,0,0,0,,untuk menemukannya?
Dialog: 0,0:49:47.60,0:49:49.81,teks umum,,0,0,0,,Kami akan menunggu sampai pengembara,
Dialog: 0,0:49:49.89,0:49:52.31,teks umum,,0,0,0,,dari Degantongun akan sadar,
Dialog: 0,0:49:52.39,0:49:54.19,teks umum,,0,0,0,,tapi kita tidak bisa menunggu lebih lama lagi
Dialog: 0,0:49:54.27,0:49:55.69,teks umum,,0,0,0,,Faktanya adalah itu
Dialog: 0,0:49:56.60,0:49:58.77,teks umum,,0,0,0,,tadi malam kita menemukan yang lain
Dialog: 0,0:50:00.02,0:50:01.36,teks umum,,0,0,0,,Saya dengar
Dialog: 0,0:50:01.44,0:50:05.03,teks umum,,0,0,0,,Seorang pengembara yang merupakan seorang kasim ditemukan di Chonbugwan
Dialog: 0,0:50:05.11,0:50:08.41,teks umum,,0,0,0,,Jin Mu pasti sudah mengunjungimu
Dialog: 0,0:50:09.37,0:50:13.87,teks umum,,0,0,0,,Saudaraku Jin Mu berkata bahwa Sosnovy Bor mengirim pencuri ke Jeonbugwan,
Dialog: 0,0:50:14.50,0:50:17.75,teks umum,,0,0,0,,yang mencoba menjebaknya. Dia sangat kesal
Dialog: 0,0:50:17.83,0:50:20.96,teks umum,,0,0,0,,Untuk mengetahui apakah Jin Mu bersalah atau tidak,
Dialog: 0,0:50:21.67,0:50:25.67,teks umum,,0,0,0,,kita membutuhkan relik dan kekuatan kepala Jinyeowon
Dialog: 0,0:50:25.76,0:50:27.09,teks umum,,0,0,0,,Bantu kami
Dialog: 0,0:50:28.89,0:50:29.93,teks umum,,0,0,0,,Maaf,
Dialog: 0,0:50:31.43,0:50:32.81,teks umum,,0,0,0,,tapi saya menolak
Dialog: 0,0:50:34.81,0:50:38.56,teks umum,,0,0,0,,Tidak ada yang lebih memalukan bagi seorang penyihir selain tuduhan menggunakan ilmu hitam
Dialog: 0,0:50:39.40,0:50:40.86,teks umum,,0,0,0,,Jika kita
Dialog: 0,0:50:40.94,0:50:45.19,miring,,0,0,0,,menguji penyihir dengan reliknya tanpa bukti apa pun,
Dialog: 0,0:50:46.15,0:50:48.91,teks umum,,0,0,0,,kami hanya akan membuat orang membenci Jinyeowon
Dialog: 0,0:50:48.99,0:50:50.32,teks umum,,0,0,0,,Saya dengar, Jin Mu
Dialog: 0,0:50:51.20,0:50:53.91,teks umum,,0,0,0,,mencari putri sulungmu
Dialog: 0,0:50:54.83,0:50:58.17,teks umum,,0,0,0,,Dia memintamu untuk tidak membantu Sosnovy Bor
Dialog: 0,0:50:58.67,0:51:00.92,teks umum,,0,0,0,,sebagai imbalan atas bantuan menemukan putrimu?
Dialog: 0,0:51:01.50,0:51:03.38,teks umum,,0,0,0,,- Ini tidak ada hubungannya...{\i1}\N- Tidak, itu ada hubungannya
Dialog: 0,0:51:03.46,0:51:07.97,teks umum,,0,0,0,,Perilakumu terhadap Sosnovy Bor tiba-tiba berubah
Dialog: 0,0:51:08.05,0:51:11.51,teks umum,,0,0,0,,Apakah kamu ingin aku selalu melakukan apa yang kamu minta?
Dialog: 0,0:51:11.60,0:51:12.97,teks umum,,0,0,0,,Apakah ini perilaku yang Anda harapkan?
Dialog: 0,0:51:14.39,0:51:18.31,teks umum,,0,0,0,,Jinyoungwon tidak patuh
Dialog: 0,0:51:18.39,0:51:19.90,teks umum,,0,0,0,,Sosnovoy Bor
Dialog: 0,0:51:19.98,0:51:21.81,teks umum,,0,0,0,,- Bab Jin!\N- Keluar
Dialog: 0,0:51:22.40,0:51:25.48,teks umum,,0,0,0,,Saya punya janji
Dialog: 0,0:51:36.29,0:51:39.25,teks umum,,0,0,0,,Saat mereka menemukan kakak perempuanmu,
Dialog: 0,0:51:39.33,0:51:42.75,teks umum,,0,0,0,,tidak akan ada lagi penghalang bagi cinta kita
Dialog: 0,0:51:42.84,0:51:46.17,teks umum,,0,0,0,,Karena Sosnovy Bor dan Jinyovon memiliki hubungan baik
Dialog: 0,0:51:46.76,0:51:48.01,teks umum,,0,0,0,,Oh, tepatnya...
Dialog: 0,0:51:50.59,0:51:51.72,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:51:53.22,0:51:55.81,teks umum,,0,0,0,,Ini dekorasi yang kusuka terakhir kali
Dialog: 0,0:51:56.47,0:51:58.77,teks umum,,0,0,0,,Sudah ada yang berhasil membelinya
Dialog: 0,0:51:58.85,0:52:00.44,teks umum,,0,0,0,,Bagaimana cara mendapatkannya?
Dialog: 0,0:52:00.52,0:52:03.61,teks umum,,0,0,0,,Membayar orang itu empat kali lipat jumlahnya
Dialog: 0,0:52:03.69,0:52:05.40,teks umum,,0,0,0,,Kupikir kamu menyukainya
Dialog: 0,0:52:05.48,0:52:07.57,teks umum,,0,0,0,,Saya sangat menyukainya
Dialog: 0,0:52:08.49,0:52:11.24,teks umum,,0,0,0,,Senyuman bahagiamu
Dialog: 0,0:52:11.32,0:52:15.03,teks umum,,0,0,0,,membuatku menjadi orang paling bahagia di dunia
Dialogue: 0,0:52:26.13,0:52:28.05,teks umum,,0,0,0,,Kenapa pamanmu terlihat begitu kesal?
Dialogue: 0,0:52:28.13,0:52:29.47,teks umum,,0,0,0,,Apa terjadi sesuatu?
Dialog: 0,0:52:30.51,0:52:33.14,teks umum,,0,0,0,,Saya pikir dia bertengkar hebat dengan kepala Jinyeowon
Dialog: 0,0:52:52.95,0:52:55.32,teks umum,,0,0,0,,Saya menggambar tahi lalat merah tua di belakang telinganya
Dialogue: 0,0:52:56.99,0:53:01.08,teks umum,,0,0,0,,Boo Young terjatuh saat kecil. Dia memiliki bekas luka di lengan kirinya
Dialog: 0,0:53:03.58,0:53:06.04,teks umum,,0,0,0,,Panjangnya sekitar sepertiga jari
Dialog: 0,0:53:38.41,0:53:41.58,teks umum,,0,0,0,,Kamu perlu menjadi Jin Bu Young, bersabarlah
Dialogue: 0,0:53:42.66,0:53:44.50,teks umum,,0,0,0,,Setiap bekas luka, setiap tahi lalat...
Dialog: 0,0:53:44.58,0:53:47.75,teks umum,,0,0,0,,Hal kecil apa pun yang diingat ibunya
Dialog: 0,0:53:49.67,0:53:50.75,teks umum,,0,0,0,,Oke
Dialog: 0,0:53:50.84,0:53:54.38,teks umum,,0,0,0,,Aku akan menuangkan asam ke kulitmu agar bekas lukanya lebih terlihat
Dialogue: 0,0:54:38.09,0:54:41.51,teks umum,,0,0,0,,Jenis ikan apa yang coba ditangkap oleh Tuan Chan muda?
Dialog: 0,0:54:41.60,0:54:43.35,teks umum,,0,0,0,,Yang dia lakukan hanyalah pergi ke danau
Dialog: 0,0:54:43.93,0:54:46.48,teks umum,,0,0,0,,Aku perlu membawakan mereka makanan
Dialog: 0,0:54:46.56,0:54:48.56,teks umum,,0,0,0,,Saya akan meminta pelayan Li untuk membawanya
Dialog: 0,0:54:48.65,0:54:50.77,teks umum,,0,0,0,,Dan kamu tetap di sini dan bantu aku
Dialog: 0,0:54:52.61,0:54:56.53,teks umum,,0,0,0,,Kita perlu membersihkan rumah dan menyiapkan makanan untuk upacara peringatan
Dialog: 0,0:54:58.03,0:54:59.28,teks umum,,0,0,0,,Untuk siapa?
Dialog: 0,0:54:59.36,0:55:01.58,teks umum,,0,0,0,,Seorang gadis muda yang meninggal dengan kematian yang mengenaskan
Dialog: 0,0:55:02.08,0:55:04.33,teks umum,,0,0,0,,Dia tersinggung oleh keluarga kami,
Dialog: 0,0:55:04.41,0:55:06.41,teks umum,,0,0,0,,jadi aku ingin membangunkannya
Dialog: 0,0:55:07.96,0:55:09.29,miring,,0,0,0,,Maiden Kim
Dialog: 0,0:55:09.37,0:55:10.88,teks umum,,0,0,0,,Saya kembali dari kuil
Dialog: 0,0:55:10.96,0:55:12.13,teks umum,,0,0,0,,- Oke\N- Ini
Dialog: 0,0:55:12.21,0:55:14.55,teks umum,,0,0,0,,Seorang biksu menulis pidato
Dialog: 0,0:55:15.88,0:55:17.59,teks umum,,0,0,0,,Pidato yang luar biasa
Dialogue: 0,0:55:18.68,0:55:20.30,teks umum,,0,0,0,,Tapi dimana nama mereka?
Dialog: 0,0:55:20.39,0:55:22.55,teks umum,,0,0,0,,Seharusnya aku menulis nama-nama roh
Dialog: 0,0:55:22.64,0:55:23.93,miring,,0,0,0,,Ini dia
Dialog: 0,0:55:24.01,0:55:26.81,teks umum,,0,0,0,,Di sini. Cho Chun dan Cho Young
Dialog: 0,0:55:28.14,0:55:30.35,di belakang layar,,0,0,0,,Cho Young? Ini namaku
Dialog: 0,0:55:30.94,0:55:32.94,miring,,0,0,0,,Ah, itu saja. Sekarang saya mengerti
Dialog: 0,0:55:33.02,0:55:34.57,teks umum,,0,0,0,,Cho Chun dan Cho Young
Dialog: 0,0:55:35.98,0:55:37.32,miring,,0,0,0,,Pidato yang bagus
Dialog: 0,0:55:37.40,0:55:39.78,teks umum,,0,0,0,,Hamba Li, ikut aku
Dialog: 0,0:55:40.32,0:55:41.91,teks umum,,0,0,0,,Bawakan makanan kepada majikan
Dialog: 0,0:55:41.99,0:55:43.12,miring,,0,0,0,,Ya, tentu saja
Dialog: 0,0:55:44.62,0:55:46.70,di belakang layar,,0,0,0,,Maiden Kim melakukan bangun tidur
Dialog: 0,0:55:47.54,0:55:49.62,di balik layar,,0,0,0,,tentang aku dan ayahku?
Dialog: 0,0:56:28.16,0:56:30.54,teks umum,,0,0,0,,Mereka membawakan kami nasi dengan jamur. Favorit saya
Dialog: 0,0:56:30.62,0:56:33.88,teks umum,,0,0,0,,Pembantu Kim adalah juru masak yang hebat
Dialog: 0,0:56:41.09,0:56:42.51,teks umum,,0,0,0,,Pecks! Saya menangkapnya!
Dialog: 0,0:56:53.02,0:56:55.48,teks umum,,0,0,0,,Saya ketagihan cacing. Dia jatuh cinta padanya
Dialog: 0,0:56:56.65,0:56:58.23,teks umum,,0,0,0,,Kita bisa memakannya
Dialog: 0,0:57:03.78,0:57:05.16,teks umum,,0,0,0,,Yah...
Dialog: 0,0:57:23.01,0:57:24.01,teks umum,,0,0,0,,Tahan
Dialog: 0,0:57:29.93,0:57:31.64,teks umum,,0,0,0,,Luangkan waktumu
Dialog: 0,0:57:33.23,0:57:35.81,teks umum,,0,0,0,,Suatu hari kamu akan merasakan perasaan ini,
Dialog: 0,0:57:35.90,0:57:38.27,teks umum,,0,0,0,,saat ikan emas menggigit
Dialog: 0,0:57:38.36,0:57:41.94,teks umum,,0,0,0,,Ini akan menjadi Chisu - kemampuan mengendalikan energi
Dialog: 0,0:57:43.65,0:57:44.66,teks umum,,0,0,0,,Begitu
Dialog: 0,0:57:45.74,0:57:48.70,teks umum,,0,0,0,,Guru Li, engkau mengajariku membaca “Kata-Kata Hati”
Dialog: 0,0:57:49.41,0:57:51.70,teks umum,,0,0,0,,Mengapa kamu terus membantuku?
Dialog: 0,0:57:52.96,0:57:55.83,teks umum,,0,0,0,,Tidak sengaja tanpa alasan,
Dialog: 0,0:57:56.33,0:57:59.38,teks umum,,0,0,0,,mana yang harus dirahasiakan?
Dialog: 0,0:58:01.30,0:58:02.76,teks umum,,0,0,0,,Itu bukan urusanmu
Dialog: 0,0:58:02.84,0:58:04.51,teks umum,,0,0,0,,Apa menurutmu aku tidak akan mengetahuinya?
Dialog: 0,0:58:07.05,0:58:08.51,teks umum,,0,0,0,,Ini menyangkut keluargaku
Dialogue: 0,0:58:13.52,0:58:15.10,teks umum,,0,0,0,,Itu karena pelayan Kim, kan?
Dialog: 0,0:58:17.02,0:58:20.32,teks umum,,0,0,0,,Kamu selalu menghujani dia dengan pujian
Dialog: 0,0:58:20.40,0:58:22.73,teks umum,,0,0,0,,Dan kamu juga mempunyai syal di lehermu...
Dialog: 0,0:58:22.82,0:58:25.11,teks umum,,0,0,0,,Dia dari toko yang dia datangi
Dialog: 0,0:58:26.15,0:58:27.36,teks umum,,0,0,0,,Ini hadiahnya, kan?
Dialog: 0,0:58:28.41,0:58:29.62,teks umum,,0,0,0,,Dan yang terpenting,
Dialog: 0,0:58:29.70,0:58:33.41,teks umum,,0,0,0,,Saya melihat bunga liar kering di kamar pelayan Kim
Dialog: 0,0:58:33.50,0:58:35.75,teks umum,,0,0,0,,Danhyangok penuh dengan itu
Dialog: 0,0:58:35.83,0:58:37.37,teks umum,,0,0,0,,Dan ini hadiahmu, kan?
Dialog: 0,0:58:38.96,0:58:41.59,teks umum,,0,0,0,,- Ya, itu benar\N- Itu yang saya tahu
Dialogue: 0,0:58:42.92,0:58:44.97,teks umum,,0,0,0,,Tetapi kamu mengamalkan kesucian...
Dialogue: 0,0:58:45.05,0:58:48.30,teks umum,,0,0,0,,Aku tidak punya perasaan "itu" padanya!
Dialog: 0,0:58:48.89,0:58:51.51,teks umum,,0,0,0,,Menurutku dia cantik dan baik hati
Dialog: 0,0:58:51.60,0:58:53.02,teks umum,,0,0,0,,Itu saja
Dialog: 0,0:58:53.56,0:58:56.60,teks umum,,0,0,0,,Itu sama saja dengan menyatakan perasaanmu padanya
Dialog: 0,0:58:56.69,0:58:58.73,teks umum,,0,0,0,,Hubungan antara pria dan wanita selalu “seperti ini”
Dialog: 0,0:58:59.31,0:59:00.19,teks umum,,0,0,0,,Dan bagaimana dengan dirimu sendiri?
Dialog: 0,0:59:00.86,0:59:03.90,teks umum,,0,0,0,,Kamu laki-laki, dan Moo Dok perempuan. Ada apa di antara kalian?
Dialog: 0,0:59:05.90,0:59:07.49,teks umum,,0,0,0,,Bagi saya...
Dialog: 0,0:59:09.11,0:59:10.28,teks umum,,0,0,0,,Aku menyukainya
Dialogue: 0,0:59:15.75,0:59:18.71,teks umum,,0,0,0,,Aku tidak percaya aku mengatakan ini kepada seseorang yang mengamalkan kesucian
Dialog: 0,0:59:18.79,0:59:22.25,teks umum,,0,0,0,,Hanya pelayan Kim yang sudah menyukai seseorang
Dialog: 0,0:59:22.34,0:59:23.71,teks umum,,0,0,0,,Kuharap aku tidak melukai perasaanmu
Dialog: 0,0:59:23.80,0:59:25.38,teks umum,,0,0,0,,Saya juga harus mengatakannya
Dialog: 0,0:59:26.21,0:59:28.84,teks umum,,0,0,0,,Kudengar Moo Deok menyukai Yul
Dialog: 0,0:59:28.93,0:59:31.51,teks umum,,0,0,0,,Dan Gu memberitahumu ini? Percakapan macam apa yang bersifat duniawi ini?
Dialog: 0,0:59:31.60,0:59:33.51,teks umum,,0,0,0,,Aku tidak hanya main-main denganmu di sini
Dialog: 0,0:59:35.64,0:59:37.31,teks umum,,0,0,0,,Saya menyadari bahwa percakapan duniawi...
Dialog: 0,0:59:38.14,0:59:40.02,teks umum,,0,0,0,,terkadang bermanfaat
Dialog: 0,0:59:42.15,0:59:44.23,teks umum,,0,0,0,,Berkat kisah cinta pertama Julia,
Dialog: 0,0:59:44.32,0:59:47.24,teks umum,,0,0,0,,Saya bisa mengetahui tentang Nak Su, si pembunuh
Dialog: 0,0:59:50.24,0:59:53.24,teks umum,,0,0,0,,Gadis yang ditemuinya di Danhyangok,
Dialog: 0,0:59:54.33,0:59:55.70,teks umum,,0,0,0,,ternyata Nak Su
Dialog: 0,0:59:56.83,0:59:58.29,teks umum,,0,0,0,,Dia menyadari bahwa itu adalah dia...
Dialog: 0,0:59:58.37,1:00:01.08,teks umum,,0,0,0,,karena peluit yang diberikan kepadanya. Dia berbaring di samping tubuhnya
Dialog: 0,1:00:03.29,1:00:07.34,teks umum,,0,0,0,,Aku tahu kamu mendengar percakapanku dengan Jin di Sejukwon
Dialog: 0,1:00:10.09,1:00:12.72,teks umum,,0,0,0,,Jadi kalian sendiri yang tahu tentang sejarah Nak Su
Dialog: 0,1:00:16.52,1:00:18.39,teks umum,,0,0,0,,Pulanglah lebih awal hari ini
Dialog: 0,1:00:19.35,1:00:20.94,teks umum,,0,0,0,,Maiden Kim mengadakan bangun...
Dialog: 0,1:00:21.73,1:00:25.11,teks umum,,0,0,0,,tentang seorang gadis kecil yang meninggal dengan kematian yang mengenaskan
Dialog: 0,1:00:41.58,1:00:42.96,teks umum,,0,0,0,,Itu saja
Dialog: 0,1:00:43.54,1:00:44.88,teks umum,,0,0,0,,Mangkuk rasi bintang dipasang
Dialog: 0,1:00:44.96,1:00:47.92,teks umum,,0,0,0,,Bawa pelayanmu kembali ke Sosnovy Bor
Dialog: 0,1:00:48.00,1:00:51.13,teks umum,,0,0,0,,Belum, belum sempurna
Dialog: 0,1:00:51.22,1:00:52.68,teks umum,,0,0,0,,Kami menyukai semuanya
Dialog: 0,1:00:52.76,1:00:54.01,teks umum,,0,0,0,,Bagaimana menurut anda?
Dialog: 0,1:00:54.09,1:00:55.47,teks umum,,0,0,0,,Lihat saja
Dialog: 0,1:00:55.55,1:00:59.35,teks umum,,0,0,0,,Warna mangkuk dan batangnya berbeda
Dialog: 0,1:00:59.93,1:01:01.98,teks umum,,0,0,0,,Kita perlu mengganti kaki
Dialog: 0,1:01:02.06,1:01:04.10,teks umum,,0,0,0,,Kami telah mengubahnya berkali-kali
Dialog: 0,1:01:04.60,1:01:05.94,teks umum,,0,0,0,,Kami menyukai semuanya
Dialog: 0,1:01:06.02,1:01:07.44,teks umum,,0,0,0,,Kepala Sosnovy Bor berjanji,
Dialog: 0,1:01:07.52,1:01:10.40,teks umum,,0,0,0,,yang akan mengembalikan semuanya seperti semula
Dialog: 0,1:01:10.99,1:01:12.78,teks umum,,0,0,0,,Jangan membuat kesalahan
Dialog: 0,1:01:14.28,1:01:16.87,teks umum,,0,0,0,,Biasanya tidak lebih dari dua hari
Dialog: 0,1:01:17.58,1:01:19.20,teks umum,,0,0,0,,Tapi kali ini semuanya tertunda
Dialog: 0,1:01:19.29,1:01:21.66,teks umum,,0,0,0,,Kamu tidak suka kami datang ke sini?
Dialog: 0,1:01:21.75,1:01:23.67,teks umum,,0,0,0,,Mengapa ini terjadi?
Dialog: 0,1:01:23.75,1:01:28.38,teks umum,,0,0,0,,Saya hanya berpikir Sosnovy Bor membuang-buang waktu dan uang
Dialog: 0,1:01:32.22,1:01:35.43,teks umum,,0,0,0,,Jangan khawatir tentang uang Sosnovy Bor
Dialog: 0,1:01:37.68,1:01:40.39,teks umum,,0,0,0,,Yul, terakhir kali kita bertemu, aku mencatat keahlianmu
Dialogue: 0,1:01:40.47,1:01:42.14,italic,,0,0,0,,Sudah menguasai Chisu?
Dialog: 0,1:01:43.98,1:01:45.06,teks umum,,0,0,0,,Ya
Dialog: 0,1:01:46.15,1:01:48.40,teks umum,,0,0,0,,Ternyata kamu adalah penyihir pertama Jeonjingak,
Dialog: 0,1:01:48.48,1:01:50.65,teks umum,,0,0,0,,kesurupan Chisu
Dialog: 0,1:01:51.28,1:01:54.32,teks umum,,0,0,0,,Semuanya seperti ayahku. Seo Il pasti sangat bangga padamu
Dialog: 0,1:01:55.32,1:01:57.07,teks umum,,0,0,0,,Apakah dia penyihir Jeonjingak?
Dialog: 0,1:01:58.74,1:02:00.79,kenangan miring,,0,0,0,,Kamu tidak bisa menyeret seseorang melawan keinginannya
Dialog: 0,1:02:06.25,1:02:07.92,kenangan,,0,0,0,,Bisakah kamu berdiri?
Dialog: 0,1:02:10.17,1:02:11.30,miring,,0,0,0,,Apa yang kamu lihat?
Dialog: 0,1:02:14.55,1:02:16.64,teks umum,,0,0,0,,Apakah dia penyihir Jeonjingak?
Dialog: 0,1:02:16.72,1:02:19.18,teks umum,,0,0,0,,- Namanya Seo Yul?\N- Ya
Dialog: 0,1:02:19.26,1:02:21.93,teks umum,,0,0,0,,Mereka adalah putra keluarga bangsawan, buah beri bukan dari ladangmu
Dialog: 0,1:02:22.52,1:02:24.43,teks umum,,0,0,0,,Berhenti berkeliaran di sini, duduk dengan tenang
Dialog: 0,1:02:30.90,1:02:33.78,teks umum,,0,0,0,,Mungkin pencurinya Jadi Dan bukan tandingannya
Dialog: 0,1:02:37.03,1:02:39.95,teks umum,,0,0,0,,Tapi begitu aku menjadi Jin Bu Young, calon kepala Jinyoung,
Dialog: 0,1:02:41.62,1:02:43.16,teks umum,,0,0,0,,semuanya bisa berubah
Dialog: 0,1:02:51.92,1:02:54.63,teks umum,,0,0,0,,Ini untuk teman Tuan Chan dan putrinya
Dialog: 0,1:02:56.97,1:02:58.72,miring,,0,0,0,,Jenazah mereka tidak dikuburkan,
Dialog: 0,1:02:59.72,1:03:02.22,miring,,0,0,0,,dan hampir tidak ada yang mengingatnya
Dialog: 0,1:03:02.97,1:03:04.81,teks umum,,0,0,0,,Jadi saya akan mengadakan setidaknya satu layanan
Dialog: 0,1:03:06.73,1:03:07.85,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:03:10.73,1:03:11.98,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:03:13.02,1:03:14.32,teks umum,,0,0,0,,Apa?
Dialog: 0,1:03:16.44,1:03:17.90,teks umum,,0,0,0,,Mereka akan sangat berterima kasih padamu
Dialog: 0,1:03:18.99,1:03:21.41,teks umum,,0,0,0,,Saya yakin mereka sangat berterima kasih
Dialog: 0,1:03:23.12,1:03:24.79,teks umum,,0,0,0,,Senang mendengarnya
Dialog: 0,1:03:26.41,1:03:28.75,teks umum,,0,0,0,,Jangan mematikan dupa sampai habis terbakar
Dialog: 0,1:03:56.69,1:03:58.90,prasasti,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:04:15.50,1:04:19.47,keterangan,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:04:27.60,1:04:28.81,teks umum,,0,0,0,,Ayah...
Dialog: 0,1:04:41.15,1:04:43.28,teks umum,,0,0,0,,Mr. Chan pergi memancing
Dialog: 0,1:04:43.37,1:04:46.08,teks umum,,0,0,0,,Dia akan segera kembali, kamu bisa menunggu di dalam
Dialog: 0,1:04:47.58,1:04:49.41,teks umum,,0,0,0,,Moo Dok pergi bersamanya?
Dialog: 0,1:04:49.50,1:04:51.71,teks umum,,0,0,0,,Tidak, dia ada di rumah
Dialog: 0,1:04:51.79,1:04:53.33,teks umum,,0,0,0,,Membantu bangun
Dialog: 0,1:05:07.81,1:05:10.23,keterangan,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:05:12.81,1:05:14.15,di luar layar,,0,0,0,,Seandainya aku tidak meninggalkanmu...
Dialog: 0,1:05:15.48,1:05:17.07,di belakang layar,,0,0,0,,sendirian di pegunungan,
Dialog: 0,1:05:20.90,1:05:25.03,di balik layar,,0,0,0,,kamu tak perlu menahan air matamu saat ini
Dialog: 0,1:05:25.87,1:05:28.24,di luar layar,,0,0,0,,dan berpura-pura menjadi orang lain
Dialog: 0,1:05:33.58,1:05:35.17,di belakang layar,,0,0,0,,Tetapi bahkan sekarang,
Dialog: 0,1:05:37.17,1:05:39.63,di luar layar,,0,0,0,,Saya tidak bisa mendekat...
Dialog: 0,1:05:40.59,1:05:42.63, sulih suara,,0,0,0,,dan memberitahumu bahwa aku tahu siapa kamu
Dialog: 0,1:05:55.69,1:05:57.31,keterangan,,0,0,0,,Cho Chun, Cho Young
Dialog: 0,1:06:03.40,1:06:04.65,teks umum,,0,0,0,,Apakah tongkatnya terbakar?
Dialog: 0,1:06:06.28,1:06:07.32,teks umum,,0,0,0,,Ya
Dialog: 0,1:06:07.99,1:06:09.03,teks umum,,0,0,0,,Terbakar habis
Dialog: 0,1:06:09.62,1:06:10.54,teks umum,,0,0,0,,Apakah kamu sudah duduk di sini?
Dialog: 0,1:06:14.04,1:06:15.37,teks umum,,0,0,0,,Ayo bereskan semuanya
Dialog: 0,1:06:55.29,1:06:58.21,teks umum,,0,0,0,,Kapan kamu kembali? Kudengar kamu pergi memancing
Dialog: 0,1:06:58.29,1:07:00.34,teks umum,,0,0,0,,Ya, baru saja kembali
Dialog: 0,1:07:00.42,1:07:01.75,teks umum,,0,0,0,,Apakah kamu sendirian? Dimana Dan Gu?
Dialog: 0,1:07:01.84,1:07:04.59,teks umum,,0,0,0,,Dia ada urusan. Saya pikir dia berkencan dengan seseorang
Dialog: 0,1:07:04.67,1:07:05.92,teks umum,,0,0,0,,Benarkah?
Dialog: 0,1:07:07.18,1:07:08.43,teks umum,,0,0,0,,Kenapa kamu datang?
Dialog: 0,1:07:08.51,1:07:11.51,teks umum,,0,0,0,,Kepala bilang kamu bisa kembali
Dialog: 0,1:07:12.10,1:07:14.52,teks umum,,0,0,0,,Lebih cepat dari perkiraanku
Dialog: 0,1:07:15.48,1:07:18.69,teks umum,,0,0,0,,Duduk dan minum. Aku masih perlu berbicara denganmu
Dialog: 0,1:07:18.77,1:07:20.40,teks umum,,0,0,0,,Saya tidak bisa, maaf
Dialog: 0,1:07:21.15,1:07:23.69,teks umum,,0,0,0,,- Saya harus kembali ke Sosnovy Bor\N- Ya?
Dialog: 0,1:07:23.78,1:07:26.90,teks umum,,0,0,0,,Kalau begitu kita bicara lagi nanti, di Jeonjingak
Dialog: 0,1:07:27.45,1:07:29.16,teks umum,,0,0,0,,Anda akan sangat terkejut
Dialog: 0,1:07:30.82,1:07:34.41,teks umum,,0,0,0,,Uk, aku akan segera kembali ke Benteng Soho
Dialog: 0,1:07:36.16,1:07:38.04,teks umum,,0,0,0,,Aku berjanji pada ayahku bahwa aku akan tinggal di Jeonjingak
Dialog: 0,1:07:38.12,1:07:40.71,teks umum,,0,0,0,,sampai aku menguasai Chisu
Dialog: 0,1:07:41.42,1:07:43.88,teks umum,,0,0,0,,Tuan Ho menulis surat kepada ayahnya,
Dialog: 0,1:07:43.96,1:07:45.84,teks umum,,0,0,0,,segera dia akan menyuruhku kembali
Dialog: 0,1:07:46.42,1:07:47.51,teks umum,,0,0,0,,Kalau begitu aku harus pergi
Dialog: 0,1:07:47.59,1:07:49.18,teks umum,,0,0,0,,Tetapi benteng Soho sangat jauh
Dialog: 0,1:07:50.05,1:07:52.97,teks umum,,0,0,0,,Dan Gu dan aku akan sangat merindukanmu
Dialog: 0,1:07:54.64,1:07:56.31,teks umum,,0,0,0,,Saya ingin membawanya bersama saya
Dialog: 0,1:07:58.02,1:07:59.85,teks umum,,0,0,0,,seseorang
Dialog: 0,1:08:02.56,1:08:04.52,teks umum,,0,0,0,,- Siapa?\N- Saya belum bisa mengatakannya
Dialog: 0,1:08:06.65,1:08:07.90,teks umum,,0,0,0,,Aku akan memberitahumu ketika saatnya tiba
Dialog: 0,1:08:10.15,1:08:11.86,teks umum,,0,0,0,,Aku pergi. Sampai jumpa besok
Dialog: 0,1:08:12.99,1:08:14.08,teks umum,,0,0,0,,Oke. Sampai jumpa
Dialog: 0,1:08:48.36,1:08:49.78,kenangan miring,,0,0,0,,Karena aku bosan
Dialog: 0,1:08:49.86,1:08:51.95,kenangan,,0,0,0,,Aku sangat menyukai orang ini
Dialog: 0,1:08:55.74,1:08:58.75,kenangan miring,,0,0,0,,Pengembara hanya bisa pulih dengan menyedot energi orang lain
Dialog: 0,1:08:58.83,1:09:00.12,kenangan miring,,0,0,0,,Setelah melakukan ini sekali,
Dialog: 0,1:09:01.21,1:09:02.79,kenangan miring,,0,0,0,,mereka berubah menjadi monster
Dialog: 0,1:09:04.00,1:09:05.92,kenangan miring,,0,0,0,,Dan tugas kita adalah
Dialog: 0,1:09:06.88,1:09:08.21,kenangan miring,,0,0,0,,lindungi dunia dari mereka
Dialog: 0,1:09:11.26,1:09:14.43,di balik layar,,0,0,0,,Apakah Yul benar-benar tahu segalanya?
Dialog: 0,1:09:15.72,1:09:17.56, kenangan miring,,0,0,0,,Aku ingin membawanya bersamaku
Dialog: 0,1:09:18.14,1:09:20.02,kenangan,,0,0,0,,seseorang
Dialog: 0,1:09:26.56,1:09:27.90,teks umum,,0,0,0,,Host
Dialog: 0,1:09:27.98,1:09:29.11,teks umum,,0,0,0,,Apa?
Dialog: 0,1:09:32.15,1:09:35.03,teks umum,,0,0,0,,Apakah So Yul sudah pergi? Pembantu Kim memberikannya padanya
Dialog: 0,1:09:42.33,1:09:43.83,teks umum,,0,0,0,,Sepertinya dia sedang membicarakanmu
Dialog: 0,1:09:44.71,1:09:47.67,teks umum,,0,0,0,,Siapa? Apakah Seo Yul mengatakan sesuatu?
Dialog: 0,1:09:51.21,1:09:52.84,teks umum,,0,0,0,,saya bisa kembali
Dialog: 0,1:09:53.72,1:09:55.05,teks umum,,0,0,0,,Itukah sebabnya kamu begitu kesal?
Dialog: 0,1:09:55.84,1:09:57.93,teks umum,,0,0,0,,Ketika kamu kembali ke hutan,
Dialog: 0,1:09:58.47,1:10:00.93,teks umum,,0,0,0,,duelmu dengan Cha Bum akan berlangsung
Dialog: 0,1:10:01.02,1:10:02.14,teks umum,,0,0,0,,Apakah kamu takut kalah?
Dialog: 0,1:10:03.02,1:10:04.52,teks umum,,0,0,0,,Saya tidak akan kalah besok
Dialog: 0,1:10:07.27,1:10:08.48,teks umum,,0,0,0,,Akhirnya saya mengerti
Dialog: 0,1:10:27.83,1:10:30.00,teks umum,,0,0,0,,Hari ini pertarungan terakhir Chan Wook
Dialog: 0,1:10:33.17,1:10:35.43,teks umum,,0,0,0,,Kami telah sedikit mengubah ketentuan taruhan
Dialog: 0,1:10:35.51,1:10:37.26,teks umum,,0,0,0,,Pemenang pertandingan hari ini
Dialog: 0,1:10:38.09,1:10:40.39,teks umum,,0,0,0,,tidak akan menerima katak emas, tetapi sesuatu yang lain
Dialog: 0,1:10:54.82,1:10:56.36,teks umum,,0,0,0,,Pemenang
Dialog: 0,1:10:57.78,1:10:59.07,teks umum,,0,0,0,,akan memenangkan pelayan
Dialog: 0,1:11:05.41,1:11:07.08,teks umum,,0,0,0,,Saya setuju untuk menyajikannya,
Dialog: 0,1:11:09.00,1:11:11.21,teks umum,,0,0,0,,siapa yang akan menang hari ini
Dialog: 0,1:11:20.85,1:11:23.01,teks umum,,0,0,0,,- Apa yang terjadi?\N{\i1} - Luar Biasa
Dialog: 0,1:11:23.68,1:11:25.31,teks umum,,0,0,0,,lawan terakhir Chang Wook,
Dialog: 0,1:11:26.06,1:11:27.02,teks umum,,0,0,0,,maju ke depan
Dialog: 0,1:11:55.46,1:11:56.38,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:11:58.30,1:12:00.09,teks umum,,0,0,0,,Hari ini bertarung denganmu
Dialog: 0,1:12:01.30,1:12:02.60,teks umum,,0,0,0,,Saya akan ke sana
Dialog: 0,1:12:57.02,1:13:01.99,pratinjau,,0,0,0,,Inggris bisa mendatangkan kekacauan di dunia ini
Dialog: 0,1:13:02.07,1:13:04.28,pratinjau,,0,0,0,,Apa yang terjadi jika dia menarik perhatian?
Dialog: 0,1:13:04.37,1:13:06.20,pratinjau,,0,0,0,,Kita harus memilih siapa yang pasti menang
Dialog: 0,1:13:06.28,1:13:08.79,pratinjau,,0,0,0,,Aku akan menang dan membawanya bersamaku sebagai pelayan
Dialogue: 0,1:13:08.87,1:13:12.75,preview,,0,0,0,,Apakah dia sudah menguasai teknik sembilan lawan sebelumnya?
Dialog: 0,1:13:12.83,1:13:13.79,pratinjau,,0,0,0,,Aku harus menemukannya
Dialog: 0,1:13:13.88,1:13:15.00,pratinjau,,0,0,0,,Maka kamu harus kehilangan sesuatu
Dialog: 0,1:13:15.08,1:13:17.09,pratinjau,,0,0,0,,Cintamu yang terhormat tidak menyerah kepada siapa pun
Dialog: 0,1:13:17.17,1:13:20.01,pratinjau,,0,0,0,,Hanya dengan begitu aku bisa menatap matanya tanpa rasa malu
Dialog: 0,1:13:20.09,1:13:23.84,pratinjau,,0,0,0,,Bertanya tentang Moo Deok. Gadis macam apa dia
Dialog: 0,1:13:23.93,1:13:26.10,pratinjau,,0,0,0,,"Tampilan penuh kelembutan", sama bagiku
Dialog: 0,1:13:26.18,1:13:27.35,pratinjau,,0,0,0,,Kamu tidak menganggapku seorang wanita
Dialog: 0,1:13:27.43,1:13:29.93,pratinjau,,0,0,0,,- Jangan menyesal nanti\N- Oke, silakan!
Dialog: 0,1:13:31.14,1:13:34.81,pratinjau,,0,0,0,,Aku sangat menyukaimu, tuan
Dialog: 0,0:02:57.14,0:02:59.14, torehan,,0,0,0,,

