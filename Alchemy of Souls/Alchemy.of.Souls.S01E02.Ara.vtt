Dialogue: 0,0:00:44.82,0:00:47.90,نقوش,,0,0,0,,قبل 20 عامًا
Dialogue: 0,0:01:04.38,0:01:05.92,ذكريات بخط مائل,,0,0,0,,سيدتي...
Dialogue: 0,0:01:09.84,0:01:11.97,ذكريات,,0,0,0,,يجب أن أجعل دو هوا ملكي
Dialogue: 0,0:01:12.05,0:01:14.68,ذكريات,,0,0,0,,إذا حملت فالطفل لي
Dialogue: 0,0:01:23.40,0:01:24.73,ذكريات,,0,0,0,,سيد...
Dialogue: 0,0:01:24.81,0:01:26.40,ذكريات,,0,0,0,,إلى أين أنت ذاهب يا سيدي؟
Dialogue: 0,0:01:37.08,0:01:38.79,ذكريات,,0,0,0,,سمعت عن دو هوا
Dialogue: 0,0:01:39.37,0:01:41.00,ذكريات,,0,0,0,,كنا متجهين إلى هناك للتو
Dialogue: 0,0:01:41.08,0:01:45.00,ذكريات,,0,0,0,,لماذا أنت هنا وليس في الجنازة؟
Dialogue: 0,0:01:45.71,0:01:48.75,ذكريات,,0,0,0,,أنا هنا لأن هذه هي الطريقة الوحيدة لتغيير مصيره
Dialogue: 0,0:02:08.32,0:02:09.32,ذكريات,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:02:35.43,0:02:37.34,ذكريات,,0,0,0,,ماذا فعلت؟
Dialogue: 0,0:02:37.43,0:02:39.47,ذكريات,,0,0,0,,أغلقت بوابة الطاقة الخاصة به
Dialogue: 0,0:02:40.31,0:02:42.77,ذكريات,,0,0,0,,لن يتمكن من إلقاء التعويذات
Dialogue: 0,0:02:45.94,0:02:49.36,ذكريات,,0,0,0,,أمنع أحداً من فتح هذه البوابة
Dialogue: 0,0:02:50.11,0:02:54.11,ذكريات,,0,0,0,,كيف تفعل هذا بابنك؟
Dialogue: 0,0:02:56.03,0:02:57.24,ذكريات,,0,0,0,,مع ابنك؟
Dialogue: 0,0:03:06.54,0:03:08.71,ذكريات,,0,0,0,,لماذا يتحكم في مصيري؟
Dialogue: 0,0:03:10.00,0:03:12.21,ذكريات,,0,0,0,,رغم ذلك لا أحد يعتبره والدي الحقيقي
Dialogue: 0,0:03:13.01,0:03:14.17,ذكريات,,0,0,0,,سأجد شخصًا ما
Dialogue: 0,0:03:14.80,0:03:16.63,ذكريات,,0,0,0,,المعلم الذي سيكشف عن قوتي
Dialogue: 0,0:03:16.72,0:03:18.72,ذكريات,,0,0,0,,وتعلم السحر
Dialogue: 0,0:03:19.68,0:03:21.51,ذكريات,,0,0,0,,سأجده بنفسي
Dialogue: 0,0:03:22.76,0:03:25.23,ذكريات,,0,0,0,,ثم سأخرج هذا السيف وأقسمه إلى قسمين.
Dialogue: 0,0:03:30.40,0:03:34.23,خلف الكواليس,,0,0,0,,غيرت 12 معلماً، طردوني من كل مكان
Dialogue: 0,0:03:36.03,0:03:39.45,خلف الكواليس,,0,0,0,,وأخيرًا وجدت الشخص الذي سيغير مصيري
Dialogue: 0,0:03:51.08,0:03:52.92,نص عام,,0,0,0,,فهمت كل شيء في لقائنا الأول
Dialogue: 0,0:03:54.67,0:03:56.05,نص عام,,0,0,0,,أنت أستاذي
Dialogue: 0,0:04:06.93,0:04:10.48,النص العام,,0,0,0,,هل تعتقد أن هناك شيئًا مميزًا بي،
Dialogue: 0,0:04:10.56,0:04:11.61,نص عام,,0,0,0,,سيد؟
Dialogue: 0,0:04:14.57,0:04:16.44,نص عام,,0,0,0,,قلت لك العيون جميلة
Dialogue: 0,0:04:16.53,0:04:18.86,نص عام,,0,0,0,,أوه، آسف. عيون فقط
Dialogue: 0,0:04:20.53,0:04:23.03,نص عام,,0,0,0,,العلامة الزرقاء للبدوي مطبوعة عليهم
Dialogue: 0,0:04:24.79,0:04:26.70,خلف الكواليس,,0,0,0,,العلامة في عيني
Dialogue: 0,0:04:31.08,0:04:32.38,نص عام,,0,0,0,,هل ستقاتلني؟
Dialogue: 0,0:04:32.46,0:04:34.17,نص عام,,0,0,0,,لن يكون من الصعب قتلك
Dialogue: 0,0:04:34.75,0:04:36.05,نص عام,,0,0,0,,لكن هذا سوسنوفي بور
Dialogue: 0,0:04:36.80,0:04:38.22,نص عام,,0,0,0,,سوف يتم القبض عليك
Dialogue: 0,0:04:50.73,0:04:52.81,نص عام,,0,0,0,,أحاول إنقاذك
Dialogue: 0,0:04:52.90,0:04:55.94,نص عام,,0,0,0,,إذا بقيت معي فلن يتم القبض عليك
Dialogue: 0,0:05:09.91,0:05:12.12,النص العام,,0,0,0,,كيف يمكنك الاتصال بي إذا كنت تريد الاختفاء؟
Dialogue: 0,0:05:14.63,0:05:15.92,نص عام,,0,0,0,"سيدتي"
Dialogue: 0,0:05:29.10,0:05:30.10,نص عام,,0,0,0,,تشان ووك؟
Dialogue: 0,0:05:30.77,0:05:31.98,نص عام,,0,0,0,,نعم هذا أنا
Dialogue: 0,0:05:32.48,0:05:33.94,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:05:37.69,0:05:38.73,نص عام,,0,0,0,,ومن هذا؟
Dialogue: 0,0:05:40.11,0:05:40.94,نص عام,,0,0,0,,آه بالضبط
Dialogue: 0,0:05:42.24,0:05:44.20,النص العام,,0,0,0,,هذه مو دوك، خادمتي
Dialogue: 0,0:05:46.83,0:05:48.04,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:05:50.70,0:05:54.96,النص العام,,0,0,0,,يول، لقد أخافتها. اخماد سيفك
Dialogue: 0,0:05:59.80,0:06:01.72,النص العام,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,0:06:04.59,0:06:05.64,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:06:08.10,0:06:10.02,نص عام,,0,0,0,,حسنًا يا معلم
Dialogue: 0,0:06:12.48,0:06:13.56,نص عام,,0,0,0,,المملكة المتحدة؟
Dialogue: 0,0:06:14.35,0:06:15.27,نص عام,,0,0,0,,نعم
Dialogue: 0,0:06:16.61,0:06:19.19,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:06:19.27,0:06:22.82,نص عام,,0,0,0,,جئت إلى الفصل. سمع قتالاً واختبأ هنا
Dialogue: 0,0:06:23.53,0:06:26.32,general text,,0,0,0,,كان هناك مرتزقة، لكن لا يمكنك القتال
Dialogue: 0,0:06:26.41,0:06:29.28,نص عام,,0,0,0,,من حسن حظك أنه لم يتم القبض عليك
Dialogue: 0,0:06:29.37,0:06:30.83,نص عام,,0,0,0,,مستحيل...
Dialogue: 0,0:06:30.91,0:06:33.25,نص عام,,0,0,0,,أحسنت في الاختباء
Dialogue: 0,0:06:33.33,0:06:36.54,general text,,0,0,0,,ركضت خادمتي وتبعتها أنت...
Dialogue: 0,0:06:36.63,0:06:37.88,نص عام,,0,0,0,,إنه مؤلم...
Dialogue: 0,0:06:38.63,0:06:40.34,نص عام,,0,0,0,,من هذا؟
Dialogue: 0,0:06:45.38,0:06:46.72,نص عام,,0,0,0,,وأي نوع من السكين؟
Dialogue: 0,0:06:53.43,0:06:54.27,نص عام,,0,0,0,,أنت...
Dialogue: 0,0:06:57.48,0:06:59.40,general text,,0,0,0,,حاولت حمايته معهم؟
Dialogue: 0,0:07:00.36,0:07:02.15,نص عام,,0,0,0,,فخور بك
Dialogue: 0,0:07:02.23,0:07:05.53,نص عام,,0,0,0,,صحيح. مالك لا يزال ضعيفا،
Dialogue: 0,0:07:05.61,0:07:07.53,نص عام,,0,0,0,,يجب حمايته
Dialogue: 0,0:07:09.70,0:07:10.87,نص عام,,0,0,0,,نعم
Dialogue: 0,0:07:10.95,0:07:13.16,نص عام,,0,0,0,,سأحمي سيدي
Dialogue: 0,0:07:14.20,0:07:16.50,نص عام,,0,0,0,,لا. لا شكرا
Dialogue: 0,0:07:17.75,0:07:20.54,نص عام,,0,0,0,,يجب أن أحميك
Dialogue: 0,0:07:22.00,0:07:23.34,نص عام,,0,0,0,,يا لها من قبضة...
Dialogue: 0,0:07:24.09,0:07:25.17,نص عام,,0,0,0,,دعنا نذهب
Dialogue: 0,0:07:33.22,0:07:36.77,نص عام,,0,0,0,,يا مو دوك، لا تبدو هكذا!
Dialogue: 0,0:07:37.48,0:07:38.69,نص عام,,0,0,0,,انظر للأسفل
Dialogue: 0,0:07:41.19,0:07:43.57,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:07:44.86,0:07:47.11,النص العام,,0,0,0,,إذاً أنت الذي تهرب مني
Dialogue: 0,0:07:47.20,0:07:48.53,نص عام,,0,0,0,,مو دوك ، أليس كذلك؟
Dialogue: 0,0:07:49.49,0:07:50.99,نص عام,,0,0,0,,آسف على التخويف
Dialogue: 0,0:08:03.30,0:08:04.88,نص عام,,0,0,0,,ألم تتأذى؟
Dialogue: 0,0:08:17.73,0:08:18.77,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:08:19.64,0:08:22.15,نص عام,,0,0,0,,أنا بخير يا معلمة
Dialogue: 0,0:08:25.15,0:08:27.24,النص العام,,0,0,0,,- هل هدأت الأمور؟\N- لا
Dialogue: 0,0:08:27.32,0:08:28.49,نص عام,,0,0,0,,الجميع ما زال في حالة ذعر
Dialogue: 0,0:08:29.07,0:08:31.03,نص عام,,0,0,0,,اختفى جسد البدو ناك سو
Dialogue: 0,0:08:32.37,0:08:34.99,خلف الكواليس,,0,0,0,,كما اعتقدت، شعب دان تشو
Dialogue: 0,0:08:35.08,0:08:37.70,خلف الكواليس,,0,0,0,,الآن كل ما علي فعله هو الخروج من هنا حياً
Dialogue: 0,0:08:38.41,0:08:40.17,نص عام,,0,0,0,,يا للأسف
Dialogue: 0,0:08:40.92,0:08:42.17,نص عام,,0,0,0,,بدوي
Dialogue: 0,0:08:42.25,0:08:44.29,نص عام,,0,0,0,,المرتزق ناك سو
Dialogue: 0,0:08:45.55,0:08:49.09,نص عام,,0,0,0,,لطالما تساءلت كيف تبدو
Dialogue: 0,0:08:51.22,0:08:53.51,التعليق الصوتي,,0,0,0,,إنه يعرف من أنا
Dialogue: 0,0:08:53.60,0:08:55.85,خارج الشاشة,,0,0,0,,يجب أن نقتله قبل الرحيل
Dialogue: 0,0:09:00.48,0:09:03.56,general text,,0,0,0,,من الواضح أنهم كسروا الحاجز وهربوا.
Dialogue: 0,0:09:16.87,0:09:18.66,نص عام,,0,0,0,,فإنكسر الحاجز
Dialogue: 0,0:09:18.75,0:09:21.08,النص العام,,0,0,0,,- نحن خلفهم\N- لقد فات الأوان
Dialogue: 0,0:09:22.62,0:09:25.13,general text,,0,0,0,,لا يمكن كسر الحاجز إلا باستخدام البورون
Dialogue: 0,0:09:26.25,0:09:28.00,general text,,0,0,0,,بيننا خائن
Dialogue: 0,0:09:29.71,0:09:31.93,نص عام,,0,0,0,,يجب أن نطلب المساعدة من عائلة جين
Dialogue: 0,0:09:38.60,0:09:41.69,نص عام,,0,0,0,,جثة ناك سو كانت في الغرفة السرية
Dialogue: 0,0:09:42.77,0:09:46.19,general text,,0,0,0,,المملكة المتحدة، ألم ترى أي شيء غريب أثناء اختبائك؟
Dialogue: 0,0:09:46.27,0:09:47.82,نص عام,,0,0,0,,غريب؟
Dialogue: 0,0:09:47.90,0:09:50.65,نص عام,,0,0,0,,لا. كنت أشاهد مو دوك للتو
Dialogue: 0,0:09:55.12,0:09:58.66,general text,,0,0,0,,هل تعتقد أن روح ناك سو انتقلت إلى جسد فتاة أخرى؟
Dialogue: 0,0:09:58.74,0:10:00.16,النص العام,,0,0,0,,ولهذا جاءت من أجل جسدها؟
Dialogue: 0,0:10:04.04,0:10:06.46,النص العام,,0,0,0,,هل يمكن للفتيات أن يتحولن إلى فتيات فقط؟
Dialogue: 0,0:10:06.54,0:10:07.67,خط مائل,,0,0,0,,ليس حقًا
Dialogue: 0,0:10:07.75,0:10:11.34,general text,,0,0,0,,لكن لكي يسير كل شيء بسلاسة، يختارون أشخاصًا مثلهم
Dialogue: 0,0:10:11.42,0:10:14.22,نص عام,,0,0,0,,الجنس والعمر واللياقة البدنية. كل شيء يجب أن يكون هو نفسه
Dialogue: 0,0:10:16.14,0:10:17.72,نص عام,,0,0,0,,أنا أسأل لأنني لم أرها
Dialogue: 0,0:10:17.80,0:10:21.85,النص العام,,0,0,0,,هل كان ناك سو نحيفًا وقصيرًا؟
Dialogue: 0,0:10:21.93,0:10:24.60,النص العام,,0,0,0,,بوجه مستدير مثل مو ديوك؟
Dialogue: 0,0:10:24.69,0:10:26.52,خلف الكواليس,,0,0,0,,ما خطبه؟
Dialogue: 0,0:10:29.11,0:10:32.65,general text,,0,0,0,,في هذه الحالة لن يكون اسمها "ناك سو"
Dialogue: 0,0:10:32.74,0:10:33.61,خط مائل,,0,0,0,,انظر إليها
Dialogue: 0,0:10:34.40,0:10:37.16,النص العام,,0,0,0,,أي مرتزقة سيبدو لطيفًا جدًا؟
Dialogue: 0,0:10:38.03,0:10:39.03,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:10:39.12,0:10:41.37,نص عام,,0,0,0,,أعتقد أنها وحش
Dialogue: 0,0:10:41.45,0:10:43.62,نص عام,,0,0,0,,لا. إنها إنسان
Dialogue: 0,0:10:45.50,0:10:48.54,general text,,0,0,0,,دعونا لا نتكلم بالسوء عن المتوفاة رغم أنها كانت قاتلة
Dialogue: 0,0:10:54.47,0:10:56.51,النص العام,,0,0,0,,السيد هو يوم يريد رؤيتك
Dialogue: 0,0:10:56.59,0:10:58.55,نص عام,,0,0,0,,اذهب بدوني. لا يزال لا يحبني
Dialogue: 0,0:10:58.64,0:11:00.35,نص عام,,0,0,0,,بالضبط. ابق هنا، إنه أكثر أمانًا
Dialogue: 0,0:11:00.43,0:11:01.60,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:11:13.07,0:11:14.82,نص عام,,0,0,0,,الجثة كانت مجمدة هنا
Dialogue: 0,0:11:14.90,0:11:18.70,general text,,0,0,0,,ليس هناك رائحة تعفن، مما يعني أن جسمك بخير
Dialogue: 0,0:11:20.66,0:11:21.70,نص عام,,0,0,0,,ناك سو
Dialogue: 0,0:11:23.33,0:11:24.50,نص عام,,0,0,0,,نعم
Dialogue: 0,0:11:25.33,0:11:27.67,نص عام,,0,0,0,,أنا قاتل
Dialogue: 0,0:11:30.38,0:11:31.67,نص عام,,0,0,0,,ناك سو
Dialogue: 0,0:11:36.38,0:11:38.59,general text,,0,0,0,,لقد حاولت لفترة طويلة أن أفهم سبب مساعدتك لي
Dialogue: 0,0:11:40.85,0:11:42.68,النص العام,,0,0,0,,أرسلك دان تشو أيضًا؟
Dialogue: 0,0:11:42.76,0:11:45.18,نص عام,,0,0,0,,لا لم يرسلني أحد
Dialogue: 0,0:11:45.27,0:11:47.19,general text,,0,0,0,,إذاً لماذا ساعدتني؟
Dialogue: 0,0:11:47.27,0:11:50.65,نص عام,,0,0,0,,لقد أخبرتك ولكن يبدو أنك لم تفهمها
Dialogue: 0,0:11:53.40,0:11:54.73,ذكريات,,0,0,0,,لديك عيون جميلة
Dialogue: 0,0:11:55.49,0:11:56.74,نص عام,,0,0,0,,لا تتكلم,
Dialogue: 0,0:11:58.03,0:11:59.28,نص عام,,0,0,0,,لقد وقعت في الحب
Dialogue: 0,0:12:01.57,0:12:02.62,نص عام,,0,0,0,,لا تضحك
Dialogue: 0,0:12:03.20,0:12:05.37,نص عام,,0,0,0,,مازلت لا أرى أي أسباب أخرى
Dialogue: 0,0:12:05.45,0:12:07.37,نص عام,,0,0,0,,أعترف أنني دعوتك بالجميلة أكثر من مرة
Dialogue: 0,0:12:08.37,0:12:10.21,النص العام,,0,0,0,,ولكن فقط لأنني سعيت لتحقيق أهدافي
Dialogue: 0,0:12:10.83,0:12:12.00,نص عام,,0,0,0,,وأي منها؟
Dialogue: 0,0:12:12.67,0:12:16.97,general text,,0,0,0,,كنت أبحث عن معلم يفك التعويذة ويعلمني السحر
Dialogue: 0,0:12:17.76,0:12:19.22,نص عام,,0,0,0,,ووجدتك،
Dialogue: 0,0:12:21.22,0:12:22.30,نص عام,,0,0,0,,ناك سو
Dialogue: 0,0:12:23.10,0:12:25.06,نص عام,,0,0,0,,كن سيدي
Dialogue: 0,0:12:40.99,0:12:42.12,نص عام,,0,0,0,,سمعت,
Dialogue: 0,0:12:42.20,0:12:44.24,النص العام,,0,0,0,,لقد استعرت روح السابساري* من عائلة جين
Dialogue: 0,0:12:42.20,0:12:44.24,ملاحظات,,0,0,0,,*كلب أشعث من السلالة الكورية الجنوبية، يُعتقد أن هذه الكلاب قادرة على طرد الأرواح الشريرة.
Dialogue: 0,0:12:44.33,0:12:45.29,نص عام,,0,0,0,,نعم
Dialogue: 0,0:12:45.87,0:12:49.33,general text,,0,0,0,,هل أنت متأكد من أنها في سوسنوفي بور؟
Dialogue: 0,0:12:49.41,0:12:50.50,نص عام,,0,0,0,,نعم
Dialogue: 0,0:12:51.54,0:12:55.25,نص عام,,0,0,0,,البدوي يختبئ في مكان ما هنا
Dialogue: 0,0:12:59.72,0:13:01.72,النص العام,,0,0,0,,ابن تشانغ غان من سوسنوفي بور
Dialogue: 0,0:13:01.80,0:13:04.26,general text,,0,0,0,,يطلب من القاتل أن يصبح مرشداً؟
Dialogue: 0,0:13:05.93,0:13:07.68,نص عام,,0,0,0,,ما هذا الهراء
Dialogue: 0,0:13:09.35,0:13:12.81,general text,,0,0,0,,سوف تفتح أبواب طاقة تلميذك وتساعده على إتقان التعويذات
Dialogue: 0,0:13:13.40,0:13:16.23,النص العام,,0,0,0,,بصفتي تلميذك، سأساعدك على الإخفاء
Dialogue: 0,0:13:16.32,0:13:19.65,general text,,0,0,0,,ستكون بيننا علاقة رائعة ستفيد كلا منا
Dialogue: 0,0:13:19.74,0:13:21.61,النص العام,,0,0,0,,- غير مهتم\N- أنت لا تريد أن تكون سيدي،
Dialogue: 0,0:13:21.70,0:13:23.41,نص عام,,0,0,0,,يمكنك أن تكوني زوجة
Dialogue: 0,0:13:23.49,0:13:24.78,النص العام,,0,0,0,,- هل توافقين على ذلك؟\N- اصمتي
Dialogue: 0,0:13:25.45,0:13:28.41,general text,,0,0,0,,سمعت أنك ذهبت إلى مجموعة من المعلمين ورفضك الجميع
Dialogue: 0,0:13:28.49,0:13:30.46,general text,,0,0,0,,هل بسبب شخصية رديئة؟
Dialogue: 0,0:13:34.42,0:13:37.75,general text,,0,0,0,,لم أتمكن من تهديد الأساتذة السابقين، فلم تكن لديهم نقاط ضعف
Dialogue: 0,0:13:38.38,0:13:42.09,نص عام,,0,0,0,,لكن لديك
Dialogue: 0,0:13:45.30,0:13:47.64,النص العام,,0,0,0,,لن تتمكن من مغادرة هذا المكان دون مساعدتي
Dialogue: 0,0:13:48.39,0:13:50.31,general text,,0,0,0,,سوف تموت إذا كشفوا عنك
Dialogue: 0,0:13:51.23,0:13:52.35,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:13:53.19,0:13:54.65,نص عام,,0,0,0,,في هذه الحالة،
Dialogue: 0,0:13:58.07,0:13:59.40,نص عام,,0,0,0,,سأقتلك للتو
Dialogue: 0,0:14:01.86,0:14:04.78,نص عام,,0,0,0,,كم هي قاسية. ومع ذلك، لقد ساعدتك
Dialogue: 0,0:14:04.86,0:14:07.83,النص العام,,0,0,0,,آسف لكوني قاسياً رغم وجهك اللطيف
Dialogue: 0,0:14:17.04,0:14:19.34,النص العام,,0,0,0,,لقد أحضرتك إلى منزلي بمساعدة مجوهرات اليشم،
Dialogue: 0,0:14:20.00,0:14:22.05,نص عام,,0,0,0,,وهنا الأمر أبسط
Dialogue: 0,0:14:22.84,0:14:24.93,نص عام,,0,0,0,,وانظر أين نحن
Dialogue: 0,0:14:32.73,0:14:34.31,نص عام,,0,0,0,,هذه هي غرفة سوسنوفي بور السرية
Dialogue: 0,0:14:35.27,0:14:38.73,general text,,0,0,0,,عندما تُغلق الأبواب، لا يمكن فتحها إلا من الخارج
Dialogue: 0,0:14:39.98,0:14:41.57,نص عام,,0,0,0,,نحن محبوسون هنا معًا
Dialogue: 0,0:14:43.82,0:14:44.99,نص عام,,0,0,0,,لا تتحرك!
Dialogue: 0,0:14:45.49,0:14:48.07,general text,,0,0,0,,ادوس على البلاطة الخاطئة وسوف تسقط الأرضية
Dialogue: 0,0:14:51.37,0:14:55.50,general text,,0,0,0,,اقتلني وسوف يقتلك السحرة الذين يأتون إلى هنا
Dialogue: 0,0:14:55.58,0:14:58.96,النص العام,,0,0,0,,ولكن إذا وافقتم، سنترك سالمين
Dialogue: 0,0:15:02.38,0:15:05.47,خارج الشاشة,,0,0,0,,ليس لدي القوة لتدمير هذه البوابات الآن
Dialogue: 0,0:15:05.97,0:15:07.84,خارج الإطار,,0,0,0,,سوف يفهم كل شيء إذا بقيت هنا
Dialogue: 0,0:15:08.43,0:15:09.47,نص عام,,0,0,0,,أحتاج سيفي
Dialogue: 0,0:15:10.85,0:15:12.81,general text,,0,0,0,,ضعفت بسبب هجرتي إلى جسد آخر
Dialogue: 0,0:15:12.89,0:15:15.73,general text,,0,0,0,,أحتاج إلى سيفي بالطاقة لفتح قوتك.
الحوار: 0,0:15:16.27,0:15:17.44,نص عام,,0,0,0,,بدونها
Dialogue: 0,0:15:18.06,0:15:20.73,نص عام,,0,0,0,,لا أستطيع فعل أي شيء
Dialogue: 0,0:15:21.86,0:15:23.32,نص عام,,0,0,0,,والحصول على السيف،
Dialogue: 0,0:15:24.69,0:15:25.90,نص عام,,0,0,0,,أريد الخروج
Dialogue: 0,0:15:25.99,0:15:27.11,نص عام,,0,0,0,,توقف
Dialogue: 0,0:15:29.37,0:15:30.66,نص عام,,0,0,0,,ألا تسمع؟
Dialogue: 0,0:15:30.74,0:15:33.83,نص عام,,0,0,0,,لا أستطيع. علينا أن ننتظر حتى يغلقوا تماما
Dialogue: 0,0:15:35.50,0:15:37.67,نص عام,,0,0,0,,أنت! لقد كذبت علي!
Dialogue: 0,0:15:40.79,0:15:42.00,نص عام,,0,0,0,,لا تتحرك!
Dialogue: 0,0:15:42.09,0:15:44.26,general text,,0,0,0,,- وإلا فإن الكلمة ستفشل!\N- انتظر...
Dialogue: 0,0:15:47.34,0:15:48.97,نص عام,,0,0,0,,انتظر جيدًا. سوف تسقط
Dialogue: 0,0:15:49.84,0:15:52.47,النص العام,,0,0,0,,- إلى أين تشير بأنفك؟\N- اصمت!
Dialogue: 0,0:15:52.56,0:15:54.27,نص عام,,0,0,0,,- مهلا!\N- أنت!
Dialogue: 0,0:15:54.35,0:15:55.31,نص عام,,0,0,0,,جاد...
Dialogue: 0,0:15:56.06,0:15:58.73,النص العام,,0,0,0,,- هذا مؤلم!\N- لم أفعل ذلك عمداً
Dialogue: 0,0:15:58.81,0:16:00.94,نص عام,,0,0,0,,- هذا مؤلم\N- انتظر
Dialogue: 0,0:16:01.52,0:16:02.40,نص عام,,0,0,0,,دعنا نذهب
Dialogue: 0,0:16:08.20,0:16:10.45,النص العام,,0,0,0,,كيف سنجد سيفك؟
Dialogue: 0,0:16:11.32,0:16:13.33,نص عام,,0,0,0,,أعرف من أخذها. سأجده
Dialogue: 0,0:16:14.62,0:16:16.54,النص العام,,0,0,0,,من الخطر مغادرة سوسنوفي بور
Dialogue: 0,0:16:16.62,0:16:18.25,نص عام,,0,0,0,,يجب أن نبقى هنا
Dialogue: 0,0:16:19.54,0:16:21.46,general text,,0,0,0,,هل تحتاج هذا السيف حقًا؟
Dialogue: 0,0:16:21.54,0:16:23.34,نص عام,,0,0,0,,خذ سيف طاقة آخر وأنهِ المهمة
Dialogue: 0,0:16:23.42,0:16:25.55,نص عام,,0,0,0,,لا أستطيع. يجب أن يكون السيف لي
Dialogue: 0,0:16:26.80,0:16:28.30,نص عام,,0,0,0,,دعونا نخرج ونجده
Dialogue: 0,0:16:29.26,0:16:32.39,التعليق الصوتي,,0,0,0,,سأغريه ثم أقتله
Dialogue: 0,0:16:33.72,0:16:35.47,نص عام,,0,0,0,,قلت أنك ضعيف
Dialogue: 0,0:16:38.48,0:16:40.73,نص عام,,0,0,0,,وأعتقدت أنك تتظاهر
Dialogue: 0,0:16:42.11,0:16:43.27,النص العام,,0,0,0,,ما مدى ضعفك؟
Dialogue: 0,0:16:46.36,0:16:47.78,نص عام,,0,0,0,,السحرة قادمون
Dialogue: 0,0:16:47.86,0:16:48.90,نص عام,,0,0,0,,كن بالمرصاد
Dialogue: 0,0:16:51.78,0:16:54.74,نص عام,,0,0,0,,لماذا؟ إنهم بجانبي
Dialogue: 0,0:16:56.24,0:16:58.75,نص عام,,0,0,0,,إلى جانبك؟ كيف صبيانية!
Dialogue: 0,0:16:58.83,0:17:00.67,نص عام,,0,0,0,,لماذا تتحدث معي بشكل عرضي؟
Dialogue: 0,0:17:00.75,0:17:01.96,نص عام,,0,0,0,,حسنًا يا معلم
Dialogue: 0,0:17:02.04,0:17:03.29,نص عام,,0,0,0,,سألقي نظرة على الأرض
Dialogue: 0,0:17:12.43,0:17:13.47,نص عام,,0,0,0,,من هذا؟
Dialogue: 0,0:17:14.26,0:17:17.31,نص عام,,0,0,0,,أنا مو دوك، خادمته
Dialogue: 0,0:17:19.81,0:17:21.81,نص عام,,0,0,0,,هل سمعت؟ خادمتي
Dialogue: 0,0:17:22.40,0:17:24.11,نص عام,,0,0,0,,من الواضح أنك مشغول. اذهب عن عملك
Dialogue: 0,0:17:24.19,0:17:26.61,general text,,0,0,0,,- هيا بنا يا مو ديوك\N- لا يمكنك المغادرة
Dialogue: 0,0:17:29.28,0:17:32.28,نص عام,,0,0,0,,قال الرئيس لجمع الجميع في غرفة التدريب
Dialogue: 0,0:17:34.62,0:17:36.03,نص عام,,0,0,0,,أنا لست طالبًا في سوسنوفي بور
Dialogue: 0,0:17:36.12,0:17:38.37,general text,,0,0,0,,يريد الرأس جمع كل الكائنات الحية في تلك الغرفة،
Dialogue: 0,0:17:39.00,0:17:41.25,نص عام,,0,0,0,,ماذا يوجد في هذه الغابة
Dialogue: 0,0:17:49.84,0:17:51.34,نص عام,,0,0,0,,- Uk\N- مرحبًا
Dialogue: 0,0:17:53.26,0:17:55.68,نص عام,,0,0,0,,ماذا يحدث؟ لماذا اجتمعنا هنا؟
Dialogue: 0,0:17:56.22,0:17:58.85,نص عام,,0,0,0,,يريدون القبض على شعب ناك سو
Dialogue: 0,0:18:01.02,0:18:02.27,نص عام,,0,0,0,,ناك سو؟
Dialogue: 0,0:18:13.03,0:18:14.24,خط مائل,,0,0,0,,بعضكم
Dialogue: 0,0:18:14.32,0:18:17.20,نص عام,,0,0,0,,ساعد أفراد ناك سو على الوصول إلى هنا اليوم
Dialogue: 0,0:18:18.03,0:18:19.04,خط مائل,,0,0,0,,الفصل,
Dialogue: 0,0:18:19.12,0:18:22.29,نص عام,,0,0,0,,الجميع هنا يعرفون بعضهم البعض
Dialogue: 0,0:18:22.37,0:18:26.00,general text,,0,0,0,,ظاهريًا، أنتم جميعًا من أتباع سوسنوفي بور
Dialogue: 0,0:18:28.25,0:18:30.17,نص عام,,0,0,0,,فطلبت المساعدة
Dialogue: 0,0:18:31.38,0:18:34.63,النص العام,,0,0,0,,أحضرت الآنسة جين تشو يونغ غويغا
Dialogue: 0,0:19:10.29,0:19:11.34,نص عام,,0,0,0,,لقد وصلت
Dialogue: 0,0:19:25.31,0:19:27.44,نص عام,,0,0,0,,لماذا تشان ووك هنا؟
Dialogue: 0,0:19:28.52,0:19:29.56,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,0:19:40.20,0:19:43.16,النص العام,,0,0,0,,وربما يكون هذا غويغو، من بقايا عائلة جين
Dialogue: 0,0:19:43.24,0:19:44.29,نص عام,,0,0,0,,غويغو؟
Dialogue: 0,0:19:44.87,0:19:46.16,النص العام,,0,0,0,,- كلب؟\N- نعم
Dialogue: 0,0:19:46.25,0:19:48.96,general text,,0,0,0,,هذه هي روح السابساري التي تحدد السحر
Dialogue: 0,0:19:53.55,0:19:54.67,نص عام,,0,0,0,,بيننا
Dialogue: 0,0:19:55.76,0:19:57.01,نص عام,,0,0,0,,بدوي
Dialogue: 0,0:19:58.47,0:20:02.56,general text,,0,0,0,,وسوف يجده غويغو
Dialogue: 0,0:20:03.22,0:20:05.85,نص عام,,0,0,0,,ظاهريًا هذا شخص نعرفه
Dialogue: 0,0:20:05.93,0:20:09.31,general text,,0,0,0,,وسيجد غويغو شخصًا لديه روح مختلفة
Dialogue: 0,0:20:15.48,0:20:17.24,نص عام,,0,0,0,,أغلق كل الأبواب
Dialogue: 0,0:20:17.32,0:20:18.20,خط مائل,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:20:22.99,0:20:27.33,النص العام,,0,0,0,,أي شخص يحاول مغادرة هذا المبنى،
Dialogue: 0,0:20:27.41,0:20:30.67,general text,,0,0,0,,سيتم التعرف على الفور على أنه خائن ويُقتل
Dialogue: 0,0:20:32.13,0:20:33.25,خط مائل,,0,0,0,,ابدأ
Dialogue: 0,0:21:34.52,0:21:38.03,النص العام,,0,0,0,,كيمياء النفوس، نوع من السحر. ولكن هناك ناقص واحد
Dialogue: 0,0:21:38.11,0:21:40.07,general text,,0,0,0,,ينشأ صدع بين الروح والجسد،
Dialogue: 0,0:21:40.15,0:21:42.57,نص عام,,0,0,0,,تتسرب منه الطاقة الشريرة
Dialogue: 0,0:21:42.66,0:21:45.03,النص العام,,0,0,0,,ويمكن لغويغو تحديد ذلك
Dialogue: 0,0:22:13.77,0:22:16.77,general text,,0,0,0,,تشان ووك، إذا تم القبض علي، فتظاهر بأنك لا تعرف شيئًا
Dialogue: 0,0:22:19.19,0:22:21.32,general text,,0,0,0,,- هل ولائك؟\N- واجبي
Dialogue: 0,0:22:27.49,0:22:29.95,نص عام,,0,0,0,,لا أريد أن أصبح أضحوكة،
Dialogue: 0,0:22:30.62,0:22:32.58,general text,,0,0,0,,عندما اكتشفوا أنني طلبت مساعدتك
Dialogue: 0,0:22:32.66,0:22:34.17,نص عام,,0,0,0,,قف بجانبي
Dialogue: 0,0:22:35.33,0:22:39.00,general text,,0,0,0,,لن يسمح أحد هنا لهذا الوحش بمهاجمتي
Dialogue: 0,0:23:10.12,0:23:11.49,نص عام,,0,0,0,,بدوي! قبض عليه!
Dialogue: 0,0:24:40.12,0:24:43.21,general text,,0,0,0,,سمعت أن البدو يتحولون إلى حجر عندما يصبحون جامحين ويفقدون طاقتهم
Dialogue: 0,0:24:43.29,0:24:44.50,خط مائل,,0,0,0,,كان صحيحاً
Dialogue: 0,0:25:13.07,0:25:15.53,نص عام,,0,0,0,,نشكرك على مساعدتك
Dialogue: 0,0:25:16.91,0:25:19.16,نص عام,,0,0,0,,أنا متأكد من أنه سيأتي اليوم الذي نطلب فيه المساعدة
Dialogue: 0,0:25:20.33,0:25:24.92,النص العام,,0,0,0,,لقد اجتمعت هنا جميع عائلات ديهو الأربع العظيمة.
Dialogue: 0,0:25:25.00,0:25:27.09,النص العام,,0,0,0,,سمعت أنهم يطلقون عليك اسم الفصول الأربعة
Dialogue: 0,0:25:27.67,0:25:30.84,general text,,0,0,0,,أراكم جميعاً معاً وتبتهج روحي
Dialogue: 0,0:25:31.59,0:25:33.30,نص عام,,0,0,0,,كنا نجتمع كثيرًا،
Dialogue: 0,0:25:33.39,0:25:36.60,general text,,0,0,0,,ولكن هذا هو اللقاء الأول بعد فسخ خطوبة ووك وتشو يونغ
Dialogue: 0,0:25:38.10,0:25:39.48,نص عام,,0,0,0,,الوغد...
Dialogue: 0,0:25:40.06,0:25:42.52,نص عام,,0,0,0,,لقد طلبت بعض الشاي
Dialogue: 0,0:25:42.60,0:25:43.81,خط مائل,,0,0,0,,لنذهب
Dialogue: 0,0:25:50.49,0:25:52.28,نص عام,,0,0,0,,كنت هنا أيضاً
Dialogue: 0,0:25:52.99,0:25:55.07,general text,,0,0,0,,سمعت أنك طردت من كيسان
Dialogue: 0,0:25:55.16,0:25:56.70,نص عام,,0,0,0,,نعم
Dialogue: 0,0:25:57.62,0:26:00.41,نص عام,,0,0,0,,توقف عن مراقبة كل تحركاتي
Dialogue: 0,0:26:03.17,0:26:06.09,النص العام,,0,0,0,,كان الجميع يتحدثون عن كيفية طردك مرة أخرى
Dialogue: 0,0:26:06.17,0:26:07.71,نص عام,,0,0,0,,سمعت للتو
Dialogue: 0,0:26:07.80,0:26:09.13,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:26:10.17,0:26:13.05,النص العام,,0,0,0,,ضيفنا العزيز لا يحب صحبتي،
Dialogue: 0,0:26:13.13,0:26:14.51,نص عام,,0,0,0,,ثم...
Dialogue: 0,0:26:17.97,0:26:19.22,نص عام,,0,0,0,,الوغد
Dialogue: 0,0:26:21.10,0:26:22.14,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:26:24.35,0:26:25.44,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:26:37.45,0:26:39.87,نص عام,,0,0,0,,مرحبًا...أنت...
Dialogue: 0,0:26:40.95,0:26:42.91,نص عام,,0,0,0,,هل رأيت خادمتي؟
Dialogue: 0,0:26:43.50,0:26:46.13,نص عام,,0,0,0,,قصيرة ذات وجه مستدير
Dialogue: 0,0:26:46.21,0:26:47.50,نص عام,,0,0,0,,اللعنة
Dialogue: 0,0:26:48.38,0:26:50.00,نص عام,,0,0,0,,أين ذهبت؟
Dialogue: 0,0:26:51.76,0:26:54.84,خارج الشاشة,,0,0,0,,أرسل دان تشو بدويًا هنا
Dialogue: 0,0:26:56.51,0:26:58.18,خلف الكواليس,,0,0,0,,علينا العثور على دان تشو
Dialogue: 0,0:27:09.31,0:27:11.73,نص عام,,0,0,0,,ليس الولاء بل الواجب
Dialogue: 0,0:27:12.32,0:27:14.24,النص العام,,0,0,0,,هل تقول ذلك في هذه الحالة؟
Dialogue: 0,0:27:15.32,0:27:17.74,نص عام,,0,0,0,,لهذا السبب سأرحل وأتركك
Dialogue: 0,0:27:17.82,0:27:20.24,النص العام,,0,0,0,,في البداية كنت سأستدرجك وأقتلك
Dialogue: 0,0:27:20.33,0:27:21.29,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:27:22.08,0:27:23.45,نص عام,,0,0,0,,شرير
Dialogue: 0,0:27:23.54,0:27:27.21,general text,,0,0,0,,أنا لست خادمتك المؤمنة ذات الوجه المستدير مو دوك.
Dialogue: 0,0:27:28.13,0:27:31.09,نص عام,,0,0,0,,أنت ناك سو. قاتل لا يرحم
Dialogue: 0,0:27:33.76,0:27:36.51,general text,,0,0,0,,لقد أتيحت لك الفرصة لقتلي في الحمام
Dialogue: 0,0:27:36.59,0:27:38.80,النص العام,,0,0,0,,لقد خاطرت بحياتي بجلبك إلى هنا
Dialogue: 0,0:27:40.05,0:27:42.18,نص عام,,0,0,0,,الأمر متروك لك: اقتلني على أية حال
Dialogue: 0,0:27:42.26,0:27:45.23,general text,,0,0,0,,أو أصبح مرشدًا وأكشف عن قواي
Dialogue: 0,0:27:50.65,0:27:54.82,النص العام,,0,0,0,,لديك عادة التحديق في الناس
Dialogue: 0,0:27:54.90,0:27:57.15,النص العام,,0,0,0,,واصل هكذا وسوف يتم القبض عليك بسرعة
Dialogue: 0,0:27:58.28,0:28:00.45,نص عام,,0,0,0,,هل ترى العلامة من هناك؟
Dialogue: 0,0:28:01.87,0:28:02.91,نص عام,,0,0,0,,لا
Dialogue: 0,0:28:05.83,0:28:06.79,نص عام,,0,0,0,,والآن؟
Dialogue: 0,0:28:09.63,0:28:11.04,نص عام,,0,0,0,,أرى لأنني أعرف
Dialogue: 0,0:28:13.05,0:28:14.17,نص عام,,0,0,0,,والآن؟
Dialogue: 0,0:28:21.60,0:28:23.31,نص عام,,0,0,0,,أرى بوضوح
Dialogue: 0,0:28:23.39,0:28:26.06,general text,,0,0,0,,ولكن من غير المرجح أن تقف بالقرب من شخص آخر.
Dialogue: 0,0:28:26.73,0:28:28.60,نص عام,,0,0,0,,كن حذرًا عند تقبيل شخص ما
Dialogue: 0,0:28:30.94,0:28:32.82,نص عام,,0,0,0,,هيا، سأساعدك على الخروج
Dialogue: 0,0:28:32.90,0:28:35.36,النص العام,,0,0,0,,أي شخص يقترب إلى هذا الحد سيموت
Dialogue: 0,0:28:37.86,0:28:39.24,نص عام,,0,0,0,,قد تموت اليوم
Dialogue: 0,0:28:40.61,0:28:41.82,نص عام,,0,0,0,,روح سابساري
Dialogue: 0,0:28:49.33,0:28:50.79,general text,,0,0,0,,إذا هاجمك،
Dialogue: 0,0:28:50.87,0:28:52.67,النص العام,,0,0,0,,هل ستتحول إلى حجر؟
Dialogue: 0,0:28:54.59,0:28:55.71,نص عام,,0,0,0,,تشغيل
Dialogue: 0,0:28:57.84,0:28:58.92,نص عام,,0,0,0,,سأحاول إنقاذك
Dialogue: 0,0:30:21.76,0:30:23.38,نص عام,,0,0,0,,غويغو اورن
Dialogue: 0,0:30:23.47,0:30:25.59,نص عام,,0,0,0,,لقد كان إرث عائلتنا
Dialogue: 0,0:30:26.89,0:30:29.81,نص عام,,0,0,0,,أردت فقط أن أرى
Dialogue: 0,0:30:29.89,0:30:32.98,النص العام,,0,0,0,,لماذا يكون الإرث العائلي هشًا جدًا؟
Dialogue: 0,0:30:33.06,0:30:34.39,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:30:38.11,0:30:39.86,نص عام,,0,0,0,,دعونا نتحدث. هنا
Dialogue: 0,0:30:40.53,0:30:41.61,نص عام,,0,0,0,,المملكة المتحدة
Dialogue: 0,0:30:43.65,0:30:44.78,نص عام,,0,0,0,,المملكة المتحدة
Dialogue: 0,0:30:46.62,0:30:49.83,نص عام,,0,0,0,,مرحبًا، المملكة المتحدة! تشان ووك!
Dialogue: 0,0:30:54.54,0:30:55.62,نص عام,,0,0,0,,المملكة المتحدة!
Dialogue: 0,0:30:56.96,0:30:58.04,نص عام,,0,0,0,,المملكة المتحدة!
Dialogue: 0,0:30:58.67,0:31:00.00,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,0:31:00.59,0:31:01.96,مائل,,0,0,0,,بارك الله فيك!
Dialogue: 0,0:31:03.30,0:31:04.26,خط مائل,,0,0,0,,المملكة المتحدة!
Dialogue: 0,0:31:05.47,0:31:06.51,نص عام,,0,0,0,,اجمع الأجزاء
Dialogue: 0,0:31:06.59,0:31:08.80,نص عام,,0,0,0,,سأضطر إلى إعادة تجميعهما معًا مرة أخرى
Dialogue: 0,0:31:08.89,0:31:10.18,نص عام,,0,0,0,,- نعم سيدتي\N- نعم سيدتي
Dialogue: 0,0:31:25.40,0:31:26.70,نص عام,,0,0,0,,أيها الأمهات
Dialogue: 0,0:31:27.32,0:31:29.16,النص العام,,0,0,0,,لقد فعل سيدك الأشياء
Dialogue: 0,0:31:30.87,0:31:33.54,التعليق الصوتي,,0,0,0,,هكذا أنقذني
Dialogue: 0,0:31:33.62,0:31:34.71,خط مائل,,0,0,0,,هذا الرجل...
Dialogue: 0,0:31:34.79,0:31:37.33,general text,,0,0,0,,فسخت خطوبتي معهم العام الماضي.
Dialogue: 0,0:31:37.42,0:31:39.84,نص عام,,0,0,0,,هذه المرة كسرت الأثر
Dialogue: 0,0:31:39.92,0:31:42.17,النص العام,,0,0,0,,- الخطوبة؟\N- نعم
Dialogue: 0,0:31:43.38,0:31:45.26,نص عام,,0,0,0,,ألغيت الزفاف معها
Dialogue: 0,0:31:45.92,0:31:49.47,مائل,,0,0,0,,12 معلمًا رفضوه، وفشل حفل الزفاف، والآن هذا أيضًا
Dialogue: 0,0:31:49.55,0:31:51.01,نص عام,,0,0,0,,كارثة تسير على الأقدام
Dialogue: 0,0:31:53.77,0:31:55.48,نص عام,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,0:31:56.39,0:31:57.56,نص عام,,0,0,0,,أين المالك؟
Dialogue: 0,0:31:58.56,0:31:59.48,نص عام,,0,0,0,,لقد تم جره بعيداً
Dialogue: 0,0:32:00.15,0:32:03.48,النص العام,,0,0,0,,أخشى أن يواجه عقوبة شديدة هذه المرة
Dialogue: 0,0:32:10.91,0:32:13.41,نص عام,,0,0,0,,أرسلتك إلى كيسان
Dialogue: 0,0:32:14.49,0:32:16.71,نص عام,,0,0,0,,لقد طردوك من هناك في ستة أشهر
Dialogue: 0,0:32:17.54,0:32:19.29,نص عام,,0,0,0,,لماذا أتيت إلى هنا اليوم؟
Dialogue: 0,0:32:19.37,0:32:22.42,general text,,0,0,0,,سمعت أنني سببت لك المتاعب فجئت لأعتذر
Dialogue: 0,0:32:23.00,0:32:24.38,نص عام,,0,0,0,,هل هذا اعتذارك؟
Dialogue: 0,0:32:27.01,0:32:29.89,نص عام,,0,0,0,,لماذا كسرت الجرة؟
Dialogue: 0,0:32:29.97,0:32:32.68,النص العام,,0,0,0,,لقد انبهرت به، وأردت إلقاء نظرة فاحصة عليه،
Dialogue: 0,0:32:32.76,0:32:34.93,نص عام,,0,0,0,,ولقد انزلقت من يدي
Dialogue: 0,0:32:35.02,0:32:37.56,general text,,0,0,0,,لو كنت أعرف التعويذات لما حدث هذا
Dialogue: 0,0:32:37.64,0:32:39.10,نص عام,,0,0,0,,ليس لدي المعرفة الكافية
Dialogue: 0,0:32:39.19,0:32:40.77,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:32:42.44,0:32:44.27,نص عام,,0,0,0,,لقد فعل الشيء نفسه
Dialogue: 0,0:32:44.36,0:32:46.53,نص عام,,0,0,0,,مع باب الغرفة السرية. دمرته
Dialogue: 0,0:32:47.03,0:32:50.16,general text,,0,0,0,,لقد فعل هذا عمدا. من الحسد
Dialogue: 0,0:32:50.95,0:32:54.03,نص عام,,0,0,0,,هذه المرة لن أدعك تفلت من العقاب
Dialogue: 0,0:32:54.99,0:32:58.16,general text,,0,0,0,,حتى أسمح بذلك، تشان ووك محظور
Dialogue: 0,0:32:58.25,0:33:01.92,نص عام,,0,0,0,,تحرك أو تكلم
Dialogue: 0,0:33:03.25,0:33:04.54,نص عام,,0,0,0,,توبة
Dialogue: 0,0:33:23.77,0:33:24.77,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:33:26.23,0:33:28.11,النص العام,,0,0,0,,لن يُعاقب طويلاً
Dialogue: 0,0:33:29.65,0:33:32.16,general text,,0,0,0,,كاد أن يموت بالبرد بعد عقوبته الأخيرة،
Dialogue: 0,0:33:32.24,0:33:33.37,النص العام,,0,0,0,,لقد عوقب طوال اليوم
Dialogue: 0,0:33:34.28,0:33:37.58,مائل,,0,0,0,,أبواب طاقته مفتوحة بما يكفي حتى لا يموت
Dialogue: 0,0:33:37.66,0:33:40.25,general text,,0,0,0,,برد أو حرارة رهيبة يمكن أن تقتله
Dialogue: 0,0:33:41.04,0:33:42.25,نص عام,,0,0,0,,وهو مريض منذ زمن طويل
Dialogue: 0,0:33:42.83,0:33:46.71,general text,,0,0,0,,ثم افتح هذه البوابات. يريد ذلك
Dialogue: 0,0:33:47.34,0:33:49.05,النص العام,,0,0,0,,أنتم أصدقاءه
Dialogue: 0,0:33:50.09,0:33:51.97,نص عام,,0,0,0,,نحن ضعفاء جداً
Dialogue: 0,0:33:53.30,0:33:54.76,النص العام,,0,0,0,,لكن لا أحد في سوسنوفي بور...
Dialogue: 0,0:33:54.85,0:33:58.47,general text,,0,0,0,,لا، لا أحد في ديهو يجرؤ على فعل هذا
Dialogue: 0,0:34:03.69,0:34:06.82,general text,,0,0,0,,فلقد عوقب طوال حياته
Dialogue: 0,0:34:41.52,0:34:43.56,نص عام,,0,0,0,,يمكنك شرب الشاي الساخن
Dialogue: 0,0:34:47.11,0:34:48.23,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:34:48.86,0:34:51.78,النص العام,,0,0,0,,سأذهب وأتركك
Dialogue: 0,0:34:53.36,0:34:54.74,general text,,0,0,0,,هل ستغادرين بدوني؟
Dialogue: 0,0:35:02.20,0:35:04.58,النص العام,,0,0,0,,أنت مخلص وتعرف مسؤولياتك
Dialogue: 0,0:35:05.46,0:35:07.83,نص عام,,0,0,0,,إذن سمحت لي بالدخول، وأحضرتني إلى هنا
Dialogue: 0,0:35:08.92,0:35:11.09,نص عام,,0,0,0,,ودفاع
Dialogue: 0,0:35:12.17,0:35:15.47,النص العام,,0,0,0,,يجب أن تفهم أنه لا يمكنك إخبار أي شخص بهذا الأمر
Dialogue: 0,0:35:28.36,0:35:30.86,نص عام,,0,0,0,,سأكون كل الشكر لك
Dialogue: 0,0:35:41.87,0:35:44.87,النص العام,,0,0,0,,الأشخاص الذين التقيت بهم أرادوا موتي
Dialogue: 0,0:35:46.16,0:35:48.04,نص عام,,0,0,0,,أنت أول من يحاول
Dialogue: 0,0:35:49.42,0:35:51.04,نص عام,,0,0,0,,أنقذوني
Dialogue: 0,0:35:57.38,0:36:00.01,general text,,0,0,0,,حتى لو وجدنا أنفسنا قريبين من بعضنا البعض مرة أخرى،
Dialogue: 0,0:36:00.64,0:36:02.18,نص عام,,0,0,0,,سوف أنقذك
Dialogue: 0,0:36:59.28,0:37:02.16,مائل,,0,0,0,,سأرسل هدية إلى كيسان كاعتذار
Dialogue: 0,0:37:02.24,0:37:06.41,النص العام,,0,0,0,,وسأدفع مبلغًا محترمًا لعائلة جين
Dialogue: 0,0:37:07.00,0:37:10.42,general text,,0,0,0,,لقد ارتكبت المملكة المتحدة الكثير من الأخطاء هذه المرة
Dialogue: 0,0:37:11.96,0:37:13.67,النص العام,,0,0,0,,كان علي أن أعاقبه
Dialogue: 0,0:37:13.75,0:37:15.59,نص عام,,0,0,0,,أنا سعيد لأنك عاقبته
Dialogue: 0,0:37:16.67,0:37:19.97,نص عام,,0,0,0,,والآن بعد أن انتهيت، سأخذها إلى المنزل
Dialogue: 0,0:37:20.72,0:37:21.89,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:37:23.60,0:37:24.72,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:37:30.64,0:37:33.73,النص العام,,0,0,0,,- هل أنت بخير؟\N- ليس بخير
Dialogue: 0,0:37:35.73,0:37:37.94,نص عام,,0,0,0,,هل عاد مو دوك إلى المنزل؟
Dialogue: 0,0:37:38.53,0:37:40.53,نص عام,,0,0,0,,لماذا تحتاجها؟
Dialogue: 0,0:37:41.40,0:37:45.08,general text,,0,0,0,,بالحديث عنها أين كانت عندما عوقبت؟
Dialogue: 0,0:37:45.70,0:37:46.79,نص عام,,0,0,0,,انسى
Dialogue: 0,0:37:50.08,0:37:52.96,النص العام,,0,0,0,,لماذا خربت الباب؟
Dialogue: 0,0:37:54.04,0:37:55.63,نص عام,,0,0,0,,الباب لن يغلق بالفعل
Dialogue: 0,0:37:56.29,0:37:57.63,نص عام,,0,0,0,,لا أعلم
Dialogue: 0,0:38:00.51,0:38:03.01,النص العام,,0,0,0,,- لماذا انكسر صندوق الاقتراع؟\N- لا...
Dialogue: 0,0:38:05.01,0:38:06.60,نص عام,,0,0,0,,قلت لا أعرف
Dialogue: 0,0:38:07.22,0:38:08.56,نص عام,,0,0,0,,توقف عن السؤال
Dialogue: 0,0:38:18.65,0:38:20.57,نص عام,,0,0,0,,المفرقعات النارية التي طلبتها
Dialogue: 0,0:38:20.65,0:38:22.70,نص عام,,0,0,0,,سوف تكون مرئية من مسافة بعيدة جدًا
Dialogue: 0,0:38:25.74,0:38:26.87,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:38:27.87,0:38:30.83,نص عام,,0,0,0,,لماذا يحتاجها السيد؟
Dialogue: 0,0:38:30.91,0:38:33.29,general text,,0,0,0,,هناك شائعات بأنه عوقب بشدة
Dialogue: 0,0:38:33.37,0:38:34.87,نص عام,,0,0,0,,ما خطبه هذه المرة؟
Dialogue: 0,0:38:36.88,0:38:37.88,نص عام,,0,0,0,,سرّي
Dialogue: 0,0:38:38.75,0:38:40.55,نص عام,,0,0,0,,لا تخبر أحداً بهذا الأمر
Dialogue: 0,0:38:42.34,0:38:43.59,نص عام,,0,0,0,,جو وول
Dialogue: 0,0:38:45.47,0:38:47.51,نص عام,,0,0,0,,من الأفضل ألا يتدخل في أي مكان
Dialogue: 0,0:38:54.27,0:38:55.65,النص العام,,0,0,0,,هذه تميمة سوسنوفي بور
Dialogue: 0,0:38:56.23,0:38:58.11,نص عام,,0,0,0,,هل يمكنك الذهاب إلى هناك فحسب؟
Dialogue: 0,0:38:58.19,0:39:00.36,نص عام,,0,0,0,,السيد الشاب يثق بك كثيرًا
Dialogue: 0,0:39:01.11,0:39:03.19,نص عام,,0,0,0,,يا له من شيء باهظ الثمن
Dialogue: 0,0:39:04.28,0:39:05.82,نص عام,,0,0,0,,يريدني أن أبيعه
Dialogue: 0,0:39:06.74,0:39:09.41,نص عام,,0,0,0,,لا يمكنك بيع شيء كهذا فحسب
Dialogue: 0,0:39:09.49,0:39:10.49,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:39:11.04,0:39:13.33,نص عام,,0,0,0,,قال أن هناك مثل هذا المكان
Dialogue: 0,0:39:13.91,0:39:14.96,نص عام,,0,0,0,,ولكن هناك
Dialogue: 0,0:39:15.04,0:39:18.42,النص العام,,0,0,0,,هناك رجل ثري يشتري كل شيء في السوق السوداء
Dialogue: 0,0:39:20.00,0:39:22.42,نص عام,,0,0,0,,لكن الوصول إلى هناك لن يكون سهلاً
Dialogue: 0,0:39:28.93,0:39:31.06,نص عام,,0,0,0,,سوف تحصل على جبل من المال
Dialogue: 0,0:39:31.14,0:39:33.06,مائل,,0,0,0,,هل يمكنني الحصول على المزيد من الدجاج؟
Dialogue: 0,0:39:33.14,0:39:35.73,نص عام,,0,0,0,,نعم. سأضعه على حساب سيدك
Dialogue: 0,0:39:35.81,0:39:37.73,خط مائل,,0,0,0,,تناول قدر ما تريد
Dialogue: 0,0:39:44.99,0:39:49.28,مائل,,0,0,0,,جسد ناك سو هنا، لكن الروح في مكان آخر.
Dialogue: 0,0:39:50.16,0:39:54.08,general text,,0,0,0,,سوف تحصل أيضًا على أجساد جديدة بواسطة كيمياء النفوس
Dialogue: 0,0:39:54.16,0:39:58.54,general text,,0,0,0,,فلا تخف من التضحية بنفسك من أجلي
Dialogue: 0,0:39:58.63,0:39:59.79,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:40:19.94,0:40:20.86,نص عام,,0,0,0,,نار!
Dialogue: 0,0:40:39.54,0:40:41.04,ذكريات,,0,0,0,,أحتاج سيفي
Dialogue: 0,0:40:41.13,0:40:43.17,ذكريات,,0,0,0,,ضعفت بسبب هجرتي إلى جسد آخر
Dialogue: 0,0:40:43.88,0:40:46.80,الذكريات,,0,0,0,,أحتاج إلى سيفي بالطاقة لفتح قوتك
Dialogue: 0,0:40:46.88,0:40:49.51,ذكريات,,0,0,0,,حتى لو وجدنا أنفسنا قريبين من بعضنا البعض مرة أخرى،
Dialogue: 0,0:40:50.09,0:40:51.59,ذكريات,,0,0,0,,سوف أنقذك
Dialogue: 0,0:40:56.39,0:40:58.85,النص العام,,0,0,0,,- فقدت الشهية\N{\i1}- سيد
Dialogue: 0,0:41:01.06,0:41:02.86,نص عام,,0,0,0,,سيدي، لقد تم القبض عليهم
Dialogue: 0,0:41:03.44,0:41:06.11,general text,,0,0,0,,- مو دوك؟\N- لماذا قبض عليها؟
Dialogue: 0,0:41:07.11,0:41:09.24,نص عام,,0,0,0,,انسى
Dialogue: 0,0:41:09.32,0:41:11.03,النص العام,,0,0,0,,جين مو، نائب رئيس جيونبوغوان،
Dialogue: 0,0:41:11.11,0:41:13.53,نص عام,,0,0,0,,القبض على رجال ناك سو الذين دخلوا سوسنوفي بور
Dialogue: 0,0:41:14.16,0:41:15.16,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:41:17.75,0:41:21.62,النص العام,,0,0,0,,سلم جين مو الجثث إلى القصر
Dialogue: 0,0:41:21.71,0:41:23.84,خط مائل,,0,0,0,,لقد قبضنا على ناك سو
Dialogue: 0,0:41:23.92,0:41:26.71,خط مائل,,0,0,0,,أخشى أن يجعلونا نضحك
Dialogue: 0,0:41:26.80,0:41:29.80,النص العام,,0,0,0,,صحيح أنه لم يدخر
Dialogue: 0,0:41:30.34,0:41:32.01,نص عام,,0,0,0,,لا أحد؟
Dialogue: 0,0:41:32.09,0:41:33.60,نص عام,,0,0,0,,لقد قتل الجميع
Dialogue: 0,0:41:35.10,0:41:37.93,نص عام,,0,0,0,,لا نستطيع تتبع كيمياء النفوس
Dialogue: 0,0:41:40.06,0:41:42.40,النص العام,,0,0,0,,جين هو كيونغ من جينيوون موجود هنا أيضًا
Dialogue: 0,0:41:47.53,0:41:49.65,نص عام,,0,0,0,,سمعت، جين مو
Dialogue: 0,0:41:49.74,0:41:52.53,نص عام,,0,0,0,,القبض على المرتزقة الذين فاتتهم بور
Dialogue: 0,0:41:53.36,0:41:56.37,general text,,0,0,0,,كيف كسروا حاجز غابة الصنوبر مرتين؟
Dialogue: 0,0:42:01.21,0:42:03.46,النص العام,,0,0,0,,كان هناك خائن في الغابة
Dialogue: 0,0:42:03.54,0:42:06.84,النص العام,,0,0,0,,الحمد لله أن غويغو قبض عليه
Dialogue: 0,0:42:07.80,0:42:09.09,نص عام,,0,0,0,,غويغو؟
Dialogue: 0,0:42:09.17,0:42:11.05,نص عام,,0,0,0,,أود أن أراه أيضًا
Dialogue: 0,0:42:11.13,0:42:13.43,نص عام,,0,0,0,,أخشى أنني لا أستطيع أن أعرضه لك الآن
Dialogue: 0,0:42:13.51,0:42:16.35,نص عام,,0,0,0,,جرته انكسرت بالخطأ
Dialogue: 0,0:42:17.43,0:42:19.68,general text,,0,0,0,,كيف يمكن ارتكاب مثل هذا الخطأ الغبي؟
Dialogue: 0,0:42:21.14,0:42:22.39,نص عام,,0,0,0,,عذراً يا صاحب الجلالة
Dialogue: 0,0:42:23.44,0:42:27.61,general text,,0,0,0,,منذ أن قدم جين مو مثل هذه المساهمة، جمعتكم جميعًا للحديث عنها
Dialogue: 0,0:42:27.69,0:42:29.94,نص عام,,0,0,0,,سأسندها إلى غوانغجو
Dialogue: 0,0:42:31.15,0:42:32.40,نص عام,,0,0,0,,لكنه مستحيل
Dialogue: 0,0:42:32.49,0:42:35.20,نص عام,,0,0,0,,تشانغ جانج لا يزال غوانغجو
Dialogue: 0,0:42:35.28,0:42:38.28,general text,,0,0,0,,أعطاه الملك الراحل رداءً وسيفًا
Dialogue: 0,0:42:38.37,0:42:40.25,النص العام,,0,0,0,,جانغ جانج - غوانغجو جيونبوغوان
Dialogue: 0,0:42:40.83,0:42:43.50,مائل,,0,0,0,,إلى جانب ذلك، لديه ابن، تشان ووك
Dialogue: 0,0:42:43.58,0:42:44.42,نص عام,,0,0,0,,شان غان,
Dialogue: 0,0:42:45.25,0:42:46.63,نص عام,,0,0,0,,الاختباء خلف التدريب,
Dialogue: 0,0:42:46.71,0:42:48.34,نص عام,,0,0,0,,مفقود منذ عقود
Dialogue: 0,0:42:48.42,0:42:51.46,مائل,,0,0,0,,ابنه "تشانغ ووك" غير قادر جسديًا على إلقاء التعويذات
Dialogue: 0,0:42:51.55,0:42:53.55,النص العام,,0,0,0,,جين مو، نائب غوانغجو،
Dialogue: 0,0:42:54.72,0:42:55.80,النص العام,,0,0,0,,يؤدي واجباته
Dialogue: 0,0:42:57.64,0:42:59.93,مائل,,0,0,0,,جلالة الملك، تعاويذ متعلقة بالسحر الأسود،
Dialogue: 0,0:43:00.01,0:43:03.39,مائل,,0,0,0,,محرم على السحرة
Dialogue: 0,0:43:03.48,0:43:05.60,النص العام,,0,0,0,,وسحرة سوسنوفي بور دائماً
Dialogue: 0,0:43:06.15,0:43:07.98,نص عام,,0,0,0,,تابع هذا
Dialogue: 0,0:43:08.56,0:43:12.07,italics,,0,0,0,,من الممكن أن تسقط "سوسنوفي بور" في الحضيض بسبب الحادث الذي وقع مع البدو
Dialogue: 0,0:43:12.15,0:43:13.61,النص العام,,0,0,0,,كان من الممكن أن يتخلصوا منه
Dialogue: 0,0:43:15.24,0:43:19.12,نص عام,,0,0,0,,لكن جين مو قتل الجميع
Dialogue: 0,0:43:20.24,0:43:22.70,النص العام,,0,0,0,,في الحقيقة لقد دمر كل شيء
Dialogue: 0,0:43:22.79,0:43:24.41,النص العام,,0,0,0,,أنت زعلان,
Dialogue: 0,0:43:25.25,0:43:28.08,النص العام,,0,0,0,,لأن جيونبوغوان نال كل المجد؟
Dialogue: 0,0:43:28.17,0:43:30.30,general text,,0,0,0,,لقد استولى سحرة غابة الصنوبر على ناك سو!
Dialogue: 0,0:43:30.38,0:43:32.26,النص العام,,0,0,0,,لكنك نالت الفضل في هذا العمل الفذ
Dialogue: 0,0:43:34.59,0:43:36.51,نص عام,,0,0,0,,ليس هذا ما جئنا لمناقشته
Dialogue: 0,0:43:39.01,0:43:42.68,general text,,0,0,0,,فيما يتعلق بموقف غوانغجو، سندعو إلى اجتماع السحرة
Dialogue: 0,0:43:42.77,0:43:45.77,النص العام,,0,0,0,,وسنتخذ قرارًا عندما يعود تشانغ جانج
Dialogue: 0,0:43:46.77,0:43:49.90,نص عام,,0,0,0,,أرجو أن تكافئه بشكل مختلف
Dialogue: 0,0:43:53.40,0:43:54.65,نص عام,,0,0,0,,جين مو
Dialogue: 0,0:43:56.61,0:43:58.41,نص عام,,0,0,0,,قل لي ماذا تريد
Dialogue: 0,0:44:01.28,0:44:03.20,نص عام,,0,0,0,,الناس قلقون من التعويذة
Dialogue: 0,0:44:03.29,0:44:05.71,general text,,0,0,0,,دعني أشعل النار في جسد ناك سو أمام جيونبوغوان
Dialogue: 0,0:44:05.79,0:44:06.96,نص عام,,0,0,0,,وسيف ناك سو...
Dialogue: 0,0:44:08.04,0:44:11.38,general text,,0,0,0,,دعونا نأخذه، فقد تمكنوا بالفعل من خسارته في سوسنوفي بور
Dialogue: 0,0:44:14.80,0:44:16.51,نص عام,,0,0,0,,هذا ما سنفعله
Dialogue: 0,0:44:25.73,0:44:29.90,مائل,,0,0,0,,أفضل سيوف السحرة محفوظة
Dialogue: 0,0:44:29.98,0:44:32.73,نص عام,,0,0,0,,في مستودع أسلحة تشونغجينغاك
Dialogue: 0,0:44:33.86,0:44:36.28,نص عام,,0,0,0,,ولكن الآن تغير كل شيء
Dialogue: 0,0:44:37.74,0:44:39.91,general text,,0,0,0,,جين مو من تشونبوغوان أخذ سيف ناك سو؟
Dialogue: 0,0:44:39.99,0:44:43.58,general text,,0,0,0,,نعم، سيدفن جثة ناك سو هناك
Dialogue: 0,0:44:43.66,0:44:46.25,النص العام,,0,0,0,,وسوف تشاهد جسدها يحترق
Dialogue: 0,0:44:46.33,0:44:47.37,خط مائل,,0,0,0,,من؟
Dialogue: 0,0:44:47.46,0:44:48.37,نص عام,,0,0,0,,ناك سو؟
Dialogue: 0,0:44:49.12,0:44:51.33,general text,,0,0,0,,هل ما زلت تعتقد أن ناك سو تمكنت من تغيير جسدها؟
Dialogue: 0,0:44:52.50,0:44:55.00,general text,,0,0,0,,هل تفكرين جدياً في أن تطلبي أن تكوني تلميذتها؟
Dialogue: 0,0:44:56.17,0:44:57.30,نص عام,,0,0,0,,انسى
Dialogue: 0,0:44:58.22,0:44:59.55,نص عام,,0,0,0,,اسكب لي المزيد من الشاي
Dialogue: 0,0:45:02.55,0:45:05.47,نص عام,,0,0,0,,لديك أيضًا يدان،
Dialogue: 0,0:45:05.56,0:45:07.10,خط مائل,,0,0,0,,كسول
Dialogue: 0,0:45:09.94,0:45:12.48,general text,,0,0,0,,أين خادمتك مو دوك؟
Dialogue: 0,0:45:13.86,0:45:17.65,النص العام,,0,0,0,,سوف أجدها، لكني بحاجة إلى سيف أولاً
Dialogue: 0,0:45:24.74,0:45:27.33,التعليق الصوتي,,0,0,0,,بما أنه تخلص من كل أشيائي،
Dialogue: 0,0:45:27.83,0:45:30.41,التعليق الصوتي,,0,0,0,,ربما يعتقد أنني مت، لأنه غير قادر على العثور على جثة جديدة
Dialogue: 0,0:45:31.96,0:45:34.84,خارج الشاشة,,0,0,0,,لا يمكن العثور على Dan Zhu. أنا لا أعرف من هو
Dialogue: 0,0:45:43.47,0:45:46.22,مائل,,0,0,0,,ابحث عن التاجر الذي يبيع هذه التميمة المرسومة،
Dialogue: 0,0:45:46.31,0:45:47.72,مائل,,0,0,0,,وبعد ذلك ستجدني
Dialogue: 0,0:45:48.31,0:45:49.60,خط مائل,,0,0,0,,سأنتظر
Dialogue: 0,0:46:12.33,0:46:13.79,خلف الكواليس,,0,0,0,,هذا في دانهيانغوك
Dialogue: 0,0:46:16.92,0:46:20.42,نقوش,,0,0,0,,جيونبوغوان
Dialogue: 0,0:46:20.51,0:46:22.22,نص عام,,0,0,0,,جئت من أجل سيف ناك سو
Dialogue: 0,0:46:22.93,0:46:24.22,نص عام,,0,0,0,,لماذا تحتاجه؟
Dialogue: 0,0:46:24.30,0:46:27.35,general text,,0,0,0,,سمعت أن جلالته سمح بإبقائه في جيونبوغوان
Dialogue: 0,0:46:27.43,0:46:30.93,general text,,0,0,0,,تشانغ جانج - غوانغجو، أعتقد أنه سيكون من الصواب إعطاء السيف لعائلته
Dialogue: 0,0:46:31.02,0:46:32.27,نص عام,,0,0,0,,بما أن والدك ليس هنا،
Dialogue: 0,0:46:32.35,0:46:34.69,النص العام,,0,0,0,,الأصح أن يحتفظ بها النائب غوانغجو
Dialogue: 0,0:46:38.15,0:46:41.74,general text,,0,0,0,,أبي ليس هنا، لذا يجب أن أحافظ عليه أنا ابنه
Dialogue: 0,0:46:46.45,0:46:48.87,نص عام,,0,0,0,,سمعت أنك تبحث عن معلم في كل مكان
Dialogue: 0,0:46:49.62,0:46:51.33,نص عام,,0,0,0,,أود أن أستقبلك بنفسي،
Dialogue: 0,0:46:52.00,0:46:54.71,general text,,0,0,0,,لكنني لا أستطيع أن أخالف إرادة والدك أستاذي.
Dialogue: 0,0:46:56.38,0:46:59.46,general text,,0,0,0,,لماذا أغلق بوابة الطاقة لابنه؟
Dialogue: 0,0:47:00.50,0:47:02.38,نص عام,,0,0,0,,لا أفهم هذا على الإطلاق
Dialogue: 0,0:47:07.05,0:47:09.47,مائل,,0,0,0,,طاقة الساحر تتدفق عبر سيفه
Dialogue: 0,0:47:09.56,0:47:13.64,النص العام,,0,0,0,,شخص عادي مثلك لن يستطيع فضحه
Dialogue: 0,0:47:37.38,0:47:39.17,general text,,0,0,0,,هل أنت خائف من أن أنجح؟
Dialogue: 0,0:47:42.09,0:47:44.67,general text,,0,0,0,,إذا استطعت، فسيتم التعرف علي كغوانغجو التالي
Dialogue: 0,0:47:44.76,0:47:47.64,general text,,0,0,0,,مما يعني أنك لن تتمكن من التقدم لهذا المنصب
Dialogue: 0,0:47:53.06,0:47:54.10,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:47:54.89,0:47:56.27,نص عام,,0,0,0,,لا أستطيع فعل هذا بعد
Dialogue: 0,0:48:08.20,0:48:09.41,نص عام,,0,0,0,,إلى اللقاء؟
Dialogue: 0,0:48:13.29,0:48:15.96,نص عام,,0,0,0,,رأيت الأضواء فوق دانهيانغوك
Dialogue: 0,0:48:16.04,0:48:17.87,نص عام,,0,0,0,,هل أنت متأكد أنه كان من هناك؟
Dialogue: 0,0:48:17.96,0:48:18.79,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:48:18.87,0:48:21.42,general text,,0,0,0,,كان فوق الوادي، الموطن السابق لناك سو.
Dialogue: 0,0:48:41.44,0:48:43.07,النص العام,,0,0,0,,أبحث عن رجل يحمل تميمة
Dialogue: 0,0:48:52.53,0:48:54.33,نص عام,,0,0,0,,سيدتي لقد جاءوا
Dialogue: 0,0:48:59.12,0:49:00.88,نص عام,,0,0,0,,أعتقد أن هناك من يريد شراء هذا
Dialogue: 0,0:49:06.46,0:49:08.30,نص عام,,0,0,0,,لك في الغرفة الأخيرة
Dialogue: 0,0:49:14.22,0:49:16.02,النص العام,,0,0,0,,كيف يمكن أن تفقده؟
Dialogue: 0,0:49:16.10,0:49:18.48,النص العام,,0,0,0,,لم أفقدها، لقد سرقها أحدهم
Dialogue: 0,0:49:18.56,0:49:20.06,نص عام,,0,0,0,,أنا متأكد من أنه كان آه هيانغ
Dialogue: 0,0:49:22.52,0:49:24.52,مائل,,0,0,0,,هل أحضرت هذا؟
Dialogue: 0,0:49:27.03,0:49:29.28,النص العام,,0,0,0,,جئت لشراء التميمة المقدسة
Dialogue: 0,0:49:30.11,0:49:31.66,نص عام,,0,0,0,,لقد وصلت للشخص المناسب
Dialogue: 0,0:49:38.91,0:49:40.71,الذكريات بخط مائل,,0,0,0,,لن تكون مفيدة بعد الآن
Dialogue: 0,0:49:40.79,0:49:42.63,ذكريات,,0,0,0,,اقتلها لتجنب المشاكل
Dialogue: 0,0:49:55.05,0:49:55.97,نص عام,,0,0,0,,أنت تعرفني، أليس كذلك؟
Dialogue: 0,0:49:56.06,0:49:58.27,general text,,0,0,0,,قلت لك أن تخبرني إذا أحضر أي شخص هذه الرسمة
Dialogue: 0,0:49:58.93,0:49:59.77,نص عام,,0,0,0,,لقد فعلت ذلك بالضبط
Dialogue: 0,0:50:00.52,0:50:02.73,نص عام,,0,0,0,,تقابله في الطابق العلوي
Dialogue: 0,0:50:03.60,0:50:05.86,نص عام,,0,0,0,,إذن كان آه هيانغ
Dialogue: 0,0:50:11.11,0:50:12.66,النص العام,,0,0,0,,نحن سحرة من جيونبوغوان
Dialogue: 0,0:50:13.24,0:50:16.45,خط مائل,,0,0,0,,لقد قبضنا للتو على لص. اهتم بشؤونك الخاصة
Dialogue: 0,0:50:22.67,0:50:23.83,تعليق صوتي,,0,0,0,,لقد قتلها
Dialogue: 0,0:50:24.88,0:50:26.42,التعليق الصوتي,,0,0,0,,لقد قرر أنه أنا
Dialogue: 0,0:50:55.61,0:50:57.78,التعليق الصوتي,,0,0,0,,دان تشو تركني
Dialogue: 0,0:51:25.14,0:51:27.44,التعليق الصوتي,,0,0,0,,هل هذا أنت حقًا؟
Dialogue: 0,0:51:32.15,0:51:34.24,خط مائل,,0,0,0,,- البدء\N- نعم
Dialogue: 0,0:52:00.55,0:52:03.22,مائل,,0,0,0,,أمسك تشونبوغوان بـ ناك سو، لكن سحرة غابة الصنوبر لم يتمكنوا من ذلك؟
Dialogue: 0,0:52:03.31,0:52:05.68,خط مائل,,0,0,0,,لقد أذلت سوسنوفي بور
Dialogue: 0,0:52:05.77,0:52:09.19,مائل,,0,0,0,,هناك نائب في غوانغجو
Dialogue: 0,0:52:09.27,0:52:10.23,خط مائل,,0,0,0,,بالضبط
Dialogue: 0,0:52:26.41,0:52:28.42,التعليق الصوتي,,0,0,0,,إذن دان تشو هو جين مو،
Dialogue: 0,0:52:28.50,0:52:32.17,خلف الكواليس,,0,0,0,,غوانغجو نائب رويال جيونبوغوان
Dialogue: 0,0:52:44.47,0:52:46.31,التعليق الصوتي,,0,0,0,,أنا أحترق
Dialogue: 0,0:52:47.81,0:52:52.15,خلف الكواليس,,0,0,0,,تمامًا مثلما احترق منزلي ووالداي في ذلك اليوم
Dialogue: 0,0:52:58.45,0:53:00.24,ذكريات,,0,0,0,,سأعطيك القوة
Dialogue: 0,0:53:00.32,0:53:02.03,ذكريات,,0,0,0,,هل ستأتي معي؟
Dialogue: 0,0:53:40.20,0:53:41.41,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:53:42.36,0:53:44.95,النص العام,,0,0,0,,كما ترون، لا أستطيع فعل أي شيء،
Dialogue: 0,0:53:45.74,0:53:47.91,نص عام,,0,0,0,,فقط شاهد جسدي يحترق
Dialogue: 0,0:53:49.75,0:53:51.71,نص عام,,0,0,0,,لا أستطيع مساعدتك أيضًا
Dialogue: 0,0:53:59.01,0:54:00.34,نص عام,,0,0,0,,لقد وجدت سيفك
Dialogue: 0,0:54:07.85,0:54:10.18,general text,,0,0,0,,قلت إن بإمكانك استعادة قوتك إذا حصلت على سيفك.
Dialogue: 0,0:54:17.19,0:54:20.24,نص عام,,0,0,0,,لماذا أنت مستيقظ؟ هيا، حاول أن تخلعه
Dialogue: 0,0:54:38.17,0:54:40.71,general text,,0,0,0,,السيف المنقطع النظير يتعرف على صاحبه
Dialogue: 0,0:54:50.85,0:54:53.56,النص العام,,0,0,0,,الآن أنا بحاجة لقبول طاقته
Dialogue: 0,0:55:30.14,0:55:32.39,مائل,,0,0,0,,أنت أضعف من أن تتحمل
Dialogue: 0,0:55:33.48,0:55:34.94,خط مائل,,0,0,0,,سيفك
Dialogue: 0,0:55:37.31,0:55:39.15,النص العام,,0,0,0,,أنت عاجز مثلي
Dialogue: 0,0:55:40.15,0:55:41.44,نص عام,,0,0,0,,نحن عديمو الفائدة
Dialogue: 0,0:55:46.74,0:55:49.28,نص عام,,0,0,0,,كفى انسى الأمر
Dialogue: 0,0:55:49.99,0:55:51.12,نص عام,,0,0,0,,ابتعد
Dialogue: 0,0:55:56.83,0:56:00.67,general text,,0,0,0,,أشك في أنك تشكل تهديدًا لسوسنوفي بور، وأن ناك سو قد مات بالفعل
Dialogue: 0,0:56:02.00,0:56:04.13,نص عام,,0,0,0,,عيش مثل مو دوك
Dialogue: 0,0:56:09.01,0:56:10.68,نص عام,,0,0,0,,أفضل أن أموت،
Dialogue: 0,0:56:14.85,0:56:16.27,نص عام,,0,0,0,,كيف سأعيش هكذا
Dialogue: 0,0:56:18.81,0:56:20.48,النص العام,,0,0,0,,ثم مت!
Dialogue: 0,0:57:12.66,0:57:14.62,ذكريات,,0,0,0,,هذا قبر البدو الذين يبتلعون أرواحهم
Dialogue: 0,0:57:15.70,0:57:18.21,ذكريات بخط مائل,,0,0,0,,الشخص الذي علمني هذه التعويذة،
Dialogue: 0,0:57:18.29,0:57:20.83,ذكريات بخط مائل,,0,0,0,,التخلص من الجثث هنا
Dialogue: 0,0:57:31.76,0:57:32.89,نص عام,,0,0,0,,فسوف يصبح
Dialogue: 0,0:57:34.30,0:57:36.14,نص عام,,0,0,0,,وقبري أيضاً
Dialogue: 0,0:58:03.88,0:58:07.59,مائل,,0,0,0,,سيدي، متى يمكننا فتح هذا المكان؟
Dialogue: 0,0:58:08.96,0:58:10.30,نص عام,,0,0,0,,لقد انتهيت بالفعل
Dialogue: 0,0:58:10.97,0:58:12.68,general text,,0,0,0,,ماذا حدث لمو ديوك؟
Dialogue: 0,0:58:12.76,0:58:14.43,نص عام,,0,0,0,,يبدو أنها ضائعة
Dialogue: 0,0:58:18.64,0:58:19.89,خط مائل,,0,0,0,,أنا فقط قلقة
Dialogue: 0,0:58:20.81,0:58:23.10,النص العام,,0,0,0,,ذهبت إلى بحيرة جيونج تشونج دايهو
Dialogue: 0,0:58:25.86,0:58:27.02,النص العام,,0,0,0,,بحيرة جيونج تشيونج دايهو؟
Dialogue: 0,0:58:30.32,0:58:31.99,ذكريات,,0,0,0,,أفضل أن أموت،
Dialogue: 0,0:58:33.78,0:58:34.99,ذكريات,,0,0,0,,كيف سأعيش هكذا
Dialogue: 0,0:58:35.07,0:58:36.53,ذكريات,,0,0,0,,ثم مت!
Dialogue: 0,0:59:50.19,0:59:51.32,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:59:52.28,0:59:53.36,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,1:00:57.38,1:01:00.84,نقوش,,0,0,0,,سيجوكون، غابة الصنوبر
Dialogue: 0,1:01:11.31,1:01:12.77,نص عام,,0,0,0,,أنت في سيجوكون
Dialogue: 0,1:01:13.73,1:01:15.53,نص عام,,0,0,0,,في مستشفى المعلم هو يوم في سوسنوفي بور
Dialogue: 0,1:01:16.65,1:01:19.61,نص عام,,0,0,0,,لم يُسمح لي بالدخول إلى هنا إلا بسببك
Dialogue: 0,1:01:22.32,1:01:25.70,نص عام,,0,0,0,,هل تؤلمك عيناك؟ أعطيتك قطرات
Dialogue: 0,1:01:26.58,1:01:29.54,مائل,,0,0,0,,قال إن البقع الزرقاء في عينيك مثل الكدمات
Dialogue: 0,1:01:29.62,1:01:32.17,النص العام,,0,0,0,,هذه القطرات ستفتح لونها
Dialogue: 0,1:01:32.79,1:01:33.88,نص عام,,0,0,0,,اقطرهم باستمرار
Dialogue: 0,1:01:41.76,1:01:43.39,نص عام,,0,0,0,,لقد استل سيفي
Dialogue: 0,1:01:45.14,1:01:46.26,نص عام,,0,0,0,,لقد فعلتها حقًا
Dialogue: 0,1:01:46.35,1:01:47.85,نص عام,,0,0,0,,أعلم، رأيت
Dialogue: 0,1:01:48.60,1:01:50.39,مائل,,0,0,0,,لكنك لا تزال ضعيفًا
Dialogue: 0,1:01:50.48,1:01:52.73,general text,,0,0,0,,لم تنجح إلا بفضل طاقة البحيرة
Dialogue: 0,1:01:54.11,1:01:56.15,نص عام,,0,0,0,,لقد عادت قوتي عندما كنت في البحيرة
Dialogue: 0,1:01:57.78,1:01:59.07,نص عام,,0,0,0,,يجب أن أعود إلى هناك
Dialogue: 0,1:01:59.15,1:02:02.61,نص عام,,0,0,0,,و؟ هل ستعيش تحت الماء مثل السمكة؟
Dialogue: 0,1:02:08.08,1:02:11.21,مائل,,0,0,0,,شعرت بموجة من الطاقة تحت الماء
Dialogue: 0,1:02:11.29,1:02:12.92,مائل,,0,0,0,,لذلك استعدت قوتي
Dialogue: 0,1:02:13.50,1:02:14.67,نص عام,,0,0,0,,هذا هو
Dialogue: 0,1:02:15.75,1:02:18.21,general text,,0,0,0,,رجل لديه نفس الطاقة القوية مثل البحيرة،
Dialogue: 0,1:02:18.88,1:02:21.63,نص عام,,0,0,0,,يجب أن يوقظ الطاقة بداخلي
Dialogue: 0,1:02:21.72,1:02:24.55,نص عام,,0,0,0,,ومن هذا؟ هل ستبحث أيضًا عن مدرس؟
Dialogue: 0,1:02:25.22,1:02:28.39,مائل,,0,0,0,,هل تعتقد أن هناك شخصًا بهذه القوة؟
Dialogue: 0,1:02:28.47,1:02:31.44,general text,,0,0,0,,حتى لو كان هناك هل يريد مساعدتك؟
Dialogue: 0,1:02:32.60,1:02:34.27,general text,,0,0,0,,أنت ناك سو، المرتزق الذي يتجول من جسد إلى جسد
Dialogue: 0,1:02:37.77,1:02:38.69,خط مائل,,0,0,0,,ماذا؟
Dialogue: 0,1:02:38.78,1:02:41.36,نص عام,,0,0,0,,ووك في سيجوكون؟
Dialogue: 0,1:02:41.95,1:02:44.11,نص عام,,0,0,0,,جاء ليُظهر الخادمة الجريحة
Dialogue: 0,1:02:44.20,1:02:45.87,نص عام,,0,0,0,,لقد اقتحمنا
Dialogue: 0,1:02:45.95,1:02:47.08,نص عام,,0,0,0,,خادم؟
Dialogue: 0,1:02:48.49,1:02:49.91,نص عام,,0,0,0,,أعتقد مو دوك؟
Dialogue: 0,1:02:50.00,1:02:51.46,نص عام,,0,0,0,,كم تأذيت بشدة،
Dialogue: 0,1:02:52.00,1:02:54.92,نص عام,,0,0,0,,هل كان عليه أن يأتي إلى هنا بنفسه؟
Dialogue: 0,1:03:11.06,1:03:13.19,نص عام,,0,0,0,,سمعت للتو عن سايجوكون
Dialogue: 0,1:03:14.02,1:03:15.65,نص عام,,0,0,0,,مستشفى رائع حقًا
Dialogue: 0,1:03:16.81,1:03:18.65,نص عام,,0,0,0,,مليء بالأعشاب الطبية
Dialogue: 0,1:03:19.27,1:03:20.69,نص عام,,0,0,0,,مثل السموم
Dialogue: 0,1:03:26.45,1:03:30.20,مائل,,0,0,0,,هذه القطرات ستجعل لون عينك طبيعياً
Dialogue: 0,1:03:30.29,1:03:31.83,النص العام,,0,0,0,,استلق وعش مثل مو دوك
Dialogue: 0,1:03:32.70,1:03:34.21,نص عام,,0,0,0,,هذا كل ما يمكنني فعله من أجلك
Dialogue: 0,1:03:34.29,1:03:35.58,نص عام,,0,0,0,,أنت مخطئ
Dialogue: 0,1:03:36.75,1:03:39.29,نص عام,,0,0,0,,أريدك أن تصبح بحيرة جيونج تشونج دايهو الخاصة بي
Dialogue: 0,1:03:42.71,1:03:45.38,general text,,0,0,0,,قلت أنك خاطرت بحياتك أكثر من مرة بسببي
Dialogue: 0,1:03:46.64,1:03:48.35,نص عام,,0,0,0,,قم بمخاطرة أخرى
Dialogue: 0,1:03:54.81,1:03:56.10,نص عام,,0,0,0,,هذا سيؤلمك
Dialogue: 0,1:04:03.49,1:04:04.86,نص عام,,0,0,0,,ماذا أضفت هنا؟
Dialogue: 0,1:04:07.20,1:04:09.20,نص عام,,0,0,0,,نبات واحد سام
Dialogue: 0,1:04:16.00,1:04:17.79,نص عام,,0,0,0,,أراهنك بكل شيء
Dialogue: 0,1:04:19.88,1:04:22.84,نص عام,,0,0,0,,أتمنى لك البقاء على قيد الحياة
Dialogue: 0,1:04:39.31,1:04:40.61,نص عام,,0,0,0,,إذا استطعت،
Dialogue: 0,1:04:43.94,1:04:45.90,نص عام,,0,0,0,,سأصبح معلمك
Dialogue: 0,1:04:55.75,1:04:57.37,خط مائل,,0,0,0,,المملكة المتحدة!
Dialogue: 0,1:04:58.33,1:05:00.38,نص عام,,0,0,0,,ما هذا؟ المملكة المتحدة
Dialogue: 0,1:05:00.46,1:05:01.54,نص عام,,0,0,0,,المملكة المتحدة!
Dialogue: 0,1:05:01.63,1:05:02.92,مائل,,0,0,0,,ماذا حدث له؟
Dialogue: 0,1:05:03.55,1:05:04.67,نص عام,,0,0,0,,شرب السم
Dialogue: 0,1:05:06.38,1:05:07.88,النص العام,,0,0,0,,- السم؟{\i1}\N- أيهما؟
Dialogue: 0,1:05:07.97,1:05:11.51,النص العام,,0,0,0,,سيتوقف قلبه خلال ست ساعات
Dialogue: 0,1:05:11.60,1:05:12.76,general text,,0,0,0,,أي نوع من السم هذا؟
Dialogue: 0,1:05:12.85,1:05:15.27,مائل,,0,0,0,,حتى تفهم وتحضر الترياق،
Dialogue: 0,1:05:15.35,1:05:17.10,نص عام,,0,0,0,,سيكون الأوان قد فات
Dialogue: 0,1:05:17.18,1:05:19.73,general text,,0,0,0,,هناك طريقة واحدة فقط لإنقاذه
Dialogue: 0,1:05:19.81,1:05:21.15,نص عام,,0,0,0,,افتح أبواب طاقته
Dialogue: 0,1:05:21.23,1:05:24.82,نص عام,,0,0,0,,وتخلص من السم بنفسك
Dialogue: 0,1:05:24.90,1:05:26.11,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:05:27.61,1:05:29.28,نص عام,,0,0,0,,افتح أبواب طاقته
Dialogue: 0,1:05:29.90,1:05:31.49,النص العام,,0,0,0,,وإلا سيموت
Dialogue: 0,1:05:35.16,1:05:36.95,نص عام,,0,0,0,,يوليو...
Dialogue: 0,1:05:37.70,1:05:39.46,النص العام,,0,0,0,,المملكة المتحدة شربت السم
Dialogue: 0,1:05:40.29,1:05:41.54,نص عام,,0,0,0,,يقولون أنه سيموت
Dialogue: 0,1:05:41.63,1:05:44.46,general text,,0,0,0,,- ماذا؟\N- مو دوك أعطاه السم
Dialogue: 0,1:05:44.54,1:05:46.92,نص عام,,0,0,0,,لكنها لا تقول أيهما،
Dialogue: 0,1:05:47.01,1:05:49.80,general text,,0,0,0,,فعمها يعذبها الآن
Dialogue: 0,1:05:55.47,1:05:57.06,general text,,0,0,0,,أي نوع من السم هذا؟
Dialogue: 0,1:06:01.39,1:06:03.15,نص عام,,0,0,0,,تابع
Dialogue: 0,1:06:03.23,1:06:05.61,general text,,0,0,0,,- ربما تموت\N- المملكة المتحدة تحتضر الآن
Dialogue: 0,1:06:06.36,1:06:10.03,نص عام,,0,0,0,,يجب أن نعرف اسم السم خلال ساعتين
Dialogue: 0,1:06:16.45,1:06:17.54,خط مائل,,0,0,0,,سيد.
Dialogue: 0,1:06:18.37,1:06:19.50,نص عام,,0,0,0,,سيد...
Dialogue: 0,1:06:21.58,1:06:22.79,نص عام,,0,0,0,,افتح البوابة
Dialogue: 0,1:06:24.00,1:06:25.88,نص عام,,0,0,0,,هذه هي الطريقة الوحيدة
Dialogue: 0,1:06:28.34,1:06:29.76,نص عام,,0,0,0,,ليس لدينا وقت!
Dialogue: 0,1:06:30.38,1:06:31.51,نص عام,,0,0,0,,سيد...
Dialogue: 0,1:06:32.51,1:06:34.59,نص عام,,0,0,0,,من فضلك احفظ سيدنا!
Dialogue: 0,1:06:49.32,1:06:50.78,نص عام,,0,0,0,,- سيد\N- كيف حال المملكة المتحدة؟
Dialogue: 0,1:06:50.86,1:06:52.49,نص عام,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,1:06:52.57,1:06:54.49,النص العام,,0,0,0,,أزال ماستيو هو يوم السم
Dialogue: 0,1:06:55.12,1:06:56.62,خط مائل,,0,0,0,,سيد. تشان آمن
Dialogue: 0,1:06:57.20,1:06:59.79,general text,,0,0,0,,- هل أعد الترياق؟{\i1}\N- لا
Dialogue: 0,1:07:00.54,1:07:03.62,نص عام,,0,0,0,,فتح أبواب طاقته
Dialogue: 0,1:07:29.19,1:07:31.99,general text,,0,0,0,,سيدي، هل أنت مستيقظ؟
Dialogue: 0,1:07:44.12,1:07:46.04,نص عام,,0,0,0,,هل أنا حي أم ميت؟
Dialogue: 0,1:07:47.29,1:07:49.00,نص عام,,0,0,0,,بالكاد نجوت
Dialogue: 0,1:07:49.09,1:07:50.63,النص العام,,0,0,0,,السيد هو يوم أنقذك،
Dialogue: 0,1:07:51.76,1:07:54.01,نص عام,,0,0,0,,فتح أبواب الطاقة
Dialogue: 0,1:07:56.43,1:07:58.09,نص عام,,0,0,0,,هل فتحهم؟
Dialogue: 0,1:07:58.18,1:07:59.64,نص عام,,0,0,0,,ذلك المجنون مو دوك
Dialogue: 0,1:08:00.35,1:08:03.35,نص عام,,0,0,0,,لم تقل ما السم الذي أعطيتك إياه
Dialogue: 0,1:08:03.43,1:08:07.23,نص عام,,0,0,0,,فلم يكن لديه خيار آخر
Dialogue: 0,1:08:11.32,1:08:13.57,ذكريات,,0,0,0,,أراهنك بكل شيء
Dialogue: 0,1:08:14.19,1:08:17.36,ذكريات,,0,0,0,,أتمنى لك البقاء على قيد الحياة
Dialogue: 0,1:08:20.37,1:08:21.79,النص العام,,0,0,0,,أين مو دوك؟
Dialogue: 0,1:08:40.80,1:08:41.93,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,1:08:48.60,1:08:49.85,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,1:09:00.41,1:09:01.37,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:09:04.87,1:09:06.04,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:09:10.54,1:09:11.63,خط مائل,,0,0,0,,مو دوك
Dialogue: 0,1:09:26.22,1:09:27.93,النص العام,,0,0,0,,كان من الممكن أن نموت كلانا
Dialogue: 0,1:09:28.81,1:09:29.94,نص عام,,0,0,0,,أنت...
Dialogue: 0,1:09:31.27,1:09:32.61,نص عام,,0,0,0,,الحقيقة مجنونة
Dialogue: 0,1:09:35.78,1:09:37.28,نص عام,,0,0,0,,هكذا نجوت،
Dialogue: 0,1:09:39.03,1:09:40.41,نص عام,,0,0,0,,يا طالبتي
Dialogue: 0,1:09:46.70,1:09:47.95,نص عام,,0,0,0,,نعم
Dialogue: 0,1:09:49.87,1:09:51.67,نص عام,,0,0,0,,كدت أموت بفضلك،
Dialogue: 0,1:09:58.21,1:09:59.97,نص عام,,0,0,0,,أستاذتي المجنونة
Dialogue: 0,1:11:10.91,1:11:15.04,preview,,0,0,0,,ونتيجة لذلك، فتحت المملكة المتحدة أبواب طاقته
Dialogue: 0,1:11:15.12,1:11:18.92,preview,,0,0,0,,بما أنني نجوت كما وعدت، سأعاملك كمعلمتي.
Dialogue: 0,1:11:19.00,1:11:22.59,preview,,0,0,0,,لكي تصبح أفضل ساحر، يجب أن تمر بعدة مراحل
Dialogue: 0,1:11:22.67,1:11:25.05,preview,,0,0,0,,أنت أسوأ مما تخيلت
Dialogue: 0,1:11:25.13,1:11:26.39,معاينة,,0,0,0,,نظرنا إلى يوليا
Dialogue: 0,1:11:26.47,1:11:27.76,معاينة,,0,0,0,,طلب مني مو دوك الحضور
Dialogue: 0,1:11:27.85,1:11:29.51,معاينة,,0,0,0,,هذه الفتاة مو دوك...
Dialogue: 0,1:11:29.60,1:11:31.81,معاينة,,0,0,0,,يبدو أنها تخفي شيئًا ما
Dialogue: 0,1:11:31.89,1:11:33.64,معاينة,,0,0,0,,أحبك!
Dialogue: 0,1:11:33.73,1:11:37.73,معاينة,,0,0,0,,سيدي، لقد جاء ولي العهد لرؤيتك
Dialogue: 0,1:11:37.81,1:11:40.02,preview,,0,0,0,,هناك سيف آخر هنا لا يمكنك سحبه
Dialogue: 0,1:11:40.11,1:11:42.44,preview,,0,0,0,,لا يبشر بالخير بالنسبة لي إذا فقدت هذا السيف أيضًا
Dialogue: 0,1:11:42.53,1:11:43.36,معاينة,,0,0,0,,ليس هناك ما يمكن فعله
Dialogue: 0,1:11:43.44,1:11:45.36,معاينة,,0,0,0,,من يفوز يأخذ السيف
Dialogue: 0,1:11:04.76,1:11:06.76,العنوان,,0,0,0,,

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
