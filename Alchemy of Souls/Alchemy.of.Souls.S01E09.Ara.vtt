Dialogue: 0,0:00:59.26,0:01:01.42,النص العام,,0,0,0,,هذه ملابس سحرة جيونجينغاك
Dialogue: 0,0:01:01.92,0:01:04.51,general text,,0,0,0,,سوف تزيد من كرامتك كساحر جيونجينغاك
Dialogue: 0,0:01:05.47,0:01:07.72,مائل,,0,0,0,,كن ناجحًا في تعلم التعويذات
Dialogue: 0,0:01:14.52,0:01:17.23,نص عام,,0,0,0,,هذه تميمة سحرة جيونجينغاك
Dialogue: 0,0:01:18.11,0:01:19.78,نص عام,,0,0,0,,يمنح الحق
Dialogue: 0,0:01:19.86,0:01:23.32,نص عام,,0,0,0,,خطوة إلى كل مكان في غابة الصنوبر وجيونجينجاك
Dialogue: 0,0:01:29.37,0:01:31.08,خط مائل,,0,0,0,,هذه مجموعة من القواعد
Dialogue: 0,0:01:31.58,0:01:33.00,نص عام,,0,0,0,,سوف تتبعه
Dialogue: 0,0:01:33.58,0:01:37.50,general text,,0,0,0,,وإذا خالفت القواعد ستعاقب وفقًا لذلك
Dialogue: 0,0:01:39.46,0:01:42.13,النص العام,,0,0,0,,تشان ووك، قف وانحني للرأس
Dialogue: 0,0:02:05.61,0:02:06.70,نص عام,,0,0,0,,شان ووك، استدر
Dialogue: 0,0:02:06.78,0:02:09.62,نص عام,,0,0,0,,وانحني لبقية السحرة
Dialogue: 0,0:02:31.22,0:02:35.02,general text,,0,0,0,,من الآن فصاعدا، تشان ووك، الابن الأكبر لعائلة تشان،
Dialogue: 0,0:02:35.73,0:02:38.31,نص عام,,0,0,0,,ساحر جيونجينغاك
Dialogue: 0,0:03:08.09,0:03:09.80,نص عام,,0,0,0,,مرحبًا تشان ووك
Dialogue: 0,0:03:09.89,0:03:11.76,نص عام,,0,0,0,,- تهانينا\N- تهانينا!
Dialogue: 0,0:03:11.85,0:03:14.77,النص العام,,0,0,0,,- لقد قطعت شوطاً طويلاً\N- إذن، إذن، يا رفاق
Dialogue: 0,0:03:16.60,0:03:21.77,general text,,0,0,0,,اليوم سننظم عطلة على شرف ساحرنا الجديد - تشان ووك
Dialogue: 0,0:03:21.86,0:03:24.48,نص عام,,0,0,0,,نحن ننتظر الجميع في تشويسونغرو
Dialogue: 0,0:03:25.65,0:03:27.28,النص العام,,0,0,0,,لقد دفعت عائلة تشان بالفعل
Dialogue: 0,0:03:27.36,0:03:30.82,نص عام,,0,0,0,,الأطعمة والمشروبات في تشويسيونرو
Dialogue: 0,0:03:30.91,0:03:32.53,نص عام,,0,0,0,,لذلك
Dialogue: 0,0:03:33.91,0:03:35.95,نص عام,,0,0,0,,يجب على الجميع أن يشربوا حتى يسقطوا
Dialogue: 0,0:03:42.88,0:03:44.09,نص عام,,0,0,0,,تشويسونرو!
Dialogue: 0,0:03:44.17,0:03:46.84,النص العام,,0,0,0,,- تشويسونغرو!\N- تشان ووك!
Dialogue: 0,0:03:46.92,0:03:51.51,النص العام,,0,0,0,,أتذكر كيف أتى تشانغ غان إلى هنا مع تشان ووك الصغير. يبدو الأمر كما لو كان بالأمس
Dialogue: 0,0:03:51.59,0:03:53.22,نص عام,,0,0,0,,لا أصدق أن هذا اليوم قد أتى
Dialogue: 0,0:03:55.10,0:03:57.64,نص عام,,0,0,0,,لا أصدق ذلك بنفسي
Dialogue: 0,0:04:00.10,0:04:01.15,نص عام,,0,0,0,,هنا
Dialogue: 0,0:04:02.15,0:04:02.98,نص عام,,0,0,0,,تناول الطعام
Dialogue: 0,0:04:05.57,0:04:06.57,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:04:06.65,0:04:08.28,نص عام,,0,0,0,,حبة جوفينيوم
Dialogue: 0,0:04:08.36,0:04:10.28,نص عام,,0,0,0,,كل قبل أن تشرب
Dialogue: 0,0:04:10.36,0:04:12.61,نص عام,,0,0,0,,سيشرب الأطفال حتى آخر لحظة
Dialogue: 0,0:04:12.70,0:04:14.91,النص العام,,0,0,0,,علينا على الأقل أن نحاول مواكبتهم
Dialogue: 0,0:04:16.16,0:04:18.50,نص عام,,0,0,0,,لن أسكر بدون هذا
Dialogue: 0,0:04:18.58,0:04:20.71,نص عام,,0,0,0,,يجب أن أفكر في عمري
Dialogue: 0,0:04:22.08,0:04:23.50,نص عام,,0,0,0,,ماذا عن عمري؟
Dialogue: 0,0:04:23.58,0:04:25.88,نص عام,,0,0,0,,إذن هناك أقفال رمادية
Dialogue: 0,0:04:27.38,0:04:29.05,نص عام,,0,0,0,,يبدو لك بسبب ضوء الشمس
Dialogue: 0,0:04:29.13,0:04:30.34,نص عام,,0,0,0,,أنظر إليه
Dialogue: 0,0:04:30.42,0:04:33.64,النص العام,,0,0,0,,انظروا كم هو حريري شعري
Dialogue: 0,0:04:34.97,0:04:36.47,نص عام,,0,0,0,,جميل جدًا
Dialogue: 0,0:04:41.77,0:04:43.44,نص عام,,0,0,0,,سأحتفظ بهذا لنفسي
Dialogue: 0,0:04:43.52,0:04:44.86,نص عام,,0,0,0,,نعم خذها
Dialogue: 0,0:05:04.17,0:05:05.25,نص عام,,0,0,0,,الآنسة دو هوا,
Dialogue: 0,0:05:06.38,0:05:07.75,نص عام,,0,0,0,,السيد الشاب
Dialogue: 0,0:05:08.71,0:05:13.43,general text,,0,0,0,,أصبح ساحر جيونججينجاك مثل والده
Dialogue: 0,0:05:15.84,0:05:17.43,خط مائل,,0,0,0,,هل أنت سعيد؟
Dialogue: 0,0:05:37.41,0:05:38.99,خلف الكواليس,,0,0,0,,لقد قمت بعمل رائع
Dialogue: 0,0:05:40.20,0:05:41.58,خلف الكواليس,,0,0,0,,منذ أن التقينا
Dialogue: 0,0:05:48.71,0:05:50.21,ذكريات بخط مائل,,0,0,0,,فهمت من النظرة الأولى
Dialogue: 0,0:05:52.09,0:05:53.51,ذكريات,,0,0,0,,أنت سيدي،
Dialogue: 0,0:05:54.17,0:05:55.38,ذكريات,,0,0,0,,ناك سو
Dialogue: 0,0:05:55.47,0:05:56.97,الذكريات,,0,0,0,,أريدك أن تصبح معلمتي
Dialogue: 0,0:05:57.05,0:05:58.93,ذكريات,,0,0,0,,ما هذا الهراء؟
Dialogue: 0,0:05:59.01,0:06:00.76,ذكريات,,0,0,0,,إذا نجوت،
Dialogue: 0,0:06:00.85,0:06:02.68,ذكريات,,0,0,0,,سأصبح سيدك
Dialogue: 0,0:06:03.81,0:06:04.89,ذكريات,,0,0,0,,يا معلمة
Dialogue: 0,0:06:04.98,0:06:06.27,ذكريات,,0,0,0,,لقد فهمت أخيرًا
Dialogue: 0,0:06:42.18,0:06:43.39,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:06:43.97,0:06:46.31,نص عام,,0,0,0,,فكيف؟ هل يناسبني؟
Dialogue: 0,0:06:46.89,0:06:50.27,نص عام,,0,0,0,,كيف أقول... كيف يجب أن أعرف؟
Dialogue: 0,0:06:51.94,0:06:54.82,نص عام,,0,0,0,,يا معلم، كيف يبدو تلميذك؟
Dialogue: 0,0:06:56.78,0:07:00.16,النص العام,,0,0,0,,هذه الملابس تناسب So Yulyu وPark Dan Gu،
Dialogue: 0,0:07:02.83,0:07:05.04,نص عام,,0,0,0,,ولكن على طالبي يبدو الأمر مثاليًا
Dialogue: 0,0:07:12.13,0:07:13.25,نص عام,,0,0,0,,كفى
Dialogue: 0,0:07:14.42,0:07:15.71,نص عام,,0,0,0,,لا أستطيع التنفس
Dialogue: 0,0:07:16.72,0:07:17.76,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,0:07:18.93,0:07:19.93,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:07:25.06,0:07:27.98,نص عام,,0,0,0,,حسنًا مو دوك. دعنا نذهب لتناول مشروب
Dialogue: 0,0:07:32.02,0:07:34.23,نص عام,,0,0,0,,تشان ووك، انتظر
Dialogue: 0,0:07:34.86,0:07:37.78,النص العام,,0,0,0,,- تشان ووك...\N- تبدو جميلاً يا سيد
Dialogue: 0,0:07:38.82,0:07:39.66,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:07:41.57,0:07:43.03,نص عام,,0,0,0,,أقبل هذا
Dialogue: 0,0:07:44.08,0:07:46.04,نص عام,,0,0,0,,لقد أعطاك السيد هيو حبة غوفينيا
Dialogue: 0,0:07:48.12,0:07:49.41,نص عام,,0,0,0,,آه ، جوفانيا؟
Dialogue: 0,0:07:49.50,0:07:51.33,نص عام,,0,0,0,,يجب التقسيم
Dialogue: 0,0:07:53.71,0:07:55.92,نص عام,,0,0,0,,إنه مثالي لمخلفات الكحول
Dialogue: 0,0:08:06.93,0:08:08.35,نص عام,,0,0,0,,هنا أيتها الخادمة كيم
Dialogue: 0,0:08:09.73,0:08:10.89,نص عام,,0,0,0,,عذراء كيم
Dialogue: 0,0:08:10.98,0:08:13.52,نص عام,,0,0,0,,كنت سأعطيك إياه. صحيح
Dialogue: 0,0:08:13.61,0:08:16.94,نص عام,,0,0,0,,عذراء كيم، عودي. خذها. حسنا حقا
Dialogue: 0,0:08:17.03,0:08:18.94,نص عام,,0,0,0,,عذراء كيم من فضلك
Dialogue: 0,0:08:25.91,0:08:30.00,النص العام,,0,0,0,,ولد تحت نجم الملك دخل سوسنوفي بور
Dialogue: 0,0:08:30.58,0:08:33.79,general text,,0,0,0,,استخدم والده حجر الجليد لإلقاء التعويذات.
Dialogue: 0,0:08:34.75,0:08:37.09,general text,,0,0,0,,ولادة تشان ووك هي نتيجة هذا السحر
Dialogue: 0,0:08:37.17,0:08:39.88,general text,,0,0,0,,هذا الطفل كارثة على سوسنوفي بور
Dialogue: 0,0:08:39.97,0:08:42.26,general text,,0,0,0,,لماذا تعتقد أن "تشانغ جانج" فعل هذا؟
Dialogue: 0,0:08:42.76,0:08:45.35,general text,,0,0,0,,يمكنه أن يجعل ابنه ملكًا،
Dialogue: 0,0:08:45.43,0:08:49.98,النص العام,,0,0,0,,استخدم الحجر لامتلاك هوانسو. كان سيخضع العالم لنفسه
Dialogue: 0,0:08:50.06,0:08:52.56,النص العام,,0,0,0,,لماذا أغلق بوابة ابنه
Dialogue: 0,0:08:52.64,0:08:54.90,نص عام,,0,0,0,,وأخفى حجر الجليد؟
Dialogue: 0,0:08:56.06,0:08:57.90,نص عام,,0,0,0,,لأنني كنت ضعيفاً
Dialogue: 0,0:08:59.48,0:09:00.74,مائل,,0,0,0,,أغلق كل شيء وهرب،
Dialogue: 0,0:09:00.82,0:09:03.16,خط مائل,,0,0,0,,لأنه لم يستطع التعامل مع الأمر
Dialogue: 0,0:09:07.49,0:09:08.99,النص العام,,0,0,0,,هل تعتقد يا كيل جو
Dialogue: 0,0:09:09.95,0:09:11.71,النص العام,,0,0,0,,قتل تشانغ غان؟
Dialogue: 0,0:09:12.25,0:09:13.58,نص عام,,0,0,0,,لو عاد...
Dialogue: 0,0:09:13.67,0:09:17.42,general text,,0,0,0,,تشانغ غان لن يفعل شيئًا كهذا علنًا
Dialogue: 0,0:09:19.05,0:09:21.17,نص عام,,0,0,0,,أظن أن السيد لي
Dialogue: 0,0:09:21.84,0:09:25.05,general text,,0,0,0,,نحن بحاجة إلى اكتساب المزيد من القوة قبل أن تبدأ غابة الصنوبر في التسلق
Dialogue: 0,0:09:27.97,0:09:29.89,نص عام,,0,0,0,,قبل عشر سنوات نجحنا
Dialogue: 0,0:09:29.97,0:09:33.31,نص عام,,0,0,0,,حصلت على حجر مختوم من تشانغ غان
Dialogue: 0,0:09:47.07,0:09:48.99,ذكريات,,0,0,0,,لقد وجدته
Dialogue: 0,0:09:50.04,0:09:51.33,ذكريات,,0,0,0,,بو يونغ,
Dialogue: 0,0:09:51.41,0:09:53.12,ذكريات,,0,0,0,,أعطني حجر الجليد
Dialogue: 0,0:10:04.38,0:10:07.01,مائل,,0,0,0,,كانت صغيرة جدًا، لكنها تمكنت من العثور على الحجر
Dialogue: 0,0:10:07.59,0:10:10.47,italics,,0,0,0,,يجب أن نعترف بأن قواها كانت مذهلة حقًا
Dialogue: 0,0:10:13.48,0:10:16.60,general text,,0,0,0,,سمعت أن جين هو كيونغ لا يؤمن بوفاة ابنته
Dialogue: 0,0:10:16.69,0:10:18.36,النص العام,,0,0,0,,وما زال يبحث عنها
Dialogue: 0,0:10:19.02,0:10:20.61,نص عام,,0,0,0,,لذلك أريد أن أجدها
Dialogue: 0,0:10:22.57,0:10:24.90,general text,,0,0,0,,سوف أجد الابنة التي كانت تبحث عنها لفترة طويلة.
Dialogue: 0,0:10:24.99,0:10:28.49,النص العام,,0,0,0,,وسأجعل جين هو كيونغ دمية لي
Dialogue: 0,0:10:28.57,0:10:30.78,نص عام,,0,0,0,,كيف تجد فتاة ميتة؟
Dialogue: 0,0:10:32.08,0:10:33.95,نص عام,,0,0,0,,سأجد شخصًا ما
Dialogue: 0,0:10:34.45,0:10:37.75,general text,,0,0,0,,الشخص الذي جعل هو كيونغ يعتقد أنه بو يونغ
Dialogue: 0,0:10:56.23,0:10:57.52,نص عام,,0,0,0,,هنا. أكل
Dialogue: 0,0:11:03.11,0:11:06.11,general text,,0,0,0,,هل أكلت شيئاً منذ أن غادرت قرية ساري؟
Dialogue: 0,0:11:14.91,0:11:15.95,نص عام,,0,0,0,,هنا
Dialogue: 0,0:11:17.79,0:11:19.33,نص عام,,0,0,0,,تناول الطعام
Dialogue: 0,0:11:28.30,0:11:29.55,نص عام,,0,0,0,,خذ وقتك
Dialogue: 0,0:11:30.18,0:11:32.93,general text,,0,0,0,,لماذا تبحر هذه الفتاة العمياء وحدها إلى المدينة؟
Dialogue: 0,0:11:33.01,0:11:34.76,نص عام,,0,0,0,,إنها تبحث عن صديق
Dialogue: 0,0:11:35.43,0:11:38.73,النص العام,,0,0,0,,سرقت صديقتها كل أغراضها
Dialogue: 0,0:11:38.81,0:11:40.81,النص العام,,0,0,0,,وهرب إلى المدينة
Dialogue: 0,0:11:40.90,0:11:42.90,نص عام,,0,0,0,,الفتاة المسكينة
Dialogue: 0,0:11:43.48,0:11:46.61,نص عام,,0,0,0,,هل تعرف إلى أين تذهب؟ ما اسم صديقك؟
Dialogue: 0,0:11:48.61,0:11:49.82,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:11:50.45,0:11:54.08,نص عام,,0,0,0,,اسم صديقي مو دوك
Dialogue: 0,0:11:55.08,0:11:57.79,general text,,0,0,0,,- "مو دوك"؟\N- كيف ستجدها؟
Dialogue: 0,0:12:00.29,0:12:01.75,مائل,,0,0,0,,حلوى حلوة!
Dialogue: 0,0:12:01.83,0:12:04.29,مائل,,0,0,0,,- حلوى الحلوى!\N- جرب ملفات تعريف الارتباط لدينا!
Dialogue: 0,0:12:04.38,0:12:06.42,نص عام,,0,0,0,,تعالوا! يشتري!
Dialogue: 0,0:12:06.50,0:12:08.34,خط مائل,,0,0,0,,فطائر حلوة!
Dialogue: 0,0:12:08.42,0:12:11.68,نص عام,,0,0,0,,الطقس جميل، أليس كذلك؟
Dialogue: 0,0:12:11.76,0:12:13.89,نص عام,,0,0,0,,أمي، اشتري فطيرة
Dialogue: 0,0:12:13.97,0:12:15.68,نص عام,,0,0,0,,ليس لدي مال
Dialogue: 0,0:12:15.76,0:12:16.97,نص عام,,0,0,0,,أمي، اشتريه!
Dialogue: 0,0:12:17.06,0:12:18.35,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:12:18.43,0:12:20.14,نص عام,,0,0,0,,حسنًا، انتظر
Dialogue: 0,0:12:22.23,0:12:24.15,نص عام,,0,0,0,,أين هم؟
Dialogue: 0,0:12:24.23,0:12:26.61,general text,,0,0,0,,- أين أموالي؟\N- ما هي؟
Dialogue: 0,0:12:26.69,0:12:29.15,نص عام,,0,0,0,,ذهب المال
Dialogue: 0,0:12:29.82,0:12:32.11,النص العام,,0,0,0,,- ماذا أفعل؟\N- خاتمي...
Dialogue: 0,0:12:33.11,0:12:35.20,النص العام,,0,0,0,,- لقد فقدت الخاتم!\N- الجنة...
Dialogue: 0,0:13:05.56,0:13:06.90,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:13:08.40,0:13:10.74,نص عام,,0,0,0,,أهذا كل شيء؟
Dialogue: 0,0:13:13.91,0:13:15.74,نص عام,,0,0,0,,الخاتم رخيص أيضاً
Dialogue: 0,0:13:17.66,0:13:21.50,general text,,0,0,0,,صلبت نفسي هناك وكل هذا هباءً منثوراً
Dialogue: 0,0:14:26.48,0:14:28.31,النص العام,,0,0,0,,- شكرًا لك\N- اسكبها لي
Dialogue: 0,0:14:31.44,0:14:33.28,نص عام,,0,0,0,,- استمتع\N- شكرًا لك
Dialogue: 0,0:15:11.69,0:15:14.61,خلف الكواليس,,0,0,0,,كنت تعرف من أنا طوال هذا الوقت
Dialogue: 0,0:15:16.36,0:15:18.66,ذكريات بخط مائل,,0,0,0,,بدلاً من وجود صديق قريب لديك صفارة
Dialogue: 0,0:15:20.03,0:15:21.91,ذكريات بخط مائل,,0,0,0,,فتركك صديقك
Dialogue: 0,0:15:39.63,0:15:40.93,نص عام,,0,0,0,,سيدي. يول؟
Dialogue: 0,0:15:44.18,0:15:45.35,نص عام,,0,0,0,,آه، مو دوك
Dialogue: 0,0:15:46.14,0:15:48.35,نص عام,,0,0,0,,لماذا تجلس في الشارع؟
Dialogue: 0,0:15:48.44,0:15:50.15,نص عام,,0,0,0,,ألا تشرب؟
Dialogue: 0,0:15:52.02,0:15:54.69,نص عام,,0,0,0,,لا. لقد كان لدي ما يكفي
Dialogue: 0,0:15:56.11,0:15:57.19,نص عام,,0,0,0,,أنا بالفعل ثمل
Dialogue: 0,0:15:58.28,0:16:00.24,نص عام,,0,0,0,,وأنت تبدو جيدًا
Dialogue: 0,0:16:01.49,0:16:02.78,نص عام,,0,0,0,,أنا سكران,
Dialogue: 0,0:16:03.74,0:16:05.41,نص عام,,0,0,0,,فتاهت
Dialogue: 0,0:16:08.87,0:16:11.42,النص العام,,0,0,0,,أضيع بسرعة إذا كان رأسي ضبابيًا
Dialogue: 0,0:16:13.63,0:16:17.01,نص عام,,0,0,0,,كيف يمكن أن تضيع هنا؟
Dialogue: 0,0:16:20.43,0:16:23.09,نص عام,,0,0,0,,انهض، سآخذك إلى المنزل
Dialogue: 0,0:16:25.51,0:16:26.76,نص عام,,0,0,0,,لقد تأذيت
Dialogue: 0,0:16:27.72,0:16:29.35,نص عام,,0,0,0,,هذا أمر خطير
Dialogue: 0,0:16:29.43,0:16:32.77,النص العام,,0,0,0,,هل توبخني مرة أخرى؟ ربما ليس اليوم؟
Dialogue: 0,0:16:34.77,0:16:36.44,نص عام,,0,0,0,,ليس من حقي أن أوبخك
Dialogue: 0,0:16:37.44,0:16:39.61,نص عام,,0,0,0,,لقد أخطأت بنفسي
Dialogue: 0,0:16:40.95,0:16:42.16,نص عام,,0,0,0,,هل أنت؟
Dialogue: 0,0:16:43.20,0:16:44.16,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:45.74,0:16:49.08,general text,,0,0,0,,لقد فعلت الشيء الصحيح دائمًا. لم يضل
Dialogue: 0,0:16:52.79,0:16:55.96,نص عام,,0,0,0,,لكنني تائه
Dialogue: 0,0:17:00.42,0:17:01.97,نص عام,,0,0,0,,والآن أنا أمسك بيدك
Dialogue: 0,0:17:07.06,0:17:09.22,النص العام,,0,0,0,,لا أعلم إلى أين سيقودني طريقي
Dialogue: 0,0:17:14.60,0:17:16.31,النص العام,,0,0,0,,سيقودك ورائي
Dialogue: 0,0:17:35.33,0:17:36.58,نص عام,,0,0,0,,أنت تمسك بيدي
Dialogue: 0,0:17:38.67,0:17:39.84,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:17:42.92,0:17:46.22,النص العام,,0,0,0,,تضيع عندما يكون رأسك ضبابيًا
Dialogue: 0,0:17:46.30,0:17:48.43,نص عام,,0,0,0,,كل هذا لأنك تفكر كثيرًا
Dialogue: 0,0:17:49.47,0:17:51.89,النص العام,,0,0,0,,عندما يحدث هذا، فكر في شيء واحد
Dialogue: 0,0:17:51.98,0:17:55.56,نص عام,,0,0,0,,مثلاً فكر بي الآن
Dialogue: 0,0:18:04.90,0:18:08.03,نص عام,,0,0,0,,حسنًا. الآن سأفكر فيك
Dialogue: 0,0:18:15.54,0:18:19.63,نص عام,,0,0,0,,سيدي. لذا، هل يمكنني أن أسألك شيئا؟
Dialogue: 0,0:18:20.17,0:18:21.13,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:18:21.88,0:18:24.97,نص عام,,0,0,0,,قلت أنك حلمت بي
Dialogue: 0,0:18:25.05,0:18:26.38,نص عام,,0,0,0,,ماذا قالت لك رؤيتي؟
Dialogue: 0,0:18:27.89,0:18:29.22,نص عام,,0,0,0,,إنك معجب بي
Dialogue: 0,0:18:29.80,0:18:32.14,نص عام,,0,0,0,,- ماذا؟\N- ما هذا؟
Dialogue: 0,0:18:32.22,0:18:33.89,نص عام,,0,0,0,,أنت نفسك كررت هذا كثيرًا
Dialogue: 0,0:18:34.73,0:18:36.14,نص عام,,0,0,0,,حسنًا، هذا لأن...
Dialogue: 0,0:18:40.06,0:18:42.40,general text,,0,0,0,,هل كان كل ذلك كذباً؟
Dialogue: 0,0:18:44.36,0:18:46.40,نص عام,,0,0,0,,أنا معجب بك، لكن...
Dialogue: 0,0:18:47.28,0:18:49.74,نص عام,,0,0,0,,نعم أنا معجب بك
Dialogue: 0,0:19:18.48,0:19:20.10,نص عام,,0,0,0,,امتناني
Dialogue: 0,0:19:33.99,0:19:35.50,النص العام,,0,0,0,,هل صدق ذلك حقًا؟
Dialogue: 0,0:19:37.50,0:19:39.17,نص عام,,0,0,0,,آمل أن لا
Dialogue: 0,0:19:45.42,0:19:47.05,نص عام,,0,0,0,,كفى
Dialogue: 0,0:19:47.13,0:19:49.68,نص عام,,0,0,0,,كل الشكر لك يا معلم
Dialogue: 0,0:19:50.39,0:19:52.39,نص عام,,0,0,0,,أنا متأكد من أن السيدة دو هوا ستكون سعيدة
Dialogue: 0,0:19:52.89,0:19:54.22,نص عام,,0,0,0,,وأخيرًا...
Dialogue: 0,0:19:54.31,0:19:58.27,general text,,0,0,0,,أشعر وكأنني فعلت شيئًا جيدًا لدو هوا كاعتذار
Dialogue: 0,0:19:58.98,0:20:01.56,نص عام,,0,0,0,,لم ترتكب أي خطأ
Dialogue: 0,0:20:01.65,0:20:04.94,general text,,0,0,0,,أنا من أحضرها إلى سيجوكون من مسقط رأسي
Dialogue: 0,0:20:05.02,0:20:08.03,النص العام,,0,0,0,,هكذا التقت بتشانغ جانج
Dialogue: 0,0:20:08.90,0:20:11.11,نص عام,,0,0,0,,هل هوا كانت لطيفة جدًا
Dialogue: 0,0:20:11.20,0:20:15.33,النص العام,,0,0,0,,لا أصدق أنه صدق كل هذه القيل والقال
Dialogue: 0,0:20:15.41,0:20:18.12,النص العام,,0,0,0,,تشان غان، يا له من وغد
Dialogue: 0,0:20:19.00,0:20:21.71,نص عام,,0,0,0,,يا معلم أنت سكران
Dialogue: 0,0:20:21.79,0:20:23.21,نص عام,,0,0,0,,إنه خطأك!
Dialogue: 0,0:20:24.96,0:20:26.92,نص عام,,0,0,0,,ماذا فعلت؟
Dialogue: 0,0:20:27.00,0:20:31.34,general text,,0,0,0,,أحضرت دو هوا إلى سايجوكون لتقضي معك وقتًا معها
Dialogue: 0,0:20:31.43,0:20:32.34,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:20:32.43,0:20:34.43,نص عام,,0,0,0,,السماء المقدسة
Dialogue: 0,0:20:35.05,0:20:37.22,نص عام,,0,0,0,,بمثل هذا المظهر والمهارات
Dialogue: 0,0:20:37.31,0:20:40.18,نص عام,,0,0,0,,لا تستطيع الحصول على قلب الفتاة؟
Dialogue: 0,0:20:40.27,0:20:43.27,نص عام,,0,0,0,,كم أنت مزعج!
Dialogue: 0,0:20:45.48,0:20:46.65,نص عام,,0,0,0,,حسنًا، نعم
Dialogue: 0,0:20:46.73,0:20:49.32,نص عام,,0,0,0,,لقد ساعدك السيد هوو كثيرًا،
Dialogue: 0,0:20:49.40,0:20:51.20,نص عام,,0,0,0,,وأنت لم تستغل فرصة واحدة
Dialogue: 0,0:20:52.70,0:20:53.87,نص عام,,0,0,0,,لقد فعلت
Dialogue: 0,0:20:55.28,0:20:56.41,نص عام,,0,0,0,,كل ما أستطيع
Dialogue: 0,0:20:57.79,0:20:59.00,نص عام,,0,0,0,,كتبت الشعر
Dialogue: 0,0:21:01.21,0:21:02.33,نص عام,,0,0,0,,الهدايا المقدمة
Dialogue: 0,0:21:03.62,0:21:05.63,النص العام,,0,0,0,,لكنك لم تعترف لها
Dialogue: 0,0:21:07.00,0:21:08.21,خط مائل,,0,0,0,"أنا أحبك"
Dialogue: 0,0:21:08.30,0:21:09.67,نص عام,,0,0,0,"هل ستكونين لي؟"
Dialogue: 0,0:21:09.76,0:21:12.88,نص عام,,0,0,0,,تجولنا حول الأدغال، لكننا لم نقول أي شيء
Dialogue: 0,0:21:12.97,0:21:16.01,general text,,0,0,0,,طبعاً خسرت أمام من قال كل شيء مباشرة
Dialogue: 0,0:21:16.10,0:21:18.35,general text,,0,0,0,,هل من الضروري التحدث بصراحة عن المشاعر؟
Dialogue: 0,0:21:20.35,0:21:23.39,نص عام,,0,0,0,,كفى تلميحات
Dialogue: 0,0:21:24.19,0:21:25.69,نص عام,,0,0,0,,كم أنت مزعج
Dialogue: 0,0:21:26.31,0:21:28.98,general text,,0,0,0,,أظهروا الاهتمام، لكنهم حافظوا على المسافة
Dialogue: 0,0:21:29.07,0:21:30.61,النص العام,,0,0,0,,ثم اقتربوا مرة أخرى
Dialogue: 0,0:21:30.69,0:21:32.45,نص عام,,0,0,0,,نحن بحاجة للتحدث مع المرأة عن المشاعر
Dialogue: 0,0:21:32.53,0:21:36.57,general text,,0,0,0,,حتى يمكنها أن تقرر ما إذا كانت ستنتظرك أم لا.
Dialogue: 0,0:21:36.66,0:21:39.95,general text,,0,0,0,,إذا كان الحب متقلبًا جدًا فقط لأنه لم يتم التعبير عنه بصوت عالٍ،
Dialogue: 0,0:21:41.08,0:21:42.21,نص عام,,0,0,0,,إذن فأنا لست بحاجة إليها!
Dialogue: 0,0:21:44.00,0:21:47.17,general text,,0,0,0,,إذا قررت امرأة أن تتركني وتذهب مع شخص آخر،
Dialogue: 0,0:21:47.67,0:21:49.13,نص عام,,0,0,0,,فليكن
Dialogue: 0,0:21:49.88,0:21:50.84,نص عام,,0,0,0,"فليكن..."
Dialogue: 0,0:21:59.35,0:22:00.64,نص عام,,0,0,0,,إستمر بدوني
Dialogue: 0,0:22:02.31,0:22:03.77,نص عام,,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:22:03.85,0:22:05.90,نص عام,,0,0,0,,سأرحل
Dialogue: 0,0:22:06.56,0:22:08.02,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:22:08.90,0:22:11.98,نص عام,,0,0,0,,خليك. تناول مشروباً معنا...
Dialogue: 0,0:22:12.07,0:22:13.53,نص عام,,0,0,0,,خليك...
Dialogue: 0,0:22:14.40,0:22:17.28,مائل,,0,0,0,,الخادمة كيم، عودي، حسنًا؟
Dialogue: 0,0:22:17.37,0:22:19.28,نص عام,,0,0,0,,- سأنتظر\N- هذا صحيح...
Dialogue: 0,0:22:19.37,0:22:21.87,مائل,,0,0,0,,- الخادمة كيم\N{\i0}- يومًا ما سيندم
Dialogue: 0,0:22:21.95,0:22:23.50,خط مائل,,0,0,0,,عذراء كيم!
Dialogue: 0,0:22:34.38,0:22:37.13,نص عام,,0,0,0,,هذا هو المكان الذي يشرب فيه الناس
Dialogue: 0,0:22:37.22,0:22:39.76,النص العام,,0,0,0,,الجميع في انتظارك. ادخل
Dialogue: 0,0:22:39.85,0:22:42.06,نص عام,,0,0,0,,لا أستطيع الشرب
Dialogue: 0,0:22:42.14,0:22:45.73,نص عام,,0,0,0,,لقد نفذ الشاي. يجب أن نعود إلى Danhyangok
Dialogue: 0,0:22:45.81,0:22:47.56,نص عام,,0,0,0,,أحضر لي بعض الطعام
Dialogue: 0,0:22:47.65,0:22:49.02,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:22:55.11,0:22:58.61,نص عام,,0,0,0,,رائحة عطر النساء ورائحة الخمر
Dialogue: 0,0:23:00.91,0:23:02.79,نص عام,,0,0,0,,هذا ليس المكان المناسب لي
Dialogue: 0,0:23:08.50,0:23:09.79,نص عام,,0,0,0,,الحب
Dialogue: 0,0:23:11.96,0:23:13.59,نص عام,,0,0,0,,لم يعجبني
Dialogue: 0,0:23:15.09,0:23:16.38,نص عام,,0,0,0,,الحب
Dialogue: 0,0:23:17.72,0:23:20.55,نص عام,,0,0,0,,لم يعجبني. يحب. لا يحب...
Dialogue: 0,0:23:20.64,0:23:23.56,نص عام,,0,0,0,,ماذا أفعل أصلاً؟
Dialogue: 0,0:23:23.64,0:23:25.18,نص عام,,0,0,0,,انسى
Dialogue: 0,0:23:30.27,0:23:33.44,نص عام,,0,0,0,,أيتها الأمهات! ماذا تفعل الآن؟
Dialogue: 0,0:23:33.52,0:23:34.78,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:24:38.59,0:24:40.01,النص العام,,0,0,0,,أنت ساحر، أليس كذلك؟
Dialogue: 0,0:24:45.55,0:24:46.56,نص عام,,0,0,0,,سيد لي؟
Dialogue: 0,0:24:47.93,0:24:49.48,النص العام,,0,0,0,,هل أنت السيد لي؟
Dialogue: 0,0:24:50.43,0:24:54.15,general text,,0,0,0,,أنا خادمة في عائلة تشان. خدمة السيد تشان
Dialogue: 0,0:24:55.44,0:24:56.82,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:24:57.40,0:24:58.53,نص عام,,0,0,0,,لا يستحق كل هذا العناء
Dialogue: 0,0:25:16.92,0:25:19.05,نص عام,,0,0,0,,أعتقد أن الأمر اشتعل عندما أمسكت بي.
Dialogue: 0,0:25:19.13,0:25:21.88,نص عام,,0,0,0,,انتظر دعني
Dialogue: 0,0:25:22.55,0:25:24.93,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:25:31.68,0:25:32.94,نص عام,,0,0,0,,تم
Dialogue: 0,0:25:37.19,0:25:40.28,نص عام,,0,0,0,,لقد كنت أنتظرك طوال المساء،
Dialogue: 0,0:25:40.36,0:25:42.57,نص عام,,0,0,0,,شكراً
Dialogue: 0,0:25:45.16,0:25:46.41,نص عام,,0,0,0,,مثل هذا
Dialogue: 0,0:25:49.41,0:25:50.79,النص العام,,0,0,0,,أين ذهب؟
Dialogue: 0,0:25:51.83,0:25:52.91,نص عام,,0,0,0,,سيد لي؟
Dialogue: 0,0:26:08.80,0:26:11.43,general text,,0,0,0,,هل لأنني لم أشرب الشاي منذ فترة طويلة؟
Dialogue: 0,0:26:14.60,0:26:17.90,نقوش,,0,0,0,,سايجوكون
Dialogue: 0,0:26:19.61,0:26:21.90,خط مائل,,0,0,0,,السيد هوو ليس هنا الآن
Dialogue: 0,0:26:21.98,0:26:24.28,نص عام,,0,0,0,,لكنه كان ينتظر وصولك
Dialogue: 0,0:26:24.99,0:26:26.36,نص عام,,0,0,0,, تفضل بالدخول
Dialogue: 0,0:26:32.50,0:26:35.04,النص العام,,0,0,0,,الاحتفال بالساحر الجديد جيونجينغاك؟
Dialogue: 0,0:26:35.12,0:26:36.71,النص العام,,0,0,0,,سيعود السيد هو ثملاً
Dialogue: 0,0:26:38.21,0:26:40.54,نص عام,,0,0,0,,الجميع يعرف كيف يحب الجد أن يشرب
Dialogue: 0,0:26:41.17,0:26:45.09,general text,,0,0,0,,سيدتي، ربما ينبغي لنا أن نذهب إلى تشويسنجرو؟
Dialogue: 0,0:26:45.88,0:26:48.55,النص العام,,0,0,0,,زوجك المستقبلي سيكون هناك
Dialogue: 0,0:26:49.26,0:26:52.26,النص العام,,0,0,0,,- ماذا؟\N- السيدة هو أخبرتني بكل شيء
Dialogue: 0,0:26:52.35,0:26:56.52,general text,,0,0,0,,سمعت أن جدك اختار عدة سحرة ليكونوا أزواجك.
Dialogue: 0,0:26:56.60,0:26:59.56,general text,,0,0,0,,من بينهم بارك دان جو من سوسنوفي بور
Dialogue: 0,0:26:59.65,0:27:01.77,النص العام,,0,0,0,,وسيو يول من عائلة سيو
Dialogue: 0,0:27:01.86,0:27:04.03,نص عام,,0,0,0,,لست هنا للزواج
Dialogue: 0,0:27:04.57,0:27:06.65,نص عام,,0,0,0,,سأساعد في المستشفى الملكي
Dialogue: 0,0:27:06.74,0:27:09.91,general text,,0,0,0,,هل تعتقد أن ولي العهد موجود أيضًا في القائمة؟
Dialogue: 0,0:27:10.70,0:27:13.45,النص العام,,0,0,0,,- جمالك...\N- سونغ يي!
Dialogue: 0,0:27:13.54,0:27:15.66,النص العام,,0,0,0,,منطقك قد أهانني بالفعل ذات مرة
Dialogue: 0,0:27:17.41,0:27:18.83,نص عام,,0,0,0,,هل نسيته بالفعل؟
Dialogue: 0,0:27:18.92,0:27:21.71,general text,,0,0,0,,هل تتحدث عن ذلك الساحر المغرور؟
Dialogue: 0,0:27:22.38,0:27:25.46,النص العام,,0,0,0,,كان علي أن أسأل عن الاسم لأخبر المعلم هو
Dialogue: 0,0:27:27.51,0:27:28.80,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:27:29.68,0:27:31.76,نص عام,,0,0,0,,كان يجب أن أسأل عن الاسم
Dialogue: 0,0:27:34.47,0:27:35.89,ذكريات,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:27:39.19,0:27:41.06,نص عام,,0,0,0,,أتساءل عما إذا كنت سأرى...
Dialogue: 0,0:27:43.77,0:27:45.15,نص عام,,0,0,0,,هو مرة أخرى
Dialogue: 0,0:27:49.70,0:27:50.82,نص عام,,0,0,0,,كفى
Dialogue: 0,0:27:55.45,0:27:59.62,النص العام,,0,0,0,,المملكة المتحدة، أنت مدين لي،
Dialogue: 0,0:27:59.71,0:28:01.46,نص عام,,0,0,0,,فأعدك
Dialogue: 0,0:28:01.54,0:28:03.92,النص العام,,0,0,0,,- وعد ماذا؟\N- ذات يوم،
Dialogue: 0,0:28:04.00,0:28:08.59,النص العام,,0,0,0,,عندما أطلب منك أن تفعل شيئاً ستفعله
Dialogue: 0,0:28:09.72,0:28:10.97,نص عام,,0,0,0,,حسنًا، أعدك
Dialogue: 0,0:28:11.72,0:28:13.47,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:28:13.55,0:28:16.81,نص عام,,0,0,0,,أولاً يجب أن أوضح شيئًا ما
Dialogue: 0,0:28:16.89,0:28:21.44,نص عام,,0,0,0,,أنا أسأل لأنك تعرف السيد لي
Dialogue: 0,0:28:21.52,0:28:25.44,النص العام,,0,0,0,,هل شربت شاي عفته؟
Dialogue: 0,0:28:26.53,0:28:29.74,نص عام,,0,0,0,,لا. أبداً. لم يشرب أبدا
Dialogue: 0,0:28:30.36,0:28:32.16,النص العام,,0,0,0,,إذن أنت لا تلاحظ العزوبة؟
Dialogue: 0,0:28:32.24,0:28:35.58,نص عام,,0,0,0,,لا بالطبع. أريد أن أتزوج يوما ما
Dialogue: 0,0:28:35.66,0:28:37.70,نص عام,,0,0,0,,رائع. هنا
Dialogue: 0,0:28:41.08,0:28:43.08,نص عام,,0,0,0,,أنت الآن مرشح أيضًا
Dialogue: 0,0:28:43.17,0:28:45.67,نص عام,,0,0,0,,أنتم الثلاثة مرشحون
Dialogue: 0,0:28:47.34,0:28:50.09,النص العام,,0,0,0,,لا تنس أن تشكر المعلم لي
Dialogue: 0,0:28:50.17,0:28:53.68,general text,,0,0,0,,لو لم يضمنك لكانت هناك مشاكل
Dialogue: 0,0:28:53.76,0:28:55.01,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:28:55.10,0:28:58.56,general text,,0,0,0,,لقد شككت بالفعل في الناس من خلال إظهار تانسو،
Dialogue: 0,0:28:58.64,0:29:00.81,نص عام,,0,0,0,,ملكية ناك سو
Dialogue: 0,0:29:00.89,0:29:04.15,general text,,0,0,0,,حتى أن ووك أراد أن يصبح تلميذ ناك سو
Dialogue: 0,0:29:06.98,0:29:09.19,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:29:10.32,0:29:11.15,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:29:13.70,0:29:17.49,general text,,0,0,0,,كان منزعجًا من عدم قدرة أحد على فتح أبوابه،
Dialogue: 0,0:29:18.12,0:29:19.79,نص عام,,0,0,0,,فمزح هكذا
Dialogue: 0,0:29:20.58,0:29:22.33,نص عام,,0,0,0,,صدقت
Dialogue: 0,0:29:23.54,0:29:25.21,نص عام,,0,0,0,,هكذا قيل؟
Dialogue: 0,0:29:25.29,0:29:27.34,نص عام,,0,0,0,,نعم صحيح
Dialogue: 0,0:29:28.46,0:29:30.80,نص عام,,0,0,0,,يول، أخبرهم،
Dialogue: 0,0:29:30.88,0:29:34.47,general text,,0,0,0,,ما هي عقوبة السحرة الذين يعشقون السحر الأسود؟
Dialogue: 0,0:29:34.55,0:29:36.97,النص العام,,0,0,0,,قد تفقد كل طاقتك،
Dialogue: 0,0:29:37.05,0:29:38.60,نص عام,,0,0,0,,عدم القدرة على إلقاء التعويذات
Dialogue: 0,0:29:38.68,0:29:40.43,general text,,0,0,0,,ثم يُطردون من ديخو،
Dialogue: 0,0:29:41.56,0:29:43.81,النص العام,,0,0,0,,ولن يتمكن الأحفاد أبدًا من أن يصبحوا سحرة
Dialogue: 0,0:29:43.89,0:29:45.10,نص عام,,0,0,0,,تذكر هذا
Dialogue: 0,0:29:48.02,0:29:51.57,نص عام,,0,0,0,,لا تقل ذلك مرة أخرى
Dialogue: 0,0:29:52.49,0:29:54.61,general text,,0,0,0,,ما هو السيء في السحر الأسود؟
Dialogue: 0,0:29:55.36,0:29:56.37,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:29:56.45,0:29:58.45,النص العام,,0,0,0,,التعاويذ العادية تقتل الناس أيضًا
Dialogue: 0,0:29:58.53,0:30:00.95,النص العام,,0,0,0,,والسحر الأسود، في بعض الأحيان، يمكن أن ينقذ الأرواح
Dialogue: 0,0:30:01.83,0:30:03.83,نص عام,,0,0,0,,كيفية فصل أحدهما عن الآخر،
Dialogue: 0,0:30:03.91,0:30:07.79,النص العام,,0,0,0,,علينا أن نفكر في نوايا الإنسان، فهذا الأهم
Dialogue: 0,0:30:07.88,0:30:11.17,نص عام,,0,0,0,,لذلك ستستخدم هذا السحر،
Dialogue: 0,0:30:12.46,0:30:14.97,النص العام,,0,0,0,,إذا كان هذا ينقذ حياة شخص ما؟
Dialogue: 0,0:30:15.05,0:30:17.01,النص العام,,0,0,0,,إذا أنقذ هذا السحر شخصًا ما،
Dialogue: 0,0:30:18.68,0:30:21.22,نص عام,,0,0,0,,لا أرى أي مشكلة
Dialogue: 0,0:30:27.90,0:30:31.15,نص عام,,0,0,0,,جرو! كيف تجرؤ!
Dialogue: 0,0:30:31.23,0:30:32.94,النص العام,,0,0,0,,أنت ساحر جيونجينغاك
Dialogue: 0,0:30:33.03,0:30:36.16,general text,,0,0,0,,كيف تجرؤ على القول إنك ستستخدم هذا السحر؟
Dialogue: 0,0:30:36.24,0:30:38.49,النص العام,,0,0,0,,إذا كنت ستتصرف بهذه الطريقة،
Dialogue: 0,0:30:38.57,0:30:41.12,نص عام,,0,0,0,,أعد الطاقة التي منحتها لك
Dialogue: 0,0:30:43.33,0:30:45.41,نص عام,,0,0,0,,- الفصل\N- ما هو؟
Dialogue: 0,0:30:45.50,0:30:48.54,general text,,0,0,0,,ولي العهد متوجه إلى هنا للقاء تشان ووك
Dialogue: 0,0:30:53.96,0:30:55.26,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:30:57.43,0:30:58.51,نص عام,,0,0,0,,مرحباً
Dialogue: 0,0:31:14.15,0:31:17.53,خط مائل,,0,0,0,,ولي العهد! قل مرحبا له!
Dialogue: 0,0:31:35.34,0:31:37.59,نص عام,,0,0,0,,حضرت عندما سمعت عن الاحتفال
Dialogue: 0,0:31:37.67,0:31:39.47,نص عام,,0,0,0,,لكن يبدو أنني أفسدت الأمر
Dialogue: 0,0:31:40.72,0:31:44.10,النص العام,,0,0,0,,إذا فكرت في الأمر، فهذا كله بفضلي،
Dialogue: 0,0:31:45.22,0:31:47.56,نص عام,,0,0,0,,يجب أن أكون ضيفًا شرفًا
Dialogue: 0,0:31:48.19,0:31:49.77,النص العام,,0,0,0,,لماذا انقلب المزاج إلى هذا الحد؟
Dialogue: 0,0:31:50.65,0:31:52.73,نص عام,,0,0,0,,أنا متأكد، في أعماقي
Dialogue: 0,0:31:52.82,0:31:55.61,نص عام,,0,0,0,,كنت تمنيت أن تكون جنازتي وليست عطلة
Dialogue: 0,0:31:55.69,0:31:57.19,نص عام,,0,0,0,,لذا فإن الشيء الوحيد الذي يمكنني فعله هو،
Dialogue: 0,0:31:57.28,0:31:59.45,نص عام,,0,0,0,,أحييكم بهدوء
Dialogue: 0,0:32:05.45,0:32:07.16,نص عام,,0,0,0,,جنازة أو عطلة,
Dialogue: 0,0:32:07.25,0:32:09.46,نص عام,,0,0,0,,هناك دائمًا مشروب هناك
Dialogue: 0,0:32:10.25,0:32:13.21,نص عام,,0,0,0,,فأخذت بعضًا منه معي
Dialogue: 0,0:32:18.55,0:32:20.59,general text,,0,0,0,,هل سيكون هناك قتال آخر؟
Dialogue: 0,0:32:20.68,0:32:22.22,نص عام,,0,0,0,,الفصل يجب أن تنزل
Dialogue: 0,0:32:22.30,0:32:25.10,نص عام,,0,0,0,,دعونا ننتظر ونرى
Dialogue: 0,0:32:31.10,0:32:33.02,النص العام,,0,0,0,,لتهنئة تشانغ ووك على فوزه،
Dialogue: 0,0:32:35.32,0:32:36.86,نص عام,,0,0,0,,سأسكب له مشروبًا
Dialogue: 0,0:32:39.15,0:32:42.11,general text,,0,0,0,,لقد أتقنت ريوسو وأصبحت ساحر جيونجينغاك
Dialogue: 0,0:32:42.20,0:32:44.37,نص عام,,0,0,0,,في أقل من شهرين
Dialogue: 0,0:32:45.87,0:32:47.16,نص عام,,0,0,0,,مبروك
Dialogue: 0,0:32:52.08,0:32:55.17,النص العام,,0,0,0,,لقد خسرت المعركة، لكن...
Dialogue: 0,0:32:55.25,0:32:57.67,نص عام,,0,0,0,,أنا سعيد كولي للعهد
Dialogue: 0,0:32:58.84,0:33:01.09,نص عام,,0,0,0,,ديهو ساحر جيد
Dialogue: 0,0:33:01.68,0:33:03.93,خط مائل,,0,0,0,,هذا يستحق الاحتفال
Dialogue: 0,0:33:04.51,0:33:05.80,نص عام,,0,0,0,,اشرب
Dialogue: 0,0:33:06.39,0:33:09.60,النص العام,,0,0,0,,وأصبح أفضل ساحر في البلاد
Dialogue: 0,0:33:10.18,0:33:12.02,نص عام,,0,0,0,,ليكن ديهو فخوراً بك،
Dialogue: 0,0:33:12.60,0:33:13.44,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:33:25.82,0:33:27.33,نص عام,,0,0,0,,شكرًا لك يا صاحب السمو
Dialogue: 0,0:33:35.58,0:33:36.92,نص عام,,0,0,0,,سأسكب لك بعضًا منه أيضًا
Dialogue: 0,0:33:48.60,0:33:51.68,نص عام,,0,0,0,,أتمنى أن تصبح ملكًا رائعًا
Dialogue: 0,0:34:12.04,0:34:13.66,general text,,0,0,0,,كن ملكًا عظيمًا يا صاحب السمو
Dialogue: 0,0:34:31.52,0:34:32.60,نص عام,,0,0,0,,هذا جيد
Dialogue: 0,0:34:32.68,0:34:36.14,النص العام,,0,0,0,,ولي العهد لا يحمل ضغينة
Dialogue: 0,0:34:39.94,0:34:42.15,نص عام,,0,0,0,,الأمير وريث العرش،
Dialogue: 0,0:34:42.23,0:34:45.78,نص عام,,0,0,0,,والشاب المولود تحت نجم الملك
Dialogue: 0,0:34:53.45,0:34:56.08,خط مائل,,0,0,0,,اثنان من آثار جينيوون مكسورة
Dialogue: 0,0:34:56.87,0:34:59.59,general text,,0,0,0,,ليس لديهم طاقة، إنهم عديمو الفائدة.
Dialogue: 0,0:34:59.67,0:35:01.96,النص العام,,0,0,0,,أحرقهم وانثر رمادهم فوق بحيرة جيونج تشونج دايهو
Dialogue: 0,0:35:02.88,0:35:04.13,نص عام,,0,0,0,,نعم يا أمي
Dialogue: 0,0:35:04.72,0:35:07.30,نص عام,,0,0,0,,سيدتي لقد عاد السيد
Dialogue: 0,0:35:08.14,0:35:09.22,نص عام,,0,0,0,,أبي؟
Dialogue: 0,0:35:10.01,0:35:11.14,نص عام,,0,0,0,,تشو يونغ
Dialogue: 0,0:35:12.18,0:35:13.18,نص عام,,0,0,0,,الزوجة
Dialogue: 0,0:35:13.27,0:35:14.73,نص عام,,0,0,0,,أبي!
Dialogue: 0,0:35:15.23,0:35:16.31,نص عام,,0,0,0,,أبي!
Dialogue: 0,0:35:17.02,0:35:18.73,خط مائل,,0,0,0,,يا تشو يونغ
Dialogue: 0,0:35:20.86,0:35:24.07,نص عام,,0,0,0,,دعني ألقي نظرة. لقد أصبحت أكثر جمالا
Dialogue: 0,0:35:33.54,0:35:34.66,نص عام,,0,0,0,,لقد عدت
Dialogue: 0,0:35:38.04,0:35:40.00,نص عام,,0,0,0,,لقد وجدتها في جزيرة فولكانو في الجنوب.
Dialogue: 0,0:35:40.67,0:35:42.42,general text,,0,0,0,,لقد فقدت والديها في طفولتها،
Dialogue: 0,0:35:42.50,0:35:45.67,نص عام,,0,0,0,,لذلك لا أتذكر أي شيء عنهم
Dialogue: 0,0:35:45.76,0:35:49.76,general text,,0,0,0,,يبدو أنها في نفس عمر بو يونغ
Dialogue: 0,0:35:52.14,0:35:54.10,نص عام,,0,0,0,,لقد غادرت
Dialogue: 0,0:35:54.18,0:35:57.73,نص عام,,0,0,0,,شيء من الطفولة؟
Dialogue: 0,0:36:01.31,0:36:05.23,النص العام,,0,0,0,,على عكس بو يونغ، ليست لديها طاقة،
Dialogue: 0,0:36:05.32,0:36:08.53,نص عام,,0,0,0,,ولا يمكنها إلقاء التعويذات
Dialogue: 0,0:36:08.61,0:36:12.82,general text,,0,0,0,,ربما فقدت قوتها أثناء غيابها عن جينيوون
Dialogue: 0,0:36:14.41,0:36:17.20,general text,,0,0,0,,ولكن إذا كانت حقًا عضوًا في عائلة جين،
Dialogue: 0,0:36:18.58,0:36:20.67,النص العام,,0,0,0,,ستعود قوتها بسهولة
Dialogue: 0,0:36:28.47,0:36:30.59,نص عام,,0,0,0,,هذا الباب سيرينا
Dialogue: 0,0:36:31.39,0:36:34.18,النص العام,,0,0,0,,هل أنت حقًا أحد أفراد عائلتنا؟
Dialogue: 0,0:37:01.75,0:37:05.09,general text,,0,0,0,,لست الابنة التي كنت تبحث عنها لفترة طويلة؟
Dialogue: 0,0:37:07.05,0:37:08.92,نص عام,,0,0,0,,لا على ما يبدو
Dialogue: 0,0:37:10.47,0:37:15.26,نص عام,,0,0,0,,لكن شكرًا لك على مجيئك إلى هذا الحد. سوف يعطونك ما يكفي من المال لإعادتك.
Dialogue: 0,0:37:17.18,0:37:21.73,general text,,0,0,0,,هل تعتقدين أن أمي ستغضب بسبب خيبة أمل أخرى؟
Dialogue: 0,0:37:22.81,0:37:24.40,النص العام,,0,0,0,,ماذا علي أن أفعل يا أبي؟
Dialogue: 0,0:38:16.91,0:38:18.03,ذكريات,,0,0,0,,الأم
Dialogue: 0,0:38:19.83,0:38:21.70,ذكريات,,0,0,0,,مات العصفور في القفص
Dialogue: 0,0:38:25.54,0:38:28.25,ذكريات,,0,0,0,,أنت على حق. فقير
Dialogue: 0,0:38:28.34,0:38:31.63,ذكريات,,0,0,0,,حتى الأمس شعرت بالطاقة الدافئة
Dialogue: 0,0:38:33.05,0:38:34.63,ذكريات,,0,0,0,,والآن لا شيء
Dialogue: 0,0:38:36.30,0:38:40.39,ذكريات,,0,0,0,,أستطيع أن أرى، لكنك كنت لا تزال أول من لاحظ
Dialogue: 0,0:38:40.47,0:38:43.23,الذكريات,,0,0,0,,جميع الكائنات الحية لديها طاقة
Dialogue: 0,0:38:44.10,0:38:46.35,ذكريات,,0,0,0,,من خلال هذه الطاقة أرى العالم
Dialogue: 0,0:38:46.44,0:38:50.98,ذكريات,,0,0,0,,بو يونغ، عسى أن لا ترى ما يراه الآخرون
Dialogue: 0,0:38:52.19,0:38:56.11,ذكريات,,0,0,0,,أنت مميز وترى ما لا يستطيع الآخرون رؤيته.
Dialogue: 0,0:39:00.83,0:39:02.99,ذكريات,,0,0,0,,صنعت لي عصابة جديدة على عيني
Dialogue: 0,0:39:03.08,0:39:05.04,ذكريات,,0,0,0,,أريد تجربتها
Dialogue: 0,0:39:25.43,0:39:26.60,نص عام,,0,0,0,,الزوجة
Dialogue: 0,0:39:28.73,0:39:30.90,نص عام,,0,0,0,,لا تنزعج
Dialogue: 0,0:39:30.98,0:39:33.86,نص عام,,0,0,0,,لم أتوقع الكثير عندما أحضرتها إلى هنا
Dialogue: 0,0:39:35.82,0:39:38.03,general text,,0,0,0,,إذًا أحضرت أي شخص فقط؟
Dialogue: 0,0:39:38.11,0:39:41.24,نص عام,,0,0,0,,إذن أنت فقط تحاول إرضائي
Dialogue: 0,0:39:41.91,0:39:43.87,النص العام,,0,0,0,,لهذا السبب لم نتمكن من العثور عليها لمدة 10 سنوات
Dialogue: 0,0:39:47.08,0:39:48.29,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:39:49.04,0:39:51.96,نص عام,,0,0,0,,سأبدأ بالبحث من جديد
Dialogue: 0,0:39:53.00,0:39:54.34,نص عام,,0,0,0,,انسى
Dialogue: 0,0:39:54.42,0:39:57.51,general text,,0,0,0,,جين مو من جيونبوغوان سيساعد في العثور عليها
Dialogue: 0,0:39:57.59,0:40:01.64,نص عام,,0,0,0,,اعتقدت أنك تكره أخيك غير الشقيق.
Dialogue: 0,0:40:01.72,0:40:05.06,نص عام,,0,0,0,,أنا أكره ذلك. ولكن إذا كنا نتحدث عن بو يونغ،
Dialogue: 0,0:40:05.14,0:40:08.89,نص عام,,0,0,0,,أنا مستعد للجوء لمساعدته
Dialogue: 0,0:40:14.82,0:40:15.90,نص عام,,0,0,0,,اخرج
Dialogue: 0,0:40:16.44,0:40:19.40,نص عام,,0,0,0,,أنا أبحث عن شخص ما هنا
Dialogue: 0,0:40:19.49,0:40:20.78,النص العام,,0,0,0,,مو دوك هنا، أليس كذلك؟
Dialogue: 0,0:40:20.86,0:40:23.12,نص عام,,0,0,0,,يوجد الكثير من الأشخاص هنا الآن، عد غدًا
Dialogue: 0,0:40:25.24,0:40:26.54,نص عام,,0,0,0,,يدفعني
Dialogue: 0,0:40:28.46,0:40:29.96,نص عام,,0,0,0,,هل تعرف من أنا؟
Dialogue: 0,0:40:31.00,0:40:32.17,نص عام,,0,0,0,,ومن؟
Dialogue: 0,0:40:34.21,0:40:37.17,general text,,0,0,0,,أنا ساحر من إحدى العائلات العليا في هذا البلد
Dialogue: 0,0:40:39.59,0:40:42.34,نص عام,,0,0,0,,أريكم سحري؟
Dialogue: 0,0:40:48.60,0:40:49.98,نص عام,,0,0,0,,اعتبر نفسك محظوظًا
Dialogue: 0,0:40:50.52,0:40:53.15,general text,,0,0,0,,لو وضعت الطاقة في يدي ستموت
Dialogue: 0,0:40:53.86,0:40:56.48,نص عام,,0,0,0,,عذراً. أنا آسف
Dialogue: 0,0:40:57.11,0:41:00.24,نص عام,,0,0,0,,إنه مجرد منزل جيسينج. هل لا تسمح للزوار؟
Dialogue: 0,0:41:00.32,0:41:03.91,النص العام,,0,0,0,,اليوم عيد سحرة جيونجينغاك
Dialogue: 0,0:41:04.49,0:41:05.58,النص العام,,0,0,0,,- سوسنوفي بور؟\N- نعم
Dialogue: 0,0:41:05.66,0:41:08.75,نص عام,,0,0,0,,حتى ولي العهد هنا
Dialogue: 0,0:41:09.62,0:41:12.25,general text,,0,0,0,,سمعت أنها بيعت لأكبر منزل في دايهو.
Dialogue: 0,0:41:12.92,0:41:14.75,نص عام,,0,0,0,,لابد أن هذا هو ذلك المنزل
Dialogue: 0,0:41:14.83,0:41:17.92,نص عام,,0,0,0,,إذا أعطيتني اسمًا سأقدمك لك
Dialogue: 0,0:41:19.09,0:41:21.88,نص عام,,0,0,0,,لا يستحق كل هذا العناء. سأعود غدا
Dialogue: 0,0:41:24.39,0:41:25.85,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:41:27.22,0:41:28.39,نص عام,,0,0,0,,من كان هناك؟
Dialogue: 0,0:41:28.97,0:41:31.35,مائل,,0,0,0,,قالت إنها من عائلة عالية
Dialogue: 0,0:41:31.43,0:41:32.98,نص عام,,0,0,0,,أعتقد أن هذا جينيوون
Dialogue: 0,0:41:33.06,0:41:36.40,general text,,0,0,0,,كان لديها شيء ما على رقبتها يحمل شعار جينيوون
Dialogue: 0,0:41:36.48,0:41:37.69,نص عام,,0,0,0,,جينيوون؟
Dialogue: 0,0:41:38.19,0:41:43.86,general text,,0,0,0,,سحرتهم دائمًا فظون وصعبو الإرضاء
Dialogue: 0,0:41:44.70,0:41:46.24,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:41:46.32,0:41:50.12,نص عام,,0,0,0,,لا يضر. إنها ضعيفة بالنسبة للساحر
Dialogue: 0,0:41:50.20,0:41:53.00,general text,,0,0,0,,ماذا لو كذبت وشعار النبالة مجرد مزيف؟
Dialogue: 0,0:41:54.00,0:41:57.71,general text,,0,0,0,,إذا كنت في ديهو تظاهرت بأنك أحد أفراد العائلة العليا،
Dialogue: 0,0:41:57.79,0:41:59.38,النص العام,,0,0,0,,يمكنك أن تموت
Dialogue: 0,0:42:01.01,0:42:02.47,نص عام,,0,0,0,,فتاة غريبة
Dialogue: 0,0:42:11.35,0:42:15.10,مائل,,0,0,0,,في قلعة ديهو، يتمتع السحرة بالفعل بالعديد من الامتيازات
Dialogue: 0,0:42:16.86,0:42:18.52,نص عام,,0,0,0,,لا بد أن مو دوك موجود في مكان ما.
Dialogue: 0,0:42:28.58,0:42:30.91,general text,,0,0,0,,علينا أن نعيش من أجل مالها ولو قليلاً
Dialogue: 0,0:42:32.58,0:42:34.54,general text,,0,0,0,,إذا قلت أنني جئت لأرد هذا،
Dialogue: 0,0:42:35.54,0:42:38.75,نص عام,,0,0,0,,أنا متأكد من أنها ستسمح لي بالبقاء، إنها لطيفة
Dialogue: 0,0:42:40.42,0:42:42.38,general text,,0,0,0,,- أهلاً، من أنت؟\N- خائفة
Dialogue: 0,0:42:49.60,0:42:50.68,نص عام,,0,0,0,,انتظرني بالخارج
Dialogue: 0,0:42:51.26,0:42:52.43,نص عام,,0,0,0,,نعم سمو الأمير
Dialogue: 0,0:42:59.94,0:43:01.61,نص عام,,0,0,0,,يجب أن تخرج
Dialogue: 0,0:43:02.98,0:43:06.11,نص عام,,0,0,0,,واحد، اثنان، ثلاثة
Dialogue: 0,0:43:08.70,0:43:10.58,نص عام,,0,0,0,,أربعة، خمسة...
Dialogue: 0,0:43:11.49,0:43:12.66,خط مائل,,0,0,0,,صاحب السمو
Dialogue: 0,0:43:14.45,0:43:15.79,نص عام,,0,0,0,,صاحب السمو!
Dialogue: 0,0:43:19.88,0:43:25.17,نص عام,,0,0,0,,مرة أخرى تأثرت
Dialogue: 0,0:43:25.76,0:43:27.26,نص عام,,0,0,0,,كرمك اللامحدود
Dialogue: 0,0:43:29.22,0:43:32.47,النص العام,,0,0,0,,نعم تظاهرت بأنني طيب وكريم
Dialogue: 0,0:43:32.56,0:43:34.68,نص عام,,0,0,0,,كان من الممكن أن يقلب هذا المكان رأساً على عقب
Dialogue: 0,0:43:34.77,0:43:37.94,general text,,0,0,0,,لكن كما قلت من قبل، لا أريد أن يصبح السحرة أعدائي
Dialogue: 0,0:43:39.23,0:43:41.61,نص عام,,0,0,0,,ماذا؟ هل تعتقد أنني غبي؟
Dialogue: 0,0:43:42.52,0:43:45.32,general text,,0,0,0,,لقد تصرفت بحكمة وذكاء شديدين،
Dialogue: 0,0:43:45.40,0:43:49.07,نص عام,,0,0,0,,إخفاء تفاهتك وعواطفك
Dialogue: 0,0:43:49.95,0:43:52.74,general text,,0,0,0,,قررت أن أظهر التفاهة لك فقط، وون مو دوك
Dialogue: 0,0:43:52.83,0:43:57.16,general text,,0,0,0,,أستطيع أن أتخيل مدى صعوبة سكب الشراب له،
Dialogue: 0,0:43:57.25,0:43:59.58,نص عام,,0,0,0,,عندما تريد أن تسمم
Dialogue: 0,0:43:59.67,0:44:02.54,نص عام,,0,0,0,,فهرعت إلى هنا بأسرع ما يمكن
Dialogue: 0,0:44:03.29,0:44:05.51,النص العام,,0,0,0,,أنا أكره سيدك لدرجة الغثيان
Dialogue: 0,0:44:05.59,0:44:06.71,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:44:06.80,0:44:08.63,general text,,0,0,0,,كبدي يحترق من الكراهية له
Dialogue: 0,0:44:08.72,0:44:10.47,نص عام,,0,0,0,,ليس لدي أدنى شك
Dialogue: 0,0:44:10.55,0:44:12.26,النص العام,,0,0,0,,وأنت... تؤيده...
Dialogue: 0,0:44:13.72,0:44:15.39,نص عام,,0,0,0,,أنا أيضًا لا أحبك
Dialogue: 0,0:44:21.23,0:44:23.52,general text,,0,0,0,,كرمي كان لك وليس له
Dialogue: 0,0:44:26.48,0:44:27.99,نص عام,,0,0,0,,وون مو ديوك
Dialogue: 0,0:44:28.07,0:44:31.36,general text,,0,0,0,,إذا دخلت في شجار أو تشاجر بيننا مرة أخرى،
Dialogue: 0,0:44:32.49,0:44:34.33,نص عام,,0,0,0,,سأقتلك أولاً
Dialogue: 0,0:44:39.04,0:44:42.96,general text,,0,0,0,,صاحب السمو، إذا كنت سأموت بسيفك،
Dialogue: 0,0:44:44.84,0:44:46.63,نص عام,,0,0,0,,لن أحمل ضغينة ضدك
Dialogue: 0,0:44:47.76,0:44:50.09,general text,,0,0,0,,هل ستخدم السيد في كل الأحوال؟
Dialogue: 0,0:44:50.18,0:44:51.59,نص عام,,0,0,0,,يا له من خادم مخلص
Dialogue: 0,0:44:51.68,0:44:53.76,general text,,0,0,0,,ربما ينبغي علينا بناء نصب تذكاري لك؟
Dialogue: 0,0:44:53.85,0:44:57.43,النص العام,,0,0,0,,يشرفني جدًا أن أتلقى تقديرك
Dialogue: 0,0:44:57.52,0:44:59.02,نص عام,,0,0,0,,انسى. تختفي
Dialogue: 0,0:44:59.10,0:45:01.48,general text,,0,0,0,,حتى فقدت كل كرمي وأصبحت تافهاً مرة أخرى
Dialogue: 0,0:45:02.48,0:45:04.69,النص العام,,0,0,0,,- صاحب السمو\N- ماذا؟ ماذا مرة أخرى؟
Dialogue: 0,0:45:04.77,0:45:07.11,نص عام,,0,0,0,,ظهرت أمنية الموت؟
Dialogue: 0,0:45:08.19,0:45:11.03,نص عام,,0,0,0,,كيف حال جراحك؟ هل أنت بخير؟
Dialogue: 0,0:45:14.12,0:45:16.74,نص عام,,0,0,0,,كان ينبغي أن أسأل في وقت سابق
Dialogue: 0,0:45:16.83,0:45:19.20,نص عام,,0,0,0,,لا تقلق. الهجوم لم يكن قويا
Dialogue: 0,0:45:19.29,0:45:21.16,general text,,0,0,0,,نعم، وقد قام Ho Yeom بإصلاحي بالفعل
Dialogue: 0,0:45:22.12,0:45:25.79,general text,,0,0,0,,لقد تفاجأت لأنك لم تتوقع هذا من سيدي
Dialogue: 0,0:45:25.88,0:45:29.34,general text,,0,0,0,,لكنك بالطبع أقوى منه
Dialogue: 0,0:45:29.42,0:45:32.80,نص عام,,0,0,0,,بطبيعة الحال. من كان يعلم أنه كان يستخدم تانسو؟
Dialogue: 0,0:45:32.88,0:45:34.01,نص عام,,0,0,0,,المحتال
Dialogue: 0,0:45:34.89,0:45:36.10,ذكريات,,0,0,0,,أوه، تقصد ذلك الكيس،
Dialogue: 0,0:45:36.89,0:45:40.10,ذكريات,,0,0,0,,التي علقتها بجانب حفرة المرحاض لطرد الذباب؟
Dialogue: 0,0:45:42.89,0:45:45.23,النص العام,,0,0,0,,أين الكيس الذي أعطيتك إياه؟
Dialogue: 0,0:45:45.31,0:45:46.19,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:45:47.11,0:45:50.07,general text,,0,0,0,,فجأة علقته بجانب حفرة المرحاض لطرد الذباب
Dialogue: 0,0:45:53.32,0:45:54.45,نص عام,,0,0,0,,هنا
Dialogue: 0,0:45:55.11,0:45:58.53,النص العام,,0,0,0,,لماذا علق مثل هذا الكنز بالقرب من المرحاض؟
Dialogue: 0,0:45:58.62,0:46:01.33,نص عام,,0,0,0,,بالضبط. كنت أعرف أنك لن تفعل ذلك
Dialogue: 0,0:46:02.29,0:46:03.21,نص عام,,0,0,0,,حسنًا، حسنًا
Dialogue: 0,0:46:05.92,0:46:07.79,النص العام,,0,0,0,,رحلة سعيدة يا صاحب السمو
Dialogue: 0,0:46:20.10,0:46:22.43,خط مائل,,0,0,0,,- يكفي\N- هذا كل شيء
Dialogue: 0,0:46:22.52,0:46:24.52,نص عام,,0,0,0,,- سيد\N- دعني وشأني
Dialogue: 0,0:46:24.60,0:46:26.65,نص عام,,0,0,0,,استيقظ يا معلم
Dialogue: 0,0:46:28.02,0:46:29.32,نص عام,,0,0,0,,- يا\N- انظر إلى ذلك
Dialogue: 0,0:46:30.36,0:46:32.53,نص عام,,0,0,0,,لن يستيقظ إلا صباح الغد
Dialogue: 0,0:46:32.61,0:46:34.24,خط مائل,,0,0,0,,يسكر بسرعة
Dialogue: 0,0:46:34.32,0:46:37.20,general text,,0,0,0,,شرب كل ما قدمه له ولي العهد
Dialogue: 0,0:46:37.28,0:46:40.12,general text,,0,0,0,,كان ينبغي أن نساعده حينها. أنت الوحيد الرصين هنا
Dialogue: 0,0:46:40.20,0:46:43.00,نص عام,,0,0,0,,كنت مشغولاً، كنت أغني
Dialogue: 0,0:46:44.54,0:46:46.08,خط مائل,,0,0,0,,ضع المحفة
Dialogue: 0,0:46:49.29,0:46:52.05,general text,,0,0,0,,فقط من يسمح لهم بالمرور هنا يمكنهم
Dialogue: 0,0:46:52.63,0:46:54.92,النص العام,,0,0,0,,إذا لم تكن من سوسنوفي بور، فارحل
Dialogue: 0,0:47:02.52,0:47:03.89,نص عام,,0,0,0,,لا يمكنك ذلك أيضاً
Dialogue: 0,0:47:05.27,0:47:06.60,نص عام,,0,0,0,,أنا مو دوك
Dialogue: 0,0:47:07.40,0:47:09.36,نص عام,,0,0,0,,سيدي. خادمة تشان
Dialogue: 0,0:47:09.44,0:47:10.69,نص عام,,0,0,0,,أنت تعلم
Dialogue: 0,0:47:12.11,0:47:15.70,general text,,0,0,0,,لم يُسمح لك بالدخول إلا لأن تشانغ ووك كان ضيفًا هنا من قبل
Dialogue: 0,0:47:15.78,0:47:16.82,نص عام,,0,0,0,,لكن الآن كل شيء مختلف
Dialogue: 0,0:47:16.90,0:47:19.49,general text,,0,0,0,,هو عضو في سوسنوفي بور، وأنت لست كذلك.
Dialogue: 0,0:47:20.24,0:47:21.37,نص عام,,0,0,0,,فلا تستطيع
Dialogue: 0,0:47:21.45,0:47:23.45,نص عام,,0,0,0,,ماذا سيحدث للمالك؟
Dialogue: 0,0:47:23.54,0:47:26.91,general text,,0,0,0,,إنه مخمور جداً. لا بد لي من الاعتناء به
Dialogue: 0,0:47:27.00,0:47:30.21,general text,,0,0,0,,خدام تشونغجينغاك سيعتنون به
Dialogue: 0,0:47:33.17,0:47:34.38,نص عام,,0,0,0,,لا!
Dialogue: 0,0:47:35.88,0:47:38.72,نص عام,,0,0,0,,يجب أن أكون قريبًا من المالك
Dialogue: 0,0:47:38.80,0:47:40.05,نص عام,,0,0,0,,دعني أدخل
Dialogue: 0,0:47:40.14,0:47:42.81,نص عام,,0,0,0,,دعها تدخل بالفعل
Dialogue: 0,0:47:42.89,0:47:45.48,general text,,0,0,0,,المملكة المتحدة ستفعل شيئًا إذا لم تكن موجودة
Dialogue: 0,0:47:45.56,0:47:49.56,general text,,0,0,0,,لا يوجد ساحر واحد من جيونججينجاك لديه امتياز خادمته
Dialogue: 0,0:47:51.11,0:47:54.32,general text,,0,0,0,,دخل تشان ووك إلى سوسنوفي بور، لذا يجب عليه اتباع قواعدنا
Dialogue: 0,0:47:55.15,0:47:57.24,نص عام,,0,0,0,,إذن لا يمكنني حقًا تسجيل الدخول؟
Dialogue: 0,0:47:57.32,0:47:58.78,نص عام,,0,0,0,,هذه هي القواعد
Dialogue: 0,0:47:59.41,0:48:01.62,نص عام,,0,0,0,,اذهب إلى المنزل الآن
Dialogue: 0,0:48:01.70,0:48:03.58,النص العام,,0,0,0,,سأعيد "أوك" إلى المنزل عندما يستيقظ
Dialogue: 0,0:48:03.66,0:48:05.08,نص عام,,0,0,0,,تشان ووك لا يمكنه المغادرة
Dialogue: 0,0:48:05.75,0:48:09.25,general text,,0,0,0,,لا يستطيع مغادرة سوسنوفي بور حتى يكمل تدريبه
Dialogue: 0,0:48:09.33,0:48:10.83,نص عام,,0,0,0,,هذه أيضًا قاعدة
Dialogue: 0,0:48:13.29,0:48:15.59,نص عام,,0,0,0,,بالضبط. بقينا هنا أيضا
Dialogue: 0,0:48:16.38,0:48:17.34,نص عام,,0,0,0,,أي,
Dialogue: 0,0:48:17.42,0:48:20.38,النص العام,,0,0,0,,لا أستطيع الدخول وسيدي لا يستطيع الخروج؟
Dialogue: 0,0:48:20.47,0:48:22.35,نص عام,,0,0,0,,ولا يمكننا أن نكون معًا؟
Dialogue: 0,0:48:22.43,0:48:25.47,النص العام,,0,0,0,,عندما أفهم، اذهب معهم إلى المنزل
Dialogue: 0,0:48:26.93,0:48:28.14,نص عام,,0,0,0,,انتظر...
Dialogue: 0,0:48:44.66,0:48:46.62,النص العام,,0,0,0,,إنه أول يوم لتشان ووك في جيونجينغاك
Dialogue: 0,0:48:46.70,0:48:49.21,general text,,0,0,0,,هل تريده أن يكسر القواعد في يومه الأول؟
Dialogue: 0,0:48:56.80,0:48:59.76,نص عام,,0,0,0,,دعني أدخل!
Dialogue: 0,0:49:02.26,0:49:05.05,مائل,,0,0,0,,إذا وقفت هناك، فلن تغادر
Dialogue: 0,0:49:05.14,0:49:07.77,مائل,,0,0,0,,إذا علمت الرأس سأعاقبها
Dialogue: 0,0:49:07.85,0:49:09.02,نص عام,,0,0,0,,فلنبدأ
Dialogue: 0,0:49:10.31,0:49:14.40,نص عام,,0,0,0,,مو دوك، اذهب للمنزل. سنجد طريقة
Dialogue: 0,0:49:22.36,0:49:23.70,نص عام,,0,0,0,,سيدتي!
Dialogue: 0,0:49:28.49,0:49:30.29,نص عام,,0,0,0,,خذني معك!
Dialogue: 0,0:49:31.58,0:49:32.87,نص عام,,0,0,0,,سيدتي!
Dialogue: 0,0:49:48.31,0:49:50.52,نص عام,,0,0,0,,كيف حالك يا جدي؟
Dialogue: 0,0:49:50.60,0:49:51.60,نص عام,,0,0,0,,كل شيء على ما يرام
Dialogue: 0,0:49:52.69,0:49:56.23,النص العام,,0,0,0,,لقد كبرت وأصبحت فتاة جميلة
Dialogue: 0,0:49:57.27,0:50:00.15,general text,,0,0,0,,السيد هوو، تم تسليم ساحر مخمور
Dialogue: 0,0:50:00.23,0:50:01.61,النص العام,,0,0,0,,بسبب تنفسه الثقيل
Dialogue: 0,0:50:01.69,0:50:05.32,النص العام,,0,0,0,,إنه فقط في حالة سكر، اعتني به بنفسك
Dialogue: 0,0:50:05.41,0:50:08.87,نص عام,,0,0,0,,هذا تشان ووك. لقد أعطيته طاقتك
Dialogue: 0,0:50:08.95,0:50:11.58,نص عام,,0,0,0,,ماذا؟ تشان ووك؟
Dialogue: 0,0:50:11.66,0:50:12.83,نص عام,,0,0,0,,المملكة المتحدة؟
Dialogue: 0,0:50:35.48,0:50:37.27,خلف الكواليس,,0,0,0,,إنه ذلك الساحر
Dialogue: 0,0:50:39.98,0:50:42.32,نص عام,,0,0,0,,يون أوك، تعال هنا
Dialogue: 0,0:50:42.40,0:50:43.57,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:50:48.99,0:50:52.70,general text,,0,0,0,,أغلقت أبواب طاقته سنوات طويلة، وفتحتها له
Dialogue: 0,0:50:53.29,0:50:56.04,general text,,0,0,0,,حتى أنني أعطيته طاقتي. اسمه تشان ووك
Dialogue: 0,0:50:57.96,0:50:59.04,نص عام,,0,0,0,,تشانغ ووك؟
Dialogue: 0,0:50:59.13,0:51:02.67,نص عام,,0,0,0,,نعم. لقد مر شهر واحد فقط وقد أتقن ريوسو بالفعل
Dialogue: 0,0:51:02.76,0:51:03.92,نص عام,,0,0,0,,إنه عبقري
Dialogue: 0,0:51:04.42,0:51:05.55,نص عام,,0,0,0,,لمدة شهر؟
Dialogue: 0,0:51:06.88,0:51:09.47,نص عام,,0,0,0,,حقاً عبقري
Dialogue: 0,0:51:23.23,0:51:25.57,نص عام,,0,0,0,,حسنًا، أنا ثمل جدًا
Dialogue: 0,0:51:25.65,0:51:28.66,النص العام,,0,0,0,,سأذهب إلى غرفتي وأذهب إلى السرير
Dialogue: 0,0:51:28.74,0:51:30.37,نص رئيسي,,0,0,0,,أنظر إلى الرقم
Dialogue: 0,0:51:30.95,0:51:32.70,نص عام,,0,0,0,,هيا
Dialogue: 0,0:51:32.79,0:51:34.37,نص عام,,0,0,0,,حسنًا يا جدي
Dialogue: 0,0:51:50.97,0:51:52.72,نص عام,,0,0,0,,نلتقي من جديد
Dialogue: 0,0:51:54.64,0:51:56.85,نص عام,,0,0,0,,سيدي. تشانغ ووك
Dialogue: 0,0:52:13.28,0:52:15.66,النص العام,,0,0,0,,لم أقطع كل هذه المسافة لأستسلم
Dialogue: 0,0:52:18.21,0:52:19.96,نص عام,,0,0,0,,سأدخل بأي وسيلة ضرورية
Dialogue: 0,0:52:36.27,0:52:37.52,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:52:45.40,0:52:46.61,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:52:47.78,0:52:51.82,النص العام,,0,0,0,,سيدك يحتضر. رأسي يدور
Dialogue: 0,0:53:32.49,0:53:33.57,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:53:35.74,0:53:37.28,نص عام,,0,0,0,,إذا تركتني،
Dialogue: 0,0:53:39.45,0:53:41.37,نص عام,,0,0,0,,أقسم أني سأقتلك
Dialogue: 0,0:54:07.86,0:54:09.28,نص عام,,0,0,0,,سيدي. يول؟
Dialogue: 0,0:54:11.61,0:54:13.65,نص عام,,0,0,0,,ظننت أنك ربما لا تزال هنا
Dialogue: 0,0:54:14.74,0:54:15.99,نص عام,,0,0,0,,ولقد كنت على حق
Dialogue: 0,0:54:18.12,0:54:19.91,نص عام,,0,0,0,,لن أغادر أبدًا
Dialogue: 0,0:54:22.08,0:54:24.62,نص عام,,0,0,0,,يجب أن أكون مع المالك
Dialogue: 0,0:54:27.46,0:54:29.71,نص عام,,0,0,0,,الجلوس هنا لن يحل المشكلة
Dialogue: 0,0:54:29.80,0:54:32.47,نص عام,,0,0,0,,فقط اجعل أوكا تخرق القواعد
Dialogue: 0,0:54:32.55,0:54:35.09,general text,,0,0,0,,حينها ستذهب كل جهوده سدى
Dialogue: 0,0:54:37.34,0:54:38.64,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:54:39.85,0:54:41.56,نص عام,,0,0,0,,اذهب إلى المنزل وانتظر هناك
Dialogue: 0,0:54:42.39,0:54:43.85,نص عام,,0,0,0,,سأرافقك
Dialogue: 0,0:54:54.57,0:54:56.57,نص عام,,0,0,0,,أخبر سيدي،
Dialogue: 0,0:54:57.95,0:54:59.66,نص عام,,0,0,0,,سوف أجد طريقة
Dialogue: 0,0:55:00.45,0:55:02.95,نص عام,,0,0,0,,الوصول إلى سوسنوفي بور للمالك
Dialogue: 0,0:55:05.33,0:55:07.37,نص عام,,0,0,0,,قل له أن يصبر حتى ذلك الحين
Dialogue: 0,0:55:09.79,0:55:12.55,نص عام,,0,0,0,,حسنًا. سأخبرك
Dialogue: 0,0:56:07.69,0:56:09.81,نص عام,,0,0,0,,رأسي يؤلمني كثيراً
Dialogue: 0,0:56:12.65,0:56:14.40,نص عام,,0,0,0,,كله الأمير
Dialogue: 0,0:56:16.36,0:56:17.65,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:56:18.49,0:56:21.37,النص العام,,0,0,0,,- أحضر بعض الماء\N{\i1}- من هو مو دوك؟
Dialogue: 0,0:56:24.29,0:56:25.37,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:56:25.45,0:56:28.33,نص عام,,0,0,0,,ألا تتذكر؟ التقينا في النزل
Dialogue: 0,0:56:30.62,0:56:31.88,ذكريات بخط مائل,,0,0,0,,لا تكذب
Dialogue: 0,0:56:31.96,0:56:34.92,ذكريات,,0,0,0,,كنت تحدق بها طوال الوقت!
Dialogue: 0,0:56:35.92,0:56:38.38,نص عام,,0,0,0,,آه، تا صن شيء هناك
Dialogue: 0,0:56:39.13,0:56:40.59,نص عام,,0,0,0,,بالضبط سونغ يي
Dialogue: 0,0:56:41.68,0:56:42.80,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:56:42.89,0:56:47.31,general text,,0,0,0,,السيده هو هي حفيدة السيد هو يوم
Dialogue: 0,0:56:47.39,0:56:48.56,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:56:50.02,0:56:51.44,نص عام,,0,0,0,,أهذا كل شيء؟
Dialogue: 0,0:56:51.52,0:56:52.81,نص عام,,0,0,0,,إذا أخبرت المعلم هوو،
Dialogue: 0,0:56:52.90,0:56:55.73,general text,,0,0,0,,كم كنت وقحة معها، سيغضب السيد منك
Dialogue: 0,0:56:56.48,0:56:58.65,النص العام,,0,0,0,,لم يحبني أبدًا على أية حال
Dialogue: 0,0:56:58.74,0:56:59.86,نص عام,,0,0,0,,دعه يقول
Dialogue: 0,0:57:03.32,0:57:04.74,نص عام,,0,0,0,,حسنًا، على الأقل أشكرها
Dialogue: 0,0:57:04.83,0:57:06.54,النص العام,,0,0,0,,سيدتي اعتنت بك طوال الليل
Dialogue: 0,0:57:06.62,0:57:07.91,نص عام,,0,0,0,,سيدتك؟
Dialogue: 0,0:57:16.71,0:57:18.21,نص عام,,0,0,0,,من الأفضل عدم ذكر ذلك لها
Dialogue: 0,0:57:20.13,0:57:23.26,النص العام,,0,0,0,,هل قابلت المملكة المتحدة بعد؟
Dialogue: 0,0:57:24.01,0:57:24.93,نص عام,,0,0,0,,نعم
Dialogue: 0,0:57:25.01,0:57:29.98,general text,,0,0,0,,شان ووك ساعد يون أوك عندما كانت في ورطة
Dialogue: 0,0:57:30.06,0:57:31.39,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:57:31.48,0:57:34.69,general text,,0,0,0,,المملكة المتحدة ليست من الدول التي تساعد الناس فقط
Dialogue: 0,0:57:35.94,0:57:37.86,نص عام,,0,0,0,,ماذا تتحدث عنه؟
Dialogue: 0,0:57:40.15,0:57:41.78,نص عام,,0,0,0,,سمعت أنك وصلت من قلعة فول
Dialogue: 0,0:57:42.61,0:57:46.33,النص العام,,0,0,0,,أنا ووالدة السيد من هناك
Dialogue: 0,0:57:47.33,0:57:50.66,نص عام,,0,0,0,,- أرى\N - ربما لهذا السبب
Dialogue: 0,0:57:50.75,0:57:52.92,نص عام,,0,0,0,,تذكرني بالسيدة دو هوا
Dialogue: 0,0:57:54.46,0:57:57.42,general text,,0,0,0,,أعتقد أنك وسيدي مقدران أن تكونا معًا
Dialogue: 0,0:57:59.71,0:58:02.09,general text,,0,0,0,,إذا كان الناس من نفس المدينة يجب أن يكونوا متشابهين،
Dialogue: 0,0:58:02.68,0:58:04.93,النص العام,,0,0,0,,فأنتم أيضًا يجب أن تكونوا متشابهين
Dialogue: 0,0:58:06.93,0:58:08.89,نص عام,,0,0,0,,ولكن لا يوجد شيء مشترك بينكما
Dialogue: 0,0:58:11.02,0:58:12.48,نص عام,,0,0,0,,لم أفهم ماذا تقصد
Dialogue: 0,0:58:13.73,0:58:15.31,خط مائل,,0,0,0,,عذراء كيم، أنت عظيمة،
Dialogue: 0,0:58:15.40,0:58:19.69,نص عام,,0,0,0,,لكنك في بعض الأحيان تبالغ وتتوصل إلى استنتاجات متسرعة
Dialogue: 0,0:58:20.57,0:58:23.07,النص العام,,0,0,0,,هل تقول أنني أكذب؟
Dialogue: 0,0:58:24.20,0:58:25.53,نص عام,,0,0,0,,لم أقل ذلك
Dialogue: 0,0:58:26.12,0:58:27.66,خط مائل,,0,0,0,,هنا والآن
Dialogue: 0,0:58:27.74,0:58:31.12,general text,,0,0,0,,لقد انزعجوا حتى أنهم وصفوا أنفسهم بالكاذبين
Dialogue: 0,0:58:31.20,0:58:32.29,نص عام,,0,0,0,,نعم نعم بالطبع
Dialogue: 0,0:58:32.37,0:58:35.71,نص عام,,0,0,0,,أنا كاذب سهل الانزعاج
Dialogue: 0,0:58:35.79,0:58:37.88,النص العام,,0,0,0,,متى قلت لك كاذباً؟
Dialogue: 0,0:58:37.96,0:58:40.21,نص عام,,0,0,0,,هذا ما قلته بالضبط
Dialogue: 0,0:58:40.30,0:58:41.55,نص عام,,0,0,0,,هذه كانت كلماتك
Dialogue: 0,0:58:41.63,0:58:42.92,خط مائل,,0,0,0,,- ما خطبك؟\N- إنه خطأك...
Dialogue: 0,0:58:43.01,0:58:45.84,النص العام,,0,0,0,,ما نوع العلاقة بينهما؟
Dialogue: 0,0:58:48.89,0:58:51.52,general text,,0,0,0,,بينهم علاقة غريبة وعجيبة،
الحوار: 0,0:58:51.60,0:58:53.77,نص عام,,0,0,0,,مرفق
Dialogue: 0,0:58:53.85,0:58:56.23,مائل,,0,0,0,,- كنت أول من انزعج\N- قلت أنني أكذب
Dialogue: 0,0:58:56.31,0:58:58.27,النص العام,,0,0,0,,يبدو أنهم قريبون، لكن لا يوجد شيء مميز هناك
Dialogue: 0,0:58:58.36,0:59:00.52,general text,,0,0,0,,- أنت نفسك جلست هنا، كررت...\N-{\i1} لكن كما ترى،
Dialogue: 0,0:59:00.61,0:59:03.82,general text,,0,0,0,,- إنه غبي جدًا\N- {\i1}واصل وصفي بالكاذب
Dialogue: 0,0:59:03.90,0:59:05.32,نص عام,,0,0,0,,وهذا مزعج
Dialogue: 0,0:59:05.40,0:59:06.41,نص عام,,0,0,0,,لا توجد كلمات
Dialogue: 0,0:59:06.49,0:59:08.66,نص عام,,0,0,0,,لدينا أدلة وشهود
Dialogue: 0,0:59:08.74,0:59:10.70,نص عام,,0,0,0,,الشهود؟ كم أنت مزعج!
Dialogue: 0,0:59:12.75,0:59:15.75,general text,,0,0,0,,كيف التقيت أنت والمملكة المتحدة؟
Dialogue: 0,0:59:18.04,0:59:19.59,نص عام,,0,0,0,,- حسنًا...\N{\i1}- سيدتي
Dialogue: 0,0:59:22.76,0:59:24.17,نص عام,,0,0,0,,آسف على التدخل
Dialogue: 0,0:59:25.30,0:59:26.59,نص عام,,0,0,0,,هل يمكننا التحدث؟
Dialogue: 0,0:59:27.84,0:59:29.39,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:59:30.51,0:59:31.97,نص عام,,0,0,0,,يمكنك التحدث هنا
Dialogue: 0,0:59:32.89,0:59:34.93,نص عام,,0,0,0,,هذا أمر شخصي!
Dialogue: 0,0:59:35.64,0:59:36.64,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:59:38.23,0:59:40.44,نص عام,,0,0,0,,ماذا يحدث معهم؟
Dialogue: 0,0:59:42.65,0:59:45.82,النص العام,,0,0,0,,الرجل يبدو جدياً جداً
Dialogue: 0,0:59:45.90,0:59:47.45,نص عام,,0,0,0,,هذا كل شيء
Dialogue: 0,0:59:47.53,0:59:50.62,نص عام,,0,0,0,,بالحكم على الطريقة التي يتبعها يون أوك،
Dialogue: 0,0:59:50.70,0:59:52.24,نص عام,,0,0,0,,هناك شيء بينهما
Dialogue: 0,0:59:52.95,0:59:54.79,النص العام,,0,0,0,,- ما هذا؟\N- ومن يدري؟
Dialogue: 0,1:00:01.29,1:00:03.17,نص عام,,0,0,0,,سأتابعهم وأكتشف ذلك
Dialogue: 0,1:00:03.25,1:00:04.38,نص عام,,0,0,0,,اجلس على الفور!
Dialogue: 0,1:00:05.13,1:00:06.47,نص عام,,0,0,0,,اجلس الآن!
Dialogue: 0,1:00:07.17,1:00:10.47,نص عام,,0,0,0,,ولكن هذا مثير للاهتمام بالنسبة لك
Dialogue: 0,1:00:10.55,1:00:12.30,نص عام,,0,0,0,,كيف يمكنك أن تكون شخصًا بطيئًا إلى هذا الحد؟
Dialogue: 0,1:00:12.97,1:00:14.22,نص عام,,0,0,0,,إنه ميؤوس منه
Dialogue: 0,1:00:14.81,1:00:16.39,خط مائل,,0,0,0,,إنه مثل مرض عضال
Dialogue: 0,1:00:16.48,1:00:17.39,نص عام,,0,0,0,,اجلس
Dialogue: 0,1:00:21.27,1:00:24.53,نص عام,,0,0,0,,لماذا يوبخونني دائمًا؟
Dialogue: 0,1:00:30.57,1:00:32.12,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,1:00:33.12,1:00:36.20,general text,,0,0,0,,هل أخبرت الجميع بالفعل بما حدث في ذلك اليوم؟
Dialogue: 0,1:00:38.75,1:00:40.75,ذكريات,,0,0,0,,كنت غير مرتاح لمتابعتك لي،
Dialogue: 0,1:00:40.83,1:00:42.42,ذكريات,,0,0,0,,وهذا أيضًا وقح من جانبك
Dialogue: 0,1:00:42.50,1:00:43.88,ذكريات,,0,0,0,,الجمال لم يبهر
Dialogue: 0,1:00:44.67,1:00:46.88,ذكريات,,0,0,0,,ولم أتبعك
Dialogue: 0,1:00:48.34,1:00:49.55,نص عام,,0,0,0,,لا
Dialogue: 0,1:00:50.26,1:00:52.85,نص عام,,0,0,0,,لن أذكر شيئًا مخزيًا جدًا
Dialogue: 0,1:00:53.55,1:00:55.14,نص عام,,0,0,0,,أنت لا تعتقد أنني لطيف
Dialogue: 0,1:00:55.22,1:00:58.56,النص العام,,0,0,0,,جمالي لم يعجبك ولم تتابعني
Dialogue: 0,1:00:59.14,1:01:00.89,نص عام,,0,0,0,,أشعر بالحرج حتى من مجرد التفكير في الأمر
Dialogue: 0,1:01:00.98,1:01:02.44,نص عام,,0,0,0,,لذلك سأصمت
Dialogue: 0,1:01:02.52,1:01:03.36,نص عام,,0,0,0,,لقد
الحوار: 0,1:01:04.11,1:01:06.69,نص عام,,0,0,0,,المنطق السليم
Dialogue: 0,1:01:07.32,1:01:09.70,نص عام,,0,0,0,,لا، ليس هذا ما أتحدث عنه
Dialogue: 0,1:01:10.36,1:01:11.28,نص عام,,0,0,0,,أنا أتحدث عن ابتلاع الروح
Dialogue: 0,1:01:11.36,1:01:14.12,نص عام,,0,0,0,,ابتلاع الروح الذي حاول قتلك
Dialogue: 0,1:01:14.70,1:01:17.79,general text,,0,0,0,,إذًا كان حقًا ابتلاعًا للروح؟
Dialogue: 0,1:01:17.87,1:01:20.37,نص عام,,0,0,0,,نعم. لكن لا يمكنك التحدث عن ذلك
Dialogue: 0,1:01:20.46,1:01:23.83,نص عام,,0,0,0,,اصنع لي معروفًا. يبقيه سرا
Dialogue: 0,1:01:25.42,1:01:29.17,general text,,0,0,0,,لقد أنقذت حياتي، وسألبي طلبك
Dialogue: 0,1:01:30.01,1:01:31.09,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,1:01:31.18,1:01:34.26,general text,,0,0,0,,بما أننا نتشارك سرًا واحدًا، فيجب علينا على الأقل أن نقدم أنفسنا
Dialogue: 0,1:01:34.97,1:01:36.56,نص عام,,0,0,0,,أنا هو يون أوك
Dialogue: 0,1:01:37.18,1:01:38.35,نص عام,,0,0,0,,أنا تشانغ ووك
Dialogue: 0,1:01:38.93,1:01:40.85,نص عام,,0,0,0,,أعلم. لقد سمعت الكثير
Dialogue: 0,1:01:40.93,1:01:42.73,نص عام,,0,0,0,,وأنا أيضًا. هذا الرجل العجوز...
Dialogue: 0,1:01:42.81,1:01:44.10,نص عام,,0,0,0,,هذا...
Dialogue: 0,1:01:44.19,1:01:47.32,نص عام,,0,0,0,,السيد هو كان يتفاخر دائمًا بحفيدته
Dialogue: 0,1:01:47.40,1:01:50.24,نص عام,,0,0,0,,هل أخبرك جدي بشيء عني؟
Dialogue: 0,1:01:52.40,1:01:54.03,نص عام,,0,0,0,,سوف تحرج
Dialogue: 0,1:01:54.62,1:01:55.78,نص عام,,0,0,0,,حقاً...
الحوار: 0,1:01:56.78,1:01:59.75,نص عام,,0,0,0,,مشي وكرر أن حفيدته
Dialogue: 0,1:01:59.83,1:02:02.08,نص عام,,0,0,0,"جميلة كالجنية الجميلة." لا، أليس كذلك؟
Dialogue: 0,1:02:02.66,1:02:06.04,general text,,0,0,0,,نعم قال للجميع إنك تبهرين بجمالك
Dialogue: 0,1:02:06.79,1:02:07.92,نص عام,,0,0,0,,لست أنا للأسف
Dialogue: 0,1:02:12.47,1:02:13.97,نص عام,,0,0,0,,إنه أمر محرج حقًا
Dialogue: 0,1:02:14.68,1:02:16.22,نص عام,,0,0,0,,لا أصدق ذلك...
Dialogue: 0,1:02:16.30,1:02:17.14,نص عام,,0,0,0,,هذا الرجل العجوز...
Dialogue: 0,1:02:17.22,1:02:20.72,نص عام,,0,0,0,,أي أن السيد هوو يظهر مثل هذه المودة
Dialogue: 0,1:02:20.81,1:02:22.81,نص عام,,0,0,0,,لقد تحدث عن أمي بنفس الطريقة
Dialogue: 0,1:02:23.69,1:02:26.36,نص عام,,0,0,0,,قيل لي أنني أشبه والدتك
Dialogue: 0,1:02:27.44,1:02:31.19,نص عام,,0,0,0,,أعتقد أن هذا هو شكل الجنيات في نظر جدي
Dialogue: 0,1:02:37.41,1:02:38.58,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:02:39.87,1:02:41.45,نص عام,,0,0,0,,ليس مشابهًا؟
Dialogue: 0,1:02:44.25,1:02:45.50,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,1:02:47.92,1:02:49.42,نص عام,,0,0,0,,لم أرها من قبل
Dialogue: 0,1:02:58.43,1:03:00.18,نص عام,,0,0,0,,وكيف سأقابل الجنية؟
Dialogue: 0,1:03:00.26,1:03:01.64,نص عام,,0,0,0,,من الصعب القول
Dialogue: 0,1:03:03.93,1:03:05.85,نص عام,,0,0,0,,هل أنت صاحي؟
Dialogue: 0,1:03:05.94,1:03:09.73,نص عام,,0,0,0,,نعم. سمعت أنك كنت بالجوار طوال الليل
Dialogue: 0,1:03:11.11,1:03:12.40,نص عام,,0,0,0,,نعم
Dialogue: 0,1:03:12.48,1:03:15.82,نص عام,,0,0,0,,اعتقدت أنه مو دوك. آسف
Dialogue: 0,1:03:19.28,1:03:22.33,نص عام,,0,0,0,,صنعت الشاي بالأعشاب
Dialogue: 0,1:03:34.01,1:03:35.72,نص عام,,0,0,0,,كنت أتمنى أن يشرب
Dialogue: 0,1:03:37.76,1:03:39.34,نقوش,,0,0,0,,سايجوكون
Dialogue: 0,1:03:39.43,1:03:41.56,نص عام,,0,0,0,,انتظر
Dialogue: 0,1:03:43.22,1:03:44.68,نص عام,,0,0,0,,هل رأيت مو دوك؟
Dialogue: 0,1:03:44.77,1:03:47.14,general text,,0,0,0,,جاءت معي بالأمس، لكن لم يتم العثور عليها في أي مكان.
Dialogue: 0,1:03:47.73,1:03:48.73,نص عام,,0,0,0,,ذهبت إلى المنزل
Dialogue: 0,1:03:50.90,1:03:53.57,general text,,0,0,0,,لماذا رحلت بدوني؟
Dialogue: 0,1:03:54.53,1:03:57.07,general text,,0,0,0,,اتركت مالك السكير وذهبت إلى المنزل؟
Dialogue: 0,1:03:57.15,1:04:00.07,general text,,0,0,0,,الآن سيعتني بك خدم سوسنوفي بور
Dialogue: 0,1:04:00.16,1:04:03.24,النص العام,,0,0,0,,مو دوك لا تنتمي إلينا، لا يمكنها المجيء إلى هنا
Dialogue: 0,1:04:05.75,1:04:06.96,نص عام,,0,0,0,,انتظر...
Dialogue: 0,1:04:10.63,1:04:12.09,خط مائل,,0,0,0,,فكر مو دوك,
Dialogue: 0,1:04:12.17,1:04:15.71,نص عام,,0,0,0,,يمكنها متابعة المملكة المتحدة إلى سوسنوفي بور
Dialogue: 0,1:04:16.92,1:04:19.89,general text,,0,0,0,,أنا متأكد من أنها تخيلت كيف تراك كل يوم
Dialogue: 0,1:04:19.97,1:04:21.47,نص عام,,0,0,0,,ربما منزعج
Dialogue: 0,1:04:34.40,1:04:37.61,نص عام,,0,0,0,,نعم. أتمنى أن تكون بخير
Dialogue: 0,1:04:41.07,1:04:42.49,نص عام,,0,0,0,,على ما يبدو، المملكة المتحدة اكتشفت ذلك
Dialogue: 0,1:04:43.33,1:04:44.74,مائل,,0,0,0,,بالتأكيد سيذهب إلى عمه
Dialogue: 0,1:04:44.83,1:04:46.87,نص كبير,,0,0,0,,هذا لا يعني
Dialogue: 0,1:04:50.75,1:04:54.67,نص عام,,0,0,0,,لم يكن لدى أي ساحر خادمة شخصية
Dialogue: 0,1:04:55.55,1:04:58.01,نص عام,,0,0,0,,ولست استثناءً
Dialogue: 0,1:04:58.09,1:04:59.13,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,1:04:59.72,1:05:02.43,النص العام,,0,0,0,,استثناء، لقد طردتني من هنا منذ 20 عامًا
Dialogue: 0,1:05:04.26,1:05:05.97,نص عام,,0,0,0,,لماذا لا نقوم باستثناء آخر؟
Dialogue: 0,1:05:07.35,1:05:10.52,نص عام,,0,0,0,,كل ذلك لأن تانسو علمتك
Dialogue: 0,1:05:12.69,1:05:14.11,نص عام,,0,0,0,,خارج هذه الجدران؟
Dialogue: 0,1:05:17.07,1:05:18.74,نص عام,,0,0,0,,أنت بحاجة إلى مو دوك،
Dialogue: 0,1:05:19.40,1:05:22.28,نص عام,,0,0,0,,للبقاء على تواصل مع المعلم؟
Dialogue: 0,1:05:23.57,1:05:26.37,general text,,0,0,0,,لقد أكد السيد لي بالفعل أنني دربت نفسي
Dialogue: 0,1:05:27.58,1:05:30.21,النص العام,,0,0,0,,لقد أنقذك ولكن الناس ما زالوا يثرثرون
Dialogue: 0,1:05:30.71,1:05:32.12,نص عام,,0,0,0,,حتى أن هناك من يفكر،
Dialogue: 0,1:05:32.96,1:05:35.71,نص عام,,0,0,0,,ما علمك إياه والدك تشانغ غان
Dialogue: 0,1:05:38.05,1:05:40.51,النص العام,,0,0,0,,في البداية قال الناس أنني لست ابنه
Dialogue: 0,1:05:41.88,1:05:43.89,general text,,0,0,0,,الآن يثرثرون أن والدي علمني؟
Dialogue: 0,1:05:45.76,1:05:49.52,نص عام,,0,0,0,,عندما تحدث استثناءات، يبدأ الأشخاص في الدردشة
Dialogue: 0,1:05:50.43,1:05:53.52,النص العام,,0,0,0,,لقد أتقنت Ryusu بسرعة واستخدمت Tansu
Dialogue: 0,1:05:54.48,1:05:56.52,نص عام,,0,0,0,,هذا غير عادي للغاية
Dialogue: 0,1:05:59.48,1:06:00.69,نص عام,,0,0,0,,أنت...
Dialogue: 0,1:06:01.65,1:06:03.86,نص عام,,0,0,0,,محاولة جذب الانتباه,
Dialogue: 0,1:06:05.32,1:06:07.12,نص عام,,0,0,0,,إجبار الناس على الحديث عن أنفسهم؟
Dialogue: 0,1:06:09.91,1:06:13.00,خارج الشاشة,,0,0,0,,لا يمكنك السماح لرئيس المشتبه به مو دوك
Dialogue: 0,1:06:13.08,1:06:14.92,خارج الشاشة,,0,0,0,,وإلا سيكتشف أنها بدوية
Dialogue: 0,1:06:16.46,1:06:19.30,النص العام,,0,0,0,,حسنًا، أفهم أنك ضد
Dialogue: 0,1:06:21.30,1:06:24.72,نص عام,,0,0,0,,هل ستتبع القواعد فحسب؟
Dialogue: 0,1:06:24.80,1:06:25.80,نص عام,,0,0,0,,نعم
Dialogue: 0,1:06:26.47,1:06:28.26,نص عام,,0,0,0,,وصلت إلى هنا بهذه الصعوبة
Dialogue: 0,1:06:28.35,1:06:32.39,نص عام,,0,0,0,,لا يمكنني المخاطرة بذلك من أجل خادمة ما
Dialogue: 0,1:06:46.82,1:06:49.87,نص عام,,0,0,0,,أريد شراء تميمة روحية من السوق السوداء
Dialogue: 0,1:06:50.99,1:06:52.25,نص عام,,0,0,0,,ابحث لي عن واحدة
Dialogue: 0,1:06:52.33,1:06:55.42,general text,,0,0,0,,كيف تطلب هذا وقد قُتل أحدهم بسبب تميمة؟
Dialogue: 0,1:06:55.50,1:06:59.59,general text,,0,0,0,,إذا تم القبض عليك، فسوف يقتلونك أيضًا.
Dialogue: 0,1:06:59.67,1:07:03.84,نص عام,,0,0,0,,يجب أن أكون بجانبه. المالك يحتاجني
Dialogue: 0,1:07:03.92,1:07:06.80,نص عام,,0,0,0,,إطلاقاً. لم يعد بحاجة إليك
Dialogue: 0,1:07:07.55,1:07:10.72,general text,,0,0,0,,كان بحاجة إليك عندما هرب وحده وتدرب
Dialogue: 0,1:07:10.81,1:07:13.39,نص عام,,0,0,0,,والآن هو في جيونجينجاك
Dialogue: 0,1:07:13.48,1:07:15.56,نص عام,,0,0,0,,هناك الكثير من الخدم الآخرين هناك
Dialogue: 0,1:07:16.14,1:07:17.85,general text,,0,0,0,,وسيساعده سحرة سوسنوفي بور أيضًا.
Dialogue: 0,1:07:17.94,1:07:20.36,نص عام,,0,0,0,,لا يمكنك فعل أي شيء أكثر من أجله
Dialogue: 0,1:07:20.44,1:07:22.11,نص عام,,0,0,0,,لماذا يحتاجك؟
Dialogue: 0,1:07:28.87,1:07:31.99,نص عام,,0,0,0,,كلفني الرئيس بتعليمك الأساسيات
Dialogue: 0,1:07:32.08,1:07:35.37,نص عام,,0,0,0,,يشرفني أن أكون معلمتك
Dialogue: 0,1:07:36.54,1:07:39.00,نص عام,,0,0,0,,اتكل عليك
Dialogue: 0,1:07:42.13,1:07:44.13,نص عام,,0,0,0,,هذه مجموعة قواعد لجونغجينجاك
Dialogue: 0,1:07:44.21,1:07:48.18,general text,,0,0,0,,من هذه الكتب ستتعرف على فضائل السحرة وكذلك جميع المحرمات
Dialogue: 0,1:07:48.80,1:07:50.01,نص عام,,0,0,0,,لا يمكنك
Dialogue: 0,1:07:50.10,1:07:52.89,نص عام,,0,0,0,,اترك هذا المكان حتى تتعلم كل شيء
Dialogue: 0,1:07:54.98,1:07:57.14,نص عام,,0,0,0,,نعم. سأتبع القواعد
Dialogue: 0,1:07:57.77,1:07:59.02,نص عام,,0,0,0,,يمكنك البدء
الحوار: 0,1:08:00.06,1:08:01.23,نص عام,,0,0,0,,اقرأ
Dialogue: 0,1:08:08.61,1:08:09.66,نص عام,,0,0,0,,سيد.
Dialogue: 0,1:08:11.95,1:08:13.03,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,1:08:13.66,1:08:15.20,نص عام,,0,0,0,,كيف دخلت؟
Dialogue: 0,1:08:18.16,1:08:19.75,نص عام,,0,0,0,,اعتقدت أنك أغلقت الباب مرة أخرى
Dialogue: 0,1:08:19.83,1:08:22.34,نص عام,,0,0,0,,في الغرفة السرية لعصاة الرأس
Dialogue: 0,1:08:23.21,1:08:25.42,نص عام,,0,0,0,,ولكنك هنا في غرفة التدريب
Dialogue: 0,1:08:26.46,1:08:28.43,نص عام,,0,0,0,,أنا فخور بك
Dialogue: 0,1:08:28.51,1:08:31.47,نص عام,,0,0,0,,الخادمة كيم، يمكنك أن تفخر بنفسك
Dialogue: 0,1:08:32.22,1:08:33.72,نص عام,,0,0,0,,لقد أحسنت تربية هذا الرجل المحترم
Dialogue: 0,1:08:36.60,1:08:39.89,نص عام,,0,0,0,,والجدير بالذكر أن الجداول منخفضة
Dialogue: 0,1:08:42.86,1:08:44.52,نص عام,,0,0,0,,والكراسي غير مريحة
Dialogue: 0,1:08:45.23,1:08:47.03,نص عام,,0,0,0,,أنا فوق الجميع
Dialogue: 0,1:08:47.11,1:08:48.82,نص عام,,0,0,0,,وأنا غير مرتاح
Dialogue: 0,1:08:48.90,1:08:52.12,نص عام,,0,0,0,,ولكن لا يمكن فعل أي شيء، هذه هي القواعد
Dialogue: 0,1:08:55.12,1:08:59.75,general text,,0,0,0,,ما هي علاقتك بالسيدة هو؟
Dialogue: 0,1:08:59.83,1:09:01.71,نص عام,,0,0,0,,عن ماذا تحدثت معها؟
Dialogue: 0,1:09:01.79,1:09:04.29,نص عام,,0,0,0,,لا يوجد شيء مميز
Dialogue: 0,1:09:07.13,1:09:10.51,نص عام,,0,0,0,,أحتاج إلى قراءة كل هذه الكتب. لقد حان الوقت لك، خادمة كيم
Dialogue: 0,1:09:10.59,1:09:13.85,general text,,0,0,0,,هل تحتاج إلى بعض الحبر قبل الصف؟
Dialogue: 0,1:09:14.43,1:09:17.72,نص عام,,0,0,0,,لا، يجب أن أفعل كل شيء بنفسي
Dialogue: 0,1:09:17.81,1:09:19.02,نص عام,,0,0,0,,هذه هي القواعد
Dialogue: 0,1:09:19.10,1:09:20.77,نص عام,,0,0,0,,القواعد. أرى
Dialogue: 0,1:09:21.73,1:09:22.94,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:09:24.06,1:09:27.19,نص عام,,0,0,0,,سأذهب. أراك لاحقا
Dialogue: 0,1:09:28.11,1:09:29.28,نص عام,,0,0,0,,العذراء كيم,
Dialogue: 0,1:09:31.11,1:09:34.70,نص عام,,0,0,0,,اعتني بمو دوك. ربما تكون قلقة
Dialogue: 0,1:09:34.78,1:09:37.29,general text,,0,0,0,,لماذا يجب أن تقلق إذا كنت بخير تمامًا؟
Dialogue: 0,1:09:37.37,1:09:38.37,نص عام,,0,0,0,,أعتقد أنها سعيدة
Dialogue: 0,1:09:40.00,1:09:42.67,general text,,0,0,0,,لقد عانت كثيراً بسببك
Dialogue: 0,1:09:42.75,1:09:46.21,general text,,0,0,0,,أنت انتقائي بشأن الطعام، كان عليها أن تطبخ ثلاث مرات،
Dialogue: 0,1:09:46.29,1:09:49.17,نص عام,,0,0,0,,عندما كانت معك في الجبال. حمل الماء للاستحمام
Dialogue: 0,1:09:49.26,1:09:52.43,نص عام,,0,0,0,,اغسل ملابسك. هل تعرف كم هذا العمل؟
Dialogue: 0,1:09:55.14,1:09:57.10,general text,,0,0,0,,لقد عانى مو دوك حقًا
Dialogue: 0,1:09:57.18,1:10:01.39,النص العام,,0,0,0,,سأخذها لرؤية الزهور وشراء شيء لذيذ
Dialogue: 0,1:10:01.98,1:10:03.69,نص عام,,0,0,0,,سأعتني بها
Dialogue: 0,1:10:03.77,1:10:06.31,نص عام,,0,0,0,,سوف تكون هادئة إذا لم تكن بالجوار
Dialogue: 0,1:10:09.98,1:10:11.19,نص عام,,0,0,0,,هل تعتقد؟
Dialogue: 0,1:10:19.62,1:10:21.87,خلف الكواليس,,0,0,0,,لقد وصل تشان ووك إلى هدفه بالفعل
Dialogue: 0,1:10:22.37,1:10:24.87,التعليق الصوتي,,0,0,0,,ربما لم يعد بحاجة إلي حقًا بعد الآن
Dialogue: 0,1:10:25.58,1:10:27.54,خلف الكواليس,,0,0,0,,ترك 12 معلماً
Dialogue: 0,1:10:28.34,1:10:31.46,general text,,0,0,0,,كان يجب أن نسممه ونجد شيئًا ليبتزه به
Dialogue: 0,1:10:32.05,1:10:33.93,نص عام,,0,0,0,,لقد وثقت به كثيرًا
Dialogue: 0,1:10:34.51,1:10:36.55,خط مائل,,0,0,0,,مو دوك!
Dialogue: 0,1:10:37.39,1:10:38.39,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:10:38.97,1:10:40.35,نص عام,,0,0,0,,هل لديك تميمة؟
Dialogue: 0,1:10:40.43,1:10:43.35,نص عام,,0,0,0,,لا أستطيع أن أفعل هذا. ولكن الآن يمكنك اجتياز الامتحان
Dialogue: 0,1:10:44.06,1:10:46.02,general text,,0,0,0,,هل تريدني أن أنجح في امتحان الساحر؟
Dialogue: 0,1:10:46.65,1:10:48.69,نص عام,,0,0,0,,هل أنت مجنون؟ لا تتحدث هراء
Dialogue: 0,1:10:49.44,1:10:52.40,general text,,0,0,0,,سوسنوفي بور تجري امتحاناً ليس للسحرة
Dialogue: 0,1:10:52.49,1:10:55.45,النص العام,,0,0,0,,حتى أن لديهم منافسة هناك بسبب المنافسة الشرسة
Dialogue: 0,1:10:55.53,1:10:56.91,نص عام,,0,0,0,,المنافسة؟
Dialogue: 0,1:10:56.99,1:10:58.74,نص عام,,0,0,0,,توظيف الخدم في سوسنوفي بور
Dialogue: 0,1:10:58.83,1:11:01.54,نص عام,,0,0,0,,لذلك يقومون فقط بتعيين الخدم
Dialogue: 0,1:11:01.62,1:11:03.96,النص العام,,0,0,0,,مو دوك أنت الخادم
Dialogue: 0,1:11:04.79,1:11:08.13,نص عام,,0,0,0,,نعم أعرف. لكنني لست خادمة عادية
Dialogue: 0,1:11:08.21,1:11:09.46,نص عام,,0,0,0,,أنا أرفض
Dialogue: 0,1:11:10.09,1:11:12.34,نص عام,,0,0,0,,لماذا تغضب؟
Dialogue: 0,1:11:12.42,1:11:14.26,general text,,0,0,0,,هل تعرف مدى صعوبة الوصول إلى هناك؟
Dialogue: 0,1:11:17.18,1:11:19.26,النص العام,,0,0,0,,مو دوك، تبدو متعبًا
Dialogue: 0,1:11:19.35,1:11:20.93,نص عام,,0,0,0,,تناول الطعام قبل أن تغادر
Dialogue: 0,1:11:26.81,1:11:27.98,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,1:11:28.06,1:11:30.52,general text,,0,0,0,,هل أنت من سوسنوفي بور؟ هل رأيت المالك؟
Dialogue: 0,1:11:30.61,1:11:33.49,نص عام,,0,0,0,,نعم. رأيت ذلك. انه بخير
Dialogue: 0,1:11:34.19,1:11:36.65,general text,,0,0,0,,ماذا يريد مني أن أفعل الآن؟
Dialogue: 0,1:11:36.74,1:11:37.99,general text,,0,0,0,,متى سيأتي من أجلي؟
Dialogue: 0,1:11:38.07,1:11:40.16,نص عام,,0,0,0,,أريدك أن تعيش جيدًا هنا
Dialogue: 0,1:11:40.24,1:11:42.41,نص عام,,0,0,0,,أعجبت بالزهور وأكلت الحلويات
Dialogue: 0,1:11:43.33,1:11:47.79,general text,,0,0,0,,قال أتتعجب من الزهور وتأكل الحلويات؟
Dialogue: 0,1:11:47.87,1:11:48.96,نص عام,,0,0,0,,نعم
Dialogue: 0,1:11:53.30,1:11:55.88,general text,,0,0,0,,ألم يقل متى سيأتي لمقابلتي؟
Dialogue: 0,1:11:55.97,1:11:58.26,النص العام,,0,0,0,,حسب القواعد لا يمكنه المغادرة
Dialogue: 0,1:11:59.09,1:12:01.51,النص العام,,0,0,0,,إنه مصمم على اتباع القواعد،
Dialogue: 0,1:12:01.60,1:12:04.18,نص عام,,0,0,0,,لم أعد أقلق عليه بعد الآن
Dialogue: 0,1:12:06.94,1:12:09.98,خلف الكواليس,,0,0,0,,أعتقد أن أوكو لم تعد بحاجة إلي بعد الآن
Dialogue: 0,1:12:12.19,1:12:13.27,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,1:12:14.53,1:12:18.95,النص العام,,0,0,0,,وأنت لا تعرف من يحب سيدنا؟
Dialogue: 0,1:12:20.74,1:12:22.74,نص عام,,0,0,0,,ربما هذه هي الفتاة التي رأيتها في سوسنوفي بور
Dialogue: 0,1:12:22.83,1:12:25.91,نص عام,,0,0,0,,فتاة؟ هل هو يواعد شخص ما؟
Dialogue: 0,1:12:26.00,1:12:27.96,نص عام,,0,0,0,,حسنًا، لقد أخبرني،
Dialogue: 0,1:12:28.54,1:12:30.75,نص عام,,0,0,0,,أن قلبه لفتاة،
Dialogue: 0,1:12:30.83,1:12:34.09,نص عام,,0,0,0,,وهي مثل بيضة الطير في أعلى الشجرة
Dialogue: 0,1:12:43.18,1:12:46.77,italics,,0,0,0,,وكذلك ليس لديها أحد غيره
Dialogue: 0,1:12:48.27,1:12:51.15,مائل,,0,0,0,,أستطيع أن أتخيل مدى قلقه واهتمامه بها
Dialogue: 0,1:12:51.23,1:12:54.07,general text,,0,0,0,,عندما يعتني الرجل بالمرأة، ماذا يعني ذلك في رأيك؟
Dialogue: 0,1:12:56.32,1:12:57.69,نص عام,,0,0,0,,يعني أنه واقع في الحب
Dialogue: 0,1:13:01.24,1:13:03.37,نص عام,,0,0,0,,لكنه أنا
Dialogue: 0,1:13:09.16,1:13:10.42,ذكريات بخط مائل,,0,0,0,,كان هناك بيض طيور
Dialogue: 0,1:13:10.50,1:13:14.63,ذكريات,,0,0,0,,يا معلم، دعونا نبقى مخلصين لبعضنا البعض
Dialogue: 0,1:13:21.05,1:13:22.76,ذكريات مائلة,,0,0,0,,كدت أن أموت بفضلك،
Dialogue: 0,1:13:22.84,1:13:24.18,ذكريات,,0,0,0,,سيدي المجنون
Dialogue: 0,1:13:28.10,1:13:31.85,ذكريات بخط مائل,,0,0,0,,ستستمر علاقتنا بين المعلم والطالب حتى تصبح الأفضل،
Dialogue: 0,1:13:31.94,1:13:34.48,ذكريات بخط مائل,,0,0,0,,لمساعدتي في استعادة طاقتي
Dialogue: 0,1:13:35.61,1:13:38.53,ذكريات بخط مائل,,0,0,0,,عندما أستعيد قوتي وأصبح ناك سو مرة أخرى،
Dialogue: 0,1:13:39.03,1:13:40.99,ذكريات,,0,0,0,,لن نكون معلمين وطالبين بعد الآن
Dialogue: 0,1:13:42.45,1:13:44.45,ذكريات بخط مائل,,0,0,0,,هل يمكنني معرفة السبب؟
Dialogue: 0,1:13:45.66,1:13:48.70,ذكريات بخط مائل,,0,0,0,,لأنه حينها لن يكون لديك سبب لحمايتي
Dialogue: 0,1:13:50.12,1:13:51.71,ذكريات بخط مائل,,0,0,0,,ولن يكون لدي أي سبب
Dialogue: 0,1:13:55.08,1:13:56.34,ذكريات مائلة,,0,0,0,,أن أكون متساهلاً معك
Dialogue: 0,1:13:57.38,1:13:59.34,ذكريات,,0,0,0,,يا معلم! إنه أنا، تشان ووك
Dialogue: 0,1:14:17.15,1:14:18.82,نص عام,,0,0,0,,فماذا أفعل؟
Dialogue: 0,1:14:20.03,1:14:21.53,نص عام,,0,0,0,,كل شيء سيء
Dialogue: 0,1:14:27.16,1:14:28.16,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:14:30.08,1:14:31.37,نص عام,,0,0,0,,افتقدك
Dialogue: 0,1:15:06.44,1:15:08.24,معاينة,,0,0,0,,لن أقوم بتدريس أوكا
Dialogue: 0,1:15:08.32,1:15:12.04,preview,,0,0,0,,لذا لم تأخذه تحت جناحك، لقد حبسته هنا للتو
Dialogue: 0,1:15:12.12,1:15:13.62,معاينة,,0,0,0,,المساعدة!
Dialogue: 0,1:15:15.08,1:15:16.71,preview,,0,0,0,,كان بالتأكيد مو ديوك!
Dialogue: 0,1:15:16.79,1:15:19.25,preview,,0,0,0,,لماذا يجب عليها دائمًا أن تكون في مكان آخر؟
Dialogue: 0,1:15:19.34,1:15:20.42,معاينة,,0,0,0,,سيدتي!
Dialogue: 0,1:15:21.34,1:15:25.38,معاينة,,0,0,0,,لماذا الرسالة؟ طالما أنها تعبر عن مشاعرك..
Dialogue: 0,1:15:25.47,1:15:30.14,preview,,0,0,0,,الرجل واقع في حب شخص ما بالفعل
Dialogue: 0,1:15:30.22,1:15:32.02,معاينة,,0,0,0,,هذا أصعب مما ظننت
Dialogue: 0,1:15:32.10,1:15:34.02,معاينة,,0,0,0,,صاحب السمو!
Dialogue: 0,1:15:34.10,1:15:36.02,معاينة,,0,0,0,,كانت دائمًا بجوار المملكة المتحدة
Dialogue: 0,1:15:36.10,1:15:39.31,معاينة,,0,0,0,,عليك أن تحاول قراءة ما لا تستطيع رؤيته
Dialogue: 0,1:15:39.40,1:15:40.82,معاينة,,0,0,0,,مو دوك
الحوار: 0,0:02:55.14,0:02:57.14,النكات,,0,0,0,,

