Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter: {\c&HFFF4C5&} Ria_Lee, tommo
Dialogue: 0,0:01:15.77,0:01:19.11,pangkalahatang text,,0,0,0,,Nabalitaan kong nag-fishing ka kasama ang Uk
Dialogue: 0,0:01:20.15,0:01:23.40,pangkalahatang teksto,,0,0,0,,Oo. Nakakatamad mangisda mag-isa
Dialogue: 0,0:01:24.15,0:01:25.95,general text,,0,0,0,,Minsan mong sinabi,
Dialogue: 0,0:01:26.03,0:01:29.45,pangkalahatang text,,0,0,0,,na si Chan Wook ay kapareho ng kapalaran ni Master Seo Kyung
Dialogue: 0,0:01:29.54,0:01:33.00,general text,,0,0,0,,So sinusuportahan mo siya at tinutulungan mo siya?
Dialogue: 0,0:01:33.50,0:01:36.42,general text,,0,0,0,,Hindi lang ako ang tumutulong sa kanya
Dialogue: 0,0:01:38.71,0:01:40.96,general text,,0,0,0,,May nagdidirekta pa ba sa kanya?
Dialogue: 0,0:01:41.92,0:01:43.42,pangkalahatang teksto,,0,0,0,,Sino?
Dialogue: 0,0:01:44.17,0:01:45.84,general text,,0,0,0,,Kilala mo ba ang taong ito?
Dialogue: 0,0:01:52.52,0:01:56.15,pangkalahatang teksto,,0,0,0,,Walang nagtuturo kay Uka na mag-spells
Dialogue: 0,0:01:56.65,0:01:57.65,pangkalahatang text,,0,0,0,,Sigurado ako
Dialogue: 0,0:01:58.23,0:02:00.94,general text,,0,0,0,,Kinumpirma ito ng kanyang kasambahay
Dialogue: 0,0:02:01.69,0:02:05.82,general text,,0,0,0,,So, siya mismo ang umabot sa ganoong taas?
Dialogue: 0,0:02:05.90,0:02:07.87,general text,,0,0,0,,Marahil siya ang naging magician ni Jeonjingak
Dialogue: 0,0:02:07.95,0:02:10.33,pangkalahatang teksto,,0,0,0,,salamat sa mga trick at suwerte
Dialogue: 0,0:02:10.41,0:02:11.91,general text,,0,0,0,,Ngunit wala siyang kakayahan
Dialogue: 0,0:02:11.99,0:02:14.79,pangkalahatang teksto,,0,0,0,,Sigurado akong narinig mo na ang aming argumento
Dialogue: 0,0:02:16.17,0:02:17.50,pangkalahatang teksto,,0,0,0,,Isang laban ang natitira
Dialogue: 0,0:02:19.21,0:02:20.25,pangkalahatang teksto,,0,0,0,,Tama ka
Dialogue: 0,0:02:20.34,0:02:23.88,pangkalahatang teksto,,0,0,0,,Pipigilan sana ng guro ang kanyang kahihiyan
Dialogue: 0,0:02:24.55,0:02:27.09,general text,,0,0,0,,Pagkatapos basahin ang "Words of the Heart", nakatanggap siya ng respeto
Dialogue: 0,0:02:27.18,0:02:29.18,general text,,0,0,0,,At pinahiya siya ng aming argumento
Dialogue: 0,0:02:29.26,0:02:32.77,general text,,0,0,0,,Matigas ang ulo niyang patuloy na lumaban
Dialogue: 0,0:02:32.85,0:02:34.43,pangkalahatang teksto,,0,0,0,,Kaya ito ay
Dialogue: 0,0:02:35.56,0:02:38.31,pangkalahatang teksto,,0,0,0,,mahalaga sa kanya
Dialogue: 0,0:02:41.69,0:02:43.44,memories,,0,0,0,,Okay ka lang? Nakikita mo ba?
Dialogue: 0,0:02:43.53,0:02:45.40,mga alaala,,0,0,0,,Oo. At ikaw, master?
Dialogue: 0,0:02:45.49,0:02:47.57,mga alaala,,0,0,0,,Hindi ka nasaktan?
Dialogue: 0,0:02:49.20,0:02:50.28,general text,,0,0,0,,Tama ka
Dialogue: 0,0:02:51.95,0:02:55.20,general text,,0,0,0,,Hindi ko naisip kung gaano kahalaga ang jade para sa kanya
Dialogue: 0,0:02:59.50,0:03:01.04,pangkalahatang teksto,,0,0,0,,Sa sandaling bumalik si Uk,
Dialogue: 0,0:03:01.71,0:03:03.96,general text,,0,0,0,,Bom gustong lumaban
Dialogue: 0,0:03:04.05,0:03:05.42,general text,,0,0,0,,Nangisda ba siya?
Dialogue: 0,0:03:06.30,0:03:08.51,general text,,0,0,0,,At pumikit si Moo Dok dito?
Dialogue: 0,0:03:09.64,0:03:11.14,pangkalahatang teksto,,0,0,0,,Malamang na hindi siya masaya tungkol dito
Dialogue: 0,0:03:11.22,0:03:14.72,general text,,0,0,0,,So napansin mo rin na nakikinig si Uk sa kanya
Dialogue: 0,0:03:14.81,0:03:18.77,general text,,0,0,0,,Siya ay matigas ang ulo, kahit anong sabihin ng sinuman sa kanya
Dialogue: 0,0:03:18.85,0:03:20.81,general text,,0,0,0,,Pero palagi siyang nakikinig kay Moo Deok
Dialogue: 0,0:03:23.86,0:03:26.61,mga alaala,,0,0,0,,Maaari nating protektahan ang mga halimaw mula sa mundong ito
Dialogue: 0,0:03:28.45,0:03:30.41,offscreen,,0,0,0,,Kinausap niya si Nak Soo noon
Dialogue: 0,0:03:32.95,0:03:37.37,voiceover,,0,0,0,,Kung naghahanap siya ng bato para protektahan siya...
Dialogue: 0,0:03:39.92,0:03:42.38,general text,,0,0,0,,- Hindi sila pwedeng magkasama\N- Ano?
Dialogue: 0,0:03:43.67,0:03:44.71,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:03:44.80,0:03:47.46,general text,,0,0,0,,Ayaw mo ba na close sila?
Dialogue: 0,0:03:49.84,0:03:50.84,pangkalahatang teksto,,0,0,0,,Hindi iyon ang punto
Dialogue: 0,0:03:51.34,0:03:54.72,pangkalahatang teksto,,0,0,0,,Kung maling landas ang kanilang pinili,
Dialogue: 0,0:03:56.93,0:03:59.39,pangkalahatang text,,0,0,0,,Hindi ko maiwasan
Dialogue: 0,0:04:08.36,0:04:14.45,italics,,0,0,0,,Ang UK ay maaaring magdala ng kaguluhan sa mundong ito
Dialogue: 0,0:04:15.58,0:04:19.46,pangkalahatang teksto,,0,0,0,,Biglang gagawin itong hindi makontrol ng aming suporta,
Dialogue: 0,0:04:19.54,0:04:22.00,pangkalahatang teksto,,0,0,0,,pagkatapos nito ay makaakit ng pansin?
Dialogue: 0,0:04:22.08,0:04:25.42,pangkalahatang teksto,,0,0,0,,Takot na makapasok siya sa trono at dalhin
Dialogue: 0,0:04:25.50,0:04:28.59,pangkalahatang teksto,,0,0,0,,kasiraan sa Deho?
Dialogue: 0,0:04:30.09,0:04:33.34,pangkalahatang teksto,,0,0,0,,Posible ito kung susundin niya ang bituin ng Hari
Dialogue: 0,0:04:33.93,0:04:35.89,pangkalahatang teksto,,0,0,0,,Palawakin nito ang kanyang pananaw
Dialogue: 0,0:04:35.97,0:04:40.52,pangkalahatang teksto,,0,0,0,,at ang pagnanais na makamit ang kadakilaan
Dialogue: 0,0:04:42.27,0:04:43.31,pangkalahatang teksto,,0,0,0,,Jin
Dialogue: 0,0:04:44.31,0:04:46.90,pangkalahatang teksto,,0,0,0,,Gaano katagal mo natutunan ang Chisa?
Dialogue: 0,0:04:47.73,0:04:48.69,pangkalahatang teksto,,0,0,0,,Chisu?
Dialogue: 0,0:04:49.19,0:04:52.32,general text,,0,0,0,,Mabilis kong na-master si Ryusu,
Dialogue: 0,0:04:52.40,0:04:56.58,pangkalahatang teksto,,0,0,0,,ngunit mas mahirap na makabisado si Chisu
Dialogue: 0,0:05:01.91,0:05:04.71,italics,,0,0,0,,Sa loob ng tatlong taon ay nag-aral ako upang maunawaan ang enerhiya ng langit
Dialogue: 0,0:05:05.83,0:05:08.46,italics,,0,0,0,,Inabot ng tatlong taon para magamit ang enerhiya ng mundo
Dialogue: 0,0:05:09.63,0:05:14.30,italics,,0,0,0,,at apat na taon para maramdaman ang enerhiya sa paligid
Dialogue: 0,0:05:16.43,0:05:20.43,italics,,0,0,0,,Ang lakas ng langit, lupa at tubig na dumadaloy sa pagitan nila
Dialogue: 0,0:05:21.31,0:05:24.31,italics,,0,0,0,,Nakabisado ko ang lahat ng ito sa loob ng sampung taon
Dialogue: 0,0:05:26.48,0:05:28.36,italics,,0,0,0,,at naintindihan si Chisa
Dialogue: 0,0:05:28.44,0:05:29.53,pangkalahatang teksto,,0,0,0,,Kahanga-hanga
Dialogue: 0,0:05:30.61,0:05:32.32,pangkalahatang teksto,,0,0,0,,Inabot ako ng 13 taon
Dialogue: 0,0:05:32.40,0:05:34.70,pangkalahatang teksto,,0,0,0,,Natutunan ni Yom ang lahat nang dalawang beses nang mas mahaba
Dialogue: 0,0:05:35.32,0:05:39.24,general text,,0,0,0,,pangalawa ako pagkatapos ng Chang Gang
Dialogue: 0,0:05:39.74,0:05:40.91,pangkalahatang teksto,,0,0,0,,Ito lang...
Dialogue: 0,0:05:48.59,0:05:52.21,pangkalahatang teksto,,0,0,0,,Nakikita natin ang enerhiya na dumadaloy sa pagitan ng langit at lupa,
Dialogue: 0,0:05:52.30,0:05:55.72,pangkalahatang teksto,,0,0,0,,ngunit sa esensya ito ay tubig lamang
Dialogue: 0,0:05:58.10,0:06:02.56,pangkalahatang teksto,,0,0,0,,Sinusubukan naming makabisado ito sa loob ng maraming taon
Dialogue: 0,0:06:04.39,0:06:06.94,pangkalahatang teksto,,0,0,0,,Ngunit may mga nagagawa ito mula sa kapanganakan
Dialogue: 0,0:06:24.16,0:06:26.62,italics,,0,0,0,,Sa madaling salita, mga henyo
Dialogue: 0,0:06:27.50,0:06:29.71,italics,,0,0,0,,Ngunit ang iba pang bahagi ng mundo
Dialogue: 0,0:06:29.79,0:06:33.51,italics,,0,0,0,,itinuturing silang walang ingat, hindi mapagkakatiwalaan
Dialogue: 0,0:06:33.59,0:06:36.22,italics,,0,0,0,,at minsan mapanganib
Dialogue: 0,0:06:39.51,0:06:40.60,pangkalahatang teksto,,0,0,0,,Ano ako...
Dialogue: 0,0:06:41.72,0:06:43.31,pangkalahatang teksto,,0,0,0,,kabisado si Chisu?
Dialogue: 0,0:06:46.44,0:06:49.10,italics,,0,0,0,,Dahil iba sila sa iba
Dialogue: 0,0:06:56.82,0:06:59.07,italics,,0,0,0,,May naiinggit sa kanila
Dialogue: 0,0:07:06.91,0:07:09.33,italics,,0,0,0,,Ang iba ay natatakot sa kanila
Dialogue: 0,0:07:12.00,0:07:13.42,general text,,0,0,0,,siguradong mananalo ako bukas
Dialogue: 0,0:07:16.17,0:07:17.47,general text,,0,0,0,,Nahuli ko siya
Dialogue: 0,0:07:19.84,0:07:21.01,general text,,0,0,0,,Talaga?
Dialogue: 0,0:07:21.68,0:07:22.76,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:07:23.85,0:07:25.06,general text,,0,0,0,,Nakabisado mo ang Chisa
Dialogue: 0,0:07:30.31,0:07:34.90,italics,,0,0,0,,Ganito ang reaksyon namin dahil hindi namin alam kung paano nila ginagamit ang kanilang hindi kapani-paniwalang kapangyarihan
Dialogue: 0,0:07:35.53,0:07:39.53,general text,,0,0,0,,Ililigtas ba niya ang mundo bilang Master So Kyung
Dialogue: 0,0:07:39.61,0:07:42.99,general text,,0,0,0,,o masisira ba ito? Hindi namin alam
Dialogue: 0,0:07:44.20,0:07:45.62,pangkalahatang teksto,,0,0,0,,Sa madaling salita,
Dialogue: 0,0:07:46.95,0:07:50.00,pangkalahatang text,,0,0,0,,patuloy mong panoorin siya?
Dialogue: 0,0:07:51.83,0:07:55.13,pangkalahatang teksto,,0,0,0,,Huwag mag-alala. Naiintindihan ko lahat
Dialogue: 0,0:07:57.38,0:07:59.34,pangkalahatang teksto,,0,0,0,,Kung kailangan mong alisin ang kapangyarihang ito,
Dialogue: 0,0:08:00.55,0:08:03.10,pangkalahatang teksto,,0,0,0,,Gagawin ko ito gamit ang sarili kong mga kamay
Dialogue: 0,0:08:10.06,0:08:11.98,general text,,0,0,0,,Chan Wook, tapos na ba ang parusa mo?
Dialogue: 0,0:08:12.06,0:08:13.31,general text,,0,0,0,,Kaya bumalik ako
Dialogue: 0,0:08:13.40,0:08:14.82,general text,,0,0,0,,So winasak mo si Jeonbugwan?
Dialogue: 0,0:08:14.90,0:08:16.15,pangkalahatang teksto,,0,0,0,,Huwag palakihin
Dialogue: 0,0:08:17.28,0:08:20.03,general text,,0,0,0,,- Hoy\N- Sa wakas nakabalik ka na
Dialogue: 0,0:08:20.74,0:08:23.66,general text,,0,0,0,,Ako ang iyong huling kalaban
Dialogue: 0,0:08:24.32,0:08:26.66,general text,,0,0,0,,- I see\N- Sayang hindi ka mananalo,
Dialogue: 0,0:08:27.70,0:08:31.92,general text,,0,0,0,,since ipaglalaban kita
Dialogue: 0,0:08:37.38,0:08:38.80,pangkalahatang teksto,,0,0,0,,Huwag mag-alala masyado
Dialogue: 0,0:08:39.46,0:08:41.88,general text,,0,0,0,,Sana maging kawili-wili ang huling laban
Dialogue: 0,0:08:42.72,0:08:43.80,pangkalahatang teksto,,0,0,0,, Umaasa sa iyo
Dialogue: 0,0:08:53.77,0:08:55.23,pangkalahatang teksto,,0,0,0,,Ano iyon?
Dialogue: 0,0:08:55.31,0:08:57.07,general text,,0,0,0,,May bago ba siyang natutunan?
Dialogue: 0,0:08:57.15,0:08:59.07,general text,,0,0,0,,Balita ko nangingisda lang siya
Dialogue: 0,0:08:59.15,0:09:01.57,general text,,0,0,0,,Don't worry, matapang lang siya
Dialogue: 0,0:09:02.61,0:09:06.78,general text,,0,0,0,,Ipapahiya ko siya sa harap ng Crown Prince
Dialogue: 0,0:09:08.83,0:09:09.95,pangkalahatang text,,0,0,0,,Your Highness
Dialogue: 0,0:09:10.75,0:09:13.54,general text,,0,0,0,,Natalo ang bobo kong master ng siyam na beses,
Dialogue: 0,0:09:13.62,0:09:17.42,pangkalahatang teksto,,0,0,0,,dahil nawalan ka ng siyam na gintong palaka
Dialogue: 0,0:09:18.05,0:09:20.38,general text,,0,0,0,,I don't dare look you in the eye
Dialogue: 0,0:09:22.76,0:09:24.22,general text,,0,0,0,,Huling laban ang natitira?
Dialogue: 0,0:09:24.30,0:09:26.09,general text,,0,0,0,,Nagsanay siya nang husto,
Dialogue: 0,0:09:26.18,0:09:28.51,general text,,0,0,0,,para hindi ka mabigo sa pagkakataong ito
Dialogue: 0,0:09:28.60,0:09:30.22,general text,,0,0,0,,Para hindi ako mabigo,
Dialogue: 0,0:09:30.81,0:09:31.89,general text,,0,0,0,,dapat siyang matalo
Dialogue: 0,0:09:36.48,0:09:39.07,general text,,0,0,0,,Tinanggap mo akong tanga
Dialogue: 0,0:09:39.15,0:09:42.19,pangkalahatang teksto,,0,0,0,,Ginamit ang aking ginto para sanayin ang kanyang master
Dialogue: 0,0:09:43.74,0:09:45.32,pangkalahatang teksto,,0,0,0,,Salamat sa tunggalian
Dialogue: 0,0:09:45.41,0:09:49.24,pangkalahatang teksto,,0,0,0,,natuwa kang panoorin ang kahihiyan ng may-ari
Dialogue: 0,0:09:49.33,0:09:51.91,pangkalahatang teksto,,0,0,0,,Sigurado akong sulit ito sa ginto
Dialogue: 0,0:09:52.75,0:09:54.41,pangkalahatang teksto,,0,0,0,,Oo, masaya
Dialogue: 0,0:09:54.50,0:09:56.67,general text,,0,0,0,,sana matalo na naman siya,
Dialogue: 0,0:09:57.46,0:10:00.00,general text,,0,0,0,,para umiyak ka kapag nawala ang jade mo
Dialogue: 0,0:10:00.67,0:10:02.88,general text,,0,0,0,,Si Chan Wook ang may kalahati, di ba?
Dialogue: 0,0:10:03.67,0:10:06.13,pangkalahatang teksto,,0,0,0,,Binigyan ka niya ng pangalawa,
Dialogue: 0,0:10:06.22,0:10:08.39,general text,,0,0,0,,so simbolo ito ng pag-ibig?
Dialogue: 0,0:10:10.76,0:10:12.56,general text,,0,0,0,,Ibinigay sa akin para gamitin ako?
Dialogue: 0,0:10:16.65,0:10:19.31,pangkalahatang teksto,,0,0,0,,Kung natalo si Uk,
Dialogue: 0,0:10:19.90,0:10:20.98,pangkalahatang teksto,,0,0,0,,Sisirain ko ang jade
Dialogue: 0,0:10:22.44,0:10:23.90,italics,,0,0,0,,Dapat may mawala sa iyo
Dialogue: 0,0:10:24.40,0:10:25.86,pangkalahatang teksto,,0,0,0,,Nakakahiya
Dialogue: 0,0:10:25.95,0:10:28.24,pangkalahatang teksto,,0,0,0,,Ang iyong magalang na pag-ibig ay lulubog sa limot
Dialogue: 0,0:10:33.54,0:10:34.96,pangkalahatang teksto,,0,0,0,,Gawin ang gusto mo
Dialogue: 0,0:10:35.91,0:10:37.33,pangkalahatang teksto,,0,0,0,,Nakumpleto ni Jade ang gawain nito
Dialogue: 0,0:10:37.42,0:10:39.58,general text,,0,0,0,,Pinilit ang may-ari na dumaan sa 10 laban
Dialogue: 0,0:10:39.67,0:10:42.71,general text,,0,0,0,,Sabi mo itataya mo ang buhay mo para sa jade
Dialogue: 0,0:10:43.96,0:10:46.47,pangkalahatang teksto,,0,0,0,,Kung kaya nating ipagsapalaran ang ating buhay para sa ating nararamdaman,
Dialogue: 0,0:10:47.88,0:10:51.22,pangkalahatang teksto,,0,0,0,,hindi makakaapekto sa kanila ang pagkawala ng batong ito
Dialogue: 0,0:10:58.40,0:11:00.98,general text,,0,0,0,,So wala kang pakialam kung mawala siya sa iyo o hindi?
Dialogue: 0,0:11:02.19,0:11:03.28,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:11:04.28,0:11:05.69,general text,,0,0,0,,Tapos itatapon ko
Dialogue: 0,0:11:16.16,0:11:17.75,pangkalahatang teksto,,0,0,0,,Kaya wala talagang ibig sabihin
Dialogue: 0,0:11:18.79,0:11:20.88,general text,,0,0,0,,Niloko mo ako
Dialogue: 0,0:11:20.96,0:11:23.25,pangkalahatang teksto,,0,0,0,,Sinabi niya na ito ang pinakamahalagang bagay
Dialogue: 0,0:11:23.34,0:11:26.17,general text,,0,0,0,,At kung hindi ka nag-aalala sa kanya, nagsinungaling ka
Dialogue: 0,0:11:27.38,0:11:29.59,general text,,0,0,0,,Paano ka magbabayad para sa isang kasinungalingan?
Dialogue: 0,0:11:29.68,0:11:31.43,general text,,0,0,0,,You're risking your life, right?
Dialogue: 0,0:11:32.10,0:11:33.22,pangkalahatang teksto,,0,0,0,,Mahusay
Dialogue: 0,0:11:34.06,0:11:36.73,pangkalahatang teksto,,0,0,0,,Nakataya ka sa oras na ito
Dialogue: 0,0:11:38.60,0:11:40.69,pangkalahatang teksto,,0,0,0,,nawalan na ako ng siyam na palaka
Dialogue: 0,0:11:41.31,0:11:42.77,general text,,0,0,0,,Ayokong mawalan ng isa pa
Dialogue: 0,0:11:42.86,0:11:44.61,general text,,0,0,0,,Magiging reward ka
Dialogue: 0,0:11:45.90,0:11:47.19,pangkalahatang teksto,,0,0,0,,sa laban na ito
Dialogue: 0,0:11:49.57,0:11:51.20,pangkalahatang text,,0,0,0,,Habang nag-order ka
Dialogue: 0,0:11:51.28,0:11:52.45,general text,,0,0,0,,Kung matatalo si Chang Wook,
Dialogue: 0,0:11:53.41,0:11:56.37,general text,,0,0,0,,ikaw ang magiging maid ng mananalo
Dialogue: 0,0:11:57.62,0:12:00.92,general text,,0,0,0,,Oo, pag-iisipan ko
Dialogue: 0,0:12:16.77,0:12:19.60,general text,,0,0,0,,So ikaw ang huling kalaban ni Chan Wook?
Dialogue: 0,0:12:20.98,0:12:22.60,pangkalahatang teksto,,0,0,0,,Ako si Cha Bum
Dialogue: 0,0:12:22.69,0:12:24.40,general text,,0,0,0,, mananalo ako kahit anong mangyari
Dialogue: 0,0:12:25.44,0:12:27.19,pangkalahatang teksto,,0,0,0,,Dapat mong
Dialogue: 0,0:12:27.28,0:12:28.82,general text,,0,0,0,,Kung matatalo ka,
Dialogue: 0,0:12:28.90,0:12:31.57,general text,,0,0,0,,Sisiguraduhin kong hindi ka magtatagumpay bilang isang salamangkero
Dialogue: 0,0:12:33.41,0:12:35.33,general text,,0,0,0,,Maaari mo bang ibigay ang sahig?
Dialogue: 0,0:12:36.58,0:12:39.62,pangkalahatang teksto,,0,0,0,,Palaging may posibilidad...
Dialogue: 0,0:12:39.70,0:12:40.83,pangkalahatang teksto,,0,0,0,,Sapat na!
Dialogue: 0,0:12:41.96,0:12:44.25,general text,,0,0,0,,Kailangan ko ng siguradong mananalo
Dialogue: 0,0:12:44.33,0:12:45.71,pangkalahatang teksto,,0,0,0,,Ibigay mo sa akin ang iyong salita
Dialogue: 0,0:12:45.79,0:12:48.34,general text,,0,0,0,,Natatakot akong hindi ko kaya, Kamahalan
Dialogue: 0,0:12:48.42,0:12:50.09,general text,,0,0,0,,Walang iba kundi siya...
Dialogue: 0,0:12:51.93,0:12:53.47,pangkalahatang teksto,,0,0,0,,hindi magbibigay ng salitang ito
Dialogue: 0,0:12:55.10,0:12:58.52,pangkalahatang teksto,,0,0,0,,Isang tao na lang ang natitira,
Dialogue: 0,0:12:59.60,0:13:01.18,general text,,0,0,0,,sino ang mananalo
Dialogue: 0,0:13:01.27,0:13:02.27,pangkalahatang teksto,,0,0,0,,So Yul
Dialogue: 0,0:13:08.23,0:13:09.48,general text,,0,0,0,,So Yul?
Dialogue: 0,0:13:22.12,0:13:24.25,pangkalahatang teksto,,0,0,0,,Ang hindi pagkakaunawaan ay hindi seryoso
Dialogue: 0,0:13:25.08,0:13:27.09,general text,,0,0,0,,Pero iniinis niya ako
Dialogue: 0,0:13:27.17,0:13:31.67,general text,,0,0,0,,Nawalan ako ng siyam na palaka para ilagay si Uka sa kanyang pwesto
Dialogue: 0,0:13:32.26,0:13:35.64,general text,,0,0,0,,Imagine kung gaano ako katawa magmumukha,
Dialogue: 0,0:13:35.72,0:13:39.60,general text,,0,0,0,,kung nanalo siya sa huling laban
Dialogue: 0,0:13:41.14,0:13:43.73,general text,,0,0,0,,Kaya kailangan ko ng siguradong mananalo
Dialogue: 0,0:13:43.81,0:13:46.48,pangkalahatang teksto,,0,0,0,,Ikaw ang pinakamahusay na mago ni Jeongjingak at ng aking pinsan
Dialogue: 0,0:13:46.56,0:13:48.02,general text,,0,0,0,,Sigurado akong ikaw lang
Dialogue: 0,0:13:49.69,0:13:52.99,general text,,0,0,0,,alam kong kaibigan mo siya
Dialogue: 0,0:13:54.74,0:13:58.16,pangkalahatang teksto,,0,0,0,,Ngunit bilang isang prinsipe at iyong pinsan,
Dialogue: 0,0:13:58.91,0:14:00.49,pangkalahatang teksto,,0,0,0,,Humihingi ako ng iyong tulong
Dialogue: 0,0:14:04.33,0:14:05.62,general text,,0,0,0,,Okay, Your Highness
Dialogue: 0,0:14:07.92,0:14:08.75,general text,,0,0,0,,Talaga?
Dialogue: 0,0:14:09.92,0:14:11.88,general text,,0,0,0,,Aawayin mo ba siya?
Dialogue: 0,0:14:12.46,0:14:13.67,general text,,0,0,0,,ako ang mananalo
Dialogue: 0,0:14:14.38,0:14:15.84,pangkalahatang teksto,,0,0,0,,Ibinibigay ko ang aking salita
Dialogue: 0,0:14:17.01,0:14:20.47,pangkalahatang teksto,,0,0,0,, Eksakto. Sa lahat ng tao, ikaw lang ang makakaya
Dialogue: 0,0:14:20.56,0:14:22.93,general text,,0,0,0,,Nangako talaga si Mu Dok na maglilingkod
Dialogue: 0,0:14:23.02,0:14:24.85,general text,,0,0,0,,winner?
Dialogue: 0,0:14:24.93,0:14:27.56,pangkalahatang teksto,,0,0,0,,Oo, sa halip na mga palaka ang inilagay niya
Dialogue: 0,0:14:32.61,0:14:34.65,pangkalahatang teksto,,0,0,0,,sa iyong sarili
Dialogue: 0,0:14:34.74,0:14:36.70,general text,,0,0,0,,Tapos matatalo ko si Uka
Dialogue: 0,0:14:38.07,0:14:39.82,general text,,0,0,0,,at gagawin ko siyang maid
Dialogue: 0,0:14:44.37,0:14:45.50,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:14:46.12,0:14:48.54,general text,,0,0,0,,huling kalaban ni Chang Wook, humarap ka
Dialogue: 0,0:15:16.82,0:15:17.82,pangkalahatang teksto,,0,0,0,,Chang Wook,
Dialogue: 0,0:15:18.91,0:15:20.78,pangkalahatang teksto,,0,0,0,,labanan ka ngayon
Dialogue: 0,0:15:21.49,0:15:22.74,pangkalahatang teksto,,0,0,0,,Ako ay magiging
Dialogue: 0,0:15:42.01,0:15:45.01,general text,,0,0,0,,Nakikipag-away ba si So Yul sa kanya para manalo siya?
Dialogue: 0,0:15:45.10,0:15:46.10,italics,,0,0,0,,Hindi
Dialogue: 0,0:15:46.18,0:15:49.27,italics,,0,0,0,,Nang magboluntaryo si Dan Gu, sumuko agad si Chang Wook
Dialogue: 0,0:15:49.35,0:15:50.77,italics,,0,0,0,,Hindi niya hahayaang manalo si Uku
Dialogue: 0,0:15:50.85,0:15:54.40,general text,,0,0,0,,Ibinigay niya sa prinsipe ang kanyang salita na matatalo niya si Chan Wook
Dialogue: 0,0:15:58.65,0:15:59.90,pangkalahatang teksto,,0,0,0,,Magsimula
Dialogue: 0,0:16:14.92,0:16:16.21,behind the scenes,,0,0,0,,Tama si Yul
Dialogue: 0,0:16:16.92,0:16:19.09,pangkalahatang teksto,,0,0,0,,Lubos na bumuti ang UK
Dialogue: 0,0:16:34.11,0:16:35.52,general text,,0,0,0,,Ito ang aking protective spell
Dialogue: 0,0:16:35.61,0:16:36.73,general text,,0,0,0,,Kailan niya ito na-master?
Dialogue: 0,0:16:38.57,0:16:41.32,italics,,0,0,0,,Natutunan niya lahat ng nakita niya sa mga nakaraang laban
Dialogue: 0,0:16:41.40,0:16:45.33,general text,,0,0,0,,Nakabisado na ba niya ang spells ng mga naunang kalaban?
Dialogue: 0,0:16:45.41,0:16:49.16,pangkalahatang teksto,,0,0,0,,Natutunan niya ang mga spelling na nakita niya at inulit ang mga ito
Dialogue: 0,0:17:49.22,0:17:50.35,pangkalahatang teksto,,0,0,0,,Ginawa niya
Dialogue: 0,0:18:26.34,0:18:27.84,general text,,0,0,0,,Tapos na ang laban
Dialogue: 0,0:18:27.93,0:18:30.43,general text,,0,0,0,,Kaya nanalo si Yul
Dialogue: 0,0:18:34.56,0:18:35.69,pangkalahatang teksto,,0,0,0,,alam ko
Dialogue: 0,0:18:37.10,0:18:39.90,general text,,0,0,0,,Natalo ang UK sa lahat ng sampung laban
Dialogue: 0,0:18:40.69,0:18:43.65,general text,,0,0,0,,Paano niya ginamit ang Tansa sa dulo?
Dialogue: 0,0:18:43.74,0:18:46.78,italics,,0,0,0,,Kinuha niya ang enerhiya sa hangin at ginawa itong tubig
Dialogue: 0,0:18:46.86,0:18:47.78,pangkalahatang text,,0,0,0,,Huwag kang nakakatawa
Dialogue: 0,0:18:48.70,0:18:51.41,pangkalahatang teksto,,0,0,0,, Tanging ang mga nagmamay-ari ng Chisu ang makakagawa nito
Dialogue: 0,0:19:03.84,0:19:05.21,general text,,0,0,0,,Kailan mo natutunan si Chisa?
Dialogue: 0,0:19:05.80,0:19:09.51,pangkalahatang teksto,,0,0,0,,Sinabi ko kahapon na may sasabihin ako sa iyo ng kamangha-manghang
Dialogue: 0,0:19:09.59,0:19:11.05,pangkalahatang teksto,,0,0,0,,Iyan ay mahusay
Dialogue: 0,0:19:11.85,0:19:13.22,pangkalahatang teksto,,0,0,0,,Binabati kita
Dialogue: 0,0:19:13.31,0:19:14.18,pangkalahatang teksto,,0,0,0,,Chan Wook!
Dialogue: 0,0:19:15.18,0:19:17.64,general text,,0,0,0,,Nakabisado mo si Chisu. Binabati kita, buddy!
Dialogue: 0,0:19:18.65,0:19:19.60,italics,,0,0,0,,Nakita mo ba?
Dialogue: 0,0:19:20.23,0:19:22.94,pangkalahatang teksto,,0,0,0,,Kabisado na ng ating Chan Wook ang Chisa!
Dialogue: 0,0:19:24.28,0:19:26.03,general text,,0,0,0,,- Talaga?\N- Hoy
Dialogue: 0,0:19:26.11,0:19:28.07,general text,,0,0,0,,- Congratulations\N- Congratulations
Dialogue: 0,0:19:28.15,0:19:30.62,italics,,0,0,0,,- Amazing\N- Congratulations
Dialogue: 0,0:19:30.70,0:19:31.78,pangkalahatang teksto,,0,0,0,,Hey
Dialogue: 0,0:19:32.95,0:19:34.45,pangkalahatang teksto,,0,0,0,, Oras sa Saejukwon
Dialogue: 0,0:19:43.75,0:19:46.21,pangkalahatang teksto,,0,0,0,,Umalis si Moo Dok kasama ang prinsipe
Dialogue: 0,0:19:46.80,0:19:49.47,pangkalahatang teksto,,0,0,0,,Marahil tinatalakay ang pagtatapos ng hindi pagkakaunawaan
Dialogue: 0,0:19:49.55,0:19:52.22,general text,,0,0,0,,Nag-aalala lang ako na may gagawin ulit sila.
Dialogue: 0,0:19:52.30,0:19:53.97,pangkalahatang text,,0,0,0,,Titingnan ko
Dialogue: 0,0:19:54.06,0:19:57.56,pangkalahatang teksto,,0,0,0,,Oo. Ingatan mo siya. Ikaw ang may-ari niya ngayon
Dialogue: 0,0:20:01.69,0:20:04.11,pangkalahatang teksto,,0,0,0,,Kaya gusto naming mag-isip ang prinsipe
Dialogue: 0,0:20:06.15,0:20:08.78,general text,,0,0,0,,So Yul, pumunta ka kay Moo Deok
Dialogue: 0,0:20:08.86,0:20:10.61,general text,,0,0,0,,Uk, at kasama kita sa Saejukwon
Dialogue: 0,0:20:11.32,0:20:13.32,general text,,0,0,0,,Tara na. Magmadali
Dialogue: 0,0:20:14.58,0:20:16.54,italics,,0,0,0,,- Mag-ingat. Well!\N- Masakit
Dialogue: 0,0:20:16.62,0:20:18.12,italics,,0,0,0,,Tingnan mo sa ilalim ng iyong mga paa
Dialogue: 0,0:20:23.25,0:20:27.42,general text,,0,0,0,,Gaya ng sinabi mo, natalo lahat ng may-ari ng sampung beses
Dialogue: 0,0:20:28.05,0:20:29.84,general text,,0,0,0,,Panalo ka, Your Highness
Dialogue: 0,0:20:30.72,0:20:34.39,general text,,0,0,0,,Alam mo naman na kabisado niya si Chisu
Dialogue: 0,0:20:35.97,0:20:38.77,pangkalahatang teksto,,0,0,0,,Kaya matapang kong inilagay ang aking sarili sa linya
Dialogue: 0,0:20:38.85,0:20:41.06,general text,,0,0,0,,Kung hindi tumanggi si Cha Bum sa laban,
Dialogue: 0,0:20:41.73,0:20:43.40,pangkalahatang teksto,,0,0,0,,manalo ang may-ari
Dialogue: 0,0:20:44.81,0:20:46.48,pangkalahatang teksto,,0,0,0,,Hindi na siya ang iyong panginoon
Dialogue: 0,0:20:48.36,0:20:50.36,pangkalahatang teksto,,0,0,0,,Ngayon ay naglilingkod ka kay Seo Yul
Dialogue: 0,0:20:53.24,0:20:56.03,general text,,0,0,0,,Sabi mo pareho kayo ng nararamdaman
Dialogue: 0,0:20:57.37,0:20:58.45,pangkalahatang teksto,,0,0,0,,Mahusay
Dialogue: 0,0:20:59.29,0:21:01.96,general text,,0,0,0,,Sana hindi mo sila mawala habang naglilingkod ka sa iba
Dialogue: 0,0:21:24.40,0:21:25.77,italics,,0,0,0,,Nakakatawa ito
Dialogue: 0,0:21:25.86,0:21:28.15,pangkalahatang text,,0,0,0,,Paano niya na-master si Chisa nang ganoon kabilis?
Dialogue: 0,0:21:28.23,0:21:30.86,general text,,0,0,0,,Totoo. Nakita na namin lahat
Dialogue: 0,0:21:31.49,0:21:32.36,general text,,0,0,0,,Talaga?
Dialogue: 0,0:22:00.56,0:22:02.27,pangkalahatang teksto,,0,0,0,,Banal na langit!
Dialogue: 0,0:22:03.56,0:22:05.77,general text,,0,0,0,,Talagang henyo ka!
Dialogue: 0,0:22:05.85,0:22:07.40,general text,,0,0,0,,Tama, Uk!
Dialogue: 0,0:22:07.48,0:22:09.65,general text,,0,0,0,,- Masakit\N- Sorry
Dialogue: 0,0:22:10.69,0:22:12.36,general text,,0,0,0,,Master Huo, nasasaktan ako
Dialogue: 0,0:22:12.94,0:22:15.20,general text,,0,0,0,,Sumali ka dahil nag-aalala ka,
Dialogue: 0,0:22:15.28,0:22:17.41,general text,,0,0,0,,na kailangan kong pagsilbihan si Cha Bum, di ba?
Dialogue: 0,0:22:17.49,0:22:19.83,pangkalahatang teksto,,0,0,0,,Salamat sa iyong kabutihan
Dialogue: 0,0:22:19.91,0:22:21.70,pangkalahatang teksto,,0,0,0,,Ngayon pagsilbihan mo ako
Dialogue: 0,0:22:22.75,0:22:25.37,general text,,0,0,0,,Ito ang pangako ko sa prinsipe
Dialogue: 0,0:22:26.04,0:22:27.67,general text,,0,0,0,,At kailangan kong magpanggap na sinusundan ito
Dialogue: 0,0:22:27.75,0:22:28.84,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:22:28.92,0:22:32.42,pangkalahatang teksto,,0,0,0,,Kung kailangan mo ng anuman, magsalita anumang oras
Dialogue: 0,0:22:32.51,0:22:33.67,pangkalahatang teksto,,0,0,0,,Walang kailangan
Dialogue: 0,0:22:34.22,0:22:36.34,pangkalahatang teksto,,0,0,0,,Maaari mong bisitahin ang Uka anumang oras
Dialogue: 0,0:22:38.22,0:22:39.39,pangkalahatang teksto,,0,0,0,,Meron akong
Dialogue: 0,0:22:40.97,0:22:42.60,pangkalahatang text,,0,0,0,,isang kahilingan lang
Dialogue: 0,0:22:44.27,0:22:47.60,general text,,0,0,0,,Pagkatapos ko ng pag-aaral, babalik ako sa Soho
Dialogue: 0,0:22:48.56,0:22:50.61,pangkalahatang text,,0,0,0,,Gusto kong magsama ng isang tao
Dialogue: 0,0:22:51.52,0:22:53.48,pangkalahatang text,,0,0,0,,Tulungan mo ako
Dialogue: 0,0:22:54.90,0:22:55.95,pangkalahatang teksto,,0,0,0,,gawin mo
Dialogue: 0,0:22:57.78,0:23:00.24,pangkalahatang text,,0,0,0,,Hindi ko alam na may ganyan kang tao
Dialogue: 0,0:23:00.32,0:23:03.62,pangkalahatang teksto,,0,0,0,,Ibigay ang iyong salita. Promise tutulungan kita
Dialogue: 0,0:23:07.87,0:23:10.42,pangkalahatang teksto,,0,0,0,,Tanong mo sa pagiging amo ko
Dialogue: 0,0:23:11.00,0:23:13.05,general text,,0,0,0,,Tutulungan talaga kita
Dialogue: 0,0:23:24.14,0:23:27.31,pangkalahatang teksto,,0,0,0,,Mayroon na ngayong lumulunok ng kaluluwa sa Saejukwon
Dialogue: 0,0:23:27.39,0:23:29.15,general text,,0,0,0,,At dinala mo dito si Uka
Dialogue: 0,0:23:29.23,0:23:31.56,pangkalahatang teksto,,0,0,0,,Ano ang maaari kong gawin? Nasugatan siya
Dialogue: 0,0:23:32.15,0:23:35.32,general text,,0,0,0,,Sinabi ko sa kanya na magpahinga ng ilang araw
Dialogue: 0,0:23:36.61,0:23:38.65,general text,,0,0,0,,- Malubhang nasugatan ba siya?\N- Hindi
Dialogue: 0,0:23:38.74,0:23:40.16,pangkalahatang teksto,,0,0,0,,Walang seryoso
Dialogue: 0,0:23:41.49,0:23:44.91,general text,,0,0,0,,Paano niya kayang labanan si Yul ng walang ingat
Dialogue: 0,0:23:44.99,0:23:47.54,pangkalahatang teksto,,0,0,0,,Ipagpapatuloy ko ang pangingisda kasama si Master Li
Dialogue: 0,0:23:47.62,0:23:49.29,general text,,0,0,0,,Hindi mo na dapat siya tinawagan pabalik
Dialogue: 0,0:23:50.21,0:23:53.88,pangkalahatang teksto,,0,0,0,,Hindi lang isda ang nagawa nila
Dialogue: 0,0:23:55.84,0:23:59.05,general text,,0,0,0,,Uk, such a bastard, mastered Chisu
Dialogue: 0,0:23:59.88,0:24:00.89,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:24:02.30,0:24:03.76,pangkalahatang teksto,,0,0,0,,Hindi kapani-paniwala, tama ba?
Dialogue: 0,0:24:03.85,0:24:05.26,italics,,0,0,0,,Hindi maintindihan
Dialogue: 0,0:24:05.35,0:24:07.22,general text,,0,0,0,,Henyo talaga siya!
Dialogue: 0,0:24:15.11,0:24:17.53,pangkalahatang teksto,,0,0,0,,Ano ang iyong pinag-aralan
Dialogue: 0,0:24:18.36,0:24:22.24,pangkalahatang teksto,,0,0,0,,habang nangingisda
Dialogue: 0,0:24:22.32,0:24:23.95,pangkalahatang teksto,,0,0,0,,kasama si Master Li?
Dialogue: 0,0:24:25.62,0:24:27.50,general text,,0,0,0,,Natuto akong manghuli ng Goldfish
Dialogue: 0,0:24:27.58,0:24:30.92,general text,,0,0,0,,Kaya gusto niyang tulungan kang master Chisa
Dialogue: 0,0:24:31.50,0:24:34.59,general text,,0,0,0,,- Kinuha ka ba niya bilang isang estudyante?{\i1}\N- Hindi talaga
Dialogue: 0,0:24:34.67,0:24:36.63,general text,,0,0,0,,May dahilan kung bakit niya ako tinutulungan
Dialogue: 0,0:24:37.59,0:24:39.97,pangkalahatang teksto,,0,0,0,,Alin?
Dialogue: 0,0:24:41.18,0:24:43.97,italics,,0,0,0,,Master sa iyo
Dialogue: 0,0:24:44.72,0:24:45.89,pangkalahatang teksto,,0,0,0,,isang bagay...
Dialogue: 0,0:24:47.43,0:24:48.72,pangkalahatang teksto,,0,0,0,,sinabi?
Dialogue: 0,0:24:50.64,0:24:52.48,pangkalahatang teksto,,0,0,0,,Ito ay may kinalaman sa aking pamilya
Dialogue: 0,0:24:52.56,0:24:54.98,general text,,0,0,0,,Napansin ko ito mismo at tinanong ko siya ng diretso
Dialogue: 0,0:24:59.28,0:25:02.45,general text,,0,0,0,,Mukhang alam mo rin ito
Dialogue: 0,0:25:04.99,0:25:06.20,pangkalahatang teksto,,0,0,0,, umaasa ako
Dialogue: 0,0:25:08.24,0:25:09.79,pangkalahatang teksto,,0,0,0,,na hindi mo makikilala
Dialogue: 0,0:25:10.71,0:25:11.96,italics,,0,0,0,,Hindi
Dialogue: 0,0:25:12.04,0:25:15.25,general text,,0,0,0,,Hindi ako nakapikit dito nang malaman ko ang lahat.
Dialogue: 0,0:25:16.67,0:25:18.17,italics,,0,0,0,,Ano ang gagawin mo ngayon?
Dialogue: 0,0:25:22.72,0:25:23.97,pangkalahatang text,,0,0,0,,Kasama ang maid Kim
Dialogue: 0,0:25:32.48,0:25:33.81,pangkalahatang teksto,,0,0,0,,Ano ang kinalaman niya dito?
Dialogue: 0,0:25:33.89,0:25:36.56,general text,,0,0,0,,Sinusubukan ni Master Lee na ligawan ang maid na si Kim,
Dialogue: 0,0:25:36.65,0:25:38.61,pangkalahatang teksto,,0,0,0,, tinutulungan ako
Dialogue: 0,0:25:39.94,0:25:41.49,general text,,0,0,0,,So ano ang gagawin mo?
Dialogue: 0,0:25:42.70,0:25:47.24,pangkalahatang teksto,,0,0,0,,Magandang tao si Master Li na nakatulong sa akin ng husto
Dialogue: 0,0:25:48.87,0:25:49.70,italics,,0,0,0,,Ngunit pa rin
Dialogue: 0,0:25:50.70,0:25:54.12,general text,,0,0,0,,Akala ko bigyan muna kita ng chance
Dialogue: 0,0:25:54.21,0:25:55.79,pangkalahatang teksto,,0,0,0,,Kung isasaalang-alang natin ang ating relasyon
Dialogue: 0,0:25:59.55,0:26:01.01,pangkalahatang teksto,,0,0,0,,Anong pagkakataon?
Dialogue: 0,0:26:02.13,0:26:05.22,general text,,0,0,0,,Alam mo ba na kasama natin si Master Li?
Dialogue: 0,0:26:06.34,0:26:08.93,general text,,0,0,0,,At iniisip ko kung saan siya tumigil
Dialogue: 0,0:26:09.01,0:26:11.22,general text,,0,0,0,,Kaya tumira siya sa bahay mo
Dialogue: 0,0:26:11.31,0:26:12.31,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:26:12.39,0:26:15.56,general text,,0,0,0,,Nandito ako ngayon, at malamang umiinom sila ng tsaa doon, nag-uusap.
Dialogue: 0,0:26:15.64,0:26:17.73,general text,,0,0,0,,Napakabait ng maid na si Kim
Dialogue: 0,0:26:17.81,0:26:20.32,pangkalahatang teksto,,0,0,0,,Mahilig siyang alagaan at pakainin ang iba
Dialogue: 0,0:26:20.40,0:26:22.82,pangkalahatang text,,0,0,0,,Ilang oras bago siya ma-in love sa kanya
Dialogue: 0,0:26:24.90,0:26:26.61,general text,,0,0,0,,Sana talaga
Dialogue: 0,0:26:26.70,0:26:29.53,general text,,0,0,0,,na magpapakasal siya sa isang mabuting lalaki
Dialogue: 0,0:26:32.91,0:26:34.54,pangkalahatang teksto,,0,0,0,,Kung ayaw mo,
Dialogue: 0,0:26:35.37,0:26:38.21,pangkalahatang teksto,,0,0,0,,Gusto ko silang suportahan
Dialogue: 0,0:26:51.85,0:26:54.73,pangkalahatang teksto,,0,0,0,,Si Master Li ay dalawang beses sa kanyang edad
Dialogue: 0,0:26:55.31,0:26:58.56,general text,,0,0,0,,Pero mas bata siya sayo
Dialogue: 0,0:26:58.65,0:27:00.19,italics,,0,0,0,,Kalokohan pa rin ito
Dialogue: 0,0:27:00.27,0:27:03.48,pangkalahatang teksto,,0,0,0,,Nagsasagawa siya ng kalinisang-puri
Dialogue: 0,0:27:04.36,0:27:06.11,general text,,0,0,0,,Paano sila magpakasal?
Dialogue: 0,0:27:06.70,0:27:10.24,general text,,0,0,0,,Pinigilan ko ang instincts ko para sa training, pero agad ding nakabawi.
Dialogue: 0,0:27:10.32,0:27:11.87,pangkalahatang teksto,,0,0,0,,Posible
Dialogue: 0,0:27:11.95,0:27:13.99,pangkalahatang teksto,,0,0,0,,Ang kasal ay dapat sa pamamagitan ng mutual consent
Dialogue: 0,0:27:15.25,0:27:17.21,pangkalahatang teksto,,0,0,0,, Dapat gusto rin niya
Dialogue: 0,0:27:17.29,0:27:18.96,pangkalahatang teksto,,0,0,0,,Siya sa lahat ng mga taon na ito
Dialogue: 0,0:27:19.96,0:27:23.75,pangkalahatang teksto,,0,0,0,,mahal ng isang tao
Dialogue: 0,0:27:25.21,0:27:26.38,pangkalahatang teksto,,0,0,0,,Jin
Dialogue: 0,0:27:26.47,0:27:32.43,general text,,0,0,0,,Sa tingin mo ba mahal pa rin niya si Chang Gang?
Dialogue: 0,0:27:34.35,0:27:36.73,pangkalahatang text,,0,0,0,,Kilala ko siya nang higit kaninuman
Dialogue: 0,0:27:37.31,0:27:40.27,pangkalahatang teksto,,0,0,0,,Kaya hinihiling ko sa iyo, huwag magmadaling magdesisyon
Dialogue: 0,0:27:42.31,0:27:44.73,pangkalahatang teksto,,0,0,0,,Ano ang dapat kong gawin sa iyo?
Dialogue: 0,0:27:44.82,0:27:46.86,general text,,0,0,0,,At may tinatawag siyang tanga,
Dialogue: 0,0:27:46.94,0:27:49.41,pangkalahatang teksto,,0,0,0,, kapag wala siyang nakikita sa ilalim ng kanyang ilong
Dialogue: 0,0:27:49.49,0:27:50.87,pangkalahatang teksto,,0,0,0,,Ano ang alam mo!
Dialogue: 0,0:27:51.45,0:27:54.29,pangkalahatang teksto,,0,0,0,,Matagal na siyang tumigil sa pagmamahal kay Chang Gan
Dialogue: 0,0:28:18.98,0:28:20.23,pangkalahatang teksto,,0,0,0,,Sa araw na iyon
Dialogue: 0,0:28:21.85,0:28:23.15,general text,,0,0,0,,nandito din siya
Dialogue: 0,0:28:27.99,0:28:30.07,pangkalahatang teksto,,0,0,0,,Ito ay bagong timplang quince tea
Dialogue: 0,0:28:30.15,0:28:31.24,pangkalahatang teksto,,0,0,0,,Ang sarap na bango
Dialogue: 0,0:28:32.87,0:28:35.74,pangkalahatang teksto,,0,0,0,,Hindi magandang panatilihin ang mga lantang bulaklak sa bahay
Dialogue: 0,0:28:35.83,0:28:38.08,pangkalahatang text,,0,0,0,,Dumating na ang malamig na panahon, mahirap nang makahanap ng mga bulaklak ngayon
Dialogue: 0,0:28:38.79,0:28:40.71,pangkalahatang teksto,,0,0,0,,Ngunit makikinig ako sa iyo at itatapon ko sila
Dialogue: 0,0:28:42.04,0:28:43.71,pangkalahatang teksto,,0,0,0,,Nagustuhan ko ang paraan ng mga bulaklak
Dialogue: 0,0:28:43.79,0:28:45.67,pangkalahatang text,,0,0,0,,pinagsama ako
Dialogue: 0,0:28:59.98,0:29:03.02,general text,,0,0,0,,Nakalimutan ko na ang mga cups at isang teapot lang ang dala ko.
Dialogue: 0,0:29:09.61,0:29:11.61,general text,,0,0,0,,Paano sila mamumulaklak muli?
Dialogue: 0,0:29:12.78,0:29:14.57,general text,,0,0,0,,Ginawa ito ni Master Li?
Dialogue: 0,0:29:16.53,0:29:17.37,pangkalahatang teksto,,0,0,0,,Ang ganda
Dialogue: 0,0:29:34.76,0:29:36.01,pangkalahatang teksto,,0,0,0,,Dapat,
Dialogue: 0,0:29:36.97,0:29:39.22,general text,,0,0,0,,binigyan niya siya ng mga bulaklak
Dialogue: 0,0:29:40.85,0:29:42.43,pangkalahatang teksto,,0,0,0,,sa araw na iyon
Dialogue: 0,0:29:51.07,0:29:53.57,pangkalahatang teksto,,0,0,0,,Master Li, napakabait mo at nakikiramay
Dialogue: 0,0:29:54.45,0:29:55.61,pangkalahatang teksto,,0,0,0,,Ako?
Dialogue: 0,0:29:56.28,0:29:58.78,pangkalahatang teksto,,0,0,0,,Manatili dito hangga't gusto mo
Dialogue: 0,0:29:58.87,0:30:00.62,general text,,0,0,0,,Ako na ang bahala sa iyo
Dialogue: 0,0:30:02.33,0:30:03.41,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:30:06.63,0:30:09.13,general text,,0,0,0,,Asawa ba ni Chang Gan ang babaeng ito?
Dialogue: 0,0:30:11.46,0:30:14.63,general text,,0,0,0,,Oo, maganda, tama ba?
Dialogue: 0,0:30:14.72,0:30:18.39,general text,,0,0,0,,Si Jin ba ang na-inlove sa kanya? sabi ni Yeom
Dialogue: 0,0:30:21.97,0:30:27.02,general text,,0,0,0,,Hindi siya nalanta at pinanatiling buo ang kanyang kagandahan
Dialogue: 0,0:30:28.81,0:30:31.53,italics,,0,0,0,,Siguro kaya hindi pa rin niya ito makalimutan.
Dialogue: 0,0:30:32.94,0:30:34.28,pangkalahatang teksto,,0,0,0,,O
Dialogue: 0,0:30:35.11,0:30:36.66,general text,,0,0,0,,ayaw lang niya sa akin
Dialogue: 0,0:30:37.49,0:30:38.70,pangkalahatang text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:30:44.83,0:30:46.92,general text,,0,0,0,,Naiintindihan ko, iyon ang utos ng prinsipe
Dialogue: 0,0:30:47.00,0:30:49.25,general text,,0,0,0,,Pero paano niya pagbawalan si Moo Deok na bisitahin ako?
Dialogue: 0,0:30:49.34,0:30:51.17,pangkalahatang teksto,,0,0,0,,Lagi siyang nag-aalala
Dialogue: 0,0:30:51.25,0:30:53.84,italics,,0,0,0,,I'm sure busy lang siya.
Dialogue: 0,0:30:53.92,0:30:55.72,general text,,0,0,0,,Sinabi ko sa kanya na ayos ka lang
Dialogue: 0,0:30:55.80,0:30:56.72,italics,,0,0,0,,Well, hindi
Dialogue: 0,0:30:56.80,0:30:59.22,pangkalahatang teksto,,0,0,0,,Sa tingin mo ba ay agad siyang napahinga pagkatapos ng iyong mga salita?
Dialogue: 0,0:30:59.85,0:31:00.93,pangkalahatang teksto,,0,0,0,,Kailangan nating suriin
Dialogue: 0,0:31:02.10,0:31:03.02,pangkalahatang teksto,,0,0,0,,Halika rito
Dialogue: 0,0:31:06.06,0:31:07.98,pangkalahatang text,,0,0,0,,Magdudulot lang ito ng sakit sa iyo
Dialogue: 0,0:31:09.69,0:31:13.98,pangkalahatang teksto,,0,0,0,,Ang ibong ito ay naghahatid ng aking mga sulat sa Soho
Dialogue: 0,0:31:16.95,0:31:20.91,pangkalahatang teksto,,0,0,0,,Tatlo hanggang apat na araw bago makarating doon sakay ng kabayo
Dialogue: 0,0:31:20.99,0:31:22.66,pangkalahatang teksto,,0,0,0,,Maaari bang lumipad ang isang ibon sa ganitong distansya?
Dialogue: 0,0:31:23.24,0:31:24.37,pangkalahatang teksto,,0,0,0,,Hindi kapani-paniwala
Dialogue: 0,0:31:37.34,0:31:38.97,general text,,0,0,0,,May sipol ka ba?
Dialogue: 0,0:31:40.05,0:31:42.68,pangkalahatang text,,0,0,0,,Paumanhin, hindi ko ito dala
Dialogue: 0,0:31:45.89,0:31:48.35,general text,,0,0,0,,Ito ay regalo mula sa iyong mahal sa buhay
Dialogue: 0,0:31:48.44,0:31:49.27,general text,,0,0,0,,Nasasaktan ako
Dialogue: 0,0:31:59.91,0:32:02.83,pangkalahatang teksto,,0,0,0,,Kailangan mong hipan ng dalawang beses para bumalik ang ibon
Dialogue: 0,0:32:04.12,0:32:05.54,pangkalahatang teksto,,0,0,0,,Magaling ka
Dialogue: 0,0:32:06.12,0:32:07.33,pangkalahatang teksto,,0,0,0,,Subukan
Dialogue: 0,0:32:37.03,0:32:38.19,pangkalahatang teksto,,0,0,0,,Tingnan
Dialogue: 0,0:32:41.32,0:32:42.82,pangkalahatang teksto,,0,0,0,,Bumalik ang ibon
Dialogue: 0,0:32:45.16,0:32:46.74,pangkalahatang teksto,,0,0,0,,Ngayon pumutok ng dalawang beses nang mabilis
Dialogue: 0,0:33:09.64,0:33:12.44,memories italics,,0,0,0,,Sinabi ko yun para pakalmahin siya
Dialogue: 0,0:33:12.52,0:33:15.23,mga alaala,,0,0,0,,Nag-aalala siya na ang kanyang tame bird ay nahihirapan sa taglamig,
Dialogue: 0,0:33:16.15,0:33:17.77,mga alaala,,0,0,0,,kaya nagsinungaling ako
Dialogue: 0,0:33:20.32,0:33:23.03,pangkalahatang teksto,,0,0,0,,See? Magaling si Moo Deok
Dialogue: 0,0:33:27.03,0:33:29.08,pangkalahatang teksto,,0,0,0,,Maghintay, maghintay, Uk
Dialogue: 0,0:33:29.16,0:33:32.37,general text,,0,0,0,,Ano nga ba ang pinagtatalunan ni Moo Dok sa Crown Prince?
Dialogue: 0,0:33:32.46,0:33:33.83,pangkalahatang teksto,,0,0,0,,Ang bagay na gusto mong ibalik
Dialogue: 0,0:33:36.79,0:33:39.17,pangkalahatang teksto,,0,0,0,,Hindi mahalaga. Ngayon, hindi ko na siya maibabalik simula noong nawala ako
Dialogue: 0,0:33:45.68,0:33:49.64,general text,,0,0,0,,Pero bakit siya naging carefree nang mawala siya?
Dialogue: 0,0:33:57.94,0:34:00.15,italics,,0,0,0,,- Ano iyon?\N- Wag kang magtanong
Dialogue: 0,0:34:00.73,0:34:04.36,general text,,0,0,0,,Bakit hindi mo pa binisita si Wook sa Saejukwon?
Dialogue: 0,0:34:05.78,0:34:08.53,pangkalahatang teksto,,0,0,0,,Ako ang iyong bagong master, ngunit hindi mo kailangang mag-alala tungkol dito
Dialogue: 0,0:34:09.37,0:34:11.16,pangkalahatang teksto,,0,0,0,,Hindi iyon ang punto
Dialogue: 0,0:34:11.66,0:34:13.66,general text,,0,0,0,,Sinisikap ko lang na huwag maging walanghiya
Dialogue: 0,0:34:25.34,0:34:27.72,memories italics,,0,0,0,,So wala kang pakialam kung mawala siya sa iyo o hindi?
Dialogue: 0,0:34:31.31,0:34:34.81,offscreen,,0,0,0,,Kailangan ko siyang mahanap. Kailangan ko siyang mahanap ngayon
Dialogue: 0,0:34:36.10,0:34:38.94,offscreen,,0,0,0,,Noon lang ako makakatingin sa mga mata niya
Dialogue: 0,0:34:50.95,0:34:52.29,italics,,0,0,0,,alam ko
Dialogue: 0,0:34:55.50,0:34:57.00,general text,,0,0,0,,Iniinom niya ang tsaa na iyon
Dialogue: 0,0:34:58.96,0:35:00.92,general text,,0,0,0,,Pinahiya niya ang mga salamangkero at tumakas
Dialogue: 0,0:35:01.00,0:35:04.80,general text,,0,0,0,,At pagkatapos ay napabuti niya at natalo ang Crown Prince. Ito ay kakaiba
Dialogue: 0,0:35:04.88,0:35:07.26,general text,,0,0,0,,Nagpasya siyang maging estudyante ni Master Li
Dialogue: 0,0:35:07.34,0:35:09.09,pangkalahatang teksto,,0,0,0,,at pagsasanay ng kalinisang-puri
Dialogue: 0,0:35:09.18,0:35:10.60,general text,,0,0,0,,Nakita mo na ba si Master Li?
Dialogue: 0,0:35:11.18,0:35:12.60,general text,,0,0,0,,Siya ay isang estudyante ni master So Kyung,
Dialogue: 0,0:35:12.68,0:35:14.47,italics,,0,0,0,,at si Master Ho Yeom ang kanyang estudyante
Dialogue: 0,0:35:14.56,0:35:16.69,general text,,0,0,0,,Pero mas bata siya sa ulo namin
Dialogue: 0,0:35:16.77,0:35:19.19,pangkalahatang teksto,,0,0,0,,At lahat dahil nagsasagawa siya ng kalinisang-puri
Dialogue: 0,0:35:19.27,0:35:23.11,general text,,0,0,0,,Nabalitaan ko na hindi siya tumatanda dahil naabot niya ang pinakamataas na antas sa kanyang kabataan
Dialogue: 0,0:35:23.19,0:35:26.24,general text,,0,0,0,,Ganun ba? Balita ko mas bata siya salamat sa isang spell
Dialogue: 0,0:35:26.32,0:35:27.20,italics,,0,0,0,,Spell?
Dialogue: 0,0:35:27.28,0:35:30.20,pangkalahatang teksto,,0,0,0,,Hindi iyon mahalaga. Desidido ang Uk
Dialogue: 0,0:35:30.28,0:35:31.74,general text,,0,0,0,,At paano kung naabot niya si Chisu?
Dialogue: 0,0:35:32.33,0:35:33.66,general text,,0,0,0,,ako ang nasa pwesto niya
Dialogue: 0,0:35:35.79,0:35:37.54,pangkalahatang teksto,,0,0,0,,hindi pigilin
Dialogue: 0,0:35:38.25,0:35:39.83,general text,,0,0,0,,Syempre, ako din
Dialogue: 0,0:35:39.92,0:35:41.75,general text,,0,0,0,,- Matigas talaga ang ulo niya\N- And don’t tell
Dialogue: 0,0:35:45.30,0:35:46.67,general text,,0,0,0,,Selos lang silang lahat
Dialogue: 0,0:35:48.47,0:35:51.80,pangkalahatang teksto,,0,0,0,,Napakaraming nakakatakot na tsismis tungkol kay Mr. Chang Wook
Dialogue: 0,0:35:59.69,0:36:00.94,pangkalahatang teksto,,0,0,0,,Nagawa ko
Dialogue: 0,0:36:01.73,0:36:05.15,pangkalahatang text,,0,0,0,,matulog ka salamat sa kanyang mga gamot
Dialogue: 0,0:36:07.82,0:36:10.95,pangkalahatang teksto,,0,0,0,,Natutuwa ako na ang mga halamang gamot ay kapaki-pakinabang
Dialogue: 0,0:36:11.99,0:36:15.49,pangkalahatang teksto,,0,0,0,,Gumamit ako ng valerian root, na tumutubo sa mga latian ng Vol fortress
Dialogue: 0,0:36:15.58,0:36:17.37,pangkalahatang teksto,,0,0,0,,Kilala siya sa pagiging nakapapawi ng loob
Dialogue: 0,0:36:17.45,0:36:21.25,pangkalahatang teksto,,0,0,0,,Dapat itong makatulong sa iyong makapagpahinga at mapabuti ang iyong pagtulog
Dialogue: 0,0:36:21.79,0:36:24.25,general text,,0,0,0,,Naiintindihan ko kung bakit inirerekomenda ka ni Master Ho Yeom
Dialogue: 0,0:36:25.71,0:36:28.17,general text,,0,0,0,,Mabuti na lang at nakakatulog na ako
Dialogue: 0,0:36:28.26,0:36:31.55,general text,,0,0,0,,Ngunit nananatili pa rin ang ingay sa tainga at sakit ng ulo
Dialogue: 0,0:36:31.64,0:36:34.01,general text,,0,0,0,,Lalong lumala ang balita tungkol sa mga nomad
Dialogue: 0,0:36:34.10,0:36:35.89,pangkalahatang teksto,,0,0,0,,iyong estado
Dialogue: 0,0:36:35.97,0:36:38.52,pangkalahatang teksto,,0,0,0,,Isang nomad ang sinubukang pumasok sa palasyo
Dialogue: 0,0:36:38.60,0:36:41.44,general text,,0,0,0,,Sa loob, baka nandoon din sila
Dialogue: 0,0:36:42.02,0:36:43.44,italics,,0,0,0,,Gwangju Deputy Jin Moo
Dialogue: 0,0:36:43.52,0:36:45.52,pangkalahatang teksto,,0,0,0,,pinaigting na seguridad, kaya huwag mag-alala
Dialogue: 0,0:36:45.61,0:36:48.24,general text,,0,0,0,,Yung lalaki niya ang nagtangkang pumunta dito!
Dialogue: 0,0:36:48.99,0:36:50.11,italics,,0,0,0,,At may mga alingawngaw,
Dialogue: 0,0:36:50.20,0:36:53.16,pangkalahatang text,,0,0,0,,na may nakita pang nomad sa Chonbugwan
Dialogue: 0,0:36:54.99,0:36:56.74,pangkalahatang teksto,,0,0,0,,Hindi ako magtiwala sa sinuman
Dialogue: 0,0:36:59.62,0:37:03.00,general text,,0,0,0,,Mukhang galing sa puso ang iyong pagkabalisa, Kamahalan.
Dialogue: 0,0:37:03.08,0:37:06.59,general text,,0,0,0,,Baka maghanap kami ng ibang paraan para pakalmahin ka?
Dialogue: 0,0:37:07.67,0:37:11.13,general text,,0,0,0,,Kilala mo ba si Hemp Master Li?
Dialogue: 0,0:37:11.22,0:37:13.26,general text,,0,0,0,,Ang huling estudyante ni master So Kyung
Dialogue: 0,0:37:13.84,0:37:15.93,italics,,0,0,0,,Narinig ko ang tungkol sa kanya,
Dialogue: 0,0:37:16.01,0:37:17.97,pangkalahatang teksto,,0,0,0,,ngunit isang beses lang nakita sa Sosnovy Bor
Dialogue: 0,0:37:18.77,0:37:22.98,general text,,0,0,0,,Estudyante niya ang lolo ko, kaya marami akong narinig tungkol sa kanya
Dialogue: 0,0:37:23.06,0:37:27.02,pangkalahatang teksto,,0,0,0,,Baka mapawi nito ang iyong pagkabalisa
Dialogue: 0,0:37:27.98,0:37:29.82,pangkalahatang teksto,,0,0,0,,Sinasabi mo bang matukoy niya,
Dialogue: 0,0:37:29.90,0:37:31.99,general text,,0,0,0,,may mga nomad ba sa paligid ko?
Dialogue: 0,0:37:32.07,0:37:34.61,general text,,0,0,0,,Hindi ko siya kilala ng personal, kaya hindi ko alam
Dialogue: 0,0:37:34.70,0:37:38.33,general text,,0,0,0,,I think pwede mo siyang anyayahan sa palasyo at humingi ng tulong
Dialogue: 0,0:37:44.75,0:37:46.59,general text,,0,0,0,,Sabi ko maglinis ka dito araw-araw!
Dialogue: 0,0:37:46.67,0:37:49.21,general text,,0,0,0,,Nasira na ang tubig sa vase!
Dialogue: 0,0:37:50.51,0:37:51.47,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:37:52.38,0:37:54.01,italics,,0,0,0,,Paano kung bumalik si Boo Young
Dialogue: 0,0:37:54.09,0:37:56.14,general text,,0,0,0,,at may nakita kang plorera na may stagnant na tubig dito?
Dialogue: 0,0:37:56.22,0:37:57.89,general text,,0,0,0,,Madidismaya siya sa akin
Dialogue: 0,0:37:58.93,0:38:00.56,italics,,0,0,0,,Palitan ang mga sheet
Dialogue: 0,0:38:00.64,0:38:02.02,pangkalahatang teksto,,0,0,0,,at tanggalin ito
Dialogue: 0,0:38:02.10,0:38:04.06,general text,,0,0,0,,Bulag siya, bakit mo inilagay dito?
Dialogue: 0,0:38:04.14,0:38:05.81,italics,,0,0,0,,Para trip niya?
Dialogue: 0,0:38:18.70,0:38:20.95,pangkalahatang text,,0,0,0,,Dose-dosenang babae na ang pumunta sa amin,
Dialogue: 0,0:38:22.12,0:38:23.62,pangkalahatang teksto,,0,0,0,,ngunit wala si Bu Young sa kanila
Dialogue: 0,0:38:24.16,0:38:28.38,pangkalahatang teksto,,0,0,0,,Naiinis siya tungkol dito, naging napakasensitibo
Dialogue: 0,0:38:28.46,0:38:29.80,general text,,0,0,0,,Napansin ko din yun
Dialogue: 0,0:38:30.71,0:38:33.55,pangkalahatang text,,0,0,0,,Pero malapit na ang iyong kaarawan
Dialogue: 0,0:38:36.55,0:38:39.55,general text,,0,0,0,,- Dito\N- Ano ito?
Dialogue: 0,0:38:42.56,0:38:45.14,general text,,0,0,0,,Tatay, ang ganda nila
Dialogue: 0,0:38:46.69,0:38:48.77,general text,,0,0,0,,Pero hindi ngayon ang birthday ko
Dialogue: 0,0:38:48.86,0:38:51.48,pangkalahatang teksto,,0,0,0,,Sa araw na ito ay magbibigay ako ng mas maganda
Dialogue: 0,0:38:53.07,0:38:55.45,pangkalahatang teksto,,0,0,0,,Gusto kong subukan ang mga ito. Maaari mo ba akong tulungan?
Dialogue: 0,0:38:56.95,0:38:58.03,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:39:02.37,0:39:06.25,general text,,0,0,0,,Tingnan natin kung gaano kaganda ang anak ko
Dialogue: 0,0:39:06.92,0:39:10.63,general text,,0,0,0,,Nung maliit ako lagi mong tinitrintas ang buhok ko
Dialogue: 0,0:39:15.26,0:39:19.05,pangkalahatang teksto,,0,0,0,,Hindi ito ginawa ni Inay
Dialogue: 0,0:39:21.51,0:39:23.43,pangkalahatang text,,0,0,0,,Paumanhin. Napakasakit ba?
Dialogue: 0,0:39:24.52,0:39:25.64,pangkalahatang teksto,,0,0,0,,Lahat ay maayos
Dialogue: 0,0:39:40.16,0:39:43.74,general text,,0,0,0,,Nakalimutan ko na siguro kung paano itirintas ang buhok ko, matagal ko nang hindi nagagawa.
Dialogue: 0,0:39:43.83,0:39:44.83,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:39:44.91,0:39:48.00,general text,,0,0,0,,Lahat ay maayos. Ano ang hitsura ko?
Dialogue: 0,0:39:48.62,0:39:50.25,general text,,0,0,0,,Lagi kang maganda
Dialogue: 0,0:40:23.78,0:40:25.83,general text,,0,0,0,,binaril ako ni Pak Jin gamit ang busog na ito
Dialogue: 0,0:40:28.58,0:40:30.08,voiceover,,0,0,0,,Natalo ako noong araw na iyon
Dialogue: 0,0:40:30.17,0:40:33.54,voiceover,,0,0,0,,Hindi ako makaisip ng mga dahilan o hindi tanggapin ang resulta ng labanan
Dialogue: 0,0:40:36.09,0:40:38.05,voiceover,,0,0,0,,Ngunit kapag nakuha ko na ang aking kapangyarihan,
Dialogue: 0,0:40:39.01,0:40:42.01,voiceover,,0,0,0,,Gusto ko siyang labanan ng totoo
Dialogue: 0,0:40:53.98,0:40:55.07,italics,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:40:56.65,0:40:58.53,pangkalahatang teksto,,0,0,0,,Paglabas, kabanata
Dialogue: 0,0:41:00.57,0:41:02.11,pangkalahatang teksto,,0,0,0,,Huwag hawakan ang lahat
Dialogue: 0,0:41:02.70,0:41:05.87,pangkalahatang teksto,,0,0,0,,Mga sandata na naglalaman ng lakas ng isang malakas na salamangkero,
Dialogue: 0,0:41:05.95,0:41:08.75,pangkalahatang teksto,,0,0,0,,delikado para sa isang marupok na babae
Dialogue: 0,0:41:10.37,0:41:12.58,pangkalahatang teksto,,0,0,0,,Kahit ako alam ko ito
Dialogue: 0,0:41:13.17,0:41:16.38,general text,,0,0,0,,Pero bakit mo nilagay dito?
Dialogue: 0,0:41:16.46,0:41:19.05,general text,,0,0,0,,Dapat akong maglinis dito
Dialogue: 0,0:41:19.13,0:41:21.88,pangkalahatang text,,0,0,0,,Karaniwan kong isinasabit sa dingding
Dialogue: 0,0:41:22.97,0:41:24.14,general text,,0,0,0,,Nakalimutan ko na sa pagkakataong ito
Dialogue: 0,0:41:24.22,0:41:25.93,general text,,0,0,0,,Pero bata ka pa
Dialogue: 0,0:41:26.01,0:41:29.60,general text,,0,0,0,,I can't believe you're already so forgetful
Dialogue: 0,0:41:30.31,0:41:33.56,general text,,0,0,0,,Nag-aalala lang ako, parang lingkod ni Sosnovy Bor
Dialogue: 0,0:41:33.65,0:41:36.65,general text,,0,0,0,,Paano kung nakalimutan mong bayaran ako?
Dialogue: 0,0:41:37.44,0:41:38.53,italics,,0,0,0,,Kabanata
Dialogue: 0,0:41:38.61,0:41:42.11,pangkalahatang teksto,,0,0,0,,Pakiusap, maging malusog. Napakabata mo pa
Dialogue: 0,0:41:45.41,0:41:48.41,general text,,0,0,0,,Babalik ako mamaya para tapusin ang paglilinis
Dialogue: 0,0:41:54.42,0:41:56.58,pangkalahatang teksto,,0,0,0,,Gaano katalino,
Dialogue: 0,0:41:57.38,0:41:59.00,pangkalahatang text,,0,0,0,,pero isang bastos na babae
Dialogue: 0,0:41:59.71,0:42:01.26,pangkalahatang teksto,,0,0,0,,Tulad ng Moo Dok
Dialogue: 0,0:42:01.34,0:42:04.34,pangkalahatang teksto,,0,0,0,,nakipagkita kay Uk?
Dialogue: 0,0:42:04.43,0:42:05.93,pangkalahatang teksto,,0,0,0,,Hindi ko alam ang mga detalye
Dialogue: 0,0:42:06.01,0:42:09.85,general text,,0,0,0,,Ngunit narinig ko na binayaran niya ang kanyang mga utang at kinuha siya mula sa Chwisongru
Dialogue: 0,0:42:09.93,0:42:12.06,pangkalahatang teksto,,0,0,0,,Pagkatapos ay pumunta sa Chwisongru
Dialogue: 0,0:42:12.14,0:42:14.77,pangkalahatang teksto,,0,0,0,,at magtanong tungkol sa kanya
Dialogue: 0,0:42:15.48,0:42:19.02,pangkalahatang teksto,,0,0,0,,Alamin ang kanyang nakaraan at ang kanyang pagkatao
Dialogue: 0,0:42:20.11,0:42:21.94,general text,,0,0,0,,curious lang ako
Dialogue: 0,0:42:25.49,0:42:27.37,general text,,0,0,0,,Hindi ko rin masyadong alam
Dialogue: 0,0:42:27.45,0:42:30.49,general text,,0,0,0,,Ngunit ang mangangalakal na nagdala sa kanya ay nasa kabisera na ngayon
Dialogue: 0,0:42:30.58,0:42:33.20,general text,,0,0,0,,Sasabihin ko sa kanya na pumunta sa Sosnovy Bor
Dialogue: 0,0:42:35.83,0:42:38.04,italics,,0,0,0,,Hey there
Dialogue: 0,0:42:40.50,0:42:42.21,general text,,0,0,0,,Nagkita na ba tayo sa village ng Sari?
Dialogue: 0,0:42:42.80,0:42:44.51,pangkalahatang teksto,,0,0,0,,Ano ang kailangan mo sa oras na ito?
Dialogue: 0,0:42:44.59,0:42:45.76,pangkalahatang teksto,,0,0,0,,Kaya ako
Dialogue: 0,0:42:45.84,0:42:47.80,italics,,0,0,0,,Nakilala mo na ba siya sa kabisera?
Dialogue: 0,0:42:48.30,0:42:50.60,general text,,0,0,0,,Alam mo ba kung nasaan siya?
Dialogue: 0,0:42:50.68,0:42:53.77,general text,,0,0,0,,Hindi ko alam. Hindi siya residente ng Sari
Dialogue: 0,0:42:54.35,0:42:57.60,pangkalahatang teksto,,0,0,0,,Nandoon siya ng ilang buwan, at pagkatapos ay ninakawan niya ang mga taganayon
Dialogue: 0,0:42:57.69,0:42:59.06,pangkalahatang text,,0,0,0,,Ipaalam sa akin kung nahuli mo siya
Dialogue: 0,0:43:04.07,0:43:06.49,pangkalahatang teksto,,0,0,0,,Saan ko ito mahahanap?
Dialogue: 0,0:43:10.41,0:43:11.45,pangkalahatang text,,0,0,0,,Heto
Dialogue: 0,0:43:12.20,0:43:14.58,general text,,0,0,0,,So Yi, nagkaroon ka ng masamang kaibigan
Dialogue: 0,0:43:16.08,0:43:19.13,general text,,0,0,0,,Baka hinanap niya si Moo Deok?
Dialogue: 0,0:43:22.63,0:43:25.22,general text,,0,0,0,,Ihahatid na kita sa Jinyeowon
Dialogue: 0,0:43:25.30,0:43:27.88,pangkalahatang teksto,,0,0,0,,Pero may kailangan muna tayong asikasuhin
Dialogue: 0,0:43:37.81,0:43:40.27,mga alaala,,0,0,0,,Eto, kumain
Dialogue: 0,0:43:40.36,0:43:42.52,mga alaala,,0,0,0,,Ninakaw mo ang pera ko
Dialogue: 0,0:43:42.61,0:43:43.86,mga alaala,,0,0,0,,Ibalik ang singsing ko
Dialogue: 0,0:43:49.57,0:43:52.37,general text,,0,0,0,,Nakilala mo ba sila sa kabisera?
Dialogue: 0,0:43:52.45,0:43:55.50,general text,,0,0,0,,Oo, pero bakit mo sila dinala dito?
Dialogue: 0,0:43:55.58,0:43:58.37,pangkalahatang teksto,,0,0,0,,Gusto ko na matalino ka at matiyaga
Dialogue: 0,0:43:58.92,0:44:00.83,pangkalahatang teksto,,0,0,0,,Pero delikado ka rin niyan
Dialogue: 0,0:44:01.92,0:44:03.92,pangkalahatang teksto,,0,0,0,,Gusto kong may makita ka
Dialogue: 0,0:44:20.73,0:44:21.94,pangkalahatang teksto,,0,0,0,,Gwangju Deputy
Dialogue: 0,0:44:22.48,0:44:25.28,general text,,0,0,0,,Salamat sa pagpapakain sa akin
Dialogue: 0,0:45:27.00,0:45:28.46,pangkalahatang teksto,,0,0,0,,Matakot
Dialogue: 0,0:45:28.55,0:45:32.47,pangkalahatang teksto,,0,0,0,,Ipagkanulo mo ako o ibunyag ang iyong pagkakakilanlan, at magdurusa ka sa parehong kapalaran
Dialogue: 0,0:45:38.39,0:45:39.39,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:45:40.35,0:45:42.98,pangkalahatang text,,0,0,0,,Sabihin mo sa akin kung may ibang makakakilala sa iyo
Dialogue: 0,0:45:43.48,0:45:44.81,italics,,0,0,0,,Kailangan kong alisin ang mga ito
Dialogue: 0,0:45:46.31,0:45:47.69,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:45:51.65,0:45:52.82,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:45:56.20,0:45:59.79,pangkalahatang teksto,,0,0,0,,Maghanap nang mas mabuti. Tiyak na itinapon ko ito doon
Dialogue: 0,0:45:59.87,0:46:01.25,pangkalahatang text,,0,0,0,,Wala akong nakikita
Dialogue: 0,0:46:01.83,0:46:04.12,pangkalahatang teksto,,0,0,0,,Tingnan mo doon
Dialogue: 0,0:46:04.21,0:46:06.96,general text,,0,0,0,,Tiningnan kong mabuti, wala naman
Dialogue: 0,0:46:07.04,0:46:08.75,pangkalahatang teksto,,0,0,0,,Tingnan muli
Dialogue: 0,0:46:08.84,0:46:10.21,pangkalahatang teksto,,0,0,0,,halos hindi ko makita...
Dialogue: 0,0:46:11.38,0:46:12.59,pangkalahatang teksto,,0,0,0,,Oo, Kamahalan
Dialogue: 0,0:46:13.13,0:46:15.09,general text,,0,0,0,,Sigurado akong nandito siya sa isang lugar
Dialogue: 0,0:46:15.18,0:46:16.84,pangkalahatang teksto,,0,0,0,,Oo, tingnan mo doon
Dialogue: 0,0:46:21.43,0:46:22.77,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:46:24.98,0:46:26.27,pangkalahatang text,,0,0,0,,None of your business. umalis ka na
Dialogue: 0,0:46:27.44,0:46:30.98,pangkalahatang teksto,,0,0,0,,Natatakot akong eunuch O ay nagdurusa nang walang kabuluhan
Dialogue: 0,0:46:31.07,0:46:34.65,general text,,0,0,0,,May sasabihin ako. Pwede ba?
Dialogue: 0,0:46:34.74,0:46:36.28,pangkalahatang teksto,,0,0,0,,Ano ang mayroon ka?
Dialogue: 0,0:46:37.70,0:46:38.66,pangkalahatang teksto,,0,0,0,,Siguro,
Dialogue: 0,0:46:39.70,0:46:40.79,pangkalahatang teksto,,0,0,0,,hinahanap mo
Dialogue: 0,0:46:41.58,0:46:43.12,general text,,0,0,0,,ito ba?
Dialogue: 0,0:46:44.71,0:46:45.71,pangkalahatang teksto,,0,0,0,,Nahanap mo na ba?
Dialogue: 0,0:46:45.79,0:46:49.21,pangkalahatang teksto,,0,0,0,,Naghanap ako araw at gabi, natagpuan ko ito hindi pa katagal.
Dialogue: 0,0:46:53.84,0:46:55.26,general text,,0,0,0,,Itinapon mo
Dialogue: 0,0:46:55.93,0:46:58.51,general text,,0,0,0,,At kinuha ko ito, ibig sabihin ay akin na ulit
Dialogue: 0,0:47:02.89,0:47:05.27,general text,,0,0,0,,Eunuch Oh, makakaalis ka na diyan
Dialogue: 0,0:47:06.60,0:47:07.90,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:47:11.07,0:47:14.32,pangkalahatang teksto,,0,0,0,,Salamat sa iyo, nakakuha ako ng isang mahalagang bagay
Dialogue: 0,0:47:14.90,0:47:18.07,general text,,0,0,0,,Meron ulit ako salamat sa iyo
Dialogue: 0,0:47:19.66,0:47:20.70,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:47:20.78,0:47:24.75,pangkalahatang teksto,,0,0,0,,Hindi ko ito nasira, hindi ko itinapon ito sa malayo
Dialogue: 0,0:47:24.83,0:47:27.33,general text,,0,0,0,,Nahanap mo kasi tinapon ko malapit.
Dialogue: 0,0:47:27.42,0:47:32.92,pangkalahatang teksto,,0,0,0,,Naglakas-loob akong subukang intindihin ka, Kamahalan
Dialogue: 0,0:47:33.00,0:47:36.13,general text,,0,0,0,,Nagdadahilan ka at nagagalit dahil
Dialogue: 0,0:47:36.22,0:47:38.26,general text,,0,0,0,,ano ang pinagsisisihan mo?
Dialogue: 0,0:47:38.89,0:47:41.85,pangkalahatang teksto,,0,0,0,,Dapat lang makinig si Von Moo Deok nang hindi sinusubukang unawain
Dialogue: 0,0:47:41.93,0:47:43.72,general text,,0,0,0,,How dare you even try?
Dialogue: 0,0:47:43.81,0:47:45.77,pangkalahatang teksto,,0,0,0,,Paumanhin, Kamahalan
Dialogue: 0,0:47:49.06,0:47:50.15,italics,,0,0,0,,Your Highness
Dialogue: 0,0:47:53.94,0:47:55.07,pangkalahatang teksto,,0,0,0,,Your Highness
Dialogue: 0,0:47:55.15,0:47:58.82,general text,,0,0,0,,Hiniling sa akin ni Master Ho na sabihin sa iyo na dumating na si Master Li
Dialogue: 0,0:47:58.91,0:48:01.07,pangkalahatang text,,0,0,0,,Okay. Nasa Saejukwon ba siya?
Dialogue: 0,0:48:01.16,0:48:04.62,pangkalahatang teksto,,0,0,0,,Oo. Kasama niya ang estudyante niyang si Chang Wook
Dialogue: 0,0:48:06.41,0:48:08.83,pangkalahatang teksto,,0,0,0,,Sinasabi nila na nakamit ni Chan Wook ang gayong tagumpay
Dialogue: 0,0:48:08.92,0:48:10.83,pangkalahatang teksto,,0,0,0,,salamat sa mga tagubilin ni Master Li
Dialogue: 0,0:48:10.92,0:48:12.67,pangkalahatang teksto,,0,0,0,,Kung hindi dahil dito,
Dialogue: 0,0:48:12.75,0:48:14.88,general text,,0,0,0,,hindi ka niya matatalo
Dialogue: 0,0:48:17.88,0:48:18.84,general text,,0,0,0,,Let's go
Dialogue: 0,0:48:30.94,0:48:33.44,general text,,0,0,0,,Seo Yul na ang pinaglilingkuran mo, hindi si Chan Wook
Dialogue: 0,0:48:34.07,0:48:36.48,general text,,0,0,0,,Kung natalo ko si Chang Wook,
Dialogue: 0,0:48:36.57,0:48:38.28,pangkalahatang teksto,,0,0,0,,paglilingkod mo ba ako
Dialogue: 0,0:48:38.36,0:48:40.15,pangkalahatang teksto,,0,0,0,,Kung hindi ka tumanggi sa laban,
Dialogue: 0,0:48:40.86,0:48:43.87,pangkalahatang teksto,,0,0,0,,hindi mo na ako kailangang pagsilbihan
Dialogue: 0,0:48:43.95,0:48:46.66,general text,,0,0,0,, hahayaan ko siyang manalo dahil sa awa
Dialogue: 0,0:48:47.25,0:48:48.66,general text,,0,0,0,,Hindi ka ba naaawa sa kanya?
Dialogue: 0,0:48:48.75,0:48:50.41,pangkalahatang teksto,,0,0,0,,Alam ng lahat sa Sosnovy Bor,
Dialogue: 0,0:48:50.50,0:48:52.75,pangkalahatang teksto,,0,0,0,,na si Chan Wook ay nagsasagawa ng kalinisang-puri
Dialogue: 0,0:48:53.33,0:48:55.17,general text,,0,0,0,,- Ganun ba?\N- Wag kang magkunwaring hindi mo alam
Dialogue: 0,0:48:55.25,0:48:56.55,pangkalahatang teksto,,0,0,0,,Mas alam mo kaysa sinuman
Dialogue: 0,0:48:57.13,0:48:59.17,general text,,0,0,0,,Hindi mo dinala sa kanya
Dialogue: 0,0:48:59.76,0:49:01.18,pangkalahatang teksto,,0,0,0,,chastity tea?
Dialogue: 0,0:49:01.26,0:49:02.43,pangkalahatang teksto,,0,0,0,,Hindi ko pa nagawa ito
Dialogue: 0,0:49:02.51,0:49:05.60,general text,,0,0,0,,Paano pa niya na-master si Chisa nang ganoon kabilis?
Dialogue: 0,0:49:06.97,0:49:08.98,general text,,0,0,0,,Hindi siya anak ni Chang Gan
Dialogue: 0,0:49:10.31,0:49:14.02,general text,,0,0,0,,Napangasawa ng kanyang ina si Chang Gan at nanganak ng isang lalaki
Dialogue: 0,0:49:14.73,0:49:17.36,general text,,0,0,0,,At ngayon ang kanyang anak ay magmamana ng lahat
Dialogue: 0,0:49:18.69,0:49:22.49,general text,,0,0,0,,Isinara ng kanyang ama ang kanyang gate para tapusin ang linya ng Uka
Dialogue: 0,0:49:22.57,0:49:25.53,general text,,0,0,0,,Ngunit binuksan sila ni Chan Wook, dapat siya ay malinis
Dialogue: 0,0:49:26.45,0:49:27.54,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:49:28.83,0:49:32.04,pangkalahatang teksto,,0,0,0,,Palihim at bastos
Dialogue: 0,0:49:32.62,0:49:33.46,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:49:35.00,0:49:36.25,general text,,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,0:49:37.50,0:49:40.17,general text,,0,0,0,,- Narinig mo\N- How dare you?
Dialogue: 0,0:49:40.67,0:49:43.22,general text,,0,0,0,,- Repeat\N- Tapos sasampalin mo ako
Dialogue: 0,0:49:43.30,0:49:44.55,pangkalahatang text,,0,0,0,,Pagkatapos sabihin mo sa akin!
Dialogue: 0,0:49:46.93,0:49:48.18,italics,,0,0,0,,Sabihin mo sa kanila
Dialogue: 0,0:49:58.48,0:49:59.69,pangkalahatang teksto,,0,0,0,,Kung marinig nila,
Dialogue: 0,0:49:59.78,0:50:03.57,pangkalahatang teksto,,0,0,0,,sabihin ito nang malakas at malinaw
Dialogue: 0,0:50:09.37,0:50:12.46,pangkalahatang teksto,,0,0,0,,Ikaw ay masama at makulit
Dialogue: 0,0:50:14.50,0:50:17.04,general text,,0,0,0,,Iyon ang sinabi niya. Naintindihan mo?
Dialogue: 0,0:50:17.67,0:50:18.50,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:50:19.59,0:50:22.34,general text,,0,0,0,,Moo Dok, may binigay ako sayo
Dialogue: 0,0:50:22.42,0:50:23.59,pangkalahatang teksto,,0,0,0,,Ipakita sa kanila
Dialogue: 0,0:50:30.47,0:50:32.23,general text,,0,0,0,,Itong sachet na ito ay regalo ko
Dialogue: 0,0:50:32.31,0:50:36.44,general text,,0,0,0,,Kung may bumugbog, pasaway o sinisiraan ka kapag wala ako,
Dialogue: 0,0:50:36.52,0:50:38.31,general text,,0,0,0,,sabihin mo lang
Dialogue: 0,0:50:39.57,0:50:40.52,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:50:42.61,0:50:43.86,pangkalahatang text,,0,0,0,,Maaari kang pumunta
Dialogue: 0,0:50:53.08,0:50:55.62,pangkalahatang teksto,,0,0,0,,Katangahan ang gumawa ng kaaway
Dialogue: 0,0:50:55.71,0:50:59.29,pangkalahatang teksto,,0,0,0,,dahil sa inggit na mas malakas ang isang tao
Dialogue: 0,0:51:08.72,0:51:10.39,general text,,0,0,0,,May tinta ka sa damit mo
Dialogue: 0,0:51:11.06,0:51:13.77,pangkalahatang teksto,,0,0,0,,Maaari silang i-breed na may puting bigas
Dialogue: 0,0:51:15.02,0:51:17.10,pangkalahatang teksto,,0,0,0,,Ito ay dalawang ganap na magkaibang kulay
Dialogue: 0,0:51:17.94,0:51:20.56,pangkalahatang teksto,,0,0,0,,Ngunit sabay nilang maalis ang mantsa
Dialogue: 0,0:51:21.19,0:51:22.69,pangkalahatang teksto,,0,0,0,,Mga salita ng karunungan
Dialogue: 0,0:51:23.44,0:51:25.86,general text,,0,0,0,,Saan mo nabasa ang mga ito, Your Highness?
Dialogue: 0,0:51:27.32,0:51:28.74,pangkalahatang teksto,,0,0,0,,Dito at doon
Dialogue: 0,0:51:28.82,0:51:31.08,general text,,0,0,0,,Ito ay itinatanong lamang sa pinakamahirap na pagsusulit
Dialogue: 0,0:51:45.55,0:51:47.43,general text,,0,0,0,,Wala ang amo ko?
Dialogue: 0,0:51:50.85,0:51:53.72,general text,,0,0,0,,Balita ko nasugatan ka. okay ka lang ba?
Dialogue: 0,0:51:54.31,0:51:57.27,pangkalahatang teksto,,0,0,0,,Oo, salamat sa iyo. Salamat sa mga gamot na iyon
Dialogue: 0,0:51:59.27,0:52:03.36,general text,,0,0,0,,Inimbitahan ako ng Maid Kim na maghapunan
Dialogue: 0,0:52:04.69,0:52:07.78,general text,,0,0,0,,Marahil sasama ka sa amin?
Dialogue: 0,0:52:08.74,0:52:09.66,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:52:11.78,0:52:14.70,general text,,0,0,0,,Pagkatapos ay pipili ako ng araw at sasabihin kay Moo Deok
Dialogue: 0,0:52:15.58,0:52:17.08,general text,,0,0,0,,Kilala mo ba ang maid ko?
Dialogue: 0,0:52:17.16,0:52:20.21,general text,,0,0,0,,Minsan akong pumunta sa iyo,
Dialogue: 0,0:52:20.29,0:52:21.92,pangkalahatang text,,0,0,0,,ngunit hindi ito gumana para sa akin
Dialogue: 0,0:52:22.71,0:52:25.25,general text,,0,0,0,,Pumasok siya sa kwarto mo noon
Dialogue: 0,0:52:30.97,0:52:32.14,mga alaala,,0,0,0,,Huwag kang pumunta
Dialogue: 0,0:52:33.35,0:52:35.14,mga alaala,,0,0,0,,Huwag pumunta sa iyong lugar, manatili dito
Dialogue: 0,0:52:36.10,0:52:37.89,mga alaala,,0,0,0,,Dadalhin ko ang damit mo
Dialogue: 0,0:52:39.98,0:52:41.02,pangkalahatang teksto,,0,0,0,,Ano iyon?
Dialogue: 0,0:52:41.90,0:52:43.23,pangkalahatang teksto,,0,0,0,,Isang hakbang patungo?
Dialogue: 0,0:52:43.77,0:52:45.32,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:52:47.23,0:52:48.36,pangkalahatang teksto,,0,0,0,,Oo nga
Dialogue: 0,0:52:55.49,0:52:56.49,pangkalahatang teksto,,0,0,0,,Sandali lang
Dialogue: 0,0:52:57.75,0:52:59.79,pangkalahatang teksto,,0,0,0,,Kalmado
Dialogue: 0,0:53:00.75,0:53:01.92,pangkalahatang teksto,,0,0,0,,Lumipad palayo
Dialogue: 0,0:53:02.71,0:53:04.09,general text,,0,0,0,,- Talaga?\N- Oo
Dialogue: 0,0:53:06.21,0:53:08.13,italics,,0,0,0,,Natakot ako
Dialogue: 0,0:53:21.19,0:53:22.31,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,0:53:38.62,0:53:40.96,general text,,0,0,0,,Moo Dok, nagkita tayong muli
Dialogue: 0,0:53:44.38,0:53:46.25,pangkalahatang teksto,,0,0,0,,Alagaan ang iyong sarili
Dialogue: 0,0:53:46.34,0:53:47.67,general text,,0,0,0,,Magkita tayo sa palasyo
Dialogue: 0,0:53:47.75,0:53:49.09,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:54:02.64,0:54:04.27,pangkalahatang teksto,,0,0,0,,Ano ito? Tumakbo ka ba dito?
Dialogue: 0,0:54:05.19,0:54:06.11,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:54:06.19,0:54:08.86,general text,,0,0,0,,Matagal na panahon na ang nakalipas simula nang bumisita ka sa akin noong ako ay nasugatan
Dialogue: 0,0:54:08.94,0:54:09.78,pangkalahatang teksto,,0,0,0,,Ano ang problema?
Dialogue: 0,0:54:09.86,0:54:12.15,pangkalahatang teksto,,0,0,0,,May mas seryoso pa sa pagpapalit ng may-ari?
Dialogue: 0,0:54:12.24,0:54:13.20,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:54:13.28,0:54:15.24,pangkalahatang teksto,,0,0,0,,Ibang mga salamangkero ay nagtsitsismis tungkol sa iyo
Dialogue: 0,0:54:15.32,0:54:16.49,general text,,0,0,0,,Gusto kong malaman ang katotohanan
Dialogue: 0,0:54:16.57,0:54:18.91,pangkalahatang teksto,,0,0,0,,Nakuha ko. Narinig mo na ba ang tungkol sa tsaa na iyon?
Dialogue: 0,0:54:18.99,0:54:20.74,general text,,0,0,0,,Pero alam mo ang totoo
Dialogue: 0,0:54:20.83,0:54:24.12,pangkalahatang teksto,,0,0,0,,Paano kung? Nahuli mo ang Golden Fish habang wala ako
Dialogue: 0,0:54:24.87,0:54:27.04,general text,,0,0,0,,Siguro naging estudyante ka talaga ni Master Li
Dialogue: 0,0:54:27.13,0:54:29.25,pangkalahatang teksto,,0,0,0,,Ano? Hindi, siyempre
Dialogue: 0,0:54:29.34,0:54:30.38,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:54:30.46,0:54:32.47,pangkalahatang teksto,,0,0,0,,ako mismo ang nagmungkahi nito sa iyo
Dialogue: 0,0:54:33.26,0:54:34.88,pangkalahatang teksto,,0,0,0,,Marahil ay hindi makatiis
Dialogue: 0,0:54:34.97,0:54:36.84,pangkalahatang teksto,,0,0,0,,Paano ko ito mapapatunayan sa iyo?
Dialogue: 0,0:54:38.01,0:54:39.35,general text,,0,0,0,,Ikaw na mismo ang nagsabi
Dialogue: 0,0:54:49.15,0:54:50.15,pangkalahatang teksto,,0,0,0,,See?
Dialogue: 0,0:54:52.65,0:54:54.07,general text,,0,0,0,,Wala kang nakikitang babae sa akin
Dialogue: 0,0:54:54.15,0:54:57.20,general text,,0,0,0,,Dapat niyakap ko ang sweet girl na iyon bilang patunay
Dialogue: 0,0:54:58.57,0:55:00.62,general text,,0,0,0,,Dapat ko ba talaga siyang yakapin?
Dialogue: 0,0:55:01.83,0:55:03.87,pangkalahatang teksto,,0,0,0,,Oo. Halika na
Dialogue: 0,0:55:03.95,0:55:05.62,pangkalahatang text,,0,0,0,,Huwag magbago ang isip mo mamaya
Dialogue: 0,0:55:05.71,0:55:07.08,pangkalahatang text,,0,0,0,,Okay, go!
Dialogue: 0,0:55:42.33,0:55:43.99,general text,,0,0,0,,Sabi mo kailangan nating atakihin,
Dialogue: 0,0:55:44.08,0:55:46.46,pangkalahatang teksto,,0,0,0,, kapag hindi inaasahan ng kaaway
Dialogue: 0,0:55:47.62,0:55:51.00,general text,,0,0,0,,Sinunod ko ang iyong payo, guro
Dialogue: 0,0:55:53.80,0:55:56.59,pangkalahatang teksto,,0,0,0,,Oo. Magaling. Proud ako sayo
Dialogue: 0,0:55:58.84,0:56:00.01,pangkalahatang teksto,,0,0,0,,Siya nga pala, guro,
Dialogue: 0,0:56:00.64,0:56:04.31,general text,,0,0,0,,Narinig ko na nasagasaan mo siya sa kwarto ko
Dialogue: 0,0:56:06.48,0:56:07.56,pangkalahatang teksto,,0,0,0,,Ano kaya?
Dialogue: 0,0:56:07.64,0:56:09.35,general text,,0,0,0,,Kaya ba pinigilan mo ako noon?
Dialogue: 0,0:56:13.15,0:56:14.69,general text,,0,0,0,,Nangyari ba talaga ito?
Dialogue: 0,0:56:15.53,0:56:17.03,general text,,0,0,0,,Hindi ko maalala
Dialogue: 0,0:56:17.74,0:56:19.82,pangkalahatang teksto,,0,0,0,,Mas mahirap unawain ka kaysa kontrolin ka
Dialogue: 0,0:56:19.91,0:56:21.28,pangkalahatang teksto,,0,0,0,,enerhiya ng Gyeongcheongdaeho
Dialogue: 0,0:56:22.74,0:56:24.49,general text,,0,0,0,,Pinigilan mo ako
Dialogue: 0,0:56:27.00,0:56:29.50,general text,,0,0,0,,Guro, pupunta ako sa palasyo ngayon
Dialogue: 0,0:56:29.58,0:56:31.46,pangkalahatang teksto,,0,0,0,,Inimbitahan ng Hari si Master Li,
Dialogue: 0,0:56:32.08,0:56:34.17,general text,,0,0,0,,at sasamahan ko siya
Dialogue: 0,0:56:34.25,0:56:36.88,general text,,0,0,0,,Gusto kong makita ang reyna, at ngayon ay nagkaroon ako ng pagkakataon
Dialogue: 0,0:56:37.63,0:56:39.17,pangkalahatang teksto,,0,0,0,,Mag-ingat
Dialogue: 0,0:56:40.47,0:56:43.30,pangkalahatang teksto,,0,0,0,,Gagawin ko. Sasabihin ko sayo lahat pagbalik ko
Dialogue: 0,0:56:51.27,0:56:52.31,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:56:56.61,0:56:57.90,pangkalahatang text,,0,0,0,,Nahanap ko
Dialogue: 0,0:56:59.65,0:57:03.66,general text,,0,0,0,,Nangyari na, kaya naisipan kong sabihin sa iyo
Dialogue: 0,0:57:05.91,0:57:06.91,pangkalahatang text,,0,0,0,,Go
Dialogue: 0,0:57:26.26,0:57:28.60,general text,,0,0,0,,Bakit ako hinahanap ng head ng Sosnovy Bor?
Dialogue: 0,0:57:29.64,0:57:31.73,general text,,0,0,0,,- Remember Moo Dok?\N- Oo
Dialogue: 0,0:57:31.81,0:57:34.81,general text,,0,0,0,,Gusto niyang malaman pa ang tungkol sa buhay niya kay Sari
Dialogue: 0,0:57:34.90,0:57:38.15,pangkalahatang teksto,,0,0,0,,Maaari niyang tanungin siya mismo
Dialogue: 0,0:57:38.23,0:57:39.19,general text,,0,0,0,,Nandito siya
Dialogue: 0,0:57:39.28,0:57:41.74,pangkalahatang teksto,,0,0,0,,Hindi. Siya ay nasa Sosnovy Bor
Dialogue: 0,0:57:41.82,0:57:42.95,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:57:43.74,0:57:46.58,general text,,0,0,0,,Ano ang ginagawa ng bulag na babae doon?
Dialogue: 0,0:57:48.87,0:57:51.41,general text,,0,0,0,,Gusto ni Master Lee na kayong dalawa ni Chan Wook
Dialogue: 0,0:57:51.50,0:57:53.33,general text,,0,0,0,,inihatid siya sa palasyo
Dialogue: 0,0:57:54.50,0:57:55.83,pangkalahatang teksto,,0,0,0,,Tagana rin ba ang Uk?
Dialogue: 0,0:57:57.34,0:57:58.46,general text,,0,0,0,,Bumabuti na ba ang pakiramdam niya?
Dialogue: 0,0:57:58.55,0:58:00.42,general text,,0,0,0,,Aalis na kami. Humanda ka
Dialogue: 0,0:58:08.72,0:58:11.39,general text,,0,0,0,,Mag-ingat sa palasyo
Dialogue: 0,0:58:11.48,0:58:13.85,pangkalahatang teksto,,0,0,0,,May yelong bato
Dialogue: 0,0:58:15.52,0:58:17.11,pangkalahatang teksto,,0,0,0,,alam ko ito sa aking sarili
Dialogue: 0,0:58:17.19,0:58:20.36,pangkalahatang teksto,,0,0,0,,Dahil walang kahihiyang itinago nila ito,
Dialogue: 0,0:58:20.44,0:58:23.40,pangkalahatang teksto,,0,0,0,,Napagpasyahan kong gumawa ng hakbang
Dialogue: 0,0:58:28.99,0:58:31.58,general text,,0,0,0,,Kailan ako huling naimbitahan sa palasyo,
Dialogue: 0,0:58:32.16,0:58:34.58,pangkalahatang teksto,,0,0,0,, napakaliit mo
Dialogue: 0,0:58:35.12,0:58:38.13,pangkalahatang text,,0,0,0,,Naalala ko kung gaano ako kahilig sa matamis,
Dialogue: 0,0:58:38.21,0:58:40.50,pangkalahatang teksto,,0,0,0,,na dinala mo noon
Dialogue: 0,0:58:40.59,0:58:41.76,pangkalahatang teksto,,0,0,0,,Nga pala,
Dialogue: 0,0:58:42.34,0:58:45.97,general text,,0,0,0,,hindi mo ba bibigyan ng regalo ang hari?
Dialogue: 0,0:58:46.05,0:58:48.01,general text,,0,0,0,,Naghanda na ako ng isa
Dialogue: 0,0:58:48.10,0:58:48.97,pangkalahatang teksto,,0,0,0,,Yom
Dialogue: 0,0:58:49.05,0:58:51.89,pangkalahatang teksto,,0,0,0,,Magpadala ng regalo sa palasyo sa takdang oras
Dialogue: 0,0:58:51.97,0:58:53.52,italics,,0,0,0,,Oo, guro
Dialogue: 0,0:58:53.60,0:58:55.19,pangkalahatang teksto,,0,0,0,,Sa isang lugar sa pagitan ng 5 at 7 pm?
Dialogue: 0,0:58:55.27,0:58:56.69,pangkalahatang teksto,,0,0,0,,Sa pagitan ng 7 at 9, tanga!
Dialogue: 0,0:58:57.27,0:58:59.02,pangkalahatang teksto,,0,0,0,, Eksakto. Paumanhin
Dialogue: 0,0:58:59.73,0:59:01.73,pangkalahatang teksto,,0,0,0,,Isulat ito kung hindi mo matandaan
Dialogue: 0,0:59:02.65,0:59:04.15,pangkalahatang teksto,,0,0,0,,Wala ka sa isip noon,
Dialogue: 0,0:59:04.24,0:59:07.16,pangkalahatang teksto,,0,0,0,,at sa edad ay mas lumalala ang lahat
Dialogue: 0,0:59:09.45,0:59:10.58,pangkalahatang teksto,,0,0,0,,Ipasa
Dialogue: 0,0:59:11.08,0:59:12.75,pangkalahatang teksto,,0,0,0,,Paalam
Dialogue: 0,0:59:13.95,0:59:16.62,general text,,0,0,0,,Hinding-hindi ako masasanay dito, guys
Dialogue: 0,0:59:45.24,0:59:46.36,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:59:47.99,0:59:49.87,pangkalahatang teksto,,0,0,0,,Gusto kang makita ng ulo
Dialogue: 0,0:59:51.33,0:59:52.53,pangkalahatang teksto,,0,0,0,,Kabanata?
Dialogue: 0,1:00:01.42,1:00:02.42,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,1:00:15.64,1:00:20.15,pangkalahatang teksto,,0,0,0,,Lahat ng tungkol sa iyo ay naliwanagan
Dialogue: 0,1:00:21.11,1:00:24.69,general text,,0,0,0,,Sinabi ko sa kanya ang tungkol sa iyong mga mata
Dialogue: 0,1:00:29.28,1:00:30.82,behind the scenes,,0,0,0,,Ngayon magbubukas na ang lahat?
Dialogue: 0,1:00:32.45,1:00:35.12,pangkalahatang teksto,,0,0,0,,Kabanata, nakikita mo...
Dialogue: 0,1:00:36.70,1:00:39.12,general text,,0,0,0,,Hindi lang siya ang nagsisinungaling
Dialogue: 0,1:00:40.46,1:00:44.13,general text,,0,0,0,,Nakiusap sa akin ang lola niya, kaya nakipaglaro ako
Dialogue: 0,1:00:44.92,1:00:48.30,pangkalahatang teksto,,0,0,0,,Napakahirap ng kanyang pamilya
Dialogue: 0,1:00:48.38,1:00:50.30,pangkalahatang teksto,,0,0,0,,Nagsinungaling siya na siya ay bulag,
Dialogue: 0,1:00:50.88,1:00:53.35,general text,,0,0,0,,upang hindi siya ibenta para makabayad ng mga utang
Dialogue: 0,1:00:53.43,1:00:55.64,general text,,0,0,0,,Tulad ng mga nagpapanggap na pilay,
Dialogue: 0,1:00:55.72,1:00:57.68,pangkalahatang teksto,,0,0,0,,para hindi na makipagdigma
Dialogue: 0,1:00:57.77,1:01:01.56,general text,,0,0,0,,Bakit ka nagsinungaling nang makarating ka sa Chwisongra?
Dialogue: 0,1:01:04.11,1:01:06.61,italics,,0,0,0,,Gusto niyang tumakas
Dialogue: 0,1:01:07.28,1:01:09.11,general text,,0,0,0,,Syempre, nabenta
Dialogue: 0,1:01:09.19,1:01:12.66,pangkalahatang teksto,,0,0,0,,Ngunit ang pagiging bulag ay mas madaling makatakas
Dialogue: 0,1:01:13.28,1:01:15.62,general text,,0,0,0,,- Tama ba ako?\N- Oo
Dialogue: 0,1:01:15.70,1:01:18.66,general text,,0,0,0,,Sinubukan kong tumakas nang makilala ko ang may-ari
Dialogue: 0,1:01:19.37,1:01:22.04,general text,,0,0,0,,Naawa siya sa akin at pinapasok niya ako.
Dialogue: 0,1:01:24.92,1:01:27.09,pangkalahatang teksto,,0,0,0,,Paumanhin sa pagsisinungaling, kabanata
Dialogue: 0,1:01:28.30,1:01:29.55,pangkalahatang text,,0,0,0,,Mali ako
Dialogue: 0,1:01:30.88,1:01:32.34,pangkalahatang teksto,,0,0,0,,Maliban sa kasinungalingang ito,
Dialogue: 0,1:01:32.43,1:01:34.26,general text,,0,0,0,,wala siyang ibang kasalanan
Dialogue: 0,1:01:34.34,1:01:38.06,general text,,0,0,0,,Siya ay palaging isang mabuting apo at isang mabait na babae
Dialogue: 0,1:01:49.82,1:01:51.99,general text,,0,0,0,,Bakit ka nagsinungaling?
Dialogue: 0,1:01:53.07,1:01:56.03,pangkalahatang text,,0,0,0,,Kumita lang ako ng pera
Dialogue: 0,1:01:56.62,1:01:57.91,general text,,0,0,0,,Kumita ka ba ng pera?
Dialogue: 0,1:02:00.66,1:02:03.00,general text,,0,0,0,,Hindi ka ba bulag?
Dialogue: 0,1:02:06.21,1:02:07.09,pangkalahatang text,,0,0,0,,Well, yes
Dialogue: 0,1:02:07.17,1:02:10.63,pangkalahatang teksto,,0,0,0,,Palagi itong tila kakaiba sa akin
Dialogue: 0,1:02:11.63,1:02:13.76,general text,,0,0,0,,- Ano?\N- Kahit bulag,
Dialogue: 0,1:02:13.84,1:02:16.09,general text,,0,0,0,,lagi mong alam kung sino ang nakatayo sa harap mo
Dialogue: 0,1:02:16.18,1:02:18.22,pangkalahatang teksto,,0,0,0,,Alam kung uulan o snow
Dialogue: 0,1:02:18.81,1:02:23.31,pangkalahatang teksto,,0,0,0,,Akala ng mga taganayon ay nagsisinungaling ka tungkol sa pagkabulag
Dialogue: 0,1:02:23.39,1:02:26.31,general text,,0,0,0,,Natakot sila at iniwasan ka
Dialogue: 0,1:02:27.48,1:02:29.15,pangkalahatang teksto,,0,0,0,,- Nakikita ko\N- Sa pangkalahatan,
Dialogue: 0,1:02:29.23,1:02:31.69,general text,,0,0,0,,kung kailangan mo ng tulong, pumunta ka sa inn
Dialogue: 0,1:02:31.78,1:02:32.82,pangkalahatang text,,0,0,0,,Okay?
Dialogue: 0,1:02:33.57,1:02:34.49,pangkalahatang teksto,,0,0,0,,Nga pala
Dialogue: 0,1:02:35.03,1:02:37.32,general text,,0,0,0,,Nagkita na ba kayo ni So Yi?
Dialogue: 0,1:02:38.41,1:02:39.58,general text,,0,0,0,,So ako?
Dialogue: 0,1:02:39.66,1:02:41.66,general text,,0,0,0,,Nasa kabisera na siya ngayon
Dialogue: 0,1:02:41.75,1:02:43.54,general text,,0,0,0,,Hinahanap siya ng ilang bandido
Dialogue: 0,1:02:43.62,1:02:46.04,general text,,0,0,0,,Ano ang ginawa niya sa pagkakataong ito?
Dialogue: 0,1:02:46.12,1:02:49.42,general text,,0,0,0,,Ninakawan niya ang bahay mo pagkatapos mamatay ang lola mo
Dialogue: 0,1:02:50.25,1:02:52.38,pangkalahatang text,,0,0,0,,Huwag kang pakialaman
Dialogue: 0,1:02:52.46,1:02:55.05,general text,,0,0,0,,Mukhang may tinatago ka kay Sosnovy Bor
Dialogue: 0,1:02:56.43,1:02:59.64,general text,,0,0,0,,Sabi mo pinaghirapan mo ang pera. Sino ang nagbayad sa iyo?
Dialogue: 0,1:02:59.72,1:03:00.81,pangkalahatang teksto,,0,0,0,,Ju Wol
Dialogue: 0,1:03:05.73,1:03:07.23,pangkalahatang teksto,,0,0,0,,Huwag kang magpasalamat sa akin
Dialogue: 0,1:03:07.73,1:03:09.77,pangkalahatang text,,0,0,0,,Ito ay pera ni Mr. Chan
Dialogue: 0,1:03:14.24,1:03:19.12,mga alaala,,0,0,0,,Kung may magtatanong tungkol kay Moo Deok,
Dialogue: 0,1:03:19.20,1:03:20.33,mga alaala,,0,0,0,,gamitin ang perang ito
Dialogue: 0,1:03:21.49,1:03:24.08,mga alaala,,0,0,0,,Siyempre, kalahati ay sa iyo
Dialogue: 0,1:03:24.75,1:03:27.67,pangkalahatang teksto,,0,0,0,,Wala akong itinago na karumaldumal
Dialogue: 0,1:03:27.75,1:03:29.67,pangkalahatang teksto,,0,0,0,,Nakuha ko ang aking bahagi
Dialogue: 0,1:03:30.75,1:03:32.55,pangkalahatang teksto,,0,0,0,,Oo, at gusto kita
Dialogue: 0,1:03:33.55,1:03:35.22,general text,,0,0,0,,Nagpapasalamat talaga ako
Dialogue: 0,1:03:35.30,1:03:38.01,pangkalahatang teksto,,0,0,0,,Ano ba talaga ang mali sa iyong mga mata?
Dialogue: 0,1:03:43.06,1:03:44.18,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,1:03:44.27,1:03:45.98,general text,,0,0,0,,May mga dahilan siguro
Dialogue: 0,1:03:50.52,1:03:54.86,behind the scenes,,0,0,0,,Kung hindi pa naghanda si Chang Wook, nalaman na ni Park Jin ang lahat.
Dialogue: 0,1:03:55.49,1:03:59.76,voiceover,,0,0,0,,Pag nahuli nila ako, maghihirap din si Chan Wook
Dialogue: 0,1:04:13.34,1:04:15.26,pangkalahatang teksto,,0,0,0,,Welcome Master Lee Chul
Dialogue: 0,1:04:16.17,1:04:18.47,pangkalahatang teksto,,0,0,0,,Salamat sa imbitasyon, Kamahalan
Dialogue: 0,1:04:20.72,1:04:22.64,mga alaala,,0,0,0,,Itong shaman na si Choi
Dialogue: 0,1:04:23.22,1:04:25.18,memories,,0,0,0,,sabi mo patayin mo ako?
Dialogue: 0,1:04:28.44,1:04:30.65,behind the scenes,,0,0,0,,Shaman Choi
Dialogue: 0,1:04:30.73,1:04:32.48,voiceover,,0,0,0,,Ito ba ang reyna?
Dialogue: 0,1:04:38.78,1:04:39.82,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,1:04:43.28,1:04:45.08,pangkalahatang teksto,,0,0,0,,Kaya ako, na iyong binanggit
Dialogue: 0,1:04:45.70,1:04:48.33,general text,,0,0,0,,Baka ito yung babaeng naghahanap sayo kamakailan.
Dialogue: 0,1:04:49.58,1:04:51.71,general text,,0,0,0,,I heard she's dangerous. Mag-ingat ka
Dialogue: 0,1:04:55.13,1:04:58.05,behind the scenes,,0,0,0,,Hindi ko siya kilala dahil hindi ko siya kilala
Dialogue: 0,1:04:58.59,1:05:00.84,behind the scenes,,0,0,0,,Tanungin mo siya tungkol sa kanya?
Dialogue: 0,1:05:01.39,1:05:04.10,mga alaala,,0,0,0,,Kung kailangan mo ng tulong, pumunta ka sa inn
Dialogue: 0,1:05:05.22,1:05:06.77,pangkalahatang text,,0,0,0,,Inn...
Dialogue: 0,1:05:13.36,1:05:17.15,mga alaala na italics,,0,0,0,,Lahat ng tungkol sa iyo ay lumabas
Dialogue: 0,1:05:36.17,1:05:38.55,general text,,0,0,0,,Nandito na si Trader Kim mula sa Sari Village?
Dialogue: 0,1:05:38.63,1:05:40.47,general text,,0,0,0,,Oo, nandito siya
Dialogue: 0,1:05:40.97,1:05:42.55,pangkalahatang teksto,,0,0,0,,Huling silid sa ikalawang palapag
Dialogue: 0,1:05:48.35,1:05:51.64,pangkalahatang teksto,,0,0,0,,Ajusshi, ito si Moo Deok
Dialogue: 0,1:06:18.38,1:06:19.38,behind the scenes,,0,0,0,,Ajusshi...
Dialogue: 0,1:06:32.27,1:06:33.73,italics,,0,0,0,,Master Li
Dialogue: 0,1:06:33.81,1:06:36.61,general text,,0,0,0,,Kung ikaw ay estudyante ni Master So Kyung,
Dialogue: 0,1:06:36.69,1:06:38.73,pangkalahatang teksto,,0,0,0,,ngayon ay mahigit isang daang taong gulang ka na
Dialogue: 0,1:06:38.82,1:06:41.44,general text,,0,0,0,,Paano ka nakaligtas ng ganito?
Dialogue: 0,1:06:42.03,1:06:45.16,general text,,0,0,0,,Ilang taon mo ba ako ibibigay?
Dialogue: 0,1:06:46.36,1:06:48.87,italics,,0,0,0,,Higit sa trenta
Dialogue: 0,1:06:48.95,1:06:51.58,pangkalahatang teksto,,0,0,0,,Labing apatnapung taon
Dialogue: 0,1:06:52.41,1:06:56.08,general text,,0,0,0,,Tama ka. Ito ang aking biological age
Dialogue: 0,1:06:57.00,1:06:57.96,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:06:58.04,1:07:00.84,pangkalahatang teksto,,0,0,0,,Ang aking kaluluwa ay isang daang taong gulang na
Dialogue: 0,1:07:01.42,1:07:04.42,pangkalahatang teksto,,0,0,0,,Ang katawan kung saan ako ipinanganak ay matagal nang naging alabok
Dialogue: 0,1:07:04.51,1:07:07.18,pangkalahatang teksto,,0,0,0,,Ang katawan na ito ay hindi sa akin
Dialogue: 0,1:07:09.39,1:07:10.26,italics,,0,0,0,,Maghintay
Dialogue: 0,1:07:11.01,1:07:13.77,general text,,0,0,0,,So isa kang nomad?
Dialogue: 0,1:07:13.85,1:07:14.85,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:07:15.89,1:07:18.27,pangkalahatang teksto,,0,0,0,,Ako ay isang lagalag
Dialogue: 0,1:07:26.95,1:07:28.24,pangkalahatang teksto,,0,0,0,,Kamahalan,
Dialogue: 0,1:07:28.32,1:07:32.45,general text,,0,0,0,,tinawag mo ako para humanap ng ibang nomad?
Dialogue: 0,1:07:33.04,1:07:34.20,general text,,0,0,0,,Hahanapin ko siya
Dialogue: 0,1:07:34.87,1:07:38.17,pangkalahatang teksto,,0,0,0,,Masasabi ko kung sino ang isang nomad
Dialogue: 0,1:07:49.51,1:07:53.56,voiceover,,0,0,0,,Alam niya sa simula pa lang na si Moo Deok ay isang nomad
Dialogue: 0,1:08:18.71,1:08:19.58,pangkalahatang text,,0,0,0,,Ikaw pala
Dialogue: 0,1:08:20.79,1:08:22.38,general text,,0,0,0,,pinatay siya
Dialogue: 0,1:09:04.92,1:09:06.55,preview,,0,0,0,,Bakit ang daming bangkay dito?
Dialogue: 0,1:09:06.63,1:09:09.05,preview,,0,0,0,,Anong klaseng buhay ang pinangunahan ni Moo Deok?
Dialogue: 0,1:09:09.13,1:09:11.93,preview,,0,0,0,,May tinatago si Moo Dok
Dialogue: 0,1:09:12.01,1:09:14.80,preview,,0,0,0,,- Ano ang hindi ma-reveal\N- Mga Mommies!
Dialogue: 0,1:09:15.68,1:09:17.64,preview,,0,0,0,,Magsisimula siyang tumahol sa halip
Dialogue: 0,1:09:18.39,1:09:22.10,preview,,0,0,0,,Gaya ng naisip ko, higit sa isang lagalag ang palasyo
Dialogue: 0,1:09:22.19,1:09:24.69,preview,,0,0,0,,Kung lumalabas na ang bituin ng Hari ay isang likha ng dark magic,
Dialogue: 0,1:09:24.77,1:09:27.19,preview,,0,0,0,,Matatapos na ang Pine Forest
Dialogue: 0,1:09:27.73,1:09:28.57,preview,,0,0,0,,Delikado ito
Dialogue: 0,1:09:28.65,1:09:31.24,preview,,0,0,0,,Hindi mo siya kilala, pero kilala niya si Moo Deok
Dialogue: 0,1:09:31.32,1:09:32.49,preview,,0,0,0,,Kailangan natin si Chang Gan
Dialogue: 0,1:09:32.57,1:09:35.08,preview,,0,0,0,,Hihintayin natin ang kanyang pagbabalik
Dialogue: 0,1:09:36.37,1:09:37.95,preview,,0,0,0,,Moo Dok, bakit ka nandito?
Dialogue: 0,1:09:38.04,1:09:40.25,preview,,0,0,0,,Hindi ko maiwan ang aking amo
Dialogue: 0,1:09:40.33,1:09:43.50,preview,,0,0,0,,Mahalin mo ako hanggang sa mamatay ka
Dialogue: 0,0:23:37.32,0:23:39.32,preview,,0,0,0,,

