Dialogue: 0,0:01:42.55,0:01:45.55,ذكريات بخط مائل,,0,0,0,,- الولد المسكين\N- المسكين
Dialogue: 0,0:01:45.63,0:01:48.10,ذكريات مائلة,,0,0,0,,- الجنة المقدسة\N- لا يصدق
Dialogue: 0,0:01:48.18,0:01:50.81,ذكريات بخط مائل,,0,0,0,,- لا بد أنه تجمد حتى الموت\N- يبدو الأمر كذلك
Dialogue: 0,0:01:50.89,0:01:53.64,ذكريات بخط مائل,,0,0,0,,- أشعر بالأسف عليه\N- عزيزي المسكين
Dialogue: 0,0:01:53.73,0:01:54.94,ذكريات بخط مائل,,0,0,0,,- إنه أمر مؤسف\N- كيف ذلك؟
Dialogue: 0,0:01:55.02,0:01:56.69,ذكريات,,0,0,0,,ماذا يحدث هنا؟ ما هذا؟
Dialogue: 0,0:01:56.77,0:01:58.94,ذكريات بخط مائل,,0,0,0,,مات صبي مشرد
Dialogue: 0,0:01:59.02,0:02:01.61,ذكريات,,0,0,0,,لقد كان مجرد طفل. أشعر بالأسف الشديد تجاهه
Dialogue: 0,0:02:01.69,0:02:04.74,ذكريات بخط مائل,,0,0,0,,كيف يكون هذا؟
Dialogue: 0,0:02:26.51,0:02:29.09,خلف الكواليس,,0,0,0,,كما أردت دائمًا،
Dialogue: 0,0:02:30.35,0:02:33.35,خلف الكواليس,,0,0,0,,سأقول لك بهدوء يا سيدي
Dialogue: 0,0:02:40.81,0:02:42.98,ذكريات بخط مائل,,0,0,0,,أشعر بالأسف الشديد عليه
Dialogue: 0,0:02:43.69,0:02:45.74,ذكريات مائلة,,0,0,0,,يبدو أنه يتيم
Dialogue: 0,0:02:45.82,0:02:47.32,ذكريات,,0,0,0,,هل نقيم له جنازة؟
Dialogue: 0,0:02:47.40,0:02:48.57,ذكريات,,0,0,0,,- نعم\N- هيا بنا
Dialogue: 0,0:02:48.66,0:02:49.70,ذكريات بخط مائل,,0,0,0,,ربما حرق الجثة...
Dialogue: 0,0:02:49.78,0:02:51.95,ذكريات بخط مائل,,0,0,0,,ونثر الرماد فوق بحيرة جيونج تشونج دايهو؟
Dialogue: 0,0:02:53.49,0:02:54.95,ذكريات بخط مائل,,0,0,0,,يا فتى...
Dialogue: 0,0:02:55.04,0:02:56.00,ذكريات,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:02:58.62,0:03:00.50,ذكريات بخط مائل,,0,0,0,,- هذا كل شيء...\N- كيف...
Dialogue: 0,0:03:00.58,0:03:03.63,ذكريات,,0,0,0,,- إلى أين يذهب؟\N- إلى أين أنت ذاهب؟
Dialogue: 0,0:03:11.85,0:03:13.35,ذكريات,,0,0,0,,توقف!
Dialogue: 0,0:03:24.69,0:03:25.78,ذكريات بخط مائل,,0,0,0,,الطفل
Dialogue: 0,0:03:25.86,0:03:28.20,ذكريات,,0,0,0,,هل طلبت مني أن أتوقف للتو؟
Dialogue: 0,0:03:30.32,0:03:31.45,ذكريات,,0,0,0,,يا له من أحمق!
Dialogue: 0,0:03:32.12,0:03:34.62,ذكريات,,0,0,0,,لا أصدق أنك أحرقت جسدي بالفعل
Dialogue: 0,0:03:37.16,0:03:39.16,ذكريات,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:03:41.17,0:03:44.59,ذكريات,,0,0,0,,لو تأخرت قليلاً لأحرقت عصاي أيضاً
Dialogue: 0,0:03:45.71,0:03:47.26,ذكريات,,0,0,0,,أحمق!
Dialogue: 0,0:03:49.97,0:03:51.14,ذكريات,,0,0,0,,أحمق!
Dialogue: 0,0:03:51.76,0:03:54.43,ذكريات,,0,0,0,,أحمق!
Dialogue: 0,0:03:55.47,0:03:57.52,ذكريات,,0,0,0,,أحمق!
Dialogue: 0,0:04:04.44,0:04:05.94,ذكريات,,0,0,0,,سيدي؟
Dialogue: 0,0:04:06.02,0:04:08.49,ذكريات,,0,0,0,,لقد غادرت جسدي مؤقتًا فقط،
Dialogue: 0,0:04:08.57,0:04:10.36,ذكريات,,0,0,0,,لمعرفة ما إذا كنت قد وصلت إلى هوانسو
Dialogue: 0,0:04:10.45,0:04:12.82,ذكريات,,0,0,0,,بعد مائة يوم من التأمل
Dialogue: 0,0:04:13.41,0:04:17.20,ذكريات,,0,0,0,,لكنني لاحظت أن جسدي يحترق، فانتقلت بسرعة إلى مكان آخر
Dialogue: 0,0:04:18.29,0:04:19.50,ذكريات,,0,0,0,,ولكن فات الأوان
Dialogue: 0,0:04:22.04,0:04:25.84,ذكريات,,0,0,0,,إذن أنت في جسد هذا الصبي؟
Dialogue: 0,0:04:25.92,0:04:28.13,ذكريات,,0,0,0,,هل أنت حقًا يا سيدي؟
Dialogue: 0,0:04:28.71,0:04:29.55,ذكريات,,0,0,0,,بالضبط
Dialogue: 0,0:04:29.63,0:04:32.63,ذكريات,,0,0,0,,أنا لي تشول، سيدك
Dialogue: 0,0:04:33.22,0:04:34.05,ذكريات,,0,0,0,,أوه...
Dialogue: 0,0:04:35.93,0:04:37.56,ذكريات,,0,0,0,,يا معلمة
Dialogue: 0,0:04:38.81,0:04:39.81,ذكريات,,0,0,0,,يا معلمة
Dialogue: 0,0:04:50.69,0:04:52.95,نص عام,,0,0,0,,أنا بدوي،
Dialogue: 0,0:05:03.21,0:05:04.29,خط مائل,,0,0,0,,جلالة الملك
Dialogue: 0,0:05:04.79,0:05:08.63,general text,,0,0,0,,ألم تتصل بي للعثور على البدو؟
Dialogue: 0,0:05:09.25,0:05:10.51,نص عام,,0,0,0,,هذا بالضبط ما سأفعله
Dialogue: 0,0:05:11.30,0:05:12.38,نص عام,,0,0,0,,أستطيع
Dialogue: 0,0:05:12.47,0:05:14.38,نص عام,,0,0,0,,التعرف على البدو
Dialogue: 0,0:05:48.75,0:05:50.88,النص العام,,0,0,0,,هل رأى أي شخص آخر وجهك؟
Dialogue: 0,0:05:55.34,0:05:56.34,ذكريات,,0,0,0,,هذه مظلة
Dialogue: 0,0:05:57.43,0:05:58.93,ذكريات,,0,0,0,,يمكن استخدامه كعصا
Dialogue: 0,0:06:01.68,0:06:02.68,نص عام,,0,0,0,,لا
Dialogue: 0,0:06:02.77,0:06:06.02,general text,,0,0,0,,في العاصمة لا أحد يعرف أنني مبصر
Dialogue: 0,0:06:07.19,0:06:10.23,نص عام,,0,0,0,,سيعتقد الناس أن قطاع الطرق قاتلوا هنا
Dialogue: 0,0:06:18.78,0:06:20.74,نص عام,,0,0,0,,كان عليك أن تتوقف عن البحث عني
Dialogue: 0,0:06:25.62,0:06:26.58,ذكريات,,0,0,0,,لذلك أنا
Dialogue: 0,0:06:29.84,0:06:31.42,ذكريات,,0,0,0,,إذن يي، هل هذه أنت؟
Dialogue: 0,0:06:31.50,0:06:33.05,ذكريات,,0,0,0,,أنا كيم من قرية ساري
Dialogue: 0,0:06:34.34,0:06:35.55,ذكريات,,0,0,0,,لقد أخطأت
Dialogue: 0,0:06:43.14,0:06:45.98,ذكريات,,0,0,0,,نحن بالكاد نعرف بعضنا البعض. بالكاد يعرفني
Dialogue: 0,0:06:46.06,0:06:47.10,ذكريات,,0,0,0,,عن ذلك الرجل
Dialogue: 0,0:06:47.73,0:06:49.15,ذكريات,,0,0,0,,يجب الاهتمام بها
Dialogue: 0,0:07:00.82,0:07:02.87,نص عام,,0,0,0,,لم يكن هناك داعي لقتله
Dialogue: 0,0:07:02.95,0:07:05.50,general text,,0,0,0,,لو ذهب إلى ساري لما التقينا مرة أخرى.
Dialogue: 0,0:07:05.58,0:07:06.66,نص عام,,0,0,0,,لكنك التقيت
Dialogue: 0,0:07:08.58,0:07:09.67,نص عام,,0,0,0,,قرية ساري؟
Dialogue: 0,0:07:12.34,0:07:13.88,نص عام,,0,0,0,,هل هذا هو المكان الذي أقمت فيه؟
Dialogue: 0,0:07:17.01,0:07:18.18,نص عام,,0,0,0,,كنت مختبئًا هناك
Dialogue: 0,0:07:19.18,0:07:22.39,نص عام,,0,0,0,,مخفي من هؤلاء البلطجية
Dialogue: 0,0:07:24.06,0:07:27.68,general text,,0,0,0,,هل بقي هناك أحد يستطيع التعرف عليك؟
Dialogue: 0,0:07:28.69,0:07:31.73,النص العام,,0,0,0,,لم أقترب من أحد حتى لا يتعرف علي
Dialogue: 0,0:07:32.94,0:07:34.48,نص عام,,0,0,0,,كنت هناك لصاً
Dialogue: 0,0:07:34.57,0:07:36.23,نص عام,,0,0,0,,- ما هذا؟\N- المال
Dialogue: 0,0:07:36.32,0:07:39.49,نص عام,,0,0,0,,سيكون الأمر مريبًا إذا لم تختفي الأموال
Dialogue: 0,0:07:40.95,0:07:42.16,نص عام,,0,0,0,,احتفظ بها لنفسك
Dialogue: 0,0:07:56.80,0:07:59.26,general text,,0,0,0,,لم أرد أن أؤذي أحداً من قرية ساري
Dialogue: 0,0:08:11.77,0:08:13.52,خلف الكواليس,,0,0,0,,مو دوك في العاصمة
Dialogue: 0,0:08:13.61,0:08:15.98,خارج الشاشة,,0,0,0,,إذا التقينا، هل سنضطر إلى قتلها؟
Dialogue: 0,0:08:18.94,0:08:21.20,general text,,0,0,0,,هل التاجر كيم من قرية ساري هنا؟
Dialogue: 0,0:08:21.78,0:08:23.78,نص عام,,0,0,0,,نعم، لقد وصل للتو
Dialogue: 0,0:08:23.87,0:08:25.91,نص عام,,0,0,0,,إنه في الغرفة الأخيرة في الطابق الثاني
Dialogue: 0,0:08:56.98,0:08:57.98,مائل,,0,0,0,,سيدتي؟
Dialogue: 0,0:09:05.62,0:09:09.70,نص عام,,0,0,0,,ما الذي أتى بك إلى هذا المكان؟
Dialogue: 0,0:09:09.79,0:09:12.25,نص عام,,0,0,0,,ليس من شأنك. أنت لم تراني هنا
Dialogue: 0,0:09:13.46,0:09:14.83,نص عام,,0,0,0,,سيدتي، هل أنت حقاً تلعبين؟
Dialogue: 0,0:09:17.46,0:09:18.50,نص عام,,0,0,0,,هل تحب القمار؟
Dialogue: 0,0:09:18.59,0:09:20.46,نص عام,,0,0,0,,ماذا؟ القمار؟
Dialogue: 0,0:09:21.13,0:09:24.09,نص عام,,0,0,0,,لمن تعتبرني؟ هل أنا نوع من البسطاء، في رأيك؟
Dialogue: 0,0:09:24.18,0:09:25.72,نص عام,,0,0,0,,لا بالطبع
Dialogue: 0,0:09:26.72,0:09:29.51,general text,,0,0,0,,لكنك كذبت علي عندما قلت أن اليشم لم ينكسر.
Dialogue: 0,0:09:29.60,0:09:33.52,general text,,0,0,0,,نظرًا لقدرتك على الكذب دون وخز الضمير،
Dialogue: 0,0:09:34.14,0:09:36.19,نص عام,,0,0,0,,اعتقدت أنه ربما لديك موهبة في المقامرة
Dialogue: 0,0:09:40.53,0:09:42.24,نص عام,,0,0,0,,جئت إلى التاجر لشراء التذاكر
Dialogue: 0,0:09:43.40,0:09:45.32,نص عام,,0,0,0,,تم بيع تذاكر العرض
Dialogue: 0,0:09:45.41,0:09:46.74,نص عام,,0,0,0,,لهذا السبب أتيت إلى هنا
Dialogue: 0,0:09:46.82,0:09:48.78,نقوش,,0,0,0,,تذكرة الدخول\N مجوس سوتشون
Dialogue: 0,0:09:49.70,0:09:52.50,النص العام,,0,0,0,,- لديك تذكرتان\N- سأذهب مع أمي
Dialogue: 0,0:09:52.58,0:09:54.33,نص عام,,0,0,0,,لا تخبر أحداً أنك رأيتني هنا
Dialogue: 0,0:09:54.41,0:09:56.79,نص عام,,0,0,0,,لا أريد أي سوء فهم
Dialogue: 0,0:09:56.88,0:09:58.17,نص عام,,0,0,0,,من يعلم
Dialogue: 0,0:09:58.25,0:10:00.80,النص العام,,0,0,0,,كما ترى، أنا لا أجيد الكذب مثلك
Dialogue: 0,0:10:00.88,0:10:03.42,general text,,0,0,0,,إذا سألني أحدهم، لست متأكدًا من أنني أستطيع الكذب
Dialogue: 0,0:10:04.76,0:10:07.64,نص عام,,0,0,0,,ولكن من أجلك سأحاول
Dialogue: 0,0:10:12.35,0:10:14.14,خط مائل,,0,0,0,,لقد التقيت بها هنا للتو.
Dialogue: 0,0:10:27.32,0:10:28.99,general text,,0,0,0,,لماذا رئيس سوسنوفي بور هنا؟
Dialogue: 0,0:10:32.33,0:10:36.29,نص عام,,0,0,0,,أتمنى ألا يكون هنا للحصول على التذاكر
Dialogue: 0,0:10:38.42,0:10:41.25,general text,,0,0,0,,إذن لن أتمكن من الذهاب إلى العرض مع Dong Gu
Dialogue: 0,0:11:22.21,0:11:23.50,نص عام,,0,0,0,,إنه أنت
Dialogue: 0,0:11:24.63,0:11:26.17,النص العام,,0,0,0,,قتله
Dialogue: 0,0:11:28.01,0:11:29.22,نص عام,,0,0,0,,هذا ليس أنا
Dialogue: 0,0:11:29.97,0:11:31.51,النص العام,,0,0,0,,لماذا قتلته؟
Dialogue: 0,0:11:31.60,0:11:32.97,نص عام,,0,0,0,,هذا ليس أنا حقًا
Dialogue: 0,0:11:33.05,0:11:35.02,النص العام,,0,0,0,,لقد كان ميتًا بالفعل عندما وصلت
Dialogue: 0,0:11:40.02,0:11:41.52,النص العام,,0,0,0,,لقد قُتل منذ وقت ليس ببعيد
Dialogue: 0,0:11:42.27,0:11:43.36,مائل,,0,0,0,,قُتل بضربة واحدة
Dialogue: 0,0:11:44.57,0:11:45.94,نص عام,,0,0,0,,مبارز ماهر
Dialogue: 0,0:11:46.61,0:11:49.07,نص عام,,0,0,0,,أقسم أنه ليس أنا
Dialogue: 0,0:11:49.95,0:11:51.87,نص عام,,0,0,0,,ليس لدي حتى سيف
Dialogue: 0,0:12:12.84,0:12:14.80,نص عام,,0,0,0,,أعتقد أن شخصًا واحدًا قتلهم
Dialogue: 0,0:12:16.10,0:12:17.39,نص عام,,0,0,0,,من هؤلاء الرجال؟
Dialogue: 0,0:12:17.47,0:12:22.44,general text,,0,0,0,,هؤلاء هم البلطجية الذين وصلوا العاصمة مؤخراً
Dialogue: 0,0:12:22.52,0:12:24.52,نص عام,,0,0,0,,لقد وصلوا
Dialogue: 0,0:12:24.61,0:12:28.57,نص عام,,0,0,0,,مع التاجر كيم من قرية ساري؟
Dialogue: 0,0:12:28.65,0:12:29.95,نص عام,,0,0,0,,لا
Dialogue: 0,0:12:30.03,0:12:34.57,general text,,0,0,0,,لكنني أتذكر كيف بدأ هؤلاء البلطجية القتال معه قبل بضعة أيام
Dialogue: 0,0:12:36.08,0:12:40.96,general text,,0,0,0,,أرادوا معرفة مكان وجود المحتال الذي كان يعيش في ساري.
Dialogue: 0,0:12:41.04,0:12:42.62,النص العام,,0,0,0,,ساري الاحتيال؟
Dialogue: 0,0:12:42.71,0:12:44.50,النص العام,,0,0,0,,ربما هذا مو دوك؟
Dialogue: 0,0:12:46.50,0:12:48.76,نص عام,,0,0,0,,أين هي؟
Dialogue: 0,0:12:53.47,0:12:55.14,نص عام,,0,0,0,,لقد كان هنا
Dialogue: 0,0:12:57.68,0:12:58.97,النص العام,,0,0,0,,لقد هربت
Dialogue: 0,0:13:09.61,0:13:10.82,خلف الكواليس,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:13:11.82,0:13:13.41,خارج الشاشة,,0,0,0,,ما هي هذه الجثث؟
Dialogue: 0,0:13:14.24,0:13:18.83,ذكريات,,0,0,0,,أرادوا معرفة مكان المحتال الذي عاش في ساري.
Dialogue: 0,0:13:19.79,0:13:21.16,التعليق الصوتي,,0,0,0,,هل يمكن أن يقصدوني؟
Dialogue: 0,0:13:22.29,0:13:25.33,خلف الكواليس,,0,0,0,,ما نوع الحياة التي عاشها مو دوك؟
Dialogue: 0,0:13:25.92,0:13:28.55,ذكريات,,0,0,0,,هل قابلت سو يي؟
Dialogue: 0,0:13:28.63,0:13:30.80,ذكريات,,0,0,0,,أتساءل ماذا فعلت هذه المرة
Dialogue: 0,0:13:30.88,0:13:32.67,ذكريات,,0,0,0,,لا تعبث معها
Dialogue: 0,0:13:34.84,0:13:35.89,نص عام,,0,0,0,,لذلك...
Dialogue: 0,0:13:37.68,0:13:39.10,نص عام,,0,0,0,,من هي سو يي؟
Dialogue: 0,0:13:42.02,0:13:44.14,نص عام,,0,0,0,,لم أرها بنفسي
Dialogue: 0,0:13:44.85,0:13:47.94,general text,,0,0,0,,لكنها تشاجرت مع جميع الحراس، بل وصفعت أحدهم على وجهه
Dialogue: 0,0:13:48.02,0:13:49.94,مائل,,0,0,0,,أنا متأكد من أنهم تذكروا وجهها
Dialogue: 0,0:13:50.86,0:13:54.03,نص عام,,0,0,0,,سيدتي، لم يأتي حارس واحد اليوم
Dialogue: 0,0:13:54.11,0:13:56.16,مائل,,0,0,0,,- كلاهما لم يأتيا؟\N- نعم
Dialogue: 0,0:13:56.24,0:13:58.74,نص عام,,0,0,0,,غريب. إنهم لا يفوتون العمل أبدًا
Dialogue: 0,0:14:04.54,0:14:07.25,نص عام,,0,0,0,,عذراً. لا ينبغي لنا أن نعامل الساحر بهذه الطريقة
Dialogue: 0,0:14:07.75,0:14:10.38,نص عام,,0,0,0,,ولكن هل هذا ضروري حقًا؟
Dialogue: 0,0:14:10.46,0:14:11.88,خط مائل,,0,0,0,"ماجو"؟
Dialogue: 0,0:14:11.96,0:14:13.38,general text,,0,0,0,,هل كذبت بشأن كونك ساحرًا؟
Dialogue: 0,0:14:14.88,0:14:16.09,النص العام,,0,0,0,,سأصبح هو قريباً
Dialogue: 0,0:14:16.68,0:14:20.68,نص عام,,0,0,0,,وحتى أقوى منك
Dialogue: 0,0:14:23.06,0:14:26.48,general text,,0,0,0,,كيف يجرؤ مزيف على التحدث معي بهذه الطريقة؟
Dialogue: 0,0:14:26.98,0:14:28.98,نص عام,,0,0,0,,سأتحدث إليك،
Dialogue: 0,0:14:29.94,0:14:32.78,نص عام,,0,0,0,,وسوف تخاطبني باحترام. أليس كذلك؟
Dialogue: 0,0:14:39.74,0:14:41.24,نص عام,,0,0,0,,اركض خلفه
Dialogue: 0,0:14:41.33,0:14:42.74,نص عام,,0,0,0,,هذا هو عملك
Dialogue: 0,0:14:49.67,0:14:53.09,general text,,0,0,0,,هناك فتاة اسمها مو ديوك من قرية ساري في جويسيونرو؟
Dialogue: 0,0:14:53.17,0:14:56.51,نص عام,,0,0,0,,نعم أعرفها. هل كنت تبحث عنها في تلك الليلة؟
Dialogue: 0,0:14:57.47,0:15:00.64,النص العام,,0,0,0,,أردت أن أطلب منها معروفًا وأرد له شيئًا
Dialogue: 0,0:15:00.72,0:15:02.76,النص العام,,0,0,0,,مو ديوك ليس في جويسيونرو
Dialogue: 0,0:15:02.85,0:15:06.02,general text,,0,0,0,,هي خادمة في عائلة جانغ، هذه عائلة غوانغجو جيونبوغوان
Dialogue: 0,0:15:06.68,0:15:08.06,نص عام,,0,0,0,,هل هي خادمة؟
Dialogue: 0,0:15:09.35,0:15:11.31,نص عام,,0,0,0,,يبدو أنها تستطيع الرؤية الآن حقًا
Dialogue: 0,0:15:12.19,0:15:14.28,نص عام,,0,0,0,,ربما هي خدعتك أيضًا
Dialogue: 0,0:15:14.36,0:15:16.03,general text,,0,0,0,,أحضروها إلى تشويسونرا، ظنوا أنها عمياء،
Dialogue: 0,0:15:16.11,0:15:18.53,general text,,0,0,0,,ولكن تفاجأ الجميع عندما فتحت عينيها وهربت.
Dialogue: 0,0:15:20.12,0:15:22.12,نص عام,,0,0,0,,لكنها ليست محتالة مثلي
Dialogue: 0,0:15:23.24,0:15:24.74,نص عام,,0,0,0,,كيف يمكنها أن ترى؟
Dialogue: 0,0:15:28.46,0:15:30.25,نص عام,,0,0,0,,أرجوك لا تقتلني
Dialogue: 0,0:15:31.17,0:15:32.38,نص عام,,0,0,0,,أنا آسف
Dialogue: 0,0:15:32.96,0:15:35.17,النص العام,,0,0,0,,لقد رأيت وجهي، لا أستطيع أن أتركك على قيد الحياة
Dialogue: 0,0:15:36.38,0:15:37.59,نص عام,,0,0,0,,من فضلك...
Dialogue: 0,0:16:01.74,0:16:05.29,النص العام,,0,0,0,,إذا كانت تستطيع الرؤية، فيمكنها التعرف علي
Dialogue: 0,0:16:07.66,0:16:09.58,general text,,0,0,0,,هل هي خادمة عائلة تشان؟
Dialogue: 0,0:16:11.37,0:16:12.92,نص عام,,0,0,0,,يجب أن أزورها
Dialogue: 0,0:16:15.50,0:16:17.30,general text,,0,0,0,,هل ارتكب مو دوك جريمة قتل؟
Dialogue: 0,0:16:17.88,0:16:21.05,general text,,0,0,0,,قُتل عدة رجال في النزل
Dialogue: 0,0:16:21.13,0:16:23.80,نص عام,,0,0,0,,كان مو دوك هناك
Dialogue: 0,0:16:23.89,0:16:27.64,general text,,0,0,0,,لكن مو دوك ليس قوياً بما يكفي لقتل شخص ما
Dialogue: 0,0:16:27.72,0:16:29.60,نص عام,,0,0,0,,وخاصة عدة رجال
Dialogue: 0,0:16:29.68,0:16:31.90,نص عام,,0,0,0,,تم ذلك بواسطة مبارز ماهر
Dialogue: 0,0:16:32.48,0:16:33.90,نص عام,,0,0,0,,إذا لم تكن هي،
Dialogue: 0,0:16:34.56,0:16:36.61,نص عام,,0,0,0,,لابد أن الساحر ساعدها
Dialogue: 0,0:16:38.11,0:16:39.28,نص عام,,0,0,0,,لا تخبرني،
Dialogue: 0,0:16:40.03,0:16:41.95,نص عام,,0,0,0,,إنك تشك في سيدنا
Dialogue: 0,0:16:43.07,0:16:44.32,نص عام,,0,0,0,,لا
Dialogue: 0,0:16:44.41,0:16:47.87,general text,,0,0,0,,ووك الآن في القصر مع السيد لي
Dialogue: 0,0:16:49.79,0:16:51.37,نص عام,,0,0,0,,الحمد لله
Dialogue: 0,0:16:51.46,0:16:53.88,نص عام,,0,0,0,,لا يمكن أن يكون مو دوك
Dialogue: 0,0:16:53.96,0:16:56.21,النص العام,,0,0,0,,ليس لديها سبب للقتل
Dialogue: 0,0:16:56.29,0:16:57.46,نص عام,,0,0,0,,العذراء كيم,
Dialogue: 0,0:16:57.55,0:17:00.92,نص عام,,0,0,0,,ما مدى معرفتك بمو ديوك؟
Dialogue: 0,0:17:02.51,0:17:03.80,نص عام,,0,0,0,,كما تعلمون،
Dialogue: 0,0:17:03.89,0:17:09.02,general text,,0,0,0,,ما نوع الحياة التي كانت تعيشها قبل أن تبدأ العمل هنا؟
Dialogue: 0,0:17:11.06,0:17:11.94,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:17:12.02,0:17:13.73,النص العام,,0,0,0,,قُتل -
Dialogue: 0,0:17:13.81,0:17:16.44,نص عام,,0,0,0,,الرجل الذي سألته عن ماضي مو ديوك
Dialogue: 0,0:17:18.15,0:17:20.11,النص العام,,0,0,0,,قطاع الطرق الذين ربما كانوا يبحثون عنها،
Dialogue: 0,0:17:20.99,0:17:22.61,نص عام,,0,0,0,,ميت أيضًا
Dialogue: 0,0:17:25.49,0:17:28.24,general text,,0,0,0,,من الواضح أنها ستتعرض للشبهة،
Dialogue: 0,0:17:28.33,0:17:30.87,general text,,0,0,0,,لكنها هربت بدلاً من إثبات براءتها
Dialogue: 0,0:17:31.37,0:17:32.50,نص عام,,0,0,0,,ما أنا متأكد منه -
Dialogue: 0,0:17:32.58,0:17:37.21,النص العام,,0,0,0,,مو دوك يخفي شيئًا ما،
Dialogue: 0,0:17:37.29,0:17:40.71,نص عام,,0,0,0,,ما لا يمكن الإفصاح عنه
Dialogue: 0,0:17:50.77,0:17:53.27,نص عام,,0,0,0,,الحراس يعيشون هناك
Dialogue: 0,0:17:53.35,0:17:55.19,نص عام,,0,0,0,,سيكون أسرع
Dialogue: 0,0:17:55.27,0:17:58.44,نص عام,,0,0,0,,ارسم صورتها وابحث عنها بنفسك
Dialogue: 0,0:17:58.52,0:18:00.11,نص عام,,0,0,0,,لا أعرف كيف تبدو
Dialogue: 0,0:18:00.19,0:18:03.03,general text,,0,0,0,,- التقيت بها عندما كنت لا أزال أعمى\N- اعتقدت أنك لست كذلك
Dialogue: 0,0:18:04.28,0:18:08.32,general text,,0,0,0,,تقول أنك كنت أعمى ثم تقول أنك لست أعمى
Dialogue: 0,0:18:09.53,0:18:12.45,general text,,0,0,0,,لا أعرف ما الذي يحدث هناك، لكن من الواضح أن حياتك ليست سكرًا
Dialogue: 0,0:18:14.75,0:18:18.00,general text,,0,0,0,,إذًا أنت لا تعرفها بالبصر، لكنها تعرفك؟
Dialogue: 0,0:18:18.96,0:18:21.17,نص عام,,0,0,0,,ربما يكون البحث عنها خطيرًا؟
Dialogue: 0,0:18:21.25,0:18:23.97,general text,,0,0,0,,ماذا لو قتلت هؤلاء الناس؟
Dialogue: 0,0:18:24.05,0:18:25.55,النص العام,,0,0,0,,وفجأة يؤذيك
Dialogue: 0,0:18:26.88,0:18:29.72,general text,,0,0,0,,الأخطر أن تكون قائداً مشتبهاً به
Dialogue: 0,0:18:32.60,0:18:35.23,general text,,0,0,0,,قد تتأذى أيضًا، لكنك دفعت للتاجر
Dialogue: 0,0:18:35.31,0:18:36.56,نص عام,,0,0,0,,أهذا هو؟
Dialogue: 0,0:18:37.56,0:18:39.73,نص عام,,0,0,0,,لم أفهم ماذا تقصد
Dialogue: 0,0:18:40.52,0:18:41.57,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:18:42.44,0:18:44.74,نص عام,,0,0,0,,تظاهر أنك لا تعرف شيئاً
Dialogue: 0,0:18:45.70,0:18:47.32,خط مائل,,0,0,0,,مات شخص ما!
Dialogue: 0,0:19:06.88,0:19:09.01,مائل,,0,0,0,,الجارديان لي والحارس تشان!
Dialogue: 0,0:19:17.06,0:19:20.56,النص العام,,0,0,0,,سوف يمنح هوانجسو قوة لا تصدق
Dialogue: 0,0:19:21.23,0:19:24.86,نص عام,,0,0,0,,كنت أظن أن كل البدو وحوش
Dialogue: 0,0:19:25.49,0:19:27.57,general text,,0,0,0,,لكنك اكتسبت الشباب والخلود
Dialogue: 0,0:19:29.11,0:19:31.16,نص عام,,0,0,0,,اتضح الآن،
Dialogue: 0,0:19:31.24,0:19:33.87,نص عام,,0,0,0,,لماذا أراد الجميع حجر ثلج للكيمياء
Dialogue: 0,0:19:34.62,0:19:37.41,general text,,0,0,0,,الجميع أراده كثيرًا، وقاتلوا إلى الأبد
Dialogue: 0,0:19:37.50,0:19:39.29,النص العام,,0,0,0,,لذلك هذا السحر حرام
Dialogue: 0,0:19:39.37,0:19:40.75,نص عام,,0,0,0,,حسنًا يا سيد لي
Dialogue: 0,0:19:41.67,0:19:43.59,نص عام,,0,0,0,,يمكنك التعرف عليهم
Dialogue: 0,0:19:43.67,0:19:45.09,نص عام,,0,0,0,,انظر حولك
Dialogue: 0,0:19:45.63,0:19:48.51,نص عام,,0,0,0,,هل يوجد بدو في القصر؟
Dialogue: 0,0:20:02.31,0:20:05.19,نص عام,,0,0,0,,مجرد النظر إلى شخص ما لا يكفي
Dialogue: 0,0:20:05.27,0:20:07.44,نص عام,,0,0,0,,إذا كانت العلامة الزرقاء غير مرئية
Dialogue: 0,0:20:07.53,0:20:09.45,نص عام,,0,0,0,,أو علامات التوحش,
Dialogue: 0,0:20:09.53,0:20:11.61,النص العام,,0,0,0,,لا يمكن تمييزهم عن الأشخاص العاديين
Dialogue: 0,0:20:12.53,0:20:15.33,نص عام,,0,0,0,,إذن كيف تتعرف عليهم؟
Dialogue: 0,0:20:16.24,0:20:18.20,نص عام,,0,0,0,,الخوف من القبض عليهم
Dialogue: 0,0:20:20.29,0:20:22.46,نص عام,,0,0,0,,الخوف من التحجير
Dialogue: 0,0:20:26.67,0:20:28.46,النص العام,,0,0,0,,علينا أن نتخلص من هذا الخوف
Dialogue: 0,0:20:29.05,0:20:31.84,general text,,0,0,0,,فأنت تزرع الخوف في نفوسهم؟
Dialogue: 0,0:20:31.93,0:20:33.72,نص عام,,0,0,0,,آسف إذا خيبت ظنك
Dialogue: 0,0:20:34.30,0:20:35.35,نص عام,,0,0,0,,بدلاً من ذلك
Dialogue: 0,0:20:36.64,0:20:38.81,نص عام,,0,0,0,,سأعطيك هدية
Dialogue: 0,0:20:38.89,0:20:40.94,نص عام,,0,0,0,,هدية؟ ماذا هناك؟
Dialogue: 0,0:20:42.19,0:20:43.35,نص عام,,0,0,0,,كلب
Dialogue: 0,0:20:44.36,0:20:45.31,نص عام,,0,0,0,,كلب؟
Dialogue: 0,0:20:45.40,0:20:48.07,النص العام,,0,0,0,,إنه ذكي جدًا ومطيع
Dialogue: 0,0:20:48.15,0:20:50.36,نص عام,,0,0,0,,وهو الآن واقف على أبواب القصر
Dialogue: 0,0:20:50.45,0:20:52.49,نص عام,,0,0,0,,هل يمكنني الاقتباس منه؟
Dialogue: 0,0:20:52.57,0:20:54.70,general text,,0,0,0,,بما أن هذه هدية فطبعاً
Dialogue: 0,0:20:55.49,0:20:56.66,نص عام,,0,0,0,,أحضر الكلب
Dialogue: 0,0:20:57.58,0:20:58.45,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:20:59.16,0:21:00.83,نص عام,,0,0,0,,أريدك أن تحضره
Dialogue: 0,0:21:02.87,0:21:06.34,النص العام,,0,0,0,,إذا تمكنت من ذلك سأكافئك
Dialogue: 0,0:21:36.62,0:21:39.08,التعليق الصوتي,,0,0,0,,ربما يجب أن أهرب مع مو دوك؟
Dialogue: 0,0:21:40.66,0:21:42.71,خلف الكواليس,,0,0,0,,حينها سيفهم الجميع
Dialogue: 0,0:21:43.75,0:21:47.17,تعليق صوتي,,0,0,0,,والآن أنا ضعيف ولن أحمي معلمتي
Dialogue: 0,0:21:52.17,0:21:54.22,التعليق الصوتي,,0,0,0,,أتساءل ماذا سيفعل السيد "لي"؟
Dialogue: 0,0:22:23.00,0:22:24.21,نص عام,,0,0,0,,نائب
Dialogue: 0,0:22:25.25,0:22:26.62,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:22:30.13,0:22:34.67,general text,,0,0,0,,هل هذه هدية رقيقة من السيد إلى الملك؟
Dialogue: 0,0:22:34.76,0:22:38.47,النص العام,,0,0,0,,قال السيد لي أن الكلب سيتبعك
Dialogue: 0,0:22:39.05,0:22:40.64,نص عام,,0,0,0,,ولكن كن حذراً
Dialogue: 0,0:22:41.56,0:22:44.73,general text,,0,0,0,,ما خطورة أخذه إلى القصر؟
Dialogue: 0,0:22:45.31,0:22:46.48,نص عام,,0,0,0,,ما الأمر؟
Dialogue: 0,0:22:48.02,0:22:48.98,نص عام,,0,0,0,,هذا غويغو
Dialogue: 0,0:22:49.77,0:22:51.32,النص العام,,0,0,0,,أحضر غويجا إلى القصر
Dialogue: 0,0:22:52.65,0:22:53.94,النص العام,,0,0,0,,لكن غويغو وحش
Dialogue: 0,0:22:54.86,0:22:56.70,general text,,0,0,0,,كيف يحضره إلى القصر؟
Dialogue: 0,0:22:58.78,0:23:02.20,نص عام,,0,0,0,,استاذتي سيو كيونغ تستخدم غويغا
Dialogue: 0,0:23:02.29,0:23:05.04,نص عام,,0,0,0,,للبحث عن الآثار التي خلقها السحر الأسود
Dialogue: 0,0:23:05.12,0:23:07.87,نص عام,,0,0,0,,استخدام حجر الجليد
Dialogue: 0,0:23:07.96,0:23:09.67,نص عام,,0,0,0,,نعم سمعت
Dialogue: 0,0:23:09.75,0:23:12.71,نص عام,,0,0,0,,لكنني اعتقدت أنه لا يمكن استخدامه بعد الآن،
Dialogue: 0,0:23:12.80,0:23:14.71,نص عام,,0,0,0,,لأن جرته مكسورة
Dialogue: 0,0:23:14.80,0:23:15.76,نص عام,,0,0,0,,لذلك
Dialogue: 0,0:23:16.63,0:23:20.85,general text,,0,0,0,,لقد نقلت روح غويغو إلى جسد كلب ميت.
Dialogue: 0,0:23:23.14,0:23:24.68,نص عام,,0,0,0,,الكلب الذي أحضرته,
Dialogue: 0,0:23:25.73,0:23:26.98,نص عام,,0,0,0,,هذا غويغو
Dialogue: 0,0:23:29.90,0:23:30.94,نص عام,,0,0,0,,غويغو؟
Dialogue: 0,0:23:35.48,0:23:36.57,نص عام,,0,0,0,,ماذا يجب أن نفعل؟
Dialogue: 0,0:23:38.11,0:23:39.95,نص عام,,0,0,0,,كم منا في القصر؟
Dialogue: 0,0:23:40.53,0:23:41.70,نص عام,,0,0,0,,أكثر من عشرة
Dialogue: 0,0:23:42.28,0:23:43.66,general text,,0,0,0,,هل انتقلت إلى جيونبوغوان؟
Dialogue: 0,0:23:43.74,0:23:46.62,النص العام,,0,0,0,,أرسلت رجلاً، سيصلون قريباً
Dialogue: 0,0:24:12.44,0:24:16.82,general text,,0,0,0,,تم تنظيم هذا الاجتماع من أجل إحلال السلام بين السحرة والقصر
Dialogue: 0,0:24:17.49,0:24:20.82,general text,,0,0,0,,ولي العهد زار سوسنوفي بور، وقد شرفك بدعوتك هنا
Dialogue: 0,0:24:20.91,0:24:22.45,نص عام,,0,0,0,,وتريد إحضاره هنا
Dialogue: 0,0:24:22.53,0:24:24.70,general text,,0,0,0,,وحش دون استئذان جلالته؟
Dialogue: 0,0:24:24.78,0:24:26.79,نص عام,,0,0,0,,أذن له
Dialogue: 0,0:24:26.87,0:24:28.66,نص عام,,0,0,0,,والآن غويغو
Dialogue: 0,0:24:28.75,0:24:31.46,general text,,0,0,0,,ليس وحشاً، لأنه في جسد كلب عادي
Dialogue: 0,0:24:31.54,0:24:34.67,general text,,0,0,0,,إذن لن يتمكن من إيذاء البدو حتى لو وجده؟
Dialogue: 0,0:24:34.75,0:24:38.26,general text,,0,0,0,,سيبدأ بالنباح فنفهم
Dialogue: 0,0:24:39.55,0:24:40.59,نص عام,,0,0,0,,اللحمة
Dialogue: 0,0:24:41.80,0:24:42.80,نص عام,,0,0,0,,ووف!
Dialogue: 0,0:25:00.57,0:25:01.99,خلف الكواليس,,0,0,0,,هذا بدوي
Dialogue: 0,0:25:02.86,0:25:05.95,خلف الكواليس,,0,0,0,,كما كنا نظن البدو الرحل في القصر
Dialogue: 0,0:25:12.46,0:25:13.58,نص عام,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:25:14.33,0:25:17.55,النص العام,,0,0,0,,إذن هناك بدو في قصري؟
Dialogue: 0,0:25:19.34,0:25:20.38,نص عام,,0,0,0,,يبدو الأمر كذلك
Dialogue: 0,0:25:21.09,0:25:23.59,general text,,0,0,0,,إذن لماذا تقف هنا؟
Dialogue: 0,0:25:23.68,0:25:26.43,نص عام,,0,0,0,,اذهب وأمسك به!
Dialogue: 0,0:25:26.51,0:25:29.39,النص العام,,0,0,0,,كما قلت الكلب هدية
Dialogue: 0,0:25:29.47,0:25:32.35,نص عام,,0,0,0,,سأترك الأمر هنا
Dialogue: 0,0:25:32.44,0:25:34.65,نص عام,,0,0,0,,بواسطته ستجد الجميع
Dialogue: 0,0:25:34.73,0:25:36.36,نص عام,,0,0,0,,بدو في القصر
Dialogue: 0,0:25:37.19,0:25:38.98,نص عام,,0,0,0,,خذوه، لسنا بحاجة إليه
Dialogue: 0,0:25:39.61,0:25:42.19,نص عام,,0,0,0,,كيف تجرؤ على إحضار هذا الوحش إلى هنا؟!
Dialogue: 0,0:25:42.28,0:25:43.90,النص العام,,0,0,0,,الملك يعاني من القلق
Dialogue: 0,0:25:43.99,0:25:46.87,general text,,0,0,0,,هل تحاولين إيذائه بهذا الوحش؟
Dialogue: 0,0:25:49.24,0:25:52.87,نص عام,,0,0,0,,أمي، نحن أنفسنا دعونا السيد لي إلى القصر
Dialogue: 0,0:25:52.96,0:25:54.67,نص عام,,0,0,0,,لا تتورط في هذا
Dialogue: 0,0:25:55.54,0:25:59.13,general text,,0,0,0,,إنها مسؤولية جيونبوغوان حماية القصر
Dialogue: 0,0:25:59.21,0:26:01.46,نص عام,,0,0,0,,إذا تم استخدام السحر الأسود في القصر،
Dialogue: 0,0:26:01.55,0:26:03.38,نص عام,,0,0,0,,سوف يكتشفون الأمر
Dialogue: 0,0:26:03.47,0:26:06.01,النص العام,,0,0,0,,لا أريد أن أرى وحشًا في جسد كلب،
Dialogue: 0,0:26:06.09,0:26:07.89,نص عام,,0,0,0,,ولا أهل سوسنوفي بور
Dialogue: 0,0:26:08.43,0:26:11.31,general text,,0,0,0,,أنت تحاول إذلالنا
Dialogue: 0,0:26:13.35,0:26:15.23,النص العام,,0,0,0,,أوقفهم يا صاحب الجلالة
Dialogue: 0,0:26:43.09,0:26:45.67,general text,,0,0,0,,ابن غوانغجو جيونبوغوان يجب أن يحمي القصر،
Dialogue: 0,0:26:45.76,0:26:47.72,نص عام,,0,0,0,,ولقد أحضرت هذا الوحش إلى هنا
Dialogue: 0,0:26:49.60,0:26:51.68,النص العام,,0,0,0,,هذه هدية من السيد لي إلى الملك
Dialogue: 0,0:26:51.76,0:26:53.31,نص عام,,0,0,0,,دعونا ندخل
Dialogue: 0,0:26:53.39,0:26:55.73,نص عام,,0,0,0,,لقد أمرت بإحضاره
Dialogue: 0,0:27:01.36,0:27:02.36,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:27:02.44,0:27:04.36,نص عام,,0,0,0,,ثم حاول تسجيل الدخول
Dialogue: 0,0:27:04.94,0:27:06.82,النص العام,,0,0,0,,اقتل هذا الوحش الذي دخل القصر
Dialogue: 0,0:27:09.32,0:27:12.28,ذكريات,,0,0,0,,إذا تعاملت معها سأكافئك
Dialogue: 0,0:27:12.87,0:27:15.62,التعليق الصوتي,,0,0,0,,فطلب مني إحضار الكلب؟
Dialogue: 0,0:27:44.07,0:27:45.69,مائل,,0,0,0,,جلالة الملك، هذا جين مو
Dialogue: 0,0:27:46.28,0:27:48.90,general text,,0,0,0,,سأتخلص من هؤلاء الوقحين من سوسنوفي بور
Dialogue: 0,0:27:49.45,0:27:52.45,النص العام,,0,0,0,,نحن هنا بدعوته، ولم ننتهي من الحديث
Dialogue: 0,0:27:52.53,0:27:54.58,general text,,0,0,0,,جين مو، لا ينبغي أن تتورط في هذا
Dialogue: 0,0:27:54.66,0:27:56.95,general text,,0,0,0,,كيف تجرؤ على إحضار هذا الوحش إلى هنا دون إذن؟!
Dialogue: 0,0:27:57.04,0:27:58.66,general text,,0,0,0,,أي سلوك هذا؟!
Dialogue: 0,0:27:58.75,0:27:59.96,نص عام,,0,0,0,,صمت
Dialogue: 0,0:28:16.39,0:28:18.68,نص عام,,0,0,0,,حراس! لا تقف هناك! أوقفه!
Dialogue: 0,0:28:23.27,0:28:24.40,نص عام,,0,0,0,,أبتاه
Dialogue: 0,0:28:24.48,0:28:26.07,نص عام,,0,0,0,,أوقف كلاهما
Dialogue: 0,0:28:26.15,0:28:28.40,general text,,0,0,0,,إذا بدأ القتال ستنتهي علاقتنا
Dialogue: 0,0:28:28.99,0:28:29.95,النص العام,,0,0,0,,يجب أن نقاتل!
Dialogue: 0,0:28:30.03,0:28:32.95,النص العام,,0,0,0,,جلبت غابة الصنوبر هذا الوحش إلى هنا!
Dialogue: 0,0:28:33.03,0:28:34.62,general text,,0,0,0,,يجب على تشونبوغوان أن يحمينا
Dialogue: 0,0:28:35.37,0:28:37.20,النص العام,,0,0,0,,- أبي!\N- صاحب الجلالة
Dialogue: 0,0:28:41.87,0:28:42.96,نص عام,,0,0,0,,آمر الجميع...
Dialogue: 0,0:28:45.00,0:28:46.09,نص عام,,0,0,0,,توقف
Dialogue: 0,0:29:05.36,0:29:06.65,نص عام,,0,0,0,,توقف!
Dialogue: 0,0:29:21.33,0:29:22.58,نص عام,,0,0,0,,السيد لي,
Dialogue: 0,0:29:22.67,0:29:25.46,general text,,0,0,0,,لقد دعوتك بطريقة ودية، هل كان من الضروري إخافتي بهذه الطريقة؟
Dialogue: 0,0:29:26.13,0:29:27.67,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:29:28.63,0:29:32.01,general text,,0,0,0,,يا صاحب الجلالة، إذا تم فتح حجر الجليد،
Dialogue: 0,0:29:32.09,0:29:34.55,نص عام,,0,0,0,,سفك الدماء سيبدأ من جديد
Dialogue: 0,0:29:35.14,0:29:36.22,نص عام,,0,0,0,,حجر الجليد؟
Dialogue: 0,0:29:36.30,0:29:37.97,مائل,,0,0,0,,هل بسبب البدو؟
Dialogue: 0,0:29:38.06,0:29:39.64,نص عام,,0,0,0,,الأشخاص الذين استخدموا
Dialogue: 0,0:29:39.72,0:29:42.73,نص عام,,0,0,0,,عاكسات لكيمياء النفوس بعد الفوضى الكبرى
Dialogue: 0,0:29:43.44,0:29:47.40,general text,,0,0,0,,يبدو أن هناك من يصنع العاكسات مرة أخرى
Dialogue: 0,0:29:49.32,0:29:52.70,نص عام,,0,0,0,,حجر ثلج مطبوع
Dialogue: 0,0:29:58.87,0:29:59.91,مائل,,0,0,0,,و؟
Dialogue: 0,0:29:59.99,0:30:02.16,نص عام,,0,0,0,,أين هو؟ في أيدي من؟
Dialogue: 0,0:30:02.96,0:30:04.71,نص عام,,0,0,0,,ربما يكون مع هؤلاء
Dialogue: 0,0:30:04.79,0:30:08.29,general text,,0,0,0,,من أرسل ناك سو وحوّل ساحر سوسنوفي بور إلى بدو
Dialogue: 0,0:30:08.88,0:30:10.55,نص عام,,0,0,0,,سمعت المعلم سو كيونغ
Dialogue: 0,0:30:10.63,0:30:12.92,نص عام,,0,0,0,,دمرت كل أحجار الجليد قبل 200 عام
Dialogue: 0,0:30:13.01,0:30:13.92,نص عام,,0,0,0,,على ما يبدو,
Dialogue: 0,0:30:14.01,0:30:17.93,general text,,0,0,0,,لم يتم تدميرها كلها، بقي بعضها في سوسنوفي بور
Dialogue: 0,0:30:18.01,0:30:21.56,نص عام,,0,0,0,,ليس من السهل كبح رغبات الإنسان
Dialogue: 0,0:30:21.64,0:30:22.68,نص عام,,0,0,0,,لكن
Dialogue: 0,0:30:24.02,0:30:25.73,نص عام,,0,0,0,,عودة حجر الجليد
Dialogue: 0,0:30:25.81,0:30:29.06,النص العام,,0,0,0,,يشير إلى قدوم رجل مثل المعلم سو كيونغ
Dialogue: 0,0:30:32.28,0:30:35.32,general text,,0,0,0,,ولد السيد سو كيونغ تحت نجم الملك
Dialogue: 0,0:30:35.90,0:30:38.03,النص العام,,0,0,0,,لكنه لم يصبح ملكاً
Dialogue: 0,0:30:39.74,0:30:41.12,نص عام,,0,0,0,,هل تريد أن تقول،
Dialogue: 0,0:30:41.91,0:30:44.37,النص العام,,0,0,0,,هل هناك شخص آخر ولد تحت هذا النجم؟
Dialogue: 0,0:30:49.21,0:30:51.63,مائل,,0,0,0,,وإن وجد فنوره ضعيف
Dialogue: 0,0:30:51.71,0:30:55.92,italics,,0,0,0,,وطاقة النجوم السبعة المحيطة به لم تتجلى بعد
Dialogue: 0,0:30:57.01,0:30:59.22,general text,,0,0,0,,قوة يمكنها مقاومة الطبيعة،
Dialogue: 0,0:30:59.30,0:31:03.18,النص العام,,0,0,0,,وجلب الفوضى للعالم، واستيقظ من جديد
Dialogue: 0,0:31:03.27,0:31:05.35,مائل,,0,0,0,,سيظهر الشخص الذي سيوقف هذا
Dialogue: 0,0:31:06.23,0:31:07.31,نص عام,,0,0,0,,معجبون بهذا
Dialogue: 0,0:31:08.60,0:31:11.65,نص عام,,0,0,0,,سيتم الحفاظ على التوازن في العالم
Dialogue: 0,0:31:17.65,0:31:22.41,نص عام,,0,0,0,,ما أريد قوله فلا داعي للقلق
Dialogue: 0,0:31:23.87,0:31:27.46,نص عام,,0,0,0,,آمل أن يجلب لك هذا السلام
Dialogue: 0,0:31:32.71,0:31:35.09,نص عام,,0,0,0,,شكرًا على كلامك
Dialogue: 0,0:31:35.92,0:31:38.51,خط مائل,,0,0,0,,الآن يجب أن أذهب
Dialogue: 0,0:31:39.22,0:31:41.55,النص العام,,0,0,0,,لقد رفضت هديتي،
Dialogue: 0,0:31:41.64,0:31:44.35,نص عام,,0,0,0,,لذلك سآخذ غفيجا معي
Dialogue: 0,0:31:46.06,0:31:48.06,النص العام,,0,0,0,,- صاحب الجلالة\N- افعل ما يحلو لك
Dialogue: 0,0:32:07.41,0:32:09.54,نص عام,,0,0,0,,لا، انتظر
Dialogue: 0,0:32:10.37,0:32:12.21,نص عام,,0,0,0,,هل سنرحل؟
Dialogue: 0,0:32:12.29,0:32:13.84,نص عام,,0,0,0,,لقد رأيت كل ما أردت
Dialogue: 0,0:32:16.30,0:32:19.01,ذكريات بخط مائل,,0,0,0,,إذن هناك بدو في قصري؟
Dialogue: 0,0:32:19.51,0:32:21.14,ذكريات,,0,0,0,,خذوه، لا نحتاجه
Dialogue: 0,0:32:21.22,0:32:23.80,ذكريات,,0,0,0,,كيف تجرؤ على إحضار هذا الوحش إلى هنا؟!
Dialogue: 0,0:32:25.18,0:32:26.93,general text,,0,0,0,,أظهروا أنفسهم عندما زرعت الخوف فيهم
Dialogue: 0,0:32:30.60,0:32:32.31,نص عام,,0,0,0,,هل أنت خائف؟
Dialogue: 0,0:32:32.40,0:32:33.98,نص عام,,0,0,0,,لم تصب بأذى؟
Dialogue: 0,0:32:34.06,0:32:35.86,نص عام,,0,0,0,,كيف تأذيت؟
Dialogue: 0,0:32:37.07,0:32:40.03,general text,,0,0,0,,الكلب بخير ولكني لست كذلك بسببك
Dialogue: 0,0:32:41.78,0:32:42.82,نص عام,,0,0,0,,تألم؟
Dialogue: 0,0:32:43.49,0:32:45.99,general text,,0,0,0,,لقد تأذيت عندما تشاجرت مع هؤلاء اللصوص، أليس كذلك؟
Dialogue: 0,0:32:46.08,0:32:47.87,general text,,0,0,0,,أمامه طريق طويل ليقطعه، أليس كذلك؟
Dialogue: 0,0:32:50.25,0:32:52.04,النص العام,,0,0,0,,انتظر، هذه دماء. يؤذي؟
Dialogue: 0,0:32:52.88,0:32:54.04,نص عام,,0,0,0,,هذا هو دمي
Dialogue: 0,0:32:54.13,0:32:55.42,النص العام,,0,0,0,,لم يتأذى على الإطلاق...
Dialogue: 0,0:32:56.13,0:32:58.17,general text,,0,0,0,,- الدم...\N- أنت مغطى به
Dialogue: 0,0:32:58.84,0:33:00.76,نص عام,,0,0,0,,حسنًا، جيد
Dialogue: 0,0:33:06.18,0:33:07.47,نص عام,,0,0,0,,هل يؤلمك؟
Dialogue: 0,0:33:09.27,0:33:10.43,نص عام,,0,0,0,,على ما يبدو نعم
Dialogue: 0,0:33:11.06,0:33:13.40,نص عام,,0,0,0,,مؤلم...
Dialogue: 0,0:33:22.95,0:33:25.12,خارج الشاشة,,0,0,0,,غويغو ينتمي إلى السيد لي
Dialogue: 0,0:33:25.62,0:33:28.54,التعليق الصوتي,,0,0,0,,كم يعرف عن مو دوك؟
Dialogue: 0,0:33:29.54,0:33:31.50,خلف الكواليس,,0,0,0,,وماذا ستفعل المملكة المتحدة,
Dialogue: 0,0:33:31.58,0:33:33.37,التعليق الصوتي,,0,0,0,,متى سيكتشف أمر ناك سو؟
Dialogue: 0,0:33:42.05,0:33:43.09,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:33:44.59,0:33:45.72,نص عام,,0,0,0,,الكل في القطع
Dialogue: 0,0:33:45.80,0:33:47.55,نص عام,,0,0,0,,أنا بخير
Dialogue: 0,0:33:47.64,0:33:50.35,نص عام,,0,0,0,,هل وجدت البدو؟ ماذا عن الحجر؟
Dialogue: 0,0:33:51.52,0:33:52.98,نص عام,,0,0,0,,ليس لديك أدنى فكرة...
Dialogue: 0,0:33:53.69,0:33:56.02,النص العام,,0,0,0,,روحي تكاد تتحرك من الرعب
Dialogue: 0,0:33:56.61,0:33:59.11,general text,,0,0,0,,حدثوا مشهداً لكن لم يجدوا أحداً؟
Dialogue: 0,0:33:59.19,0:34:02.61,نص عام,,0,0,0,,دع الكلب يعض أحداً
Dialogue: 0,0:34:03.24,0:34:04.32,خط مائل,,0,0,0,,المملكة المتحدة
Dialogue: 0,0:34:04.40,0:34:06.57,نص عام,,0,0,0,,ابحث عن البدو في القصر
Dialogue: 0,0:34:06.66,0:34:08.99,النص العام,,0,0,0,,أصعب من سوسنوفي بور أو جيونبوغوان
Dialogue: 0,0:34:10.20,0:34:11.70,نص عام,,0,0,0,,إذا خرجت الأمور عن السيطرة،
Dialogue: 0,0:34:11.79,0:34:14.29,general text,,0,0,0,,سينشأ صراع بين القصر وسوسنوفي بور
Dialogue: 0,0:34:17.42,0:34:18.38,خط مائل,,0,0,0,,لنذهب
Dialogue: 0,0:34:18.46,0:34:19.80,نص عام,,0,0,0,,أنت بحاجة إلى الترقيع
Dialogue: 0,0:34:20.50,0:34:21.51,خط مائل,,0,0,0,,رئيسة
Dialogue: 0,0:34:25.05,0:34:27.05,نص عام,,0,0,0,,انتظر قليلاً
Dialogue: 0,0:34:27.14,0:34:30.22,general text,,0,0,0,,لقد طلب ولي العهد مرافقتك إلى قصره
Dialogue: 0,0:34:30.81,0:34:33.10,النص العام,,0,0,0,,- ولي العهد؟\N- ستمطر
Dialogue: 0,0:34:33.18,0:34:35.56,نص عام,,0,0,0,,يريدك أن تنتظريه
Dialogue: 0,0:34:37.81,0:34:38.90,نص عام,,0,0,0,,الرصاصة
Dialogue: 0,0:34:47.74,0:34:50.49,نص عام,,0,0,0,,المملكة المتحدة، أرسلها أولاً
Dialogue: 0,0:34:50.58,0:34:52.08,نص عام,,0,0,0,,في سوسنوفي بور
Dialogue: 0,0:34:53.25,0:34:54.41,نص عام,,0,0,0,,تعال هنا
Dialogue: 0,0:34:55.83,0:34:56.96,نص عام,,0,0,0,,هنا
Dialogue: 0,0:35:09.18,0:35:12.81,general text,,0,0,0,,كان عليك أن تخبرني أنهم مدعوون إلى القصر!
Dialogue: 0,0:35:12.89,0:35:14.06,نص عام,,0,0,0,,اعتقدت أن هذا سيكون
Dialogue: 0,0:35:14.81,0:35:16.52,نص عام,,0,0,0,,اجتماع عادي
Dialogue: 0,0:35:17.02,0:35:18.06,نص عام,,0,0,0,,إذا كانت الملكة
Dialogue: 0,0:35:18.15,0:35:20.52,general text,,0,0,0,,سوف تعاني، ستتحول إلى حجر، مثل الخصي كيم
Dialogue: 0,0:35:20.61,0:35:22.32,نص عام,,0,0,0,,قطعة لحم عديمة الفائدة!
Dialogue: 0,0:35:34.45,0:35:36.54,النص العام,,0,0,0,,شخص ولد تحت نجم الملك،
Dialogue: 0,0:35:36.62,0:35:38.92,general text,,0,0,0,,ما الذي سيكرر مصير المعلمة سو كيونغ؟
Dialogue: 0,0:35:41.25,0:35:43.84,general text,,0,0,0,,إذا تبين أن هذا النجم هو ثمرة السحر الأسود،
Dialogue: 0,0:35:44.80,0:35:46.72,نص عام,,0,0,0,,نهاية غابة الصنوبر
Dialogue: 0,0:35:50.68,0:35:53.97,نص عام,,0,0,0,,أرسلت جفيجا إلى سوسنوفي بور
Dialogue: 0,0:35:55.06,0:35:57.10,نص عام,,0,0,0,,آسفة لإخافتك
Dialogue: 0,0:35:57.18,0:35:59.44,general text,,0,0,0,,عندما تم العثور على البدو في سوسنوفي بور،
Dialogue: 0,0:35:59.52,0:36:01.90,نص عام,,0,0,0,,ظننت أنهم قد يكونون في القصر أيضاً
Dialogue: 0,0:36:02.94,0:36:06.15,النص العام,,0,0,0,,حتى أنه حاول الوصول إلى هنا مؤخرًا
Dialogue: 0,0:36:06.90,0:36:09.03,نص عام,,0,0,0,,سمعت أنها صنعته
Dialogue: 0,0:36:09.11,0:36:10.86,نص عام,,0,0,0,,وقتل ناك سو
Dialogue: 0,0:36:15.29,0:36:16.37,نص عام,,0,0,0,,ناك سو؟
Dialogue: 0,0:36:18.25,0:36:21.08,نص عام,,0,0,0,,المرتزق الذي قتل العديد من المحاربين
Dialogue: 0,0:36:21.75,0:36:23.59,general text,,0,0,0,,تطير الرؤوس من كتفيها حيث كانت
Dialogue: 0,0:36:23.67,0:36:25.55,نص عام,,0,0,0,,لهذا سميت بهذا الاسم
Dialogue: 0,0:36:25.63,0:36:29.22,general text,,0,0,0,,هناك شائعات بأنها بدوية وأنها على قيد الحياة
Dialogue: 0,0:36:32.43,0:36:34.05,نص عام,,0,0,0,,نوماد ناك سو؟
Dialogue: 0,0:36:35.64,0:36:37.39,نص عام,,0,0,0,,إشاعات مثيرة للاهتمام
Dialogue: 0,0:37:11.63,0:37:15.26,نص عام,,0,0,0,,آمل أن يتم القبض على مو دوك قبل عودة السيد.
Dialogue: 0,0:37:22.52,0:37:24.19,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:37:26.48,0:37:27.86,نص عام,,0,0,0,,لماذا ترتعش؟
Dialogue: 0,0:37:28.48,0:37:30.82,general text,,0,0,0,,هل تصدق حقًا أنني قتلت شخصًا ما؟
Dialogue: 0,0:37:32.82,0:37:34.82,نص عام,,0,0,0,,تفضل بالدخول
Dialogue: 0,0:37:40.25,0:37:41.71,نص عام,,0,0,0,,لماذا أتيت؟
Dialogue: 0,0:37:42.66,0:37:44.00,general text,,0,0,0,,خذ الأشياء وهرب؟
Dialogue: 0,0:37:44.08,0:37:46.13,نص عام,,0,0,0,,جئت لأطلب شيئاً
Dialogue: 0,0:37:46.71,0:37:48.92,general text,,0,0,0,,قال الرأس ليمسك بك بمجرد ظهورك
Dialogue: 0,0:37:49.92,0:37:51.09,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:37:51.17,0:37:52.47,نص عام,,0,0,0,,لم تفعل هذا؟
Dialogue: 0,0:37:53.18,0:37:56.01,general text,,0,0,0,,- ليس أنا\N- إذن لماذا هربت؟
Dialogue: 0,0:37:56.68,0:37:58.10,نص عام,,0,0,0,,كان علي أن أفعل ذلك
Dialogue: 0,0:37:59.47,0:38:00.77,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:38:01.52,0:38:02.60,نص عام,,0,0,0,,لديك
Dialogue: 0,0:38:03.52,0:38:05.40,نص عام,,0,0,0,,هل من أسرار؟
Dialogue: 0,0:38:10.90,0:38:12.24,نص عام,,0,0,0,,السيد الشاب
Dialogue: 0,0:38:13.32,0:38:15.03,نص عام,,0,0,0,,هل تعلم بهم؟
Dialogue: 0,0:38:21.04,0:38:24.62,general text,,0,0,0,,مو دوك، يجب أن تهرب
Dialogue: 0,0:38:25.21,0:38:26.29,نص عام,,0,0,0,,سأعطيك المال
Dialogue: 0,0:38:26.37,0:38:27.96,نص عام,,0,0,0,,اركض ولا ترجع
Dialogue: 0,0:38:28.04,0:38:29.17,نص عام,,0,0,0,,لا أستطيع
Dialogue: 0,0:38:30.38,0:38:32.71,نص عام,,0,0,0,,لا أستطيع ترك سيدي
Dialogue: 0,0:38:32.80,0:38:34.05,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:38:35.30,0:38:38.43,general text,,0,0,0,,إذا بقيت قريبًا فسوف يقع أيضًا تحت الشبهات
Dialogue: 0,0:38:38.51,0:38:39.85,نص عام,,0,0,0,,إذا كنت قلقة عليه،
Dialogue: 0,0:38:40.64,0:38:42.10,نص عام,,0,0,0,,إذن ساعدني
Dialogue: 0,0:38:42.18,0:38:45.10,general text,,0,0,0,,لا تريد التحدث إلى الرأس، ولا تريد الهرب أيضًا
Dialogue: 0,0:38:45.69,0:38:47.02,نص عام,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,0:38:48.69,0:38:50.52,النص العام,,0,0,0,,يجب أن نجد القاتل
Dialogue: 0,0:38:51.98,0:38:56.36,general text,,0,0,0,,القاتل يقتل من يعرفه بالبصر
Dialogue: 0,0:39:01.41,0:39:03.45,النص العام,,0,0,0,,هل يعيش غوانغجو جيونغبوغوان هنا؟
Dialogue: 0,0:39:04.29,0:39:06.16,نص عام,,0,0,0,,على ما يبدو عائلة مؤثرة
Dialogue: 0,0:39:08.12,0:39:11.42,general text,,0,0,0,,هل يعرفك أحد من عائلة تشان؟
Dialogue: 0,0:39:14.13,0:39:17.34,نص عام,,0,0,0,,انتظر عند الزاوية. سأحضر هذا الرجل
Dialogue: 0,0:39:28.14,0:39:30.31,نص عام,,0,0,0,,أريد أن أطلب من شخص ما التأكيد،
Dialogue: 0,0:39:30.40,0:39:33.98,نص عام,,0,0,0,,أنني لم أكن في الغرفة عندما قُتل هؤلاء الأشخاص
Dialogue: 0,0:39:35.36,0:39:36.65,نص عام,,0,0,0,,ومن؟
Dialogue: 0,0:39:37.24,0:39:38.61,نص عام,,0,0,0,,الآنسة جين من جينيوون
Dialogue: 0,0:39:39.61,0:39:41.20,نص عام,,0,0,0,,قابلتها هناك
Dialogue: 0,0:39:42.20,0:39:44.37,general text,,0,0,0,,هذا المخنث لن يوافق على مقابلتك
Dialogue: 0,0:39:45.62,0:39:46.83,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:39:47.96,0:39:50.21,نص عام,,0,0,0,,خذني إلى جينيوون
Dialogue: 0,0:39:52.42,0:39:53.42,نص عام,,0,0,0,,جينيوون؟
Dialogue: 0,0:40:18.03,0:40:21.45,النص العام,,0,0,0,,عذراً، هل يمكنك مساعدتي في رفع العكاز؟
Dialogue: 0,0:40:27.91,0:40:28.87,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:40:29.75,0:40:32.29,نص عام,,0,0,0,,هل يمكنك أن تخبرني أين أنا؟
Dialogue: 0,0:40:33.04,0:40:37.01,نص عام,,0,0,0,,في منزل غوانغجو جيونبوغوان
Dialogue: 0,0:40:38.80,0:40:39.97,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:40:41.01,0:40:42.09,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:40:55.36,0:40:56.61,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:40:56.69,0:40:57.73,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:41:05.53,0:41:07.49,خلف الكواليس,,0,0,0,,على ما يبدو أن مو دوك يمكنه الرؤية الآن
Dialogue: 0,0:41:08.12,0:41:10.08,خارج الشاشة,,0,0,0,,لكنها لم تتعرف علي
Dialogue: 0,0:41:10.87,0:41:12.54,خلف الكواليس,,0,0,0,,أتمنى أن يكون هذا للأفضل
Dialogue: 0,0:41:16.17,0:41:17.42,نص عام,,0,0,0,,لماذا أنت وحدك؟
Dialogue: 0,0:41:18.21,0:41:21.13,نص عام,,0,0,0,,لقد كنت مخطئًا. نحن لا نعرفها على الإطلاق
Dialogue: 0,0:41:22.55,0:41:24.97,نص عام,,0,0,0,,لقد انتهينا. دعونا نعود إلى جيونبوغوان
Dialogue: 0,0:41:37.15,0:41:38.69,نص عام,,0,0,0,,هل يمكنني المحاولة؟
Dialogue: 0,0:41:38.78,0:41:39.65,نص عام,,0,0,0,,- No\N- No
Dialogue: 0,0:41:39.73,0:41:41.86,نص عام,,0,0,0,,توقف
Dialogue: 0,0:41:41.95,0:41:43.86,خط مائل,,0,0,0,,أنا مبتل
Dialogue: 0,0:41:43.95,0:41:45.57,نص عام,,0,0,0,,هذه هي تلك المظلة
Dialogue: 0,0:41:46.20,0:41:47.12,ذكريات,,0,0,0,,هذه مظلة
Dialogue: 0,0:41:48.08,0:41:49.95,ذكريات,,0,0,0,,يمكن استخدامه كعصا
Dialogue: 0,0:41:52.96,0:41:55.50,النص العام,,0,0,0,,أمي سوف توبخني، توقف عن ذلك
Dialogue: 0,0:41:55.58,0:41:56.50,نص عام,,0,0,0,,كفى
Dialogue: 0,0:41:57.17,0:41:59.42,نص عام,,0,0,0,,- مستحيل\N- مرحبًا
Dialogue: 0,0:42:00.71,0:42:03.72,نص عام,,0,0,0,,هل تريد أن تتبادل معي المظلات؟
Dialogue: 0,0:42:07.60,0:42:11.89,نص عام,,0,0,0,,سمعت حركات ناك سو
Dialogue: 0,0:42:11.98,0:42:15.73,نص عام,,0,0,0,,في جسد شاب طويل القامة وقوي البنية.
Dialogue: 0,0:42:15.81,0:42:19.32,general text,,0,0,0,,يمكنها أن تنتقل إلى جسد امرأة صغيرة وضعيفة
Dialogue: 0,0:42:21.40,0:42:26.03,general text,,0,0,0,,بمثل هذا الجسد الضعيف لن يكون هناك أي فائدة من لمسها
Dialogue: 0,0:42:28.91,0:42:30.04,نص عام,,0,0,0,,ولكن لا
Dialogue: 0,0:42:30.58,0:42:32.79,general text,,0,0,0,,ناك سو ذو الرداء الأزرق كان رجلاً بالتأكيد
Dialogue: 0,0:42:33.58,0:42:35.00,نص عام,,0,0,0,"ناك سو باللون الأزرق"
Dialogue: 0,0:42:35.08,0:42:38.46,general text,,0,0,0,,- سمعت عنه\N- كان يرتدي اللون الأزرق بالكامل
Dialogue: 0,0:42:38.54,0:42:42.63,النص العام,,0,0,0,,انتشر في كل مكان، وبدأ الناس يتجولون باللون الأزرق
Dialogue: 0,0:42:42.71,0:42:45.09,نص عام,,0,0,0,,ظنوا ذلك حينها
Dialogue: 0,0:42:45.18,0:42:48.22,general text,,0,0,0,,ناك سو باللون الأزرق سيحميهم من كيمياء النفوس
Dialogue: 0,0:42:49.93,0:42:51.72,general text,,0,0,0,,كان ناك سو مرتزقًا،
Dialogue: 0,0:42:53.22,0:42:56.14,general text,,0,0,0,,لكنها لم تقتل الناس العاديين، ولم تكن لديها القوة
Dialogue: 0,0:43:01.78,0:43:04.65,نص عام,,0,0,0,,يمكن أن يكون الناس أغبياء جدًا
Dialogue: 0,0:43:04.74,0:43:06.32,نص عام,,0,0,0,,هذا ليس غباء
Dialogue: 0,0:43:07.20,0:43:08.45,نص عام,,0,0,0,,هذا هو الخوف
Dialogue: 0,0:43:11.20,0:43:13.79,general text,,0,0,0,,جثة ناك سو احترقت، الجميع يعرف ذلك
Dialogue: 0,0:43:14.66,0:43:17.46,نص عام,,0,0,0,,هذا عمل الأقوياء والمؤثرين
Dialogue: 0,0:43:19.25,0:43:20.71,نص عام,,0,0,0,,سموهم حمقى،
Dialogue: 0,0:43:21.67,0:43:23.84,نص عام,,0,0,0,,عندما يكونون خائفين فقط، فهذا خطأ
Dialogue: 0,0:43:33.10,0:43:36.73,النص العام,,0,0,0,,جمعتكم على أمل إيجاد حل،
Dialogue: 0,0:43:36.81,0:43:40.02,نص عام,,0,0,0,,لكن لديك الجرأة لتجلس هنا وتنتقدني
Dialogue: 0,0:43:43.27,0:43:46.99,general text,,0,0,0,,أنا أفهم أنك تريد إذلال بعضكما البعض،
Dialogue: 0,0:43:47.07,0:43:50.24,نص عام,,0,0,0,,لكنني آمل أن نبدأ جميعنا بالانسجام
Dialogue: 0,0:43:51.16,0:43:53.41,نص عام,,0,0,0,,السيد لي معنا أيضًا
Dialogue: 0,0:43:53.49,0:43:54.66,خط مائل,,0,0,0,,دعونا نشرب الشاي
Dialogue: 0,0:43:57.75,0:43:59.04,خط مائل,,0,0,0,,صاحب السمو
Dialogue: 0,0:44:00.04,0:44:01.38,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:44:04.80,0:44:07.55,النص العام,,0,0,0,,العشيقة هو تطلب مقابلة
Dialogue: 0,0:44:07.63,0:44:08.63,نص عام,,0,0,0,,دعها تدخل
Dialogue: 0,0:44:17.14,0:44:18.43,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:44:18.52,0:44:20.98,نص عام,,0,0,0,,سمعت أن أحداً أصيب بعد الشجار
Dialogue: 0,0:44:21.56,0:44:23.19,نص عام,,0,0,0,,جئت لأتفقد
Dialogue: 0,0:44:25.32,0:44:27.61,خط مائل,,0,0,0,,أصيب واحد فقط هنا
Dialogue: 0,0:44:27.69,0:44:30.57,النص العام,,0,0,0,,- خذوه بعيداً وأشفيه\N- أنا بخير
Dialogue: 0,0:44:30.66,0:44:32.16,نص عام,,0,0,0,,لن يطول الأمر
Dialogue: 0,0:44:32.24,0:44:33.45,خط مائل,,0,0,0,,امشِ معي
Dialogue: 0,0:44:45.84,0:44:48.51,النص العام,,0,0,0,,يبدو أن تشان ووك سيخطب مرة أخرى
Dialogue: 0,0:44:48.59,0:44:49.63,نص عام,,0,0,0,,مرة أخرى؟
Dialogue: 0,0:44:49.72,0:44:51.72,general text,,0,0,0,,- ماذا يعني هذا؟\N{\i1}- ألا تعلم؟
Dialogue: 0,0:44:51.80,0:44:54.01,نص عام,,0,0,0,,هل تعرف حقًا شيئًا؟
Dialogue: 0,0:44:54.10,0:44:56.10,خط مائل,,0,0,0,,تنتشر الشائعات في سايجوكون
Dialogue: 0,0:44:56.18,0:44:59.89,general text,,0,0,0,,أنتم الثلاثة مرشحون محتملون لدور صهر السيد هو يوم
Dialogue: 0,0:45:00.48,0:45:02.15,general text,,0,0,0,,المملكة المتحدة هي الثالثة في القائمة
Dialogue: 0,0:45:02.23,0:45:04.06,النص العام,,0,0,0,,ولكن بالنسبة لها، على ما يبدو، هو الأول
Dialogue: 0,0:45:05.02,0:45:06.98,مائل,,0,0,0,,هو يوم يريد تزويجها هذا العام
Dialogue: 0,0:45:07.07,0:45:09.78,general text,,0,0,0,,قريباً سيتحدثون عن الخطوبة. أنا أؤكد لك
Dialogue: 0,0:45:15.87,0:45:19.79,نص عام,,0,0,0,,الجراح ليست عميقة. هذه الحبوب سوف توقف النزيف
Dialogue: 0,0:45:19.87,0:45:22.71,النص العام,,0,0,0,,كان ينبغي أن تعطيني إياهم على الفور
Dialogue: 0,0:45:22.79,0:45:24.63,نص عام,,0,0,0,,سمعت عن الجروح
Dialogue: 0,0:45:24.71,0:45:29.09,نص عام,,0,0,0,,أردت أن أتحقق من ذلك بنفسي لأهدأ
Dialogue: 0,0:45:31.80,0:45:32.88,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:45:33.55,0:45:37.89,general text,,0,0,0,,لقد جرحت أكثر من مرة فنشأت هذه الفكرة...
Dialogue: 0,0:45:39.02,0:45:40.27,نص عام,,0,0,0,,أنا بخير
Dialogue: 0,0:45:40.98,0:45:42.23,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:45:48.44,0:45:52.53,نص عام,,0,0,0,,أوه بالضبط. أعطتها لي الخادمة كيم
Dialogue: 0,0:45:52.61,0:45:55.24,نص عام,,0,0,0,,لم أشكرها بعد
Dialogue: 0,0:45:57.03,0:45:58.33,نص عام,,0,0,0,,إنها نفسها
Dialogue: 0,0:46:03.62,0:46:04.62,نص عام,,0,0,0,,نفس الشيء؟
Dialogue: 0,0:46:06.63,0:46:08.96,نص عام,,0,0,0,,دبوس شعر رأيته قبل عشرين عامًا
Dialogue: 0,0:46:09.59,0:46:11.63,النص العام,,0,0,0,,هل هذا شيء ذو قيمة؟
Dialogue: 0,0:46:16.34,0:46:17.80,نص عام,,0,0,0,,يبدو جديداً
Dialogue: 0,0:46:17.89,0:46:19.89,نص عام,,0,0,0,,ربما ليس لنا
Dialogue: 0,0:46:20.68,0:46:22.52,نص عام,,0,0,0,,لكن الأمر مشابه جدًا
Dialogue: 0,0:46:23.85,0:46:24.69,خط مائل,,0,0,0,,هذا كل شيء
Dialogue: 0,0:46:25.35,0:46:27.31,نص عام,,0,0,0,,يبدو أن الأمير كان على حق
Dialogue: 0,0:46:28.44,0:46:30.61,نص عام,,0,0,0,,قريباً سنسمع عن خطوبة أوكا
Dialogue: 0,0:46:30.69,0:46:32.65,general text,,0,0,0,,ولكن بالنسبة للسيد هوو فهو الثالث في القائمة
Dialogue: 0,0:46:34.99,0:46:37.32,general text,,0,0,0,,هل ستتزوجها بنفسك بما أنك الأول في هذه القائمة؟
Dialogue: 0,0:46:38.37,0:46:41.41,general text,,0,0,0,,إذا تزوجت عليك العودة إلى سيهو
Dialogue: 0,0:46:42.00,0:46:45.00,general text,,0,0,0,,يول، فقط لا تتزوج. سأكون وحيدا
Dialogue: 0,0:46:46.62,0:46:48.92,ذكريات بخط مائل,,0,0,0,,أستطيع التعرف على البدو
Dialogue: 0,0:46:57.51,0:47:00.05,النص العام,,0,0,0,,علينا أن نأخذه معنا إلى سيهو في أقرب وقت ممكن
Dialogue: 0,0:47:00.14,0:47:01.18,نص عام,,0,0,0,,من؟
Dialogue: 0,0:47:02.06,0:47:02.93,نص عام,,0,0,0,,أنا؟
Dialogue: 0,0:47:09.11,0:47:10.44,نص عام,,0,0,0,,أتراجع عن كلامي
Dialogue: 0,0:47:11.15,0:47:15.74,النص العام,,0,0,0,,شعرت بالهدوء بعد رؤية رد فعلك اليوم
Dialogue: 0,0:47:16.32,0:47:17.95,نص عام,,0,0,0,,يسعدني سماع ذلك
Dialogue: 0,0:47:18.87,0:47:20.91,نص عام,,0,0,0,,ماذا كنت تريد أن تسألني شخصياً؟
Dialogue: 0,0:47:23.08,0:47:25.66,نص عام,,0,0,0,,أعلم أن لديك السيف ناك سو
Dialogue: 0,0:47:25.75,0:47:27.75,نص عام,,0,0,0,,هل يمكنني التقاطه؟
Dialogue: 0,0:47:36.42,0:47:39.64,نص عام,,0,0,0,,شاهدت العرض العام الماضي
Dialogue: 0,0:47:40.22,0:47:41.47,نص عام,,0,0,0,,كانت هناك أفيال هناك
Dialogue: 0,0:47:41.97,0:47:45.18,general text,,0,0,0,,لكن عندما أذهب مع دان جو، يجب أن أتظاهر بأن هذه هي المرة الأولى لي هناك.
Dialogue: 0,0:47:45.27,0:47:47.81,general text,,0,0,0,,إذًا كانت تلك التذاكر لك وللسيد دان جو؟
Dialogue: 0,0:47:47.89,0:47:50.06,نص عام,,0,0,0,,خائف. ما الذي تفعله هنا؟
Dialogue: 0,0:47:50.15,0:47:52.69,نص عام,,0,0,0,,جئت أطلب معروفاً
Dialogue: 0,0:47:52.77,0:47:53.90,نص عام,,0,0,0,,عن الخدمة؟
Dialogue: 0,0:47:54.94,0:47:56.32,نص عام,,0,0,0,,لا تتعب نفسك
Dialogue: 0,0:47:56.40,0:47:59.49,النص العام,,0,0,0,,لا رغبة في مساعدتك
Dialogue: 0,0:47:59.57,0:48:01.20,النص العام,,0,0,0,,أنا متهم بجريمة قتل
Dialogue: 0,0:48:01.95,0:48:03.08,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:48:03.16,0:48:05.41,نص عام,,0,0,0,,يمكنك الذهاب إلى رئيس سوسنوفي بور
Dialogue: 0,0:48:06.12,0:48:08.54,نص عام,,0,0,0,,وقل أنك رأيتني؟
Dialogue: 0,0:48:09.67,0:48:13.92,general text,,0,0,0,,هل تريدني أن أذهب إلى رأسي وأعترف بأنني ذهبت
Dialogue: 0,0:48:14.50,0:48:15.76,نص عام,,0,0,0,,إلى مثل هذا المكان؟
Dialogue: 0,0:48:16.46,0:48:18.30,نص عام,,0,0,0,,لست مجنوناً
Dialogue: 0,0:48:20.18,0:48:21.80,نص عام,,0,0,0,,أنت أملي الوحيد
Dialogue: 0,0:48:22.47,0:48:24.35,نص عام,,0,0,0,,من فضلك
Dialogue: 0,0:48:27.43,0:48:28.60,نص عام,,0,0,0,,لا
Dialogue: 0,0:48:28.68,0:48:30.60,النص العام,,0,0,0,,لقد أخبرت دان جو أن لدي تذكرة إضافية
Dialogue: 0,0:48:30.69,0:48:32.56,النص العام,,0,0,0,,لا أريده أن يعرف من أين اشتريتها
Dialogue: 0,0:48:32.65,0:48:35.27,general text,,0,0,0,,عارك سيكون مؤقتاً،
Dialogue: 0,0:48:35.36,0:48:37.36,النص العام,,0,0,0,,ويمكنهم قتلي
Dialogue: 0,0:48:38.36,0:48:40.40,النص العام,,0,0,0,,إذا اكتشفت أمي ذلك، فلن أعيش أيضًا
Dialogue: 0,0:48:40.49,0:48:43.24,general text,,0,0,0,,لن تقتل ابنتها أبدًا!
Dialogue: 0,0:48:43.32,0:48:45.54,general text,,0,0,0,,لماذا تصرخ عندما جئت لطلب المساعدة؟
Dialogue: 0,0:48:48.29,0:48:51.58,general text,,0,0,0,,إذن يجب أن أخبر والدتك بكل شيء بنفسي
Dialogue: 0,0:48:52.08,0:48:53.71,نص عام,,0,0,0,,واطلب منها المساعدة
Dialogue: 0,0:48:53.79,0:48:55.42,النص العام,,0,0,0,,هل يجب أن أسأل أمي؟
Dialogue: 0,0:48:56.84,0:48:58.38,نص عام,,0,0,0,,ها هي قادمة
Dialogue: 0,0:49:00.76,0:49:03.80,general text,,0,0,0,,ما كان عليك أن تهتم بالهدايا كاعتذار عن الماضي
Dialogue: 0,0:49:05.10,0:49:08.77,general text,,0,0,0,,كلما فكرت في الأمر أكثر، كلما أردت الاعتذار أكثر.
Dialogue: 0,0:49:10.18,0:49:12.73,نص عام,,0,0,0,,سأذهب وأسألها بنفسي
Dialogue: 0,0:49:12.81,0:49:13.73,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:49:13.81,0:49:16.90,نص عام,,0,0,0,,سأفكر في الأمر. تعال معي أولا
Dialogue: 0,0:49:25.74,0:49:27.79,نص عام,,0,0,0,,سأعود حالاً. انتظر هنا
Dialogue: 0,0:49:28.37,0:49:29.83,نص عام,,0,0,0,,إذا لم تعد سأصرخ
Dialogue: 0,0:49:29.91,0:49:31.41,نص عام,,0,0,0,,- سأعود\N-{\i1} تشو يونغ
Dialogue: 0,0:49:32.21,0:49:33.33,نص عام,,0,0,0,,نعم يا أمي
Dialogue: 0,0:49:34.13,0:49:34.96,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:50:06.28,0:50:07.66,نص عام,,0,0,0,,صغير جدًا
Dialogue: 0,0:50:08.99,0:50:10.16,نص عام,,0,0,0,,أتساءل من هو؟
Dialogue: 0,0:50:39.61,0:50:41.23,النص العام,,0,0,0,,هل بسبب البخور؟
Dialogue: 0,0:50:45.24,0:50:46.53,نص عام,,0,0,0,,مزهرية جميلة
Dialogue: 0,0:50:47.57,0:50:51.54,general text,,0,0,0,,إذا وضعت الزهور في هذه المزهرية، ستكون رائحتها أقوى.
Dialogue: 0,0:50:52.79,0:50:54.71,نص عام,,0,0,0,,- حقاً؟\N- نعم
Dialogue: 0,0:50:54.79,0:50:58.00,general text,,0,0,0,,لطالما أردت تغيير المزهرية في غرفة ابنتي
Dialogue: 0,0:50:59.04,0:50:59.96,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:51:03.67,0:51:06.72,general text,,0,0,0,,أمي، هل ستضعين مزهرية في غرفة بو يونغ أوني؟
Dialogue: 0,0:51:06.80,0:51:08.72,نص عام,,0,0,0,,ستصبح رائحة الزهور أقوى
Dialogue: 0,0:51:08.80,0:51:12.47,general text,,0,0,0,,أختك عمياء، لذا على الأقل يمكنها الاستمتاع برائحة الزهور.
Dialogue: 0,0:51:56.77,0:51:58.10,نص عام,,0,0,0,,كيف تجرؤ؟!
Dialogue: 0,0:51:58.19,0:52:00.02,النص العام,,0,0,0,,ماذا تفعل في غرفة ابنتي؟
Dialogue: 0,0:52:04.90,0:52:06.32,نص عام,,0,0,0,,جاءت معي
Dialogue: 0,0:52:06.40,0:52:07.86,نص عام,,0,0,0,,ربما ضاع
Dialogue: 0,0:52:08.45,0:52:10.70,general text,,0,0,0,,مو دوك، ماذا تفعل هنا؟
Dialogue: 0,0:52:12.99,0:52:14.16,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:52:15.95,0:52:18.12,خط مائل,,0,0,0,,المساعدة مرة واحدة
Dialogue: 0,0:52:19.46,0:52:21.04,خط مائل,,0,0,0,,ابتعد
Dialogue: 0,0:52:21.13,0:52:22.96,نص عام,,0,0,0,,ولا تعود بعد الآن
Dialogue: 0,0:52:23.04,0:52:24.75,نص عام,,0,0,0,,نعم
Dialogue: 0,0:52:28.34,0:52:30.18,مائل,,0,0,0,,سآتي. أعدك
Dialogue: 0,0:52:32.64,0:52:33.72,نص عام,,0,0,0,,تشو يونغ,
Dialogue: 0,0:52:34.39,0:52:37.98,نص عام,,0,0,0,,قل للخدم أن ينظفوا غرفة أختك مرة أخرى
Dialogue: 0,0:52:38.73,0:52:40.52,نص عام,,0,0,0,,نعم يا أمي
Dialogue: 0,0:53:08.26,0:53:09.26,نص عام,,0,0,0,,فأنا
Dialogue: 0,0:53:10.26,0:53:12.05,النص العام,,0,0,0,,هذا الرجل سيكون والدك
Dialogue: 0,0:53:13.01,0:53:14.14,نص عام,,0,0,0,,أبي؟
Dialogue: 0,0:53:15.05,0:53:17.47,general text,,0,0,0,,أب يريد أن يدخل ابنة مزيفة إلى المنزل؟
Dialogue: 0,0:53:20.85,0:53:24.48,general text,,0,0,0,,أنا لست والد جين بو يونغ بالدم.
Dialogue: 0,0:53:25.98,0:53:29.03,general text,,0,0,0,,والدها الحقيقي شخص آخر
Dialogue: 0,0:53:41.66,0:53:44.38,النص العام,,0,0,0,,أن يتم الاعتراف بك على أنها ابنة عائلة جين،
Dialogue: 0,0:53:44.46,0:53:46.34,نص عام,,0,0,0,,عليك أن تفتح أبواب جينيوون
Dialogue: 0,0:53:46.42,0:53:49.84,general text,,0,0,0,,ولهذا يجب أن تسري دماءهم في عروقك
Dialogue: 0,0:53:53.72,0:53:55.05,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:53:55.14,0:53:58.47,general text,,0,0,0,,دودة تحتوي على دم أحد أفراد عائلة جين
Dialogue: 0,0:54:20.45,0:54:22.37,النص العام,,0,0,0,,هذا هو دماء تشو يونغ،
Dialogue: 0,0:54:23.37,0:54:24.92,نص عام,,0,0,0,,المفضل لدي
Dialogue: 0,0:54:26.79,0:54:28.96,نص عام,,0,0,0,,وماذا ستفعل حيال ذلك؟
Dialogue: 0,0:54:29.04,0:54:30.46,نص عام,,0,0,0,,مد يدك
Dialogue: 0,0:54:32.63,0:54:34.22,نص عام,,0,0,0,,لا تجعلني أنتظر
Dialogue: 0,0:55:17.68,0:55:20.85,التعليق الصوتي,,0,0,0,,الآن لديك دماء عائلة جين
Dialogue: 0,0:55:21.93,0:55:24.35,التعليق الصوتي,,0,0,0,,إذا لم أستخدم السحر الأسود،
Dialogue: 0,0:55:24.43,0:55:27.31,التعليق الصوتي,,0,0,0,,هذه الدودة ستأكلك من الداخل
Dialogue: 0,0:55:28.65,0:55:30.23,مائل,,0,0,0,,أحاول الهرب,
Dialogue: 0,0:55:31.07,0:55:33.36,خط مائل,,0,0,0,,هذه الدودة ستأكلك حياً
Dialogue: 0,0:55:40.45,0:55:43.12,النص العام,,0,0,0,,هذه غرفة ابنتها التي ماتت قبل 10 سنوات
Dialogue: 0,0:55:44.29,0:55:45.87,النص العام,,0,0,0,,يبدو أنها غرقت،
Dialogue: 0,0:55:46.62,0:55:49.17,نص عام,,0,0,0,,لكن السيدة جين لا تزال تعتقد أنها ستعود
Dialogue: 0,0:55:50.75,0:55:51.96,نص عام,,0,0,0,,أشعر بالأسف عليها
Dialogue: 0,0:55:52.92,0:55:54.59,النص العام,,0,0,0,,سامحها على الصفعة
Dialogue: 0,0:55:57.72,0:56:00.76,general text,,0,0,0,,وكانت ابنتها عمياء؟
Dialogue: 0,0:56:01.68,0:56:03.97,نص عام,,0,0,0,,نعم كان كذلك
Dialogue: 0,0:56:05.27,0:56:07.48,خارج الشاشة,,0,0,0,,صاحب هذا الجسد كان أعمى أيضًا
Dialogue: 0,0:56:08.27,0:56:10.60,خارج الشاشة,,0,0,0,,ربما لهذا السبب شعرت بشيء غريب؟
Dialogue: 0,0:56:28.08,0:56:31.21,نص عام,,0,0,0,,أراد السيد "لي" التحدث عن شيء ما مع الأمير بمفرده
Dialogue: 0,0:56:31.83,0:56:32.84,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:56:38.01,0:56:40.97,نص عام,,0,0,0,,طلب الرئيس مرافقتك إلى سوسنوفي بور
Dialogue: 0,0:56:41.55,0:56:43.55,نص عام,,0,0,0,,أنا؟ لماذا؟
Dialogue: 0,0:56:43.64,0:56:44.64,خط مائل,,0,0,0,,تعال معنا
Dialogue: 0,0:56:55.15,0:56:56.73,general text,,0,0,0,,سوف يحبسوني هنا مرة أخرى، أليس كذلك؟
Dialogue: 0,0:56:57.23,0:56:59.07,نص عام,,0,0,0,,- ماذا يحدث؟\N- هذا...
Dialogue: 0,0:56:59.78,0:57:01.11,نص عام,,0,0,0,,أمرنا بالصمت
Dialogue: 0,0:57:01.91,0:57:03.12,مائل,,0,0,0,,انتظروه هنا
Dialogue: 0,0:57:12.83,0:57:16.09,general text,,0,0,0,,شوهدت مو دوك بجوار الجثث، ومن الواضح سبب نقلها بعيدًا.
Dialogue: 0,0:57:16.17,0:57:18.67,نص عام,,0,0,0,,ولكن لماذا يا سيدي؟ كان في القصر
Dialogue: 0,0:57:20.05,0:57:22.59,نص عام,,0,0,0,,ماذا يفكر الرأس؟
Dialogue: 0,0:57:22.68,0:57:23.68,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,0:57:26.31,0:57:27.35,نص عام,,0,0,0,,يول,
Dialogue: 0,0:57:27.43,0:57:29.56,general text,,0,0,0,,مو دوك لن يقتل أحداً
Dialogue: 0,0:57:30.18,0:57:31.27,خط مائل,,0,0,0,,حقاً؟
Dialogue: 0,0:57:34.36,0:57:36.52,نص عام,,0,0,0,,هل أستطيع النظر إلى الجثث؟
Dialogue: 0,0:57:49.41,0:57:51.29,general text,,0,0,0,,القاتل استخدم السيف بمهارة
Dialogue: 0,0:57:51.91,0:57:53.54,النص العام,,0,0,0,,لا يمكن أن يكون هذا مو دوك
Dialogue: 0,0:57:55.17,0:57:56.75,خارج الشاشة,,0,0,0,,لكنها ناك سو
Dialogue: 0,0:57:57.71,0:57:59.46,خارج الشاشة,,0,0,0,,كان من الممكن أن تقتلهم
Dialogue: 0,0:58:04.64,0:58:07.55,ذكريات بخط مائل,,0,0,0,,لدي أسبابي،
Dialogue: 0,0:58:07.64,0:58:09.06,ذكريات بخط مائل,,0,0,0,,لا تزعجني
Dialogue: 0,0:58:12.64,0:58:15.48,general text,,0,0,0,,- هؤلاء هم قطاع الطرق هؤلاء\N- هل تعرفهم؟
Dialogue: 0,0:58:17.77,0:58:20.03,نص عام,,0,0,0,,لقد حاربتهم منذ وقت ليس ببعيد
Dialogue: 0,0:58:25.28,0:58:27.83,general text,,0,0,0,,هل أستطيع أن آخذ جثثهم وأقيم جنازتهم؟
Dialogue: 0,0:58:34.37,0:58:36.50,general text,,0,0,0,,ما الذي أتى بالرئيس تشويسونرا إلى هنا؟
Dialogue: 0,0:58:36.58,0:58:38.09,نص عام,,0,0,0,,هل مات أحد؟
Dialogue: 0,0:58:38.17,0:58:40.63,النص العام,,0,0,0,,قُتل حراسنا
Dialogue: 0,0:58:53.93,0:58:55.31,نص عام,,0,0,0,,دان جو
Dialogue: 0,0:58:55.39,0:58:57.31,نص عام,,0,0,0,,أخبرت الخادمة كيم عما حدث
Dialogue: 0,0:58:59.23,0:59:00.61,نص عام,,0,0,0,,تشو يونغ,
Dialogue: 0,0:59:01.61,0:59:03.24,نص عام,,0,0,0,,مساعدة مو دوك
Dialogue: 0,0:59:11.12,0:59:13.87,نص عام,,0,0,0,,ذهبت إلى هناك لشراء التذاكر
Dialogue: 0,0:59:15.71,0:59:17.58,نص عام,,0,0,0,,كان مو دوك هناك
Dialogue: 0,0:59:19.67,0:59:20.71,نص عام,,0,0,0,,بالطبع,
Dialogue: 0,0:59:20.79,0:59:24.59,نص عام,,0,0,0,,كانت المرة الأولى لي في مثل هذا المكان
Dialogue: 0,0:59:25.17,0:59:26.26,نص عام,,0,0,0,,أعلم
Dialogue: 0,0:59:27.09,0:59:30.85,general text,,0,0,0,,تحدثنا قليلاً، ثم دخل مو دوك
Dialogue: 0,0:59:30.93,0:59:32.89,النص العام,,0,0,0,,لقد رأيتك أيضاً عندما دخلت
Dialogue: 0,0:59:33.81,0:59:38.27,النص العام,,0,0,0,,بالطبع لم أكن أعتقد أنني سأراك في مثل هذا المكان
Dialogue: 0,0:59:39.94,0:59:41.11,نص عام,,0,0,0,,أعلم
Dialogue: 0,0:59:44.57,0:59:45.99,نص عام,,0,0,0,,هذا ما يحدث...
Dialogue: 0,0:59:47.03,0:59:51.12,general text,,0,0,0,,لم يكن لدى مو دوك الوقت الكافي لقتل هؤلاء الرجال.
Dialogue: 0,0:59:52.16,0:59:55.37,general text,,0,0,0,,جاءت فتاة مؤخرًا إلى Chwisung-ru بحثًا عن Moo Deok.
Dialogue: 0,0:59:55.45,0:59:56.91,النص العام,,0,0,0,,تظاهرت بأنها ساحرة
Dialogue: 0,0:59:57.00,0:59:58.50,النص العام,,0,0,0,,يعتقد تشويسونجرو،
Dialogue: 0,0:59:58.58,1:00:02.54,general text,,0,0,0,,قد تكون هذه "سو يي"، الفتاة التي حذر التاجر "مو ديوك" منها
Dialogue: 0,1:00:02.63,1:00:05.01,نص عام,,0,0,0,,رأيت ذات مرة فتاة يتم جرها من قبل هؤلاء قطاع الطرق
Dialogue: 0,1:00:06.34,1:00:07.59,نص عام,,0,0,0,,التاجر,
Dialogue: 0,1:00:07.67,1:00:08.97,نص عام,,0,0,0,,قطاع الطرق والحراس
Dialogue: 0,1:00:09.84,1:00:12.10,نص عام,,0,0,0,,كلهم تقاطعوا مع هذا لذا أنا
Dialogue: 0,1:00:12.18,1:00:14.01,نص عام,,0,0,0,,هذا المحتال "سو يي" مريب للغاية
Dialogue: 0,1:00:14.89,1:00:17.14,نص عام,,0,0,0,,هذا يعني أن مو دوك ليس هو الملام
Dialogue: 0,1:00:18.69,1:00:19.73,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:00:20.73,1:00:25.32,النص العام,,0,0,0,,أنا شخصياً شككت في أن مو دوك يمكنه قتل شخص ما
Dialogue: 0,1:00:25.40,1:00:29.53,نص عام,,0,0,0,,هذا كل شيء. أنت تعلم يا عمي أن مو دوك لم يكن قادرًا على ذلك، أليس كذلك؟
Dialogue: 0,1:00:29.61,1:00:33.16,نص عام,,0,0,0,,هل يمكنك السماح لـ Wook و Moo Deok بالذهاب الآن؟
Dialogue: 0,1:00:33.24,1:00:35.49,نص عام,,0,0,0,,لقد أغلقتهم حتى
Dialogue: 0,1:00:36.37,1:00:38.33,نص عام,,0,0,0,,اسأل شيئًا
Dialogue: 0,1:00:39.37,1:00:40.87,خط مائل,,0,0,0,,سأتولى الباقي بنفسي
Dialogue: 0,1:00:40.96,1:00:42.08,نص عام,,0,0,0,,يمكنك الذهاب
Dialogue: 0,1:00:42.17,1:00:43.34,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:01:02.27,1:01:03.52,نص عام,,0,0,0,,الفصل
Dialogue: 0,1:01:04.27,1:01:06.90,نص عام,,0,0,0,,على الأقل أخبرني ما هو الخطأ
Dialogue: 0,1:01:07.69,1:01:10.15,general text,,0,0,0,,ارتكب مو دوك جريمة قتل
Dialogue: 0,1:01:13.28,1:01:14.28,نص عام,,0,0,0,,ماذا...
Dialogue: 0,1:01:14.37,1:01:17.45,general text,,0,0,0,,قتلت من عرفها في الماضي
Dialogue: 0,1:01:20.62,1:01:24.67,نص عام,,0,0,0,,أخبرني ما الذي تخفيه أنت ومو ديوك
Dialogue: 0,1:01:25.84,1:01:28.30,general text,,0,0,0,,إذا كانت كلماتك لا تتطابق مع كلمات مو دوك،
Dialogue: 0,1:01:28.88,1:01:31.22,نص عام,,0,0,0,,لن تغادر هذه الغرفة
Dialogue: 0,1:01:32.05,1:01:33.80,النص العام,,0,0,0,,وسيموت مو دوك
Dialogue: 0,1:01:55.12,1:01:56.66,نص عام,,0,0,0,,الفصل اسمع...
Dialogue: 0,1:01:56.74,1:01:58.08,نص عام,,0,0,0,,الأمر لا يتعلق بالقتل
Dialogue: 0,1:02:00.04,1:02:02.00,general text,,0,0,0,,المملكة المتحدة كشفت لي سرك
Dialogue: 0,1:02:03.29,1:02:04.54,نص عام,,0,0,0,,لقد قال كل شيء
Dialogue: 0,1:02:08.13,1:02:12.05,general text,,0,0,0,,إذا قلت الحقيقة أيضًا فسوف أنقذ حياتك
Dialogue: 0,1:02:13.18,1:02:14.34,نص عام,,0,0,0,,ولكن إذا،
Dialogue: 0,1:02:14.43,1:02:17.51,نص عام,,0,0,0,,ستختلف كلماتك،
Dialogue: 0,1:02:19.43,1:02:20.89,النص العام,,0,0,0,,سوف تموت
Dialogue: 0,1:02:29.82,1:02:31.69,التعليق الصوتي,,0,0,0,,لو عرف أنها بدوية،
Dialogue: 0,1:02:31.78,1:02:33.74,خلف الكواليس,,0,0,0,,لن نضيع الوقت بهذه الطريقة
Dialogue: 0,1:02:33.82,1:02:36.41,خارج الإطار,,0,0,0,,إنه يحاول تفريقنا عن طريق استجوابنا بشكل منفصل
Dialogue: 0,1:02:37.24,1:02:39.58,خلف الكواليس,,0,0,0,,يجب أن نقول نفس الشيء
Dialogue: 0,1:02:41.37,1:02:44.62,التعليق الصوتي,,0,0,0,,ماذا سيجيب تشان ووك؟
Dialogue: 0,1:02:44.71,1:02:48.54,خلف الكواليس,,0,0,0,,سر من المؤكد أن يكشفه كلانا
Dialogue: 0,1:02:48.63,1:02:53.22,خلف الكواليس,,0,0,0,,سر لن يؤدي كشفه إلى موتي
Dialogue: 0,1:02:56.30,1:02:57.76,نص عام,,0,0,0,,سأخبرك
Dialogue: 0,1:02:57.84,1:02:59.22,نص عام,,0,0,0,,أعترف لك
Dialogue: 0,1:03:06.90,1:03:08.36,نص عام,,0,0,0,,ماذا حدث؟
Dialogue: 0,1:03:09.36,1:03:11.32,نص عام,,0,0,0,,مو ديوك وتشان ووك
Dialogue: 0,1:03:12.19,1:03:13.32,نص عام,,0,0,0,,يمكنك ترك الأمر
Dialogue: 0,1:03:13.82,1:03:16.86,نص عام,,0,0,0,,ماذا قالوا؟ واحد ونفس الشيء؟
Dialogue: 0,1:03:20.08,1:03:23.08,نص عام,,0,0,0,,قالوا... نفس الشيء
Dialogue: 0,1:03:52.57,1:03:55.44,نص عام,,0,0,0,,- لقد تركت\N- وأنت أيضاً
Dialogue: 0,1:03:56.03,1:03:58.91,نص عام,,0,0,0,,- سعيد لأنك بخير\N- وأنا أيضًا
Dialogue: 0,1:03:58.99,1:04:00.82,نص عام,,0,0,0,,والحمد لله أننا قلنا نفس الشيء
Dialogue: 0,1:04:02.37,1:04:03.87,نص عام,,0,0,0,,ماذا قلت؟
Dialogue: 0,1:04:03.95,1:04:05.66,نص عام,,0,0,0,,كلانا غادر...
Dialogue: 0,1:04:07.04,1:04:09.04,نص عام,,0,0,0,,فلقد قلت نفس الشيء
Dialogue: 0,1:04:14.00,1:04:17.47,general text,,0,0,0,,لقد حبستهم لتعرف ما كانوا يخفونه
Dialogue: 0,1:04:17.55,1:04:19.47,نص عام,,0,0,0,,أعتقد أنك اكتشفت شيئًا ما
Dialogue: 0,1:04:19.55,1:04:20.39,نص عام,,0,0,0,,أخبر
Dialogue: 0,1:04:20.47,1:04:22.85,نص عام,,0,0,0,,ما سرهم؟
Dialogue: 0,1:04:23.76,1:04:25.18,نص عام,,0,0,0,,إنهم...
Dialogue: 0,1:04:26.27,1:04:29.73,نص عام,,0,0,0,,لقد تركتني عاجزًا عن الكلام حرفيًا
Dialogue: 0,1:04:32.56,1:04:35.19,نص عام,,0,0,0,,لقد أظهروا نفس الشيء
Dialogue: 0,1:04:37.11,1:04:38.49,ذكريات بخط مائل,,0,0,0,,سأقول الحقيقة
Dialogue: 0,1:04:39.40,1:04:41.03,ذكريات,,0,0,0,,حاولت ألا يتم القبض علي
Dialogue: 0,1:04:42.28,1:04:44.08,ذكريات,,0,0,0,,هذا ما كنت أخفيه
Dialogue: 0,1:05:01.72,1:05:03.22,ذكريات,,0,0,0,,كما ترى، أنا...
Dialogue: 0,1:05:03.72,1:05:06.10,ذكريات,,0,0,0,,في الحقيقة أنا...
Dialogue: 0,1:05:13.06,1:05:14.69,ذكريات,,0,0,0,,حب مو ديوك
Dialogue: 0,1:05:18.53,1:05:20.36,ذكريات,,0,0,0,,أنا أحب المالك كثيرًا
Dialogue: 0,1:05:26.74,1:05:29.20,نص عام,,0,0,0,,أعتقد أنك ربما تعترف بذلك
Dialogue: 0,1:05:31.04,1:05:33.42,نص عام,,0,0,0,,لن يقتلوني من أجل هذا
Dialogue: 0,1:05:33.50,1:05:37.25,general text,,0,0,0,,نعم، ولا يوجد شيء عن هذا في كتاب قواعد سوسنوفي بور
Dialogue: 0,1:05:37.34,1:05:39.71,general text,,0,0,0,,ليس هناك حظر على الولد أن يحب الفتاة
Dialogue: 0,1:05:42.88,1:05:43.72,نص عام,,0,0,0,,نعم
Dialogue: 0,1:05:43.80,1:05:47.85,general text,,0,0,0,,وحب الخادمة لسيدها لا يؤدي إلى الموت
Dialogue: 0,1:05:49.93,1:05:53.23,نص عام,,0,0,0,,هل هذا ما قلته؟ لماذا تحبني حتى الموت؟
Dialogue: 0,1:05:54.98,1:05:56.11,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,1:05:56.82,1:06:00.03,نص عام,,0,0,0,,بالغت حتى يصدق
Dialogue: 0,1:06:03.28,1:06:04.82,نص عام,,0,0,0,,لم يكن هناك خيار آخر
Dialogue: 0,1:06:06.20,1:06:09.70,general text,,0,0,0,,لم يكن هناك خيار سوى الاعتراف بأنك تحبني حتى الموت
Dialogue: 0,1:06:10.91,1:06:12.62,نص عام,,0,0,0,,أنا آسف إلى حد ما حتى
Dialogue: 0,1:06:13.33,1:06:15.71,نص عام,,0,0,0,,لم أضع الكثير من المشاعر في اعترافي
Dialogue: 0,1:06:16.25,1:06:17.54,نص عام,,0,0,0,,كان علينا أن نحاول
Dialogue: 0,1:06:17.63,1:06:18.80,نص عام,,0,0,0,,انسى
Dialogue: 0,1:06:20.59,1:06:24.59,general text,,0,0,0,,لا تضع كل شيء على المحك من أجل شيء متقلب مثل الحب
Dialogue: 0,1:06:25.93,1:06:27.85,نص عام,,0,0,0,,إذا حدث هذا مرة أخرى،
Dialogue: 0,1:06:28.60,1:06:30.89,نص عام,,0,0,0,,وستكون الحياة مرهونة بالاختيار,
Dialogue: 0,1:06:31.98,1:06:33.23,نص عام,,0,0,0,,خيانة الحب
Dialogue: 0,1:06:34.52,1:06:35.73,نص عام,,0,0,0,,واختر الحياة
Dialogue: 0,1:06:38.11,1:06:39.73,مائل,,0,0,0,,إلا إذا كنت تريد الموت بالطبع
Dialogue: 0,1:06:40.65,1:06:42.19,نص عام,,0,0,0,,هذا أمر المعلم
Dialogue: 0,1:06:47.24,1:06:48.37,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,1:06:49.08,1:06:50.62,نص عام,,0,0,0,,ماذا لو لم يكن لدي مانع من الموت؟
Dialogue: 0,1:06:51.41,1:06:53.83,النص العام,,0,0,0,,هل يمكنني الاستمرار في حبك إذن؟
Dialogue: 0,1:06:56.29,1:06:58.42,general text,,0,0,0,,بمعنى آخر، أنا مستعد للمخاطرة بكل شيء،
Dialogue: 0,1:06:59.38,1:07:01.17,نص عام,,0,0,0,,حتى نكون معًا
Dialogue: 0,1:07:02.55,1:07:04.17,نص عام,,0,0,0,,سأفعل ذلك
Dialogue: 0,1:07:04.72,1:07:09.18,نص عام,,0,0,0,,افعل نفس الشيء، وتمسك باعترافك
Dialogue: 0,1:07:10.72,1:07:12.31,نص عام,,0,0,0,,أحبني حتى الموت
Dialogue: 0,1:07:51.81,1:07:55.73,preview,,0,0,0,,إذا كانت المملكة المتحدة تحب شخصًا فلا ينبغي عليه ذلك،
Dialogue: 0,1:07:55.81,1:07:57.23,معاينة,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,1:07:57.31,1:08:01.27,preview,,0,0,0,,إذا كنت معك، يجب أن أتأكد من أنك ملكي
Dialogue: 0,1:08:01.36,1:08:03.23,preview,,0,0,0,,كيف تجرؤ على فضح جينيوون؟
Dialogue: 0,1:08:03.98,1:08:05.03,معاينة,,0,0,0,,- مالح\N- حذاءان - زوج
Dialogue: 0,1:08:05.11,1:08:06.40,preview,,0,0,0,,لماذا لم تتزوج؟
Dialogue: 0,1:08:06.49,1:08:08.24,معاينة,,0,0,0,,أنا أبحث عن شامان تشوي
Dialogue: 0,1:08:08.32,1:08:11.16,preview,,0,0,0,,إذا تم اصطياد الشامان من قبل سحرة جيونبوغوان...
Dialogue: 0,1:08:11.24,1:08:14.08,preview,,0,0,0,,هل تبحث عنها لأنها تحمل ضغينة ضد والدك؟
Dialogue: 0,1:08:14.16,1:08:16.87,معاينة,,0,0,0,,إذا جاء أبلغ فوراً
Dialogue: 0,1:08:16.96,1:08:18.54,معاينة,,0,0,0,,حتى ميت، هذا غويغو
Dialogue: 0,1:08:18.62,1:08:20.50,preview,,0,0,0,,تظاهر أنك لا تعرف، أليس كذلك؟
Dialogue: 0,1:08:21.17,1:08:23.75,preview,,0,0,0,,كان الأمر صعبًا عليك، أليس كذلك؟
Dialogue: 0,1:08:23.84,1:08:26.17,preview,,0,0,0,,إذا كان عليك سحب سيف وتوجيهه نحو شخص ما،
Dialogue: 0,1:08:26.26,1:08:28.55,معاينة,,0,0,0,,دعني أكون الأول
الحوار: 0,0:02:55.14,0:02:57.14,النكات,,0,0,0,,

