Dialogue: 0,0:02:47.09,0:02:52.09,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.09,0:02:57.09,الألقاب,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.09,0:03:02.09,الألقاب,,0,0,0,,مترجمو الطباعة:{\c&HFFF4C5&} Ria_Lee, Mina_Mi
Dialogue: 0,0:00:44.06,0:00:45.27,نص عام,,0,0,0,,شكرًا لعرض كل شيء
Dialogue: 0,0:00:45.36,0:00:47.57,نص عام,,0,0,0,,- في انتظار قرارك\N- نعم
Dialogue: 0,0:00:51.32,0:00:55.66,النص العام,,0,0,0,,هذا المكان يقع بين جينيفون وسوسنوفي بور مباشرةً.
Dialogue: 0,0:00:56.37,0:00:58.62,نص عام,,0,0,0,,البلاط والأرضيات جيدة
Dialogue: 0,0:00:58.70,0:01:01.29,النص العام,,0,0,0,,هذا هو أفضل خيار رأيناه
Dialogue: 0,0:01:01.37,0:01:04.25,نص عام,,0,0,0,,ألا تعتقد أن هناك الكثير من الغرف؟
Dialogue: 0,0:01:04.34,0:01:06.09,نص عام,,0,0,0,,سيرزقون بأطفال قريباً
Dialogue: 0,0:01:06.17,0:01:09.22,general text,,0,0,0,,سيأخذ الابن لقب باك ويقود سوسنوفي بور
Dialogue: 0,0:01:09.30,0:01:12.89,general text,,0,0,0,,ستأخذ الابنة لقب جين وتقود جينيوون
Dialogue: 0,0:01:12.97,0:01:14.35,نص عام,,0,0,0,,عليهم أن ينجبوا المزيد
Dialogue: 0,0:01:15.10,0:01:18.93,نص عام,,0,0,0,,من الجيد أنني طلبت منك الانضمام إلي
Dialogue: 0,0:01:19.02,0:01:22.81,نص عام,,0,0,0,,سأختار المنزل الذي يعجبك
Dialogue: 0,0:01:27.69,0:01:28.73,نص عام,,0,0,0,,بصراحة،
Dialogue: 0,0:01:29.57,0:01:33.57,نص عام,,0,0,0,,لا أريد أن أعيش في منزل كبير
Dialogue: 0,0:01:34.62,0:01:37.08,نص عام,,0,0,0,,أحب المنزل المريح،
Dialogue: 0,0:01:37.58,0:01:41.41,نص عام,,0,0,0,,حيث سنعيش أنا وزوجي بسعادة
Dialogue: 0,0:01:43.12,0:01:46.75,النص العام,,0,0,0,,مع حديقة صغيرة حيث يمكنك زراعة زهورك المفضلة
Dialogue: 0,0:01:47.80,0:01:50.84,نص عام,,0,0,0,,أنت تحب الزهور كثيراً
Dialogue: 0,0:01:53.22,0:01:54.72,نص عام,,0,0,0,,ربما ينبغي لنا أن نزرع البلسم؟
Dialogue: 0,0:01:55.43,0:01:58.97,general text,,0,0,0,,كنت أنا وزوجي نرسم أظافرنا بدهانات منه*
Dialogue: 0,0:01:55.43,0:01:58.97,ملاحظات,,0,0,0,,*تم سحق جذر البلسم واستخدامه في طلاء الأظافر وأطراف الأصابع باللون الأصفر.
Dialogue: 0,0:02:01.18,0:02:04.69,نص عام,,0,0,0,,سيكون من الرائع أن نعيش هكذا
Dialogue: 0,0:02:06.69,0:02:09.44,نص عام,,0,0,0,,سأبحث عنك
Dialogue: 0,0:02:10.94,0:02:12.28,نص عام,,0,0,0,,هكذا منزل
Dialogue: 0,0:02:18.28,0:02:19.45,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:02:19.54,0:02:23.00,نص عام,,0,0,0,,سأشتري منزلاً بحديقة صغيرة
Dialogue: 0,0:02:23.96,0:02:25.75,نص عام,,0,0,0,,وسأزرع البلسم
Dialogue: 0,0:02:26.58,0:02:29.17,نص عام,,0,0,0,,هذه ستكون هديتي
Dialogue: 0,0:02:30.59,0:02:31.67,نص عام,,0,0,0,,لزفافك
Dialogue: 0,0:02:35.76,0:02:37.43,نص عام,,0,0,0,,هدية؟
Dialogue: 0,0:02:37.51,0:02:41.31,نص عام,,0,0,0,,السيد "لي" أحب "سابساري" كثيراً
Dialogue: 0,0:02:42.02,0:02:45.56,نص عام,,0,0,0,,سأعطيك جروًا أيضًا
Dialogue: 0,0:02:46.15,0:02:51.03,general text,,0,0,0,,هل ستتزوجني بالسيد "لي" الآن؟
Dialogue: 0,0:02:51.11,0:02:56.24,نص عام,,0,0,0,,قلت أنك سعيد بمجرد النظر إليه
Dialogue: 0,0:02:57.74,0:03:02.20,general text,,0,0,0,,هل تعتقد أنني كنت سعيدًا بالنظر إلى السيد لي؟
Dialogue: 0,0:03:03.12,0:03:07.04,نص عام,,0,0,0,,أنا لست غبيًا تمامًا
Dialogue: 0,0:03:07.12,0:03:09.38,النص العام,,0,0,0,,أي أنك ستعطيني منزلاً بسخاء،
Dialogue: 0,0:03:09.46,0:03:12.84,نص عام,,0,0,0,,إذا تزوجت السيد لي؟
Dialogue: 0,0:03:13.46,0:03:17.89,نص عام,,0,0,0,,لدي مال لمثل هذه الهدية
Dialogue: 0,0:03:18.93,0:03:20.01,نص عام,,0,0,0,,كما تعلمون،
Dialogue: 0,0:03:20.60,0:03:23.89,نص عام,,0,0,0,,اشتري لي منزلاً به مائة غرفة
Dialogue: 0,0:03:24.48,0:03:25.64,نص عام,,0,0,0,,مائة؟
Dialogue: 0,0:03:27.60,0:03:30.11,نص عام,,0,0,0,,هل تحب المنازل الكبيرة؟
Dialogue: 0,0:03:32.40,0:03:34.65,نص عام,,0,0,0,,ما زلت بطيئًا بعض الشيء
Dialogue: 0,0:03:35.61,0:03:36.95,نص عام,,0,0,0,,هل أنت أحمق؟
Dialogue: 0,0:03:38.03,0:03:39.95,النص العام,,0,0,0,,مشاعرك أسعدتني
Dialogue: 0,0:03:51.63,0:03:52.88,نص عام,,0,0,0,,كنت أتمنى
Dialogue: 0,0:03:53.92,0:03:56.09,نص عام,,0,0,0,,سوف تفهم عاجلاً أم آجلاً
Dialogue: 0,0:03:56.17,0:04:00.55,نص عام,,0,0,0,,طبخت أطباقك المفضلة وخيطت ملابسك
Dialogue: 0,0:04:00.64,0:04:05.14,نص عام,,0,0,0,,رغم أنك بطيء إلا أنني تمنيت ذلك يوماً ما
Dialogue: 0,0:04:06.43,0:04:07.60,نص عام,,0,0,0,,سوف يصل إليك
Dialogue: 0,0:04:08.56,0:04:11.94,general text,,0,0,0,,هل تعتبرني شخصًا آخر؟
Dialogue: 0,0:04:12.73,0:04:14.73,النص العام,,0,0,0,,أعطني منزلاً لحفل زفافي مع شخص آخر؟
Dialogue: 0,0:04:15.90,0:04:17.24,نص عام,,0,0,0,,العذراء كيم...
Dialogue: 0,0:04:18.45,0:04:21.57,نص عام,,0,0,0,,لم أفهم...
Dialogue: 0,0:04:21.66,0:04:22.66,نص عام,,0,0,0,,اصمت!
Dialogue: 0,0:04:24.28,0:04:27.37,نص عام,,0,0,0,,نختار منزلًا معًا،
Dialogue: 0,0:04:28.58,0:04:31.25,نص عام,,0,0,0,,تخيلت كيف سنتزوج،
Dialogue: 0,0:04:32.71,0:04:35.17,نص عام,,0,0,0,,كيف سنرسم أظافر بعضنا البعض في الحب
Dialogue: 0,0:04:35.25,0:04:37.63,نص عام,,0,0,0,,زهور البلسم,
Dialogue: 0,0:04:37.72,0:04:40.09,نص عام,,0,0,0,,من قطف في الحديقة
Dialogue: 0,0:04:42.55,0:04:44.60,نص عام,,0,0,0,,هل تحب؟
Dialogue: 0,0:04:44.68,0:04:47.60,نص عام,,0,0,0,,نعم! يعشق!
Dialogue: 0,0:04:47.68,0:04:48.64,نص عام,,0,0,0,,الحب الجزرة!
Dialogue: 0,0:04:50.98,0:04:52.73,نص عام,,0,0,0,,في الحب!
Dialogue: 0,0:04:52.81,0:04:55.27,نص عام,,0,0,0,,نعم! بالضبط! يعشق!
Dialogue: 0,0:04:56.48,0:05:00.45,نص عام,,0,0,0,,هذه الصورة تقف أمام عيني بوضوح شديد
Dialogue: 0,0:05:00.53,0:05:01.61,نص عام,,0,0,0,,انسى
Dialogue: 0,0:05:01.70,0:05:03.20,نص عام,,0,0,0,,لقد حطمت أحلامي
Dialogue: 0,0:05:03.28,0:05:05.99,نص عام,,0,0,0,,لن أتوقع منك المزيد
Dialogue: 0,0:05:06.91,0:05:10.08,نص عام,,0,0,0,,لكنني سأقبل منزلاً به مائة غرفة!
Dialogue: 0,0:05:11.71,0:05:12.75,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:05:12.83,0:05:15.75,نص عام,,0,0,0,,العذراء كيم!
Dialogue: 0,0:05:18.51,0:05:19.80,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:05:22.22,0:05:23.59,نص عام,,0,0,0,,في الحب...
Dialogue: 0,0:05:24.51,0:05:28.02,نص عام,,0,0,0,,لقد دمرت كل شيء
Dialogue: 0,0:05:30.39,0:05:31.56,نص عام,,0,0,0,,أحمق
Dialogue: 0,0:05:35.15,0:05:36.44,نص عام,,0,0,0,,ممتاز
Dialogue: 0,0:05:36.52,0:05:39.49,نص عام,,0,0,0,,سأتزوج شخصاً ما
Dialogue: 0,0:05:39.57,0:05:41.74,نص عام,,0,0,0,,دعه يمنحني منزلاً!
Dialogue: 0,0:05:43.28,0:05:44.91,نص عام,,0,0,0,,ها أنت ذا
Dialogue: 0,0:05:45.99,0:05:48.37,النص العام,,0,0,0,,الخادمة كيم، هل تبكي؟
Dialogue: 0,0:05:48.45,0:05:51.37,نص عام,,0,0,0,,لا. لماذا يجب أن أبكي؟
Dialogue: 0,0:05:53.42,0:05:55.42,نص عام,,0,0,0,,هل تبكي؟ من ينزعج؟
Dialogue: 0,0:05:55.50,0:05:58.13,النص العام,,0,0,0,,دموعك تحطم قلبي
Dialogue: 0,0:05:59.17,0:06:00.76,نص عام,,0,0,0,,أنا فقط غيور،
Dialogue: 0,0:06:00.84,0:06:04.93,نص عام,,0,0,0,,أن السيد دان جو سيتزوج قبلك
Dialogue: 0,0:06:05.51,0:06:07.76,نص عام,,0,0,0,,أنا غيور وحزين
Dialogue: 0,0:06:07.85,0:06:10.89,نص عام,,0,0,0,,لا تحزن. سأتزوج قريبا
Dialogue: 0,0:06:11.48,0:06:12.31,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:06:13.10,0:06:16.65,general text,,0,0,0,,هل قررت أخيرًا الزواج من شخص ما؟
Dialogue: 0,0:06:16.73,0:06:20.69,النص العام,,0,0,0,,نعم فلا داعي للحسد والحزن
Dialogue: 0,0:06:20.78,0:06:21.90,نص عام,,0,0,0,,ثم...
Dialogue: 0,0:06:21.99,0:06:24.36,نص عام,,0,0,0,,ثم يجب ترك هذا
Dialogue: 0,0:06:25.57,0:06:26.99,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:06:27.07,0:06:30.20,نص عام,,0,0,0,,هدايا زفافك التي احتفظت بها
Dialogue: 0,0:06:30.29,0:06:33.21,النص العام,,0,0,0,,كنت أفكر في إعطائهم للسيد دان جو والسيدة تشو يون
Dialogue: 0,0:06:33.29,0:06:35.50,النص العام,,0,0,0,,لماذا أعطيها لهم؟ مضيعة
Dialogue: 0,0:06:35.58,0:06:36.58,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:06:36.67,0:06:39.09,نص عام,,0,0,0,,أعطهم للسيدة هو؟
Dialogue: 0,0:06:40.50,0:06:42.26,نص عام,,0,0,0,,لماذا تحتاجها؟
Dialogue: 0,0:06:42.84,0:06:44.22,نص عام,,0,0,0,,قلت أنك ستتزوج
Dialogue: 0,0:06:44.30,0:06:45.88,نص عام,,0,0,0,,أعرف كل شيء
Dialogue: 0,0:06:45.97,0:06:47.97,نص عام,,0,0,0,,إنها بيضتك
Dialogue: 0,0:06:50.22,0:06:52.60,general text,,0,0,0,,- بيضتي؟\N- حبيبك السري
Dialogue: 0,0:06:53.39,0:06:57.69,نص عام,,0,0,0,,بيضة مالك الحزين الرشيقة على قمة الشجرة
Dialogue: 0,0:07:00.23,0:07:03.28,النص العام,,0,0,0,,الخادم كيم، لقد أسيء فهمك. هذا ليس نفس الطائر
Dialogue: 0,0:07:04.28,0:07:05.90,النص العام,,0,0,0,,- أليست هي؟\N- لا
Dialogue: 0,0:07:05.99,0:07:10.03,نص عام,,0,0,0,,ظننت أنها ستفقس من البيضة
Dialogue: 0,0:07:10.83,0:07:13.25,النص العام,,0,0,0,,هل هناك شخص آخر إذن؟
Dialogue: 0,0:07:14.50,0:07:16.54,نص عام,,0,0,0,,نعم. نعم
Dialogue: 0,0:07:17.79,0:07:19.04,نص عام,,0,0,0,,ومن هذا؟
Dialogue: 0,0:07:20.50,0:07:23.38,نص عام,,0,0,0,,الخادم كيم، فقط لا تتفاجأ
Dialogue: 0,0:07:23.46,0:07:24.88,النص العام,,0,0,0,,وإذا لم تتمكن من ضبط نفسك،
Dialogue: 0,0:07:24.97,0:07:26.55,نص عام,,0,0,0,,عض منديلك
Dialogue: 0,0:07:28.22,0:07:30.68,نص عام,,0,0,0,,من يكون؟
Dialogue: 0,0:07:31.26,0:07:33.06,نص عام,,0,0,0,,لم تكن هناك فتيات أخريات بالقرب منك
Dialogue: 0,0:07:41.98,0:07:43.28,نص عام,,0,0,0,,حقاً...
Dialogue: 0,0:07:44.61,0:07:47.03,نص عام,,0,0,0,,نعم. سوف يحصل Moo Deok على كل شيء
Dialogue: 0,0:07:53.74,0:07:54.91,نص عام,,0,0,0,,لا يمكن أن يكون
Dialogue: 0,0:07:55.00,0:07:58.58,نص عام,,0,0,0,,كيف ذلك؟ ماذا عن السيدة هو؟
Dialogue: 0,0:08:01.59,0:08:04.96,النص العام,,0,0,0,,أرى أن الأمور تسير على ما يرام بينك وبين السيد تشان ووك
Dialogue: 0,0:08:05.05,0:08:05.96,نص عام,,0,0,0,,نعم
Dialogue: 0,0:08:06.05,0:08:08.34,نص عام,,0,0,0,,قررت الزواج منه
Dialogue: 0,0:08:08.43,0:08:10.76,نص عام,,0,0,0,,أحب نشر كل أنواع الشائعات
Dialogue: 0,0:08:10.84,0:08:13.93,نص عام,,0,0,0,,من فضلك. وليعلم الجميع أنني غيرت مصيري
Dialogue: 0,0:08:15.27,0:08:18.89,general text,,0,0,0,,خبر زواجك سيزيل كل الشائعات الفاحشة
Dialogue: 0,0:08:19.52,0:08:20.73,نص عام,,0,0,0,"إشاعات غير لائقة"؟
Dialogue: 0,0:08:20.81,0:08:23.82,general text,,0,0,0,,كثير من الناس يشاعون أنه عاجز جنسياً،
Dialogue: 0,0:08:23.90,0:08:25.23,نص عام,,0,0,0,,مرات ممارسات العفة
Dialogue: 0,0:08:25.98,0:08:27.15,نص عام,,0,0,0,,هذا غير صحيح
Dialogue: 0,0:08:27.24,0:08:29.66,نص عام,,0,0,0,,هذا ما قاله الجميع. هذا خطأ؟
Dialogue: 0,0:08:29.74,0:08:32.28,نص عام,,0,0,0,,ليست كلمة حق!
Dialogue: 0,0:08:33.33,0:08:34.91,نص عام,,0,0,0,,فلقد راجعت ذلك بنفسك
Dialogue: 0,0:08:36.41,0:08:38.12,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:08:38.21,0:08:40.96,نص عام,,0,0,0,,فهمت. ولهذا السبب قررت الزواج منه
Dialogue: 0,0:08:41.04,0:08:43.29,general text,,0,0,0,,أي امرأة ستتزوج برجل عاجز،
Dialogue: 0,0:08:43.38,0:08:45.25,نص عام,,0,0,0,,حتى لو كان وريثاً غنياً؟
Dialogue: 0,0:08:45.34,0:08:46.67,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:08:46.76,0:08:48.63,نص عام,,0,0,0,,كن مطمئناً، سأخبر الجميع
Dialogue: 0,0:08:48.72,0:08:50.63,general text,,0,0,0,"لقد فحصته، فهو ليس عاجزاً"
Dialogue: 0,0:08:50.72,0:08:52.34,نص عام,,0,0,0,,لم ننم معًا بعد!
Dialogue: 0,0:08:53.30,0:08:55.26,نص عام,,0,0,0,,حقاً لم يكن لدينا أي شيء بعد
Dialogue: 0,0:08:56.14,0:08:58.56,نص عام,,0,0,0,,لا تخجل. أنا أكبر سنا
Dialogue: 0,0:09:02.23,0:09:04.65,general text,,0,0,0,,كنت مؤذياً جداً عندما التقينا للمرة الأولى
Dialogue: 0,0:09:04.73,0:09:06.48,نص عام,,0,0,0,,والآن ظهر قلب
Dialogue: 0,0:09:08.86,0:09:13.49,general text,,0,0,0,,ظننت أنك يومًا ما ستقطع علاقاتك مع الجميع وتختفي
Dialogue: 0,0:09:15.24,0:09:18.54,نص عام,,0,0,0,,قلت لك أنني غيرت القدر
Dialogue: 0,0:09:19.62,0:09:23.29,النص العام,,0,0,0,,سأبقى وأحمي من أحب
Dialogue: 0,0:09:24.58,0:09:26.04,نص عام,,0,0,0,,يبدو أنك تحبه كثيرًا
Dialogue: 0,0:09:29.55,0:09:32.63,نص عام,,0,0,0,,أتمنى لك حياة سعيدة
Dialogue: 0,0:09:40.31,0:09:44.19,مائل,,0,0,0,,سألتقط سيفًا سيساعدك على تدمير تشان ووك
Dialogue: 0,0:09:45.36,0:09:49.78,general text,,0,0,0,,أنا وحدي القادر على حمايتك بإنقاذك من نجم الملك
Dialogue: 0,0:09:49.86,0:09:51.95,النص العام,,0,0,0,,شان ووك فقد كل قوته
Dialogue: 0,0:09:53.24,0:09:55.78,general text,,0,0,0,,بذلت كل طاقتي لتدمير الحاجز
Dialogue: 0,0:09:56.91,0:10:00.20,general text,,0,0,0,,لا يمكنه أن يصبح غوانغجو التالي
Dialogue: 0,0:10:00.29,0:10:02.16,نص عام,,0,0,0,,فقد نفوذه
Dialogue: 0,0:10:03.50,0:10:06.75,general text,,0,0,0,,والجميع يظن أن نجم الملك قد أشرق لي
Dialogue: 0,0:10:08.71,0:10:12.67,النص العام,,0,0,0,,ليس لديك ما تقدمه لي أيها النائب غوانغجو
Dialogue: 0,0:10:15.68,0:10:17.85,النص العام,,0,0,0,,شان غان ضحى بنفسه من أجل
Dialogue: 0,0:10:17.93,0:10:19.97,النص العام,,0,0,0,,سوسنوفي بور وجيني وون وجيونبوغوان
Dialogue: 0,0:10:20.06,0:10:23.77,general text,,0,0,0,,لكن جين وو تاك على قيد الحياة، وسوف يتم إدانتك
Dialogue: 0,0:10:24.56,0:10:27.31,نص عام,,0,0,0,,لا أريد معاقبة أستاذي السابق
Dialogue: 0,0:10:28.15,0:10:31.23,نص عام,,0,0,0,,وضح كل شيء واقبل العقاب
Dialogue: 0,0:10:35.70,0:10:37.82,general text,,0,0,0,,هل تعتقد حقاً أن الحجر قد اختفى؟
Dialogue: 0,0:10:39.87,0:10:42.25,النص العام,,0,0,0,,حجر الجليد مملوء بالطاقة السماوية
Dialogue: 0,0:10:42.33,0:10:44.79,نص عام,,0,0,0,,ولد تحت نجم الملك
Dialogue: 0,0:10:45.29,0:10:47.58,النص العام,,0,0,0,,مُنح هذه القوة
Dialogue: 0,0:10:48.54,0:10:50.67,نص عام,,0,0,0,,ماذا ستفعل,
Dialogue: 0,0:10:51.38,0:10:54.34,general text,,0,0,0,,إذا كان تشانغ ووك يخفي هذه القوة؟
Dialogue: 0,0:11:02.14,0:11:03.85,نص عام,,0,0,0,,سأنتظر ردك
Dialogue: 0,0:11:05.02,0:11:07.60,general text,,0,0,0,,سأظل وفياً لك دائماً يا صاحب السمو
Dialogue: 0,0:11:28.17,0:11:31.80,general text,,0,0,0,,عدت إلى رشدك لكنك لا تزال صامتاً؟
Dialogue: 0,0:11:34.84,0:11:39.01,general text,,0,0,0,,ما أنقذتك إلا لتكفر عن ذنوبك
Dialogue: 0,0:11:40.22,0:11:41.76,نص عام,,0,0,0,,أمام ابنتنا
Dialogue: 0,0:11:43.06,0:11:44.64,نص عام,,0,0,0,,قبل بو يونغ
Dialogue: 0,0:11:49.23,0:11:51.02,نص عام,,0,0,0,,عندما التقينا للمرة الأولى،
Dialogue: 0,0:11:53.32,0:11:55.53,النص العام,,0,0,0,,لقد وقعت في حب ابتسامتك الدافئة
Dialogue: 0,0:11:58.66,0:12:00.12,ذكريات,,0,0,0,,هذا لطيف أيضًا
Dialogue: 0,0:12:00.20,0:12:04.12,ذكريات,,0,0,0,,أعتقد أن هذا سيناسب بو يونغ
Dialogue: 0,0:12:06.96,0:12:10.17,نص عام,,0,0,0,,ومن لحظة لقائنا،
Dialogue: 0,0:12:11.25,0:12:12.50,نص عام,,0,0,0,,أحبك
Dialogue: 0,0:12:13.88,0:12:15.92,نص عام,,0,0,0,,لم أحب أحداً
Dialogue: 0,0:12:17.17,0:12:18.38,نص عام,,0,0,0,,إلا
Dialogue: 0,0:12:25.43,0:12:27.81,نص عام,,0,0,0,,أحاول أن أوضح لك شيئاً
Dialogue: 0,0:12:28.52,0:12:32.19,نص عام,,0,0,0,,أقول هذا لكي تعاني
Dialogue: 0,0:12:36.07,0:12:37.94,نص عام,,0,0,0,,أريدك أن تعرف،
Dialogue: 0,0:12:38.03,0:12:42.16,general text,,0,0,0,,خدعت جين مو، لقد فعلت هذا بابنتنا
Dialogue: 0,0:12:42.74,0:12:45.58,نص عام,,0,0,0,,أتمنى أن تعاني
Dialogue: 0,0:13:08.85,0:13:11.06,النص العام,,0,0,0,,جين وو تاك في سايجوكون
Dialogue: 0,0:13:11.14,0:13:12.77,نص عام,,0,0,0,,لقد عاد إلى رشده
Dialogue: 0,0:13:13.27,0:13:15.40,نص عام,,0,0,0,,بما أنه حي،
Dialogue: 0,0:13:15.48,0:13:18.36,النص العام,,0,0,0,,من المحتمل أن يخونني ويخون منظمتنا
Dialogue: 0,0:13:18.44,0:13:20.07,نص عام,,0,0,0,,علينا أن نتخلص منه
Dialogue: 0,0:13:26.53,0:13:29.12,نص عام,,0,0,0,,أحضرت رماد أرواح الملكة
Dialogue: 0,0:13:29.20,0:13:32.17,نص عام,,0,0,0,,والاجراس كما طلبت
Dialogue: 0,0:14:30.39,0:14:35.06,نص عام,,0,0,0,,أستطيع أن أجعل كل البدو يصابون بالجنون
Dialogue: 0,0:14:36.90,0:14:39.44,general text,,0,0,0,,إذا كان لدى تشانغ ووك قوة حجر الجليد،
Dialogue: 0,0:14:40.48,0:14:42.74,نص عام,,0,0,0,,سيتعين عليه أن يريهم
Dialogue: 0,0:14:49.74,0:14:51.58,نص عام,,0,0,0,,اجعلهم حلقتين
Dialogue: 0,0:14:53.96,0:14:56.12,نص عام,,0,0,0,,لقد طلبت حلقتين
Dialogue: 0,0:14:56.21,0:14:58.21,نص عام,,0,0,0,,حتى لا تكذب الشائعات
Dialogue: 0,0:14:59.75,0:15:02.05,النص العام,,0,0,0,,هذه خواتم زفاف، افعلي كل شيء جيدًا
Dialogue: 0,0:15:02.13,0:15:03.05,خط مائل,,0,0,0,,بالطبع
Dialogue: 0,0:15:03.13,0:15:05.51,نص عام,,0,0,0,,سأفعل كل شيء بأفضل طريقة ممكنة
Dialogue: 0,0:15:05.59,0:15:08.55,نص عام,,0,0,0,,ألق نظرة على هذه الخيارات
Dialogue: 0,0:15:08.64,0:15:09.89,نص عام,,0,0,0,,أيهما أعجبك؟
Dialogue: 0,0:15:09.97,0:15:11.64,نص عام,,0,0,0,,هذه جميلة
Dialogue: 0,0:15:11.72,0:15:12.68,نص عام,,0,0,0,,لا!
Dialogue: 0,0:15:14.35,0:15:15.39,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:15:15.48,0:15:18.48,نص عام,,0,0,0,,إنها مملوكة للسيدة يونغ أوك
Dialogue: 0,0:15:18.56,0:15:20.52,نص عام,,0,0,0,,- أوه، لا، ليس هؤلاء\N- حسنًا
Dialogue: 0,0:15:20.61,0:15:21.98,نص عام,,0,0,0,,إنهم ليسوا كذلك
Dialogue: 0,0:15:22.98,0:15:25.20,نص عام,,0,0,0,,- وهذا؟\N- لا...
Dialogue: 0,0:15:25.28,0:15:26.40,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:15:27.57,0:15:28.74,النص العام,,0,0,0,,- السيدة سو جيونغ...\N- ليست نفسها أيضًا
Dialogue: 0,0:15:29.32,0:15:31.08,نص عام,,0,0,0,,لا يعجبني شيء
Dialogue: 0,0:15:31.16,0:15:33.87,نص عام,,0,0,0,,سأزيل ما لا يناسبك
Dialogue: 0,0:15:35.16,0:15:37.25,نص عام,,0,0,0,,هذه...
Dialogue: 0,0:15:38.17,0:15:39.54,نص عام,,0,0,0,,وهذه
Dialogue: 0,0:15:40.59,0:15:41.84,نص عام,,0,0,0,,هنا
Dialogue: 0,0:15:41.92,0:15:44.42,نص عام,,0,0,0,,اختر من بين الباقي
Dialogue: 0,0:15:45.80,0:15:48.01,نص عام,,0,0,0,,سبع حلقات؟
Dialogue: 0,0:16:02.15,0:16:03.32,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:16:03.98,0:16:07.11,نص عام,,0,0,0,,لا يبدو أن هناك سبعة. أنا حقا لا أتذكر أحدا
Dialogue: 0,0:16:07.20,0:16:09.11,general text,,0,0,0,,هل كانوا مثل تشو يونغ؟
Dialogue: 0,0:16:10.12,0:16:12.08,general text,,0,0,0,,وعدت بالزواج إذا فتحت أبواب الطاقة؟
Dialogue: 0,0:16:12.16,0:16:13.95,النص العام,,0,0,0,,أقسم أنني لم أعتني بهم أولاً
Dialogue: 0,0:16:14.04,0:16:17.62,general text,,0,0,0,,أنت بنفسك قلت أنك بحاجة إلى بذل جهد حتى لا تقع في حب رجل وسيم
Dialogue: 0,0:16:17.71,0:16:20.17,نص عام,,0,0,0,,لم يبذلوا الجهد الكافي
Dialogue: 0,0:16:20.25,0:16:21.88,نص عام,,0,0,0,,لا تغضبني
Dialogue: 0,0:16:21.96,0:16:24.21,نص عام,,0,0,0,,الآن أنا ملكك بالكامل
Dialogue: 0,0:16:24.30,0:16:25.80,النص العام,,0,0,0,,ألست فخوراً بذلك
Dialogue: 0,0:16:25.88,0:16:27.80,general text,,0,0,0,,تجاوزت الجميع وحصلت على قلبي؟
Dialogue: 0,0:16:29.93,0:16:32.64,النص العام,,0,0,0,,لو كان هناك عشرات منهم سأكون فخوراً
Dialogue: 0,0:16:32.72,0:16:34.31,نص عام,,0,0,0,,وهكذا، مجرد مضحك
Dialogue: 0,0:16:34.39,0:16:35.97,النص العام,,0,0,0,,هل تعتقد أنه لم يكن هناك الكثير منهم؟
Dialogue: 0,0:16:37.93,0:16:39.98,نص عام,,0,0,0,,أنا أمزح. أنت الوحيد
Dialogue: 0,0:16:40.06,0:16:41.44,نص عام,,0,0,0,,لقد نسيت الجميع
Dialogue: 0,0:16:41.52,0:16:42.73,نص عام,,0,0,0,,انتظر لحظة
Dialogue: 0,0:16:43.65,0:16:45.78,نص عام,,0,0,0,,رأيت عدة حلقات عندما كنت أنظف غرفتك
Dialogue: 0,0:16:46.53,0:16:47.57,نص عام,,0,0,0,,علينا العثور عليهم
Dialogue: 0,0:16:47.65,0:16:50.91,general text,,0,0,0,,لماذا تبحث عن خواتم لا يحتاجها أحد؟
Dialogue: 0,0:16:50.99,0:16:53.53,نص عام,,0,0,0,,أنا متأكد من أنه كان هناك حوالي عشرة منهم
Dialogue: 0,0:16:54.62,0:16:55.58,نص عام,,0,0,0,,بحاجة للتدقيق
Dialogue: 0,0:17:01.75,0:17:03.08,نص عام,,0,0,0,,ليس لدي أحد
Dialogue: 0,0:17:05.88,0:17:07.84,نص عام,,0,0,0,,مو دوك، هيا نأكل
Dialogue: 0,0:17:10.30,0:17:12.18,نص عام,,0,0,0,,أخبرني بصراحة
Dialogue: 0,0:17:12.26,0:17:13.34,نص عام,,0,0,0,,كم عدد الخواتم؟
Dialogue: 0,0:17:18.93,0:17:20.19,نص عام,,0,0,0,,واحد
Dialogue: 0,0:17:20.27,0:17:22.98,النص العام,,0,0,0,,سأضع يدك في حلقة يدي
Dialogue: 0,0:17:24.19,0:17:26.36,النص العام,,0,0,0,,بالتأكيد لا أحد لديه مثل هذا الخاتم
Dialogue: 0,0:17:27.98,0:17:29.11,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:17:29.94,0:17:32.07,نص عام,,0,0,0,,بما أن لدينا حلقات بالفعل،
Dialogue: 0,0:17:32.57,0:17:35.07,النص العام,,0,0,0,,ليست هناك حاجة لتصنيعها من اليشم أيضًا
Dialogue: 0,0:17:37.74,0:17:39.95,مائل,,0,0,0,,ربما ينبغي علينا صنع بعض القلائد؟
Dialogue: 0,0:17:40.04,0:17:41.58,نص عام,,0,0,0,,كما تريد
Dialogue: 0,0:17:41.66,0:17:44.33,خط مائل,,0,0,0,,أنا لا أحسد دان غو ولو قليلاً
Dialogue: 0,0:17:44.88,0:17:48.13,مائل,,0,0,0,,- أنا لا أحسد تشو يون ولو قليلاً\N- {\i0}لذا فإن الشائعات صحيحة
Dialogue: 0,0:17:48.21,0:17:50.80,النص العام,,0,0,0,,هذا الرجل المؤذي... يبتسم
Dialogue: 0,0:17:52.05,0:17:53.34,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:17:53.43,0:17:55.60,نص عام,,0,0,0,,يبدو أنني منذ البداية
Dialogue: 0,0:17:56.89,0:18:00.23,نص عام,,0,0,0,,فهمت كل شيء خطأ. هذا عار
Dialogue: 0,0:18:01.35,0:18:02.52,نص عام,,0,0,0,,سيدتي,
Dialogue: 0,0:18:03.27,0:18:07.02,general text,,0,0,0,,فقط لا تقل أنك اعترفت له بمشاعرك في ذلك الحاجز
Dialogue: 0,0:18:07.61,0:18:10.40,نص عام,,0,0,0,,كنت أستعد. لقد اعترفت تقريبا
Dialogue: 0,0:18:11.78,0:18:13.20,نص عام,,0,0,0,,أتيحت لي الفرصة
Dialogue: 0,0:18:22.16,0:18:24.75,ذكريات,,0,0,0,,ليس عليك أن تحمل شمعة بجانبي
Dialogue: 0,0:18:24.83,0:18:26.63,ذكريات,,0,0,0,,يمكنك وضعها في مكان ما
Dialogue: 0,0:18:27.88,0:18:31.01,ذكريات,,0,0,0,,هل أنت محرج لوجودي هنا؟
Dialogue: 0,0:18:31.09,0:18:32.55,ذكريات,,0,0,0,,كل شيء يناسبني
Dialogue: 0,0:18:34.43,0:18:35.76,ذكريات,,0,0,0,,حسنًا، كما تعلم
Dialogue: 0,0:18:39.60,0:18:42.23,الذكريات,,0,0,0,,عندما كنت مستلقيًا في ذهول ثمل في سيجوكون،
Dialogue: 0,0:18:42.31,0:18:45.44,ذكريات,,0,0,0,,لم يزعجك تقدمي
Dialogue: 0,0:18:45.52,0:18:47.40,ذكريات,,0,0,0,,اعتقدت أنك مو دوك
Dialogue: 0,0:18:57.91,0:19:01.12,النص العام,,0,0,0,,هكذا هو بجوار حبيبته
Dialogue: 0,0:19:01.87,0:19:05.50,general text,,0,0,0,,إذا كان السيد أوك قد عانى بدلاً من السيد يوليا،
Dialogue: 0,0:19:05.58,0:19:08.13,نص عام,,0,0,0,,ستقترب أكثر
Dialogue: 0,0:19:09.75,0:19:11.92,نص عام,,0,0,0,,أنت تعالج الجرحى
Dialogue: 0,0:19:13.38,0:19:14.63,نص عام,,0,0,0,,هل تعتقد؟
Dialogue: 0,0:19:16.01,0:19:17.68,نص عام,,0,0,0,,إذا كان قد جُرح،
Dialogue: 0,0:19:20.39,0:19:22.27,نص عام,,0,0,0,,هل سأحظى بفرصة؟
Dialogue: 0,0:19:29.69,0:19:31.98,general text,,0,0,0,,يول، سمعت أنك عائد إلى قلعة سوهو.
Dialogue: 0,0:19:32.07,0:19:34.36,نص عام,,0,0,0,,نعم بعد زفاف دان جو
Dialogue: 0,0:19:34.44,0:19:36.07,general text,,0,0,0,,هل سنقيم حفلة قبل أن تغادري؟
Dialogue: 0,0:19:36.15,0:19:37.20,نص عام,,0,0,0,,نعم
Dialogue: 0,0:19:48.63,0:19:52.88,مائل,,0,0,0,,لقد شفي جرحك، لكن هل مازلت تتألم؟
Dialogue: 0,0:19:53.84,0:19:57.05,نص عام,,0,0,0,,ظننت أن الأمر سيتحسن، لكنني كنت مخطئًا
Dialogue: 0,0:19:57.68,0:20:00.01,general text,,0,0,0,,حدث شيء آخر عندما كنت غائباً عن الوعي
Dialogue: 0,0:20:00.09,0:20:01.64,نص عام,,0,0,0,,هل كان في الحاجز؟
Dialogue: 0,0:20:01.72,0:20:05.85,نص عام,,0,0,0,,أوقفنا النزيف
Dialogue: 0,0:20:08.73,0:20:11.61,general text,,0,0,0,,الهاربة سو يي أعطتك دمها
Dialogue: 0,0:20:14.48,0:20:16.78,نص عام,,0,0,0,,لا يمكنك التبرع بالدم بهذه الطريقة
Dialogue: 0,0:20:17.36,0:20:19.45,النص العام,,0,0,0,,لماذا هذا الاستهتار؟
Dialogue: 0,0:20:20.95,0:20:22.33,نص عام,,0,0,0,,أنا فقط
Dialogue: 0,0:20:22.41,0:20:25.20,نص عام,,0,0,0,,أراد إنقاذه
Dialogue: 0,0:20:28.75,0:20:31.75,النص العام,,0,0,0,,لقد دخل دمها إلى جرحك
Dialogue: 0,0:20:32.84,0:20:34.84,نص عام,,0,0,0,,ولكن هذا لا ينبغي أن يسبب مشاكل
Dialogue: 0,0:20:34.92,0:20:36.34,نص عام,,0,0,0,,أعتقد أنني سأتحسن قريبًا
Dialogue: 0,0:20:37.13,0:20:40.01,النص العام,,0,0,0,,لا أريد أن تقلق الرؤوس، لذا أبقِ الأمر سراً
Dialogue: 0,0:20:42.47,0:20:44.76,مائل,,0,0,0,,حسنًا، إلى الأسفل!
Dialogue: 0,0:20:46.39,0:20:48.56,نص عام,,0,0,0,,مرحبًا، ماذا تفعل هناك؟
Dialogue: 0,0:20:50.06,0:20:51.85,نص عام,,0,0,0,,ماذا سرقت؟
Dialogue: 0,0:20:52.44,0:20:54.52,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:20:54.61,0:20:56.48,نص عام,,0,0,0,,مرحبًا! قف!
Dialogue: 0,0:21:16.30,0:21:19.76,النص العام,,0,0,0,,الجرح الذي خلفته الدودة يلتئم ببطء شديد
Dialogue: 0,0:21:31.94,0:21:34.02,نص عام,,0,0,0,,تلك الدودة في جسده
Dialogue: 0,0:21:38.36,0:21:39.90,النص العام,,0,0,0,,ربما يتألم
Dialogue: 0,0:21:41.15,0:21:44.24,النص العام,,0,0,0,,إنه يحتاج إلى الدواء الذي تناولته في جينيوون
Dialogue: 0,0:21:50.37,0:21:51.62,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:21:54.83,0:21:57.84,نص عام,,0,0,0,,يجب ألا تعمل هنا بعد الآن
Dialogue: 0,0:21:58.76,0:22:01.51,نص عام,,0,0,0,,ماذا؟ هل تطردني؟
Dialogue: 0,0:22:01.59,0:22:03.63,النص العام,,0,0,0,,إذا كان الأمر كذلك، هل ستستمع إلي؟
Dialogue: 0,0:22:03.72,0:22:06.30,نص عام,,0,0,0,,- لا\N- كنت أعلم أنه ليس كذلك
Dialogue: 0,0:22:06.39,0:22:07.89,نص عام,,0,0,0,,لا تجعلني شخصًا سيئًا
Dialogue: 0,0:22:10.60,0:22:12.48,نص عام,,0,0,0,,لا تقومي بالأعمال المنزلية بعد الآن
Dialogue: 0,0:22:13.56,0:22:16.98,general text,,0,0,0,,سوف تكونين زوجته الحبيبة، لا أستطيع أن أجبرك على العمل
Dialogue: 0,0:22:18.40,0:22:21.19,نص عام,,0,0,0,,إذن تقبلني؟
Dialogue: 0,0:22:21.28,0:22:24.07,نص عام,,0,0,0,,هل لدي خيار؟ هو فقط يعشقك
Dialogue: 0,0:22:26.45,0:22:29.49,نص عام,,0,0,0,,لن أدعوك سيدتي
Dialogue: 0,0:22:30.54,0:22:32.33,نص عام,,0,0,0,,لن أعتبرك حماتي أيضاً
Dialogue: 0,0:22:32.41,0:22:35.25,general text,,0,0,0,,لماذا يجب أن أكون حماتك إذا كنت أنا نفسي لم أتزوج بعد؟
Dialogue: 0,0:22:35.33,0:22:36.33,نص عام,,0,0,0,,هذا من شأنه أن يجرح كبريائي
Dialogue: 0,0:22:36.96,0:22:38.09,نص عام,,0,0,0,,في الواقع
Dialogue: 0,0:22:38.63,0:22:41.46,general text,,0,0,0,,لكنك أنت والرئيس ستتزوجان قريباً، أليس كذلك؟
Dialogue: 0,0:22:43.72,0:22:45.89,نص عام,,0,0,0,,ظننت أنكما تحبان بعضكما البعض
Dialogue: 0,0:22:54.77,0:22:55.94,نص عام,,0,0,0,,العذراء كيم...
Dialogue: 0,0:22:56.90,0:22:59.32,نص عام,,0,0,0,,حتى أنت لاحظت ذلك لكنه لم يفعل
Dialogue: 0,0:22:59.86,0:23:01.65,نص عام,,0,0,0,,- حسنًا...\N- هذا...
Dialogue: 0,0:23:01.73,0:23:04.28,النص العام,,0,0,0,,كيف يمكن أن يكون بطيئًا إلى هذا الحد؟
Dialogue: 0,0:23:04.36,0:23:05.49,general text,,0,0,0,,هل هو منغلق أم ماذا؟
Dialogue: 0,0:23:05.57,0:23:06.95,نص عام,,0,0,0,,إنه مجرد أحمق
Dialogue: 0,0:23:12.12,0:23:16.17,ذكريات بخط مائل,,0,0,0,,نعم! يعشق! الحب هو الجزرة!
Dialogue: 0,0:23:17.12,0:23:18.75,نص عام,,0,0,0,,لا أستطيع
Dialogue: 0,0:23:20.00,0:23:22.09,نص عام,,0,0,0,,انسوا الكلمات,
Dialogue: 0,0:23:22.17,0:23:23.46,نص عام,,0,0,0,,التي قالتها
Dialogue: 0,0:23:24.76,0:23:26.18,نص عام,,0,0,0,,أنا
Dialogue: 0,0:23:36.89,0:23:38.06,نص عام,,0,0,0,,الفصل
Dialogue: 0,0:23:43.15,0:23:44.19,نص عام,,0,0,0,,المملكة المتحدة...
Dialogue: 0,0:23:44.78,0:23:47.41,نص عام,,0,0,0,,متى وصلت؟
Dialogue: 0,0:23:47.49,0:23:49.82,نص عام,,0,0,0,,مؤخراً. أردت أن أقول لك شيئا
Dialogue: 0,0:23:49.91,0:23:53.04,نص عام,,0,0,0,,ما الذي يقلقك إلى هذه الدرجة؟
Dialogue: 0,0:23:54.00,0:23:55.33,نص عام,,0,0,0,,شيء رهيب
Dialogue: 0,0:23:56.71,0:23:58.00,نص عام,,0,0,0,,يقلقني
Dialogue: 0,0:23:58.87,0:24:01.04,نص عام,,0,0,0,,ماذا أردت أن تقول؟
Dialogue: 0,0:24:01.67,0:24:02.88,نص عام,,0,0,0,,كما ترى...
Dialogue: 0,0:24:02.96,0:24:07.13,النص العام,,0,0,0,,أخطط لمغادرة العاصمة لفترة بعد زفاف دان جو
Dialogue: 0,0:24:08.01,0:24:09.34,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:24:11.26,0:24:12.56,نص عام,,0,0,0,,ثم...
Dialogue: 0,0:24:13.72,0:24:15.31,نص عام,,0,0,0,,والخادمة كيم؟
Dialogue: 0,0:24:17.48,0:24:21.48,general text,,0,0,0,,إذا لم يكن أحد يريدها أن تبقى، فسأضطر إلى اصطحابها معي
Dialogue: 0,0:24:22.82,0:24:26.19,نص عام,,0,0,0,,لا أعرف متى سنعود. ربما في عام، وربما في عشرة
Dialogue: 0,0:24:26.28,0:24:28.86,نص عام,,0,0,0,,أو ربما لن نعود أبدًا
Dialogue: 0,0:24:33.70,0:24:36.25,نص عام,,0,0,0,,لقد فعلت شيئاً
Dialogue: 0,0:24:36.91,0:24:39.58,نص عام,,0,0,0,,لا يغتفر
Dialogue: 0,0:24:42.92,0:24:44.38,نص عام,,0,0,0,,إذا أبقيتها هنا،
Dialogue: 0,0:24:44.46,0:24:47.72,النص العام,,0,0,0,,هل تعتقد أنها ستبقى؟
Dialogue: 0,0:24:49.18,0:24:50.05,نص عام,,0,0,0,,هي...
Dialogue: 0,0:24:52.01,0:24:52.97,نص عام,,0,0,0,,بكاء
Dialogue: 0,0:25:00.90,0:25:04.11,general text,,0,0,0,,سوف تبكي أكثر إذا لم توقفها
Dialogue: 0,0:25:10.32,0:25:12.66,نص عام,,0,0,0,,سأغادر
Dialogue: 0,0:25:14.03,0:25:15.24,نص عام,,0,0,0,,مع المعلم الشاب
Dialogue: 0,0:25:16.74,0:25:17.95,نص عام,,0,0,0,,لن أرحل
Dialogue: 0,0:25:20.16,0:25:21.25,نص عام,,0,0,0,,سأرحل
Dialogue: 0,0:25:25.88,0:25:28.84,النص العام,,0,0,0,,ليس هناك فائدة من البقاء. بحاجة للذهاب
Dialogue: 0,0:25:43.65,0:25:46.52,نص عام,,0,0,0,,أريد شيئاً
Dialogue: 0,0:25:48.28,0:25:50.19,نص عام,,0,0,0,,تظهر لك
Dialogue: 0,0:26:01.16,0:26:03.17,نص عام,,0,0,0,,هذه بذور البلسم
Dialogue: 0,0:26:04.50,0:26:06.13,نص عام,,0,0,0,,إذا زرعتها الآن،
Dialogue: 0,0:26:07.04,0:26:10.09,نص عام,,0,0,0,,سوف تتفتح الزهور خلال ثلاثة إلى أربعة أشهر
Dialogue: 0,0:26:12.51,0:26:16.01,نص عام,,0,0,0,,أستطيع أن أجعلها تزدهر الآن أمام عينيك،
Dialogue: 0,0:26:16.10,0:26:18.01,نص عام,,0,0,0,,استخدام التعويذة
Dialogue: 0,0:26:19.18,0:26:20.35,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:26:22.52,0:26:23.81,نص عام,,0,0,0,,أنا بطيء جدًا
Dialogue: 0,0:26:29.23,0:26:32.07,نص عام,,0,0,0,,أريد أن أراها تنبت ببطء
Dialogue: 0,0:26:33.90,0:26:35.45,نص عام,,0,0,0,,وتزهر
Dialogue: 0,0:26:41.79,0:26:43.33,general text,,0,0,0,,هل ستنتظرهم ليزدهروا معي؟
Dialogue: 0,0:27:16.70,0:27:17.78,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:27:23.66,0:27:24.66,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:27:25.79,0:27:29.21,النص العام,,0,0,0,,سأمشي معك في الحياة ببطء
Dialogue: 0,0:27:47.14,0:27:50.65,النص العام,,0,0,0,,هذه الهدية لن تعوقهم إلا
Dialogue: 0,0:28:11.09,0:28:13.88,نص عام,,0,0,0,,شكرًا لك. سوف نأكل كل شيء
Dialogue: 0,0:28:13.96,0:28:15.05,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:28:26.43,0:28:27.94,نص عام,,0,0,0,,هل رأيت؟
Dialogue: 0,0:28:28.02,0:28:30.65,النص العام,,0,0,0,,كان هذا الأجاشي يبكي
Dialogue: 0,0:28:30.73,0:28:35.07,النص العام,,0,0,0,,لم أر قط بالغين يبكون بالمخاط
Dialogue: 0,0:28:36.19,0:28:38.53,نص عام,,0,0,0,,ربما يكون مريضاً
Dialogue: 0,0:28:38.61,0:28:39.78,نص عام,,0,0,0,,هل تعتقد؟
Dialogue: 0,0:29:07.27,0:29:08.48,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:29:09.64,0:29:11.31,نص عام,,0,0,0,,جلبت لك الدواء
Dialogue: 0,0:29:11.40,0:29:12.73,نص عام,,0,0,0,,هنا
Dialogue: 0,0:29:19.95,0:29:23.28,general text,,0,0,0,,بمجرد أن يتحدث شقيق الشامان تشوي،
Dialogue: 0,0:29:23.37,0:29:25.16,نص عام,,0,0,0,,يمكننا القبض على جين مو
Dialogue: 0,0:29:25.24,0:29:28.25,نص عام,,0,0,0,,أريد أن أسأل جين مو شيئًا ما
Dialogue: 0,0:29:30.16,0:29:32.75,general text,,0,0,0,,والدي نفسه قرر أن يصبح بدوياً
Dialogue: 0,0:29:32.83,0:29:35.71,نص عام,,0,0,0,,أم أن هناك قصة ما وراء هذا؟
Dialogue: 0,0:29:35.79,0:29:37.25,نص عام,,0,0,0,,وحده من يعلم
Dialogue: 0,0:29:39.42,0:29:42.97,مائل,,0,0,0,,مراقب النجوم تشو تشون مات بسبب غوانغجو تشانغ جانج
Dialogue: 0,0:29:43.55,0:29:47.43,general text,,0,0,0,,علم مراقب النجوم تشو أن غوانغجو يستخدم السحر
Dialogue: 0,0:29:47.51,0:29:49.23,general text,,0,0,0,,خوفاً من أن ينكشف كل شيء،
Dialogue: 0,0:29:49.31,0:29:52.52,general text,,0,0,0,,جين مو جعله بدوياً وأصبح جامحاً
Dialogue: 0,0:29:52.60,0:29:54.23,نص عام,,0,0,0,,هذا يعني،
Dialogue: 0,0:29:54.31,0:29:56.94,نص عام,,0,0,0,,أننا قتلنا شخصاً بريئاً؟
Dialogue: 0,0:30:03.41,0:30:04.70,خط مائل,,0,0,0,,ليس خطأنا
Dialogue: 0,0:30:05.32,0:30:07.16,نص عام,,0,0,0,,لم نعرف القصة كاملة
Dialogue: 0,0:30:08.12,0:30:09.33,نص عام,,0,0,0,,الجميع يفكر,
Dialogue: 0,0:30:09.41,0:30:12.71,نص عام,,0,0,0,,أن المنجم "تشو" قتل عائلته لأنه أصبح مهتماً بالسحر
Dialogue: 0,0:30:13.54,0:30:17.21,النص العام,,0,0,0,,طلب غوانغجو تبرئة اسم تشو تشون
Dialogue: 0,0:30:17.92,0:30:21.80,نص عام,,0,0,0,,سنناقش هذا الأمر في المجلس الموحد القادم
Dialogue: 0,0:30:21.88,0:30:25.05,general text,,0,0,0,,ولكن لماذا ذهب جين مو إلى هذا الحد؟
Dialogue: 0,0:30:25.14,0:30:27.30,النص العام,,0,0,0,,إذا أراد إبقاء تشو تشون صامتًا،
Dialogue: 0,0:30:27.39,0:30:28.85,نص عام,,0,0,0,,لماذا قلبه
Dialogue: 0,0:30:28.93,0:30:32.64,general text,,0,0,0,,في الروح ابتلاع وأجبر على قتل جميع أفراد الأسرة؟
Dialogue: 0,0:30:34.94,0:30:36.11,خط مائل,,0,0,0,,جين مو كان يعرف كل شيء
Dialogue: 0,0:30:36.69,0:30:40.23,نص عام,,0,0,0,,حول ظروف ولادة تشان ووك
Dialogue: 0,0:30:41.49,0:30:42.99,نص عام,,0,0,0,,لقد فعلها
Dialogue: 0,0:30:43.07,0:30:44.99,نص عام,,0,0,0,,مع صديق تشانغ غون، تشو تشون،
Dialogue: 0,0:30:46.37,0:30:48.45,النص العام,,0,0,0,,فقط لتعذيب تشانغ جانج
Dialogue: 0,0:30:48.53,0:30:49.74,نص عام,,0,0,0,,هذا يعني،
Dialogue: 0,0:30:51.00,0:30:54.50,نص عام,,0,0,0,,إذا تم القبض على جين مو فسوف يستسلم
Dialogue: 0,0:30:55.83,0:30:57.08,نص عام,,0,0,0,,سيد. سر تشان
Dialogue: 0,0:30:57.17,0:31:00.80,نص عام,,0,0,0,,لا يمكننا السماح بذلك. جين مو
Dialogue: 0,0:31:02.84,0:31:04.59,النص العام,,0,0,0,,يجب أن يموت
Dialogue: 0,0:31:18.77,0:31:22.44,ذكريات مائلة,,0,0,0,,إذا وضعت لعنة على عاكسات الروح، إذن
Dialogue: 0,0:31:22.53,0:31:26.57,الذكريات,,0,0,0,,يمكنك التحكم بالروح التي تستخدمه
Dialogue: 0,0:31:38.54,0:31:40.96,ذكريات بخط مائل,,0,0,0,,يمكنك أن تجعله ينفجر،
Dialogue: 0,0:31:41.80,0:31:46.18,ذكريات مائلة,,0,0,0,,ثم تخلص منه عندما يتحجر
Dialogue: 0,0:31:55.31,0:31:57.10,نص عام,,0,0,0,,شامان تشوي
Dialogue: 0,0:31:57.81,0:32:02.27,النص العام,,0,0,0,,وضعت لعنة على كل عاكسات الروح التي خلقتها
Dialogue: 0,0:32:03.03,0:32:07.11,نص عام,,0,0,0,,لهذا السبب لم أصبح بدوياً حتى يومنا هذا
Dialogue: 0,0:32:08.82,0:32:10.62,نص عام,,0,0,0,,سأجبر كل البدو
Dialogue: 0,0:32:10.70,0:32:14.45,general text,,0,0,0,,انطلق جامحًا في هذه العاصمة، مثل "تشو تشون" في ذلك اليوم.
Dialogue: 0,0:32:20.17,0:32:21.09,نص عام,,0,0,0,,نائب,
Dialogue: 0,0:32:22.17,0:32:24.34,general text,,0,0,0,,تشان ووك على وشك مغادرة جيونجينجاك
Dialogue: 0,0:32:26.05,0:32:28.09,general text,,0,0,0,,غابة الصنوبر تسمح له بالذهاب؟
Dialogue: 0,0:32:28.18,0:32:29.13,نص عام,,0,0,0,,هذه هي الشائعات
Dialogue: 0,0:32:29.22,0:32:31.39,نص عام,,0,0,0,,يقولون أنه سيغادر العاصمة
Dialogue: 0,0:32:31.47,0:32:33.81,النص العام,,0,0,0,,هل سيترك كل شيء؟
Dialogue: 0,0:32:33.89,0:32:37.14,general text,,0,0,0,,تشان ووك هو سلاحي الوحيد ضد الأمير. اذا رحل...
Dialogue: 0,0:32:37.23,0:32:39.27,ذكريات,,0,0,0,,ليس لديك ما تقدمه لي،
Dialogue: 0,0:32:40.40,0:32:41.36,ذكريات,,0,0,0,,نائب غوانغجو
Dialogue: 0,0:32:42.31,0:32:44.65,general text,,0,0,0,,لماذا يغادر سوسنوفي بور؟
Dialogue: 0,0:32:44.73,0:32:48.11,general text,,0,0,0,,شرب السم ليصل إلى هناك، واستولى على تشيسو.
Dialogue: 0,0:32:48.20,0:32:51.16,general text,,0,0,0,,ربما حتى لديه قوة الحجر،
Dialogue: 0,0:32:51.24,0:32:52.70,نص عام,,0,0,0,,فلماذا؟
Dialogue: 0,0:32:57.33,0:33:00.08,نص عام,,0,0,0,,ربما تغير؟
Dialogue: 0,0:33:05.13,0:33:07.55,ذكريات,,0,0,0,,هذا يعني أنه تغير
Dialogue: 0,0:33:07.63,0:33:09.93,ذكريات,,0,0,0,,لماذا تغير فجأة؟
Dialogue: 0,0:33:11.93,0:33:13.85,النص العام,,0,0,0,,ما الذي جعله يتغير؟
Dialogue: 0,0:33:14.60,0:33:17.98,ذكريات,,0,0,0,,الناس يتغيرون بسبب أشخاص آخرين
Dialogue: 0,0:33:19.48,0:33:22.15,ذكريات,,0,0,0,,اكتشف من ظهر في اللحظة التي بدأ فيها التغيير
Dialogue: 0,0:33:25.15,0:33:26.57,ذكريات,,0,0,0,,هذا سيكون الجواب
Dialogue: 0,0:33:27.36,0:33:30.57,general text,,0,0,0,,اكتشف من ظهر في اللحظة التي بدأ فيها التغيير
Dialogue: 0,0:33:31.24,0:33:32.91,ذكريات,,0,0,0,,جئت من أجل سيف ناك سو
Dialogue: 0,0:33:35.87,0:33:39.16,نص عام,,0,0,0,,لا يمكن أن يكون كذلك. لا يمكن أن يكون ناك سو
Dialogue: 0,0:33:41.00,0:33:42.88,مائل,,0,0,0,,لقد استخدم Tansu، التي كانت مملوكة لناك سو
Dialogue: 0,0:33:43.46,0:33:44.59,نص عام,,0,0,0,,لا...
Dialogue: 0,0:33:45.79,0:33:47.88,النص العام,,0,0,0,,ربما تعلم هذا من المعلم لي
Dialogue: 0,0:33:47.96,0:33:51.01,ذكريات,,0,0,0,,رأيت كل شيء عندما كنت معه في دانهيانغك
Dialogue: 0,0:33:51.09,0:33:54.72,ذكريات,,0,0,0,,ولم يكن معه أحد إلا خادمته
Dialogue: 0,0:34:02.60,0:34:07.69,النص العام,,0,0,0,,يرحل مع خادمته؟
Dialogue: 0,0:34:07.77,0:34:08.78,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:34:08.86,0:34:12.78,general text,,0,0,0,,يأخذ معه مو دوك الذي يتبعه في كل مكان.
Dialogue: 0,0:34:28.92,0:34:30.92,نص عام,,0,0,0,,آسف لجلبك إلى هنا
Dialogue: 0,0:34:31.55,0:34:33.84,نص عام,,0,0,0,,قلت أنك بحاجة لشراء الكثير من الأشياء
Dialogue: 0,0:34:33.93,0:34:35.51,نص عام,,0,0,0,,سأساعدك
Dialogue: 0,0:34:41.64,0:34:43.52,النص العام,,0,0,0,,إذا كانت هي من أعتبرها...
Dialogue: 0,0:35:32.44,0:35:33.69,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:35:44.37,0:35:46.96,النص العام,,0,0,0,,- هل أنت بخير؟\N- نعم
Dialogue: 0,0:35:47.62,0:35:49.54,مائل,,0,0,0,,ألم تسمعني أناديك؟
Dialogue: 0,0:35:51.92,0:35:52.92,نص عام,,0,0,0,,سمعت
Dialogue: 0,0:35:53.71,0:35:56.30,مائل,,0,0,0,,لماذا لم أجب؟
Dialogue: 0,0:35:57.76,0:35:59.72,general text,,0,0,0,,هل سمعت أيضًا رنين الأجراس؟
Dialogue: 0,0:36:00.64,0:36:02.93,نص عام,,0,0,0,,جيل الأجراس؟ لم أسمع
Dialogue: 0,0:36:03.52,0:36:06.81,نص عام,,0,0,0,,- إنهم ليسوا جيدين جدًا، فلنبدأ\N - حسنًا
Dialogue: 0,0:36:10.15,0:36:11.06,نص عام,,0,0,0,,ناك سو,
Dialogue: 0,0:36:12.82,0:36:15.61,نص عام,,0,0,0,,لقد منحتني الأمل
Dialogue: 0,0:36:24.16,0:36:26.41,نص عام,,0,0,0,,سيد لي، هناك واحد هناك
Dialogue: 0,0:36:27.08,0:36:28.87,نص عام,,0,0,0,,إيه، ماذا تفعل؟
Dialogue: 0,0:36:29.54,0:36:30.42,مائل,,0,0,0,,ما خطبك؟
Dialogue: 0,0:36:30.50,0:36:33.71,النص العام,,0,0,0,,سيد لي، لقد فاتك الكثير من الأسماك
Dialogue: 0,0:36:34.34,0:36:36.59,النص العام,,0,0,0,,لست نادماً على السمكة التي لم أتمكن من اصطيادها
Dialogue: 0,0:36:36.67,0:36:38.34,نص عام,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:36:38.43,0:36:41.14,نص عام,,0,0,0,,فهذا مضيعة للوقت
Dialogue: 0,0:36:42.14,0:36:43.93,نص عام,,0,0,0,,وإلا فهو جشع وهوس
Dialogue: 0,0:36:44.01,0:36:46.31,نص عام,,0,0,0,,- ماذا؟ \N- ومع ذلك،
Dialogue: 0,0:36:46.39,0:36:50.77,general text,,0,0,0,,أدركت أن في الخسارة حزناً خالصاً
Dialogue: 0,0:36:54.32,0:36:58.07,general text,,0,0,0,,مؤخرًا بدأت أفهم سبب حزن الناس،
Dialogue: 0,0:36:58.15,0:36:59.86,النص العام,,0,0,0,,عندما يرون تدفق الماء،
Dialogue: 0,0:36:59.95,0:37:04.08,نص عام,,0,0,0,,موسم العبور وغروب الشمس
Dialogue: 0,0:37:14.00,0:37:16.55,general text,,0,0,0,,النظر إلى هذه العربة الفارغة يحزنني
Dialogue: 0,0:37:16.63,0:37:18.72,نص عام,,0,0,0,,قال مو دوك إنه يصطاد الكثير من الأسماك
Dialogue: 0,0:37:19.30,0:37:21.68,general text,,0,0,0,,فهل ستترك البدو بجانبك؟
Dialogue: 0,0:37:25.68,0:37:28.10,النص العام,,0,0,0,,وفينا بوعدنا لك
Dialogue: 0,0:37:28.85,0:37:30.69,general text,,0,0,0,,وجهت "ناك سو" سيفها نحوي،
Dialogue: 0,0:37:30.77,0:37:32.73,نص عام,,0,0,0,,ثم خفضته
Dialogue: 0,0:37:32.81,0:37:38.11,general text,,0,0,0,,لذا آمل أن تلتزم بجانبك من الصفقة وتتركنا نذهب.
Dialogue: 0,0:37:38.19,0:37:40.36,general text,,0,0,0,,ماذا حدث لحجر الجليد ذلك اليوم؟
Dialogue: 0,0:37:41.45,0:37:44.99,نص عام,,0,0,0,,هل يمكن أن يكون بداخلك؟
Dialogue: 0,0:37:59.63,0:38:01.76,نص عام,,0,0,0,,حتى لو كان الأمر كذلك،
Dialogue: 0,0:38:02.80,0:38:04.85,نص عام,,0,0,0,,إنه عديم الفائدة على الإطلاق
Dialogue: 0,0:38:04.93,0:38:09.31,general text,,0,0,0,,لا أستطيع حتى التحكم في قطرة ماء، ناهيك عن السمكة الذهبية.
Dialogue: 0,0:38:11.89,0:38:15.98,general text,,0,0,0,,إذا بدأت التدريب مرة أخرى، فستتمكن من استخدام هذه القوة
Dialogue: 0,0:38:16.57,0:38:18.61,النص العام,,0,0,0,,رأيت مدى الرغبة في السيطرة على هذه القوة
Dialogue: 0,0:38:18.69,0:38:21.95,نص عام,,0,0,0,,جعل الناس قاسيين وأشراراً
Dialogue: 0,0:38:22.86,0:38:26.03,النص العام,,0,0,0,,من الأفضل عدم إيقاظ قوة حجر الجليد
Dialogue: 0,0:38:28.08,0:38:31.16,النص العام,,0,0,0,,أنت جشع للأسماك،
Dialogue: 0,0:38:31.25,0:38:33.25,نص عام,,0,0,0,,ألا تهتم بحجر الجليد؟
Dialogue: 0,0:38:34.54,0:38:36.17,النص العام,,0,0,0,,أنت أفضل مني
Dialogue: 0,0:38:39.42,0:38:42.88,general text,,0,0,0,,على أية حال، طالما أنني أملك حجر الجليد،
Dialogue: 0,0:38:44.01,0:38:46.18,نص عام,,0,0,0,,أستطيع حماية شخص واحد
Dialogue: 0,0:38:47.26,0:38:50.52,النص العام,,0,0,0,,إذا أصبح مو دوك جامحًا،
Dialogue: 0,0:38:50.60,0:38:54.06,general text,,0,0,0,,ساعدني في استخدام هذه القوة لإيقاف هذا
Dialogue: 0,0:38:54.14,0:38:58.65,general text,,0,0,0,,ستكون بخير طالما أنها لم تحاول إظهار قوتها
Dialogue: 0,0:38:59.23,0:39:02.86,general text,,0,0,0,,في هذا الجسد الضعيف تختبئ روح القاتل القوية
Dialogue: 0,0:39:02.94,0:39:05.66,general text,,0,0,0,,لو حدث أي شيء لكانت قد أصبحت جامحة بالفعل
Dialogue: 0,0:39:05.74,0:39:07.53,نص عام,,0,0,0,,لم تغضب لأنها،
Dialogue: 0,0:39:07.62,0:39:10.99,نص عام,,0,0,0,,أن جسدها تسيطر عليه قوة الروح
Dialogue: 0,0:39:12.62,0:39:15.21,نص عام,,0,0,0,,أدركت ذلك عندما التقينا للمرة الأولى
Dialogue: 0,0:39:20.59,0:39:23.13,general text,,0,0,0,,الشيء الوحيد الذي يمكن مقارنته بقوة الساحر،
Dialogue: 0,0:39:23.22,0:39:25.34,نص عام,,0,0,0,,هذه هي القوى الإلهية للكاهنات
Dialogue: 0,0:39:26.89,0:39:30.26,general text,,0,0,0,,أعتقد أن جثة مو ديوك تنتمي في الأصل إلى
Dialogue: 0,0:39:30.85,0:39:33.31,نص عام,,0,0,0,,إلى شخص يتمتع بقدرات إلهية
Dialogue: 0,0:39:57.29,0:39:59.29,ذكريات,,0,0,0,,هذا سوف يساعد في تخفيف الألم
Dialogue: 0,0:40:00.46,0:40:04.09,ذكريات,,0,0,0,,سيسهل الأمر فقط، لكنه لن يتخلص منه
Dialogue: 0,0:40:05.38,0:40:07.43,نص عام,,0,0,0,,يجب أن أعطيه هذا
Dialogue: 0,0:40:14.72,0:40:17.56,نص عام,,0,0,0,,لقد حفرت قبرك بيدك
Dialogue: 0,0:40:19.90,0:40:22.52,general text,,0,0,0,,تجرؤون على خداعي والتظاهر بأنها ابنتي،
Dialogue: 0,0:40:23.19,0:40:24.07,نص عام,,0,0,0,,وأنا كذلك؟
Dialogue: 0,0:40:26.78,0:40:28.61,نص عام,,0,0,0,,لم تخدعوا
Dialogue: 0,0:40:28.70,0:40:31.45,النص العام,,0,0,0,,كنت تعلم ولكنك كنت تتظاهر
Dialogue: 0,0:40:32.99,0:40:34.70,general text,,0,0,0,,هل بسبب حجر الجليد؟
Dialogue: 0,0:40:36.41,0:40:37.62,نص عام,,0,0,0,,نعم
Dialogue: 0,0:40:37.71,0:40:40.83,النص العام,,0,0,0,,الأم تتعرف دائمًا على طفلها
Dialogue: 0,0:40:42.50,0:40:44.05,النص العام,,0,0,0,,قبل أن تطلق لسانك،
Dialogue: 0,0:40:44.13,0:40:48.30,نص عام,,0,0,0,,من الأفضل أن أقتلك هنا والآن
Dialogue: 0,0:40:49.80,0:40:51.18,نص عام,,0,0,0,,فأنت وهذا
Dialogue: 0,0:40:52.68,0:40:54.01,نص عام,,0,0,0,,هل تعرفين؟
Dialogue: 0,0:40:54.85,0:40:57.02,general text,,0,0,0,,بو يونغ كانت ترتدي هذه الضمادة عندما اختفت
Dialogue: 0,0:40:58.52,0:41:00.44,نص عام,,0,0,0,,قلت أنك طرزتها بنفسك
Dialogue: 0,0:41:11.91,0:41:14.53,نص عام,,0,0,0,,من أين لك هذا؟
Dialogue: 0,0:41:14.62,0:41:16.83,نص عام,,0,0,0,,هل أعطاك جين مو هذا؟
Dialogue: 0,0:41:19.16,0:41:20.08,نص عام,,0,0,0,,لا
Dialogue: 0,0:41:21.08,0:41:24.75,النص العام,,0,0,0,,فقط أعرف من هو صاحبها الحقيقي
Dialogue: 0,0:41:24.84,0:41:26.05,نص عام,,0,0,0,,أخبرني
Dialogue: 0,0:41:27.55,0:41:29.38,نص عام,,0,0,0,,ابنتك لا تزال على قيد الحياة
Dialogue: 0,0:41:31.01,0:41:32.39,نص عام,,0,0,0,,اقتلني,
Dialogue: 0,0:41:33.09,0:41:34.89,النص العام,,0,0,0,,ولن تراها مرة أخرى أبدًا
Dialogue: 0,0:41:37.47,0:41:38.60,النص العام,,0,0,0,,سأنقذ حياتك
Dialogue: 0,0:41:39.18,0:41:41.02,نص عام,,0,0,0,,أين ابنتي؟
Dialogue: 0,0:41:45.23,0:41:46.48,نص عام,,0,0,0,,لا تستعجلني
Dialogue: 0,0:41:48.53,0:41:52.24,نص عام,,0,0,0,,سأخبرك عندما أتأكد من سلامتي
Dialogue: 0,0:42:09.30,0:42:10.92,نص عام,,0,0,0,,لقد اختفى حجر الجليد
Dialogue: 0,0:42:11.42,0:42:14.09,general text,,0,0,0,,لكن كان هناك بدو تم إنشاؤهم على يد شقيق تشوي وأخته
Dialogue: 0,0:42:14.18,0:42:16.35,نص عام,,0,0,0,,وتنظيمهم
Dialogue: 0,0:42:17.06,0:42:20.73,general text,,0,0,0,,سوسنوفي بور وجيني وون سيدمرونهم جميعًا
Dialogue: 0,0:42:21.73,0:42:24.56,نص عام,,0,0,0,,أطلب مساعدتكم
Dialogue: 0,0:42:28.23,0:42:29.99,نص عام,,0,0,0,,أنت تسألني
Dialogue: 0,0:42:30.61,0:42:33.03,النص العام,,0,0,0,,لم تحمي جين مو حتى لو تم القبض عليه؟
Dialogue: 0,0:42:33.11,0:42:37.70,general text,,0,0,0,,أعلم أنه كان معلمك، لكني أعتقد أنه لم يعميك
Dialogue: 0,0:42:40.16,0:42:41.50,نص عام,,0,0,0,,إذن أنت تثق بي؟
Dialogue: 0,0:42:42.79,0:42:44.00,النص العام,,0,0,0,,ثم تصدق,
Dialogue: 0,0:42:44.96,0:42:47.92,نص عام,,0,0,0,,أني ولدت تحت نجم الملك وأزلت الحاجز؟
Dialogue: 0,0:42:52.63,0:42:56.34,النص العام,,0,0,0,,تم رفع حاجز الحجر الجليدي وكنت هناك
Dialogue: 0,0:42:56.43,0:42:58.22,نص عام,,0,0,0,,ثم أشرق نجم الملك
Dialogue: 0,0:42:59.22,0:43:03.02,general text,,0,0,0,,لأنني، مثل أي شخص آخر، أعتقد أن نجمًا قد أشرق فوقك
Dialogue: 0,0:43:07.86,0:43:10.65,نص عام,,0,0,0,,لم أكن وحدي هنا في ذلك اليوم
Dialogue: 0,0:43:11.86,0:43:13.24,نص عام,,0,0,0,,لقد وقفت هناك
Dialogue: 0,0:43:13.32,0:43:17.16,النص العام,,0,0,0,,من سيلاحظ شخصًا آخر غيرك؟
Dialogue: 0,0:43:17.24,0:43:21.45,النص العام,,0,0,0,,كان تشان ووك هناك، أنا متأكد أنك رأيته
Dialogue: 0,0:43:23.87,0:43:25.79,النص العام,,0,0,0,,إنه بمثابة الابن بالنسبة لي
Dialogue: 0,0:43:26.92,0:43:29.17,general text,,0,0,0,,لقد أنقذت حياته يا صاحب الجلالة
Dialogue: 0,0:43:30.17,0:43:32.21,نص عام,,0,0,0,,أنا ممتن حقًا لهذا
Dialogue: 0,0:43:42.93,0:43:45.69,النص العام,,0,0,0,,اليوم سأغادر سوسنوفي بور
Dialogue: 0,0:43:45.77,0:43:47.02,نص عام,,0,0,0,,أترك العمل هنا
Dialogue: 0,0:43:49.31,0:43:51.86,النص العام,,0,0,0,,لقد مررت بالكثير للحصول على هذه الوظيفة
Dialogue: 0,0:43:52.61,0:43:54.94,النص العام,,0,0,0,,من المؤسف أنك ستغادرين بسبب الزفاف
Dialogue: 0,0:43:55.61,0:43:59.24,general text,,0,0,0,,ومن ناحية أخرى، سوف تصبح سيدة عائلة تشان
Dialogue: 0,0:44:01.95,0:44:04.04,النص العام,,0,0,0,,مو دوك، تهانينا على زفافك
Dialogue: 0,0:44:04.12,0:44:05.21,نص عام,,0,0,0,,كن سعيداً
Dialogue: 0,0:44:12.17,0:44:14.59,نص عام,,0,0,0,,دعونا نفعل ذلك الآن. دعنا نذهب
Dialogue: 0,0:44:15.26,0:44:18.97,نص عام,,0,0,0,,لماذا تقف هناك؟ اتبعني
Dialogue: 0,0:44:22.81,0:44:27.44,النص العام,,0,0,0,,صاحب السمو، شكرًا لك على إنقاذ حياتي
Dialogue: 0,0:44:28.19,0:44:31.56,نص عام,,0,0,0,,أتمنى أن يسطع نجم الملك إلى الأبد
Dialogue: 0,0:44:31.65,0:44:33.86,نص عام,,0,0,0,,كفى. لا حاجة للتظاهر
Dialogue: 0,0:44:34.44,0:44:35.36,نص عام,,0,0,0,,محرج
Dialogue: 0,0:44:37.99,0:44:41.32,general text,,0,0,0,,أنت تعلم أن تشان ووك هو من أنقذ الجميع في ذلك اليوم.
Dialogue: 0,0:44:41.41,0:44:45.62,general text,,0,0,0,,كما اتفقتم، لن أخبر أي روح حية
Dialogue: 0,0:44:45.70,0:44:46.87,نص عام,,0,0,0,,فلا تقلق
Dialogue: 0,0:44:48.79,0:44:52.13,general text,,0,0,0,,هل تعتقد أنني قلق من فقدان الشهرة؟
Dialogue: 0,0:44:52.21,0:44:54.84,نص عام,,0,0,0,,أنا فقط منزعج من تملق الجميع
Dialogue: 0,0:44:54.92,0:44:57.67,النص العام,,0,0,0,,كلهم يسبحونك
Dialogue: 0,0:44:57.76,0:45:01.01,نص عام,,0,0,0,,يمكنك فقط قبول هذا الثناء
Dialogue: 0,0:45:01.09,0:45:03.89,general text,,0,0,0,,من المزعج سماع التملق من الغرباء، لكن...
Dialogue: 0,0:45:04.60,0:45:06.81,النص العام,,0,0,0,,عندما تشكرني، بمعرفة الحقيقة كاملة،
Dialogue: 0,0:45:08.43,0:45:11.19,نص عام,,0,0,0,,يبدو أنك تمزح معي. مزعج
Dialogue: 0,0:45:16.40,0:45:18.49,نص عام,,0,0,0,,أتفهم أنك غير مرتاح
Dialogue: 0,0:45:20.78,0:45:23.45,النص العام,,0,0,0,,لن تراني مرة أخرى أبدًا
Dialogue: 0,0:45:23.95,0:45:25.03,نص عام,,0,0,0,,فلا تقلق
Dialogue: 0,0:45:27.08,0:45:28.16,نص عام,,0,0,0,,سمعت
Dialogue: 0,0:45:29.54,0:45:32.04,النص العام,,0,0,0,,- ستغادرين معه\N{\i1}- نعم
Dialogue: 0,0:45:32.13,0:45:35.46,النص العام,,0,0,0,,سوف نبتعد عن هنا ونعيش معًا
Dialogue: 0,0:45:36.05,0:45:37.09,نص عام,,0,0,0,,معاً؟
Dialogue: 0,0:45:39.97,0:45:42.01,نص عام,,0,0,0,,يمكنني بسهولة منعك من المغادرة
Dialogue: 0,0:45:42.76,0:45:44.80,النص العام,,0,0,0,,تظن أنني سأدعه يذهب،
Dialogue: 0,0:45:45.64,0:45:47.27,النص العام,,0,0,0,,متى يعرف نقطة ضعفي؟
Dialogue: 0,0:45:50.06,0:45:54.90,general text,,0,0,0,,وإذا بقينا قريبين كيف ستشعر؟
Dialogue: 0,0:45:57.53,0:46:00.95,نص عام,,0,0,0,,لن ينتهي الأمر بغضب واحد فقط
Dialogue: 0,0:46:07.29,0:46:08.29,نص عام,,0,0,0,,نعم
Dialogue: 0,0:46:08.79,0:46:11.71,general text,,0,0,0,,وون مو ديوك، لقد استمعت إلى شكواي التافهة
Dialogue: 0,0:46:12.75,0:46:14.75,نص عام,,0,0,0,,استمع لهذا أيضاً
Dialogue: 0,0:46:15.59,0:46:18.71,general text,,0,0,0,,سأشعر بأنني لا قيمة لي، عندما أعلم أنه فعل ما لم أستطع
Dialogue: 0,0:46:19.26,0:46:22.76,general text,,0,0,0,,والتظاهر بأن هذا هو كل ما عندي من الجدارة، سأصبح أكثر إثارة للشفقة
Dialogue: 0,0:46:22.84,0:46:23.89,نص عام,,0,0,0,,لكن الأقوى
Dialogue: 0,0:46:25.76,0:46:27.85,النص العام,,0,0,0,,سأحتقر بشدة...
Dialogue: 0,0:46:29.85,0:46:32.69,نص عام,,0,0,0,,كلاكما، نراكما معًا
Dialogue: 0,0:46:36.36,0:46:37.52,نص عام,,0,0,0,,سبق أن قلت،
Dialogue: 0,0:46:37.61,0:46:41.07,نص عام,,0,0,0,,لا أتمسك بما لا أستطيع التمسك به
Dialogue: 0,0:46:41.15,0:46:43.91,general text,,0,0,0,,هل تعلم ماذا سيحدث إذا حاولت الإمساك بشخص ما ولم أستطع؟
Dialogue: 0,0:46:45.78,0:46:47.87,النص العام,,0,0,0,,سوف تلوم هذا الرجل
Dialogue: 0,0:46:49.24,0:46:50.87,نص عام,,0,0,0,,وتتخلص منه؟
Dialogue: 0,0:46:50.95,0:46:54.79,general text,,0,0,0,,إذا تحول الشفقة على النفس إلى قسوة أو غضب،
Dialogue: 0,0:46:57.59,0:47:00.63,نص عام,,0,0,0,,تجنبي لن يصلح أي شيء
Dialogue: 0,0:47:03.26,0:47:05.39,نص عام,,0,0,0,,اذهب إلى أبعد من ذلك
Dialogue: 0,0:47:07.18,0:47:08.47,نص عام,,0,0,0,,لم أستطع الوصول إليك
Dialogue: 0,0:47:22.74,0:47:23.90,نص عام,,0,0,0,,يا شباب,
Dialogue: 0,0:47:24.99,0:47:26.45,نص عام,,0,0,0,,سأتزوج غداً!
Dialogue: 0,0:47:32.91,0:47:34.04,نص عام,,0,0,0,,يا شباب
Dialogue: 0,0:47:34.62,0:47:37.75,النص العام,,0,0,0,,لن نرى بعضنا البعض كثيرًا بعد الآن
Dialogue: 0,0:47:37.83,0:47:38.75,خط مائل,,0,0,0,,بالطبع لا
Dialogue: 0,0:47:38.84,0:47:41.88,نص عام,,0,0,0,,لن يسمح تشو يونغ بهذا
Dialogue: 0,0:47:41.96,0:47:43.76,نص عام,,0,0,0,,- ولا حماته\N- بالضبط
Dialogue: 0,0:47:44.92,0:47:46.51,نص عام,,0,0,0,,لن يأتي مرة أخرى
Dialogue: 0,0:47:47.22,0:47:48.85,نص عام,,0,0,0,,ركوب الخيل
Dialogue: 0,0:47:48.93,0:47:50.97,النص العام,,0,0,0,,أو اذهب للصيد معنا
Dialogue: 0,0:47:51.97,0:47:55.06,نص عام,,0,0,0,,سوف أجد الوقت لرؤيتك
Dialogue: 0,0:47:55.14,0:47:57.81,نص عام,,0,0,0,,وكيف؟ هل ستكذب بشأن التدريب؟
Dialogue: 0,0:47:57.90,0:48:00.69,general text,,0,0,0,,هل كنت ستكذب جديًا على كاهنة جينيوون؟
Dialogue: 0,0:48:00.77,0:48:02.48,نص عام,,0,0,0,,سيتم القبض عليه فوراً
Dialogue: 0,0:48:02.57,0:48:05.07,نص عام,,0,0,0,,سوف تحيطك بآثارها
Dialogue: 0,0:48:05.15,0:48:06.61,نص عام,,0,0,0,,وسيطالب بالحقيقة
Dialogue: 0,0:48:06.70,0:48:08.45,نص عام,,0,0,0,,ثم تعترف بكل شيء
Dialogue: 0,0:48:09.03,0:48:11.74,general text,,0,0,0,,سوف ينتفوا شعره كله
Dialogue: 0,0:48:11.83,0:48:13.95,النص العام,,0,0,0,,لنبدأ بحقيقة أن شعره خفيف
Dialogue: 0,0:48:19.58,0:48:20.54,خط مائل,,0,0,0,,أنا أفهم
Dialogue: 0,0:48:20.63,0:48:21.79,نص عام,,0,0,0,,أنت تحسدني
Dialogue: 0,0:48:22.63,0:48:24.88,نص عام,,0,0,0,,مازلت سعيدًا
Dialogue: 0,0:48:24.96,0:48:27.72,النص العام,,0,0,0,,سأتزوج حبي الأول
Dialogue: 0,0:48:28.34,0:48:32.76,النص العام,,0,0,0,,أعطيكم أيها العزاب طاقتي الطيبة
Dialogue: 0,0:48:35.22,0:48:38.27,النص العام,,0,0,0,,- القبض\N- نعم، لديك مو ديوك
Dialogue: 0,0:48:38.35,0:48:40.40,النص العام,,0,0,0,,- نعم\N- لكنها ليست حبك الأول
Dialogue: 0,0:48:40.48,0:48:43.19,general text,,0,0,0,,- هل هي الثامنة بالفعل؟\N- لا... لا... لا
Dialogue: 0,0:48:43.27,0:48:45.65,النص العام,,0,0,0,,- فقط لا تخبرها بذلك\N- حسنًا
Dialogue: 0,0:48:45.74,0:48:47.61,نص عام,,0,0,0,,حسنًا، سنتركك
Dialogue: 0,0:48:47.70,0:48:50.20,النص العام,,0,0,0,,يول، يمكنك أن تأخذ طاقتي
Dialogue: 0,0:48:50.28,0:48:51.32,نص عام,,0,0,0,,لا حاجة
Dialogue: 0,0:48:52.37,0:48:53.58,نص عام,,0,0,0,,لقد تم رفضي مؤخرًا
Dialogue: 0,0:48:53.66,0:48:54.83,خط مائل,,0,0,0,,ماذا؟
Dialogue: 0,0:48:54.91,0:48:56.16,نص عام,,0,0,0,,من؟
Dialogue: 0,0:48:57.62,0:48:58.83,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:49:02.84,0:49:03.96,نص عام,,0,0,0,,لا
Dialogue: 0,0:49:04.50,0:49:07.47,نص عام,,0,0,0,,لم تكن لدي مشاعر تجاهها
Dialogue: 0,0:49:11.76,0:49:13.72,مائل,,0,0,0,,إذن من هو؟
Dialogue: 0,0:49:14.60,0:49:16.18,نص عام,,0,0,0,,المملكة المتحدة، هل تعلم؟
Dialogue: 0,0:49:16.81,0:49:18.73,نص عام,,0,0,0,,حسنًا، لدي تخميناتي الخاصة
Dialogue: 0,0:49:23.69,0:49:27.15,general text,,0,0,0,,هل قررت أين ستذهب يا تشان ووك؟
Dialogue: 0,0:49:28.44,0:49:31.36,نص عام,,0,0,0,,قرية ساري. أريد أن أعرف شيئا
Dialogue: 0,0:49:31.45,0:49:34.87,general text,,0,0,0,,هل أنت مستعد للعودة إلى قلعة سوهو؟
Dialogue: 0,0:49:35.49,0:49:37.62,general text,,0,0,0,,ستغادرين مباشرة بعد زفافي، أليس كذلك؟
Dialogue: 0,0:49:37.70,0:49:39.16,نص عام,,0,0,0,,بعد قليل، على ما أعتقد
Dialogue: 0,0:49:40.00,0:49:41.54,نص عام,,0,0,0,,لم أشفى بعد
Dialogue: 0,0:49:41.62,0:49:43.25,نص عام,,0,0,0,,هل ما زال يؤلمك؟
Dialogue: 0,0:49:43.33,0:49:45.17,النص العام,,0,0,0,,سمعت أن الجرح قد التئم بالفعل
Dialogue: 0,0:49:45.75,0:49:47.67,نص عام,,0,0,0,,ماذا؟ هل السيد هوو دجال؟
Dialogue: 0,0:49:48.51,0:49:50.05,مائل,,0,0,0,,لقد التئم الجرح،
Dialogue: 0,0:49:50.13,0:49:51.59,نص عام,,0,0,0,,لكنه ما زال يؤلمني
Dialogue: 0,0:49:53.14,0:49:54.10,نص عام,,0,0,0,,سأكون بخير
Dialogue: 0,0:50:08.69,0:50:09.86,نص عام,,0,0,0,,سيدي. لذلك يول
Dialogue: 0,0:50:11.28,0:50:13.45,نص عام,,0,0,0,,لا أعرف إذا كان ينبغي عليّ أن أعطيك هذا
Dialogue: 0,0:50:13.53,0:50:16.87,النص العام,,0,0,0,,لكن امرأة متسولة طلبت نقلها
Dialogue: 0,0:50:28.92,0:50:33.18,خط مائل,,0,0,0,,هذا الدواء سيخفف آلام الصدر
Dialogue: 0,0:50:33.26,0:50:34.93,خط مائل,,0,0,0,,يجب أن تقبله
Dialogue: 0,0:50:36.26,0:50:38.39,خارج الشاشة,,0,0,0,,هذا الشخص يعرف حالتي
Dialogue: 0,0:50:39.10,0:50:40.22,خلف الكواليس,,0,0,0,,من هذا؟
Dialogue: 0,0:50:51.49,0:50:54.11,النص العام,,0,0,0,,كنت أعلم أنك ستعود يا صاحب السمو
Dialogue: 0,0:50:55.91,0:50:59.16,general text,,0,0,0,,تشان ووك مرهق، سأطرده من هنا
Dialogue: 0,0:50:59.24,0:51:01.37,نص عام,,0,0,0,,ليس لديه حجر ثلج
Dialogue: 0,0:51:02.04,0:51:04.87,النص العام,,0,0,0,,اعترف بجرائمك في نهاية اليوم
Dialogue: 0,0:51:04.96,0:51:06.21,نص عام,,0,0,0,,إذا لم تفعل هذا،
Dialogue: 0,0:51:08.54,0:51:10.92,النص العام,,0,0,0,,سأمسك بك وأعاقبك بنفسي
Dialogue: 0,0:51:13.80,0:51:16.05,النص العام,,0,0,0,,الجميع يخدعونك
Dialogue: 0,0:51:19.01,0:51:21.39,النص العام,,0,0,0,,هل رأيت رئيس سوسنوفي بور اليوم؟
Dialogue: 0,0:51:21.93,0:51:23.60,نص عام,,0,0,0,,ماذا قال؟
Dialogue: 0,0:51:23.68,0:51:26.81,general text,,0,0,0,,هل سررت لأن النجم كان يسطع فوقك؟
Dialogue: 0,0:51:27.69,0:51:31.36,النص العام,,0,0,0,,إنه يعلم أنه كان تشان ووك، وليس أنت
Dialogue: 0,0:51:33.74,0:51:35.99,خط مائل,,0,0,0,,وكذلك السيد لي
Dialogue: 0,0:51:36.07,0:51:37.99,نص عام,,0,0,0,,لقد اقتحم القصر
Dialogue: 0,0:51:38.07,0:51:40.33,نص عام,,0,0,0,,وذكر نجم الملك
Dialogue: 0,0:51:43.37,0:51:46.92,general text,,0,0,0,,هل تريد أن تقول إن الجميع يخدعونني ويسخرون مني؟
Dialogue: 0,0:51:47.00,0:51:49.42,general text,,0,0,0,,إنهم يحاولون حماية تشان ووك
Dialogue: 0,0:51:50.00,0:51:51.84,general text,,0,0,0,,من يسطع له النجم فله الحجر
Dialogue: 0,0:51:51.92,0:51:53.30,النص العام,,0,0,0,,وغابة الصنوبر تحميه
Dialogue: 0,0:51:53.38,0:51:56.43,نص عام,,0,0,0,,أنا وحدي من يستطيع حمايتك
Dialogue: 0,0:52:01.39,0:52:03.81,خط مائل,,0,0,0,,يحتفظ تشان ووك بسر كبير
Dialogue: 0,0:52:04.39,0:52:05.94,نص عام,,0,0,0,,سأفضحه...
Dialogue: 0,0:52:07.48,0:52:08.56,نص عام,,0,0,0,,و...
Dialogue: 0,0:52:09.48,0:52:13.23,نص عام,,0,0,0,,سأجعلك تغرق في الحضيض
Dialogue: 0,0:52:22.95,0:52:24.04,خط مائل,,0,0,0,,حسنًا...
Dialogue: 0,0:52:25.04,0:52:27.46,نص عام,,0,0,0,,من شرب كل هذا؟
Dialogue: 0,0:52:27.54,0:52:28.75,نص عام,,0,0,0,,كأسك فارغ
Dialogue: 0,0:52:28.83,0:52:30.92,نص عام,,0,0,0,,هل هذا أنت؟ لقد شربت كل شيء
Dialogue: 0,0:52:31.54,0:52:33.13,النص العام,,0,0,0,,إذا كان الكأس فارغاً فاسكب لي كأساً آخر
Dialogue: 0,0:52:33.21,0:52:34.63,نص عام,,0,0,0,,- مثل هذا\N- اشرب
Dialogue: 0,0:52:34.71,0:52:37.26,نص عام,,0,0,0,"أشرب مشروباً"؟ كيف تجرؤ؟
Dialogue: 0,0:52:37.34,0:52:38.72,مائل,,0,0,0,,-"تشرب"؟..\N- إلى الأسفل
Dialogue: 0,0:52:40.47,0:52:42.26,النص العام,,0,0,0,,أوه، هذا هو سيدنا الشاب!
Dialogue: 0,0:52:42.35,0:52:46.85,نص عام,,0,0,0,,لقد احتفلنا بشيء ما اليوم
Dialogue: 0,0:52:46.93,0:52:49.56,general text,,0,0,0,,- رحيلها من سوسنوفي بور\N- أرى
Dialogue: 0,0:52:49.65,0:52:52.15,نص عام,,0,0,0,,- مرحبًا تشان ووك\N- مرحبًا!
Dialogue: 0,0:52:52.73,0:52:54.53,النص العام,,0,0,0,,إنه سيدك الشاب
Dialogue: 0,0:52:55.40,0:52:57.99,نص عام,,0,0,0,,عذراً. خطأي
Dialogue: 0,0:52:58.07,0:53:00.20,مائل,,0,0,0,,- هذا صحيح\N{\i0}- لقد شربوا كثيرًا
Dialogue: 0,0:53:00.28,0:53:01.28,خط مائل,,0,0,0,,السيد الشاب
Dialogue: 0,0:53:01.37,0:53:03.49,نص عام,,0,0,0,,اذهب هنا
Dialogue: 0,0:53:07.00,0:53:10.00,نص عام,,0,0,0,,سأريكم شيئاً مذهلاً
Dialogue: 0,0:53:10.08,0:53:11.54,النص العام,,0,0,0,,عندما يكون مو دوك في حالة سكر،
Dialogue: 0,0:53:12.46,0:53:14.71,نص عام,,0,0,0,,هي لا تتحدث اللهجة
Dialogue: 0,0:53:16.38,0:53:17.97,نص عام,,0,0,0,,رائع، أليس كذلك؟
Dialogue: 0,0:53:18.55,0:53:19.63,نص عام,,0,0,0,,لا أستطيع
Dialogue: 0,0:53:19.72,0:53:22.30,نص عام,,0,0,0,,إظهار شيء جدير بالاهتمام حقًا
Dialogue: 0,0:53:23.01,0:53:25.93,نص عام,,0,0,0,,لكنني أستطيع الطيران إلى السطح
Dialogue: 0,0:53:26.02,0:53:28.27,نص عام,,0,0,0,,حقاً؟ جربه
Dialogue: 0,0:53:28.35,0:53:30.19,نص عام,,0,0,0,,- جربها؟\N- جربها
Dialogue: 0,0:53:31.52,0:53:32.48,نص عام,,0,0,0,,انظر بعناية
Dialogue: 0,0:53:39.61,0:53:41.78,نص عام,,0,0,0,,ثانية واحدة فقط
Dialogue: 0,0:53:44.58,0:53:45.99,النص العام,,0,0,0,,- مو دوك...\N- لا يعمل
Dialogue: 0,0:53:46.08,0:53:47.04,نص عام,,0,0,0,,اجلس
Dialogue: 0,0:53:47.12,0:53:49.54,نص عام,,0,0,0,,لا أستطيع فعل ذلك بعد الآن
Dialogue: 0,0:53:50.79,0:53:52.71,النص العام,,0,0,0,,ولا أستطيع أن أسل سيفي
Dialogue: 0,0:53:52.79,0:53:54.46,نص عام,,0,0,0,,ماذا؟ هذا؟
Dialogue: 0,0:53:54.54,0:53:57.13,نص عام,,0,0,0,,هذا ليس لك. هذا هو سيف ناك سو
Dialogue: 0,0:53:57.96,0:53:59.30,مائل,,0,0,0,,- السيد الصغير\N{\i0}- نعم؟
Dialogue: 0,0:53:59.38,0:54:03.64,general text,,0,0,0,,لماذا جلبت هذه القمامة مرة أخرى؟
Dialogue: 0,0:54:03.72,0:54:05.55,نص عام,,0,0,0,,سأتخلص منه
Dialogue: 0,0:54:06.51,0:54:08.22,نص عام,,0,0,0,,أعطني فرصة أخرى
Dialogue: 0,0:54:08.31,0:54:09.56,نص عام,,0,0,0,,- بالطبع، حاول\N- اجلس
Dialogue: 0,0:54:09.64,0:54:11.60,خط مائل,,0,0,0,,طير، افعلها
Dialogue: 0,0:54:15.77,0:54:18.19,general text,,0,0,0,,- نظف هنا واذهب للنوم\N- هل رأيت هذا؟
Dialogue: 0,0:54:18.28,0:54:20.03,general text,,0,0,0,,- سأتعامل مع Moo Dok\N- أستطيع الطيران
Dialogue: 0,0:54:20.11,0:54:22.03,نص عام,,0,0,0,,- لا تتحرك\N- نجح الأمر
Dialogue: 0,0:54:22.11,0:54:23.99,نص عام,,0,0,0,,لقد طارت حقاً
Dialogue: 0,0:54:25.12,0:54:27.12,نص عام,,0,0,0,,الفصل هل رأيت هذا؟
Dialogue: 0,0:54:27.20,0:54:28.95,نص عام,,0,0,0,,أريد أيضًا أن أطير
Dialogue: 0,0:54:29.04,0:54:32.00,النص العام,,0,0,0,,ليس لديكم أي فكرة يا أطفال عن هويتي
Dialogue: 0,0:54:32.08,0:54:35.13,نص عام,,0,0,0,,أنا السيد هنا. هل تريد مني أن تظهر لك؟
Dialogue: 0,0:54:38.71,0:54:39.84,نص عام,,0,0,0,,أنا السيد هنا
Dialogue: 0,0:54:40.51,0:54:42.17,نص عام,,0,0,0,,اليوم ليس يومي
Dialogue: 0,0:54:49.35,0:54:50.35,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:54:50.43,0:54:53.56,النص العام,,0,0,0,,لا تشرب مرة أخرى. سوف تخبر الجميع أنك ناك سو
Dialogue: 0,0:54:56.36,0:54:58.15,نص عام,,0,0,0,,يجب أن أقول لك شيئاً
Dialogue: 0,0:54:58.23,0:54:59.90,النص العام,,0,0,0,,النوم، ستخبرني غدًا
Dialogue: 0,0:55:01.61,0:55:02.95,نص عام,,0,0,0,,مطلوب اليوم
Dialogue: 0,0:55:03.45,0:55:06.32,general text,,0,0,0,,ماذا لو مت غدًا دون أن أخبرك بأي شيء؟
Dialogue: 0,0:55:06.99,0:55:09.37,نص عام,,0,0,0,,حسنًا، تحدث. يموت فجأة
Dialogue: 0,0:55:09.45,0:55:10.54,نص عام,,0,0,0,,أنا أستمع
Dialogue: 0,0:55:15.21,0:55:16.42,نص عام,,0,0,0,,تشانغ ووك
Dialogue: 0,0:55:19.46,0:55:21.05,نص عام,,0,0,0,,أنا معجب بك جدًا
Dialogue: 0,0:55:39.44,0:55:41.73,النص العام,,0,0,0,,نعم، وذهبت مباشرة إلى السرير
Dialogue: 0,0:55:41.82,0:55:43.19,نص عام,,0,0,0,,تمامًا هكذا
Dialogue: 0,0:55:46.66,0:55:49.70,النص العام,,0,0,0,,يجب أن نخبرها بما قاله السيد لي
Dialogue: 0,0:55:51.41,0:55:54.50,ذكريات بخط مائل,,0,0,0,,أعتقد أن جثة مو دوك تنتمي في الأصل إلى
Dialogue: 0,0:55:55.00,0:55:57.33,ذكريات بخط مائل,,0,0,0,,لشخص يتمتع بقدرات إلهية
Dialogue: 0,0:55:58.71,0:56:01.05,النص العام,,0,0,0,,ربما أعرف كيف أصل إلى قرية ساري
Dialogue: 0,0:57:43.86,0:57:46.98,نص عام,,0,0,0,,دع ما مضى قد مضى
Dialogue: 0,0:57:47.07,0:57:49.28,نص عام,,0,0,0,,الآن ستصبحون أقرباء
Dialogue: 0,0:57:50.61,0:57:53.16,general text,,0,0,0,,تشو يونغ لم ينضم إلى عائلة بارك
Dialogue: 0,0:57:53.74,0:57:56.58,النص العام,,0,0,0,,يصبح دان غو هذا جزءًا من حياتنا
Dialogue: 0,0:57:57.45,0:57:59.00,general text,,0,0,0,,إنه لن ينتقل للعيش معك
Dialogue: 0,0:57:59.75,0:58:02.71,general text,,0,0,0,,أنت تقول أشياء كهذه، والناس يثرثرون،
Dialogue: 0,0:58:02.79,0:58:05.38,النص العام,,0,0,0,,أن بارك دان جو سيصبح جين دان جو قريبًا
Dialogue: 0,0:58:07.09,0:58:09.05,general text,,0,0,0,,بناتهم سوف يمنحون لقبنا
Dialogue: 0,0:58:09.72,0:58:11.05,نص عام,,0,0,0,,ولابني - ابننا
Dialogue: 0,0:58:12.09,0:58:14.80,نص عام,,0,0,0,,لا تجادل في هذا اليوم الرائع
Dialogue: 0,0:58:14.89,0:58:16.81,نص عام,,0,0,0,,سيصل الضيوف قريبًا
Dialogue: 0,0:58:16.89,0:58:19.73,نص عام,,0,0,0,,كن مستعداً لتحيتهم
Dialogue: 0,0:58:19.81,0:58:21.52,خط مائل,,0,0,0,,هيا
Dialogue: 0,0:58:24.73,0:58:25.98,نص عام,,0,0,0,,أين دان جو؟
Dialogue: 0,0:58:26.07,0:58:28.11,general text,,0,0,0,,سيذهب إلى سايجوكون مع تشو يونغ أولاً
Dialogue: 0,0:58:28.69,0:58:31.40,general text,,0,0,0,,يريدون الوصول إلى والدها وإلقاء التحية
Dialogue: 0,0:58:32.57,0:58:33.61,نص عام,,0,0,0,,أين مو دوك؟
Dialogue: 0,0:58:35.37,0:58:37.91,نص عام,,0,0,0,,لا أعرف. لقد جاءت أولاً، لكنني لم أراها
Dialogue: 0,0:58:39.50,0:58:42.04,general text,,0,0,0,,هل تشعر بالحرج وتتجنبني بسبب الليلة الماضية؟
Dialogue: 0,0:59:46.69,0:59:47.60,نص عام,,0,0,0,,ناك سو,
Dialogue: 0,0:59:48.94,0:59:51.82,general text,,0,0,0,,لا يمكنك سحب سيفك لأنك عالق في هذا الجسد
Dialogue: 0,0:59:53.03,0:59:56.11,خط مائل,,0,0,0,,أنت سلاحي الأخير
Dialogue: 0,0:59:56.20,0:59:59.20,general text,,0,0,0,,أستخدم كل قوتي للاتصال بك
Dialogue: 0,1:00:00.12,1:00:01.95,نص عام,,0,0,0,,بمجرد أن تستعيد قوتك،
Dialogue: 0,1:00:03.00,1:00:04.54,نص عام,,0,0,0,,أنت مجنون
Dialogue: 0,1:01:02.05,1:01:05.06,ذكريات بخط مائل,,0,0,0,,فقط أعرف من هو مالكها الحقيقي
Dialogue: 0,1:01:05.81,1:01:08.19,ذكريات,,0,0,0,,ابنتك لا تزال على قيد الحياة
Dialogue: 0,1:01:09.14,1:01:10.27,ذكريات,,0,0,0,,الأم
Dialogue: 0,1:01:21.32,1:01:22.37,نص عام,,0,0,0,,عذراء كيم
Dialogue: 0,1:01:28.58,1:01:31.75,general text,,0,0,0,,أين كانت تعيش خادمتك مو دوك؟
Dialogue: 0,1:01:33.21,1:01:36.05,general text,,0,0,0,,هل والداها على قيد الحياة؟
Dialogue: 0,1:01:37.01,1:01:40.26,نص عام,,0,0,0,,لا. جاءت من قرية ساري
Dialogue: 0,1:01:41.34,1:01:43.89,general text,,0,0,0,,عندما اتُهمت بجرائم سو يي،
Dialogue: 0,1:01:43.97,1:01:45.51,نص عام,,0,0,0,,لقد أخبرتك بكل شيء
Dialogue: 0,1:01:46.31,1:01:48.10,نص عام,,0,0,0,,طلبت منك مساعدة هذه الفتاة المسكينة
Dialogue: 0,1:01:48.85,1:01:50.31,نص عام,,0,0,0,,لكنك لم تساعد
Dialogue: 0,1:01:51.60,1:01:54.44,نص عام,,0,0,0,,إذًا فإن "يي" تعرف "مو ديوك"؟
Dialogue: 0,1:01:55.07,1:01:57.99,نص عام,,0,0,0,,نعم. تعرفها السيدة تشو يونغ أيضًا
Dialogue: 0,1:02:04.12,1:02:05.87,نص عام,,0,0,0,,أنت جميلة بشكل لا يصدق
Dialogue: 0,1:02:08.12,1:02:10.96,نص عام,,0,0,0,,أستطيع أن أقول نفس الشيء عنك
Dialogue: 0,1:02:14.38,1:02:17.25,نص عام,,0,0,0,,دعنا نلقي التحية على والدك
Dialogue: 0,1:02:17.84,1:02:19.59,نص عام,,0,0,0,,لا يمكنك البقاء هنا لفترة طويلة
Dialogue: 0,1:02:20.17,1:02:23.30,النص العام,,0,0,0,,إذا علم الكبار بالأمر فسيجلسون على آذانهم
Dialogue: 0,1:02:23.93,1:02:24.97,نص عام,,0,0,0,,نعم
Dialogue: 0,1:02:25.93,1:02:27.01,نص عام,,0,0,0,,شكرًا لك،
Dialogue: 0,1:02:28.60,1:02:31.10,نص عام,,0,0,0,,رجل... زوج
Dialogue: 0,1:02:36.52,1:02:37.69,نص عام,,0,0,0,,كن حذراً،
Dialogue: 0,1:02:39.65,1:02:40.65,نص عام,,0,0,0,,أنثى... زوجة
Dialogue: 0,1:02:41.74,1:02:42.91,نص عام,,0,0,0,,زوجتي
Dialogue: 0,1:02:44.28,1:02:45.62,خط مائل,,0,0,0,,انتظر
Dialogue: 0,1:02:51.04,1:02:54.25,نص عام,,0,0,0,,مو دوك؟ لماذا أنت هنا؟
Dialogue: 0,1:02:59.59,1:03:02.17,النص العام,,0,0,0,,مو دوك، لا يمكنك إحضار السيف
Dialogue: 0,1:03:05.59,1:03:07.89,ذكريات بخط مائل,,0,0,0,,اقتل جين وو تاك أولاً
Dialogue: 0,1:03:13.85,1:03:14.81,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,1:03:45.84,1:03:47.26,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,1:03:49.76,1:03:50.89,نص عام,,0,0,0,,أنت
Dialogue: 0,1:03:51.56,1:03:53.56,نص عام,,0,0,0,,خادمة تشانغ ووك؟
Dialogue: 0,1:03:54.14,1:03:55.31,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:04:21.34,1:04:23.26,ذكريات بخط مائل,,0,0,0,,اقتل جين وو تاك
Dialogue: 0,1:04:30.89,1:04:32.01,نص عام,,0,0,0,,أبي!
Dialogue: 0,1:04:34.18,1:04:36.27,نص عام,,0,0,0,,أبي!
Dialogue: 0,1:04:38.56,1:04:39.65,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,1:04:39.73,1:04:40.81,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,1:04:40.90,1:04:42.40,نص عام,,0,0,0,,هي...
Dialogue: 0,1:04:42.48,1:04:45.19,نص عام,,0,0,0,,إنها مرتزقة
Dialogue: 0,1:04:45.94,1:04:47.11,نص عام,,0,0,0,,اركض يا تشو يونغ
Dialogue: 0,1:04:47.20,1:04:48.45,خط مائل,,0,0,0,,أسرع!
Dialogue: 0,1:05:13.39,1:05:14.64,نص عام,,0,0,0,,سيد!
Dialogue: 0,1:05:14.72,1:05:15.93,نص عام,,0,0,0,,أوقف مو دوك
Dialogue: 0,1:05:19.60,1:05:20.44,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:05:22.65,1:05:24.52,خط مائل,,0,0,0,,أوقفها!
Dialogue: 0,1:05:25.86,1:05:26.90,نص عام,,0,0,0,,لا...
Dialogue: 0,1:05:55.93,1:05:57.93,نص عام,,0,0,0,,اقتلها! بل
Dialogue: 0,1:06:15.49,1:06:16.54,نص عام,,0,0,0,,أبي!
Dialogue: 0,1:06:17.99,1:06:20.04,نص عام,,0,0,0,,أبي!
Dialogue: 0,1:06:20.58,1:06:21.42,نص عام,,0,0,0,,أبي!
Dialogue: 0,1:06:23.25,1:06:24.08,ذكريات مائلة,,0,0,0,,أبي
Dialogue: 0,1:06:25.67,1:06:27.71,خط مائل,,0,0,0,,أبي
Dialogue: 0,1:06:29.17,1:06:30.55,نص عام,,0,0,0,,الأب
Dialogue: 0,1:06:31.17,1:06:32.76,نص عام,,0,0,0,,لا تموت
Dialogue: 0,1:06:36.10,1:06:37.85,نص عام,,0,0,0,,أبي، من فضلك...
Dialogue: 0,1:06:38.60,1:06:40.14,نص عام,,0,0,0,,أبي
Dialogue: 0,1:06:43.15,1:06:44.27,ذكريات,,0,0,0,,أبي
Dialogue: 0,1:06:52.15,1:06:55.99,خط مائل,,0,0,0,,أبي، لا تموت
Dialogue: 0,1:06:57.70,1:06:58.79,نص عام,,0,0,0,,ناك سو,
Dialogue: 0,1:07:00.25,1:07:02.66,مائل,,0,0,0,,اقتل من فعل هذا بأبيك
Dialogue: 0,1:07:08.04,1:07:09.25,خط مائل,,0,0,0,,أبي!
Dialogue: 0,1:07:10.09,1:07:11.30,خط مائل,,0,0,0,,أبي!
Dialogue: 0,1:07:11.38,1:07:12.76,خط مائل,,0,0,0,,أبي!
Dialogue: 0,1:07:13.51,1:07:14.76,خط مائل,,0,0,0,,أبي!
Dialogue: 0,1:07:44.92,1:07:47.13,نص عام,,0,0,0,,كيف تجرؤ على الظهور هنا؟
Dialogue: 0,1:07:48.38,1:07:49.92,نص عام,,0,0,0,,امسك جين مو!
Dialogue: 0,1:07:51.51,1:07:53.05,نص عام,,0,0,0,,أنا نائب غوانغجو،
Dialogue: 0,1:07:53.13,1:07:55.01,نص عام,,0,0,0,,جاء للقبض على البدو
Dialogue: 0,1:07:57.59,1:08:00.93,النص العام,,0,0,0,,ناك سو، البدوي، الآن في سوسنوفي بور
Dialogue: 0,1:08:02.06,1:08:04.10,النص العام,,0,0,0,,- ناك سو?\N{\i1}- الفصل!
Dialogue: 0,1:08:08.65,1:08:10.11,نص عام,,0,0,0,,مشكلة!
Dialogue: 0,1:08:10.19,1:08:12.69,نص عام,,0,0,0,,ظهر المرتزق في سيجوكون
Dialogue: 0,1:08:15.11,1:08:18.28,نص عام,,0,0,0,,لقد قتلت السيد جين
Dialogue: 0,1:08:19.28,1:08:22.16,general text,,0,0,0,,هذا هو المرتزق الذي أبحث عنه. ناك سو
Dialogue: 0,1:08:22.91,1:08:23.79,نص عام,,0,0,0,,لا
Dialogue: 0,1:08:24.62,1:08:26.08,نص عام,,0,0,0,,هذا...
Dialogue: 0,1:08:26.16,1:08:27.37,نص عام,,0,0,0,,كان مو دوك
Dialogue: 0,1:08:27.46,1:08:31.29,نص عام,,0,0,0,,هذا مو دوك هو ناك سو
Dialogue: 0,1:08:38.64,1:08:39.68,نص عام,,0,0,0,,مرتزقة!
Dialogue: 0,1:08:40.35,1:08:42.22,النص العام,,0,0,0,,مرتزقة في سيجوكون!
Dialogue: 0,1:09:14.88,1:09:16.30,نص عام,,0,0,0,,امسكها!
Dialogue: 0,1:09:38.32,1:09:39.90,نص عام,,0,0,0,,- قبض!\N- نعم!
Dialogue: 0,1:11:20.17,1:11:21.17,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:11:25.01,1:11:26.14,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:11:29.39,1:11:30.52,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:11:35.10,1:11:36.10,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:11:42.03,1:11:42.86,نص عام,,0,0,0,,تشان ووك؟
Dialogue: 0,1:11:57.38,1:11:58.71,نص عام,,0,0,0,,هل هذا أنا؟
Dialogue: 0,1:12:00.42,1:12:01.67,نص عام,,0,0,0,,هذا أنا
Dialogue: 0,1:12:03.92,1:12:05.30,نص عام,,0,0,0,,لقد طعنتك
Dialogue: 0,1:12:26.61,1:12:27.74,ذكريات بخط مائل,,0,0,0,,واحد
Dialogue: 0,1:12:30.20,1:12:33.08,ذكريات,,0,0,0,,سأضع يدك في حلقة يدي
Dialogue: 0,1:12:33.95,1:12:36.54,ذكريات,,0,0,0,,بالتأكيد لا أحد لديه مثل هذا الخاتم
Dialogue: 0,1:12:39.75,1:12:42.05,ذكريات بخط مائل,,0,0,0,,إذا أصبحت ناك سو، سأكون في خطر
Dialogue: 0,1:12:42.63,1:12:45.92,ذكريات بخط مائل,,0,0,0,,لا يهمك ما يحدث لي حينها
Dialogue: 0,1:12:48.64,1:12:49.55,ذكريات,,0,0,0,,لماذا؟
Dialogue: 0,1:12:50.05,1:12:52.26,ذكريات,,0,0,0,,لأننا لن نكون طلاباً ومعلمين بعد الآن؟
Dialogue: 0,1:12:52.35,1:12:54.60,ذكريات,,0,0,0,,لن يكون لديك أي سبب لحمايتي
Dialogue: 0,1:12:54.68,1:12:56.98,ذكريات,,0,0,0,,ولدي أسباب لأكون أكثر لطفًا معك
Dialogue: 0,1:12:58.19,1:13:00.36,ذكريات,,0,0,0,,هذا كان وعدنا
Dialogue: 0,1:13:00.90,1:13:02.69,ذكريات بخط مائل,,0,0,0,,ثم وعد بشيء آخر
Dialogue: 0,1:13:02.77,1:13:04.23,ذكريات,,0,0,0,,عندما تستعيد قوتك،
Dialogue: 0,1:13:04.94,1:13:07.45,ذكريات,,0,0,0,,إذا كان عليك أن ترفع سيفك على شخص ما،
Dialogue: 0,1:13:08.49,1:13:10.20,ذكريات,,0,0,0,,دعني أكون الأول
Dialogue: 0,1:13:11.45,1:13:12.62,ذكريات,,0,0,0,,إذا طعنتني،
Dialogue: 0,1:13:12.70,1:13:17.46,ذكريات,,0,0,0,,سأموت لمن أطلق سراح المرتزق
Dialogue: 0,1:13:24.09,1:13:25.21,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,1:13:29.55,1:13:30.76,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,1:13:34.85,1:13:36.60,نص عام,,0,0,0,,لا...
Dialogue: 0,1:14:36.66,1:14:37.66,خط مائل,,0,0,0,,أمسكها!
Dialogue: 0,1:15:20.83,1:15:21.87,نص عام,,0,0,0,,المملكة المتحدة...
Dialogue: 0,1:15:28.96,1:15:30.42,نص عام,,0,0,0,,المملكة المتحدة!
Dialogue: 0,1:16:22.72,1:16:24.02,نص عام,,0,0,0,,أعتقد,
Dialogue: 0,1:16:27.02,1:16:30.31,نص عام,,0,0,0,,ووك كان يعلم أن مو ديوك هو ناك سو
Dialogue: 0,1:16:32.03,1:16:33.40,نص عام,,0,0,0,,جين مو
Dialogue: 0,1:16:34.44,1:16:37.41,النص العام,,0,0,0,,أبحث عن دليل على ذلك في جيونجينغاك بينما نتحدث
Dialogue: 0,1:16:42.95,1:16:44.54,نص عام,,0,0,0,,كنت أعرف ذلك أيضًا
Dialogue: 0,1:16:45.71,1:16:47.54,نص عام,,0,0,0,,دعني أذهب خلفها
Dialogue: 0,1:16:47.62,1:16:50.21,نص عام,,0,0,0,,وتعرف على ما حدث
Dialogue: 0,1:16:50.29,1:16:53.30,general text,,0,0,0,,أنت الابن الأكبر في عائلة سو
Dialogue: 0,1:16:54.30,1:16:57.05,نص عام,,0,0,0,,أنت لا تعرف شيئًا
Dialogue: 0,1:16:58.51,1:17:01.51,نص عام,,0,0,0,,من هذه اللحظة ممنوع عليك مغادرة هذا المكان
Dialogue: 0,1:17:13.52,1:17:14.73,نص عام,,0,0,0,,مات الأب
Dialogue: 0,1:17:15.53,1:17:18.20,نص عام,,0,0,0,,على يد مرتزق
Dialogue: 0,1:17:18.82,1:17:20.11,نص عام,,0,0,0,,سأجد
Dialogue: 0,1:17:21.37,1:17:23.33,نص عام,,0,0,0,,وسأقتلها
Dialogue: 0,1:17:26.20,1:17:27.25,نص عام,,0,0,0,,لا
Dialogue: 0,1:17:30.63,1:17:34.80,general text,,0,0,0,,يجب أن تجدها وتعيدها حية
Dialogue: 0,1:17:36.55,1:17:40.09,general text,,0,0,0,,ناك سو ما هو إلا روح في هذا الجسد
Dialogue: 0,1:17:40.18,1:17:43.30,نص عام,,0,0,0,,يجب أن أعرف لمن تعود هذه الجثة
Dialogue: 0,1:17:45.81,1:17:48.31,نص عام,,0,0,0,,أعيدوها بأي ثمن
Dialogue: 0,1:17:58.61,1:18:01.24,نص عام,,0,0,0,,مارس ناك سو كيمياء الأرواح
Dialogue: 0,1:18:01.32,1:18:03.57,نص عام,,0,0,0,,مع عائلة تشوي
Dialogue: 0,1:18:04.37,1:18:06.37,نص عام,,0,0,0,,لقد أمسكت بها بالفعل من قبل،
Dialogue: 0,1:18:06.45,1:18:08.00,النص العام,,0,0,0,,عندما قتل كل أهلها
Dialogue: 0,1:18:08.08,1:18:10.75,نص عام,,0,0,0,,فعرفت أن ناك سو لا يزال على قيد الحياة
Dialogue: 0,1:18:11.37,1:18:13.96,النص العام,,0,0,0,,كنت أبحث عنها طوال هذا الوقت،
Dialogue: 0,1:18:14.04,1:18:15.63,نص عام,,0,0,0,,لمسح اسمك
Dialogue: 0,1:18:15.71,1:18:16.88,نص عام,,0,0,0,,وهي ابنة
Dialogue: 0,1:18:16.96,1:18:19.38,general text,,0,0,0,,تشو تشون، قُتل على يد العائلات الرئيسية؟
Dialogue: 0,1:18:20.26,1:18:23.39,general text,,0,0,0,,ربما دخلت سوسنوفي بور للانتقام من والدها
Dialogue: 0,1:18:24.26,1:18:27.06,general text,,0,0,0,,أبقى ابن تشانغ جانج قريبًا منها، وهو يعرف من هي؟
Dialogue: 0,1:18:27.14,1:18:28.93,نص عام,,0,0,0,,لقد مات ولن نعرف ذلك
Dialogue: 0,1:18:29.02,1:18:32.60,general text,,0,0,0,,ولكن أتمنى أن تعاقب سوسنوفي بور على كل شيء
Dialogue: 0,1:18:37.15,1:18:38.69,نص عام,,0,0,0,,أين ناك سو؟
Dialogue: 0,1:18:38.78,1:18:41.28,general text,,0,0,0,,سحرة جيونبوغوان يبحثون عنها
Dialogue: 0,1:18:41.36,1:18:45.78,general text,,0,0,0,,بدأت بالجنون، وسرعان ما ستتحول إلى حجر وتموت
Dialogue: 0,1:19:03.05,1:19:04.09,ذكريات بخط مائل,,0,0,0,,مو دوك
Dialogue: 0,1:19:08.43,1:19:09.81,ذكريات,,0,0,0,,مو دوك
Dialogue: 0,1:19:13.85,1:19:14.98,ذكريات,,0,0,0,,شان ووك!
Dialogue: 0,1:19:35.08,1:19:39.05,نص عام,,0,0,0,,لا أستطيع الحداد، لا أستطيع دفنه
Dialogue: 0,1:19:39.63,1:19:41.84,نص عام,,0,0,0,,صحيح لأنه مجرم
Dialogue: 0,1:19:42.59,1:19:45.68,general text,,0,0,0,,كيف يمكن حرق جثته بهذه الطريقة؟
Dialogue: 0,1:19:48.14,1:19:49.89,نص عام,,0,0,0,,لا يمكنك فعل ذلك!
Dialogue: 0,1:19:50.47,1:19:52.18,نص عام,,0,0,0,,أوقفوهم...
Dialogue: 0,1:19:54.06,1:19:55.39,نص عام,,0,0,0,,سوسنوفي بور
Dialogue: 0,1:19:56.98,1:19:58.23,نص عام,,0,0,0,,ليس له صوت
Dialogue: 0,1:19:59.65,1:20:01.28,نص عام,,0,0,0,,في هذا السؤال
Dialogue: 0,1:20:03.28,1:20:04.45,نص عام,,0,0,0,,عذراً
Dialogue: 0,1:20:24.92,1:20:26.13,نص عام,,0,0,0,,سيد...
Dialogue: 0,1:21:27.57,1:21:29.91,نص عام,,0,0,0,,لماذا أنا هنا؟
Dialogue: 0,1:21:34.41,1:21:35.49,نص عام,,0,0,0,,على الأقل...
Dialogue: 0,1:21:39.42,1:21:42.25,نص عام,,0,0,0,,لم أعد أسمع صوت الأجراس
Dialogue: 0,1:21:47.92,1:21:50.34,نص عام,,0,0,0,,ناك سو سيذهب إلى قبر البدو
Dialogue: 0,1:21:51.14,1:21:54.26,نص عام,,0,0,0,,هناك سيلقى موته
Dialogue: 0,1:22:10.24,1:22:13.01,general text,,0,0,0,,ولدت تحت نجم الملك، قوة السماء تخضع لك
Dialogue: 0,1:22:14.49,1:22:17.62,general text,,0,0,0,,ليس هذا هو القدر الذي ستموت به،
Dialogue: 0,1:22:18.91,1:22:20.04,نص عام,,0,0,0,,تشانغ ووك
Dialogue: 0,1:22:47.90,1:22:49.07,نص عام,,0,0,0,,سيدي.

