Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter: {\c&HFFF4C5&} Ria_Lee, Tommo, Zero Amamiya
Dialogue: 0,0:00:43.53,0:00:45.95,mga inskripsiyon,,0,0,0,,Kami ay kumukuha ng mga katulong sa Sosnovy Bor
Dialogue: 0,0:00:46.03,0:00:47.49,pangkalahatang teksto,,0,0,0,,Hindi ito sulat
Dialogue: 0,0:00:48.54,0:00:49.75,pangkalahatang teksto,,0,0,0,,Ano ito kung gayon?
Dialogue: 0,0:00:49.83,0:00:52.83,pangkalahatang teksto,,0,0,0,,Kung ito ay naghahatid ng iyong damdamin, ito ay isang liham
Dialogue: 0,0:00:57.80,0:01:00.05,general text,,0,0,0,,Marahil ay nagmukha akong kaawa-awa sa aking mga pagtatangka
Dialogue: 0,0:01:00.84,0:01:02.38,pangkalahatang teksto,,0,0,0,,pumunta ka rito bilang isang utusan
Dialogue: 0,0:01:03.43,0:01:06.35,pangkalahatang teksto,,0,0,0,,Ikaw ay isang hindi kapani-paniwalang karanasang guro
Dialogue: 0,0:01:06.43,0:01:08.18,general text,,0,0,0,,Naaawa ako sa iyo
Dialogue: 0,0:01:09.18,0:01:11.60,general text,,0,0,0,,At least natuto ka ng loyalty\N at tumupad sa iyong mga tungkulin
Dialogue: 0,0:01:11.68,0:01:13.85,pangkalahatang teksto,,0,0,0,,Sinisikap ako ng aking guro nang husto
Dialogue: 0,0:01:13.94,0:01:17.19,pangkalahatang teksto,,0,0,0,,Akala ko dapat kong ibigay ang lahat
Dialogue: 0,0:01:19.44,0:01:20.86,general text,,0,0,0,,Na-stress ka ba nito?
Dialogue: 0,0:01:20.94,0:01:23.65,general text,,0,0,0,,Hindi naman. Pero nagduda ako
Dialogue: 0,0:01:24.49,0:01:29.29,pangkalahatang teksto,,0,0,0,,Sagutin ka bilang isang mag-aaral o bilang isang master
Dialogue: 0,0:01:29.87,0:01:32.54,pangkalahatang teksto,,0,0,0,,O sumagot sa istilo ng iyong nabasa
Dialogue: 0,0:01:33.66,0:01:35.33,general text,,0,0,0,,At ano ang nabasa mo?
Dialogue: 0,0:01:36.13,0:01:39.96,pangkalahatang text,,0,0,0,,Pagkatapos sagutin mo ang parehong?
Dialogue: 0,0:01:41.46,0:01:43.01,pangkalahatang teksto,,0,0,0,,Pareho? Ano ang pinagsasabi mo?
Dialogue: 0,0:01:44.05,0:01:45.26,pangkalahatang teksto,,0,0,0,,Nakasulat doon
Dialogue: 0,0:01:45.34,0:01:47.76,general text,,0,0,0,,"Dadaanan ko ang lahat para lang makita ka"
Dialogue: 0,0:01:48.39,0:01:51.64,general text,,0,0,0,,"Kaya kong gawin ang lahat, magkaroon lang ng pagkakataon na makita ka"
Dialogue: 0,0:01:52.31,0:01:53.81,general text,,0,0,0,,At ito ang sagot ko
Dialogue: 0,0:02:05.11,0:02:06.57,general text,,0,0,0,,Na-miss din kita
Dialogue: 0,0:02:10.45,0:02:11.79,general text,,0,0,0,,Ito ang sagot ko
Dialogue: 0,0:02:41.40,0:02:43.23,general text,,0,0,0,,Magpapanggap akong hindi ko ito narinig
Dialogue: 0,0:02:43.86,0:02:45.28,pangkalahatang teksto,,0,0,0,,At kalimutan ang tungkol sa sulat
Dialogue: 0,0:02:50.45,0:02:51.95,pangkalahatang teksto,,0,0,0,,Hindi mo maalis ang isang bagay,
Dialogue: 0,0:02:52.79,0:02:54.50,pangkalahatang text,,0,0,0,,kung naibahagi na sa isang tao
Dialogue: 0,0:02:57.00,0:02:58.33,pangkalahatang teksto,,0,0,0,,Maaari mong alisin ang
Dialogue: 0,0:03:01.04,0:03:02.63,pangkalahatang teksto,,0,0,0,,Maaaring sunugin,
Dialogue: 0,0:03:03.96,0:03:05.67,pangkalahatang text,,0,0,0,,parang hindi nangyari
Dialogue: 0,0:03:07.05,0:03:09.22,pangkalahatang teksto,,0,0,0,,Sa tingin mo susunugin mo ito at wala ang sulat?
Dialogue: 0,0:03:10.14,0:03:11.39,general text,,0,0,0,,Ngayon lang, teacher,
Dialogue: 0,0:03:12.14,0:03:13.47,pangkalahatang teksto,,0,0,0,,iyong estudyante
Dialogue: 0,0:03:14.22,0:03:16.77,pangkalahatang teksto,,0,0,0,,natutong makita kung ano ang hindi nakikita
Dialogue: 0,0:03:19.06,0:03:22.48,general text,,0,0,0,,Nabasa ko ang “Words of the Heart.” Gusto mo bang suriin?
Dialogue: 0,0:03:24.57,0:03:26.32,pangkalahatang teksto,,0,0,0,,Kailangan nating mag-concentrate,
Dialogue: 0,0:03:26.40,0:03:29.32,pangkalahatang teksto,,0,0,0,,upang basahin ang hindi mo nakikita
Dialogue: 0,0:03:30.70,0:03:31.82,pangkalahatang teksto,,0,0,0,,At pagkatapos...
Dialogue: 0,0:03:35.20,0:03:37.33,pangkalahatang text,,0,0,0,,sabihin ang pangalan ng addressee
Dialogue: 0,0:03:39.87,0:03:41.00,pangkalahatang text,,0,0,0,,Moo Dok
Dialogue: 0,0:03:42.71,0:03:44.67,offscreen,,0,0,0,,Malinaw ngunit mapanganib na signal
Dialogue: 0,0:03:45.42,0:03:48.30,voiceover,,0,0,0,,In love ako sa kanya
Dialogue: 0,0:03:51.59,0:03:52.97,general text,,0,0,0,,Well, ayan na. nabasa ko
Dialogue: 0,0:03:54.51,0:03:56.85,general text,,0,0,0,,May mahirap basahin dahil nakatago,
Dialogue: 0,0:03:56.93,0:03:58.06,pangkalahatang text,,0,0,0,,pero nandiyan
Dialogue: 0,0:04:03.31,0:04:06.19,general text,,0,0,0,,Nakita mo ang marka sa aking mga mata, nalaman mo na ako ay isang nomad,
Dialogue: 0,0:04:07.82,0:04:09.36,pangkalahatang text,,0,0,0,,nahuli ako
Dialogue: 0,0:04:11.24,0:04:13.16,general text,,0,0,0,,Ngayon nakita ko na ang isa ko pang kahinaan
Dialogue: 0,0:04:13.24,0:04:15.12,pangkalahatang teksto,,0,0,0,,Kung ito ang iyong kahinaan,
Dialogue: 0,0:04:15.99,0:04:17.33,pangkalahatang text,,0,0,0,,tapos sa akin din
Dialogue: 0,0:04:19.37,0:04:21.71,general text,,0,0,0,,Iyong sulat ang sagot ko
Dialogue: 0,0:04:21.79,0:04:23.46,pangkalahatang teksto,,0,0,0,,Kaya mayroon tayong isang kahinaan
Dialogue: 0,0:04:24.79,0:04:28.26,general text,,0,0,0,,I think I don't mind share your weakness
Dialogue: 0,0:04:30.76,0:04:33.18,general text,,0,0,0,,To be honest, nag-aalala ako
Dialogue: 0,0:04:33.84,0:04:35.89,pangkalahatang teksto,,0,0,0,,Nahanap mo na sa wakas ang gusto mo
Dialogue: 0,0:04:36.51,0:04:40.68,general text,,0,0,0,,At wala akong magawa kahit iwan mo ako
Dialogue: 0,0:04:41.35,0:04:44.94,general text,,0,0,0,,Naisipan ko pang lasonin ka
Dialogue: 0,0:04:45.02,0:04:46.77,pangkalahatang teksto,,0,0,0,,at humanap ng masisira
Dialogue: 0,0:04:48.19,0:04:49.32,pangkalahatang teksto,,0,0,0,,Chan Wook,
Dialogue: 0,0:04:50.74,0:04:53.28,general text,,0,0,0,,malamang nalason ka na
Dialogue: 0,0:04:54.91,0:04:55.99,pangkalahatang teksto,,0,0,0,,Nalason?
Dialogue: 0,0:04:56.07,0:04:58.20,pangkalahatang teksto,,0,0,0,,Ikaw ay manghihina at mahina
Dialogue: 0,0:04:58.70,0:05:01.25,pangkalahatang teksto,,0,0,0,,Walang takas mula sa lason na ito
Dialogue: 0,0:05:02.21,0:05:04.33,general text,,0,0,0,,Ang panlunas ay ang taong lumason sa iyo
Dialogue: 0,0:05:04.42,0:05:07.00,general text,,0,0,0,,So, na-miss kita dahil,
Dialogue: 0,0:05:07.88,0:05:09.55,pangkalahatang teksto,,0,0,0,,ano ang nalason?
Dialogue: 0,0:05:10.46,0:05:11.55,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:05:12.17,0:05:14.64,pangkalahatang teksto,,0,0,0,,Wala kang awang nilason ng isang shadow warrior
Dialogue: 0,0:05:15.26,0:05:16.60,pangkalahatang teksto,,0,0,0,,Mag-isip sa ganitong paraan
Dialogue: 0,0:05:17.72,0:05:19.35,pangkalahatang teksto,,0,0,0,,Hindi ito malayo sa katotohanan
Dialogue: 0,0:05:20.68,0:05:22.06,pangkalahatang teksto,,0,0,0,,So ito ay lason?
Dialogue: 0,0:05:23.64,0:05:26.44,pangkalahatang teksto,,0,0,0,,Oo, kakaiba na sa lahat
Dialogue: 0,0:05:27.82,0:05:28.86,general text,,0,0,0,,Namiss kita
Dialogue: 0,0:05:29.94,0:05:32.28,general text,,0,0,0,,Palagi mo akong pinagbantaan na papatayin
Dialogue: 0,0:05:32.36,0:05:34.15,general text,,0,0,0,,Binato pa niya ako ng kutsilyo
Dialogue: 0,0:05:34.24,0:05:36.62,general text,,0,0,0,,Tinawanan niya ako, halos mawalan ako ng braso.
Dialogue: 0,0:05:36.70,0:05:38.41,pangkalahatang teksto,,0,0,0,,At mayroon kang lakas ng loob na magsinungaling
Dialogue: 0,0:05:38.99,0:05:40.74,general text,,0,0,0,,Naging malupit ka sa akin,
Dialogue: 0,0:05:40.83,0:05:43.00,general text,,0,0,0,,pero hindi ko maiwasang isipin ka
Dialogue: 0,0:05:43.08,0:05:44.96,general text,,0,0,0,,Buksan mo ang aking mga mata - miss na kita
Dialogue: 0,0:05:45.04,0:05:48.54,general text,,0,0,0,,Miss kita buong araw, kahit matulog na ako
Dialogue: 0,0:05:48.63,0:05:50.00,general text,,0,0,0,,- Stop\N- Bakit?
Dialogue: 0,0:05:50.09,0:05:52.46,general text,,0,0,0,,Ipinagtapat ko ang aking nararamdaman, at inihambing mo ang mga ito sa lason
Dialogue: 0,0:05:52.55,0:05:55.43,pangkalahatang teksto,,0,0,0,,Kaya pakinggan mo man lang kung ano ang aking mga sintomas
Dialogue: 0,0:05:55.51,0:05:57.01,general text,,0,0,0,,Ikaw ang aking panlaban
Dialogue: 0,0:05:58.35,0:06:02.98,general text,,0,0,0,,sabi ko lang na miss na kita, grabeng shadow warrior
Dialogue: 0,0:06:03.06,0:06:04.56,pangkalahatang text,,0,0,0,,At sasabihin mong nalason ako
Dialogue: 0,0:06:04.64,0:06:07.19,pangkalahatang teksto,,0,0,0,, Ngayon tiisin ang aking mga reklamo tungkol sa mga sintomas
Dialogue: 0,0:06:07.27,0:06:08.56,general text,,0,0,0,,Nalason ako, kung tutuusin
Dialogue: 0,0:06:08.65,0:06:11.02,general text,,0,0,0,,Wala akong dapat ikahiya
Dialogue: 0,0:06:11.11,0:06:13.90,pangkalahatang teksto,,0,0,0,,Dahil isa kang antidote, ibig sabihin ay may kaugnayan ka sa pagkalason
Dialogue: 0,0:06:26.75,0:06:30.25,pangkalahatang teksto,,0,0,0,,Pamangkin ito ng pinuno ng Sosnovy Bor
Dialogue: 0,0:06:30.34,0:06:33.55,pangkalahatang teksto,,0,0,0,,at ang susunod nating kabanata
Dialogue: 0,0:06:38.22,0:06:41.72,pangkalahatang teksto,,0,0,0,,Pumunta ako upang batiin ka sa ngalan ng pinuno
Dialogue: 0,0:06:42.51,0:06:44.60,pangkalahatang teksto,,0,0,0,,Binabati kita sa pagsali sa Sosnovy Bor
Dialogue: 0,0:06:45.68,0:06:46.69,pangkalahatang teksto,,0,0,0,,Magaling
Dialogue: 0,0:06:48.98,0:06:52.36,pangkalahatang text,,0,0,0,,Maganda ang ginawa mo ngayon
Dialogue: 0,0:06:52.90,0:06:56.74,pangkalahatang teksto,,0,0,0,,Ngayon ay bibigyan ka ng alak at karne
Dialogue: 0,0:06:57.49,0:06:58.86,pangkalahatang text,,0,0,0,,Maaari kang magsaya
Dialogue: 0,0:07:00.57,0:07:02.70,pangkalahatang teksto,,0,0,0,,Pumunta, kumain, uminom
Dialogue: 0,0:07:04.08,0:07:05.54,pangkalahatang text,,0,0,0,,Sundan mo ako
Dialogue: 0,0:07:08.46,0:07:09.33,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,0:07:10.17,0:07:12.34,general text,,0,0,0,,familiar ka ba kay Moo Deok?
Dialogue: 0,0:07:12.42,0:07:14.25,general text,,0,0,0,,Nakapasa siya sa pagsusulit ngayon
Dialogue: 0,0:07:15.34,0:07:18.26,pangkalahatang teksto,,0,0,0,,Ang lingkod na huling dumating
Dialogue: 0,0:07:20.05,0:07:23.01,mga inskripsiyon,,0,0,0,,Isang daan dalawampu't lima
Dialogue: 0,0:07:38.90,0:07:40.78,mga alaala,,0,0,0,,Number 125, Moo Deok
Dialogue: 0,0:07:43.20,0:07:44.53,mga alaala,,0,0,0,,Nakapasa!
Dialogue: 0,0:07:53.46,0:07:55.55,pangkalahatang text,,0,0,0,,Kilala ko si Mu Dok
Dialogue: 0,0:07:56.63,0:07:59.34,general text,,0,0,0,,Nawalan siya ng malay at dinala sa Sejukwon
Dialogue: 0,0:07:59.42,0:08:01.89,general text,,0,0,0,,Kailangan kong ibalik ang mga gamit niya
Dialogue: 0,0:08:03.39,0:08:06.85,pangkalahatang teksto,,0,0,0,,at ibigay ang anting-anting upang makapasok
Dialogue: 0,0:08:07.43,0:08:09.52,general text,,0,0,0,,Nasa Saejukwon pa rin ba siya?
Dialogue: 0,0:08:10.52,0:08:12.40,general text,,0,0,0,,Ibigay mo sa akin. ipapasa ko
Dialogue: 0,0:08:13.40,0:08:14.82,pangkalahatang teksto,,0,0,0,,Maganda ang ginawa mo ngayon
Dialogue: 0,0:08:20.61,0:08:22.20,general text,,0,0,0,,Let's go
Dialogue: 0,0:08:46.97,0:08:48.18,mga alaala,,0,0,0,,Mu Dok...
Dialogue: 0,0:09:08.41,0:09:11.96,mga alaala,,0,0,0,,Naliligaw ka kasi sa isip mo
Dialogue: 0,0:09:12.04,0:09:14.46,mga alaala,,0,0,0,,masyadong maraming iniisip
Dialogue: 0,0:09:15.63,0:09:18.17,mga alaala,,0,0,0,,Kapag nangyari ito, isipin ang isang bagay
Dialogue: 0,0:09:19.80,0:09:23.68,voiceover,,0,0,0,,Nak Soo, ang iniisip mo lang ay si Chan Wook
Dialogue: 0,0:09:39.15,0:09:40.23,pangkalahatang teksto,,0,0,0,,Makinig, Yul
Dialogue: 0,0:09:41.03,0:09:43.82,general text,,0,0,0,,Napatingin ako sa bag ni Moo Deok.
Dialogue: 0,0:09:45.32,0:09:48.20,pangkalahatang teksto,,0,0,0,,at may nakitang kakaiba
Dialogue: 0,0:09:50.04,0:09:52.75,general text,,0,0,0,,Ito ang sipol mo, di ba?
Dialogue: 0,0:09:53.66,0:09:55.29,pangkalahatang teksto,,0,0,0,,Na nawala mo sa Danhyangok
Dialogue: 0,0:09:56.88,0:09:58.38,pangkalahatang teksto,,0,0,0,,Oo, akin
Dialogue: 0,0:09:59.17,0:10:01.55,general text,,0,0,0,,Kung gayon bakit mayroon nito si Moo Dok?
Dialogue: 0,0:10:14.18,0:10:16.06,general text,,0,0,0,,Nakita mo na ba si Mr. Dan Gu?
Dialogue: 0,0:10:16.69,0:10:19.23,pangkalahatang teksto,,0,0,0,,Nasa kanya ang aking mga gamit at isang anting-anting para sa pagpasok
Dialogue: 0,0:10:23.74,0:10:25.32,general text,,0,0,0,,Ibinigay niya sa akin
Dialogue: 0,0:10:25.90,0:10:26.74,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:10:27.36,0:10:28.70,pangkalahatang text,,0,0,0,,Kukunin ko
Dialogue: 0,0:10:37.92,0:10:41.80,general text,,0,0,0,,Nawala ko siya sa Danhyangok. Nahanap mo ba siya doon?
Dialogue: 0,0:10:44.92,0:10:46.05,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:10:46.55,0:10:49.47,general text,,0,0,0,,Kinuha ko kasi...
Dialogue: 0,0:10:52.72,0:10:54.47,general text,,0,0,0,,In love with me
Dialogue: 0,0:10:57.85,0:10:59.77,general text,,0,0,0,,Ikaw na mismo ang nagsabi
Dialogue: 0,0:11:01.27,0:11:03.48,pangkalahatang teksto,,0,0,0,,Sapat na ang paliwanag na ito
Dialogue: 0,0:11:09.87,0:11:11.49,general text,,0,0,0,,Kukunin ko ang mga gamit ko,
Dialogue: 0,0:11:12.12,0:11:13.54,pangkalahatang teksto,,0,0,0,,at sipol ka
Dialogue: 0,0:11:18.21,0:11:21.21,general text,,0,0,0,,Sinabi ko kay Dan Gu na ibinigay ko ito sa iyo
Dialogue: 0,0:11:22.54,0:11:23.96,pangkalahatang text,,0,0,0,,Hindi na maibabalik
Dialogue: 0,0:11:26.59,0:11:28.26,general text,,0,0,0,,Bakit mo binibigay sa akin?
Dialogue: 0,0:11:28.34,0:11:30.93,general text,,0,0,0,,Hindi ka naniwala noong ipinagtapat ko ang aking pag-ibig
Dialogue: 0,0:11:32.51,0:11:34.64,pangkalahatang teksto,,0,0,0,,Kung gayon kailangan mo akong paniwalaan
Dialogue: 0,0:11:42.19,0:11:46.32,general text,,0,0,0,, pinagtatawanan ko lang sila
Dialogue: 0,0:11:46.90,0:11:49.61,general text,,0,0,0,,At mahal na mahal ni Moo Dok si Yulia
Dialogue: 0,0:11:50.20,0:11:52.20,pangkalahatang teksto,,0,0,0,,At isinasaalang-alang ang regalo ni Julia,
Dialogue: 0,0:11:52.28,0:11:54.78,general text,,0,0,0,,I think he's also breathing unevenly towards her
Dialogue: 0,0:11:55.70,0:11:57.83,general text,,0,0,0,,Malamang hiniling niya ang whistle na ito
Dialogue: 0,0:11:58.41,0:11:59.92,pangkalahatang teksto,,0,0,0,,Kapag may kailangan siya,
Dialogue: 0,0:12:00.00,0:12:02.00,pangkalahatang teksto,,0,0,0,,nagsisinungaling siya at madaling umiwas
Dialogue: 0,0:12:03.34,0:12:06.71,general text,,0,0,0,,Alam pa ni Yul ang pagsali niya sa exam
Dialogue: 0,0:12:06.80,0:12:09.30,general text,,0,0,0,,Sinagot niya ang lahat ng tanong para sa kanyang kapakanan
Dialogue: 0,0:12:09.38,0:12:12.43,general text,,0,0,0,,Tiyak na hiniling niya sa kanya na tumulong,
Dialogue: 0,0:12:12.51,0:12:14.68,general text,,0,0,0,,dahil masyado akong tanga sa sarili ko
Dialogue: 0,0:12:15.89,0:12:17.43,pangkalahatang teksto,,0,0,0,,Lagi niyang nakukuha ang gusto niya
Dialogue: 0,0:12:18.48,0:12:19.81,pangkalahatang teksto,,0,0,0,,Higit sa lahat,
Dialogue: 0,0:12:20.73,0:12:24.36,general text,,0,0,0,,Nakita ko silang naglalakad na magkasama
Dialogue: 0,0:12:24.98,0:12:26.15,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:12:27.15,0:12:28.19,pangkalahatang teksto,,0,0,0,,Maganda?
Dialogue: 0,0:12:34.53,0:12:38.04,italics,,0,0,0,,Moo Deok at Yul minsan nagkita
Dialogue: 0,0:12:38.12,0:12:42.08,general text,,0,0,0,,Sa tingin ko hindi mo alam dahil nakakulong ka sa training room
Dialogue: 0,0:12:42.62,0:12:43.58,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:12:47.75,0:12:50.01,general text,,0,0,0,,Oo, hindi ko alam
Dialogue: 0,0:13:16.12,0:13:17.74,pangkalahatang teksto,,0,0,0,,Paano kung totoo ito?
Dialogue: 0,0:13:18.33,0:13:19.45,memories italics,,0,0,0,,I missed you too
Dialogue: 0,0:13:19.54,0:13:20.66,mga alaala,,0,0,0,,Ito ang sagot ko
Dialogue: 0,0:13:31.13,0:13:33.34,general text,,0,0,0,,Tumanggi siya dahil hindi niya ako gusto
Dialogue: 0,0:13:34.30,0:13:36.18,general text,,0,0,0,,Hindi niya siya na-miss gaya ko
Dialogue: 0,0:13:38.22,0:13:40.06,general text,,0,0,0,,Na-miss lang kita
Dialogue: 0,0:13:46.06,0:13:47.11,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,0:13:47.73,0:13:50.36,general text,,0,0,0,,Gusto kong uminom ng lason at mamatay
Dialogue: 0,0:13:58.41,0:13:59.70,pangkalahatang teksto,,0,0,0,,Nakakahiya
Dialogue: 0,0:14:12.55,0:14:13.88,pangkalahatang text,,0,0,0,,Gusto kita
Dialogue: 0,0:14:14.59,0:14:17.34,pangkalahatang teksto,,0,0,0,,Sinabi ko na ito sa iyo nang daan-daang beses
Dialogue: 0,0:14:23.73,0:14:25.35,general text,,0,0,0,,Wala akong masyadong alam sa love,
Dialogue: 0,0:14:26.60,0:14:30.02,general text,,0,0,0,,pero pag may gusto ka sa isang tao, hindi mo na uulitin.
Dialogue: 0,0:14:32.03,0:14:34.11,general text,,0,0,0,,Dahil mahirap umamin kahit isang beses
Dialogue: 0,0:14:39.66,0:14:41.08,pangkalahatang teksto,,0,0,0,,Itong sipol
Dialogue: 0,0:14:42.74,0:14:46.04,pangkalahatang teksto,,0,0,0,,pag-aari ng isang kaibigan na hindi ko kailanman maamin
Dialogue: 0,0:14:54.42,0:14:56.05,general text,,0,0,0,,gusto talaga kita
Dialogue: 0,0:15:05.31,0:15:08.60,general text,,0,0,0,,Gusto ko talagang sabihin sa kanya ang tungkol dito
Dialogue: 0,0:15:14.03,0:15:15.69,memories italics,,0,0,0,,Gusto ko rin subukan
Dialogue: 0,0:15:16.61,0:15:18.45,memories,,0,0,0,,Pwede ba?
Dialogue: 0,0:15:56.28,0:15:59.70,general text,,0,0,0,,Pumasok ka na ngayon sa Sosnovy Bor. Mas madalas tayong magkikita
Dialogue: 0,0:16:02.49,0:16:04.66,general text,,0,0,0,,Pwede kang lumapit sa akin kung may kailangan ka
Dialogue: 0,0:16:09.83,0:16:11.46,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:16:39.74,0:16:42.16,general text,,0,0,0,,Chan Wook read “Words of the Heart”
Dialogue: 0,0:16:43.36,0:16:45.03,general text,,0,0,0,,Tinulungan mo siya diba?
Dialogue: 0,0:16:46.16,0:16:49.37,general text,,0,0,0,,Nalaman kong kaya niya kaya pumunta ako para sabihin sayo
Dialogue: 0,0:16:50.25,0:16:54.54,pangkalahatang teksto,,0,0,0,,Sabihan si Jin na ihatid ang aklat na ito kay Jinyeowon
Dialogue: 0,0:16:55.88,0:16:57.05,pangkalahatang teksto,,0,0,0,,Bone
Dialogue: 0,0:16:57.80,0:16:58.63,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:16:59.76,0:17:02.76,general text,,0,0,0,,Nagalit si Chan Wook na binabasa ng lahat ang "liham" na ito
Dialogue: 0,0:17:03.34,0:17:06.97,pangkalahatang text,,0,0,0,,Palagay ko ganoon din ang mararamdaman ni Master Seo Kyung
Dialogue: 0,0:17:07.06,0:17:10.27,general text,,0,0,0,,Mukhang gusto mo talaga si Chan Wook
Dialogue: 0,0:17:11.64,0:17:14.81,general text,,0,0,0,,Special siya kaya pinapanood ko siya
Dialogue: 0,0:17:14.90,0:17:16.86,general text,,0,0,0,,Napakatalino niya,
Dialogue: 0,0:17:16.94,0:17:20.36,general text,,0,0,0,,pero gusto siyang ikulong ni Jin dito
Dialogue: 0,0:17:23.45,0:17:24.99,mga alaala,,0,0,0,,Sigurado ka ba,
Dialogue: 0,0:17:25.62,0:17:27.78,mga alaala,,0,0,0,,na ang batong yelo ay wala sa Sosnovy Bor?
Dialogue: 0,0:17:28.79,0:17:30.54,memories,,0,0,0,,Bakit mo naisipan yan?
Dialogue: 0,0:17:31.29,0:17:32.66,mga alaala,,0,0,0,,20 taon na ang nakakaraan
Dialogue: 0,0:17:33.62,0:17:36.04,mga alaala,,0,0,0,,Gwangju Chang Gang pinagkadalubhasaan ang alchemy ng mga kaluluwa
Dialogue: 0,0:17:38.00,0:17:39.30,mga alaala,,0,0,0,,Dahil dito
Dialogue: 0,0:17:39.38,0:17:42.01,mga alaala,,0,0,0,,isinilang ang isang bata na hindi dapat magkaroon
Dialogue: 0,0:17:43.01,0:17:46.47,mga alaala,,0,0,0,,At noong gabing iyon ang bituin ng Hari ay nagningning sa kalangitan
Dialogue: 0,0:17:47.51,0:17:49.26,memories,,0,0,0,,Si Chan Wook ba ito?
Dialogue: 0,0:17:50.10,0:17:51.22,mga alaala,,0,0,0,,Oo
Dialogue: 0,0:17:51.31,0:17:55.69,mga alaala,,0,0,0,,Binakasan ng salamangkero ang bato sa Sosnovy Bor
Dialogue: 0,0:17:56.44,0:17:59.61,mga alaala,,0,0,0,,at sa pamamagitan ng alchemy of souls ipinanganak ang anak ng hari
Dialogue: 0,0:18:01.86,0:18:05.82,mga alaala,,0,0,0,,Alam ito ni Jin Moo mula kay Jeonbugwan
Dialogue: 0,0:18:07.70,0:18:11.16,mga alaala,,0,0,0,,Kung nasa kanila na ang bato, anong dahilan
Dialogue: 0,0:18:11.83,0:18:14.04,mga alaala,,0,0,0,,imbento ng Pine Forest,
Dialogue: 0,0:18:16.17,0:18:17.83,mga alaala,,0,0,0,,para kunin siya?
Dialogue: 0,0:18:23.46,0:18:27.39,general text,,0,0,0,,Walang ibang paraan si Jin para protektahan ang Pine Forest maliban sa itago si Uka
Dialogue: 0,0:18:28.05,0:18:28.89,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:18:28.97,0:18:32.72,general text,,0,0,0,,May hindi ba ako alam?
Dialogue: 0,0:18:42.03,0:18:43.23,pangkalahatang teksto,,0,0,0,,Oh, ang liit mo...
Dialogue: 0,0:18:43.32,0:18:47.45,pangkalahatang teksto,,0,0,0,,Paano ka pa magtitiwala sa gayong pabaya at walang ingat na kabataan sa mga sikreto?!
Dialogue: 0,0:18:48.74,0:18:50.58,pangkalahatang teksto,,0,0,0,,Paano mo...
Dialogue: 0,0:18:51.91,0:18:53.62,pangkalahatang text,,0,0,0,,Sana mawala ito
Dialogue: 0,0:18:57.00,0:18:58.42,general text,,0,0,0,,Siya ay...
Dialogue: 0,0:18:58.50,0:19:00.79,general text,,0,0,0,,hindi nagalit, kahit sinabi kong meron pa
Dialogue: 0,0:19:00.88,0:19:02.50,general text,,0,0,0,,Hindi ako iinom ng chastity tea
Dialogue: 0,0:19:05.09,0:19:08.93,general text,,0,0,0,,Teka, regalo ng maid Kim yung scarf
Dialogue: 0,0:19:29.70,0:19:32.20,pangkalahatang teksto,,0,0,0,,Dapat makumpleto ang paglilinis bago
Dialogue: 0,0:19:32.28,0:19:34.62,pangkalahatang teksto,,0,0,0,,kung paano sisimulan ng mga salamangkero ang kanilang mga klase. Mas mabilis
Dialogue: 0,0:19:34.70,0:19:35.54,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:19:56.64,0:19:57.93,general text,,0,0,0,,Nasaan ang may-ari?
Dialogue: 0,0:19:58.02,0:20:00.06,general text,,0,0,0,,- Hindi siya darating?\N- Well...
Dialogue: 0,0:20:00.14,0:20:01.40,general text,,0,0,0,,pumunta ako para gisingin siya,
Dialogue: 0,0:20:01.48,0:20:03.73,general text,,0,0,0,,pero hindi daw siya nakatulog ng isang kindat kagabi
Dialogue: 0,0:20:03.82,0:20:06.07,general text,,0,0,0,,At lalaktawan niya? Sa unang araw?
Dialogue: 0,0:20:07.90,0:20:09.15,pangkalahatang teksto,,0,0,0,,Magkita tayo, Moo Deok
Dialogue: 0,0:20:26.92,0:20:28.01,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:20:28.09,0:20:29.55,pangkalahatang teksto,,0,0,0,,Kailangan na nating bumangon
Dialogue: 0,0:20:31.26,0:20:32.43,pangkalahatang teksto,,0,0,0,,Guro!
Dialogue: 0,0:20:36.14,0:20:37.52,pangkalahatang text,,0,0,0,,Gumising
Dialogue: 0,0:20:37.60,0:20:39.02,pangkalahatang text,,0,0,0,,Kung hindi, sasampalin kita
Dialogue: 0,0:20:39.10,0:20:40.27,pangkalahatang teksto,,0,0,0,,Bumangon ka!
Dialogue: 0,0:20:49.53,0:20:51.82,general text,,0,0,0,,Huwag kang maingay at umalis, matutulog ako
Dialogue: 0,0:20:54.20,0:20:56.66,general text,,0,0,0,,Nababaliw ka na ba? Gusto mo ba ng kamatayan?
Dialogue: 0,0:20:59.37,0:21:01.04,general text,,0,0,0,,Oo, baliw ako at gusto kong mamatay
Dialogue: 0,0:21:01.75,0:21:03.75,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari sa iyo?
Dialogue: 0,0:21:03.83,0:21:06.38,general text,,0,0,0,,Ito ang mga sintomas ng aking pagkalason
Dialogue: 0,0:21:07.71,0:21:10.67,general text,,0,0,0,,Chan Wook, itigil ang pagiging matigas ang ulo at galit
Dialogue: 0,0:21:13.13,0:21:14.72,general text,,0,0,0,,Sinabi ko na ako ang antidote
Dialogue: 0,0:21:16.22,0:21:17.05,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:21:18.14,0:21:20.10,pangkalahatang teksto,,0,0,0,,Narito ako
Dialogue: 0,0:21:31.57,0:21:32.82,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:21:47.29,0:21:48.34,pangkalahatang teksto,,0,0,0,,Hey, Chan Wook
Dialogue: 0,0:21:49.30,0:21:52.09,general text,,0,0,0,,Narinig kong binasa mo ang “Words of the Heart.” nagulat ako
Dialogue: 0,0:21:52.17,0:21:53.84,pangkalahatang teksto,,0,0,0,,Walang dapat ipagtaka
Dialogue: 0,0:21:53.93,0:21:56.26,pangkalahatang teksto,,0,0,0,,Nakikita kong nagbabasa ka tungkol sa pamamaraan ng Hyonggon
Dialogue: 0,0:21:56.34,0:21:58.55,pangkalahatang teksto,,0,0,0,,Nakabisado ko ang istilong ito ng espada noong bata pa ako
Dialogue: 0,0:21:59.68,0:22:02.02,pangkalahatang teksto,,0,0,0,,Kung magtuturo kang magbasa ng "Words of the Heart",
Dialogue: 0,0:22:02.10,0:22:03.81,pangkalahatang text,,0,0,0,,Tutulungan kita master Hyonggon
Dialogue: 0,0:22:06.52,0:22:07.36,pangkalahatang teksto,,0,0,0,,Kailangan nating mag-isip
Dialogue: 0,0:22:09.94,0:22:12.07,italics,,0,0,0,,Sang-ayon. Sabihin mong pumayag ka
Dialogue: 0,0:22:13.74,0:22:16.16,general text,,0,0,0,,Makinig, pagod na ako sa isang bagay
Dialogue: 0,0:22:17.45,0:22:20.49,pangkalahatang teksto,,0,0,0,,Humingi ng tulong kay Master Li
Dialogue: 0,0:22:29.34,0:22:30.38,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:22:31.09,0:22:33.55,pangkalahatang teksto,,0,0,0,,Nakabisado ko si Ryusu sa halos parehong oras tulad mo
Dialogue: 0,0:22:34.17,0:22:37.05,general text,,0,0,0,,Gusto mo ba akong awayin?
Dialogue: 0,0:22:37.13,0:22:39.43,general text,,0,0,0,,Pagkatapos ay ipapahiram ko sa iyo ang sapphire carpet
Dialogue: 0,0:22:39.51,0:22:41.47,pangkalahatang teksto,,0,0,0,,para sa pagsasanay
Dialogue: 0,0:22:42.52,0:22:45.23,pangkalahatang teksto,,0,0,0,,Sa tulong nito, madodoble ang enerhiya
Dialogue: 0,0:22:45.31,0:22:48.60,pangkalahatang text,,0,0,0,,Sapphire carpet? Ito ay isang pambihira
Dialogue: 0,0:22:50.02,0:22:51.90,pangkalahatang teksto,,0,0,0,,Guro, ito ay isang magandang pagkakataon
Dialogue: 0,0:22:54.24,0:22:56.57,general text,,0,0,0,,Pero malamig ang ganyang carpet, di ba?
Dialogue: 0,0:22:57.36,0:22:59.28,general text,,0,0,0,,Mabilis akong magkasakit
Dialogue: 0,0:23:00.37,0:23:02.41,pangkalahatang teksto,,0,0,0,,Kaya hindi ko kailangan ito
Dialogue: 0,0:23:10.54,0:23:11.84,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:23:13.21,0:23:16.84,general text,,0,0,0,,Hindi ako nakatulog ng maayos nitong mga araw na ito, iidlip ako
Dialogue: 0,0:23:18.59,0:23:21.72,pangkalahatang teksto,,0,0,0,,Nalampasan ang pagkakataong makabisado si Hyonggon
Dialogue: 0,0:23:21.80,0:23:22.81,general text,,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:23:22.89,0:23:25.64,pangkalahatang teksto,,0,0,0,,At kahapon. Ang sapphire carpet ay mahirap makuha,
Dialogue: 0,0:23:25.73,0:23:27.14,general text,,0,0,0,,at sabi mo malamig siya
Dialogue: 0,0:23:27.23,0:23:29.77,pangkalahatang teksto,,0,0,0,,Kailangan kong pumayag kahit na mamatay ako dito
Dialogue: 0,0:23:29.85,0:23:32.48,pangkalahatang teksto,,0,0,0,,Hindi kapani-paniwala. "Baliw. Mamatay"
Dialogue: 0,0:23:32.57,0:23:34.40,general text,,0,0,0,,Iyon lang ang sasabihin mo sa akin
Dialogue: 0,0:23:36.28,0:23:37.70,pangkalahatang teksto,,0,0,0,,Ibigay dito
Dialogue: 0,0:23:47.83,0:23:48.75,pangkalahatang teksto,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:23:48.83,0:23:50.37,pangkalahatang text,,0,0,0,,Hindi ka magkasya dito nang magkasama
Dialogue: 0,0:23:51.29,0:23:53.13,general text,,0,0,0,,Matutulog ka lang kung bumangon ako
Dialogue: 0,0:23:56.80,0:23:57.97,pangkalahatang teksto,,0,0,0,,Bumangon
Dialogue: 0,0:23:59.05,0:24:00.22,pangkalahatang teksto,,0,0,0,,At gumawa ka
Dialogue: 0,0:24:00.30,0:24:03.18,pangkalahatang teksto,,0,0,0,,Hindi ito magiging mahirap
Dialogue: 0,0:24:17.28,0:24:19.07,general text,,0,0,0,,sabi ko na-miss kita,
Dialogue: 0,0:24:19.15,0:24:22.74,general text,,0,0,0,,at sinabi mong nalason ako, kaya kailangan kong matulog at bumalik sa aking katinuan
Dialogue: 0,0:24:22.82,0:24:24.83,pangkalahatang text,,0,0,0,,Tigilan mo ako sa panggugulo, kahit saglit lang
Dialogue: 0,0:24:28.95,0:24:31.62,general text,,0,0,0,,Gusto mo lang magalit ako
Dialogue: 0,0:24:33.00,0:24:35.09,general text,,0,0,0,,Sabi ko sayo, pag namatay ako, mamamatay ka rin
Dialogue: 0,0:24:35.88,0:24:38.63,pangkalahatang text,,0,0,0,,Nahihirapan ako, dapat may nararamdaman ka rin
Dialogue: 0,0:24:38.71,0:24:41.88,general text,,0,0,0,,Pag natutulog ako, may cramps pa ako
Dialogue: 0,0:24:48.35,0:24:49.81,pangkalahatang teksto,,0,0,0,,At hanggang kailan?
Dialogue: 0,0:24:51.02,0:24:51.85,general text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:24:52.48,0:24:54.11,pangkalahatang teksto,,0,0,0,,Ano? Nakakainis?
Dialogue: 0,0:24:54.73,0:24:56.40,pangkalahatang teksto,,0,0,0,,Pagkatapos ay tulungan mo akong gawing mas komportable ang aking sarili
Dialogue: 0,0:25:05.62,0:25:09.54,pangkalahatang text,,0,0,0,,Patuloy na natutulog ang may-ari
Dialogue: 0,0:25:09.62,0:25:12.08,general text,,0,0,0,,Sabihin sa kanya na magsanay
Dialogue: 0,0:25:12.16,0:25:14.04,pangkalahatang teksto,,0,0,0,,Mages ng Jeonjingak tren sa kalooban
Dialogue: 0,0:25:14.13,0:25:17.21,pangkalahatang teksto,,0,0,0,,Nakakabisado ng bawat tao ang kanyang enerhiya nang iba
Dialogue: 0,0:25:17.29,0:25:19.67,general text,,0,0,0,,Hindi ako makikialam basta hindi siya lumalabag sa rules
Dialogue: 0,0:25:21.09,0:25:22.01,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,0:25:22.09,0:25:24.47,pangkalahatang text,,0,0,0,,Huwag mag-alala. Heto siya
Dialogue: 0,0:25:30.47,0:25:33.14,general text,,0,0,0,,Sakit ng ulo ko,
Dialogue: 0,0:25:33.23,0:25:34.52,general text,,0,0,0,,Uuwi na ako
Dialogue: 0,0:25:34.60,0:25:37.11,pangkalahatang teksto,,0,0,0,,at ako ay matauhan, magbabad sa tubig
Dialogue: 0,0:25:39.32,0:25:41.65,general text,,0,0,0,,Masakit ba ang ulo mo? Wala kang ginawa
Dialogue: 0,0:25:42.24,0:25:45.24,general text,,0,0,0,,At hindi ka makakauwi. Hindi ito ayon sa mga patakaran
Dialogue: 0,0:25:45.32,0:25:46.41,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:25:46.49,0:25:49.16,pangkalahatang text,,0,0,0,,Chan Wook exception. Siya ay may pahintulot ng ulo
Dialogue: 0,0:25:49.74,0:25:50.70,general text,,0,0,0,,Bakit siya?
Dialogue: 0,0:25:50.79,0:25:53.79,pangkalahatang teksto,,0,0,0,,Abala sa lahat ng uri ng libangan, wala kang oras para doon,
Dialogue: 0,0:25:53.87,0:25:56.79,general text,,0,0,0,,pero nakipag deal ako sa ulo habang nakakulong ako dito
Dialogue: 0,0:25:59.59,0:26:00.59,pangkalahatang text,,0,0,0,,Babalik ako kaagad
Dialogue: 0,0:26:05.05,0:26:06.59,general text,,0,0,0,,Sasamahan ko siya
Dialogue: 0,0:26:08.05,0:26:09.97,general text,,0,0,0,,Kung aalis ka, mapapaalis ka dito
Dialogue: 0,0:26:10.06,0:26:13.35,general text,,0,0,0,,Sinisikap mong makapunta dito. Handa ka na bang umalis?
Dialogue: 0,0:26:23.99,0:26:26.07,general text,,0,0,0,,Umuwi si Chan Wook
Dialogue: 0,0:26:26.16,0:26:27.66,general text,,0,0,0,,Sigurado ka bang tama ito?
Dialogue: 0,0:26:27.74,0:26:31.08,general text,,0,0,0,,Hayaan mo siya kung saan niya gusto
Dialogue: 0,0:26:32.79,0:26:34.50,general text,,0,0,0,,Tapos siya ay magiging tamad
Dialogue: 0,0:26:35.12,0:26:36.00,italics,,0,0,0,,Kabanata
Dialogue: 0,0:26:39.96,0:26:42.46,pangkalahatang teksto,,0,0,0,,Hinihiling ka ng ginang na maghintay ng kaunti
Dialogue: 0,0:26:43.30,0:26:46.22,general text,,0,0,0,,May host ba siya?
Dialogue: 0,0:26:52.39,0:26:55.14,general text,,0,0,0,,Nakita ko ang katulong ni Jeonbugwan papunta dito
Dialogue: 0,0:26:55.23,0:26:58.31,general text,,0,0,0,,Baka nandito si Deputy Jin Mu?
Dialogue: 0,0:26:58.40,0:27:02.98,general text,,0,0,0,,Hindi sila close para makita ang isa't isa ng ganun.
Dialogue: 0,0:27:04.15,0:27:07.66,pangkalahatang text,,0,0,0,,Kung sakali, pumunta at tingnan kung sino ang aalis
Dialogue: 0,0:27:18.83,0:27:20.46,pangkalahatang teksto,,0,0,0,,Kung gusto ni Master Li ng ganoon,
Dialogue: 0,0:27:20.54,0:27:23.59,pangkalahatang text,,0,0,0,,itatago natin ang "Words of the Heart" sa Jinyeowon
Dialogue: 0,0:27:25.34,0:27:28.30,general text,,0,0,0,,May nakita ka bang iba ngayon?
Dialogue: 0,0:27:29.18,0:27:30.64,pangkalahatang teksto,,0,0,0,, Malayong kamag-anak
Dialogue: 0,0:27:32.81,0:27:37.06,general text,,0,0,0,,Mamanahin ni Jin Cho Young si Jinyoung?
Dialogue: 0,0:27:39.06,0:27:40.52,pangkalahatang teksto,,0,0,0,,Hindi pa ito napagpasyahan
Dialogue: 0,0:27:41.40,0:27:43.82,general text,,0,0,0,,Maaaring buhay pa ang panganay kong babae
Dialogue: 0,0:27:46.03,0:27:48.24,pangkalahatang teksto,,0,0,0,,Sampung taon na ang lumipas mula noon
Dialogue: 0,0:27:49.45,0:27:51.37,pangkalahatang teksto,,0,0,0,,At bagaman siya ay bulag,
Dialogue: 0,0:27:51.45,0:27:55.41,pangkalahatang teksto,,0,0,0,,nakakadama siya ng enerhiya at nakontrol ang mga relic na wala nang iba
Dialogue: 0,0:27:55.49,0:27:57.20,pangkalahatang teksto,,0,0,0,,Ito ay isang napakatalino na bata
Dialogue: 0,0:27:57.29,0:27:58.71,pangkalahatang teksto,,0,0,0,,Hindi tulad ng ibang mga bata,
Dialogue: 0,0:27:59.62,0:28:02.92,pangkalahatang teksto,,0,0,0,,ipinanganak siya sa 13 buwan
Dialogue: 0,0:28:04.46,0:28:07.92,pangkalahatang teksto,,0,0,0,,Siya ay ipinanganak noong araw na pinangalanan ni Chang Gang si Gwangju
Dialogue: 0,0:28:08.01,0:28:09.47,pangkalahatang teksto,,0,0,0,, pinagpala ng langit
Dialogue: 0,0:28:11.72,0:28:15.47,general text,,0,0,0,,Siya ay ipinanganak sa araw na pinili ni Chang Gang para sa iyo?
Dialogue: 0,0:28:16.93,0:28:18.10,pangkalahatang teksto,,0,0,0,,Posible ba
Dialogue: 0,0:28:18.18,0:28:22.23,pangkalahatang teksto,,0,0,0,,piliin ang petsa at oras ng kapanganakan ng bata?
Dialogue: 0,0:28:23.36,0:28:24.90,pangkalahatang teksto,,0,0,0,,Nagkataon lang
Dialogue: 0,0:28:26.57,0:28:29.90,general text,,0,0,0,,Gusto kong imbitahan si Master Lee sa Jinyeowon
Dialogue: 0,0:28:30.49,0:28:31.78,pangkalahatang teksto,,0,0,0,,Sabihin mo sa kanya ito
Dialogue: 0,0:28:33.03,0:28:34.12,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:28:49.88,0:28:51.93,mga alaala na italics,,0,0,0,,Kinuha ko siya sa loob ng 13 buwan
Dialogue: 0,0:28:52.01,0:28:55.05,mga alaala,,0,0,0,,Hindi ko siya kayang bitawan ng ganoon kadali
Dialogue: 0,0:28:56.68,0:28:58.56,mga alaala,,0,0,0,,Narinig kong may kapangyarihan ang bato
Dialogue: 0,0:28:58.64,0:29:01.56,mga alaala,,0,0,0,,buhayin ang mga patay na kaluluwa
Dialogue: 0,0:29:08.19,0:29:09.32,mga alaala,,0,0,0,,Gwangju
Dialogue: 0,0:29:11.36,0:29:12.57,mga alaala,,0,0,0,,Tulungan mo ako
Dialogue: 0,0:29:22.87,0:29:27.50,voiceover,,0,0,0,,Nagpunta ako dito para protektahan ang anak ko
Dialogue: 0,0:29:38.85,0:29:40.10,general text,,0,0,0,,Hahanapin kita
Dialogue: 0,0:29:42.52,0:29:44.69,pangkalahatang teksto,,0,0,0,,Gagawin ko ang aking makakaya,
Dialogue: 0,0:29:46.52,0:29:47.86,pangkalahatang text,,0,0,0,,para mahanap ka
Dialogue: 0,0:29:59.79,0:30:02.83,general text,,0,0,0,,- Nasuri mo ba kung sino itong mahalagang bisita?\N- Oo
Dialogue: 0,0:30:04.37,0:30:07.84,italics,,0,0,0,,Ito ay Deputy Jin Mu
Dialogue: 0,0:30:10.17,0:30:12.30,pangkalahatang teksto,,0,0,0,,Kailan ang pinuno ng Jinyeowon
Dialogue: 0,0:30:12.38,0:30:15.63,general text,,0,0,0,,itinuring siyang miyembro ng pamilya at tinatanggap siya?
Dialogue: 0,0:30:15.72,0:30:17.55,general text,,0,0,0,,Tahimik siyang umalis sa likod ng gate
Dialogue: 0,0:30:18.30,0:30:21.02,general text,,0,0,0,,Kaya lihim ang pagpupulong
Dialogue: 0,0:30:22.18,0:30:24.89,general text,,0,0,0,,I wonder kung anong trick ang ginamit niya
Dialogue: 0,0:30:24.98,0:30:27.94,general text,,0,0,0,,madulas na Jin Mu para malayang bisitahin si Jinyoewon?
Dialogue: 0,0:30:45.29,0:30:48.67,italics,,0,0,0,,Bulag ka, kaya hindi mo alam kung nasaan ka
Dialogue: 0,0:30:49.79,0:30:52.80,italics,,0,0,0,,Tatahimik ka at gagawin ang hinihiling nila,
Dialogue: 0,0:30:53.38,0:30:54.92,italics,,0,0,0,,iligtas ang iyong buhay
Dialogue: 0,0:30:55.55,0:30:57.38,italics,,0,0,0,,Walang tunog
Dialogue: 0,0:30:57.47,0:30:58.55,pangkalahatang teksto,,0,0,0,,Bumangon
Dialogue: 0,0:32:18.88,0:32:20.05,pangkalahatang teksto,,0,0,0,,Maupo
Dialogue: 0,0:32:28.31,0:32:30.94,pangkalahatang text,,0,0,0,,Iwan mo siya, pwede na ang iba
Dialogue: 0,0:32:34.48,0:32:36.73,offscreen,,0,0,0,,Hinahanap nila ang babae mula sa portrait
Dialogue: 0,0:32:36.82,0:32:38.32,offscreen,,0,0,0,,Mukhang bulag siya
Dialogue: 0,0:32:39.36,0:32:42.32,offscreen,,0,0,0,,Pwede daw pumunta yung iba bakit walang sounds?
Dialogue: 0,0:33:11.89,0:33:13.40,pangkalahatang teksto,,0,0,0,,Makikita mo
Dialogue: 0,0:33:15.98,0:33:18.90,general text,,0,0,0,,Sayang naman. Akala ko nakahanap na ako ng tamang babae
Dialogue: 0,0:33:19.44,0:33:20.36,pangkalahatang teksto,,0,0,0,,Patayin mo siya
Dialogue: 0,0:33:24.24,0:33:25.87,pangkalahatang text,,0,0,0,,kaya ko!
Dialogue: 0,0:33:27.74,0:33:31.33,pangkalahatang teksto,,0,0,0,,maaaring ako ang babae mula sa portrait
Dialogue: 0,0:33:37.29,0:33:38.50,pangkalahatang text,,0,0,0,,Iligtas mo ako
Dialogue: 0,0:33:39.21,0:33:40.88,general text,,0,0,0,,Sabi mo pupunta ako
Dialogue: 0,0:33:42.09,0:33:43.97,pangkalahatang teksto,,0,0,0,,Kung kailangan mong maging bulag,
Dialogue: 0,0:33:47.10,0:33:49.18,pangkalahatang teksto,,0,0,0,,kung gayon ako ay magiging isa
Dialogue: 0,0:34:03.78,0:34:06.99,pangkalahatang text,,0,0,0,,Nakakaaliw na babae. Bumangon ka na
Dialogue: 0,0:34:12.91,0:34:15.08,general text,,0,0,0,,Para magpanggap kang bulag?
Dialogue: 0,0:34:15.92,0:34:17.58,general text,,0,0,0,,Bulag na ako
Dialogue: 0,0:34:21.13,0:34:23.59,pangkalahatang teksto,,0,0,0,,Buweno, suriin natin
Dialogue: 0,0:35:01.96,0:35:04.80,general text,,0,0,0,,Mukhang nakita ko talaga ang kailangan ko
Dialogue: 0,0:35:24.40,0:35:25.86,pangkalahatang teksto,,0,0,0,,Gayunpaman
Dialogue: 0,0:35:25.94,0:35:29.95,general text,,0,0,0,,Mula ngayon, ikaw na si Jin Bu Young, ang nawawalang anak ni Jinyoung
Dialogue: 0,0:35:31.07,0:35:32.12,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:35:33.29,0:35:35.12,pangkalahatang teksto,,0,0,0,,Ako si Jin Bu Young
Dialogue: 0,0:35:47.30,0:35:49.30,voiceover,,0,0,0,,Tumigil muli si Chan Wook sa pagsasanay
Dialogue: 0,0:35:53.76,0:35:57.27,voiceover,,0,0,0,,Paano ko siya parurusahan sa pagkakataong ito?
Dialogue: 0,0:36:02.56,0:36:04.73,general text,,0,0,0,,Salamat sa akin, nagsusumikap ka
Dialogue: 0,0:36:09.20,0:36:10.11,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:36:10.70,0:36:13.95,general text,,0,0,0,,Salamat sa iyo, kailangan kong magwalis muli ng bakuran
Dialogue: 0,0:36:21.38,0:36:22.63,general text,,0,0,0,,Nakikipagtalo ka ba sa akin?
Dialogue: 0,0:36:23.67,0:36:24.84,general text,,0,0,0,,Pagkatapos tutulungan kitang umalis
Dialogue: 0,0:36:24.92,0:36:26.25,pangkalahatang text,,0,0,0,,Niloko mo
Dialogue: 0,0:36:26.80,0:36:28.92,general text,,0,0,0,,Kung pag-uusapan ko ito, itatapon ka kaagad dito
Dialogue: 0,0:36:31.22,0:36:32.80,pangkalahatang teksto,,0,0,0,,Paumanhin, Kamahalan
Dialogue: 0,0:36:33.89,0:36:36.97,general text,,0,0,0,,Nagpapasalamat ako sa mga dahong nalaglag sa tulong mo
Dialogue: 0,0:36:37.06,0:36:39.60,pangkalahatang teksto,,0,0,0,,Maaari mong ipagpatuloy ang pag-alog ng puno
Dialogue: 0,0:36:41.40,0:36:43.06,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:36:44.02,0:36:46.48,pangkalahatang teksto,,0,0,0,,para sa mga sagot, hindi para sa mga dahon
Dialogue: 0,0:36:48.53,0:36:53.45,pangkalahatang teksto,,0,0,0,,Kaya hindi ka dumating para magreklamo, kundi para sa pasasalamat
Dialogue: 0,0:36:53.53,0:36:56.24,pangkalahatang teksto,,0,0,0,,Matagal akong umintindi, Kamahalan
Dialogue: 0,0:36:56.33,0:36:58.25,pangkalahatang teksto,,0,0,0,,Ako ay lubos na nagpapasalamat sa iyo
Dialogue: 0,0:36:59.04,0:37:02.12,general text,,0,0,0,,Syempre nagpapasalamat ka. Ako mismo ang sumulat ng mga sagot
Dialogue: 0,0:37:03.67,0:37:06.09,general text,,0,0,0,,Marunong ka rin bang maghugas ng tinta?
Dialogue: 0,0:37:07.46,0:37:10.59,general text,,0,0,0,,Nakasulat ka na ba ng sagot?
Dialogue: 0,0:37:11.22,0:37:14.01,pangkalahatang teksto,,0,0,0,,Oo. Ako ang Crown Prince
Dialogue: 0,0:37:14.09,0:37:16.60,general text,,0,0,0,,Nalaman ko na ang rice paste ay nag-aalis ng tinta
Dialogue: 0,0:37:17.22,0:37:20.31,pangkalahatang teksto,,0,0,0,, Kahit na sinubukan ko ito, gumagana ito
Dialogue: 0,0:37:21.02,0:37:22.39,pangkalahatang teksto,,0,0,0,,Walang mga salita
Dialogue: 0,0:37:23.98,0:37:26.11,general text,,0,0,0,,Ako ay walang hanggan sa iyong utang
Dialogue: 0,0:37:27.69,0:37:28.82,pangkalahatang teksto,,0,0,0,,Ano kaya?
Dialogue: 0,0:37:29.74,0:37:31.24,general text,,0,0,0,,Masaya na kasama ang iyong amo?
Dialogue: 0,0:37:32.65,0:37:34.28,general text,,0,0,0,,Narinig kong binasa niya ang "Words of the Heart"
Dialogue: 0,0:37:34.36,0:37:35.49,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:37:35.57,0:37:38.95,pangkalahatang teksto,,0,0,0,,Sa mga mago ng Jeongjingak, siya ang pinakamabilis
Dialogue: 0,0:37:42.08,0:37:44.00,pangkalahatang teksto,,0,0,0,,Malamang na talento at kakayahan lang
Dialogue: 0,0:37:44.58,0:37:46.25,general text,,0,0,0,,Marahil maswerte na naman
Dialogue: 0,0:37:47.29,0:37:50.09,general text,,0,0,0,,Pero natalo ka niya sa isang tunggalian
Dialogue: 0,0:37:53.30,0:37:56.93,general text,,0,0,0,,Alam ko kung ano ang kaya ni Chan Wook dahil inaway ko siya
Dialogue: 0,0:37:58.31,0:38:01.10,pangkalahatang teksto,,0,0,0,,Mahina ang kasanayan sa espada, mahinang spelling
Dialogue: 0,0:38:01.18,0:38:04.90,general text,,0,0,0,,Maswerte siyang gumamit ng Tansu. Ito ay hindi tungkol sa mga kasanayan
Dialogue: 0,0:38:06.19,0:38:08.23,behind the scenes,,0,0,0,,Tama siya sa isang bagay
Dialogue: 0,0:38:08.98,0:38:12.61,general text,,0,0,0,,Kaya pumunta siya sa Jeonjingak. Maging isang makapangyarihang salamangkero
Dialogue: 0,0:38:12.69,0:38:15.82,pangkalahatang teksto,,0,0,0,,Sa katunayan, kulang siya sa kakayahan para makasali sa Jeonjingak
Dialogue: 0,0:38:16.49,0:38:19.91,general text,,0,0,0,,Kung matatalo niya ang sinuman dito,
Dialogue: 0,0:38:20.66,0:38:22.29,pangkalahatang teksto,,0,0,0,,kilala ko ito
Dialogue: 0,0:38:23.58,0:38:26.63,voiceover,,0,0,0,,Masarap gamitin ang Crown Prince
Dialogue: 0,0:38:26.71,0:38:27.79,pangkalahatang teksto,,0,0,0,,Your Highness
Dialogue: 0,0:38:28.34,0:38:31.71,general text,,0,0,0,,O baka naman pwede tayong magtalo?
Dialogue: 0,0:38:32.55,0:38:33.72,general text,,0,0,0,,Pustahan ba tayo?
Dialogue: 0,0:38:35.05,0:38:37.18,general text,,0,0,0,,Ano ang mapapala ko sa pakikipagtalo sa iyo?
Dialogue: 0,0:38:38.39,0:38:42.22,pangkalahatang teksto,,0,0,0,,Ibibigay ko sa iyo ang pinakamahalagang bagay na mayroon ako
Dialogue: 0,0:38:50.48,0:38:51.86,memories italics,,0,0,0,,Ako ang unang pipili
Dialogue: 0,0:38:51.94,0:38:53.82,mga alaala,,0,0,0,,Kukunin ko ang pula, kunin mo ang asul
Dialogue: 0,0:38:59.03,0:39:01.83,mga alaala na italics,,0,0,0,,Teka. pupunta ako diyan
Dialogue: 0,0:39:02.49,0:39:03.87,memories italics,,0,0,0,,I missed you too
Dialogue: 0,0:39:05.33,0:39:06.67,mga alaala,,0,0,0,,Ito ang sagot ko
Dialogue: 0,0:39:16.76,0:39:18.39,pangkalahatang teksto,,0,0,0,,- Mister\N- Oo
Dialogue: 0,0:39:19.01,0:39:21.10,general text,,0,0,0,,Binili ko ang paborito mong cookies
Dialogue: 0,0:39:21.93,0:39:23.39,general text,,0,0,0,,Tutuloy ka ba para sa tanghalian?
Dialogue: 0,0:39:23.47,0:39:25.48,general text,,0,0,0,,Umuwi ako ng ilang araw
Dialogue: 0,0:39:26.43,0:39:29.65,general text,,0,0,0,,- Posible ba ito?\N- Nagbigay ng pahintulot ang ulo
Dialogue: 0,0:39:29.73,0:39:31.98,pangkalahatang teksto,,0,0,0,,Ginawa akong exception sa lahat ng bagay
Dialogue: 0,0:39:32.07,0:39:33.36,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:39:33.44,0:39:36.19,pangkalahatang teksto,,0,0,0,,Basahin mo ang "Mga Salita ng Puso" sa loob ng ilang araw
Dialogue: 0,0:39:36.28,0:39:39.45,pangkalahatang teksto,,0,0,0,,Katangahan na pilitin kang sundin ang parehong mga patakaran tulad ng mga ordinaryong salamangkero
Dialogue: 0,0:39:40.49,0:39:42.91,general text,,0,0,0,,Masaya ka ba sa tagumpay ko?
Dialogue: 0,0:39:42.99,0:39:44.83,general text,,0,0,0,,Hindi lang ako masaya
Dialogue: 0,0:39:44.91,0:39:47.21,pangkalahatang teksto,,0,0,0,,Wala kang ideya kung gaano ako ipinagmamalaki
Dialogue: 0,0:39:49.04,0:39:50.46,pangkalahatang teksto,,0,0,0,,Dalagang Kim,
Dialogue: 0,0:39:50.54,0:39:54.17,pangkalahatang teksto,,0,0,0,,Palagi kitang binigo, at ngayon ay maipagmamalaki mo
Dialogue: 0,0:39:54.25,0:39:57.09,general text,,0,0,0,,Bilhan ba kita ng magandang damit?
Dialogue: 0,0:39:57.17,0:39:58.59,general text,,0,0,0,,You look
Dialogue: 0,0:39:58.68,0:40:02.72,general text,,0,0,0,,Wala akong kailangan. Pakiramdam ko nasa akin na ang lahat
Dialogue: 0,0:40:03.97,0:40:05.43,pangkalahatang teksto,,0,0,0,,Dumating ang mga tao
Dialogue: 0,0:40:05.52,0:40:08.94,general text,,0,0,0,,at sinabi nila sa akin na anak ka ng iyong ama
Dialogue: 0,0:40:10.77,0:40:11.77,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:40:12.36,0:40:14.65,pangkalahatang teksto,,0,0,0,,Tinawag na henyo ang iyong ama
Dialogue: 0,0:40:14.73,0:40:18.24,general text,,0,0,0,,At ngayon sinasabi nila na kasing talino mo ang iyong ama
Dialogue: 0,0:40:20.24,0:40:22.62,general text,,0,0,0,,Sabi ng mga tao hindi ko daw siya kamukha
Dialogue: 0,0:40:25.99,0:40:27.62,pangkalahatang teksto,,0,0,0,,Ikaw ay uunlad,
Dialogue: 0,0:40:28.29,0:40:31.96,pangkalahatang teksto,,0,0,0,,at hindi na sasabihin ng mga tao ang tungkol sa iyo
Dialogue: 0,0:40:32.04,0:40:35.21,pangkalahatang teksto,,0,0,0,,Paano kung walang tagumpay? Magsisimula na ba silang magkalat ng tsismis?
Dialogue: 0,0:40:37.09,0:40:38.21,pangkalahatang teksto,,0,0,0,,Hindi, hindi ganoon...
Dialogue: 0,0:40:39.55,0:40:42.64,pangkalahatang teksto,,0,0,0,,Sabihin sa kanila na malaya silang sabihin ang anumang gusto nila
Dialogue: 0,0:40:42.72,0:40:44.01,pangkalahatang text,,0,0,0,,Hindi na ako nakakaabala
Dialogue: 0,0:40:45.06,0:40:47.89,pangkalahatang teksto,,0,0,0,,Oo. Hindi ka na maaaring mag-alala tungkol dito
Dialogue: 0,0:40:49.94,0:40:54.90,pangkalahatang teksto,,0,0,0,, At bukod pa, ang iyong mga tagumpay ay ang iyong mga merito
Dialogue: 0,0:40:54.98,0:40:56.36,general text,,0,0,0,,Aling panig ang ama dito?
Dialogue: 0,0:40:57.07,0:40:59.44,pangkalahatang teksto,,0,0,0,,Siya ay hindi kailanman nasa paligid
Dialogue: 0,0:41:00.03,0:41:03.70,pangkalahatang teksto,,0,0,0,,At sa pangkalahatan, lahat dahil ako
Dialogue: 0,0:41:03.78,0:41:05.16,general text,,0,0,0,,pinalaki ka ng maayos
Dialogue: 0,0:41:11.96,0:41:15.00,general text,,0,0,0,,You will always be my dear sir,
Dialogue: 0,0:41:15.92,0:41:18.55,pangkalahatang teksto,,0,0,0,,may tagumpay man o walang
Dialogue: 0,0:41:20.01,0:41:21.05,general text,,0,0,0,,Talaga?
Dialogue: 0,0:41:22.55,0:41:26.05,general text,,0,0,0,,Tapos pwede ka nang umuwi at tamad?
Dialogue: 0,0:41:27.81,0:41:29.77,pangkalahatang teksto,,0,0,0,,Oo, kung gusto mo
Dialogue: 0,0:41:30.56,0:41:33.02,general text,,0,0,0,,Pero akala ko kinasusuklaman mo
Dialogue: 0,0:41:34.56,0:41:38.23,general text,,0,0,0,,Kung ikukumpara mo noong bumalik ka mula Danhyangok,
Dialogue: 0,0:41:38.32,0:41:41.53,pangkalahatang teksto,,0,0,0,,mukhang mas masaya kaysa noong
Dialogue: 0,0:41:42.53,0:41:44.16,pangkalahatang text,,0,0,0,,nagpapalamig sa bahay
Dialogue: 0,0:41:45.49,0:41:48.41,general text,,0,0,0,,Kaya hindi kita napigilan, sa kabila ng lahat ng panganib
Dialogue: 0,0:41:49.04,0:41:50.08,pangkalahatang teksto,,0,0,0,,Gusto ko,
Dialogue: 0,0:41:50.62,0:41:55.42,pangkalahatang teksto,,0,0,0,,upang magtagumpay ka sa anumang pipiliin mo para sa iyong sarili
Dialogue: 0,0:41:58.04,0:41:59.17,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:42:03.17,0:42:04.51,pangkalahatang teksto,,0,0,0,,Dapat akong bumalik
Dialogue: 0,0:42:05.59,0:42:07.26,general text,,0,0,0,,Aalis ka na ba?
Dialogue: 0,0:42:07.35,0:42:10.89,pangkalahatang teksto,,0,0,0,,Oo. Kung hihilingin mong umalis ako, gagawin ko ang kabaligtaran
Dialogue: 0,0:42:10.97,0:42:13.06,pangkalahatang teksto,,0,0,0,,Ngunit pagkatapos ng gayong talumpati, kailangan nating bumalik
Dialogue: 0,0:42:13.14,0:42:16.77,pangkalahatang teksto,,0,0,0,,Dapat kong gawin ang lahat para ipagmalaki ka
Dialogue: 0,0:42:18.23,0:42:20.53,pangkalahatang teksto,,0,0,0,,At ang ulo? Hindi na ba masakit?
Dialogue: 0,0:42:21.23,0:42:22.36,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:42:23.24,0:42:25.24,pangkalahatang teksto,,0,0,0,,Anong mga tao, anong mga kabayo
Dialogue: 0,0:42:25.32,0:42:27.57,pangkalahatang teksto,,0,0,0,,turuan gamit ang carrots at sticks
Dialogue: 0,0:42:28.78,0:42:31.87,general text,,0,0,0,,Pinalo lang nila ako
Dialogue: 0,0:42:32.45,0:42:35.33,general text,,0,0,0,,Sino ang nangahas na saktan ka?
Dialogue: 0,0:42:35.42,0:42:37.88,general text,,0,0,0,,Huwag kang mag-alala, hindi ako tatayo habang binubugbog nila ako
Dialogue: 0,0:42:39.84,0:42:41.34,pangkalahatang text,,0,0,0,, Balutin mo ako ng mga matamis
Dialogue: 0,0:42:41.42,0:42:42.84,pangkalahatang text,,0,0,0,,Isang bungkos ng cookies
Dialogue: 0,0:42:43.80,0:42:46.51,general text,,0,0,0,,- Magiging masaya\N- Sigurado ka ba?
Dialogue: 0,0:42:47.59,0:42:48.68,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:42:49.97,0:42:51.10,pangkalahatang text,,0,0,0,,Sa wakas nandito ka na
Dialogue: 0,0:42:51.81,0:42:52.93,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:42:53.02,0:42:55.81,general text,,0,0,0,,Parang lahat kayo naghihintay sa akin
Dialogue: 0,0:42:56.44,0:42:58.90,general text,,0,0,0,,Gusto ba ng lahat ang cookies na dala ko?
Dialogue: 0,0:42:58.98,0:43:02.07,general text,,0,0,0,,Pumunta sa training room. Magiging masaya
Dialogue: 0,0:43:13.54,0:43:15.62,general text,,0,0,0,,- Hinihintay mo ba ako?\N- Oo
Dialogue: 0,0:43:15.71,0:43:18.46,general text,,0,0,0,,Ako ang una mong kalaban
Dialogue: 0,0:43:19.96,0:43:20.79,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:43:21.54,0:43:23.34,general text,,0,0,0,,Simulan na natin ang laban
Dialogue: 0,0:43:24.09,0:43:26.13,general text,,0,0,0,,Kung tumanggi ka, talo ka
Dialogue: 0,0:43:27.01,0:43:28.47,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:43:32.47,0:43:34.10,pangkalahatang teksto,,0,0,0,,Kunin
Dialogue: 0,0:44:03.63,0:44:04.71,italics,,0,0,0,,Natalo si Chan Wook
Dialogue: 0,0:44:06.51,0:44:09.43,pangkalahatang teksto,,0,0,0,,Gyo Ho, ang nanalo, ay maaaring kunin ang kanyang gintong palaka
Dialogue: 0,0:44:37.29,0:44:38.66,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:44:38.75,0:44:40.00,pangkalahatang text,,0,0,0,,pusta ako
Dialogue: 0,0:44:40.08,0:44:42.38,general text,,0,0,0,,Hindi ako nakipagtalo sa iyo tungkol sa kahit ano, Your Highness
Dialogue: 0,0:44:42.46,0:44:45.21,pangkalahatang teksto,,0,0,0,,Hindi sa iyo, sa iyong kasambahay
Dialogue: 0,0:44:49.30,0:44:52.51,general text,,0,0,0,,Sinabi ko sa kanya na hindi mo matatalo ang isang magician dito
Dialogue: 0,0:44:52.59,0:44:53.97,pangkalahatang text,,0,0,0,,hindi mo kaya
Dialogue: 0,0:44:54.05,0:44:57.06,general text,,0,0,0,,At sabi ng maid mo matatalo mo kahit isa.
Dialogue: 0,0:44:57.97,0:44:59.81,general text,,0,0,0,,Sinabi ni Mu Dok?
Dialogue: 0,0:45:01.77,0:45:04.11,general text,,0,0,0,,Lalaban ka araw-araw sa loob ng sampung araw
Dialogue: 0,0:45:04.19,0:45:06.02,general text,,0,0,0,,Kung hindi ka nanalo,
Dialogue: 0,0:45:06.11,0:45:08.57,general text,,0,0,0,,ibibigay niya sa akin ang pinakamahalagang bagay na mayroon siya
Dialogue: 0,0:45:10.28,0:45:11.36,pangkalahatang teksto,,0,0,0,,Mahal?
Dialogue: 0,0:45:12.53,0:45:14.24,pangkalahatang teksto,,0,0,0,,Ano ang napakahalaga sa iyo?
Dialogue: 0,0:45:14.87,0:45:16.62,pangkalahatang teksto,,0,0,0,,Ang ibinigay mo sa akin
Dialogue: 0,0:45:18.70,0:45:20.16,pangkalahatang teksto,,0,0,0,,Nakataya
Dialogue: 0,0:45:29.67,0:45:32.30,general text,,0,0,0,,Mukhang mahal ang jade na ito, gusto ko para sa sarili ko
Dialogue: 0,0:45:34.51,0:45:36.30,pangkalahatang teksto,,0,0,0,,Kaya dinala ko ang mga gintong palaka
Dialogue: 0,0:45:36.39,0:45:37.97,pangkalahatang teksto,,0,0,0,,bilang premyo
Dialogue: 0,0:45:44.65,0:45:48.44,pangkalahatang teksto,,0,0,0,,Kung hindi ka nanalo bago matapos ang mga palaka,
Dialogue: 0,0:45:48.52,0:45:49.94,pangkalahatang teksto,,0,0,0,,magiging akin ito
Dialogue: 0,0:45:50.57,0:45:52.82,pangkalahatang teksto,,0,0,0,,Wala akong gaanong interes sa naturang pagtatalo
Dialogue: 0,0:45:53.66,0:45:56.41,general text,,0,0,0,,Hindi ako nakikipagtalo sa iyo, kundi sa kanya
Dialogue: 0,0:45:58.16,0:45:59.49,pangkalahatang teksto,,0,0,0,,Kung susuko ka,
Dialogue: 0,0:45:59.58,0:46:02.08,general text,,0,0,0,,na nangangahulugang hindi siya nanalo kahit isang laban, ibig sabihin, natalo siya
Dialogue: 0,0:46:02.96,0:46:04.08,pangkalahatang teksto,,0,0,0,,At ito ay magiging akin
Dialogue: 0,0:46:08.80,0:46:09.92,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:46:11.17,0:46:13.84,pangkalahatang teksto,,0,0,0,,Ito ang pinakamahalagang bagay na natanggap ko
Dialogue: 0,0:46:15.80,0:46:19.31,pangkalahatang teksto,,0,0,0,,Pakibalik siya
Dialogue: 0,0:46:30.44,0:46:31.48,pangkalahatang teksto,,0,0,0,,Manood ng higit pa
Dialogue: 0,0:46:32.11,0:46:33.74,pangkalahatang teksto,,0,0,0,,Nakakuha ka talaga ng golden toad
Dialogue: 0,0:46:33.82,0:46:37.37,pangkalahatang teksto,,0,0,0,,Hayaan ang Uk na basahin ang "Words of the Heart",
Dialogue: 0,0:46:37.45,0:46:39.78,pangkalahatang text,,0,0,0,,- pero hindi siya marunong gumamit ng espada\N- Ano ang nangyayari?
Dialogue: 0,0:46:41.70,0:46:44.54,pangkalahatang teksto,,0,0,0,,Nagtalo sina Prince at Moo Deok
Dialogue: 0,0:46:45.54,0:46:48.84,pangkalahatang teksto,,0,0,0,,Ang Crown Prince ay nagdala ng mga gintong palaka, kaya lahat ay gustong lumahok
Dialogue: 0,0:46:50.25,0:46:53.17,pangkalahatang teksto,,0,0,0,,Pumila ang malalakas na magician
Dialogue: 0,0:46:55.17,0:46:56.80,pangkalahatang teksto,,0,0,0,,Put
Dialogue: 0,0:47:04.23,0:47:06.73,pangkalahatang teksto,,0,0,0,,Tinawanan ka ng Kanyang Kamahalan
Dialogue: 0,0:47:07.27,0:47:09.27,general text,,0,0,0,,Bilang guro mo, hindi ako makaimik
Dialogue: 0,0:47:09.36,0:47:12.28,pangkalahatang teksto,,0,0,0,,Huwag magsinungaling. kilala kita
Dialogue: 0,0:47:13.53,0:47:15.24,general text,,0,0,0,,Tamad ako nitong mga araw na ito,
Dialogue: 0,0:47:15.32,0:47:17.70,pangkalahatang text,,0,0,0,,kaya nakipagpustahan ka para magsanay ako
Dialogue: 0,0:47:20.20,0:47:21.12,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:47:22.66,0:47:26.96,pangkalahatang teksto,,0,0,0,,Kailangan mong makipaglaban sa isang dosenang mago, gusto mo man o hindi
Dialogue: 0,0:47:28.46,0:47:31.63,pangkalahatang teksto,,0,0,0,,Ang unang laban ay higit na isang pagkabigo
Dialogue: 0,0:47:32.25,0:47:34.34,general text,,0,0,0,,Mabigat ang hakbang, dahan-dahan mong igalaw ang espada
Dialogue: 0,0:47:34.42,0:47:37.68,general text,,0,0,0,,- Bukas ay isang tunggalian sa...\N- Tumanggi ako
Dialogue: 0,0:47:40.97,0:47:43.26,general text,,0,0,0,,Kahit matalo ka, maaalala mo ang nakita mo,
Dialogue: 0,0:47:43.35,0:47:44.56,pangkalahatang teksto,,0,0,0,,makakatulong ito sa iyo
Dialogue: 0,0:47:44.64,0:47:47.64,general text,,0,0,0,,- Hindi ako lalaban\N- Sampung laban -
Dialogue: 0,0:47:47.73,0:47:50.23,pangkalahatang teksto,,0,0,0,,sampung magkakaibang istilo
Dialogue: 0,0:47:51.06,0:47:52.57,pangkalahatang teksto,,0,0,0,,- Mu Dok...\N- Master,
Dialogue: 0,0:47:52.65,0:47:54.82,pangkalahatang text,,0,0,0,, ligtas kang makakauwi para magbabad
Dialogue: 0,0:47:54.90,0:47:57.20,general text,,0,0,0,,Kung gayon hindi mo na ibabalik ang jade na iyon
Dialogue: 0,0:47:58.78,0:47:59.91,pangkalahatang teksto,,0,0,0,,Okay, okay
Dialogue: 0,0:48:00.95,0:48:02.53,pangkalahatang text,,0,0,0,,Pusta ka
Dialogue: 0,0:48:03.12,0:48:04.12,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,0:48:05.29,0:48:07.00,general text,,0,0,0,,Bakit mo nilagay ang regalo ko?
Dialogue: 0,0:48:07.71,0:48:08.83,pangkalahatang teksto,,0,0,0,,Alam mo
Dialogue: 0,0:48:09.33,0:48:12.79,pangkalahatang teksto,,0,0,0,,Ito lang ang paraan para lumaban ka at manalo
Dialogue: 0,0:48:15.55,0:48:16.71,general text,,0,0,0,,Noong sinabi kong na-miss kita,
Dialogue: 0,0:48:16.80,0:48:19.34,general text,,0,0,0,,ito ba ang ibig mong sabihin sa kahinaan ko?
Dialogue: 0,0:48:22.18,0:48:23.30,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:48:24.68,0:48:26.47,general text,,0,0,0,,Malamang galit ka sa akin ngayon,
Dialogue: 0,0:48:27.68,0:48:30.52,general text,,0,0,0,,pero hindi mawawala ang pag-aari nating dalawa
Dialogue: 0,0:48:35.32,0:48:37.61,general text,,0,0,0,,Kaya ba sinabi mong nalason ako?
Dialogue: 0,0:48:37.69,0:48:39.99,general text,,0,0,0,,Kung babalikan mo siya, ngumiti ako ng malawak sayo
Dialogue: 0,0:48:40.91,0:48:42.28,pangkalahatang teksto,,0,0,0,,Sa halip na isang antidote
Dialogue: 0,0:48:46.79,0:48:47.91,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:48:49.25,0:48:50.75,pangkalahatang teksto,,0,0,0,,Ibalik ito sa anumang paraan
Dialogue: 0,0:48:51.83,0:48:54.21,pangkalahatang teksto,,0,0,0,,Ito ang pinakamahalagang bagay na pag-aari ko
Dialogue: 0,0:48:55.67,0:48:57.30,pangkalahatang teksto,,0,0,0,,natanggap sa buong buhay ko
Dialogue: 0,0:49:00.01,0:49:01.55,general text,,0,0,0,,Mahal mo ba talaga siya?
Dialogue: 0,0:49:02.43,0:49:03.68,pangkalahatang teksto,,0,0,0,,O...
Dialogue: 0,0:49:05.14,0:49:06.64,general text,,0,0,0,,mahal na mahal lang ba?
Dialogue: 0,0:49:12.19,0:49:14.23,general text,,0,0,0,,Kukunin ko ito sa Crown Prince
Dialogue: 0,0:49:15.15,0:49:17.19,pangkalahatang teksto,,0,0,0,,Kakaiba ang may pagkakapareho sa kanya
Dialogue: 0,0:49:24.24,0:49:26.49,pangkalahatang teksto,,0,0,0,,Ngunit hindi rin ito sulit na ibahagi sa iyo
Dialogue: 0,0:49:48.35,0:49:50.98,general text,,0,0,0,,Narinig kong madalas kang bumibisita sa Saejukwon
Dialogue: 0,0:49:51.60,0:49:54.81,pangkalahatang teksto,,0,0,0,,Baka gusto mong italaga si Master Huo bilang iyong guro
Dialogue: 0,0:49:55.40,0:49:57.65,general text,,0,0,0,,at matuto ng magic mula sa kanya?
Dialogue: 0,0:49:58.94,0:50:00.15,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:50:00.90,0:50:02.74,pangkalahatang teksto,,0,0,0,,Ikaw ang aking guro
Dialogue: 0,0:50:03.82,0:50:05.57,italics,,0,0,0,,Pumunta lang ako doon para magpagamot
Dialogue: 0,0:50:05.66,0:50:09.29,pangkalahatang teksto,,0,0,0,,Paghinga ng sariwang hangin. Dagdag pa, madalas na nangyayari ang mga nakakatawang bagay doon
Dialogue: 0,0:50:09.37,0:50:13.04,pangkalahatang teksto,,0,0,0,,Dapat kang masiyahan sa paggugol ng oras sa mga salamangkero ng Sosnovy Bor
Dialogue: 0,0:50:13.12,0:50:15.29,general text,,0,0,0,,kausap ko si Yul, ang aking pinsan
Dialogue: 0,0:50:15.37,0:50:17.54,general text,,0,0,0,,Nakakatuwa din si Park Dan Gu
Dialogue: 0,0:50:17.63,0:50:20.88,general text,,0,0,0,,Ah Chang Wook... Gusto ko sana siyang turuan ng leksyon, pero hindi ganoon kadali
Dialogue: 0,0:50:21.42,0:50:23.97,general text,,0,0,0,,Mukhang natuwa siya na nabasa niya ang “Words of the Heart”
Dialogue: 0,0:50:24.05,0:50:26.01,general text,,0,0,0,,kaya ngayon inilagay ko ito sa lugar nito
Dialogue: 0,0:50:26.09,0:50:28.60,italics,,0,0,0,,Natalo siya sa isang magician na kakabisado lang ni Ryusu
Dialogue: 0,0:50:28.68,0:50:30.81,pangkalahatang teksto,,0,0,0,,Ngayon alam na ng mga tao ang kanyang tunay na kapangyarihan
Dialogue: 0,0:50:30.89,0:50:32.60,general text,,0,0,0,,Wala nang humahanga sa kanya
Dialogue: 0,0:50:39.61,0:50:40.94,pangkalahatang teksto,,0,0,0,,Magandang jade
Dialogue: 0,0:50:41.65,0:50:43.82,pangkalahatang teksto,,0,0,0,,pinalitan ko ito ng sampung gintong palaka
Dialogue: 0,0:50:44.82,0:50:47.62,general text,,0,0,0,,- Napakahalaga ba niya?\N- Mayroon siyang Yin energy
Dialogue: 0,0:50:48.32,0:50:50.24,pangkalahatang teksto,,0,0,0,,Nasaan ang ikalawang kalahati?
Dialogue: 0,0:50:50.33,0:50:51.37,pangkalahatang teksto,,0,0,0,,Ikalawang kalahati?
Dialogue: 0,0:50:51.45,0:50:53.87,pangkalahatang teksto,,0,0,0,,Ang mga bagay na may kabaligtaran na enerhiya ay laging may pares
Dialogue: 0,0:50:53.96,0:50:56.21,italics,,0,0,0,,Dapat mayroon ding red jade
Dialogue: 0,0:50:56.96,0:50:59.09,pangkalahatang teksto,,0,0,0,,Pares lang ang halaga nila
Dialogue: 0,0:51:03.84,0:51:05.59,italics,,0,0,0,,So may date siya?
Dialogue: 0,0:51:06.09,0:51:07.26,pangkalahatang teksto,,0,0,0,,Eunuch O
Dialogue: 0,0:51:08.05,0:51:10.60,pangkalahatang teksto,,0,0,0,,Kung ang mga tao ay nagpares ng mga bagay, ano ang ibig sabihin nito?
Dialogue: 0,0:51:10.68,0:51:12.77,general text,,0,0,0,,Ibig sabihin ay kasal na sila o nagde-date
Dialogue: 0,0:51:15.23,0:51:16.69,pangkalahatang teksto,,0,0,0,,Holy shit
Dialogue: 0,0:51:17.31,0:51:20.36,general text,,0,0,0,,Hindi mo gusto ang jade na ito, Your Highness?
Dialogue: 0,0:51:20.44,0:51:23.86,general text,,0,0,0,,Oo, pinagalitan niya ako. Nakakabaliw
Dialogue: 0,0:51:24.36,0:51:27.28,pangkalahatang teksto,,0,0,0,,Kunin ito at hatiin sa maliliit na piraso
Dialogue: 0,0:51:27.36,0:51:29.99,italics,,0,0,0,,Hindi mo magagawa yan
Dialogue: 0,0:51:30.07,0:51:31.74,pangkalahatang text,,0,0,0,,Maaari itong manalo muli ni Chan Wook
Dialogue: 0,0:51:34.20,0:51:36.00,general text,,0,0,0,,Kung ibabalik niya ito,
Dialogue: 0,0:51:36.87,0:51:38.29,general text,,0,0,0,,tapos magiging couple ulit sila
Dialogue: 0,0:51:39.71,0:51:40.88,pangkalahatang text,,0,0,0,,Heto
Dialogue: 0,0:51:53.18,0:51:54.35,italics,,0,0,0,,- Master Li\N{\i0}- Oo...
Dialogue: 0,0:51:57.48,0:51:59.94,general text,,0,0,0,,Ano ang nagdala sa iyo dito?
Dialogue: 0,0:52:02.27,0:52:04.98,pangkalahatang teksto,,0,0,0,,Nagsuot ako ng damit ng abaka buong taon at hindi ako nakaramdam ng lamig
Dialogue: 0,0:52:05.82,0:52:06.65,italics,,0,0,0,,Pero
Dialogue: 0,0:52:07.65,0:52:09.36,pangkalahatang teksto,,0,0,0,, sulit ang pagsusuot ng scarf na ito,
Dialogue: 0,0:52:10.24,0:52:12.41,general text,,0,0,0,,Narealize ko kung gaano ako nilalamig
Dialogue: 0,0:52:14.91,0:52:16.54,pangkalahatang teksto,,0,0,0,,Ano iyon?
Dialogue: 0,0:52:19.12,0:52:20.12,pangkalahatang teksto,,0,0,0,,Ano...
Dialogue: 0,0:52:25.00,0:52:28.67,pangkalahatang teksto,,0,0,0,,Hindi kailanman sa aking buhay ay may mga bulaklak na tila maganda sa akin,
Dialogue: 0,0:52:30.09,0:52:33.89,general text,,0,0,0,,pero sa sandaling nakita ko ang mga ito, gusto kong ibigay sa iyo
Dialogue: 0,0:52:41.15,0:52:42.69,pangkalahatang teksto,,0,0,0,,Beauty
Dialogue: 0,0:52:43.69,0:52:46.23,general text,,0,0,0,,Para sa akin ba ito?
Dialogue: 0,0:52:53.66,0:52:55.99,pangkalahatang teksto,,0,0,0,,Ang mga aklat na ito...
Dialogue: 0,0:52:56.08,0:52:57.45,pangkalahatang teksto,,0,0,0,,Mayroon kang magagandang libro dito
Dialogue: 0,0:52:58.62,0:53:00.37,pangkalahatang teksto,,0,0,0,,Mahusay na aklat
Dialogue: 0,0:53:07.42,0:53:08.92,pangkalahatang text,,0,0,0,,Maiden Kim...
Dialogue: 0,0:53:10.01,0:53:11.18,pangkalahatang text,,0,0,0,,may sakit?
Dialogue: 0,0:53:11.26,0:53:13.30,pangkalahatang teksto,,0,0,0,,Matagal na siyang hindi nagpakita sa Sosnovy Bor
Dialogue: 0,0:53:13.39,0:53:14.93,general text,,0,0,0,,Pumunta siya doon kahapon
Dialogue: 0,0:53:15.55,0:53:17.64,italics,,0,0,0,,Madalas niyang binibisita si Mr. Chan
Dialogue: 0,0:53:18.72,0:53:19.89,pangkalahatang teksto,,0,0,0,,Ganito
Dialogue: 0,0:53:22.02,0:53:24.48,general text,,0,0,0,,Hindi lang niya ako pinuntahan
Dialogue: 0,0:53:26.52,0:53:28.78,general text,,0,0,0,,May bisita siya ngayon
Dialogue: 0,0:53:28.86,0:53:30.65,pangkalahatang teksto,,0,0,0,, Panauhin? WHO?
Dialogue: 0,0:53:30.74,0:53:34.16,general text,,0,0,0,,Hindi ko siya kilala, pero binata siya
Dialogue: 0,0:53:34.95,0:53:36.37,pangkalahatang teksto,,0,0,0,,Binata?
Dialogue: 0,0:53:37.37,0:53:41.04,general text,,0,0,0,,Sa pagkakaalam ko, walang alam na binata ang maid Kim
Dialogue: 0,0:53:50.97,0:53:52.59,italics,,0,0,0,,Maiden Kim
Dialogue: 0,0:53:58.18,0:53:59.52,pangkalahatang teksto,,0,0,0,,Kumusta
Dialogue: 0,0:54:01.35,0:54:03.06,pangkalahatang teksto,,0,0,0,,Anong uri ng mga damo ito?
Dialogue: 0,0:54:03.14,0:54:04.94,pangkalahatang teksto,,0,0,0,,Ito ay mga bulaklak
Dialogue: 0,0:54:05.81,0:54:08.02,pangkalahatang teksto,,0,0,0,,- Ano pang mga damo?{\i1}\N- Maid Kim
Dialogue: 0,0:54:08.52,0:54:12.11,general text,,0,0,0,,Na-offend ka ba dahil bastos ako noong araw na iyon?
Dialogue: 0,0:54:12.90,0:54:14.41,general text,,0,0,0,,So hindi na sila dumating?
Dialogue: 0,0:54:15.45,0:54:18.95,italics,,0,0,0,,Hindi ko talaga alam. Akala mo may sakit ka
Dialogue: 0,0:54:19.03,0:54:21.08,general text,,0,0,0,,Nag-alala ako at pumunta dito
Dialogue: 0,0:54:21.16,0:54:22.87,general text,,0,0,0,,Hindi ka dapat pumunta
Dialogue: 0,0:54:23.50,0:54:25.58,general text,,0,0,0,,Sabi mo hindi ka pupunta dito
Dialogue: 0,0:54:25.67,0:54:27.67,general text,,0,0,0,,Kailan ko sinabi yun?
Dialogue: 0,0:54:27.75,0:54:29.17,general text,,0,0,0,,Mali ka
Dialogue: 0,0:54:30.59,0:54:32.17,italics,,0,0,0,,Ngunit pa rin
Dialogue: 0,0:54:32.26,0:54:34.55,pangkalahatang teksto,,0,0,0,,Natutuwa akong malusog ka
Dialogue: 0,0:54:40.43,0:54:42.60,pangkalahatang teksto,,0,0,0,,Kung labis silang nag-aalala sa aking kalusugan,
Dialogue: 0,0:54:43.77,0:54:46.73,pangkalahatang teksto,,0,0,0,,kahit maaari silang magdala ng mga damo
Dialogue: 0,0:54:46.81,0:54:48.65,general text,,0,0,0,,Kailangan mo ba ng mga damo?
Dialogue: 0,0:54:49.23,0:54:50.36,general text,,0,0,0,,Dadalhin ko sila
Dialogue: 0,0:54:52.11,0:54:53.82,pangkalahatang teksto,,0,0,0,,Hindi ko sila kailangan
Dialogue: 0,0:54:53.90,0:54:57.91,pangkalahatang teksto,,0,0,0,,Hindi damo ang hinihingi ko, kundi bulaklak
Dialogue: 0,0:55:00.03,0:55:01.62,italics,,0,0,0,,Gusto kong ipakita mo
Dialogue: 0,0:55:01.70,0:55:03.29,pangkalahatang teksto,,0,0,0,,iyong alalahanin,
Dialogue: 0,0:55:04.37,0:55:06.17,general text,,0,0,0,,nagbibigay sa akin ng maganda
Dialogue: 0,0:55:12.96,0:55:16.05,general text,,0,0,0,,Nandito pa ang bisita ko, mabuti pang umalis ka
Dialogue: 0,0:55:17.22,0:55:18.47,pangkalahatang teksto,,0,0,0,,Maiden Kim
Dialogue: 0,0:55:19.30,0:55:20.51,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,0:55:21.81,0:55:25.39,pangkalahatang teksto,,0,0,0,,Kapag bumisita ka kay Uka,
Dialogue: 0,0:55:27.19,0:55:29.73,general text,,0,0,0,,sana puntahan mo ako
Dialogue: 0,0:55:32.53,0:55:34.49,pangkalahatang text,,0,0,0,,Stop...
Dialogue: 0,0:55:38.24,0:55:39.99,general text,,0,0,0,,Drives me because,
Dialogue: 0,0:55:41.16,0:55:43.20,general text,,0,0,0,,na dumating ako na walang dala?
Dialogue: 0,0:55:44.87,0:55:46.08,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,0:55:48.33,0:55:49.75,pangkalahatang teksto,,0,0,0,,Napakalamig ng dugo
Dialogue: 0,0:56:14.61,0:56:17.44,general text,,0,0,0,,Dahil mas maliit ang sapatos niya kaysa sa akin,
Dialogue: 0,0:56:18.90,0:56:20.78,general text,,0,0,0,,ibig sabihin mas maikli siya
Dialogue: 0,0:56:35.63,0:56:37.92,general text,,0,0,0,,Mahilig ka ba sa matamis?
Dialogue: 0,0:56:38.01,0:56:38.88,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:56:45.22,0:56:46.39,pangkalahatang teksto,,0,0,0,,Masarap
Dialogue: 0,0:56:47.64,0:56:49.44,pangkalahatang teksto,,0,0,0,,Pagkatapos ay kunin
Dialogue: 0,0:56:51.40,0:56:52.52,pangkalahatang teksto,,0,0,0,,Para sa akin ito
Dialogue: 0,0:57:06.95,0:57:09.00,general text,,0,0,0,,- Ano ang hitsura ko?\N- Napakaganda
Dialogue: 0,0:57:09.08,0:57:10.75,pangkalahatang text,,0,0,0,,- Subukan ito sa\N- Ako?
Dialogue: 0,0:57:10.83,0:57:11.75,general text,,0,0,0,,So paano?
Dialogue: 0,0:57:11.83,0:57:13.71,general text,,0,0,0,,Ibinitin nila siya dito
Dialogue: 0,0:57:26.76,0:57:30.56,pangkalahatang teksto,,0,0,0,,Tingnan mo, mga bulaklak
Dialogue: 0,0:57:31.23,0:57:33.27,general text,,0,0,0,,Sabi mo bumili ka ng bulaklak
Dialogue: 0,0:57:33.35,0:57:36.57,general text,,0,0,0,,Kailangan kong palamutihan ang kwarto ni Boo Young unnie kasama nila
Dialogue: 0,0:57:38.07,0:57:41.86,pangkalahatang teksto,,0,0,0,,Sa pagkakataong ito, tila, natagpuan nila siya
Dialogue: 0,0:57:49.20,0:57:52.08,general text,,0,0,0,,Talaga? Nahanap ba siya ni Jin Mu?
Dialogue: 0,0:57:53.54,0:57:55.08,general text,,0,0,0,,Secret pa rin
Dialogue: 0,0:57:56.25,0:57:59.42,general text,,0,0,0,,sana bumalik si unnie
Dialogue: 0,0:57:59.51,0:58:03.26,general text,,0,0,0,,Kung gayon hindi ka magiging Jinyowon
Dialogue: 0,0:58:03.34,0:58:06.55,general text,,0,0,0,,Pero pwede kong pakasalan ang gusto ko
Dialogue: 0,0:58:07.68,0:58:10.93,general text,,0,0,0,,Pwede mong pakasalan ang iyong mahal sa buhay
Dialogue: 0,0:58:13.44,0:58:14.77,pangkalahatang teksto,,0,0,0,,Natutuwa akong marinig
Dialogue: 0,0:58:16.73,0:58:19.27,pangkalahatang teksto,,0,0,0,,Kung gayon kailangan nating putulin ang ating pekeng pakikipag-ugnayan
Dialogue: 0,0:58:19.36,0:58:22.74,general text,,0,0,0,,Salamat sa pagpapanggap mong fiancé ko
Dialogue: 0,0:58:25.41,0:58:26.87,pangkalahatang text,,0,0,0,,Hindi ako nagpapanggap
Dialogue: 0,0:58:28.66,0:58:29.79,italics,,0,0,0,,My feelings
Dialogue: 0,0:58:31.29,0:58:32.75,pangkalahatang teksto,,0,0,0,, taos-puso
Dialogue: 0,0:58:36.42,0:58:37.84,italics,,0,0,0,,Malapit ka nang maging pinuno
Dialogue: 0,0:58:37.92,0:58:41.71,general text,,0,0,0,,Papakasalan mo ba ako? Sasama ka ba sa aming pamilya at iiwan ang lahat?
Dialogue: 0,0:58:43.01,0:58:44.13,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:58:44.97,0:58:46.68,pangkalahatang teksto,,0,0,0,,Sa tingin ko ay nag-aalala ako para sa wala
Dialogue: 0,0:58:46.76,0:58:49.14,general text,,0,0,0,,Naghahanda pa nga ako para dito,
Dialogue: 0,0:58:49.97,0:58:51.43,pangkalahatang text,,0,0,0,,na ako ay sisipain sa pamilya
Dialogue: 0,0:58:53.14,0:58:54.48,general text,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:58:55.31,0:58:58.98,pangkalahatang teksto,,0,0,0,,Nais isuko ang katayuan ng pinuno ng Sosnovy Bor para sa akin?
Dialogue: 0,0:58:59.06,0:59:01.73,general text,,0,0,0,,Sabi mo ayaw mo ng kasal na walang pagmamahal
Dialogue: 0,0:59:02.74,0:59:04.61,italics,,0,0,0,,Tapos naisip ko, kung magpakasal tayo,
Dialogue: 0,0:59:04.70,0:59:06.82,general text,,0,0,0,,magkakaroon ka ng mapagmahal na asawa
Dialogue: 0,0:59:09.37,0:59:10.53,pangkalahatang teksto,,0,0,0,,Samakatuwid...
Dialogue: 0,0:59:11.74,0:59:15.41,general text,,0,0,0,,Well, hindi mo pa nakikilala ang mahal mo
Dialogue: 0,0:59:42.36,0:59:44.23,general text,,0,0,0,,Mukhang ako na
Dialogue: 0,0:59:45.94,0:59:47.15,pangkalahatang teksto,,0,0,0,,nakilala siya
Dialogue: 0,0:59:53.70,0:59:55.95,pangkalahatang text,,0,0,0,,Kung panghawakan mo ako ng ganyan,
Dialogue: 0,1:00:00.75,1:00:02.59,general text,,0,0,0,,Hinding-hindi ko bibitawan
Dialogue: 0,1:00:03.63,1:00:05.42,italics,,0,0,0,,Ang aking damdamin ay masyadong malakas
Dialogue: 0,1:00:06.72,1:00:08.63,pangkalahatang teksto,,0,0,0,,Walang babalikan
Dialogue: 0,1:00:18.35,1:00:21.61,general text,,0,0,0,,Kailangan nating bumili ng bulaklak para makapag-propose ng maayos
Dialogue: 0,1:00:25.44,1:00:26.65,general text,,0,0,0,,Let's go
Dialogue: 0,1:00:33.91,1:00:37.58,pangkalahatang teksto,,0,0,0,,Ipadala ang mga bulaklak na ito sa pamilya Chan
Dialogue: 0,1:00:37.66,1:00:40.75,general text,,0,0,0,,May namatay ba?
Dialogue: 0,1:00:40.83,1:00:42.88,general text,,0,0,0,,Bakit mo sila pinadalhan ng chrysanthemums?
Dialogue: 0,1:00:46.59,1:00:48.67,pangkalahatang text,,0,0,0,,Muntik na akong magkamali
Dialogue: 0,1:00:48.76,1:00:49.80,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,1:00:51.01,1:00:52.26,pangkalahatang teksto,,0,0,0,,Mula rito
Dialogue: 0,1:00:53.39,1:00:54.89,pangkalahatang text,,0,0,0,,sa dito
Dialogue: 0,1:00:54.97,1:00:56.47,pangkalahatang text,,0,0,0,,Ipadala lahat
Dialogue: 0,1:00:56.56,1:00:59.14,pangkalahatang teksto,,0,0,0,,- Lahat ng mga bulaklak na ito?\N- Oo, lahat
Dialogue: 0,1:00:59.23,1:01:01.90,general text,,0,0,0,,- I'm sure magugustuhan niya kahit ano{\i1}\N- It can't be
Dialogue: 0,1:01:01.98,1:01:04.23,general text,,0,0,0,,Maraming salamat
Dialogue: 0,1:01:06.90,1:01:09.19,general text,,0,0,0,,- Alin ang gusto mo?\N- Ito ang mga ito
Dialogue: 0,1:01:09.90,1:01:12.03,general text,,0,0,0,,Mabibili ko lahat kung gusto mo
Dialogue: 0,1:01:36.64,1:01:38.68,pangkalahatang teksto,,0,0,0,,Ikaw ang magiging pinuno ng Sosnovy Bor
Dialogue: 0,1:01:39.85,1:01:42.23,general text,,0,0,0,,Bakit kayo nakikipagkita sa future head ni Jinyeowon?
Dialogue: 0,1:01:42.73,1:01:43.81,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,1:01:44.48,1:01:47.52,general text,,0,0,0,,Gusto mo bang talikuran ang iyong mana at sumali sa kanilang pamilya?
Dialogue: 0,1:01:47.61,1:01:51.20,general text,,0,0,0,,Tito, mahal namin ang isa't isa
Dialogue: 0,1:01:51.86,1:01:53.91,pangkalahatang teksto,,0,0,0,,Noon pa lang Cho Young
Dialogue: 0,1:01:54.82,1:01:56.28,general text,,0,0,0,,loved Uka
Dialogue: 0,1:01:56.91,1:01:58.95,pangkalahatang teksto,,0,0,0,,Hindi. Ngayon ay pinatunayan niya ito sa akin
Dialogue: 0,1:01:59.04,1:02:03.00,general text,,0,0,0,,Sinabi ni Cho Young na isusuko niya ang titulo ng ulo alang-alang sa pag-ibig
Dialogue: 0,1:02:03.08,1:02:04.58,general text,,0,0,0,,Iisa lang ang anak nila
Dialogue: 0,1:02:04.67,1:02:06.21,general text,,0,0,0,,Sino kaya ang magiging pinuno ng Jinyowon?
Dialogue: 0,1:02:06.79,1:02:09.25,general text,,0,0,0,,Siya ang magiging panganay na anak na babae
Dialogue: 0,1:02:09.34,1:02:12.80,general text,,0,0,0,,Tulungan sila ng mga magician ni Jeonbugwan na mahanap ang nawawala niyang kapatid.
Dialogue: 0,1:02:14.22,1:02:15.14,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:02:15.22,1:02:17.93,pangkalahatang text,,0,0,0,,Pumupunta si Deputy Jin Mu para makita sila araw-araw
Dialogue: 0,1:02:19.64,1:02:20.97,pangkalahatang teksto,,0,0,0,,Jin Mu?
Dialogue: 0,1:02:22.60,1:02:24.56,general text,,0,0,0,,Kung may kapatid lang ako,
Dialogue: 0,1:02:24.65,1:02:27.44,pangkalahatang teksto,,0,0,0,,na magiging ulo sa halip na ako
Dialogue: 0,1:02:28.86,1:02:31.32,italics,,0,0,0,,I'm asking purely out of curiosity
Dialogue: 0,1:02:32.11,1:02:35.99,general text,,0,0,0,,Tito, sigurado ka bang wala kang anak sa tabi mo?
Dialogue: 0,1:02:39.91,1:02:40.83,pangkalahatang teksto,,0,0,0,,Wala?
Dialogue: 0,1:02:42.45,1:02:43.62,pangkalahatang teksto,,0,0,0,,Sa lahat?
Dialogue: 0,1:02:46.17,1:02:47.00,pangkalahatang text,,0,0,0,,Lumabas
Dialogue: 0,1:02:48.75,1:02:50.09,pangkalahatang text,,0,0,0,,Lumabas
Dialogue: 0,1:02:50.17,1:02:51.30,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:02:51.38,1:02:52.46,pangkalahatang text,,0,0,0,,Lumabas ka!
Dialogue: 0,1:02:54.63,1:02:57.26,general text,,0,0,0,,Hindi pa huli ang lahat, pwede ka nang magkaanak
Dialogue: 0,1:02:57.34,1:02:58.30,pangkalahatang teksto,,0,0,0,,Ikaw...
Dialogue: 0,1:02:58.39,1:03:00.22,general text,,0,0,0,,Ibig kong sabihin, puno ka pa ng lakas
Dialogue: 0,1:03:02.14,1:03:04.23,pangkalahatang teksto,,0,0,0,,Hulihin ang hamak na ito!
Dialogue: 0,1:03:08.65,1:03:09.90,pangkalahatang teksto,,0,0,0,,Well, well
Dialogue: 0,1:03:20.83,1:03:23.16,general text,,0,0,0,,Bakit ang daming kulay dito?
Dialogue: 0,1:03:23.83,1:03:27.17,general text,,0,0,0,,Nakipag-away ako sa isang tao. Kaya sinusubukan niyang makipagpayapaan
Dialogue: 0,1:03:28.71,1:03:32.25,general text,,0,0,0,,sana mapatawad mo siya. Ang mga bulaklak na ito ay maganda
Dialogue: 0,1:03:34.67,1:03:36.55,general text,,0,0,0,,Napakabait mo
Dialogue: 0,1:03:37.68,1:03:39.72,pangkalahatang teksto,,0,0,0,,Nanay ni Young Master Chan...
Dialogue: 0,1:03:40.30,1:03:42.76,pangkalahatang text,,0,0,0,,ay kasingbait mo
Dialogue: 0,1:03:43.77,1:03:45.10,pangkalahatang teksto,,0,0,0,,Malamang, pinasok ito ni Uk
Dialogue: 0,1:03:47.31,1:03:48.31,pangkalahatang teksto,,0,0,0,,Mr?
Dialogue: 0,1:03:49.69,1:03:53.07,pangkalahatang teksto,,0,0,0,,Ano ang nagpaisip sa iyo?
Dialogue: 0,1:03:55.36,1:03:57.36,general text,,0,0,0,,Nang pag-usapan niya ang tungkol sa kanyang ina,
Dialogue: 0,1:03:57.45,1:03:59.20,pangkalahatang text,,0,0,0,,Nakaramdam ako ng init
Dialogue: 0,1:04:00.24,1:04:01.45,general text,,0,0,0,,Nakita ko ito sa kanyang mga mata
Dialogue: 0,1:04:02.83,1:04:03.66,pangkalahatang text,,0,0,0,,Sandali...
Dialogue: 0,1:04:04.41,1:04:07.41,general text,,0,0,0,,Nakausap ka ba niya tungkol sa nanay niya?
Dialogue: 0,1:04:08.71,1:04:10.54,general text,,0,0,0,,Dapat malapit ka sa kanya
Dialogue: 0,1:04:11.75,1:04:13.63,pangkalahatang teksto,,0,0,0,,Hindi naman
Dialogue: 0,1:04:13.71,1:04:15.71,general text,,0,0,0,,Si Young Master Chan lang ang gustong lumapit
Dialogue: 0,1:04:15.80,1:04:19.18,general text,,0,0,0,,Huling beses na nakasama niya ang ginang ng hanggang 4 na oras
Dialogue: 0,1:04:20.30,1:04:21.22,general text,,0,0,0,,Totoo ba?
Dialogue: 0,1:04:22.43,1:04:24.22,general text,,0,0,0,,Nag-usap lang kami ng konti
Dialogue: 0,1:04:26.68,1:04:29.44,general text,,0,0,0,,Ikaw pala. puting tagak
Dialogue: 0,1:04:30.69,1:04:33.77,general text,,0,0,0,,Maaaring malamig ang ginoo, nagdusa siya sa nakaraan
Dialogue: 0,1:04:33.86,1:04:37.57,pangkalahatang teksto,,0,0,0,,At kung paano magbukas sa isang tao - mabait at mapagmalasakit
Dialogue: 0,1:04:39.53,1:04:41.45,pangkalahatang text,,0,0,0,,Bisitahin kami nang mas madalas
Dialogue: 0,1:04:41.53,1:04:43.78,pangkalahatang teksto,,0,0,0,,Isaalang-alang ang lugar na ito na iyong pugad
Dialogue: 0,1:04:43.87,1:04:46.29,pangkalahatang text,,0,0,0,,at madalas pumunta dito
Dialogue: 0,1:04:47.50,1:04:48.66,pangkalahatang text,,0,0,0,,Okay
Dialogue: 0,1:04:55.38,1:04:58.88,general text,,0,0,0,,Tinutulungan ni Jin Mu si Jin Ho Kyung na mahanap ang kanyang anak?
Dialogue: 0,1:04:58.97,1:05:01.22,general text,,0,0,0,,I think this is just an excuse
Dialogue: 0,1:05:01.30,1:05:03.14,pangkalahatang text,,0,0,0,,bisitahin si Jinyeowon
Dialogue: 0,1:05:03.93,1:05:07.81,general text,,0,0,0,,Sa tingin ko gusto ni Jin Mu na humingi ng suporta kay Jinyeowon
Dialogue: 0,1:05:09.10,1:05:11.65,pangkalahatang teksto,,0,0,0,,Kung magtagumpay siya,
Dialogue: 0,1:05:12.44,1:05:15.19,general text,,0,0,0,,kaya niyang labanan ang Pine Forest
Dialogue: 0,1:05:15.27,1:05:16.27,pangkalahatang teksto,,0,0,0,,At pagkatapos...
Dialogue: 0,1:05:18.28,1:05:20.65,pangkalahatang teksto,,0,0,0,,siya at ang kanyang mga tao nang walang takot at pagsisisi
Dialogue: 0,1:05:22.66,1:05:26.20,pangkalahatang teksto,,0,0,0,,ipapakita ang kapangyarihan ng yelong bato sa mundo
Dialogue: 0,1:05:34.04,1:05:38.26,italics,,0,0,0,,Isa sa mga tao ni Jin Mu ang may bato
Dialogue: 0,1:05:40.01,1:05:43.22,italics,,0,0,0,,Akala ng lahat na ang bato ay gawa sa yelo,
Dialogue: 0,1:05:43.76,1:05:48.39,italics,,0,0,0,,ngunit ang puwersa ng apoy, tubig at hangin ay puro dito
Dialogue: 0,1:05:49.31,1:05:51.52,italics,,0,0,0,,200 taon na ang nakakaraan, isang salamangkero mula sa pamilyang Choi ang lumikha ng reflector
Dialogue: 0,1:05:52.23,1:05:56.40,italics,,0,0,0,,At ngayon ay may gumagamit ng kapangyarihan ng bato para ulitin ito
Dialogue: 0,1:06:07.78,1:06:11.50,italics,,0,0,0,,Bagong batch ng mga reflector na ginawa ng reyna
Dialogue: 0,1:06:16.67,1:06:19.42,italics,,0,0,0,,Ang kasamaan ay hindi nasa kapangyarihan ng yelong bato
Dialogue: 0,1:06:19.50,1:06:23.63,italics,,0,0,0,,Ang reflector ay kung ano ang ginagamit para sa masasamang layunin
Dialogue: 0,1:06:26.93,1:06:30.10,italics,,0,0,0,,Isang puwersa na lampas sa kontrol ng isang ordinaryong tao,
Dialogue: 0,1:06:30.18,1:06:32.43,italics,,0,0,0,,gustong makuha ang lahat kung ito ay magagamit
Dialogue: 0,1:06:33.64,1:06:36.19,italics,,0,0,0,,Ang kapangyarihang umalis sa lumang katawan
Dialogue: 0,1:06:36.27,1:06:38.02,italics,,0,0,0,,at kumuha ng bago
Dialogue: 0,1:06:39.77,1:06:44.07,italics,,0,0,0,,Isang lumang katawan kapalit ng isang bata, isang pangit para sa isang maganda
Dialogue: 0,1:06:45.36,1:06:49.03,italics,,0,0,0,,Ang kapangyarihang pigilan ang kamatayan at gawing walang hanggan ang buhay
Dialogue: 0,1:07:04.72,1:07:07.89,pangkalahatang teksto,,0,0,0,,Siya ay isang bata, malusog at kahanga-hangang binata
Dialogue: 0,1:07:08.47,1:07:09.47,pangkalahatang teksto,,0,0,0,,Napili ito...
Dialogue: 0,1:07:10.39,1:07:13.64,pangkalahatang teksto,,0,0,0,,ng kahalili ko
Dialogue: 0,1:07:14.43,1:07:16.56,general text,,0,0,0,,gusto kong mag-migrate sa katawan niya
Dialogue: 0,1:07:17.85,1:07:19.27,pangkalahatang teksto,,0,0,0,,Guro
Dialogue: 0,1:07:20.27,1:07:22.65,general text,,0,0,0,,Anong spell ang gusto mong ipakita sa akin?
Dialogue: 0,1:07:23.24,1:07:24.57,pangkalahatang teksto,,0,0,0,,Alchemy of souls
Dialogue: 0,1:07:25.15,1:07:26.40,pangkalahatang teksto,,0,0,0,,Alchemy of souls?
Dialogue: 0,1:07:28.07,1:07:32.83,general text,,0,0,0,,Marami pa akong dapat gawin,
Dialogue: 0,1:07:33.45,1:07:37.21,general text,,0,0,0,,ngunit hindi maganda ang katawan na ito, ang sakit ay naglalapit sa kanyang nalalapit na kamatayan
Dialogue: 0,1:07:38.46,1:07:39.54,pangkalahatang teksto,,0,0,0,,Samakatuwid...
Dialogue: 0,1:07:40.96,1:07:43.21,pangkalahatang teksto,,0,0,0,,Kailangan ko ang iyong katawan
Dialogue: 0,1:07:47.55,1:07:48.72,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:08:05.99,1:08:09.20,pangkalahatang teksto,,0,0,0,,Magsimula tayo sa alchemy ng mga kaluluwa
Dialogue: 0,1:08:17.21,1:08:19.25,pangkalahatang text,,0,0,0,,Guro, ayaw kong lumipat ng katawan
Dialogue: 0,1:08:19.83,1:08:22.25,general text,,0,0,0,,Kung lumipat ako ng katawan sa iyo, malapit na akong mamatay
Dialogue: 0,1:08:22.34,1:08:24.30,pangkalahatang teksto,,0,0,0,,Ngunit mabubuhay ang iyong katawan
Dialogue: 0,1:08:35.39,1:08:36.52,italics,,0,0,0,,Tulong
Dialogue: 0,1:08:37.14,1:08:38.44,pangkalahatang text,,0,0,0,,Iligtas mo ako
Dialogue: 0,1:08:39.23,1:08:42.15,pangkalahatang text,,0,0,0,,Tulungan mo ako! Tulong!
Dialogue: 0,1:08:44.61,1:08:46.32,pangkalahatang teksto,,0,0,0,,Guro!
Dialogue: 0,1:10:33.84,1:10:35.01,pangkalahatang teksto,,0,0,0,,Guro
Dialogue: 0,1:10:36.01,1:10:37.01,pangkalahatang teksto,,0,0,0,,Katawan ko...
Dialogue: 0,1:10:37.10,1:10:38.93,pangkalahatang teksto,,0,0,0,,Ibalik ang lahat
Dialogue: 0,1:10:39.51,1:10:41.73,pangkalahatang teksto,,0,0,0,,Pakiusap. Ayokong mamatay
Dialogue: 0,1:10:41.81,1:10:44.31,pangkalahatang teksto,,0,0,0,,Guro! Ibigay mo sa akin ang aking katawan
Dialogue: 0,1:10:44.39,1:10:47.11,pangkalahatang teksto,,0,0,0,,Guro! Gusto kong bumalik sa katawan ko
Dialogue: 0,1:10:47.19,1:10:49.11,italics,,0,0,0,,Guro!
Dialogue: 0,1:10:50.57,1:10:54.86,pangkalahatang teksto,,0,0,0,,Nakatulong ang Alchemy of souls na iligtas ang buhay ng iba
Dialogue: 0,1:10:55.70,1:10:56.91,pangkalahatang teksto,,0,0,0,,mahalagang salamangkero
Dialogue: 0,1:11:06.71,1:11:07.92,pangkalahatang teksto,,0,0,0,,Habang kami
Dialogue: 0,1:11:08.92,1:11:10.67,pangkalahatang teksto,,0,0,0,,mayroon tayong kapangyarihan ng bato,
Dialogue: 0,1:11:10.75,1:11:14.30,pangkalahatang teksto,,0,0,0,,ang ating kaluluwa ay mabubuhay magpakailanman, at hindi mabubulok sa mga katawang ito
Dialogue: 0,1:11:15.34,1:11:18.47,italics,,0,0,0,,Ngayon ang kapangyarihan ng bato ay ipinagbabawal,
Dialogue: 0,1:11:18.55,1:11:21.97,pangkalahatang teksto,,0,0,0,,kaya kailangan mong gumawa ng alchemy nang patago
Dialogue: 0,1:11:22.06,1:11:26.27,general text,,0,0,0,,Ngunit maya-maya darating ang araw na lalakas ang ating lakas
Dialogue: 0,1:11:26.35,1:11:29.77,general text,,0,0,0,,Ipapakita namin sa lahat na tama kami. Magbubunga ang ating pagsusumikap
Dialogue: 0,1:11:31.15,1:11:32.40,pangkalahatang teksto,,0,0,0,,At sa araw na ito
Dialogue: 0,1:11:33.53,1:11:35.11,pangkalahatang teksto,,0,0,0,,lahat naroroon dito...
Dialogue: 0,1:11:35.65,1:11:39.03,pangkalahatang teksto,,0,0,0,,matatalo ang kamatayan at magtamo ng buhay na walang hanggan
Dialogue: 0,1:12:02.35,1:12:03.93,general text,,0,0,0,,Nakita mo ba lahat?
Dialogue: 0,1:12:06.89,1:12:07.98,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:12:08.06,1:12:12.48,general text,,0,0,0,,Dapat kang magdala ng isang tao dito
Dialogue: 0,1:12:13.98,1:12:17.82,general text,,0,0,0,,Magiging nanay mo si Jin Ho Kyung. Get closer to her
Dialogue: 0,1:12:17.90,1:12:20.74,pangkalahatang teksto,,0,0,0,,At pagkatapos ay dalhin siya dito
Dialogue: 0,1:12:22.62,1:12:24.04,general text,,0,0,0,,Kaya mo ba?
Dialogue: 0,1:12:27.79,1:12:28.87,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:12:38.88,1:12:40.30,italics,,0,0,0,,Nakasya siya
Dialogue: 0,1:12:41.34,1:12:43.72,italics,,0,0,0,,Kung pwede mong dalhin dito si Jin Ho Kyung,
Dialogue: 0,1:12:45.01,1:12:49.02,pangkalahatang teksto,,0,0,0,,mas madaling ipakita ang kapangyarihan ng bato sa buong mundo
Dialogue: 0,1:13:40.65,1:13:42.28,general text,,0,0,0,,Bakit hindi ka pa natutulog?
Dialogue: 0,1:13:53.50,1:13:55.46,italics,,0,0,0,,Jin Mu ay maaaring maging
Dialogue: 0,1:13:55.54,1:13:59.71,pangkalahatang teksto,,0,0,0,,mas malakas at mas maimpluwensyang kaysa sa inaakala natin
Dialogue: 0,1:14:00.97,1:14:05.01,general text,,0,0,0,,Tiyak na lumitaw ang bituin ng Hari upang maalis ang kaguluhang dulot ng bato
Dialogue: 0,1:14:07.47,1:14:10.10,general text,,0,0,0,,Uke ba ang sinasabi mo?
Dialogue: 0,1:14:10.18,1:14:13.94,pangkalahatang teksto,,0,0,0,,Master So Kyung, na pumigil sa kakila-kilabot dalawang daang taon na ang nakakaraan,
Dialogue: 0,1:14:14.02,1:14:16.23,pangkalahatang teksto,,0,0,0,,ipinanganak din sa ilalim ng katulad na bituin
Dialogue: 0,1:14:16.31,1:14:18.11,pangkalahatang teksto,,0,0,0,,Ang bituin na ito ay nilikha ng mahika
Dialogue: 0,1:14:18.19,1:14:20.07,general text,,0,0,0,,Hindi siya maikukumpara sa bida ni Master Seo Kyung
Dialogue: 0,1:14:21.36,1:14:24.20,general text,,0,0,0,,Nabanggit ko ba na pareho ang bituin?
Dialogue: 0,1:14:26.03,1:14:27.70,general text,,0,0,0,,Kaya curious ako
Dialogue: 0,1:14:30.79,1:14:34.92,general text,,0,0,0,,I wonder if this star will slowly to out
Dialogue: 0,1:14:36.29,1:14:37.88,pangkalahatang teksto,,0,0,0,,o ito ba ay magniningning nang maliwanag?
Dialogue: 0,1:15:16.08,1:15:17.13,italics,,0,0,0,,Victory!
Dialogue: 0,1:15:17.21,1:15:19.67,italics,,0,0,0,,- Magaling\N- Good job
Dialogue: 0,1:15:19.75,1:15:20.84,italics,,0,0,0,,alam ko na
Dialogue: 0,1:16:03.76,1:16:05.38,pangkalahatang text,,0,0,0,,Alam ko ang tungkol kay Tansu
Dialogue: 0,1:16:06.13,1:16:08.22,italics,,0,0,0,,Hindi alam ng prinsipe, kaya ginawa mo
Dialogue: 0,1:16:08.30,1:16:11.22,pangkalahatang teksto,,0,0,0,,At tubig mula sa lusak na nakita ng lahat
Dialogue: 0,1:16:11.30,1:16:12.51,pangkalahatang teksto,,0,0,0,,Madali kasing pie
Dialogue: 0,1:16:26.69,1:16:27.95,italics,,0,0,0,,Victory!
Dialogue: 0,1:16:29.78,1:16:32.62,italics,,0,0,0,,- Napakahusay!\N- Kamangha-manghang!
Dialogue: 0,1:16:52.05,1:16:54.26,pangkalahatang teksto,,0,0,0,,Tatlong palaka na lang ang natitira?
Dialogue: 0,1:16:54.35,1:16:55.60,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:16:56.56,1:16:59.69,general text,,0,0,0,,So, pitong sunod-sunod na araw siyang lumalaban?
Dialogue: 0,1:16:59.77,1:17:01.85,pangkalahatang teksto,,0,0,0,,At patuloy na nawawala
Dialogue: 0,1:17:03.36,1:17:06.19,general text,,0,0,0,,Akala ko titigil siya kapag natalo siya.
Dialogue: 0,1:17:09.07,1:17:11.07,pangkalahatang teksto,,0,0,0,,Malamang, sinusubukan niya ito
Dialogue: 0,1:17:11.16,1:17:14.70,pangkalahatang text,,0,0,0,,Gaya ng sabi mo, hindi siya mahusay gumamit ng espada, mahina ang spells niya.
Dialogue: 0,1:17:14.78,1:17:16.20,general text,,0,0,0,,Ngunit patuloy siyang lumalaban...
Dialogue: 0,1:17:16.29,1:17:18.83,pangkalahatang text,,0,0,0,,dahil lang siya matiyaga
Dialogue: 0,1:17:19.33,1:17:22.96,general text,,0,0,0,,Mga tunggalian lang ito, pero araw-araw siyang nakikipag-away sa ibang salamangkero
Dialogue: 0,1:17:23.04,1:17:24.59,italics,,0,0,0,,Talagang pagod na siya
Dialogue: 0,1:17:24.67,1:17:27.67,pangkalahatang teksto,,0,0,0,,Kamahalan, naniniwala ako sa iyong tagumpay
Dialogue: 0,1:17:27.76,1:17:30.72,general text,,0,0,0,, Kahit ako ay hindi nagkaroon ng pagkakataon na labanan ang mga salamangkero ng Jeonjingak
Dialogue: 0,1:17:30.80,1:17:33.26,general text,,0,0,0,,Pero hinayaan ko si Chan Wook na gawin ito...
Dialogue: 0,1:17:33.34,1:17:35.60,pangkalahatang teksto,,0,0,0,,para sa sarili mong mga gintong palaka
Dialogue: 0,1:17:35.68,1:17:37.68,general text,,0,0,0,,Naloko na naman ako ni Won Mu Deok?
Dialogue: 0,1:17:57.87,1:18:00.79,behind the scenes,,0,0,0,,Labanan at matalo, Chan Wook
Dialogue: 0,1:18:15.30,1:18:18.22,behind the scenes,,0,0,0,,Lahat ng hindi pumapatay sa iyo,
Dialogue: 0,1:18:23.19,1:18:26.15,behind the scenes,,0,0,0,,nagpapalakas ka lang
Dialogue: 0,1:18:59.56,1:19:01.77,preview,,0,0,0,,- Chan Wook!\N- Nakarating ka na ba sa may-ari?
Dialogue: 0,1:19:01.85,1:19:04.10,preview,,0,0,0,,Let him lose, he becomes stronger
Dialogue: 0,1:19:05.69,1:19:06.52,preview,,0,0,0,,Huwag pumunta
Dialogue: 0,1:19:06.60,1:19:08.40,preview,,0,0,0,,Huwag kang pumunta sa kwarto mo, manatili dito
Dialogue: 0,1:19:08.48,1:19:11.07,preview,,0,0,0,,Nakakatakot! Tumingin sa sapatos. Basa lahat
Dialogue: 0,1:19:11.15,1:19:12.40,preview,,0,0,0,,Nasugatan ka
Dialogue: 0,1:19:13.99,1:19:17.49,preview,,0,0,0,,May kaguluhan sa kabisera. Kagabi ay inatake siya ng ilang mga assassin
Dialogue: 0,1:19:18.57,1:19:20.83,preview,,0,0,0,,- Huwag mo siyang patayin!\N- Patayin mo siya!
Dialogue: 0,1:19:21.79,1:19:23.87,preview,,0,0,0,,- Isa siyang nomad\N- Lumabas ka!
Dialogue: 0,1:19:23.96,1:19:25.58,preview,,0,0,0,,- Pupunta ako\N- Chan Wook
Dialogue: 0,1:19:25.67,1:19:29.96,preview,,0,0,0,,I don't think it's right to let go of a magician who just got here so easily
Dialogue: 0,1:19:30.04,1:19:32.13,preview,,0,0,0,,Kapag naging wild ka, hindi ka na makakabalik
Dialogue: 0,1:19:32.21,1:19:34.22,preview,,0,0,0,,Hindi ka maaaring maging isang tao, isang halimaw lamang
Dialogue: 0,1:19:34.30,1:19:36.88,preview,,0,0,0,,Maaari nating protektahan ang mga halimaw sa mundong ito
Dialogue: 0,1:19:39.60,1:19:44.60,preview,,0,0,0,,
Dialogue: 0,1:19:44.60,1:19:46.60,pangkalahatang teksto,,0,0,0,,
