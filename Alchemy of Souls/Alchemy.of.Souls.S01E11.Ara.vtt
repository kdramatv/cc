Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,niks,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، Tommo، Zero Amamiya
Dialogue: 0,0:00:43.53,0:00:45.95,نقشات,,0,0,0,,نستأجر خدمًا في سوسنوفي بور
Dialogue: 0,0:00:46.03,0:00:47.49,نص عام,,0,0,0,,هذه ليست رسالة
Dialogue: 0,0:00:48.54,0:00:49.75,نص عام,,0,0,0,,ما هذا إذن؟
Dialogue: 0,0:00:49.83,0:00:52.83,النص العام,,0,0,0,,إذا كان ينقل مشاعرك فهذه رسالة
Dialogue: 0,0:00:57.80,0:01:00.05,نص عام,,0,0,0,,ربما بدوت مثيراً للشفقة في محاولاتي
Dialogue: 0,0:01:00.84,0:01:02.38,نص عام,,0,0,0,,تعال هنا كخادم
Dialogue: 0,0:01:03.43,0:01:06.35,نص عام,,0,0,0,,لقد كنت معلمًا ذا خبرة لا تصدق
Dialogue: 0,0:01:06.43,0:01:08.18,نص عام,,0,0,0,,أشعر بالأسف عليك
Dialogue: 0,0:01:09.18,0:01:11.60,النص العام,,0,0,0,,على الأقل تعلمت الولاء\N وقمت بواجباتك
Dialogue: 0,0:01:11.68,0:01:13.85,نص عام,,0,0,0,,لقد حاول معلمي جاهداً من أجلي
Dialogue: 0,0:01:13.94,0:01:17.19,نص عام,,0,0,0,,اعتقدت أنني يجب أن أبذل قصارى جهدي
Dialogue: 0,0:01:19.44,0:01:20.86,نص عام,,0,0,0,,هل أزعجك هذا الأمر؟
Dialogue: 0,0:01:20.94,0:01:23.65,نص عام,,0,0,0,,ليس حقًا. لكنني شككت
Dialogue: 0,0:01:24.49,0:01:29.29,نص عام,,0,0,0,,أجيبك كطالب أو أستاذ
Dialogue: 0,0:01:29.87,0:01:32.54,نص عام,,0,0,0,,أو أجب بأسلوب ما قرأته
Dialogue: 0,0:01:33.66,0:01:35.33,نص عام,,0,0,0,,وماذا قرأت؟
Dialogue: 0,0:01:36.13,0:01:39.96,نص عام,,0,0,0,,ثم أجيب بنفس السؤال؟
Dialogue: 0,0:01:41.46,0:01:43.01,نص عام,,0,0,0,,نفس الشيء؟ ما الذي تتحدث عنه؟
Dialogue: 0,0:01:44.05,0:01:45.26,نص عام,,0,0,0,,إنه مكتوب هناك
Dialogue: 0,0:01:45.34,0:01:47.76,النص العام,,0,0,0,،"سأخوض في كل شيء فقط لأراك"
Dialogue: 0,0:01:48.39,0:01:51.64,general text,,0,0,0,،"أستطيع أن أفعل أي شيء، فقط لأحظى بفرصة رؤيتك"
Dialogue: 0,0:01:52.31,0:01:53.81,نص عام,,0,0,0,,وهذا جوابي
Dialogue: 0,0:02:05.11,0:02:06.57,نص عام,,0,0,0,,واشتقت لك أيضاً
Dialogue: 0,0:02:10.45,0:02:11.79,نص عام,,0,0,0,,هذه إجابتي
Dialogue: 0,0:02:41.40,0:02:43.23,نص عام,,0,0,0,,سأتظاهر بأنني لم أسمع هذا
Dialogue: 0,0:02:43.86,0:02:45.28,نص عام,,0,0,0,,وانسى الرسالة
Dialogue: 0,0:02:50.45,0:02:51.95,نص عام,,0,0,0,,لا يمكنك التخلص من شيء ما،
Dialogue: 0,0:02:52.79,0:02:54.50,نص عام,,0,0,0,,إذا تمت مشاركته بالفعل مع شخص ما
Dialogue: 0,0:02:57.00,0:02:58.33,نص عام,,0,0,0,,يمكنك التخلص من
Dialogue: 0,0:03:01.04,0:03:02.63,نص عام,,0,0,0,,يمكن حرقه,
Dialogue: 0,0:03:03.96,0:03:05.67,نص عام,,0,0,0,,وكأن الأمر لم يحدث قط
Dialogue: 0,0:03:07.05,0:03:09.22,general text,,0,0,0,,هل تظن أنك ستحرقها والرسالة غير موجودة؟
Dialogue: 0,0:03:10.14,0:03:11.39,نص عام,,0,0,0,,الآن فقط أيها المعلم،
Dialogue: 0,0:03:12.14,0:03:13.47,نص عام,,0,0,0,,تلميذتك
Dialogue: 0,0:03:14.22,0:03:16.77,نص عام,,0,0,0,,تعلمت رؤية ما لا يمكن رؤيته
Dialogue: 0,0:03:19.06,0:03:22.48,النص العام,,0,0,0,,قرأت "كلمات من القلب". هل تريد التحقق؟
Dialogue: 0,0:03:24.57,0:03:26.32,نص عام,,0,0,0,,نحن بحاجة إلى التركيز،
Dialogue: 0,0:03:26.40,0:03:29.32,نص عام,,0,0,0,,لقراءة ما لا يمكنك رؤيته
Dialogue: 0,0:03:30.70,0:03:31.82,نص عام,,0,0,0,,وبعد ذلك...
Dialogue: 0,0:03:35.20,0:03:37.33,نص عام,,0,0,0,,قل اسم المرسل إليه
Dialogue: 0,0:03:39.87,0:03:41.00,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:03:42.71,0:03:44.67,خارج الشاشة,,0,0,0,,إشارة واضحة ولكنها خطيرة
Dialogue: 0,0:03:45.42,0:03:48.30,التعليق الصوتي,,0,0,0,,أنا أحبه
Dialogue: 0,0:03:51.59,0:03:52.97,نص عام,,0,0,0,,حسنًا، ها أنت ذا. قرأت
Dialogue: 0,0:03:54.51,0:03:56.85,نص عام,,0,0,0,,هناك شيء يصعب قراءته لأنه مخفي،
Dialogue: 0,0:03:56.93,0:03:58.06,نص عام,,0,0,0,,ولكنه موجود
Dialogue: 0,0:04:03.31,0:04:06.19,general text,,0,0,0,,لقد رأيت العلامة في عيني، وعلمت أنني بدوي،
Dialogue: 0,0:04:07.82,0:04:09.36,نص عام,,0,0,0,,لفت انتباهي
Dialogue: 0,0:04:11.24,0:04:13.16,نص عام,,0,0,0,,الآن رأيت نقطة ضعفي الأخرى
Dialogue: 0,0:04:13.24,0:04:15.12,نص عام,,0,0,0,,إذا كان هذا هو ضعفك،
Dialogue: 0,0:04:15.99,0:04:17.33,نص عام,,0,0,0,,وأنا أيضًا
Dialogue: 0,0:04:19.37,0:04:21.71,نص عام,,0,0,0,,رسالتك هي جوابي
Dialogue: 0,0:04:21.79,0:04:23.46,نص عام,,0,0,0,,لذا لدينا نقطة ضعف واحدة
Dialogue: 0,0:04:24.79,0:04:28.26,النص العام,,0,0,0,,أعتقد أنني لا أمانع في مشاركة نقاط ضعفك
Dialogue: 0,0:04:30.76,0:04:33.18,نص عام,,0,0,0,,بصراحة كنت قلقة
Dialogue: 0,0:04:33.84,0:04:35.89,نص عام,,0,0,0,,لقد وجدت أخيرًا ما أردته
Dialogue: 0,0:04:36.51,0:04:40.68,general text,,0,0,0,,ولن أستطيع فعل أي شيء حتى لو تركتني
Dialogue: 0,0:04:41.35,0:04:44.94,نص عام,,0,0,0,,حتى أنني فكرت في تسميمك
Dialogue: 0,0:04:45.02,0:04:46.77,نص عام,,0,0,0,,والعثور على شيء لتشويه سمعته
Dialogue: 0,0:04:48.19,0:04:49.32,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:04:50.74,0:04:53.28,نص عام,,0,0,0,,يبدو أنك مسموم بالفعل
Dialogue: 0,0:04:54.91,0:04:55.99,نص عام,,0,0,0,,مسمومة؟
Dialogue: 0,0:04:56.07,0:04:58.20,النص العام,,0,0,0,,سوف تصبح ضعيفاً وعاجزاً
Dialogue: 0,0:04:58.70,0:05:01.25,نص عام,,0,0,0,,لا مفر من هذا السم
Dialogue: 0,0:05:02.21,0:05:04.33,نص عام,,0,0,0,,الترياق هو الشخص الذي سممك
Dialogue: 0,0:05:04.42,0:05:07.00,نص عام,,0,0,0,,لذا اشتقت إليك لأنني،
Dialogue: 0,0:05:07.88,0:05:09.55,نص عام,,0,0,0,,ما الذي تم تسميمه؟
Dialogue: 0,0:05:10.46,0:05:11.55,نص عام,,0,0,0,,نعم
Dialogue: 0,0:05:12.17,0:05:14.64,النص العام,,0,0,0,,لقد تسممت بلا رحمة على يد محارب الظل
Dialogue: 0,0:05:15.26,0:05:16.60,نص عام,,0,0,0,,فكر بهذه الطريقة
Dialogue: 0,0:05:17.72,0:05:19.35,نص عام,,0,0,0,,هذا ليس بعيدًا عن الحقيقة
Dialogue: 0,0:05:20.68,0:05:22.06,نص عام,,0,0,0,,هل هو سم إذن؟
Dialogue: 0,0:05:23.64,0:05:26.44,نص عام,,0,0,0,,حسنًا، نعم، كان الأمر غريبًا بين الجميع
Dialogue: 0,0:05:27.82,0:05:28.86,نص عام,,0,0,0,,اشتقت لك
Dialogue: 0,0:05:29.94,0:05:32.28,النص العام,,0,0,0,,كنت دائمًا تهدد بقتلي
Dialogue: 0,0:05:32.36,0:05:34.15,النص العام,,0,0,0,,حتى أنها رمتني بسكين
Dialogue: 0,0:05:34.24,0:05:36.62,general text,,0,0,0,,ضحكت عليّ، كدت أن أفقد ذراعي
Dialogue: 0,0:05:36.70,0:05:38.41,نص عام,,0,0,0,,وعندك الجرأة على الكذب
Dialogue: 0,0:05:38.99,0:05:40.74,النص العام,,0,0,0,,لقد كنت قاسياً معي،
Dialogue: 0,0:05:40.83,0:05:43.00,نص عام,,0,0,0,,لكنني لا أستطيع إلا أن أفكر فيك
Dialogue: 0,0:05:43.08,0:05:44.96,النص العام,,0,0,0,,افتح عيني - أنا أفتقدك بالفعل
Dialogue: 0,0:05:45.04,0:05:48.54,النص العام,,0,0,0,,أفتقدك طوال اليوم، حتى عندما أذهب إلى السرير
Dialogue: 0,0:05:48.63,0:05:50.00,نص عام,,0,0,0,,- Stop\N- لماذا؟
Dialogue: 0,0:05:50.09,0:05:52.46,general text,,0,0,0,,اعترفت بمشاعري فشبهتها بالسم
Dialogue: 0,0:05:52.55,0:05:55.43,النص العام,,0,0,0,,لذا على الأقل استمع إلى الأعراض التي أعاني منها
Dialogue: 0,0:05:55.51,0:05:57.01,نص عام,,0,0,0,,أنت ترياقي
Dialogue: 0,0:05:58.35,0:06:02.98,النص العام,,0,0,0,,قلت للتو إنني أفتقدك، أيها المحارب الظل الرهيب
Dialogue: 0,0:06:03.06,0:06:04.56,نص عام,,0,0,0,,وتقول إني مسموم
Dialogue: 0,0:06:04.64,0:06:07.19,نص عام,,0,0,0,,تحمل الآن شكاوي بشأن الأعراض
Dialogue: 0,0:06:07.27,0:06:08.56,النص العام,,0,0,0,,لقد تسممت بعد كل شيء
Dialogue: 0,0:06:08.65,0:06:11.02,نص عام,,0,0,0,,ليس لدي ما أخجل منه
Dialogue: 0,0:06:11.11,0:06:13.90,general text,,0,0,0,,بما أنك ترياق فهذا يعني أنك مرتبط بالتسمم
Dialogue: 0,0:06:26.75,0:06:30.25,النص العام,,0,0,0,,هذا هو ابن شقيق رئيس سوسنوفي بور
Dialogue: 0,0:06:30.34,0:06:33.55,النص العام,,0,0,0,,والفصل التالي
Dialogue: 0,0:06:38.22,0:06:41.72,النص العام,,0,0,0,,جئت لأسلم عليك نيابة عن الرئيس
Dialogue: 0,0:06:42.51,0:06:44.60,النص العام,,0,0,0,,مبروك انضمامك إلى سوسنوفي بور
Dialogue: 0,0:06:45.68,0:06:46.69,نص عام,,0,0,0,,أحسنت
Dialogue: 0,0:06:48.98,0:06:52.36,النص العام,,0,0,0,,لقد قمت بعمل جيد اليوم
Dialogue: 0,0:06:52.90,0:06:56.74,النص العام,,0,0,0,,اليوم سيُعرض عليكم الخمر واللحم
Dialogue: 0,0:06:57.49,0:06:58.86,نص عام,,0,0,0,,يمكنك الاستمتاع ببعض المرح
Dialogue: 0,0:07:00.57,0:07:02.70,نص عام,,0,0,0,,اذهب وكل واشرب
Dialogue: 0,0:07:04.08,0:07:05.54,نص عام,,0,0,0,,اتبعني
Dialogue: 0,0:07:08.46,0:07:09.33,نص عام,,0,0,0,,سيدي.
Dialogue: 0,0:07:10.17,0:07:12.34,نص عام,,0,0,0,,هل أنت على دراية بمو ديوك؟
Dialogue: 0,0:07:12.42,0:07:14.25,نص عام,,0,0,0,,نجحت اليوم في الامتحان
Dialogue: 0,0:07:15.34,0:07:18.26,نص عام,,0,0,0,,الخادم الذي جاء أخيرًا
Dialogue: 0,0:07:20.05,0:07:23.01,نقوش,,0,0,0,,مائة وخمسة وعشرون
Dialogue: 0,0:07:38.90,0:07:40.78,ذكريات,,0,0,0,,الرقم 125، مو دوك
Dialogue: 0,0:07:43.20,0:07:44.53,ذكريات,,0,0,0,,مرت!
Dialogue: 0,0:07:53.46,0:07:55.55,نص عام,,0,0,0,,أنا أعرف مو دوك جيدًا
Dialogue: 0,0:07:56.63,0:07:59.34,general text,,0,0,0,,لقد فقدت الوعي وتم نقلها إلى سيجوكون
Dialogue: 0,0:07:59.42,0:08:01.89,نص عام,,0,0,0,,يجب أن أعيد لها أغراضها
Dialogue: 0,0:08:03.39,0:08:06.85,نص عام,,0,0,0,,وأعط التميمة للدخول
Dialogue: 0,0:08:07.43,0:08:09.52,general text,,0,0,0,,هل ما زالت في سايجوكون؟
Dialogue: 0,0:08:10.52,0:08:12.40,نص عام,,0,0,0,,أعطني إياه. سوف أنقلها
Dialogue: 0,0:08:13.40,0:08:14.82,نص عام,,0,0,0,,لقد قمت بعمل جيد اليوم
Dialogue: 0,0:08:20.61,0:08:22.20,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:08:46.97,0:08:48.18,ذكريات,,0,0,0,,مو دوك...
Dialogue: 0,0:09:08.41,0:09:11.96,ذكريات,,0,0,0,,لقد ضاعت لأن في رأسك
Dialogue: 0,0:09:12.04,0:09:14.46,ذكريات,,0,0,0,,أفكار كثيرة جدًا
Dialogue: 0,0:09:15.63,0:09:18.17,ذكريات,,0,0,0,,عندما يحدث هذا، فكر في شيء واحد
Dialogue: 0,0:09:19.80,0:09:23.68,التعليق الصوتي,,0,0,0,,ناك سو، الشخص الوحيد الذي تفكر فيه هو تشان ووك
Dialogue: 0,0:09:39.15,0:09:40.23,نص عام,,0,0,0,,استمع يا يول
Dialogue: 0,0:09:41.03,0:09:43.82,نص عام,,0,0,0,,نظرت بالخطأ إلى حقيبة مو ديوك
Dialogue: 0,0:09:45.32,0:09:48.20,نص عام,,0,0,0,,ووجدت شيئاً غريباً
Dialogue: 0,0:09:50.04,0:09:52.75,general text,,0,0,0,,هذه صافرتك، أليس كذلك؟
Dialogue: 0,0:09:53.66,0:09:55.29,نص عام,,0,0,0,,الذي فقدته في دانهيانغوك
Dialogue: 0,0:09:56.88,0:09:58.38,نص عام,,0,0,0,,نعم لي
Dialogue: 0,0:09:59.17,0:10:01.55,general text,,0,0,0,,إذن لماذا يمتلكه مو دوك؟
Dialogue: 0,0:10:14.18,0:10:16.06,نص عام,,0,0,0,,هل رأيت السيد دان جو؟
Dialogue: 0,0:10:16.69,0:10:19.23,نص عام,,0,0,0,,لديه أغراضي وتميمة للدخول
Dialogue: 0,0:10:23.74,0:10:25.32,نص عام,,0,0,0,,أعطانيهم
Dialogue: 0,0:10:25.90,0:10:26.74,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:10:27.36,0:10:28.70,نص عام,,0,0,0,,سأخذ
Dialogue: 0,0:10:37.92,0:10:41.80,النص العام,,0,0,0,,لقد فقدته في دانهيانغوك. هل وجدته هناك؟
Dialogue: 0,0:10:44.92,0:10:46.05,نص عام,,0,0,0,,نعم
Dialogue: 0,0:10:46.55,0:10:49.47,نص عام,,0,0,0,,لقد أخذته لأن...
Dialogue: 0,0:10:52.72,0:10:54.47,نص عام,,0,0,0,,في حبي
Dialogue: 0,0:10:57.85,0:10:59.77,نص عام,,0,0,0,,لقد قلت ذلك بنفسك
Dialogue: 0,0:11:01.27,0:11:03.48,نص عام,,0,0,0,,هذا الشرح كافي
Dialogue: 0,0:11:09.87,0:11:11.49,نص عام,,0,0,0,,سأخذ أغراضي،
Dialogue: 0,0:11:12.12,0:11:13.54,النص العام,,0,0,0,,وأنت تطلق الصافرة
Dialogue: 0,0:11:18.21,0:11:21.21,نص عام,,0,0,0,,لقد أخبرت دان جو أنني أعطيتك إياها
Dialogue: 0,0:11:22.54,0:11:23.96,نص عام,,0,0,0,,لا أستطيع التراجع
Dialogue: 0,0:11:26.59,0:11:28.26,general text,,0,0,0,,لماذا تعطيني إياها؟
Dialogue: 0,0:11:28.34,0:11:30.93,النص العام,,0,0,0,,لم تصدقي عندما اعترفت بحبي
Dialogue: 0,0:11:32.51,0:11:34.64,النص العام,,0,0,0,,إذن كان عليك أن تجعلني أصدق
Dialogue: 0,0:11:42.19,0:11:46.32,نص عام,,0,0,0,,كنت أسخر منهم فقط
Dialogue: 0,0:11:46.90,0:11:49.61,النص العام,,0,0,0,,ومو دوك يحب يوليا حقًا
Dialogue: 0,0:11:50.20,0:11:52.20,نص عام,,0,0,0,,وبالنظر إلى هدية جوليا،
Dialogue: 0,0:11:52.28,0:11:54.78,general text,,0,0,0,,أعتقد أنه يتنفس بشكل غير متساو تجاهها أيضًا
Dialogue: 0,0:11:55.70,0:11:57.83,general text,,0,0,0,,من المحتمل أنها طلبت هذه الصافرة
Dialogue: 0,0:11:58.41,0:11:59.92,نص عام,,0,0,0,,عندما تحتاج إلى شيء ما،
Dialogue: 0,0:12:00.00,0:12:02.00,النص العام,,0,0,0,,إنها تكذب وتهرب بسهولة
Dialogue: 0,0:12:03.34,0:12:06.71,general text,,0,0,0,,حتى أن يول علمت بمشاركتها في الامتحان
Dialogue: 0,0:12:06.80,0:12:09.30,نص عام,,0,0,0,,أجاب على كل الأسئلة من أجلها
Dialogue: 0,0:12:09.38,0:12:12.43,النص العام,,0,0,0,,بالتأكيد طلبت منه المساعدة،
Dialogue: 0,0:12:12.51,0:12:14.68,نص عام,,0,0,0,,لأنني نفسي غبي جدًا
Dialogue: 0,0:12:15.89,0:12:17.43,نص عام,,0,0,0,,إنها تحصل دائمًا على ما تريد
Dialogue: 0,0:12:18.48,0:12:19.81,نص عام,,0,0,0,,والأهم من ذلك،
Dialogue: 0,0:12:20.73,0:12:24.36,نص عام,,0,0,0,,رأيتهم يسيرون معًا بشكل جيد
Dialogue: 0,0:12:24.98,0:12:26.15,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:12:27.15,0:12:28.19,نص عام,,0,0,0,,لطيف؟
Dialogue: 0,0:12:34.53,0:12:38.04,خط مائل,,0,0,0,,مو ديوك ويول التقيا مرة واحدة
Dialogue: 0,0:12:38.12,0:12:42.08,نص عام,,0,0,0,,أعتقد أنك لم تكن تعرف لأنك كنت محبوسًا في غرفة التدريب
Dialogue: 0,0:12:42.62,0:12:43.58,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:12:47.75,0:12:50.01,نص عام,,0,0,0,,نعم لم أكن أعرف
Dialogue: 0,0:13:16.12,0:13:17.74,نص عام,,0,0,0,,ماذا لو كان هذا صحيحاً؟
Dialogue: 0,0:13:18.33,0:13:19.45,ذكريات بخط مائل,,0,0,0,,لقد اشتقت لك أيضاً
Dialogue: 0,0:13:19.54,0:13:20.66,ذكريات,,0,0,0,,هذه إجابتي
Dialogue: 0,0:13:31.13,0:13:33.34,النص العام,,0,0,0,,رفضت لأنها لا تحبني
Dialogue: 0,0:13:34.30,0:13:36.18,النص العام,,0,0,0,,لم تفتقدها كما فعلت أنا
Dialogue: 0,0:13:38.22,0:13:40.06,نص عام,,0,0,0,,فقط اشتقت إليك
Dialogue: 0,0:13:46.06,0:13:47.11,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:13:47.73,0:13:50.36,النص العام,,0,0,0,,أريد أن أشرب السم وأموت
Dialogue: 0,0:13:58.41,0:13:59.70,نص عام,,0,0,0,,يا له من عار
Dialogue: 0,0:14:12.55,0:14:13.88,نص عام,,0,0,0,,أنا معجب بك
Dialogue: 0,0:14:14.59,0:14:17.34,نص عام,,0,0,0,,لقد أخبرتك بهذا مئات المرات
Dialogue: 0,0:14:23.73,0:14:25.35,نص عام,,0,0,0,,لا أعرف الكثير عن الحب،
Dialogue: 0,0:14:26.60,0:14:30.02,نص عام,,0,0,0,,ولكن عندما تحب شخص ما فلا تكرر ذلك مراراً وتكراراً
Dialogue: 0,0:14:32.03,0:14:34.11,نص عام,,0,0,0,,لأنه من الصعب الاعتراف ولو مرة واحدة
Dialogue: 0,0:14:39.66,0:14:41.08,نص عام,,0,0,0,,هذه الصافرة
Dialogue: 0,0:14:42.74,0:14:46.04,النص العام,,0,0,0,,ملكية لصديق لا يمكنني الاعتراف له أبدًا
Dialogue: 0,0:14:54.42,0:14:56.05,نص عام,,0,0,0,,أنا معجب بك حقًا
Dialogue: 0,0:15:05.31,0:15:08.60,نص عام,,0,0,0,,أردت حقًا أن أخبرها بهذا الأمر
Dialogue: 0,0:15:14.03,0:15:15.69,ذكريات بخط مائل,,0,0,0,,أريد تجربتها أيضًا
Dialogue: 0,0:15:16.61,0:15:18.45,ذكريات,,0,0,0,,هل أستطيع؟
Dialogue: 0,0:15:56.28,0:15:59.70,general text,,0,0,0,,لقد دخلت الآن إلى سوسنوفي بور. سوف نرى بعضنا البعض في كثير من الأحيان
Dialogue: 0,0:16:02.49,0:16:04.66,نص عام,,0,0,0,,يمكنك أن تأتي إلي إذا كنت بحاجة إلى أي شيء
Dialogue: 0,0:16:09.83,0:16:11.46,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:16:39.74,0:16:42.16,النص العام,,0,0,0,,قرأ تشان ووك "كلمات من القلب"
Dialogue: 0,0:16:43.36,0:16:45.03,النص العام,,0,0,0,,لقد ساعدته، أليس كذلك؟
Dialogue: 0,0:16:46.16,0:16:49.37,general text,,0,0,0,,اكتشفت أنه يستطيع ذلك، لذلك جئت لأخبرك
Dialogue: 0,0:16:50.25,0:16:54.54,نص عام,,0,0,0,,أخبر جين أن يسلم هذا الكتاب إلى جينيوون
Dialogue: 0,0:16:55.88,0:16:57.05,نص عام,,0,0,0,,عظم
Dialogue: 0,0:16:57.80,0:16:58.63,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:16:59.76,0:17:02.76,general text,,0,0,0,,كان تشان ووك غاضبًا لأن الجميع كانوا يقرأون هذه "الرسالة"
Dialogue: 0,0:17:03.34,0:17:06.97,نص عام,,0,0,0,,أعتقد أن المعلم سيو كيونغ سيشعر بنفس الشعور
Dialogue: 0,0:17:07.06,0:17:10.27,نص عام,,0,0,0,,يبدو أنك تحب تشان ووك حقًا
Dialogue: 0,0:17:11.64,0:17:14.81,النص العام,,0,0,0,,إنه مميز ولهذا السبب أشاهده
Dialogue: 0,0:17:14.90,0:17:16.86,النص العام,,0,0,0,,إنه ذكي جدًا،
Dialogue: 0,0:17:16.94,0:17:20.36,نص عام,,0,0,0,,لكن جين يريد حبسه هنا
Dialogue: 0,0:17:23.45,0:17:24.99,ذكريات,,0,0,0,,هل أنت متأكد،
Dialogue: 0,0:17:25.62,0:17:27.78,ذكريات,,0,0,0,,أن حجر الجليد ليس في سوسنوفي بور؟
Dialogue: 0,0:17:28.79,0:17:30.54,ذكريات,,0,0,0,,لماذا قررت ذلك؟
Dialogue: 0,0:17:31.29,0:17:32.66,ذكريات,,0,0,0,,قبل 20 عامًا
Dialogue: 0,0:17:33.62,0:17:36.04,ذكريات,,0,0,0,,غوانغجو تشانغ جانج أتقن كيمياء الأرواح
Dialogue: 0,0:17:38.00,0:17:39.30,ذكريات,,0,0,0,,لهذا السبب
Dialogue: 0,0:17:39.38,0:17:42.01,ذكريات,,0,0,0,,ولد طفل لا ينبغي له أن ينجب
Dialogue: 0,0:17:43.01,0:17:46.47,ذكريات,,0,0,0,,وفي تلك الليلة أشرق نجم الملك في السماء
Dialogue: 0,0:17:47.51,0:17:49.26,ذكريات,,0,0,0,,هل هذا تشان ووك؟
Dialogue: 0,0:17:50.10,0:17:51.22,ذكريات,,0,0,0,,نعم
Dialogue: 0,0:17:51.31,0:17:55.69,ذكريات,,0,0,0,,فتح الساحر الحجر في سوسنوفي بور
Dialogue: 0,0:17:56.44,0:17:59.61,ذكريات,,0,0,0,,وبواسطة كيمياء النفوس ولد ابن الملك
Dialogue: 0,0:18:01.86,0:18:05.82,ذكريات,,0,0,0,,يعرف جين مو من جيونبوغوان عن هذا الأمر
Dialogue: 0,0:18:07.70,0:18:11.16,ذكريات,,0,0,0,,إذا كان لديهم الحجر بالفعل، فما العذر الذي يمكن أن يكون هناك
Dialogue: 0,0:18:11.83,0:18:14.04,ذكريات,,0,0,0,,اخترع غابة الصنوبر,
Dialogue: 0,0:18:16.17,0:18:17.83,ذكريات,,0,0,0,,لتأخذه؟
Dialogue: 0,0:18:23.46,0:18:27.39,general text,,0,0,0,,جين ليس لديه طريقة أخرى لحماية غابة الصنوبر سوى إخفاء أوكا
Dialogue: 0,0:18:28.05,0:18:28.89,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:18:28.97,0:18:32.72,نص عام,,0,0,0,,هل هناك شيء لا أعرفه؟
Dialogue: 0,0:18:42.03,0:18:43.23,نص عام,,0,0,0,,يا صغيري...
Dialogue: 0,0:18:43.32,0:18:47.45,general text,,0,0,0,,كيف يمكنك حتى أن تثق بمثل هذا الشاب المهمل والمتهور الذي يخفي أسراره؟!
Dialogue: 0,0:18:48.74,0:18:50.58,نص عام,,0,0,0,,كيف يمكنك...
Dialogue: 0,0:18:51.91,0:18:53.62,نص عام,,0,0,0,,آمل أن يزول الأمر
Dialogue: 0,0:18:57.00,0:18:58.42,نص عام,,0,0,0,,إنه...
Dialogue: 0,0:18:58.50,0:19:00.79,نص عام,,0,0,0,,لم أغضب، حتى عندما قلت أن هناك المزيد
Dialogue: 0,0:19:00.88,0:19:02.50,نص عام,,0,0,0,,لن أشرب شاي العفة
Dialogue: 0,0:19:05.09,0:19:08.93,النص العام,,0,0,0,,إنتظر، الوشاح هدية من الخادمة كيم
Dialogue: 0,0:19:29.70,0:19:32.20,نص عام,,0,0,0,,يجب الانتهاء من التنظيف قبل
Dialogue: 0,0:19:32.28,0:19:34.62,النص العام,,0,0,0,,كيف سيبدأ السحرة دروسهم. أسرع
Dialogue: 0,0:19:34.70,0:19:35.54,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:19:56.64,0:19:57.93,نص عام,,0,0,0,,أين المالك؟
Dialogue: 0,0:19:58.02,0:20:00.06,النص العام,,0,0,0,,- لن يأتي؟\N- حسنًا...
Dialogue: 0,0:20:00.14,0:20:01.40,نص عام,,0,0,0,,ذهبت لإيقاظه،
Dialogue: 0,0:20:01.48,0:20:03.73,النص العام,,0,0,0,,لكنه قال إنه لم ينم غمزة الليلة الماضية
Dialogue: 0,0:20:03.82,0:20:06.07,نص عام,,0,0,0,,وهل سيتخطى؟ في اليوم الأول؟
Dialogue: 0,0:20:07.90,0:20:09.15,النص العام,,0,0,0,,إلى اللقاء يا مو دوك
Dialogue: 0,0:20:26.92,0:20:28.01,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:20:28.09,0:20:29.55,نص عام,,0,0,0,,علينا أن ننهض
Dialogue: 0,0:20:31.26,0:20:32.43,نص عام,,0,0,0,,سيدتي!
Dialogue: 0,0:20:36.14,0:20:37.52,نص عام,,0,0,0,,استيقظ
Dialogue: 0,0:20:37.60,0:20:39.02,نص عام,,0,0,0,,وإلا سأضربك
Dialogue: 0,0:20:39.10,0:20:40.27,نص عام,,0,0,0,,انهض!
Dialogue: 0,0:20:49.53,0:20:51.82,النص العام,,0,0,0,,لا تصدر ضجيجًا واذهب، سأنام
Dialogue: 0,0:20:54.20,0:20:56.66,نص عام,,0,0,0,,هل أنت مجنون؟ هل أردت الموت؟
Dialogue: 0,0:20:59.37,0:21:01.04,النص العام,,0,0,0,,نعم أنا مجنون وأريد أن أموت
Dialogue: 0,0:21:01.75,0:21:03.75,نص عام,,0,0,0,,ما بك؟
Dialogue: 0,0:21:03.83,0:21:06.38,النص العام,,0,0,0,,هذه أعراض تسممي
Dialogue: 0,0:21:07.71,0:21:10.67,النص العام,,0,0,0,,شان ووك، توقف عن العناد والغضب
Dialogue: 0,0:21:13.13,0:21:14.72,نص عام,,0,0,0,,قلت أنا الترياق
Dialogue: 0,0:21:16.22,0:21:17.05,نص عام,,0,0,0,,هنا
Dialogue: 0,0:21:18.14,0:21:20.10,نص عام,,0,0,0,,ها أنا ذا
Dialogue: 0,0:21:31.57,0:21:32.82,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:21:47.29,0:21:48.34,نص عام,,0,0,0,,مرحبًا تشان ووك
Dialogue: 0,0:21:49.30,0:21:52.09,general text,,0,0,0,,سمعتك تقرأ "كلمات من القلب". أنا مندهش
Dialogue: 0,0:21:52.17,0:21:53.84,نص عام,,0,0,0,,ليس هناك ما يدعو للدهشة
Dialogue: 0,0:21:53.93,0:21:56.26,النص العام,,0,0,0,,أرى أنك تقرأ عن تقنية Hyonggon
Dialogue: 0,0:21:56.34,0:21:58.55,general text,,0,0,0,,لقد أتقنت هذا الأسلوب من فن المبارزة عندما كنت طفلاً
Dialogue: 0,0:21:59.68,0:22:02.02,general text,,0,0,0,,إذا كنت تعلم قراءة "كلمات القلب"،
Dialogue: 0,0:22:02.10,0:22:03.81,نص عام,,0,0,0,,سأساعدك على إتقان هيونغون
Dialogue: 0,0:22:06.52,0:22:07.36,نص عام,,0,0,0,,علينا أن نفكر
Dialogue: 0,0:22:09.94,0:22:12.07,خط مائل,,0,0,0,,أوافق. قل أنك توافق
Dialogue: 0,0:22:13.74,0:22:16.16,نص عام,,0,0,0,,اسمع، لقد تعبت من شيء ما
Dialogue: 0,0:22:17.45,0:22:20.49,نص عام,,0,0,0,,اطلب المساعدة من المعلم لي
Dialogue: 0,0:22:29.34,0:22:30.38,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:22:31.09,0:22:33.55,general text,,0,0,0,,لقد أتقنت ريوسو في نفس الوقت تقريبًا مثلك
Dialogue: 0,0:22:34.17,0:22:37.05,النص العام,,0,0,0,,هل تريد قتالي؟
Dialogue: 0,0:22:37.13,0:22:39.43,النص العام,,0,0,0,,إذن سأقرضك السجادة الياقوتية
Dialogue: 0,0:22:39.51,0:22:41.47,نص عام,,0,0,0,,للتدريب
Dialogue: 0,0:22:42.52,0:22:45.23,general text,,0,0,0,,بمساعدتها يمكن مضاعفة الطاقة
Dialogue: 0,0:22:45.31,0:22:48.60,نص عام,,0,0,0,,سجادة ياقوتية؟ هذا أمر نادر
Dialogue: 0,0:22:50.02,0:22:51.90,نص عام,,0,0,0,,سيدتي، هذه فرصة جيدة
Dialogue: 0,0:22:54.24,0:22:56.57,general text,,0,0,0,,لكن مثل هذه السجادة باردة، أليس كذلك؟
Dialogue: 0,0:22:57.36,0:22:59.28,نص عام,,0,0,0,,أمرض بسرعة
Dialogue: 0,0:23:00.37,0:23:02.41,نص عام,,0,0,0,,لذا لست بحاجة لهذا
Dialogue: 0,0:23:10.54,0:23:11.84,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:23:13.21,0:23:16.84,نص عام,,0,0,0,,لم أنم جيدًا هذه الأيام، سأذهب لأخذ قيلولة
Dialogue: 0,0:23:18.59,0:23:21.72,النص العام,,0,0,0,,ضاعت فرصة السيطرة على هيونغون
Dialogue: 0,0:23:21.80,0:23:22.81,النص العام,,0,0,0,,هل أنت مجنون تمامًا؟
Dialogue: 0,0:23:22.89,0:23:25.64,نص عام,,0,0,0,,وأمس. من الصعب الحصول على سجادة الياقوت،
Dialogue: 0,0:23:25.73,0:23:27.14,نص عام,,0,0,0,,وقلت إنه بارد
Dialogue: 0,0:23:27.23,0:23:29.77,general text,,0,0,0,,كان عليّ أن أوافق حتى لو كان بإمكاني الموت على ذلك.
Dialogue: 0,0:23:29.85,0:23:32.48,نص عام,,0,0,0,,لا يصدق. "مجنون. يموت"
Dialogue: 0,0:23:32.57,0:23:34.40,نص عام,,0,0,0,,هذا كل ما تخبرني به
Dialogue: 0,0:23:36.28,0:23:37.70,نص عام,,0,0,0,,اعطيه هنا
Dialogue: 0,0:23:47.83,0:23:48.75,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:23:48.83,0:23:50.37,نص عام,,0,0,0,,لا يمكن أن تجتمعا هنا معًا
Dialogue: 0,0:23:51.29,0:23:53.13,النص العام,,0,0,0,,لن تذهب إلى السرير إلا إذا استيقظت
Dialogue: 0,0:23:56.80,0:23:57.97,نص عام,,0,0,0,,انهض
Dialogue: 0,0:23:59.05,0:24:00.22,نص عام,,0,0,0,,وتجعل
Dialogue: 0,0:24:00.30,0:24:03.18,نص عام,,0,0,0,,لن يكون الأمر صعبًا
Dialogue: 0,0:24:17.28,0:24:19.07,نص عام,,0,0,0,,قلت اشتقت لك,
Dialogue: 0,0:24:19.15,0:24:22.74,general text,,0,0,0,,وقلت إنني مسموم، لذا أريد أن أنام وأعود إلى صوابي
Dialogue: 0,0:24:22.82,0:24:24.83,نص عام,,0,0,0,,توقف عن العبث معي، على الأقل لبعض الوقت
Dialogue: 0,0:24:28.95,0:24:31.62,نص عام,,0,0,0,,أنت فقط تريد أن تزعجني
Dialogue: 0,0:24:33.00,0:24:35.09,general text,,0,0,0,,قلت لك إذا مت، ستموت أنت أيضاً
Dialogue: 0,0:24:35.88,0:24:38.63,general text,,0,0,0,,أنا أتألم، يجب أن تشعر بشيء على الأقل أيضًا.
Dialogue: 0,0:24:38.71,0:24:41.88,النص العام,,0,0,0,,حتى عندما أنام أشعر بالتشنجات
Dialogue: 0,0:24:48.35,0:24:49.81,نص عام,,0,0,0,,وإلى متى؟
Dialogue: 0,0:24:51.02,0:24:51.85,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,0:24:52.48,0:24:54.11,نص عام,,0,0,0,,ماذا؟ مزعج؟
Dialogue: 0,0:24:54.73,0:24:56.40,نص عام,,0,0,0,,إذن ساعدني في جعل نفسي أكثر راحة
Dialogue: 0,0:25:05.62,0:25:09.54,نص عام,,0,0,0,,المالك نائم باستمرار
Dialogue: 0,0:25:09.62,0:25:12.08,نص عام,,0,0,0,,قل له أن يتدرب
Dialogue: 0,0:25:12.16,0:25:14.04,النص العام,,0,0,0,,سحرة جيونجينغاك يتدربون حسب الرغبة
Dialogue: 0,0:25:14.13,0:25:17.21,نص عام,,0,0,0,,كل شخص يتحكم في طاقته بشكل مختلف
Dialogue: 0,0:25:17.29,0:25:19.67,النص العام,,0,0,0,,لن أتدخل طالما أنه لم يخالف القواعد
Dialogue: 0,0:25:21.09,0:25:22.01,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:25:22.09,0:25:24.47,نص عام,,0,0,0,,لا تقلق. هنا هو
Dialogue: 0,0:25:30.47,0:25:33.14,نص عام,,0,0,0,,أعاني من الصداع،
Dialogue: 0,0:25:33.23,0:25:34.52,نص عام,,0,0,0,,سأعود للمنزل
Dialogue: 0,0:25:34.60,0:25:37.11,نص عام,,0,0,0,,وسأعود إلى صوابي وأنا أنقع في الماء
Dialogue: 0,0:25:39.32,0:25:41.65,نص عام,,0,0,0,,هل يؤلمك رأسك؟ أنت لم تفعل أي شيء
Dialogue: 0,0:25:42.24,0:25:45.24,نص عام,,0,0,0,,ولا يمكنك العودة إلى المنزل. انها ليست وفقا للقواعد
Dialogue: 0,0:25:45.32,0:25:46.41,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:25:46.49,0:25:49.16,نص عام,,0,0,0,,استثناء تشان ووك. وله إذن الرأس
Dialogue: 0,0:25:49.74,0:25:50.70,نص عام,,0,0,0,,لماذا هو؟
Dialogue: 0,0:25:50.79,0:25:53.79,general text,,0,0,0,,مشغول بكل أنواع الترفيه، لم يكن لديك وقت لذلك،
Dialogue: 0,0:25:53.87,0:25:56.79,general text,,0,0,0,,لكنني عقدت صفقة مع رأسي بينما كنت محبوسًا هنا
Dialogue: 0,0:25:59.59,0:26:00.59,نص عام,,0,0,0,,سأعود قريباً
Dialogue: 0,0:26:05.05,0:26:06.59,نص عام,,0,0,0,,سأذهب معه
Dialogue: 0,0:26:08.05,0:26:09.97,نص عام,,0,0,0,,إذا ذهبت، سيتم طردك من هنا
Dialogue: 0,0:26:10.06,0:26:13.35,نص عام,,0,0,0,,لقد حاولت جاهداً أن تصل إلى هنا. هل أنت مستعد للمغادرة فقط؟
Dialogue: 0,0:26:23.99,0:26:26.07,نص عام,,0,0,0,,عاد تشان ووك إلى المنزل
Dialogue: 0,0:26:26.16,0:26:27.66,نص عام,,0,0,0,,هل أنت متأكد من صحة هذا؟
Dialogue: 0,0:26:27.74,0:26:31.08,نص عام,,0,0,0,,دعه يذهب حيث يريد
Dialogue: 0,0:26:32.79,0:26:34.50,general text,,0,0,0,,ثم يصبح كسولاً
Dialogue: 0,0:26:35.12,0:26:36.00,مائل,,0,0,0,,فصل
Dialogue: 0,0:26:39.96,0:26:42.46,نص عام,,0,0,0,,السيدة تطلب منك الانتظار قليلاً
Dialogue: 0,0:26:43.30,0:26:46.22,general text,,0,0,0,,هل تستضيف أحداً؟
Dialogue: 0,0:26:52.39,0:26:55.14,النص العام,,0,0,0,,رأيت خادم جيونبوجوان في الطريق إلى هنا
Dialogue: 0,0:26:55.23,0:26:58.31,نص عام,,0,0,0,,ربما النائب جين مو هنا؟
Dialogue: 0,0:26:58.40,0:27:02.98,general text,,0,0,0,,إنهم ليسوا قريبين بما يكفي لرؤية بعضهم البعض بهذه الطريقة
Dialogue: 0,0:27:04.15,0:27:07.66,نص عام,,0,0,0,,احتياطًا، اذهب وتحقق من المغادر
Dialogue: 0,0:27:18.83,0:27:20.46,نص عام,,0,0,0,,إذا أراد السيد "لي" الأمر بهذه الطريقة،
Dialogue: 0,0:27:20.54,0:27:23.59,النص العام,,0,0,0,,سنخفي "كلمات القلب" في جينيوون
Dialogue: 0,0:27:25.34,0:27:28.30,نص عام,,0,0,0,,هل رأيت أحداً غيرك اليوم؟
Dialogue: 0,0:27:29.18,0:27:30.64,نص عام,,0,0,0,,قريب بعيد
Dialogue: 0,0:27:32.81,0:27:37.06,general text,,0,0,0,,هل يرث جين تشو يونغ جينيونغ؟
Dialogue: 0,0:27:39.06,0:27:40.52,نص عام,,0,0,0,,لم يتم تحديد هذا الأمر بعد
Dialogue: 0,0:27:41.40,0:27:43.82,النص العام,,0,0,0,,ربما تكون ابنتي الكبرى لا تزال على قيد الحياة
Dialogue: 0,0:27:46.03,0:27:48.24,نص عام,,0,0,0,,لقد مرت عشر سنوات منذ ذلك الحين
Dialogue: 0,0:27:49.45,0:27:51.37,النص العام,,0,0,0,,ورغم أنها عمياء،
Dialogue: 0,0:27:51.45,0:27:55.41,general text,,0,0,0,,يمكنها الشعور بالطاقة والتحكم في الآثار بشكل لا مثيل له.
Dialogue: 0,0:27:55.49,0:27:57.20,نص عام,,0,0,0,,كان طفلاً ذكياً جداً
Dialogue: 0,0:27:57.29,0:27:58.71,نص عام,,0,0,0,,خلافاً للأطفال الآخرين،
Dialogue: 0,0:27:59.62,0:28:02.92,نص عام,,0,0,0,,ولدت بعمر 13 شهراً
Dialogue: 0,0:28:04.46,0:28:07.92,general text,,0,0,0,,ولدت في اليوم الذي أطلق فيه تشانغ جانج اسمه على غوانغجو.
Dialogue: 0,0:28:08.01,0:28:09.47,نص عام,,0,0,0,,تباركت السماء
Dialogue: 0,0:28:11.72,0:28:15.47,general text,,0,0,0,,ولدت في اليوم الذي اختاره تشانغ جانج لك؟
Dialogue: 0,0:28:16.93,0:28:18.10,نص عام,,0,0,0,,هل من الممكن
Dialogue: 0,0:28:18.18,0:28:22.23,نص عام,,0,0,0,,حدد تاريخ ووقت ميلاد الطفل؟
Dialogue: 0,0:28:23.36,0:28:24.90,نص عام,,0,0,0,,لقد كانت صدفة
Dialogue: 0,0:28:26.57,0:28:29.90,نص عام,,0,0,0,,أود دعوة السيد لي إلى جينيوون
Dialogue: 0,0:28:30.49,0:28:31.78,نص عام,,0,0,0,,قل له هذا
Dialogue: 0,0:28:33.03,0:28:34.12,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:28:49.88,0:28:51.93,ذكريات بخط مائل,,0,0,0,,حملتها 13 شهرًا
Dialogue: 0,0:28:52.01,0:28:55.05,ذكريات,,0,0,0,,لا أستطيع أن أتركها تذهب بهذه السهولة
Dialogue: 0,0:28:56.68,0:28:58.56,ذكريات,,0,0,0,,سمعت أن الحجر له قوة
Dialogue: 0,0:28:58.64,0:29:01.56,ذكريات,,0,0,0,,تعيد الأرواح الميتة إلى الحياة
Dialogue: 0,0:29:08.19,0:29:09.32,ذكريات,,0,0,0,,غوانغجو
Dialogue: 0,0:29:11.36,0:29:12.57,ذكريات,,0,0,0,,ساعدوني
Dialogue: 0,0:29:22.87,0:29:27.50,تعليق صوتي,,0,0,0,,لقد قطعت هذا الحد لحماية طفلي
Dialogue: 0,0:29:38.85,0:29:40.10,نص عام,,0,0,0,,سوف أجدك
Dialogue: 0,0:29:42.52,0:29:44.69,نص عام,,0,0,0,,سأبذل قصارى جهدي،
Dialogue: 0,0:29:46.52,0:29:47.86,نص عام,,0,0,0,,للعثور عليك
Dialogue: 0,0:29:59.79,0:30:02.83,النص العام,,0,0,0,,- هل تأكدت من هو هذا الضيف المهم؟\N- نعم
Dialogue: 0,0:30:04.37,0:30:07.84,مائل,,0,0,0,,كان النائب جين مو
Dialogue: 0,0:30:10.17,0:30:12.30,نص عام,,0,0,0,,منذ متى أصبح رئيس جينيوون؟
Dialogue: 0,0:30:12.38,0:30:15.63,general text,,0,0,0,,تعتبره أحد أفراد العائلة وتقبله؟
Dialogue: 0,0:30:15.72,0:30:17.55,نص عام,,0,0,0,,غادر بهدوء عبر البوابة الخلفية
Dialogue: 0,0:30:18.30,0:30:21.02,نص عام,,0,0,0,,فكان اللقاء سرياً
Dialogue: 0,0:30:22.18,0:30:24.89,نص عام,,0,0,0,,أتساءل ما هي الحيل التي استخدمها
Dialogue: 0,0:30:24.98,0:30:27.94,النص العام,,0,0,0,,جين مو الزلق لزيارة جينيوون بحرية؟
Dialogue: 0,0:30:45.29,0:30:48.67,مائل,,0,0,0,,أنت أعمى فلا تعرف أين أنت
Dialogue: 0,0:30:49.79,0:30:52.80,italics,,0,0,0,,سوف تصمت وتفعل ما يطلبونه،
Dialogue: 0,0:30:53.38,0:30:54.92,خط مائل,,0,0,0,,أنقذ حياتك
Dialogue: 0,0:30:55.55,0:30:57.38,خط مائل,,0,0,0,,بدون صوت
Dialogue: 0,0:30:57.47,0:30:58.55,نص عام,,0,0,0,,انهض
Dialogue: 0,0:32:18.88,0:32:20.05,نص عام,,0,0,0,,اجلس
Dialogue: 0,0:32:28.31,0:32:30.94,نص عام,,0,0,0,,اتركها وسيذهب الباقي
Dialogue: 0,0:32:34.48,0:32:36.73,خارج الشاشة,,0,0,0,,إنهم يبحثون عن الفتاة التي في الصورة
Dialogue: 0,0:32:36.82,0:32:38.32,خارج الإطار,,0,0,0,,يبدو أنها عمياء
Dialogue: 0,0:32:39.36,0:32:42.32,خارج الإطار,,0,0,0,,قال أن الآخرين يمكنهم الذهاب، لماذا لا توجد أصوات؟
Dialogue: 0,0:33:11.89,0:33:13.40,نص عام,,0,0,0,,يمكنك أن ترى
Dialogue: 0,0:33:15.98,0:33:18.90,نص عام,,0,0,0,,إنه أمر مؤسف. اعتقدت أنني وجدت الفتاة المناسبة
Dialogue: 0,0:33:19.44,0:33:20.36,نص عام,,0,0,0,,اقتلها
Dialogue: 0,0:33:24.24,0:33:25.87,نص عام,,0,0,0,,أستطيع أن أفعل ذلك!
Dialogue: 0,0:33:27.74,0:33:31.33,نص عام,,0,0,0,,يمكنني أن أكون الفتاة التي في الصورة
Dialogue: 0,0:33:37.29,0:33:38.50,نص عام,,0,0,0,,أنقذني
Dialogue: 0,0:33:39.21,0:33:40.88,نص عام,,0,0,0,,قلت إنني قادم
Dialogue: 0,0:33:42.09,0:33:43.97,نص عام,,0,0,0,,إذا كان عليك أن تكون أعمى،
Dialogue: 0,0:33:47.10,0:33:49.18,نص عام,,0,0,0,,إذن سأكون واحدًا
Dialogue: 0,0:34:03.78,0:34:06.99,نص عام,,0,0,0,,فتاة مسلية. انهض
Dialogue: 0,0:34:12.91,0:34:15.08,نص عام,,0,0,0,,هل يمكنك التظاهر بأنك أعمى؟
Dialogue: 0,0:34:15.92,0:34:17.58,نص عام,,0,0,0,,أنا بالفعل أعمى
Dialogue: 0,0:34:21.13,0:34:23.59,نص عام,,0,0,0,,حسنًا، دعونا نتحقق
Dialogue: 0,0:35:01.96,0:35:04.80,نص عام,,0,0,0,,يبدو أنني وجدت ما أحتاجه فعلاً
Dialogue: 0,0:35:24.40,0:35:25.86,نص عام,,0,0,0,,فليكن
Dialogue: 0,0:35:25.94,0:35:29.95,general text,,0,0,0,,من الآن فصاعدا، أنت جين بو يونغ، ابنة جينيونغ المفقودة
Dialogue: 0,0:35:31.07,0:35:32.12,نص عام,,0,0,0,,نعم
Dialogue: 0,0:35:33.29,0:35:35.12,نص عام,,0,0,0,,أنا جين بو يونغ
Dialogue: 0,0:35:47.30,0:35:49.30,التعليق الصوتي,,0,0,0,,توقف تشان ووك عن التدريب مرة أخرى
Dialogue: 0,0:35:53.76,0:35:57.27,التعليق الصوتي,,0,0,0,,كيف أعاقبه هذه المرة؟
Dialogue: 0,0:36:02.56,0:36:04.73,نص عام,,0,0,0,,شكرًا لي، أنت تعمل بجد
Dialogue: 0,0:36:09.20,0:36:10.11,نص عام,,0,0,0,,نعم
Dialogue: 0,0:36:10.70,0:36:13.95,النص العام,,0,0,0,,شكرًا لك، سأضطر إلى أكنس الفناء مرة أخرى
Dialogue: 0,0:36:21.38,0:36:22.63,نص عام,,0,0,0,,هل تتجادل معي؟
Dialogue: 0,0:36:23.67,0:36:24.84,نص عام,,0,0,0,,إذن سأساعدك على الرحيل
Dialogue: 0,0:36:24.92,0:36:26.25,نص عام,,0,0,0,,لقد غششت
Dialogue: 0,0:36:26.80,0:36:28.92,general text,,0,0,0,,إذا تحدثت عن هذا، فسيتم طردك من هنا على الفور
Dialogue: 0,0:36:31.22,0:36:32.80,نص عام,,0,0,0,,عذراً سمو الأمير
Dialogue: 0,0:36:33.89,0:36:36.97,النص العام,,0,0,0,,أنا ممتن للأوراق التي تساقطت بمساعدتك
Dialogue: 0,0:36:37.06,0:36:39.60,نص عام,,0,0,0,,يمكنك الاستمرار في هز الشجرة
Dialogue: 0,0:36:41.40,0:36:43.06,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:36:44.02,0:36:46.48,نص عام,,0,0,0,,للإجابات وليس للأوراق
Dialogue: 0,0:36:48.53,0:36:53.45,النص العام,,0,0,0,,إذن أنت لم تأت للتذمر بل للامتنان
Dialogue: 0,0:36:53.53,0:36:56.24,النص العام,,0,0,0,,يستغرق مني وقتاً طويلاً لأفهمه يا صاحب السمو
Dialogue: 0,0:36:56.33,0:36:58.25,نص عام,,0,0,0,,أنا ممتن للغاية لك
Dialogue: 0,0:36:59.04,0:37:02.12,نص عام,,0,0,0,,بالطبع أنت ممتن. لقد كتبت الإجابات بنفسي
Dialogue: 0,0:37:03.67,0:37:06.09,general text,,0,0,0,,هل تعرف حتى كيف تغسل الحبر؟
Dialogue: 0,0:37:07.46,0:37:10.59,نص عام,,0,0,0,,هل كتبت إجابة؟
Dialogue: 0,0:37:11.22,0:37:14.01,نص عام,,0,0,0,,نعم. أنا ولي العهد
Dialogue: 0,0:37:14.09,0:37:16.60,النص العام,,0,0,0,,تعلمت أن معجون الأرز يزيل الحبر
Dialogue: 0,0:37:17.22,0:37:20.31,النص العام,,0,0,0,,حتى أنني جربته بنفسي، نجح
Dialogue: 0,0:37:21.02,0:37:22.39,نص عام,,0,0,0,,ببساطة لا توجد كلمات
Dialogue: 0,0:37:23.98,0:37:26.11,النص العام,,0,0,0,,أنا مدين لك إلى الأبد
Dialogue: 0,0:37:27.69,0:37:28.82,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:37:29.74,0:37:31.24,النص العام,,0,0,0,,هل أنت سعيد بوجودك مع سيدك؟
Dialogue: 0,0:37:32.65,0:37:34.28,general text,,0,0,0,,سمعته يقرأ "كلمات من القلب"
Dialogue: 0,0:37:34.36,0:37:35.49,نص عام,,0,0,0,,نعم
Dialogue: 0,0:37:35.57,0:37:38.95,general text,,0,0,0,,من بين سحرة جيونججينجاك، كان هو الأسرع في فعل ذلك
Dialogue: 0,0:37:42.08,0:37:44.00,general text,,0,0,0,,من غير المرجح أن تكون مجرد موهبة ومهارات
Dialogue: 0,0:37:44.58,0:37:46.25,نص عام,,0,0,0,,ربما محظوظ مرة أخرى
Dialogue: 0,0:37:47.29,0:37:50.09,general text,,0,0,0,,لكنه هزمك في مبارزة
Dialogue: 0,0:37:53.30,0:37:56.93,general text,,0,0,0,,أعرف ما يستطيع تشان ووك فعله لأنني قاتلته
Dialogue: 0,0:37:58.31,0:38:01.10,النص العام,,0,0,0,,مهارات السيف ضعيفة، التعاويذ ضعيفة
Dialogue: 0,0:38:01.18,0:38:04.90,general text,,0,0,0,,كان محظوظًا باستخدام Tansu. الأمر لا يتعلق بالمهارات
Dialogue: 0,0:38:06.19,0:38:08.23,خلف الكواليس,,0,0,0,,إنه على حق في شيء ما
Dialogue: 0,0:38:08.98,0:38:12.61,general text,,0,0,0,,فجاء إلى جيونجينغاك. تصبح ساحرا قويا
Dialogue: 0,0:38:12.69,0:38:15.82,general text,,0,0,0,,في الواقع، كان يفتقر إلى المهارات اللازمة حتى للانضمام إلى جيونجينغاك
Dialogue: 0,0:38:16.49,0:38:19.91,general text,,0,0,0,,إذا هزم أي شخص هنا،
Dialogue: 0,0:38:20.66,0:38:22.29,نص عام,,0,0,0,,أتعرف عليه
Dialogue: 0,0:38:23.58,0:38:26.63,التعليق الصوتي,,0,0,0,,سيكون من الجميل الاستعانة بولي العهد
Dialogue: 0,0:38:26.71,0:38:27.79,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:38:28.34,0:38:31.71,نص عام,,0,0,0,,أو ربما يمكننا الجدال؟
Dialogue: 0,0:38:32.55,0:38:33.72,نص عام,,0,0,0,,هل نراهن؟
Dialogue: 0,0:38:35.05,0:38:37.18,general text,,0,0,0,,ماذا سأستفيد من الجدال معك؟
Dialogue: 0,0:38:38.39,0:38:42.22,النص العام,,0,0,0,,سأهديك أغلى ما أملك
Dialogue: 0,0:38:50.48,0:38:51.86,ذكريات بخط مائل,,0,0,0,,سأكون أول من يختار
Dialogue: 0,0:38:51.94,0:38:53.82,ذكريات,,0,0,0,,سأخذ اللون الأحمر وأنت تأخذ اللون الأزرق
Dialogue: 0,0:38:59.03,0:39:01.83,ذكريات بخط مائل,,0,0,0,,انتظر. سوف آتي إلى هناك
Dialogue: 0,0:39:02.49,0:39:03.87,ذكريات بخط مائل,,0,0,0,,لقد اشتقت لك أيضاً
Dialogue: 0,0:39:05.33,0:39:06.67,ذكريات,,0,0,0,,هذه إجابتي
Dialogue: 0,0:39:16.76,0:39:18.39,نص عام,,0,0,0,,- سيد\N- نعم
Dialogue: 0,0:39:19.01,0:39:21.10,نص عام,,0,0,0,,لقد اشتريت ملفات تعريف الارتباط المفضلة لديك
Dialogue: 0,0:39:21.93,0:39:23.39,النص العام,,0,0,0,,هل ستبقى لتناول طعام الغداء؟
Dialogue: 0,0:39:23.47,0:39:25.48,نص عام,,0,0,0,,عدت إلى المنزل لبضعة أيام
Dialogue: 0,0:39:26.43,0:39:29.65,general text,,0,0,0,,- هل هذا ممكن؟\N- الرئيس أعطى الإذن
Dialogue: 0,0:39:29.73,0:39:31.98,النص العام,,0,0,0,,جعلتني استثناءً في كل شيء
Dialogue: 0,0:39:32.07,0:39:33.36,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:39:33.44,0:39:36.19,النص العام,,0,0,0,,تقرأ "كلمات من القلب" في بضعة أيام
Dialogue: 0,0:39:36.28,0:39:39.45,general text,,0,0,0,,من الغباء إجبارك على اتباع نفس القواعد التي يتبعها السحرة العاديون
Dialogue: 0,0:39:40.49,0:39:42.91,general text,,0,0,0,,هل أنت سعيد بنجاحي؟
Dialogue: 0,0:39:42.99,0:39:44.83,نص عام,,0,0,0,,لست سعيدًا فقط
Dialogue: 0,0:39:44.91,0:39:47.21,نص عام,,0,0,0,,ليس لديك أي فكرة عن مدى فخري
Dialogue: 0,0:39:49.04,0:39:50.46,نص عام,,0,0,0,,العذراء كيم,
Dialogue: 0,0:39:50.54,0:39:54.17,general text,,0,0,0,,لقد خيبت أملك باستمرار، والآن يمكنك أن تفخر
Dialogue: 0,0:39:54.25,0:39:57.09,النص العام,,0,0,0,,هل أشتري لك فستاناً جميلاً؟
Dialogue: 0,0:39:57.17,0:39:58.59,نص عام,,0,0,0,,أنت تنظر
Dialogue: 0,0:39:58.68,0:40:02.72,نص عام,,0,0,0,,لست بحاجة إلى أي شيء. أشعر وكأنني أملك كل شيء
Dialogue: 0,0:40:03.97,0:40:05.43,نص عام,,0,0,0,,جاء الناس
Dialogue: 0,0:40:05.52,0:40:08.94,النص العام,,0,0,0,,وقالوا لي أنت ابن أبيك
Dialogue: 0,0:40:10.77,0:40:11.77,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:40:12.36,0:40:14.65,النص العام,,0,0,0,,كان والدك يسمى عبقري
Dialogue: 0,0:40:14.73,0:40:18.24,general text,,0,0,0,,والآن يقولون أنك موهوب مثل والدك
Dialogue: 0,0:40:20.24,0:40:22.62,النص العام,,0,0,0,,الناس قالوا أنني لا أشبهه على الإطلاق
Dialogue: 0,0:40:25.99,0:40:27.62,النص العام,,0,0,0,,سوف تحرز تقدمًا،
Dialogue: 0,0:40:28.29,0:40:31.96,نص عام,,0,0,0,,ولن يقول الناس شيئًا كهذا عنك بعد الآن
Dialogue: 0,0:40:32.04,0:40:35.21,النص العام,,0,0,0,,ماذا لو لم يكن هناك نجاح؟ هل سيبدأون في نشر الشائعات مرة أخرى؟
Dialogue: 0,0:40:37.09,0:40:38.21,نص عام,,0,0,0,,لا، ليس الأمر كذلك...
Dialogue: 0,0:40:39.55,0:40:42.64,النص العام,,0,0,0,,أخبرهم أنهم أحرار في قول ما يريدون
Dialogue: 0,0:40:42.72,0:40:44.01,نص عام,,0,0,0,,لم يعد يزعجني بعد الآن
Dialogue: 0,0:40:45.06,0:40:47.89,نص عام,,0,0,0,,نعم. لا يمكنك القلق بشأن هذا بعد الآن
Dialogue: 0,0:40:49.94,0:40:54.90,general text,,0,0,0,,وإضافة إلى ذلك فإن نجاحاتك هي من مزاياك
Dialogue: 0,0:40:54.98,0:40:56.36,general text,,0,0,0,,أي جهة الأب هنا؟
Dialogue: 0,0:40:57.07,0:40:59.44,النص العام,,0,0,0,,لم يكن موجودًا أبدًا
Dialogue: 0,0:41:00.03,0:41:03.70,نص عام,,0,0,0,,وبشكل عام، كل ذلك لأنني
Dialogue: 0,0:41:03.78,0:41:05.16,نص عام,,0,0,0,,ربيتك بخير
Dialogue: 0,0:41:11.96,0:41:15.00,النص العام,,0,0,0,,ستظل دائمًا سيدي العزيز،
Dialogue: 0,0:41:15.92,0:41:18.55,النص العام,,0,0,0,,بنجاح أو بدون نجاح
Dialogue: 0,0:41:20.01,0:41:21.05,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:41:22.55,0:41:26.05,general text,,0,0,0,,إذن يمكنك العودة إلى المنزل وتكون كسولاً؟
Dialogue: 0,0:41:27.81,0:41:29.77,نص عام,,0,0,0,,نعم إن أردت ذلك
Dialogue: 0,0:41:30.56,0:41:33.02,نص عام,,0,0,0,,لكنني اعتقدت أنك تكرهه
Dialogue: 0,0:41:34.56,0:41:38.23,نص عام,,0,0,0,,إذا قارنت وقت عودتك من دانهيانغوك،
Dialogue: 0,0:41:38.32,0:41:41.53,النص العام,,0,0,0,,بدا أكثر سعادة مما كانوا عليه عندما كانوا للتو
Dialogue: 0,0:41:42.53,0:41:44.16,نص عام,,0,0,0,,قشعريرة في المنزل
Dialogue: 0,0:41:45.49,0:41:48.41,general text,,0,0,0,,لهذا السبب لم أتمكن من إيقافك رغم كل الخطر
Dialogue: 0,0:41:49.04,0:41:50.08,نص عام,,0,0,0,,أريد,
Dialogue: 0,0:41:50.62,0:41:55.42,نص عام,,0,0,0,,حتى تنجح فيما تختاره لنفسك
Dialogue: 0,0:41:58.04,0:41:59.17,نص عام,,0,0,0,,نعم
Dialogue: 0,0:42:03.17,0:42:04.51,نص عام,,0,0,0,,يجب أن أعود
Dialogue: 0,0:42:05.59,0:42:07.26,نص عام,,0,0,0,,هل سترحل؟
Dialogue: 0,0:42:07.35,0:42:10.89,نص عام,,0,0,0,,نعم. ولو طلبت مني الرحيل لفعلت العكس
Dialogue: 0,0:42:10.97,0:42:13.06,نص عام,,0,0,0,,لكن بعد مثل هذا الكلام علينا العودة إلى الوراء
Dialogue: 0,0:42:13.14,0:42:16.77,النص العام,,0,0,0,,يجب أن أفعل كل ما بوسعي لأجعلك فخوراً
Dialogue: 0,0:42:18.23,0:42:20.53,نص عام,,0,0,0,,والرأس؟ ألا يؤلمك بعد الآن؟
Dialogue: 0,0:42:21.23,0:42:22.36,نص عام,,0,0,0,,لا
Dialogue: 0,0:42:23.24,0:42:25.24,نص عام,,0,0,0,,ما الناس، ما الخيول
Dialogue: 0,0:42:25.32,0:42:27.57,نص عام,,0,0,0,,التعليم بالجزرة والعصا
Dialogue: 0,0:42:28.78,0:42:31.87,النص العام,,0,0,0,,لقد ضربوني للتو
Dialogue: 0,0:42:32.45,0:42:35.33,نص عام,,0,0,0,,من تجرأ على ضربك؟
Dialogue: 0,0:42:35.42,0:42:37.88,general text,,0,0,0,,لا تقلق، لن أقف هناك بينما يضربونني.
Dialogue: 0,0:42:39.84,0:42:41.34,نص عام,,0,0,0,,غلفي لي بعض الحلوى
Dialogue: 0,0:42:41.42,0:42:42.84,نص عام,,0,0,0,,مجموعة من ملفات تعريف الارتباط
Dialogue: 0,0:42:43.80,0:42:46.51,نص عام,,0,0,0,,- سيكون ممتعاً\N- هل أنت متأكد؟
Dialogue: 0,0:42:47.59,0:42:48.68,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:42:49.97,0:42:51.10,نص عام,,0,0,0,,لقد وصلت أخيرًا
Dialogue: 0,0:42:51.81,0:42:52.93,نص عام,,0,0,0,,نعم
Dialogue: 0,0:42:53.02,0:42:55.81,النص العام,,0,0,0,,أشعر وكأنكم كنتم جميعاً تنتظرونني
Dialogue: 0,0:42:56.44,0:42:58.90,general text,,0,0,0,,هل يريد الجميع الكعك الذي أحضرته؟
Dialogue: 0,0:42:58.98,0:43:02.07,نص عام,,0,0,0,,اذهب إلى غرفة التدريب. سيكون ممتعا
Dialogue: 0,0:43:13.54,0:43:15.62,النص العام,,0,0,0,,- هل كنت تنتظرني؟\N- نعم
Dialogue: 0,0:43:15.71,0:43:18.46,نص عام,,0,0,0,,سأكون خصمك الأول
Dialogue: 0,0:43:19.96,0:43:20.79,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:43:21.54,0:43:23.34,نص عام,,0,0,0,,لنبدأ القتال
Dialogue: 0,0:43:24.09,0:43:26.13,النص العام,,0,0,0,,إذا رفضت خسرت
Dialogue: 0,0:43:27.01,0:43:28.47,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:43:32.47,0:43:34.10,نص عام,,0,0,0,,خذ
Dialogue: 0,0:44:03.63,0:44:04.71,خط مائل,,0,0,0,,خسر تشان ووك
Dialogue: 0,0:44:06.51,0:44:09.43,general text,,0,0,0,,يمكن للفائز "جيو هو" أن يأخذ ضفدعه الذهبي
Dialogue: 0,0:44:37.29,0:44:38.66,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:44:38.75,0:44:40.00,نص عام,,0,0,0,,أراهن
Dialogue: 0,0:44:40.08,0:44:42.38,النص العام,,0,0,0,,لم أجادلك في شيء يا صاحب السمو
Dialogue: 0,0:44:42.46,0:44:45.21,نص عام,,0,0,0,,ليس معك، مع خادمتك
Dialogue: 0,0:44:49.30,0:44:52.51,general text,,0,0,0,,أخبرتها أنك لا تستطيع هزيمة ساحر واحد هنا
Dialogue: 0,0:44:52.59,0:44:53.97,نص عام,,0,0,0,,لا تستطيع
Dialogue: 0,0:44:54.05,0:44:57.06,general text,,0,0,0,,وقالت خادمتك أنك ستهزم واحدًا على الأقل
Dialogue: 0,0:44:57.97,0:44:59.81,نص عام,,0,0,0,,قال مو دوك ذلك؟
Dialogue: 0,0:45:01.77,0:45:04.11,النص العام,,0,0,0,,سوف تقاتل كل يوم لمدة عشرة أيام
Dialogue: 0,0:45:04.19,0:45:06.02,النص العام,,0,0,0,,إذا لم تفز أبدًا،
Dialogue: 0,0:45:06.11,0:45:08.57,النص العام,,0,0,0,,سوف تمنحني أغلى ما لديها
Dialogue: 0,0:45:10.28,0:45:11.36,نص عام,,0,0,0,,عزيزي؟
Dialogue: 0,0:45:12.53,0:45:14.24,نص عام,,0,0,0,,ما هو الشيء الثمين بالنسبة لك؟
Dialogue: 0,0:45:14.87,0:45:16.62,نص عام,,0,0,0,,ما أعطيتني
Dialogue: 0,0:45:18.70,0:45:20.16,نص عام,,0,0,0,,الأمر على المحك
Dialogue: 0,0:45:29.67,0:45:32.30,النص العام,,0,0,0,,هذا اليشم يبدو باهظ الثمن، أريده لنفسي
Dialogue: 0,0:45:34.51,0:45:36.30,نص عام,,0,0,0,,فأحضرت الضفادع الذهبية
Dialogue: 0,0:45:36.39,0:45:37.97,نص عام,,0,0,0,,جائزة
Dialogue: 0,0:45:44.65,0:45:48.44,general text,,0,0,0,,إذا لم تفز قبل انتهاء الضفادع،
Dialogue: 0,0:45:48.52,0:45:49.94,نص عام,,0,0,0,,هذا سيكون لي
Dialogue: 0,0:45:50.57,0:45:52.82,نص عام,,0,0,0,,أنا غير مهتم بمثل هذا النزاع
Dialogue: 0,0:45:53.66,0:45:56.41,نص عام,,0,0,0,,لم أكن أتجادل معك، بل معها
Dialogue: 0,0:45:58.16,0:45:59.49,نص عام,,0,0,0,,إذا استسلمت,
Dialogue: 0,0:45:59.58,0:46:02.08,النص العام,,0,0,0,,مما يعني أنها لم تربح معركة واحدة، مما يعني أنها خسرت
Dialogue: 0,0:46:02.96,0:46:04.08,نص عام,,0,0,0,,وهذا سيكون لي
Dialogue: 0,0:46:08.80,0:46:09.92,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:46:11.17,0:46:13.84,نص عام,,0,0,0,,هذا أثمن شيء تلقيته
Dialogue: 0,0:46:15.80,0:46:19.31,نص عام,,0,0,0,,أرجو إعادته
Dialogue: 0,0:46:30.44,0:46:31.48,نص عام,,0,0,0,,شاهد المزيد
Dialogue: 0,0:46:32.11,0:46:33.74,نص عام,,0,0,0,,لقد حصلت حقًا على الضفدع الذهبي
Dialogue: 0,0:46:33.82,0:46:37.37,النص العام,,0,0,0,,دع المملكة المتحدة تقرأ "كلمات من القلب"،
Dialogue: 0,0:46:37.45,0:46:39.78,general text,,0,0,0,,- لكنه لا يشهر السيف جيداً\N- ماذا يحدث؟
Dialogue: 0,0:46:41.70,0:46:44.54,general text,,0,0,0,,جادل الأمير ومو ديوك
Dialogue: 0,0:46:45.54,0:46:48.84,general text,,0,0,0,,ولي العهد أحضر الضفادع الذهبية، فالجميع يريد المشاركة
Dialogue: 0,0:46:50.25,0:46:53.17,نص عام,,0,0,0,,اصطف السحرة الأقوياء
Dialogue: 0,0:46:55.17,0:46:56.80,نص عام,,0,0,0,,ضع
Dialogue: 0,0:47:04.23,0:47:06.73,النص العام,,0,0,0,,صاحب السمو ضحك عليك
Dialogue: 0,0:47:07.27,0:47:09.27,النص العام,,0,0,0,,باعتباري معلمتك، لا أستطيع أن أبقى صامتاً
Dialogue: 0,0:47:09.36,0:47:12.28,نص عام,,0,0,0,,لا تكذب. أنا أعرفك
Dialogue: 0,0:47:13.53,0:47:15.24,نص عام,,0,0,0,,لقد كنت كسولاً في هذين اليومين،
Dialogue: 0,0:47:15.32,0:47:17.70,النص العام,,0,0,0,,فراهنت عليّ أن أتدرب
Dialogue: 0,0:47:20.20,0:47:21.12,نص عام,,0,0,0,,نعم
Dialogue: 0,0:47:22.66,0:47:26.96,general text,,0,0,0,,سيكون عليك القتال مع عشرات السحرة، سواء أعجبك ذلك أم لا
Dialogue: 0,0:47:28.46,0:47:31.63,general text,,0,0,0,,كانت المعركة الأولى أكثر خيبة أمل
Dialogue: 0,0:47:32.25,0:47:34.34,general text,,0,0,0,,الخطوة ثقيلة تحرك السيف ببطء
Dialogue: 0,0:47:34.42,0:47:37.68,general text,,0,0,0,,- غداً مبارزة مع...\N- أرفض
Dialogue: 0,0:47:40.97,0:47:43.26,general text,,0,0,0,,حتى لو خسرت، ستتذكر ما رأيت،
Dialogue: 0,0:47:43.35,0:47:44.56,نص عام,,0,0,0,,هذا سيساعدك
Dialogue: 0,0:47:44.64,0:47:47.64,النص العام,,0,0,0,,- لن أقاتل\N- عشر معارك -
Dialogue: 0,0:47:47.73,0:47:50.23,نص عام,,0,0,0,,عشرة أنماط مختلفة
Dialogue: 0,0:47:51.06,0:47:52.57,نص عام,,0,0,0,,- مو دوك...\N- ماستر,
Dialogue: 0,0:47:52.65,0:47:54.82,نص عام,,0,0,0,,يمكنك العودة إلى المنزل بأمان لتنغمس في الماء
Dialogue: 0,0:47:54.90,0:47:57.20,general text,,0,0,0,,إذن فلن تعود ذلك اليشم أبدًا
Dialogue: 0,0:47:58.78,0:47:59.91,نص عام,,0,0,0,,حسنًا، حسنًا
Dialogue: 0,0:48:00.95,0:48:02.53,نص عام,,0,0,0,,أنت تراهن
Dialogue: 0,0:48:03.12,0:48:04.12,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:48:05.29,0:48:07.00,النص العام,,0,0,0,,لماذا وضعت هديتي؟
Dialogue: 0,0:48:07.71,0:48:08.83,نص عام,,0,0,0,,أنت تعلم
Dialogue: 0,0:48:09.33,0:48:12.79,general text,,0,0,0,,كانت هذه هي الطريقة الوحيدة التي تجعلك تقاتل وتنتصر
Dialogue: 0,0:48:15.55,0:48:16.71,نص عام,,0,0,0,,عندما قلت اشتقت إليك،
Dialogue: 0,0:48:16.80,0:48:19.34,النص العام,,0,0,0,,هل هذا ما قصدته بضعفي؟
Dialogue: 0,0:48:22.18,0:48:23.30,نص عام,,0,0,0,,نعم
Dialogue: 0,0:48:24.68,0:48:26.47,نص عام,,0,0,0,,ربما تكرهني الآن،
Dialogue: 0,0:48:27.68,0:48:30.52,general text,,0,0,0,,لكنك لا تستطيع أن تفقد ما ينتمي لكلينا
Dialogue: 0,0:48:35.32,0:48:37.61,general text,,0,0,0,,أهذا هو سبب قولك أنني تسممت؟
Dialogue: 0,0:48:37.69,0:48:39.99,general text,,0,0,0,,إذا رجعته سأبتسم لك ابتسامة عريضة
Dialogue: 0,0:48:40.91,0:48:42.28,نص عام,,0,0,0,,بدلاً من الترياق
Dialogue: 0,0:48:46.79,0:48:47.91,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:48:49.25,0:48:50.75,نص عام,,0,0,0,,أرجعه بأي شكل من الأشكال
Dialogue: 0,0:48:51.83,0:48:54.21,النص العام,,0,0,0,,هذا أثمن شيء امتلكته على الإطلاق
Dialogue: 0,0:48:55.67,0:48:57.30,نص عام,,0,0,0,,تلقاه في حياتي كلها
Dialogue: 0,0:49:00.01,0:49:01.55,النص العام,,0,0,0,,هل هو عزيز عليك حقًا؟
Dialogue: 0,0:49:02.43,0:49:03.68,نص عام,,0,0,0,,أو...
Dialogue: 0,0:49:05.14,0:49:06.64,نص عام,,0,0,0,,هل هو مكلف للغاية؟
Dialogue: 0,0:49:12.19,0:49:14.23,نص عام,,0,0,0,,سآخذه من ولي العهد
Dialogue: 0,0:49:15.15,0:49:17.19,نص عام,,0,0,0,,من الغريب أن يكون هناك شيء مشترك معه
Dialogue: 0,0:49:24.24,0:49:26.49,نص عام,,0,0,0,,لكن الأمر لم يكن يستحق المشاركة معك أيضًا
Dialogue: 0,0:49:48.35,0:49:50.98,النص العام,,0,0,0,,سمعت أنك تزور سايجوكون كثيرًا
Dialogue: 0,0:49:51.60,0:49:54.81,نص عام,,0,0,0,,ربما تريد تعيين المعلم هوو كمعلم لك
Dialogue: 0,0:49:55.40,0:49:57.65,النص العام,,0,0,0,,وتعلم منه السحر؟
Dialogue: 0,0:49:58.94,0:50:00.15,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:50:00.90,0:50:02.74,نص عام,,0,0,0,,أنت أستاذي
Dialogue: 0,0:50:03.82,0:50:05.57,خط مائل,,0,0,0,,لا أذهب إلى هناك إلا للعلاج
Dialogue: 0,0:50:05.66,0:50:09.29,نص عام,,0,0,0,,استنشاق الهواء النقي. بالإضافة إلى ذلك، غالبًا ما تحدث أشياء مضحكة هناك
Dialogue: 0,0:50:09.37,0:50:13.04,general text,,0,0,0,,يجب أن تستمتع بقضاء الوقت مع سحرة سوسنوفي بور
Dialogue: 0,0:50:13.12,0:50:15.29,نص عام,,0,0,0,,أنا أتحدث مع يول، ابن عمي
Dialogue: 0,0:50:15.37,0:50:17.54,نص عام,,0,0,0,,بارك دان غو ممتع أيضًا
Dialogue: 0,0:50:17.63,0:50:20.88,general text,,0,0,0,,آه تشانغ ووك... أود أن ألقنه درسًا، لكن الأمر ليس بهذه السهولة.
Dialogue: 0,0:50:21.42,0:50:23.97,general text,,0,0,0,,يبدو مسرورًا لأنه قرأ "كلمات من القلب"
Dialogue: 0,0:50:24.05,0:50:26.01,نص عام,,0,0,0,,لذلك اليوم أضعه في مكانه
Dialogue: 0,0:50:26.09,0:50:28.60,italics,,0,0,0,,خسر أمام ساحر أتقن للتو ريوسو
Dialogue: 0,0:50:28.68,0:50:30.81,النص العام,,0,0,0,,الآن يعرف الناس قوته الحقيقية
Dialogue: 0,0:50:30.89,0:50:32.60,النص العام,,0,0,0,,لم يعد أحد معجباً به
Dialogue: 0,0:50:39.61,0:50:40.94,نص عام,,0,0,0,,يشم جميل
Dialogue: 0,0:50:41.65,0:50:43.82,نص عام,,0,0,0,,لقد استبدلتها بعشرة ضفادع ذهبية
Dialogue: 0,0:50:44.82,0:50:47.62,general text,,0,0,0,,- هل هو ذو قيمة كبيرة؟\N- لديه طاقة يين
Dialogue: 0,0:50:48.32,0:50:50.24,نص عام,,0,0,0,,أين النصف الثاني؟
Dialogue: 0,0:50:50.33,0:50:51.37,نص عام,,0,0,0,,الشوط الثاني؟
Dialogue: 0,0:50:51.45,0:50:53.87,general text,,0,0,0,,الأجسام ذات الطاقة المعاكسة لها دائمًا زوج
Dialogue: 0,0:50:53.96,0:50:56.21,مائل,,0,0,0,,يجب أن يكون هناك أيضًا يشم أحمر
Dialogue: 0,0:50:56.96,0:50:59.09,نص عام,,0,0,0,,لها قيمة فقط في أزواج
Dialogue: 0,0:51:03.84,0:51:05.59,مائل,,0,0,0,,إذن لديه موعد؟
Dialogue: 0,0:51:06.09,0:51:07.26,نص عام,,0,0,0,,الخصي يا
Dialogue: 0,0:51:08.05,0:51:10.60,general text,,0,0,0,,إذا قام الناس بإقران الأشياء، فماذا يعني ذلك؟
Dialogue: 0,0:51:10.68,0:51:12.77,general text,,0,0,0,,هذا يعني أنهم متزوجون أو يتواعدون.
Dialogue: 0,0:51:15.23,0:51:16.69,نص عام,,0,0,0,,يا إلهي
Dialogue: 0,0:51:17.31,0:51:20.36,النص العام,,0,0,0,,ألا يعجبك هذا اليشم يا صاحب السمو؟
Dialogue: 0,0:51:20.44,0:51:23.86,general text,,0,0,0,,نعم يغضبني. يثير أعصابي
Dialogue: 0,0:51:24.36,0:51:27.28,نص عام,,0,0,0,,خذها وقسمها إلى قطع صغيرة
Dialogue: 0,0:51:27.36,0:51:29.99,خط مائل,,0,0,0,,لا يمكنك فعل ذلك
Dialogue: 0,0:51:30.07,0:51:31.74,النص العام,,0,0,0,,يمكن لتشان ووك أن يستعيدها
Dialogue: 0,0:51:34.20,0:51:36.00,نص عام,,0,0,0,,إذا أعادها،
Dialogue: 0,0:51:36.87,0:51:38.29,النص العام,,0,0,0,,ثم سيصبحان زوجين مرة أخرى
Dialogue: 0,0:51:39.71,0:51:40.88,نص عام,,0,0,0,,تفضل
Dialogue: 0,0:51:53.18,0:51:54.35,خط مائل,,0,0,0,,- سيد Li\N{\i0}- نعم...
Dialogue: 0,0:51:57.48,0:51:59.94,نص عام,,0,0,0,,ما الذي أتى بك إلى هنا؟
Dialogue: 0,0:52:02.27,0:52:04.98,النص العام,,0,0,0,,ارتديت ملابس القنب طوال العام ولم أشعر بالبرد أبدًا
Dialogue: 0,0:52:05.82,0:52:06.65,خط مائل,,0,0,0,,لكن
Dialogue: 0,0:52:07.65,0:52:09.36,نص عام,,0,0,0,,كان يستحق ارتداء هذا الوشاح،
Dialogue: 0,0:52:10.24,0:52:12.41,نص عام,,0,0,0,,أدركت كم كنت باردًا
Dialogue: 0,0:52:14.91,0:52:16.54,نص عام,,0,0,0,,ما هذا هناك؟
Dialogue: 0,0:52:19.12,0:52:20.12,نص عام,,0,0,0,,ماذا...
Dialogue: 0,0:52:25.00,0:52:28.67,general text,,0,0,0,,لم يسبق لي في حياتي أن بدت الزهور جميلة،
Dialogue: 0,0:52:30.09,0:52:33.89,نص عام,,0,0,0,,ولكن بمجرد أن رأيت هذه الأشياء، أردت أن أقدمها لك
Dialogue: 0,0:52:41.15,0:52:42.69,نص عام,,0,0,0,,الجمال
Dialogue: 0,0:52:43.69,0:52:46.23,نص عام,,0,0,0,,هل هذا لي؟
Dialogue: 0,0:52:53.66,0:52:55.99,نص عام,,0,0,0,,هذه الكتب...
Dialogue: 0,0:52:56.08,0:52:57.45,نص عام,,0,0,0,,لديك كتب جيدة هنا
Dialogue: 0,0:52:58.62,0:53:00.37,نص عام,,0,0,0,,كتاب ممتاز
Dialogue: 0,0:53:07.42,0:53:08.92,نص عام,,0,0,0,,العذراء كيم...
Dialogue: 0,0:53:10.01,0:53:11.18,نص عام,,0,0,0,,مريض؟
Dialogue: 0,0:53:11.26,0:53:13.30,النص العام,,0,0,0,,لم تظهر في سوسنوفي بور منذ فترة طويلة
Dialogue: 0,0:53:13.39,0:53:14.93,نص عام,,0,0,0,,لقد ذهبت إلى هناك بالأمس
Dialogue: 0,0:53:15.55,0:53:17.64,مائل,,0,0,0,,إنها تزور السيد تشان كثيرًا
Dialogue: 0,0:53:18.72,0:53:19.89,نص عام,,0,0,0,,إليك الطريقة
Dialogue: 0,0:53:22.02,0:53:24.48,النص العام,,0,0,0,,هي فقط لم تأتي لرؤيتي
Dialogue: 0,0:53:26.52,0:53:28.78,نص عام,,0,0,0,,لديها ضيف الآن
Dialogue: 0,0:53:28.86,0:53:30.65,نص عام,,0,0,0,,ضيف؟ من؟
Dialogue: 0,0:53:30.74,0:53:34.16,النص العام,,0,0,0,,لا أعرفه لكنه شاب
Dialogue: 0,0:53:34.95,0:53:36.37,نص عام,,0,0,0,,أيها الشاب؟
Dialogue: 0,0:53:37.37,0:53:41.04,general text,,0,0,0,,على حد علمي، الخادمة كيم لا تعرف أي شاب.
Dialogue: 0,0:53:50.97,0:53:52.59,مائل,,0,0,0,,عذراء كيم
Dialogue: 0,0:53:58.18,0:53:59.52,نص عام,,0,0,0,,مرحباً
Dialogue: 0,0:54:01.35,0:54:03.06,النص العام,,0,0,0,,أي نوع من الحشائش هذه؟
Dialogue: 0,0:54:03.14,0:54:04.94,نص عام,,0,0,0,,هذه زهور
Dialogue: 0,0:54:05.81,0:54:08.02,النص العام,,0,0,0,,- ما هي الأعشاب الأخرى؟{\i1}\N- الخادمة كيم
Dialogue: 0,0:54:08.52,0:54:12.11,general text,,0,0,0,,هل تشعر بالإهانة لأنني كنت وقحة في ذلك اليوم؟
Dialogue: 0,0:54:12.90,0:54:14.41,النص العام,,0,0,0,,فتوقفوا عن المجيء؟
Dialogue: 0,0:54:15.45,0:54:18.95,خط مائل,,0,0,0,,لم أكن أعرف حقاً. اعتقدت أنك مريض
Dialogue: 0,0:54:19.03,0:54:21.08,نص عام,,0,0,0,,كنت قلقة وجئت إلى هنا
Dialogue: 0,0:54:21.16,0:54:22.87,نص عام,,0,0,0,,ما كان عليك الحضور
Dialogue: 0,0:54:23.50,0:54:25.58,نص عام,,0,0,0,,قلت أنك لن تأتي إلى هنا أبدًا
Dialogue: 0,0:54:25.67,0:54:27.67,نص عام,,0,0,0,,متى قلت ذلك؟
Dialogue: 0,0:54:27.75,0:54:29.17,نص عام,,0,0,0,,أنت مخطئ
Dialogue: 0,0:54:30.59,0:54:32.17,خط مائل,,0,0,0,,ولكن لا يزال
Dialogue: 0,0:54:32.26,0:54:34.55,نص عام,,0,0,0,,أنا سعيد لأنك بصحة جيدة
Dialogue: 0,0:54:40.43,0:54:42.60,general text,,0,0,0,,إذا كانوا قلقين إلى هذه الدرجة على صحتي،
Dialogue: 0,0:54:43.77,0:54:46.73,نص عام,,0,0,0,,على الأقل يمكنهم جلب الأعشاب الضارة
Dialogue: 0,0:54:46.81,0:54:48.65,نص عام,,0,0,0,,هل تحتاج إلى الأعشاب الضارة؟
Dialogue: 0,0:54:49.23,0:54:50.36,نص عام,,0,0,0,,سأحضرهم
Dialogue: 0,0:54:52.11,0:54:53.82,نص عام,,0,0,0,,لست بحاجة إليهم
Dialogue: 0,0:54:53.90,0:54:57.91,النص العام,,0,0,0,,أنا لا أطلب منك الأعشاب الضارة، بل الزهور
Dialogue: 0,0:55:00.03,0:55:01.62,خط مائل,,0,0,0,,أريدك أن تظهر
Dialogue: 0,0:55:01.70,0:55:03.29,نص عام,,0,0,0,,همومك,
Dialogue: 0,0:55:04.37,0:55:06.17,نص عام,,0,0,0,,اهديني شيئاً جميلاً
Dialogue: 0,0:55:12.96,0:55:16.05,نص عام,,0,0,0,,ضيفي لا يزال هنا، من الأفضل أن تغادر
Dialogue: 0,0:55:17.22,0:55:18.47,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:55:19.30,0:55:20.51,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:55:21.81,0:55:25.39,نص عام,,0,0,0,,عندما تأتي لزيارة أوكا،
Dialogue: 0,0:55:27.19,0:55:29.73,نص عام,,0,0,0,,أتمنى أن تأتي لرؤيتي
Dialogue: 0,0:55:32.53,0:55:34.49,نص عام,,0,0,0,,توقف...
Dialogue: 0,0:55:38.24,0:55:39.99,نص عام,,0,0,0,,يدفعني لأن،
Dialogue: 0,0:55:41.16,0:55:43.20,نص عام,,0,0,0,,أنني جئت خالي الوفاض؟
Dialogue: 0,0:55:44.87,0:55:46.08,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:55:48.33,0:55:49.75,نص عام,,0,0,0,,كم هو ذو دم بارد
Dialogue: 0,0:56:14.61,0:56:17.44,general text,,0,0,0,,بما أن حذائه أصغر من حذائي،
Dialogue: 0,0:56:18.90,0:56:20.78,نص عام,,0,0,0,,هذا يعني أنه أقصر
Dialogue: 0,0:56:35.63,0:56:37.92,نص عام,,0,0,0,,هل تحب الحلويات؟
Dialogue: 0,0:56:38.01,0:56:38.88,نص عام,,0,0,0,,نعم
Dialogue: 0,0:56:45.22,0:56:46.39,نص عام,,0,0,0,,لذيذ
Dialogue: 0,0:56:47.64,0:56:49.44,نص عام,,0,0,0,,ثم خذها
Dialogue: 0,0:56:51.40,0:56:52.52,نص عام,,0,0,0,,هذا لي
Dialogue: 0,0:57:06.95,0:57:09.00,النص العام,,0,0,0,,- كيف أبدو؟\N- جميلة جداً
Dialogue: 0,0:57:09.08,0:57:10.75,النص العام,,0,0,0,,- جربه على\N- أنا؟
Dialogue: 0,0:57:10.83,0:57:11.75,نص عام,,0,0,0,,فكيف؟
Dialogue: 0,0:57:11.83,0:57:13.71,نص عام,,0,0,0,,شنقوه هنا
Dialogue: 0,0:57:26.76,0:57:30.56,نص عام,,0,0,0,,انظري أيتها الزهور
Dialogue: 0,0:57:31.23,0:57:33.27,النص العام,,0,0,0,,قلت أنه يجب عليك شراء الزهور
Dialogue: 0,0:57:33.35,0:57:36.57,النص العام,,0,0,0,,أحتاج إلى تزيين غرفة Boo Young unnie معهم
Dialogue: 0,0:57:38.07,0:57:41.86,النص العام,,0,0,0,,هذه المرة، على ما يبدو، عثروا عليها
Dialogue: 0,0:57:49.20,0:57:52.08,نص عام,,0,0,0,,حقاً؟ هل وجدها جين مو؟
Dialogue: 0,0:57:53.54,0:57:55.08,نص عام,,0,0,0,,ما زال سراً
Dialogue: 0,0:57:56.25,0:57:59.42,نص عام,,0,0,0,,أتمنى أن تعود أوني
Dialogue: 0,0:57:59.51,0:58:03.26,النص العام,,0,0,0,,إذن لن تصبح جينيوون
Dialogue: 0,0:58:03.34,0:58:06.55,نص عام,,0,0,0,,لكنني أستطيع أن أتزوج من أريد
Dialogue: 0,0:58:07.68,0:58:10.93,نص عام,,0,0,0,,يمكنك الزواج من من تحب
Dialogue: 0,0:58:13.44,0:58:14.77,نص عام,,0,0,0,,يسعدني سماع ذلك
Dialogue: 0,0:58:16.73,0:58:19.27,general text,,0,0,0,,إذن علينا فسخ خطوبتنا المزيفة
Dialogue: 0,0:58:19.36,0:58:22.74,النص العام,,0,0,0,,شكرًا لك على التظاهر بأنك خطيبي
Dialogue: 0,0:58:25.41,0:58:26.87,نص عام,,0,0,0,,لم أكن أتظاهر
Dialogue: 0,0:58:28.66,0:58:29.79,خط مائل,,0,0,0,,مشاعري
Dialogue: 0,0:58:31.29,0:58:32.75,نص عام,,0,0,0,,خالص
Dialogue: 0,0:58:36.42,0:58:37.84,مائل,,0,0,0,,سوف تصبح الرأس قريباً
Dialogue: 0,0:58:37.92,0:58:41.71,نص عام,,0,0,0,,هل تتزوجيني؟ هل ستنضم إلى عائلتنا وتترك كل شيء؟
Dialogue: 0,0:58:43.01,0:58:44.13,نص عام,,0,0,0,,نعم
Dialogue: 0,0:58:44.97,0:58:46.68,نص عام,,0,0,0,,أعتقد أنني لم أقلق من أجل لا شيء
Dialogue: 0,0:58:46.76,0:58:49.14,النص العام,,0,0,0,,حتى أنني كنت أستعد لهذا،
Dialogue: 0,0:58:49.97,0:58:51.43,نص عام,,0,0,0,,أنني سأطرد من العائلة
Dialogue: 0,0:58:53.14,0:58:54.48,نص عام,,0,0,0,,هل أنت جاد؟
Dialogue: 0,0:58:55.31,0:58:58.98,general text,,0,0,0,,أردت أن أتخلى عن منصب رئيس سوسنوفي بور من أجلي؟
Dialogue: 0,0:58:59.06,0:59:01.73,النص العام,,0,0,0,,قلت أنك لا تريد زواجاً بلا حب
Dialogue: 0,0:59:02.74,0:59:04.61,مائل,,0,0,0,,ثم فكرت، إذا تزوجنا،
Dialogue: 0,0:59:04.70,0:59:06.82,نص عام,,0,0,0,,سيكون لديك زوج محب.
Dialogue: 0,0:59:09.37,0:59:10.53,نص عام,,0,0,0,,لذلك...
Dialogue: 0,0:59:11.74,0:59:15.41,النص العام,,0,0,0,,حسنًا، لم تقابل بعد الشخص الذي تحبه
Dialogue: 0,0:59:42.36,0:59:44.23,نص عام,,0,0,0,,يبدو أنني كذلك بالفعل
Dialogue: 0,0:59:45.94,0:59:47.15,نص عام,,0,0,0,,التقيت به
Dialogue: 0,0:59:53.70,0:59:55.95,general text,,0,0,0,,إذا تمسكت بي بهذه الطريقة،
Dialogue: 0,1:00:00.75,1:00:02.59,نص عام,,0,0,0,,لن أتركها أبدًا
Dialogue: 0,1:00:03.63,1:00:05.42,خط مائل,,0,0,0,,مشاعري قوية جدًا
Dialogue: 0,1:00:06.72,1:00:08.63,نص عام,,0,0,0,,لا رجعة إلى الوراء
Dialogue: 0,1:00:18.35,1:00:21.61,نص عام,,0,0,0,,نحن بحاجة لشراء الزهور لنقترحها بشكل صحيح
Dialogue: 0,1:00:25.44,1:00:26.65,نص عام,,0,0,0,,لنذهب
Dialogue: 0,1:00:33.91,1:00:37.58,نص عام,,0,0,0,,أرسل هذه الزهور إلى عائلة تشان
Dialogue: 0,1:00:37.66,1:00:40.75,نص عام,,0,0,0,,هل مات أحد؟
Dialogue: 0,1:00:40.83,1:00:42.88,general text,,0,0,0,,لماذا ترسل لهم الأقحوان؟
Dialogue: 0,1:00:46.59,1:00:48.67,نص عام,,0,0,0,,كدت أن أرتكب خطأً كبيراً
Dialogue: 0,1:00:48.76,1:00:49.80,نص عام,,0,0,0,,بالضبط
Dialogue: 0,1:00:51.01,1:00:52.26,نص عام,,0,0,0,,من هنا
الحوار: 0,1:00:53.39,1:00:54.89,نص عام,,0,0,0,,إلى هنا
Dialogue: 0,1:00:54.97,1:00:56.47,نص عام,,0,0,0,,أرسل كل شيء
Dialogue: 0,1:00:56.56,1:00:59.14,نص عام,,0,0,0,,- كل هذه الزهور؟\N- نعم جميعها
Dialogue: 0,1:00:59.23,1:01:01.90,نص عام,,0,0,0,,- أنا متأكد من أنها ستحب شيئًا على الأقل{\i1}\N- لا يمكن أن يكون
Dialogue: 0,1:01:01.98,1:01:04.23,نص عام,,0,0,0,,شكرًا جزيلا لك
Dialogue: 0,1:01:06.90,1:01:09.19,النص العام,,0,0,0,,- أي منها تفضل؟\N- هذه هذه
Dialogue: 0,1:01:09.90,1:01:12.03,نص عام,,0,0,0,,أستطيع شراء كل شيء إذا أردت
Dialogue: 0,1:01:36.64,1:01:38.68,النص العام,,0,0,0,,أنت رئيس سوسنوفي بور المستقبلي
Dialogue: 0,1:01:39.85,1:01:42.23,general text,,0,0,0,,لماذا تقابل رئيس جينيوون المستقبلي؟
Dialogue: 0,1:01:42.73,1:01:43.81,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,1:01:44.48,1:01:47.52,general text,,0,0,0,,هل تريد التنازل عن ميراثك والانضمام إلى عائلتهم؟
Dialogue: 0,1:01:47.61,1:01:51.20,نص عام,,0,0,0,,عم نحب بعضنا البعض
Dialogue: 0,1:01:51.86,1:01:53.91,نص عام,,0,0,0,,منذ وقت ليس ببعيد تشو يونغ
Dialogue: 0,1:01:54.82,1:01:56.28,نص عام,,0,0,0,,أحببت أوكا
Dialogue: 0,1:01:56.91,1:01:58.95,نص عام,,0,0,0,,لا. اليوم أثبتت ذلك لي
Dialogue: 0,1:01:59.04,1:02:03.00,general text,,0,0,0,,قالت تشو يونغ إنها ستتخلى عن لقب الرأس من أجل الحب
Dialogue: 0,1:02:03.08,1:02:04.58,نص عام,,0,0,0,,لديهم ابنة واحدة فقط
Dialogue: 0,1:02:04.67,1:02:06.21,general text,,0,0,0,,من سيصبح رئيس جينيون إذن؟
Dialogue: 0,1:02:06.79,1:02:09.25,النص العام,,0,0,0,,سوف تصبح الابنة الكبرى
Dialogue: 0,1:02:09.34,1:02:12.80,general text,,0,0,0,,يساعدهم سحرة جيونبوغوان في العثور على أختها المفقودة
Dialogue: 0,1:02:14.22,1:02:15.14,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:02:15.22,1:02:17.93,النص العام,,0,0,0,,يأتي النائب جين مو لرؤيتهم كل يوم
Dialogue: 0,1:02:19.64,1:02:20.97,نص عام,,0,0,0,,جين مو؟
Dialogue: 0,1:02:22.60,1:02:24.56,نص عام,,0,0,0,,ليتني أخًا،
Dialogue: 0,1:02:24.65,1:02:27.44,النص العام,,0,0,0,,الذي سيصبح الرأس بدلاً مني
Dialogue: 0,1:02:28.86,1:02:31.32,خط مائل,,0,0,0,,أنا أسأل بدافع الفضول فقط
Dialogue: 0,1:02:32.11,1:02:35.99,general text,,0,0,0,,عمي، هل أنت متأكد أنه ليس لديك طفل بجانبك؟
Dialogue: 0,1:02:39.91,1:02:40.83,نص عام,,0,0,0,,لا شيء؟
Dialogue: 0,1:02:42.45,1:02:43.62,نص عام,,0,0,0,,على الإطلاق؟
Dialogue: 0,1:02:46.17,1:02:47.00,نص عام,,0,0,0,,اخرج
Dialogue: 0,1:02:48.75,1:02:50.09,نص عام,,0,0,0,,اخرج
Dialogue: 0,1:02:50.17,1:02:51.30,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:02:51.38,1:02:52.46,نص عام,,0,0,0,,اخرج!
Dialogue: 0,1:02:54.63,1:02:57.26,general text,,0,0,0,,لم يفت الأوان بعد، يمكنك إنجاب طفل الآن
Dialogue: 0,1:02:57.34,1:02:58.30,نص عام,,0,0,0,,أنت...
Dialogue: 0,1:02:58.39,1:03:00.22,نص عام,,0,0,0,,أعني أنك مازلت مليئاً بالقوة
Dialogue: 0,1:03:02.14,1:03:04.23,نص عام,,0,0,0,,قبض على هذا الوغد!
Dialogue: 0,1:03:08.65,1:03:09.90,نص عام,,0,0,0,,حسنًا، حسنًا
Dialogue: 0,1:03:20.83,1:03:23.16,نص عام,,0,0,0,,لماذا يوجد الكثير من الألوان هنا؟
Dialogue: 0,1:03:23.83,1:03:27.17,نص عام,,0,0,0,,لقد تشاجرت مع شخص واحد. لذا فهو يحاول صنع السلام
Dialogue: 0,1:03:28.71,1:03:32.25,نص عام,,0,0,0,,أتمنى أن تسامحيه. هذه الزهور جميلة
Dialogue: 0,1:03:34.67,1:03:36.55,نص عام,,0,0,0,,أنت لطيف جدًا
Dialogue: 0,1:03:37.68,1:03:39.72,نص عام,,0,0,0,,والدة السيد الشاب تشان...
Dialogue: 0,1:03:40.30,1:03:42.76,نص عام,,0,0,0,,كان لطيفاً مثلك
Dialogue: 0,1:03:43.77,1:03:45.10,النص العام,,0,0,0,,على ما يبدو، المملكة المتحدة دخلت في هذا الأمر
Dialogue: 0,1:03:47.31,1:03:48.31,نص عام,,0,0,0,,سيد؟
Dialogue: 0,1:03:49.69,1:03:53.07,نص عام,,0,0,0,,ما الذي جعلك تعتقد ذلك؟
Dialogue: 0,1:03:55.36,1:03:57.36,نص عام,,0,0,0,,عندما تحدث عن والدته،
Dialogue: 0,1:03:57.45,1:03:59.20,نص عام,,0,0,0,,شعرت بالدفء
Dialogue: 0,1:04:00.24,1:04:01.45,نص عام,,0,0,0,,رأيته في عينيه
Dialogue: 0,1:04:02.83,1:04:03.66,نص عام,,0,0,0,,انتظر لحظة...
Dialogue: 0,1:04:04.41,1:04:07.41,نص عام,,0,0,0,,هل كلمك عن والدته؟
Dialogue: 0,1:04:08.71,1:04:10.54,نص عام,,0,0,0,,لابد أنك قريب منه جدًا
Dialogue: 0,1:04:11.75,1:04:13.63,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,1:04:13.71,1:04:15.71,نص عام,,0,0,0,,فقط السيد الشاب تشان يريد التقرب
Dialogue: 0,1:04:15.80,1:04:19.18,النص العام,,0,0,0,,آخر مرة قضى ما يصل إلى 4 ساعات مع السيدة
Dialogue: 0,1:04:20.30,1:04:21.22,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,1:04:22.43,1:04:24.22,نص عام,,0,0,0,,لقد تحدثنا قليلاً
Dialogue: 0,1:04:26.68,1:04:29.44,نص عام,,0,0,0,,اتضح أنه أنت. مالك الحزين الأبيض
Dialogue: 0,1:04:30.69,1:04:33.77,general text,,0,0,0,,قد يكون الرجل باردًا، فقد عانى في الماضي
Dialogue: 0,1:04:33.86,1:04:37.57,نص عام,,0,0,0,,وكيفية الانفتاح على شخص ما - لطيفًا ومهتمًا
Dialogue: 0,1:04:39.53,1:04:41.45,نص عام,,0,0,0,,زورونا كثيرًا
Dialogue: 0,1:04:41.53,1:04:43.78,نص عام,,0,0,0,,اعتبر هذا المكان عشك
Dialogue: 0,1:04:43.87,1:04:46.29,نص عام,,0,0,0,,وتعال إلى هنا كثيرًا
Dialogue: 0,1:04:47.50,1:04:48.66,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:04:55.38,1:04:58.88,general text,,0,0,0,,جين مو يساعد جين هو كيونغ في العثور على ابنته؟
Dialogue: 0,1:04:58.97,1:05:01.22,نص عام,,0,0,0,,أعتقد أن هذا مجرد عذر
Dialogue: 0,1:05:01.30,1:05:03.14,نص عام,,0,0,0,,قم بزيارة جينيوون
Dialogue: 0,1:05:03.93,1:05:07.81,نص عام,,0,0,0,,أعتقد أن جين مو يريد الحصول على دعم جينيوون
Dialogue: 0,1:05:09.10,1:05:11.65,نص عام,,0,0,0,,إذا نجح،
Dialogue: 0,1:05:12.44,1:05:15.19,نص عام,,0,0,0,,يستطيع مقاومة غابة الصنوبر
Dialogue: 0,1:05:15.27,1:05:16.27,نص عام,,0,0,0,,وبعد ذلك...
Dialogue: 0,1:05:18.28,1:05:20.65,نص عام,,0,0,0,,هو وشعبه بلا خوف ولا ندم
Dialogue: 0,1:05:22.66,1:05:26.20,نص عام,,0,0,0,,سوف يكشف للعالم قوة حجر الجليد
Dialogue: 0,1:05:34.04,1:05:38.26,مائل,,0,0,0,,أحد أفراد جين مو لديه الحجر
Dialogue: 0,1:05:40.01,1:05:43.22,مائل,,0,0,0,,الجميع يعتقد أن الحجر مصنوع من الجليد،
Dialogue: 0,1:05:43.76,1:05:48.39,مائل,,0,0,0,,لكن قوى النار والماء والرياح تتركز فيها
Dialogue: 0,1:05:49.31,1:05:51.52,مائل,,0,0,0,,قبل 200 عام، قام ساحر من عائلة تشوي بإنشاء عاكس
Dialogue: 0,1:05:52.23,1:05:56.40,italics,,0,0,0,,والآن يستخدم شخص ما قوة الحجر لتكرار هذا
Dialogue: 0,1:06:07.78,1:06:11.50,مائل,,0,0,0,,دفعة جديدة من العاكسات صنعتها الملكة
Dialogue: 0,1:06:16.67,1:06:19.42,مائل,,0,0,0,,الشر لا يكمن في قوة حجر الجليد
Dialogue: 0,1:06:19.50,1:06:23.63,italics,,0,0,0,,العاكس هو ما يستخدم لأغراض شريرة
Dialogue: 0,1:06:26.93,1:06:30.10,italics,,0,0,0,,قوة خارجة عن سيطرة شخص عادي،
Dialogue: 0,1:06:30.18,1:06:32.43,مائل,,0,0,0,,سيرغب في الحصول على كل شيء إذا أصبح متاحًا
Dialogue: 0,1:06:33.64,1:06:36.19,خط مائل,,0,0,0,,القدرة على ترك الجسد القديم
Dialogue: 0,1:06:36.27,1:06:38.02,خط مائل,,0,0,0,,وخذ واحدة جديدة
Dialogue: 0,1:06:39.77,1:06:44.07,مائل,,0,0,0,,جسد عجوز مقابل شاب وقبيح بجميل
Dialogue: 0,1:06:45.36,1:06:49.03,مائل,,0,0,0,,القدرة على إيقاف الموت وجعل الحياة أبدية
Dialogue: 0,1:07:04.72,1:07:07.89,النص العام,,0,0,0,,إنه شاب شاب يتمتع بصحة جيدة ورائع
Dialogue: 0,1:07:08.47,1:07:09.47,نص عام,,0,0,0,,تم الاختيار...
Dialogue: 0,1:07:10.39,1:07:13.64,نص عام,,0,0,0,,بقلم خليفتي
Dialogue: 0,1:07:14.43,1:07:16.56,نص عام,,0,0,0,,أريد الهجرة إلى جسده
Dialogue: 0,1:07:17.85,1:07:19.27,نص عام,,0,0,0,,ماستر
Dialogue: 0,1:07:20.27,1:07:22.65,نص عام,,0,0,0,,ما هي التعويذة التي تريد أن تريني إياها؟
Dialogue: 0,1:07:23.24,1:07:24.57,نص عام,,0,0,0,,كيمياء النفوس
Dialogue: 0,1:07:25.15,1:07:26.40,نص عام,,0,0,0,,كيمياء النفوس؟
Dialogue: 0,1:07:28.07,1:07:32.83,نص عام,,0,0,0,,لا يزال لدي الكثير من الأشياء لأقوم بها،
Dialogue: 0,1:07:33.45,1:07:37.21,general text,,0,0,0,,لكن هذا الجسد ليس بخير، المرض يقرب موته الوشيك
Dialogue: 0,1:07:38.46,1:07:39.54,نص عام,,0,0,0,,لذلك...
Dialogue: 0,1:07:40.96,1:07:43.21,نص عام,,0,0,0,,أحتاج إلى جسدك
Dialogue: 0,1:07:47.55,1:07:48.72,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:08:05.99,1:08:09.20,نص عام,,0,0,0,,لنبدأ بكيمياء النفوس
Dialogue: 0,1:08:17.21,1:08:19.25,نص عام,,0,0,0,,سيدتي، لا أريد تبديل الجثث
Dialogue: 0,1:08:19.83,1:08:22.25,general text,,0,0,0,,إذا بدلت الجثث معك سأموت قريبًا
Dialogue: 0,1:08:22.34,1:08:24.30,نص عام,,0,0,0,,لكن جسدك سيعيش
Dialogue: 0,1:08:35.39,1:08:36.52,خط مائل,,0,0,0,,مساعدة
Dialogue: 0,1:08:37.14,1:08:38.44,نص عام,,0,0,0,,أنقذوني
Dialogue: 0,1:08:39.23,1:08:42.15,نص عام,,0,0,0,,ساعدني! يساعد!
Dialogue: 0,1:08:44.61,1:08:46.32,نص عام,,0,0,0,,سيدتي!
Dialogue: 0,1:10:33.84,1:10:35.01,نص عام,,0,0,0,,ماستر
Dialogue: 0,1:10:36.01,1:10:37.01,نص عام,,0,0,0,,جسدي...
Dialogue: 0,1:10:37.10,1:10:38.93,نص عام,,0,0,0,,أرجع كل شيء إلى الوراء
Dialogue: 0,1:10:39.51,1:10:41.73,نص عام,,0,0,0,,من فضلك. لا أريد أن أموت
Dialogue: 0,1:10:41.81,1:10:44.31,نص عام,,0,0,0,,سيدتي! أعطني جسدي
Dialogue: 0,1:10:44.39,1:10:47.11,نص عام,,0,0,0,,سيدتي! أريد العودة إلى جسدي
Dialogue: 0,1:10:47.19,1:10:49.11,خط مائل,,0,0,0,,سيدتي!
Dialogue: 0,1:10:50.57,1:10:54.86,general text,,0,0,0,,كيمياء النفوس ساعدت في إنقاذ حياة شخص آخر
Dialogue: 0,1:10:55.70,1:10:56.91,نص عام,,0,0,0,,ساحر قيم
Dialogue: 0,1:11:06.71,1:11:07.92,نص عام,,0,0,0,,بينما نحن
Dialogue: 0,1:11:08.92,1:11:10.67,نص عام,,0,0,0,,لدينا قوة الحجر،
Dialogue: 0,1:11:10.75,1:11:14.30,general text,,0,0,0,,ستكون أرواحنا قادرة على العيش إلى الأبد، ولن تتعفن في هذه الأجساد
Dialogue: 0,1:11:15.34,1:11:18.47,italics,,0,0,0,,الآن قوة الحجر محظورة،
Dialogue: 0,1:11:18.55,1:11:21.97,نص عام,,0,0,0,,لذا عليك أن تمارس الكيمياء سرًا
Dialogue: 0,1:11:22.06,1:11:26.27,general text,,0,0,0,,ولكن عاجلاً أم آجلاً سيأتي اليوم الذي ستتقوى فيه قوتنا
Dialogue: 0,1:11:26.35,1:11:29.77,general text,,0,0,0,,سنبين للجميع أننا على حق. عملنا الشاق سوف يؤتي ثماره
Dialogue: 0,1:11:31.15,1:11:32.40,نص عام,,0,0,0,,وفي مثل هذا اليوم
Dialogue: 0,1:11:33.53,1:11:35.11,نص عام,,0,0,0,,جميع الحاضرين هنا...
Dialogue: 0,1:11:35.65,1:11:39.03,النص العام,,0,0,0,,سوف يهزم الموت وينال الحياة الأبدية
Dialogue: 0,1:12:02.35,1:12:03.93,نص عام,,0,0,0,,هل رأيت كل شيء؟
Dialogue: 0,1:12:06.89,1:12:07.98,نص عام,,0,0,0,,نعم
Dialogue: 0,1:12:08.06,1:12:12.48,نص عام,,0,0,0,,يجب عليك إحضار شخص واحد هنا
Dialogue: 0,1:12:13.98,1:12:17.82,general text,,0,0,0,,جين هو كيونغ ستصبح والدتك. اقترب منها
Dialogue: 0,1:12:17.90,1:12:20.74,نص عام,,0,0,0,,ثم أحضرها إلى هنا
Dialogue: 0,1:12:22.62,1:12:24.04,نص عام,,0,0,0,,هل تستطيع التعامل معه؟
Dialogue: 0,1:12:27.79,1:12:28.87,نص عام,,0,0,0,,نعم
Dialogue: 0,1:12:38.88,1:12:40.30,خط مائل,,0,0,0,,إنها تناسبها
Dialogue: 0,1:12:41.34,1:12:43.72,مائل,,0,0,0,,إذا كان بإمكانك إحضار جين هو كيونغ هنا،
Dialogue: 0,1:12:45.01,1:12:49.02,النص العام,,0,0,0,,سيكون من الأسهل الكشف عن قوة الحجر للعالم أجمع
Dialogue: 0,1:13:40.65,1:13:42.28,نص عام,,0,0,0,,لماذا لم تنم بعد؟
Dialogue: 0,1:13:53.50,1:13:55.46,خط مائل,,0,0,0,,يمكن أن يصبح جين مو
Dialogue: 0,1:13:55.54,1:13:59.71,نص عام,,0,0,0,,أقوى وأكثر تأثيراً مما نعتقد
Dialogue: 0,1:14:00.97,1:14:05.01,general text,,0,0,0,,بالتأكيد ظهر نجم الملك ليقضي على الفوضى التي سببها الحجر
Dialogue: 0,1:14:07.47,1:14:10.10,نص عام,,0,0,0,,هل تتحدث عن أوك؟
Dialogue: 0,1:14:10.18,1:14:13.94,general text,,0,0,0,,السيد سو كيونغ الذي منع الرعب قبل مائتي عام،
Dialogue: 0,1:14:14.02,1:14:16.23,نص عام,,0,0,0,,ولد أيضًا تحت نجم مماثل
Dialogue: 0,1:14:16.31,1:14:18.11,النص العام,,0,0,0,,هذا النجم خلقه السحر
Dialogue: 0,1:14:18.19,1:14:20.07,general text,,0,0,0,,لا يمكن مقارنتها بنجمة المعلم سيو كيونغ.
Dialogue: 0,1:14:21.36,1:14:24.20,نص عام,,0,0,0,,هل ذكرت أن النجم هو نفسه؟
Dialogue: 0,1:14:26.03,1:14:27.70,نص عام,,0,0,0,,لذا أشعر بالفضول
Dialogue: 0,1:14:30.79,1:14:34.92,نص عام,,0,0,0,,أتساءل عما إذا كان هذا النجم سيختفي ببطء
Dialogue: 0,1:14:36.29,1:14:37.88,نص عام,,0,0,0,,أم أنها ستتألق؟
Dialogue: 0,1:15:16.08,1:15:17.13,خط مائل,,0,0,0,,النصر!
Dialogue: 0,1:15:17.21,1:15:19.67,خط مائل,,0,0,0,,- ممتاز\N- عمل جيد
Dialogue: 0,1:15:19.75,1:15:20.84,خط مائل,,0,0,0,,كنت أعرف ذلك
Dialogue: 0,1:16:03.76,1:16:05.38,نص عام,,0,0,0,,كنت أعرف عن تانسو
Dialogue: 0,1:16:06.13,1:16:08.22,مائل,,0,0,0,,الأمير لم يكن يعلم ففعلت ذلك
Dialogue: 0,1:16:08.30,1:16:11.22,نص عام,,0,0,0,,وكذلك الماء من البركة التي رآها الجميع
Dialogue: 0,1:16:11.30,1:16:12.51,نص عام,,0,0,0,,سهل كالفطيرة
Dialogue: 0,1:16:26.69,1:16:27.95,خط مائل,,0,0,0,,النصر!
Dialogue: 0,1:16:29.78,1:16:32.62,خط مائل,,0,0,0,,- ممتاز!\N- مذهل!
Dialogue: 0,1:16:52.05,1:16:54.26,نص عام,,0,0,0,,لم يتبق سوى ثلاثة ضفادع؟
Dialogue: 0,1:16:54.35,1:16:55.60,نص عام,,0,0,0,,نعم
Dialogue: 0,1:16:56.56,1:16:59.69,general text,,0,0,0,,إذًا كان يقاتل طوال الأيام السبعة الماضية على التوالي؟
Dialogue: 0,1:16:59.77,1:17:01.85,نص عام,,0,0,0,,ويضيع باستمرار
Dialogue: 0,1:17:03.36,1:17:06.19,نص عام,,0,0,0,,اعتقدت أنه سيتوقف إذا استمر في الخسارة
Dialogue: 0,1:17:09.07,1:17:11.07,النص العام,,0,0,0,,يبدو أنه يحاول ذلك
Dialogue: 0,1:17:11.16,1:17:14.70,general text,,0,0,0,,كما قلت، فهو لا يستخدم السيف جيدًا، ونوباته ضعيفة
Dialogue: 0,1:17:14.78,1:17:16.20,general text,,0,0,0,,لكنه يواصل القتال...
Dialogue: 0,1:17:16.29,1:17:18.83,نص عام,,0,0,0,,فقط لأنه مثابر
Dialogue: 0,1:17:19.33,1:17:22.96,general text,,0,0,0,,هذه مجرد مبارزات، لكنه يتقاتل مع السحرة الآخرين كل يوم
Dialogue: 0,1:17:23.04,1:17:24.59,خط مائل,,0,0,0,,إنه مرهق بالتأكيد
Dialogue: 0,1:17:24.67,1:17:27.67,general text,,0,0,0,,صاحب السمو، أنا أؤمن بانتصارك
Dialogue: 0,1:17:27.76,1:17:30.72,general text,,0,0,0,,حتى أنني لم تتح لي الفرصة لمحاربة سحرة جيونجينغاك
Dialogue: 0,1:17:30.80,1:17:33.26,نص عام,,0,0,0,,لكنني تركت تشان ووك يفعل ذلك...
Dialogue: 0,1:17:33.34,1:17:35.60,نص عام,,0,0,0,,لضفادعك الذهبية
Dialogue: 0,1:17:35.68,1:17:37.68,general text,,0,0,0,,وون مو ديوك خدعني مرة أخرى؟
Dialogue: 0,1:17:57.87,1:18:00.79,خلف الكواليس,,0,0,0,,قاتل واخسر، تشان ووك
Dialogue: 0,1:18:15.30,1:18:18.22,خلف الكواليس,,0,0,0,,كل ما لا يقتلك,
Dialogue: 0,1:18:23.19,1:18:26.15,خلف الكواليس,,0,0,0,,يجعلك أقوى
Dialogue: 0,1:18:59.56,1:19:01.77,preview,,0,0,0,,- تشان ووك!\N- هل أتيت إلى المالك؟
Dialogue: 0,1:19:01.85,1:19:04.10,preview,,0,0,0,,دعه يخسر، يصبح أقوى
Dialogue: 0,1:19:05.69,1:19:06.52,معاينة,,0,0,0,,لا تذهب
Dialogue: 0,1:19:06.60,1:19:08.40,preview,,0,0,0,,لا تذهب إلى غرفتك، ابق هنا
Dialogue: 0,1:19:08.48,1:19:11.07,معاينة,,0,0,0,,يا له من رعب! انظر إلى الأحذية. كل الرطب
Dialogue: 0,1:19:11.15,1:19:12.40,معاينة,,0,0,0,,أنت مجروح
Dialogue: 0,1:19:13.99,1:19:17.49,preview,,0,0,0,,هناك هياج في العاصمة. الليلة الماضية تعرض لهجوم من قبل العديد من القتلة
Dialogue: 0,1:19:18.57,1:19:20.83,preview,,0,0,0,,- لا تقتله!\N- اقتله!
Dialogue: 0,1:19:21.79,1:19:23.87,preview,,0,0,0,,- إنه بدو\N- اخرج!
Dialogue: 0,1:19:23.96,1:19:25.58,معاينة,,0,0,0,,- أنا قادم\N- تشان ووك
Dialogue: 0,1:19:25.67,1:19:29.96,preview,,0,0,0,,لا أعتقد أنه من الصواب التخلي عن ساحر وصل للتو إلى هنا بهذه السهولة
Dialogue: 0,1:19:30.04,1:19:32.13,معاينة,,0,0,0,,بمجرد أن تصبح جامحًا، لا يمكنك العودة
Dialogue: 0,1:19:32.21,1:19:34.22,preview,,0,0,0,,لا يمكنك أن تصبح رجلاً، بل مجرد وحش
Dialogue: 0,1:19:34.30,1:19:36.88,معاينة,,0,0,0,,يمكننا حماية وحوش هذا العالم
Dialogue: 0,1:19:39.60,1:19:44.60,معاينة,,0,0,0,,
Dialogue: 0,1:19:44.60,1:19:46.60,نص عام,,0,0,0,,
