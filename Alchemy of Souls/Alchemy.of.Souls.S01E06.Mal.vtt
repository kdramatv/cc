Dialog: 0,0:02:47.39,0:02:49.39,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.39,0:02:51.39,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:51.39,0:02:53.39,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, Zero_Amamiya
Dialog: 0,0:01:04.34,0:01:06.39,kenangan,,0,0,0,,Yul dari keluarga So
Dialog: 0,0:01:08.10,0:01:09.68,kenangan,,0,0,0,,Jangan kembali ke sini
Dialog: 0,0:01:16.06,0:01:17.48,kenangan,,0,0,0,,Anda akan datang lagi -
Dialog: 0,0:01:18.90,0:01:20.53,kenangan,,0,0,0,,Saya akan bunuh awak
Dialog: 0,0:01:25.99,0:01:26.82,kenangan,,0,0,0,,Tunggu...
Dialog: 0,0:01:52.85,0:01:55.69,suara,,0,0,0,,Saya tidak dapat menghalangnya
Dialog: 0,0:01:57.10,0:01:58.94,di sebalik tabir,,0,0,0,,Saya tidak boleh bertanya mengapa
Dialog: 0,0:02:00.19,0:02:03.44,suara,,0,0,0,,Apabila dia memotong ketulusan saya,
Dialog: 0,0:02:04.86,0:02:07.53,di sebalik tabir,,0,0,0,,Saya berhenti menghargai kenangan kita
Dialog: 0,0:02:08.82,0:02:11.45,suara,,0,0,0,,Semuanya menjadi rahsia yang perlu saya simpan dalam hati
Dialog: 0,0:02:17.79,0:02:21.21,teks umum,,0,0,0,,Awak bangun awal. awak buat apa kat sini?
Dialog: 0,0:02:25.51,0:02:26.80,teks umum,,0,0,0,,Kenapa awak
Dialog: 0,0:02:27.80,0:02:29.26,teks umum,,0,0,0,,datang ke sini?
Dialog: 0,0:02:32.01,0:02:34.35,teks umum,,0,0,0,,Tangkap burung itu. Saya akan sediakan untuk awak
Dialog: 0,0:02:37.23,0:02:38.73,teks umum,,0,0,0,,Makanan tidak menggembirakan saya
Dialog: 0,0:02:38.81,0:02:40.77,teks umum,,0,0,0,,Saya akan masak nasi dengan buah berangan
Dialog: 0,0:02:41.90,0:02:44.15,teks umum,,0,0,0,,Berangan di sini sangat manis
Dialog: 0,0:02:48.03,0:02:50.82,teks umum,,0,0,0,,Terdapat buah berangan yang sangat manis di Danhyangk
Dialog: 0,0:03:04.00,0:03:05.46,teks umum,,0,0,0,,Dan saya juga tidak suka manisan
Dialog: 0,0:03:08.80,0:03:11.01,teks umum,,0,0,0,,Anda boleh menolak
Dialog: 0,0:03:11.09,0:03:13.47,teks umum,,0,0,0,,Memandangkan kekuatan awak, saya boleh mati
Dialog: 0,0:03:16.02,0:03:17.43,teks umum,,0,0,0,,Jangan terlalu bertindak
Dialog: 0,0:03:18.39,0:03:21.73,teks umum,,0,0,0,,Saya menolak awak, tetapi saya tidak berniat untuk membunuh awak
Dialog: 0,0:03:21.81,0:03:23.40,teks umum,,0,0,0,,Tetapi mereka menolak
Dialog: 0,0:03:24.02,0:03:25.94,teks umum,,0,0,0,,Tidak perlu bersusah payah dengan sarapan pagi
Dialog: 0,0:03:26.03,0:03:27.49,teks umum,,0,0,0,,Saya akan pergi apabila Dan Gu bangun
Dialog: 0,0:03:27.57,0:03:30.11,teks umum,,0,0,0,,Tidak mahu, seperti yang anda mahu
Dialog: 0,0:03:46.76,0:03:48.13,teks umum,,0,0,0,,Kenapa awak masih di sini?
Dialog: 0,0:03:50.01,0:03:51.26,teks umum,,0,0,0,,Saya akan makan sebelum pergi
Dialog: 0,0:03:51.84,0:03:52.93,teks umum,,0,0,0,,Masak makanan
Dialog: 0,0:03:53.01,0:03:54.64,teks umum,,0,0,0,,Saya fikir awak tidak mahu
Dialog: 0,0:03:55.22,0:03:57.52,teks umum,,0,0,0,,Saya tidak cakap begitu. Jangan buat fitnah
Dialog: 0,0:04:00.23,0:04:04.56,teks umum,,0,0,0,,Anda minum terlalu banyak semalam, saya fikir anda akan berasa tidak sihat pada waktu pagi
Dialog: 0,0:04:04.65,0:04:07.19,teks umum,,0,0,0,,Saya menolak supaya tidak mengganggu awak
Dialog: 0,0:04:08.28,0:04:09.49,teks umum,,0,0,0,,Difahamkan
Dialog: 0,0:04:10.28,0:04:11.45,teks umum,,0,0,0,,Kemudian
Dialog: 0,0:04:11.53,0:04:14.12,teks am,,0,0,0,,- kita perlu basuh lebih banyak beras\N- Di mana?
Dialog: 0,0:04:14.78,0:04:17.49,teks am,,0,0,0,,- Saya akan basuh\N- Awak dah masak nasi ke?
Dialog: 0,0:04:17.58,0:04:20.87,teks umum,,0,0,0,,Tidak, tetapi saya boleh jika anda mengajar saya
Dialog: 0,0:04:22.00,0:04:23.42,teks umum,,0,0,0,,Ia sangat mudah
Dialog: 0,0:04:24.08,0:04:27.55,teks am,,0,0,0,,Bilas beras dalam air, masukkan air secukupnya
Dialog: 0,0:04:27.63,0:04:29.09,teks umum,,0,0,0,,dan masak dengan api yang tinggi
Dialog: 0,0:04:29.92,0:04:32.09,teks umum,,0,0,0,,Dan kemudian biarkan ia berdiri
Dialog: 0,0:04:33.43,0:04:35.14,teks umum,,0,0,0,,Agak mudah
Dialog: 0,0:04:43.85,0:04:46.31,teks umum,,0,0,0,,Anda kata anda boleh jika saya menjelaskan
Dialog: 0,0:04:46.40,0:04:48.11,teks umum,,0,0,0,,Mereka sendiri berkata ia mudah
Dialog: 0,0:04:49.65,0:04:52.74,teks umum,,0,0,0,,Saya silap. saya minta maaf
Dialog: 0,0:04:53.49,0:04:55.95,teks umum,,0,0,0,,Lihat ini
Dialog: 0,0:04:56.03,0:04:57.62,teks umum,,0,0,0,,Dia terbakar di seluruh
Dialog: 0,0:04:58.41,0:05:00.50,teks umum,,0,0,0,,Biar saya tebus kesalahan
Dialog: 0,0:05:02.08,0:05:03.62,teks umum,,0,0,0,,Dan sayur-sayuran itu
Dialog: 0,0:05:03.71,0:05:05.13,teks am,,0,0,0,,Ajar cara memotong sayur
Dialog: 0,0:05:09.96,0:05:12.72,teks umum,,0,0,0,,- Buang saja sekarang\N- Wow
Dialog: 0,0:05:19.60,0:05:20.93,teks umum,,0,0,0,,Dan Gu
Dialog: 0,0:05:22.06,0:05:22.93,teks umum,,0,0,0,,Hei
Dialog: 0,0:05:23.52,0:05:25.19,teks umum,,0,0,0,,Berenang sebelum pergi
Dialog: 0,0:05:25.27,0:05:27.15,teks am,,0,0,0,,Air mineral akan menjadikan kulit anda lebih lembut
Dialog: 0,0:05:27.23,0:05:28.82,teks umum,,0,0,0,,Dan bersarapan
Dialog: 0,0:05:28.90,0:05:30.23,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:05:30.32,0:05:32.44,teks umum,,0,0,0,,Moo Deok dan Yul menyediakan sarapan bersama-sama
Dialog: 0,0:05:33.36,0:05:34.74,teks umum,,0,0,0,,- Bersama-sama?\N- Ya
Dialog: 0,0:05:34.82,0:05:37.12,teks am,,0,0,0,,Yul masak nasi dengan Moo Deok
Dialog: 0,0:05:49.54,0:05:53.17,teks am,,0,0,0,,saya suruh potong bawang besar
Dialog: 0,0:05:58.18,0:05:59.26,teks umum,,0,0,0,,- Adakah ini besar?\N- Tidak
Dialog: 0,0:05:59.93,0:06:02.47,teks umum,,0,0,0,,Anda tidak tahu maksud perkataan "besar"?
Dialog: 0,0:06:02.56,0:06:04.14,teks umum,,0,0,0,,Kepingan besar
Dialog: 0,0:06:06.56,0:06:08.27,teks umum,,0,0,0,,Besar...
Dialog: 0,0:06:08.36,0:06:09.65,teks umum,,0,0,0,,Tidak sama
Dialog: 0,0:06:09.73,0:06:11.44,teks umum,,0,0,0,,Ini juga kecil
Dialog: 0,0:06:13.19,0:06:14.15,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:06:14.82,0:06:18.16,teks umum,,0,0,0,,Kepingan besar. Macam ni
Dialog: 0,0:06:19.32,0:06:22.29,teks umum,,0,0,0,,Saya sepatutnya menerangkannya dengan betul
Dialog: 0,0:06:22.37,0:06:25.29,teks umum,,0,0,0,,Bagaimanakah saya sepatutnya memahami "kepingan besar" anda?
Dialog: 0,0:06:25.37,0:06:27.71,teks umum,,0,0,0,,Saya fikir awak adalah ahli silap mata terbaik Jeonjingak
Dialog: 0,0:06:27.79,0:06:31.25,teks umum,,0,0,0,,Tidak dapat membezakan besar dari kecil?
Dialog: 0,0:06:32.46,0:06:33.38,miring,,0,0,0,,Lupakan
Dialog: 0,0:06:33.46,0:06:35.88,teks umum,,0,0,0,,Tuang air dalam mangkuk
Dialog: 0,0:06:43.72,0:06:44.68,teks umum,,0,0,0,,Tunggu...
Dialog: 0,0:06:45.48,0:06:47.44,teks umum,,0,0,0,,Mangkuk yang manakah yang anda maksudkan?
Dialog: 0,0:06:49.48,0:06:50.48,teks umum,,0,0,0,,Yang ini?
Dialog: 0,0:06:54.03,0:06:55.07,teks umum,,0,0,0,,Atau ini?
Dialog: 0,0:06:55.82,0:06:56.70,teks umum,,0,0,0,,Ini?
Dialog: 0,0:06:59.45,0:07:00.74,teks umum,,0,0,0,,Di sini
Dialog: 0,0:07:06.91,0:07:09.83,teks umum,,0,0,0,,Kenapa nampaknya Moo Deok sedang memarahinya?
Dialog: 0,0:07:10.63,0:07:12.09,teks umum,,0,0,0,,Adakah anda pasti dia suka dia?
Dialog: 0,0:07:12.17,0:07:13.63,teks umum,,0,0,0,,Inilah jenis perempuan
Dialog: 0,0:07:14.13,0:07:17.84,teks umum,,0,0,0,,Dia tidak menunjukkan kasih sayang atau rasa malu di hadapan orang lain
Dialog: 0,0:07:21.14,0:07:24.31,teks umum,,0,0,0,,Lihat sahaja Yulia
Dialog: 0,0:07:25.10,0:07:27.81,teks umum,,0,0,0,,Mereka memarahinya, tetapi dia masih belajar
Dialog: 0,0:07:30.60,0:07:32.31,teks umum,,0,0,0,,- Belajar?\N- Tengok
Dialog: 0,0:07:33.02,0:07:34.82,teks umum,,0,0,0,,Saya kata cukuplah
Dialog: 0,0:07:36.19,0:07:37.65,teks umum,,0,0,0,,Saya tidak suka makanan masin
Dialog: 0,0:07:41.28,0:07:42.66,contact,,0,0,0,,Dia tidak pernah begitu
Dialog: 0,0:07:42.74,0:07:45.66,teks umum,,0,0,0,,- Cuba sendiri\N- {\i1}Walaupun di hadapan Master Ho atau bapa saudara saya
Dialog: 0,0:07:45.74,0:07:46.95,teks umum,,0,0,0,,Lucu
Dialog: 0,0:07:47.54,0:07:50.46,italic,,0,0,0,,Dia macam pelajar yang takut, kan?
Dialog: 0,0:07:50.54,0:07:51.92,italic,,0,0,0,,Hambar, huh?
Dialog: 0,0:07:52.00,0:07:55.75,teks umum,,0,0,0,,Di sini. Saya sepatutnya berhenti apabila saya berkata
Dialog: 0,0:07:55.84,0:07:59.26,teks umum,,0,0,0,,- Saya minta maaf\N- {\i1}Tuan yang dihormati dan pelajarnya yang taat
Dialog: 0,0:08:00.38,0:08:02.68,teks umum,,0,0,0,,Tinggalkan. Perlu selesai memasak
Dialog: 0,0:08:02.76,0:08:04.89,teks umum,,0,0,0,,- Guru dan murid?\N{\i1}- Duduk
Dialog: 0,0:08:04.97,0:08:07.27,teks umum,,0,0,0,,Kenapa awak degil sangat,
Dialog: 0,0:08:07.35,0:08:09.48,teks umum,,0,0,0,,jika anda memasak buat kali pertama?
Dialog: 0,0:08:16.65,0:08:17.61,teks umum,,0,0,0,,Okey
Dialog: 0,0:08:17.69,0:08:21.32,teks umum,,0,0,0,,Mari kita lihat bagaimana anda mengajarnya, dan bagaimana anda belajar
Dialog: 0,0:08:21.86,0:08:23.41,teks umum,,0,0,0,,Jom cuba
Dialog: 0,0:08:28.79,0:08:30.08,teks umum,,0,0,0,,Sedap
Dialog: 0,0:08:30.16,0:08:31.46,teks umum,,0,0,0,,Sedap?
Dialog: 0,0:08:33.88,0:08:36.09,teks umum,,0,0,0,,Saya melakukan segala-galanya seperti yang dikatakan oleh Moo Deok
Dialog: 0,0:08:39.13,0:08:40.26,teks umum,,0,0,0,,Syabas
Dialog: 0,0:08:41.34,0:08:44.14,teks umum,,0,0,0,,Gembira, saya rasa, selepas pujian guru
Dialog: 0,0:08:44.72,0:08:48.01,teks umum,,0,0,0,,Saya fikir saya pandai dalam segala-galanya kerana orang memanggil saya genius
Dialog: 0,0:08:48.81,0:08:50.98,teks umum,,0,0,0,,Tetapi ternyata ada sesuatu yang saya tidak boleh lakukan
Dialog: 0,0:08:51.06,0:08:52.02,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,0:08:52.10,0:08:53.73,teks umum,,0,0,0,,terima kasih kerana membantu saya menyedari perkara ini
Dialog: 0,0:08:53.81,0:08:57.98,teks umum,,0,0,0,,Ia tidak mudah kerana dia tidak faham apa yang saya katakan
Dialog: 0,0:08:58.07,0:09:00.74,teks umum,,0,0,0,,Tetapi dia masih terus mencuba
Dialog: 0,0:09:01.40,0:09:03.07,teks umum,,0,0,0,,Jadi saya terus mengajarnya
Dialog: 0,0:09:04.61,0:09:05.99,teks umum,,0,0,0,,Melebih-lebihkan
Dialog: 0,0:09:06.62,0:09:08.91,teks umum,,0,0,0,,Seolah-olah meja diraja telah ditetapkan di sini
Dialog: 0,0:09:08.99,0:09:11.79,teks umum,,0,0,0,,Anda boleh belajar banyak semasa memasak
Dialog: 0,0:09:11.87,0:09:13.46,teks umum,,0,0,0,,- Anda harus belajar juga\N- Malangnya,
Dialog: 0,0:09:13.54,0:09:16.25,teks umum,,0,0,0,,Saya tidak mempunyai guru seperti dia
Dialog: 0,0:09:18.17,0:09:20.17,teks umum,,0,0,0,,Maaf, tapi nasinya hangus sedikit
Dialog: 0,0:09:20.26,0:09:22.92,teks umum,,0,0,0,,- Ya\N{\i1}- Anda boleh cuba lagi
Dialog: 0,0:09:23.01,0:09:26.47,teks umum,,0,0,0,,Moo Dok, adakah anda fikir dia akan melakukan yang lebih baik pada masa akan datang?
Dialog: 0,0:09:26.55,0:09:29.10,teks umum,,0,0,0,,Dia tidak sepenuhnya putus asa
Dialog: 0,0:09:29.18,0:09:30.85,italic,,0,0,0,,Terima kasih atas kata-kata itu
Dialog: 0,0:09:45.82,0:09:47.24,teks am,,0,0,0,,Kenapa awak basuh sendiri?
Dialog: 0,0:09:47.32,0:09:49.45,teks umum,,0,0,0,,Minta pelajar hebat anda untuk membantu
Dialog: 0,0:09:49.53,0:09:53.25,teks umum,,0,0,0,,Dia memasak makanan, jadi saya akan membersihkan semuanya
Dialog: 0,0:09:54.62,0:09:56.17,teks umum,,0,0,0,,Adakah menyenangkan untuk mengajarnya?
Dialog: 0,0:09:56.83,0:09:58.04,teks umum,,0,0,0,,Adakah anda mahu dia
Dialog: 0,0:09:58.71,0:09:59.79,teks umum,,0,0,0,,adakah pelajar anda?
Dialog: 0,0:09:59.88,0:10:01.88,teks umum,,0,0,0,,Lebih mudah jika begini
Dialog: 0,0:10:02.46,0:10:04.55,teks umum,,0,0,0,,Dia rajin, taat
Dialog: 0,0:10:05.34,0:10:07.51,teks umum,,0,0,0,,Tidak malas dan melulu seperti anda
Dialog: 0,0:10:07.59,0:10:10.10,teks umum,,0,0,0,,Cikgu, jangan tipu saya
Dialog: 0,0:10:11.68,0:10:12.52,teks umum,,0,0,0,,Apa?
Dialog: 0,0:10:12.60,0:10:14.89,teks umum,,0,0,0,,Saya faham anda suka ketekunan dan ketabahannya
Dialog: 0,0:10:14.98,0:10:17.31,teks umum,,0,0,0,,Tetapi saya satu-satunya pelajar anda
Dialog: 0,0:10:17.40,0:10:20.86,teks umum,,0,0,0,,Seorang guru tidak sepatutnya mempunyai beberapa pelajar dan sebaliknya
Dialog: 0,0:10:20.94,0:10:24.15,teks umum,,0,0,0,,Marah sebab ajar Yulia masak?
Dialog: 0,0:10:24.24,0:10:26.15,teks umum,,0,0,0,,Ya. Tepat sekali. Bagaimana anda boleh mengajar orang lain
Dialog: 0,0:10:26.24,0:10:28.28,teks umum,,0,0,0,,apabila pelajar anda berada betul-betul di hadapan anda?
Dialog: 0,0:10:28.87,0:10:31.03,contact,,0,0,0,,Adakah anda mahu mengajar seseorang cara memasak? Biarlah saya
Dialog: 0,0:10:31.12,0:10:32.74,teks umum,,0,0,0,,Mengajar orang lain adalah pengkhianatan dan pengkhianatan
Dialog: 0,0:10:33.87,0:10:36.54,teks umum,,0,0,0,,Saya faham bahagian tentang pengkhianatan
Dialog: 0,0:10:36.62,0:10:37.83,teks umum,,0,0,0,,Tetapi pengkhianatan?
Dialog: 0,0:10:37.92,0:10:39.38,teks umum,,0,0,0,,Tiada perkataan
Dialog: 0,0:10:42.42,0:10:43.55,teks umum,,0,0,0,,Saya pasti,
Dialog: 0,0:10:44.51,0:10:46.47,teks umum,,0,0,0,,bahawa saya rasa dikhianati
Dialog: 0,0:10:53.81,0:10:55.02,teks umum,,0,0,0,,Apa lagi ini?
Dialog: 0,0:10:56.06,0:10:56.98,teks umum,,0,0,0,,Nah, apa lagi?
Dialog: 0,0:10:57.06,0:10:58.81,teks umum,,0,0,0,,Moo Dok, jangan tipu saya
Dialog: 0,0:10:58.90,0:11:00.31,teks umum,,0,0,0,,Ini menyakitkan dan membuat saya marah
Dialog: 0,0:11:00.40,0:11:03.19,teks umum,,0,0,0,,Saya tidak tahu bahawa pelajar saya begitu taksub
Dialog: 0,0:11:03.90,0:11:05.78,teks umum,,0,0,0,,Baiklah, anda akan menjadi seorang sahaja
Dialog: 0,0:11:05.86,0:11:08.95,teks umum,,0,0,0,,seorang pelajar yang berkata karut pada waktu pagi. Adakah anda berpuas hati?
Dialog: 0,0:11:09.03,0:11:10.66,teks umum,,0,0,0,,- Tapi...\N{\i1}- Mu Dok!
Dialog: 0,0:11:11.70,0:11:12.66,miring,,0,0,0,,Moo Dok!
Dialog: 0,0:11:14.29,0:11:15.16,teks umum,,0,0,0,,Hos,
Dialog: 0,0:11:15.91,0:11:19.58,teks umum,,0,0,0,,adalah pengkhianatan jika saya memanggil orang lain tuan
Dialog: 0,0:11:20.21,0:11:21.54,teks umum,,0,0,0,,dan jawab panggilan mereka?
Dialog: 0,0:11:21.63,0:11:23.38,teks umum,,0,0,0,,Tiada apa yang boleh dilakukan di sini, sudah tentu
Dialog: 0,0:11:23.46,0:11:25.96,teks umum,,0,0,0,,Tetapi apabila anda menghubungi mereka,
Dialog: 0,0:11:26.05,0:11:28.47,teks umum,,0,0,0,,panggil saya tuan
Dialog: 0,0:11:30.26,0:11:31.59,teks umum,,0,0,0,,Ketawa dan tidak lebih
Dialog: 0,0:11:33.97,0:11:37.60,teks umum,,0,0,0,,Tuan Pak, saya datang!
Dialog: 0,0:11:37.68,0:11:40.73,teks umum,,0,0,0,,Moo Dok, awak sakitkan perasaan saya. Saya suruh awak panggil saya tuan!
Dialog: 0,0:11:49.40,0:11:51.16,teks umum,,0,0,0,,Sangat tinggi
Dialog: 0,0:11:53.16,0:11:55.62,teks umum,,0,0,0,,Yul, awak nak tengok pokok ni?
Dialog: 0,0:11:56.95,0:11:58.20,teks umum,,0,0,0,,Semacam
Dialog: 0,0:11:59.62,0:12:01.67,teks umum,,0,0,0,,Saya tidak percaya ia wujud
Dialog: 0,0:12:09.76,0:12:12.76,kenangan,,0,0,0,,Bagaimana awak tahu saya terluka?
Dialog: 0,0:12:13.47,0:12:16.26,kenangan,,0,0,0,,Ada pokok tinggi berhampiran,
Dialog: 0,0:12:18.02,0:12:21.39,kenangan,,0,0,0,,semua Danhyangok kelihatan dari atas
Dialog: 0,0:12:26.86,0:12:29.78,teks umum,,0,0,0,,Keseluruhan Danhyangok kelihatan dari atas
Dialog: 0,0:12:33.32,0:12:35.24,teks umum,,0,0,0,,Jadi awak naik
Dialog: 0,0:12:36.41,0:12:37.66,teks umum,,0,0,0,,ke bahagian paling atas?
Dialog: 0,0:12:41.66,0:12:44.63,teks umum,,0,0,0,,Saya andaikan begitu, kerana ia tinggi
Dialog: 0,0:12:46.50,0:12:48.67,teks umum,,0,0,0,,Adakah anda mahu naik?
Dialog: 0,0:12:48.76,0:12:50.42,teks umum,,0,0,0,,Bantu anda mendaki?
Dialog: 0,0:12:51.09,0:12:53.72,teks umum,,0,0,0,,Dan Gu, kamu tidak boleh memanjatnya
Dialog: 0,0:12:53.80,0:12:57.14,teks umum,,0,0,0,,Anda perlu sekurang-kurangnya menguasai Chisa untuk mendaki ke sana
Dialog: 0,0:12:58.39,0:12:59.39,teks umum,,0,0,0,,Ya?
Dialog: 0,0:13:00.02,0:13:01.52,teks umum,,0,0,0,,Mungkin saya patut mencuba?
Dialog: 0,0:13:02.10,0:13:03.10,miring,,0,0,0,,Tepat
Dialog: 0,0:13:03.19,0:13:05.10,teks umum,,0,0,0,,Mungkin anda boleh melakukannya
Dialog: 0,0:13:05.69,0:13:06.98,teks umum,,0,0,0,,Moo Dok, jom ikut dia
Dialog: 0,0:13:10.69,0:13:11.78,teks umum,,0,0,0,,Adakah anda mahu mendaki?
Dialog: 0,0:13:17.08,0:13:18.37,teks umum,,0,0,0,,Saya tidak mahu
Dialog: 0,0:13:18.45,0:13:21.58,teks umum,,0,0,0,,Saya tidak mahu memanjat pokok ini dengan sesiapa sahaja
Dialog: 0,0:13:26.50,0:13:27.34,teks umum,,0,0,0, "Dengan sesiapa sahaja"?
Dialog: 0,0:13:30.51,0:13:33.72,teks umum,,0,0,0,,Saya rasa dia terlalu takut
Dialog: 0,0:13:33.80,0:13:35.13,teks umum,,0,0,0,,Jom
Dialog: 0,0:13:46.52,0:13:48.52,teks umum,,0,0,0,,Saya mengkaji inti tenaganya
Dialog: 0,0:13:49.77,0:13:52.57,teks umum,,0,0,0,,Dia orang biasa, bukan ahli silap mata
Dialog: 0,0:13:53.57,0:13:56.74,teks umum,,0,0,0,,Saya pasti ada ramai lagi mangsa
Dialog: 0,0:13:56.82,0:14:00.20,teks umum,,0,0,0,,Terdapat seorang nomad di kalangan kita
Dialog: 0,0:14:00.79,0:14:02.70,teks umum,,0,0,0,,Apa yang perlu dilakukan, Cikgu Li?
Dialog: 0,0:14:02.79,0:14:05.62,teks umum,,0,0,0,,Lebih sukar untuk mengenali asal usul sihir ini,
Dialog: 0,0:14:05.71,0:14:07.21,teks umum,,0,0,0,,cara menangkap nomad
Dialog: 0,0:14:08.04,0:14:09.59,teks umum,,0,0,0,,Saya syak Jeonbugwan
Dialog: 0,0:14:11.42,0:14:14.42,teks umum,,0,0,0,,Nomad ini yang menyerang Sosnovy Bor,
Dialog: 0,0:14:15.34,0:14:17.30,teks umum,,0,0,0,,ada ahli nujum di sana
Dialog: 0,0:14:18.26,0:14:21.06,teks umum,,0,0,0,,Selain itu, ia adalah Jin Mu
Dialog: 0,0:14:21.14,0:14:23.02,teks umum,,0,0,0,,memusnahkan Nak Su semasa pemindahan jiwa,
Dialog: 0,0:14:23.81,0:14:25.73,teks umum,,0,0,0,,dan kemudian semua orangnya
Dialog: 0,0:14:27.19,0:14:28.90,teks umum,,0,0,0,,Nak Su...
Dialog: 0,0:14:35.86,0:14:38.62,teks umum,,0,0,0,,Kami mengetahui siapa dia
Dialog: 0,0:14:38.70,0:14:39.82,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:14:39.91,0:14:42.29,teks umum,,0,0,0,,Salah seorang hamba Jeonbugwan
Dialog: 0,0:14:42.37,0:14:45.83,teks umum,,0,0,0,,Apa? Jeonbugwan terlibat lagi
Dialog: 0,0:14:45.91,0:14:48.58,teks umum,,0,0,0,,Saya akan pergi berjumpa Jin Mu segera!
Dialog: 0,0:14:48.67,0:14:50.25,teks umum,,0,0,0,,Semua orang di belakang saya
Dialog: 0,0:14:50.34,0:14:51.54,teks umum,,0,0,0,,Yom
Dialog: 0,0:14:52.21,0:14:53.17,teks umum,,0,0,0,,Ya?
Dialog: 0,0:14:53.84,0:14:54.96,teks umum,,0,0,0,,Buat apa-apa
Dialog: 0,0:14:56.84,0:14:59.97,teks umum,,0,0,0,,Pada satu masa, kecerobohan anda merosakkan banyak
Dialog: 0,0:15:00.05,0:15:02.14,teks umum,,0,0,0,,Sekarang anda telah dewasa, tetapi watak anda masih sama
Dialog: 0,0:15:03.06,0:15:04.72,teks umum,,0,0,0,,Maaf, cikgu
Dialog: 0,0:15:05.31,0:15:06.43,teks umum,,0,0,0,,Belum masanya
Dialog: 0,0:15:06.52,0:15:10.48,teks umum,,0,0,0,,Kita perlu mengawasi Jeonbugwan dengan teliti
Dialog: 0,0:15:10.56,0:15:11.86,teks umum,,0,0,0,,Jin
Dialog: 0,0:15:12.86,0:15:14.40,teks umum,,0,0,0,,Anda membesar dengan bijak
Dialog: 0,0:15:15.69,0:15:17.82,teks umum,,0,0,0,,Anda berlari-lari dengan seluar dalam
Dialog: 0,0:15:17.90,0:15:21.16,teks umum,,0,0,0,,Saya tidak percaya anda membesar seperti itu dan memimpin orang
Dialog: 0,0:15:25.95,0:15:27.04,teks umum,,0,0,0,,Guru
Dialog: 0,0:15:33.29,0:15:34.92,teks umum,,0,0,0,,Siapa dia?
Dialog: 0,0:15:36.38,0:15:37.59,teks umum,,0,0,0,,Dia seorang pelajar
Dialog: 0,0:15:38.13,0:15:41.55,teks umum,,0,0,0,,Master So Kyung, pengasas Sosnovy Bor
Dialog: 0,0:15:42.60,0:15:44.06,teks umum,,0,0,0,,Tetapi dia masih muda
Dialog: 0,0:15:45.18,0:15:46.52,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,0:15:47.39,0:15:49.10,teks umum,,0,0,0,,Saya masih ingat menyanyi
Dialog: 0,0:15:51.35,0:15:53.19,teks umum,,0,0,0,,pada sambutan ulang tahunnya
Dialog: 0,0:15:56.86,0:15:58.32,teks umum,,0,0,0,,Saya pun menari
Dialog: 0,0:16:02.07,0:16:04.95,teks umum,,0,0,0,,Anjing ini... adakah Gwigu?
Dialog: 0,0:16:07.16,0:16:11.62,teks umum,,0,0,0,,Jadi awak ambil Gwiga daripada Jinyeowon
Dialog: 0,0:16:12.63,0:16:14.96,teks umum,,0,0,0,,Dia akan menemui seorang nomad
Dialog: 0,0:16:15.75,0:16:18.21,teks umum,,0,0,0,,Nak Su meninggal semasa pemindahan jiwa, bukan?
Dialog: 0,0:16:18.30,0:16:19.13,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:19.22,0:16:22.68,teks umum,,0,0,0,,Dia seorang askar upahan terkenal dan ahli silap mata yang berbakat
Dialog: 0,0:16:25.05,0:16:27.60,teks umum,,0,0,0,,Bukankah jiwanya yang saya rasakan?
Dialog: 0,0:16:39.99,0:16:42.45,teks umum,,0,0,0,,Pedang Chang Gan sekarang
Dialog: 0,0:16:42.53,0:16:44.70,teks umum,,0,0,0,,- anak dia, kan?\N- Ya
Dialog: 0,0:16:44.78,0:16:48.62,teks umum,,0,0,0,,Awak pernah jumpa dia?
Dialog: 0,0:16:48.70,0:16:50.58,teks umum,,0,0,0,,Saya melihat seorang lelaki muda dengan gelang
Dialog: 0,0:16:50.66,0:16:53.83,teks umum,,0,0,0,,dan pembantu rumah yang mengikutinya
Dialog: 0,0:16:55.59,0:16:56.88,teks umum,,0,0,0,,Menarik
Dialog: 0,0:17:03.97,0:17:06.51,teks umum,,0,0,0,,Moo Dok mengumpul beberapa buah berangan
Dialog: 0,0:17:06.60,0:17:09.22,teks umum,,0,0,0,,Mereka manis, ya. Berikan Kim pembantu rumah itu juga
Dialog: 0,0:17:09.31,0:17:10.18,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:17:19.19,0:17:20.74,teks umum,,0,0,0,,Mengapa kamu mengambil pedang ayah kamu?
Dialog: 0,0:17:21.36,0:17:23.61,teks umum,,0,0,0,,Oh, ini? Moo Deok mengambilnya
Dialog: 0,0:17:23.70,0:17:26.78,teks umum,,0,0,0,,Anda tidak akan berlatih, mengapa anda membawanya ke sini?
Dialog: 0,0:17:27.53,0:17:28.91,teks umum,,0,0,0,, Bawa kepada pembantu rumah Kim?
Dialog: 0,0:17:30.83,0:17:31.70,kenangan condong,,0,0,0,,Anda...
Dialog: 0,0:17:32.75,0:17:34.04,kenangan,,0,0,0,,bukan anak lelaki
Dialog: 0,0:17:35.33,0:17:36.54,kenangan,,0,0,0,,Chan Gan
Dialog: 0,0:17:40.05,0:17:41.17,teks umum,,0,0,0,,Seperti yang anda mahu
Dialog: 0,0:17:45.38,0:17:46.55,teks umum,,0,0,0,,- Jom\N- Ya
Dialog: 0,0:17:49.26,0:17:51.89,teks am,,0,0,0,,Kamu berkata bahawa kamu sering mengumpul herba di sini
Dialog: 0,0:17:53.23,0:17:57.10,teks umum,,0,0,0,,Pernahkah anda melihat sesiapa yang tinggal di sini?
Dialog: 0,0:17:57.19,0:18:00.19,teks umum,,0,0,0,,No. Siapa yang akan tinggal di sini?
Dialog: 0,0:18:01.57,0:18:02.82,teks umum,,0,0,0,,Faham
Dialog: 0,0:18:07.53,0:18:08.74,teks umum,,0,0,0,,Dan banyak lagi
Dialog: 0,0:18:10.79,0:18:12.91,teks umum,,0,0,0,,Adakah ia sangat sejuk pada musim sejuk?
Dialog: 0,0:18:14.37,0:18:15.79,teks umum,,0,0,0,,Apa?
Dialog: 0,0:18:17.92,0:18:19.67,teks umum,,0,0,0,,Saya tidak pernah ke sini pada musim sejuk
Dialog: 0,0:18:22.67,0:18:24.67,teks umum,,0,0,0,,Bimbang setiap kali salji turun
Dialog: 0,0:18:26.47,0:18:28.26,teks umum,,0,0,0,,Bimbang sama ada ia terlalu sejuk
Dialog: 0,0:18:29.85,0:18:32.10,teks umum,,0,0,0,,Adakah semuanya baik-baik saja
Dialog: 0,0:18:42.40,0:18:44.11,teks umum,,0,0,0,,Ia menjadi lebih panas di sini,
Dialog: 0,0:18:45.19,0:18:47.20,teks umum,,0,0,0,,daripada yang kelihatan
Dialog: 0,0:18:50.28,0:18:53.29,teks umum,,0,0,0,,Salji cair dengan cepat di tempat yang cerah
Dialog: 0,0:18:56.21,0:18:58.17,teks umum,,0,0,0,,Ya? Saya gembira
Dialog: 0,0:19:04.30,0:19:06.72,teks umum,,0,0,0,,Ya, terdapat banyak makanan di sini walaupun pada musim sejuk
Dialog: 0,0:19:07.68,0:19:10.34,teks umum,,0,0,0,,Ada tempat untuk bersembunyi daripada salji
Dialog: 0,0:19:13.22,0:19:15.60,teks umum,,0,0,0,,- Saya pasti ia sedap\N- Sangat
Dialog: 0,0:19:18.56,0:19:19.98,teks umum,,0,0,0,, Patutkah kita tinggal sehari lagi?
Dialog: 0,0:19:21.40,0:19:23.90,contact,,0,0,0,,Rupa-rupanya Moo Deok sangat menyukainya
Dialog: 0,0:19:28.45,0:19:30.20,teks umum,,0,0,0,,Dia memberitahunya
Dialog: 0,0:19:31.32,0:19:32.66,teks umum,,0,0,0,,tidak suka
Dialog: 0,0:19:32.74,0:19:35.24,teks umum,,0,0,0,,Saya katakan anda suka!
Dialog: 0,0:19:35.95,0:19:36.87,teks umum,,0,0,0,,Lihat
Dialog: 0,0:19:36.95,0:19:41.04,teks umum,,0,0,0,,Dia tidak memandang kita seperti dia memandangnya
Dialog: 0,0:19:49.51,0:19:51.18,teks umum,,0,0,0,,Angin bertiup
Dialog: 0,0:19:59.85,0:20:01.56,teks umum,,0,0,0,,Adakah ia datang daripada dia?
Dialog: 0,0:20:05.32,0:20:06.28,teks umum,,0,0,0,,Dan Gu, mari pergi
Dialog: 0,0:20:06.90,0:20:07.99,teks umum,,0,0,0,,Ya
Dialog: 0,0:20:12.28,0:20:14.03,contact,,0,0,0,,Bye, Moo Deok
Dialog: 0,0:20:19.50,0:20:20.54,miring,,0,0,0,,Jom
Dialog: 0,0:20:27.92,0:20:29.47,teks umum,,0,0,0,,Saya akan tunjukkan mereka
Dialog: 0,0:20:42.23,0:20:44.40,teks umum,,0,0,0,,- Selamat melancong\N- Jumpa lagi
Dialog: 0,0:20:45.31,0:20:47.53,teks umum,,0,0,0,,Cuba ingat di mana anda kehilangan azimat semangat
Dialog: 0,0:20:48.11,0:20:50.19,teks umum,,0,0,0,,- Okay\N- Dan tundukkan kepala anda
Dialog: 0,0:20:50.70,0:20:52.86,teks umum,,0,0,0,,Disebabkan kamu, malah Majlis Bersatu diadakan
Dialog: 0,0:20:52.95,0:20:55.87,teks umum,,0,0,0,,Saya rasa kesemua 12 bekas guru saya ada di sana
Dialog: 0,0:20:55.95,0:20:58.79,teks umum,,0,0,0,,Mereka semua sangat tidak berhati perut terhadap anda
Dialog: 0,0:20:59.45,0:21:02.33,teks umum,,0,0,0,,Mereka juga menawarkan untuk menutup semua tenaga anda
Dialog: 0,0:21:03.08,0:21:05.33,teks umum,,0,0,0,,- Mengapa mereka berkata begitu?\N- Apa?
Dialog: 0,0:21:07.84,0:21:09.59,teks umum,,0,0,0,,Sebab awak lari dari pergaduhan
Dialog: 0,0:21:11.26,0:21:13.05,contact,,0,0,0,,Tetapi ini hanya bodoh
Dialog: 0,0:21:13.13,0:21:14.97,teks umum,,0,0,0,,Anda juga tidak mahu ia berlaku
Dialog: 0,0:21:15.05,0:21:17.26,contact,,0,0,0,,Tiada siapa menjangka anda muncul
Dialog: 0,0:21:17.35,0:21:21.02,teks umum,,0,0,0,,Jadi tinggal di sini dan hidup dengan tenang
Dialog: 0,0:21:23.39,0:21:25.10,miring,,0,0,0,,Kepala ingin tahu sesuatu
Dialog: 0,0:21:26.65,0:21:28.73,teks umum,,0,0,0,,Dia bertanya sama ada anda melakukan apa yang disuruh
Dialog: 0,0:21:30.99,0:21:31.99,kenangan condong,,0,0,0,,Anda
Dialog: 0,0:21:32.49,0:21:35.53,kenangan,,0,0,0,,buah pengkhianatan ibumu
Dialog: 0,0:21:35.61,0:21:38.16,kenangan,,0,0,0,,Tetapi kami tidak boleh membiarkan anda menjadi ketua Jeonbugwan
Dialog: 0,0:21:38.24,0:21:41.41,kenangan,,0,0,0,,Jadi berhentilah bermimpi untuk mengikuti jejak langkah
Dialog: 0,0:21:44.54,0:21:45.75,kenangan,,0,0,0,,kepada bapanya
Dialog: 0,0:21:46.33,0:21:48.38,kenangan,,0,0,0,,Kekal pewaris yang tidak tahu
Dialog: 0,0:21:49.75,0:21:52.47,kenangan,,0,0,0,,Keluarga Chan
Dialog: 0,0:21:55.84,0:21:58.18,teks umum,,0,0,0,,Bolehkah saya memberinya jawapan yang positif?
Dialog: 0,0:21:58.26,0:22:00.18,teks umum,,0,0,0,,Pernahkah saya taat?
Dialog: 0,0:22:00.81,0:22:03.68,teks umum,,0,0,0,,Beritahu dia saya melakukan sebaliknya, bersikap melulu
Dialog: 0,0:22:06.94,0:22:08.11,teks umum,,0,0,0,,Dan Gu, tinggalkan pedang di sini
Dialog: 0,0:22:09.11,0:22:10.02,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:22:10.90,0:22:13.19,teks umum,,0,0,0,,Saya ingin membantu Mu Deok menangkap burung
Dialog: 0,0:22:17.62,0:22:18.82,teks umum,,0,0,0,,Bye
Dialog: 0,0:22:24.29,0:22:26.87,teks umum,,0,0,0,,Adakah kita menyakiti harga dirinya?
Dialog: 0,0:22:26.96,0:22:27.83,miring,,0,0,0,,Tinggalkan dia
Dialog: 0,0:22:27.92,0:22:30.42,teks umum,,0,0,0,,Kita tidak boleh meminta dia kembali dan mati dengan bermaruah di sana
Dialog: 0,0:22:38.39,0:22:40.72,teks umum,,0,0,0,,Adakah kamu kembali dengan pedang yang kamu berikan?
Dialog: 0,0:22:43.27,0:22:45.27,teks umum,,0,0,0,,Saya telah menjadi bahan ketawa dan ia menyakitkan kebanggaan saya
Dialog: 0,0:22:47.39,0:22:50.15,teks umum,,0,0,0,,Kalau begitu, mari kita berlatih seolah-olah hidup kita bergantung kepadanya
Dialog: 0,0:22:51.48,0:22:52.61,teks umum,,0,0,0,,Nampaknya anda terhibur dengan,
Dialog: 0,0:22:54.32,0:22:56.11,teks umum,,0,0,0,,bahawa pelajar anda telah menjadi bahan ketawa
Dialog: 0,0:22:56.90,0:22:59.32,teks umum,,0,0,0,,Selain itu, saya akan menambah
Dialog: 0,0:23:00.57,0:23:03.87,teks umum,,0,0,0,,Rakan anda tidak meminta anda pulang bersama mereka
Dialog: 0,0:23:03.95,0:23:06.71,teks umum,,0,0,0,,Jika mereka kamu, mereka akan bertarung sampai mati
Dialog: 0,0:23:06.79,0:23:09.71,teks umum,,0,0,0,,Dan anda diberitahu untuk lari dan bersembunyi
Dialog: 0,0:23:10.79,0:23:11.92,teks umum,,0,0,0,,Tahukah anda kenapa?
Dialog: 0,0:23:14.38,0:23:16.97,teks umum,,0,0,0,,Kerana kamu tidak berguna
Dialog: 0,0:23:18.88,0:23:20.85,teks umum,,0,0,0,,Lidahmu lebih tajam daripada pedang
Dialog: 0,0:23:21.72,0:23:24.72,teks umum,,0,0,0,,Jadi kata-kata menyakitkan. Dengan kejam
Dialog: 0,0:23:24.81,0:23:27.06,teks umum,,0,0,0,,Saya tidak akan teragak-agak untuk menikam kamu dengan pedang,
Dialog: 0,0:23:27.14,0:23:29.14,teks umum,,0,0,0,,jika itu akan membawa anda kembali ke landasan yang betul
Dialog: 0,0:23:29.23,0:23:30.27,teks umum,,0,0,0,,Ya, tuan
Dialog: 0,0:23:30.35,0:23:32.61,teks umum,,0,0,0,,Pukul pelajar anda yang tidak berguna sehingga mati
Dialog: 0,0:23:35.32,0:23:37.36,teks umum,,0,0,0,,Mengapa awak tidak berpuas hati selepas kata-kata saya?
Dialog: 0,0:23:37.44,0:23:38.74,teks umum,,0,0,0,,Kenapa rosak sangat?
Dialog: 0,0:23:41.24,0:23:43.45,teks umum,,0,0,0,,Kata-kata jahat awak membuat saya kecewa akhirnya
Dialog: 0,0:23:44.20,0:23:45.66,teks umum,,0,0,0,,Saya perlu mandi dan berehat
Dialog: 0,0:23:47.45,0:23:49.42,teks umum,,0,0,0,,Kenapa dia kerap mandi?
Dialog: 0,0:23:49.50,0:23:51.00,teks umum,,0,0,0,,Bodoh yang tidak berguna dan malas
Dialog: 0,0:23:51.08,0:23:52.42,teks umum,,0,0,0,,Saya harap anda mendidih dalam air mendidih!
Dialog: 0,0:23:53.79,0:23:57.26,teks umum,,0,0,0,,Luar biasa! Apakah jenis guru yang berkata demikian kepada anak muridnya?
Dialog: 0,0:24:02.47,0:24:06.64,teks umum,,0,0,0,,Uk tidak ingat bagaimana dia kehilangan azimat rohnya?
Dialog: 0,0:24:07.60,0:24:09.73,teks umum,,0,0,0,,Mungkin seseorang menjualnya selepas Uk menjatuhkannya
Dialog: 0,0:24:09.81,0:24:12.06,teks umum,,0,0,0,,Jadi azimat itu sampai kepada mereka
Dialog: 0,0:24:12.15,0:24:14.11,teks umum,,0,0,0,,Saya dengar ada tempat di mana mereka menjual azimat sebegitu
Dialog: 0,0:24:15.32,0:24:18.11,teks umum,,0,0,0,,Kalau begitu, cuba cari segala-galanya
Dialog: 0,0:24:19.28,0:24:20.57,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:24:20.65,0:24:21.91,teks umum,,0,0,0,,Bagaimana...
Dialog: 0,0:24:24.03,0:24:26.33,teks umum,,0,0,0,,adakah Uka lakukan?
Dialog: 0,0:24:28.95,0:24:31.50,teks umum,,0,0,0,,Semuanya baik-baik saja dengannya, dia diberi makan dan sihat
Dialog: 0,0:24:32.58,0:24:34.71,teks umum,,0,0,0,,Dia masih belum melepaskan gelang itu
Dialog: 0,0:24:37.05,0:24:38.13,teks umum,,0,0,0,,Anda boleh pergi
Dialog: 0,0:24:59.40,0:25:00.86,teks umum,,0,0,0,,Ia tidak begitu berat lagi
Dialog: 0,0:25:00.95,0:25:02.49,teks umum,,0,0,0,,Dan ia tidak mengganggu berjalan
Dialog: 0,0:25:02.57,0:25:05.16,teks umum,,0,0,0,,Sesetengah ahli silap mata berlatih dengan pemberat besi,
Dialog: 0,0:25:05.24,0:25:07.28,teks umum,,0,0,0,,untuk menguatkan tangan anda dan menggunakan pedang dengan lebih baik
Dialog: 0,0:25:07.79,0:25:10.96,contact,,0,0,0,,Anda secara tidak sedar menjadi lebih kuat,
Dialog: 0,0:25:11.04,0:25:13.25,teks umum,,0,0,0,,semasa memakai gelang berat ini sepanjang hari
Dialog: 0,0:25:13.33,0:25:14.75,teks umum,,0,0,0,,Tidak disengajakan,
Dialog: 0,0:25:14.83,0:25:17.13,teks umum,,0,0,0,,tetapi anda menemui alat latihan yang hebat untuk diri anda sendiri
Dialog: 0,0:25:18.42,0:25:19.96,teks umum,,0,0,0,,Anda amat bertuah
Dialog: 0,0:25:20.05,0:25:23.43,teks umum,,0,0,0,,Jika saya menanggalkannya, saya akan menjadi lebih pantas dan lebih kuat
Dialog: 0,0:25:24.01,0:25:27.47,teks umum,,0,0,0,,Tetapi jika anda tidak belajar mengawal diri anda, anda akan menjadi lebih menyedihkan
Dialog: 0,0:25:29.22,0:25:30.27,teks umum,,0,0,0,,Saya...
Dialog: 0,0:25:30.93,0:25:31.93,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:25:35.85,0:25:38.94,teks umum,,0,0,0,,Apa yang awak dan Yul bincangkan?
Dialog: 0,0:25:41.36,0:25:42.86,teks umum,,0,0,0,,Tentang Danhyangok
Dialog: 0,0:25:44.86,0:25:47.87,teks umum,,0,0,0,,Dia bertanya bagaimana keadaan di sini pada musim sejuk
Dialog: 0,0:25:52.04,0:25:53.91,contact,,0,0,0,,Awak jumpa Naxu,
Dialog: 0,0:25:54.67,0:25:56.33,teks umum,,0,0,0,,semasa anda muda?
Dialog: 0,0:25:58.29,0:26:01.34,teks umum,,0,0,0,,Saya tidak pasti bila saya melihat mayatnya
Dialog: 0,0:26:01.42,0:26:03.97,teks umum,,0,0,0,,Tetapi perjalanan ke Danhyangk membantu saya mengesahkan perkara ini
Dialog: 0,0:26:04.05,0:26:05.13,teks umum,,0,0,0,,Jadi saya hanya mengatakan ini sekarang
Dialog: 0,0:26:06.22,0:26:10.01,teks umum,,0,0,0,,Danhyangok - lembah yang dalam dan berbahaya
Dialog: 0,0:26:10.10,0:26:12.77,teks umum,,0,0,0,,Gadis kecil itu tidak dapat bertahan di sana tanpa bantuan seseorang
Dialog: 0,0:26:12.85,0:26:15.56,teks umum,,0,0,0,,Dia tinggal di sana, seolah-olah bersembunyi daripada seseorang
Dialog: 0,0:26:16.98,0:26:19.36,contact,,0,0,0,,Apabila dia mengetahui siapa saya dan dari keluarga mana saya,
Dialog: 0,0:26:20.11,0:26:22.03,miring,,0,0,0,,Saya tidak pernah melihatnya lagi
Dialog: 0,0:26:23.24,0:26:25.70,italic,,0,0,0,,Jadi saya tahu nama awak...
Dialog: 0,0:26:26.49,0:26:29.58,teks umum,,0,0,0,,Beritahu semua yang anda tahu tentang dia
Dialog: 0,0:26:32.37,0:26:33.75,teks umum,,0,0,0,,Saya tidak tahu apa-apa
Dialog: 0,0:26:34.37,0:26:36.12,teks umum,,0,0,0,,Tiada nama, tiada umur
Dialog: 0,0:26:36.79,0:26:38.67,teks umum,,0,0,0,,Kecuali tebing tempat kami melihat burung...
Dialog: 0,0:26:38.75,0:26:40.42,teks umum,,0,0,0,,Saya tidak pernah melihat di mana dia tinggal
Dialog: 0,0:26:44.55,0:26:45.51,teks umum,,0,0,0,,Hanya satu
Dialog: 0,0:26:48.43,0:26:50.35,teks umum,,0,0,0,,Sekali dia menyebut bapanya
Dialog: 0,0:27:01.40,0:27:05.15,kenangan,,0,0,0,,Ayah saya menggambarkan bintang
Dialog: 0,0:27:07.07,0:27:09.49,contact,,0,0,0,,Kemudian saya tidak mempedulikannya
Dialog: 0,0:27:09.57,0:27:12.20,teks umum,,0,0,0,,Tetapi inilah yang dilakukan oleh pengamat bintang
Dialog: 0,0:27:12.28,0:27:13.87,teks umum,,0,0,0,,dari Jeonbugwan
Dialog: 0,0:27:15.25,0:27:16.37,contact,,0,0,0,,Guru,
Dialog: 0,0:27:16.87,0:27:18.92,teks umum,,0,0,0,,di kalangan ahli silap mata bintang
Dialog: 0,0:27:20.00,0:27:21.92,teks umum,,0,0,0,,adakah seseorang marah dengan anda?
Dialog: 0,0:27:24.92,0:27:26.22,teks umum,,0,0,0,,Stargazer
Dialog: 0,0:27:27.55,0:27:28.88,teks umum,,0,0,0,,dari Jeonbugwan?
Dialog: 0,0:27:30.89,0:27:31.97,teks umum,,0,0,0,, Mage?
Dialog: 0,0:27:36.81,0:27:40.48,huruf miring,,0,0,0,,Dua puluh tahun dahulu ada seorang ahli nujum meninggal dunia...
Dialog: 0,0:27:41.11,0:27:43.82,italic,,0,0,0,,di tangan empat keluarga
Dialog: 0,0:27:45.69,0:27:48.99,teks umum,,0,0,0,,Seluruh keluarganya terbunuh pada hari itu
Dialog: 0,0:27:49.66,0:27:51.07,teks umum,,0,0,0,,Kecuali seorang
Dialog: 0,0:27:51.16,0:27:53.95,teks umum,,0,0,0,,Anak perempuannya tidak ditemui malam itu
Dialog: 0,0:28:20.35,0:28:22.23,contact,,0,0,0,,Ternyata keluarga kami yang bersalah
Dialog: 0,0:28:23.19,0:28:25.11,teks umum,,0,0,0,,dalam kematian bapanya
Dialog: 0,0:28:25.69,0:28:27.40,teks umum,,0,0,0,,Dia pasti berdendam dengan awak,
Dialog: 0,0:28:27.48,0:28:29.82,teks umum,,0,0,0,,sejak keluarga anda mengambil bahagian dalam ini
Dialog: 0,0:28:29.90,0:28:32.82,teks umum,,0,0,0,,Adakah anda ingat apa-apa lagi?
Dialog: 0,0:28:33.41,0:28:35.08,teks umum,,0,0,0,,Sudah lama dahulu
Dialog: 0,0:28:36.12,0:28:37.83,teks umum,,0,0,0,,Tidak mungkin saya dapat mengingati apa-apa lagi
Dialog: 0,0:29:00.81,0:29:02.52,kenangan miring,,0,0,0,,Sebab saya ingin melihatnya
Dialog: 0,0:29:03.81,0:29:06.02,kenangan miring,,0,0,0,,Kaki yang patah tidak mengganggu saya
Dialog: 0,0:29:06.11,0:29:07.90,kenangan miring,,0,0,0,,Dan saya tidak takut mereka akan memarahi saya
Dialog: 0,0:29:12.32,0:29:14.16,kenangan,,0,0,0,,Saya sangat menyayangi mereka
Dialog: 0,0:29:23.37,0:29:27.50,kenangan miring,,0,0,0,,Saya melihat anda menggunakan ini untuk memanggil burung anda
Dialog: 0,0:29:29.42,0:29:30.67,kenangan,,0,0,0,,saya nak cuba juga
Dialog: 0,0:29:31.67,0:29:33.59,kenangan,,0,0,0,,Bolehkah saya memilikinya?
Dialog: 0,0:30:29.48,0:30:31.11,di sebalik tabir,,0,0,0,,Putera Mahkota kuat
Dialog: 0,0:30:31.73,0:30:36.15,suara,,0,0,0,,Hanya ada satu cara untuk Uka mengalahkannya dan terus hidup
Dialog: 0,0:30:37.07,0:30:38.45,teks umum,,0,0,0,,Tansu
Dialog: 0,0:31:12.48,0:31:14.23,teks umum,,0,0,0,,Apa yang anda mahu daripada saya?
Dialog: 0,0:31:15.94,0:31:17.86,teks umum,,0,0,0,,Potong titisan air semasa ia jatuh
Dialog: 0,0:31:19.28,0:31:20.57,teks umum,,0,0,0,,Bukan titisan hujan
Dialog: 0,0:31:20.66,0:31:23.04,teks umum,,0,0,0,,Malah seseorang yang tidak bernasib baik seperti anda
Dialog: 0,0:31:23.12,0:31:25.58,teks umum,,0,0,0,,akan dapat memotong titisan yang menitis dengan begitu perlahan
Dialog: 0,0:31:26.25,0:31:27.12,teks umum,,0,0,0,,Ke hadapan
Dialog: 0,0:31:48.44,0:31:50.31,teks umum,,0,0,0,,Hanya tiga titik dalam sekali duduk
Dialog: 0,0:31:51.19,0:31:52.36,contact,,0,0,0,,Tidak mengapa
Dialog: 0,0:31:52.44,0:31:55.98,teks umum,,0,0,0,,Tarian yang akan anda pelajari memerlukan anda memotong hanya satu
Dialog: 0,0:31:56.07,0:31:57.19,teks umum,,0,0,0,,Tansu?
Dialog: 0,0:31:58.74,0:31:59.91,teks umum,,0,0,0,,Guru...
Dialog: 0,0:32:00.41,0:32:03.91,teks umum,,0,0,0,,Saya faham, saya seorang yang agak cepat belajar,
Dialog: 0,0:32:03.99,0:32:05.33,teks umum,,0,0,0,,tetapi Tansu... tidak terlalu banyak?
Dialog: 0,0:32:05.41,0:32:08.00,teks umum,,0,0,0,,Nampaknya guru anda mengajar anda sesuatu
Dialog: 0,0:32:08.08,0:32:09.08,teks umum,,0,0,0,,Betul
Dialog: 0,0:32:09.16,0:32:11.96,teks umum,,0,0,0,,Anda boleh belajar Tansu hanya selepas menguasai Chisu
Dialog: 0,0:32:12.63,0:32:14.59,teks umum,,0,0,0,,Anda hampir tidak menguasai Ryusu
Dialog: 0,0:32:14.67,0:32:17.30,teks umum,,0,0,0,,Anda masih tidak mengawal tenaga anda
Dialog: 0,0:32:17.38,0:32:19.22,teks umum,,0,0,0,,Seorang pelajar tahap anda tidak boleh mempelajari ini
Dialog: 0,0:32:20.55,0:32:21.68,teks umum,,0,0,0,,Tetapi?
Dialog: 0,0:32:22.30,0:32:23.64,teks umum,,0,0,0,,Tetapi hanya dengan cara ini
Dialog: 0,0:32:25.31,0:32:29.60,teks umum,,0,0,0,,anda akan mengalahkan putera mahkota dan terus hidup
Dialog: 0,0:33:04.09,0:33:07.18,di sebalik tabir,,0,0,0,,Tansu ialah pergerakan tenaga dengan pedang
Dialog: 0,0:33:07.26,0:33:09.06,suara,,0,0,0,,Tangan kanan awak lemah,
Dialog: 0,0:33:09.77,0:33:12.35,di sebalik tabir,,0,0,0,,tetapi dikuatkan terima kasih kepada gelang
Dialog: 0,0:33:13.48,0:33:14.35,di sebalik tabir,,0,0,0,,Hanya satu titisan
Dialog: 0,0:33:15.44,0:33:18.44,di belakang tabir,,0,0,0,,Tekan satu titis supaya anda boleh mengumpul dan mengarahkan tenaga
Dialog: 0,0:33:30.79,0:33:32.54,teks umum,,0,0,0,,Anda tidak akan dapat menguasai Tansu secepat itu
Dialog: 0,0:33:33.21,0:33:34.67,teks umum,,0,0,0,,Jom makan dan teruskan
Dialog: 0,0:34:22.84,0:34:24.01,teks umum,,0,0,0,,Tansu?
Dialog: 0,0:34:24.80,0:34:26.59,teks umum,,0,0,0,,Ya, dia tidak akan pernah dapat menguasainya
Dialog: 0,0:34:29.30,0:34:32.14,miring,,0,0,0,,Ini bukan pembantu rumah dan tuannya
Dialog: 0,0:34:32.85,0:34:34.89,teks umum,,0,0,0,,Cepat cikgu dan pelajar
Dialog: 0,0:36:14.16,0:36:15.33,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:36:17.41,0:36:19.58,contact,,0,0,0,,Jadi awak latih dia
Dialog: 0,0:36:22.63,0:36:24.50,teks umum,,0,0,0,,Saya nampak dia berlatih Tansu
Dialog: 0,0:36:25.38,0:36:26.59,teks umum,,0,0,0,,Di manakah anda belajar ini?
Dialog: 0,0:36:27.17,0:36:31.18,teks umum,,0,0,0,,Pemiliknya bijak, dia mempunyai 12 orang guru
Dialog: 0,0:36:31.26,0:36:33.30,teks umum,,0,0,0,,Dia cuba berlari tanpa benar-benar belajar berjalan
Dialog: 0,0:36:33.39,0:36:35.51,teks umum,,0,0,0,,Perjalanannya masih panjang
Dialog: 0,0:36:35.60,0:36:37.85,teks umum,,0,0,0,,Sekurang-kurangnya patut dicuba
Dialog: 0,0:36:38.43,0:36:41.14,teks umum,,0,0,0,,Langkah seterusnya boleh menyebabkan kematiannya
Dialog: 0,0:36:45.15,0:36:47.36,teks umum,,0,0,0,,Adakah tuan kamu tahu tentang perkara ini?
Dialog: 0,0:37:22.73,0:37:24.73,teks umum,,0,0,0,,Mengapa anda tidak mengelak?
Dialog: 0,0:37:24.81,0:37:25.90,teks umum,,0,0,0,,Serius
Dialog: 0,0:37:41.75,0:37:44.00,teks umum,,0,0,0,,Ini adalah hasil daripada anda melepaskan tenaga ke luar
Dialog: 0,0:37:45.17,0:37:47.21,teks umum,,0,0,0,,Tangan anda mungkin pecah jika anda meneruskan
Dialog: 0,0:37:53.38,0:37:56.72,teks umum,,0,0,0,,Dia akan mula reput. Kemudian anda perlu memotongnya
Dialog: 0,0:37:57.39,0:37:58.51,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:38:02.68,0:38:05.77,teks umum,,0,0,0,,Jika tenaga reput merebak ke seluruh badan anda,
Dialog: 0,0:38:06.40,0:38:07.65,teks umum,,0,0,0,,anda akan mati
Dialog: 0,0:38:27.38,0:38:29.63,teks umum,,0,0,0,,Haba telah reda. Adakah awak okey
Dialog: 0,0:38:29.71,0:38:31.34,teks umum,,0,0,0,,Tidur. Tidur adalah ubat terbaik
Dialog: 0,0:38:32.13,0:38:33.13,teks umum,,0,0,0,,Pembohong
Dialog: 0,0:38:35.30,0:38:37.09,teks umum,,0,0,0,,Betul ke apa yang dia cakap?
Dialog: 0,0:38:37.64,0:38:39.47,contact,,0,0,0,,Tidak kira saya mati akibat racun,
Dialog: 0,0:38:39.55,0:38:42.35,teks umum,,0,0,0,,sebat, pukul dengan pedang atau tangan anda pecah
Dialog: 0,0:38:43.06,0:38:46.44,teks umum,,0,0,0,,Guru saya tidak mempedulikan pelajarnya
Dialog: 0,0:38:48.02,0:38:49.44,teks umum,,0,0,0,,Betul
Dialog: 0,0:38:50.36,0:38:54.36,teks umum,,0,0,0,,Ini kerana anda sangat bertuah dan bertuah
Dialog: 0,0:38:55.11,0:38:57.45,teks umum,,0,0,0,,Adakah berbohong nama tengah anda?
Dialog: 0,0:39:00.62,0:39:02.70,teks umum,,0,0,0,,Saya hanya tidak mahu menakutkan anda
Dialog: 0,0:39:03.29,0:39:06.46,teks umum,,0,0,0,,Faham. Terima kasih cikgu yang tiada belas kasihan
Dialog: 0,0:39:06.54,0:39:09.13,teks umum,,0,0,0,,Tetapi jauhkan diri apabila saya memegang pedang lagi
Dialog: 0,0:39:09.21,0:39:10.79,teks umum,,0,0,0,,Saya hampir menikam awak hari ini
Dialog: 0,0:39:10.88,0:39:14.26,teks umum,,0,0,0,,Saya berdiri kerana saya mahu anda mengawal tenaga sendiri
Dialog: 0,0:39:14.88,0:39:16.17,teks umum,,0,0,0,,Saya tidak bermaksud mengganggu
Dialog: 0,0:39:16.26,0:39:19.01,teks umum,,0,0,0,,Anda tidak campur tangan. Saya cuma risaukan awak
Dialog: 0,0:39:25.64,0:39:27.69,teks umum,,0,0,0,,Anggap saya sebagai ibu burung yang bimbang...
Dialog: 0,0:39:27.77,0:39:29.81,teks umum,,0,0,0,,bahawa telurnya akan pecah. Bolehkah anda bayangkan?
Dialog: 0,0:39:29.90,0:39:32.44,teks umum,,0,0,0,,Tidak mengapa. Ini tidak akan membahayakan saya
Dialog: 0,0:39:32.52,0:39:33.65,teks umum,,0,0,0,,Saya boleh mengelak
Dialog: 0,0:39:34.40,0:39:35.61,teks umum,,0,0,0,,Tidakkah berbahaya?
Dialog: 0,0:39:35.69,0:39:37.90,teks umum,,0,0,0,,Bagaimana anda boleh mengelak jika saya begitu pantas?
Dialog: 0,0:39:37.99,0:39:39.66,teks umum,,0,0,0,,Tidak begitu pantas
Dialog: 0,0:39:40.32,0:39:41.70,teks umum,,0,0,0,,Penjahat...
Dialog: 0,0:39:43.54,0:39:45.12,teks umum,,0,0,0,,Cepat, kan? Jangan mengelak
Dialog: 0,0:39:45.20,0:39:46.70,teks umum,,0,0,0,,Anda menyerang tanpa amaran!
Dialog: 0,0:39:46.79,0:39:48.54,teks umum,,0,0,0,,Ya? Kemudian ini dia
Dialog: 0,0:39:48.62,0:39:49.71,teks umum,,0,0,0,,Mu Dok, mata
Dialog: 0,0:39:52.34,0:39:53.38,teks umum,,0,0,0,,Bajingan
Dialog: 0,0:39:53.46,0:39:55.46,teks umum,,0,0,0,,Anda membelinya semula, saya tidak percaya
Dialog: 0,0:40:00.43,0:40:01.68,teks umum,,0,0,0,,Ayo lagi
Dialog: 0,0:40:02.72,0:40:04.18,teks umum,,0,0,0,,Dari jarak ini?
Dialog: 0,0:40:04.26,0:40:05.85,teks umum,,0,0,0,,- Serius?\N- Ayuh
Dialog: 0,0:40:10.56,0:40:11.69,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:40:12.94,0:40:15.11,teks umum,,0,0,0,,tanda biru kelihatan di mata
Dialog: 0,0:40:15.98,0:40:17.32,teks umum,,0,0,0,,Dan ia sangat cantik
Dialog: 0,0:40:21.20,0:40:24.78,teks umum,,0,0,0,,Dan lebih baik kamu jangan memprovokasi saya dengan berada begitu dekat
Dialog: 0,0:40:25.45,0:40:26.74,teks umum,,0,0,0,,Fikirkan saya boleh
Dialog: 0,0:40:26.83,0:40:28.25,teks umum,,0,0,0,,dari jarak ini
Dialog: 0,0:40:32.50,0:40:34.50,teks umum,,0,0,0,,Saya rasa anda memahami kata-kata saya dengan betul
Dialog: 0,0:40:35.38,0:40:37.51,teks umum,,0,0,0,,Mungkin ada sesuatu yang boleh saya ajar kepada anda
Dialog: 0,0:40:41.97,0:40:43.14,teks umum,,0,0,0,,Chang Wook
Dialog: 0,0:40:46.39,0:40:50.10,teks umum,,0,0,0,,Adakah anda fikir saya naif jika saya tinggal di sini seorang diri?
Dialog: 0,0:40:51.52,0:40:52.81,teks umum,,0,0,0,,Nah, ya
Dialog: 0,0:40:54.77,0:40:57.78,teks umum,,0,0,0,,Saya mahu anda tahu bahawa saya boleh mengajar anda banyak perkara
Dialog: 0,0:40:58.99,0:41:00.11,teks umum,,0,0,0,,Sebagai contoh?
Dialog: 0,0:41:07.24,0:41:08.54,teks umum,,0,0,0,,Hei! awak...
Dialog: 0,0:41:08.62,0:41:10.79,teks umum,,0,0,0,,Serangan yang benar-benar berkesan adalah
Dialog: 0,0:41:10.87,0:41:14.00,teks umum,,0,0,0,,apabila musuh tidak mengharapkannya sama sekali
Dialog: 0,0:41:14.54,0:41:16.38,teks umum,,0,0,0,,Ingat ini wahai muridku
Dialog: 0,0:41:17.59,0:41:21.05,teks umum,,0,0,0,,Saya hampir tidak menyentuh kamu, dan kamu memberikan segalanya!
Dialog: 0,0:41:21.13,0:41:22.76,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:41:24.43,0:41:26.76,teks umum,,0,0,0,,Hei, Moo Deok
Dialog: 0,0:41:36.98,0:41:38.78,miring,,0,0,0,,Gunting baharu?
Dialog: 0,0:41:39.61,0:41:42.70,teks umum,,0,0,0,,Sekarang dia tidak mengikut formaliti
Dialog: 0,0:41:43.32,0:41:45.57,italic,,0,0,0,,Dia daripada keluarga kecil ahli silap mata di timur
Dialog: 0,0:41:45.66,0:41:48.91,italic,,0,0,0,,Pada hari lahirnya, sebuah komet melepasi Big Dipper
Dialog: 0,0:41:48.99,0:41:52.71,teks umum,,0,0,0,,Jadi dia akan mengumpulkan semua wanita yang dilahirkan pada malam yang luar biasa
Dialog: 0,0:41:52.79,0:41:55.42,miring,,0,0,0,,Dia mahu menangkap bintang Raja
Dialog: 0,0:42:06.43,0:42:08.35,teks umum,,0,0,0,,Apabila mendiang raja menaiki takhta,
Dialog: 0,0:42:08.43,0:42:12.64,teks umum,,0,0,0,,diramalkan yang seterusnya akan lahir di bawah bintang Raja
Dialog: 0,0:42:13.77,0:42:16.52,teks umum,,0,0,0,,Penduduk Deho gembira
Dialog: 0,0:42:16.60,0:42:17.48,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:42:17.56,0:42:20.69,teks umum,,0,0,0,,takhta telah diambil oleh bapa kamu, dilahirkan pada malam biasa
Dialog: 0,0:42:20.78,0:42:22.57,teks umum,,0,0,0,,Jika tidak, seperti anda
Dialog: 0,0:42:23.36,0:42:24.90,teks umum,,0,0,0,,Jadi perbualan bermula
Dialog: 0,0:42:25.78,0:42:27.62,teks umum,,0,0,0,,Ramalan tidak betul
Dialog: 0,0:42:27.70,0:42:31.41,teks umum,,0,0,0,,Geng Gwangju Chang melarikan diri selepas membuat ramalan kelakar
Dialog: 0,0:42:31.49,0:42:33.54,teks umum,,0,0,0,,Ayah kamu percaya kepadanya
Dialog: 0,0:42:34.12,0:42:35.87,teks umum,,0,0,0,,Jadi anda takut
Dialog: 0,0:42:38.33,0:42:39.79,teks umum,,0,0,0,,Saya tidak takut
Dialog: 0,0:42:39.88,0:42:42.67,teks umum,,0,0,0,,Anda takut seseorang yang mempunyai tenaga sedemikian akan muncul,
Dialog: 0,0:42:42.76,0:42:44.92,teks umum,,0,0,0,, atau bapa kamu akan mempunyai seorang anak lelaki
Dialog: 0,0:42:45.80,0:42:47.64,italic,,0,0,0,,Saya tahu itu
Dialog: 0,0:42:51.06,0:42:53.81,teks umum,,0,0,0,,Pergaduhan anda dengan Chan Wook hampir tiba
Dialog: 0,0:42:53.89,0:42:57.23,teks umum,,0,0,0,,Hancurkan anak orang yang membuat ramalan ini
Dialog: 0,0:42:58.86,0:43:01.65,teks umum,,0,0,0,,Singkirkan ketakutan anda sekarang kerana anda mempunyai peluang
Dialog: 0,0:43:04.28,0:43:05.45,teks umum,,0,0,0,,Adakah anda fikir,
Dialog: 0,0:43:06.32,0:43:07.78,teks umum,,0,0,0,, adakah ia akan muncul?
Dialog: 0,0:43:08.78,0:43:09.87,teks umum,,0,0,0,,Saya dengar dia berlari
Dialog: 0,0:43:10.78,0:43:14.25,teks umum,,0,0,0,,Ada khabar angin mengatakan dia sudah bersedia untuk berkahwin, cuma bukan untuk bergaduh.
Dialog: 0,0:43:15.41,0:43:16.71,teks umum,,0,0,0,,Perkahwinan?
Dialog: 0,0:43:16.79,0:43:20.71,teks umum,,0,0,0,,Saya dengar dia akan menyertai keluarga Jin untuk menggunakan azimat keluarga mereka
Dialog: 0,0:43:27.13,0:43:29.14,teks umum,,0,0,0,,Adakah Wook dan Jo Young akan berkahwin?
Dialog: 0,0:43:29.93,0:43:31.76,teks umum,,0,0,0,,Mereka memutuskan pertunangan mereka sekali
Dialog: 0,0:43:32.68,0:43:34.64,teks umum,,0,0,0,,Jadi lebih mudah untuk membuat persiapan untuk majlis perkahwinan
Dialog: 0,0:43:35.43,0:43:38.64,teks umum,,0,0,0,,Dia masih ada hadiah perkahwinan
Dialog: 0,0:43:38.73,0:43:40.90,teks umum,,0,0,0,,dari kali terakhir
Dialog: 0,0:43:43.94,0:43:45.03,teks umum,,0,0,0,,Faham
Dialog: 0,0:43:45.53,0:43:48.40,contact,,0,0,0,,Selepas perkahwinan Chan Wook...
Dialog: 0,0:43:48.49,0:43:51.45,teks umum,,0,0,0,,Iaitu, suami saya akan berpindah ke sini
Dialog: 0,0:43:51.95,0:43:54.45,teks umum,,0,0,0,,Tetapi bilik saya terlalu kecil untuk kami berdua
Dialog: 0,0:43:54.54,0:43:59.00,teks umum,,0,0,0,,Bolehkah kita menggunakan bilik besar di sayap timur?
Dialog: 0,0:43:59.58,0:44:02.34,teks umum,,0,0,0,,Ini bilik kakak awak
Dialog: 0,0:44:03.84,0:44:06.38,teks umum,,0,0,0,,Ini bilik terbaik kami
Dialog: 0,0:44:06.46,0:44:09.51,teks umum,,0,0,0,,Sayang sekali untuk membiarkannya kosong selama bertahun-tahun
Dialog: 0,0:44:10.51,0:44:11.97,teks umum,,0,0,0,,Ia bukan kosong
Dialog: 0,0:44:12.68,0:44:14.39,teks umum,,0,0,0,,Boo Young akan kembali
Dialog: 0,0:44:15.81,0:44:17.56,teks umum,,0,0,0,,Maaf, ibu
Dialog: 0,0:44:20.31,0:44:22.19,teks umum,,0,0,0,,Ayah kamu sedang mencari dia
Dialog: 0,0:44:23.36,0:44:26.44,teks umum,,0,0,0,,Kakak kamu akan pulang tidak lama lagi
Dialog: 0,0:44:28.86,0:44:31.24,teks umum,,0,0,0,,Bawa saya jed Yin-and-Yang dari Jinyeowon
Dialog: 0,0:44:33.66,0:44:34.95,teks umum,,0,0,0,,Yin-and-Yang?
Dialog: 0,0:44:35.03,0:44:36.41,teks umum,,0,0,0,,Anda mahukan dia
Dialog: 0,0:44:37.95,0:44:41.00,teks umum,,0,0,0,,Mereka mengatakan bahawa jika pasangan memakai cincin yang diperbuat daripada jed itu,
Dialog: 0,0:44:41.08,0:44:42.79,teks umum,,0,0,0,,cinta hanya akan bertambah kuat
Dialog: 0,0:44:44.92,0:44:47.92,teks umum,,0,0,0,,Biar mereka membuat cincin daripadanya
Dialog: 0,0:44:49.34,0:44:51.09,teks umum,,0,0,0,,Terima kasih, ibu
Dialog: 0,0:45:14.62,0:45:16.99,teks umum,,0,0,0,,Gur yang menjengkelkan. Adakah itu awak?
Dialog: 0,0:45:17.49,0:45:19.04,teks umum,,0,0,0,,Memarahkan
Dialog: 0,0:45:26.00,0:45:27.25,teks umum,,0,0,0,,Saya rasa awak marah,
Dialog: 0,0:45:27.34,0:45:29.42,teks umum,,0,0,0,,bahawa saya akan berkahwin
Dialog: 0,0:45:29.51,0:45:30.55,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:45:30.63,0:45:32.22,teks umum,,0,0,0,,Anda akan lebih marah,
Dialog: 0,0:45:32.30,0:45:34.05,teks umum,,0,0,0,,apabila saya memakai cincin jed ini
Dialog: 0,0:45:46.36,0:45:47.94,teks umum,,0,0,0,,Makan
Dialog: 0,0:45:48.94,0:45:50.23,teks umum,,0,0,0,,Jadi
Dialog: 0,0:45:52.61,0:45:55.11,teks umum,,0,0,0,,saya bawa burung pegar
Dialog: 0,0:45:55.20,0:45:57.16,teks umum,,0,0,0,,Mengapa hanya ada kehijauan di sini?
Dialog: 0,0:45:57.24,0:45:58.66,teks umum,,0,0,0,,Dia ada...
Dialog: 0,0:45:59.33,0:46:00.24,teks umum,,0,0,0,,Dia ada dalam sup
Dialog: 0,0:46:00.33,0:46:02.08,teks umum,,0,0,0,,Pegar itu sangat kecil
Dialog: 0,0:46:02.16,0:46:03.92,teks umum,,0,0,0,,Hanya sedikit yang tinggal semasa saya menyediakan kuahnya
Dialog: 0,0:46:14.84,0:46:16.93,teks umum,,0,0,0,,Rasanya sangat lemah
Dialog: 0,0:46:21.93,0:46:24.73,teks umum,,0,0,0,,Saya mendengar sesuatu semasa menjual herba di Sosnovy Bor
Dialog: 0,0:46:24.81,0:46:27.19,teks umum,,0,0,0,,Dua keluarga bangsawan berkahwin dengan anak mereka
Dialog: 0,0:46:27.77,0:46:29.69,teks umum,,0,0,0,,Dan siapa ini?
Dialog: 0,0:46:29.77,0:46:32.69,teks umum,,0,0,0,,Anak perempuan Puan Jin akan berkahwin
Dialog: 0,0:46:33.40,0:46:36.45,teks umum,,0,0,0,,Adakah Young mendapati dirinya seorang pengantin lelaki? Siapa dia?
Dialog: 0,0:46:36.53,0:46:38.66,teks umum,,0,0,0,,Anak kepada Gwangju Jeonbugwan
Dialog: 0,0:46:40.95,0:46:42.33,teks umum,,0,0,0,,Bukankah itu anda?
Dialog: 0,0:46:53.26,0:46:56.47,teks umum,,0,0,0,,Saya tidak mengatakan bahawa saya akan berkahwin. Apa yang berlaku?
Dialog: 0,0:46:56.55,0:46:58.22,teks umum,,0,0,0,,Apa yang pembantu Kim buat di sana?
Dialog: 0,0:46:58.30,0:47:01.06,teks umum,,0,0,0,,Perkahwinan tergesa-gesa berlaku kerana kemunculan seorang kanak-kanak
Dialog: 0,0:47:01.14,0:47:02.18,teks umum,,0,0,0,,Tidak
Dialog: 0,0:47:02.77,0:47:04.35,teks umum,,0,0,0,,Anda sudah pun bertunang
Dialog: 0,0:47:05.02,0:47:06.60,teks umum,,0,0,0,,Mungkin anda tidak dapat menahan diri
Dialog: 0,0:47:06.69,0:47:09.90,teks umum,,0,0,0,,Kami tidak pernah begitu rapat, bagaimana dia boleh hamil?
Dialog: 0,0:47:10.73,0:47:12.86,teks umum,,0,0,0,,Ya, awak pandai bercakap
Dialog: 0,0:47:12.94,0:47:14.11,teks umum,,0,0,0,,Apa?
Dialog: 0,0:47:14.19,0:47:16.07,teks umum,,0,0,0,,Lalu kenapa kamu enggan minum teh suci?
Dialog: 0,0:47:16.15,0:47:17.15,teks umum,,0,0,0,,Ini kerana...
Dialog: 0,0:47:19.57,0:47:21.24,teks umum,,0,0,0,,bahawa anda perlu berkahwin
Dialog: 0,0:47:23.08,0:47:24.83,teks umum,,0,0,0,,Jadi, saya mahu berkahwin
Dialog: 0,0:47:26.12,0:47:27.67,teks umum,,0,0,0,,Ya, saya ingin
Dialog: 0,0:47:27.75,0:47:28.87,teks umum,,0,0,0,,Saya sangat mahu
Dialog: 0,0:47:29.63,0:47:32.17,teks umum,,0,0,0,,Saya pasti akan berkahwin
Dialog: 0,0:47:32.25,0:47:33.50,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:47:48.73,0:47:50.44,italic,,0,0,0,,Kenapa awak nak jumpa saya?
Dialog: 0,0:47:51.23,0:47:54.65,teks am,,0,0,0,,Bilakah kabinet ibu mutiara yang saya tempah daripada Sosnovy Bor akan tiba?
Dialog: 0,0:47:55.28,0:47:56.53,teks umum,,0,0,0,,Dia untuk Uk dan saya
Dialog: 0,0:47:56.61,0:48:00.61,teks umum,,0,0,0,,Barang dari selatan akan sampai dalam sehari dalam seminggu
Dialog: 0,0:48:01.37,0:48:02.66,teks umum,,0,0,0,,Sudah lewat
Dialog: 0,0:48:03.66,0:48:05.12,teks umum,,0,0,0,,Sepatutnya dipesan lebih awal
Dialog: 0,0:48:05.20,0:48:07.08,teks umum,,0,0,0,,Lupakan tentang almari
Dialog: 0,0:48:07.62,0:48:09.54,teks umum,,0,0,0,,Saya patut beritahu Uku
Dialog: 0,0:48:10.88,0:48:12.21,teks umum,,0,0,0,,Dia tidak tahu
Dialog: 0,0:48:14.30,0:48:16.92,teks umum,,0,0,0,,Jadi saya menulis surat kepadanya
Dialog: 0,0:48:17.72,0:48:19.18,teks umum,,0,0,0,,Baca dan kongsi fikiran anda
Dialog: 0,0:48:20.89,0:48:22.01,teks umum,,0,0,0,,Okey
Dialog: 0,0:48:25.72,0:48:26.85,teks umum,,0,0,0,,Baunya
Dialog: 0,0:48:26.93,0:48:29.23,teks umum,,0,0,0,,Inilah kemenyan yang membawa cinta
Dialog: 0,0:48:30.14,0:48:31.60,teks umum,,0,0,0,,Harta Karun Jinyeowon
Dialog: 0,0:48:33.36,0:48:35.98,teks umum,,0,0,0,,Baunya sangat harum
Dialog: 0,0:48:57.80,0:48:59.55,teks umum,,0,0,0,,Kenapa awak menghidunya?
Dialog: 0,0:48:59.63,0:49:00.59,teks umum,,0,0,0,,Hentikan!
Dialog: 0,0:49:01.72,0:49:03.64,teks umum,,0,0,0,,Dan tutup hidung anda!
Dialog: 0,0:49:15.98,0:49:17.82,teks umum,,0,0,0,,Saya hampir membazirkan segala-galanya
Dialog: 0,0:49:21.03,0:49:22.74,teks umum,,0,0,0,,Berikan surat kepada Uku
Dialog: 0,0:49:23.32,0:49:26.53,teks umum,,0,0,0,,Dan pastikan tiada wanita berdekatan apabila dia membuka
Dialog: 0,0:49:29.33,0:49:30.16,teks umum,,0,0,0,,Okay
Dialog: 0,0:49:35.50,0:49:36.63,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:49:36.71,0:49:41.38,teks umum,,0,0,0,,Anda dan Uk mempunyai tangan yang sama, bukan?
Dialog: 0,0:49:43.38,0:49:44.59,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:45.39,0:49:47.89,teks umum,,0,0,0,,Ikut saya beli cincin kahwin
Dialog: 0,0:49:47.97,0:49:49.31,teks umum,,0,0,0,,Hidupkan saya
Dialog: 0,0:49:50.06,0:49:52.52,teks umum,,0,0,0,,Mengapa saya perlu pergi ke sana bersama awak?
Dialog: 0,0:49:52.60,0:49:53.77,teks umum,,0,0,0,,Pergi dengan tunang awak
Dialog: 0,0:49:54.81,0:49:58.94,teks umum,,0,0,0,,Perkahwinan mesti diakhiri dengan persetujuan bersama
Dialog: 0,0:49:59.57,0:50:02.32,teks umum,,0,0,0,,Sedihnya anda berkelakuan begini
Dialog: 0,0:50:03.61,0:50:04.45,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:50:06.03,0:50:07.99,teks umum,,0,0,0,,Adakah anda fikir saya tergesa-gesa?
Dialog: 0,0:50:08.70,0:50:10.74,teks umum,,0,0,0,,Atau dia akan menolak lagi?
Dialog: 0,0:50:15.71,0:50:18.42,teks umum,,0,0,0,,Adakah anda tergesa-gesa atau tidak,
Dialog: 0,0:50:19.96,0:50:21.38,teks umum,,0,0,0,,Saya akan membantu
Dialog: 0,0:50:22.21,0:50:23.38,teks umum,,0,0,0,,Seandainya ia berkesan
Dialog: 0,0:50:28.43,0:50:30.18,teks umum,,0,0,0,,Dan saya akan membantu anda juga
Dialog: 0,0:50:39.36,0:50:40.94,italic,,0,0,0,,Jika anda fikirkan,
Dialog: 0,0:50:41.03,0:50:43.65,teks umum,,0,0,0,,pembantu rumah Kim menentang saya tinggal bersama keluarga isteri saya,
Dialog: 0,0:50:43.74,0:50:45.82,teks umum,,0,0,0,,bila kali terakhir kami membincangkan perkahwinan dengan Cho Young
Dialog: 0,0:50:47.20,0:50:50.49,teks umum,,0,0,0,,Hanya satu sebab mengapa mereka mula bercakap tentang perkahwinan semula
Dialog: 0,0:50:50.99,0:50:52.20,teks umum,,0,0,0,,Pertahanan saya
Dialog: 0,0:50:52.79,0:50:55.04,teks umum,,0,0,0,,Dia membuat perjanjian dengan keluarga Jin,
Dialog: 0,0:50:55.12,0:50:57.46,teks umum,,0,0,0,,untuk membantu anda mengelakkan pergaduhan
Dialog: 0,0:50:57.54,0:50:59.54,teks umum,,0,0,0,,Dia mungkin memerlukan pengaruh Puan Jin
Dialog: 0,0:51:01.00,0:51:02.63,teks umum,,0,0,0,,Dalam kes ini,
Dialog: 0,0:51:03.67,0:51:05.09,teks umum,,0,0,0,,berkahwin?
Dialog: 0,0:51:06.84,0:51:09.85,teks umum,,0,0,0,,Apa yang perlu saya buat, cikgu? Kahwin?
Dialog: 0,0:51:12.22,0:51:13.35,teks umum,,0,0,0,,Adakah ia berbaloi?
Dialog: 0,0:51:15.18,0:51:18.90,teks umum,,0,0,0,,Jika demikian, tiada sebab untuk tinggal di sini lagi
Dialog: 0,0:51:19.48,0:51:21.40,teks umum,,0,0,0,,Tepat sekali. Kita perlu pulang ke rumah
Dialog: 0,0:51:21.48,0:51:23.69,teks umum,,0,0,0,,Tetapi hubungan kami, sudah tentu, tidak akan bertahan
Dialog: 0,0:51:23.78,0:51:26.65,teks umum,,0,0,0,,Kenapa? Awak masih boleh jadi pembantu rumah saya
Dialog: 0,0:51:28.86,0:51:31.53,teks umum,,0,0,0,,Rancangan saya tidak termasuk menjadi dia selamanya
Dialog: 0,0:51:49.76,0:51:51.39,teks umum,,0,0,0,,Kemudian anda akan belayar sendiri
Dialog: 0,0:51:51.47,0:51:52.97,teks umum,,0,0,0,,Saya akan berada di Chwisongru
Dialog: 0,0:51:54.31,0:51:57.39,teks umum,,0,0,0,,Jika anda tidak datang untuk saya, saya akan pergi sendiri
Dialog: 0,0:52:12.12,0:52:13.87,teks umum,,0,0,0,,Chwisongru
Dialog: 0,0:52:19.33,0:52:20.33,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:52:20.42,0:52:22.08,teks umum,,0,0,0,,Kami dari Jeonbugwan
Dialog: 0,0:52:22.17,0:52:24.04,teks umum,,0,0,0,,Kami akan membawa anda ke sana
Dialog: 0,0:52:24.13,0:52:24.96,teks umum,,0,0,0,,Jom
Dialog: 0,0:52:28.38,0:52:30.30,contact,,0,0,0,,Ini adalah uncang Baginda
Dialog: 0,0:52:30.38,0:52:34.05,teks umum,,0,0,0,,Saya berada di bawah perlindungan putera raja sendiri, awak tidak berani menyentuh saya
Dialog: 0,0:52:37.27,0:52:39.73,teks umum,,0,0,0,,Apa yang kamu lakukan? lepaskan!
Dialog: 0,0:52:39.81,0:52:41.69,teks umum,,0,0,0,,Ini adalah sachet Putera Mahkota
Dialog: 0,0:52:53.70,0:52:55.91,teks umum,,0,0,0,,Kami menghantarnya dari Chwisongru
Dialog: 0,0:52:56.54,0:52:58.33,teks umum,,0,0,0,,Chwisongru?
Dialog: 0,0:53:07.13,0:53:09.55,teks umum,,0,0,0,,Gadis yang awak tanya telah tiba
Dialog: 0,0:53:10.17,0:53:11.30,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,0:53:15.01,0:53:16.10,teks umum,,0,0,0,,Di sini
Dialog: 0,0:53:18.43,0:53:19.39,teks umum,,0,0,0,,Dia?
Dialog: 0,0:53:19.93,0:53:21.52,teks umum,,0,0,0,,Angkat kepala anda
Dialog: 0,0:53:33.07,0:53:34.70,teks umum,,0,0,0,,Kenapa awak berpakaian begitu?
Dialog: 0,0:53:35.28,0:53:36.78,teks umum,,0,0,0,,Tiada idea
Dialog: 0,0:53:37.32,0:53:40.53,teks umum,,0,0,0,,Dia menukar pakaian saya sebaik sahaja mereka membawa saya ke sini
Dialog: 0,0:53:41.49,0:53:43.66,teks umum,,0,0,0,,Adakah ini anda lakukan?
Dialog: 0,0:53:43.75,0:53:45.83,teks umum,,0,0,0,,Bukankah dia seorang kisaeng...
Dialog: 0,0:53:46.71,0:53:47.96,teks umum,,0,0,0,,dari Chwisongru?
Dialog: 0,0:53:49.13,0:53:50.29,teks umum,,0,0,0,,Tidak
Dialog: 0,0:53:51.84,0:53:54.26,teks umum,,0,0,0,,- Dia Busuk Mu Dok\N- V-Stink?
Dialog: 0,0:53:56.34,0:53:57.59,teks umum,,0,0,0,,Keluar
Dialog: 0,0:53:58.51,0:53:59.76,teks umum,,0,0,0,,Go
Dialog: 0,0:54:02.89,0:54:04.14,teks umum,,0,0,0,,Lihat sahaja diri anda
Dialog: 0,0:54:08.35,0:54:10.36,teks umum,,0,0,0,,Kenapa awak nak jumpa saya?
Dialog: 0,0:54:10.44,0:54:14.28,teks umum,,0,0,0,,Saya ingin mengatakan sesuatu, jadi saya mengarahkan anda untuk dihantar
Dialog: 0,0:54:14.36,0:54:16.36,teks umum,,0,0,0,,Tetapi sekarang anda bukan Won Moo Deok
Dialog: 0,0:54:16.45,0:54:18.07,teks umum,,0,0,0,,Bau busuk dan sutera tidak seiring
Dialog: 0,0:54:18.78,0:54:21.37,teks umum,,0,0,0,,Dalam kamus anda ia sangat
Dialog: 0,0:54:22.41,0:54:23.79,teks umum,,0,0,0,,Adakah anda baru sahaja mengetuk?
Dialog: 0,0:54:23.87,0:54:25.41,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:25.50,0:54:28.46,teks umum,,0,0,0,,Saya bersyukur kerana mereka memakaikan saya dengan sutera
Dialog: 0,0:54:30.08,0:54:33.34,teks umum,,0,0,0,, Boleh diterima. Wajah baru ini...
Dialog: 0,0:54:35.21,0:54:36.59,teks umum,,0,0,0,,tidak sesuai dengan anda
Dialog: 0,0:54:39.38,0:54:42.85,teks umum,,0,0,0,,Anda tidak suka, saya tidak selesa dengan ini,
Dialog: 0,0:54:42.93,0:54:44.18,teks umum,,0,0,0,,Saya akan menukar pakaian
Dialog: 0,0:54:44.26,0:54:45.35,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:46.52,0:54:49.10,teks umum,,0,0,0,,Tidak mengapa. Biarkan seadanya
Dialog: 0,0:54:51.56,0:54:55.65,teks umum,,0,0,0,,Katakan apa yang anda mahu dan saya akan melakukannya
Dialog: 0,0:54:55.73,0:54:58.03,teks umum,,0,0,0,, Beritahu tuanmu...
Dialog: 0,0:54:58.65,0:54:59.95,teks umum,,0,0,0,,jangan datang hari itu
Dialog: 0,0:55:01.11,0:55:02.45,teks umum,,0,0,0,,Saya tidak mahu membunuhnya
Dialog: 0,0:55:02.53,0:55:05.70,miring,,0,0,0,,dan menjadi musuh Hutan Pine dan keluarga Chan
Dialog: 0,0:55:06.41,0:55:08.71,teks umum,,0,0,0,,Adalah lebih baik jika dia melarikan diri dan meninggalkan segala-galanya seperti sedia ada
Dialog: 0,0:55:10.25,0:55:12.71,teks umum,,0,0,0,,Iaitu, dia hanya perlu menjadi bahan ketawa
Dialog: 0,0:55:13.38,0:55:14.42,contact,,0,0,0,,Betul
Dialog: 0,0:55:15.05,0:55:18.34,teks umum,,0,0,0,,Jika dia berdegil, beritahu dia
Dialog: 0,0:55:18.42,0:55:20.34,teks umum,,0,0,0,,Dia tidak akan bertahan dalam pergaduhan dengan saya
Dialog: 0,0:55:22.93,0:55:26.06,teks umum,,0,0,0,,Biarkan dia duduk diam dan kemudian berkahwin dengan Jin Cho Young
Dialog: 0,0:55:27.35,0:55:30.44,teks umum,,0,0,0,,Jadi memang benar perkahwinan akan menyelamatkan nyawanya
Dialog: 0,0:55:33.19,0:55:35.48,teks umum,,0,0,0,,Apa yang akan berlaku kepada anda jika dia berkahwin?
Dialog: 0,0:55:35.57,0:55:36.69,teks umum,,0,0,0,,Adakah anda akan tinggal bersamanya?
Dialog: 0,0:55:37.36,0:55:38.65,teks umum,,0,0,0,,Saya tidak akan tinggal
Dialog: 0,0:55:39.28,0:55:41.95,teks umum,,0,0,0,,Kenapa? Adakah dia berputus asa dengan anda?
Dialog: 0,0:55:44.37,0:55:47.24,teks umum,,0,0,0,,Dan anda bersedia untuk minum air dari periuk bilik demi dia
Dialog: 0,0:55:47.33,0:55:49.00,contact,,0,0,0,,Dia tiada kesetiaan,
Dialog: 0,0:55:49.08,0:55:50.41,teks umum,,0,0,0,,tiada maruah
Dialog: 0,0:55:51.62,0:55:55.84,teks umum,,0,0,0,,Ada sesuatu, Yang Amat Mulia
Dialog: 0,0:55:55.92,0:55:58.34,teks umum,,0,0,0,,Adakah anda melindungi dia? Dan selalunya dia cakap benda jahat
Dialog: 0,0:55:58.42,0:56:00.22,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:56:01.17,0:56:03.47,teks umum,,0,0,0,,Anda pasti gembira mendengar perkara jahat tentang dia,
Dialog: 0,0:56:04.30,0:56:08.06,teks umum,,0,0,0,,tetapi sekarang saya tidak mempunyai kekuatan untuk bercakap
Dialog: 0,0:56:09.60,0:56:12.23,teks umum,,0,0,0,,Anda adalah kacukan kotor yang akan ditinggalkan oleh pemilik anda
Dialog: 0,0:56:23.57,0:56:24.61,teks umum,,0,0,0,,Adakah anda mahu saya bawakannya kepada anda?
Dialog: 0,0:56:26.74,0:56:27.99,teks umum,,0,0,0,,Saya boleh
Dialog: 0,0:56:28.58,0:56:30.87,teks umum,,0,0,0,,Anda akan mendapat kerja di sini juga
Dialog: 0,0:56:32.21,0:56:33.08,teks umum,,0,0,0,,Saya tidak mahu
Dialog: 0,0:56:34.50,0:56:37.38,teks umum,,0,0,0,,Izinkan saya menjadi Won Mu Deok, yang semua orang elakkan,
Dialog: 0,0:56:37.96,0:56:40.76,teks umum,,0,0,0,,tetapi saya tidak melayan semua orang
Dialog: 0,0:56:44.26,0:56:46.89,teks umum,,0,0,0,,Lupakan. Awak juga tidak berputus asa dengan saya
Dialog: 0,0:56:47.51,0:56:49.56,miring,,0,0,0,,- Anda boleh pergi\N-{\i0} Ya
Dialog: 0,0:56:55.10,0:56:56.65,teks umum,,0,0,0,,Kalau begitu saya pergi,
Dialog: 0,0:56:57.23,0:56:58.48,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:57:08.03,0:57:09.41,teks umum,,0,0,0,,"Kepada semua orang"?
Dialog: 0,0:57:10.74,0:57:12.04,teks umum,,0,0,0,,Saya seorang putera raja
Dialog: 0,0:57:12.12,0:57:14.12,teks umum,,0,0,0,,Won Moo Deok tidak faham,
Dialog: 0,0:57:14.21,0:57:15.75,teks umum,,0,0,0,,dengan siapa dia bercakap
Dialog: 0,0:57:33.23,0:57:35.98,teks umum,,0,0,0,,- Berhati-hati. Jangan tergesa-gesa\N- Ya, puan
Dialog: 0,0:57:38.11,0:57:38.94,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:57:40.36,0:57:41.23,teks umum,,0,0,0,,Apa khabar?
Dialog: 0,0:57:42.48,0:57:43.57,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:57:44.19,0:57:45.70,teks umum,,0,0,0,,Sayang!
Dialog: 0,0:57:47.70,0:57:49.57,teks umum,,0,0,0,,- Tuan Muda!\N- Adakah anda bimbang?
Dialog: 0,0:57:49.66,0:57:50.87,teks umum,,0,0,0,,Adakah anda makan dengan baik?
Dialog: 0,0:57:50.95,0:57:52.58,teks umum,,0,0,0,,Ya, bagus
Dialog: 0,0:57:52.66,0:57:54.12,teks umum,,0,0,0,,Alangkah bahagianya
Dialog: 0,0:57:54.20,0:57:55.71,teks umum,,0,0,0,,Kulit anda bersinar
Dialog: 0,0:57:55.79,0:57:56.92,teks umum,,0,0,0,,Apa yang kamu cakapkan!
Dialog: 0,0:57:57.00,0:57:58.29,teks umum,,0,0,0,,Jom masuk
Dialog: 0,0:58:01.96,0:58:03.80,teks umum,,0,0,0,,Dia cuba menjualnya
Dialog: 0,0:58:06.47,0:58:07.84,teks umum,,0,0,0,,azimat daripada Sosnovy Bor?
Dialog: 0,0:58:15.77,0:58:17.85,teks umum,,0,0,0,,Itu bukan saya. Ini semua Moo Deok
Dialog: 0,0:58:18.65,0:58:20.86,teks umum,,0,0,0,,Moo Dok cuba menjual azimat Wook?
Dialog: 0,0:58:20.94,0:58:23.19,teks umum,,0,0,0,,Saya baru sahaja memperkenalkannya kepada penjual
Dialog: 0,0:58:23.28,0:58:25.28,teks umum,,0,0,0,,Akhirnya Ah Hyang yang mencurinya
Dialog: 0,0:58:25.36,0:58:27.32,teks umum,,0,0,0,,So Moo Deok dan saya tiada kaitan dengannya
Dialog: 0,0:58:45.05,0:58:46.34,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:58:47.72,0:58:49.97,teks umum,,0,0,0,,Kenapa dia berpakaian begitu?
Dialog: 0,0:58:50.72,0:58:52.43,teks umum,,0,0,0,,Cerita panjang
Dialog: 0,0:58:52.51,0:58:55.27,teks umum,,0,0,0,,Awak dah balik ke Chwisong-ra?
Dialog: 0,0:58:56.14,0:58:58.39,teks umum,,0,0,0,,Adakah Uk menjual awak balik kerana dia akan berkahwin?
Dialog: 0,0:58:58.48,0:58:59.77,teks umum,,0,0,0,,Tidak
Dialog: 0,0:58:59.85,0:59:03.77,teks umum,,0,0,0,,Walaupun ia terjual, saya tidak akan kembali ke sini
Dialog: 0,0:59:03.86,0:59:05.86,teks umum,,0,0,0,,Joo Wol akhirnya menyerah dan memberitahu saya,
Dialog: 0,0:59:05.94,0:59:07.65,teks umum,,0,0,0,,bahawa anda cuba menjual azimat Uka
Dialog: 0,0:59:10.99,0:59:12.82,teks umum,,0,0,0,,Ya, saya cuba
Dialog: 0,0:59:13.70,0:59:14.62,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:59:15.74,0:59:17.50,teks umum,,0,0,0,,Sebab saya perlukan wang
Dialog: 0,0:59:17.58,0:59:20.29,teks umum,,0,0,0,,Saya mahu memakai sutera, makan gula-gula,
Dialog: 0,0:59:20.37,0:59:22.88,teks umum,,0,0,0,,dan bergembiralah di tempat sebegitu
Dialog: 0,0:59:22.96,0:59:26.46,teks umum,,0,0,0,,Itulah sebab awak mabuk lepas
Dialog: 0,0:59:27.38,0:59:30.63,teks umum,,0,0,0,,Ya. Saya mencuri wang pemilik saya dan mabuk
Dialog: 0,0:59:35.22,0:59:37.27,teks umum,,0,0,0,,Saya benar-benar hairan
Dialog: 0,0:59:38.98,0:59:41.48,teks umum,,0,0,0,,Saya cuma tidak faham awak
Dialog: 0,0:59:44.90,0:59:47.19,teks umum,,0,0,0,,Dan anda tidak memerlukannya
Dialog: 0,0:59:47.28,0:59:49.07,teks umum,,0,0,0,,Biarkan semuanya seperti sedia ada
Dialog: 0,0:59:51.15,0:59:52.78,teks umum,,0,0,0,,Saya masuk
Dialog: 0,0:59:52.86,0:59:54.53,teks umum,,0,0,0,,Adakah anda mahu menyertai saya?
Dialog: 0,0:59:55.33,0:59:56.24,teks umum,,0,0,0,,Tidak
Dialog: 0,0:59:57.49,0:59:58.62,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,1:00:11.80,1:00:13.26,teks umum,,0,0,0,,Azimat...
Dialog: 0,1:00:14.64,1:00:17.81,teks umum,,0,0,0,,Jadi awaklah, Nak Su
Dialog: 0,1:00:27.94,1:00:29.07,teks umum,,0,0,0,,En.
Dialog: 0,1:00:30.86,1:00:32.86,teks umum,,0,0,0,,kenapa awak tak nak kahwin?
Dialog: 0,1:00:34.70,1:00:36.24,teks umum,,0,0,0,,Awak tak suka Puan Jin?
Dialog: 0,1:00:36.32,1:00:38.66,teks umum,,0,0,0,,Bukan saya tidak suka dia
Dialog: 0,1:00:39.70,1:00:41.58,teks umum,,0,0,0,,Saya cuma tidak berminat
Dialog: 0,1:00:42.21,1:00:44.33,teks umum,,0,0,0,,Adakah anda menyukai orang lain?
Dialog: 0,1:00:45.71,1:00:46.92,teks umum,,0,0,0,,Siapa?
Dialog: 0,1:00:47.50,1:00:49.00,teks umum,,0,0,0,,Adakah saya mengenalinya?
Dialog: 0,1:00:50.01,1:00:52.05,teks umum,,0,0,0,,Tidak, anda tidak mengenalinya
Dialog: 0,1:00:52.63,1:00:53.84,teks umum,,0,0,0,,Jadi ada seseorang
Dialog: 0,1:00:53.93,1:00:55.18,teks umum,,0,0,0,,saya tahu
Dialog: 0,1:00:55.26,1:00:56.30,teks umum,,0,0,0,,Siapa dia?
Dialog: 0,1:00:57.85,1:00:58.89,teks umum,,0,0,0,,Nah...
Dialog: 0,1:00:58.97,1:01:01.89,teks umum,,0,0,0,,Dia seperti telur yang sunyi di dalam sarang bukan di puncak pokok
Dialog: 0,1:01:02.52,1:01:06.06,teks umum,,0,0,0,,Dia tiada sesiapa selain saya, jadi bagaimana saya boleh berkahwin dengan orang lain?
Dialog: 0,1:01:06.15,1:01:09.07,teks umum,,0,0,0,,Gadis sebegitulah yang paling berbahaya!
Dialog: 0,1:01:09.15,1:01:11.40,teks umum,,0,0,0,,Mereka tidak mempunyai apa-apa untuk dibualkan, tetapi mereka akan berpegang teguh!
Dialog: 0,1:01:11.48,1:01:12.99,teks umum,,0,0,0,,Dia bukan begitu
Dialog: 0,1:01:13.07,1:01:15.53,teks umum,,0,0,0,,Siapa dia? Cakap
Dialog: 0,1:01:15.61,1:01:16.91,teks umum,,0,0,0,,saya akan jaga dia
Dialog: 0,1:01:16.99,1:01:18.16,teks umum,,0,0,0,,Bagaimana sebenarnya?
Dialog: 0,1:01:18.24,1:01:20.70,teks umum,,0,0,0,,Saya akan beri dia beg wang,
Dialog: 0,1:01:20.79,1:01:23.37,teks umum,,0,0,0,,dia akan menetas dari telur dan terbang pergi
Dialog: 0,1:01:23.46,1:01:26.88,teks umum,,0,0,0,,Dia tidak boleh terbang, ia tidak semudah itu
Dialog: 0,1:01:28.17,1:01:30.30,teks umum,,0,0,0,,Walau bagaimanapun, saya tidak boleh berkahwin
Dialog: 0,1:01:30.38,1:01:31.59,teks umum,,0,0,0,,Berurusan dengannya
Dialog: 0,1:01:32.55,1:01:34.72,teks umum,,0,0,0,,Fikirkan sahaja. baik?
Dialog: 0,1:01:35.51,1:01:36.84,teks umum,,0,0,0,,En.
Dialog: 0,1:01:39.35,1:01:42.06,teks umum,,0,0,0,,Apakah itu? Adakah anda cedera?
Dialog: 0,1:01:42.14,1:01:43.39,teks umum,,0,0,0,,Tunjukkan
Dialog: 0,1:01:45.56,1:01:47.48,teks umum,,0,0,0,,Ada apa dengan tangan?
Dialog: 0,1:01:49.27,1:01:50.94,teks umum,,0,0,0,,Tidak terkawal lagi?
Dialog: 0,1:01:58.16,1:01:59.78,teks umum,,0,0,0,,Jual pakaian ini
Dialog: 0,1:01:59.87,1:02:03.50,teks umum,,0,0,0,,- Ini sutera, jual pada harga yang lebih tinggi\N- Bagus
Dialog: 0,1:02:04.08,1:02:06.54,teks umum,,0,0,0,,Wanita itu kini mempunyai pelawat
Dialog: 0,1:02:06.62,1:02:08.33,teks umum,,0,0,0,,Cik Muda Jin dari Jinyeowon ada di sini
Dialog: 0,1:02:09.08,1:02:12.63,miring,,0,0,0,,Dia sedang mencari tuan yang akan membuat cincin perkahwinan untuknya
Dialog: 0,1:02:12.71,1:02:14.55,teks umum,,0,0,0,,Dia berkahwin dengan ahli silap mata dari Sosnovy Bor
Dialog: 0,1:02:18.51,1:02:20.76,teks umum,,0,0,0,,Bagaimanakah anda menyukai cincin ini?
Dialog: 0,1:02:23.77,1:02:27.48,teks umum,,0,0,0,,Ini adalah karya tukang terbaik dari Deho
Dialog: 0,1:02:29.27,1:02:32.15,teks umum,,0,0,0,,Ia cantik, tetapi sedikit tawar
Dialog: 0,1:02:33.78,1:02:36.03,teks umum,,0,0,0,,Bolehkah saya melihat jed yin-yang?
Dialog: 0,1:02:36.11,1:02:38.78,teks umum,,0,0,0,,Setelah melihatnya sendiri, saya boleh memilih pilihan yang lebih baik
Dialog: 0,1:02:43.62,1:02:45.62,teks umum,,0,0,0,,Mereka berkata apabila kekasih memakai cincin jed,
Dialog: 0,1:02:45.70,1:02:48.21,teks umum,,0,0,0,,cinta mereka bertambah kuat
Dialog: 0,1:03:02.43,1:03:04.14,di sebalik tabir,,0,0,0,,Kenapa jed itu retak?
Dialog: 0,1:03:04.97,1:03:07.35,suara,,0,0,0,,Apabila saya mengambilnya, semuanya baik-baik saja
Dialog: 0,1:03:13.15,1:03:15.86,suara,,0,0,0,,Adakah dia rosak ketika itu?
Dialog: 0,1:03:18.86,1:03:19.95,contact,,0,0,0,,Moo Dok
Dialog: 0,1:03:26.62,1:03:27.87,miring,,0,0,0,,Pn.
Dialog: 0,1:03:28.46,1:03:30.75,teks umum,,0,0,0,,Kenapa awak pergi tiba-tiba?
Dialog: 0,1:03:30.83,1:03:33.92,teks umum,,0,0,0,,Adakah ini Moo Dok? Uk ada di sini juga?
Dialog: 0,1:03:34.00,1:03:35.21,teks umum,,0,0,0,,Tidak
Dialog: 0,1:03:36.55,1:03:39.17,teks umum,,0,0,0,,- Adakah begitu?\N- Dia mengikut dia dengan ekornya,
Dialog: 0,1:03:39.26,1:03:41.05,teks umum,,0,0,0,,dia mesti berada di suatu tempat di bandar
Dialog: 0,1:03:41.13,1:03:42.93,teks umum,,0,0,0,,Berjalan dengan ekornya?
Dialog: 0,1:03:43.01,1:03:44.72,teks umum,,0,0,0,,Dia hambanya!
Dialog: 0,1:03:45.85,1:03:47.27,teks umum,,0,0,0,,Tonton bahasa anda
Dialog: 0,1:03:48.73,1:03:52.31,teks umum,,0,0,0,,Moo Dok bukan sekadar hamba untuknya
Dialog: 0,1:03:53.48,1:03:56.94,teks umum,,0,0,0,,Moo Dok mabuk baru-baru ini, dan dia datang untuknya
Dialog: 0,1:03:57.61,1:03:59.40,miring,,0,0,0,,Dia menyayanginya
Dialog: 0,1:03:59.49,1:04:01.99,teks umum,,0,0,0,,Saya hanya membawanya di belakang saya
Dialog: 0,1:04:02.66,1:04:03.57,contact,,0,0,0,,Sudah tentu
Dialog: 0,1:04:03.66,1:04:07.37,teks umum,,0,0,0,,mengambilnya dari sini kerana saya menyukainya
Dialog: 0,1:04:07.91,1:04:11.21,teks umum,,0,0,0,,Mu Dok dari sini? Adakah dia seorang gisaeng?
Dialog: 0,1:04:11.29,1:04:12.75,teks umum,,0,0,0,,Dia seorang gadis miskin
Dialog: 0,1:04:13.42,1:04:16.71,teks umum,,0,0,0,,Tidak hairanlah dia terlalu membebel tentangnya
Dialog: 0,1:04:31.06,1:04:32.10,teks umum,,0,0,0,,Hei
Dialog: 0,1:04:32.73,1:04:34.52,teks umum,,0,0,0,,Anda tahu siapa saya, bukan?
Dialog: 0,1:04:35.90,1:04:38.02,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,1:04:38.11,1:04:40.57,teks umum,,0,0,0,,Anda masih muda Cik Jin dari Jinyeowon
Dialog: 0,1:04:42.57,1:04:45.70,teks umum,,0,0,0,,Tak lama lagi awak akan panggil saya perempuan simpanan
Dialog: 0,1:04:46.91,1:04:50.58,teks umum,,0,0,0,,Sebab saya dan Uk akan berkahwin
Dialog: 0,1:04:52.12,1:04:54.83,teks umum,,0,0,0,,Tahniah
Dialog: 0,1:04:54.92,1:04:58.13,teks umum,,0,0,0,,Saya akan menjadi isterinya, dan awak akan menjadi pembantu rumah saya
Dialog: 0,1:04:59.55,1:05:01.09,teks umum,,0,0,0,,Lakukan sesuatu sekarang
Dialog: 0,1:05:03.34,1:05:05.05,teks umum,,0,0,0,,Ambil kotak
Dialog: 0,1:05:06.09,1:05:07.72,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,1:05:14.56,1:05:15.85,di sebalik tabir,,0,0,0,,Ada apa?
Dialog: 0,1:05:17.02,1:05:18.69,di sebalik tabir,,0,0,0,,Batu patah
Dialog: 0,1:05:21.28,1:05:23.70,teks umum,,0,0,0,,Ini adalah perkara yang berharga
Dialog: 0,1:05:23.78,1:05:25.91,teks umum,,0,0,0,,Jika ia pecah,
Dialog: 0,1:05:25.99,1:05:28.03,teks umum,,0,0,0,,anda akan dipersalahkan
Dialog: 0,1:05:29.16,1:05:31.83,suara,,0,0,0,,Anda katakan ini apabila dia sudah rosak
Dialog: 0,1:05:32.75,1:05:33.79,teks umum,,0,0,0,,Ambil dan ikut saya
Dialog: 0,1:05:35.04,1:05:36.17,teks umum,,0,0,0,,Pn.
Dialog: 0,1:05:36.92,1:05:38.75,teks umum,,0,0,0,,Sementara saya tidak melayan kamu
Dialog: 0,1:05:39.38,1:05:42.09,teks umum,,0,0,0,,Sudah tiba masanya untuk saya pergi ke tuan saya. selamat tinggal
Dialog: 0,1:05:46.38,1:05:48.93,teks umum,,0,0,0,,Adakah dia memandang rendah saya?
Dialog: 0,1:05:56.69,1:05:59.23,teks umum,,0,0,0,,Saya tidak membayangkannya?
Dialog: 0,1:06:09.82,1:06:12.20,di sebalik tabir,,0,0,0,,Lebih baik saya tidak bertembung dengan dia
Dialog: 0,1:06:14.33,1:06:16.37,teks umum,,0,0,0,,Hei! awak!
Dialog: 0,1:06:18.46,1:06:19.38,di sebalik tabir,,0,0,0,,Lelaki berbahaya
Dialog: 0,1:06:21.21,1:06:22.67,di sebalik tabir,,0,0,0,,atau budak keji ini?
Dialog: 0,1:06:24.26,1:06:25.34,teks umum,,0,0,0,,Puan saya
Dialog: 0,1:06:26.13,1:06:28.51,teks umum,,0,0,0,,Berikan kepada saya. Saya akan bawa
Dialog: 0,1:06:31.72,1:06:32.85,teks umum,,0,0,0,,Okey
Dialog: 0,1:06:32.93,1:06:35.48,teks umum,,0,0,0,,Berhati-hati
Dialog: 0,1:06:40.06,1:06:41.56,luar skrin,,0,0,0,,Ya, ia sudah rosak
Dialog: 0,1:06:42.15,1:06:44.36,suara,,0,0,0,,Dia nak salahkan saya dalam hal ini?
Dialog: 0,1:07:13.26,1:07:15.26,suara,,0,0,0,,Jadi ini bermakna keluarga Jin tinggal di sini?
Dialog: 0,1:07:48.05,1:07:49.51,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,1:08:01.77,1:08:02.81,teks umum,,0,0,0,,Ibu
Dialog: 0,1:08:24.50,1:08:26.13,contact,,0,0,0,,Anda tidak boleh pergi begitu sahaja
Dialog: 0,1:08:27.42,1:08:30.80,teks umum,,0,0,0,,Bersumpah di hadapan potret arwah ibu anda bahawa anda akan berkahwin
Dialog: 0,1:08:30.88,1:08:33.43,teks umum,,0,0,0,,Ini adalah satu-satunya cara untuk melindungi status bapa kamu
Dialog: 0,1:08:35.85,1:08:37.18,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:08:37.26,1:08:38.47,teks umum,,0,0,0,,Adakah anda fikir...
Dialog: 0,1:08:39.52,1:08:41.64,teks umum,,0,0,0,,bahawa dia bapa saya?
Dialog: 0,1:08:45.19,1:08:46.56,teks umum,,0,0,0,,Anda tahu...
Dialog: 0,1:08:47.86,1:08:49.53,teks umum,,0,0,0,,siapa bapa kandung saya?
Dialog: 0,1:08:51.19,1:08:52.86,teks umum,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:08:53.78,1:08:55.99,teks umum,,0,0,0,,Anda adalah anak kepada Gwangju Chang Gang
Dialog: 0,1:08:57.91,1:09:00.12,teks umum,,0,0,0,,Ya, itulah yang saya percaya sepanjang hidup saya
Dialog: 0,1:09:00.20,1:09:02.04,italic,,0,0,0,,Saya tidak mahu menafikannya sekarang
Dialog: 0,1:09:02.12,1:09:03.08,contact,,0,0,0,,Jadi...
Dialog: 0,1:09:05.17,1:09:07.17,teks umum,,0,0,0,,Saya tidak akan berdiam diri
Dialog: 0,1:09:08.63,1:09:10.00,teks umum,,0,0,0,,Jangan halang saya,
Dialog: 0,1:09:11.13,1:09:12.47,teks umum,,0,0,0,,apa sahaja yang saya lakukan
Dialog: 0,1:09:20.47,1:09:23.60,teks umum,,0,0,0,,Maiden Kim, keluarga Jin menghantar sesuatu
Dialog: 0,1:09:24.19,1:09:26.52,teks umum,,0,0,0,,Dari Jinyeowon? Apa masalahnya?
Dialog: 0,1:09:26.60,1:09:28.06,teks umum,,0,0,0,,Sesuatu berlaku di sana
Dialog: 0,1:09:28.94,1:09:32.03,teks umum,,0,0,0,,Mereka mahu Tuan Muda Chan segera kepada mereka
Dialog: 0,1:10:12.90,1:10:14.19,teks umum,,0,0,0,,Adakah anda mencari saya?
Dialog: 0,1:10:14.28,1:10:15.57,teks umum,,0,0,0,,Apakah maksud semua ini?
Dialog: 0,1:10:16.15,1:10:18.87,teks umum,,0,0,0,,Pusaka keluarga kami telah hilang
Dialog: 0,1:10:19.66,1:10:20.78,teks umum,,0,0,0,,Dan pembantu rumah...
Dialog: 0,1:10:22.12,1:10:24.25,teks umum,,0,0,0,,hilang bersamanya
Dialog: 0,1:10:31.59,1:10:34.34,suara,,0,0,0,,Itulah dia, Jinyoewon
Dialog: 0,1:10:42.81,1:10:43.89,teks umum,,0,0,0,,Hei
Dialog: 0,1:10:51.15,1:10:52.65,teks umum,,0,0,0,,Jadi anda
Dialog: 0,1:10:56.78,1:10:58.36,teks umum,,0,0,0,,Lama tidak berjumpa
Dialog: 0,1:11:28.64,1:11:29.94,contact,,0,0,0,,Awak cakap Mu Dok...
Dialog: 0,1:11:30.81,1:11:33.48,teks umum,,0,0,0,,- tiada di sini?\N- Ya
Dialog: 0,1:11:34.07,1:11:35.48,teks umum,,0,0,0,,Pembantu rumah awak, Moo Deok,
Dialog: 0,1:11:36.19,1:11:38.61,teks umum,,0,0,0,,mencuri jed yin-yang dan melarikan diri
Dialog: 0,1:12:10.81,1:12:13.10,pratonton,,0,0,0,,Anda sedang memikirkan tentang saya, Yang Amat Mulia,
Dialog: 0,1:12:13.19,1:12:14.65,pratonton,,0,0,0,,sebab itu saya datang
Dialog: 0,1:12:14.73,1:12:17.36,pratonton,,0,0,0,,Anda merindui orang yang anda temui di Danhyangok
Dialog: 0,1:12:17.44,1:12:18.78,pratonton,,0,0,0,,Adakah saya merindui awak?
Dialog: 0,1:12:18.86,1:12:20.11,pratonton,,0,0,0,,Tiada perkara seperti itu
Dialog: 0,1:12:20.19,1:12:21.45,pratonton,,0,0,0,,Buka pintu
Dialog: 0,1:12:21.53,1:12:24.49,pratonton,,0,0,0,,Buka pintu kepada Jinyeowon, tempat peninggalan disimpan
Dialog: 0,1:12:24.57,1:12:26.66,pratonton,,0,0,0,,Anda mungkin dirasuk sihir dan tidak dapat kembali
Dialog: 0,1:12:26.74,1:12:28.49,pratonton,,0,0,0,,Anda terlalu takut untuk menyentuhnya
Dialog: 0,1:12:30.00,1:12:31.25,pratonton,,0,0,0,,Apa itu?
Dialog: 0,1:12:31.33,1:12:32.92,pratonton,,0,0,0,,Bawa Chan Wook
Dialog: 0,1:12:33.00,1:12:35.08,pratonton,,0,0,0,,Saya mesti menyerahkan awak untuk hidup
Dialog: 0,1:12:35.17,1:12:36.13,pratonton,,0,0,0,,Beginilah ia sepatutnya
Dialog: 0,1:12:37.34,1:12:39.88,pratonton,,0,0,0,,So Moo Deok ialah Nak Soo
Dialog: 0,1:12:43.01,1:12:45.26,pratonton,,0,0,0,,Berjuanglah seperti hidupmu bergantung padanya
Dialog: 0,0:20:53.07,0:20:55.07,teks umum,,0,0,0,,

