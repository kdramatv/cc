Dialogue: 0,0:02:47.14,0:02:49.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:49.14,0:02:51.14,الألقاب,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} سانا، مارتيني
Dialogue: 0,0:02:51.14,0:02:53.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، تومو
Dialogue: 0,0:00:48.70,0:00:50.70,نص عام,,0,0,0,,انتظري سيدتي
Dialogue: 0,0:00:50.79,0:00:52.54,نص عام,,0,0,0,,لا تغمض عينيك
Dialogue: 0,0:00:52.62,0:00:53.83,نص عام,,0,0,0,,لا تغفو
Dialogue: 0,0:01:04.30,0:01:06.26,caption,,0,0,0,,يجب أن أجعل دو هوا ملكي. إذا حملت، فالطفل لي
Dialogue: 0,0:01:06.35,0:01:08.35,ذكريات بخط مائل,,0,0,0,,شكرًا لك
Dialogue: 0,0:01:09.10,0:01:12.27,ذكريات,,0,0,0,,الأسبوع الماضي كان مذهلاً
Dialogue: 0,0:01:17.23,0:01:18.69,ذكريات,,0,0,0,,هل هوا قريباً
Dialogue: 0,0:01:20.03,0:01:21.99,ذكريات,,0,0,0,,سوف تلد ابني
Dialogue: 0,0:01:24.41,0:01:25.53,ذكريات,,0,0,0,,جلالتك
Dialogue: 0,0:01:26.24,0:01:30.04,الذكريات,,0,0,0,,هل تتذكر النبؤة التي تلقيتها يوم تتويجي؟
Dialogue: 0,0:01:30.62,0:01:34.12,ذكريات,,0,0,0,,قلت إنني سأرزق بابن
Dialogue: 0,0:01:34.92,0:01:37.96,ذكريات,,0,0,0,,من سيكون لديه طاقة النجم الملكي
Dialogue: 0,0:01:38.54,0:01:42.21,ذكريات,,0,0,0,,كان التوقع خاطئًا. هذا مستحيل
Dialogue: 0,0:01:44.68,0:01:45.88,ذكريات,,0,0,0,,لا
Dialogue: 0,0:01:47.43,0:01:50.06,ذكريات,,0,0,0,,يجب أن يصبح هذا حقيقة
Dialogue: 0,0:01:51.06,0:01:54.18,ذكريات,,0,0,0,,سيكون لدي ابن بفضل كيمياء النفوس الخاصة بك
Dialogue: 0,0:01:55.98,0:01:57.69,ذكريات,,0,0,0,,تذكر هذا
Dialogue: 0,0:01:58.90,0:02:00.77,ذكريات,,0,0,0,,هل هوا تحمل وتلد
Dialogue: 0,0:02:02.69,0:02:04.15,ذكريات,,0,0,0,,يابني
Dialogue: 0,0:02:07.20,0:02:08.53,ذكريات,,0,0,0,,سيكون لي
Dialogue: 0,0:03:07.01,0:03:10.64,ذكريات مائلة,,0,0,0,,النجم الذي في وسط الدب الأكبر والذي يعني أسرار الطبيعة،
Dialogue: 0,0:03:10.72,0:03:15.35,ذكريات بخط مائل,,0,0,0,,لا تظهر إلا عندما تمتلئ السماء بطاقة مياه ديهو.
Dialogue: 0,0:03:23.36,0:03:26.19,ذكريات بخط مائل,,0,0,0,,سيولد ابني عندما يسطع هذا النجم
Dialogue: 0,0:03:36.58,0:03:39.96,ذكريات,,0,0,0,,من الآن فصاعدا، أمنع تشان ووك من دخول سوسنوفي بور
Dialogue: 0,0:03:41.29,0:03:42.63,ذكريات,,0,0,0,,ضربة واحدة متبقية
Dialogue: 0,0:03:42.71,0:03:44.09,ذكريات,,0,0,0,,وطبق هذا الأخير بنفسك
Dialogue: 0,0:03:59.98,0:04:01.06,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:04:02.31,0:04:05.69,النص العام,,0,0,0,,هل لا يزال السيد الشاب صامتًا؟
Dialogue: 0,0:04:06.73,0:04:10.70,نص عام,,0,0,0,,نعم. ضربوني على ظهري، وشعرت وكأن لساني قد أصيب بأذى
Dialogue: 0,0:04:10.78,0:04:13.20,general text,,0,0,0,,انفجر بالبكاء حتى عندما ضرب إصبعه
Dialogue: 0,0:04:13.28,0:04:15.95,general text,,0,0,0,,وبعد مائة ضربة صمت كالسمكة
Dialogue: 0,0:04:16.03,0:04:17.12,نص عام,,0,0,0,,أنا قلقة
Dialogue: 0,0:04:17.20,0:04:20.29,general text,,0,0,0,,إنه طفل يبكي، لذا أعتقد أنه لا يزال قادرًا على تحمله
Dialogue: 0,0:04:21.71,0:04:25.75,النص العام,,0,0,0,,ليس ظهره هو الذي يؤلمه، بل قلبه
Dialogue: 0,0:04:26.88,0:04:30.80,general text,,0,0,0,,لقد تخلى عنه الرجل الذي اعتبره والده
Dialogue: 0,0:04:30.88,0:04:32.43,نص عام,,0,0,0,,تخيل كيف يبدو الأمر بالنسبة له
Dialogue: 0,0:04:33.76,0:04:35.55,نص عام,,0,0,0,,كم يشعر بأنه مهجور
Dialogue: 0,0:04:59.58,0:05:01.46,نص عام,,0,0,0,,كن سعيدًا لأنك تعرضت للضرب
Dialogue: 0,0:05:02.16,0:05:05.33,نص عام,,0,0,0,,لن يتمكنوا من أخذ الطاقة الآن
Dialogue: 0,0:05:05.42,0:05:07.34,نص عام,,0,0,0,,لديك المزيد من الوقت للتدريب
Dialogue: 0,0:05:18.35,0:05:19.47,نص عام,,0,0,0,,المضيف
Dialogue: 0,0:05:20.31,0:05:21.31,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:05:41.62,0:05:43.75,نص عام,,0,0,0,,مو دوك، انظر
Dialogue: 0,0:05:43.83,0:05:46.12,نص عام,,0,0,0,,أعتقد أن هذه الدوائر على الماء هي ميزتي
Dialogue: 0,0:05:50.96,0:05:52.38,نص عام,,0,0,0,,إنها مجرد تموجات
Dialogue: 0,0:05:54.09,0:05:56.89,نص عام,,0,0,0,,لماذا لا يعمل؟ لقد قمت بتدريب تنفسي
Dialogue: 0,0:05:56.97,0:05:59.30,النص العام,,0,0,0,,هذا ما كنت تفعله في صمت
Dialogue: 0,0:05:59.39,0:06:02.60,general text,,0,0,0,,وأعتقدت أنك تغرق في محيط من الحزن لأنك طردتني
Dialogue: 0,0:06:02.68,0:06:05.27,general text,,0,0,0,,- لقد كنت مخطئاً\N- هل أنا غارق في محيط من الحزن؟
Dialogue: 0,0:06:05.35,0:06:07.35,نص عام,,0,0,0,,لقد هجرتني منذ ولادتي
Dialogue: 0,0:06:07.44,0:06:09.69,النص العام,,0,0,0,,وهذه ليست المرة الأولى التي أطرد فيها من مكان ما
Dialogue: 0,0:06:09.77,0:06:11.23,نص عام,,0,0,0,,لا يزعجني ذلك
Dialogue: 0,0:06:17.03,0:06:18.53,نص عام,,0,0,0,,سترى
Dialogue: 0,0:06:18.62,0:06:22.04,general text,,0,0,0,,سأجعلهم يتوسلون إليّ للعودة إلى سوسنوفي بور
Dialogue: 0,0:06:23.45,0:06:25.12,النص العام,,0,0,0,,الحماقة مفيدة أحيانًا، على ما يبدو
Dialogue: 0,0:06:25.71,0:06:26.71,النص العام,,0,0,0,,هذا مظهر من مظاهر القوة!
Dialogue: 0,0:06:30.34,0:06:33.09,نص عام,,0,0,0,,لماذا الجو حار هنا؟
Dialogue: 0,0:06:33.71,0:06:35.59,نص عام,,0,0,0,,هل الجو حار؟ أنا بارد
Dialogue: 0,0:06:38.34,0:06:40.14,نص عام,,0,0,0,,لماذا أصبح الماء ساخناً جداً؟
Dialogue: 0,0:06:42.47,0:06:43.97,نص عام,,0,0,0,,لماذا تحترق؟
Dialogue: 0,0:06:44.93,0:06:48.69,نص عام,,0,0,0,,أشعر بالغرابة. درجة الحرارة ترتفع
Dialogue: 0,0:06:48.77,0:06:50.11,نص عام,,0,0,0,,هذه هي الطاقة
Dialogue: 0,0:06:51.23,0:06:52.44,نص عام,,0,0,0,,لكن قريباً جداً؟
Dialogue: 0,0:06:55.32,0:06:56.90,نص عام,,0,0,0,,إنها مسألة ضرب.
Dialogue: 0,0:06:56.99,0:06:59.16,general text,,0,0,0,,بسببها كانت هناك موجة من الطاقة
Dialogue: 0,0:06:59.91,0:07:01.58,نص عام,,0,0,0,,سعيد لأنك تعرضت للضرب
Dialogue: 0,0:07:04.49,0:07:06.25,النص العام,,0,0,0,,مو دوك، أنا مشتعل
Dialogue: 0,0:07:06.33,0:07:09.67,general text,,0,0,0,,سوف تكون ساخنًا بينما تتحول الطاقة إلى حرارة
Dialogue: 0,0:07:09.75,0:07:11.88,النص العام,,0,0,0,,وسيكون الجو بارداً عندما يبرد
Dialogue: 0,0:07:11.96,0:07:14.59,general text,,0,0,0,,الطاقة لن تكون ملكك إلا إذا تعاملت معها
Dialogue: 0,0:07:15.76,0:07:18.55,نص عام,,0,0,0,,تنفس ببطء
Dialogue: 0,0:07:26.39,0:07:27.81,نص عام,,0,0,0,,هذا ماء بارد
Dialogue: 0,0:07:41.49,0:07:42.62,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:07:43.37,0:07:45.04,نص عام,,0,0,0,,هل لا يزال السيد الشاب يستحم؟
Dialogue: 0,0:07:45.12,0:07:47.08,نص عام,,0,0,0,,لقد مرت ساعة تقريبًا
Dialogue: 0,0:07:47.75,0:07:51.88,خلف الكواليس,,0,0,0,,إذا اكتشفت الأمر، ستخبر كل شيء في سوسنوفي بور، وسنفقد طاقتنا
Dialogue: 0,0:07:51.96,0:07:52.83,نص عام,,0,0,0,,الأعشاب الطبية
Dialogue: 0,0:07:54.38,0:07:56.63,نص عام,,0,0,0,,يستحم في الأعشاب
Dialogue: 0,0:07:57.21,0:07:58.92,نص عام,,0,0,0,,لقد جهزت الأعشاب،
Dialogue: 0,0:07:59.01,0:08:01.84,النص العام,,0,0,0,,ويغتسل فيهما لتلتئم الجراح
Dialogue: 0,0:08:03.10,0:08:03.93,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:08:05.31,0:08:06.56,نص عام,,0,0,0,,فكرة جيدة
Dialogue: 0,0:08:09.64,0:08:10.73,نص عام,,0,0,0,,قف
Dialogue: 0,0:08:17.90,0:08:19.74,النص العام,,0,0,0,,لماذا الماء بارد إذن؟
Dialogue: 0,0:08:19.82,0:08:21.03,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:08:21.11,0:08:24.07,general text,,0,0,0,,كان ينبغي أن يبرد الماء خلال الساعة الماضية
Dialogue: 0,0:08:24.16,0:08:26.08,general text,,0,0,0,,لماذا مازلت تحضره باردًا بدلًا من الساخن؟
Dialogue: 0,0:08:28.79,0:08:30.25,general text,,0,0,0,,هل يعاني من الحمى؟
Dialogue: 0,0:08:32.08,0:08:33.25,نص عام,,0,0,0,,سيد...
Dialogue: 0,0:08:38.46,0:08:39.46,نص عام,,0,0,0,,إنها جليدية
Dialogue: 0,0:08:40.17,0:08:41.76,نص عام,,0,0,0,,كيف سمحت لهذا أن يحدث؟
Dialogue: 0,0:08:41.84,0:08:43.30,نص عام,,0,0,0,,ماذا لو مرض؟
Dialogue: 0,0:08:50.14,0:08:53.06,خلف الكواليس,,0,0,0,,تحول الماء المغلي فجأة إلى جليد.
Dialogue: 0,0:08:53.15,0:08:54.23,خط مائل,,0,0,0,,سيد.
Dialogue: 0,0:08:55.77,0:08:57.07,نص عام,,0,0,0,,أين هو؟
Dialogue: 0,0:09:02.82,0:09:05.28,نص عام,,0,0,0,,سيدي، هل أنت بخير؟
Dialogue: 0,0:09:05.99,0:09:07.20,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:09:07.28,0:09:10.54,general text,,0,0,0,,السباحة أراحت جسدي وبدأت أشعر بالنعاس
Dialogue: 0,0:09:13.33,0:09:15.88,خط مائل,,0,0,0,,ما هي قيمتك؟ تحضير مكان للنوم
Dialogue: 0,0:09:17.17,0:09:20.46,نص عام,,0,0,0,,بارد. الآن هو متجمد
Dialogue: 0,0:09:26.68,0:09:29.77,نص عام,,0,0,0,,أشعر بالبرد. يبدو الأمر كما لو أنني أتحول إلى ثلج
Dialogue: 0,0:09:30.68,0:09:34.39,نص عام,,0,0,0,,البرد ينتشر. طاقتك تنمو بشكل أسرع مما كنت أعتقد
Dialogue: 0,0:09:35.65,0:09:36.81,نص عام,,0,0,0,,واصل التنفس
Dialogue: 0,0:10:02.51,0:10:03.97,نص عام,,0,0,0,,بارد جدًا لدرجة أن العقل يصبح غائمًا
Dialogue: 0,0:10:06.18,0:10:08.26,نص عام,,0,0,0,,انتظر. يجب عليك
Dialogue: 0,0:10:10.64,0:10:13.18,نص عام,,0,0,0,,شان ووك! لا تغفو!
Dialogue: 0,0:10:13.27,0:10:15.06,general text,,0,0,0,,إذا نمت ستتجمد حتى الموت
Dialogue: 0,0:10:15.14,0:10:16.27,نص عام,,0,0,0,,انهض
Dialogue: 0,0:10:18.81,0:10:20.07,نص عام,,0,0,0,,تنفس
Dialogue: 0,0:10:31.03,0:10:34.54,general text,,0,0,0,,عمي ويول وأنا أصدقاء أوكا الوحيدون
Dialogue: 0,0:10:34.62,0:10:37.12,general text,,0,0,0,,وسوسنوفي بور هو المكان الوحيد الذي يسميه وطنه.
Dialogue: 0,0:10:37.21,0:10:40.00,نص عام,,0,0,0,,دعه يعود
Dialogue: 0,0:10:40.09,0:10:41.80,النص العام,,0,0,0,,ما زال غير قادر على التدريب
Dialogue: 0,0:10:42.30,0:10:43.96,general text,,0,0,0,,لن يقبلوه في أي مكان،
Dialogue: 0,0:10:44.05,0:10:46.34,general text,,0,0,0,,عندما اكتشفوا أنهم طردوهم من هنا أيضًا
Dialogue: 0,0:10:47.88,0:10:49.76,نص عام,,0,0,0,,يكفي الحديث عنه
Dialogue: 0,0:10:49.85,0:10:53.10,النص العام,,0,0,0,,من الآن فصاعدا، ركز على البدو الرحل وابتلاع الأرواح
Dialogue: 0,0:11:01.94,0:11:04.23,نص عام,,0,0,0,,إنه كالحجر
Dialogue: 0,0:11:05.53,0:11:06.90,النص العام,,0,0,0,,فتحول إلى حجر
Dialogue: 0,0:11:10.37,0:11:11.78,النص العام,,0,0,0,,عندما يندفع البدو إلى البرية،
Dialogue: 0,0:11:11.87,0:11:15.00,النص العام,,0,0,0,,يفقدون الطاقة، لذلك يمتصونها من الناس
Dialogue: 0,0:11:17.25,0:11:19.29,نص عام,,0,0,0,,إنها مثل روح شريرة
Dialogue: 0,0:11:19.37,0:11:22.00,النص العام,,0,0,0,,من الواضح سبب تحريم هذا السحر
Dialogue: 0,0:11:22.09,0:11:24.96,النص العام,,0,0,0,,كيمياء النفوس لم تكن في الأصل سحراً
Dialogue: 0,0:11:25.55,0:11:27.17,نص عام,,0,0,0,,يمكن إتقانه
Dialogue: 0,0:11:27.26,0:11:30.68,النص العام,,0,0,0,,فقط بعد أن أتقنت تشيبسو وريوسا وتشيسا وأخيرًا هوانسو
Dialogue: 0,0:11:30.76,0:11:32.26,النص العام,,0,0,0,,هوانجسو... هذا...
Dialogue: 0,0:11:32.35,0:11:35.77,النص العام,,0,0,0,,متى يمكنك استبدال النار بالماء والعكس؟
Dialogue: 0,0:11:35.85,0:11:38.06,النص العام,,0,0,0,,- الناس لا يستطيعون فعل هذا\N- بالضبط
Dialogue: 0,0:11:38.14,0:11:40.73,general text,,0,0,0,,لكن السيد سو كيونغ، مؤسس غابة الصنوبر، كان قادراً
Dialogue: 0,0:11:40.81,0:11:42.56,نص عام,,0,0,0,,كان هناك واحد آخر
Dialogue: 0,0:11:42.65,0:11:43.69,نص عام,,0,0,0,,من؟
Dialogue: 0,0:11:43.77,0:11:45.69,النص العام,,0,0,0,,وإلا سأخبرك بالاسم وستفهم
Dialogue: 0,0:11:47.15,0:11:49.82,نص عام,,0,0,0,,من تجرأ على تجربة هذه الكيمياء
Dialogue: 0,0:11:49.91,0:11:52.57,نص عام,,0,0,0,,على طالبنا المسكين؟
Dialogue: 0,0:11:52.66,0:11:56.37,general text,,0,0,0,,كان من المفترض أن يعمل في جيونبوجوان، يقرأ النجوم
Dialogue: 0,0:11:56.45,0:11:58.71,general text,,0,0,0,,لقد كان هناك كثيرًا خلال الأشهر القليلة الماضية
Dialogue: 0,0:11:59.62,0:12:02.21,خط مائل,,0,0,0,,بالضبط. هناك أيضًا من قبض على أفراد ناك سو
Dialogue: 0,0:12:02.29,0:12:04.71,general text,,0,0,0,,لم نتمكن من ذلك، ولكن يبدو أن هؤلاء ينتظرونهم
Dialogue: 0,0:12:04.79,0:12:07.21,نص عام,,0,0,0,,أنا متأكد من أن لديهم شيئًا ليفعلوه
Dialogue: 0,0:12:07.30,0:12:09.42,نص عام,,0,0,0,,إلى هذه الروح المبتلعة
Dialogue: 0,0:12:11.38,0:12:14.18,النص العام,,0,0,0,,يول، دان جو، شاهد جيونبوغوان
Dialogue: 0,0:12:14.26,0:12:16.10,نص عام,,0,0,0,,فجأة لاحظت شيئاً غريباً
Dialogue: 0,0:12:16.68,0:12:17.56,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:12:20.06,0:12:21.65,نص عام,,0,0,0,,ماذا عنها؟
Dialogue: 0,0:12:21.73,0:12:24.02,general text,,0,0,0,,الباب يعمل بشكل متقطع منذ أن كسرته المملكة المتحدة
Dialogue: 0,0:12:25.07,0:12:27.15,النص العام,,0,0,0,,- تشان ووك...\N- لا تتحرك!
Dialogue: 0,0:12:27.86,0:12:29.07,نص عام,,0,0,0,,سوف تسقط الأرض
Dialogue: 0,0:12:32.49,0:12:33.82,نص عام,,0,0,0,,لا تتحرك
Dialogue: 0,0:12:34.41,0:12:36.12,نص عام,,0,0,0,,انتظر حتى يغلق الباب تماماً
Dialogue: 0,0:12:37.20,0:12:38.08,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:12:38.62,0:12:41.50,نص عام,,0,0,0,,قلت لك ألا تتحرك!
Dialogue: 0,0:12:41.58,0:12:43.33,نص عام,,0,0,0,,ساعدني!
Dialogue: 0,0:12:45.46,0:12:46.59,نص عام,,0,0,0,,اصمت
Dialogue: 0,0:12:47.96,0:12:49.01,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:13:20.33,0:13:22.25,نص عام,,0,0,0,,استلقي الآن
Dialogue: 0,0:13:40.85,0:13:42.06,نص عام,,0,0,0,,سابساري
Dialogue: 0,0:13:43.06,0:13:44.23,نص عام,,0,0,0,,أخرج
Dialogue: 0,0:13:44.94,0:13:46.65,نص عام,,0,0,0,,تعال معي
Dialogue: 0,0:14:31.15,0:14:32.94,نص عام,,0,0,0,,سعيد بعودتك
Dialogue: 0,0:14:36.61,0:14:40.87,النص العام,,0,0,0,,سأعطيك مكافأة إذا وجدت بدوياً
Dialogue: 0,0:14:40.95,0:14:42.45,نص عام,,0,0,0,,أتمنى أن نعمل معًا
Dialogue: 0,0:15:12.65,0:15:13.78,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:15:15.65,0:15:17.36,نص عام,,0,0,0,,إذا تجمدت حتى الموت،
Dialogue: 0,0:15:18.95,0:15:20.62,نص عام,,0,0,0,,خذ طاقتي,
Dialogue: 0,0:15:22.83,0:15:24.91,نص عام,,0,0,0,,إذا استطعت
Dialogue: 0,0:15:26.20,0:15:29.08,general text,,0,0,0,,لو كنت أستطيع لقتلتك منذ زمن طويل وأخذتك بعيداً
Dialogue: 0,0:15:32.00,0:15:33.67,نص عام,,0,0,0,,أنا متجمد هنا،
Dialogue: 0,0:15:35.26,0:15:37.26,نص عام,,0,0,0,,وترمي عبارات باردة
Dialogue: 0,0:15:39.26,0:15:40.76,نص عام,,0,0,0,,قل شيئًا دافئًا
Dialogue: 0,0:15:41.34,0:15:43.43,نص عام,,0,0,0,,هل فقدت عقلك؟
Dialogue: 0,0:15:43.51,0:15:44.81,نص عام,,0,0,0,,سوف تقول نفس الشيء
Dialogue: 0,0:15:49.64,0:15:51.73,نص عام,,0,0,0,,تشان ووك افتح عينيك
Dialogue: 0,0:15:52.52,0:15:55.44,نص عام,,0,0,0,,حسنًا، سأقول شيئًا دافئًا
Dialogue: 0,0:15:58.36,0:16:01.82,نص عام,,0,0,0,,حيث كنت أعيش، نمت شجرة ضخمة
Dialogue: 0,0:16:03.74,0:16:06.62,النص العام,,0,0,0,,في الأعلى كان هناك عش
Dialogue: 0,0:16:07.29,0:16:09.04,نص عام,,0,0,0,,وكان بداخلها بيضة واحدة
Dialogue: 0,0:16:10.54,0:16:11.92,نص عام,,0,0,0,,هل أكلته؟
Dialogue: 0,0:16:12.92,0:16:14.92,النص العام,,0,0,0,,ستشعر بالدفء من كلامي
Dialogue: 0,0:16:20.30,0:16:22.97,general text,,0,0,0,,طار الطير الأم وجلس عليه
Dialogue: 0,0:16:27.43,0:16:31.85,النص العام,,0,0,0,,أنا مثل البيضة في أعلى الشجرة
Dialogue: 0,0:16:35.27,0:16:36.86,نص عام,,0,0,0,,لا أعرف أحداً،
Dialogue: 0,0:16:38.78,0:16:40.65,نص عام,,0,0,0,,وأنا عاجز
Dialogue: 0,0:16:44.82,0:16:47.41,النص العام,,0,0,0,,أنت الوحيد الذي يستطيع الاعتناء بي
Dialogue: 0,0:16:51.46,0:16:52.71,نص عام,,0,0,0,,حياتي
Dialogue: 0,0:16:54.00,0:16:55.84,نص عام,,0,0,0,,بين يديك
Dialogue: 0,0:17:03.30,0:17:04.59,نص عام,,0,0,0,,كم هو دافئ
Dialogue: 0,0:17:10.73,0:17:12.02,نص عام,,0,0,0,,تابع
Dialogue: 0,0:17:16.44,0:17:19.48,نص عام,,0,0,0,,وكان هناك أيضاً كهف
Dialogue: 0,0:17:21.78,0:17:24.03,نص عام,,0,0,0,,عاش فيها شبل الدب
Dialogue: 0,0:17:55.06,0:17:57.44,ذكريات,,0,0,0,,لا يمكنك حتى التقاط سيف والدك
Dialogue: 0,0:17:57.52,0:17:59.27,ذكريات,,0,0,0,,كيف تريد أن تتعلم التعاويذ؟
Dialogue: 0,0:18:01.03,0:18:03.49,ذكريات,,0,0,0,,لا أحد في دايهو يستطيع مقاومة والدك
Dialogue: 0,0:18:03.57,0:18:05.70,ذكريات,,0,0,0,,وافتح أبواب طاقتك
Dialogue: 0,0:18:05.78,0:18:08.58,ذكريات,,0,0,0,,هذا هو المصير الذي أُعطي لك
Dialogue: 0,0:18:09.58,0:18:11.16,ذكريات,,0,0,0,,والدك
Dialogue: 0,0:18:32.52,0:18:33.68,نص عام,,0,0,0,,لست مستعدًا بعد
Dialogue: 0,0:18:39.98,0:18:42.44,نص عام,,0,0,0,,ارسم السيف السحري
Dialogue: 0,0:18:43.07,0:18:46.15,general text,,0,0,0,,يجب عليك إتقان ريوسو وتعلم كيفية إطلاق الطاقة
Dialogue: 0,0:18:46.95,0:18:50.16,general text,,0,0,0,,لا يمكنك فعل هذا بعد، لأنك لا تستطيع التحكم في طاقتك
Dialogue: 0,0:18:50.91,0:18:53.79,general text,,0,0,0,,ترك والدي هذا السيف عندما تركني
Dialogue: 0,0:18:53.87,0:18:56.08,general text,,0,0,0,,لن أصل إلى سوسنوفي بور إلا بكشفها
Dialogue: 0,0:18:58.83,0:19:00.92,نص عام,,0,0,0,,أريد أن أفعل هذا وأريهم
Dialogue: 0,0:19:02.13,0:19:03.46,general text,,0,0,0,,هل هذا مظهر من مظاهر الغباء؟
Dialogue: 0,0:19:03.55,0:19:04.84,نص عام,,0,0,0,,لا يا قوى
Dialogue: 0,0:19:07.09,0:19:09.97,النص العام,,0,0,0,,كن قوياً تشان ووك
Dialogue: 0,0:19:29.03,0:19:30.16,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:19:30.24,0:19:32.70,النص العام,,0,0,0,,وصلنا إلى منزل تشانغ غان، غوانغجو جيونبوغوان
Dialogue: 0,0:19:37.04,0:19:38.25,نص عام,,0,0,0,,السيد الشاب!
Dialogue: 0,0:19:40.29,0:19:42.67,نص عام,,0,0,0,,لديك ضيف
Dialogue: 0,0:19:43.38,0:19:44.30,نص عام,,0,0,0,,من؟
Dialogue: 0,0:19:44.38,0:19:47.63,نص عام,,0,0,0,,لقد وصل ولي العهد
Dialogue: 0,0:20:09.99,0:20:12.82,خط مائل,,0,0,0,,الطقس مثالي تمامًا
Dialogue: 0,0:20:12.91,0:20:16.08,مائل,,0,0,0,,لصيد الأسماك مع ووك بالقرب من جيونج تشونج دايهو
Dialogue: 0,0:20:18.16,0:20:20.96,نص عام,,0,0,0,,أتساءل عما إذا كان قد عاد إلى رشده
Dialogue: 0,0:20:22.54,0:20:24.63,النص العام,,0,0,0,,قررت زيارته لأنني قلقة
Dialogue: 0,0:20:24.71,0:20:26.38,نص عام,,0,0,0,,لماذا تتدخل؟
Dialogue: 0,0:20:27.80,0:20:29.17,نص عام,,0,0,0,,أريد التحقق من شيء ما
Dialogue: 0,0:20:29.26,0:20:31.38,نص عام,,0,0,0,,قلت شيئاً لخادمته
Dialogue: 0,0:20:32.39,0:20:35.01,نص عام,,0,0,0,,نزوره كأصدقاء،
Dialogue: 0,0:20:35.10,0:20:36.68,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:20:37.81,0:20:39.93,نص عام,,0,0,0,,عثرت عليك بالصدفة
Dialogue: 0,0:20:40.02,0:20:43.69,general text,,0,0,0,,ولدي أيضًا ما أعيب عليه
Dialogue: 0,0:20:43.77,0:20:46.32,نص عام,,0,0,0,,أرى، كنت سأحصل عليه
Dialogue: 0,0:20:46.90,0:20:48.44,نص عام,,0,0,0,,ماذا يوجد في الطرد؟
Dialogue: 0,0:20:51.32,0:20:53.49,نص عام,,0,0,0,,دواء لجراحه
Dialogue: 0,0:20:54.03,0:20:57.83,general text,,0,0,0,,أولاً تعطيه الدواء ثم تجلس على أذنيه
Dialogue: 0,0:20:59.04,0:21:01.33,خط مائل,,0,0,0,,لا يصدق
Dialogue: 0,0:21:03.37,0:21:05.54,general text,,0,0,0,,هل أتيت من أجل سيف ناك سو؟
Dialogue: 0,0:21:05.63,0:21:07.55,general text,,0,0,0,,عهد بها الملك إلى جيونبوغوان
Dialogue: 0,0:21:08.05,0:21:11.30,general text,,0,0,0,,يجب على جين مو، نائب غوانغجو، الاحتفاظ بها، لأنه لا يوجد غوانغجو نفسه
Dialogue: 0,0:21:15.51,0:21:18.31,نص عام,,0,0,0,,بما أنك أتيت إلى هنا شخصيًا، فسوف أنقلها إليك
Dialogue: 0,0:21:18.39,0:21:19.47,نص عام,,0,0,0,,خذها
Dialogue: 0,0:21:20.10,0:21:20.93,خط مائل,,0,0,0,,أحضر السيف
Dialogue: 0,0:21:22.73,0:21:23.85,نص عام,,0,0,0,,هذا ليس كل شيء
Dialogue: 0,0:21:24.60,0:21:26.98,general text,,0,0,0,,هناك سيف آخر هنا لا يمكنك سحبه
Dialogue: 0,0:21:28.65,0:21:32.15,general text,,0,0,0,,منحها الملك الراحل إلى غوانغجو تشانغ جانج
Dialogue: 0,0:21:32.78,0:21:34.36,نص عام,,0,0,0,,أريد أن آخذه أيضًا
Dialogue: 0,0:21:34.45,0:21:37.24,النص العام,,0,0,0,,ولكنها لأبيه
Dialogue: 0,0:21:37.95,0:21:39.66,النص العام,,0,0,0,,السيف عن يمين السيد الشاب
Dialogue: 0,0:21:39.74,0:21:41.29,general text,,0,0,0,,لكنه لم يكن مؤتمناً على هذا السيف أبداً
Dialogue: 0,0:21:42.66,0:21:44.87,general text,,0,0,0,,في السابق تم تخزينه في سوسنوفي بور
Dialogue: 0,0:21:44.96,0:21:47.88,general text,,0,0,0,,لقد أخذتها عندما طُردت من هناك، هل أنا على حق؟
Dialogue: 0,0:21:49.59,0:21:53.09,general text,,0,0,0,,سيحتفظ بها القصر الملكي حتى انتخاب غوانغجو الجديد
Dialogue: 0,0:21:54.93,0:21:56.05,نص عام,,0,0,0,,أحضر لي سيفاً
Dialogue: 0,0:22:03.39,0:22:04.89,نص عام,,0,0,0,,لا أستطيع التخلي عن ذلك
Dialogue: 0,0:22:06.52,0:22:10.32,general text,,0,0,0,,كما تعلمون، لا يعترفون بي كابن لأبيهم
Dialogue: 0,0:22:11.86,0:22:14.61,general text,,0,0,0,,إذا فقدت سيفي أيضًا، فلن ينتهي الأمر جيدًا بالنسبة لي
Dialogue: 0,0:22:15.74,0:22:18.24,نص عام,,0,0,0,,سأحتفظ بها ولو للزينة فقط
Dialogue: 0,0:22:21.87,0:22:23.91,نص عام,,0,0,0,,لا بد لي من اصطحابه،
Dialogue: 0,0:22:24.66,0:22:26.96,النص العام,,0,0,0,,وأنت ترفض. لا شيء للقيام به
Dialogue: 0,0:22:29.29,0:22:30.96,النص العام,,0,0,0,,الفائز يأخذ السيف
Dialogue: 0,0:22:49.02,0:22:51.65,general text,,0,0,0,,أنت لست مدربًا بشكل خاص على القتال من أجل معركة حقيقية
Dialogue: 0,0:22:58.53,0:23:00.70,نص عام,,0,0,0,,هل يمكنك تجاوز هذا الخط،
Dialogue: 0,0:23:01.28,0:23:02.58,نص عام,,0,0,0,,سأغادر
Dialogue: 0,0:23:17.30,0:23:21.93,نص عام,,0,0,0,,أنا متأكد أنك توقعت مني أن أتذلل أمامك
Dialogue: 0,0:23:23.26,0:23:26.60,general text,,0,0,0,,مخالفةك مظهر من مظاهر الغباء
Dialogue: 0,0:23:26.68,0:23:29.31,النص العام,,0,0,0,,إلا أن البعض يعتبر ذلك مظهراً من مظاهر القوة
Dialogue: 0,0:23:29.40,0:23:30.44,نص عام,,0,0,0,,لذلك سأحاول
Dialogue: 0,0:24:23.82,0:24:25.16,ذكريات,,0,0,0,,هذه هي الطاقة
Dialogue: 0,0:24:25.24,0:24:26.54,ذكريات,,0,0,0,,الأمر يتعلق بالضرب
Dialogue: 0,0:24:26.62,0:24:28.66,ذكريات,,0,0,0,,كانت هناك موجة من الطاقة بسببها
Dialogue: 0,0:24:29.54,0:24:30.54,ذكريات,,0,0,0,,سعيد لأنك تعرضت للضرب
Dialogue: 0,0:24:31.17,0:24:34.88,خارج الشاشة,,0,0,0,,حسنًا، يمكنك أن تصل إلى العدد الذي تريده
Dialogue: 0,0:25:54.00,0:25:55.29,نص عام,,0,0,0,,رجوع!
Dialogue: 0,0:25:55.92,0:25:57.67,نص عام,,0,0,0,,احذر! إنها من وعاء الغرفة!
Dialogue: 0,0:26:10.06,0:26:11.60,نص عام,,0,0,0,,ماذا فعلت!
Dialogue: 0,0:26:13.02,0:26:13.89,نص عام,,0,0,0,,من هذا؟
Dialogue: 0,0:26:15.31,0:26:18.15,النص العام,,0,0,0,,- أنا أخدم السيد\N- كيف تجرؤ الخادمة على التدخل؟
Dialogue: 0,0:26:21.86,0:26:23.28,نص عام,,0,0,0,,عذراً سمو الأمير
Dialogue: 0,0:26:23.36,0:26:25.03,نص عام,,0,0,0,,خادمتي وقحة
Dialogue: 0,0:26:27.62,0:26:28.53,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:26:31.33,0:26:33.79,نص عام,,0,0,0,,مقرف
Dialogue: 0,0:26:33.87,0:26:35.87,نص عام,,0,0,0,,اذهب إلى المنزل وغير ملابسك
Dialogue: 0,0:26:36.37,0:26:38.54,النص العام,,0,0,0,,- ماذا؟\N - لقد تجاوزت الخط
Dialogue: 0,0:26:41.63,0:26:44.55,general text,,0,0,0,,بالطبع، لم تكن تريد أن تتسخ، لكن مع ذلك،
Dialogue: 0,0:26:44.63,0:26:45.80,نص عام,,0,0,0,,هذه خسارة
Dialogue: 0,0:26:45.88,0:26:49.26,general text,,0,0,0,,احفظ كلمتك واترك لي سيف والدي.
Dialogue: 0,0:26:50.26,0:26:51.81,خط مائل,,0,0,0,,كما ترون،
Dialogue: 0,0:26:51.89,0:26:54.43,general text,,0,0,0,,لن أتمكن من مرافقتك لأني مصاب بجروح خطيرة
Dialogue: 0,0:27:02.15,0:27:03.44,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:27:04.44,0:27:05.65,مائل,,0,0,0,,حسنًا
Dialogue: 0,0:27:05.74,0:27:07.57,النص العام,,0,0,0,,سأفي بكلمتي وأترك السيف
Dialogue: 0,0:27:08.28,0:27:09.28,نص عام,,0,0,0,,لكن,
Dialogue: 0,0:27:10.37,0:27:11.91,النص العام,,0,0,0,,سأعاقبها
Dialogue: 0,0:27:17.12,0:27:19.71,النص العام,,0,0,0,,لن أسامحها على ملابسها المتسخة
Dialogue: 0,0:28:12.60,0:28:15.14,نص عام,,0,0,0,,لقد استل سيفي...
Dialogue: 0,0:28:29.19,0:28:30.91,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:28:30.99,0:28:33.57,نص عام,,0,0,0,,اعتقدت أنك لا تستطيع إلقاء التعويذات،
Dialogue: 0,0:28:33.66,0:28:35.41,النص العام,,0,0,0,,ولقد خدعتنا جميعاً
Dialogue: 0,0:28:35.99,0:28:36.83,نص عام,,0,0,0,,لا...
Dialogue: 0,0:28:37.45,0:28:39.54,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:28:46.63,0:28:48.05,نص عام,,0,0,0,,أنت!
Dialogue: 0,0:28:48.13,0:28:50.42,general text,,0,0,0,,كيف تجرؤ على رفع سيفك على ولي العهد؟
Dialogue: 0,0:28:50.51,0:28:52.68,general text,,0,0,0,,- لا، هذا ليس أنا\N- المملكة المتحدة، ألقِ سيفك!
Dialogue: 0,0:28:53.68,0:28:55.89,النص العام,,0,0,0,,- اخفضه الآن\N- أحاول
Dialogue: 0,0:28:56.47,0:28:57.47,نص عام,,0,0,0,,لكنني لا أستطيع
Dialogue: 0,0:29:20.87,0:29:22.48,نص عام,,0,0,0,,توقف الآن أيها الغبي!
Dialogue: 0,0:29:23.50,0:29:25.17,نص عام,,0,0,0,,أنا لا أتحكم فيه!
Dialogue: 0,0:29:37.64,0:29:38.64,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:29:39.64,0:29:40.89,نص عام,,0,0,0,,مت!
Dialogue: 0,0:29:50.78,0:29:51.82,نص عام,,0,0,0,,توقف
Dialogue: 0,0:30:00.20,0:30:02.29,النص العام,,0,0,0,,- توقف\N- لا أتحكم في يدي
Dialogue: 0,0:30:02.37,0:30:03.71,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:30:05.12,0:30:07.13,نص عام,,0,0,0,,أنا... لم أقصد أن
Dialogue: 0,0:30:07.63,0:30:10.00,نص عام,,0,0,0,,السيد الشاب!
Dialogue: 0,0:30:17.01,0:30:18.01,نص عام,,0,0,0,,هذا سوار ملزم
Dialogue: 0,0:30:18.10,0:30:20.76,النص العام,,0,0,0,,وزنه سيبقي يدك تحت السيطرة
Dialogue: 0,0:30:27.15,0:30:30.82,خارج الإطار,,0,0,0,,طاقته انسكبت في يد واحدة وكان لا يمكن السيطرة عليها
Dialogue: 0,0:30:32.44,0:30:33.61,نص عام,,0,0,0,,فك قيوده!
Dialogue: 0,0:30:36.16,0:30:37.20,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:30:38.28,0:30:39.41,نص عام,,0,0,0,,أمسك السيف
Dialogue: 0,0:30:41.62,0:30:42.58,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:30:42.66,0:30:44.66,نص عام,,0,0,0,,إنه لا يضاهيك
Dialogue: 0,0:30:44.75,0:30:46.33,نص عام,,0,0,0,,وأنتم على ذلك من الشهود
Dialogue: 0,0:30:46.42,0:30:48.96,general text,,0,0,0,,وجه سيف أبيه نحوي.
Dialogue: 0,0:30:49.04,0:30:51.59,general text,,0,0,0,,هو فقط لم يتحكم في طاقته
Dialogue: 0,0:30:51.67,0:30:54.17,general text,,0,0,0,,- حتى أنه ضربني يا من رأيت\N- اصمت!
Dialogue: 0,0:30:56.18,0:30:58.76,general text,,0,0,0,,صاحب السمو، كنت أول من صوب نصل سيفك نحوه.
Dialogue: 0,0:30:59.35,0:31:01.39,النص العام,,0,0,0,,السيف الذي لوحت به عند الغضب مكسور
Dialogue: 0,0:31:01.47,0:31:03.89,النص العام,,0,0,0,,يجب عليك مراعاة عادات السحرة والعودة إلى القصر
Dialogue: 0,0:31:07.02,0:31:09.98,general text,,0,0,0,,كيف تجرؤ على مقاومة إرادتي؟
Dialogue: 0,0:31:12.40,0:31:16.03,نص عام,,0,0,0,,تشان وجين وسيو وبارك. الأربعة أمامي
Dialogue: 0,0:31:16.95,0:31:19.57,النص العام,,0,0,0,,أرفض الرحيل مهزوماً
Dialogue: 0,0:31:19.66,0:31:20.82,نص عام,,0,0,0,,ماذا ستفعل؟
Dialogue: 0,0:31:22.08,0:31:24.83,النص العام,,0,0,0,,أنتم الأربعة تهاجمون
Dialogue: 0,0:31:32.63,0:31:34.51,نص عام,,0,0,0,,إنه سيء
Dialogue: 0,0:31:34.59,0:31:37.59,general text,,0,0,0,,يبدو أن عائلاتنا ذهبت ضد العائلة المالكة
Dialogue: 0,0:31:37.67,0:31:39.59,خط مائل,,0,0,0,,كل شيء أصبح جديًا
Dialogue: 0,0:31:39.68,0:31:41.26,general text,,0,0,0,,تشو يونغ استفزه
Dialogue: 0,0:31:41.35,0:31:43.01,نص عام,,0,0,0,,ماذا فعلت؟
Dialogue: 0,0:31:43.56,0:31:46.39,النص العام,,0,0,0,,ثم سنعطيه أوكا فقط
Dialogue: 0,0:31:46.48,0:31:47.56,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:31:48.27,0:31:50.69,النص العام,,0,0,0,,هذه هي العائلات الرئيسية لديهو
Dialogue: 0,0:31:51.31,0:31:52.73,النص العام,,0,0,0,,سيغضب الملك،
Dialogue: 0,0:31:52.82,0:31:54.40,نص عام,,0,0,0,,إذا سمع عن هذا القتال
Dialogue: 0,0:31:55.90,0:31:58.24,نص عام,,0,0,0,,وماذا في ذلك؟ هل يجب أن أغادر فحسب؟
Dialogue: 0,0:31:59.45,0:32:01.53,نص عام,,0,0,0,,كان يجب أن توقفني مبكراً
Dialogue: 0,0:32:15.67,0:32:16.63,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:32:25.10,0:32:26.77,نص عام,,0,0,0,,أنا آسف جدًا يا صاحب السمو
Dialogue: 0,0:32:28.14,0:32:31.15,النص العام,,0,0,0,,كيف أجرؤ مثل هذا الجرذ على سكب البراز
Dialogue: 0,0:32:31.23,0:32:32.48,نص عام,,0,0,0,,على ملابسك؟
Dialogue: 0,0:32:37.65,0:32:39.95,نص عام,,0,0,0,,أنا آسف حقًا. جدا
Dialogue: 0,0:32:40.03,0:32:41.16,نص عام,,0,0,0,,ابتعد
Dialogue: 0,0:32:41.24,0:32:43.53,نص عام,,0,0,0,,اختفي. أنت نتن
Dialogue: 0,0:32:44.58,0:32:46.91,نص عام,,0,0,0,,سامحنا
Dialogue: 0,0:32:50.75,0:32:55.54,general text,,0,0,0,,من باب الندم الصادق سأنهي ما تبقى
Dialogue: 0,0:32:56.46,0:32:58.71,نص عام,,0,0,0,,فاغفر لنا
Dialogue: 0,0:33:08.68,0:33:09.64,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:33:11.98,0:33:14.10,نص عام,,0,0,0,,لماذا تشرب؟
Dialogue: 0,0:33:16.86,0:33:17.82,نص عام,,0,0,0,,سيد!
Dialogue: 0,0:33:21.07,0:33:22.61,نص عام,,0,0,0,,يجب أن أشرب هذا
Dialogue: 0,0:33:24.49,0:33:25.82,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:33:27.62,0:33:29.20,نص عام,,0,0,0,,ليس الأمر كذلك
Dialogue: 0,0:33:29.29,0:33:31.12,نص عام,,0,0,0,,لماذا أنت؟
Dialogue: 0,0:33:31.21,0:33:33.71,النص العام,,0,0,0,,أنا السبب في هذا لذا سأشرب
Dialogue: 0,0:33:33.79,0:33:36.63,نص عام,,0,0,0,,إطلاقاً. سموه غاضب مني
Dialogue: 0,0:33:36.71,0:33:38.75,نص عام,,0,0,0,,يجب أن أشرب
Dialogue: 0,0:33:42.38,0:33:44.38,نص عام,,0,0,0,,وهناك الكثير...
Dialogue: 0,0:33:45.22,0:33:47.89,نص عام,,0,0,0,,دعونا نأتي هنا، سأتناول مشروبًا
Dialogue: 0,0:33:47.97,0:33:49.10,general text,,0,0,0,,ثم هل نتشارك؟
Dialogue: 0,0:33:50.43,0:33:52.64,نص عام,,0,0,0,,لماذا تشارك هذا؟
Dialogue: 0,0:33:52.73,0:33:54.06,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:33:54.14,0:33:55.23,نص عام,,0,0,0,,خذ كل شيء
Dialogue: 0,0:33:57.36,0:33:59.53,النص العام,,0,0,0,,ثم سأشرب قليلاً وأعطيك إياه
Dialogue: 0,0:33:59.61,0:34:02.32,النص العام,,0,0,0,,ساعدني على الرفع، يدي لا تستطيع التحرك
الحوار: 0,0:34:06.32,0:34:07.16,نص عام,,0,0,0,,سيد!
Dialogue: 0,0:34:11.83,0:34:13.25,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:34:14.50,0:34:15.46,نص عام,,0,0,0,,الشرب
Dialogue: 0,0:34:16.63,0:34:17.58,نص عام,,0,0,0,,انسى
Dialogue: 0,0:34:17.67,0:34:19.55,نص عام,,0,0,0,,لماذا تحتاجه؟
Dialogue: 0,0:34:19.63,0:34:20.75,نص عام,,0,0,0,,اخرج من هنا
Dialogue: 0,0:34:20.84,0:34:23.09,خط مائل,,0,0,0,,كم عددهم؟
Dialogue: 0,0:34:23.17,0:34:24.80,نص عام,,0,0,0,,هل تريد مني المساعدة؟
Dialogue: 0,0:34:25.43,0:34:27.72,النص العام,,0,0,0,,- بجد؟\N- تعال هنا
Dialogue: 0,0:34:31.39,0:34:32.47,نص عام,,0,0,0,,هذه الحقيقة من القدر...
Dialogue: 0,0:34:35.85,0:34:37.06,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:34:37.15,0:34:39.15,النص العام,,0,0,0,,كيف نجرؤ على التنافس معك؟
Dialogue: 0,0:34:39.86,0:34:41.28,النص العام,,0,0,0,,هل يحتاجون حقًا للشرب
Dialogue: 0,0:34:41.36,0:34:43.61,نص عام,,0,0,0,,هذا الهراء كاعتذار؟
Dialogue: 0,0:34:46.99,0:34:48.37,نص عام,,0,0,0,,إليكم
Dialogue: 0,0:34:49.49,0:34:52.70,نص عام,,0,0,0,,توقف. لقد سئمت منك
Dialogue: 0,0:34:55.16,0:34:56.33,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:34:58.08,0:35:01.46,النص العام,,0,0,0,,سموه يغادر! احنوا رؤوسكم!
Dialogue: 0,0:35:07.18,0:35:09.64,general text,,0,0,0,,لماذا أتى أصلاً؟
Dialogue: 0,0:35:10.26,0:35:12.22,نص عام,,0,0,0,,خلف سيف ناك سو
Dialogue: 0,0:35:12.93,0:35:14.85,نص عام,,0,0,0,,ثم فجأة بدأ القتال
Dialogue: 0,0:35:15.52,0:35:18.35,general text,,0,0,0,,اليوم رحل لكن أعرف شخصيته،
Dialogue: 0,0:35:18.85,0:35:20.52,النص العام,,0,0,0,,سوف ينتقم حتماً
Dialogue: 0,0:35:24.03,0:35:26.36,general text,,0,0,0,,- هل أنت بخير؟\N- لقد ضربني مرات عديدة
Dialogue: 0,0:35:26.45,0:35:28.99,مائل,,0,0,0,,ولقد ضربتني بشدة!
Dialogue: 0,0:35:31.45,0:35:33.16,خط مائل,,0,0,0,,- هل أنت بخير؟\N- أعتقد ذلك
Dialogue: 0,0:35:33.24,0:35:34.49,نص عام,,0,0,0,,- يؤلم\N- هل يؤلم؟
Dialogue: 0,0:35:34.58,0:35:35.91,النص العام,,0,0,0,,- هل هذا مؤلم؟\N- مؤلم هنا
Dialogue: 0,0:35:36.00,0:35:38.58,general text,,0,0,0,,- يؤلمني في كل مكان\N- لا تلمسه
Dialogue: 0,0:35:41.54,0:35:44.38,نص عام,,0,0,0,,صاحب السمو!
Dialogue: 0,0:35:48.34,0:35:49.64,نص عام,,0,0,0,,ماذا تريد؟
Dialogue: 0,0:35:50.51,0:35:53.51,النص العام,,0,0,0,,لقد أتيت من أجل سيف ناك سو، تفضل
Dialogue: 0,0:35:55.39,0:35:56.48,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:35:57.31,0:35:58.85,نص عام,,0,0,0,,جئت لاصطحابه
Dialogue: 0,0:35:58.94,0:36:02.77,نص عام,,0,0,0,,لقد أحضرته حتى لا تضطر إلى العودة مرة أخرى
Dialogue: 0,0:36:02.86,0:36:04.23,نص عام,,0,0,0,,أرجو أن تتقبله
Dialogue: 0,0:36:04.98,0:36:08.28,general text,,0,0,0,,هل تريد أن تقول لي أن آخذ ما جئت من أجله ولا أعود؟
Dialogue: 0,0:36:09.53,0:36:13.58,النص العام,,0,0,0,,أنت ذكي جدًا وبصير وقوي
Dialogue: 0,0:36:13.66,0:36:15.87,general text,,0,0,0,,هل تضحك علي لأنني خسرت؟
Dialogue: 0,0:36:15.95,0:36:18.79,نص عام,,0,0,0,,تخسر؟ لقد حصلت على ما أردت
Dialogue: 0,0:36:18.87,0:36:20.87,نص عام,,0,0,0,,وفقده
Dialogue: 0,0:36:20.96,0:36:23.96,نص عام,,0,0,0,,الفائز هنا هو أنت
Dialogue: 0,0:36:26.46,0:36:30.05,النص العام,,0,0,0,,إنها على حق يا صاحب السمو. لقد فزت
Dialogue: 0,0:36:30.88,0:36:33.10,النص العام,,0,0,0,,مبروك يا صاحب السمو
Dialogue: 0,0:36:35.18,0:36:36.47,نص عام,,0,0,0,,فليكن
Dialogue: 0,0:36:40.44,0:36:42.60,النص العام,,0,0,0,,إلى جانب ذلك، أنت كريم جدًا
Dialogue: 0,0:36:42.69,0:36:45.65,general text,,0,0,0,,ليس هناك شخص نبيل مثلك في العالم
Dialogue: 0,0:36:50.20,0:36:51.36,نص عام,,0,0,0,,ما اسمك؟
Dialogue: 0,0:36:53.49,0:36:55.12,النص العام,,0,0,0,,مو دوك، سموك
Dialogue: 0,0:36:56.28,0:36:57.29,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:36:57.79,0:36:59.62,النص العام,,0,0,0,,لقد سكبت الماء من القدر عليّ
Dialogue: 0,0:36:59.71,0:37:01.33,النص العام,,0,0,0,,من الآن فصاعدا سأناديك وون مو ديوك
Dialogue: 0,0:37:02.00,0:37:05.96,general text,,0,0,0,,مثل اسمك، يا رائحة التراب
Dialogue: 0,0:37:12.59,0:37:14.34,نص عام,,0,0,0,,حتى أنك أعطيتني اسمًا
Dialogue: 0,0:37:14.43,0:37:17.89,نص عام,,0,0,0,,شكرًا جزيلاً على لطفك.
Dialogue: 0,0:37:22.31,0:37:23.69,نص عام,,0,0,0,,إلى اللقاء يا صاحب السمو
Dialogue: 0,0:37:25.77,0:37:26.73,نص عام,,0,0,0,,إلى الأمام
Dialogue: 0,0:37:35.82,0:37:39.33,التعليق الصوتي,,0,0,0,,ما زال طالبي أضعف من أن يقاتلك
Dialogue: 0,0:37:39.41,0:37:43.08,التعليق الصوتي,,0,0,0,,حتى يصبح أقوى، من الأفضل ألا يفسد علاقته معك
Dialogue: 0,0:37:50.21,0:37:53.01,general text,,0,0,0,,من السهل أن تقع في حب الآخرين أو تتقرب منهم.
Dialogue: 0,0:37:53.09,0:37:54.47,نص عام,,0,0,0,,من أجل سيدك؟
Dialogue: 0,0:37:54.55,0:37:57.14,general text,,0,0,0,,لم أستطع قتاله فغمرته بالماء.
Dialogue: 0,0:37:59.14,0:38:02.02,النص العام,,0,0,0,,أنا كريهة الرائحة، من الأفضل ألا تقترب مني
Dialogue: 0,0:38:08.11,0:38:08.94,نص عام,,0,0,0,,امسح نفسك
Dialogue: 0,0:38:12.57,0:38:15.28,general text,,0,0,0,,كيف أجرؤ على تلطيخ شيء الرجل الذي أحبه؟
Dialogue: 0,0:38:16.28,0:38:17.53,نص عام,,0,0,0,,لا، شكرًا
Dialogue: 0,0:38:53.49,0:38:55.53,النص العام,,0,0,0,,لقد أصبحت حقًا نتن مو ديوك
Dialogue: 0,0:39:01.49,0:39:04.37,النص العام,,0,0,0,,أنت تغسل وجهك أيضًا، ربما تكون رائحتك كريهة
Dialogue: 0,0:39:21.43,0:39:24.52,نص عام,,0,0,0,,يا معلم، لقد فعلتها أخيراً
Dialogue: 0,0:39:50.83,0:39:54.92,general text,,0,0,0,,غويغا سُرقت من جينيوون
Dialogue: 0,0:39:56.05,0:39:59.80,general text,,0,0,0,,فقط أفراد عائلة جين هم من يمكنهم فتح هذا الباب
Dialogue: 0,0:40:00.51,0:40:03.76,النص العام,,0,0,0,,لابد أنهم اتصلوا به من الخارج
Dialogue: 0,0:40:05.47,0:40:06.89,النص العام,,0,0,0,,السرقة في جينيوون؟
Dialogue: 0,0:40:06.98,0:40:10.15,general text,,0,0,0,,لقد حزنت على ابنتك الميتة لسنوات،
Dialogue: 0,0:40:10.23,0:40:13.61,نص عام,,0,0,0,,لابد أن هذا قد أضعفك
Dialogue: 0,0:40:14.73,0:40:16.94,نص عام,,0,0,0,,وقاحة وقح
Dialogue: 0,0:40:17.53,0:40:20.99,general text,,0,0,0,,قد تكون غير شرعي، لكنك لا تزال جزءًا من عائلة جين
Dialogue: 0,0:40:21.07,0:40:23.16,general text,,0,0,0,,كيف تجرؤ على التشهير بأختك غير الشقيقة؟
Dialogue: 0,0:40:23.24,0:40:24.37,نص عام,,0,0,0,,الوغد
Dialogue: 0,0:40:24.45,0:40:25.74,نص عام,,0,0,0,,أنا نائب غوانغجو
Dialogue: 0,0:40:25.83,0:40:28.46,نص عام,,0,0,0,,سأكون ممتنًا لو أظهرت المزيد من الاحترام
Dialogue: 0,0:40:36.38,0:40:39.67,نص عام,,0,0,0,,سيدي، من فضلك اخرج إلى الفناء. تشان ووك جاء لرؤيتك
Dialogue: 0,0:41:01.15,0:41:03.11,نص عام,,0,0,0,,لقد منعته من الظهور هنا
Dialogue: 0,0:41:03.20,0:41:06.74,general text,,0,0,0,,لماذا أحضرته معك؟
Dialogue: 0,0:41:07.66,0:41:09.45,نص عام,,0,0,0,,يجب أن ترى شيئًا ما
Dialogue: 0,0:41:16.67,0:41:18.55,نص عام,,0,0,0,,هذا سيف والدي
Dialogue: 0,0:41:19.34,0:41:22.72,italics,,0,0,0,,عندما كنت أصغر سناً قلت إنك ستقبلني إذا استطعت تحمل ذلك
Dialogue: 0,0:41:23.39,0:41:24.34,نص عام,,0,0,0,,هل تتذكر؟
Dialogue: 0,0:42:05.30,0:42:08.01,general text,,0,0,0,,اعتقدت أنه فتح أبواب طاقته مؤخرًا فقط
Dialogue: 0,0:42:08.72,0:42:11.73,general text,,0,0,0,,أرى أنه أتقن تدفق طاقتي
Dialogue: 0,0:42:12.39,0:42:14.48,خط مائل,,0,0,0,,كما تتوقع من ابن تشانغ جانج
Dialogue: 0,0:42:14.56,0:42:16.69,general text,,0,0,0,,لقد أتقن ريوسو في غمضة عين
Dialogue: 0,0:42:17.40,0:42:20.65,نص عام,,0,0,0,,أرجوك خذني إلى مكانك،
Dialogue: 0,0:42:21.48,0:42:22.40,نص عام,,0,0,0,,الرئيسية
Dialogue: 0,0:42:27.24,0:42:28.87,نص عام,,0,0,0,,ماذا في يدك؟
Dialogue: 0,0:42:29.45,0:42:31.70,general text,,0,0,0,,تتركز طاقته في يده اليمنى
Dialogue: 0,0:42:31.79,0:42:33.08,مائل,,0,0,0,,لم يتحكم فيها بعد،
Dialogue: 0,0:42:33.16,0:42:35.12,نص عام,,0,0,0,,فوضعنا عليه سوار تقييد
Dialogue: 0,0:42:46.72,0:42:48.68,نص عام,,0,0,0,,انزعها
Dialogue: 0,0:42:49.60,0:42:52.14,general text,,0,0,0,,إذا نزعناه ستتوقف يده عن الطاعة
Dialogue: 0,0:42:52.22,0:42:55.06,النص العام,,0,0,0,,دعه يصورها لاحقاً بعد التدريب
Dialogue: 0,0:42:56.10,0:42:57.23,نص عام,,0,0,0,,أطلق النار
Dialogue: 0,0:43:23.63,0:43:27.05,نص عام,,0,0,0,,أريد أن أرى كيف تمسك بالسيف
Dialogue: 0,0:43:58.54,0:44:00.46,نص عام,,0,0,0,,اربطوا ذراعه
Dialogue: 0,0:44:13.60,0:44:15.89,نص عام,,0,0,0,,هل أنت... بخير؟
Dialogue: 0,0:44:16.93,0:44:18.85,نص عام,,0,0,0,,ما الفائدة من سحب السيف،
Dialogue: 0,0:44:20.81,0:44:22.56,نص عام,,0,0,0,,إذا كنت لا تستطيع حتى الإمساك به؟
Dialogue: 0,0:44:28.74,0:44:30.66,مائل,,0,0,0,,إنه لا يستطيع السيطرة عليها بعد
Dialogue: 0,0:44:30.74,0:44:32.91,مائل,,0,0,0,,لكنه يتمتع بقوة لا تصدق
Dialogue: 0,0:44:32.99,0:44:34.49,general text,,0,0,0,,حتى أنه هزم ولي العهد
Dialogue: 0,0:44:35.54,0:44:37.91,مائل,,0,0,0,,لقد كسر سيف سموه
Dialogue: 0,0:44:38.50,0:44:40.54,مائل,,0,0,0,,على الرغم من أنه أتقن ريوسو منذ فترة طويلة
Dialogue: 0,0:44:40.62,0:44:42.17,خط مائل,,0,0,0,,فازت المملكة المتحدة
Dialogue: 0,0:44:43.71,0:44:45.92,النص العام,,0,0,0,,جين تشو يونغ، لا تتدخل
Dialogue: 0,0:44:47.09,0:44:48.46,نص عام,,0,0,0,,نعم يا أمي
Dialogue: 0,0:44:49.34,0:44:54.10,general text,,0,0,0,,المملكة المتحدة، هل وجهت سيفك حقًا إلى ولي العهد؟
Dialogue: 0,0:44:54.68,0:44:56.43,النص العام,,0,0,0,,بدأت المملكة المتحدة بالقتال
Dialogue: 0,0:44:56.51,0:44:58.39,النص العام,,0,0,0,,وجهت سيفك نحو ولي العهد؟!
Dialogue: 0,0:45:00.44,0:45:01.52,نص عام,,0,0,0,,نعم
Dialogue: 0,0:45:02.81,0:45:05.52,general text,,0,0,0,,أراد سموه أن يأخذ سيف غوانغجو
Dialogue: 0,0:45:05.61,0:45:07.48,نص عام,,0,0,0,,لقد كان خلافاً
Dialogue: 0,0:45:08.19,0:45:10.15,مائل,,0,0,0,,حتى ولي العهد سامحه
Dialogue: 0,0:45:11.36,0:45:15.66,مائل,,0,0,0,,سيف سموه مكسور، لكن المملكة المتحدة ما زالت تصوب سيفه نحوه!
Dialogue: 0,0:45:15.74,0:45:18.58,نص عام,,0,0,0,,عرض حياة ولي العهد للخطر
Dialogue: 0,0:45:18.66,0:45:19.66,نص عام,,0,0,0,,كنا هناك أيضًا
Dialogue: 0,0:45:20.79,0:45:21.87,نص عام,,0,0,0,,تمكنا من إيقافه
Dialogue: 0,0:45:21.96,0:45:24.00,general text,,0,0,0,,هذا يعني أنكم الأربعة شاهدتم،
Dialogue: 0,0:45:24.08,0:45:26.25,نص عام,,0,0,0,,كيف سخروا من سموه
Dialogue: 0,0:45:28.71,0:45:31.72,general text,,0,0,0,,هذه إهانة للعائلة المالكة!
Dialogue: 0,0:45:34.72,0:45:36.51,نص عام,,0,0,0,,احبس تشان ووك
Dialogue: 0,0:45:39.39,0:45:41.56,نص عام,,0,0,0,,إنه أمر خطير ولا يمكن السيطرة عليه
Dialogue: 0,0:45:41.64,0:45:42.77,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:46:02.21,0:46:04.17,نص عام,,0,0,0,,كان الأمر يستحق فتح أبواب الطاقة،
Dialogue: 0,0:46:04.25,0:46:08.17,نص عام,,0,0,0,,كيف بدأ تشانغ ووك بتهديد ولي العهد
Dialogue: 0,0:46:11.17,0:46:14.01,النص العام,,0,0,0,,لن يترك تشونبوغوان هذا الأمر بهذه السهولة
Dialogue: 0,0:47:14.07,0:47:16.86,general text,,0,0,0,,لم تعالج جرحك بعد، لقد فقدت الكثير من الدماء.
Dialogue: 0,0:47:19.24,0:47:21.62,نص عام,,0,0,0,,كيف حال يدك؟
Dialogue: 0,0:47:25.33,0:47:27.54,النص العام,,0,0,0,,السوار لا يسمح لها بالتحرك
Dialogue: 0,0:47:28.37,0:47:29.63,نص عام,,0,0,0,,لكنني بخير
Dialogue: 0,0:47:31.38,0:47:34.55,general text,,0,0,0,,لقد تمكنت من إتقان تدفق الطاقة من المعلم هو يوم
Dialogue: 0,0:47:34.63,0:47:36.13,نص عام,,0,0,0,,في مثل هذا الوقت القصير
Dialogue: 0,0:47:37.30,0:47:38.51,نص عام,,0,0,0,,أنا معجب حقًا
Dialogue: 0,0:47:41.14,0:47:43.06,general text,,0,0,0,,في البداية كان جسدي يحترق بالنار،
Dialogue: 0,0:47:43.64,0:47:46.10,النص العام,,0,0,0,,وبعد ذلك بدا وكأنه مغطى بالجليد
Dialogue: 0,0:47:47.85,0:47:50.10,general text,,0,0,0,,كيف حال جروحك من الضرب؟
Dialogue: 0,0:47:50.19,0:47:51.52,النص العام,,0,0,0,,هل يؤلمون؟
Dialogue: 0,0:47:54.36,0:47:58.40,general text,,0,0,0,,يبدو أن الضرب ساعد على تجميع الطاقة
Dialogue: 0,0:48:00.36,0:48:02.49,نص عام,,0,0,0,,وجه لي ولي العهد العديد من الضربات،
Dialogue: 0,0:48:04.45,0:48:07.58,النص العام,,0,0,0,,بعد ذلك شعرت بموجة من الطاقة
Dialogue: 0,0:48:07.66,0:48:09.04,النص العام,,0,0,0,,وبعد ذلك تمكنت من الحصول على السيف
Dialogue: 0,0:48:11.42,0:48:12.42,نص عام,,0,0,0,,لا عجب
Dialogue: 0,0:48:13.17,0:48:17.59,النص العام,,0,0,0,,لقد تعلمت دائمًا كل شيء بشكل أسرع من الآخرين
Dialogue: 0,0:48:18.76,0:48:22.60,خط مائل,,0,0,0,,لقد تعلمت المشي والجري قبل دان جو بكثير
Dialogue: 0,0:48:23.39,0:48:25.68,نص عام,,0,0,0,,وبدأت بالحديث مبكراً
Dialogue: 0,0:48:26.85,0:48:28.27,نص عام,,0,0,0,,أتذكر هذا
Dialogue: 0,0:48:29.06,0:48:32.52,general text,,0,0,0,,حتى اكتشفت أن بوابات الطاقة الخاصة بي مغلقة،
Dialogue: 0,0:48:34.15,0:48:36.65,النص العام,,0,0,0,,ظننت أنني سأصبح أقوى شخص
Dialogue: 0,0:48:42.03,0:48:43.28,نص عام,,0,0,0,,المملكة المتحدة
Dialogue: 0,0:48:44.74,0:48:48.79,general text,,0,0,0,,أنت ذكي وتتعلم كل شيء بسرعة
Dialogue: 0,0:48:51.29,0:48:55.59,general text,,0,0,0,,ربما تصبح تاجرًا، وتتعلم كيفية ممارسة الأعمال التجارية؟
Dialogue: 0,0:48:56.17,0:49:00.84,general text,,0,0,0,,أو سيأخذه المعلم هو يوم كطالب ويعلمه الطب
Dialogue: 0,0:49:05.64,0:49:06.68,نص عام,,0,0,0,,أنا أرفض
Dialogue: 0,0:49:09.73,0:49:12.98,general text,,0,0,0,,سوف أتدرب في جيونجينغاك وأصبح ساحرًا
Dialogue: 0,0:49:13.65,0:49:14.73,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:49:15.69,0:49:18.40,general text,,0,0,0,,لأن هذا ما فعله والدك؟
Dialogue: 0,0:49:20.32,0:49:23.49,general text,,0,0,0,,هل تريد أن تصبح غوانغجو جيونبوغوان التالي؟
Dialogue: 0,0:49:24.16,0:49:26.91,النص العام,,0,0,0,,نعم وسأصبح واحدًا
Dialogue: 0,0:49:27.99,0:49:29.62,نص عام,,0,0,0,,سوف آخذ مكانه
Dialogue: 0,0:49:29.70,0:49:32.75,general text,,0,0,0,,وسأثبت لهؤلاء الأوغاد الذين لم يصدقوا أنني ابنه
Dialogue: 0,0:49:34.33,0:49:36.25,general text,,0,0,0,,- سأسكتهم جميعاً{\i1}\N- أنت...
Dialogue: 0,0:49:38.46,0:49:39.96,نص عام,,0,0,0,,ليس ابنًا
Dialogue: 0,0:49:41.22,0:49:42.30,نص عام,,0,0,0,,تشان غان
Dialogue: 0,0:49:45.64,0:49:46.93,خط مائل,,0,0,0,,أنت
Dialogue: 0,0:49:47.64,0:49:50.85,نص عام,,0,0,0,,ثمرة خيانة والدتك
Dialogue: 0,0:49:52.94,0:49:56.31,مائل,,0,0,0,,لقد قبلناك في عائلة تشان لإظهار الاحترام لوالدتك الراحلة
Dialogue: 0,0:49:56.40,0:49:59.19,مائل,,0,0,0,,لكن لا يمكننا أن نسمح لك بأن تصبح رئيس جيونبوغوان
Dialogue: 0,0:49:59.28,0:50:02.40,النص العام,,0,0,0,,فتوقف عن الحلم باتباع الخطى
Dialogue: 0,0:50:05.45,0:50:06.41,نص عام,,0,0,0,,والده
Dialogue: 0,0:50:07.87,0:50:11.20,خط مائل,,0,0,0,,تبقى وريثاً جاهلاً
Dialogue: 0,0:50:11.91,0:50:14.46,خط مائل,,0,0,0,,عائلة تشان
Dialogue: 0,0:50:16.33,0:50:17.46,نص عام,,0,0,0,,وبعد ذلك
Dialogue: 0,0:50:19.21,0:50:21.30,نص عام,,0,0,0,,سنستمر في الاعتناء بك
Dialogue: 0,0:50:28.97,0:50:30.06,نص عام,,0,0,0,,ثم...
Dialogue: 0,0:50:33.23,0:50:34.85,نص عام,,0,0,0,,إذن من هو والدي؟
Dialogue: 0,0:50:37.61,0:50:41.48,النص العام,,0,0,0,,كيف نعرف مع من والدتك الراحلة؟
Dialogue: 0,0:50:44.15,0:50:45.91,نص عام,,0,0,0,,خدعته؟
Dialogue: 0,0:51:20.40,0:51:24.15,general text,,0,0,0,,أوكا لديه الكثير من الأفكار في رأسه الآن، دعه وشأنه
Dialogue: 0,0:51:30.87,0:51:32.74,نص عام,,0,0,0,,تأكد من أنه يأكل كل شيء
Dialogue: 0,0:51:42.55,0:51:45.42,general text,,0,0,0,,أمرتني العذراء كيم بالتأكد من أنك تأكل كل شيء
Dialogue: 0,0:51:49.09,0:51:50.47,general text,,0,0,0,,هل وبخك مرة أخرى؟
Dialogue: 0,0:51:52.81,0:51:55.35,نص عام,,0,0,0,,ظننتك معتادة على التوبيخ...
Dialogue: 0,0:52:07.70,0:52:08.86,نص عام,,0,0,0,,ليس لي علاقة بالموضوع
Dialogue: 0,0:52:08.95,0:52:12.24,general text,,0,0,0,,ربما لم يصلحوا المقطع بعد بعد تلك الحادثة
Dialogue: 0,0:52:14.95,0:52:15.87,نص عام,,0,0,0,,لا تتحرك
Dialogue: 0,0:52:17.66,0:52:19.00,نص عام,,0,0,0,,فقط قف هناك
Dialogue: 0,0:52:22.75,0:52:24.80,نص عام,,0,0,0,,كل شيء يمكن أن ينهار
Dialogue: 0,0:52:27.21,0:52:28.80,نص عام,,0,0,0,,لذا قف ساكنًا
Dialogue: 0,0:52:41.69,0:52:44.69,general text,,0,0,0,,لماذا لم تتهرب من السيف؟
Dialogue: 0,0:52:45.73,0:52:46.78,نص عام,,0,0,0,,هذا بسبب
Dialogue: 0,0:52:47.28,0:52:49.74,general text,,0,0,0,,هل كنت بحاجة إلى سبب آخر لطرده؟
Dialogue: 0,0:52:50.78,0:52:52.78,نص عام,,0,0,0,,أنا أستحق ذلك
Dialogue: 0,0:52:52.87,0:52:56.45,النص العام,,0,0,0,,على كل حال لقد كسرت قلبه
Dialogue: 0,0:52:58.04,0:53:02.33,general text,,0,0,0,,لا بد أن كسر قلبه كان يؤلمه أكثر من تلقي ضربة.
Dialogue: 0,0:53:04.17,0:53:05.29,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:53:06.13,0:53:11.13,general text,,0,0,0,,قلت أن هناك شائعات بأنني والد أوكا؟
Dialogue: 0,0:53:11.68,0:53:13.59,نص عام,,0,0,0,,ماذا لو قلت،
Dialogue: 0,0:53:14.26,0:53:18.35,نص عام,,0,0,0,,أنني والده حقاً؟
Dialogue: 0,0:53:22.14,0:53:24.36,نص عام,,0,0,0,,سأترك منصبي
Dialogue: 0,0:53:25.98,0:53:28.32,نص عام,,0,0,0,,سأبدأ عملاً صغيراً
Dialogue: 0,0:53:29.53,0:53:31.65,نص عام,,0,0,0,,وسأبدأ التداول مع Ukom
Dialogue: 0,0:53:32.24,0:53:34.99,النص العام,,0,0,0,,سوسنوفوي بور بحاجة إلى فصل
Dialogue: 0,0:53:37.03,0:53:38.58,نص عام,,0,0,0,,أو ربما نقول،
Dialogue: 0,0:53:39.50,0:53:41.54,نص عام,,0,0,0,,أنني والدته؟
Dialogue: 0,0:53:42.33,0:53:43.54,نص عام,,0,0,0,,أعتقد أنه سيكون أفضل،
Dialogue: 0,0:53:43.62,0:53:47.09,general text,,0,0,0,,إذا ذهبنا أنا ووك إلى قريتي، حيث نشأنا مع السيدة دو هوا
Dialogue: 0,0:53:49.59,0:53:52.30,نص عام,,0,0,0,,هذا لن يحدث
Dialogue: 0,0:53:53.93,0:53:58.43,نص عام,,0,0,0,,ووك يشبه دو هوا، لذا
Dialogue: 0,0:53:59.56,0:54:01.85,نص عام,,0,0,0,,إنه جميل جدًا
Dialogue: 0,0:54:02.94,0:54:04.15,نص عام,,0,0,0,,من يصدق ذلك
Dialogue: 0,0:54:06.44,0:54:08.02,نص عام,,0,0,0,,أنك والدته؟
Dialogue: 0,0:54:10.23,0:54:11.24,نص عام,,0,0,0,,توقف
Dialogue: 0,0:54:12.03,0:54:15.87,general text,,0,0,0,,فإذا كنت والدته لكان مخيفاً؟
Dialogue: 0,0:54:16.87,0:54:19.24,general text,,0,0,0,,لهذا السبب، لا يمكنك أن تكون والده أيضًا
Dialogue: 0,0:54:19.33,0:54:20.83,نص عام,,0,0,0,,بالطبع أستطيع
Dialogue: 0,0:54:21.58,0:54:24.04,مائل,,0,0,0,,تشانغ جانج وأنا نواكب دائمًا،
Dialogue: 0,0:54:28.29,0:54:30.71,نص عام,,0,0,0,,عندما يتعلق الأمر بالمظهر
Dialogue: 0,0:54:33.84,0:54:34.97,نص عام,,0,0,0,,لا لقد خسرت
Dialogue: 0,0:54:35.55,0:54:37.09,مائل,,0,0,0,,أنت حتى لا تقف بجانبه
Dialogue: 0,0:54:37.18,0:54:41.31,general text,,0,0,0,,هل قالت هوا إنها تحب كل شيء فيك باستثناء مظهرك؟
Dialogue: 0,0:54:41.39,0:54:43.56,نص عام,,0,0,0,,لا تختلق الأمور!
Dialogue: 0,0:54:44.77,0:54:46.60,general text,,0,0,0,,أنت لم تجفل حتى عندما ضربتك بالسيف
Dialogue: 0,0:54:46.69,0:54:48.98,general text,,0,0,0,,لكن أعتقد أن سماع أنك مخيف أكثر إيلاماً
Dialogue: 0,0:54:49.06,0:54:50.32,نص عام,,0,0,0,,رنا
Dialogue: 0,0:54:51.86,0:54:53.86,نص عام,,0,0,0,,يؤلمني كثيراً
Dialogue: 0,0:54:53.94,0:54:55.61,نص عام,,0,0,0,,أنت لا تتظاهر؟
Dialogue: 0,0:54:55.70,0:54:58.24,النص العام,,0,0,0,,لا تتحرك وإلا سينفتح الجرح
Dialogue: 0,0:55:00.28,0:55:01.49,نص عام,,0,0,0,,نحن نشارك
Dialogue: 0,0:55:03.70,0:55:05.75,نص عام,,0,0,0,,نفس الألم
Dialogue: 0,0:55:07.25,0:55:09.84,خط مائل,,0,0,0,,مرفوض من الناس,
Dialogue: 0,0:55:09.92,0:55:12.42,خط مائل,,0,0,0,,الذين كانوا محبوبين
Dialogue: 0,0:55:12.92,0:55:14.34,نص عام,,0,0,0,,هيا بنا
Dialogue: 0,0:55:15.59,0:55:17.01,نص عام,,0,0,0,,دعونا لا نؤذي بعضنا البعض
Dialogue: 0,0:55:18.80,0:55:22.39,نص عام,,0,0,0,,أعترف أنني لم أرغب في الإساءة إليك
Dialogue: 0,0:55:22.47,0:55:23.85,نص عام,,0,0,0,,أنت...
Dialogue: 0,0:55:25.98,0:55:26.98,نص عام,,0,0,0,,كرا...
Dialogue: 0,0:55:30.19,0:55:31.27,نص عام,,0,0,0,,كرا...
Dialogue: 0,0:55:32.53,0:55:34.03,نص عام,,0,0,0,,جميل
Dialogue: 0,0:55:36.40,0:55:40.45,نص عام,,0,0,0,,وأنت أيضاً أيتها الخادمة كيم،
Dialogue: 0,0:55:41.74,0:55:42.95,نص عام,,0,0,0,,كرا...
Dialogue: 0,0:55:44.08,0:55:47.29,نص عام,,0,0,0,,جميل...أنا
Dialogue: 0,0:55:55.01,0:55:57.97,نص عام,,0,0,0,,دعني أنفث على جرحك
Dialogue: 0,0:55:58.63,0:55:59.84,نص عام,,0,0,0,,إنه مؤلم
Dialogue: 0,0:56:03.26,0:56:04.93,نص عام,,0,0,0,,أدناه مباشرة
Dialogue: 0,0:56:05.02,0:56:06.56,نص عام,,0,0,0,,نعم نعم هناك
Dialogue: 0,0:56:18.11,0:56:19.53,ذكريات بخط مائل,,0,0,0,,يبدو أن التميمة موجودة في تشويسونجرو
Dialogue: 0,0:56:19.61,0:56:21.62,ذكريات,,0,0,0,,يخص تشان ووك
Dialogue: 0,0:56:22.91,0:56:23.91,ذكريات,,0,0,0,,تشان ووك؟
Dialogue: 0,0:56:23.99,0:56:26.79,ذكريات,,0,0,0,,لقد عوقب مؤخرًا لأنه فقد تميمة
Dialogue: 0,0:56:26.87,0:56:30.62,ذكريات,,0,0,0,,وسمعت أن خادمته كثيراً ما تذهب إلى ذلك المكان
Dialogue: 0,0:56:33.67,0:56:36.46,خلف الكواليس,,0,0,0,,هذه الفتاة من سوسنوفي بور هي خادمته،
Dialogue: 0,0:56:37.67,0:56:40.84,تعليق صوتي,,0,0,0,,وكانت في الحانة ذلك اليوم
Dialogue: 0,0:56:43.22,0:56:44.51,نص عام,,0,0,0,,هل يمكن أن تكون كذلك؟
Dialogue: 0,0:56:45.47,0:56:46.47,نص عام,,0,0,0,,ناك سو؟
Dialogue: 0,0:56:50.52,0:56:53.69,general text,,0,0,0,,هل ما زلنا بعيدين عن جيونبوغوان؟
Dialogue: 0,0:56:57.11,0:57:00.45,نص عام,,0,0,0,,بهذا المعدل سأتحول إلى حجر
Dialogue: 0,0:57:01.32,0:57:03.07,نص عام,,0,0,0,,سنسرع فاصبر
Dialogue: 0,0:57:03.62,0:57:05.53,نص عام,,0,0,0,,لا يمكنك أن تفقد السيطرة الآن
Dialogue: 0,0:57:06.41,0:57:09.00,نص عام,,0,0,0,,سيدي، هل أنت بخير؟
Dialogue: 0,0:57:36.98,0:57:39.61,نص عام,,0,0,0,,العودة إلى الوراء
Dialogue: 0,0:58:00.30,0:58:04.89,مائل,,0,0,0,,يدك... لقد فهمت ريوسا هكذا
Dialogue: 0,0:58:04.97,0:58:07.39,نص عام,,0,0,0,,وقت قصير
Dialogue: 0,0:58:08.76,0:58:11.98,خط مائل,,0,0,0,,أنت ذكي مثل والدك
Dialogue: 0,0:58:14.85,0:58:16.31,خط مائل,,0,0,0,,جين مو من جيونبوغوان
Dialogue: 0,0:58:16.40,0:58:20.32,general text,,0,0,0,,بدأ الجدال فقط لأنه أدرك أن منصب غوانغجو لن يحدث له
Dialogue: 0,0:58:20.40,0:58:22.57,مائل,,0,0,0,,لقد أدرك أنك،
Dialogue: 0,0:58:22.65,0:58:25.70,مائل,,0,0,0,,الابن الأكبر لعائلة تشان، هل ستتخذ هذا المنصب؟
Dialogue: 0,0:58:34.29,0:58:37.17,نص عام,,0,0,0,,جرح العم ليس عميقاً
Dialogue: 0,0:58:37.25,0:58:38.71,نص عام,,0,0,0,,لا تقلق عليه
Dialogue: 0,0:58:38.79,0:58:42.26,نص عام,,0,0,0,,سأتحدث إلى جين مو
Dialogue: 0,0:58:42.34,0:58:43.38,مائل,,0,0,0,,حسنًا؟
Dialogue: 0,0:58:49.43,0:58:50.93,نص عام,,0,0,0,,اعتني به
Dialogue: 0,0:59:19.38,0:59:21.34,general text,,0,0,0,,عندما تكون في الجوار، تكون المملكة المتحدة دائمًا في خطر
Dialogue: 0,0:59:23.01,0:59:24.67,general text,,0,0,0,,كنت معه عندما شرب السم
Dialogue: 0,0:59:24.76,0:59:27.59,general text,,0,0,0,,وعندما تصارع مع ولي العهد
Dialogue: 0,0:59:29.80,0:59:33.39,general text,,0,0,0,,فهل تريد أن تفرقنا؟
Dialogue: 0,0:59:33.47,0:59:34.68,نص عام,,0,0,0,,لا أستطيع أن أفعل هذا
Dialogue: 0,0:59:38.02,0:59:40.23,نص عام,,0,0,0,,لقد حصل دائمًا على ما يريد
Dialogue: 0,0:59:40.86,0:59:42.65,general text,,0,0,0,,وخاطرت بحياتك لإنقاذه
Dialogue: 0,0:59:49.32,0:59:51.20,النص العام,,0,0,0,,هذا سيف والده
Dialogue: 0,0:59:51.28,0:59:52.99,نص عام,,0,0,0,,خذها
Dialogue: 0,1:00:21.44,1:00:23.48,نص عام,,0,0,0,,لا أستطيع النظر إلى هذا بعد الآن!
Dialogue: 0,1:00:23.57,1:00:25.23,نص عام,,0,0,0,,إلى متى ستندم على نفسك؟
Dialogue: 0,1:00:32.20,1:00:33.41,مائل,,0,0,0,,انهض
Dialogue: 0,1:00:45.67,1:00:48.84,general text,,0,0,0,,لقد تلقيت طاقة هائلة وتمكنت من التعامل معها
Dialogue: 0,1:00:49.59,1:00:53.39,مائل,,0,0,0,,يحتاج الناس إلى 10 سنوات للقيام بذلك، لقد استغرق الأمر منك 10 أيام
Dialogue: 0,1:00:53.47,1:00:55.47,نص عام,,0,0,0,,- تدريبنا...\N- إنسى الأمر
Dialogue: 0,1:00:55.56,1:00:56.97,نص عام,,0,0,0,,لا أريد!
Dialogue: 0,1:00:59.98,1:01:01.69,general text,,0,0,0,,ترفض بسبب بضع كلمات من بارك جين؟
Dialogue: 0,1:01:02.44,1:01:04.52,مائل,,0,0,0,,فلم تكن القوة بل الغباء
Dialogue: 0,1:01:04.61,1:01:07.48,النص العام,,0,0,0,,لا عجب أنك يائس جدًا. أنت ضعيف جداً!
Dialogue: 0,1:01:07.57,1:01:10.36,النص العام,,0,0,0,,نعم أنا ضعيف، لذا لن أفعل أي شيء
Dialogue: 0,1:01:10.45,1:01:11.91,نص عام,,0,0,0,,اصمت فحسب
Dialogue: 0,1:01:13.70,1:01:15.33,نص عام,,0,0,0,,أغلق فمك ولا تضايقني
Dialogue: 0,1:01:23.17,1:01:25.38,نص عام,,0,0,0,,لست بحاجة إلى طالب غير نشط
Dialogue: 0,1:01:29.72,1:01:31.30,نص عام,,0,0,0,,إذن لا تكن أستاذي،
Dialogue: 0,1:01:32.43,1:01:33.93,نص عام,,0,0,0,,سوف تكوني خادمتي
Dialogue: 0,1:01:35.01,1:01:36.93,النص العام,,0,0,0,,إذا أغضبتني مرة أخرى سأبيعه
Dialogue: 0,1:02:16.09,1:02:17.22,نص عام,,0,0,0,,سيد.
Dialogue: 0,1:02:19.43,1:02:24.06,النص العام,,0,0,0,,المالك قلق للغاية لدرجة أنه لا يشرب حتى الماء
Dialogue: 0,1:02:24.14,1:02:26.10,نص عام,,0,0,0,,المساعدة من فضلك
Dialogue: 0,1:02:26.19,1:02:27.77,نص عام,,0,0,0,,ولكن ماذا يمكنني أن أفعل؟
Dialogue: 0,1:02:28.44,1:02:30.28,النص العام,,0,0,0,,من الأفضل أن ننتظر عمي ليرتب كل شيء
Dialogue: 0,1:02:30.36,1:02:33.61,نص عام,,0,0,0,,قال السيد هو يوم إنه سيساعدك
Dialogue: 0,1:02:33.70,1:02:37.41,general text,,0,0,0,,اطلب منه أن يجتمع سريعًا مع جين مو ويضع حدًا لهذا الأمر.
Dialogue: 0,1:02:42.16,1:02:46.83,general text,,0,0,0,,لقد جئت إليك لأنني قلقة بشأن مدى صغر حجمك
Dialogue: 0,1:02:46.92,1:02:49.34,نص عام,,0,0,0,,لم يضخم المشكلة
Dialogue: 0,1:02:49.42,1:02:53.80,general text,,0,0,0,,كيف يمكن أن يكون تهديد حياة ولي العهد شيئاً صغيراً؟
Dialogue: 0,1:02:56.34,1:02:59.51,general text,,0,0,0,,فحبسه قائدنا
Dialogue: 0,1:03:00.14,1:03:02.89,النص العام,,0,0,0,,غابة الصنوبر ستعاقبه
Dialogue: 0,1:03:02.98,1:03:05.81,general text,,0,0,0,,عندما يتعلق الأمر بالعائلة المالكة، يجب ألا تتدخل غابة الصنوبر
Dialogue: 0,1:03:06.52,1:03:10.27,general text,,0,0,0,,هذه مسؤولية جيونبوغوان، وسوف نعاقبه بأنفسنا
Dialogue: 0,1:03:11.02,1:03:13.15,نص عام,,0,0,0,,وماذا ستفعل؟
Dialogue: 0,1:03:13.24,1:03:17.07,نص عام,,0,0,0,,هدد ولي العهد فيجب إعدامه
Dialogue: 0,1:03:19.28,1:03:23.16,general text,,0,0,0,,لكننا لا نستطيع قتل الابن الوحيد لغوانغجو
Dialogue: 0,1:03:23.83,1:03:27.67,general text,,0,0,0,,فلنقطع اليد التي صوبت السيف نحو الأمير
Dialogue: 0,1:03:28.33,1:03:30.25,مائل,,0,0,0,,أقطع يدك؟
Dialogue: 0,1:03:30.34,1:03:31.88,نص عام,,0,0,0,,ربما شعرت بالإهانة من ذلك،
Dialogue: 0,1:03:31.96,1:03:34.21,مائل,,0,0,0,,أن تلميذك لم يتمكن من هزيمة أوكا،
Dialogue: 0,1:03:34.30,1:03:37.01,نص عام,,0,0,0,,أبواب الطاقة التي فُتحت منذ عشرة أيام فقط
Dialogue: 0,1:03:37.09,1:03:39.89,مائل,,0,0,0,,أيها الغبي، أنا هنا أحاول إنقاذ سمعتك وسمعة الأمير
Dialogue: 0,1:03:39.97,1:03:42.22,نص عام,,0,0,0,,كنت سأكون لطيفًا
Dialogue: 0,1:03:42.31,1:03:43.93,نص عام,,0,0,0,,لكنك مجنون تمامًا!
Dialogue: 0,1:03:44.02,1:03:47.77,general text,,0,0,0,,دع جيونغبوجوان يقرر ما إذا كنت مجنونًا أم تشان ووك
Dialogue: 0,1:03:47.85,1:03:50.90,النص العام,,0,0,0,,- أيها اللقيط...\N- سيدي، بهدوء
Dialogue: 0,1:03:52.65,1:03:55.32,general text,,0,0,0,,كان قتالهم بالتراضي
Dialogue: 0,1:03:55.90,1:03:58.28,general text,,0,0,0,,الخادمة أوكا هي المسؤولة عما حدث
Dialogue: 0,1:04:01.24,1:04:03.04,نص عام,,0,0,0,,كانت المعركة عادلة
Dialogue: 0,1:04:04.24,1:04:08.92,general text,,0,0,0,,إذا كنت لا تصدقنا، دعهم يقاتلون مرة أخرى
Dialogue: 0,1:04:13.17,1:04:16.76,نص عام,,0,0,0,,مرة أخرى؟ فكرة جيدة
Dialogue: 0,1:04:18.26,1:04:21.26,general text,,0,0,0,,بما أنك تدعي أن المملكة المتحدة لم تهدد ولي العهد،
Dialogue: 0,1:04:21.35,1:04:22.93,نص عام,,0,0,0,,وكان القتال عادلاً،
Dialogue: 0,1:04:23.81,1:04:26.77,نص عام,,0,0,0,,لتقام المباراة الرسمية
Dialogue: 0,1:04:27.39,1:04:29.69,general text,,0,0,0,,مبارزة بين المملكة المتحدة والأمير؟
Dialogue: 0,1:04:30.27,1:04:33.23,النص العام,,0,0,0,,إذا كنت لا تستطيع قبول هذا، أعطنا أوكا
Dialogue: 0,1:04:33.32,1:04:34.73,نص عام,,0,0,0,,لكن إذا وافقتم،
Dialogue: 0,1:04:34.82,1:04:39.24,النص العام,,0,0,0,,لن نحاسب أحداً حتى لو مات أحدهم
Dialogue: 0,1:04:40.11,1:04:42.49,نص عام,,0,0,0,,وفقًا لعادات سحرة ديهو
Dialogue: 0,1:04:53.42,1:04:56.21,general text,,0,0,0,,لقد جئنا لنكتشف كل شيء، وما هي النتيجة النهائية؟
Dialogue: 0,1:04:56.80,1:05:00.97,النص العام,,0,0,0,,لقد كان الثعبان تحت الماء هو الذي تغلب عليّ
Dialogue: 0,1:05:01.05,1:05:04.05,general text,,0,0,0,,المملكة المتحدة ستموت في معركة رسمية. ماذا يجب أن نفعل؟
الحوار: 0,1:05:04.14,1:05:05.43,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,1:05:05.51,1:05:07.85,نص عام,,0,0,0,,ولي العهد لن يقبل التحدي
Dialogue: 0,1:05:08.93,1:05:11.48,general text,,0,0,0,,منذ أن أسس المعلم سو كيونغ غابة الصنوبر،
Dialogue: 0,1:05:11.56,1:05:14.94,النص العام,,0,0,0,,العائلة المالكة والسحرة لم يتنافسوا
Dialogue: 0,1:05:15.02,1:05:16.53,نص عام,,0,0,0,,التزم الطرفان
Dialogue: 0,1:05:16.61,1:05:21.49,نص عام,,0,0,0,,لهذه القاعدة غير المعلنة، حتى لا تهدر الطاقة
Dialogue: 0,1:05:22.07,1:05:23.16,نص عام,,0,0,0,,لا يمكن أن يكون كذلك،
Dialogue: 0,1:05:23.24,1:05:26.62,نص عام,,0,0,0,,ليكسر ولي العهد هذه القواعد ويخالف أوكا
Dialogue: 0,1:05:35.63,1:05:37.34,نص عام,,0,0,0,,يرجى قبول التحدي
Dialogue: 0,1:05:38.51,1:05:42.72,general text,,0,0,0,,لا أفهم لماذا علي أن أعارض سوسنوفي بور بسبب هذا الغبي
Dialogue: 0,1:05:42.80,1:05:46.81,general text,,0,0,0,,لقد فعلوا ذلك بأنفسهم حتى لا يوجهوا أصابع الاتهام إلينا
Dialogue: 0,1:05:46.89,1:05:51.18,النص العام,,0,0,0,,أظهر لسوسنوفي بور مدى قوتك
Dialogue: 0,1:06:11.33,1:06:13.42,نص عام,,0,0,0,,الحرس الملكي وشعب جيونبوغوان
Dialogue: 0,1:06:14.00,1:06:15.17,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,1:06:15.79,1:06:17.79,نص عام,,0,0,0,,بارك الله فيك يا سيد هو
Dialogue: 0,1:06:18.59,1:06:20.55,نص عام,,0,0,0,,قال لن يحدث ذلك
Dialogue: 0,1:06:20.63,1:06:22.30,خط مائل,,0,0,0,,ولكن انظر
Dialogue: 0,1:06:23.18,1:06:24.72,نص عام,,0,0,0,,ماذا يجب أن نفعل الآن؟
Dialogue: 0,1:06:27.68,1:06:30.56,نص عام,,0,0,0,,لا أفهم سبب وجودهم هنا؟
Dialogue: 0,1:06:30.64,1:06:34.31,نص عام,,0,0,0,,كنت على وشك إخبارك
Dialogue: 0,1:06:34.39,1:06:36.52,نص عام,,0,0,0,,لكن جين مو سبقني
Dialogue: 0,1:06:37.94,1:06:39.11,نص عام,,0,0,0,,جين مو؟
Dialogue: 0,1:06:39.90,1:06:42.24,نص عام,,0,0,0,,هل حدث شيء مرة أخرى؟
Dialogue: 0,1:06:44.15,1:06:45.57,نص عام,,0,0,0,,دعهم جميعًا!
Dialogue: 0,1:06:45.66,1:06:47.49,نص عام,,0,0,0,,ولي العهد
Dialogue: 0,1:06:47.57,1:06:50.24,النص العام,,0,0,0,,تحدى تشان ووك في مبارزة
Dialogue: 0,1:06:52.50,1:06:56.46,general text,,0,0,0,,قال نائب غوانغجو أنه يجب علينا تسليم تشانغ ووك إلى جيونبوغوان،
Dialogue: 0,1:06:56.54,1:06:58.96,نص عام,,0,0,0,,إذا رفض القتال
Dialogue: 0,1:06:59.54,1:07:02.46,نص عام,,0,0,0,,تشان ووك مغلق هنا بالفعل
Dialogue: 0,1:07:04.30,1:07:07.80,النص العام,,0,0,0,,التوصيل إلى جيونبوغوان؟ لماذا؟
Dialogue: 0,1:07:07.89,1:07:09.60,نص عام,,0,0,0,,اسأل المعلم هو
Dialogue: 0,1:07:10.39,1:07:13.68,نص عام,,0,0,0,,قيل لي أنك وافقت على هذه الشروط
Dialogue: 0,1:07:22.48,1:07:25.45,نص عام,,0,0,0,,المملكة المتحدة، انهض. تحتاج إلى الهروب من هنا
Dialogue: 0,1:07:26.20,1:07:27.28,نص عام,,0,0,0,,ما الأمر؟
Dialogue: 0,1:07:27.36,1:07:30.74,نص عام,,0,0,0,,لا وقت للشرح. إذا لم نستعجل، فسوف تفقد يدك
Dialogue: 0,1:07:31.66,1:07:33.41,نص عام,,0,0,0,,قد تموت حتى
Dialogue: 0,1:07:34.00,1:07:35.29,نص عام,,0,0,0,,- ماذا؟\N- المضيف
Dialogue: 0,1:07:35.87,1:07:37.42,نص عام,,0,0,0,,كل شيء أصبح أكثر جدية
Dialogue: 0,1:07:37.50,1:07:40.00,general text,,0,0,0,,ابق هنا، فسوف تفقد يدك أو حياتك
Dialogue: 0,1:07:41.04,1:07:42.50,النص العام,,0,0,0,,هل ستجلس هكذا؟
Dialogue: 0,1:07:53.85,1:07:58.40,general text,,0,0,0,,سأذهب مع المملكة المتحدة إلى القصر وألتقي بولي العهد
Dialogue: 0,1:07:58.98,1:08:00.94,نص عام,,0,0,0,,المملكة المتحدة ستكون هنا قريبًا
Dialogue: 0,1:08:05.53,1:08:06.49,نص عام,,0,0,0,,أين تقع المملكة المتحدة؟
Dialogue: 0,1:08:06.57,1:08:09.82,general text,,0,0,0,,إنه ليس في الغرفة السرية. أعتقد أنه هرب
Dialogue: 0,1:08:10.53,1:08:11.53,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:08:18.71,1:08:21.17,نص عام,,0,0,0,,عندما تعلق بين صخرة ومكان صلب،
Dialogue: 0,1:08:21.25,1:08:23.21,نص عام,,0,0,0,,الهروب هو المخرج الوحيد
Dialogue: 0,1:08:31.18,1:08:34.10,نص عام,,0,0,0,,لقد كان هنا طوال الوقت. فقط خادمته تدخل وتخرج
Dialogue: 0,1:08:34.68,1:08:36.27,نص عام,,0,0,0,,لا أفهم كيف هرب
Dialogue: 0,1:08:38.89,1:08:40.85,general text,,0,0,0,,أين يول ودان غو؟
Dialogue: 0,1:08:49.61,1:08:53.24,النص العام,,0,0,0,,الفصل سيحل كل شيء. أبقِ رأسك منخفضًا حتى تهدأ الأمور
Dialogue: 0,1:08:54.58,1:08:57.33,نص عام,,0,0,0,,مو دوك، اعتني به
Dialogue: 0,1:08:58.25,1:09:01.25,نص عام,,0,0,0,,هل أنت متأكد من أننا لسنا بحاجة إليك؟
Dialogue: 0,1:09:01.33,1:09:03.84,نص عام,,0,0,0,,نعم سنذهب إلى قريتي
Dialogue: 0,1:09:03.92,1:09:05.88,نص عام,,0,0,0,,قرية ساري، هاه؟
Dialogue: 0,1:09:05.96,1:09:08.80,نص عام,,0,0,0,,ابق هناك. سوف نأتي لك
Dialogue: 0,1:09:14.89,1:09:17.10,النص العام,,0,0,0,,لقد عرضته للخطر مرة أخرى
Dialogue: 0,1:09:20.35,1:09:22.73,نص عام,,0,0,0,,وسوف يحصل على ما يريد مرة أخرى
Dialogue: 0,1:09:50.01,1:09:51.34,نص عام,,0,0,0,,ستكون المعركة
الحوار: 0,1:09:52.63,1:09:56.43,نص عام,,0,0,0,,منتصف الشهر القادم
Dialogue: 0,1:09:59.89,1:10:01.23,نص عام,,0,0,0,,ولكن إذا
Dialogue: 0,1:10:02.10,1:10:03.98,النص العام,,0,0,0,,لن يظهر في ذلك اليوم،
Dialogue: 0,1:10:05.81,1:10:07.82,نص عام,,0,0,0,,اعتبر هذا هزيمة
Dialogue: 0,1:10:07.90,1:10:10.36,النص العام,,0,0,0,,هذا هروب وليس هزيمة
Dialogue: 0,1:10:12.45,1:10:15.12,النص العام,,0,0,0,,أعتقد أنه يجب معاقبة مثل هؤلاء الجبناء
Dialogue: 0,1:10:17.70,1:10:19.33,نص عام,,0,0,0,,أنا أتفق معه
Dialogue: 0,1:10:19.95,1:10:22.25,نص عام,,0,0,0,,إذا لم يعد تشانغ ووك،
Dialogue: 0,1:10:22.83,1:10:25.13,general text,,0,0,0,,سوف يُحرم من حقه في أن يصبح
Dialogue: 0,1:10:26.08,1:10:27.17,نص عام,,0,0,0,,غوانغجو التالية
Dialogue: 0,1:10:35.09,1:10:37.35,نص عام,,0,0,0,,فليكن يا صاحب الجلالة
Dialogue: 0,1:10:54.95,1:10:57.03,general text,,0,0,0,,لماذا أخذتها ونحن نهرب؟
Dialogue: 0,1:10:58.37,1:10:59.78,نص عام,,0,0,0,,للتدريب
Dialogue: 0,1:10:59.87,1:11:01.08,نص عام,,0,0,0,,التدريب؟
Dialogue: 0,1:11:01.16,1:11:02.45,نص عام,,0,0,0,,هل سنتدرب؟
Dialogue: 0,1:11:04.04,1:11:05.08,نص عام,,0,0,0,,هل أنت وراء هذا؟
Dialogue: 0,1:11:05.17,1:11:06.62,نص عام,,0,0,0,,مساهمة
Dialogue: 0,1:11:07.13,1:11:09.96,general text,,0,0,0,,لقد تحركت أخيرًا عندما قلت إنك في خطر
Dialogue: 0,1:11:12.05,1:11:13.30,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:11:13.38,1:11:15.47,نص عام,,0,0,0,,لست بحاجة إلى طالب لا يحرز تقدمًا
Dialogue: 0,1:11:16.26,1:11:18.85,general text,,0,0,0,,فقط مت إذا كنت لن تفعل أي شيء
Dialogue: 0,1:11:18.93,1:11:20.76,النص العام,,0,0,0,,لقد سممتني مرة أخرى،
Dialogue: 0,1:11:21.93,1:11:23.64,نص عام,,0,0,0,,سيدي المجنون
Dialogue: 0,1:11:24.31,1:11:25.35,نص عام,,0,0,0,,شان ووك
Dialogue: 0,1:11:26.14,1:11:29.52,نص عام,,0,0,0,,نحن ذاهبون إلى حيث تدربت. استعد
Dialogue: 0,1:11:30.15,1:11:33.61,نص عام,,0,0,0,,لن يكون هناك حمامات دافئة هناك
Dialogue: 0,1:11:33.69,1:11:38.28,نص عام,,0,0,0,,لا أسرة ولا طعامك المفضل
Dialogue: 0,1:11:40.45,1:11:43.41,general text,,0,0,0,,هل قرية ساري مخيفة إلى هذا الحد؟
Dialogue: 0,1:11:44.25,1:11:46.87,نص عام,,0,0,0,,عاش مو دوك في ساري
Dialogue: 0,1:11:46.96,1:11:48.92,نص عام,,0,0,0,,ناك سو من نفس المكان
Dialogue: 0,1:11:50.00,1:11:51.38,نص عام,,0,0,0,,من Danhyanggok
Dialogue: 0,1:11:53.76,1:11:55.47,نص عام,,0,0,0,,هذا هو ما نتجه إليه
Dialogue: 0,1:12:51.94,1:12:53.73,معاينة,,0,0,0,,ما كل هذا؟
Dialogue: 0,1:12:53.82,1:12:54.94,preview,,0,0,0,,مو دوك!
Dialogue: 0,1:12:55.02,1:12:58.03,preview,,0,0,0,,كادت أن أعتبر هذا محاولة لاختطافي والعيش معي
Dialogue: 0,1:12:58.11,1:12:59.78,معاينة,,0,0,0,,تحت ستار التدريب
Dialogue: 0,1:12:59.86,1:13:02.82,معاينة,,0,0,0,,فقط لعلمك، يمكنني تعليمك بشكل مختلف
Dialogue: 0,1:13:02.91,1:13:05.62,معاينة,,0,0,0,,مثل هؤلاء الفتيات هن الأخطر
Dialogue: 0,1:13:05.70,1:13:07.20,معاينة,,0,0,0,,أنا لا أحب الحلويات
Dialogue: 0,1:13:07.29,1:13:09.50,معاينة,,0,0,0,,حسنًا، من فضلك، إذا لم يعجبك
Dialogue: 0,1:13:09.58,1:13:12.92,preview,,0,0,0,,- يطبخ يول الأرز مع مو ديوك!\N- لقد أخبرتك...
Dialogue: 0,1:13:13.00,1:13:16.92,preview,,0,0,0,,كيف يمكنك تعليم شخص آخر عندما يكون طالبك هنا؟
Dialogue: 0,1:13:17.01,1:13:20.09,preview,,0,0,0,,ماذا لو حرمناه من حق أن يُسمى ساحراً؟
Dialogue: 0,1:13:20.17,1:13:23.05,preview,,0,0,0,,أينما ذهب لا يجد معلماً
Dialogue: 0,1:13:23.14,1:13:26.31,معاينة,,0,0,0,,روح مذهلة هاجرت إلى هذا الجسد
Dialogue: 0,1:13:26.39,1:13:27.35,preview,,0,0,0,,مو دوك، اركض!
Dialogue: 0,1:13:27.43,1:13:28.73,preview,,0,0,0,,لم أرغب في فعل أي شيء...
Dialogue: 0,1:13:28.81,1:13:30.31,معاينة,,0,0,0,,ولكن هناك شيء يزعجني
الحوار: 0,0:35:38.58,0:35:40.58,معاينة,,0,0,0,,

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
