Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter:{\c&HFFF4C5&} Ria_Lee, tommo, Zero Amamiya
Dialogue: 0,0:00:45.24,0:00:47.66,pangkalahatang teksto,,0,0,0,,Ito ay isang uri ng kabaliwan!
Dialogue: 0,0:00:47.74,0:00:51.04,general text,,0,0,0,,Ganyan bang entertainment ang pagpatay at pagbuhay sa isang tao?
Dialogue: 0,0:00:51.12,0:00:53.00,pangkalahatang teksto,,0,0,0,,Hindi kami makikialam,
Dialogue: 0,0:00:53.08,0:00:55.79,general text,,0,0,0,,dahil si Moo Dok ay may kalokohang pumayag
Dialogue: 0,0:00:57.09,0:00:58.30,pangkalahatang text,,0,0,0,,Itong babaeng ito
Dialogue: 0,0:01:00.76,0:01:02.05,pangkalahatang text,,0,0,0,,nakangiti
Dialogue: 0,0:01:02.13,0:01:04.68,mga alaala,,0,0,0,,Okay. Sumasang-ayon ako
Dialogue: 0,0:01:09.60,0:01:11.39,general text,,0,0,0,,Pumayag siya
Dialogue: 0,0:01:11.48,0:01:14.31,general text,,0,0,0,,dahil sa gintong matatanggap niya
Dialogue: 0,0:01:14.90,0:01:17.11,general text,,0,0,0,,Dahil ba talaga sa ginto
Dialogue: 0,0:01:19.53,0:01:21.61,general text,,0,0,0,,nakangiti ba siya?
Dialogue: 0,0:01:33.71,0:01:35.96,general text,,0,0,0,,Ayoko rin
Dialogue: 0,0:01:37.04,0:01:39.30,general text,,0,0,0,,Kaya papatayin kita ng walang sakit
Dialogue: 0,0:01:39.38,0:01:41.80,pangkalahatang teksto,,0,0,0,,Hindi ito para ipakita ang aking kamatayan
Dialogue: 0,0:01:42.88,0:01:45.05,general text,,0,0,0,,Ginagawa namin ito para ipakita kung paano ako bubuhayin
Dialogue: 0,0:01:47.30,0:01:51.64,pangkalahatang teksto,,0,0,0,,Sa tulong ng libro sinusubukan nilang bumili ng oras para ilantad ka
Dialogue: 0,0:01:52.22,0:01:54.73,italics,,0,0,0,,Kapag namatay siya, tatawagin nila ang kapangyarihan ng bato,
Dialogue: 0,0:01:54.81,0:01:58.44,italics,,0,0,0,,gamitin ang oras na ito para lumipat sa kanyang katawan
Dialogue: 0,0:01:58.52,0:02:02.19,pangkalahatang teksto,,0,0,0,,Magtatapos ang konseho kapag namatay ang reyna
Dialogue: 0,0:02:03.11,0:02:07.03,pangkalahatang teksto,,0,0,0,,At mahinahon nating iiwan ang Pine Forest na may dalang bato
Dialogue: 0,0:02:09.78,0:02:13.37,general text,,0,0,0,,Nagtataka ako kung bakit siya pinili ng Kanyang Kamahalan sa lahat?
Dialogue: 0,0:02:13.45,0:02:16.25,general text,,0,0,0,,Siya ang pinakamahina sa amin
Dialogue: 0,0:02:16.33,0:02:17.96,italics,,0,0,0,,Tama ang pinili niya
Dialogue: 0,0:03:26.11,0:03:27.32,mga alaala,,0,0,0,,Ang aking kagandahan
Dialogue: 0,0:03:28.57,0:03:30.36,mga alaala,,0,0,0,,My Boo Young
Dialogue: 0,0:03:39.21,0:03:40.33,pangkalahatang teksto,,0,0,0,,Ina
Dialogue: 0,0:04:10.49,0:04:12.87,general text,,0,0,0,,Walang tumitingin sa iyo
Dialogue: 0,0:04:12.95,0:04:14.70,pangkalahatang teksto,,0,0,0,,Ilipat ang iyong kaluluwa
Dialogue: 0,0:04:15.53,0:04:17.08,pangkalahatang text,,0,0,0,,Hindi ako
Dialogue: 0,0:04:17.16,0:04:20.00,pangkalahatang teksto,,0,0,0,,Hindi ko kontrolado ang bato
Dialogue: 0,0:04:20.58,0:04:21.75,pangkalahatang teksto,,0,0,0,,Kung gayon sino?
Dialogue: 0,0:05:08.34,0:05:09.63,pangkalahatang teksto,,0,0,0,,Itigil mo ito
Dialogue: 0,0:05:21.39,0:05:23.81,general text,,0,0,0,,Inay, okay ka lang?
Dialogue: 0,0:05:28.02,0:05:29.11,pangkalahatang teksto,,0,0,0,,Bu Young...
Dialogue: 0,0:05:33.15,0:05:35.70,offscreen,,0,0,0,,Nakilala ba niya siya? Ito ay masama
Dialogue: 0,0:05:36.28,0:05:38.20,behind the scenes,,0,0,0,,Mabubuhay siya ngayon
Dialogue: 0,0:05:38.78,0:05:40.12,behind the scenes,,0,0,0,,Hindi ito pinapayagan
Dialogue: 0,0:05:40.20,0:05:41.54,voiceover,,0,0,0,,Dapat siyang mamatay
Dialogue: 0,0:06:27.08,0:06:28.33,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:06:28.83,0:06:30.59,pangkalahatang teksto,,0,0,0,,Nasaan ang bato?
Dialogue: 0,0:06:34.46,0:06:35.59,general text,,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:06:48.31,0:06:49.56,italics,,0,0,0,,Nakita mo na ba?
Dialogue: 0,0:06:49.65,0:06:52.82,pangkalahatang teksto,,0,0,0,,Ang kapangyarihan ng bato at langit ay nagkaisa
Dialogue: 0,0:06:52.90,0:06:55.99,pangkalahatang teksto,,0,0,0,,Mukhang kinuha ng langit ang bato
Dialogue: 0,0:06:57.07,0:06:58.61,pangkalahatang teksto,,0,0,0,,Hindi kinuha ang bato
Dialogue: 0,0:07:03.29,0:07:04.45,general text,,0,0,0,,Siya pa rin
Dialogue: 0,0:07:05.41,0:07:06.50,pangkalahatang teksto,,0,0,0,,sa isang lugar dito
Dialogue: 0,0:07:06.58,0:07:10.50,pangkalahatang teksto,,0,0,0,,Saan ito eksakto?
Dialogue: 0,0:07:36.03,0:07:40.24,general text,,0,0,0,,Kulog, kidlat, ngayon din fog sa kalagitnaan ng araw?
Dialogue: 0,0:07:40.32,0:07:41.95,pangkalahatang teksto,,0,0,0,,Hindi lang iyon
Dialogue: 0,0:07:42.03,0:07:43.41,pangkalahatang text,,0,0,0,,May nangyaring mali
Dialogue: 0,0:07:50.71,0:07:53.34,general text,,0,0,0,,- Ito ba ang ginamit nilang panakip sa bato?\N- Oo
Dialogue: 0,0:07:53.42,0:07:54.59,general text,,0,0,0,,May nangyari sa bato?
Dialogue: 0,0:07:56.00,0:07:57.46,general text,,0,0,0,,Panaginip ba ito o ano?
Dialogue: 0,0:07:57.55,0:08:00.63,pangkalahatang teksto,,0,0,0,,- Bulaklak kahit saan\N - Lahat ay hindi totoo
Dialogue: 0,0:08:01.34,0:08:03.35,general text,,0,0,0,,Patay na ba tayo?
Dialogue: 0,0:08:03.97,0:08:06.43,general text,,0,0,0,,- Ito ba ang kabilang buhay?\N- Hoy!
Dialogue: 0,0:08:06.52,0:08:08.14,pangkalahatang teksto,,0,0,0,,Tumigil sa pagsasalita ng walang kapararakan
Dialogue: 0,0:08:08.23,0:08:11.06,general text,,0,0,0,,Kung gayon ako ang jade emperor, at siya ay isang diwata?
Dialogue: 0,0:08:12.94,0:08:14.36,pangkalahatang teksto,,0,0,0,,Diwata!
Dialogue: 0,0:08:24.32,0:08:25.62,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:08:26.49,0:08:27.95,pangkalahatang teksto,,0,0,0,,Siguradong hindi isang engkanto
Dialogue: 0,0:08:28.83,0:08:30.00,pangkalahatang text,,0,0,0,,Ghost?
Dialogue: 0,0:08:39.13,0:08:41.68,pangkalahatang teksto,,0,0,0,,Mga salamangkero ba kayo?
Dialogue: 0,0:08:42.38,0:08:44.64,pangkalahatang teksto,,0,0,0,,Oo, ang mga salamangkero ng Jeonjingak
Dialogue: 0,0:08:48.64,0:08:50.02,general text,,0,0,0,,Nandito ka rin Ms. Ho
Dialogue: 0,0:08:54.31,0:08:55.56,pangkalahatang text,,0,0,0,,Bitawan mo ako
Dialogue: 0,0:08:58.53,0:09:01.78,pangkalahatang text,,0,0,0,,Chan Wook, huwag kang pumunta kahit saan, bantayan mo ang lugar na ito
Dialogue: 0,0:09:02.49,0:09:03.82,pangkalahatang teksto,,0,0,0,,Kayong tatlo
Dialogue: 0,0:09:04.61,0:09:05.62,pangkalahatang teksto,,0,0,0,,Tingnan ang paligid
Dialogue: 0,0:09:05.70,0:09:09.37,general text,,0,0,0,,- Pupunta ako sa training room\N- Sasamahan ka namin
Dialogue: 0,0:09:12.12,0:09:13.87,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:09:13.96,0:09:15.21,general text,,0,0,0,,May narinig akong kulog
Dialogue: 0,0:09:15.29,0:09:17.42,general text,,0,0,0,,Hindi rin namin alam
Dialogue: 0,0:09:18.21,0:09:21.21,pangkalahatang teksto,,0,0,0,,Aalamin natin kapag nawala ang hamog
Dialogue: 0,0:09:21.88,0:09:23.63,pangkalahatang teksto,,0,0,0,,Kung hindi ito panaginip o kabilang buhay,
Dialogue: 0,0:09:24.22,0:09:26.09,general text,,0,0,0,,saan nagmula ang lahat ng bulaklak na ito?
Dialogue: 0,0:09:27.18,0:09:28.76,general text,,0,0,0,,Totoo ba ang fog?
Dialogue: 0,0:10:04.72,0:10:06.18,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:10:06.26,0:10:07.18,general text,,0,0,0,,Hindi mo naintindihan
Dialogue: 0,0:10:07.26,0:10:10.72,general text,,0,0,0,,Sinubukan naming lumabas ng gate, ngunit napaatras kami ng malakas na hangin.
Dialogue: 0,0:10:10.81,0:10:11.93,pangkalahatang teksto,,0,0,0,, Hangin?
Dialogue: 0,0:10:13.31,0:10:14.56,pangkalahatang teksto,,0,0,0,,Walang hangin
Dialogue: 0,0:10:18.23,0:10:20.48,general text,,0,0,0,,Huwag lumapit. Hindi namin nakikita
Dialogue: 0,0:10:20.57,0:10:22.44,pangkalahatang teksto,,0,0,0,,ngunit hindi kapani-paniwalang enerhiya ang pumapalibot sa atin
Dialogue: 0,0:10:22.53,0:10:24.78,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari dito?
Dialogue: 0,0:10:24.86,0:10:25.82,pangkalahatang teksto,,0,0,0,,Ito ay isang hadlang
Dialogue: 0,0:10:27.24,0:10:29.95,pangkalahatang teksto,,0,0,0,,Sa tingin ko ay may harang sa paligid ng Jeongjingak
Dialogue: 0,0:10:30.95,0:10:32.04,pangkalahatang teksto,,0,0,0,,Barrier?
Dialogue: 0,0:10:32.12,0:10:33.62,pangkalahatang teksto,,0,0,0,,Sino ang nagtayo nito dito?
Dialogue: 0,0:10:33.70,0:10:34.87,italics,,0,0,0,,Your Highness
Dialogue: 0,0:10:37.08,0:10:38.33,pangkalahatang teksto,,0,0,0,,Your Highness
Dialogue: 0,0:10:38.42,0:10:40.71,general text,,0,0,0,,Nandito na ang heiress ni Jinyeowon
Dialogue: 0,0:10:41.46,0:10:43.80,general text,,0,0,0,,Jin Bu Young, na nagdala ng ice stone
Dialogue: 0,0:10:43.88,0:10:45.55,pangkalahatang teksto,,0,0,0,, nahimatay
Dialogue: 0,0:10:56.89,0:10:57.77,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:11:14.12,0:11:17.79,pangkalahatang teksto,,0,0,0,,Ang lakas ng bato ay tumagos sa Jeonjingak
Dialogue: 0,0:11:17.87,0:11:19.88,pangkalahatang teksto,,0,0,0,,at gumawa ng hadlang
Dialogue: 0,0:11:21.33,0:11:23.75,general text,,0,0,0,,Sino ang nasa loob ngayon?
Dialogue: 0,0:11:24.67,0:11:26.59,pangkalahatang teksto,,0,0,0,, Chan Wook at Seo Yul ay wala kahit saan
Dialogue: 0,0:11:26.67,0:11:27.97,pangkalahatang teksto,,0,0,0,,Malamang nandoon sila
Dialogue: 0,0:11:28.93,0:11:30.51,general text,,0,0,0,,Nandiyan din si Miss Ho
Dialogue: 0,0:11:30.59,0:11:33.10,general text,,0,0,0,,- My Young Ok!\N-{\i1} Crown Prince
Dialogue: 0,0:11:33.18,0:11:34.72,general text,,0,0,0,,Nandoon din ang Kamahalan
Dialogue: 0,0:11:35.47,0:11:38.94,general text,,0,0,0,,- Ano?\N- Andyan din ba si Bom?
Dialogue: 0,0:11:39.02,0:11:41.15,general text,,0,0,0,,Nasaan si Jin Ho?
Dialogue: 0,0:11:42.11,0:11:43.11,italics,,0,0,0,,Chief Jin,
Dialogue: 0,0:11:43.19,0:11:44.40,pangkalahatang teksto,,0,0,0,,gumawa ng isang bagay
Dialogue: 0,0:11:44.48,0:11:47.69,general text,,0,0,0,,Nilamon din ng bato ang anak mo, malamang nandoon din siya
Dialogue: 0,0:11:48.32,0:11:50.32,pangkalahatang teksto,,0,0,0,,Hindi ka maaaring magmadali
Dialogue: 0,0:11:50.41,0:11:53.78,general text,,0,0,0,,Nakita namin ang nangyari pagkatapos ng interbensyon ni Jin Bu Young
Dialogue: 0,0:11:55.08,0:11:57.83,general text,,0,0,0,,Kasalanan ni Jinyeowon
Dialogue: 0,0:11:59.29,0:12:01.83,pangkalahatang teksto,,0,0,0,,Gusto mong makita ang kapangyarihan ng batong yelo
Dialogue: 0,0:12:01.92,0:12:03.71,general text,,0,0,0,,Ngayon gusto mo kaming sisihin?
Dialogue: 0,0:12:04.75,0:12:07.30,general text,,0,0,0,,Mag-aaway na naman ba kayo?
Dialogue: 0,0:12:07.38,0:12:10.05,pangkalahatang teksto,,0,0,0,,Sapat na. Nandoon ang mga bata
Dialogue: 0,0:12:10.13,0:12:11.72,general text,,0,0,0,,Yong Ok!
Dialogue: 0,0:12:28.90,0:12:31.15,pangkalahatang teksto,,0,0,0,,May magagawa ka
Dialogue: 0,0:12:31.24,0:12:33.99,pangkalahatang teksto,,0,0,0,,na may harang sa paligid ng Jeonjingak?
Dialogue: 0,0:12:34.07,0:12:35.87,general text,,0,0,0,,Ano ang nangyari sa training hall?
Dialogue: 0,0:12:37.16,0:12:38.20,pangkalahatang teksto,,0,0,0,,Ito...
Dialogue: 0,0:12:47.96,0:12:50.30,voiceover,,0,0,0,, Siguradong dahil ito kay Moo Deok
Dialogue: 0,0:12:50.38,0:12:53.76,behind the scenes,,0,0,0,,Gayunpaman, siya ang tunay na Jin Bu Young mula kay Jinyoung
Dialogue: 0,0:12:54.34,0:12:56.26,behind the scenes,,0,0,0,,At iniisip ng lahat na ako ito
Dialogue: 0,0:12:56.35,0:12:58.60,offscreen,,0,0,0,,Hindi ko masasabing siya yun
Dialogue: 0,0:12:58.68,0:12:59.56,behind the scenes,,0,0,0,,Ano ang dapat kong gawin?
Dialogue: 0,0:13:00.52,0:13:01.85,pangkalahatang teksto,,0,0,0,,Sagot
Dialogue: 0,0:13:01.94,0:13:03.19,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,0:13:04.69,0:13:05.98,pangkalahatang text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:13:06.06,0:13:09.32,general text,,0,0,0,,bulag ako, kaya hindi ko nakita ang nangyari
Dialogue: 0,0:13:09.40,0:13:12.15,general text,,0,0,0,,Nawalan ako ng malay nang lumakas ang hangin at kakagising ko lang.
Dialogue: 0,0:13:12.24,0:13:14.16,general text,,0,0,0,,Hindi mo alam kung paano ka napunta dito?
Dialogue: 0,0:13:14.24,0:13:16.70,general text,,0,0,0,,Hindi ko alam kung nasaan ako
Dialogue: 0,0:13:16.78,0:13:19.58,general text,,0,0,0,,Paano ko malalaman kung paano ako nakarating dito?
Dialogue: 0,0:13:24.00,0:13:26.21,pangkalahatang teksto,,0,0,0,,Hindi siya masyadong maganda
Dialogue: 0,0:13:27.25,0:13:29.92,general text,,0,0,0,,Namumutla lahat, pawis sa noo
Dialogue: 0,0:13:30.01,0:13:31.59,pangkalahatang teksto,,0,0,0,,Ano ang masasabi mo?
Dialogue: 0,0:13:33.38,0:13:36.22,general text,,0,0,0,,Kailangan muna niyang magpahinga, Your Highness
Dialogue: 0,0:13:39.68,0:13:40.68,general text,,0,0,0,,Hayaan mo siyang magpahinga
Dialogue: 0,0:13:42.02,0:13:43.02,general text,,0,0,0,,Let's go
Dialogue: 0,0:13:48.57,0:13:49.94,pangkalahatang teksto,,0,0,0,,Kasinungalingan ang lahat
Dialogue: 0,0:13:51.40,0:13:52.69,general text,,0,0,0,,Ano ang tinatago niya?
Dialogue: 0,0:13:52.78,0:13:54.15,pangkalahatang text,,0,0,0,,Baka alam ni Moo Dok
Dialogue: 0,0:13:54.90,0:13:56.57,general text,,0,0,0,,Mu Dok, kasama mo ba siya?
Dialogue: 0,0:13:59.20,0:14:00.87,general text,,0,0,0,,Moo Dok, paano ka nakarating dito?
Dialogue: 0,0:14:02.12,0:14:04.79,general text,,0,0,0,,Nandito ako palagi
Dialogue: 0,0:14:07.92,0:14:09.00,general text,,0,0,0,,Nakapunta ka na ba dito?
Dialogue: 0,0:14:10.05,0:14:12.51,general text,,0,0,0,,Hindi mo ba natapon ang tsaa sa study hall?
Dialogue: 0,0:14:13.47,0:14:16.89,general text,,0,0,0,,Oo, pero sinundan agad kita
Dialogue: 0,0:14:16.97,0:14:19.97,general text,,0,0,0,,Hindi ko alam kung anong nangyari noon
Dialogue: 0,0:14:20.93,0:14:23.85,general text,,0,0,0,,Ano ang maitatanong mo sa isang kasambahay na ang alam lang
Dialogue: 0,0:14:24.43,0:14:28.23,pangkalahatang teksto,,0,0,0,,takbuhin ang iyong amo na parang maliit na aso?
Dialogue: 0,0:14:28.31,0:14:29.86,italics,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:14:30.36,0:14:32.82,pangkalahatang teksto,,0,0,0,,Sa kabila ng hadlang ay ang pinakamahuhusay na mago ng Unified Council
Dialogue: 0,0:14:32.90,0:14:35.28,general text,,0,0,0,,Mabilis nila tayong ililigtas
Dialogue: 0,0:14:36.45,0:14:38.28,pangkalahatang teksto,,0,0,0,,Dalhin ang His Highness tea
Dialogue: 0,0:14:38.37,0:14:39.45,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:14:51.92,0:14:55.34,pangkalahatang teksto,,0,0,0,,Isang aso na humahabol sa may-ari nito
Dialogue: 0,0:14:55.42,0:14:57.38,pangkalahatang teksto,,0,0,0,,Walang alam na alipin
Dialogue: 0,0:14:58.93,0:15:00.64,pangkalahatang teksto,,0,0,0,,Ito si Mu Dok
Dialogue: 0,0:15:06.94,0:15:08.31,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:15:08.40,0:15:10.11,pangkalahatang teksto,,0,0,0,,At walang tubig
Dialogue: 0,0:16:09.79,0:16:12.75,pangkalahatang teksto,,0,0,0,,Ang tsaa na pinakuluan ng spell ang pinaka masarap
Dialogue: 0,0:16:14.50,0:16:15.80,pangkalahatang teksto,,0,0,0,,Maraming oras na ang lumipas
Dialogue: 0,0:16:18.51,0:16:22.97,voiceover,,0,0,0,,Nabawi ko sa wakas ang lakas ko salamat sa bato
Dialogue: 0,0:16:32.06,0:16:34.81,mga alaala,,0,0,0,,Ano ang nangyayari? nasaan ako?
Dialogue: 0,0:16:36.57,0:16:38.86,mga alaala,,0,0,0,,Hindi tayo mawawala sa pagkakataong ito
Dialogue: 0,0:16:39.69,0:16:41.70,mga alaala,,0,0,0,,Nasa ice stone tayo
Dialogue: 0,0:16:43.32,0:16:45.20,mga alaala,,0,0,0,,Bato ba ito?
Dialogue: 0,0:16:45.78,0:16:48.95,mga alaala,,0,0,0,,Ang yelong bato ay hindi limitado sa laki o hugis
Dialogue: 0,0:16:49.58,0:16:51.79,mga alaala,,0,0,0,,Maaaring tubig, apoy
Dialogue: 0,0:16:51.87,0:16:53.54,mga alaala,,0,0,0,,o ang hangin
Dialogue: 0,0:16:57.67,0:17:00.01,memories,,0,0,0,,So akin na ang bato?
Dialogue: 0,0:17:06.97,0:17:09.60,mga alaala,,0,0,0,,Walang sinuman ang maaaring magtaglay ng bato
Dialogue: 0,0:17:10.98,0:17:13.06,mga alaala,,0,0,0,,Magagamit mo lang ang kapangyarihan nito
Dialogue: 0,0:17:13.14,0:17:15.77,mga alaala,,0,0,0,,Ito ay tulad ng pagbibigay at pagkuha
Dialogue: 0,0:17:15.86,0:17:17.90,mga alaala,,0,0,0,,May napala ka, may nawawala sa iyo
Dialogue: 0,0:17:17.98,0:17:20.94,mga alaala,,0,0,0,,Ito ay isang pasanin na dapat mong tiisin
Dialogue: 0,0:17:21.03,0:17:23.53,mga alaala,,0,0,0,,Tatanggapin ko ito ng may kagalakan
Dialogue: 0,0:17:23.61,0:17:25.20,mga alaala,,0,0,0,,Well, subukan ito
Dialogue: 0,0:17:25.28,0:17:27.33,mga alaala,,0,0,0,,Ang sobrang enerhiya ay hahantong sa
Dialogue: 0,0:17:27.95,0:17:30.66,mga alaala,,0,0,0,,na hindi mo makontrol ang kapangyarihang ginagamit mo
Dialogue: 0,0:17:31.45,0:17:34.00,mga alaala,,0,0,0,,Kung gusto mo ng ulan, magkakaroon ka ng baha
Dialogue: 0,0:17:34.83,0:17:37.54,memories,,0,0,0,,Kung gusto mo ng hangin, magkakaroon ka ng bagyo
Dialogue: 0,0:17:38.50,0:17:39.59,mga alaala,,0,0,0,,Subukan mong makayanan
Dialogue: 0,0:17:40.09,0:17:41.30,mga alaala,,0,0,0,,Ano ka?
Dialogue: 0,0:17:41.88,0:17:43.51,memories,,0,0,0,,Relic of Jinyoewon?
Dialogue: 0,0:17:44.43,0:17:46.84,mga alaala,,0,0,0,,Paano ang kaluluwang nabubuhay sa aking katawan,
Dialogue: 0,0:17:47.76,0:17:49.22,memories,,0,0,0,,tawagin mo akong relic?
Dialogue: 0,0:18:17.96,0:18:19.17,mga alaala,,0,0,0,,Jeonjingak?
Dialogue: 0,0:18:25.47,0:18:26.88,behind the scenes,,0,0,0,,Ano iyon?
Dialogue: 0,0:18:28.05,0:18:31.26,behind the scenes,,0,0,0,,Relic ni Jinyewon na nakakabit sa bato?
Dialogue: 0,0:18:37.56,0:18:39.81,general text,,0,0,0,,Moo Dok, ano ito?
Dialogue: 0,0:18:39.90,0:18:42.57,general text,,0,0,0,,Dalhan ang prinsipe ng basag na tasa?
Dialogue: 0,0:18:42.65,0:18:44.36,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:18:44.44,0:18:45.53,general text,,0,0,0,,Magpapalit ako
Dialogue: 0,0:18:46.07,0:18:49.41,offscreen,,0,0,0,,Stop. Hindi ko na kailangan pang magsilbi
Dialogue: 0,0:18:49.49,0:18:50.95,pangkalahatang teksto,,0,0,0,,- Mu Dok\N- Oo
Dialogue: 0,0:18:51.53,0:18:53.95,pangkalahatang teksto,,0,0,0,,Isang daang marumi. Punasan mo
Dialogue: 0,0:18:54.04,0:18:56.16,offscreen,,0,0,0,,Hindi na kailangang sumunod
Dialogue: 0,0:18:56.75,0:18:58.33,behind the scenes,,0,0,0,,Naging Moo Deok na ba ako hanggang sa kaibuturan?
Dialogue: 0,0:19:04.13,0:19:05.76,voiceover,,0,0,0,,Hindi na ako si Moo Deok
Dialogue: 0,0:19:05.84,0:19:06.76,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:19:12.01,0:19:14.93,pangkalahatang teksto,,0,0,0,,Wala pa kaming kinakain simula pa lang ng council
Dialogue: 0,0:19:15.02,0:19:16.43,general text,,0,0,0,,May makakain ka ba?
Dialogue: 0,0:19:17.10,0:19:19.73,pangkalahatang teksto,,0,0,0,,Ang Sujebi ay angkop para sa atin*
Dialogue: 0,0:19:17.10,0:19:19.73,notes,,0,0,0,,*traditional Korean soup na may mga piraso ng kuwarta
Dialogue: 0,0:19:19.81,0:19:20.73,general text,,0,0,0,,Kaya mo ba?
Dialogue: 0,0:19:27.49,0:19:29.95,general text,,0,0,0,,I Mu Dok hanggang matapos akong magluto
Dialogue: 0,0:19:30.66,0:19:34.29,general text,,0,0,0,,At pagkatapos ay titigil na ako sa pagiging kanya
Dialogue: 0,0:19:35.37,0:19:37.71,pangkalahatang teksto,,0,0,0,,Kapag muli kong maitatago ang kaluluwa,
Dialogue: 0,0:19:37.79,0:19:40.17,pangkalahatang teksto,,0,0,0,,Pumili ako ng anumang katawan
Dialogue: 0,0:19:42.42,0:19:43.96,general text,,0,0,0,,Pwede na rin akong maging hari
Dialogue: 0,0:19:51.64,0:19:53.18,pangkalahatang teksto,,0,0,0,,O mas mabuting patayin ang kalaban
Dialogue: 0,0:19:53.26,0:19:55.60,pangkalahatang teksto,,0,0,0,,at kunin ang kanyang katawan para sa iyong sarili?
Dialogue: 0,0:20:04.77,0:20:05.98,general text,,0,0,0,,Ayoko
Dialogue: 0,0:20:07.24,0:20:09.45,general text,,0,0,0,,Mas maganda maging Park Jin
Dialogue: 0,0:20:19.46,0:20:21.37,pangkalahatang teksto,,0,0,0,,Maaari kang pumili ng sinuman
Dialogue: 0,0:20:21.96,0:20:23.50,pangkalahatang teksto,,0,0,0,,Kailangan nating mag-isip
Dialogue: 0,0:20:24.96,0:20:26.71,pangkalahatang teksto,,0,0,0,,Perpekto
Dialogue: 0,0:20:26.80,0:20:29.09,pangkalahatang text,,0,0,0,,Nakakalungkot na hayaan siyang pumunta sa Suzhebi*
Dialogue: 0,0:20:26.80,0:20:29.09,notes,,0,0,0,,*sopas dough ay pinunit ng kamay
Dialogue: 0,0:20:29.17,0:20:30.76,general text,,0,0,0,,Siguro dapat tayong gumawa ng kuksa?*
Dialogue: 0,0:20:29.17,0:20:30.76,notes,,0,0,0,,* malamig na sabaw ng pansit
Dialogue: 0,0:20:30.84,0:20:32.80,pangkalahatang text,,0,0,0,,Mahal ni Chan Wook ang kuksu
Dialogue: 0,0:20:38.56,0:20:40.64,mga alaala,,0,0,0,,Ang amoy ay napakahina
Dialogue: 0,0:20:47.40,0:20:51.32,general text,,0,0,0,,Ito ang huling pagkain na inihanda ni Moo Deok para sa may-ari
Dialogue: 0,0:21:01.29,0:21:02.87,general text,,0,0,0,,- Master\N- Yes?
Dialogue: 0,0:21:04.25,0:21:07.04,general text,,0,0,0,,Gumawa ako ng kuksu, kainin mo
Dialogue: 0,0:21:07.13,0:21:08.34,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:21:12.05,0:21:15.43,general text,,0,0,0,,Ngayon aalis ka na ng kasambahay mo
Dialogue: 0,0:21:17.35,0:21:18.51,pangkalahatang teksto,,0,0,0,,At higit pa...
Dialogue: 0,0:21:20.39,0:21:22.56,general text,,0,0,0,,dito ako titigil sa pagiging guro mo
Dialogue: 0,0:21:24.27,0:21:25.31,general text,,0,0,0,,Titigil ka ba?
Dialogue: 0,0:21:27.02,0:21:29.07,general text,,0,0,0,,Hindi mo siguro naintindihan,
Dialogue: 0,0:21:29.82,0:21:31.44,general text,,0,0,0,,nasa loob tayo ng ice stone
Dialogue: 0,0:21:32.15,0:21:34.32,pangkalahatang teksto,,0,0,0,,Nabawi ko ang kapangyarihan tulad ng sa Lake Gyeongcheongdaeho
Dialogue: 0,0:21:36.95,0:21:38.79,pangkalahatang teksto,,0,0,0,,At ginagamit ko ang batong ito para sa alchemy,
Dialogue: 0,0:21:39.74,0:21:41.37,pangkalahatang teksto,,0,0,0,,upang umalis sa katawan na ito
Dialogue: 0,0:21:43.37,0:21:44.67,pangkalahatang teksto,,0,0,0,,Iyon ay...
Dialogue: 0,0:21:45.71,0:21:47.38,general text,,0,0,0,,hindi na tayo magkikita?
Dialogue: 0,0:21:47.46,0:21:49.34,pangkalahatang teksto,,0,0,0,,Nangako kaming tapusin ang lahat,
Dialogue: 0,0:21:49.92,0:21:51.88,pangkalahatang teksto,,0,0,0,, kapag nakuha ko na ang aking kapangyarihan
Dialogue: 0,0:21:51.96,0:21:54.84,pangkalahatang teksto,,0,0,0,,At pagkatapos ay nangako silang pag-usapan ang ating kinabukasan
Dialogue: 0,0:22:01.85,0:22:03.35,pangkalahatang teksto,,0,0,0,,Hindi para sa amin
Dialogue: 0,0:22:05.52,0:22:06.77,pangkalahatang teksto,,0,0,0,,isa pang hinaharap
Dialogue: 0,0:22:15.82,0:22:17.87,memories italics,,0,0,0,,You gain something, you lose something
Dialogue: 0,0:22:17.95,0:22:20.83,mga alaala,,0,0,0,,Ito ay isang pasanin na dapat mong tiisin
Dialogue: 0,0:22:22.29,0:22:24.41,general text,,0,0,0,,Kung kailangan kitang mawala kapalit ng kapangyarihan,
Dialogue: 0,0:22:26.00,0:22:27.42,pangkalahatang teksto,,0,0,0,,gayunpaman
Dialogue: 0,0:22:39.68,0:22:41.60,general text,,0,0,0,,- Master\N- Yes?
Dialogue: 0,0:22:41.68,0:22:43.77,general text,,0,0,0,,Gumawa ako ng kuksu, kainin mo
Dialogue: 0,0:22:44.52,0:22:46.06,pangkalahatang teksto,,0,0,0,,- At...\N- Mu Dok
Dialogue: 0,0:22:46.14,0:22:48.23,pangkalahatang teksto,,0,0,0,,Sa tingin ko ang hadlang sa paligid ng Jeonjingak
Dialogue: 0,0:22:48.31,0:22:50.19,pangkalahatang teksto,,0,0,0,,ito ay isang batong yelo
Dialogue: 0,0:22:50.77,0:22:51.61,behind the scenes,,0,0,0,,Ano?
Dialogue: 0,0:22:52.23,0:22:54.69,offscreen,,0,0,0,,Hindi niya dapat naintindihan yun
Dialogue: 0,0:22:56.20,0:22:58.49,general text,,0,0,0,,Sinasabi nila na ang bato ay tubig, apoy at hangin
Dialogue: 0,0:22:59.03,0:23:01.03,general text,,0,0,0,,Sa tingin ko binabalot tayo ng lakas ng hangin
Dialogue: 0,0:23:01.91,0:23:04.37,italics,,0,0,0,,Kung tayo ay nasa loob ng isang bato,
Dialogue: 0,0:23:04.91,0:23:08.25,general text,,0,0,0,,maaalis ba ito nang walang nakakaunawa?
Dialogue: 0,0:23:10.96,0:23:12.17,general text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:23:12.25,0:23:13.88,general text,,0,0,0,,Nakabisado ko ang Chisa
Dialogue: 0,0:23:14.63,0:23:16.47,general text,,0,0,0,,Baka mahuli ko siya na parang Goldfish?
Dialogue: 0,0:23:16.55,0:23:19.01,pangkalahatang teksto,,0,0,0,,Hindi man lang maikumpara ang iyong kasalukuyang lakas
Dialogue: 0,0:23:19.59,0:23:20.80,pangkalahatang teksto,,0,0,0,,may yelong bato
Dialogue: 0,0:23:23.10,0:23:26.39,general text,,0,0,0,,Sana ay mabawi mo ang iyong lakas, tulad ng ginawa mo sa lawa
Dialogue: 0,0:23:29.19,0:23:30.56,pangkalahatang teksto,,0,0,0,,Sa tingin ko kaya mo ito
Dialogue: 0,0:23:33.73,0:23:35.44,pangkalahatang teksto,,0,0,0,,Kung ibabalik ko ang kapangyarihan
Dialogue: 0,0:23:36.11,0:23:38.28,pangkalahatang teksto,,0,0,0,,at tumakas gamit ang bato?
Dialogue: 0,0:23:40.24,0:23:42.99,general text,,0,0,0,,Pag nahuli, baka mapatay ka
Dialogue: 0,0:23:44.20,0:23:45.41,general text,,0,0,0,,Hindi ka ba natatakot?
Dialogue: 0,0:23:45.49,0:23:48.21,general text,,0,0,0,,Ang posibilidad na tumakas ka gamit ang bato
Dialogue: 0,0:23:48.29,0:23:50.21,pangkalahatang teksto,,0,0,0,,ay laging umiral
Dialogue: 0,0:23:51.17,0:23:55.05,general text,,0,0,0,,At nasabi ko na rin na ganap kong pananagutan
Dialogue: 0,0:24:00.09,0:24:01.18,pangkalahatang teksto,,0,0,0,,Ngunit
Dialogue: 0,0:24:02.01,0:24:03.55,general text,,0,0,0,,Medyo natatakot ako
Dialogue: 0,0:24:04.93,0:24:09.39,general text,,0,0,0,,Natatakot ako na baka masira mo ang pangako natin at iwan mo ako ng hindi man lang nagpaalam.
Dialogue: 0,0:24:11.48,0:24:12.44,pangkalahatang teksto,,0,0,0,,Guro,
Dialogue: 0,0:24:12.52,0:24:16.23,general text,,0,0,0,,wag mo akong iwan, kung hindi, iiyak ako na parang baliw
Dialogue: 0,0:24:18.99,0:24:22.66,general text,,0,0,0,,Madali mong sabihin ang mga nakakahiyang bagay
Dialogue: 0,0:24:23.99,0:24:25.99,general text,,0,0,0,,Pagkatapos ay pagsisisihan mo ito
Dialogue: 0,0:24:28.33,0:24:31.25,general text,,0,0,0,,Hindi mahirap magsabi ng ganito, kaya kong tiisin ang kahihiyan
Dialogue: 0,0:24:31.33,0:24:34.92,general text,,0,0,0,,Ngunit hindi ko ibabalik ang oras, kahit na may pagsisihan ako
Dialogue: 0,0:24:36.59,0:24:39.30,pangkalahatang teksto,,0,0,0,,Guro, iwasan ang kahihiyan
Dialogue: 0,0:24:39.38,0:24:40.88,pangkalahatang teksto,,0,0,0,,at maging tapat sa iyong sarili
Dialogue: 0,0:24:40.97,0:24:43.89,pangkalahatang teksto,,0,0,0,,Kung gayon wala kang pagsisisihan
Dialogue: 0,0:24:49.73,0:24:52.02,pangkalahatang teksto,,0,0,0,,- Chan Wook, I...\N{\i1}- Mister
Dialogue: 0,0:24:55.65,0:24:56.73,general text,,0,0,0,,Pupunta ako diyan
Dialogue: 0,0:24:57.48,0:24:59.57,pangkalahatang teksto,,0,0,0,, Nasa kanya ang susi ng bulwagan na may mga ipinagbabawal na libro
Dialogue: 0,0:24:59.65,0:25:02.32,general text,,0,0,0,,Dahil nandito na tayo, may gusto akong hanapin
Dialogue: 0,0:25:03.36,0:25:04.45,italics,,0,0,0,,Nga pala
Dialogue: 0,0:25:10.29,0:25:11.87,pangkalahatang teksto,,0,0,0,,Kumain ka na. Huwag ibahagi sa sinuman
Dialogue: 0,0:25:37.69,0:25:41.28,pangkalahatang teksto,,0,0,0,,Naghahanap ng mga libro tungkol sa dark magic?
Dialogue: 0,0:25:41.36,0:25:43.49,general text,,0,0,0,,Oo, narinig kong umalis si tatay dito
Dialogue: 0,0:25:43.57,0:25:47.03,general text,,0,0,0,,lahat ng libro tungkol sa dark magic na natanggap ko mula sa shaman
Dialogue: 0,0:25:48.83,0:25:50.33,pangkalahatang teksto,,0,0,0,,Gusto kong hanapin sila
Dialogue: 0,0:25:53.41,0:25:55.42,pangkalahatang teksto,,0,0,0,,Kaya ito ang mga aklat ng Gwangju Chang Gang
Dialogue: 0,0:25:56.50,0:25:57.96,general text,,0,0,0,,Tutulong ako
Dialogue: 0,0:25:58.04,0:26:01.51,pangkalahatang text,,0,0,0,,kaya ko ang sarili ko. Maaari mong iwan sa akin ang susi at umalis
Dialogue: 0,0:26:02.92,0:26:05.38,pangkalahatang text,,0,0,0,,Ipinagkatiwala ito sa akin ni lolo
Dialogue: 0,0:26:05.47,0:26:07.43,general text,,0,0,0,,Paano ako makakasigurado na hindi mo ito mawawala?
Dialogue: 0,0:26:07.51,0:26:11.52,general text,,0,0,0,,Well, yes. Walang tiwala sa akin. Salamat sa iyong tulong
Dialogue: 0,0:26:29.33,0:26:31.41,pangkalahatang teksto,,0,0,0,,So, pansin
Dialogue: 0,0:26:32.12,0:26:36.75,pangkalahatang teksto,,0,0,0,,May sapat na libreng mga silid at pagkain sa Jeongjingak
Dialogue: 0,0:26:36.83,0:26:40.25,italics,,0,0,0,,Kaya huwag masyadong mag-alala
Dialogue: 0,0:26:40.34,0:26:41.42,italics,,0,0,0,,Kalmado tayo
Dialogue: 0,0:26:41.50,0:26:42.63,general text,,0,0,0,,Okay?
Dialogue: 0,0:26:51.64,0:26:54.60,general text,,0,0,0,,Pumunta sa Kisan at ipadala ang lahat dito
Dialogue: 0,0:26:54.68,0:26:57.44,pangkalahatang teksto,,0,0,0,,May karapatan din tayo sa kapangyarihan ng batong yelo
Dialogue: 0,0:26:57.52,0:26:58.60,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:27:01.73,0:27:03.94,pangkalahatang teksto,,0,0,0,,Tipunin ang lahat ng maaaring mag-spell
Dialogue: 0,0:27:04.03,0:27:05.90,pangkalahatang teksto,,0,0,0,,Kahit mga bata at matatanda
Dialogue: 0,0:27:05.99,0:27:07.24,general text,,0,0,0,,- Yes, sir\N- Okay
Dialogue: 0,0:27:15.16,0:27:18.29,pangkalahatang teksto,,0,0,0,,Tipunin ang lahat ng mga salamangkero ng Jeonbugwan at ipadala sila sa Sosnovy Bor
Dialogue: 0,0:27:18.37,0:27:20.92,pangkalahatang teksto,,0,0,0,,Maaaring sumiklab ang away sa ibabaw ng yelong bato
Dialogue: 0,0:27:21.42,0:27:22.92,pangkalahatang teksto,,0,0,0,,Dapat tayong maging handa
Dialogue: 0,0:27:23.00,0:27:24.21,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:27:31.97,0:27:32.85,pangkalahatang teksto,,0,0,0,,Kamahalan
Dialogue: 0,0:27:32.93,0:27:34.77,general text,,0,0,0,,Mukhang may sakit ka
Dialogue: 0,0:27:34.85,0:27:36.85,general text,,0,0,0,,Dapat kang bumalik sa palasyo
Dialogue: 0,0:27:37.69,0:27:40.73,pangkalahatang teksto,,0,0,0,,Kailangan kong makita ito ng sarili kong mga mata
Dialogue: 0,0:27:41.77,0:27:43.27,pangkalahatang teksto,,0,0,0,,May nakita kaming batong yelo,
Dialogue: 0,0:27:44.36,0:27:46.28,pangkalahatang teksto,,0,0,0,,na nangangahulugang ang bituin ng Hari ay hindi malayo
Dialogue: 0,0:28:01.50,0:28:04.96,general text,,0,0,0,,Marahil lahat ay naghihintay sa amin na magdala ng "Words of the Heart"
Dialogue: 0,0:28:06.51,0:28:07.84,general text,,0,0,0,,Bilisan natin
Dialogue: 0,0:28:16.39,0:28:17.43,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,0:28:17.52,0:28:18.89,general text,,0,0,0,,Nagdala kami ng "Words of the Heart"
Dialogue: 0,0:28:18.98,0:28:20.81,pangkalahatang teksto,,0,0,0,,Walang oras para sa kanila ngayon
Dialogue: 0,0:28:20.90,0:28:22.69,pangkalahatang teksto,,0,0,0,,May lumitaw na hadlang sa paligid ng Jeongjingak
Dialogue: 0,0:28:23.27,0:28:24.40,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:28:32.32,0:28:34.12,offscreen,,0,0,0,,Mahuhuli ba ako?
Dialogue: 0,0:28:36.29,0:28:38.33,offscreen,,0,0,0,,Tapos papatayin talaga nila
Dialogue: 0,0:29:00.02,0:29:01.35,pangkalahatang text,,0,0,0,,Ito ay honey cookies
Dialogue: 0,0:29:02.19,0:29:05.06,general text,,0,0,0,,Halos wala kang kinain. Tulungan ang iyong sarili
Dialogue: 0,0:29:09.61,0:29:11.28,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:29:13.16,0:29:16.24,general text,,0,0,0,,Nagulat ka ba nang malaman mong anak ako ng Jin family?
Dialogue: 0,0:29:16.78,0:29:19.75,general text,,0,0,0,,Noong una tayong magkita, hindi ko pa kilala ang aking mga magulang
Dialogue: 0,0:29:21.12,0:29:22.54,general text,,0,0,0,,Ito ang iyong payong
Dialogue: 0,0:29:24.17,0:29:26.42,pangkalahatang teksto,,0,0,0,,Dala ko ito kahit saan
Dialogue: 0,0:29:26.50,0:29:28.71,general text,,0,0,0,,Sana makikilala mo ako kung magkita tayong muli
Dialogue: 0,0:29:32.01,0:29:35.14,general text,,0,0,0,,Gwangju Deputy Jin Mu tinulungan kang mahanap ang iyong mga magulang?
Dialogue: 0,0:29:35.22,0:29:36.22,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:29:38.18,0:29:42.43,general text,,0,0,0,,Huwag mo sanang sabihin sa kanya na nagkita na kami dati.
Dialogue: 0,0:29:44.60,0:29:46.69,pangkalahatang teksto,,0,0,0,,Pag nalaman ni nanay,
Dialogue: 0,0:29:46.77,0:29:49.40,pangkalahatang text,,0,0,0,,ang pinagdaanan ko ay madudurog sa puso niya
Dialogue: 0,0:29:51.15,0:29:53.11,general text,,0,0,0,,Kaya huwag mong sabihin sa kanya
Dialogue: 0,0:29:54.53,0:29:56.66,offscreen,,0,0,0,,Lahat ng nakakakilala sa kanya ay pinatay
Dialogue: 0,0:29:57.24,0:29:58.66,voiceover,,0,0,0,,Iniligtas niya ako?
Dialogue: 0,0:30:01.37,0:30:04.50,mga alaala,,0,0,0,,Walang ideya si Jin Mu na kilala natin kung sino siya
Dialogue: 0,0:30:05.04,0:30:06.29,mga alaala,,0,0,0,,Ito ang kanyang kahinaan
Dialogue: 0,0:30:06.79,0:30:10.42,mga alaala,,0,0,0,,Tiyak na pinatay niya ang lahat para itago ang kanyang pagkakakilanlan
Dialogue: 0,0:30:10.50,0:30:13.26,mga alaala,,0,0,0,,Sa huli, mamamatay din siya
Dialogue: 0,0:30:13.88,0:30:16.64,mga alaala,,0,0,0,,Kung plano ng reyna na ilipat ang kaluluwa sa kanyang katawan...
Dialogue: 0,0:30:17.22,0:30:18.55,mga alaala,,0,0,0,,Siya ay dinala dito upang pumatay
Dialogue: 0,0:30:18.64,0:30:21.31,mga alaala,,0,0,0,,Wala siyang ideya tungkol sa anuman at ginagawa niya ang lahat ng kanyang makakaya
Dialogue: 0,0:30:21.39,0:30:23.06,mga alaala,,0,0,0,,Ginagamit siya ni Jin Mu
Dialogue: 0,0:30:24.27,0:30:26.23,mga alaala,,0,0,0,,Parang Nak Soo
Dialogue: 0,0:30:29.94,0:30:32.15,mga alaala,,0,0,0,,Kaya si Yi ay isa lamang pobreng babae
Dialogue: 0,0:30:34.61,0:30:35.78,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,0:30:36.36,0:30:37.61,pangkalahatang teksto,,0,0,0,,Alam mo ba,
Dialogue: 0,0:30:37.70,0:30:40.03,general text,,0,0,0,,na hindi ginagawa ng payong ito ang trabaho nito?
Dialogue: 0,0:30:42.08,0:30:45.29,pangkalahatang teksto,,0,0,0,,Tingnan. Napunit na
Dialogue: 0,0:30:46.96,0:30:48.04,pangkalahatang teksto,,0,0,0,,Totoo
Dialogue: 0,0:30:48.13,0:30:50.38,general text,,0,0,0,,Mahal, sabi ng nagbebenta, mataas ang kalidad
Dialogue: 0,0:30:50.46,0:30:52.25,pangkalahatang teksto,,0,0,0,,Dapat ay nalinlang ka
Dialogue: 0,0:30:58.47,0:31:00.01,pangkalahatang teksto,,0,0,0,,Ako ay lubos na nagtitiwala
Dialogue: 0,0:31:00.93,0:31:02.18,general text,,0,0,0,,Talaga?
Dialogue: 0,0:31:42.55,0:31:44.68,italics,,0,0,0,,Nawawala ba si Master Kahn?
Dialogue: 0,0:31:45.35,0:31:48.23,pangkalahatang teksto,,0,0,0,,Sinugo niya ang kanyang lakas at umalis
Dialogue: 0,0:31:48.73,0:31:51.23,general text,,0,0,0,,Hindi namin siya mahanap Saejukwon
Dialogue: 0,0:31:51.31,0:31:54.36,pangkalahatang teksto,,0,0,0,,Naganap ang pinag-isang konseho sa tabi ng mga training hall
Dialogue: 0,0:31:54.44,0:31:55.65,general text,,0,0,0,,Malamang na hindi siya pumunta doon
Dialogue: 0,0:31:55.73,0:31:57.65,pangkalahatang teksto,,0,0,0,,Nagkaroon ng kalituhan buong araw,
Dialogue: 0,0:31:57.74,0:31:59.45,pangkalahatang text,,0,0,0,,pero napansin sana namin
Dialogue: 0,0:31:59.53,0:32:02.78,pangkalahatang teksto,,0,0,0,,May isang lugar kung saan siya maaaring magtago
Dialogue: 0,0:32:03.45,0:32:04.83,pangkalahatang teksto,,0,0,0,,at hindi napapansin
Dialogue: 0,0:32:07.54,0:32:09.37,pangkalahatang teksto,,0,0,0,,Sa loob ng harang
Dialogue: 0,0:32:10.46,0:32:12.42,general text,,0,0,0,,Baka nandoon siya
Dialogue: 0,0:32:50.33,0:32:51.62,pangkalahatang teksto,,0,0,0,,Nomad
Dialogue: 0,0:32:54.59,0:32:56.00,general text,,0,0,0,,Kasama ko si Jin Mu
Dialogue: 0,0:33:00.84,0:33:02.09,pangkalahatang text,,0,0,0,,kilala kita
Dialogue: 0,0:33:02.76,0:33:04.72,general text,,0,0,0,,Nakita kong ginalaw mo ang iyong kaluluwa sa Jeonbugwan
Dialogue: 0,0:33:04.80,0:33:07.10,pangkalahatang teksto,,0,0,0,,Ang iyong kaluluwa ay umalis sa iyong lumang katawan
Dialogue: 0,0:33:17.82,0:33:20.99,general text,,0,0,0,,Magkampi tayo. Patawarin mo ako
Dialogue: 0,0:33:23.41,0:33:25.41,pangkalahatang teksto,,0,0,0,,Ngayon kailangan ko ng lakas ng tao
Dialogue: 0,0:33:25.49,0:33:27.12,general text,,0,0,0,,May dadalhin ako para sa iyo
Dialogue: 0,0:33:27.20,0:33:28.99,pangkalahatang teksto,,0,0,0,,Enerhiya ng mga mago ng Jeonjingak
Dialogue: 0,0:33:29.08,0:33:31.58,pangkalahatang teksto,,0,0,0,, ay magiging mas mahusay kaysa sa akin
Dialogue: 0,0:33:32.21,0:33:33.75,italics,,0,0,0,,Maghintay dito,
Dialogue: 0,0:33:33.83,0:33:35.79,pangkalahatang text,,0,0,0,,Kukunin ko ang isang tao dito
Dialogue: 0,0:33:37.50,0:33:39.59,pangkalahatang teksto,,0,0,0,,- Magi ng Jeonjingak?\N- {\i1}Oo
Dialogue: 0,0:33:39.67,0:33:41.34,general text,,0,0,0,,Dahil sa hadlang, walang makakagawa
Dialogue: 0,0:33:41.42,0:33:43.72,pangkalahatang teksto,,0,0,0,,hindi umalis o pumasok sa Chongjingak
Dialogue: 0,0:33:44.34,0:33:46.09,pangkalahatang teksto,,0,0,0,,Barrier?
Dialogue: 0,0:34:01.65,0:34:03.03,general text,,0,0,0,,Miss Jin?
Dialogue: 0,0:34:03.61,0:34:05.28,general text,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:34:05.36,0:34:07.28,general text,,0,0,0,,May hinahanap ako,
Dialogue: 0,0:34:07.37,0:34:09.91,pangkalahatang text,,0,0,0,,pero nahulog ko ang payong ko, hindi ako makalakad nang wala ito
Dialogue: 0,0:34:11.66,0:34:12.91,general text,,0,0,0,,Narito siya
Dialogue: 0,0:34:49.24,0:34:50.53,italics,,0,0,0,,Hindi kita papatayin
Dialogue: 0,0:34:50.62,0:34:53.12,pangkalahatang teksto,,0,0,0,,Magdala ng mas maraming salamangkero
Dialogue: 0,0:34:53.70,0:34:54.79,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:34:58.50,0:34:59.96,general text,,0,0,0,,So Yul...
Dialogue: 0,0:35:00.67,0:35:02.21,general text,,0,0,0,,sa Jeonjingak din?
Dialogue: 0,0:35:04.88,0:35:05.80,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:35:09.30,0:35:10.93,italics,,0,0,0,,Sinaktan niya ako ng espada
Dialogue: 0,0:35:11.51,0:35:13.10,general text,,0,0,0,,papatayin ko muna siya
Dialogue: 0,0:35:14.43,0:35:15.60,pangkalahatang teksto,,0,0,0,,Eto na
Dialogue: 0,0:35:16.48,0:35:17.64,pangkalahatang teksto,,0,0,0,,hindi
Dialogue: 0,0:35:21.11,0:35:22.48,pangkalahatang teksto,,0,0,0,,Kung tumanggi ka,
Dialogue: 0,0:35:24.19,0:35:25.53,general text,,0,0,0,,papatayin kita
Dialogue: 0,0:35:25.61,0:35:26.61,general text,,0,0,0,,Gagawin ko ang lahat
Dialogue: 0,0:35:28.20,0:35:30.74,general text,,0,0,0,,May taong gusto kong tanggalin
Dialogue: 0,0:35:32.16,0:35:33.83,general text,,0,0,0,,Ibibigay ko
Dialogue: 0,0:35:35.33,0:35:37.00,pangkalahatang teksto,,0,0,0,,Pakipatay siya
Dialogue: 0,0:35:50.89,0:35:53.18,pangkalahatang teksto,,0,0,0,,Hindi masarap ang meryenda
Dialogue: 0,0:35:53.26,0:35:54.47,pangkalahatang teksto,,0,0,0,,Kuksu din
Dialogue: 0,0:35:56.02,0:35:57.77,voiceover,,0,0,0,,Hindi ko pa nakakausap si Chan Wook,
Dialogue: 0,0:35:58.35,0:36:00.10,behind the scenes,,0,0,0,,kaya magtagal pa ako kay Moo Deok
Dialogue: 0,0:36:01.15,0:36:02.69,pangkalahatang text,,0,0,0,,I'm sorry
Dialogue: 0,0:36:03.94,0:36:05.86,general text,,0,0,0,,Ito ang chapter wine na itinago ni Dan Gu
Dialogue: 0,0:36:13.62,0:36:14.95,pangkalahatang teksto,,0,0,0,,Paano mo gusto ang lasa?
Dialogue: 0,0:36:16.24,0:36:17.79,pangkalahatang teksto,,0,0,0,,Hindi masama
Dialogue: 0,0:36:18.37,0:36:20.04,italics,,0,0,0,,I wonder kung anong ginagawa nila sa labas,
Dialogue: 0,0:36:20.12,0:36:22.67,pangkalahatang teksto,,0,0,0,,- dahil hindi pa nareresolba ang problemang ito\N{\i1}- Gayunpaman,
Dialogue: 0,0:36:22.75,0:36:26.21,general text,,0,0,0,,may mga bulaklak sa paligid, maganda ang panahon,
Dialogue: 0,0:36:26.30,0:36:28.97,general text,,0,0,0,,lahat ay mabango. Hindi naman ganoon kalala
Dialogue: 0,0:36:30.13,0:36:31.05,pangkalahatang teksto,,0,0,0,,Kamahalan
Dialogue: 0,0:36:31.13,0:36:32.89,pangkalahatang teksto,,0,0,0,,Nakakabagot ang paghanga sa mga bulaklak
Dialogue: 0,0:36:32.97,0:36:34.93,general text,,0,0,0,,Gusto mo bang makita ang Hyonggon technique?
Dialogue: 0,0:36:35.56,0:36:38.14,pangkalahatang teksto,,0,0,0,,Ito ay isang medyo kawili-wiling pamamaraan
Dialogue: 0,0:36:38.23,0:36:39.27,general text,,0,0,0,,Talaga?
Dialogue: 0,0:36:40.06,0:36:41.19,pangkalahatang text,,0,0,0,,Okay, ipakita mo sa akin
Dialogue: 0,0:36:41.77,0:36:42.94,italics,,0,0,0,,Oo
Dialogue: 0,0:37:28.86,0:37:29.90,italics,,0,0,0,,Ano?..
Dialogue: 0,0:37:29.99,0:37:31.78,pangkalahatang teksto,,0,0,0,,- Bom!\N - Bom!
Dialogue: 0,0:37:32.90,0:37:34.41,pangkalahatang teksto,,0,0,0,,Bom, gumising ka
Dialogue: 0,0:37:34.49,0:37:35.70,italics,,0,0,0,,- Halika na!\N- Hoy
Dialogue: 0,0:37:35.78,0:37:37.91,italics,,0,0,0,,- Itaas natin\N- Bom
Dialogue: 0,0:37:40.45,0:37:42.54,pangkalahatang teksto,,0,0,0,,Pagkatapos ng spell, iniwan ka ba ng iyong enerhiya?
Dialogue: 0,0:37:42.62,0:37:43.46,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:37:43.54,0:37:45.75,general text,,0,0,0,,Naramdaman ko ang pag-alis ng enerhiya sa akin
Dialogue: 0,0:37:45.83,0:37:46.92,pangkalahatang teksto,,0,0,0,,As if
Dialogue: 0,0:37:48.13,0:37:50.30,pangkalahatang teksto,,0,0,0,,enerhiya na ibinuhos na parang mula sa basag na plorera
Dialogue: 0,0:37:51.17,0:37:52.72,general text,,0,0,0,,Tinuri ko ang energy core niya,
Dialogue: 0,0:37:52.80,0:37:54.55,pangkalahatang teksto,,0,0,0,,nawala sa kanya ang karamihan nito
Dialogue: 0,0:37:56.34,0:37:57.85,pangkalahatang teksto,,0,0,0,,Paano ako mawawalan ng enerhiya?
Dialogue: 0,0:38:08.40,0:38:09.86,pangkalahatang teksto,,0,0,0,,Siguro ito ang espada?
Dialogue: 0,0:38:27.75,0:38:30.17,pangkalahatang teksto,,0,0,0,,Kakalabas lang ng aking enerhiya sa pamamagitan ng espada
Dialogue: 0,0:38:30.75,0:38:32.76,pangkalahatang teksto,,0,0,0,,Sa tingin ko ang problema ay nasa hadlang
Dialogue: 0,0:38:34.80,0:38:36.76,general text,,0,0,0,,Parang kumukuha siya ng energy,
Dialogue: 0,0:38:38.97,0:38:40.51,pangkalahatang text,,0,0,0,,kapag gumamit ka ng spells
Dialogue: 0,0:38:54.53,0:38:56.32,pangkalahatang teksto,,0,0,0,,Hindi ka maaaring gumamit ng mga spell
Dialogue: 0,0:38:56.40,0:38:58.03,pangkalahatang teksto,,0,0,0,,at gumuhit ng mga espada
Dialogue: 0,0:38:58.82,0:39:00.41,pangkalahatang teksto,,0,0,0,,Iwanan natin ang mga espada dito
Dialogue: 0,0:39:09.13,0:39:11.63,general text,,0,0,0,,Ito ang espada ni Nak Su. Kinuha sa akin ni Teacher Li
Dialogue: 0,0:39:12.17,0:39:13.30,general text,,0,0,0,,Meron ka ba nito?
Dialogue: 0,0:39:13.38,0:39:15.97,pangkalahatang teksto,,0,0,0,,Oo. Hiniling niya sa akin na itago ito
Dialogue: 0,0:39:16.05,0:39:17.84,general text,,0,0,0,,Pero hindi nagustuhan ng maid Kim na nasa bahay siya
Dialogue: 0,0:39:17.93,0:39:19.34,general text,,0,0,0,,Kaya iniwan ko ito dito
Dialogue: 0,0:39:34.03,0:39:35.86,mga alaala na italiko,,0,0,0,,Kunin mo ito
Dialogue: 0,0:39:35.94,0:39:37.61,mga alaala,,0,0,0,,at ibigay ito sa kanya pagbalik niya
Dialogue: 0,0:39:39.57,0:39:42.16,general text,,0,0,0,,Hindi ako makakaalis kapag pinagkatiwalaan ako nito
Dialogue: 0,0:39:43.29,0:39:44.49,italics,,0,0,0,,Maiden Kim
Dialogue: 0,0:39:45.62,0:39:46.87,pangkalahatang teksto,,0,0,0,,Anong meron?
Dialogue: 0,0:39:46.96,0:39:49.42,general text,,0,0,0,,Naging maayos ba ang unified council?
Dialogue: 0,0:39:49.50,0:39:50.83,pangkalahatang teksto,,0,0,0,,Halos
Dialogue: 0,0:39:50.92,0:39:54.17,pangkalahatang teksto,,0,0,0,,Ang mga salamangkero mula sa lahat ng pamilya ay papunta na ngayon sa Sosnovy Bor
Dialogue: 0,0:39:55.09,0:39:57.05,general text,,0,0,0,,May nangyari siguro
Dialogue: 0,0:39:58.63,0:40:01.93,memories italics,,0,0,0,,Kailangan niyang bumalik dahil sa lahat ng kaguluhang ito
Dialogue: 0,0:40:09.23,0:40:11.98,general text,,0,0,0,,Babalik ba talaga ang Gwangju Chang Gang?
Dialogue: 0,0:40:36.09,0:40:38.13,pangkalahatang teksto,,0,0,0,,Sino ka?
Dialogue: 0,0:40:41.22,0:40:42.43,pangkalahatang teksto,,0,0,0,,Gwangju
Dialogue: 0,0:40:47.43,0:40:51.65,general text,,0,0,0,,Sino ngayon ang assistant ni Deputy Jin Mu?
Dialogue: 0,0:41:16.54,0:41:19.76,mga alaala,,0,0,0,,Nagbanta si Cho Chan na ibunyag ang katotohanan tungkol kay Young Master Chan
Dialogue: 0,0:41:19.84,0:41:23.09,memories,,0,0,0,,Wala akong choice kundi turuan siya ng alchemy of souls
Dialogue: 0,0:41:23.64,0:41:27.10,memories,,0,0,0,,Nag-wild siya at namatay, so it's all over?
Dialogue: 0,0:41:27.93,0:41:31.27,memories italics,,0,0,0,,ginawa ko lang ito para sa iyo at sa iyong anak
Dialogue: 0,0:41:32.10,0:41:35.94,mga alaala,,0,0,0,,Dahil sa kulam, nawalan ako ng asawa at isang matalik na kaibigan
Dialogue: 0,0:41:37.19,0:41:39.28,mga alaala,,0,0,0,,Aalisin ko lahat ng natitirang reflector
Dialogue: 0,0:41:39.90,0:41:42.15,mga alaala,,0,0,0,,Itatatakan ko ang yelong bato sa Lawa ng Gyeongcheongdaeho
Dialogue: 0,0:41:42.78,0:41:43.91,mga alaala,,0,0,0,,Huwag...
Dialogue: 0,0:41:44.86,0:41:47.49,mga alaala,,0,0,0,,Ang dami mong pinagdaanan para makuha...
Dialogue: 0,0:41:47.58,0:41:49.45,memories,,0,0,0,,Paano mo maaalis ang bato?
Dialogue: 0,0:41:49.54,0:41:50.66,mga alaala,,0,0,0,,Hindi mo magagawa iyon!
Dialogue: 0,0:41:52.21,0:41:54.29,memories,,0,0,0,,Alam mo rin ang alchemy,
Dialogue: 0,0:41:55.13,0:41:57.96,mga alaala,,0,0,0,,kaya sisirain ko ang kaibuturan ng iyong enerhiya
Dialogue: 0,0:41:58.04,0:41:59.46,mga alaala,,0,0,0,,Sirain ang core?
Dialogue: 0,0:42:00.71,0:42:02.17,mga alaala,,0,0,0,,Huwag
Dialogue: 0,0:42:09.22,0:42:12.02,mga alaala na italics,,0,0,0,,Huwag itong sirain
Dialogue: 0,0:42:12.10,0:42:15.27,mga alaala,,0,0,0,,Isinusumpa kong hindi kailanman gagamit ng soul alchemy,
Dialogue: 0,0:42:15.77,0:42:19.11,mga alaala,,0,0,0,,na itinuro mo sa akin. Pangako ko!
Dialogue: 0,0:42:37.58,0:42:40.84,behind the scenes,,0,0,0,,It was worth destroy its core then
Dialogue: 0,0:42:43.13,0:42:46.34,offscreen,,0,0,0,,Sa halip na itago ang ice stone,
Dialogue: 0,0:42:46.93,0:42:48.85,offscreen,,0,0,0,,Dapat ko rin siyang sirain
Dialogue: 0,0:42:51.18,0:42:53.89,behind the scenes,,0,0,0,,Paano niya ito nakuha
Dialogue: 0,0:42:55.27,0:42:57.23,behind the scenes,,0,0,0,,mula sa Gyeongcheongdaeho Lake?
Dialogue: 0,0:42:58.31,0:42:59.90,offscreen,,0,0,0,,May tumulong ba sa kanya?
Dialogue: 0,0:43:31.68,0:43:33.43,general text,,0,0,0,,Okay lang ako
Dialogue: 0,0:43:35.14,0:43:37.56,pangkalahatang teksto,,0,0,0,,Ngunit may isang pagkakaiba sa pagitan natin
Dialogue: 0,0:43:38.94,0:43:40.19,pangkalahatang teksto,,0,0,0,,I
Dialogue: 0,0:43:42.44,0:43:43.94,pangkalahatang teksto,,0,0,0,,nomad
Dialogue: 0,0:43:47.32,0:43:48.66,pangkalahatang teksto,,0,0,0,,Hey Bom
Dialogue: 0,0:43:49.53,0:43:50.91,pangkalahatang teksto,,0,0,0,,Babalikan ka ng ehersisyo
Dialogue: 0,0:43:51.49,0:43:54.16,italics,,0,0,0,,Tama siya, magiging maayos din ang lahat
Dialogue: 0,0:43:54.24,0:43:55.45,pangkalahatang text,,0,0,0,,Cheer up
Dialogue: 0,0:43:55.54,0:43:58.62,offscreen,,0,0,0,,Ang yelong bato ay sumisipsip ng kanilang enerhiya
Dialogue: 0,0:43:58.71,0:44:01.67,offscreen,,0,0,0,,Kung babaguhin ko ang aking katawan at kunin ang bato,
Dialogue: 0,0:44:02.25,0:44:04.92,voiceover,,0,0,0,, kukuha din ba ako ng lakas nila?
Dialogue: 0,0:44:05.63,0:44:08.01,memories italics,,0,0,0,,You gain something, you lose something
Dialogue: 0,0:44:08.09,0:44:10.84,mga alaala,,0,0,0,,Ito ay isang pasanin na dapat mong tiisin
Dialogue: 0,0:44:11.89,0:44:13.72,pangkalahatang teksto,,0,0,0,,Kung gusto kong bumalik ang aking kapangyarihan,
Dialogue: 0,0:44:15.85,0:44:18.14,pangkalahatang teksto,,0,0,0,,Kailangan kong sumipsip ng kanilang lakas
Dialogue: 0,0:44:19.44,0:44:20.35,italics,,0,0,0,,Pagkatapos
Dialogue: 0,0:44:21.02,0:44:22.48,general text,,0,0,0,,mamamatay silang lahat
Dialogue: 0,0:44:33.58,0:44:35.20,pangkalahatang teksto,,0,0,0,,ako ang mananagot
Dialogue: 0,0:44:36.16,0:44:38.04,pangkalahatang teksto,,0,0,0,,sa kanilang pagkamatay
Dialogue: 0,0:44:41.79,0:44:44.54,general text,,0,0,0,,Won Moo Deok, anong ginagawa mo dito?
Dialogue: 0,0:44:50.80,0:44:52.34,offscreen,,0,0,0,,Mamamatay din siya
Dialogue: 0,0:44:53.14,0:44:54.47,italics,,0,0,0,,Delikado dito
Dialogue: 0,0:44:54.55,0:44:56.60,pangkalahatang teksto,,0,0,0,,Kung hinawakan mo ang hadlang,
Dialogue: 0,0:44:56.68,0:44:58.64,general text,,0,0,0,,babali mo lahat ng buto mo
Dialogue: 0,0:44:58.73,0:45:00.23,pangkalahatang text,,0,0,0,,Lumayo
Dialogue: 0,0:45:04.40,0:45:06.11,pangkalahatang teksto,,0,0,0,,Gusto mo bang pasalamatan ako?
Dialogue: 0,0:45:07.94,0:45:10.24,pangkalahatang teksto,,0,0,0,,Nagpakita ako ng pagmamalasakit sa iyo
Dialogue: 0,0:45:13.28,0:45:15.33,general text,,0,0,0,,Nawalan ka ng energy kanina
Dialogue: 0,0:45:16.24,0:45:17.54,general text,,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,0:45:19.70,0:45:22.17,pangkalahatang teksto,,0,0,0,,Nagpapasalamat ka ba sa pamamagitan ng pag-aalala tungkol sa akin?
Dialogue: 0,0:45:23.25,0:45:24.38,pangkalahatang teksto,,0,0,0,,Hindi masama
Dialogue: 0,0:45:25.50,0:45:27.25,general text,,0,0,0,,Okay lang ako
Dialogue: 0,0:45:28.42,0:45:29.59,pangkalahatang teksto,,0,0,0,,Patawarin mo ako
Dialogue: 0,0:45:29.67,0:45:30.92,pangkalahatang teksto,,0,0,0,,Para saan?
Dialogue: 0,0:45:31.01,0:45:34.51,pangkalahatang teksto,,0,0,0,,Para sa paghahanda ng mga kakila-kilabot na meryenda at kuksa
Dialogue: 0,0:45:35.05,0:45:36.72,general text,,0,0,0,,Ni hindi ka makakain
Dialogue: 0,0:45:42.35,0:45:43.94,pangkalahatang teksto,,0,0,0,,Kunin ito
Dialogue: 0,0:45:48.36,0:45:49.98,pangkalahatang text,,0,0,0,,paboritong cookies ni Chan Wook
Dialogue: 0,0:45:50.49,0:45:52.86,general text,,0,0,0,,Ibinabahagi mo ba sa akin ang ibinigay niya sa iyo?
Dialogue: 0,0:45:52.95,0:45:55.45,italics,,0,0,0,,Hindi na kailangan, itago mo ito para sa iyong sarili
Dialogue: 0,0:45:57.37,0:46:00.37,pangkalahatang teksto,,0,0,0,,Alam kong kailangan kong kunin ang mga ito
Dialogue: 0,0:46:01.87,0:46:05.67,general text,,0,0,0,,Ngunit napagpasyahan kong ibigay ang mga ito sa iyo. Lahat
Dialogue: 0,0:46:08.63,0:46:10.25,general text,,0,0,0,,binigay ko sila sa iyo
Dialogue: 0,0:46:11.80,0:46:14.88,voiceover,,0,0,0,,Hindi siya ang pinakamabait na tao, pero inalagaan niya ako all this time
Dialogue: 0,0:46:18.47,0:46:19.35,italics,,0,0,0,,Kunin
Dialogue: 0,0:46:19.43,0:46:21.56,pangkalahatang teksto,,0,0,0,,Gusto kong taos-pusong magpasalamat sa iyo
Dialogue: 0,0:46:22.93,0:46:24.89,pangkalahatang teksto,,0,0,0,,- Taos-puso?{\i1}\N- Oo
Dialogue: 0,0:46:25.56,0:46:26.94,pangkalahatang teksto,,0,0,0,,Mula sa kaibuturan ng aking puso
Dialogue: 0,0:46:28.40,0:46:30.23,pangkalahatang teksto,,0,0,0,,Palagi akong nagpapasalamat sa iyo
Dialogue: 0,0:46:34.65,0:46:37.28,general text,,0,0,0,,Kung gusto mo akong pasalamatan nang taos-puso,
Dialogue: 0,0:46:38.12,0:46:41.33,pangkalahatang teksto,,0,0,0,,bigyan mo ako ng higit pa
Dialogue: 0,0:46:42.79,0:46:44.33,pangkalahatang teksto,,0,0,0,,Isang bagay na mas makabuluhan
Dialogue: 0,0:46:51.63,0:46:52.92,general text,,0,0,0,,Tanggapin mo na lang
Dialogue: 0,0:46:54.42,0:46:56.34,pangkalahatang teksto,,0,0,0,,Ito ang kailangan mo
Dialogue: 0,0:47:00.22,0:47:02.14,pangkalahatang teksto,,0,0,0,,Ikaw ay hindi kapani-paniwala
Dialogue: 0,0:47:04.18,0:47:07.15,pangkalahatang teksto,,0,0,0,,Palaging maglakas-loob at makamit ang iyong layunin
Dialogue: 0,0:47:07.73,0:47:10.52,italics,,0,0,0,,Pero sa tuwing aabot ako sayo, aatras ka
Dialogue: 0,0:47:13.65,0:47:16.45,general text,,0,0,0,,Ang dahilan kung bakit hindi kita sinusubukang pigilan ay,
Dialogue: 0,0:47:17.11,0:47:19.49,general text,,0,0,0,,paano kung sa huli tanggihan mo pa rin ako, ako...
Dialogue: 0,0:47:24.79,0:47:27.54,general text,,0,0,0,,Kalimutan mo na, hindi ko tatanggapin ang iyong pasasalamat sa ganoong dami
Dialogue: 0,0:47:41.01,0:47:43.77,general text,,0,0,0,,Mababawasan ang kalungkutan kung tatanggapin niya ito
Dialogue: 0,0:47:47.77,0:47:48.90,behind the scenes,,0,0,0,,Mas maganda pa yun
Dialogue: 0,0:47:49.69,0:47:52.15,voiceover,,0,0,0,,Hindi ako dapat makonsensya
Dialogue: 0,0:48:16.46,0:48:17.30,italics,,0,0,0,,Moo Dok
Dialogue: 0,0:48:20.18,0:48:21.64,general text,,0,0,0,,May request ako sayo
Dialogue: 0,0:48:22.35,0:48:24.60,general text,,0,0,0,,Pwede ka bang pumunta sa mages wing para sa akin?
Dialogue: 0,0:48:25.89,0:48:27.06,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:48:27.14,0:48:30.14,general text,,0,0,0,,Malamig dito. Pwede mo ba akong dalhan ng kumot?
Dialogue: 0,0:48:31.06,0:48:32.65,general text,,0,0,0,,Nabalitaan ko na naka-imbak sila doon
Dialogue: 0,0:48:46.83,0:48:48.04,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:49:08.18,0:49:09.85,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:49:09.93,0:49:12.06,pangkalahatang teksto,,0,0,0,,Sinusubukang panatilihing nagpapatuloy ang apoy sa brazier
Dialogue: 0,0:49:31.00,0:49:32.00,pangkalahatang text,,0,0,0,,Wow
Dialogue: 0,0:49:32.92,0:49:34.21,general text,,0,0,0,,Seryoso ka ba?
Dialogue: 0,0:49:34.79,0:49:36.04,general text,,0,0,0,,Gago ka ba talaga?
Dialogue: 0,0:49:38.71,0:49:39.92,pangkalahatang text,,0,0,0,,Stop
Dialogue: 0,0:49:43.01,0:49:45.80,general text,,0,0,0,,Tinawag mo lang akong tanga?
Dialogue: 0,0:49:45.89,0:49:47.56,pangkalahatang teksto,,0,0,0,,May daan-daang aklat dito
Dialogue: 0,0:49:47.64,0:49:49.22,pangkalahatang teksto,,0,0,0,,Maaari mong sunugin silang lahat
Dialogue: 0,0:49:49.31,0:49:51.27,general text,,0,0,0,,Nakontrol ko ang apoy gamit ang spell
Dialogue: 0,0:49:51.35,0:49:52.77,pangkalahatang teksto,,0,0,0,,Hindi ako gumamit ng dahas,
Dialogue: 0,0:49:54.02,0:49:55.31,pangkalahatang teksto,,0,0,0,,nalilito
Dialogue: 0,0:49:55.40,0:49:58.77,pangkalahatang teksto,,0,0,0,,Ngunit maaari mo lamang itong takpan ng takip
Dialogue: 0,0:49:58.86,0:50:00.57,italics,,0,0,0,,Tinatawag kang henyo ng mga tao
Dialogue: 0,0:50:00.65,0:50:02.57,pangkalahatang teksto,,0,0,0,,Ngunit nawalan ka ng kontrol sa mahihirap na sitwasyon
Dialogue: 0,0:50:02.65,0:50:05.03,general text,,0,0,0,,- Isa ka lang tanga{\i1}\N- Wag mo akong bastusin
Dialogue: 0,0:50:05.11,0:50:06.66,pangkalahatang text,,0,0,0,,Masasaktan ako
Dialogue: 0,0:50:08.49,0:50:10.08,general text,,0,0,0,,Para alam mo kung paano masaktan
Dialogue: 0,0:50:11.37,0:50:13.54,pangkalahatang teksto,,0,0,0,,Palagi kang kalmado tulad ng tubig
Dialogue: 0,0:50:14.04,0:50:16.79,pangkalahatang teksto,,0,0,0,,Maging ang tubig ay maaaring kumulo o mag-freeze
Dialogue: 0,0:50:17.67,0:50:19.17,italics,,0,0,0,,Hindi siya laging kalmado
Dialogue: 0,0:50:27.43,0:50:29.85,pangkalahatang teksto,,0,0,0,,Naging mahalumigmig dahil sa fog
Dialogue: 0,0:50:29.93,0:50:32.48,general text,,0,0,0,,Nag-apoy ka ba dahil masakit ang binti mo?
Dialogue: 0,0:50:34.85,0:50:37.40,pangkalahatang teksto,,0,0,0,,Naaalala mo ba ito
Dialogue: 0,0:50:38.86,0:50:40.02,italics,,0,0,0,,Okay lang ako
Dialogue: 0,0:50:40.11,0:50:41.28,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:50:45.28,0:50:47.66,general text,,0,0,0,,Gusto mo ba ng pine needle tea
Dialogue: 0,0:50:49.66,0:50:51.16,pangkalahatang teksto,,0,0,0,,Ngunit hindi ko ito maitimpla para sa iyo
Dialogue: 0,0:50:52.20,0:50:53.70,general text,,0,0,0,,Naaalala mo rin ito
Dialogue: 0,0:50:55.54,0:50:57.08,pangkalahatang teksto,,0,0,0,,At ano ang punto nito?
Dialogue: 0,0:50:57.79,0:50:59.54,pangkalahatang teksto,,0,0,0,,Tandaan mo lang
Dialogue: 0,0:51:00.42,0:51:02.67,pangkalahatang text,,0,0,0,,Brew it next time
Dialogue: 0,0:51:05.72,0:51:07.30,behind the scenes,,0,0,0,,Wala nang susunod
Dialogue: 0,0:51:07.39,0:51:11.51,voiceover,,0,0,0,,Kung magpalit ako ng katawan, mamamatay din siya
Dialogue: 0,0:51:11.60,0:51:12.47,italics,,0,0,0,,O mas maganda
Dialogue: 0,0:51:12.56,0:51:14.85,pangkalahatang teksto,,0,0,0,,turuan mo ako
Dialogue: 0,0:51:14.93,0:51:17.90,general text,,0,0,0,,Pagkatapos ay ako na mismo ang magtitimpla nito. Tulad ng huling pagkakataon
Dialogue: 0,0:51:18.56,0:51:19.86,italics,,0,0,0,,Remember?
Dialogue: 0,0:51:27.11,0:51:28.24,pangkalahatang teksto,,0,0,0,,I appreciate
Dialogue: 0,0:51:29.12,0:51:31.12,pangkalahatang teksto,,0,0,0,,lahat ng alaala mula kay Danhyangok
Dialogue: 0,0:51:40.79,0:51:43.75,offscreen,,0,0,0,,Kaya mamamatay si Yul
Dialogue: 0,0:51:48.63,0:51:51.60,general text,,0,0,0,,Pumunta ako sa pakpak ng mga mago para kumuha ng kumot
Dialogue: 0,0:51:51.68,0:51:53.06,general text,,0,0,0,,Pupunta ako
Dialogue: 0,0:52:01.15,0:52:04.07,pangkalahatang text,,0,0,0,,Pupunta ako, at pupunta ka sa Uku
Dialogue: 0,0:52:13.58,0:52:15.33,general text,,0,0,0,,Hinahanap ka niya kahit saan
Dialogue: 0,0:52:27.92,0:52:29.63,voiceover,,0,0,0,,I just need to be Nak Soo again
Dialogue: 0,0:52:30.89,0:52:33.18,voiceover,,0,0,0,, Pinutol ko na ang pakikipag-ugnayan sa kanya noong nakaraan
Dialogue: 0,0:52:35.22,0:52:36.97,voiceover,,0,0,0,,Gayundin ang gagawin ko sa lahat
Dialogue: 0,0:52:50.24,0:52:53.12,pangkalahatang teksto,,0,0,0,,Hindi masisira ang hadlang sa iyong tingin
Dialogue: 0,0:52:59.71,0:53:00.79,general text,,0,0,0,,Nakita mo ba?
Dialogue: 0,0:53:01.62,0:53:03.21,pangkalahatang teksto,,0,0,0,,Dumaan sa kanya ang bato
Dialogue: 0,0:53:04.04,0:53:05.09,pangkalahatang teksto,,0,0,0,,Tama ka
Dialogue: 0,0:53:06.00,0:53:08.21,pangkalahatang teksto,,0,0,0,,Marahil ang mga bagay na gawa sa tubig lamang ang hindi makakalampas
Dialogue: 0,0:53:08.30,0:53:09.80,italics,,0,0,0,,Kakaibang hadlang
Dialogue: 0,0:53:09.88,0:53:12.76,pangkalahatang teksto,,0,0,0,,Nagpasya siya kung ano ang laktawan
Dialogue: 0,0:53:12.84,0:53:14.30,pangkalahatang teksto,,0,0,0,,Anong uri ng hadlang ito?
Dialogue: 0,0:53:15.01,0:53:16.68,general text,,0,0,0,,At ano ang ginagawa ng iba?
Dialogue: 0,0:53:16.76,0:53:20.52,pangkalahatang teksto,,0,0,0,,Napakaraming magagaling na salamangkero doon, ngunit hindi pa rin nila nagawang masira siya
Dialogue: 0,0:53:21.94,0:53:23.69,general text,,0,0,0,,Dahil ba sa yelong bato ang lumikha nito?
Dialogue: 0,0:53:23.77,0:53:27.61,general text,,0,0,0,,Malamang abala sila sa pagtatalo kung sino ang kukuha ng bato
Dialogue: 0,0:53:27.69,0:53:30.82,general text,,0,0,0,,Pero alam nila na naka-lock ako dito
Dialogue: 0,0:53:32.45,0:53:37.20,general text,,0,0,0,,Marahil hindi ka ganoon kahalaga sa reyna na may yelong bato
Dialogue: 0,0:53:38.66,0:53:40.12,italics,,0,0,0,,Paano magiging ganito ang ugali ng isang ina?
Dialogue: 0,0:53:41.12,0:53:43.04,general text,,0,0,0,,O kamukha niya ang tatay ko?
Dialogue: 0,0:53:45.21,0:53:46.71,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:53:46.79,0:53:50.46,general text,,0,0,0,,Sa pagkakaalam mo, hindi ko siya tunay na ina
Dialogue: 0,0:53:51.55,0:53:53.47,pangkalahatang teksto,,0,0,0,,Tulad ng iyong ama sa iyo
Dialogue: 0,0:53:55.64,0:53:57.14,pangkalahatang teksto,,0,0,0,,Pinag-uusapan ito ng lahat
Dialogue: 0,0:53:57.97,0:53:59.89,general text,,0,0,0,,Hindi ako hihingi ng tawad, kahit nasaktan ka
Dialogue: 0,0:54:00.60,0:54:02.48,general text,,0,0,0,,Kung gayon hindi rin ako magpapatalo
Dialogue: 0,0:54:03.19,0:54:06.90,pangkalahatang teksto,,0,0,0,,Kung ang reyna at Jin Mu ay nag-aalok sa iyo ng kapangyarihan ng batong yelo,
Dialogue: 0,0:54:06.98,0:54:08.36,general text,,0,0,0,,maaalis mo ba sila?
Dialogue: 0,0:54:11.36,0:54:15.66,pangkalahatang teksto,,0,0,0,,Mahirap tanggihan ang gayong hindi kapani-paniwalang kapangyarihan
Dialogue: 0,0:54:16.62,0:54:17.83,general text,,0,0,0,,Matapang ka
Dialogue: 0,0:54:19.33,0:54:21.95,pangkalahatang teksto,,0,0,0,,Kailangan ng lakas ng loob para hayagang aminin ang iyong kasakiman
Dialogue: 0,0:54:26.29,0:54:29.80,pangkalahatang teksto,,0,0,0,,At ikaw? Ano ang gagawin mo kung mayroon ka nito?
Dialogue: 0,0:54:33.30,0:54:35.18,pangkalahatang text,,0,0,0,,Magiging parang Master So Kyung
Dialogue: 0,0:54:35.26,0:54:36.43,general text,,0,0,0,,So Kyung?
Dialogue: 0,0:54:38.01,0:54:40.76,general text,,0,0,0,,Nais mo bang maging isang bayani na may tadhana ng isang maharlikang bituin,
Dialogue: 0,0:54:40.85,0:54:42.77,pangkalahatang teksto,,0,0,0,,sirain ang lahat ng mga bato at iligtas ang mundo?
Dialogue: 0,0:54:42.85,0:54:46.44,pangkalahatang teksto,,0,0,0,,Sigurado akong ginawa niya ito nang may pinakamahusay na intensyon
Dialogue: 0,0:54:47.52,0:54:50.86,general text,,0,0,0,,At naniniwala ako na nag-iwan siya ng isang bato para iligtas ang mahal niya.
Dialogue: 0,0:54:51.48,0:54:53.11,pangkalahatang teksto,,0,0,0,,na may pinakamagandang intensyon
Dialogue: 0,0:54:53.61,0:54:56.07,pangkalahatang teksto,,0,0,0,,Nakikita mo, ang bahaging ito ay higit na tumutugon sa akin
Dialogue: 0,0:54:59.41,0:55:01.91,general text,,0,0,0,,So, ito ang isinulat niya sa kanyang libro
Dialogue: 0,0:55:01.99,0:55:05.29,general text,,0,0,0,,Isang dahilan lang ito para hindi matanggal ang bato
Dialogue: 0,0:55:06.08,0:55:07.37,pangkalahatang teksto,,0,0,0,,Sino ang maniniwala dito?
Dialogue: 0,0:55:07.46,0:55:08.83,pangkalahatang teksto,,0,0,0,,Naniniwala ako
Dialogue: 0,0:55:10.79,0:55:13.46,pangkalahatang teksto,,0,0,0,,Dahil ganoon din ang gagawin ko
Dialogue: 0,0:55:31.02,0:55:32.19,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:55:32.27,0:55:34.07,pangkalahatang teksto,,0,0,0,,Ang mga bato ay dumaan sa hadlang
Dialogue: 0,0:55:34.15,0:55:36.61,pangkalahatang text,,0,0,0,,Padalhan sila ng mensahe para mabilis ka nilang mailigtas
Dialogue: 0,0:55:39.82,0:55:40.66,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:55:42.12,0:55:43.24,pangkalahatang teksto,,0,0,0,,Ikaw ay isang henyo
Dialogue: 0,0:55:47.25,0:55:48.33,pangkalahatang teksto,,0,0,0,,Tingnan natin
Dialogue: 0,0:55:51.67,0:55:53.84,pangkalahatang teksto,,0,0,0,,- Barrier{\i1}\N- Hey Chan Wook
Dialogue: 0,0:55:54.59,0:55:56.42,general text,,0,0,0,,May mas malaking bato ba?
Dialogue: 0,0:55:56.51,0:55:58.30,pangkalahatang text,,0,0,0,,Kailangan lang nilang basahin ang iyong mensahe
Dialogue: 0,0:55:58.38,0:56:00.09,general text,,0,0,0,,Hindi mo kailangan ng malaking bato
Dialogue: 0,0:56:00.18,0:56:01.68,italics,,0,0,0,,Dapat na nakasulat sa malalaking titik
Dialogue: 0,0:56:02.39,0:56:04.56,pangkalahatang teksto,,0,0,0,,Hindi maiangat ang batong ito?
Dialogue: 0,0:56:07.43,0:56:08.69,general text,,0,0,0,,- Inom tayo\N- Inom tayo
Dialogue: 0,0:56:09.69,0:56:12.27,general text,,0,0,0,,Nga pala, bakit hindi sinabi sa amin ni Dan Gu
Dialogue: 0,0:56:12.36,0:56:14.86,italics,,0,0,0,,tungkol sa iyong mga lihim na supply ng alak?
Dialogue: 0,0:56:14.94,0:56:17.28,italics,,0,0,0,,Dapat nating inumin ang lahat dito, inumin
Dialogue: 0,0:56:17.36,0:56:19.78,italics,,0,0,0,,- Inom tayo\N- Inom tayo
Dialogue: 0,0:56:24.49,0:56:25.87,general text,,0,0,0,,Nagdala ako ng isa pang brazier
Dialogue: 0,0:56:28.25,0:56:29.46,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:56:30.04,0:56:31.83,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:56:31.92,0:56:33.00,pangkalahatang teksto,,0,0,0,,Sa anong kahulugan?
Dialogue: 0,0:56:35.00,0:56:37.59,pangkalahatang teksto,,0,0,0,,Mr. Si Yul mismo ang kumuha ng kumot
Dialogue: 0,0:56:40.84,0:56:42.64,memories italics,,0,0,0,,Kaya si Yul ay nasa Jeonjingak din
Dialogue: 0,0:56:42.72,0:56:44.60,memories,,0,0,0,,Papatayin ko muna siya
Dialogue: 0,0:57:15.09,0:57:17.59,pangkalahatang teksto,,0,0,0,,Mr. Yul, bawal kang pumasok diyan
Dialogue: 0,0:57:18.84,0:57:21.18,general text,,0,0,0,,- Anong nangyari?\N- Bumalik ka
Dialogue: 0,0:57:22.89,0:57:25.30,general text,,0,0,0,,Nakikita mo ba ako?
Dialogue: 0,0:57:25.89,0:57:27.43,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,0:58:00.18,0:58:01.72,pangkalahatang teksto,,0,0,0,,Mr!
Dialogue: 0,0:58:32.17,0:58:33.38,italics,,0,0,0,,Mr.
Dialogue: 0,0:58:35.34,0:58:38.55,general text,,0,0,0,,Sir, ano po ang dapat nating gawin?
Dialogue: 0,0:58:56.99,0:58:58.15,italics,,0,0,0,,Ano ang gagawin?
Dialogue: 0,0:59:22.22,0:59:23.47,italics,,0,0,0,,Ano ito?
Dialogue: 0,0:59:23.55,0:59:25.64,general text,,0,0,0,,Sino ka?
Dialogue: 0,0:59:54.29,0:59:55.71,pangkalahatang teksto,,0,0,0,,Yul!
Dialogue: 0,0:59:55.79,0:59:56.63,pangkalahatang teksto,,0,0,0,,Yul!
Dialogue: 0,1:00:03.09,1:00:05.47,general text,,0,0,0,,- Mister\N- Okay ka lang?
Dialogue: 0,1:00:37.25,1:00:38.38,pangkalahatang teksto,,0,0,0,,Yul
Dialogue: 0,1:00:40.05,1:00:41.84,pangkalahatang teksto,,0,0,0,,- Ano ang nangyari?{\i1}\N- Nomad
Dialogue: 0,1:00:41.92,1:00:43.09,general text,,0,0,0,,May nomad dito
Dialogue: 0,1:00:43.18,1:00:44.43,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:00:47.93,1:00:49.26,pangkalahatang teksto,,0,0,0,,May nomad
Dialogue: 0,1:00:49.35,1:00:51.98,italics,,0,0,0,,Na-absorb niya ang energy nina Yoon Soo at Jin Ho
Dialogue: 0,1:01:07.62,1:01:10.79,pangkalahatang teksto,,0,0,0,,Ang Nomad ay ang master Kan ng Degantongun, siya ay napakalakas
Dialogue: 0,1:01:10.87,1:01:14.21,pangkalahatang teksto,,0,0,0,,At ginamit niya ang lakas para mag-spell
Dialogue: 0,1:01:14.29,1:01:16.54,pangkalahatang teksto,,0,0,0,,Walang sinuman sa atin ang maaaring gumamit ng puwersa dito
Dialogue: 0,1:01:17.21,1:01:18.63,general text,,0,0,0,,Bakit siya nagtagumpay?
Dialogue: 0,1:01:18.71,1:01:21.09,pangkalahatang teksto,,0,0,0,,Ang lugar na ito ay sumisipsip ng ating enerhiya,
Dialogue: 0,1:01:21.17,1:01:22.63,pangkalahatang teksto,,0,0,0,,pero para sa kanila ito ay kabaligtaran, tila
Dialogue: 0,1:01:25.59,1:01:27.43,mga alaala na italics,,0,0,0,,Kung maibabalik ko ang aking kapangyarihan
Dialogue: 0,1:01:28.05,1:01:30.22,mga alaala,,0,0,0,,at tumakas gamit ang bato?
Dialogue: 0,1:01:30.89,1:01:33.64,mga alaala,,0,0,0,,Pag nahuli ka, baka mapatay ka
Dialogue: 0,1:01:35.10,1:01:36.31,mga alaala,,0,0,0,,Hindi ka ba natatakot?
Dialogue: 0,1:01:36.40,1:01:38.48,mga alaala,,0,0,0,,Medyo natatakot ako
Dialogue: 0,1:01:38.56,1:01:41.07,mga alaala,,0,0,0,,Natatakot akong masira mo ang ating pangako
Dialogue: 0,1:01:41.15,1:01:42.99,mga alaala,,0,0,0,,at iniwan mo ako ng hindi man lang nagpaalam
Dialogue: 0,1:01:45.40,1:01:47.70,mga alaala,,0,0,0,,- Chan Wook, I...\N{\i1}- Mister
Dialogue: 0,1:01:52.16,1:01:55.12,pangkalahatang teksto,,0,0,0,,Nasaan si Moo Dok?
Dialogue: 0,1:01:55.71,1:01:57.50,pangkalahatang text,,0,0,0,,Nandito siya kanina pa
Dialogue: 0,1:01:58.13,1:01:59.38,italics,,0,0,0,,Saan siya nagpunta?
Dialogue: 0,1:02:06.09,1:02:07.97,pangkalahatang text,,0,0,0,,May lumabas na problema
Dialogue: 0,1:02:18.44,1:02:20.77,general text,,0,0,0,,Kung hindi siya napigilan, mamamatay silang lahat
Dialogue: 0,1:02:22.82,1:02:25.69,general text,,0,0,0,,Mamamatay pa rin sila kung magpapalit ako ng katawan
Dialogue: 0,1:02:25.78,1:02:27.70,pangkalahatang text,,0,0,0,,Nakakatuwa na iligtas sila ngayon
Dialogue: 0,1:02:28.82,1:02:30.70,pangkalahatang text,,0,0,0,,Kaya puputulin ko ang pakikipag-ugnayan sa kanila
Dialogue: 0,1:02:35.50,1:02:37.75,general text,,0,0,0,,Pero hindi pa rin ako mapalagay
Dialogue: 0,1:02:38.33,1:02:41.08,pangkalahatang teksto,,0,0,0,,Ito na ang huling beses na ililigtas ko sila
Dialogue: 0,1:02:42.00,1:02:43.17,pangkalahatang teksto,,0,0,0,,Isang beses pa
Dialogue: 0,1:02:45.63,1:02:46.72,pangkalahatang teksto,,0,0,0,,Ikaw...
Dialogue: 0,1:02:48.01,1:02:50.72,general text,,0,0,0,,- Nasaan ka na?\N- Dumating ako
Dialogue: 0,1:02:51.22,1:02:52.30,pangkalahatang teksto,,0,0,0,,Uk...
Dialogue: 0,1:02:52.93,1:02:54.14,pangkalahatang text,,0,0,0,,Maaaring mamatay si Chan Wook!
Dialogue: 0,1:03:15.58,1:03:17.37,memories italics,,0,0,0,,Walang makakatalo sa kanya ngayon
Dialogue: 0,1:03:18.08,1:03:19.71,mga alaala na italics,,0,0,0,,Hindi lahat tayo pwedeng mamatay
Dialogue: 0,1:03:19.79,1:03:22.25,memories italics,,0,0,0,,Susubukan kong akitin siya sa secret room
Dialogue: 0,1:03:25.92,1:03:28.92,italics,,0,0,0,,Kapag ikinulong niya ang nomad kasama niya sa lihim na silid,
Dialogue: 0,1:03:29.01,1:03:30.34,general text,,0,0,0,,Mamamatay din si Uk
Dialogue: 0,1:03:30.88,1:03:31.97,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,1:03:32.72,1:03:34.30,general text,,0,0,0,,Bakit siya pumuntang mag-isa?
Dialogue: 0,1:03:35.22,1:03:37.60,italics,,0,0,0,,Kailangan daw
Dialogue: 0,1:03:37.68,1:03:39.10,general text,,0,0,0,,Sabi na responsibilidad niya
Dialogue: 0,1:03:46.48,1:03:49.07,general text,,0,0,0,,- Saan ka pupunta?\N- Sa secret room
Dialogue: 0,1:03:50.45,1:03:52.45,pangkalahatang teksto,,0,0,0,,Kung bukas ang pinto sa sikretong silid,
Dialogue: 0,1:03:53.87,1:03:56.41,general text,,0,0,0,,na nangangahulugang namatay si Uk at hindi siya maakit doon
Dialogue: 0,1:03:56.49,1:03:57.99,italics,,0,0,0,,Kung sarado ang pinto,
Dialogue: 0,1:03:58.91,1:04:00.54,italics,,0,0,0,,tapos malamang patay na siya
Dialogue: 0,1:04:01.29,1:04:02.50,pangkalahatang teksto,,0,0,0,,Walang saysay ito
Dialogue: 0,1:04:04.79,1:04:07.67,general text,,0,0,0,,Sabi mo hindi mo ako susubukang pigilan
Dialogue: 0,1:04:08.63,1:04:10.38,general text,,0,0,0,,Hindi mo ako mapipigilan
Dialogue: 0,1:04:11.38,1:04:12.76,pangkalahatang text,,0,0,0,,Pakiusap bitawan mo ako
Dialogue: 0,1:05:11.40,1:05:14.99,memories italics,,0,0,0,,Kung sarado ang pinto, malamang patay na siya
Dialogue: 0,1:05:19.33,1:05:22.87,memories italics,,0,0,0,,Ngunit hindi ko ibabalik ang oras, kahit na may pagsisihan ako
Dialogue: 0,1:05:24.33,1:05:25.54,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,1:08:19.42,1:08:20.84,pangkalahatang teksto,,0,0,0,,Buhay ka,
Dialogue: 0,1:08:23.01,1:08:24.43,pangkalahatang teksto,,0,0,0,, aking estudyante
Dialogue: 0,1:08:43.61,1:08:45.24,general text,,0,0,0,,Bakit mo ito itinago sa akin?
Dialogue: 0,1:08:49.49,1:08:50.62,pangkalahatang teksto,,0,0,0,,Dahil
Dialogue: 0,1:08:52.62,1:08:53.87,general text,,0,0,0,,gusto mong mamatay
Dialogue: 0,1:08:55.67,1:08:56.84,pangkalahatang teksto,,0,0,0,,Pagkatapos
Dialogue: 0,1:08:58.09,1:08:59.38,general text,,0,0,0,,bakit ka dumating?
Dialogue: 0,1:09:02.72,1:09:03.84,pangkalahatang teksto,,0,0,0,,Dahil
Dialogue: 0,1:09:08.05,1:09:09.56,pangkalahatang text,,0,0,0,,namatay ka na sana
Dialogue: 0,1:09:16.23,1:09:17.98,pangkalahatang teksto,,0,0,0,,Mula nang kinuha mo ang espada,
Dialogue: 0,1:09:19.36,1:09:20.69,pangkalahatang text,,0,0,0,,gumawa ka
Dialogue: 0,1:09:23.65,1:09:25.41,general text,,0,0,0,,Alam kong iniiwasan mo ako
Dialogue: 0,1:09:25.49,1:09:28.12,pangkalahatang teksto,,0,0,0,,Alam kong nasa iyong mga kamay ang aming buhay
Dialogue: 0,1:09:32.54,1:09:33.87,pangkalahatang teksto,,0,0,0,,Tulad ng ipinangako,
Dialogue: 0,1:09:34.96,1:09:36.54,general text,,0,0,0,,itutok mo muna sa akin ang iyong espada
Dialogue: 0,1:09:50.93,1:09:51.97,mga alaala,,0,0,0,,Papatayin mo,
Dialogue: 0,1:09:52.68,1:09:55.27,mga alaala,,0,0,0,,Ako ang magiging isa na namatay,
Dialogue: 0,1:09:56.02,1:09:57.40,mga alaala,,0,0,0,,pagpalaya ng mersenaryo
Dialogue: 0,1:09:59.56,1:10:00.86,mga alaala,,0,0,0,,Maawa ka -
Dialogue: 0,1:10:01.69,1:10:03.69,mga alaala,,0,0,0,,Ipapangako ko sayo
Dialogue: 0,1:10:27.09,1:10:28.22,pangkalahatang teksto,,0,0,0,,Ngayon,
Dialogue: 0,1:10:32.68,1:10:34.56,pangkalahatang teksto,,0,0,0,,gaya ng sinabi mo,
Dialogue: 0,1:10:36.14,1:10:37.98,general text,,0,0,0,,bigyan mo ako ng isa pang pangako
Dialogue: 0,1:11:51.42,1:11:54.60,preview,,0,0,0,,Anong uri ng tao ang maaaring tumanggi sa gayong hindi kapani-paniwalang kapangyarihan?
Dialogue: 0,1:11:54.68,1:11:56.97,preview,,0,0,0,,Upang protektahan ang dapat nating...
Dialogue: 0,1:11:57.06,1:11:58.47,preview,,0,0,0,,Paano kung ibigay ko ang lahat?
Dialogue: 0,1:11:58.56,1:12:00.35,preview,,0,0,0,,Sinusubukan din kitang protektahan
Dialogue: 0,1:12:01.10,1:12:02.94,preview,,0,0,0,,Anong ginagawa niya dito?
Dialogue: 0,1:12:03.02,1:12:05.52,preview,,0,0,0,,Ang hindi kapani-paniwalang divine power ni Jin Bu Young
Dialogue: 0,1:12:05.61,1:12:07.69,preview,,0,0,0,,nakuha niya ito hindi lamang sa kanyang ina, isang miyembro ng pamilya Jin
Dialogue: 0,1:12:07.78,1:12:11.07,preview,,0,0,0,,Park Jin! Itinago mo ang katotohanan, alam mo nang lubusan ang lahat
Dialogue: 0,1:12:12.99,1:12:17.49,preview,,0,0,0,,At ngayon ang mga dapat umalis ay aalis, at ang mga dapat bumalik ay babalik
Dialogue: 0,1:12:17.58,1:12:20.16,preview,,0,0,0,,Sir, gawin mo ang sa tingin mo ay kailangan
Dialogue: 0,1:12:20.25,1:12:23.42,preview,,0,0,0,,Susubukan kong gawin ito hindi dahil sa katangahan, kundi dahil sa sigasig
Dialogue: 0,1:12:23.50,1:12:25.00,preview,,0,0,0,,Itinuro sa akin ito ng aking guro
Dialogue: 0,1:12:25.08,1:12:27.42,preview,,0,0,0,,- Mukhang maganda\N- Wow
Dialogue: 0,1:12:27.50,1:12:29.84,preview,,0,0,0,,Balita ko may nobya dito na malapit na ang kasal
Dialogue: 0,0:02:56.94,0:02:58.94,nicks,,0,0,0,,

