Dialogue: 0,0:17:16.73,0:17:17.98,نص عام,,0,0,0,,آه أوه، تفضل بالدخول
Dialogue: 0,0:17:18.90,0:17:19.86,نص عام,,0,0,0,,سيدي.
Dialogue: 0,0:17:19.94,0:17:22.19,النص العام,,0,0,0,,لن تخدعونا بهذه الحيل
Dialogue: 0,0:17:23.45,0:17:25.99,النص العام,,0,0,0,,أنت تتابعها منذ دخولك العاصمة
Dialogue: 0,0:17:33.50,0:17:35.83,ذكريات,,0,0,0,,هذا الرجل يطاردنا
Dialogue: 0,0:17:39.59,0:17:42.97,النص العام,,0,0,0,,لقد تبعتها طوال الطريق إلى النزل
Dialogue: 0,0:17:45.13,0:17:47.43,نص عام,,0,0,0,,كنا في اتجاه واحد فقط
Dialogue: 0,0:17:47.51,0:17:48.64,نص عام,,0,0,0,,لا تكذب
Dialogue: 0,0:17:48.72,0:17:51.52,نص عام,,0,0,0,,كنت تحدق بها طوال الوقت!
Dialogue: 0,0:17:51.60,0:17:52.73,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,0:17:52.81,0:17:53.81,خط مائل,,0,0,0,,سونغ يي
Dialogue: 0,0:17:54.52,0:17:56.19,نص عام,,0,0,0,,لا تحرجه
Dialogue: 0,0:18:00.15,0:18:03.57,general text,,0,0,0,,لم أكن مرتاحًا لمتابعتك لي، وكان ذلك أيضًا وقاحة من جانبك
Dialogue: 0,0:18:04.15,0:18:07.11,النص العام,,0,0,0,,إذا كنت لا تريدني أن أبحث عن نزل آخر،
Dialogue: 0,0:18:07.20,0:18:08.32,نص عام,,0,0,0,,ارحل
Dialogue: 0,0:18:09.87,0:18:11.16,نص عام,,0,0,0,,الفتاة
Dialogue: 0,0:18:11.99,0:18:14.33,النص العام,,0,0,0,,لماذا قررت أن أتبعك؟
Dialogue: 0,0:18:14.91,0:18:16.79,نص عام,,0,0,0,,أنت لا تدين لي بأي شيء،
Dialogue: 0,0:18:16.87,0:18:20.13,general text,,0,0,0,,أنا لا أعرفك حتى، لماذا يجب أن ألاحقك؟
Dialogue: 0,0:18:20.21,0:18:23.17,general text,,0,0,0,,- لأنها...\N- اصمتي، سون يي
Dialogue: 0,0:18:24.72,0:18:26.34,نص عام,,0,0,0,,دعها تجيب
Dialogue: 0,0:18:28.51,0:18:32.72,general text,,0,0,0,,واجهت مشاكل كثيرة بسبب الرجال الذين تابعوني بسبب جمالي
Dialogue: 0,0:18:32.81,0:18:33.97,نص عام,,0,0,0,,فقررت،
Dialogue: 0,0:18:35.18,0:18:36.81,نص عام,,0,0,0,,إنك واحد منهم
Dialogue: 0,0:18:37.39,0:18:38.23,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:18:39.15,0:18:39.98,نص عام,,0,0,0,,لكن الأمر ليس كذلك
Dialogue: 0,0:18:42.36,0:18:43.73,نص عام,,0,0,0,,الجمال لم يبهر
Dialogue: 0,0:18:44.44,0:18:46.20,نص عام,,0,0,0,,ولم أتبعك
Dialogue: 0,0:18:47.86,0:18:49.20,نص عام,,0,0,0,,حسنًا إذن،
Dialogue: 0,0:18:51.20,0:18:52.54,نص عام,,0,0,0,,أنا آسف
Dialogue: 0,0:18:52.62,0:18:54.54,نص عام,,0,0,0,,هل يمكنني الصعود إذن؟
Dialogue: 0,0:19:07.05,0:19:09.47,نص عام,,0,0,0,,- سيدة هو\N- نعم؟
Dialogue: 0,0:19:09.55,0:19:11.18,نص عام,,0,0,0,,يجب أن تأكل
Dialogue: 0,0:19:13.22,0:19:14.39,نص عام,,0,0,0,,هذا الوغد...
Dialogue: 0,0:19:15.35,0:19:16.43,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:19:17.02,0:19:19.90,general text,,0,0,0,,هل تشعر بالحرج لأنك قد تلتقي به مرة أخرى؟
Dialogue: 0,0:19:21.15,0:19:22.44,نص عام,,0,0,0,,لا
Dialogue: 0,0:19:23.40,0:19:24.90,نص عام,,0,0,0,,أنا فقط لا أشعر بأنني بخير
Dialogue: 0,0:19:25.48,0:19:27.24,نص عام,,0,0,0,,تغيير الملابس الجافة
Dialogue: 0,0:19:27.32,0:19:29.74,نص عام,,0,0,0,,سأحضر لك بعض العصيدة
Dialogue: 0,0:21:10.38,0:21:11.59,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:21:14.97,0:21:17.72,نص عام,,0,0,0,,ماذا كان ذلك؟
Dialogue: 0,0:21:19.01,0:21:20.56,نص عام,,0,0,0,,هل اتبعته؟
Dialogue: 0,0:21:21.43,0:21:22.60,نص عام,,0,0,0,,نعم
Dialogue: 0,0:21:24.48,0:21:26.11,نص عام,,0,0,0,,أنا سعيد لأنك لم تتأذى
Dialogue: 0,0:21:26.94,0:21:28.07,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:21:29.73,0:21:30.73,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:21:31.24,0:21:32.78,نص عام,,0,0,0,,إذا شعرت بالسوء،
Dialogue: 0,0:21:33.57,0:21:35.32,نص عام,,0,0,0,,اذهب إلى سيجوكون في سوسنوفي بور
Dialogue: 0,0:21:35.41,0:21:36.95,النص العام,,0,0,0,,هل تعرف عن سايجوكون؟
Dialogue: 0,0:21:37.03,0:21:38.74,نص عام,,0,0,0,,أنا من سيجوكون...
Dialogue: 0,0:21:42.87,0:21:44.58,نص عام,,0,0,0,,أنا هو يونغ أوك
Dialogue: 0,0:22:03.89,0:22:06.98,ذكريات بخط مائل,,0,0,0,,بدلاً من وجود صديق قريب منك، لديك صفارة
Dialogue: 0,0:22:08.23,0:22:10.11,ذكريات بخط مائل,,0,0,0,,فتركك صديقك
Dialogue: 0,0:22:13.65,0:22:14.90,نص عام,,0,0,0,,كنت تعلم
Dialogue: 0,0:22:16.95,0:22:18.45,نص عام,,0,0,0,,من أنا كل هذا الوقت
Dialogue: 0,0:23:19.72,0:23:20.97,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:23:21.05,0:23:22.76,نص عام,,0,0,0,,كيف حالك هناك؟
Dialogue: 0,0:23:22.85,0:23:25.68,نص عام,,0,0,0,,حاول النهوض. ببطء
Dialogue: 0,0:23:29.27,0:23:30.81,نص عام,,0,0,0,,الوحش!
Dialogue: 0,0:23:32.90,0:23:33.94,نص عام,,0,0,0,,ابتلاع الروح!
Dialogue: 0,0:23:34.02,0:23:35.11,نص عام,,0,0,0,,إنه ابتلاع الروح!
Dialogue: 0,0:23:35.19,0:23:37.44,النص العام,,0,0,0,,- ابتلاع الروح\N- ابتلاع الروح!
Dialogue: 0,0:24:10.64,0:24:13.44,ذكريات,,0,0,0,,صحيح أن دان تشو شخص آخر
Dialogue: 0,0:24:14.44,0:24:18.11,ذكريات,,0,0,0,,الشخص الحقيقي يمكنه إيقاف التحجير
Dialogue: 0,0:24:18.19,0:24:20.95,التعليق الصوتي,,0,0,0,,نعم، اذهب إلى Dan Zhu الخاص بك
Dialogue: 0,0:24:23.24,0:24:24.83,النص العام,,0,0,0,,هل كيل تشو مفقود؟
Dialogue: 0,0:24:24.91,0:24:28.66,general text,,0,0,0,,لا نعرف أين هو منذ أن طارد خادمة تشان ووك
Dialogue: 0,0:24:30.21,0:24:31.79,نص عام,,0,0,0,,خادمة تشانغ ووك؟
Dialogue: 0,0:24:32.42,0:24:34.17,النص العام,,0,0,0,,لماذا يحتاجها؟
Dialogue: 0,0:24:34.25,0:24:37.92,النص العام,,0,0,0,,بصراحة كان يتابع تشان ووك
Dialogue: 0,0:24:38.96,0:24:42.68,general text,,0,0,0,,تميمة الروح التي بقيت بعد ناك سو كانت مملوكة لتشان ووك
Dialogue: 0,0:24:43.43,0:24:46.56,general text,,0,0,0,,ربما كان يعتقد أن تشان ووك كان مرتبطًا بها بطريقةٍ ما.
Dialogue: 0,0:24:46.64,0:24:48.89,نص عام,,0,0,0,,كان يجب أن تخبرني سابقًا!
Dialogue: 0,0:24:49.52,0:24:50.77,نص عام,,0,0,0,,يقول ليصمت
Dialogue: 0,0:24:50.85,0:24:53.15,نص عام,,0,0,0,,ربما أردت العثور على أدلة دامغة
Dialogue: 0,0:24:53.77,0:24:55.90,general text,,0,0,0,,أخبر جميع السحرة أن يجدوا كيل جو
Dialogue: 0,0:25:02.15,0:25:03.82,نص عام,,0,0,0,,سوار تشان ووك
Dialogue: 0,0:25:03.91,0:25:06.37,النص العام,,0,0,0,,هل وجدت أين أجروا كيمياء النفوس؟
Dialogue: 0,0:25:06.45,0:25:07.95,النص العام,,0,0,0,,دان جو يبحث عن السيد.
Dialogue: 0,0:25:08.04,0:25:10.08,نص عام,,0,0,0,,السيد فتفحص محيط المعبد
Dialogue: 0,0:25:10.16,0:25:12.79,النص العام,,0,0,0,,- كانوا في الهيكل؟\N- نعم
Dialogue: 0,0:25:12.87,0:25:16.92,general text,,0,0,0,,أشك في أن المملكة المتحدة قادرة على الكيمياء
Dialogue: 0,0:25:17.00,0:25:18.34,نص عام,,0,0,0,,السيد لي,
Dialogue: 0,0:25:18.42,0:25:20.92,general text,,0,0,0,,ماذا لو هاجرت روح شخص ما إلى جسد أوكا؟
Dialogue: 0,0:25:21.01,0:25:23.76,نص عام,,0,0,0,,لا تقلق. أنا متأكد من أنه بخير
Dialogue: 0,0:25:28.39,0:25:30.56,النص العام,,0,0,0,,سوف تحميه
Dialogue: 0,0:25:30.64,0:25:31.81,خط مائل,,0,0,0,,أين
Dialogue: 0,0:25:31.89,0:25:35.60,general text,,0,0,0,,رأسنا، متى تكون هذه الفوضى هنا؟
Dialogue: 0,0:25:36.52,0:25:38.23,نص عام,,0,0,0,,قبل أن تولد المملكة المتحدة...
Dialogue: 0,0:25:39.98,0:25:42.03,نص عام,,0,0,0,,قبل 20 سنة...
Dialogue: 0,0:25:42.61,0:25:43.61,نص عام,,0,0,0,,تشان غان
Dialogue: 0,0:25:44.49,0:25:46.32,نص عام,,0,0,0,,أجريت كيمياء النفوس؟
Dialogue: 0,0:25:51.58,0:25:53.83,النص العام,,0,0,0,,غوانغجو جيونبوغوان والسحر؟
Dialogue: 0,0:25:54.67,0:25:56.00,نص عام,,0,0,0,,هذا مضحك فحسب!
Dialogue: 0,0:25:56.08,0:25:57.29,نص عام,,0,0,0,,أخبرني جين مو عن هذا
Dialogue: 0,0:25:58.92,0:26:00.96,نص عام,,0,0,0,,لم أجرؤ على سؤاله،
Dialogue: 0,0:26:02.38,0:26:03.97,نص عام,,0,0,0,,لهذا السبب أتيت إليك
Dialogue: 0,0:26:08.43,0:26:09.81,نص عام,,0,0,0,,الآنسة دو هوا
Dialogue: 0,0:26:11.06,0:26:12.77,نص عام,,0,0,0,,قلق من أن غوانغجو
Dialogue: 0,0:26:13.77,0:26:16.69,نص عام,,0,0,0,,مهتم ببعض التعويذات الغريبة
Dialogue: 0,0:26:17.52,0:26:20.82,نص عام,,0,0,0,,لكنه لم يدم طويلاً
Dialogue: 0,0:26:21.40,0:26:23.65,النص العام,,0,0,0,,غوانغجو لم تعد إلى المنزل منذ عام
Dialogue: 0,0:26:24.28,0:26:27.82,general text,,0,0,0,,تعويذات تدربت مع جين مو في غرفة جيونبوغوان السرية
Dialogue: 0,0:26:27.91,0:26:28.87,نص عام,,0,0,0,,لكن
Dialogue: 0,0:26:28.95,0:26:32.74,نص عام,,0,0,0,,توقف عندما حملت زوجته
Dialogue: 0,0:26:36.67,0:26:40.54,ذكريات بخط مائل,,0,0,0,,إنه ابن ملك متوفى
Dialogue: 0,0:26:41.21,0:26:42.30,ذكريات,,0,0,0,,ملك
Dialogue: 0,0:26:43.09,0:26:45.80,ذكريات,,0,0,0,,مات بسبب المرض ولم يتمكن من الحركة
Dialogue: 0,0:26:45.88,0:26:47.26,ذكريات,,0,0,0,,كيف يكون هذا ممكنًا؟
Dialogue: 0,0:26:49.22,0:26:52.68,ذكريات,,0,0,0,,هذا ممكن بسبب كيمياء النفوس
Dialogue: 0,0:26:54.64,0:26:56.02,نص عام,,0,0,0,,أن تكون ساحرًا،
Dialogue: 0,0:26:57.35,0:26:59.52,general text,,0,0,0,,كان مشتعلًا باهتمام بسيط بمثل هذه الأشياء
Dialogue: 0,0:26:59.60,0:27:00.52,نص عام,,0,0,0,,لا
Dialogue: 0,0:27:01.86,0:27:03.15,نص عام,,0,0,0,,ارتكب
Dialogue: 0,0:27:04.65,0:27:05.90,نص عام,,0,0,0,,شيء لا يمكن إصلاحه
Dialogue: 0,0:27:06.70,0:27:10.70,نص عام,,0,0,0,,مع حياة دو هوا وووك
Dialogue: 0,0:27:21.00,0:27:24.38,general text,,0,0,0,,الساحر من تشونغجينغاك يبحث بشكل عاجل عن سيدنا
Dialogue: 0,0:27:34.18,0:27:35.89,نص عام,,0,0,0,,لم أكن أعلم أنك هنا يا عمي
Dialogue: 0,0:27:35.97,0:27:37.27,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:27:38.44,0:27:39.64,نص عام,,0,0,0,,أعتقد,
Dialogue: 0,0:27:40.48,0:27:42.27,general text,,0,0,0,,وقعت المملكة المتحدة ضحية كيمياء الأرواح
Dialogue: 0,0:27:43.36,0:27:44.44,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:28:08.84,0:28:10.22,خط مائل,,0,0,0,,هذا جيونبوجوان
Dialogue: 0,0:28:10.76,0:28:13.72,خلف الكواليس,,0,0,0,,دان تشو الحقيقي خلف هذه الجدران؟
Dialogue: 0,0:28:36.91,0:28:39.50,نص عام,,0,0,0,,هذا هو الطريق إلى القصر
Dialogue: 0,0:28:40.33,0:28:43.17,general text,,0,0,0,,هل دان تشو الحقيقي موجود؟
Dialogue: 0,0:28:52.97,0:28:54.14,نص عام,,0,0,0,,أنا من جيونبوغوان
Dialogue: 0,0:28:54.85,0:28:56.60,نص عام,,0,0,0,,ربما يكون هذا الأمر عاجلاً
Dialogue: 0,0:29:04.77,0:29:06.02,نص عام,,0,0,0,,أظهر وجهك
Dialogue: 0,0:29:06.11,0:29:08.02,نص عام,,0,0,0,,هذا أمر عاجل. بعيدًا عن الطريق
Dialogue: 0,0:29:08.11,0:29:09.40,نص عام,,0,0,0,,أظهر وجهك أولاً
Dialogue: 0,0:29:31.92,0:29:32.97,نص عام,,0,0,0,,ابتلاع الروح
Dialogue: 0,0:29:35.93,0:29:37.05,نص عام,,0,0,0,,وراءه
Dialogue: 0,0:31:26.70,0:31:28.79,نص عام,,0,0,0,,حقيقي في القصر
Dialogue: 0,0:31:31.42,0:31:32.75,نص عام,,0,0,0,,حجر الجليد، أليس كذلك؟
Dialogue: 0,0:31:33.92,0:31:35.46,نص عام,,0,0,0,,لقد ذكرته
Dialogue: 0,0:31:37.13,0:31:40.26,general text,,0,0,0,,سأجده وأنقذها من مصير مماثل لك.
Dialogue: 0,0:32:11.50,0:32:12.92,نص عام,,0,0,0,,انتظر، هو...
Dialogue: 0,0:32:13.88,0:32:15.25,نص عام,,0,0,0,,انظر
Dialogue: 0,0:32:15.34,0:32:16.88,النص العام,,0,0,0,,هل مات فعلاً؟
Dialogue: 0,0:32:16.96,0:32:18.76,نص عام,,0,0,0,,- المس\N- هل يستحق الأمر؟
Dialogue: 0,0:32:36.86,0:32:38.86,general text,,0,0,0,,حاول الدخول إلى القصر حتى تحول إلى حجر
Dialogue: 0,0:32:40.74,0:32:41.95,النص العام,,0,0,0,,هل قتلته؟
Dialogue: 0,0:32:42.99,0:32:44.45,نص عام,,0,0,0,,كيف نجرؤ؟
Dialogue: 0,0:32:44.53,0:32:47.37,general text,,0,0,0,,فجأة ظهر ساحر مجهول وقتله
Dialogue: 0,0:32:48.12,0:32:50.37,نص عام,,0,0,0,,من أي عائلة هو؟ هل رأيت الوجه؟
Dialogue: 0,0:32:50.45,0:32:52.00,نص عام,,0,0,0,,لا، كان مخفياً
Dialogue: 0,0:32:52.08,0:32:54.75,نص عام,,0,0,0,,لكنني رأيت أنه استخدم
Dialogue: 0,0:33:01.21,0:33:02.38,خط مائل,,0,0,0,,كانت تانسو
Dialogue: 0,0:33:05.84,0:33:08.72,النص العام,,0,0,0,,- تانسو؟\N- نعم أنا متأكد
Dialogue: 0,0:33:09.85,0:33:11.39,النص العام,,0,0,0,,ضرب بقوة السيف
Dialogue: 0,0:33:14.10,0:33:17.19,خارج الشاشة,,0,0,0,,تانغسو كانت مملوكة لناك سو
Dialogue: 0,0:33:17.27,0:33:20.27,خارج الشاشة,,0,0,0,,هل كان هناك شخص آخر أتقنها؟
Dialogue: 0,0:33:29.33,0:33:31.79,نص عام,,0,0,0,,سمعت أنك قبضت على مبتلاع الروح
Dialogue: 0,0:33:32.45,0:33:35.75,نص عام,,0,0,0,,جئنا لنرى من هو
Dialogue: 0,0:33:37.04,0:33:39.96,نص عام,,0,0,0,,بالطبع. يمكنك أن تنظر
Dialogue: 0,0:34:03.86,0:34:04.99,النص العام,,0,0,0,,هذا كيل جو،
Dialogue: 0,0:34:05.86,0:34:08.66,نص عام,,0,0,0,,أحد قومك
Dialogue: 0,0:34:10.58,0:34:12.74,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:34:15.20,0:34:17.83,نص عام,,0,0,0,,أدخل الجثة وأخرج الجميع
Dialogue: 0,0:34:17.92,0:34:18.79,نص عام,,0,0,0,,نعم
Dialogue: 0,0:34:24.42,0:34:27.59,خلف الكواليس,,0,0,0,,كان جين مو معي عندما أجروا الكيمياء
Dialogue: 0,0:34:28.43,0:34:30.01,خارج الإطار,,0,0,0,,وهو أيضًا مرتبك
Dialogue: 0,0:34:31.01,0:34:34.47,خارج الإطار,,0,0,0,,لم يكن يعلم أنهم قاموا بالكيمياء
Dialogue: 0,0:34:36.18,0:34:39.56,general text,,0,0,0,,سأعتني بالأمر بما أن كل شيء حدث في جيونبوغوان
Dialogue: 0,0:34:39.65,0:34:41.36,نص عام,,0,0,0,,لا علاقة لها بسوسنوفي بور
Dialogue: 0,0:34:42.07,0:34:43.15,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:34:43.90,0:34:46.86,نص عام,,0,0,0,,إذا لزم الأمر، سنقدم المساعدة
Dialogue: 0,0:34:47.45,0:34:49.78,نص عام,,0,0,0,,إذا لزم الأمر
Dialogue: 0,0:34:52.37,0:34:54.83,مائل,,0,0,0,,بدوي آخر تحول إلى ابتلاع الروح؟
Dialogue: 0,0:34:55.41,0:34:58.54,النص العام,,0,0,0,,ولحسن الحظ أنه تم القبض عليه وقتله
Dialogue: 0,0:34:58.62,0:35:00.63,نص عام,,0,0,0,,ومن هو؟
Dialogue: 0,0:35:00.71,0:35:01.92,نص عام,,0,0,0,,كيل جو,
Dialogue: 0,0:35:02.00,0:35:05.21,نص عام,,0,0,0,,الساحر جيونبوغوان
Dialogue: 0,0:35:07.05,0:35:09.18,مائل,,0,0,0,,أصبح "كيل تشو" بدويًا؟
Dialogue: 0,0:35:10.18,0:35:13.26,general text,,0,0,0,,أمسك به جونبوغوان؟
Dialogue: 0,0:35:13.35,0:35:15.35,نص عام,,0,0,0,,تم القبض عليه أمام القصر
Dialogue: 0,0:35:15.43,0:35:18.48,general text,,0,0,0,,لقد حاول الدخول إلى القصر وهو في حالة جنون
Dialogue: 0,0:35:19.44,0:35:21.15,نص عام,,0,0,0,,هل أتى إلى هنا؟
Dialogue: 0,0:35:21.23,0:35:23.40,general text,,0,0,0,,فجأة ظهر ساحر،
Dialogue: 0,0:35:23.48,0:35:25.61,نص عام,,0,0,0,,الذي استخدمته تانسو
Dialogue: 0,0:35:28.95,0:35:30.99,نص عام,,0,0,0,,ومن هو؟
Dialogue: 0,0:35:32.53,0:35:34.66,نص عام,,0,0,0,,كيل جو قتل ناك سو
Dialogue: 0,0:35:34.74,0:35:35.99,نص عام,,0,0,0,,- ماذا؟\N- ناك سو؟
Dialogue: 0,0:35:36.08,0:35:37.50,نص عام,,0,0,0,,لقد عادت!
Dialogue: 0,0:35:37.58,0:35:39.46,النص العام,,0,0,0,,- ناك سو؟\N- مرتزق؟
Dialogue: 0,0:35:40.00,0:35:44.04,general text,,0,0,0,,ساحر يحمل تانسو ظهر أمام القصر
Dialogue: 0,0:35:44.13,0:35:45.92,نص عام,,0,0,0,,لقد امتلكها ناك سو
Dialogue: 0,0:35:46.00,0:35:47.71,خط مائل,,0,0,0,,- حقاً؟\N- مذهل
Dialogue: 0,0:35:47.80,0:35:49.17,النص العام,,0,0,0,,- أكانت هي؟\N- هي؟
Dialogue: 0,0:35:49.26,0:35:50.55,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:35:50.63,0:35:51.97,نص عام,,0,0,0,,مات ناك سو
Dialogue: 0,0:35:52.05,0:35:52.93,خط مائل,,0,0,0,,بالضبط!
Dialogue: 0,0:35:53.01,0:35:55.93,النص العام,,0,0,0,,رأى الجميع هنا كيف احترق جسدها
Dialogue: 0,0:35:56.01,0:35:58.35,نص عام,,0,0,0,,رأيته بنفسي
Dialogue: 0,0:35:58.43,0:35:59.60,نص عام,,0,0,0,,- نعم\N- بالضبط
Dialogue: 0,0:35:59.68,0:36:02.10,النص العام,,0,0,0,,الجسد يحترق أما الروح فهي حية
Dialogue: 0,0:36:02.19,0:36:05.57,general text,,0,0,0,,محارب الظل أصبح بدوياً!
Dialogue: 0,0:36:05.65,0:36:07.32,نص عام,,0,0,0,,- ماذا؟\N- حقاً؟
Dialogue: 0,0:36:07.40,0:36:09.32,النص العام,,0,0,0,,- لا يمكن أن يكون\N- بجدية؟
Dialogue: 0,0:36:09.40,0:36:11.28,نص عام,,0,0,0,,لكن ناك سو فتاة
Dialogue: 0,0:36:11.36,0:36:13.41,general text,,0,0,0,,وقتل كيل جو على يد شاب
Dialogue: 0,0:36:13.49,0:36:16.66,نص عام,,0,0,0,,شاب طويل القامة يرتدي رداء أزرق
Dialogue: 0,0:36:17.33,0:36:19.33,نص عام,,0,0,0,,ناك سو بدوي، أليس كذلك؟
Dialogue: 0,0:36:19.41,0:36:22.08,general text,,0,0,0,,يمكنها أن تهاجر إلى جسد هذا الشاب
Dialogue: 0,0:36:23.88,0:36:25.79,النص العام,,0,0,0,,وبعد ذلك أصبحت أقوى
Dialogue: 0,0:36:27.30,0:36:28.96,نص عام,,0,0,0,,كانت قوية
Dialogue: 0,0:36:29.05,0:36:32.51,general text,,0,0,0,,ولكن في جسد الرجل أصبح أقوى
Dialogue: 0,0:36:34.72,0:36:36.14,general text,,0,0,0,,مقتل كيل جو هو انتقامها
Dialogue: 0,0:36:36.22,0:36:38.68,نص عام,,0,0,0,,جيونبوغوان للجثة المحروقة
Dialogue: 0,0:36:39.35,0:36:40.85,نص عام,,0,0,0,,وقتل أهلها
Dialogue: 0,0:36:40.93,0:36:42.35,النص العام,,0,0,0,,لماذا يجب أن ننتقم؟
Dialogue: 0,0:36:42.44,0:36:44.31,نص عام,,0,0,0,,غابة الصنوبر قتلت ناك سو
Dialogue: 0,0:36:45.31,0:36:50.07,النص العام,,0,0,0,"لقد عاد ناك سو المذهل مرتديًا ملابس زرقاء"
Dialogue: 0,0:36:50.15,0:36:52.74,النص العام,,0,0,0,"غابة الصنوبر هي هدفها القادم"
Dialogue: 0,0:36:52.82,0:36:55.99,نص عام,,0,0,0,,هذه هي الشائعات
Dialogue: 0,0:36:56.07,0:36:58.95,general text,,0,0,0,,تم القبض على ابتلاع الروح قبل ساعتين فقط
Dialogue: 0,0:36:59.04,0:37:00.83,نص عام,,0,0,0,,وهذه الشائعات السخيفة بالفعل؟
Dialogue: 0,0:37:01.41,0:37:05.21,النص العام,,0,0,0,,مثل هذه الشائعات سريعة كالنار في الهشيم
Dialogue: 0,0:37:05.29,0:37:06.96,نص عام,,0,0,0,,والشائعات لا أساس لها من الصحة
Dialogue: 0,0:37:07.04,0:37:10.00,نص عام,,0,0,0,,استخدم الساحر طنسا،
Dialogue: 0,0:37:10.09,0:37:12.47,نص عام,,0,0,0,,مثل ناك سو
Dialogue: 0,0:37:12.55,0:37:14.47,general text,,0,0,0,,وكانت هي الوحيدة التي تملكه؟
Dialogue: 0,0:37:16.05,0:37:18.76,نص عام,,0,0,0,,أود ذلك، لقد أتقنته الآن
Dialogue: 0,0:37:20.56,0:37:23.27,general text,,0,0,0,,إذا انتشرت هذه الشائعات في جميع أنحاء سوسنوفي بور،
Dialogue: 0,0:37:23.35,0:37:26.44,نص عام,,0,0,0,,سوف تجيب. تأكد من عدم حدوث ذلك
Dialogue: 0,0:37:27.23,0:37:28.27,نص عام,,0,0,0,,نعم
Dialogue: 0,0:37:31.65,0:37:34.65,النص العام,,0,0,0,,يا لها من نعمة أنك أصبحت مبتلع الروح
Dialogue: 0,0:37:34.74,0:37:36.16,نص عام,,0,0,0,,ليس سيدًا شابًا
Dialogue: 0,0:37:37.07,0:37:40.28,general text,,0,0,0,,ولكن لماذا وجدنا سواره هناك؟
Dialogue: 0,0:37:41.95,0:37:44.16,نص عام,,0,0,0,,سنعرف عندما نجده
Dialogue: 0,0:37:50.21,0:37:52.76,نص عام,,0,0,0,,أنت تبدو سيئًا
Dialogue: 0,0:38:00.05,0:38:01.39,نص عام,,0,0,0,,يجب عليك
Dialogue: 0,0:38:02.14,0:38:04.48,نص عام,,0,0,0,,اذهب إلى المنزل وانتظره هناك
Dialogue: 0,0:38:14.82,0:38:16.53,نص عام,,0,0,0,,هل تشعر بالتوعك؟
Dialogue: 0,0:38:17.15,0:38:20.20,نص عام,,0,0,0,,فوجئت جدًا بكعكة العسل التي أكلتها بالأمس
Dialogue: 0,0:38:20.28,0:38:22.29,نص عام,,0,0,0,,ما زال في حلقي
Dialogue: 0,0:38:24.33,0:38:27.29,general text,,0,0,0,,شعرت بالخوف الشديد عندما سمعت عن ابتلاع الروح،
Dialogue: 0,0:38:27.37,0:38:29.71,النص العام,,0,0,0,,أن الروح خرجت من الجسد أولاً ثم عادت
Dialogue: 0,0:38:37.84,0:38:40.26,نص عام,,0,0,0,,هل عادت الحقيقة؟
Dialogue: 0,0:38:43.18,0:38:44.52,general text,,0,0,0,,هل هذه أنت أيتها الخادمة كيم؟
Dialogue: 0,0:38:45.35,0:38:47.85,نص عام,,0,0,0,,لا، الفصل. أنا خادمة باك
Dialogue: 0,0:38:49.06,0:38:52.69,general text,,0,0,0,,كان من الممكن أن أضرب السيد الشاب على ظهره، الأمر الذي يخيفني كثيرًا
Dialogue: 0,0:38:54.78,0:38:56.19,نص عام,,0,0,0,,اضربني بدلاً من ذلك
Dialogue: 0,0:38:58.57,0:39:01.16,نص عام,,0,0,0,,أسمح لميد باك
Dialogue: 0,0:39:01.74,0:39:02.83,نص عام,,0,0,0,,هيا
Dialogue: 0,0:39:02.91,0:39:04.66,نص عام,,0,0,0,,يدي قوية
Dialogue: 0,0:39:04.74,0:39:06.70,نص عام,,0,0,0,,سيؤلمك
Dialogue: 0,0:39:07.58,0:39:09.79,نص عام,,0,0,0,,لن أبكي,
Dialogue: 0,0:39:09.87,0:39:11.17,نص عام,,0,0,0,,إيقاع
Dialogue: 0,0:39:14.80,0:39:17.72,النص العام,,0,0,0,,اعتبر أنك سبق أن ضربتني مرة واحدة
Dialogue: 0,0:39:19.05,0:39:20.34,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:39:21.05,0:39:23.18,general text,,0,0,0,,هل ستفعل لي شيئًا غير سار ردًا على ذلك؟
Dialogue: 0,0:39:23.26,0:39:25.77,نص عام,,0,0,0,,ثم ألغي هذه الضربة
Dialogue: 0,0:39:25.85,0:39:27.18,نص عام,,0,0,0,,اضربني أيضًا
Dialogue: 0,0:39:28.02,0:39:29.14,نص عام,,0,0,0,,هيا
Dialogue: 0,0:39:30.10,0:39:31.56,نص عام,,0,0,0,,أسرع
Dialogue: 0,0:39:37.23,0:39:38.44,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:39:40.20,0:39:41.86,نص عام,,0,0,0,,لا أريد أن أؤذيك
Dialogue: 0,0:39:44.24,0:39:46.20,النص العام,,0,0,0,,كرئيس سوسنوفي بور،
Dialogue: 0,0:39:47.45,0:39:50.41,النص العام,,0,0,0,,سأضطر إلى التصرف ببرود وبلا قلب
Dialogue: 0,0:39:51.08,0:39:52.42,نص عام,,0,0,0,,لكنني حقاً
Dialogue: 0,0:39:53.54,0:39:55.21,نص عام,,0,0,0,,لا أريد أن أؤذيك
Dialogue: 0,0:40:00.88,0:40:02.22,نص عام,,0,0,0,,هل أنت قلق بشأن ذلك؟
Dialogue: 0,0:40:02.76,0:40:06.22,general text,,0,0,0,,ماذا سألوني عن السيد تشانغ غان بالأمس؟
Dialogue: 0,0:40:06.81,0:40:08.77,نص عام,,0,0,0,,لقد حدث الكثير
Dialogue: 0,0:40:08.85,0:40:10.85,نص عام,,0,0,0,,كوني الرأس، لم أستطع
Dialogue: 0,0:40:11.85,0:40:13.81,نص عام,,0,0,0,,كن موضوعياً
Dialogue: 0,0:40:14.77,0:40:16.90,general text,,0,0,0,,ضربتك أعادتني إلى صوابي
Dialogue: 0,0:40:17.73,0:40:20.95,نص عام,,0,0,0,,الآن يجب أن نتصرف بحكمة
Dialogue: 0,0:40:25.12,0:40:27.03,نص عام,,0,0,0,,يمكنك أن تهزمني بهدوء
Dialogue: 0,0:40:28.37,0:40:29.95,نص عام,,0,0,0,,كخادمة باك
Dialogue: 0,0:40:31.87,0:40:33.04,نص عام,,0,0,0,,منك
Dialogue: 0,0:40:34.04,0:40:35.63,نص عام,,0,0,0,,سأقبل
Dialogue: 0,0:40:51.81,0:40:53.14,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:40:53.23,0:40:55.77,general text,,0,0,0,,قال السيد هو لمعرفة مصدر السحر
Dialogue: 0,0:40:55.86,0:40:58.15,نص عام,,0,0,0,,وعلى الفور وجدت هذا
Dialogue: 0,0:40:59.15,0:41:01.28,نص عام,,0,0,0,,ضائع على ما يبدو
Dialogue: 0,0:41:02.70,0:41:04.24,نص عام,,0,0,0,,لست بحاجة إليه بعد الآن؟
Dialogue: 0,0:41:05.28,0:41:07.07,نص عام,,0,0,0,,لا، ليس بعد الآن
Dialogue: 0,0:41:07.78,0:41:10.24,نص عام,,0,0,0,,كادت أن تفقد كنز عائلة جين
Dialogue: 0,0:41:11.33,0:41:12.58,نص عام,,0,0,0,,شكرًا على العثور عليه
Dialogue: 0,0:41:14.00,0:41:15.71,نص عام,,0,0,0,,لقد فقدت شيئًا آخر
Dialogue: 0,0:41:17.00,0:41:18.84,general text,,0,0,0,,ألن تبحث عن مو دوك؟
Dialogue: 0,0:41:20.88,0:41:21.92,نص عام,,0,0,0,,أين هي؟
Dialogue: 0,0:41:23.67,0:41:25.30,النص العام,,0,0,0,,لقد وجدتها عندما كانت مختبئة في الغابة
Dialogue: 0,0:41:26.76,0:41:29.68,النص العام,,0,0,0,,كانت مجروحة وتنزف
Dialogue: 0,0:41:44.99,0:41:45.91,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:41:47.62,0:41:48.78,نص عام,,0,0,0,,المضيف,
Dialogue: 0,0:41:49.33,0:41:51.79,نص عام,,0,0,0,,كيف تتركني؟
Dialogue: 0,0:41:51.87,0:41:52.87,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:41:54.62,0:41:58.08,general text,,0,0,0,,لقد هربت وتركتني
Dialogue: 0,0:41:58.92,0:42:00.42,نص عام,,0,0,0,,العب معي
Dialogue: 0,0:42:04.13,0:42:07.22,النص العام,,0,0,0,,نعم... لقد هربت
Dialogue: 0,0:42:07.80,0:42:08.76,نص عام,,0,0,0,,بالضبط!
Dialogue: 0,0:42:08.84,0:42:12.14,general text,,0,0,0,,واجهنا ابتلاع الروح بينما كان يختبئ من المطر
Dialogue: 0,0:42:12.22,0:42:13.52,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:42:13.60,0:42:16.89,النص العام,,0,0,0,,كاد يبتلعني هذا الروح
Dialogue: 0,0:42:19.40,0:42:20.44,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:42:22.02,0:42:25.74,general text,,0,0,0,,كنت خائفًا جدًا لدرجة أنني لم أستطع التفكير في أي شيء وهربت
Dialogue: 0,0:42:27.32,0:42:30.70,general text,,0,0,0,,أخطأ يول في اعتبار مو دوك ابتلاعًا للروح وكاد أن يقتله
Dialogue: 0,0:42:31.37,0:42:34.41,general text,,0,0,0,,لو لم يعتني بها لكان مو دوك قد مات
Dialogue: 0,0:42:39.96,0:42:41.42,نص عام,,0,0,0,,يول,
Dialogue: 0,0:42:41.50,0:42:45.42,general text,,0,0,0,,شكرًا لك على إنقاذ مو ديوك والعناية بها.
Dialogue: 0,0:42:51.30,0:42:53.10,general text,,0,0,0,,هل هربت حقاً وتركتها؟
Dialogue: 0,0:42:58.89,0:43:00.73,نص عام,,0,0,0,,وإلا سأموت
Dialogue: 0,0:43:01.36,0:43:02.82,نص عام,,0,0,0,,أحيانًا عليك أن تفكر في نفسك فقط
Dialogue: 0,0:43:04.32,0:43:06.40,نص عام,,0,0,0,,ماذا تشاهد؟ لا توافق؟
Dialogue: 0,0:43:07.78,0:43:10.03,نص عام,,0,0,0,,على أية حال، أنا سعيد،
Dialogue: 0,0:43:10.11,0:43:12.83,نص عام,,0,0,0,,أن كلانا بخير
Dialogue: 0,0:43:22.42,0:43:23.25,نص عام,,0,0,0,,نعم
Dialogue: 0,0:43:29.55,0:43:31.39,نص عام,,0,0,0,,سمعت أنك مختبئ في دانهيانغوك
Dialogue: 0,0:43:31.97,0:43:33.85,النص العام,,0,0,0,,هل سمعت ما قاله قائدنا؟
Dialogue: 0,0:43:33.93,0:43:36.06,النص العام,,0,0,0,,غابة الصنوبر ستحمل عارك
Dialogue: 0,0:43:36.14,0:43:37.64,نص عام,,0,0,0,,أنا متعب جدًا
Dialogue: 0,0:43:38.39,0:43:40.81,general text,,0,0,0,,لماذا، إذا لم أكن حتى عضوًا في سوسنوفي بور؟
Dialogue: 0,0:43:40.89,0:43:43.02,النص العام,,0,0,0,,مبارزة مع الأمير في أسبوعين
Dialogue: 0,0:43:43.65,0:43:47.23,general text,,0,0,0,,لا تظهر في المدينة حتى ذلك الحين، لا تسبب مشاكل
Dialogue: 0,0:43:47.32,0:43:48.53,نص عام,,0,0,0,,أخفض رأسك
Dialogue: 0,0:43:54.53,0:43:56.79,نص عام,,0,0,0,,شكرًا لاهتمامك بي
Dialogue: 0,0:43:56.87,0:43:58.95,general text,,0,0,0,,على ما يبدو، المملكة المتحدة تتأقلم بشكل جيد بدون سوار
Dialogue: 0,0:44:00.04,0:44:02.25,نص عام,,0,0,0,,أعتقد أنه يستطيع التحكم في الطاقة الآن
Dialogue: 0,0:44:04.54,0:44:07.42,general text,,0,0,0,,خاطر بحياته من جديد وحصل على ما يريد
Dialogue: 0,0:44:07.50,0:44:09.01,نص عام,,0,0,0,,وكنت هناك مرة أخرى
Dialogue: 0,0:44:11.80,0:44:15.60,general text,,0,0,0,,لو كان الأمر يضايقك إلى هذا الحد لتركتني أموت
Dialogue: 0,0:44:16.22,0:44:17.35,نص عام,,0,0,0,,ربما
Dialogue: 0,0:44:19.10,0:44:20.48,نص عام,,0,0,0,,في المرة القادمة
Dialogue: 0,0:44:27.36,0:44:28.57,مائل,,0,0,0,,مو دوك
Dialogue: 0,0:44:29.65,0:44:30.90,نص عام,,0,0,0,,أنا قادم يا معلم
Dialogue: 0,0:44:33.66,0:44:34.70,نص عام,,0,0,0,,لقد انطلقنا
Dialogue: 0,0:44:40.58,0:44:42.62,general text,,0,0,0,,المملكة المتحدة لم تجرح
Dialogue: 0,0:44:43.54,0:44:44.46,نص عام,,0,0,0,,هذا جيد
Dialogue: 0,0:44:45.38,0:44:47.29,نص عام,,0,0,0,,رأى
Dialogue: 0,0:44:47.38,0:44:49.88,general text,,0,0,0,,من كان مع كيل جو عندما غيّر النفوس؟
Dialogue: 0,0:44:49.96,0:44:52.88,نص عام,,0,0,0,,ربما الرجل ذو الرداء الأزرق
Dialogue: 0,0:44:52.97,0:44:55.39,general text,,0,0,0,,كانت المملكة المتحدة مشغولة جدًا بالركض لتنظر
Dialogue: 0,0:44:55.47,0:44:57.18,general text,,0,0,0,,هل سألت خادمته؟
Dialogue: 0,0:44:58.60,0:45:00.35,نص عام,,0,0,0,,لا بد أنها رأت التعويذات
Dialogue: 0,0:45:03.35,0:45:04.60,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:45:10.61,0:45:12.78,نص عام,,0,0,0,,إذا رأته بالكاد تعرف ما هو
Dialogue: 0,0:45:13.99,0:45:16.74,النص العام,,0,0,0,,هذه خادمة عادية لا تعرف سوى القليل عن السحر
Dialogue: 0,0:45:19.41,0:45:21.58,نص عام,,0,0,0,,ماذا عن اليد؟
Dialogue: 0,0:45:23.33,0:45:24.16,نص عام,,0,0,0,,تألم؟
Dialogue: 0,0:45:26.71,0:45:29.75,general text,,0,0,0,,كان هناك سم من السحر في العاكس الذي لمسته
Dialogue: 0,0:45:30.59,0:45:31.67,نص عام,,0,0,0,,لكنني بخير
Dialogue: 0,0:45:33.34,0:45:34.72,نص عام,,0,0,0,,سأذهب
Dialogue: 0,0:46:12.84,0:46:14.67,نص عام,,0,0,0,,لماذا أردت رؤيتي؟
Dialogue: 0,0:46:16.55,0:46:20.76,نص عام,,0,0,0,,سمعت أنك أخذت هدايا زفافي
Dialogue: 0,0:46:21.39,0:46:22.72,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:46:22.81,0:46:25.93,general text,,0,0,0,,أتخشى أن أدمرهم؟
Dialogue: 0,0:46:26.02,0:46:30.02,نص عام,,0,0,0,,سأحتفظ بهم حتى زفافك القادم
Dialogue: 0,0:46:30.56,0:46:31.98,نص عام,,0,0,0,,ارميهم بعيدًا
Dialogue: 0,0:46:32.07,0:46:34.40,النص العام,,0,0,0,,الزواج لم يعد من أولوياتي
Dialogue: 0,0:46:35.40,0:46:37.53,نص عام,,0,0,0,,لا تشعر بالإحراج الشديد
Dialogue: 0,0:46:37.61,0:46:42.12,general text,,0,0,0,,تم التحضير لحفل الزفاف سراً، ولم يعلم عنه إلا القليل من الناس
Dialogue: 0,0:46:44.16,0:46:45.12,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:46:47.37,0:46:49.50,خط مائل,,0,0,0,,تشو يونغ!
Dialogue: 0,0:46:53.13,0:46:54.88,نص عام,,0,0,0,,يقولون أنك ستتزوجين
Dialogue: 0,0:46:55.67,0:46:58.80,general text,,0,0,0,,سمعت عن الهدايا، وأنني وجدت حرفيًا في صناعة الخواتم
Dialogue: 0,0:46:59.34,0:47:02.10,نص عام,,0,0,0,,على ما يبدو أن الشائعات انتشرت
Dialogue: 0,0:47:02.18,0:47:03.10,نص عام,,0,0,0,,مبروك
Dialogue: 0,0:47:03.18,0:47:05.43,نص عام,,0,0,0,,مبروك السيد الشاب باك
Dialogue: 0,0:47:06.10,0:47:08.77,general text,,0,0,0,,- أنا؟\N- أعرف أنك أنت من سيتزوج
Dialogue: 0,0:47:08.85,0:47:10.69,خط مائل,,0,0,0,,لقد تلقى الهدايا
Dialogue: 0,0:47:10.77,0:47:12.61,مائل,,0,0,0,,ذهبت معك لتجربة الخواتم
Dialogue: 0,0:47:12.69,0:47:13.82,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:47:13.90,0:47:16.74,النص العام,,0,0,0,,كانت هناك شائعات سخيفة بأنك ستتزوج تشان ووك
Dialogue: 0,0:47:17.32,0:47:18.28,خط مائل,,0,0,0,,لا؟
Dialogue: 0,0:47:18.36,0:47:20.03,خط مائل,,0,0,0,,سوف تتزوجان
Dialogue: 0,0:47:21.70,0:47:22.74,نص عام,,0,0,0,,نعم هذا صحيح
Dialogue: 0,0:47:22.82,0:47:24.74,نص عام,,0,0,0,,لكن لا تتحدث عنه
Dialogue: 0,0:47:24.83,0:47:26.25,نص عام,,0,0,0,,ما زال سراً
Dialogue: 0,0:47:26.87,0:47:28.00,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:47:28.62,0:47:29.79,نص عام,,0,0,0,,إلى اللقاء
Dialogue: 0,0:47:31.04,0:47:33.42,نص عام,,0,0,0,,لقد أخبرتك أنه دان جو
Dialogue: 0,0:47:33.50,0:47:36.59,نص عام,,0,0,0,,بالضبط. إنها ليست مجنونة بالزواج من أوكا مرة أخرى
Dialogue: 0,0:47:36.67,0:47:38.26,خط مائل,,0,0,0,,لا تقل
Dialogue: 0,0:47:40.93,0:47:42.01,نص عام,,0,0,0,,دان جو
Dialogue: 0,0:47:42.09,0:47:43.89,general text,,0,0,0,,لماذا تأكدت من كلامهم؟
Dialogue: 0,0:47:44.47,0:47:46.77,general text,,0,0,0,,هذا أفضل من الاعتراف بأن المملكة المتحدة رفضتك مرتين
Dialogue: 0,0:47:47.39,0:47:50.19,general text,,0,0,0,,لنفترض أنك هذه المرة رفضت الزواج مني
Dialogue: 0,0:47:50.27,0:47:52.06,نص عام,,0,0,0,,لكن هذه ستكون مجرد شائعات
Dialogue: 0,0:47:53.69,0:47:55.98,general text,,0,0,0,,هل توافق على هذا الترتيب؟
Dialogue: 0,0:47:56.94,0:47:58.49,نص عام,,0,0,0,,سوف تشعر بالحرج
Dialogue: 0,0:47:59.74,0:48:00.95,نص عام,,0,0,0,,أوافق
Dialogue: 0,0:48:28.93,0:48:29.89,النص العام,,0,0,0,,ستنك مو ديوك؟
Dialogue: 0,0:48:31.48,0:48:33.94,نص عام,,0,0,0,,هل عدت إلى هنا مرة أخرى؟ لم تتأذى؟
Dialogue: 0,0:48:34.94,0:48:35.94,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:48:38.86,0:48:40.40,نص عام,,0,0,0,,انسى. الابتعاد
Dialogue: 0,0:48:45.53,0:48:47.70,general text,,0,0,0,,هل تبحث عن مو ديوك مرة أخرى؟
Dialogue: 0,0:48:47.78,0:48:50.54,نص عام,,0,0,0,,لا. بدا الفستان مألوفًا
Dialogue: 0,0:48:51.87,0:48:54.33,نص عام,,0,0,0,,باعها مو دوك لنا
Dialogue: 0,0:48:55.08,0:48:57.09,النص العام,,0,0,0,,- تم البيع؟\N- نعم
Dialogue: 0,0:48:57.17,0:49:00.09,general text,,0,0,0,,قالت إنها هدية من رجل تافه
Dialogue: 0,0:49:00.17,0:49:01.59,نص عام,,0,0,0,,وأيضاً ما يتم توفيره
Dialogue: 0,0:49:01.67,0:49:03.63,نص عام,,0,0,0,,ولن يطلب إرجاع الفستان
Dialogue: 0,0:49:05.26,0:49:07.89,نص عام,,0,0,0,,هل قالت ذلك حقًا؟
Dialogue: 0,0:49:07.97,0:49:11.77,نص عام,,0,0,0,,نعم. لا يمكن أن يسير Stink Moo Deok والحرير جنبًا إلى جنب
Dialogue: 0,0:49:12.73,0:49:13.98,نص عام,,0,0,0,,انتبه إلى لغتك
Dialogue: 0,0:49:14.73,0:49:15.60,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:49:15.69,0:49:19.07,general text,,0,0,0,,لقد أعطيتها هذا الاسم وأنا وحدي من يستطيع أن أطلق عليها هذا الاسم.
Dialogue: 0,0:49:19.15,0:49:20.28,نص عام,,0,0,0,,لست أنت
Dialogue: 0,0:49:21.23,0:49:22.28,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:49:23.99,0:49:25.07,نص عام,,0,0,0,,وكذلك
Dialogue: 0,0:49:27.16,0:49:29.45,النص العام,,0,0,0,,بدت جميلة في ذلك الفستان
Dialogue: 0,0:49:30.16,0:49:32.54,النص العام,,0,0,0,,أفضل منك في تلك الرداء الأزرق
Dialogue: 0,0:49:33.12,0:49:34.79,نص عام,,0,0,0,,يبدو أنك لا تحب ذلك
Dialogue: 0,0:49:36.38,0:49:37.63,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:49:37.71,0:49:40.34,نص عام,,0,0,0,,كل شيء هنا هكذا
Dialogue: 0,0:49:40.42,0:49:42.46,نص عام,,0,0,0,,هذا رداء ناك سو
Dialogue: 0,0:49:42.55,0:49:43.59,نص عام,,0,0,0,,من؟
Dialogue: 0,0:49:43.67,0:49:47.05,general text,,0,0,0,,البدوي ناك سو قتل الساحر جيونبوغوان أمام القصر
Dialogue: 0,0:49:47.64,0:49:49.81,النص العام,,0,0,0,,كانت ترتدي رداءً مماثلاً
Dialogue: 0,0:49:49.89,0:49:53.52,النص العام,,0,0,0,,الآن كل شخص في العاصمة لديه هذا
Dialogue: 0,0:49:59.06,0:50:02.32,نص عام,,0,0,0,,- تعال واشتري رداء ناك سو\N- لدي واحد
Dialogue: 0,0:50:02.40,0:50:04.15,النص العام,,0,0,0,,هذا سيحمي روحك من الانغماس
Dialogue: 0,0:50:04.24,0:50:05.65,نص عام,,0,0,0,,- هذا\N- خذ
Dialogue: 0,0:50:05.74,0:50:08.16,خط مائل,,0,0,0,,أريد هذا
Dialogue: 0,0:50:08.24,0:50:10.45,نص عام,,0,0,0,,- كيب ناك سو\N- جربه
Dialogue: 0,0:50:15.12,0:50:17.21,نص عام,,0,0,0,,بدوي باللون الأزرق
Dialogue: 0,0:50:18.33,0:50:20.59,النص العام,,0,0,0,,الجميع يعتقد أن ناك سو قد عاد من بين الأموات
Dialogue: 0,0:50:22.30,0:50:26.13,نص عام,,0,0,0,,ولكن بفضل "ناك سو باللون الأزرق"،
Dialogue: 0,0:50:26.22,0:50:28.89,النص العام,,0,0,0,,لا أحد يتذكر القتال بين أوكا والأمير
Dialogue: 0,0:50:30.05,0:50:32.01,نص عام,,0,0,0,,أتساءل أين ووك ومو دوك؟
Dialogue: 0,0:50:33.14,0:50:34.52,نص عام,,0,0,0,,لم يكونوا في دانهيانغوك
Dialogue: 0,0:50:35.39,0:50:36.85,نص عام,,0,0,0,,أنا متأكد أنهم بخير
Dialogue: 0,0:50:37.56,0:50:40.19,نص عام,,0,0,0,,سيعودون خلال أسبوعين
Dialogue: 0,0:50:42.65,0:50:44.28,نص عام,,0,0,0,,بالمناسبة يول
Dialogue: 0,0:50:46.86,0:50:48.57,النص العام,,0,0,0,,اشتريته لنفسي أيضًا. هل تريد تجربتها؟
Dialogue: 0,0:50:54.29,0:50:55.25,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:50:59.83,0:51:02.38,نص عام,,0,0,0,,من يكون؟
Dialogue: 0,0:51:02.46,0:51:05.63,النص العام,,0,0,0,,ناك سو باللون الأزرق، يملك تانسو؟
Dialogue: 0,0:51:13.64,0:51:15.77,نص عام,,0,0,0,,قلت هذا قبر مبتلع الأرواح
Dialogue: 0,0:51:17.35,0:51:18.94,نص عام,,0,0,0,,لذلك ينبغي أن يكون هنا
Dialogue: 0,0:51:20.81,0:51:21.94,نص عام,,0,0,0,,والدك
Dialogue: 0,0:51:23.90,0:51:25.48,نص عام,,0,0,0,,حبيبتي
Dialogue: 0,0:51:26.03,0:51:29.78,general text,,0,0,0,,ظننت أنه قُتل على يد سحرة العائلات الأربع
Dialogue: 0,0:51:31.49,0:51:34.12,general text,,0,0,0,,أخذني جين مو إليه، دعوته دان تشو
Dialogue: 0,0:51:34.20,0:51:35.24,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:51:36.87,0:51:39.37,نص عام,,0,0,0,,كان والدي بدوياً، وقد تم استخدامه
Dialogue: 0,0:51:41.08,0:51:43.38,general text,,0,0,0,,واستغلوني ثم تخلوا عني
Dialogue: 0,0:51:46.96,0:51:48.51,نص عام,,0,0,0,,كما قال كيل جو،
Dialogue: 0,0:51:49.63,0:51:51.38,النص العام,,0,0,0,,سوف أتحجر وأموت
Dialogue: 0,0:51:56.22,0:51:57.64,نص عام,,0,0,0,,عندما أتحول إلى حجر،
Dialogue: 0,0:52:02.06,0:52:03.73,نص عام,,0,0,0,,هل ستدفنني هنا؟
Dialogue: 0,0:52:15.24,0:52:19.33,نص عام,,0,0,0,,لقد اكتشفت مكان دان تشو الحقيقي
Dialogue: 0,0:52:21.00,0:52:24.04,نص عام,,0,0,0,,في القصر. الحقيقي هناك
Dialogue: 0,0:52:28.51,0:52:31.38,نص عام,,0,0,0,,أخبرني عن حجر الجليد
Dialogue: 0,0:52:33.05,0:52:34.34,نص عام,,0,0,0,,هل أنت متأكد،
Dialogue: 0,0:52:34.93,0:52:38.18,نص عام,,0,0,0,,تم تدميره
Dialogue: 0,0:52:39.56,0:52:43.27,general text,,0,0,0,,السيد سيو كيونغ ورئيس جينيوون قبل 200 عام؟
Dialogue: 0,0:52:46.06,0:52:47.65,نص عام,,0,0,0,,نحن على يقين أنه
Dialogue: 0,0:52:49.23,0:52:50.69,نص عام,,0,0,0,,ليس في سوسنوفي بور
Dialogue: 0,0:53:11.88,0:53:13.80,نص عام,,0,0,0,,مرحبًا دان تشو
Dialogue: 0,0:53:30.11,0:53:33.78,general text,,0,0,0,,أراد كيل جو حجرًا ثلجيًا، فأتى إلى القصر لرؤيتي
Dialogue: 0,0:53:34.95,0:53:36.11,نص عام,,0,0,0,,لم أكن أعرف،
Dialogue: 0,0:53:37.07,0:53:39.58,نص عام,,0,0,0,,أن كيل جو يعرف من هو دان جو الحقيقي
Dialogue: 0,0:53:40.29,0:53:42.20,النص العام,,0,0,0,,اليوم الذي تستعيد فيه عائلة تشوي السلطة،
Dialogue: 0,0:53:42.83,0:53:46.75,general text,,0,0,0,,وسوسنوفي بور، سبب سقوطنا، قد تم تدميره
Dialogue: 0,0:53:48.75,0:53:51.96,نص عام,,0,0,0,,قريب جدًا بالفعل. ثم سأبدأ في الحكم في دايهو
Dialogue: 0,0:53:53.72,0:53:56.26,النص العام,,0,0,0,,إنني أتطلع إلى هذا اليوم ليس أقل منك
Dialogue: 0,0:53:57.68,0:54:01.10,general text,,0,0,0,,يجب أن نجد ونقتل الشخص الذي تعامل مع كيل جو
Dialogue: 0,0:54:02.60,0:54:05.06,general text,,0,0,0,,ربما كان هذا الرجل ينتظر حتى كيل جو
Dialogue: 0,0:54:05.14,0:54:07.90,نص عام,,0,0,0,,سيأتي إلى القصر من أجل الحجر
Dialogue: 0,0:54:07.98,0:54:10.57,نص عام,,0,0,0,,إذا كان يعرف مكان الحجر،
Dialogue: 0,0:54:11.07,0:54:12.44,نص عام,,0,0,0,,يجب أن تجد
Dialogue: 0,0:54:13.57,0:54:14.86,النص العام,,0,0,0,,وقتله
Dialogue: 0,0:54:19.45,0:54:20.91,نص عام,,0,0,0,,لا أعرف من هو،
Dialogue: 0,0:54:21.95,0:54:23.91,النص العام,,0,0,0,,لكن دان تشو الحقيقي موجود في القصر ومعه حجر
Dialogue: 0,0:54:24.00,0:54:26.71,general text,,0,0,0,,بمساعدتها لا يتحول البدو إلى ابتلاع أرواح.
Dialogue: 0,0:54:28.79,0:54:32.05,general text,,0,0,0,,إذن، علينا الدخول إلى القصر والعثور على دان تشو؟
Dialogue: 0,0:54:32.13,0:54:34.13,نص عام,,0,0,0,,هذا مستحيل الآن
Dialogue: 0,0:54:34.92,0:54:37.38,النص العام,,0,0,0,,أنا ساحر ضعيف رفضه جيونغجينجاك
Dialogue: 0,0:54:38.01,0:54:40.60,نص عام,,0,0,0,,لكنني سأمضي قدماً
Dialogue: 0,0:54:41.72,0:54:44.22,نص عام,,0,0,0,,وأنا بالتأكيد سأصل إلى القصر
Dialogue: 0,0:54:45.81,0:54:46.85,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,0:54:48.10,0:54:49.35,نص عام,,0,0,0,,سوف أجد
Dialogue: 0,0:54:50.40,0:54:51.77,نص عام,,0,0,0,,حجر لك
Dialogue: 0,0:54:57.28,0:54:58.32,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:54:59.20,0:55:01.53,النص العام,,0,0,0,,معلمك ليس قوياً بما يكفي لتشجيعك
Dialogue: 0,0:55:02.62,0:55:05.29,نص عام,,0,0,0,,أو الغلاف من الخلف
Dialogue: 0,0:55:06.96,0:55:10.13,نص عام,,0,0,0,,لم تكن هكذا من قبل
Dialogue: 0,0:55:10.67,0:55:12.25,نص عام,,0,0,0,,يدفعني دائمًا إلى الموت
Dialogue: 0,0:55:15.76,0:55:19.68,مائل,,0,0,0,,ولكن بعد كل مرة أصبحت أفضل وأقوى من ذي قبل
Dialogue: 0,0:55:23.47,0:55:25.31,نص عام,,0,0,0,,استمر في تعريضي للخطر
Dialogue: 0,0:55:25.89,0:55:27.52,نص عام,,0,0,0,,الشيء الرئيسي هو أن تكون قريبًا
Dialogue: 0,0:55:37.49,0:55:38.70,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:55:39.65,0:55:41.78,النص العام,,0,0,0,,سأكون هناك وأدفعك حتى الموت،
Dialogue: 0,0:55:41.87,0:55:44.20,نص عام,,0,0,0,,إذا توقفت
Dialogue: 0,0:56:11.73,0:56:14.81,general text,,0,0,0,,سأجد أوكا وأتأكد من عدم حضوره للقتال
Dialogue: 0,0:56:16.65,0:56:17.94,نص عام,,0,0,0,,لا حاجة
Dialogue: 0,0:56:18.49,0:56:20.82,نص عام,,0,0,0,,إذا أراد أن يأتي،
Dialogue: 0,0:56:21.70,0:56:22.66,نص عام,,0,0,0,,دعونا
Dialogue: 0,0:56:22.74,0:56:25.41,general text,,0,0,0,,هذه مبارزة رسمية بين السحرة
Dialogue: 0,0:56:26.16,0:56:28.37,general text,,0,0,0,,لن نتمكن من التدخل حتى لو مات أحد
Dialogue: 0,0:56:30.50,0:56:32.25,نص عام,,0,0,0,,إذا مات أحد،
Dialogue: 0,0:56:34.21,0:56:35.71,نص عام,,0,0,0,,هكذا سيكون الأمر كذلك
Dialogue: 0,0:56:40.13,0:56:41.67,نص عام,,0,0,0,,لن توقف هذا؟
Dialogue: 0,0:56:45.64,0:56:48.31,نص عام,,0,0,0,,المجلس الموحد طالب من أوكا
Dialogue: 0,0:56:48.39,0:56:50.48,النص العام,,0,0,0,,القتال نيابة عن سوسنوفي بور
Dialogue: 0,0:56:51.39,0:56:53.31,النص العام,,0,0,0,,سوف يهرب من الجبان
Dialogue: 0,0:56:54.02,0:56:56.11,النص العام,,0,0,0,,وسأموت بشرف،
Dialogue: 0,0:56:56.90,0:57:01.78,النص العام,,0,0,0,,سأشاهد فقط كرئيس لسوسنوفي بور
Dialogue: 0,0:58:33.91,0:58:38.21,general text,,0,0,0,,لقد وصل سيادتهما الملك والملكة
Dialogue: 0,0:59:11.28,0:59:14.08,general text,,0,0,0,,قبل شهر جو وون، وريث عائلة دايهو المالكة،
Dialogue: 0,0:59:14.16,0:59:17.71,general text,,0,0,0,,تحدى الابن الأكبر لعائلة تشان في مبارزة
Dialogue: 0,0:59:17.79,0:59:21.33,general text,,0,0,0,,قبلت سوسنوفي بور التحدي نيابة عن تشان ووك
Dialogue: 0,0:59:22.13,0:59:24.17,مائل,,0,0,0,,بالتوقيع على هذه الورقة،
Dialogue: 0,0:59:24.25,0:59:26.46,general text,,0,0,0,,أنت توافق على عدم تقديم أي مطالبات
Dialogue: 0,0:59:27.42,0:59:30.47,نص عام,,0,0,0,,حتى لو مات أحد
Dialogue: 0,0:59:32.18,0:59:35.97,النص العام,,0,0,0,,ستبدأ المبارزة عند الظهر
Dialogue: 0,0:59:36.64,0:59:38.73,النص العام,,0,0,0,,إذا لم يظهر تشانغ ووك قبل ذلك الحين،
Dialogue: 0,0:59:39.52,0:59:41.52,general text,,0,0,0,,سنعتبر هذا هزيمة
Dialogue: 0,0:59:44.23,0:59:49.24,general text,,0,0,0,,عليك أن تذكر العقوبة التي سينالها إذا لم يحضر
Dialogue: 0,0:59:52.53,0:59:57.12,النص العام,,0,0,0,,إذا لم يأتي تشانغ ووك اليوم،
Dialogue: 0,0:59:57.91,1:00:02.00,general text,,0,0,0,,سيفقد الحق في أن يصبح غوانغجو التالي
Dialogue: 0,1:00:03.92,1:00:05.34,نص عام,,0,0,0,,جونبوغوان
Dialogue: 0,1:00:26.44,1:00:27.36,نص عام,,0,0,0,,تعالوا إليّ
Dialogue: 0,1:00:29.11,1:00:30.95,نص عام,,0,0,0,,ماذا يوجد في تلك الأباريق؟
Dialogue: 0,1:00:32.74,1:00:34.41,نص عام,,0,0,0,,الماء
Dialogue: 0,1:00:34.99,1:00:36.53,نص عام,,0,0,0,,الماء؟
Dialogue: 0,1:01:09.23,1:01:11.19,نص عام,,0,0,0,,الفصل، لقد حان الظهر بالفعل
Dialogue: 0,1:01:11.28,1:01:13.24,نص عام,,0,0,0,,أغلق باب الصالة
Dialogue: 0,1:01:14.45,1:01:15.62,نص عام,,0,0,0,,يجب عليّ
Dialogue: 0,1:01:16.87,1:01:18.37,نص عام,,0,0,0,,أعلن عن خسارته
Dialogue: 0,1:01:38.43,1:01:39.35,نص عام,,0,0,0,,إغلاق
Dialogue: 0,1:01:54.40,1:01:55.66,النص العام,,0,0,0,,لقد وصل تشان ووك!
Dialogue: 0,1:02:05.00,1:02:05.92,نص عام,,0,0,0,,سيد...
Dialogue: 0,1:02:36.61,1:02:37.61,نص عام,,0,0,0,,سيد.
Dialogue: 0,1:02:39.20,1:02:40.20,نص عام,,0,0,0,,كل شيء سيكون على ما يرام
Dialogue: 0,1:02:44.75,1:02:47.08,نقوش,,0,0,0,,شان ووك
Dialogue: 0,1:03:07.39,1:03:09.35,نص عام,,0,0,0,,لقد وقعت على الورقة
Dialogue: 0,1:03:09.44,1:03:10.94,نص عام,,0,0,0,,الآن لن يتدخل أحد،
Dialogue: 0,1:03:11.69,1:03:13.69,النص العام,,0,0,0,,حتى لو مت أثناء القتال
Dialogue: 0,1:03:14.90,1:03:16.07,نص عام,,0,0,0,,فهمت
Dialogue: 0,1:03:19.78,1:03:20.99,نص عام,,0,0,0,,الأم,
Dialogue: 0,1:03:21.07,1:03:23.70,نص عام,,0,0,0,,أوقفوا هذا القتال
Dialogue: 0,1:03:24.45,1:03:27.25,نص عام,,0,0,0,,سيموت على يد ولي العهد
Dialogue: 0,1:03:27.33,1:03:29.33,النص العام,,0,0,0,,لقد جاء لأنه كان مستعداً للموت
Dialogue: 0,1:03:30.42,1:03:32.13,نص عام,,0,0,0,,لقد فسخ زواجك من جديد
Dialogue: 0,1:03:32.21,1:03:34.96,general text,,0,0,0,,مصيره لا علاقة له بنا
Dialogue: 0,1:03:48.48,1:03:49.85,نص عام,,0,0,0,,يمكنك البدء
Dialogue: 0,1:04:19.05,1:04:21.26,ذكريات مائلة,,0,0,0,,أولاً: لا تهاجم، دافع عن نفسك فقط
Dialogue: 0,1:04:21.34,1:04:23.51,ذكريات,,0,0,0,,هاجمه بمهاراتك -
Dialogue: 0,1:04:25.05,1:04:26.22,ذكريات,,0,0,0,,سوف تموت
Dialogue: 0,1:04:28.14,1:04:30.06,ذكريات,,0,0,0,,لا يمكنك الهجوم إلا عندما يكون
Dialogue: 0,1:04:31.23,1:04:32.81,ذكريات,,0,0,0,,يفقد التركيز
Dialogue: 0,1:05:10.85,1:05:12.81,خلف الكواليس,,0,0,0,,أنا متأكد من أنه وضعهم
Dialogue: 0,1:05:12.89,1:05:15.61,ذكريات بخط مائل,,0,0,0,,هل يمكنك حقاً الذهاب إلى سوسنوفي بور وقتما تشاء؟
Dialogue: 0,1:05:16.65,1:05:17.82,ذكريات,,0,0,0,,نعم. وماذا؟
Dialogue: 0,1:05:18.86,1:05:20.40,ذكريات,,0,0,0,,لدي طلب
Dialogue: 0,1:05:20.99,1:05:22.82,ذكريات,,0,0,0,,يمكنك وضع الماء في غرفة التدريب،
Dialogue: 0,1:05:22.90,1:05:24.99,ذكريات,,0,0,0,,حتى يتمكن من استخدام تانسو؟
Dialogue: 0,1:05:39.17,1:05:42.17,ذكريات,,0,0,0,,أباريق الماء هذه تحيرني
Dialogue: 0,1:05:43.88,1:05:44.84,ذكريات,,0,0,0,,كسرها
Dialogue: 0,1:06:44.65,1:06:45.70,نص عام,,0,0,0,,المضيف
Dialogue: 0,1:06:57.37,1:06:58.50,نص عام,,0,0,0,,تانسو
Dialogue: 0,1:07:16.43,1:07:17.39,نص عام,,0,0,0,,الأمير...
Dialogue: 0,1:07:17.48,1:07:18.56,نص عام,,0,0,0,,مبارزة
Dialogue: 0,1:07:19.10,1:07:20.27,نص عام,,0,0,0,,انتهى
Dialogue: 0,1:07:25.32,1:07:27.65,نص عام,,0,0,0,,ليس عادلاً. لا تعول!
Dialogue: 0,1:07:37.50,1:07:39.04,نص عام,,0,0,0,,كانت تانسو
Dialogue: 0,1:07:39.96,1:07:42.92,general text,,0,0,0,,فقط أولئك الذين أتقنوا تشيسو يمكنهم إتقانها
Dialogue: 0,1:07:43.79,1:07:47.55,general text,,0,0,0,,كيف يمكن لتشان ووك، الذي فتحت بوابته مؤخرًا، أن يستولي عليه؟
Dialogue: 0,1:07:47.63,1:07:48.97,نص عام,,0,0,0,,أنا متأكد،
Dialogue: 0,1:07:49.05,1:07:52.30,نص عام,,0,0,0,,أن أحد الأساتذة ساعده
Dialogue: 0,1:07:52.39,1:07:55.51,مائل,,0,0,0,,كيف سيساعدونه،
Dialogue: 0,1:07:55.60,1:07:57.43,نص عام,,0,0,0,,إذا شاهد الجميع؟
Dialogue: 0,1:07:57.52,1:07:58.98,نص عام,,0,0,0,,لا تتحدث بالهراء!
Dialogue: 0,1:07:59.60,1:08:01.56,مائل,,0,0,0,,شان ووك، الإجابة
Dialogue: 0,1:08:01.65,1:08:04.19,general text,,0,0,0,,لقد أتقنت حقًا تشيسا، ثم تانسي
Dialogue: 0,1:08:04.27,1:08:05.98,نص عام,,0,0,0,,في مثل هذا الوقت القصير؟
Dialogue: 0,1:08:07.53,1:08:08.86,نص عام,,0,0,0,,ليس حقًا
Dialogue: 0,1:08:09.78,1:08:11.78,نص عام,,0,0,0,,لدي ضعف في التحكم في الطاقة
Dialogue: 0,1:08:11.86,1:08:14.12,النص العام,,0,0,0,,لا أستطيع استخدام طنسا إلا في حالة وجود ماء
Dialogue: 0,1:08:14.70,1:08:17.41,نص عام,,0,0,0,,أنا أعرف فقط كيف أقطع الماء
Dialogue: 0,1:08:17.50,1:08:19.79,نص عام,,0,0,0,,من علمك هذا؟
Dialogue: 0,1:08:21.58,1:08:23.79,نص عام,,0,0,0,,كان ينبغي أن يساعدك أحد
Dialogue: 0,1:08:26.96,1:08:28.01,نص عام,,0,0,0,,لا أحد
Dialogue: 0,1:08:29.92,1:08:30.97,نص عام,,0,0,0,,أنت تنظر
Dialogue: 0,1:08:31.68,1:08:33.14,نص عام,,0,0,0,,هذا مجرد مضحك
Dialogue: 0,1:08:33.22,1:08:35.76,general text,,0,0,0,,يدعي أنه أتقن هذه المهارة بنفسه
Dialogue: 0,1:08:38.85,1:08:41.44,نص عام,,0,0,0,,لاحظت وجود أباريق ماء هنا
Dialogue: 0,1:08:43.15,1:08:45.19,نص عام,,0,0,0,,من وضعها؟
Dialogue: 0,1:08:46.86,1:08:48.69,نص عام,,0,0,0,,معلمك؟
Dialogue: 0,1:08:50.57,1:08:52.03,نص عام,,0,0,0,,لقد درست نفسي
Dialogue: 0,1:08:52.11,1:08:53.49,نص عام,,0,0,0,,لن أقع في هذا!
Dialogue: 0,1:08:53.57,1:08:55.45,نص عام,,0,0,0,,شان ووك، اشرح نفسك
Dialogue: 0,1:08:58.91,1:09:02.04,نص عام,,0,0,0,,من ساعدك في التدريب؟
Dialogue: 0,1:09:12.17,1:09:13.26,مائل,,0,0,0,,لقد وضعت الأباريق
Dialogue: 0,1:09:25.90,1:09:27.48,نص عام,,0,0,0,,وكنت معه
Dialogue: 0,1:09:28.27,1:09:31.44,نص عام,,0,0,0,,كل ما قاله صحيح
Dialogue: 0,1:09:35.11,1:09:36.28,نص عام,,0,0,0,,ومن أنت؟
Dialogue: 0,1:09:37.20,1:09:39.12,نص عام,,0,0,0,,كيف تجرؤ على التدخل؟
Dialogue: 0,1:09:39.20,1:09:40.29,نص عام,,0,0,0,,اصمت!
Dialogue: 0,1:09:41.04,1:09:43.71,نص عام,,0,0,0,,هذا سيد القنب لي
Dialogue: 0,1:09:43.79,1:09:45.50,نص عام,,0,0,0,,تلميذ المعلم سيو كيونغ
Dialogue: 0,1:09:45.58,1:09:47.42,نص عام,,0,0,0,,أحييه!
Dialogue: 0,1:09:50.80,1:09:52.63,نص عام,,0,0,0,,مرحباً أستاذي
Dialogue: 0,1:09:55.47,1:09:58.89,النص العام,,0,0,0,,كنت معه في دانهيانغك ورأيت كل شيء
Dialogue: 0,1:09:58.97,1:10:01.68,general text,,0,0,0,,أمضى أيامًا في تعلم تقطيع قطرات الماء
Dialogue: 0,1:10:04.89,1:10:06.44,نص عام,,0,0,0,,ومعها
Dialogue: 0,1:10:07.94,1:10:10.32,نص عام,,0,0,0,,لم يكن هناك سوى خادمته
Dialogue: 0,1:10:12.36,1:10:15.40,نص عام,,0,0,0,,شهد له السيد لي
Dialogue: 0,1:10:17.45,1:10:21.91,نص عام,,0,0,0,,هل هناك اعتراضات أخرى؟
Dialogue: 0,1:10:56.86,1:10:58.49,نص عام,,0,0,0,,هيا بنا يا صاحب الجلالة
Dialogue: 0,1:11:15.59,1:11:18.34,نص عام,,0,0,0,,دع تشان ووك يدخل جيونبوغوان
Dialogue: 0,1:11:31.48,1:11:34.90,general text,,0,0,0,,لا عجب أن ابن غوانغجو تشانغ غان موهوب جدًا
Dialogue: 0,1:11:34.98,1:11:40.03,general text,,0,0,0,,بما أنه ليس لديك معلم حتى الآن، فإن جيونبوغوان سيقبلك بكل سرور
Dialogue: 0,1:11:40.82,1:11:42.70,نص عام,,0,0,0,,لست بحاجة إليه هنا!
Dialogue: 0,1:11:42.78,1:11:45.12,نص عام,,0,0,0,,يجب أن أكون معلمه
Dialogue: 0,1:11:45.20,1:11:48.33,general text,,0,0,0,,فتحت له أبوابه وأنا من منحته طاقتي
Dialogue: 0,1:11:48.41,1:11:50.83,نص عام,,0,0,0,,المملكة المتحدة، تعال معي إلى سيجوكون
Dialogue: 0,1:11:50.92,1:11:53.21,نص عام,,0,0,0,,سأعلمك كل ما أعرفه
Dialogue: 0,1:11:53.29,1:11:55.55,نص عام,,0,0,0,,أو ربما في جينيوون؟
Dialogue: 0,1:11:57.30,1:11:59.13,النص العام,,0,0,0,,انقطعت العلاقة مع تشو يونغ،
Dialogue: 0,1:11:59.22,1:12:02.47,نص عام,,0,0,0,,لكننا سنعتبرك عائلة ونعلمك تعاويذنا
Dialogue: 0,1:12:06.93,1:12:08.14,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,1:12:09.02,1:12:11.27,نص عام,,0,0,0,,إذا أردت، يمكنك الانضمام إلى Jeonjingak
Dialogue: 0,1:12:12.98,1:12:14.27,نص عام,,0,0,0,,سنقبلك
Dialogue: 0,1:12:33.46,1:12:34.59,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,1:12:34.67,1:12:38.42,نص عام,,0,0,0,,الجميع يتصل بي. إلى أين تذهب؟
Dialogue: 0,1:12:50.89,1:12:52.69,النص العام,,0,0,0,,أدخل سوسنوفي بور,
Dialogue: 0,1:12:53.56,1:12:54.69,نص عام,,0,0,0,,المضيف
Dialogue: 0,1:13:04.70,1:13:06.78,general text,,0,0,0,,أنا تشان ووك، الابن الأكبر لعائلة تشان،
Dialogue: 0,1:13:07.58,1:13:09.66,نص عام,,0,0,0,,سوف أدخل جيونجينغاك
Dialogue: 0,1:14:06.79,1:14:09.92,preview,,0,0,0,,أصبح السيد ساحر جيونجينغاك
Dialogue: 0,1:14:10.01,1:14:13.22,معاينة,,0,0,0,,مرحبًا بساحرنا الجديد تشان ووك
Dialogue: 0,1:14:13.88,1:14:16.05,preview,,0,0,0,,أنا أكره سيدك حتى أطحن أسناني
Dialogue: 0,1:14:16.14,1:14:17.05,معاينة,,0,0,0,,بالطبع
Dialogue: 0,1:14:19.81,1:14:22.06,preview,,0,0,0,,إذا كان هذا الحب متقلبًا جدًا، فأنا لست بحاجة إليه!
Dialogue: 0,1:14:22.14,1:14:23.10,معاينة,,0,0,0,,دعني أدخل
Dialogue: 0,1:14:23.19,1:14:24.02,معاينة,,0,0,0,,مو دوك
Dialogue: 0,1:14:24.10,1:14:26.44,معاينة,,0,0,0,,يجب أن أكون مع المالك
Dialogue: 0,1:14:26.52,1:14:27.65,معاينة,,0,0,0,,اذهب إلى المنزل وانتظر هناك
Dialogue: 0,1:14:27.73,1:14:30.07,معاينة,,0,0,0,,سيد. خرج تشان وعاد للمنزل
Dialogue: 0,1:14:30.82,1:14:32.70,preview,,0,0,0,,سيدتي! انتظر هناك
Dialogue: 0,1:14:32.78,1:14:34.95,preview,,0,0,0,,- أنا قادم إليك\N- وجدت أسئلة الامتحان
Dialogue: 0,1:14:35.61,1:14:36.87,معاينة,,0,0,0,,مهما حدث,
Dialogue: 0,1:14:36.95,1:14:39.37,معاينة,,0,0,0,,سأصل إلى سوسنوفي بور للمالك
Dialogue: 0,1:14:39.45,1:14:40.66,معاينة,,0,0,0,,مو دوك
Dialogue: 0,1:14:40.74,1:14:43.75,preview,,0,0,0,,أستطيع التعامل مع أي شيء لمجرد رؤيتك
الحوار: 0,0:02:57.14,0:02:59.14,معاينة,,0,0,0,,

