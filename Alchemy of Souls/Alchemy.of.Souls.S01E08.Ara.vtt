Dialogue: 0,0:00:59.50,0:01:00.67,خلف الكواليس,,0,0,0,,هل هذه هي كيمياء النفوس؟
Dialogue: 0,0:01:15.52,0:01:19.98,التعليق الصوتي,,0,0,0,,روحي تتحرك الآن؟
Dialogue: 0,0:03:07.92,0:03:09.34,نص عام,,0,0,0,,الروح لم تتحرك
Dialogue: 0,0:03:10.89,0:03:12.26,نص عام,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:03:20.02,0:03:21.06,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:03:22.11,0:03:23.23,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,0:03:26.44,0:03:27.69,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,0:03:28.86,0:03:30.03,نص عام,,0,0,0,,شان ووك!
Dialogue: 0,0:03:45.17,0:03:48.84,general text,,0,0,0,,كيل جو، لقد بدلت أجسادك مع تلميذي
Dialogue: 0,0:03:50.63,0:03:51.72,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:03:55.47,0:03:58.02,general text,,0,0,0,,كنت ضعيفاً لأحميه منك
Dialogue: 0,0:03:58.89,0:04:01.35,نص عام,,0,0,0,,لكنني سأقضي عليك بالتأكيد
Dialogue: 0,0:04:07.19,0:04:08.44,نص عام,,0,0,0,,لم أكن أعرف،
Dialogue: 0,0:04:09.24,0:04:11.24,نص عام,,0,0,0,,لماذا كنت قلقًا جدًا بشأن تشان ووك
Dialogue: 0,0:04:11.99,0:04:13.20,نص عام,,0,0,0,,اخرس!
Dialogue: 0,0:04:15.33,0:04:16.49,نص عام,,0,0,0,,يا معلم!
Dialogue: 0,0:04:17.58,0:04:18.70,نص عام,,0,0,0,,هذا أنا تشان ووك
Dialogue: 0,0:04:19.62,0:04:20.87,نص عام,,0,0,0,,نحن لم نتغير
Dialogue: 0,0:04:23.21,0:04:25.21,نص عام,,0,0,0,,انظر في عيني
Dialogue: 0,0:04:26.34,0:04:27.80,نص عام,,0,0,0,,هذا أنا
Dialogue: 0,0:04:32.30,0:04:35.05,النص العام,,0,0,0,,الوحيد الذي يمكنه النظر إليك من هذه المسافة
Dialogue: 0,0:04:38.77,0:04:40.10,نص عام,,0,0,0,,هل تعرفني؟
Dialogue: 0,0:06:01.68,0:06:04.02,نص عام,,0,0,0,,لديه علامة على كتفه
Dialogue: 0,0:06:05.81,0:06:08.69,general text,,0,0,0,,ويبدو أن روحه عادت إلى جسده.
Dialogue: 0,0:06:09.77,0:06:11.07,نص عام,,0,0,0,,إذن لماذا أنا بخير؟
Dialogue: 0,0:06:11.15,0:06:12.11,نص عام,,0,0,0,,ليس حقًا
Dialogue: 0,0:06:12.82,0:06:14.40,نص عام,,0,0,0,,لقد تغيرت أيضاً. انظر
Dialogue: 0,0:06:15.70,0:06:17.91,النص العام,,0,0,0,,أنت لا ترتدي سواراً ولكن يدك لا ترتعش
Dialogue: 0,0:06:20.41,0:06:23.45,نص عام,,0,0,0,,أنت على حق. يمكنني تحريكه بحرية
Dialogue: 0,0:06:23.54,0:06:25.91,نص عام,,0,0,0,,العاكس يساعد في اكتساب الطاقة
Dialogue: 0,0:06:26.00,0:06:29.71,general text,,0,0,0,,السم يفتح أبوابك، يعكس الطاقة المتزايدة
Dialogue: 0,0:06:30.79,0:06:34.09,النص العام,,0,0,0,,تشان ووك، أنت محظوظ للغاية
Dialogue: 0,0:06:40.76,0:06:43.60,نص عام,,0,0,0,,أنا متأكد من أنني رأيتك هناك
Dialogue: 0,0:06:44.52,0:06:45.64,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:07:05.91,0:07:07.29,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:07:08.25,0:07:09.79,نص عام,,0,0,0,,لماذا أنت بخير؟
Dialogue: 0,0:07:09.87,0:07:12.84,general text,,0,0,0,,لقد فشلت بسبب ضعف طاقتك
Dialogue: 0,0:07:12.92,0:07:15.05,نص عام,,0,0,0,,أنت أيضاً بدويّ
Dialogue: 0,0:07:15.13,0:07:16.97,نص عام,,0,0,0,,ناك سو أنت أيضًا
Dialogue: 0,0:07:17.88,0:07:19.93,النص العام,,0,0,0,,سوف تتحجر وتموت
Dialogue: 0,0:07:21.05,0:07:23.05,نص عام,,0,0,0,,كيف أنا
Dialogue: 0,0:07:24.26,0:07:25.89,نص عام,,0,0,0,,مثل والدك
Dialogue: 0,0:07:30.81,0:07:31.90,نص عام,,0,0,0,,أبي؟
Dialogue: 0,0:07:32.56,0:07:33.57,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:07:34.07,0:07:36.90,نص عام,,0,0,0,,ساحر مراقب النجوم
Dialogue: 0,0:07:37.53,0:07:38.70,نص عام,,0,0,0,,تشو تشون!
Dialogue: 0,0:07:40.57,0:07:42.03,نص عام,,0,0,0,,أبي...
Dialogue: 0,0:07:44.87,0:07:46.29,نص عام,,0,0,0,,هل كان بدوياً؟
Dialogue: 0,0:07:49.21,0:07:53.67,general text,,0,0,0,,عائلتك لم تُقتل على يد عائلات ديهو الرئيسية
Dialogue: 0,0:07:55.13,0:07:59.26,النص العام,,0,0,0,,لقد كان والدك. لقد تحول إلى ابتلاع الروح وقتل الجميع
Dialogue: 0,0:08:01.38,0:08:03.39,ذكريات مائلة,,0,0,0,,ابقَ في الداخل ولا تخرج
Dialogue: 0,0:08:03.47,0:08:06.39,ذكريات,,0,0,0,,إذا رأيت أباك فاهرب
Dialogue: 0,0:08:06.47,0:08:08.10,ذكريات,,0,0,0,,لا تدعه يمسك بك
Dialogue: 0,0:08:11.48,0:08:15.69,نص عام,,0,0,0,,تم استغلالك أنت ووالدك
Dialogue: 0,0:08:16.44,0:08:18.78,النص العام,,0,0,0,,سوف تتحجر وتموت
Dialogue: 0,0:08:19.74,0:08:21.74,نص عام,,0,0,0,,كان والدي بدوياً
Dialogue: 0,0:08:23.11,0:08:24.28,نص عام,,0,0,0,,هل دان تشو؟
Dialogue: 0,0:08:25.37,0:08:27.37,النص العام,,0,0,0,,جين مو من جيونبوغوان؟
Dialogue: 0,0:08:27.95,0:08:30.91,النص العام,,0,0,0,,جين مو ليس دان تشو الحقيقي
Dialogue: 0,0:08:31.66,0:08:34.54,النص العام,,0,0,0,,صحيح أن دان تشو شخص آخر
Dialogue: 0,0:08:35.46,0:08:37.67,النص العام,,0,0,0,,- ومن هذا؟\N- حقيقي
Dialogue: 0,0:08:38.88,0:08:41.34,نص عام,,0,0,0,,يمكن أن يوقف التحجير
Dialogue: 0,0:08:42.34,0:08:45.51,نص عام,,0,0,0,,لأنه لديه حجر ثلج
Dialogue: 0,0:08:45.60,0:08:47.85,النص العام,,0,0,0,,من هو دان تشو الحقيقي؟
Dialogue: 0,0:09:12.62,0:09:14.71,النص العام,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,0:09:15.92,0:09:17.17,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:09:18.04,0:09:19.96,النص العام,,0,0,0,,اركض خلفه. أسرع!
Dialogue: 0,0:09:56.71,0:09:59.04,خلف الكواليس,,0,0,0,,علينا أن نخرج من هنا،
Dialogue: 0,0:09:59.71,0:10:01.71,خلف الكواليس,,0,0,0,,حتى ينتشر سم السحر
Dialogue: 0,0:10:26.15,0:10:27.32,خط مائل,,0,0,0,,عرض الكل
Dialogue: 0,0:10:27.41,0:10:28.66,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:10:52.26,0:10:53.22,نص عام,,0,0,0,,لا أحد
Dialogue: 0,0:10:58.81,0:11:00.69,نص عام,,0,0,0,,شعرت بقوة السحر
Dialogue: 0,0:11:00.77,0:11:03.86,نص عام,,0,0,0,,السيد هو كان على حق. هذا السابساري هو Gwigu
Dialogue: 0,0:11:04.48,0:11:06.78,general text,,0,0,0,,هل هناك حقاً كيمياء النفوس هنا؟
Dialogue: 0,0:11:15.87,0:11:16.79,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:11:17.37,0:11:18.75,نص عام,,0,0,0,,ملقى على الأرض
Dialogue: 0,0:11:19.87,0:11:21.13,نص عام,,0,0,0,,ربما يكون عاكساً
Dialogue: 0,0:11:26.96,0:11:28.13,نص عام,,0,0,0,,هذا السوار...
Dialogue: 0,0:11:29.01,0:11:31.01,نص عام,,0,0,0,,أهذا سوار السيد تشان ووك؟
Dialogue: 0,0:11:31.09,0:11:32.76,نص عام,,0,0,0,,لماذا هو هنا؟
Dialogue: 0,0:11:33.39,0:11:34.97,نص عام,,0,0,0,,إذن كانت المملكة المتحدة هنا؟
Dialogue: 0,0:11:39.77,0:11:40.98,النص العام,,0,0,0,,لقد تقاتلوا
Dialogue: 0,0:11:41.06,0:11:43.23,النص العام,,0,0,0,,هل تعتقد أن شيئًا ما قد حدث له؟
Dialogue: 0,0:11:46.57,0:11:49.11,النص العام,,0,0,0,,ارجع إلى سوسنوفي بور وأبلغ عما رأيته
Dialogue: 0,0:11:49.78,0:11:52.03,النص العام,,0,0,0,,دان جو، تعال وابحث عن أوكا
Dialogue: 0,0:11:52.12,0:11:54.03,نص عام,,0,0,0,,- سأنظر في المنطقة\N- حسنًا
Dialogue: 0,0:12:29.90,0:12:32.41,general text,,0,0,0,,كيف اكتشف سحرة سوسنوفي بور ذلك؟
Dialogue: 0,0:12:49.55,0:12:51.30,ذكريات بخط مائل,,0,0,0,,أنت بدويّ أيضاً
Dialogue: 0,0:12:51.88,0:12:53.59,ذكريات,,0,0,0,,ناك سو، أنت أيضاً
Dialogue: 0,0:12:54.51,0:12:56.72,ذكريات,,0,0,0,,سوف تتحجر وتموت
Dialogue: 0,0:12:56.80,0:12:58.81,ذكريات,,0,0,0,,مثلي
Dialogue: 0,0:12:59.47,0:13:01.06,ذكريات,,0,0,0,,مثل والدك
Dialogue: 0,0:13:04.77,0:13:05.98,نص عام,,0,0,0,,أبي...
Dialogue: 0,0:13:30.34,0:13:31.96,ذكريات بخط مائل,,0,0,0,,وأنت وأبوك
Dialogue: 0,0:13:33.67,0:13:36.22,ذكريات بخط مائل,,0,0,0,,مستعملة. سوف تتحول إلى الحجر
Dialogue: 0,0:13:37.68,0:13:39.81,ذكريات بخط مائل,,0,0,0,,وتموت
Dialogue: 0,0:15:26.41,0:15:27.58,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:15:28.58,0:15:29.96,نص عام,,0,0,0,,لماذا أنت مرة أخرى؟
Dialogue: 0,0:15:36.38,0:15:39.22,نص عام,,0,0,0,,هل هذا بدو؟
Dialogue: 0,0:15:39.30,0:15:41.30,نص عام,,0,0,0,,لا يا خادمة أوكا
Dialogue: 0,0:15:42.35,0:15:44.64,general text,,0,0,0,,لقد جرحتها بالخطأ، يجب أن تؤخذ إلى المعالجين.
Dialogue: 0,0:15:51.56,0:15:54.07,نص عام,,0,0,0,,يا له من يوم
Dialogue: 0,0:15:54.15,0:15:56.82,نص عام,,0,0,0,,كانت التجارة تسير بشكل جيد
Dialogue: 0,0:16:02.87,0:16:05.08,خلف الكواليس,,0,0,0,,أحتاج إلى تجديد طاقتي، وإلا سأتحجر تمامًا
Dialogue: 0,0:16:07.75,0:16:09.79,مائل,,0,0,0,,- انتهيت؟\N- هذا كل شيء بالفعل
Dialogue: 0,0:16:10.37,0:16:12.21,نص عام,,0,0,0,,هل نتناول مشروبًا؟
Dialogue: 0,0:16:12.88,0:16:13.92,خط مائل,,0,0,0,,- حسنًا\N- أسرع
Dialogue: 0,0:16:14.00,0:16:15.17,خط مائل,,0,0,0,,لنذهب
Dialogue: 0,0:16:16.84,0:16:19.13,خلف الكواليس,,0,0,0,,لن أتمكن من العودة إذا أحدثت ضجة
Dialogue: 0,0:16:19.22,0:16:22.13,خلف الكواليس,,0,0,0,,أحتاج إلى العثور على مكان هادئ حيث يمكنني الحصول على ما يكفي
