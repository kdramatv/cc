Dialog: 0,0:01:00.80,0:01:03.72,kenangan,,0,0,0,,Cikgu, ini saya, Yom
Dialog: 0,0:01:03.80,0:01:06.93,kenangan,,0,0,0,,Semalam adalah seratus hari sejak kamu bermeditasi
Dialog: 0,0:01:07.01,0:01:08.31,kenangan,,0,0,0,,Sudah tiba masanya untuk keluar
Dialog: 0,0:01:13.98,0:01:15.10,kenangan,,0,0,0,,Tuan
Dialog: 0,0:01:20.69,0:01:21.94,kenangan,,0,0,0,,Tuan
Dialog: 0,0:01:25.70,0:01:26.74,kenangan,,0,0,0,,Cikgu...
Dialog: 0,0:01:27.87,0:01:28.78,kenangan,,0,0,0,,Tuan
Dialog: 0,0:01:30.95,0:01:31.87,kenangan,,0,0,0,,Cikgu!
Dialog: 0,0:01:32.71,0:01:33.79,kenangan,,0,0,0,,Cikgu...
Dialog: 0,0:01:35.67,0:01:36.58,kenangan,,0,0,0,,Cikgu!
Dialog: 0,0:01:42.55,0:01:45.55,kenangan miring,,0,0,0,,- Budak malang\N- Malang
Dialog: 0,0:01:45.63,0:01:48.10,kenangan miring,,0,0,0,,- Syurga suci\N- Luar biasa
Dialog: 0,0:01:48.18,0:01:50.81,kenangan miring,,0,0,0,,- Dia pasti mati beku\N- Nampaknya begitu
Dialog: 0,0:01:50.89,0:01:53.64,kenangan miring,,0,0,0,,- Saya sangat kesian padanya\N- Kasihan sayang
Dialog: 0,0:01:53.73,0:01:54.94,kenangan miring,,0,0,0,,- Sayang sekali\N- Macam mana?
Dialog: 0,0:01:55.02,0:01:56.69,kenangan,,0,0,0,,Apa yang berlaku di sini? Apa ini?
Dialog: 0,0:01:56.77,0:01:58.94,kenangan condong,,0,0,0,,Seorang budak gelandangan meninggal dunia
Dialog: 0,0:01:59.02,0:02:01.61,kenangan,,0,0,0,,Dia hanya seorang kanak-kanak. Saya berasa sangat kasihan kepadanya
Dialog: 0,0:02:01.69,0:02:04.74,kenangan condong,,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,0:02:26.51,0:02:29.09,di sebalik tabir,,0,0,0,,Seperti yang anda mahukan,
Dialog: 0,0:02:30.35,0:02:33.35,di sebalik tabir,,0,0,0,,Saya secara senyap-senyap akan mengucapkan selamat tinggal kepada tuan
Dialog: 0,0:02:40.81,0:02:42.98,kenangan miring,,0,0,0,,Saya sangat kasihan kepadanya
Dialog: 0,0:02:43.69,0:02:45.74,kenangan miring,,0,0,0,,Nampaknya dia anak yatim piatu
Dialog: 0,0:02:45.82,0:02:47.32,kenangan,,0,0,0,,Bolehkah kita mengadakan pengebumian untuknya?
Dialog: 0,0:02:47.40,0:02:48.57,kenangan,,0,0,0,,- Ya\N- Jom
Dialog: 0,0:02:48.66,0:02:49.70,kenangan miring,,0,0,0,,Mungkin pembakaran mayat...
Dialog: 0,0:02:49.78,0:02:51.95,memori italic,,0,0,0,,dan taburkan abu di atas Tasik Gyeongcheongdaeho?
Dialog: 0,0:02:53.49,0:02:54.95,kenangan condong,,0,0,0,,Budak lelaki...
Dialog: 0,0:02:55.04,0:02:56.00,kenangan,,0,0,0,,kau okay tak?
Dialog: 0,0:02:58.62,0:03:00.50,kenangan miring,,0,0,0,,- Itu sahaja...\N- Bagaimana...
Dialog: 0,0:03:00.58,0:03:03.63,kenangan,,0,0,0,,- Dia pergi mana?\N- Awak nak pergi mana?
Dialog: 0,0:03:11.85,0:03:13.35,kenangan,,0,0,0,,Berhenti!
Dialog: 0,0:03:24.69,0:03:25.78,kenangan condong,,0,0,0,,Kanak-kanak
Dialog: 0,0:03:25.86,0:03:28.20,kenangan,,0,0,0,,Adakah anda hanya memberitahu saya untuk berhenti?
Dialog: 0,0:03:30.32,0:03:31.45,kenangan,,0,0,0,,Bodohnya!
Dialog: 0,0:03:32.12,0:03:34.62,kenangan,,0,0,0,,Saya tidak percaya awak sudah membakar badan saya
Dialog: 0,0:03:37.16,0:03:39.16,kenangan,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:03:41.17,0:03:44.59,kenangan,,0,0,0,,Jika saya datang sedikit kemudian, awak akan membakar tongkat saya juga
Dialog: 0,0:03:45.71,0:03:47.26,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:49.97,0:03:51.14,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:51.76,0:03:54.43,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:03:55.47,0:03:57.52,kenangan,,0,0,0,,Bodoh!
Dialog: 0,0:04:04.44,0:04:05.94,kenangan,,0,0,0,,M-master?
Dialog: 0,0:04:06.02,0:04:08.49,kenangan,,0,0,0,,Saya hanya meninggalkan badan buat sementara waktu,
Dialog: 0,0:04:08.57,0:04:10.36,kenangan,,0,0,0,,untuk memeriksa sama ada saya sampai ke Hwansu
Dialog: 0,0:04:10.45,0:04:12.82,kenangan,,0,0,0,,selepas seratus hari bermeditasi
Dialog: 0,0:04:13.41,0:04:17.20,kenangan,,0,0,0,,Tetapi saya perasan badan saya terbakar, jadi saya cepat-cepat berpindah ke tempat lain
Dialog: 0,0:04:18.29,0:04:19.50,kenangan,,0,0,0,,Tetapi sudah terlambat
Dialog: 0,0:04:22.04,0:04:25.84,kenangan,,0,0,0,,Jadi awak ada dalam badan budak ni?
Dialog: 0,0:04:25.92,0:04:28.13,kenangan,,0,0,0,,Betulkah awak, cikgu?
Dialog: 0,0:04:28.71,0:04:29.55,kenangan,,0,0,0,,Tepat sekali
Dialog: 0,0:04:29.63,0:04:32.63,kenangan,,0,0,0,,Saya Lee Chul, tuanmu
Dialog: 0,0:04:33.22,0:04:34.05,kenangan,,0,0,0,,Oh...
Dialog: 0,0:04:35.93,0:04:37.56,kenangan,,0,0,0,,Tuan
Dialog: 0,0:04:38.81,0:04:39.81,kenangan,,0,0,0,,Tuan
Dialog: 0,0:04:50.69,0:04:52.95,teks umum,,0,0,0,,Saya seorang nomad,
Dialog: 0,0:05:03.21,0:05:04.29,italic,,0,0,0,,Yang Mulia
Dialog: 0,0:05:04.79,0:05:08.63,teks umum,,0,0,0,,Awak tak telefon saya untuk cari nomad?
Dialog: 0,0:05:09.25,0:05:10.51,teks umum,,0,0,0,,Itulah yang akan saya lakukan
Dialog: 0,0:05:11.30,0:05:12.38,teks umum,,0,0,0,,Saya boleh
Dialog: 0,0:05:12.47,0:05:14.38,teks umum,,0,0,0,,kenali nomad
Dialog: 0,0:05:48.75,0:05:50.88,teks umum,,0,0,0,,Adakah orang lain melihat wajah anda?
Dialog: 0,0:05:55.34,0:05:56.34,kenangan,,0,0,0,,Ini adalah payung
Dialog: 0,0:05:57.43,0:05:58.93,kenangan,,0,0,0,,Boleh digunakan sebagai rotan
Dialog: 0,0:06:01.68,0:06:02.68,teks umum,,0,0,0,,Tidak
Dialog: 0,0:06:02.77,0:06:06.02,teks umum,,0,0,0,,Di ibu negara tiada orang lain tahu bahawa saya kelihatan
Dialog: 0,0:06:07.19,0:06:10.23,teks umum,,0,0,0,,Orang ramai akan fikir penyamun berperang di sini
Dialog: 0,0:06:18.78,0:06:20.74,teks umum,,0,0,0,,Anda sepatutnya berhenti mencari saya
Dialog: 0,0:06:25.62,0:06:26.58,kenangan,,0,0,0,,Jadi saya
Dialog: 0,0:06:29.84,0:06:31.42,kenangan,,0,0,0,,So Yi, adakah itu awak?
Dialog: 0,0:06:31.50,0:06:33.05,kenangan,,0,0,0,,Saya Kim dari kampung Sari
Dialog: 0,0:06:34.34,0:06:35.55,kenangan,,0,0,0,,Anda membuat kesilapan
Dialog: 0,0:06:43.14,0:06:45.98,kenangan,,0,0,0,,Kami hampir tidak mengenali antara satu sama lain. Dia hampir tidak mengenali saya
Dialog: 0,0:06:46.06,0:06:47.10,kenangan,,0,0,0,,Tentang lelaki itu
Dialog: 0,0:06:47.73,0:06:49.15,kenangan,,0,0,0,,perlu dijaga
Dialog: 0,0:07:00.82,0:07:02.87,teks umum,,0,0,0,,Tidak perlu membunuhnya
Dialog: 0,0:07:02.95,0:07:05.50,teks umum,,0,0,0,,Jika dia pergi ke Sari, kami tidak akan bertemu lagi
Dialog: 0,0:07:05.58,0:07:06.66,teks umum,,0,0,0,,Tetapi awak berjumpa
Dialog: 0,0:07:08.58,0:07:09.67,teks umum,,0,0,0,,Kampung Sari?
Dialog: 0,0:07:12.34,0:07:13.88,teks umum,,0,0,0,,Adakah itu tempat anda tinggal?
Dialog: 0,0:07:17.01,0:07:18.18,teks umum,,0,0,0,,Saya bersembunyi di sana
Dialog: 0,0:07:19.18,0:07:22.39,teks umum,,0,0,0,,Tersembunyi daripada samseng ini
Dialog: 0,0:07:24.06,0:07:27.68,teks umum,,0,0,0,,Adakah sesiapa yang tinggal di sana yang boleh mengenali anda?
Dialog: 0,0:07:28.69,0:07:31.73,teks umum,,0,0,0,,Saya tidak rapat dengan sesiapa pun supaya mereka tidak mengenali saya
Dialog: 0,0:07:32.94,0:07:34.48,teks umum,,0,0,0,,Saya seorang pencuri di sana
Dialog: 0,0:07:34.57,0:07:36.23,teks umum,,0,0,0,,- Apakah ini?\N- Wang
Dialog: 0,0:07:36.32,0:07:39.49,teks umum,,0,0,0,,Adalah mencurigakan jika wang itu tidak hilang
Dialog: 0,0:07:40.95,0:07:42.16,teks umum,,0,0,0,,Simpan untuk diri sendiri
Dialog: 0,0:07:56.80,0:07:59.26,teks umum,,0,0,0,,Saya tidak mahu mencederakan sesiapa dari kampung Sari
Dialog: 0,0:08:11.77,0:08:13.52,di sebalik tabir,,0,0,0,,Moo Dok di ibu negara
Dialog: 0,0:08:13.61,0:08:15.98,luar skrin,,0,0,0,,Jika kita berjumpa, adakah kita perlu membunuhnya?
Dialog: 0,0:08:18.94,0:08:21.20,teks umum,,0,0,0,,Pedagang Kim dari Kampung Sari ada di sini?
Dialog: 0,0:08:21.78,0:08:23.78,teks umum,,0,0,0,,Ya, dia baru sampai
Dialog: 0,0:08:23.87,0:08:25.91,teks umum,,0,0,0,,Dia berada di bilik terakhir di tingkat dua
Dialog: 0,0:08:56.98,0:08:57.98,italic,,0,0,0,,Puan?
Dialog: 0,0:09:05.62,0:09:09.70,teks umum,,0,0,0,,Apa yang membawa anda ke tempat ini?
Dialog: 0,0:09:09.79,0:09:12.25,teks umum,,0,0,0,,Tiada urusan anda. Anda tidak melihat saya di sini
Dialog: 0,0:09:13.46,0:09:14.83,teks umum,,0,0,0,,Puan, adakah anda benar-benar bermain
Dialog: 0,0:09:17.46,0:09:18.50,teks umum,,0,0,0,, ke dalam perjudian?
Dialog: 0,0:09:18.59,0:09:20.46,teks umum,,0,0,0,,Apa? Berjudi?
Dialog: 0,0:09:21.13,0:09:24.09,teks umum,,0,0,0,,Awak bawa saya untuk siapa? Adakah saya seorang yang sederhana, pada pendapat anda?
Dialog: 0,0:09:24.18,0:09:25.72,teks umum,,0,0,0,,Tidak, sudah tentu
Dialog: 0,0:09:26.72,0:09:29.51,teks umum,,0,0,0,,Tetapi awak berbohong kepada saya apabila awak mengatakan jed itu tidak pecah
Dialog: 0,0:09:29.60,0:09:33.52,teks umum,,0,0,0,,Memandangkan keupayaan anda untuk berbohong tanpa sedikit pun hati nurani,
Dialog: 0,0:09:34.14,0:09:36.19,teks umum,,0,0,0,,Saya fikir mungkin anda mempunyai bakat untuk berjudi
Dialog: 0,0:09:40.53,0:09:42.24,teks umum,,0,0,0,,Saya datang kepada peniaga untuk mendapatkan tiket
Dialog: 0,0:09:43.40,0:09:45.32,teks umum,,0,0,0,,Tiket untuk persembahan telah habis dijual
Dialog: 0,0:09:45.41,0:09:46.74,teks umum,,0,0,0,,Itu sebab saya datang ke sini
Dialog: 0,0:09:46.82,0:09:48.78, inskripsi,,0,0,0,,Tiket masuk\N Magi of Seochon
Dialog: 0,0:09:49.70,0:09:52.50,teks umum,,0,0,0,,- Anda ada dua tiket\N- Saya pergi dengan ibu saya
Dialog: 0,0:09:52.58,0:09:54.33,teks umum,,0,0,0,,Jangan beritahu sesiapa yang anda nampak saya di sini
Dialog: 0,0:09:54.41,0:09:56.79,teks umum,,0,0,0,,Saya tidak mahu sebarang salah faham
Dialog: 0,0:09:56.88,0:09:58.17,teks umum,,0,0,0,,Siapa tahu
Dialog: 0,0:09:58.25,0:10:00.80,teks umum,,0,0,0,,Anda lihat, saya tidak pandai berbohong seperti anda
Dialog: 0,0:10:00.88,0:10:03.42,teks umum,,0,0,0,,Jika seseorang bertanya, saya tidak pasti saya boleh berbohong
Dialog: 0,0:10:04.76,0:10:07.64,teks umum,,0,0,0,,Tetapi demi anda saya akan cuba
Dialog: 0,0:10:12.35,0:10:14.14,miring,,0,0,0,,Saya kebetulan bertemu dengannya di sini
Dialog: 0,0:10:27.32,0:10:28.99,teks umum,,0,0,0,,Mengapa ketua Sosnovy Bor ada di sini?
Dialog: 0,0:10:32.33,0:10:36.29,teks umum,,0,0,0,,Saya harap dia tidak ke sini untuk mendapatkan tiket
Dialog: 0,0:10:38.42,0:10:41.25,teks umum,,0,0,0,,Maka saya tidak akan dapat pergi ke persembahan bersama Dong Gu
Dialog: 0,0:11:22.21,0:11:23.50,teks umum,,0,0,0,,Itu awak
Dialog: 0,0:11:24.63,0:11:26.17,teks umum,,0,0,0,,membunuhnya
Dialog: 0,0:11:28.01,0:11:29.22,teks umum,,0,0,0,,Ini bukan saya
Dialog: 0,0:11:29.97,0:11:31.51,teks umum,,0,0,0,,Kenapa awak bunuh dia?
Dialog: 0,0:11:31.60,0:11:32.97,teks umum,,0,0,0,,Ini benar-benar bukan saya
Dialog: 0,0:11:33.05,0:11:35.02,teks umum,,0,0,0,,Dia sudah mati semasa saya tiba
Dialog: 0,0:11:40.02,0:11:41.52,teks umum,,0,0,0,,Dia dibunuh tidak lama dahulu
Dialog: 0,0:11:42.27,0:11:43.36,contact,,0,0,0,,Dia dibunuh dengan satu pukulan
Dialog: 0,0:11:44.57,0:11:45.94,teks umum,,0,0,0,,Pedang yang mahir
Dialog: 0,0:11:46.61,0:11:49.07,teks umum,,0,0,0,,Saya bersumpah itu bukan saya
Dialog: 0,0:11:49.95,0:11:51.87,teks umum,,0,0,0,,Saya tidak mempunyai pedang
Dialog: 0,0:12:12.84,0:12:14.80,teks umum,,0,0,0,,Saya rasa satu orang membunuh mereka
Dialog: 0,0:12:16.10,0:12:17.39,teks umum,,0,0,0,,Siapakah lelaki ini?
Dialog: 0,0:12:17.47,0:12:22.44,teks am,,0,0,0,,Ini adalah samseng yang tiba di ibu negara baru-baru ini
Dialog: 0,0:12:22.52,0:12:24.52,teks umum,,0,0,0,,Mereka telah tiba
Dialog: 0,0:12:24.61,0:12:28.57,teks am,,0,0,0,,dengan peniaga Kim dari kampung Sari?
Dialog: 0,0:12:28.65,0:12:29.95,teks umum,,0,0,0,,Tidak
Dialog: 0,0:12:30.03,0:12:34.57,teks umum,,0,0,0,,Tetapi saya masih ingat bagaimana samseng itu memulakan pergaduhan dengannya beberapa hari lalu
Dialog: 0,0:12:36.08,0:12:40.96,teks umum,,0,0,0,,Mereka ingin tahu di mana penipu yang tinggal di Sari berada
Dialog: 0,0:12:41.04,0:12:42.62,teks umum,,0,0,0,,Penipuan Sari?
Dialog: 0,0:12:42.71,0:12:44.50,teks umum,,0,0,0,,Mungkin ini Moo Dok?
Dialog: 0,0:12:46.50,0:12:48.76,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,0:12:53.47,0:12:55.14,teks umum,,0,0,0,,Dia ada di sini
Dialog: 0,0:12:57.68,0:12:58.97,teks umum,,0,0,0,,Dia melarikan diri
Dialog: 0,0:13:09.61,0:13:10.82,di sebalik tabir,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:13:11.82,0:13:13.41,luar skrin,,0,0,0,,Apakah mayat ini?
Dialog: 0,0:13:14.24,0:13:18.83,kenangan,,0,0,0,,Mereka ingin tahu di mana penipu yang tinggal di Sari
Dialog: 0,0:13:19.79,0:13:21.16,suara,,0,0,0,,Bolehkah mereka maksudkan saya?
Dialog: 0,0:13:22.29,0:13:25.33,di sebalik tabir,,0,0,0,,Apakah jenis kehidupan yang dijalani Moo Deok?
Dialog: 0,0:13:25.92,0:13:28.55,kenangan,,0,0,0,,Awak pernah jumpa So Yi?
Dialog: 0,0:13:28.63,0:13:30.80,kenangan,,0,0,0,,Saya tertanya-tanya apa yang dia buat kali ini
Dialog: 0,0:13:30.88,0:13:32.67,kenangan,,0,0,0,,Jangan kacau dia
Dialog: 0,0:13:34.84,0:13:35.89,teks umum,,0,0,0,,Jadi saya...
Dialog: 0,0:13:37.68,0:13:39.10,teks umum,,0,0,0,,Siapa So Yi?
Dialog: 0,0:13:42.02,0:13:44.14,teks umum,,0,0,0,,Saya sendiri tidak melihatnya
Dialog: 0,0:13:44.85,0:13:47.94,teks umum,,0,0,0,,Tetapi dia bergaduh dengan semua pengawal, malah menampar muka seorang
Dialog: 0,0:13:48.02,0:13:49.94,contact,,0,0,0,,Saya pasti mereka ingat wajahnya
Dialog: 0,0:13:50.86,0:13:54.03,teks umum,,0,0,0,,Puan, tiada seorang pengawal pun datang hari ini
Dialog: 0,0:13:54.11,0:13:56.16,contact,,0,0,0,,- Mereka berdua tidak datang?\N- Ya
Dialog: 0,0:13:56.24,0:13:58.74,teks umum,,0,0,0,,Pelik. Mereka tidak pernah terlepas kerja
Dialog: 0,0:14:04.54,0:14:07.25,teks umum,,0,0,0,,Maaf. Kita tidak sepatutnya memperlakukan ahli silap mata seperti itu
Dialog: 0,0:14:07.75,0:14:10.38,teks umum,,0,0,0,,Tetapi adakah ini benar-benar perlu?
Dialog: 0,0:14:10.46,0:14:11.88,contact,,0,0,0,,"Magu"?
Dialog: 0,0:14:11.96,0:14:13.38,teks umum,,0,0,0,,Adakah anda berbohong tentang menjadi ahli silap mata?
Dialog: 0,0:14:14.88,0:14:16.09,teks umum,,0,0,0,,Saya akan menjadi dia tidak lama lagi
Dialog: 0,0:14:16.68,0:14:20.68,teks umum,,0,0,0,,Dan lebih berkuasa daripada anda
Dialog: 0,0:14:23.06,0:14:26.48,teks umum,,0,0,0,,Beraninya bercakap palsu dengan saya seperti itu?
Dialog: 0,0:14:26.98,0:14:28.98,teks umum,,0,0,0,,Saya akan bercakap dengan anda,
Dialog: 0,0:14:29.94,0:14:32.78,teks umum,,0,0,0,,dan anda akan menghubungi saya dengan hormat. bukan?
Dialog: 0,0:14:39.74,0:14:41.24,teks umum,,0,0,0,,Lari kejar dia
Dialog: 0,0:14:41.33,0:14:42.74,teks umum,,0,0,0,,Ini tugas anda
Dialog: 0,0:14:49.67,0:14:53.09,teks umum,,0,0,0,,Ada seorang gadis bernama Moo Deok dari kampung Sari di Jwiseonru?
Dialog: 0,0:14:53.17,0:14:56.51,teks umum,,0,0,0,,Ya, saya kenal dia. Adakah anda mencari dia malam itu?
Dialog: 0,0:14:57.47,0:15:00.64,teks umum,,0,0,0,,Saya ingin meminta bantuan daripadanya dan membalas sesuatu
Dialog: 0,0:15:00.72,0:15:02.76,teks umum,,0,0,0,,Moo Deok tiada dalam Jwiseonru
Dialog: 0,0:15:02.85,0:15:06.02,teks umum,,0,0,0,,Dia adalah pembantu rumah dalam keluarga Jang, ini adalah keluarga Gwangju Jeonbugwan
Dialog: 0,0:15:06.68,0:15:08.06,teks umum,,0,0,0,,Adakah dia seorang pembantu rumah?
Dialog: 0,0:15:09.35,0:15:11.31,teks umum,,0,0,0,,Nampaknya dia benar-benar boleh melihat sekarang
Dialog: 0,0:15:12.19,0:15:14.28,teks umum,,0,0,0,,Dia mungkin memperdayakan kamu juga
Dialog: 0,0:15:14.36,0:15:16.03,teks umum,,0,0,0,,Mereka membawanya ke Chwisonra, mereka menyangka dia buta,
Dialog: 0,0:15:16.11,0:15:18.53,teks umum,,0,0,0,,Tetapi semua orang terkejut apabila dia membuka matanya dan melarikan diri
Dialog: 0,0:15:20.12,0:15:22.12,teks umum,,0,0,0,,Tetapi dia bukan penipu seperti saya
Dialog: 0,0:15:23.24,0:15:24.74,teks umum,,0,0,0,,Bagaimana dia boleh melihat?
Dialog: 0,0:15:28.46,0:15:30.25,teks umum,,0,0,0,,Tolong jangan bunuh saya
Dialog: 0,0:15:31.17,0:15:32.38,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:15:32.96,0:15:35.17,teks umum,,0,0,0,,Awak nampak muka saya, saya tak boleh tinggalkan awak hidup-hidup
Dialog: 0,0:15:36.38,0:15:37.59,teks umum,,0,0,0,,Sila...
Dialog: 0,0:16:01.74,0:16:05.29,teks umum,,0,0,0,,Jika dia dapat melihat, maka dia boleh mengenali saya
Dialog: 0,0:16:07.66,0:16:09.58,teks am,,0,0,0,,Adakah dia pembantu rumah keluarga Chan?
Dialog: 0,0:16:11.37,0:16:12.92,teks umum,,0,0,0,,Saya perlu melawatnya
Dialog: 0,0:16:15.50,0:16:17.30,teks am,,0,0,0,,Adakah Mu Dok melakukan pembunuhan?
Dialog: 0,0:16:17.88,0:16:21.05,teks umum,,0,0,0,,Beberapa lelaki terbunuh di rumah penginapan
Dialog: 0,0:16:21.13,0:16:23.80,teks umum,,0,0,0,,Moo Dok ada di sana
Dialog: 0,0:16:23.89,0:16:27.64,teks umum,,0,0,0,,Tetapi Moo Deok tidak cukup kuat untuk membunuh seseorang
Dialog: 0,0:16:27.72,0:16:29.60,teks umum,,0,0,0,,Terutama beberapa lelaki
Dialog: 0,0:16:29.68,0:16:31.90,teks umum,,0,0,0,,Ia dilakukan oleh seorang pendekar pedang yang mahir
Dialog: 0,0:16:32.48,0:16:33.90,teks umum,,0,0,0,,Jika bukan dia,
Dialog: 0,0:16:34.56,0:16:36.61,teks umum,,0,0,0,,ahli silap mata pasti menolongnya
Dialog: 0,0:16:38.11,0:16:39.28,teks umum,,0,0,0,,Jangan beritahu saya,
Dialog: 0,0:16:40.03,0:16:41.95,teks umum,,0,0,0,,bahawa anda mengesyaki tuan kami
Dialog: 0,0:16:43.07,0:16:44.32,teks umum,,0,0,0,,Tidak
Dialog: 0,0:16:44.41,0:16:47.87,teks umum,,0,0,0,,Wook kini berada di istana bersama Master Li
Dialog: 0,0:16:49.79,0:16:51.37,teks umum,,0,0,0,,Syukurlah
Dialog: 0,0:16:51.46,0:16:53.88,teks umum,,0,0,0,,Ia tidak mungkin Moo Deok
Dialog: 0,0:16:53.96,0:16:56.21,teks umum,,0,0,0,,Dia tiada sebab untuk membunuh
Dialog: 0,0:16:56.29,0:16:57.46,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,0:16:57.55,0:17:00.92,teks umum,,0,0,0,,sejauh manakah anda mengenali Moo Deok?
Dialog: 0,0:17:02.51,0:17:03.80,teks umum,,0,0,0,,Anda tahu,
Dialog: 0,0:17:03.89,0:17:09.02,teks umum,,0,0,0,,Apakah jenis kehidupan yang dia jalani sebelum dia mula bekerja di sini?
Dialog: 0,0:17:11.06,0:17:11.94,teks umum,,0,0,0,,Apa?
Dialog: 0,0:17:12.02,0:17:13.73,teks umum,,0,0,0,,Dibunuh -
Dialog: 0,0:17:13.81,0:17:16.44,teks umum,,0,0,0,,lelaki yang saya tanya tentang masa lalu Moo Deok
Dialog: 0,0:17:18.15,0:17:20.11,teks umum,,0,0,0,,Penyamun yang mungkin mencarinya,
Dialog: 0,0:17:20.99,0:17:22.61,teks umum,,0,0,0,,juga mati
Dialog: 0,0:17:25.49,0:17:28.24,teks umum,,0,0,0,,Jelas sekali, dia akan dicurigai,
Dialog: 0,0:17:28.33,0:17:30.87,teks umum,,0,0,0,,tetapi dia melarikan diri daripada membuktikan dia tidak bersalah
Dialog: 0,0:17:31.37,0:17:32.50,teks umum,,0,0,0,,Apa yang saya pasti -
Dialog: 0,0:17:32.58,0:17:37.21,teks umum,,0,0,0,,Moo Dok sedang menyembunyikan sesuatu,
Dialog: 0,0:17:37.29,0:17:40.71,teks umum,,0,0,0,,apa yang tidak boleh didedahkan
Dialog: 0,0:17:50.77,0:17:53.27,teks umum,,0,0,0,,Pengawal tinggal di sana
Dialog: 0,0:17:53.35,0:17:55.19,teks umum,,0,0,0,,Ia akan menjadi lebih pantas
Dialog: 0,0:17:55.27,0:17:58.44,teks umum,,0,0,0,,lukis potretnya dan cari sendiri
Dialog: 0,0:17:58.52,0:18:00.11,teks umum,,0,0,0,,Saya tidak tahu rupa dia
Dialog: 0,0:18:00.19,0:18:03.03,teks umum,,0,0,0,,- Saya bertemu dengannya semasa saya masih buta\N- Saya fikir awak bukan
Dialog: 0,0:18:04.28,0:18:08.32,teks umum,,0,0,0,,Anda mengatakan bahawa anda buta, kemudian anda mengatakan bahawa anda tidak
Dialog: 0,0:18:09.53,0:18:12.45,teks umum,,0,0,0,,Saya tidak tahu apa yang berlaku di sana, tetapi hidup anda jelas bukan gula
Dialog: 0,0:18:14.75,0:18:18.00,teks umum,,0,0,0,,Jadi anda tidak mengenalinya secara penglihatan, tetapi dia mengenali anda?
Dialog: 0,0:18:18.96,0:18:21.17,teks umum,,0,0,0,,Mungkin berbahaya untuk mencarinya?
Dialog: 0,0:18:21.25,0:18:23.97,teks umum,,0,0,0,,Bagaimana jika dia membunuh orang itu?
Dialog: 0,0:18:24.05,0:18:25.55,teks umum,,0,0,0,,Dan tiba-tiba ia akan membahayakan anda
Dialog: 0,0:18:26.88,0:18:29.72,teks umum,,0,0,0,,Lebih bahaya menjadi pemimpin yang disyaki
Dialog: 0,0:18:32.60,0:18:35.23,teks umum,,0,0,0,,Anda juga boleh cedera, tetapi anda membayar pedagang
Dialog: 0,0:18:35.31,0:18:36.56,teks umum,,0,0,0,,Itu?
Dialog: 0,0:18:37.56,0:18:39.73,teks umum,,0,0,0,,Saya tidak faham apa yang anda maksudkan
Dialog: 0,0:18:40.52,0:18:41.57,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:18:42.44,0:18:44.74,teks umum,,0,0,0,, Berpura-pura anda tidak tahu apa-apa
Dialog: 0,0:18:45.70,0:18:47.32,miring,,0,0,0,,Seseorang meninggal dunia!
Dialog: 0,0:19:06.88,0:19:09.01,contact,,0,0,0,,Guardian Li dan Guard Chan!
Dialog: 0,0:19:17.06,0:19:20.56,teks umum,,0,0,0,,Hwangsu akan memberikan kekuatan yang luar biasa
Dialog: 0,0:19:21.23,0:19:24.86,teks umum,,0,0,0,,Saya fikir semua nomad adalah raksasa
Dialog: 0,0:19:25.49,0:19:27.57,teks umum,,0,0,0,,Tetapi anda telah memperoleh keremajaan dan keabadian
Dialog: 0,0:19:29.11,0:19:31.16,teks umum,,0,0,0,,Sudah jelas sekarang,
Dialog: 0,0:19:31.24,0:19:33.87,teks umum,,0,0,0,,kenapa semua orang mahukan batu ais untuk alkimia
Dialog: 0,0:19:34.62,0:19:37.41,teks umum,,0,0,0,,Semua orang sangat menginginkannya, mereka berjuang selama-lamanya
Dialog: 0,0:19:37.50,0:19:39.29,teks umum,,0,0,0,,Oleh itu, sihir ini dilarang
Dialog: 0,0:19:39.37,0:19:40.75,teks umum,,0,0,0,,Baiklah, Cikgu Li
Dialog: 0,0:19:41.67,0:19:43.59,teks umum,,0,0,0,,Anda boleh mengenalinya
Dialog: 0,0:19:43.67,0:19:45.09,teks umum,,0,0,0,,Lihat sekeliling
Dialog: 0,0:19:45.63,0:19:48.51,teks umum,,0,0,0,,Adakah orang perantau di istana?
Dialog: 0,0:20:02.31,0:20:05.19,teks umum,,0,0,0,,Melihat seseorang sahaja tidak mencukupi
Dialog: 0,0:20:05.27,0:20:07.44,teks umum,,0,0,0,,Jika tanda biru tidak kelihatan
Dialog: 0,0:20:07.53,0:20:09.45,teks umum,,0,0,0,,atau tanda-tanda kebiadaban,
Dialog: 0,0:20:09.53,0:20:11.61,teks umum,,0,0,0,,mereka tidak boleh dibezakan daripada orang biasa
Dialog: 0,0:20:12.53,0:20:15.33,teks umum,,0,0,0,, Kemudian bagaimana anda mengenalinya?
Dialog: 0,0:20:16.24,0:20:18.20,teks umum,,0,0,0,,Takut ditangkap
Dialog: 0,0:20:20.29,0:20:22.46,teks umum,,0,0,0,,Takut membatu
Dialog: 0,0:20:26.67,0:20:28.46,teks umum,,0,0,0,,Kita perlu keluarkan ketakutan ini
Dialog: 0,0:20:29.05,0:20:31.84,teks umum,,0,0,0,,Jadi anda menanam rasa takut kepada mereka?
Dialog: 0,0:20:31.93,0:20:33.72,teks umum,,0,0,0,,Maaf jika saya mengecewakan anda
Dialog: 0,0:20:34.30,0:20:35.35,teks umum,,0,0,0,,Sebaliknya
Dialog: 0,0:20:36.64,0:20:38.81,teks umum,,0,0,0,,Saya akan berikan hadiah kepada anda
Dialog: 0,0:20:38.89,0:20:40.94,teks umum,,0,0,0,,Hadiah? apa yang ada?
Dialog: 0,0:20:42.19,0:20:43.35,teks umum,,0,0,0,,Anjing
Dialog: 0,0:20:44.36,0:20:45.31,teks umum,,0,0,0,,Anjing?
Dialog: 0,0:20:45.40,0:20:48.07,teks umum,,0,0,0,,Dia sangat pintar dan patuh
Dialog: 0,0:20:48.15,0:20:50.36,teks umum,,0,0,0,,Dia kini berdiri di pintu pagar istana
Dialog: 0,0:20:50.45,0:20:52.49,teks umum,,0,0,0,,Bolehkah saya memetiknya?
Dialog: 0,0:20:52.57,0:20:54.70,teks umum,,0,0,0,,Oleh kerana ini adalah hadiah, maka sudah tentu
Dialog: 0,0:20:55.49,0:20:56.66,teks umum,,0,0,0,,Bawa anjing itu
Dialog: 0,0:20:57.58,0:20:58.45,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:20:59.16,0:21:00.83,teks umum,,0,0,0,,saya nak awak bawa dia
Dialog: 0,0:21:02.87,0:21:06.34,teks umum,,0,0,0,,Jika anda menguruskannya, saya akan memberi ganjaran kepada anda
Dialog: 0,0:21:36.62,0:21:39.08,suara,,0,0,0,,Mungkin saya patut lari dengan Moo Deok?
Dialog: 0,0:21:40.66,0:21:42.71,di sebalik tabir,,0,0,0,,Maka semua orang akan faham
Dialog: 0,0:21:43.75,0:21:47.17,suara,,0,0,0,,Dan sekarang saya lemah dan tidak akan melindungi guru saya
Dialog: 0,0:21:52.17,0:21:54.22,suara,,0,0,0,,Saya tertanya-tanya apa yang Cikgu Li akan buat?
Dialog: 0,0:22:23.00,0:22:24.21,teks am,,0,0,0,,Timbalan
Dialog: 0,0:22:25.25,0:22:26.62,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:22:30.13,0:22:34.67,teks umum,,0,0,0,,Adakah gebu ini pemberian tuan kepada raja?
Dialog: 0,0:22:34.76,0:22:38.47,teks umum,,0,0,0,,Cikgu Li kata anjing itu akan mengikut kamu
Dialog: 0,0:22:39.05,0:22:40.64,teks umum,,0,0,0,,Tetapi berhati-hati
Dialog: 0,0:22:41.56,0:22:44.73,teks umum,,0,0,0,,Apakah bahaya membawanya ke istana?
Dialog: 0,0:22:45.31,0:22:46.48,teks umum,,0,0,0,,Ada apa?
Dialog: 0,0:22:48.02,0:22:48.98,teks umum,,0,0,0,,Ini Gwigu
Dialog: 0,0:22:49.77,0:22:51.32,teks umum,,0,0,0,,Dia membawa Gwiga ke istana
Dialog: 0,0:22:52.65,0:22:53.94,teks umum,,0,0,0,,Tetapi Gwigu adalah raksasa
Dialog: 0,0:22:54.86,0:22:56.70,teks umum,,0,0,0,,Bagaimana dia boleh membawanya ke istana?
Dialog: 0,0:22:58.78,0:23:02.20,teks umum,,0,0,0,,Guru saya Seo Kyung menggunakan Gwiga
Dialog: 0,0:23:02.29,0:23:05.04,teks umum,,0,0,0,,untuk mencari peninggalan yang dicipta oleh sihir gelap
Dialog: 0,0:23:05.12,0:23:07.87,teks umum,,0,0,0,,menggunakan batu ais
Dialog: 0,0:23:07.96,0:23:09.67,teks umum,,0,0,0,,Ya, saya dengar
Dialog: 0,0:23:09.75,0:23:12.71,teks umum,,0,0,0,,Tetapi saya fikir ia tidak boleh digunakan lagi,
Dialog: 0,0:23:12.80,0:23:14.71,teks umum,,0,0,0,,kerana bekasnya rosak
Dialog: 0,0:23:14.80,0:23:15.76,teks umum,,0,0,0,,Oleh itu
Dialog: 0,0:23:16.63,0:23:20.85,teks umum,,0,0,0,,Saya memindahkan jiwa Gwigu ke dalam badan anjing yang mati
Dialog: 0,0:23:23.14,0:23:24.68,teks umum,,0,0,0,,Anjing yang saya bawa,
Dialog: 0,0:23:25.73,0:23:26.98,teks umum,,0,0,0,,ini Gwigu
Dialog: 0,0:23:29.90,0:23:30.94,teks umum,,0,0,0,,Gwigu?
Dialog: 0,0:23:35.48,0:23:36.57,teks umum,,0,0,0,,Apa yang perlu kita lakukan?
Dialog: 0,0:23:38.11,0:23:39.95,teks umum,,0,0,0,,Berapa ramai antara kita di istana?
Dialog: 0,0:23:40.53,0:23:41.70,teks umum,,0,0,0,,Lebih daripada sepuluh
Dialog: 0,0:23:42.28,0:23:43.66,teks umum,,0,0,0,,Dipindahkan kepada Jeonbugwan?
Dialog: 0,0:23:43.74,0:23:46.62,teks umum,,0,0,0,,Hantar seorang lelaki, mereka akan tiba tidak lama lagi
Dialog: 0,0:24:12.44,0:24:16.82,teks umum,,0,0,0,,Pertemuan ini dianjurkan untuk mewujudkan keamanan antara ahli silap mata dan istana
Dialog: 0,0:24:17.49,0:24:20.82,teks umum,,0,0,0,,Putera Mahkota melawat Sosnovy Bor, dan dia menghormati anda dengan menjemput anda ke sini
Dialog: 0,0:24:20.91,0:24:22.45,teks umum,,0,0,0,,Dan anda mahu membawanya ke sini
Dialog: 0,0:24:22.53,0:24:24.70,teks umum,,0,0,0,,raksasa, tanpa meminta izin Baginda?
Dialog: 0,0:24:24.78,0:24:26.79,teks umum,,0,0,0,,Dia memberi kebenarannya
Dialog: 0,0:24:26.87,0:24:28.66,teks umum,,0,0,0,,Dan kini Gwigu
Dialog: 0,0:24:28.75,0:24:31.46,teks umum,,0,0,0,,bukan raksasa, kerana dalam badan anjing biasa
Dialog: 0,0:24:31.54,0:24:34.67,teks umum,,0,0,0,,Jadi, dia tidak akan dapat membahayakan nomad itu, walaupun dia menjumpainya?
Dialog: 0,0:24:34.75,0:24:38.26,teks umum,,0,0,0,,Dia akan mula menyalak, jadi kita akan faham
Dialog: 0,0:24:39.55,0:24:40.59,teks umum,,0,0,0,,Woof
Dialog: 0,0:24:41.80,0:24:42.80,teks umum,,0,0,0,,Woof!
Dialog: 0,0:25:00.57,0:25:01.99,di sebalik tabir,,0,0,0,,Ini nomad
Dialog: 0,0:25:02.86,0:25:05.95,di sebalik tabir,,0,0,0,,Seperti yang kita sangka, perantau di istana
Dialog: 0,0:25:12.46,0:25:13.58,teks umum,,0,0,0,,Bunyi apakah itu?
Dialog: 0,0:25:14.33,0:25:17.55,teks umum,,0,0,0,,Jadi ada orang perantau di istana saya?
Dialog: 0,0:25:19.34,0:25:20.38,teks umum,,0,0,0,,Nampaknya begitu
Dialog: 0,0:25:21.09,0:25:23.59,teks umum,,0,0,0,,Kalau begitu kenapa awak berdiri di sini?
Dialog: 0,0:25:23.68,0:25:26.43,teks umum,,0,0,0,,Pergi dan tangkap dia!
Dialog: 0,0:25:26.51,0:25:29.39,teks umum,,0,0,0,,Seperti yang saya katakan, anjing adalah hadiah
Dialog: 0,0:25:29.47,0:25:32.35,teks umum,,0,0,0,,Saya tinggalkan di sini
Dialog: 0,0:25:32.44,0:25:34.65,teks umum,,0,0,0,,Menggunakannya anda akan menemui semua orang
Dialog: 0,0:25:34.73,0:25:36.36,teks umum,,0,0,0,, perantau di istana
Dialog: 0,0:25:37.19,0:25:38.98,teks umum,,0,0,0,,Ambil dia, kita tidak perlukan dia
Dialog: 0,0:25:39.61,0:25:42.19,teks umum,,0,0,0,,Beraninya awak bawa raksasa ini ke sini?!
Dialog: 0,0:25:42.28,0:25:43.90,teks umum,,0,0,0,,Raja mengalami kebimbangan
Dialog: 0,0:25:43.99,0:25:46.87,teks umum,,0,0,0,,Adakah anda cuba mencederakan dia dengan raksasa ini?
Dialog: 0,0:25:49.24,0:25:52.87,teks umum,,0,0,0,,Ibu, kami sendiri menjemput Cikgu Li ke istana
Dialog: 0,0:25:52.96,0:25:54.67,teks umum,,0,0,0,,Jangan terlibat dalam perkara ini
Dialog: 0,0:25:55.54,0:25:59.13,teks umum,,0,0,0,,Adalah tanggungjawab Jeonbugwan untuk melindungi istana
Dialog: 0,0:25:59.21,0:26:01.46,teks umum,,0,0,0,,Jika sihir gelap digunakan di istana,
Dialog: 0,0:26:01.55,0:26:03.38,teks umum,,0,0,0,,mereka akan memikirkannya
Dialog: 0,0:26:03.47,0:26:06.01,teks umum,,0,0,0,,Saya tidak mahu melihat raksasa dalam badan anjing,
Dialog: 0,0:26:06.09,0:26:07.89,teks umum,,0,0,0,, mahupun penduduk Sosnovy Bor
Dialog: 0,0:26:08.43,0:26:11.31,teks umum,,0,0,0,,Anda cuba mengaibkan kami
Dialog: 0,0:26:13.35,0:26:15.23,teks umum,,0,0,0,,Hentikan mereka, Yang Mulia
Dialog: 0,0:26:43.09,0:26:45.67,teks umum,,0,0,0,,Anak lelaki Gwangju Jeonbugwan mesti melindungi istana,
Dialog: 0,0:26:45.76,0:26:47.72,teks umum,,0,0,0,,dan awak bawa raksasa ini ke sini
Dialog: 0,0:26:49.60,0:26:51.68,teks umum,,0,0,0,,Ini adalah hadiah daripada Tuan Li kepada raja
Dialog: 0,0:26:51.76,0:26:53.31,teks umum,,0,0,0,,Mari kita masuk
Dialog: 0,0:26:53.39,0:26:55.73,teks umum,,0,0,0,,Saya diperintahkan untuk membawanya
Dialog: 0,0:27:01.36,0:27:02.36,teks umum,,0,0,0,,Begitukah?
Dialog: 0,0:27:02.44,0:27:04.36,teks umum,,0,0,0,,Kemudian cuba log masuk
Dialog: 0,0:27:04.94,0:27:06.82,teks umum,,0,0,0,,Bunuh binatang ini yang memasuki istana
Dialog: 0,0:27:09.32,0:27:12.28,kenangan,,0,0,0,,Jika anda mengendalikannya, saya akan memberi ganjaran kepada anda
Dialog: 0,0:27:12.87,0:27:15.62,suara,,0,0,0,,Jadi dia minta saya bawa anjing itu?
Dialog: 0,0:27:44.07,0:27:45.69,italic,,0,0,0,,Yang Mulia, ini Jin Mu
Dialog: 0,0:27:46.28,0:27:48.90,teks umum,,0,0,0,,Saya akan singkirkan orang-orang kurang ajar ini dari Sosnovy Bor
Dialog: 0,0:27:49.45,0:27:52.45,teks umum,,0,0,0,,Kami di sini atas jemputannya, dan kami belum selesai bercakap
Dialog: 0,0:27:52.53,0:27:54.58,teks umum,,0,0,0,,Jin Mu, kamu tidak sepatutnya terlibat dalam perkara ini
Dialog: 0,0:27:54.66,0:27:56.95,teks umum,,0,0,0,,Beraninya awak bawa raksasa ini ke sini tanpa kebenaran?!
Dialog: 0,0:27:57.04,0:27:58.66,teks umum,,0,0,0,,Tingkah laku apakah ini?!
Dialog: 0,0:27:58.75,0:27:59.96,teks umum,,0,0,0,,Senyap
Dialog: 0,0:28:16.39,0:28:18.68,teks umum,,0,0,0,,Pengawal! Jangan berdiri di sana! Hentikan dia!
Dialog: 0,0:28:23.27,0:28:24.40,teks umum,,0,0,0,,Bapa
Dialog: 0,0:28:24.48,0:28:26.07,teks umum,,0,0,0,,Hentikan kedua-duanya
Dialog: 0,0:28:26.15,0:28:28.40,teks umum,,0,0,0,,Jika pergaduhan bermula, hubungan kita akan berakhir
Dialog: 0,0:28:28.99,0:28:29.95,teks umum,,0,0,0,,Kita mesti lawan!
Dialog: 0,0:28:30.03,0:28:32.95,teks am,,0,0,0,,Hutan pain membawa binatang ini ke sini!
Dialog: 0,0:28:33.03,0:28:34.62,teks umum,,0,0,0,,Chonbugwan mesti melindungi kita
Dialog: 0,0:28:35.37,0:28:37.20,teks umum,,0,0,0,,- Bapa!\N- Tuanku
Dialog: 0,0:28:41.87,0:28:42.96,teks umum,,0,0,0,,Saya pesan semua...
Dialog: 0,0:28:45.00,0:28:46.09,teks umum,,0,0,0,,berhenti
Dialog: 0,0:29:05.36,0:29:06.65,teks umum,,0,0,0,,Berhenti!
Dialog: 0,0:29:21.33,0:29:22.58,teks umum,,0,0,0,,Cikgu Li,
Dialog: 0,0:29:22.67,0:29:25.46,teks umum,,0,0,0,,Saya menjemput awak dengan mesra, adakah perlu untuk menakutkan saya seperti itu?
Dialog: 0,0:29:26.13,0:29:27.67,teks umum,,0,0,0,,Maaf
Dialog: 0,0:29:28.63,0:29:32.01,teks umum,,0,0,0,,Yang Mulia, jika batu ais itu dibuka,
Dialog: 0,0:29:32.09,0:29:34.55,teks umum,,0,0,0,,pertumpahan darah akan bermula semula
Dialog: 0,0:29:35.14,0:29:36.22,teks umum,,0,0,0,,Ais batu?
Dialog: 0,0:29:36.30,0:29:37.97,contact,,0,0,0,,Adakah kerana orang nomad?
Dialog: 0,0:29:38.06,0:29:39.64,teks umum,,0,0,0,,Orang yang digunakan
Dialog: 0,0:29:39.72,0:29:42.73,teks umum,,0,0,0,,pemantul untuk alkimia jiwa selepas Kekacauan Besar
Dialog: 0,0:29:43.44,0:29:47.40,teks umum,,0,0,0,,Nampaknya seseorang sedang membuat reflektor lagi
Dialog: 0,0:29:49.32,0:29:52.70,teks umum,,0,0,0,,Batu ais dicetak
Dialog: 0,0:29:58.87,0:29:59.91,italic,,0,0,0,,Dan?
Dialog: 0,0:29:59.99,0:30:02.16,teks umum,,0,0,0,,Di mana dia? Di tangan siapa?
Dialog: 0,0:30:02.96,0:30:04.71,teks umum,,0,0,0,,Mungkin dengan mereka
Dialog: 0,0:30:04.79,0:30:08.29,teks umum,,0,0,0,,yang menghantar Nak Su dan menjadikan ahli silap mata Sosnovy Bor menjadi nomad
Dialog: 0,0:30:08.88,0:30:10.55,teks umum,,0,0,0,,Saya dengar Master So Kyung
Dialog: 0,0:30:10.63,0:30:12.92,teks umum,,0,0,0,,memusnahkan semua batu ais 200 tahun yang lalu
Dialog: 0,0:30:13.01,0:30:13.92,teks umum,,0,0,0,,Nampaknya,
Dialog: 0,0:30:14.01,0:30:17.93,teks umum,,0,0,0,,tidak semua musnah, ada yang kekal di Sosnovy Bor
Dialog: 0,0:30:18.01,0:30:21.56,teks umum,,0,0,0,,Bukan mudah untuk mengekang keinginan manusia
Dialog: 0,0:30:21.64,0:30:22.68,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:30:24.02,0:30:25.73,teks umum,,0,0,0,,pemulangan batu ais
Dialog: 0,0:30:25.81,0:30:29.06,teks umum,,0,0,0,,menandakan kedatangan seorang lelaki seperti Master So Kyung
Dialog: 0,0:30:32.28,0:30:35.32,teks umum,,0,0,0,,Cikgu So Kyung dilahirkan di bawah bintang Raja
Dialog: 0,0:30:35.90,0:30:38.03,teks umum,,0,0,0,,Namun, dia tidak menjadi raja
Dialog: 0,0:30:39.74,0:30:41.12,teks umum,,0,0,0,,Adakah anda ingin katakan,
Dialog: 0,0:30:41.91,0:30:44.37,teks umum,,0,0,0,,adakah orang lain yang dilahirkan di bawah bintang ini?
Dialog: 0,0:30:49.21,0:30:51.63,miring,,0,0,0,,Walaupun ia wujud, cahayanya akan lemah
Dialog: 0,0:30:51.71,0:30:55.92,contact,,0,0,0,,Dan tenaga tujuh bintang yang mengelilinginya masih belum nyata.
Dialog: 0,0:30:57.01,0:30:59.22,teks umum,,0,0,0,,Kuasa yang boleh menentang alam semula jadi,
Dialog: 0,0:30:59.30,0:31:03.18,teks umum,,0,0,0,,dan membawa huru-hara kepada dunia, dibangkitkan semula
Dialog: 0,0:31:03.27,0:31:05.35,italic,,0,0,0,,Orang yang akan menghentikan ini akan muncul
Dialog: 0,0:31:06.23,0:31:07.31,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:31:08.60,0:31:11.65,teks umum,,0,0,0,,keseimbangan di dunia akan dikekalkan
Dialog: 0,0:31:17.65,0:31:22.41,teks umum,,0,0,0,,Apa yang saya ingin katakan, tidak ada gunanya bimbang
Dialog: 0,0:31:23.87,0:31:27.46,teks umum,,0,0,0,,Saya harap ini membawa ketenangan kepada anda
Dialog: 0,0:31:32.71,0:31:35.09,teks umum,,0,0,0,,Terima kasih atas kata-kata anda
Dialog: 0,0:31:35.92,0:31:38.51,miring,,0,0,0,,Sekarang saya perlu pergi
Dialog: 0,0:31:39.22,0:31:41.55,teks umum,,0,0,0,,Anda menolak pemberian saya,
Dialog: 0,0:31:41.64,0:31:44.35,teks umum,,0,0,0,,jadi saya akan bawa Gviga bersama saya
Dialog: 0,0:31:46.06,0:31:48.06,teks umum,,0,0,0,,- Duli Yang Maha Mulia\N- Lakukan sesuka hati
Dialog: 0,0:32:07.41,0:32:09.54,teks umum,,0,0,0,,Tidak, tunggu
Dialog: 0,0:32:10.37,0:32:12.21,teks umum,,0,0,0,,Adakah kita pergi?
Dialog: 0,0:32:12.29,0:32:13.84,teks umum,,0,0,0,,Saya melihat semua yang saya mahu
Dialog: 0,0:32:16.30,0:32:19.01,kenangan miring,,0,0,0,,Jadi ada orang perantau di istana saya?
Dialog: 0,0:32:19.51,0:32:21.14,kenangan,,0,0,0,,Ambil dia, kita tidak perlukan dia
Dialog: 0,0:32:21.22,0:32:23.80,kenangan,,0,0,0,,Beraninya awak bawa raksasa ini ke sini?!
Dialog: 0,0:32:25.18,0:32:26.93,teks umum,,0,0,0,,Mereka menunjukkan diri mereka apabila saya menanamkan ketakutan kepada mereka
Dialog: 0,0:32:30.60,0:32:32.31,teks umum,,0,0,0,,Takut?
Dialog: 0,0:32:32.40,0:32:33.98,teks umum,,0,0,0,,Tidak cedera?
Dialog: 0,0:32:34.06,0:32:35.86,teks umum,,0,0,0,,Bagaimana anda cedera?
Dialog: 0,0:32:37.07,0:32:40.03,teks umum,,0,0,0,,Anjing itu baik, tetapi saya tidak, kerana awak
Dialog: 0,0:32:41.78,0:32:42.82,teks umum,,0,0,0,,Sakit?
Dialog: 0,0:32:43.49,0:32:45.99,teks umum,,0,0,0,,Saya cedera apabila berlawan dengan penyamun ini, bukan?
Dialog: 0,0:32:46.08,0:32:47.87,teks umum,,0,0,0,,Dia mempunyai perjalanan yang jauh, bukan?
Dialog: 0,0:32:50.25,0:32:52.04,teks umum,,0,0,0,,Tunggu, ini darah. sakit hati?
Dialog: 0,0:32:52.88,0:32:54.04,teks umum,,0,0,0,,Ini darah saya
Dialog: 0,0:32:54.13,0:32:55.42,teks umum,,0,0,0,,Dia tidak cedera sama sekali...
Dialog: 0,0:32:56.13,0:32:58.17,teks umum,,0,0,0,,- Darah...\N- Anda terselit di dalamnya
Dialog: 0,0:32:58.84,0:33:00.76,teks umum,,0,0,0,,Baiklah
Dialog: 0,0:33:06.18,0:33:07.47,teks umum,,0,0,0,,Adakah ia menyakitkan?
Dialog: 0,0:33:09.27,0:33:10.43,teks umum,,0,0,0,,Nampaknya ya
Dialog: 0,0:33:11.06,0:33:13.40,teks umum,,0,0,0,,Sakit...
Dialog: 0,0:33:22.95,0:33:25.12,luar skrin,,0,0,0,,Gwigu kepunyaan Master Li
Dialog: 0,0:33:25.62,0:33:28.54,suara,,0,0,0,,Sejauh manakah dia tahu tentang Moo Deok?
Dialog: 0,0:33:29.54,0:33:31.50,di sebalik tabir,,0,0,0,,Dan apa yang akan Uk lakukan,
Dialog: 0,0:33:31.58,0:33:33.37,suara,,0,0,0,,bila dia akan tahu tentang Nak Soo?
Dialog: 0,0:33:42.05,0:33:43.09,teks umum,,0,0,0,,Awak okey?
Dialog: 0,0:33:44.59,0:33:45.72,teks umum,,0,0,0,,Semua dalam potongan
Dialog: 0,0:33:45.80,0:33:47.55,teks umum,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:33:47.64,0:33:50.35,teks umum,,0,0,0,,Adakah anda menemui orang nomad? Bagaimana dengan batu itu?
Dialog: 0,0:33:51.52,0:33:52.98,teks umum,,0,0,0,,Anda tidak tahu...
Dialog: 0,0:33:53.69,0:33:56.02,teks umum,,0,0,0,,Jiwa saya hampir bergerak dari ketakutan
Dialog: 0,0:33:56.61,0:33:59.11,teks umum,,0,0,0,,Mereka membuat adegan, tetapi tidak menjumpai sesiapa?
Dialog: 0,0:33:59.19,0:34:02.61,teks umum,,0,0,0,,Biarkan anjing menggigit seseorang
Dialog: 0,0:34:03.24,0:34:04.32,miring,,0,0,0,,Uk
Dialog: 0,0:34:04.40,0:34:06.57,teks umum,,0,0,0,,Cari nomad di istana
Dialog: 0,0:34:06.66,0:34:08.99,teks umum,,0,0,0,,lebih sukar daripada dalam Sosnovy Bor atau Jeonbugwan
Dialog: 0,0:34:10.20,0:34:11.70,teks umum,,0,0,0,,Jika keadaan menjadi tidak terkawal,
Dialog: 0,0:34:11.79,0:34:14.29,teks umum,,0,0,0,,konflik akan timbul antara istana dan Sosnovy Bor
Dialog: 0,0:34:17.42,0:34:18.38,miring,,0,0,0,,Jom
Dialog: 0,0:34:18.46,0:34:19.80,teks umum,,0,0,0,,Anda perlu menampal
Dialog: 0,0:34:20.50,0:34:21.51,italic,,0,0,0,,Guru
Dialog: 0,0:34:25.05,0:34:27.05,teks umum,,0,0,0,,Tunggu sebentar
Dialog: 0,0:34:27.14,0:34:30.22,teks umum,,0,0,0,,Putera Mahkota telah meminta untuk mengiringi kamu ke istananya
Dialog: 0,0:34:30.81,0:34:33.10,teks umum,,0,0,0,,- Putera Mahkota?\N- Hujan akan turun
Dialog: 0,0:34:33.18,0:34:35.56,teks umum,,0,0,0,,Dia mahu anda menunggunya
Dialog: 0,0:34:37.81,0:34:38.90,teks umum,,0,0,0,,Plumbum
Dialog: 0,0:34:47.74,0:34:50.49,teks umum,,0,0,0,,Uk, hantar dulu
Dialog: 0,0:34:50.58,0:34:52.08,teks umum,,0,0,0,,dalam Sosnovy Bor
Dialog: 0,0:34:53.25,0:34:54.41,teks umum,,0,0,0,,Datang ke sini
Dialog: 0,0:34:55.83,0:34:56.96,teks umum,,0,0,0,,Di sini
Dialog: 0,0:35:09.18,0:35:12.81,teks umum,,0,0,0,,Anda sepatutnya memberitahu saya bahawa mereka dijemput ke istana!
Dialog: 0,0:35:12.89,0:35:14.06,teks umum,,0,0,0,,Saya fikir ini akan menjadi
Dialog: 0,0:35:14.81,0:35:16.52,teks umum,,0,0,0,,mesyuarat biasa
Dialog: 0,0:35:17.02,0:35:18.06,teks umum,,0,0,0,,Jika permaisuri
Dialog: 0,0:35:18.15,0:35:20.52,teks umum,,0,0,0,,akan menderita, anda akan menjadi batu, seperti sida-sida Kim
Dialog: 0,0:35:20.61,0:35:22.32,teks am,,0,0,0,,Sekeping daging yang tidak berguna!
Dialog: 0,0:35:34.45,0:35:36.54,teks umum,,0,0,0,,Seseorang yang dilahirkan di bawah bintang Raja,
Dialog: 0,0:35:36.62,0:35:38.92,teks umum,,0,0,0,,apakah yang akan mengulangi nasib Cikgu So Kyung?
Dialog: 0,0:35:41.25,0:35:43.84,teks umum,,0,0,0,,Jika ternyata bintang ini adalah buah sihir gelap,
Dialog: 0,0:35:44.80,0:35:46.72,teks umum,,0,0,0,,Tamat Hutan Pine
Dialog: 0,0:35:50.68,0:35:53.97,teks umum,,0,0,0,,Saya menghantar Gviga ke Sosnovy Bor
Dialog: 0,0:35:55.06,0:35:57.10,teks umum,,0,0,0,,Maaf kerana menakutkan anda
Dialog: 0,0:35:57.18,0:35:59.44,teks umum,,0,0,0,,Apabila nomad ditemui di Sosnovy Bor,
Dialog: 0,0:35:59.52,0:36:01.90,teks umum,,0,0,0,,Saya fikir mereka mungkin berada di istana juga
Dialog: 0,0:36:02.94,0:36:06.15,teks umum,,0,0,0,,Baru-baru ini dia pun cuba ke sini
Dialog: 0,0:36:06.90,0:36:09.03,teks umum,,0,0,0,,Saya dengar dia menciptanya
Dialog: 0,0:36:09.11,0:36:10.86,teks umum,,0,0,0,,dan membunuh Nak Su
Dialog: 0,0:36:15.29,0:36:16.37,teks umum,,0,0,0,,Nak Su?
Dialog: 0,0:36:18.25,0:36:21.08,teks umum,,0,0,0,,Seorang tentera upahan yang membunuh ramai pahlawan
Dialog: 0,0:36:21.75,0:36:23.59,teks umum,,0,0,0,,Kepala melayang dari bahu tempat dia berada
Dialog: 0,0:36:23.67,0:36:25.55,teks umum,,0,0,0,,Itulah sebabnya dia dipanggil begitu
Dialog: 0,0:36:25.63,0:36:29.22,teks umum,,0,0,0,,Terdapat khabar angin bahawa dia seorang nomad dan dia masih hidup
Dialog: 0,0:36:32.43,0:36:34.05,teks umum,,0,0,0,,Nomad Nak Su?
Dialog: 0,0:36:35.64,0:36:37.39,teks umum,,0,0,0,,Khabar angin menarik
Dialog: 0,0:37:11.63,0:37:15.26,teks umum,,0,0,0,,Saya harap Mu Deok ditangkap sebelum tuannya kembali
Dialog: 0,0:37:22.52,0:37:24.19,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:37:26.48,0:37:27.86,teks umum,,0,0,0,,Kenapa awak gegar?
Dialog: 0,0:37:28.48,0:37:30.82,teks umum,,0,0,0,,Adakah anda benar-benar percaya bahawa saya telah membunuh seseorang?
Dialog: 0,0:37:32.82,0:37:34.82,teks umum,,0,0,0,,Masuk
Dialog: 0,0:37:40.25,0:37:41.71,teks umum,,0,0,0,,Kenapa awak datang?
Dialog: 0,0:37:42.66,0:37:44.00,teks umum,,0,0,0,,Ambil barang dan lari?
Dialog: 0,0:37:44.08,0:37:46.13,teks umum,,0,0,0,,Saya datang untuk meminta sesuatu
Dialog: 0,0:37:46.71,0:37:48.92,teks umum,,0,0,0,,Ketua berkata untuk menangkap anda sebaik sahaja anda muncul
Dialog: 0,0:37:49.92,0:37:51.09,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:37:51.17,0:37:52.47,teks umum,,0,0,0,,anda tidak melakukan ini?
Dialog: 0,0:37:53.18,0:37:56.01,teks umum,,0,0,0,,- Bukan saya\N- Jadi kenapa awak lari
Dialog: 0,0:37:56.68,0:37:58.10,teks umum,,0,0,0,,Saya terpaksa
Dialog: 0,0:37:59.47,0:38:00.77,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:38:01.52,0:38:02.60,teks umum,,0,0,0,,Anda ada
Dialog: 0,0:38:03.52,0:38:05.40,teks umum,,0,0,0,,sebarang rahsia?
Dialog: 0,0:38:10.90,0:38:12.24,teks umum,,0,0,0,,Tuan Muda
Dialog: 0,0:38:13.32,0:38:15.03,teks umum,,0,0,0,, sedar tentang mereka?
Dialog: 0,0:38:21.04,0:38:24.62,teks umum,,0,0,0,,Moo Dok, awak mesti lari
Dialog: 0,0:38:25.21,0:38:26.29,teks umum,,0,0,0,,Saya akan berikan anda wang
Dialog: 0,0:38:26.37,0:38:27.96,teks umum,,0,0,0,,Lari dan jangan kembali
Dialog: 0,0:38:28.04,0:38:29.17,teks umum,,0,0,0,,Saya tidak boleh
Dialog: 0,0:38:30.38,0:38:32.71,teks umum,,0,0,0,,Saya tidak boleh meninggalkan tuan saya
Dialog: 0,0:38:32.80,0:38:34.05,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:38:35.30,0:38:38.43,teks umum,,0,0,0,,Jika anda berada dekat, dia juga akan dicurigai
Dialog: 0,0:38:38.51,0:38:39.85,teks umum,,0,0,0,,Jika anda bimbang tentang dia,
Dialog: 0,0:38:40.64,0:38:42.10,teks umum,,0,0,0,,kemudian tolong saya
Dialog: 0,0:38:42.18,0:38:45.10,teks umum,,0,0,0,,Anda tidak mahu bercakap dengan kepala, anda juga tidak mahu melarikan diri
Dialog: 0,0:38:45.69,0:38:47.02,teks umum,,0,0,0,,Apa yang anda akan lakukan?
Dialog: 0,0:38:48.69,0:38:50.52,teks umum,,0,0,0,,Kita mesti cari pembunuh
Dialog: 0,0:38:51.98,0:38:56.36,teks umum,,0,0,0,,Pembunuh membunuh mereka yang mengenalinya dengan penglihatan
Dialog: 0,0:39:01.41,0:39:03.45,teks umum,,0,0,0,,Adakah Gwangju Jeongbugwan tinggal di sini?
Dialog: 0,0:39:04.29,0:39:06.16,teks umum,,0,0,0,,Rupa-rupanya keluarga yang berpengaruh
Dialog: 0,0:39:08.12,0:39:11.42,teks umum,,0,0,0,,Adakah sesiapa daripada keluarga Chan mengenali anda?
Dialog: 0,0:39:14.13,0:39:17.34,teks umum,,0,0,0,,Tunggu di sudut. Saya akan membawa lelaki ini
Dialog: 0,0:39:28.14,0:39:30.31,teks umum,,0,0,0,,Saya ingin meminta seseorang untuk mengesahkan,
Dialog: 0,0:39:30.40,0:39:33.98,teks umum,,0,0,0,,bahawa saya tiada di dalam bilik ketika orang itu dibunuh
Dialog: 0,0:39:35.36,0:39:36.65,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:39:37.24,0:39:38.61,teks umum,,0,0,0,,Puan Jin dari Jinyeowon
Dialog: 0,0:39:39.61,0:39:41.20,teks umum,,0,0,0,,Saya terserempak dengan dia di sana
Dialog: 0,0:39:42.20,0:39:44.37,teks umum,,0,0,0,,Sissy ini tidak akan bersetuju untuk bertemu dengan anda
Dialog: 0,0:39:45.62,0:39:46.83,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:39:47.96,0:39:50.21,teks umum,,0,0,0,,Bawa saya ke Jinyeowon
Dialog: 0,0:39:52.42,0:39:53.42,teks umum,,0,0,0,,Jinyeowon?
Dialog: 0,0:40:18.03,0:40:21.45,teks umum,,0,0,0,,Maaf, boleh tolong saya angkat tongkat?
Dialog: 0,0:40:27.91,0:40:28.87,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:40:29.75,0:40:32.29,teks umum,,0,0,0,,Bolehkah anda beritahu saya di mana saya berada?
Dialog: 0,0:40:33.04,0:40:37.01,teks umum,,0,0,0,,Di rumah Gwangju Jeonbugwan
Dialog: 0,0:40:38.80,0:40:39.97,teks umum,,0,0,0,,Faham
Dialog: 0,0:40:41.01,0:40:42.09,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:40:55.36,0:40:56.61,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:40:56.69,0:40:57.73,teks umum,,0,0,0,,Jom
Dialog: 0,0:41:05.53,0:41:07.49,di sebalik tabir,,0,0,0,,Nampaknya Moo Deok boleh nampak sekarang
Dialog: 0,0:41:08.12,0:41:10.08,luar skrin,,0,0,0,,Tetapi dia tidak mengenali saya
Dialog: 0,0:41:10.87,0:41:12.54,di sebalik tabir,,0,0,0,,Saya harap ini menjadi lebih baik
Dialog: 0,0:41:16.17,0:41:17.42,teks umum,,0,0,0,,Kenapa awak bersendirian?
Dialog: 0,0:41:18.21,0:41:21.13,teks umum,,0,0,0,,Saya silap. Kami tidak mengenalinya sama sekali
Dialog: 0,0:41:22.55,0:41:24.97,teks umum,,0,0,0,,Kami sudah selesai. Mari kembali ke Jeonbugwan
Dialog: 0,0:41:37.15,0:41:38.69,teks umum,,0,0,0,,Boleh saya cuba?
Dialog: 0,0:41:38.78,0:41:39.65,teks umum,,0,0,0,,- Tidak\N- Tidak
Dialog: 0,0:41:39.73,0:41:41.86,teks umum,,0,0,0,,Hentikan
Dialog: 0,0:41:41.95,0:41:43.86,miring,,0,0,0,,Saya basah
Dialog: 0,0:41:43.95,0:41:45.57,teks umum,,0,0,0,,Inilah payung itu
Dialog: 0,0:41:46.20,0:41:47.12,kenangan,,0,0,0,,Ini adalah payung
Dialog: 0,0:41:48.08,0:41:49.95,kenangan,,0,0,0,,Boleh digunakan sebagai rotan
Dialog: 0,0:41:52.96,0:41:55.50,teks umum,,0,0,0,,Mak akan tegur saya, hentikan
Dialog: 0,0:41:55.58,0:41:56.50,teks umum,,0,0,0,,Cukup
Dialog: 0,0:41:57.17,0:41:59.42,teks umum,,0,0,0,,- Tidak mungkin\N- Hei
Dialog: 0,0:42:00.71,0:42:03.72,teks umum,,0,0,0,,Adakah anda mahu bertukar payung dengan saya?
Dialog: 0,0:42:07.60,0:42:11.89,teks umum,,0,0,0,,Saya dengar Nak Soo terharu
Dialog: 0,0:42:11.98,0:42:15.73,teks umum,,0,0,0,,ke dalam tubuh seorang lelaki muda yang tinggi lampai
Dialog: 0,0:42:15.81,0:42:19.32,teks umum,,0,0,0,,Dia boleh bergerak ke dalam badan seorang wanita yang kecil dan lemah
Dialog: 0,0:42:21.40,0:42:26.03,teks umum,,0,0,0,,Dengan tubuh yang lemah, tidak ada gunanya menyentuhnya
Dialog: 0,0:42:28.91,0:42:30.04,teks umum,,0,0,0,,Tetapi tidak
Dialog: 0,0:42:30.58,0:42:32.79,teks umum,,0,0,0,,Nak Su berbaju biru pastinya seorang lelaki
Dialog: 0,0:42:33.58,0:42:35.00,teks umum,,0,0,0,,"Nak Su berwarna biru"
Dialog: 0,0:42:35.08,0:42:38.46,teks umum,,0,0,0,,- Saya mendengarnya\N- Dia berpakaian biru
Dialog: 0,0:42:38.54,0:42:42.63,teks umum,,0,0,0,,Ia tersebar ke mana-mana, orang ramai mula berjalan-jalan dengan warna biru
Dialog: 0,0:42:42.71,0:42:45.09,teks umum,,0,0,0,,Mereka fikir begitu
Dialog: 0,0:42:45.18,0:42:48.22,teks umum,,0,0,0,,Nak Su berwarna biru akan melindungi mereka daripada alkimia jiwa
Dialog: 0,0:42:49.93,0:42:51.72,teks umum,,0,0,0,,Nak Su ialah seorang tentera upahan,
Dialog: 0,0:42:53.22,0:42:56.14,teks umum,,0,0,0,,tetapi dia tidak membunuh orang biasa, dan dia tidak mempunyai kekuatan
Dialog: 0,0:43:01.78,0:43:04.65,teks umum,,0,0,0,,Orang ramai boleh jadi bodoh
Dialog: 0,0:43:04.74,0:43:06.32,teks umum,,0,0,0,,Ini bukan kebodohan
Dialog: 0,0:43:07.20,0:43:08.45,teks umum,,0,0,0,,Ini adalah ketakutan
Dialog: 0,0:43:11.20,0:43:13.79,teks umum,,0,0,0,,Mayat Nak Su dibakar, semua orang tahu
Dialog: 0,0:43:14.66,0:43:17.46,teks umum,,0,0,0,,Ini adalah kerja orang berkuasa dan berpengaruh
Dialog: 0,0:43:19.25,0:43:20.71,teks umum,,0,0,0,,Panggil mereka bodoh,
Dialog: 0,0:43:21.67,0:43:23.84,teks umum,,0,0,0,,apabila mereka hanya takut, salah
Dialog: 0,0:43:33.10,0:43:36.73,teks umum,,0,0,0,,Saya mengumpulkan anda dengan harapan untuk mencari penyelesaian,
Dialog: 0,0:43:36.81,0:43:40.02,teks umum,,0,0,0,,tetapi anda mempunyai keberanian untuk duduk di sini dan mengkritik saya
Dialog: 0,0:43:43.27,0:43:46.99,teks umum,,0,0,0,,Saya faham, kamu mahu mengaibkan satu sama lain,
Dialog: 0,0:43:47.07,0:43:50.24,teks umum,,0,0,0,,tetapi saya harap kita semua mula berbaik-baik
Dialog: 0,0:43:51.16,0:43:53.41,teks umum,,0,0,0,,Cikgu Li juga bersama kami
Dialog: 0,0:43:53.49,0:43:54.66,italic,,0,0,0,,Jom minum teh
Dialog: 0,0:43:57.75,0:43:59.04,italic,,0,0,0,,Yang Mulia
Dialog: 0,0:44:00.04,0:44:01.38,teks umum,,0,0,0,,Apa?
Dialog: 0,0:44:04.80,0:44:07.55,teks umum,,0,0,0,,Puan Ho meminta penonton
Dialog: 0,0:44:07.63,0:44:08.63,teks umum,,0,0,0,,Biarkan dia masuk
Dialog: 0,0:44:17.14,0:44:18.43,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:44:18.52,0:44:20.98,teks umum,,0,0,0,,Saya mendengar seseorang cedera selepas pergaduhan
Dialog: 0,0:44:21.56,0:44:23.19,teks umum,,0,0,0,,Saya datang untuk menyemak
Dialog: 0,0:44:25.32,0:44:27.61,contact,,0,0,0,,Hanya seorang yang cedera di sini
Dialog: 0,0:44:27.69,0:44:30.57,teks umum,,0,0,0,,- Bawa dia pergi dan sembuhkan\N- Saya tidak apa-apa
Dialog: 0,0:44:30.66,0:44:32.16,teks umum,,0,0,0,,Ia tidak akan lama
Dialog: 0,0:44:32.24,0:44:33.45,miring,,0,0,0,,Berjalan dengan saya
Dialog: 0,0:44:45.84,0:44:48.51,teks umum,,0,0,0,,Nampaknya Chan Wook akan bertunang lagi
Dialog: 0,0:44:48.59,0:44:49.63,teks umum,,0,0,0,,Sekali lagi?
Dialog: 0,0:44:49.72,0:44:51.72,teks umum,,0,0,0,,- Apakah maksud ini?\N{\i1}- Adakah anda tidak tahu?
Dialog: 0,0:44:51.80,0:44:54.01,teks umum,,0,0,0,,Adakah anda benar-benar tahu apa-apa?
Dialog: 0,0:44:54.10,0:44:56.10,contact,,0,0,0,,Khabar angin sedang tersebar di Saejukwon
Dialog: 0,0:44:56.18,0:44:59.89,teks umum,,0,0,0,,Kamu bertiga adalah calon yang berpotensi untuk memegang watak menantu Master Ho Yeom
Dialog: 0,0:45:00.48,0:45:02.15,teks umum,,0,0,0,,UK ketiga dalam senarai
Dialog: 0,0:45:02.23,0:45:04.06,teks umum,,0,0,0,,Tetapi baginya, nampaknya, dia yang pertama
Dialog: 0,0:45:05.02,0:45:06.98,contact,,0,0,0,,Ho Yeom mahu mengahwininya tahun ini
Dialog: 0,0:45:07.07,0:45:09.78,teks umum,,0,0,0,,Tidak lama lagi mereka akan bercakap tentang pertunangan. Saya memberi jaminan kepada anda
Dialog: 0,0:45:15.87,0:45:19.79,teks umum,,0,0,0,,Lukanya tidak dalam. Pil ini akan menghentikan pendarahan
Dialog: 0,0:45:19.87,0:45:22.71,teks umum,,0,0,0,,Anda sepatutnya memberikannya kepada saya dengan segera
Dialog: 0,0:45:22.79,0:45:24.63,teks umum,,0,0,0,,Saya mendengar tentang luka
Dialog: 0,0:45:24.71,0:45:29.09,teks umum,,0,0,0,,Saya ingin menyemak sendiri untuk bertenang
Dialog: 0,0:45:31.80,0:45:32.88,teks umum,,0,0,0,,Nah...
Dialog: 0,0:45:33.55,0:45:37.89,teks umum,,0,0,0,,Anda cedera lebih daripada sekali, jadi pemikiran ini timbul...
Dialog: 0,0:45:39.02,0:45:40.27,teks umum,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:45:40.98,0:45:42.23,teks umum,,0,0,0,,Okey
Dialog: 0,0:45:48.44,0:45:52.53,teks umum,,0,0,0,,Oh, betul-betul. Pembantu rumah Kim memberikannya kepada saya
Dialog: 0,0:45:52.61,0:45:55.24,teks umum,,0,0,0,,saya belum berterima kasih kepadanya
Dialog: 0,0:45:57.03,0:45:58.33,teks umum,,0,0,0,,Dia sama
Dialog: 0,0:46:03.62,0:46:04.62,teks umum,,0,0,0,,Sama?
Dialog: 0,0:46:06.63,0:46:08.96,teks umum,,0,0,0,,Jepit rambut yang saya lihat dua puluh tahun lalu
Dialog: 0,0:46:09.59,0:46:11.63,teks umum,,0,0,0,,Oh, adakah ini sesuatu yang berharga?
Dialog: 0,0:46:16.34,0:46:17.80,teks umum,,0,0,0,,Nampak baharu
Dialog: 0,0:46:17.89,0:46:19.89,teks umum,,0,0,0,,Mungkin bukan milik kita
Dialog: 0,0:46:20.68,0:46:22.52,teks umum,,0,0,0,,Tetapi ia dilakukan begitu serupa
Dialog: 0,0:46:23.85,0:46:24.69,italic,,0,0,0,,Itu sahaja
Dialog: 0,0:46:25.35,0:46:27.31,teks umum,,0,0,0,,Rupa-rupanya putera raja itu betul
Dialog: 0,0:46:28.44,0:46:30.61,teks umum,,0,0,0,,Tidak lama lagi kita akan mendengar tentang pertunangan Uka
Dialog: 0,0:46:30.69,0:46:32.65,teks umum,,0,0,0,,Tetapi untuk Master Huo dia ketiga dalam senarai
Dialog: 0,0:46:34.99,0:46:37.32,teks umum,,0,0,0,,Adakah anda akan mengahwininya sendiri, kerana anda adalah yang pertama dalam senarai ini?
Dialog: 0,0:46:38.37,0:46:41.41,teks umum,,0,0,0,,Kalau awak kahwin, awak kena balik Seho
Dialog: 0,0:46:42.00,0:46:45.00,teks umum,,0,0,0,,Yul, cuma jangan kahwin. Saya akan kesepian
Dialog: 0,0:46:46.62,0:46:48.92,kenangan miring,,0,0,0,,Saya boleh mengenali nomad
Dialog: 0,0:46:57.51,0:47:00.05,teks umum,,0,0,0,,Kami perlu membawanya bersama kami ke Seho secepat mungkin
Dialog: 0,0:47:00.14,0:47:01.18,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:47:02.06,0:47:02.93,teks umum,,0,0,0,,Saya?
Dialog: 0,0:47:09.11,0:47:10.44,teks umum,,0,0,0,,Saya tarik balik kata-kata saya
Dialog: 0,0:47:11.15,0:47:15.74,teks umum,,0,0,0,,Saya berasa lebih tenang selepas melihat reaksi anda hari ini
Dialog: 0,0:47:16.32,0:47:17.95,teks umum,,0,0,0,,Gembira mendengarnya
Dialog: 0,0:47:18.87,0:47:20.91,teks umum,,0,0,0,,Apa yang anda mahu tanya saya secara peribadi?
Dialog: 0,0:47:23.08,0:47:25.66,teks umum,,0,0,0,,Saya tahu awak ada pedang Nak Su
Dialog: 0,0:47:25.75,0:47:27.75,teks umum,,0,0,0,,Bolehkah saya mengambilnya?
Dialog: 0,0:47:36.42,0:47:39.64,teks umum,,0,0,0,,Saya menonton rancangan itu tahun lepas
Dialog: 0,0:47:40.22,0:47:41.47,teks umum,,0,0,0,,Terdapat gajah di sana
Dialog: 0,0:47:41.97,0:47:45.18,teks umum,,0,0,0,,Tetapi apabila saya pergi dengan Dan Gu, saya perlu berpura-pura bahawa ini kali pertama saya ke sana
Dialog: 0,0:47:45.27,0:47:47.81,teks umum,,0,0,0,,Jadi tiket itu untuk awak dan Encik Dan Gu?
Dialog: 0,0:47:47.89,0:47:50.06,teks umum,,0,0,0,,Takut. awak buat apa kat sini?
Dialog: 0,0:47:50.15,0:47:52.69,teks umum,,0,0,0,,Saya datang untuk meminta bantuan
Dialog: 0,0:47:52.77,0:47:53.90,teks umum,,0,0,0,,Mengenai perkhidmatan?
Dialog: 0,0:47:54.94,0:47:56.32,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:47:56.40,0:47:59.49,teks umum,,0,0,0,,Tiada keinginan untuk membantu anda
Dialog: 0,0:47:59.57,0:48:01.20,teks am,,0,0,0,,Saya dituduh membunuh
Dialog: 0,0:48:01.95,0:48:03.08,teks umum,,0,0,0,,Apa?
Dialog: 0,0:48:03.16,0:48:05.41,teks umum,,0,0,0,,Anda boleh pergi ke ketua Sosnovy Bor
Dialog: 0,0:48:06.12,0:48:08.54,teks umum,,0,0,0,,dan katakan bahawa anda melihat saya?
Dialog: 0,0:48:09.67,0:48:13.92,teks umum,,0,0,0,,Adakah anda mahu saya pergi ke kepala dan mengaku bahawa saya pergi
Dialog: 0,0:48:14.50,0:48:15.76,teks umum,,0,0,0,,ke tempat sedemikian?
Dialog: 0,0:48:16.46,0:48:18.30,teks umum,,0,0,0,,Saya tidak gila
Dialog: 0,0:48:20.18,0:48:21.80,teks umum,,0,0,0,,Anda adalah satu-satunya harapan saya
Dialog: 0,0:48:22.47,0:48:24.35,teks umum,,0,0,0,,Sila
Dialog: 0,0:48:27.43,0:48:28.60,teks umum,,0,0,0,,Tidak
Dialog: 0,0:48:28.68,0:48:30.60,teks umum,,0,0,0,,Saya memberitahu Dan Gu bahawa saya mempunyai tiket tambahan
Dialog: 0,0:48:30.69,0:48:32.56,teks umum,,0,0,0,,Saya tidak mahu dia tahu di mana saya membelinya
Dialog: 0,0:48:32.65,0:48:35.27,teks umum,,0,0,0,,Aib anda akan sementara,
Dialog: 0,0:48:35.36,0:48:37.36,teks umum,,0,0,0,,dan mereka boleh membunuh saya
Dialog: 0,0:48:38.36,0:48:40.40,teks umum,,0,0,0,,Jika ibu tahu, saya juga tidak akan hidup
Dialog: 0,0:48:40.49,0:48:43.24,teks umum,,0,0,0,,Dia tidak akan pernah membunuh anak perempuannya!
Dialog: 0,0:48:43.32,0:48:45.54,teks umum,,0,0,0,,Mengapa kamu menjerit apabila kamu datang meminta pertolongan?
Dialog: 0,0:48:48.29,0:48:51.58,teks umum,,0,0,0,,Kalau begitu saya perlu beritahu ibu awak semuanya sendiri
Dialog: 0,0:48:52.08,0:48:53.71,teks umum,,0,0,0,,dan minta bantuannya
Dialog: 0,0:48:53.79,0:48:55.42,teks umum,,0,0,0,, Patutkah saya bertanya kepada ibu saya?
Dialog: 0,0:48:56.84,0:48:58.38,teks umum,,0,0,0,,Ini dia datang
Dialog: 0,0:49:00.76,0:49:03.80,teks umum,,0,0,0,,Anda tidak sepatutnya peduli dengan hadiah sebagai permintaan maaf untuk masa lalu
Dialog: 0,0:49:05.10,0:49:08.77,teks umum,,0,0,0,,Semakin saya memikirkannya, semakin saya ingin meminta maaf
Dialog: 0,0:49:10.18,0:49:12.73,teks umum,,0,0,0,,Saya akan pergi dan tanya dia sendiri
Dialog: 0,0:49:12.81,0:49:13.73,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:49:13.81,0:49:16.90,teks umum,,0,0,0,,Saya akan fikirkannya. Mula-mula ikut saya
Dialog: 0,0:49:25.74,0:49:27.79,teks umum,,0,0,0,,Saya akan kembali segera. tunggu sini
Dialog: 0,0:49:28.37,0:49:29.83,teks umum,,0,0,0,,Jika anda tidak kembali, saya akan menjerit
Dialog: 0,0:49:29.91,0:49:31.41,teks umum,,0,0,0,,- Saya akan kembali\N-{\i1} Cho Young
Dialog: 0,0:49:32.21,0:49:33.33,teks umum,,0,0,0,,Ya, ibu
Dialog: 0,0:49:34.13,0:49:34.96,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:50:06.28,0:50:07.66,teks umum,,0,0,0,,Sangat muda
Dialog: 0,0:50:08.99,0:50:10.16,teks umum,,0,0,0,,Saya tertanya-tanya siapa itu?
Dialog: 0,0:50:39.61,0:50:41.23,teks umum,,0,0,0,,Adakah kerana kemenyan?
Dialog: 0,0:50:45.24,0:50:46.53,teks umum,,0,0,0,,Pasu yang cantik
Dialog: 0,0:50:47.57,0:50:51.54,teks umum,,0,0,0,,Jika anda meletakkan bunga dalam pasu ini, ia akan berbau lebih kuat
Dialog: 0,0:50:52.79,0:50:54.71,teks umum,,0,0,0,,- Betul ke?\N- Ya
Dialog: 0,0:50:54.79,0:50:58.00,teks umum,,0,0,0,,Saya sudah lama ingin menukar pasu di bilik anak perempuan saya
Dialog: 0,0:50:59.04,0:50:59.96,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:51:03.67,0:51:06.72,teks umum,,0,0,0,,Ibu, bolehkah kamu meletakkan pasu di dalam bilik Boo Young unnie?
Dialog: 0,0:51:06.80,0:51:08.72,teks umum,,0,0,0,,Bunga akan berbau lebih kuat
Dialog: 0,0:51:08.80,0:51:12.47,teks umum,,0,0,0,,Kakak kamu buta, jadi sekurang-kurangnya dia dapat menikmati bau bunga
Dialog: 0,0:51:56.77,0:51:58.10,teks umum,,0,0,0,,Beraninya awak?!
Dialog: 0,0:51:58.19,0:52:00.02,teks umum,,0,0,0,,Apa yang kamu lakukan di dalam bilik anak perempuan saya?
Dialog: 0,0:52:04.90,0:52:06.32,teks umum,,0,0,0,,Dia ikut saya
Dialog: 0,0:52:06.40,0:52:07.86,teks umum,,0,0,0,,Mungkin hilang
Dialog: 0,0:52:08.45,0:52:10.70,teks umum,,0,0,0,,Moo Dok, awak buat apa di sini?
Dialog: 0,0:52:12.99,0:52:14.16,teks umum,,0,0,0,,Maaf
Dialog: 0,0:52:15.95,0:52:18.12,contact,,0,0,0,,Bantuan sekali
Dialog: 0,0:52:19.46,0:52:21.04,contact,,0,0,0,,Pergi
Dialog: 0,0:52:21.13,0:52:22.96,teks umum,,0,0,0,,Dan jangan kembali lagi
Dialog: 0,0:52:23.04,0:52:24.75,teks umum,,0,0,0,,Ya
Dialog: 0,0:52:28.34,0:52:30.18,italic,,0,0,0,,Saya akan datang. saya janji
Dialog: 0,0:52:32.64,0:52:33.72,teks umum,,0,0,0,,Cho Young,
Dialog: 0,0:52:34.39,0:52:37.98,teks umum,,0,0,0,,suruh orang suruhan bersihkan bilik adik kamu semula
Dialog: 0,0:52:38.73,0:52:40.52,teks umum,,0,0,0,,Ya, ibu
Dialog: 0,0:53:08.26,0:53:09.26,teks umum,,0,0,0,,Jadi saya
Dialog: 0,0:53:10.26,0:53:12.05,teks umum,,0,0,0,,Lelaki ini akan menjadi bapa kamu
Dialog: 0,0:53:13.01,0:53:14.14,teks umum,,0,0,0,,Ayah?
Dialog: 0,0:53:15.05,0:53:17.47,teks umum,,0,0,0,,Seorang bapa mahu membawa anak perempuan palsu ke dalam rumah?
Dialog: 0,0:53:20.85,0:53:24.48,teks am,,0,0,0,,Saya bukan bapa Jin Bu Young berdasarkan darah
Dialog: 0,0:53:25.98,0:53:29.03,teks umum,,0,0,0,,Ayah kandungnya orang lain
Dialog: 0,0:53:41.66,0:53:44.38,teks umum,,0,0,0,,Untuk diiktiraf sebagai anak perempuan keluarga Jin,
Dialog: 0,0:53:44.46,0:53:46.34,teks umum,,0,0,0,,anda mesti membuka pintu Jinyeowon
Dialog: 0,0:53:46.42,0:53:49.84,teks umum,,0,0,0,,Dan untuk ini, darah mereka mesti mengalir melalui urat anda
Dialog: 0,0:53:53.72,0:53:55.05,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:53:55.14,0:53:58.47,teks umum,,0,0,0,,Seekor cacing yang mengandungi darah ahli keluarga Jin
Dialog: 0,0:54:20.45,0:54:22.37,teks umum,,0,0,0,,Ini adalah darah Cho Young,
Dialog: 0,0:54:23.37,0:54:24.92,teks umum,,0,0,0,,kegemaran saya
Dialog: 0,0:54:26.79,0:54:28.96,teks umum,,0,0,0,,Dan apakah yang akan anda lakukan mengenainya?
Dialog: 0,0:54:29.04,0:54:30.46,teks umum,,0,0,0,,Ulurkan tangan anda
Dialog: 0,0:54:32.63,0:54:34.22,teks umum,,0,0,0,,Jangan tunggu saya
Dialog: 0,0:55:17.68,0:55:20.85,suara,,0,0,0,,Sekarang kamu mempunyai darah keluarga Jin
Dialog: 0,0:55:21.93,0:55:24.35,suara,,0,0,0,,Jika saya tidak menggunakan sihir gelap,
Dialog: 0,0:55:24.43,0:55:27.31,suara,,0,0,0,,cacing ini akan memakan anda dari dalam
Dialog: 0,0:55:28.65,0:55:30.23,contact,,0,0,0,,Cuba melarikan diri,
Dialog: 0,0:55:31.07,0:55:33.36,italic,,0,0,0,,cacing ini akan memakan kamu hidup-hidup
Dialog: 0,0:55:40.45,0:55:43.12,teks umum,,0,0,0,,Ini adalah bilik anak perempuannya, yang meninggal dunia 10 tahun lalu
Dialog: 0,0:55:44.29,0:55:45.87,teks umum,,0,0,0,,Nampaknya dia lemas,
Dialog: 0,0:55:46.62,0:55:49.17,teks umum,,0,0,0,,tetapi Puan Jin masih fikir dia akan kembali
Dialog: 0,0:55:50.75,0:55:51.96,teks umum,,0,0,0,,Saya kasihan kepadanya
Dialog: 0,0:55:52.92,0:55:54.59,teks umum,,0,0,0,,Maafkan dia atas tamparan itu
Dialog: 0,0:55:57.72,0:56:00.76,teks umum,,0,0,0,,Dan anak perempuannya buta?
Dialog: 0,0:56:01.68,0:56:03.97,teks umum,,0,0,0,,Ya, itu
Dialog: 0,0:56:05.27,0:56:07.48,luar skrin,,0,0,0,,Pemilik badan ini juga buta
Dialog: 0,0:56:08.27,0:56:10.60,luar skrin,,0,0,0,,Mungkin sebab itu saya rasa sesuatu yang pelik?
Dialog: 0,0:56:28.08,0:56:31.21,teks umum,,0,0,0,,Cikgu Li ingin bercakap tentang sesuatu dengan putera raja sahaja
Dialog: 0,0:56:31.83,0:56:32.84,teks umum,,0,0,0,,Faham
Dialog: 0,0:56:38.01,0:56:40.97,teks umum,,0,0,0,,Ketua meminta untuk menemani anda ke Sosnovy Bor
Dialog: 0,0:56:41.55,0:56:43.55,teks umum,,0,0,0,,Saya? kenapa?
Dialog: 0,0:56:43.64,0:56:44.64,contact,,0,0,0,,Mari bersama kami
Dialog: 0,0:56:55.15,0:56:56.73,teks umum,,0,0,0,,Mereka akan mengurung saya di sini semula, bukan?
Dialog: 0,0:56:57.23,0:56:59.07,teks umum,,0,0,0,,- Apa yang sedang berlaku?\N- Ini...
Dialog: 0,0:56:59.78,0:57:01.11,teks umum,,0,0,0,,Kami diarahkan untuk senyap
Dialog: 0,0:57:01.91,0:57:03.12,italic,,0,0,0,,Tunggu dia di sini
Dialog: 0,0:57:12.83,0:57:16.09,teks umum,,0,0,0,,Mu Dok dilihat di sebelah mayat, jelas sebab dia dibawa pergi
Dialog: 0,0:57:16.17,0:57:18.67,teks umum,,0,0,0,,Tetapi kenapa, tuan? Dia berada di dalam istana
Dialog: 0,0:57:20.05,0:57:22.59,teks umum,,0,0,0,,Apakah yang difikirkan oleh kepala?
Dialog: 0,0:57:22.68,0:57:23.68,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:57:26.31,0:57:27.35,teks umum,,0,0,0,,Yul,
Dialog: 0,0:57:27.43,0:57:29.56,teks umum,,0,0,0,,Moo Dok tidak akan membunuh sesiapa
Dialog: 0,0:57:30.18,0:57:31.27,condong,,0,0,0,,Betul ke?
Dialog: 0,0:57:34.36,0:57:36.52,teks am,,0,0,0,,Boleh saya tengok mayat?
Dialog: 0,0:57:49.41,0:57:51.29,teks umum,,0,0,0,,Pembunuh itu menghunus pedang dengan mahir
Dialog: 0,0:57:51.91,0:57:53.54,teks umum,,0,0,0,,Ini bukan Moo Deok
Dialog: 0,0:57:55.17,0:57:56.75,luar skrin,,0,0,0,,Tetapi dia Nak Soo
Dialog: 0,0:57:57.71,0:57:59.46,luar skrin,,0,0,0,,Dia boleh membunuh mereka
Dialog: 0,0:58:04.64,0:58:07.55,kenangan miring,,0,0,0,,Saya ada alasan,
Dialog: 0,0:58:07.64,0:58:09.06,kenangan condong,,0,0,0,,jangan ganggu saya
Dialog: 0,0:58:12.64,0:58:15.48,teks umum,,0,0,0,,- Ini penyamun\N- Adakah anda mengenali mereka?
Dialog: 0,0:58:17.77,0:58:20.03,teks umum,,0,0,0,,Saya melawan mereka tidak lama dahulu
Dialog: 0,0:58:25.28,0:58:27.83,teks am,,0,0,0,,Bolehkah saya mengambil mayat mereka dan menjalankan pengebumian?
Dialog: 0,0:58:34.37,0:58:36.50,teks umum,,0,0,0,,Apa yang membawa Ketua Chwisonra ke sini?
Dialog: 0,0:58:36.58,0:58:38.09,teks umum,,0,0,0,,Adakah seseorang meninggal dunia?
Dialog: 0,0:58:38.17,0:58:40.63,teks umum,,0,0,0,,Pengawal kami terbunuh
Dialog: 0,0:58:53.93,0:58:55.31,teks umum,,0,0,0,,Dan Gu
Dialog: 0,0:58:55.39,0:58:57.31,teks umum,,0,0,0,,Hamba Kim memberitahu tentang apa yang berlaku
Dialog: 0,0:58:59.23,0:59:00.61,teks umum,,0,0,0,,Cho Young,
Dialog: 0,0:59:01.61,0:59:03.24,teks umum,,0,0,0,,bantu Moo Dok
Dialog: 0,0:59:11.12,0:59:13.87,teks umum,,0,0,0,,Saya pergi ke sana untuk membeli tiket
Dialog: 0,0:59:15.71,0:59:17.58,teks umum,,0,0,0,,Moo Deok ada di sana
Dialog: 0,0:59:19.67,0:59:20.71,teks umum,,0,0,0,,Sudah tentu,
Dialog: 0,0:59:20.79,0:59:24.59,teks umum,,0,0,0,,itu kali pertama saya berada di tempat sedemikian
Dialog: 0,0:59:25.17,0:59:26.26,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:59:27.09,0:59:30.85,teks umum,,0,0,0,,Kami bercakap sedikit, dan kemudian Moo Deok masuk
Dialog: 0,0:59:30.93,0:59:32.89,teks umum,,0,0,0,,Saya melihat anda juga semasa anda masuk
Dialog: 0,0:59:33.81,0:59:38.27,teks umum,,0,0,0,,Sudah tentu, saya tidak sangka saya akan melihat anda di tempat sedemikian
Dialog: 0,0:59:39.94,0:59:41.11,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:59:44.57,0:59:45.99,teks umum,,0,0,0,,Inilah yang berlaku...
Dialog: 0,0:59:47.03,0:59:51.12,teks umum,,0,0,0,,Moo Dok tidak akan mempunyai masa yang cukup untuk membunuh lelaki itu
Dialog: 0,0:59:52.16,0:59:55.37,teks umum,,0,0,0,,Baru-baru ini seorang gadis datang ke Chwisung-ru, mencari Moo Deok
Dialog: 0,0:59:55.45,0:59:56.91,teks umum,,0,0,0,,Dia berpura-pura menjadi ahli silap mata
Dialog: 0,0:59:57.00,0:59:58.50,teks umum,,0,0,0,,Chwisongru berfikir,
Dialog: 0,0:59:58.58,1:00:02.54,teks umum,,0,0,0,,ini boleh jadi So Yi, gadis pedagang yang memberi amaran kepada Moo Deok tentang
Dialog: 0,1:00:02.63,1:00:05.01,teks umum,,0,0,0,,Saya pernah melihat seorang gadis diseret oleh penyamun ini
Dialog: 0,1:00:06.34,1:00:07.59,teks umum,,0,0,0,,Pedagang,
Dialog: 0,1:00:07.67,1:00:08.97,teks umum,,0,0,0,,penyamun dan pengawal
Dialog: 0,1:00:09.84,1:00:12.10,teks umum,,0,0,0,,Mereka semua bersilang dengan ini Jadi saya
Dialog: 0,1:00:12.18,1:00:14.01,teks umum,,0,0,0,,Penipu So Yi ini sangat mencurigakan
Dialog: 0,1:00:14.89,1:00:17.14,teks umum,,0,0,0,,Ini bermakna Moo Deok tidak boleh dipersalahkan
Dialog: 0,1:00:18.69,1:00:19.73,teks umum,,0,0,0,,Okey
Dialog: 0,1:00:20.73,1:00:25.32,teks umum,,0,0,0,,Saya sendiri meragui bahawa Moo Dok boleh membunuh seseorang
Dialog: 0,1:00:25.40,1:00:29.53,teks umum,,0,0,0,,Itu sahaja. Anda tahu, pakcik, bahawa Moo Deok tidak mampu melakukan ini, bukan?
Dialog: 0,1:00:29.61,1:00:33.16,teks umum,,0,0,0,,Bolehkah awak lepaskan Wook dan Moo Deok pergi sekarang?
Dialog: 0,1:00:33.24,1:00:35.49,teks umum,,0,0,0,,Saya mengurungnya supaya
Dialog: 0,1:00:36.37,1:00:38.33,teks umum,,0,0,0,,tanya sesuatu
Dialog: 0,1:00:39.37,1:00:40.87,italic,,0,0,0,,Selebihnya saya uruskan sendiri
Dialog: 0,1:00:40.96,1:00:42.08,teks umum,,0,0,0,,Anda boleh pergi
Dialog: 0,1:00:42.17,1:00:43.34,teks umum,,0,0,0,,Okay
Dialog: 0,1:01:02.27,1:01:03.52,teks umum,,0,0,0,,Bab
Dialog: 0,1:01:04.27,1:01:06.90,teks umum,,0,0,0,,Sekurang-kurangnya beritahu saya apa yang salah
Dialog: 0,1:01:07.69,1:01:10.15,teks umum,,0,0,0,,Moo Dok melakukan pembunuhan
Dialog: 0,1:01:13.28,1:01:14.28,teks umum,,0,0,0,,Apa...
Dialog: 0,1:01:14.37,1:01:17.45,teks umum,,0,0,0,,Dia membunuh mereka yang mengenalinya pada masa lalu
Dialog: 0,1:01:20.62,1:01:24.67,teks umum,,0,0,0,,Beritahu saya perkara yang anda dan Moo Deok sembunyikan
Dialog: 0,1:01:25.84,1:01:28.30,teks umum,,0,0,0,,Jika kata-kata anda tidak bertepatan dengan kata-kata Moo Deok,
Dialog: 0,1:01:28.88,1:01:31.22,teks umum,,0,0,0,,anda tidak akan meninggalkan bilik ini
Dialog: 0,1:01:32.05,1:01:33.80,teks umum,,0,0,0,,Dan Moo Deok akan mati
Dialog: 0,1:01:55.12,1:01:56.66,teks umum,,0,0,0,,Bab, dengar...
Dialog: 0,1:01:56.74,1:01:58.08,teks umum,,0,0,0,,Ini bukan tentang pembunuhan
Dialog: 0,1:02:00.04,1:02:02.00,teks umum,,0,0,0,,UK mendedahkan rahsia anda kepada saya
Dialog: 0,1:02:03.29,1:02:04.54,teks umum,,0,0,0,,Dia memberitahu segala-galanya
Dialog: 0,1:02:08.13,1:02:12.05,teks umum,,0,0,0,,Jika anda juga bercakap benar, saya akan menyelamatkan nyawa anda
Dialog: 0,1:02:13.18,1:02:14.34,teks umum,,0,0,0,,Tetapi jika,
Dialog: 0,1:02:14.43,1:02:17.51,teks umum,,0,0,0,,perkataan anda akan berbeza,
Dialog: 0,1:02:19.43,1:02:20.89,teks umum,,0,0,0,,anda akan mati
Dialog: 0,1:02:29.82,1:02:31.69,suara,,0,0,0,,Jika dia tahu bahawa dia seorang nomad,
Dialog: 0,1:02:31.78,1:02:33.74,di sebalik tabir,,0,0,0,,tidak akan membuang masa seperti ini
Dialog: 0,1:02:33.82,1:02:36.41,luar skrin,,0,0,0,,Dia cuba memecahbelahkan kami dengan menyoal siasat kami secara berasingan
Dialog: 0,1:02:37.24,1:02:39.58,di sebalik tabir,,0,0,0,,Kita mesti cakap perkara yang sama
Dialog: 0,1:02:41.37,1:02:44.62,suara,,0,0,0,,Apa yang akan dijawab oleh Chan Wook?
Dialog: 0,1:02:44.71,1:02:48.54,di sebalik tabir,,0,0,0,, Rahsia yang kami berdua pasti akan bongkar
Dialog: 0,1:02:48.63,1:02:53.22,di sebalik tabir,,0,0,0,, Rahsia, yang pendedahannya tidak akan membawa kepada kematian saya
Dialog: 0,1:02:56.30,1:02:57.76,teks umum,,0,0,0,,Saya akan beritahu anda
Dialog: 0,1:02:57.84,1:02:59.22,teks umum,,0,0,0,,Saya mengaku kepada awak
Dialog: 0,1:03:06.90,1:03:08.36,teks umum,,0,0,0,,Apa yang berlaku?
Dialog: 0,1:03:09.36,1:03:11.32,teks umum,,0,0,0,,Moo Deok dan Chan Wook
Dialog: 0,1:03:12.19,1:03:13.32,teks umum,,0,0,0,,anda boleh lepaskan
Dialog: 0,1:03:13.82,1:03:16.86,teks umum,,0,0,0,,Apa yang mereka katakan? Satu dan sama?
Dialog: 0,1:03:20.08,1:03:23.08,teks umum,,0,0,0,,Mereka berkata... perkara yang sama
Dialog: 0,1:03:52.57,1:03:55.44,teks umum,,0,0,0,,- Anda pergi\N- Anda juga
Dialog: 0,1:03:56.03,1:03:58.91,teks umum,,0,0,0,,- Gembira awak okay\N- Saya juga
Dialog: 0,1:03:58.99,1:04:00.82,teks umum,,0,0,0,,Syukurlah, kami berkata perkara yang sama
Dialog: 0,1:04:02.37,1:04:03.87,teks umum,,0,0,0,,Apa yang anda katakan?
Dialog: 0,1:04:03.95,1:04:05.66,teks umum,,0,0,0,,Kami berdua pergi...
Dialog: 0,1:04:07.04,1:04:09.04,teks umum,,0,0,0,,jadi anda berkata perkara yang sama
Dialog: 0,1:04:14.00,1:04:17.47,teks umum,,0,0,0,,Anda mengurung mereka untuk mengetahui apa yang mereka sembunyikan
Dialog: 0,1:04:17.55,1:04:19.47,teks umum,,0,0,0,,Saya rasa anda telah mengetahui sesuatu
Dialog: 0,1:04:19.55,1:04:20.39,teks umum,,0,0,0,,Beritahu
Dialog: 0,1:04:20.47,1:04:22.85,teks umum,,0,0,0,,Apakah rahsia mereka?
Dialog: 0,1:04:23.76,1:04:25.18,teks umum,,0,0,0,,Mereka...
Dialog: 0,1:04:26.27,1:04:29.73,teks umum,,0,0,0,,betul-betul membuatkan saya terdiam
Dialog: 0,1:04:32.56,1:04:35.19,teks umum,,0,0,0,,Mereka menunjukkan perkara yang sama
Dialog: 0,1:04:37.11,1:04:38.49,kenangan miring,,0,0,0,,Saya akan beritahu perkara sebenar
Dialog: 0,1:04:39.40,1:04:41.03,kenangan,,0,0,0,,Saya cuba untuk tidak ditangkap
Dialog: 0,1:04:42.28,1:04:44.08,kenangan,,0,0,0,,Ini yang saya sembunyikan
Dialog: 0,1:05:01.72,1:05:03.22,kenangan,,0,0,0,,Anda lihat, saya...
Dialog: 0,1:05:03.72,1:05:06.10,kenangan,,0,0,0,,Sebenarnya saya...
Dialog: 0,1:05:13.06,1:05:14.69,kenangan,,0,0,0,,cinta Moo Deok
Dialog: 0,1:05:18.53,1:05:20.36,kenangan,,0,0,0,,Saya sangat menyayangi pemiliknya
Dialog: 0,1:05:26.74,1:05:29.20,teks umum,,0,0,0,,Saya fikir anda mungkin akan mengakuinya
Dialog: 0,1:05:31.04,1:05:33.42,teks umum,,0,0,0,,Mereka tidak akan membunuh saya untuk ini
Dialog: 0,1:05:33.50,1:05:37.25,teks umum,,0,0,0,,Ya, dan tiada apa-apa tentang perkara ini dalam buku peraturan Sosnovy Bor
Dialog: 0,1:05:37.34,1:05:39.71,teks umum,,0,0,0,,Tiada larangan bagi lelaki untuk mencintai perempuan
Dialog: 0,1:05:42.88,1:05:43.72,teks umum,,0,0,0,,Ya
Dialog: 0,1:05:43.80,1:05:47.85,teks umum,,0,0,0,,Dan cinta seorang hamba kepada tuannya tidak akan membawa kepada kematian
Dialog: 0,1:05:49.93,1:05:53.23,teks umum,,0,0,0,,Adakah itu yang anda katakan? Kenapa awak sayang saya sampai mati?
Dialog: 0,1:05:54.98,1:05:56.11,teks umum,,0,0,0,,Nah...
Dialog: 0,1:05:56.82,1:06:00.03,teks umum,,0,0,0,,Saya berlebihan supaya dia percaya
Dialog: 0,1:06:03.28,1:06:04.82,teks umum,,0,0,0,,Tiada pilihan lain
Dialog: 0,1:06:06.20,1:06:09.70,teks umum,,0,0,0,,Tiada pilihan selain mengaku yang awak cintakan saya sampai mati
Dialog: 0,1:06:10.91,1:06:12.62,teks umum,,0,0,0,,Saya minta maaf walaupun
Dialog: 0,1:06:13.33,1:06:15.71,teks umum,,0,0,0,,Saya tidak meletakkan terlalu banyak perasaan dalam pengakuan saya
Dialog: 0,1:06:16.25,1:06:17.54,teks umum,,0,0,0,,Kami terpaksa mencuba
Dialog: 0,1:06:17.63,1:06:18.80,teks umum,,0,0,0,,Lupakan
Dialog: 0,1:06:20.59,1:06:24.59,teks umum,,0,0,0,,Jangan letakkan segala-galanya untuk sesuatu yang berubah-ubah seperti cinta
Dialog: 0,1:06:25.93,1:06:27.85,teks umum,,0,0,0,,Jika ini berlaku lagi,
Dialog: 0,1:06:28.60,1:06:30.89,teks umum,,0,0,0,,dan kehidupan akan bergantung pada pilihan,
Dialog: 0,1:06:31.98,1:06:33.23,teks umum,,0,0,0,,mengkhianati cinta
Dialog: 0,1:06:34.52,1:06:35.73,teks umum,,0,0,0,,dan pilih kehidupan
Dialog: 0,1:06:38.11,1:06:39.73,contact,,0,0,0,,Melainkan, sudah tentu, anda mahu mati
Dialog: 0,1:06:40.65,1:06:42.19,teks umum,,0,0,0,,Ini pesanan cikgu
Dialog: 0,1:06:47.24,1:06:48.37,teks umum,,0,0,0,,Guru,
Dialog: 0,1:06:49.08,1:06:50.62,teks umum,,0,0,0,,bagaimana jika saya tidak kisah mati?
Dialog: 0,1:06:51.41,1:06:53.83,teks umum,,0,0,0,,Bolehkah saya terus mencintai awak?
Dialog: 0,1:06:56.29,1:06:58.42,teks umum,,0,0,0,,Dalam erti kata lain, saya bersedia untuk mempertaruhkan segala-galanya,
Dialog: 0,1:06:59.38,1:07:01.17,teks umum,,0,0,0,,supaya kita boleh bersama
Dialog: 0,1:07:02.55,1:07:04.17,teks umum,,0,0,0,,Saya akan buat
Dialog: 0,1:07:04.72,1:07:09.18,teks umum,,0,0,0,,Lakukan perkara yang sama, berpegang pada pengakuan anda
Dialog: 0,1:07:10.72,1:07:12.31,teks umum,,0,0,0,,Cintai saya sampai mati
Dialog: 0,1:07:51.81,1:07:55.73,pratonton,,0,0,0,,Jika Uk mencintai seseorang dia tidak sepatutnya,
Dialog: 0,1:07:55.81,1:07:57.23,pratonton,,0,0,0,,apa yang anda akan lakukan?
Dialog: 0,1:07:57.31,1:08:01.27,pratonton,,0,0,0,,Jika saya bersama awak, saya perlu pastikan awak milik saya
Dialog: 0,1:08:01.36,1:08:03.23,pratonton,,0,0,0,,Beraninya awak memalukan Jinyeowon?
Dialog: 0,1:08:03.98,1:08:05.03,pratonton,,0,0,0,,- Salty\N- Dua but - sepasang
Dialog: 0,1:08:05.11,1:08:06.40,pratonton,,0,0,0,,Kenapa awak tak kahwin?
Dialog: 0,1:08:06.49,1:08:08.24,pratonton,,0,0,0,,saya sedang mencari bomoh Choi
Dialog: 0,1:08:08.32,1:08:11.16,pratonton,,0,0,0,,Jika bomoh itu diburu oleh ahli silap mata Jeonbugwan...
Dialog: 0,1:08:11.24,1:08:14.08,pratonton,,0,0,0,,Adakah kamu mencarinya kerana dia menyimpan dendam terhadap ayah kamu?
Dialog: 0,1:08:14.16,1:08:16.87,pratonton,,0,0,0,,Jika dia datang, laporkan segera
Dialog: 0,1:08:16.96,1:08:18.54,pratonton,,0,0,0,,Walaupun mati, ini Gwigu
Dialog: 0,1:08:18.62,1:08:20.50,pratonton,,0,0,0,,pura-pura tak tahu, kan?
Dialog: 0,1:08:21.17,1:08:23.75,pratonton,,0,0,0,,Sukar untuk anda, bukan?
Dialog: 0,1:08:23.84,1:08:26.17,pratonton,,0,0,0,,Jika anda perlu menghunus pedang dan menghalakannya kepada seseorang,
Dialog: 0,1:08:26.26,1:08:28.55,pratonton,,0,0,0,,biar saya yang pertama
Dialog: 0,0:02:55.14,0:02:57.14,nick,,0,0,0,,

