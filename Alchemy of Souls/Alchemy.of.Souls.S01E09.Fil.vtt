Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:00:59.26,0:01:01.42,general text,,0,0,0,,Ito ang mga damit ng mga salamangkero ng Jeonjingak
Dialogue: 0,0:01:01.92,0:01:04.51,pangkalahatang teksto,,0,0,0,,Tataasin mo ang iyong dignidad bilang isang salamangkero ng Jeonjingak
Dialogue: 0,0:01:05.47,0:01:07.72,italics,,0,0,0,,Maging matagumpay sa pag-aaral ng spells
Dialogue: 0,0:01:14.52,0:01:17.23,pangkalahatang teksto,,0,0,0,,Ito ang anting-anting ng mga mago ng Jeonjingak
Dialogue: 0,0:01:18.11,0:01:19.78,pangkalahatang teksto,,0,0,0,,Ibinigay niya ang karapatan
Dialogue: 0,0:01:19.86,0:01:23.32,pangkalahatang teksto,,0,0,0,,step everywhere sa Pine Forest at Jeonjingak
Dialogue: 0,0:01:29.37,0:01:31.08,italics,,0,0,0,,Ito ay isang set ng mga panuntunan
Dialogue: 0,0:01:31.58,0:01:33.00,general text,,0,0,0,,Susundan mo ito
Dialogue: 0,0:01:33.58,0:01:37.50,pangkalahatang teksto,,0,0,0,,At kung lalabag ka sa mga patakaran, paparusahan ka ng naaayon
Dialogue: 0,0:01:39.46,0:01:42.13,pangkalahatang teksto,,0,0,0,,Chan Wook, tumayo at yumuko sa ulo
Dialogue: 0,0:02:05.61,0:02:06.70,general text,,0,0,0,,Chan Wook, tumalikod
Dialogue: 0,0:02:06.78,0:02:09.62,pangkalahatang teksto,,0,0,0,,at yumuko sa iba pang mga salamangkero
Dialogue: 0,0:02:31.22,0:02:35.02,general text,,0,0,0,,Mula ngayon, si Chan Wook, ang panganay na anak ng pamilya Chan,
Dialogue: 0,0:02:35.73,0:02:38.31,pangkalahatang teksto,,0,0,0,,mago ng Jeonjingak
Dialogue: 0,0:03:08.09,0:03:09.80,pangkalahatang text,,0,0,0,,Hey, Chan Wook
Dialogue: 0,0:03:09.89,0:03:11.76,general text,,0,0,0,,- Congratulations\N- Congratulations!
Dialogue: 0,0:03:11.85,0:03:14.77,general text,,0,0,0,,- Malayo na ang narating mo\N- So, so, so, guys
Dialogue: 0,0:03:16.60,0:03:21.77,pangkalahatang teksto,,0,0,0,,Ngayon ay mag-oorganisa kami ng holiday bilang parangal sa aming bagong magician - Chan Wook
Dialogue: 0,0:03:21.86,0:03:24.48,pangkalahatang teksto,,0,0,0,,Hinihintay namin ang lahat sa Chwisongru
Dialogue: 0,0:03:25.65,0:03:27.28,general text,,0,0,0,,Nagbayad na ang pamilya Chan
Dialogue: 0,0:03:27.36,0:03:30.82,pangkalahatang teksto,,0,0,0,,pagkain at inumin sa Chwiseonru
Dialogue: 0,0:03:30.91,0:03:32.53,pangkalahatang teksto,,0,0,0,,Samakatuwid
Dialogue: 0,0:03:33.91,0:03:35.95,pangkalahatang teksto,,0,0,0,,dapat uminom ang lahat hanggang sa mahulog sila
Dialogue: 0,0:03:42.88,0:03:44.09,pangkalahatang teksto,,0,0,0,,Chwisonru!
Dialogue: 0,0:03:44.17,0:03:46.84,pangkalahatang teksto,,0,0,0,,- Chwisungru!\N- Chan Wook!
Dialogue: 0,0:03:46.92,0:03:51.51,general text,,0,0,0,,Naalala ko kung paano pumunta si Chang Gan dito kasama ang maliit na si Chan Wook. Parang kahapon lang
Dialogue: 0,0:03:51.59,0:03:53.22,general text,,0,0,0,,Hindi ako makapaniwala na dumating na ang araw na ito
Dialogue: 0,0:03:55.10,0:03:57.64,general text,,0,0,0,,Hindi ako makapaniwala sa sarili ko
Dialogue: 0,0:04:00.10,0:04:01.15,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:04:02.15,0:04:02.98,pangkalahatang teksto,,0,0,0,,Kumain
Dialogue: 0,0:04:05.57,0:04:06.57,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:04:06.65,0:04:08.28,pangkalahatang teksto,,0,0,0,,Govenium Pill
Dialogue: 0,0:04:08.36,0:04:10.28,pangkalahatang text,,0,0,0,,Kumain bago ka uminom
Dialogue: 0,0:04:10.36,0:04:12.61,pangkalahatang teksto,,0,0,0,,Iinom ang mga bata hanggang sa huling sandali
Dialogue: 0,0:04:12.70,0:04:14.91,pangkalahatang teksto,,0,0,0,,Kailangan nating subukang makipagsabayan sa kanila
Dialogue: 0,0:04:16.16,0:04:18.50,general text,,0,0,0,,Hindi ako maglalasing kung wala ito
Dialogue: 0,0:04:18.58,0:04:20.71,pangkalahatang teksto,,0,0,0,,Dapat kong isipin ang aking edad
Dialogue: 0,0:04:22.08,0:04:23.50,pangkalahatang text,,0,0,0,,Paano ang edad ko?
Dialogue: 0,0:04:23.58,0:04:25.88,pangkalahatang teksto,,0,0,0,,Kaya may mga kulay abong kandado
Dialogue: 0,0:04:27.38,0:04:29.05,general text,,0,0,0,,Mukhang dahil sa sikat ng araw
Dialogue: 0,0:04:29.13,0:04:30.34,general text,,0,0,0,,Tingnan mo siya
Dialogue: 0,0:04:30.42,0:04:33.64,pangkalahatang text,,0,0,0,,Tingnan mo kung gaano malasutla ang buhok ko
Dialogue: 0,0:04:34.97,0:04:36.47,pangkalahatang teksto,,0,0,0,,Napakaganda
Dialogue: 0,0:04:41.77,0:04:43.44,pangkalahatang teksto,,0,0,0,,Itatago ko ito sa aking sarili
Dialogue: 0,0:04:43.52,0:04:44.86,pangkalahatang teksto,,0,0,0,,Oo, kunin mo
Dialogue: 0,0:05:04.17,0:05:05.25,pangkalahatang teksto,,0,0,0,,Miss Do Hwa,
Dialogue: 0,0:05:06.38,0:05:07.75,pangkalahatang teksto,,0,0,0,,young master
Dialogue: 0,0:05:08.71,0:05:13.43,pangkalahatang teksto,,0,0,0,,naging magician ni Jeongjingak, tulad ng kanyang ama
Dialogue: 0,0:05:15.84,0:05:17.43,italics,,0,0,0,,Masaya ka ba?
Dialogue: 0,0:05:37.41,0:05:38.99,behind the scenes,,0,0,0,,You did a great job
Dialogue: 0,0:05:40.20,0:05:41.58,behind the scenes,,0,0,0,,mula nang magkakilala tayo
Dialogue: 0,0:05:48.71,0:05:50.21,memories italics,,0,0,0,,Naintindihan ko sa unang tingin
Dialogue: 0,0:05:52.09,0:05:53.51,mga alaala,,0,0,0,,Ikaw ang aking panginoon,
Dialogue: 0,0:05:54.17,0:05:55.38,mga alaala,,0,0,0,,Nak Su
Dialogue: 0,0:05:55.47,0:05:56.97,mga alaala,,0,0,0,,gusto kitang maging guro
Dialogue: 0,0:05:57.05,0:05:58.93,mga alaala,,0,0,0,,Anong kalokohan?
Dialogue: 0,0:05:59.01,0:06:00.76,mga alaala,,0,0,0,,Kung mabubuhay ka,
Dialogue: 0,0:06:00.85,0:06:02.68,mga alaala,,0,0,0,,Ako ang magiging master mo
Dialogue: 0,0:06:03.81,0:06:04.89,mga alaala,,0,0,0,,Guro
Dialogue: 0,0:06:04.98,0:06:06.27,mga alaala,,0,0,0,,Sa wakas nakuha ko na
Dialogue: 0,0:06:42.18,0:06:43.39,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:06:43.97,0:06:46.31,general text,,0,0,0,,So paano? Nababagay ba ito sa akin?
Dialogue: 0,0:06:46.89,0:06:50.27,pangkalahatang teksto,,0,0,0,,Paano sasabihin... Paano ko malalaman?
Dialogue: 0,0:06:51.94,0:06:54.82,pangkalahatang teksto,,0,0,0,,Guro, ano ang hitsura ng iyong estudyante?
Dialogue: 0,0:06:56.78,0:07:00.16,pangkalahatang text,,0,0,0,,Bagay ang damit na ito kina So Yulyu at Park Dan Gu,
Dialogue: 0,0:07:02.83,0:07:05.04,pangkalahatang text,,0,0,0,,pero sa estudyante ko mukhang perpekto lang
Dialogue: 0,0:07:12.13,0:07:13.25,pangkalahatang teksto,,0,0,0,,Sapat na
Dialogue: 0,0:07:14.42,0:07:15.71,pangkalahatang text,,0,0,0,,Hindi ako makahinga
Dialogue: 0,0:07:16.72,0:07:17.76,pangkalahatang teksto,,0,0,0,,Guro,
Dialogue: 0,0:07:18.93,0:07:19.93,pangkalahatang teksto,,0,0,0,,salamat
Dialogue: 0,0:07:25.06,0:07:27.98,pangkalahatang text,,0,0,0,,Okay, Moo Dok. Tara inom tayo
Dialogue: 0,0:07:32.02,0:07:34.23,general text,,0,0,0,,Chan Wook, wait
Dialogue: 0,0:07:34.86,0:07:37.78,general text,,0,0,0,,- Chan Wook...\N- Mister, ang ganda mo
Dialogue: 0,0:07:38.82,0:07:39.66,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:07:41.57,0:07:43.03,pangkalahatang teksto,,0,0,0,,Tanggapin ito
Dialogue: 0,0:07:44.08,0:07:46.04,general text,,0,0,0,,Binigyan ka ni Master Huo ng govenia pill
Dialogue: 0,0:07:48.12,0:07:49.41,pangkalahatang teksto,,0,0,0,,Ah, govania?
Dialogue: 0,0:07:49.50,0:07:51.33,pangkalahatang teksto,,0,0,0,,Kailangang hatiin
Dialogue: 0,0:07:53.71,0:07:55.92,pangkalahatang teksto,,0,0,0,,Ito ay perpekto para sa mga hangover
Dialogue: 0,0:08:06.93,0:08:08.35,general text,,0,0,0,,Here, maid Kim
Dialogue: 0,0:08:09.73,0:08:10.89,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,0:08:10.98,0:08:13.52,general text,,0,0,0,,Ibibigay ko sana sa iyo. totoo
Dialogue: 0,0:08:13.61,0:08:16.94,general text,,0,0,0,,Maiden Kim, bumalik ka. Kunin mo. Well talaga
Dialogue: 0,0:08:17.03,0:08:18.94,pangkalahatang text,,0,0,0,,Maiden Kim, please
Dialogue: 0,0:08:25.91,0:08:30.00,pangkalahatang teksto,,0,0,0,,Ipinanganak sa ilalim ng bituin ng hari pumasok sa Sosnovy Bor
Dialogue: 0,0:08:30.58,0:08:33.79,pangkalahatang teksto,,0,0,0,,Gumamit ng batong yelo ang kanyang ama para mag-spells
Dialogue: 0,0:08:34.75,0:08:37.09,pangkalahatang teksto,,0,0,0,,Ang kapanganakan ni Chan Wook ay ang resulta ng pangkukulam na ito
Dialogue: 0,0:08:37.17,0:08:39.88,pangkalahatang teksto,,0,0,0,,Ang batang ito ay isang kalamidad para kay Sosnovy Bor
Dialogue: 0,0:08:39.97,0:08:42.26,general text,,0,0,0,,Bakit sa tingin mo ginawa ito ni Chang Gang?
Dialogue: 0,0:08:42.76,0:08:45.35,pangkalahatang teksto,,0,0,0,,Maaari niyang gawing hari ang kanyang anak,
Dialogue: 0,0:08:45.43,0:08:49.98,pangkalahatang teksto,,0,0,0,,gamitin ang bato upang angkinin si Hwansu. Ipapasuko niya ang mundo sa kanyang sarili
Dialogue: 0,0:08:50.06,0:08:52.56,general text,,0,0,0,,Bakit niya tinatakan ang gate ng kanyang anak
Dialogue: 0,0:08:52.64,0:08:54.90,general text,,0,0,0,,at itinago ang ice stone?
Dialogue: 0,0:08:56.06,0:08:57.90,general text,,0,0,0,,Dahil mahina ako
Dialogue: 0,0:08:59.48,0:09:00.74,italics,,0,0,0,,Siya ay tinatakan ang lahat at nakatakas,
Dialogue: 0,0:09:00.82,0:09:03.16,italics,,0,0,0,,dahil hindi niya kinaya
Dialogue: 0,0:09:07.49,0:09:08.99,pangkalahatang teksto,,0,0,0,,Sa tingin mo, Kil Ju
Dialogue: 0,0:09:09.95,0:09:11.71,general text,,0,0,0,,pinatay si Chang Gang?
Dialogue: 0,0:09:12.25,0:09:13.58,general text,,0,0,0,,Kung bumalik siya...
Dialogue: 0,0:09:13.67,0:09:17.42,pangkalahatang teksto,,0,0,0,,Hindi hayagang gagawa ng ganoon si Chang Gan
Dialogue: 0,0:09:19.05,0:09:21.17,pangkalahatang text,,0,0,0,,Sinala ko si Master Li
Dialogue: 0,0:09:21.84,0:09:25.05,pangkalahatang teksto,,0,0,0,,Kailangan nating magkaroon ng higit na lakas bago magsimulang umakyat ang Pine Forest
Dialogue: 0,0:09:27.97,0:09:29.89,pangkalahatang teksto,,0,0,0,,Sampung taon na ang nakalipas, matagumpay tayong
Dialogue: 0,0:09:29.97,0:09:33.31,pangkalahatang teksto,,0,0,0,,nakuha ang isang bato na tinatakan ni Chang Gan
Dialogue: 0,0:09:47.07,0:09:48.99,mga alaala,,0,0,0,,Nahanap mo siya
Dialogue: 0,0:09:50.04,0:09:51.33,mga alaala,,0,0,0,,Bu Young,
Dialogue: 0,0:09:51.41,0:09:53.12,mga alaala,,0,0,0,,bigyan mo ako ng yelong bato
Dialogue: 0,0:10:04.38,0:10:07.01,italics,,0,0,0,,Siya ay napakabata, ngunit nagawa niyang mahanap ang bato
Dialogue: 0,0:10:07.59,0:10:10.47,italics,,0,0,0,,Dapat nating aminin na ang kanyang kapangyarihan ay talagang kamangha-mangha
Dialogue: 0,0:10:13.48,0:10:16.60,general text,,0,0,0,,Nabalitaan kong hindi naniniwala si Jin Ho Kyung sa pagkamatay ng kanyang anak.
Dialogue: 0,0:10:16.69,0:10:18.36,general text,,0,0,0,,at hinahanap pa rin siya
Dialogue: 0,0:10:19.02,0:10:20.61,general text,,0,0,0,,Kaya gusto ko siyang hanapin
Dialogue: 0,0:10:22.57,0:10:24.90,general text,,0,0,0,,Hahanapin ko ang babaeng matagal na niyang hinahanap.
Dialogue: 0,0:10:24.99,0:10:28.49,general text,,0,0,0,,at gagawin kong puppet si Jin Ho Kyung
Dialogue: 0,0:10:28.57,0:10:30.78,general text,,0,0,0,,Paano ka makakahanap ng patay na babae?
Dialogue: 0,0:10:32.08,0:10:33.95,pangkalahatang text,,0,0,0,,I'll find someone
Dialogue: 0,0:10:34.45,0:10:37.75,general text,,0,0,0,,Ang nagpapaniwala kay Ho Kyung na si Boo Young iyon
Dialogue: 0,0:10:56.23,0:10:57.52,pangkalahatang teksto,,0,0,0,,Narito. Kumain
Dialogue: 0,0:11:03.11,0:11:06.11,general text,,0,0,0,,Kumain ka na ba mula nang umalis ka sa Sari Village?
Dialogue: 0,0:11:14.91,0:11:15.95,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:11:17.79,0:11:19.33,pangkalahatang teksto,,0,0,0,,Kumain
Dialogue: 0,0:11:28.30,0:11:29.55,pangkalahatang teksto,,0,0,0,,Maghintay ka
Dialogue: 0,0:11:30.18,0:11:32.93,general text,,0,0,0,,Bakit naglalayag mag-isa ang bulag na babaeng ito papuntang lungsod?
Dialogue: 0,0:11:33.01,0:11:34.76,general text,,0,0,0,,Naghahanap siya ng kaibigan
Dialogue: 0,0:11:35.43,0:11:38.73,general text,,0,0,0,,Ninakaw ng kaibigan niya ang lahat ng gamit niya
Dialogue: 0,0:11:38.81,0:11:40.81,pangkalahatang teksto,,0,0,0,,at tumakas sa lungsod
Dialogue: 0,0:11:40.90,0:11:42.90,pangkalahatang text,,0,0,0,,Poor girl
Dialogue: 0,0:11:43.48,0:11:46.61,general text,,0,0,0,,Alam mo ba kung saan pupunta? Ano ang pangalan ng iyong kaibigan?
Dialogue: 0,0:11:48.61,0:11:49.82,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:11:50.45,0:11:54.08,pangkalahatang teksto,,0,0,0,,Ang pangalan ng kaibigan ko ay Moo Deok
Dialogue: 0,0:11:55.08,0:11:57.79,general text,,0,0,0,,- “Moo Dok”?\N- Paano niya siya mahahanap?
Dialogue: 0,0:12:00.29,0:12:01.75,italics,,0,0,0,,Sweet toffees!
Dialogue: 0,0:12:01.83,0:12:04.29,italics,,0,0,0,,- Sweet toffees!\N- Subukan ang aming cookies!
Dialogue: 0,0:12:04.38,0:12:06.42,pangkalahatang teksto,,0,0,0,,Halika! Bumili!
Dialogue: 0,0:12:06.50,0:12:08.34,italics,,0,0,0,,Sweet pie!
Dialogue: 0,0:12:08.42,0:12:11.68,general text,,0,0,0,,Ang ganda ng panahon noh?
Dialogue: 0,0:12:11.76,0:12:13.89,pangkalahatang text,,0,0,0,,Nay, bumili ng pie
Dialogue: 0,0:12:13.97,0:12:15.68,general text,,0,0,0,,Wala akong pera
Dialogue: 0,0:12:15.76,0:12:16.97,general text,,0,0,0,,Nay, bilhin mo na!
Dialogue: 0,0:12:17.06,0:12:18.35,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:12:18.43,0:12:20.14,general text,,0,0,0,,Okay, wait
Dialogue: 0,0:12:22.23,0:12:24.15,general text,,0,0,0,,Oh, nasaan na sila?
Dialogue: 0,0:12:24.23,0:12:26.61,general text,,0,0,0,,- Nasaan ang pera ko?\N- Ano ito?
Dialogue: 0,0:12:26.69,0:12:29.15,pangkalahatang text,,0,0,0,,Wala na ang pera
Dialogue: 0,0:12:29.82,0:12:32.11,general text,,0,0,0,,- Anong gagawin?\N- Ang singsing ko...
Dialogue: 0,0:12:33.11,0:12:35.20,general text,,0,0,0,,- Nawala ko ang singsing!\N- Heaven...
Dialogue: 0,0:13:05.56,0:13:06.90,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:13:08.40,0:13:10.74,general text,,0,0,0,,Iyon lang ba?
Dialogue: 0,0:13:13.91,0:13:15.74,general text,,0,0,0,,Mura din ang singsing
Dialogue: 0,0:13:17.66,0:13:21.50,pangkalahatang teksto,,0,0,0,,Ipinako ko ang aking sarili doon at lahat nang walang kabuluhan
Dialogue: 0,0:14:26.48,0:14:28.31,general text,,0,0,0,,- Salamat\N- Ibuhos mo sa akin
Dialogue: 0,0:14:31.44,0:14:33.28,general text,,0,0,0,,- Enjoy\N- Salamat
Dialogue: 0,0:15:11.69,0:15:14.61,behind the scenes,,0,0,0,,Alam mo kung sino ako all this time
Dialogue: 0,0:15:16.36,0:15:18.66,memories italics,,0,0,0,,Imbes na kaibigang malapit, mayroon kang sipol
Dialogue: 0,0:15:20.03,0:15:21.91,memories italics,,0,0,0,,Kaya iniwan ka ng kaibigan mo
Dialogue: 0,0:15:39.63,0:15:40.93,pangkalahatang teksto,,0,0,0,,Mr. Yul?
Dialogue: 0,0:15:44.18,0:15:45.35,pangkalahatang teksto,,0,0,0,,Ah, Moo Deok
Dialogue: 0,0:15:46.14,0:15:48.35,general text,,0,0,0,,Bakit ka nakaupo sa kalye?
Dialogue: 0,0:15:48.44,0:15:50.15,general text,,0,0,0,,Hindi ka ba iinom?
Dialogue: 0,0:15:52.02,0:15:54.69,pangkalahatang teksto,,0,0,0,,Hindi. Sapat na ako
Dialogue: 0,0:15:56.11,0:15:57.19,general text,,0,0,0,,lasing na ako
Dialogue: 0,0:15:58.28,0:16:00.24,general text,,0,0,0,,At maganda ka
Dialogue: 0,0:16:01.49,0:16:02.78,general text,,0,0,0,,lasing ako,
Dialogue: 0,0:16:03.74,0:16:05.41,general text,,0,0,0,,kaya naligaw ako
Dialogue: 0,0:16:08.87,0:16:11.42,general text,,0,0,0,,Mabilis akong mawala kung malabo ang ulo ko
Dialogue: 0,0:16:13.63,0:16:17.01,general text,,0,0,0,,Paano ka maliligaw dito?
Dialogue: 0,0:16:20.43,0:16:23.09,general text,,0,0,0,,Bumangon ka na, iuuwi na kita
Dialogue: 0,0:16:25.51,0:16:26.76,general text,,0,0,0,,Nasaktan ka
Dialogue: 0,0:16:27.72,0:16:29.35,pangkalahatang teksto,,0,0,0,,Mapanganib ito
Dialogue: 0,0:16:29.43,0:16:32.77,general text,,0,0,0,,Pinagalitan mo na naman ba ako? Baka hindi ngayon?
Dialogue: 0,0:16:34.77,0:16:36.44,general text,,0,0,0,,Hindi para sa akin ang pagalitan ka
Dialogue: 0,0:16:37.44,0:16:39.61,pangkalahatang teksto,,0,0,0,,ako mismo ang nagkamali
Dialogue: 0,0:16:40.95,0:16:42.16,general text,,0,0,0,,Ikaw ba?
Dialogue: 0,0:16:43.20,0:16:44.16,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:16:45.74,0:16:49.08,pangkalahatang teksto,,0,0,0,,Lagi kong ginagawa ang tama. Hindi naligaw ng landas
Dialogue: 0,0:16:52.79,0:16:55.96,pangkalahatang text,,0,0,0,,Pero nawawala ako
Dialogue: 0,0:17:00.42,0:17:01.97,general text,,0,0,0,,At ngayon hawak ko na ang kamay mo
Dialogue: 0,0:17:07.06,0:17:09.22,general text,,0,0,0,,Hindi ko alam kung saan ako dadalhin ng aking landas
Dialogue: 0,0:17:14.60,0:17:16.31,general text,,0,0,0,,Pamumunuan ka niya pagkatapos ko
Dialogue: 0,0:17:35.33,0:17:36.58,general text,,0,0,0,,Hinawakan mo ang kamay ko
Dialogue: 0,0:17:38.67,0:17:39.84,general text,,0,0,0,,Let's go
Dialogue: 0,0:17:42.92,0:17:46.22,general text,,0,0,0,,Naliligaw ka kapag malabo ang ulo mo
Dialogue: 0,0:17:46.30,0:17:48.43,pangkalahatang teksto,,0,0,0,,Lahat dahil marami kang iniisip
Dialogue: 0,0:17:49.47,0:17:51.89,pangkalahatang teksto,,0,0,0,,Kapag nangyari ito, isipin ang isang bagay
Dialogue: 0,0:17:51.98,0:17:55.56,pangkalahatang teksto,,0,0,0,,Halimbawa, isipin mo ako ngayon
Dialogue: 0,0:18:04.90,0:18:08.03,pangkalahatang text,,0,0,0,,Okay. Ngayon iisipin kita
Dialogue: 0,0:18:15.54,0:18:19.63,pangkalahatang teksto,,0,0,0,,Mr. Kaya, maaari ba akong magtanong sa iyo?
Dialogue: 0,0:18:20.17,0:18:21.13,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:18:21.88,0:18:24.97,general text,,0,0,0,,Sabi mo napanaginipan mo ako
Dialogue: 0,0:18:25.05,0:18:26.38,pangkalahatang teksto,,0,0,0,,Ano ang sinabi sa iyo ng aking paningin?
Dialogue: 0,0:18:27.89,0:18:29.22,general text,,0,0,0,,Na gusto mo ako
Dialogue: 0,0:18:29.80,0:18:32.14,general text,,0,0,0,,- Ano?\N- Ano yun?
Dialogue: 0,0:18:32.22,0:18:33.89,pangkalahatang teksto,,0,0,0,,Ikaw mismo ay paulit-ulit na madalas
Dialogue: 0,0:18:34.73,0:18:36.14,general text,,0,0,0,,Well, kasi...
Dialogue: 0,0:18:40.06,0:18:42.40,pangkalahatang teksto,,0,0,0,,Kasinungalingan ba ang lahat?
Dialogue: 0,0:18:44.36,0:18:46.40,general text,,0,0,0,,Gusto kita, pero...
Dialogue: 0,0:18:47.28,0:18:49.74,pangkalahatang teksto,,0,0,0,,Oo, gusto kita
Dialogue: 0,0:19:18.48,0:19:20.10,pangkalahatang teksto,,0,0,0,,Ang aking pasasalamat
Dialogue: 0,0:19:33.99,0:19:35.50,general text,,0,0,0,,Naniwala ba talaga siya?
Dialogue: 0,0:19:37.50,0:19:39.17,general text,,0,0,0,,Sana hindi
Dialogue: 0,0:19:45.42,0:19:47.05,pangkalahatang teksto,,0,0,0,,Sapat na
Dialogue: 0,0:19:47.13,0:19:49.68,pangkalahatang teksto,,0,0,0,,Salamat sa iyo, master
Dialogue: 0,0:19:50.39,0:19:52.39,general text,,0,0,0,,Sigurado akong matutuwa si Mrs. Do Hwa
Dialogue: 0,0:19:52.89,0:19:54.22,pangkalahatang teksto,,0,0,0,,Sa wakas ako...
Dialogue: 0,0:19:54.31,0:19:58.27,pangkalahatang text,,0,0,0,,parang may nagawa akong mabuti para kay Do Hwa bilang paghingi ng tawad
Dialogue: 0,0:19:58.98,0:20:01.56,general text,,0,0,0,,Wala kang ginawang mali
Dialogue: 0,0:20:01.65,0:20:04.94,general text,,0,0,0,,Ako ang nagdala sa kanya sa Sejukwon mula sa aking bayan
Dialogue: 0,0:20:05.02,0:20:08.03,general text,,0,0,0,,Ganito niya nakilala si Chang Gang
Dialogue: 0,0:20:08.90,0:20:11.11,general text,,0,0,0,,Napakabait ni Do Hwa
Dialogue: 0,0:20:11.20,0:20:15.33,general text,,0,0,0,,Hindi ako makapaniwala na naniwala siya sa lahat ng tsismis na ito
Dialogue: 0,0:20:15.41,0:20:18.12,pangkalahatang teksto,,0,0,0,,Chan Gan, ganyang kalokohan
Dialogue: 0,0:20:19.00,0:20:21.71,general text,,0,0,0,,Guro, lasing ka
Dialogue: 0,0:20:21.79,0:20:23.21,general text,,0,0,0,,Ikaw ang may kasalanan!
Dialogue: 0,0:20:24.96,0:20:26.92,general text,,0,0,0,,Ano ang ginawa ko?
Dialogue: 0,0:20:27.00,0:20:31.34,general text,,0,0,0,,Dinala ko si Do Hwa sa Saejukwon para i-set up ka sa kanya
Dialogue: 0,0:20:31.43,0:20:32.34,pangkalahatang teksto,,0,0,0,,Ano kaya?
Dialogue: 0,0:20:32.43,0:20:34.43,pangkalahatang teksto,,0,0,0,,Banal na langit
Dialogue: 0,0:20:35.05,0:20:37.22,pangkalahatang teksto,,0,0,0,,Na may ganitong hitsura at kasanayan
Dialogue: 0,0:20:37.31,0:20:40.18,pangkalahatang text,,0,0,0,,hindi makuha ang puso ng babae?
Dialogue: 0,0:20:40.27,0:20:43.27,general text,,0,0,0,,Nakakainis ka!
Dialogue: 0,0:20:45.48,0:20:46.65,pangkalahatang teksto,,0,0,0,,Well, yes
Dialogue: 0,0:20:46.73,0:20:49.32,pangkalahatang text,,0,0,0,,Sobrang natulungan ka ni Master Huo,
Dialogue: 0,0:20:49.40,0:20:51.20,pangkalahatang teksto,,0,0,0,,at hindi mo sinamantala ang isang pagkakataon
Dialogue: 0,0:20:52.70,0:20:53.87,pangkalahatang teksto,,0,0,0,,Ginawa ko
Dialogue: 0,0:20:55.28,0:20:56.41,pangkalahatang teksto,,0,0,0,,lahat ng kaya ko
Dialogue: 0,0:20:57.79,0:20:59.00,pangkalahatang teksto,,0,0,0,,Nagsulat ako ng tula
Dialogue: 0,0:21:01.21,0:21:02.33,pangkalahatang teksto,,0,0,0,,Mga regalo
Dialogue: 0,0:21:03.62,0:21:05.63,general text,,0,0,0,,Pero hindi ka nagtapat sa kanya
Dialogue: 0,0:21:07.00,0:21:08.21,italics,,0,0,0,,"Mahal kita"
Dialogue: 0,0:21:08.30,0:21:09.67,general text,,0,0,0,,"Will you be mine?"
Dialogue: 0,0:21:09.76,0:21:12.88,pangkalahatang text,,0,0,0,,Naglakad-lakad kami sa paligid ng bush, ngunit walang sinabi
Dialogue: 0,0:21:12.97,0:21:16.01,general text,,0,0,0,,Siyempre talo ka sa direktang nagsabi ng lahat.
Dialogue: 0,0:21:16.10,0:21:18.35,pangkalahatang teksto,,0,0,0,,Kailangan bang hayagang pag-usapan ang tungkol sa nararamdaman?
Dialogue: 0,0:21:20.35,0:21:23.39,pangkalahatang teksto,,0,0,0,,Sapat na mga pahiwatig
Dialogue: 0,0:21:24.19,0:21:25.69,general text,,0,0,0,,Nakakainis ka
Dialogue: 0,0:21:26.31,0:21:28.98,pangkalahatang teksto,,0,0,0,,Nagpakita sila ng interes, ngunit nanatili sila sa kanilang distansya
Dialogue: 0,0:21:29.07,0:21:30.61,general text,,0,0,0,,Tapos lumapit ulit sila
Dialogue: 0,0:21:30.69,0:21:32.45,pangkalahatang teksto,,0,0,0,,Kailangan nating makipag-usap sa isang babae tungkol sa damdamin
Dialogue: 0,0:21:32.53,0:21:36.57,general text,,0,0,0,,Para makapagdesisyon siya kung hihintayin ka o hindi
Dialogue: 0,0:21:36.66,0:21:39.95,pangkalahatang teksto,,0,0,0,,Kung ang pag-ibig ay pabagu-bago lamang dahil hindi ito naipahayag nang malakas,
Dialogue: 0,0:21:41.08,0:21:42.21,general text,,0,0,0,,kung gayon hindi ko siya kailangan!
Dialogue: 0,0:21:44.00,0:21:47.17,general text,,0,0,0,,Kung ang isang babae ay nagpasya na iwan ako at sumama sa iba,
Dialogue: 0,0:21:47.67,0:21:49.13,pangkalahatang teksto,,0,0,0,,gayunpaman
Dialogue: 0,0:21:49.88,0:21:50.84,pangkalahatang teksto,,0,0,0,, "Kaya nga..."
Dialogue: 0,0:21:59.35,0:22:00.64,pangkalahatang teksto,,0,0,0,,Magpatuloy nang wala ako
Dialogue: 0,0:22:02.31,0:22:03.77,general text,,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:22:03.85,0:22:05.90,general text,,0,0,0,,Aalis na ako
Dialogue: 0,0:22:06.56,0:22:08.02,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,0:22:08.90,0:22:11.98,pangkalahatang teksto,,0,0,0,, Manatili. Uminom ka sa amin...
Dialogue: 0,0:22:12.07,0:22:13.53,pangkalahatang teksto,,0,0,0,, Manatili...
Dialogue: 0,0:22:14.40,0:22:17.28,italics,,0,0,0,,Maid Kim, bumalik ka, okay?
Dialogue: 0,0:22:17.37,0:22:19.28,general text,,0,0,0,,- Maghihintay ako\N- Tama...
Dialogue: 0,0:22:19.37,0:22:21.87,italics,,0,0,0,,- Maid Kim\N{\i0}- Balang araw magsisisi siya
Dialogue: 0,0:22:21.95,0:22:23.50,italics,,0,0,0,,Dalagang Kim!
Dialogue: 0,0:22:34.38,0:22:37.13,general text,,0,0,0,,Kaya dito umiinom ang mga tao
Dialogue: 0,0:22:37.22,0:22:39.76,general text,,0,0,0,,Hinihintay ka ng lahat. Pumasok ka
Dialogue: 0,0:22:39.85,0:22:42.06,pangkalahatang text,,0,0,0,,Hindi ako makainom
Dialogue: 0,0:22:42.14,0:22:45.73,general text,,0,0,0,,Ubusan na ako ng tsaa. Dapat tayong bumalik sa Danhyangok
Dialogue: 0,0:22:45.81,0:22:47.56,general text,,0,0,0,,Ikuha mo ako ng pagkain
Dialogue: 0,0:22:47.65,0:22:49.02,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:22:55.11,0:22:58.61,pangkalahatang teksto,,0,0,0,,Ang amoy ng pabango ng babae at ang amoy ng alak
Dialogue: 0,0:23:00.91,0:23:02.79,pangkalahatang teksto,,0,0,0,,Hindi ito ang lugar para sa akin
Dialogue: 0,0:23:08.50,0:23:09.79,pangkalahatang teksto,,0,0,0,,Loves
Dialogue: 0,0:23:11.96,0:23:13.59,pangkalahatang teksto,,0,0,0,,Mga Hindi Gusto
Dialogue: 0,0:23:15.09,0:23:16.38,pangkalahatang teksto,,0,0,0,,Loves
Dialogue: 0,0:23:17.72,0:23:20.55,pangkalahatang teksto,,0,0,0,,Mga Hindi gusto. Nagmamahal. ayoko...
Dialogue: 0,0:23:20.64,0:23:23.56,general text,,0,0,0,,Ano ba ang ginagawa ko?
Dialogue: 0,0:23:23.64,0:23:25.18,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:23:30.27,0:23:33.44,pangkalahatang teksto,,0,0,0,,Mga Mommies! Ano ang gagawin ngayon?
Dialogue: 0,0:23:33.52,0:23:34.78,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:24:38.59,0:24:40.01,general text,,0,0,0,,Mago ka diba?
Dialogue: 0,0:24:45.55,0:24:46.56,pangkalahatang teksto,,0,0,0,,Master Li?
Dialogue: 0,0:24:47.93,0:24:49.48,general text,,0,0,0,,Ikaw ba si Master Li?
Dialogue: 0,0:24:50.43,0:24:54.15,general text,,0,0,0,,Isa akong kasambahay ng pamilya Chan. Naglilingkod kay Mr. Chan
Dialogue: 0,0:24:55.44,0:24:56.82,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:24:57.40,0:24:58.53,pangkalahatang teksto,,0,0,0,,Hindi sulit
Dialogue: 0,0:25:16.92,0:25:19.05,general text,,0,0,0,,I think it catched on nung nahuli mo ako
Dialogue: 0,0:25:19.13,0:25:21.88,pangkalahatang teksto,,0,0,0,,Teka, hayaan mo ako
Dialogue: 0,0:25:22.55,0:25:24.93,pangkalahatang teksto,,0,0,0,,Paumanhin
Dialogue: 0,0:25:31.68,0:25:32.94,pangkalahatang teksto,,0,0,0,,Tapos na
Dialogue: 0,0:25:37.19,0:25:40.28,general text,,0,0,0,,hinihintay kita buong gabi,
Dialogue: 0,0:25:40.36,0:25:42.57,pangkalahatang teksto,,0,0,0,,para pasalamatan
Dialogue: 0,0:25:45.16,0:25:46.41,pangkalahatang teksto,,0,0,0,,Gaya nito
Dialogue: 0,0:25:49.41,0:25:50.79,general text,,0,0,0,,Saan siya nagpunta?
Dialogue: 0,0:25:51.83,0:25:52.91,pangkalahatang teksto,,0,0,0,,Master Li?
Dialogue: 0,0:26:08.80,0:26:11.43,general text,,0,0,0,,Dahil ba sa matagal na akong hindi umiinom ng tsaa?
Dialogue: 0,0:26:14.60,0:26:17.90,mga inskripsiyon,,0,0,0,,Saejukwon
Dialogue: 0,0:26:19.61,0:26:21.90,italics,,0,0,0,,Wala si Master Huo ngayon
Dialogue: 0,0:26:21.98,0:26:24.28,general text,,0,0,0,,Ngunit hinihintay niya ang iyong pagdating
Dialogue: 0,0:26:24.99,0:26:26.36,pangkalahatang teksto,,0,0,0,,Pumasok ka
Dialogue: 0,0:26:32.50,0:26:35.04,general text,,0,0,0,,Selebrasyon para sa bagong magician na si Jeonjingak?
Dialogue: 0,0:26:35.12,0:26:36.71,general text,,0,0,0,,Babalik lasing si Master Ho
Dialogue: 0,0:26:38.21,0:26:40.54,pangkalahatang teksto,,0,0,0,,Alam ng lahat kung gaano kahilig uminom si lolo
Dialogue: 0,0:26:41.17,0:26:45.09,general text,,0,0,0,,Madam, baka pumunta tayo sa Chwisongru?
Dialogue: 0,0:26:45.88,0:26:48.55,general text,,0,0,0,,Nandiyan ang magiging asawa mo
Dialogue: 0,0:26:49.26,0:26:52.26,general text,,0,0,0,,- Ano?\N- Sinabi sa akin ni Mrs. Ho ang lahat
Dialogue: 0,0:26:52.35,0:26:56.52,general text,,0,0,0,,Nabalitaan ko na ang lolo mo ay pumili ng ilang salamangkero para maging asawa mo
Dialogue: 0,0:26:56.60,0:26:59.56,pangkalahatang teksto,,0,0,0,,Kabilang sa kanila ay si Park Dan Gu mula sa Sosnovy Bor
Dialogue: 0,0:26:59.65,0:27:01.77,pangkalahatang teksto,,0,0,0,,at Seo Yul mula sa pamilyang Seo
Dialogue: 0,0:27:01.86,0:27:04.03,general text,,0,0,0,,Hindi ako nandito para sa kasal
Dialogue: 0,0:27:04.57,0:27:06.65,general text,,0,0,0,,Tutulong ako sa royal hospital
Dialogue: 0,0:27:06.74,0:27:09.91,general text,,0,0,0,,Sa tingin mo ba nasa listahan din ang Crown Prince?
Dialogue: 0,0:27:10.70,0:27:13.45,general text,,0,0,0,,- Ang ganda mo...\N- Song Yi!
Dialogue: 0,0:27:13.54,0:27:15.66,pangkalahatang teksto,,0,0,0,,Napahiya na ako ng iyong pangangatwiran minsan
Dialogue: 0,0:27:17.41,0:27:18.83,pangkalahatang teksto,,0,0,0,,Nakalimutan na ba ito?
Dialogue: 0,0:27:18.92,0:27:21.71,general text,,0,0,0,,Tungkol ba sa mayabang na salamangkero ang pinag-uusapan mo?
Dialogue: 0,0:27:22.38,0:27:25.46,general text,,0,0,0,,Kinailangan kong itanong ang pangalan para sabihin kay Master Ho
Dialogue: 0,0:27:27.51,0:27:28.80,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:27:29.68,0:27:31.76,general text,,0,0,0,,Dapat tinanong ko ang pangalan
Dialogue: 0,0:27:34.47,0:27:35.89,memories,,0,0,0,,Okay ka lang?
Dialogue: 0,0:27:39.19,0:27:41.06,general text,,0,0,0,,I wonder if I'll see...
Dialogue: 0,0:27:43.77,0:27:45.15,general text,,0,0,0,,siya na naman
Dialogue: 0,0:27:49.70,0:27:50.82,pangkalahatang teksto,,0,0,0,,Sapat na
Dialogue: 0,0:27:55.45,0:27:59.62,pangkalahatang teksto,,0,0,0,,Uk, may utang ka sa akin,
Dialogue: 0,0:27:59.71,0:28:01.46,pangkalahatang teksto,,0,0,0,,kaya pangako
Dialogue: 0,0:28:01.54,0:28:03.92,general text,,0,0,0,,- Pangako ano?\N- Isang araw,
Dialogue: 0,0:28:04.00,0:28:08.59,general text,,0,0,0,,kapag may hiniling akong gawin, gagawin mo
Dialogue: 0,0:28:09.72,0:28:10.97,general text,,0,0,0,,Okay, I promise
Dialogue: 0,0:28:11.72,0:28:13.47,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:28:13.55,0:28:16.81,general text,,0,0,0,,May kailangan muna akong linawin
Dialogue: 0,0:28:16.89,0:28:21.44,general text,,0,0,0,,I'm asking because you know Master Li
Dialogue: 0,0:28:21.52,0:28:25.44,general text,,0,0,0,,Ininom mo ba ang chastity tea niya?
Dialogue: 0,0:28:26.53,0:28:29.74,pangkalahatang teksto,,0,0,0,,Hindi. Hindi kailanman. Hindi kailanman uminom
Dialogue: 0,0:28:30.36,0:28:32.16,general text,,0,0,0,,So hindi ka nagmamasid sa celibacy?
Dialogue: 0,0:28:32.24,0:28:35.58,pangkalahatang teksto,,0,0,0,,Hindi, siyempre. Gusto kong magpakasal balang araw
Dialogue: 0,0:28:35.66,0:28:37.70,pangkalahatang teksto,,0,0,0,,Kahanga-hanga. Dito
Dialogue: 0,0:28:41.08,0:28:43.08,general text,,0,0,0,,Kandidato ka na rin
Dialogue: 0,0:28:43.17,0:28:45.67,general text,,0,0,0,,Kandidato kayong tatlo
Dialogue: 0,0:28:47.34,0:28:50.09,pangkalahatang teksto,,0,0,0,,Huwag kalimutang pasalamatan si Master Li
Dialogue: 0,0:28:50.17,0:28:53.68,general text,,0,0,0,,Kung hindi ka niya tiniyak, may mga problema sana
Dialogue: 0,0:28:53.76,0:28:55.01,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:28:55.10,0:28:58.56,pangkalahatang teksto,,0,0,0,,Nagduda ka na sa mga tao sa pamamagitan ng pagpapakita kay Tansu,
Dialogue: 0,0:28:58.64,0:29:00.81,pangkalahatang teksto,,0,0,0,,pag-aari ni Nak Su
Dialogue: 0,0:29:00.89,0:29:04.15,general text,,0,0,0,,Gusto pa ni Woook na maging estudyante ni Nak Soo
Dialogue: 0,0:29:06.98,0:29:09.19,general text,,0,0,0,,Ano ang pinag-uusapan mo?
Dialogue: 0,0:29:10.32,0:29:11.15,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:29:13.70,0:29:17.49,pangkalahatang teksto,,0,0,0,,Nabalisa siya na walang makapagbukas ng kanyang mga tarangkahan,
Dialogue: 0,0:29:18.12,0:29:19.79,general text,,0,0,0,,kaya nagbiro ako ng ganito
Dialogue: 0,0:29:20.58,0:29:22.33,pangkalahatang teksto,,0,0,0,,Totoo ka
Dialogue: 0,0:29:23.54,0:29:25.21,general text,,0,0,0,,so said?
Dialogue: 0,0:29:25.29,0:29:27.34,pangkalahatang teksto,,0,0,0,,Oo, totoo
Dialogue: 0,0:29:28.46,0:29:30.80,general text,,0,0,0,,Yul, sabihin mo sa kanila,
Dialogue: 0,0:29:30.88,0:29:34.47,pangkalahatang teksto,,0,0,0,,anong parusa ang dulot ng mga salamangkero na mahilig sa dark magic
Dialogue: 0,0:29:34.55,0:29:36.97,pangkalahatang teksto,,0,0,0,,Maaari mong mawala ang lahat ng iyong lakas,
Dialogue: 0,0:29:37.05,0:29:38.60,pangkalahatang teksto,,0,0,0,,hindi makapagbigay ng spells
Dialogue: 0,0:29:38.68,0:29:40.43,pangkalahatang teksto,,0,0,0,,Pagkatapos ay paalisin sila sa Dekho,
Dialogue: 0,0:29:41.56,0:29:43.81,pangkalahatang teksto,,0,0,0,,at ang mga inapo ay hindi kailanman magiging salamangkero
Dialogue: 0,0:29:43.89,0:29:45.10,pangkalahatang teksto,,0,0,0,,Tandaan ito
Dialogue: 0,0:29:48.02,0:29:51.57,pangkalahatang teksto,,0,0,0,,Huwag mo nang uulitin iyon
Dialogue: 0,0:29:52.49,0:29:54.61,pangkalahatang teksto,,0,0,0,,Ano ang masama sa dark magic?
Dialogue: 0,0:29:55.36,0:29:56.37,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:29:56.45,0:29:58.45,pangkalahatang teksto,,0,0,0,,Papatayin din ng mga ordinaryong spell ang mga tao
Dialogue: 0,0:29:58.53,0:30:00.95,pangkalahatang teksto,,0,0,0,,At ang dark magic, minsan, ay nakakapagligtas ng mga buhay
Dialogue: 0,0:30:01.83,0:30:03.83,pangkalahatang teksto,,0,0,0,,Paano paghiwalayin ang isa sa isa,
Dialogue: 0,0:30:03.91,0:30:07.79,pangkalahatang teksto,,0,0,0,,kailangan nating isipin ang mga intensyon ng tao, ito ay mas mahalaga
Dialogue: 0,0:30:07.88,0:30:11.17,pangkalahatang teksto,,0,0,0,,Kaya gagamitin mo itong magic,
Dialogue: 0,0:30:12.46,0:30:14.97,pangkalahatang teksto,,0,0,0,,kung ito ay nagliligtas sa buhay ng isang tao?
Dialogue: 0,0:30:15.05,0:30:17.01,pangkalahatang teksto,,0,0,0,,Kung ang magic na ito ay nagliligtas sa isang tao,
Dialogue: 0,0:30:18.68,0:30:21.22,pangkalahatang teksto,,0,0,0,,Wala akong nakikitang problema
Dialogue: 0,0:30:27.90,0:30:31.15,pangkalahatang teksto,,0,0,0,,Tuta! Ang lakas ng loob mo!
Dialogue: 0,0:30:31.23,0:30:32.94,pangkalahatang teksto,,0,0,0,,Ikaw ang salamangkero ng Jeonjingak
Dialogue: 0,0:30:33.03,0:30:36.16,general text,,0,0,0,,How dare you say na gagamitin mo ang magic na ito?
Dialogue: 0,0:30:36.24,0:30:38.49,pangkalahatang text,,0,0,0,,Kung ganito ang ugali mo,
Dialogue: 0,0:30:38.57,0:30:41.12,pangkalahatang teksto,,0,0,0,,ibalik ang lakas na ibinigay ko sa iyo
Dialogue: 0,0:30:43.33,0:30:45.41,pangkalahatang teksto,,0,0,0,,- Kabanata\N- Ano ito?
Dialogue: 0,0:30:45.50,0:30:48.54,pangkalahatang teksto,,0,0,0,,Pupunta rito ang Crown Prince para makipagkita kay Chan Wook
Dialogue: 0,0:30:53.96,0:30:55.26,general text,,0,0,0,,Your Highness
Dialogue: 0,0:30:57.43,0:30:58.51,pangkalahatang teksto,,0,0,0,,Kumusta
Dialogue: 0,0:31:14.15,0:31:17.53,italics,,0,0,0,,Crown Prince! Kamustahin mo siya!
Dialogue: 0,0:31:35.34,0:31:37.59,general text,,0,0,0,,Pumunta ako nang marinig ko ang tungkol sa pagdiriwang
Dialogue: 0,0:31:37.67,0:31:39.47,general text,,0,0,0,,Pero parang nasira ko
Dialogue: 0,0:31:40.72,0:31:44.10,general text,,0,0,0,,Kung iisipin mo, salamat sa akin,
Dialogue: 0,0:31:45.22,0:31:47.56,pangkalahatang teksto,,0,0,0,,dapat ako ay isang pinarangalan na panauhin
Dialogue: 0,0:31:48.19,0:31:49.77,general text,,0,0,0,,Bakit naging masama ang mood?
Dialogue: 0,0:31:50.65,0:31:52.73,pangkalahatang teksto,,0,0,0,,Sigurado ako, sa kaibuturan
Dialogue: 0,0:31:52.82,0:31:55.61,general text,,0,0,0,,asahan mong libing ko ito at hindi holiday
Dialogue: 0,0:31:55.69,0:31:57.19,general text,,0,0,0,,Kaya ang tanging magagawa ko lang ay,
Dialogue: 0,0:31:57.28,0:31:59.45,pangkalahatang teksto,,0,0,0,, mahinahong batiin ka
Dialogue: 0,0:32:05.45,0:32:07.16,pangkalahatang text,,0,0,0,,Libing o holiday,
Dialogue: 0,0:32:07.25,0:32:09.46,general text,,0,0,0,, laging may inuman doon
Dialogue: 0,0:32:10.25,0:32:13.21,pangkalahatang teksto,,0,0,0,,Kaya nagdala ako ng ilan
Dialogue: 0,0:32:18.55,0:32:20.59,general text,,0,0,0,,May laban pa ba?
Dialogue: 0,0:32:20.68,0:32:22.22,general text,,0,0,0,,Chapter, dapat kang bumaba
Dialogue: 0,0:32:22.30,0:32:25.10,pangkalahatang teksto,,0,0,0,,Abangan natin at tingnan
Dialogue: 0,0:32:31.10,0:32:33.02,pangkalahatang teksto,,0,0,0,,Upang batiin si Chang Wook sa kanyang tagumpay,
Dialogue: 0,0:32:35.32,0:32:36.86,general text,,0,0,0,,Bubuhusan ko siya ng inumin
Dialogue: 0,0:32:39.15,0:32:42.11,general text,,0,0,0,,Nakabisado mo si Ryusu at naging magician ng Jeonjingak
Dialogue: 0,0:32:42.20,0:32:44.37,pangkalahatang teksto,,0,0,0,,sa wala pang dalawang buwan
Dialogue: 0,0:32:45.87,0:32:47.16,pangkalahatang teksto,,0,0,0,,Binabati kita
Dialogue: 0,0:32:52.08,0:32:55.17,general text,,0,0,0,,Natalo ako sa laban, pero...
Dialogue: 0,0:32:55.25,0:32:57.67,pangkalahatang teksto,,0,0,0,,Natutuwa ako bilang Crown Prince
Dialogue: 0,0:32:58.84,0:33:01.09,pangkalahatang teksto,,0,0,0,,Si Deho ay napakahusay na salamangkero
Dialogue: 0,0:33:01.68,0:33:03.93,italics,,0,0,0,,Ito ay sulit na ipagdiwang
Dialogue: 0,0:33:04.51,0:33:05.80,pangkalahatang text,,0,0,0,,Inumin
Dialogue: 0,0:33:06.39,0:33:09.60,pangkalahatang teksto,,0,0,0,,at naging pinakamahusay na mago sa bansa
Dialogue: 0,0:33:10.18,0:33:12.02,general text,,0,0,0,,Ipagmalaki ka ni Deho,
Dialogue: 0,0:33:12.60,0:33:13.44,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:33:25.82,0:33:27.33,pangkalahatang teksto,,0,0,0,,Salamat, Kamahalan
Dialogue: 0,0:33:35.58,0:33:36.92,general text,,0,0,0,,bubuhos din kita
Dialogue: 0,0:33:48.60,0:33:51.68,pangkalahatang teksto,,0,0,0,,Sana maging isang kahanga-hangang hari ka
Dialogue: 0,0:34:12.04,0:34:13.66,pangkalahatang teksto,,0,0,0,,Maging isang dakilang hari, Kamahalan
Dialogue: 0,0:34:31.52,0:34:32.60,pangkalahatang teksto,,0,0,0,,Mabuti iyan
Dialogue: 0,0:34:32.68,0:34:36.14,pangkalahatang teksto,,0,0,0,,Ang Crown Prince ay walang sama ng loob
Dialogue: 0,0:34:39.94,0:34:42.15,pangkalahatang teksto,,0,0,0,,Prinsipe, tagapagmana ng trono,
Dialogue: 0,0:34:42.23,0:34:45.78,pangkalahatang teksto,,0,0,0,,at ang binatang ipinanganak sa ilalim ng bituin ng hari
Dialogue: 0,0:34:53.45,0:34:56.08,italics,,0,0,0,,Dalawang relics ni Jinyeowon ang nasira
Dialogue: 0,0:34:56.87,0:34:59.59,general text,,0,0,0,,Wala silang energy, wala silang silbi
Dialogue: 0,0:34:59.67,0:35:01.96,pangkalahatang teksto,,0,0,0,,Sunin ang mga ito at ikalat ang mga abo sa Lawa ng Gyeongcheongdaeho
Dialogue: 0,0:35:02.88,0:35:04.13,pangkalahatang teksto,,0,0,0,,Oo, ina
Dialogue: 0,0:35:04.72,0:35:07.30,general text,,0,0,0,,Madam, bumalik na ang ginoo
Dialogue: 0,0:35:08.14,0:35:09.22,pangkalahatang teksto,,0,0,0,,Ama?
Dialogue: 0,0:35:10.01,0:35:11.14,pangkalahatang teksto,,0,0,0,,Cho Young
Dialogue: 0,0:35:12.18,0:35:13.18,pangkalahatang teksto,,0,0,0,,Asawa
Dialogue: 0,0:35:13.27,0:35:14.73,pangkalahatang teksto,,0,0,0,,Ama!
Dialogue: 0,0:35:15.23,0:35:16.31,pangkalahatang teksto,,0,0,0,,Ama!
Dialogue: 0,0:35:17.02,0:35:18.73,italics,,0,0,0,,My Cho Young
Dialogue: 0,0:35:20.86,0:35:24.07,pangkalahatang teksto,,0,0,0,,Hayaan mo akong tingnan. Lalo kang gumanda
Dialogue: 0,0:35:33.54,0:35:34.66,general text,,0,0,0,,Bumalik ako
Dialogue: 0,0:35:38.04,0:35:40.00,general text,,0,0,0,,Natagpuan ko siya sa Volcano Island sa timog
Dialogue: 0,0:35:40.67,0:35:42.42,pangkalahatang teksto,,0,0,0,,Nawalan siya ng mga magulang sa pagkabata,
Dialogue: 0,0:35:42.50,0:35:45.67,pangkalahatang teksto,,0,0,0,,kaya walang maalala tungkol sa kanila
Dialogue: 0,0:35:45.76,0:35:49.76,general text,,0,0,0,,Mukhang kasing edad niya si Boo Young
Dialogue: 0,0:35:52.14,0:35:54.10,general text,,0,0,0,,Umalis ka na
Dialogue: 0,0:35:54.18,0:35:57.73,pangkalahatang teksto,,0,0,0,,isang bagay mula pagkabata?
Dialogue: 0,0:36:01.31,0:36:05.23,general text,,0,0,0,,Hindi tulad ni Boo Young, wala siyang energy,
Dialogue: 0,0:36:05.32,0:36:08.53,pangkalahatang text,,0,0,0,,at hindi siya makapag-spell
Dialogue: 0,0:36:08.61,0:36:12.82,general text,,0,0,0,,Maaaring nawalan siya ng lakas habang malayo kay Jinyoewon
Dialogue: 0,0:36:14.41,0:36:17.20,general text,,0,0,0,,Pero kung miyembro talaga siya ng Jin family,
Dialogue: 0,0:36:18.58,0:36:20.67,general text,,0,0,0,,madaling babalik ang kanyang lakas
Dialogue: 0,0:36:28.47,0:36:30.59,pangkalahatang teksto,,0,0,0,,Ipapakita sa atin ng pintong ito
Dialogue: 0,0:36:31.39,0:36:34.18,general text,,0,0,0,,miyembro ka ba talaga ng aming pamilya
Dialogue: 0,0:37:01.75,0:37:05.09,general text,,0,0,0,,Hindi ako ang babaeng matagal mo nang hinahanap?
Dialogue: 0,0:37:07.05,0:37:08.92,pangkalahatang teksto,,0,0,0,,Hindi, tila
Dialogue: 0,0:37:10.47,0:37:15.26,pangkalahatang teksto,,0,0,0,,Pero salamat sa pagdating mo hanggang dito. Bibigyan ka nila ng sapat na pera para mabawi ka.
Dialogue: 0,0:37:17.18,0:37:21.73,general text,,0,0,0,,Sa tingin mo magagalit si nanay dahil sa panibagong pagkabigo?
Dialogue: 0,0:37:22.81,0:37:24.40,general text,,0,0,0,,Ano ang dapat kong gawin, ama?
Dialogue: 0,0:38:16.91,0:38:18.03,mga alaala,,0,0,0,,Ina
Dialogue: 0,0:38:19.83,0:38:21.70,mga alaala,,0,0,0,,Namatay ang ibon sa hawla
Dialogue: 0,0:38:25.54,0:38:28.25,memories,,0,0,0,,Tama ka. mahirap
Dialogue: 0,0:38:28.34,0:38:31.63,mga alaala,,0,0,0,,Hanggang kahapon nakaramdam ako ng mainit na enerhiya
Dialogue: 0,0:38:33.05,0:38:34.63,mga alaala,,0,0,0,,At ngayon wala na
Dialogue: 0,0:38:36.30,0:38:40.39,alaala,,0,0,0,,nakikita ko, pero ikaw pa rin ang unang nakapansin
Dialogue: 0,0:38:40.47,0:38:43.23,mga alaala,,0,0,0,,Lahat ng nabubuhay na bagay ay may enerhiya
Dialogue: 0,0:38:44.10,0:38:46.35,mga alaala,,0,0,0,,Sa pamamagitan ng enerhiyang ito nakikita ko ang mundo
Dialogue: 0,0:38:46.44,0:38:50.98,mga alaala,,0,0,0,,Bu Young, nawa'y hindi mo makita ang nakikita ng iba
Dialogue: 0,0:38:52.19,0:38:56.11,mga alaala,,0,0,0,,Ikaw ay espesyal at nakikita mo ang hindi nakikita ng iba
Dialogue: 0,0:39:00.83,0:39:02.99,mga alaala,,0,0,0,,Ginawa mo akong bagong blindfold
Dialogue: 0,0:39:03.08,0:39:05.04,mga alaala,,0,0,0,,Gusto kong subukan ito
Dialogue: 0,0:39:25.43,0:39:26.60,pangkalahatang teksto,,0,0,0,,Asawa
Dialogue: 0,0:39:28.73,0:39:30.90,pangkalahatang text,,0,0,0,,Huwag kang magalit
Dialogue: 0,0:39:30.98,0:39:33.86,general text,,0,0,0,,I didn't expect much nung dinala ko siya dito
Dialogue: 0,0:39:35.82,0:39:38.03,general text,,0,0,0,,So kahit sino lang dinala mo?
Dialogue: 0,0:39:38.11,0:39:41.24,general text,,0,0,0,,Kaya sinusubukan mo lang akong pasayahin
Dialogue: 0,0:39:41.91,0:39:43.87,general text,,0,0,0,,Kaya nga 10 taon na kaming hindi mahanap.
Dialogue: 0,0:39:47.08,0:39:48.29,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,0:39:49.04,0:39:51.96,general text,,0,0,0,,Magsisimula akong maghanap muli
Dialogue: 0,0:39:53.00,0:39:54.34,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:39:54.42,0:39:57.51,pangkalahatang text,,0,0,0,,Tutulong si Jin Mu mula kay Jeonbugwan na mahanap siya
Dialogue: 0,0:39:57.59,0:40:01.64,general text,,0,0,0,,Akala ko galit ka sa stepbrother mo
Dialogue: 0,0:40:01.72,0:40:05.06,general text,,0,0,0,,I hate it. Ngunit kung Boo Young ang pinag-uusapan,
Dialogue: 0,0:40:05.14,0:40:08.89,pangkalahatang teksto,,0,0,0,,Handa akong humingi ng tulong sa kanya
Dialogue: 0,0:40:14.82,0:40:15.90,pangkalahatang text,,0,0,0,,Lumabas
Dialogue: 0,0:40:16.44,0:40:19.40,general text,,0,0,0,,May hinahanap ako dito
Dialogue: 0,0:40:19.49,0:40:20.78,general text,,0,0,0,,Nandito si Moo Dok, tama ba?
Dialogue: 0,0:40:20.86,0:40:23.12,general text,,0,0,0,,Maraming tao ngayon dito balik bukas
Dialogue: 0,0:40:25.24,0:40:26.54,pangkalahatang teksto,,0,0,0,,Itinulak ako
Dialogue: 0,0:40:28.46,0:40:29.96,general text,,0,0,0,,Kilala mo ba kung sino ako?
Dialogue: 0,0:40:31.00,0:40:32.17,pangkalahatang teksto,,0,0,0,,At sino?
Dialogue: 0,0:40:34.21,0:40:37.17,pangkalahatang teksto,,0,0,0,,Ako ay isang salamangkero ng isa sa mga pinakamataas na pamilya ng bansang ito
Dialogue: 0,0:40:39.59,0:40:42.34,pangkalahatang teksto,,0,0,0,,Ipakita sa iyo ang aking mahika?
Dialogue: 0,0:40:48.60,0:40:49.98,pangkalahatang teksto,,0,0,0,,Isaalang-alang ang iyong sarili na masuwerte
Dialogue: 0,0:40:50.52,0:40:53.15,pangkalahatang teksto,,0,0,0,,Kung maglalagay ako ng enerhiya sa aking kamay, mamamatay ka
Dialogue: 0,0:40:53.86,0:40:56.48,pangkalahatang text,,0,0,0,,Paumanhin. pasensya na po
Dialogue: 0,0:40:57.11,0:41:00.24,general text,,0,0,0,,Gisaeng house lang. Hindi mo ba pinapayagan ang mga bisita?
Dialogue: 0,0:41:00.32,0:41:03.91,pangkalahatang teksto,,0,0,0,,Ngayon ay pista ng mga salamangkero ng Jeonjingak
Dialogue: 0,0:41:04.49,0:41:05.58,pangkalahatang teksto,,0,0,0,,- Sosnovy Bor?\N- Oo
Dialogue: 0,0:41:05.66,0:41:08.75,pangkalahatang teksto,,0,0,0,,Maging ang Crown Prince ay narito
Dialogue: 0,0:41:09.62,0:41:12.25,general text,,0,0,0,,Nabalitaan kong ibinenta siya sa pinakamalaking gisaeng house sa Daeho
Dialogue: 0,0:41:12.92,0:41:14.75,general text,,0,0,0,,Ito siguro ang bahay na iyon
Dialogue: 0,0:41:14.83,0:41:17.92,general text,,0,0,0,,Kung bibigyan mo ako ng pangalan, ipapakilala kita
Dialogue: 0,0:41:19.09,0:41:21.88,pangkalahatang teksto,,0,0,0,,Hindi sulit. babalik ako bukas
Dialogue: 0,0:41:24.39,0:41:25.85,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:41:27.22,0:41:28.39,pangkalahatang teksto,,0,0,0,,Sino ang nandoon?
Dialogue: 0,0:41:28.97,0:41:31.35,italics,,0,0,0,,Sabi niya galing siya sa mataas na pamilya
Dialogue: 0,0:41:31.43,0:41:32.98,general text,,0,0,0,,I think this is Jinyeowon
Dialogue: 0,0:41:33.06,0:41:36.40,pangkalahatang teksto,,0,0,0,,May sabit sa leeg niya na may Jinyoewon crest
Dialogue: 0,0:41:36.48,0:41:37.69,pangkalahatang text,,0,0,0,,Jinyeowon?
Dialogue: 0,0:41:38.19,0:41:43.86,pangkalahatang teksto,,0,0,0,,Ang kanilang mga salamangkero ay palaging bastos at mapili
Dialogue: 0,0:41:44.70,0:41:46.24,general text,,0,0,0,,Okay ka lang?
Dialogue: 0,0:41:46.32,0:41:50.12,general text,,0,0,0,,Hindi masakit. Siya ay mahina para sa isang salamangkero
Dialogue: 0,0:41:50.20,0:41:53.00,general text,,0,0,0,,Paano kung nagsinungaling siya at peke lang ang coat of arms?
Dialogue: 0,0:41:54.00,0:41:57.71,pangkalahatang teksto,,0,0,0,,Kung sa Deho ay nagpanggap kang isang kataas-taasang pamilya,
Dialogue: 0,0:41:57.79,0:41:59.38,general text,,0,0,0,,maari kang mamatay
Dialogue: 0,0:42:01.01,0:42:02.47,pangkalahatang teksto,,0,0,0,,Kakaibang babae
Dialogue: 0,0:42:11.35,0:42:15.10,italics,,0,0,0,,Sa Deho Fortress, ang mga salamangkero ay talagang mayroong maraming pribilehiyo
Dialogue: 0,0:42:16.86,0:42:18.52,general text,,0,0,0,,Dapat nandiyan si Moo Dok sa isang lugar
Dialogue: 0,0:42:28.58,0:42:30.91,pangkalahatang teksto,,0,0,0,,Kailangan nating mabuhay para sa kanyang pera kahit kaunti
Dialogue: 0,0:42:32.58,0:42:34.54,pangkalahatang teksto,,0,0,0,,Kung sasabihin kong naparito ako upang ibalik ito,
Dialogue: 0,0:42:35.54,0:42:38.75,general text,,0,0,0,,I'm sure hahayaan niya akong manatili, mabait siya
Dialogue: 0,0:42:40.42,0:42:42.38,general text,,0,0,0,,- Hoy, sino ka?\N- Natatakot
Dialogue: 0,0:42:49.60,0:42:50.68,general text,,0,0,0,,Hintayin mo ako sa labas
Dialogue: 0,0:42:51.26,0:42:52.43,pangkalahatang teksto,,0,0,0,,Oo, Kamahalan
Dialogue: 0,0:42:59.94,0:43:01.61,pangkalahatang teksto,,0,0,0,,Dapat siyang lumabas
Dialogue: 0,0:43:02.98,0:43:06.11,pangkalahatang teksto,,0,0,0,,Isa, dalawa, tatlo
Dialogue: 0,0:43:08.70,0:43:10.58,pangkalahatang teksto,,0,0,0,,Apat, lima...
Dialogue: 0,0:43:11.49,0:43:12.66,italics,,0,0,0,,Your Highness
Dialogue: 0,0:43:14.45,0:43:15.79,pangkalahatang teksto,,0,0,0,,Kamahalan!
Dialogue: 0,0:43:19.88,0:43:25.17,general text,,0,0,0,,Muli akong naantig
Dialogue: 0,0:43:25.76,0:43:27.26,pangkalahatang teksto,,0,0,0,,ang iyong walang katapusang kabutihang-loob
Dialogue: 0,0:43:29.22,0:43:32.47,general text,,0,0,0,,Oo, nagkunwari akong mabait at mapagbigay
Dialogue: 0,0:43:32.56,0:43:34.68,pangkalahatang teksto,,0,0,0,,Maaaring baligtarin ang lugar na ito
Dialogue: 0,0:43:34.77,0:43:37.94,general text,,0,0,0,,Ngunit, gaya ng sinabi ko na, ayokong maging kaaway ko ang mga salamangkero
Dialogue: 0,0:43:39.23,0:43:41.61,pangkalahatang teksto,,0,0,0,,Ano? Sa tingin mo ba ako ay tanga?
Dialogue: 0,0:43:42.52,0:43:45.32,pangkalahatang teksto,,0,0,0,,Ikaw ay kumilos nang napakatalino at matalino,
Dialogue: 0,0:43:45.40,0:43:49.07,pangkalahatang teksto,,0,0,0,, itinatago ang iyong kakulitan at emosyon
Dialogue: 0,0:43:49.95,0:43:52.74,pangkalahatang text,,0,0,0,,Napagpasyahan kong magpakita ng pettiness sa iyo lang, Won Moo Deok
Dialogue: 0,0:43:52.83,0:43:57.16,general text,,0,0,0,,Naiimagine ko kung gaano kahirap buhusan siya ng inumin,
Dialogue: 0,0:43:57.25,0:43:59.58,pangkalahatang teksto,,0,0,0,,kapag gusto mong lasunin
Dialogue: 0,0:43:59.67,0:44:02.54,general text,,0,0,0,,Kaya dali-dali akong pumunta dito
Dialogue: 0,0:44:03.29,0:44:05.51,pangkalahatang teksto,,0,0,0,,Nasusuklam ako sa iyong panginoon hanggang sa nasusuka
Dialogue: 0,0:44:05.59,0:44:06.71,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:44:06.80,0:44:08.63,general text,,0,0,0,,Nag-aapoy ang atay ko sa galit sa kanya
Dialogue: 0,0:44:08.72,0:44:10.47,pangkalahatang teksto,,0,0,0,,Wala akong duda
Dialogue: 0,0:44:10.55,0:44:12.26,general text,,0,0,0,,At ikaw... sinusuportahan mo siya...
Dialogue: 0,0:44:13.72,0:44:15.39,general text,,0,0,0,,Ayoko rin sayo
Dialogue: 0,0:44:21.23,0:44:23.52,pangkalahatang teksto,,0,0,0,,Ang aking kabutihang-loob ay inilaan para sa iyo, hindi para sa kanya
Dialogue: 0,0:44:26.48,0:44:27.99,pangkalahatang teksto,,0,0,0,,Won Moo Deok
Dialogue: 0,0:44:28.07,0:44:31.36,general text,,0,0,0,,Kung mag-aaway o mag-away ulit tayo,
Dialogue: 0,0:44:32.49,0:44:34.33,general text,,0,0,0,,papatayin muna kita
Dialogue: 0,0:44:39.04,0:44:42.96,pangkalahatang teksto,,0,0,0,,Kamahalan, kung ako ay mamatay sa iyong tabak,
Dialogue: 0,0:44:44.84,0:44:46.63,pangkalahatang teksto,,0,0,0,,Hindi ako magdaramdam sa iyo
Dialogue: 0,0:44:47.76,0:44:50.09,general text,,0,0,0,,Maglilingkod ka ba sa master sa anumang kaso?
Dialogue: 0,0:44:50.18,0:44:51.59,pangkalahatang teksto,,0,0,0,,Napakatapat na lingkod
Dialogue: 0,0:44:51.68,0:44:53.76,general text,,0,0,0,,Siguro dapat kaming magtayo ng monumento para sa iyo?
Dialogue: 0,0:44:53.85,0:44:57.43,pangkalahatang teksto,,0,0,0,,Lubos akong ikinararangal na matanggap ang iyong pagkilala
Dialogue: 0,0:44:57.52,0:44:59.02,pangkalahatang teksto,,0,0,0,,Kalimutan. mawala
Dialogue: 0,0:44:59.10,0:45:01.48,general text,,0,0,0,,Hanggang sa nawala lahat ng generosity ko at naging maliit ulit.
Dialogue: 0,0:45:02.48,0:45:04.69,general text,,0,0,0,,- Your Highness\N- Ano? ano ulit?
Dialogue: 0,0:45:04.77,0:45:07.11,pangkalahatang teksto,,0,0,0,,Lumalabas ang dying wish?
Dialogue: 0,0:45:08.19,0:45:11.03,general text,,0,0,0,,Kumusta ang iyong mga sugat? okay ka lang ba?
Dialogue: 0,0:45:14.12,0:45:16.74,general text,,0,0,0,,Dapat nagtanong kanina
Dialogue: 0,0:45:16.83,0:45:19.20,pangkalahatang teksto,,0,0,0,,Huwag mag-alala. Hindi malakas ang pag-atake
Dialogue: 0,0:45:19.29,0:45:21.16,general text,,0,0,0,,Oo, at tinambalan na ako ni Ho Yeom
Dialogue: 0,0:45:22.12,0:45:25.79,general text,,0,0,0,,Nagulat ka dahil hindi mo ito inaasahan sa aking amo
Dialogue: 0,0:45:25.88,0:45:29.34,general text,,0,0,0,,Pero ikaw, siyempre, mas malakas kaysa sa kanya
Dialogue: 0,0:45:29.42,0:45:32.80,pangkalahatang teksto,,0,0,0,,Natural. Sino ang nakakaalam na ginagamit niya si Tansu?
Dialogue: 0,0:45:32.88,0:45:34.01,pangkalahatang text,,0,0,0,,Fraudster
Dialogue: 0,0:45:34.89,0:45:36.10,mga alaala,,0,0,0,,Oh, ang ibig mong sabihin ay sachet,
Dialogue: 0,0:45:36.89,0:45:40.10,mga alaala,,0,0,0,,na isinabit niya sa tabi ng hukay ng palikuran upang itakwil ang mga langaw?
Dialogue: 0,0:45:42.89,0:45:45.23,general text,,0,0,0,,Nasaan na yung sachet na binigay ko sayo?
Dialogue: 0,0:45:45.31,0:45:46.19,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:45:47.11,0:45:50.07,general text,,0,0,0,,Bigla mo itong isinabit sa tabi ng latrine pit para itaboy ang mga langaw
Dialogue: 0,0:45:53.32,0:45:54.45,pangkalahatang teksto,,0,0,0,,Dito
Dialogue: 0,0:45:55.11,0:45:58.53,pangkalahatang teksto,,0,0,0,,Bakit isabit ang gayong kayamanan malapit sa palikuran?
Dialogue: 0,0:45:58.62,0:46:01.33,pangkalahatang teksto,,0,0,0,, Eksakto. Alam kong hindi mo ito gagawin
Dialogue: 0,0:46:02.29,0:46:03.21,pangkalahatang teksto,,0,0,0,,Well, okay
Dialogue: 0,0:46:05.92,0:46:07.79,pangkalahatang teksto,,0,0,0,,Magandang paglalakbay, Kamahalan
Dialogue: 0,0:46:20.10,0:46:22.43,italics,,0,0,0,,- Enough\N- Iyon lang
Dialogue: 0,0:46:22.52,0:46:24.52,general text,,0,0,0,,- Master\N- Iwanan mo ako
Dialogue: 0,0:46:24.60,0:46:26.65,pangkalahatang teksto,,0,0,0,,Gumising, master
Dialogue: 0,0:46:28.02,0:46:29.32,general text,,0,0,0,,- Hey\N- Tingnan mo yan
Dialogue: 0,0:46:30.36,0:46:32.53,pangkalahatang text,,0,0,0,,Maghihilom na lang siya bukas ng umaga
Dialogue: 0,0:46:32.61,0:46:34.24,italics,,0,0,0,,Mabilis malasing
Dialogue: 0,0:46:34.32,0:46:37.20,general text,,0,0,0,,Ininom niya lahat ng inialok sa kanya ng Crown Prince
Dialogue: 0,0:46:37.28,0:46:40.12,general text,,0,0,0,,Dapat tinulungan natin siya noon. Ikaw lang ang matino dito
Dialogue: 0,0:46:40.20,0:46:43.00,general text,,0,0,0,,busy ako, kumakanta ako
Dialogue: 0,0:46:44.54,0:46:46.08,italics,,0,0,0,,Ilagay ang palanquin
Dialogue: 0,0:46:49.29,0:46:52.05,general text,,0,0,0,,Yung mga pinapayagang makapasa lang dito ang pwede
Dialogue: 0,0:46:52.63,0:46:54.92,general text,,0,0,0,,Kung hindi ka taga-Sosnovy Bor, umalis ka
Dialogue: 0,0:47:02.52,0:47:03.89,general text,,0,0,0,,Hindi mo rin kaya
Dialogue: 0,0:47:05.27,0:47:06.60,pangkalahatang text,,0,0,0,,Ako si Moo Dok
Dialogue: 0,0:47:07.40,0:47:09.36,pangkalahatang teksto,,0,0,0,,Mr. Kasambahay ni Chan
Dialogue: 0,0:47:09.44,0:47:10.69,pangkalahatang teksto,,0,0,0,,Alam mo
Dialogue: 0,0:47:12.11,0:47:15.70,general text,,0,0,0,,Pinapayagan ka lang pumasok dahil guest si Chang Wook dito dati.
Dialogue: 0,0:47:15.78,0:47:16.82,pangkalahatang teksto,,0,0,0,,Ngunit ngayon ay iba na ang lahat
Dialogue: 0,0:47:16.90,0:47:19.49,pangkalahatang teksto,,0,0,0,,Siya ay miyembro ng Sosnovy Bor, at hindi ka
Dialogue: 0,0:47:20.24,0:47:21.37,general text,,0,0,0,,Kaya hindi mo kaya
Dialogue: 0,0:47:21.45,0:47:23.45,general text,,0,0,0,,Ano ang mangyayari sa may-ari?
Dialogue: 0,0:47:23.54,0:47:26.91,general text,,0,0,0,,Lasing na lasing siya. Kailangan ko siyang alagaan
Dialogue: 0,0:47:27.00,0:47:30.21,pangkalahatang teksto,,0,0,0,,Aalagaan siya ng mga katulong ni Chongjingak
Dialogue: 0,0:47:33.17,0:47:34.38,pangkalahatang teksto,,0,0,0,,Hindi!
Dialogue: 0,0:47:35.88,0:47:38.72,general text,,0,0,0,,Dapat malapit ako sa may-ari
Dialogue: 0,0:47:38.80,0:47:40.05,pangkalahatang text,,0,0,0,,Papasukin mo ako
Dialogue: 0,0:47:40.14,0:47:42.81,pangkalahatang text,,0,0,0,,Papasukin na siya
Dialogue: 0,0:47:42.89,0:47:45.48,pangkalahatang text,,0,0,0,,May gagawin si Uk kung wala siya
Dialogue: 0,0:47:45.56,0:47:49.56,pangkalahatang teksto,,0,0,0,,Wala ni isang salamangkero ni Jeongjingak ang may pribilehiyo ng kanyang sariling kasambahay
Dialogue: 0,0:47:51.11,0:47:54.32,general text,,0,0,0,,Si Chan Wook ay pumasok sa Sosnovy Bor, kaya dapat niyang sundin ang aming mga patakaran
Dialogue: 0,0:47:55.15,0:47:57.24,general text,,0,0,0,,So hindi talaga ako maka-log in?
Dialogue: 0,0:47:57.32,0:47:58.78,pangkalahatang teksto,,0,0,0,,Ito ang mga patakaran
Dialogue: 0,0:47:59.41,0:48:01.62,pangkalahatang text,,0,0,0,,Umuwi ka muna
Dialogue: 0,0:48:01.70,0:48:03.58,general text,,0,0,0,,Iuuwi ko si Uk pag gising niya
Dialogue: 0,0:48:03.66,0:48:05.08,pangkalahatang text,,0,0,0,,Hindi makaalis si Chan Wook
Dialogue: 0,0:48:05.75,0:48:09.25,pangkalahatang teksto,,0,0,0,,Hindi siya makakaalis kay Sosnovy Bor hangga't hindi niya natatapos ang kanyang pagsasanay
Dialogue: 0,0:48:09.33,0:48:10.83,pangkalahatang teksto,,0,0,0,,Ito ay isang tuntunin din
Dialogue: 0,0:48:13.29,0:48:15.59,pangkalahatang teksto,,0,0,0,, Eksakto. Nagstay din kami dito
Dialogue: 0,0:48:16.38,0:48:17.34,pangkalahatang teksto,,0,0,0,,Ibig sabihin,
Dialogue: 0,0:48:17.42,0:48:20.38,general text,,0,0,0,,Hindi ako makapasok at hindi makalabas ang master ko?
Dialogue: 0,0:48:20.47,0:48:22.35,general text,,0,0,0,,At hindi tayo pwedeng magkasama?
Dialogue: 0,0:48:22.43,0:48:25.47,general text,,0,0,0,,Pag naintindihan ko na, umuwi ka na sa kanila
Dialogue: 0,0:48:26.93,0:48:28.14,pangkalahatang text,,0,0,0,,Teka...
Dialogue: 0,0:48:44.66,0:48:46.62,pangkalahatang teksto,,0,0,0,,Ito ang unang araw ni Chan Wook sa Jeonjingak
Dialogue: 0,0:48:46.70,0:48:49.21,general text,,0,0,0,,Gusto mo bang labagin niya ang rules sa unang araw niya?
Dialogue: 0,0:48:56.80,0:48:59.76,pangkalahatang text,,0,0,0,,Papasukin mo ako!
Dialogue: 0,0:49:02.26,0:49:05.05,italics,,0,0,0,,Kung tatayo ka diyan, hindi siya aalis
Dialogue: 0,0:49:05.14,0:49:07.77,italics,,0,0,0,,Pag nalaman ng ulo, parurusahan ko siya
Dialogue: 0,0:49:07.85,0:49:09.02,pangkalahatang text,,0,0,0,,So tara na
Dialogue: 0,0:49:10.31,0:49:14.40,general text,,0,0,0,,Moo Dok, umuwi ka na. Hahanap tayo ng paraan
Dialogue: 0,0:49:22.36,0:49:23.70,pangkalahatang teksto,,0,0,0,,Guro!
Dialogue: 0,0:49:28.49,0:49:30.29,pangkalahatang text,,0,0,0,,Isama mo ako!
Dialogue: 0,0:49:31.58,0:49:32.87,pangkalahatang teksto,,0,0,0,,Guro!
Dialogue: 0,0:49:48.31,0:49:50.52,general text,,0,0,0,,Lolo, kumusta ka na?
Dialogue: 0,0:49:50.60,0:49:51.60,pangkalahatang teksto,,0,0,0,,Lahat ay maayos
Dialogue: 0,0:49:52.69,0:49:56.23,pangkalahatang teksto,,0,0,0,,Lumaki ka sa isang magandang babae
Dialogue: 0,0:49:57.27,0:50:00.15,general text,,0,0,0,,Master Huo, isang lasing na mago ang inihatid
Dialogue: 0,0:50:00.23,0:50:01.61,general text,,0,0,0,,dahil sa kanyang mabigat na paghinga
Dialogue: 0,0:50:01.69,0:50:05.32,general text,,0,0,0,,Lasing lang siya, ikaw na ang bahala sa kanya
Dialogue: 0,0:50:05.41,0:50:08.87,pangkalahatang teksto,,0,0,0,,Ito si Chan Wook. Binigyan mo siya ng iyong enerhiya
Dialogue: 0,0:50:08.95,0:50:11.58,pangkalahatang teksto,,0,0,0,,Ano? Chan Wook?
Dialogue: 0,0:50:11.66,0:50:12.83,pangkalahatang teksto,,0,0,0,,Uk?
Dialogue: 0,0:50:35.48,0:50:37.27,behind the scenes,,0,0,0,,Ito ang mago
Dialogue: 0,0:50:39.98,0:50:42.32,general text,,0,0,0,,Yoon Ok, halika dito
Dialogue: 0,0:50:42.40,0:50:43.57,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:50:48.99,0:50:52.70,pangkalahatang teksto,,0,0,0,,Sarado ang kanyang energy gate sa loob ng maraming taon, at binuksan ko ito para sa kanya
Dialogue: 0,0:50:53.29,0:50:56.04,general text,,0,0,0,,Binigyan ko pa siya ng lakas. Chan Wook ang pangalan niya
Dialogue: 0,0:50:57.96,0:50:59.04,pangkalahatang text,,0,0,0,,Chang Wook?
Dialogue: 0,0:50:59.13,0:51:02.67,pangkalahatang teksto,,0,0,0,,Oo. Isang buwan na lang ang lumipas at kabisado na niya si Ryusu
Dialogue: 0,0:51:02.76,0:51:03.92,pangkalahatang teksto,,0,0,0,,Siya ay isang henyo
Dialogue: 0,0:51:04.42,0:51:05.55,pangkalahatang text,,0,0,0,,Para sa isang buwan?
Dialogue: 0,0:51:06.88,0:51:09.47,pangkalahatang teksto,,0,0,0,,Talagang henyo
Dialogue: 0,0:51:23.23,0:51:25.57,general text,,0,0,0,,Well, lasing na lasing ako
Dialogue: 0,0:51:25.65,0:51:28.66,general text,,0,0,0,,Pupunta ako sa kwarto ko at matutulog
Dialogue: 0,0:51:28.74,0:51:30.37,general text,,0,0,0,,Alagaan mo siya
Dialogue: 0,0:51:30.95,0:51:32.70,pangkalahatang teksto,,0,0,0,,Halika
Dialogue: 0,0:51:32.79,0:51:34.37,pangkalahatang teksto,,0,0,0,,Okay, lolo
Dialogue: 0,0:51:50.97,0:51:52.72,general text,,0,0,0,,Nagkita tayong muli
Dialogue: 0,0:51:54.64,0:51:56.85,pangkalahatang teksto,,0,0,0,,Mr. Chang Wook
Dialogue: 0,0:52:13.28,0:52:15.66,general text,,0,0,0,,Hindi ako pumunta dito para sumuko
Dialogue: 0,0:52:18.21,0:52:19.96,pangkalahatang teksto,,0,0,0,,Papasok ako sa anumang paraan na kinakailangan
Dialogue: 0,0:52:36.27,0:52:37.52,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:52:45.40,0:52:46.61,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:52:47.78,0:52:51.82,pangkalahatang teksto,,0,0,0,,Namamatay ang iyong amo. Umiikot ang ulo ko
Dialogue: 0,0:53:32.49,0:53:33.57,pangkalahatang teksto,,0,0,0,,Chan Wook,
Dialogue: 0,0:53:35.74,0:53:37.28,general text,,0,0,0,,kung iiwan mo ako,
Dialogue: 0,0:53:39.45,0:53:41.37,general text,,0,0,0,,I swear papatayin kita
Dialogue: 0,0:54:07.86,0:54:09.28,pangkalahatang teksto,,0,0,0,,Mr. Yul?
Dialogue: 0,0:54:11.61,0:54:13.65,general text,,0,0,0,,Akala ko baka nandito ka pa
Dialogue: 0,0:54:14.74,0:54:15.99,pangkalahatang teksto,,0,0,0,,At tama ako
Dialogue: 0,0:54:18.12,0:54:19.91,general text,,0,0,0,,Hinding-hindi ako aalis
Dialogue: 0,0:54:22.08,0:54:24.62,general text,,0,0,0,,Dapat kasama ko ang may-ari
Dialogue: 0,0:54:27.46,0:54:29.71,pangkalahatang teksto,,0,0,0,,Ang pag-upo dito ay hindi malulutas ang problema
Dialogue: 0,0:54:29.80,0:54:32.47,pangkalahatang teksto,,0,0,0,,Labagin mo lang si Uka sa mga patakaran
Dialogue: 0,0:54:32.55,0:54:35.09,pangkalahatang teksto,,0,0,0,,Kung gayon ang lahat ng kanyang mga pagpapagal ay magiging walang kabuluhan
Dialogue: 0,0:54:37.34,0:54:38.64,pangkalahatang teksto,,0,0,0,,Tama ka
Dialogue: 0,0:54:39.85,0:54:41.56,general text,,0,0,0,,Umuwi ka na, maghintay ka dyan
Dialogue: 0,0:54:42.39,0:54:43.85,general text,,0,0,0,,Sasamahan kita
Dialogue: 0,0:54:54.57,0:54:56.57,pangkalahatang teksto,,0,0,0,,Sabihin mo sa aking panginoon,
Dialogue: 0,0:54:57.95,0:54:59.66,general text,,0,0,0,,na gagawa ako ng paraan
Dialogue: 0,0:55:00.45,0:55:02.95,pangkalahatang teksto,,0,0,0,,pumunta sa Sosnovy Bor sa may-ari
Dialogue: 0,0:55:05.33,0:55:07.37,general text,,0,0,0,,Sabihin sa kanya na huminto hanggang doon
Dialogue: 0,0:55:09.79,0:55:12.55,pangkalahatang text,,0,0,0,,Okay. sasabihin ko sayo
Dialogue: 0,0:56:07.69,0:56:09.81,general text,,0,0,0,,Sobrang sakit ng ulo ko
Dialogue: 0,0:56:12.65,0:56:14.40,pangkalahatang teksto,,0,0,0,,Lahat ng prinsipe
Dialogue: 0,0:56:16.36,0:56:17.65,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:56:18.49,0:56:21.37,general text,,0,0,0,,- Magdala ka ng tubig\N{\i1}- Sino si Moo Deok?
Dialogue: 0,0:56:24.29,0:56:25.37,pangkalahatang teksto,,0,0,0,,Sino ka?
Dialogue: 0,0:56:25.45,0:56:28.33,pangkalahatang teksto,,0,0,0,,Hindi mo naaalala? Nagkita kami sa inn
Dialogue: 0,0:56:30.62,0:56:31.88,mga alaala na italics,,0,0,0,,Huwag magsinungaling
Dialogue: 0,0:56:31.96,0:56:34.92,mga alaala,,0,0,0,,Nakatitig ka sa kanya sa buong oras!
Dialogue: 0,0:56:35.92,0:56:38.38,general text,,0,0,0,,Ah, Ta Sun something there
Dialogue: 0,0:56:39.13,0:56:40.59,pangkalahatang teksto,,0,0,0,,Eksakto, Song Yi
Dialogue: 0,0:56:41.68,0:56:42.80,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:56:42.89,0:56:47.31,general text,,0,0,0,,Mistress Ho ay apo ni Master Ho Yeom
Dialogue: 0,0:56:47.39,0:56:48.56,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:56:50.02,0:56:51.44,general text,,0,0,0,,Iyon lang ba?
Dialogue: 0,0:56:51.52,0:56:52.81,general text,,0,0,0,,Kung sasabihin niya kay Master Huo,
Dialogue: 0,0:56:52.90,0:56:55.73,general text,,0,0,0,,gaano ka bastos sa kanya, magagalit sayo ang amo
Dialogue: 0,0:56:56.48,0:56:58.65,pangkalahatang text,,0,0,0,, Kahit kailan hindi niya ako nagustuhan
Dialogue: 0,0:56:58.74,0:56:59.86,pangkalahatang teksto,,0,0,0,,Hayaan siyang sabihin
Dialogue: 0,0:57:03.32,0:57:04.74,general text,,0,0,0,,Well, at least thank her
Dialogue: 0,0:57:04.83,0:57:06.54,pangkalahatang text,,0,0,0,,Inalagaan ka ni Misis magdamag
Dialogue: 0,0:57:06.62,0:57:07.91,pangkalahatang teksto,,0,0,0,,Ang iyong babae?
Dialogue: 0,0:57:16.71,0:57:18.21,pangkalahatang teksto,,0,0,0,,Mas mabuting huwag mo nang banggitin ito sa kanya
Dialogue: 0,0:57:20.13,0:57:23.26,general text,,0,0,0,,Nakilala mo na ba si Uk?
Dialogue: 0,0:57:24.01,0:57:24.93,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:57:25.01,0:57:29.98,general text,,0,0,0,,Tinulungan ni Chan Wook si Yoon Ok noong may problema siya
Dialogue: 0,0:57:30.06,0:57:31.39,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:57:31.48,0:57:34.69,pangkalahatang teksto,,0,0,0,,Ang UK ay hindi isa sa mga tumutulong lamang sa mga tao
Dialogue: 0,0:57:35.94,0:57:37.86,general text,,0,0,0,,Ano ang sinasabi mo tungkol sa kanya?
Dialogue: 0,0:57:40.15,0:57:41.78,general text,,0,0,0,,Nabalitaan kong dumating ka mula sa Vol fortress
Dialogue: 0,0:57:42.61,0:57:46.33,general text,,0,0,0,,Ako at ang ina ng ginoo ay tagaroon
Dialogue: 0,0:57:47.33,0:57:50.66,general text,,0,0,0,,- Nakikita ko\N - Marahil kaya
Dialogue: 0,0:57:50.75,0:57:52.92,pangkalahatang text,,0,0,0,,ipapaalala mo sa akin si Mrs. Do Hwa
Dialogue: 0,0:57:54.46,0:57:57.42,pangkalahatang teksto,,0,0,0,,Sa tingin ko kayo at ang aking panginoon ay nakatadhana na magsama
Dialogue: 0,0:57:59.71,0:58:02.09,pangkalahatang teksto,,0,0,0,,Kung ang mga tao mula sa parehong lungsod ay dapat magkatulad,
Dialogue: 0,0:58:02.68,0:58:04.93,pangkalahatang teksto,,0,0,0,,kung gayon dapat ay magkatulad din kayo sa isa't isa
Dialogue: 0,0:58:06.93,0:58:08.89,pangkalahatang teksto,,0,0,0,,Ngunit wala kayong pagkakatulad
Dialogue: 0,0:58:11.02,0:58:12.48,general text,,0,0,0,,Hindi ko maintindihan ang ibig mong sabihin
Dialogue: 0,0:58:13.73,0:58:15.31,italics,,0,0,0,,Maiden Kim, ang galing mo,
Dialogue: 0,0:58:15.40,0:58:19.69,pangkalahatang teksto,,0,0,0,,ngunit kung minsan ay nagpapalaki ka at gumagawa ng madaliang konklusyon
Dialogue: 0,0:58:20.57,0:58:23.07,general text,,0,0,0,,Sinasabi mo bang nagsisinungaling ako?
Dialogue: 0,0:58:24.20,0:58:25.53,general text,,0,0,0,,Hindi ko sinabi yun
Dialogue: 0,0:58:26.12,0:58:27.66,italics,,0,0,0,,Dito at ngayon
Dialogue: 0,0:58:27.74,0:58:31.12,general text,,0,0,0,,Nagalit sila at tinawag pa nila ang kanilang sarili na sinungaling
Dialogue: 0,0:58:31.20,0:58:32.29,pangkalahatang teksto,,0,0,0,,Oo, oo, siyempre
Dialogue: 0,0:58:32.37,0:58:35.71,pangkalahatang teksto,,0,0,0,,Ako ay isang madaling magalit na sinungaling
Dialogue: 0,0:58:35.79,0:58:37.88,general text,,0,0,0,,Kailan kita tinawag na sinungaling?
Dialogue: 0,0:58:37.96,0:58:40.21,pangkalahatang teksto,,0,0,0,,Ngayon ay eksakto kung ano ang sinabi mo
Dialogue: 0,0:58:40.30,0:58:41.55,pangkalahatang teksto,,0,0,0,,Ito ang iyong mga salita
Dialogue: 0,0:58:41.63,0:58:42.92,italics,,0,0,0,,- Ano bang problema mo?\N- Ikaw ang may kasalanan...
Dialogue: 0,0:58:43.01,0:58:45.84,general text,,0,0,0,,Anong klaseng relasyon meron sila?
Dialogue: 0,0:58:48.89,0:58:51.52,general text,,0,0,0,,Sila ay may kakaiba at kakaibang relasyon,
Dialogue: 0,0:58:51.60,0:58:53.77,pangkalahatang teksto,,0,0,0,,nakalakip
Dialogue: 0,0:58:53.85,0:58:56.23,italics,,0,0,0,,- Ikaw ang unang nagalit\N- Sabi mo nagsisinungaling ako
Dialogue: 0,0:58:56.31,0:58:58.27,general text,,0,0,0,,Mukhang close sila, pero walang espesyal doon
Dialogue: 0,0:58:58.36,0:59:00.52,general text,,0,0,0,,- Ikaw mismo ang umupo dito, paulit-ulit...\N-{\i1} Pero nakikita mo,
Dialogue: 0,0:59:00.61,0:59:03.82,general text,,0,0,0,,- masyado siyang tanga\N- {\i1}Tawagin mo pa akong sinungaling
Dialogue: 0,0:59:03.90,0:59:05.32,pangkalahatang teksto,,0,0,0,,At nakakainis
Dialogue: 0,0:59:05.40,0:59:06.41,pangkalahatang teksto,,0,0,0,,Walang salita
Dialogue: 0,0:59:06.49,0:59:08.66,pangkalahatang teksto,,0,0,0,,Mayroon kaming ebidensya at mga saksi
Dialogue: 0,0:59:08.74,0:59:10.70,pangkalahatang teksto,,0,0,0,,Saksi? Nakakainis ka!
Dialogue: 0,0:59:12.75,0:59:15.75,general text,,0,0,0,,Paano kayo nagkakilala ni Uk?
Dialogue: 0,0:59:18.04,0:59:19.59,general text,,0,0,0,,- Well...\N{\i1}- Madam
Dialogue: 0,0:59:22.76,0:59:24.17,pangkalahatang text,,0,0,0,,Paumanhin sa pakikialam
Dialogue: 0,0:59:25.30,0:59:26.59,general text,,0,0,0,,Pwede ba tayong mag-usap?
Dialogue: 0,0:59:27.84,0:59:29.39,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:59:30.51,0:59:31.97,general text,,0,0,0,,Maaari kang makipag-usap dito
Dialogue: 0,0:59:32.89,0:59:34.93,general text,,0,0,0,,Ito ay personal!
Dialogue: 0,0:59:35.64,0:59:36.64,general text,,0,0,0,,Let's go
Dialogue: 0,0:59:38.23,0:59:40.44,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari sa kanila?
Dialogue: 0,0:59:42.65,0:59:45.82,general text,,0,0,0,,Mukhang seryosong seryoso ang ginoo
Dialogue: 0,0:59:45.90,0:59:47.45,pangkalahatang teksto,,0,0,0,,Iyon lang
Dialogue: 0,0:59:47.53,0:59:50.62,pangkalahatang teksto,,0,0,0,,Paghuhusga sa paraan ng pagsunod ni Yoon Ok,
Dialogue: 0,0:59:50.70,0:59:52.24,general text,,0,0,0,,may something between them
Dialogue: 0,0:59:52.95,0:59:54.79,general text,,0,0,0,,- Ano ito?\N- Sino ang nakakaalam?
Dialogue: 0,1:00:01.29,1:00:03.17,general text,,0,0,0,,susundan ko sila at malalaman
Dialogue: 0,1:00:03.25,1:00:04.38,general text,,0,0,0,,Umupo kaagad!
Dialogue: 0,1:00:05.13,1:00:06.47,pangkalahatang teksto,,0,0,0,,Maupo ka na!
Dialogue: 0,1:00:07.17,1:00:10.47,pangkalahatang teksto,,0,0,0,,Ngunit ito ay kawili-wili sa iyo
Dialogue: 0,1:00:10.55,1:00:12.30,general text,,0,0,0,,Paano ka magiging napakabagal na tao?
Dialogue: 0,1:00:12.97,1:00:14.22,pangkalahatang teksto,,0,0,0,,Wala na siyang pag-asa
Dialogue: 0,1:00:14.81,1:00:16.39,italics,,0,0,0,,Para itong sakit na walang lunas
Dialogue: 0,1:00:16.48,1:00:17.39,pangkalahatang teksto,,0,0,0,,Umupo
Dialogue: 0,1:00:21.27,1:00:24.53,general text,,0,0,0,,Bakit lagi nila akong pinapagalitan?
Dialogue: 0,1:00:30.57,1:00:32.12,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,1:00:33.12,1:00:36.20,general text,,0,0,0,,Nasabi mo na ba sa lahat ang nangyari noong araw na iyon?
Dialogue: 0,1:00:38.75,1:00:40.75,mga alaala,,0,0,0,,Hindi ako komportable sa pagsunod mo sa akin,
Dialogue: 0,1:00:40.83,1:00:42.42,mga alaala,,0,0,0,,at bastos din ito sa iyong panig
Dialogue: 0,1:00:42.50,1:00:43.88,mga alaala,,0,0,0,,Hindi napahanga ang kagandahan
Dialogue: 0,1:00:44.67,1:00:46.88,mga alaala,,0,0,0,,At hindi kita sinunod
Dialogue: 0,1:00:48.34,1:00:49.55,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,1:00:50.26,1:00:52.85,pangkalahatang teksto,,0,0,0,,Hindi ko babanggitin ang isang bagay na nakakahiya
Dialogue: 0,1:00:53.55,1:00:55.14,general text,,0,0,0,,Hindi mo akalain na cute ako
Dialogue: 0,1:00:55.22,1:00:58.56,general text,,0,0,0,,Ang kagandahan ko ay hindi ka napahanga at hindi mo ako sinundan
Dialogue: 0,1:00:59.14,1:01:00.89,pangkalahatang teksto,,0,0,0,,Nahihiya akong isipin ito
Dialogue: 0,1:01:00.98,1:01:02.44,general text,,0,0,0,,Kaya tatahimik ako
Dialogue: 0,1:01:02.52,1:01:03.36,pangkalahatang teksto,,0,0,0,,Meron akong
Dialogue: 0,1:01:04.11,1:01:06.69,pangkalahatang text,,0,0,0,,common sense
Dialogue: 0,1:01:07.32,1:01:09.70,pangkalahatang teksto,,0,0,0,,Hindi, hindi iyon ang sinasabi ko
Dialogue: 0,1:01:10.36,1:01:11.28,pangkalahatang teksto,,0,0,0,,Ang tinutukoy ko ay ang lumulunok ng kaluluwa
Dialogue: 0,1:01:11.36,1:01:14.12,pangkalahatang teksto,,0,0,0,,Ang lumulunok ng kaluluwa na nagtangkang pumatay sa iyo
Dialogue: 0,1:01:14.70,1:01:17.79,pangkalahatang teksto,,0,0,0,,Kaya talagang isang kaluluwang lumulunok?
Dialogue: 0,1:01:17.87,1:01:20.37,pangkalahatang teksto,,0,0,0,,Oo. Ngunit hindi mo maaaring pag-usapan ito
Dialogue: 0,1:01:20.46,1:01:23.83,pangkalahatang teksto,,0,0,0,,Paboran mo ako. Panatilihin itong sikreto
Dialogue: 0,1:01:25.42,1:01:29.17,general text,,0,0,0,,Iniligtas mo ang buhay ko, tutuparin ko ang iyong kahilingan
Dialogue: 0,1:01:30.01,1:01:31.09,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,1:01:31.18,1:01:34.26,pangkalahatang teksto,,0,0,0,,Dahil may iisang sikreto tayo, dapat tayong magpakilala man lang
Dialogue: 0,1:01:34.97,1:01:36.56,pangkalahatang text,,0,0,0,,Ako si Ho Yoon Ok
Dialogue: 0,1:01:37.18,1:01:38.35,pangkalahatang text,,0,0,0,,Ako si Chang Wook
Dialogue: 0,1:01:38.93,1:01:40.85,general text,,0,0,0,,Alam ko. Marami akong narinig
Dialogue: 0,1:01:40.93,1:01:42.73,general text,,0,0,0,,Ako rin. Ang matandang ito...
Dialogue: 0,1:01:42.81,1:01:44.10,pangkalahatang teksto,,0,0,0,,Iyon ay...
Dialogue: 0,1:01:44.19,1:01:47.32,pangkalahatang text,,0,0,0,,Lagi na ipinagyayabang ni Master Ho ang kanyang apo
Dialogue: 0,1:01:47.40,1:01:50.24,general text,,0,0,0,,May sinabi ba si lolo tungkol sa akin?
Dialogue: 0,1:01:52.40,1:01:54.03,general text,,0,0,0,,Mapapahiya ka
Dialogue: 0,1:01:54.62,1:01:55.78,pangkalahatang text,,0,0,0,,Talaga...
Dialogue: 0,1:01:56.78,1:01:59.75,general text,,0,0,0,,lumakad siya at inulit iyon ng kanyang apo.
Dialogue: 0,1:01:59.83,1:02:02.08,general text,,0,0,0,,"maganda, parang magandang diwata." Hindi, tama?
Dialogue: 0,1:02:02.66,1:02:06.04,general text,,0,0,0,,Oo, sinabi niya sa lahat na nasilaw ka sa iyong kagandahan
Dialogue: 0,1:02:06.79,1:02:07.92,pangkalahatang text,,0,0,0,,Hindi ako, sa kasamaang-palad
Dialogue: 0,1:02:12.47,1:02:13.97,general text,,0,0,0,,Awkward talaga
Dialogue: 0,1:02:14.68,1:02:16.22,general text,,0,0,0,,Hindi ako makapaniwala...
Dialogue: 0,1:02:16.30,1:02:17.14,pangkalahatang teksto,,0,0,0,,Itong matandang...
Dialogue: 0,1:02:17.22,1:02:20.72,pangkalahatang teksto,,0,0,0,,Ibig sabihin, si Master Huo ay nagpapakita ng gayong pagmamahal
Dialogue: 0,1:02:20.81,1:02:22.81,pangkalahatang text,,0,0,0,,Ganoon din ang sinabi niya tungkol sa nanay ko
Dialogue: 0,1:02:23.69,1:02:26.36,general text,,0,0,0,,Sabi sa akin kamukha ko daw ang nanay mo.
Dialogue: 0,1:02:27.44,1:02:31.19,general text,,0,0,0,,I think ganito ang hitsura ng mga fairies kay lolo
Dialogue: 0,1:02:37.41,1:02:38.58,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,1:02:39.87,1:02:41.45,pangkalahatang teksto,,0,0,0,,Hindi katulad?
Dialogue: 0,1:02:44.25,1:02:45.50,pangkalahatang text,,0,0,0,,Hindi ko alam
Dialogue: 0,1:02:47.92,1:02:49.42,general text,,0,0,0,,Hindi ko pa siya nakita
Dialogue: 0,1:02:58.43,1:03:00.18,general text,,0,0,0,,At paano ako makakatagpo ng isang diwata?
Dialogue: 0,1:03:00.26,1:03:01.64,pangkalahatang teksto,,0,0,0,,Mahirap sabihin
Dialogue: 0,1:03:03.93,1:03:05.85,general text,,0,0,0,,Matino ka ba?
Dialogue: 0,1:03:05.94,1:03:09.73,pangkalahatang teksto,,0,0,0,,Oo. Narinig kong nasa paligid ka buong gabi
Dialogue: 0,1:03:11.11,1:03:12.40,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:03:12.48,1:03:15.82,general text,,0,0,0,,Akala ko si Moo Deok. Paumanhin
Dialogue: 0,1:03:19.28,1:03:22.33,pangkalahatang teksto,,0,0,0,,Gumawa ako ng tsaa na may mga halamang gamot
Dialogue: 0,1:03:34.01,1:03:35.72,general text,,0,0,0,,Sana uminom siya
Dialogue: 0,1:03:37.76,1:03:39.34,mga inskripsiyon,,0,0,0,,Saejukwon
Dialogue: 0,1:03:39.43,1:03:41.56,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,1:03:43.22,1:03:44.68,general text,,0,0,0,,Nakita mo na ba si Moo Dok?
Dialogue: 0,1:03:44.77,1:03:47.14,pangkalahatang text,,0,0,0,,Siya ay sumama sa akin kahapon, ngunit wala siya saanman
Dialogue: 0,1:03:47.73,1:03:48.73,general text,,0,0,0,,Umuwi siya
Dialogue: 0,1:03:50.90,1:03:53.57,general text,,0,0,0,,Bakit siya umalis ng wala ako?
Dialogue: 0,1:03:54.53,1:03:57.07,general text,,0,0,0,,Iniwan ang lasing mong may-ari at umuwi?
Dialogue: 0,1:03:57.15,1:04:00.07,pangkalahatang teksto,,0,0,0,,Ngayon ang mga lingkod ni Sosnovy Bor ang bahala sa iyo
Dialogue: 0,1:04:00.16,1:04:03.24,general text,,0,0,0,,Hindi sa amin si Moo Dok, hindi siya makakapunta dito
Dialogue: 0,1:04:05.75,1:04:06.96,pangkalahatang text,,0,0,0,,Teka...
Dialogue: 0,1:04:10.63,1:04:12.09,italics,,0,0,0,,Naisip ni Moo Dok,
Dialogue: 0,1:04:12.17,1:04:15.71,pangkalahatang teksto,,0,0,0,,maaari niyang sundan ang Uk sa Sosnovy Bor
Dialogue: 0,1:04:16.92,1:04:19.89,general text,,0,0,0,,I'm sure naisip niya kung paano ka niya makikita araw-araw
Dialogue: 0,1:04:19.97,1:04:21.47,pangkalahatang text,,0,0,0,,Marahil ay nagagalit
Dialogue: 0,1:04:34.40,1:04:37.61,pangkalahatang teksto,,0,0,0,,Oo. Sana ok lang siya
Dialogue: 0,1:04:41.07,1:04:42.49,pangkalahatang teksto,,0,0,0,,Malamang, nalaman ni Uk
Dialogue: 0,1:04:43.33,1:04:44.74,italics,,0,0,0,,Tiyak na pupunta siya sa kanyang tiyuhin
Dialogue: 0,1:04:44.83,1:04:46.87,pangkalahatang text,,0,0,0,,Hindi ito papayagan ni Uncle
Dialogue: 0,1:04:50.75,1:04:54.67,pangkalahatang teksto,,0,0,0,,Wala ni isang salamangkero ang may personal na kasambahay
Dialogue: 0,1:04:55.55,1:04:58.01,pangkalahatang teksto,,0,0,0,,At ikaw ay walang exception
Dialogue: 0,1:04:58.09,1:04:59.13,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,1:04:59.72,1:05:02.43,general text,,0,0,0,,Bilang exception, pinaalis mo ako dito 20 taon na ang nakakaraan
Dialogue: 0,1:05:04.26,1:05:05.97,pangkalahatang teksto,,0,0,0,,Bakit hindi gumawa ng isa pang exception?
Dialogue: 0,1:05:07.35,1:05:10.52,general text,,0,0,0,,Lahat dahil tinuruan ka ni Tansu
Dialogue: 0,1:05:12.69,1:05:14.11,pangkalahatang teksto,,0,0,0,,sa labas ng mga pader na ito?
Dialogue: 0,1:05:17.07,1:05:18.74,pangkalahatang teksto,,0,0,0,,Kailangan mo si Moo Dok,
Dialogue: 0,1:05:19.40,1:05:22.28,pangkalahatang teksto,,0,0,0,,upang makipag-ugnayan sa guro?
Dialogue: 0,1:05:23.57,1:05:26.37,general text,,0,0,0,,Kinumpirma na ni Master Li na sinanay ko ang aking sarili
Dialogue: 0,1:05:27.58,1:05:30.21,general text,,0,0,0,,Iniligtas ka niya, pero nagtsitsismisan pa rin ang mga tao
Dialogue: 0,1:05:30.71,1:05:32.12,general text,,0,0,0,,May nag-iisip pa,
Dialogue: 0,1:05:32.96,1:05:35.71,pangkalahatang teksto,,0,0,0,,kung ano ang itinuro sa iyo ng iyong ama na si Chang Gan
Dialogue: 0,1:05:38.05,1:05:40.51,general text,,0,0,0,,Noong una sinabi ng mga tao na hindi niya ako anak
Dialogue: 0,1:05:41.88,1:05:43.89,general text,,0,0,0,,Ngayon nagdadaldalan sila na tinuruan ako ng tatay ko?
Dialogue: 0,1:05:45.76,1:05:49.52,pangkalahatang text,,0,0,0,,Kapag nangyari ang mga exception, nagsimulang makipag-chat ang mga tao
Dialogue: 0,1:05:50.43,1:05:53.52,pangkalahatang teksto,,0,0,0,,Mabilis mong pinagkadalubhasaan si Ryusu at ginamit ang Tansu
Dialogue: 0,1:05:54.48,1:05:56.52,pangkalahatang teksto,,0,0,0,,Ito ay masyadong kakaiba
Dialogue: 0,1:05:59.48,1:06:00.69,pangkalahatang teksto,,0,0,0,,Ikaw...
Dialogue: 0,1:06:01.65,1:06:03.86,pangkalahatang teksto,,0,0,0,,sinusubukang makaakit ng atensyon,
Dialogue: 0,1:06:05.32,1:06:07.12,pangkalahatang teksto,,0,0,0,,pinipilit ang mga tao na pag-usapan ang kanilang sarili?
Dialogue: 0,1:06:09.91,1:06:13.00,offscreen,,0,0,0,,Hindi mo maaaring hayaan ang ulo na maghinala kay Moo Deok
Dialogue: 0,1:06:13.08,1:06:14.92,offscreen,,0,0,0,,Kung hindi ay malalaman niya na siya ay isang nomad
Dialogue: 0,1:06:16.46,1:06:19.30,pangkalahatang teksto,,0,0,0,,Okay, naiintindihan ko na laban ka
Dialogue: 0,1:06:21.30,1:06:24.72,general text,,0,0,0,,So susunod ka na lang sa rules?
Dialogue: 0,1:06:24.80,1:06:25.80,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:06:26.47,1:06:28.26,pangkalahatang text,,0,0,0,,Nakarating ako dito sa sobrang hirap
Dialogue: 0,1:06:28.35,1:06:32.39,pangkalahatang text,,0,0,0,,I can't risk it for some maid
Dialogue: 0,1:06:46.82,1:06:49.87,general text,,0,0,0,,Gusto kong bumili ng spirit amulet sa black market
Dialogue: 0,1:06:50.99,1:06:52.25,pangkalahatang teksto,,0,0,0,,Hanapin ako ng isa
Dialogue: 0,1:06:52.33,1:06:55.42,general text,,0,0,0,,Paano mo ito mahihiling kung ang isa ay napatay dahil sa anting-anting?
Dialogue: 0,1:06:55.50,1:06:59.59,general text,,0,0,0,,Pag nahuli ka, papatayin ka rin nila
Dialogue: 0,1:06:59.67,1:07:03.84,general text,,0,0,0,,Ako dapat ang katabi niya. Kailangan ako ng may-ari
Dialogue: 0,1:07:03.92,1:07:06.80,pangkalahatang teksto,,0,0,0,,Hindi naman. Hindi ka na niya kailangan
Dialogue: 0,1:07:07.55,1:07:10.72,general text,,0,0,0,,Kinailangan ka noong tumakas siyang mag-isa at nagsanay
Dialogue: 0,1:07:10.81,1:07:13.39,general text,,0,0,0,,At ngayon ay nasa Jeonjingak na siya
Dialogue: 0,1:07:13.48,1:07:15.56,pangkalahatang teksto,,0,0,0,,Maraming iba pang katulong doon
Dialogue: 0,1:07:16.14,1:07:17.85,general text,,0,0,0,,Tutulungan din siya ng mga magician ni Sosnovy Bor
Dialogue: 0,1:07:17.94,1:07:20.36,general text,,0,0,0,,Wala ka nang magagawa para sa kanya
Dialogue: 0,1:07:20.44,1:07:22.11,general text,,0,0,0,,Bakit ka niya kailangan?
Dialogue: 0,1:07:28.87,1:07:31.99,pangkalahatang teksto,,0,0,0,,Ipinagkatiwala sa akin ng ulo na ituro sa iyo ang mga pangunahing kaalaman
Dialogue: 0,1:07:32.08,1:07:35.37,pangkalahatang teksto,,0,0,0,,karangalan kong maging guro mo
Dialogue: 0,1:07:36.54,1:07:39.00,pangkalahatang text,,0,0,0,,Asa sa iyo
Dialogue: 0,1:07:42.13,1:07:44.13,pangkalahatang teksto,,0,0,0,,Ito ay isang hanay ng mga panuntunan para kay Jeongjingak
Dialogue: 0,1:07:44.21,1:07:48.18,pangkalahatang teksto,,0,0,0,,Mula sa mga aklat na ito matututunan mo ang tungkol sa mga kabutihan ng mga salamangkero, gayundin ang lahat ng mga pagbabawal
Dialogue: 0,1:07:48.80,1:07:50.01,pangkalahatang text,,0,0,0,,Hindi mo kaya
Dialogue: 0,1:07:50.10,1:07:52.89,general text,,0,0,0,,umalis sa lugar na ito hanggang sa matutunan mo ang lahat
Dialogue: 0,1:07:54.98,1:07:57.14,pangkalahatang teksto,,0,0,0,,Oo. Susunod ako sa rules
Dialogue: 0,1:07:57.77,1:07:59.02,pangkalahatang text,,0,0,0,,Maaari kang magsimula
Dialogue: 0,1:08:00.06,1:08:01.23,pangkalahatang teksto,,0,0,0,,basahin
Dialogue: 0,1:08:08.61,1:08:09.66,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,1:08:11.95,1:08:13.03,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,1:08:13.66,1:08:15.20,general text,,0,0,0,,Paano ka nakapasok?
Dialogue: 0,1:08:18.16,1:08:19.75,general text,,0,0,0,,Akala ko sarado ka na ulit
Dialogue: 0,1:08:19.83,1:08:22.34,pangkalahatang teksto,,0,0,0,,sa lihim na silid para sa pagsuway sa ulo
Dialogue: 0,1:08:23.21,1:08:25.42,general text,,0,0,0,,Pero nandito ka sa training room
Dialogue: 0,1:08:26.46,1:08:28.43,general text,,0,0,0,,I'm proud of you
Dialogue: 0,1:08:28.51,1:08:31.47,pangkalahatang teksto,,0,0,0,,Lingkod Kim, maipagmamalaki mo ang iyong sarili
Dialogue: 0,1:08:32.22,1:08:33.72,general text,,0,0,0,,Pinalaki mong mabuti itong ginoo
Dialogue: 0,1:08:36.60,1:08:39.89,pangkalahatang teksto,,0,0,0,,Kapansin-pansin na mababa ang mga talahanayan
Dialogue: 0,1:08:42.86,1:08:44.52,pangkalahatang teksto,,0,0,0,,At ang mga upuan ay hindi komportable
Dialogue: 0,1:08:45.23,1:08:47.03,pangkalahatang teksto,,0,0,0,,Nasa itaas ako sa iba
Dialogue: 0,1:08:47.11,1:08:48.82,pangkalahatang text,,0,0,0,,at hindi ako komportable
Dialogue: 0,1:08:48.90,1:08:52.12,general text,,0,0,0,,Ngunit walang magagawa, ito ang mga patakaran
Dialogue: 0,1:08:55.12,1:08:59.75,general text,,0,0,0,,Ano ang relasyon niyo ni Mrs. Ho?
Dialogue: 0,1:08:59.83,1:09:01.71,general text,,0,0,0,,Ano ang pinag-usapan ninyo sa kanya?
Dialogue: 0,1:09:01.79,1:09:04.29,pangkalahatang teksto,,0,0,0,,Walang espesyal
Dialogue: 0,1:09:07.13,1:09:10.51,pangkalahatang teksto,,0,0,0,,Kailangan kong basahin ang lahat ng aklat na ito. Oras na para sa iyo, maid Kim
Dialogue: 0,1:09:10.59,1:09:13.85,pangkalahatang teksto,,0,0,0,,Kailangan mo ba ng tinta bago ang klase?
Dialogue: 0,1:09:14.43,1:09:17.72,pangkalahatang teksto,,0,0,0,,Hindi, kailangan kong gawin ang lahat sa aking sarili
Dialogue: 0,1:09:17.81,1:09:19.02,pangkalahatang teksto,,0,0,0,,Ito ang mga patakaran
Dialogue: 0,1:09:19.10,1:09:20.77,pangkalahatang teksto,,0,0,0,,Mga Panuntunan. nakikita ko
Dialogue: 0,1:09:21.73,1:09:22.94,pangkalahatang text,,0,0,0,,Okay
Dialogue: 0,1:09:24.06,1:09:27.19,general text,,0,0,0,,Pupunta ako. See you later
Dialogue: 0,1:09:28.11,1:09:29.28,pangkalahatang teksto,,0,0,0,,Dalagang Kim,
Dialogue: 0,1:09:31.11,1:09:34.70,general text,,0,0,0,,ingatan mo si Moo Deok. Malamang nag-aalala siya
Dialogue: 0,1:09:34.78,1:09:37.29,general text,,0,0,0,,Bakit siya mag-aalala kung ayos lang kayo?
Dialogue: 0,1:09:37.37,1:09:38.37,general text,,0,0,0,,I think she's happy
Dialogue: 0,1:09:40.00,1:09:42.67,general text,,0,0,0,,Sobrang nagdusa siya dahil sayo
Dialogue: 0,1:09:42.75,1:09:46.21,general text,,0,0,0,,Mapili ka sa pagkain, kailangan niyang magluto ng tatlong beses,
Dialogue: 0,1:09:46.29,1:09:49.17,general text,,0,0,0,,nung kasama mo siya sa bundok. May dalang tubig para sa paliligo
Dialogue: 0,1:09:49.26,1:09:52.43,pangkalahatang teksto,,0,0,0,,Labahan ang iyong mga damit. Alam mo ba kung gaano karaming trabaho ito?
Dialogue: 0,1:09:55.14,1:09:57.10,general text,,0,0,0,,Nahirapan talaga si Moo Dok
Dialogue: 0,1:09:57.18,1:10:01.39,general text,,0,0,0,,Dadalhin ko siya para makita ang mga bulaklak at bumili ng masarap
Dialogue: 0,1:10:01.98,1:10:03.69,general text,,0,0,0,,ako na ang bahala sa kanya
Dialogue: 0,1:10:03.77,1:10:06.31,general text,,0,0,0,,Magiging kalmado siya kung wala ka
Dialogue: 0,1:10:09.98,1:10:11.19,pangkalahatang teksto,,0,0,0,,Sa tingin mo?
Dialogue: 0,1:10:19.62,1:10:21.87,behind the scenes,,0,0,0,,Naabot na ni Chan Wook ang kanyang layunin
Dialogue: 0,1:10:22.37,1:10:24.87,voiceover,,0,0,0,,Baka hindi na niya talaga ako kailangan
Dialogue: 0,1:10:25.58,1:10:27.54,behind the scenes,,0,0,0,,Nag-iwan siya ng 12 guro
Dialogue: 0,1:10:28.34,1:10:31.46,pangkalahatang text,,0,0,0,,Lasunin na sana natin siya at nakahanap ng mai-blackmail sa kanya.
Dialogue: 0,1:10:32.05,1:10:33.93,general text,,0,0,0,,Nagtiwala ako sa kanya ng sobra
Dialogue: 0,1:10:34.51,1:10:36.55,italics,,0,0,0,,Moo Dok!
Dialogue: 0,1:10:37.39,1:10:38.39,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,1:10:38.97,1:10:40.35,general text,,0,0,0,,May anting-anting ka ba?
Dialogue: 0,1:10:40.43,1:10:43.35,pangkalahatang text,,0,0,0,,Hindi ko ito magagawa. Ngunit ngayon maaari kang makapasa sa pagsusulit
Dialogue: 0,1:10:44.06,1:10:46.02,general text,,0,0,0,,Gusto mo bang makapasa ako sa magician exam?
Dialogue: 0,1:10:46.65,1:10:48.69,general text,,0,0,0,,Nababaliw ka na ba? Huwag magsalita ng kalokohan
Dialogue: 0,1:10:49.44,1:10:52.40,pangkalahatang teksto,,0,0,0,,Nagsagawa ng pagsusulit si Sosnovy Bor hindi para sa mga salamangkero
Dialogue: 0,1:10:52.49,1:10:55.45,general text,,0,0,0,,May competition pa sila dun dahil sa matinding competition.
Dialogue: 0,1:10:55.53,1:10:56.91,pangkalahatang teksto,,0,0,0,,Kumpetisyon?
Dialogue: 0,1:10:56.99,1:10:58.74,pangkalahatang teksto,,0,0,0,,Pag-hire ng mga katulong sa Sosnovy Bor
Dialogue: 0,1:10:58.83,1:11:01.54,general text,,0,0,0,,Kaya kumuha na lang sila ng mga katulong
Dialogue: 0,1:11:01.62,1:11:03.96,general text,,0,0,0,,Moo Dok, ikaw ang katulong
Dialogue: 0,1:11:04.79,1:11:08.13,pangkalahatang teksto,,0,0,0,,Oo, alam ko. Pero hindi ako ordinaryong maid
Dialogue: 0,1:11:08.21,1:11:09.46,general text,,0,0,0,,Tumanggi ako
Dialogue: 0,1:11:10.09,1:11:12.34,general text,,0,0,0,,Bakit magagalit?
Dialogue: 0,1:11:12.42,1:11:14.26,general text,,0,0,0,,Alam mo ba kung gaano kahirap makarating doon?
Dialogue: 0,1:11:17.18,1:11:19.26,general text,,0,0,0,,Moo Dok, mukha kang pagod
Dialogue: 0,1:11:19.35,1:11:20.93,pangkalahatang text,,0,0,0,,Kumain bago ka umalis
Dialogue: 0,1:11:26.81,1:11:27.98,pangkalahatang text,,0,0,0,,Maiden Kim
Dialogue: 0,1:11:28.06,1:11:30.52,general text,,0,0,0,,Taga-Sosnovy Bor ka ba? Nakita mo na ba ang may-ari?
Dialogue: 0,1:11:30.61,1:11:33.49,pangkalahatang teksto,,0,0,0,,Oo. nakita ko na. Ayos naman siya
Dialogue: 0,1:11:34.19,1:11:36.65,general text,,0,0,0,,Anong gusto niyang gawin ko ngayon?
Dialogue: 0,1:11:36.74,1:11:37.99,general text,,0,0,0,,Kailan siya pupunta para sa akin?
Dialogue: 0,1:11:38.07,1:11:40.16,pangkalahatang teksto,,0,0,0,,Gusto mong mamuhay ng maayos dito
Dialogue: 0,1:11:40.24,1:11:42.41,pangkalahatang teksto,,0,0,0,,Hinahangaan ang mga bulaklak, kumain ng matamis
Dialogue: 0,1:11:43.33,1:11:47.79,general text,,0,0,0,,Hangaan daw ang mga bulaklak at kumain ng matatamis?
Dialogue: 0,1:11:47.87,1:11:48.96,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:11:53.30,1:11:55.88,general text,,0,0,0,,Hindi ba niya sinabi kung kailan siya pupunta para makipagkita sa akin?
Dialogue: 0,1:11:55.97,1:11:58.26,general text,,0,0,0,,Ayon sa rules, hindi siya pwedeng umalis
Dialogue: 0,1:11:59.09,1:12:01.51,pangkalahatang teksto,,0,0,0,,Desidido siyang sundin ang mga tuntunin,
Dialogue: 0,1:12:01.60,1:12:04.18,general text,,0,0,0,,Hindi na ako nag-aalala sa kanya
Dialogue: 0,1:12:06.94,1:12:09.98,behind the scenes,,0,0,0,,I think hindi na ako kailangan ni Uku
Dialogue: 0,1:12:12.19,1:12:13.27,pangkalahatang teksto,,0,0,0,,Mu Dok,
Dialogue: 0,1:12:14.53,1:12:18.95,general text,,0,0,0,,at hindi mo alam kung sino ang gusto ng ating amo?
Dialogue: 0,1:12:20.74,1:12:22.74,general text,,0,0,0,,Baka ito yung babaeng nakita ko sa Sosnovy Bor
Dialogue: 0,1:12:22.83,1:12:25.91,pangkalahatang teksto,,0,0,0,,Babae? May nililigawan ba siya?
Dialogue: 0,1:12:26.00,1:12:27.96,general text,,0,0,0,,Well, sinabi niya sa akin,
Dialogue: 0,1:12:28.54,1:12:30.75,pangkalahatang teksto,,0,0,0,,na ang kanyang puso ay pag-aari ng isang babae,
Dialogue: 0,1:12:30.83,1:12:34.09,pangkalahatang teksto,,0,0,0,,na parang itlog ng ibon sa tuktok ng puno
Dialogue: 0,1:12:43.18,1:12:46.77,italics,,0,0,0,,At wala rin siyang iba maliban sa kanya
Dialogue: 0,1:12:48.27,1:12:51.15,italics,,0,0,0,,Naiisip ko kung gaano siya nag-aalala at nagmamalasakit sa kanya
Dialogue: 0,1:12:51.23,1:12:54.07,general text,,0,0,0,,Kapag ang lalaki ay nag-aalaga ng babae, ano sa tingin mo ang ibig sabihin nito?
Dialogue: 0,1:12:56.32,1:12:57.69,general text,,0,0,0,,Ibig sabihin in love siya
Dialogue: 0,1:13:01.24,1:13:03.37,pangkalahatang text,,0,0,0,,Pero ako ito
Dialogue: 0,1:13:09.16,1:13:10.42,mga alaala na italics,,0,0,0,,May mga itlog ng ibon
Dialogue: 0,1:13:10.50,1:13:14.63,alaala,,0,0,0,,Guro, manatiling tapat tayo sa isa't isa
Dialogue: 0,1:13:21.05,1:13:22.76,memories italics,,0,0,0,,muntik na akong mamatay salamat sa iyo,
Dialogue: 0,1:13:22.84,1:13:24.18,mga alaala,,0,0,0,,ang baliw kong amo
Dialogue: 0,1:13:28.10,1:13:31.85,memories italics,,0,0,0,,Magtatagal ang relasyon nating guro-estudyante hanggang sa maging pinakamahusay ka,
Dialogue: 0,1:13:31.94,1:13:34.48,mga alaala na italics,,0,0,0,,upang matulungan akong maibalik ang aking lakas
Dialogue: 0,1:13:35.61,1:13:38.53,memories italics,,0,0,0,,Nang makabawi ako ng lakas at naging Nak Su muli,
Dialogue: 0,1:13:39.03,1:13:40.99,mga alaala,,0,0,0,,hindi na tayo magiging guro at estudyante
Dialogue: 0,1:13:42.45,1:13:44.45,memories italics,,0,0,0,,Pwede ko bang malaman kung bakit?
Dialogue: 0,1:13:45.66,1:13:48.70,memories italics,,0,0,0,,Dahil wala ka nang dahilan para protektahan ako
Dialogue: 0,1:13:50.12,1:13:51.71,mga alaala na italics,,0,0,0,,At wala akong dahilan
Dialogue: 0,1:13:55.08,1:13:56.34,mga alaala na italics,,0,0,0,,upang maging maluwag sa iyo
Dialogue: 0,1:13:57.38,1:13:59.34,mga alaala,,0,0,0,,Guro! Ako ito, Chan Wook
Dialogue: 0,1:14:17.15,1:14:18.82,pangkalahatang teksto,,0,0,0,,So ano ang gagawin?
Dialogue: 0,1:14:20.03,1:14:21.53,pangkalahatang teksto,,0,0,0,,Lahat ay masama
Dialogue: 0,1:14:27.16,1:14:28.16,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,1:14:30.08,1:14:31.37,general text,,0,0,0,,Miss na kita
Dialogue: 0,1:15:06.44,1:15:08.24,preview,,0,0,0,,Hindi ako magtuturo kay Uka
Dialogue: 0,1:15:08.32,1:15:12.04,preview,,0,0,0,,Kaya hindi mo siya kinuha sa ilalim ng iyong pakpak, ikinulong mo lang siya dito
Dialogue: 0,1:15:12.12,1:15:13.62,preview,,0,0,0,,Tulong!
Dialogue: 0,1:15:15.08,1:15:16.71,preview,,0,0,0,,Siguradong si Moo Deok iyon!
Dialogue: 0,1:15:16.79,1:15:19.25,preview,,0,0,0,,Bakit kailangan niya laging nasa ibang lugar?
Dialogue: 0,1:15:19.34,1:15:20.42,preview,,0,0,0,,Guro!
Dialogue: 0,1:15:21.34,1:15:25.38,preview,,0,0,0,,Bakit sulat? Hangga't ito ay naglalahad ng iyong nararamdaman...
Dialogue: 0,1:15:25.47,1:15:30.14,preview,,0,0,0,,In love na ang gentleman sa isang tao
Dialogue: 0,1:15:30.22,1:15:32.02,preview,,0,0,0,,Mas mahirap ito kaysa sa inaakala ko
Dialogue: 0,1:15:32.10,1:15:34.02,preview,,0,0,0,,Your Highness!
Dialogue: 0,1:15:34.10,1:15:36.02,preview,,0,0,0,,Lagi siyang nasa tabi ng Uk
Dialogue: 0,1:15:36.10,1:15:39.31,preview,,0,0,0,,Kailangan mong subukang basahin kung ano ang hindi mo nakikita
Dialogue: 0,1:15:39.40,1:15:40.82,preview,,0,0,0,,Moo Dok
