Dialogue: 0,0:02:51.39,0:02:53.39,الألقاب,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee, Zero_Amamiya
Dialogue: 0,0:01:04.34,0:01:06.39,ذكريات,,0,0,0,,يول من عائلة سو
Dialogue: 0,0:01:08.10,0:01:09.68,ذكريات,,0,0,0,,لا تعود إلى هنا
Dialogue: 0,0:01:16.06,0:01:17.48,ذكريات,,0,0,0,,سوف تأتي مرة أخرى -
Dialogue: 0,0:01:18.90,0:01:20.53,ذكريات,,0,0,0,,سأقتلك
Dialogue: 0,0:01:25.99,0:01:26.82,ذكريات,,0,0,0,,انتظر...
Dialogue: 0,0:01:52.85,0:01:55.69,التعليق الصوتي,,0,0,0,,لم أستطع إيقافها
Dialogue: 0,0:01:57.10,0:01:58.94,خلف الكواليس,,0,0,0,,لم أستطع أن أسأل لماذا
Dialogue: 0,0:02:00.19,0:02:03.44,التعليق الصوتي,,0,0,0,,عندما قطعت صدقي إلى أجزاء،
Dialogue: 0,0:02:04.86,0:02:07.53,خلف الكواليس,,0,0,0,,توقفت عن الاعتزاز بذكرياتنا
Dialogue: 0,0:02:08.82,0:02:11.45,التعليق الصوتي,,0,0,0,,كل شيء أصبح سراً يجب أن أحفظه في قلبي
Dialogue: 0,0:02:17.79,0:02:21.21,نص عام,,0,0,0,,لقد استيقظت باكراً. ما الذي تفعله هنا؟
Dialogue: 0,0:02:25.51,0:02:26.80,نص عام,,0,0,0,,لماذا أنت
Dialogue: 0,0:02:27.80,0:02:29.26,نص عام,,0,0,0,,أتى إلى هنا؟
Dialogue: 0,0:02:32.01,0:02:34.35,نص عام,,0,0,0,,امسك الطائر. سأجهزها لك
Dialogue: 0,0:02:37.23,0:02:38.73,نص عام,,0,0,0,,الطعام لا يجلب لي السعادة
Dialogue: 0,0:02:38.81,0:02:40.77,نص عام,,0,0,0,,سأطبخ الأرز بالكستناء
Dialogue: 0,0:02:41.90,0:02:44.15,نص عام,,0,0,0,,الكستناء هنا حلوة جداً
Dialogue: 0,0:02:48.03,0:02:50.82,نص عام,,0,0,0,,هناك كستناء حلوة جدًا في دانهيانجك
Dialogue: 0,0:03:04.00,0:03:05.46,نص عام,,0,0,0,,وأنا لا أحب الحلويات أيضاً
Dialogue: 0,0:03:08.80,0:03:11.01,نص عام,,0,0,0,,يمكنك فقط الرفض
Dialogue: 0,0:03:11.09,0:03:13.47,النص العام,,0,0,0,,بقوتك كان من الممكن أن أموت
Dialogue: 0,0:03:16.02,0:03:17.43,نص عام,,0,0,0,,لا تبالغ
Dialogue: 0,0:03:18.39,0:03:21.73,general text,,0,0,0,,لقد دفعتك، لكنني لم أنوي قتلك.
Dialogue: 0,0:03:21.81,0:03:23.40,نص عام,,0,0,0,,لكنهم دفعوا
Dialogue: 0,0:03:24.02,0:03:25.94,نص عام,,0,0,0,,لا داعي للقلق بشأن وجبة الإفطار
Dialogue: 0,0:03:26.03,0:03:27.49,نص عام,,0,0,0,,سأغادر عندما يستيقظ دان جو
Dialogue: 0,0:03:27.57,0:03:30.11,نص عام,,0,0,0,,لا تريده كما تريد
Dialogue: 0,0:03:46.76,0:03:48.13,نص عام,,0,0,0,,لماذا لا تزال هنا؟
Dialogue: 0,0:03:50.01,0:03:51.26,نص عام,,0,0,0,,سآكل قبل الرحيل
Dialogue: 0,0:03:51.84,0:03:52.93,نص عام,,0,0,0,,اطبخ بعض الطعام
Dialogue: 0,0:03:53.01,0:03:54.64,نص عام,,0,0,0,,ظننت أنك لا تريد
Dialogue: 0,0:03:55.22,0:03:57.52,نص عام,,0,0,0,,لم أقل ذلك. لا تفتري
Dialogue: 0,0:04:00.23,0:04:04.56,general text,,0,0,0,,لقد شربت كثيرًا بالأمس، اعتقدت أنك ستشعر بالسوء في الصباح
Dialogue: 0,0:04:04.65,0:04:07.19,نص عام,,0,0,0,,رفضت حتى لا أزعجك
Dialogue: 0,0:04:08.28,0:04:09.49,نص عام,,0,0,0,,مفهوم
Dialogue: 0,0:04:10.28,0:04:11.45,نص عام,,0,0,0,,ثم
Dialogue: 0,0:04:11.53,0:04:14.12,النص العام,,0,0,0,,- نحتاج إلى غسل المزيد من الأرز\N- أين هو؟
Dialogue: 0,0:04:14.78,0:04:17.49,النص العام,,0,0,0,,- سأغسل\N- هل طبخت الأرز من قبل؟
Dialogue: 0,0:04:17.58,0:04:20.87,نص عام,,0,0,0,,لا، لكني أستطيع إذا علمتني
Dialogue: 0,0:04:22.00,0:04:23.42,نص عام,,0,0,0,,الأمر بسيط جدًا
Dialogue: 0,0:04:24.08,0:04:27.55,النص العام,,0,0,0,,اشطف الأرز في الماء، وأضف كمية كافية من الماء.
Dialogue: 0,0:04:27.63,0:04:29.09,نص عام,,0,0,0,,ويطهى على نار عالية
Dialogue: 0,0:04:29.92,0:04:32.09,نص عام,,0,0,0,,ثم دع الأمر يقف
Dialogue: 0,0:04:33.43,0:04:35.14,نص عام,,0,0,0,,بسيط جدًا
Dialogue: 0,0:04:43.85,0:04:46.31,نص عام,,0,0,0,,قلت أنك تستطيع لو شرحت ذلك
Dialogue: 0,0:04:46.40,0:04:48.11,نص عام,,0,0,0,,هم أنفسهم قالوا أن الأمر سهل
Dialogue: 0,0:04:49.65,0:04:52.74,نص عام,,0,0,0,,لقد كنت مخطئًا. أنا آسف
Dialogue: 0,0:04:53.49,0:04:55.95,نص عام,,0,0,0,,انظر إلى هذا
Dialogue: 0,0:04:56.03,0:04:57.62,نص عام,,0,0,0,,لقد احترق في كل مكان
Dialogue: 0,0:04:58.41,0:05:00.50,نص عام,,0,0,0,,دعني أعوض
Dialogue: 0,0:05:02.08,0:05:03.62,نص عام,,0,0,0,,وتلك الخضار
Dialogue: 0,0:05:03.71,0:05:05.13,نص عام,,0,0,0,,تعليم كيفية تقطيع الخضار
Dialogue: 0,0:05:09.96,0:05:12.72,نص عام,,0,0,0,,- ارميها بعيدًا الآن\N- واو
Dialogue: 0,0:05:19.60,0:05:20.93,نص عام,,0,0,0,,دان جو
Dialogue: 0,0:05:22.06,0:05:22.93,نص عام,,0,0,0,,يا
Dialogue: 0,0:05:23.52,0:05:25.19,نص عام,,0,0,0,,اسبح قبل الرحيل
Dialogue: 0,0:05:25.27,0:05:27.15,النص العام,,0,0,0,,المياه المعدنية ستجعل بشرتك أكثر نعومة
Dialogue: 0,0:05:27.23,0:05:28.82,نص عام,,0,0,0,,وتناول الفطور
Dialogue: 0,0:05:28.90,0:05:30.23,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:05:30.32,0:05:32.44,النص العام,,0,0,0,,مو دوك ويول يعدان الإفطار معًا
Dialogue: 0,0:05:33.36,0:05:34.74,نص عام,,0,0,0,,- معًا؟\N- نعم
Dialogue: 0,0:05:34.82,0:05:37.12,نص عام,,0,0,0,,يول يطبخ الأرز مع مو دوك
Dialogue: 0,0:05:49.54,0:05:53.17,نص عام,,0,0,0,,قلت لك أن تقطع البصل إلى قطع كبيرة
Dialogue: 0,0:05:58.18,0:05:59.26,النص العام,,0,0,0,,- هل هذه كبيرة؟\N- لا
Dialogue: 0,0:05:59.93,0:06:02.47,نص عام,,0,0,0,,أنت لا تعرف معنى كلمة "كبير"؟
Dialogue: 0,0:06:02.56,0:06:04.14,نص عام,,0,0,0,,قطع كبيرة
Dialogue: 0,0:06:06.56,0:06:08.27,نص عام,,0,0,0,,كبير...
Dialogue: 0,0:06:08.36,0:06:09.65,نص عام,,0,0,0,,ليس نفسه
Dialogue: 0,0:06:09.73,0:06:11.44,نص عام,,0,0,0,,وهذه أيضًا صغيرة
Dialogue: 0,0:06:13.19,0:06:14.15,نص عام,,0,0,0,,معجبون بهذا
Dialogue: 0,0:06:14.82,0:06:18.16,نص عام,,0,0,0,,قطع كبيرة. مثل هذا
Dialogue: 0,0:06:19.32,0:06:22.29,نص عام,,0,0,0,,كان يجب أن أشرحه بشكل صحيح
Dialogue: 0,0:06:22.37,0:06:25.29,general text,,0,0,0,,كيف كان من المفترض أن أفهم "قطعك الكبيرة"؟
Dialogue: 0,0:06:25.37,0:06:27.71,النص العام,,0,0,0,,اعتقدت أنك أفضل ساحر في جيونجينغاك
Dialogue: 0,0:06:27.79,0:06:31.25,نص عام,,0,0,0,,لا أستطيع التمييز بين الكبير والصغير؟
Dialogue: 0,0:06:32.46,0:06:33.38,خط مائل,,0,0,0,,انسى
Dialogue: 0,0:06:33.46,0:06:35.88,نص عام,,0,0,0,,اسكب الماء في وعاء
Dialogue: 0,0:06:43.72,0:06:44.68,نص عام,,0,0,0,,انتظر...
Dialogue: 0,0:06:45.48,0:06:47.44,نص عام,,0,0,0,,عن أي وعاء تتحدث؟
Dialogue: 0,0:06:49.48,0:06:50.48,نص عام,,0,0,0,,هذه؟
Dialogue: 0,0:06:54.03,0:06:55.07,نص عام,,0,0,0,,أم هذا؟
Dialogue: 0,0:06:55.82,0:06:56.70,نص عام,,0,0,0,,هذا؟
Dialogue: 0,0:06:59.45,0:07:00.74,نص عام,,0,0,0,,هنا
Dialogue: 0,0:07:06.91,0:07:09.83,general text,,0,0,0,,لماذا يبدو أن مو دوك يوبخه؟
Dialogue: 0,0:07:10.63,0:07:12.09,general text,,0,0,0,,هل أنت متأكد من أنها معجبة به؟
Dialogue: 0,0:07:12.17,0:07:13.63,نص عام,,0,0,0,,هذا هو هذا النوع من الفتيات
Dialogue: 0,0:07:14.13,0:07:17.84,النص العام,,0,0,0,,لا تظهر المودة أو الإحراج أمام الآخرين
Dialogue: 0,0:07:21.14,0:07:24.31,نص عام,,0,0,0,,فقط انظر إلى يوليا
Dialogue: 0,0:07:25.10,0:07:27.81,general text,,0,0,0,,يوبخونه لكنه لا يزال يدرس
Dialogue: 0,0:07:30.60,0:07:32.31,نص عام,,0,0,0,,- أدرس؟\N- انظر
Dialogue: 0,0:07:33.02,0:07:34.82,نص عام,,0,0,0,,قلت هذا يكفي
Dialogue: 0,0:07:36.19,0:07:37.65,نص عام,,0,0,0,,أنا لا أحب الطعام المالح
Dialogue: 0,0:07:41.28,0:07:42.66,مائل,,0,0,0,,لم يكن هكذا أبدًا
Dialogue: 0,0:07:42.74,0:07:45.66,general text,,0,0,0,,- جرب بنفسك\N- {\i1}حتى أمام المعلم هو أو عمي
Dialogue: 0,0:07:45.74,0:07:46.95,نص عام,,0,0,0,,مضحك
Dialogue: 0,0:07:47.54,0:07:50.46,مائل,,0,0,0,,إنه مثل الطالب الخائف، أليس كذلك؟
Dialogue: 0,0:07:50.54,0:07:51.92,مائل,,0,0,0,,لطيف، هاه؟
Dialogue: 0,0:07:52.00,0:07:55.75,نص عام,,0,0,0,,هنا. كان يجب أن أتوقف عندما قلت
Dialogue: 0,0:07:55.84,0:07:59.26,النص العام,,0,0,0,,- أنا آسف\N- {\i1}سيدي العزيز وطالبه المطيع
Dialogue: 0,0:08:00.38,0:08:02.68,نص عام,,0,0,0,,اترك. بحاجة لإنهاء الطهي
Dialogue: 0,0:08:02.76,0:08:04.89,النص العام,,0,0,0,,- المعلم والتلميذ؟\N{\i1}- اجلس
Dialogue: 0,0:08:04.97,0:08:07.27,نص عام,,0,0,0,,لماذا أنت عنيد جدًا،
Dialogue: 0,0:08:07.35,0:08:09.48,نص عام,,0,0,0,,إذا كنت تطبخ لأول مرة؟
Dialogue: 0,0:08:16.65,0:08:17.61,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:08:17.69,0:08:21.32,نص عام,,0,0,0,,دعونا نرى كيف علمته وكيف تعلمت
Dialogue: 0,0:08:21.86,0:08:23.41,نص عام,,0,0,0,,دعونا نحاول
Dialogue: 0,0:08:28.79,0:08:30.08,نص عام,,0,0,0,,لذيذ
Dialogue: 0,0:08:30.16,0:08:31.46,نص عام,,0,0,0,,لذيذ؟
Dialogue: 0,0:08:33.88,0:08:36.09,النص العام,,0,0,0,,لقد فعلت كل شيء كما قال مو ديوك
Dialogue: 0,0:08:39.13,0:08:40.26,نص عام,,0,0,0,,أحسنت
Dialogue: 0,0:08:41.34,0:08:44.14,نص عام,,0,0,0,,أعتقد أنني مسرور بعد مدح المعلم
Dialogue: 0,0:08:44.72,0:08:48.01,general text,,0,0,0,,اعتقدت أنني جيد في كل شيء لأن الناس ينادونني بالعبقري.
Dialogue: 0,0:08:48.81,0:08:50.98,نص عام,,0,0,0,,ولكن اتضح أن هناك شيئًا لا أستطيع فعله
Dialogue: 0,0:08:51.06,0:08:52.02,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:08:52.10,0:08:53.73,نص عام,,0,0,0,,شكرًا لمساعدتي في تحقيق ذلك
Dialogue: 0,0:08:53.81,0:08:57.98,general text,,0,0,0,,لم يكن الأمر سهلاً لأنه لم يفهم ما كنت أقوله
Dialogue: 0,0:08:58.07,0:09:00.74,النص العام,,0,0,0,,لكنه استمر في المحاولة
Dialogue: 0,0:09:01.40,0:09:03.07,نص عام,,0,0,0,,فواصلت تعليمه
Dialogue: 0,0:09:04.61,0:09:05.99,نص عام,,0,0,0,,مبالغة
Dialogue: 0,0:09:06.62,0:09:08.91,نص عام,,0,0,0,,كما لو أن المائدة الملكية قد وُضعت هنا
Dialogue: 0,0:09:08.99,0:09:11.79,نص عام,,0,0,0,,يمكنك أن تتعلم الكثير أثناء الطهي
Dialogue: 0,0:09:11.87,0:09:13.46,النص العام,,0,0,0,,- يجب أن تتعلم أيضاً\N- للأسف،
Dialogue: 0,0:09:13.54,0:09:16.25,نص عام,,0,0,0,,ليس لدي معلم مثله
Dialogue: 0,0:09:18.17,0:09:20.17,النص العام,,0,0,0,,عذرًا، لكن الأرز محترق قليلاً
Dialogue: 0,0:09:20.26,0:09:22.92,نص عام,,0,0,0,,- نعم\N{\i1}- يمكنك المحاولة مرة أخرى
Dialogue: 0,0:09:23.01,0:09:26.47,general text,,0,0,0,,مو دوك، هل تعتقد أنه سيحقق نتائج أفضل في المرة القادمة؟
Dialogue: 0,0:09:26.55,0:09:29.10,النص العام,,0,0,0,,إنه ليس يائسًا تمامًا
Dialogue: 0,0:09:29.18,0:09:30.85,خط مائل,,0,0,0,,شكرًا على هذه الكلمات
Dialogue: 0,0:09:45.82,0:09:47.24,نص عام,,0,0,0,,لماذا تغسله بنفسك؟
Dialogue: 0,0:09:47.32,0:09:49.45,نص عام,,0,0,0,,اطلب من تلميذك الرائع مساعدتك
Dialogue: 0,0:09:49.53,0:09:53.25,النص العام,,0,0,0,,لقد طبخ الطعام، لذا سأنظف كل شيء
Dialogue: 0,0:09:54.62,0:09:56.17,النص العام,,0,0,0,,هل كان تعليمه ممتعًا؟
Dialogue: 0,0:09:56.83,0:09:58.04,نص عام,,0,0,0,,هل تريده
Dialogue: 0,0:09:58.71,0:09:59.79,نص عام,,0,0,0,,هل كان تلميذك؟
Dialogue: 0,0:09:59.88,0:10:01.88,نص عام,,0,0,0,,سيكون الأمر أسهل لو كان الأمر هكذا
Dialogue: 0,0:10:02.46,0:10:04.55,النص العام,,0,0,0,,إنه مجتهد مطيع
Dialogue: 0,0:10:05.34,0:10:07.51,نص عام,,0,0,0,,لست كسولاً ومتهوراً مثلك
Dialogue: 0,0:10:07.59,0:10:10.10,نص عام,,0,0,0,,يا معلم لا تخدعني
Dialogue: 0,0:10:11.68,0:10:12.52,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:10:12.60,0:10:14.89,general text,,0,0,0,,أفهم أنك تحب اجتهاده ومثابرته
Dialogue: 0,0:10:14.98,0:10:17.31,نص عام,,0,0,0,,لكنني تلميذك الوحيد
Dialogue: 0,0:10:17.40,0:10:20.86,نص عام,,0,0,0,,يجب ألا يكون لدى المعلم عدة طلاب والعكس صحيح
Dialogue: 0,0:10:20.94,0:10:24.15,general text,,0,0,0,,منزعج لأنني علمت يوليا الطبخ؟
Dialogue: 0,0:10:24.24,0:10:26.15,نص عام,,0,0,0,,نعم. بالضبط. كيف يمكنك تعليم شخص آخر
Dialogue: 0,0:10:26.24,0:10:28.28,نص عام,,0,0,0,,عندما كان طالبك أمامك مباشرة؟
Dialogue: 0,0:10:28.87,0:10:31.03,مائل,,0,0,0,,هل تريد تعليم شخص ما كيفية الطهي؟ فليكن أنا
Dialogue: 0,0:10:31.12,0:10:32.74,النص العام,,0,0,0,,تعليم غيرك خيانة وخيانة
Dialogue: 0,0:10:33.87,0:10:36.54,نص عام,,0,0,0,,أفهم الجزء المتعلق بالخيانة
Dialogue: 0,0:10:36.62,0:10:37.83,نص عام,,0,0,0,,لكن الخيانة؟
Dialogue: 0,0:10:37.92,0:10:39.38,نص عام,,0,0,0,,لا توجد كلمات
Dialogue: 0,0:10:42.42,0:10:43.55,نص عام,,0,0,0,,أنا متأكد،
Dialogue: 0,0:10:44.51,0:10:46.47,نص عام,,0,0,0,,شعرت بالخيانة
Dialogue: 0,0:10:53.81,0:10:55.02,نص عام,,0,0,0,,ما هذا أيضًا؟
Dialogue: 0,0:10:56.06,0:10:56.98,نص عام,,0,0,0,,حسنًا، ماذا أيضًا؟
Dialogue: 0,0:10:57.06,0:10:58.81,النص العام,,0,0,0,,مو دوك، لا تخونني
Dialogue: 0,0:10:58.90,0:11:00.31,نص عام,,0,0,0,,هذا يؤلمني ويغضبني
Dialogue: 0,0:11:00.40,0:11:03.19,نص عام,,0,0,0,,لم أكن أعلم أن تلميذي مهووس إلى هذا الحد
Dialogue: 0,0:11:03.90,0:11:05.78,نص عام,,0,0,0,,حسنًا، ستكون أنت الوحيد
Dialogue: 0,0:11:05.86,0:11:08.95,نص عام,,0,0,0,,طالب يقول هراء في الصباح. هل أنت راض؟
Dialogue: 0,0:11:09.03,0:11:10.66,النص العام,,0,0,0,,- لكن...\N{\i1}- مو دوك!
Dialogue: 0,0:11:11.70,0:11:12.66,خط مائل,,0,0,0,,مو دوك!
Dialogue: 0,0:11:14.29,0:11:15.16,نص عام,,0,0,0,,المضيف,
Dialogue: 0,0:11:15.91,0:11:19.58,النص العام,,0,0,0,,إنها خيانة إذا لقبت الآخرين بالسادة
Dialogue: 0,0:11:20.21,0:11:21.54,نص عام,,0,0,0,,وتجيب على دعوتهم؟
Dialogue: 0,0:11:21.63,0:11:23.38,نص عام,,0,0,0,,لا يمكن فعل أي شيء هنا بالطبع
Dialogue: 0,0:11:23.46,0:11:25.96,نص عام,,0,0,0,,لكن عندما تتصل بهم،
Dialogue: 0,0:11:26.05,0:11:28.47,نص عام,,0,0,0,,اتصلوا بي يا سادة
Dialogue: 0,0:11:30.26,0:11:31.59,نص عام,,0,0,0,,ضحك ولا أكثر
Dialogue: 0,0:11:33.97,0:11:37.60,نص عام,,0,0,0,,سيد باك، أنا قادم!
Dialogue: 0,0:11:37.68,0:11:40.73,general text,,0,0,0,,مو دوك، لقد جرحت مشاعري. قلت لك أن تدعوني سيد!
Dialogue: 0,0:11:49.40,0:11:51.16,نص عام,,0,0,0,,عالٍ جداً
Dialogue: 0,0:11:53.16,0:11:55.62,general text,,0,0,0,,يول، هل تريد رؤية هذه الشجرة؟
Dialogue: 0,0:11:56.95,0:11:58.20,نص عام,,0,0,0,,نوعاً ما
Dialogue: 0,0:11:59.62,0:12:01.67,نص عام,,0,0,0,,لا أصدق أنه موجود
Dialogue: 0,0:12:09.76,0:12:12.76,ذكريات,,0,0,0,,كيف عرفت أنني تأذيت؟
Dialogue: 0,0:12:13.47,0:12:16.26,ذكريات,,0,0,0,,هناك شجرة طويلة في مكان قريب،
Dialogue: 0,0:12:18.02,0:12:21.39,ذكريات,,0,0,0,,دانهيانجوك كلها مرئية من الأعلى
Dialogue: 0,0:12:26.86,0:12:29.78,نص عام,,0,0,0,,دانهيانغوك بأكملها مرئية من الأعلى
Dialogue: 0,0:12:33.32,0:12:35.24,نص عام,,0,0,0,,فصعدت
Dialogue: 0,0:12:36.41,0:12:37.66,نص عام,,0,0,0,,إلى القمة؟
Dialogue: 0,0:12:41.66,0:12:44.63,نص عام,,0,0,0,,افترضت ذلك لأنه مرتفع
Dialogue: 0,0:12:46.50,0:12:48.67,نص عام,,0,0,0,,هل تريد الصعود؟
Dialogue: 0,0:12:48.76,0:12:50.42,نص عام,,0,0,0,,أساعدك على التسلق؟
Dialogue: 0,0:12:51.09,0:12:53.72,نص عام,,0,0,0,,دان جو، لا يمكنك تسلقه
Dialogue: 0,0:12:53.80,0:12:57.14,general text,,0,0,0,,أنت بحاجة على الأقل إلى إتقان تشيسا لتتمكن من التسلق إلى هناك.
Dialogue: 0,0:12:58.39,0:12:59.39,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:13:00.02,0:13:01.52,نص عام,,0,0,0,,ربما يجب أن أحاول؟
Dialogue: 0,0:13:02.10,0:13:03.10,خط مائل,,0,0,0,,بالضبط
Dialogue: 0,0:13:03.19,0:13:05.10,نص عام,,0,0,0,,ربما يمكنك فعل ذلك
Dialogue: 0,0:13:05.69,0:13:06.98,النص العام,,0,0,0,,مو دوك، دعنا نذهب معه
Dialogue: 0,0:13:10.69,0:13:11.78,نص عام,,0,0,0,,هل تريد التسلق؟
Dialogue: 0,0:13:17.08,0:13:18.37,نص عام,,0,0,0,,لا أريد
Dialogue: 0,0:13:18.45,0:13:21.58,نص عام,,0,0,0,,لا أريد أن أتسلق هذه الشجرة مع أي شخص
Dialogue: 0,0:13:26.50,0:13:27.34,نص عام,,0,0,0,"مع أي شخص فقط"؟
Dialogue: 0,0:13:30.51,0:13:33.72,نص عام,,0,0,0,,أعتقد أنها خائفة جدًا
Dialogue: 0,0:13:33.80,0:13:35.13,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:13:46.52,0:13:48.52,نص عام,,0,0,0,,درست جوهر طاقته
Dialogue: 0,0:13:49.77,0:13:52.57,general text,,0,0,0,,كان من عامة الشعب وليس ساحراً
Dialogue: 0,0:13:53.57,0:13:56.74,نص عام,,0,0,0,,أنا متأكد من أن هناك المزيد من الضحايا
Dialogue: 0,0:13:56.82,0:14:00.20,نص عام,,0,0,0,,هناك بدو بيننا
Dialogue: 0,0:14:00.79,0:14:02.70,نص عام,,0,0,0,,ماذا تفعل يا سيد لي؟
Dialogue: 0,0:14:02.79,0:14:05.62,general text,,0,0,0,,من الصعب التعرف على أصل هذا السحر،
Dialogue: 0,0:14:05.71,0:14:07.21,نص عام,,0,0,0,,كيفية القبض على البدو الرحل
Dialogue: 0,0:14:08.04,0:14:09.59,نص عام,,0,0,0,,أظن أن جيونبوغوان
Dialogue: 0,0:14:11.42,0:14:14.42,النص العام,,0,0,0,,هذا البدوي الذي غزا سوسنوفي بور،
Dialogue: 0,0:14:15.34,0:14:17.30,نص عام,,0,0,0,,كان هناك منجمون هناك
Dialogue: 0,0:14:18.26,0:14:21.06,نص عام,,0,0,0,,بالإضافة إلى ذلك، إنه جين مو
Dialogue: 0,0:14:21.14,0:14:23.02,النص العام,,0,0,0,,دمر ناك سو أثناء نقل الروح،
Dialogue: 0,0:14:23.81,0:14:25.73,نص عام,,0,0,0,,ثم كل أهلها
Dialogue: 0,0:14:27.19,0:14:28.90,نص عام,,0,0,0,,ناك سو...
Dialogue: 0,0:14:35.86,0:14:38.62,نص عام,,0,0,0,,لقد اكتشفنا من هو
Dialogue: 0,0:14:38.70,0:14:39.82,نص عام,,0,0,0,,ومن؟
Dialogue: 0,0:14:39.91,0:14:42.29,نص عام,,0,0,0,,أحد خدم جيونبوغوان
Dialogue: 0,0:14:42.37,0:14:45.83,نص عام,,0,0,0,,ماذا؟ Jeonbugwan متورط مرة أخرى
Dialogue: 0,0:14:45.91,0:14:48.58,نص عام,,0,0,0,,سأذهب لرؤية جين مو على الفور!
Dialogue: 0,0:14:48.67,0:14:50.25,نص عام,,0,0,0,,الجميع خلفي
Dialogue: 0,0:14:50.34,0:14:51.54,نص عام,,0,0,0,,يوم
Dialogue: 0,0:14:52.21,0:14:53.17,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:14:53.84,0:14:54.96,نص عام,,0,0,0,,لا تفعل شيئاً
Dialogue: 0,0:14:56.84,0:14:59.97,النص العام,,0,0,0,,في وقت ما تهورك أفسد الكثير
Dialogue: 0,0:15:00.05,0:15:02.14,general text,,0,0,0,,الآن كبرت لكن شخصيتك ما زالت كما هي
Dialogue: 0,0:15:03.06,0:15:04.72,نص عام,,0,0,0,,عذراً أيها المعلم
Dialogue: 0,0:15:05.31,0:15:06.43,نص عام,,0,0,0,,لم يحن الوقت بعد
Dialogue: 0,0:15:06.52,0:15:10.48,نص عام,,0,0,0,,نحن بحاجة إلى مراقبة جيونبوغوان عن كثب
Dialogue: 0,0:15:10.56,0:15:11.86,نص عام,,0,0,0,,جين
Dialogue: 0,0:15:12.86,0:15:14.40,نص عام,,0,0,0,,لقد كبرت ذكياً
Dialogue: 0,0:15:15.69,0:15:17.82,نص عام,,0,0,0,,كنت تركض بملابسك الداخلية
Dialogue: 0,0:15:17.90,0:15:21.16,general text,,0,0,0,,لا أصدق أنك كبرت هكذا وتقود الناس
Dialogue: 0,0:15:25.95,0:15:27.04,نص عام,,0,0,0,,يا معلمة
Dialogue: 0,0:15:33.29,0:15:34.92,نص عام,,0,0,0,,من هو؟
Dialogue: 0,0:15:36.38,0:15:37.59,نص عام,,0,0,0,,كان طالباً
Dialogue: 0,0:15:38.13,0:15:41.55,النص العام,,0,0,0,,السيد سو كيونغ، مؤسس سوسنوفي بور
Dialogue: 0,0:15:42.60,0:15:44.06,نص عام,,0,0,0,,لكنه صغير جدًا
Dialogue: 0,0:15:45.18,0:15:46.52,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,0:15:47.39,0:15:49.10,نص عام,,0,0,0,,مازلت أتذكر الغناء
Dialogue: 0,0:15:51.35,0:15:53.19,نص عام,,0,0,0,,في الاحتفال بالذكرى المئوية لميلاده
Dialogue: 0,0:15:56.86,0:15:58.32,نص عام,,0,0,0,,حتى أنني رقصت
Dialogue: 0,0:16:02.07,0:16:04.95,general text,,0,0,0,,هذا الكلب... هل هو غويغو؟
Dialogue: 0,0:16:07.16,0:16:11.62,النص العام,,0,0,0,,إذن أخذت غويغا من جينيوون
Dialogue: 0,0:16:12.63,0:16:14.96,نص عام,,0,0,0,,سوف يجد بدوياً
Dialogue: 0,0:16:15.75,0:16:18.21,general text,,0,0,0,,مات ناك سو أثناء نقل الروح، أليس كذلك؟
Dialogue: 0,0:16:18.30,0:16:19.13,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:19.22,0:16:22.68,general text,,0,0,0,,كانت مرتزقة مشهورة وساحرة موهوبة
Dialogue: 0,0:16:25.05,0:16:27.60,general text,,0,0,0,,أليست روحها هي التي أحسست بها؟
Dialogue: 0,0:16:39.99,0:16:42.45,نص عام,,0,0,0,,سيف تشانغ غان الآن
Dialogue: 0,0:16:42.53,0:16:44.70,النص العام,,0,0,0,,- ابنه أليس كذلك؟\N- نعم
Dialogue: 0,0:16:44.78,0:16:48.62,نص عام,,0,0,0,,هل قابلته؟
Dialogue: 0,0:16:48.70,0:16:50.58,نص عام,,0,0,0,,رأيت شاباً يرتدي سواراً
Dialogue: 0,0:16:50.66,0:16:53.83,نص عام,,0,0,0,,والخادمة التي تبعته
Dialogue: 0,0:16:55.59,0:16:56.88,نص عام,,0,0,0,,مثير للاهتمام
Dialogue: 0,0:17:03.97,0:17:06.51,نص عام,,0,0,0,,جمع مو دوك بعض الكستناء
Dialogue: 0,0:17:06.60,0:17:09.22,النص العام,,0,0,0,,إنهم حلوون، نعم. أعط كيم الخادمة بعضًا أيضًا
Dialogue: 0,0:17:09.31,0:17:10.18,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:17:19.19,0:17:20.74,general text,,0,0,0,,لماذا أخذت سيف أبيك؟
Dialogue: 0,0:17:21.36,0:17:23.61,نص عام,,0,0,0,,أوه هذا؟ أخذها مو دوك
Dialogue: 0,0:17:23.70,0:17:26.78,general text,,0,0,0,,لن تتدرب، لماذا أحضرته إلى هنا؟
Dialogue: 0,0:17:27.53,0:17:28.91,نص عام,,0,0,0,,خذها إلى الخادمة كيم؟
Dialogue: 0,0:17:30.83,0:17:31.70,ذكريات بخط مائل,,0,0,0,,أنت...
Dialogue: 0,0:17:32.75,0:17:34.04,ذكريات,,0,0,0,,ليس ابناً
Dialogue: 0,0:17:35.33,0:17:36.54,ذكريات,,0,0,0,,تشان غان
Dialogue: 0,0:17:40.05,0:17:41.17,نص عام,,0,0,0,,كما تريد
Dialogue: 0,0:17:45.38,0:17:46.55,نص عام,,0,0,0,,- هيا بنا\N- نعم
Dialogue: 0,0:17:49.26,0:17:51.89,النص العام,,0,0,0,,قلت أنك غالبًا ما تجمع الأعشاب هنا
Dialogue: 0,0:17:53.23,0:17:57.10,نص عام,,0,0,0,,هل رأيت أحداً عاش هنا؟
Dialogue: 0,0:17:57.19,0:18:00.19,نص عام,,0,0,0,,لا. من سيعيش هنا؟
Dialogue: 0,0:18:01.57,0:18:02.82,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:18:07.53,0:18:08.74,نص عام,,0,0,0,,والمزيد
Dialogue: 0,0:18:10.79,0:18:12.91,general text,,0,0,0,,هل الجو بارد جداً في الشتاء؟
Dialogue: 0,0:18:14.37,0:18:15.79,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:18:17.92,0:18:19.67,نص عام,,0,0,0,,لم يسبق لي أن كنت هنا في الشتاء
Dialogue: 0,0:18:22.67,0:18:24.67,نص عام,,0,0,0,,قلق في كل مرة يتساقط فيها الثلج
Dialogue: 0,0:18:26.47,0:18:28.26,النص العام,,0,0,0,,قلق إذا كان الجو باردًا جدًا
Dialogue: 0,0:18:29.85,0:18:32.10,نص عام,,0,0,0,,هل كل شيء على ما يرام
Dialogue: 0,0:18:42.40,0:18:44.11,نص عام,,0,0,0,,الجو يصبح أكثر دفئًا هنا،
Dialogue: 0,0:18:45.19,0:18:47.20,نص عام,,0,0,0,,مما قد يبدو عليه الأمر
Dialogue: 0,0:18:50.28,0:18:53.29,نص عام,,0,0,0,,الثلج يذوب بسرعة في الأماكن المشمسة
Dialogue: 0,0:18:56.21,0:18:58.17,نص عام,,0,0,0,,نعم؟ أنا سعيد
Dialogue: 0,0:19:04.30,0:19:06.72,general text,,0,0,0,,نعم، يوجد الكثير من الطعام هنا حتى في الشتاء
Dialogue: 0,0:19:07.68,0:19:10.34,نص عام,,0,0,0,,هناك مكان للاختباء من الثلج
Dialogue: 0,0:19:13.22,0:19:15.60,النص العام,,0,0,0,,- أنا متأكد من أنه لذيذ\N- جداً
Dialogue: 0,0:19:18.56,0:19:19.98,general text,,0,0,0,,هل نبقى يومًا آخر؟
Dialogue: 0,0:19:21.40,0:19:23.90,مائل,,0,0,0,,يبدو أن مو دوك معجب به حقًا
Dialogue: 0,0:19:28.45,0:19:30.20,نص عام,,0,0,0,,قال لها
Dialogue: 0,0:19:31.32,0:19:32.66,نص عام,,0,0,0,,لا يعجبني
Dialogue: 0,0:19:32.74,0:19:35.24,نص عام,,0,0,0,,أقول أنه أعجبك!
Dialogue: 0,0:19:35.95,0:19:36.87,نص عام,,0,0,0,,انظر
Dialogue: 0,0:19:36.95,0:19:41.04,general text,,0,0,0,,إنها لا تنظر إلينا كما تنظر إليه
Dialogue: 0,0:19:49.51,0:19:51.18,نص عام,,0,0,0,,تهب الرياح
Dialogue: 0,0:19:59.85,0:20:01.56,النص العام,,0,0,0,,هل يأتي منها؟
Dialogue: 0,0:20:05.32,0:20:06.28,نص عام,,0,0,0,,دان جو، دعنا نذهب
Dialogue: 0,0:20:06.90,0:20:07.99,نص عام,,0,0,0,,نعم
Dialogue: 0,0:20:12.28,0:20:14.03,خط مائل,,0,0,0,,إلى اللقاء يا مو دوك
Dialogue: 0,0:20:19.50,0:20:20.54,خط مائل,,0,0,0,,لنذهب
Dialogue: 0,0:20:27.92,0:20:29.47,نص عام,,0,0,0,,سأعرضهم
Dialogue: 0,0:20:42.23,0:20:44.40,نص عام,,0,0,0,,- أتمنى لك رحلة سعيدة\N- نراكم لاحقاً
Dialogue: 0,0:20:45.31,0:20:47.53,نص عام,,0,0,0,,حاول أن تتذكر أين فقدت تميمة الروح
Dialogue: 0,0:20:48.11,0:20:50.19,نص عام,,0,0,0,,- حسنًا\N- وأخفض رأسك
Dialogue: 0,0:20:50.70,0:20:52.86,general text,,0,0,0,,بفضلكم حتى المجلس الموحد انعقد
Dialogue: 0,0:20:52.95,0:20:55.87,النص العام,,0,0,0,,أعتقد أن جميع أساتذتي السابقين الـ 12 كانوا هناك
Dialogue: 0,0:20:55.95,0:20:58.79,general text,,0,0,0,,كانوا جميعًا بلا قلب تجاهك
Dialogue: 0,0:20:59.45,0:21:02.33,general text,,0,0,0,,حتى أنهم عرضوا عليك ختم كل طاقتك
Dialogue: 0,0:21:03.08,0:21:05.33,general text,,0,0,0,,- لماذا يقولون ذلك؟\N- ماذا؟
Dialogue: 0,0:21:07.84,0:21:09.59,general text,,0,0,0,,لأنك هربت من القتال
Dialogue: 0,0:21:11.26,0:21:13.05,خط مائل,,0,0,0,,ولكن هذا مجرد غبي
Dialogue: 0,0:21:13.13,0:21:14.97,نص عام,,0,0,0,,لم تكن تريد أن يحدث ذلك أيضًا
Dialogue: 0,0:21:15.05,0:21:17.26,خط مائل,,0,0,0,,لا أحد يتوقع حضورك
Dialogue: 0,0:21:17.35,0:21:21.02,نص عام,,0,0,0,,لذا فقط ابقَ هنا وعش بهدوء
Dialogue: 0,0:21:23.39,0:21:25.10,مائل,,0,0,0,,أراد الرأس أن يعرف شيئاً
Dialogue: 0,0:21:26.65,0:21:28.73,النص العام,,0,0,0,,سألك إذا كنت تفعل ما قيل لك
Dialogue: 0,0:21:30.99,0:21:31.99,ذكريات بخط مائل,,0,0,0,,أنت
Dialogue: 0,0:21:32.49,0:21:35.53,ذكريات,,0,0,0,,ثمرة خيانة والدتك
Dialogue: 0,0:21:35.61,0:21:38.16,ذكريات,,0,0,0,,لكن لا يمكننا أن نسمح لك بأن تصبح رئيس جيونبوغوان
Dialogue: 0,0:21:38.24,0:21:41.41,ذكريات,,0,0,0,,فتوقف عن الحلم باتباع الخطوات
Dialogue: 0,0:21:44.54,0:21:45.75,ذكريات,,0,0,0,,عن والده
Dialogue: 0,0:21:46.33,0:21:48.38,ذكريات,,0,0,0,,تبقى وريثاً جاهلاً
Dialogue: 0,0:21:49.75,0:21:52.47,ذكريات,,0,0,0,,عائلة تشان
Dialogue: 0,0:21:55.84,0:21:58.18,نص عام,,0,0,0,,هل يمكنني أن أعطيه إجابة إيجابية؟
Dialogue: 0,0:21:58.26,0:22:00.18,النص العام,,0,0,0,,هل كنت مطيعاً من قبل؟
Dialogue: 0,0:22:00.81,0:22:03.68,general text,,0,0,0,,قل له أنني أفعل العكس تماماً، كوني متهوراً
Dialogue: 0,0:22:06.94,0:22:08.11,نص عام,,0,0,0,,دان جو، اترك السيف هنا
Dialogue: 0,0:22:09.11,0:22:10.02,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:22:10.90,0:22:13.19,النص العام,,0,0,0,,أريد مساعدة مو ديوك في الإمساك بطائر الدراج
Dialogue: 0,0:22:17.62,0:22:18.82,نص عام,,0,0,0,,إلى اللقاء
Dialogue: 0,0:22:24.29,0:22:26.87,general text,,0,0,0,,هل جرحنا كبريائه؟
Dialogue: 0,0:22:26.96,0:22:27.83,خط مائل,,0,0,0,,اتركه
Dialogue: 0,0:22:27.92,0:22:30.42,general text,,0,0,0,,لا يمكننا أن نطلب منه العودة والموت بكرامة هناك
Dialogue: 0,0:22:38.39,0:22:40.72,general text,,0,0,0,,هل تعود بالسيف الذي أهديته؟
Dialogue: 0,0:22:43.27,0:22:45.27,general text,,0,0,0,,لقد أصبحت أضحوكة وهذا يؤذي كبريائي
Dialogue: 0,0:22:47.39,0:22:50.15,general text,,0,0,0,,في هذه الحالة، دعونا نتدرب وكأن حياتنا تعتمد على ذلك
Dialogue: 0,0:22:51.48,0:22:52.61,نص عام,,0,0,0,,يبدو أنك مستمتع بذلك،
Dialogue: 0,0:22:54.32,0:22:56.11,نص عام,,0,0,0,,أن تلميذك أصبح أضحوكة
Dialogue: 0,0:22:56.90,0:22:59.32,نص عام,,0,0,0,,وعلاوة على ذلك، سأضيف
Dialogue: 0,0:23:00.57,0:23:03.87,النص العام,,0,0,0,,أصدقاؤك لم يطلبوا منك أن تعود معهم إلى المنزل
Dialogue: 0,0:23:03.95,0:23:06.71,general text,,0,0,0,,لو كانوا أنت لقاتلوا حتى الموت
Dialogue: 0,0:23:06.79,0:23:09.71,general text,,0,0,0,,وقد قيل لك أن تركض وتختبئ
Dialogue: 0,0:23:10.79,0:23:11.92,نص عام,,0,0,0,,هل تعلم لماذا؟
Dialogue: 0,0:23:14.38,0:23:16.97,نص عام,,0,0,0,,لأنك عديم الفائدة
Dialogue: 0,0:23:18.88,0:23:20.85,general text,,0,0,0,,لسانك أحد من السيف
Dialogue: 0,0:23:21.72,0:23:24.72,نص عام,,0,0,0,,الكلمات تؤذي. بلا رحمة
Dialogue: 0,0:23:24.81,0:23:27.06,general text,,0,0,0,,لن أتردد في طعنك بالسيف،
Dialogue: 0,0:23:27.14,0:23:29.14,نص عام,,0,0,0,,إذا كان ذلك سيعيدك إلى المسار الصحيح
Dialogue: 0,0:23:29.23,0:23:30.27,نص عام,,0,0,0,,نعم يا معلم
Dialogue: 0,0:23:30.35,0:23:32.61,النص العام,,0,0,0,,اضرب تلميذك عديم الفائدة حتى الموت
Dialogue: 0,0:23:35.32,0:23:37.36,general text,,0,0,0,,لماذا لم تنتعش بعد كلامي؟
Dialogue: 0,0:23:37.44,0:23:38.74,نص عام,,0,0,0,,لماذا هذا الانكسار؟
Dialogue: 0,0:23:41.24,0:23:43.45,general text,,0,0,0,,كلماتك الشريرة أزعجتني في النهاية
Dialogue: 0,0:23:44.20,0:23:45.66,النص العام,,0,0,0,,أحتاج إلى الاستحمام والاسترخاء
Dialogue: 0,0:23:47.45,0:23:49.42,general text,,0,0,0,,لماذا يستحم كثيراً؟
Dialogue: 0,0:23:49.50,0:23:51.00,النص العام,,0,0,0,,أحمق كسول لا قيمة له
Dialogue: 0,0:23:51.08,0:23:52.42,نص عام,,0,0,0,,أتمنى أن تغلي في الماء المغلي!
Dialogue: 0,0:23:53.79,0:23:57.26,نص عام,,0,0,0,,لا يصدق! أي نوع من المعلمين يقول ذلك لطلابه؟
Dialogue: 0,0:24:02.47,0:24:06.64,general text,,0,0,0,,المملكة المتحدة لا تتذكر كيف فقد تميمة روحه؟
Dialogue: 0,0:24:07.60,0:24:09.73,general text,,0,0,0,,ربما باعه أحدهم بعد أن أسقطته المملكة المتحدة
Dialogue: 0,0:24:09.81,0:24:12.06,النص العام,,0,0,0,,فوصلت إليهم التميمة
Dialogue: 0,0:24:12.15,0:24:14.11,نص عام,,0,0,0,,سمعت أن هناك مكان يبيعون فيه مثل هذه التمائم
Dialogue: 0,0:24:15.32,0:24:18.11,نص عام,,0,0,0,,في هذه الحالة، حاول معرفة كل شيء
Dialogue: 0,0:24:19.28,0:24:20.57,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:24:20.65,0:24:21.91,نص عام,,0,0,0,,كيف...
Dialogue: 0,0:24:24.03,0:24:26.33,نص عام,,0,0,0,,هل تفعل أوكا؟
Dialogue: 0,0:24:28.95,0:24:31.50,general text,,0,0,0,,كل شيء على ما يرام معه، يتغذى ويتمتع بصحة جيدة
Dialogue: 0,0:24:32.58,0:24:34.71,نص عام,,0,0,0,,ما زال لم يتخلص من السوار
Dialogue: 0,0:24:37.05,0:24:38.13,نص عام,,0,0,0,,يمكنك الذهاب
Dialogue: 0,0:24:59.40,0:25:00.86,نص عام,,0,0,0,,لم يعد الأمر ثقيلاً بعد الآن
Dialogue: 0,0:25:00.95,0:25:02.49,نص عام,,0,0,0,,ولا يتعارض مع المشي
Dialogue: 0,0:25:02.57,0:25:05.16,النص العام,,0,0,0,,بعض السحرة يتدربون على أثقال الحديد،
Dialogue: 0,0:25:05.24,0:25:07.28,النص العام,,0,0,0,,لتقوية يديك واستخدام السيف بشكل أفضل
Dialogue: 0,0:25:07.79,0:25:10.96,مائل,,0,0,0,,لقد أصبحت أقوى دون قصد،
Dialogue: 0,0:25:11.04,0:25:13.25,نص عام,,0,0,0,,أثناء ارتداء هذا السوار الثقيل طوال اليوم
Dialogue: 0,0:25:13.33,0:25:14.75,نص عام,,0,0,0,,غير مقصود,
Dialogue: 0,0:25:14.83,0:25:17.13,نص عام,,0,0,0,,لكنك وجدت أداة تدريب رائعة لنفسك
Dialogue: 0,0:25:18.42,0:25:19.96,نص عام,,0,0,0,,أنت محظوظ بشكل لا يصدق
Dialogue: 0,0:25:20.05,0:25:23.43,general text,,0,0,0,,إذا خلعته سأكون أسرع وأقوى
Dialogue: 0,0:25:24.01,0:25:27.47,general text,,0,0,0,,ولكن إذا لم تتعلم التحكم في نفسك، فسوف تصبح أكثر إثارة للشفقة
Dialogue: 0,0:25:29.22,0:25:30.27,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:25:30.93,0:25:31.93,نص عام,,0,0,0,,انسى
Dialogue: 0,0:25:35.85,0:25:38.94,النص العام,,0,0,0,,ما الذي كنت تتحدث عنه أنت ويول؟
Dialogue: 0,0:25:41.36,0:25:42.86,نص عام,,0,0,0,,عن دانهيانغوك
Dialogue: 0,0:25:44.86,0:25:47.87,نص عام,,0,0,0,,سأل كيف كان الوضع هنا في الشتاء
Dialogue: 0,0:25:52.04,0:25:53.91,خط مائل,,0,0,0,,لقد قابلت ناكسو،
Dialogue: 0,0:25:54.67,0:25:56.33,نص عام,,0,0,0,,عندما كنت صغيراً؟
Dialogue: 0,0:25:58.29,0:26:01.34,نص عام,,0,0,0,,لم أكن متأكدة عندما رأيت جثتها
Dialogue: 0,0:26:01.42,0:26:03.97,النص العام,,0,0,0,,لكن الرحلة إلى Danhyangk ساعدتني في تأكيد ذلك
Dialogue: 0,0:26:04.05,0:26:05.13,نص عام,,0,0,0,,لذلك أنا أقول هذا الآن فقط
Dialogue: 0,0:26:06.22,0:26:10.01,النص العام,,0,0,0,,دانهيانجوك - وادي عميق وخطير
Dialogue: 0,0:26:10.10,0:26:12.77,general text,,0,0,0,,لم يكن من الممكن أن تنجو الفتاة الصغيرة هناك دون مساعدة أحد.
Dialogue: 0,0:26:12.85,0:26:15.56,general text,,0,0,0,,عاشت هناك وكأنها تختبئ من أحد.
Dialogue: 0,0:26:16.98,0:26:19.36,مائل,,0,0,0,,عندما عرفت من أنا ومن أي عائلة أنتمي،
Dialogue: 0,0:26:20.11,0:26:22.03,خط مائل,,0,0,0,,لم أرها مرة أخرى
Dialogue: 0,0:26:23.24,0:26:25.70,خط مائل,,0,0,0,,لذلك اكتشفت اسمك...
Dialogue: 0,0:26:26.49,0:26:29.58,نص عام,,0,0,0,,أخبرنا بكل ما تعرفه عنها
Dialogue: 0,0:26:32.37,0:26:33.75,نص عام,,0,0,0,,لا أعرف شيئًا
Dialogue: 0,0:26:34.37,0:26:36.12,نص عام,,0,0,0,,لا اسم ولا عمر
Dialogue: 0,0:26:36.79,0:26:38.67,نص عام,,0,0,0,,باستثناء الجرف حيث شاهدنا الطيور...
Dialogue: 0,0:26:38.75,0:26:40.42,نص عام,,0,0,0,,لم أر قط أين تعيش
Dialogue: 0,0:26:44.55,0:26:45.51,نص عام,,0,0,0,,واحد فقط
Dialogue: 0,0:26:48.43,0:26:50.35,نص عام,,0,0,0,,عندما ذكرت والدها
Dialogue: 0,0:27:01.40,0:27:05.15,ذكريات,,0,0,0,,وصف والدي النجوم
Dialogue: 0,0:27:07.07,0:27:09.49,مائل,,0,0,0,,ثم لم انتبه لذلك
Dialogue: 0,0:27:09.57,0:27:12.20,نص عام,,0,0,0,,لكن هذا ما يفعله مراقبو النجوم
Dialogue: 0,0:27:12.28,0:27:13.87,نص عام,,0,0,0,,من جيونبوغوان
Dialogue: 0,0:27:15.25,0:27:16.37,خط مائل,,0,0,0,,سيدتي,
Dialogue: 0,0:27:16.87,0:27:18.92,نص عام,,0,0,0,,بين السحرة مراقبي النجوم
Dialogue: 0,0:27:20.00,0:27:21.92,نص عام,,0,0,0,,هل كان أحد غاضباً منك؟
Dialogue: 0,0:27:24.92,0:27:26.22,نص عام,,0,0,0,,مراقب النجوم
Dialogue: 0,0:27:27.55,0:27:28.88,نص عام,,0,0,0,,من جيونبوغوان؟
Dialogue: 0,0:27:30.89,0:27:31.97,نص عام,,0,0,0,,ماجى؟
Dialogue: 0,0:27:36.81,0:27:40.48,مائل,,0,0,0,,قبل عشرين عامًا كان هناك منجم مات...
Dialogue: 0,0:27:41.11,0:27:43.82,مائل,,0,0,0,,على يد أربع عائلات
Dialogue: 0,0:27:45.69,0:27:48.99,general text,,0,0,0,,قُتلت عائلته بأكملها في ذلك اليوم
Dialogue: 0,0:27:49.66,0:27:51.07,نص عام,,0,0,0,,باستثناء شخص واحد
Dialogue: 0,0:27:51.16,0:27:53.95,النص العام,,0,0,0,,لم يتم العثور على ابنته تلك الليلة
Dialogue: 0,0:28:20.35,0:28:22.23,مائل,,0,0,0,,اتضح أن عائلتنا كانت مذنبة
Dialogue: 0,0:28:23.19,0:28:25.11,نص عام,,0,0,0,,في وفاة والدها
Dialogue: 0,0:28:25.69,0:28:27.40,general text,,0,0,0,,لابد أنها كانت لديها ضغينة ضدك،
Dialogue: 0,0:28:27.48,0:28:29.82,نص عام,,0,0,0,,بما أن عائلتك شاركت في هذا
Dialogue: 0,0:28:29.90,0:28:32.82,نص عام,,0,0,0,,هل تتذكر أي شيء آخر؟
Dialogue: 0,0:28:33.41,0:28:35.08,نص عام,,0,0,0,,لقد مضى وقت طويل
Dialogue: 0,0:28:36.12,0:28:37.83,نص عام,,0,0,0,,من غير المرجح أن أتذكر أي شيء آخر
Dialogue: 0,0:29:00.81,0:29:02.52,ذكريات بخط مائل,,0,0,0,,لأنني أردت رؤيتهم
Dialogue: 0,0:29:03.81,0:29:06.02,ذكريات بخط مائل,,0,0,0,,لم يزعجني كسر ساقي
Dialogue: 0,0:29:06.11,0:29:07.90,ذكريات بخط مائل,,0,0,0,,ولم أخاف أن يوبخوني
Dialogue: 0,0:29:12.32,0:29:14.16,ذكريات,,0,0,0,,لقد أحببتهم كثيراً
Dialogue: 0,0:29:23.37,0:29:27.50,ذكريات بخط مائل,,0,0,0,,لقد رأيتك تستخدم هذا لتنادي طائرك
Dialogue: 0,0:29:29.42,0:29:30.67,ذكريات,,0,0,0,,أريد تجربتها أيضًا
Dialogue: 0,0:29:31.67,0:29:33.59,ذكريات,,0,0,0,,هل أستطيع الحصول عليها؟
Dialogue: 0,0:30:29.48,0:30:31.11,خلف الكواليس,,0,0,0,,ولي العهد قوي
Dialogue: 0,0:30:31.73,0:30:36.15,التعليق الصوتي,,0,0,0,,هناك طريقة واحدة فقط ليهزمه أوكا ويبقى على قيد الحياة
Dialogue: 0,0:30:37.07,0:30:38.45,نص عام,,0,0,0,,تانسو
Dialogue: 0,0:31:12.48,0:31:14.23,نص عام,,0,0,0,,ماذا تريد مني؟
Dialogue: 0,0:31:15.94,0:31:17.86,نص عام,,0,0,0,,اقطع قطرات الماء وهي تسقط
Dialogue: 0,0:31:19.28,0:31:20.57,نص عام,,0,0,0,,ليست قطرات مطر
Dialogue: 0,0:31:20.66,0:31:23.04,نص عام,,0,0,0,,حتى شخص سيئ الحظ مثلك
Dialogue: 0,0:31:23.12,0:31:25.58,النص العام,,0,0,0,,سيكون قادرًا على قطع القطرات التي تتساقط ببطء شديد
Dialogue: 0,0:31:26.25,0:31:27.12,نص عام,,0,0,0,,إلى الأمام
Dialogue: 0,0:31:48.44,0:31:50.31,نص عام,,0,0,0,,ثلاث قطرات فقط في جلسة واحدة
Dialogue: 0,0:31:51.19,0:31:52.36,خط مائل,,0,0,0,,لا يهم
Dialogue: 0,0:31:52.44,0:31:55.98,general text,,0,0,0,,الرقصة التي ستتعلمها تتطلب منك قطع رقصة واحدة فقط
Dialogue: 0,0:31:56.07,0:31:57.19,نص عام,,0,0,0,,تانسو؟
Dialogue: 0,0:31:58.74,0:31:59.91,نص عام,,0,0,0,,يا معلمة...
Dialogue: 0,0:32:00.41,0:32:03.91,نص عام,,0,0,0,,أفهم ذلك، فأنا سريع التعلم جدًا،
Dialogue: 0,0:32:03.99,0:32:05.33,نص عام,,0,0,0,,لكن تانسو... ليس كثيرًا؟
Dialogue: 0,0:32:05.41,0:32:08.00,نص عام,,0,0,0,,يبدو أن معلميك علموك شيئًا ما
Dialogue: 0,0:32:08.08,0:32:09.08,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:32:09.16,0:32:11.96,النص العام,,0,0,0,,لا يمكنك تعلم التانسو إلا بعد إتقان لغة تشيسو
Dialogue: 0,0:32:12.63,0:32:14.59,نص عام,,0,0,0,,أنت بالكاد تتقن ريوسو
Dialogue: 0,0:32:14.67,0:32:17.30,نص عام,,0,0,0,,مازلت لا تتحكم في طاقتك
Dialogue: 0,0:32:17.38,0:32:19.22,general text,,0,0,0,,لا يمكن لطالب في مستواك أن يتعلم هذا
Dialogue: 0,0:32:20.55,0:32:21.68,نص عام,,0,0,0,,لكن؟
Dialogue: 0,0:32:22.30,0:32:23.64,نص عام,,0,0,0,,لكن بهذه الطريقة فقط
Dialogue: 0,0:32:25.31,0:32:29.60,general text,,0,0,0,,سوف تهزم ولي العهد وستبقى على قيد الحياة
Dialogue: 0,0:33:04.09,0:33:07.18,خلف الكواليس,,0,0,0,,تانسو هي حركة الطاقة بالسيف
Dialogue: 0,0:33:07.26,0:33:09.06,التعليق الصوتي,,0,0,0,,يدك اليمنى كانت ضعيفة،
Dialogue: 0,0:33:09.77,0:33:12.35,خلف الكواليس,,0,0,0,,ولكنها أصبحت أقوى بفضل السوار
Dialogue: 0,0:33:13.48,0:33:14.35,خلف الكواليس,,0,0,0,,قطرة واحدة فقط
Dialogue: 0,0:33:15.44,0:33:18.44,خلف الكواليس,,0,0,0,,اضرب قطرة واحدة حتى تتمكن من جمع الطاقة وتوجيهها
Dialogue: 0,0:33:30.79,0:33:32.54,النص العام,,0,0,0,,لن تتمكن من إتقان التانسو بهذه السرعة
Dialogue: 0,0:33:33.21,0:33:34.67,نص عام,,0,0,0,,دعونا نأكل ونكمل
Dialogue: 0,0:34:22.84,0:34:24.01,نص عام,,0,0,0,,تانسو؟
Dialogue: 0,0:34:24.80,0:34:26.59,general text,,0,0,0,,نعم لن يتمكن من إتقانها أبدًا
Dialogue: 0,0:34:29.30,0:34:32.14,مائل,,0,0,0,,هذه ليست خادمة وسيّدها
Dialogue: 0,0:34:32.85,0:34:34.89,نص عام,,0,0,0,,أسرع أيها المعلم والطالب
Dialogue: 0,0:36:14.16,0:36:15.33,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:36:17.41,0:36:19.58,مائل,,0,0,0,,إذن أنت تدربه
Dialogue: 0,0:36:22.63,0:36:24.50,النص العام,,0,0,0,,رأيته يمارس التانسو
Dialogue: 0,0:36:25.38,0:36:26.59,نص عام,,0,0,0,,أين تعلمت هذا؟
Dialogue: 0,0:36:27.17,0:36:31.18,نص عام,,0,0,0,,المالك ذكي كان عنده 12 معلم
Dialogue: 0,0:36:31.26,0:36:33.30,النص العام,,0,0,0,,إنه يحاول الركض دون أن يتعلم المشي حقًا
Dialogue: 0,0:36:33.39,0:36:35.51,نص عام,,0,0,0,,أمامه طريق طويل ليقطعه
Dialogue: 0,0:36:35.60,0:36:37.85,نص عام,,0,0,0,,الأمر يستحق المحاولة على الأقل
Dialogue: 0,0:36:38.43,0:36:41.14,general text,,0,0,0,,خطوته التالية قد تؤدي إلى وفاته
Dialogue: 0,0:36:45.15,0:36:47.36,النص العام,,0,0,0,,هل يعلم سيدك بهذا؟
Dialogue: 0,0:37:22.73,0:37:24.73,النص العام,,0,0,0,,لماذا لم تهرب؟
Dialogue: 0,0:37:24.81,0:37:25.90,نص عام,,0,0,0,,بجدية
Dialogue: 0,0:37:41.75,0:37:44.00,general text,,0,0,0,,هذه نتيجة إطلاق الطاقة إلى الخارج.
Dialogue: 0,0:37:45.17,0:37:47.21,النص العام,,0,0,0,,قد تنفجر ذراعك إذا تابعت
Dialogue: 0,0:37:53.38,0:37:56.72,general text,,0,0,0,,إنها على وشك أن تبدأ بالتعفن. ثم سيكون عليك قطعها
Dialogue: 0,0:37:57.39,0:37:58.51,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:38:02.68,0:38:05.77,general text,,0,0,0,,إذا انتشرت الطاقة المتحللة في جميع أنحاء جسمك،
Dialogue: 0,0:38:06.40,0:38:07.65,النص العام,,0,0,0,,سوف تموت
Dialogue: 0,0:38:27.38,0:38:29.63,النص العام,,0,0,0,,لقد هدأت الحرارة. هل أنت بخير
Dialogue: 0,0:38:29.71,0:38:31.34,نص عام,,0,0,0,,النوم. النوم هو أفضل دواء
Dialogue: 0,0:38:32.13,0:38:33.13,نص عام,,0,0,0,,كذاب
Dialogue: 0,0:38:35.30,0:38:37.09,نص عام,,0,0,0,,هل صحيح ما قاله؟
Dialogue: 0,0:38:37.64,0:38:39.47,مائل,,0,0,0,,لا يهم إذا مت من السم،
Dialogue: 0,0:38:39.55,0:38:42.35,general text,,0,0,0,,الجلد أو الضرب بالسيف أو من انفجار ذراعك
Dialogue: 0,0:38:43.06,0:38:46.44,نص عام,,0,0,0,,مدرسي لا يهتم بتلميذه
Dialogue: 0,0:38:48.02,0:38:49.44,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:38:50.36,0:38:54.36,نص عام,,0,0,0,,هذا لأنك محظوظ ومحظوظ جدًا
Dialogue: 0,0:38:55.11,0:38:57.45,general text,,0,0,0,,هل الكذب هو اسمك الأوسط؟
Dialogue: 0,0:39:00.62,0:39:02.70,نص عام,,0,0,0,,أنا فقط لا أريد إخافتك
Dialogue: 0,0:39:03.29,0:39:06.46,نص عام,,0,0,0,,فهمت. شكرا لك أستاذي الذي لا يرحم
Dialogue: 0,0:39:06.54,0:39:09.13,النص العام,,0,0,0,,لكن ابتعد عندما أحمل السيف مرة أخرى
Dialogue: 0,0:39:09.21,0:39:10.79,نص عام,,0,0,0,,كدت أطعنك اليوم
Dialogue: 0,0:39:10.88,0:39:14.26,general text,,0,0,0,,وقفت لأنني أردتك أن تتحكم في الطاقة بنفسك
Dialogue: 0,0:39:14.88,0:39:16.17,نص عام,,0,0,0,,لم أقصد التدخل
Dialogue: 0,0:39:16.26,0:39:19.01,نص عام,,0,0,0,,لم تتدخل. لقد كنت فقط قلقة عليك
Dialogue: 0,0:39:25.64,0:39:27.69,general text,,0,0,0,,فكر بي كالطير الأم الذي يشعر بالقلق...
Dialogue: 0,0:39:27.77,0:39:29.81,النص العام,,0,0,0,,أن بيضها سينكسر. هل يمكنك أن تتخيل؟
Dialogue: 0,0:39:29.90,0:39:32.44,نص عام,,0,0,0,,لا يهم. وهذا من شأنه أن يضرني بالكاد
Dialogue: 0,0:39:32.52,0:39:33.65,نص عام,,0,0,0,,يمكنني المراوغة
Dialogue: 0,0:39:34.40,0:39:35.61,نص عام,,0,0,0,,ألم يكن خطيرًا؟
Dialogue: 0,0:39:35.69,0:39:37.90,general text,,0,0,0,,كيف يمكنك المراوغة إذا كنت بهذه السرعة؟
Dialogue: 0,0:39:37.99,0:39:39.66,نص عام,,0,0,0,,ليس بهذه السرعة
Dialogue: 0,0:39:40.32,0:39:41.70,نص عام,,0,0,0,,الوغد...
Dialogue: 0,0:39:43.54,0:39:45.12,نص عام,,0,0,0,,سريعًا، أليس كذلك؟ لا دودج
Dialogue: 0,0:39:45.20,0:39:46.70,general text,,0,0,0,,لقد هاجمت دون سابق إنذار!
Dialogue: 0,0:39:46.79,0:39:48.54,نص عام,,0,0,0,,نعم؟ ثم هنا
Dialogue: 0,0:39:48.62,0:39:49.71,نص عام,,0,0,0,,مو دوك، عيون
Dialogue: 0,0:39:52.34,0:39:53.38,نص عام,,0,0,0,,أيها اللقيط
Dialogue: 0,0:39:53.46,0:39:55.46,النص العام,,0,0,0,,لقد اشتريته مرة أخرى، لا أستطيع أن أصدق ذلك
Dialogue: 0,0:40:00.43,0:40:01.68,نص عام,,0,0,0,,هيا مرة أخرى
Dialogue: 0,0:40:02.72,0:40:04.18,نص عام,,0,0,0,,من هذه المسافة؟
Dialogue: 0,0:40:04.26,0:40:05.85,النص العام,,0,0,0,,- بجد؟\N- هيا
Dialogue: 0,0:40:10.56,0:40:11.69,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:40:12.94,0:40:15.11,نص عام,,0,0,0,,العلامة الزرقاء مرئية في العيون
Dialogue: 0,0:40:15.98,0:40:17.32,نص عام,,0,0,0,,وجميل جداً
Dialogue: 0,0:40:21.20,0:40:24.78,general text,,0,0,0,,ومن الأفضل ألا تستفزني بقربك الشديد
Dialogue: 0,0:40:25.45,0:40:26.74,نص عام,,0,0,0,,أعتقد أنني أستطيع
Dialogue: 0,0:40:26.83,0:40:28.25,نص عام,,0,0,0,,من هذه المسافة
Dialogue: 0,0:40:32.50,0:40:34.50,نص عام,,0,0,0,,أعتقد أنك فهمت كلامي بشكل صحيح
Dialogue: 0,0:40:35.38,0:40:37.51,نص عام,,0,0,0,,ربما هناك شيء أستطيع أن أعلمك إياه
Dialogue: 0,0:40:41.97,0:40:43.14,نص عام,,0,0,0,,تشانغ ووك
Dialogue: 0,0:40:46.39,0:40:50.10,general text,,0,0,0,,هل تعتقد أنني ساذج إذا عشت هنا وحدي؟
Dialogue: 0,0:40:51.52,0:40:52.81,نص عام,,0,0,0,,حسنًا، نعم
Dialogue: 0,0:40:54.77,0:40:57.78,نص عام,,0,0,0,,أريدك أن تعلم أنني أستطيع أن أعلمك الكثير
Dialogue: 0,0:40:58.99,0:41:00.11,نص عام,,0,0,0,,مثلاً؟
Dialogue: 0,0:41:07.24,0:41:08.54,نص عام,,0,0,0,,مرحبًا! أنت...
Dialogue: 0,0:41:08.62,0:41:10.79,general text,,0,0,0,,الهجمات الفعالة حقًا هي
Dialogue: 0,0:41:10.87,0:41:14.00,النص العام,,0,0,0,,عندما لا يتوقع العدو ذلك على الإطلاق
Dialogue: 0,0:41:14.54,0:41:16.38,نص عام,,0,0,0,,تذكر هذا يا تلميذي
Dialogue: 0,0:41:17.59,0:41:21.05,general text,,0,0,0,,بالكاد لمسك، وبذلت كل ما في وسعك!
Dialogue: 0,0:41:21.13,0:41:22.76,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:41:24.43,0:41:26.76,نص عام,,0,0,0,,مرحبًا مو ديوك
Dialogue: 0,0:41:36.98,0:41:38.78,خط مائل,,0,0,0,,خليلة جديدة؟
Dialogue: 0,0:41:39.61,0:41:42.70,نص عام,,0,0,0,,والآن هو لا يتبع حتى الشكليات
Dialogue: 0,0:41:43.32,0:41:45.57,مائل,,0,0,0,,إنها من عائلة صغيرة من السحرة في الشرق
Dialogue: 0,0:41:45.66,0:41:48.91,مائل,,0,0,0,,في عيد ميلادها، مر مذنب عبر الدب الأكبر
Dialogue: 0,0:41:48.99,0:41:52.71,general text,,0,0,0,,فسوف يجمع كل النساء المولودات في ليالي غير عادية
Dialogue: 0,0:41:52.79,0:41:55.42,مائل,,0,0,0,,يريد الإمساك بنجمة الملك
Dialogue: 0,0:42:06.43,0:42:08.35,النص العام,,0,0,0,,عندما اعتلى الملك الراحل العرش،
Dialogue: 0,0:42:08.43,0:42:12.64,general text,,0,0,0,,كان من المتوقع أن يولد القادم تحت نجم الملك
Dialogue: 0,0:42:13.77,0:42:16.52,نص عام,,0,0,0,,كان أهل ديهو سعداء
Dialogue: 0,0:42:16.60,0:42:17.48,نص عام,,0,0,0,,ولكن
Dialogue: 0,0:42:17.56,0:42:20.69,general text,,0,0,0,,العرش أخذه والدك، ولد في ليلة عادية
Dialogue: 0,0:42:20.78,0:42:22.57,نص عام,,0,0,0,,وإلا مثلك
Dialogue: 0,0:42:23.36,0:42:24.90,نص عام,,0,0,0,,فبدأت المحادثات
Dialogue: 0,0:42:25.78,0:42:27.62,نص عام,,0,0,0,,التوقع غير صحيح
Dialogue: 0,0:42:27.70,0:42:31.41,general text,,0,0,0,,هرب غوانغجو تشانغ جانج بعد أن قام بهذا التنبؤ المضحك
Dialogue: 0,0:42:31.49,0:42:33.54,general text,,0,0,0,,أبوك يؤمن به
Dialogue: 0,0:42:34.12,0:42:35.87,نص عام,,0,0,0,,فأنت خائف
Dialogue: 0,0:42:38.33,0:42:39.79,نص عام,,0,0,0,,لست خائفاً
Dialogue: 0,0:42:39.88,0:42:42.67,general text,,0,0,0,,أنت خائف من ظهور شخص بهذه الطاقة،
Dialogue: 0,0:42:42.76,0:42:44.92,النص العام,,0,0,0,,أو أن يكون لوالدك ولد
Dialogue: 0,0:42:45.80,0:42:47.64,خط مائل,,0,0,0,,أعلم ذلك
Dialogue: 0,0:42:51.06,0:42:53.81,general text,,0,0,0,,معركتك مع تشان ووك على الأبواب
Dialogue: 0,0:42:53.89,0:42:57.23,general text,,0,0,0,,دمر ابن الذي تنبأ بهذا
Dialogue: 0,0:42:58.86,0:43:01.65,النص العام,,0,0,0,,تخلص من مخاوفك الآن بعد أن سنحت لك الفرصة
Dialogue: 0,0:43:04.28,0:43:05.45,نص عام,,0,0,0,,هل تعتقد,
Dialogue: 0,0:43:06.32,0:43:07.78,نص عام,,0,0,0,,هل سيظهر؟
Dialogue: 0,0:43:08.78,0:43:09.87,نص عام,,0,0,0,,سمعت أنه كان يركض
Dialogue: 0,0:43:10.78,0:43:14.25,general text,,0,0,0,,هناك شائعات بأنه مستعد حتى للزواج، فقط ليس للقتال
Dialogue: 0,0:43:15.41,0:43:16.71,نص عام,,0,0,0,,الزواج؟
Dialogue: 0,0:43:16.79,0:43:20.71,general text,,0,0,0,,سمعت أنه سينضم إلى عائلة جين لاستخدام تميمة عائلتهم
Dialogue: 0,0:43:27.13,0:43:29.14,general text,,0,0,0,,هل سيتزوج ووك وجو يونغ؟
Dialogue: 0,0:43:29.93,0:43:31.76,النص العام,,0,0,0,,فسخوا خطوبتهم مرة واحدة
Dialogue: 0,0:43:32.68,0:43:34.64,نص عام,,0,0,0,,لذلك أصبح الاستعداد لحفل الزفاف أسهل
Dialogue: 0,0:43:35.43,0:43:38.64,نص عام,,0,0,0,,لا يزال لديها هدايا الزفاف
Dialogue: 0,0:43:38.73,0:43:40.90,نص عام,,0,0,0,,من المرة السابقة
Dialogue: 0,0:43:43.94,0:43:45.03,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:43:45.53,0:43:48.40,خط مائل,,0,0,0,,بعد زفاف تشان ووك...
Dialogue: 0,0:43:48.49,0:43:51.45,نص عام,,0,0,0,,أي أن زوجي سينتقل هنا
Dialogue: 0,0:43:51.95,0:43:54.45,النص العام,,0,0,0,,لكن غرفتي صغيرة جدًا بالنسبة لنا نحن الاثنين
Dialogue: 0,0:43:54.54,0:43:59.00,general text,,0,0,0,,هل يمكننا استخدام الغرفة الكبيرة في الجناح الشرقي؟
Dialogue: 0,0:43:59.58,0:44:02.34,نص عام,,0,0,0,,هذه غرفة أختك
Dialogue: 0,0:44:03.84,0:44:06.38,نص عام,,0,0,0,,هذه أفضل غرفتنا
Dialogue: 0,0:44:06.46,0:44:09.51,النص العام,,0,0,0,,من المؤسف أن نبقيه فارغًا لسنوات عديدة
Dialogue: 0,0:44:10.51,0:44:11.97,نص عام,,0,0,0,,ليس فارغاً
Dialogue: 0,0:44:12.68,0:44:14.39,نص عام,,0,0,0,,سيعود بو يونغ
Dialogue: 0,0:44:15.81,0:44:17.56,نص عام,,0,0,0,,عذراً يا أمي
Dialogue: 0,0:44:20.31,0:44:22.19,النص العام,,0,0,0,,والدك يبحث عنها
Dialogue: 0,0:44:23.36,0:44:26.44,نص عام,,0,0,0,,ستعود أختك إلى المنزل قريبًا
Dialogue: 0,0:44:28.86,0:44:31.24,النص العام,,0,0,0,,أحضر لي اليشم يين ويانغ من جينيوون
Dialogue: 0,0:44:33.66,0:44:34.95,نص عام,,0,0,0,,يين ويانغ؟
Dialogue: 0,0:44:35.03,0:44:36.41,نص عام,,0,0,0,,لقد أردته
Dialogue: 0,0:44:37.95,0:44:41.00,general text,,0,0,0,,يقولون أنه إذا ارتدى الزوجان خواتم مصنوعة من هذا اليشم،
Dialogue: 0,0:44:41.08,0:44:42.79,النص العام,,0,0,0,,الحب سيزداد قوة
Dialogue: 0,0:44:44.92,0:44:47.92,نص عام,,0,0,0,,فليصنعوا منها حلقات
Dialogue: 0,0:44:49.34,0:44:51.09,نص عام,,0,0,0,,شكرًا لك يا أمي
Dialogue: 0,0:45:14.62,0:45:16.99,نص عام,,0,0,0,,الجرّة المزعجة. هل هذا أنت؟
Dialogue: 0,0:45:17.49,0:45:19.04,نص عام,,0,0,0,,غضب
Dialogue: 0,0:45:26.00,0:45:27.25,نص عام,,0,0,0,,أعتقد أنك غاضب،
Dialogue: 0,0:45:27.34,0:45:29.42,نص عام,,0,0,0,,أنني سأتزوج
Dialogue: 0,0:45:29.51,0:45:30.55,نص عام,,0,0,0,,سترى
Dialogue: 0,0:45:30.63,0:45:32.22,نص عام,,0,0,0,,ستغضب أكثر،
Dialogue: 0,0:45:32.30,0:45:34.05,نص عام,,0,0,0,,عندما ارتديت خاتم اليشم هذا
Dialogue: 0,0:45:46.36,0:45:47.94,نص عام,,0,0,0,,تناول الطعام
Dialogue: 0,0:45:48.94,0:45:50.23,نص عام,,0,0,0,,لذا
Dialogue: 0,0:45:52.61,0:45:55.11,نص عام,,0,0,0,,لقد أحضرت طائر الدراج
Dialogue: 0,0:45:55.20,0:45:57.16,نص عام,,0,0,0,,لماذا لا يوجد هنا سوى الخضرة؟
Dialogue: 0,0:45:57.24,0:45:58.66,نص عام,,0,0,0,,إنه هناك...
Dialogue: 0,0:45:59.33,0:46:00.24,نص عام,,0,0,0,,إنه في الحساء
Dialogue: 0,0:46:00.33,0:46:02.08,نص عام,,0,0,0,,كان الدراج صغيراً جداً
Dialogue: 0,0:46:02.16,0:46:03.92,النص العام,,0,0,0,,لم يبق إلا القليل عندما أعددت المرق
Dialogue: 0,0:46:14.84,0:46:16.93,نص عام,,0,0,0,,الطعم ضعيف جداً
Dialogue: 0,0:46:21.93,0:46:24.73,نص عام,,0,0,0,,سمعت شيئًا أثناء بيع الأعشاب في سوسنوفي بور
Dialogue: 0,0:46:24.81,0:46:27.19,general text,,0,0,0,,عائلتان نبيلتان تتزوجان أبناءهما
Dialogue: 0,0:46:27.77,0:46:29.69,نص عام,,0,0,0,,ومن هذا؟
Dialogue: 0,0:46:29.77,0:46:32.69,النص العام,,0,0,0,,ابنة السيدة جين ستتزوج
Dialogue: 0,0:46:33.40,0:46:36.45,general text,,0,0,0,,هل وجدت يونغ نفسها عريساً؟ من هو؟
Dialogue: 0,0:46:36.53,0:46:38.66,نص عام,,0,0,0,,ابن غوانغجو جيونبوغوان
Dialogue: 0,0:46:40.95,0:46:42.33,نص عام,,0,0,0,,أليس هذا أنت؟
Dialogue: 0,0:46:53.26,0:46:56.47,نص عام,,0,0,0,,لم أقل أنني سأتزوج. ماذا يحدث؟
Dialogue: 0,0:46:56.55,0:46:58.22,general text,,0,0,0,,ماذا تفعل الخادمة كيم هناك؟
Dialogue: 0,0:46:58.30,0:47:01.06,general text,,0,0,0,,الزواج المتسرع يحدث بسبب ظهور طفل
Dialogue: 0,0:47:01.14,0:47:02.18,نص عام,,0,0,0,,لا
Dialogue: 0,0:47:02.77,0:47:04.35,نص عام,,0,0,0,,لقد كنت مخطوباً بالفعل
Dialogue: 0,0:47:05.02,0:47:06.60,نص عام,,0,0,0,,ربما لم تتمالك نفسك
Dialogue: 0,0:47:06.69,0:47:09.90,general text,,0,0,0,,لم نكن قريبين جدًا من قبل، كيف يمكن أن تحمل؟
Dialogue: 0,0:47:10.73,0:47:12.86,النص العام,,0,0,0,,حسنًا، نعم، أنت جيد جدًا في التحدث
Dialogue: 0,0:47:12.94,0:47:14.11,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:47:14.19,0:47:16.07,general text,,0,0,0,,إذن لماذا رفضت شرب شاي العفة؟
Dialogue: 0,0:47:16.15,0:47:17.15,نص عام,,0,0,0,,هذا لأن...
Dialogue: 0,0:47:19.57,0:47:21.24,نص عام,,0,0,0,,أنك بحاجة للزواج
Dialogue: 0,0:47:23.08,0:47:24.83,نص عام,,0,0,0,,لذلك أريد أن أتزوج
Dialogue: 0,0:47:26.12,0:47:27.67,نص عام,,0,0,0,,نعم أود ذلك
Dialogue: 0,0:47:27.75,0:47:28.87,نص عام,,0,0,0,,أريد حقاً أن
Dialogue: 0,0:47:29.63,0:47:32.17,نص عام,,0,0,0,,بالتأكيد سأتزوج
Dialogue: 0,0:47:32.25,0:47:33.50,نص عام,,0,0,0,,سترى
Dialogue: 0,0:47:48.73,0:47:50.44,مائل,,0,0,0,,لماذا أردت رؤيتي؟
Dialogue: 0,0:47:51.23,0:47:54.65,general text,,0,0,0,,متى ستصل خزانة عرق اللؤلؤ التي طلبتها من سوسنوفي بور؟
Dialogue: 0,0:47:55.28,0:47:56.53,نص عام,,0,0,0,,إنه لي ولبريطانيا
Dialogue: 0,0:47:56.61,0:48:00.61,نص عام,,0,0,0,,البضائع من الجنوب ستصل في يوم من أيام الأسبوع
Dialogue: 0,0:48:01.37,0:48:02.66,نص عام,,0,0,0,,لقد تأخر الوقت
Dialogue: 0,0:48:03.66,0:48:05.12,نص عام,,0,0,0,,كان ينبغي الطلب مبكرًا
Dialogue: 0,0:48:05.20,0:48:07.08,نص عام,,0,0,0,,انس أمر الخزانة
Dialogue: 0,0:48:07.62,0:48:09.54,نص عام,,0,0,0,,يجب أن أخبر أوكو
Dialogue: 0,0:48:10.88,0:48:12.21,نص عام,,0,0,0,,لا يعلم
Dialogue: 0,0:48:14.30,0:48:16.92,نص عام,,0,0,0,,فكتبت له رسالة
Dialogue: 0,0:48:17.72,0:48:19.18,نص عام,,0,0,0,,اقرأ وشارك أفكارك
Dialogue: 0,0:48:20.89,0:48:22.01,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:48:25.72,0:48:26.85,نص عام,,0,0,0,,رائحتها
Dialogue: 0,0:48:26.93,0:48:29.23,النص العام,,0,0,0,,هذا هو البخور الذي يحمل الحب
Dialogue: 0,0:48:30.14,0:48:31.60,النص العام,,0,0,0,,كنز جينيوون
Dialogue: 0,0:48:33.36,0:48:35.98,نص عام,,0,0,0,,رائحته جميلة جداً
Dialogue: 0,0:48:57.80,0:48:59.55,النص العام,,0,0,0,,لماذا تشمها؟
Dialogue: 0,0:48:59.63,0:49:00.59,نص عام,,0,0,0,,توقف!
Dialogue: 0,0:49:01.72,0:49:03.64,نص عام,,0,0,0,,وأغلق أنفك!
Dialogue: 0,0:49:15.98,0:49:17.82,نص عام,,0,0,0,,كدت أضيع كل شيء
Dialogue: 0,0:49:21.03,0:49:22.74,نص عام,,0,0,0,,أعط الرسالة إلى أوكو
Dialogue: 0,0:49:23.32,0:49:26.53,general text,,0,0,0,,وتأكد من عدم وجود امرأة بالقرب منه عندما يفتح
Dialogue: 0,0:49:29.33,0:49:30.16,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:49:35.50,0:49:36.63,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:49:36.71,0:49:41.38,general text,,0,0,0,,أنت والمملكة المتحدة لديكما نفس الأيدي، أليس كذلك؟
Dialogue: 0,0:49:43.38,0:49:44.59,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:49:45.39,0:49:47.89,نص عام,,0,0,0,,تعالوا معي لشراء خواتم الزفاف
Dialogue: 0,0:49:47.97,0:49:49.31,نص عام,,0,0,0,,ساعدني
Dialogue: 0,0:49:50.06,0:49:52.52,النص العام,,0,0,0,,لماذا يجب أن أذهب معك إلى هناك؟
Dialogue: 0,0:49:52.60,0:49:53.77,نص عام,,0,0,0,,اذهبي مع خطيبك
Dialogue: 0,0:49:54.81,0:49:58.94,النص العام,,0,0,0,,يجب أن يتم الزواج بالتراضي
Dialogue: 0,0:49:59.57,0:50:02.32,النص العام,,0,0,0,,من المحزن أن تتصرف بهذه الطريقة
Dialogue: 0,0:50:03.61,0:50:04.45,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:50:06.03,0:50:07.99,النص العام,,0,0,0,,هل تعتقد أنني أتعجل في الأمور؟
Dialogue: 0,0:50:08.70,0:50:10.74,general text,,0,0,0,,أم أنه سيرفض مرة أخرى؟
Dialogue: 0,0:50:15.71,0:50:18.42,النص العام,,0,0,0,,هل أنت مستعجل أم لا،
Dialogue: 0,0:50:19.96,0:50:21.38,نص عام,,0,0,0,,سأساعدك
Dialogue: 0,0:50:22.21,0:50:23.38,نص عام,,0,0,0,,ليتها تنجح
Dialogue: 0,0:50:28.43,0:50:30.18,نص عام,,0,0,0,,وسأقدم لك المساعدة أيضًا
Dialogue: 0,0:50:39.36,0:50:40.94,مائل,,0,0,0,,إذا فكرت في الأمر،
Dialogue: 0,0:50:41.03,0:50:43.65,general text,,0,0,0,,الخادمة كيم كانت ضدي في العيش مع عائلة زوجتي،
Dialogue: 0,0:50:43.74,0:50:45.82,general text,,0,0,0,,متى كانت آخر مرة ناقشنا فيها الزواج مع تشو يونغ
Dialogue: 0,0:50:47.20,0:50:50.49,general text,,0,0,0,,هناك سبب واحد فقط وراء بدء الحديث عن الزواج مرة أخرى
Dialogue: 0,0:50:50.99,0:50:52.20,نص عام,,0,0,0,,دفاعي
Dialogue: 0,0:50:52.79,0:50:55.04,general text,,0,0,0,,لقد عقدت صفقة مع عائلة جين،
Dialogue: 0,0:50:55.12,0:50:57.46,نص عام,,0,0,0,,لمساعدتك على تجنب القتال
Dialogue: 0,0:50:57.54,0:50:59.54,النص العام,,0,0,0,,ربما كانت بحاجة إلى تأثير مدام جين
Dialogue: 0,0:51:01.00,0:51:02.63,نص عام,,0,0,0,,في هذه الحالة،
Dialogue: 0,0:51:03.67,0:51:05.09,نص عام,,0,0,0,,الزواج؟
Dialogue: 0,0:51:06.84,0:51:09.85,نص عام,,0,0,0,,ماذا علي أن أفعل أيها المعلم؟ الزواج؟
Dialogue: 0,0:51:12.22,0:51:13.35,نص عام,,0,0,0,,هل يستحق الأمر؟
Dialogue: 0,0:51:15.18,0:51:18.90,general text,,0,0,0,,في هذه الحالة، ليس هناك سبب للبقاء هنا بعد الآن
Dialogue: 0,0:51:19.48,0:51:21.40,نص عام,,0,0,0,,بالضبط. نحن بحاجة للعودة إلى المنزل
Dialogue: 0,0:51:21.48,0:51:23.69,general text,,0,0,0,,لكن علاقتنا بالطبع لن تصمد.
Dialogue: 0,0:51:23.78,0:51:26.65,نص عام,,0,0,0,,لماذا؟ لا يزال بإمكانك أن تكون خادمتي
Dialogue: 0,0:51:28.86,0:51:31.53,النص العام,,0,0,0,,خططي لا تتضمن أن أكون هي إلى الأبد
Dialogue: 0,0:51:49.76,0:51:51.39,النص العام,,0,0,0,,ثم ستبحر بمفردك
Dialogue: 0,0:51:51.47,0:51:52.97,نص عام,,0,0,0,,سأكون في تشويسونغرو
Dialogue: 0,0:51:54.31,0:51:57.39,النص العام,,0,0,0,,إذا لم تأت من أجلي سأغادر وحدي
Dialogue: 0,0:52:12.12,0:52:13.87,نص عام,,0,0,0,,تشويسونجرو
Dialogue: 0,0:52:19.33,0:52:20.33,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:52:20.42,0:52:22.08,نص عام,,0,0,0,,نحن من جيونبوغوان
Dialogue: 0,0:52:22.17,0:52:24.04,نص عام,,0,0,0,,سنأخذك إلى هناك
Dialogue: 0,0:52:24.13,0:52:24.96,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:52:28.38,0:52:30.30,مائل,,0,0,0,,هذا هو كيس سموه
Dialogue: 0,0:52:30.38,0:52:34.05,general text,,0,0,0,,أنا تحت حماية الأمير نفسه، لا تجرؤ على لمسي
Dialogue: 0,0:52:37.27,0:52:39.73,نص عام,,0,0,0,,ماذا تفعل؟ اتركه!
Dialogue: 0,0:52:39.81,0:52:41.69,نص عام,,0,0,0,,هذا هو كيس ولي العهد
Dialogue: 0,0:52:53.70,0:52:55.91,النص العام,,0,0,0,,سلمناها من تشويسنجرو
Dialogue: 0,0:52:56.54,0:52:58.33,نص عام,,0,0,0,,تشويسونغرو؟
Dialogue: 0,0:53:07.13,0:53:09.55,نص عام,,0,0,0,,الفتاة التي سألتها وصلت
Dialogue: 0,0:53:10.17,0:53:11.30,نص عام,,0,0,0,,أين هي؟
Dialogue: 0,0:53:15.01,0:53:16.10,نص عام,,0,0,0,,هنا
Dialogue: 0,0:53:18.43,0:53:19.39,نص عام,,0,0,0,,هي؟
Dialogue: 0,0:53:19.93,0:53:21.52,نص عام,,0,0,0,,ارفع رأسك
Dialogue: 0,0:53:33.07,0:53:34.70,النص العام,,0,0,0,,لماذا ترتدين هكذا؟
Dialogue: 0,0:53:35.28,0:53:36.78,نص عام,,0,0,0,,لا فكرة
Dialogue: 0,0:53:37.32,0:53:40.53,general text,,0,0,0,,لقد غيرت ملابسي بمجرد أن أحضروني إلى هنا
Dialogue: 0,0:53:41.49,0:53:43.66,النص العام,,0,0,0,,هل هذا من صنعك؟
Dialogue: 0,0:53:43.75,0:53:45.83,النص العام,,0,0,0,,أليست كيسينغ...
Dialogue: 0,0:53:46.71,0:53:47.96,نص عام,,0,0,0,,من تشويسنجرو؟
Dialogue: 0,0:53:49.13,0:53:50.29,نص عام,,0,0,0,,لا
Dialogue: 0,0:53:51.84,0:53:54.26,general text,,0,0,0,,- هي كريهة الرائحة مو دوك\N- V-كريهة الرائحة؟
Dialogue: 0,0:53:56.34,0:53:57.59,نص عام,,0,0,0,,اخرج
Dialogue: 0,0:53:58.51,0:53:59.76,نص عام,,0,0,0,,انطلق
Dialogue: 0,0:54:02.89,0:54:04.14,نص عام,,0,0,0,,انظر لنفسك فقط
Dialogue: 0,0:54:08.35,0:54:10.36,نص عام,,0,0,0,,لماذا أردت رؤيتي؟
Dialogue: 0,0:54:10.44,0:54:14.28,النص العام,,0,0,0,,أردت أن أقول شيئاً فأمرت بتسليمك
Dialogue: 0,0:54:14.36,0:54:16.36,النص العام,,0,0,0,,ولكنك الآن لست وون مو دوك
Dialogue: 0,0:54:16.45,0:54:18.07,general text,,0,0,0,,الرائحة الكريهة والحرير لا يجتمعان
Dialogue: 0,0:54:18.78,0:54:21.37,نص عام,,0,0,0,,في قاموسك إنه أمر مهم جدًا
Dialogue: 0,0:54:22.41,0:54:23.79,نص عام,,0,0,0,,هل التقطت للتو؟
Dialogue: 0,0:54:23.87,0:54:25.41,نص عام,,0,0,0,,لا
Dialogue: 0,0:54:25.50,0:54:28.46,النص العام,,0,0,0,,أنا ممتن لأنهم ألبسوني الحرير
الحوار: 0,0:54:30.08,0:54:33.34,نص عام,,0,0,0,,مقبول. هذا المظهر الجديد...
Dialogue: 0,0:54:35.21,0:54:36.59,نص عام,,0,0,0,,لا يناسبك
Dialogue: 0,0:54:39.38,0:54:42.85,النص العام,,0,0,0,,لا يعجبك هذا، أنا غير مرتاح لهذا،
Dialogue: 0,0:54:42.93,0:54:44.18,نص عام,,0,0,0,,سأغير ملابسي
Dialogue: 0,0:54:44.26,0:54:45.35,نص عام,,0,0,0,,لا
Dialogue: 0,0:54:46.52,0:54:49.10,نص عام,,0,0,0,,لا يهم. اترك الأمر كما هو
Dialogue: 0,0:54:51.56,0:54:55.65,نص عام,,0,0,0,,قل ما تريد وسأفعله
Dialogue: 0,0:54:55.73,0:54:58.03,نص عام,,0,0,0,,أخبر سيدك...
Dialogue: 0,0:54:58.65,0:54:59.95,نص عام,,0,0,0,,لا تأتي في ذلك اليوم
Dialogue: 0,0:55:01.11,0:55:02.45,نص عام,,0,0,0,,لا أريد أن أقتله
Dialogue: 0,0:55:02.53,0:55:05.70,مائل,,0,0,0,,وأصبح عدوًا لغابة الصنوبر وعائلة تشان.
Dialogue: 0,0:55:06.41,0:55:08.71,general text,,0,0,0,,سيكون من الأفضل أن يهرب ويترك كل شيء كما هو
Dialogue: 0,0:55:10.25,0:55:12.71,النص العام,,0,0,0,,أي أنه يحتاج فقط إلى أن يظل أضحوكة
Dialogue: 0,0:55:13.38,0:55:14.42,خط مائل,,0,0,0,,صحيح
Dialogue: 0,0:55:15.05,0:55:18.34,general text,,0,0,0,,إذا عنيد فأقنعه بالعدول عنه
Dialogue: 0,0:55:18.42,0:55:20.34,general text,,0,0,0,,لن ينجو من قتال معي
Dialogue: 0,0:55:22.93,0:55:26.06,نص عام,,0,0,0,,دعه يجلس بهدوء ثم يتزوج جين تشو يونغ
Dialogue: 0,0:55:27.35,0:55:30.44,general text,,0,0,0,,فصحيح أن الزواج سينقذ حياته
Dialogue: 0,0:55:33.19,0:55:35.48,general text,,0,0,0,,ماذا سيحدث لك لو تزوج؟
Dialogue: 0,0:55:35.57,0:55:36.69,نص عام,,0,0,0,,هل ستبقى معه؟
Dialogue: 0,0:55:37.36,0:55:38.65,نص عام,,0,0,0,,لن أبقى
Dialogue: 0,0:55:39.28,0:55:41.95,نص عام,,0,0,0,,لماذا؟ هل تخلى عنك؟
Dialogue: 0,0:55:44.37,0:55:47.24,general text,,0,0,0,,وكنت مستعداً لشرب الماء من إناء الحجرة من أجله
Dialogue: 0,0:55:47.33,0:55:49.00,مائل,,0,0,0,,ليس لديه ولاء،
Dialogue: 0,0:55:49.08,0:55:50.41,نص عام,,0,0,0,,لا كرامة
Dialogue: 0,0:55:51.62,0:55:55.84,نص عام,,0,0,0,,هناك شيء يا صاحب السمو
Dialogue: 0,0:55:55.92,0:55:58.34,النص العام,,0,0,0,,هل تحميه؟ وعادة ما قالت أشياء سيئة
Dialogue: 0,0:55:58.42,0:56:00.22,نص عام,,0,0,0,,سامحوني
Dialogue: 0,0:56:01.17,0:56:03.47,general text,,0,0,0,,سيكون من دواعي سرورك أن تسمع أشياء سيئة عنه،
Dialogue: 0,0:56:04.30,0:56:08.06,نص عام,,0,0,0,,لكنني الآن لا أملك القوة للكلام
Dialogue: 0,0:56:09.60,0:56:12.23,general text,,0,0,0,,أنت هجين قذر سيتخلى عنه مالكك
Dialogue: 0,0:56:23.57,0:56:24.61,نص عام,,0,0,0,,هل تريدني أن آخذه إليك؟
Dialogue: 0,0:56:26.74,0:56:27.99,نص عام,,0,0,0,,أستطيع
Dialogue: 0,0:56:28.58,0:56:30.87,نص عام,,0,0,0,,ستجد عملاً هنا أيضًا
Dialogue: 0,0:56:32.21,0:56:33.08,نص عام,,0,0,0,,لا أريد
Dialogue: 0,0:56:34.50,0:56:37.38,general text,,0,0,0,,دعني أكون وون مو دوك، الذي يتجنبه الجميع،
Dialogue: 0,0:56:37.96,0:56:40.76,نص عام,,0,0,0,,لكنني لا أخدم الجميع
Dialogue: 0,0:56:44.26,0:56:46.89,نص عام,,0,0,0,,انسى. أنت لم تتخلى عني أيضا
Dialogue: 0,0:56:47.51,0:56:49.56,مائل,,0,0,0,,- يمكنك الذهاب\N-{\i0} نعم
Dialogue: 0,0:56:55.10,0:56:56.65,نص عام,,0,0,0,,ثم سأذهب،
Dialogue: 0,0:56:57.23,0:56:58.48,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:57:08.03,0:57:09.41,نص عام,,0,0,0,"إلى الجميع"؟
Dialogue: 0,0:57:10.74,0:57:12.04,نص عام,,0,0,0,,أنا أمير
Dialogue: 0,0:57:12.12,0:57:14.12,النص العام,,0,0,0,,وون مو دوك لا يفهم،
Dialogue: 0,0:57:14.21,0:57:15.75,نص عام,,0,0,0,,مع من يتحدث
Dialogue: 0,0:57:33.23,0:57:35.98,نص عام,,0,0,0,,- كن حذرًا. لاrush\N- نعم، سيدتي
Dialogue: 0,0:57:38.11,0:57:38.94,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:57:40.36,0:57:41.23,نص عام,,0,0,0,,كيف حالك؟
Dialogue: 0,0:57:42.48,0:57:43.57,نص عام,,0,0,0,,السيد الشاب!
Dialogue: 0,0:57:44.19,0:57:45.70,نص عام,,0,0,0,,عزيزتي!
Dialogue: 0,0:57:47.70,0:57:49.57,general text,,0,0,0,,- السيد الشاب!\N- هل كنت قلقاً؟
Dialogue: 0,0:57:49.66,0:57:50.87,النص العام,,0,0,0,,هل أكلت جيداً؟
Dialogue: 0,0:57:50.95,0:57:52.58,نص عام,,0,0,0,,نعم جيد
Dialogue: 0,0:57:52.66,0:57:54.12,نص عام,,0,0,0,,يا لها من سعادة
Dialogue: 0,0:57:54.20,0:57:55.71,النص العام,,0,0,0,,بشرتك متوهجة
Dialogue: 0,0:57:55.79,0:57:56.92,نص عام,,0,0,0,,ما الذي تتحدث عنه!
Dialogue: 0,0:57:57.00,0:57:58.29,نص عام,,0,0,0,,دعونا نذهب إلى الداخل
Dialogue: 0,0:58:01.96,0:58:03.80,النص العام,,0,0,0,,كانت تحاول بيعه
Dialogue: 0,0:58:06.47,0:58:07.84,نص عام,,0,0,0,,تميمة من سوسنوفي بور؟
Dialogue: 0,0:58:15.77,0:58:17.85,نص عام,,0,0,0,,لم أكن أنا. كل هذا هو مو دوك
Dialogue: 0,0:58:18.65,0:58:20.86,general text,,0,0,0,,حاول مو دوك بيع تميمة ووك؟
Dialogue: 0,0:58:20.94,0:58:23.19,نص عام,,0,0,0,,لقد عرفتها للتو على البائع
Dialogue: 0,0:58:23.28,0:58:25.28,النص العام,,0,0,0,,في النهاية، آه هيانغ سرقها
Dialogue: 0,0:58:25.36,0:58:27.32,النص العام,,0,0,0,,لذلك لا علاقة لي أنا ومو ديوك بالأمر
Dialogue: 0,0:58:45.05,0:58:46.34,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:58:47.72,0:58:49.97,النص العام,,0,0,0,,لماذا ترتدي هكذا؟
Dialogue: 0,0:58:50.72,0:58:52.43,نص عام,,0,0,0,,قصة طويلة
Dialogue: 0,0:58:52.51,0:58:55.27,general text,,0,0,0,,هل عدت إلى تشويسونغ را؟
Dialogue: 0,0:58:56.14,0:58:58.39,general text,,0,0,0,,هل باعك المملكة المتحدة لأنه سيتزوج؟
Dialogue: 0,0:58:58.48,0:58:59.77,نص عام,,0,0,0,,لا
Dialogue: 0,0:58:59.85,0:59:03.77,نص عام,,0,0,0,,حتى لو بيعت لن أعود إلى هنا
Dialogue: 0,0:59:03.86,0:59:05.86,general text,,0,0,0,,أخيرًا استسلم جو وول وأخبرني،
Dialogue: 0,0:59:05.94,0:59:07.65,نص عام,,0,0,0,,أنك حاولت بيع تميمة أوكا
Dialogue: 0,0:59:10.99,0:59:12.82,نص عام,,0,0,0,,نعم حاولت
Dialogue: 0,0:59:13.70,0:59:14.62,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:59:15.74,0:59:17.50,نص عام,,0,0,0,,لأنني كنت بحاجة إلى المال
Dialogue: 0,0:59:17.58,0:59:20.29,النص العام,,0,0,0,,أردت أن ألبس الحرير، وأتناول الحلويات،
Dialogue: 0,0:59:20.37,0:59:22.88,نص عام,,0,0,0,,وإستمتع في مثل هذه الأماكن
Dialogue: 0,0:59:22.96,0:59:26.46,النص العام,,0,0,0,,لهذا السبب سكرت في المرة الماضية
Dialogue: 0,0:59:27.38,0:59:30.63,نص عام,,0,0,0,,نعم. لقد سرقت أموال مالكي وسكرت
Dialogue: 0,0:59:35.22,0:59:37.27,نص عام,,0,0,0,,أنا في حيرة حقًا
Dialogue: 0,0:59:38.98,0:59:41.48,نص عام,,0,0,0,,أنا فقط لا أفهمك
Dialogue: 0,0:59:44.90,0:59:47.19,نص عام,,0,0,0,,ولست بحاجة إليه
Dialogue: 0,0:59:47.28,0:59:49.07,نص عام,,0,0,0,,اترك كل شيء كما هو
Dialogue: 0,0:59:51.15,0:59:52.78,نص عام,,0,0,0,,أنا قادم
Dialogue: 0,0:59:52.86,0:59:54.53,نص عام,,0,0,0,,هل تريد الانضمام إلي؟
Dialogue: 0,0:59:55.33,0:59:56.24,نص عام,,0,0,0,,لا
Dialogue: 0,0:59:57.49,0:59:58.62,نص عام,,0,0,0,,وداعا
Dialogue: 0,1:00:11.80,1:00:13.26,نص عام,,0,0,0,,تميمة...
Dialogue: 0,1:00:14.64,1:00:17.81,نص عام,,0,0,0,,إذن أنت، ناك سو
Dialogue: 0,1:00:27.94,1:00:29.07,نص عام,,0,0,0,,سيد.
Dialogue: 0,1:00:30.86,1:00:32.86,نص عام,,0,0,0,,لماذا لا تريد الزواج؟
Dialogue: 0,1:00:34.70,1:00:36.24,نص عام,,0,0,0,,أنت لا تحب السيدة جين؟
Dialogue: 0,1:00:36.32,1:00:38.66,نص عام,,0,0,0,,ليس الأمر أنني لا أحبها
Dialogue: 0,1:00:39.70,1:00:41.58,نص عام,,0,0,0,,أنا فقط غير مهتم
Dialogue: 0,1:00:42.21,1:00:44.33,نص عام,,0,0,0,,هل تحب شخصًا آخر؟
Dialogue: 0,1:00:45.71,1:00:46.92,نص عام,,0,0,0,,من؟
Dialogue: 0,1:00:47.50,1:00:49.00,نص عام,,0,0,0,,هل أعرفها؟
Dialogue: 0,1:00:50.01,1:00:52.05,نص عام,,0,0,0,,لا، أنت لا تعرفها
Dialogue: 0,1:00:52.63,1:00:53.84,نص عام,,0,0,0,,إذن هناك شخص ما
Dialogue: 0,1:00:53.93,1:00:55.18,نص عام,,0,0,0,,كنت أعرف ذلك
Dialogue: 0,1:00:55.26,1:00:56.30,نص عام,,0,0,0,,من هي؟
Dialogue: 0,1:00:57.85,1:00:58.89,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,1:00:58.97,1:01:01.89,general text,,0,0,0,,إنها مثل بيضة وحيدة في عش وليس في أعلى شجرة
Dialogue: 0,1:01:02.52,1:01:06.06,general text,,0,0,0,,ليس لها أحد غيري فكيف أتزوج غيري؟
Dialogue: 0,1:01:06.15,1:01:09.07,general text,,0,0,0,,مثل هؤلاء الفتيات هن الأخطر!
Dialogue: 0,1:01:09.15,1:01:11.40,general text,,0,0,0,,ليس لديهم ما يتباهون به، لكنهم سيتمسكون بشدة!
Dialogue: 0,1:01:11.48,1:01:12.99,نص عام,,0,0,0,,إنها ليست كذلك
Dialogue: 0,1:01:13.07,1:01:15.53,نص عام,,0,0,0,,من هي؟ تحدث
Dialogue: 0,1:01:15.61,1:01:16.91,نص عام,,0,0,0,,سأعتني بها
Dialogue: 0,1:01:16.99,1:01:18.16,نص عام,,0,0,0,,كيف بالضبط؟
Dialogue: 0,1:01:18.24,1:01:20.70,نص عام,,0,0,0,,سأعطيها كيساً من المال،
Dialogue: 0,1:01:20.79,1:01:23.37,نص عام,,0,0,0,,سوف تفقس من البيضة وتطير بعيدًا
Dialogue: 0,1:01:23.46,1:01:26.88,نص عام,,0,0,0,,لا يمكنها الطيران بعيدًا، الأمر ليس بهذه البساطة
Dialogue: 0,1:01:28.17,1:01:30.30,نص عام,,0,0,0,,على أية حال لا أستطيع الزواج
Dialogue: 0,1:01:30.38,1:01:31.59,نص عام,,0,0,0,,تعامل معها
Dialogue: 0,1:01:32.55,1:01:34.72,نص عام,,0,0,0,,فقط اكتشف ذلك. بخير؟
Dialogue: 0,1:01:35.51,1:01:36.84,نص عام,,0,0,0,,سيد.
Dialogue: 0,1:01:39.35,1:01:42.06,نص عام,,0,0,0,,ما هذا؟ هل أنت مجروح؟
Dialogue: 0,1:01:42.14,1:01:43.39,نص عام,,0,0,0,,عرض
Dialogue: 0,1:01:45.56,1:01:47.48,نص عام,,0,0,0,,ما مشكلة اليد؟
Dialogue: 0,1:01:49.27,1:01:50.94,نص عام,,0,0,0,,غير منضبط مرة أخرى؟
Dialogue: 0,1:01:58.16,1:01:59.78,نص عام,,0,0,0,,بيع هذا الفستان
Dialogue: 0,1:01:59.87,1:02:03.50,general text,,0,0,0,,- إنه حرير، بيعه بسعر أعلى\N- جيد
Dialogue: 0,1:02:04.08,1:02:06.54,نص عام,,0,0,0,,السيدة الآن لديها زائر
Dialogue: 0,1:02:06.62,1:02:08.33,نص عام,,0,0,0,,الآنسة جين الصغيرة من جينيوون هنا
Dialogue: 0,1:02:09.08,1:02:12.63,مائل,,0,0,0,,إنها تبحث عن سيد يصنع لها خواتم الزفاف
Dialogue: 0,1:02:12.71,1:02:14.55,general text,,0,0,0,,تزوجت الساحر من سوسنوفي بور
Dialogue: 0,1:02:18.51,1:02:20.76,نص عام,,0,0,0,,كيف يعجبك هذا الخاتم؟
Dialogue: 0,1:02:23.77,1:02:27.48,النص العام,,0,0,0,,هذه أعمال أفضل الحرفيين من ديهو
Dialogue: 0,1:02:29.27,1:02:32.15,نص عام,,0,0,0,,إنها جميلة ولكن لا طعم لها قليلاً
Dialogue: 0,1:02:33.78,1:02:36.03,نص عام,,0,0,0,,هل يمكنني إلقاء نظرة على يشم يين يانغ؟
Dialogue: 0,1:02:36.11,1:02:38.78,نص عام,,0,0,0,,بعد أن رأيت ذلك بنفسي، يمكنني اختيار خيارات أفضل
Dialogue: 0,1:02:43.62,1:02:45.62,النص العام,,0,0,0,,يقولون عندما يرتدي العشاق خواتم اليشم،
Dialogue: 0,1:02:45.70,1:02:48.21,النص العام,,0,0,0,,حبهم يزداد قوة
Dialogue: 0,1:03:02.43,1:03:04.14,خلف الكواليس,,0,0,0,,لماذا تشقق اليشم؟
Dialogue: 0,1:03:04.97,1:03:07.35,التعليق الصوتي,,0,0,0,,عندما أخذتها، كان كل شيء على ما يرام
Dialogue: 0,1:03:13.15,1:03:15.86,التعليق الصوتي,,0,0,0,,هل انهار إذن؟
Dialogue: 0,1:03:18.86,1:03:19.95,مائل,,0,0,0,,مو دوك
Dialogue: 0,1:03:26.62,1:03:27.87,خط مائل,,0,0,0,,السيدة.
Dialogue: 0,1:03:28.46,1:03:30.75,نص عام,,0,0,0,,لماذا تغادرين فجأة؟
Dialogue: 0,1:03:30.83,1:03:33.92,نص عام,,0,0,0,,هل هذا مو دوك؟ المملكة المتحدة هنا أيضا؟
Dialogue: 0,1:03:34.00,1:03:35.21,نص عام,,0,0,0,,لا
Dialogue: 0,1:03:36.55,1:03:39.17,general text,,0,0,0,,- أهذا صحيح؟\N- تتبعه بذيلها،
Dialogue: 0,1:03:39.26,1:03:41.05,نص عام,,0,0,0,,لابد أنه في مكان ما في المدينة
Dialogue: 0,1:03:41.13,1:03:42.93,نص عام,,0,0,0,,يمشي بذيله؟
Dialogue: 0,1:03:43.01,1:03:44.72,general text,,0,0,0,,إنها خادمته!
Dialogue: 0,1:03:45.85,1:03:47.27,نص عام,,0,0,0,,انتبه إلى لغتك
Dialogue: 0,1:03:48.73,1:03:52.31,general text,,0,0,0,,مو دوك ليس مجرد خادم له
Dialogue: 0,1:03:53.48,1:03:56.94,general text,,0,0,0,,لقد سُكر مو دوك مؤخرًا، وجاء من أجلها
Dialogue: 0,1:03:57.61,1:03:59.40,مائل,,0,0,0,,شغوف بها
Dialogue: 0,1:03:59.49,1:04:01.99,نص عام,,0,0,0,,لقد حملته للتو على ظهري
Dialogue: 0,1:04:02.66,1:04:03.57,مائل,,0,0,0,,بالتأكيد
Dialogue: 0,1:04:03.66,1:04:07.37,نص عام,,0,0,0,,نقلته من هنا لأنه أعجبني
Dialogue: 0,1:04:07.91,1:04:11.21,نص عام,,0,0,0,,مو دوك من هنا؟ هل كانت جيسينج؟
Dialogue: 0,1:04:11.29,1:04:12.75,نص عام,,0,0,0,,إنها فتاة فقيرة
Dialogue: 0,1:04:13.42,1:04:16.71,النص العام,,0,0,0,,لا عجب أنه يضايقها كثيرًا
Dialogue: 0,1:04:31.06,1:04:32.10,نص عام,,0,0,0,,يا
Dialogue: 0,1:04:32.73,1:04:34.52,نص عام,,0,0,0,,أنت تعرف من أنا، أليس كذلك؟
Dialogue: 0,1:04:35.90,1:04:38.02,نص عام,,0,0,0,,بالطبع
Dialogue: 0,1:04:38.11,1:04:40.57,نص عام,,0,0,0,,أنت شابة الآنسة جين من جينيوون
Dialogue: 0,1:04:42.57,1:04:45.70,نص عام,,0,0,0,,قريباً ستناديني بالسيدة
Dialogue: 0,1:04:46.91,1:04:50.58,نص عام,,0,0,0,,لأنني وبريطانيا سنتزوج
Dialogue: 0,1:04:52.12,1:04:54.83,نص عام,,0,0,0,,مبروك
Dialogue: 0,1:04:54.92,1:04:58.13,النص العام,,0,0,0,,سأكون زوجته وستكونين خادمتي
Dialogue: 0,1:04:59.55,1:05:01.09,نص عام,,0,0,0,,افعل شيئًا الآن
Dialogue: 0,1:05:03.34,1:05:05.05,نص عام,,0,0,0,,خذ الصندوق
Dialogue: 0,1:05:06.09,1:05:07.72,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,1:05:14.56,1:05:15.85,خلف الكواليس,,0,0,0,,ما الأمر؟
Dialogue: 0,1:05:17.02,1:05:18.69,خلف الكواليس,,0,0,0,,الحجر المكسور
Dialogue: 0,1:05:21.28,1:05:23.70,نص عام,,0,0,0,,هذا شيء ثمين
Dialogue: 0,1:05:23.78,1:05:25.91,نص عام,,0,0,0,,إذا انكسر,
Dialogue: 0,1:05:25.99,1:05:28.03,نص عام,,0,0,0,,سوف تكون الملام
Dialogue: 0,1:05:29.16,1:05:31.83,تعليق صوتي,,0,0,0,,تقول هذا وهو مكسور بالفعل
Dialogue: 0,1:05:32.75,1:05:33.79,نص عام,,0,0,0,,خذها واتبعني
Dialogue: 0,1:05:35.04,1:05:36.17,نص عام,,0,0,0,,سيدتي.
Dialogue: 0,1:05:36.92,1:05:38.75,النص العام,,0,0,0,,بينما أنا لا أخدمك
Dialogue: 0,1:05:39.38,1:05:42.09,general text,,0,0,0,,حان الوقت بالنسبة لي للذهاب إلى سيدي. وداعا
Dialogue: 0,1:05:46.38,1:05:48.93,النص العام,,0,0,0,,هل تنظر إلي بازدراء؟
Dialogue: 0,1:05:56.69,1:05:59.23,نص عام,,0,0,0,,لم أتخيل ذلك؟
Dialogue: 0,1:06:09.82,1:06:12.20,خلف الكواليس,,0,0,0,,من الأفضل لي ألا أتقاطع معه
Dialogue: 0,1:06:14.33,1:06:16.37,نص عام,,0,0,0,,مرحبًا! أنت!
Dialogue: 0,1:06:18.46,1:06:19.38,خلف الكواليس,,0,0,0,,رجل خطير
Dialogue: 0,1:06:21.21,1:06:22.67,خلف الكواليس,,0,0,0,,أم هذا الشقي الحقير؟
Dialogue: 0,1:06:24.26,1:06:25.34,نص عام,,0,0,0,,سيدتي
Dialogue: 0,1:06:26.13,1:06:28.51,نص عام,,0,0,0,,أعطني إياه. سأحمل
Dialogue: 0,1:06:31.72,1:06:32.85,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:06:32.93,1:06:35.48,نص عام,,0,0,0,,كن حذراً
Dialogue: 0,1:06:40.06,1:06:41.56,خارج الشاشة,,0,0,0,,نعم، لقد تم كسره بالفعل
Dialogue: 0,1:06:42.15,1:06:44.36,التعليق الصوتي,,0,0,0,,تريد أن تلومني على هذا؟
Dialogue: 0,1:07:13.26,1:07:15.26,تعليق صوتي,,0,0,0,,هل هذا يعني أن عائلة جين تعيش هنا؟
Dialogue: 0,1:07:48.05,1:07:49.51,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,1:08:01.77,1:08:02.81,نص عام,,0,0,0,,الأم
Dialogue: 0,1:08:24.50,1:08:26.13,خط مائل,,0,0,0,,لا يمكنك المغادرة فحسب
Dialogue: 0,1:08:27.42,1:08:30.80,general text,,0,0,0,,أقسم أمام صورة والدتك الراحلة أنك ستتزوجها
Dialogue: 0,1:08:30.88,1:08:33.43,general text,,0,0,0,,هذه هي الطريقة الوحيدة لحماية مكانة والدك
Dialogue: 0,1:08:35.85,1:08:37.18,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,1:08:37.26,1:08:38.47,نص عام,,0,0,0,,هل تعتقد...
Dialogue: 0,1:08:39.52,1:08:41.64,نص عام,,0,0,0,,أنه والدي؟
Dialogue: 0,1:08:45.19,1:08:46.56,نص عام,,0,0,0,,أنت تعلم...
Dialogue: 0,1:08:47.86,1:08:49.53,نص عام,,0,0,0,,من هو والدي الحقيقي؟
Dialogue: 0,1:08:51.19,1:08:52.86,نص عام,,0,0,0,,ماذا تقول؟
Dialogue: 0,1:08:53.78,1:08:55.99,النص العام,,0,0,0,,أنت ابن غوانغجو تشانغ جانج
Dialogue: 0,1:08:57.91,1:09:00.12,النص العام,,0,0,0,,نعم هذا ما كنت أؤمن به طوال حياتي
Dialogue: 0,1:09:00.20,1:09:02.04,مائل,,0,0,0,,لا أريد إنكار ذلك الآن
Dialogue: 0,1:09:02.12,1:09:03.08,خط مائل,,0,0,0,,لذا...
Dialogue: 0,1:09:05.17,1:09:07.17,نص عام,,0,0,0,,لن أبقى مكتوف الأيدي
Dialogue: 0,1:09:08.63,1:09:10.00,نص عام,,0,0,0,,لا توقفني,
Dialogue: 0,1:09:11.13,1:09:12.47,نص عام,,0,0,0,,مهما فعلت
Dialogue: 0,1:09:20.47,1:09:23.60,general text,,0,0,0,,عذراء كيم، عائلة جين أرسلت شيئاً
Dialogue: 0,1:09:24.19,1:09:26.52,نص عام,,0,0,0,,من جينيوون؟ ماذا جرى؟
Dialogue: 0,1:09:26.60,1:09:28.06,نص عام,,0,0,0,,حدث شيء ما هناك
Dialogue: 0,1:09:28.94,1:09:32.03,النص العام,,0,0,0,,يريدون أن يسرع السيد الشاب تشان إليهم
Dialogue: 0,1:10:12.90,1:10:14.19,نص عام,,0,0,0,,هل كنت تبحث عني؟
Dialogue: 0,1:10:14.28,1:10:15.57,نص عام,,0,0,0,,ماذا يعني كل هذا؟
Dialogue: 0,1:10:16.15,1:10:18.87,نص عام,,0,0,0,,لقد اختفى إرث عائلتنا
Dialogue: 0,1:10:19.66,1:10:20.78,نص عام,,0,0,0,,والخادمة...
Dialogue: 0,1:10:22.12,1:10:24.25,نص عام,,0,0,0,,اختفى معها
Dialogue: 0,1:10:31.59,1:10:34.34,التعليق الصوتي,,0,0,0,,هذا هو جينيوون
Dialogue: 0,1:10:42.81,1:10:43.89,نص عام,,0,0,0,,يا
Dialogue: 0,1:10:51.15,1:10:52.65,نص عام,,0,0,0,,إذًا أنت
Dialogue: 0,1:10:56.78,1:10:58.36,نص عام,,0,0,0,,لم أراك منذ وقت طويل
Dialogue: 0,1:11:28.64,1:11:29.94,خط مائل,,0,0,0,,أنت تقول مو دوك...
Dialogue: 0,1:11:30.81,1:11:33.48,نص عام,,0,0,0,,- مفقود هنا؟\N- نعم
Dialogue: 0,1:11:34.07,1:11:35.48,النص العام,,0,0,0,,خادمتك مو ديوك,
Dialogue: 0,1:11:36.19,1:11:38.61,النص العام,,0,0,0,,سرق يشم يين يانغ وهرب
Dialogue: 0,1:12:10.81,1:12:13.10,preview,,0,0,0,,كنت تفكر بي يا صاحب السمو،
Dialogue: 0,1:12:13.19,1:12:14.65,معاينة,,0,0,0,,لهذا السبب أتيت
Dialogue: 0,1:12:14.73,1:12:17.36,preview,,0,0,0,,لقد فاتك الشخص الذي قابلته في دانهيانغوك
Dialogue: 0,1:12:17.44,1:12:18.78,preview,,0,0,0,,هل اشتقت إليك؟
Dialogue: 0,1:12:18.86,1:12:20.11,معاينة,,0,0,0,,لم يكن هناك شيء من هذا القبيل
Dialogue: 0,1:12:20.19,1:12:21.45,معاينة,,0,0,0,,افتح الباب
Dialogue: 0,1:12:21.53,1:12:24.49,معاينة,,0,0,0,,افتح الباب أمام جينيوون، حيث يتم حفظ الآثار
Dialogue: 0,1:12:24.57,1:12:26.66,preview,,0,0,0,,قد يكون السحر ممسوسًا ولا تستطيع العودة
Dialogue: 0,1:12:26.74,1:12:28.49,معاينة,,0,0,0,,أنت خائف جدًا حتى من لمسهم
Dialogue: 0,1:12:30.00,1:12:31.25,معاينة,,0,0,0,,ماذا كان ذلك؟
Dialogue: 0,1:12:31.33,1:12:32.92,معاينة,,0,0,0,,أحضر تشان ووك
Dialogue: 0,1:12:33.00,1:12:35.08,معاينة,,0,0,0,,يجب أن أتخلى عنك لتعيش
Dialogue: 0,1:12:35.17,1:12:36.13,معاينة,,0,0,0,,هكذا ينبغي أن يكون
Dialogue: 0,1:12:37.34,1:12:39.88,معاينة,,0,0,0,,سو مو ديوك كان ناك سو
Dialogue: 0,1:12:43.01,1:12:45.26,preview,,0,0,0,,قاتل وكأن حياتك تعتمد على ذلك
Dialogue: 0,0:20:53.07,0:20:55.07,نص عام,,0,0,0,,

