Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:00:59.26,0:01:01.42,teks umum,,0,0,0,,Ini adalah pakaian ahli silap mata Jeonjingak
Dialog: 0,0:01:01.92,0:01:04.51,teks umum,,0,0,0,,Anda akan meningkatkan maruah anda sebagai ahli silap mata Jeonjingak
Dialog: 0,0:01:05.47,0:01:07.72,miring,,0,0,0,,Berjaya dalam mempelajari mantera
Dialog: 0,0:01:14.52,0:01:17.23,teks umum,,0,0,0,,Ini adalah azimat ahli silap mata Jeonjingak
Dialog: 0,0:01:18.11,0:01:19.78,teks umum,,0,0,0,,Dia memberikan hak
Dialog: 0,0:01:19.86,0:01:23.32,teks umum,,0,0,0,,langkah di mana-mana di Hutan Pine dan Jeonjingak
Dialog: 0,0:01:29.37,0:01:31.08,miring,,0,0,0,,Ini adalah satu set peraturan
Dialog: 0,0:01:31.58,0:01:33.00,teks umum,,0,0,0,,Anda akan mengikutinya
Dialog: 0,0:01:33.58,0:01:37.50,teks umum,,0,0,0,,Dan jika anda melanggar peraturan, anda akan dihukum sewajarnya
Dialog: 0,0:01:39.46,0:01:42.13,teks umum,,0,0,0,,Chan Wook, berdiri dan tunduk pada kepala
Dialog: 0,0:02:05.61,0:02:06.70,teks umum,,0,0,0,,Chan Wook, pusing
Dialog: 0,0:02:06.78,0:02:09.62,teks umum,,0,0,0,,dan tunduk kepada ahli silap mata yang lain
Dialog: 0,0:02:31.22,0:02:35.02,teks umum,,0,0,0,,Mulai sekarang, Chan Wook, anak sulung keluarga Chan,
Dialog: 0,0:02:35.73,0:02:38.31,teks umum,,0,0,0,,ahli silap mata Jeonjingak
Dialog: 0,0:03:08.09,0:03:09.80,teks umum,,0,0,0,,Hei, Chan Wook
Dialog: 0,0:03:09.89,0:03:11.76,teks umum,,0,0,0,,- Tahniah\N- Tahniah!
Dialog: 0,0:03:11.85,0:03:14.77,teks umum,,0,0,0,,- Anda telah pergi jauh\N- Jadi, jadi, jadi, kawan-kawan
Dialog: 0,0:03:16.60,0:03:21.77,teks umum,,0,0,0,,Hari ini kami akan menganjurkan percutian untuk menghormati ahli silap mata baharu kami - Chan Wook
Dialog: 0,0:03:21.86,0:03:24.48,teks umum,,0,0,0,,Kami sedang menunggu semua orang di Chwisongru
Dialog: 0,0:03:25.65,0:03:27.28,teks umum,,0,0,0,,Keluarga Chan sudah membayar
Dialog: 0,0:03:27.36,0:03:30.82,teks umum,,0,0,0,,makanan dan minuman dalam Chwiseonru
Dialog: 0,0:03:30.91,0:03:32.53,teks umum,,0,0,0,,Oleh itu
Dialog: 0,0:03:33.91,0:03:35.95,teks umum,,0,0,0,,semua orang harus minum sehingga mereka jatuh
Dialog: 0,0:03:42.88,0:03:44.09,teks umum,,0,0,0,,Chwisonru!
Dialog: 0,0:03:44.17,0:03:46.84,teks umum,,0,0,0,,- Chwisungru!\N- Chan Wook!
Dialog: 0,0:03:46.92,0:03:51.51,teks umum,,0,0,0,,Saya masih ingat bagaimana Chang Gan datang ke sini bersama Chan Wook. Ia seperti semalam
Dialog: 0,0:03:51.59,0:03:53.22,teks umum,,0,0,0,,Saya tidak percaya hari ini telah tiba
Dialog: 0,0:03:55.10,0:03:57.64,teks umum,,0,0,0,,Saya sendiri tidak percaya
Dialog: 0,0:04:00.10,0:04:01.15,teks umum,,0,0,0,,Di sini
Dialog: 0,0:04:02.15,0:04:02.98,teks umum,,0,0,0,,Makan
Dialog: 0,0:04:05.57,0:04:06.57,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:04:06.65,0:04:08.28,teks umum,,0,0,0,,Govenium Pil
Dialog: 0,0:04:08.36,0:04:10.28,teks umum,,0,0,0,,Makan sebelum anda minum
Dialog: 0,0:04:10.36,0:04:12.61,teks umum,,0,0,0,,Kanak-kanak akan minum sehingga saat terakhir
Dialog: 0,0:04:12.70,0:04:14.91,teks umum,,0,0,0,,Sekurang-kurangnya kita mesti cuba untuk bersaing dengan mereka
Dialog: 0,0:04:16.16,0:04:18.50,teks umum,,0,0,0,,Saya tidak akan mabuk tanpa ini
Dialog: 0,0:04:18.58,0:04:20.71,teks umum,,0,0,0,,Saya harus memikirkan tentang umur saya
Dialog: 0,0:04:22.08,0:04:23.50,teks umum,,0,0,0,,Bagaimana dengan umur saya?
Dialog: 0,0:04:23.58,0:04:25.88,teks umum,,0,0,0,,Jadi terdapat kunci kelabu
Dialog: 0,0:04:27.38,0:04:29.05,teks umum,,0,0,0,,Nampaknya anda kerana cahaya matahari
Dialog: 0,0:04:29.13,0:04:30.34,teks umum,,0,0,0,,Tengok dia
Dialog: 0,0:04:30.42,0:04:33.64,teks umum,,0,0,0,,Lihat betapa suteranya rambut saya
Dialog: 0,0:04:34.97,0:04:36.47,teks umum,,0,0,0,,Sangat cantik
Dialog: 0,0:04:41.77,0:04:43.44,teks umum,,0,0,0,,Saya akan simpan ini untuk diri saya sendiri
Dialog: 0,0:04:43.52,0:04:44.86,teks umum,,0,0,0,,Ya, terimalah
Dialog: 0,0:05:04.17,0:05:05.25,teks umum,,0,0,0,,Cik Do Hwa,
Dialog: 0,0:05:06.38,0:05:07.75,teks umum,,0,0,0,,tuan muda
Dialog: 0,0:05:08.71,0:05:13.43,teks umum,,0,0,0,,menjadi ahli silap mata Jeongjingak, seperti bapanya
Dialog: 0,0:05:15.84,0:05:17.43,italic,,0,0,0,,Adakah anda gembira?
Dialog: 0,0:05:37.41,0:05:38.99,di sebalik tabir,,0,0,0,,Anda melakukan kerja yang hebat
Dialog: 0,0:05:40.20,0:05:41.58,di sebalik tabir,,0,0,0,,sejak kita bertemu
Dialog: 0,0:05:48.71,0:05:50.21,kenangan condong,,0,0,0,,Saya faham pada pandangan pertama
Dialog: 0,0:05:52.09,0:05:53.51,kenangan,,0,0,0,,Anda adalah tuanku,
Dialog: 0,0:05:54.17,0:05:55.38,kenangan,,0,0,0,,Nak Su
Dialog: 0,0:05:55.47,0:05:56.97,kenangan,,0,0,0,,saya nak awak jadi guru saya
Dialog: 0,0:05:57.05,0:05:58.93,kenangan,,0,0,0,,Karut apa?
Dialog: 0,0:05:59.01,0:06:00.76,kenangan,,0,0,0,,Jika anda bertahan,
Dialog: 0,0:06:00.85,0:06:02.68,kenangan,,0,0,0,,Saya akan menjadi tuanmu
Dialog: 0,0:06:03.81,0:06:04.89,kenangan,,0,0,0,,Tuan
Dialog: 0,0:06:04.98,0:06:06.27,kenangan,,0,0,0,,saya akhirnya dapat
Dialog: 0,0:06:42.18,0:06:43.39,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:06:43.97,0:06:46.31,teks umum,,0,0,0,,Jadi bagaimana? Adakah ia sesuai dengan saya?
Dialog: 0,0:06:46.89,0:06:50.27,teks umum,,0,0,0,,Bagaimana hendak menyebut... Bagaimana saya perlu tahu?
Dialog: 0,0:06:51.94,0:06:54.82,teks umum,,0,0,0,,Cikgu, bagaimana rupa pelajar anda?
Dialog: 0,0:06:56.78,0:07:00.16,teks umum,,0,0,0,,Pakaian ini sesuai dengan So Yulyu dan Park Dan Gu,
Dialog: 0,0:07:02.83,0:07:05.04,teks umum,,0,0,0,,tetapi pada pelajar saya ia kelihatan sempurna
Dialog: 0,0:07:12.13,0:07:13.25,teks umum,,0,0,0,,Cukup
Dialog: 0,0:07:14.42,0:07:15.71,teks umum,,0,0,0,,Saya tidak boleh bernafas
Dialog: 0,0:07:16.72,0:07:17.76,teks umum,,0,0,0,,Guru,
Dialog: 0,0:07:18.93,0:07:19.93,teks umum,,0,0,0,,terima kasih
Dialog: 0,0:07:25.06,0:07:27.98,teks umum,,0,0,0,,Baiklah, Moo Dok. Jom pergi minum
Dialog: 0,0:07:32.02,0:07:34.23,teks umum,,0,0,0,,Chan Wook, tunggu
Dialog: 0,0:07:34.86,0:07:37.78,teks umum,,0,0,0,,- Chan Wook...\N- Tuan, awak kelihatan sangat baik
Dialog: 0,0:07:38.82,0:07:39.66,teks umum,,0,0,0,,Hos
Dialog: 0,0:07:41.57,0:07:43.03,teks umum,,0,0,0,,Terima ini
Dialog: 0,0:07:44.08,0:07:46.04,teks umum,,0,0,0,,Cikgu Huo memberi anda pil govenia
Dialog: 0,0:07:48.12,0:07:49.41,teks umum,,0,0,0,,Ah, govania?
Dialog: 0,0:07:49.50,0:07:51.33,teks umum,,0,0,0,,Perlu dibahagikan
Dialog: 0,0:07:53.71,0:07:55.92,teks umum,,0,0,0,,Ia sesuai untuk mabuk
Dialog: 0,0:08:06.93,0:08:08.35,teks umum,,0,0,0,,Ini, pembantu rumah Kim
Dialog: 0,0:08:09.73,0:08:10.89,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:08:10.98,0:08:13.52,teks umum,,0,0,0,,Saya akan memberikannya kepada anda. betul
Dialog: 0,0:08:13.61,0:08:16.94,teks umum,,0,0,0,,Maiden Kim, kembalilah. Ambillah. Baik betul
Dialog: 0,0:08:17.03,0:08:18.94,teks umum,,0,0,0,,Maiden Kim, tolong
Dialog: 0,0:08:25.91,0:08:30.00,teks umum,,0,0,0,,Lahir di bawah bintang raja memasuki Sosnovy Bor
Dialog: 0,0:08:30.58,0:08:33.79,teks umum,,0,0,0,,Ayahnya menggunakan batu ais untuk memantera
Dialog: 0,0:08:34.75,0:08:37.09,teks umum,,0,0,0,,Kelahiran Chan Wook adalah hasil daripada sihir ini
Dialog: 0,0:08:37.17,0:08:39.88,teks umum,,0,0,0,,Kanak-kanak ini adalah bencana untuk Sosnovy Bor
Dialog: 0,0:08:39.97,0:08:42.26,teks umum,,0,0,0,,Kenapa anda rasa Chang Gang melakukan ini?
Dialog: 0,0:08:42.76,0:08:45.35,teks umum,,0,0,0,,Dia boleh menjadikan anaknya raja,
Dialog: 0,0:08:45.43,0:08:49.98,teks umum,,0,0,0,,gunakan batu itu untuk memiliki Hwansu. Dia akan menundukkan dunia kepada dirinya sendiri
Dialog: 0,0:08:50.06,0:08:52.56,teks umum,,0,0,0,,Mengapa dia menutup pintu pagar anaknya
Dialog: 0,0:08:52.64,0:08:54.90,teks umum,,0,0,0,,dan menyembunyikan batu ais?
Dialog: 0,0:08:56.06,0:08:57.90,teks umum,,0,0,0,,Kerana saya lemah
Dialog: 0,0:08:59.48,0:09:00.74,italic,,0,0,0,,Dia menutup segala-galanya dan melarikan diri,
Dialog: 0,0:09:00.82,0:09:03.16,contact,,0,0,0,,kerana dia tidak dapat mengendalikannya
Dialog: 0,0:09:07.49,0:09:08.99,teks umum,,0,0,0,,Adakah anda fikir, Kil Ju
Dialog: 0,0:09:09.95,0:09:11.71,teks umum,,0,0,0,,membunuh Chang Gan?
Dialog: 0,0:09:12.25,0:09:13.58,teks umum,,0,0,0,,Jika dia kembali...
Dialog: 0,0:09:13.67,0:09:17.42,teks umum,,0,0,0,,Chang Gan tidak akan melakukan sesuatu seperti itu secara terbuka
Dialog: 0,0:09:19.05,0:09:21.17,teks umum,,0,0,0,,Saya syak Cikgu Li
Dialog: 0,0:09:21.84,0:09:25.05,teks umum,,0,0,0,,Kita perlu mendapatkan lebih kekuatan sebelum Hutan Pine mula mendaki
Dialog: 0,0:09:27.97,0:09:29.89,teks umum,,0,0,0,,Sepuluh tahun lalu kami berjaya
Dialog: 0,0:09:29.97,0:09:33.31,teks umum,,0,0,0,,mendapat batu yang dimeterai oleh Chang Gan
Dialog: 0,0:09:47.07,0:09:48.99,kenangan,,0,0,0,,Awak jumpa dia
Dialog: 0,0:09:50.04,0:09:51.33,kenangan,,0,0,0,,Bu Young,
Dialog: 0,0:09:51.41,0:09:53.12,kenangan,,0,0,0,,berikan saya batu ais
Dialog: 0,0:10:04.38,0:10:07.01,miring,,0,0,0,,Dia masih muda, tetapi dia dapat menemui batu itu
Dialog: 0,0:10:07.59,0:10:10.47,contact,,0,0,0,,Kita harus akui bahawa kuasanya benar-benar menakjubkan
Dialog: 0,0:10:13.48,0:10:16.60,teks umum,,0,0,0,,Saya dengar Jin Ho Kyung tidak percaya dengan kematian anak perempuannya
Dialog: 0,0:10:16.69,0:10:18.36,teks umum,,0,0,0,,dan masih mencarinya
Dialog: 0,0:10:19.02,0:10:20.61,teks umum,,0,0,0,,Jadi saya ingin mencarinya
Dialog: 0,0:10:22.57,0:10:24.90,teks umum,,0,0,0,,Saya akan jumpa anak perempuan yang dia cari selama ini.
Dialog: 0,0:10:24.99,0:10:28.49,teks umum,,0,0,0,,dan saya akan jadikan Jin Ho Kyung boneka saya
Dialog: 0,0:10:28.57,0:10:30.78,teks umum,,0,0,0,,Bagaimana anda mencari gadis yang sudah mati?
Dialog: 0,0:10:32.08,0:10:33.95,teks umum,,0,0,0,,Saya akan cari seseorang
Dialog: 0,0:10:34.45,0:10:37.75,teks umum,,0,0,0,,Orang yang membuat Ho Kyung percaya bahawa itu adalah Boo Young
Dialog: 0,0:10:56.23,0:10:57.52,teks umum,,0,0,0,,Di sini. makan
Dialog: 0,0:11:03.11,0:11:06.11,teks am,,0,0,0,,Awak pernah makan apa-apa sejak keluar dari Kampung Sari?
Dialog: 0,0:11:14.91,0:11:15.95,teks umum,,0,0,0,,Di sini
Dialog: 0,0:11:17.79,0:11:19.33,teks umum,,0,0,0,,Makan
Dialog: 0,0:11:28.30,0:11:29.55,teks umum,,0,0,0,,Luangkan masa anda
Dialog: 0,0:11:30.18,0:11:32.93,teks umum,,0,0,0,,Mengapa gadis buta ini belayar seorang diri ke bandar?
Dialog: 0,0:11:33.01,0:11:34.76,teks umum,,0,0,0,,Dia sedang mencari kawan
Dialog: 0,0:11:35.43,0:11:38.73,teks umum,,0,0,0,,Kawannya mencuri semua barangnya
Dialog: 0,0:11:38.81,0:11:40.81,teks umum,,0,0,0,,dan melarikan diri ke bandar
Dialog: 0,0:11:40.90,0:11:42.90,teks umum,,0,0,0,,Gadis malang
Dialog: 0,0:11:43.48,0:11:46.61,teks umum,,0,0,0,,Tahu ke mana hendak pergi? Siapa nama kawan awak?
Dialog: 0,0:11:48.61,0:11:49.82,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:11:50.45,0:11:54.08,teks umum,,0,0,0,,Nama kawan saya ialah Moo Deok
Dialog: 0,0:11:55.08,0:11:57.79,teks umum,,0,0,0,,- “Moo Dok”?\N- Bagaimanakah dia akan menemuinya?
Dialog: 0,0:12:00.29,0:12:01.75,italic,,0,0,0,,Sweet toffees!
Dialog: 0,0:12:01.83,0:12:04.29,italic,,0,0,0,,- Toffees manis!\N- Cuba kuki kami!
Dialog: 0,0:12:04.38,0:12:06.42,teks umum,,0,0,0,,Datang! Beli!
Dialog: 0,0:12:06.50,0:12:08.34,contact,,0,0,0,,Pai manis!
Dialog: 0,0:12:08.42,0:12:11.68,teks umum,,0,0,0,,Cuacanya bagus kan?
Dialog: 0,0:12:11.76,0:12:13.89,teks umum,,0,0,0,,Ibu, beli pai
Dialog: 0,0:12:13.97,0:12:15.68,teks umum,,0,0,0,,Saya tiada wang
Dialog: 0,0:12:15.76,0:12:16.97,teks umum,,0,0,0,,Ibu, belilah!
Dialog: 0,0:12:17.06,0:12:18.35,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:12:18.43,0:12:20.14,teks umum,,0,0,0,,Baiklah, tunggu
Dialog: 0,0:12:22.23,0:12:24.15,teks umum,,0,0,0,,Oh, di manakah mereka?
Dialog: 0,0:12:24.23,0:12:26.61,teks umum,,0,0,0,,- Di manakah wang saya?\N- Apakah itu?
Dialog: 0,0:12:26.69,0:12:29.15,teks umum,,0,0,0,,Wang sudah tiada
Dialog: 0,0:12:29.82,0:12:32.11,teks umum,,0,0,0,,- Apa yang perlu dilakukan?\N- Cincin saya...
Dialog: 0,0:12:33.11,0:12:35.20,teks umum,,0,0,0,,- Saya kehilangan cincin itu!\N- Syurga...
Dialog: 0,0:13:05.56,0:13:06.90,teks umum,,0,0,0,,Apa?
Dialog: 0,0:13:08.40,0:13:10.74,teks umum,,0,0,0,,Itu sahaja?
Dialog: 0,0:13:13.91,0:13:15.74,teks umum,,0,0,0,,Cincin itu juga murah
Dialog: 0,0:13:17.66,0:13:21.50,teks umum,,0,0,0,,Saya menyalibkan diri saya di sana dan semuanya untuk sia-sia
Dialog: 0,0:14:26.48,0:14:28.31,teks umum,,0,0,0,,- Terima kasih\N- Tuangkan untuk saya
Dialog: 0,0:14:31.44,0:14:33.28,teks umum,,0,0,0,,- Enjoy\N- Terima kasih
Dialog: 0,0:15:11.69,0:15:14.61,di sebalik tabir,,0,0,0,,Anda tahu siapa saya selama ini
Dialog: 0,0:15:16.36,0:15:18.66,kenangan miring,,0,0,0,,Daripada rakan berdekatan, anda mempunyai wisel
Dialog: 0,0:15:20.03,0:15:21.91,kenangan miring,,0,0,0,,Jadi rakan anda meninggalkan anda
Dialog: 0,0:15:39.63,0:15:40.93,teks umum,,0,0,0,,En. Yul?
Dialog: 0,0:15:44.18,0:15:45.35,teks umum,,0,0,0,,Ah, Moo Deok
Dialog: 0,0:15:46.14,0:15:48.35,teks umum,,0,0,0,,Kenapa awak duduk di jalan?
Dialog: 0,0:15:48.44,0:15:50.15,teks umum,,0,0,0,, Awak takkan minum?
Dialog: 0,0:15:52.02,0:15:54.69,teks umum,,0,0,0,,No. Saya sudah cukup
Dialog: 0,0:15:56.11,0:15:57.19,teks umum,,0,0,0,,Saya sudah mabuk
Dialog: 0,0:15:58.28,0:16:00.24,teks umum,,0,0,0,,Dan anda kelihatan baik
Dialog: 0,0:16:01.49,0:16:02.78,teks umum,,0,0,0,,Saya mabuk,
Dialog: 0,0:16:03.74,0:16:05.41,teks umum,,0,0,0,,jadi saya tersesat
Dialog: 0,0:16:08.87,0:16:11.42,teks umum,,0,0,0,,Saya cepat tersesat jika kepala saya berkabus
Dialog: 0,0:16:13.63,0:16:17.01,teks umum,,0,0,0,,Bagaimana anda boleh tersesat di sini?
Dialog: 0,0:16:20.43,0:16:23.09,teks umum,,0,0,0,,Bangun, saya akan bawa awak pulang
Dialog: 0,0:16:25.51,0:16:26.76,teks umum,,0,0,0,,Anda cedera
Dialog: 0,0:16:27.72,0:16:29.35,teks umum,,0,0,0,,Ini berbahaya
Dialog: 0,0:16:29.43,0:16:32.77,teks umum,,0,0,0,,Awak tegur saya lagi? Mungkin bukan hari ini?
Dialog: 0,0:16:34.77,0:16:36.44,teks umum,,0,0,0,,Bukan saya memarahi awak
Dialog: 0,0:16:37.44,0:16:39.61,teks umum,,0,0,0,,Saya sendiri yang membuat kesilapan
Dialog: 0,0:16:40.95,0:16:42.16,teks umum,,0,0,0,,Adakah anda?
Dialog: 0,0:16:43.20,0:16:44.16,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:45.74,0:16:49.08,teks umum,,0,0,0,,Saya sentiasa melakukan perkara yang betul. Tidak sesat
Dialog: 0,0:16:52.79,0:16:55.96,teks umum,,0,0,0,,Tetapi saya tersesat
Dialog: 0,0:17:00.42,0:17:01.97,teks umum,,0,0,0,,Dan sekarang saya pegang tangan awak
Dialog: 0,0:17:07.06,0:17:09.22,teks umum,,0,0,0,,Saya tidak tahu ke mana laluan saya akan membawa saya
Dialog: 0,0:17:14.60,0:17:16.31,teks umum,,0,0,0,,Dia akan memimpin kamu selepas saya
Dialog: 0,0:17:35.33,0:17:36.58,teks umum,,0,0,0,,Awak pegang tangan saya
Dialog: 0,0:17:38.67,0:17:39.84,teks umum,,0,0,0,,Jom
Dialog: 0,0:17:42.92,0:17:46.22,teks umum,,0,0,0,,Anda tersesat apabila kepala anda berkabus
Dialog: 0,0:17:46.30,0:17:48.43,teks umum,,0,0,0,,Semuanya kerana anda banyak berfikir
Dialog: 0,0:17:49.47,0:17:51.89,teks umum,,0,0,0,,Apabila ini berlaku, fikirkan satu perkara
Dialog: 0,0:17:51.98,0:17:55.56,teks umum,,0,0,0,,Sebagai contoh, fikirkan tentang saya sekarang
Dialog: 0,0:18:04.90,0:18:08.03,teks umum,,0,0,0,,Baiklah. Sekarang saya akan fikirkan tentang awak
Dialog: 0,0:18:15.54,0:18:19.63,teks umum,,0,0,0,,En. Jadi, boleh saya bertanya sesuatu?
Dialog: 0,0:18:20.17,0:18:21.13,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:18:21.88,0:18:24.97,teks umum,,0,0,0,,Awak kata awak mimpikan saya
Dialog: 0,0:18:25.05,0:18:26.38,teks umum,,0,0,0,,Apa yang penglihatan saya beritahu anda?
Dialog: 0,0:18:27.89,0:18:29.22,teks umum,,0,0,0,,Bahawa awak suka saya
Dialog: 0,0:18:29.80,0:18:32.14,teks umum,,0,0,0,,- Apa?\N- Apa itu?
Dialog: 0,0:18:32.22,0:18:33.89,teks umum,,0,0,0,,Anda sendiri sering mengulangi perkara ini
Dialog: 0,0:18:34.73,0:18:36.14,teks umum,,0,0,0,,Nah, itu kerana...
Dialog: 0,0:18:40.06,0:18:42.40,teks umum,,0,0,0,,Adakah itu semua pembohongan?
Dialog: 0,0:18:44.36,0:18:46.40,teks umum,,0,0,0,,Saya suka awak, tapi...
Dialog: 0,0:18:47.28,0:18:49.74,teks umum,,0,0,0,,Ya, saya suka awak
Dialog: 0,0:19:18.48,0:19:20.10,teks umum,,0,0,0,,Terima kasih saya
Dialog: 0,0:19:33.99,0:19:35.50,teks umum,,0,0,0,,Adakah dia benar-benar percaya?
Dialog: 0,0:19:37.50,0:19:39.17,teks umum,,0,0,0,,Saya harap tidak
Dialog: 0,0:19:45.42,0:19:47.05,teks umum,,0,0,0,,Cukup
Dialog: 0,0:19:47.13,0:19:49.68,teks umum,,0,0,0,,Semua terima kasih kepada anda, tuan
Dialog: 0,0:19:50.39,0:19:52.39,teks umum,,0,0,0,,Saya pasti Puan Do Hwa akan gembira
Dialog: 0,0:19:52.89,0:19:54.22,teks umum,,0,0,0,,Akhirnya saya...
Dialog: 0,0:19:54.31,0:19:58.27,teks umum,,0,0,0,,rasa seperti saya melakukan sesuatu yang baik untuk Do Hwa sebagai permintaan maaf
Dialog: 0,0:19:58.98,0:20:01.56,teks umum,,0,0,0,,Anda tidak melakukan apa-apa kesalahan
Dialog: 0,0:20:01.65,0:20:04.94,teks umum,,0,0,0,,Saya yang membawanya ke Sejukwon dari kampung halaman saya
Dialog: 0,0:20:05.02,0:20:08.03,teks umum,,0,0,0,,Begitulah dia bertemu Chang Gang
Dialog: 0,0:20:08.90,0:20:11.11,teks umum,,0,0,0,,Do Hwa sangat baik hati
Dialog: 0,0:20:11.20,0:20:15.33,teks umum,,0,0,0,,Saya tidak percaya bahawa dia percaya semua gosip ini
Dialog: 0,0:20:15.41,0:20:18.12,teks umum,,0,0,0,,Chan Gan, bajingan
Dialog: 0,0:20:19.00,0:20:21.71,teks umum,,0,0,0,,Cikgu, anda mabuk
Dialog: 0,0:20:21.79,0:20:23.21,teks umum,,0,0,0,,Ini salah awak!
Dialog: 0,0:20:24.96,0:20:26.92,teks umum,,0,0,0,,Apa yang saya buat?
Dialog: 0,0:20:27.00,0:20:31.34,teks umum,,0,0,0,,Saya membawa Do Hwa ke Saejukwon untuk mengaturkan awak dengannya
Dialog: 0,0:20:31.43,0:20:32.34,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:20:32.43,0:20:34.43,teks umum,,0,0,0,,Syurga suci
Dialog: 0,0:20:35.05,0:20:37.22,teks umum,,0,0,0,,Dengan penampilan dan kemahiran sedemikian
Dialog: 0,0:20:37.31,0:20:40.18,teks umum,,0,0,0,,tak dapat hati perempuan?
Dialog: 0,0:20:40.27,0:20:43.27,teks umum,,0,0,0,,Alangkah menjengkelkan anda!
Dialog: 0,0:20:45.48,0:20:46.65,teks umum,,0,0,0,,Nah, ya
Dialog: 0,0:20:46.73,0:20:49.32,teks umum,,0,0,0,,Cikgu Huo banyak membantu anda,
Dialog: 0,0:20:49.40,0:20:51.20,teks umum,,0,0,0,,dan anda tidak mengambil kesempatan daripada satu peluang pun
Dialog: 0,0:20:52.70,0:20:53.87,teks umum,,0,0,0,,Saya lakukan
Dialog: 0,0:20:55.28,0:20:56.41,teks umum,,0,0,0,,semua yang saya boleh
Dialog: 0,0:20:57.79,0:20:59.00,teks umum,,0,0,0,,Saya menulis puisi
Dialog: 0,0:21:01.21,0:21:02.33,teks umum,,0,0,0,,Hadiah yang diberi
Dialog: 0,0:21:03.62,0:21:05.63,teks umum,,0,0,0,,Tetapi awak tidak mengaku kepadanya
Dialog: 0,0:21:07.00,0:21:08.21,contact,,0,0,0,,"Saya sayang awak"
Dialog: 0,0:21:08.30,0:21:09.67,teks umum,,0,0,0,,"Sudikah awak menjadi milik saya?"
Dialog: 0,0:21:09.76,0:21:12.88,teks umum,,0,0,0,,Kami berjalan di sekitar semak, tetapi tidak berkata apa-apa
Dialog: 0,0:21:12.97,0:21:16.01,teks umum,,0,0,0,,Sudah tentu, anda kalah kepada orang yang mengatakan segala-galanya secara langsung
Dialog: 0,0:21:16.10,0:21:18.35,teks umum,,0,0,0,,Adakah perlu bercakap secara terbuka tentang perasaan?
Dialog: 0,0:21:20.35,0:21:23.39,teks umum,,0,0,0,,Petua yang cukup
Dialog: 0,0:21:24.19,0:21:25.69,teks umum,,0,0,0,,Betapa menjengkelkan anda
Dialog: 0,0:21:26.31,0:21:28.98,teks umum,,0,0,0,,Mereka menunjukkan minat, tetapi mereka menjaga jarak
Dialog: 0,0:21:29.07,0:21:30.61,teks umum,,0,0,0,,Kemudian mereka mendekati semula
Dialog: 0,0:21:30.69,0:21:32.45,teks umum,,0,0,0,,Kita perlu bercakap dengan seorang wanita tentang perasaan
Dialog: 0,0:21:32.53,0:21:36.57,teks umum,,0,0,0,,Jadi dia boleh memutuskan sama ada mahu menunggu anda atau tidak
Dialog: 0,0:21:36.66,0:21:39.95,teks umum,,0,0,0,,Jika cinta itu berubah-ubah hanya kerana ia tidak diluahkan dengan lantang,
Dialog: 0,0:21:41.08,0:21:42.21,teks umum,,0,0,0,,maka saya tidak perlukan dia!
Dialog: 0,0:21:44.00,0:21:47.17,teks umum,,0,0,0,,Jika seorang wanita memutuskan untuk meninggalkan saya dan pergi bersama orang lain,
Dialog: 0,0:21:47.67,0:21:49.13,teks umum,,0,0,0,,jadilah
Dialog: 0,0:21:49.88,0:21:50.84,teks umum,,0,0,0, "Jadilah..."
Dialog: 0,0:21:59.35,0:22:00.64,teks umum,,0,0,0,,Teruskan tanpa saya
Dialog: 0,0:22:02.31,0:22:03.77,teks umum,,0,0,0,,Nak ke mana?
Dialog: 0,0:22:03.85,0:22:05.90,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:22:06.56,0:22:08.02,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:22:08.90,0:22:11.98,teks umum,,0,0,0,,Tinggal. Jom minum bersama kami...
Dialog: 0,0:22:12.07,0:22:13.53,teks umum,,0,0,0,,Tinggal...
Dialog: 0,0:22:14.40,0:22:17.28,italik,,0,0,0,,Pembantu Kim, balik, okay?
Dialog: 0,0:22:17.37,0:22:19.28,teks umum,,0,0,0,,- Saya tunggu\N- Betul...
Dialog: 0,0:22:19.37,0:22:21.87,contact,,0,0,0,,- Pembantu Kim\N{\i0}- Suatu hari nanti dia akan menyesal
Dialog: 0,0:22:21.95,0:22:23.50,contact,,0,0,0,,Kim Gadis!
Dialog: 0,0:22:34.38,0:22:37.13,teks umum,,0,0,0,,Jadi di sinilah tempat orang minum
Dialog: 0,0:22:37.22,0:22:39.76,teks umum,,0,0,0,,Semua orang sedang menunggu anda. Masuklah
Dialog: 0,0:22:39.85,0:22:42.06,teks umum,,0,0,0,,Saya tidak boleh minum
Dialog: 0,0:22:42.14,0:22:45.73,teks umum,,0,0,0,,Saya kehabisan teh. Kita mesti kembali ke Danhyangok
Dialog: 0,0:22:45.81,0:22:47.56,teks umum,,0,0,0,,Dapatkan saya makanan
Dialog: 0,0:22:47.65,0:22:49.02,teks umum,,0,0,0,,Okey
Dialog: 0,0:22:55.11,0:22:58.61,teks umum,,0,0,0,,Bau minyak wangi wanita dan bau minuman keras
Dialog: 0,0:23:00.91,0:23:02.79,teks umum,,0,0,0,,Ini bukan tempat untuk saya
Dialog: 0,0:23:08.50,0:23:09.79,teks umum,,0,0,0,,Cinta
Dialog: 0,0:23:11.96,0:23:13.59,teks umum,,0,0,0,,Tidak suka
Dialog: 0,0:23:15.09,0:23:16.38,teks umum,,0,0,0,,Cinta
Dialog: 0,0:23:17.72,0:23:20.55,teks umum,,0,0,0,,Tidak suka. suka. tidak suka...
Dialog: 0,0:23:20.64,0:23:23.56,teks umum,,0,0,0,,Apa yang saya sedang buat?
Dialog: 0,0:23:23.64,0:23:25.18,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:23:30.27,0:23:33.44,teks umum,,0,0,0,,Mommies! Apa yang perlu dilakukan sekarang?
Dialog: 0,0:23:33.52,0:23:34.78,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:24:38.59,0:24:40.01,teks umum,,0,0,0,,Anda seorang ahli silap mata, bukan?
Dialog: 0,0:24:45.55,0:24:46.56,teks umum,,0,0,0,,Cikgu Li?
Dialog: 0,0:24:47.93,0:24:49.48,teks umum,,0,0,0,,Adakah anda Cikgu Li?
Dialog: 0,0:24:50.43,0:24:54.15,teks umum,,0,0,0,,Saya adalah pembantu rumah keluarga Chan. Melayan Encik Chan
Dialog: 0,0:24:55.44,0:24:56.82,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:24:57.40,0:24:58.53,teks umum,,0,0,0,,Tidak berbaloi
Dialog: 0,0:25:16.92,0:25:19.05,teks umum,,0,0,0,,Saya rasa ia terperangkap apabila anda menangkap saya
Dialog: 0,0:25:19.13,0:25:21.88,teks umum,,0,0,0,,Tunggu, izinkan saya
Dialog: 0,0:25:22.55,0:25:24.93,teks umum,,0,0,0,,Maaf
Dialog: 0,0:25:31.68,0:25:32.94,teks umum,,0,0,0,,Selesai
Dialog: 0,0:25:37.19,0:25:40.28,teks umum,,0,0,0,,Saya telah menunggu awak sepanjang petang,
Dialog: 0,0:25:40.36,0:25:42.57,teks umum,,0,0,0,,untuk berterima kasih
Dialog: 0,0:25:45.16,0:25:46.41,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:25:49.41,0:25:50.79,teks umum,,0,0,0,,Ke mana dia pergi?
Dialog: 0,0:25:51.83,0:25:52.91,teks umum,,0,0,0,,Cikgu Li?
Dialog: 0,0:26:08.80,0:26:11.43,teks umum,,0,0,0,,Adakah kerana saya sudah lama tidak minum teh?
Dialog: 0,0:26:14.60,0:26:17.90,prasasti,,0,0,0,,Saejukwon
Dialog: 0,0:26:19.61,0:26:21.90,contact,,0,0,0,,Cikgu Huo tiada di sini sekarang
Dialog: 0,0:26:21.98,0:26:24.28,teks umum,,0,0,0,,Tetapi dia sedang menunggu ketibaan awak
Dialog: 0,0:26:24.99,0:26:26.36,teks umum,,0,0,0,,Masuklah
Dialog: 0,0:26:32.50,0:26:35.04,teks umum,,0,0,0,,Sambutan untuk ahli silap mata baharu Jeonjingak?
Dialog: 0,0:26:35.12,0:26:36.71,teks umum,,0,0,0,,Cikgu Ho akan kembali dalam keadaan mabuk
Dialog: 0,0:26:38.21,0:26:40.54,teks umum,,0,0,0,,Semua orang tahu bagaimana datuk suka minum
Dialog: 0,0:26:41.17,0:26:45.09,teks umum,,0,0,0,,Puan, mungkin kita patut pergi ke Chwisongru?
Dialog: 0,0:26:45.88,0:26:48.55,teks umum,,0,0,0,,Bakal suami anda akan berada di sana
Dialog: 0,0:26:49.26,0:26:52.26,teks umum,,0,0,0,,- Apa?\N- Puan Ho memberitahu saya segala-galanya
Dialog: 0,0:26:52.35,0:26:56.52,teks umum,,0,0,0,,Saya dengar datuk kamu memilih beberapa ahli silap mata untuk dijadikan suami kamu
Dialog: 0,0:26:56.60,0:26:59.56,teks umum,,0,0,0,,Antaranya ialah Park Dan Gu dari Sosnovy Bor
Dialog: 0,0:26:59.65,0:27:01.77,teks umum,,0,0,0,,dan Seo Yul daripada keluarga Seo
Dialog: 0,0:27:01.86,0:27:04.03,teks umum,,0,0,0,,Saya di sini bukan untuk kahwin
Dialog: 0,0:27:04.57,0:27:06.65,teks umum,,0,0,0,,Saya akan membantu di hospital diraja
Dialog: 0,0:27:06.74,0:27:09.91,teks umum,,0,0,0,,Adakah anda rasa Putera Mahkota juga ada dalam senarai?
Dialog: 0,0:27:10.70,0:27:13.45,teks umum,,0,0,0,,- Cantik awak...\N- Song Yi!
Dialog: 0,0:27:13.54,0:27:15.66,teks umum,,0,0,0,,Alasan anda telah memalukan saya sekali
Dialog: 0,0:27:17.41,0:27:18.83,teks umum,,0,0,0,, Sudah lupa?
Dialog: 0,0:27:18.92,0:27:21.71,teks umum,,0,0,0,,Adakah anda bercakap tentang ahli silap mata yang sombong itu?
Dialog: 0,0:27:22.38,0:27:25.46,teks umum,,0,0,0,,Saya terpaksa bertanya nama untuk memberitahu Master Ho
Dialog: 0,0:27:27.51,0:27:28.80,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:27:29.68,0:27:31.76,teks umum,,0,0,0,,Saya sepatutnya bertanya nama
Dialog: 0,0:27:34.47,0:27:35.89,kenangan,,0,0,0,,Awak okay?
Dialog: 0,0:27:39.19,0:27:41.06,teks umum,,0,0,0,,Saya tertanya-tanya jika saya akan melihat...
Dialog: 0,0:27:43.77,0:27:45.15,teks umum,,0,0,0,,dia lagi
Dialog: 0,0:27:49.70,0:27:50.82,teks umum,,0,0,0,,Cukup
Dialog: 0,0:27:55.45,0:27:59.62,teks umum,,0,0,0,,Uk, awak berhutang dengan saya,
Dialog: 0,0:27:59.71,0:28:01.46,teks umum,,0,0,0,,jadi janji
Dialog: 0,0:28:01.54,0:28:03.92,teks umum,,0,0,0,,- Janji apa?\N- Suatu hari,
Dialog: 0,0:28:04.00,0:28:08.59,teks umum,,0,0,0,,apabila saya meminta anda melakukan sesuatu, anda akan melakukannya
Dialog: 0,0:28:09.72,0:28:10.97,teks umum,,0,0,0,,Baiklah, saya berjanji
Dialog: 0,0:28:11.72,0:28:13.47,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:28:13.55,0:28:16.81,teks umum,,0,0,0,,Mula-mula saya perlu menjelaskan sesuatu
Dialog: 0,0:28:16.89,0:28:21.44,teks umum,,0,0,0,,Saya tanya sebab awak kenal Cikgu Li
Dialog: 0,0:28:21.52,0:28:25.44,teks umum,,0,0,0,,Adakah anda minum teh kesuciannya?
Dialog: 0,0:28:26.53,0:28:29.74,teks umum,,0,0,0,,No. tidak pernah. Tak pernah minum
Dialog: 0,0:28:30.36,0:28:32.16,teks umum,,0,0,0,,Jadi anda tidak memerhatikan membujang?
Dialog: 0,0:28:32.24,0:28:35.58,teks umum,,0,0,0,,Tidak, sudah tentu. Saya mahu berkahwin suatu hari nanti
Dialog: 0,0:28:35.66,0:28:37.70,teks umum,,0,0,0,,Hebat. Di sini
Dialog: 0,0:28:41.08,0:28:43.08,teks umum,,0,0,0,,Anda kini juga seorang calon
Dialog: 0,0:28:43.17,0:28:45.67,teks umum,,0,0,0,,Kamu bertiga adalah calon
Dialog: 0,0:28:47.34,0:28:50.09,teks umum,,0,0,0,,Jangan lupa berterima kasih kepada Cikgu Li
Dialog: 0,0:28:50.17,0:28:53.68,teks umum,,0,0,0,,Jika dia tidak menjamin anda, pasti ada masalah
Dialog: 0,0:28:53.76,0:28:55.01,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:28:55.10,0:28:58.56,teks umum,,0,0,0,,Anda telah meragui orang ramai dengan menunjukkan Tansu,
Dialog: 0,0:28:58.64,0:29:00.81,teks umum,,0,0,0,,milik Nak Su
Dialog: 0,0:29:00.89,0:29:04.15,teks umum,,0,0,0,,Wook malah mahu menjadi pelajar Nak Soo
Dialog: 0,0:29:06.98,0:29:09.19,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:29:10.32,0:29:11.15,teks umum,,0,0,0,,Apa?
Dialog: 0,0:29:13.70,0:29:17.49,teks umum,,0,0,0,,Dia kecewa kerana tiada siapa boleh membuka pintu pagarnya,
Dialog: 0,0:29:18.12,0:29:19.79,teks umum,,0,0,0,,jadi saya bergurau begini
Dialog: 0,0:29:20.58,0:29:22.33,teks umum,,0,0,0,,Anda benar
Dialog: 0,0:29:23.54,0:29:25.21,teks umum,,0,0,0,,katanya?
Dialog: 0,0:29:25.29,0:29:27.34,teks umum,,0,0,0,,Ya, benar
Dialog: 0,0:29:28.46,0:29:30.80,teks umum,,0,0,0,,Yul, beritahu mereka,
Dialog: 0,0:29:30.88,0:29:34.47,teks umum,,0,0,0,,apakah hukuman yang dikenakan kepada ahli silap mata yang gemar sihir gelap
Dialog: 0,0:29:34.55,0:29:36.97,teks umum,,0,0,0,,Anda boleh kehilangan semua tenaga anda,
Dialog: 0,0:29:37.05,0:29:38.60,teks umum,,0,0,0,,tidak dapat mengucapkan mantra
Dialog: 0,0:29:38.68,0:29:40.43,teks umum,,0,0,0,,Kemudian mereka akan diusir dari Dekho,
Dialog: 0,0:29:41.56,0:29:43.81,teks umum,,0,0,0,,dan keturunan tidak akan pernah boleh menjadi ahli silap mata
Dialog: 0,0:29:43.89,0:29:45.10,teks umum,,0,0,0,,Ingat ini
Dialog: 0,0:29:48.02,0:29:51.57,teks umum,,0,0,0,,Jangan katakan itu lagi
Dialog: 0,0:29:52.49,0:29:54.61,teks umum,,0,0,0,,Apakah yang buruk tentang sihir gelap?
Dialog: 0,0:29:55.36,0:29:56.37,teks umum,,0,0,0,,Apa?
Dialog: 0,0:29:56.45,0:29:58.45,teks umum,,0,0,0,,Mantra biasa juga membunuh orang
Dialog: 0,0:29:58.53,0:30:00.95,teks umum,,0,0,0,,Dan sihir gelap, kadangkala, boleh menyelamatkan nyawa
Dialog: 0,0:30:01.83,0:30:03.83,teks umum,,0,0,0,,Cara memisahkan satu daripada yang lain,
Dialog: 0,0:30:03.91,0:30:07.79,teks umum,,0,0,0,,kita perlu fikir tentang niat manusia, ini lebih penting
Dialog: 0,0:30:07.88,0:30:11.17,teks umum,,0,0,0,,Jadi anda akan menggunakan sihir ini,
Dialog: 0,0:30:12.46,0:30:14.97,teks umum,,0,0,0,,jika ini menyelamatkan nyawa seseorang?
Dialog: 0,0:30:15.05,0:30:17.01,teks umum,,0,0,0,,Jika sihir ini menyelamatkan seseorang,
Dialog: 0,0:30:18.68,0:30:21.22,teks umum,,0,0,0,,Saya tidak nampak sebarang masalah
Dialog: 0,0:30:27.90,0:30:31.15,teks umum,,0,0,0,,Puppy! Beraninya awak!
Dialog: 0,0:30:31.23,0:30:32.94,teks umum,,0,0,0,,Anda adalah ahli silap mata Jeonjingak
Dialog: 0,0:30:33.03,0:30:36.16,teks umum,,0,0,0,,Beraninya awak mengatakan bahawa awak akan menggunakan sihir ini?
Dialog: 0,0:30:36.24,0:30:38.49,teks umum,,0,0,0,,Jika anda akan berkelakuan seperti ini,
Dialog: 0,0:30:38.57,0:30:41.12,teks umum,,0,0,0,,kembalikan tenaga yang saya berikan kepada awak
Dialog: 0,0:30:43.33,0:30:45.41,teks umum,,0,0,0,,- Bab\N- Apa itu?
Dialog: 0,0:30:45.50,0:30:48.54,teks umum,,0,0,0,,Putera Mahkota menuju ke sini untuk bertemu Chan Wook
Dialog: 0,0:30:53.96,0:30:55.26,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:30:57.43,0:30:58.51,teks umum,,0,0,0,,Helo
Dialog: 0,0:31:14.15,0:31:17.53,contact,,0,0,0,,Putera Mahkota! Sampaikan salam kepadanya!
Dialog: 0,0:31:35.34,0:31:37.59,teks umum,,0,0,0,,Saya datang apabila saya mendengar tentang perayaan itu
Dialog: 0,0:31:37.67,0:31:39.47,teks umum,,0,0,0,,Tetapi nampaknya saya telah merosakkannya
Dialog: 0,0:31:40.72,0:31:44.10,teks umum,,0,0,0,,Jika anda memikirkannya, semuanya terima kasih kepada saya,
Dialog: 0,0:31:45.22,0:31:47.56,teks umum,,0,0,0,,Saya mesti menjadi tetamu kehormat
Dialog: 0,0:31:48.19,0:31:49.77,teks umum,,0,0,0,,Mengapa mood menjadi teruk?
Dialog: 0,0:31:50.65,0:31:52.73,teks umum,,0,0,0,,Saya pasti, jauh di lubuk hati
Dialog: 0,0:31:52.82,0:31:55.61,teks umum,,0,0,0,,anda harap ia adalah pengebumian saya dan bukan percutian
Dialog: 0,0:31:55.69,0:31:57.19,teks umum,,0,0,0,,Jadi satu-satunya perkara yang boleh saya lakukan ialah,
Dialog: 0,0:31:57.28,0:31:59.45,teks umum,,0,0,0,,salam dengan tenang
Dialog: 0,0:32:05.45,0:32:07.16,teks umum,,0,0,0,,Pengebumian atau cuti,
Dialog: 0,0:32:07.25,0:32:09.46,teks umum,,0,0,0,, sentiasa ada minum di sana
Dialog: 0,0:32:10.25,0:32:13.21,teks umum,,0,0,0,,Jadi saya membawa beberapa bersama saya
Dialog: 0,0:32:18.55,0:32:20.59,teks umum,,0,0,0,,Adakah akan ada pergaduhan lagi?
Dialog: 0,0:32:20.68,0:32:22.22,teks umum,,0,0,0,,Bab, awak patut turun
Dialog: 0,0:32:22.30,0:32:25.10,teks umum,,0,0,0,,Kita tunggu dan lihat
Dialog: 0,0:32:31.10,0:32:33.02,teks umum,,0,0,0,,Untuk mengucapkan tahniah kepada Chang Wook atas kemenangannya,
Dialog: 0,0:32:35.32,0:32:36.86,teks umum,,0,0,0,,Saya akan tuangkan dia minuman
Dialog: 0,0:32:39.15,0:32:42.11,teks umum,,0,0,0,,Anda menguasai Ryusu dan menjadi ahli silap mata Jeonjingak
Dialog: 0,0:32:42.20,0:32:44.37,teks umum,,0,0,0,,dalam masa kurang daripada dua bulan
Dialog: 0,0:32:45.87,0:32:47.16,teks umum,,0,0,0,,Tahniah
Dialog: 0,0:32:52.08,0:32:55.17,teks umum,,0,0,0,,Saya kalah dalam pertarungan, tetapi...
Dialog: 0,0:32:55.25,0:32:57.67,teks umum,,0,0,0,,Saya gembira sebagai Putera Mahkota
Dialog: 0,0:32:58.84,0:33:01.09,teks umum,,0,0,0,,Deho adalah ahli silap mata yang baik
Dialog: 0,0:33:01.68,0:33:03.93,italic,,0,0,0,,Ini patut diraikan
Dialog: 0,0:33:04.51,0:33:05.80,teks umum,,0,0,0,,Minum
Dialog: 0,0:33:06.39,0:33:09.60,teks umum,,0,0,0,,dan menjadi ahli silap mata terbaik di negara ini
Dialog: 0,0:33:10.18,0:33:12.02,teks umum,,0,0,0,,Semoga Deho berbangga dengan kamu,
Dialog: 0,0:33:12.60,0:33:13.44,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:33:25.82,0:33:27.33,teks umum,,0,0,0,,Terima kasih, Yang Amat Mulia
Dialog: 0,0:33:35.58,0:33:36.92,teks umum,,0,0,0,,saya juga akan mencurahkan kepada anda
Dialog: 0,0:33:48.60,0:33:51.68,teks umum,,0,0,0,,Saya harap awak menjadi raja yang hebat
Dialog: 0,0:34:12.04,0:34:13.66,teks umum,,0,0,0,,Menjadi raja yang hebat, Yang Amat Mulia
Dialog: 0,0:34:31.52,0:34:32.60,teks umum,,0,0,0,,Baguslah
Dialog: 0,0:34:32.68,0:34:36.14,teks umum,,0,0,0,,Putera Mahkota tidak menyimpan dendam
Dialog: 0,0:34:39.94,0:34:42.15,teks umum,,0,0,0,,Putera, pewaris takhta,
Dialog: 0,0:34:42.23,0:34:45.78,teks umum,,0,0,0,,dan pemuda yang dilahirkan di bawah bintang raja
Dialog: 0,0:34:53.45,0:34:56.08,contact,,0,0,0,,Dua peninggalan Jinyeowon rosak
Dialog: 0,0:34:56.87,0:34:59.59,teks umum,,0,0,0,,Mereka tidak mempunyai tenaga, mereka tidak berguna
Dialog: 0,0:34:59.67,0:35:01.96,teks umum,,0,0,0,,Bakar dan taburkan abu di atas Tasik Gyeongcheongdaeho
Dialog: 0,0:35:02.88,0:35:04.13,teks umum,,0,0,0,,Ya, ibu
Dialog: 0,0:35:04.72,0:35:07.30,teks umum,,0,0,0,,Puan, tuan puan telah kembali
Dialog: 0,0:35:08.14,0:35:09.22,teks umum,,0,0,0,,Ayah?
Dialog: 0,0:35:10.01,0:35:11.14,teks umum,,0,0,0,,Cho Young
Dialog: 0,0:35:12.18,0:35:13.18,teks umum,,0,0,0,,Isteri
Dialog: 0,0:35:13.27,0:35:14.73,teks umum,,0,0,0,,Bapa!
Dialog: 0,0:35:15.23,0:35:16.31,teks umum,,0,0,0,,Bapa!
Dialog: 0,0:35:17.02,0:35:18.73,miring,,0,0,0,,My Cho Young
Dialog: 0,0:35:20.86,0:35:24.07,teks umum,,0,0,0,,Biar saya lihat. Anda telah menjadi lebih cantik
Dialog: 0,0:35:33.54,0:35:34.66,teks umum,,0,0,0,,Saya kembali
Dialog: 0,0:35:38.04,0:35:40.00,teks umum,,0,0,0,,saya jumpa dia di Pulau Volcano di selatan
Dialog: 0,0:35:40.67,0:35:42.42,teks umum,,0,0,0,,Dia kehilangan ibu bapanya semasa kecil,
Dialog: 0,0:35:42.50,0:35:45.67,teks umum,,0,0,0,,jadi tidak ingat apa-apa tentang mereka
Dialog: 0,0:35:45.76,0:35:49.76,teks umum,,0,0,0,,Dia nampaknya sebaya dengan Boo Young
Dialog: 0,0:35:52.14,0:35:54.10,teks umum,,0,0,0,,Anda telah pergi
Dialog: 0,0:35:54.18,0:35:57.73,teks umum,,0,0,0,,sesuatu dari zaman kanak-kanak?
Dialog: 0,0:36:01.31,0:36:05.23,teks umum,,0,0,0,,Tidak seperti Boo Young, dia tidak mempunyai tenaga,
Dialog: 0,0:36:05.32,0:36:08.53,teks umum,,0,0,0,,dan dia tidak boleh mengucapkan mantra
Dialog: 0,0:36:08.61,0:36:12.82,teks umum,,0,0,0,,Dia mungkin telah kehilangan kekuatannya ketika jauh dari Jinyoewon
Dialog: 0,0:36:14.41,0:36:17.20,teks umum,,0,0,0,,Tetapi jika dia benar-benar ahli keluarga Jin,
Dialog: 0,0:36:18.58,0:36:20.67,teks umum,,0,0,0,,kekuatannya akan kembali dengan mudah
Dialog: 0,0:36:28.47,0:36:30.59,teks umum,,0,0,0,,Pintu ini akan menunjukkan kepada kita
Dialog: 0,0:36:31.39,0:36:34.18,teks umum,,0,0,0,,adakah anda benar-benar ahli keluarga kami
Dialog: 0,0:37:01.75,0:37:05.09,teks umum,,0,0,0,,saya bukan anak perempuan yang awak cari selama ini?
Dialog: 0,0:37:07.05,0:37:08.92,teks umum,,0,0,0,,Tidak, nampaknya
Dialog: 0,0:37:10.47,0:37:15.26,teks umum,,0,0,0,,Tetapi terima kasih kerana datang sejauh ini. Mereka akan memberi anda wang yang cukup untuk mendapatkan anda kembali.
Dialog: 0,0:37:17.18,0:37:21.73,teks umum,,0,0,0,,Adakah anda rasa ibu akan marah kerana kekecewaan yang lain?
Dialog: 0,0:37:22.81,0:37:24.40,teks umum,,0,0,0,,Apa yang perlu saya lakukan, ayah?
Dialog: 0,0:38:16.91,0:38:18.03,kenangan,,0,0,0,,Ibu
Dialog: 0,0:38:19.83,0:38:21.70,kenangan,,0,0,0,,Burung dalam sangkar mati
Dialog: 0,0:38:25.54,0:38:28.25,kenangan,,0,0,0,,Kau betul. miskin
Dialog: 0,0:38:28.34,0:38:31.63,kenangan,,0,0,0,,Sehingga semalam saya rasa tenaga hangat
Dialog: 0,0:38:33.05,0:38:34.63,kenangan,,0,0,0,,Dan kini tiada apa-apa
Dialog: 0,0:38:36.30,0:38:40.39,kenangan,,0,0,0,,Saya boleh lihat, tetapi anda masih orang pertama yang perasan
Dialog: 0,0:38:40.47,0:38:43.23,kenangan,,0,0,0,,Semua benda hidup mempunyai tenaga
Dialog: 0,0:38:44.10,0:38:46.35,kenangan,,0,0,0,,Melalui tenaga ini saya melihat dunia
Dialog: 0,0:38:46.44,0:38:50.98,kenangan,,0,0,0,,Bu Young, semoga anda tidak melihat apa yang orang lain lihat
Dialog: 0,0:38:52.19,0:38:56.11,kenangan,,0,0,0,,Anda istimewa dan anda melihat apa yang orang lain tidak dapat lihat
Dialog: 0,0:39:00.83,0:39:02.99,kenangan,,0,0,0,,Awak jadikan saya penutup mata baru
Dialog: 0,0:39:03.08,0:39:05.04,kenangan,,0,0,0,,Saya ingin mencubanya
Dialog: 0,0:39:25.43,0:39:26.60,teks umum,,0,0,0,,Isteri
Dialog: 0,0:39:28.73,0:39:30.90,teks umum,,0,0,0,,Jangan marah
Dialog: 0,0:39:30.98,0:39:33.86,teks umum,,0,0,0,,Saya tidak menjangkakan sangat apabila saya membawanya ke sini
Dialog: 0,0:39:35.82,0:39:38.03,teks umum,,0,0,0,,Jadi awak bawa sesiapa sahaja?
Dialog: 0,0:39:38.11,0:39:41.24,teks umum,,0,0,0,,Jadi anda hanya cuba menggembirakan saya
Dialog: 0,0:39:41.91,0:39:43.87,teks umum,,0,0,0,,Itulah sebabnya kami tidak dapat mencarinya selama 10 tahun
Dialog: 0,0:39:47.08,0:39:48.29,teks umum,,0,0,0,,Saya...
Dialog: 0,0:39:49.04,0:39:51.96,teks umum,,0,0,0,,Saya akan mula mencari semula
Dialog: 0,0:39:53.00,0:39:54.34,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:39:54.42,0:39:57.51,teks umum,,0,0,0,,Jin Mu dari Jeonbugwan akan membantu mencarinya
Dialog: 0,0:39:57.59,0:40:01.64,teks umum,,0,0,0,,Saya fikir awak benci abang tiri awak
Dialog: 0,0:40:01.72,0:40:05.06,teks umum,,0,0,0,,Saya benci. Tetapi jika kita bercakap tentang Boo Young,
Dialog: 0,0:40:05.14,0:40:08.89,teks umum,,0,0,0,,Saya bersedia untuk menggunakan bantuannya
Dialog: 0,0:40:14.82,0:40:15.90,teks umum,,0,0,0,,Keluar
Dialog: 0,0:40:16.44,0:40:19.40,teks umum,,0,0,0,,Saya sedang mencari seseorang di sini
Dialog: 0,0:40:19.49,0:40:20.78,teks umum,,0,0,0,,Moo Dok ada di sini, bukan?
Dialog: 0,0:40:20.86,0:40:23.12,teks umum,,0,0,0,,Ada ramai orang di sini sekarang, kembali esok
Dialog: 0,0:40:25.24,0:40:26.54,teks umum,,0,0,0,,Menolak saya
Dialog: 0,0:40:28.46,0:40:29.96,teks umum,,0,0,0,,Adakah anda tahu siapa saya?
Dialog: 0,0:40:31.00,0:40:32.17,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:40:34.21,0:40:37.17,teks umum,,0,0,0,,Saya adalah ahli silap mata salah satu keluarga tertinggi negara ini
Dialog: 0,0:40:39.59,0:40:42.34,teks umum,,0,0,0,,Tunjukkan keajaiban saya?
Dialog: 0,0:40:48.60,0:40:49.98,teks umum,,0,0,0,,Anggap diri anda bertuah
Dialog: 0,0:40:50.52,0:40:53.15,teks umum,,0,0,0,,Jika saya meletakkan tenaga di tangan saya, awak akan mati
Dialog: 0,0:40:53.86,0:40:56.48,teks umum,,0,0,0,,Maaf. saya minta maaf
Dialog: 0,0:40:57.11,0:41:00.24,teks umum,,0,0,0,,Itu rumah gisaeng sahaja. Adakah anda tidak membenarkan pelawat?
Dialog: 0,0:41:00.32,0:41:03.91,teks umum,,0,0,0,,Hari ini adalah perayaan ahli silap mata Jeonjingak
Dialog: 0,0:41:04.49,0:41:05.58,teks umum,,0,0,0,,- Sosnovy Bor?\N- Ya
Dialog: 0,0:41:05.66,0:41:08.75,teks umum,,0,0,0,,Malah Putera Mahkota ada di sini
Dialog: 0,0:41:09.62,0:41:12.25,общий текст,,0,0,0,,Я слышала, её продали в самый большой дом кисэн в Д
Dialog: 0,0:41:12.92,0:41:14.75,teks umum,,0,0,0,,Ini mesti rumah itu
Dialog: 0,0:41:14.83,0:41:17.92,teks umum,,0,0,0,,Jika anda memberi saya nama, saya akan memperkenalkan anda
Dialog: 0,0:41:19.09,0:41:21.88,teks umum,,0,0,0,,Tidak berbaloi. Saya akan kembali esok
Dialog: 0,0:41:24.39,0:41:25.85,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:41:27.22,0:41:28.39,teks umum,,0,0,0,,Siapa di sana?
Dialog: 0,0:41:28.97,0:41:31.35,contact,,0,0,0,,Dia kata dia dari keluarga yang tinggi
Dialog: 0,0:41:31.43,0:41:32.98,teks umum,,0,0,0,,Saya rasa ini Jinyeowon
Dialog: 0,0:41:33.06,0:41:36.40,teks umum,,0,0,0,,Dia mempunyai sesuatu di lehernya dengan jambul Jinyoewon
Dialog: 0,0:41:36.48,0:41:37.69,teks umum,,0,0,0,,Jinyeowon?
Dialog: 0,0:41:38.19,0:41:43.86,teks umum,,0,0,0,,Ahli silap mata mereka sentiasa kurang ajar dan cerewet
Dialog: 0,0:41:44.70,0:41:46.24,teks umum,,0,0,0,,Awak okey?
Dialog: 0,0:41:46.32,0:41:50.12,teks umum,,0,0,0,,Ia tidak menyakitkan. Dia lemah untuk ahli sihir
Dialog: 0,0:41:50.20,0:41:53.00,teks umum,,0,0,0,,Bagaimana jika dia berbohong dan jata itu hanyalah palsu?
Dialog: 0,0:41:54.00,0:41:57.71,teks umum,,0,0,0,,Jika di Deho anda berpura-pura menjadi seseorang daripada keluarga tertinggi,
Dialog: 0,0:41:57.79,0:41:59.38,teks umum,,0,0,0,,anda boleh mati
Dialog: 0,0:42:01.01,0:42:02.47,teks umum,,0,0,0,,Gadis pelik
Dialog: 0,0:42:11.35,0:42:15.10,contact,,0,0,0,,Di Kubu Deho, ahli silap mata sebenarnya mempunyai banyak keistimewaan
Dialog: 0,0:42:16.86,0:42:18.52,teks umum,,0,0,0,,Moo Dok mesti ada di suatu tempat
Dialog: 0,0:42:28.58,0:42:30.91,teks umum,,0,0,0,,Kita perlu hidup untuk wangnya sekurang-kurangnya sedikit
Dialog: 0,0:42:32.58,0:42:34.54,teks umum,,0,0,0,,Jika saya katakan saya datang untuk mengembalikan ini,
Dialog: 0,0:42:35.54,0:42:38.75,teks umum,,0,0,0,,Saya pasti dia akan benarkan saya tinggal, dia baik hati
Dialog: 0,0:42:40.42,0:42:42.38,teks umum,,0,0,0,,- Hei, siapa awak?\N- Takut
Dialog: 0,0:42:49.60,0:42:50.68,teks umum,,0,0,0,,Tunggu saya di luar
Dialog: 0,0:42:51.26,0:42:52.43,teks umum,,0,0,0,,Ya, Yang Amat Mulia
Dialog: 0,0:42:59.94,0:43:01.61,teks umum,,0,0,0,,Dia mesti keluar
Dialog: 0,0:43:02.98,0:43:06.11,teks umum,,0,0,0,,Satu, dua, tiga
Dialog: 0,0:43:08.70,0:43:10.58,teks umum,,0,0,0,,Empat, lima...
Dialog: 0,0:43:11.49,0:43:12.66,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:43:14.45,0:43:15.79,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:43:19.88,0:43:25.17,teks umum,,0,0,0,,Sekali lagi saya tersentuh
Dialog: 0,0:43:25.76,0:43:27.26,teks umum,,0,0,0,,kemurahan hati anda yang tidak berkesudahan
Dialog: 0,0:43:29.22,0:43:32.47,teks umum,,0,0,0,,Ya, saya berpura-pura baik dan pemurah
Dialog: 0,0:43:32.56,0:43:34.68,teks umum,,0,0,0,,Boleh terbalikkan tempat ini
Dialog: 0,0:43:34.77,0:43:37.94,teks umum,,0,0,0,,Tetapi, seperti yang telah saya katakan, saya tidak mahu ahli silap mata menjadi musuh saya
Dialog: 0,0:43:39.23,0:43:41.61,teks umum,,0,0,0,,Apa? Awak rasa saya bodoh?
Dialog: 0,0:43:42.52,0:43:45.32,teks umum,,0,0,0,,Anda bertindak dengan sangat bijak dan bijak,
Dialog: 0,0:43:45.40,0:43:49.07,teks umum,,0,0,0,,menyembunyikan kepicikan dan emosi anda
Dialog: 0,0:43:49.95,0:43:52.74,teks umum,,0,0,0,,Saya memutuskan untuk menunjukkan kepicikan hanya kepada awak, Won Moo Deok
Dialog: 0,0:43:52.83,0:43:57.16,teks umum,,0,0,0,,Saya boleh bayangkan betapa sukarnya untuk menuangkan minuman kepadanya,
Dialog: 0,0:43:57.25,0:43:59.58,teks umum,,0,0,0,,bila anda ingin meracuni
Dialog: 0,0:43:59.67,0:44:02.54,teks umum,,0,0,0,,Jadi saya bergegas ke sini secepat yang saya boleh
Dialog: 0,0:44:03.29,0:44:05.51,teks umum,,0,0,0,,Saya benci tuan awak sampai mual
Dialog: 0,0:44:05.59,0:44:06.71,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:44:06.80,0:44:08.63,teks umum,,0,0,0,,Hati saya membara dengan kebencian kepadanya
Dialog: 0,0:44:08.72,0:44:10.47,teks umum,,0,0,0,,Saya tidak ragu-ragu
Dialog: 0,0:44:10.55,0:44:12.26,teks umum,,0,0,0,,Dan awak... awak sokong dia...
Dialog: 0,0:44:13.72,0:44:15.39,teks umum,,0,0,0,,saya pun tak suka awak
Dialog: 0,0:44:21.23,0:44:23.52,teks umum,,0,0,0,,Kemurahan hati saya ditujukan untuk anda, bukan untuk dia
Dialog: 0,0:44:26.48,0:44:27.99,teks umum,,0,0,0,,Won Moo Deok
Dialog: 0,0:44:28.07,0:44:31.36,teks umum,,0,0,0,,Jika anda bergaduh atau bergaduh antara kami lagi,
Dialog: 0,0:44:32.49,0:44:34.33,teks umum,,0,0,0,,Saya akan bunuh awak dahulu
Dialog: 0,0:44:39.04,0:44:42.96,teks umum,,0,0,0,,Yang Mulia, jika saya akan mati oleh pedang tuan,
Dialog: 0,0:44:44.84,0:44:46.63,teks umum,,0,0,0,,Saya tidak akan menyimpan dendam terhadap awak
Dialog: 0,0:44:47.76,0:44:50.09,teks umum,,0,0,0,,Adakah anda akan berkhidmat kepada tuan dalam apa jua keadaan?
Dialog: 0,0:44:50.18,0:44:51.59,teks umum,,0,0,0,,Sungguh hamba yang setia
Dialog: 0,0:44:51.68,0:44:53.76,teks umum,,0,0,0,,Mungkin kami patut membina monumen untuk anda?
Dialog: 0,0:44:53.85,0:44:57.43,teks umum,,0,0,0,,Saya amat berbesar hati menerima pengiktirafan anda
Dialog: 0,0:44:57.52,0:44:59.02,teks umum,,0,0,0,,Lupakan. hilang
Dialog: 0,0:44:59.10,0:45:01.48,teks umum,,0,0,0,,Sehingga saya kehilangan semua kemurahan hati saya dan menjadi picik lagi
Dialog: 0,0:45:02.48,0:45:04.69,teks umum,,0,0,0,,- Yang Amat Mulia\N- Apa? apa lagi?
Dialog: 0,0:45:04.77,0:45:07.11,teks umum,,0,0,0,,Hajat mati muncul?
Dialog: 0,0:45:08.19,0:45:11.03,teks umum,,0,0,0,,Bagaimana keadaan luka anda? awak okay tak?
Dialog: 0,0:45:14.12,0:45:16.74,teks umum,,0,0,0,,Sepatutnya tanya tadi
Dialog: 0,0:45:16.83,0:45:19.20,teks umum,,0,0,0,,Jangan risau. Serangan itu tidak kuat
Dialog: 0,0:45:19.29,0:45:21.16,teks umum,,0,0,0,,Ya, dan Ho Yeom telah menambal saya
Dialog: 0,0:45:22.12,0:45:25.79,teks umum,,0,0,0,,Kamu terkejut kerana kamu tidak menjangkakan ini daripada tuanku
Dialog: 0,0:45:25.88,0:45:29.34,teks umum,,0,0,0,,Tetapi anda, tentu saja, lebih kuat daripada dia
Dialog: 0,0:45:29.42,0:45:32.80,teks umum,,0,0,0,,Secara semula jadi. Siapa tahu dia menggunakan Tansu?
Dialog: 0,0:45:32.88,0:45:34.01,teks umum,,0,0,0,,Penipu
Dialog: 0,0:45:34.89,0:45:36.10,kenangan,,0,0,0,,Oh, maksud kamu sachet itu,
Dialog: 0,0:45:36.89,0:45:40.10,kenangan,,0,0,0,,yang dia gantung di tepi lubang tandas untuk menghalau lalat?
Dialog: 0,0:45:42.89,0:45:45.23,teks am,,0,0,0,,Di manakah sachet yang saya berikan kepada awak?
Dialog: 0,0:45:45.31,0:45:46.19,teks umum,,0,0,0,,Apa?
Dialog: 0,0:45:47.11,0:45:50.07,teks umum,,0,0,0,,Tiba-tiba anda menggantungnya di tepi lubang tandas untuk menghalau lalat
Dialog: 0,0:45:53.32,0:45:54.45,teks umum,,0,0,0,,Di sini
Dialog: 0,0:45:55.11,0:45:58.53,teks umum,,0,0,0,,Mengapa menggantung harta karun itu berhampiran tandas?
Dialog: 0,0:45:58.62,0:46:01.33,teks umum,,0,0,0,,Tepat sekali. Saya tahu awak tidak akan melakukannya
Dialog: 0,0:46:02.29,0:46:03.21,teks umum,,0,0,0,,Baiklah, okey
Dialog: 0,0:46:05.92,0:46:07.79,teks umum,,0,0,0,,Selamat melancong, Yang Amat Mulia
Dialog: 0,0:46:20.10,0:46:22.43,miring,,0,0,0,,- Cukup\N- Itu sahaja
Dialog: 0,0:46:22.52,0:46:24.52,teks umum,,0,0,0,,- Cikgu\N- Tinggalkan saya sendiri
Dialog: 0,0:46:24.60,0:46:26.65,teks umum,,0,0,0,,Bangun, tuan
Dialog: 0,0:46:28.02,0:46:29.32,teks umum,,0,0,0,,- Hei\N- Tengok tu
Dialog: 0,0:46:30.36,0:46:32.53,teks umum,,0,0,0,,Dia akan sedar hanya esok pagi
Dialog: 0,0:46:32.61,0:46:34.24,miring,,0,0,0,,Cepat mabuk
Dialog: 0,0:46:34.32,0:46:37.20,teks umum,,0,0,0,,Dia minum semua yang ditawarkan oleh Putera Mahkota kepadanya
Dialog: 0,0:46:37.28,0:46:40.12,teks umum,,0,0,0,,Kita sepatutnya menolongnya ketika itu. Hanya awak yang sedar diri di sini
Dialog: 0,0:46:40.20,0:46:43.00,teks umum,,0,0,0,,Saya sibuk, saya menyanyi
Dialog: 0,0:46:44.54,0:46:46.08,italik,,0,0,0,,Letak tandu
Dialog: 0,0:46:49.29,0:46:52.05,teks umum,,0,0,0,,Hanya mereka yang dibenarkan lalu di sini boleh
Dialog: 0,0:46:52.63,0:46:54.92,teks umum,,0,0,0,,Jika anda bukan dari Sosnovy Bor, tinggalkan
Dialog: 0,0:47:02.52,0:47:03.89,teks umum,,0,0,0,,Anda juga tidak boleh
Dialog: 0,0:47:05.27,0:47:06.60,teks umum,,0,0,0,,Saya Moo Dok
Dialog: 0,0:47:07.40,0:47:09.36,teks umum,,0,0,0,,En. pembantu rumah Chan
Dialog: 0,0:47:09.44,0:47:10.69,teks umum,,0,0,0,,Anda tahu
Dialog: 0,0:47:12.11,0:47:15.70,teks umum,,0,0,0,,Anda hanya dibenarkan masuk kerana Chang Wook adalah tetamu di sini sebelum ini
Dialog: 0,0:47:15.78,0:47:16.82,teks umum,,0,0,0,,Tetapi kini semuanya berbeza
Dialog: 0,0:47:16.90,0:47:19.49,teks umum,,0,0,0,,Dia ahli Sosnovy Bor, dan anda bukan
Dialog: 0,0:47:20.24,0:47:21.37,teks umum,,0,0,0,,Jadi anda tidak boleh
Dialog: 0,0:47:21.45,0:47:23.45,teks umum,,0,0,0,,Apakah yang akan berlaku kepada pemiliknya?
Dialog: 0,0:47:23.54,0:47:26.91,teks umum,,0,0,0,,Dia sangat mabuk. Saya kena jaga dia
Dialog: 0,0:47:27.00,0:47:30.21,teks umum,,0,0,0,,Hamba Chongjingak akan menjaganya
Dialog: 0,0:47:33.17,0:47:34.38,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:47:35.88,0:47:38.72,teks umum,,0,0,0,,Saya mesti rapat dengan pemilik
Dialog: 0,0:47:38.80,0:47:40.05,teks umum,,0,0,0,,Izinkan saya masuk
Dialog: 0,0:47:40.14,0:47:42.81,teks umum,,0,0,0,,Biarkan dia masuk
Dialog: 0,0:47:42.89,0:47:45.48,teks umum,,0,0,0,,Uk akan melakukan sesuatu jika dia tiada
Dialog: 0,0:47:45.56,0:47:49.56,teks umum,,0,0,0,,Tiada seorang ahli silap mata pun Jeongjingak mempunyai keistimewaan pembantu rumahnya sendiri
Dialog: 0,0:47:51.11,0:47:54.32,teks umum,,0,0,0,,Chan Wook memasuki Sosnovy Bor, jadi dia mesti mengikut peraturan kami
Dialog: 0,0:47:55.15,0:47:57.24,teks umum,,0,0,0,,Jadi saya benar-benar tidak boleh log masuk?
Dialog: 0,0:47:57.32,0:47:58.78,teks umum,,0,0,0,,Ini adalah peraturan
Dialog: 0,0:47:59.41,0:48:01.62,teks umum,,0,0,0,,Pulang ke rumah buat masa ini
Dialog: 0,0:48:01.70,0:48:03.58,teks umum,,0,0,0,,Saya akan bawa Uk pulang apabila dia bangun
Dialog: 0,0:48:03.66,0:48:05.08,teks umum,,0,0,0,,Chan Wook tidak boleh pergi
Dialog: 0,0:48:05.75,0:48:09.25,teks umum,,0,0,0,,Dia tidak boleh meninggalkan Sosnovy Bor sehingga dia menamatkan latihannya
Dialog: 0,0:48:09.33,0:48:10.83,teks umum,,0,0,0,,Ini juga merupakan peraturan
Dialog: 0,0:48:13.29,0:48:15.59,teks umum,,0,0,0,,Tepat sekali. Kami tinggal di sini juga
Dialog: 0,0:48:16.38,0:48:17.34,teks umum,,0,0,0,,Iaitu,
Dialog: 0,0:48:17.42,0:48:20.38,teks umum,,0,0,0,,Saya tidak boleh masuk dan tuan saya tidak boleh keluar?
Dialog: 0,0:48:20.47,0:48:22.35,teks umum,,0,0,0,,Dan kita tidak boleh bersama?
Dialog: 0,0:48:22.43,0:48:25.47,teks umum,,0,0,0,,Setelah saya faham, pulang bersama mereka
Dialog: 0,0:48:26.93,0:48:28.14,teks umum,,0,0,0,,Tunggu...
Dialog: 0,0:48:44.66,0:48:46.62,teks umum,,0,0,0,,Ini hari pertama Chan Wook di Jeonjingak
Dialog: 0,0:48:46.70,0:48:49.21,teks umum,,0,0,0,,Adakah anda mahu dia melanggar peraturan pada hari pertamanya?
Dialog: 0,0:48:56.80,0:48:59.76,teks umum,,0,0,0,,Izinkan saya masuk!
Dialog: 0,0:49:02.26,0:49:05.05,contact,,0,0,0,,Jika anda berdiri di sana, dia tidak akan pergi
Dialog: 0,0:49:05.14,0:49:07.77,contact,,0,0,0,,Jika kepala tahu, saya akan menghukum dia
Dialog: 0,0:49:07.85,0:49:09.02,teks umum,,0,0,0,,Jadi mari kita pergi
Dialog: 0,0:49:10.31,0:49:14.40,teks umum,,0,0,0,,Moo Dok, pulang ke rumah. Kami akan cari jalan
Dialog: 0,0:49:22.36,0:49:23.70,teks umum,,0,0,0,,Cikgu!
Dialog: 0,0:49:28.49,0:49:30.29,teks umum,,0,0,0,,Bawa saya bersama kamu!
Dialog: 0,0:49:31.58,0:49:32.87,teks umum,,0,0,0,,Cikgu!
Dialog: 0,0:49:48.31,0:49:50.52,teks umum,,0,0,0,,Atuk, apa khabar?
Dialog: 0,0:49:50.60,0:49:51.60,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:49:52.69,0:49:56.23,teks umum,,0,0,0,,Anda telah berkembang menjadi seorang gadis yang cantik
Dialog: 0,0:49:57.27,0:50:00.15,teks umum,,0,0,0,,Tuan Huo, seorang ahli silap mata yang mabuk telah dihantar
Dialog: 0,0:50:00.23,0:50:01.61,teks umum,,0,0,0,,disebabkan nafasnya yang berat
Dialog: 0,0:50:01.69,0:50:05.32,teks umum,,0,0,0,,Dia hanya mabuk, jaga dia sendiri
Dialog: 0,0:50:05.41,0:50:08.87,teks umum,,0,0,0,,Ini Chan Wook. Awak beri dia tenaga awak
Dialog: 0,0:50:08.95,0:50:11.58,teks umum,,0,0,0,,Apa? Chan Wook?
Dialog: 0,0:50:11.66,0:50:12.83,teks umum,,0,0,0,,Uk?
Dialog: 0,0:50:35.48,0:50:37.27,di sebalik tabir,,0,0,0,,Itu ahli silap mata
Dialog: 0,0:50:39.98,0:50:42.32,teks umum,,0,0,0,,Yoon Ok, ke sini
Dialog: 0,0:50:42.40,0:50:43.57,teks umum,,0,0,0,,Okey
Dialog: 0,0:50:48.99,0:50:52.70,teks umum,,0,0,0,,Pintu tenaganya ditutup selama bertahun-tahun, dan saya membukanya untuknya
Dialog: 0,0:50:53.29,0:50:56.04,teks umum,,0,0,0,,Saya juga memberi dia tenaga saya. Nama dia Chan Wook
Dialog: 0,0:50:57.96,0:50:59.04,teks umum,,0,0,0,,Chang Wook?
Dialog: 0,0:50:59.13,0:51:02.67,teks umum,,0,0,0,,Ya. Baru sebulan berlalu dan dia sudah pun menguasai Ryusu
Dialog: 0,0:51:02.76,0:51:03.92,teks umum,,0,0,0,,Dia seorang genius
Dialog: 0,0:51:04.42,0:51:05.55,teks umum,,0,0,0,,Selama sebulan?
Dialog: 0,0:51:06.88,0:51:09.47,teks umum,,0,0,0,,Sungguh genius
Dialog: 0,0:51:23.23,0:51:25.57,teks umum,,0,0,0,,Saya sangat mabuk
Dialog: 0,0:51:25.65,0:51:28.66,teks umum,,0,0,0,,Saya akan pergi ke bilik saya dan tidur
Dialog: 0,0:51:28.74,0:51:30.37,teks umum,,0,0,0,,Jaga dia
Dialog: 0,0:51:30.95,0:51:32.70,teks umum,,0,0,0,,Ayuh
Dialog: 0,0:51:32.79,0:51:34.37,teks umum,,0,0,0,,Baiklah, datuk
Dialog: 0,0:51:50.97,0:51:52.72,teks umum,,0,0,0,,Kita berjumpa lagi
Dialog: 0,0:51:54.64,0:51:56.85,teks umum,,0,0,0,,En. Chang Wook
Dialog: 0,0:52:13.28,0:52:15.66,teks umum,,0,0,0,,Saya tidak datang jauh-jauh untuk berputus asa
Dialog: 0,0:52:18.21,0:52:19.96,teks umum,,0,0,0,,Saya akan masuk ke dalam dengan apa-apa cara yang perlu
Dialog: 0,0:52:36.27,0:52:37.52,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:52:45.40,0:52:46.61,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:52:47.78,0:52:51.82,teks umum,,0,0,0,,Tuan kamu sedang nazak. Kepala saya berpusing
Dialog: 0,0:53:32.49,0:53:33.57,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:53:35.74,0:53:37.28,teks umum,,0,0,0,,jika awak tinggalkan saya,
Dialog: 0,0:53:39.45,0:53:41.37,teks umum,,0,0,0,,Saya bersumpah saya akan membunuh awak
Dialog: 0,0:54:07.86,0:54:09.28,teks umum,,0,0,0,,En. Yul?
Dialog: 0,0:54:11.61,0:54:13.65,teks umum,,0,0,0,,Saya fikir mungkin awak masih di sini
Dialog: 0,0:54:14.74,0:54:15.99,teks umum,,0,0,0,,Dan saya betul
Dialog: 0,0:54:18.12,0:54:19.91,teks umum,,0,0,0,,Saya tidak akan pergi
Dialog: 0,0:54:22.08,0:54:24.62,teks umum,,0,0,0,,Saya mesti bersama pemiliknya
Dialog: 0,0:54:27.46,0:54:29.71,teks umum,,0,0,0,,Duduk di sini tidak akan menyelesaikan masalah
Dialog: 0,0:54:29.80,0:54:32.47,teks umum,,0,0,0,,Cukup buat Uka melanggar peraturan
Dialog: 0,0:54:32.55,0:54:35.09,teks umum,,0,0,0,,Maka semua jerih payahnya akan menjadi sia-sia
Dialog: 0,0:54:37.34,0:54:38.64,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:54:39.85,0:54:41.56,teks umum,,0,0,0,,Pulang, tunggu di sana
Dialog: 0,0:54:42.39,0:54:43.85,teks umum,,0,0,0,,Saya akan menemani awak
Dialog: 0,0:54:54.57,0:54:56.57,teks umum,,0,0,0,,Beritahu tuanku,
Dialog: 0,0:54:57.95,0:54:59.66,teks umum,,0,0,0,,bahawa saya akan mencari jalan
Dialog: 0,0:55:00.45,0:55:02.95,teks umum,,0,0,0,,sampai ke Sosnovy Bor kepada pemilik
Dialog: 0,0:55:05.33,0:55:07.37,teks umum,,0,0,0,,Suruh dia bertahan sehingga itu
Dialog: 0,0:55:09.79,0:55:12.55,teks umum,,0,0,0,,Baiklah. Saya akan memberitahu anda
Dialog: 0,0:56:07.69,0:56:09.81,teks umum,,0,0,0,,Kepala saya sangat sakit
Dialog: 0,0:56:12.65,0:56:14.40,teks umum,,0,0,0,,Semuanya putera raja
Dialog: 0,0:56:16.36,0:56:17.65,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:56:18.49,0:56:21.37,teks umum,,0,0,0,,- Bawa air\N{\i1}- Siapa Moo Deok?
Dialog: 0,0:56:24.29,0:56:25.37,teks umum,,0,0,0,,Siapa awak?
Dialog: 0,0:56:25.45,0:56:28.33,teks umum,,0,0,0,,Tidak ingat? Kami bertemu di rumah penginapan
Dialog: 0,0:56:30.62,0:56:31.88,kenangan condong,,0,0,0,,Jangan berbohong
Dialog: 0,0:56:31.96,0:56:34.92,kenangan,,0,0,0,,Anda merenungnya sepanjang masa!
Dialog: 0,0:56:35.92,0:56:38.38,teks umum,,0,0,0,,Ah, Ta Sun sesuatu di sana
Dialog: 0,0:56:39.13,0:56:40.59,teks umum,,0,0,0,,Tepat sekali, Song Yi
Dialog: 0,0:56:41.68,0:56:42.80,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:56:42.89,0:56:47.31,teks umum,,0,0,0,,Puan Ho ialah cucu kepada Master Ho Yeom
Dialog: 0,0:56:47.39,0:56:48.56,teks umum,,0,0,0,,Faham
Dialog: 0,0:56:50.02,0:56:51.44,teks umum,,0,0,0,,Itu sahaja?
Dialog: 0,0:56:51.52,0:56:52.81,teks umum,,0,0,0,,Jika dia memberitahu Cikgu Huo,
Dialog: 0,0:56:52.90,0:56:55.73,teks umum,,0,0,0,,betapa kurang ajarnya kamu kepadanya, tuan akan marah kepada kamu
Dialog: 0,0:56:56.48,0:56:58.65,teks umum,,0,0,0,,Dia tidak pernah menyukai saya
Dialog: 0,0:56:58.74,0:56:59.86,teks umum,,0,0,0,,Biar dia cakap
Dialog: 0,0:57:03.32,0:57:04.74,teks umum,,0,0,0,,Sekurang-kurangnya terima kasih kepadanya
Dialog: 0,0:57:04.83,0:57:06.54,teks umum,,0,0,0,,Puan menjaga awak sepanjang malam
Dialog: 0,0:57:06.62,0:57:07.91,teks umum,,0,0,0,,Puan awak?
Dialog: 0,0:57:16.71,0:57:18.21,teks umum,,0,0,0,,Lebih baik jangan sebutkan perkara ini kepadanya
Dialog: 0,0:57:20.13,0:57:23.26,teks umum,,0,0,0,,Awak dah jumpa Uk belum?
Dialog: 0,0:57:24.01,0:57:24.93,teks umum,,0,0,0,,Ya
Dialog: 0,0:57:25.01,0:57:29.98,teks umum,,0,0,0,,Chan Wook membantu Yoon Ok ketika dia dalam kesusahan
Dialog: 0,0:57:30.06,0:57:31.39,teks umum,,0,0,0,,Faham
Dialog: 0,0:57:31.48,0:57:34.69,teks umum,,0,0,0,,Uk bukan salah seorang yang hanya membantu orang
Dialog: 0,0:57:35.94,0:57:37.86,teks umum,,0,0,0,,Apa yang kamu cakap tentang dia?
Dialog: 0,0:57:40.15,0:57:41.78,teks umum,,0,0,0,,Saya dengar awak tiba dari kubu Vol
Dialog: 0,0:57:42.61,0:57:46.33,teks umum,,0,0,0,,Saya dan ibu lelaki itu berasal dari sana
Dialog: 0,0:57:47.33,0:57:50.66,teks umum,,0,0,0,,- Saya faham\N - Mungkin itulah sebabnya
Dialog: 0,0:57:50.75,0:57:52.92,teks umum,,0,0,0,,anda ingatkan saya pada Puan Do Hwa
Dialog: 0,0:57:54.46,0:57:57.42,teks umum,,0,0,0,,Saya rasa awak dan tuan saya ditakdirkan untuk bersama
Dialog: 0,0:57:59.71,0:58:02.09,teks umum,,0,0,0,,Jika orang dari bandar yang sama sepatutnya serupa,
Dialog: 0,0:58:02.68,0:58:04.93,teks umum,,0,0,0,,maka anda juga mesti serupa antara satu sama lain
Dialog: 0,0:58:06.93,0:58:08.89,teks umum,,0,0,0,,Tetapi anda tidak mempunyai persamaan
Dialog: 0,0:58:11.02,0:58:12.48,teks umum,,0,0,0,,Saya tidak faham apa yang anda maksudkan
Dialog: 0,0:58:13.73,0:58:15.31,contact,,0,0,0,,Maiden Kim, awak hebat,
Dialog: 0,0:58:15.40,0:58:19.69,teks umum,,0,0,0,,tetapi kadangkala anda membesar-besarkan dan membuat kesimpulan terburu-buru
Dialog: 0,0:58:20.57,0:58:23.07,teks umum,,0,0,0,,Adakah anda mengatakan saya berbohong?
Dialog: 0,0:58:24.20,0:58:25.53,teks umum,,0,0,0,,Saya tidak cakap begitu
Dialog: 0,0:58:26.12,0:58:27.66,contact,,0,0,0,,Di sini dan sekarang
Dialog: 0,0:58:27.74,0:58:31.12,teks umum,,0,0,0,,Mereka kecewa malah menggelarkan diri mereka penipu
Dialog: 0,0:58:31.20,0:58:32.29,teks umum,,0,0,0,,Ya, ya, sudah tentu
Dialog: 0,0:58:32.37,0:58:35.71,teks umum,,0,0,0,,Saya pembohong yang mudah marah
Dialog: 0,0:58:35.79,0:58:37.88,teks umum,,0,0,0,,Bila saya panggil awak penipu?
Dialog: 0,0:58:37.96,0:58:40.21,teks umum,,0,0,0,,Sekarang itulah yang anda katakan
Dialog: 0,0:58:40.30,0:58:41.55,teks umum,,0,0,0,,Ini adalah kata-kata anda
Dialog: 0,0:58:41.63,0:58:42.92,contact,,0,0,0,,- Apa salah awak?\N- Salah awak...
Dialog: 0,0:58:43.01,0:58:45.84,teks umum,,0,0,0,,Apakah jenis hubungan yang mereka ada?
Dialog: 0,0:58:48.89,0:58:51.52,teks umum,,0,0,0,,Mereka mempunyai hubungan yang aneh dan pelik,
Dialog: 0,0:58:51.60,0:58:53.77,teks umum,,0,0,0,, dilampirkan
Dialog: 0,0:58:53.85,0:58:56.23,italic,,0,0,0,,- Awak orang pertama yang kecewa\N- Awak cakap saya tipu
Dialog: 0,0:58:56.31,0:58:58.27,teks umum,,0,0,0,,Nampaknya mereka rapat, tetapi tidak ada yang istimewa di sana
Dialog: 0,0:58:58.36,0:59:00.52,teks umum,,0,0,0,,- Anda sendiri duduk di sini, berulang...\N-{\i1} Tetapi anda lihat,
Dialog: 0,0:59:00.61,0:59:03.82,teks umum,,0,0,0,,- dia terlalu bodoh\N- {\i1}Teruskan panggil saya penipu
Dialog: 0,0:59:03.90,0:59:05.32,teks umum,,0,0,0,,Dan ia menjengkelkan
Dialog: 0,0:59:05.40,0:59:06.41,teks umum,,0,0,0,,Tiada perkataan
Dialog: 0,0:59:06.49,0:59:08.66,teks umum,,0,0,0,,Kami mempunyai bukti dan saksi
Dialog: 0,0:59:08.74,0:59:10.70,teks umum,,0,0,0,,Saksi? Betapa menjengkelkan anda!
Dialog: 0,0:59:12.75,0:59:15.75,teks umum,,0,0,0,,Bagaimana anda dan Uk bertemu?
Dialog: 0,0:59:18.04,0:59:19.59,teks umum,,0,0,0,,- Nah...\N{\i1}- Puan
Dialog: 0,0:59:22.76,0:59:24.17,teks umum,,0,0,0,,Maaf kerana mengganggu
Dialog: 0,0:59:25.30,0:59:26.59,teks umum,,0,0,0,,Boleh kita bercakap?
Dialog: 0,0:59:27.84,0:59:29.39,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:59:30.51,0:59:31.97,teks umum,,0,0,0,,Anda boleh bercakap di sini
Dialog: 0,0:59:32.89,0:59:34.93,teks umum,,0,0,0,,Ini adalah peribadi!
Dialog: 0,0:59:35.64,0:59:36.64,teks umum,,0,0,0,,Jom
Dialog: 0,0:59:38.23,0:59:40.44,teks umum,,0,0,0,,Apa yang berlaku dengan mereka?
Dialog: 0,0:59:42.65,0:59:45.82,teks umum,,0,0,0,, Lelaki itu kelihatan sangat serius
Dialog: 0,0:59:45.90,0:59:47.45,teks umum,,0,0,0,,Itu sahaja
Dialog: 0,0:59:47.53,0:59:50.62,teks umum,,0,0,0,,Melihat dari cara Yoon Ok mengikuti,
Dialog: 0,0:59:50.70,0:59:52.24,teks umum,,0,0,0,,ada sesuatu di antara mereka
Dialog: 0,0:59:52.95,0:59:54.79,teks umum,,0,0,0,,- Apa ini?\N- Siapa tahu?
Dialog: 0,1:00:01.29,1:00:03.17,teks umum,,0,0,0,,Saya akan mengikuti mereka dan mengetahui
Dialog: 0,1:00:03.25,1:00:04.38,teks umum,,0,0,0,,Duduk segera!
Dialog: 0,1:00:05.13,1:00:06.47,teks umum,,0,0,0,,Duduk sekarang!
Dialog: 0,1:00:07.17,1:00:10.47,teks umum,,0,0,0,,Tetapi ini menarik untuk anda
Dialog: 0,1:00:10.55,1:00:12.30,teks umum,,0,0,0,,Bagaimana anda boleh menjadi seorang yang lembab?
Dialog: 0,1:00:12.97,1:00:14.22,teks umum,,0,0,0,,Dia tiada harapan
Dialog: 0,1:00:14.81,1:00:16.39,miring,,0,0,0,,Ia seperti penyakit yang tidak boleh diubati
Dialog: 0,1:00:16.48,1:00:17.39,teks umum,,0,0,0,,Duduk
Dialog: 0,1:00:21.27,1:00:24.53,teks umum,,0,0,0,,Kenapa mereka selalu memarahi saya?
Dialog: 0,1:00:30.57,1:00:32.12,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,1:00:33.12,1:00:36.20,teks umum,,0,0,0,,Adakah anda sudah memberitahu semua orang tentang apa yang berlaku pada hari itu?
Dialog: 0,1:00:38.75,1:00:40.75,kenangan,,0,0,0,,Saya tidak selesa dengan anda mengikuti saya,
Dialog: 0,1:00:40.83,1:00:42.42,kenangan,,0,0,0,,dan ia juga tidak sopan di pihak anda
Dialog: 0,1:00:42.50,1:00:43.88,kenangan,,0,0,0,,Kecantikan tidak menarik perhatian
Dialog: 0,1:00:44.67,1:00:46.88,kenangan,,0,0,0,,Dan saya tidak mengikuti awak
Dialog: 0,1:00:48.34,1:00:49.55,teks umum,,0,0,0,,Tidak
Dialog: 0,1:00:50.26,1:00:52.85,teks umum,,0,0,0,,Saya tidak akan menyebut sesuatu yang sangat memalukan
Dialog: 0,1:00:53.55,1:00:55.14,teks umum,,0,0,0,,Anda tidak fikir saya comel
Dialog: 0,1:00:55.22,1:00:58.56,teks umum,,0,0,0,,Kecantikan saya tidak menarik perhatian anda dan anda tidak mengikuti saya
Dialog: 0,1:00:59.14,1:01:00.89,teks umum,,0,0,0,,Saya malu untuk memikirkannya
Dialog: 0,1:01:00.98,1:01:02.44,teks umum,,0,0,0,,Jadi saya akan diam
Dialog: 0,1:01:02.52,1:01:03.36,teks umum,,0,0,0,,Saya ada
Dialog: 0,1:01:04.11,1:01:06.69,teks umum,,0,0,0,,akal sehat
Dialog: 0,1:01:07.32,1:01:09.70,teks umum,,0,0,0,,Tidak, bukan itu yang saya maksudkan
Dialog: 0,1:01:10.36,1:01:11.28,teks umum,,0,0,0,,Saya bercakap tentang penelan jiwa
Dialog: 0,1:01:11.36,1:01:14.12,teks umum,,0,0,0,, Penelan jiwa yang cuba membunuh awak
Dialog: 0,1:01:14.70,1:01:17.79,teks umum,,0,0,0,,Jadi ia benar-benar penelan jiwa?
Dialog: 0,1:01:17.87,1:01:20.37,teks umum,,0,0,0,,Ya. Tetapi anda tidak boleh bercakap mengenainya
Dialog: 0,1:01:20.46,1:01:23.83,teks umum,,0,0,0,,Tolong bantu saya. Rahsia
Dialog: 0,1:01:25.42,1:01:29.17,teks umum,,0,0,0,,Anda telah menyelamatkan nyawa saya, saya akan memenuhi permintaan awak
Dialog: 0,1:01:30.01,1:01:31.09,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:01:31.18,1:01:34.26,teks umum,,0,0,0,,Oleh kerana kita berkongsi satu rahsia, kita hendaklah sekurang-kurangnya memperkenalkan diri
Dialog: 0,1:01:34.97,1:01:36.56,teks umum,,0,0,0,,Saya Ho Yoon Ok
Dialog: 0,1:01:37.18,1:01:38.35,teks umum,,0,0,0,,Saya Chang Wook
Dialog: 0,1:01:38.93,1:01:40.85,teks umum,,0,0,0,,Saya tahu. Banyak yang saya dengar
Dialog: 0,1:01:40.93,1:01:42.73,teks umum,,0,0,0,,Saya juga. Orang tua ini...
Dialog: 0,1:01:42.81,1:01:44.10,teks umum,,0,0,0,,Itulah...
Dialog: 0,1:01:44.19,1:01:47.32,teks umum,,0,0,0,,Cikgu Ho sentiasa bercakap besar tentang cucunya
Dialog: 0,1:01:47.40,1:01:50.24,teks umum,,0,0,0,,Adakah datuk memberitahu kamu sesuatu tentang saya?
Dialog: 0,1:01:52.40,1:01:54.03,teks umum,,0,0,0,,Anda akan malu
Dialog: 0,1:01:54.62,1:01:55.78,teks umum,,0,0,0,,Sungguh...
Dialog: 0,1:01:56.78,1:01:59.75,teks umum,,0,0,0,,dia berjalan dan mengulangi perkataan cucunya
Dialog: 0,1:01:59.83,1:02:02.08,teks umum,,0,0,0,,"cantik, seperti bidadari yang cantik." Tidak, kan?
Dialog: 0,1:02:02.66,1:02:06.04,teks umum,,0,0,0,,Ya, dia memberitahu semua orang bahawa anda terpesona dengan kecantikan anda
Dialog: 0,1:02:06.79,1:02:07.92,teks umum,,0,0,0,,Bukan saya, malangnya
Dialog: 0,1:02:12.47,1:02:13.97,teks umum,,0,0,0,,Ia sungguh janggal
Dialog: 0,1:02:14.68,1:02:16.22,teks umum,,0,0,0,,Saya tidak percaya...
Dialog: 0,1:02:16.30,1:02:17.14,teks umum,,0,0,0,,Orang tua ini...
Dialog: 0,1:02:17.22,1:02:20.72,teks umum,,0,0,0,,Iaitu, Guru Huo menunjukkan kasih sayang sedemikian
Dialog: 0,1:02:20.81,1:02:22.81,teks umum,,0,0,0,,Dia bercakap tentang ibu saya dengan cara yang sama
Dialog: 0,1:02:23.69,1:02:26.36,teks umum,,0,0,0,,Saya diberitahu bahawa saya kelihatan seperti ibu awak
Dialog: 0,1:02:27.44,1:02:31.19,teks umum,,0,0,0,,Saya rasa inilah rupa pari-pari kepada datuk
Dialog: 0,1:02:37.41,1:02:38.58,teks umum,,0,0,0,,Apa?
Dialog: 0,1:02:39.87,1:02:41.45,teks umum,,0,0,0,,Tidak serupa?
Dialog: 0,1:02:44.25,1:02:45.50,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,1:02:47.92,1:02:49.42,teks umum,,0,0,0,,Saya tidak pernah melihatnya
Dialog: 0,1:02:58.43,1:03:00.18,teks umum,,0,0,0,,Dan bagaimana saya akan berjumpa dengan bidadari?
Dialog: 0,1:03:00.26,1:03:01.64,teks umum,,0,0,0,,Sukar untuk disebut
Dialog: 0,1:03:03.93,1:03:05.85,teks umum,,0,0,0,,Adakah anda sedar?
Dialog: 0,1:03:05.94,1:03:09.73,teks umum,,0,0,0,,Ya. Dengar awak ada sepanjang malam
Dialog: 0,1:03:11.11,1:03:12.40,teks umum,,0,0,0,,Ya
Dialog: 0,1:03:12.48,1:03:15.82,teks umum,,0,0,0,,Saya sangka itu Moo Deok. Maaf
Dialog: 0,1:03:19.28,1:03:22.33,teks am,,0,0,0,,Saya membuat teh dengan herba
Dialog: 0,1:03:34.01,1:03:35.72,teks umum,,0,0,0,,Saya harap dia akan minum
Dialog: 0,1:03:37.76,1:03:39.34,prasasti,,0,0,0,,Saejukwon
Dialog: 0,1:03:39.43,1:03:41.56,teks umum,,0,0,0,,Tunggu
Dialog: 0,1:03:43.22,1:03:44.68,teks umum,,0,0,0,,Pernahkah anda melihat Moo Dok?
Dialog: 0,1:03:44.77,1:03:47.14,teks umum,,0,0,0,,Dia datang bersama saya semalam, tetapi dia tidak ditemui di mana-mana
Dialog: 0,1:03:47.73,1:03:48.73,teks umum,,0,0,0,,Dia pulang ke rumah
Dialog: 0,1:03:50.90,1:03:53.57,teks umum,,0,0,0,,Kenapa dia pergi tanpa saya?
Dialog: 0,1:03:54.53,1:03:57.07,teks umum,,0,0,0,,Tinggalkan pemilik anda yang mabuk dan pulang ke rumah?
Dialog: 0,1:03:57.15,1:04:00.07,teks umum,,0,0,0,,Sekarang hamba Sosnovy Bor akan menjaga kamu
Dialog: 0,1:04:00.16,1:04:03.24,teks umum,,0,0,0,,Moo Dok bukan milik kita, dia tidak boleh datang ke sini
Dialog: 0,1:04:05.75,1:04:06.96,teks umum,,0,0,0,,Tunggu...
Dialog: 0,1:04:10.63,1:04:12.09,contact,,0,0,0,,Moo Dok fikir,
Dialog: 0,1:04:12.17,1:04:15.71,teks umum,,0,0,0,,dia boleh mengikuti Uk ke Sosnovy Bor
Dialog: 0,1:04:16.92,1:04:19.89,teks umum,,0,0,0,,Saya pasti dia membayangkan bagaimana dia akan melihat anda setiap hari
Dialog: 0,1:04:19.97,1:04:21.47,teks umum,,0,0,0,,Mungkin kecewa
Dialog: 0,1:04:34.40,1:04:37.61,teks umum,,0,0,0,,Ya. Harap dia ok
Dialog: 0,1:04:41.07,1:04:42.49,teks umum,,0,0,0,,Nampaknya, Uk mendapat tahu
Dialog: 0,1:04:43.33,1:04:44.74,contact,,0,0,0,,Pasti dia akan pergi ke bapa saudaranya
Dialog: 0,1:04:44.83,1:04:46.87,teks umum,,0,0,0,,Pakcik tidak membenarkan ini
Dialog: 0,1:04:50.75,1:04:54.67,teks umum,,0,0,0,,Tiada seorang ahli silap mata pun mempunyai pembantu rumah peribadi
Dialog: 0,1:04:55.55,1:04:58.01,teks umum,,0,0,0,,Dan anda tidak terkecuali
Dialog: 0,1:04:58.09,1:04:59.13,teks umum,,0,0,0,,Kenapa?
Dialog: 0,1:04:59.72,1:05:02.43,teks umum,,0,0,0,,Sebagai pengecualian, anda telah menghalau saya dari sini 20 tahun yang lalu
Dialog: 0,1:05:04.26,1:05:05.97,teks umum,,0,0,0,,Mengapa tidak membuat pengecualian lain?
Dialog: 0,1:05:07.35,1:05:10.52,teks umum,,0,0,0,,Semuanya kerana Tansu mengajar kamu
Dialog: 0,1:05:12.69,1:05:14.11,teks umum,,0,0,0,,di luar dinding ini?
Dialog: 0,1:05:17.07,1:05:18.74,teks umum,,0,0,0,,Anda perlukan Moo Dok,
Dialog: 0,1:05:19.40,1:05:22.28,teks umum,,0,0,0,,untuk terus berhubung dengan guru?
Dialog: 0,1:05:23.57,1:05:26.37,teks umum,,0,0,0,,Cikgu Li sudah mengesahkan bahawa saya melatih diri
Dialog: 0,1:05:27.58,1:05:30.21,teks umum,,0,0,0,,Dia menyelamatkan kamu, tetapi orang masih bergosip
Dialog: 0,1:05:30.71,1:05:32.12,teks umum,,0,0,0,,Seseorang pun berfikir,
Dialog: 0,1:05:32.96,1:05:35.71,teks umum,,0,0,0,,apa yang ayah awak, Chang Gan, ajar awak
Dialog: 0,1:05:38.05,1:05:40.51,teks umum,,0,0,0,,Mula-mula orang kata saya bukan anaknya
Dialog: 0,1:05:41.88,1:05:43.89,teks umum,,0,0,0,,Sekarang mereka berceloteh yang ayah saya ajar saya?
Dialog: 0,1:05:45.76,1:05:49.52,teks umum,,0,0,0,,Apabila pengecualian berlaku, orang mula bersembang
Dialog: 0,1:05:50.43,1:05:53.52,teks umum,,0,0,0,,Anda cepat menguasai Ryusu dan menggunakan Tansu
Dialog: 0,1:05:54.48,1:05:56.52,teks umum,,0,0,0,,Ini terlalu luar biasa
Dialog: 0,1:05:59.48,1:06:00.69,teks umum,,0,0,0,,Anda...
Dialog: 0,1:06:01.65,1:06:03.86,teks umum,,0,0,0,,cuba menarik perhatian,
Dialog: 0,1:06:05.32,1:06:07.12,teks umum,,0,0,0,,memaksa orang bercakap tentang diri mereka sendiri?
Dialog: 0,1:06:09.91,1:06:13.00,luar skrin,,0,0,0,,Anda tidak boleh biarkan ketua mengesyaki Moo Deok
Dialog: 0,1:06:13.08,1:06:14.92,luar skrin,,0,0,0,,Jika tidak, dia akan tahu dia seorang nomad
Dialog: 0,1:06:16.46,1:06:19.30,teks umum,,0,0,0,,Baiklah, saya faham anda menentang
Dialog: 0,1:06:21.30,1:06:24.72,teks umum,,0,0,0,,Jadi adakah anda hanya mengikut peraturan?
Dialog: 0,1:06:24.80,1:06:25.80,teks umum,,0,0,0,,Ya
Dialog: 0,1:06:26.47,1:06:28.26,teks umum,,0,0,0,,Saya sampai di sini dengan susah payah
Dialog: 0,1:06:28.35,1:06:32.39,teks umum,,0,0,0,,Saya tidak boleh mengambil risiko untuk beberapa pembantu rumah
Dialog: 0,1:06:46.82,1:06:49.87,teks umum,,0,0,0,,Saya ingin membeli azimat semangat di pasaran gelap
Dialog: 0,1:06:50.99,1:06:52.25,teks umum,,0,0,0,,Cari saya satu
Dialog: 0,1:06:52.33,1:06:55.42,teks umum,,0,0,0,,Bagaimana anda boleh meminta ini apabila seseorang terbunuh kerana azimat?
Dialog: 0,1:06:55.50,1:06:59.59,teks umum,,0,0,0,,Jika anda ditangkap, mereka akan membunuh anda juga
Dialog: 0,1:06:59.67,1:07:03.84,teks umum,,0,0,0,,Saya sepatutnya berada di sebelahnya. Pemilik memerlukan saya
Dialog: 0,1:07:03.92,1:07:06.80,teks umum,,0,0,0,,Tidak sama sekali. Dia tak perlukan awak lagi
Dialog: 0,1:07:07.55,1:07:10.72,teks umum,,0,0,0,,Anda diperlukan apabila dia melarikan diri seorang diri dan berlatih
Dialog: 0,1:07:10.81,1:07:13.39,teks umum,,0,0,0,,Dan kini dia berada di Jeonjingak
Dialog: 0,1:07:13.48,1:07:15.56,teks umum,,0,0,0,,Terdapat banyak pelayan lain di sana
Dialog: 0,1:07:16.14,1:07:17.85,teks umum,,0,0,0,,Ahli silap mata Sosnovy Bor juga akan membantunya
Dialog: 0,1:07:17.94,1:07:20.36,teks umum,,0,0,0,,Anda tidak boleh berbuat apa-apa lagi untuknya
Dialog: 0,1:07:20.44,1:07:22.11,teks umum,,0,0,0,,Kenapa dia perlukan awak?
Dialog: 0,1:07:28.87,1:07:31.99,teks umum,,0,0,0,,Ketua mengamanahkan saya untuk mengajar anda perkara asas
Dialog: 0,1:07:32.08,1:07:35.37,teks umum,,0,0,0,,Saya berbesar hati menjadi guru kamu
Dialog: 0,1:07:36.54,1:07:39.00,teks umum,,0,0,0,,Bergantung pada anda
Dialog: 0,1:07:42.13,1:07:44.13,teks umum,,0,0,0,,Ini ialah satu set peraturan untuk Jeongjingak
Dialog: 0,1:07:44.21,1:07:48.18,teks umum,,0,0,0,,Dari buku-buku ini anda akan belajar tentang kebaikan ahli sihir, serta semua larangan
Dialog: 0,1:07:48.80,1:07:50.01,teks umum,,0,0,0,,Anda tidak boleh
Dialog: 0,1:07:50.10,1:07:52.89,teks umum,,0,0,0,,tinggalkan tempat ini sehingga anda mempelajari segala-galanya
Dialog: 0,1:07:54.98,1:07:57.14,teks umum,,0,0,0,,Ya. Saya akan ikut peraturan
Dialog: 0,1:07:57.77,1:07:59.02,teks umum,,0,0,0,,Anda boleh mulakan
Dialog: 0,1:08:00.06,1:08:01.23,teks umum,,0,0,0,,baca
Dialog: 0,1:08:08.61,1:08:09.66,teks umum,,0,0,0,,En.
Dialog: 0,1:08:11.95,1:08:13.03,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:08:13.66,1:08:15.20,teks umum,,0,0,0,,Bagaimana anda boleh masuk?
Dialog: 0,1:08:18.16,1:08:19.75,teks umum,,0,0,0,,Saya fikir anda telah ditutup semula
Dialog: 0,1:08:19.83,1:08:22.34,teks umum,,0,0,0,,di dalam bilik rahsia kerana tidak taat kepada kepala
Dialog: 0,1:08:23.21,1:08:25.42,teks umum,,0,0,0,,Tetapi di sini anda berada di bilik latihan
Dialog: 0,1:08:26.46,1:08:28.43,teks umum,,0,0,0,,Saya bangga dengan awak
Dialog: 0,1:08:28.51,1:08:31.47,teks umum,,0,0,0,,Hamba Kim, kamu boleh berbangga dengan diri sendiri
Dialog: 0,1:08:32.22,1:08:33.72,teks umum,,0,0,0,,Anda membesarkan lelaki ini dengan baik
Dialog: 0,1:08:36.60,1:08:39.89,teks umum,,0,0,0,,Perlu diperhatikan bahawa jadual adalah rendah
Dialog: 0,1:08:42.86,1:08:44.52,teks umum,,0,0,0,,Dan kerusinya tidak selesa
Dialog: 0,1:08:45.23,1:08:47.03,teks umum,,0,0,0,,Saya mengatasi yang lain
Dialog: 0,1:08:47.11,1:08:48.82,teks umum,,0,0,0,,dan saya tidak selesa
Dialog: 0,1:08:48.90,1:08:52.12,teks umum,,0,0,0,,Tetapi tiada apa yang boleh dilakukan, inilah peraturannya
Dialog: 0,1:08:55.12,1:08:59.75,teks umum,,0,0,0,,Apakah hubungan anda dengan Puan Ho?
Dialog: 0,1:08:59.83,1:09:01.71,teks umum,,0,0,0,,Apa yang anda bercakap dengannya?
Dialog: 0,1:09:01.79,1:09:04.29,teks umum,,0,0,0,,Tiada yang istimewa
Dialog: 0,1:09:07.13,1:09:10.51,teks umum,,0,0,0,,Saya perlu membaca semua buku ini. Sudah tiba masanya untuk awak, pembantu Kim
Dialog: 0,1:09:10.59,1:09:13.85,teks umum,,0,0,0,,Adakah anda memerlukan dakwat sebelum kelas?
Dialog: 0,1:09:14.43,1:09:17.72,teks umum,,0,0,0,,Tidak, saya perlu melakukan semuanya sendiri
Dialog: 0,1:09:17.81,1:09:19.02,teks umum,,0,0,0,,Ini adalah peraturan
Dialog: 0,1:09:19.10,1:09:20.77,teks umum,,0,0,0,,Peraturan. saya nampak
Dialog: 0,1:09:21.73,1:09:22.94,teks umum,,0,0,0,,Okay
Dialog: 0,1:09:24.06,1:09:27.19,teks umum,,0,0,0,,Saya akan pergi. Jumpa lagi nanti
Dialog: 0,1:09:28.11,1:09:29.28,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,1:09:31.11,1:09:34.70,teks umum,,0,0,0,,jaga Moo Deok. Dia mungkin risau
Dialog: 0,1:09:34.78,1:09:37.29,teks umum,,0,0,0,,Mengapa dia perlu risau jika anda sihat sepenuhnya?
Dialog: 0,1:09:37.37,1:09:38.37,teks umum,,0,0,0,,Saya rasa dia gembira
Dialog: 0,1:09:40.00,1:09:42.67,teks umum,,0,0,0,,Dia sangat menderita kerana awak
Dialog: 0,1:09:42.75,1:09:46.21,teks umum,,0,0,0,,Anda pemilih tentang makanan, dia terpaksa memasak tiga kali,
Dialog: 0,1:09:46.29,1:09:49.17,teks umum,,0,0,0,,ketika dia bersama kamu di pergunungan. Membawa air untuk mandi
Dialog: 0,1:09:49.26,1:09:52.43,teks umum,,0,0,0,,Basuh pakaian anda. Adakah anda tahu berapa banyak kerja ini?
Dialog: 0,1:09:55.14,1:09:57.10,teks umum,,0,0,0,,Moo Dok benar-benar menderita
Dialog: 0,1:09:57.18,1:10:01.39,teks umum,,0,0,0,,Saya akan bawa dia melihat bunga dan membeli sesuatu yang sedap
Dialog: 0,1:10:01.98,1:10:03.69,teks umum,,0,0,0,,saya akan jaga dia
Dialog: 0,1:10:03.77,1:10:06.31,teks umum,,0,0,0,,Dia akan tenang jika anda tiada
Dialog: 0,1:10:09.98,1:10:11.19,teks umum,,0,0,0,,Adakah anda fikir?
Dialog: 0,1:10:19.62,1:10:21.87,di sebalik tabir,,0,0,0,,Chan Wook sudah mencapai matlamatnya
Dialog: 0,1:10:22.37,1:10:24.87,suara,,0,0,0,,Mungkin dia benar-benar tidak memerlukan saya lagi
Dialog: 0,1:10:25.58,1:10:27.54,di sebalik tabir,,0,0,0,,Dia meninggalkan 12 orang guru
Dialog: 0,1:10:28.34,1:10:31.46,teks umum,,0,0,0,,Kita sepatutnya meracuni dia dan menemui sesuatu untuk memeras ugutnya
Dialog: 0,1:10:32.05,1:10:33.93,teks umum,,0,0,0,,Saya terlalu mempercayainya
Dialog: 0,1:10:34.51,1:10:36.55,miring,,0,0,0,,Moo Dok!
Dialog: 0,1:10:37.39,1:10:38.39,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:10:38.97,1:10:40.35,teks umum,,0,0,0,,Adakah anda mempunyai azimat?
Dialog: 0,1:10:40.43,1:10:43.35,teks umum,,0,0,0,,Saya tidak boleh melakukan ini. Tetapi sekarang anda boleh lulus peperiksaan
Dialog: 0,1:10:44.06,1:10:46.02,teks am,,0,0,0,,Adakah anda mahu saya lulus peperiksaan ahli silap mata?
Dialog: 0,1:10:46.65,1:10:48.69,teks umum,,0,0,0,,Adakah anda gila? Jangan cakap kosong
Dialog: 0,1:10:49.44,1:10:52.40,teks umum,,0,0,0,,Sosnovy Bor menjalankan peperiksaan bukan untuk ahli silap mata
Dialog: 0,1:10:52.49,1:10:55.45,teks umum,,0,0,0,,Mereka juga ada pertandingan di sana kerana persaingan yang sengit
Dialog: 0,1:10:55.53,1:10:56.91,teks umum,,0,0,0,,Pertandingan?
Dialog: 0,1:10:56.99,1:10:58.74,teks umum,,0,0,0,,Mengupah pekerja di Sosnovy Bor
Dialog: 0,1:10:58.83,1:11:01.54,teks umum,,0,0,0,,Jadi mereka hanya mengupah pelayan
Dialog: 0,1:11:01.62,1:11:03.96,teks umum,,0,0,0,,Moo Dok, awak adalah hamba
Dialog: 0,1:11:04.79,1:11:08.13,teks umum,,0,0,0,,Ya, saya tahu. Tapi saya bukan pembantu rumah biasa
Dialog: 0,1:11:08.21,1:11:09.46,teks umum,,0,0,0,,Saya menolak
Dialog: 0,1:11:10.09,1:11:12.34,teks umum,,0,0,0,,Kenapa perlu marah?
Dialog: 0,1:11:12.42,1:11:14.26,teks umum,,0,0,0,,Adakah anda tahu betapa sukarnya untuk sampai ke sana?
Dialog: 0,1:11:17.18,1:11:19.26,teks umum,,0,0,0,,Moo Dok, awak nampak letih
Dialog: 0,1:11:19.35,1:11:20.93,teks umum,,0,0,0,,Makan sebelum anda pergi
Dialog: 0,1:11:26.81,1:11:27.98,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:11:28.06,1:11:30.52,teks umum,,0,0,0,,Adakah anda dari Sosnovy Bor? Pernahkah anda melihat pemiliknya?
Dialog: 0,1:11:30.61,1:11:33.49,teks umum,,0,0,0,,Ya. Saya melihatnya. Dia baik
Dialog: 0,1:11:34.19,1:11:36.65,teks umum,,0,0,0,,Apa yang dia mahu saya lakukan sekarang?
Dialog: 0,1:11:36.74,1:11:37.99,teks umum,,0,0,0,,Bila dia akan datang untuk saya?
Dialog: 0,1:11:38.07,1:11:40.16,teks umum,,0,0,0,,Mahu anda hidup dengan baik di sini
Dialog: 0,1:11:40.24,1:11:42.41,teks umum,,0,0,0,,Mengagumi bunga, makan gula-gula
Dialog: 0,1:11:43.33,1:11:47.79,teks umum,,0,0,0,,Dia berkata untuk mengagumi bunga dan makan gula-gula?
Dialog: 0,1:11:47.87,1:11:48.96,teks umum,,0,0,0,,Ya
Dialog: 0,1:11:53.30,1:11:55.88,teks umum,,0,0,0,,Bukankah dia cakap bila dia akan datang berjumpa saya?
Dialog: 0,1:11:55.97,1:11:58.26,teks umum,,0,0,0,,Mengikut peraturan, dia tidak boleh pergi
Dialog: 0,1:11:59.09,1:12:01.51,teks umum,,0,0,0,,Dia bertekad untuk mengikut peraturan,
Dialog: 0,1:12:01.60,1:12:04.18,teks umum,,0,0,0,,Saya tidak risau tentang dia lagi
Dialog: 0,1:12:06.94,1:12:09.98,di sebalik tabir,,0,0,0,,Saya rasa Uku tidak memerlukan saya lagi
Dialog: 0,1:12:12.19,1:12:13.27,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:12:14.53,1:12:18.95,teks umum,,0,0,0,,dan anda tidak tahu siapa yang disukai oleh tuan kita?
Dialog: 0,1:12:20.74,1:12:22.74,teks umum,,0,0,0,,Mungkin ini gadis yang saya lihat di Sosnovy Bor
Dialog: 0,1:12:22.83,1:12:25.91,teks umum,,0,0,0,,Gadis? Adakah dia berkencan dengan seseorang?
Dialog: 0,1:12:26.00,1:12:27.96,teks umum,,0,0,0,,Nah, dia memberitahu saya,
Dialog: 0,1:12:28.54,1:12:30.75,teks umum,,0,0,0,,bahawa hatinya adalah milik seorang gadis,
Dialog: 0,1:12:30.83,1:12:34.09,teks umum,,0,0,0,,iaitu seperti telur burung di atas pokok
Dialog: 0,1:12:43.18,1:12:46.77,miring,,0,0,0,,Dan juga bahawa dia tidak mempunyai sesiapa selain dia
Dialog: 0,1:12:48.27,1:12:51.15,contact,,0,0,0,,Saya boleh bayangkan betapa dia risau dan ambil berat tentang dia
Dialog: 0,1:12:51.23,1:12:54.07,teks umum,,0,0,0,,Apabila seorang lelaki menjaga seorang wanita, pada pendapat anda apakah maksudnya?
Dialog: 0,1:12:56.32,1:12:57.69,teks umum,,0,0,0,,Maknanya dia sedang jatuh cinta
Dialog: 0,1:13:01.24,1:13:03.37,teks umum,,0,0,0,,Tetapi ini saya
Dialog: 0,1:13:09.16,1:13:10.42,kenangan miring,,0,0,0,,Terdapat telur burung
Dialog: 0,1:13:10.50,1:13:14.63,kenangan,,0,0,0,,Cikgu, marilah kita terus berbakti antara satu sama lain
Dialog: 0,1:13:21.05,1:13:22.76,kenangan miring,,0,0,0,,Saya hampir mati terima kasih kepada awak,
Dialog: 0,1:13:22.84,1:13:24.18,kenangan,,0,0,0,,tuanku yang gila
Dialog: 0,1:13:28.10,1:13:31.85,kenangan miring,,0,0,0,,Hubungan guru-murid kami akan kekal sehingga anda menjadi yang terbaik,
Dialog: 0,1:13:31.94,1:13:34.48,kenangan miring,,0,0,0,,untuk membantu saya memulihkan tenaga
Dialog: 0,1:13:35.61,1:13:38.53,kenangan miring,,0,0,0,,Apabila saya kembali bertenaga dan menjadi Nak Su semula,
Dialog: 0,1:13:39.03,1:13:40.99,kenangan,,0,0,0,,kita tidak lagi menjadi guru dan pelajar
Dialog: 0,1:13:42.45,1:13:44.45,kenangan condong,,0,0,0,,Boleh saya tahu kenapa?
Dialog: 0,1:13:45.66,1:13:48.70,kenangan miring,,0,0,0,,Kerana anda tidak lagi mempunyai alasan untuk melindungi saya
Dialog: 0,1:13:50.12,1:13:51.71,kenangan miring,,0,0,0,,Dan saya tidak akan mempunyai sebab
Dialog: 0,1:13:55.08,1:13:56.34,kenangan condong,,0,0,0,,untuk berlembut terhadap anda
Dialog: 0,1:13:57.38,1:13:59.34,kenangan,,0,0,0,,Cikgu! Ini saya, Chan Wook
Dialog: 0,1:14:17.15,1:14:18.82,teks umum,,0,0,0,,Jadi apa yang perlu dilakukan?
Dialog: 0,1:14:20.03,1:14:21.53,teks umum,,0,0,0,,Semuanya buruk
Dialog: 0,1:14:27.16,1:14:28.16,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:14:30.08,1:14:31.37,teks umum,,0,0,0,,Saya rindu awak
Dialog: 0,1:15:06.44,1:15:08.24,pratonton,,0,0,0,,Saya tidak akan mengajar Uka
Dialog: 0,1:15:08.32,1:15:12.04,pratonton,,0,0,0,,Jadi anda tidak mengambil dia di bawah sayap anda, anda hanya menguncinya di sini
Dialog: 0,1:15:12.12,1:15:13.62,pratonton,,0,0,0,,Bantuan!
Dialog: 0,1:15:15.08,1:15:16.71,pratonton,,0,0,0,,Ia pasti Moo Deok!
Dialog: 0,1:15:16.79,1:15:19.25,pratonton,,0,0,0,,Mengapa dia sentiasa perlu berada di tempat lain?
Dialog: 0,1:15:19.34,1:15:20.42,pratonton,,0,0,0,,Cikgu!
Dialog: 0,1:15:21.34,1:15:25.38,pratonton,,0,0,0,,Kenapa surat? Asalkan ia meluahkan perasaan...
Dialog: 0,1:15:25.47,1:15:30.14,pratonton,,0,0,0,,Lelaki itu sudah jatuh cinta dengan seseorang
Dialog: 0,1:15:30.22,1:15:32.02,pratonton,,0,0,0,,Ini lebih sukar daripada yang saya sangka
Dialog: 0,1:15:32.10,1:15:34.02,pratonton,,0,0,0,,Yang Mulia!
Dialog: 0,1:15:34.10,1:15:36.02,pratonton,,0,0,0,,Dia sentiasa di sebelah Uk
Dialog: 0,1:15:36.10,1:15:39.31,pratonton,,0,0,0,,Anda perlu cuba membaca perkara yang anda tidak dapat lihat
Dialog: 0,1:15:39.40,1:15:40.82,pratonton,,0,0,0,,Moo Dok
Dialog: 0,0:02:55.14,0:02:57.14,nicks,,0,0,0,,

