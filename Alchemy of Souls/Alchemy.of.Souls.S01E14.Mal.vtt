Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:01:15.77,0:01:19.11,teks umum,,0,0,0,,Saya dengar awak pergi memancing dengan Uk
Dialog: 0,0:01:20.15,0:01:23.40,teks umum,,0,0,0,,Ya. Memang bosan memancing seorang diri
Dialog: 0,0:01:24.15,0:01:25.95,teks umum,,0,0,0,,Anda pernah berkata,
Dialog: 0,0:01:26.03,0:01:29.45,teks umum,,0,0,0,,bahawa Chan Wook mempunyai nasib yang sama dengan Master Seo Kyung
Dialog: 0,0:01:29.54,0:01:33.00,teks umum,,0,0,0,,Jadi awak sokong dia dan bantu dia?
Dialog: 0,0:01:33.50,0:01:36.42,teks umum,,0,0,0,,Bukan saya seorang sahaja yang membantunya
Dialog: 0,0:01:38.71,0:01:40.96,teks umum,,0,0,0,,Adakah orang lain yang mengarahkannya?
Dialog: 0,0:01:41.92,0:01:43.42,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:01:44.17,0:01:45.84,teks umum,,0,0,0,,Adakah anda mengenali orang ini?
Dialog: 0,0:01:52.52,0:01:56.15,teks umum,,0,0,0,,Tiada siapa yang mengajar Uka membaca jampi
Dialog: 0,0:01:56.65,0:01:57.65,teks umum,,0,0,0,,Saya pasti
Dialog: 0,0:01:58.23,0:02:00.94,teks umum,,0,0,0,,Ini disahkan oleh pembantu rumahnya
Dialog: 0,0:02:01.69,0:02:05.82,teks umum,,0,0,0,,Jadi, dia sendiri mencapai tahap yang tinggi?
Dialog: 0,0:02:05.90,0:02:07.87,teks umum,,0,0,0,,Mungkin dia menjadi ahli silap mata Jeonjingak
Dialog: 0,0:02:07.95,0:02:10.33,teks umum,,0,0,0,,terima kasih kepada helah dan nasib
Dialog: 0,0:02:10.41,0:02:11.91,teks umum,,0,0,0,,Tetapi dia tidak mempunyai kemahiran
Dialog: 0,0:02:11.99,0:02:14.79,teks umum,,0,0,0,,Saya pasti anda pernah mendengar tentang hujah kami
Dialog: 0,0:02:16.17,0:02:17.50,teks umum,,0,0,0,,Tinggal satu pertarungan
Dialog: 0,0:02:19.21,0:02:20.25,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:02:20.34,0:02:23.88,teks umum,,0,0,0,,Guru itu akan menghalang kehinaannya
Dialog: 0,0:02:24.55,0:02:27.09,teks umum,,0,0,0,,Selepas membaca "Kata Hati", dia menerima penghormatan
Dialog: 0,0:02:27.18,0:02:29.18,teks umum,,0,0,0,,Dan hujah kami memalukan dia
Dialog: 0,0:02:29.26,0:02:32.77,teks umum,,0,0,0,,Dia berdegil terus melawan
Dialog: 0,0:02:32.85,0:02:34.43,teks umum,,0,0,0,,Jadi ini
Dialog: 0,0:02:35.56,0:02:38.31,teks umum,,0,0,0,,sangat bermakna baginya
Dialog: 0,0:02:41.69,0:02:43.44,kenangan,,0,0,0,,Awak okay? boleh nampak?
Dialog: 0,0:02:43.53,0:02:45.40,kenangan,,0,0,0,,Ya. Dan awak, tuan?
Dialog: 0,0:02:45.49,0:02:47.57,kenangan,,0,0,0,,Anda tidak cedera?
Dialog: 0,0:02:49.20,0:02:50.28,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:02:51.95,0:02:55.20,teks umum,,0,0,0,,Saya tidak pernah terfikir betapa pentingnya jed untuknya
Dialog: 0,0:02:59.50,0:03:01.04,teks umum,,0,0,0,,Sebaik sahaja Uk kembali,
Dialog: 0,0:03:01.71,0:03:03.96,teks umum,,0,0,0,,Bom nak lawan
Dialog: 0,0:03:04.05,0:03:05.42,teks umum,,0,0,0,,Adakah dia memancing?
Dialog: 0,0:03:06.30,0:03:08.51,teks umum,,0,0,0,,Dan Moo Dok menutup mata terhadap perkara ini?
Dialog: 0,0:03:09.64,0:03:11.14,teks umum,,0,0,0,,Tidak mungkin dia gembira dengan perkara ini
Dialog: 0,0:03:11.22,0:03:14.72,teks umum,,0,0,0,,Jadi anda juga perasan bahawa Uk mendengarnya
Dialog: 0,0:03:14.81,0:03:18.77,teks umum,,0,0,0,,Dia degil, tidak kira apa yang orang beritahu dia
Dialog: 0,0:03:18.85,0:03:20.81,teks umum,,0,0,0,,Tetapi dia sentiasa mendengar Moo Deok
Dialog: 0,0:03:23.86,0:03:26.61,kenangan,,0,0,0,,Kita boleh melindungi raksasa dari dunia ini
Dialog: 0,0:03:28.45,0:03:30.41,luar skrin,,0,0,0,,Dia bercakap tentang Nak Soo ketika itu
Dialog: 0,0:03:32.95,0:03:37.37,suara,,0,0,0,,Jika dia sedang mencari batu untuk melindunginya...
Dialog: 0,0:03:39.92,0:03:42.38,teks umum,,0,0,0,,- Mereka tidak boleh bersama\N- Apa?
Dialog: 0,0:03:43.67,0:03:44.71,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:03:44.80,0:03:47.46,teks umum,,0,0,0,, Adakah anda tidak suka bahawa mereka rapat?
Dialog: 0,0:03:49.84,0:03:50.84,teks umum,,0,0,0,,Bukan itu maksudnya
Dialog: 0,0:03:51.34,0:03:54.72,teks umum,,0,0,0,,Jika mereka memilih jalan yang salah,
Dialog: 0,0:03:56.93,0:03:59.39,teks umum,,0,0,0,,Saya tidak dapat membantu
Dialog: 0,0:04:08.36,0:04:14.45,contact,,0,0,0,,Uk boleh membawa huru-hara kepada dunia ini
Dialog: 0,0:04:15.58,0:04:19.46,teks umum,,0,0,0,,Tiba-tiba sokongan kami akan menjadikannya tidak terkawal,
Dialog: 0,0:04:19.54,0:04:22.00,teks umum,,0,0,0,,selepas itu ia akan menarik perhatian?
Dialog: 0,0:04:22.08,0:04:25.42,teks umum,,0,0,0,,Takut dia akan menceroboh takhta dan membawa
Dialog: 0,0:04:25.50,0:04:28.59,teks umum,,0,0,0,,kemusnahan di Deho?
Dialog: 0,0:04:30.09,0:04:33.34,teks umum,,0,0,0,,Ini mungkin jika dia mengikut bintang Raja
Dialog: 0,0:04:33.93,0:04:35.89,teks umum,,0,0,0,,Ini akan meluaskan pandangannya
Dialog: 0,0:04:35.97,0:04:40.52,teks umum,,0,0,0,,dan keinginan untuk mencapai kehebatan
Dialog: 0,0:04:42.27,0:04:43.31,teks umum,,0,0,0,,Jin
Dialog: 0,0:04:44.31,0:04:46.90,teks umum,,0,0,0,,Berapa lama masa yang anda ambil untuk menguasai Chisa?
Dialog: 0,0:04:47.73,0:04:48.69,teks umum,,0,0,0,,Chisu?
Dialog: 0,0:04:49.19,0:04:52.32,teks umum,,0,0,0,,Saya cepat menguasai Ryusu,
Dialog: 0,0:04:52.40,0:04:56.58,teks umum,,0,0,0,,tetapi lebih sukar untuk menguasai Chisu
Dialog: 0,0:05:01.91,0:05:04.71,contact,,0,0,0,,Selama tiga tahun saya belajar untuk memahami tenaga syurga
Dialog: 0,0:05:05.83,0:05:08.46,contact,,0,0,0,,Ia mengambil masa tiga tahun untuk memanfaatkan tenaga bumi
Dialog: 0,0:05:09.63,0:05:14.30,miring,,0,0,0,, dan empat tahun untuk merasai tenaga di sekeliling
Dialog: 0,0:05:16.43,0:05:20.43,miring,,0,0,0,,Tenaga langit, bumi dan air yang mengalir di antara mereka
Dialog: 0,0:05:21.31,0:05:24.31,italic,,0,0,0,,Saya menguasai semua ini selama sepuluh tahun
Dialog: 0,0:05:26.48,0:05:28.36,miring,,0,0,0,,dan memahami Chisa
Dialog: 0,0:05:28.44,0:05:29.53,teks umum,,0,0,0,,Mengejutkan
Dialog: 0,0:05:30.61,0:05:32.32,teks umum,,0,0,0,,Saya mengambil masa 13 tahun
Dialog: 0,0:05:32.40,0:05:34.70,teks umum,,0,0,0,,Yom belajar segala-galanya dua kali lebih lama
Dialog: 0,0:05:35.32,0:05:39.24,teks umum,,0,0,0,,Saya berada di tempat kedua selepas Chang Gang
Dialog: 0,0:05:39.74,0:05:40.91,teks umum,,0,0,0,,Hanya ini...
Dialog: 0,0:05:48.59,0:05:52.21,teks umum,,0,0,0,,Kita melihat tenaga yang mengalir antara langit dan bumi,
Dialog: 0,0:05:52.30,0:05:55.72,teks umum,,0,0,0,,tetapi pada asasnya ia hanya air
Dialog: 0,0:05:58.10,0:06:02.56,teks umum,,0,0,0,,Kami telah cuba menguasai ini selama bertahun-tahun
Dialog: 0,0:06:04.39,0:06:06.94,teks umum,,0,0,0,,Tetapi ada orang yang boleh melakukan ini sejak lahir
Dialog: 0,0:06:24.16,0:06:26.62,contact,,0,0,0,,Ringkasnya, genius
Dialog: 0,0:06:27.50,0:06:29.71,miring,,0,0,0,,Tetapi seluruh dunia
Dialog: 0,0:06:29.79,0:06:33.51,miring,,0,0,0,,menganggapnya melulu, tidak boleh dipercayai
Dialog: 0,0:06:33.59,0:06:36.22,miring,,0,0,0,,dan kadangkala berbahaya
Dialog: 0,0:06:39.51,0:06:40.60,teks umum,,0,0,0,,Apa saya...
Dialog: 0,0:06:41.72,0:06:43.31,teks umum,,0,0,0,,menguasai Chisu?
Dialog: 0,0:06:46.44,0:06:49.10,miring,,0,0,0,,Kerana ia berbeza daripada yang lain
Dialog: 0,0:06:56.82,0:06:59.07,contact,,0,0,0,,Ada yang iri hati dengan mereka
Dialog: 0,0:07:06.91,0:07:09.33,contact,,0,0,0,,Orang lain takut dengan mereka
Dialog: 0,0:07:12.00,0:07:13.42,teks umum,,0,0,0,,Saya pasti menang esok
Dialog: 0,0:07:16.17,0:07:17.47,teks umum,,0,0,0,,Saya menangkapnya
Dialog: 0,0:07:19.84,0:07:21.01,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:07:21.68,0:07:22.76,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:07:23.85,0:07:25.06,teks umum,,0,0,0,,Anda telah menguasai Chisa
Dialog: 0,0:07:30.31,0:07:34.90,contact,,0,0,0,,Kami bertindak balas seperti ini kerana kami tidak tahu bagaimana mereka menggunakan kuasa luar biasa mereka
Dialog: 0,0:07:35.53,0:07:39.53,teks umum,,0,0,0,,Adakah dia akan menyelamatkan dunia sebagai Master So Kyung
Dialog: 0,0:07:39.61,0:07:42.99,teks umum,,0,0,0,,atau adakah ia akan memusnahkan? Kami tidak tahu
Dialog: 0,0:07:44.20,0:07:45.62,teks umum,,0,0,0,,Dalam erti kata lain,
Dialog: 0,0:07:46.95,0:07:50.00,teks umum,,0,0,0,,teruskan menonton dia?
Dialog: 0,0:07:51.83,0:07:55.13,teks umum,,0,0,0,,Jangan risau. Saya faham semuanya
Dialog: 0,0:07:57.38,0:07:59.34,teks umum,,0,0,0,,Jika anda perlu menyingkirkan kuasa ini,
Dialog: 0,0:08:00.55,0:08:03.10,teks umum,,0,0,0,,Saya akan melakukannya dengan tangan saya sendiri
Dialog: 0,0:08:10.06,0:08:11.98,teks umum,,0,0,0,,Chan Wook, adakah hukuman awak sudah tamat?
Dialog: 0,0:08:12.06,0:08:13.31,teks umum,,0,0,0,,Jadi saya kembali
Dialog: 0,0:08:13.40,0:08:14.82,teks umum,,0,0,0,,Jadi awak musnahkan Jeonbugwan?
Dialog: 0,0:08:14.90,0:08:16.15,teks umum,,0,0,0,,Jangan keterlaluan
Dialog: 0,0:08:17.28,0:08:20.03,teks umum,,0,0,0,,- Hei\N- Anda akhirnya kembali
Dialog: 0,0:08:20.74,0:08:23.66,teks umum,,0,0,0,,Saya lawan terakhir kamu
Dialog: 0,0:08:24.32,0:08:26.66,teks umum,,0,0,0,,- Saya nampak\N- Sayang sekali anda tidak akan menang,
Dialog: 0,0:08:27.70,0:08:31.92,teks umum,,0,0,0,,kerana saya akan berlawan dengan awak
Dialog: 0,0:08:37.38,0:08:38.80,teks umum,,0,0,0,,Jangan risau sangat
Dialog: 0,0:08:39.46,0:08:41.88,teks umum,,0,0,0,,Saya harap pertempuran terakhir akan menarik
Dialog: 0,0:08:42.72,0:08:43.80,teks umum,,0,0,0,,Mengharapkan anda
Dialog: 0,0:08:53.77,0:08:55.23,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:08:55.31,0:08:57.07,teks umum,,0,0,0,,Adakah dia belajar sesuatu yang baharu?
Dialog: 0,0:08:57.15,0:08:59.07,teks umum,,0,0,0,,Saya dengar dia hanya memancing
Dialog: 0,0:08:59.15,0:09:01.57,teks umum,,0,0,0,,Jangan risau, dia hanya berani
Dialog: 0,0:09:02.61,0:09:06.78,teks umum,,0,0,0,,Saya akan memalukan dia di hadapan Putera Mahkota
Dialog: 0,0:09:08.83,0:09:09.95,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:09:10.75,0:09:13.54,teks umum,,0,0,0,,Tuan bodoh saya kalah sembilan kali,
Dialog: 0,0:09:13.62,0:09:17.42,teks umum,,0,0,0,,disebabkan itu anda kehilangan sembilan kodok emas
Dialog: 0,0:09:18.05,0:09:20.38,teks umum,,0,0,0,,Saya tidak berani memandang mata anda
Dialog: 0,0:09:22.76,0:09:24.22,teks umum,,0,0,0,,Perlawanan terakhir tinggalkan?
Dialog: 0,0:09:24.30,0:09:26.09,teks umum,,0,0,0,,Dia berlatih bersungguh-sungguh,
Dialog: 0,0:09:26.18,0:09:28.51,teks umum,,0,0,0,,supaya tidak mengecewakan anda kali ini
Dialog: 0,0:09:28.60,0:09:30.22,teks umum,,0,0,0,,Supaya saya tidak kecewa,
Dialog: 0,0:09:30.81,0:09:31.89,teks umum,,0,0,0,,dia mesti kalah
Dialog: 0,0:09:36.48,0:09:39.07,teks umum,,0,0,0,,Anda menganggap saya bodoh
Dialog: 0,0:09:39.15,0:09:42.19,teks umum,,0,0,0,,Menggunakan emas saya untuk melatih tuannya
Dialog: 0,0:09:43.74,0:09:45.32,teks umum,,0,0,0,,Terima kasih kepada pertarungan
Dialog: 0,0:09:45.41,0:09:49.24,teks umum,,0,0,0,,anda seronok melihat penghinaan pemilik
Dialog: 0,0:09:49.33,0:09:51.91,teks umum,,0,0,0,,Saya pasti ia berbaloi dengan emas
Dialog: 0,0:09:52.75,0:09:54.41,teks umum,,0,0,0,,Ya, ia menyeronokkan
Dialog: 0,0:09:54.50,0:09:56.67,teks umum,,0,0,0,,Saya harap dia kalah lagi,
Dialog: 0,0:09:57.46,0:10:00.00,teks umum,,0,0,0,,supaya anda menangis apabila kehilangan jed anda
Dialog: 0,0:10:00.67,0:10:02.88,teks umum,,0,0,0,,Chan Wook ada separuh lagi, kan?
Dialog: 0,0:10:03.67,0:10:06.13,teks umum,,0,0,0,,Dia memberi anda yang kedua,
Dialog: 0,0:10:06.22,0:10:08.39,teks umum,,0,0,0,,jadi ini simbol cinta?
Dialog: 0,0:10:10.76,0:10:12.56,teks umum,,0,0,0,,Berikan kepada saya untuk menggunakan saya?
Dialog: 0,0:10:16.65,0:10:19.31,teks umum,,0,0,0,,Jika Uk kalah,
Dialog: 0,0:10:19.90,0:10:20.98,teks umum,,0,0,0,,Saya akan memusnahkan jed
Dialog: 0,0:10:22.44,0:10:23.90,miring,,0,0,0,,Anda mesti kehilangan sesuatu
Dialog: 0,0:10:24.40,0:10:25.86,teks umum,,0,0,0,,Sungguh memalukan
Dialog: 0,0:10:25.95,0:10:28.24,teks umum,,0,0,0,,Cinta hormatmu akan tenggelam dalam kelalaian
Dialog: 0,0:10:33.54,0:10:34.96,teks umum,,0,0,0,,Lakukan sesuka hati
Dialog: 0,0:10:35.91,0:10:37.33,teks umum,,0,0,0,,Jade menyelesaikan tugasnya
Dialog: 0,0:10:37.42,0:10:39.58,teks umum,,0,0,0,,Memaksa pemilik untuk melalui 10 pergaduhan
Dialog: 0,0:10:39.67,0:10:42.71,teks umum,,0,0,0,,Anda berkata bahawa anda akan mempertaruhkan nyawa anda untuk jed
Dialog: 0,0:10:43.96,0:10:46.47,teks umum,,0,0,0,,Jika kita boleh mempertaruhkan nyawa kita untuk perasaan kita,
Dialog: 0,0:10:47.88,0:10:51.22,teks umum,,0,0,0,,kehilangan batu ini tidak akan menjejaskan mereka
Dialog: 0,0:10:58.40,0:11:00.98,teks umum,,0,0,0,,Jadi anda tidak kisah sama ada anda kehilangan dia atau tidak?
Dialog: 0,0:11:02.19,0:11:03.28,teks umum,,0,0,0,,Okay
Dialog: 0,0:11:04.28,0:11:05.69,teks umum,,0,0,0,,Kemudian saya akan membuangnya
Dialog: 0,0:11:16.16,0:11:17.75,teks umum,,0,0,0,,Jadi ia tidak bermakna apa-apa
Dialog: 0,0:11:18.79,0:11:20.88,teks umum,,0,0,0,,Awak tipu saya
Dialog: 0,0:11:20.96,0:11:23.25,teks umum,,0,0,0,,Dia berkata bahawa ini adalah perkara yang paling berharga
Dialog: 0,0:11:23.34,0:11:26.17,teks umum,,0,0,0,,Dan jika anda tidak bimbang tentang dia, maka anda berbohong
Dialog: 0,0:11:27.38,0:11:29.59,teks umum,,0,0,0,,Bagaimanakah anda akan membayar untuk pembohongan?
Dialog: 0,0:11:29.68,0:11:31.43,teks umum,,0,0,0,,Anda mempertaruhkan nyawa anda, bukan?
Dialog: 0,0:11:32.10,0:11:33.22,teks umum,,0,0,0,,Cemerlang
Dialog: 0,0:11:34.06,0:11:36.73,teks umum,,0,0,0,,Anda dipertaruhkan kali ini
Dialog: 0,0:11:38.60,0:11:40.69,teks umum,,0,0,0,,Saya sudah kehilangan sembilan ekor kodok
Dialog: 0,0:11:41.31,0:11:42.77,teks umum,,0,0,0,,Saya tidak mahu kehilangan yang lain
Dialog: 0,0:11:42.86,0:11:44.61,teks umum,,0,0,0,,Anda akan mendapat ganjaran
Dialog: 0,0:11:45.90,0:11:47.19,teks umum,,0,0,0,,dalam pertarungan ini
Dialog: 0,0:11:49.57,0:11:51.20,teks umum,,0,0,0,,Seperti yang anda pesan
Dialog: 0,0:11:51.28,0:11:52.45,teks umum,,0,0,0,,Jika Chang Wook kalah,
Dialog: 0,0:11:53.41,0:11:56.37,teks umum,,0,0,0,,anda akan menjadi pembantu rumah pemenang
Dialog: 0,0:11:57.62,0:12:00.92,teks umum,,0,0,0,,Ya, saya akan fikirkannya
Dialog: 0,0:12:16.77,0:12:19.60,teks umum,,0,0,0,,Jadi anda adalah lawan terakhir Chan Wook?
Dialog: 0,0:12:20.98,0:12:22.60,teks umum,,0,0,0,,Saya Cha Bum
Dialog: 0,0:12:22.69,0:12:24.40,teks umum,,0,0,0,,Saya akan menang walau apa cara sekalipun
Dialog: 0,0:12:25.44,0:12:27.19,teks umum,,0,0,0,,Anda mesti
Dialog: 0,0:12:27.28,0:12:28.82,teks umum,,0,0,0,,Jika anda kalah,
Dialog: 0,0:12:28.90,0:12:31.57,teks umum,,0,0,0,,Saya akan pastikan anda tidak akan berjaya sebagai ahli silap mata
Dialog: 0,0:12:33.41,0:12:35.33,teks umum,,0,0,0,,Bolehkah anda memberi jawapan?
Dialog: 0,0:12:36.58,0:12:39.62,teks umum,,0,0,0,,Selalu ada kebarangkalian...
Dialog: 0,0:12:39.70,0:12:40.83,teks umum,,0,0,0,,Cukup!
Dialog: 0,0:12:41.96,0:12:44.25,teks umum,,0,0,0,,Saya perlukan seseorang yang pasti akan menang
Dialog: 0,0:12:44.33,0:12:45.71,teks umum,,0,0,0,,Beri saya kata-kata anda
Dialog: 0,0:12:45.79,0:12:48.34,teks umum,,0,0,0,,Saya takut saya tidak boleh, Yang Amat Mulia
Dialog: 0,0:12:48.42,0:12:50.09,teks umum,,0,0,0,,Tiada sesiapa kecuali dia...
Dialog: 0,0:12:51.93,0:12:53.47,teks umum,,0,0,0,,tidak akan memberikan perkataan ini
Dialog: 0,0:12:55.10,0:12:58.52,teks umum,,0,0,0,,Hanya seorang sahaja yang tinggal,
Dialog: 0,0:12:59.60,0:13:01.18,teks umum,,0,0,0,,siapa boleh menang
Dialog: 0,0:13:01.27,0:13:02.27,teks umum,,0,0,0,,So Yul
Dialog: 0,0:13:08.23,0:13:09.48,teks umum,,0,0,0,,Jadi Yul?
Dialog: 0,0:13:22.12,0:13:24.25,teks umum,,0,0,0,,Pertikaian itu tidak serius
Dialog: 0,0:13:25.08,0:13:27.09,teks umum,,0,0,0,,Tetapi dia mengganggu saya
Dialog: 0,0:13:27.17,0:13:31.67,teks umum,,0,0,0,,Saya kehilangan sembilan ekor kodok untuk meletakkan Uka di tempatnya
Dialog: 0,0:13:32.26,0:13:35.64,teks umum,,0,0,0,,Bayangkan betapa lucunya saya akan kelihatan,
Dialog: 0,0:13:35.72,0:13:39.60,teks umum,,0,0,0,,jika dia memenangi pertarungan terakhir
Dialog: 0,0:13:41.14,0:13:43.73,teks umum,,0,0,0,,Jadi saya perlukan seseorang yang pasti akan menang
Dialog: 0,0:13:43.81,0:13:46.48,teks umum,,0,0,0,,Anda adalah ahli silap mata terbaik Jeongjingak dan sepupu saya
Dialog: 0,0:13:46.56,0:13:48.02,teks umum,,0,0,0,,Saya pasti anda seorang sahaja
Dialog: 0,0:13:49.69,0:13:52.99,teks umum,,0,0,0,,Saya tahu awak berkawan dengan dia
Dialog: 0,0:13:54.74,0:13:58.16,teks umum,,0,0,0,,Tetapi sebagai seorang putera raja dan sepupu anda,
Dialog: 0,0:13:58.91,0:14:00.49,teks umum,,0,0,0,,Saya minta bantuan anda
Dialog: 0,0:14:04.33,0:14:05.62,teks umum,,0,0,0,,Baiklah Yang Amat Mulia
Dialog: 0,0:14:07.92,0:14:08.75,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:14:09.92,0:14:11.88,teks umum,,0,0,0,,Adakah anda akan melawan dia?
Dialog: 0,0:14:12.46,0:14:13.67,teks umum,,0,0,0,,Saya akan menang
Dialog: 0,0:14:14.38,0:14:15.84,teks umum,,0,0,0,,Saya beri kata-kata
Dialog: 0,0:14:17.01,0:14:20.47,teks umum,,0,0,0,,Tepat sekali. Daripada semua orang, hanya anda yang boleh
Dialog: 0,0:14:20.56,0:14:22.93,teks umum,,0,0,0,,Mu Dok betul-betul berjanji untuk berkhidmat
Dialog: 0,0:14:23.02,0:14:24.85,teks umum,,0,0,0,,pemenang?
Dialog: 0,0:14:24.93,0:14:27.56,teks umum,,0,0,0,,Ya, bukannya kodok yang dia letak
Dialog: 0,0:14:32.61,0:14:34.65,teks umum,,0,0,0,,pada diri sendiri
Dialog: 0,0:14:34.74,0:14:36.70,teks umum,,0,0,0,,Maka saya akan mengalahkan Uka
Dialog: 0,0:14:38.07,0:14:39.82,teks umum,,0,0,0,,dan saya akan jadikan dia pembantu rumah saya
Dialog: 0,0:14:44.37,0:14:45.50,teks umum,,0,0,0,,Okey
Dialog: 0,0:14:46.12,0:14:48.54,teks umum,,0,0,0,,Pelawan terakhir Chang Wook, tampil ke hadapan
Dialog: 0,0:15:16.82,0:15:17.82,teks umum,,0,0,0,,Chang Wook,
Dialog: 0,0:15:18.91,0:15:20.78,teks umum,,0,0,0,,berlawan dengan awak hari ini
Dialog: 0,0:15:21.49,0:15:22.74,teks umum,,0,0,0,,Saya akan
Dialog: 0,0:15:42.01,0:15:45.01,teks umum,,0,0,0,,Adakah So Yul bergaduh dengannya untuk membiarkan dia menang?
Dialog: 0,0:15:45.10,0:15:46.10,miring,,0,0,0,,Tidak
Dialog: 0,0:15:46.18,0:15:49.27,italic,,0,0,0,,Apabila Dan Gu menawarkan diri, Chang Wook mengalah serta-merta
Dialog: 0,0:15:49.35,0:15:50.77,contact,,0,0,0,,Dia tidak akan biarkan Uku menang
Dialog: 0,0:15:50.85,0:15:54.40,teks umum,,0,0,0,,Dia memberi kata-kata kepada putera raja bahawa dia akan mengalahkan Chan Wook
Dialog: 0,0:15:58.65,0:15:59.90,teks umum,,0,0,0,,Mulakan
Dialog: 0,0:16:14.92,0:16:16.21,di sebalik tabir,,0,0,0,,Yul betul
Dialog: 0,0:16:16.92,0:16:19.09,teks umum,,0,0,0,,UK telah meningkat dengan pesat
Dialog: 0,0:16:34.11,0:16:35.52,teks umum,,0,0,0,,Ini adalah mantra pelindung saya
Dialog: 0,0:16:35.61,0:16:36.73,teks umum,,0,0,0,,Bila dia menguasainya?
Dialog: 0,0:16:38.57,0:16:41.32,contact,,0,0,0,,Dia belajar semua yang dia lihat dalam pergaduhan sebelumnya
Dialog: 0,0:16:41.40,0:16:45.33,teks umum,,0,0,0,,Adakah dia menguasai mantera lawan terdahulu?
Dialog: 0,0:16:45.41,0:16:49.16,teks umum,,0,0,0,,Dia mempelajari mantera yang dilihatnya dan mengulanginya
Dialog: 0,0:17:49.22,0:17:50.35,teks umum,,0,0,0,,Dia melakukannya
Dialog: 0,0:18:26.34,0:18:27.84,teks umum,,0,0,0,,Perjuangan sudah berakhir
Dialog: 0,0:18:27.93,0:18:30.43,teks umum,,0,0,0,,Jadi Yul menang
Dialog: 0,0:18:34.56,0:18:35.69,teks umum,,0,0,0,,saya tahu
Dialog: 0,0:18:37.10,0:18:39.90,teks umum,,0,0,0,,Uk kalah kesemua sepuluh pertarungan
Dialog: 0,0:18:40.69,0:18:43.65,teks umum,,0,0,0,,Bagaimana dia menggunakan Tansa pada penghujungnya?
Dialog: 0,0:18:43.74,0:18:46.78,contact,,0,0,0,,Dia mengumpul tenaga di udara dan mengubahnya menjadi air
Dialog: 0,0:18:46.86,0:18:47.78,teks umum,,0,0,0,,Jangan kelakar
Dialog: 0,0:18:48.70,0:18:51.41,teks umum,,0,0,0,,Hanya mereka yang memiliki Chisu boleh melakukan ini
Dialog: 0,0:19:03.84,0:19:05.21,teks umum,,0,0,0,,Bila anda menguasai Chisa?
Dialog: 0,0:19:05.80,0:19:09.51,teks umum,,0,0,0,,Saya berkata semalam bahawa saya akan memberitahu anda sesuatu yang menakjubkan
Dialog: 0,0:19:09.59,0:19:11.05,teks umum,,0,0,0,,Itu bagus
Dialog: 0,0:19:11.85,0:19:13.22,teks umum,,0,0,0,,Tahniah
Dialog: 0,0:19:13.31,0:19:14.18,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:19:15.18,0:19:17.64,teks umum,,0,0,0,,Anda telah menguasai Chisu. Tahniah, kawan!
Dialog: 0,0:19:18.65,0:19:19.60,italic,,0,0,0,,Awak nampak?
Dialog: 0,0:19:20.23,0:19:22.94,teks umum,,0,0,0,,Chan Wook kami telah menguasai Chisa!
Dialog: 0,0:19:24.28,0:19:26.03,teks umum,,0,0,0,,- Betul ke?\N- Hei
Dialog: 0,0:19:26.11,0:19:28.07,teks umum,,0,0,0,,- Tahniah\N- Tahniah
Dialog: 0,0:19:28.15,0:19:30.62,italic,,0,0,0,,- Hebat\N- Tahniah
Dialog: 0,0:19:30.70,0:19:31.78,teks umum,,0,0,0,,Hei
Dialog: 0,0:19:32.95,0:19:34.45,teks umum,,0,0,0,,Masa ke Saejukwon
Dialog: 0,0:19:43.75,0:19:46.21,teks umum,,0,0,0,,Moo Dok pergi bersama putera raja
Dialog: 0,0:19:46.80,0:19:49.47,teks umum,,0,0,0,,Mungkin membincangkan penamatan pertikaian
Dialog: 0,0:19:49.55,0:19:52.22,teks umum,,0,0,0,,Saya cuma bimbang mereka akan melakukan perkara seperti itu lagi
Dialog: 0,0:19:52.30,0:19:53.97,teks umum,,0,0,0,,Saya akan semak
Dialog: 0,0:19:54.06,0:19:57.56,teks umum,,0,0,0,,Ya. Jaga dia. Anda adalah pemiliknya sekarang
Dialog: 0,0:20:01.69,0:20:04.11,teks umum,,0,0,0,,Jadi kami mahu putera raja berfikir
Dialog: 0,0:20:06.15,0:20:08.78,teks umum,,0,0,0,,So Yul, pergi ke Moo Deok
Dialog: 0,0:20:08.86,0:20:10.61,teks umum,,0,0,0,,Uk, dan anda bersama saya di Saejukwon
Dialog: 0,0:20:11.32,0:20:13.32,teks umum,,0,0,0,,Jom. Cepat
Dialog: 0,0:20:14.58,0:20:16.54,italic,,0,0,0,,- Berhati-hati. Nah!\N- Sakit
Dialog: 0,0:20:16.62,0:20:18.12,miring,,0,0,0,,Lihat di bawah kaki anda
Dialog: 0,0:20:23.25,0:20:27.42,teks umum,,0,0,0,,Seperti yang anda katakan, pemilik kehilangan kesemuanya sepuluh kali
Dialog: 0,0:20:28.05,0:20:29.84,teks umum,,0,0,0,,Anda menang, Yang Amat Mulia
Dialog: 0,0:20:30.72,0:20:34.39,teks umum,,0,0,0,,Anda tahu bahawa dia menguasai Chisu
Dialog: 0,0:20:35.97,0:20:38.77,teks umum,,0,0,0,,Jadi saya dengan berani meletakkan diri saya di talian
Dialog: 0,0:20:38.85,0:20:41.06,teks umum,,0,0,0,,Jika Cha Bum tidak menolak pertarungan itu,
Dialog: 0,0:20:41.73,0:20:43.40,teks umum,,0,0,0,,pemilik akan menang
Dialog: 0,0:20:44.81,0:20:46.48,teks umum,,0,0,0,,Dia bukan lagi tuanmu
Dialog: 0,0:20:48.36,0:20:50.36,teks umum,,0,0,0,,Sekarang awak layan Seo Yul
Dialog: 0,0:20:53.24,0:20:56.03,teks umum,,0,0,0,,Anda berkata bahawa anda berkongsi perasaan yang sama
Dialog: 0,0:20:57.37,0:20:58.45,teks umum,,0,0,0,,Cemerlang
Dialog: 0,0:20:59.29,0:21:01.96,teks umum,,0,0,0,,Saya harap anda tidak kehilangan mereka semasa anda melayani yang lain
Dialog: 0,0:21:24.40,0:21:25.77,miring,,0,0,0,,Ini kelakar
Dialog: 0,0:21:25.86,0:21:28.15,teks umum,,0,0,0,,Bagaimana dia boleh menguasai Chisa dengan begitu cepat?
Dialog: 0,0:21:28.23,0:21:30.86,teks umum,,0,0,0,,Memang benar. Kami telah melihat semuanya
Dialog: 0,0:21:31.49,0:21:32.36,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:22:00.56,0:22:02.27,teks umum,,0,0,0,,Syurga yang suci!
Dialog: 0,0:22:03.56,0:22:05.77,teks umum,,0,0,0,,Anda benar-benar genius!
Dialog: 0,0:22:05.85,0:22:07.40,teks umum,,0,0,0,,Betul, Uk!
Dialog: 0,0:22:07.48,0:22:09.65,teks umum,,0,0,0,,- Sakit\N- Maaf
Dialog: 0,0:22:10.69,0:22:12.36,teks umum,,0,0,0,,Cikgu Huo, saya sakit hati
Dialog: 0,0:22:12.94,0:22:15.20,teks umum,,0,0,0,,Anda menyertai kerana anda bimbang,
Dialog: 0,0:22:15.28,0:22:17.41,teks am,,0,0,0,,saya kena layan Cha Bum, kan?
Dialog: 0,0:22:17.49,0:22:19.83,teks umum,,0,0,0,,Terima kasih atas kebaikan anda
Dialog: 0,0:22:19.91,0:22:21.70,teks umum,,0,0,0,,Sekarang awak layan saya
Dialog: 0,0:22:22.75,0:22:25.37,teks umum,,0,0,0,,Ini adalah janji yang saya buat kepada putera raja
Dialog: 0,0:22:26.04,0:22:27.67,teks umum,,0,0,0,,Dan saya perlu berpura-pura mengikutinya
Dialog: 0,0:22:27.75,0:22:28.84,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:22:28.92,0:22:32.42,teks umum,,0,0,0,,Jika anda memerlukan apa-apa, bercakap pada bila-bila masa
Dialog: 0,0:22:32.51,0:22:33.67,teks umum,,0,0,0,,Tiada apa-apa yang diperlukan
Dialog: 0,0:22:34.22,0:22:36.34,teks umum,,0,0,0,,Anda boleh melawat Uka pada bila-bila masa
Dialog: 0,0:22:38.22,0:22:39.39,teks umum,,0,0,0,,Saya ada
Dialog: 0,0:22:40.97,0:22:42.60,teks umum,,0,0,0,,hanya satu permintaan
Dialog: 0,0:22:44.27,0:22:47.60,teks umum,,0,0,0,,Apabila saya tamat belajar, saya akan kembali ke Soho
Dialog: 0,0:22:48.56,0:22:50.61,teks umum,,0,0,0,,Saya mahu membawa seorang bersama saya
Dialog: 0,0:22:51.52,0:22:53.48,teks umum,,0,0,0,,Tolong bantu saya
Dialog: 0,0:22:54.90,0:22:55.95,teks umum,,0,0,0,,lakukan
Dialog: 0,0:22:57.78,0:23:00.24,teks umum,,0,0,0,,Saya tidak tahu anda mempunyai orang seperti itu
Dialog: 0,0:23:00.32,0:23:03.62,teks umum,,0,0,0,,Beri kata anda. Janji awak akan bantu
Dialog: 0,0:23:07.87,0:23:10.42,teks umum,,0,0,0,,Awak tanya tuan saya
Dialog: 0,0:23:11.00,0:23:13.05,teks umum,,0,0,0,,Saya pasti akan membantu anda
Dialog: 0,0:23:24.14,0:23:27.31,teks umum,,0,0,0,,Kini terdapat penelan jiwa di Saejukwon
Dialog: 0,0:23:27.39,0:23:29.15,teks umum,,0,0,0,,Dan awak bawa Uka ke sini
Dialog: 0,0:23:29.23,0:23:31.56,teks umum,,0,0,0,,Apa yang boleh saya lakukan? Dia cedera
Dialog: 0,0:23:32.15,0:23:35.32,teks umum,,0,0,0,,saya suruh dia berehat beberapa hari
Dialog: 0,0:23:36.61,0:23:38.65,teks umum,,0,0,0,,- Adakah dia cedera parah?\N- Tidak
Dialog: 0,0:23:38.74,0:23:40.16,teks umum,,0,0,0,,Tiada apa-apa yang serius
Dialog: 0,0:23:41.49,0:23:44.91,teks umum,,0,0,0,,Bagaimana dia boleh melawan Yul secara melulu
Dialog: 0,0:23:44.99,0:23:47.54,teks umum,,0,0,0,,Saya akan terus memancing bersama Master Li
Dialog: 0,0:23:47.62,0:23:49.29,teks umum,,0,0,0,,Anda tidak sepatutnya menghubunginya semula
Dialog: 0,0:23:50.21,0:23:53.88,teks umum,,0,0,0,,Mereka pasti melakukan lebih daripada sekadar ikan
Dialog: 0,0:23:55.84,0:23:59.05,teks umum,,0,0,0,,Uk, keparat, menguasai Chisu
Dialog: 0,0:23:59.88,0:24:00.89,teks umum,,0,0,0,,Apa?
Dialog: 0,0:24:02.30,0:24:03.76,teks umum,,0,0,0,,Luar biasa, bukan?
Dialog: 0,0:24:03.85,0:24:05.26,miring,,0,0,0,,Tidak dapat difahami
Dialog: 0,0:24:05.35,0:24:07.22,teks umum,,0,0,0,,Dia benar-benar genius!
Dialog: 0,0:24:15.11,0:24:17.53,teks umum,,0,0,0,,Apa yang anda pelajari
Dialog: 0,0:24:18.36,0:24:22.24,teks umum,,0,0,0,,semasa memancing
Dialog: 0,0:24:22.32,0:24:23.95,teks umum,,0,0,0,,dengan Cikgu Li?
Dialog: 0,0:24:25.62,0:24:27.50,teks umum,,0,0,0,,Saya belajar menangkap Ikan Emas
Dialog: 0,0:24:27.58,0:24:30.92,teks umum,,0,0,0,,Jadi dia ingin membantu anda menguasai Chisa
Dialog: 0,0:24:31.50,0:24:34.59,teks umum,,0,0,0,,- Adakah dia mengambil kamu sebagai pelajar?{\i1}\N- Tidak juga
Dialog: 0,0:24:34.67,0:24:36.63,teks umum,,0,0,0,,Ada sebab dia membantu saya
Dialog: 0,0:24:37.59,0:24:39.97,teks umum,,0,0,0,,Yang mana?
Dialog: 0,0:24:41.18,0:24:43.97,italic,,0,0,0,,Tuan kepada anda
Dialog: 0,0:24:44.72,0:24:45.89,teks umum,,0,0,0,,sesuatu...
Dialog: 0,0:24:47.43,0:24:48.72,teks umum,,0,0,0,,diberitahu?
Dialog: 0,0:24:50.64,0:24:52.48,teks umum,,0,0,0,,Ini menyangkut keluarga saya
Dialog: 0,0:24:52.56,0:24:54.98,teks umum,,0,0,0,,Saya sendiri perasan perkara ini dan bertanya terus kepadanya
Dialog: 0,0:24:59.28,0:25:02.45,teks umum,,0,0,0,,Nampaknya anda juga tahu perkara ini
Dialog: 0,0:25:04.99,0:25:06.20,teks umum,,0,0,0,,Saya berharap
Dialog: 0,0:25:08.24,0:25:09.79,teks umum,,0,0,0,,yang anda tidak akan kenali
Dialog: 0,0:25:10.71,0:25:11.96,miring,,0,0,0,,Tidak
Dialog: 0,0:25:12.04,0:25:15.25,teks umum,,0,0,0,,Saya tidak dapat menutup mata saya apabila saya mengetahui segala-galanya
Dialog: 0,0:25:16.67,0:25:18.17,contact,,0,0,0,,Apa yang akan anda lakukan sekarang?
Dialog: 0,0:25:22.72,0:25:23.97,teks umum,,0,0,0,,Dengan pembantu rumah Kim
Dialog: 0,0:25:32.48,0:25:33.81,teks umum,,0,0,0,,Apa kaitan dia dengannya?
Dialog: 0,0:25:33.89,0:25:36.56,teks umum,,0,0,0,,Cikgu Lee cuba memikat pembantu rumah Kim,
Dialog: 0,0:25:36.65,0:25:38.61,teks umum,,0,0,0,,membantu saya
Dialog: 0,0:25:39.94,0:25:41.49,teks umum,,0,0,0,,Jadi apa yang akan anda lakukan?
Dialog: 0,0:25:42.70,0:25:47.24,teks umum,,0,0,0,,Cikgu Li ialah orang yang hebat yang banyak membantu saya
Dialog: 0,0:25:48.87,0:25:49.70,miring,,0,0,0,,Tetapi masih
Dialog: 0,0:25:50.70,0:25:54.12,teks umum,,0,0,0,,saya fikir saya patut beri awak peluang dulu
Dialog: 0,0:25:54.21,0:25:55.79,teks umum,,0,0,0,,Jika kita mengambil kira hubungan kita
Dialog: 0,0:25:59.55,0:26:01.01,teks umum,,0,0,0,,Peluang apa?
Dialog: 0,0:26:02.13,0:26:05.22,teks umum,,0,0,0,,Adakah anda tahu bahawa Cikgu Li tinggal bersama kami?
Dialog: 0,0:26:06.34,0:26:08.93,teks umum,,0,0,0,,Dan saya tertanya-tanya di mana dia berhenti
Dialog: 0,0:26:09.01,0:26:11.22,teks umum,,0,0,0,,Jadi dia tinggal di rumah awak
Dialog: 0,0:26:11.31,0:26:12.31,teks umum,,0,0,0,,Ya
Dialog: 0,0:26:12.39,0:26:15.56,teks umum,,0,0,0,,Saya di sini sekarang, dan mereka mungkin sedang minum teh di sana, bercakap
Dialog: 0,0:26:15.64,0:26:17.73,teks umum,,0,0,0,,Pembantu rumah Kim sangat baik
Dialog: 0,0:26:17.81,0:26:20.32,teks umum,,0,0,0,,Dia suka menjaga dan memberi makan kepada orang lain
Dialog: 0,0:26:20.40,0:26:22.82,teks umum,,0,0,0,,Tinggal masa sebelum dia jatuh cinta dengannya
Dialog: 0,0:26:24.90,0:26:26.61,teks umum,,0,0,0,,Saya sangat berharap
Dialog: 0,0:26:26.70,0:26:29.53,teks umum,,0,0,0,,bahawa dia akan berkahwin dengan lelaki yang baik
Dialog: 0,0:26:32.91,0:26:34.54,teks umum,,0,0,0,,Jika anda tidak keberatan,
Dialog: 0,0:26:35.37,0:26:38.21,teks umum,,0,0,0,,Saya ingin menyokong mereka
Dialog: 0,0:26:51.85,0:26:54.73,teks umum,,0,0,0,,Cikgu Li dua kali umurnya
Dialog: 0,0:26:55.31,0:26:58.56,teks umum,,0,0,0,,Tetapi dia kelihatan lebih muda daripada awak
Dialog: 0,0:26:58.65,0:27:00.19,miring,,0,0,0,,Ini mengarut juga
Dialog: 0,0:27:00.27,0:27:03.48,teks umum,,0,0,0,,Dia mengamalkan kesucian
Dialog: 0,0:27:04.36,0:27:06.11,teks umum,,0,0,0,,Bagaimana mereka boleh berkahwin?
Dialog: 0,0:27:06.70,0:27:10.24,teks umum,,0,0,0,,Saya menekan naluri saya demi latihan, tetapi kemudian cepat pulih
Dialog: 0,0:27:10.32,0:27:11.87,teks umum,,0,0,0,,Mungkin
Dialog: 0,0:27:11.95,0:27:13.99,teks umum,,0,0,0,,Perkahwinan mestilah atas persetujuan bersama
Dialog: 0,0:27:15.25,0:27:17.21,teks umum,,0,0,0,,Dia pasti mahukannya juga
Dialog: 0,0:27:17.29,0:27:18.96,teks umum,,0,0,0,,Dia selama ini
Dialog: 0,0:27:19.96,0:27:23.75,teks umum,,0,0,0,,mencintai seseorang
Dialog: 0,0:27:25.21,0:27:26.38,teks umum,,0,0,0,,Jin
Dialog: 0,0:27:26.47,0:27:32.43,teks umum,,0,0,0,,Adakah anda benar-benar berfikir bahawa dia masih mencintai Chang Gang?
Dialog: 0,0:27:34.35,0:27:36.73,teks umum,,0,0,0,,Saya lebih mengenalinya daripada sesiapa sahaja
Dialog: 0,0:27:37.31,0:27:40.27,teks umum,,0,0,0,,Jadi saya minta anda, jangan membuat kesimpulan terburu-buru
Dialog: 0,0:27:42.31,0:27:44.73,teks umum,,0,0,0,,Apa yang perlu saya lakukan dengan awak?
Dialog: 0,0:27:44.82,0:27:46.86,teks umum,,0,0,0,,Dan dia memanggil orang lain bodoh,
Dialog: 0,0:27:46.94,0:27:49.41,teks umum,,0,0,0,,apabila dia tidak nampak apa-apa di bawah hidungnya
Dialog: 0,0:27:49.49,0:27:50.87,teks umum,,0,0,0,,Apa yang anda tahu!
Dialog: 0,0:27:51.45,0:27:54.29,teks umum,,0,0,0,,Dia sudah lama berhenti mencintai Chang Gan
Dialog: 0,0:28:18.98,0:28:20.23,teks umum,,0,0,0,,Pada hari itu
Dialog: 0,0:28:21.85,0:28:23.15,teks umum,,0,0,0,,dia juga ada di sini
Dialog: 0,0:28:27.99,0:28:30.07,teks umum,,0,0,0,,Ini teh quince yang baru dibancuh
Dialog: 0,0:28:30.15,0:28:31.24,teks umum,,0,0,0,,Aroma yang menyenangkan
Dialog: 0,0:28:32.87,0:28:35.74,teks umum,,0,0,0,,Tidak baik menyimpan bunga layu di dalam rumah
Dialog: 0,0:28:35.83,0:28:38.08,teks umum,,0,0,0,,Cuaca sejuk telah tiba, bunga sukar ditemui sekarang
Dialog: 0,0:28:38.79,0:28:40.71,teks umum,,0,0,0,,Tetapi saya akan mendengar anda dan membuangnya
Dialog: 0,0:28:42.04,0:28:43.71,teks umum,,0,0,0,,Saya suka cara bunga
Dialog: 0,0:28:43.79,0:28:45.67,teks umum,,0,0,0,,menemani saya
Dialog: 0,0:28:59.98,0:29:03.02,teks umum,,0,0,0,,Saya benar-benar terlupa tentang cawan dan hanya membawa teko
Dialog: 0,0:29:09.61,0:29:11.61,teks umum,,0,0,0,,Bagaimana ia boleh mekar semula?
Dialog: 0,0:29:12.78,0:29:14.57,teks umum,,0,0,0,,Cikgu Li buat ini?
Dialog: 0,0:29:16.53,0:29:17.37,teks umum,,0,0,0,,Sungguh cantik
Dialog: 0,0:29:34.76,0:29:36.01,teks umum,,0,0,0,,Mestilah,
Dialog: 0,0:29:36.97,0:29:39.22,teks umum,,0,0,0,,dia memberinya bunga
Dialog: 0,0:29:40.85,0:29:42.43,teks umum,,0,0,0,,hari itu
Dialog: 0,0:29:51.07,0:29:53.57,teks umum,,0,0,0,,Cikgu Li, anda sangat baik dan bersimpati
Dialog: 0,0:29:54.45,0:29:55.61,teks umum,,0,0,0,,Saya?
Dialog: 0,0:29:56.28,0:29:58.78,teks umum,,0,0,0,,Tinggal di sini selagi anda mahu
Dialog: 0,0:29:58.87,0:30:00.62,teks umum,,0,0,0,,Saya akan menjaga kamu
Dialog: 0,0:30:02.33,0:30:03.41,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:30:06.63,0:30:09.13,teks umum,,0,0,0,,Adakah gadis ini isteri Chang Gan?
Dialog: 0,0:30:11.46,0:30:14.63,teks umum,,0,0,0,,Ya, cantik, kan?
Dialog: 0,0:30:14.72,0:30:18.39,teks umum,,0,0,0,,Adakah Jin yang jatuh cinta padanya? Yeom memberitahu
Dialog: 0,0:30:21.97,0:30:27.02,teks umum,,0,0,0,,Dia tidak layu dan mengekalkan kecantikannya
Dialog: 0,0:30:28.81,0:30:31.53,italic,,0,0,0,,Mungkin sebab itu dia masih tidak dapat melupakannya
Dialog: 0,0:30:32.94,0:30:34.28,teks umum,,0,0,0,,Atau
Dialog: 0,0:30:35.11,0:30:36.66,teks umum,,0,0,0,,dia cuma tak suka saya
Dialog: 0,0:30:37.49,0:30:38.70,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:30:44.83,0:30:46.92,teks umum,,0,0,0,,Saya faham, itu yang diperintahkan oleh putera raja
Dialog: 0,0:30:47.00,0:30:49.25,teks umum,,0,0,0,,Tetapi bagaimana dia boleh melarang Moo Deok daripada melawat saya?
Dialog: 0,0:30:49.34,0:30:51.17,teks umum,,0,0,0,,Dia risau sepanjang masa
Dialog: 0,0:30:51.25,0:30:53.84,contact,,0,0,0,,Saya pasti dia hanya sibuk
Dialog: 0,0:30:53.92,0:30:55.72,teks umum,,0,0,0,,Saya memberitahunya bahawa anda baik-baik saja
Dialog: 0,0:30:55.80,0:30:56.72,miring,,0,0,0,,Nah, tidak
Dialog: 0,0:30:56.80,0:30:59.22,teks umum,,0,0,0,,Adakah anda rasa dia segera berehat selepas kata-kata anda?
Dialog: 0,0:30:59.85,0:31:00.93,teks umum,,0,0,0,,Kita perlu menyemak
Dialog: 0,0:31:02.10,0:31:03.02,teks umum,,0,0,0,,Datang ke sini
Dialog: 0,0:31:06.06,0:31:07.98,teks umum,,0,0,0,,Ini hanya akan menyebabkan anda sakit
Dialog: 0,0:31:09.69,0:31:13.98,teks umum,,0,0,0,,Burung ini menghantar surat saya kepada Soho
Dialog: 0,0:31:16.95,0:31:20.91,teks umum,,0,0,0,,Ia mengambil masa tiga hingga empat hari untuk sampai ke sana dengan menaiki kuda
Dialog: 0,0:31:20.99,0:31:22.66,teks umum,,0,0,0,,Bolehkah seekor burung terbang sejauh ini?
Dialog: 0,0:31:23.24,0:31:24.37,teks umum,,0,0,0,,Luar biasa
Dialog: 0,0:31:37.34,0:31:38.97,teks umum,,0,0,0,,Adakah anda mempunyai wisel?
Dialog: 0,0:31:40.05,0:31:42.68,teks umum,,0,0,0,,Maaf, saya tidak membawanya bersama saya
Dialog: 0,0:31:45.89,0:31:48.35,teks umum,,0,0,0,,Ini adalah hadiah daripada orang yang anda sayangi
Dialog: 0,0:31:48.44,0:31:49.27,teks umum,,0,0,0,,Saya terluka
Dialog: 0,0:31:59.91,0:32:02.83,teks umum,,0,0,0,,Anda perlu meniup dua kali untuk burung itu kembali
Dialog: 0,0:32:04.12,0:32:05.54,teks umum,,0,0,0,,Anda melakukannya dengan baik
Dialog: 0,0:32:06.12,0:32:07.33,teks umum,,0,0,0,,Cuba
Dialog: 0,0:32:37.03,0:32:38.19,teks umum,,0,0,0,,Lihat
Dialog: 0,0:32:41.32,0:32:42.82,teks umum,,0,0,0,,Burung itu kembali
Dialog: 0,0:32:45.16,0:32:46.74,teks umum,,0,0,0,,Sekarang tiup dua kali dengan cepat
Dialog: 0,0:33:09.64,0:33:12.44,kenangan miring,,0,0,0,,Saya berkata demikian untuk menenangkannya
Dialog: 0,0:33:12.52,0:33:15.23,kenangan,,0,0,0,,Dia bimbang burung jinaknya mengalami kesukaran pada musim sejuk,
Dialog: 0,0:33:16.15,0:33:17.77,kenangan,,0,0,0,,jadi saya berbohong
Dialog: 0,0:33:20.32,0:33:23.03,teks umum,,0,0,0,,Nampak? Moo Deok sihat
Dialog: 0,0:33:27.03,0:33:29.08,teks umum,,0,0,0,,Tunggu, tunggu, Uk
Dialog: 0,0:33:29.16,0:33:32.37,teks umum,,0,0,0,,Apa sebenarnya yang Moo Dok berhujah dengan Putera Mahkota?
Dialog: 0,0:33:32.46,0:33:33.83,teks umum,,0,0,0,,Perkara yang anda mahu kembali
Dialog: 0,0:33:36.79,0:33:39.17,teks umum,,0,0,0,,Tidak mengapa. Sekarang saya tidak dapat mendapatkannya kembali sejak saya kalah
Dialog: 0,0:33:45.68,0:33:49.64,teks umum,,0,0,0,,Tetapi kenapa dia begitu riang apabila kehilangan dia?
Dialog: 0,0:33:57.94,0:34:00.15,contact,,0,0,0,,- Jadi apa itu?\N- Jangan tanya
Dialog: 0,0:34:00.73,0:34:04.36,teks umum,,0,0,0,,Mengapa kamu tidak pernah melawat Wook di Saejukwon?
Dialog: 0,0:34:05.78,0:34:08.53,teks umum,,0,0,0,,Saya tuan baharu kamu, tetapi kamu tidak perlu risau mengenainya
Dialog: 0,0:34:09.37,0:34:11.16,teks umum,,0,0,0,,Bukan itu maksudnya
Dialog: 0,0:34:11.66,0:34:13.66,teks umum,,0,0,0,,Saya hanya cuba untuk tidak malu
Dialog: 0,0:34:25.34,0:34:27.72,kenangan miring,,0,0,0,,Jadi anda tidak kisah sama ada anda kehilangan dia atau tidak?
Dialog: 0,0:34:31.31,0:34:34.81,luar skrin,,0,0,0,,Saya kena cari dia. Saya mesti mencari dia hari ini
Dialog: 0,0:34:36.10,0:34:38.94,luar skrin,,0,0,0,,Barulah saya dapat melihat matanya
Dialog: 0,0:34:50.95,0:34:52.29,contact,,0,0,0,,saya tahu
Dialog: 0,0:34:55.50,0:34:57.00,teks umum,,0,0,0,,Dia minum teh itu
Dialog: 0,0:34:58.96,0:35:00.92,teks umum,,0,0,0,,Dia memalukan ahli silap mata dan melarikan diri
Dialog: 0,0:35:01.00,0:35:04.80,teks umum,,0,0,0,,Dan kemudian dia bertambah baik dan mengalahkan Putera Mahkota. Ini pelik
Dialog: 0,0:35:04.88,0:35:07.26,teks umum,,0,0,0,,Dia memutuskan untuk menjadi pelajar Master Li
Dialog: 0,0:35:07.34,0:35:09.09,teks umum,,0,0,0,,dan mengamalkan kesucian
Dialog: 0,0:35:09.18,0:35:10.60,teks umum,,0,0,0,,Pernahkah anda semua melihat Cikgu Li?
Dialog: 0,0:35:11.18,0:35:12.60,teks umum,,0,0,0,,Beliau adalah pelajar kepada tuan So Kyung,
Dialog: 0,0:35:12.68,0:35:14.47,contact,,0,0,0,,dan Cikgu Ho Yeom ialah muridnya
Dialog: 0,0:35:14.56,0:35:16.69,teks umum,,0,0,0,,Tetapi dia kelihatan lebih muda daripada kepala kita
Dialog: 0,0:35:16.77,0:35:19.19,teks umum,,0,0,0,,Dan semuanya kerana dia mengamalkan kesucian
Dialog: 0,0:35:19.27,0:35:23.11,teks umum,,0,0,0,,Saya dengar dia tidak tua kerana dia mencapai tahap tertinggi pada masa mudanya
Dialog: 0,0:35:23.19,0:35:26.24,teks umum,,0,0,0,,Begitukah? Saya dengar dia menjadi lebih muda kerana sihir
Dialog: 0,0:35:26.32,0:35:27.20,condong,,0,0,0,,Eja?
Dialog: 0,0:35:27.28,0:35:30.20,teks umum,,0,0,0,,Itu tidak penting. Uk berazam
Dialog: 0,0:35:30.28,0:35:31.74,teks umum,,0,0,0,, Dan bagaimana jika dia sampai ke Chisu?
Dialog: 0,0:35:32.33,0:35:33.66,teks umum,,0,0,0,,Saya di tempat dia
Dialog: 0,0:35:35.79,0:35:37.54,teks umum,,0,0,0,,tidak akan menahan diri
Dialog: 0,0:35:38.25,0:35:39.83,teks umum,,0,0,0,,Sudah tentu, saya juga
Dialog: 0,0:35:39.92,0:35:41.75,teks umum,,0,0,0,,- Dia betul-betul degil\N- Dan jangan beritahu
Dialog: 0,0:35:45.30,0:35:46.67,teks umum,,0,0,0,,Mereka semua cemburu
Dialog: 0,0:35:48.47,0:35:51.80,teks umum,,0,0,0,,Terdapat banyak khabar angin yang mengerikan tentang Encik Chang Wook
Dialog: 0,0:35:59.69,0:36:00.94,teks umum,,0,0,0,,Saya dapat
Dialog: 0,0:36:01.73,0:36:05.15,teks umum,,0,0,0,,tidurlah dengan bantuan ubat-ubatannya
Dialog: 0,0:36:07.82,0:36:10.95,teks am,,0,0,0,,Saya gembira kerana herba perubatan bermanfaat
Dialog: 0,0:36:11.99,0:36:15.49,teks umum,,0,0,0,,Saya menggunakan akar valerian, yang tumbuh di paya kubu Vol
Dialog: 0,0:36:15.58,0:36:17.37,teks umum,,0,0,0,,Dia terkenal sebagai seorang yang menenangkan
Dialog: 0,0:36:17.45,0:36:21.25,teks umum,,0,0,0,,Ia akan membantu anda berehat dan meningkatkan tidur anda
Dialog: 0,0:36:21.79,0:36:24.25,teks umum,,0,0,0,,Saya faham kenapa Cikgu Ho Yeom mengesyorkan anda
Dialog: 0,0:36:25.71,0:36:28.17,teks umum,,0,0,0,,Nasib baik, saya kini boleh tidur lena
Dialog: 0,0:36:28.26,0:36:31.55,teks umum,,0,0,0,,Tetapi tinnitus dan sakit kepala masih kekal
Dialog: 0,0:36:31.64,0:36:34.01,teks umum,,0,0,0,,Berita tentang orang perantau semakin teruk
Dialog: 0,0:36:34.10,0:36:35.89,teks umum,,0,0,0,,negeri anda
Dialog: 0,0:36:35.97,0:36:38.52,teks umum,,0,0,0,,Seorang perantau cuba memasuki istana
Dialog: 0,0:36:38.60,0:36:41.44,teks umum,,0,0,0,,Di dalam, mungkin mereka juga ada
Dialog: 0,0:36:42.02,0:36:43.44,italic,,0,0,0,,Timbalan Gwangju Jin Moo
Dialog: 0,0:36:43.52,0:36:45.52,teks umum,,0,0,0,, keselamatan dipertingkatkan, jadi jangan risau
Dialog: 0,0:36:45.61,0:36:48.24,teks umum,,0,0,0,,Orangnya yang cuba ke sini!
Dialog: 0,0:36:48.99,0:36:50.11,contact,,0,0,0,,Dan terdapat khabar angin,
Dialog: 0,0:36:50.20,0:36:53.16,teks umum,,0,0,0,,bahawa seorang lagi perantau telah dilihat di Chonbugwan
Dialog: 0,0:36:54.99,0:36:56.74,teks umum,,0,0,0,,Saya tidak boleh mempercayai sesiapa
Dialog: 0,0:36:59.62,0:37:03.00,teks umum,,0,0,0,,Nampaknya kebimbangan tuanku datang dari hati, Tuanku
Dialog: 0,0:37:03.08,0:37:06.59,teks umum,,0,0,0,,Mungkin kami boleh mencari cara lain untuk menenangkan anda?
Dialog: 0,0:37:07.67,0:37:11.13,teks umum,,0,0,0,,Adakah anda kenal Hemp Master Li?
Dialog: 0,0:37:11.22,0:37:13.26,teks umum,,0,0,0,,Pelajar terakhir sarjana So Kyung
Dialog: 0,0:37:13.84,0:37:15.93,contact,,0,0,0,,Saya mendengar tentang dia,
Dialog: 0,0:37:16.01,0:37:17.97,teks umum,,0,0,0,,tetapi melihat hanya sekali dalam Sosnovy Bor
Dialog: 0,0:37:18.77,0:37:22.98,teks umum,,0,0,0,,Datuk saya adalah muridnya, jadi saya mendengar banyak tentang dia
Dialog: 0,0:37:23.06,0:37:27.02,teks umum,,0,0,0,,Mungkin ia boleh mengurangkan kebimbangan anda
Dialog: 0,0:37:27.98,0:37:29.82,teks umum,,0,0,0,,Adakah anda mengatakan bahawa dia boleh menentukan,
Dialog: 0,0:37:29.90,0:37:31.99,teks umum,,0,0,0,,adakah orang nomad di sekeliling saya?
Dialog: 0,0:37:32.07,0:37:34.61,teks umum,,0,0,0,,Saya tidak mengenalinya secara peribadi, jadi saya tidak tahu
Dialog: 0,0:37:34.70,0:37:38.33,teks umum,,0,0,0,,Saya rasa anda boleh menjemputnya ke istana dan meminta bantuan
Dialog: 0,0:37:44.75,0:37:46.59,teks umum,,0,0,0,,Saya suruh awak bersihkan di sini setiap hari!
Dialog: 0,0:37:46.67,0:37:49.21,teks am,,0,0,0,,Air dalam pasu telah rosak!
Dialog: 0,0:37:50.51,0:37:51.47,teks umum,,0,0,0,,Maaf
Dialog: 0,0:37:52.38,0:37:54.01,italic,,0,0,0,,Bagaimana jika Boo Young kembali
Dialog: 0,0:37:54.09,0:37:56.14,teks am,,0,0,0,,dan nampak pasu dengan air bertakung di sini?
Dialog: 0,0:37:56.22,0:37:57.89,teks umum,,0,0,0,,Dia akan kecewa dengan saya
Dialog: 0,0:37:58.93,0:38:00.56,contact,,0,0,0,,Tukar helaian
Dialog: 0,0:38:00.64,0:38:02.02,teks umum,,0,0,0,,dan hapuskannya
Dialog: 0,0:38:02.10,0:38:04.06,teks umum,,0,0,0,,Dia buta, jadi kenapa awak letak ini di sini?
Dialog: 0,0:38:04.14,0:38:05.81,miring,,0,0,0,,Untuk dia tersandung?
Dialog: 0,0:38:18.70,0:38:20.95,teks umum,,0,0,0,,Berpuluh-puluh gadis telah datang kepada kami,
Dialog: 0,0:38:22.12,0:38:23.62,teks umum,,0,0,0,,tetapi Bu Young tiada di kalangan mereka
Dialog: 0,0:38:24.16,0:38:28.38,teks umum,,0,0,0,,Dia kecewa tentang perkara ini, menjadi sangat sensitif
Dialog: 0,0:38:28.46,0:38:29.80,teks umum,,0,0,0,,Saya juga perasan
Dialog: 0,0:38:30.71,0:38:33.55,teks umum,,0,0,0,,Tetapi hari lahir anda akan datang tidak lama lagi
Dialog: 0,0:38:36.55,0:38:39.55,teks umum,,0,0,0,,- Sini\N- Apakah ini?
Dialog: 0,0:38:42.56,0:38:45.14,teks umum,,0,0,0,,Ayah, mereka sangat cantik
Dialog: 0,0:38:46.69,0:38:48.77,teks umum,,0,0,0,,Tetapi hari lahir saya bukan hari ini
Dialog: 0,0:38:48.86,0:38:51.48,teks umum,,0,0,0,,Pada hari ini saya akan memberikan sesuatu yang lebih indah
Dialog: 0,0:38:53.07,0:38:55.45,teks umum,,0,0,0,,Saya mahu mencubanya. Bolehkah anda membantu saya?
Dialog: 0,0:38:56.95,0:38:58.03,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:39:02.37,0:39:06.25,teks umum,,0,0,0,,Mari kita lihat betapa cantiknya anak perempuan saya
Dialog: 0,0:39:06.92,0:39:10.63,teks umum,,0,0,0,,Masa saya kecik, awak selalu tocang rambut saya
Dialog: 0,0:39:15.26,0:39:19.05,teks umum,,0,0,0,,Ibu tidak pernah melakukan ini
Dialog: 0,0:39:21.51,0:39:23.43,teks umum,,0,0,0,,Maaf. Adakah ia sangat menyakitkan?
Dialog: 0,0:39:24.52,0:39:25.64,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:39:40.16,0:39:43.74,teks umum,,0,0,0,,Saya mungkin terlupa cara mengepang rambut saya, saya sudah lama tidak melakukannya
Dialog: 0,0:39:43.83,0:39:44.83,teks umum,,0,0,0,,Maaf
Dialog: 0,0:39:44.91,0:39:48.00,teks umum,,0,0,0,,Semuanya baik-baik saja. Macam mana rupa saya?
Dialog: 0,0:39:48.62,0:39:50.25,teks umum,,0,0,0,,Anda sentiasa cantik
Dialog: 0,0:40:23.78,0:40:25.83,teks umum,,0,0,0,,Pak Jin menembak saya dengan busur ini
Dialog: 0,0:40:28.58,0:40:30.08,suara,,0,0,0,,Saya kalah hari itu
Dialog: 0,0:40:30.17,0:40:33.54,suara,,0,0,0,,Saya tidak boleh mengemukakan alasan atau tidak menerima keputusan pertempuran
Dialog: 0,0:40:36.09,0:40:38.05,suara,,0,0,0,,Tetapi apabila saya mendapat semula kuasa saya,
Dialog: 0,0:40:39.01,0:40:42.01,suara,,0,0,0,,Saya ingin melawan dia dengan sebenar-benarnya
Dialog: 0,0:40:53.98,0:40:55.07,italic,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:40:56.65,0:40:58.53,teks umum,,0,0,0,,Keluar, bab
Dialog: 0,0:41:00.57,0:41:02.11,teks umum,,0,0,0,,Jangan sentuh semuanya
Dialog: 0,0:41:02.70,0:41:05.87,teks umum,,0,0,0,,Senjata yang mengandungi tenaga ahli silap mata yang kuat,
Dialog: 0,0:41:05.95,0:41:08.75,teks umum,,0,0,0,,bahaya untuk gadis yang rapuh
Dialog: 0,0:41:10.37,0:41:12.58,teks umum,,0,0,0,,Malah saya tahu ini
Dialog: 0,0:41:13.17,0:41:16.38,teks umum,,0,0,0,,Tetapi mengapa anda meletakkannya di sini?
Dialog: 0,0:41:16.46,0:41:19.05,teks umum,,0,0,0,,Saya harus membersihkan di sini
Dialog: 0,0:41:19.13,0:41:21.88,teks umum,,0,0,0,,Saya biasanya menggantungnya di dinding
Dialog: 0,0:41:22.97,0:41:24.14,teks umum,,0,0,0,,Saya lupa kali ini
Dialog: 0,0:41:24.22,0:41:25.93,teks umum,,0,0,0,,Tetapi anda masih begitu muda
Dialog: 0,0:41:26.01,0:41:29.60,teks umum,,0,0,0,,Saya tidak percaya anda sudah begitu pelupa
Dialog: 0,0:41:30.31,0:41:33.56,teks umum,,0,0,0,,Saya hanya bimbang, seperti hamba Sosnovy Bor
Dialog: 0,0:41:33.65,0:41:36.65,teks umum,,0,0,0,,Bagaimana jika anda terlupa untuk membayar saya?
Dialog: 0,0:41:37.44,0:41:38.53,miring,,0,0,0,,Bab
Dialog: 0,0:41:38.61,0:41:42.11,teks umum,,0,0,0,,Sila sihat. Anda masih begitu muda
Dialog: 0,0:41:45.41,0:41:48.41,teks umum,,0,0,0,,Saya akan kembali nanti untuk menyelesaikan pembersihan
Dialog: 0,0:41:54.42,0:41:56.58,teks umum,,0,0,0,,Betapa pintarnya,
Dialog: 0,0:41:57.38,0:41:59.00,teks umum,,0,0,0,,tetapi seorang gadis kurang ajar
Dialog: 0,0:41:59.71,0:42:01.26,teks umum,,0,0,0,,Suka Moo Dok
Dialog: 0,0:42:01.34,0:42:04.34,teks umum,,0,0,0,,bertemu dengan Uk?
Dialog: 0,0:42:04.43,0:42:05.93,teks umum,,0,0,0,,Saya tidak tahu butirannya
Dialog: 0,0:42:06.01,0:42:09.85,teks umum,,0,0,0,,Tetapi saya mendengar bahawa dia membayar hutangnya dan mengambilnya dari Chwisongru
Dialog: 0,0:42:09.93,0:42:12.06,teks umum,,0,0,0,,Kemudian pergi ke Chwisongru
Dialog: 0,0:42:12.14,0:42:14.77,teks umum,,0,0,0,,dan tanya tentang dia
Dialog: 0,0:42:15.48,0:42:19.02,teks umum,,0,0,0,,Ketahui tentang masa lalunya dan wataknya
Dialog: 0,0:42:20.11,0:42:21.94,teks umum,,0,0,0,,Saya hanya ingin tahu
Dialog: 0,0:42:25.49,0:42:27.37,teks umum,,0,0,0,,saya pun tak tahu banyak
Dialog: 0,0:42:27.45,0:42:30.49,teks umum,,0,0,0,,Tetapi saudagar yang membawanya kini berada di ibu negara
Dialog: 0,0:42:30.58,0:42:33.20,teks umum,,0,0,0,,Saya akan suruh dia datang ke Sosnovy Bor
Dialog: 0,0:42:35.83,0:42:38.04,contact,,0,0,0,,Hey
Dialog: 0,0:42:40.50,0:42:42.21,teks umum,,0,0,0,,Adakah kita sudah berjumpa di kampung Sari?
Dialog: 0,0:42:42.80,0:42:44.51,teks umum,,0,0,0,,Apa yang anda perlukan kali ini?
Dialog: 0,0:42:44.59,0:42:45.76,teks umum,,0,0,0,,Jadi saya
Dialog: 0,0:42:45.84,0:42:47.80,italic,,0,0,0,,Awak pernah jumpa dia di ibu negara?
Dialog: 0,0:42:48.30,0:42:50.60,teks umum,,0,0,0,,Adakah anda tahu di mana dia boleh berada?
Dialog: 0,0:42:50.68,0:42:53.77,teks umum,,0,0,0,,Saya tidak tahu. Dia bukan penduduk Sari
Dialog: 0,0:42:54.35,0:42:57.60,teks umum,,0,0,0,,Dia berada di sana selama beberapa bulan, dan kemudian dia merompak penduduk kampung
Dialog: 0,0:42:57.69,0:42:59.06,teks umum,,0,0,0,, Beritahu saya jika anda menangkapnya
Dialog: 0,0:43:04.07,0:43:06.49,teks umum,,0,0,0,,Di mana saya boleh mencarinya?
Dialog: 0,0:43:10.41,0:43:11.45,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:43:12.20,0:43:14.58,teks umum,,0,0,0,,So Yi, awak telah berkawan jahat
Dialog: 0,0:43:16.08,0:43:19.13,teks umum,,0,0,0,,Mungkin dia pergi mencari Moo Deok?
Dialog: 0,0:43:22.63,0:43:25.22,teks umum,,0,0,0,,Sebentar lagi saya akan bawa awak ke Jinyeowon
Dialog: 0,0:43:25.30,0:43:27.88,teks umum,,0,0,0,,Tetapi pertama-tama kita perlu menjaga sesuatu
Dialog: 0,0:43:37.81,0:43:40.27,kenangan,,0,0,0,,Sini, makan
Dialog: 0,0:43:40.36,0:43:42.52,kenangan,,0,0,0,,Awak curi duit saya
Dialog: 0,0:43:42.61,0:43:43.86,kenangan,,0,0,0,,Kembalikan cincin saya
Dialog: 0,0:43:49.57,0:43:52.37,teks umum,,0,0,0,,Adakah anda bertemu mereka di ibu negara?
Dialog: 0,0:43:52.45,0:43:55.50,teks umum,,0,0,0,,Ya, tetapi mengapa anda membawa mereka ke sini?
Dialog: 0,0:43:55.58,0:43:58.37,teks umum,,0,0,0,,Saya suka anda pintar dan gigih
Dialog: 0,0:43:58.92,0:44:00.83,teks umum,,0,0,0,,Tetapi itu juga membuatkan anda berbahaya
Dialog: 0,0:44:01.92,0:44:03.92,teks umum,,0,0,0,,Saya mahu anda melihat sesuatu
Dialog: 0,0:44:20.73,0:44:21.94,teks umum,,0,0,0,,Timbalan Gwangju
Dialog: 0,0:44:22.48,0:44:25.28,teks umum,,0,0,0,,Terima kasih kerana memberi saya makan
Dialog: 0,0:45:27.00,0:45:28.46,teks umum,,0,0,0,,Takut
Dialog: 0,0:45:28.55,0:45:32.47,teks umum,,0,0,0,,Mengkhianati saya atau mendedahkan identiti anda, dan anda akan mengalami nasib yang sama
Dialog: 0,0:45:38.39,0:45:39.39,teks umum,,0,0,0,,Okey
Dialog: 0,0:45:40.35,0:45:42.98,teks umum,,0,0,0,, Beritahu saya jika ada orang lain yang mungkin mengenali anda
Dialog: 0,0:45:43.48,0:45:44.81,miring,,0,0,0,,Saya perlu menyingkirkannya
Dialog: 0,0:45:46.31,0:45:47.69,teks umum,,0,0,0,,Ya?
Dialog: 0,0:45:51.65,0:45:52.82,teks umum,,0,0,0,,Ya
Dialog: 0,0:45:56.20,0:45:59.79,teks umum,,0,0,0,,Cari dengan lebih teliti. Saya pasti melemparkannya ke sana
Dialog: 0,0:45:59.87,0:46:01.25,teks umum,,0,0,0,,Saya tidak nampak apa-apa
Dialog: 0,0:46:01.83,0:46:04.12,teks umum,,0,0,0,,Tengok sana
Dialog: 0,0:46:04.21,0:46:06.96,teks umum,,0,0,0,,Saya melihat baik-baik, tiada apa-apa di sana
Dialog: 0,0:46:07.04,0:46:08.75,teks umum,,0,0,0,,Lihat semula
Dialog: 0,0:46:08.84,0:46:10.21,teks umum,,0,0,0,,Saya hampir tidak dapat melihat...
Dialog: 0,0:46:11.38,0:46:12.59,teks umum,,0,0,0,,Ya, Yang Amat Mulia
Dialog: 0,0:46:13.13,0:46:15.09,teks umum,,0,0,0,,Saya pasti dia ada di sini di suatu tempat
Dialog: 0,0:46:15.18,0:46:16.84,teks umum,,0,0,0,,Ya, lihat di sana
Dialog: 0,0:46:21.43,0:46:22.77,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:46:24.98,0:46:26.27,teks umum,,0,0,0,,Bukan urusan anda. pergi pergi
Dialog: 0,0:46:27.44,0:46:30.98,teks umum,,0,0,0,,Saya takut sida-sida O menderita sia-sia
Dialog: 0,0:46:31.07,0:46:34.65,teks umum,,0,0,0,,Saya perlu katakan sesuatu. boleh?
Dialog: 0,0:46:34.74,0:46:36.28,teks umum,,0,0,0,,Apa yang anda ada?
Dialog: 0,0:46:37.70,0:46:38.66,teks umum,,0,0,0,,Mungkin,
Dialog: 0,0:46:39.70,0:46:40.79,teks umum,,0,0,0,,yang anda cari
Dialog: 0,0:46:41.58,0:46:43.12,teks umum,,0,0,0,, adakah ini?
Dialog: 0,0:46:44.71,0:46:45.71,teks umum,,0,0,0,,Adakah anda menemuinya?
Dialog: 0,0:46:45.79,0:46:49.21,teks umum,,0,0,0,,Saya mencari siang dan malam, mendapatinya tidak lama dahulu
Dialog: 0,0:46:53.84,0:46:55.26,teks umum,,0,0,0,,Anda telah membuangnya
Dialog: 0,0:46:55.93,0:46:58.51,teks umum,,0,0,0,,Dan saya mengambilnya, yang bermaksud ia milik saya lagi
Dialog: 0,0:47:02.89,0:47:05.27,teks umum,,0,0,0,,Kasim Oh, kamu boleh keluar dari sana
Dialog: 0,0:47:06.60,0:47:07.90,teks umum,,0,0,0,,Ya
Dialog: 0,0:47:11.07,0:47:14.32,teks umum,,0,0,0,,Terima kasih kepada anda, saya mendapat sesuatu yang berharga
Dialog: 0,0:47:14.90,0:47:18.07,teks umum,,0,0,0,,Saya memilikinya sekali lagi terima kasih kepada anda
Dialog: 0,0:47:19.66,0:47:20.70,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:47:20.78,0:47:24.75,teks umum,,0,0,0,,Saya tidak memecahkannya, tidak membuangnya jauh
Dialog: 0,0:47:24.83,0:47:27.33,teks umum,,0,0,0,,Anda dapati kerana saya melemparkannya rapat
Dialog: 0,0:47:27.42,0:47:32.92,teks umum,,0,0,0,,Saya berani cuba memahami Tuanku.
Dialog: 0,0:47:33.00,0:47:36.13,teks umum,,0,0,0,,Anda membuat alasan dan marah kerana
Dialog: 0,0:47:36.22,0:47:38.26,teks umum,,0,0,0,,apa yang anda minta maaf?
Dialog: 0,0:47:38.89,0:47:41.85,teks umum,,0,0,0,,Von Moo Deok hanya perlu mendengar tanpa cuba memahami
Dialog: 0,0:47:41.93,0:47:43.72,teks umum,,0,0,0,,Beraninya anda mencuba?
Dialog: 0,0:47:43.81,0:47:45.77,teks umum,,0,0,0,,Maaf, Yang Amat Mulia
Dialog: 0,0:47:49.06,0:47:50.15,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:47:53.94,0:47:55.07,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:47:55.15,0:47:58.82,teks umum,,0,0,0,,Cikgu Ho meminta saya memberitahu anda bahawa Cikgu Li telah tiba
Dialog: 0,0:47:58.91,0:48:01.07,teks umum,,0,0,0,,Baiklah. Adakah dia di Saejukwon?
Dialog: 0,0:48:01.16,0:48:04.62,teks umum,,0,0,0,,Ya. Pelajarnya Chang Wook ada bersamanya
Dialog: 0,0:48:06.41,0:48:08.83,teks umum,,0,0,0,,Mereka mengatakan Chan Wook telah mencapai kejayaan sedemikian
Dialog: 0,0:48:08.92,0:48:10.83,teks umum,,0,0,0,,terima kasih atas arahan Cikgu Li
Dialog: 0,0:48:10.92,0:48:12.67,teks umum,,0,0,0,,Jika bukan kerana ini,
Dialog: 0,0:48:12.75,0:48:14.88,teks umum,,0,0,0,,dia tidak akan mengalahkan kamu
Dialog: 0,0:48:17.88,0:48:18.84,teks umum,,0,0,0,,Jom
Dialog: 0,0:48:30.94,0:48:33.44,teks umum,,0,0,0,,Anda sekarang layan Seo Yul, bukan Chan Wook
Dialog: 0,0:48:34.07,0:48:36.48,teks umum,,0,0,0,,Jika saya telah mengalahkan Chang Wook,
Dialog: 0,0:48:36.57,0:48:38.28,teks umum,,0,0,0,,bolehkah awak layan saya
Dialog: 0,0:48:38.36,0:48:40.15,teks umum,,0,0,0,,Jika anda tidak menolak pertarungan itu,
Dialog: 0,0:48:40.86,0:48:43.87,teks umum,,0,0,0,,anda tidak perlu layan saya
Dialog: 0,0:48:43.95,0:48:46.66,teks umum,,0,0,0,,Saya akan biarkan dia menang kerana kasihan
Dialog: 0,0:48:47.25,0:48:48.66,teks umum,,0,0,0,,Awak tak kasihankan dia?
Dialog: 0,0:48:48.75,0:48:50.41,teks umum,,0,0,0,,Semua orang di Sosnovy Bor tahu,
Dialog: 0,0:48:50.50,0:48:52.75,teks umum,,0,0,0,,bahawa Chan Wook mengamalkan kesucian
Dialog: 0,0:48:53.33,0:48:55.17,teks umum,,0,0,0,,- Adakah begitu?\N- Jangan pura-pura tidak tahu
Dialog: 0,0:48:55.25,0:48:56.55,teks umum,,0,0,0,,Anda lebih tahu daripada sesiapa
Dialog: 0,0:48:57.13,0:48:59.17,teks umum,,0,0,0,,Anda tidak membawanya kepadanya
Dialog: 0,0:48:59.76,0:49:01.18,teks umum,,0,0,0,,teh kesucian?
Dialog: 0,0:49:01.26,0:49:02.43,teks umum,,0,0,0,,Saya tidak pernah melakukan ini
Dialog: 0,0:49:02.51,0:49:05.60,teks umum,,0,0,0,,Bagaimana lagi dia menguasai Chisa dengan begitu cepat?
Dialog: 0,0:49:06.97,0:49:08.98,teks umum,,0,0,0,,Dia bukan anak kepada Chang Gan
Dialog: 0,0:49:10.31,0:49:14.02,teks umum,,0,0,0,,Ibunya berkahwin dengan Chang Gan dan melahirkan seorang anak lelaki
Dialog: 0,0:49:14.73,0:49:17.36,teks umum,,0,0,0,,Dan kini anaknya akan mewarisi segala-galanya
Dialog: 0,0:49:18.69,0:49:22.49,teks umum,,0,0,0,,Ayahnya menutup pintu pagar untuk menamatkan talian Uka
Dialog: 0,0:49:22.57,0:49:25.53,teks umum,,0,0,0,,Tetapi Chan Wook membukanya, dia sepatutnya suci
Dialog: 0,0:49:26.45,0:49:27.54,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:49:28.83,0:49:32.04,teks umum,,0,0,0,,Licik dan jahat
Dialog: 0,0:49:32.62,0:49:33.46,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:35.00,0:49:36.25,teks umum,,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:49:37.50,0:49:40.17,teks umum,,0,0,0,,- Awak dengar\N- Beraninya awak?
Dialog: 0,0:49:40.67,0:49:43.22,teks umum,,0,0,0,,- Ulang\N- Kemudian awak akan pukul saya
Dialog: 0,0:49:43.30,0:49:44.55,teks umum,,0,0,0,,Kemudian beritahu saya!
Dialog: 0,0:49:46.93,0:49:48.18,miring,,0,0,0,,Beritahu mereka
Dialog: 0,0:49:58.48,0:49:59.69,teks umum,,0,0,0,,Jika mereka mendengar,
Dialog: 0,0:49:59.78,0:50:03.57,teks umum,,0,0,0,,sebut dengan kuat dan jelas
Dialog: 0,0:50:09.37,0:50:12.46,teks umum,,0,0,0,,Anda keji dan jahat
Dialog: 0,0:50:14.50,0:50:17.04,teks umum,,0,0,0,,Itulah yang dia katakan. faham?
Dialog: 0,0:50:17.67,0:50:18.50,teks umum,,0,0,0,,Ya
Dialog: 0,0:50:19.59,0:50:22.34,teks umum,,0,0,0,,Moo Dok, saya beri awak sesuatu
Dialog: 0,0:50:22.42,0:50:23.59,teks umum,,0,0,0,,Tunjukkan kepada mereka
Dialog: 0,0:50:30.47,0:50:32.23,teks umum,,0,0,0,,Uncang ini adalah hadiah saya
Dialog: 0,0:50:32.31,0:50:36.44,teks umum,,0,0,0,,Jika seseorang memukul, memarahi atau menghina anda apabila saya tiada,
Dialog: 0,0:50:36.52,0:50:38.31,teks umum,,0,0,0,,beritahu saya sahaja
Dialog: 0,0:50:39.57,0:50:40.52,teks umum,,0,0,0,,Ya
Dialog: 0,0:50:42.61,0:50:43.86,teks umum,,0,0,0,,Anda boleh pergi
Dialog: 0,0:50:53.08,0:50:55.62,teks umum,,0,0,0,,Bodoh untuk membuat musuh
Dialog: 0,0:50:55.71,0:50:59.29,teks umum,,0,0,0,, kerana iri hati bahawa seseorang lebih kuat
Dialog: 0,0:51:08.72,0:51:10.39,teks umum,,0,0,0,,Anda mempunyai dakwat pada pakaian anda
Dialog: 0,0:51:11.06,0:51:13.77,teks umum,,0,0,0,,Mereka boleh dibiakkan dengan nasi putih
Dialog: 0,0:51:15.02,0:51:17.10,teks umum,,0,0,0,,Ini adalah dua warna yang sama sekali berbeza
Dialog: 0,0:51:17.94,0:51:20.56,teks umum,,0,0,0,,Tetapi bersama-sama mereka boleh menghilangkan noda
Dialog: 0,0:51:21.19,0:51:22.69,teks umum,,0,0,0,,Kata-kata hikmat
Dialog: 0,0:51:23.44,0:51:25.86,teks umum,,0,0,0,,Di manakah anda membacanya, Yang Amat Mulia?
Dialog: 0,0:51:27.32,0:51:28.74,teks umum,,0,0,0,,Sana sini
Dialog: 0,0:51:28.82,0:51:31.08,teks umum,,0,0,0,,Ini hanya ditanya dalam peperiksaan yang paling sukar
Dialog: 0,0:51:45.55,0:51:47.43,teks umum,,0,0,0,,Tuan saya tiada di sini?
Dialog: 0,0:51:50.85,0:51:53.72,teks umum,,0,0,0,,Saya dengar awak cedera. awak okay tak?
Dialog: 0,0:51:54.31,0:51:57.27,teks umum,,0,0,0,,Ya, terima kasih kepada anda. Terima kasih untuk ubat-ubatan itu
Dialog: 0,0:51:59.27,0:52:03.36,teks umum,,0,0,0,,Maid Kim menjemput saya makan malam
Dialog: 0,0:52:04.69,0:52:07.78,teks umum,,0,0,0,,Mungkin anda akan menyertai kami?
Dialog: 0,0:52:08.74,0:52:09.66,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:52:11.78,0:52:14.70,teks umum,,0,0,0,, Kemudian saya akan memilih hari dan memberitahu Moo Deok
Dialog: 0,0:52:15.58,0:52:17.08,teks umum,,0,0,0,,Awak kenal pembantu rumah saya?
Dialog: 0,0:52:17.16,0:52:20.21,teks umum,,0,0,0,,Saya pernah datang berjumpa awak,
Dialog: 0,0:52:20.29,0:52:21.92,teks umum,,0,0,0,,tetapi ia tidak berkesan untuk saya
Dialog: 0,0:52:22.71,0:52:25.25,teks umum,,0,0,0,,Dia masuk ke bilik awak kemudian
Dialog: 0,0:52:30.97,0:52:32.14,kenangan,,0,0,0,,Jangan pergi
Dialog: 0,0:52:33.35,0:52:35.14,kenangan,,0,0,0,,Jangan pergi ke tempat anda, tinggal di sini
Dialog: 0,0:52:36.10,0:52:37.89,kenangan,,0,0,0,,Saya akan bawa baju awak
Dialog: 0,0:52:39.98,0:52:41.02,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:52:41.90,0:52:43.23,teks umum,,0,0,0,,Selangkah ke arah?
Dialog: 0,0:52:43.77,0:52:45.32,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:52:47.23,0:52:48.36,teks umum,,0,0,0,,Ya begitu
Dialog: 0,0:52:55.49,0:52:56.49,teks umum,,0,0,0,,Sekejap
Dialog: 0,0:52:57.75,0:52:59.79,teks umum,,0,0,0,,Tenang
Dialog: 0,0:53:00.75,0:53:01.92,teks umum,,0,0,0,,Terbang pergi
Dialog: 0,0:53:02.71,0:53:04.09,teks umum,,0,0,0,,- Betulkah?\N- Ya
Dialog: 0,0:53:06.21,0:53:08.13,contact,,0,0,0,,Saya sangat takut
Dialog: 0,0:53:21.19,0:53:22.31,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:53:38.62,0:53:40.96,teks umum,,0,0,0,,Moo Dok, kita jumpa lagi
Dialog: 0,0:53:44.38,0:53:46.25,teks umum,,0,0,0,,Jaga diri anda
Dialog: 0,0:53:46.34,0:53:47.67,teks umum,,0,0,0,,Jumpa di istana
Dialog: 0,0:53:47.75,0:53:49.09,teks umum,,0,0,0,,Ya
Dialog: 0,0:54:02.64,0:54:04.27,teks umum,,0,0,0,,Apakah itu? Awak lari ke sini?
Dialog: 0,0:54:05.19,0:54:06.11,teks umum,,0,0,0,,Ya
Dialog: 0,0:54:06.19,0:54:08.86,teks umum,,0,0,0,,Sudah lama awak tidak melawat saya semasa saya cedera
Dialog: 0,0:54:08.94,0:54:09.78,teks umum,,0,0,0,,Ada apa?
Dialog: 0,0:54:09.86,0:54:12.15,teks umum,,0,0,0,,Sesuatu yang lebih serius daripada pertukaran pemilik?
Dialog: 0,0:54:12.24,0:54:13.20,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:13.28,0:54:15.24,teks umum,,0,0,0,,Ahli silap mata lain sedang bergosip tentang anda
Dialog: 0,0:54:15.32,0:54:16.49,teks umum,,0,0,0,,Saya ingin tahu kebenaran
Dialog: 0,0:54:16.57,0:54:18.91,teks umum,,0,0,0,,Faham. Pernahkah anda mendengar tentang teh itu?
Dialog: 0,0:54:18.99,0:54:20.74,teks umum,,0,0,0,,Tetapi anda tahu kebenarannya
Dialog: 0,0:54:20.83,0:54:24.12,teks umum,,0,0,0,,Bagaimana jika? Anda menangkap Ikan Emas semasa saya tiada
Dialog: 0,0:54:24.87,0:54:27.04,teks umum,,0,0,0,,Mungkin anda benar-benar menjadi pelajar Master Li
Dialog: 0,0:54:27.13,0:54:29.25,teks umum,,0,0,0,,Apa? Tidak, sudah tentu
Dialog: 0,0:54:29.34,0:54:30.38,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:54:30.46,0:54:32.47,teks umum,,0,0,0,,Saya sendiri yang mencadangkannya kepada anda
Dialog: 0,0:54:33.26,0:54:34.88,teks umum,,0,0,0,,Mungkin tidak dapat menahan
Dialog: 0,0:54:34.97,0:54:36.84,teks umum,,0,0,0,,Bagaimana saya boleh membuktikannya kepada anda?
Dialog: 0,0:54:38.01,0:54:39.35,teks umum,,0,0,0,,Anda sendiri yang mengatakannya
Dialog: 0,0:54:49.15,0:54:50.15,teks umum,,0,0,0,,Nampak?
Dialog: 0,0:54:52.65,0:54:54.07,teks umum,,0,0,0,,Anda tidak nampak seorang wanita dalam diri saya
Dialog: 0,0:54:54.15,0:54:57.20,teks umum,,0,0,0,,Saya sepatutnya memeluk gadis manis itu sebagai bukti
Dialog: 0,0:54:58.57,0:55:00.62,teks umum,,0,0,0,, Patutkah saya benar-benar memeluknya?
Dialog: 0,0:55:01.83,0:55:03.87,teks umum,,0,0,0,,Ya. Ayuh
Dialog: 0,0:55:03.95,0:55:05.62,teks umum,,0,0,0,,Jangan ubah fikiran nanti
Dialog: 0,0:55:05.71,0:55:07.08,teks umum,,0,0,0,,Baiklah, pergi!
Dialog: 0,0:55:42.33,0:55:43.99,teks umum,,0,0,0,,Anda kata kami perlu menyerang,
Dialog: 0,0:55:44.08,0:55:46.46,teks umum,,0,0,0,,apabila musuh paling tidak menjangkakannya
Dialog: 0,0:55:47.62,0:55:51.00,teks umum,,0,0,0,,saya ikut nasihat cikgu
Dialog: 0,0:55:53.80,0:55:56.59,teks umum,,0,0,0,,Ya. Syabas. Saya bangga dengan awak
Dialog: 0,0:55:58.84,0:56:00.01,teks umum,,0,0,0,,By the way, cikgu,
Dialog: 0,0:56:00.64,0:56:04.31,teks umum,,0,0,0,,Saya dengar awak terserempak dengan dia dalam bilik saya
Dialog: 0,0:56:06.48,0:56:07.56,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:56:07.64,0:56:09.35,teks umum,,0,0,0,,Itukah sebabnya awak menghalang saya ketika itu?
Dialog: 0,0:56:13.15,0:56:14.69,teks umum,,0,0,0,,Adakah ini benar-benar berlaku?
Dialog: 0,0:56:15.53,0:56:17.03,teks umum,,0,0,0,,Saya tidak ingat
Dialog: 0,0:56:17.74,0:56:19.82,teks umum,,0,0,0,,Memahami anda lebih sukar daripada mengawal anda
Dialog: 0,0:56:19.91,0:56:21.28,teks umum,,0,0,0,,tenaga Gyeongcheongdaeho
Dialog: 0,0:56:22.74,0:56:24.49,teks umum,,0,0,0,,Anda menghalang saya
Dialog: 0,0:56:27.00,0:56:29.50,teks umum,,0,0,0,,Cikgu, saya akan pergi ke istana hari ini
Dialog: 0,0:56:29.58,0:56:31.46,teks umum,,0,0,0,,Raja menjemput Tuan Li,
Dialog: 0,0:56:32.08,0:56:34.17,teks umum,,0,0,0,, dan saya akan menemaninya
Dialog: 0,0:56:34.25,0:56:36.88,teks umum,,0,0,0,,Saya mahu berjumpa dengan permaisuri, dan sekarang saya mendapat peluang
Dialog: 0,0:56:37.63,0:56:39.17,teks umum,,0,0,0,,Berhati-hati
Dialog: 0,0:56:40.47,0:56:43.30,teks umum,,0,0,0,,Saya akan. Saya akan memberitahu anda segala-galanya apabila saya kembali
Dialog: 0,0:56:51.27,0:56:52.31,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:56:56.61,0:56:57.90,teks umum,,0,0,0,,saya jumpa
Dialog: 0,0:56:59.65,0:57:03.66,teks umum,,0,0,0,,Ia berlaku, jadi saya fikir saya harus memberitahu anda
Dialog: 0,0:57:05.91,0:57:06.91,teks umum,,0,0,0,,Go
Dialog: 0,0:57:26.26,0:57:28.60,teks umum,,0,0,0,,Mengapa ketua Sosnovy Bor mencari saya?
Dialog: 0,0:57:29.64,0:57:31.73,teks umum,,0,0,0,,- Ingat Moo Dok?\N- Ya
Dialog: 0,0:57:31.81,0:57:34.81,teks umum,,0,0,0,,Dia ingin mengetahui lebih lanjut tentang kehidupannya di Sari
Dialog: 0,0:57:34.90,0:57:38.15,teks umum,,0,0,0,,Dia boleh bertanya sendiri
Dialog: 0,0:57:38.23,0:57:39.19,teks umum,,0,0,0,,Dia ada di sini
Dialog: 0,0:57:39.28,0:57:41.74,teks umum,,0,0,0,,No. Dia berada di Sosnovy Bor
Dialog: 0,0:57:41.82,0:57:42.95,teks umum,,0,0,0,,Ya?
Dialog: 0,0:57:43.74,0:57:46.58,teks umum,,0,0,0,,Apa yang wanita buta itu lakukan di sana?
Dialog: 0,0:57:48.87,0:57:51.41,teks umum,,0,0,0,,Cikgu Lee mahu kamu berdua dan Chan Wook
Dialog: 0,0:57:51.50,0:57:53.33,teks umum,,0,0,0,,mengiringnya ke istana
Dialog: 0,0:57:54.50,0:57:55.83,teks umum,,0,0,0,,Adakah Uk juga berfungsi?
Dialog: 0,0:57:57.34,0:57:58.46,teks umum,,0,0,0,,Adakah dia sudah berasa lebih baik?
Dialog: 0,0:57:58.55,0:58:00.42,teks umum,,0,0,0,,Kami akan pergi tidak lama lagi. Bersedialah
Dialog: 0,0:58:08.72,0:58:11.39,teks umum,,0,0,0,,Berhati-hati di dalam istana
Dialog: 0,0:58:11.48,0:58:13.85,teks umum,,0,0,0,,Ada batu ais
Dialog: 0,0:58:15.52,0:58:17.11,teks umum,,0,0,0,,Saya sendiri tahu
Dialog: 0,0:58:17.19,0:58:20.36,teks umum,,0,0,0,,Oleh kerana mereka tanpa segan silu menyembunyikannya,
Dialog: 0,0:58:20.44,0:58:23.40,teks umum,,0,0,0,,Saya memutuskan untuk bertindak dengan berani
Dialog: 0,0:58:28.99,0:58:31.58,teks umum,,0,0,0,,Bila kali terakhir saya dijemput ke istana,
Dialog: 0,0:58:32.16,0:58:34.58,teks umum,,0,0,0,,anda sangat kecil
Dialog: 0,0:58:35.12,0:58:38.13,teks umum,,0,0,0,,Saya masih ingat betapa saya suka gula-gula,
Dialog: 0,0:58:38.21,0:58:40.50,teks umum,,0,0,0,,yang kemudian anda bawa
Dialog: 0,0:58:40.59,0:58:41.76,teks umum,,0,0,0,,By the way,
Dialog: 0,0:58:42.34,0:58:45.97,teks umum,,0,0,0,,takkan kamu beri hadiah kepada raja?
Dialog: 0,0:58:46.05,0:58:48.01,teks umum,,0,0,0,,Saya sudah sediakan satu
Dialog: 0,0:58:48.10,0:58:48.97,teks umum,,0,0,0,,Yom
Dialog: 0,0:58:49.05,0:58:51.89,teks umum,,0,0,0,,Hantar hadiah kepada istana pada masa yang ditetapkan
Dialog: 0,0:58:51.97,0:58:53.52,italic,,0,0,0,,Ya, cikgu
Dialog: 0,0:58:53.60,0:58:55.19,teks umum,,0,0,0,,Di suatu tempat antara 5 dan 7 petang?
Dialog: 0,0:58:55.27,0:58:56.69,teks umum,,0,0,0,,Antara 7 dan 9, bodoh!
Dialog: 0,0:58:57.27,0:58:59.02,teks umum,,0,0,0,,Tepat sekali. Maaf
Dialog: 0,0:58:59.73,0:59:01.73,teks umum,,0,0,0,,Tuliskannya jika anda tidak ingat
Dialog: 0,0:59:02.65,0:59:04.15,teks umum,,0,0,0,,Anda tidak berfikiran sebelum ini,
Dialog: 0,0:59:04.24,0:59:07.16,teks umum,,0,0,0,,dan dengan usia segala-galanya menjadi lebih teruk
Dialog: 0,0:59:09.45,0:59:10.58,teks umum,,0,0,0,,Maju
Dialog: 0,0:59:11.08,0:59:12.75,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,0:59:13.95,0:59:16.62,teks umum,,0,0,0,,Saya tidak akan biasa dengan ini, kawan-kawan
Dialog: 0,0:59:45.24,0:59:46.36,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:59:47.99,0:59:49.87,teks umum,,0,0,0,,Kepala ingin berjumpa dengan anda
Dialog: 0,0:59:51.33,0:59:52.53,teks umum,,0,0,0,,Bab?
Dialog: 0,1:00:01.42,1:00:02.42,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:00:15.64,1:00:20.15,teks umum,,0,0,0,,Semua tentang anda telah terbongkar
Dialog: 0,1:00:21.11,1:00:24.69,teks umum,,0,0,0,,Saya beritahu dia tentang mata awak
Dialog: 0,1:00:29.28,1:00:30.82,di sebalik tabir,,0,0,0,,Sekarang semuanya akan terbuka?
Dialog: 0,1:00:32.45,1:00:35.12,teks umum,,0,0,0,,Bab, anda lihat...
Dialog: 0,1:00:36.70,1:00:39.12,teks umum,,0,0,0,,Bukan dia seorang sahaja yang berbohong
Dialog: 0,1:00:40.46,1:00:44.13,teks umum,,0,0,0,,Neneknya merayu kepada saya, jadi saya bermain bersama
Dialog: 0,1:00:44.92,1:00:48.30,teks umum,,0,0,0,,Keluarganya sangat miskin
Dialog: 0,1:00:48.38,1:00:50.30,teks umum,,0,0,0,,Dia berbohong bahawa dia buta,
Dialog: 0,1:00:50.88,1:00:53.35,teks umum,,0,0,0,,supaya dia tidak dijual untuk membayar hutang
Dialog: 0,1:00:53.43,1:00:55.64,teks umum,,0,0,0,,Seperti mereka yang berpura-pura tempang,
Dialog: 0,1:00:55.72,1:00:57.68,teks umum,,0,0,0,,supaya tidak berperang
Dialog: 0,1:00:57.77,1:01:01.56,teks umum,,0,0,0,,Mengapa anda berbohong apabila anda sampai ke Chwisongra?
Dialog: 0,1:01:04.11,1:01:06.61,contact,,0,0,0,,Dia mahu melarikan diri
Dialog: 0,1:01:07.28,1:01:09.11,teks umum,,0,0,0,,Sudah tentu, ia telah dijual
Dialog: 0,1:01:09.19,1:01:12.66,teks umum,,0,0,0,,Tetapi menjadi buta lebih mudah untuk melarikan diri
Dialog: 0,1:01:13.28,1:01:15.62,teks umum,,0,0,0,,- Betulkah saya?\N- Ya
Dialog: 0,1:01:15.70,1:01:18.66,teks umum,,0,0,0,,Saya cuba melarikan diri apabila saya bertemu pemiliknya
Dialog: 0,1:01:19.37,1:01:22.04,teks umum,,0,0,0,,Dia mengasihani saya dan menerima saya
Dialog: 0,1:01:24.92,1:01:27.09,teks umum,,0,0,0,,Maaf kerana menipu, bab
Dialog: 0,1:01:28.30,1:01:29.55,teks umum,,0,0,0,,saya buat salah
Dialog: 0,1:01:30.88,1:01:32.34,teks umum,,0,0,0,,Kecuali pembohongan ini,
Dialog: 0,1:01:32.43,1:01:34.26,teks umum,,0,0,0,,dia tiada dosa lain
Dialog: 0,1:01:34.34,1:01:38.06,teks umum,,0,0,0,,Dia sentiasa cucu yang baik dan seorang gadis yang baik hati
Dialog: 0,1:01:49.82,1:01:51.99,teks umum,,0,0,0,,Kenapa awak berbohong?
Dialog: 0,1:01:53.07,1:01:56.03,teks umum,,0,0,0,,Baru dapat duit saya
Dialog: 0,1:01:56.62,1:01:57.91,teks umum,,0,0,0,,Adakah anda memperoleh wang itu?
Dialog: 0,1:02:00.66,1:02:03.00,teks umum,,0,0,0,,Bukankah kamu buta?
Dialog: 0,1:02:06.21,1:02:07.09,teks umum,,0,0,0,,Nah, ya
Dialog: 0,1:02:07.17,1:02:10.63,teks umum,,0,0,0,,Ia sentiasa kelihatan pelik kepada saya
Dialog: 0,1:02:11.63,1:02:13.76,teks umum,,0,0,0,,- Apa?\N- Walaupun buta,
Dialog: 0,1:02:13.84,1:02:16.09,teks umum,,0,0,0,,anda sentiasa tahu siapa yang berdiri di hadapan anda
Dialog: 0,1:02:16.18,1:02:18.22,teks umum,,0,0,0,,Tahu jika hujan atau salji
Dialog: 0,1:02:18.81,1:02:23.31,teks umum,,0,0,0,,Penduduk kampung menyangka anda berbohong tentang buta
Dialog: 0,1:02:23.39,1:02:26.31,teks umum,,0,0,0,,Mereka takut dan mengelak anda
Dialog: 0,1:02:27.48,1:02:29.15,teks umum,,0,0,0,,- Saya nampak\N- Secara umum,
Dialog: 0,1:02:29.23,1:02:31.69,teks umum,,0,0,0,,jika anda perlukan bantuan, datang ke rumah penginapan
Dialog: 0,1:02:31.78,1:02:32.82,teks umum,,0,0,0,,Okay?
Dialog: 0,1:02:33.57,1:02:34.49,teks umum,,0,0,0,,By the way
Dialog: 0,1:02:35.03,1:02:37.32,teks umum,,0,0,0,,Awak dah jumpa So Yi belum?
Dialog: 0,1:02:38.41,1:02:39.58,teks umum,,0,0,0,,Jadi saya?
Dialog: 0,1:02:39.66,1:02:41.66,teks umum,,0,0,0,,Dia kini berada di ibu negara
Dialog: 0,1:02:41.75,1:02:43.54,teks umum,,0,0,0,,Beberapa penyamun sedang mencarinya
Dialog: 0,1:02:43.62,1:02:46.04,teks umum,,0,0,0,,Apa yang dia buat kali ini?
Dialog: 0,1:02:46.12,1:02:49.42,teks umum,,0,0,0,,Dia merompak rumah awak selepas nenek awak meninggal
Dialog: 0,1:02:50.25,1:02:52.38,teks umum,,0,0,0,,Jangan main-main dengan dia
Dialog: 0,1:02:52.46,1:02:55.05,teks umum,,0,0,0,,Nampaknya anda menyembunyikan sesuatu daripada Sosnovy Bor
Dialog: 0,1:02:56.43,1:02:59.64,teks umum,,0,0,0,,Anda berkata bahawa anda telah menggunakan wang itu. Siapa yang bayar awak?
Dialog: 0,1:02:59.72,1:03:00.81,teks umum,,0,0,0,,Ju Wol
Dialog: 0,1:03:05.73,1:03:07.23,teks umum,,0,0,0,,Jangan berterima kasih kepada saya
Dialog: 0,1:03:07.73,1:03:09.77,teks umum,,0,0,0,,Itu duit Encik Chan
Dialog: 0,1:03:14.24,1:03:19.12,kenangan,,0,0,0,,Jika ada yang bertanya tentang Moo Deok,
Dialog: 0,1:03:19.20,1:03:20.33,kenangan,,0,0,0,,gunakan wang ini
Dialog: 0,1:03:21.49,1:03:24.08,kenangan,,0,0,0,,Sudah tentu separuh milik anda
Dialog: 0,1:03:24.75,1:03:27.67,teks umum,,0,0,0,,Saya tidak menyembunyikan apa-apa yang keji
Dialog: 0,1:03:27.75,1:03:29.67,teks umum,,0,0,0,,Dapat bahagian saya
Dialog: 0,1:03:30.75,1:03:32.55,teks umum,,0,0,0,,Ya, dan saya suka awak
Dialog: 0,1:03:33.55,1:03:35.22,teks umum,,0,0,0,,Saya amat bersyukur
Dialog: 0,1:03:35.30,1:03:38.01,teks umum,,0,0,0,,Apa yang salah dengan mata anda?
Dialog: 0,1:03:43.06,1:03:44.18,teks umum,,0,0,0,,Lupakan
Dialog: 0,1:03:44.27,1:03:45.98,teks umum,,0,0,0,,Mungkin ada sebabnya
Dialog: 0,1:03:50.52,1:03:54.86,di sebalik tabir,,0,0,0,,Jika Chang Wook tidak membuat persediaan awal, Park Jin akan mengetahui segala-galanya
Dialog: 0,1:03:55.49,1:03:59.76,suara,,0,0,0,,Jika mereka menangkap saya, Chan Wook akan menderita juga
Dialog: 0,1:04:13.34,1:04:15.26,teks umum,,0,0,0,,Selamat Datang Cikgu Lee Chul
Dialog: 0,1:04:16.17,1:04:18.47,teks umum,,0,0,0,,Terima kasih atas jemputan, Yang Mulia
Dialog: 0,1:04:20.72,1:04:22.64,kenangan,,0,0,0,,Bomoh Choi ini
Dialog: 0,1:04:23.22,1:04:25.18,kenangan,,0,0,0,,suruh awak bunuh saya?
Dialog: 0,1:04:28.44,1:04:30.65,di sebalik tabir,,0,0,0,,Shaman Choi
Dialog: 0,1:04:30.73,1:04:32.48,suara,,0,0,0,,Adakah ini permaisuri?
Dialog: 0,1:04:38.78,1:04:39.82,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:04:43.28,1:04:45.08,teks umum,,0,0,0,,Jadi saya, yang anda sebutkan
Dialog: 0,1:04:45.70,1:04:48.33,teks umum,,0,0,0,,Mungkin ini gadis yang mencari anda baru-baru ini
Dialog: 0,1:04:49.58,1:04:51.71,teks umum,,0,0,0,,Saya dengar dia berbahaya. Berhati-hati
Dialog: 0,1:04:55.13,1:04:58.05,di sebalik tabir,,0,0,0,,Saya tidak mengenalinya kerana saya tidak mengenalinya
Dialog: 0,1:04:58.59,1:05:00.84,di sebalik tabir,,0,0,0,,Tanya lelaki itu tentang dia?
Dialog: 0,1:05:01.39,1:05:04.10,kenangan,,0,0,0,,Jika anda perlukan bantuan, datang ke rumah penginapan
Dialog: 0,1:05:05.22,1:05:06.77,teks umum,,0,0,0,,Inn...
Dialog: 0,1:05:13.36,1:05:17.15,kenangan miring,,0,0,0,,Semua tentang awak terungkap
Dialog: 0,1:05:36.17,1:05:38.55,teks umum,,0,0,0,,Pedagang Kim dari Kampung Sari ada di sini?
Dialog: 0,1:05:38.63,1:05:40.47,teks umum,,0,0,0,,Ya, dia ada di sini
Dialog: 0,1:05:40.97,1:05:42.55,teks umum,,0,0,0,,Bilik terakhir di tingkat dua
Dialog: 0,1:05:48.35,1:05:51.64,teks umum,,0,0,0,,Ajusshi, ini Moo Deok
Dialog: 0,1:06:18.38,1:06:19.38,di sebalik tabir,,0,0,0,,Ajusshi...
Dialog: 0,1:06:32.27,1:06:33.73,contact,,0,0,0,,Cikgu Li
Dialog: 0,1:06:33.81,1:06:36.61,teks umum,,0,0,0,,Jika anda pelajar Master So Kyung,
Dialog: 0,1:06:36.69,1:06:38.73,teks umum,,0,0,0,,kini anda berumur lebih seratus tahun
Dialog: 0,1:06:38.82,1:06:41.44,teks umum,,0,0,0,,Bagaimana anda bertahan seperti ini?
Dialog: 0,1:06:42.03,1:06:45.16,teks umum,,0,0,0,,Berapa tahun yang anda akan berikan kepada saya?
Dialog: 0,1:06:46.36,1:06:48.87,miring,,0,0,0,,Lebih tiga puluh
Dialog: 0,1:06:48.95,1:06:51.58,teks umum,,0,0,0,,Maksimum empat puluh tahun
Dialog: 0,1:06:52.41,1:06:56.08,teks umum,,0,0,0,,Anda betul. Ini adalah usia biologi saya
Dialog: 0,1:06:57.00,1:06:57.96,teks umum,,0,0,0,,Apa?
Dialog: 0,1:06:58.04,1:07:00.84,teks umum,,0,0,0,,Jiwa saya berumur seratus tahun
Dialog: 0,1:07:01.42,1:07:04.42,teks umum,,0,0,0,,Badan yang saya lahirkan telah lama bertukar menjadi debu
Dialog: 0,1:07:04.51,1:07:07.18,teks umum,,0,0,0,,Badan ini bukan milik saya
Dialog: 0,1:07:09.39,1:07:10.26,miring,,0,0,0,,Tunggu
Dialog: 0,1:07:11.01,1:07:13.77,teks umum,,0,0,0,,Jadi anda seorang nomad?
Dialog: 0,1:07:13.85,1:07:14.85,teks umum,,0,0,0,,Ya
Dialog: 0,1:07:15.89,1:07:18.27,teks umum,,0,0,0,,Saya seorang nomad
Dialog: 0,1:07:26.95,1:07:28.24,teks umum,,0,0,0,,Yang Mulia,
Dialog: 0,1:07:28.32,1:07:32.45,teks umum,,0,0,0,, awak telefon saya untuk cari nomad lain?
Dialog: 0,1:07:33.04,1:07:34.20,teks umum,,0,0,0,,Saya akan cari dia
Dialog: 0,1:07:34.87,1:07:38.17,teks umum,,0,0,0,,Saya boleh tahu siapa nomad
Dialog: 0,1:07:49.51,1:07:53.56,suara,,0,0,0,,Dia tahu sejak awal lagi bahawa Moo Deok seorang perantau
Dialog: 0,1:08:18.71,1:08:19.58,teks umum,,0,0,0,,Itu awak
Dialog: 0,1:08:20.79,1:08:22.38,teks umum,,0,0,0,,membunuhnya
Dialog: 0,1:09:04.92,1:09:06.55,pratonton,,0,0,0,,Kenapa banyak mayat di sini?
Dialog: 0,1:09:06.63,1:09:09.05,pratonton,,0,0,0,,Apakah jenis kehidupan yang dijalani Moo Deok?
Dialog: 0,1:09:09.13,1:09:11.93,pratonton,,0,0,0,,Moo Dok sedang menyembunyikan sesuatu
Dialog: 0,1:09:12.01,1:09:14.80,pratonton,,0,0,0,,- Apa yang tidak boleh didedahkan\N- Mommies!
Dialog: 0,1:09:15.68,1:09:17.64,pratonton,,0,0,0,,Dia akan mula menyalak
Dialog: 0,1:09:18.39,1:09:22.10,pratonton,,0,0,0,,Seperti yang saya sangka, terdapat lebih daripada satu perantau di istana
Dialog: 0,1:09:22.19,1:09:24.69,pratonton,,0,0,0,,Jika ternyata bintang Raja adalah ciptaan sihir gelap,
Dialog: 0,1:09:24.77,1:09:27.19,pratonton,,0,0,0,,Hutan Pine akan berakhir
Dialog: 0,1:09:27.73,1:09:28.57,pratonton,,0,0,0,,Ini berbahaya
Dialog: 0,1:09:28.65,1:09:31.24,pratonton,,0,0,0,,Anda tidak mengenalinya, tetapi dia mengenali Moo Deok
Dialog: 0,1:09:31.32,1:09:32.49,pratonton,,0,0,0,,Kami perlukan Geng Chang
Dialog: 0,1:09:32.57,1:09:35.08,pratonton,,0,0,0,,Kami akan menunggu kepulangannya
Dialog: 0,1:09:36.37,1:09:37.95,pratonton,,0,0,0,,Moo Dok, kenapa awak ada di sini?
Dialog: 0,1:09:38.04,1:09:40.25,pratonton,,0,0,0,,Saya tidak boleh meninggalkan tuan saya
Dialog: 0,1:09:40.33,1:09:43.50,pratonton,,0,0,0,,Cintailah saya sehingga awak mati
Dialog: 0,0:23:37.32,0:23:39.32,pratonton,,0,0,0,,

