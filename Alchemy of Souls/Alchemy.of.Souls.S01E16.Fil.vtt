Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Mga tagasalin ng Typesetter:{\c&HFFF4C5&} Ria_Lee, Alina, Zero Amamiya
Dialogue: 0,0:00:43.74,0:00:45.28,pangkalahatang teksto,,0,0,0,,Paano kung hindi ko iniisip na mamatay?
Dialogue: 0,0:00:46.03,0:00:48.41,general text,,0,0,0,,Pwede ba kitang patuloy na mahalin?
Dialogue: 0,0:00:50.87,0:00:53.00,pangkalahatang teksto,,0,0,0,,Sa madaling salita, handa akong ipagsapalaran ang lahat,
Dialogue: 0,0:00:53.96,0:00:55.75,general text,,0,0,0,,para tayo ay magkasama
Dialogue: 0,0:00:57.09,0:00:59.21,pangkalahatang text,,0,0,0,,Gagawin ko
Dialogue: 0,0:00:59.30,0:01:03.76,general text,,0,0,0,,Gawin mo rin, manatili sa iyong pag-amin
Dialogue: 0,0:01:05.34,0:01:07.30,pangkalahatang teksto,,0,0,0,,Mahalin mo ako hanggang kamatayan
Dialogue: 0,0:01:21.19,0:01:23.95,general text,,0,0,0,,Moo Dok, huwag mo akong tingnan ng ganyan
Dialogue: 0,0:01:24.03,0:01:27.24,general text,,0,0,0,,Kung titingnan mo nang ganyan, walang maniniwala sa iyong mga salita
Dialogue: 0,0:01:28.41,0:01:29.95,pangkalahatang teksto,,0,0,0,,Pagkatapos, master,
Dialogue: 0,0:01:30.04,0:01:34.00,general text,,0,0,0,,paano ko masisigurong lahat ay naniniwala sa aking pag-ibig?
Dialogue: 0,0:01:35.58,0:01:36.83,pangkalahatang teksto,,0,0,0,,Buweno, una sa lahat...
Dialogue: 0,0:01:38.25,0:01:40.46,pangkalahatang teksto,,0,0,0,,Ang iyong view ay hindi angkop sa lahat
Dialogue: 0,0:01:41.76,0:01:44.13,general text,,0,0,0,,Dapat may lambing sa titig
Dialogue: 0,0:01:46.55,0:01:47.76,pangkalahatang teksto,,0,0,0,,Sa tingin ko ito ay imposible
Dialogue: 0,0:01:48.97,0:01:50.93,general text,,0,0,0,,Bakit mo sinabing mahal mo ako?
Dialogue: 0,0:01:51.02,0:01:54.31,general text,,0,0,0,,Dapat sinabi ko na gusto mo ako
Dialogue: 0,0:01:55.94,0:01:58.31,pangkalahatang text,,0,0,0,,Kumbaga, naglalambing ako
Dialogue: 0,0:01:58.40,0:02:00.52,pangkalahatang text,,0,0,0,,at mahal kita
Dialogue: 0,0:02:00.61,0:02:02.69,pangkalahatang teksto,,0,0,0,,Ano kung gayon?
Dialogue: 0,0:02:02.78,0:02:04.07,pangkalahatang teksto,,0,0,0,,Mamaya?
Dialogue: 0,0:02:04.15,0:02:07.03,pangkalahatang teksto,,0,0,0,,mahal kita nang walang taros,
Dialogue: 0,0:02:07.11,0:02:09.91,general text,,0,0,0,,habang ang maid Kim ay desperadong nagsisikap na pakasalan ka?
Dialogue: 0,0:02:10.99,0:02:14.16,general text,,0,0,0,,Ano ang mangyayari sa akin?
Dialogue: 0,0:02:14.83,0:02:18.00,general text,,0,0,0,,Wag kang mag-alala, hindi ako ikakasal
Dialogue: 0,0:02:18.08,0:02:19.75,pangkalahatang teksto,,0,0,0,,Hindi siya pupunta
Dialogue: 0,0:02:19.84,0:02:22.67,general text,,0,0,0,,Kaya ba tumanggi ka sa chastity tea?
Dialogue: 0,0:02:25.05,0:02:28.22,pangkalahatang teksto,,0,0,0,,Naiintindihan ko nang tama kung ano ang hinihiling mo
Dialogue: 0,0:02:28.30,0:02:31.31,pangkalahatang teksto,,0,0,0,,isang uri ng pangako o isang bagay?
Dialogue: 0,0:02:31.39,0:02:33.27,general text,,0,0,0,,Kung mahal kita,
Dialogue: 0,0:02:34.43,0:02:36.81,pangkalahatang teksto,,0,0,0,,na ang ibig sabihin ay dapat kong siguraduhin na ikaw ay akin
Dialogue: 0,0:02:39.06,0:02:43.03,pangkalahatang teksto,,0,0,0,,Huwag nating madaliin ang mga bagay-bagay
Dialogue: 0,0:02:43.11,0:02:44.03,pangkalahatang teksto,,0,0,0,,Tanggi
Dialogue: 0,0:02:45.94,0:02:48.82,general text,,0,0,0,,Bakit ang hirap sayo?
Dialogue: 0,0:02:48.91,0:02:51.45,general text,,0,0,0,,I just ask you don't rush
Dialogue: 0,0:02:51.53,0:02:54.54,general text,,0,0,0,,Kailangan kong makausap ang maid na si Kim
Dialogue: 0,0:02:54.62,0:02:55.62,pangkalahatang text,,0,0,0,,Tingnan mo
Dialogue: 0,0:02:56.54,0:02:57.37,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:02:58.46,0:03:00.17,pangkalahatang teksto,,0,0,0,,Magiliw na sulyap, upang ikaw
Dialogue: 0,0:03:00.25,0:03:02.84,pangkalahatang text,,0,0,0,,Titingnan kita na para kang isang masamang aso
Dialogue: 0,0:03:02.92,0:03:04.00,pangkalahatang text,,0,0,0,,Aso?
Dialogue: 0,0:03:04.92,0:03:05.96,pangkalahatang teksto,,0,0,0,,Eksakto
Dialogue: 0,0:03:06.05,0:03:09.51,general text,,0,0,0,,Nakalimutan kong sabihin ang isang mahalagang bagay
Dialogue: 0,0:03:10.14,0:03:11.93,pangkalahatang teksto,,0,0,0,,Ito ay isang aso
Dialogue: 0,0:03:12.51,0:03:14.06,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:03:14.14,0:03:17.35,general text,,0,0,0,,Ang aso na kasama ni Master Li sa Danhyangk. naaalala mo ba
Dialogue: 0,0:03:18.14,0:03:19.23,pangkalahatang teksto,,0,0,0,,Sapsari?
Dialogue: 0,0:03:19.31,0:03:20.65,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:03:21.77,0:03:23.02,pangkalahatang teksto,,0,0,0,,Ito si Gwigu
Dialogue: 0,0:03:26.07,0:03:30.66,pangkalahatang teksto,,0,0,0,,Alam ni Master Li sa simula pa lang na ikaw ay isang nomad
Dialogue: 0,0:03:30.74,0:03:31.91,pangkalahatang teksto,,0,0,0,,Marahil
Dialogue: 0,0:03:32.83,0:03:34.62,general text,,0,0,0,,alam pa niya na ikaw si Nak Soo
Dialogue: 0,0:03:48.17,0:03:51.76,general text,,0,0,0,,Ano ang nagdala sa ulo ni Jinyeowon sa ganoong oras?
Dialogue: 0,0:03:57.27,0:03:58.98,pangkalahatang teksto,,0,0,0,,malamang ako ay dumating para sa iyo
Dialogue: 0,0:03:59.98,0:04:01.10,pangkalahatang text,,0,0,0,,Narinig ko,
Dialogue: 0,0:04:01.19,0:04:04.65,general text,,0,0,0,,dinala mo si Gwiga, isang relic ni Jinyovon, sa palasyo
Dialogue: 0,0:04:04.73,0:04:07.53,pangkalahatang teksto,,0,0,0,,Naghahanap kami ng mga bakas ng dark magic
Dialogue: 0,0:04:07.61,0:04:12.11,pangkalahatang teksto,,0,0,0,,Babalaan kita: mas mabuting huwag isali si Jinyeowon sa anumang negosyo kasama ang mga nomad
Dialogue: 0,0:04:12.20,0:04:14.37,pangkalahatang teksto,,0,0,0,,Bakit ginagamit ng Pine Forest ang Jinyeowon?
Dialogue: 0,0:04:16.66,0:04:18.58,pangkalahatang teksto,,0,0,0,,Mages ng Unified Council
Dialogue: 0,0:04:18.66,0:04:20.33,pangkalahatang teksto,,0,0,0,,dapat maiwasan ang dark magic
Dialogue: 0,0:04:20.41,0:04:24.21,pangkalahatang teksto,,0,0,0,,At dapat tulungan ni Jinyeowon si Sosnovy Bor dito
Dialogue: 0,0:04:24.79,0:04:26.46,pangkalahatang teksto,,0,0,0,,Sa tingin mo?
Dialogue: 0,0:04:26.55,0:04:29.51,general text,,0,0,0,,Kaya ginagamit mo na naman kami
Dialogue: 0,0:04:30.22,0:04:33.09,general text,,0,0,0,,Tapos kukunin ko si Gviga
Dialogue: 0,0:04:34.34,0:04:35.55,italics,,0,0,0,,Dalhin mo siya sa akin
Dialogue: 0,0:04:36.31,0:04:39.98,pangkalahatang text,,0,0,0,,O ako mismo ang kukuha sa kanya?
Dialogue: 0,0:04:40.73,0:04:42.19,italics,,0,0,0,,Gwigu dito
Dialogue: 0,0:04:52.61,0:04:55.82,pangkalahatang teksto,,0,0,0,,Ang Gwigu ay isang relic na nilikha ni master So Kyung
Dialogue: 0,0:04:55.91,0:04:57.49,pangkalahatang teksto,,0,0,0,,Si Sosnovy Bor ay may parehong mga karapatan dito
Dialogue: 0,0:04:57.58,0:04:59.87,pangkalahatang teksto,,0,0,0,,Anong mga karapatan mo sa Jinyeowon relic?
Dialogue: 0,0:04:59.95,0:05:03.58,general text,,0,0,0,,Gusto mo bang sabihin na si Jinyeowon ang storeroom ng Pine Forest?
Dialogue: 0,0:05:03.67,0:05:05.42,general text,,0,0,0,,Hindi iyon ang ibig niyang sabihin
Dialogue: 0,0:05:05.50,0:05:09.09,general text,,0,0,0,,Wala kang kahihiyang naniniwala na lahat ng kayamanan ni Jinyeowon ay pag-aari mo
Dialogue: 0,0:05:09.17,0:05:11.55,pangkalahatang teksto,,0,0,0,,Kumuha ka ng mga bagay nang hindi nagtatanong at huwag mong ibalik ang mga ito
Dialogue: 0,0:05:12.13,0:05:13.93,pangkalahatang teksto,,0,0,0,,Ito ang mga tao ng Sosnovy Bor
Dialogue: 0,0:05:16.39,0:05:20.06,general text,,0,0,0,,Nasabi mo na ito dati
Dialogue: 0,0:05:21.77,0:05:25.98,pangkalahatang teksto,,0,0,0,,Na may kinuha sa iyo ang salamangkero ni Sosnovy Bor
Dialogue: 0,0:05:33.49,0:05:34.95,pangkalahatang teksto,,0,0,0,,Sino iyon?
Dialogue: 0,0:05:46.12,0:05:48.92,general text,,0,0,0,,Nasa harap ko siya
Dialogue: 0,0:05:49.96,0:05:52.59,pangkalahatang text,,0,0,0,,Pinasok niya si Jinyeowon
Dialogue: 0,0:05:52.67,0:05:54.34,pangkalahatang text,,0,0,0,,at ninakaw si Gwiga
Dialogue: 0,0:05:55.43,0:05:59.72,general text,,0,0,0,,How dare you call Master Li na magnanakaw?!
Dialogue: 0,0:05:59.81,0:06:02.68,general text,,0,0,0,,Ano pa ang itatawag mo sa taong nagnakaw ng ari-arian ng iba?
Dialogue: 0,0:06:03.35,0:06:05.69,pangkalahatang teksto,,0,0,0,,Ina, pakiusap
Dialogue: 0,0:06:05.77,0:06:09.86,pangkalahatang teksto,,0,0,0,,Inilipat ni Master Li ang kaluluwa ni Gwigu mula sa sirang urn
Dialogue: 0,0:06:09.94,0:06:11.65,pangkalahatang teksto,,0,0,0,,sa katawan ng aso
Dialogue: 0,0:06:11.73,0:06:13.57,italics,,0,0,0,,At binasag nila ang basurahan na iyon sa Sosnovy Bor
Dialogue: 0,0:06:13.65,0:06:14.82,italics,,0,0,0,,Tingnan mo!
Dialogue: 0,0:07:16.55,0:07:18.26,general text,,0,0,0,,Patay na siya, master
Dialogue: 0,0:07:22.14,0:07:23.72,pangkalahatang teksto,,0,0,0,,Pinoprotektahan ko ang aking anak na babae
Dialogue: 0,0:07:23.81,0:07:27.18,general text,,0,0,0,,Master Li, inutusan mo ba si Gwig na atakihin kami?
Dialogue: 0,0:07:27.27,0:07:29.85,general text,,0,0,0,,Atake ni Gwigu dahil nakaramdam siya ng dark magic
Dialogue: 0,0:07:33.98,0:07:35.32,pangkalahatang teksto,,0,0,0,,Ibig sabihin,
Dialogue: 0,0:07:37.15,0:07:39.11,general text,,0,0,0,,ang batang si Miss Jin ay konektado sa kanya kahit papaano
Dialogue: 0,0:07:47.29,0:07:50.00,offscreen,,0,0,0,,Marahil lahat ay dahil sa uod na may dark magic
Dialogue: 0,0:07:56.96,0:07:58.05,pangkalahatang teksto,,0,0,0,,Miss Jin,
Dialogue: 0,0:07:59.01,0:08:00.13,pangkalahatang teksto,,0,0,0,,ikaw
Dialogue: 0,0:08:00.93,0:08:02.59,pangkalahatang text,,0,0,0,,gumamit ng dark magic?
Dialogue: 0,0:08:08.81,0:08:11.02,pangkalahatang text,,0,0,0,,Dark magic? Anong kalokohan!
Dialogue: 0,0:08:11.10,0:08:12.35,pangkalahatang teksto,,0,0,0,,Kung hindi,
Dialogue: 0,0:08:12.44,0:08:14.77,general text,,0,0,0,,bakit siya inatake ni Gwigu?
Dialogue: 0,0:08:15.36,0:08:18.40,pangkalahatang teksto,,0,0,0,,Sinusubukan na ngayon ni Sosnovy Bor na siraan ang aking anak na babae
Dialogue: 0,0:08:18.49,0:08:19.99,pangkalahatang text,,0,0,0,,Tumigil ka!
Dialogue: 0,0:08:20.65,0:08:22.41,general text,,0,0,0,,Tama si Master Li
Dialogue: 0,0:08:25.99,0:08:27.20,pangkalahatang teksto,,0,0,0,,Kamakailan
Dialogue: 0,0:08:28.00,0:08:31.54,general text,,0,0,0,,Gumamit ako ng dark magic
Dialogue: 0,0:08:37.63,0:08:41.38,pangkalahatang teksto,,0,0,0,,Ngunit hindi ko sinaktan ang sinuman
Dialogue: 0,0:08:49.56,0:08:51.60,pangkalahatang text,,0,0,0,,Sikat na sikat ito ngayon
Dialogue: 0,0:08:52.98,0:08:56.57,general text,,0,0,0,,Ito ay anting-anting para sa love spell para mahalin ka ng iyong kasintahan
Dialogue: 0,0:09:02.53,0:09:04.53,general text,,0,0,0,,I think that's the point
Dialogue: 0,0:09:12.04,0:09:15.13,general text,,0,0,0,,Mukhang nagdulot ng hindi pagkakaunawaan ang aming anak na babae
Dialogue: 0,0:09:15.21,0:09:16.29,pangkalahatang text,,0,0,0,,Paumanhin
Dialogue: 0,0:09:40.07,0:09:43.86,pangkalahatang teksto,,0,0,0,,Nabuhay ka sa katawan ng asong ito,
Dialogue: 0,0:09:44.78,0:09:46.49,general text,,0,0,0,,at ngayon iniwan na niya tayo
Dialogue: 0,0:09:55.25,0:09:58.67,general text,,0,0,0,,Wala na sa amin si Gwigu
Dialogue: 0,0:10:00.67,0:10:02.09,pangkalahatang teksto,,0,0,0,,Ano ang gagawin?
Dialogue: 0,0:10:02.84,0:10:06.55,general text,,0,0,0,,Kasalanan ko bang namatay si Gwigu?
Dialogue: 0,0:10:06.64,0:10:07.51,pangkalahatang teksto,,0,0,0,,Jin Cho Young!
Dialogue: 0,0:10:08.26,0:10:10.64,general text,,0,0,0,,How dare you disgrace Jinyeowon?
Dialogue: 0,0:10:35.04,0:10:36.58,general text,,0,0,0,,Namatay si Gwigu?
Dialogue: 0,0:10:37.50,0:10:38.54,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:10:38.63,0:10:41.46,general text,,0,0,0,,Sinabi ni Master Li na ililibing niya siya bukas
Dialogue: 0,0:10:42.88,0:10:44.71,voiceover,,0,0,0,,Kaya si Gwigu
Dialogue: 0,0:10:48.26,0:10:51.14,voiceover,,0,0,0,,Alam niya sa simula pa lang na nomad ako
Dialogue: 0,0:10:51.93,0:10:54.18,voiceover,,0,0,0,,Pero kahit kailan hindi siya umangal sa akin
Dialogue: 0,0:10:55.18,0:10:58.60,offscreen,,0,0,0,,Ganyan ba niya ako tinakpan?
Dialogue: 0,0:11:03.23,0:11:04.86,general text,,0,0,0,,Kahit patay, ito si Gwigu
Dialogue: 0,0:11:05.86,0:11:08.57,pangkalahatang teksto,,0,0,0,,Malamang na ang lahat ng enerhiya ay umalis sa katawan. Huwag hawakan
Dialogue: 0,0:11:16.87,0:11:19.33,general text,,0,0,0,,Nakaalis na ba ang mga tao ni Jinyeowon?
Dialogue: 0,0:11:19.42,0:11:21.04,general text,,0,0,0,,Tinatalakay nila ang isa pang problema
Dialogue: 0,0:11:21.63,0:11:22.63,pangkalahatang teksto,,0,0,0,,Isa pang problema
Dialogue: 0,0:11:23.34,0:11:24.84,general text,,0,0,0,,Si Dan Gu at Cho Young pala
Dialogue: 0,0:11:25.88,0:11:27.09,pangkalahatang teksto,,0,0,0,,nangyayari
Dialogue: 0,0:11:28.34,0:11:29.59,general text,,0,0,0,,- Ano?\N- Ano?
Dialogue: 0,0:11:30.64,0:11:33.93,general text,,0,0,0,,sinira ko ang relic ni Jinyeowon,
Dialogue: 0,0:11:34.01,0:11:35.89,pangkalahatang text,,0,0,0,,hindi mo kasalanan
Dialogue: 0,0:11:36.47,0:11:38.39,pangkalahatang teksto,,0,0,0,,Panahon na para sa atin
Dialogue: 0,0:11:39.44,0:11:41.65,general text,,0,0,0,,- Tara na\N- Oo
Dialogue: 0,0:11:41.73,0:11:42.98,pangkalahatang teksto,,0,0,0,,Miss Jin
Dialogue: 0,0:11:43.06,0:11:45.32,pangkalahatang teksto,,0,0,0,,Uminom ng tsaa bago umalis
Dialogue: 0,0:11:45.90,0:11:48.11,pangkalahatang teksto,,0,0,0,,Kailangan nating linawin ang lahat, pagbutihin ang relasyon
Dialogue: 0,0:11:48.78,0:11:49.95,pangkalahatang teksto,,0,0,0,,Mga Relasyon?
Dialogue: 0,0:11:50.03,0:11:51.99,general text,,0,0,0,,In love sila
Dialogue: 0,0:11:52.07,0:11:54.45,pangkalahatang teksto,,0,0,0,,Ang talisman na iyon ay inilaan para kay Dan Gu,
Dialogue: 0,0:11:54.53,0:11:57.16,general text,,0,0,0,,tama ba ako?
Dialogue: 0,0:11:59.54,0:12:01.79,pangkalahatang teksto,,0,0,0,,Oo. Ako ang dahilan ng lahat
Dialogue: 0,0:12:02.38,0:12:04.13,general text,,0,0,0,,Walang ginawang mali si Cho Young
Dialogue: 0,0:12:04.21,0:12:05.21,pangkalahatang teksto,,0,0,0,,Tumahimik
Dialogue: 0,0:12:07.84,0:12:09.55,general text,,0,0,0,,Nalaman ko kamakailan
Dialogue: 0,0:12:09.63,0:12:11.43,general text,,0,0,0,,Nagsalita siya ng walang kapararakan
Dialogue: 0,0:12:11.51,0:12:14.26,pangkalahatang teksto,,0,0,0,,tungkol sa kung ano ang kanilang magiging pagsasama kapag bumalik ang iyong namatay na anak na babae,
Dialogue: 0,0:12:14.35,0:12:16.10,general text,,0,0,0,,so I told him off
Dialogue: 0,0:12:16.18,0:12:19.23,pangkalahatang teksto,,0,0,0,,Namatay na anak na babae? Buhay si Boo Young at makikita natin siya sa lalong madaling panahon
Dialogue: 0,0:12:20.69,0:12:23.31,general text,,0,0,0,,Naniniwala ka ba talaga na mahahanap siya ni Jin Mu?
Dialogue: 0,0:12:23.94,0:12:26.82,general text,,0,0,0,,Niloloko ka niya
Dialogue: 0,0:12:27.40,0:12:29.78,pangkalahatang teksto,,0,0,0,,Binigyan ka niya ng ideya na hanapin si Sosnovy Bor
Dialogue: 0,0:12:29.86,0:12:31.70,pangkalahatang text,,0,0,0,,sa oras na ito para kunin si Gviga?
Dialogue: 0,0:12:31.78,0:12:33.99,general text,,0,0,0,,Sabi ko sayo wag kang makialam sa negosyo ni Jinyowon
Dialogue: 0,0:12:34.57,0:12:37.41,general text,,0,0,0,,Huwag tayong mag-away
Dialogue: 0,0:12:37.49,0:12:40.62,pangkalahatang teksto,,0,0,0,,Maganda kung si Boo Young ay matatagpuan
Dialogue: 0,0:12:40.71,0:12:44.25,pangkalahatang teksto,,0,0,0,,Ayaw makipag-away ni Misis Jin kay Sosnovy Bor
Dialogue: 0,0:12:45.34,0:12:48.76,pangkalahatang teksto,,0,0,0,,Magtulungan tayo
Dialogue: 0,0:12:48.84,0:12:50.30,pangkalahatang teksto,,0,0,0,,Sino ang nakakaalam?
Dialogue: 0,0:12:50.38,0:12:54.01,general text,,0,0,0,,Baka magkaisa sina Dan Gu at Cho Young ng dalawang pamilya
Dialogue: 0,0:12:54.09,0:12:55.43,pangkalahatang teksto,,0,0,0,,Tutol ako
Dialogue: 0,0:12:55.51,0:12:58.22,pangkalahatang text,,0,0,0,,Hahanap si Cho Young ng mas magandang party
Dialogue: 0,0:12:59.72,0:13:03.65,pangkalahatang teksto,,0,0,0,,Saan ka makakahanap ng mas mahusay na nobyo kaysa sa hinaharap na pinuno ng Sosnovy Bor?
Dialogue: 0,0:13:03.73,0:13:05.27,pangkalahatang teksto,,0,0,0,,Anak ng pamilya Jin
Dialogue: 0,0:13:05.36,0:13:08.11,pangkalahatang teksto,,0,0,0,,karapat-dapat pakasalan ang Crown Prince
Dialogue: 0,0:13:09.65,0:13:10.61,pangkalahatang teksto,,0,0,0,,Ina,
Dialogue: 0,0:13:10.69,0:13:12.28,pangkalahatang teksto,,0,0,0,,ano ang ibig sabihin nito?
Dialogue: 0,0:13:13.24,0:13:14.45,general text,,0,0,0,,Ayoko
Dialogue: 0,0:13:15.24,0:13:17.33,pangkalahatang teksto,,0,0,0,,Evil Prince
Dialogue: 0,0:13:17.41,0:13:19.87,general text,,0,0,0,,- At hindi ko siya gusto\N- Jin Cho Young
Dialogue: 0,0:13:20.54,0:13:22.50,general text,,0,0,0,,papakasalan ko ang mahal ko
Dialogue: 0,0:13:24.04,0:13:24.87,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:13:25.50,0:13:27.42,general text,,0,0,0,,Ako ang manliligaw niya
Dialogue: 0,0:13:27.50,0:13:28.55,pangkalahatang teksto,,0,0,0,,Park Dan Gu!
Dialogue: 0,0:13:34.47,0:13:35.64,general text,,0,0,0,,Sa bahay tayo mag-usap
Dialogue: 0,0:13:39.01,0:13:40.72,general text,,0,0,0,,Bitiwan mo ang kamay niya at umalis na tayo
Dialogue: 0,0:13:42.81,0:13:44.52,pangkalahatang text,,0,0,0,,Hayaan mo na siya ngayon
Dialogue: 0,0:13:44.60,0:13:46.44,general text,,0,0,0,,Bitawan mo ang kamay niya para makaalis na siya
Dialogue: 0,0:13:47.73,0:13:49.27,general text,,0,0,0,,Hayaan mo siya!
Dialogue: 0,0:13:49.36,0:13:50.44,pangkalahatang teksto,,0,0,0,,Hayaan mo na!
Dialogue: 0,0:13:59.58,0:14:00.58,pangkalahatang teksto,,0,0,0,,Jin Cho Young,
Dialogue: 0,0:14:00.66,0:14:03.58,general text,,0,0,0,,Kung ayaw mong sumunod, huwag kang umuwi
Dialogue: 0,0:14:12.76,0:14:15.55,general text,,0,0,0,,Sa tingin ko mas mabuting umalis na tayo
Dialogue: 0,0:14:18.26,0:14:19.89,general text,,0,0,0,,Uuwi ka ba sa amin?
Dialogue: 0,0:14:19.97,0:14:22.43,general text,,0,0,0,,Sa pagkakataong ito ay hindi na ako susuko sa aking ina
Dialogue: 0,0:14:23.68,0:14:25.23,pangkalahatang teksto,,0,0,0,,Intindihin, ama
Dialogue: 0,0:14:27.73,0:14:30.40,general text,,0,0,0,,Ipapaalam ko sa iyo kapag kumalma na ang nanay mo
Dialogue: 0,0:14:32.61,0:14:33.99,general text,,0,0,0,,Alagaan mo siya sa ngayon
Dialogue: 0,0:14:34.74,0:14:35.65,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:14:45.08,0:14:47.87,general text,,0,0,0,,Tito, pasensya na sa kaguluhan,
Dialogue: 0,0:14:47.96,0:14:49.54,general text,,0,0,0,,pero poprotektahan ko ang girlfriend ko
Dialogue: 0,0:14:49.63,0:14:50.46,general text,,0,0,0,,Maliligaw ka rin!
Dialogue: 0,0:15:00.68,0:15:03.85,general text,,0,0,0,,Saan tayo pupunta ngayon?
Dialogue: 0,0:15:05.98,0:15:07.23,pangkalahatang text,,0,0,0,,Hindi ko alam
Dialogue: 0,0:15:10.73,0:15:12.77,general text,,0,0,0,,Huwag na daw umuwi,
Dialogue: 0,0:15:12.86,0:15:15.69,general text,,0,0,0,,pupunta tayo sa inn at...
Dialogue: 0,0:15:16.36,0:15:18.24,general text,,0,0,0,,- Magrenta ng kwarto?\N- Ano?
Dialogue: 0,0:15:20.62,0:15:21.78,pangkalahatang teksto,,0,0,0,,Hindi iyon ang ibig kong sabihin!
Dialogue: 0,0:15:21.87,0:15:24.70,pangkalahatang teksto,,0,0,0,,Hindi isa, ngunit dalawang magkaibang
Dialogue: 0,0:15:27.96,0:15:30.33,general text,,0,0,0,,Ayoko ng inns
Dialogue: 0,0:15:32.09,0:15:35.00,pangkalahatang teksto,,0,0,0,,Wala pang ibang mapupuntahan
Dialogue: 0,0:15:35.09,0:15:36.59,general text,,0,0,0,,At lumalamig na
Dialogue: 0,0:15:37.34,0:15:38.38,pangkalahatang teksto,,0,0,0,,Malamig...
Dialogue: 0,0:15:40.89,0:15:42.18,pangkalahatang teksto,,0,0,0,,Saan pupunta?
Dialogue: 0,0:15:42.26,0:15:43.64,italics,,0,0,0,,Mr. Park!
Dialogue: 0,0:15:45.06,0:15:48.39,general text,,0,0,0,,Sinabi sa akin na pinalaya si Mr. Chan, pero wala siya sa kwarto.
Dialogue: 0,0:15:48.48,0:15:49.81,general text,,0,0,0,,Nakita mo na ba?
Dialogue: 0,0:15:54.73,0:15:56.73,pangkalahatang teksto,,0,0,0,,May mali ba?
Dialogue: 0,0:15:59.86,0:16:01.95,general text,,0,0,0,,- Maid Kim...\N- Ano?
Dialogue: 0,0:16:02.03,0:16:03.03,pangkalahatang text,,0,0,0,,Maiden Kim...
Dialogue: 0,0:16:03.12,0:16:05.03,general text,,0,0,0,,Hayaan mo, Mr. Park
Dialogue: 0,0:16:05.79,0:16:08.33,general text,,0,0,0,,Miss Jin, ano yun?
Dialogue: 0,0:16:08.41,0:16:10.04,pangkalahatang teksto,,0,0,0,,Dalagang Kim...
Dialogue: 0,0:16:10.12,0:16:12.58,pangkalahatang teksto,,0,0,0,,Gwigu, na nag-organisa ng pogrom sa palasyo,
Dialogue: 0,0:16:12.67,0:16:16.38,general text,,0,0,0,, winasak ni Mrs. Jin sa pagtatangkang pigilan siya
Dialogue: 0,0:16:16.46,0:16:18.21,pangkalahatang teksto,,0,0,0,,nawasak si Gwigu?
Dialogue: 0,0:16:18.30,0:16:20.18,pangkalahatang teksto,,0,0,0,,Bakit sirain kung ano ang tutukuyin ang dark magic?
Dialogue: 0,0:16:20.26,0:16:22.64,pangkalahatang teksto,,0,0,0,,Kahulugan ng dark magic
Dialogue: 0,0:16:22.72,0:16:25.68,pangkalahatang teksto,,0,0,0,,ay dahilan lamang para takutin ni Sosnovy Bor ang palasyo
Dialogue: 0,0:16:26.26,0:16:27.89,italics,,0,0,0,,Tama si Jin Mu
Dialogue: 0,0:16:27.97,0:16:31.52,pangkalahatang teksto,,0,0,0,,Sinubukan ni Sosnovy Bor na ipakita na mas maimpluwensya ito kaysa sa amin
Dialogue: 0,0:16:32.81,0:16:34.69,pangkalahatang teksto,,0,0,0,,Sa ilalim ng dahilan ng pagpuksa sa kasamaan,
Dialogue: 0,0:16:34.77,0:16:37.28,pangkalahatang teksto,,0,0,0,,Pine Forest ay maaaring magpulong ng mga mago ng Unified Council
Dialogue: 0,0:16:37.36,0:16:39.32,pangkalahatang teksto,,0,0,0,,at ilipat ang hari
Dialogue: 0,0:16:40.03,0:16:42.28,general text,,0,0,0,,Kaya pala binanggit nila ang star ng Hari?
Dialogue: 0,0:16:42.36,0:16:45.41,general text,,0,0,0,,Babala na kaya nila akong pabagsakin?
Dialogue: 0,0:16:46.37,0:16:49.20,pangkalahatang teksto,,0,0,0,,Si Master Li ay nagsimulang magsalita tungkol sa bituin upang ipaliwanag,
Dialogue: 0,0:16:49.29,0:16:52.83,pangkalahatang teksto,,0,0,0,,na ang isang tulad ni Master So Kyung ay lilitaw upang protektahan tayo sa mahihirap na panahon
Dialogue: 0,0:16:52.92,0:16:54.79,general text,,0,0,0,,Walang nagbanta sa amin
Dialogue: 0,0:16:54.88,0:16:58.17,pangkalahatang teksto,,0,0,0,,Paano kung gusto ng tagapagligtas na mamuno sa atin?
Dialogue: 0,0:16:59.05,0:17:00.42,general text,,0,0,0,,Pwede mo ba siyang pigilan?
Dialogue: 0,0:17:02.01,0:17:03.59,pangkalahatang teksto,,0,0,0,,Gwangju Chang Gang
Dialogue: 0,0:17:03.68,0:17:05.39,pangkalahatang teksto,,0,0,0,,hulaan ang paglitaw ng isang bituin
Dialogue: 0,0:17:05.97,0:17:07.47,italics,,0,0,0,,Ganoon din ang sinabi ni Master Li
Dialogue: 0,0:17:08.97,0:17:11.89,general text,,0,0,0,,Alam din ba ito ni Sosnovy Bor?
Dialogue: 0,0:17:19.32,0:17:23.91,pangkalahatang teksto,,0,0,0,,Sa una ay kumuha siya ng mga babae para magbuntis ng anak sa ilalim ng bituing ito
Dialogue: 0,0:17:23.99,0:17:26.49,pangkalahatang teksto,,0,0,0,,Ngayon ay sinusubukang hanapin siya sa Sosnovy Bor
Dialogue: 0,0:17:27.28,0:17:29.58,pangkalahatang teksto,,0,0,0,,Natural sa isang hari na laging magbantay
Dialogue: 0,0:17:30.75,0:17:32.25,pangkalahatang teksto,,0,0,0,,Para sa maharlikang pamilya ni Go
Dialogue: 0,0:17:32.33,0:17:35.46,pangkalahatang teksto,,0,0,0,,ang pagkakaroon ng bituin ng Hari ay tanda ng pagtataksil
Dialogue: 0,0:17:42.59,0:17:43.68,pangkalahatang teksto,,0,0,0,,"Pagkanulo"?
Dialogue: 0,0:17:44.55,0:17:47.43,pangkalahatang teksto,,0,0,0,,Naniniwala ang mga tao sa Deho sa kapangyarihan ng langit at iginagalang sila,
Dialogue: 0,0:17:48.10,0:17:50.77,pangkalahatang teksto,,0,0,0,,ngunit ang isang siglong gulang na dinastiya ay hindi nagbabago nang ganoon kadali
Dialogue: 0,0:17:50.85,0:17:53.52,general text,,0,0,0,,Katangahan isipin na may magiging hari
Dialogue: 0,0:17:53.60,0:17:54.94,pangkalahatang teksto,,0,0,0,,dahil lang sa bituin
Dialogue: 0,0:17:55.02,0:17:57.73,general text,,0,0,0,,Kung taga-Sosnovy Bor siya, posible
Dialogue: 0,0:17:58.90,0:18:01.90,pangkalahatang teksto,,0,0,0,,Iniligtas ni Master So Kyung ang mundo dalawang daang taon na ang nakararaan
Dialogue: 0,0:18:02.49,0:18:06.74,general text,,0,0,0,,Pinarangalan pa rin nila siya sa Deho
Dialogue: 0,0:18:08.20,0:18:10.87,pangkalahatang teksto,,0,0,0,,Kung ang isang tao ay ipinanganak sa ilalim ng parehong bituin bilang Master So Kyung,
Dialogue: 0,0:18:10.95,0:18:15.62,pangkalahatang teksto,,0,0,0,,ito ay sapat na upang maluklok ang trono
Dialogue: 0,0:18:17.50,0:18:19.04,pangkalahatang teksto,,0,0,0,,Sa tingin mo,
Dialogue: 0,0:18:19.96,0:18:23.09,pangkalahatang teksto,,0,0,0,,hindi ba walang batayan ang mga karanasan ng hari?
Dialogue: 0,0:18:25.63,0:18:27.05,pangkalahatang teksto,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:18:27.93,0:18:32.56,general text,,0,0,0,,Hangga't nandito ako, hindi ito mangyayari
Dialogue: 0,0:18:37.40,0:18:38.56,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:18:38.65,0:18:43.19,pangkalahatang teksto,,0,0,0,,Hindi ako magiging kasing tanga ng aking ama at mabubuhay sa walang hanggang takot
Dialogue: 0,0:18:47.53,0:18:49.91,general text,,0,0,0,,Nang dinala ko si Gwiga sa palasyo,
Dialogue: 0,0:18:50.66,0:18:52.58,general text,,0,0,0,,Napagtanto ko na tama ka
Dialogue: 0,0:18:52.66,0:18:55.91,pangkalahatang teksto,,0,0,0,,Ang Reyna ay nasa panig ni Jin Mu
Dialogue: 0,0:18:56.00,0:18:59.96,general text,,0,0,0,,Hindi pa natin ma-provoke ang royal family
Dialogue: 0,0:19:00.04,0:19:02.38,pangkalahatang teksto,,0,0,0,,Kung susubukan nating gumawa ng anuman,
Dialogue: 0,0:19:02.46,0:19:05.55,general text,,0,0,0,,Tiyak na ibubunyag ni Jin Mu ang sikreto ng kapanganakan ni Wook
Dialogue: 0,0:19:05.63,0:19:07.97,pangkalahatang teksto,,0,0,0,,at gagawin siyang kaaway ng palasyo
Dialogue: 0,0:19:08.72,0:19:11.68,pangkalahatang teksto,,0,0,0,,At lahat ng tao sa Sosnovy Bor ay magiging mga kaaway,
Dialogue: 0,0:19:11.76,0:19:13.35,general text,,0,0,0,,dahil tinanggap nila ito
Dialogue: 0,0:19:14.22,0:19:15.77,pangkalahatang teksto,,0,0,0,,Kailangan natin si Chang Gan
Dialogue: 0,0:19:17.10,0:19:19.52,general text,,0,0,0,,Siya lang ang nakakaalam ng buong katotohanan
Dialogue: 0,0:19:20.15,0:19:22.57,pangkalahatang teksto,,0,0,0,,Tulad ng mga kahinaan ni Jin Mu
Dialogue: 0,0:19:22.65,0:19:27.03,general text,,0,0,0,,Paano mo mahahanap ang isang taong nagtatago sa loob ng dalawang dekada?
Dialogue: 0,0:19:27.61,0:19:30.11,pangkalahatang text,,0,0,0,,Hintayin natin na bumalik siya mismo
Dialogue: 0,0:19:31.16,0:19:35.08,pangkalahatang teksto,,0,0,0,,Ang mga alingawngaw tungkol sa mga nomad ay kumalat nang malayo sa mga pader ng kuta ng Deho
Dialogue: 0,0:19:35.16,0:19:38.25,pangkalahatang teksto,,0,0,0,,Babalik siya kapag narinig niya sila,
Dialogue: 0,0:19:38.33,0:19:43.17,pangkalahatang teksto,,0,0,0,,dahil sa takot para kay Sosnovy Bor at para sa kanyang anak
Dialogue: 0,0:20:21.92,0:20:23.67,general text,,0,0,0,,Narinig kong hinahanap nila ako
Dialogue: 0,0:20:23.75,0:20:25.25,general text,,0,0,0,,Nasaan si Master Li?
Dialogue: 0,0:20:27.17,0:20:29.38,general text,,0,0,0,,Pumunta siya sa Danhyangk sa madaling araw,
Dialogue: 0,0:20:29.88,0:20:31.34,pangkalahatang teksto,,0,0,0,,para sunugin si Sapsari
Dialogue: 0,0:20:31.93,0:20:32.84,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:20:33.43,0:20:36.39,general text,,0,0,0,,Wala siya? Diba siya yung tumawag sakin?
Dialogue: 0,0:20:36.47,0:20:37.89,pangkalahatang teksto,,0,0,0,,Siya
Dialogue: 0,0:20:39.68,0:20:41.48,pangkalahatang teksto,,0,0,0,,Sinabi sa akin na sabihin ito sa iyo
Dialogue: 0,0:20:44.19,0:20:48.44,general text,,0,0,0,,Ito ang espada ni Nak Su, na kinuha niya sa Crown Prince
Dialogue: 0,0:20:49.61,0:20:52.11,general text,,0,0,0,,Ayon sa kanya, ikaw lang ang makakapag-imbak nito,
Dialogue: 0,0:20:52.20,0:20:53.91,general text,,0,0,0,,kaya hiniling ko na ibalik ito
Dialogue: 0,0:20:54.87,0:20:56.49,pangkalahatang teksto,,0,0,0,,Iniwan ang espada?
Dialogue: 0,0:20:57.41,0:20:59.83,general text,,0,0,0,,At wala siyang sinabi bago umalis?
Dialogue: 0,0:20:59.91,0:21:03.08,general text,,0,0,0,,Hindi ka niya estudyante, bakit
Dialogue: 0,0:21:03.17,0:21:06.38,general text,,0,0,0,,sobrang pakialam niya sayo, hindi ko maintindihan
Dialogue: 0,0:21:06.88,0:21:08.67,general text,,0,0,0,,Hindi ka man lang nagsanay ng chastity!
Dialogue: 0,0:21:10.88,0:21:14.22,general text,,0,0,0,,Pak Jin na babaero ka daw.
Dialogue: 0,0:21:14.84,0:21:16.55,pangkalahatang teksto,,0,0,0,,Kung naiinlove ka kay Moo Deok,
Dialogue: 0,0:21:16.64,0:21:18.39,general text,,0,0,0,,bakit mo binata ang aking Young Ok?
Dialogue: 0,0:21:19.89,0:21:22.27,general text,,0,0,0,,- Hindi ako nag-spud\N- Hindi?
Dialogue: 0,0:21:22.35,0:21:23.69,general text,,0,0,0,,Ginayuma mo siya
Dialogue: 0,0:21:23.77,0:21:26.65,general text,,0,0,0,,Paano mo ginaya si Master Li?
Dialogue: 0,0:21:26.73,0:21:28.48,general text,,0,0,0,,Wala akong ginawa
Dialogue: 0,0:21:28.57,0:21:31.61,general text,,0,0,0,,Na may mabait sa akin,
Dialogue: 0,0:21:31.69,0:21:33.78,pangkalahatang text,,0,0,0,,hindi ibig sabihin ginayuma ko sila
Dialogue: 0,0:21:35.07,0:21:38.12,pangkalahatang teksto,,0,0,0,,Mag-ingat sa Young Ok sa hinaharap
Dialogue: 0,0:21:38.20,0:21:39.83,pangkalahatang teksto,,0,0,0,,at magalang kay Master Li
Dialogue: 0,0:21:39.91,0:21:40.95,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:21:41.04,0:21:44.62,pangkalahatang teksto,,0,0,0,,Si Master Li ay hindi kasingkitid ng isip gaya ng ibang mga guro
Dialogue: 0,0:21:44.71,0:21:47.88,general text,,0,0,0,,Hindi siya bias at mabait
Dialogue: 0,0:21:47.96,0:21:49.55,general text,,0,0,0,,ginagalang ko siya
Dialogue: 0,0:21:50.38,0:21:53.51,general text,,0,0,0,,Hindi mo maisip kung gaano siya kahigpit
Dialogue: 0,0:21:54.43,0:21:58.60,pangkalahatang teksto,,0,0,0,,Wala siyang awa sa paghiga ng patatas
Dialogue: 0,0:21:58.68,0:22:01.43,general text,,0,0,0,,Kaya laging mag-ingat
Dialogue: 0,0:22:01.52,0:22:02.64,pangkalahatang teksto,,0,0,0,,Kunin ito at umalis
Dialogue: 0,0:22:09.69,0:22:10.78,general text,,0,0,0,,Nakalimutan ko na
Dialogue: 0,0:22:10.86,0:22:12.44,general text,,0,0,0,,Muntik na naman magkagulo
Dialogue: 0,0:22:12.53,0:22:14.57,pangkalahatang teksto,,0,0,0,,Hiniling akong maghatid ng mensahe,
Dialogue: 0,0:22:14.65,0:22:17.20,pangkalahatang teksto,,0,0,0,,kapag binigay ko sa iyo ang espada Nak Su
Dialogue: 0,0:22:29.25,0:22:31.30,general text,,0,0,0,,Bakit niya ibinigay sa iyo ang aking espada?
Dialogue: 0,0:22:31.88,0:22:34.09,general text,,0,0,0,,Dahil akin ka,
Dialogue: 0,0:22:34.84,0:22:36.68,pangkalahatang teksto,,0,0,0,,na nangangahulugang espada din
Dialogue: 0,0:22:37.59,0:22:40.64,pangkalahatang teksto,,0,0,0,,Sa anumang kaso, nangangahulugan ito na patuloy siyang tatahimik
Dialogue: 0,0:22:40.72,0:22:42.06,pangkalahatang teksto,,0,0,0,,Maganda ito
Dialogue: 0,0:22:47.52,0:22:50.27,memories italics,,0,0,0,,Hiniling akong maghatid ng mensahe
Dialogue: 0,0:22:55.11,0:22:57.49,mga alaala,,0,0,0,,Dapat alagaan siya ni Chan Wook
Dialogue: 0,0:22:57.57,0:23:01.45,mga alaala,,0,0,0,,Kung may magtangkang gumamit ng espada, kailangan niyang patayin
Dialogue: 0,0:23:03.58,0:23:05.41,mga alaala,,0,0,0,,Kung hindi niya gagawin,
Dialogue: 0,0:23:07.67,0:23:09.50,mga alaala,,0,0,0,,mamamatay din siya
Dialogue: 0,0:23:12.67,0:23:16.67,voiceover,,0,0,0,,Ito ay isang babala na papatayin niya kami kapag ginamit ni Moo Deok ang espada.
Dialogue: 0,0:23:17.59,0:23:19.01,behind the scenes,,0,0,0,,bilang mersenaryong Nak Su
Dialogue: 0,0:23:23.56,0:23:25.73,general text,,0,0,0,,Ang espada ko, pero kakaiba ang sensasyon
Dialogue: 0,0:23:27.02,0:23:29.60,general text,,0,0,0,,Sa tingin ko hinayaan niya akong mabuhay dahil alam niyang hindi ko siya magagamit
Dialogue: 0,0:23:30.69,0:23:33.27,pangkalahatang teksto,,0,0,0,,Kaya, bilang Moo Dok, magiging ligtas ka
Dialogue: 0,0:23:34.07,0:23:36.36,general text,,0,0,0,,Kung magiging Nak Su ako, malalagay ako sa panganib
Dialogue: 0,0:23:37.40,0:23:39.66,pangkalahatang teksto,,0,0,0,,Sa sandaling mahanap ko ang batong yelo at mabawi ang aking lakas,
Dialogue: 0,0:23:40.36,0:23:42.45,general text,,0,0,0,,Hahanap din ako ng mga kaaway
Dialogue: 0,0:23:44.33,0:23:45.83,general text,,0,0,0,,Ano ang mangyayari sa akin noon,
Dialogue: 0,0:23:46.45,0:23:47.96,pangkalahatang teksto,,0,0,0,, hindi dapat mag-alala sa iyo
Dialogue: 0,0:23:48.04,0:23:49.00,pangkalahatang teksto,,0,0,0,,Bakit?
Dialogue: 0,0:23:49.71,0:23:51.88,general text,,0,0,0,,Dahil hindi na tayo magiging guro at estudyante?
Dialogue: 0,0:23:51.96,0:23:54.30,general text,,0,0,0,,Hindi mo na ako kailangang protektahan,
Dialogue: 0,0:23:54.38,0:23:56.34,pangkalahatang teksto,,0,0,0,,at hindi ko na kailangang sumuko
Dialogue: 0,0:23:57.72,0:24:00.13,general text,,0,0,0,,Iyon ang kasunduan namin
Dialogue: 0,0:24:07.81,0:24:09.39,pangkalahatang teksto,,0,0,0,,Pagkatapos ay ipangako mo sa akin ang isa pang bagay
Dialogue: 0,0:24:10.10,0:24:12.40,pangkalahatang teksto,,0,0,0,,Dahil sa pakiramdam ng tungkulin at katapatan,
Dialogue: 0,0:24:12.48,0:24:16.53,general text,,0,0,0,,and so-called love, may iba ka pa bang maipapangako sa akin?
Dialogue: 0,0:24:18.07,0:24:19.86,pangkalahatang teksto,,0,0,0,,Okay. ano gusto mo
Dialogue: 0,0:24:20.57,0:24:22.11,pangkalahatang teksto,,0,0,0,,Kung ibabalik mo ang lakas,
Dialogue: 0,0:24:22.74,0:24:25.28,pangkalahatang teksto,,0,0,0,,kailangan mong ituro ang isang espada sa isang tao,
Dialogue: 0,0:24:26.37,0:24:28.12,pangkalahatang teksto,,0,0,0,, hayaan mo akong mauna
Dialogue: 0,0:24:31.17,0:24:32.21,pangkalahatang teksto,,0,0,0,,Kung mamatay ako,
Dialogue: 0,0:24:32.83,0:24:37.63,general text,,0,0,0,,ibig sabihin binawian ng killer ang buhay ko
Dialogue: 0,0:24:41.38,0:24:42.72,pangkalahatang teksto,,0,0,0,,Kung hindi,
Dialogue: 0,0:24:43.64,0:24:45.76,general text,,0,0,0,,Bibigyan kita ng isa pang pangako
Dialogue: 0,0:24:47.52,0:24:49.39,pangkalahatang teksto,,0,0,0,, Parang pangako,
Dialogue: 0,0:24:49.48,0:24:53.77,general text,,0,0,0,,na gusto mong marinig mula sa akin tungkol sa ating kinabukasan
Dialogue: 0,0:25:02.20,0:25:05.53,general text,,0,0,0,,Hahanapin ko ang batong yelo at hindi ka magiging ligaw,
Dialogue: 0,0:25:06.95,0:25:08.54,general text,,0,0,0,,dahil nangako ako sayo
Dialogue: 0,0:25:19.71,0:25:21.42,pangkalahatang teksto,,0,0,0,,Raway na mag-asawa
Dialogue: 0,0:25:22.47,0:25:23.93,pangkalahatang teksto,,0,0,0,,ay mananatili
Dialogue: 0,0:25:25.76,0:25:28.01,general text,,0,0,0,,Nandito ba si Dan Gu?
Dialogue: 0,0:25:30.56,0:25:34.69,general text,,0,0,0,,Bakit mo sila pinapasok?
Dialogue: 0,0:25:34.77,0:25:35.94,pangkalahatang teksto,,0,0,0,,Kinakailangan
Dialogue: 0,0:25:36.02,0:25:37.86,pangkalahatang teksto,,0,0,0,,hayaan silang pumunta sa lungsod,
Dialogue: 0,0:25:37.94,0:25:41.36,general text,,0,0,0,,upang magtayo sila ng love nest para sa libangan ng buong lungsod?
Dialogue: 0,0:25:43.40,0:25:44.61,pangkalahatang teksto,,0,0,0,,Dalagang Kim,
Dialogue: 0,0:25:44.70,0:25:47.78,pangkalahatang teksto,,0,0,0,,Nahihiya ako at nagpapasalamat
Dialogue: 0,0:25:47.87,0:25:50.29,general text,,0,0,0,,Napaka-cute nilang mag-asawa
Dialogue: 0,0:25:50.37,0:25:52.12,pangkalahatang teksto,,0,0,0,,Bakit ka tutol dito?
Dialogue: 0,0:25:52.20,0:25:54.46,general text,,0,0,0,,Hindi sila pwedeng magpakasal
Dialogue: 0,0:25:54.54,0:25:56.33,general text,,0,0,0,,At kaya mo sila pinaalis?
Dialogue: 0,0:25:56.92,0:25:58.75,pangkalahatang teksto,,0,0,0,,Iwanan ang kakila-kilabot na ugali
Dialogue: 0,0:25:59.88,0:26:03.34,general text,,0,0,0,,Kagabi hinawakan mo si Moo Deok at Mr. Master ng walang dahilan
Dialogue: 0,0:26:03.42,0:26:05.63,pangkalahatang teksto,,0,0,0,,Kailangan mong maging mas mapagparaya sa edad
Dialogue: 0,0:26:06.22,0:26:07.34,pangkalahatang teksto,,0,0,0,,Pareho sa akin...
Dialogue: 0,0:26:09.18,0:26:11.35,memories italics,,0,0,0,,Mahal ko si Moo Deok
Dialogue: 0,0:26:11.43,0:26:14.35,memories italics,,0,0,0,,mahal na mahal ko ang may-ari
Dialogue: 0,0:26:15.23,0:26:16.15,pangkalahatang teksto,,0,0,0,,Maiden Kim
Dialogue: 0,0:26:16.90,0:26:19.36,pangkalahatang teksto,,0,0,0,,If Wook, tulad ni Dan Gu,
Dialogue: 0,0:26:20.73,0:26:23.53,pangkalahatang teksto,,0,0,0,, mamahalin ang hindi dapat,
Dialogue: 0,0:26:24.20,0:26:25.15,general text,,0,0,0,,ano ang gagawin mo?
Dialogue: 0,0:26:25.24,0:26:27.24,general text,,0,0,0,,Magpaparaya ka ba?
Dialogue: 0,0:26:31.79,0:26:35.33,general text,,0,0,0,,Susuportahan ko ang anumang pagpipilian ni Mr.
Dialogue: 0,0:26:35.41,0:26:37.17,general text,,0,0,0,,- Talaga?\N- Syempre
Dialogue: 0,0:26:40.09,0:26:41.13,pangkalahatang teksto,,0,0,0,,Wala akong duda
Dialogue: 0,0:26:41.75,0:26:43.84,pangkalahatang teksto,,0,0,0,,alam na alam ko kung ano ang bumabagabag sa iyo
Dialogue: 0,0:26:43.92,0:26:46.88,pangkalahatang teksto,,0,0,0,,petsa ng kapanganakan, hitsura, edad at lahat ng iyon
Dialogue: 0,0:26:46.97,0:26:48.55,pangkalahatang teksto,,0,0,0,,Ang puso ang pinakamahalaga
Dialogue: 0,0:26:49.14,0:26:52.06,general text,,0,0,0,,Kung inlove ka, hindi mahalaga ang hitsura
Dialogue: 0,0:26:52.81,0:26:55.18,general text,,0,0,0,,Kahit hindi siya kagandahan
Dialogue: 0,0:26:55.27,0:26:57.65,pangkalahatang teksto,,0,0,0,,o kung sila ay may malaking pagkakaiba sa edad
Dialogue: 0,0:27:03.82,0:27:07.32,pangkalahatang teksto,,0,0,0,,Kaya iyon ang iniisip mo,
Dialogue: 0,0:27:08.49,0:27:09.62,pangkalahatang teksto,,0,0,0,,oo?
Dialogue: 0,0:27:09.70,0:27:10.87,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:27:14.25,0:27:17.71,general text,,0,0,0,,Sinumang hindi kasing gwapo ni Chang Gan
Dialogue: 0,0:27:18.62,0:27:20.25,pangkalahatang teksto,,0,0,0,,at kung sino ang mas matanda,
Dialogue: 0,0:27:20.33,0:27:23.84,pangkalahatang teksto,,0,0,0,,magkakaroon pa rin ng pagkakataon,
Dialogue: 0,0:27:25.34,0:27:26.72,general text,,0,0,0,,kung naantig ang puso mo?
Dialogue: 0,0:27:28.47,0:27:29.59,pangkalahatang teksto,,0,0,0,,Well...
Dialogue: 0,0:27:33.01,0:27:34.56,pangkalahatang teksto,,0,0,0,,Kung ang puso ko ay naantig,
Dialogue: 0,0:27:36.27,0:27:39.14,pangkalahatang teksto,,0,0,0,,mas maganda ito
Dialogue: 0,0:27:39.23,0:27:40.52,pangkalahatang text,,0,0,0,,at mas bata sa paningin ko
Dialogue: 0,0:27:53.28,0:27:56.04,general text,,0,0,0,,I see, maid Kim
Dialogue: 0,0:27:57.33,0:27:58.58,pangkalahatang teksto,,0,0,0,,Naiintindihan kita
Dialogue: 0,0:28:16.31,0:28:21.19,general text,,0,0,0,,Napaka-prangka niya nang tanungin niya ang nararamdaman ko para sa kanya.
Dialogue: 0,0:28:22.61,0:28:24.82,pangkalahatang teksto,,0,0,0,,At ano ang ibig sabihin ng "hindi maganda"?
Dialogue: 0,0:28:24.90,0:28:26.90,general text,,0,0,0,,Matanda lang siya ng dalawang taon
Dialogue: 0,0:28:30.07,0:28:31.78,pangkalahatang teksto,,0,0,0,,Mga alalahanin nang wala saan
Dialogue: 0,0:28:42.42,0:28:46.55,general text,,0,0,0,,Paano niya nasabi sa akin nang ganoon kadali,
Dialogue: 0,0:28:46.63,0:28:48.38,general text,,0,0,0,,ano ang gusto ni Master Li?
Dialogue: 0,0:28:52.43,0:28:54.14,general text,,0,0,0,,Gwapo ba siya?
Dialogue: 0,0:28:56.06,0:28:59.48,pangkalahatang teksto,,0,0,0,,Matanda siya sa kanya ng mahigit isang daang taon
Dialogue: 0,0:29:09.94,0:29:11.11,pangkalahatang teksto,,0,0,0,,Pak Dan Gu...
Dialogue: 0,0:29:11.78,0:29:13.70,general text,,0,0,0,,You little bastard!
Dialogue: 0,0:29:17.49,0:29:18.83,pangkalahatang teksto,,0,0,0,,Ngayon
Dialogue: 0,0:29:20.20,0:29:23.96,general text,,0,0,0,,Mas gusto ko ang hidden wine ng tiyuhin ko
Dialogue: 0,0:29:25.13,0:29:26.38,pangkalahatang text,,0,0,0,,tsa sa halip
Dialogue: 0,0:29:26.46,0:29:28.92,pangkalahatang teksto,,0,0,0,,Ano? Nagsisisi na?
Dialogue: 0,0:29:29.51,0:29:30.55,pangkalahatang teksto,,0,0,0,,Hindi!
Dialogue: 0,0:29:31.22,0:29:34.55,general text,,0,0,0,,Akala ko kaya kong isuko ang lahat
Dialogue: 0,0:29:34.64,0:29:37.39,general text,,0,0,0,,So kinuha ko yung kamay niya then
Dialogue: 0,0:29:39.64,0:29:42.94,italics,,0,0,0,,Hindi ko inaasahan na bigla niyang hinawakan ang kamay ko.
Dialogue: 0,0:29:43.69,0:29:46.61,general text,,0,0,0,,nagalit lang ako na pinag-uusapan nila ang Crown Prince
Dialogue: 0,0:29:46.69,0:29:49.11,general text,,0,0,0,,At sinabi ko na hindi ko siya gusto
Dialogue: 0,0:29:49.73,0:29:52.11,general text,,0,0,0,,At bigla niyang hinawakan ang kamay ko at ipinagtapat ang kanyang pagmamahal.
Dialogue: 0,0:29:52.19,0:29:53.45,pangkalahatang teksto,,0,0,0,,Ilipat ng kaunti
Dialogue: 0,0:29:56.49,0:29:58.66,general text,,0,0,0,,Hindi ko mabitawan ang kamay niya
Dialogue: 0,0:29:58.74,0:30:00.83,general text,,0,0,0,,Nalilito lang ako
Dialogue: 0,0:30:01.75,0:30:04.42,general text,,0,0,0,,Hindi ko man lang naisip na tumakas sa bahay
Dialogue: 0,0:30:06.04,0:30:07.71,general text,,0,0,0,,Gaano ka katagal dito?
Dialogue: 0,0:30:09.25,0:30:11.76,general text,,0,0,0,,Inutusan akong pagsilbihan kayong dalawa habang nandito kayo
Dialogue: 0,0:30:14.01,0:30:15.47,pangkalahatang teksto,,0,0,0,,Walang ideya
Dialogue: 0,0:30:15.55,0:30:17.68,general text,,0,0,0,,Ayokong magtagal dito
Dialogue: 0,0:30:18.55,0:30:21.81,general text,,0,0,0,,Kung sasabihin ko na dapat na tayong umuwi,
Dialogue: 0,0:30:21.89,0:30:24.06,general text,,0,0,0,,tapos magmumukha akong iresponsable di ba?
Dialogue: 0,0:30:24.14,0:30:27.06,general text,,0,0,0,,Kung sasabihin kong gusto ko nang umuwi, I'll break his heart, right?
Dialogue: 0,0:30:28.11,0:30:29.77,pangkalahatang teksto,,0,0,0,,- Ano ang dapat kong gawin?\N- Ano ang dapat kong gawin?
Dialogue: 0,0:30:31.48,0:30:33.03,pangkalahatang teksto,,0,0,0,,Lahat ay para sa ikabubuti
Dialogue: 0,0:30:33.11,0:30:35.20,pangkalahatang teksto,,0,0,0,,Paglingkuran si Lady Jin dito
Dialogue: 0,0:30:35.28,0:30:37.66,pangkalahatang teksto,,0,0,0,,mas mabuti kaysa makipagkita kay Pak Jin sa Sosnovy Bor
Dialogue: 0,0:30:37.74,0:30:42.24,pangkalahatang teksto,,0,0,0,,Kung si So Yi ang nasa likod ng mga pagpatay na inakusahan ka,
Dialogue: 0,0:30:42.87,0:30:44.00,pangkalahatang teksto,,0,0,0,,kung gayon ito ay mapanganib
Dialogue: 0,0:30:44.08,0:30:47.79,general text,,0,0,0,,Hindi mo siya kilala, pero kilala niya si Moo Deok
Dialogue: 0,0:30:49.71,0:30:52.67,pangkalahatang teksto,,0,0,0,,Bakit naglilibot si So Yi sa pagpatay ng mga tao?
Dialogue: 0,0:30:56.55,0:30:58.72,italics,,0,0,0,,Kung ang babaeng bulag na hinahanap ng mga bandido,
Dialogue: 0,0:30:58.80,0:31:00.68,pangkalahatang teksto,,0,0,0,,ito ay pareho Kaya ako,
Dialogue: 0,0:31:01.18,0:31:02.93,general text,,0,0,0,,at hindi niya kayang patayin ang mga ito mismo
Dialogue: 0,0:31:03.02,0:31:04.52,general text,,0,0,0,,Sa tingin ko may kasabwat siya
Dialogue: 0,0:31:04.60,0:31:07.81,general text,,0,0,0,,Kung kukunin ng mga awtoridad ang mga bangkay na ito, mahuhuli nila ang pumatay
Dialogue: 0,0:31:08.60,0:31:10.27,pangkalahatang teksto,,0,0,0,,Kilala ni Mu Deok si So Yi
Dialogue: 0,0:31:10.36,0:31:12.61,general text,,0,0,0,,Siya ay dapat tumulong sa imbestigasyon
Dialogue: 0,0:31:13.82,0:31:15.53,voiceover,,0,0,0,,Hindi niya kilala si So Yi
Dialogue: 0,0:31:15.61,0:31:18.07,behind the scenes,,0,0,0,,Hindi siya si Moo Dok na nakatira sa Sari village
Dialogue: 0,0:31:18.16,0:31:21.08,pangkalahatang teksto,,0,0,0,,Siya ay maling akusahan at magdurusa
Dialogue: 0,0:31:21.16,0:31:24.04,general text,,0,0,0,,Kung kinakailangan, ako mismo ang magtatanong sa kanya
Dialogue: 0,0:31:31.13,0:31:34.38,pangkalahatang teksto,,0,0,0,,Mas mabuting huwag makialam. Alam ni Yul ang ginagawa niya
Dialogue: 0,0:31:41.80,0:31:44.60,general text,,0,0,0,,Magkakagulo kapag nalaman ng deputy na wala ka sa bahay
Dialogue: 0,0:31:45.10,0:31:47.85,general text,,0,0,0,,Lahat ng nakakakilala sa akin ay pinatay
Dialogue: 0,0:31:47.94,0:31:50.19,general text,,0,0,0,,Darating ako sa Jinyoewon - Kailangan ko pang lumabas
Dialogue: 0,0:31:50.27,0:31:52.40,general text,,0,0,0,,Kailangan nating magsanay para maniwala sila sa akin
Dialogue: 0,0:31:53.52,0:31:54.98,pangkalahatang teksto,,0,0,0,,Bilhin ang gusto mo
Dialogue: 0,0:31:55.07,0:31:56.99,general text,,0,0,0,,Binigyan kita ng maraming pera
Dialogue: 0,0:31:58.53,0:32:00.11,general text,,0,0,0,,Balik tayo agad
Dialogue: 0,0:32:01.45,0:32:02.70,pangkalahatang text,,0,0,0,,Maghintay
Dialogue: 0,0:32:03.58,0:32:05.83,pangkalahatang teksto,,0,0,0,,Bakit ka gumagamit ng payong sa halip na tungkod?
Dialogue: 0,0:32:07.83,0:32:09.00,pangkalahatang text,,0,0,0,,Huwag hawakan
Dialogue: 0,0:32:11.00,0:32:12.38,pangkalahatang teksto,,0,0,0,,gusto ko ito
Dialogue: 0,0:32:24.35,0:32:27.22,pangkalahatang text,,0,0,0,,Tulungan mong linisin ang pangalan ko
Dialogue: 0,0:32:27.31,0:32:29.60,general text,,0,0,0,,Sana mag-enjoy kayo dito
Dialogue: 0,0:32:29.69,0:32:31.94,general text,,0,0,0,,Palagi bang ganito kumakain ang pamilya Chan?
Dialogue: 0,0:32:33.19,0:32:34.40,pangkalahatang teksto,,0,0,0,,Masyadong matapang
Dialogue: 0,0:32:37.73,0:32:40.65,general text,,0,0,0,,Okay, madam. Magluluto ako ng iba
Dialogue: 0,0:32:49.91,0:32:51.67,pangkalahatang teksto,,0,0,0,,Masyadong maalat!
Dialogue: 0,0:32:54.08,0:32:56.04,pangkalahatang teksto,,0,0,0,,- Sariwa?\N- Maalat
Dialogue: 0,0:32:56.13,0:32:58.34,general text,,0,0,0,,Bumaga ang tiyan ko dahil sa maalat na pagkain
Dialogue: 0,0:33:01.05,0:33:02.30,general text,,0,0,0,,Okay, madam
Dialogue: 0,0:33:05.35,0:33:06.43,pangkalahatang teksto,,0,0,0,,Masyadong mahirap
Dialogue: 0,0:33:06.51,0:33:08.35,pangkalahatang teksto,,0,0,0,,Masyadong matamis
Dialogue: 0,0:33:09.56,0:33:10.85,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:33:12.10,0:33:13.94,general text,,0,0,0,,Nag-aalala ako na nawalan ako ng gana
Dialogue: 0,0:33:15.98,0:33:19.19,voiceover,,0,0,0,,Bakit parang Uk siya?
Dialogue: 0,0:33:19.90,0:33:21.20,general text,,0,0,0,,Wala akong gana
Dialogue: 0,0:33:21.28,0:33:22.78,general text,,0,0,0,,May maiinom ba?
Dialogue: 0,0:33:22.86,0:33:24.45,pangkalahatang teksto,,0,0,0,,Cinnamon tea o seekhe*
Dialogue: 0,0:33:22.86,0:33:24.45,notes,,0,0,0,,*matamis na inuming kanin
Dialogue: 0,0:33:29.95,0:33:32.54,pangkalahatang teksto,,0,0,0,,Ginawa lang sila para sa isa't isa. Dapat nagpakasal na tayo!
Dialogue: 0,0:33:32.62,0:33:36.13,general text,,0,0,0,,Kung gayon isa sa kanila ay tiyak na mamamatay sa isang away
Dialogue: 0,0:33:40.92,0:33:42.09,pangkalahatang teksto,,0,0,0,,Mu Dok, sikh...
Dialogue: 0,0:33:42.17,0:33:44.30,pangkalahatang teksto,,0,0,0,,Sweet? Masyadong malamig?
Dialogue: 0,0:33:44.93,0:33:47.05,pangkalahatang teksto,,0,0,0,,Ganito dapat
Dialogue: 0,0:33:47.76,0:33:49.43,general text,,0,0,0,,Bakit ka sumisigaw?
Dialogue: 0,0:33:49.52,0:33:51.06,general text,,0,0,0,,Pagod ka na bang pagsilbihan ako?
Dialogue: 0,0:33:51.93,0:33:54.10,pangkalahatang text,,0,0,0,,Sa tingin mo ba madali kang pasayahin?
Dialogue: 0,0:33:56.52,0:33:58.77,general text,,0,0,0,,Nagiging iritable ako kapag nag-aalala
Dialogue: 0,0:33:58.86,0:34:00.82,pangkalahatang text,,0,0,0,,Nakakapagod ang malayo sa bahay
Dialogue: 0,0:34:00.90,0:34:02.69,general text,,0,0,0,,Pagkatapos ay umuwi ka na
Dialogue: 0,0:34:03.74,0:34:06.49,pangkalahatang teksto,,0,0,0,,Hindi, natatakot ako
Dialogue: 0,0:34:06.57,0:34:08.53,general text,,0,0,0,,Galit na galit si mama sa akin
Dialogue: 0,0:34:10.04,0:34:13.41,general text,,0,0,0,,Anong klase kang anak?
Dialogue: 0,0:34:13.50,0:34:15.42,general text,,0,0,0,,Hindi ako naging paborito niya
Dialogue: 0,0:34:16.58,0:34:18.75,pangkalahatang teksto,,0,0,0,,Ang aking kapatid na babae ang kanyang pagmamalaki at kagalakan
Dialogue: 0,0:34:20.63,0:34:22.63,pangkalahatang teksto,,0,0,0,,Kahit na siya ay bulag,
Dialogue: 0,0:34:22.71,0:34:24.72,pangkalahatang teksto,,0,0,0,,nakakita ng enerhiya at nakipag-ugnayan sa mga labi
Dialogue: 0,0:34:24.80,0:34:27.55,general text,,0,0,0,,Hindi siya hamak sa lakas sa kanyang ina kahit sa murang edad.
Dialogue: 0,0:34:27.64,0:34:30.47,general text,,0,0,0,,Well, narinig ko na ang mga miyembro ng pamilyang Jin ay karamihan
Dialogue: 0,0:34:30.56,0:34:33.35,pangkalahatang teksto,,0,0,0,,pamahalaan ang kapangyarihan ng langit, at huwag gumawa ng mga spelling
Dialogue: 0,0:34:33.93,0:34:36.10,general text,,0,0,0,,Nakita mo naman kung paano ko tratuhin si Gwigu diba?
Dialogue: 0,0:34:36.77,0:34:38.31,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:34:38.40,0:34:40.19,pangkalahatang teksto,,0,0,0,,Malakas na Priestess
Dialogue: 0,0:34:40.27,0:34:43.69,pangkalahatang teksto,,0,0,0,,maaaring kontrolin ang mga kaluluwa ng mga tao at maakit sila sa mga bitag
Dialogue: 0,0:34:44.61,0:34:46.95,pangkalahatang teksto,,0,0,0,,- Mang-akit sa mga bitag?\N- Oo
Dialogue: 0,0:34:47.03,0:34:49.07,pangkalahatang teksto,,0,0,0,,Kung bitag ng priestes ang pwersa,
Dialogue: 0,0:34:49.16,0:34:52.66,pangkalahatang teksto,,0,0,0,,kahit ang pinakamakapangyarihang salamangkero ay hindi makakatakas
Dialogue: 0,0:34:54.58,0:34:57.00,general text,,0,0,0,,Narinig ko na kaya ng mga shaman
Dialogue: 0,0:34:57.08,0:34:59.25,pangkalahatang teksto,,0,0,0,,burahin at baguhin ang mga alaala
Dialogue: 0,0:34:59.33,0:35:02.05,pangkalahatang text,,0,0,0,,Priestesses ni Jinyeowon sa ibang level
Dialogue: 0,0:35:02.13,0:35:05.26,general text,,0,0,0,,At paano namatay ang babaeng iyon?
Dialogue: 0,0:35:06.80,0:35:08.34,pangkalahatang teksto,,0,0,0,,Siya ay talagang hindi kapani-paniwala
Dialogue: 0,0:35:10.05,0:35:12.06,general text,,0,0,0,,Siya ay tiyak na buhay
Dialogue: 0,0:35:13.89,0:35:15.52,general text,,0,0,0,,At makikita natin siyang muli
Dialogue: 0,0:35:21.77,0:35:23.19,pangkalahatang teksto,,0,0,0,,Kung siya ay buhay,
Dialogue: 0,0:35:24.15,0:35:25.57,pangkalahatang teksto,,0,0,0,,makikita mo, nang walang pag-aalinlangan
Dialogue: 0,0:35:34.41,0:35:37.37,general text,,0,0,0,,Tinanong ni Uncle si Moo Deok
Dialogue: 0,0:35:37.96,0:35:40.88,general text,,0,0,0,,Nagtanong ba siya sa merchant tungkol sa kanya?
Dialogue: 0,0:35:41.75,0:35:43.50,pangkalahatang teksto,,0,0,0,,Oo. Sabi ni Moo Deok
Dialogue: 0,0:35:45.51,0:35:47.92,pangkalahatang teksto,,0,0,0,,Lahat dahil sa insidenteng iyon sa nomad
Dialogue: 0,0:35:48.51,0:35:49.43,general text,,0,0,0,,Tama ka
Dialogue: 0,0:35:49.51,0:35:53.81,general text,,0,0,0,,Kung may mga nomad sa palasyo, maaaring nasa Sosnovy Bor din sila
Dialogue: 0,0:35:54.68,0:35:58.52,pangkalahatang teksto,,0,0,0,,Bakit nababahala ang ipinatapon na kahalili ni Sosnovy Bor tungkol dito?
Dialogue: 0,0:35:58.60,0:36:02.73,general text,,0,0,0,,- Hindi ako exile\N- Nagsisisi na siya
Dialogue: 0,0:36:02.81,0:36:03.65,pangkalahatang text,,0,0,0,,Hey
Dialogue: 0,0:36:03.73,0:36:06.07,general text,,0,0,0,,Sigurado ka kahapon
Dialogue: 0,0:36:08.40,0:36:10.03,pangkalahatang text,,0,0,0,,Lagi na pinapaalis si Uka
Dialogue: 0,0:36:10.11,0:36:11.53,general text,,0,0,0,,Anong ginagawa ko dito?
Dialogue: 0,0:36:11.62,0:36:13.74,general text,,0,0,0,,Masanay ka na
Dialogue: 0,0:36:13.83,0:36:17.04,general text,,0,0,0,,Well, malulungkot sa una
Dialogue: 0,0:36:18.66,0:36:20.58,general text,,0,0,0,,Si Yul lang ang hindi nakadaan dito
Dialogue: 0,0:36:20.67,0:36:21.83,pangkalahatang teksto,,0,0,0,,Ano ang pinagsasabi mo?
Dialogue: 0,0:36:21.92,0:36:23.00,general text,,0,0,0,,Si Yulia ay pinalayas din
Dialogue: 0,0:36:23.09,0:36:24.17,pangkalahatang teksto,,0,0,0,,Hindi maaaring
Dialogue: 0,0:36:24.88,0:36:27.05,pangkalahatang teksto,,0,0,0,,Tandaan, nabasag ko ang ginintuan na bato ng tinta,
Dialogue: 0,0:36:27.13,0:36:28.63,general text,,0,0,0,,at nagsinungaling tayong lahat?
Dialogue: 0,0:36:33.76,0:36:37.14,mga alaala,,0,0,0,,Gagalit sa akin si tito
Dialogue: 0,0:36:37.72,0:36:38.60,mga alaala,,0,0,0,,Itago natin ito
Dialogue: 0,0:36:39.56,0:36:41.65,mga alaala,,0,0,0,,Ilibing natin siya at magkunwaring wala tayong alam
Dialogue: 0,0:36:42.23,0:36:43.44,mga alaala,,0,0,0,,Mali ito
Dialogue: 0,0:36:44.27,0:36:46.57,mga alaala,,0,0,0,,Dapat nating sabihin ang totoo at humingi ng tawad
Dialogue: 0,0:36:46.65,0:36:49.74,mga alaala,,0,0,0,,Pagkatapos ay malalagay sa malaking problema si Dan Gu
Dialogue: 0,0:36:52.78,0:36:54.78,mga alaala,,0,0,0,,Hindi ako makapagsinungaling
Dialogue: 0,0:36:56.33,0:36:58.08,mga alaala,,0,0,0,,Magiging maayos ang lahat, Dan Gu
Dialogue: 0,0:36:58.95,0:37:00.58,mga alaala,,0,0,0,,Kakayanin natin
Dialogue: 0,0:37:02.79,0:37:06.46,italics,,0,0,0,,Napagkasunduan naming lahat na itago ito
Dialogue: 0,0:37:06.55,0:37:08.96,italics,,0,0,0,,Pero pagkatapos noon ay nagkasakit si Yul
Dialogue: 0,0:37:09.55,0:37:12.51,memories,,0,0,0,,Sobrang sakit yata ni Yul
Dialogue: 0,0:37:12.59,0:37:13.80,mga alaala,,0,0,0,,I think so too
Dialogue: 0,0:37:15.72,0:37:20.06,memories,,0,0,0,,Bakit kaya nagkasakit si Yul? Anong nangyari?
Dialogue: 0,0:37:20.64,0:37:24.15,mga alaala,,0,0,0,,Narinig kong mahina siyang kumakain at mahina ang tulog
Dialogue: 0,0:37:24.23,0:37:25.31,memories italics,,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:37:26.69,0:37:29.74,italics,,0,0,0,,Walang ginawang mali si Yul
Dialogue: 0,0:37:29.82,0:37:32.24,italics,,0,0,0,,Nagkasakit siya, nag-aalala na baka mahuli kami
Dialogue: 0,0:37:33.07,0:37:36.45,general text,,0,0,0,,Nagtapat kami sa balyena dahil akala namin mamamatay si Yul
Dialogue: 0,0:37:36.53,0:37:38.66,general text,,0,0,0,,At lahat kami ay pinalayas
Dialogue: 0,0:37:38.74,0:37:42.04,general text,,0,0,0,,Na-kick out ako ng maraming beses na hindi ko na maalala.
Dialogue: 0,0:37:42.12,0:37:45.67,general text,,0,0,0,,Pero duda ako na may sakit si Yul sa takot na mahuli.
Dialogue: 0,0:37:47.09,0:37:49.80,pangkalahatang teksto,,0,0,0,,Nagdusa siya dahil naiintindihan niya na siya ay kumilos nang masama
Dialogue: 0,0:37:50.46,0:37:53.63,general text,,0,0,0,,at mahirap para sa kanya na tanggapin ang katotohanang ito
Dialogue: 0,0:37:57.97,0:38:00.14,pangkalahatang teksto,,0,0,0,,Naliligaw siya kapag nahuli siya nang hindi nagbabantay
Dialogue: 0,0:38:01.85,0:38:04.81,general text,,0,0,0,,Tiyak na nag-aalala at natatakot siyang gawin...
Dialogue: 0,0:38:05.60,0:38:07.11,pangkalahatang teksto,,0,0,0,,may mali
Dialogue: 0,0:38:08.69,0:38:10.19,pangkalahatang teksto,,0,0,0,,para sa kapakanan ng iyong mga kaibigan
Dialogue: 0,0:38:15.32,0:38:17.78,pangkalahatang teksto,,0,0,0,,Oo. Naaalala ko ito nang husto
Dialogue: 0,0:38:19.12,0:38:20.54,pangkalahatang teksto,,0,0,0,,Pinahirapan ako nito
Dialogue: 0,0:38:21.62,0:38:23.54,pangkalahatang teksto,,0,0,0,,Parusahan ang iyong sarili nang mas matindi,
Dialogue: 0,0:38:23.62,0:38:26.50,pangkalahatang teksto,,0,0,0,,kaysa sa iba
Dialogue: 0,0:38:26.58,0:38:28.84,pangkalahatang teksto,,0,0,0,,Ito ba ay isang uri ng mas mataas na pakiramdam ng moralidad?
Dialogue: 0,0:38:29.54,0:38:32.30,general text,,0,0,0,,Ganyan ka ba noong bata ka?
Dialogue: 0,0:38:32.38,0:38:33.42,pangkalahatang teksto,,0,0,0,,Hindi kapani-paniwala
Dialogue: 0,0:38:35.09,0:38:37.84,general text,,0,0,0,,Imagine how I felt buriing that stone with my
Dialogue: 0,0:38:37.93,0:38:39.35,general text,,0,0,0,,iresponsableng mga kaibigan?
Dialogue: 0,0:38:40.68,0:38:43.18,pangkalahatang teksto,,0,0,0,,Hindi man lang namin ito maibaon. Mabilis kaming nadiskubre
Dialogue: 0,0:38:43.27,0:38:44.56,general text,,0,0,0,,- Ano?\N- Ano?
Dialogue: 0,0:38:44.64,0:38:47.35,general text,,0,0,0,,Nalantad na ba tayo? Sabi mo, umamin tayo
Dialogue: 0,0:38:47.94,0:38:49.94,italics,,0,0,0,,Hindi masyadong natatandaan ni Dan Gu
Dialogue: 0,0:38:50.02,0:38:51.44,general text,,0,0,0,,Hindi kami umamin
Dialogue: 0,0:38:52.48,0:38:55.90,pangkalahatang teksto,,0,0,0,,Nakakita si San Ho ng kalahating nakabaon na bato. Iyon ay kung paano kami natuklasan
Dialogue: 0,0:38:56.53,0:38:57.66,general text,,0,0,0,,Totoo ba ito?
Dialogue: 0,0:38:58.24,0:38:59.74,pangkalahatang teksto,,0,0,0,,Mukhang pinaganda ko ito ng kaunti
Dialogue: 0,0:39:01.12,0:39:03.41,pangkalahatang teksto,,0,0,0,,Akala ko kumilos kami ng marangal
Dialogue: 0,0:39:03.50,0:39:05.08,pangkalahatang teksto,,0,0,0,,Nakakahiya...
Dialogue: 0,0:39:05.16,0:39:08.00,pangkalahatang teksto,,0,0,0,,Ano ang dapat ikahiya?
Dialogue: 0,0:39:08.08,0:39:10.21,pangkalahatang teksto,,0,0,0,,Na-kick out ka kamakailan
Dialogue: 0,0:39:10.29,0:39:13.00,general text,,0,0,0,,Sino ang susunod na head sa halip na si Dan Gu?
Dialogue: 0,0:39:14.26,0:39:15.17,general text,,0,0,0,,Si Sang Ho?
Dialogue: 0,0:39:15.26,0:39:16.63,italics,,0,0,0,,Sa tingin mo?
Dialogue: 0,0:39:16.72,0:39:19.01,pangkalahatang text,,0,0,0,,Tapos kakampi ko siya
Dialogue: 0,0:39:19.97,0:39:22.22,general text,,0,0,0,,You can't give up on me like that
Dialogue: 0,0:39:22.31,0:39:24.22,general text,,0,0,0,,You should be on my side actually
Dialogue: 0,0:39:24.31,0:39:26.18,pangkalahatang teksto,,0,0,0,,Halika, Uk
Dialogue: 0,0:39:26.27,0:39:28.81,pangkalahatang text,,0,0,0,,Hindi ko talaga matutulungan
Dialogue: 0,0:39:29.65,0:39:32.61,general text,,0,0,0,,- Hoy, Yul\N- Hindi ako masyadong magaling magsalita
Dialogue: 0,0:39:33.11,0:39:34.32,general text,,0,0,0,,Lalo na sa pag-ibig
Dialogue: 0,0:39:42.91,0:39:44.41,general text,,0,0,0,,Syempre pareho kayo sa side ko
Dialogue: 0,0:40:02.76,0:40:05.56,italics,,0,0,0,,Yul, mahina ka na bang natutulog kanina?
Dialogue: 0,0:40:05.64,0:40:08.64,pangkalahatang teksto,,0,0,0,,Ngayon maaari kang uminom hangga't gusto mo
Dialogue: 0,0:40:08.73,0:40:10.73,pangkalahatang teksto,,0,0,0,,At pagkatapos nito, matulog ng mahimbing
Dialogue: 0,0:40:12.06,0:40:14.07,general text,,0,0,0,,May problema ka ba sa pagtulog?
Dialogue: 0,0:40:14.69,0:40:15.69,pangkalahatang teksto,,0,0,0,,Hindi
Dialogue: 0,0:40:15.78,0:40:17.36,general text,,0,0,0,,Nakita kitang gumagala hanggang gabi
Dialogue: 0,0:40:17.44,0:40:19.24,pangkalahatang teksto,,0,0,0,,Karaniwang maaga kang natutulog
Dialogue: 0,0:40:19.32,0:40:22.62,general text,,0,0,0,,Nag-aalala ka ba sa nangyayari sa Soho Fortress?
Dialogue: 0,0:40:29.92,0:40:32.38,memories italics,,0,0,0,,Nakapatay lang ako ng nomad
Dialogue: 0,0:40:33.75,0:40:35.84,mga alaala na italics,,0,0,0,,Protektahan ang mundo mula sa mga halimaw -
Dialogue: 0,0:40:36.84,0:40:38.34,mga alaala na italics,,0,0,0,,aming responsibilidad
Dialogue: 0,0:40:39.97,0:40:41.89,memories italics,,0,0,0,,Kahit patay, ito si Gwigu
Dialogue: 0,0:40:42.43,0:40:43.85,mga alaala,,0,0,0,,Malamang na ang lahat ng enerhiya ay umalis sa katawan
Dialogue: 0,0:40:43.93,0:40:45.43,mga alaala,,0,0,0,,Huwag hawakan
Dialogue: 0,0:40:52.56,0:40:54.61,general text,,0,0,0,,Nagpapanggap ka ba na wala kang alam?
Dialogue: 0,0:40:58.07,0:41:00.03,general text,,0,0,0,,Tulad noong pagkabata, noong nagbaon sila ng bato
Dialogue: 0,0:41:01.36,0:41:04.37,pangkalahatang teksto,,0,0,0,,Mahirap para sa iyo
Dialogue: 0,0:41:22.59,0:41:24.80,voiceover,,0,0,0,,Kung babalik ang aking lakas at bunot ako ng aking espada,
Dialogue: 0,0:41:26.85,0:41:30.89,voiceover,,0,0,0,,kaya ko bang pumatay ulit ng walang awa gaya ng dati?
Dialogue: 0,0:41:35.69,0:41:37.44,general text,,0,0,0,,Ito ang espada ng mamamatay-tao?
Dialogue: 0,0:41:39.03,0:41:41.32,general text,,0,0,0,,Bakit siya dinala ulit ng master dito?
Dialogue: 0,0:41:42.32,0:41:45.82,pangkalahatang text,,0,0,0,,Siya ay nagbibigay sa akin ng goosebumps
Dialogue: 0,0:41:46.91,0:41:48.95,pangkalahatang teksto,,0,0,0,,Napakasama. Mas maganda kung wala siya dito
Dialogue: 0,0:41:51.33,0:41:54.33,general text,,0,0,0,,Nakatulog na ang mga bisita. Humiga ka na
Dialogue: 0,0:41:55.00,0:41:56.63,general text,,0,0,0,,Baka gumawa ako ng anting-anting...
Dialogue: 0,0:42:06.80,0:42:08.18,general text,,0,0,0,,You give me goosebumps...
Dialogue: 0,0:42:11.22,0:42:12.43,pangkalahatang teksto,,0,0,0,,at mukhang masama ka
Dialogue: 0,0:42:42.80,0:42:44.88,italics,,0,0,0,,Pagkatapos ng nangyari sa Jeonbugwan,
Dialogue: 0,0:42:44.97,0:42:46.72,italics,,0,0,0,,eunuch Kim ay hindi nakikita kasama ng reyna
Dialogue: 0,0:42:47.68,0:42:49.05,pangkalahatang teksto,,0,0,0,,May alam ka ba tungkol dito?
Dialogue: 0,0:42:49.14,0:42:52.39,general text,,0,0,0,,May sakit daw siya at nagpapahinga. Ngunit walang nakakaalam kung nasaan siya
Dialogue: 0,0:42:54.18,0:42:56.39,pangkalahatang teksto,,0,0,0,,Alamin hangga't maaari tungkol sa kanya
Dialogue: 0,0:42:56.48,0:42:57.98,pangkalahatang teksto,,0,0,0,,Nang siya ay nagpakita sa palasyo,
Dialogue: 0,0:42:58.06,0:43:01.11,general text,,0,0,0,,noong nagsimula siyang maglingkod sa reyna, may mga kakaibang bagay sa kanya.
Dialogue: 0,0:43:01.94,0:43:03.36,pangkalahatang teksto,,0,0,0,,Mag-ingat
Dialogue: 0,0:43:04.07,0:43:04.99,general text,,0,0,0,,Okay, Your Highness
Dialogue: 0,0:43:11.03,0:43:14.50,general text,,0,0,0,,Naaalala mo ba ang sinabi ni Eunuch Kim noong nakilala natin siya sa Jeonbugwan?
Dialogue: 0,0:43:16.75,0:43:18.92,mga alaala,,0,0,0,,Itong shaman Choi...
Dialogue: 0,0:43:19.58,0:43:21.54,memories,,0,0,0,,sabi mo patayin mo ako?
Dialogue: 0,0:43:22.09,0:43:23.80,pangkalahatang teksto,,0,0,0,,Shaman Choi...
Dialogue: 0,0:43:23.88,0:43:26.97,general text,,0,0,0,,Dapat mas mataas ang posisyon niya kaysa kay Jin Mu, kaya inutusan niya ito
Dialogue: 0,0:43:28.01,0:43:29.72,pangkalahatang teksto,,0,0,0,,Reyna?
Dialogue: 0,0:43:29.80,0:43:32.51,pangkalahatang teksto,,0,0,0,,Nak Soo sa katawan ni Moo Deok
Dialogue: 0,0:43:32.60,0:43:34.27,general text,,0,0,0,,Siguro sa katawan ng reyna
Dialogue: 0,0:43:35.31,0:43:37.02,general text,,0,0,0,,soul of shaman Choi?
Dialogue: 0,0:43:37.10,0:43:37.98,pangkalahatang teksto,,0,0,0,,Malamang
Dialogue: 0,0:43:39.40,0:43:42.27,pangkalahatang teksto,,0,0,0,,Ngunit kung ang reyna ay isang nomad
Dialogue: 0,0:43:43.36,0:43:47.32,general text,,0,0,0,,Wala akong napansin na magmumungkahi na ang reyna ay isang nomad
Dialogue: 0,0:43:47.40,0:43:50.41,pangkalahatang teksto,,0,0,0,,Sinusuri ang kanyang energy core sa panahon ng inspeksyon,
Dialogue: 0,0:43:50.49,0:43:53.41,pangkalahatang teksto,,0,0,0,,Wala akong napansin na kakaiba. Siya ay isang ordinaryong tao
Dialogue: 0,0:43:55.70,0:44:00.13,general text,,0,0,0,,So parang may ice stone siya
Dialogue: 0,0:44:01.75,0:44:05.67,pangkalahatang teksto,,0,0,0,,Ang Reyna ay ang nakababatang kapatid na babae ni Heneral So
Dialogue: 0,0:44:05.76,0:44:07.17,general text,,0,0,0,,Siya si Tita Julia
Dialogue: 0,0:44:07.26,0:44:10.84,pangkalahatang teksto,,0,0,0,,Siya ay hindi nauugnay sa pamilyang Ho, ngunit kabilang sa pamilyang So
Dialogue: 0,0:44:10.93,0:44:12.39,pangkalahatang teksto,,0,0,0,,Kung ang kanyang kaluluwa ay inilipat,
Dialogue: 0,0:44:13.39,0:44:17.23,general text,,0,0,0,,ngayon sa katawan niya ay ang kaluluwa ng ibang tao
Dialogue: 0,0:44:17.31,0:44:20.48,general text,,0,0,0,,Namatay na pala ang kaluluwa ng reyna?
Dialogue: 0,0:44:21.06,0:44:22.52,pangkalahatang teksto,,0,0,0,,Imposible ito
Dialogue: 0,0:44:22.61,0:44:25.82,pangkalahatang teksto,,0,0,0,,Ang bawat miyembro ng pamilyang So ay may Lantern ng Buhay
Dialogue: 0,0:44:27.19,0:44:30.74,pangkalahatang teksto,,0,0,0,,Ang kuta ng Soho, na nasa hangganan, ay binabantayan ng pamilyang So. Madalas silang mag-away
Dialogue: 0,0:44:30.82,0:44:34.66,italics,,0,0,0,,Lahat ay may sariling parol, na nasusunog dahil sa vital energy ng may-ari
Dialogue: 0,0:44:34.74,0:44:36.45,italics,,0,0,0,,Para alam nila kung sino ang buhay at kung sino ang hindi
Dialogue: 0,0:44:37.58,0:44:39.79,pangkalahatang teksto,,0,0,0,,Kung namatay ang reyna,
Dialogue: 0,0:44:40.29,0:44:42.83,general text,,0,0,0,,malalaman agad nila ito dahil sa Life Lantern niya.
Dialogue: 0,0:44:43.84,0:44:46.96,general text,,0,0,0,,Eksakto, naaalala ko ang mga parol na iyon
Dialogue: 0,0:44:47.05,0:44:51.09,pangkalahatang teksto,,0,0,0,,Ang kanyang kaluluwa ay maaaring mabuhay sa ibang katawan
Dialogue: 0,0:44:52.80,0:44:57.77,italics,,0,0,0,,Tulad ng kaso ni Master Kang ng Daegantonggun, nasa Sejukwon siya ngayon
Dialogue: 0,0:45:00.69,0:45:05.06,general text,,0,0,0,,Sigurado ka bang nomad ang reyna?
Dialogue: 0,0:45:06.65,0:45:08.32,pangkalahatang teksto,,0,0,0,,Kung alam natin ang tungkol dito,
Dialogue: 0,0:45:09.32,0:45:12.74,pangkalahatang teksto,,0,0,0,,ito ay nangangahulugan na nakita namin ang pinakamalaking kahinaan ni Jin Mu
Dialogue: 0,0:45:15.99,0:45:18.20,italics,,0,0,0,,Pinaghihinalaan nila ako sa Sosnovy Bor
Dialogue: 0,0:45:18.29,0:45:21.25,general text,,0,0,0,,Susubukan nilang patunayan na ang reyna ay isang nomad
Dialogue: 0,0:45:21.33,0:45:22.87,pangkalahatang teksto,,0,0,0,,Kung gayon, ano ang dapat nating alalahanin?
Dialogue: 0,0:45:23.92,0:45:27.21,general text,,0,0,0,,Napili na namin ang katawan kung saan namin ililipat ang kanyang kaluluwa
Dialogue: 0,0:45:32.43,0:45:36.35,general text,,0,0,0,,Pwede mo ba siyang dalhin kay Jinyeowon nang walang problema?
Dialogue: 0,0:45:37.60,0:45:39.31,general text,,0,0,0,,Dadalhin ko siya ngayon
Dialogue: 0,0:45:39.97,0:45:42.23,pangkalahatang teksto,,0,0,0,,Kung ang lahat ay naaayon sa plano,
Dialogue: 0,0:45:42.81,0:45:45.36,general text,,0,0,0,,Babawiin ni Jinyeowon ang kanilang nawawalang anak na babae
Dialogue: 0,0:45:46.02,0:45:48.52,general text,,0,0,0,,At ang libing ay magaganap sa palasyo
Dialogue: 0,0:45:50.57,0:45:53.78,pangkalahatang teksto,,0,0,0,,Dahil pinarangalan ng reyna
Dialogue: 0,0:45:56.49,0:46:01.12,general text,,0,0,0,,Ano ang gagawin natin sa dati kong katawan, kung saan ang kaluluwa ng reyna?
Dialogue: 0,0:46:03.25,0:46:06.08,general text,,0,0,0,,Hindi na natin ito kailangan. Kami na ang bahala sa kanya
Dialogue: 0,0:46:48.67,0:46:51.84,pangkalahatang teksto,,0,0,0,,Kamahalan, ngayon ay pumunta ako sa iyo sa halip na eunuch Kim
Dialogue: 0,0:47:00.47,0:47:01.85,pangkalahatang teksto,,0,0,0,,Nakakahiya
Dialogue: 0,0:47:02.68,0:47:06.56,pangkalahatang teksto,,0,0,0,,Mas magiging mas madali para sa iyo kung iniwan ka ng iyong isip
Dialogue: 0,0:47:28.62,0:47:30.33,pangkalahatang teksto,,0,0,0,,Ito ay dapat na nayon ng Gema
Dialogue: 0,0:47:31.13,0:47:33.21,memories italics,,0,0,0,,Naghahanap ka ba ng shaman?
Dialogue: 0,0:47:33.30,0:47:34.30,mga alaala,,0,0,0,,Oo
Dialogue: 0,0:47:35.13,0:47:37.01,mga alaala,,0,0,0,,Pagkatapos ay tumingin sa nayon ng Gema
Dialogue: 0,0:47:37.59,0:47:40.93,mga alaala,,0,0,0,,Maraming shaman ang nakatira doon
Dialogue: 0,0:47:41.51,0:47:44.10,mga alaala,,0,0,0,,kilala ko ang pinakamatandang shaman
Dialogue: 0,0:47:44.68,0:47:47.48,memories,,0,0,0,,Kung may hinahanap ka, tanungin mo siya
Dialogue: 0,0:47:50.90,0:47:52.27,pangkalahatang teksto,,0,0,0,,- Fire Priestess...\N- Hindi, salamat
Dialogue: 0,0:47:54.48,0:47:58.49,general text,,0,0,0,,Excuse me, alam mo ba kung saan ang bahay ng shaman Bon?
Dialogue: 0,0:47:58.57,0:47:59.91,pangkalahatang teksto,,0,0,0,,Shaman Bon?
Dialogue: 0,0:47:59.99,0:48:02.24,general text,,0,0,0,,Nawalan siya ng kapangyarihan
Dialogue: 0,0:48:02.33,0:48:03.99,general text,,0,0,0,,You better go to the Fire Priestess
Dialogue: 0,0:48:04.08,0:48:06.87,general text,,0,0,0,,- Ihahatid kita sa kanya\N- Hindi, hinahanap ko ang shaman na si Bon
Dialogue: 0,0:48:06.95,0:48:10.00,general text,,0,0,0,,- Sinasabi ko sayo, wala siyang pakinabang\N- Pero kailangan ko siya
Dialogue: 0,0:48:10.92,0:48:11.92,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,0:48:24.06,0:48:26.02,general text,,0,0,0,,Nasaan ako?
Dialogue: 0,0:48:26.56,0:48:28.64,pangkalahatang teksto,,0,0,0,,Pareho ang lahat ng kalye
Dialogue: 0,0:48:32.40,0:48:35.36,italics,,0,0,0,,Hindi ako pupunta sa priestess of Fire!
Dialogue: 0,0:48:35.44,0:48:38.19,pangkalahatang teksto,,0,0,0,,Pero kailangan mo pa ring magbayad, dahil sinabihan ka na ng iyong kapalaran
Dialogue: 0,0:48:38.28,0:48:40.70,general text,,0,0,0,,- Saan ka pupunta?\N- Don’t touch!
Dialogue: 0,0:48:41.20,0:48:43.45,pangkalahatang teksto,,0,0,0,,Hindi siya nagsabi ng isang salita na totoo. Ano ang babayaran?
Dialogue: 0,0:48:49.91,0:48:51.62,general text,,0,0,0,,Pumunta ka ba sa shaman Bon?
Dialogue: 0,0:48:51.71,0:48:53.00,general text,,0,0,0,,Masama siya, tama?
Dialogue: 0,0:48:53.08,0:48:56.05,general text,,0,0,0,,The Fire Priestess is the best. Oo?
Dialogue: 0,0:48:56.13,0:48:57.76,pangkalahatang teksto,,0,0,0,,"Fire Priestess", oo, siyempre
Dialogue: 0,0:48:57.84,0:48:58.92,pangkalahatang text,,0,0,0,,Stop
Dialogue: 0,0:49:04.05,0:49:06.43,pangkalahatang teksto,,0,0,0,,Pumunta ka ba para sa isang hula?
Dialogue: 0,0:49:07.39,0:49:09.39,pangkalahatang teksto,,0,0,0,,At paano ang iyong sarili? Gusto mo bang magsagawa ng exorcism?
Dialogue: 0,0:49:10.02,0:49:12.81,general text,,0,0,0,,Ano ang sinabi ng Fire Priestess na ikinagalit mo?
Dialogue: 0,0:49:13.44,0:49:16.90,general text,,0,0,0,,Wala akong nakikitang swerte sa pamumuno, mas mabuting pumasok sa isang craft
Dialogue: 0,0:49:16.98,0:49:18.36,pangkalahatang teksto,,0,0,0,,Ako ang Crown Prince
Dialogue: 0,0:49:19.82,0:49:21.53,general text,,0,0,0,,Ano ang sinabi sa iyo ng shaman Bon?
Dialogue: 0,0:49:21.61,0:49:23.95,general text,,0,0,0,,Pupuntahan ko lang siya. Marami akong tanong
Dialogue: 0,0:49:26.74,0:49:27.79,pangkalahatang teksto,,0,0,0,,Chan Wook
Dialogue: 0,0:49:30.96,0:49:33.17,general text,,0,0,0,,Hinahanap mo rin ba si eunuch Kim?
Dialogue: 0,0:49:36.42,0:49:38.34,general text,,0,0,0,,Bakit mo hinahanap dito?
Dialogue: 0,0:49:42.05,0:49:45.39,general text,,0,0,0,,Pagkatapos ng insidenteng iyon sa Jeonbugwan, nawala siya sa palasyo
Dialogue: 0,0:49:46.22,0:49:48.18,pangkalahatang teksto,,0,0,0,,Ang kanyang mga track ay nagdala sa akin dito
Dialogue: 0,0:49:48.26,0:49:51.60,general text,,0,0,0,,So pumunta ka dito mag-isa, walang security?
Dialogue: 0,0:49:53.39,0:49:55.23,general text,,0,0,0,,Ayokong may makaalam,
Dialogue: 0,0:49:56.19,0:49:57.90,general text,,0,0,0,,na pinaghihinalaan ko siya
Dialogue: 0,0:50:00.94,0:50:02.99,general text,,0,0,0,,Kaya sumasang-ayon ka na siya ay isang nomad,
Dialogue: 0,0:50:04.07,0:50:06.95,general text,,0,0,0,,at kakaiba ang kinikilos ng reyna, sinusubukang itago ito?
Dialogue: 0,0:50:08.87,0:50:09.95,pangkalahatang teksto,,0,0,0,,Tama
Dialogue: 0,0:50:11.16,0:50:13.12,italics,,0,0,0,,At ikaw? Ano ang hinahanap mo?
Dialogue: 0,0:50:13.79,0:50:16.63,pangkalahatang teksto,,0,0,0,,Sa palagay ko nagpunta tayo dito para sa parehong bagay
Dialogue: 0,0:50:16.71,0:50:17.88,pangkalahatang teksto,,0,0,0,,Magpapalitan ba tayo ng impormasyon?
Dialogue: 0,0:50:18.71,0:50:20.00,pangkalahatang teksto,,0,0,0,,Kaunti sa bawat isa?
Dialogue: 0,0:50:20.80,0:50:22.80,pangkalahatang teksto,,0,0,0,,Mahusay. Tapos ikaw muna
Dialogue: 0,0:50:22.88,0:50:24.80,general text,,0,0,0,,Kung una kong sasabihin,
Dialogue: 0,0:50:24.88,0:50:27.60,pangkalahatang teksto,,0,0,0,,wala kang sasabihin sa akin, binabanggit ang katotohanan na ikaw ay isang prinsipe
Dialogue: 0,0:50:27.68,0:50:28.64,pangkalahatang teksto,,0,0,0,,Paano mo naiintindihan?
Dialogue: 0,0:50:30.56,0:50:31.56,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:50:33.18,0:50:36.81,general text,,0,0,0,,Habang hinahanap si eunuch Kim, may nakita akong kakaiba
Dialogue: 0,0:50:36.90,0:50:39.44,general text,,0,0,0,,Bawat buwan ay umalis siya sa palasyo at pumunta sa isang lugar
Dialogue: 0,0:50:40.23,0:50:42.57,general text,,0,0,0,,Pumunta siya rito
Dialogue: 0,0:50:43.36,0:50:45.53,general text,,0,0,0,,Naghahanap ako ng shaman Choi
Dialogue: 0,0:50:46.11,0:50:47.03,general text,,0,0,0,,Sino pa ba ito?
Dialogue: 0,0:50:47.11,0:50:49.58,general text,,0,0,0,,Sasabihin ko yan sa ibang pagkakataon. Para dito...
Dialogue: 0,0:50:50.41,0:50:51.62,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:50:52.70,0:50:55.83,pangkalahatang teksto,,0,0,0,,Ano sa palagay mo ang sinasabi sa akin ng iyong mga salita?
Dialogue: 0,0:50:55.92,0:50:57.67,general text,,0,0,0,,Hindi ko na alam
Dialogue: 0,0:51:00.50,0:51:03.51,general text,,0,0,0,,- Bakit mo ako sinusundan?\N- Sa shaman Bon
Dialogue: 0,0:51:03.59,0:51:05.22,general text,,0,0,0,,Baka hindi tayo magsama
Dialogue: 0,0:51:05.30,0:51:08.64,general text,,0,0,0,,Pero ipapasabi ko sa kanya lahat ng sinabi niya sayo
Dialogue: 0,0:51:09.30,0:51:10.43,general text,,0,0,0,,Dahil ako ay isang prinsipe
Dialogue: 0,0:51:15.73,0:51:18.90,general text,,0,0,0,,- Hindi ko alam kung nasaan siya\N{\i1} - Alam mo lahat
Dialogue: 0,0:51:18.98,0:51:20.44,italics,,0,0,0,,Hindi ko talaga alam
Dialogue: 0,0:51:23.36,0:51:28.41,general text,,0,0,0,,Nakausap ko ang tito mo at nanay mo
Dialogue: 0,0:51:28.49,0:51:30.28,general text,,0,0,0,,Ano ang sinabi niya?
Dialogue: 0,0:51:30.37,0:51:32.74,general text,,0,0,0,,Galit na galit pa rin ba siya sa akin?
Dialogue: 0,0:51:33.62,0:51:35.66,general text,,0,0,0,,Itataboy niya ba talaga ako sa Sosnovy Bor?
Dialogue: 0,0:51:36.96,0:51:41.21,general text,,0,0,0,,Patawarin daw ka nila kung pumayag kang pumirma sa sulat
Dialogue: 0,0:51:41.29,0:51:44.13,pangkalahatang teksto,,0,0,0,,Kaya pumayag kang hindi na magkita muli
Dialogue: 0,0:51:47.51,0:51:48.34,pangkalahatang teksto,,0,0,0,,Eto na
Dialogue: 0,0:51:50.59,0:51:52.05,general text,,0,0,0,,Nakasulat na ang lahat doon
Dialogue: 0,0:51:52.14,0:51:54.35,pangkalahatang teksto,,0,0,0,,Ang kailangan mo lang gawin ay pirmahan sila
Dialogue: 0,0:51:54.43,0:51:56.23,pangkalahatang text,,0,0,0,,Pagkatapos ay makakauwi ka na
Dialogue: 0,0:51:56.77,0:51:58.52,italics,,0,0,0,,Pwede mo munang pag-usapan ang lahat
Dialogue: 0,0:51:59.35,0:52:03.32,pangkalahatang teksto,,0,0,0,,Mabibigyan kita ng pagkain at tirahan sandali,
Dialogue: 0,0:52:03.40,0:52:06.40,italics,,0,0,0,,kung magpasya kang manatiling magkasama
Dialogue: 0,0:52:06.49,0:52:07.32,italics,,0,0,0,,Aalis na ako
Dialogue: 0,0:52:18.75,0:52:19.96,pangkalahatang teksto,,0,0,0,,Cho Young...
Dialogue: 0,0:52:25.00,0:52:26.17,pangkalahatang teksto,,0,0,0,,Sa totoo lang,
Dialogue: 0,0:52:29.51,0:52:31.26,general text,,0,0,0,,I'm a little sorry
Dialogue: 0,0:52:34.01,0:52:36.10,general text,,0,0,0,,Natatakot ako na baka gawin ko...
Dialogue: 0,0:52:38.52,0:52:40.06,pangkalahatang teksto,,0,0,0,,masyadong impulsive
Dialogue: 0,0:52:43.86,0:52:45.11,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,0:52:51.53,0:52:53.66,general text,,0,0,0,,isip ko lang na hindi na kita makikita...
Dialogue: 0,0:52:56.70,0:52:58.45,general text,,0,0,0,,Iyon lang ang ikinabahala ko
Dialogue: 0,0:53:00.50,0:53:02.21,general text,,0,0,0,,Hindi ko mapirmahan ang sulat
Dialogue: 0,0:53:02.29,0:53:03.96,general text,,0,0,0,,Hindi ako mabubuhay kung wala ka
Dialogue: 0,0:53:06.25,0:53:08.38,caption,,0,0,0,,Nangako si Jin Cho Young na hindi na muling makikita si Park Dan Gu
Dialogue: 0,0:53:09.26,0:53:11.43,general text,,0,0,0,,Noong una naiinis din ako
Dialogue: 0,0:53:14.47,0:53:16.31,pangkalahatang teksto,,0,0,0,,Ngunit gusto kong patuloy na makita ka
Dialogue: 0,0:53:52.68,0:53:54.64,pangkalahatang teksto,,0,0,0,,Nakumpleto ang mga negosasyon
Dialogue: 0,0:53:54.72,0:53:57.51,pangkalahatang teksto,,0,0,0,,Moo Dok, itakda ang talahanayan
Dialogue: 0,0:54:04.06,0:54:05.90,pangkalahatang teksto,,0,0,0,,Kumain ng isda
Dialogue: 0,0:54:12.32,0:54:13.90,pangkalahatang teksto,,0,0,0,,At karne rin
Dialogue: 0,0:54:25.96,0:54:30.05,general text,,0,0,0,,Talaga bang mananatili ka dito?
Dialogue: 0,0:54:30.13,0:54:31.34,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:54:31.42,0:54:35.51,general text,,0,0,0,,Uuwi na kami para kumuha ng mga gamit
Dialogue: 0,0:54:35.59,0:54:38.35,general text,,0,0,0,,Magtatayo ka ba ng pugad dito para sa iyong honeymoon?
Dialogue: 0,0:54:41.43,0:54:42.64,pangkalahatang teksto,,0,0,0,,Hindi naman
Dialogue: 0,0:54:42.73,0:54:44.60,pangkalahatang teksto,,0,0,0,,Ngunit kailangan natin ng pagpapalit ng damit
Dialogue: 0,0:54:44.69,0:54:47.40,general text,,0,0,0,,Pwede ka bang sumama kay Cho Young at dalhin ang mga gamit niya?
Dialogue: 0,0:54:58.20,0:54:59.91,general text,,0,0,0,,Natapon mo ba yung papel na nakalagay dito?
Dialogue: 0,0:55:00.49,0:55:01.33,pangkalahatang teksto,,0,0,0,,Narito ang lahat
Dialogue: 0,0:55:08.63,0:55:09.63,caption,,0,0,0,,Nangako si Jin Cho Young na hindi na muling makikita si Park Dan Gu
Dialogue: 0,0:55:09.71,0:55:11.25,pangkalahatang teksto,,0,0,0,,Kailangan kong isipin ang lahat
Dialogue: 0,0:55:12.46,0:55:15.67,general text,,0,0,0,,Kung mag-impake ako ng mga gamit ko at umalis, baka paalisin talaga nila ako.
Dialogue: 0,0:55:17.76,0:55:19.09,general text,,0,0,0,,Nasaktan ka ba?
Dialogue: 0,0:55:21.35,0:55:22.52,general text,,0,0,0,,Masakit ba?
Dialogue: 0,0:55:23.10,0:55:24.60,general text,,0,0,0,,Syempre masakit!
Dialogue: 0,0:55:29.77,0:55:30.81,pangkalahatang teksto,,0,0,0,,Ano? May peklat ka ba?
Dialogue: 0,0:55:30.90,0:55:32.44,pangkalahatang teksto,,0,0,0,,Saan mo ito nakuha?
Dialogue: 0,0:55:33.15,0:55:34.44,pangkalahatang teksto,,0,0,0,,Wala akong ideya
Dialogue: 0,0:55:34.53,0:55:36.61,general text,,0,0,0,,Naranasan ko na ito mula pagkabata, kaya hindi ko na maalala
Dialogue: 0,0:55:37.61,0:55:39.62,pangkalahatang teksto,,0,0,0,,Nananatiling ganito pagkatapos ng hiwa
Dialogue: 0,0:55:39.70,0:55:42.79,pangkalahatang text,,0,0,0,,Ganoon din ang kapatid ko dahil sa akin
Dialogue: 0,0:55:44.12,0:55:47.04,general text,,0,0,0,,Nahulog siya katulad mo ngayon
Dialogue: 0,0:55:54.84,0:55:57.34,pangkalahatang teksto,,0,0,0,,May lumitaw na peklat sa lugar ng hiwa
Dialogue: 0,0:56:02.26,0:56:03.68,pangkalahatang teksto,,0,0,0,,Kung ano lang ang kailangan mo
Dialogue: 0,0:56:05.52,0:56:08.69,general text,,0,0,0,,Gagawin ko ang aking makakaya, ama
Dialogue: 0,0:56:11.11,0:56:13.23,general text,,0,0,0,,Huwag mo akong tawaging ganyan maliban kung kinakailangan
Dialogue: 0,0:56:14.44,0:56:15.82,pangkalahatang text,,0,0,0,,Goosebumps
Dialogue: 0,0:56:25.33,0:56:27.87,pangkalahatang teksto,,0,0,0,,Hindi kailangang maging bastos
Dialogue: 0,0:56:28.62,0:56:31.67,general text,,0,0,0,,At bakit niya itinapon ang napakagandang silk scarf?
Dialogue: 0,0:56:33.29,0:56:34.38,pangkalahatang teksto,,0,0,0,,Ano...
Dialogue: 0,0:56:42.51,0:56:45.06,pangkalahatang teksto,,0,0,0,,Kapareho ito ng pattern ng headband ni Moo Deok
Dialogue: 0,0:56:49.35,0:56:51.81,general text,,0,0,0,,- Umalis na ba ang ginoo kay Jinyowon?\N- Oo
Dialogue: 0,0:56:54.77,0:56:56.32,pangkalahatang teksto,,0,0,0,,Anong uri ng pattern ito?
Dialogue: 0,0:56:56.40,0:56:59.15,pangkalahatang teksto,,0,0,0,,Eskudo ng arm ng pamilya Jin
Dialogue: 0,0:56:59.90,0:57:02.03,general text,,0,0,0,,Pupunta ka doon ngayon. Humanda ka
Dialogue: 0,0:57:02.70,0:57:03.87,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:57:06.62,0:57:08.41,voiceover,,0,0,0,,So iyon ang nangyari?
Dialogue: 0,0:57:17.00,0:57:19.63,behind the scenes,,0,0,0,,Bakit may bagay si Moo Deok...
Dialogue: 0,0:57:19.72,0:57:22.09,behind the scenes,,0,0,0,,with the Jinyoewon crest?
Dialogue: 0,0:57:29.60,0:57:32.10,general text,,0,0,0,,Ipunin mo ang mga gamit ko para walang malaman ang nanay ko
Dialogue: 0,0:57:32.19,0:57:33.27,pangkalahatang teksto,,0,0,0,,Sundan mo ako
Dialogue: 0,0:57:34.52,0:57:37.15,general text,,0,0,0,,Gusto ko na siyang umuwi at manatili doon
Dialogue: 0,0:57:45.20,0:57:48.12,general text,,0,0,0,,Mapagkakatiwalaan ba talaga siya? Mukhang scam
Dialogue: 0,0:57:48.95,0:57:50.79,pangkalahatang teksto,,0,0,0,,Malamang na espesyal siya
Dialogue: 0,0:57:51.37,0:57:55.21,general text,,0,0,0,,May ganoong apoy sa pagitan mo. May iba pa dito
Dialogue: 0,0:57:55.79,0:57:56.96,general text,,0,0,0,,Lovers ba kayo?
Dialogue: 0,0:57:59.25,0:58:00.67,pangkalahatang teksto,,0,0,0,,Wow...
Dialogue: 0,0:58:02.72,0:58:05.93,pangkalahatang teksto,,0,0,0,,Ang aking tuntunin: huwag isapubliko ang iyong naririnig dito
Dialogue: 0,0:58:06.01,0:58:07.68,pangkalahatang text,,0,0,0,,Makakaasa ka sa akin
Dialogue: 0,0:58:07.76,0:58:12.52,general text,,0,0,0,,May something significant between you, tama ba ako?
Dialogue: 0,0:58:14.02,0:58:14.90,general text,,0,0,0,,At magaling siya
Dialogue: 0,0:58:16.27,0:58:17.19,pangkalahatang teksto,,0,0,0,,Halika...
Dialogue: 0,0:58:19.36,0:58:22.19,general text,,0,0,0,,Nabalitaan ko na nakatira ka sa Gema Village ang pinakamatagal
Dialogue: 0,0:58:22.28,0:58:24.70,general text,,0,0,0,,Kilala mo ba ang shaman na si Choi?
Dialogue: 0,0:58:27.99,0:58:29.24,pangkalahatang teksto,,0,0,0,,Shaman Choi?
Dialogue: 0,0:58:29.33,0:58:32.25,pangkalahatang teksto,,0,0,0,,Sinusubaybayan mo ba ang paggamit ng dark magic?
Dialogue: 0,0:58:35.62,0:58:39.80,pangkalahatang teksto,,0,0,0,,Hindi naman. Nabalitaan ko lang na sobrang galing niya sa craft niya.
Dialogue: 0,0:58:39.88,0:58:41.76,general text,,0,0,0,,Kaya gusto ko siyang hanapin
Dialogue: 0,0:58:45.34,0:58:46.55,pangkalahatang teksto,,0,0,0,,Magaling siya
Dialogue: 0,0:58:47.14,0:58:49.05,pangkalahatang teksto,,0,0,0,,Ngunit mahigit 20 taon na ang nakalipas mula noon
Dialogue: 0,0:58:56.48,0:58:57.81,italics,,0,0,0,,Sikat si Shaman Choi sa
Dialogue: 0,0:58:57.90,0:59:01.86,italics,,0,0,0,,na naghahatid ng pangkukulam sa mga tao
Dialogue: 0,0:59:02.44,0:59:04.40,italics,,0,0,0,,Noong unang panahon sa mga mago ni Jeonbugwan
Dialogue: 0,0:59:04.49,0:59:08.37,italics,,0,0,0,,halos mahuli siya
Dialogue: 0,0:59:09.28,0:59:10.83,italics,,0,0,0,,Ngunit nagawa niyang tumalon sa apoy
Dialogue: 0,0:59:13.08,0:59:16.62,italics,,0,0,0,,Sinasabi nila na namatay siya sa apoy na iyon
Dialogue: 0,0:59:17.29,0:59:21.21,pangkalahatang teksto,,0,0,0,,Naniniwala ang iba na siya ay nasunog nang husto, ngunit nakaligtas
Dialogue: 0,0:59:21.88,0:59:23.01,general text,,0,0,0,,Tapos ang tatay mo na si Chang Gan...
Dialogue: 0,0:59:23.09,0:59:26.01,pangkalahatang teksto,,0,0,0,,was gwangju Jeonbugwan
Dialogue: 0,0:59:28.80,0:59:31.93,general text,,0,0,0,,Hinahanap mo si shaman Choi dahil nagtatanim siya ng sama ng loob sa iyong ama
Dialogue: 0,0:59:33.06,0:59:35.39,general text,,0,0,0,,dahil sa pag-uusig kay Jeonbugwan?
Dialogue: 0,0:59:35.48,0:59:37.77,general text,,0,0,0,,Hindi ko na maalala ang tatay ko
Dialogue: 0,0:59:38.40,0:59:40.61,general text,,0,0,0,,Paano ko malalaman kung sino ang may sama ng loob sa kanya?
Dialogue: 0,0:59:44.19,0:59:47.24,captions,,0,0,0,,Nangako si Park Dan Gu na hindi na muling makikita si Jin Jo Young
Dialogue: 0,0:59:49.36,0:59:51.62,general text,,0,0,0,,Hindi ka pumirma
Dialogue: 0,0:59:51.70,0:59:54.24,general text,,0,0,0,,Naisip kong pumirma sa papel at umuwi,
Dialogue: 0,0:59:55.16,0:59:57.25,pangkalahatang teksto,,0,0,0,,ngunit kasinungalingan iyon
Dialogue: 0,0:59:57.33,0:59:59.29,general text,,0,0,0,,I can't live without her
Dialogue: 0,1:00:02.50,1:00:05.05,pangkalahatang teksto,,0,0,0,,Ang aking damdamin ay hindi lumitaw sa magdamag
Dialogue: 0,1:00:05.92,1:00:09.05,general text,,0,0,0,,Matagal ko na siyang mahal, pero hindi ako nagkaroon ng pagkakataong umamin.
Dialogue: 0,1:00:09.13,1:00:11.10,general text,,0,0,0,,ngayon ko lang nahawakan ang kamay niya
Dialogue: 0,1:00:11.68,1:00:13.18,general text,,0,0,0,,Huwag mong tawaging childish ang nararamdaman natin...
Dialogue: 0,1:00:13.26,1:00:15.81,pangkalahatang teksto,,0,0,0,,at bigyan kami ng pagkakataon
Dialogue: 0,1:00:15.89,1:00:18.19,pangkalahatang teksto,,0,0,0,,Kunin ang iyong mga gamit...
Dialogue: 0,1:00:18.27,1:00:19.90,pangkalahatang text,,0,0,0,,at pumunta sa bahay ni Uku
Dialogue: 0,1:00:20.90,1:00:22.61,general text,,0,0,0,,- Uncle...\N- Kailangan ko,
Dialogue: 0,1:00:23.52,1:00:25.07,italics,,0,0,0,,para may magawa ka doon
Dialogue: 0,1:00:34.79,1:00:36.70,italics,,0,0,0,,Kung pupunta ang lalaking ito sa kanyang bahay,
Dialogue: 0,1:00:36.79,1:00:38.46,pangkalahatang text,,0,0,0,,ipaalam sa akin kaagad
Dialogue: 0,1:00:38.54,1:00:40.58,pangkalahatang teksto,,0,0,0,,Sino ito?
Dialogue: 0,1:00:41.75,1:00:43.59,general text,,0,0,0,,Jang Gang, Jeonbugwan's gwangju
Dialogue: 0,1:00:44.34,1:00:45.59,pangkalahatang teksto,,0,0,0,,Pare Uka
Dialogue: 0,1:00:49.22,1:00:50.80,italics,,0,0,0,,Kung darating siya,
Dialogue: 0,1:00:52.76,1:00:54.01,pangkalahatang text,,0,0,0,,ipaalam sa akin
Dialogue: 0,1:00:55.10,1:00:56.27,pangkalahatang teksto,,0,0,0,,Agad-agad
Dialogue: 0,1:00:58.93,1:01:00.85,general text,,0,0,0,,Exactly, nakalimutan ko na
Dialogue: 0,1:01:00.94,1:01:04.44,pangkalahatang teksto,,0,0,0,,May nakababatang kapatid si Shaman Choi
Dialogue: 0,1:01:05.40,1:01:08.11,general text,,0,0,0,,Alam mo ba kung nasaan siya?
Dialogue: 0,1:01:08.19,1:01:12.32,general text,,0,0,0,,Mula sa pangyayaring iyon hindi ko na siya nakita pang muli
Dialogue: 0,1:01:12.99,1:01:16.54,general text,,0,0,0,,Pero may mga tsismis na nagpakasal siya...
Dialogue: 0,1:01:16.62,1:01:18.91,pangkalahatang teksto,,0,0,0,,sa isang babae mula sa isang maimpluwensyang pamilya
Dialogue: 0,1:01:43.60,1:01:46.57,general text,,0,0,0,,Sinabi sa akin na baka siya iyon
Dialogue: 0,1:01:47.48,1:01:49.32,general text,,0,0,0,,Bakit siya nakasuot ng basahan?
Dialogue: 0,1:01:49.40,1:01:51.86,pangkalahatang teksto,,0,0,0,,Bilang isang bata, siya ay inanod sa baybayin ng Lake Gyeongcheongdaeho
Dialogue: 0,1:01:51.95,1:01:54.62,general text,,0,0,0,,Halos humihinga siya nang iligtas siya ng mangingisda
Dialogue: 0,1:01:55.53,1:01:58.70,general text,,0,0,0,,Pagkatapos ng insidenteng iyon, nawala ang kanyang memorya,
Dialogue: 0,1:01:59.33,1:02:04.29,general text,,0,0,0,,pero, sa kabila ng kanyang pagkabulag, naiintindihan niya ang mga bagay sa paligid niya
Dialogue: 0,1:02:27.31,1:02:30.32,general text,,0,0,0,,May nunal ka dito...
Dialogue: 0,1:02:39.33,1:02:41.04,pangkalahatang teksto,,0,0,0,,At ang peklat sa parehong lugar
Dialogue: 0,1:02:42.37,1:02:47.83,general text,,0,0,0,,Kaya nga sabi nila malamang ikaw ang aming Boo Young
Dialogue: 0,1:02:47.92,1:02:49.42,pangkalahatang teksto,,0,0,0,,Ito lamang
Dialogue: 0,1:02:49.50,1:02:53.59,pangkalahatang text,,0,0,0,,maaaring nagkataon lang ito. Kailangang suriin para makasigurado
Dialogue: 0,1:03:00.51,1:03:02.68,pangkalahatang teksto,,0,0,0,,Tara na at tingnan natin...
Dialogue: 0,1:03:03.98,1:03:05.77,general text,,0,0,0,,mabubuksan mo ba ang pinto ng Jinyeowon
Dialogue: 0,1:03:15.78,1:03:17.86,general text,,0,0,0,,Narito na naman ang mga taga-Jeonbugwan
Dialogue: 0,1:03:17.95,1:03:20.24,general text,,0,0,0,,Malamang dinala nila ulit yung babae para malaman kung si Boo Young yun.
Dialogue: 0,1:03:30.29,1:03:33.71,voiceover,,0,0,0,,May dugo sa katawan mo Jin Cho Young,
Dialogue: 0,1:03:33.80,1:03:36.34,behind the scenes,,0,0,0,,dapat mabuksan mo ang pinto ng Jinyeowon
Dialogue: 0,1:03:38.30,1:03:40.89,behind the scenes,,0,0,0,,Subukang buksan ang mga ito kahit kaunti
Dialogue: 0,1:03:41.47,1:03:43.18,behind the scenes,,0,0,0,,Sapat na iyon
Dialogue: 0,1:03:53.19,1:03:55.69,general text,,0,0,0,,Maraming nakapunta dito,
Dialogue: 0,1:03:56.40,1:03:57.86,general text,,0,0,0,,pero walang nagbukas ng pinto
Dialogue: 0,1:04:41.28,1:04:42.45,pangkalahatang teksto,,0,0,0,,Bu Young!
Dialogue: 0,1:04:43.74,1:04:45.04,pangkalahatang teksto,,0,0,0,,Our Boo Young
Dialogue: 0,1:04:48.50,1:04:52.25,behind the scenes,,0,0,0,,Muli. Sa tuwing mangyayari ito, sulit ang pagpunta dito
Dialogue: 0,1:05:08.31,1:05:09.85,pangkalahatang teksto,,0,0,0,,Kung nangyari ito 20 taon na ang nakakaraan,
Dialogue: 0,1:05:10.39,1:05:13.23,pangkalahatang teksto,,0,0,0,,kaya si Jin Mu ay estudyante ng iyong ama
Dialogue: 0,1:05:14.36,1:05:16.65,pangkalahatang teksto,,0,0,0,,Maaaring may alam si Jin Mu. Dapat ko ba siyang tanungin?
Dialogue: 0,1:05:16.73,1:05:18.44,pangkalahatang teksto,,0,0,0,,Hindi pwede
Dialogue: 0,1:05:18.53,1:05:21.86,pangkalahatang teksto,,0,0,0,,Itago ang iyong narinig ngayon
Dialogue: 0,1:05:23.95,1:05:27.33,general text,,0,0,0,,Mukhang wala kaming natutunang importante, pero okay
Dialogue: 0,1:05:30.79,1:05:34.04,general text,,0,0,0,,Your Highness, mag-isa ka lang pumunta dito?
Dialogue: 0,1:05:34.13,1:05:35.13,italics,,0,0,0,,Kaya nga
Dialogue: 0,1:05:35.21,1:05:38.63,general text,,0,0,0,,Pero parang may sumusunod sa amin
Dialogue: 0,1:05:42.09,1:05:45.26,general text,,0,0,0,,Dapat ba tayong maghiwalay para malaman kung sino sa atin ang sinusundan?
Dialogue: 0,1:06:25.39,1:06:26.60,pangkalahatang teksto,,0,0,0,,Ina!
Dialogue: 0,1:07:08.72,1:07:10.68,general text,,0,0,0,,Sino ka at bakit mo ako hinahabol?
Dialogue: 0,1:07:13.73,1:07:14.64,general text,,0,0,0,,Tinatanong ko...
Dialogue: 0,1:07:18.06,1:07:19.15,pangkalahatang teksto,,0,0,0,,Sino ka?
Dialogue: 0,1:08:11.41,1:08:14.95,preview,,0,0,0,,Bu Young, ang dinala ni Jin Mu ay isang scammer na nagngangalang Song Yi
Dialogue: 0,1:08:15.04,1:08:16.25,preview,,0,0,0,,Bakit nandito ito?
Dialogue: 0,1:08:16.33,1:08:17.75,preview,,0,0,0,,Totoong anak na babae - Moo Deok
Dialogue: 0,1:08:17.83,1:08:19.79,preview,,0,0,0,,Ano ang mangyayari sa akin kapag nalaman niya ang lahat?
Dialogue: 0,1:08:19.87,1:08:22.38,preview,,0,0,0,,May isang bagay si Jin Moo na hindi papayag kahit si Jin Ho Kyung na bumuka ang kanyang bibig,
Dialogue: 0,1:08:22.46,1:08:25.13,preview,,0,0,0,,kung nalaman niya ang tungkol sa pagpapalit
Dialogue: 0,1:08:25.71,1:08:26.76,preview,,0,0,0,,Ano ang gusto mo?
Dialogue: 0,1:08:26.84,1:08:31.34,preview,,0,0,0,,Dapat mong sirain ang Pine Forest para maprotektahan ang yelong bato
Dialogue: 0,1:08:32.68,1:08:34.60,preview,,0,0,0,,Tumahimik ka, please!
Dialogue: 0,1:08:34.68,1:08:37.14,preview,,0,0,0,,Nais mo bang maging isang bayani na may tadhana ng isang maharlikang bituin,
Dialogue: 0,1:08:37.23,1:08:39.48,preview,,0,0,0,,sirain ang bawat yelong bato at iligtas ang mundo mula sa kaguluhan?
Dialogue: 0,1:08:39.56,1:08:40.85,preview,,0,0,0,,Nandito ba si So Yul?
Dialogue: 0,1:08:40.94,1:08:42.56,preview,,0,0,0,,Siya ang unang papatayin ko
Dialogue: 0,1:08:43.27,1:08:44.52,preview,,0,0,0,,Mr!
Dialogue: 0,1:08:45.98,1:08:46.94,preview,,0,0,0,,Narito ang isang nomad!
Dialogue: 0,1:08:47.03,1:08:48.32,preview,,0,0,0,,Dapat Mamatay si Chan Wook
Dialogue: 0,1:08:48.40,1:08:50.41,preview,,0,0,0,,Chan Wook, estudyante ko...
Dialogue: 0,1:08:50.41,1:08:52.41,pangkalahatang teksto,,0,0,0,,

