Dialogue: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Project coordinator at editor: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Coordinator assistant:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Typesetter translator: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:01:18.77,0:01:21.19,general text,,0,0,0,,Magchichismisan ang mga tao kung bigla kang mawawala
Dialogue: 0,0:01:21.28,0:01:23.49,pangkalahatang teksto,,0,0,0,,Kamatayan sa harap ng mga saksi
Dialogue: 0,0:01:23.57,0:01:25.78,pangkalahatang teksto,,0,0,0,,papasimplehin ang lahat
Dialogue: 0,0:01:27.91,0:01:29.66,general text,,0,0,0,,Gusto kong iligtas ang mukha
Dialogue: 0,0:01:30.66,0:01:32.62,general text,,0,0,0,,Sana maging karapat-dapat ang kamatayan
Dialogue: 0,0:01:37.71,0:01:39.88,general text,,0,0,0,,- Master!\N- Master!
Dialogue: 0,0:01:43.26,0:01:44.34,general text,,0,0,0,,Anong sinasabi niya?
Dialogue: 0,0:01:44.43,0:01:46.34,general text,,0,0,0,,- Ano ito?\N- Tingnan mo!
Dialogue: 0,0:01:47.05,0:01:48.93,pangkalahatang teksto,,0,0,0,,Mga Mersenaryo!
Dialogue: 0,0:02:18.46,0:02:20.42,pangkalahatang teksto,,0,0,0,,Guro
Dialogue: 0,0:02:29.09,0:02:32.31,pangkalahatang teksto,,0,0,0,,Ginagamit ko ang iyong katawan nang may dignidad
Dialogue: 0,0:03:25.94,0:03:26.82,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:03:30.07,0:03:32.24,pangkalahatang teksto,,0,0,0,,Banal na tae
Dialogue: 0,0:03:38.83,0:03:40.00,pangkalahatang teksto,,0,0,0,,Lahat ay maayos
Dialogue: 0,0:03:40.96,0:03:41.96,pangkalahatang text,,0,0,0,,Huwag kang sumama
Dialogue: 0,0:03:46.84,0:03:47.76,italics,,0,0,0,,Kahiya-hiya
Dialogue: 0,0:03:47.84,0:03:50.47,general text,,0,0,0,,Ngayon ay lalo siyang nagdusa
Dialogue: 0,0:03:50.55,0:03:52.80,general text,,0,0,0,,- Dalawa pa ang natitira?\N- Oo
Dialogue: 0,0:03:54.18,0:03:56.43,pangkalahatang teksto,,0,0,0,,Bukas Cha Bum
Dialogue: 0,0:03:56.52,0:03:58.52,general text,,0,0,0,,Ayokong makitang natatalo si Uk sa kanya
Dialogue: 0,0:03:59.18,0:04:00.56,general text,,0,0,0,,Siguro dapat akong lumaban?
Dialogue: 0,0:04:01.27,0:04:03.23,italics,,0,0,0,,Hayaan kong manalo si Uku at matapos ito
Dialogue: 0,0:04:03.31,0:04:04.77,pangkalahatang teksto,,0,0,0,,Magiging masaya ang UK tungkol dito
Dialogue: 0,0:04:05.27,0:04:07.36,pangkalahatang teksto,,0,0,0,,Pagtatalo sa Crown Prince
Dialogue: 0,0:04:07.44,0:04:09.03,general text,,0,0,0,,Kailangan natin siyang dayain
Dialogue: 0,0:04:12.20,0:04:14.12,pangkalahatang teksto,,0,0,0,,Natatalo ang UK, ngunit nakakakuha ng karanasan
Dialogue: 0,0:04:16.20,0:04:17.20,pangkalahatang teksto,,0,0,0,,Host
Dialogue: 0,0:04:17.29,0:04:19.96,general text,,0,0,0,,Pumunta ka sa kwarto mo, magdadala ako ng tuwalya
Dialogue: 0,0:04:28.09,0:04:30.88,general text,,0,0,0,,Hindi ko alam kung sino ang huling lumaban sa kanya,
Dialogue: 0,0:04:32.89,0:04:34.85,pangkalahatang teksto,,0,0,0,,ngunit hindi magiging madali ang pagkatalo kay Uka
Dialogue: 0,0:04:49.32,0:04:50.32,pangkalahatang teksto,,0,0,0,,Chan Wook!
Dialogue: 0,0:04:54.53,0:04:55.78,general text,,0,0,0,,Nasaan ang may-ari?
Dialogue: 0,0:04:56.37,0:04:57.87,general text,,0,0,0,,Oh, hinahanap mo ba siya?
Dialogue: 0,0:04:58.66,0:04:59.66,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:05:00.45,0:05:02.21,general text,,0,0,0,,Ikaw si Mu Dok, malamang
Dialogue: 0,0:05:03.42,0:05:05.58,pangkalahatang teksto,,0,0,0,,- Oo\N- Nakikita ko
Dialogue: 0,0:05:05.67,0:05:08.63,general text,,0,0,0,,Yung laging katabi ni Chan Wook
Dialogue: 0,0:05:09.21,0:05:12.42,behind the scenes,,0,0,0,,Yung tagak na sinasabi ng katulong na si Kim.
Dialogue: 0,0:05:12.93,0:05:15.76,italics,,0,0,0,,Pumunta ako para makita siya bago umalis
Dialogue: 0,0:05:15.84,0:05:17.26,pangkalahatang text,,0,0,0,,Enter. A...
Dialogue: 0,0:05:17.35,0:05:20.31,general text,,0,0,0,,Nagdala ako ng meryenda. Gusto?
Dialogue: 0,0:05:21.14,0:05:22.14,pangkalahatang teksto,,0,0,0,,Hindi, salamat
Dialogue: 0,0:05:30.65,0:05:33.78,general text,,0,0,0,,Mabait siya at maamo, gaya ng sinabi ng katulong na si Kim
Dialogue: 0,0:06:34.01,0:06:36.30,general text,,0,0,0,,Bakit ka nakatayo dito ng basa?
Dialogue: 0,0:06:38.30,0:06:39.68,pangkalahatang text,,0,0,0,,Hoy, tingnan mo
Dialogue: 0,0:06:57.45,0:06:59.07,general text,,0,0,0,,Ginawa iyon ng lalaking iyon, di ba?
Dialogue: 0,0:06:59.66,0:07:01.83,pangkalahatang teksto,,0,0,0,,Dapat nating subukan ito gamit ang isang espada
Dialogue: 0,0:07:02.74,0:07:05.62,general text,,0,0,0,,Akala ko nagalit ka sa pagkahulog mo sa tubig
Dialogue: 0,0:07:06.50,0:07:08.42,pangkalahatang teksto,,0,0,0,,At tinasa mo ang iyong laban
Dialogue: 0,0:07:08.92,0:07:11.75,pangkalahatang teksto,,0,0,0,,Sa unang dalawang beses na ganito
Dialogue: 0,0:07:11.84,0:07:13.84,general text,,0,0,0,,galit lang ako na walong beses akong natalo
Dialogue: 0,0:07:15.92,0:07:19.38,general text,,0,0,0,,Sanay kang maglakad nang malinis at plantsado,
Dialogue: 0,0:07:19.47,0:07:22.35,pangkalahatang teksto,,0,0,0,,at ngayon ay nakatayo ka sa basa at marumi, ibig sabihin,
Dialogue: 0,0:07:23.47,0:07:24.85,general text,,0,0,0,,seryoso ka ba
Dialogue: 0,0:07:28.10,0:07:29.65,general text,,0,0,0,,Dumi talaga
Dialogue: 0,0:07:34.82,0:07:36.82,general text,,0,0,0,,Nagmamadali ka ngayon
Dialogue: 0,0:07:36.90,0:07:40.24,general text,,0,0,0,,Hindi na kailangang umatake kapag siya ay nagtatanggol
Dialogue: 0,0:07:40.32,0:07:43.28,general text,,0,0,0,,It was worth waiting for him to weaken his defense
Dialogue: 0,0:07:44.33,0:07:45.49,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:07:45.58,0:07:48.33,pangkalahatang teksto,,0,0,0,,Kung umatras ka pagkatapos ng mga suntok,
Dialogue: 0,0:07:48.41,0:07:51.79,general text,,0,0,0,,relax siya at manghihina
Dialogue: 0,0:07:51.88,0:07:53.34,pangkalahatang teksto,,0,0,0,,proteksyon
Dialogue: 0,0:07:54.09,0:07:56.13,pangkalahatang teksto,,0,0,0,,Ang labanan ay isang laro ng tug of war
Dialogue: 0,0:07:56.76,0:07:59.51,general text,,0,0,0,,Hihilahin ka ng kalaban kapag nagpasya siyang nanghina ka
Dialogue: 0,0:08:00.68,0:08:02.64,pangkalahatang teksto,,0,0,0,,Kung gayon kailangan mong umatake
Dialogue: 0,0:08:04.30,0:08:06.14,pangkalahatang teksto,,0,0,0,,Salamat sa payo, master
Dialogue: 0,0:08:11.56,0:08:12.52,general text,,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:08:14.06,0:08:16.07,pangkalahatang text,,0,0,0,,Lungoy at magpalit ng damit
Dialogue: 0,0:08:16.15,0:08:17.78,general text,,0,0,0,,amoy ko na
Dialogue: 0,0:08:19.19,0:08:21.36,memories,,0,0,0,,Ah, hinahanap mo siya
Dialogue: 0,0:08:28.91,0:08:30.21,pangkalahatang text,,0,0,0,,Huwag pumunta
Dialogue: 0,0:08:33.88,0:08:35.88,pangkalahatang teksto,,0,0,0,,Huwag pumunta sa iyong lugar, manatili dito
Dialogue: 0,0:08:36.75,0:08:39.30,general text,,0,0,0,,- Magdadala ako ng damit\N- Bakit?
Dialogue: 0,0:08:39.38,0:08:41.22,pangkalahatang text,,0,0,0,,Pwede na akong magpalit
Dialogue: 0,0:08:42.18,0:08:43.93,pangkalahatang teksto,,0,0,0,,Bakit labis na trabaho ang iyong sarili na parang tanga?
Dialogue: 0,0:08:49.31,0:08:50.39,general text,,0,0,0,,Tama ka
Dialogue: 0,0:08:52.48,0:08:54.10,pangkalahatang teksto,,0,0,0,,Asal na parang tanga
Dialogue: 0,0:08:58.48,0:08:59.40,pangkalahatang text,,0,0,0,,Go
Dialogue: 0,0:09:04.07,0:09:05.12,pangkalahatang text,,0,0,0,,Moo Dok
Dialogue: 0,0:09:05.20,0:09:06.62,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:09:08.45,0:09:09.49,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:09:16.59,0:09:17.75,pangkalahatang teksto,,0,0,0,,Maupo
Dialogue: 0,0:09:18.59,0:09:19.76,pangkalahatang teksto,,0,0,0,,Oo, maupo
Dialogue: 0,0:09:25.68,0:09:27.85,pangkalahatang teksto,,0,0,0,,Tingnan ang sapatos. Basa lahat
Dialogue: 0,0:09:31.14,0:09:31.98,pangkalahatang teksto,,0,0,0,,Bakit...
Dialogue: 0,0:09:33.23,0:09:35.94,general text,,0,0,0,,Bakit mo pa ako sinundan sa tubig?
Dialogue: 0,0:09:38.82,0:09:43.03,pangkalahatang teksto,,0,0,0,,Minsan nagtatrabaho ka nang hindi makatwiran
Dialogue: 0,0:09:43.11,0:09:45.74,pangkalahatang teksto,,0,0,0,,Bakit nagsisikap na maglinis?
Dialogue: 0,0:09:45.82,0:09:48.20,pangkalahatang text,,0,0,0,,Pahinga, tinutukoy ako
Dialogue: 0,0:09:50.45,0:09:53.41,pangkalahatang text,,0,0,0,,Nagpadala ng tuyong tainga ang dalagang si Kim kay Corwin
Dialogue: 0,0:09:53.50,0:09:56.37,general text,,0,0,0,,Kumain ka rin para sa sarili mo, huwag mong ipaubaya sa akin ang lahat.
Dialogue: 0,0:09:57.67,0:09:58.88,pangkalahatang text,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:10:00.96,0:10:03.67,general text,,0,0,0,,Maganda ang pakikitungo nila sa akin dahil malapit ako kay Dan Gu,
Dialogue: 0,0:10:03.76,0:10:05.18,pangkalahatang teksto,,0,0,0,, tagapagmana ni Sosnovy Bor
Dialogue: 0,0:10:07.26,0:10:08.39,pangkalahatang teksto,,0,0,0,,Ganito
Dialogue: 0,0:10:09.51,0:10:13.60,pangkalahatang teksto,,0,0,0,,Alam kong ginagamit mo ang kapangyarihan para sa iyong kalamangan
Dialogue: 0,0:10:20.65,0:10:22.07,pangkalahatang teksto,,0,0,0,,Nasugatan ka
Dialogue: 0,0:10:24.49,0:10:26.36,general text,,0,0,0,,Walong sunod-sunod na araw akong lumaban
Dialogue: 0,0:10:27.45,0:10:28.87,pangkalahatang teksto,,0,0,0,,Hindi lang ito ang sugat
Dialogue: 0,0:10:31.37,0:10:32.74,pangkalahatang teksto,,0,0,0,,Saan pa?
Dialogue: 0,0:10:33.58,0:10:35.50,general text,,0,0,0,,Dapat tayong pumunta sa Sejukwon
Dialogue: 0,0:10:35.58,0:10:37.17,general text,,0,0,0,,May natitira pang laban
Dialogue: 0,0:10:39.63,0:10:41.46,pangkalahatang teksto,,0,0,0,,Dapat tayong magdusa nang husto,
Dialogue: 0,0:10:42.80,0:10:44.55,general text,,0,0,0,,hangga't naghihintay ang aking amo
Dialogue: 0,0:11:00.86,0:11:02.23,pangkalahatang teksto,,0,0,0,,Ang mga paa ay magyeyelo
Dialogue: 0,0:11:03.36,0:11:04.78,general text,,0,0,0,,Magpalit ka rin ng damit
Dialogue: 0,0:11:46.53,0:11:47.65,general text,,0,0,0,,Maiden Kim?
Dialogue: 0,0:12:01.54,0:12:03.25,pangkalahatang teksto,,0,0,0,,Tapos na, Kamahalan
Dialogue: 0,0:12:03.34,0:12:06.34,general text,,0,0,0,,Pait ang gamot. Any sweets?
Dialogue: 0,0:12:06.42,0:12:08.59,general text,,0,0,0,,May dadalhin ako
Dialogue: 0,0:12:19.35,0:12:21.56,memories italics,,0,0,0,,Dapat mayroon ding red jade
Dialogue: 0,0:12:22.44,0:12:24.48,mga alaala na italics,,0,0,0,,Pares lang ang halaga nila
Dialogue: 0,0:12:26.19,0:12:27.82,general text,,0,0,0,,Baka itapon ko na lang?
Dialogue: 0,0:13:07.23,0:13:08.57,pangkalahatang teksto,,0,0,0,,Ano?..
Dialogue: 0,0:13:09.15,0:13:10.36,pangkalahatang teksto,,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:13:18.87,0:13:21.00,behind the scenes,,0,0,0,,Ano ito?
Dialogue: 0,0:13:33.22,0:13:37.64,offscreen,,0,0,0,,May humihikayat sa akin ng hindi kapani-paniwalang puwersa
Dialogue: 0,0:13:41.47,0:13:43.10,behind the scenes,,0,0,0,,Hindi maipaliwanag na atraksyon...
Dialogue: 0,0:13:44.23,0:13:45.19,voiceover,,0,0,0,,Tumatawag ito sa akin
Dialogue: 0,0:14:37.53,0:14:39.03,general text,,0,0,0,,- Damn it\N- Tama yan
Dialogue: 0,0:14:39.12,0:14:41.45,pangkalahatang teksto,,0,0,0,,Bakit kailangang magbuhos ng enerhiya sa jade
Dialogue: 0,0:14:41.53,0:14:43.54,pangkalahatang text,,0,0,0,,at nalilito ako?
Dialogue: 0,0:14:43.62,0:14:45.50,pangkalahatang teksto,,0,0,0,,Ito ay medyo nakakasakit
Dialogue: 0,0:14:45.58,0:14:46.41,pangkalahatang teksto,,0,0,0,,Parehong bagay
Dialogue: 0,0:14:46.50,0:14:51.04,general text,,0,0,0,,Nasaktan ako na tumibok ng husto ang puso ko dahil sayo!
Dialogue: 0,0:14:55.88,0:14:56.93,pangkalahatang teksto,,0,0,0,,At ikaw...
Dialogue: 0,0:14:57.97,0:14:59.14,pangkalahatang teksto,,0,0,0,,naramdaman din ba ito?
Dialogue: 0,0:15:00.51,0:15:03.93,general text,,0,0,0,,Tumibok ang puso ko kaya...
Dialogue: 0,0:15:06.56,0:15:08.31,general text,,0,0,0,,- Oh...\N- Don’t say
Dialogue: 0,0:15:11.02,0:15:12.15,pangkalahatang teksto,,0,0,0,,Kalimutan
Dialogue: 0,0:15:12.94,0:15:14.15,general text,,0,0,0,,Nagulat ka,
Dialogue: 0,0:15:14.98,0:15:17.03,pangkalahatang teksto,,0,0,0,,na nangangahulugang hindi ko pa ito ginamit
Dialogue: 0,0:15:17.86,0:15:18.78,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:15:18.86,0:15:20.41,pangkalahatang teksto,,0,0,0,,Walang magic si Moo Dok
Dialogue: 0,0:15:21.07,0:15:22.70,pangkalahatang teksto,,0,0,0,,Hindi ka makapagpalitan ng enerhiya
Dialogue: 0,0:15:22.78,0:15:23.87,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:15:24.41,0:15:27.08,general text,,0,0,0,,Hindi ko alam na may ganoong kapangyarihan ang jade na ito
Dialogue: 0,0:15:42.68,0:15:44.39,pangkalahatang teksto,,0,0,0,,Sapat na
Dialogue: 0,0:15:45.77,0:15:47.77,pangkalahatang teksto,,0,0,0,,Gayunpaman,
Dialogue: 0,0:15:48.56,0:15:50.06,general text,,0,0,0,,May bago akong natutunan
Dialogue: 0,0:15:50.90,0:15:52.81,general text,,0,0,0,,- Salamat\N- Ano?
Dialogue: 0,0:15:52.90,0:15:53.98,pangkalahatang teksto,,0,0,0,,Sa tingin mo ba dapat ko itong gamitin?
Dialogue: 0,0:15:55.02,0:15:56.36,pangkalahatang teksto,,0,0,0,,Malamang na hindi mo magagawa
Dialogue: 0,0:15:57.78,0:15:59.15,pangkalahatang teksto,,0,0,0,,Hindi na ito babawiin ni Moo Dok
Dialogue: 0,0:15:59.24,0:16:01.20,general text,,0,0,0,,May dalawa pa akong laban
Dialogue: 0,0:16:01.74,0:16:03.78,pangkalahatang teksto,,0,0,0,,Ibabalik ko ito at gagamitin
Dialogue: 0,0:16:03.87,0:16:05.83,pangkalahatang teksto,,0,0,0,,I-save hanggang doon
Dialogue: 0,0:16:07.33,0:16:08.83,pangkalahatang teksto,,0,0,0,,At pakiusap,
Dialogue: 0,0:16:09.50,0:16:10.92,pangkalahatang teksto,,0,0,0,,huwag makipaglaro sa enerhiya
Dialogue: 0,0:16:12.88,0:16:14.42,general text,,0,0,0,,Ikaw din
Dialogue: 0,0:16:19.80,0:16:22.18,general text,,0,0,0,,Your Highness, saan ka napunta?
Dialogue: 0,0:16:23.60,0:16:24.76,memories italics,,0,0,0,,Isama ka?
Dialogue: 0,0:16:26.26,0:16:27.31,mga alaala,,0,0,0,,Kaya ko
Dialogue: 0,0:16:27.93,0:16:30.23,mga alaala,,0,0,0,,Makakahanap ka ng trabaho dito
Dialogue: 0,0:16:31.64,0:16:32.77,mga alaala,,0,0,0,,Ayoko
Dialogue: 0,0:16:33.86,0:16:35.69,general text,,0,0,0,,- Eunuch O\N- Oo?
Dialogue: 0,0:16:35.77,0:16:38.69,general text,,0,0,0,,Alamin kung sino ang susunod na lalaban kay Uka
Dialogue: 0,0:16:39.28,0:16:40.24,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:16:40.86,0:16:42.03,pangkalahatang teksto,,0,0,0,,Huwag kang magkamali
Dialogue: 0,0:16:42.70,0:16:43.87,mga inskripsiyon,,0,0,0,,Hyonggon Art
Dialogue: 0,0:16:43.95,0:16:44.82,pangkalahatang teksto,,0,0,0,,Hey,
Dialogue: 0,0:16:44.91,0:16:46.83,general text,,0,0,0,,gaano mo gusto ang laban?
Dialogue: 0,0:16:46.91,0:16:50.04,pangkalahatang text,,0,0,0,,Kasama si Chan Wook? Kasing dali ng paghihimay ng peras
Dialogue: 0,0:16:50.96,0:16:53.17,italics,,0,0,0,,- Handa ka na ba para sa iyo?\N- Syempre
Dialogue: 0,0:16:53.25,0:16:55.71,general text,,0,0,0,,Hyunggon ang gamit ko, kung tutuusin...
Dialogue: 0,0:16:59.38,0:17:02.05,behind the scenes,,0,0,0,,Isang mago mula sa pamilya Cha na nagmamay-ari ng Hyunggon
Dialogue: 0,0:17:02.72,0:17:04.76,offscreen,,0,0,0,,Siya ay nanonood ng Uk sa buong oras
Dialogue: 0,0:17:04.84,0:17:08.68,behind the scenes,,0,0,0,,Isang duwag na nagpasya na lumaban lamang pagkatapos na matalo si Chan Wook
Dialogue: 0,0:17:09.56,0:17:11.48,italics,,0,0,0,,Maaari siyang talunin ng UK
Dialogue: 0,0:17:15.10,0:17:18.15,pangkalahatang teksto,,0,0,0,,Hyonggon ay isang kamangha-manghang sining
Dialogue: 0,0:17:18.82,0:17:21.19,pangkalahatang teksto,,0,0,0,,Ngunit walang silbi kung kulang ka sa mga kasanayan
Dialogue: 0,0:17:22.11,0:17:24.16,pangkalahatang teksto,,0,0,0,,Mukhang nakakatakot si Cha Bum,
Dialogue: 0,0:17:24.24,0:17:25.66,general text,,0,0,0,,pero façade lang ito
Dialogue: 0,0:17:26.70,0:17:29.16,voiceover,,0,0,0,,Kaya madaling basahin ni Yul ang iba, no wonder
Dialogue: 0,0:17:29.66,0:17:30.75,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:17:31.29,0:17:33.67,pangkalahatang teksto,,0,0,0,,At umiikot siya na sinasabi sa lahat kung gaano ito kadali
Dialogue: 0,0:17:34.21,0:17:35.96,pangkalahatang teksto,,0,0,0,,matalo ang may-ari
Dialogue: 0,0:17:36.04,0:17:37.13,general text,,0,0,0,,Natatakot lang siya
Dialogue: 0,0:17:38.00,0:17:40.42,pangkalahatang teksto,,0,0,0,,Malaking bumuti ang UK sa mga araw na ito
Dialogue: 0,0:17:41.05,0:17:43.63,general text,,0,0,0,,Natatakot si Bom na matalo siya ni Uk
Dialogue: 0,0:17:44.84,0:17:49.10,pangkalahatang teksto,,0,0,0,,Kaya't ang aking panginoon ay nag-improve nang husto kaya siya nag-aalala sa iba
Dialogue: 0,0:17:51.85,0:17:54.10,general text,,0,0,0,,Natutuwa ka ba na naging mas malakas ang Uk?
Dialogue: 0,0:17:54.19,0:17:57.11,pangkalahatang teksto,,0,0,0,,Siyempre. Deretso sa langit ang pagmamataas
Dialogue: 0,0:17:58.52,0:18:01.48,voiceover,,0,0,0,,Sinasanay ni Nak Soo si Wook
Dialogue: 0,0:18:01.57,0:18:02.65,italics,,0,0,0,,Yul
Dialogue: 0,0:18:05.53,0:18:06.91,general text,,0,0,0,,Narinig mo na ba?
Dialogue: 0,0:18:06.99,0:18:08.70,general text,,0,0,0,,May kaguluhan sa kabisera
Dialogue: 0,0:18:09.58,0:18:10.74,general text,,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:18:10.83,0:18:14.46,pangkalahatang teksto,,0,0,0,,Namatay si Master Kang ng Degantongun dahil sa sakit
Dialogue: 0,0:18:15.83,0:18:16.87,general text,,0,0,0,,Pero may mga tsismis,
Dialogue: 0,0:18:17.54,0:18:19.67,general text,,0,0,0,,na inatake siya ng mga mersenaryo kagabi
Dialogue: 0,0:18:20.96,0:18:23.84,italics,,0,0,0,,Nagpunta sina Uncle at Master Huo sa libing
Dialogue: 0,0:18:24.42,0:18:27.18,general text,,0,0,0,,At kung pareho silang mga mersenaryo ni Nak Su?
Dialogue: 0,0:18:39.19,0:18:41.73,mga inskripsiyon,,0,0,0,,Ang namatay na si Kang Man Jung
Dialogue: 0,0:18:43.69,0:18:46.03,italics,,0,0,0,,Bakit hindi natin maipahayag ang ating pakikiramay?
Dialogue: 0,0:18:47.82,0:18:50.78,pangkalahatang teksto,,0,0,0,,Ang aming pamilya ay naghahatid ng mga mamahaling produkto
Dialogue: 0,0:18:50.87,0:18:53.45,pangkalahatang teksto,,0,0,0,,Kung nalaman ng mga tao na ang pinuno ng bahay
Dialogue: 0,0:18:53.54,0:18:57.25,general text,,0,0,0,,pinatay ng mga mersenaryo, mawawalan ng trabaho ang pamilya
Dialogue: 0,0:18:57.96,0:18:59.54,general text,,0,0,0,,Ibinalita na siya ay namatay sa isang nakakahawang sakit
Dialogue: 0,0:19:00.13,0:19:01.46,general text,,0,0,0,,Kaya walang makapasok
Dialogue: 0,0:19:04.76,0:19:06.42,pangkalahatang teksto,,0,0,0,,Got it
Dialogue: 0,0:19:06.51,0:19:09.30,pangkalahatang teksto,,0,0,0,,Mayroon bang anumang mga pahiwatig na makakatulong sa paghahanap ng mga mersenaryo?
Dialogue: 0,0:19:11.26,0:19:12.93,general text,,0,0,0,,Nagsagawa ka na ba ng autopsy?
Dialogue: 0,0:19:14.64,0:19:18.06,pangkalahatang teksto,,0,0,0,,Si Master Kahn ay sinaksak hanggang mamatay gamit ang isang espada sa harap ng ating mga mata
Dialogue: 0,0:19:18.65,0:19:19.98,pangkalahatang teksto,,0,0,0,,Hindi na kailangan
Dialogue: 0,0:19:21.61,0:19:23.40,pangkalahatang teksto,,0,0,0,,Ang kanyang katawan ay susunugin ngayong gabi
Dialogue: 0,0:19:23.48,0:19:25.03,general text,,0,0,0,,So soon?
Dialogue: 0,0:19:25.61,0:19:26.74,pangkalahatang teksto,,0,0,0,,Ito ay nakakalungkot,
Dialogue: 0,0:19:26.82,0:19:28.66,general text,,0,0,0,,pero kailangan nating magmadali bago kumalat ang tsismis
Dialogue: 0,0:19:28.74,0:19:32.66,general text,,0,0,0,,Sigurado akong gusto din ni Master Kan
Dialogue: 0,0:19:32.74,0:19:33.79,pangkalahatang teksto,,0,0,0,,Hindi ito katanggap-tanggap
Dialogue: 0,0:19:33.87,0:19:36.00,general text,,0,0,0,,Kung i-cremate mo siya,
Dialogue: 0,0:19:36.66,0:19:39.25,pangkalahatang teksto,,0,0,0,,walang katibayan ng pagpatay
Dialogue: 0,0:19:41.67,0:19:43.13,pangkalahatang teksto,,0,0,0,,Ito ay isang bagay sa pamilya
Dialogue: 0,0:19:44.46,0:19:46.30,general text,,0,0,0,,Naiintindihan kong nag-aalala ka
Dialogue: 0,0:19:47.30,0:19:50.30,pangkalahatang teksto,,0,0,0,,Ngunit ang pinuno ng Sosnovy Bor ay hindi kailangang makisali dito
Dialogue: 0,0:19:51.59,0:19:54.01,pangkalahatang teksto,,0,0,0,,Kailangan ng autopsy
Dialogue: 0,0:19:54.10,0:19:55.81,pangkalahatang teksto,,0,0,0,,Ipagpaliban ang cremation
Dialogue: 0,0:19:57.18,0:20:01.02,general text,,0,0,0,,Si Sosnovy Bor ay dumating sa puntong nakakasagabal ito sa mga libing ng ibang tao?
Dialogue: 0,0:20:04.40,0:20:05.73,pangkalahatang teksto,,0,0,0,,Hindi kami nakikialam
Dialogue: 0,0:20:06.48,0:20:10.74,pangkalahatang teksto,,0,0,0,,Sinusubukan kong bigyan ng babala ang bagong pinuno ng bahay
Dialogue: 0,0:20:10.82,0:20:12.74,pangkalahatang teksto,,0,0,0,,mula sa hindi na maibabalik na error
Dialogue: 0,0:20:12.82,0:20:14.87,general text,,0,0,0,,Bakit ka tutol?
Dialogue: 0,0:20:14.95,0:20:16.49,pangkalahatang teksto,,0,0,0,,Anong karapatan mo?
Dialogue: 0,0:20:16.58,0:20:20.12,italics,,0,0,0,,Hindi nagtagal, ang mga salamangkero ay inatake ni Nak Su
Dialogue: 0,0:20:20.21,0:20:22.29,pangkalahatang teksto,,0,0,0,,Ngayon ay may lumitaw na mga bagong mersenaryo
Dialogue: 0,0:20:23.04,0:20:25.75,pangkalahatang teksto,,0,0,0,,Maaaring may koneksyon ang kasong ito at ang mahika ng Nak Su
Dialogue: 0,0:20:26.42,0:20:27.63,general text,,0,0,0,,Kaya nakikialam ako
Dialogue: 0,0:20:28.84,0:20:30.68,pangkalahatang teksto,,0,0,0,,Walang magic
Dialogue: 0,0:20:30.76,0:20:31.68,pangkalahatang text,,0,0,0,,makukumpirma ko
Dialogue: 0,0:20:31.76,0:20:33.64,general text,,0,0,0,,Saan nanggagaling ang ganoong kumpiyansa nang walang autopsy?!
Dialogue: 0,0:20:35.05,0:20:38.47,pangkalahatang teksto,,0,0,0,,Ayaw magsagawa ng autopsy ng ulo
Dialogue: 0,0:20:38.56,0:20:40.77,general text,,0,0,0,,Jin Mu, tumahimik ka na lang
Dialogue: 0,0:20:41.35,0:20:43.40,pangkalahatang teksto,,0,0,0,,May karapatan kaming makialam,
Dialogue: 0,0:20:43.48,0:20:45.06,pangkalahatang teksto,,0,0,0,,kung magic ang pinag-uusapan
Dialogue: 0,0:20:45.15,0:20:47.61,general text,,0,0,0,,Sumasang-ayon ka ba, Ms. Jin?
Dialogue: 0,0:20:49.57,0:20:50.95,pangkalahatang teksto,,0,0,0,,Sa tingin ko,
Dialogue: 0,0:20:52.53,0:20:55.12,general text,,0,0,0,,sa pagkakataong ito ay tama ang deputy
Dialogue: 0,0:20:58.95,0:21:01.50,pangkalahatang teksto,,0,0,0,,Kinumpirma ng bagong pinuno ang pagkamatay ni Master Kahn
Dialogue: 0,0:21:01.58,0:21:05.13,general text,,0,0,0,,At wala siyang choice kundi itago ang totoong dahilan
Dialogue: 0,0:21:07.00,0:21:09.96,pangkalahatang teksto,,0,0,0,,Walang ebidensya na tumuturo sa mahika
Dialogue: 0,0:21:11.30,0:21:15.14,pangkalahatang teksto,,0,0,0,,Kaya duda ako na may makukuha si Sosnovy Bor dito
Dialogue: 0,0:21:21.98,0:21:24.19,general text,,0,0,0,,Gusto ko lang pangalagaan ang dignidad ng master
Dialogue: 0,0:21:24.27,0:21:27.73,general text,,0,0,0,,Ituloy natin ang libing
Dialogue: 0,0:21:50.71,0:21:53.93,pangkalahatang teksto,,0,0,0,,Hayagan kaming pinababayaan ni Jin Mu
Dialogue: 0,0:21:56.93,0:21:59.22,pangkalahatang teksto,,0,0,0,,Bakit sila tutol dito?
Dialogue: 0,0:22:00.39,0:22:02.56,pangkalahatang teksto,,0,0,0,,- Kakaiba\N- At saka,
Dialogue: 0,0:22:02.64,0:22:06.77,general text,,0,0,0,,Hindi ko akalain na papanig si Mrs.
Dialogue: 0,0:22:07.36,0:22:09.69,pangkalahatang teksto,,0,0,0,,kinasusuklaman niya ang stepbrother
Dialogue: 0,0:22:13.90,0:22:17.11,general text,,0,0,0,,Natuwa ako nung pumanig ka sa akin
Dialogue: 0,0:22:18.99,0:22:20.03,pangkalahatang teksto,,0,0,0,,Husga para sa iyong sarili
Dialogue: 0,0:22:20.12,0:22:24.33,pangkalahatang teksto,,0,0,0,,Sa sandaling nagkaisa kami, kinailangang sumuko si Sosnovny Bor
Dialogue: 0,0:22:26.08,0:22:28.04,general text,,0,0,0,,Kumusta ang paghahanap kay Boo Young?
Dialogue: 0,0:22:30.55,0:22:32.96,general text,,0,0,0,,Hinanap namin ang buong paligid ng lawa
Dialogue: 0,0:22:33.05,0:22:36.09,pangkalahatang text,,0,0,0,,naghahanap ng bulag na babae sa parehong edad
Dialogue: 0,0:22:37.68,0:22:41.26,pangkalahatang teksto,,0,0,0,,Ginagawa ko ito sa nakalipas na sampung taon
Dialogue: 0,0:22:41.35,0:22:42.39,pangkalahatang teksto,,0,0,0,,To be honest,
Dialogue: 0,0:22:43.18,0:22:45.81,general text,,0,0,0,,Parang alam ko na kung ano ang nangyari kay Boo Young
Dialogue: 0,0:22:47.27,0:22:50.52,pangkalahatang teksto,,0,0,0,,Sampung taon na ang nakalipas, isang batang babae ang naligo sa pampang ng ilog
Dialogue: 0,0:22:52.19,0:22:54.15,general text,,0,0,0,,- Oo?\N- Dito lang
Dialogue: 0,0:22:56.07,0:22:57.78,general text,,0,0,0,,matagal na siyang patay
Dialogue: 0,0:23:04.70,0:23:08.54,general text,,0,0,0,,Inay, sigurado akong hindi siya iyon
Dialogue: 0,0:23:08.62,0:23:11.25,pangkalahatang teksto,,0,0,0,,Sinabi ko sa aking mga tao na hukayin ang libingan
Dialogue: 0,0:23:12.09,0:23:14.46,general text,,0,0,0,,Kung patay na talaga si Boo Young,
Dialogue: 0,0:23:14.55,0:23:18.13,pangkalahatang teksto,,0,0,0,,Dadalhin ko sa iyo ang kanyang katawan sa anumang halaga
Dialogue: 0,0:23:18.97,0:23:20.51,pangkalahatang text,,0,0,0,,Hindi ito gagana
Dialogue: 0,0:23:21.39,0:23:24.06,general text,,0,0,0,,Ibalik mo sa akin ang aking anak na buhay
Dialogue: 0,0:23:25.22,0:23:27.39,general text,,0,0,0,,Definitely, kalma lang
Dialogue: 0,0:23:28.56,0:23:30.52,general text,,0,0,0,,Hahanapin natin siyang buhay
Dialogue: 0,0:23:46.41,0:23:48.04,italics,,0,0,0,,Tinignan mo ba itong mabuti?
Dialogue: 0,0:23:48.91,0:23:51.21,pangkalahatang teksto,,0,0,0,,Ang iyong magiging ina at kapatid na babae
Dialogue: 0,0:23:51.92,0:23:53.04,pangkalahatang teksto,,0,0,0,,Sa tingin mo,
Dialogue: 0,0:23:53.92,0:23:56.17,general text,,0,0,0,,maniniwala ba sila na anak nila ako?
Dialogue: 0,0:23:56.26,0:23:57.59,general text,,0,0,0,,Bihis ka na ba?
Dialogue: 0,0:23:58.92,0:24:01.80,pangkalahatang teksto,,0,0,0,,tulad ni Boo Young noong bata pa
Dialogue: 0,0:24:01.89,0:24:03.89,pangkalahatang text,,0,0,0,,Pero hindi ko akalaing bibilhin ito ni Ho Kyung
Dialogue: 0,0:24:06.35,0:24:08.60,pangkalahatang text,,0,0,0,,Tapos magagandang damit
Dialogue: 0,0:24:10.39,0:24:12.23,pangkalahatang teksto,,0,0,0,,hindi maglalaro sa ating mga kamay
Dialogue: 0,0:24:12.81,0:24:15.36,pangkalahatang teksto,,0,0,0,,dapat magmukha akong kaawa-awa
Dialogue: 0,0:24:16.65,0:24:18.69,general text,,0,0,0,,Nawalan siya ng anak na babae
Dialogue: 0,0:24:18.78,0:24:22.82,general text,,0,0,0,,Kung maawa siya sa akin, ako lang ang mananalo sa puso niya.
Dialogue: 0,0:24:25.66,0:24:26.79,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:24:27.75,0:24:29.46,general text,,0,0,0,,Tama ka, Kaya ako
Dialogue: 0,0:24:33.71,0:24:34.96,pangkalahatang teksto,,0,0,0,,Siguradong gagawin ko
Dialogue: 0,0:24:37.67,0:24:40.55,general text,,0,0,0,,Magiging anak ako ng pamilya Jin
Dialogue: 0,0:24:53.69,0:24:55.31,general text,,0,0,0,,Mas maganda ka
Dialogue: 0,0:24:55.98,0:24:58.23,general text,,0,0,0,,Oo, mabilis akong gumaling
Dialogue: 0,0:25:09.62,0:25:11.79,pangkalahatang teksto,,0,0,0,,Hyonggon Art
Dialogue: 0,0:25:12.75,0:25:14.13,pangkalahatang teksto,,0,0,0,,detalyadong
Dialogue: 0,0:25:20.13,0:25:23.93,general text,,0,0,0,,May hinala ako tungkol sa pagkamatay ni Master Kahn
Dialogue: 0,0:25:36.31,0:25:40.07,general text,,0,0,0,,Malakas siya, magaling siya sa spells
Dialogue: 0,0:25:40.15,0:25:42.82,general text,,0,0,0,,Ngunit namamatay na siya sa sakit
Dialogue: 0,0:25:43.61,0:25:46.99,pangkalahatang teksto,,0,0,0,,Hindi na kailangang magpadala bilang isang mersenaryo
Dialogue: 0,0:25:47.07,0:25:49.20,general text,,0,0,0,,Baka may nagtanim ng sama ng loob sa kanya
Dialogue: 0,0:25:49.99,0:25:52.08,pangkalahatang text,,0,0,0,,at gustong pumatay sa sarili ko
Dialogue: 0,0:25:52.16,0:25:53.08,italics,,0,0,0,,Hindi
Dialogue: 0,0:25:53.16,0:25:55.00,general text,,0,0,0,,Hindi pa namin alam,
Dialogue: 0,0:25:56.21,0:25:58.79,pangkalahatang teksto,,0,0,0,,ngunit dapat may dahilan para sa pag-atake
Dialogue: 0,0:26:01.80,0:26:05.09,pangkalahatang teksto,,0,0,0,,Kapag ang kaluluwa ay pumasok sa isang bagong katawan, hindi na kailangan ang luma
Dialogue: 0,0:26:05.68,0:26:07.72,pangkalahatang teksto,,0,0,0,,Ngunit hindi ganoon kadali ang pag-alis nito
Dialogue: 0,0:26:07.80,0:26:11.27,pangkalahatang teksto,,0,0,0,,Sa mata ng mga tao, ito ay isang makapangyarihang salamangkero,
Dialogue: 0,0:26:11.35,0:26:13.23,pangkalahatang teksto,,0,0,0,,opisyal o mangangalakal
Dialogue: 0,0:26:13.89,0:26:16.52,general text,,0,0,0,,Kung bigla na lang siyang mawawala, magdududa.
Dialogue: 0,0:26:18.31,0:26:23.03,general text,,0,0,0,,Nak Soo ang bahala dito
Dialogue: 0,0:26:23.11,0:26:25.15,pangkalahatang teksto,,0,0,0,,Ang tinutukoy mo ba ay mandirigma ng kadiliman?
Dialogue: 0,0:26:27.49,0:26:30.08,pangkalahatang teksto,,0,0,0,,Salamat sa mandirigmang ito,
Dialogue: 0,0:26:30.66,0:26:34.96,pangkalahatang teksto,,0,0,0,,Hindi man lang naisip ni Sosnovy Bor na gumagawa ako ng mga nomad
Dialogue: 0,0:26:36.29,0:26:38.58,italics,,0,0,0,,Nang hinabol ko si Nak Su,
Dialogue: 0,0:26:38.67,0:26:42.17,general text,,0,0,0,,Akala ko baliw siya, na gustong patunayan ang sarili
Dialogue: 0,0:26:42.25,0:26:46.22,general text,,0,0,0,,Kaya hindi ko na tiningnan kung sino ang pinatay niya
Dialogue: 0,0:26:48.84,0:26:50.76,pangkalahatang teksto,,0,0,0,,Ibig sabihin, pinatay niya ang mga iyon
Dialogue: 0,0:26:51.51,0:26:53.81,general text,,0,0,0,,kaninong mga kaluluwa ang ginalaw ni Jin Mu?
Dialogue: 0,0:26:53.89,0:26:55.31,pangkalahatang teksto,,0,0,0,,Mas tiyak ang mga iyon,
Dialogue: 0,0:26:56.39,0:26:59.48,pangkalahatang teksto,,0,0,0,,na hindi kailangan pagkatapos ng paglipat
Dialogue: 0,0:26:59.56,0:27:02.19,general text,,0,0,0,,Sabi mo anak siya ni Cho Chun
Dialogue: 0,0:27:02.98,0:27:07.78,general text,,0,0,0,,Kaya kinuha niya ang batang babae at ginawang mersenaryo?
Dialogue: 0,0:27:09.57,0:27:11.99,italics,,0,0,0,,Kaya nga hindi ko ipinahalata sa kanya ang identity ko.
Dialogue: 0,0:27:12.74,0:27:14.95,general text,,0,0,0,,at pinilit akong mamuhay mag-isa sa kabundukan
Dialogue: 0,0:27:16.46,0:27:18.71,pangkalahatang teksto,,0,0,0,,Binigyan siya ng hindi hihigit sa kailangan niya para mabuhay
Dialogue: 0,0:27:19.54,0:27:23.46,pangkalahatang teksto,,0,0,0,,Ngunit siya ay determinado at lumaking malakas
Dialogue: 0,0:27:25.01,0:27:26.55,pangkalahatang teksto,,0,0,0,,Dahil...
Dialogue: 0,0:27:27.13,0:27:29.97,general text,,0,0,0,,Akala niya ganito ang paghihiganti niya para sa kanyang pamilya
Dialogue: 0,0:27:30.05,0:27:31.55,pangkalahatang teksto,,0,0,0,,Samakatuwid, sinunod ko si Jin Mu
Dialogue: 0,0:27:33.47,0:27:35.93,italics,,0,0,0,,Nakatulong siya
Dialogue: 0,0:27:36.52,0:27:39.44,pangkalahatang teksto,,0,0,0,,At pagkatapos ay ang isang lagalag ay naging isang lumulunok ng kaluluwa
Dialogue: 0,0:27:40.10,0:27:41.40,pangkalahatang teksto,,0,0,0,,Dahil dito
Dialogue: 0,0:27:42.44,0:27:44.69,pangkalahatang teksto,,0,0,0,,Sinala ni Sosnovy Bor ang alchemy ng mga kaluluwa
Dialogue: 0,0:27:45.73,0:27:47.90,general text,,0,0,0,,Nang malaman ni Jin Mu na hinahanap namin siya,
Dialogue: 0,0:27:48.74,0:27:51.45,general text,,0,0,0,,natatakot siya na mahuli siya
Dialogue: 0,0:27:52.24,0:27:57.16,general text,,0,0,0,,Tiyak na ipinadala niya siya kay Sosnovy Bor, alam niyang mamamatay siya.
Dialogue: 0,0:28:10.47,0:28:12.76,general text,,0,0,0,,Mu Dok, magdala ka ng tubig
Dialogue: 0,0:28:12.85,0:28:13.89,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:28:22.44,0:28:25.69,general text,,0,0,0,,Moo Dok, hindi ka ba nakinig sa akin?
Dialogue: 0,0:28:25.77,0:28:27.82,general text,,0,0,0,,Sabi ko magpahinga ka
Dialogue: 0,0:28:30.82,0:28:32.41,pangkalahatang teksto,,0,0,0,,At paano ang iyong sarili?
Dialogue: 0,0:28:32.49,0:28:34.45,general text,,0,0,0,,Sabi ko pagalingin mo ang mga sugat
Dialogue: 0,0:28:34.53,0:28:37.75,general text,,0,0,0,,Pumunta ako sa Sejukwon. nakinig ako sayo
Dialogue: 0,0:28:41.46,0:28:42.67,pangkalahatang teksto,,0,0,0,,Maaari mong suriin
Dialogue: 0,0:28:45.96,0:28:47.17,pangkalahatang teksto,,0,0,0,,Amoy wormwood
Dialogue: 0,0:28:54.35,0:28:55.68,general text,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:28:55.76,0:28:59.10,general text,,0,0,0,,May mga away ako araw-araw. Pagod lang
Dialogue: 0,0:29:06.32,0:29:07.65,pangkalahatang teksto,,0,0,0,,Kainitan
Dialogue: 0,0:29:10.32,0:29:12.45,general text,,0,0,0,,Pinahiran ka ba nila ng mainit na wormwood?
Dialogue: 0,0:29:13.24,0:29:15.37,general text,,0,0,0,,Naiinitan ako diba?
Dialogue: 0,0:29:16.83,0:29:19.37,pangkalahatang teksto,,0,0,0,,Oo. Mainit
Dialogue: 0,0:29:23.67,0:29:27.46,memories italics,,0,0,0,,Siya ay nalinlang at ipinadala sa tiyak na kamatayan
Dialogue: 0,0:29:28.50,0:29:29.51,mga alaala na italics,,0,0,0,,Nak Su...
Dialogue: 0,0:29:29.59,0:29:32.42,memories italics,,0,0,0,,Naaawa talaga ako sa batang ito
Dialogue: 0,0:29:41.85,0:29:43.48,pangkalahatang text,,0,0,0,,Lamig ka na. Hayaan mo
Dialogue: 0,0:29:46.36,0:29:49.40,general text,,0,0,0,,- Nagpalit ka na ba ng sapatos?\N- Oo
Dialogue: 0,0:29:49.48,0:29:51.15,general text,,0,0,0,,Kumain ka ba ng dala ng maid Kim?
Dialogue: 0,0:29:51.24,0:29:54.53,pangkalahatang teksto,,0,0,0,,Oo. Actually, kumain na ako bago ka nagsuggest.
Dialogue: 0,0:29:55.11,0:29:57.07,pangkalahatang teksto,,0,0,0,,Magaling, Moo Deok
Dialogue: 0,0:29:59.12,0:30:01.75,pangkalahatang teksto,,0,0,0,,Hindi ko alam na kaya pala ng batong ito
Dialogue: 0,0:30:04.50,0:30:05.58,pangkalahatang teksto,,0,0,0,,Jade yin-yang?
Dialogue: 0,0:30:05.67,0:30:07.67,general text,,0,0,0,,Naintindihan ko lang kasi binigay mo sa prinsipe
Dialogue: 0,0:30:08.42,0:30:10.00,general text,,0,0,0,,At ano ang magagawa niya?
Dialogue: 0,0:30:10.09,0:30:12.05,pangkalahatang text,,0,0,0,,- Ipakita\N- Hindi ko kaya
Dialogue: 0,0:30:12.13,0:30:13.72,pangkalahatang teksto,,0,0,0,,Ipapakita ko,
Dialogue: 0,0:30:13.80,0:30:15.93,general text,,0,0,0,,kailan ko ibabalik ang sa iyo
Dialogue: 0,0:30:17.43,0:30:18.72,general text,,0,0,0,,Ibibigay mo sa akin
Dialogue: 0,0:30:19.72,0:30:21.14,general text,,0,0,0,,kailan mo ito kukunin?
Dialogue: 0,0:30:22.89,0:30:25.31,pangkalahatang teksto,,0,0,0,,Ano? Hindi mo ba tatanggapin?
Dialogue: 0,0:30:28.98,0:30:32.65,general text,,0,0,0,,Ibabalik ko ito at ilalagay sa iyong mga kamay
Dialogue: 0,0:30:32.74,0:30:35.53,pangkalahatang teksto,,0,0,0,,Ito ay may malaking kapangyarihan
Dialogue: 0,0:30:35.61,0:30:36.95,pangkalahatang teksto,,0,0,0,,Sa kabutihang palad hindi namin alam ang tungkol dito
Dialogue: 0,0:30:37.03,0:30:39.58,general text,,0,0,0,,Magugulat ka kapag nakita mo
Dialogue: 0,0:30:43.66,0:30:45.83,pangkalahatang teksto,,0,0,0,,Anong uri ng kapangyarihan? Ipakita mo sa akin
Dialogue: 0,0:30:46.50,0:30:49.38,general text,,0,0,0,,Nahulog sa lupa ang Crown Prince, bumubula ang bibig
Dialogue: 0,0:30:49.96,0:30:51.38,pangkalahatang teksto,,0,0,0,,Nakakatakot
Dialogue: 0,0:30:51.46,0:30:53.96,pangkalahatang teksto,,0,0,0,,Iyan ay may katuturan. Taga-Jinyeowon siya
Dialogue: 0,0:30:54.05,0:30:56.05,pangkalahatang teksto,,0,0,0,,Ito ay maaaring isang seryosong sandata
Dialogue: 0,0:31:18.74,0:31:20.32,pangkalahatang teksto,,0,0,0,,Kumusta, Deputy
Dialogue: 0,0:31:25.75,0:31:27.33,italics,,0,0,0,,Head of Sosnovy Bor
Dialogue: 0,0:31:27.41,0:31:30.54,pangkalahatang teksto,,0,0,0,,ibinalik upang personal na obserbahan ang cremation
Dialogue: 0,0:31:31.21,0:31:33.34,pangkalahatang teksto,,0,0,0,,Ano ang ginagawa mo sa oras na ito?
Dialogue: 0,0:31:33.42,0:31:36.17,general text,,0,0,0,,Pumunta ako para tingnan lang
Dialogue: 0,0:31:37.13,0:31:40.09,general text,,0,0,0,,Gayunpaman, nakita ko si Master Kahn sa huling pagkakataon
Dialogue: 0,0:31:40.18,0:31:42.60,pangkalahatang teksto,,0,0,0,,Obligado akong isagawa ito
Dialogue: 0,0:32:15.42,0:32:18.47,memories italics,,0,0,0,,Nakita mo na ba ang nomad,
Dialogue: 0,0:32:18.55,0:32:20.47,mga alaala,,0,0,0,,para makilala mo ang asul na marka
Dialogue: 0,0:32:21.39,0:32:24.76,mga alaala,,0,0,0,,Tingnan kung may marka si Master Kan sa kanyang katawan
Dialogue: 0,0:32:24.85,0:32:27.10,mga alaala,,0,0,0,,Kahit na ihayag natin ang alchemy ng mga kaluluwa,
Dialogue: 0,0:32:27.18,0:32:29.35,mga alaala,,0,0,0,,hindi namin alam kung kaninong katawan siya nilipatan
Dialogue: 0,0:32:30.73,0:32:34.69,mga alaala,,0,0,0,,Kailangan mong gumawa ng isang bagay upang makatulong na malaman ito
Dialogue: 0,0:33:06.31,0:33:09.73,memories,,0,0,0,,Alam kong kabisado mo na ang Chisa
Dialogue: 0,0:33:10.85,0:33:12.85,mga alaala,,0,0,0,,Hindi ko sinasadyang nanahimik tungkol dito
Dialogue: 0,0:33:12.94,0:33:14.35,memories,,0,0,0,,Hindi kita pinapagalitan
Dialogue: 0,0:33:15.27,0:33:16.98,mga alaala,,0,0,0,,Ang hinihiling kong gawin mo,
Dialogue: 0,0:33:17.07,0:33:19.61,mga alaala,,0,0,0,,napakadelikado at maaaring mag-alis sa iyo ng enerhiya
Dialogue: 0,0:33:20.40,0:33:22.74,mga alaala,,0,0,0,,Pero ang mga nagmamay-ari ng Chisu lang ang makakagawa nito
Dialogue: 0,0:33:23.82,0:33:26.95,memories italics,,0,0,0,,Ang nomad ay nagiging soul swallower kapag nawalan siya ng lakas
Dialogue: 0,0:33:27.70,0:33:30.12,memories italics,,0,0,0,,Mainit pa rin ang kanyang katawan
Dialogue: 0,0:33:30.87,0:33:33.17,mga alaala na italics,,0,0,0,,Ibuhos ang iyong lakas dito,
Dialogue: 0,0:33:33.75,0:33:36.34,memories italics,,0,0,0,,para maging wild siya
Dialogue: 0,0:34:03.53,0:34:05.20,pangkalahatang teksto,,0,0,0,,Mr...
Dialogue: 0,0:34:08.78,0:34:10.12,pangkalahatang teksto,,0,0,0,,Ano ito?
Dialogue: 0,0:34:10.20,0:34:12.83,pangkalahatang teksto,,0,0,0,,Siya...
Dialogue: 0,0:34:27.14,0:34:29.72,pangkalahatang teksto,,0,0,0,,Kukunin ko ang mga buto, tumalikod ang lahat
Dialogue: 0,0:34:32.81,0:34:35.73,pangkalahatang teksto,,0,0,0,,Ito ay isang lagalag,
Dialogue: 0,0:34:35.81,0:34:38.98,pangkalahatang teksto,,0,0,0,,na naging bato
Dialogue: 0,0:34:41.65,0:34:45.03,pangkalahatang teksto,,0,0,0,,Walang nagdududa na may kinalaman ang magic dito
Dialogue: 0,0:34:46.41,0:34:48.66,pangkalahatang teksto,,0,0,0,,Maaari bang makialam si Sosnovy Bor ngayon?
Dialogue: 0,0:34:56.12,0:35:00.54,general text,,0,0,0,,Hindi ka nagalit, sinubukan mo pang itago
Dialogue: 0,0:35:01.13,0:35:03.59,pangkalahatang teksto,,0,0,0,,Kaya alam mo ang tungkol dito
Dialogue: 0,0:35:05.92,0:35:06.97,italics,,0,0,0,,Alam mo,
Dialogue: 0,0:35:07.63,0:35:12.51,pangkalahatang teksto,,0,0,0,,na ito ay isang lagalag na naging ligaw
Dialogue: 0,0:35:36.25,0:35:38.04,pangkalahatang teksto,,0,0,0,,Ang iyong mga kasanayan ay nagpapahiwatig na
Dialogue: 0,0:35:38.12,0:35:41.25,pangkalahatang teksto,,0,0,0,,na ang kaluluwa ni Master Kan ay nasa katawan na ito
Dialogue: 0,0:35:42.92,0:35:44.80,pangkalahatang teksto,,0,0,0,,Kaya ang kanyang kaluluwa
Dialogue: 0,0:35:44.88,0:35:46.97,pangkalahatang teksto,,0,0,0,,namatay sa iyong katawan
Dialogue: 0,0:35:47.05,0:35:48.76,pangkalahatang teksto,,0,0,0,,Kalokohan!
Dialogue: 0,0:36:08.24,0:36:09.45,pangkalahatang teksto,,0,0,0,,Nagiging ligaw ka,
Dialogue: 0,0:36:10.03,0:36:11.99,pangkalahatang teksto,,0,0,0,,walang dugo at enerhiya
Dialogue: 0,0:36:15.24,0:36:18.50,pangkalahatang teksto,,0,0,0,,Kung mas maraming enerhiya ang iyong ginagamit, mas mabilis kang nagiging bato
Dialogue: 0,0:36:19.12,0:36:20.42,pangkalahatang teksto,,0,0,0,,Stop
Dialogue: 0,0:36:26.88,0:36:29.09,general text,,0,0,0,,You better not move!
Dialogue: 0,0:36:35.35,0:36:37.35,general text,,0,0,0,,- Huwag mo siyang patayin\N- Patayin mo siya
Dialogue: 0,0:38:22.87,0:38:25.21,pangkalahatang teksto,,0,0,0,,Delikado ang isang ligaw na lagalag
Dialogue: 0,0:38:25.71,0:38:27.50,pangkalahatang teksto,,0,0,0,,Sa kabutihang palad, nakipag-ayos sa kanya si Jeonbugwan
Dialogue: 0,0:38:28.08,0:38:29.59,general text,,0,0,0,,Tinulungan mo kami,
Dialogue: 0,0:38:29.67,0:38:32.92,pangkalahatang teksto,,0,0,0,,upang makuha mo ang ilan sa kaluwalhatian
Dialogue: 0,0:38:37.01,0:38:39.01,pangkalahatang teksto,,0,0,0,,Mr.
Dialogue: 0,0:38:49.06,0:38:51.57,pangkalahatang teksto,,0,0,0,,Dahil tayo ay bahagi ng kaluwalhatian,
Dialogue: 0,0:38:51.65,0:38:53.69,pangkalahatang teksto,,0,0,0,,kunin natin ang katawan at pag-aaralan ito
Dialogue: 0,0:38:56.15,0:38:57.57,pangkalahatang teksto,,0,0,0,,Pakiusap
Dialogue: 0,0:39:10.92,0:39:12.59,general text,,0,0,0,,sinara ko ang gate niya,
Dialogue: 0,0:39:12.67,0:39:15.38,pangkalahatang teksto,,0,0,0,,para hindi tumagas ang enerhiya
Dialogue: 0,0:39:16.13,0:39:18.22,general text,,0,0,0,,Buhayin mo siya para tanungin siya
Dialogue: 0,0:39:19.22,0:39:20.55,pangkalahatang teksto,,0,0,0,,Posible ba ito?
Dialogue: 0,0:39:21.60,0:39:25.48,pangkalahatang teksto,,0,0,0,,Isaalang-alang ito na isang batong humihinga. Gusto mo siyang kausapin?
Dialogue: 0,0:39:25.56,0:39:27.02,pangkalahatang teksto,,0,0,0,,Hindi ito magiging madali
Dialogue: 0,0:39:35.36,0:39:38.45,general text,,0,0,0,,Natatakot ka ba na baka buhay pa siya?
Dialogue: 0,0:39:40.87,0:39:42.66,pangkalahatang teksto,,0,0,0,,Gayunpaman, hindi sila magtatagumpay
Dialogue: 0,0:39:43.58,0:39:46.16,pangkalahatang teksto,,0,0,0,,Posible ito sa isang batong yelo
Dialogue: 0,0:39:46.66,0:39:48.25,pangkalahatang teksto,,0,0,0,,Ngunit wala sila nito
Dialogue: 0,0:39:48.92,0:39:52.04,pangkalahatang teksto,,0,0,0,,Kaya maaari itong buhayin gamit ang isang bato?
Dialogue: 0,0:39:52.13,0:39:53.13,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:39:54.13,0:39:56.67,pangkalahatang teksto,,0,0,0,,At mayroon kang batong ito?
Dialogue: 0,0:39:57.80,0:39:59.26,pangkalahatang teksto,,0,0,0,,Hindi mo kailangang malaman
Dialogue: 0,0:40:00.64,0:40:02.47,pangkalahatang teksto,,0,0,0,,Ihanda ang mga mersenaryo
Dialogue: 0,0:40:03.22,0:40:04.76,general text,,0,0,0,,Hahanap ako ng paraan,
Dialogue: 0,0:40:04.85,0:40:07.39,pangkalahatang teksto,,0,0,0,,kahit kailangan mong ilipat ang kaluluwa sa katawan ng salamangkero na si Jeonjingak
Dialogue: 0,0:40:14.48,0:40:16.69,pangkalahatang teksto,,0,0,0,,- Hoy, Bom\N- Ano?
Dialogue: 0,0:40:16.78,0:40:17.74,pangkalahatang text,,0,0,0,,Tara na
Dialogue: 0,0:40:26.12,0:40:27.37,mga inskripsiyon,,0,0,0,,Hyonggon Art
Dialogue: 0,0:40:27.45,0:40:29.04,mga inskripsiyon,,0,0,0,,Leopard head press stance
Dialogue: 0,0:40:29.12,0:40:30.96,mga inskripsiyon,,0,0,0,,Direktang paninindigan sa pag-atake
Dialogue: 0,0:42:04.30,0:42:05.47,pangkalahatang teksto,,0,0,0,,Yul
Dialogue: 0,0:42:07.22,0:42:08.64,pangkalahatang teksto,,0,0,0,,UK
Dialogue: 0,0:42:09.60,0:42:10.97,general text,,0,0,0,,Pupunta ka ba sa training?
Dialogue: 0,0:42:12.14,0:42:13.10,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:42:13.89,0:42:14.81,pangkalahatang teksto,,0,0,0,,At ikaw?
Dialogue: 0,0:42:20.86,0:42:22.19,general text,,0,0,0,,At lumaban ako
Dialogue: 0,0:42:24.15,0:42:25.49,pangkalahatang teksto,,0,0,0,,na may nomad
Dialogue: 0,0:42:29.41,0:42:32.54,pangkalahatang teksto,,0,0,0,,Ang namatay na master na si Kan ay isang nomad
Dialogue: 0,0:42:34.04,0:42:35.37,general text,,0,0,0,,Talaga?
Dialogue: 0,0:42:35.46,0:42:37.29,pangkalahatang teksto,,0,0,0,,Paano mo nalaman?
Dialogue: 0,0:42:38.63,0:42:40.30,pangkalahatang teksto,,0,0,0,,Kung itatago mo ang asul na marka,
Dialogue: 0,0:42:40.38,0:42:42.55,pangkalahatang teksto,,0,0,0,,walang paraan upang makilala sila mula sa ibang tao
Dialogue: 0,0:42:43.47,0:42:45.22,pangkalahatang teksto,,0,0,0,,Ngunit kapag sila ay naging ligaw,
Dialogue: 0,0:42:46.43,0:42:47.93,pangkalahatang teksto,,0,0,0,,walang babalikan
Dialogue: 0,0:42:54.73,0:42:57.56,pangkalahatang teksto,,0,0,0,,Nawawalan ng enerhiya, nagiging bato sila
Dialogue: 0,0:42:58.44,0:43:01.48,pangkalahatang teksto,,0,0,0,,At makakabawi ka lamang sa pamamagitan ng pagsipsip ng enerhiya ng ibang tao
Dialogue: 0,0:43:02.98,0:43:04.49,pangkalahatang teksto,,0,0,0,,Natapos ito minsan,
Dialogue: 0,0:43:06.61,0:43:08.57,pangkalahatang teksto,,0,0,0,, nagiging halimaw sila
Dialogue: 0,0:43:11.79,0:43:12.95,pangkalahatang teksto,,0,0,0,,Mga Halimaw?
Dialogue: 0,0:43:28.01,0:43:30.39,pangkalahatang teksto,,0,0,0,,At ang aming gawain ay protektahan ang mundo
Dialogue: 0,0:43:34.52,0:43:36.10,pangkalahatang teksto,,0,0,0,,mula sa kanila
Dialogue: 0,0:43:44.78,0:43:47.36,pangkalahatang teksto,,0,0,0,,Maaari nating protektahan ang mga halimaw na ito mula sa mundo
Dialogue: 0,0:43:49.28,0:43:50.91,pangkalahatang teksto,,0,0,0,,Babantayan namin ito,
Dialogue: 0,0:43:51.74,0:43:53.62,pangkalahatang teksto,,0,0,0,,at magkakaroon ng kapayapaan sa mundo
Dialogue: 0,0:43:54.83,0:43:57.50,pangkalahatang teksto,,0,0,0,,Mataas ang pag-asa sa iyo ng lahat mula pagkabata,
Dialogue: 0,0:43:57.58,0:44:00.54,pangkalahatang teksto,,0,0,0,,kaya sa tingin mo ay dapat kang gumawa ng isang bagay na kapaki-pakinabang
Dialogue: 0,0:44:00.63,0:44:01.96,general text,,0,0,0,,Well, sinabi nila sa akin,
Dialogue: 0,0:44:03.21,0:44:05.26,pangkalahatang text,,0,0,0,,kaya hindi ko inilabas ang aking ulo
Dialogue: 0,0:44:07.72,0:44:08.93,pangkalahatang teksto,,0,0,0,,I
Dialogue: 0,0:44:10.47,0:44:12.26,pangkalahatang teksto,,0,0,0,,sundin ang aking puso
Dialogue: 0,0:44:38.83,0:44:42.13,pangkalahatang teksto,,0,0,0,,Hinayaan ni Jin Mu na isara ang Pine Forest
Dialogue: 0,0:44:42.21,0:44:44.92,general text,,0,0,0,,Paano kung maghinala sila sa palasyo?
Dialogue: 0,0:44:45.67,0:44:46.96,pangkalahatang teksto,,0,0,0,,Palasyo...
Dialogue: 0,0:44:47.96,0:44:52.43,pangkalahatang text,,0,0,0,,hindi isang lugar kung saan pwede lang pasukin ni Park Jin, tulad ng sa Daegantonggun
Dialogue: 0,0:44:52.51,0:44:55.56,general text,,0,0,0,,Ngunit kung siya ay lumitaw, ako ay nasa panganib
Dialogue: 0,0:44:56.14,0:44:57.97,pangkalahatang teksto,,0,0,0,,Mula nang mamatay si Kil Ju
Dialogue: 0,0:44:58.06,0:44:59.85,general text,,0,0,0,,Hindi ako kumain ng energy
Dialogue: 0,0:45:01.64,0:45:04.27,pangkalahatang text,,0,0,0,,natatakot akong magwala
Dialogue: 0,0:45:07.65,0:45:10.11,pangkalahatang teksto,,0,0,0,,Maaari mong ibahagi sa akin
Dialogue: 0,0:45:11.03,0:45:12.61,pangkalahatang teksto,,0,0,0,,sa pamamagitan ng kapangyarihan ng isang batong yelo?
Dialogue: 0,0:45:13.95,0:45:14.95,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:45:15.03,0:45:18.45,pangkalahatang teksto,,0,0,0,,Ang tanging makapaglingkod sa iyo, na nakakaalam ng iyong tunay na mukha,
Dialogue: 0,0:45:22.67,0:45:24.33,general text,,0,0,0,,ako ito, hindi ka ba sumasang-ayon?
Dialogue: 0,0:45:25.54,0:45:26.75,pangkalahatang teksto,,0,0,0,,Shaman
Dialogue: 0,0:45:28.00,0:45:29.63,pangkalahatang text,,0,0,0,,Bastard...
Dialogue: 0,0:45:29.71,0:45:32.22,general text,,0,0,0,,Sabi ko wag mo akong haharapin ng ganyan
Dialogue: 0,0:45:34.26,0:45:36.51,pangkalahatang teksto,,0,0,0,,Gusto mo bang maging bato sa lalong madaling panahon?
Dialogue: 0,0:45:39.10,0:45:40.31,general text,,0,0,0,,Alam kong hindi mo kaya
Dialogue: 0,0:45:41.98,0:45:44.52,general text,,0,0,0,,Ako lang sa palasyo ang nakakaalam,
Dialogue: 0,0:45:44.60,0:45:47.52,general text,,0,0,0,,na ikaw ang shaman Choi,
Dialogue: 0,0:45:47.61,0:45:50.65,pangkalahatang teksto,,0,0,0,,lumipat sa katawan ng reyna
Dialogue: 0,0:45:52.07,0:45:53.53,pangkalahatang teksto,,0,0,0,,Kung mamatay ako,
Dialogue: 0,0:45:53.61,0:45:57.83,general text,,0,0,0,,pwede mo bang ilipat ang kapatid mo mula kay Jinyeowon dito?
Dialogue: 0,0:46:02.16,0:46:03.37,pangkalahatang teksto,,0,0,0,,Bukod dito,
Dialogue: 0,0:46:04.12,0:46:09.09,pangkalahatang teksto,,0,0,0,,isang tunay na reyna sa iyong katawan
Dialogue: 0,0:46:11.13,0:46:15.39,general text,,0,0,0,,Itigil ko na ba ang pagbisita sa kanya?
Dialogue: 0,0:46:15.97,0:46:17.01,pangkalahatang teksto,,0,0,0,,Huh?
Dialogue: 0,0:46:21.56,0:46:23.69,pangkalahatang text,,0,0,0,,Nagiging mahirap para sa akin
Dialogue: 0,0:46:24.73,0:46:26.65,pangkalahatang teksto,,0,0,0,,nabubuhay sa katawan na ito
Dialogue: 0,0:46:28.65,0:46:30.86,pangkalahatang teksto,,0,0,0,,Sabihin kay Jin Mu
Dialogue: 0,0:46:30.94,0:46:34.78,pangkalahatang teksto,,0,0,0,,ilipat ang aking kaluluwa sa ibang katawan
Dialogue: 0,0:46:36.49,0:46:37.74,pangkalahatang teksto,,0,0,0,,Kamahalan
Dialogue: 0,0:46:41.16,0:46:42.41,pangkalahatang teksto,,0,0,0,,Okay
Dialogue: 0,0:46:43.50,0:46:44.87,pangkalahatang teksto,,0,0,0,,Maaari kang pumunta
Dialogue: 0,0:47:10.94,0:47:12.23,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:47:13.19,0:47:15.40,general text,,0,0,0,,Pagbibigyan kita at matatapos ang lahat
Dialogue: 0,0:47:20.32,0:47:22.16,pangkalahatang teksto,,0,0,0,,suko na ako
Dialogue: 0,0:47:22.74,0:47:24.04,pangkalahatang teksto,,0,0,0,,Hey, Uk... Uk!
Dialogue: 0,0:47:31.29,0:47:32.84,general text,,0,0,0,,Gusto mong umalis bago ako
Dialogue: 0,0:47:32.92,0:47:34.17,general text,,0,0,0,,At nanalo ka
Dialogue: 0,0:47:41.18,0:47:43.60,pangkalahatang teksto,,0,0,0,,Gustong hayaan ka ni Dan Gu na manalo
Dialogue: 0,0:47:43.68,0:47:45.06,general text,,0,0,0,,Paano ka tatanggi?
Dialogue: 0,0:47:45.14,0:47:47.52,general text,,0,0,0,,Hindi ko alam na proud ka pala sa sarili mo
Dialogue: 0,0:47:47.60,0:47:50.52,general text,,0,0,0,,Hoy, ginawa mo ito para tumanggi ako
Dialogue: 0,0:47:50.61,0:47:51.69,general text,,0,0,0,,Kailan ito?
Dialogue: 0,0:47:51.77,0:47:53.61,pangkalahatang teksto,,0,0,0,,Ito ay isang hitsura ng kaginhawaan
Dialogue: 0,0:47:53.69,0:47:55.44,pangkalahatang teksto,,0,0,0,,Dapat naipakita
Dialogue: 0,0:47:56.11,0:47:57.03,pangkalahatang teksto,,0,0,0,,Gaya nito
Dialogue: 0,0:47:57.11,0:47:58.40,pangkalahatang teksto,,0,0,0,,Ginawa ko iyon
Dialogue: 0,0:47:59.49,0:48:02.78,pangkalahatang teksto,,0,0,0,,At paano ito mauunawaan? Kung naiintindihan ko, papayag ako
Dialogue: 0,0:48:04.33,0:48:05.91,pangkalahatang teksto,,0,0,0,,Isang laban ang natitira
Dialogue: 0,0:48:06.62,0:48:07.87,general text,,0,0,0,,Ano ang gagawin mo?
Dialogue: 0,0:48:07.96,0:48:09.46,general text,,0,0,0,,Teka, sinisisi mo ba ako?
Dialogue: 0,0:48:10.04,0:48:12.67,general text,,0,0,0,,Ikaw mismo ang nagbigay sa kanya ng jade, at galit ka sa akin?
Dialogue: 0,0:48:12.75,0:48:15.30,general text,,0,0,0,,Ginagalaw mo na ba ang mga arrow?
Dialogue: 0,0:48:15.38,0:48:16.84,pangkalahatang teksto,,0,0,0,,Napakabata
Dialogue: 0,0:48:16.92,0:48:19.43,pangkalahatang teksto,,0,0,0,,Bata? Ipakita ang tunay na pag-uugali ng bata?
Dialogue: 0,0:48:19.51,0:48:20.47,general text,,0,0,0,,Ibinibigay ko ang lahat
Dialogue: 0,0:48:21.59,0:48:22.60,pangkalahatang teksto,,0,0,0,,Dapat ba akong kumilos nang ganito?
Dialogue: 0,0:48:32.69,0:48:35.48,general text,,0,0,0,,Binabantayan ni Mages si Saejukwon simula kagabi
Dialogue: 0,0:48:36.57,0:48:39.49,pangkalahatang teksto,,0,0,0,,Tiyak na nandoon ang katawan ng lumulunok ng kaluluwa
Dialogue: 0,0:48:39.57,0:48:42.32,general text,,0,0,0,,Kung siya ay namatay, ang bangkay ay dadalhin sa secret room
Dialogue: 0,0:48:42.82,0:48:45.54,pangkalahatang teksto,,0,0,0,,Bakit siya inilagay sa Sejukwon, na para sa buhay?
Dialogue: 0,0:48:54.59,0:48:58.05,general text,,0,0,0,,Pumunta ako para alamin kung ano ang nangyari sa katawan
Dialogue: 0,0:48:58.13,0:49:00.38,pangkalahatang text,,0,0,0,,Teka. Ipaalam ko sa ulo
Dialogue: 0,0:49:17.07,0:49:20.49,general text,,0,0,0,,Narinig kong nasa Saejukwon ang ulo, kaya pumunta ako sa kanya.
Dialogue: 0,0:49:20.57,0:49:23.07,pangkalahatang teksto,,0,0,0,,Wala pang pinapayagang pumasok sa Sejukwon
Dialogue: 0,0:49:23.16,0:49:25.45,general text,,0,0,0,,Tapos makikipagkita muna ako kay Mr.
Dialogue: 0,0:49:25.53,0:49:27.62,pangkalahatang text,,0,0,0,,Sabihin sa ulo na nandito ako
Dialogue: 0,0:49:29.20,0:49:30.45,general text,,0,0,0,,Dumating na si Jin Mu
Dialogue: 0,0:49:31.83,0:49:34.83,general text,,0,0,0,,check kung namatay ba talaga ang souleater
Dialogue: 0,0:49:35.96,0:49:38.34,general text,,0,0,0,,Sabihin mo akong umalis habang nag-iimbestiga pa tayo
Dialogue: 0,0:49:38.42,0:49:41.51,pangkalahatang teksto,,0,0,0,,Oo. May ibang dumating para makita ka
Dialogue: 0,0:49:42.34,0:49:43.47,general text,,0,0,0,,Hayaan mo siya
Dialogue: 0,0:49:43.55,0:49:46.14,pangkalahatang teksto,,0,0,0,,Huwag papasukin ang sinuman sa Saejukwon
Dialogue: 0,0:49:46.22,0:49:47.18,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,0:49:47.26,0:49:49.72,general text,,0,0,0,,Sasabihin ko sa maid Kim na umalis
Dialogue: 0,0:49:51.02,0:49:52.14,pangkalahatang teksto,,0,0,0,,Ano?
Dialogue: 0,0:49:53.23,0:49:54.40,general text,,0,0,0,,Maiden Kim?
Dialogue: 0,0:49:54.48,0:49:57.36,general text,,0,0,0,,Sasabihin ko sa kanya na hindi kayang tanggapin ng ulo ang sinuman
Dialogue: 0,0:50:00.28,0:50:01.49,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:50:02.78,0:50:06.20,pangkalahatang teksto,,0,0,0,,Maaari niya bilang isang exception
Dialogue: 0,0:50:15.88,0:50:18.25,general text,,0,0,0,,Long time no see, maid Kim
Dialogue: 0,0:50:37.56,0:50:40.98,pangkalahatang teksto,,0,0,0,,Tumira ako sa bahay ni Gwangju Chang Gan nang pagsilbihan ko siya,
Dialogue: 0,0:50:41.65,0:50:44.61,pangkalahatang teksto,,0,0,0,,at nagluto ka ng masarap na pagkain
Dialogue: 0,0:50:45.74,0:50:47.20,pangkalahatang teksto,,0,0,0,,Ang dami mong kinain,
Dialogue: 0,0:50:47.70,0:50:51.12,pangkalahatang teksto,,0,0,0,,na ang iyong rice bowl ang pinakamalaki
Dialogue: 0,0:50:52.25,0:50:53.37,general text,,0,0,0,,Naaalala mo ba?
Dialogue: 0,0:50:53.45,0:50:56.62,pangkalahatang teksto,,0,0,0,,Mayroon kang napakalaking mangkok
Dialogue: 0,0:50:56.71,0:50:59.67,general text,,0,0,0,,lagi akong nagugutom noon
Dialogue: 0,0:51:00.59,0:51:04.17,general text,,0,0,0,,Malamang masarap ulit ang niluto mo
Dialogue: 0,0:51:04.76,0:51:07.89,pangkalahatang teksto,,0,0,0,,Oo. Ako mismo ang naghanda sa kanila
Dialogue: 0,0:51:12.06,0:51:15.64,pangkalahatang text,,0,0,0,,Honey cookies. Mahal na mahal ko sila noon pa
Dialogue: 0,0:51:15.73,0:51:16.94,pangkalahatang teksto,,0,0,0,,Iyon lang
Dialogue: 0,0:51:17.02,0:51:20.02,pangkalahatang teksto,,0,0,0,,Hiniling ko sa iyo na iparating ang Gwangju,
Dialogue: 0,0:51:20.11,0:51:23.15,pangkalahatang text,,0,0,0,,at naglagay ka ng pares sa iyong mga bulsa
Dialogue: 0,0:51:24.36,0:51:28.03,general text,,0,0,0,,Kasi nakakakain lang ako\N kapag natapos na siya.
Dialogue: 0,0:51:28.86,0:51:32.99,pangkalahatang teksto,,0,0,0,,Sa anumang kaso, malaki ang nakuha ko sa pagsunod kay Gwangju
Dialogue: 0,0:51:33.08,0:51:35.12,pangkalahatang teksto,,0,0,0,, kumain ng masarap,
Dialogue: 0,0:51:36.08,0:51:38.54,pangkalahatang teksto,,0,0,0,,nagturo ng mga espesyal na spelling
Dialogue: 0,0:51:43.71,0:51:47.13,general text,,0,0,0,,Mas masarap sila kapag kumain ka ng patago, di ba?
Dialogue: 0,0:51:53.93,0:51:55.14,pangkalahatang teksto,,0,0,0,,Samakatuwid
Dialogue: 0,0:51:56.10,0:51:58.56,pangkalahatang teksto,,0,0,0,,sweet ay palaging napakadelikado
Dialogue: 0,0:51:58.64,0:52:02.65,pangkalahatang teksto,,0,0,0,,Kapag sinubukan mo ito, hindi ka maaaring tumigil
Dialogue: 0,0:52:06.03,0:52:07.61,pangkalahatang teksto,,0,0,0,,Hindi mo pinagkaiba,
Dialogue: 0,0:52:09.16,0:52:10.74,pangkalahatang teksto,,0,0,0,,kung ano ang maaari mong kainin,
Dialogue: 0,0:52:12.45,0:52:14.16,pangkalahatang teksto,,0,0,0,,at kung ano-ano pa
Dialogue: 0,0:52:16.25,0:52:19.00,general text,,0,0,0,,Nasaktan mo ako sa hindi pagpayag na subukan ko
Dialogue: 0,0:52:21.00,0:52:24.55,pangkalahatang teksto,,0,0,0,,Huwag masyadong gahaman
Dialogue: 0,0:52:28.76,0:52:32.05,general text,,0,0,0,,Gwangju really loved these cookies
Dialogue: 0,0:52:32.14,0:52:34.01,general text,,0,0,0,,At ang kanyang anak?
Dialogue: 0,0:52:34.10,0:52:37.14,general text,,0,0,0,,Mahal din sila ng young master
Dialogue: 0,0:52:37.22,0:52:39.69,general text,,0,0,0,,Kung gayon kailangan mong ibahagi ito sa kanya
Dialogue: 0,0:52:40.85,0:52:45.15,general text,,0,0,0,,Marami akong masasabi sa kanya tungkol sa tatay ko
Dialogue: 0,0:52:52.74,0:52:56.04,general text,,0,0,0,,You and Uk have nothing to talk about
Dialogue: 0,0:52:56.12,0:52:57.83,pangkalahatang text,,0,0,0,,Maaari kang pumunta
Dialogue: 0,0:52:57.91,0:53:00.75,general text,,0,0,0,,Gusto lang niya ng cookies. Ano bang problema mo?
Dialogue: 0,0:53:01.46,0:53:04.63,general text,,0,0,0,,Huwag mo akong hayaang magbahagi ng mga alaala sa kanya
Dialogue: 0,0:53:04.71,0:53:05.67,pangkalahatang teksto,,0,0,0,,Dapat,
Dialogue: 0,0:53:07.46,0:53:09.92,general text,,0,0,0,,muli, ayaw mong hawakan ko ang sa iyo
Dialogue: 0,0:53:12.76,0:53:13.89,pangkalahatang teksto,,0,0,0,,Maghintay
Dialogue: 0,0:53:14.76,0:53:17.97,pangkalahatang teksto,,0,0,0,,Para ito sa ginoo,
Dialogue: 0,0:53:18.06,0:53:19.60,pangkalahatang teksto,,0,0,0,,ngunit maaari mong kunin
Dialogue: 0,0:53:20.14,0:53:21.23,pangkalahatang teksto,,0,0,0,,Maiden Kim
Dialogue: 0,0:53:22.14,0:53:23.35,pangkalahatang text,,0,0,0,,Huwag mo siyang bigyan
Dialogue: 0,0:53:24.27,0:53:26.32,general text,,0,0,0,,Kung gusto ko talaga,
Dialogue: 0,0:53:26.86,0:53:29.32,general text,,0,0,0,,Nagnakaw na sana ako ng mag-asawa
Dialogue: 0,0:53:29.99,0:53:32.20,general text,,0,0,0,,Pero hahayaan kitang manalo
Dialogue: 0,0:53:34.66,0:53:38.91,general text,,0,0,0,,Matagal na tayong hindi nagkita. Sayang ang paalam
Dialogue: 0,0:53:47.80,0:53:49.05,pangkalahatang teksto,,0,0,0,,Naghiganti si Jin Mu,
Dialogue: 0,0:53:49.13,0:53:52.01,general text,,0,0,0,,kung siya ay napagalitan dahil sa pagkain
Dialogue: 0,0:53:52.68,0:53:54.26,general text,,0,0,0,,Cookies lang
Dialogue: 0,0:53:54.34,0:53:55.97,general text,,0,0,0,,Dapat binigyan siya ng kaunti
Dialogue: 0,0:53:56.05,0:53:58.14,general text,,0,0,0,,Ayoko lang siyang kumain niyan,
Dialogue: 0,0:53:59.52,0:54:03.31,pangkalahatang teksto,,0,0,0,,kung ano ang nahirapan mong ihanda
Dialogue: 0,0:54:05.15,0:54:06.27,pangkalahatang teksto,,0,0,0,,Umupo
Dialogue: 0,0:54:06.36,0:54:08.48,general text,,0,0,0,,Matagal na tayong hindi nagkita
Dialogue: 0,0:54:08.57,0:54:11.99,pangkalahatang teksto,,0,0,0,,Pag-usapan natin ang isang tasa ng tsaa
Dialogue: 0,0:54:15.61,0:54:17.32,pangkalahatang teksto,,0,0,0,,May mali ba?
Dialogue: 0,0:54:18.16,0:54:19.70,general text,,0,0,0,,Mukhang pagod ka
Dialogue: 0,0:54:23.71,0:54:25.00,pangkalahatang text,,0,0,0,,Huwag mag-alala
Dialogue: 0,0:54:26.17,0:54:30.46,general text,,0,0,0,,Kakainin ko ang cookies mo at agad akong natauhan
Dialogue: 0,0:54:40.43,0:54:41.72,italics,,0,0,0,,Moo Dok
Dialogue: 0,0:54:42.89,0:54:44.52,pangkalahatang text,,0,0,0,,may utos ako
Dialogue: 0,0:54:44.60,0:54:46.56,pangkalahatang teksto,,0,0,0,,Order? alin?
Dialogue: 0,0:54:46.65,0:54:47.86,pangkalahatang teksto,,0,0,0,,Pumunta kay Jeonbugwan
Dialogue: 0,0:54:49.06,0:54:52.36,general text,,0,0,0,,Mali pa rin ito. Ipasa ito
Dialogue: 0,0:54:53.69,0:54:54.95,pangkalahatang teksto,,0,0,0,,Siyempre
Dialogue: 0,0:54:59.70,0:55:01.62,general text,,0,0,0,,May nangyari ba sa Sejukwon?
Dialogue: 0,0:55:02.70,0:55:05.21,general text,,0,0,0,,Hindi ko alam lahat
Dialogue: 0,0:55:05.29,0:55:08.79,general text,,0,0,0,,Pero parang konektado ito sa nangyari kay Degantongun
Dialogue: 0,0:55:09.59,0:55:11.75,general text,,0,0,0,,Nabalitaan kong nag-aaway sina Jeonbugwan at Sosnovy Bor
Dialogue: 0,0:55:17.22,0:55:18.09,general text,,0,0,0,,Nasaan si Yul?
Dialogue: 0,0:55:18.18,0:55:19.89,general text,,0,0,0,,Hindi ko na siya nakita simula kagabi
Dialogue: 0,0:55:19.97,0:55:21.89,pangkalahatang teksto,,0,0,0,,Isinasagawa ang mga tagubilin mula sa ulo, malamang
Dialogue: 0,0:55:23.14,0:55:24.27,pangkalahatang teksto,,0,0,0,,Oo?
Dialogue: 0,0:55:25.85,0:55:27.14,memories italics,,0,0,0,,At lumaban ako
Dialogue: 0,0:55:29.27,0:55:30.69,mga alaala,,0,0,0,,na may isang lagalag
Dialogue: 0,0:55:43.29,0:55:45.45,pangkalahatang teksto,,0,0,0,,Dapat nating palakasin ang mga hangganan
Dialogue: 0,0:55:45.54,0:55:48.37,pangkalahatang teksto,,0,0,0,,Bawal kang umalis sa Sosnovy Bor
Dialogue: 0,0:55:50.29,0:55:52.04,italics,,0,0,0,,Yaong mga nagmamay-ari ng Ryusu at higit pa,
Dialogue: 0,0:55:52.13,0:55:55.55,pangkalahatang text,,0,0,0,,pumunta sa Saejukwon at sundin ang utos ni Sang Ho
Dialogue: 0,0:55:55.63,0:55:56.76,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:55:57.63,0:55:58.55,italics,,0,0,0,,Chang Wook
Dialogue: 0,0:55:59.89,0:56:00.89,pangkalahatang text,,0,0,0,,Manatili ka
Dialogue: 0,0:56:02.30,0:56:04.01,pangkalahatang teksto,,0,0,0,,Lahat maliban kay Chan Wook,
Dialogue: 0,0:56:04.10,0:56:06.89,pangkalahatang teksto,,0,0,0,,sundan si Sang Ho hanggang Saejukwon
Dialogue: 0,0:56:06.98,0:56:08.27,pangkalahatang teksto,,0,0,0,,- Oo\N- Oo
Dialogue: 0,0:56:13.82,0:56:14.98,pangkalahatang teksto,,0,0,0,,Kabanata
Dialogue: 0,0:56:15.86,0:56:17.78,general text,,0,0,0,,Bakit hindi ako pupunta?
Dialogue: 0,0:56:17.86,0:56:20.66,general text,,0,0,0,,Hindi mo ito kailangan dahil hindi ka kailangan doon
Dialogue: 0,0:56:21.91,0:56:23.78,general text,,0,0,0,,May delikado ba doon?
Dialogue: 0,0:56:24.83,0:56:26.20,general text,,0,0,0,,May nomad ba doon?
Dialogue: 0,0:56:26.79,0:56:28.87,pangkalahatang teksto,,0,0,0,,Wala kang pakialam
Dialogue: 0,0:56:29.62,0:56:31.04,pangkalahatang teksto,,0,0,0,,Huwag maging interesado
Dialogue: 0,0:56:31.13,0:56:33.92,general text,,0,0,0,,Bakit mo itinatago sa akin ang lahat? Isa rin akong magician dito
Dialogue: 0,0:56:34.00,0:56:37.34,pangkalahatang teksto,,0,0,0,,Ikaw ay exception sa lahat ng mga patakaran
Dialogue: 0,0:56:37.92,0:56:40.72,general text,,0,0,0,,Kung naiinip ka, maaari kang umalis sa Sosnovy Bor
Dialogue: 0,0:56:40.80,0:56:44.18,pangkalahatang teksto,,0,0,0,,Umuwi ka at gawin ang gusto mo
Dialogue: 0,0:56:46.85,0:56:50.35,pangkalahatang teksto,,0,0,0,,Oo. Salamat sa pag-aalala
Dialogue: 0,0:57:08.45,0:57:09.62,pangkalahatang teksto,,0,0,0,,Moo Dok
Dialogue: 0,0:57:10.79,0:57:13.00,general text,,0,0,0,,Punta tayo sa Chwisonra at kumain ng masarap
Dialogue: 0,0:57:14.63,0:57:18.09,pangkalahatang teksto,,0,0,0,,Lahat ng mga magician sa Sejukwon. bakit ayaw mo?
Dialogue: 0,0:57:19.67,0:57:21.13,general text,,0,0,0,,Sinabihan akong huwag makialam
Dialogue: 0,0:57:21.22,0:57:24.22,pangkalahatang teksto,,0,0,0,,at hindi ko ito inaalala
Dialogue: 0,0:57:24.80,0:57:27.43,general text,,0,0,0,,- Let's go\N- Binigyan ako ni Maid Kim ng task
Dialogue: 0,0:57:28.14,0:57:30.60,pangkalahatang text,,0,0,0,,Okay. Sabay na tayo. Saan ako dapat pumunta?
Dialogue: 0,0:57:31.44,0:57:32.56,pangkalahatang teksto,,0,0,0,,Jeonbugwan
Dialogue: 0,0:57:34.31,0:57:35.23,general text,,0,0,0,,Tara na
Dialogue: 0,0:57:39.99,0:57:44.66,general text,,0,0,0,,Narinig kong sinabi mo sa kanya na gusto mo ng ibang katawan
Dialogue: 0,0:57:46.78,0:57:48.12,general text,,0,0,0,,Ibibigay mo ba sa akin?
Dialogue: 0,0:57:48.91,0:57:53.17,general text,,0,0,0,,Tapos gusto ko ang katawan ng babaeng makakasama ni Jinyoung bilang Boo Young
Dialogue: 0,0:57:55.54,0:57:57.25,pangkalahatang teksto,,0,0,0,,Na nasa katawan ng isang bating,
Dialogue: 0,0:57:58.00,0:57:59.71,general text,,0,0,0,,I wouldn't mind being in a woman's body
Dialogue: 0,0:58:00.51,0:58:05.43,pangkalahatang teksto,,0,0,0,,Gusto ko ng malakas na katawan, tulad ng shaman's
Dialogue: 0,0:58:07.10,0:58:08.35,pangkalahatang teksto,,0,0,0,,"Shaman"?
Dialogue: 0,0:58:09.60,0:58:11.93,pangkalahatang text,,0,0,0,,Nagalit siya na pinaalala mo sa kanya
Dialogue: 0,0:58:12.02,0:58:15.15,pangkalahatang teksto,,0,0,0,,na siya ay isang shaman, isang manghuhula
Dialogue: 0,0:58:15.77,0:58:17.36,general text,,0,0,0,,Hindi ako nagsinungaling
Dialogue: 0,0:58:19.82,0:58:24.49,general text,,0,0,0,,Naalala ko rin kung paano ako humingi ng pagkain at nagnakaw ng matamis.
Dialogue: 0,0:58:26.16,0:58:30.20,pangkalahatang teksto,,0,0,0,,Ito ay hindi isang kasinungalingan, ngunit hindi ako natuwa na marinig ang isang bagay na ganoon
Dialogue: 0,0:58:40.05,0:58:43.22,pangkalahatang text,,0,0,0,,Gustong kumain ni Jin Mu ng cookies,
Dialogue: 0,0:58:43.30,0:58:45.09,general text,,0,0,0,,pero hindi siya pinayagan ni Park Jin
Dialogue: 0,0:58:45.72,0:58:47.72,general text,,0,0,0,,Nag-alala ang dalagang Kim na baka masaktan si Ji Moo,
Dialogue: 0,0:58:47.80,0:58:49.76,general text,,0,0,0,,kaya hiniling ko na ibigay mo ito sa kanya
Dialogue: 0,0:58:49.85,0:58:52.81,general text,,0,0,0,,So, parang mga bata silang nagtatalo sa pagkain?
Dialogue: 0,0:58:52.89,0:58:55.64,pangkalahatang teksto,,0,0,0,,Ang kabanata ay minsan napakaliit
Dialogue: 0,0:58:55.73,0:58:58.56,general text,,0,0,0,,Nagtatalo tungkol sa honey cookies?!
Dialogue: 0,0:58:58.65,0:59:00.94,pangkalahatang teksto,,0,0,0,,Tama ka, ito ay maliit
Dialogue: 0,0:59:08.07,0:59:09.62,mga alaala na italics,,0,0,0,,Dito sa Jeonbugwan
Dialogue: 0,0:59:09.70,0:59:12.49,mga alaala na italics,,0,0,0,,isinulat namin ang lahat ng mga bituin
Dialogue: 0,0:59:35.73,0:59:39.19,general text,,0,0,0,,Sasabihin ko sa deputy na galing ito sa pamilya Chan
Dialogue: 0,0:59:39.98,0:59:43.61,general text,,0,0,0,,Sabihin mo sa kanya na galing ito sa maid na si Kim
Dialogue: 0,0:59:44.90,0:59:47.24,pangkalahatang teksto,,0,0,0,,At mayroon din silang maraming langis
Dialogue: 0,0:59:47.32,0:59:49.62,pangkalahatang teksto,,0,0,0,,at dapat hugasan ng berdeng tsaa
Dialogue: 0,0:59:49.70,0:59:50.78,pangkalahatang teksto,,0,0,0,,Oo, sir
Dialogue: 0,0:59:50.87,0:59:53.49,pangkalahatang teksto,,0,0,0,,At doon, siyempre, ay honey
Dialogue: 0,0:59:53.58,0:59:55.87,pangkalahatang teksto,,0,0,0,,Dapat silang itago sa lamig, kung hindi ay magkakadikit sila
Dialogue: 0,0:59:55.95,0:59:58.37,general text,,0,0,0,,- Yes, sir\N- At dahil dinala namin sila,
Dialogue: 0,0:59:58.46,1:00:00.42,general text,,0,0,0,,- pwede ba akong pumasok?\N- Oo...
Dialogue: 0,1:00:00.50,1:00:02.92,general text,,0,0,0,,- Ano?\N- Salamat. Hindi tayo magtatagal
Dialogue: 0,1:00:03.00,1:00:03.92,general text,,0,0,0,,Let's go
Dialogue: 0,1:00:05.59,1:00:06.55,pangkalahatang teksto,,0,0,0,,Pero...
Dialogue: 0,1:00:14.39,1:00:16.31,pangkalahatang text,,0,0,0,,Gusto ko laging bumisita dito
Dialogue: 0,1:00:16.39,1:00:19.85,general text,,0,0,0,,Kahit na ang tatay ko ay si Gwangju, hindi ako pinayagan dito
Dialogue: 0,1:00:24.36,1:00:26.65,general text,,0,0,0,,Hoy, ano ito?
Dialogue: 0,1:00:28.45,1:00:31.03,general text,,0,0,0,,Nandito ka diba?
Dialogue: 0,1:00:31.12,1:00:33.24,pangkalahatang teksto,,0,0,0,,Ang tatay mo ay isang astrologo dito
Dialogue: 0,1:00:34.41,1:00:36.33,general text,,0,0,0,,Pumunta ka ba dito para sa akin?
Dialogue: 0,1:00:38.96,1:00:42.04,pangkalahatang text,,0,0,0,,Maaari mong hilingin sa isang tao na maghatid ng cookies
Dialogue: 0,1:00:42.71,1:00:45.75,general text,,0,0,0,,Pero kusa akong dumating dahil gusto ko, tama ba ako?
Dialogue: 0,1:00:50.43,1:00:53.47,general text,,0,0,0,,Bata pa ako madalas dinala ng tatay ko dito
Dialogue: 0,1:00:54.60,1:00:58.02,pangkalahatang teksto,,0,0,0,,Nagpakita pa sa akin ng recording ng araw na ipinanganak ako
Dialogue: 0,1:00:59.48,1:01:01.10,pangkalahatang teksto,,0,0,0,,Siya ay isang mabuting ama
Dialogue: 0,1:01:04.61,1:01:06.15,pangkalahatang teksto,,0,0,0,,Kung iisipin mo,
Dialogue: 0,1:01:06.23,1:01:09.32,general text,,0,0,0,,siguradong may recording din dito mula sa birthday mo
Dialogue: 0,1:01:11.70,1:01:13.20,pangkalahatang teksto,,0,0,0,,Sa tingin mo?
Dialogue: 0,1:01:14.53,1:01:18.04,pangkalahatang teksto,,0,0,0,,Kaya, ang recording mula sa araw na iyon ay dapat na narito sa isang lugar
Dialogue: 0,1:01:31.38,1:01:33.93,general text,,0,0,0,,Nangako ka sa akin ng bagong katawan
Dialogue: 0,1:01:34.47,1:01:37.10,pangkalahatang teksto,,0,0,0,,Ngunit sa halip ay naging bato ka
Dialogue: 0,1:01:37.76,1:01:39.18,pangkalahatang teksto,,0,0,0,,Hindi ka na kailangan
Dialogue: 0,1:01:39.85,1:01:42.27,general text,,0,0,0,,At magiging bato ka na lang
Dialogue: 0,1:01:57.99,1:01:59.29,pangkalahatang text,,0,0,0,,Bastard...
Dialogue: 0,1:02:18.22,1:02:20.47,pangkalahatang teksto,,0,0,0,,Pagdating ng gabi, darating ang mga mago
Dialogue: 0,1:02:21.10,1:02:22.64,general text,,0,0,0,,Tingnan natin kung paano sila gumagawa ng mga tala?
Dialogue: 0,1:02:22.73,1:02:24.81,pangkalahatang teksto,,0,0,0,,Sabi nila ito ay isang kamangha-manghang tanawin
Dialogue: 0,1:02:27.02,1:02:30.73,general text,,0,0,0,,Maganda sana, pero magkakaroon ng mga problema kung mahuli tayo
Dialogue: 0,1:02:30.82,1:02:31.94,general text,,0,0,0,,Uwi na tayo
Dialogue: 0,1:02:45.58,1:02:47.25,pangkalahatang text,,0,0,0,,Naging wild si Eunuch Kim
Dialogue: 0,1:02:47.33,1:02:49.71,pangkalahatang teksto,,0,0,0,,Walang dapat makaalam na siya ay isang lagalag
Dialogue: 0,1:02:50.30,1:02:53.72,general text,,0,0,0,,Nasa Jeonbugwan pa siya. Kailangan natin siyang mahanap bago mag madaling araw
Dialogue: 0,1:02:53.80,1:02:54.97,pangkalahatang teksto,,0,0,0,,Oo
Dialogue: 0,1:03:38.39,1:03:39.85,general text,,0,0,0,,Alam kong nandito ka
Dialogue: 0,1:03:40.39,1:03:42.68,pangkalahatang teksto,,0,0,0,,Hindi na kailangang lumikha ng mga problema, lumabas
Dialogue: 0,1:03:42.76,1:03:44.31,pangkalahatang text,,0,0,0,,ibibigay ko ang gusto mo
Dialogue: 0,1:03:52.40,1:03:53.65,pangkalahatang teksto,,0,0,0,,Lumabas
Dialogue: 0,1:03:55.94,1:03:57.86,general text,,0,0,0,,- Now!\N- Aalis na ako
Dialogue: 0,1:04:02.91,1:04:04.87,pangkalahatang text,,0,0,0,,- Chan Wook\N- Oo
Dialogue: 0,1:04:10.42,1:04:12.04,general text,,0,0,0,,Bakit ka nandito?
Dialogue: 0,1:04:12.54,1:04:14.21,pangkalahatang text,,0,0,0,,Paumanhin. May pasok ako
Dialogue: 0,1:04:14.30,1:04:15.84,general text,,0,0,0,,Well, gusto kong manood
Dialogue: 0,1:04:20.14,1:04:21.30,pangkalahatang teksto,,0,0,0,,Order?
Dialogue: 0,1:04:21.93,1:04:25.52,general text,,0,0,0,,Narinig ko gusto mo ng honey cookies
Dialogue: 0,1:04:26.68,1:04:28.06,pangkalahatang text,,0,0,0,,Cookies?
Dialogue: 0,1:04:28.14,1:04:30.19,pangkalahatang text,,0,0,0,,Napansin ni Servant Kim na nabalisa ka,
Dialogue: 0,1:04:30.27,1:04:32.02,pangkalahatang text,,0,0,0,,at hiniling sa akin na bigyan ka
Dialogue: 0,1:04:34.65,1:04:37.07,pangkalahatang teksto,,0,0,0,,Salamat. Sabihin mo sa kanya na nagpapasalamat ako
Dialogue: 0,1:04:37.82,1:04:38.95,italics,,0,0,0,,Ano?
Dialogue: 0,1:04:40.36,1:04:43.28,general text,,0,0,0,,Akala ko magagalit ka na pumasok ako ng walang pahintulot
Dialogue: 0,1:04:44.03,1:04:44.91,general text,,0,0,0,,Hindi ka ba galit?
Dialogue: 0,1:04:44.99,1:04:48.29,general text,,0,0,0,,Pumunta ka para bigyan ako ng cookies. Maaari kang pumunta
Dialogue: 0,1:04:49.58,1:04:51.58,pangkalahatang teksto,,0,0,0,,Mabuti. To be honest...
Dialogue: 0,1:04:53.13,1:04:54.13,pangkalahatang teksto,,0,0,0,,Hindi ako nag-iisa
Dialogue: 0,1:04:55.55,1:04:57.42,general text,,0,0,0,,Moo Dok, lumabas ka. Hindi siya galit
Dialogue: 0,1:04:58.55,1:05:00.47,general text,,0,0,0,,Ito ang aking kasambahay
Dialogue: 0,1:05:02.01,1:05:03.80,pangkalahatang teksto,,0,0,0,,Ako si Moo Dok,
Dialogue: 0,1:05:03.89,1:05:05.43,pangkalahatang text,,0,0,0,,kanyang kasambahay
Dialogue: 0,1:05:07.97,1:05:09.52,general text,,0,0,0,,Nandito ka rin
Dialogue: 0,1:05:10.23,1:05:12.23,general text,,0,0,0,,Akala ko magagalit ka
Dialogue: 0,1:05:12.31,1:05:15.44,pangkalahatang teksto,,0,0,0,,Salamat sa iyong mabuting pakikitungo
Dialogue: 0,1:05:15.52,1:05:16.82,pangkalahatang text,,0,0,0,,Kumain ng cookies
Dialogue: 0,1:05:16.90,1:05:19.24,general text,,0,0,0,,Kung gusto mo pa, sabihin mo lang
Dialogue: 0,1:05:21.99,1:05:23.24,pangkalahatang teksto,,0,0,0,,Salamat
Dialogue: 0,1:05:23.32,1:05:24.45,general text,,0,0,0,,Let's go
Dialogue: 0,1:05:39.63,1:05:42.84,mga alaala,,0,0,0,,Ito ang royal eunuch
Dialogue: 0,1:05:43.89,1:05:45.30,memories italics,,0,0,0,,Ano ang problema niya?
Dialogue: 0,1:05:46.56,1:05:47.97,mga alaala,,0,0,0,,Siya ay isang lagalag
Dialogue: 0,1:05:48.85,1:05:51.44,mga alaala,,0,0,0,,Tingnan mo. Naging wild siya
Dialogue: 0,1:05:59.40,1:06:01.82,memories italics,,0,0,0,,Hindi ako makapaniwala na nasa palasyo ang nomad
Dialogue: 0,1:06:01.90,1:06:02.95,mga alaala,,0,0,0,,Marahil
Dialogue: 0,1:06:03.82,1:06:05.12,mga alaala,,0,0,0,,ginagawa niya ito
Dialogue: 0,1:06:08.45,1:06:09.83,memories italics,,0,0,0,,Alam kong nandito ka
Dialogue: 0,1:06:10.33,1:06:12.71,mga alaala,,0,0,0,,Hindi na kailangang gumawa ng mga problema, lumabas ka
Dialogue: 0,1:06:12.79,1:06:14.54,mga alaala,,0,0,0,,ibibigay ko ang gusto mo
Dialogue: 0,1:06:21.34,1:06:22.76,mga alaala na italics,,0,0,0,,Lumabas ka!
Dialogue: 0,1:06:31.35,1:06:32.60,mga alaala,,0,0,0,,Aalis na ako
Dialogue: 0,1:06:58.50,1:06:59.71,pangkalahatang text,,0,0,0,,Run
Dialogue: 0,1:07:02.84,1:07:04.09,general text,,0,0,0,,Sa likod namin ay isa pang pinto
Dialogue: 0,1:07:17.10,1:07:18.73,general text,,0,0,0,,Bakit ayaw mo kaming paalisin?
Dialogue: 0,1:07:19.73,1:07:23.82,pangkalahatang teksto,,0,0,0,,Hindi tama na bitawan ang isang salamangkero na madaling nakarating dito
Dialogue: 0,1:07:23.90,1:07:26.07,general text,,0,0,0,,Magkakaroon ka ng mga problema,
Dialogue: 0,1:07:27.07,1:07:28.53,general text,,0,0,0,,kung mawala ako sa Jeonbugwan
Dialogue: 0,1:07:28.62,1:07:30.08,general text,,0,0,0,,At hindi kita sasaktan
Dialogue: 0,1:07:31.24,1:07:33.45,pangkalahatang teksto,,0,0,0,,Magiging ligtas ang iyong katawan
Dialogue: 0,1:07:42.96,1:07:43.96,pangkalahatang teksto,,0,0,0,,Chan Uk...
Dialogue: 0,1:08:46.61,1:08:48.90,italics,,0,0,0,,Nasa loob ka ng harang na nilikha ko
Dialogue: 0,1:08:53.49,1:08:54.62,italics,,0,0,0,,Huwag mag-alala
Dialogue: 0,1:08:55.49,1:08:57.62,general text,,0,0,0,,Tumayo ka at hindi ka masasaktan
Dialogue: 0,1:08:59.25,1:09:01.17,pangkalahatang text,,0,0,0,,Maghintay dito
Dialogue: 0,1:09:14.72,1:09:16.22,general text,,0,0,0,,Mu Dok ang pangalan mo?
Dialogue: 0,1:09:17.89,1:09:19.85,pangkalahatang text,,0,0,0,,Yung kasambahay,
Dialogue: 0,1:09:19.93,1:09:24.15,pangkalahatang teksto,,0,0,0,,na laging kasama niya at kung saan siya palaging nasa problema
Dialogue: 0,1:09:27.40,1:09:29.40,general text,,0,0,0,,May tao dito
Dialogue: 0,1:09:29.94,1:09:32.07,pangkalahatang teksto,,0,0,0,,Lumabas at ibalik ang iyong enerhiya
Dialogue: 0,1:09:43.75,1:09:45.21,pangkalahatang teksto,,0,0,0,,At pagkatapos
Dialogue: 0,1:09:45.79,1:09:49.71,general text,,0,0,0,,Ililipat kita sa katawan ng young master, ayon sa gusto mo
Dialogue: 0,1:10:03.69,1:10:05.23,general text,,0,0,0,,Itong bruhang... shaman Choi
Dialogue: 0,1:10:06.69,1:10:08.82,general text,,0,0,0,,papatayin daw ako?
Dialogue: 0,1:10:09.86,1:10:11.82,pangkalahatang teksto,,0,0,0,,Kailangan ko ang iyong tulong
Dialogue: 0,1:10:12.57,1:10:15.45,general text,,0,0,0,,Kung hindi ka naniniwala sa akin, aalis ako
Dialogue: 0,1:10:17.37,1:10:19.58,pangkalahatang text,,0,0,0,,Pwede kang magmeryenda kasama siya
Dialogue: 0,1:11:11.25,1:11:12.84,general text,,0,0,0,,Kailangan na nating umalis dito
Dialogue: 0,1:12:07.77,1:12:10.69,general text,,0,0,0,,Teacher, tulungan mo ulit ako
Dialogue: 0,1:12:11.44,1:12:13.82,pangkalahatang teksto,,0,0,0,,Bigyan ng tiwala ang iyong estudyante
Dialogue: 0,1:12:25.33,1:12:26.50,pangkalahatang text,,0,0,0,,Chan Wook
Dialogue: 0,1:13:06.62,1:13:07.66,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,1:13:10.21,1:13:11.37,pangkalahatang teksto,,0,0,0,,Moo Dok!
Dialogue: 0,1:13:44.24,1:13:45.37,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,1:14:13.77,1:14:14.98,pangkalahatang teksto,,0,0,0,,Mu Dok...
Dialogue: 0,1:14:18.27,1:14:19.44,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,1:14:21.74,1:14:23.70,general text,,0,0,0,,naubos lang ang energy niya
Dialogue: 0,1:14:30.91,1:14:32.12,pangkalahatang teksto,,0,0,0,,I...
Dialogue: 0,1:14:33.75,1:14:35.29,general text,,0,0,0,,running wild?
Dialogue: 0,1:14:49.64,1:14:51.56,general text,,0,0,0,,- Mu Dok..\N- Huwag kang lalapit
Dialogue: 0,1:15:04.95,1:15:06.49,pangkalahatang teksto,,0,0,0,,Hindi. Maayos ang lahat
Dialogue: 0,1:15:07.24,1:15:08.62,general text,,0,0,0,,Okay ka lang
Dialogue: 0,1:15:10.37,1:15:12.20,pangkalahatang text,,0,0,0,,- At magiging maayos ka\N- Hindi
Dialogue: 0,1:15:13.20,1:15:14.25,pangkalahatang text,,0,0,0,,Huwag mo akong hawakan
Dialogue: 0,1:15:16.33,1:15:17.96,pangkalahatang teksto,,0,0,0,,Kung ako ay mag-wild,
Dialogue: 0,1:15:20.17,1:15:22.01,general text,,0,0,0,,wag mo akong hawakan
Dialogue: 0,1:15:25.51,1:15:27.22,pangkalahatang teksto,,0,0,0,,Kung hindi, uubusin ko rin ang iyong lakas
Dialogue: 0,1:15:28.09,1:15:29.22,general text,,0,0,0,,at mamamatay ka
Dialogue: 0,1:17:10.36,1:17:12.53,preview,,0,0,0,,May ingay na nagmumula sa recording room
Dialogue: 0,1:17:12.62,1:17:13.99,preview,,0,0,0,,Lumabas!
Dialogue: 0,1:17:14.08,1:17:17.04,preview,,0,0,0,,Galit ka ba na ginawa naming bato ang kaibigan mo?
Dialogue: 0,1:17:17.12,1:17:19.87,preview,,0,0,0,,Hindi ka aalis sa lugar na ito
Dialogue: 0,1:17:19.96,1:17:23.00,preview,,0,0,0,,So, miyembro ito ng pamilya Cho?
Dialogue: 0,1:17:23.08,1:17:26.92,preview,,0,0,0,,At kung ang espiritu niya ay kumapit kay Uka, ano?
Dialogue: 0,1:17:27.00,1:17:30.93,preview,,0,0,0,,Kung hindi kita iniwan sa kabundukan,
Dialogue: 0,1:17:31.01,1:17:32.93,preview,,0,0,0,,hindi ito mangyayari sa iyo
Dialogue: 0,1:17:33.01,1:17:34.43,preview,,0,0,0,,Inilalagay mo ba ang iyong buhay sa linya?
Dialogue: 0,1:17:34.51,1:17:36.51,preview,,0,0,0,,Alok ang iyong sarili bilang kapalit sa oras na ito
Dialogue: 0,1:17:36.60,1:17:38.22,preview,,0,0,0,, mananalo talaga ako bukas
Dialogue: 0,1:17:38.31,1:17:40.39,preview,,0,0,0,,Kailangan ko ng siguradong mananalo
Dialogue: 0,1:17:40.48,1:17:43.06,preview,,0,0,0,,Kung naghahanap siya ng bato para protektahan siya...
Dialogue: 0,1:17:43.15,1:17:44.15,preview,,0,0,0,,Hindi sila pwedeng magkasama
Dialogue: 0,1:17:44.23,1:17:46.69,preview,,0,0,0,,Lahat ng tungkol sa iyo ay lumabas
Dialogue: 0,0:02:55.14,0:02:57.14,nicks,,0,0,0,,

