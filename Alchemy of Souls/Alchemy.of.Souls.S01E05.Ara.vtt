Dialogue: 0,0:02:47.44,0:02:49.44,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:49.44,0:02:51.44,النيكات,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:51.44,0:02:53.44,الألقاب,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، تومو
Dialogue: 0,0:00:59.10,0:01:03.35,ذكريات,,0,0,0,,هنا في جيونبوغوان نسجل كل النجوم
Dialogue: 0,0:01:03.43,0:01:06.69,ذكريات,,0,0,0,,هناك واحدة ظهرت في عيد ميلادك. هل تريد أن ترى؟
Dialogue: 0,0:01:06.77,0:01:08.44,ذكريات,,0,0,0,,نعم يا أبي
Dialogue: 0,0:01:09.31,0:01:10.86,ذكريات,,0,0,0,,حسنًا، لنذهب
Dialogue: 0,0:01:23.41,0:01:24.66,ذكريات,,0,0,0,,هنا
Dialogue: 0,0:01:28.79,0:01:31.21,التعليق الصوتي,,0,0,0,,درس والدي النجوم وسجل ملاحظات عنها
Dialogue: 0,0:01:32.21,0:01:34.67,خلف الكواليس,,0,0,0,,لأنه كان ساحراً يقرأ الأبراج
Dialogue: 0,0:01:47.98,0:01:48.98,ذكريات,,0,0,0,,سيدتي!
Dialogue: 0,0:01:49.06,0:01:50.23,ذكريات,,0,0,0,,سيدتي!
Dialogue: 0,0:02:00.24,0:02:02.45,ذكريات,,0,0,0,,ابق هنا ولا تغادر
Dialogue: 0,0:02:04.29,0:02:06.62,ذكريات,,0,0,0,,عندما ترى والدك اركض
Dialogue: 0,0:02:07.12,0:02:08.54,ذكريات,,0,0,0,,لا تدعه يمسك بك
Dialogue: 0,0:02:33.15,0:02:34.48,ذكريات,,0,0,0,,أبي...
Dialogue: 0,0:03:31.42,0:03:33.33,ذكريات,,0,0,0,,سأعطيك القوة
Dialogue: 0,0:03:34.17,0:03:35.54,ذكريات,,0,0,0,,هل ستأتي معي؟
Dialogue: 0,0:03:44.80,0:03:47.51,التعليق الصوتي,,0,0,0,,اليوم الذي قُتل فيه والدي على يد عائلات دايهو الأربع،
Dialogue: 0,0:03:48.18,0:03:50.06,خارج الشاشة,,0,0,0,,لقد تابعت جين مو
Dialogue: 0,0:03:51.39,0:03:53.94,خلف الكواليس,,0,0,0,,لقد نشأت معزولاً تماماً عن العالم
Dialogue: 0,0:03:54.02,0:03:56.82,خلف الكواليس,,0,0,0,,في وديان Danhyanggok العميقة والخطيرة
Dialogue: 0,0:04:28.06,0:04:30.56,خلف الكواليس,,0,0,0,,لا أعلم، لقد نجوت لأنني قوي،
Dialogue: 0,0:04:30.64,0:04:32.85,خلف الكواليس,,0,0,0,,أو قوية لأنها نجت
Dialogue: 0,0:04:37.06,0:04:40.48,التعليق الصوتي,,0,0,0,,عندما نسي ماضي وأبي،
Dialogue: 0,0:04:41.44,0:04:43.65,التعليق الصوتي,,0,0,0,,لقد عدت أخيرًا بدور ناكسو
Dialogue: 0,0:04:48.95,0:04:50.83,خارج الشاشة,,0,0,0,,لكن ناكسو مات
Dialogue: 0,0:04:51.54,0:04:54.75,التعليق الصوتي,,0,0,0,,لقد عدت إلى هنا بشخصية مو ديوك
Dialogue: 0,0:04:55.75,0:04:58.17,خلف الكواليس,,0,0,0,,مع مالك عاجز،
Dialogue: 0,0:04:58.92,0:05:02.38,خلف الكواليس,,0,0,0,,وهو في نفس الوقت تلميذي غير المهتم
Dialogue: 0,0:05:02.46,0:05:04.80,نص عام,,0,0,0,,كم من الوقت يتعين علينا أن نذهب؟
Dialogue: 0,0:05:04.88,0:05:06.18,نص عام,,0,0,0,,يزن هذا السوار طنًا
Dialogue: 0,0:05:06.26,0:05:08.30,نص عام,,0,0,0,,يا معلم، تلميذك متعب
Dialogue: 0,0:05:08.39,0:05:11.01,نص عام,,0,0,0,,لقد اكتفيت. لا أستطيع الذهاب بعد الآن
Dialogue: 0,0:05:11.10,0:05:13.18,نص عام,,0,0,0,,أنا أحمل كل الأشياء!
Dialogue: 0,0:05:13.27,0:05:15.89,النص العام,,0,0,0,,أنا السيد وأنت خادمي
Dialogue: 0,0:05:15.98,0:05:17.23,نص عام,,0,0,0,,هذا هو عملك
Dialogue: 0,0:05:17.31,0:05:19.23,نص عام,,0,0,0,,عند الضرورة أنا معلمك،
Dialogue: 0,0:05:19.77,0:05:21.53,نص عام,,0,0,0,,والخادمة متى تريدين ذلك؟
Dialogue: 0,0:05:21.61,0:05:22.65,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:05:27.07,0:05:28.28,نص عام,,0,0,0,,لم أكن أعرف،
Dialogue: 0,0:05:28.95,0:05:31.28,نص عام,,0,0,0,,أن هناك مثل هذا المكان خارج المدينة
Dialogue: 0,0:05:31.37,0:05:35.08,general text,,0,0,0,,هذا المكان قاسٍ لدرجة أنك لا تستطيع حتى سماع صدى هنا
Dialogue: 0,0:05:36.21,0:05:37.50,نص عام,,0,0,0,,ومن هنا جاء الاسم دانهيانجوك
Dialogue: 0,0:05:42.84,0:05:44.13,نص عام,,0,0,0,,وأسمع صدى
Dialogue: 0,0:05:44.21,0:05:45.51,نص عام,,0,0,0,,إنه مجرد كلام مجازي!
Dialogue: 0,0:05:45.59,0:05:47.01,نص عام,,0,0,0,,العنوان غبي
Dialogue: 0,0:05:48.55,0:05:49.55,نص عام,,0,0,0,,أريد أن آكل
Dialogue: 0,0:05:51.51,0:05:53.56,نص عام,,0,0,0,,عشت هناك
Dialogue: 0,0:05:53.64,0:05:55.85,نص عام,,0,0,0,,سوف تأكل ما أحمله معك
Dialogue: 0,0:05:55.93,0:05:59.48,النص العام,,0,0,0,,والنوم حيث تغفو بعد يوم شاق
Dialogue: 0,0:06:02.77,0:06:04.19,نص عام,,0,0,0,,ما هذا؟ رائحة مثل الدجاج
Dialogue: 0,0:06:06.07,0:06:08.78,general text,,0,0,0,,- هل يبيعون الدجاج هنا؟\N- من سيبيع الدجاج هنا؟
Dialogue: 0,0:06:11.62,0:06:13.79,نص عام,,0,0,0,,أنت تشعر بذلك أيضًا، أليس كذلك؟
Dialogue: 0,0:06:13.87,0:06:15.54,نص عام,,0,0,0,,أنا أقول لك، إنه دجاج
Dialogue: 0,0:06:16.12,0:06:18.83,نص عام,,0,0,0,,أنا متأكد. أنا أحب الدجاج
Dialogue: 0,0:06:19.62,0:06:21.21,نص عام,,0,0,0,,كيف وصلت إلى هناك؟
Dialogue: 0,0:06:22.21,0:06:24.00,النص العام,,0,0,0,,هناك من يقلي الدجاج في مكان قريب
Dialogue: 0,0:06:24.09,0:06:25.76,نص عام,,0,0,0,,انزل. لماذا ذهبت إلى هناك؟
Dialogue: 0,0:06:34.97,0:06:36.10,مائل,,0,0,0,,أرأيت؟ دجاج
Dialogue: 0,0:06:36.18,0:06:39.23,نص عام,,0,0,0,,لقد أخبرتك أن رائحتها تشبهها. كم هو رائع هنا
Dialogue: 0,0:06:58.79,0:07:00.67,نص عام,,0,0,0,,لماذا كل هذا هنا؟
Dialogue: 0,0:07:02.79,0:07:03.63,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:07:04.67,0:07:06.59,نص عام,,0,0,0,,حتى أن هناك حوض استحمام هنا
Dialogue: 0,0:07:16.06,0:07:16.97,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:07:17.56,0:07:21.23,نص عام,,0,0,0,,هناك جبل من الطعام وحتى مكان للسباحة
Dialogue: 0,0:07:21.31,0:07:23.48,نص عام,,0,0,0,,يا معلم، كان لديك منزل جيد
Dialogue: 0,0:07:23.56,0:07:25.82,general text,,0,0,0,,هل كان من الضروري حقاً إخافة الطالب بهذه الطريقة؟
Dialogue: 0,0:07:25.90,0:07:26.73,نص عام,,0,0,0,,غريب جداً...
Dialogue: 0,0:07:29.07,0:07:30.49,نص عام,,0,0,0,,وهناك بطانية
Dialogue: 0,0:07:32.49,0:07:35.03,نص عام,,0,0,0,,بعبارة ملطفة. لطيف ومريح
Dialogue: 0,0:07:35.91,0:07:37.33,نص عام,,0,0,0,,هذا ليس لي
Dialogue: 0,0:07:38.79,0:07:40.66,نص عام,,0,0,0,,شخص يعيش هنا
Dialogue: 0,0:07:45.96,0:07:47.17,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:07:47.25,0:07:50.63,نص عام,,0,0,0,,هل نأكل الدجاج؟ إنها مستعدة جيدًا بالفعل
Dialogue: 0,0:07:50.72,0:07:51.88,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:07:57.64,0:07:59.06,النص العام,,0,0,0,,هل هذا رجل؟
Dialogue: 0,0:08:20.66,0:08:21.96,نص عام,,0,0,0,,هيا، توقف!
Dialogue: 0,0:08:23.79,0:08:25.29,نص عام,,0,0,0,,هادئ
Dialogue: 0,0:08:37.72,0:08:38.72,نص عام,,0,0,0,,الولد الطيب
Dialogue: 0,0:08:38.81,0:08:40.64,نص عام,,0,0,0,,تدريب جيد. هل تعيش هنا؟
Dialogue: 0,0:08:41.35,0:08:42.77,نص عام,,0,0,0,,هذا ليس كلبًا ضالًا
Dialogue: 0,0:08:43.77,0:08:45.02,نص عام,,0,0,0,,أين سيدك؟
Dialogue: 0,0:08:45.85,0:08:47.81,النص العام,,0,0,0,,يا رقيق، أحضر سيدك
Dialogue: 0,0:08:50.03,0:08:52.03,نص عام,,0,0,0,,يا له من كلب ذكي
Dialogue: 0,0:08:54.15,0:08:55.70,خلف الكواليس,,0,0,0,,من هذا؟
Dialogue: 0,0:08:55.78,0:08:57.24,التعليق الصوتي,,0,0,0,,لا يمكن أن يكون هؤلاء أشخاص Dan Zhu
Dialogue: 0,0:08:57.32,0:09:00.58,خارج الشاشة,,0,0,0,,هذا لا يحاول الاختباء أو الاختباء
Dialogue: 0,0:09:03.25,0:09:04.33,خط مائل,,0,0,0,,الشاي
Dialogue: 0,0:09:04.41,0:09:07.46,general text,,0,0,0,,نحن ضيوف، لذا يمكننا تناول فنجان، أليس كذلك؟
Dialogue: 0,0:09:08.75,0:09:10.21,نص عام,,0,0,0,,انتبهوا ماذا تأكلون وتشربون
Dialogue: 0,0:09:11.00,0:09:13.05,نص عام,,0,0,0,,أولاً علينا التحقق من من يعيش هنا
Dialogue: 0,0:09:13.13,0:09:14.92,نص عام,,0,0,0,,ثم سنقرر ما يجب فعله بعد ذلك
Dialogue: 0,0:09:15.01,0:09:16.26,نص عام,,0,0,0,,إذًا أنت حقًا لا تعرف؟
Dialogue: 0,0:09:16.89,0:09:17.72,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:09:17.80,0:09:20.10,النص العام,,0,0,0,,هناك كلب، والزهور في كل مكان،
Dialogue: 0,0:09:20.18,0:09:22.10,النص العام,,0,0,0,,الدجاج والشاي يغليان
Dialogue: 0,0:09:22.18,0:09:23.48,نص عام,,0,0,0,,وكادت أن أكون مخطئاً
Dialogue: 0,0:09:24.10,0:09:24.93,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:09:25.02,0:09:28.31,general text,,0,0,0,,قررت أنك تحاول اختطافي والعيش معي،
Dialogue: 0,0:09:28.40,0:09:29.86,نص عام,,0,0,0,,الاختباء خلف التدريب
Dialogue: 0,0:09:29.94,0:09:31.73,general text,,0,0,0,,إذا هز هذا الكلب ذيله أمامك،
Dialogue: 0,0:09:31.82,0:09:34.44,نص عام,,0,0,0,,سأقرر أن هذه هي خطتك كلها
Dialogue: 0,0:09:34.53,0:09:36.65,نص عام,,0,0,0,,هناك مساحة كافية لطفلين أو ثلاثة أطفال
Dialogue: 0,0:09:37.36,0:09:39.24,نص عام,,0,0,0,,كان كل شيء مختلفًا هنا عندما كنت أعيش هنا
Dialogue: 0,0:09:39.82,0:09:41.20,نص عام,,0,0,0,,كان المكان هامداً
Dialogue: 0,0:09:41.28,0:09:43.87,نص عام,,0,0,0,,وكان مثاليًا للتدريب، ولهذا السبب أحضرتك إلى هنا
Dialogue: 0,0:09:45.46,0:09:46.75,نص عام,,0,0,0,,إذن التدريب؟
Dialogue: 0,0:09:48.08,0:09:49.46,نص عام,,0,0,0,,فقط هذا كان في أفكارك؟
Dialogue: 0,0:09:50.17,0:09:52.59,نص عام,,0,0,0,,انس الأمر! كل واشرب ما شئت، هيا
Dialogue: 0,0:09:52.67,0:09:53.80,نص عام,,0,0,0,,دعهم يقتلوك
Dialogue: 0,0:09:55.63,0:09:56.47,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:09:56.55,0:10:00.22,النص العام,,0,0,0,,لم أكن أعتقد أنها ستتفاعل بهذه الطريقة مع نكتة بسيطة
Dialogue: 0,0:10:00.30,0:10:03.47,general text,,0,0,0,,إنها غلطتي لأنني تبعتها إلى هذه البرية
Dialogue: 0,0:10:04.06,0:10:05.02,نص عام,,0,0,0,,لا توجد كلمات
Dialogue: 0,0:10:13.69,0:10:15.57,ذكريات بخط مائل,,0,0,0,,تبقى وريثاً جاهلاً
Dialogue: 0,0:10:17.07,0:10:19.78,ذكريات,,0,0,0,,عائلة تشان
Dialogue: 0,0:10:21.66,0:10:22.99,نص عام,,0,0,0,,أفضل البقاء هنا،
Dialogue: 0,0:10:24.24,0:10:25.66,نص عام,,0,0,0,,كيف سأعيش هكذا
Dialogue: 0,0:11:12.21,0:11:13.84,نص عام,,0,0,0,,اليوم هو رئيس جينيوون
Dialogue: 0,0:11:13.92,0:11:16.75,نص عام,,0,0,0,,اجتمع سحرة ديهو في المجلس الموحد
Dialogue: 0,0:11:17.30,0:11:20.76,النص العام,,0,0,0,,جميع العائلات الـ 11 موجودة باستثناء تشانغ غان
Dialogue: 0,0:11:20.84,0:11:24.76,general text,,0,0,0,,هل قتالي مع تشان ووك حدث كبير؟
Dialogue: 0,0:11:25.35,0:11:27.77,general text,,0,0,0,,هذه مبارزة بين السحرة والعائلة المالكة
Dialogue: 0,0:11:27.85,0:11:29.64,نص عام,,0,0,0,,آخرها كان منذ مئات السنين
Dialogue: 0,0:11:29.73,0:11:32.27,النص العام,,0,0,0,,أنا فقط أحاول معاقبة تشان ووك
Dialogue: 0,0:11:32.35,0:11:34.44,نص عام,,0,0,0,,لنظرتك باستخفاف لي
Dialogue: 0,0:11:34.52,0:11:35.90,نص عام,,0,0,0,,هذه ليست نتائج شخصية
Dialogue: 0,0:11:36.77,0:11:39.53,general text,,0,0,0,,أصدر جلالته الأمر واجتمع السحرة
Dialogue: 0,0:11:39.61,0:11:43.28,general text,,0,0,0,,إذا وافقوا ستجري مبارزة رسمية
Dialogue: 0,0:11:45.07,0:11:47.58,general text,,0,0,0,,ظهرت فجوة دمرت الاستقرار والسلام،
Dialogue: 0,0:11:48.45,0:11:50.87,نص عام,,0,0,0,,كان موجوداً بين القصر والسحرة
Dialogue: 0,0:12:03.97,0:12:08.14,general text,,0,0,0,,هل توافق حقًا على قرار حرمان ووك من حقوقه ليصبح غوانغجو التالي؟
Dialogue: 0,0:12:09.35,0:12:10.73,نص عام,,0,0,0,,نعم صحيح
Dialogue: 0,0:12:15.40,0:12:16.77,نص عام,,0,0,0,,مبارزة فقط
Dialogue: 0,0:12:16.86,0:12:19.40,general text,,0,0,0,,سيحل سوء التفاهم بين ولي العهد والمملكة المتحدة
Dialogue: 0,0:12:19.48,0:12:20.74,نص عام,,0,0,0,,وبخصوص غوانغجو
Dialogue: 0,0:12:21.61,0:12:26.12,النص العام,,0,0,0,,لدي بالفعل مرشح أريد ترشيحه
Dialogue: 0,0:12:26.20,0:12:28.03,general text,,0,0,0,,الهروب لا يساوي الهزيمة
Dialogue: 0,0:12:29.24,0:12:32.41,general text,,0,0,0,,سمعت أنه هرب قبل إعلان القتال
Dialogue: 0,0:12:34.62,0:12:36.00,نص عام,,0,0,0,,يا له من عار
Dialogue: 0,0:12:36.08,0:12:39.50,general text,,0,0,0,,يجب أن يقاتل بصدق ويموت بكرامة مثل الساحر.
Dialogue: 0,0:12:39.59,0:12:41.84,النص العام,,0,0,0,,تشان ووك لم يكن لديه الشجاعة للقيام بذلك
Dialogue: 0,0:12:43.26,0:12:46.18,نص عام,,0,0,0,,الجميع هنا كان معلمه
Dialogue: 0,0:12:46.26,0:12:48.89,general text,,0,0,0,,- نعم\N- لم يتميز بالموهبة أبداً
Dialogue: 0,0:12:48.97,0:12:52.48,general text,,0,0,0,,أنا ضد فضح السحرة بهذه الطريقة
Dialogue: 0,0:12:52.56,0:12:55.23,general text,,0,0,0,,ماذا لو حرمنا تشان ووك من مكانته كساحر؟
Dialogue: 0,0:12:58.52,0:13:01.99,general text,,0,0,0,,إذا حرمانه بالإجماع من هذه المكانة،
Dialogue: 0,0:13:02.07,0:13:05.32,general text,,0,0,0,,سيتعين عليك أن تأخذ كل طاقته، سيفقد قواه
Dialogue: 0,0:13:05.41,0:13:08.12,general text,,0,0,0,,هل تقترح تدمير حياة شاب بأكملها؟
Dialogue: 0,0:13:08.20,0:13:10.03,نص عام,,0,0,0,,لكن هذا سيساعد في التعامل مع القتال
Dialogue: 0,0:13:10.95,0:13:15.21,italics,,0,0,0,,على أية حال، أغلقت بوابة طاقته بسبب والده
Dialogue: 0,0:13:15.29,0:13:17.21,نص عام,,0,0,0,,- إنه على حق\N- هناك نقطة
Dialogue: 0,0:13:17.29,0:13:19.38,نص عام,,0,0,0,,كل واحد منكم
Dialogue: 0,0:13:19.46,0:13:22.59,نص عام,,0,0,0,,كان معلم أوكا
Dialogue: 0,0:13:25.72,0:13:27.34,نص عام,,0,0,0,,كيف يمكنك التحدث بهذه اللامبالاة
Dialogue: 0,0:13:27.43,0:13:30.56,نص عام,,0,0,0,,عن تدمير حياة شخص كان تلميذك ذات يوم؟
Dialogue: 0,0:13:32.47,0:13:35.69,النص العام,,0,0,0,,قبل سوسنوفي بور شروط القصر
Dialogue: 0,0:13:35.77,0:13:38.69,general text,,0,0,0,,سنتحمل على أنفسنا العار الذي قد يقع أو لا يقع
Dialogue: 0,0:13:39.27,0:13:42.86,general text,,0,0,0,,إذن فلتكن هذه مبارزة رسمية بين سوسنوفي بور والقصر
Dialogue: 0,0:13:44.69,0:13:45.53,نص عام,,0,0,0,,نعم
Dialogue: 0,0:13:46.95,0:13:49.99,general text,,0,0,0,,سمعت أن المملكة المتحدة أتقنت ريوسو في وقت قصير جدًا
Dialogue: 0,0:13:50.99,0:13:53.58,النص العام,,0,0,0,,هل علمه أحد من الغابة؟
Dialogue: 0,0:13:57.25,0:14:00.63,النص العام,,0,0,0,,لا يهم أين يذهب، ولمن،
Dialogue: 0,0:14:02.30,0:14:05.92,نص عام,,0,0,0,,ليس له معلم
Dialogue: 0,0:14:10.47,0:14:12.97,النص العام,,0,0,0,,الماء لطيف ونظيف. أصبح الجلد أكثر ليونة
Dialogue: 0,0:14:13.06,0:14:14.35,نص عام,,0,0,0,,ربما هو معدن
Dialogue: 0,0:14:15.02,0:14:18.69,general text,,0,0,0,,مو دوك صاحب المنزل شخص أنيق جدًا
Dialogue: 0,0:14:18.77,0:14:20.27,نص عام,,0,0,0,,لا أعتقد أنه سيعود...
Dialogue: 0,0:14:23.78,0:14:24.82,نص عام,,0,0,0,,تفضل
Dialogue: 0,0:14:39.37,0:14:40.88,نص عام,,0,0,0,,النوم العميق
Dialogue: 0,0:14:41.50,0:14:43.13,خط مائل,,0,0,0,,بالطبع أنت متعب
Dialogue: 0,0:14:43.21,0:14:45.84,النص العام,,0,0,0,,كان بإمكاننا أن نسير بهدوء، لكنك كنت مستعجلاً
Dialogue: 0,0:14:45.92,0:14:48.88,general text,,0,0,0,,أنت الآن مو دوك، وليس ناك سو. ليس لديك القوة الكافية
Dialogue: 0,0:14:53.85,0:14:55.22,نص عام,,0,0,0,,كيف...
Dialogue: 0,0:14:56.06,0:14:57.10,نص عام,,0,0,0,,ثقيل
Dialogue: 0,0:14:57.18,0:14:58.73,نص عام,,0,0,0,,أحمق
Dialogue: 0,0:14:58.81,0:15:01.69,النص العام,,0,0,0,,إذا كان الأمر صعبًا جدًا، فعليك طلب المساعدة
Dialogue: 0,0:15:09.57,0:15:11.03,نص عام,,0,0,0,,ناعم جدًا
Dialogue: 0,0:15:16.58,0:15:18.58,نص عام,,0,0,0,,أنا المالك،
Dialogue: 0,0:15:19.25,0:15:21.75,النص العام,,0,0,0,,وهي خادمة. هذا صحيح
Dialogue: 0,0:15:23.17,0:15:24.96,نص عام,,0,0,0,,يجب أن أنام هنا
Dialogue: 0,0:15:38.06,0:15:40.77,نص عام,,0,0,0,,بطريقةٍ ما أشعر بعدم الراحة
Dialogue: 0,0:15:50.32,0:15:51.36,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:16:04.58,0:16:05.67,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,0:16:05.75,0:16:07.17,نص عام,,0,0,0,,تصبحون على خير
Dialogue: 0,0:16:31.94,0:16:33.40,نص عام,,0,0,0,,كم هو غير مريح
Dialogue: 0,0:17:01.77,0:17:04.23,نص عام,,0,0,0,,هل تقول أن هناك بدوي بالداخل؟
Dialogue: 0,0:17:07.90,0:17:09.48,نص عام,,0,0,0,,كم هو مثير للاهتمام
Dialogue: 0,0:17:37.34,0:17:39.55,general text,,0,0,0,,لولا مساعدتك لم أكن لأتعرف عليها،
Dialogue: 0,0:17:39.64,0:17:41.22,النص العام,,0,0,0,,لأنه ليس في روحها حقد
Dialogue: 0,0:17:46.06,0:17:50.15,general text,,0,0,0,,من الأفضل لك أن تموت على يدي من أن تتوحش وتتحجر.
Dialogue: 0,0:18:18.05,0:18:20.76,خلف الكواليس,,0,0,0,,هناك روح مذهلة في هذا الجسد
Dialogue: 0,0:18:22.10,0:18:26.48,التعليق الصوتي,,0,0,0,,كان ينبغي عليها أن تصبح جامحة الآن، مع الأخذ في الاعتبار مدى ضعف هذا الجسد
Dialogue: 0,0:18:26.56,0:18:28.48,التعليق الصوتي,,0,0,0,,لماذا لا تزال بخير؟
Dialogue: 0,0:18:36.44,0:18:40.16,التعليق الصوتي,,0,0,0,,لا أشعر بأي طاقة. أين اختفت جميعها؟
Dialogue: 0,0:18:46.16,0:18:47.58,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:18:49.67,0:18:51.46,نص عام,,0,0,0,,ومن أنت؟
Dialogue: 0,0:18:51.54,0:18:53.54,النص العام,,0,0,0,,ابتعد عن مو دوك
Dialogue: 0,0:20:28.43,0:20:31.39,general text,,0,0,0,,هذا السيف أُعطي من قبل ملك غوانغجو جيونبوغوان
Dialogue: 0,0:20:31.98,0:20:33.27,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:20:34.10,0:20:36.11,general text,,0,0,0,,ماذا تفعل بجانب هذه الفتاة؟
Dialogue: 0,0:20:40.32,0:20:41.24,النص العام,,0,0,0,,مو دوك، اركض!
Dialogue: 0,0:22:08.45,0:22:10.91,نص عام,,0,0,0,,أخيرًا استيقظت
Dialogue: 0,0:22:15.50,0:22:16.54,نص عام,,0,0,0,,من هذا؟
Dialogue: 0,0:22:16.62,0:22:17.92,نص عام,,0,0,0,,رجل الأمس
Dialogue: 0,0:22:19.29,0:22:20.54,نص عام,,0,0,0,,رجل الأمس؟
Dialogue: 0,0:22:20.63,0:22:21.84,نص عام,,0,0,0,,نعم. لا تتذكر؟
Dialogue: 0,0:22:26.59,0:22:27.84,ذكريات بخط مائل,,0,0,0,,مو دوك، اركض!
Dialogue: 0,0:23:04.09,0:23:05.88,خط مائل,,0,0,0,,أنا آسف بشأن الأمس
Dialogue: 0,0:23:05.96,0:23:07.80,نص عام,,0,0,0,,رأيت أحداً في المنزل،
Dialogue: 0,0:23:07.88,0:23:10.89,general text,,0,0,0,,وسحبت فجأة سيفًا، ولم يكن لدي أي خيار آخر.
Dialogue: 0,0:23:10.97,0:23:12.30,نص عام,,0,0,0,,نعم كنت خائفة بنفسي
Dialogue: 0,0:23:12.39,0:23:14.97,النص العام,,0,0,0,,مازلت أعاني من ضعف السيطرة على الطاقة في يدي
Dialogue: 0,0:23:15.06,0:23:16.93,نص عام,,0,0,0,,لم أكن أريد أن أؤذيك
Dialogue: 0,0:23:17.02,0:23:18.14,نص عام,,0,0,0,,أنتما...
Dialogue: 0,0:23:19.06,0:23:20.02,نص عام,,0,0,0,,قاتلت؟
Dialogue: 0,0:23:23.94,0:23:26.15,نص عام,,0,0,0,,أنت حقاً لا تتذكر أي شيء؟
Dialogue: 0,0:23:27.40,0:23:28.61,نص عام,,0,0,0,,لا
Dialogue: 0,0:23:28.69,0:23:31.24,النص العام,,0,0,0,,كنت تقف هناك وتنظر إلينا
Dialogue: 0,0:23:31.32,0:23:32.57,نص عام,,0,0,0,,أنا؟
Dialogue: 0,0:23:32.66,0:23:33.53,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:23:34.16,0:23:35.91,نص عام,,0,0,0,,أعتقد أنك تمشي أثناء النوم
Dialogue: 0,0:23:35.99,0:23:39.58,النص العام,,0,0,0,,سأعطيك الأعشاب الطبية لهذا الغرض. صنع الشاي والشراب
Dialogue: 0,0:23:40.21,0:23:41.67,النص العام,,0,0,0,,هل أنت معالج؟
Dialogue: 0,0:23:41.75,0:23:43.83,النص العام,,0,0,0,,لا، لكنه هنا ليجمع بعض الأعشاب،
Dialogue: 0,0:23:43.92,0:23:45.54,نص عام,,0,0,0,,لا يمكن العثور عليه إلا هنا
Dialogue: 0,0:23:45.63,0:23:46.55,نص عام,,0,0,0,,نادني بالسيد لي
Dialogue: 0,0:23:47.13,0:23:49.30,نص عام,,0,0,0,,هناك مساحة كافية لنا،
Dialogue: 0,0:23:49.38,0:23:51.26,نص عام,,0,0,0,,اشعر وكأنك في بيتك
Dialogue: 0,0:23:54.64,0:23:56.18,نص عام,,0,0,0,,حسنًا يا سابساري
Dialogue: 0,0:23:58.47,0:23:59.85,مائل,,0,0,0,,أنت حقًا لا تتذكر؟
Dialogue: 0,0:23:59.93,0:24:01.94,مائل,,0,0,0,,هل مشيت حقًا أثناء نومي؟
Dialogue: 0,0:24:15.95,0:24:17.20,خط مائل,,0,0,0,,كنت مستلقياً على الأرض...
Dialogue: 0,0:24:17.28,0:24:19.75,نص عام,,0,0,0,,هذا البدوي مميز
Dialogue: 0,0:24:19.83,0:24:23.04,النص العام,,0,0,0,,روح خاصة في مثل هذا الجسد الضعيف
Dialogue: 0,0:24:25.33,0:24:27.29,نص عام,,0,0,0,,دعونا نتعرف عليها بشكل أفضل
Dialogue: 0,0:24:27.38,0:24:28.84,نص عام,,0,0,0,,لا تكذب
Dialogue: 0,0:24:28.92,0:24:31.51,نص عام,,0,0,0,,بجد! لقد قمت بنقلك حتى تتمكن من النوم بشكل أكثر راحة
Dialogue: 0,0:24:31.59,0:24:32.97,نص عام,,0,0,0,,ما هي علاقتك؟
Dialogue: 0,0:24:34.72,0:24:35.93,نص عام,,0,0,0,,متزوج؟
Dialogue: 0,0:24:36.01,0:24:37.22,نص عام,,0,0,0,,- No\N- No
Dialogue: 0,0:24:38.18,0:24:41.35,نص عام,,0,0,0,,لم أنم على السرير. كنت مستلقيا على الأرض
Dialogue: 0,0:24:41.43,0:24:43.48,النص العام,,0,0,0,,لماذا يجب أن أكذب؟ أنا حقا...
Dialogue: 0,0:24:43.56,0:24:44.85,مائل,,0,0,0,,- أنت تكذب دائمًا\N{\i0}- بالتأكيد متزوج
Dialogue: 0,0:24:45.77,0:24:46.94,نص عام,,0,0,0,,- إطلاقاً\N- إطلاقاً
Dialogue: 0,0:24:47.52,0:24:49.11,النص العام,,0,0,0,,حسنًا، هل فزت؟
Dialogue: 0,0:24:49.19,0:24:50.73,نص عام,,0,0,0,,لا، ضاعت. لكن...
Dialogue: 0,0:24:51.61,0:24:52.99,النص العام,,0,0,0,,إنه قوي جدًا
Dialogue: 0,0:24:53.07,0:24:55.28,النص العام,,0,0,0,,- هو...\N- أنت محظوظ. عرفت ذلك
Dialogue: 0,0:24:55.36,0:24:56.41,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:25:00.74,0:25:04.12,النص العام,,0,0,0,,حتى أنهم جمعوا مجلساً. الأمور تزداد تعقيدا
Dialogue: 0,0:25:04.21,0:25:07.54,general text,,0,0,0,,هل تعتقد أن ووك ومو ديوك بخير؟
Dialogue: 0,0:25:07.63,0:25:10.30,general text,,0,0,0,,ذهبوا إلى ساري، موطن مو دوك.
Dialogue: 0,0:25:10.38,0:25:11.55,نص عام,,0,0,0,,أعتقد أنها سعيدة
Dialogue: 0,0:25:13.38,0:25:14.97,النص العام,,0,0,0,,لماذا يجب أن تكون سعيدة؟
Dialogue: 0,0:25:15.05,0:25:16.18,نص عام,,0,0,0,,كان عليها أن تتركك
Dialogue: 0,0:25:16.26,0:25:18.51,النص العام,,0,0,0,,- و؟\N - حسنًا، أنت أحمق
Dialogue: 0,0:25:18.60,0:25:20.51,النص العام,,0,0,0,,مو دوك مغرم بك
Dialogue: 0,0:25:23.14,0:25:24.52,نص عام,,0,0,0,,هي قالت ذلك،
Dialogue: 0,0:25:25.44,0:25:26.77,نص عام,,0,0,0,,لمساعدة أوكو
Dialogue: 0,0:25:26.85,0:25:28.56,نص عام,,0,0,0,,نعم نعم بالطبع
Dialogue: 0,0:25:31.57,0:25:34.49,النص العام,,0,0,0,,سمعت السيد تشان يهرب
Dialogue: 0,0:25:34.57,0:25:38.70,general text,,0,0,0,,لم يهرب، لقد اختبأ الآن فقط
Dialogue: 0,0:25:38.78,0:25:40.24,نص عام,,0,0,0,,ما الفرق؟
Dialogue: 0,0:25:40.33,0:25:43.00,general text,,0,0,0,,إذن ذهب إلى Danhyangok مع Mu Dok؟
Dialogue: 0,0:25:44.87,0:25:46.96,نص عام,,0,0,0,,- دانهيانجوك؟\N- نعم
Dialogue: 0,0:25:47.04,0:25:50.42,general text,,0,0,0,,قامت مؤخرًا بإطلاق الألعاب النارية هناك بأمر من السيد
Dialogue: 0,0:25:50.50,0:25:53.09,نص عام,,0,0,0,,أذكر أنني رأيتهم
Dialogue: 0,0:25:53.17,0:25:56.26,general text,,0,0,0,,اكتشفت أنهم ذهبوا إلى هناك لأنه كان قريباً
Dialogue: 0,0:25:56.34,0:25:59.01,النص العام,,0,0,0,,- هل أنا على حق؟\N- لا
Dialogue: 0,0:25:59.09,0:26:01.97,النص العام,,0,0,0,,مو دوك مع أوك في قرية ساري
Dialogue: 0,0:26:02.06,0:26:04.06,نص عام,,0,0,0,,آه، فهمت. ساري
Dialogue: 0,0:26:04.14,0:26:06.27,نص عام,,0,0,0,,لا تخبر أحداً أن المملكة المتحدة موجودة
Dialogue: 0,0:26:06.85,0:26:08.52,نص عام,,0,0,0,,حسنًا لن أقول
Dialogue: 0,0:26:08.60,0:26:09.73,نص عام,,0,0,0,,شهية طيبة
Dialogue: 0,0:26:11.90,0:26:14.23,نص عام,,0,0,0,,مو دوك في دانهيانغوك؟
Dialogue: 0,0:26:14.32,0:26:15.82,نص عام,,0,0,0,,المكان خطير جداً
Dialogue: 0,0:26:15.90,0:26:18.24,نص عام,,0,0,0,,هل أبقيت طائرك هناك؟
Dialogue: 0,0:26:18.95,0:26:20.99,general text,,0,0,0,,لقد لويت كاحلك هناك وأخافت الجميع
Dialogue: 0,0:26:21.95,0:26:23.37,نص عام,,0,0,0,,نعم في دانهيانغوك
Dialogue: 0,0:26:25.54,0:26:27.71,نص عام,,0,0,0,,لقد نسيت كل شيء عن هذا المكان
Dialogue: 0,0:26:41.39,0:26:42.51,نص عام,,0,0,0,,نار ضعيفة
Dialogue: 0,0:26:47.56,0:26:50.19,general text,,0,0,0,,جسده مليء بالطاقة بالنظر إلى قوته
Dialogue: 0,0:26:53.19,0:26:54.90,النص العام,,0,0,0,,إنه سيد الشيبسو
Dialogue: 0,0:26:55.53,0:26:57.90,نص عام,,0,0,0,,الرقائق؟ لذا فهو قوي مثلي
Dialogue: 0,0:26:57.99,0:27:00.36,general text,,0,0,0,,من الواضح سبب صعوبة التغلب عليه
Dialogue: 0,0:27:09.92,0:27:12.08,مائل,,0,0,0,,يستخدم الطاقة لإبقاء النار مشتعلة
Dialogue: 0,0:27:12.17,0:27:13.25,نص عام,,0,0,0,,لقد انتقل،
Dialogue: 0,0:27:14.17,0:27:15.30,نص عام,,0,0,0,,من ريوسو
Dialogue: 0,0:27:18.01,0:27:18.97,نص عام,,0,0,0,,ريوسو؟
Dialogue: 0,0:27:20.09,0:27:22.72,general text,,0,0,0,,إنه أقوى مني. كان من الممكن أن أتأذى كثيرًا
Dialogue: 0,0:27:28.02,0:27:29.77,نص عام,,0,0,0,,بلل المطر ثيابي
Dialogue: 0,0:27:51.83,0:27:53.00,نص عام,,0,0,0,,هذا هو تشيسو
Dialogue: 0,0:27:53.79,0:27:55.71,النص العام,,0,0,0,,لقد جفف ملابسه بسهولة
Dialogue: 0,0:27:55.79,0:27:58.42,النص العام,,0,0,0,,هذه أعلى درجات الشيسو
Dialogue: 0,0:28:05.22,0:28:06.85,نص عام,,0,0,0,,أعلى درجة؟
Dialogue: 0,0:28:08.14,0:28:09.60,نص عام,,0,0,0,,كان من الممكن أن أموت
Dialogue: 0,0:28:13.23,0:28:14.77,نص عام,,0,0,0,,الآن أصبح جافًا
Dialogue: 0,0:28:23.78,0:28:25.12,خط مائل,,0,0,0,,لا تشرب هذا الشاي
Dialogue: 0,0:28:29.87,0:28:31.37,النص العام,,0,0,0,,هل شربت كل شيء؟
Dialogue: 0,0:28:31.46,0:28:32.46,نص عام,,0,0,0,,نعم
Dialogue: 0,0:28:32.54,0:28:34.63,نص عام,,0,0,0,,هل أنت بخير؟ هل يؤلمك شيء؟
Dialogue: 0,0:28:37.25,0:28:38.30,general text,,0,0,0,,هل هذا مغلي سام؟
Dialogue: 0,0:28:39.21,0:28:40.59,خط مائل,,0,0,0,,لا بالطبع
Dialogue: 0,0:28:40.67,0:28:41.97,نص عام,,0,0,0,,مغلي المرق
Dialogue: 0,0:28:42.05,0:28:43.30,نص عام,,0,0,0,,بروتنياك؟
Dialogue: 0,0:28:43.38,0:28:44.64,نص عام,,0,0,0,,مغلي الغصين؟
Dialogue: 0,0:28:45.22,0:28:48.26,النص العام,,0,0,0,,لقد تحدثت عن الأعشاب التي تنمو فقط في دانهيانغوك
Dialogue: 0,0:28:48.35,0:28:49.68,نص عام,,0,0,0,,هل كنت تتحدث عن الأغصان؟
Dialogue: 0,0:28:51.98,0:28:53.81,نص عام,,0,0,0,,هل تعلم عنه؟
Dialogue: 0,0:28:53.89,0:28:56.86,general text,,0,0,0,,سمعت أن السحرة كانوا يشربون هذا النوع من الشاي...
Dialogue: 0,0:28:56.94,0:29:00.28,general text,,0,0,0,,لقد خفض الرغبة الجنسية وتدربوا بهدوء
Dialogue: 0,0:29:01.69,0:29:03.36,نص عام,,0,0,0,,الرغبة الجنسية؟ ما هذا؟
Dialogue: 0,0:29:04.20,0:29:06.99,general text,,0,0,0,,الرغبة الجسدية، إحدى احتياجات الإنسان الخمس
Dialogue: 0,0:29:07.07,0:29:08.58,نص عام,,0,0,0,,جسدي...
Dialogue: 0,0:29:11.29,0:29:13.37,نص عام,,0,0,0,,يخفض بروتنياك...
Dialogue: 0,0:29:14.87,0:29:18.09,النص العام,,0,0,0,,الطاقة المسببة لهذه الرغبة
Dialogue: 0,0:29:20.30,0:29:23.09,general text,,0,0,0,,سمعت عن ساحر وصل لدرجة عالية من السحر
Dialogue: 0,0:29:23.17,0:29:25.80,general text,,0,0,0,,لقد نجح لأنه خفض الرغبة الجنسية لديه وتحسنت
Dialogue: 0,0:29:25.88,0:29:29.05,مائل,,0,0,0,,يقولون إنه لا يرتدي إلا الملابس المصنوعة من قماش القنب،
Dialogue: 0,0:29:29.14,0:29:32.35,نص عام,,0,0,0,,لهذا السبب أُطلق على السيد "لي" لقب "السيد هيمب لي"
Dialogue: 0,0:29:32.43,0:29:36.14,النص العام,,0,0,0,,وأنت ذكي بالنسبة لخادم بسيط
Dialogue: 0,0:29:38.77,0:29:41.98,general text,,0,0,0,,إنه لشرف لي أن ألتقي بساحر بهذا المستوى
Dialogue: 0,0:29:42.53,0:29:44.49,نص عام,,0,0,0,,تحياتي أستاذ همبلي
Dialogue: 0,0:29:53.12,0:29:54.08,نص عام,,0,0,0,,المضيف,
Dialogue: 0,0:29:54.16,0:29:56.08,نص عام,,0,0,0,,لماذا تجلس؟ قل مرحبا
Dialogue: 0,0:29:59.21,0:30:02.50,general text,,0,0,0,,إذًا... الرغبة الجنسية لدي هي نفسها تمامًا بالفعل؟..
Dialogue: 0,0:30:03.88,0:30:05.01,نص عام,,0,0,0,,لا...
Dialogue: 0,0:30:05.09,0:30:06.09,نص عام,,0,0,0,,لا...
Dialogue: 0,0:30:06.17,0:30:07.72,نص عام,,0,0,0,,ولكن ليس هذا...
Dialogue: 0,0:30:08.43,0:30:10.35,نص عام,,0,0,0,,هذا لا يمكن أن يكون. ساعدني
Dialogue: 0,0:30:11.18,0:30:13.93,نص عام,,0,0,0,,غلاية واحدة لا تكفي لهذا
Dialogue: 0,0:30:14.02,0:30:15.85,نص عام,,0,0,0,,هل أنت متأكد؟ قل لي الحقيقة!
Dialogue: 0,0:30:15.93,0:30:17.94,مائل,,0,0,0,,هذا صحيح. إذا كنت قلقًا جدًا،
Dialogue: 0,0:30:18.02,0:30:20.48,نص عام,,0,0,0,,سأعد شايًا آخر يعيد كل شيء إلى مكانه
Dialogue: 0,0:30:22.44,0:30:25.07,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:30:25.15,0:30:26.15,خط مائل,,0,0,0,,السيد لي
Dialogue: 0,0:30:26.24,0:30:28.99,نص عام,,0,0,0,,هل يمكنك مساعدة سيدي؟
Dialogue: 0,0:30:29.07,0:30:33.45,general text,,0,0,0,,طاقته تراكمت في يده اليمنى ولا يستطيع السيطرة عليها
Dialogue: 0,0:30:33.54,0:30:37.46,النص العام,,0,0,0,,هل يمكنك تعليمه كيفية التأقلم بطريقة ما؟
Dialogue: 0,0:30:37.54,0:30:39.21,نص عام,,0,0,0,,لن يكون من الصعب تعليمه
Dialogue: 0,0:30:39.29,0:30:42.25,نص عام,,0,0,0,,لكن! لتتعلم مني عليك أن تتبع كل ما أقوله.
Dialogue: 0,0:30:42.34,0:30:43.55,نص عام,,0,0,0,,هل أنت مستعد لهذا؟
Dialogue: 0,0:30:43.63,0:30:45.05,مائل,,0,0,0,,إنه مستعد لأي شيء
Dialogue: 0,0:30:45.13,0:30:46.05,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:30:48.59,0:30:51.35,نص عام,,0,0,0,,ما الذي يجب علي فعله بالضبط؟
Dialogue: 0,0:30:51.43,0:30:52.55,نص عام,,0,0,0,,مثلي
Dialogue: 0,0:30:53.35,0:30:54.77,نص عام,,0,0,0,,اشرب مغلي الأغصان
Dialogue: 0,0:30:56.06,0:30:58.48,نص عام,,0,0,0,,جاهز للرجوع إلى إصدار أقدم
Dialogue: 0,0:31:01.15,0:31:02.23,نص عام,,0,0,0,,الرغبة الجنسية؟
Dialogue: 0,0:31:06.82,0:31:08.45,general text,,0,0,0,,هل أفرغت الغلاية بأكملها؟
Dialogue: 0,0:31:08.95,0:31:09.95,نص عام,,0,0,0,,نعم
Dialogue: 0,0:31:10.91,0:31:12.12,نص عام,,0,0,0,,هل يمكنك فعل ذلك؟
Dialogue: 0,0:31:24.04,0:31:26.30,النص العام,,0,0,0,,فماذا لو كان ساحراً مشهوراً؟
Dialogue: 0,0:31:26.38,0:31:30.09,general text,,0,0,0,,ليس لديه تلميذ، وهو يتسكع هنا دون سبب واضح.
Dialogue: 0,0:31:30.93,0:31:33.18,النص العام,,0,0,0,,بمساعدتها، كل شيء سوف يسير بشكل أسرع
Dialogue: 0,0:31:33.68,0:31:36.43,general text,,0,0,0,,سوف تكون قادرًا على التحكم بالطاقة في يدك اليمنى
Dialogue: 0,0:31:36.52,0:31:40.10,general text,,0,0,0,,يريدني أن أشرب شاي العفة هذا. ما هي النقطة؟
Dialogue: 0,0:31:40.19,0:31:44.65,النص العام,,0,0,0,,أنا قلق بالفعل بشأن الكمية التي شربتها بالأمس
Dialogue: 0,0:31:44.73,0:31:47.15,general text,,0,0,0,,أشك في أن هذا الشاي سيكون كافياً لإعادة كل شيء.
Dialogue: 0,0:31:47.23,0:31:49.07,نص عام,,0,0,0,,هذا منطقي
Dialogue: 0,0:31:50.20,0:31:52.16,نص عام,,0,0,0,,ليست فكرة سيئة
Dialogue: 0,0:31:52.24,0:31:55.62,النص العام,,0,0,0,,الآن لست بحاجة إلى زيادة الرغبة الجنسية
Dialogue: 0,0:31:59.71,0:32:03.00,general text,,0,0,0,,إذن لبعض الوقت لن يكون لدي أي رغبات؟
Dialogue: 0,0:32:04.96,0:32:06.96,النص العام,,0,0,0,,مو دوك انظر في عيني وأخبرني
Dialogue: 0,0:32:07.05,0:32:08.55,نص عام,,0,0,0,,نعم! وماذا؟
Dialogue: 0,0:32:08.63,0:32:10.59,نص عام,,0,0,0,,فكر بنفسك. هذه فرصة نادرة
Dialogue: 0,0:32:10.67,0:32:12.88,general text,,0,0,0,,ليس كل أحمق محظوظاً بما يكفي للقاء شخص مثله
Dialogue: 0,0:32:13.93,0:32:15.55,نص عام,,0,0,0,,قليل من ضبط النفس
Dialogue: 0,0:32:16.60,0:32:17.60,نص عام,,0,0,0,,وتخلص منه
Dialogue: 0,0:32:17.68,0:32:20.18,general text,,0,0,0,,هذه ليست نزهة في الحديقة، لا تزعجني هنا!
Dialogue: 0,0:32:20.27,0:32:22.31,general text,,0,0,0,,العزوبة تضحية تافهة لساحر رفيع المستوى
Dialogue: 0,0:32:22.39,0:32:24.19,نص عام,,0,0,0,,فقط استمع!
Dialogue: 0,0:32:24.27,0:32:26.73,general text,,0,0,0,,لا يهمك حتى لو أفسدت كل شيء بنفسي هناك إلى الأبد!
Dialogue: 0,0:32:26.82,0:32:28.28,النص العام,,0,0,0,,توقف عن صنع الجبال من التلال!
Dialogue: 0,0:32:28.36,0:32:30.40,general text,,0,0,0,,إنه مهم بالنسبة لي، بغض النظر عما إذا كنت أستخدمه أم لا!
Dialogue: 0,0:32:41.62,0:32:43.17,نص عام,,0,0,0,,مرحبًا...
Dialogue: 0,0:32:43.25,0:32:45.96,النص العام,,0,0,0,,يا مو دوك، هل أنت بخير؟
Dialogue: 0,0:32:46.54,0:32:48.59,نص عام,,0,0,0,,ماذا حدث للتو؟
Dialogue: 0,0:32:49.63,0:32:50.55,نص عام,,0,0,0,,ريوسو
Dialogue: 0,0:32:52.84,0:32:55.26,نص عام,,0,0,0,,الطاقة تسربت منك
Dialogue: 0,0:32:56.76,0:32:59.18,نص عام,,0,0,0,,قليل من الطاقة ومثل هذه الزيادة في القوة
Dialogue: 0,0:32:59.77,0:33:02.81,general text,,0,0,0,,لو خلعت السوار واستخدمت كل قوتك،
Dialogue: 0,0:33:02.89,0:33:04.69,نص عام,,0,0,0,,سأموت على الفور
Dialogue: 0,0:33:08.44,0:33:09.90,نص عام,,0,0,0,,أنت تنزف...
Dialogue: 0,0:33:12.32,0:33:14.32,نص عام,,0,0,0,,يا معلم، أنت مجنون تمامًا
Dialogue: 0,0:33:14.40,0:33:16.41,general text,,0,0,0,,- هل تعجبك فكرة أن أموت؟\N- نعم
Dialogue: 0,0:33:16.49,0:33:19.41,النص العام,,0,0,0,,هذا يعني أنك أصبحت أقوى
Dialogue: 0,0:33:23.00,0:33:26.37,نص عام,,0,0,0,,الآن قد يبدو هذا غير مهم،
Dialogue: 0,0:33:26.46,0:33:29.67,نص عام,,0,0,0,,ولكن قريباً سيكون لديك المزيد من الطاقة
Dialogue: 0,0:33:30.46,0:33:33.84,general text,,0,0,0,,وسوف تصبح قوتك مثيرة للإعجاب مثل بحيرة جيونج جيونج دايهو.
Dialogue: 0,0:33:35.97,0:33:38.39,النص العام,,0,0,0,,إذن يمكنني أيضًا استعادة قوتي
Dialogue: 0,0:33:52.28,0:33:55.36,general text,,0,0,0,,امسح الدماء عن جبهتك قبل أن تغمر غيونغجيونغدايهو.
Dialogue: 0,0:33:58.78,0:33:59.62,نص عام,,0,0,0,,هل يؤلمك؟
Dialogue: 0,0:33:59.70,0:34:01.33,نص عام,,0,0,0,,إطلاقاً
Dialogue: 0,0:34:01.41,0:34:02.91,نص عام,,0,0,0,,توقف عن الشجاعة
Dialogue: 0,0:34:07.79,0:34:09.71,نص عام,,0,0,0,,العام الأول من حكم الملك غو سان
Dialogue: 0,0:34:09.79,0:34:12.17,نص عام,,0,0,0,,يوم أبريل
Dialogue: 0,0:34:18.72,0:34:20.05,نقوش,,0,0,0,,جو سان، السنة الأولى، الأول من أبريل
Dialogue: 0,0:34:20.14,0:34:23.60,ذكريات بخط مائل,,0,0,0,,نجمة الملك أضاءت في سماء الليل في عيد ميلاد الصبي
Dialogue: 0,0:34:23.68,0:34:26.31,ذكريات,,0,0,0,,لا ينبغي لأحد أن يعرف عن هذا
Dialogue: 0,0:34:26.39,0:34:28.90,ذكريات,,0,0,0,,ولكن من المحتمل أن جيونغبوجوان قام بالتسجيل
Dialogue: 0,0:34:28.98,0:34:31.31,ذكريات,,0,0,0,,لقد أخذت الإشارة الحقيقية للخروج من هناك
Dialogue: 0,0:34:31.40,0:34:32.73,ذكريات,,0,0,0,,في جيونبوغوان
Dialogue: 0,0:34:33.86,0:34:35.49,ذكريات,,0,0,0,,وهمية بلا نجمة
Dialogue: 0,0:34:37.11,0:34:41.32,ذكريات بخط مائل,,0,0,0,,لا تدع أحداً يعرف سر ولادته
Dialogue: 0,0:34:45.95,0:34:48.54,نص عام,,0,0,0,,هل رأيت كوكبة غريبة؟
Dialogue: 0,0:34:57.42,0:35:01.51,نص عام,,0,0,0,,إنه عيد ميلاد ووك ووفاة السيدة دو هوا
Dialogue: 0,0:35:04.26,0:35:05.93,نص عام,,0,0,0,,سمعت عن النصيحة
Dialogue: 0,0:35:06.89,0:35:11.44,النص العام,,0,0,0,,لقد اجتمع كل السحرة الكرام بسببي
Dialogue: 0,0:35:14.23,0:35:15.53,خط مائل,,0,0,0,,نائب غوانغجو,
Dialogue: 0,0:35:16.32,0:35:18.15,مائل,,0,0,0,,لماذا لا تبدأ سلسلة نسبك؟
Dialogue: 0,0:35:19.20,0:35:21.99,نص عام,,0,0,0,,بصوت واحد,
Dialogue: 0,0:35:22.07,0:35:26.66,النص العام,,0,0,0,,قد يتم التعرف عليك أيضًا كساحر موقر
Dialogue: 0,0:35:29.37,0:35:32.79,النص العام,,0,0,0,,أنا من عشيرة جين. جينيوون هو المكان الذي ولدت فيه
Dialogue: 0,0:35:35.84,0:35:37.71,general text,,0,0,0,,ما الذي أتى بك إلى جيونبوغوان؟
Dialogue: 0,0:35:37.80,0:35:39.30,النص العام,,0,0,0,,البدوي الذي تم العثور عليه في سوسنوفي بور،
Dialogue: 0,0:35:39.38,0:35:41.59,النص العام,,0,0,0,,كان منجمًا من جيونبوغوان
Dialogue: 0,0:35:42.34,0:35:44.76,general text,,0,0,0,,بدأ سحرة تشونغجينجاك التحقيق،
Dialogue: 0,0:35:45.47,0:35:46.68,نص عام,,0,0,0,,تقديم المساعدة
Dialogue: 0,0:35:47.39,0:35:49.35,نص عام,,0,0,0,,أي تحقيق؟
Dialogue: 0,0:35:54.11,0:35:58.03,general text,,0,0,0,,وإذا أخبرتك هل ستخفي كل الأدلة؟
Dialogue: 0,0:36:01.07,0:36:03.62,نص عام,,0,0,0,,ليس لدي ما أخفيه
Dialogue: 0,0:36:03.70,0:36:05.58,نص عام,,0,0,0,,يمكن أن يأتوا في أي وقت
Dialogue: 0,0:36:06.95,0:36:09.66,نص عام,,0,0,0,,إنهم هنا بالفعل
Dialogue: 0,0:36:34.15,0:36:35.94,النص العام,,0,0,0,,يجب أن يكون لدى هذا الساحر
Dialogue: 0,0:36:36.02,0:36:38.98,نص عام,,0,0,0,,حافظ باستمرار على الكمية المطلوبة من الطاقة هنا
Dialogue: 0,0:36:40.03,0:36:42.70,نص عام,,0,0,0,,كان مسؤولاً عن هذا المكان
Dialogue: 0,0:36:51.45,0:36:54.67,نص عام,,0,0,0,,ماذا؟ الجثة في جيونبوغوان؟
Dialogue: 0,0:36:54.75,0:36:57.96,general text,,0,0,0,,استخرج كيم الخصي كل طاقته، وجسده في غرفة سرية.
Dialogue: 0,0:37:12.73,0:37:15.10,نص عام,,0,0,0,,لم يكن هناك شيء مميز في عمله
Dialogue: 0,0:37:15.19,0:37:18.27,نص عام,,0,0,0,,مجرد ملاحظة للنظر سراً إلى الأبراج
Dialogue: 0,0:37:21.65,0:37:22.69,نص عام,,0,0,0,,عم
Dialogue: 0,0:37:23.78,0:37:27.16,نص عام,,0,0,0,,لقد اختفى هنا العديد من العلماء
Dialogue: 0,0:37:27.24,0:37:28.62,general text,,0,0,0,,أين يمكن أن يكونوا قد اختفوا؟
Dialogue: 0,0:37:35.37,0:37:37.00,نص عام,,0,0,0,,شكرًا لمساعدتكم
Dialogue: 0,0:37:37.67,0:37:39.09,نص عام,,0,0,0,,لا يوجد شيء مميز
Dialogue: 0,0:37:39.17,0:37:41.42,نص عام,,0,0,0,,لدي طلب آخر
Dialogue: 0,0:37:42.30,0:37:43.92,نص عام,,0,0,0,,ربما هذا كثير جدًا،
Dialogue: 0,0:37:44.72,0:37:48.26,النص العام,,0,0,0,,لكنني أود أن ألقي نظرة على غرفة جيونبوغوان السرية.
Dialogue: 0,0:38:06.03,0:38:07.91,نص عام,,0,0,0,,يمكنك أن تنظر حولك
Dialogue: 0,0:38:34.27,0:38:36.98,ذكريات بخط مائل,,0,0,0,,حمل الجثة عبر الممر تحت الأرض
Dialogue: 0,0:38:49.20,0:38:52.12,ذكريات مائلة,,0,0,0,,إذا أخفوا شيئًا سيحاولون التخلص منه
Dialogue: 0,0:38:52.95,0:38:54.58,ذكريات بخط مائل,,0,0,0,,راقب شعبه
Dialogue: 0,0:38:58.67,0:38:59.87,نص عام,,0,0,0,,أسرع
Dialogue: 0,0:39:13.26,0:39:15.18,نص عام,,0,0,0,,لقد رأينا كيف غادرت هذه العربة جيونبوغوان
Dialogue: 0,0:39:15.27,0:39:17.06,النص العام,,0,0,0,,هل أنتم سحرة؟
Dialogue: 0,0:39:17.14,0:39:18.27,نص عام,,0,0,0,,إظهار الوجوه
Dialogue: 0,0:39:18.35,0:39:19.56,نص عام,,0,0,0,,نريد أن نرى ما بالداخل
Dialogue: 0,0:40:03.19,0:40:04.11,نص عام,,0,0,0,,فلنقبض عليه
Dialogue: 0,0:40:52.20,0:40:53.74,النص العام,,0,0,0,,الرجل هرب
Dialogue: 0,0:40:55.11,0:40:56.66,نص عام,,0,0,0,,هل فقدته؟
Dialogue: 0,0:40:58.87,0:41:00.16,نص عام,,0,0,0,,كان هذا بالداخل
Dialogue: 0,0:41:00.79,0:41:02.25,نص عام,,0,0,0,,تميمة الروح
Dialogue: 0,0:41:03.12,0:41:05.21,general text,,0,0,0,,هل هم من سوسنوفي بور؟
Dialogue: 0,0:41:20.68,0:41:23.89,النص العام,,0,0,0,,كان هناك تميمة روحية في العربة
Dialogue: 0,0:41:23.98,0:41:26.06,نص عام,,0,0,0,,لا ينبغي طرح أي أسئلة
Dialogue: 0,0:41:27.06,0:41:29.65,general text,,0,0,0,,ساعدنا ناك سو حتى بعد الموت
Dialogue: 0,0:41:33.15,0:41:36.20,النص العام,,0,0,0,,آسف على الصعوبات، النائب غوانغجو
Dialogue: 0,0:41:40.91,0:41:43.75,general text,,0,0,0,,هل هاجمت رجلاً في منتصف الشارع؟
Dialogue: 0,0:41:43.83,0:41:46.67,general text,,0,0,0,,لقد نقلت روحك التافهة إلى جسد لائق،
Dialogue: 0,0:41:46.75,0:41:48.13,نص عام,,0,0,0,,لكن لم يكن لك الحق في التباهي
Dialogue: 0,0:41:48.21,0:41:49.38,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:41:58.05,0:42:00.14,نص عام,,0,0,0,,سلم هذا الصندوق
Dialogue: 0,0:42:03.31,0:42:05.48,نص عام,,0,0,0,,تأكد من أنه في الأيدي اليمنى
Dialogue: 0,0:42:05.56,0:42:08.81,نص عام,,0,0,0,,سأهتم بالأمر على الفور
Dialogue: 0,0:42:19.49,0:42:21.41,نص عام,,0,0,0,,حان وقت التخلص منه
Dialogue: 0,0:42:21.49,0:42:23.20,نص عام,,0,0,0,,ابحث لي عن خصي آخر
Dialogue: 0,0:42:23.29,0:42:27.37,general text,,0,0,0,,وإلا سأنقل روحك إلى جسده
Dialogue: 0,0:42:30.38,0:42:32.05,نص عام,,0,0,0,,في جسد الخصي؟
Dialogue: 0,0:42:32.96,0:42:35.72,نص عام,,0,0,0,,ماذا؟ لا أحب ذلك؟
Dialogue: 0,0:42:38.55,0:42:40.85,نص عام,,0,0,0,,سأتبع طلبك
Dialogue: 0,0:42:40.93,0:42:44.02,general text,,0,0,0,,هل مازلت تحمل العاكس معك؟
Dialogue: 0,0:42:44.10,0:42:45.02,نص عام,,0,0,0,,نعم
Dialogue: 0,0:42:53.65,0:42:57.07,general text,,0,0,0,,كنت أفكر في الامتناع عن تناسخ الأرواح بسبب سوسنوفي بور
Dialogue: 0,0:42:58.82,0:43:02.99,general text,,0,0,0,,ولكن يبدو أن هذه هي الطريقة الوحيدة لخدمة جلالته
Dialogue: 0,0:43:08.71,0:43:12.09,مائل,,0,0,0,,عُثر على تميمة "سوسنوفي بور" في عربة غريبة،
Dialogue: 0,0:43:12.17,0:43:14.25,نص عام,,0,0,0,,الذي غادر جيونبوغوان
Dialogue: 0,0:43:14.34,0:43:17.22,نص عام,,0,0,0,,الآن ليس لدينا الحق في البحث عن أي شيء هناك
Dialogue: 0,0:43:17.30,0:43:20.18,نص عام,,0,0,0,,اكتشف لمن هذه التميمة
Dialogue: 0,0:43:20.76,0:43:24.72,general text,,0,0,0,,تذكر أن المملكة المتحدة خسرت بلدها
Dialogue: 0,0:43:25.31,0:43:28.73,النص العام,,0,0,0,,وبالنظر إلى هذه العلامة المحروقة، فهذه تميمة له
Dialogue: 0,0:43:30.10,0:43:31.40,نص عام,,0,0,0,,تميمة أوكا؟
Dialogue: 0,0:43:31.48,0:43:35.61,general text,,0,0,0,,فكر فقط، لقد هرب، لكن المشاكل لا تزال تقع علينا
Dialogue: 0,0:43:35.69,0:43:37.44,نص عام,,0,0,0,,البحث عن أوكا
Dialogue: 0,0:43:37.53,0:43:41.45,نص عام,,0,0,0,,اكتشف كيف وأين فقده
Dialogue: 0,0:43:42.28,0:43:43.57,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:44:24.41,0:44:26.70,النص العام,,0,0,0,,هذا من جين مو، نائب جيونبوغوان
Dialogue: 0,0:44:36.67,0:44:39.80,general text,,0,0,0,,ماذا يرسل لك باستمرار؟
Dialogue: 0,0:44:40.55,0:44:43.84,نص عام,,0,0,0,,هذه أعشاب طبية لصحتي
Dialogue: 0,0:44:46.85,0:44:49.14,النص العام,,0,0,0,,لا يمكنك معرفة ذلك منه، لكنه مهتم جدًا
Dialogue: 0,0:45:04.11,0:45:05.03,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:45:05.11,0:45:07.70,نص عام,,0,0,0,,سأذهب مع السيد لي لجمع الأعشاب
Dialogue: 0,0:45:07.78,0:45:08.83,نص عام,,0,0,0,,والتدريب؟
Dialogue: 0,0:45:08.91,0:45:11.83,نص عام,,0,0,0,,يجب أن أدفع ثمن المحتوى. أراك لاحقا
Dialogue: 0,0:45:11.91,0:45:13.29,نص عام,,0,0,0,,- هيا بنا\N- نعم
Dialogue: 0,0:45:14.37,0:45:15.96,نص عام,,0,0,0,,هل المكان جميل جدًا هناك حقًا؟
Dialogue: 0,0:45:16.04,0:45:18.84,نص عام,,0,0,0,,- ببساطة مذهل\N- أتمنى أن أراه قريباً
Dialogue: 0,0:45:24.18,0:45:26.55,نص عام,,0,0,0,,سيد لي، أنت ذكي جدًا
Dialogue: 0,0:45:26.64,0:45:29.43,نص عام,,0,0,0,,أشتري كل شيء وأجمعه. امسكها
Dialogue: 0,0:45:29.51,0:45:30.56,نص عام,,0,0,0,,- إذن؟\N- نعم
Dialogue: 0,0:45:34.89,0:45:36.06,نص عام,,0,0,0,,رائع
Dialogue: 0,0:45:38.65,0:45:41.36,نص عام,,0,0,0,,اليوم سنذهب إلى حيث يوجد الكثير من اليوسفي*
Dialogue: 0,0:45:38.65,0:45:41.36,ملاحظات,,0,0,0,,*سمك النهاش الصيني
Dialogue: 0,0:45:41.44,0:45:44.70,نص عام,,0,0,0,,اليوسفي؟ لنأخذ ما نحتاجه ونعد يخنة السمك
Dialogue: 0,0:45:44.78,0:45:46.11,نص عام,,0,0,0,,هل يمكنك فعل ذلك؟
Dialogue: 0,0:45:46.20,0:45:48.16,نص عام,,0,0,0,,لا لكنك ستعلمني
Dialogue: 0,0:45:49.08,0:45:50.91,نص عام,,0,0,0,,ما بك...
Dialogue: 0,0:46:02.13,0:46:03.26,نص عام,,0,0,0,,مملح
Dialogue: 0,0:46:05.97,0:46:07.64,نص عام,,0,0,0,,مو دوك، حاول
Dialogue: 0,0:46:08.22,0:46:11.10,نص عام,,0,0,0,,سيدتي، هل أنت هنا للتعامل مع الهراء؟
Dialogue: 0,0:46:11.18,0:46:12.93,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:46:13.72,0:46:15.89,نص عام,,0,0,0,,هناك شيء لنتعلمه من المعلم لي
Dialogue: 0,0:46:15.98,0:46:17.40,نص عام,,0,0,0,,من يطلب منك أن تتعلم هذا؟
Dialogue: 0,0:46:17.48,0:46:19.48,النص العام,,0,0,0,,إذا تعلمت منه فتعلم بشكل صحيح!
Dialogue: 0,0:46:20.31,0:46:22.86,general text,,0,0,0,,مو دوك، أعتقد أنني مثالي لهذا النوع من الحياة
Dialogue: 0,0:46:22.94,0:46:24.57,نص عام,,0,0,0,,شكرًا لإحضاري
Dialogue: 0,0:46:24.65,0:46:26.24,نص عام,,0,0,0,,إلى هذا المكان الرائع
Dialogue: 0,0:46:28.82,0:46:29.99,نص عام,,0,0,0,,لست قلقاً
Dialogue: 0,0:46:32.12,0:46:34.20,نص عام,,0,0,0,,بسبب المبارزة مع الأمير؟
Dialogue: 0,0:46:35.62,0:46:37.67,نص عام,,0,0,0,,إذا كنت قلقًا للغاية، فاكتشف ذلك بنفسك
Dialogue: 0,0:46:39.63,0:46:40.58,نص عام,,0,0,0,,بالتأكيد مبالغ فيه
Dialogue: 0,0:46:43.75,0:46:44.67,نص عام,,0,0,0,,مرحبًا!
Dialogue: 0,0:46:56.56,0:46:57.77,النص العام,,0,0,0,,مو دوك، ضع السكين جانباً
Dialogue: 0,0:46:58.73,0:47:00.65,نص عام,,0,0,0,,لا تجرؤ على رميها عليّ!
Dialogue: 0,0:47:01.23,0:47:03.36,نص عام,,0,0,0,,قلت سأقتلك إذا كنت عديم الفائدة
Dialogue: 0,0:47:04.48,0:47:05.57,نص عام,,0,0,0,,لا يمكنك قتلي
Dialogue: 0,0:47:05.65,0:47:07.82,general text,,0,0,0,,لقد أتقنت الشيبسو وأنت فقط مو دوك
Dialogue: 0,0:47:09.74,0:47:11.45,نص عام,,0,0,0,,أنت لم تعد ناك سو بعد الآن
Dialogue: 0,0:47:14.12,0:47:15.79,نص عام,,0,0,0,,هاي، لقد أخبرتك!
Dialogue: 0,0:47:16.50,0:47:19.33,نص عام,,0,0,0,,أنا وأنت لا نحتاج إلى السلام والهدوء
Dialogue: 0,0:47:19.42,0:47:20.62,النص العام,,0,0,0,,سأدمر عالمك
Dialogue: 0,0:47:27.13,0:47:28.51,نص عام,,0,0,0,,ما بك؟
Dialogue: 0,0:47:28.59,0:47:30.72,general text,,0,0,0,,لماذا تمنعني من العيش بسلام؟
Dialogue: 0,0:47:30.80,0:47:32.68,general text,,0,0,0,,هل أنت سعيد بهذا النوع من الحياة؟
Dialogue: 0,0:47:33.93,0:47:34.81,نص عام,,0,0,0,,نعم!
Dialogue: 0,0:47:34.89,0:47:37.81,نص عام,,0,0,0,,بالتأكيد. إذا كنت لا تحب ذلك، غادر
Dialogue: 0,0:47:37.89,0:47:39.81,نص عام,,0,0,0,,أحب العيش هنا،
Dialogue: 0,0:47:39.89,0:47:42.86,النص العام,,0,0,0,,ويمكنك المغادرة إذا كنت ضد ذلك
Dialogue: 0,0:47:45.19,0:47:46.53,نص عام,,0,0,0,,أيها اللقيط
Dialogue: 0,0:47:47.57,0:47:49.74,النص العام,,0,0,0,,تعلم أننا مرتبطون بالقدر
Dialogue: 0,0:47:50.28,0:47:52.53,نص عام,,0,0,0,,وتريدني أن أنهي كل شيء
Dialogue: 0,0:47:54.37,0:47:55.66,نص عام,,0,0,0,,جبان
Dialogue: 0,0:48:26.90,0:48:28.69,نص عام,,0,0,0,,لقد وجدت طريقة لأوكا
Dialogue: 0,0:48:28.78,0:48:32.49,general text,,0,0,0,,تجنب المبارزة وتصبح غوانغجو جيونبوغوان
Dialogue: 0,0:48:33.49,0:48:36.20,نص عام,,0,0,0,,أي واحد؟ نحن مستعدون لأي شيء
Dialogue: 0,0:48:37.58,0:48:41.83,نص عام,,0,0,0,,دعه يتزوج ابنتي تشو يونغ
Dialogue: 0,0:48:49.59,0:48:52.05,general text,,0,0,0,,عائلتنا لديها تميمة من شأنها أن تسمح
Dialogue: 0,0:48:52.13,0:48:53.97,نص عام,,0,0,0,,رفض أوامر الملك
Dialogue: 0,0:48:59.06,0:49:01.64,general text,,0,0,0,,يمكننا حتى إسقاط الملك،
Dialogue: 0,0:49:01.73,0:49:05.06,النص العام,,0,0,0,,إذا صوت جميع سحرة ديهو لهذا
Dialogue: 0,0:49:06.02,0:49:09.86,general text,,0,0,0,,هذه التميمة عهد بها إلينا المجلس الموحد
Dialogue: 0,0:49:09.94,0:49:14.49,general text,,0,0,0,,لتجنب هروب الأرواح الشريرة المختومة في جينيوون
Dialogue: 0,0:49:15.07,0:49:19.79,general text,,0,0,0,,تقترح إلغاء أمر الملك بحرمان أوكا من حقوقه
Dialogue: 0,0:49:20.37,0:49:21.75,النص العام,,0,0,0,,هل ستكون غوانغجو التالية؟
Dialogue: 0,0:49:21.83,0:49:24.29,general text,,0,0,0,,نعم، ولكن فقط إذا تزوج ابنتي
Dialogue: 0,0:49:24.92,0:49:26.79,النص العام,,0,0,0,,وسوف ينضم إلى عائلة جين
Dialogue: 0,0:49:30.59,0:49:34.30,نص عام,,0,0,0,,ولكن السيدة جين والسيد ووك مرة واحدة
Dialogue: 0,0:49:35.43,0:49:38.30,النص العام,,0,0,0,,لقد فسخت الخطبة بالفعل. أليست هذه مشكلة؟
Dialogue: 0,0:49:39.72,0:49:41.93,النص العام,,0,0,0,,ليس لأن مشاعري تجاهه قد زالت
Dialogue: 0,0:49:42.60,0:49:45.02,النص العام,,0,0,0,,مازلت أريد الزواج من أوكا
Dialogue: 0,0:49:49.40,0:49:51.73,نص عام,,0,0,0,,لم أكن أعتقد أنه سيتزوج مبكراً
Dialogue: 0,0:49:51.82,0:49:53.90,النص العام,,0,0,0,,ولست متأكدة من أنه مستعد للزواج
Dialogue: 0,0:50:03.66,0:50:06.58,النص العام,,0,0,0,,أنت بخير من أجل ابن رجل ثري
Dialogue: 0,0:50:06.67,0:50:09.79,نص عام,,0,0,0,,عندما أتحمس لشيء ما، أتعلم بسرعة
Dialogue: 0,0:50:09.88,0:50:11.09,نص عام,,0,0,0,,الآن أنا معجب بك أكثر
Dialogue: 0,0:50:12.76,0:50:15.38,النص العام,,0,0,0,,أعد النظر في رغبتك في أن تصبح تلميذي
Dialogue: 0,0:50:16.38,0:50:19.43,نص عام,,0,0,0,,سيدتي، ألم يكن لديك طالب واحد؟
Dialogue: 0,0:50:21.14,0:50:22.89,نص عام,,0,0,0,,كان هناك واحد،
Dialogue: 0,0:50:22.97,0:50:24.98,نص عام,,0,0,0,,لكنه تخلى عن العزوبة وتزوج
Dialogue: 0,0:50:26.94,0:50:28.85,نص عام,,0,0,0,,يعمل الآن في المستشفى
Dialogue: 0,0:50:36.53,0:50:38.86,النص العام,,0,0,0,,يمكنك تغيير رأيك والرفض في أي وقت
Dialogue: 0,0:50:38.95,0:50:40.07,نص عام,,0,0,0,,فكر في الأمر
Dialogue: 0,0:50:41.95,0:50:44.20,نص عام,,0,0,0,,لم آتي إلى هنا للتدريب
Dialogue: 0,0:50:44.29,0:50:46.08,general text,,0,0,0,,هل تريد حقًا إنفاق هذه القوة
Dialogue: 0,0:50:46.16,0:50:48.83,نص عام,,0,0,0,,صيد الأسماك وجمع الأعشاب؟
Dialogue: 0,0:50:54.09,0:50:57.05,general text,,0,0,0,,- مازلت لا أتحكم بها\N- نعم؟
Dialogue: 0,0:50:57.72,0:51:00.22,general text,,0,0,0,,هذه اليد ستصبح عبئاً إذا تركتها هكذا
Dialogue: 0,0:51:01.89,0:51:03.64,general text,,0,0,0,,هل تريدني أن أستهلك كل طاقتي؟
Dialogue: 0,0:51:05.60,0:51:08.69,النص العام,,0,0,0,,ثم يمكنك أن تعيش حياة عادية
Dialogue: 0,0:51:23.70,0:51:26.45,نص عام,,0,0,0,,أنا ذاهب إلى المدينة. هل ستأتي معي؟
Dialogue: 0,0:51:26.54,0:51:29.46,نص عام,,0,0,0,,لا، ليس اليوم. لا بد لي من طهي مو دوك لتناول الطعام
Dialogue: 0,0:51:30.67,0:51:33.71,نص عام,,0,0,0,,هي ليست هنا. لقد نزلت مؤخرًا إلى الجبل
Dialogue: 0,0:51:34.92,0:51:36.05,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:51:36.13,0:51:38.97,خط مائل,,0,0,0,,تشان ووك مجرد عبقري
Dialogue: 0,0:51:39.05,0:51:41.34,مائل,,0,0,0,,لقد أتقن ريوسو بالفعل
Dialogue: 0,0:51:41.43,0:51:44.01,نص عام,,0,0,0,,ويتدرب بشدة على القتال
Dialogue: 0,0:51:46.14,0:51:48.56,نص عام,,0,0,0,,فلتنتشر مثل هذه الإشاعة في جميع أنحاء المدينة
Dialogue: 0,0:51:48.64,0:51:49.69,نص عام,,0,0,0,,بجد؟
Dialogue: 0,0:51:50.39,0:51:53.15,general text,,0,0,0,,إذا لم يظهر فسوف يفقد ماء الوجه تمامًا
Dialogue: 0,0:51:54.19,0:51:57.32,general text,,0,0,0,,لذا على الأقل سيشعر بالإهانة
Dialogue: 0,0:51:58.03,0:51:59.28,نص عام,,0,0,0,,أعطني بعض الدجاج
Dialogue: 0,0:51:59.36,0:52:01.95,نص عام,,0,0,0,,غادر اليوم. هنا شعب جيونبوغوان
Dialogue: 0,0:52:02.03,0:52:03.99,خط مائل,,0,0,0,,جاء شخص مهم اليوم
Dialogue: 0,0:52:05.08,0:52:06.79,النص العام,,0,0,0,,من الأفضل عدم التقاطع معه،
Dialogue: 0,0:52:06.87,0:52:08.41,نص عام,,0,0,0,,خاصة بعد قصة التميمة
Dialogue: 0,0:52:29.39,0:52:30.27,نص عام,,0,0,0,,هيا، توقف!
Dialogue: 0,0:52:35.44,0:52:37.69,النص العام,,0,0,0,,هل أنت خادمة تشان ووك؟
Dialogue: 0,0:52:38.78,0:52:40.57,نص عام,,0,0,0,,نعم. وماذا؟
Dialogue: 0,0:52:41.36,0:52:44.78,التعليق الصوتي,,0,0,0,,ناك سو لن تنقل روحها أبدًا إلى مثل هذا الجسد
Dialogue: 0,0:52:45.95,0:52:46.99,خط مائل,,0,0,0,,مرحبًا بك
Dialogue: 0,0:52:47.66,0:52:51.04,النص العام,,0,0,0,,هل تتذكر عندما التقينا في النزل بجوار الرصيف؟
Dialogue: 0,0:53:01.05,0:53:02.84,نص عام,,0,0,0,,لا أعرف حتى
Dialogue: 0,0:53:06.97,0:53:08.26,خارج الشاشة,,0,0,0,,إنه يشتبه بي
Dialogue: 0,0:53:09.39,0:53:12.35,نص عام,,0,0,0,,أريد أن أطرح عليك بعض الأسئلة. تعال معنا إلى جيونبوغوان
Dialogue: 0,0:53:15.77,0:53:16.81,خط مائل,,0,0,0,,لنذهب
Dialogue: 0,0:53:16.90,0:53:18.98,نص عام,,0,0,0,,- دعني أذهب\N- ابقى ساكناً
Dialogue: 0,0:53:19.07,0:53:20.48,النص العام,,0,0,0,,- لماذا أنت...\N- حسنًا، قف ساكنًا
Dialogue: 0,0:53:22.90,0:53:24.03,خارج الشاشة,,0,0,0,,ليس لديها علامة زرقاء
Dialogue: 0,0:53:25.57,0:53:27.45,التعليق الصوتي,,0,0,0,,إنها على حق، أليس كذلك ناك سو؟
Dialogue: 0,0:53:29.37,0:53:32.58,نص عام,,0,0,0,,لا أعرف أين السيد
Dialogue: 0,0:53:36.13,0:53:37.33,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,0:53:41.21,0:53:42.42,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:53:43.55,0:53:45.22,النص العام,,0,0,0,,صاحب السمو، هذا أنا
Dialogue: 0,0:53:45.30,0:53:46.68,النص العام,,0,0,0,,هذا أنا وون مو دوك
Dialogue: 0,0:53:59.31,0:54:00.73,نص عام,,0,0,0,,أنت وون مو دوك
Dialogue: 0,0:54:00.82,0:54:04.24,نص عام,,0,0,0,,نعم هذا أنا. لقد أعطيتني هذا الاسم
Dialogue: 0,0:54:04.32,0:54:05.86,نص عام,,0,0,0,,أنا وون مو دوك
Dialogue: 0,0:54:08.07,0:54:10.95,نص عام,,0,0,0,,صاحب السمو، من فضلك ساعدني
Dialogue: 0,0:54:11.03,0:54:12.16,نص عام,,0,0,0,,بماذا؟
Dialogue: 0,0:54:12.75,0:54:15.87,general text,,0,0,0,,صاحب السمو، أنت لست ذكيًا فحسب، بل قوي جدًا أيضًا
Dialogue: 0,0:54:15.96,0:54:18.21,general text,,0,0,0,,وسيدي بالعكس غبي ومثير للشفقة
Dialogue: 0,0:54:18.29,0:54:20.09,النص العام,,0,0,0,,بسببه حياتي في خطر
Dialogue: 0,0:54:20.17,0:54:21.92,خط مائل,,0,0,0,,أرجو مساعدتي
Dialogue: 0,0:54:28.43,0:54:30.97,نص عام,,0,0,0,,شكرًا جزيلا لك يا صاحب السمو
Dialogue: 0,0:54:33.06,0:54:35.89,general text,,0,0,0,,ماذا يفعل سيدك الغبي والمثير للشفقة؟
Dialogue: 0,0:54:35.98,0:54:38.19,النص العام,,0,0,0,,إنه يبكي كل يوم فقط
Dialogue: 0,0:54:38.27,0:54:41.32,general text,,0,0,0,,إنه خائف منك لدرجة أنه يرتجف من الخوف
Dialogue: 0,0:54:41.40,0:54:43.15,نص عام,,0,0,0,,ويبكي في الخفاء
Dialogue: 0,0:54:43.94,0:54:46.82,general text,,0,0,0,,أرى أنك تتكلم عنه بالسوء لإرضائي
Dialogue: 0,0:54:47.74,0:54:51.24,نص عام,,0,0,0,,يمكنني أن أقول أشياء أسوأ إذا كان ذلك يجعلك سعيدًا
Dialogue: 0,0:54:52.41,0:54:56.00,general text,,0,0,0,,وون مو ديوك، لا بد أنك تعتقد أنني مثير للشفقة
Dialogue: 0,0:54:56.58,0:54:58.50,النص العام,,0,0,0,,أنت لم تمنحني هذا الاسم عبثًا
Dialogue: 0,0:54:59.08,0:55:02.38,نص عام,,0,0,0,,يمكنك أن تخبرني بكل ما تريد، لكنك لا تستطيع،
Dialogue: 0,0:55:02.46,0:55:04.21,نص عام,,0,0,0,,لأنهم كانوا يخشون أن يبدوا مثيرين للشفقة
Dialogue: 0,0:55:05.38,0:55:07.67,النص العام,,0,0,0,,هل تريد أن تكون بالوعة لفظية؟
Dialogue: 0,0:55:07.76,0:55:10.51,نص عام,,0,0,0,,هذا عنوان مرتفع جدًا بالنسبة لي
Dialogue: 0,0:55:10.59,0:55:12.39,نص عام,,0,0,0,,لكنه سيكون شرفاً لي
Dialogue: 0,0:55:14.47,0:55:16.81,نص عام,,0,0,0,,لا أحتاجك أن تخفف التوتر
Dialogue: 0,0:55:18.48,0:55:21.48,general text,,0,0,0,,صاحب السمو، لقد فعلت ما يكفي بالفعل،
Dialogue: 0,0:55:21.56,0:55:24.98,النص العام,,0,0,0,,لكن ألا يمكنك أن تأمر هؤلاء الأشخاص بعدم أخذي؟
Dialogue: 0,0:55:25.65,0:55:27.11,نص عام,,0,0,0,,التحذير يكفي
Dialogue: 0,0:55:35.04,0:55:36.37,نص عام,,0,0,0,,خذ هذا
Dialogue: 0,0:55:37.83,0:55:39.04,خط مائل,,0,0,0,,هذا هو حقيبتي
Dialogue: 0,0:55:39.12,0:55:40.29,ملاحظات,,0,0,0,,الكيس - وسادة من الورق أو القماش (كيس) مع حشوة عطرية فضفاضة
Dialogue: 0,0:55:40.37,0:55:43.67,general text,,0,0,0,,أظهر هذا إذا كان سيدك المثير للشفقة يوقعك في المشاكل مرة أخرى
Dialogue: 0,0:55:44.63,0:55:47.01,نص عام,,0,0,0,,شكرًا جزيلا لك
Dialogue: 0,0:55:52.97,0:55:54.81,النص العام,,0,0,0,,رائحته مثل القرفة
Dialogue: 0,0:55:54.89,0:55:56.68,general text,,0,0,0,,لماذا لديك هذا الوجه؟
Dialogue: 0,0:55:56.77,0:55:58.85,نص عام,,0,0,0,,ماذا؟ لا يعجبك؟
Dialogue: 0,0:55:58.93,0:56:01.48,نص عام,,0,0,0,,لا، أنا حقًا أحب ذلك
Dialogue: 0,0:56:02.19,0:56:03.69,general text,,0,0,0,,- إذا لم يعجبك أرجعه {\i1}\N- لا
Dialogue: 0,0:56:03.77,0:56:05.82,النص العام,,0,0,0,,لقد لوثتها بنفسي بالفعل
Dialogue: 0,0:56:07.15,0:56:09.86,نص عام,,0,0,0,,أشكرك على هذه الهدية الرائعة الرائحة
Dialogue: 0,0:56:11.78,0:56:14.91,النص العام,,0,0,0,,دعني أسكب لك مشروبًا رائحته طيبة أيضًا
Dialogue: 0,0:56:25.17,0:56:26.59,مائل,,0,0,0,,هذا نبيذ بالقرفة والزنجبيل
Dialogue: 0,0:56:26.67,0:56:27.96,نص عام,,0,0,0,,هناك الكثير من القرفة
Dialogue: 0,0:56:30.05,0:56:32.55,نص عام,,0,0,0,,ربما لا يعجبك. أعد الكيس
Dialogue: 0,0:56:33.18,0:56:34.18,نص عام,,0,0,0,,لا
Dialogue: 0,0:56:34.26,0:56:35.47,نص عام,,0,0,0,,أعجبني
Dialogue: 0,0:56:45.56,0:56:47.86,النص العام,,0,0,0,,- لذيذ؟\N- جداً
Dialogue: 0,0:56:47.94,0:56:48.90,نص عام,,0,0,0,,اشرب أكثر
Dialogue: 0,0:56:56.99,0:56:59.87,general text,,0,0,0,,ربما ذهب "مو دوك" إلى "تشويسونغ رو". ليس لديها مكان آخر تذهب إليه
Dialogue: 0,0:57:00.41,0:57:02.16,النص العام,,0,0,0,,هل غضبت ورحلت؟
Dialogue: 0,0:57:03.25,0:57:04.83,نص عام,,0,0,0,,أي نوع من الخادمة هذه؟
Dialogue: 0,0:57:05.50,0:57:07.13,نص عام,,0,0,0,,إنها ليست مجرد خادمة
Dialogue: 0,0:57:07.75,0:57:11.09,general text,,0,0,0,,إذا لم تكن مجرد خادمة فمن؟
Dialogue: 0,0:57:12.01,0:57:14.43,نص عام,,0,0,0,,مو دوك مثل البيضة
Dialogue: 0,0:57:14.51,0:57:16.14,نص عام,,0,0,0,,يجب حمايتها
Dialogue: 0,0:57:17.14,0:57:19.72,مائل,,0,0,0,,- دعنا نذهب ونلقي نظرة\N- ماذا هناك؟
Dialogue: 0,0:57:19.81,0:57:21.93,مائل,,0,0,0,,لقد عثروا على جثة أحد البدو
Dialogue: 0,0:57:22.02,0:57:23.81,خط مائل,,0,0,0,,- جثة البدو؟\N- أين؟
Dialogue: 0,0:57:26.77,0:57:29.57,مائل,,0,0,0,,- دعني ألقي نظرة\N- ماذا حدث؟
Dialogue: 0,0:57:29.65,0:57:31.44,خط مائل,,0,0,0,,- السماء المقدسة\N- رعب
Dialogue: 0,0:57:31.53,0:57:34.36,خط مائل,,0,0,0,,كابوس
Dialogue: 0,0:57:38.28,0:57:40.29,نص عام,,0,0,0,,هذا ليس بدوياً
Dialogue: 0,0:57:40.37,0:57:42.29,general text,,0,0,0,,لكنه مات بسببه
Dialogue: 0,0:57:43.00,0:57:44.50,نص عام,,0,0,0,,هل تعلم عن البدو؟
Dialogue: 0,0:57:44.58,0:57:47.13,general text,,0,0,0,,عندما يفقد البدو عقولهم يمتصون طاقة الناس
Dialogue: 0,0:57:47.71,0:57:49.67,general text,,0,0,0,,لهذا السبب تم تحريم كيمياء النفوس،
Dialogue: 0,0:57:49.75,0:57:52.13,النص العام,,0,0,0,,وبدأ القبض على البدو وقتلهم
Dialogue: 0,0:58:03.68,0:58:05.60,general text,,0,0,0,,هل يفقد كل البدو عقولهم؟
Dialogue: 0,0:58:05.69,0:58:07.94,النص العام,,0,0,0,,فقط أولئك الذين لا يتحدثون هوانسو
Dialogue: 0,0:58:08.65,0:58:11.82,general text,,0,0,0,,هل يستطيع الإنسان أن يصل إلى هذا المستوى؟
Dialogue: 0,0:58:11.90,0:58:13.11,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:58:13.99,0:58:17.28,general text,,0,0,0,,هل تريد أن تصبح تلميذي وتصل إلى هذا المستوى؟
Dialogue: 0,0:58:17.86,0:58:20.49,النص العام,,0,0,0,,أنت لست ذكيًا وقوي البنية فحسب،
Dialogue: 0,0:58:20.58,0:58:22.45,نص عام,,0,0,0,,لديك كل ما تحتاجه لهذا الغرض
Dialogue: 0,0:58:23.37,0:58:26.79,general text,,0,0,0,,شكرًا على الإطراء، لكني لا أريد أن أقطع نذر العزوبة.
Dialogue: 0,0:58:26.87,0:58:28.08,نص عام,,0,0,0,,إذا أصبحت تلميذي،
Dialogue: 0,0:58:28.17,0:58:30.67,نص عام,,0,0,0,,سوف أساعدك على خلع هذا السوار
Dialogue: 0,0:58:31.25,0:58:32.34,نص عام,,0,0,0,"يا معلمة"
Dialogue: 0,0:58:33.92,0:58:34.76,نص عام,,0,0,0,,كرر
Dialogue: 0,0:58:35.67,0:58:37.59,نص عام,,0,0,0,,من فضلك توقف عن إقناعي
Dialogue: 0,0:58:38.18,0:58:40.68,خط مائل,,0,0,0,,نحن من جيونبوغوان، أفسحوا الطريق
Dialogue: 0,0:58:42.81,0:58:45.68,نص عام,,0,0,0,,أنا بحاجة للذهاب. لا أستطيع أن أكون في أعينهم
Dialogue: 0,0:59:00.53,0:59:02.28,خط مائل,,0,0,0,,انظر هناك
Dialogue: 0,0:59:02.37,0:59:03.91,خط مائل,,0,0,0,,- أهذا قوس قزح؟\N- أين؟
Dialogue: 0,0:59:03.99,0:59:06.62,خط مائل,,0,0,0,,إنه قوس قزح
Dialogue: 0,0:59:06.71,0:59:09.04,مائل,,0,0,0,,- إنه حقًا قوس قزح\N- الجمال
Dialogue: 0,0:59:09.12,0:59:12.21,خط مائل,,0,0,0,,- انظر\N- كم مضى على رحيلها
Dialogue: 0,0:59:13.38,0:59:14.76,خط مائل,,0,0,0,,- بيوتي\N- ألقِ نظرة
Dialogue: 0,0:59:14.84,0:59:17.13,مائل,,0,0,0,,- إنه حقًا قوس قزح{\i0}\N- أين ذهبت العربة؟
Dialogue: 0,0:59:18.13,0:59:19.72,مائل,,0,0,0,,كانت هنا منذ دقيقة
Dialogue: 0,0:59:20.26,0:59:23.06,مائل,,0,0,0,,- أين ذهبت؟\N- أين العربة؟
Dialogue: 0,0:59:52.58,0:59:55.17,general text,,0,0,0,,إنه لأمر مدهش أن نسمع صدى صوتك في Danhyangok
Dialogue: 0,0:59:57.05,0:59:58.17,نص عام,,0,0,0,,ممتاز
Dialogue: 0,1:00:01.13,1:00:04.22,نص عام,,0,0,0,,ماذا؟ هل مو دوك سكران؟
Dialogue: 0,1:00:04.30,1:00:06.35,نص عام,,0,0,0,,هل تقول أنها كانت تشرب هنا؟
Dialogue: 0,1:00:06.43,1:00:08.60,النص العام,,0,0,0,,كادوا أن يأخذوها إلى جيونبوغوان اليوم
Dialogue: 0,1:00:09.56,1:00:12.56,general text,,0,0,0,,ولكن لحسن الحظ أنقذها ولي العهد
Dialogue: 0,1:00:14.90,1:00:16.36,نص عام,,0,0,0,,- ولي العهد؟{\i1}\N- نعم
Dialogue: 0,1:00:16.44,1:00:18.15,نص عام,,0,0,0,,لقد كانت جيدة في إضحاكه
Dialogue: 0,1:00:18.24,1:00:19.82,مائل,,0,0,0,,وجدت طريقة للوصول إليه
Dialogue: 0,1:00:19.90,1:00:22.82,النص العام,,0,0,0,,شربت كل الكؤوس التي قدمها لها
Dialogue: 0,1:00:28.04,1:00:28.95,نص عام,,0,0,0,,أين هي؟
Dialogue: 0,1:00:57.77,1:00:59.69,نص عام,,0,0,0,,سكران كالجحيم
Dialogue: 0,1:01:00.82,1:01:02.86,النص العام,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,1:01:06.45,1:01:09.37,نص عام,,0,0,0,,يا طالبي، لقد أتيت من أجلي
Dialogue: 0,1:01:11.25,1:01:13.75,نص عام,,0,0,0,,نعم جئت لأجلك يا معلم
Dialogue: 0,1:01:15.04,1:01:17.79,نص عام,,0,0,0,,أنا لا أتحكم في جسدي
Dialogue: 0,1:01:18.38,1:01:20.46,نص عام,,0,0,0,,لا أستطيع حتى أن أبقي رأسي مستقيماً
Dialogue: 0,1:01:21.01,1:01:24.13,general text,,0,0,0,,هذا لم يحدث من قبل مهما شربت
Dialogue: 0,1:01:25.84,1:01:27.80,النص العام,,0,0,0,,أنت لم تعد محاربًا ماهرًا،
Dialogue: 0,1:01:28.93,1:01:30.10,نص عام,,0,0,0,,لكن مو دوك فقط
Dialogue: 0,1:01:37.36,1:01:39.94,نص عام,,0,0,0,,لا أستطيع حتى أن أشرب
Dialogue: 0,1:02:01.25,1:02:03.88,نص عام,,0,0,0,,أريد أن أترك كل شيء وأعيش حياة هادئة
Dialogue: 0,1:02:06.72,1:02:08.30,نص عام,,0,0,0,,لكن هناك شيء يزعجني
Dialogue: 0,1:02:34.79,1:02:37.37,نص عام,,0,0,0,,ظننت أنني سقطت من ارتفاع كبير
Dialogue: 0,1:02:39.08,1:02:40.96,نص عام,,0,0,0,,ولكن أعتقد أنه لم يكن مرتفعًا إلى هذا الحد
Dialogue: 0,1:02:50.51,1:02:51.93,ذكريات,,0,0,0,,يبدو أنني كسرت ساقي
Dialogue: 0,1:02:52.51,1:02:53.72,ذكريات,,0,0,0,,ساعدني
Dialogue: 0,1:02:54.47,1:02:58.31,الذكريات,,0,0,0,,رأيتك تستخدم هذا لتنادي طائرك
Dialogue: 0,1:03:00.73,1:03:02.02,ذكريات بخط مائل,,0,0,0,,أريد تجربتها أيضًا
Dialogue: 0,1:03:02.11,1:03:04.53,ذكريات,,0,0,0,,هل يمكنني الحصول عليها؟
Dialogue: 0,1:03:19.96,1:03:21.79,نص عام,,0,0,0,,جئت لأعيدها إليك
Dialogue: 0,1:03:53.91,1:03:55.49,خط مائل,,0,0,0,,مو دوك
Dialogue: 0,1:03:55.78,1:03:56.95,نص عام,,0,0,0,,رأيت مو دوك
Dialogue: 0,1:04:02.24,1:04:03.74,خط مائل,,0,0,0,,إنها هنا حقًا
Dialogue: 0,1:04:04.83,1:04:05.66,مائل,,0,0,0,,أين تقع المملكة المتحدة؟
Dialogue: 0,1:04:06.45,1:04:07.91,خط مائل,,0,0,0,,قلت لك ألا تهرب
Dialogue: 0,1:04:09.92,1:04:11.25,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,1:04:11.33,1:04:12.54,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,1:04:12.63,1:04:14.55,نص عام,,0,0,0,,لم نجدك في قرية ساري،
Dialogue: 0,1:04:14.63,1:04:17.13,نص عام,,0,0,0,,لذلك جئنا إلى هنا للبحث عنك
Dialogue: 0,1:04:17.72,1:04:19.80,خط مائل,,0,0,0,,جو وول كان على حق، أنت هنا حقًا
Dialogue: 0,1:04:19.88,1:04:22.30,نص عام,,0,0,0,,كيف حالك يا مو دوك؟
Dialogue: 0,1:04:23.26,1:04:24.43,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:04:50.00,1:04:52.96,general text,,0,0,0,,مو دوك، ربما تكون سعيدًا برؤيتنا
Dialogue: 0,1:04:56.34,1:04:57.30,نص عام,,0,0,0,,إنها في حالة سكر
Dialogue: 0,1:04:58.42,1:05:00.05,نص عام,,0,0,0,,هل شربت؟
Dialogue: 0,1:05:00.13,1:05:01.68,نص عام,,0,0,0,,- نعم{\i1}\N- رأيت
Dialogue: 0,1:05:02.26,1:05:03.60,نص عام,,0,0,0,,ساعدها على النهوض
Dialogue: 0,1:05:04.18,1:05:05.18,نص عام,,0,0,0,,ارفعها
Dialogue: 0,1:05:14.98,1:05:17.40,النص العام,,0,0,0,,كان مو دوك يأتي إلى دانهيانغك لجمع الأعشاب الطبية
Dialogue: 0,1:05:17.48,1:05:20.70,نص عام,,0,0,0,,السيد لي يعيش هنا، لقد سمح لنا بالتوقف هنا
Dialogue: 0,1:05:20.78,1:05:23.16,النص العام,,0,0,0,,لا أستطيع أن أصدق أن مو ديوك سُكر بمفرده
Dialogue: 0,1:05:23.24,1:05:24.57,خط مائل,,0,0,0,,إنها تعيش بشكل جيد
Dialogue: 0,1:05:25.24,1:05:27.33,نص عام,,0,0,0,,لم أكن أعلم بوجود مكان كهذا في دانهيانغوك
Dialogue: 0,1:05:27.95,1:05:29.33,نص عام,,0,0,0,,هل تعلم عن دانهيانغوك؟
Dialogue: 0,1:05:29.41,1:05:31.58,نص عام,,0,0,0,,كان يأتي إلى هنا كثيرًا
Dialogue: 0,1:05:31.66,1:05:34.54,general text,,0,0,0,,لقد حصل عليه لأنه يهرب باستمرار
Dialogue: 0,1:05:34.63,1:05:35.71,مائل,,0,0,0,,يول؟
Dialogue: 0,1:05:36.21,1:05:38.34,مائل,,0,0,0,,كان مهووسًا بالطيور
Dialogue: 0,1:05:38.42,1:05:40.88,نص عام,,0,0,0,,لماذا أتيت إلى هنا وحدك؟
Dialogue: 0,1:05:40.97,1:05:42.47,نص عام,,0,0,0,,حتى أنك آذيت ساقك هنا
Dialogue: 0,1:05:45.09,1:05:46.72,نص عام,,0,0,0,,لأنني أردت رؤيتهم
Dialogue: 0,1:05:51.43,1:05:53.35,نص عام,,0,0,0,,لم أهتم بالساق المكسورة
Dialogue: 0,1:05:54.40,1:05:56.23,general text,,0,0,0,,ولم أخاف أن يوبخوني
Dialogue: 0,1:05:59.65,1:06:01.49,نص عام,,0,0,0,,لقد أحببتهم كثيراً
Dialogue: 0,1:06:16.67,1:06:19.13,خط مائل,,0,0,0,,إنه يحب الطيور حقًا
Dialogue: 0,1:06:19.96,1:06:22.76,النص العام,,0,0,0,,بالمناسبة، أي نوع من الشاي هذا؟
Dialogue: 0,1:06:22.84,1:06:25.51,النص العام,,0,0,0,,- الرائحة لطيفة جداً\N- هل شربتها؟
Dialogue: 0,1:06:27.93,1:06:30.06,نص عام,,0,0,0,,نعم ولكن ماذا؟ هل هو مفيد؟
Dialogue: 0,1:06:31.06,1:06:31.93,نص عام,,0,0,0,,بالطبع
Dialogue: 0,1:06:32.02,1:06:34.02,نص عام,,0,0,0,,مصنوعة من الأعشاب الطبية،
Dialogue: 0,1:06:34.10,1:06:36.52,نص عام,,0,0,0,,التي تنمو فقط في دانهيانغوك
Dialogue: 0,1:06:36.60,1:06:37.69,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,1:06:37.77,1:06:39.86,general text,,0,0,0,,- يول، جرب ذلك أيضًا...\N- لا تشرب...
Dialogue: 0,1:06:40.36,1:06:41.40,نص عام,,0,0,0,,حسنًا، ساعد نفسك
Dialogue: 0,1:06:41.48,1:06:43.74,نص عام,,0,0,0,,- الرائحة لطيفة حقاً\N- أخبرني؟
Dialogue: 0,1:06:46.20,1:06:47.78,نص عام,,0,0,0,,هذا شاي العفة
Dialogue: 0,1:06:49.20,1:06:50.24,خط مائل,,0,0,0,,ماذا؟ العفة؟
Dialogue: 0,1:06:50.33,1:06:52.91,نص عام,,0,0,0,,لن تتمكن من...
Dialogue: 0,1:06:54.62,1:06:57.54,general text,,0,0,0,,- هل هذا شاي الحوذان؟\N- لا أعرف بالضبط
Dialogue: 0,1:06:58.21,1:06:59.25,خط مائل,,0,0,0,,حسنًا...
Dialogue: 0,1:06:59.34,1:07:02.26,النص العام,,0,0,0,,هناك الكثير من الأعشاب المختلفة، يمكنك شربها
Dialogue: 0,1:07:04.05,1:07:05.05,نص عام,,0,0,0,,لذيذ
Dialogue: 0,1:07:08.76,1:07:10.26,نص عام,,0,0,0,,لصحتك
Dialogue: 0,1:07:41.46,1:07:43.67,نص عام,,0,0,0,,مجموعة من الرجال المشبوهين وتميمة؟
Dialogue: 0,1:07:44.26,1:07:45.13,نص عام,,0,0,0,,نعم
Dialogue: 0,1:07:45.21,1:07:47.13,مائل,,0,0,0,,هل فقدت تميمةك حقًا؟
Dialogue: 0,1:07:47.22,1:07:49.55,general text,,0,0,0,,هل سرقها منك أحد أم أقرضتها لشخص ما؟
Dialogue: 0,1:07:49.64,1:07:51.85,نص عام,,0,0,0,,لا، لقد فقدتها
Dialogue: 0,1:07:51.93,1:07:54.47,نص عام,,0,0,0,,هل تتذكر أين ومتى حدث هذا؟
Dialogue: 0,1:07:56.31,1:07:57.14,نص عام,,0,0,0,,لا
Dialogue: 0,1:07:57.23,1:07:59.73,نص عام,,0,0,0,,وجدناه عندما كنا نحقق في قضية البدو
Dialogue: 0,1:07:59.81,1:08:01.65,نص عام,,0,0,0,,هذا مهم وخطير جداً
Dialogue: 0,1:08:09.66,1:08:13.03,مائل,,0,0,0,,زفاف جين جو يونغ وتشان ووك؟
Dialogue: 0,1:08:13.62,1:08:16.16,نص عام,,0,0,0,,فكرة رائعة
Dialogue: 0,1:08:16.25,1:08:20.46,general text,,0,0,0,,لكن من يتزوج يجب أن يحب بعضه البعض
Dialogue: 0,1:08:20.54,1:08:24.25,general text,,0,0,0,,لا يستطيع أن يتزوج من لا يحبه فقط لحل المشكلة
Dialogue: 0,1:08:24.34,1:08:28.22,نص عام,,0,0,0,,من سيتحدث عن الحب! طوال حياتي أنا مثل شجرة وحيدة في الحقل. كلاهما!
Dialogue: 0,1:08:29.09,1:08:31.80,نص عام,,0,0,0,,الزفاف ليس مزحة
Dialogue: 0,1:08:31.89,1:08:33.43,نص عام,,0,0,0,,وأنا أيضاً شعرت بالحب
Dialogue: 0,1:08:33.51,1:08:34.60,نص عام,,0,0,0,,كان يا مكان
Dialogue: 0,1:08:34.68,1:08:38.35,النص العام,,0,0,0,,ابتعدت عن السيد بسبب الحب
Dialogue: 0,1:08:38.43,1:08:40.98,نص عام,,0,0,0,,وذهب كل ذلك سدى
Dialogue: 0,1:08:41.06,1:08:42.19,نص عام,,0,0,0,,فلنسرع
Dialogue: 0,1:08:42.98,1:08:43.94,نص عام,,0,0,0,,الزواج
Dialogue: 0,1:08:49.36,1:08:51.11,general text,,0,0,0,,دمر شخص مجهول حاجزنا ودخل
Dialogue: 0,1:08:55.83,1:08:59.29,النص العام,,0,0,0,,هو يوم، اخرج وألقي التحية
Dialogue: 0,1:08:59.37,1:09:03.17,نص عام,,0,0,0,,من يجرؤ على مناداتي بالاسم؟
Dialogue: 0,1:09:07.96,1:09:09.01,نص عام,,0,0,0,,يوم
Dialogue: 0,1:09:10.26,1:09:11.59,نص عام,,0,0,0,,كيف حالك؟
Dialogue: 0,1:09:12.64,1:09:13.55,نص عام,,0,0,0,,يا معلمة...
Dialogue: 0,1:09:14.39,1:09:15.43,نص عام,,0,0,0,,يا معلمة
Dialogue: 0,1:09:16.14,1:09:17.18,نص عام,,0,0,0,,يا معلم!
Dialogue: 0,1:09:18.72,1:09:19.73,نص عام,,0,0,0,,يا معلمة...
Dialogue: 0,1:09:19.81,1:09:21.77,نص عام,,0,0,0,,أستاذتي
Dialogue: 0,1:09:24.94,1:09:26.82,النص العام,,0,0,0,,أنزلوا سيوفكم! الآن!
Dialogue: 0,1:09:49.55,1:09:50.72,مائل,,0,0,0,,مو دوك
Dialogue: 0,1:09:51.51,1:09:54.30,نص عام,,0,0,0,,ظننتك نائماً. بحثت في كل مكان
Dialogue: 0,1:09:54.39,1:09:56.22,general text,,0,0,0,,هل مازلت سكراناً؟
Dialogue: 0,1:09:56.93,1:09:59.52,النص العام,,0,0,0,,اعتقدت في حالة سكر أنه يمكنني التسلق عليه
Dialogue: 0,1:10:00.64,1:10:04.15,نص عام,,0,0,0,,لكنه مرتفع هنا. أعتقد أنني قادم إلى روحي
Dialogue: 0,1:10:04.81,1:10:07.77,general text,,0,0,0,,هل هذه هي الشجرة التي يوجد العش في الأعلى؟
Dialogue: 0,1:10:07.86,1:10:08.90,نص عام,,0,0,0,,نعم
Dialogue: 0,1:10:10.36,1:10:12.40,نص عام,,0,0,0,,أريد أن أتسلق هذه الشجرة مرة أخرى
Dialogue: 0,1:10:13.78,1:10:17.20,general text,,0,0,0,,هل صعدت فعلاً إلى القمة؟
Dialogue: 0,1:10:18.41,1:10:20.16,نص عام,,0,0,0,,كنت ناك سو حينها
Dialogue: 0,1:10:21.79,1:10:24.75,النص العام,,0,0,0,,القمر من هناك مذهل بكل بساطة
Dialogue: 0,1:10:26.00,1:10:28.29,نص عام,,0,0,0,,لكنني لن أراها مرة أخرى
Dialogue: 0,1:10:30.42,1:10:32.51,نص عام,,0,0,0,,قابلت الرجل دان تشو اليوم
Dialogue: 0,1:10:33.17,1:10:34.68,نص عام,,0,0,0,,يبدو أنه اشتبه بي
Dialogue: 0,1:10:35.59,1:10:38.30,general text,,0,0,0,,هل أعطيتهم تميمة روحي؟
Dialogue: 0,1:10:38.39,1:10:40.60,نص عام,,0,0,0,,حاولت استخدامه للعودة
Dialogue: 0,1:10:41.39,1:10:44.06,general text,,0,0,0,,لكنه قتل من أخطأ في حقي
Dialogue: 0,1:10:47.06,1:10:49.11,نص عام,,0,0,0,,إذا قبضوا علي،
Dialogue: 0,1:10:50.02,1:10:51.36,نص عام,,0,0,0,,لا تحاول إنقاذي
Dialogue: 0,1:10:53.40,1:10:55.49,نص عام,,0,0,0,,بالطبع. أنا ضعيف جدًا على أي حال
Dialogue: 0,1:10:57.82,1:11:00.58,نص عام,,0,0,0,,لا يستطيع طالبك أن يفعل أي شيء من أجلك
Dialogue: 0,1:11:04.12,1:11:05.50,نص عام,,0,0,0,,لم أتوقع شيئًا
Dialogue: 0,1:11:09.21,1:11:10.29,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,1:11:10.96,1:11:13.88,نص عام,,0,0,0,,لا أستطيع فعل الكثير، لكني أستطيع تسلق شجرة
Dialogue: 0,1:11:14.76,1:11:17.55,نص عام,,0,0,0,,ليس هناك فروع في الأعلى لتقف عليها
Dialogue: 0,1:11:18.55,1:11:20.60,النص العام,,0,0,0,,يجب علينا استخدام الطاقة لإنشاء موطئ قدم
Dialogue: 0,1:11:21.22,1:11:23.68,النص العام,,0,0,0,,لهذا عليك إتقان تشيسا
Dialogue: 0,1:11:24.31,1:11:26.02,النص العام,,0,0,0,,أنت تهتم بهذا مثل القمر
Dialogue: 0,1:11:26.10,1:11:27.90,نص عام,,0,0,0,,لم أرغب في فعل أي شيء،
Dialogue: 0,1:11:28.69,1:11:30.52,نص عام,,0,0,0,,لكنني أريد أن أتسلق هذه الشجرة
Dialogue: 0,1:11:36.95,1:11:38.74,نص عام,,0,0,0,,قلت أنك تريد النظر إلى القمر من هناك
Dialogue: 0,1:11:38.82,1:11:40.99,general text,,0,0,0,,أنا الوحيد الذي يمكنه المساعدة في هذا الأمر،
Dialogue: 0,1:11:41.58,1:11:42.99,نص عام,,0,0,0,,لذلك سأحاول
Dialogue: 0,1:11:44.04,1:11:45.62,نص عام,,0,0,0,,هل تريد الصعود؟
Dialogue: 0,1:11:47.71,1:11:50.67,النص العام,,0,0,0,,نحن بحاجة إلى السيطرة على تشيسا، لقد أخبرتك بذلك
Dialogue: 0,1:11:52.38,1:11:53.92,نص عام,,0,0,0,,هل تريد ذلك أم لا؟
Dialogue: 0,1:11:59.22,1:12:00.97,نص عام,,0,0,0,,إذن ساعدني
Dialogue: 0,1:12:02.22,1:12:03.72,نص عام,,0,0,0,,اصعد إلى هناك
Dialogue: 0,1:12:05.73,1:12:06.98,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:12:07.06,1:12:10.31,نص عام,,0,0,0,,سأخذك إلى أعلى هذه الشجرة
Dialogue: 0,1:12:53.69,1:12:56.78,preview,,0,0,0,,كيف حالك مع أوكا؟
Dialogue: 0,1:12:56.86,1:12:59.53,preview,,0,0,0,,هل تعرف من هو والدي الحقيقي؟
Dialogue: 0,1:12:59.61,1:13:02.24,preview,,0,0,0,,لا أحد يتوقع منك أن تقاتله
Dialogue: 0,1:13:02.32,1:13:05.45,preview,,0,0,0,,الخطوة التالية قد تقربه من الموت
Dialogue: 0,1:13:05.53,1:13:07.66,preview,,0,0,0,,هل يعلم سيدك بهذا؟
Dialogue: 0,1:13:07.75,1:13:10.83,preview,,0,0,0,,هل قابلت ناك سو عندما كنت طفلاً؟
Dialogue: 0,1:13:10.92,1:13:12.29,معاينة,,0,0,0,,لا أعرف اسمها أو عمرها
Dialogue: 0,1:13:12.38,1:13:14.25,معاينة,,0,0,0,,فقط المكان الذي نظرنا منه إلى الطيور
Dialogue: 0,1:13:14.34,1:13:15.88,معاينة,,0,0,0,,لا أعرف أين عاشت
Dialogue: 0,1:13:15.96,1:13:18.13,معاينة,,0,0,0,,عائلة جين تعيش هنا
Dialogue: 0,1:13:18.21,1:13:20.97,معاينة,,0,0,0,,ابنة السيدة جين تتزوج
Dialogue: 0,1:13:21.05,1:13:23.84,معاينة,,0,0,0,,ماذا تفعل أيها المعلم؟ الزواج؟
Dialogue: 0,1:13:23.93,1:13:26.64,preview,,0,0,0,,ليست خطتي أن أكون خادمتك إلى الأبد

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
