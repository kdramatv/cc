Dialog: 0,0:02:47.24,0:02:52.24,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.24,0:02:57.24,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.24,0:03:02.24,nicks,,0,0,0,,Penterjemah penaip:{\c&HFFF4C5&} Ria_Lee, Mina_Mi, Zero Amamiya
Dialog: 0,0:00:51.18,0:00:56.44,teks am,,0,0,0,,Bu Young, di manakah anda merasakan kuasa batu ais itu?
Dialog: 0,0:00:56.52,0:00:57.64,teks umum,,0,0,0,,Bapa
Dialog: 0,0:00:57.73,0:00:58.94,teks umum,,0,0,0,,Kami dekat
Dialog: 0,0:01:00.27,0:01:03.57,teks umum,,0,0,0,,Batu di suatu tempat berdekatan di bawah air
Dialog: 0,0:01:10.12,0:01:13.29,teks umum,,0,0,0,,Adakah anda benar-benar fikir dia menemui batu ais itu?
Dialog: 0,0:01:13.87,0:01:14.95,teks umum,,0,0,0,,Ya, sepatutnya dia
Dialog: 0,0:01:15.91,0:01:17.58,teks umum,,0,0,0,,10 tahun lalu cikgu Chang Gan
Dialog: 0,0:01:17.67,0:01:20.29,teks umum,,0,0,0,,menyembunyikan batu itu di sini di Tasik Gyeongcheongdaeho
Dialog: 0,0:01:20.38,0:01:23.30,teks umum,,0,0,0,,Dan kini batu itu ditemui oleh seorang gadis yang dilahirkan
Dialog: 0,0:01:23.88,0:01:25.67,teks umum,,0,0,0,,menggunakan kuasa batu
Dialog: 0,0:01:27.01,0:01:30.76,teks umum,,0,0,0,,Saya pasti Boo Young ialah anak perempuan Chang Gun
Dialog: 0,0:01:31.64,0:01:34.10,teks umum,,0,0,0,,Ini menerangkan sebab dia menyelamatkannya dengan sihir
Dialog: 0,0:01:35.77,0:01:37.43,teks umum,,0,0,0,,Awak tak suka dia ke?
Dialog: 0,0:01:46.94,0:01:48.57,teks umum,,0,0,0,,Terima kasih kepada gadis ini
Dialog: 0,0:01:48.65,0:01:51.78,teks umum,,0,0,0,,tidak bernilai, saya dapat berkahwin
Dialog: 0,0:01:52.87,0:01:55.24,teks umum,,0,0,0,,anak perempuan keluarga Jin
Dialog: 0,0:01:57.33,0:01:59.04,teks umum,,0,0,0,,Saya rasa saya patut bersyukur
Dialog: 0,0:02:02.17,0:02:05.96,teks umum,,0,0,0,,Di sini. Batu itu betul-betul di bawah kami
Dialog: 0,0:02:17.85,0:02:20.60,di sebalik tabir,,0,0,0,, Kompleks dan cemburu ayah,
Dialog: 0,0:02:20.69,0:02:23.44,luar skrin,,0,0,0,,menyebabkan Jin Bu Young mati
Dialog: 0,0:02:25.90,0:02:27.15,teks umum,,0,0,0,,Sesuai dengan anda
Dialog: 0,0:02:28.19,0:02:31.41,teks umum,,0,0,0,,Jika kamu suka, maka saya suka, ibu
Dialog: 0,0:02:33.37,0:02:35.16,italic,,0,0,0,,Jom cuba yang lain
Dialog: 0,0:02:38.75,0:02:40.37,di sebalik tabir,,0,0,0,,Kekuatan luar biasa Jin Bu Young
Dialog: 0,0:02:40.96,0:02:43.50,di sebalik tabir,,0,0,0,,dia mendapatnya bukan sahaja daripada ibunya, ahli keluarga Jin
Dialog: 0,0:02:44.42,0:02:48.88,di sebalik tabir,,0,0,0,,Dia juga kuat terima kasih kepada darah bapanya, keturunan keluarga Choi yang terkorban
Dialog: 0,0:02:52.26,0:02:55.26,di sebalik tabir,,0,0,0,,Abang dan kakak Choi, yang mencari rezeki dari tilik,
Dialog: 0,0:02:55.85,0:02:58.72,di sebalik tabir,,0,0,0,,adalah keturunan ahli silap mata Choi, orang pertama yang melakukan
Dialog: 0,0:02:58.81,0:03:00.56,di sebalik tabir,,0,0,0,,alkimia jiwa
Dialog: 0,0:03:03.27,0:03:05.56,suara,,0,0,0,,Jin Bu Young adalah keturunan kedua-dua keluarga,
Dialog: 0,0:03:05.65,0:03:09.32,suara,,0,0,0,,yang menjadikannya paderi wanita terkuat yang pernah dilihat di dunia
Dialog: 0,0:03:10.69,0:03:12.24,teks umum,,0,0,0,,Anda akhirnya menemuinya
Dialog: 0,0:03:13.32,0:03:14.16,teks umum,,0,0,0,,Boo Young,
Dialog: 0,0:03:14.74,0:03:16.12,teks umum,,0,0,0,,beri saya batu
Dialog: 0,0:03:28.30,0:03:29.46,teks umum,,0,0,0,,Kembalikan!
Dialog: 0,0:03:34.76,0:03:35.80,teks umum,,0,0,0,,Bu Young...
Dialog: 0,0:03:36.39,0:03:38.18,teks umum,,0,0,0,,Boo Young
Dialog: 0,0:03:40.06,0:03:41.14,teks umum,,0,0,0,,Bu Young!
Dialog: 0,0:04:07.17,0:04:08.84,teks umum,,0,0,0,,Makan
Dialog: 0,0:04:09.92,0:04:11.34,teks umum,,0,0,0,,Sini, pegang sudu
Dialog: 0,0:04:12.51,0:04:14.63,teks umum,,0,0,0,,Sayangnya awak buta
Dialog: 0,0:04:14.72,0:04:17.43,teks umum,,0,0,0,,Perkara yang paling teruk ialah anda tidak ingat nama anda
Dialog: 0,0:04:19.89,0:04:22.02,teks umum,,0,0,0,,Adakah anda mahu tinggal bersama saya?
Dialog: 0,0:04:22.89,0:04:26.65,teks umum,,0,0,0,,Nama cucu saya yang meninggal ialah Mu Dok
Dialog: 0,0:04:26.73,0:04:27.90,teks umum,,0,0,0,,Boleh saya panggil awak begitu?
Dialog: 0,0:04:30.48,0:04:31.98,teks umum,,0,0,0,,Okey
Dialog: 0,0:04:32.07,0:04:33.61,teks umum,,0,0,0,,Mulai sekarang anda adalah Moo Deok
Dialog: 0,0:04:34.53,0:04:36.15,teks umum,,0,0,0,,Sungguh manis
Dialog: 0,0:04:36.24,0:04:38.12,italic,,0,0,0,,Jom makan
Dialog: 0,0:04:44.16,0:04:45.54,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:05:28.17,0:05:29.33,teks umum,,0,0,0,,Ibu
Dialog: 0,0:05:36.76,0:05:38.30,kenangan,,0,0,0,,Bu Young...
Dialog: 0,0:05:53.77,0:05:54.98,teks umum,,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,0:05:56.78,0:05:59.74,teks umum,,0,0,0,,Ini berlaku pada hari Bu Young menghilangkan diri
Dialog: 0,0:06:12.75,0:06:14.25,teks umum,,0,0,0,,Moo Dok belum kembali
Dialog: 0,0:06:14.34,0:06:17.71,teks umum,,0,0,0,,Perantau itu mungkin membunuh dia dan Chan Wook
Dialog: 0,0:06:17.80,0:06:20.13,teks umum,,0,0,0,,Maka kita semua akan mati
Dialog: 0,0:06:26.56,0:06:27.68,teks umum,,0,0,0,,Jin Bu Young
Dialog: 0,0:06:27.77,0:06:30.48,teks umum,,0,0,0,,Awak sendiri yang bawa batu itu dari Jinyeowon
Dialog: 0,0:06:31.23,0:06:33.48,teks umum,,0,0,0,,Anda seorang paderi, tetapi anda tidak boleh mengawalnya?
Dialog: 0,0:06:34.90,0:06:37.73,teks umum,,0,0,0,,Saya mengikut arahan ibu saya
Dialog: 0,0:06:38.61,0:06:39.82,teks umum,,0,0,0,,Kamu menyedihkan
Dialog: 0,0:06:41.36,0:06:44.20,teks umum,,0,0,0,,Jadi Yul kehilangan terlalu banyak darah
Dialog: 0,0:06:45.03,0:06:47.54,teks umum,,0,0,0,,Tanpa transfusi dia mungkin mati
Dialog: 0,0:06:48.41,0:06:50.71,teks am,,0,0,0,,Jika anda perlukan darah, anda boleh ambil darah saya
Dialog: 0,0:06:50.79,0:06:53.08,teks umum,,0,0,0,,Anda tidak boleh menggunakan mantra di sini,
Dialog: 0,0:06:53.17,0:06:55.00,teks umum,,0,0,0,,jadi darah anda tidak boleh digunakan
Dialog: 0,0:07:02.55,0:07:03.93,kenangan miring,,0,0,0,,Ulurkan tangan anda
Dialog: 0,0:07:13.65,0:07:16.69,kenangan,,0,0,0,,Cacing dari darah anak perempuan saya Cho Young
Dialog: 0,0:07:16.77,0:07:19.57,kenangan miring,,0,0,0,,akan memberi anda kuasa keluarga Jin
Dialog: 0,0:07:22.82,0:07:26.41,italic,,0,0,0,,Chan Wook menipu kita semua
Dialog: 0,0:07:28.74,0:07:32.04,teks umum,,0,0,0,,Mages of the Unified Council bergilir-gilir membaca “Words of the Heart”,
Dialog: 0,0:07:32.12,0:07:34.12,teks umum,,0,0,0,,tetapi tidak ada perkataan tentang batu itu
Dialog: 0,0:07:34.21,0:07:36.84,teks umum,,0,0,0,,Tidak lebih daripada puisi
Dialog: 0,0:07:40.38,0:07:42.26,teks umum,,0,0,0,,Apakah yang akan Sosnovy Bor katakan tentang perkara ini?
Dialog: 0,0:07:45.30,0:07:46.72,teks umum,,0,0,0,,Semua ahli silap mata membacanya,
Dialog: 0,0:07:47.68,0:07:49.81,teks umum,,0,0,0,,tetapi tiada siapa yang tahu sesuatu
Dialog: 0,0:07:57.11,0:07:59.98,kenangan,,0,0,0,,"Kata hati" - surat cinta
Dialog: 0,0:08:00.07,0:08:01.40,kenangan,,0,0,0,,Tuan Seo Kyung
Dialog: 0,0:08:01.49,0:08:04.20,kenangan,,0,0,0,,Mesej?
Dialog: 0,0:08:04.78,0:08:08.33,kenangan,,0,0,0,,Surat Cinta untuk Jin Seol Ran,
Dialog: 0,0:08:08.41,0:08:09.87,kenangan,,0,0,0,,bab pertama Jinyeowon
Dialog: 0,0:08:11.29,0:08:15.37,teks umum,,0,0,0,,Ini adalah pengakuan bahawa dia tidak memusnahkan batu itu kerana
Dialog: 0,0:08:16.12,0:08:19.50,teks umum,,0,0,0,,bahawa saya tidak dapat melepaskan kekasih saya yang sedang nazak
Dialog: 0,0:08:21.59,0:08:23.51,teks umum,,0,0,0,,So, Master So Kyung
Dialog: 0,0:08:23.59,0:08:26.93,teks umum,,0,0,0,,tidak memusnahkan batu itu kerana cinta?
Dialog: 0,0:08:27.89,0:08:29.55,teks umum,,0,0,0,,Dia cuba menipu awak
Dialog: 0,0:08:30.14,0:08:33.73,teks umum,,0,0,0,,Saya boleh buktikan bahawa ini adalah surat cinta
Dialog: 0,0:08:35.56,0:08:38.11,teks umum,,0,0,0,,Sudah cukup untuk menamakan nama penerima dalam fikiran anda
Dialog: 0,0:08:38.69,0:08:42.07,teks umum,,0,0,0,,dan anda boleh membaca surat ini sendiri, Yang Mulia
Dialog: 0,0:08:42.15,0:08:43.86,teks umum,,0,0,0,,saya boleh baca puisi
Dialog: 0,0:08:44.99,0:08:46.66,teks umum,,0,0,0,,walaupun tanpa menjadi ahli silap mata?
Dialog: 0,0:08:47.36,0:08:48.70,contact,,0,0,0,,Nama penerima
Dialog: 0,0:08:48.78,0:08:53.08,teks umum,,0,0,0,, akan mengingatkan anda tentang "bunga orkid yang dilitupi salji"
Dialog: 0,0:08:55.00,0:08:56.50,teks umum,,0,0,0,,Ini Sol Ran
Dialog: 0,0:08:57.87,0:08:59.21,teks umum,,0,0,0,,"Salt Ran"?
Dialog: 0,0:09:31.53,0:09:34.95,teks umum,,0,0,0,,"Saya melihat cakrawala biru. Esakan yang tenang kedengaran"
Dialog: 0,0:09:43.42,0:09:46.88,teks umum,,0,0,0,,"Saya tahu mata saya akan penuh dengan air mata lagi"
Dialog: 0,0:09:47.97,0:09:49.13,teks umum,,0,0,0,,"Tetapi saya bodoh,"
Dialog: 0,0:09:49.72,0:09:53.01,teks umum,,0,0,0,,"tidak jatuh ke pipi saya"
Dialog: 0,0:09:54.22,0:09:56.39,contact,,0,0,0,,"tiada satu koyak pun"
Dialog: 0,0:09:58.73,0:10:00.40,teks umum,,0,0,0,,Ini pengakuannya
Dialog: 0,0:10:00.48,0:10:03.90,teks umum,,0,0,0,,bahawa dia tidak memusnahkan batu itu demi kekasihnya
Dialog: 0,0:10:07.49,0:10:09.53,teks umum,,0,0,0,,Tetapi kepala Jin Seol Ran meninggal dunia
Dialog: 0,0:10:09.61,0:10:11.62,teks umum,,0,0,0,,kira-kira enam bulan kemudian
Dialog: 0,0:10:11.70,0:10:16.08,teks umum,,0,0,0,,selepas penubuhan Jinyaewon akibat kecederaan yang diterima semasa Great Chaos
Dialog: 0,0:10:16.16,0:10:17.58,teks umum,,0,0,0,,Jika batu itu untuk dia,
Dialog: 0,0:10:17.66,0:10:19.83,teks umum,,0,0,0,,mengapa dia tidak menggunakannya dan menyelamatkan dirinya?
Dialog: 0,0:10:20.46,0:10:24.25,teks umum,,0,0,0,,Saya pasti ini supaya dunia tidak tahu
Dialog: 0,0:10:24.92,0:10:26.67,teks umum,,0,0,0,,kuasa berbahaya itu
Dialog: 0,0:10:27.84,0:10:31.30,teks umum,,0,0,0,,Siapa yang akan menolak kuasa sedemikian?
Dialog: 0,0:10:31.38,0:10:32.80,teks umum,,0,0,0,,Orang seperti anda
Dialog: 0,0:10:33.85,0:10:36.31,teks umum,,0,0,0,,tidak akan bertindak seperti dia
Dialog: 0,0:10:36.39,0:10:39.10,teks umum,,0,0,0,,Dan dia melakukannya demi kemanusiaan
Dialog: 0,0:10:40.48,0:10:41.73,teks umum,,0,0,0,,Melakukan perkara yang betul
Dialog: 0,0:10:43.44,0:10:45.90,teks umum,,0,0,0,,Untuk melindungi apa yang patut
Dialog: 0,0:10:48.36,0:10:53.62,teks umum,,0,0,0,,kadang-kadang seseorang terpaksa melepaskan segala-galanya
Dialog: 0,0:11:10.42,0:11:12.26,teks umum,,0,0,0,,Sejak kamu mengambil pedang,
Dialog: 0,0:11:13.68,0:11:15.39,teks umum,,0,0,0,,buat pilihan anda
Dialog: 0,0:11:20.14,0:11:21.64,teks umum,,0,0,0,,Saya tahu awak mengelak saya
Dialog: 0,0:11:21.73,0:11:24.73,teks umum,,0,0,0,,Saya tahu bahawa hidup kami di tangan anda
Dialog: 0,0:11:27.07,0:11:30.74,teks umum,,0,0,0,,Seperti yang dijanjikan, halakan pedang anda kepada saya dahulu
Dialog: 0,0:11:43.12,0:11:45.08,kenangan condong,,0,0,0,,Tenaga yang berlebihan akan membawa kepada
Dialog: 0,0:11:45.17,0:11:47.84,memori italik,,0,0,0,,bahawa anda tidak boleh mengawal kuasa yang anda gunakan
Dialog: 0,0:11:48.80,0:11:51.42,kenangan,,0,0,0,,Kalau nak hujan kena banjir
Dialog: 0,0:11:52.17,0:11:54.76,kenangan,,0,0,0,,Kalau nak angin, kena taufan
Dialog: 0,0:11:54.84,0:11:56.51,kenangan,,0,0,0,,Cuba hadapi
Dialog: 0,0:11:56.59,0:11:59.47,kenangan,,0,0,0,,Jadi, saya tidak akan dapat mengawal kuasa ini?
Dialog: 0,0:12:00.77,0:12:03.60,kenangan,,0,0,0,,Sesuatu yang anda boleh lakukan atas kehendak anda sendiri
Dialog: 0,0:12:05.85,0:12:07.02,kenangan,,0,0,0,,Jangan gunakannya
Dialog: 0,0:12:08.36,0:12:11.65,kenangan,,0,0,0,,Pilihan di tangan anda: menggunakan kekerasan atau tidak
Dialog: 0,0:12:25.37,0:12:27.33,teks umum,,0,0,0,,Sekarang, seperti yang anda katakan,
Dialog: 0,0:12:29.42,0:12:31.05,teks umum,,0,0,0,,beri saya janji lagi
Dialog: 0,0:12:47.77,0:12:49.11,contact,,0,0,0,,Antara bintang
Dialog: 0,0:12:49.19,0:12:52.48,italic,,0,0,0,,ada yang paling menyedihkan - bintang Raja
Dialog: 0,0:12:54.61,0:12:56.78,teks umum,,0,0,0,,Bintang jenis apakah ini?
Dialog: 0,0:12:57.49,0:12:58.82,teks umum,,0,0,0,,Dilahirkan di bawah tandanya
Dialog: 0,0:12:58.91,0:13:01.20,teks umum,,0,0,0,,boleh mengawal tenaga syurga
Dialog: 0,0:13:01.28,0:13:03.87,teks umum,,0,0,0,,Jadi orang itu akan menjadi kuat?
Dialog: 0,0:13:03.95,0:13:05.62,teks umum,,0,0,0,,Bagus
Dialog: 0,0:13:06.50,0:13:09.96,teks umum,,0,0,0,,Bagaimana untuk mengatakan... Ia tidak selalunya sesuatu yang baik
Dialog: 0,0:13:10.04,0:13:12.00,teks umum,,0,0,0,,Semakin besar kuasa -
Dialog: 0,0:13:12.09,0:13:14.05,teks umum,,0,0,0,,semakin besar tanggungjawab
Dialog: 0,0:13:14.13,0:13:16.09,teks umum,,0,0,0,,Apakah itu "tanggungjawab"?
Dialog: 0,0:13:16.17,0:13:18.64,teks umum,,0,0,0,,Ini adalah apabila anda perlu melakukan sesuatu yang anda tidak mahu lakukan,
Dialog: 0,0:13:18.72,0:13:20.97,teks umum,,0,0,0,,walaupun anda berasa sedih dan sunyi kemudiannya
Dialog: 0,0:13:21.05,0:13:24.60,teks umum,,0,0,0,,Ajusshi, boleh saya makan ini?
Dialog: 0,0:13:25.81,0:13:26.77,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:13:27.81,0:13:30.73,teks umum,,0,0,0,,- Saya sepatutnya memberikannya lebih awal\N- Terima kasih
Dialog: 0,0:13:30.81,0:13:34.48,teks umum,,0,0,0,,Cuma jangan berebut mereka
Dialog: 0,0:13:34.57,0:13:36.15,teks umum,,0,0,0,,Baiklah. Kami pergi
Dialog: 0,0:13:46.54,0:13:48.25,teks umum,,0,0,0,,Bintang akan muncul tidak lama lagi
Dialog: 0,0:13:49.37,0:13:52.29,teks umum,,0,0,0,,Kemudian mereka yang sepatutnya hilang,
Dialog: 0,0:13:52.38,0:13:54.92,teks umum,,0,0,0,,dan mereka yang memerlukannya akan kembali
Dialog: 0,0:14:01.93,0:14:05.77,teks umum,,0,0,0,,Putera Mahkota sedang mencari tempat ini
Dialog: 0,0:14:06.43,0:14:08.48,teks umum,,0,0,0,,Kedai tempat setiap bulan
Dialog: 0,0:14:08.56,0:14:10.94,teks umum,,0,0,0,,kasim Kim, hamba ratu, berjalan
Dialog: 0,0:14:11.02,0:14:13.27,teks umum,,0,0,0,,Anda tahu jalan anda dengan baik
Dialog: 0,0:14:13.98,0:14:16.44,teks umum,,0,0,0,,Dan azimat itu, supaya kekasih jatuh cinta...
Dialog: 0,0:14:16.53,0:14:17.86,teks umum,,0,0,0,,Adakah anda mendapatkannya di sini?
Dialog: 0,0:14:19.07,0:14:22.16,teks umum,,0,0,0,,Ia tidak berjaya, berhenti mengejek saya
Dialog: 0,0:14:22.74,0:14:26.20,teks umum,,0,0,0,,Bagaimana ia "tidak berfungsi"? Kami bersama sekarang
Dialog: 0,0:14:27.54,0:14:28.50,teks umum,,0,0,0,,Nah...
Dialog: 0,0:14:28.58,0:14:31.33,teks umum,,0,0,0,,Kami tidak berkencan
Dialog: 0,0:14:39.88,0:14:43.01,teks umum,,0,0,0,,Kenapa dia ada di sini?
Dialog: 0,0:14:45.01,0:14:47.27,prasasti,,0,0,0,,kedai Herbalist
Dialog: 0,0:14:48.31,0:14:49.48,teks umum,,0,0,0,,Ayah?
Dialog: 0,0:15:27.51,0:15:29.77,teks umum,,0,0,0,,Sedarlah
Dialog: 0,0:15:29.85,0:15:32.44,teks umum,,0,0,0,,Mereka cuba mencederakan diri mereka sekali lagi, Yang Amat Mulia
Dialog: 0,0:15:32.52,0:15:34.60,teks umum,,0,0,0,,Mengapa awak membiarkan saya hidup?
Dialog: 0,0:15:35.36,0:15:37.52,teks umum,,0,0,0,,Bunuh saja sudah
Dialog: 0,0:15:37.61,0:15:40.82,teks umum,,0,0,0,,Belum lagi. Tanglung Kehidupan Ratu
Dialog: 0,0:15:41.65,0:15:44.49,teks umum,,0,0,0,,mesti terbakar semasa mayat permaisuri masih hidup
Dialog: 0,0:15:47.78,0:15:50.45,teks umum,,0,0,0,,Seramnya awak tengok saya macam tu
Dialog: 0,0:15:51.58,0:15:53.96,teks umum,,0,0,0,,dengan muka kakak saya
Dialog: 0,0:15:54.04,0:15:56.29,teks umum,,0,0,0,,Awak tak patut marah saya
Dialog: 0,0:15:56.38,0:15:58.17,teks umum,,0,0,0,,Orang yang meletakkannya dipersalahkan
Dialog: 0,0:15:59.34,0:16:01.38,teks umum,,0,0,0,,saya dan kakak saya berada dalam situasi ini
Dialog: 0,0:16:13.31,0:16:15.81,kenangan,,0,0,0,,Shaman Choi, kamu mengutuk dan mencederakan orang
Dialog: 0,0:16:15.90,0:16:17.94,kenangan,,0,0,0,,menggunakan jampi terlarang
Dialog: 0,0:16:18.90,0:16:20.40,kenangan,,0,0,0,,Adakah anda mengakui dosa anda?
Dialog: 0,0:16:25.99,0:16:29.78,kenangan,,0,0,0,,Saya lakukan untuk wang apa yang orang minta
Dialog: 0,0:16:29.87,0:16:33.50,kenangan,,0,0,0,,Ini salah mereka yang meminta saya mengutuk seseorang
Dialog: 0,0:16:33.58,0:16:35.42,kenangan,,0,0,0,,Sumpahan awak membawa kepada kematian!
Dialog: 0,0:16:36.46,0:16:38.33,kenangan,,0,0,0,,Adakah anda berpura-pura tidak bersalah?
Dialog: 0,0:16:42.01,0:16:44.72,kenangan,,0,0,0,,Mantra yang boleh membunuh...
Dialog: 0,0:16:44.80,0:16:46.34,kenangan,,0,0,0,,Kagum dengan kekuatan anda
Dialog: 0,0:16:46.97,0:16:48.09,kenangan,,0,0,0,,Kuasa ini
Dialog: 0,0:16:49.01,0:16:53.47,kenangan,,0,0,0,,malah mungkin cukup untuk membunuh anda
Dialog: 0,0:16:58.73,0:17:02.78,kenangan,,0,0,0,,Cari semua buku mantra, semua yang dia gunakan!
Dialog: 0,0:17:02.86,0:17:03.78,kenangan,,0,0,0,,- Ya!\N- Ya!
Dialog: 0,0:17:21.25,0:17:22.92,kenangan,,0,0,0,,Tidak, bukan itu!
Dialog: 0,0:17:23.80,0:17:25.05,kenangan,,0,0,0,,Kami adalah keluarga miskin,
Dialog: 0,0:17:25.13,0:17:27.13,kenangan,,0,0,0,,tetapi ini pusaka keluarga kami
Dialog: 0,0:17:27.22,0:17:29.51,kenangan,,0,0,0,,Saya tidak meneka dengannya!
Dialog: 0,0:17:29.59,0:17:30.76,kenangan,,0,0,0,,Jangan terbakar
Dialog: 0,0:17:31.35,0:17:32.51,prasasti,,0,0,0,,Chongan
Dialog: 0,0:17:32.60,0:17:33.77,kenangan,,0,0,0,,Ini adalah buku jampi
Dialog: 0,0:17:33.85,0:17:34.89,kenangan,,0,0,0,,Tidak...
Dialog: 0,0:17:35.68,0:17:36.60,kenangan,,0,0,0,,Terbakar
Dialog: 0,0:17:39.52,0:17:43.27,kenangan,,0,0,0,,Tidak!
Dialog: 0,0:17:43.78,0:17:45.19,prasasti,,0,0,0,,Chongan
Dialog: 0,0:18:01.54,0:18:03.13,teks umum,,0,0,0,,Padamkan api. Cepat!
Dialog: 0,0:18:03.21,0:18:04.25,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:18:10.05,0:18:15.10,prasasti,,0,0,0,,Chongan
Dialog: 0,0:18:23.11,0:18:25.40,prasasti,,0,0,0,,Alkimia jiwa
Dialog: 0,0:18:25.98,0:18:27.53,kenangan,,0,0,0,,"Alkimia Jiwa"?
Dialog: 0,0:18:41.71,0:18:43.04,kenangan,,0,0,0,,Sabar ye kakak
Dialog: 0,0:19:01.39,0:19:03.27,contact,,0,0,0,,Semuanya bermula dengan dia
Dialog: 0,0:19:03.35,0:19:04.90,teks umum,,0,0,0,,Dia meninggalkan parut ini
Dialog: 0,0:19:04.98,0:19:08.15,teks umum,,0,0,0,,Kerana dia, kakak saya memindahkan rohnya ke tubuh awak
Dialog: 0,0:19:08.23,0:19:10.24,teks umum,,0,0,0,,Ini salah dia
Dialog: 0,0:19:11.65,0:19:12.82,teks umum,,0,0,0,,Chan Gan
Dialog: 0,0:19:14.62,0:19:15.66,teks umum,,0,0,0,,Chan...
Dialog: 0,0:19:16.53,0:19:18.16,teks umum,,0,0,0,,Gan...
Dialog: 0,0:19:19.50,0:19:21.16,teks umum,,0,0,0,,Anda belum boleh mati
Dialog: 0,0:19:21.96,0:19:23.83,teks umum,,0,0,0,,Hidup dalam badan adik saya
Dialog: 0,0:19:25.04,0:19:26.34,teks umum,,0,0,0,,sedikit lagi,
Dialog: 0,0:19:27.34,0:19:28.38,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:19:33.76,0:19:36.26,teks umum,,0,0,0,,Lebih sepuluh tahun telah berlalu sejak saya mendapat badan ini
Dialog: 0,0:19:37.43,0:19:40.77,teks umum,,0,0,0,,Tetapi setiap kali dia sedar, ia memberi kesan kepada saya
Dialog: 0,0:19:41.73,0:19:44.73,teks umum,,0,0,0,,Jika bukan kerana tanglung Kehidupan, saya akan membunuhnya
Dialog: 0,0:19:44.81,0:19:47.36,teks am,,0,0,0,,Abang awak bawa ubat dia
Dialog: 0,0:19:48.44,0:19:50.36,teks umum,,0,0,0,,Anda akan berasa lebih baik tidak lama lagi
Dialog: 0,0:19:51.78,0:19:52.78,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:19:54.20,0:19:56.82,teks umum,,0,0,0,,Bagaimanakah batu itu berakhir di Chongjingak?
Dialog: 0,0:19:56.91,0:19:58.62,teks umum,,0,0,0,,Jin Ho Kyung mungkin tersilap,
Dialog: 0,0:19:58.70,0:20:00.75,teks umum,,0,0,0,,kerana saya menggunakan batu itu buat kali pertama
Dialog: 0,0:20:01.75,0:20:03.21,teks umum,,0,0,0,,Apabila tiba masanya,
Dialog: 0,0:20:04.00,0:20:07.04,teks umum,,0,0,0,,Saya menggunakan kuasa batu untuk alkimia jiwa
Dialog: 0,0:20:09.30,0:20:12.63,teks umum,,0,0,0,,Jika anda melakukan ini sekarang, semua orang di Jeongjingak akan mati
Dialog: 0,0:20:12.72,0:20:13.84,teks umum,,0,0,0,,Ya, saya tahu
Dialog: 0,0:20:14.38,0:20:15.97,teks umum,,0,0,0,,Putera Mahkota juga ada
Dialog: 0,0:20:17.80,0:20:18.97,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:20:20.52,0:20:23.06,teks umum,,0,0,0,,Kita mesti tunggu dia diselamatkan dari sana
Dialog: 0,0:20:23.14,0:20:24.56,teks umum,,0,0,0,, Kemudian anda boleh mengumpul kuasa batu
Dialog: 0,0:20:24.64,0:20:26.02,teks umum,,0,0,0,,Bagaimana jika mereka tidak menyelamatkannya?
Dialog: 0,0:20:27.10,0:20:29.15,teks umum,,0,0,0,, Patutkah saya duduk dan menunggu?
Dialog: 0,0:20:29.23,0:20:32.74,teks umum,,0,0,0,,Bagaimana jika sesuatu mengambil batu sebelum saya?
Dialog: 0,0:20:32.82,0:20:36.41,teks umum,,0,0,0,,Syukurlah, tiada siapa yang melakukan apa-apa, semua orang hanya berjaga-jaga
Dialog: 0,0:20:37.66,0:20:41.58,teks umum,,0,0,0,,Kita mesti mencari jalan untuk menyelamatkan Putera Mahkota
Dialog: 0,0:20:55.72,0:20:56.88,kenangan,,0,0,0,,Ibu
Dialog: 0,0:21:03.43,0:21:04.81,teks umum,,0,0,0,,Saya mendengarnya
Dialog: 0,0:21:05.56,0:21:07.23,teks umum,,0,0,0,,Kenapa dia panggil saya begitu?
Dialog: 0,0:21:08.10,0:21:09.27,teks umum,,0,0,0,,Ketawa dan tidak lebih
Dialog: 0,0:21:16.15,0:21:17.20,teks umum,,0,0,0,,Semua
Dialog: 0,0:21:18.78,0:21:21.03,teks umum,,0,0,0,,lebih risau tentang batu ais,
Dialog: 0,0:21:23.04,0:21:25.54,teks umum,,0,0,0,, daripada kanak-kanak yang terkunci di sana
Dialog: 0,0:21:27.21,0:21:30.04,teks umum,,0,0,0,,Anda dan saya mesti cuba memusnahkan penghalang
Dialog: 0,0:21:31.75,0:21:34.67,teks umum,,0,0,0,,Mari kita lakukan sesuatu tanpa persetujuan majlis,
Dialog: 0,0:21:35.38,0:21:37.09,teks umum,,0,0,0,,akan ada skandal lagi
Dialog: 0,0:21:39.01,0:21:41.35,teks umum,,0,0,0,,Batu itu kepunyaan Jinyeowon
Dialog: 0,0:21:41.43,0:21:44.06,teks umum,,0,0,0,,Sosnovy Bor tidak berhak membuat keputusan
Dialog: 0,0:21:44.14,0:21:45.18,teks umum,,0,0,0,,Bab Jin,
Dialog: 0,0:21:45.73,0:21:49.56,teks umum,,0,0,0,,batu itu tidak pernah benar-benar meninggalkan dinding Jinyeowon
Dialog: 0,0:21:49.65,0:21:51.94,teks umum,,0,0,0,, sepanjang 200 tahun yang lalu?
Dialog: 0,0:21:54.57,0:21:57.28,italics,,0,0,0,,Anda pernah berkata bahawa ahli silap mata Sosnovy Bor telah pun memasuki Jinyeowon
Dialog: 0,0:21:57.78,0:21:59.07,teks umum,,0,0,0,,Ini rawak
Dialog: 0,0:22:01.07,0:22:02.33,teks umum,,0,0,0,,bukankah Chang Gan?
Dialog: 0,0:22:06.33,0:22:08.04,teks umum,,0,0,0,,Saya bertanya soalan
Dialog: 0,0:22:09.04,0:22:12.79,teks am,,0,0,0,,Adakah Geng Chang pernah menggunakan batu?
Dialog: 0,0:22:24.31,0:22:26.22,kenangan,,0,0,0,,Bayi di dalam tidak bergerak
Dialog: 0,0:22:26.31,0:22:28.02,kenangan,,0,0,0,,Saya menggendongnya selama 13 bulan
Dialog: 0,0:22:28.89,0:22:30.02,kenangan,,0,0,0,,Saya tidak boleh melepaskannya
Dialog: 0,0:22:32.36,0:22:33.61,kenangan,,0,0,0,,Saya perlu menyelamatkannya
Dialog: 0,0:22:34.23,0:22:35.94,kenangan,,0,0,0,,Maafkan saya
Dialog: 0,0:22:36.98,0:22:38.69,kenangan,,0,0,0,,Dia sudah mati
Dialog: 0,0:22:43.87,0:22:45.20,kenangan,,0,0,0,,Dalam Jinyeowon
Dialog: 0,0:22:46.91,0:22:47.87,kenangan,,0,0,0,,ada batu ais
Dialog: 0,0:22:49.83,0:22:51.17,kenangan,,0,0,0,,Ais batu?
Dialog: 0,0:22:51.25,0:22:53.67,kenangan,,0,0,0,,Kenapa terkejut? Anda sudah mengesyaki
Dialog: 0,0:22:53.75,0:22:57.09,kenangan,,0,0,0,,Awak minta pergi ke Jinyeowon berkali-kali
Dialog: 0,0:22:57.92,0:23:00.55,kenangan,,0,0,0,,Saya tahu awak nak cari batu di sana
Dialog: 0,0:23:04.14,0:23:05.76,kenangan,,0,0,0,,Mereka kata batu itu boleh
Dialog: 0,0:23:05.85,0:23:09.89,kenangan,,0,0,0,,hidupkan semula orang mati
Dialog: 0,0:23:11.31,0:23:12.48,kenangan,,0,0,0,,Saya tidak mempunyai kekuatan yang mencukupi
Dialog: 0,0:23:14.19,0:23:15.90,kenangan,,0,0,0,,kawal batu
Dialog: 0,0:23:16.73,0:23:17.82,kenangan,,0,0,0,,Tetapi untuk awak, Chang Gan
Dialog: 0,0:23:18.69,0:23:20.78,kenangan,,0,0,0,,kekuatan mungkin cukup
Dialog: 0,0:23:22.95,0:23:25.03,kenangan,,0,0,0,,Adakah anda meminta untuk menggunakan sihir gelap?
Dialog: 0,0:23:25.12,0:23:27.79,kenangan,,0,0,0,,Saya akan lakukan segalanya untuk menyelamatkan anak saya
Dialog: 0,0:23:30.58,0:23:31.54,kenangan,,0,0,0,,Sila
Dialog: 0,0:23:32.75,0:23:34.92,kenangan,,0,0,0,,Bantu saya selamatkan dia
Dialog: 0,0:23:45.68,0:23:49.39,suara,,0,0,0,,Malam itu saya membuka pintu Jinyoewon dan membenarkan dia masuk
Dialog: 0,0:23:50.02,0:23:52.31,suara,,0,0,0,,dengan harapan dia akan menyelamatkan anak perempuan saya
Dialog: 0,0:23:53.35,0:23:56.98,di sebalik tabir,,0,0,0,,Dan akibatnya, Jinyeowon kehilangan batu ais
Dialog: 0,0:24:05.36,0:24:06.66,teks umum,,0,0,0,,Walaupun begitu,
Dialog: 0,0:24:07.66,0:24:09.91,teks am,,0,0,0,,ada lagi rasa bersalah di sebalik Sosnovy Bor
Dialog: 0,0:24:09.99,0:24:13.54,teks umum,,0,0,0,,Ahli silap mata anda sentiasa menggambarkan orang benar, tetapi masih
Dialog: 0,0:24:13.62,0:24:15.46,teks umum,,0,0,0,,mengambil batu ais
Dialog: 0,0:24:15.54,0:24:18.96,teks umum,,0,0,0,,Mencipta alkimia jiwa dan menimbulkan huru-hara di bumi
Dialog: 0,0:24:21.59,0:24:23.76,teks umum,,0,0,0,,Jadi saya ingin menyembunyikannya
Dialog: 0,0:24:25.18,0:24:26.22,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:24:27.43,0:24:30.64,teks umum,,0,0,0,,Saya akan melakukan segala-galanya untuk mendedahkan kebenaran dan membetulkan segala-galanya,
Dialog: 0,0:24:31.77,0:24:34.23,teks umum,,0,0,0,,walaupun anda perlu mendedahkan dosa Sosnovy Bor
Dialog: 0,0:24:35.98,0:24:37.40,teks umum,,0,0,0,,dan menghukum mereka yang bersalah
Dialog: 0,0:24:41.11,0:24:44.82,teks umum,,0,0,0,,Maka anda perlu membuat penilaian terhadap orang yang anda sayangi
Dialog: 0,0:24:47.20,0:24:48.53,teks umum,,0,0,0,,Ia tidak akan mudah
Dialog: 0,0:24:50.58,0:24:51.79,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:24:54.16,0:24:55.12,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:24:55.87,0:25:00.09,teks umum,,0,0,0,,jika ini adalah satu-satunya cara untuk membetulkan keadaan,
Dialog: 0,0:25:03.30,0:25:05.67,teks umum,,0,0,0,,Saya akan melakukannya
Dialog: 0,0:25:15.52,0:25:17.69,teks umum,,0,0,0,,Jiwa adik saya akan menggantikan jasad awak
Dialog: 0,0:25:17.77,0:25:21.69,teks umum,,0,0,0,, pada tubuh seorang gadis yang berpura-pura menjadi anak sulung saya
Dialog: 0,0:25:22.48,0:25:24.07,condong,,0,0,0,,Kemudian
Dialog: 0,0:25:24.15,0:25:27.74,teks umum,,0,0,0,,Saya akan bunuh awak, seperti yang awak minta
Dialog: 0,0:25:43.00,0:25:44.05,teks umum,,0,0,0,,Cho Young,
Dialog: 0,0:25:46.09,0:25:47.30,contact,,0,0,0,,apa...
Dialog: 0,0:25:47.38,0:25:48.72,teks umum,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:25:51.51,0:25:52.72,teks umum,,0,0,0,,Bapa,
Dialog: 0,0:25:53.81,0:25:54.93,teks umum,,0,0,0,,apa yang..
Dialog: 0,0:25:56.23,0:25:58.06,teks umum,,0,0,0,,karut... Saya cuma
Dialog: 0,0:25:59.23,0:26:00.48,teks umum,,0,0,0,,didengar?
Dialog: 0,0:26:04.86,0:26:07.86,teks umum,,0,0,0,,Siapa wanita ini?
Dialog: 0,0:26:09.03,0:26:11.28,miring,,0,0,0,,Dipenjara dalam badan ini
Dialog: 0,0:26:13.58,0:26:15.54,teks umum,,0,0,0,,jiwa seorang ratu sebenar?
Dialog: 0,0:26:45.11,0:26:47.40,teks umum,,0,0,0,,Ayah, berhenti
Dialog: 0,0:27:49.25,0:27:50.30,teks umum,,0,0,0,,Gwangju,
Dialog: 0,0:27:51.30,0:27:52.55,teks umum,,0,0,0,, adakah itu anda?
Dialog: 0,0:28:02.27,0:28:03.35,teks umum,,0,0,0,,Maiden Kim,
Dialog: 0,0:28:04.35,0:28:05.77,teks umum,,0,0,0,,lama tidak berjumpa
Dialog: 0,0:28:10.07,0:28:11.28,teks umum,,0,0,0,,Geng Master Chang
Dialog: 0,0:28:51.32,0:28:52.69,teks umum,,0,0,0,,Ini adalah penelan jiwa
Dialog: 0,0:28:55.65,0:28:57.87,contact,,0,0,0,,Chan Wook mesti membunuhnya
Dialog: 0,0:28:58.45,0:28:59.53,teks umum,,0,0,0,,Dikalahkan dengan satu pukulan
Dialog: 0,0:29:01.04,0:29:03.95,teks umum,,0,0,0,,Ejaan tidak boleh dihantar di sini. Bagaimana dia melakukannya?
Dialog: 0,0:29:06.33,0:29:08.00,teks umum,,0,0,0,,Di manakah Chan Wook dan Moo Deok?
Dialog: 0,0:29:08.08,0:29:09.17,teks umum,,0,0,0,,Cari mereka
Dialog: 0,0:29:09.88,0:29:11.13,teks umum,,0,0,0,,Ya
Dialog: 0,0:29:21.89,0:29:25.02,teks umum,,0,0,0,,Saya mendapat penglihatan apabila saya merasakan tenaga batu ais
Dialog: 0,0:29:26.06,0:29:28.56,teks umum,,0,0,0,,Gadis itu berkata bahawa tiada siapa yang boleh memiliki batu itu
Dialog: 0,0:29:28.65,0:29:30.31,teks umum,,0,0,0,,Anda hanya boleh menggunakan kekerasan
Dialog: 0,0:29:31.44,0:29:33.07,teks umum,,0,0,0,,Kerana ini adalah tenaga langit
Dialog: 0,0:29:33.82,0:29:35.49,teks umum,,0,0,0,,Kita mesti berlatih,
Dialog: 0,0:29:36.07,0:29:39.24,teks umum,,0,0,0,,untuk mengawal walaupun tenaga dalam diri kita
Dialog: 0,0:29:39.32,0:29:42.20,teks umum,,0,0,0,,Tenaga langit, sudah tentu, di luar kemampuan kita
Dialog: 0,0:29:42.28,0:29:46.62,teks umum,,0,0,0,,Kami tidak boleh menggunakannya secara bebas kerana ia bukan milik kami
Dialog: 0,0:29:49.42,0:29:50.83,teks umum,,0,0,0,,Jika anda tidak dapat menguasainya?
Dialog: 0,0:29:51.92,0:29:53.50,teks umum,,0,0,0,,Bagaimana jika saya memberikan semua milik saya?
Dialog: 0,0:29:54.21,0:29:55.59,teks umum,,0,0,0,,Beri saya milik anda?
Dialog: 0,0:29:55.67,0:29:59.30,teks umum,,0,0,0,,Bagaimana jika saya meletakkan semua tenaga saya ke langit?
Dialog: 0,0:30:00.01,0:30:02.35,teks umum,,0,0,0,,Kemudian tenaga saya akan menjadi tenaga langit
Dialog: 0,0:30:05.93,0:30:08.06,teks umum,,0,0,0,,Saya membaca nota tentang batu ais
Dialog: 0,0:30:08.14,0:30:10.02,teks umum,,0,0,0,,di perpustakaan rahsia Jeonjingak
Dialog: 0,0:30:11.81,0:30:14.73,italic,,0,0,0,,Mereka kata batu ais tiada bentuk
Dialog: 0,0:30:14.82,0:30:17.65,contact,,0,0,0,,Ia mungkin air, api atau angin
Dialog: 0,0:30:17.74,0:30:19.95,contact,,0,0,0,,Tidak dapat mengetahui saiznya
Dialog: 0,0:30:20.03,0:30:23.37,contact,,0,0,0,,Ia boleh sama ada kecil atau besar
Dialog: 0,0:30:25.41,0:30:28.37,teks umum,,0,0,0,,Ini bermakna halangan mengelilingi Jeonjingak
Dialog: 0,0:30:28.46,0:30:30.29,teks umum,,0,0,0,,bukan bentuk sebenar batu ais
Dialog: 0,0:30:30.83,0:30:32.88,teks umum,,0,0,0,,Dia boleh bertukar menjadi air atau api,
Dialog: 0,0:30:32.96,0:30:35.67,teks umum,,0,0,0,,menjadi lebih besar atau lebih kecil daripada sekarang
Dialog: 0,0:30:36.42,0:30:37.46,teks umum,,0,0,0,,Ya
Dialog: 0,0:30:37.55,0:30:41.09,teks umum,,0,0,0,,Adakah anda fikir kita boleh mengubah kabus menjadi hujan?
Dialog: 0,0:30:41.72,0:30:42.72,teks umum,,0,0,0,,Dalam hujan?
Dialog: 0,0:30:42.80,0:30:45.64,teks umum,,0,0,0,,Awak kata kekuatan saya tiada apa-apa jika dibandingkan dengan kekuatan batu
Dialog: 0,0:30:46.27,0:30:48.14,teks umum,,0,0,0,,Hanya setitik air dalam kuasa saya
Dialog: 0,0:30:48.23,0:30:52.73,teks umum,,0,0,0,,Dan jika titisan ini bertukar menjadi beribu-ribu titisan hujan?
Dialog: 0,0:30:54.69,0:30:56.82,teks umum,,0,0,0,, Hujan akan turun
Dialog: 0,0:30:56.90,0:30:58.44,teks umum,,0,0,0,,Ini mungkin berkesan
Dialog: 0,0:30:59.32,0:31:01.24,teks umum,,0,0,0,,Tetapi untuk ini anda perlu menggunakan Tansu
Dialog: 0,0:31:01.32,0:31:03.66,teks umum,,0,0,0,,- Kemudian...\N- Kemudian saya akan kehilangan semua tenaga saya
Dialog: 0,0:31:04.70,0:31:07.83,teks umum,,0,0,0,,Jadi saya berkata saya perlu memberikan semuanya
Dialog: 0,0:31:12.00,0:31:13.00,teks umum,,0,0,0,,Tidak
Dialog: 0,0:31:13.08,0:31:14.79,teks umum,,0,0,0,,Temukan cara lain
Dialog: 0,0:31:14.88,0:31:17.75,teks umum,,0,0,0,,Kita mesti cepat, jika tidak, permaisuri akan mengumpulkan semua kuasa batu
Dialog: 0,0:31:18.76,0:31:19.92,teks umum,,0,0,0,,Maka kita semua akan mati
Dialog: 0,0:31:20.01,0:31:23.76,teks umum,,0,0,0,,Majlis memerhatikannya, dia tidak akan melakukan apa-apa yang terburu-buru
Dialog: 0,0:31:24.39,0:31:26.89,teks umum,,0,0,0,,Chan Wook, tidak perlu
Dialog: 0,0:31:27.51,0:31:29.14,teks umum,,0,0,0,,Sebagai guru kamu, saya perintah
Dialog: 0,0:31:37.90,0:31:40.53,teks umum,,0,0,0,,Saya berputus asa untuk mendapatkan semula kuasa saya,
Dialog: 0,0:31:40.61,0:31:42.32,teks umum,,0,0,0,,tetapi saya tidak akan membiarkan anda mensia-siakan saya
Dialog: 0,0:31:43.74,0:31:45.82,teks umum,,0,0,0,,Anda dan saya sudah sejauh ini
Dialog: 0,0:31:46.66,0:31:48.24,teks umum,,0,0,0,,Saya sangat mendorong anda,
Dialog: 0,0:31:48.33,0:31:50.91,teks umum,,0,0,0,, dan anda mempertaruhkan nyawa anda berkali-kali
Dialog: 0,0:31:56.50,0:31:59.96,teks umum,,0,0,0,,Dan adakah anda bersedia untuk melepaskan segala-galanya untuk satu titisan?
Dialog: 0,0:32:03.51,0:32:05.18,teks umum,,0,0,0,,Yul cedera parah
Dialog: 0,0:32:05.26,0:32:07.89,teks umum,,0,0,0,,Jika tiada apa-apa, dia akan mati
Dialog: 0,0:32:13.60,0:32:14.94,miring,,0,0,0,,Moo Dok
Dialog: 0,0:32:15.56,0:32:18.73,teks umum,,0,0,0,,Anda menyerahkan segalanya untuk melindungi saya
Dialog: 0,0:32:22.19,0:32:23.61,teks umum,,0,0,0,,Saya mahu melindungi awak juga
Dialog: 0,0:32:24.49,0:32:28.53,teks umum,,0,0,0,,Dan Yul juga melindungi kamu selama ini
Dialog: 0,0:32:39.13,0:32:42.13,kenangan miring,,0,0,0,,Tanpa transfusi dia boleh mati
Dialog: 0,0:32:45.51,0:32:48.05,italic,,0,0,0,,Cacing ini adalah dari darah keluarga Jin...
Dialog: 0,0:32:48.14,0:32:49.76,teks umum,,0,0,0,,Jika kamu berikan kepadanya...
Dialog: 0,0:33:26.38,0:33:28.09,teks umum,,0,0,0,,Jangan mati, tuan
Dialog: 0,0:33:29.60,0:33:31.10,teks umum,,0,0,0,,Kekal hidup
Dialog: 0,0:34:01.63,0:34:04.09,teks umum,,0,0,0,,Alih keluar pemantul. Bagaimana jika seseorang melihat?
Dialog: 0,0:34:04.67,0:34:06.72,teks umum,,0,0,0,,Saya tidak tahan lagi
Dialog: 0,0:34:07.22,0:34:09.09,teks umum,,0,0,0,,Saya mesti mengembalikan batu itu
Dialog: 0,0:34:09.18,0:34:11.35,teks umum,,0,0,0,,menggunakan reflektor
Dialog: 0,0:34:13.76,0:34:15.02,teks umum,,0,0,0,,Adakah anda gila?
Dialog: 0,0:34:15.10,0:34:16.85,teks umum,,0,0,0,,Anda tidak boleh melakukan sihir dengan pemantul,
Dialog: 0,0:34:16.93,0:34:18.60,teks umum,,0,0,0,,sementara Majlis Bersatu ada di sini
Dialog: 0,0:34:20.15,0:34:21.31,teks umum,,0,0,0,, Conjure?
Dialog: 0,0:34:24.73,0:34:27.19,teks umum,,0,0,0,,Reflektor ini diperbuat daripada batu ais
Dialog: 0,0:34:27.28,0:34:30.11,teks umum,,0,0,0,,Tetapi batu itu dianggap baik, dan pemantulnya adalah jahat
Dialog: 0,0:34:30.20,0:34:32.32,teks umum,,0,0,0,,Ini mengarut
Dialog: 0,0:34:32.41,0:34:36.41,teks umum,,0,0,0,,Anggap ia tidak masuk akal, tetapi ini adalah susunan dunia ini
Dialog: 0,0:34:36.50,0:34:39.25,teks umum,,0,0,0,,Kami melakukan ini supaya anda boleh keluar dari kegelapan
Dialog: 0,0:34:39.33,0:34:41.79,teks umum,,0,0,0,,tanpa stigma ahli sihir
Dialog: 0,0:34:42.54,0:34:43.54,teks umum,,0,0,0,,Stigma memalukan?
Dialog: 0,0:34:45.13,0:34:48.01,teks umum,,0,0,0,,Anda telah sampai sejauh ini menggunakan alkimia keluarga saya
Dialog: 0,0:34:48.09,0:34:50.63,teks umum,,0,0,0,,Beraninya anda memperlakukan ini dengan menghina?
Dialog: 0,0:34:53.55,0:34:58.35,teks umum,,0,0,0,,Saya hanya mengatakan bahawa alkimia jiwa adalah sihir yang tidak diiktiraf
Dialog: 0,0:34:59.81,0:35:02.19,teks umum,,0,0,0,,Mengapa dunia harus mengakui perkara ini?
Dialog: 0,0:35:02.90,0:35:06.07,teks umum,,0,0,0,,Apabila kami menemui batu ais di Tasik Gyeongcheongdaeho sepuluh tahun yang lalu,
Dialog: 0,0:35:06.15,0:35:09.78,teks umum,,0,0,0,,kita boleh menggunakan kuasanya untuk memartabatkan keluarga Choi
Dialog: 0,0:35:09.86,0:35:10.86,teks umum,,0,0,0,,Walau bagaimanapun,
Dialog: 0,0:35:10.95,0:35:14.03,teks umum,,0,0,0,,anda berkeras supaya saya masuk ke dalam badan permaisuri,
Dialog: 0,0:35:14.12,0:35:16.41,teks umum,,0,0,0,,mencipta organisasi rahsia di Jeonbugwan,
Dialog: 0,0:35:16.49,0:35:17.66,teks umum,,0,0,0,,dan sekarang
Dialog: 0,0:35:18.54,0:35:22.46,teks umum,,0,0,0,,anda menuntut untuk mendedahkan batu ais kepada dunia melalui Jinyeowon
Dialog: 0,0:35:23.79,0:35:27.84,teks umum,,0,0,0,,Terlalu berbahaya untuk melawan dunia dengan bantuan ilmu sihir
Dialog: 0,0:35:27.92,0:35:31.76,teks umum,,0,0,0,,Ini bukan tentang bahaya, tetapi tentang penghinaan anda
Dialog: 0,0:35:32.26,0:35:34.72,teks umum,,0,0,0,,Saya tidak mahu dicap sebagai ilmu sihir
Dialog: 0,0:35:34.80,0:35:38.93,teks umum,,0,0,0,,Saya mahu menggunakan kuasa supaya semua orang menyembah awak
Dialog: 0,0:35:42.27,0:35:44.77,teks umum,,0,0,0,,Mengapa anda begitu terdesak mencari pengiktirafan?
Dialog: 0,0:35:46.77,0:35:50.03,teks umum,,0,0,0,, Kerana anda tidak dapat menerima hakikat bahawa
Dialog: 0,0:35:50.90,0:35:53.99,teks umum,,0,0,0,,dilahirkan kerana hubungan sulit bapanya dan tidak pernah diiktiraf
Dialog: 0,0:35:54.61,0:35:59.45,teks umum,,0,0,0,,ahli keluarga Jin, kenapa awak perlu mengibaskan ekor awak seperti anjing kecil di hadapan semua orang?
Dialog: 0,0:36:13.05,0:36:18.10,teks umum,,0,0,0,,Nampaknya, jawatan permaisuri telah menjadi beban baginya,
Dialog: 0,0:36:18.18,0:36:22.39,teks umum,,0,0,0,,bahawa dia sebelum ini menerima sen untuk ramalan nasibnya
Dialog: 0,0:36:26.73,0:36:31.53,teks umum,,0,0,0,,Jika ia sangat sukar, saya akan memberikan anda beberapa mangsa manusia
Dialog: 0,0:36:31.61,0:36:36.11,teks umum,,0,0,0,,Cukuplah jiwa mereka dan tarik diri anda bersama
Dialog: 0,0:37:03.39,0:37:06.48,italic,,0,0,0,,Adakah anda telah menemui ratu sebenar?
Dialog: 0,0:37:07.73,0:37:11.27,teks umum,,0,0,0,,Adakah anda membawanya ke Sosnovy Bor?
Dialog: 0,0:37:11.36,0:37:12.32,teks umum,,0,0,0,,Ya
Dialog: 0,0:37:12.40,0:37:14.24,teks umum,,0,0,0,,Dia bersama Jin Cho Young
Dialog: 0,0:37:17.07,0:37:18.82,teks umum,,0,0,0,,Bawa dia ke dewan ilmiah
Dialog: 0,0:37:18.91,0:37:20.45,teks umum,,0,0,0,,Saya akan mendedahkan kebenaran kepada semua orang
Dialog: 0,0:37:21.16,0:37:22.29,teks umum,,0,0,0,,Tidak, bab
Dialog: 0,0:37:22.95,0:37:26.12,teks umum,,0,0,0,,Ceritakan ini hanya kepada keluarga diraja dan penduduk Jinyeowon
Dialog: 0,0:37:27.50,0:37:31.71,teks umum,,0,0,0,,Anda adalah ketua masa depan Sosnovy Bor,
Dialog: 0,0:37:31.80,0:37:35.59,teks umum,,0,0,0,,tetapi awak berdiri di sini dan bimbang tentang reputasi Jinyoewon?
Dialog: 0,0:37:37.30,0:37:38.89,teks umum,,0,0,0,,Saya tidak menafikannya
Dialog: 0,0:37:40.68,0:37:43.89,teks umum,,0,0,0,,Tetapi Sosnovy Bor juga bertanggungjawab untuk ini
Dialog: 0,0:37:45.60,0:37:49.27,teks umum,,0,0,0,,Mage of Sosnovy Bor adalah permulaan segala-galanya
Dialog: 0,0:37:49.35,0:37:52.36,teks umum,,0,0,0,,Mage dari Sosnovy Bor? WHO?
Dialog: 0,0:37:53.15,0:37:56.95,teks umum,,0,0,0,,Ayah Jang Wook, Gwangju Chang Gang
Dialog: 0,0:38:16.63,0:38:18.38,contact,,0,0,0,,Atas permintaan Sosnovy Bor
Dialog: 0,0:38:18.47,0:38:21.64,teks umum,,0,0,0,,Saya menghantar semua orang kecuali ahli silap mata Jeonbugwan dan Jinyeowon
Dialog: 0,0:38:23.05,0:38:24.68,teks umum,,0,0,0,,Apa yang anda ingin beritahu kami?
Dialog: 0,0:38:26.18,0:38:30.73,teks umum,,0,0,0,,Saya dengar Putera Mahkota sedang mencari seseorang baru-baru ini
Dialog: 0,0:38:31.48,0:38:33.52,miring,,0,0,0,,Pak Dan Gu, ahli silap mata Jeonjingak,
Dialog: 0,0:38:33.61,0:38:36.78,teks umum,,0,0,0,,dan Jin Cho Young, paderi perempuan Jinyoung menemui lelaki ini
Dialog: 0,0:38:38.24,0:38:40.16,teks umum,,0,0,0,,Adakah Putera Mahkota sedang mencari seseorang?
Dialog: 0,0:38:41.28,0:38:42.57,teks umum,,0,0,0,,Dan siapakah itu?
Dialog: 0,0:38:44.20,0:38:46.75,teks umum,,0,0,0,,Orang ini ada di sini sekarang
Dialog: 0,0:38:51.71,0:38:53.00,teks umum,,0,0,0,,Saya mendengar seseorang membaling batu,
Dialog: 0,0:38:53.08,0:38:55.80,teks umum,,0,0,0,,di mana ada tertulis bahawa batu ais menghilangkan kekuatan apabila melemparkan mantra
Dialog: 0,0:38:55.88,0:38:58.84,teks umum,,0,0,0,,Mereka tidak boleh menggunakan mantra?
Dialog: 0,0:38:58.92,0:39:01.30,teks umum,,0,0,0,,Kuasa yang sama digunakan dalam alkimia jiwa
Dialog: 0,0:39:01.38,0:39:04.76,teks umum,,0,0,0,,Saya rasa batu itu menghilangkan kekuatan dengan cara yang sama ia menyedut jiwa
Dialog: 0,0:39:04.85,0:39:08.43,teks umum,,0,0,0,,Lalu apa yang akan berlaku kepada anak-anak kita?
Dialog: 0,0:39:08.52,0:39:10.73,teks umum,,0,0,0,,Kamu semua sangat ingin membunuh seseorang,
Dialog: 0,0:39:10.81,0:39:13.40,teks umum,,0,0,0,,untuk melihat kekuatan batu itu
Dialog: 0,0:39:13.48,0:39:15.36,teks umum,,0,0,0,,Adakah anda takut sekarang?
Dialog: 0,0:39:15.94,0:39:19.86,teks umum,,0,0,0,,Kuasa batu ais di luar kawalan manusia
Dialog: 0,0:39:19.95,0:39:22.78,teks umum,,0,0,0,,Itulah sebabnya Sosnovy Bor berkeras untuk memusnahkannya
Dialog: 0,0:39:22.86,0:39:24.91,teks umum,,0,0,0,,Maka Sosnovy Bor mesti mengambil tindakan
Dialog: 0,0:39:25.45,0:39:27.41,teks umum,,0,0,0,,Anak saya ada di sana
Dialog: 0,0:39:27.49,0:39:28.95,teks umum,,0,0,0,,Cucu perempuan saya juga
Dialog: 0,0:39:29.45,0:39:32.33,teks umum,,0,0,0,,Kalaulah saya tahu apa yang perlu saya lakukan, saya tidak akan berdiri di sini sahaja
Dialog: 0,0:39:33.67,0:39:35.21,teks umum,,0,0,0,,Semua orang di sini dahaga
Dialog: 0,0:39:35.29,0:39:37.63,teks umum,,0,0,0,,kuasa syurga, dan lihat ke mana arahnya
Dialog: 0,0:39:38.42,0:39:40.84,teks umum,,0,0,0,,Bagaimana jika ini membawa kepada huru-hara,
Dialog: 0,0:39:40.92,0:39:43.68,teks umum,,0,0,0,,seperti 200 tahun dahulu?
Dialog: 0,0:39:44.26,0:39:45.35,teks umum,,0,0,0,,So Kyung...
Dialog: 0,0:39:46.35,0:39:48.35,teks umum,,0,0,0,,Cikgu So Kyung memusnahkan batu ais
Dialog: 0,0:39:49.47,0:39:52.31,teks umum,,0,0,0,,Dia tidak meninggalkan apa-apa selain "Kata-Kata Hati"?
Dialog: 0,0:39:52.39,0:39:56.27,teks umum,,0,0,0,,Puisi ini adalah satu-satunya perkara yang kita ada
Dialog: 0,0:39:57.32,0:39:59.57,teks umum,,0,0,0,,Kami telah menyeru kepada kuasa batu ais,
Dialog: 0,0:39:59.65,0:40:02.28,teks umum,,0,0,0,,salah seorang daripada kita perlu membetulkannya,
Dialog: 0,0:40:03.24,0:40:05.78,teks umum,,0,0,0,,seperti Master So Kyung bertahun-tahun yang lalu
Dialog: 0,0:40:12.21,0:40:15.04,teks umum,,0,0,0,,Panggil hujan untuk menghilangkan kuasa batu itu?
Dialog: 0,0:40:16.13,0:40:17.92,teks umum,,0,0,0,,Tidak pasti jika hujan,
Dialog: 0,0:40:18.00,0:40:21.17,teks umum,,0,0,0,,dan adakah hujan ini dapat membebaskan kita daripada halangan
Dialog: 0,0:40:22.01,0:40:23.55,teks umum,,0,0,0,,Satu perkara yang pasti
Dialog: 0,0:40:24.47,0:40:26.05,teks umum,,0,0,0,,Jika anda menggunakan Tansu di sini...
Dialog: 0,0:40:27.01,0:40:28.10,teks umum,,0,0,0,,Chan Uk...
Dialog: 0,0:40:29.01,0:40:31.02,teks umum,,0,0,0,,anda akan kehilangan semua tenaga anda
Dialog: 0,0:40:32.14,0:40:33.52,teks umum,,0,0,0,,Saya tahu
Dialog: 0,0:40:33.60,0:40:35.10,teks umum,,0,0,0,,Dan masih mahu mencuba?
Dialog: 0,0:40:38.02,0:40:40.28,teks umum,,0,0,0,,Mungkin anda bukan ahli silap mata peringkat tinggi,
Dialog: 0,0:40:40.86,0:40:43.82,teks umum,,0,0,0,,tetapi anda masih melalui banyak perkara untuk sampai sejauh ini
Dialog: 0,0:40:44.49,0:40:46.03,teks umum,,0,0,0,,Dan anda bersetuju untuk kehilangan segala-galanya?
Dialog: 0,0:40:49.12,0:40:50.79,teks umum,,0,0,0,,Saya akan berurusan dengannya
Dialog: 0,0:40:51.37,0:40:53.46,teks umum,,0,0,0,,Tetapi saya mahu anda membantu saya dengan sesuatu
Dialog: 0,0:40:55.12,0:40:57.79,teks umum,,0,0,0,,Jika batu ais itu hilang,
Dialog: 0,0:40:58.46,0:41:01.30,teks umum,,0,0,0,,uruskan yang lain
Dialog: 0,0:41:03.97,0:41:06.55,teks umum,,0,0,0,,Mereka yang mendambakan kuasanya akan menjadi marah
Dialog: 0,0:41:06.63,0:41:10.31,teks umum,,0,0,0,,Mereka mungkin mengesyaki ada sesuatu yang tidak kena dan berfikir bahawa ia tersembunyi di suatu tempat
Dialog: 0,0:41:10.39,0:41:14.60,teks umum,,0,0,0,,Iaitu, bertindak seolah-olah saya memusnahkan batu itu
Dialog: 0,0:41:14.68,0:41:16.81,teks umum,,0,0,0,,dan berurusan dengan akibatnya?
Dialog: 0,0:41:16.90,0:41:20.15,teks umum,,0,0,0,, Bertanggungjawab atas apa yang anda lakukan?
Dialog: 0,0:41:20.23,0:41:22.28,teks umum,,0,0,0,,Saya minta anda menyusun segala-galanya
Dialog: 0,0:41:22.36,0:41:25.07,teks umum,,0,0,0,,selepas kekacauan yang saya buat
Dialog: 0,0:41:30.16,0:41:31.24,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:41:31.95,0:41:34.20,teks umum,,0,0,0,,selain tenaga, anda boleh kehilangan nyawa anda
Dialog: 0,0:41:34.29,0:41:36.08,teks umum,,0,0,0,,Jangan jadi bodoh, lupakan sahaja
Dialog: 0,0:41:39.08,0:41:41.00,teks umum,,0,0,0,,Guru saya yang luar biasa
Dialog: 0,0:41:41.54,0:41:44.76,teks umum,,0,0,0,,sentiasa menolak saya ke tepi tebing dan berkata yang berikut:
Dialog: 0,0:41:45.30,0:41:48.76,miring,,0,0,0,,"Lebih baik mati daripada tidak berbuat apa-apa"
Dialog: 0,0:41:51.10,0:41:54.85,teks umum,,0,0,0,,Saya akan cuba bukan kerana kebodohan, tetapi kerana kedegilan
Dialog: 0,0:41:55.73,0:41:57.64,teks umum,,0,0,0,,Inilah yang diajar oleh guru saya
Dialog: 0,0:42:01.90,0:42:03.82,teks umum,,0,0,0,,Saya tidak tahu anda mempunyai guru
Dialog: 0,0:42:03.90,0:42:07.74,teks umum,,0,0,0,,Siapa ini? Cikgu Lee Chul?
Dialog: 0,0:42:09.78,0:42:10.78,miring,,0,0,0,,Hos
Dialog: 0,0:42:14.58,0:42:15.75,teks umum,,0,0,0,,Saya membawa pedang
Dialog: 0,0:42:22.54,0:42:23.50,teks umum,,0,0,0,,Won Moo Deok
Dialog: 0,0:42:24.96,0:42:27.63,teks umum,,0,0,0,,Adakah anda tidak akan membicarakannya tentang sikap melulu ini?
Dialog: 0,0:42:29.01,0:42:32.76,teks umum,,0,0,0,,Lebih baik mati daripada tidak berbuat apa-apa
Dialog: 0,0:42:36.60,0:42:37.56,teks umum,,0,0,0,,Hos,
Dialog: 0,0:42:39.06,0:42:40.60,teks umum,,0,0,0,,buat apa yang perlu
Dialog: 0,0:42:41.19,0:42:42.23,teks umum,,0,0,0,,Dan...
Dialog: 0,0:42:43.15,0:42:44.73,teks umum,,0,0,0,,Saya percaya pada awak
Dialog: 0,0:43:03.21,0:43:08.21,teks umum,,0,0,0,,Orang yang akan masuk ke sini berada dalam keadaan yang teruk
Dialog: 0,0:43:08.80,0:43:10.13,teks umum,,0,0,0,,20 tahun yang lalu
Dialog: 0,0:43:10.22,0:43:13.60,teks umum,,0,0,0,,dia melemparkan dirinya ke dalam api untuk bersembunyi daripada Jeonbugwan
Dialog: 0,0:43:19.43,0:43:21.64,teks umum,,0,0,0,,Ini bomoh, dia sedang meramal nasib
Dialog: 0,0:43:22.81,0:43:24.15,teks umum,,0,0,0,,dan orang terkutuk
Dialog: 0,0:43:27.28,0:43:28.53,teks umum,,0,0,0,, Dukun?
Dialog: 0,0:43:29.28,0:43:33.07,teks umum,,0,0,0,,Dia dikunci seperti haiwan untuk masa yang sangat lama,
Dialog: 0,0:43:33.16,0:43:36.74,teks am,,0,0,0,,di dalam penjara kecil di kedai pakar herba di kampung Gema
Dialog: 0,0:43:39.20,0:43:42.04,teks umum,,0,0,0,,Mengapa dia dikunci?
Dialog: 0,0:43:42.12,0:43:44.29,teks umum,,0,0,0,,Saya meminta anda untuk mengadakan mesyuarat ini
Dialog: 0,0:43:45.00,0:43:47.42,teks umum,,0,0,0,,berharap untuk mengetahui, Yang Mulia
Dialog: 0,0:43:49.17,0:43:50.72,italik,,0,0,0,,Semua orang yang ada di sini,
Dialog: 0,0:43:50.80,0:43:56.26,teks umum,,0,0,0,,berhubung dengan Shaman Choi, seorang wanita yang akan memasuki bilik ini tidak lama lagi
Dialog: 0,0:43:58.06,0:44:00.31,teks umum,,0,0,0,,- Itu sahaja?\N- {\i1}Yang Mulia
Dialog: 0,0:44:00.39,0:44:02.73,teks umum,,0,0,0,,Sekarang bukan masa untuk ini
Dialog: 0,0:44:03.31,0:44:04.85,contact,,0,0,0,,Batu ais lebih penting
Dialog: 0,0:44:04.94,0:44:06.90,teks umum,,0,0,0,,Adalah lebih penting untuk menyelamatkan Putera Mahkota
Dialog: 0,0:44:13.40,0:44:18.20,teks am,,0,0,0,,Ketua Pak, bawa bomoh ke sini
Dialog: 0,0:44:23.75,0:44:25.08,teks umum,,0,0,0,,Masuk
Dialog: 0,0:45:12.55,0:45:16.13,teks umum,,0,0,0,,Shaman Choi, tunjukkan muka awak
Dialog: 0,0:45:43.62,0:45:45.08,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:45:46.75,0:45:51.59,teks umum,,0,0,0,,Walaupun dalam mimpi saya, saya tidak pernah membayangkan bahawa saya akan melihat wajah awak lagi
Dialog: 0,0:45:52.67,0:45:55.42,teks umum,,0,0,0,,Adakah anda mengenali saya?
Dialog: 0,0:45:55.51,0:45:58.43,teks umum,,0,0,0,,Saya isteri tuan, Yang Amat Mulia
Dialog: 0,0:45:58.97,0:46:02.18,teks umum,,0,0,0,,Saya, So Ha Sun, Ratu Daeho
Dialog: 0,0:46:03.14,0:46:04.14,miring,,0,0,0,,Diam!
Dialog: 0,0:46:04.22,0:46:07.35,teks umum,,0,0,0,,Beraninya awak sebut nama saya dengan mulut kotor awak?
Dialog: 0,0:46:08.02,0:46:09.77,teks umum,,0,0,0,,Saya adalah ratu negara ini!
Dialog: 0,0:46:09.85,0:46:11.44,teks umum,,0,0,0,,Beraninya awak?
Dialog: 0,0:46:12.19,0:46:13.78,teks umum,,0,0,0,,Anda melakukan ini kepada saya
Dialog: 0,0:46:14.36,0:46:17.70,teks umum,,0,0,0,,Anda, bomoh yang menyedihkan, alkimia jiwa yang digunakan
Dialog: 0,0:46:17.78,0:46:20.32,teks umum,,0,0,0,,untuk memindahkan jiwa kotor anda...
Dialog: 0,0:46:21.57,0:46:25.91,teks umum,,0,0,0,, ke dalam badan suci saya, badan permaisuri!
Dialog: 0,0:46:26.00,0:46:27.83,teks umum,,0,0,0,,Saya sudah cukup dengan pembohongan awak
Dialog: 0,0:46:28.50,0:46:30.12,teks umum,,0,0,0,,Timbalan Gwangju, jangan berdiri di sana!
Dialog: 0,0:46:30.21,0:46:32.29,miring,,0,0,0,,Diamlah perempuan gila itu sekarang!
Dialog: 0,0:46:34.34,0:46:38.47,contact,,0,0,0,,Pertama, kita perlu menyemak
Dialog: 0,0:46:38.55,0:46:40.84,teks umum,,0,0,0,,adakah dia berbohong atau tidak
Dialog: 0,0:46:42.35,0:46:43.39,teks umum,,0,0,0,,Okey
Dialog: 0,0:46:44.47,0:46:46.27,teks umum,,0,0,0,,Dia berkata jiwanya telah dipindahkan
Dialog: 0,0:46:46.35,0:46:49.56,teks umum,,0,0,0,,Mari kita periksa sama ada Ratu mempunyai tanda biru di badannya
Dialog: 0,0:46:54.23,0:46:58.15,teks umum,,0,0,0,,Saya dengan senang hati akan menunjukkannya kepada anda untuk membantu menghilangkan syak wasangka
Dialog: 0,0:47:08.58,0:47:12.21,teks umum,,0,0,0,, Patutkah saya dedahkan bahu saya di sini?
Dialog: 0,0:47:12.29,0:47:16.50,teks umum,,0,0,0,,Tanda biru boleh ditanggalkan dengan mudah
Dialog: 0,0:47:16.59,0:47:18.09,teks umum,,0,0,0,,Jika tidak, tiada apa yang boleh dibuktikan
Dialog: 0,0:47:21.80,0:47:23.30,teks umum,,0,0,0,,Kami ada Gwigu
Dialog: 0,0:47:32.35,0:47:33.69,contact,,0,0,0,,Saya ada abu
Dialog: 0,0:47:33.77,0:47:38.90,teks umum,,0,0,0,,anjing yang dibakar di mana jiwa Gwigu hidup
Dialog: 0,0:47:40.61,0:47:43.03,teks umum,,0,0,0,,Apa yang tinggal dari pasukan Gwigu akan membantu kita...
Dialog: 0,0:47:48.54,0:47:49.41,teks umum,,0,0,0,,mendedahkan kebenaran
Dialog: 0,0:47:54.21,0:47:56.00,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:47:59.84,0:48:02.26,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:48:09.27,0:48:10.52,teks umum,,0,0,0,,Anda lihat,
Dialog: 0,0:48:11.48,0:48:12.60,teks umum,,0,0,0,,itu...
Dialog: 0,0:48:13.90,0:48:15.61,teks umum,,0,0,0,,baru sahaja mengumpul abu
Dialog: 0,0:48:16.56,0:48:18.07,teks umum,,0,0,0,,dari brazier
Dialog: 0,0:48:32.00,0:48:33.83,teks umum,,0,0,0,,Anda baru saja membuktikannya sendiri,
Dialog: 0,0:48:34.42,0:48:37.92,teks umum,,0,0,0,,bahawa anda seorang nomad
Dialog: 0,0:48:47.35,0:48:49.14,teks umum,,0,0,0,,Rebut bomoh Choi,
Dialog: 0,0:48:49.22,0:48:53.43,teks umum,,0,0,0,,yang menggunakan alkimia jiwa untuk merebut kuasa
Dialog: 0,0:48:53.52,0:48:54.81,teks umum,,0,0,0,,dalam badan permaisuri!
Dialog: 0,0:48:54.89,0:48:55.98,condong,,0,0,0,,- Ya!\N- Ya!
Dialog: 0,0:48:56.60,0:48:57.73,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:49:00.27,0:49:04.03,teks umum,,0,0,0,,Jangan cederakan dia. Ini badan saya
Dialog: 0,0:49:04.78,0:49:08.03,teks umum,,0,0,0,,Jiwa saya mesti kembali ke badan ini. Jangan membahayakan dia
Dialog: 0,0:49:09.12,0:49:10.74,teks umum,,0,0,0,,Jangan mendekat
Dialog: 0,0:49:12.20,0:49:16.37,teks umum,,0,0,0,,Jika tidak, saya akan mengoyak badan ini menjadi kepingan
Dialog: 0,0:49:16.96,0:49:18.83,teks umum,,0,0,0,,Dia adalah keturunan ahli silap mata Choi,
Dialog: 0,0:49:18.92,0:49:22.17,teks umum,,0,0,0,,yang menyebabkan Kekacauan Besar 200 tahun yang lalu
Dialog: 0,0:49:23.59,0:49:26.80,teks umum,,0,0,0,,Dan reflektor itu mungkin hasil kerjanya
Dialog: 0,0:49:27.72,0:49:30.22,teks umum,,0,0,0,,Ini menerangkan kemunculan penelan jiwa baru-baru ini
Dialog: 0,0:49:31.26,0:49:33.22,miring,,0,0,0,,Ini ahli sihir jahat
Dialog: 0,0:49:33.31,0:49:35.89,contact,,0,0,0,,menunjukkan batu ais di hadapan Majlis Bersatu
Dialog: 0,0:49:36.48,0:49:38.44,teks umum,,0,0,0,,dan membuat semua orang kelihatan seperti orang bodoh
Dialog: 0,0:49:39.61,0:49:41.44,teks umum,,0,0,0,,Semua ahli silap mata di Deho
Dialog: 0,0:49:42.57,0:49:45.86,teks umum,,0,0,0,,Keluarga diraja, Jeonbugwan dan Jinyeowon
Dialog: 0,0:49:46.45,0:49:48.49,contact,,0,0,0,,Semua orang tertipu
Dialog: 0,0:49:48.57,0:49:53.62,teks umum,,0,0,0,,adik lelaki dan perempuan keluarga Choi
Dialog: 0,0:49:55.04,0:49:56.21,teks umum,,0,0,0,,"Abang dan kakak"?
Dialog: 0,0:50:03.30,0:50:04.67,teks umum,,0,0,0,,Jadi,
Dialog: 0,0:50:05.80,0:50:09.22,teks am,,0,0,0,,kamu dengan bomoh ni adik beradik?
Dialog: 0,0:50:13.76,0:50:15.56,teks umum,,0,0,0,,Adakah anda ahli keluarga Choi?
Dialog: 0,0:50:23.52,0:50:24.98,teks umum,,0,0,0,,Ya
Dialog: 0,0:50:29.36,0:50:30.61,teks umum,,0,0,0,,Maaf
Dialog: 0,0:50:34.04,0:50:36.41,huruf miring,,0,0,0,,Anak perempuan yang baru kamu temui, Jin Bu Young,
Dialog: 0,0:50:36.50,0:50:38.12,teks umum,,0,0,0,,juga palsu,
Dialog: 0,0:50:39.33,0:50:40.46,teks umum,,0,0,0,,yang mereka ambil
Dialog: 0,0:50:41.83,0:50:45.96,teks umum,,0,0,0,,Rancangan seterusnya adalah untuk berpindah ke badan
Dialog: 0,0:50:46.05,0:50:48.38,teks umum,,0,0,0,,waris Jinyeowon
Dialog: 0,0:51:00.52,0:51:01.73,contact,,0,0,0,,Shaman Choi,
Dialog: 0,0:51:01.81,0:51:03.40,teks umum,,0,0,0,,letakkan keris
Dialog: 0,0:51:03.48,0:51:06.44,teks umum,,0,0,0,,dan kembalikan mayat ini kepada Duli Yang Teramat Mulia
Dialog: 0,0:51:06.53,0:51:07.74,teks umum,,0,0,0,,Lakukan seperti yang saya katakan,
Dialog: 0,0:51:08.65,0:51:13.49,teks umum,,0,0,0,,dan saya akan menyelamatkan nyawa abang awak
Dialog: 0,0:51:25.80,0:51:27.51,teks umum,,0,0,0,,Awak cakap saya jahat
Dialog: 0,0:51:30.17,0:51:31.80,teks umum,,0,0,0,,Tetapi tiada sesiapa di sini
Dialog: 0,0:51:32.84,0:51:35.89,teks umum,,0,0,0,,tidak berhak memanggil saya begitu
Dialog: 0,0:51:37.39,0:51:38.85,condong,,0,0,0,,Nak tahu
Dialog: 0,0:51:38.93,0:51:42.73,teks umum,,0,0,0,,bagaimanakah saya berjaya mengambil alih badan keramat permaisuri?
Dialog: 0,0:51:44.61,0:51:49.07,teks umum,,0,0,0,,Dia dengan senang hati memberikan tubuhnya kepada saya kerana dia mahu menggerakkan jiwanya
Dialog: 0,0:51:49.15,0:51:51.74,teks umum,,0,0,0,,kepada tubuh yang muda dan cantik
Dialog: 0,0:51:51.82,0:51:52.78,teks umum,,0,0,0,,Jin Ho Kyung!
Dialog: 0,0:51:54.07,0:51:56.95,teks umum,,0,0,0,,Bukankah anda yang mengumumkan batu ais kepada seluruh dunia?
Dialog: 0,0:51:58.12,0:52:01.37,contact,,0,0,0,,Anda adalah ketua Jinyoewon, pelindung peninggalannya
Dialog: 0,0:52:01.46,0:52:02.79,teks umum,,0,0,0,,Dan anda membiarkan batu itu
Dialog: 0,0:52:02.87,0:52:06.25,teks umum,,0,0,0,,biarkan Jinyeowon menggunakannya untuk alkimia
Dialog: 0,0:52:07.84,0:52:11.76,teks umum,,0,0,0,,Dan orang yang melakukan alkimia jiwa,
Dialog: 0,0:52:13.22,0:52:15.01,teks umum,,0,0,0,,adalah ahli silap mata Sosnovy Bor
Dialog: 0,0:52:16.05,0:52:17.56,italic,,0,0,0,,Park Jin!
Dialog: 0,0:52:17.64,0:52:20.35,teks umum,,0,0,0,,Anda menyembunyikan kebenaran walaupun pada hakikatnya anda tahu segala-galanya
Dialog: 0,0:52:21.06,0:52:25.27,teks umum,,0,0,0,,Bertindak seolah-olah anda tidak sabar untuk menangkap semua orang yang melakukan sihir
Dialog: 0,0:52:25.35,0:52:30.23,teks umum,,0,0,0,,Tetapi kamu hanya cuba menyembunyikan dosa ahli silap mata itu
Dialog: 0,0:52:39.95,0:52:41.41,teks umum,,0,0,0,,Adapun awak, Jin Mu
Dialog: 0,0:52:42.83,0:52:46.63,teks umum,,0,0,0,,Mengapa kamu hanya berdiri di situ tanpa berbuat apa-apa?
Dialog: 0,0:52:48.59,0:52:52.80,teks umum,,0,0,0,,Saya adalah satu-satunya yang jahat, berdasarkan logik dan justifikasi anda,
Dialog: 0,0:52:54.26,0:52:56.09,teks umum,,0,0,0,,yang anda buat
Dialog: 0,0:53:07.35,0:53:09.40,teks umum,,0,0,0,,Logik ditentukan oleh kuasa
Dialog: 0,0:53:09.48,0:53:14.36,teks umum,,0,0,0,,Anda telah kehilangan kuasa anda dan itu menjadikan anda jahat
Dialog: 0,0:53:18.20,0:53:20.16,teks umum,,0,0,0,,Jin Mu, anda tidak akan gagal untuk mengecewakan
Dialog: 0,0:53:21.20,0:53:25.08,teks umum,,0,0,0,,Kebaktianmu berubah-ubah seperti angin
Dialog: 0,0:53:25.16,0:53:27.21,teks umum,,0,0,0,,Lepasi seluruh pemantul
Dialog: 0,0:53:28.00,0:53:29.50,teks umum,,0,0,0,,Kami akan mengembalikan mayat permaisuri,
Dialog: 0,0:53:29.59,0:53:31.67,teks umum,,0,0,0,,dan anda tidak akan membatu
Dialog: 0,0:53:32.88,0:53:37.13,teks umum,,0,0,0,,saya nasihatkan awak ikut kata saya kalau awak nak adik awak hidup
Dialog: 0,0:53:38.22,0:53:39.72,miring,,0,0,0,,Kakak
Dialog: 0,0:53:39.80,0:53:42.52,teks umum,,0,0,0,,Gunakan baki reflektor untuk melarikan diri
Dialog: 0,0:53:44.60,0:53:47.39,teks umum,,0,0,0,,Ini satu-satunya perkara yang boleh saya lakukan untuk anda
Dialog: 0,0:53:49.94,0:53:51.02,teks umum,,0,0,0,,Saya minta maaf
Dialog: 0,0:53:54.53,0:53:55.86,teks umum,,0,0,0,,Bapa!
Dialog: 0,0:53:55.95,0:53:57.07,condong,,0,0,0,,Bapa!
Dialog: 0,0:53:58.61,0:53:59.57,condong,,0,0,0,,Bapa!
Dialog: 0,0:54:07.46,0:54:08.62,contact,,0,0,0,,Bapa...
Dialog: 0,0:54:20.84,0:54:22.30,contact,,0,0,0,,Bapa...
Dialog: 0,0:54:42.41,0:54:46.58,teks umum,,0,0,0,,Saya akan lakukan seperti yang kamu mahu dan singkirkan batu ais yang jahat itu!
Dialog: 0,0:54:46.66,0:54:47.87,teks umum,,0,0,0,,Walau bagaimanapun,
Dialog: 0,0:54:48.58,0:54:50.54,teks umum,,0,0,0,,sebaik batu ais hilang,
Dialog: 0,0:54:51.38,0:54:56.34,teks umum,,0,0,0,,anda semua akan mati juga
Dialog: 0,0:56:31.39,0:56:32.89,italic,,0,0,0,,- Tengok\N- Apa ini?
Dialog: 0,0:57:31.83,0:57:32.66,teks umum,,0,0,0,,Chan Gan?
Dialog: 0,0:57:33.33,0:57:34.29,italic,,0,0,0,,Adakah ini Chang Gan?
Dialog: 0,0:57:35.00,0:57:37.79,teks umum,,0,0,0,,Jang Gang, Gwangju Jeongbugwan?
Dialog: 0,0:57:38.38,0:57:41.05,italic,,0,0,0,,Chan Gang, betul ke awak tu?
Dialog: 0,0:57:41.63,0:57:43.46,teks umum,,0,0,0,,Apa yang awak buat di sini?
Dialog: 0,0:58:07.86,0:58:09.20,teks umum,,0,0,0,,Pemantul jiwa...
Dialog: 0,0:58:19.46,0:58:21.59,teks umum,,0,0,0,,Tenaga pemantul telah hilang
Dialog: 0,0:58:22.46,0:58:25.30,teks umum,,0,0,0,,Seseorang menghentikannya
Dialog: 0,0:58:29.05,0:58:30.51,teks umum,,0,0,0,,Gwangju Chang Gang di sini
Dialog: 0,0:58:47.32,0:58:48.74,teks umum,,0,0,0,,Chan Gan...
Dialog: 0,0:58:49.95,0:58:52.83,teks umum,,0,0,0,,Anda telah menyerap tenaga pemantul...
Dialog: 0,0:58:54.16,0:58:55.70,teks umum,,0,0,0,, ke dalam badan anda?
Dialog: 0,0:59:02.54,0:59:05.71,italic,,0,0,0,,Jangan dekati dia
Dialog: 0,0:59:05.80,0:59:08.09,teks umum,,0,0,0,,Chan Gan seorang nomad dan dia menjadi liar
Dialog: 0,0:59:08.80,0:59:10.05,contact,,0,0,0,,Tengok
Dialog: 0,0:59:10.13,0:59:13.01,contact,,0,0,0,,Seluruh badannya bertukar menjadi batu
Dialog: 0,0:59:15.64,0:59:16.52,teks umum,,0,0,0,,Dia betul
Dialog: 0,0:59:17.85,0:59:20.98,teks umum,,0,0,0,,Saya melakukan alkimia jiwa terlarang dan menjadi nomad
Dialog: 0,0:59:21.69,0:59:22.90,teks umum,,0,0,0,,Sekarang saya berlari liar
Dialog: 0,0:59:24.40,0:59:26.11,teks umum,,0,0,0,,Anda adalah gwangju Jeonbugwan
Dialog: 0,0:59:26.19,0:59:28.15,teks umum,,0,0,0,,Dan awak menggunakan sihir?
Dialog: 0,0:59:28.24,0:59:31.07,teks umum,,0,0,0,,Cikgu Lee Chul, murid Guru So Kyung,
Dialog: 0,0:59:32.36,0:59:35.99,teks umum,,0,0,0,,memerintahkan saya untuk mengaku dosa saya kepada Majlis Bersatu
Dialog: 0,0:59:37.24,0:59:38.91,teks umum,,0,0,0,,Itulah sebabnya saya di sini
Dialog: 0,0:59:43.67,0:59:46.21,kenangan miring,,0,0,0,,Jika anda masih mempunyai kekuatan untuk membaca surat ini,
Dialog: 0,0:59:46.30,0:59:49.26,kenangan miring,,0,0,0,,gunakan kekuatan yang masih ada untuk membantu mereka yang menderita
Dialog: 0,0:59:49.34,0:59:51.01,kenangan miring,,0,0,0,,kekacauan yang anda buat
Dialog: 0,0:59:52.47,0:59:55.26,kenangan miring,,0,0,0,,Ini adalah peluang untuk anda menyelesaikan apa yang anda mulakan
Dialog: 0,0:59:56.10,0:59:58.93,kenangan miring,,0,0,0,,Kemudian bintang akan terbit,
Dialog: 0,0:59:59.02,1:00:01.06,kenangan condong,,0,0,0,,dan batu itu akan tenggelam
Dialog: 0,1:00:05.52,1:00:07.32,teks umum,,0,0,0,,Saya bertanggungjawab
Dialog: 0,1:00:08.40,1:00:11.49,teks umum,,0,0,0,,untuk semua kesilapan Sosnovy Bor, Jinyeowon dan Jeonbugwan
Dialog: 0,1:00:12.99,1:00:15.03,teks umum,,0,0,0,,Saya mengambil batu ais daripada Jinyeowon
Dialog: 0,1:00:16.12,1:00:18.12,miring,,0,0,0,,dan dia melakukan sihir
Dialog: 0,1:00:19.54,1:00:22.25,contact,,0,0,0,,Saya cuba merahsiakannya
Dialog: 0,1:00:23.75,1:00:26.67,teks umum,,0,0,0,,Saya akan membatu di sini untuk menebus semua dosa saya
Dialog: 0,1:00:29.17,1:00:32.05,teks umum,,0,0,0,,Gwangju Chang Gang adalah orang yang memulakan semuanya,
Dialog: 0,1:00:32.13,1:00:34.68,teks umum,,0,0,0,,jadi saya akan biarkan dia menamatkan perkara ini
Dialog: 0,1:00:35.76,1:00:37.05,teks umum,,0,0,0,,kematian
Dialog: 0,1:00:44.94,1:00:47.73,teks umum,,0,0,0,,Saksikan kejatuhan tragis manusia,
Dialog: 0,1:00:48.69,1:00:50.11,teks umum,,0,0,0,,yang melakukan sihir
Dialog: 0,1:00:50.19,1:00:52.19,teks umum,,0,0,0,,Mungkin dia seorang nomad,
Dialog: 0,1:00:52.28,1:00:53.99,teks umum,,0,0,0,,tetapi anda tidak boleh biarkan dia mati seperti itu
Dialog: 0,1:00:54.07,1:00:56.57,teks umum,,0,0,0,,Anak lelakinya, Chan Wook, di dalam Jeonjingak
Dialog: 0,1:00:56.66,1:00:59.74,miring,,0,0,0,,Tunggu sehingga Chang Wook keluar dari sana
Dialog: 0,1:00:59.83,1:01:03.21,teks umum,,0,0,0,,Dia layak mengucapkan selamat tinggal kepada bapanya
Dialog: 0,1:01:03.29,1:01:05.00,teks umum,,0,0,0,,Dia bukan anak saya!
Dialog: 0,1:01:05.62,1:01:07.67,teks umum,,0,0,0,,Anda semua tahu bahawa saya telah menutup pintu tenaganya,
Dialog: 0,1:01:07.75,1:01:10.00,teks umum,,0,0,0,,untuk menghalang dia daripada mengikut jejak langkah saya
Dialog: 0,1:01:13.84,1:01:15.55,teks umum,,0,0,0,,Masa kecilnya sudah sedih
Dialog: 0,1:01:16.80,1:01:19.10,teks umum,,0,0,0,,Jangan biarkan dia dikenali sebagai anak orang berdosa
Dialog: 0,1:02:26.87,1:02:28.33,di sebalik tabir,,0,0,0,,Di mana saya?
Dialog: 0,1:02:34.09,1:02:36.80,di sebalik tabir,,0,0,0,,Apa yang sedang berlaku? Adakah saya mati?
Dialog: 0,1:02:49.52,1:02:50.69,teks umum,,0,0,0,,Nah, ia berlaku
Dialog: 0,1:02:51.77,1:02:53.52,teks umum,,0,0,0,,Tenaga saya telah hilang
Dialog: 0,1:03:14.29,1:03:15.59,teks am,,0,0,0,,Adakah ini batu ais?
Dialog: 0,1:03:16.80,1:03:20.84,teks umum,,0,0,0,,Temui dia apabila semua kekuatan saya meninggalkan saya
Dialog: 0,1:03:22.39,1:03:23.68,teks umum,,0,0,0,,Bagi saya sekarang
Dialog: 0,1:03:24.89,1:03:26.64,teks umum,,0,0,0,,ini tidak lebih dari sekadar batu
Dialog: 0,1:03:51.21,1:03:53.00,contact,,0,0,0,,Ini adalah bintang Raja!
Dialog: 0,1:03:53.08,1:03:55.63,teks umum,,0,0,0,, Bintang Raja menyala di langit
Dialog: 0,1:04:32.12,1:04:35.00,teks umum,,0,0,0,,Bintang Raja bersinar di langit, dan penghalang tidur
Dialog: 0,1:04:49.81,1:04:51.56,italic,,0,0,0,,Batu ais telah hilang,
Dialog: 0,1:04:52.52,1:04:54.69,contact,,0,0,0,,dan bintang Raja muncul
Dialog: 0,1:04:55.90,1:04:58.23,teks umum,,0,0,0,,Apabila Master So Kyung menghentikan Kekacauan Besar
Dialog: 0,1:04:58.32,1:05:00.69,teks umum,,0,0,0,,bintang Raja juga muncul
Dialog: 0,1:05:01.53,1:05:04.70,contact,,0,0,0,,Jadi seseorang berada di dalam Jeonjingak
Dialog: 0,1:05:04.78,1:05:07.82,contact,,0,0,0,,dilahirkan dengan nasib yang sama dengan Master Seo Kyung?
Dialog: 0,1:05:27.93,1:05:29.76,teks umum,,0,0,0,, Bintang Raja di atasnya
Dialog: 0,1:05:29.85,1:05:31.77,teks umum,,0,0,0,,Ini dia!
Dialog: 0,1:05:46.70,1:05:48.53,teks umum,,0,0,0,,Putera Mahkota
Dialog: 0,1:05:49.12,1:05:52.20,teks umum,,0,0,0,, Bintang Raja telah bersinar untuk anda!
Dialog: 0,1:05:52.29,1:05:54.50,teks umum,,0,0,0,,- Yang Amat Mulia!\N- Yang Amat Mulia!
Dialog: 0,1:06:09.09,1:06:12.01,di sebalik tabir,,0,0,0,,Chan Wook dilahirkan di bawah tanda bintang Raja
Dialog: 0,1:06:13.31,1:06:16.10,suara,,0,0,0,,Adakah dia menghilangkan batu ais itu?
Dialog: 0,1:06:44.30,1:06:46.38,suara,,0,0,0,,Pelajar saya, anda telah kehilangan semua tenaga anda
Dialog: 0,1:06:48.22,1:06:52.22,di sebalik tabir,,0,0,0,,Cikgu, kamu juga telah menjadi Moo Deok
Dialog: 0,1:06:54.85,1:06:56.39,teks umum,,0,0,0,,Saya tidak kisah
Dialog: 0,1:06:57.39,1:06:58.98,teks umum,,0,0,0,,semasa kita bersama
Dialog: 0,1:07:35.51,1:07:38.10,teks umum,,0,0,0,,Saya dengar perkahwinan itu akan berlangsung di Sosnovy Bor
Dialog: 0,1:07:38.18,1:07:40.94,teks umum,,0,0,0,,Sudah tentu. Pengantin lelaki - ahli silap mata Sosnovy Bor
Dialog: 0,1:07:41.44,1:07:43.23,teks umum,,0,0,0,,Saya tidak merestui perkahwinan mereka
Dialog: 0,1:07:43.31,1:07:45.73,teks umum,,0,0,0,,Saya tidak percaya mereka akan berkahwin
Dialog: 0,1:07:45.82,1:07:47.78,teks umum,,0,0,0,,Saya telah melihat mereka bersama beberapa kali
Dialog: 0,1:07:47.86,1:07:49.53,teks umum,,0,0,0,,Mereka kelihatan baik bersama
Dialog: 0,1:07:49.61,1:07:52.41,teks umum,,0,0,0,,Apa? Mereka boleh memilih pengantin lelaki yang lebih baik
Dialog: 0,1:07:52.49,1:07:53.87,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,1:07:53.95,1:07:55.87,contact,,0,0,0,,Perkara yang sama boleh dikatakan tentang pengantin perempuan
Dialog: 0,1:07:55.95,1:07:57.66,teks umum,,0,0,0,,Orang ramai hanya bercakap
Dialog: 0,1:07:57.74,1:08:00.08,teks umum,,0,0,0,,tentang United Council dan bintang Raja
Dialog: 0,1:08:00.16,1:08:03.00,teks umum,,0,0,0,,Dan kini mereka membincangkan perkahwinan yang akan datang
Dialog: 0,1:08:04.63,1:08:07.88,teks umum,,0,0,0,,Itulah sebabnya ketua mendesak perkahwinan itu
Dialog: 0,1:08:07.96,1:08:11.34,teks umum,,0,0,0,,Saya harus mengakui, saya masih tidak percaya bahawa mereka berdua akan berkahwin
Dialog: 0,1:08:14.01,1:08:17.39,teks umum,,0,0,0,,En. Yul, saya dengar awak belum makan apa-apa
Dialog: 0,1:08:18.06,1:08:19.97,teks umum,,0,0,0,,Saya akan makan apabila saya lapar
Dialog: 0,1:08:20.06,1:08:21.77,teks umum,,0,0,0,,Biar saya sediakan kuksa untuk anda
Dialog: 0,1:08:22.39,1:08:24.02,teks am,,0,0,0,,Dan anda perlu makan ubat
Dialog: 0,1:08:26.11,1:08:29.15,teks am,,0,0,0,,Saya tidak perlukan ubat lagi. Berhenti mengganggu saya dengan mereka
Dialog: 0,1:08:29.73,1:08:31.61,teks umum,,0,0,0,,Anda akan kembali ke Kubu Soho tidak lama lagi
Dialog: 0,1:08:31.70,1:08:33.66,teks umum,,0,0,0,,Anda perlu makan dengan baik semasa berada di sini...
Dialog: 0,1:08:40.04,1:08:41.54,teks umum,,0,0,0,,Luka saya telah sembuh
Dialog: 0,1:08:42.54,1:08:43.92,teks umum,,0,0,0,,Tenaga telah kembali juga
Dialog: 0,1:08:45.46,1:08:47.67,teks umum,,0,0,0,,Saya dengar awak mengerang kesakitan semasa tidur
Dialog: 0,1:08:48.59,1:08:50.00,teks umum,,0,0,0,,Saya tahu awak berbohong
Dialog: 0,1:08:52.59,1:08:54.09,teks umum,,0,0,0,,Luka hampir tidak sakit
Dialog: 0,1:09:00.06,1:09:03.39,teks umum,,0,0,0,,Anda pembohong yang teruk
Dialog: 0,1:09:05.19,1:09:08.23,teks umum,,0,0,0,,Anda mempunyai hati yang suci, jadi setiap kali anda berbohong,
Dialog: 0,1:09:08.82,1:09:10.82,teks umum,,0,0,0,,ini jelas
Dialog: 0,1:09:12.78,1:09:14.53,teks umum,,0,0,0,,Ia tertulis di muka anda
Dialog: 0,1:09:16.70,1:09:19.62,teks umum,,0,0,0,,Mestilah sukar untuk anda menyembunyikannya sekian lama
Dialog: 0,1:09:27.25,1:09:28.42,teks umum,,0,0,0,,Maaf
Dialog: 0,1:09:30.55,1:09:32.01,teks umum,,0,0,0,,Dan terima kasih,
Dialog: 0,1:09:33.88,1:09:35.09,teks umum,,0,0,0,,apa yang mereka pertahankan
Dialog: 0,1:09:41.68,1:09:45.14,kenangan miring,,0,0,0,,Yul melindungi kamu selama ini
Dialog: 0,1:09:48.77,1:09:50.82,kenangan,,0,0,0,,Dia tahu siapa kamu
Dialog: 0,1:09:52.19,1:09:53.69,kenangan,,0,0,0,,Mengetahui bahawa anda seorang perantau
Dialog: 0,1:09:53.78,1:09:55.65,kenangan,,0,0,0,,Tahu bahawa anda adalah Nak Soo
Dialog: 0,1:09:56.53,1:09:58.32,kenangan,,0,0,0,,Dia berusaha keras untuk tidak menunjukkannya
Dialog: 0,1:10:03.70,1:10:07.46,kenangan,,0,0,0,,Dia benar-benar ingin melindungi gadis yang ditemuinya di Danhyangok
Dialog: 0,1:10:15.92,1:10:17.38,teks umum,,0,0,0,,Ini
Dialog: 0,1:10:17.47,1:10:20.60,teks umum,,0,0,0,,kepunyaan rakan anda dari Danhyangk
Dialog: 0,1:10:22.10,1:10:23.22,teks umum,,0,0,0,,Ya
Dialog: 0,1:10:25.31,1:10:27.60,teks umum,,0,0,0,,Saya mahu membawanya bersama saya
Dialog: 0,1:10:27.69,1:10:29.77,teks umum,,0,0,0,,ke kubu Soho
Dialog: 0,1:10:35.53,1:10:39.07,teks umum,,0,0,0,,Dia mempunyai rahsia yang dia sembunyikan daripada semua orang
Dialog: 0,1:10:41.16,1:10:43.45,teks umum,,0,0,0,,Jadi saya mahu membawanya ke sana dan menyembunyikannya
Dialog: 0,1:10:48.25,1:10:49.92,teks umum,,0,0,0,,Saya berjanji kepada anda bahawa saya akan membantu
Dialog: 0,1:10:50.75,1:10:53.67,teks umum,,0,0,0,,bawa dia bersama anda
Dialog: 0,1:10:55.71,1:10:59.59,teks umum,,0,0,0,,Tetapi orang ini kini wujud hanya dalam ingatan anda
Dialog: 0,1:11:00.55,1:11:02.43,teks umum,,0,0,0,,Dia tiada lagi di dunia ini
Dialog: 0,1:11:11.65,1:11:13.15,teks umum,,0,0,0,,Pada mulanya saya fikir,
Dialog: 0,1:11:13.23,1:11:16.48,teks umum,,0,0,0,, pembakaran mayat akan memadamkannya dari ingatan anda
Dialog: 0,1:11:17.94,1:11:20.57,teks umum,,0,0,0,,Tetapi kamu berkata bahawa kamu menghargai kenangan daripada Danhyangok
Dialog: 0,1:11:26.33,1:11:27.66,teks umum,,0,0,0,,Bawa dia bersama anda
Dialog: 0,1:11:41.05,1:11:43.18,teks umum,,0,0,0,,Saya ingin memastikan bahawa anda dalam keadaan baik
Dialog: 0,1:11:44.14,1:11:46.39,teks umum,,0,0,0,,Jadi saya ingin merasai tiga hembusan nafas anda
Dialog: 0,1:12:07.20,1:12:09.16,teks umum,,0,0,0,,Mari kita ucapkan selamat tinggal antara satu sama lain
Dialog: 0,1:12:12.00,1:12:14.79,teks umum,,0,0,0,,selagi ketiga-tiga nafas ini bertahan
Dialog: 0,1:12:27.31,1:12:29.68,teks umum,,0,0,0,,Kenangan juga saya sayangi
Dialog: 0,1:12:31.73,1:12:33.60,teks umum,,0,0,0,,dari Danhyanggok
Dialog: 0,1:12:40.74,1:12:42.07,teks umum,,0,0,0,,Terima kasih atas segalanya
Dialog: 0,1:13:22.94,1:13:25.53,teks umum,,0,0,0,,Nampaknya luka anda sembuh dengan baik
Dialog: 0,1:13:26.91,1:13:31.37,teks am,,0,0,0,,Saya tahu ubat itu pahit, tetapi ambil dengan kerap
Dialog: 0,1:13:38.38,1:13:39.50,teks umum,,0,0,0,,Okey
Dialog: 0,1:13:41.17,1:13:43.38,teks umum,,0,0,0,,Saya akan minum, tidak kira betapa pahitnya ia
Dialog: 0,1:13:48.18,1:13:49.89,teks umum,,0,0,0,,Kali ini seluruh luka akan sembuh
Dialog: 0,1:14:29.26,1:14:32.60,teks umum,,0,0,0,,Mengorbankan nyawa saya,
Dialog: 0,1:14:32.68,1:14:38.02,teks umum,,0,0,0,,ayah kamu bertanggungjawab atas apa yang berlaku
Dialog: 0,1:14:38.90,1:14:42.07,italic,,0,0,0,,Berkat pengorbanannya, Sosnovy Bor dan Jinyeowon tidak dihukum
Dialog: 0,1:14:49.95,1:14:52.49,teks umum,,0,0,0,,Mungkin dia menafikan bahawa kamu adalah anaknya,
Dialog: 0,1:14:53.20,1:14:57.62,teks umum,,0,0,0,,kerana dia tidak mahu anda dipersalahkan atas dosanya
Dialog: 0,1:15:01.29,1:15:02.63,teks umum,,0,0,0,,Jangan risau
Dialog: 0,1:15:03.13,1:15:07.26,teks umum,,0,0,0,,Saya tidak lagi mengambil berat tentang hakikat bahawa dia mungkin bukan bapa saya
Dialog: 0,1:15:11.43,1:15:14.89,teks umum,,0,0,0,,Adakah anda mengenali bapa anda?
Dialog: 0,1:15:15.77,1:15:17.89,teks umum,,0,0,0,,Anda tidak pernah berjumpa sebelum ini
Dialog: 0,1:15:20.52,1:15:21.90,teks umum,,0,0,0,,Kami bertemu sekali
Dialog: 0,1:15:23.31,1:15:24.73,teks umum,,0,0,0,,Mungkin kemudian
Dialog: 0,1:15:26.03,1:15:27.49,teks umum,,0,0,0,,dia mengenali saya
Dialog: 0,1:15:28.57,1:15:29.86,kenangan miring,,0,0,0,,Nampaknya awak
Dialog: 0,1:15:30.57,1:15:32.24,kenangan,,0,0,0,,anda tahu siapa saya
Dialog: 0,1:15:32.91,1:15:35.24,kenangan,,0,0,0,,Anda mempunyai pedang Gwangju Jeonbugwan
Dialog: 0,1:15:35.33,1:15:36.83,kenangan,,0,0,0,,Anda mesti anaknya
Dialog: 0,1:16:08.73,1:16:12.11,teks umum,,0,0,0,,Ini adalah pedang dan jubah yang diberikan keluarga diraja kepada Chang Gan,
Dialog: 0,1:16:12.20,1:16:15.49,teks umum,,0,0,0,,bekas gwangju Jeonbugwan, yang meninggal dunia akibat sihir
Dialog: 0,1:16:15.58,1:16:20.29,teks umum,,0,0,0,,Kami ingin anda memutuskan apa yang harus kami lakukan dengan perkara-perkaranya
Dialog: 0,1:16:20.87,1:16:22.33,teks umum,,0,0,0,,Bertolak di Sosnovy Bor
Dialog: 0,1:16:23.75,1:16:25.84,teks umum,,0,0,0,,Adakah anda menemui Timbalan Jin Mu?
Dialog: 0,1:16:26.59,1:16:27.71,teks umum,,0,0,0,,Kami masih mencari dia
Dialog: 0,1:16:28.71,1:16:31.51,teks umum,,0,0,0,,Kami pasti dia masih belum meninggalkan ibu negara
Dialog: 0,1:16:31.59,1:16:33.30,teks umum,,0,0,0,,Dia boleh memiliki badan lain
Dialog: 0,1:16:34.55,1:16:36.97,teks umum,,0,0,0,,Jika dia melakukan kepada dirinya perkara yang sama seperti saya,
Dialog: 0,1:16:37.05,1:16:38.64,teks umum,,0,0,0,,Adakah Sosnovy Bor mengenalinya?
Dialog: 0,1:16:39.77,1:16:41.98,teks umum,,0,0,0,,Anda telah ditipu selama ini
Dialog: 0,1:16:45.90,1:16:47.23,miring,,0,0,0,,Yang Mulia
Dialog: 0,1:16:47.32,1:16:51.03,teks umum,,0,0,0,,Cikgu Kang dari Degangtongun menjadi gila dan membatu,
Dialog: 0,1:16:51.11,1:16:53.20,teks umum,,0,0,0,,tetapi Saejukwon berjaya menyelamatkannya
Dialog: 0,1:16:53.82,1:16:57.37,teks umum,,0,0,0,,Jika anda menjadi liar dan mula berubah menjadi batu,
Dialog: 0,1:16:57.45,1:16:59.29,teks umum,,0,0,0,,kami tahu cara untuk menyelamatkan anda
Dialog: 0,1:17:00.54,1:17:01.83,teks umum,,0,0,0,,Apa gunanya?
Dialog: 0,1:17:02.37,1:17:07.04,teks umum,,0,0,0,,Saya perlu tinggal di dalam badan yang dahsyat ini sepanjang hari-hari saya
Dialog: 0,1:17:09.17,1:17:11.92,teks umum,,0,0,0,,Anda membenarkan Chan Wook untuk hidup, walaupun bapanya bersalah kerana
Dialog: 0,1:17:12.01,1:17:14.13,teks umum,,0,0,0,,apa yang berlaku kepada saya
Dialog: 0,1:17:14.22,1:17:15.51,contact,,0,0,0,,Chang Gan
Dialog: 0,1:17:16.09,1:17:18.60,teks umum,,0,0,0,,mengambil tanggungjawab sepenuhnya, mengorbankan dirinya
Dialog: 0,1:17:19.51,1:17:21.47,teks umum,,0,0,0,,Kami juga telah melucutkan hak Chan Wook
Dialog: 0,1:17:22.35,1:17:25.94,teks umum,,0,0,0,,menjadi gwangju Jeonbugwan seterusnya
Dialog: 0,1:17:27.15,1:17:28.94,teks umum,,0,0,0,,Dia membasuh dosanya,
Dialog: 0,1:17:29.82,1:17:32.19,teks umum,,0,0,0,,kehilangan semua yang saya ada
Dialog: 0,1:17:34.03,1:17:37.57,teks umum,,0,0,0,,Apabila Chang Gang meninggal dunia, dia mengaku Wook bukan anaknya
Dialog: 0,1:17:37.66,1:17:39.70,teks umum,,0,0,0,,Kita tidak boleh mengalihkan tanggungjawab kepadanya
Dialog: 0,1:17:39.78,1:17:43.45,teks umum,,0,0,0,,Chang Gang meninggal dunia tanpa mendedahkan nama bapa kandung Wook
Dialog: 0,1:17:51.63,1:17:53.26,kenangan,,0,0,0,,Cikgu Chang Gan mahu,
Dialog: 0,1:17:54.22,1:17:56.51,kenangan,,0,0,0,,supaya saya berikan ini kepada anda
Dialog: 0,1:18:01.35,1:18:03.93,kenangan,,0,0,0,,Dia berkata ia akan mendedahkan kebenaran
Dialog: 0,1:18:04.93,1:18:07.14,kenangan,,0,0,0,,tentang bapa kandung Encik Chan Wook
Dialog: 0,1:18:30.42,1:18:31.59,kenangan,,0,0,0,,Saya rasa,
Dialog: 0,1:18:32.84,1:18:35.88,kenangan,,0,0,0,,sekarang awak, pembantu Kim, tahu perkara sebenar
Dialog: 0,1:18:37.51,1:18:38.97,kenangan,,0,0,0,,Saya tidak percaya
Dialog: 0,1:18:40.01,1:18:43.81,kenangan,,0,0,0,,Puan Do Hwa melahirkan putera mendiang raja?
Dialog: 0,1:18:44.47,1:18:47.64,kenangan,,0,0,0,,Uka dikandung apabila mendiang raja menggerakkan jiwanya...
Dialog: 0,1:18:48.77,1:18:51.48,kenangan,,0,0,0,,dan berbaring dengan Do Hwa
Dialog: 0,1:18:52.19,1:18:56.53,kenangan,,0,0,0,,Chan Gan melakukan alkimia dan bertukar jiwa...
Dialog: 0,1:18:58.57,1:19:00.20,kenangan,,0,0,0,,dengan mendiang raja
Dialog: 0,1:19:02.28,1:19:07.12,kenangan,,0,0,0,,Cikgu Chang Gan merosakkan kehidupan anaknya
Dialog: 0,1:19:08.96,1:19:10.58,teks umum,,0,0,0,,Jika lelaki itu mengetahui perkara ini...
Dialog: 0,1:19:12.08,1:19:13.67,teks umum,,0,0,0,,Saya tidak akan mendedahkan ini
Dialog: 0,1:19:15.17,1:19:18.80,teks umum,,0,0,0,,Bukan sahaja Uku,
Dialog: 0,1:19:19.97,1:19:21.93,teks umum,,0,0,0,,Saya akan merahsiakan perkara ini daripada semua orang
Dialog: 0,1:19:25.93,1:19:29.27,teks umum,,0,0,0,,Bintang yang muncul di langit apabila anda memusnahkan batu ais,
Dialog: 0,1:19:29.35,1:19:31.73,teks umum,,0,0,0,,terpahat pada tablet buruj
Dialog: 0,1:19:31.81,1:19:35.48,teks umum,,0,0,0,,Semua orang gembira menyambut raja, dilahirkan di bawah undang-undang bintang Raja
Dialog: 0,1:19:35.57,1:19:37.23,miring,,0,0,0,,Adakah anda ingin melihat papan tanda itu?
Dialog: 0,1:19:39.15,1:19:40.32,teks umum,,0,0,0,,Tidak
Dialog: 0,1:19:52.71,1:19:54.09,teks umum,,0,0,0,,Timbalan Gwangju
Dialog: 0,1:19:55.13,1:19:57.51,teks umum,,0,0,0,,menempatkan semula jiwa dan hilang?
Dialog: 0,1:20:28.29,1:20:30.50,teks umum,,0,0,0,,Tersembunyi dalam Jeonbugwan selama ini?
Dialog: 0,1:20:31.00,1:20:34.21,teks umum,,0,0,0,,Saya telah menunggu peluang untuk bertemu dengan Tuanku.
Dialog: 0,1:20:36.75,1:20:39.17,teks umum,,0,0,0,,Adakah anda meminta saya untuk menyelamatkan nyawa anda?
Dialog: 0,1:20:39.26,1:20:41.88,teks umum,,0,0,0,,Hanya anda boleh menyelamatkan saya,
Dialog: 0,1:20:41.97,1:20:45.64,teks umum,,0,0,0,,dan hanya saya yang boleh melindungi anda
Dialog: 0,1:20:46.39,1:20:49.14,teks umum,,0,0,0,,Lindungi saya? Dari apa?
Dialog: 0,1:20:49.22,1:20:52.14,teks umum,,0,0,0,,Saya akan melindungi kamu daripada pewaris sebenar bintang Raja
Dialog: 0,1:20:53.19,1:20:56.44,teks umum,,0,0,0,,- Apa yang awak cakapkan?\N{\i1}- Anda sudah tahu,
Dialog: 0,1:20:56.52,1:20:58.94,teks umum,,0,0,0,,anda bukan waris sebenar
Dialog: 0,1:21:04.82,1:21:08.74,teks umum,,0,0,0,,Lelaki yang akan menyerlahkan kamu... Lelaki yang akan disembah
Dialog: 0,1:21:08.83,1:21:12.66,teks umum,,0,0,0,,Lelaki yang akan mengalahkan kamu
Dialog: 0,1:21:13.25,1:21:14.67,teks umum,,0,0,0,,Anda hanya berada di barisan kedua selepas takhta
Dialog: 0,1:21:14.75,1:21:17.71,teks umum,,0,0,0,,Chan Wook, pewaris bintang, tidak boleh dibenarkan,
Dialog: 0,1:21:18.50,1:21:19.75,teks umum,,0,0,0,,bangkit di atas anda
Dialog: 0,1:21:21.92,1:21:26.59,teks umum,,0,0,0,,Saya berjanji akan menyelamatkan kamu daripada cahaya yang tidak menyenangkan ini
Dialog: 0,1:21:32.39,1:21:34.64,teks umum,,0,0,0,,Satu-satunya perkara yang sangat saya perjuangkan...
Dialog: 0,1:21:37.35,1:21:39.11,teks umum,,0,0,0,,sebenarnya milik Chan Wook
Dialog: 0,1:22:07.01,1:22:10.18,teks umum,,0,0,0,,Sungguh comel. awak cantik
Dialog: 0,1:22:11.76,1:22:14.48,teks umum,,0,0,0,,Anda kelihatan hebat
Dialog: 0,1:22:16.64,1:22:18.10,teks umum,,0,0,0,,Lapkan air liur anda
Dialog: 0,1:22:18.69,1:22:20.81,teks umum,,0,0,0,,- Anda boleh menanggalkannya sekarang\N- Kenapa awak...
Dialog: 0,1:22:20.90,1:22:23.65,teks umum,,0,0,0,,sebenarnya suruh saya pakai ni? Kenapa bukan pengantin perempuan?
Dialog: 0,1:22:23.73,1:22:27.07,teks umum,,0,0,0,,Bapanya dalam keadaan teruk, jadi dia tidak dapat datang
Dialog: 0,1:22:27.15,1:22:29.53,teks umum,,0,0,0,,Anda dan dia mempunyai fizikal yang serupa, jadi
Dialog: 0,1:22:30.12,1:22:31.33,teks umum,,0,0,0,,Anda boleh menukar pakaian anda
Dialog: 0,1:22:32.87,1:22:35.12,teks umum,,0,0,0,,Ayuh. Mari pergi supaya dia boleh menukar pakaian
Dialog: 0,1:22:35.87,1:22:38.79,miring,,0,0,0,,- Berhenti merenung. Jom\N- Dia gadis paling cantik yang pernah saya lihat
Dialog: 0,1:22:38.87,1:22:40.21,teks umum,,0,0,0,,Memang benar
Dialog: 0,1:22:44.00,1:22:45.13,teks umum,,0,0,0,,Saya rasa,
Dialog: 0,1:22:46.09,1:22:47.72,teks umum,,0,0,0,,saya nampak comel
Dialog: 0,1:22:49.55,1:22:50.64,teks umum,,0,0,0,,Tunggu
Dialog: 0,1:22:50.72,1:22:52.47,teks umum,,0,0,0,,Adakah Mu Dok di sini? Di mana dia?
Dialog: 0,1:22:52.56,1:22:53.81,teks umum,,0,0,0,,Mu Dok sekarang...
Dialog: 0,1:22:56.64,1:22:58.44,teks umum,,0,0,0,,Dia berada di dalam bilik itu
Dialog: 0,1:22:58.52,1:22:59.98,teks umum,,0,0,0,,- Masuk\N- Okay
Dialog: 0,1:23:10.70,1:23:11.95,teks umum,,0,0,0,,Wah...
Dialog: 0,1:23:12.74,1:23:15.08,teks umum,,0,0,0,,Saya dengar ada orang akan berkahwin tidak lama lagi
Dialog: 0,1:23:15.87,1:23:16.79,teks umum,,0,0,0,,Bukankah itu anda?
Dialog: 0,1:23:17.71,1:23:18.71,teks umum,,0,0,0,,Tidak
Dialog: 0,1:23:23.84,1:23:25.71,teks umum,,0,0,0,,Lihat, ini guru saya
Dialog: 0,1:23:26.46,1:23:28.59,teks umum,,0,0,0,,saya suruh awak tunggu saya di Sejukwon
Dialog: 0,1:23:28.67,1:23:31.51,teks umum,,0,0,0,,- Kenapa awak ada di sini?\N- Ho Yeom menghantar saya untuk mendapatkan wain
Dialog: 0,1:23:31.59,1:23:33.26,teks umum,,0,0,0,,Ah Joo Wol meminta memakai ini
Dialog: 0,1:23:33.35,1:23:36.18,teks umum,,0,0,0,,Saya perlu menukar pakaian. Tunggu di luar
Dialog: 0,1:23:36.27,1:23:37.56,teks umum,,0,0,0,,Tidak, tunggu
Dialog: 0,1:23:37.64,1:23:40.77,teks umum,,0,0,0,,Tempat ini sesuai. Di sinilah kami pertama kali bertemu
Dialog: 0,1:23:42.31,1:23:43.98,teks umum,,0,0,0,,Sesuai untuk apa?
Dialog: 0,1:23:45.82,1:23:48.19,teks umum,,0,0,0,,Untuk ritual yang mesti kita lakukan
Dialog: 0,1:23:49.15,1:23:50.82,miring,,0,0,0,,Mula-mula, duduk sini
Dialog: 0,1:24:01.71,1:24:03.17,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:24:04.00,1:24:05.21,teks umum,,0,0,0,,Ini adalah pilihan
Dialog: 0,1:24:08.84,1:24:12.26,teks umum,,0,0,0,,Berhenti. Awak memalukan saya. Apa masalah awak?
Dialog: 0,1:24:17.43,1:24:19.31,teks umum,,0,0,0,,Ini hanya mengelirukan pada mulanya
Dialog: 0,1:24:19.39,1:24:21.19,teks umum,,0,0,0,,Tetapi selepas kali ke-13 anda terbiasa dengannya
Dialog: 0,1:24:22.48,1:24:23.56,teks umum,,0,0,0,,Apa?
Dialog: 0,1:24:24.19,1:24:26.27,teks umum,,0,0,0,,Adakah anda melamar 13 kali?
Dialog: 0,1:24:28.78,1:24:29.90,teks umum,,0,0,0,,Guru,
Dialog: 0,1:24:30.61,1:24:34.16,teks umum,,0,0,0,,hari ini saya ingin menamatkan latihan saya dengan anda
Dialog: 0,1:24:37.24,1:24:40.25,teks umum,,0,0,0,,Terima kasih kerana membuat saya berlatih keras
Dialog: 0,1:24:40.83,1:24:43.08,teks umum,,0,0,0,,Walaupun saya seorang yang bodoh
Dialog: 0,1:24:45.25,1:24:46.42,miring,,0,0,0,,Saya tahu,
Dialog: 0,1:24:46.50,1:24:48.88,teks umum,,0,0,0,,anda meninggalkan peluang untuk mendapatkan semula kuasa anda
Dialog: 0,1:24:49.67,1:24:52.93,teks umum,,0,0,0,,Sama seperti saya melepaskan tenaga yang saya ingin miliki
Dialog: 0,1:24:53.72,1:24:57.76,teks umum,,0,0,0,,Tetapi saya mempunyai sesuatu yang saya mahu simpan di sebelah saya sepanjang hidup saya
Dialog: 0,1:25:01.56,1:25:05.98,teks umum,,0,0,0,,Saya tidak mahu digunakan dan dibuang. Saya mahu melindungi dan menjaga
Dialog: 0,1:25:06.65,1:25:09.61,teks umum,,0,0,0,,Jadi... lepaskan saya
Dialog: 0,1:25:14.99,1:25:16.49,teks umum,,0,0,0,,Guru awak, Moo Deok,
Dialog: 0,1:25:17.57,1:25:19.70,teks umum,,0,0,0,,membenarkan pelajarnya Chan Wook pergi
Dialog: 0,1:25:24.46,1:25:25.50,teks umum,,0,0,0,,Baiklah, kalau begitu...
Dialog: 0,1:25:26.71,1:25:29.55,teks umum,,0,0,0,,Kahwin dengan saya, Moo Deok?
Dialog: 0,1:26:01.83,1:26:04.58,pratonton,,0,0,0,,Saya memutuskan untuk berkahwin dengan pemiliknya
Dialog: 0,1:26:04.66,1:26:05.87,pratonton,,0,0,0,,Anda tidak mempunyai teman wanita pun
Dialog: 0,1:26:05.96,1:26:07.67,pratonton,,0,0,0,,Itu sahaja untuk Moo Deok
Dialog: 0,1:26:07.75,1:26:08.67,pratonton,,0,0,0,,Mustahil!
Dialog: 0,1:26:08.75,1:26:12.55,pratonton,,0,0,0,,Saya akan cari pedang yang akan membolehkan kamu memukul Chan Wook
Dialog: 0,1:26:12.63,1:26:14.97,pratonton,,0,0,0,,Jin Mu mesti mati
Dialog: 0,1:26:15.05,1:26:18.59,pratonton,,0,0,0,,Adakah anda mengatakan mereka semua menipu saya dan mengejek saya?
Dialog: 0,1:26:18.68,1:26:20.97,pratonton,,0,0,0,,Mereka cuba melindungi Chan Wook
Dialog: 0,1:26:21.05,1:26:23.10,pratonton,,0,0,0,,Seorang pembunuh telah muncul di Saejukwon
Dialog: 0,1:26:23.18,1:26:25.10,pratonton,,0,0,0,,Saya rasa mayat Moo Deok pada asalnya milik...
Dialog: 0,1:26:25.18,1:26:27.10,pratonton,,0,0,0,,kepada seseorang yang mempunyai kuasa ilahi yang besar
Dialog: 0,1:26:28.27,1:26:31.98,pratonton,,0,0,0,,Nak Soo, awak memberi saya harapan
Dialog: 0,0:02:55.24,0:02:57.24,nicks,,0,0,0,,

