Dialog: 0,0:02:47.44,0:02:49.44,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.44,0:02:51.44,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:51.44,0:02:53.44,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:00:59.10,0:01:03.35,kenangan,,0,0,0,,Di Jeonbugwan kami merakam semua bintang
Dialog: 0,0:01:03.43,0:01:06.69,kenangan,,0,0,0,,Ada satu yang muncul pada hari lahir anda. Adakah anda mahu melihat?
Dialog: 0,0:01:06.77,0:01:08.44,kenangan,,0,0,0,,Ya, ayah
Dialog: 0,0:01:09.31,0:01:10.86,kenangan,,0,0,0,,Okey, jom
Dialog: 0,0:01:23.41,0:01:24.66,kenangan,,0,0,0,,Di sini
Dialog: 0,0:01:28.79,0:01:31.21,suara,,0,0,0,,Ayah saya mengkaji bintang dan mencatatkan nota mengenainya
Dialog: 0,0:01:32.21,0:01:34.67,di sebalik tabir,,0,0,0,,Kerana dia seorang ahli silap mata yang membaca buruj
Dialog: 0,0:01:47.98,0:01:48.98,kenangan,,0,0,0,,Puan!
Dialog: 0,0:01:49.06,0:01:50.23,kenangan,,0,0,0,,Puan!
Dialog: 0,0:02:00.24,0:02:02.45,kenangan,,0,0,0,,Tinggal di sini dan jangan pergi
Dialog: 0,0:02:04.29,0:02:06.62,kenangan,,0,0,0,,Apabila kamu melihat ayahmu, larilah
Dialog: 0,0:02:07.12,0:02:08.54,kenangan,,0,0,0,,Jangan biarkan dia menangkap anda
Dialog: 0,0:02:33.15,0:02:34.48,kenangan,,0,0,0,,Ayah...
Dialog: 0,0:03:31.42,0:03:33.33,kenangan,,0,0,0,,Saya akan berikan kamu kekuatan
Dialog: 0,0:03:34.17,0:03:35.54,kenangan,,0,0,0,,Sudikah awak ikut saya?
Dialog: 0,0:03:44.80,0:03:47.51,suara,,0,0,0,,Hari ayah saya dibunuh oleh empat keluarga Daeho,
Dialog: 0,0:03:48.18,0:03:50.06,luar skrin,,0,0,0,,Saya mengikuti Jin Moo
Dialog: 0,0:03:51.39,0:03:53.94,di sebalik tabir,,0,0,0,,Saya dibesarkan sepenuhnya terputus dari dunia
Dialog: 0,0:03:54.02,0:03:56.82,di sebalik tabir,,0,0,0,,di lembah Danhyanggok yang dalam dan berbahaya
Dialog: 0,0:04:28.06,0:04:30.56,di sebalik tabir,,0,0,0,,Saya tidak tahu, saya terselamat kerana saya kuat,
Dialog: 0,0:04:30.64,0:04:32.85,di sebalik tabir,,0,0,0,,atau kuat kerana dia terselamat
Dialog: 0,0:04:37.06,0:04:40.48,suara,,0,0,0,,Apabila masa silam saya dan ayah saya dilupakan,
Dialog: 0,0:04:41.44,0:04:43.65,suara,,0,0,0,,Saya akhirnya kembali sebagai Naxu
Dialog: 0,0:04:48.95,0:04:50.83,luar skrin,,0,0,0,,Tetapi Naxu sudah mati
Dialog: 0,0:04:51.54,0:04:54.75,suara,,0,0,0,,Saya kembali ke sini sebagai Moo Deok
Dialog: 0,0:04:55.75,0:04:58.17,di sebalik tabir,,0,0,0,,dengan pemilik yang tidak berdaya,
Dialog: 0,0:04:58.92,0:05:02.38,di sebalik tabir,,0,0,0,,yang pada masa yang sama adalah pelajar saya yang tidak berminat
Dialog: 0,0:05:02.46,0:05:04.80,teks umum,,0,0,0,,Berapa lama lagi kita perlu pergi?
Dialog: 0,0:05:04.88,0:05:06.18,teks umum,,0,0,0,,Gelang ini seberat satu tan
Dialog: 0,0:05:06.26,0:05:08.30,teks umum,,0,0,0,,Cikgu, pelajar anda penat
Dialog: 0,0:05:08.39,0:05:11.01,teks umum,,0,0,0,,Saya sudah cukup. Saya tidak boleh pergi lagi
Dialog: 0,0:05:11.10,0:05:13.18,teks umum,,0,0,0,,Saya bawa semua barang!
Dialog: 0,0:05:13.27,0:05:15.89,teks umum,,0,0,0,,Saya adalah tuan, dan awak adalah hamba saya
Dialog: 0,0:05:15.98,0:05:17.23,teks umum,,0,0,0,,Ini tugas anda
Dialog: 0,0:05:17.31,0:05:19.23,teks umum,,0,0,0,,Apabila perlu, saya adalah guru kamu,
Dialog: 0,0:05:19.77,0:05:21.53,teks umum,,0,0,0,,dan pembantu rumah, bila awak nak?
Dialog: 0,0:05:21.61,0:05:22.65,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:05:27.07,0:05:28.28,teks umum,,0,0,0,,Saya tidak tahu,
Dialog: 0,0:05:28.95,0:05:31.28,teks umum,,0,0,0,,bahawa terdapat tempat sedemikian di luar bandar
Dialog: 0,0:05:31.37,0:05:35.08,teks umum,,0,0,0,,Tempat ini sangat keras sehinggakan anda tidak dapat mendengar bergema di sini
Dialog: 0,0:05:36.21,0:05:37.50,teks umum,,0,0,0,,Oleh itu namanya, Danhyangok
Dialog: 0,0:05:42.84,0:05:44.13,teks umum,,0,0,0,,Dan saya mendengar gema
Dialog: 0,0:05:44.21,0:05:45.51,teks umum,,0,0,0,,Ia hanyalah kiasan!
Dialog: 0,0:05:45.59,0:05:47.01,teks umum,,0,0,0,,Tajuknya mengarut
Dialog: 0,0:05:48.55,0:05:49.55,teks umum,,0,0,0,,saya nak makan
Dialog: 0,0:05:51.51,0:05:53.56,teks umum,,0,0,0,,Saya tinggal di sana
Dialog: 0,0:05:53.64,0:05:55.85,teks umum,,0,0,0,,Anda akan makan apa yang saya bawa
Dialog: 0,0:05:55.93,0:05:59.48,teks umum,,0,0,0,,dan tidur di tempat anda tertidur selepas hari yang sukar
Dialog: 0,0:06:02.77,0:06:04.19,teks umum,,0,0,0,,Apakah ini? Bau ayam
Dialog: 0,0:06:06.07,0:06:08.78,teks am,,0,0,0,,- Adakah mereka menjual ayam di sini?\N- Siapa yang akan menjual ayam di sini?
Dialog: 0,0:06:11.62,0:06:13.79,teks umum,,0,0,0,,Anda juga merasakannya, bukan?
Dialog: 0,0:06:13.87,0:06:15.54,teks umum,,0,0,0,,Saya beritahu awak, itu ayam
Dialog: 0,0:06:16.12,0:06:18.83,teks umum,,0,0,0,,Saya pasti. Saya suka ayam
Dialog: 0,0:06:19.62,0:06:21.21,teks umum,,0,0,0,,Bagaimana anda sampai di sana?
Dialog: 0,0:06:22.21,0:06:24.00,teks umum,,0,0,0,,Seseorang sedang menggoreng ayam berdekatan
Dialog: 0,0:06:24.09,0:06:25.76,teks umum,,0,0,0,,Turun. Kenapa awak pergi ke sana?
Dialog: 0,0:06:34.97,0:06:36.10,italic,,0,0,0,,Nampak? ayam
Dialog: 0,0:06:36.18,0:06:39.23,teks umum,,0,0,0,,Saya beritahu awak bau dia. Betapa sejuknya di sini
Dialog: 0,0:06:58.79,0:07:00.67,teks umum,,0,0,0,,Kenapa semua ini ada di sini?
Dialog: 0,0:07:02.79,0:07:03.63,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:07:04.67,0:07:06.59,teks umum,,0,0,0,,Malah terdapat tab mandi di sini
Dialog: 0,0:07:16.06,0:07:16.97,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,0:07:17.56,0:07:21.23,teks umum,,0,0,0,,ada gunung makanan dan juga tempat untuk berenang
Dialog: 0,0:07:21.31,0:07:23.48,teks umum,,0,0,0,,Cikgu, anda mempunyai rumah yang baik
Dialog: 0,0:07:23.56,0:07:25.82,teks umum,,0,0,0,,Adakah perlu untuk menakutkan pelajar seperti itu?
Dialog: 0,0:07:25.90,0:07:26.73,teks umum,,0,0,0,,Sungguh pelik...
Dialog: 0,0:07:29.07,0:07:30.49,teks umum,,0,0,0,,Dan ada selimut
Dialog: 0,0:07:32.49,0:07:35.03,teks umum,,0,0,0,,Secara ringkasnya. Comel dan selesa
Dialog: 0,0:07:35.91,0:07:37.33,teks umum,,0,0,0,,Ini bukan milik saya
Dialog: 0,0:07:38.79,0:07:40.66,teks umum,,0,0,0,,Seseorang tinggal di sini
Dialog: 0,0:07:45.96,0:07:47.17,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:07:47.25,0:07:50.63,teks umum,,0,0,0,,bolehkah kita makan ayam? Dia sudah bersedia
Dialog: 0,0:07:50.72,0:07:51.88,teks umum,,0,0,0,,Mu Dok?
Dialog: 0,0:07:57.64,0:07:59.06,teks umum,,0,0,0,,Adakah ini lelaki?
Dialog: 0,0:08:20.66,0:08:21.96,teks umum,,0,0,0,,Ayuh, berhenti!
Dialog: 0,0:08:23.79,0:08:25.29,teks umum,,0,0,0,,Tenang
Dialog: 0,0:08:37.72,0:08:38.72,teks umum,,0,0,0,,Budak baik
Dialog: 0,0:08:38.81,0:08:40.64,teks umum,,0,0,0,,Terlatih dengan baik. Adakah anda tinggal di sini?
Dialog: 0,0:08:41.35,0:08:42.77,teks umum,,0,0,0,,Ini bukan anjing liar
Dialog: 0,0:08:43.77,0:08:45.02,teks umum,,0,0,0,,Di manakah tuanmu?
Dialog: 0,0:08:45.85,0:08:47.81,teks umum,,0,0,0,,Hei, gebu, bawa tuanmu
Dialog: 0,0:08:50.03,0:08:52.03,teks umum,,0,0,0,,Anjing yang bijak
Dialog: 0,0:08:54.15,0:08:55.70,di sebalik tabir,,0,0,0,,Siapa ini?
Dialog: 0,0:08:55.78,0:08:57.24,suara,,0,0,0,,Ini bukan orang Dan Zhu
Dialog: 0,0:08:57.32,0:09:00.58,luar skrin,,0,0,0,,Yang ini tidak cuba menyembunyikan atau menyembunyikan
Dialog: 0,0:09:03.25,0:09:04.33,miring,,0,0,0,,Teh
Dialog: 0,0:09:04.41,0:09:07.46,teks umum,,0,0,0,,Kita tetamu, jadi kita boleh minum secawan kan?
Dialog: 0,0:09:08.75,0:09:10.21,teks umum,,0,0,0,,Tonton apa yang anda makan dan minum
Dialog: 0,0:09:11.00,0:09:13.05,teks umum,,0,0,0,,Mula-mula kita perlu menyemak siapa yang tinggal di sini
Dialog: 0,0:09:13.13,0:09:14.92,teks umum,,0,0,0,,Kemudian kami akan memutuskan perkara yang perlu dilakukan seterusnya
Dialog: 0,0:09:15.01,0:09:16.26,teks umum,,0,0,0,,Jadi anda benar-benar tidak tahu?
Dialog: 0,0:09:16.89,0:09:17.72,teks umum,,0,0,0,,Apa?
Dialog: 0,0:09:17.80,0:09:20.10,teks umum,,0,0,0,,Ada anjing, bunga di mana-mana,
Dialog: 0,0:09:20.18,0:09:22.10,teks umum,,0,0,0,,ayam dan teh sedang mendidih
Dialog: 0,0:09:22.18,0:09:23.48,teks umum,,0,0,0,,Dan saya hampir tersilap
Dialog: 0,0:09:24.10,0:09:24.93,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:09:25.02,0:09:28.31,teks umum,,0,0,0,,Saya memutuskan bahawa anda cuba menculik saya dan tinggal bersama saya,
Dialog: 0,0:09:28.40,0:09:29.86,teks umum,,0,0,0,,bersembunyi di sebalik latihan
Dialog: 0,0:09:29.94,0:09:31.73,teks umum,,0,0,0,,Jika anjing ini mengibaskan ekornya di hadapan anda,
Dialog: 0,0:09:31.82,0:09:34.44,teks umum,,0,0,0,,Saya akan memutuskan bahawa ini semua rancangan anda
Dialog: 0,0:09:34.53,0:09:36.65,teks umum,,0,0,0,,Ada ruang yang cukup untuk dua atau tiga kanak-kanak
Dialog: 0,0:09:37.36,0:09:39.24,teks umum,,0,0,0,,Semuanya berbeza di sini semasa saya tinggal di sini
Dialog: 0,0:09:39.82,0:09:41.20,teks umum,,0,0,0,,Tempat itu tidak bernyawa
Dialog: 0,0:09:41.28,0:09:43.87,teks umum,,0,0,0,,dan sesuai untuk latihan, itulah sebabnya saya membawa anda ke sini
Dialog: 0,0:09:45.46,0:09:46.75,teks umum,,0,0,0,,Jadi, latihan?
Dialog: 0,0:09:48.08,0:09:49.46,teks umum,,0,0,0,,Hanya ini dalam fikiran anda?
Dialog: 0,0:09:50.17,0:09:52.59,teks umum,,0,0,0,,Lupakan! Makan dan minum apa yang anda mahu, teruskan
Dialog: 0,0:09:52.67,0:09:53.80,teks umum,,0,0,0,,Biarkan mereka membunuh anda
Dialog: 0,0:09:55.63,0:09:56.47,teks umum,,0,0,0,,Betul
Dialog: 0,0:09:56.55,0:10:00.22,teks umum,,0,0,0,,Saya tidak sangka dia akan bertindak balas sebegitu kepada jenaka mudah
Dialog: 0,0:10:00.30,0:10:03.47,teks umum,,0,0,0,,Ini salah saya sendiri kerana mengikut dia ke padang gurun ini
Dialog: 0,0:10:04.06,0:10:05.02,teks umum,,0,0,0,,Tiada perkataan
Dialog: 0,0:10:13.69,0:10:15.57,kenangan miring,,0,0,0,,Kekal pewaris yang tidak tahu
Dialog: 0,0:10:17.07,0:10:19.78,kenangan,,0,0,0,,Keluarga Chan
Dialog: 0,0:10:21.66,0:10:22.99,teks umum,,0,0,0,,Saya lebih suka tinggal di sini,
Dialog: 0,0:10:24.24,0:10:25.66,teks umum,,0,0,0,,bagaimana saya akan hidup seperti ini
Dialog: 0,0:11:12.21,0:11:13.84,teks umum,,0,0,0,,Hari ini ialah ketua Jinyeowon
Dialog: 0,0:11:13.92,0:11:16.75,teks umum,,0,0,0,,mengumpulkan ahli silap mata Deho di Majlis Bersatu
Dialog: 0,0:11:17.30,0:11:20.76,teks umum,,0,0,0,,Semua 11 keluarga hadir kecuali Chang Gan
Dialog: 0,0:11:20.84,0:11:24.76,teks umum,,0,0,0,,Pergaduhan saya dengan Chan Wook adalah peristiwa yang besar?
Dialog: 0,0:11:25.35,0:11:27.77,teks umum,,0,0,0,,Ini adalah pertarungan antara ahli silap mata dan keluarga diraja
Dialog: 0,0:11:27.85,0:11:29.64,teks umum,,0,0,0,,Yang terakhir beratus tahun yang lalu
Dialog: 0,0:11:29.73,0:11:32.27,teks umum,,0,0,0,,Saya hanya cuba menghukum Chan Wook
Dialog: 0,0:11:32.35,0:11:34.44,teks umum,,0,0,0,,kerana memandang rendah saya
Dialog: 0,0:11:34.52,0:11:35.90,teks umum,,0,0,0,,Ini bukan markah peribadi
Dialog: 0,0:11:36.77,0:11:39.53,teks umum,,0,0,0,,Baginda memberi titah dan ahli sihir berkumpul
Dialog: 0,0:11:39.61,0:11:43.28,teks umum,,0,0,0,,Jika mereka bersetuju, duel rasmi akan berlaku
Dialog: 0,0:11:45.07,0:11:47.58,teks umum,,0,0,0,,Jurang telah muncul yang telah memusnahkan kestabilan dan keamanan,
Dialog: 0,0:11:48.45,0:11:50.87,teks umum,,0,0,0,, wujud antara istana dan ahli silap mata
Dialog: 0,0:12:03.97,0:12:08.14,teks umum,,0,0,0,,Adakah anda benar-benar bersetuju dengan keputusan untuk melucutkan hak Wook untuk menjadi Gwangju seterusnya?
Dialog: 0,0:12:09.35,0:12:10.73,teks umum,,0,0,0,,Ya, benar
Dialog: 0,0:12:15.40,0:12:16.77,teks umum,,0,0,0,, Duel sahaja
Dialog: 0,0:12:16.86,0:12:19.40,teks umum,,0,0,0,,akan menyelesaikan salah faham antara Putera Mahkota dan Uk
Dialog: 0,0:12:19.48,0:12:20.74,teks umum,,0,0,0,,Dan berkenaan Gwangju
Dialog: 0,0:12:21.61,0:12:26.12,teks umum,,0,0,0,,Saya sudah ada calon yang ingin saya calonkan
Dialog: 0,0:12:26.20,0:12:28.03,teks umum,,0,0,0,, Melarikan diri tidak sama dengan kekalahan
Dialog: 0,0:12:29.24,0:12:32.41,teks umum,,0,0,0,,Saya dengar dia lari sebelum pergaduhan diumumkan
Dialog: 0,0:12:34.62,0:12:36.00,teks umum,,0,0,0,,Sungguh memalukan
Dialog: 0,0:12:36.08,0:12:39.50,teks umum,,0,0,0,,Dia mesti bertarung dengan jujur dan mati dengan bermaruah, seperti ahli silap mata
Dialog: 0,0:12:39.59,0:12:41.84,teks umum,,0,0,0,,Chan Wook tidak mempunyai keberanian untuk ini
Dialog: 0,0:12:43.26,0:12:46.18,teks umum,,0,0,0,,Semua orang di sini adalah gurunya
Dialog: 0,0:12:46.26,0:12:48.89,teks umum,,0,0,0,,- Ya\N- Dia tidak pernah dibezakan oleh bakat
Dialog: 0,0:12:48.97,0:12:52.48,teks umum,,0,0,0,,Saya menentang ahli silap mata yang dihina seperti itu
Dialog: 0,0:12:52.56,0:12:55.23,teks umum,,0,0,0,,Bagaimana jika kita menafikan status ahli silap mata Chan Wook?
Dialog: 0,0:12:58.52,0:13:01.99,teks umum,,0,0,0,,Jika kita sebulat suara melucutkan status ini,
Dialog: 0,0:13:02.07,0:13:05.32,teks umum,,0,0,0,,anda perlu mengambil semua tenaganya, dia akan kehilangan kuasanya
Dialog: 0,0:13:05.41,0:13:08.12,teks umum,,0,0,0,,Adakah anda bercadang untuk merosakkan seluruh hidup seorang lelaki muda?
Dialog: 0,0:13:08.20,0:13:10.03,teks umum,,0,0,0,,Tetapi ini akan membantu menangani pergaduhan
Dialog: 0,0:13:10.95,0:13:15.21,italic,,0,0,0,,Apapun, pintu tenaganya tertutup kerana ayahnya
Dialog: 0,0:13:15.29,0:13:17.21,teks umum,,0,0,0,,- Dia betul\N- Ada betulnya
Dialog: 0,0:13:17.29,0:13:19.38,teks umum,,0,0,0,,Setiap daripada kamu
Dialog: 0,0:13:19.46,0:13:22.59,teks umum,,0,0,0,,adalah guru Uka
Dialog: 0,0:13:25.72,0:13:27.34,teks umum,,0,0,0,,Bagaimana anda boleh bercakap dengan tidak berhati-hati
Dialog: 0,0:13:27.43,0:13:30.56,teks umum,,0,0,0,,tentang kemusnahan hidup seseorang yang pernah menjadi pelajar anda?
Dialog: 0,0:13:32.47,0:13:35.69,teks umum,,0,0,0,,Sosnovy Bor menerima syarat istana
Dialog: 0,0:13:35.77,0:13:38.69,teks umum,,0,0,0,,Kami akan mengambil ke atas diri kita rasa malu yang mungkin jatuh atau tidak
Dialog: 0,0:13:39.27,0:13:42.86,teks umum,,0,0,0,,Kalau begitu biarlah ini menjadi pertarungan rasmi antara Sosnovy Bor dan istana
Dialog: 0,0:13:44.69,0:13:45.53,teks umum,,0,0,0,,Ya
Dialog: 0,0:13:46.95,0:13:49.99,teks umum,,0,0,0,,Saya dengar Uk menguasai Ryusu dalam masa yang singkat
Dialog: 0,0:13:50.99,0:13:53.58,teks umum,,0,0,0,,Adakah seseorang dari hutan mengajarnya?
Dialog: 0,0:13:57.25,0:14:00.63,teks umum,,0,0,0,,Tidak kira ke mana dia pergi, kepada siapa,
Dialog: 0,0:14:02.30,0:14:05.92,teks umum,,0,0,0,,tiada guru untuknya
Dialog: 0,0:14:10.47,0:14:12.97,teks umum,,0,0,0,,Airnya menyenangkan dan bersih. Kulit dah makin lembut
Dialog: 0,0:14:13.06,0:14:14.35,teks umum,,0,0,0,,Mungkin itu mineral
Dialog: 0,0:14:15.02,0:14:18.69,teks am,,0,0,0,,Mu Dok, tuan rumah seorang yang sangat kemas
Dialog: 0,0:14:18.77,0:14:20.27,teks umum,,0,0,0,,Saya tidak fikir dia akan kembali...
Dialog: 0,0:14:23.78,0:14:24.82,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:14:39.37,0:14:40.88,teks umum,,0,0,0,,Tidur nyenyak
Dialog: 0,0:14:41.50,0:14:43.13,miring,,0,0,0,,Sudah tentu anda penat
Dialog: 0,0:14:43.21,0:14:45.84,teks umum,,0,0,0,,Kami boleh berjalan dengan tenang, tetapi anda tergesa-gesa
Dialog: 0,0:14:45.92,0:14:48.88,teks umum,,0,0,0,,Anda kini Moo Dok, bukan Nak Soo. Anda tidak mempunyai kekuatan yang cukup
Dialog: 0,0:14:53.85,0:14:55.22,teks umum,,0,0,0,,Bagaimana...
Dialog: 0,0:14:56.06,0:14:57.10,teks umum,,0,0,0,, Berat
Dialog: 0,0:14:57.18,0:14:58.73,teks umum,,0,0,0,,Bodoh
Dialog: 0,0:14:58.81,0:15:01.69,teks umum,,0,0,0,,Jika ia sangat sukar, anda harus meminta bantuan
Dialog: 0,0:15:09.57,0:15:11.03,teks umum,,0,0,0,,Sangat lembut
Dialog: 0,0:15:16.58,0:15:18.58,teks umum,,0,0,0,,Saya pemiliknya,
Dialog: 0,0:15:19.25,0:15:21.75,teks umum,,0,0,0,,dan dia seorang hamba. betul tu
Dialog: 0,0:15:23.17,0:15:24.96,teks umum,,0,0,0,,Saya patut tidur di sini
Dialog: 0,0:15:38.06,0:15:40.77,teks umum,,0,0,0,,Entah bagaimana saya tidak selesa
Dialog: 0,0:15:50.32,0:15:51.36,teks umum,,0,0,0,,Okey
Dialog: 0,0:16:04.58,0:16:05.67,teks umum,,0,0,0,,Guru,
Dialog: 0,0:16:05.75,0:16:07.17,teks umum,,0,0,0,,selamat malam
Dialog: 0,0:16:31.94,0:16:33.40,teks umum,,0,0,0,,Sungguh menyusahkan
Dialog: 0,0:17:01.77,0:17:04.23,teks umum,,0,0,0,,Anda kata ada orang nomad di dalam?
Dialog: 0,0:17:07.90,0:17:09.48,teks umum,,0,0,0,,Sungguh menarik
Dialog: 0,0:17:37.34,0:17:39.55,teks umum,,0,0,0,,Tanpa bantuan anda, saya tidak akan mengenalinya,
Dialog: 0,0:17:39.64,0:17:41.22,teks umum,,0,0,0,,kerana tiada niat jahat dalam jiwanya
Dialog: 0,0:17:46.06,0:17:50.15,teks umum,,0,0,0,,Lebih baik kamu mati di tanganku daripada menjadi liar dan membatu
Dialog: 0,0:18:18.05,0:18:20.76,di sebalik tabir,,0,0,0,,Terdapat jiwa yang menakjubkan dalam tubuh ini
Dialog: 0,0:18:22.10,0:18:26.48,suara,,0,0,0,,Dia sepatutnya menjadi liar sekarang, memandangkan betapa lemahnya badan ini
Dialog: 0,0:18:26.56,0:18:28.48,suara,,0,0,0,,Kenapa dia masih okay?
Dialog: 0,0:18:36.44,0:18:40.16,suara,,0,0,0,,Saya tidak berasa apa-apa tenaga. Ke mana dia semua menghilang?
Dialog: 0,0:18:46.16,0:18:47.58,teks umum,,0,0,0,,Siapa awak?
Dialog: 0,0:18:49.67,0:18:51.46,teks umum,,0,0,0,,Dan siapa kamu?
Dialog: 0,0:18:51.54,0:18:53.54,teks umum,,0,0,0,,Elak dari Moo Dok
Dialog: 0,0:20:28.43,0:20:31.39,teks umum,,0,0,0,,Pedang ini diberikan oleh raja Gwangju Jeonbugwan
Dialog: 0,0:20:31.98,0:20:33.27,teks umum,,0,0,0,,Siapa awak?
Dialog: 0,0:20:34.10,0:20:36.11,teks umum,,0,0,0,,Apa yang kamu lakukan di sebelah gadis seperti itu?
Dialog: 0,0:20:40.32,0:20:41.24,teks umum,,0,0,0,,Moo Dok, lari!
Dialog: 0,0:22:08.45,0:22:10.91,teks umum,,0,0,0,,Akhirnya bangun
Dialog: 0,0:22:15.50,0:22:16.54,teks umum,,0,0,0,,Siapa ini?
Dialog: 0,0:22:16.62,0:22:17.92,teks umum,,0,0,0,,Lelaki Semalam
Dialog: 0,0:22:19.29,0:22:20.54,teks umum,,0,0,0,,Lelaki semalam?
Dialog: 0,0:22:20.63,0:22:21.84,teks umum,,0,0,0,,Ya. tak ingat?
Dialog: 0,0:22:26.59,0:22:27.84,kenangan miring,,0,0,0,,Moo Dok, lari!
Dialog: 0,0:23:04.09,0:23:05.88,miring,,0,0,0,,Saya minta maaf tentang semalam
Dialog: 0,0:23:05.96,0:23:07.80,teks umum,,0,0,0,,Saya melihat seseorang di dalam rumah,
Dialog: 0,0:23:07.88,0:23:10.89,teks umum,,0,0,0,,dan anda tiba-tiba mengeluarkan pedang, saya tiada pilihan
Dialog: 0,0:23:10.97,0:23:12.30,teks umum,,0,0,0,,Ya, saya sendiri takut
Dialog: 0,0:23:12.39,0:23:14.97,teks umum,,0,0,0,,Saya masih kurang mengawal tenaga di tangan saya
Dialog: 0,0:23:15.06,0:23:16.93,teks umum,,0,0,0,,Saya tidak mahu menyakiti awak
Dialog: 0,0:23:17.02,0:23:18.14,teks umum,,0,0,0,,Kamu berdua...
Dialog: 0,0:23:19.06,0:23:20.02,teks umum,,0,0,0,,bergaduh?
Dialog: 0,0:23:23.94,0:23:26.15,teks umum,,0,0,0,,Anda benar-benar tidak ingat apa-apa?
Dialog: 0,0:23:27.40,0:23:28.61,teks umum,,0,0,0,,Tidak
Dialog: 0,0:23:28.69,0:23:31.24,teks umum,,0,0,0,,Anda berdiri di sana dan melihat kami
Dialog: 0,0:23:31.32,0:23:32.57,teks umum,,0,0,0,,Saya?
Dialog: 0,0:23:32.66,0:23:33.53,teks umum,,0,0,0,,Apa?
Dialog: 0,0:23:34.16,0:23:35.91,teks umum,,0,0,0,,Saya rasa awak sedang tidur berjalan
Dialog: 0,0:23:35.99,0:23:39.58,teks am,,0,0,0,,Saya akan berikan anda herba ubatan untuk ini. Bancuh teh dan minum
Dialog: 0,0:23:40.21,0:23:41.67,teks umum,,0,0,0,,Adakah anda seorang penyembuh?
Dialog: 0,0:23:41.75,0:23:43.83,teks umum,,0,0,0,,Tidak, tetapi dia ada di sini untuk mengumpul beberapa herba,
Dialog: 0,0:23:43.92,0:23:45.54,teks umum,,0,0,0,,yang hanya boleh didapati di sini
Dialog: 0,0:23:45.63,0:23:46.55,teks umum,,0,0,0,,Panggil saya Cikgu Li
Dialog: 0,0:23:47.13,0:23:49.30,teks umum,,0,0,0,,Ada ruang yang cukup untuk kita,
Dialog: 0,0:23:49.38,0:23:51.26,teks umum,,0,0,0,,jadikan diri anda di rumah
Dialog: 0,0:23:54.64,0:23:56.18,teks umum,,0,0,0,,Baiklah, Sapsari
Dialog: 0,0:23:58.47,0:23:59.85,italic,,0,0,0,,Anda betul-betul tidak ingat?
Dialog: 0,0:23:59.93,0:24:01.94,contact,,0,0,0,,Adakah saya benar-benar berjalan dalam tidur saya?
Dialog: 0,0:24:15.95,0:24:17.20,contact,,0,0,0,,Saya terbaring di atas lantai...
Dialog: 0,0:24:17.28,0:24:19.75,teks umum,,0,0,0,,Nomad ini istimewa
Dialog: 0,0:24:19.83,0:24:23.04,teks umum,,0,0,0,,Jiwa istimewa dalam tubuh yang lemah
Dialog: 0,0:24:25.33,0:24:27.29,teks umum,,0,0,0,,Mari kita kenali dia dengan lebih dekat
Dialog: 0,0:24:27.38,0:24:28.84,teks umum,,0,0,0,,Jangan berbohong
Dialog: 0,0:24:28.92,0:24:31.51,teks umum,,0,0,0,,Serius! Saya tukar awak supaya awak boleh tidur dengan lebih selesa
Dialog: 0,0:24:31.59,0:24:32.97,teks umum,,0,0,0,,Apakah hubungan anda?
Dialog: 0,0:24:34.72,0:24:35.93,teks am,,0,0,0,,Kahwin?
Dialog: 0,0:24:36.01,0:24:37.22,teks umum,,0,0,0,,- Tidak\N- Tidak
Dialog: 0,0:24:38.18,0:24:41.35,teks umum,,0,0,0,,Saya tidak tidur di atas katil. Saya terbaring di atas lantai
Dialog: 0,0:24:41.43,0:24:43.48,teks umum,,0,0,0,,Kenapa saya perlu berbohong? saya betul-betul...
Dialog: 0,0:24:43.56,0:24:44.85,contact,,0,0,0,,- Anda selalu berbohong\N{\i0}- Pasti sudah berkahwin
Dialog: 0,0:24:45.77,0:24:46.94,teks umum,,0,0,0,,- Tidak sama sekali\N- Tidak sama sekali
Dialog: 0,0:24:47.52,0:24:49.11,teks umum,,0,0,0,,Nah, adakah anda menang?
Dialog: 0,0:24:49.19,0:24:50.73,teks umum,,0,0,0,,Tidak, hilang. Tetapi...
Dialog: 0,0:24:51.61,0:24:52.99,teks umum,,0,0,0,,Dia sangat kuat
Dialog: 0,0:24:53.07,0:24:55.28,teks umum,,0,0,0,,- Dia...\N- Awak bertuah. Saya tahu ia
Dialog: 0,0:24:55.36,0:24:56.41,teks umum,,0,0,0,,Apa?
Dialog: 0,0:25:00.74,0:25:04.12,teks umum,,0,0,0,,Mereka juga telah mengumpul sebuah majlis. Keadaan semakin rumit
Dialog: 0,0:25:04.21,0:25:07.54,teks umum,,0,0,0,,Adakah anda rasa Wook dan Moo Deok okey?
Dialog: 0,0:25:07.63,0:25:10.30,teks umum,,0,0,0,,Mereka pergi ke Sari, kampung asal Mu Dok
Dialog: 0,0:25:10.38,0:25:11.55,teks umum,,0,0,0,,Dia gembira, saya rasa
Dialog: 0,0:25:13.38,0:25:14.97,teks umum,,0,0,0,,Kenapa dia harus gembira?
Dialog: 0,0:25:15.05,0:25:16.18,teks umum,,0,0,0,,Dia terpaksa meninggalkan kamu
Dialog: 0,0:25:16.26,0:25:18.51,teks umum,,0,0,0,,- Dan?\N - Nah, awak bodoh
Dialog: 0,0:25:18.60,0:25:20.51,teks umum,,0,0,0,,Moo Dok jatuh cinta dengan awak
Dialog: 0,0:25:23.14,0:25:24.52,teks umum,,0,0,0,,Dia berkata begitu,
Dialog: 0,0:25:25.44,0:25:26.77,teks umum,,0,0,0,,untuk membantu Uku
Dialog: 0,0:25:26.85,0:25:28.56,teks umum,,0,0,0,,Ya, ya, sudah tentu
Dialog: 0,0:25:31.57,0:25:34.49,teks umum,,0,0,0,,Saya dengar Encik Chan lari
Dialog: 0,0:25:34.57,0:25:38.70,teks umum,,0,0,0,,Dia tidak melarikan diri, dia hanya bersembunyi buat masa ini
Dialog: 0,0:25:38.78,0:25:40.24,teks umum,,0,0,0,,Apa bezanya?
Dialog: 0,0:25:40.33,0:25:43.00,teks umum,,0,0,0,,Jadi dia pergi ke Danhyangok dengan Mu Dok?
Dialog: 0,0:25:44.87,0:25:46.96,teks umum,,0,0,0,,- Danhyangok?\N- Ya
Dialog: 0,0:25:47.04,0:25:50.42,teks umum,,0,0,0,,Dia baru-baru ini menyalakan bunga api di sana atas arahan tuannya
Dialog: 0,0:25:50.50,0:25:53.09,teks umum,,0,0,0,,Saya masih ingat melihat mereka
Dialog: 0,0:25:53.17,0:25:56.26,teks umum,,0,0,0,,Saya dapati mereka pergi ke sana kerana dekat
Dialog: 0,0:25:56.34,0:25:59.01,teks umum,,0,0,0,,- Betulkah saya?\N- Tidak
Dialog: 0,0:25:59.09,0:26:01.97,teks umum,,0,0,0,,Mu Dok dengan Uk di kampung Sari
Dialog: 0,0:26:02.06,0:26:04.06,teks umum,,0,0,0,,Ah, saya faham. Sari
Dialog: 0,0:26:04.14,0:26:06.27,teks umum,,0,0,0,,Jangan beritahu sesiapa bahawa Uk ada di sana
Dialog: 0,0:26:06.85,0:26:08.52,teks umum,,0,0,0,,Baiklah, saya tidak akan katakan
Dialog: 0,0:26:08.60,0:26:09.73,teks umum,,0,0,0,,Selera makan
Dialog: 0,0:26:11.90,0:26:14.23,teks umum,,0,0,0,,Mu Dok dalam Danhyangok?
Dialog: 0,0:26:14.32,0:26:15.82,teks umum,,0,0,0,,Tempat itu sangat berbahaya
Dialog: 0,0:26:15.90,0:26:18.24,teks umum,,0,0,0,,Adakah anda menyimpan burung anda di sana?
Dialog: 0,0:26:18.95,0:26:20.99,teks umum,,0,0,0,,Anda memutar buku lali anda di sana dan menakutkan semua orang
Dialog: 0,0:26:21.95,0:26:23.37,teks umum,,0,0,0,,Ya, dalam Danhyangok
Dialog: 0,0:26:25.54,0:26:27.71,teks umum,,0,0,0,,Saya terlupa semua tentang tempat ini
Dialog: 0,0:26:41.39,0:26:42.51,teks umum,,0,0,0,,Api lemah
Dialog: 0,0:26:47.56,0:26:50.19,teks umum,,0,0,0,,Badannya penuh tenaga, memandangkan kekuatannya
Dialog: 0,0:26:53.19,0:26:54.90,teks umum,,0,0,0,,Beliau adalah tuan Chipsu
Dialog: 0,0:26:55.53,0:26:57.90,teks umum,,0,0,0,,Cip? Jadi dia kuat seperti saya
Dialog: 0,0:26:57.99,0:27:00.36,teks umum,,0,0,0,,Jelas mengapa sukar untuk mengalahkannya
Dialog: 0,0:27:09.92,0:27:12.08,contact,,0,0,0,,Dia menggunakan tenaga untuk mengekalkan api
Dialog: 0,0:27:12.17,0:27:13.25,teks umum,,0,0,0,,Dia telah berpindah,
Dialog: 0,0:27:14.17,0:27:15.30,teks umum,,0,0,0,,daripada Ryusu
Dialog: 0,0:27:18.01,0:27:18.97,teks umum,,0,0,0,,Ryusu?
Dialog: 0,0:27:20.09,0:27:22.72,teks umum,,0,0,0,,Dia lebih kuat daripada saya. Saya boleh banyak terluka
Dialog: 0,0:27:28.02,0:27:29.77,teks umum,,0,0,0,,Hujan membasahi pakaian saya
Dialog: 0,0:27:51.83,0:27:53.00,teks umum,,0,0,0,,Ini Chisu
Dialog: 0,0:27:53.79,0:27:55.71,teks umum,,0,0,0,,Dia mengeringkan pakaiannya dengan begitu mudah
Dialog: 0,0:27:55.79,0:27:58.42,teks umum,,0,0,0,,Ini adalah tahap tertinggi Chisu
Dialog: 0,0:28:05.22,0:28:06.85,teks umum,,0,0,0,,Ijazah tertinggi?
Dialog: 0,0:28:08.14,0:28:09.60,teks umum,,0,0,0,,Saya boleh mati
Dialog: 0,0:28:13.23,0:28:14.77,teks umum,,0,0,0,,Sekarang kering
Dialog: 0,0:28:23.78,0:28:25.12,miring,,0,0,0,,Jangan minum teh ini
Dialog: 0,0:28:29.87,0:28:31.37,teks umum,,0,0,0,,Awak dah minum semua?
Dialog: 0,0:28:31.46,0:28:32.46,teks umum,,0,0,0,,Ya
Dialog: 0,0:28:32.54,0:28:34.63,teks umum,,0,0,0,,Awak okay? Adakah sesuatu yang menyakitkan?
Dialog: 0,0:28:37.25,0:28:38.30,teks umum,,0,0,0,,Adakah ini air rebusan beracun?
Dialog: 0,0:28:39.21,0:28:40.59,contact,,0,0,0,,Tidak, sudah tentu
Dialog: 0,0:28:40.67,0:28:41.97,teks umum,,0,0,0,,Rebusan air rebusan
Dialog: 0,0:28:42.05,0:28:43.30,teks umum,,0,0,0,,Prutnyak?
Dialog: 0,0:28:43.38,0:28:44.64,teks umum,,0,0,0,,Rebusan ranting?
Dialog: 0,0:28:45.22,0:28:48.26,teks am,,0,0,0,,Anda bercakap tentang herba yang tumbuh hanya di Danhyangok
Dialog: 0,0:28:48.35,0:28:49.68,teks umum,,0,0,0,,Adakah anda bercakap tentang ranting?
Dialog: 0,0:28:51.98,0:28:53.81,teks umum,,0,0,0,,Adakah anda tahu tentang dia?
Dialog: 0,0:28:53.89,0:28:56.86,teks umum,,0,0,0,,Saya dengar ahli silap mata minum teh jenis ini...
Dialog: 0,0:28:56.94,0:29:00.28,teks umum,,0,0,0,,Dia menurunkan libido dan mereka dengan tenang melatih
Dialog: 0,0:29:01.69,0:29:03.36,teks umum,,0,0,0,,Libido? Apakah ini?
Dialog: 0,0:29:04.20,0:29:06.99,teks umum,,0,0,0,,Keinginan duniawi, salah satu daripada lima keperluan manusia
Dialog: 0,0:29:07.07,0:29:08.58,teks umum,,0,0,0,, Carnal...
Dialog: 0,0:29:11.29,0:29:13.37,teks umum,,0,0,0,,Prutnyak merendahkan...
Dialog: 0,0:29:14.87,0:29:18.09,teks umum,,0,0,0,,tenaga yang menyebabkan keinginan ini
Dialog: 0,0:29:20.30,0:29:23.09,teks umum,,0,0,0,,Saya mendengar tentang ahli sihir yang mencapai tahap sihir yang tinggi
Dialog: 0,0:29:23.17,0:29:25.80,teks umum,,0,0,0,,Dia berjaya kerana menurunkan libidonya dan bertambah baik
Dialog: 0,0:29:25.88,0:29:29.05,contact,,0,0,0,,Mereka mengatakan dia hanya memakai pakaian yang diperbuat daripada kain rami,
Dialog: 0,0:29:29.14,0:29:32.35,teks umum,,0,0,0,, itulah sebabnya Cikgu Li digelar "Master Hemp Li"
Dialog: 0,0:29:32.43,0:29:36.14,teks umum,,0,0,0,,Dan anda bijak untuk hamba yang sederhana
Dialog: 0,0:29:38.77,0:29:41.98,teks umum,,0,0,0,,Adalah satu penghormatan bagi saya untuk bertemu dengan ahli silap mata sebegitu rupa
Dialog: 0,0:29:42.53,0:29:44.49,teks umum,,0,0,0,,Salam, Master HempLi
Dialog: 0,0:29:53.12,0:29:54.08,teks umum,,0,0,0,,Hos,
Dialog: 0,0:29:54.16,0:29:56.08,teks umum,,0,0,0,,kenapa awak duduk? Tanya khabar
Dialog: 0,0:29:59.21,0:30:02.50,teks umum,,0,0,0,,Jadi... libido saya sudah agak sama?..
Dialog: 0,0:30:03.88,0:30:05.01,teks umum,,0,0,0,,Tidak...
Dialog: 0,0:30:05.09,0:30:06.09,teks umum,,0,0,0,,Tidak...
Dialog: 0,0:30:06.17,0:30:07.72,teks umum,,0,0,0,,Tetapi bukan ini...
Dialog: 0,0:30:08.43,0:30:10.35,teks umum,,0,0,0,,Ini tidak boleh. Tolong saya
Dialog: 0,0:30:11.18,0:30:13.93,teks umum,,0,0,0,,Satu cerek tidak mencukupi untuk ini
Dialog: 0,0:30:14.02,0:30:15.85,teks umum,,0,0,0,,Adakah anda pasti? Beritahu saya perkara sebenar!
Dialog: 0,0:30:15.93,0:30:17.94,contact,,0,0,0,,Memang benar. Jika anda sangat risau,
Dialog: 0,0:30:18.02,0:30:20.48,teks umum,,0,0,0,,Saya akan membancuh teh lain yang akan meletakkan semuanya kembali pada tempatnya
Dialog: 0,0:30:22.44,0:30:25.07,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:30:25.15,0:30:26.15,contact,,0,0,0,,Cikgu Li
Dialog: 0,0:30:26.24,0:30:28.99,teks umum,,0,0,0,,Bolehkah kamu membantu tuan saya?
Dialog: 0,0:30:29.07,0:30:33.45,teks umum,,0,0,0,,Tenaganya telah terkumpul di tangan kanannya dan dia tidak dapat mengawalnya
Dialog: 0,0:30:33.54,0:30:37.46,teks umum,,0,0,0,,Bolehkah anda mengajarnya bagaimana untuk mengatasinya?
Dialog: 0,0:30:37.54,0:30:39.21,teks umum,,0,0,0,,Tidak sukar untuk mengajarnya
Dialog: 0,0:30:39.29,0:30:42.25,teks umum,,0,0,0,,Tetapi! Untuk belajar daripada saya, anda perlu mengikuti semua yang saya katakan.
Dialog: 0,0:30:42.34,0:30:43.55,teks umum,,0,0,0,,Bersedia untuk ini?
Dialog: 0,0:30:43.63,0:30:45.05,contact,,0,0,0,,Dia bersedia untuk apa sahaja
Dialog: 0,0:30:45.13,0:30:46.05,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:30:48.59,0:30:51.35,teks umum,,0,0,0,,Apa sebenarnya yang perlu saya lakukan?
Dialog: 0,0:30:51.43,0:30:52.55,teks umum,,0,0,0,,Seperti saya
Dialog: 0,0:30:53.35,0:30:54.77,teks umum,,0,0,0,,minum air rebusan ranting
Dialog: 0,0:30:56.06,0:30:58.48,teks umum,,0,0,0,,Bersedia untuk menurunkan taraf
Dialog: 0,0:31:01.15,0:31:02.23,teks umum,,0,0,0,,libido?
Dialog: 0,0:31:06.82,0:31:08.45,teks am,,0,0,0,,Adakah anda telah mengosongkan keseluruhan cerek?
Dialog: 0,0:31:08.95,0:31:09.95,teks umum,,0,0,0,,Ya
Dialog: 0,0:31:10.91,0:31:12.12,teks umum,,0,0,0,,Bolehkah anda melakukannya?
Dialog: 0,0:31:24.04,0:31:26.30,teks umum,,0,0,0,,Jadi bagaimana jika dia seorang ahli silap mata terkenal?
Dialog: 0,0:31:26.38,0:31:30.09,teks umum,,0,0,0,,Dia tidak mempunyai pelajar, dan dia berkeliaran di sini tanpa sebab yang jelas
Dialog: 0,0:31:30.93,0:31:33.18,teks umum,,0,0,0,,Dengan bantuannya, semuanya akan berjalan lebih pantas
Dialog: 0,0:31:33.68,0:31:36.43,teks umum,,0,0,0,,Anda akan dapat mengawal tenaga di tangan kanan anda
Dialog: 0,0:31:36.52,0:31:40.10,teks umum,,0,0,0,,Hei, dia mahu saya minum teh kesucian ini. Apa gunanya?
Dialog: 0,0:31:40.19,0:31:44.65,teks umum,,0,0,0,,Saya sudah risau tentang berapa banyak yang saya minum semalam
Dialog: 0,0:31:44.73,0:31:47.15,teks umum,,0,0,0,,Saya ragu bahawa teh ini akan mencukupi untuk mengembalikan segala-galanya
Dialog: 0,0:31:47.23,0:31:49.07,teks umum,,0,0,0,,Ini masuk akal
Dialog: 0,0:31:50.20,0:31:52.16,teks umum,,0,0,0,,Bukan idea yang buruk
Dialog: 0,0:31:52.24,0:31:55.62,teks umum,,0,0,0,,Kini anda tidak memerlukan libido yang meningkat
Dialog: 0,0:31:59.71,0:32:03.00,teks umum,,0,0,0,,Jadi, untuk beberapa lama saya tidak akan mempunyai sebarang keinginan?
Dialog: 0,0:32:04.96,0:32:06.96,teks umum,,0,0,0,,Moo Dok, pandang mata saya dan beritahu saya
Dialog: 0,0:32:07.05,0:32:08.55,teks umum,,0,0,0,,Ya! Dan apa?
Dialog: 0,0:32:08.63,0:32:10.59,teks umum,,0,0,0,,Fikir sendiri. Ini adalah peluang yang jarang berlaku
Dialog: 0,0:32:10.67,0:32:12.88,teks umum,,0,0,0,,Tidak semua orang bodoh bernasib baik untuk bertemu dengan orang seperti dia
Dialog: 0,0:32:13.93,0:32:15.55,teks umum,,0,0,0,,Sedikit sekatan
Dialog: 0,0:32:16.60,0:32:17.60,teks umum,,0,0,0,,dan hapuskannya
Dialog: 0,0:32:17.68,0:32:20.18,teks umum,,0,0,0,,Ini bukan jalan-jalan di taman, jangan ganggu saya di sini!
Dialog: 0,0:32:20.27,0:32:22.31,teks umum,,0,0,0,,Bujangan adalah pengorbanan yang tidak penting untuk ahli silap mata peringkat tinggi
Dialog: 0,0:32:22.39,0:32:24.19,teks umum,,0,0,0,,Dengar sahaja!
Dialog: 0,0:32:24.27,0:32:26.73,teks umum,,0,0,0,,Anda tidak kisah walaupun saya merosakkan segala-galanya untuk diri saya di sana selama-lamanya!
Dialog: 0,0:32:26.82,0:32:28.28,teks umum,,0,0,0,,Berhenti membuat gunung daripada molehills!
Dialog: 0,0:32:28.36,0:32:30.40,teks umum,,0,0,0,,Adalah penting bagi saya, tidak kira sama ada saya menggunakannya atau tidak!
Dialog: 0,0:32:41.62,0:32:43.17,teks umum,,0,0,0,,Hei...
Dialog: 0,0:32:43.25,0:32:45.96,teks umum,,0,0,0,,Hei Moo Deok, awak okay?
Dialog: 0,0:32:46.54,0:32:48.59,teks umum,,0,0,0,,Apa yang baru berlaku?
Dialog: 0,0:32:49.63,0:32:50.55,teks umum,,0,0,0,,Ryusu
Dialog: 0,0:32:52.84,0:32:55.26,teks umum,,0,0,0,,Tenaga bocor daripada anda
Dialog: 0,0:32:56.76,0:32:59.18,teks umum,,0,0,0,,Sedikit tenaga dan lonjakan kuasa sedemikian
Dialog: 0,0:32:59.77,0:33:02.81,teks umum,,0,0,0,,Jika anda menanggalkan gelang itu dan menggunakan seluruh kekuatan anda,
Dialog: 0,0:33:02.89,0:33:04.69,teks umum,,0,0,0,,Saya akan mati di tempat kejadian
Dialog: 0,0:33:08.44,0:33:09.90,teks umum,,0,0,0,,Hei, awak berdarah...
Dialog: 0,0:33:12.32,0:33:14.32,teks umum,,0,0,0,,Cikgu, kamu benar-benar gila
Dialog: 0,0:33:14.40,0:33:16.41,teks umum,,0,0,0,,- Adakah anda suka idea bahawa saya boleh mati?\N- Ya
Dialog: 0,0:33:16.49,0:33:19.41,teks umum,,0,0,0,,Ini bermakna anda semakin kuat
Dialog: 0,0:33:23.00,0:33:26.37,teks umum,,0,0,0,,Sekarang ini mungkin kelihatan tidak penting,
Dialog: 0,0:33:26.46,0:33:29.67,teks umum,,0,0,0,,tetapi tidak lama lagi anda akan mempunyai lebih banyak tenaga
Dialog: 0,0:33:30.46,0:33:33.84,teks umum,,0,0,0,,dan kekuatan anda akan menjadi hebat seperti Tasik Gyeongjeongdaeho
Dialog: 0,0:33:35.97,0:33:38.39,teks umum,,0,0,0,,Maka saya juga boleh memulihkan kekuatan saya
Dialog: 0,0:33:52.28,0:33:55.36,teks umum,,0,0,0,,Sapu darah dari dahi sebelum membanjiri Gyeongjeongdaeho
Dialog: 0,0:33:58.78,0:33:59.62,teks umum,,0,0,0,,Adakah ia menyakitkan?
Dialog: 0,0:33:59.70,0:34:01.33,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,0:34:01.41,0:34:02.91,teks umum,,0,0,0,,Berhenti menjadi berani
Dialog: 0,0:34:07.79,0:34:09.71,teks umum,,0,0,0,,Tahun pertama pemerintahan Raja Go San
Dialog: 0,0:34:09.79,0:34:12.17,teks umum,,0,0,0,,Hari April
Dialog: 0,0:34:18.72,0:34:20.05, inskripsi,,0,0,0,,Go San, tahun satu, 1 April
Dialog: 0,0:34:20.14,0:34:23.60,kenangan miring,,0,0,0,, Bintang Raja bersinar di langit malam pada hari lahir budak itu
Dialog: 0,0:34:23.68,0:34:26.31,kenangan,,0,0,0,,Tiada sesiapa patut tahu tentang perkara ini
Dialog: 0,0:34:26.39,0:34:28.90,kenangan,,0,0,0,,Tetapi Jeongbugwan mungkin membuat rakaman
Dialog: 0,0:34:28.98,0:34:31.31,kenangan,,0,0,0,,Saya mengambil tanda sebenar dari sana
Dialog: 0,0:34:31.40,0:34:32.73,kenangan,,0,0,0,,Di Jeonbugwan
Dialog: 0,0:34:33.86,0:34:35.49,kenangan,,0,0,0,,palsu tanpa bintang
Dialog: 0,0:34:37.11,0:34:41.32,kenangan miring,,0,0,0,,Jangan biarkan sesiapa tahu rahsia kelahirannya
Dialog: 0,0:34:45.95,0:34:48.54,teks umum,,0,0,0,,Nampak buruj pelik?
Dialog: 0,0:34:57.42,0:35:01.51,teks umum,,0,0,0,,Ini hari lahir Wook dan kematian Lady Do Hwa
Dialog: 0,0:35:04.26,0:35:05.93,teks umum,,0,0,0,,Saya mendengar tentang nasihat itu
Dialog: 0,0:35:06.89,0:35:11.44,teks umum,,0,0,0,,Semua ahli silap mata yang mulia telah berkumpul kerana saya
Dialog: 0,0:35:14.23,0:35:15.53,contact,,0,0,0,,Timbalan Gwangju,
Dialog: 0,0:35:16.32,0:35:18.15,italic,,0,0,0,,kenapa anda tidak memulakan salasilah anda?
Dialog: 0,0:35:19.20,0:35:21.99,teks umum,,0,0,0,,Dengan undian tunggal,
Dialog: 0,0:35:22.07,0:35:26.66,teks umum,,0,0,0,,anda juga mungkin diiktiraf sebagai ahli silap mata yang dihormati
Dialog: 0,0:35:29.37,0:35:32.79,teks umum,,0,0,0,,Saya dari puak Jin. Jinyeowon ialah tempat saya dilahirkan
Dialog: 0,0:35:35.84,0:35:37.71,teks umum,,0,0,0,,Apa yang membawa anda ke Jeonbugwan?
Dialog: 0,0:35:37.80,0:35:39.30,teks umum,,0,0,0,,Orang nomad yang ditemui di Sosnovy Bor,
Dialog: 0,0:35:39.38,0:35:41.59,teks umum,,0,0,0,,adalah ahli nujum dari Jeonbugwan
Dialog: 0,0:35:42.34,0:35:44.76,teks umum,,0,0,0,,Ahli silap mata Chongjingak memulakan siasatan,
Dialog: 0,0:35:45.47,0:35:46.68,teks umum,,0,0,0,,memberi bantuan
Dialog: 0,0:35:47.39,0:35:49.35,teks umum,,0,0,0,,Siasatan apa?
Dialog: 0,0:35:54.11,0:35:58.03,teks umum,,0,0,0,,Dan jika saya memberitahu anda, adakah anda akan menyembunyikan semua bukti?
Dialog: 0,0:36:01.07,0:36:03.62,teks umum,,0,0,0,,Saya tidak mempunyai apa-apa untuk disembunyikan
Dialog: 0,0:36:03.70,0:36:05.58,teks umum,,0,0,0,,Mereka boleh datang pada bila-bila masa
Dialog: 0,0:36:06.95,0:36:09.66,teks umum,,0,0,0,,Mereka sudah ada di sini
Dialog: 0,0:36:34.15,0:36:35.94,teks umum,,0,0,0,,Ahli silap mata ini sepatutnya
Dialog: 0,0:36:36.02,0:36:38.98,teks umum,,0,0,0,, sentiasa mengekalkan jumlah tenaga yang diperlukan di sini
Dialog: 0,0:36:40.03,0:36:42.70,teks umum,,0,0,0,,Dia bertanggungjawab untuk tempat ini
Dialog: 0,0:36:51.45,0:36:54.67,teks umum,,0,0,0,,Apa? Mayat di Jeonbugwan?
Dialog: 0,0:36:54.75,0:36:57.96,teks umum,,0,0,0,,Eunuch Kim mengekstrak semua tenaganya, badan di dalam bilik rahsia
Dialog: 0,0:37:12.73,0:37:15.10,teks umum,,0,0,0,,Tiada apa-apa yang istimewa dalam karyanya
Dialog: 0,0:37:15.19,0:37:18.27,teks umum,,0,0,0,,Sekadar ucapan untuk diam-diam melihat tanda-tanda buruj
Dialog: 0,0:37:21.65,0:37:22.69,teks umum,,0,0,0,,Pakcik
Dialog: 0,0:37:23.78,0:37:27.16,teks umum,,0,0,0,,Ramai saintis telah hilang di sini
Dialog: 0,0:37:27.24,0:37:28.62,teks umum,,0,0,0,,Ke mana mereka boleh hilang?
Dialog: 0,0:37:35.37,0:37:37.00,teks umum,,0,0,0,,Terima kasih atas bantuan anda
Dialog: 0,0:37:37.67,0:37:39.09,teks umum,,0,0,0,,Tiada yang istimewa
Dialog: 0,0:37:39.17,0:37:41.42,teks umum,,0,0,0,,Saya ada satu permintaan lagi
Dialog: 0,0:37:42.30,0:37:43.92,teks umum,,0,0,0,,Mungkin ini terlalu banyak,
Dialog: 0,0:37:44.72,0:37:48.26,teks umum,,0,0,0,,tetapi saya ingin melihat bilik rahsia Jeonbugwan
Dialog: 0,0:38:06.03,0:38:07.91,teks umum,,0,0,0,,Anda boleh melihat sekeliling
Dialog: 0,0:38:34.27,0:38:36.98,kenangan miring,,0,0,0,,Membawa mayat melalui laluan bawah tanah
Dialog: 0,0:38:49.20,0:38:52.12,kenangan miring,,0,0,0,,Jika mereka menyembunyikan sesuatu, mereka akan cuba menyingkirkannya
Dialog: 0,0:38:52.95,0:38:54.58,kenangan miring,,0,0,0,,Perhatikan umatnya
Dialog: 0,0:38:58.67,0:38:59.87,teks umum,,0,0,0,,Lebih pantas
Dialog: 0,0:39:13.26,0:39:15.18,teks umum,,0,0,0,,Kami melihat bagaimana kereta ini meninggalkan Jeonbugwan
Dialog: 0,0:39:15.27,0:39:17.06,teks umum,,0,0,0,,Adakah anda ahli silap mata?
Dialog: 0,0:39:17.14,0:39:18.27,teks umum,,0,0,0,,Tunjukkan muka
Dialog: 0,0:39:18.35,0:39:19.56,teks umum,,0,0,0,,Kami ingin melihat apa yang ada di dalamnya
Dialog: 0,0:40:03.19,0:40:04.11,teks umum,,0,0,0,,Jom dapatkan dia
Dialog: 0,0:40:52.20,0:40:53.74,teks umum,,0,0,0,,Lelaki itu melarikan diri
Dialog: 0,0:40:55.11,0:40:56.66,teks umum,,0,0,0,,Adakah anda kehilangannya?
Dialog: 0,0:40:58.87,0:41:00.16,teks umum,,0,0,0,,Ini ada di dalam
Dialog: 0,0:41:00.79,0:41:02.25,teks umum,,0,0,0,,Azimat Roh
Dialog: 0,0:41:03.12,0:41:05.21,teks umum,,0,0,0,,Adakah mereka dari Sosnovy Bor?
Dialog: 0,0:41:20.68,0:41:23.89,teks umum,,0,0,0,,Terdapat azimat semangat dalam troli
Dialog: 0,0:41:23.98,0:41:26.06,teks umum,,0,0,0,,Tiada soalan harus timbul
Dialog: 0,0:41:27.06,0:41:29.65,teks umum,,0,0,0,,Nak Su membantu kami walaupun selepas kematian
Dialog: 0,0:41:33.15,0:41:36.20,teks umum,,0,0,0,,Maaf atas kesulitan, Timbalan Gwangju
Dialog: 0,0:41:40.91,0:41:43.75,teks umum,,0,0,0,,Anda menyerang seorang lelaki di tengah jalan?
Dialog: 0,0:41:43.83,0:41:46.67,teks umum,,0,0,0,,Saya telah memindahkan jiwa kamu yang tidak berharga kepada tubuh yang layak,
Dialog: 0,0:41:46.75,0:41:48.13,teks umum,,0,0,0,,tetapi anda tiada hak untuk menunjuk-nunjuk
Dialog: 0,0:41:48.21,0:41:49.38,teks umum,,0,0,0,,Maaf
Dialog: 0,0:41:58.05,0:42:00.14,teks umum,,0,0,0,,Sampaikan peti ini
Dialog: 0,0:42:03.31,0:42:05.48,teks umum,,0,0,0,,Pastikan ia berada di tangan yang betul
Dialog: 0,0:42:05.56,0:42:08.81,teks umum,,0,0,0,,Saya akan uruskannya dengan segera
Dialog: 0,0:42:19.49,0:42:21.41,teks umum,,0,0,0,,Sudah tiba masanya untuk menyingkirkannya
Dialog: 0,0:42:21.49,0:42:23.20,teks umum,,0,0,0,,Cari saya sida-sida lain
Dialog: 0,0:42:23.29,0:42:27.37,teks umum,,0,0,0,,Atau saya akan memindahkan jiwa awak ke dalam tubuhnya
Dialog: 0,0:42:30.38,0:42:32.05,teks umum,,0,0,0,,Ke dalam tubuh seorang sida?
Dialog: 0,0:42:32.96,0:42:35.72,teks umum,,0,0,0,,Apa? Tidak suka?
Dialog: 0,0:42:38.55,0:42:40.85,teks umum,,0,0,0,,Saya akan mengikut perintah anda
Dialog: 0,0:42:40.93,0:42:44.02,teks umum,,0,0,0,,Adakah anda masih membawa Reflektor bersama anda?
Dialog: 0,0:42:44.10,0:42:45.02,teks umum,,0,0,0,,Ya
Dialog: 0,0:42:53.65,0:42:57.07,teks umum,,0,0,0,,Saya sedang berfikir tentang menahan diri daripada berpindah jiwa kerana Sosnovy Bor
Dialog: 0,0:42:58.82,0:43:02.99,teks umum,,0,0,0,,Tetapi, nampaknya, ini adalah satu-satunya cara untuk berkhidmat kepada Baginda
Dialog: 0,0:43:08.71,0:43:12.09,contact,,0,0,0,,Azimat Sosnovy Bor ditemui dalam kereta pelik,
Dialog: 0,0:43:12.17,0:43:14.25,teks umum,,0,0,0,,yang meninggalkan Jeonbugwan
Dialog: 0,0:43:14.34,0:43:17.22,teks umum,,0,0,0,,Sekarang kami tiada hak untuk mencari apa-apa di sana
Dialog: 0,0:43:17.30,0:43:20.18,teks umum,,0,0,0,,Ketahui azimat siapa ini
Dialog: 0,0:43:20.76,0:43:24.72,teks umum,,0,0,0,,Ingat, Uk kehilangan
Dialog: 0,0:43:25.31,0:43:28.73,teks umum,,0,0,0,,Dan berdasarkan tanda terbakar ini, ini adalah azimatnya
Dialog: 0,0:43:30.10,0:43:31.40,teks umum,,0,0,0,,Azimat Uka?
Dialog: 0,0:43:31.48,0:43:35.61,teks umum,,0,0,0,,Cukup fikir, dia melarikan diri, tetapi masalah masih menimpa kita
Dialog: 0,0:43:35.69,0:43:37.44,teks umum,,0,0,0,,Cari Uka
Dialog: 0,0:43:37.53,0:43:41.45,teks umum,,0,0,0,,Ketahui bagaimana dan di mana dia kehilangannya
Dialog: 0,0:43:42.28,0:43:43.57,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:44:24.41,0:44:26.70,teks umum,,0,0,0,,Ini daripada Jin Moo, timbalan Jeonbugwan
Dialog: 0,0:44:36.67,0:44:39.80,teks umum,,0,0,0,,Apa yang dia terus hantar kepada anda?
Dialog: 0,0:44:40.55,0:44:43.84,teks am,,0,0,0,,Ini adalah herba ubatan untuk kesihatan saya
Dialog: 0,0:44:46.85,0:44:49.14,teks umum,,0,0,0,,Anda tidak boleh memberitahu daripadanya, tetapi dia sangat mengambil berat
Dialog: 0,0:45:04.11,0:45:05.03,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:45:05.11,0:45:07.70,teks am,,0,0,0,,Saya akan pergi bersama Cikgu Li untuk mengumpul herba
Dialog: 0,0:45:07.78,0:45:08.83,teks umum,,0,0,0,,Dan latihan?
Dialog: 0,0:45:08.91,0:45:11.83,teks umum,,0,0,0,,Saya perlu membayar untuk kandungannya. Jumpa lagi nanti
Dialog: 0,0:45:11.91,0:45:13.29,teks umum,,0,0,0,,- Jom\N- Ya
Dialog: 0,0:45:14.37,0:45:15.96,teks umum,,0,0,0,,Adakah ia sangat cantik di sana?
Dialog: 0,0:45:16.04,0:45:18.84,teks umum,,0,0,0,,- Sungguh menakjubkan\N- Saya harap saya dapat melihatnya tidak lama lagi
Dialog: 0,0:45:24.18,0:45:26.55,teks umum,,0,0,0,,Cikgu Li, awak sangat pandai
Dialog: 0,0:45:26.64,0:45:29.43,teks umum,,0,0,0,,Saya membeli segala-galanya dan menambahnya. pegang je
Dialog: 0,0:45:29.51,0:45:30.56,teks umum,,0,0,0,,- Jadi?\N- Ya
Dialog: 0,0:45:34.89,0:45:36.06,teks umum,,0,0,0,,Hebat
Dialog: 0,0:45:38.65,0:45:41.36,teks umum,,0,0,0,,Hari ini kita akan pergi ke tempat yang terdapat banyak tangerin*
Dialog: 0,0:45:38.65,0:45:41.36,nota,,0,0,0,,*Ikan kakap Cina
Dialog: 0,0:45:41.44,0:45:44.70,teks umum,,0,0,0,,Tangerin? Jom ambil apa yang perlu dan sediakan rebusan ikan
Dialog: 0,0:45:44.78,0:45:46.11,teks umum,,0,0,0,,Bolehkah anda melakukannya?
Dialog: 0,0:45:46.20,0:45:48.16,teks umum,,0,0,0,,Tidak, tetapi anda akan mengajar saya
Dialog: 0,0:45:49.08,0:45:50.91,teks umum,,0,0,0,,Ada apa dengan awak...
Dialog: 0,0:46:02.13,0:46:03.26,teks umum,,0,0,0,,Lebih masin
Dialog: 0,0:46:05.97,0:46:07.64,teks umum,,0,0,0,,Moo Dok, cuba
Dialog: 0,0:46:08.22,0:46:11.10,teks umum,,0,0,0,,Cikgu, adakah anda di sini untuk menangani perkara karut?
Dialog: 0,0:46:11.18,0:46:12.93,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:46:13.72,0:46:15.89,teks umum,,0,0,0,,Ada sesuatu untuk dipelajari daripada Guru Li
Dialog: 0,0:46:15.98,0:46:17.40,teks umum,,0,0,0,,Siapa yang meminta anda mempelajari ini?
Dialog: 0,0:46:17.48,0:46:19.48,teks umum,,0,0,0,,Jika anda belajar daripadanya, belajar dengan betul!
Dialog: 0,0:46:20.31,0:46:22.86,teks umum,,0,0,0,,Moo Dok, saya rasa saya sempurna untuk kehidupan seperti ini
Dialog: 0,0:46:22.94,0:46:24.57,teks umum,,0,0,0,,Terima kasih kerana membawa saya
Dialog: 0,0:46:24.65,0:46:26.24,teks umum,,0,0,0,,ke tempat yang begitu indah
Dialog: 0,0:46:28.82,0:46:29.99,teks umum,,0,0,0,,Anda tidak bimbang
Dialog: 0,0:46:32.12,0:46:34.20,teks umum,,0,0,0,,kerana pertarungan dengan putera raja?
Dialog: 0,0:46:35.62,0:46:37.67,teks umum,,0,0,0,,Jika anda sangat bimbang, fikirkan sendiri
Dialog: 0,0:46:39.63,0:46:40.58,teks umum,,0,0,0,,Sudah pasti terlebih garam
Dialog: 0,0:46:43.75,0:46:44.67,teks umum,,0,0,0,,Hei!
Dialog: 0,0:46:56.56,0:46:57.77,teks umum,,0,0,0,,Moo Dok, letakkan pisau
Dialog: 0,0:46:58.73,0:47:00.65,teks umum,,0,0,0,,Jangan berani lemparkan pada saya!
Dialog: 0,0:47:01.23,0:47:03.36,teks umum,,0,0,0,,Saya kata saya akan bunuh awak jika awak tidak berguna
Dialog: 0,0:47:04.48,0:47:05.57,teks umum,,0,0,0,,Anda tidak boleh membunuh saya
Dialog: 0,0:47:05.65,0:47:07.82,teks umum,,0,0,0,,Saya menguasai Chipsu, dan awak hanyalah Moo Dok
Dialog: 0,0:47:09.74,0:47:11.45,teks umum,,0,0,0,,Awak bukan Nak Soo lagi
Dialog: 0,0:47:14.12,0:47:15.79,teks umum,,0,0,0,,Hei, saya dah cakap!
Dialog: 0,0:47:16.50,0:47:19.33,teks umum,,0,0,0,,Anda dan saya tidak memerlukan kedamaian dan ketenangan
Dialog: 0,0:47:19.42,0:47:20.62,teks umum,,0,0,0,,Saya akan memusnahkan dunia awak
Dialog: 0,0:47:27.13,0:47:28.51,teks umum,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:47:28.59,0:47:30.72,teks umum,,0,0,0,,Kenapa awak menghalang saya daripada hidup aman?
Dialog: 0,0:47:30.80,0:47:32.68,teks umum,,0,0,0,,Adakah anda gembira dengan kehidupan seperti ini?
Dialog: 0,0:47:33.93,0:47:34.81,teks umum,,0,0,0,,Ya!
Dialog: 0,0:47:34.89,0:47:37.81,teks umum,,0,0,0,,Sama sekali. Jika anda tidak suka, pergi
Dialog: 0,0:47:37.89,0:47:39.81,teks umum,,0,0,0,,Saya suka tinggal di sini,
Dialog: 0,0:47:39.89,0:47:42.86,teks umum,,0,0,0,,dan anda boleh keluar jika anda menentangnya
Dialog: 0,0:47:45.19,0:47:46.53,teks umum,,0,0,0,,Bajingan
Dialog: 0,0:47:47.57,0:47:49.74,teks umum,,0,0,0,,Anda tahu bahawa kita dihubungkan oleh takdir
Dialog: 0,0:47:50.28,0:47:52.53,teks umum,,0,0,0,,Dan awak mahu saya selesaikan semuanya
Dialog: 0,0:47:54.37,0:47:55.66,teks umum,,0,0,0,,Pengecut
Dialog: 0,0:48:26.90,0:48:28.69,teks umum,,0,0,0,,Saya jumpa jalan untuk Uka
Dialog: 0,0:48:28.78,0:48:32.49,teks umum,,0,0,0,,elakkan pertarungan dan jadi gwangju Jeonbugwan
Dialog: 0,0:48:33.49,0:48:36.20,teks umum,,0,0,0,,Yang mana? Kami bersedia untuk apa sahaja
Dialog: 0,0:48:37.58,0:48:41.83,teks umum,,0,0,0,,Biar dia berkahwin dengan anak perempuan saya Cho Young
Dialog: 0,0:48:49.59,0:48:52.05,teks umum,,0,0,0,,Keluarga kami mempunyai azimat yang membolehkan
Dialog: 0,0:48:52.13,0:48:53.97,teks umum,,0,0,0,,menolak titah raja
Dialog: 0,0:48:59.06,0:49:01.64,teks umum,,0,0,0,,Kita juga boleh menggulingkan raja,
Dialog: 0,0:49:01.73,0:49:05.06,teks umum,,0,0,0,,jika semua ahli sihir Deho mengundi ini
Dialog: 0,0:49:06.02,0:49:09.86,teks umum,,0,0,0,,Azimat ini telah diamanahkan kepada kami oleh Majlis Bersatu
Dialog: 0,0:49:09.94,0:49:14.49,teks umum,,0,0,0,,untuk mengelakkan pelarian roh jahat yang dimeterai dalam Jinyeowon
Dialog: 0,0:49:15.07,0:49:19.79,teks umum,,0,0,0,,Anda bercadang untuk membatalkan perintah raja untuk melucutkan hak Uka
Dialog: 0,0:49:20.37,0:49:21.75,teks umum,,0,0,0,,jadi Gwangju seterusnya?
Dialog: 0,0:49:21.83,0:49:24.29,teks umum,,0,0,0,,Ya, tetapi hanya jika dia berkahwin dengan anak perempuan saya
Dialog: 0,0:49:24.92,0:49:26.79,teks umum,,0,0,0,,dan akan menyertai keluarga Jin
Dialog: 0,0:49:30.59,0:49:34.30,teks umum,,0,0,0,,Tetapi Puan Jin dan Encik Wook sekali
Dialog: 0,0:49:35.43,0:49:38.30,teks umum,,0,0,0,,pertunangan telah pun putus. Adakah ini tidak menjadi masalah?
Dialog: 0,0:49:39.72,0:49:41.93,teks umum,,0,0,0,,Bukan kerana perasaan saya terhadapnya telah berlalu
Dialog: 0,0:49:42.60,0:49:45.02,teks umum,,0,0,0,,Saya masih mahu berkahwin dengan Uka
Dialog: 0,0:49:49.40,0:49:51.73,teks umum,,0,0,0,,Saya tidak sangka dia akan berkahwin awal
Dialog: 0,0:49:51.82,0:49:53.90,teks umum,,0,0,0,,Dan saya tidak pasti dia sudah bersedia untuk berkahwin
Dialog: 0,0:50:03.66,0:50:06.58,teks umum,,0,0,0,,Anda berbuat baik untuk anak orang kaya
Dialog: 0,0:50:06.67,0:50:09.79,teks umum,,0,0,0,,Sebaik sahaja saya teruja dengan sesuatu, saya belajar dengan cepat
Dialog: 0,0:50:09.88,0:50:11.09,teks umum,,0,0,0,,Sekarang saya lebih menyukai awak
Dialog: 0,0:50:12.76,0:50:15.38,teks umum,,0,0,0,,Pertimbangkan semula keinginan anda untuk menjadi pelajar saya
Dialog: 0,0:50:16.38,0:50:19.43,teks umum,,0,0,0,,Cikgu, bukankah anda mempunyai seorang pelajar?
Dialog: 0,0:50:21.14,0:50:22.89,teks umum,,0,0,0,,Ada satu,
Dialog: 0,0:50:22.97,0:50:24.98,teks umum,,0,0,0,,tetapi dia berhenti membujang dan berkahwin
Dialog: 0,0:50:26.94,0:50:28.85,teks umum,,0,0,0,,Dia bekerja di hospital sekarang
Dialog: 0,0:50:36.53,0:50:38.86,teks umum,,0,0,0,,Anda boleh mengubah fikiran dan menolak pada bila-bila masa
Dialog: 0,0:50:38.95,0:50:40.07,teks umum,,0,0,0,,Fikirkanlah
Dialog: 0,0:50:41.95,0:50:44.20,teks umum,,0,0,0,,Saya tidak datang ke sini untuk latihan
Dialog: 0,0:50:44.29,0:50:46.08,teks umum,,0,0,0,,Adakah anda benar-benar mahu menghabiskan kuasa ini
Dialog: 0,0:50:46.16,0:50:48.83,teks am,,0,0,0,,memancing dan mengumpul herba?
Dialog: 0,0:50:54.09,0:50:57.05,teks umum,,0,0,0,,- Saya masih tidak mengawalnya\N- Ya?
Dialog: 0,0:50:57.72,0:51:00.22,teks umum,,0,0,0,,Tangan ini akan menjadi beban jika dibiarkan begini
Dialog: 0,0:51:01.89,0:51:03.64,teks umum,,0,0,0,,Adakah anda mahu saya mengambil semua tenaga?
Dialog: 0,0:51:05.60,0:51:08.69,teks umum,,0,0,0,,Maka anda boleh menjalani kehidupan biasa
Dialog: 0,0:51:23.70,0:51:26.45,teks umum,,0,0,0,,Saya akan pergi ke bandar. Sudikah awak ikut saya?
Dialog: 0,0:51:26.54,0:51:29.46,teks umum,,0,0,0,,Tidak, bukan hari ini. Saya perlu memasak Moo Deok untuk makan
Dialog: 0,0:51:30.67,0:51:33.71,teks umum,,0,0,0,,Dia tiada di sini. Dia baru-baru ini turun gunung
Dialog: 0,0:51:34.92,0:51:36.05,teks umum,,0,0,0,,Apa?
Dialog: 0,0:51:36.13,0:51:38.97,italic,,0,0,0,,Chan Wook hanya seorang genius
Dialog: 0,0:51:39.05,0:51:41.34,italic,,0,0,0,,Dia sudah menguasai Ryusu
Dialog: 0,0:51:41.43,0:51:44.01,teks umum,,0,0,0,,dan sedang berlatih keras untuk pertarungan
Dialog: 0,0:51:46.14,0:51:48.56,teks umum,,0,0,0,,Biar khabar angin sebegitu tersebar di seluruh bandar
Dialog: 0,0:51:48.64,0:51:49.69,teks umum,,0,0,0,,Serius?
Dialog: 0,0:51:50.39,0:51:53.15,teks umum,,0,0,0,,Jika dia tidak muncul, dia akan kehilangan muka sepenuhnya
Dialog: 0,0:51:54.19,0:51:57.32,teks umum,,0,0,0,,Sekurang-kurangnya dia akan rasa terhina
Dialog: 0,0:51:58.03,0:51:59.28,teks umum,,0,0,0,,Beri saya sedikit ayam
Dialog: 0,0:51:59.36,0:52:01.95,teks umum,,0,0,0,,Tinggalkan hari ini. Berikut ialah penduduk Jeonbugwan
Dialog: 0,0:52:02.03,0:52:03.99,italic,,0,0,0,,Seseorang penting datang hari ini
Dialog: 0,0:52:05.08,0:52:06.79,teks umum,,0,0,0,,Lebih baik jangan bersilang dengan dia,
Dialog: 0,0:52:06.87,0:52:08.41,teks umum,,0,0,0,,terutama selepas cerita dengan azimat
Dialog: 0,0:52:29.39,0:52:30.27,teks umum,,0,0,0,,Ayuh, berhenti!
Dialog: 0,0:52:35.44,0:52:37.69,teks umum,,0,0,0,,Adakah anda pembantu rumah Chan Wook?
Dialog: 0,0:52:38.78,0:52:40.57,teks umum,,0,0,0,,Ya. Dan apa?
Dialog: 0,0:52:41.36,0:52:44.78,suara,,0,0,0,,Nak Soo tidak akan pernah memindahkan jiwanya ke dalam tubuh seperti itu
Dialog: 0,0:52:45.95,0:52:46.99,contact,,0,0,0,,Hei awak
Dialog: 0,0:52:47.66,0:52:51.04,teks umum,,0,0,0,,Adakah anda masih ingat ketika kita bertemu di rumah penginapan di tepi jeti?
Dialog: 0,0:53:01.05,0:53:02.84,teks umum,,0,0,0,,saya pun tak tahu
Dialog: 0,0:53:06.97,0:53:08.26,luar skrin,,0,0,0,,Dia mengesyaki saya
Dialog: 0,0:53:09.39,0:53:12.35,teks umum,,0,0,0,,Saya ingin bertanya kepada anda beberapa soalan. Mari bersama kami ke Jeonbugwan
Dialog: 0,0:53:15.77,0:53:16.81,miring,,0,0,0,,Jom
Dialog: 0,0:53:16.90,0:53:18.98,teks umum,,0,0,0,,- Biar saya pergi\N- Berdiam diri
Dialog: 0,0:53:19.07,0:53:20.48,teks umum,,0,0,0,,- Kenapa awak...\N- Baik, diam
Dialog: 0,0:53:22.90,0:53:24.03,luar skrin,,0,0,0,,Dia tidak mempunyai tanda biru
Dialog: 0,0:53:25.57,0:53:27.45,suara,,0,0,0,,Dia betul, bukan Nak Soo?
Dialog: 0,0:53:29.37,0:53:32.58,teks umum,,0,0,0,,Saya tidak tahu di mana tuannya
Dialog: 0,0:53:36.13,0:53:37.33,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:53:41.21,0:53:42.42,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:53:43.55,0:53:45.22,teks umum,,0,0,0,,Yang Mulia, ini saya
Dialog: 0,0:53:45.30,0:53:46.68,teks umum,,0,0,0,,Ini saya, Won Mu Deok
Dialog: 0,0:53:59.31,0:54:00.73,teks umum,,0,0,0,,You are Won Mu Deok
Dialog: 0,0:54:00.82,0:54:04.24,teks umum,,0,0,0,,Ya, ini saya. Anda memberi saya nama ini
Dialog: 0,0:54:04.32,0:54:05.86,teks umum,,0,0,0,,Saya Won Mu Deok
Dialog: 0,0:54:08.07,0:54:10.95,teks umum,,0,0,0,,Yang Mulia, tolong saya
Dialog: 0,0:54:11.03,0:54:12.16,teks umum,,0,0,0,,Dengan apa?
Dialog: 0,0:54:12.75,0:54:15.87,teks umum,,0,0,0,,Yang Mulia, anda bukan sahaja bijak, tetapi juga sangat kuat
Dialog: 0,0:54:15.96,0:54:18.21,teks umum,,0,0,0,,Dan tuan saya, sebaliknya, adalah bodoh dan menyedihkan
Dialog: 0,0:54:18.29,0:54:20.09,teks umum,,0,0,0,,Kerana dia, hidup saya dalam bahaya
Dialog: 0,0:54:20.17,0:54:21.92,italic,,0,0,0,,Tolong bantu saya
Dialog: 0,0:54:28.43,0:54:30.97,teks umum,,0,0,0,,Terima kasih banyak Yang Amat Mulia
Dialog: 0,0:54:33.06,0:54:35.89,teks umum,,0,0,0,,Apa yang tuan bodoh dan menyedihkan buat?
Dialog: 0,0:54:35.98,0:54:38.19,teks umum,,0,0,0,,Dia hanya menangis setiap hari
Dialog: 0,0:54:38.27,0:54:41.32,teks umum,,0,0,0,,Dia sangat takut kepada anda sehingga dia gemetar ketakutan
Dialog: 0,0:54:41.40,0:54:43.15,teks umum,,0,0,0,,dan tangisan secara rahsia
Dialog: 0,0:54:43.94,0:54:46.82,teks umum,,0,0,0,,Saya nampak awak bercakap buruk tentang dia untuk menggembirakan saya
Dialog: 0,0:54:47.74,0:54:51.24,teks umum,,0,0,0,,Saya boleh mengatakan perkara yang lebih buruk jika ia menggembirakan anda
Dialog: 0,0:54:52.41,0:54:56.00,teks umum,,0,0,0,,Won Moo Deok, anda mesti fikir saya menyedihkan
Dialog: 0,0:54:56.58,0:54:58.50,teks umum,,0,0,0,,Anda tidak memberi saya nama ini secara percuma
Dialog: 0,0:54:59.08,0:55:02.38,teks umum,,0,0,0,,Anda boleh beritahu saya semua yang anda mahu, tetapi tidak boleh,
Dialog: 0,0:55:02.46,0:55:04.21,teks umum,,0,0,0,,kerana mereka takut kelihatan menyedihkan
Dialog: 0,0:55:05.38,0:55:07.67,teks umum,,0,0,0,,Adakah anda mahu menjadi tong sampah lisan?
Dialog: 0,0:55:07.76,0:55:10.51,teks umum,,0,0,0,,Ini adalah tajuk yang terlalu tinggi untuk saya
Dialog: 0,0:55:10.59,0:55:12.39,teks umum,,0,0,0,,Tetapi ia adalah satu penghormatan bagi saya
Dialog: 0,0:55:14.47,0:55:16.81,teks umum,,0,0,0,,Saya tidak perlukan awak untuk meredakan ketegangan
Dialog: 0,0:55:18.48,0:55:21.48,teks umum,,0,0,0,,Yang Mulia, anda telah melakukan cukup,
Dialog: 0,0:55:21.56,0:55:24.98,teks umum,,0,0,0,,tetapi bolehkah anda mengarahkan orang itu supaya tidak membawa saya?
Dialog: 0,0:55:25.65,0:55:27.11,teks umum,,0,0,0,,Amaran sudah memadai
Dialog: 0,0:55:35.04,0:55:36.37,teks umum,,0,0,0,,Ambil ini
Dialog: 0,0:55:37.83,0:55:39.04,italic,,0,0,0,,Ini uncang saya
Dialog: 0,0:55:39.12,0:55:40.29,nota,,0,0,0,,Sachet - pad kertas atau kain (beg) dengan isi wangi yang longgar
Dialog: 0,0:55:40.37,0:55:43.67,teks umum,,0,0,0,,Tunjukkan ini jika tuan anda yang menyedihkan membuat anda menghadapi masalah lagi
Dialog: 0,0:55:44.63,0:55:47.01,teks umum,,0,0,0,,Terima kasih banyak
Dialog: 0,0:55:52.97,0:55:54.81,teks umum,,0,0,0,,Dia berbau seperti kayu manis
Dialog: 0,0:55:54.89,0:55:56.68,teks umum,,0,0,0,,Mengapa awak mempunyai wajah sedemikian?
Dialog: 0,0:55:56.77,0:55:58.85,teks umum,,0,0,0,,Apa? Adakah anda tidak menyukainya?
Dialog: 0,0:55:58.93,0:56:01.48,teks umum,,0,0,0,,Tidak, saya sangat menyukainya
Dialog: 0,0:56:02.19,0:56:03.69,teks umum,,0,0,0,,- Jika anda tidak menyukainya, kembalikan {\i1}\N- Tidak
Dialog: 0,0:56:03.77,0:56:05.82,teks umum,,0,0,0,,Saya sudah mengotorinya dengan diri saya sendiri
Dialog: 0,0:56:07.15,0:56:09.86,teks umum,,0,0,0,,Saya mengucapkan terima kasih atas hadiah berbau harum ini
Dialog: 0,0:56:11.78,0:56:14.91,teks umum,,0,0,0,,Izinkan saya menuangkan minuman yang berbau harum
Dialog: 0,0:56:25.17,0:56:26.59,italic,,0,0,0,,Ini adalah wain dengan kayu manis dan halia
Dialog: 0,0:56:26.67,0:56:27.96,teks umum,,0,0,0,,Terdapat banyak kayu manis
Dialog: 0,0:56:30.05,0:56:32.55,teks umum,,0,0,0,,Anda mungkin tidak menyukainya. Kembalikan sachet
Dialog: 0,0:56:33.18,0:56:34.18,teks umum,,0,0,0,,Tidak
Dialog: 0,0:56:34.26,0:56:35.47,teks umum,,0,0,0,,Suka
Dialog: 0,0:56:45.56,0:56:47.86,teks umum,,0,0,0,,- Sedap?\N- Sangat
Dialog: 0,0:56:47.94,0:56:48.90,teks umum,,0,0,0,,Minum lebih banyak
Dialog: 0,0:56:56.99,0:56:59.87,teks umum,,0,0,0,,Moo Dok mungkin pergi ke Chwisong-ru. Dia tidak mempunyai tempat lain untuk pergi
Dialog: 0,0:57:00.41,0:57:02.16,teks umum,,0,0,0,,Adakah dia marah dan pergi?
Dialog: 0,0:57:03.25,0:57:04.83,teks umum,,0,0,0,,Pembantu rumah apakah ini?
Dialog: 0,0:57:05.50,0:57:07.13,teks umum,,0,0,0,,Dia bukan hanya seorang hamba
Dialog: 0,0:57:07.75,0:57:11.09,teks umum,,0,0,0,,Jika dia bukan hanya seorang hamba, maka siapa?
Dialog: 0,0:57:12.01,0:57:14.43,teks umum,,0,0,0,,Mu Dok ibarat telur
Dialog: 0,0:57:14.51,0:57:16.14,teks umum,,0,0,0,,Dia mesti dilindungi
Dialog: 0,0:57:17.14,0:57:19.72,contact,,0,0,0,,- Jom tengok\N- Apa yang ada?
Dialog: 0,0:57:19.81,0:57:21.93,contact,,0,0,0,,Mereka menemui mayat seorang perantau
Dialog: 0,0:57:22.02,0:57:23.81,italic,,0,0,0,,- Mayat perantau?\N- Di mana?
Dialog: 0,0:57:26.77,0:57:29.57,contact,,0,0,0,,- Mari saya lihat\N- Apa yang berlaku?
Dialog: 0,0:57:29.65,0:57:31.44,italic,,0,0,0,,- Holy Heaven\N- Seram
Dialog: 0,0:57:31.53,0:57:34.36,miring,,0,0,0,,Mimpi ngeri
Dialog: 0,0:57:38.28,0:57:40.29,teks umum,,0,0,0,,Ini bukan nomad
Dialog: 0,0:57:40.37,0:57:42.29,teks umum,,0,0,0,,Tetapi dia mati kerana dia
Dialog: 0,0:57:43.00,0:57:44.50,teks umum,,0,0,0,,Adakah anda tahu tentang nomad?
Dialog: 0,0:57:44.58,0:57:47.13,teks umum,,0,0,0,,Apabila nomad hilang akal, mereka menyerap tenaga orang
Dialog: 0,0:57:47.71,0:57:49.67,teks umum,,0,0,0,,Itulah sebabnya alkimia jiwa dilarang,
Dialog: 0,0:57:49.75,0:57:52.13,teks umum,,0,0,0,,dan nomad mula ditangkap dan dibunuh
Dialog: 0,0:58:03.68,0:58:05.60,teks umum,,0,0,0,,Adakah semua perantau hilang akal?
Dialog: 0,0:58:05.69,0:58:07.94,teks umum,,0,0,0,,Hanya mereka yang tidak bercakap Hwansu
Dialog: 0,0:58:08.65,0:58:11.82,teks umum,,0,0,0,,Bolehkah seseorang mencapai tahap sedemikian?
Dialog: 0,0:58:11.90,0:58:13.11,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:58:13.99,0:58:17.28,teks umum,,0,0,0,,Adakah anda mahu menjadi pelajar saya dan mencapai tahap ini?
Dialog: 0,0:58:17.86,0:58:20.49,teks umum,,0,0,0,,Anda bukan sahaja pintar dan bertubuh kukuh,
Dialog: 0,0:58:20.58,0:58:22.45,teks umum,,0,0,0,,anda mempunyai semua yang anda perlukan untuk ini
Dialog: 0,0:58:23.37,0:58:26.79,teks umum,,0,0,0,,Terima kasih atas pujian, tetapi saya tidak mahu bersumpah untuk membujang
Dialog: 0,0:58:26.87,0:58:28.08,teks umum,,0,0,0,,Jika anda menjadi pelajar saya,
Dialog: 0,0:58:28.17,0:58:30.67,teks umum,,0,0,0,,Saya akan tolong awak tanggalkan gelang ini
Dialog: 0,0:58:31.25,0:58:32.34,teks umum,,0,0,0,,"Guru"
Dialog: 0,0:58:33.92,0:58:34.76,teks umum,,0,0,0,,Ulang
Dialog: 0,0:58:35.67,0:58:37.59,teks umum,,0,0,0,,Tolong berhenti memujuk saya
Dialog: 0,0:58:38.18,0:58:40.68,miring,,0,0,0,,Kami dari Jeonbugwan, beri laluan
Dialog: 0,0:58:42.81,0:58:45.68,teks umum,,0,0,0,,Saya perlu pergi. Saya tidak dapat melihat mereka
Dialog: 0,0:59:00.53,0:59:02.28,miring,,0,0,0,,Tengok sana
Dialog: 0,0:59:02.37,0:59:03.91,italic,,0,0,0,,- Adakah ini pelangi?\N- Di mana?
Dialog: 0,0:59:03.99,0:59:06.62,miring,,0,0,0,,Ia adalah pelangi
Dialog: 0,0:59:06.71,0:59:09.04,contact,,0,0,0,,- Sungguh pelangi\N- Kecantikan
Dialog: 0,0:59:09.12,0:59:12.21,miring,,0,0,0,,- Tengok\N- Berapa lama dia pergi
Dialog: 0,0:59:13.38,0:59:14.76,miring,,0,0,0,,- Kecantikan\N- Tengok
Dialog: 0,0:59:14.84,0:59:17.13,huruf miring,,0,0,0,,- Ia benar-benar pelangi{\i0}\N- Ke mana perginya kereta itu?
Dialog: 0,0:59:18.13,0:59:19.72,miring,,0,0,0,,Dia berada di sini seminit yang lalu
Dialog: 0,0:59:20.26,0:59:23.06,contact,,0,0,0,,- Ke mana dia pergi?\N- Di mana trolinya?
Dialog: 0,0:59:52.58,0:59:55.17,teks umum,,0,0,0,,Sungguh menakjubkan mendengar gema anda dalam Danhyangok
Dialog: 0,0:59:57.05,0:59:58.17,teks umum,,0,0,0,,Cemerlang
Dialog: 0,1:00:01.13,1:00:04.22,teks umum,,0,0,0,,Apa? Adakah Moo Deok mabuk?
Dialog: 0,1:00:04.30,1:00:06.35,teks umum,,0,0,0,,Anda kata dia minum di sini?
Dialog: 0,1:00:06.43,1:00:08.60,teks umum,,0,0,0,,Mereka hampir membawanya ke Jeonbugwan hari ini
Dialog: 0,1:00:09.56,1:00:12.56,teks umum,,0,0,0,,Tetapi, mujurlah Putera Mahkota menyelamatkannya
Dialog: 0,1:00:14.90,1:00:16.36,teks umum,,0,0,0,,- Putera Mahkota?{\i1}\N- Ya
Dialog: 0,1:00:16.44,1:00:18.15,teks umum,,0,0,0,,Dia pandai membuat dia ketawa
Dialog: 0,1:00:18.24,1:00:19.82,miring,,0,0,0,,Dia menemui pendekatan kepadanya
Dialog: 0,1:00:19.90,1:00:22.82,teks umum,,0,0,0,,Dia minum semua gelas yang ditawarkannya
Dialog: 0,1:00:28.04,1:00:28.95,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,1:00:57.77,1:00:59.69,teks umum,,0,0,0,,Drunk as hell
Dialog: 0,1:01:00.82,1:01:02.86,teks umum,,0,0,0,,Moo Dok, awak okay?
Dialog: 0,1:01:06.45,1:01:09.37,teks umum,,0,0,0,,Pelajar saya, awak datang untuk saya
Dialog: 0,1:01:11.25,1:01:13.75,teks umum,,0,0,0,,Ya, saya datang untuk awak, cikgu
Dialog: 0,1:01:15.04,1:01:17.79,teks umum,,0,0,0,,Saya tidak mengawal badan saya
Dialog: 0,1:01:18.38,1:01:20.46,teks umum,,0,0,0,,Saya tidak boleh memegang kepala saya lurus
Dialog: 0,1:01:21.01,1:01:24.13,teks umum,,0,0,0,,Ini tidak pernah berlaku sebelum ini, tidak kira berapa banyak saya minum
Dialog: 0,1:01:25.84,1:01:27.80,teks umum,,0,0,0,,Anda bukan lagi seorang pahlawan yang mahir,
Dialog: 0,1:01:28.93,1:01:30.10,teks umum,,0,0,0,,tetapi hanya Moo Dok
Dialog: 0,1:01:37.36,1:01:39.94,teks umum,,0,0,0,,Saya tidak boleh minum pun
Dialog: 0,1:02:01.25,1:02:03.88,teks umum,,0,0,0,,Saya mahu meninggalkan segala-galanya dan menjalani kehidupan yang tenang
Dialog: 0,1:02:06.72,1:02:08.30,teks umum,,0,0,0,,Tetapi ada sesuatu yang mengganggu saya
Dialog: 0,1:02:34.79,1:02:37.37,teks umum,,0,0,0,,Fikir saya jatuh dari ketinggian yang tinggi
Dialog: 0,1:02:39.08,1:02:40.96,teks umum,,0,0,0,,Tetapi saya rasa ia tidak begitu tinggi
Dialog: 0,1:02:50.51,1:02:51.93,kenangan,,0,0,0,,Nampaknya saya patah kaki
Dialog: 0,1:02:52.51,1:02:53.72,kenangan,,0,0,0,,Tolong saya
Dialog: 0,1:02:54.47,1:02:58.31,kenangan,,0,0,0,,Saya melihat anda menggunakan ini untuk memanggil burung anda
Dialog: 0,1:03:00.73,1:03:02.02,kenangan miring,,0,0,0,,saya nak cuba juga
Dialog: 0,1:03:02.11,1:03:04.53,kenangan,,0,0,0,,Bolehkah saya memilikinya?
Dialog: 0,1:03:19.96,1:03:21.79,teks umum,,0,0,0,,Saya datang untuk mengembalikannya kepada anda
Dialog: 0,1:03:53.91,1:03:55.49,miring,,0,0,0,,Moo Dok
Dialog: 0,1:03:55.78,1:03:56.95,teks umum,,0,0,0,,Saya nampak Moo Dok
Dialog: 0,1:04:02.24,1:04:03.74,miring,,0,0,0,,Dia benar-benar di sini
Dialog: 0,1:04:04.83,1:04:05.66,italic,,0,0,0,,Di mana Uk?
Dialog: 0,1:04:06.45,1:04:07.91,italic,,0,0,0,,Saya dah cakap jangan lari
Dialog: 0,1:04:09.92,1:04:11.25,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,1:04:11.33,1:04:12.54,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,1:04:12.63,1:04:14.55,teks umum,,0,0,0,,Kami tidak menjumpai kamu di kampung Sari,
Dialog: 0,1:04:14.63,1:04:17.13,teks umum,,0,0,0,,jadi kami datang ke sini untuk mencari anda
Dialog: 0,1:04:17.72,1:04:19.80,contact,,0,0,0,,Ju Wol betul, awak betul-betul di sini
Dialog: 0,1:04:19.88,1:04:22.30,teks umum,,0,0,0,,Apa khabar, Moo Deok?
Dialog: 0,1:04:23.26,1:04:24.43,teks umum,,0,0,0,,Okay
Dialog: 0,1:04:50.00,1:04:52.96,teks umum,,0,0,0,,Moo Dok, anda mungkin gembira melihat kami
Dialog: 0,1:04:56.34,1:04:57.30,teks umum,,0,0,0,,Dia mabuk
Dialog: 0,1:04:58.42,1:05:00.05,teks umum,,0,0,0,,Adakah dia minum?
Dialog: 0,1:05:00.13,1:05:01.68,teks umum,,0,0,0,,- Ya{\i1}\N- Saw
Dialog: 0,1:05:02.26,1:05:03.60,teks umum,,0,0,0,,Bantu dia bangun
Dialog: 0,1:05:04.18,1:05:05.18,teks umum,,0,0,0,,Angkat dia
Dialog: 0,1:05:14.98,1:05:17.40,teks am,,0,0,0,,Mu Dok pernah datang ke Danhyangk untuk mengumpul herba ubatan
Dialog: 0,1:05:17.48,1:05:20.70,teks umum,,0,0,0,,Cikgu Li tinggal di sini, dia benarkan kami berhenti di sini
Dialog: 0,1:05:20.78,1:05:23.16,teks umum,,0,0,0,,Saya tidak percaya Moo Deok mabuk seorang diri
Dialog: 0,1:05:23.24,1:05:24.57,contact,,0,0,0,,Dia hidup dengan baik
Dialog: 0,1:05:25.24,1:05:27.33,teks umum,,0,0,0,,Saya tidak tahu ada tempat seperti itu di Danhyangok
Dialog: 0,1:05:27.95,1:05:29.33,teks umum,,0,0,0,,Tahukah anda tentang Danhyangok?
Dialog: 0,1:05:29.41,1:05:31.58,teks umum,,0,0,0,,Dia sering datang ke sini
Dialog: 0,1:05:31.66,1:05:34.54,teks umum,,0,0,0,,Dia mendapatnya kerana sentiasa melarikan diri
Dialog: 0,1:05:34.63,1:05:35.71,italic,,0,0,0,,Yul?
Dialog: 0,1:05:36.21,1:05:38.34,miring,,0,0,0,,Dia gilakan burung
Dialog: 0,1:05:38.42,1:05:40.88,teks umum,,0,0,0,,Kenapa awak datang ke sini seorang diri?
Dialog: 0,1:05:40.97,1:05:42.47,teks umum,,0,0,0,,Kamu pun sakit kaki di sini
Dialog: 0,1:05:45.09,1:05:46.72,teks umum,,0,0,0,,Sebab saya mahu berjumpa dengan mereka
Dialog: 0,1:05:51.43,1:05:53.35,teks umum,,0,0,0,,Saya tidak kisah tentang patah kaki
Dialog: 0,1:05:54.40,1:05:56.23,teks umum,,0,0,0,,Dan saya tidak takut mereka akan memarahi saya
Dialog: 0,1:05:59.65,1:06:01.49,teks umum,,0,0,0,,Saya sangat menyayangi mereka
Dialog: 0,1:06:16.67,1:06:19.13,miring,,0,0,0,,Dia sangat suka burung
Dialog: 0,1:06:19.96,1:06:22.76,teks umum,,0,0,0,,By the way, teh jenis apakah ini?
Dialog: 0,1:06:22.84,1:06:25.51,teks am,,0,0,0,,- Baunya sangat harum\N- Adakah anda meminumnya?
Dialog: 0,1:06:27.93,1:06:30.06,teks umum,,0,0,0,,Ya, tetapi apa? Adakah dia berguna?
Dialog: 0,1:06:31.06,1:06:31.93,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,1:06:32.02,1:06:34.02,teks am,,0,0,0,,Ia diperbuat daripada herba perubatan,
Dialog: 0,1:06:34.10,1:06:36.52,teks umum,,0,0,0,,yang tumbuh hanya di Danhyangok
Dialog: 0,1:06:36.60,1:06:37.69,teks umum,,0,0,0,,Betul ke?
Dialog: 0,1:06:37.77,1:06:39.86,teks umum,,0,0,0,,- Yul, cuba juga...\N- Jangan minum...
Dialog: 0,1:06:40.36,1:06:41.40,teks umum,,0,0,0,,Baiklah, bantu diri sendiri
Dialog: 0,1:06:41.48,1:06:43.74,teks umum,,0,0,0,,- Baunya sungguh harum\N- Beritahu saya?
Dialog: 0,1:06:46.20,1:06:47.78,teks umum,,0,0,0,,Ini teh kesucian
Dialog: 0,1:06:49.20,1:06:50.24,contact,,0,0,0,,Apa? Kesucian?
Dialog: 0,1:06:50.33,1:06:52.91,teks umum,,0,0,0,,Anda tidak akan dapat...
Dialog: 0,1:06:54.62,1:06:57.54,teks umum,,0,0,0,,- Adakah ini teh buttercup?\N- Saya tidak tahu dengan tepat
Dialog: 0,1:06:58.21,1:06:59.25,miring,,0,0,0,,Nah...
Dialog: 0,1:06:59.34,1:07:02.26,teks am,,0,0,0,,Terdapat banyak jenis herba, anda boleh minum
Dialog: 0,1:07:04.05,1:07:05.05,teks umum,,0,0,0,,Sedap
Dialog: 0,1:07:08.76,1:07:10.26,teks umum,,0,0,0,,Untuk kesihatan anda
Dialog: 0,1:07:41.46,1:07:43.67,teks umum,,0,0,0,,Sekumpulan lelaki yang mencurigakan dan azimat saya?
Dialog: 0,1:07:44.26,1:07:45.13,teks umum,,0,0,0,,Ya
Dialog: 0,1:07:45.21,1:07:47.13,contact,,0,0,0,,Adakah anda benar-benar kehilangan azimat anda?
Dialog: 0,1:07:47.22,1:07:49.55,teks umum,,0,0,0,,Adakah seseorang mencurinya daripada anda atau adakah anda meminjamkannya kepada seseorang?
Dialog: 0,1:07:49.64,1:07:51.85,teks umum,,0,0,0,,Tidak, saya kehilangannya
Dialog: 0,1:07:51.93,1:07:54.47,teks umum,,0,0,0,,Adakah anda ingat di mana dan bila perkara ini berlaku?
Dialog: 0,1:07:56.31,1:07:57.14,teks umum,,0,0,0,,Tidak
Dialog: 0,1:07:57.23,1:07:59.73,teks umum,,0,0,0,,Kami menemuinya semasa kami menyiasat kes orang perantau
Dialog: 0,1:07:59.81,1:08:01.65,teks umum,,0,0,0,,Ini sangat penting dan berbahaya
Dialog: 0,1:08:09.66,1:08:13.03,italic,,0,0,0,,Perkahwinan Jin Jo Young dan Chan Wook?
Dialog: 0,1:08:13.62,1:08:16.16,teks umum,,0,0,0,,Idea yang bagus
Dialog: 0,1:08:16.25,1:08:20.46,teks umum,,0,0,0,,Tetapi mereka yang berkahwin mesti saling mengasihi
Dialog: 0,1:08:20.54,1:08:24.25,teks umum,,0,0,0,,Dia tidak boleh berkahwin dengan orang yang tidak dia cintai hanya untuk menyelesaikan masalah
Dialog: 0,1:08:24.34,1:08:28.22,teks umum,,0,0,0,,Siapa yang akan bercakap tentang cinta! Sepanjang hidup saya, saya seperti pokok sunyi di padang. Kedua-duanya!
Dialog: 0,1:08:29.09,1:08:31.80,teks umum,,0,0,0,,Perkahwinan bukan gurauan
Dialog: 0,1:08:31.89,1:08:33.43,teks umum,,0,0,0,,Saya juga merasakan cinta
Dialog: 0,1:08:33.51,1:08:34.60,teks umum,,0,0,0,,Pada suatu masa dahulu
Dialog: 0,1:08:34.68,1:08:38.35,teks umum,,0,0,0,,Saya berpaling dari tuan kerana cinta
Dialog: 0,1:08:38.43,1:08:40.98,teks umum,,0,0,0,,Dan semuanya sia-sia
Dialog: 0,1:08:41.06,1:08:42.19,teks umum,,0,0,0,,Jom cepat
Dialog: 0,1:08:42.98,1:08:43.94,teks umum,,0,0,0,,memperkahwinkan mereka
Dialog: 0,1:08:49.36,1:08:51.11,teks umum,,0,0,0,,Orang yang tidak dikenali memusnahkan penghalang kami dan memasuki
Dialog: 0,1:08:55.83,1:08:59.29,teks umum,,0,0,0,,Ho Yeom, keluar dan bertanya khabar
Dialog: 0,1:08:59.37,1:09:03.17,teks umum,,0,0,0,,Siapa berani panggil saya dengan nama?
Dialog: 0,1:09:07.96,1:09:09.01,teks umum,,0,0,0,,Yom
Dialog: 0,1:09:10.26,1:09:11.59,teks umum,,0,0,0,,Apa khabar?
Dialog: 0,1:09:12.64,1:09:13.55,teks umum,,0,0,0,,Guru...
Dialog: 0,1:09:14.39,1:09:15.43,teks umum,,0,0,0,,Guru
Dialog: 0,1:09:16.14,1:09:17.18,teks am,,0,0,0,,Cikgu!
Dialog: 0,1:09:18.72,1:09:19.73,teks umum,,0,0,0,,Guru...
Dialog: 0,1:09:19.81,1:09:21.77,teks umum,,0,0,0,,Guru saya
Dialog: 0,1:09:24.94,1:09:26.82,teks umum,,0,0,0,,Turunkan pedangmu! Sekarang!
Dialog: 0,1:09:49.55,1:09:50.72,miring,,0,0,0,,Moo Dok
Dialog: 0,1:09:51.51,1:09:54.30,teks umum,,0,0,0,,Fikirkan anda sedang tidur. Dicari di merata tempat
Dialog: 0,1:09:54.39,1:09:56.22,teks umum,,0,0,0,,Adakah anda masih mabuk?
Dialog: 0,1:09:56.93,1:09:59.52,teks umum,,0,0,0,,Mabuk fikir saya boleh memanjatnya
Dialog: 0,1:10:00.64,1:10:04.15,teks umum,,0,0,0,,Tetapi ia tinggi di sini. Saya rasa saya sudah sedar
Dialog: 0,1:10:04.81,1:10:07.77,teks umum,,0,0,0,,Adakah itu pokok dengan sarang di atas?
Dialog: 0,1:10:07.86,1:10:08.90,teks umum,,0,0,0,,Ya
Dialog: 0,1:10:10.36,1:10:12.40,teks umum,,0,0,0,,saya nak panjat pokok ni lagi
Dialog: 0,1:10:13.78,1:10:17.20,teks umum,,0,0,0,,Adakah anda benar-benar mendaki ke puncak?
Dialog: 0,1:10:18.41,1:10:20.16,teks umum,,0,0,0,,Saya Nak Soo masa tu
Dialog: 0,1:10:21.79,1:10:24.75,teks umum,,0,0,0,,Bulan dari sana sungguh luar biasa
Dialog: 0,1:10:26.00,1:10:28.29,teks umum,,0,0,0,,Tetapi saya tidak akan berjumpa dengannya lagi
Dialog: 0,1:10:30.42,1:10:32.51,teks umum,,0,0,0,,Saya terserempak dengan lelaki Dan Zhu hari ini
Dialog: 0,1:10:33.17,1:10:34.68,teks umum,,0,0,0,,Nampaknya dia mengesyaki saya
Dialog: 0,1:10:35.59,1:10:38.30,teks umum,,0,0,0,,Adakah anda memberi mereka azimat semangat saya?
Dialog: 0,1:10:38.39,1:10:40.60,teks umum,,0,0,0,,Saya cuba menggunakannya untuk kembali
Dialog: 0,1:10:41.39,1:10:44.06,teks umum,,0,0,0,,Tetapi dia membunuh orang yang dia sangka saya
Dialog: 0,1:10:47.06,1:10:49.11,teks umum,,0,0,0,,Jika mereka menangkap saya,
Dialog: 0,1:10:50.02,1:10:51.36,teks umum,,0,0,0,,jangan cuba selamatkan saya
Dialog: 0,1:10:53.40,1:10:55.49,teks umum,,0,0,0,,Sudah tentu. Saya terlalu lemah pula
Dialog: 0,1:10:57.82,1:11:00.58,teks umum,,0,0,0,,Pelajar anda tidak boleh berbuat apa-apa untuk anda
Dialog: 0,1:11:04.12,1:11:05.50,teks umum,,0,0,0,,Saya tidak mengharapkan apa-apa
Dialog: 0,1:11:09.21,1:11:10.29,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:11:10.96,1:11:13.88,teks umum,,0,0,0,,Saya tidak boleh berbuat banyak, tetapi saya boleh memanjat pokok
Dialog: 0,1:11:14.76,1:11:17.55,teks umum,,0,0,0,,Tiada dahan di bahagian atas untuk berdiri
Dialog: 0,1:11:18.55,1:11:20.60,teks umum,,0,0,0,,Kita mesti menggunakan tenaga untuk mencipta pijakan
Dialog: 0,1:11:21.22,1:11:23.68,teks umum,,0,0,0,,Untuk ini anda perlu menguasai Chisa
Dialog: 0,1:11:24.31,1:11:26.02,teks umum,,0,0,0,,Anda mengambil berat tentang perkara ini seperti bulan
Dialog: 0,1:11:26.10,1:11:27.90,teks umum,,0,0,0,,Saya tidak mahu berbuat apa-apa,
Dialog: 0,1:11:28.69,1:11:30.52,teks umum,,0,0,0,,tapi saya nak panjat pokok ni
Dialog: 0,1:11:36.95,1:11:38.74,teks umum,,0,0,0,,Awak kata nak tengok bulan dari sana
Dialog: 0,1:11:38.82,1:11:40.99,teks umum,,0,0,0,,Saya seorang sahaja yang boleh membantu dengan ini,
Dialog: 0,1:11:41.58,1:11:42.99,teks umum,,0,0,0,,jadi saya akan cuba
Dialog: 0,1:11:44.04,1:11:45.62,teks umum,,0,0,0,,Adakah anda mahu naik?
Dialog: 0,1:11:47.71,1:11:50.67,teks umum,,0,0,0,,Kita perlu kuasai Chisa, saya dah cakap begitu
Dialog: 0,1:11:52.38,1:11:53.92,teks umum,,0,0,0,,Adakah anda mahu atau tidak?
Dialog: 0,1:11:59.22,1:12:00.97,teks umum,,0,0,0,,Kemudian tolong saya
Dialog: 0,1:12:02.22,1:12:03.72,teks umum,,0,0,0,,naik sana
Dialog: 0,1:12:05.73,1:12:06.98,teks umum,,0,0,0,,Okay
Dialog: 0,1:12:07.06,1:12:10.31,teks umum,,0,0,0,,Saya akan membawa anda ke puncak pokok ini
Dialog: 0,1:12:53.69,1:12:56.78,pratonton,,0,0,0,,Apa khabar dengan Uka?
Dialog: 0,1:12:56.86,1:12:59.53,pratonton,,0,0,0,,Awak tahu siapa ayah saya yang sebenarnya?
Dialog: 0,1:12:59.61,1:13:02.24,pratonton,,0,0,0,,Tiada siapa mengharapkan anda untuk melawannya
Dialog: 0,1:13:02.32,1:13:05.45,pratonton,,0,0,0,,Langkah seterusnya mungkin membawanya lebih dekat kepada kematian
Dialog: 0,1:13:05.53,1:13:07.66,pratonton,,0,0,0,,Adakah tuan kamu tahu tentang perkara ini?
Dialog: 0,1:13:07.75,1:13:10.83,pratonton,,0,0,0,,Awak jumpa Nak Soo masa kecil?
Dialog: 0,1:13:10.92,1:13:12.29,pratonton,,0,0,0,,Saya tidak tahu nama atau umurnya
Dialog: 0,1:13:12.38,1:13:14.25,pratonton,,0,0,0,,Hanya tempat dari mana kami melihat burung
Dialog: 0,1:13:14.34,1:13:15.88,pratonton,,0,0,0,,Saya tidak tahu di mana dia tinggal
Dialog: 0,1:13:15.96,1:13:18.13,pratonton,,0,0,0,,Keluarga Jin tinggal di sini
Dialog: 0,1:13:18.21,1:13:20.97,pratonton,,0,0,0,,Anak perempuan Cikgu Jin berkahwin
Dialog: 0,1:13:21.05,1:13:23.84,pratonton,,0,0,0,,Apa yang perlu dilakukan, cikgu? Kahwin?
Dialog: 0,1:13:23.93,1:13:26.64,pratonton,,0,0,0,,Bukan rancangan saya untuk menjadi pembantu rumah awak selama-lamanya

Ulasan: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Editor Beta: {\c&HFFF4C5&} Sana
