Dialog: 0,0:02:47.14,0:02:49.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.14,0:02:51.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Sana, Martini
Dialog: 0,0:02:51.14,0:02:53.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:00:48.70,0:00:50.70,teks umum,,0,0,0,,Tunggu, puan
Dialog: 0,0:00:50.79,0:00:52.54,teks umum,,0,0,0,,Jangan tutup mata anda
Dialog: 0,0:00:52.62,0:00:53.83,teks umum,,0,0,0,,Jangan tertidur
Dialog: 0,0:01:04.30,0:01:06.26,kapsyen,,0,0,0,,Saya mesti menjadikan Do Hwa milik saya. Jika dia hamil, maka anak itu adalah milik saya
Dialog: 0,0:01:06.35,0:01:08.35,kenangan miring,,0,0,0,,Terima kasih kepada anda
Dialog: 0,0:01:09.10,0:01:12.27,kenangan,,0,0,0,,minggu lepas sungguh luar biasa
Dialog: 0,0:01:17.23,0:01:18.69,kenangan,,0,0,0,,Do Hwa tidak lama lagi
Dialog: 0,0:01:20.03,0:01:21.99,kenangan,,0,0,0,,akan melahirkan anak lelaki saya
Dialog: 0,0:01:24.41,0:01:25.53,kenangan,,0,0,0,,Yang Mulia
Dialog: 0,0:01:26.24,0:01:30.04,kenangan,,0,0,0,,Ingat ramalan yang saya terima pada hari pertabalan saya?
Dialog: 0,0:01:30.62,0:01:34.12,kenangan,,0,0,0,,Awak kata saya akan ada anak lelaki
Dialog: 0,0:01:34.92,0:01:37.96,kenangan,,0,0,0,,yang akan mempunyai tenaga bintang diraja
Dialog: 0,0:01:38.54,0:01:42.21,kenangan,,0,0,0,,Ramalan itu salah. tak mungkin
Dialog: 0,0:01:44.68,0:01:45.88,kenangan,,0,0,0,,Tidak
Dialog: 0,0:01:47.43,0:01:50.06,kenangan,,0,0,0,,Ini mesti menjadi kenyataan
Dialog: 0,0:01:51.06,0:01:54.18,kenangan,,0,0,0,,Saya akan mendapat seorang anak lelaki terima kasih kepada alkimia jiwa anda
Dialog: 0,0:01:55.98,0:01:57.69,kenangan,,0,0,0,,Ingat ini
Dialog: 0,0:01:58.90,0:02:00.77,kenangan,,0,0,0,,Do Hwa mengandung dan melahirkan
Dialog: 0,0:02:02.69,0:02:04.15,kenangan,,0,0,0,,anakku
Dialog: 0,0:02:07.20,0:02:08.53,kenangan,,0,0,0,,Dia akan menjadi milikku
Dialog: 0,0:03:07.01,0:03:10.64,kenangan miring,,0,0,0,,Bintang di tengah Big Dipper, yang bermaksud rahsia alam,
Dialog: 0,0:03:10.72,0:03:15.35,kenangan miring,,0,0,0,,muncul hanya apabila langit dipenuhi dengan tenaga perairan Deho
Dialog: 0,0:03:23.36,0:03:26.19,kenangan miring,,0,0,0,,Anak saya akan lahir apabila bintang ini bersinar
Dialog: 0,0:03:36.58,0:03:39.96,kenangan,,0,0,0,,Mulai sekarang, saya melarang Chan Wook daripada memasuki Sosnovy Bor
Dialog: 0,0:03:41.29,0:03:42.63,kenangan,,0,0,0,,Tinggal satu pukulan
Dialog: 0,0:03:42.71,0:03:44.09,kenangan,,0,0,0,,Dan gunakan yang terakhir ini sendiri
Dialog: 0,0:03:59.98,0:04:01.06,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:04:02.31,0:04:05.69,teks umum,,0,0,0,,Adakah tuan muda masih diam?
Dialog: 0,0:04:06.73,0:04:10.70,teks umum,,0,0,0,,Ya. Mereka memukul belakang saya, dan rasanya lidah saya terluka
Dialog: 0,0:04:10.78,0:04:13.20,teks umum,,0,0,0,,Dia menangis walaupun terkena jarinya
Dialog: 0,0:04:13.28,0:04:15.95,teks umum,,0,0,0,,Dan selepas seratus pukulan dia diam, seperti ikan
Dialog: 0,0:04:16.03,0:04:17.12,teks umum,,0,0,0,,Saya bimbang
Dialog: 0,0:04:17.20,0:04:20.29,teks umum,,0,0,0,,Dia seorang yang menangis, jadi saya rasa dia masih boleh menanggungnya
Dialog: 0,0:04:21.71,0:04:25.75,teks umum,,0,0,0,,Bukan belakangnya yang sakit, tetapi hatinya
Dialog: 0,0:04:26.88,0:04:30.80,teks umum,,0,0,0,,Dia ditinggalkan oleh lelaki yang dia anggap bapanya
Dialog: 0,0:04:30.88,0:04:32.43,teks umum,,0,0,0,,Bayangkan bagaimana keadaannya
Dialog: 0,0:04:33.76,0:04:35.55,teks umum,,0,0,0,,Betapa dia rasa ditinggalkan
Dialog: 0,0:04:59.58,0:05:01.46,teks umum,,0,0,0,,Bergembiralah anda dipukul
Dialog: 0,0:05:02.16,0:05:05.33,teks umum,,0,0,0,,Mereka tidak akan dapat mengambil tenaga sekarang
Dialog: 0,0:05:05.42,0:05:07.34,teks umum,,0,0,0,,Anda mempunyai lebih banyak masa untuk berlatih
Dialog: 0,0:05:18.35,0:05:19.47,teks umum,,0,0,0,,Hos
Dialog: 0,0:05:20.31,0:05:21.31,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:05:41.62,0:05:43.75,teks umum,,0,0,0,,Mu Dok, lihat
Dialog: 0,0:05:43.83,0:05:46.12,teks umum,,0,0,0,,Saya rasa bulatan di atas air ini adalah merit saya
Dialog: 0,0:05:50.96,0:05:52.38,teks umum,,0,0,0,,Ia hanya riak
Dialog: 0,0:05:54.09,0:05:56.89,teks umum,,0,0,0,,Mengapa ia tidak berkesan? Saya melatih pernafasan saya
Dialog: 0,0:05:56.97,0:05:59.30,teks umum,,0,0,0,,Jadi inilah yang anda lakukan dalam diam
Dialog: 0,0:05:59.39,0:06:02.60,teks umum,,0,0,0,,Dan saya fikir awak tenggelam dalam lautan kesedihan kerana awak menghalau saya
Dialog: 0,0:06:02.68,0:06:05.27,teks umum,,0,0,0,,- Saya silap\N- Adakah saya tenggelam dalam lautan kesedihan?
Dialog: 0,0:06:05.35,0:06:07.35,teks umum,,0,0,0,,Saya telah ditinggalkan sejak lahir
Dialog: 0,0:06:07.44,0:06:09.69,teks umum,,0,0,0,,Dan ini bukan kali pertama saya dihalau dari suatu tempat
Dialog: 0,0:06:09.77,0:06:11.23,teks umum,,0,0,0,,Ia tidak mengganggu saya
Dialog: 0,0:06:17.03,0:06:18.53,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:06:18.62,0:06:22.04,teks umum,,0,0,0,,Saya akan meminta mereka untuk kembali ke Sosnovy Bor
Dialog: 0,0:06:23.45,0:06:25.12,teks umum,,0,0,0,,Kebodohan kadangkala berguna, nampaknya
Dialog: 0,0:06:25.71,0:06:26.71,teks umum,,0,0,0,,Ini adalah manifestasi kuasa!
Dialog: 0,0:06:30.34,0:06:33.09,teks umum,,0,0,0,,Kenapa panas sangat di sini?
Dialog: 0,0:06:33.71,0:06:35.59,teks umum,,0,0,0,,Adakah panas? saya sejuk
Dialog: 0,0:06:38.34,0:06:40.14,teks am,,0,0,0,,Mengapa air menjadi begitu panas?
Dialog: 0,0:06:42.47,0:06:43.97,teks umum,,0,0,0,,Kenapa awak terbakar?
Dialog: 0,0:06:44.93,0:06:48.69,teks umum,,0,0,0,,Saya rasa pelik. Suhu semakin meningkat
Dialog: 0,0:06:48.77,0:06:50.11,teks umum,,0,0,0,,Ini adalah tenaga
Dialog: 0,0:06:51.23,0:06:52.44,teks umum,,0,0,0,,Tetapi tidak lama lagi?
Dialog: 0,0:06:55.32,0:06:56.90,teks umum,,0,0,0,,Ini soal pukul
Dialog: 0,0:06:56.99,0:06:59.16,teks umum,,0,0,0,,Disebabkan dia, terdapat lonjakan tenaga
Dialog: 0,0:06:59.91,0:07:01.58,teks umum,,0,0,0,,Senang anda dipukul
Dialog: 0,0:07:04.49,0:07:06.25,teks umum,,0,0,0,,Moo Dok, saya terbakar
Dialog: 0,0:07:06.33,0:07:09.67,teks umum,,0,0,0,,Anda akan menjadi panas manakala tenaga bertukar menjadi haba
Dialog: 0,0:07:09.75,0:07:11.88,teks umum,,0,0,0,,Dan ia akan menjadi sejuk apabila ia sejuk
Dialog: 0,0:07:11.96,0:07:14.59,teks umum,,0,0,0,,Tenaga hanya akan menjadi milik anda jika anda mengendalikannya
Dialog: 0,0:07:15.76,0:07:18.55,teks umum,,0,0,0,,Bernafas perlahan-lahan
Dialog: 0,0:07:26.39,0:07:27.81,teks umum,,0,0,0,,Ini air sejuk
Dialog: 0,0:07:41.49,0:07:42.62,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:07:43.37,0:07:45.04,teks umum,,0,0,0,, tuan muda masih mandi?
Dialog: 0,0:07:45.12,0:07:47.08,teks umum,,0,0,0,,Sejam sudah hampir berlalu
Dialog: 0,0:07:47.75,0:07:51.88,di sebalik tabir,,0,0,0,,Jika dia tahu, dia akan memberitahu segala-galanya dalam Sosnovy Bor, dan kita akan kehilangan tenaga
Dialog: 0,0:07:51.96,0:07:52.83,teks am,,0,0,0,,Herba perubatan
Dialog: 0,0:07:54.38,0:07:56.63,teks umum,,0,0,0,,Dia mandi dengan herba
Dialog: 0,0:07:57.21,0:07:58.92,teks am,,0,0,0,,Saya telah menyediakan herba,
Dialog: 0,0:07:59.01,0:08:01.84,teks umum,,0,0,0,,dan dia mandi di dalamnya supaya luka sembuh
Dialog: 0,0:08:03.10,0:08:03.93,teks umum,,0,0,0,,Begitukah?
Dialog: 0,0:08:05.31,0:08:06.56,teks umum,,0,0,0,,Idea yang bagus
Dialog: 0,0:08:09.64,0:08:10.73,teks umum,,0,0,0,,Stand
Dialog: 0,0:08:17.90,0:08:19.74,teks umum,,0,0,0,,Kenapa airnya sejuk?
Dialog: 0,0:08:19.82,0:08:21.03,teks umum,,0,0,0,,Apa?
Dialog: 0,0:08:21.11,0:08:24.07,teks umum,,0,0,0,,Air sepatutnya menjadi sejuk sejak sejam yang lalu
Dialog: 0,0:08:24.16,0:08:26.08,teks umum,,0,0,0,,Kenapa awak masih bawa dia sejuk dan bukannya panas?
Dialog: 0,0:08:28.79,0:08:30.25,teks umum,,0,0,0,,Adakah dia demam?
Dialog: 0,0:08:32.08,0:08:33.25,teks umum,,0,0,0,,Encik...
Dialog: 0,0:08:38.46,0:08:39.46,teks umum,,0,0,0,,Dia dingin
Dialog: 0,0:08:40.17,0:08:41.76,teks umum,,0,0,0,,Bagaimana anda membiarkan perkara ini berlaku?
Dialog: 0,0:08:41.84,0:08:43.30,teks umum,,0,0,0,,Bagaimana jika dia jatuh sakit?
Dialog: 0,0:08:50.14,0:08:53.06,di sebalik tabir,,0,0,0,,Air mendidih tiba-tiba bertukar berais
Dialog: 0,0:08:53.15,0:08:54.23,miring,,0,0,0,,Mr.
Dialog: 0,0:08:55.77,0:08:57.07,teks umum,,0,0,0,,Di mana dia?
Dialog: 0,0:09:02.82,0:09:05.28,teks umum,,0,0,0,,Encik, awak okay?
Dialog: 0,0:09:05.99,0:09:07.20,miring,,0,0,0,,Ya
Dialog: 0,0:09:07.28,0:09:10.54,teks umum,,0,0,0,,Berenang melegakan badan saya dan saya mula mengantuk
Dialog: 0,0:09:13.33,0:09:15.88,contact,,0,0,0,,Apakah nilai anda? Sediakan tempat untuk tidur
Dialog: 0,0:09:17.17,0:09:20.46,teks umum,,0,0,0,,Sejuk. Sekarang dia membeku
Dialog: 0,0:09:26.68,0:09:29.77,teks umum,,0,0,0,,Saya kesejukan. Saya seperti berubah menjadi ais
Dialog: 0,0:09:30.68,0:09:34.39,teks umum,,0,0,0,,Sejuk merebak. Tenaga anda berkembang lebih cepat daripada yang saya fikirkan
Dialog: 0,0:09:35.65,0:09:36.81,teks umum,,0,0,0,,Teruskan bernafas
Dialog: 0,0:10:02.51,0:10:03.97,teks umum,,0,0,0,,Sangat sejuk sehingga fikiran menjadi mendung
Dialog: 0,0:10:06.18,0:10:08.26,teks umum,,0,0,0,,Tunggu. Anda sepatutnya
Dialog: 0,0:10:10.64,0:10:13.18,teks umum,,0,0,0,,Chan Wook! Jangan tertidur!
Dialog: 0,0:10:13.27,0:10:15.06,teks umum,,0,0,0,,Jika anda tertidur, anda akan mati beku
Dialog: 0,0:10:15.14,0:10:16.27,teks umum,,0,0,0,,Bangun
Dialog: 0,0:10:18.81,0:10:20.07,teks umum,,0,0,0,,Bernafas
Dialog: 0,0:10:31.03,0:10:34.54,teks umum,,0,0,0,,Pakcik, Yul dan saya hanya kawan Uka
Dialog: 0,0:10:34.62,0:10:37.12,teks umum,,0,0,0,,Dan Sosnovy Bor adalah satu-satunya tempat dia menelefon rumah
Dialog: 0,0:10:37.21,0:10:40.00,teks umum,,0,0,0,,Biar dia kembali
Dialog: 0,0:10:40.09,0:10:41.80,teks umum,,0,0,0,,Dia masih tidak boleh berlatih
Dialog: 0,0:10:42.30,0:10:43.96,teks umum,,0,0,0,,Mereka tidak akan menerima dia di mana-mana,
Dialog: 0,0:10:44.05,0:10:46.34,teks umum,,0,0,0,,apabila mereka mengetahui bahawa mereka telah mengusir mereka dari sini juga
Dialog: 0,0:10:47.88,0:10:49.76,teks umum,,0,0,0,,Cukup bercakap tentang dia
Dialog: 0,0:10:49.85,0:10:53.10,teks umum,,0,0,0,,Mulai sekarang, fokus pada orang nomad dan penelan jiwa
Dialog: 0,0:11:01.94,0:11:04.23,teks umum,,0,0,0,,Dia seperti batu
Dialog: 0,0:11:05.53,0:11:06.90,teks umum,,0,0,0,,Jadi dia berubah menjadi batu
Dialog: 0,0:11:10.37,0:11:11.78,teks umum,,0,0,0,,Apabila nomad lari liar,
Dialog: 0,0:11:11.87,0:11:15.00,teks umum,,0,0,0,, mereka kehilangan tenaga, jadi mereka menyedutnya daripada orang
Dialog: 0,0:11:17.25,0:11:19.29,teks umum,,0,0,0,,Ia seperti roh jahat
Dialog: 0,0:11:19.37,0:11:22.00,teks umum,,0,0,0,,Jelas mengapa anda melarang sihir ini
Dialog: 0,0:11:22.09,0:11:24.96,teks umum,,0,0,0,,Alkimia jiwa pada asalnya bukan ilmu sihir
Dialog: 0,0:11:25.55,0:11:27.17,teks umum,,0,0,0,,Ia boleh dikuasai
Dialog: 0,0:11:27.26,0:11:30.68,teks umum,,0,0,0,,hanya telah menguasai Chipsu, Ryusa, Chisa dan akhirnya Hwansu
Dialog: 0,0:11:30.76,0:11:32.26,teks umum,,0,0,0,,Hwangsu... Ini...
Dialog: 0,0:11:32.35,0:11:35.77,teks umum,,0,0,0,,bila anda boleh menukar api dengan air dan sebaliknya?
Dialog: 0,0:11:35.85,0:11:38.06,teks umum,,0,0,0,,- Orang tidak boleh melakukan ini\N- Betul
Dialog: 0,0:11:38.14,0:11:40.73,teks umum,,0,0,0,,Tetapi Master So Kyung, pengasas Pine Forest, dapat
Dialog: 0,0:11:40.81,0:11:42.56,teks umum,,0,0,0,,Ada satu lagi
Dialog: 0,0:11:42.65,0:11:43.69,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:11:43.77,0:11:45.69,teks umum,,0,0,0,,Jika tidak, saya akan memberitahu anda nama dan anda akan faham
Dialog: 0,0:11:47.15,0:11:49.82,teks umum,,0,0,0,,Siapa yang berani mencuba alkimia ini
Dialog: 0,0:11:49.91,0:11:52.57,teks umum,,0,0,0,,pada pelajar kami yang malang?
Dialog: 0,0:11:52.66,0:11:56.37,teks umum,,0,0,0,,Dia sepatutnya bekerja di Jeonbugwan, baca bintang
Dialog: 0,0:11:56.45,0:11:58.71,teks umum,,0,0,0,,Beliau sering ke sana sejak beberapa bulan lalu
Dialog: 0,0:11:59.62,0:12:02.21,miring,,0,0,0,,Tepat sekali. Ada juga yang tangkap orang Nak Su
Dialog: 0,0:12:02.29,0:12:04.71,teks umum,,0,0,0,,Kami tidak dapat, tetapi ini nampaknya sedang menunggu mereka
Dialog: 0,0:12:04.79,0:12:07.21,teks umum,,0,0,0,,Saya pasti mereka ada kaitan dengan
Dialog: 0,0:12:07.30,0:12:09.42,teks umum,,0,0,0,,kepada penelan jiwa ini
Dialog: 0,0:12:11.38,0:12:14.18,teks umum,,0,0,0,,Yul, Dan Gu, tonton Jeonbugwan
Dialog: 0,0:12:14.26,0:12:16.10,teks umum,,0,0,0,,Tiba-tiba anda perasan sesuatu yang pelik
Dialog: 0,0:12:16.68,0:12:17.56,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:12:20.06,0:12:21.65,teks umum,,0,0,0,,Bagaimana dengan dia?
Dialog: 0,0:12:21.73,0:12:24.02,teks umum,,0,0,0,,Pintu itu berfungsi sekejap-sekejap sejak Uk memecahkannya
Dialog: 0,0:12:25.07,0:12:27.15,teks umum,,0,0,0,,- Chan Wook...\N- Jangan bergerak!
Dialog: 0,0:12:27.86,0:12:29.07,teks umum,,0,0,0,,Lantai akan runtuh
Dialog: 0,0:12:32.49,0:12:33.82,teks umum,,0,0,0,,Jangan bergerak
Dialog: 0,0:12:34.41,0:12:36.12,teks umum,,0,0,0,,Tunggu sehingga pintu ditutup sepenuhnya
Dialog: 0,0:12:37.20,0:12:38.08,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:12:38.62,0:12:41.50,teks umum,,0,0,0,,Saya dah cakap jangan gerak!
Dialog: 0,0:12:41.58,0:12:43.33,teks umum,,0,0,0,,Tolong saya!
Dialog: 0,0:12:45.46,0:12:46.59,teks umum,,0,0,0,,Diam
Dialog: 0,0:12:47.96,0:12:49.01,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:13:20.33,0:13:22.25,teks umum,,0,0,0,,Berbaring buat masa ini
Dialog: 0,0:13:40.85,0:13:42.06,teks umum,,0,0,0,,Sapsari
Dialog: 0,0:13:43.06,0:13:44.23,teks umum,,0,0,0,,Keluar
Dialog: 0,0:13:44.94,0:13:46.65,teks umum,,0,0,0,,Ikut saya
Dialog: 0,0:14:31.15,0:14:32.94,teks umum,,0,0,0,,Gembira anda kembali
Dialog: 0,0:14:36.61,0:14:40.87,teks umum,,0,0,0,,Saya akan memberi anda hadiah jika anda menjumpai nomad
Dialog: 0,0:14:40.95,0:14:42.45,teks umum,,0,0,0,,Saya harap kita bekerjasama
Dialog: 0,0:15:12.65,0:15:13.78,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:15:15.65,0:15:17.36,teks umum,,0,0,0,,Jika saya mati beku,
Dialog: 0,0:15:18.95,0:15:20.62,teks umum,,0,0,0,,ambil tenaga saya,
Dialog: 0,0:15:22.83,0:15:24.91,teks umum,,0,0,0,,jika anda boleh
Dialog: 0,0:15:26.20,0:15:29.08,teks umum,,0,0,0,,Jika saya boleh, saya sudah lama membunuh awak dan membawa awak pergi
Dialog: 0,0:15:32.00,0:15:33.67,teks umum,,0,0,0,,Saya kedinginan di sini,
Dialog: 0,0:15:35.26,0:15:37.26,teks umum,,0,0,0,,dan anda melemparkan frasa sejuk
Dialog: 0,0:15:39.26,0:15:40.76,teks umum,,0,0,0,,Katakan sesuatu yang hangat
Dialog: 0,0:15:41.34,0:15:43.43,teks umum,,0,0,0,,Adakah anda hilang akal?
Dialog: 0,0:15:43.51,0:15:44.81,teks umum,,0,0,0,,Anda akan berkata yang sama
Dialog: 0,0:15:49.64,0:15:51.73,teks umum,,0,0,0,,Chan Wook, buka mata anda
Dialog: 0,0:15:52.52,0:15:55.44,teks umum,,0,0,0,,Baiklah, saya akan katakan sesuatu yang hangat
Dialog: 0,0:15:58.36,0:16:01.82,teks umum,,0,0,0,,Di tempat saya tinggal, pokok besar tumbuh
Dialog: 0,0:16:03.74,0:16:06.62,teks umum,,0,0,0,,Di bahagian paling atas terdapat sarang
Dialog: 0,0:16:07.29,0:16:09.04,teks umum,,0,0,0,,Terdapat satu telur di dalamnya
Dialog: 0,0:16:10.54,0:16:11.92,teks umum,,0,0,0,,Adakah anda memakannya?
Dialog: 0,0:16:12.92,0:16:14.92,teks umum,,0,0,0,,Anda akan berasa hangat dengan kata-kata saya
Dialog: 0,0:16:20.30,0:16:22.97,teks umum,,0,0,0,,Ibu burung terbang masuk dan duduk di atasnya
Dialog: 0,0:16:27.43,0:16:31.85,teks umum,,0,0,0,,Saya seperti telur di bahagian paling atas pokok
Dialog: 0,0:16:35.27,0:16:36.86,teks umum,,0,0,0,,Saya tidak kenal sesiapa,
Dialog: 0,0:16:38.78,0:16:40.65,teks umum,,0,0,0,,dan saya tidak berdaya
Dialog: 0,0:16:44.82,0:16:47.41,teks umum,,0,0,0,,Anda sahaja yang boleh menjaga saya
Dialog: 0,0:16:51.46,0:16:52.71,teks umum,,0,0,0,,Hidup saya
Dialog: 0,0:16:54.00,0:16:55.84,teks umum,,0,0,0,,di tangan anda
Dialog: 0,0:17:03.30,0:17:04.59,teks umum,,0,0,0,,Betapa hangatnya
Dialog: 0,0:17:10.73,0:17:12.02,teks umum,,0,0,0,,Teruskan
Dialog: 0,0:17:16.44,0:17:19.48,teks umum,,0,0,0,,Dan terdapat juga sebuah gua
Dialog: 0,0:17:21.78,0:17:24.03,teks umum,,0,0,0,,Seekor anak beruang tinggal di dalamnya
Dialog: 0,0:17:55.06,0:17:57.44,kenangan,,0,0,0,,Awak tak boleh angkat pedang ayah awak
Dialog: 0,0:17:57.52,0:17:59.27,kenangan,,0,0,0,,Bagaimana anda mahu belajar jampi?
Dialog: 0,0:18:01.03,0:18:03.49,kenangan,,0,0,0,,Tiada sesiapa dalam Daeho yang dapat menentang ayah kamu
Dialog: 0,0:18:03.57,0:18:05.70,kenangan,,0,0,0,,dan buka pintu tenaga anda
Dialog: 0,0:18:05.78,0:18:08.58,kenangan,,0,0,0,,Inilah takdir yang diberikan kepadamu
Dialog: 0,0:18:09.58,0:18:11.16,kenangan,,0,0,0,,bapa awak
Dialog: 0,0:18:32.52,0:18:33.68,teks umum,,0,0,0,,Anda belum bersedia lagi
Dialog: 0,0:18:39.98,0:18:42.44,teks umum,,0,0,0,,lukis pedang ajaib
Dialog: 0,0:18:43.07,0:18:46.15,teks umum,,0,0,0,,Anda mesti menguasai Ryusu dan belajar cara melepaskan tenaga
Dialog: 0,0:18:46.95,0:18:50.16,teks umum,,0,0,0,,Anda belum boleh melakukan ini, kerana anda tidak dapat mengawal tenaga anda
Dialog: 0,0:18:50.91,0:18:53.79,teks umum,,0,0,0,,Ayah saya meninggalkan pedang ini apabila dia meninggalkan saya
Dialog: 0,0:18:53.87,0:18:56.08,teks umum,,0,0,0,,Saya hanya akan sampai ke Sosnovy Bor dengan mendedahkannya
Dialog: 0,0:18:58.83,0:19:00.92,teks umum,,0,0,0,,Saya mahu melakukan ini dan menunjukkan kepada mereka
Dialog: 0,0:19:02.13,0:19:03.46,teks umum,,0,0,0,,Adakah ini manifestasi kebodohan?
Dialog: 0,0:19:03.55,0:19:04.84,teks umum,,0,0,0,,Tidak, memaksa
Dialog: 0,0:19:07.09,0:19:09.97,teks umum,,0,0,0,,Tabahlah, Chan Wook
Dialog: 0,0:19:29.03,0:19:30.16,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:19:30.24,0:19:32.70,teks umum,,0,0,0,,Kami tiba di rumah Chang Gan, gwangju Jeonbugwan
Dialog: 0,0:19:37.04,0:19:38.25,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:19:40.29,0:19:42.67,teks umum,,0,0,0,,Anda ada tetamu
Dialog: 0,0:19:43.38,0:19:44.30,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:19:44.38,0:19:47.63,teks umum,,0,0,0,,Putera Mahkota telah tiba
Dialog: 0,0:20:09.99,0:20:12.82,contact,,0,0,0,,Cuaca benar-benar sempurna
Dialog: 0,0:20:12.91,0:20:16.08,italic,,0,0,0,,untuk memancing bersama Wook berhampiran Gyeongcheongdaeho
Dialog: 0,0:20:18.16,0:20:20.96,teks umum,,0,0,0,,Saya tertanya-tanya adakah dia sedar
Dialog: 0,0:20:22.54,0:20:24.63,teks umum,,0,0,0,,Saya memutuskan untuk melawatnya kerana saya bimbang
Dialog: 0,0:20:24.71,0:20:26.38,teks umum,,0,0,0,,Kenapa awak terlibat?
Dialog: 0,0:20:27.80,0:20:29.17,teks umum,,0,0,0,,Saya ingin menyemak sesuatu
Dialog: 0,0:20:29.26,0:20:31.38,teks umum,,0,0,0,,Saya berkata sesuatu kepada pembantu rumahnya
Dialog: 0,0:20:32.39,0:20:35.01,teks umum,,0,0,0,,Kami melawat dia sebagai kawan,
Dialog: 0,0:20:35.10,0:20:36.68,teks umum,,0,0,0,,kenapa awak ada di sini?
Dialog: 0,0:20:37.81,0:20:39.93,teks umum,,0,0,0,,Saya terjumpa awak secara tidak sengaja
Dialog: 0,0:20:40.02,0:20:43.69,teks umum,,0,0,0,,Dan saya juga ada sesuatu untuk mencari kesalahannya
Dialog: 0,0:20:43.77,0:20:46.32,teks umum,,0,0,0,,Saya nampak, saya akan dapatkan dia
Dialog: 0,0:20:46.90,0:20:48.44,teks umum,,0,0,0,,Apa yang ada dalam pakej?
Dialog: 0,0:20:51.32,0:20:53.49,teks am,,0,0,0,,Ubat untuk lukanya
Dialog: 0,0:20:54.03,0:20:57.83,teks umum,,0,0,0,,Mula-mula anda beri ubat, kemudian anda duduk di telinganya
Dialog: 0,0:20:59.04,0:21:01.33,contact,,0,0,0,,Luar biasa
Dialog: 0,0:21:03.37,0:21:05.54,teks umum,,0,0,0,,Awak datang untuk pedang Nak Su?
Dialog: 0,0:21:05.63,0:21:07.55,teks umum,,0,0,0,,Raja mempercayakannya kepada Jeonbugwan
Dialog: 0,0:21:08.05,0:21:11.30,teks umum,,0,0,0,,Jin Mu, timbalan Gwangju mesti menyimpannya, kerana tidak ada Gwangju sendiri
Dialog: 0,0:21:15.51,0:21:18.31,teks umum,,0,0,0,,Oleh kerana anda datang ke sini secara peribadi, saya akan menyampaikannya kepada anda
Dialog: 0,0:21:18.39,0:21:19.47,teks umum,,0,0,0,,Ambil
Dialog: 0,0:21:20.10,0:21:20.93,italic,,0,0,0,,Bawa pedang
Dialog: 0,0:21:22.73,0:21:23.85,teks umum,,0,0,0,,Bukan itu sahaja
Dialog: 0,0:21:24.60,0:21:26.98,teks umum,,0,0,0,,Ada satu lagi pedang di sini yang anda tidak boleh lukis
Dialog: 0,0:21:28.65,0:21:32.15,teks umum,,0,0,0,,Allahyarham raja memberikannya kepada Gwangju Chang Gang
Dialog: 0,0:21:32.78,0:21:34.36,teks umum,,0,0,0,,saya nak ambil dia juga
Dialog: 0,0:21:34.45,0:21:37.24,teks umum,,0,0,0,,Tetapi ia milik bapanya
Dialog: 0,0:21:37.95,0:21:39.66,teks umum,,0,0,0,,Pedang di sebelah kanan tuan muda
Dialog: 0,0:21:39.74,0:21:41.29,teks umum,,0,0,0,,Tetapi dia tidak pernah dipercayai dengan pedang ini
Dialog: 0,0:21:42.66,0:21:44.87,teks umum,,0,0,0,,Sebelum ini ia disimpan dalam Sosnovy Bor
Dialog: 0,0:21:44.96,0:21:47.88,teks umum,,0,0,0,,Anda mengambilnya apabila anda dibuang dari situ, betulkah saya?
Dialog: 0,0:21:49.59,0:21:53.09,teks umum,,0,0,0,,Istana Diraja akan menyimpannya sehingga pemilihan Gwangju baharu
Dialog: 0,0:21:54.93,0:21:56.05,teks umum,,0,0,0,,Bawa saya pedang
Dialog: 0,0:22:03.39,0:22:04.89,teks umum,,0,0,0,,Saya tidak dapat memberikannya
Dialog: 0,0:22:06.52,0:22:10.32,teks umum,,0,0,0,,Seperti yang anda tahu, mereka tidak mengenali saya sebagai anak bapa mereka
Dialog: 0,0:22:11.86,0:22:14.61,teks umum,,0,0,0,,Jika saya juga kehilangan pedang saya, ia tidak akan berakhir dengan baik untuk saya
Dialog: 0,0:22:15.74,0:22:18.24,teks umum,,0,0,0,,Ia akan disimpan oleh saya, walaupun hanya sebagai hiasan
Dialog: 0,0:22:21.87,0:22:23.91,teks umum,,0,0,0,,Saya perlu menjemputnya,
Dialog: 0,0:22:24.66,0:22:26.96,teks umum,,0,0,0,,dan anda menolak. Tiada apa yang perlu dilakukan
Dialog: 0,0:22:29.29,0:22:30.96,teks umum,,0,0,0,,Pemenang mengambil pedang
Dialog: 0,0:22:49.02,0:22:51.65,teks umum,,0,0,0,,Anda tidak begitu terlatih untuk bertarung untuk pertempuran sebenar
Dialog: 0,0:22:58.53,0:23:00.70,teks umum,,0,0,0,,Bolehkah anda menolak melebihi baris ini,
Dialog: 0,0:23:01.28,0:23:02.58,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:23:17.30,0:23:21.93,teks umum,,0,0,0,,Saya pasti anda menjangkakan saya akan merenung sebelum anda
Dialog: 0,0:23:23.26,0:23:26.60,teks umum,,0,0,0,, Melawan kamu adalah manifestasi kebodohan
Dialog: 0,0:23:26.68,0:23:29.31,teks umum,,0,0,0,,Namun, ada yang menganggap ini sebagai manifestasi kekuatan
Dialog: 0,0:23:29.40,0:23:30.44,teks umum,,0,0,0,,Jadi saya akan cuba
Dialog: 0,0:24:23.82,0:24:25.16,kenangan,,0,0,0,,Ini adalah tenaga
Dialog: 0,0:24:25.24,0:24:26.54,kenangan,,0,0,0,,Ini tentang pukulan
Dialog: 0,0:24:26.62,0:24:28.66,kenangan,,0,0,0,,Terdapat lonjakan tenaga kerana dia
Dialog: 0,0:24:29.54,0:24:30.54,kenangan,,0,0,0,,Gembira anda dipukul
Dialog: 0,0:24:31.17,0:24:34.88,luar skrin,,0,0,0,,Baiklah, anda boleh memukul seberapa banyak yang anda mahu
Dialog: 0,0:25:54.00,0:25:55.29,teks umum,,0,0,0,,Kembali!
Dialog: 0,0:25:55.92,0:25:57.67,teks umum,,0,0,0,,Awas! Ia dari periuk bilik!
Dialog: 0,0:26:10.06,0:26:11.60,teks umum,,0,0,0,,Apa yang telah anda lakukan!
Dialog: 0,0:26:13.02,0:26:13.89,teks umum,,0,0,0,,Siapa ini?
Dialog: 0,0:26:15.31,0:26:18.15,teks umum,,0,0,0,,- Saya berkhidmat untuk tuan\N- Beraninya pembantu rumah itu campur tangan?
Dialog: 0,0:26:21.86,0:26:23.28,teks umum,,0,0,0,,Maaf, Yang Amat Mulia
Dialog: 0,0:26:23.36,0:26:25.03,teks umum,,0,0,0,,Pembantu rumah saya kurang ajar
Dialog: 0,0:26:27.62,0:26:28.53,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:26:31.33,0:26:33.79,teks umum,,0,0,0,,Menjijikkan
Dialog: 0,0:26:33.87,0:26:35.87,teks umum,,0,0,0,,Pulang ke rumah, tukar baju
Dialog: 0,0:26:36.37,0:26:38.54,teks umum,,0,0,0,,- Apa?\N - Anda melepasi talian
Dialog: 0,0:26:41.63,0:26:44.55,teks umum,,0,0,0,,Sudah tentu, anda tidak mahu menjadi kotor, tetapi masih,
Dialog: 0,0:26:44.63,0:26:45.80,teks umum,,0,0,0,,ini adalah kerugian
Dialog: 0,0:26:45.88,0:26:49.26,teks umum,,0,0,0,,Tepati janjimu dan tinggalkan aku pedang ayahku
Dialog: 0,0:26:50.26,0:26:51.81,miring,,0,0,0,,Seperti yang anda lihat,
Dialog: 0,0:26:51.89,0:26:54.43,teks umum,,0,0,0,,Saya tidak akan dapat menemani awak kerana saya cedera parah
Dialog: 0,0:27:02.15,0:27:03.44,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:27:04.44,0:27:05.65,contact,,0,0,0,,Okay
Dialog: 0,0:27:05.74,0:27:07.57,teks umum,,0,0,0,,Saya akan menjaga kata-kata saya dan meninggalkan pedang
Dialog: 0,0:27:08.28,0:27:09.28,teks umum,,0,0,0,,Tetapi,
Dialog: 0,0:27:10.37,0:27:11.91,teks umum,,0,0,0,,Saya akan menghukum dia
Dialog: 0,0:27:17.12,0:27:19.71,teks umum,,0,0,0,,Saya tidak akan memaafkannya kerana pakaiannya yang kotor
Dialog: 0,0:28:12.60,0:28:15.14,teks umum,,0,0,0,,Saya menghunus pedang saya...
Dialog: 0,0:28:29.19,0:28:30.91,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:28:30.99,0:28:33.57,teks umum,,0,0,0,,Saya fikir anda tidak boleh menggunakan jampi,
Dialog: 0,0:28:33.66,0:28:35.41,teks umum,,0,0,0,,dan anda memperdayakan kami semua
Dialog: 0,0:28:35.99,0:28:36.83,teks umum,,0,0,0,,Tidak...
Dialog: 0,0:28:37.45,0:28:39.54,teks umum,,0,0,0,,Apa?
Dialog: 0,0:28:46.63,0:28:48.05,teks umum,,0,0,0,,Awak!
Dialog: 0,0:28:48.13,0:28:50.42,teks umum,,0,0,0,,Beraninya awak mengangkat pedang menentang Putera Mahkota?
Dialog: 0,0:28:50.51,0:28:52.68,teks umum,,0,0,0,,- Tidak, ini bukan saya\N- Uk, letakkan pedangmu!
Dialog: 0,0:28:53.68,0:28:55.89,teks umum,,0,0,0,,- Turunkan sekarang\N- Saya cuba
Dialog: 0,0:28:56.47,0:28:57.47,teks umum,,0,0,0,,Tetapi saya tidak boleh
Dialog: 0,0:29:20.87,0:29:22.48,teks umum,,0,0,0,,Berhenti sekarang, bodoh!
Dialog: 0,0:29:23.50,0:29:25.17,teks umum,,0,0,0,,Saya tidak mengawal dia!
Dialog: 0,0:29:37.64,0:29:38.64,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:29:39.64,0:29:40.89,teks umum,,0,0,0,,mati!
Dialog: 0,0:29:50.78,0:29:51.82,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:30:00.20,0:30:02.29,teks umum,,0,0,0,,- Berhenti\N- Saya tidak mengawal tangan saya
Dialog: 0,0:30:02.37,0:30:03.71,teks umum,,0,0,0,,Apa?
Dialog: 0,0:30:05.12,0:30:07.13,teks umum,,0,0,0,,Saya... Saya tidak bermaksud untuk
Dialog: 0,0:30:07.63,0:30:10.00,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:30:17.01,0:30:18.01,teks umum,,0,0,0,,Ini adalah gelang yang mengikat
Dialog: 0,0:30:18.10,0:30:20.76,teks umum,,0,0,0,,Berat badannya akan mengawal tangan anda
Dialog: 0,0:30:27.15,0:30:30.82,luar skrin,,0,0,0,,Tenaganya dicurahkan ke satu tangan dan tidak dapat dikawal
Dialog: 0,0:30:32.44,0:30:33.61,teks umum,,0,0,0,,Leraikan dia!
Dialog: 0,0:30:36.16,0:30:37.20,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:30:38.28,0:30:39.41,teks umum,,0,0,0,,Gam the sword
Dialog: 0,0:30:41.62,0:30:42.58,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:30:42.66,0:30:44.66,teks umum,,0,0,0,,Dia bukan tandingan anda
Dialog: 0,0:30:44.75,0:30:46.33,teks umum,,0,0,0,,Anda adalah saksi kepada perkara ini
Dialog: 0,0:30:46.42,0:30:48.96,teks umum,,0,0,0,,Dia mengacukan pedang bapanya kepada saya
Dialog: 0,0:30:49.04,0:30:51.59,teks umum,,0,0,0,,Dia hanya tidak mengawal tenaganya
Dialog: 0,0:30:51.67,0:30:54.17,teks umum,,0,0,0,,- Dia pun pukul saya, awak nampak\N- Diam!
Dialog: 0,0:30:56.18,0:30:58.76,teks umum,,0,0,0,,Yang Mulia, anda adalah orang pertama yang menghalakan bilah pedang anda kepadanya
Dialog: 0,0:30:59.35,0:31:01.39,teks umum,,0,0,0,,Pedang yang kamu lambai dalam kemarahan telah patah
Dialog: 0,0:31:01.47,0:31:03.89,teks umum,,0,0,0,,Kamu mesti mematuhi adat-istiadat ahli silap mata dan kembali ke istana
Dialog: 0,0:31:07.02,0:31:09.98,teks umum,,0,0,0,,Beraninya awak menentang kehendak saya?
Dialog: 0,0:31:12.40,0:31:16.03,teks umum,,0,0,0,,Chan, Jin, Seo dan Park. Mereka berempat berada di hadapan saya
Dialog: 0,0:31:16.95,0:31:19.57,teks umum,,0,0,0,,Saya enggan meninggalkan kekalahan
Dialog: 0,0:31:19.66,0:31:20.82,teks umum,,0,0,0,,Apa yang akan anda lakukan?
Dialog: 0,0:31:22.08,0:31:24.83,teks umum,,0,0,0,,Kamu berempat menyerang
Dialog: 0,0:31:32.63,0:31:34.51,teks umum,,0,0,0,,Sangat teruk
Dialog: 0,0:31:34.59,0:31:37.59,teks umum,,0,0,0,,Nampaknya keluarga kami menentang keluarga diraja
Dialog: 0,0:31:37.67,0:31:39.59,contact,,0,0,0,,Semuanya semakin serius
Dialog: 0,0:31:39.68,0:31:41.26,teks umum,,0,0,0,,Cho Young memprovokasi dia
Dialog: 0,0:31:41.35,0:31:43.01,teks umum,,0,0,0,,Apa yang saya buat?
Dialog: 0,0:31:43.56,0:31:46.39,teks umum,,0,0,0,,Kemudian kami hanya memberinya Uka
Dialog: 0,0:31:46.48,0:31:47.56,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:31:48.27,0:31:50.69,teks umum,,0,0,0,,Ini adalah keluarga utama Deho
Dialog: 0,0:31:51.31,0:31:52.73,teks umum,,0,0,0,,Raja akan murka,
Dialog: 0,0:31:52.82,0:31:54.40,teks umum,,0,0,0,,jika dia mendengar tentang pergaduhan ini
Dialog: 0,0:31:55.90,0:31:58.24,teks umum,,0,0,0,,Jadi bagaimana? Patutkah saya pergi sahaja?
Dialog: 0,0:31:59.45,0:32:01.53,teks umum,,0,0,0,,Anda sepatutnya menghalang saya lebih awal
Dialog: 0,0:32:15.67,0:32:16.63,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:32:25.10,0:32:26.77,teks umum,,0,0,0,,Maaf, Yang Amat Mulia
Dialog: 0,0:32:28.14,0:32:31.15,teks umum,,0,0,0,,Beraninya saya, tikus seperti itu, menumpahkan najis
Dialog: 0,0:32:31.23,0:32:32.48,teks umum,,0,0,0,,pada pakaian anda?
Dialog: 0,0:32:37.65,0:32:39.95,teks umum,,0,0,0,,Saya benar-benar minta maaf. sangat
Dialog: 0,0:32:40.03,0:32:41.16,teks umum,,0,0,0,,Pergi
Dialog: 0,0:32:41.24,0:32:43.53,teks umum,,0,0,0,,Hilang. awak busuk
Dialog: 0,0:32:44.58,0:32:46.91,teks umum,,0,0,0,,Maafkan kami
Dialog: 0,0:32:50.75,0:32:55.54,teks umum,,0,0,0,,Sebagai tanda penyesalan yang ikhlas, saya akan menghabiskan apa yang tinggal
Dialog: 0,0:32:56.46,0:32:58.71,teks umum,,0,0,0,,Maka maafkan kami
Dialog: 0,0:33:08.68,0:33:09.64,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:33:11.98,0:33:14.10,teks umum,,0,0,0,,Kenapa awak minum?
Dialog: 0,0:33:16.86,0:33:17.82,teks umum,,0,0,0,,En!
Dialog: 0,0:33:21.07,0:33:22.61,teks umum,,0,0,0,,saya kena minum ni
Dialog: 0,0:33:24.49,0:33:25.82,teks umum,,0,0,0,,Apa?
Dialog: 0,0:33:27.62,0:33:29.20,teks umum,,0,0,0,,Ini tidak begitu
Dialog: 0,0:33:29.29,0:33:31.12,teks umum,,0,0,0,,Kenapa awak?
Dialog: 0,0:33:31.21,0:33:33.71,teks umum,,0,0,0,,Sayalah sebabnya, jadi saya akan minum
Dialog: 0,0:33:33.79,0:33:36.63,teks umum,,0,0,0,,Tidak sama sekali. Baginda marah kepada saya
Dialog: 0,0:33:36.71,0:33:38.75,teks umum,,0,0,0,,Saya mesti minum
Dialog: 0,0:33:42.38,0:33:44.38,teks umum,,0,0,0,,Dan ada banyak...
Dialog: 0,0:33:45.22,0:33:47.89,teks umum,,0,0,0,,Jom ke sini, saya minum
Dialog: 0,0:33:47.97,0:33:49.10,teks umum,,0,0,0,,Maka bolehkah kita berkongsi?
Dialog: 0,0:33:50.43,0:33:52.64,teks umum,,0,0,0,,Mengapa kongsi ini?
Dialog: 0,0:33:52.73,0:33:54.06,teks umum,,0,0,0,,Apa?
Dialog: 0,0:33:54.14,0:33:55.23,teks umum,,0,0,0,,Ambil semuanya
Dialog: 0,0:33:57.36,0:33:59.53,teks umum,,0,0,0,,Kemudian saya akan minum sedikit dan memberikannya kepada anda
Dialog: 0,0:33:59.61,0:34:02.32,teks umum,,0,0,0,,Bantu saya angkat, tangan saya tidak boleh bergerak
Dialog: 0,0:34:06.32,0:34:07.16,teks umum,,0,0,0,,En!
Dialog: 0,0:34:11.83,0:34:13.25,teks umum,,0,0,0,,Saya...
Dialog: 0,0:34:14.50,0:34:15.46,teks umum,,0,0,0,,minum
Dialog: 0,0:34:16.63,0:34:17.58,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:34:17.67,0:34:19.55,teks umum,,0,0,0,,Mengapa anda memerlukannya?
Dialog: 0,0:34:19.63,0:34:20.75,teks umum,,0,0,0,,Keluar dari sini
Dialog: 0,0:34:20.84,0:34:23.09,contact,,0,0,0,,Berapa jumlahnya?
Dialog: 0,0:34:23.17,0:34:24.80,teks umum,,0,0,0,,Adakah anda mahu saya bantu?
Dialog: 0,0:34:25.43,0:34:27.72,teks umum,,0,0,0,,- Serius?\N- Datang ke sini
Dialog: 0,0:34:31.39,0:34:32.47,teks umum,,0,0,0,,Ini adalah kebenaran dari periuk...
Dialog: 0,0:34:35.85,0:34:37.06,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:34:37.15,0:34:39.15,teks umum,,0,0,0,,Beraninya kami bersaing dengan anda?
Dialog: 0,0:34:39.86,0:34:41.28,teks umum,,0,0,0,,Adakah mereka benar-benar perlu minum
Dialog: 0,0:34:41.36,0:34:43.61,teks umum,,0,0,0,,kerana ini sebagai permintaan maaf?
Dialog: 0,0:34:46.99,0:34:48.37,teks umum,,0,0,0,,Kepada anda
Dialog: 0,0:34:49.49,0:34:52.70,teks umum,,0,0,0,,Berhenti. Saya muak dengan awak
Dialog: 0,0:34:55.16,0:34:56.33,teks umum,,0,0,0,,Jom
Dialog: 0,0:34:58.08,0:35:01.46,teks umum,,0,0,0,,Yang Mulia akan pergi! Tundukkan kepala anda!
Dialog: 0,0:35:07.18,0:35:09.64,teks umum,,0,0,0,,Kenapa dia datang?
Dialog: 0,0:35:10.26,0:35:12.22,teks umum,,0,0,0,,Di sebalik pedang Nak Su
Dialog: 0,0:35:12.93,0:35:14.85,teks umum,,0,0,0,,Dan kemudian tiba-tiba pergaduhan bermula
Dialog: 0,0:35:15.52,0:35:18.35,teks umum,,0,0,0,,Hari ini dia pergi, tetapi mengetahui wataknya,
Dialog: 0,0:35:18.85,0:35:20.52,teks umum,,0,0,0,,dia pasti akan membalas dendam
Dialog: 0,0:35:24.03,0:35:26.36,teks umum,,0,0,0,,- Awak okay?\N- Dia pukul saya berkali-kali
Dialog: 0,0:35:26.45,0:35:28.99,contact,,0,0,0,,Dan awak memukul saya dengan kuat!
Dialog: 0,0:35:31.45,0:35:33.16,italic,,0,0,0,,- Awak okay?\N- Saya rasa begitu
Dialog: 0,0:35:33.24,0:35:34.49,teks umum,,0,0,0,,- Sakit\N- Adakah ia menyakitkan?
Dialog: 0,0:35:34.58,0:35:35.91,teks umum,,0,0,0,,- Adakah sakit di sini?\N- Sakit
Dialog: 0,0:35:36.00,0:35:38.58,teks umum,,0,0,0,,- Sakit di mana-mana\N- Jangan sentuh dia
Dialog: 0,0:35:41.54,0:35:44.38,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:35:48.34,0:35:49.64,teks umum,,0,0,0,,Apa yang anda mahukan?
Dialog: 0,0:35:50.51,0:35:53.51,teks umum,,0,0,0,,Anda datang untuk pedang Nak Su, ini dia
Dialog: 0,0:35:55.39,0:35:56.48,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:35:57.31,0:35:58.85,teks umum,,0,0,0,,Saya datang untuk menjemputnya
Dialog: 0,0:35:58.94,0:36:02.77,teks umum,,0,0,0,,Saya membawanya supaya anda tidak perlu kembali untuk kali kedua
Dialog: 0,0:36:02.86,0:36:04.23,teks umum,,0,0,0,,Sila ambil
Dialog: 0,0:36:04.98,0:36:08.28,teks umum,,0,0,0,,Adakah anda ingin memberitahu saya untuk mengambil apa yang saya datang dan tidak kembali?
Dialog: 0,0:36:09.53,0:36:13.58,teks umum,,0,0,0,,Anda sangat bijak, berwawasan dan kuat
Dialog: 0,0:36:13.66,0:36:15.87,teks umum,,0,0,0,,Adakah anda mentertawakan saya kerana saya kalah?
Dialog: 0,0:36:15.95,0:36:18.79,teks umum,,0,0,0,,Kalah? Anda mendapat apa yang anda mahu
Dialog: 0,0:36:18.87,0:36:20.87,teks umum,,0,0,0,,Dan dia kehilangannya
Dialog: 0,0:36:20.96,0:36:23.96,teks umum,,0,0,0,,Pemenang di sini ialah anda
Dialog: 0,0:36:26.46,0:36:30.05,teks umum,,0,0,0,,Beliau betul, Yang Amat Mulia. Awak menang
Dialog: 0,0:36:30.88,0:36:33.10,teks umum,,0,0,0,,Tahniah, Yang Amat Mulia
Dialog: 0,0:36:35.18,0:36:36.47,teks umum,,0,0,0,,Jadi begitu
Dialog: 0,0:36:40.44,0:36:42.60,teks umum,,0,0,0,,Selain itu, anda sangat pemurah
Dialog: 0,0:36:42.69,0:36:45.65,teks umum,,0,0,0,,Tiada orang yang mulia di dunia seperti anda
Dialog: 0,0:36:50.20,0:36:51.36,teks umum,,0,0,0,,Siapa nama awak?
Dialog: 0,0:36:53.49,0:36:55.12,teks umum,,0,0,0,,Moo Dok, Yang Amat Mulia
Dialog: 0,0:36:56.28,0:36:57.29,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:36:57.79,0:36:59.62,teks umum,,0,0,0,,Awak menumpahkan air dari periuk ke atas saya
Dialog: 0,0:36:59.71,0:37:01.33,teks umum,,0,0,0,,Mulai sekarang saya akan panggil awak Won Mu Deok
Dialog: 0,0:37:02.00,0:37:05.96,teks umum,,0,0,0,,Seperti nama awak, awak berbau kotoran
Dialog: 0,0:37:12.59,0:37:14.34,teks umum,,0,0,0,,Anda juga memberi saya nama
Dialog: 0,0:37:14.43,0:37:17.89,teks umum,,0,0,0,,Terima kasih banyak atas kebaikan anda
Dialog: 0,0:37:22.31,0:37:23.69,teks umum,,0,0,0,,Selamat tinggal, Yang Amat Mulia
Dialog: 0,0:37:25.77,0:37:26.73,teks umum,,0,0,0,,Maju
Dialog: 0,0:37:35.82,0:37:39.33,suara,,0,0,0,,Pelajar saya masih terlalu lemah untuk melawan awak
Dialog: 0,0:37:39.41,0:37:43.08,suara,,0,0,0,,Sehingga dia menjadi lebih kuat, lebih baik dia tidak merosakkan hubungannya dengan awak
Dialog: 0,0:37:50.21,0:37:53.01,teks umum,,0,0,0,,Anda mudah jatuh cinta atau memikat hati orang lain
Dialog: 0,0:37:53.09,0:37:54.47,teks umum,,0,0,0,,demi tuanmu?
Dialog: 0,0:37:54.55,0:37:57.14,teks umum,,0,0,0,,Saya tidak dapat melawannya, jadi saya menyiramnya
Dialog: 0,0:37:59.14,0:38:02.02,teks umum,,0,0,0,,Saya busuk, lebih baik awak jangan dekat saya
Dialog: 0,0:38:08.11,0:38:08.94,teks umum,,0,0,0,,Lap sendiri
Dialog: 0,0:38:12.57,0:38:15.28,teks umum,,0,0,0,,Beraninya saya mengotorkan perkara lelaki yang saya cintai?
Dialog: 0,0:38:16.28,0:38:17.53,teks umum,,0,0,0,,Tidak, terima kasih
Dialog: 0,0:38:53.49,0:38:55.53,teks umum,,0,0,0,,Saya benar-benar menjadi Stinky Moo Deok
Dialog: 0,0:39:01.49,0:39:04.37,teks umum,,0,0,0,,Anda cuci muka juga, anda mungkin berbau
Dialog: 0,0:39:21.43,0:39:24.52,teks umum,,0,0,0,,Cikgu, akhirnya saya berjaya
Dialog: 0,0:39:50.83,0:39:54.92,teks umum,,0,0,0,,Gwiga telah dicuri daripada Jinyeowon
Dialog: 0,0:39:56.05,0:39:59.80,teks umum,,0,0,0,,Hanya ahli keluarga Jin boleh membuka pintu ini
Dialog: 0,0:40:00.51,0:40:03.76,teks umum,,0,0,0,,Mereka pasti memanggilnya dari luar
Dialog: 0,0:40:05.47,0:40:06.89,teks umum,,0,0,0,,Kecurian di Jinyeowon?
Dialog: 0,0:40:06.98,0:40:10.15,teks umum,,0,0,0,,Anda bersedih kerana anak perempuan anda yang mati selama bertahun-tahun,
Dialog: 0,0:40:10.23,0:40:13.61,teks umum,,0,0,0,,ini pasti melemahkan anda
Dialog: 0,0:40:14.73,0:40:16.94,teks umum,,0,0,0,,Biadap tak tahu malu
Dialog: 0,0:40:17.53,0:40:20.99,teks umum,,0,0,0,,Anda mungkin tidak sah, tetapi masih sebahagian daripada keluarga Jin
Dialog: 0,0:40:21.07,0:40:23.16,teks umum,,0,0,0,,Beraninya awak memfitnah adik tiri awak?
Dialog: 0,0:40:23.24,0:40:24.37,teks umum,,0,0,0,,Scoundrel
Dialog: 0,0:40:24.45,0:40:25.74,teks umum,,0,0,0,,Saya timbalan Gwangju
Dialog: 0,0:40:25.83,0:40:28.46,teks umum,,0,0,0,,Saya akan menghargainya jika anda menunjukkan lebih hormat
Dialog: 0,0:40:36.38,0:40:39.67,teks umum,,0,0,0,,Encik, sila keluar ke halaman rumah. Chan Wook datang jumpa awak
Dialog: 0,0:41:01.15,0:41:03.11,teks umum,,0,0,0,,Saya melarang dia muncul di sini
Dialog: 0,0:41:03.20,0:41:06.74,teks umum,,0,0,0,,Kenapa awak bawa dia bersama awak?
Dialog: 0,0:41:07.66,0:41:09.45,teks umum,,0,0,0,,Anda perlu melihat sesuatu
Dialog: 0,0:41:16.67,0:41:18.55,teks umum,,0,0,0,,Ini adalah pedang ayah saya
Dialog: 0,0:41:19.34,0:41:22.72,italic,,0,0,0,,Masa saya muda, awak kata awak akan terima saya kalau saya boleh tahan.
Dialog: 0,0:41:23.39,0:41:24.34,teks umum,,0,0,0,,Awak ingat?
Dialog: 0,0:42:05.30,0:42:08.01,teks umum,,0,0,0,,Saya fikir dia baru sahaja membuka pintu tenaganya
Dialog: 0,0:42:08.72,0:42:11.73,teks umum,,0,0,0,,Saya nampak dia telah menguasai aliran tenaga saya
Dialog: 0,0:42:12.39,0:42:14.48,miring,,0,0,0,,Seperti yang anda jangkakan daripada anak lelaki Chang Gang
Dialog: 0,0:42:14.56,0:42:16.69,teks umum,,0,0,0,,Dia menguasai Ryusu dalam sekelip mata
Dialog: 0,0:42:17.40,0:42:20.65,teks umum,,0,0,0,,Sila bawa saya ke tempat anda,
Dialog: 0,0:42:21.48,0:42:22.40,teks umum,,0,0,0,,tuan
Dialog: 0,0:42:27.24,0:42:28.87,teks umum,,0,0,0,,Apa yang ada di tangan anda?
Dialog: 0,0:42:29.45,0:42:31.70,teks umum,,0,0,0,,Tenaganya tertumpu di tangan kanannya
Dialog: 0,0:42:31.79,0:42:33.08,miring,,0,0,0,,Dia belum mengawalnya lagi,
Dialog: 0,0:42:33.16,0:42:35.12,teks umum,,0,0,0,,jadi kami meletakkan gelang kekang padanya
Dialog: 0,0:42:46.72,0:42:48.68,teks umum,,0,0,0,,Tanggalkan
Dialog: 0,0:42:49.60,0:42:52.14,teks umum,,0,0,0,,Jika kita lepaskan dia, tangannya akan berhenti menurut
Dialog: 0,0:42:52.22,0:42:55.06,teks umum,,0,0,0,,Biar dia merakamnya kemudian, selepas latihan
Dialog: 0,0:42:56.10,0:42:57.23,teks umum,,0,0,0,,Tembak
Dialog: 0,0:43:23.63,0:43:27.05,teks umum,,0,0,0,,Saya mahu melihat bagaimana anda memegang pedang
Dialog: 0,0:43:58.54,0:44:00.46,teks umum,,0,0,0,,Ikat lengannya
Dialog: 0,0:44:13.60,0:44:15.89,teks umum,,0,0,0,,Awak... okay?
Dialog: 0,0:44:16.93,0:44:18.85,teks umum,,0,0,0,,Apa guna menarik pedang,
Dialog: 0,0:44:20.81,0:44:22.56,teks umum,,0,0,0,, jika anda tidak boleh menahannya?
Dialog: 0,0:44:28.74,0:44:30.66,contact,,0,0,0,,Dia masih belum dapat mengawalnya
Dialog: 0,0:44:30.74,0:44:32.91,contact,,0,0,0,,Tetapi dia mempunyai kekuatan yang luar biasa
Dialog: 0,0:44:32.99,0:44:34.49,teks umum,,0,0,0,,Dia malah mengalahkan Putera Mahkota
Dialog: 0,0:44:35.54,0:44:37.91,contact,,0,0,0,,Dia mematahkan pedang Baginda
Dialog: 0,0:44:38.50,0:44:40.54,italic,,0,0,0,,Walaupun dia sudah lama menguasai Ryusu
Dialog: 0,0:44:40.62,0:44:42.17,italic,,0,0,0,,UK menang
Dialog: 0,0:44:43.71,0:44:45.92,teks umum,,0,0,0,,Jin Cho Young, jangan campur
Dialog: 0,0:44:47.09,0:44:48.46,teks umum,,0,0,0,,Ya, ibu
Dialog: 0,0:44:49.34,0:44:54.10,teks umum,,0,0,0,,Uk, adakah kamu benar-benar menghalakan pedang terhadap Putera Mahkota?
Dialog: 0,0:44:54.68,0:44:56.43,teks umum,,0,0,0,,Ne Uk memulakan pergaduhan
Dialog: 0,0:44:56.51,0:44:58.39,teks umum,,0,0,0,,Anda mengacukan pedang ke arah Putera Mahkota?!
Dialog: 0,0:45:00.44,0:45:01.52,teks umum,,0,0,0,,Ya
Dialog: 0,0:45:02.81,0:45:05.52,teks umum,,0,0,0,,Yang Mulia ingin mengambil pedang Gwangju
Dialog: 0,0:45:05.61,0:45:07.48,teks umum,,0,0,0,,Ia adalah pertikaian
Dialog: 0,0:45:08.19,0:45:10.15,contact,,0,0,0,,Putera Mahkota pun memaafkannya
Dialog: 0,0:45:11.36,0:45:15.66,contact,,0,0,0,,Pedang Yang Amat Mulia telah patah, tetapi Uk masih mengacukannya ke arahnya!
Dialog: 0,0:45:15.74,0:45:18.58,teks umum,,0,0,0,,Dia meletakkan nyawa Putera Mahkota dalam bahaya
Dialog: 0,0:45:18.66,0:45:19.66,teks umum,,0,0,0,,Kami juga berada di sana
Dialog: 0,0:45:20.79,0:45:21.87,teks umum,,0,0,0,,Kami dapat menghalangnya
Dialog: 0,0:45:21.96,0:45:24.00,teks umum,,0,0,0,,Ini bermakna anda berempat menonton,
Dialog: 0,0:45:24.08,0:45:26.25,teks umum,,0,0,0,,bagaimana mereka mengejek Baginda
Dialog: 0,0:45:28.71,0:45:31.72,teks umum,,0,0,0,,Ini adalah satu penghinaan kepada keluarga diraja!
Dialog: 0,0:45:34.72,0:45:36.51,teks umum,,0,0,0,,Kunci Chan Wook
Dialog: 0,0:45:39.39,0:45:41.56,teks umum,,0,0,0,,Ia tidak terkawal dan berbahaya
Dialog: 0,0:45:41.64,0:45:42.77,condong,,0,0,0,,Ya
Dialog: 0,0:46:02.21,0:46:04.17,teks umum,,0,0,0,,Adalah berbaloi untuk membuka pintu tenaga,
Dialog: 0,0:46:04.25,0:46:08.17,teks umum,,0,0,0,,bagaimana Chang Wook mula mengancam Putera Mahkota
Dialog: 0,0:46:11.17,0:46:14.01,teks umum,,0,0,0,,Chonbugwan tidak akan meninggalkan ini dengan begitu mudah
Dialog: 0,0:47:14.07,0:47:16.86,teks umum,,0,0,0,,Anda belum lagi merawat luka itu, anda telah kehilangan banyak darah
Dialog: 0,0:47:19.24,0:47:21.62,teks umum,,0,0,0,,Bagaimana keadaan tangan anda?
Dialog: 0,0:47:25.33,0:47:27.54,teks umum,,0,0,0,,Gelang itu tidak membenarkan dia bergerak
Dialog: 0,0:47:28.37,0:47:29.63,teks umum,,0,0,0,,Tetapi saya baik-baik saja
Dialog: 0,0:47:31.38,0:47:34.55,teks umum,,0,0,0,,Anda dapat menguasai aliran tenaga daripada Master Ho Yeom
Dialog: 0,0:47:34.63,0:47:36.13,teks umum,,0,0,0,,dalam masa yang singkat
Dialog: 0,0:47:37.30,0:47:38.51,teks umum,,0,0,0,,Saya sangat kagum
Dialog: 0,0:47:41.14,0:47:43.06,teks umum,,0,0,0,,Pada mulanya badan saya terbakar dengan api,
Dialog: 0,0:47:43.64,0:47:46.10,teks umum,,0,0,0,,dan kemudian ia seolah-olah diselaputi ais
Dialog: 0,0:47:47.85,0:47:50.10,teks umum,,0,0,0,,Bagaimana keadaan luka anda akibat pukulan itu?
Dialog: 0,0:47:50.19,0:47:51.52,teks umum,,0,0,0,,Adakah ia menyakitkan?
Dialog: 0,0:47:54.36,0:47:58.40,teks umum,,0,0,0,,Nampaknya pukulan itu membantu mengumpul tenaga
Dialog: 0,0:48:00.36,0:48:02.49,teks umum,,0,0,0,,Putera Mahkota memberi saya banyak pukulan,
Dialog: 0,0:48:04.45,0:48:07.58,teks umum,,0,0,0,,selepas itu saya merasakan lonjakan tenaga
Dialog: 0,0:48:07.66,0:48:09.04,teks umum,,0,0,0,,Dan kemudian saya dapat pedang
Dialog: 0,0:48:11.42,0:48:12.42,teks umum,,0,0,0,,Tidak hairanlah
Dialog: 0,0:48:13.17,0:48:17.59,teks umum,,0,0,0,,Anda sentiasa belajar segala-galanya lebih cepat daripada yang lain
Dialog: 0,0:48:18.76,0:48:22.60,contact,,0,0,0,,Anda belajar berjalan dan berlari lebih awal daripada Dan Gu
Dialog: 0,0:48:23.39,0:48:25.68,teks umum,,0,0,0,,Dan mula bercakap lebih awal
Dialog: 0,0:48:26.85,0:48:28.27,teks umum,,0,0,0,,Saya ingat ini
Dialog: 0,0:48:29.06,0:48:32.52,teks umum,,0,0,0,,Sehingga saya mendapat tahu bahawa pintu tenaga saya terkunci,
Dialog: 0,0:48:34.15,0:48:36.65,teks umum,,0,0,0,,Saya fikir saya akan menjadi orang yang paling kuat
Dialog: 0,0:48:42.03,0:48:43.28,teks umum,,0,0,0,,Uk
Dialog: 0,0:48:44.74,0:48:48.79,teks umum,,0,0,0,,Anda bijak dan belajar segala-galanya dengan cepat
Dialog: 0,0:48:51.29,0:48:55.59,teks umum,,0,0,0,,Mungkin anda akan menjadi seorang peniaga, belajar berniaga?
Dialog: 0,0:48:56.17,0:49:00.84,teks umum,,0,0,0,,Atau tuan Ho Yeom akan mengambilnya sebagai pelajar dan mengajarnya perubatan
Dialog: 0,0:49:05.64,0:49:06.68,teks umum,,0,0,0,,Saya menolak
Dialog: 0,0:49:09.73,0:49:12.98,teks umum,,0,0,0,,Saya akan berlatih di Jeonjingak dan menjadi ahli silap mata
Dialog: 0,0:49:13.65,0:49:14.73,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:49:15.69,0:49:18.40,teks umum,,0,0,0,,Sebab itu yang ayah awak buat?
Dialog: 0,0:49:20.32,0:49:23.49,teks umum,,0,0,0,,Adakah anda mahu menjadi Gwangju Jeonbugwan seterusnya?
Dialog: 0,0:49:24.16,0:49:26.91,teks umum,,0,0,0,,Ya, dan saya akan menjadi satu
Dialog: 0,0:49:27.99,0:49:29.62,teks umum,,0,0,0,,Saya akan menggantikan tempatnya
Dialog: 0,0:49:29.70,0:49:32.75,teks umum,,0,0,0,,dan saya akan buktikan kepada orang jahat ini yang tidak percaya bahawa saya adalah anaknya
Dialog: 0,0:49:34.33,0:49:36.25,teks umum,,0,0,0,,- Saya akan senyapkan mereka semua{\i1}\N- Awak...
Dialog: 0,0:49:38.46,0:49:39.96,teks umum,,0,0,0,,bukan anak lelaki
Dialog: 0,0:49:41.22,0:49:42.30,teks umum,,0,0,0,,Chan Gan
Dialog: 0,0:49:45.64,0:49:46.93,miring,,0,0,0,,Anda
Dialog: 0,0:49:47.64,0:49:50.85,teks umum,,0,0,0,,buah pengkhianatan ibumu
Dialog: 0,0:49:52.94,0:49:56.31,italic,,0,0,0,,Kami menerima kamu ke dalam keluarga Chan untuk menunjukkan rasa hormat kepada arwah ibu kamu
Dialog: 0,0:49:56.40,0:49:59.19,miring,,0,0,0,,Tetapi kami tidak boleh membenarkan anda menjadi ketua Jeonbugwan
Dialog: 0,0:49:59.28,0:50:02.40,teks umum,,0,0,0,,Jadi berhentilah bermimpi untuk mengikuti jejak langkah
Dialog: 0,0:50:05.45,0:50:06.41,teks umum,,0,0,0,,bapanya
Dialog: 0,0:50:07.87,0:50:11.20,contact,,0,0,0,,Kekal pewaris yang tidak tahu
Dialog: 0,0:50:11.91,0:50:14.46,contact,,0,0,0,,Keluarga Chan
Dialog: 0,0:50:16.33,0:50:17.46,teks umum,,0,0,0,,Dan kemudian
Dialog: 0,0:50:19.21,0:50:21.30,teks umum,,0,0,0,,kami akan terus menjaga anda
Dialog: 0,0:50:28.97,0:50:30.06,teks umum,,0,0,0,,Kemudian...
Dialog: 0,0:50:33.23,0:50:34.85,teks umum,,0,0,0,,Lalu siapa ayah saya?
Dialog: 0,0:50:37.61,0:50:41.48,teks umum,,0,0,0,,Bagaimana kami tahu dengan siapa arwah ibu anda?
Dialog: 0,0:50:44.15,0:50:45.91,teks umum,,0,0,0,,menipu dia?
Dialog: 0,0:51:20.40,0:51:24.15,teks umum,,0,0,0,,Uka mempunyai banyak fikiran dalam kepalanya sekarang, biarkan dia sendirian
Dialog: 0,0:51:30.87,0:51:32.74,teks umum,,0,0,0,,Pastikan dia makan semuanya
Dialog: 0,0:51:42.55,0:51:45.42,teks umum,,0,0,0,,Maiden Kim mengarahkan saya untuk memastikan awak makan semuanya
Dialog: 0,0:51:49.09,0:51:50.47,teks umum,,0,0,0,,Adakah dia memarahi awak lagi?
Dialog: 0,0:51:52.81,0:51:55.35,teks umum,,0,0,0,,saya sangka awak sudah biasa dimarahi...
Dialog: 0,0:52:07.70,0:52:08.86,teks umum,,0,0,0,,Saya tiada kaitan dengannya
Dialog: 0,0:52:08.95,0:52:12.24,teks umum,,0,0,0,,Mereka mungkin belum membetulkan petikan itu selepas kejadian itu
Dialog: 0,0:52:14.95,0:52:15.87,teks umum,,0,0,0,,Jangan bergerak
Dialog: 0,0:52:17.66,0:52:19.00,teks umum,,0,0,0,,Berdiri di sana
Dialog: 0,0:52:22.75,0:52:24.80,teks umum,,0,0,0,,Semuanya boleh runtuh
Dialog: 0,0:52:27.21,0:52:28.80,teks umum,,0,0,0,,Jadi diam sahaja
Dialog: 0,0:52:41.69,0:52:44.69,teks umum,,0,0,0,,Kenapa kamu tidak mengelak pedang?
Dialog: 0,0:52:45.73,0:52:46.78,teks umum,,0,0,0,,Ini kerana
Dialog: 0,0:52:47.28,0:52:49.74,teks umum,,0,0,0,,adakah anda perlukan alasan lain untuk menendangnya?
Dialog: 0,0:52:50.78,0:52:52.78,teks umum,,0,0,0,,saya layak menerimanya
Dialog: 0,0:52:52.87,0:52:56.45,teks umum,,0,0,0,,Lagipun, saya hancurkan hatinya
Dialog: 0,0:52:58.04,0:53:02.33,teks umum,,0,0,0,,Mematahkan hatinya pasti lebih menyakitkan daripada memukul
Dialog: 0,0:53:04.17,0:53:05.29,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:53:06.13,0:53:11.13,teks am,,0,0,0,,Awak kata ada khabar angin saya ni ayah Uka?
Dialog: 0,0:53:11.68,0:53:13.59,teks umum,,0,0,0,,Bagaimana jika saya katakan,
Dialog: 0,0:53:14.26,0:53:18.35,teks umum,,0,0,0,, bahawa saya benar-benar bapanya?
Dialog: 0,0:53:22.14,0:53:24.36,teks umum,,0,0,0,,Saya akan tinggalkan jawatan saya
Dialog: 0,0:53:25.98,0:53:28.32,teks umum,,0,0,0,,Saya akan memulakan perniagaan kecil
Dialog: 0,0:53:29.53,0:53:31.65,teks umum,,0,0,0,,dan saya akan mula berdagang dengan Ukom
Dialog: 0,0:53:32.24,0:53:34.99,teks umum,,0,0,0,,Sosnovoy Bor memerlukan satu bab
Dialog: 0,0:53:37.03,0:53:38.58,teks umum,,0,0,0,,Atau mungkin katakan,
Dialog: 0,0:53:39.50,0:53:41.54,teks umum,,0,0,0,,bahawa saya ibunya?
Dialog: 0,0:53:42.33,0:53:43.54,teks umum,,0,0,0,,Saya rasa ia akan menjadi lebih baik,
Dialog: 0,0:53:43.62,0:53:47.09,teks umum,,0,0,0,,jika saya dan Wook pergi ke kampung asal saya, tempat kami dibesarkan bersama Lady Do Hwa
Dialog: 0,0:53:49.59,0:53:52.30,teks umum,,0,0,0,,Ini tidak akan berlaku
Dialog: 0,0:53:53.93,0:53:58.43,teks umum,,0,0,0,,Wook serupa dengan Do Hwa, jadi
Dialog: 0,0:53:59.56,0:54:01.85,teks umum,,0,0,0,,dia sangat cantik
Dialog: 0,0:54:02.94,0:54:04.15,teks umum,,0,0,0,,Siapa yang akan percaya bahawa
Dialog: 0,0:54:06.44,0:54:08.02,teks umum,,0,0,0,, bahawa anda adalah ibunya?
Dialog: 0,0:54:10.23,0:54:11.24,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:54:12.03,0:54:15.87,teks umum,,0,0,0,,Jadi, jika saya ibunya, dia akan menakutkan?
Dialog: 0,0:54:16.87,0:54:19.24,teks umum,,0,0,0,,Untuk perkara itu, anda juga tidak boleh menjadi bapanya
Dialog: 0,0:54:19.33,0:54:20.83,teks umum,,0,0,0,,Sudah tentu saya boleh
Dialog: 0,0:54:21.58,0:54:24.04,contact,,0,0,0,,Saya dan Chang Gang sentiasa mengikut rentak,
Dialog: 0,0:54:28.29,0:54:30.71,teks umum,,0,0,0,,apabila ia datang kepada penampilan
Dialog: 0,0:54:33.84,0:54:34.97,teks umum,,0,0,0,,Tidak, anda kalah
Dialog: 0,0:54:35.55,0:54:37.09,italic,,0,0,0,,Anda tidak berdiri di sebelahnya
Dialog: 0,0:54:37.18,0:54:41.31,teks umum,,0,0,0,,Do Hwa cakap dia suka semua tentang awak kecuali penampilan awak
Dialog: 0,0:54:41.39,0:54:43.56,teks umum,,0,0,0,,Jangan mengada-ada!
Dialog: 0,0:54:44.77,0:54:46.60,teks umum,,0,0,0,,Anda tidak tersentak apabila dipukul dengan pedang
Dialog: 0,0:54:46.69,0:54:48.98,teks umum,,0,0,0,,Tetapi, saya rasa, mendengar bahawa anda menakutkan adalah lebih menyakitkan
Dialog: 0,0:54:49.06,0:54:50.32,teks umum,,0,0,0,,Rana
Dialog: 0,0:54:51.86,0:54:53.86,teks umum,,0,0,0,,sangat menyakitkan
Dialog: 0,0:54:53.94,0:54:55.61,teks umum,,0,0,0,,Anda tidak berpura-pura?
Dialog: 0,0:54:55.70,0:54:58.24,teks umum,,0,0,0,,Jangan bergerak, jika tidak luka akan terbuka
Dialog: 0,0:55:00.28,0:55:01.49,teks umum,,0,0,0,,Kami berkongsi
Dialog: 0,0:55:03.70,0:55:05.75,teks umum,,0,0,0,,sakit yang sama
Dialog: 0,0:55:07.25,0:55:09.84,contact,,0,0,0,,ditolak oleh orang,
Dialog: 0,0:55:09.92,0:55:12.42,italic,,0,0,0,,yang disayangi
Dialog: 0,0:55:12.92,0:55:14.34,teks umum,,0,0,0,,Jadi mari
Dialog: 0,0:55:15.59,0:55:17.01,teks umum,,0,0,0,,janganlah kita saling menyakiti
Dialog: 0,0:55:18.80,0:55:22.39,teks umum,,0,0,0,,Saya akui saya tidak mahu menyinggung perasaan awak
Dialog: 0,0:55:22.47,0:55:23.85,teks umum,,0,0,0,,Anda...
Dialog: 0,0:55:25.98,0:55:26.98,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:30.19,0:55:31.27,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:32.53,0:55:34.03,teks umum,,0,0,0,,cantik
Dialog: 0,0:55:36.40,0:55:40.45,teks umum,,0,0,0,,Anda juga, pembantu rumah Kim,
Dialog: 0,0:55:41.74,0:55:42.95,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:44.08,0:55:47.29,teks umum,,0,0,0,,cantik...saya
Dialog: 0,0:55:55.01,0:55:57.97,teks umum,,0,0,0,,Biar saya tiup pada luka awak
Dialog: 0,0:55:58.63,0:55:59.84,teks umum,,0,0,0,,Sakit
Dialog: 0,0:56:03.26,0:56:04.93,teks umum,,0,0,0,,Tepat di bawah
Dialog: 0,0:56:05.02,0:56:06.56,teks umum,,0,0,0,,Ya, ya, ada
Dialog: 0,0:56:18.11,0:56:19.53,kenangan miring,,0,0,0,,Nampaknya azimat itu ada di Chwisongru
Dialog: 0,0:56:19.61,0:56:21.62,kenangan,,0,0,0,,milik Chan Wook
Dialog: 0,0:56:22.91,0:56:23.91,kenangan,,0,0,0,,Chan Wook?
Dialog: 0,0:56:23.99,0:56:26.79,kenangan,,0,0,0,,Dia baru-baru ini dihukum kerana kehilangan azimat
Dialog: 0,0:56:26.87,0:56:30.62,kenangan,,0,0,0,,Dan saya dengar pembantu rumahnya sering pergi ke tempat itu
Dialog: 0,0:56:33.67,0:56:36.46,di sebalik tabir,,0,0,0,,Gadis dari Sosnovy Bor ini adalah pembantu rumahnya,
Dialog: 0,0:56:37.67,0:56:40.84,suara,,0,0,0,,dan dia berada di kedai pada hari itu
Dialog: 0,0:56:43.22,0:56:44.51,teks umum,,0,0,0,,Bolehkah dia
Dialog: 0,0:56:45.47,0:56:46.47,teks umum,,0,0,0,,Nak Su?
Dialog: 0,0:56:50.52,0:56:53.69,teks umum,,0,0,0,,Adakah kita masih jauh dari Jeonbugwan?
Dialog: 0,0:56:57.11,0:57:00.45,teks umum,,0,0,0,,Pada kadar ini saya akan bertukar menjadi batu
Dialog: 0,0:57:01.32,0:57:03.07,teks umum,,0,0,0,,Kami akan mempercepatkan, bersabar
Dialog: 0,0:57:03.62,0:57:05.53,teks umum,,0,0,0,,Anda tidak boleh kehilangan kawalan sekarang
Dialog: 0,0:57:06.41,0:57:09.00,teks umum,,0,0,0,,Encik, awak okay?
Dialog: 0,0:57:36.98,0:57:39.61,teks umum,,0,0,0,,Belakang
Dialog: 0,0:58:00.30,0:58:04.89,contact,,0,0,0,,Tangan awak... Anda memahami Ryusa untuk perkara itu
Dialog: 0,0:58:04.97,0:58:07.39,teks umum,,0,0,0,,masa singkat
Dialog: 0,0:58:08.76,0:58:11.98,italic,,0,0,0,,Awak pandai macam ayah awak
Dialog: 0,0:58:14.85,0:58:16.31,miring,,0,0,0,,Jin Moo daripada Jeonbugwan
Dialog: 0,0:58:16.40,0:58:20.32,teks umum,,0,0,0,,memulakan pertengkaran hanya kerana dia menyedari bahawa jawatan Gwangju tidak akan berlaku kepadanya
Dialog: 0,0:58:20.40,0:58:22.57,miring,,0,0,0,,Dia menyedari bahawa anda,
Dialog: 0,0:58:22.65,0:58:25.70,contact,,0,0,0,,anak lelaki sulung keluarga Chan, sudikah awak mengambil jawatan ini
Dialog: 0,0:58:34.29,0:58:37.17,teks umum,,0,0,0,,Luka pakcik tidak begitu dalam
Dialog: 0,0:58:37.25,0:58:38.71,teks umum,,0,0,0,,Jangan risau tentang dia
Dialog: 0,0:58:38.79,0:58:42.26,teks umum,,0,0,0,,Saya akan bercakap dengan Jin Mu
Dialog: 0,0:58:42.34,0:58:43.38,condong,,0,0,0,,Okay?
Dialog: 0,0:58:49.43,0:58:50.93,teks umum,,0,0,0,,Jaga dia
Dialog: 0,0:59:19.38,0:59:21.34,teks umum,,0,0,0,,Apabila anda ada, Uk sentiasa dalam bahaya
Dialog: 0,0:59:23.01,0:59:24.67,teks umum,,0,0,0,,Anda bersamanya ketika dia minum racun
Dialog: 0,0:59:24.76,0:59:27.59,teks umum,,0,0,0,,dan ketika dia bergelut dengan Putera Mahkota
Dialog: 0,0:59:29.80,0:59:33.39,teks umum,,0,0,0,,Jadi, adakah anda mahu memisahkan kami?
Dialog: 0,0:59:33.47,0:59:34.68,teks umum,,0,0,0,,Saya tidak boleh melakukan ini
Dialog: 0,0:59:38.02,0:59:40.23,teks umum,,0,0,0,,Dia sentiasa mendapat apa yang dia mahu
Dialog: 0,0:59:40.86,0:59:42.65,teks umum,,0,0,0,,Dan anda mempertaruhkan nyawa anda untuk menyelamatkannya
Dialog: 0,0:59:49.32,0:59:51.20,teks umum,,0,0,0,,Ini adalah pedang ayahnya
Dialog: 0,0:59:51.28,0:59:52.99,teks umum,,0,0,0,,Ambil
Dialog: 0,1:00:21.44,1:00:23.48,teks umum,,0,0,0,,Saya tidak boleh melihat ini lagi!
Dialog: 0,1:00:23.57,1:00:25.23,teks umum,,0,0,0,,Berapa lama anda akan berasa kasihan pada diri sendiri?
Dialog: 0,1:00:32.20,1:00:33.41,contact,,0,0,0,,Bangun
Dialog: 0,1:00:45.67,1:00:48.84,teks umum,,0,0,0,,Anda menerima tenaga yang besar dan dapat mengatasinya
Dialog: 0,1:00:49.59,1:00:53.39,italic,,0,0,0,,Orang ramai memerlukan 10 tahun untuk melakukan ini, anda mengambil masa 10 hari
Dialog: 0,1:00:53.47,1:00:55.47,teks umum,,0,0,0,,- Latihan kami...\N- Lupakan saja
Dialog: 0,1:00:55.56,1:00:56.97,teks umum,,0,0,0,,Saya tidak mahu!
Dialog: 0,1:00:59.98,1:01:01.69,teks umum,,0,0,0,,Menolak kerana beberapa perkataan daripada Park Jin?
Dialog: 0,1:01:02.44,1:01:04.52,contact,,0,0,0,,Jadi itu bukan kekuatan, tetapi kebodohan
Dialog: 0,1:01:04.61,1:01:07.48,teks umum,,0,0,0,,Tidak hairanlah anda sangat terdesak. Anda terlalu lemah!
Dialog: 0,1:01:07.57,1:01:10.36,teks umum,,0,0,0,,Ya, saya seorang yang lemah, jadi saya tidak akan melakukan apa-apa
Dialog: 0,1:01:10.45,1:01:11.91,teks umum,,0,0,0,,Jadi diam sahaja
Dialog: 0,1:01:13.70,1:01:15.33,teks umum,,0,0,0,,Tutup mulut dan jangan ganggu saya
Dialog: 0,1:01:23.17,1:01:25.38,teks umum,,0,0,0,,Saya tidak memerlukan pelajar yang tidak aktif
Dialog: 0,1:01:29.72,1:01:31.30,teks umum,,0,0,0,,Kalau begitu jangan jadi guru saya,
Dialog: 0,1:01:32.43,1:01:33.93,teks umum,,0,0,0,,anda akan menjadi pembantu rumah saya
Dialog: 0,1:01:35.01,1:01:36.93,teks umum,,0,0,0,,Jika anda membuat saya marah lagi, saya akan menjualnya
Dialog: 0,1:02:16.09,1:02:17.22,teks umum,,0,0,0,,En.
Dialog: 0,1:02:19.43,1:02:24.06,teks umum,,0,0,0,,Pemiliknya sangat risau sehingga dia tidak minum air pun
Dialog: 0,1:02:24.14,1:02:26.10,teks umum,,0,0,0,,Tolong tolong
Dialog: 0,1:02:26.19,1:02:27.77,teks umum,,0,0,0,,Tetapi apa yang boleh saya lakukan?
Dialog: 0,1:02:28.44,1:02:30.28,teks umum,,0,0,0,,Lebih baik kita tunggu pakcik selesaikan semuanya
Dialog: 0,1:02:30.36,1:02:33.61,teks umum,,0,0,0,,Cikgu Ho Yeom berkata dia akan membantu
Dialog: 0,1:02:33.70,1:02:37.41,teks umum,,0,0,0,,Minta dia berjumpa dengan Jin Mu dengan cepat dan menamatkan perkara ini
Dialog: 0,1:02:42.16,1:02:46.83,teks umum,,0,0,0,,Saya datang kepada anda kerana saya bimbang betapa kecilnya anda
Dialog: 0,1:02:46.92,1:02:49.34,teks umum,,0,0,0,,tidak menambah masalah
Dialog: 0,1:02:49.42,1:02:53.80,teks umum,,0,0,0,,Bagaimanakah ancaman terhadap nyawa Putera Mahkota boleh menjadi perkara kecil?
Dialog: 0,1:02:56.34,1:02:59.51,teks umum,,0,0,0,,Jadi ketua kami mengurungnya
Dialog: 0,1:03:00.14,1:03:02.89,teks umum,,0,0,0,,Hutan pain akan menghukumnya
Dialog: 0,1:03:02.98,1:03:05.81,teks umum,,0,0,0,,Apabila bercakap mengenai keluarga diraja, Hutan Pine tidak sepatutnya mengganggu
Dialog: 0,1:03:06.52,1:03:10.27,teks umum,,0,0,0,,Ini adalah tanggungjawab Jeonbugwan, kami akan menghukum dia sendiri
Dialog: 0,1:03:11.02,1:03:13.15,teks umum,,0,0,0,,Dan apakah yang akan anda lakukan?
Dialog: 0,1:03:13.24,1:03:17.07,teks umum,,0,0,0,,Dia mengancam Putera Mahkota, dia harus dihukum bunuh
Dialog: 0,1:03:19.28,1:03:23.16,teks umum,,0,0,0,,Tetapi kita tidak boleh membunuh anak lelaki tunggal Gwangju
Dialog: 0,1:03:23.83,1:03:27.67,teks umum,,0,0,0,,Jadi mari kita potong tangan yang mengacukan pedang kepada putera raja
Dialog: 0,1:03:28.33,1:03:30.25,contact,,0,0,0,,Potong tangan awak?
Dialog: 0,1:03:30.34,1:03:31.88,teks umum,,0,0,0,,Anda mungkin tersinggung dengan,
Dialog: 0,1:03:31.96,1:03:34.21,contact,,0,0,0,,bahawa pelajar anda tidak dapat mengalahkan Uka,
Dialog: 0,1:03:34.30,1:03:37.01,teks umum,,0,0,0,,pintu tenaga yang dibuka hanya sepuluh hari yang lalu
Dialog: 0,1:03:37.09,1:03:39.89,contact,,0,0,0,,Bodoh, saya di sini cuba menyelamatkan reputasi awak dan putera raja
Dialog: 0,1:03:39.97,1:03:42.22,teks umum,,0,0,0,,Saya akan bersikap baik
Dialog: 0,1:03:42.31,1:03:43.93,teks umum,,0,0,0,,Tetapi awak benar-benar gila!
Dialog: 0,1:03:44.02,1:03:47.77,teks umum,,0,0,0,,Biar Jeongbugwan tentukan sama ada saya gila atau Chan Wook
Dialog: 0,1:03:47.85,1:03:50.90,teks umum,,0,0,0,,- Bangsat...\N- Cikgu, tenang
Dialog: 0,1:03:52.65,1:03:55.32,teks umum,,0,0,0,,Pergaduhan mereka adalah atas persetujuan bersama
Dialog: 0,1:03:55.90,1:03:58.28,teks umum,,0,0,0,,Pembantu rumah Uka dipersalahkan atas apa yang berlaku
Dialog: 0,1:04:01.24,1:04:03.04,teks umum,,0,0,0,,Pertarungan itu adil
Dialog: 0,1:04:04.24,1:04:08.92,teks umum,,0,0,0,,Jika anda tidak percaya kami, biarkan mereka berlawan lagi
Dialog: 0,1:04:13.17,1:04:16.76,teks umum,,0,0,0,,Sekali lagi? Idea yang bagus
Dialog: 0,1:04:18.26,1:04:21.26,teks umum,,0,0,0,,Oleh kerana anda mendakwa bahawa Uk tidak mengancam Putera Mahkota,
Dialog: 0,1:04:21.35,1:04:22.93,teks umum,,0,0,0,,dan perjuangan itu adil,
Dialog: 0,1:04:23.81,1:04:26.77,teks umum,,0,0,0,,biar perlawanan rasmi berlangsung
Dialog: 0,1:04:27.39,1:04:29.69,teks umum,,0,0,0,,Pertarungan antara Uk dan putera raja?
Dialog: 0,1:04:30.27,1:04:33.23,teks umum,,0,0,0,,Jika anda tidak boleh menerima ini, berikan Uka kepada kami
Dialog: 0,1:04:33.32,1:04:34.73,teks umum,,0,0,0,,Tetapi jika anda bersetuju,
Dialog: 0,1:04:34.82,1:04:39.24,teks umum,,0,0,0,,kami tidak akan bertanggungjawab sesiapa pun, walaupun salah seorang daripada mereka meninggal dunia
Dialog: 0,1:04:40.11,1:04:42.49,teks umum,,0,0,0,,Sesuai dengan adat ahli sihir Deho
Dialog: 0,1:04:53.42,1:04:56.21,teks umum,,0,0,0,,Kami datang untuk memikirkan segala-galanya, dan apakah keputusan akhirnya?
Dialog: 0,1:04:56.80,1:05:00.97,teks umum,,0,0,0,,Ular bawah airlah yang mengalahkan saya
Dialog: 0,1:05:01.05,1:05:04.05,teks umum,,0,0,0,,Uk akan mati dalam pertempuran rasmi. Apa yang patut kita buat?
Dialog: 0,1:05:04.14,1:05:05.43,teks umum,,0,0,0,,Jangan risau
Dialog: 0,1:05:05.51,1:05:07.85,teks umum,,0,0,0,,Putera Mahkota tidak akan menerima cabaran
Dialog: 0,1:05:08.93,1:05:11.48,teks umum,,0,0,0,,Sejak Master So Kyung mengasaskan Hutan Pine,
Dialog: 0,1:05:11.56,1:05:14.94,teks umum,,0,0,0,,keluarga diraja dan ahli silap mata tidak bertanding
Dialog: 0,1:05:15.02,1:05:16.53,teks umum,,0,0,0,,Kedua-dua belah pihak mematuhi
Dialog: 0,1:05:16.61,1:05:21.49,teks umum,,0,0,0,, peraturan yang tidak dinyatakan ini, supaya tidak membazir tenaga
Dialog: 0,1:05:22.07,1:05:23.16,teks umum,,0,0,0,,Tidak boleh,
Dialog: 0,1:05:23.24,1:05:26.62,teks umum,,0,0,0,,untuk Putera Mahkota melanggar peraturan ini dan menentang Uka
Dialog: 0,1:05:35.63,1:05:37.34,teks umum,,0,0,0,,Sila terima cabaran
Dialog: 0,1:05:38.51,1:05:42.72,teks umum,,0,0,0,,Saya tidak faham kenapa saya perlu menentang Sosnovy Bor kerana si bodoh ini
Dialog: 0,1:05:42.80,1:05:46.81,teks umum,,0,0,0,,Mereka sendiri yang membuatnya supaya mereka tidak menuding jari kepada kita
Dialog: 0,1:05:46.89,1:05:51.18,teks umum,,0,0,0,,Tunjukkan Sosnovy Bor betapa kuatnya anda
Dialog: 0,1:06:11.33,1:06:13.42,teks am,,0,0,0,,Pengawal Diraja dan penduduk Jeonbugwan
Dialog: 0,1:06:14.00,1:06:15.17,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:06:15.79,1:06:17.79,teks umum,,0,0,0,,Diberkatilah tuan Ho
Dialog: 0,1:06:18.59,1:06:20.55,teks umum,,0,0,0,,Dia berkata ia tidak akan berlaku
Dialog: 0,1:06:20.63,1:06:22.30,condong,,0,0,0,,Tetapi lihat
Dialog: 0,1:06:23.18,1:06:24.72,teks umum,,0,0,0,,Apa yang perlu kita lakukan sekarang?
Dialog: 0,1:06:27.68,1:06:30.56,teks umum,,0,0,0,,Saya tidak faham mengapa mereka berada di sini?
Dialog: 0,1:06:30.64,1:06:34.31,teks umum,,0,0,0,,Saya baru sahaja hendak memberitahu anda
Dialog: 0,1:06:34.39,1:06:36.52,teks umum,,0,0,0,,Tetapi Jin Mu mendahului saya
Dialog: 0,1:06:37.94,1:06:39.11,teks umum,,0,0,0,,Jin Mu?
Dialog: 0,1:06:39.90,1:06:42.24,teks umum,,0,0,0,,Adakah sesuatu berlaku lagi?
Dialog: 0,1:06:44.15,1:06:45.57,teks umum,,0,0,0,,Biar mereka semua!
Dialog: 0,1:06:45.66,1:06:47.49,teks umum,,0,0,0,,Putera Mahkota
Dialog: 0,1:06:47.57,1:06:50.24,teks umum,,0,0,0,,cabar Chan Wook untuk bertanding
Dialog: 0,1:06:52.50,1:06:56.46,teks umum,,0,0,0,,Timbalan Gwangju berkata bahawa kita harus menghantar Chang Wook kepada Jeonbugwan,
Dialog: 0,1:06:56.54,1:06:58.96,teks umum,,0,0,0,,jika dia menolak pergaduhan
Dialog: 0,1:06:59.54,1:07:02.46,teks umum,,0,0,0,,Chan Wook sudah dikunci di sini
Dialog: 0,1:07:04.30,1:07:07.80,teks umum,,0,0,0,,Hantar kepada Jeonbugwan? Untuk apa?
Dialog: 0,1:07:07.89,1:07:09.60,teks umum,,0,0,0,,Tanya Cikgu Ho
Dialog: 0,1:07:10.39,1:07:13.68,teks umum,,0,0,0,,Saya diberitahu bahawa anda bersetuju dengan syarat ini
Dialog: 0,1:07:22.48,1:07:25.45,teks umum,,0,0,0,,Uk, bangun. Awak perlu lari dari sini
Dialog: 0,1:07:26.20,1:07:27.28,teks umum,,0,0,0,,Ada apa?
Dialog: 0,1:07:27.36,1:07:30.74,teks umum,,0,0,0,,Tiada masa untuk menerangkan. Jika kami tidak cepat, anda akan kehilangan tangan anda
Dialog: 0,1:07:31.66,1:07:33.41,teks umum,,0,0,0,,Anda mungkin mati
Dialog: 0,1:07:34.00,1:07:35.29,teks umum,,0,0,0,,- Apa?\N- Hos
Dialog: 0,1:07:35.87,1:07:37.42,teks umum,,0,0,0,,Semuanya menjadi lebih serius
Dialog: 0,1:07:37.50,1:07:40.00,teks umum,,0,0,0,,Tinggal di sini, maka anda akan kehilangan tangan atau nyawa anda
Dialog: 0,1:07:41.04,1:07:42.50,teks umum,,0,0,0,,Adakah anda akan duduk seperti itu?
Dialog: 0,1:07:53.85,1:07:58.40,teks umum,,0,0,0,,Saya akan pergi bersama Uk ke istana dan berjumpa dengan Putera Mahkota
Dialog: 0,1:07:58.98,1:08:00.94,teks umum,,0,0,0,,UK akan tiba tidak lama lagi
Dialog: 0,1:08:05.53,1:08:06.49,teks umum,,0,0,0,,Di manakah Uk?
Dialog: 0,1:08:06.57,1:08:09.82,teks umum,,0,0,0,,Dia tiada dalam bilik rahsia. Saya rasa dia melarikan diri
Dialog: 0,1:08:10.53,1:08:11.53,teks umum,,0,0,0,,Apa?
Dialog: 0,1:08:18.71,1:08:21.17,teks umum,,0,0,0,,Apabila tersepit di antara batu dan tempat yang keras,
Dialog: 0,1:08:21.25,1:08:23.21,teks umum,,0,0,0,,melarikan diri adalah satu-satunya jalan keluar
Dialog: 0,1:08:31.18,1:08:34.10,teks umum,,0,0,0,,Dia berada di sini sepanjang masa. Hanya pembantu rumahnya sahaja yang keluar masuk
Dialog: 0,1:08:34.68,1:08:36.27,teks umum,,0,0,0,,Saya tidak faham bagaimana dia melarikan diri
Dialog: 0,1:08:38.89,1:08:40.85,teks umum,,0,0,0,,Di manakah Yul dan Dan Gu?
Dialog: 0,1:08:49.61,1:08:53.24,teks umum,,0,0,0,,Bab akan menyelesaikan segala-galanya. Tundukkan kepala anda sehingga keadaan menjadi tenang
Dialog: 0,1:08:54.58,1:08:57.33,teks umum,,0,0,0,,Moo Dok, jaga dia
Dialog: 0,1:08:58.25,1:09:01.25,teks umum,,0,0,0,,Adakah anda pasti kami tidak memerlukan anda?
Dialog: 0,1:09:01.33,1:09:03.84,teks umum,,0,0,0,,Ya, kita akan pergi ke kampung halaman saya
Dialog: 0,1:09:03.92,1:09:05.88,teks umum,,0,0,0,,Kampung Sari, ya?
Dialog: 0,1:09:05.96,1:09:08.80,teks umum,,0,0,0,,Tinggal di sana. Kami akan datang untuk anda
Dialog: 0,1:09:14.89,1:09:17.10,teks umum,,0,0,0,,Anda meletakkan dia dalam bahaya lagi
Dialog: 0,1:09:20.35,1:09:22.73,teks umum,,0,0,0,,Dan dia akan mendapat apa yang dia mahukan semula
Dialog: 0,1:09:50.01,1:09:51.34,teks umum,,0,0,0,,Pertarungan akan berlaku
Dialog: 0,1:09:52.63,1:09:56.43,teks umum,,0,0,0,,pada pertengahan bulan depan
Dialog: 0,1:09:59.89,1:10:01.23,teks umum,,0,0,0,,Tetapi jika
Dialog: 0,1:10:02.10,1:10:03.98,teks umum,,0,0,0,,dia tidak akan muncul pada hari itu,
Dialog: 0,1:10:05.81,1:10:07.82,teks umum,,0,0,0,,anggap ini sebagai kekalahan
Dialog: 0,1:10:07.90,1:10:10.36,teks umum,,0,0,0,,Ini adalah pelarian, bukan kekalahan
Dialog: 0,1:10:12.45,1:10:15.12,teks umum,,0,0,0,,Saya rasa pengecut seperti itu harus dihukum
Dialog: 0,1:10:17.70,1:10:19.33,teks umum,,0,0,0,,Saya bersetuju dengannya
Dialog: 0,1:10:19.95,1:10:22.25,teks umum,,0,0,0,,Jika Chang Wook tidak kembali,
Dialog: 0,1:10:22.83,1:10:25.13,teks umum,,0,0,0,,dia akan dilucutkan hak untuk menjadi
Dialog: 0,1:10:26.08,1:10:27.17,teks umum,,0,0,0,,Gwangju seterusnya
Dialog: 0,1:10:35.09,1:10:37.35,teks umum,,0,0,0,,Baiklah Tuanku
Dialog: 0,1:10:54.95,1:10:57.03,teks umum,,0,0,0,,Mengapa awak mengambilnya jika kami melarikan diri?
Dialog: 0,1:10:58.37,1:10:59.78,teks umum,,0,0,0,,Untuk latihan
Dialog: 0,1:10:59.87,1:11:01.08,teks umum,,0,0,0,,Latihan?
Dialog: 0,1:11:01.16,1:11:02.45,teks umum,,0,0,0,,Adakah kita akan berlatih?
Dialog: 0,1:11:04.04,1:11:05.08,teks umum,,0,0,0,,Adakah anda di sebalik ini?
Dialog: 0,1:11:05.17,1:11:06.62,teks umum,,0,0,0,,Sumbangan
Dialog: 0,1:11:07.13,1:11:09.96,teks umum,,0,0,0,,Akhirnya anda terharu apabila saya berkata anda berada dalam bahaya
Dialog: 0,1:11:12.05,1:11:13.30,teks umum,,0,0,0,,Apa?
Dialog: 0,1:11:13.38,1:11:15.47,teks umum,,0,0,0,,Saya tidak memerlukan pelajar yang tidak membuat kemajuan
Dialog: 0,1:11:16.26,1:11:18.85,teks umum,,0,0,0,,Mati sahaja jika anda tidak akan melakukan apa-apa
Dialog: 0,1:11:18.93,1:11:20.76,teks umum,,0,0,0,,Awak racun saya lagi,
Dialog: 0,1:11:21.93,1:11:23.64,teks umum,,0,0,0,,tuanku yang gila
Dialog: 0,1:11:24.31,1:11:25.35,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:11:26.14,1:11:29.52,teks umum,,0,0,0,,Kami akan pergi ke tempat saya berlatih. Bersedialah
Dialog: 0,1:11:30.15,1:11:33.61,teks umum,,0,0,0,,Tidak akan ada mandi air panas di sana
Dialog: 0,1:11:33.69,1:11:38.28,teks umum,,0,0,0,,Tiada katil, tiada makanan kegemaran anda
Dialog: 0,1:11:40.45,1:11:43.41,teks am,,0,0,0,,Adakah Kampung Sari begitu menakutkan?
Dialog: 0,1:11:44.25,1:11:46.87,teks umum,,0,0,0,,Moo Dok tinggal di Sari
Dialog: 0,1:11:46.96,1:11:48.92,teks umum,,0,0,0,,Nak Su dari tempat yang sama
Dialog: 0,1:11:50.00,1:11:51.38,teks umum,,0,0,0,,dari Danhyanggok
Dialog: 0,1:11:53.76,1:11:55.47,teks umum,,0,0,0,,Ke situlah kita menuju
Dialog: 0,1:12:51.94,1:12:53.73,pratonton,,0,0,0,,Apakah semua ini?
Dialog: 0,1:12:53.82,1:12:54.94,pratonton,,0,0,0,,Moo Dok!
Dialog: 0,1:12:55.02,1:12:58.03,pratonton,,0,0,0,,Saya hampir mengambil ini untuk cubaan menculik saya dan tinggal bersama saya
Dialog: 0,1:12:58.11,1:12:59.78,pratonton,,0,0,0,,bertopengkan latihan
Dialog: 0,1:12:59.86,1:13:02.82,pratonton,,0,0,0,,Untuk pengetahuan anda, saya boleh mengajar anda secara berbeza
Dialog: 0,1:13:02.91,1:13:05.62,pratonton,,0,0,0,,Gadis sebegitulah yang paling berbahaya
Dialog: 0,1:13:05.70,1:13:07.20,pratonton,,0,0,0,,Saya tidak suka gula-gula
Dialog: 0,1:13:07.29,1:13:09.50,pratonton,,0,0,0,,Nah, sila, jika anda tidak menyukainya
Dialog: 0,1:13:09.58,1:13:12.92,pratonton,,0,0,0,,- Yul sedang masak nasi bersama Moo Deok!\N- Saya dah cakap...
Dialog: 0,1:13:13.00,1:13:16.92,pratonton,,0,0,0,,Bagaimanakah anda boleh mengajar orang lain apabila pelajar anda berada di sini?
Dialog: 0,1:13:17.01,1:13:20.09,pratonton,,0,0,0,,Bagaimana jika kita merampas haknya untuk dipanggil ahli silap mata?
Dialog: 0,1:13:20.17,1:13:23.05,pratonton,,0,0,0,,Ke mana sahaja dia pergi, dia tidak dapat mencari guru
Dialog: 0,1:13:23.14,1:13:26.31,pratonton,,0,0,0,,Jiwa yang menakjubkan berhijrah ke dalam badan ini
Dialog: 0,1:13:26.39,1:13:27.35,pratonton,,0,0,0,,Moo Dok, lari!
Dialog: 0,1:13:27.43,1:13:28.73,pratonton,,0,0,0,,Saya tidak mahu berbuat apa-apa...
Dialog: 0,1:13:28.81,1:13:30.31,pratonton,,0,0,0,,tetapi ada sesuatu yang mengganggu saya
Dialog: 0,0:35:38.58,0:35:40.58,pratonton,,0,0,0,,

Ulasan: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Editor Beta: {\c&HFFF4C5&} Sana
