Dialog: 0,0:02:47.09,0:02:52.09,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.09,0:02:57.09,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.09,0:03:02.09,nicks,,0,0,0,,Penterjemah penaip:{\c&HFFF4C5&} Ria_Lee, Mina_Mi
Dialog: 0,0:00:44.06,0:00:45.27,teks umum,,0,0,0,,Terima kasih kerana menunjukkan segala-galanya
Dialog: 0,0:00:45.36,0:00:47.57,teks umum,,0,0,0,,- Menunggu keputusan anda\N- Ya
Dialog: 0,0:00:51.32,0:00:55.66,teks umum,,0,0,0,,Tempat ini betul-betul di antara Jinyovon dan Sosnovy Bor
Dialog: 0,0:00:56.37,0:00:58.62,teks umum,,0,0,0,,Jubin dan lantai bagus
Dialog: 0,0:00:58.70,0:01:01.29,teks umum,,0,0,0,,Ini adalah pilihan terbaik yang pernah kita lihat
Dialog: 0,0:01:01.37,0:01:04.25,teks umum,,0,0,0,,Tidakkah anda rasa terdapat terlalu banyak bilik?
Dialog: 0,0:01:04.34,0:01:06.09,teks umum,,0,0,0,,Mereka akan mendapat anak tidak lama lagi
Dialog: 0,0:01:06.17,0:01:09.22,teks umum,,0,0,0,,Anak lelaki akan mengambil nama keluarga Pak dan mengetuai Sosnovy Bor
Dialog: 0,0:01:09.30,0:01:12.89,teks umum,,0,0,0,,Anak perempuan akan mengambil nama keluarga Jin dan mengetuai Jinyeowon
Dialog: 0,0:01:12.97,0:01:14.35,teks umum,,0,0,0,,Mereka sepatutnya melahirkan lebih banyak
Dialog: 0,0:01:15.10,0:01:18.93,teks umum,,0,0,0,,Baguslah saya minta awak sertai saya
Dialog: 0,0:01:19.02,0:01:22.81,teks umum,,0,0,0,,Saya akan pilih rumah yang awak suka
Dialog: 0,0:01:27.69,0:01:28.73,teks umum,,0,0,0,,Sejujurnya,
Dialog: 0,0:01:29.57,0:01:33.57,teks umum,,0,0,0,,Saya tidak mahu tinggal di rumah besar
Dialog: 0,0:01:34.62,0:01:37.08,teks umum,,0,0,0,,Saya suka rumah yang selesa,
Dialog: 0,0:01:37.58,0:01:41.41,teks umum,,0,0,0,,di mana saya dan suami akan hidup bahagia
Dialog: 0,0:01:43.12,0:01:46.75,teks umum,,0,0,0,,Dengan taman kecil di mana anda boleh menanam bunga kegemaran anda
Dialog: 0,0:01:47.80,0:01:50.84,teks umum,,0,0,0,,Anda sangat suka bunga
Dialog: 0,0:01:53.22,0:01:54.72,teks umum,,0,0,0,,Mungkin kita patut tanam balsam?
Dialog: 0,0:01:55.43,0:01:58.97,teks umum,,0,0,0,,Saya dan suami akan melukis kuku dengan cat daripadanya*
Dialog: 0,0:01:55.43,0:01:58.97,nota,,0,0,0,,*akar balsam dihancurkan dan digunakan untuk mengecat kuku dan hujung jari dengan warna kuning
Dialog: 0,0:02:01.18,0:02:04.69,teks umum,,0,0,0,,Alangkah baiknya hidup seperti ini
Dialog: 0,0:02:06.69,0:02:09.44,teks umum,,0,0,0,,Saya akan cari awak
Dialog: 0,0:02:10.94,0:02:12.28,teks umum,,0,0,0,,rumah sedemikian
Dialog: 0,0:02:18.28,0:02:19.45,teks umum,,0,0,0,,Apa?
Dialog: 0,0:02:19.54,0:02:23.00,teks umum,,0,0,0,,Saya akan beli rumah dengan taman kecil
Dialog: 0,0:02:23.96,0:02:25.75,teks umum,,0,0,0,,dan saya akan tanam balsam
Dialog: 0,0:02:26.58,0:02:29.17,teks umum,,0,0,0,,Ini akan menjadi hadiah saya
Dialog: 0,0:02:30.59,0:02:31.67,teks umum,,0,0,0,,untuk perkahwinan anda
Dialog: 0,0:02:35.76,0:02:37.43,teks umum,,0,0,0,,Hadiah?
Dialog: 0,0:02:37.51,0:02:41.31,teks umum,,0,0,0,,Cikgu Li sangat menyayangi Sapsari
Dialog: 0,0:02:42.02,0:02:45.56,teks umum,,0,0,0,,Saya akan berikan anda seekor anak anjing juga
Dialog: 0,0:02:46.15,0:02:51.03,teks umum,,0,0,0,,Adakah awak kahwinkan saya dengan Cikgu Li sekarang?
Dialog: 0,0:02:51.11,0:02:56.24,teks umum,,0,0,0,,Awak kata awak gembira hanya melihat dia
Dialog: 0,0:02:57.74,0:03:02.20,teks umum,,0,0,0,,Adakah anda fikir saya gembira melihat Cikgu Li?
Dialog: 0,0:03:03.12,0:03:07.04,teks umum,,0,0,0,,Saya tidaklah bodoh sepenuhnya
Dialog: 0,0:03:07.12,0:03:09.38,teks umum,,0,0,0,,Iaitu, anda akan memberi saya sebuah rumah,
Dialog: 0,0:03:09.46,0:03:12.84,teks am,,0,0,0,,kalau saya kahwin dengan Cikgu Li?
Dialog: 0,0:03:13.46,0:03:17.89,teks umum,,0,0,0,,Saya ada wang untuk hadiah sedemikian
Dialog: 0,0:03:18.93,0:03:20.01,teks umum,,0,0,0,,Anda tahu,
Dialog: 0,0:03:20.60,0:03:23.89,teks umum,,0,0,0,,beli saya rumah dengan seratus bilik
Dialog: 0,0:03:24.48,0:03:25.64,teks umum,,0,0,0,,Seratus?
Dialog: 0,0:03:27.60,0:03:30.11,teks umum,,0,0,0,,Jadi anda suka rumah besar?
Dialog: 0,0:03:32.40,0:03:34.65,teks umum,,0,0,0,,Namun, saya agak lambat akal
Dialog: 0,0:03:35.61,0:03:36.95,teks umum,,0,0,0,,Adakah anda seorang yang bodoh?
Dialog: 0,0:03:38.03,0:03:39.95,teks umum,,0,0,0,,Perasaan untuk awak membuatkan saya gembira
Dialog: 0,0:03:51.63,0:03:52.88,teks umum,,0,0,0,,Saya harap
Dialog: 0,0:03:53.92,0:03:56.09,teks umum,,0,0,0,,anda akan faham lambat laun
Dialog: 0,0:03:56.17,0:04:00.55,teks umum,,0,0,0,,Memasak hidangan kegemaran anda, menjahit pakaian anda
Dialog: 0,0:04:00.64,0:04:05.14,teks umum,,0,0,0,,Walaupun awak lambat, saya harap suatu hari nanti
Dialog: 0,0:04:06.43,0:04:07.60,teks umum,,0,0,0,,akan menghubungi anda
Dialog: 0,0:04:08.56,0:04:11.94,teks umum,,0,0,0,,Adakah anda menganggap saya orang lain?
Dialog: 0,0:04:12.73,0:04:14.73,teks umum,,0,0,0,,Beri saya rumah untuk perkahwinan saya dengan orang lain?
Dialog: 0,0:04:15.90,0:04:17.24,teks umum,,0,0,0,,Kim Gadis...
Dialog: 0,0:04:18.45,0:04:21.57,teks umum,,0,0,0,,Saya tidak faham...
Dialog: 0,0:04:21.66,0:04:22.66,teks umum,,0,0,0,,Diam!
Dialog: 0,0:04:24.28,0:04:27.37,teks umum,,0,0,0,,Memilih rumah bersama,
Dialog: 0,0:04:28.58,0:04:31.25,teks umum,,0,0,0,,Saya membayangkan bagaimana kami akan berkahwin,
Dialog: 0,0:04:32.71,0:04:35.17,teks umum,,0,0,0,,bagaimana kita akan melukis kuku satu sama lain dalam cinta
Dialog: 0,0:04:35.25,0:04:37.63,teks umum,,0,0,0,,bunga balsam,
Dialog: 0,0:04:37.72,0:04:40.09,teks umum,,0,0,0,,siapa yang memetik di taman
Dialog: 0,0:04:42.55,0:04:44.60,teks umum,,0,0,0,,Bercinta?
Dialog: 0,0:04:44.68,0:04:47.60,teks umum,,0,0,0,,Ya! jatuh cinta!
Dialog: 0,0:04:47.68,0:04:48.64,teks umum,,0,0,0,,Cinta lobak merah!
Dialog: 0,0:04:50.98,0:04:52.73,teks umum,,0,0,0,,In love!
Dialog: 0,0:04:52.81,0:04:55.27,teks umum,,0,0,0,,Ya! Tepat sekali! jatuh cinta!
Dialog: 0,0:04:56.48,0:05:00.45,teks umum,,0,0,0,,Gambar ini terpampang jelas di hadapan mata saya
Dialog: 0,0:05:00.53,0:05:01.61,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:05:01.70,0:05:03.20,teks umum,,0,0,0,,Anda menghancurkan impian saya
Dialog: 0,0:05:03.28,0:05:05.99,teks umum,,0,0,0,,Saya tidak akan mengharapkan apa-apa lagi daripada anda
Dialog: 0,0:05:06.91,0:05:10.08,teks umum,,0,0,0,,Tetapi saya akan menerima rumah dengan seratus bilik!
Dialog: 0,0:05:11.71,0:05:12.75,teks umum,,0,0,0,,Saya...
Dialog: 0,0:05:12.83,0:05:15.75,teks umum,,0,0,0,,Kim Gadis!
Dialog: 0,0:05:18.51,0:05:19.80,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:05:22.22,0:05:23.59,teks umum,,0,0,0,,Dalam cinta...
Dialog: 0,0:05:24.51,0:05:28.02,teks umum,,0,0,0,,Saya memusnahkan segala-galanya
Dialog: 0,0:05:30.39,0:05:31.56,teks umum,,0,0,0,,Bodoh
Dialog: 0,0:05:35.15,0:05:36.44,teks umum,,0,0,0,,Cemerlang
Dialog: 0,0:05:36.52,0:05:39.49,teks umum,,0,0,0,,Saya akan berkahwin dengan seseorang
Dialog: 0,0:05:39.57,0:05:41.74,teks umum,,0,0,0,,Biar dia beri saya rumah!
Dialog: 0,0:05:43.28,0:05:44.91,teks umum,,0,0,0,,Ada anda
Dialog: 0,0:05:45.99,0:05:48.37,teks umum,,0,0,0,,Hamba Kim, adakah kamu menangis?
Dialog: 0,0:05:48.45,0:05:51.37,teks umum,,0,0,0,,No. Kenapa saya perlu menangis?
Dialog: 0,0:05:53.42,0:05:55.42,teks umum,,0,0,0,,Adakah anda menangis? Siapa yang marah?
Dialog: 0,0:05:55.50,0:05:58.13,teks umum,,0,0,0,,Air mata awak menghancurkan hati saya
Dialog: 0,0:05:59.17,0:06:00.76,teks umum,,0,0,0,,Saya hanya cemburu,
Dialog: 0,0:06:00.84,0:06:04.93,teks umum,,0,0,0,,bahawa Encik Dan Gu akan berkahwin sebelum anda
Dialog: 0,0:06:05.51,0:06:07.76,teks umum,,0,0,0,,Saya cemburu dan sedih
Dialog: 0,0:06:07.85,0:06:10.89,teks umum,,0,0,0,,Jangan bersedih. Saya akan berkahwin tidak lama lagi
Dialog: 0,0:06:11.48,0:06:12.31,teks umum,,0,0,0,,Apa?
Dialog: 0,0:06:13.10,0:06:16.65,teks umum,,0,0,0,,Adakah anda akhirnya memutuskan untuk berkahwin dengan seseorang?
Dialog: 0,0:06:16.73,0:06:20.69,teks umum,,0,0,0,,Ya, jadi tidak ada sebab untuk iri hati dan sedih
Dialog: 0,0:06:20.78,0:06:21.90,teks umum,,0,0,0,,Kemudian...
Dialog: 0,0:06:21.99,0:06:24.36,teks umum,,0,0,0,,Maka ini harus ditinggalkan
Dialog: 0,0:06:25.57,0:06:26.99,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:06:27.07,0:06:30.20,teks umum,,0,0,0,,Hadiah untuk perkahwinan awak yang saya simpan
Dialog: 0,0:06:30.29,0:06:33.21,teks umum,,0,0,0,,Saya sedang berfikir untuk memberikannya kepada Encik Dan Gu dan Cik Cho Yeon
Dialog: 0,0:06:33.29,0:06:35.50,teks umum,,0,0,0,,Kenapa berikan kepada mereka? Satu pembaziran
Dialog: 0,0:06:35.58,0:06:36.58,teks umum,,0,0,0,,Ya?
Dialog: 0,0:06:36.67,0:06:39.09,teks umum,,0,0,0,,Berikan kepada Puan Ho?
Dialog: 0,0:06:40.50,0:06:42.26,teks umum,,0,0,0,,Mengapa dia memerlukannya?
Dialog: 0,0:06:42.84,0:06:44.22,teks umum,,0,0,0,,Awak kata awak nak kahwin
Dialog: 0,0:06:44.30,0:06:45.88,teks umum,,0,0,0,,Saya tahu segala-galanya
Dialog: 0,0:06:45.97,0:06:47.97,teks umum,,0,0,0,,Dia adalah telur awak
Dialog: 0,0:06:50.22,0:06:52.60,teks umum,,0,0,0,,- Telur saya?\N- Kekasih rahsia awak
Dialog: 0,0:06:53.39,0:06:57.69,teks umum,,0,0,0,,Telur bangau yang anggun di atas pokok
Dialog: 0,0:07:00.23,0:07:03.28,teks umum,,0,0,0,,Hamba Kim, awak salah faham. Ini bukan burung yang sama
Dialog: 0,0:07:04.28,0:07:05.90,teks umum,,0,0,0,,- Bukan dia?\N- Tidak
Dialog: 0,0:07:05.99,0:07:10.03,teks umum,,0,0,0,,Saya fikir dia akan menetas dari telur
Dialog: 0,0:07:10.83,0:07:13.25,teks umum,,0,0,0,,Ada orang lain ke?
Dialog: 0,0:07:14.50,0:07:16.54,teks umum,,0,0,0,,Ya. ya
Dialog: 0,0:07:17.79,0:07:19.04,teks umum,,0,0,0,,Dan siapa ini?
Dialog: 0,0:07:20.50,0:07:23.38,teks umum,,0,0,0,,Hamba Kim, cuma jangan terkejut
Dialog: 0,0:07:23.46,0:07:24.88,teks umum,,0,0,0,,Dan jika anda tidak dapat menahan diri,
Dialog: 0,0:07:24.97,0:07:26.55,teks umum,,0,0,0,,gigit sapu tangan anda
Dialog: 0,0:07:28.22,0:07:30.68,teks umum,,0,0,0,,Siapa mungkin?
Dialog: 0,0:07:31.26,0:07:33.06,teks umum,,0,0,0,,Tiada gadis lain berhampiran anda
Dialog: 0,0:07:41.98,0:07:43.28,teks umum,,0,0,0,,Sungguh...
Dialog: 0,0:07:44.61,0:07:47.03,teks umum,,0,0,0,,Ya. Moo Deok akan dapat semuanya
Dialog: 0,0:07:53.74,0:07:54.91,teks umum,,0,0,0,,Ia tidak boleh
Dialog: 0,0:07:55.00,0:07:58.58,teks umum,,0,0,0,,Bagaimana itu? Bagaimana dengan Puan Ho?
Dialog: 0,0:08:01.59,0:08:04.96,teks umum,,0,0,0,,Saya lihat keadaan berjalan lancar antara awak dan Encik Chan Wook
Dialog: 0,0:08:05.05,0:08:05.96,teks umum,,0,0,0,,Ya
Dialog: 0,0:08:06.05,0:08:08.34,teks umum,,0,0,0,,Saya memutuskan untuk berkahwin dengannya
Dialog: 0,0:08:08.43,0:08:10.76,teks umum,,0,0,0,,Saya suka menyebarkan pelbagai khabar angin
Dialog: 0,0:08:10.84,0:08:13.93,teks umum,,0,0,0,,Sila. Biar semua orang tahu bahawa saya mengubah nasib saya
Dialog: 0,0:08:15.27,0:08:18.89,teks umum,,0,0,0,,Berita perkahwinan anda akan menjelaskan semua khabar angin lucah
Dialog: 0,0:08:19.52,0:08:20.73,teks umum,,0,0,0,,"Khabar angin tidak senonoh"?
Dialog: 0,0:08:20.81,0:08:23.82,teks umum,,0,0,0,,Ramai orang bergosip bahawa dia mati pucuk,
Dialog: 0,0:08:23.90,0:08:25.23,teks umum,,0,0,0,,kali amalan kesucian
Dialog: 0,0:08:25.98,0:08:27.15,teks umum,,0,0,0,,Ini tidak benar
Dialog: 0,0:08:27.24,0:08:29.66,teks umum,,0,0,0,,Itulah kata semua orang. Ini salah?
Dialog: 0,0:08:29.74,0:08:32.28,teks umum,,0,0,0,,Bukan perkataan kebenaran!
Dialog: 0,0:08:33.33,0:08:34.91,teks umum,,0,0,0,,Jadi anda menyemaknya sendiri
Dialog: 0,0:08:36.41,0:08:38.12,teks umum,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:08:38.21,0:08:40.96,teks umum,,0,0,0,,Faham. Dan itulah sebabnya saya memutuskan untuk berkahwin dengannya
Dialog: 0,0:08:41.04,0:08:43.29,teks umum,,0,0,0,,Wanita mana yang akan berkahwin dengan lelaki mati pucuk,
Dialog: 0,0:08:43.38,0:08:45.25,teks umum,,0,0,0,,walaupun dia seorang waris yang kaya?
Dialog: 0,0:08:45.34,0:08:46.67,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:08:46.76,0:08:48.63,teks umum,,0,0,0,,Yakinlah, saya akan beritahu semua orang
Dialog: 0,0:08:48.72,0:08:50.63,teks umum,,0,0,0,,"Dia memeriksa, dia tidak mati pucuk"
Dialog: 0,0:08:50.72,0:08:52.34,teks umum,,0,0,0,,Kami belum tidur bersama lagi!
Dialog: 0,0:08:53.30,0:08:55.26,teks umum,,0,0,0,,Kami benar-benar belum mempunyai apa-apa lagi
Dialog: 0,0:08:56.14,0:08:58.56,teks umum,,0,0,0,,Jangan malu. Saya lebih tua
Dialog: 0,0:09:02.23,0:09:04.65,teks umum,,0,0,0,,Anda sangat berbahaya apabila kita mula-mula bertemu
Dialog: 0,0:09:04.73,0:09:06.48,teks umum,,0,0,0,,Dan kini, sebuah hati telah muncul
Dialog: 0,0:09:08.86,0:09:13.49,teks umum,,0,0,0,,Saya fikir suatu hari nanti awak akan memutuskan hubungan dengan semua orang dan hilang
Dialog: 0,0:09:15.24,0:09:18.54,teks umum,,0,0,0,,Saya dah cakap saya mengubah nasib
Dialog: 0,0:09:19.62,0:09:23.29,teks umum,,0,0,0,,Saya akan tinggal dan melindungi mereka yang saya sayang
Dialog: 0,0:09:24.58,0:09:26.04,teks umum,,0,0,0,,Nampaknya awak sangat menyukainya
Dialog: 0,0:09:29.55,0:09:32.63,teks umum,,0,0,0,,saya doakan awak bahagia
Dialog: 0,0:09:40.31,0:09:44.19,italic,,0,0,0,,Saya akan ambil pedang yang akan membantu awak memusnahkan Chan Wook
Dialog: 0,0:09:45.36,0:09:49.78,teks umum,,0,0,0,,Hanya saya boleh melindungi anda dengan menyelamatkan anda daripada bintang Raja
Dialog: 0,0:09:49.86,0:09:51.95,teks umum,,0,0,0,,Chan Wook kehilangan semua kekuatannya
Dialog: 0,0:09:53.24,0:09:55.78,teks umum,,0,0,0,,Saya memberikan semua tenaga saya untuk memusnahkan penghalang
Dialog: 0,0:09:56.91,0:10:00.20,teks umum,,0,0,0,,Dia tidak boleh menjadi Gwangju seterusnya
Dialog: 0,0:10:00.29,0:10:02.16,teks umum,,0,0,0,,Dia kehilangan pengaruhnya
Dialog: 0,0:10:03.50,0:10:06.75,teks umum,,0,0,0,,Dan semua orang berfikir bahawa bintang Raja telah bersinar untuk saya
Dialog: 0,0:10:08.71,0:10:12.67,teks umum,,0,0,0,,Anda tiada apa-apa untuk ditawarkan kepada saya, Timbalan Gwangju
Dialog: 0,0:10:15.68,0:10:17.85,teks umum,,0,0,0,,Chan Gan mengorbankan dirinya atas nama
Dialog: 0,0:10:17.93,0:10:19.97,teks umum,,0,0,0,,Sosnovy Bor, Jinyeowon dan Jeonbugwan
Dialog: 0,0:10:20.06,0:10:23.77,teks umum,,0,0,0,,Tetapi Jin Woo Tak masih hidup, kamu akan didapati bersalah
Dialog: 0,0:10:24.56,0:10:27.31,teks umum,,0,0,0,,Saya tidak mahu menghukum bekas guru saya
Dialog: 0,0:10:28.15,0:10:31.23,teks umum,,0,0,0,,Jelaskan segala-galanya dan terima hukuman
Dialog: 0,0:10:35.70,0:10:37.82,teks umum,,0,0,0,,Adakah anda benar-benar berfikir bahawa batu itu telah hilang?
Dialog: 0,0:10:39.87,0:10:42.25,teks umum,,0,0,0,,Batu ais dipenuhi dengan tenaga syurga
Dialog: 0,0:10:42.33,0:10:44.79,teks umum,,0,0,0,,Dilahirkan di bawah bintang Raja
Dialog: 0,0:10:45.29,0:10:47.58,teks umum,,0,0,0,,dikurniakan kuasa ini
Dialog: 0,0:10:48.54,0:10:50.67,teks umum,,0,0,0,,Apa yang anda akan lakukan,
Dialog: 0,0:10:51.38,0:10:54.34,teks umum,,0,0,0,,jika Chang Wook menyembunyikan kuasa ini?
Dialog: 0,0:11:02.14,0:11:03.85,teks umum,,0,0,0,,Saya akan tunggu jawapan anda
Dialog: 0,0:11:05.02,0:11:07.60,teks umum,,0,0,0,,Saya akan sentiasa setia kepada Tuanku, Yang Amat Mulia
Dialog: 0,0:11:28.17,0:11:31.80,teks umum,,0,0,0,,Anda sedar, tetapi anda terus berdiam diri?
Dialog: 0,0:11:34.84,0:11:39.01,teks umum,,0,0,0,,Aku menyelamatkan kamu hanya supaya kamu menebus dosa kamu
Dialog: 0,0:11:40.22,0:11:41.76,teks umum,,0,0,0,,di hadapan anak perempuan kami
Dialog: 0,0:11:43.06,0:11:44.64,teks umum,,0,0,0,,Sebelum Boo Young
Dialog: 0,0:11:49.23,0:11:51.02,teks umum,,0,0,0,,Ketika kita mula-mula bertemu,
Dialog: 0,0:11:53.32,0:11:55.53,teks umum,,0,0,0,,Saya jatuh cinta dengan senyuman hangat awak
Dialog: 0,0:11:58.66,0:12:00.12,kenangan,,0,0,0,,Comel juga
Dialog: 0,0:12:00.20,0:12:04.12,kenangan,,0,0,0,,Saya rasa ini sesuai dengan Boo Young kita
Dialog: 0,0:12:06.96,0:12:10.17,teks umum,,0,0,0,,Dan dari saat pertemuan kami,
Dialog: 0,0:12:11.25,0:12:12.50,teks umum,,0,0,0,,cinta dengan awak
Dialog: 0,0:12:13.88,0:12:15.92,teks umum,,0,0,0,,Saya tidak mencintai sesiapa pun
Dialog: 0,0:12:17.17,0:12:18.38,teks umum,,0,0,0,,kecuali
Dialog: 0,0:12:25.43,0:12:27.81,teks umum,,0,0,0,,Saya cuba menjelaskan sesuatu untuk anda
Dialog: 0,0:12:28.52,0:12:32.19,teks umum,,0,0,0,,Saya katakan ini supaya kamu menderita
Dialog: 0,0:12:36.07,0:12:37.94,teks umum,,0,0,0,,Saya nak awak tahu,
Dialog: 0,0:12:38.03,0:12:42.16,teks umum,,0,0,0,,perdaya Jin Mu, awak buat ini pada anak perempuan kita
Dialog: 0,0:12:42.74,0:12:45.58,teks umum,,0,0,0,,Saya harap anda akan menderita
Dialog: 0,0:13:08.85,0:13:11.06,teks umum,,0,0,0,,Jin Woo Tak di Saejukwon
Dialog: 0,0:13:11.14,0:13:12.77,teks umum,,0,0,0,,Dia sedar
Dialog: 0,0:13:13.27,0:13:15.40,teks umum,,0,0,0,,Sejak dia masih hidup,
Dialog: 0,0:13:15.48,0:13:18.36,teks umum,,0,0,0,,dia mungkin akan mengkhianati saya dan organisasi kita
Dialog: 0,0:13:18.44,0:13:20.07,teks umum,,0,0,0,,Kita perlu singkirkan dia
Dialog: 0,0:13:26.53,0:13:29.12,teks umum,,0,0,0,,Saya membawa abu arwah ratu
Dialog: 0,0:13:29.20,0:13:32.17,teks umum,,0,0,0,,dan loceng, seperti yang anda pesan
Dialog: 0,0:14:30.39,0:14:35.06,teks umum,,0,0,0,,Saya boleh membuat semua perantau menjadi gila
Dialog: 0,0:14:36.90,0:14:39.44,teks umum,,0,0,0,,Jika Chang Wook mempunyai kuasa batu ais,
Dialog: 0,0:14:40.48,0:14:42.74,teks umum,,0,0,0,,dia perlu menunjukkan kepada mereka
Dialog: 0,0:14:49.74,0:14:51.58,teks umum,,0,0,0,,Jadikan dua cincin
Dialog: 0,0:14:53.96,0:14:56.12,teks umum,,0,0,0,,Anda memesan dua deringan
Dialog: 0,0:14:56.21,0:14:58.21,teks umum,,0,0,0,,Jadi khabar angin itu tidak berbohong
Dialog: 0,0:14:59.75,0:15:02.05,teks umum,,0,0,0,,Ini adalah cincin untuk perkahwinan, lakukan semuanya dengan baik
Dialog: 0,0:15:02.13,0:15:03.05,contact,,0,0,0,,Sudah tentu
Dialog: 0,0:15:03.13,0:15:05.51,teks umum,,0,0,0,,Saya akan melakukan segala-galanya dengan cara yang terbaik
Dialog: 0,0:15:05.59,0:15:08.55,teks umum,,0,0,0,,Lihat pilihan ini
Dialog: 0,0:15:08.64,0:15:09.89,teks umum,,0,0,0,,Yang manakah anda suka?
Dialog: 0,0:15:09.97,0:15:11.64,teks umum,,0,0,0,,Ini cantik
Dialog: 0,0:15:11.72,0:15:12.68,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:15:14.35,0:15:15.39,teks umum,,0,0,0,,Ini...
Dialog: 0,0:15:15.48,0:15:18.48,teks umum,,0,0,0,,Itu kepunyaan Puan Young Ok
Dialog: 0,0:15:18.56,0:15:20.52,teks umum,,0,0,0,,- Oh, tidak, bukan ini\N- Okay
Dialog: 0,0:15:20.61,0:15:21.98,teks umum,,0,0,0,,Mereka tidak begitu
Dialog: 0,0:15:22.98,0:15:25.20,teks umum,,0,0,0,,- Dan ini?\N- Tidak...
Dialog: 0,0:15:25.28,0:15:26.40,teks umum,,0,0,0,,Nah...
Dialog: 0,0:15:27.57,0:15:28.74,teks umum,,0,0,0,,- Puan So Jeong...\N- Tidak sama juga
Dialog: 0,0:15:29.32,0:15:31.08,teks umum,,0,0,0,,Saya tidak suka apa-apa
Dialog: 0,0:15:31.16,0:15:33.87,teks umum,,0,0,0,,Saya akan keluarkan yang tidak sesuai dengan anda
Dialog: 0,0:15:35.16,0:15:37.25,teks umum,,0,0,0,,Ini...
Dialog: 0,0:15:38.17,0:15:39.54,teks umum,,0,0,0,,Dan ini
Dialog: 0,0:15:40.59,0:15:41.84,teks umum,,0,0,0,,Di sini
Dialog: 0,0:15:41.92,0:15:44.42,teks umum,,0,0,0,,Pilih daripada yang selebihnya
Dialog: 0,0:15:45.80,0:15:48.01,teks umum,,0,0,0,,Tujuh deringan?
Dialog: 0,0:16:02.15,0:16:03.32,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:16:03.98,0:16:07.11,teks umum,,0,0,0,,Nampaknya tidak ada tujuh. Saya benar-benar tidak ingat sesiapa
Dialog: 0,0:16:07.20,0:16:09.11,teks umum,,0,0,0,,Adakah mereka seperti Cho Young?
Dialog: 0,0:16:10.12,0:16:12.08,teks am,,0,0,0,,Berjanji untuk berkahwin jika pintu tenaga dibuka?
Dialog: 0,0:16:12.16,0:16:13.95,teks umum,,0,0,0,,Saya bersumpah, saya tidak menjaga mereka dahulu
Dialog: 0,0:16:14.04,0:16:17.62,teks umum,,0,0,0,,Awak sendiri cakap yang awak perlu berusaha untuk tidak jatuh cinta dengan lelaki kacak
Dialog: 0,0:16:17.71,0:16:20.17,teks umum,,0,0,0,,Mereka tidak berusaha secukupnya
Dialog: 0,0:16:20.25,0:16:21.88,teks umum,,0,0,0,,Jangan buat saya marah
Dialog: 0,0:16:21.96,0:16:24.21,teks umum,,0,0,0,,Sekarang saya milik awak
Dialog: 0,0:16:24.30,0:16:25.80,teks umum,,0,0,0,,Tidakkah anda bangga itu
Dialog: 0,0:16:25.88,0:16:27.80,teks umum,,0,0,0,, memintas semua orang dan mendapat hati saya?
Dialog: 0,0:16:29.93,0:16:32.64,teks umum,,0,0,0,,Jika ada sedozen daripada mereka, saya akan berbangga
Dialog: 0,0:16:32.72,0:16:34.31,teks umum,,0,0,0,,Dan sebagainya, kelakar
Dialog: 0,0:16:34.39,0:16:35.97,teks umum,,0,0,0,,Adakah anda fikir bilangan mereka tidak begitu banyak?
Dialog: 0,0:16:37.93,0:16:39.98,teks umum,,0,0,0,,Saya gurau. Awak seorang sahaja
Dialog: 0,0:16:40.06,0:16:41.44,teks umum,,0,0,0,,Saya lupa semua orang
Dialog: 0,0:16:41.52,0:16:42.73,teks umum,,0,0,0,,Tunggu sebentar
Dialog: 0,0:16:43.65,0:16:45.78,teks umum,,0,0,0,,Saya melihat beberapa deringan semasa saya membersihkan bilik anda
Dialog: 0,0:16:46.53,0:16:47.57,teks umum,,0,0,0,,Kita perlu mencarinya
Dialog: 0,0:16:47.65,0:16:50.91,teks umum,,0,0,0,,Mengapa mencari cincin yang tiada siapa perlukan?
Dialog: 0,0:16:50.99,0:16:53.53,teks umum,,0,0,0,,Saya pasti terdapat kira-kira sedozen daripadanya
Dialog: 0,0:16:54.62,0:16:55.58,teks umum,,0,0,0,,Perlu menyemak
Dialog: 0,0:17:01.75,0:17:03.08,teks umum,,0,0,0,,Saya tidak mempunyai sesiapa
Dialog: 0,0:17:05.88,0:17:07.84,teks umum,,0,0,0,,Moo Dok, jom makan
Dialog: 0,0:17:10.30,0:17:12.18,teks umum,,0,0,0,,Beritahu saya dengan jujur
Dialog: 0,0:17:12.26,0:17:13.34,teks umum,,0,0,0,,Berapa deringan?
Dialog: 0,0:17:18.93,0:17:20.19,teks umum,,0,0,0,,Satu
Dialog: 0,0:17:20.27,0:17:22.98,teks umum,,0,0,0,,Saya akan memegang tangan anda di dalam cincin tangan saya
Dialog: 0,0:17:24.19,0:17:26.36,teks umum,,0,0,0,,Sudah pasti tiada siapa yang mempunyai cincin sedemikian
Dialog: 0,0:17:27.98,0:17:29.11,teks umum,,0,0,0,,Nah...
Dialog: 0,0:17:29.94,0:17:32.07,teks umum,,0,0,0,,Oleh kerana kita sudah mempunyai cincin,
Dialog: 0,0:17:32.57,0:17:35.07,teks umum,,0,0,0,,tidak perlu membuatnya daripada jed sama ada
Dialog: 0,0:17:37.74,0:17:39.95,italic,,0,0,0,,Mungkin kita patut buat beberapa rantai?
Dialog: 0,0:17:40.04,0:17:41.58,teks umum,,0,0,0,,Seperti yang anda mahu
Dialog: 0,0:17:41.66,0:17:44.33,italic,,0,0,0,,Saya tidak iri pada Dan Gu sedikit pun
Dialog: 0,0:17:44.88,0:17:48.13,italics,,0,0,0,,- Saya tidak iri Cho Yeon sedikit pun\N- {\i0}Jadi khabar angin itu benar
Dialog: 0,0:17:48.21,0:17:50.80,teks umum,,0,0,0,,Lelaki nakal ini... sedang tersenyum
Dialog: 0,0:17:52.05,0:17:53.34,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:17:53.43,0:17:55.60,teks umum,,0,0,0,,Nampaknya saya dari awal lagi
Dialog: 0,0:17:56.89,0:18:00.23,teks umum,,0,0,0,,faham semuanya salah. sangat memalukan
Dialog: 0,0:18:01.35,0:18:02.52,teks umum,,0,0,0,,Puan,
Dialog: 0,0:18:03.27,0:18:07.02,teks umum,,0,0,0,,jangan katakan bahawa anda meluahkan perasaan anda kepadanya dalam halangan itu
Dialog: 0,0:18:07.61,0:18:10.40,teks umum,,0,0,0,,Saya sedang bersiap. Saya hampir mengaku
Dialog: 0,0:18:11.78,0:18:13.20,teks umum,,0,0,0,,Saya mempunyai peluang
Dialog: 0,0:18:22.16,0:18:24.75,kenangan,,0,0,0,,Anda tidak perlu pegang lilin di sebelah saya
Dialog: 0,0:18:24.83,0:18:26.63,kenangan,,0,0,0,,Anda boleh meletakkannya di suatu tempat
Dialog: 0,0:18:27.88,0:18:31.01,kenangan,,0,0,0,,Adakah anda malu kerana saya di sini?
Dialog: 0,0:18:31.09,0:18:32.55,kenangan,,0,0,0,,Semuanya sesuai dengan saya
Dialog: 0,0:18:34.43,0:18:35.76,kenangan,,0,0,0,,Nah, seperti yang anda tahu
Dialog: 0,0:18:39.60,0:18:42.23,kenangan,,0,0,0,,Ketika anda terbaring dalam keadaan mabuk di Sejukwon,
Dialog: 0,0:18:42.31,0:18:45.44,kenangan,,0,0,0,, pendahuluan saya tidak mengganggu anda
Dialog: 0,0:18:45.52,0:18:47.40,kenangan,,0,0,0,,Saya sangka awak Moo Deok
Dialog: 0,0:18:57.91,0:19:01.12,teks umum,,0,0,0,,Beginilah dia di sebelah kekasihnya
Dialog: 0,0:19:01.87,0:19:05.50,teks umum,,0,0,0,,Sekiranya Encik Uk yang menderita bukannya Encik Yulya,
Dialog: 0,0:19:05.58,0:19:08.13,teks umum,,0,0,0,,anda akan semakin dekat
Dialog: 0,0:19:09.75,0:19:11.92,teks umum,,0,0,0,,Anda sedang merawat yang cedera
Dialog: 0,0:19:13.38,0:19:14.63,teks umum,,0,0,0,,Adakah anda fikir?
Dialog: 0,0:19:16.01,0:19:17.68,teks umum,,0,0,0,,Jika dia telah cedera,
Dialog: 0,0:19:20.39,0:19:22.27,teks umum,,0,0,0,,adakah saya mempunyai peluang?
Dialog: 0,0:19:29.69,0:19:31.98,teks umum,,0,0,0,,Jadi Yul, saya dengar awak akan kembali ke Kubu Soho
Dialog: 0,0:19:32.07,0:19:34.36,teks umum,,0,0,0,,Ya, selepas perkahwinan Dan Gu
Dialog: 0,0:19:34.44,0:19:36.07,teks umum,,0,0,0,,Bolehkah kami mengadakan parti sebelum anda pergi?
Dialog: 0,0:19:36.15,0:19:37.20,teks umum,,0,0,0,,Ya
Dialog: 0,0:19:48.63,0:19:52.88,italic,,0,0,0,,Luka awak dah sembuh, tapi awak masih sakit?
Dialog: 0,0:19:53.84,0:19:57.05,teks umum,,0,0,0,,Saya fikir ia akan menjadi lebih baik, tetapi saya silap
Dialog: 0,0:19:57.68,0:20:00.01,teks umum,,0,0,0,,Sesuatu berlaku semasa saya tidak sedarkan diri
Dialog: 0,0:20:00.09,0:20:01.64,teks umum,,0,0,0,,ada dalam penghalang?
Dialog: 0,0:20:01.72,0:20:05.85,teks umum,,0,0,0,,Kami menghentikan pendarahan
Dialog: 0,0:20:08.73,0:20:11.61,teks umum,,0,0,0,,So Yi yang melarikan diri memberi kamu darahnya
Dialog: 0,0:20:14.48,0:20:16.78,teks umum,,0,0,0,,Anda tidak boleh menderma darah seperti itu
Dialog: 0,0:20:17.36,0:20:19.45,teks umum,,0,0,0,,Mengapa sikap melulu?
Dialog: 0,0:20:20.95,0:20:22.33,teks umum,,0,0,0,,Saya cuma
Dialog: 0,0:20:22.41,0:20:25.20,teks umum,,0,0,0,,ingin menyelamatkannya
Dialog: 0,0:20:28.75,0:20:31.75,teks umum,,0,0,0,,Darahnya masuk ke dalam luka anda
Dialog: 0,0:20:32.84,0:20:34.84,teks umum,,0,0,0,,Tetapi ini tidak sepatutnya menyebabkan masalah
Dialog: 0,0:20:34.92,0:20:36.34,teks umum,,0,0,0,,Saya rasa saya akan sembuh tidak lama lagi
Dialog: 0,0:20:37.13,0:20:40.01,teks umum,,0,0,0,,Saya tidak mahu kepala bimbang, jadi rahsiakan
Dialog: 0,0:20:42.47,0:20:44.76,italic,,0,0,0,,Ok, sampai ke bawah!
Dialog: 0,0:20:46.39,0:20:48.56,teks umum,,0,0,0,,Hei, awak buat apa di sana?
Dialog: 0,0:20:50.06,0:20:51.85,teks umum,,0,0,0,,Apa yang awak curi?
Dialog: 0,0:20:52.44,0:20:54.52,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:20:54.61,0:20:56.48,teks umum,,0,0,0,,Hei! Berhenti!
Dialog: 0,0:21:16.30,0:21:19.76,teks umum,,0,0,0,,Luka yang ditinggalkan oleh cacing itu sembuh dengan sangat perlahan
Dialog: 0,0:21:31.94,0:21:34.02,teks umum,,0,0,0,,Cacing dalam badannya
Dialog: 0,0:21:38.36,0:21:39.90,teks umum,,0,0,0,,Dia mungkin dalam kesakitan
Dialog: 0,0:21:41.15,0:21:44.24,teks am,,0,0,0,,Dia memerlukan ubat yang saya ambil dalam Jinyeowon
Dialog: 0,0:21:50.37,0:21:51.62,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:21:54.83,0:21:57.84,teks umum,,0,0,0,,Anda tidak sepatutnya bekerja di sini lagi
Dialog: 0,0:21:58.76,0:22:01.51,teks umum,,0,0,0,,Apa? Adakah anda menendang saya keluar?
Dialog: 0,0:22:01.59,0:22:03.63,teks umum,,0,0,0,,Jika ya, adakah anda akan mendengar saya?
Dialog: 0,0:22:03.72,0:22:06.30,teks umum,,0,0,0,,- Tidak\N- Saya tahu ia bukan
Dialog: 0,0:22:06.39,0:22:07.89,teks umum,,0,0,0,,Jangan jadikan saya orang jahat
Dialog: 0,0:22:10.60,0:22:12.48,teks umum,,0,0,0,,Jangan buat kerja rumah lagi
Dialog: 0,0:22:13.56,0:22:16.98,teks umum,,0,0,0,,Awak bakal isteri tercinta, saya tak boleh paksa awak bekerja
Dialog: 0,0:22:18.40,0:22:21.19,teks umum,,0,0,0,,Jadi awak terima saya?
Dialog: 0,0:22:21.28,0:22:24.07,teks umum,,0,0,0,,Adakah saya mempunyai pilihan? Dia hanya memuja awak
Dialog: 0,0:22:26.45,0:22:29.49,teks umum,,0,0,0,,Saya tidak akan memanggil puan
Dialog: 0,0:22:30.54,0:22:32.33,teks umum,,0,0,0,,Saya juga tidak akan menganggap awak sebagai ibu mertua saya
Dialog: 0,0:22:32.41,0:22:35.25,teks am,,0,0,0,,Mengapa saya harus menjadi ibu mertua awak jika saya sendiri belum berkahwin?
Dialog: 0,0:22:35.33,0:22:36.33,teks umum,,0,0,0,,Itu akan menyakiti harga diri saya
Dialog: 0,0:22:36.96,0:22:38.09,teks umum,,0,0,0,,Memang
Dialog: 0,0:22:38.63,0:22:41.46,teks umum,,0,0,0,,Tetapi awak dan ketua akan berkahwin tidak lama lagi, bukan?
Dialog: 0,0:22:43.72,0:22:45.89,teks umum,,0,0,0,,Saya fikir anda suka antara satu sama lain
Dialog: 0,0:22:54.77,0:22:55.94,teks umum,,0,0,0,,Maiden Kim...
Dialog: 0,0:22:56.90,0:22:59.32,teks umum,,0,0,0,, Walaupun anda perasan, tetapi dia tidak
Dialog: 0,0:22:59.86,0:23:01.65,teks umum,,0,0,0,,- Nah...\N- Itulah...
Dialog: 0,0:23:01.73,0:23:04.28,teks umum,,0,0,0,,Bagaimana dia boleh jadi lembab?
Dialog: 0,0:23:04.36,0:23:05.49,teks umum,,0,0,0,,Adakah dia berfikiran rapat atau apa?
Dialog: 0,0:23:05.57,0:23:06.95,teks umum,,0,0,0,,Dia hanya orang bodoh
Dialog: 0,0:23:12.12,0:23:16.17,kenangan condong,,0,0,0,,Ya! jatuh cinta! Cinta adalah lobak merah!
Dialog: 0,0:23:17.12,0:23:18.75,teks umum,,0,0,0,,Saya tidak boleh
Dialog: 0,0:23:20.00,0:23:22.09,teks umum,,0,0,0,,lupa kata,
Dialog: 0,0:23:22.17,0:23:23.46,teks umum,,0,0,0,,yang dia katakan
Dialog: 0,0:23:24.76,0:23:26.18,teks umum,,0,0,0,,saya
Dialog: 0,0:23:36.89,0:23:38.06,teks umum,,0,0,0,,Bab
Dialog: 0,0:23:43.15,0:23:44.19,teks umum,,0,0,0,,Uk...
Dialog: 0,0:23:44.78,0:23:47.41,teks umum,,0,0,0,,Bila anda tiba?
Dialog: 0,0:23:47.49,0:23:49.82,teks umum,,0,0,0,,Baru-baru ini. Saya ingin memberitahu anda sesuatu
Dialog: 0,0:23:49.91,0:23:53.04,teks umum,,0,0,0,,Apa yang awak risau sangat?
Dialog: 0,0:23:54.00,0:23:55.33,teks umum,,0,0,0,,Sesuatu yang mengerikan
Dialog: 0,0:23:56.71,0:23:58.00,teks umum,,0,0,0,,membimbangkan saya
Dialog: 0,0:23:58.87,0:24:01.04,teks umum,,0,0,0,,Apa yang anda ingin katakan?
Dialog: 0,0:24:01.67,0:24:02.88,teks umum,,0,0,0,,Anda lihat...
Dialog: 0,0:24:02.96,0:24:07.13,teks umum,,0,0,0,,Saya bercadang untuk meninggalkan ibu kota buat seketika selepas perkahwinan Dan Gu
Dialog: 0,0:24:08.01,0:24:09.34,teks umum,,0,0,0,,Begitukah?
Dialog: 0,0:24:11.26,0:24:12.56,teks umum,,0,0,0,,Kemudian...
Dialog: 0,0:24:13.72,0:24:15.31,teks umum,,0,0,0,,Dan pembantu rumah Kim?
Dialog: 0,0:24:17.48,0:24:21.48,teks umum,,0,0,0,,Jika tiada sesiapa mahu dia tinggal, saya perlu membawanya bersama saya
Dialog: 0,0:24:22.82,0:24:26.19,teks umum,,0,0,0,,Saya tidak tahu bila kita akan kembali. Mungkin dalam setahun, atau mungkin dalam sepuluh
Dialog: 0,0:24:26.28,0:24:28.86,teks umum,,0,0,0,,Atau mungkin kita tidak akan kembali
Dialog: 0,0:24:33.70,0:24:36.25,teks umum,,0,0,0,,Saya melakukan sesuatu
Dialog: 0,0:24:36.91,0:24:39.58,teks umum,,0,0,0,,tidak boleh dimaafkan
Dialog: 0,0:24:42.92,0:24:44.38,teks umum,,0,0,0,,Jika saya simpan dia di sini,
Dialog: 0,0:24:44.46,0:24:47.72,teks umum,,0,0,0,, adakah anda fikir dia akan kekal?
Dialog: 0,0:24:49.18,0:24:50.05,teks umum,,0,0,0,,Dia...
Dialog: 0,0:24:52.01,0:24:52.97,teks umum,,0,0,0,,menangis
Dialog: 0,0:25:00.90,0:25:04.11,teks umum,,0,0,0,,Dia akan menangis lebih kuat jika anda tidak menghalangnya
Dialog: 0,0:25:10.32,0:25:12.66,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:25:14.03,0:25:15.24,teks umum,,0,0,0,,dengan tuan muda
Dialog: 0,0:25:16.74,0:25:17.95,teks umum,,0,0,0,,Saya tidak akan pergi
Dialog: 0,0:25:20.16,0:25:21.25,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:25:25.88,0:25:28.84,teks umum,,0,0,0,,Tiada gunanya tinggal. Perlu pergi
Dialog: 0,0:25:43.65,0:25:46.52,teks umum,,0,0,0,,Saya mahukan sesuatu
Dialog: 0,0:25:48.28,0:25:50.19,teks umum,,0,0,0,,tunjukkan kepada anda
Dialog: 0,0:26:01.16,0:26:03.17,teks umum,,0,0,0,,Ini adalah biji balsam
Dialog: 0,0:26:04.50,0:26:06.13,teks umum,,0,0,0,,Jika anda menanamnya sekarang,
Dialog: 0,0:26:07.04,0:26:10.09,teks umum,,0,0,0,,bunga akan mekar dalam masa tiga hingga empat bulan
Dialog: 0,0:26:12.51,0:26:16.01,teks umum,,0,0,0,,Saya boleh membuatnya mekar sekarang di depan mata anda,
Dialog: 0,0:26:16.10,0:26:18.01,teks umum,,0,0,0,,menggunakan jampi
Dialog: 0,0:26:19.18,0:26:20.35,teks umum,,0,0,0,,Tetapi...
Dialog: 0,0:26:22.52,0:26:23.81,teks umum,,0,0,0,,Saya sangat lambat
Dialog: 0,0:26:29.23,0:26:32.07,teks umum,,0,0,0,,Saya mahu perlahan-lahan melihat mereka bercambah
Dialog: 0,0:26:33.90,0:26:35.45,teks umum,,0,0,0,,dan mekar
Dialog: 0,0:26:41.79,0:26:43.33,teks umum,,0,0,0,,Adakah anda akan menunggu mereka mekar bersama saya?
Dialog: 0,0:27:16.70,0:27:17.78,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:27:23.66,0:27:24.66,teks umum,,0,0,0,,Saya...
Dialog: 0,0:27:25.79,0:27:29.21,teks umum,,0,0,0,,Saya akan menjalani hidup dengan awak perlahan-lahan
Dialog: 0,0:27:47.14,0:27:50.65,teks umum,,0,0,0,,Hadiah ini hanya akan menghalang mereka
Dialog: 0,0:28:11.09,0:28:13.88,teks umum,,0,0,0,,Terima kasih. Kami akan makan semuanya
Dialog: 0,0:28:13.96,0:28:15.05,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:28:26.43,0:28:27.94,teks umum,,0,0,0,,Adakah anda lihat?
Dialog: 0,0:28:28.02,0:28:30.65,teks umum,,0,0,0,,Ahjusshi ini sedang menangis
Dialog: 0,0:28:30.73,0:28:35.07,teks umum,,0,0,0,,Saya tidak pernah melihat orang dewasa menangis dengan hingus
Dialog: 0,0:28:36.19,0:28:38.53,teks umum,,0,0,0,,Dia mungkin sakit
Dialog: 0,0:28:38.61,0:28:39.78,teks umum,,0,0,0,,Adakah anda fikir?
Dialog: 0,0:29:07.27,0:29:08.48,teks umum,,0,0,0,,Awak okay?
Dialog: 0,0:29:09.64,0:29:11.31,teks am,,0,0,0,,Saya bawakan awak ubat
Dialog: 0,0:29:11.40,0:29:12.73,teks umum,,0,0,0,,Di sini
Dialog: 0,0:29:19.95,0:29:23.28,teks umum,,0,0,0,,Sebaik sahaja abang bomoh Choi bercakap,
Dialog: 0,0:29:23.37,0:29:25.16,teks umum,,0,0,0,,kita boleh tangkap Jin Mu
Dialog: 0,0:29:25.24,0:29:28.25,teks umum,,0,0,0,,Saya perlu bertanya kepada Jin Mu sesuatu
Dialog: 0,0:29:30.16,0:29:32.75,teks umum,,0,0,0,,Ayah saya sendiri memutuskan untuk menjadi nomad
Dialog: 0,0:29:32.83,0:29:35.71,teks umum,,0,0,0,,atau adakah terdapat cerita di sebalik ini?
Dialog: 0,0:29:35.79,0:29:37.25,teks umum,,0,0,0,,Hanya dia yang tahu
Dialog: 0,0:29:39.42,0:29:42.97,italic,,0,0,0,,Stargazer Cho Chun meninggal dunia kerana Gwangju Chang Gang
Dialog: 0,0:29:43.55,0:29:47.43,teks umum,,0,0,0,,Stargazer Cho mengetahui bahawa Gwangju menggunakan ilmu sihir
Dialog: 0,0:29:47.51,0:29:49.23,teks umum,,0,0,0,, Kerana khuatir semuanya akan terbongkar,
Dialog: 0,0:29:49.31,0:29:52.52,teks umum,,0,0,0,,Jin Mu menjadikannya seorang nomad dan dia menjadi liar
Dialog: 0,0:29:52.60,0:29:54.23,teks umum,,0,0,0,,Ini bermakna,
Dialog: 0,0:29:54.31,0:29:56.94,teks am,,0,0,0,,bahawa kita membunuh orang yang tidak bersalah?
Dialog: 0,0:30:03.41,0:30:04.70,contact,,0,0,0,,Bukan salah kami
Dialog: 0,0:30:05.32,0:30:07.16,teks umum,,0,0,0,,Kami tidak tahu keseluruhan cerita
Dialog: 0,0:30:08.12,0:30:09.33,teks umum,,0,0,0,,Semua orang berfikir,
Dialog: 0,0:30:09.41,0:30:12.71,teks umum,,0,0,0,,ahli nujum Cho membunuh keluarganya kerana dia berminat dengan ilmu sihir
Dialog: 0,0:30:13.54,0:30:17.21,teks umum,,0,0,0,,Gwangju meminta untuk membersihkan nama Cho Chun
Dialog: 0,0:30:17.92,0:30:21.80,teks umum,,0,0,0,,Kami akan membincangkan perkara ini pada Majlis Bersatu yang akan datang
Dialog: 0,0:30:21.88,0:30:25.05,teks umum,,0,0,0,,Tetapi kenapa Jin Mu pergi jauh?
Dialog: 0,0:30:25.14,0:30:27.30,teks umum,,0,0,0,,Jika dia mahu mendiamkan Cho Chun,
Dialog: 0,0:30:27.39,0:30:28.85,teks umum,,0,0,0,,kenapa dia pusing dia
Dialog: 0,0:30:28.93,0:30:32.64,teks umum,,0,0,0,, dalam jiwa yang menelan dan terpaksa membunuh seluruh keluarga?
Dialog: 0,0:30:34.94,0:30:36.11,italic,,0,0,0,,Jin Mu tahu segala-galanya
Dialog: 0,0:30:36.69,0:30:40.23,teks umum,,0,0,0,,tentang keadaan kelahiran Chan Wook
Dialog: 0,0:30:41.49,0:30:42.99,teks umum,,0,0,0,,Dia melakukannya
Dialog: 0,0:30:43.07,0:30:44.99,teks umum,,0,0,0,,dengan rakan Chang Gun, Cho Chun,
Dialog: 0,0:30:46.37,0:30:48.45,teks umum,,0,0,0,,hanya untuk menyeksa Chang Gan
Dialog: 0,0:30:48.53,0:30:49.74,teks umum,,0,0,0,,Ini bermakna,
Dialog: 0,0:30:51.00,0:30:54.50,teks umum,,0,0,0,,jika Jin Mu ditangkap, dia akan menyerah
Dialog: 0,0:30:55.83,0:30:57.08,teks umum,,0,0,0,,En. Rahsia Chan
Dialog: 0,0:30:57.17,0:31:00.80,teks umum,,0,0,0,,Kami tidak boleh membenarkan ini. Jin Mu
Dialog: 0,0:31:02.84,0:31:04.59,teks umum,,0,0,0,,mesti mati
Dialog: 0,0:31:18.77,0:31:22.44,kenangan miring,,0,0,0,,Jika anda meletakkan kutukan pada pemantul jiwa, maka
Dialog: 0,0:31:22.53,0:31:26.57,kenangan,,0,0,0,,anda boleh mengawal jiwa yang menggunakannya
Dialog: 0,0:31:38.54,0:31:40.96,kenangan miring,,0,0,0,,Anda boleh membuat dia menjadi liar,
Dialog: 0,0:31:41.80,0:31:46.18,kenangan miring,,0,0,0,,dan kemudian singkirkan dia apabila dia membatu
Dialog: 0,0:31:55.31,0:31:57.10,teks umum,,0,0,0,,Shaman Choi
Dialog: 0,0:31:57.81,0:32:02.27,teks umum,,0,0,0,,meletakkan sumpahan pada semua pemantul jiwa yang dia cipta
Dialog: 0,0:32:03.03,0:32:07.11,teks umum,,0,0,0,,Inilah sebabnya saya tidak menjadi perantau sehingga hari ini
Dialog: 0,0:32:08.82,0:32:10.62,teks umum,,0,0,0,,Saya akan paksa semua nomad
Dialog: 0,0:32:10.70,0:32:14.45,teks umum,,0,0,0,,berlari di ibu kota ini, seperti Cho Chun hari itu
Dialog: 0,0:32:20.17,0:32:21.09,teks am,,0,0,0,,Timbalan,
Dialog: 0,0:32:22.17,0:32:24.34,teks umum,,0,0,0,,Chan Wook akan meninggalkan Jeonjingak
Dialog: 0,0:32:26.05,0:32:28.09,teks umum,,0,0,0,,Hutan pain membiarkan dia pergi?
Dialog: 0,0:32:28.18,0:32:29.13,teks umum,,0,0,0,,Ini adalah khabar angin
Dialog: 0,0:32:29.22,0:32:31.39,teks umum,,0,0,0,,Mereka mengatakan dia akan meninggalkan ibu kota
Dialog: 0,0:32:31.47,0:32:33.81,teks umum,,0,0,0,,Adakah dia akan meninggalkan segala-galanya?
Dialog: 0,0:32:33.89,0:32:37.14,teks umum,,0,0,0,,Chan Wook adalah satu-satunya senjata saya menentang putera raja. Jika dia pergi...
Dialog: 0,0:32:37.23,0:32:39.27,kenangan,,0,0,0,,Anda tiada apa-apa untuk ditawarkan kepada saya,
Dialog: 0,0:32:40.40,0:32:41.36,kenangan,,0,0,0,,Timbalan Gwangju
Dialog: 0,0:32:42.31,0:32:44.65,teks umum,,0,0,0,,Mengapa dia meninggalkan Sosnovy Bor?
Dialog: 0,0:32:44.73,0:32:48.11,teks umum,,0,0,0,,Dia minum racun untuk ke sana, mengambil milik Chisu
Dialog: 0,0:32:48.20,0:32:51.16,teks umum,,0,0,0,,Mungkin dia juga mempunyai kuasa batu,
Dialog: 0,0:32:51.24,0:32:52.70,teks umum,,0,0,0,,jadi kenapa?
Dialog: 0,0:32:57.33,0:33:00.08,teks umum,,0,0,0,,Mungkin ia telah berubah?
Dialog: 0,0:33:05.13,0:33:07.55,kenangan,,0,0,0,,Maknanya dia dah berubah
Dialog: 0,0:33:07.63,0:33:09.93,kenangan,,0,0,0,,Kenapa dia berubah secara tiba-tiba?
Dialog: 0,0:33:11.93,0:33:13.85,teks umum,,0,0,0,,Apa yang membuatkan dia berubah?
Dialog: 0,0:33:14.60,0:33:17.98,kenangan,,0,0,0,,Orang berubah kerana orang lain
Dialog: 0,0:33:19.48,0:33:22.15,kenangan,,0,0,0,,Ketahui siapa yang muncul tepat pada saat dia mula berubah
Dialog: 0,0:33:25.15,0:33:26.57,kenangan,,0,0,0,,Inilah jawapannya
Dialog: 0,0:33:27.36,0:33:30.57,teks umum,,0,0,0,,Ketahui siapa yang muncul tepat pada saat dia mula berubah
Dialog: 0,0:33:31.24,0:33:32.91,kenangan,,0,0,0,,Saya datang untuk pedang Nak Su
Dialog: 0,0:33:35.87,0:33:39.16,teks umum,,0,0,0,,Tidak boleh. Tak mungkin Nak Soo
Dialog: 0,0:33:41.00,0:33:42.88,miring,,0,0,0,,Dia menggunakan Tansu, yang dimiliki oleh Nak Su
Dialog: 0,0:33:43.46,0:33:44.59,teks umum,,0,0,0,,Tidak...
Dialog: 0,0:33:45.79,0:33:47.88,teks umum,,0,0,0,,Dia mungkin belajar ini daripada Guru Li
Dialog: 0,0:33:47.96,0:33:51.01,kenangan,,0,0,0,,Saya melihat segala-galanya semasa saya bersamanya di Danhyangk
Dialog: 0,0:33:51.09,0:33:54.72,kenangan,,0,0,0,,dan tiada sesiapa bersamanya kecuali pembantu rumahnya
Dialog: 0,0:34:02.60,0:34:07.69,teks umum,,0,0,0,,Dia pergi dengan pembantu rumahnya?
Dialog: 0,0:34:07.77,0:34:08.78,miring,,0,0,0,,Ya
Dialog: 0,0:34:08.86,0:34:12.78,teks umum,,0,0,0,,Dia membawa Moo Dok bersamanya, yang mengikutinya ke mana-mana
Dialog: 0,0:34:28.92,0:34:30.92,teks umum,,0,0,0,,Maaf kerana membawa awak ke sini
Dialog: 0,0:34:31.55,0:34:33.84,teks umum,,0,0,0,,Awak kata awak perlu beli banyak barang
Dialog: 0,0:34:33.93,0:34:35.51,teks umum,,0,0,0,,Saya akan membantu
Dialog: 0,0:34:41.64,0:34:43.52,teks umum,,0,0,0,,Jika dialah yang saya ambil untuknya...
Dialog: 0,0:35:32.44,0:35:33.69,teks umum,,0,0,0,,Mu Dok?
Dialog: 0,0:35:44.37,0:35:46.96,teks umum,,0,0,0,,- Awak okay?\N- Ya
Dialog: 0,0:35:47.62,0:35:49.54,italic,,0,0,0,,Awak tak dengar saya panggil awak?
Dialog: 0,0:35:51.92,0:35:52.92,teks umum,,0,0,0,,Saya dengar
Dialog: 0,0:35:53.71,0:35:56.30,italic,,0,0,0,,Kenapa saya tidak menjawab?
Dialog: 0,0:35:57.76,0:35:59.72,teks umum,,0,0,0,,Adakah anda juga mendengar bunyi loceng?
Dialog: 0,0:36:00.64,0:36:02.93,teks umum,,0,0,0,,Loceng jell? Saya tidak mendengar
Dialog: 0,0:36:03.52,0:36:06.81,teks umum,,0,0,0,,- Mereka tidak begitu bagus, mari kita pergi\N - Okay
Dialog: 0,0:36:10.15,0:36:11.06,teks umum,,0,0,0,,Nak Su,
Dialog: 0,0:36:12.82,0:36:15.61,teks umum,,0,0,0,,anda memberi saya harapan
Dialog: 0,0:36:24.16,0:36:26.41,teks umum,,0,0,0,,Cikgu Li, ada satu di sana
Dialog: 0,0:36:27.08,0:36:28.87,teks umum,,0,0,0,,Eh, awak buat apa?
Dialog: 0,0:36:29.54,0:36:30.42,contact,,0,0,0,,Ada apa dengan awak?
Dialog: 0,0:36:30.50,0:36:33.71,teks umum,,0,0,0,,Cikgu Li, anda terlepas begitu banyak ikan
Dialog: 0,0:36:34.34,0:36:36.59,teks umum,,0,0,0,,Saya tidak menyesali ikan yang tidak dapat saya tangkap
Dialog: 0,0:36:36.67,0:36:38.34,teks umum,,0,0,0,,Apakah maksud ini?
Dialog: 0,0:36:38.43,0:36:41.14,teks umum,,0,0,0,,Maka ini membuang masa
Dialog: 0,0:36:42.14,0:36:43.93,teks umum,,0,0,0,,Jika tidak, ia adalah ketamakan dan obsesi
Dialog: 0,0:36:44.01,0:36:46.31,teks umum,,0,0,0,,- Apa? \N- Walau bagaimanapun,
Dialog: 0,0:36:46.39,0:36:50.77,teks umum,,0,0,0,,Saya menyedari bahawa terdapat kesedihan yang murni dalam kehilangan
Dialog: 0,0:36:54.32,0:36:58.07,teks umum,,0,0,0,,Kebelakangan ini saya mula faham kenapa orang sedih,
Dialog: 0,0:36:58.15,0:36:59.86,teks umum,,0,0,0,,apabila mereka melihat aliran air,
Dialog: 0,0:36:59.95,0:37:04.08,teks umum,,0,0,0,,musim berlalu, dan matahari terbenam
Dialog: 0,0:37:14.00,0:37:16.55,teks umum,,0,0,0,,Melihat troli kosong ini membuatkan saya sedih
Dialog: 0,0:37:16.63,0:37:18.72,teks umum,,0,0,0,,Mu Dok kata tangkap ikan banyak
Dialog: 0,0:37:19.30,0:37:21.68,teks umum,,0,0,0,,Jadi adakah anda akan meninggalkan nomad di sebelah anda?
Dialog: 0,0:37:25.68,0:37:28.10,teks umum,,0,0,0,,Kami menepati janji kami kepada anda
Dialog: 0,0:37:28.85,0:37:30.69,teks umum,,0,0,0,,Nak Su mengacukan pedangnya kepada saya,
Dialog: 0,0:37:30.77,0:37:32.73,teks umum,,0,0,0,,dan kemudian menurunkannya
Dialog: 0,0:37:32.81,0:37:38.11,teks umum,,0,0,0,,Jadi saya harap anda akan mengekalkan pengakhiran perjanjian anda dan biarkan kami pergi
Dialog: 0,0:37:38.19,0:37:40.36,teks umum,,0,0,0,,Apa yang berlaku pada batu ais pada hari itu?
Dialog: 0,0:37:41.45,0:37:44.99,teks umum,,0,0,0,,Mungkinkah ia berada di dalam diri anda?
Dialog: 0,0:37:59.63,0:38:01.76,teks umum,,0,0,0,,Walaupun begitu,
Dialog: 0,0:38:02.80,0:38:04.85,teks umum,,0,0,0,,ia sama sekali tidak berguna
Dialog: 0,0:38:04.93,0:38:09.31,teks umum,,0,0,0,,Saya tidak dapat mengawal setitik air pun, apatah lagi Ikan Emas
Dialog: 0,0:38:11.89,0:38:15.98,teks umum,,0,0,0,,Jika anda memulakan latihan semula, anda akan dapat menggunakan kuasa ini
Dialog: 0,0:38:16.57,0:38:18.61,teks umum,,0,0,0,,Saya melihat bagaimana keinginan untuk menguasai kuasa ini
Dialog: 0,0:38:18.69,0:38:21.95,teks umum,,0,0,0,,menjadikan orang kejam dan jahat
Dialog: 0,0:38:22.86,0:38:26.03,teks umum,,0,0,0,,Lebih baik jangan membangkitkan kuasa batu ais
Dialog: 0,0:38:28.08,0:38:31.16,teks umum,,0,0,0,,Anda tamak akan ikan,
Dialog: 0,0:38:31.25,0:38:33.25,teks umum,,0,0,0,, adakah anda tidak mengambil berat tentang batu ais?
Dialog: 0,0:38:34.54,0:38:36.17,teks umum,,0,0,0,,Anda lebih baik daripada saya
Dialog: 0,0:38:39.42,0:38:42.88,teks umum,,0,0,0,,Bagaimanapun, selagi saya ada batu ais,
Dialog: 0,0:38:44.01,0:38:46.18,teks umum,,0,0,0,,Saya boleh melindungi seorang
Dialog: 0,0:38:47.26,0:38:50.52,teks umum,,0,0,0,,Jika Moo Dok menjadi liar,
Dialog: 0,0:38:50.60,0:38:54.06,teks umum,,0,0,0,,bantu saya menggunakan kuasa ini untuk menghentikan ini
Dialog: 0,0:38:54.14,0:38:58.65,teks umum,,0,0,0,,Dia akan baik-baik saja selagi dia tidak cuba menunjukkan kuasanya
Dialog: 0,0:38:59.23,0:39:02.86,teks umum,,0,0,0,,Dalam badan yang lemah ini menyembunyikan jiwa yang kuat seorang pembunuh
Dialog: 0,0:39:02.94,0:39:05.66,teks umum,,0,0,0,,Jika apa-apa berlaku, dia pasti sudah menjadi liar
Dialog: 0,0:39:05.74,0:39:07.53,teks umum,,0,0,0,,Dia tidak menjadi liar kerana,
Dialog: 0,0:39:07.62,0:39:10.99,teks umum,,0,0,0,,bahawa tubuhnya dikawal oleh kuasa jiwa
Dialog: 0,0:39:12.62,0:39:15.21,teks umum,,0,0,0,,Saya menyedari perkara ini ketika pertama kali bertemu
Dialog: 0,0:39:20.59,0:39:23.13,teks umum,,0,0,0,,Satu-satunya perkara yang setanding dengan kuasa ahli silap mata,
Dialog: 0,0:39:23.22,0:39:25.34,teks umum,,0,0,0,,ini adalah kuasa ilahi para pendeta
Dialog: 0,0:39:26.89,0:39:30.26,teks umum,,0,0,0,,Saya rasa mayat Mu Deok pada asalnya milik
Dialog: 0,0:39:30.85,0:39:33.31,teks umum,,0,0,0,,kepada seseorang yang mempunyai kuasa ilahi
Dialog: 0,0:39:57.29,0:39:59.29,kenangan,,0,0,0,,Ini akan membantu mengurangkan kesakitan
Dialog: 0,0:40:00.46,0:40:04.09,kenangan,,0,0,0,,Ia hanya akan memudahkan, tetapi tidak akan menghilangkannya
Dialog: 0,0:40:05.38,0:40:07.43,teks umum,,0,0,0,,Saya perlu memberikan ini kepadanya
Dialog: 0,0:40:14.72,0:40:17.56,teks umum,,0,0,0,,Kamu gali kubur kamu sendiri
Dialog: 0,0:40:19.90,0:40:22.52,teks umum,,0,0,0,,Berani menipu saya, berpura-pura menjadi anak saya,
Dialog: 0,0:40:23.19,0:40:24.07,teks umum,,0,0,0,,Jadi saya?
Dialog: 0,0:40:26.78,0:40:28.61,teks umum,,0,0,0,,Anda tidak tertipu
Dialog: 0,0:40:28.70,0:40:31.45,teks umum,,0,0,0,,Anda tahu, tetapi anda berpura-pura
Dialog: 0,0:40:32.99,0:40:34.70,teks umum,,0,0,0,,Adakah kerana batu ais?
Dialog: 0,0:40:36.41,0:40:37.62,teks umum,,0,0,0,,Ya
Dialog: 0,0:40:37.71,0:40:40.83,teks umum,,0,0,0,,Seorang ibu sentiasa mengenali anaknya
Dialog: 0,0:40:42.50,0:40:44.05,teks umum,,0,0,0,,Sebelum anda melonggarkan lidah,
Dialog: 0,0:40:44.13,0:40:48.30,teks umum,,0,0,0,,lebih baik bunuh kamu di sini dan sekarang
Dialog: 0,0:40:49.80,0:40:51.18,teks umum,,0,0,0,,Jadi anda dan ini
Dialog: 0,0:40:52.68,0:40:54.01,teks umum,,0,0,0,,adakah anda mengenali?
Dialog: 0,0:40:54.85,0:40:57.02,teks umum,,0,0,0,,Bu Young memakai pembalut ini apabila dia menghilangkan diri
Dialog: 0,0:40:58.52,0:41:00.44,teks umum,,0,0,0,,Anda berkata bahawa anda menyulamnya sendiri
Dialog: 0,0:41:11.91,0:41:14.53,teks umum,,0,0,0,,Di manakah anda mendapat ini?
Dialog: 0,0:41:14.62,0:41:16.83,teks umum,,0,0,0,,Adakah Jin Mu memberi anda ini?
Dialog: 0,0:41:19.16,0:41:20.08,teks umum,,0,0,0,,Tidak
Dialog: 0,0:41:21.08,0:41:24.75,teks umum,,0,0,0,,Hanya saya tahu siapa pemiliknya yang sebenar
Dialog: 0,0:41:24.84,0:41:26.05,teks umum,,0,0,0,, Beritahu saya
Dialog: 0,0:41:27.55,0:41:29.38,teks umum,,0,0,0,,Anak perempuan awak masih hidup
Dialog: 0,0:41:31.01,0:41:32.39,teks umum,,0,0,0,,Bunuh saya,
Dialog: 0,0:41:33.09,0:41:34.89,teks umum,,0,0,0,, dan anda tidak akan berjumpa dengannya lagi
Dialog: 0,0:41:37.47,0:41:38.60,teks umum,,0,0,0,,Saya akan selamatkan nyawa awak
Dialog: 0,0:41:39.18,0:41:41.02,teks umum,,0,0,0,,Di mana anak perempuan saya?
Dialog: 0,0:41:45.23,0:41:46.48,teks umum,,0,0,0,,Jangan tergesa-gesa saya
Dialog: 0,0:41:48.53,0:41:52.24,teks umum,,0,0,0,,Saya akan memberitahu anda apabila saya pasti keselamatan saya
Dialog: 0,0:42:09.30,0:42:10.92,teks umum,,0,0,0,,Batu ais telah hilang
Dialog: 0,0:42:11.42,0:42:14.09,teks umum,,0,0,0,,Tetapi ada orang nomad yang dicipta oleh abang dan kakak Choi
Dialog: 0,0:42:14.18,0:42:16.35,teks umum,,0,0,0,,dan organisasi mereka
Dialog: 0,0:42:17.06,0:42:20.73,teks umum,,0,0,0,,Sosnovy Bor dan Jinyeowon akan memusnahkan mereka semua
Dialog: 0,0:42:21.73,0:42:24.56,teks umum,,0,0,0,,saya minta bantuan anda
Dialog: 0,0:42:28.23,0:42:29.99,teks umum,,0,0,0,,Anda tanya saya
Dialog: 0,0:42:30.61,0:42:33.03,teks umum,,0,0,0,,tidak melindungi Jin Mu walaupun dia ditangkap?
Dialog: 0,0:42:33.11,0:42:37.70,teks umum,,0,0,0,,Saya tahu dia adalah guru kamu, tetapi saya percaya kamu tidak dibutakan olehnya
Dialog: 0,0:42:40.16,0:42:41.50,teks umum,,0,0,0,,Jadi awak percayakan saya?
Dialog: 0,0:42:42.79,0:42:44.00,teks umum,,0,0,0,,Maka kamu percaya,
Dialog: 0,0:42:44.96,0:42:47.92,teks umum,,0,0,0,,bahawa saya dilahirkan di bawah bintang Raja dan membuang penghalang?
Dialog: 0,0:42:52.63,0:42:56.34,teks umum,,0,0,0,,Penghalang batu ais telah diangkat dan anda berada di sana
Dialog: 0,0:42:56.43,0:42:58.22,teks umum,,0,0,0,,Kemudian bintang Raja bersinar
Dialog: 0,0:42:59.22,0:43:03.02,teks umum,,0,0,0,, Kerana, seperti orang lain, saya percaya bahawa bintang telah bersinar di atas anda
Dialog: 0,0:43:07.86,0:43:10.65,teks umum,,0,0,0,,Saya tidak keseorangan di sini pada hari itu
Dialog: 0,0:43:11.86,0:43:13.24,teks umum,,0,0,0,,Anda berdiri di sana
Dialog: 0,0:43:13.32,0:43:17.16,teks umum,,0,0,0,,Siapa yang akan perasan orang lain selain anda?
Dialog: 0,0:43:17.24,0:43:21.45,teks umum,,0,0,0,,Chan Wook ada di sana, saya pasti awak nampak dia
Dialog: 0,0:43:23.87,0:43:25.79,teks umum,,0,0,0,,Dia seperti anak kepada saya
Dialog: 0,0:43:26.92,0:43:29.17,teks umum,,0,0,0,,Engkau menyelamatkan nyawanya, Tuanku
Dialog: 0,0:43:30.17,0:43:32.21,teks umum,,0,0,0,,Saya amat berterima kasih untuk ini
Dialog: 0,0:43:42.93,0:43:45.69,teks umum,,0,0,0,,Hari ini saya akan meninggalkan Sosnovy Bor
Dialog: 0,0:43:45.77,0:43:47.02,teks umum,,0,0,0,,Saya tinggalkan kerja di sini
Dialog: 0,0:43:49.31,0:43:51.86,teks umum,,0,0,0,,Anda telah melalui begitu banyak untuk mendapatkan pekerjaan ini
Dialog: 0,0:43:52.61,0:43:54.94,teks umum,,0,0,0,,Sayangnya awak pergi kerana majlis perkahwinan
Dialog: 0,0:43:55.61,0:43:59.24,teks umum,,0,0,0,,Sebaliknya, anda akan menjadi wanita keluarga Chan
Dialog: 0,0:44:01.95,0:44:04.04,teks umum,,0,0,0,,Moo Dok, tahniah atas perkahwinan anda
Dialog: 0,0:44:04.12,0:44:05.21,teks umum,,0,0,0,,Bergembiralah
Dialog: 0,0:44:12.17,0:44:14.59,teks umum,,0,0,0,,Mari kita lakukan sekarang. jom pergi
Dialog: 0,0:44:15.26,0:44:18.97,teks umum,,0,0,0,,Kenapa awak berdiri di situ? ikut saya
Dialog: 0,0:44:22.81,0:44:27.44,teks umum,,0,0,0,,Yang Mulia, terima kasih kerana menyelamatkan nyawa saya
Dialog: 0,0:44:28.19,0:44:31.56,teks umum,,0,0,0,,Saya harap bintang Raja akan bersinar selamanya
Dialog: 0,0:44:31.65,0:44:33.86,teks umum,,0,0,0,,Cukup. Tidak perlu berpura-pura
Dialog: 0,0:44:34.44,0:44:35.36,teks umum,,0,0,0,, Janggal
Dialog: 0,0:44:37.99,0:44:41.32,teks umum,,0,0,0,,Anda tahu bahawa Chan Wook yang menyelamatkan semua orang pada hari itu
Dialog: 0,0:44:41.41,0:44:45.62,teks umum,,0,0,0,,Seperti yang anda berdua bersetuju, saya tidak akan memberitahu satu jiwa yang hidup
Dialog: 0,0:44:45.70,0:44:46.87,teks umum,,0,0,0,,Jadi jangan risau
Dialog: 0,0:44:48.79,0:44:52.13,teks umum,,0,0,0,,Anda fikir saya bimbang kehilangan kemasyhuran?
Dialog: 0,0:44:52.21,0:44:54.84,teks umum,,0,0,0,,Saya hanya jengkel dengan sanjungan semua orang
Dialog: 0,0:44:54.92,0:44:57.67,teks umum,,0,0,0,,Mereka semua memuji kamu
Dialog: 0,0:44:57.76,0:45:01.01,teks umum,,0,0,0,,Anda boleh terima pujian ini
Dialog: 0,0:45:01.09,0:45:03.89,teks umum,,0,0,0,,Memang tidak menyenangkan mendengar sanjungan daripada orang yang tidak dikenali, tetapi...
Dialog: 0,0:45:04.60,0:45:06.81,teks umum,,0,0,0,,Apabila anda berterima kasih kepada saya, mengetahui keseluruhan kebenaran,
Dialog: 0,0:45:08.43,0:45:11.19,teks umum,,0,0,0,,nampaknya awak sedang bergurau. menjengkelkan
Dialog: 0,0:45:16.40,0:45:18.49,teks umum,,0,0,0,,Saya faham anda tidak selesa
Dialog: 0,0:45:20.78,0:45:23.45,teks umum,,0,0,0,,Anda tidak akan melihat saya lagi
Dialog: 0,0:45:23.95,0:45:25.03,teks umum,,0,0,0,,Jadi jangan risau
Dialog: 0,0:45:27.08,0:45:28.16,teks umum,,0,0,0,,Saya dengar
Dialog: 0,0:45:29.54,0:45:32.04,teks umum,,0,0,0,,- Anda akan pergi bersamanya\N{\i1}- Ya
Dialog: 0,0:45:32.13,0:45:35.46,teks umum,,0,0,0,,Kami akan berpindah dari sini dan tinggal bersama
Dialog: 0,0:45:36.05,0:45:37.09,teks umum,,0,0,0,,Bersama?
Dialog: 0,0:45:39.97,0:45:42.01,teks umum,,0,0,0,,Saya boleh menghalang anda daripada pergi dengan mudah
Dialog: 0,0:45:42.76,0:45:44.80,teks umum,,0,0,0,,Anda fikir saya akan biarkan dia pergi,
Dialog: 0,0:45:45.64,0:45:47.27,teks umum,,0,0,0,,bila dia tahu kelemahan saya?
Dialog: 0,0:45:50.06,0:45:54.90,teks umum,,0,0,0,,Dan jika kita kekal rapat, apakah perasaan anda?
Dialog: 0,0:45:57.53,0:46:00.95,teks umum,,0,0,0,,Ia tidak akan berakhir dengan hanya satu kerengsaan
Dialog: 0,0:46:07.29,0:46:08.29,teks umum,,0,0,0,,Ya
Dialog: 0,0:46:08.79,0:46:11.71,teks umum,,0,0,0,,Won Moo Deok, awak mendengar aduan saya yang kecil
Dialog: 0,0:46:12.75,0:46:14.75,teks umum,,0,0,0,,Dengar ini juga
Dialog: 0,0:46:15.59,0:46:18.71,teks umum,,0,0,0,,Saya akan berasa tidak berharga, mengetahui bahawa dia melakukan apa yang saya tidak boleh
Dialog: 0,0:46:19.26,0:46:22.76,teks umum,,0,0,0,,Dan berpura-pura bahawa ini semua jasa saya, saya akan menjadi lebih menyedihkan
Dialog: 0,0:46:22.84,0:46:23.89,teks umum,,0,0,0,,Tetapi yang paling berkuasa
Dialog: 0,0:46:25.76,0:46:27.85,teks umum,,0,0,0,,Saya akan sangat menghina...
Dialog: 0,0:46:29.85,0:46:32.69,teks umum,,0,0,0,,kamu berdua, berjumpa dengan kamu
Dialog: 0,0:46:36.36,0:46:37.52,teks umum,,0,0,0,,Saya sudah berkata,
Dialog: 0,0:46:37.61,0:46:41.07,teks umum,,0,0,0,,Saya tidak berpegang pada apa yang saya tidak boleh pegang
Dialog: 0,0:46:41.15,0:46:43.91,teks umum,,0,0,0,,Adakah anda tahu apa yang akan berlaku jika saya cuba memegang seseorang dan saya tidak boleh?
Dialog: 0,0:46:45.78,0:46:47.87,teks umum,,0,0,0,,Anda akan menyalahkan lelaki ini
Dialog: 0,0:46:49.24,0:46:50.87,teks umum,,0,0,0,,dan hapuskannya?
Dialog: 0,0:46:50.95,0:46:54.79,teks umum,,0,0,0,,Jika kasihan diri berubah menjadi kekejaman atau kemarahan,
Dialog: 0,0:46:57.59,0:47:00.63,teks umum,,0,0,0,,mengelakkan saya tidak akan membetulkan apa-apa
Dialog: 0,0:47:03.26,0:47:05.39,teks umum,,0,0,0,,Sejauh ini saya
Dialog: 0,0:47:07.18,0:47:08.47,teks umum,,0,0,0,,tidak dapat memahami anda
Dialog: 0,0:47:22.74,0:47:23.90,teks umum,,0,0,0,,Kawan-kawan,
Dialog: 0,0:47:24.99,0:47:26.45,teks umum,,0,0,0,,Saya akan berkahwin esok!
Dialog: 0,0:47:32.91,0:47:34.04,teks umum,,0,0,0,,Kamu lelaki
Dialog: 0,0:47:34.62,0:47:37.75,teks umum,,0,0,0,,Kami tidak akan berjumpa dengan satu sama lain begitu kerap lagi
Dialog: 0,0:47:37.83,0:47:38.75,italic,,0,0,0,,Sudah tentu tidak
Dialog: 0,0:47:38.84,0:47:41.88,teks umum,,0,0,0,,Cho Young tidak akan membenarkan ini
Dialog: 0,0:47:41.96,0:47:43.76,teks umum,,0,0,0,,- Baik ibu mertuanya\N- Tepat
Dialog: 0,0:47:44.92,0:47:46.51,teks umum,,0,0,0,,Dia tidak akan datang lagi
Dialog: 0,0:47:47.22,0:47:48.85,teks umum,,0,0,0,,menunggang kuda
Dialog: 0,0:47:48.93,0:47:50.97,teks umum,,0,0,0,,Atau pergi memancing bersama kami
Dialog: 0,0:47:51.97,0:47:55.06,teks umum,,0,0,0,,Saya akan cari masa untuk berjumpa dengan awak
Dialog: 0,0:47:55.14,0:47:57.81,teks umum,,0,0,0,,Dan bagaimana? Adakah anda akan berbohong tentang latihan?
Dialog: 0,0:47:57.90,0:48:00.69,teks umum,,0,0,0,,Adakah anda serius akan berbohong kepada paderi perempuan Jinyoewon?
Dialog: 0,0:48:00.77,0:48:02.48,teks umum,,0,0,0,,Dia akan ditangkap serta-merta
Dialog: 0,0:48:02.57,0:48:05.07,teks umum,,0,0,0,,Dia akan mengelilingi anda dengan peninggalannya
Dialog: 0,0:48:05.15,0:48:06.61,teks umum,,0,0,0,,dan akan menuntut kebenaran
Dialog: 0,0:48:06.70,0:48:08.45,teks umum,,0,0,0,,Kemudian awak mengaku segalanya
Dialog: 0,0:48:09.03,0:48:11.74,teks umum,,0,0,0,,Mereka akan mencabut semua rambutnya
Dialog: 0,0:48:11.83,0:48:13.95,teks umum,,0,0,0,,Mari kita mulakan dengan fakta bahawa dia mempunyai rambut nipis
Dialog: 0,0:48:19.58,0:48:20.54,italic,,0,0,0,,Saya faham
Dialog: 0,0:48:20.63,0:48:21.79,teks umum,,0,0,0,,Anda iri dengan saya
Dialog: 0,0:48:22.63,0:48:24.88,teks umum,,0,0,0,,Saya masih gembira
Dialog: 0,0:48:24.96,0:48:27.72,teks umum,,0,0,0,,Saya akan berkahwin dengan cinta pertama saya
Dialog: 0,0:48:28.34,0:48:32.76,teks umum,,0,0,0,,Saya berikan kepada anda, bujang, tenaga baik saya
Dialog: 0,0:48:35.22,0:48:38.27,teks umum,,0,0,0,,- Ditangkap\N- Ya, anda ada Moo Deok
Dialog: 0,0:48:38.35,0:48:40.40,teks umum,,0,0,0,,- Ya\N- Tapi dia bukan cinta pertama awak
Dialog: 0,0:48:40.48,0:48:43.19,teks umum,,0,0,0,,- Adakah dia sudah yang kelapan?\N- Tidak... tidak... tidak
Dialog: 0,0:48:43.27,0:48:45.65,teks umum,,0,0,0,,- Cuma jangan beritahu dia\N- Okay
Dialog: 0,0:48:45.74,0:48:47.61,teks umum,,0,0,0,,Baiklah, kami akan tinggalkan anda
Dialog: 0,0:48:47.70,0:48:50.20,teks umum,,0,0,0,,Yul, awak boleh ambil tenaga saya
Dialog: 0,0:48:50.28,0:48:51.32,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:48:52.37,0:48:53.58,teks umum,,0,0,0,,Saya telah ditolak baru-baru ini
Dialog: 0,0:48:53.66,0:48:54.83,condong,,0,0,0,,Apa?
Dialog: 0,0:48:54.91,0:48:56.16,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:48:57.62,0:48:58.83,teks umum,,0,0,0,,Mu Dok?
Dialog: 0,0:49:02.84,0:49:03.96,teks umum,,0,0,0,,Tidak
Dialog: 0,0:49:04.50,0:49:07.47,teks umum,,0,0,0,,Saya tidak mempunyai perasaan terhadapnya
Dialog: 0,0:49:11.76,0:49:13.72,contact,,0,0,0,,Lalu siapa?
Dialog: 0,0:49:14.60,0:49:16.18,teks umum,,0,0,0,,Uk, adakah anda tahu?
Dialog: 0,0:49:16.81,0:49:18.73,teks umum,,0,0,0,,Saya ada tekaan sendiri
Dialog: 0,0:49:23.69,0:49:27.15,teks umum,,0,0,0,,Adakah anda sudah memutuskan ke mana anda akan pergi, Chan Wook?
Dialog: 0,0:49:28.44,0:49:31.36,teks umum,,0,0,0,,Kampung Sari. Saya ingin tahu sesuatu
Dialog: 0,0:49:31.45,0:49:34.87,teks umum,,0,0,0,,Adakah anda bersedia untuk kembali ke Kubu Soho?
Dialog: 0,0:49:35.49,0:49:37.62,teks umum,,0,0,0,,Awak akan pergi selepas perkahwinan saya, kan?
Dialog: 0,0:49:37.70,0:49:39.16,teks umum,,0,0,0,,Sedikit kemudian, saya rasa
Dialog: 0,0:49:40.00,0:49:41.54,teks umum,,0,0,0,,Saya belum sembuh
Dialog: 0,0:49:41.62,0:49:43.25,teks umum,,0,0,0,,Adakah ia masih menyakitkan?
Dialog: 0,0:49:43.33,0:49:45.17,teks umum,,0,0,0,,Saya dengar luka sudah sembuh
Dialog: 0,0:49:45.75,0:49:47.67,teks umum,,0,0,0,,Apa? Adakah Cikgu Huo seorang penipu?
Dialog: 0,0:49:48.51,0:49:50.05,contact,,0,0,0,,Luka telah sembuh,
Dialog: 0,0:49:50.13,0:49:51.59,teks umum,,0,0,0,,tetapi ia masih menyakitkan saya
Dialog: 0,0:49:53.14,0:49:54.10,teks umum,,0,0,0,,Saya akan baik-baik saja
Dialog: 0,0:50:08.69,0:50:09.86,teks umum,,0,0,0,,En. Jadi Yul
Dialog: 0,0:50:11.28,0:50:13.45,teks umum,,0,0,0,,Saya tidak tahu sama ada saya perlu memberikan ini kepada anda
Dialog: 0,0:50:13.53,0:50:16.87,teks umum,,0,0,0,,Tetapi seorang wanita pengemis meminta untuk menyampaikan
Dialog: 0,0:50:28.92,0:50:33.18,italic,,0,0,0,,Ubat ini akan melegakan sakit dada
Dialog: 0,0:50:33.26,0:50:34.93,italic,,0,0,0,,Anda mesti menerimanya
Dialog: 0,0:50:36.26,0:50:38.39,luar skrin,,0,0,0,,Orang ini tahu tentang keadaan saya
Dialog: 0,0:50:39.10,0:50:40.22,di sebalik tabir,,0,0,0,,Siapa ini?
Dialog: 0,0:50:51.49,0:50:54.11,teks umum,,0,0,0,,Saya tahu tuan akan kembali, Yang Amat Mulia
Dialog: 0,0:50:55.91,0:50:59.16,teks umum,,0,0,0,,Chan Wook keletihan, saya akan hantar dia pergi dari sini
Dialog: 0,0:50:59.24,0:51:01.37,teks umum,,0,0,0,,Dia tidak mempunyai batu ais
Dialog: 0,0:51:02.04,0:51:04.87,teks umum,,0,0,0,,Akui jenayah anda pada penghujung hari
Dialog: 0,0:51:04.96,0:51:06.21,teks umum,,0,0,0,,Jika anda tidak melakukan ini,
Dialog: 0,0:51:08.54,0:51:10.92,teks umum,,0,0,0,,Saya akan menangkap kamu dan menghukum kamu sendiri
Dialog: 0,0:51:13.80,0:51:16.05,teks umum,,0,0,0,,Semua orang menipu anda
Dialog: 0,0:51:19.01,0:51:21.39,teks umum,,0,0,0,,Adakah anda melihat ketua Sosnovy Bor hari ini?
Dialog: 0,0:51:21.93,0:51:23.60,teks umum,,0,0,0,,Apa yang dia cakap?
Dialog: 0,0:51:23.68,0:51:26.81,teks umum,,0,0,0,,Adakah anda gembira kerana bintang itu bersinar di atas anda?
Dialog: 0,0:51:27.69,0:51:31.36,teks umum,,0,0,0,,Dia tahu itu Chan Wook, bukan awak
Dialog: 0,0:51:33.74,0:51:35.99,contact,,0,0,0,,Begitu juga Cikgu Li
Dialog: 0,0:51:36.07,0:51:37.99,teks umum,,0,0,0,,Dia memecah masuk istana
Dialog: 0,0:51:38.07,0:51:40.33,teks umum,,0,0,0,,dan menyebut bintang Raja
Dialog: 0,0:51:43.37,0:51:46.92,teks umum,,0,0,0,,Adakah anda ingin mengatakan bahawa semua orang menipu saya dan mengejek saya?
Dialog: 0,0:51:47.00,0:51:49.42,teks umum,,0,0,0,,Mereka cuba melindungi Chan Wook
Dialog: 0,0:51:50.00,0:51:51.84,teks umum,,0,0,0,,Orang untuk siapa bintang bersinar mempunyai batu
Dialog: 0,0:51:51.92,0:51:53.30,teks umum,,0,0,0,,dan Hutan Pine melindunginya
Dialog: 0,0:51:53.38,0:51:56.43,teks umum,,0,0,0,,Hanya saya boleh melindungi anda
Dialog: 0,0:52:01.39,0:52:03.81,miring,,0,0,0,,Chan Wook menyimpan rahsia besar
Dialog: 0,0:52:04.39,0:52:05.94,teks umum,,0,0,0,,Saya akan dedahkan dia...
Dialog: 0,0:52:07.48,0:52:08.56,teks umum,,0,0,0,,dan...
Dialog: 0,0:52:09.48,0:52:13.23,teks umum,,0,0,0,,Saya akan membuatkan awak tenggelam ke dasar
Dialog: 0,0:52:22.95,0:52:24.04,contact,,0,0,0,,Nah...
Dialog: 0,0:52:25.04,0:52:27.46,teks umum,,0,0,0,,Siapa yang minum kesemuanya?
Dialog: 0,0:52:27.54,0:52:28.75,teks umum,,0,0,0,,Cawan anda kosong
Dialog: 0,0:52:28.83,0:52:30.92,teks umum,,0,0,0,,Adakah itu anda? Awak minum semuanya
Dialog: 0,0:52:31.54,0:52:33.13,teks umum,,0,0,0,,Jika cawan kosong, tuangkan saya satu lagi
Dialog: 0,0:52:33.21,0:52:34.63,teks umum,,0,0,0,,- Seperti ini\N- Minum
Dialog: 0,0:52:34.71,0:52:37.26,teks umum,,0,0,0,,"Minumlah"? Beraninya awak?
Dialog: 0,0:52:37.34,0:52:38.72,contact,,0,0,0,,-“Minum”?.. \N- Ke bawah
Dialog: 0,0:52:40.47,0:52:42.26,teks umum,,0,0,0,,Oh, ini tuan muda kita!
Dialog: 0,0:52:42.35,0:52:46.85,teks umum,,0,0,0,,Kami meraikan sesuatu hari ini
Dialog: 0,0:52:46.93,0:52:49.56,teks umum,,0,0,0,,- Pemergiannya dari Sosnovy Bor\N- Saya nampak
Dialog: 0,0:52:49.65,0:52:52.15,teks umum,,0,0,0,,- Hello, Chan Wook\N- Hei!
Dialog: 0,0:52:52.73,0:52:54.53,teks umum,,0,0,0,,Dia tuan muda kamu
Dialog: 0,0:52:55.40,0:52:57.99,teks umum,,0,0,0,,Maaf. kesilapan saya
Dialog: 0,0:52:58.07,0:53:00.20,miring,,0,0,0,,- Betul\N{\i0}- Mereka minum terlalu banyak
Dialog: 0,0:53:00.28,0:53:01.28,contact,,0,0,0,,Tuan Muda
Dialog: 0,0:53:01.37,0:53:03.49,teks umum,,0,0,0,,Pergi ke sini
Dialog: 0,0:53:07.00,0:53:10.00,teks umum,,0,0,0,,Saya akan tunjukkan sesuatu yang menakjubkan
Dialog: 0,0:53:10.08,0:53:11.54,teks umum,,0,0,0,,Apabila Moo Deok mabuk,
Dialog: 0,0:53:12.46,0:53:14.71,teks umum,,0,0,0,,dia tidak bercakap dialek
Dialog: 0,0:53:16.38,0:53:17.97,teks umum,,0,0,0,,Hebat, bukan?
Dialog: 0,0:53:18.55,0:53:19.63,teks umum,,0,0,0,,Saya tidak boleh
Dialog: 0,0:53:19.72,0:53:22.30,teks umum,,0,0,0,,tunjukkan sesuatu yang sangat berbaloi
Dialog: 0,0:53:23.01,0:53:25.93,teks umum,,0,0,0,,Tetapi saya boleh terbang ke bumbung
Dialog: 0,0:53:26.02,0:53:28.27,teks umum,,0,0,0,,Betulkah? Cubalah
Dialog: 0,0:53:28.35,0:53:30.19,teks umum,,0,0,0,,- Cuba?\N- Cubalah
Dialog: 0,0:53:31.52,0:53:32.48,teks umum,,0,0,0,,Lihat dengan teliti
Dialog: 0,0:53:39.61,0:53:41.78,teks umum,,0,0,0,,Sekejap
Dialog: 0,0:53:44.58,0:53:45.99,teks umum,,0,0,0,,- Mu Dok...\N- Tidak berfungsi
Dialog: 0,0:53:46.08,0:53:47.04,teks umum,,0,0,0,,Duduk
Dialog: 0,0:53:47.12,0:53:49.54,teks umum,,0,0,0,,Tidak boleh melakukannya lagi
Dialog: 0,0:53:50.79,0:53:52.71,teks umum,,0,0,0,,Dan saya tidak boleh menarik pedang saya
Dialog: 0,0:53:52.79,0:53:54.46,teks umum,,0,0,0,,Apa? ini?
Dialog: 0,0:53:54.54,0:53:57.13,teks umum,,0,0,0,,Ini bukan milik anda. Ini pedang Nak Soo
Dialog: 0,0:53:57.96,0:53:59.30,contact,,0,0,0,,- Tuan Muda\N{\i0}- Ya?
Dialog: 0,0:53:59.38,0:54:03.64,teks umum,,0,0,0,,Kenapa awak bawa sampah ini lagi?
Dialog: 0,0:54:03.72,0:54:05.55,teks umum,,0,0,0,,Saya akan singkirkan dia
Dialog: 0,0:54:06.51,0:54:08.22,teks umum,,0,0,0,,Beri saya satu peluang lagi
Dialog: 0,0:54:08.31,0:54:09.56,teks umum,,0,0,0,,- Sudah tentu, cuba\N- Duduk
Dialog: 0,0:54:09.64,0:54:11.60,miring,,0,0,0,,Terbang, lakukannya
Dialog: 0,0:54:15.77,0:54:18.19,teks umum,,0,0,0,,- Bersihkan di sini dan tidur\N- Pernahkah anda melihat ini?
Dialog: 0,0:54:18.28,0:54:20.03,teks umum,,0,0,0,,- Saya akan berurusan dengan Moo Dok \N- Saya boleh terbang
Dialog: 0,0:54:20.11,0:54:22.03,teks umum,,0,0,0,,- Jangan gerak\N- Ia berkesan
Dialog: 0,0:54:22.11,0:54:23.99,teks umum,,0,0,0,,Dia benar-benar terbang
Dialog: 0,0:54:25.12,0:54:27.12,teks umum,,0,0,0,,Bab, adakah anda melihat ini?
Dialog: 0,0:54:27.20,0:54:28.95,teks umum,,0,0,0,,Saya juga mahu terbang
Dialog: 0,0:54:29.04,0:54:32.00,teks umum,,0,0,0,,Kamu anak-anak tidak tahu siapa saya
Dialog: 0,0:54:32.08,0:54:35.13,teks umum,,0,0,0,,Saya adalah tuan di sini. Adakah anda mahu saya tunjukkan kepada anda?
Dialog: 0,0:54:38.71,0:54:39.84,teks umum,,0,0,0,,Saya adalah tuan di sini
Dialog: 0,0:54:40.51,0:54:42.17,teks umum,,0,0,0,,Hari ini bukan hari saya
Dialog: 0,0:54:49.35,0:54:50.35,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:54:50.43,0:54:53.56,teks umum,,0,0,0,,Jangan minum lagi. Anda akan memberitahu semua orang bahawa anda adalah Nak Soo
Dialog: 0,0:54:56.36,0:54:58.15,teks umum,,0,0,0,,Saya perlu memberitahu anda sesuatu
Dialog: 0,0:54:58.23,0:54:59.90,teks umum,,0,0,0,,Tidur, awak akan beritahu saya esok
Dialog: 0,0:55:01.61,0:55:02.95,teks umum,,0,0,0,,Diperlukan hari ini
Dialog: 0,0:55:03.45,0:55:06.32,teks umum,,0,0,0,,Bagaimana jika saya mati esok tanpa memberitahu awak apa-apa?
Dialog: 0,0:55:06.99,0:55:09.37,teks umum,,0,0,0,,Baiklah, cakap. Tiba-tiba mati
Dialog: 0,0:55:09.45,0:55:10.54,teks umum,,0,0,0,,Saya sedang mendengar
Dialog: 0,0:55:15.21,0:55:16.42,teks umum,,0,0,0,,Chang Wook
Dialog: 0,0:55:19.46,0:55:21.05,teks umum,,0,0,0,,Saya sangat menyukai awak
Dialog: 0,0:55:39.44,0:55:41.73,teks umum,,0,0,0,,Ya, dan terus tidur
Dialog: 0,0:55:41.82,0:55:43.19,teks umum,,0,0,0,,Sama seperti itu
Dialog: 0,0:55:46.66,0:55:49.70,teks umum,,0,0,0,,Kita mesti beritahu dia apa yang Cikgu Li cakap
Dialog: 0,0:55:51.41,0:55:54.50,kenangan miring,,0,0,0,,Saya rasa badan Moo Deok pada asalnya milik
Dialog: 0,0:55:55.00,0:55:57.33,kenangan miring,,0,0,0,,kepada seseorang yang mempunyai kuasa ilahi
Dialog: 0,0:55:58.71,0:56:01.05,teks umum,,0,0,0,,Mungkin saya akan tahu bagaimana saya sampai ke kampung Sari
Dialog: 0,0:57:43.86,0:57:46.98,teks umum,,0,0,0,,Biar yang lalu berlalu
Dialog: 0,0:57:47.07,0:57:49.28,teks umum,,0,0,0,,Sekarang anda akan menjadi saudara mara
Dialog: 0,0:57:50.61,0:57:53.16,teks umum,,0,0,0,,Cho Young tidak menyertai keluarga Park
Dialog: 0,0:57:53.74,0:57:56.58,teks umum,,0,0,0,,Dan Gu ini menjadi sebahagian daripada kami
Dialog: 0,0:57:57.45,0:57:59.00,teks umum,,0,0,0,,Dia tidak bergerak bersama anda
Dialog: 0,0:57:59.75,0:58:02.71,teks umum,,0,0,0,,Awak cakap macam tu, dan orang bergosip,
Dialog: 0,0:58:02.79,0:58:05.38,teks umum,,0,0,0,,bahawa Park Dan Gu akan menjadi Jin Dan Gu tidak lama lagi
Dialog: 0,0:58:07.09,0:58:09.05,teks umum,,0,0,0,,Anak perempuan mereka akan memberikan nama keluarga kami
Dialog: 0,0:58:09.72,0:58:11.05,teks umum,,0,0,0,,Dan untuk anak saya - milik kita
Dialog: 0,0:58:12.09,0:58:14.80,teks umum,,0,0,0,,Jangan berdebat pada hari yang indah ini
Dialog: 0,0:58:14.89,0:58:16.81,teks umum,,0,0,0,,Tetamu akan tiba tidak lama lagi
Dialog: 0,0:58:16.89,0:58:19.73,teks umum,,0,0,0,,Bersedia untuk menyambut mereka
Dialog: 0,0:58:19.81,0:58:21.52,miring,,0,0,0,,Ayuh
Dialog: 0,0:58:24.73,0:58:25.98,teks umum,,0,0,0,,Di manakah Dan Gu?
Dialog: 0,0:58:26.07,0:58:28.11,teks umum,,0,0,0,,Dia akan pergi ke Saejukwon bersama Cho Young dahulu
Dialog: 0,0:58:28.69,0:58:31.40,teks umum,,0,0,0,,Mereka ingin menemui bapanya dan bertanya khabar
Dialog: 0,0:58:32.57,0:58:33.61,teks umum,,0,0,0,,Di manakah Moo Dok?
Dialog: 0,0:58:35.37,0:58:37.91,teks umum,,0,0,0,,Saya tidak tahu. Dia datang dulu, tapi saya tak nampak dia
Dialog: 0,0:58:39.50,0:58:42.04,teks umum,,0,0,0,,Adakah dia malu dan mengelak saya kerana semalam?
Dialog: 0,0:59:46.69,0:59:47.60,teks umum,,0,0,0,,Nak Su,
Dialog: 0,0:59:48.94,0:59:51.82,teks umum,,0,0,0,,anda tidak boleh menghunus pedang anda kerana anda terperangkap dalam badan ini
Dialog: 0,0:59:53.03,0:59:56.11,contact,,0,0,0,,Anda adalah senjata terakhir saya
Dialog: 0,0:59:56.20,0:59:59.20,teks umum,,0,0,0,,Saya menggunakan semua kuasa saya untuk menghubungi anda
Dialog: 0,1:00:00.12,1:00:01.95,teks umum,,0,0,0,,Sebaik sahaja anda mendapat kekuatan anda semula,
Dialog: 0,1:00:03.00,1:00:04.54,teks umum,,0,0,0,,anda menjadi liar
Dialog: 0,1:01:02.05,1:01:05.06,kenangan miring,,0,0,0,,Hanya saya yang tahu siapa pemiliknya yang sebenar
Dialog: 0,1:01:05.81,1:01:08.19,kenangan,,0,0,0,,Anak perempuan awak masih hidup
Dialog: 0,1:01:09.14,1:01:10.27,kenangan,,0,0,0,,Ibu
Dialog: 0,1:01:21.32,1:01:22.37,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:01:28.58,1:01:31.75,teks umum,,0,0,0,,Di manakah pembantu rumah anda Moo Deok pernah tinggal?
Dialog: 0,1:01:33.21,1:01:36.05,teks umum,,0,0,0,,Adakah ibu bapanya masih hidup?
Dialog: 0,1:01:37.01,1:01:40.26,teks umum,,0,0,0,,No. Dia berasal dari kampung Sari
Dialog: 0,1:01:41.34,1:01:43.89,teks umum,,0,0,0,,Apabila dia dituduh melakukan jenayah So Yi,
Dialog: 0,1:01:43.97,1:01:45.51,teks umum,,0,0,0,,Saya memberitahu anda segala-galanya
Dialog: 0,1:01:46.31,1:01:48.10,teks umum,,0,0,0,,saya minta awak tolong perempuan malang ini
Dialog: 0,1:01:48.85,1:01:50.31,teks umum,,0,0,0,,Tetapi anda tidak membantu
Dialog: 0,1:01:51.60,1:01:54.44,teks umum,,0,0,0,,Jadi Yi kenal Moo Deok?
Dialog: 0,1:01:55.07,1:01:57.99,teks umum,,0,0,0,,Ya. Cikgu Cho Young juga mengenalinya
Dialog: 0,1:02:04.12,1:02:05.87,teks umum,,0,0,0,,Anda sangat cantik
Dialog: 0,1:02:08.12,1:02:10.96,teks umum,,0,0,0,,Saya boleh katakan perkara yang sama tentang anda
Dialog: 0,1:02:14.38,1:02:17.25,teks umum,,0,0,0,,Mari kita bertanya khabar dengan ayah kamu
Dialog: 0,1:02:17.84,1:02:19.59,teks umum,,0,0,0,,Anda tidak boleh tinggal lama di sini
Dialog: 0,1:02:20.17,1:02:23.30,teks umum,,0,0,0,,Jika orang tua tahu, mereka akan duduk di telinga mereka
Dialog: 0,1:02:23.93,1:02:24.97,teks umum,,0,0,0,,Ya
Dialog: 0,1:02:25.93,1:02:27.01,teks umum,,0,0,0,,Terima kasih,
Dialog: 0,1:02:28.60,1:02:31.10,teks umum,,0,0,0,,lelaki... suami
Dialog: 0,1:02:36.52,1:02:37.69,teks umum,,0,0,0,,Berhati-hati,
Dialog: 0,1:02:39.65,1:02:40.65,teks umum,,0,0,0,,perempuan... isteri
Dialog: 0,1:02:41.74,1:02:42.91,teks umum,,0,0,0,,Isteri saya
Dialog: 0,1:02:44.28,1:02:45.62,miring,,0,0,0,,Tunggu
Dialog: 0,1:02:51.04,1:02:54.25,teks umum,,0,0,0,,Mu Dok? Kenapa awak ada di sini?
Dialog: 0,1:02:59.59,1:03:02.17,teks umum,,0,0,0,,Mu Dok, awak tak boleh bawa pedang
Dialog: 0,1:03:05.59,1:03:07.89,kenangan condong,,0,0,0,,Bunuh Jin Woo Tak dulu
Dialog: 0,1:03:13.85,1:03:14.81,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,1:03:45.84,1:03:47.26,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:03:49.76,1:03:50.89,teks umum,,0,0,0,,Anda
Dialog: 0,1:03:51.56,1:03:53.56,teks am,,0,0,0,,Pembantu rumah Chang Wook?
Dialog: 0,1:03:54.14,1:03:55.31,teks umum,,0,0,0,,Awak okay?
Dialog: 0,1:04:21.34,1:04:23.26,kenangan miring,,0,0,0,,Bunuh Jin Woo Tak
Dialog: 0,1:04:30.89,1:04:32.01,teks umum,,0,0,0,,Ayah!
Dialog: 0,1:04:34.18,1:04:36.27,teks umum,,0,0,0,,Bapa!
Dialog: 0,1:04:38.56,1:04:39.65,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,1:04:39.73,1:04:40.81,teks umum,,0,0,0,,apa yang awak buat?
Dialog: 0,1:04:40.90,1:04:42.40,teks umum,,0,0,0,,Dia...
Dialog: 0,1:04:42.48,1:04:45.19,teks umum,,0,0,0,,Dia seorang askar upahan
Dialog: 0,1:04:45.94,1:04:47.11,teks umum,,0,0,0,,Run, Cho Young
Dialog: 0,1:04:47.20,1:04:48.45,contact,,0,0,0,,Cepat!
Dialog: 0,1:05:13.39,1:05:14.64,teks umum,,0,0,0,,Encik!
Dialog: 0,1:05:14.72,1:05:15.93,teks umum,,0,0,0,,Stop Mu Dok
Dialog: 0,1:05:19.60,1:05:20.44,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:05:22.65,1:05:24.52,contact,,0,0,0,,Hentikan dia!
Dialog: 0,1:05:25.86,1:05:26.90,teks umum,,0,0,0,,Tidak...
Dialog: 0,1:05:55.93,1:05:57.93,teks umum,,0,0,0,,Bunuh dia! Sebaliknya
Dialog: 0,1:06:15.49,1:06:16.54,teks umum,,0,0,0,,Bapa!
Dialog: 0,1:06:17.99,1:06:20.04,teks umum,,0,0,0,,Ayah!
Dialog: 0,1:06:20.58,1:06:21.42,teks umum,,0,0,0,,Bapa!
Dialog: 0,1:06:23.25,1:06:24.08,kenangan condong,,0,0,0,,Bapa
Dialog: 0,1:06:25.67,1:06:27.71,contact,,0,0,0,,Bapa
Dialog: 0,1:06:29.17,1:06:30.55,teks umum,,0,0,0,,Bapa
Dialog: 0,1:06:31.17,1:06:32.76,teks umum,,0,0,0,,Jangan mati
Dialog: 0,1:06:36.10,1:06:37.85,teks umum,,0,0,0,,Ayah, tolong...
Dialog: 0,1:06:38.60,1:06:40.14,teks umum,,0,0,0,,Ayah
Dialog: 0,1:06:43.15,1:06:44.27,kenangan,,0,0,0,,Ayah
Dialog: 0,1:06:52.15,1:06:55.99,contact,,0,0,0,,Ayah, jangan mati
Dialog: 0,1:06:57.70,1:06:58.79,teks umum,,0,0,0,,Nak Su,
Dialog: 0,1:07:00.25,1:07:02.66,contact,,0,0,0,,bunuh mereka yang melakukan ini kepada bapa kamu
Dialog: 0,1:07:08.04,1:07:09.25,italic,,0,0,0,,Ayah!
Dialog: 0,1:07:10.09,1:07:11.30,condong,,0,0,0,,Ayah!
Dialog: 0,1:07:11.38,1:07:12.76,condong,,0,0,0,,Ayah!
Dialog: 0,1:07:13.51,1:07:14.76,condong,,0,0,0,,Ayah!
Dialog: 0,1:07:44.92,1:07:47.13,teks umum,,0,0,0,,Beraninya awak muncul di sini?
Dialog: 0,1:07:48.38,1:07:49.92,teks umum,,0,0,0,,Tangkap Jin Mu!
Dialog: 0,1:07:51.51,1:07:53.05,teks umum,,0,0,0,,Saya, Timbalan Gwangju,
Dialog: 0,1:07:53.13,1:07:55.01,teks umum,,0,0,0,,datang untuk menangkap nomad
Dialog: 0,1:07:57.59,1:08:00.93,teks umum,,0,0,0,,Nak Su, nomad, kini di Sosnovy Bor
Dialog: 0,1:08:02.06,1:08:04.10,teks umum,,0,0,0,,- Nak Su?\N{\i1}- Bab!
Dialog: 0,1:08:08.65,1:08:10.11,teks umum,,0,0,0,,Masalah!
Dialog: 0,1:08:10.19,1:08:12.69,teks umum,,0,0,0,,Ada upahan muncul di Sejukwon
Dialog: 0,1:08:15.11,1:08:18.28,teks umum,,0,0,0,,Dia membunuh Encik Jin
Dialog: 0,1:08:19.28,1:08:22.16,teks am,,0,0,0,,Inilah askar upahan yang saya cari. Nak Soo
Dialog: 0,1:08:22.91,1:08:23.79,teks umum,,0,0,0,,Tidak
Dialog: 0,1:08:24.62,1:08:26.08,teks umum,,0,0,0,,Ini...
Dialog: 0,1:08:26.16,1:08:27.37,teks umum,,0,0,0,,Ia adalah Moo Deok
Dialog: 0,1:08:27.46,1:08:31.29,teks umum,,0,0,0,,Moo Dok ini ialah Nak Soo
Dialog: 0,1:08:38.64,1:08:39.68,teks am,,0,0,0,,Upah!
Dialog: 0,1:08:40.35,1:08:42.22,teks am,,0,0,0,,Tenaga upahan di Sejukwon!
Dialog: 0,1:09:14.88,1:09:16.30,teks umum,,0,0,0,,Tangkap dia!
Dialog: 0,1:09:38.32,1:09:39.90,teks umum,,0,0,0,,- Tangkap!\N- Ya!
Dialog: 0,1:11:20.17,1:11:21.17,teks umum,,0,0,0,,Mu Dok
Dialog: 0,1:11:25.01,1:11:26.14,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:11:29.39,1:11:30.52,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:11:35.10,1:11:36.10,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:11:42.03,1:11:42.86,teks umum,,0,0,0,,Chan Wook?
Dialog: 0,1:11:57.38,1:11:58.71,teks umum,,0,0,0,,Adakah itu saya?
Dialog: 0,1:12:00.42,1:12:01.67,teks umum,,0,0,0,,Ini saya
Dialog: 0,1:12:03.92,1:12:05.30,teks umum,,0,0,0,,Saya menikam awak
Dialog: 0,1:12:26.61,1:12:27.74,kenangan condong,,0,0,0,,Satu
Dialog: 0,1:12:30.20,1:12:33.08,kenangan,,0,0,0,,Saya akan pegang tangan awak dalam cincin tangan saya
Dialog: 0,1:12:33.95,1:12:36.54,kenangan,,0,0,0,,Pasti tiada siapa yang mempunyai cincin seperti itu
Dialog: 0,1:12:39.75,1:12:42.05,kenangan miring,,0,0,0,,Jika saya menjadi Nak Su, saya akan dalam bahaya
Dialog: 0,1:12:42.63,1:12:45.92,kenangan miring,,0,0,0,,Ia tidak sepatutnya membimbangkan anda apa yang berlaku kepada saya kemudian
Dialog: 0,1:12:48.64,1:12:49.55,kenangan,,0,0,0,,Kenapa?
Dialog: 0,1:12:50.05,1:12:52.26,kenangan,,0,0,0,,Kerana kita tidak lagi menjadi pelajar dan guru?
Dialog: 0,1:12:52.35,1:12:54.60,kenangan,,0,0,0,,Anda tiada sebab untuk melindungi saya
Dialog: 0,1:12:54.68,1:12:56.98,kenangan,,0,0,0,,Dan saya ada sebab untuk lebih lembut dengan awak
Dialog: 0,1:12:58.19,1:13:00.36,kenangan,,0,0,0,,Itu janji kami
Dialog: 0,1:13:00.90,1:13:02.69,kenangan miring,,0,0,0,,Kemudian berjanji satu perkara lagi
Dialog: 0,1:13:02.77,1:13:04.23,kenangan,,0,0,0,,Apabila anda mendapat semula kuasa anda,
Dialog: 0,1:13:04.94,1:13:07.45,kenangan,,0,0,0,,jika anda perlu mengangkat pedang pada seseorang,
Dialog: 0,1:13:08.49,1:13:10.20,kenangan,,0,0,0,,biar saya yang pertama
Dialog: 0,1:13:11.45,1:13:12.62,kenangan,,0,0,0,,Jika awak tikam saya,
Dialog: 0,1:13:12.70,1:13:17.46,kenangan,,0,0,0,,Saya akan mati kepada mereka yang membebaskan tentera upahan
Dialog: 0,1:13:24.09,1:13:25.21,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,1:13:29.55,1:13:30.76,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,1:13:34.85,1:13:36.60,teks umum,,0,0,0,,Tidak...
Dialog: 0,1:14:36.66,1:14:37.66,miring,,0,0,0,,Tangkap dia!
Dialog: 0,1:15:20.83,1:15:21.87,teks umum,,0,0,0,,Uk...
Dialog: 0,1:15:28.96,1:15:30.42,teks umum,,0,0,0,,Uk!
Dialog: 0,1:16:22.72,1:16:24.02,teks umum,,0,0,0,,Saya rasa,
Dialog: 0,1:16:27.02,1:16:30.31,teks umum,,0,0,0,,Wook tahu bahawa Moo Deok ialah Nak Soo
Dialog: 0,1:16:32.03,1:16:33.40,teks umum,,0,0,0,,Jin Mu
Dialog: 0,1:16:34.44,1:16:37.41,teks umum,,0,0,0,,mencari bukti perkara ini di Jeonjingak semasa kita bercakap
Dialog: 0,1:16:42.95,1:16:44.54,teks umum,,0,0,0,,saya juga tahu
Dialog: 0,1:16:45.71,1:16:47.54,teks umum,,0,0,0,,Biar saya kejar dia
Dialog: 0,1:16:47.62,1:16:50.21,teks umum,,0,0,0,,dan ketahui apa yang berlaku
Dialog: 0,1:16:50.29,1:16:53.30,teks umum,,0,0,0,,Anda adalah anak sulung keluarga So
Dialog: 0,1:16:54.30,1:16:57.05,teks umum,,0,0,0,,Anda tidak tahu apa-apa
Dialog: 0,1:16:58.51,1:17:01.51,teks umum,,0,0,0,,Mulai saat ini, anda dilarang meninggalkan tempat ini
Dialog: 0,1:17:13.52,1:17:14.73,teks umum,,0,0,0,,Ayah meninggal dunia
Dialog: 0,1:17:15.53,1:17:18.20,teks umum,,0,0,0,,di tangan seorang askar upahan
Dialog: 0,1:17:18.82,1:17:20.11,teks umum,,0,0,0,,Saya akan cari
Dialog: 0,1:17:21.37,1:17:23.33,teks umum,,0,0,0,,dan saya akan bunuh dia
Dialog: 0,1:17:26.20,1:17:27.25,teks umum,,0,0,0,,Tidak
Dialog: 0,1:17:30.63,1:17:34.80,teks umum,,0,0,0,,Anda mesti mencari dia dan membawanya kembali hidup-hidup
Dialog: 0,1:17:36.55,1:17:40.09,teks umum,,0,0,0,,Nak Su hanyalah jiwa dalam jasad ini
Dialog: 0,1:17:40.18,1:17:43.30,teks umum,,0,0,0,,saya kena cari kepunyaan siapa badan ini
Dialog: 0,1:17:45.81,1:17:48.31,teks umum,,0,0,0,,Bawa dia kembali pada sebarang kos
Dialog: 0,1:17:58.61,1:18:01.24,teks umum,,0,0,0,,Nak Su mengamalkan alkimia jiwa
Dialog: 0,1:18:01.32,1:18:03.57,teks umum,,0,0,0,,bersama keluarga Choi
Dialog: 0,1:18:04.37,1:18:06.37,teks umum,,0,0,0,,Saya sudah menangkapnya sebelum ini,
Dialog: 0,1:18:06.45,1:18:08.00,teks umum,,0,0,0,,apabila dia membunuh semua orangnya
Dialog: 0,1:18:08.08,1:18:10.75,teks umum,,0,0,0,,Jadi saya tahu bahawa Nak Soo masih hidup
Dialog: 0,1:18:11.37,1:18:13.96,teks umum,,0,0,0,,Saya mencari dia selama ini,
Dialog: 0,1:18:14.04,1:18:15.63,teks umum,,0,0,0,,untuk membersihkan nama anda
Dialog: 0,1:18:15.71,1:18:16.88,teks umum,,0,0,0,,Dan dia seorang anak perempuan
Dialog: 0,1:18:16.96,1:18:19.38,teks am,,0,0,0,,Cho Chun, dibunuh oleh keluarga utama?
Dialog: 0,1:18:20.26,1:18:23.39,teks umum,,0,0,0,,Mungkin memasuki Sosnovy Bor untuk membalas dendam bapanya
Dialog: 0,1:18:24.26,1:18:27.06,teks umum,,0,0,0,,Anak lelaki Chang Gang menyimpan dia rapat, mengetahui siapa dia?
Dialog: 0,1:18:27.14,1:18:28.93,teks umum,,0,0,0,,Dia sudah mati, kita tidak akan tahu itu
Dialog: 0,1:18:29.02,1:18:32.60,teks umum,,0,0,0,,Tetapi saya harap anda akan menghukum Sosnovy Bor untuk segala-galanya
Dialog: 0,1:18:37.15,1:18:38.69,teks umum,,0,0,0,,Di mana Nak Su?
Dialog: 0,1:18:38.78,1:18:41.28,teks umum,,0,0,0,,Ahli silap mata Jeonbugwan sedang mencarinya
Dialog: 0,1:18:41.36,1:18:45.78,teks umum,,0,0,0,,Dia mula menjadi liar, tidak lama lagi dia akan berubah menjadi batu dan mati
Dialog: 0,1:19:03.05,1:19:04.09,kenangan condong,,0,0,0,,Moo Dok
Dialog: 0,1:19:08.43,1:19:09.81,kenangan,,0,0,0,,Moo Dok
Dialog: 0,1:19:13.85,1:19:14.98,kenangan,,0,0,0,,Chan Wook!
Dialog: 0,1:19:35.08,1:19:39.05,teks umum,,0,0,0,,Saya tidak boleh bersedih, saya tidak boleh menguburkannya
Dialog: 0,1:19:39.63,1:19:41.84,teks umum,,0,0,0,, dengan betul, kerana dia seorang penjenayah
Dialog: 0,1:19:42.59,1:19:45.68,teks umum,,0,0,0,,Bagaimana dia boleh dibakar dengan cara ini?
Dialog: 0,1:19:48.14,1:19:49.89,teks umum,,0,0,0,,Anda tidak boleh berbuat demikian!
Dialog: 0,1:19:50.47,1:19:52.18,teks umum,,0,0,0,,Hentikan mereka...
Dialog: 0,1:19:54.06,1:19:55.39,teks umum,,0,0,0,,Sosnovy Bor
Dialog: 0,1:19:56.98,1:19:58.23,teks umum,,0,0,0,,tidak bersuara
Dialog: 0,1:19:59.65,1:20:01.28,teks umum,,0,0,0,,dalam soalan ini
Dialog: 0,1:20:03.28,1:20:04.45,teks umum,,0,0,0,,Maaf
Dialog: 0,1:20:24.92,1:20:26.13,teks umum,,0,0,0,,Encik...
Dialog: 0,1:21:27.57,1:21:29.91,teks umum,,0,0,0,,Mengapa saya di sini?
Dialog: 0,1:21:34.41,1:21:35.49,teks umum,,0,0,0,,Sekurang-kurangnya...
Dialog: 0,1:21:39.42,1:21:42.25,teks umum,,0,0,0,,Saya tidak lagi mendengar bunyi loceng
Dialog: 0,1:21:47.92,1:21:50.34,teks umum,,0,0,0,,Nak Su akan pergi ke kubur orang perantau
Dialog: 0,1:21:51.14,1:21:54.26,teks umum,,0,0,0,,Di sana dia akan menemui kematiannya
Dialog: 0,1:22:10.24,1:22:13.01,teks umum,,0,0,0,,Dilahirkan di bawah bintang Raja, kuasa syurga tunduk kepadamu
Dialog: 0,1:22:14.49,1:22:17.62,teks umum,,0,0,0,,Ini bukan bagaimana anda ditakdirkan untuk mati,
Dialog: 0,1:22:18.91,1:22:20.04,teks umum,,0,0,0,,Chang Wook
Dialog: 0,1:22:47.90,1:22:49.07,teks umum,,0,0,0,,En.

