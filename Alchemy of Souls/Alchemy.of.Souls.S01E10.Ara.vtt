Dialogue: 0,0:02:47.14,0:02:52.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,الألقاب,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:00:47.49,0:00:51.04,النص العام,,0,0,0,,ستكون الغرفة فارغة أثناء تواجد السيد في سوسنوفي بور
Dialogue: 0,0:00:51.12,0:00:53.92,نص عام,,0,0,0,,نظف هنا
Dialogue: 0,0:00:54.00,0:00:55.13,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:00:57.75,0:01:02.01,نص عام,,0,0,0,,خرج من المنزل وعاد عدة مرات
Dialogue: 0,0:01:02.59,0:01:05.05,نص عام,,0,0,0,,انتظر يومين، ربما يعود
Dialogue: 0,0:01:05.89,0:01:07.14,نص عام,,0,0,0,,هذه المرة كل شيء مختلف
Dialogue: 0,0:01:07.89,0:01:10.85,نص عام,,0,0,0,,لقد تغير
Dialogue: 0,0:01:12.14,0:01:14.35,نص عام,,0,0,0,,وربما سيتزوج قريباً
Dialogue: 0,0:01:15.06,0:01:16.61,خط مائل,,0,0,0,,لذلك نحن بحاجة إلى التنظيف في كل مكان
Dialogue: 0,0:01:17.27,0:01:19.44,مائل,,0,0,0,,هل هو مخطوب مرة أخرى؟
Dialogue: 0,0:01:20.36,0:01:23.70,general text,,0,0,0,,إذا لم يتزوج هذه المرة فمن غير المرجح أن يحصل على زوجة
Dialogue: 0,0:01:24.28,0:01:25.86,خط مائل,,0,0,0,,هذه المرة كل شيء مختلف!
Dialogue: 0,0:01:25.95,0:01:30.83,النص العام,,0,0,0,,السيد الشاب يقع في حب شخص ما بشدة
Dialogue: 0,0:01:32.37,0:01:33.46,نص عام,,0,0,0,,حقًا يا مو ديوك؟
Dialogue: 0,0:01:35.08,0:01:37.75,نص عام,,0,0,0,,بيضة الطير التي ذكرها
Dialogue: 0,0:01:38.75,0:01:42.80,النص العام,,0,0,0,,أنا متأكد من أن هذه هي الفتاة التي رأيتها في سوسنوفي بور
Dialogue: 0,0:01:43.59,0:01:46.26,نص عام,,0,0,0,,بيضة في عش أعلى شجرة
Dialogue: 0,0:01:46.34,0:01:48.89,النص العام,,0,0,0,,ربما تكون هذه فتاة متطورة،
Dialogue: 0,0:01:49.47,0:01:51.27,نص عام,,0,0,0,,الذي يحتاج إلى الحماية
Dialogue: 0,0:01:51.35,0:01:54.06,نص عام,,0,0,0,,شيء مثل مالك الحزين الأبيض
Dialogue: 0,0:01:54.14,0:01:55.19,نص عام,,0,0,0,,مثلي
Dialogue: 0,0:01:55.27,0:01:56.56,نص عام,,0,0,0,,من يدري؟
Dialogue: 0,0:01:57.31,0:02:02.03,general text,,0,0,0,,يفقس ويتبين أنه نسر متعطش للدماء،
Dialogue: 0,0:02:02.11,0:02:04.19,نص عام,,0,0,0,,ليس مالك الحزين المتطور
Dialogue: 0,0:02:04.78,0:02:05.86,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:02:06.66,0:02:08.24,نص عام,,0,0,0,,النسر المتعطش للدماء، يا له من رعب
Dialogue: 0,0:02:09.07,0:02:11.45,نص عام,,0,0,0,,أتمنى ألا تكون البيضة نقار خشب أو وقواق
Dialogue: 0,0:02:11.54,0:02:13.12,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:02:13.70,0:02:16.71,نص عام,,0,0,0,,سوف يفقس الفرخ ويطير بعيدًا
Dialogue: 0,0:02:18.29,0:02:21.38,النص العام,,0,0,0,,ماذا لو كانت تحبه أيضًا؟
Dialogue: 0,0:02:22.67,0:02:27.34,النص العام,,0,0,0,,إذا كانا قريبين جدًا، فأنا متأكد من أن المشاعر متبادلة
Dialogue: 0,0:02:28.18,0:02:30.39,نص عام,,0,0,0,,لا بد أن الفرخة تحبه
Dialogue: 0,0:02:33.22,0:02:35.39,نص عام,,0,0,0,,آمل أن تكون هذه السيدة هو.
Dialogue: 0,0:02:36.27,0:02:37.81,نص عام,,0,0,0,,تشبه السيدة دو هوا
Dialogue: 0,0:02:40.65,0:02:41.98,نص عام,,0,0,0,,- الخصي لي\N- نعم؟
Dialogue: 0,0:02:42.07,0:02:44.28,نص عام,,0,0,0,,ضعه هناك. هذه كتب تشان ووك
Dialogue: 0,0:02:45.69,0:02:47.11,نص عام,,0,0,0,,أسرع
Dialogue: 0,0:02:51.08,0:02:53.16,خلف الكواليس,,0,0,0,,ما الذي يربطنا بتشان ووك:
Dialogue: 0,0:02:54.41,0:02:56.54,خلف الكواليس,,0,0,0,,الرغبة اليائسة في البقاء على قيد الحياة
Dialogue: 0,0:02:59.92,0:03:02.46,خلف الكواليس,,0,0,0,,وتجد نفسك
Dialogue: 0,0:03:12.10,0:03:14.01,خلف الكواليس,,0,0,0,,عندما نحصل على ما نريد،
Dialogue: 0,0:03:15.39,0:03:18.02,خلف الكواليس,,0,0,0,,سوف نتفرق على الفور في اتجاهات مختلفة
Dialogue: 0,0:03:20.81,0:03:23.07,خلف الكواليس,,0,0,0,,الحب الذي تتحدث عنه الخادمة كيم،
Dialogue: 0,0:03:25.53,0:03:27.74,خارج الشاشة,,0,0,0,,ربما انزلقت بيننا،
Dialogue: 0,0:03:28.82,0:03:33.49,التعليق الصوتي,,0,0,0,,لكن هذه ليست أكثر من قوقعة سأرميها بعيدًا عندما أفقس
Dialogue: 0,0:03:55.64,0:03:58.93,النص العام,,0,0,0,,هل تعلمت بالفعل وكتبت كل شيء؟
Dialogue: 0,0:03:59.02,0:04:02.81,نص عام,,0,0,0,,نعم يمكنك التحقق. أنا متأكد من أنني تذكرت كل شيء
Dialogue: 0,0:04:05.73,0:04:06.90,نص عام,,0,0,0,,ما زال,
Dialogue: 0,0:04:06.98,0:04:09.24,نص عام,,0,0,0,,كان من المفترض أن يستغرق هذا شهرًا على الأقل
Dialogue: 0,0:04:09.32,0:04:13.03,نص عام,,0,0,0,,كان لدي 12 مدرسًا، قرأت هذه الكتب 12 مرة
Dialogue: 0,0:04:13.62,0:04:14.74,نص عام,,0,0,0,,قد يقول المرء،
Dialogue: 0,0:04:14.83,0:04:17.20,نص عام,,0,0,0,,كانت المهمة سهلة للغاية
Dialogue: 0,0:04:17.29,0:04:20.71,النص العام,,0,0,0,,وكنت أتساءل لماذا وافق على اتباع القواعد
Dialogue: 0,0:04:20.79,0:04:22.33,نص عام,,0,0,0,,كان لديه أسباب
Dialogue: 0,0:04:22.42,0:04:25.71,general text,,0,0,0,,الآن أستطيع مغادرة سوسنوفي بور متى شئت. أنا في المنزل
Dialogue: 0,0:04:26.30,0:04:27.50,خط مائل,,0,0,0,,ليس بهذه السرعة
Dialogue: 0,0:04:35.47,0:04:37.06,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:04:37.14,0:04:40.27,نص عام,,0,0,0,,تنص القواعد على أنه يمكنني الخروج إذا أتقنت الأساسيات
Dialogue: 0,0:04:40.35,0:04:42.52,نص عام,,0,0,0,,عندما طلبت قراءة الكتب،
Dialogue: 0,0:04:42.60,0:04:44.65,نص عام,,0,0,0,,لم أقصد أن أتذكرهم فقط
Dialogue: 0,0:04:44.73,0:04:46.65,نص عام,,0,0,0,,كان ينبغي أن تحفظ كل شيء عن ظهر قلب
Dialogue: 0,0:04:47.48,0:04:49.78,نص عام,,0,0,0,,لكن بما أنك ماكر جدًا،
Dialogue: 0,0:04:49.86,0:04:53.16,نص عام,,0,0,0,,لا أعتقد أنك حفظت كل شيء
Dialogue: 0,0:04:54.74,0:04:56.16,نص عام,,0,0,0,,لم أكن أعرف،
Dialogue: 0,0:04:56.87,0:04:59.75,نص عام,,0,0,0,,أن رئيس سوسنوفي بور يمكنه تغيير القواعد كما يشاء
Dialogue: 0,0:05:01.21,0:05:02.04,نص عام,,0,0,0,,هنا
Dialogue: 0,0:05:02.75,0:05:04.67,نص عام,,0,0,0,,لدي مهمة أخرى
Dialogue: 0,0:05:05.25,0:05:07.50,نص عام,,0,0,0,,إذا قرأت هذا الكتاب،
Dialogue: 0,0:05:09.09,0:05:12.13,النص العام,,0,0,0,,سأسمح لك بمغادرة سوسنوفي بور وقتما تشاء
الحوار: 0,0:05:15.68,0:05:16.97,نص عام,,0,0,0,,لا!
Dialogue: 0,0:05:24.48,0:05:26.36,نص عام,,0,0,0,,سأتمكن بالتأكيد من الخروج،
Dialogue: 0,0:05:27.61,0:05:29.07,نص عام,,0,0,0,,إذا قرأته؟
Dialogue: 0,0:05:29.15,0:05:30.23,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:05:31.07,0:05:33.86,نص عام,,0,0,0,,أتمنى قراءة هذا الكتاب
Dialogue: 0,0:05:34.61,0:05:37.20,نص عام,,0,0,0,,أيضًا ليس صعبًا
Dialogue: 0,0:05:38.66,0:05:40.33,نص عام,,0,0,0,,كل شيء سيء
Dialogue: 0,0:05:40.41,0:05:42.75,general text,,0,0,0,,مو ديوك لن يتمكن من رؤية ووك لفترة من الوقت
Dialogue: 0,0:05:56.39,0:05:58.05,نص عام,,0,0,0,,ماذا؟ انها فارغة هنا
Dialogue: 0,0:06:00.47,0:06:04.52,نص عام,,0,0,0,,إطلاقاً. هناك كلمات
Dialogue: 0,0:06:05.77,0:06:06.77,نص عام,,0,0,0,,لا، لا شيء هنا
Dialogue: 0,0:06:06.85,0:06:08.36,نص عام,,0,0,0,,هل ترى شيئاً؟
Dialogue: 0,0:06:09.73,0:06:11.19,نص عام,,0,0,0,,أنت لا ترى شيئًا
Dialogue: 0,0:06:12.11,0:06:14.65,نص عام,,0,0,0,,لا يمكنك قراءة هذا الكتاب إلا بتركيز طاقتك
Dialogue: 0,0:06:14.74,0:06:17.24,النص العام,,0,0,0,,هذا كتاب الأستاذ سيو كيونغ "كلمات من القلب"
Dialogue: 0,0:06:20.95,0:06:21.91,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:06:22.87,0:06:25.71,نص عام,,0,0,0,,إذًا هذه كلمات بالفعل؟
Dialogue: 0,0:06:25.79,0:06:28.50,general text,,0,0,0,,وهل أنا الوحيد الذي لا يستطيع قراءتها؟
Dialogue: 0,0:06:33.59,0:06:35.59,نص عام,,0,0,0,,صديقك تشان ووك,
Dialogue: 0,0:06:35.67,0:06:37.43,نص عام,,0,0,0,,لابد أنك لم تعرف نوع هذا الكتاب
Dialogue: 0,0:06:37.51,0:06:41.05,النص العام,,0,0,0,,لم يتدرب قط. كيف يعرف؟
Dialogue: 0,0:06:41.14,0:06:43.02,general text,,0,0,0,,سيتم حبسه في قاعة التدريب حتى
Dialogue: 0,0:06:43.10,0:06:44.56,نص عام,,0,0,0,,حتى يقرأه
Dialogue: 0,0:06:45.27,0:06:46.44,نص عام,,0,0,0,,أشعر بالأسف عليه
Dialogue: 0,0:06:46.52,0:06:48.40,نص عام,,0,0,0,,لقد ظل عالقًا هناك لمدة ستة أشهر
Dialogue: 0,0:06:49.44,0:06:51.86,نص عام,,0,0,0,,ستة أشهر ليست طويلة
Dialogue: 0,0:06:51.94,0:06:55.40,general text,,0,0,0,,لقد أتقن ريوسو من خلال الحظ وليس التدريب
Dialogue: 0,0:06:56.32,0:06:58.74,نص عام,,0,0,0,,سوف يستغرق الأمر أكثر من عام
Dialogue: 0,0:07:07.83,0:07:10.46,general text,,0,0,0,,كيف نعرفك إذا لم نر هذا الكتاب بأنفسنا؟
Dialogue: 0,0:07:10.54,0:07:13.42,نص عام,,0,0,0,,أنا متأكد من أنك لن تحتاج إلى وقت أقل
Dialogue: 0,0:07:13.50,0:07:16.01,general text,,0,0,0,,كما أنه تقدم أكثر منك،
Dialogue: 0,0:07:16.76,0:07:18.43,نص عام,,0,0,0,,الذي يختلف عنه
Dialogue: 0,0:07:19.26,0:07:20.64,نص عام,,0,0,0,,لم نحمل هذا الكتاب بين أيدينا
Dialogue: 0,0:07:25.77,0:07:28.52,نص عام,,0,0,0,,إنه على حق. لا تتحدث عبثا
Dialogue: 0,0:07:28.60,0:07:29.69,نص عام,,0,0,0,,إلى اللقاء
Dialogue: 0,0:07:31.36,0:07:32.52,نص عام,,0,0,0,,...
Dialogue: 0,0:07:37.57,0:07:40.07,general text,,0,0,0,,لماذا أعطاه عمه هذا الكتاب بالفعل؟
Dialogue: 0,0:07:41.70,0:07:42.95,نص عام,,0,0,0,,أنا في حيرة من أمري
Dialogue: 0,0:07:43.03,0:07:46.79,general text,,0,0,0,,لن يتمكن من فعل أي شيء وهو عالق هناك.
Dialogue: 0,0:07:53.63,0:07:54.71,نص عام,,0,0,0,,أنا
Dialogue: 0,0:07:55.63,0:07:57.67,نص عام,,0,0,0,,لن أقوم بتدريس أوكا
Dialogue: 0,0:07:58.30,0:08:01.64,النص العام,,0,0,0,,سأبقيه قريبًا وأراقبه
Dialogue: 0,0:08:01.72,0:08:04.55,نص عام,,0,0,0,,حتى لا يسبب المزيد من المشاكل
Dialogue: 0,0:08:04.64,0:08:09.56,general text,,0,0,0,,إذًا لم تأخذه تحت جناحك، بل حبسته ببساطة في سوسنوفي بور؟
Dialogue: 0,0:08:11.19,0:08:13.65,general text,,0,0,0,,دخلت المملكة المتحدة بصوت عالٍ سوسنوفي بور،
Dialogue: 0,0:08:14.23,0:08:15.86,نص عام,,0,0,0,,سيصل والده قريباً
Dialogue: 0,0:08:15.94,0:08:18.03,نص عام,,0,0,0,,أبي؟ تشانغ قانغ؟
Dialogue: 0,0:08:18.11,0:08:21.11,general text,,0,0,0,,كان خوف تشانغ جانج الأكبر هو أن يفتح ووك البوابة
Dialogue: 0,0:08:22.66,0:08:25.33,نص عام,,0,0,0,,وسوف يتم طرحه بشكل مفتوح للعالم
Dialogue: 0,0:08:25.91,0:08:27.29,النص العام,,0,0,0,,بمجرد أن يكتشف "تشانغ جانج" الأمر،
Dialogue: 0,0:08:28.20,0:08:30.08,نص عام,,0,0,0,,سيعود فوراً
Dialogue: 0,0:08:30.16,0:08:34.50,general text,,0,0,0,,يجب على غوانغجو العودة وإيقاف جين مو
Dialogue: 0,0:08:35.75,0:08:37.67,نص عام,,0,0,0,,كل شيء سيُحل،
Dialogue: 0,0:08:39.13,0:08:41.30,نص عام,,0,0,0,,عندما يعود
Dialogue: 0,0:08:42.93,0:08:45.01,نص عام,,0,0,0,,آسف على تشان ووك
Dialogue: 0,0:08:45.85,0:08:47.76,نص عام,,0,0,0,,لقد وصل حتى الآن
Dialogue: 0,0:08:47.85,0:08:50.10,نص عام,,0,0,0,,لا يوجد تدريب على الإطلاق
Dialogue: 0,0:08:50.18,0:08:51.56,general text,,0,0,0,,كيف سيقرأ "كلمات القلب"؟
Dialogue: 0,0:08:51.64,0:08:52.89,نص عام,,0,0,0,,هذا مستحيل
Dialogue: 0,0:09:01.40,0:09:03.86,general text,,0,0,0,,لماذا يحتاج أيضًا إلى حمل الطعام؟
Dialogue: 0,0:09:04.78,0:09:06.74,نص عام,,0,0,0,,سمعت عنه شيئاً
Dialogue: 0,0:09:06.83,0:09:09.12,general text,,0,0,0,,هناك شائعات غريبة عن العائلة، لا مهارات،
Dialogue: 0,0:09:09.20,0:09:11.50,نص عام,,0,0,0,,- شخصية سيئة\N- غير صحيح
Dialogue: 0,0:09:13.71,0:09:14.88,نص عام,,0,0,0,,إنه جيد
Dialogue: 0,0:09:14.96,0:09:17.04,نص عام,,0,0,0,,من أين أتيت بالفكرة؟
Dialogue: 0,0:09:17.13,0:09:18.67,النص العام,,0,0,0,,إنه ضار جدًا،
Dialogue: 0,0:09:18.75,0:09:21.97,general text,,0,0,0,,أن الشخص الوحيد الذي يستطيع التأقلم معه هو مو دوك.
Dialogue: 0,0:09:24.22,0:09:25.76,النص العام,,0,0,0,,- مو دوك؟\N- نعم
Dialogue: 0,0:09:25.84,0:09:28.81,النص العام,,0,0,0,,هذه هي الخادمة التي معه دائماً
Dialogue: 0,0:09:33.98,0:09:35.15,ذكريات,,0,0,0,,مو دوك
Dialogue: 0,0:09:35.81,0:09:38.48,ذكريات,,0,0,0,,سمعت أنك كنت موجودًا طوال الليل
Dialogue: 0,0:09:38.57,0:09:41.69,ذكريات,,0,0,0,,اعتقدت أنه مو دوك. آسف
Dialogue: 0,0:09:43.24,0:09:45.95,نص عام,,0,0,0,,لهذا السبب ظن أنني مو دوك
Dialogue: 0,0:09:52.08,0:09:53.16,نص عام,,0,0,0,,مرحباً
Dialogue: 0,0:09:55.37,0:09:56.79,نص عام,,0,0,0,,نحن من سيجوكون
Dialogue: 0,0:09:57.67,0:09:59.09,نص عام,,0,0,0,,هنا سيدتي
Dialogue: 0,0:10:37.08,0:10:39.42,نص عام,,0,0,0,,هذه... نار...
Dialogue: 0,0:11:05.69,0:11:06.70,ذكريات بخط مائل,,0,0,0,,هنا
Dialogue: 0,0:11:06.78,0:11:08.41,ذكريات,,0,0,0,,لدي مهمة أخرى
Dialogue: 0,0:11:13.83,0:11:15.08,نص عام,,0,0,0,,لقد خدعني
Dialogue: 0,0:11:15.16,0:11:17.12,نص عام,,0,0,0,,ملفوف حول إصبعي!
Dialogue: 0,0:11:34.26,0:11:36.10,نص عام,,0,0,0,,إنه أنت مرة أخرى!
Dialogue: 0,0:11:36.18,0:11:39.94,نص عام,,0,0,0,,نعم. هل أنت ذاهب إلى مكان ما؟
Dialogue: 0,0:11:40.02,0:11:42.40,نص عام,,0,0,0,,حسنًا، نعم. أحتاج إلى مقابلة شخص ما
Dialogue: 0,0:11:43.69,0:11:45.57,نص عام,,0,0,0,,ولكن لماذا عبر النافذة؟
Dialogue: 0,0:11:47.86,0:11:49.20,نص عام,,0,0,0,,هذا هروب
Dialogue: 0,0:11:51.24,0:11:53.99,نص عام,,0,0,0,,تظاهر أنك لم ترى أي شيء
Dialogue: 0,0:11:57.50,0:12:01.79,خط مائل,,0,0,0,,الآنسة هيو غير صبورة للغاية. لماذا لم تنتظرني؟
Dialogue: 0,0:12:01.88,0:12:04.21,مائل,,0,0,0,,لقد غادرت بدوني
Dialogue: 0,0:12:08.84,0:12:10.22,نص عام,,0,0,0,,ما هو؟
Dialogue: 0,0:12:11.84,0:12:13.39,النص العام,,0,0,0,,أليس تشان ووك موجودًا؟
Dialogue: 0,0:12:13.97,0:12:15.56,نص عام,,0,0,0,,لا، إنه هناك
Dialogue: 0,0:12:16.18,0:12:17.52,نص عام,,0,0,0,,فلنصعد إذن إلى الطابق العلوي
Dialogue: 0,0:12:17.60,0:12:21.31,نص عام,,0,0,0,,أريد التحدث معه
Dialogue: 0,0:12:21.39,0:12:23.10,نص عام,,0,0,0,,وحدي
Dialogue: 0,0:12:25.61,0:12:28.78,نص عام,,0,0,0,,سيستغرق هذا بعض الوقت. انتظر بالخارج
Dialogue: 0,0:12:48.63,0:12:51.59,general text,,0,0,0,,لقد وصل مو دوك، السيد من سوسنوفي بور.
Dialogue: 0,0:12:51.68,0:12:53.18,نص عام,,0,0,0,,أبحث عنك
Dialogue: 0,0:13:10.86,0:13:12.53,نص عام,,0,0,0,,مرحبًا سيد يول
Dialogue: 0,0:13:15.12,0:13:16.83,نص عام,,0,0,0,,في انتظار أوكا؟
Dialogue: 0,0:13:18.79,0:13:20.83,نص عام,,0,0,0,,لن يبقى هنا لفترة من الوقت
Dialogue: 0,0:13:21.62,0:13:23.54,نص عام,,0,0,0,,تم تكليفه بمهمة صعبة للغاية
Dialogue: 0,0:13:24.29,0:13:25.79,نص عام,,0,0,0,,يستطيع التعامل معها
Dialogue: 0,0:13:26.67,0:13:28.75,نص عام,,0,0,0,,الشيء الأساسي هو البقاء هناك
Dialogue: 0,0:13:29.34,0:13:31.84,نص عام,,0,0,0,,وتابع التعلم
Dialogue: 0,0:13:32.59,0:13:35.59,general text,,0,0,0,,قلقت عليك منذ ذلك اليوم، لكن مظهرك جيد.
Dialogue: 0,0:13:36.64,0:13:38.51,نص عام,,0,0,0,,ماذا كنت تفعل؟
Dialogue: 0,0:13:39.26,0:13:42.98,النص العام,,0,0,0,,أنا خادمة هنا، عملت بالطبع
Dialogue: 0,0:13:43.77,0:13:45.98,النص العام,,0,0,0,,العذراء كيم ليست هنا الآن
Dialogue: 0,0:13:46.06,0:13:47.56,نص عام,,0,0,0,,يمكنك الانتظار بالداخل
Dialogue: 0,0:13:48.15,0:13:49.90,النص العام,,0,0,0,,لقد جئت إليك وليس إليها
Dialogue: 0,0:13:51.90,0:13:52.94,نص عام,,0,0,0,,لي؟
Dialogue: 0,0:13:53.65,0:13:56.32,نص عام,,0,0,0,,لماذا تريد رؤيتي؟
Dialogue: 0,0:13:57.16,0:13:58.20,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:13:58.83,0:14:00.04,نص عام,,0,0,0,,مظلة
Dialogue: 0,0:14:00.95,0:14:04.71,نص عام,,0,0,0,,جئت لأخذ المظلة التي لا تزال لديك
Dialogue: 0,0:14:06.08,0:14:07.46,نص عام,,0,0,0,,المظلة؟
Dialogue: 0,0:14:07.54,0:14:10.34,نص عام,,0,0,0,,تمزقت بسبب الريح، رميتها بعيدًا
Dialogue: 0,0:14:11.76,0:14:12.71,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:14:15.05,0:14:16.01,نص عام,,0,0,0,,ثم دعنا نذهب
Dialogue: 0,0:14:16.72,0:14:17.55,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:14:17.64,0:14:19.22,نص عام,,0,0,0,,للجديد
Dialogue: 0,0:14:19.30,0:14:21.93,نص عام,,0,0,0,,اشتري لي مظلة جديدة
Dialogue: 0,0:14:24.56,0:14:27.35,نقوش,,0,0,0,,المظلات
Dialogue: 0,0:14:30.61,0:14:33.44,نص عام,,0,0,0,,هذا هو بالضبط نفس ما لديك
Dialogue: 0,0:14:33.53,0:14:34.90,نص عام,,0,0,0,,إنها رخيصة...
Dialogue: 0,0:14:36.78,0:14:39.12,نص عام,,0,0,0,,مظلة لمرة واحدة وورقة رخيصة
Dialogue: 0,0:14:39.20,0:14:41.37,النص العام,,0,0,0,,منجمي مصنوع من جلد الغنم الباهظ الثمن والخيزران
Dialogue: 0,0:14:42.95,0:14:44.37,نص عام,,0,0,0,,عزيزي؟
Dialogue: 0,0:14:45.08,0:14:47.37,general text,,0,0,0,,لماذا أعطيت الخادمة مظلة غالية الثمن؟
Dialogue: 0,0:14:47.46,0:14:49.38,نص عام,,0,0,0,,أعرتك إياها
Dialogue: 0,0:14:49.46,0:14:51.63,نص عام,,0,0,0,,الآن حان الوقت لإعادته إليّ
Dialogue: 0,0:14:54.34,0:14:56.59,نص عام,,0,0,0,,كانت هذه مظلتي الوحيدة
Dialogue: 0,0:14:56.67,0:14:59.80,نص عام,,0,0,0,,لماذا لديك مظلة واحدة فقط؟
Dialogue: 0,0:14:59.89,0:15:02.01,نص عام,,0,0,0,,نادراً ما أمشي تحت المطر
Dialogue: 0,0:15:03.22,0:15:07.14,general text,,0,0,0,,لقد كسرت ساقي عندما كنت طفلاً،\Nما زال يؤلمني عندما يهطل المطر
Dialogue: 0,0:15:08.31,0:15:11.44,النص العام,,0,0,0,,هل ما زالت ساقك تؤلمك؟
Dialogue: 0,0:15:15.69,0:15:18.61,نص عام,,0,0,0,,سيدي. أخبرني بارك كيف كسرت الأمر
Dialogue: 0,0:15:20.03,0:15:21.87,نص عام,,0,0,0,,في دانهيانغك
Dialogue: 0,0:15:21.95,0:15:25.58,general text,,0,0,0,,من المؤسف أنك ساحر ذو ساق ضعيفة
Dialogue: 0,0:15:26.37,0:15:28.79,نص عام,,0,0,0,,ربما تم شفاءه بشكل سيء
Dialogue: 0,0:15:31.21,0:15:32.50,نص عام,,0,0,0,,كان هناك صديق،
Dialogue: 0,0:15:33.38,0:15:35.67,نص عام,,0,0,0,,الذي كان ينتظرني في دانهيانغك
Dialogue: 0,0:15:38.26,0:15:40.47,النص العام,,0,0,0,,أنقذتني وضمدت الجرح
Dialogue: 0,0:15:41.72,0:15:43.97,نص عام,,0,0,0,,ربما لم تشفى الساق بسبب
Dialogue: 0,0:15:45.52,0:15:47.10,نص عام,,0,0,0,,أنني لم أشكرها
Dialogue: 0,0:16:00.61,0:16:02.62,نص عام,,0,0,0,,- يعجبني هذا\N- ماذا؟
Dialogue: 0,0:16:02.70,0:16:04.78,نص عام,,0,0,0,,سأخذ هذه. ادفع
Dialogue: 0,0:16:06.91,0:16:08.16,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:12.96,0:16:14.50,نص عام,,0,0,0,,- سنأخذ هذه\N- حسنًا
Dialogue: 0,0:16:14.59,0:16:17.05,نص عام,,0,0,0,,اكتب باسم المعلم تشانغ غان
Dialogue: 0,0:16:17.63,0:16:20.51,نص عام,,0,0,0,,لماذا باسمه؟ كان ينبغي عليك أن تدفع
Dialogue: 0,0:16:21.13,0:16:23.55,نص عام,,0,0,0,,من أين تحصل الخادمة على المال؟
Dialogue: 0,0:16:23.64,0:16:24.89,نص عام,,0,0,0,,لديهم
Dialogue: 0,0:16:25.39,0:16:27.02,نص عام,,0,0,0,,رأيت. هل ذهبت
Dialogue: 0,0:16:27.10,0:16:29.39,نص عام,,0,0,0,,اشتري الفساتين بالمال المدخر
Dialogue: 0,0:16:29.48,0:16:30.85,نص عام,,0,0,0,,هذا لأن...
Dialogue: 0,0:16:35.73,0:16:38.57,general text,,0,0,0,,- كم أتقاضى؟\N- لديك ذوق جيد
Dialogue: 0,0:16:38.65,0:16:41.11,نص عام,,0,0,0,,هذه أغلى مظلتنا
Dialogue: 0,0:16:46.45,0:16:47.54,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:16:53.04,0:16:54.25,مائل,,0,0,0,,مو دوك ليس هناك؟
Dialogue: 0,0:16:55.42,0:16:58.30,general text,,0,0,0,,لماذا رحلت الآن؟
Dialogue: 0,0:16:58.38,0:17:00.88,general text,,0,0,0,,سيدي، هل تم طردك مرة أخرى؟
Dialogue: 0,0:17:01.47,0:17:03.97,نص عام,,0,0,0,,لا. جئت لفترة قصيرة
Dialogue: 0,0:17:04.05,0:17:05.89,نص عام,,0,0,0,,قريباً
Dialogue: 0,0:17:05.97,0:17:06.80,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:17:06.89,0:17:08.72,نص عام,,0,0,0,,سيعود مو دوك قريبًا
Dialogue: 0,0:17:09.31,0:17:11.77,general text,,0,0,0,,هل تريد السباحة أولاً؟
Dialogue: 0,0:17:12.48,0:17:13.39,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:17:13.48,0:17:15.90,general text,,0,0,0,,لقد مر وقت طويل منذ أن رششت الماء في المنزل
Dialogue: 0,0:17:15.98,0:17:18.15,نص عام,,0,0,0,,- سأجهز كل شيء\N- حسنًا
Dialogue: 0,0:17:34.08,0:17:35.38,نص عام,,0,0,0,,إنهم...
Dialogue: 0,0:17:36.58,0:17:38.80,general text,,0,0,0,,هل كانت كعكات العسل هذه حلوة دائمًا؟
Dialogue: 0,0:17:41.01,0:17:43.38,general text,,0,0,0,,لماذا لا يوجد شيء كهذا في سوسنوفي بور؟
Dialogue: 0,0:17:43.97,0:17:46.09,النص العام,,0,0,0,,الرأس أيضًا يحب الحلويات
Dialogue: 0,0:18:03.28,0:18:07.20,نص عام,,0,0,0,,هل سننفصل اليوم؟
Dialogue: 0,0:18:08.12,0:18:09.53,نص عام,,0,0,0,,نعم
Dialogue: 0,0:18:10.12,0:18:13.16,general text,,0,0,0,,ستنهي هؤلاء الأخوات الثلاث الثرثارات قريبًا درسهن في زراعة الزهور
Dialogue: 0,0:18:13.25,0:18:14.46,النص العام,,0,0,0,,وسوف يمرون بنا
Dialogue: 0,0:18:15.04,0:18:17.33,نص عام,,0,0,0,,إذا تجادلنا أمامهم،
Dialogue: 0,0:18:17.42,0:18:20.04,نص عام,,0,0,0,,سيطلقون شائعة بأننا انفصلنا
Dialogue: 0,0:18:25.93,0:18:27.51,نص عام,,0,0,0,,كما وعدتكم,
Dialogue: 0,0:18:27.59,0:18:30.01,نص عام,,0,0,0,,سأكون سبباً في فراقنا
Dialogue: 0,0:18:30.64,0:18:33.06,نص عام,,0,0,0,,اضربني على وجهي أولاً
Dialogue: 0,0:18:33.14,0:18:35.94,general text,,0,0,0,,ثم ادفع بعيدًا عندما أحاول الإمساك بك والرحيل
Dialogue: 0,0:18:36.52,0:18:38.56,نص عام,,0,0,0,,هذا قليل...
Dialogue: 0,0:18:38.65,0:18:40.36,نص عام,,0,0,0,,هكذا ينبغي أن يكون
Dialogue: 0,0:18:40.44,0:18:43.44,general text,,0,0,0,,اعتقدوا أننا تشاجرنا وفسخنا الخطوبة
Dialogue: 0,0:18:43.53,0:18:47.03,general text,,0,0,0,,حينها سيقول الناس عنك أشياء سيئة
Dialogue: 0,0:18:47.11,0:18:50.62,general text,,0,0,0,,ومع السمعة السيئة سيكون من الصعب العثور على عروس مناسبة
Dialogue: 0,0:18:53.54,0:18:54.70,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:18:55.41,0:18:57.46,general text,,0,0,0,,لا أريدهم أن يبحثوا لي عن شريك
Dialogue: 0,0:19:01.09,0:19:02.75,النص العام,,0,0,0,,سأتزوج تلك،
Dialogue: 0,0:19:03.88,0:19:05.09,نص عام,,0,0,0,,ما يعجبني
Dialogue: 0,0:19:13.85,0:19:15.18,نص عام,,0,0,0,,مازلت لن أضربك
Dialogue: 0,0:19:16.56,0:19:19.15,نص عام,,0,0,0,,أفضل مع هذا الألم
Dialogue: 0,0:19:19.73,0:19:22.65,نص عام,,0,0,0,,نعم. من الممكن بهذه الطريقة
Dialogue: 0,0:19:26.11,0:19:27.61,النص العام,,0,0,0,,الشاي ساخن جداً
Dialogue: 0,0:19:28.78,0:19:30.91,نص عام,,0,0,0,,سوف يحترق وجهي
Dialogue: 0,0:19:36.25,0:19:37.71,نص عام,,0,0,0,,هيا
Dialogue: 0,0:19:38.54,0:19:39.79,نص عام,,0,0,0,,لا شيء
Dialogue: 0,0:19:41.88,0:19:45.30,نص عام,,0,0,0,,الأداء السحري قريباً
Dialogue: 0,0:19:47.01,0:19:48.76,نص عام,,0,0,0,,أردت المشاهدة حقًا
Dialogue: 0,0:19:49.47,0:19:52.35,النص العام,,0,0,0,,لكنني لا أستطيع إذا افترقنا اليوم
Dialogue: 0,0:19:52.97,0:19:55.22,نص عام,,0,0,0,,لكن... و... لماذا؟
Dialogue: 0,0:19:55.31,0:19:59.14,النص العام,,0,0,0,,كنت لا أزال في المنزل، وهذا ما يقرب من شهر،
Dialogue: 0,0:20:00.06,0:20:02.40,نص عام,,0,0,0,,بعد فسخ الخطبة
Dialogue: 0,0:20:03.77,0:20:06.19,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:20:09.99,0:20:14.16,general text,,0,0,0,,إذن لنؤجل الفراق ليومين؟
Dialogue: 0,0:20:14.24,0:20:15.08,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:20:18.16,0:20:21.29,النص العام,,0,0,0,,لكن تلك الثرثرة الثلاثة ستكون موجودة أيضًا
Dialogue: 0,0:20:22.13,0:20:25.55,نص عام,,0,0,0,,لا أعتقد أن الأمر يستحق الذهاب إلى هناك بمفردك
Dialogue: 0,0:20:26.55,0:20:30.22,general text,,0,0,0,,بما أنهم يعتقدون بالفعل أننا زوجين، سأذهب معك
Dialogue: 0,0:20:32.51,0:20:34.80,نص عام,,0,0,0,,حسنًا، أعتقد أننا نستطيع...
Dialogue: 0,0:20:39.81,0:20:42.56,النص العام,,0,0,0,,أريد حلوى اليقطين والأرز،
Dialogue: 0,0:20:42.65,0:20:44.69,نص عام,,0,0,0,,وكذلك بسكويت العسل
Dialogue: 0,0:20:44.77,0:20:45.94,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:20:47.57,0:20:49.65,نص عام,,0,0,0,,سيدي كالطفل
Dialogue: 0,0:20:49.74,0:20:51.86,general text,,0,0,0,,إنه مؤذ عندما لا يوجد شيء للأكل
Dialogue: 0,0:20:52.78,0:20:53.99,نص عام,,0,0,0,,أخبريه
Dialogue: 0,0:20:56.99,0:20:59.29,النص العام,,0,0,0,,أحب هذه من حبوب لقاح الصنوبر
Dialogue: 0,0:20:59.37,0:21:02.00,نص عام,,0,0,0,,اعتقدت أن تفضيلاتك باهظة الثمن
Dialogue: 0,0:21:02.08,0:21:04.46,النص العام,,0,0,0,,- أعطهم؟\N- لا
Dialogue: 0,0:21:15.76,0:21:17.93,نقشات,,0,0,0,,نستأجر خدمًا في سوسنوفي بور
Dialogue: 0,0:21:19.93,0:21:21.35,نقشات,,0,0,0,,نستأجر خدمًا في سوسنوفي بور
Dialogue: 0,0:21:21.43,0:21:24.40,نقوش,,0,0,0,,الشروط: سليم، متعلم، غير محكوم عليه بجرائم
Dialogue: 0,0:21:26.86,0:21:28.94,نص عام,,0,0,0,,لقد نسبتها إلى عائلة تشان
Dialogue: 0,0:21:35.41,0:21:37.07,نص عام,,0,0,0,,أخبر المالك بهذا
Dialogue: 0,0:21:38.20,0:21:41.79,النص العام,,0,0,0,,ما زال لدي عمل. سأذهب
Dialogue: 0,0:21:58.89,0:21:59.93,نص عام,,0,0,0,,هنا
Dialogue: 0,0:22:00.01,0:22:01.43,نص عام,,0,0,0,,- انظر حولك\N- نعم
Dialogue: 0,0:22:02.23,0:22:03.35,نص عام,,0,0,0,,- آسف\N- نعم؟
Dialogue: 0,0:22:03.43,0:22:04.60,نص عام,,0,0,0,,وداعا
Dialogue: 0,0:22:09.82,0:22:11.86,نص عام,,0,0,0,,هل هذه هي؟
Dialogue: 0,0:22:11.94,0:22:13.11,نص عام,,0,0,0,,هي
Dialogue: 0,0:22:14.90,0:22:16.11,نص عام,,0,0,0,,يا
Dialogue: 0,0:22:16.20,0:22:18.37,النص العام,,0,0,0,,- لقد سرقت مالي\N- أعد خاتمي
Dialogue: 0,0:22:23.33,0:22:24.87,النص العام,,0,0,0,,- أمي...\N- أين هي؟
Dialogue: 0,0:22:24.96,0:22:27.42,النص العام,,0,0,0,,- مهلاً، توقف!\N- مهلاً!
Dialogue: 0,0:22:27.50,0:22:28.67,نص عام,,0,0,0,,توقف!
Dialogue: 0,0:22:28.75,0:22:31.05,نص عام,,0,0,0,,- توقف\N- المحتال!
Dialogue: 0,0:22:31.13,0:22:33.51,النص العام,,0,0,0,,- أيها اللص!\N- عد!
Dialogue: 0,0:22:33.59,0:22:36.88,نص عام,,0,0,0,,سأمسك بك، سوف تحصل عليه!
Dialogue: 0,0:22:37.47,0:22:39.51,النص العام,,0,0,0,,- توقف!\N- انتظر!
Dialogue: 0,0:22:41.76,0:22:43.43,النص العام,,0,0,0,,- أسرع!\N- ماذا تفعل؟
Dialogue: 0,0:22:43.52,0:22:44.64,نص عام,,0,0,0,,صغير...
Dialogue: 0,0:22:44.73,0:22:46.35,نص عام,,0,0,0,,أمسكها!
Dialogue: 0,0:22:46.44,0:22:48.56,general text,,0,0,0,,- لقد هربت!\N- هذا صحيح
Dialogue: 0,0:22:48.65,0:22:50.48,النص العام,,0,0,0,,- أهذه هي؟\N- نعم
Dialogue: 0,0:22:57.82,0:22:59.32,نص عام,,0,0,0,,هذا مو دوك
Dialogue: 0,0:22:59.41,0:23:00.24,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:23:05.75,0:23:07.33,نص عام,,0,0,0,,ها أنت...
Dialogue: 0,0:23:07.42,0:23:09.08,النص العام,,0,0,0,,- هيا...\N- أمسكها!
Dialogue: 0,0:23:09.17,0:23:12.21,نص عام,,0,0,0,,تعال هنا! سأرتب هذا لك!
Dialogue: 0,0:23:12.30,0:23:13.55,نص عام,,0,0,0,,مرحبًا!
Dialogue: 0,0:23:13.63,0:23:14.80,خط مائل,,0,0,0,,يا لك...
Dialogue: 0,0:23:27.06,0:23:28.60,نص عام,,0,0,0,,لقد كانت بالتأكيد هي
Dialogue: 0,0:23:30.40,0:23:32.23,نص عام,,0,0,0,,لكن لماذا ترى الآن؟
Dialogue: 0,0:23:46.04,0:23:48.21,general text,,0,0,0,,كانت دائماً تعصب عينيها بهذا
Dialogue: 0,0:23:50.33,0:23:51.96,النص العام,,0,0,0,,أليست هذه هي؟
Dialogue: 0,0:24:11.77,0:24:13.52,نص عام,,0,0,0,,التقينا من جديد،
Dialogue: 0,0:24:14.36,0:24:15.48,نص عام,,0,0,0,,فأنا
Dialogue: 0,0:24:16.07,0:24:19.07,general text,,0,0,0,,جئت إلى هنا من قرية ساري لأنني سمعت أنك هنا
Dialogue: 0,0:24:19.15,0:24:20.78,نص عام,,0,0,0,,صعدت بعيداً
Dialogue: 0,0:24:21.41,0:24:23.62,النص العام,,0,0,0,,ظننت أنك ستختبئ في العاصمة؟
Dialogue: 0,0:24:25.41,0:24:26.33,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:24:27.70,0:24:31.29,النص العام,,0,0,0,,هل تتظاهر بأنك أعمى؟
Dialogue: 0,0:24:33.58,0:24:36.00,النص العام,,0,0,0,,تظاهر بأنه شيء مسكين،
Dialogue: 0,0:24:36.09,0:24:39.51,النص العام,,0,0,0,,ثم سرقت بخبث
Dialogue: 0,0:24:41.97,0:24:43.18,نص عام,,0,0,0,,كيف حالك
Dialogue: 0,0:24:44.64,0:24:46.43,نص عام,,0,0,0,,هل تجرؤ على سرقتي؟
Dialogue: 0,0:24:48.52,0:24:50.23,نص عام,,0,0,0,,لا أعرف من...
Dialogue: 0,0:24:51.98,0:24:53.90,نص عام,,0,0,0,,...
Dialogue: 0,0:24:54.69,0:24:58.03,النص العام,,0,0,0,,مرة أخرى تحاول خداعي
Dialogue: 0,0:24:58.65,0:24:59.53,نص عام,,0,0,0,,امسكها
Dialogue: 0,0:25:04.07,0:25:05.28,نص عام,,0,0,0,,المساعدة!
Dialogue: 0,0:25:05.37,0:25:07.03,نص عام,,0,0,0,,الرجاء المساعدة!
Dialogue: 0,0:25:09.37,0:25:11.62,نص عام,,0,0,0,,أنا أعمى!
Dialogue: 0,0:25:11.71,0:25:14.08,نص عام,,0,0,0,,لا أعرفهم،
Dialogue: 0,0:25:14.17,0:25:16.54,النص العام,,0,0,0,,إنهم يحاولون خطفي
Dialogue: 0,0:25:17.25,0:25:20.88,نص عام,,0,0,0,,أرجو مساعدتي!
Dialogue: 0,0:25:20.97,0:25:23.55,النص العام,,0,0,0,,إنه يحاول جاهداً، انظر
Dialogue: 0,0:25:26.47,0:25:27.43,خط مائل,,0,0,0,,احفظ!
Dialogue: 0,0:25:27.51,0:25:28.76,نص عام,,0,0,0,,إلى ماذا تحدق؟
Dialogue: 0,0:25:28.85,0:25:31.27,نص عام,,0,0,0,,- تعال هنا\N- اتركنا!
Dialogue: 0,0:25:41.94,0:25:44.49,النص العام,,0,0,0,,لا يمكن جره رغمًا عنك
Dialogue: 0,0:25:45.61,0:25:48.28,نص عام,,0,0,0,,لدي أسباب لذلك،
Dialogue: 0,0:25:48.37,0:25:49.83,نص عام,,0,0,0,,ابتعد عن الطريق
Dialogue: 0,0:25:50.54,0:25:52.37,نص عام,,0,0,0,,أنا أعمى,
Dialogue: 0,0:25:52.46,0:25:54.42,النص العام,,0,0,0,,- وأنا لا أعرفهم\N{\i1}- كيف حالك...
Dialogue: 0,0:25:57.04,0:25:58.29,نص عام,,0,0,0,,أمسك به!
Dialogue: 0,0:26:10.35,0:26:12.10,النص العام,,0,0,0,,إنه ساحر
Dialogue: 0,0:26:12.18,0:26:13.31,نص عام,,0,0,0,,تشغيل
Dialogue: 0,0:26:21.61,0:26:22.99,نص عام,,0,0,0,,هل تستطيع الوقوف؟
Dialogue: 0,0:26:28.24,0:26:29.78,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:26:29.87,0:26:31.62,نص عام,,0,0,0,,بداوا خطيرين
Dialogue: 0,0:26:31.70,0:26:33.91,نص عام,,0,0,0,,اطلب المساعدة من الحراس
Dialogue: 0,0:26:34.66,0:26:35.71,نص عام,,0,0,0,,سأخذك إليهم
Dialogue: 0,0:26:35.79,0:26:38.58,نص عام,,0,0,0,,لا حاجة. كل شيء على ما يرام
Dialogue: 0,0:26:40.29,0:26:41.75,النص العام,,0,0,0,,عصاك مكسورة
Dialogue: 0,0:26:48.39,0:26:49.35,نص عام,,0,0,0,,هذه مظلة
Dialogue: 0,0:26:50.39,0:26:51.68,نص عام,,0,0,0,,يمكنك أن تأخذ
Dialogue: 0,0:27:08.61,0:27:11.20,النص العام,,0,0,0,,سيدي من الأفضل أن تتركها
Dialogue: 0,0:27:11.28,0:27:13.83,نص عام,,0,0,0,,ولم تكن تريد الذهاب إلى الحراس
Dialogue: 0,0:27:13.91,0:27:16.21,نص عام,,0,0,0,,لا أعرف شيئًا عن ماضيها،
Dialogue: 0,0:27:16.29,0:27:18.04,نص عام,,0,0,0,,لكن هؤلاء كانوا قطاع طرق
Dialogue: 0,0:27:18.71,0:27:22.88,general text,,0,0,0,,من الأفضل عدم التدخل في أعمالهم، ستكون آمنًا
Dialogue: 0,0:27:32.47,0:27:33.64,ذكريات بخط مائل,,0,0,0,,سوف آخذك إليهم
Dialogue: 0,0:27:34.52,0:27:36.93,ذكريات بخط مائل,,0,0,0,,اطلب المساعدة من الحراس
Dialogue: 0,0:27:41.19,0:27:43.07,نص عام,,0,0,0,,ربما كان علي أن أوافق
Dialogue: 0,0:28:04.13,0:28:06.71,نص عام,,0,0,0,,الرقم 125
Dialogue: 0,0:28:08.22,0:28:10.72,general text,,0,0,0,,هل قام الكثير من الأشخاص بالتسجيل هناك بالفعل؟
Dialogue: 0,0:28:10.80,0:28:12.14,نقوش,,0,0,0,,مائة وخمسة وعشرون
Dialogue: 0,0:28:13.22,0:28:15.06,النص العام,,0,0,0,,وسوف يأخذون خمسة فقط
Dialogue: 0,0:28:16.27,0:28:18.35,نص عام,,0,0,0,,هل هناك أمل؟
Dialogue: 0,0:28:18.93,0:28:20.06,خط مائل,,0,0,0,,مرحبًا مو ديوك
Dialogue: 0,0:28:21.69,0:28:22.90,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:28:22.98,0:28:24.44,النص العام,,0,0,0,,الرجل كان يبحث عنك
Dialogue: 0,0:28:24.52,0:28:26.98,general text,,0,0,0,,هل عاد السيد يول مرة أخرى؟
Dialogue: 0,0:28:27.07,0:28:29.15,نص عام,,0,0,0,,ليس هو يا سيد تشان
Dialogue: 0,0:28:29.90,0:28:32.82,general text,,0,0,0,,هرب وعاد إلى البيت
Dialogue: 0,0:28:42.08,0:28:45.63,نص عام,,0,0,0,,يجب أن أعود قبل غروب الشمس. أين ترتديه؟
Dialogue: 0,0:29:28.30,0:29:29.42,نص عام,,0,0,0,,أين السيد؟
Dialogue: 0,0:29:29.51,0:29:31.67,general text,,0,0,0,,لقد غادر للتو، لكنني لم أراه أيضًا
Dialogue: 0,0:29:34.22,0:29:36.26,general text,,0,0,0,,قال إنه سيتبع القواعد، لماذا هرب؟
Dialogue: 0,0:29:38.14,0:29:39.93,نص عام,,0,0,0,,آمل ألا يتم القبض عليه
Dialogue: 0,0:29:42.94,0:29:44.35,نص عام,,0,0,0,,بقيت للتو
Dialogue: 0,0:29:44.94,0:29:45.94,نص عام,,0,0,0,,الآن
Dialogue: 0,0:29:47.86,0:29:49.65,نص عام,,0,0,0,,ما بها؟
Dialogue: 0,0:30:14.13,0:30:15.30,نص عام,,0,0,0,,تشان أوك...
Dialogue: 0,0:30:15.88,0:30:16.80,نص عام,,0,0,0,,سيدتي!
Dialogue: 0,0:30:21.56,0:30:24.31,نص عام,,0,0,0,,أين كنت؟ اعتقدت أننا لن نرى بعضنا البعض
Dialogue: 0,0:30:53.38,0:30:55.76,نص عام,,0,0,0,,لكننا التقينا. أنا سعيد
Dialogue: 0,0:30:58.34,0:31:00.80,نص عام,,0,0,0,,يجب أن أذهب. إذا اكتشفوا أنني غادرت، فسوف أفشل
Dialogue: 0,0:31:01.72,0:31:04.35,نص عام,,0,0,0,,انتظرني. سأكون هناك قريبا
Dialogue: 0,0:31:06.02,0:31:10.23,نص عام,,0,0,0,,لقد وجدت طريقة، فافعل ما يجب عليك
Dialogue: 0,0:31:10.31,0:31:12.02,نص عام,,0,0,0,,وسوف أفعل ما يجب عليّ
Dialogue: 0,0:31:13.44,0:31:16.07,نص عام,,0,0,0,,حسنًا. أي نوع من الطريقة؟
Dialogue: 0,0:31:17.45,0:31:19.37,نص عام,,0,0,0,,إنهم يجندون الناس
Dialogue: 0,0:31:40.05,0:31:41.26,نص عام,,0,0,0,,لا يتم القبض عليك. أتمنى لك رحلة سعيدة
Dialogue: 0,0:32:07.29,0:32:10.50,general text,,0,0,0,,صاحب السمو، لماذا تذهب إلى سيجوكون بنفسك؟
Dialogue: 0,0:32:10.58,0:32:12.58,النص العام,,0,0,0,,كان عليك استدعاء السيد هو إلى مكانك
Dialogue: 0,0:32:14.09,0:32:17.38,نص عام,,0,0,0,,توقف عن هذا. إنه يعطيني سببًا للخروج واستنشاق بعض الهواء.
Dialogue: 0,0:32:17.46,0:32:18.97,نص عام,,0,0,0,,أحب المشي
Dialogue: 0,0:32:24.97,0:32:26.06,نص عام,,0,0,0,,هذا تشان ووك
Dialogue: 0,0:32:36.23,0:32:37.86,نص عام,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:32:37.94,0:32:40.03,نص عام,,0,0,0,,سمعت أنه غير مسموح لك بمغادرة قاعة التدريب
Dialogue: 0,0:32:40.11,0:32:41.82,نص عام,,0,0,0,,حتى تقرأ "كلمات من القلب"
Dialogue: 0,0:32:41.91,0:32:44.32,general text,,0,0,0,,أولاً جاءوا إلى تشويسونرو من أجلي،
Dialogue: 0,0:32:44.41,0:32:46.08,نص عام,,0,0,0,,الآن اتبعني
Dialogue: 0,0:32:46.79,0:32:49.96,general text,,0,0,0,,من أين يأتي هذا الاهتمام بي؟ إنه مخيف
Dialogue: 0,0:32:50.04,0:32:52.04,نص عام,,0,0,0,,قال لي السيد هو
Dialogue: 0,0:32:53.00,0:32:56.63,general text,,0,0,0,,سمعت أنك لم تتمكن من الوقوف على قدميك بعد الشراب الذي قدمته لك
Dialogue: 0,0:32:56.71,0:32:59.01,النص العام,,0,0,0,,لماذا أتيت إلى سيجوكون؟
Dialogue: 0,0:32:59.72,0:33:04.22,general text,,0,0,0,,هل ما زالت جراحي تؤلمني؟
Dialogue: 0,0:33:04.30,0:33:05.39,نص عام,,0,0,0,,ضعيف...
Dialogue: 0,0:33:05.47,0:33:08.56,نص عام,,0,0,0,,لا يؤلمون. أنا بصحة جيدة
Dialogue: 0,0:33:08.64,0:33:11.10,النص العام,,0,0,0,,جئت لتناول بعض الأدوية المفيدة
Dialogue: 0,0:33:11.89,0:33:15.36,نص عام,,0,0,0,,أتمنى أن تكون قد أخذت الكثير من الأشياء. يجب أن تعيش حياة طويلة وصحية
Dialogue: 0,0:33:17.40,0:33:20.11,نص عام,,0,0,0,,ماذا كنت تخفي؟
Dialogue: 0,0:33:21.20,0:33:22.20,نص عام,,0,0,0,,عرض
Dialogue: 0,0:33:39.84,0:33:40.88,نص عام,,0,0,0,,كعكة العسل
Dialogue: 0,0:33:41.47,0:33:44.13,نص عام,,0,0,0,,أردت أن آكله بنفسي. كيف عرفت؟
Dialogue: 0,0:33:44.72,0:33:45.84,نص عام,,0,0,0,,خذ
Dialogue: 0,0:33:52.18,0:33:55.27,النص العام,,0,0,0,,لا توجد مثل هذه الحلويات في سوسنوفي بور
Dialogue: 0,0:33:56.73,0:33:57.86,نص عام,,0,0,0,,هل عدت إلى المنزل؟
Dialogue: 0,0:34:04.78,0:34:07.91,general text,,0,0,0,,ستواجه مشاكل إذا اكتشفوا أنك هربت.
Dialogue: 0,0:34:08.53,0:34:11.79,النص العام,,0,0,0,,أحضرت لي شرابًا وأثنيت عليّ
Dialogue: 0,0:34:11.87,0:34:14.83,general text,,0,0,0,,هل ستخبرني حقًا عن إهانتي الصغيرة؟
Dialogue: 0,0:34:18.46,0:34:20.88,نص عام,,0,0,0,,لقد أعطيتك بسكويت العسل
Dialogue: 0,0:34:26.22,0:34:30.60,نص عام,,0,0,0,,تجول حول شجرة الصنوبر الكبيرة تلك. كان هناك العديد من السحرة هناك
Dialogue: 0,0:34:33.56,0:34:35.69,نص عام,,0,0,0,,شكرًا لك يا صاحب السمو. وداعا
Dialogue: 0,0:34:39.98,0:34:42.07,نص عام,,0,0,0,,لا أفهم لماذا أنا لطيف معه إلى هذه الدرجة
Dialogue: 0,0:34:46.57,0:34:48.12,نص عام,,0,0,0,,لذيذ
Dialogue: 0,0:34:48.91,0:34:50.08,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:34:54.08,0:34:55.87,general text,,0,0,0,,- لذيذ يا صاحب السمو؟\N- نعم
Dialogue: 0,0:34:56.46,0:34:58.42,نص عام,,0,0,0,,ظننت ولي العهد
Dialogue: 0,0:34:59.29,0:35:02.00,النص العام,,0,0,0,,سيكون معاديًا للسحرة
Dialogue: 0,0:35:03.17,0:35:05.09,نص عام,,0,0,0,,وغمد السيف
Dialogue: 0,0:35:05.76,0:35:07.93,نص عام,,0,0,0,,وصار أقرب إليهم
Dialogue: 0,0:35:08.55,0:35:11.81,general text,,0,0,0,,ربما قرر أن يجعلهم أصدقاء له لكي يستخدمهم،
Dialogue: 0,0:35:11.89,0:35:13.52,النص العام,,0,0,0,,متى يصبح الملك التالي
Dialogue: 0,0:35:15.23,0:35:18.60,general text,,0,0,0,,هل أنت متأكد من أنه لا ينبغي عليك فعل أي شيء؟
Dialogue: 0,0:35:18.69,0:35:19.94,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:35:20.02,0:35:21.98,نص عام,,0,0,0,,لن يكون من الصعب تغيير رأيه
Dialogue: 0,0:35:22.61,0:35:24.94,نص عام,,0,0,0,,لدينا علامة مع كوكبة تشانغ ووك
Dialogue: 0,0:35:26.74,0:35:30.20,general text,,0,0,0,,لن يكون أمام ولي العهد خيار سوى قتله
Dialogue: 0,0:35:41.17,0:35:45.76,general text,,0,0,0,,هل نستخدم هذا لإخضاع جين هو كيونغ؟
Dialogue: 0,0:35:45.84,0:35:49.18,نص عام,,0,0,0,,جينيوون ستصبح ملكنا قريبًا
Dialogue: 0,0:36:09.82,0:36:12.41,نص عام,,0,0,0,,مرت أربع ساعات منذ دخول السيدة
Dialogue: 0,0:36:15.12,0:36:16.37,نص عام,,0,0,0,,لا تتدخل
Dialogue: 0,0:36:16.45,0:36:17.79,نص عام,,0,0,0,,يبدو أن لديهم الكثير ليناقشوه
Dialogue: 0,0:36:21.50,0:36:24.29,نص عام,,0,0,0,,مهلا، انتظر!
Dialogue: 0,0:36:25.30,0:36:27.55,نص عام,,0,0,0,,طلبت منك عدم إزعاجهم!
Dialogue: 0,0:36:27.63,0:36:28.80,نص عام,,0,0,0,,هناك خطأ ما
Dialogue: 0,0:36:28.88,0:36:31.09,نص عام,,0,0,0,,يجب أن أتحقق مما إذا كان تشان ووك موجودًا أم لا
Dialogue: 0,0:36:31.18,0:36:33.39,النص العام,,0,0,0,,هل تعتقدين أن سيدتي تكذب؟
Dialogue: 0,0:36:38.98,0:36:41.02,general text,,0,0,0,,لماذا لم يعد بعد؟
Dialogue: 0,0:36:42.73,0:36:46.15,general text,,0,0,0,,سيكون غريبًا إذا اكتشفوا أنه ليس هنا
Dialogue: 0,0:36:56.28,0:36:58.16,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:36:59.12,0:37:03.29,النص العام,,0,0,0,,قلت أننا سنكون معًا حتى لا يتم القبض عليك
Dialogue: 0,0:37:04.33,0:37:06.21,نص عام,,0,0,0,,كنت أنتظر عودتك
Dialogue: 0,0:37:12.76,0:37:15.76,نص عام,,0,0,0,,أرأيت؟ هم معا
Dialogue: 0,0:37:17.81,0:37:19.14,نص عام,,0,0,0,,سأذهب
Dialogue: 0,0:37:19.64,0:37:22.73,نص عام,,0,0,0,,سعدت بالحديث معك
Dialogue: 0,0:37:24.10,0:37:25.31,نص عام,,0,0,0,,نعم متبادل
Dialogue: 0,0:37:25.90,0:37:27.19,نص عام,,0,0,0,,وداعا
Dialogue: 0,0:37:37.70,0:37:39.95,النص العام,,0,0,0,,ماذا فعلت خلال هذه الساعات الأربع؟
Dialogue: 0,0:37:41.37,0:37:42.58,نص عام,,0,0,0,,في الواقع
Dialogue: 0,0:37:43.37,0:37:46.79,نص عام,,0,0,0,,ماذا كنا نفعل؟
Dialogue: 0,0:38:09.27,0:38:10.73,نص عام,,0,0,0,,لقد شعرت بالملل
Dialogue: 0,0:38:15.16,0:38:17.62,general text,,0,0,0,,هل تريدين أن تصبحي خادمة في سوسنوفي بور؟
Dialogue: 0,0:38:18.20,0:38:20.24,نص عام,,0,0,0,,نعم. أنت تعرف ماذا حدث اليوم
Dialogue: 0,0:38:20.33,0:38:24.62,النص العام,,0,0,0,,المالك يحتاجني بالقرب منه
Dialogue: 0,0:38:25.46,0:38:26.42,نص عام,,0,0,0,,أوافق
Dialogue: 0,0:38:27.17,0:38:30.80,general text,,0,0,0,,على ما يبدو، كان غير مرتاح للغاية هناك لدرجة أنه عاد إلى المنزل ليغتسل ويأكل
Dialogue: 0,0:38:31.63,0:38:34.93,نص عام,,0,0,0,,سيدنا لطيف جدًا. كان الجميع يركضون حوله عندما كان يكبر.
Dialogue: 0,0:38:35.01,0:38:37.22,general text,,0,0,0,,الحياة مع الآخرين في سوسنوفي بور ليست مناسبة له
Dialogue: 0,0:38:37.80,0:38:39.05,نقوش,,0,0,0,,مائة وخمسة وعشرون
Dialogue: 0,0:38:39.14,0:38:40.35,نص عام,,0,0,0,,لقد قمت بالتسجيل بالفعل
Dialogue: 0,0:38:41.26,0:38:42.39,نص عام,,0,0,0,,سأصل بالتأكيد إلى هناك
Dialogue: 0,0:38:43.39,0:38:45.31,نص عام,,0,0,0,,نعم نعم ولكن هذا ليس ضروريا
Dialogue: 0,0:38:45.98,0:38:47.48,النص العام,,0,0,0,,نحن خدام عائلة تشان
Dialogue: 0,0:38:47.56,0:38:49.02,نص عام,,0,0,0,,يمكننا الوصول إلى هناك بسهولة
Dialogue: 0,0:38:49.65,0:38:50.57,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:38:50.65,0:38:53.65,نص عام,,0,0,0,,لست بحاجة لأداء الامتحان؟
Dialogue: 0,0:38:53.74,0:38:56.28,نص عام,,0,0,0,,بالطبع. ثق بي
Dialogue: 0,0:38:59.49,0:39:00.95,نص عام,,0,0,0,,مستحيل
Dialogue: 0,0:39:01.62,0:39:05.46,مائل,,0,0,0,,يتم تعيين الخدم في سوسنوفي بور فقط من خلال الاختيار المفتوح
Dialogue: 0,0:39:05.54,0:39:06.79,خط مائل,,0,0,0,,بلا استثناءات
Dialogue: 0,0:39:06.87,0:39:09.04,النص العام,,0,0,0,,أنا لا أطلب أن أعطيها مكاناً مجاناً
Dialogue: 0,0:39:09.13,0:39:11.88,النص العام,,0,0,0,,إنها تحتاج فقط إلى تميمة. اكتب اسمها
Dialogue: 0,0:39:11.96,0:39:13.55,نص عام,,0,0,0,,ثم ستحصل عليه
Dialogue: 0,0:39:13.63,0:39:15.38,نص عام,,0,0,0,,سندفع كل شهر
Dialogue: 0,0:39:18.93,0:39:20.18,نص عام,,0,0,0,,و...
Dialogue: 0,0:39:20.85,0:39:21.89,نص عام,,0,0,0,,هنا
Dialogue: 0,0:39:23.35,0:39:26.56,general text,,0,0,0,,ظننت أنه سيناسبك فأخذته معي أيتها الخادمة باك.
Dialogue: 0,0:39:57.59,0:40:01.47,نص عام,,0,0,0,,يقولون أنك حاولت
Dialogue: 0,0:40:01.55,0:40:05.43,نص عام,,0,0,0,,رشوة الخادمة باك بهذا
Dialogue: 0,0:40:06.06,0:40:09.14,general text,,0,0,0,,- إنها مجرد هدية...\N- لقد سألتها
Dialogue: 0,0:40:10.06,0:40:12.40,نص عام,,0,0,0,,امنح مو دوك مكانًا هنا
Dialogue: 0,0:40:12.48,0:40:15.53,نص عام,,0,0,0,,رجلنا حساس للغاية،
Dialogue: 0,0:40:15.61,0:40:17.57,نص عام,,0,0,0,,ففكرت إذا كان مو دوك
Dialogue: 0,0:40:17.65,0:40:21.62,general text,,0,0,0,,سيكون الأمر أسهل معه، وسيكون أسهل على السيد، لذلك طلبت معروفًا
Dialogue: 0,0:40:23.16,0:40:24.37,النص العام,,0,0,0,,فهذه رشوة بالفعل!
Dialogue: 0,0:40:25.74,0:40:29.04,نص عام,,0,0,0,,أنا آسف. لم أكن أعتقد
Dialogue: 0,0:40:29.12,0:40:31.17,general text,,0,0,0,,عندما أحضرت لي الخادمة باك هذا،
Dialogue: 0,0:40:31.25,0:40:34.09,النص العام,,0,0,0,,قلت لها أنك لن تفعلي ذلك أبداً
Dialogue: 0,0:40:34.88,0:40:36.00,نص عام,,0,0,0,,كنت متأكداً
Dialogue: 0,0:40:36.09,0:40:40.09,general text,,0,0,0,,كيف يمكنني أن أنظر في عينيها الآن؟
Dialogue: 0,0:40:40.18,0:40:41.43,نص عام,,0,0,0,,أنا...
Dialogue: 0,0:40:45.72,0:40:48.18,نص عام,,0,0,0,,سأعتذر لها
Dialogue: 0,0:40:48.81,0:40:50.02,نص عام,,0,0,0,,ماذا سيفكر الناس؟
Dialogue: 0,0:40:50.85,0:40:54.31,general text,,0,0,0,,سيعتقدون أنك استغلت علاقتنا،
Dialogue: 0,0:40:54.40,0:40:56.27,نص عام,,0,0,0,,إعطاء شخص رشوة
Dialogue: 0,0:40:56.36,0:40:59.82,النص العام,,0,0,0,,أعطيتها وشاحاً ولكني لم أذكرك
Dialogue: 0,0:40:59.90,0:41:01.07,نص عام,,0,0,0,,ومع ذلك،
Dialogue: 0,0:41:01.15,0:41:03.78,النص العام,,0,0,0,,الجميع في سوسنوفي بور يعلم أننا قريبون
Dialogue: 0,0:41:03.87,0:41:07.54,general text,,0,0,0,,إذا فعلت هذا، فلن أتمكن من القيام بذلك بعد الآن...
Dialogue: 0,0:41:10.91,0:41:14.96,نص عام,,0,0,0,,نحافظ على علاقاتنا الوثيقة
Dialogue: 0,0:41:16.80,0:41:20.51,نص عام,,0,0,0,,إذًا... لن آتي إلى هنا بعد الآن
Dialogue: 0,0:41:21.68,0:41:22.88,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:41:22.97,0:41:26.60,نص عام,,0,0,0,,هل كنت أنا وأنت قريبين جدًا؟
Dialogue: 0,0:41:27.22,0:41:29.02,النص العام,,0,0,0,,لو كان الأمر كذلك فلن تتمكن من ذلك
Dialogue: 0,0:41:29.10,0:41:32.14,نص عام,,0,0,0,,من السهل جدًا التحدث عن قطع العلاقة
Dialogue: 0,0:41:32.23,0:41:33.56,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:41:34.27,0:41:37.61,النص العام,,0,0,0,,- الخادمة كيم، أنا...\N- سأخبر ميد بارك،
Dialogue: 0,0:41:37.69,0:41:40.11,نص عام,,0,0,0,,أنا الذي تجرأت على إعطاء الرشوة،
Dialogue: 0,0:41:40.19,0:41:41.61,نص عام,,0,0,0,,بالتأكيد
Dialogue: 0,0:41:41.70,0:41:44.82,نص عام,,0,0,0,,ليس قريبًا من رأس سوسنوفي بور
Dialogue: 0,0:41:44.91,0:41:46.20,نص عام,,0,0,0,,- هذا...\N- نعم
Dialogue: 0,0:41:46.78,0:41:48.79,نص عام,,0,0,0,,أنا آسف جدًا لأنه بسببي
Dialogue: 0,0:41:48.87,0:41:50.25,نص عام,,0,0,0,,لقد فقدت ماء وجهك
Dialogue: 0,0:41:51.12,0:41:52.62,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:41:54.37,0:41:56.29,نص عام,,0,0,0,,لا يمكنك المغادرة فحسب
Dialogue: 0,0:42:03.17,0:42:04.38,نص عام,,0,0,0,,خذ هذا
Dialogue: 0,0:42:06.34,0:42:09.85,general text,,0,0,0,,إذا احتفظت بها، فهذا يعني أنني قبلت رشوة
Dialogue: 0,0:42:26.82,0:42:28.53,نص عام,,0,0,0,,و...
Dialogue: 0,0:42:29.78,0:42:31.79,نص عام,,0,0,0,,لم أقصد،
Dialogue: 0,0:42:33.46,0:42:36.62,نص عام,,0,0,0,,لا أريد رؤيتك...
Dialogue: 0,0:42:36.71,0:42:37.79,نص عام,,0,0,0,,الخدمة...
Dialogue: 0,0:42:37.88,0:42:39.54,نص عام,,0,0,0,,عذراء كيم!
Dialogue: 0,0:42:44.88,0:42:46.09,نص عام,,0,0,0,,ما مدى تعقيد كل شيء
Dialogue: 0,0:43:03.99,0:43:05.49,خط مائل,,0,0,0,,لن تقرأ
Dialogue: 0,0:43:08.24,0:43:09.37,نص عام,,0,0,0,,السيد لي
Dialogue: 0,0:43:10.03,0:43:12.95,نص عام,,0,0,0,,مع تركيزك الحالي لن تتمكن من القراءة
Dialogue: 0,0:43:13.62,0:43:16.79,general text,,0,0,0,,لم تتدرب بجد أبدًا، على عكس الآخرين
Dialogue: 0,0:43:16.87,0:43:19.88,general text,,0,0,0,,كم من الوقت سيستغرق إذا بدأت التدريب الآن؟
Dialogue: 0,0:43:19.96,0:43:22.38,نص عام,,0,0,0,,الأسرع - العام
Dialogue: 0,0:43:23.42,0:43:26.63,نص عام,,0,0,0,,غير مناسب. أرفض الجلوس هنا لمدة عام كامل
Dialogue: 0,0:43:26.72,0:43:29.84,نص عام,,0,0,0,,أعتقد أن هذا هو السبب الذي دفع بارك جين إلى إعطائك هذا الكتاب.
Dialogue: 0,0:43:34.39,0:43:35.85,نص عام,,0,0,0,,سوف تختصر الوقت،
Dialogue: 0,0:43:36.60,0:43:40.36,نص عام,,0,0,0,,إذا أصبحت تلميذي واتبعت تعاليمي
Dialogue: 0,0:43:40.44,0:43:41.61,نص عام,,0,0,0,,هذا...
Dialogue: 0,0:43:42.98,0:43:44.69,نص عام,,0,0,0,,تشرب هذا الشاي؟
Dialogue: 0,0:43:47.95,0:43:50.28,نص عام,,0,0,0,,أعطني وقتاً للتفكير
Dialogue: 0,0:43:51.70,0:43:54.12,نص عام,,0,0,0,,هذا كتاب معلمتي
Dialogue: 0,0:43:54.20,0:43:58.54,النص العام,,0,0,0,,هذه قصيدة للأستاذ سيو كيونغ
Dialogue: 0,0:43:58.62,0:43:59.79,نص عام,,0,0,0,,الآية؟
Dialogue: 0,0:43:59.87,0:44:01.88,نص عام,,0,0,0,,ليس طويلاً
Dialogue: 0,0:44:02.88,0:44:05.46,نص عام,,0,0,0,,اقرأ الكلمة الأولى،
Dialogue: 0,0:44:05.55,0:44:07.51,نص عام,,0,0,0,,والباقي سيأتي في حد ذاته
Dialogue: 0,0:44:08.97,0:44:11.72,نص عام,,0,0,0,,بالضبط. لا يمكنك قراءتها بعد
Dialogue: 0,0:44:12.68,0:44:15.72,النص العام,,0,0,0,,هل من الممتع الاستهزاء بي؟ لن تخبرني ماذا هناك
Dialogue: 0,0:44:15.81,0:44:17.10,نص عام,,0,0,0,,مشاهدة ممتعة
Dialogue: 0,0:44:19.10,0:44:21.60,نص عام,,0,0,0,,أساعدك هذه المرة؟
Dialogue: 0,0:44:23.48,0:44:24.32,نص عام,,0,0,0,,نعم
Dialogue: 0,0:44:25.23,0:44:28.61,نص عام,,0,0,0,,سأخبرك بسر مجهول
Dialogue: 0,0:44:29.90,0:44:33.49,نص عام,,0,0,0,,في الواقع هذه رسالة حب
Dialogue: 0,0:44:35.08,0:44:36.45,نص عام,,0,0,0,,رسالة حب؟
Dialogue: 0,0:44:36.54,0:44:37.58,نص عام,,0,0,0,,نعم
Dialogue: 0,0:44:37.66,0:44:41.58,general text,,0,0,0,,لقد قرأ مئات السحرة هذا الكتاب، لكن لا أحد يعرفه.
Dialogue: 0,0:44:45.50,0:44:49.55,general text,,0,0,0,,كتب المعلم سو كيونغ هذا الكتاب إلى الشخص الذي لا يستطيع الرؤية،
Dialogue: 0,0:44:49.63,0:44:52.47,نص عام,,0,0,0,,فتقرأه بقلبها
Dialogue: 0,0:44:57.10,0:45:00.31,نص عام,,0,0,0,,يمكن قراءة الكتاب بتركيز الطاقة
Dialogue: 0,0:45:00.39,0:45:04.40,general text,,0,0,0,,فكر كيف يكون هذا ممكناً، مع العلم أن هذه رسالة حب
Dialogue: 0,0:45:05.98,0:45:09.69,نص عام,,0,0,0,,كيف تبدأ رسالة الحب؟
Dialogue: 0,0:45:16.95,0:45:18.12,نص عام,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:45:21.12,0:45:22.37,general text,,0,0,0,,هل هو منحرف؟
Dialogue: 0,0:45:22.46,0:45:26.04,general text,,0,0,0,,لماذا تسمح لشخص ما بقراءة رسالة حبك؟
