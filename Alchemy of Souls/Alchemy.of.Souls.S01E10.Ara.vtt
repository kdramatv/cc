Dialogue: 0,0:58:25.24,0:58:29.16,general text,,0,0,0,,أهذا ما قاله لي ألا آتي؟
Dialogue: 0,0:58:29.24,0:58:31.66,نص عام,,0,0,0,,لماذا كل هذا الغضب؟
Dialogue: 0,0:58:31.75,0:58:33.87,خط مائل,,0,0,0,,لا أصدق ذلك
Dialogue: 0,0:58:34.79,0:58:36.38,نص عام,,0,0,0,,لا يهم. دعنا نذهب
Dialogue: 0,0:58:37.17,0:58:38.46,النص العام,,0,0,0,,صاحب السمو، يجب أن نذهب إلى هناك
Dialogue: 0,0:58:41.46,0:58:43.47,النص العام,,0,0,0,,- أعرف\N- نعم سمو الأمير
Dialogue: 0,0:58:44.47,0:58:48.89,النص العام,,0,0,0,,يجب أن نمشي خمسة ري ونعود بالماء*
Dialogue: 0,0:58:44.47,0:58:48.89,ملاحظات,,0,0,0,,*حوالي 20 كم
Dialogue: 0,0:58:48.97,0:58:50.43,نص عام,,0,0,0,,الخمسة الأولى
Dialogue: 0,0:58:51.10,0:58:54.39,النص العام,,0,0,0,,سيفوز بالمسابقة
Dialogue: 0,0:58:55.64,0:58:56.90,خلف الكواليس,,0,0,0,,العائق الأخير
Dialogue: 0,0:58:58.11,0:59:00.11,خلف الكواليس,,0,0,0,,يجب أن أكون من الأوائل
Dialogue: 0,0:59:12.29,0:59:13.12,نص عام,,0,0,0,,إلى الأمام!
Dialogue: 0,0:59:21.71,0:59:24.84,general text,,0,0,0,,يحدق في "كلمات القلب" لعدة أيام
Dialogue: 0,0:59:26.59,0:59:27.72,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:59:35.98,0:59:37.98,نص عام,,0,0,0,,لا يمكنك قراءته بهذه السرعة
Dialogue: 0,0:59:38.06,0:59:39.52,نص عام,,0,0,0,,اصبر
Dialogue: 0,0:59:41.73,0:59:43.03,نص عام,,0,0,0,,نعم
Dialogue: 0,0:59:43.73,0:59:47.03,النص العام,,0,0,0,,الخادم كيم قلق جدًا عليك
Dialogue: 0,0:59:47.91,0:59:49.70,نص عام,,0,0,0,,أخبرني إذا كنت بحاجة إلى أي شيء
Dialogue: 0,0:59:49.78,0:59:53.95,النص العام,,0,0,0,,سأطلب السرير والطعام والملابس التي تريد تجهيزها
Dialogue: 0,0:59:55.79,0:59:57.21,نص عام,,0,0,0,,لا يستحق كل هذا العناء
Dialogue: 0,1:00:06.38,1:00:08.72,نص عام,,0,0,0,,الرياح أكثر برودة
Dialogue: 0,1:00:08.80,1:00:11.22,نص عام,,0,0,0,,أغلق النوافذ
Dialogue: 0,1:00:12.76,1:00:16.93,ذكريات بخط مائل,,0,0,0,,لقد كتبت المعلمة سو كيونغ هذا الكتاب إلى الشخص الذي لا يستطيع الرؤية،
Dialogue: 0,1:00:17.02,1:00:19.98,ذكريات,,0,0,0,,حتى تتمكن من قراءتها بقلبها
Dialogue: 0,1:00:21.61,1:00:23.23,نص عام,,0,0,0,,لدي سؤال
Dialogue: 0,1:00:24.32,1:00:28.20,general text,,0,0,0,,السيد سو كيونغ يعرف امرأة عمياء؟
Dialogue: 0,1:00:32.07,1:00:34.45,نص عام,,0,0,0,,خلال الفوضى الكبرى التي حدثت قبل مائتي عام
الحوار: 0,1:00:35.12,1:00:37.37,نص عام,,0,0,0,,كان هناك
Dialogue: 0,1:00:37.45,1:00:39.83,نص عام,,0,0,0,,الفصل الأول من جينيوون
Dialogue: 0,1:00:39.92,1:00:42.88,نص عام,,0,0,0,,وكانت عمياء
Dialogue: 0,1:00:44.09,1:00:47.84,خلف الكواليس,,0,0,0,,لقد كتب هذه الرسالة لرئيس جينيوون
Dialogue: 0,1:00:49.72,1:00:53.80,نص عام,,0,0,0,,وهذا بالتأكيد يمكن للجميع قراءته؟
Dialogue: 0,1:00:54.47,1:00:56.60,نص عام,,0,0,0,,وإذا وصفت مشاعره هنا،
Dialogue: 0,1:00:56.68,1:00:58.77,نص عام,,0,0,0,,الذي عرضته للعامة؟
Dialogue: 0,1:01:02.81,1:01:05.82,نص عام,,0,0,0,,أحاول استغلالي لقراءة كتاب
Dialogue: 0,1:01:06.48,1:01:08.28,نص عام,,0,0,0,,سأقول هذا
Dialogue: 0,1:01:08.36,1:01:13.41,نص عام,,0,0,0,,هذا الكتاب ليس له علاقة بمشاعر السيد
Dialogue: 0,1:01:15.66,1:01:20.21,ذكريات,,0,0,0,,لقد قرأ مئات السحرة هذا الكتاب، لكن لا أحد يعرفه.
Dialogue: 0,1:01:20.79,1:01:23.63,خلف الكواليس,,0,0,0,,بالضبط. لا أحد يعلم أن هذه رسالة حب
Dialogue: 0,1:01:23.71,1:01:25.67,نص عام,,0,0,0,,بدلاً من أن تكون ماكرًا،
Dialogue: 0,1:01:25.75,1:01:28.21,نص عام,,0,0,0,,قم بالتدريب
Dialogue: 0,1:01:29.01,1:01:32.22,خلف الكواليس,,0,0,0,,كيف لا يمكن لأحد أن يفهم هذا؟
Dialogue: 0,1:01:37.14,1:01:40.48,خلف الكواليس,,0,0,0,,يمكن قراءة الكتاب من خلال تركيز الطاقة
Dialogue: 0,1:01:40.56,1:01:45.15,تعليق صوتي,,0,0,0,,فكر كيف يكون هذا ممكنًا، مع العلم أن هذه رسالة حب
Dialogue: 0,1:01:45.98,1:01:49.65,خلف الكواليس,,0,0,0,,لذلك لا بد من وجود طريقة أخرى
Dialogue: 0,1:01:50.69,1:01:52.86,خلف الكواليس,,0,0,0,,البقية لا يعرفون هذا
Dialogue: 0,1:01:52.95,1:01:55.45,خلف الكواليس,,0,0,0,,هذا لا يعرفه إلا من يعرف رسالة الحب
Dialogue: 0,1:01:56.03,1:01:57.41,خلف الكواليس,,0,0,0,,لكن كيف؟
Dialogue: 0,1:01:57.49,1:02:00.66,ذكريات,,0,0,0,,كيف تبدأ رسالة الحب؟
Dialogue: 0,1:02:11.72,1:02:13.13,نص عام,,0,0,0,,سؤال آخر
Dialogue: 0,1:02:14.09,1:02:15.76,نص عام,,0,0,0,,ما اسمك؟
Dialogue: 0,1:02:16.76,1:02:18.31,نص عام,,0,0,0,,الفصل الأول من جينيوون؟
Dialogue: 0,1:02:30.61,1:02:32.53,نص عام,,0,0,0,,جميع رسائل الحب
Dialogue: 0,1:02:33.99,1:02:35.86,نص عام,,0,0,0,,يبدأ باسم المستلم
Dialogue: 0,1:02:36.78,1:02:37.91,نص عام,,0,0,0,,اسم عائلتها
Dialogue: 0,1:02:38.49,1:02:41.66,نص عام,,0,0,0,,كان جين وكان اسمه سيول ران
Dialogue: 0,1:02:42.66,1:02:45.00,النص العام,,0,0,0,,مستلم الرسالة هو سول ران
Dialogue: 0,1:02:45.08,1:02:46.71,نص عام,,0,0,0,"زهرة الأوركيد"
Dialogue: 0,1:02:47.88,1:02:49.17,نص عام,,0,0,0,"هذا مغطى بالثلج"
Dialogue: 0,1:02:50.75,1:02:51.96,نص عام,,0,0,0,,اسمها
Dialogue: 0,1:02:53.17,1:02:55.05,نص عام,,0,0,0,,سيفتح هذه الرسالة
Dialogue: 0,1:03:33.55,1:03:34.76,نص عام,,0,0,0,,أرى
Dialogue: 0,1:03:42.93,1:03:44.93,نص عام,,0,0,0,,ها هي هنا
Dialogue: 0,1:03:46.94,1:03:48.56,نص عام,,0,0,0,,ها هو مو دوك
Dialogue: 0,1:04:03.12,1:04:04.66,خلف الكواليس,,0,0,0,"لا تمنعوا تدفق المياه"
Dialogue: 0,1:04:06.16,1:04:07.71,خلف الكواليس,,0,0,0,,"لكن الأرض تزهر كل عام"
Dialogue: 0,1:04:09.50,1:04:11.54,خلف الكواليس,,0,0,0,"لن نأخذ النار بأيدينا"
Dialogue: 0,1:04:11.63,1:04:13.05,خلف الكواليس,,0,0,0,"دعونا نشعل ناراً بالحطب"
Dialogue: 0,1:04:15.38,1:04:17.26,خلف الكواليس,,0,0,0,,"والرياح تهب أيضاً"
Dialogue: 0,1:04:18.88,1:04:20.34,خلف الكواليس,,0,0,0,"حجر أو صخرة ستتوقف"
Dialogue: 0,1:04:22.05,1:04:25.81,خلف الكواليس,,0,0,0,,"إذا أطلقت لهم العنان فسوف يتفرقون بما يرضي قلوبهم"
Dialogue: 0,1:04:27.60,1:04:29.02,خلف الكواليس,,0,0,0,"أرى السماء الزرقاء"
Dialogue: 0,1:04:30.69,1:04:32.02,خارج الإطار,,0,0,0,"سمعت تنهيدة هادئة"
Dialogue: 0,1:04:34.86,1:04:37.03,خلف الكواليس,,0,0,0,"أتنفس البرد وأتلاشى"
Dialogue: 0,1:04:37.61,1:04:39.82,خلف الكواليس,,0,0,0,"أحول تنهداتي إلى ثلج ودموع"
Dialogue: 0,1:04:40.95,1:04:43.74,خلف الكواليس,,0,0,0,,"لكنني لا أستطيع ذرف الدموع. أخفيها قدر استطاعتي"
Dialogue: 0,1:04:45.33,1:04:48.08,خلف الكواليس,,0,0,0,,"أعلم أن عيني ستمتلئ بالدموع مرة أخرى"
Dialogue: 0,1:04:48.79,1:04:53.13,خلف الكواليس,,0,0,0,,"لكنني أحمق، ولم تنزل دمعة واحدة على خدي"
Dialogue: 0,1:04:58.42,1:05:00.05,نص عام,,0,0,0,,لقد عاد هذان الشخصان بالفعل
Dialogue: 0,1:05:02.68,1:05:03.89,نص عام,,0,0,0,,لا أرى مو دوك
Dialogue: 0,1:05:12.48,1:05:14.56,نص عام,,0,0,0,,هناك بالفعل ستة أشخاص أمامها
Dialogue: 0,1:05:14.65,1:05:16.86,نص عام,,0,0,0,,يجب أن نتجاوز اثنين على الأقل
Dialogue: 0,1:05:27.33,1:05:30.41,caption,,0,0,0,،"لكنني أحمق، ولم تنزل دمعة واحدة على خدي"
Dialogue: 0,1:05:46.56,1:05:47.64,نص عام,,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,1:05:48.68,1:05:49.85,نص عام,,0,0,0,,بالضبط
Dialogue: 0,1:05:52.31,1:05:53.40,نص عام,,0,0,0,,قرأت
Dialogue: 0,1:06:15.83,1:06:16.84,نص عام,,0,0,0,,الرقم 29,
Dialogue: 0,1:06:16.92,1:06:18.80,النص العام,,0,0,0,,جانغ جونغ دو، لقد نجحت
Dialogue: 0,1:06:19.80,1:06:22.01,نص عام,,0,0,0,,بقي شخص آخر
Dialogue: 0,1:06:55.00,1:06:57.08,ذكريات بخط مائل,,0,0,0,,لست بحاجة إلى طالب لا يحرز تقدمًا
Dialogue: 0,1:06:57.58,1:06:59.67,ذكريات,,0,0,0,,إذا لم تفعل أي شيء، مت فقط
Dialogue: 0,1:07:00.71,1:07:02.71,ذكريات,,0,0,0,,هذا خطير!
Dialogue: 0,1:07:02.80,1:07:04.51,ذكريات,,0,0,0,,أنت لم تعد ناك سو
Dialogue: 0,1:07:11.18,1:07:13.14,التعليق الصوتي,,0,0,0,"لا يهم مدى شعورك بالسوء"
Dialogue: 0,1:07:14.23,1:07:16.31,خلف الكواليس,,0,0,0,"عليك أن تفعل ما بوسعك"
Dialogue: 0,1:07:18.77,1:07:20.65,خلف الكواليس,,0,0,0,,إذا كنت لا أريد أن أفعل أي شيء،
Dialogue: 0,1:07:22.23,1:07:23.69,التعليق الصوتي,,0,0,0,,أفضل أن أموت
Dialogue: 0,1:07:43.17,1:07:45.05,نص عام,,0,0,0,,الرقم 125، مو دوك،
Dialogue: 0,1:07:47.47,1:07:48.80,نص عام,,0,0,0,,لقد نجحت!
Dialogue: 0,1:07:58.02,1:08:00.81,نص عام,,0,0,0,,هذه كلمة بكلمة "كلمات من القلب"
Dialogue: 0,1:08:01.52,1:08:03.44,نص عام,,0,0,0,,فعلها تشان ووك
Dialogue: 0,1:08:05.86,1:08:07.32,نص عام,,0,0,0,,هل تكيف؟
Dialogue: 0,1:08:12.16,1:08:15.33,النص العام,,0,0,0,,- أين هو الآن؟\N- في سايجوكون
Dialogue: 0,1:08:15.41,1:08:18.71,general text,,0,0,0,,خادمته أغمي عليها أثناء المنافسة،
Dialogue: 0,1:08:18.79,1:08:20.00,نص عام,,0,0,0,,أخذها إلى هناك
Dialogue: 0,1:08:21.17,1:08:22.34,نص عام,,0,0,0,,خادم؟
Dialogue: 0,1:08:23.00,1:08:24.96,general text,,0,0,0,,- هل تتحدث عن مو دوك؟\N- نعم
Dialogue: 0,1:08:25.05,1:08:27.01,نص عام,,0,0,0,,نجحت في المنافسة
Dialogue: 0,1:08:27.72,1:08:29.93,general text,,0,0,0,,سقطت في النهاية،
Dialogue: 0,1:08:30.01,1:08:32.05,نص عام,,0,0,0,,لكنها نجحت
Dialogue: 0,1:08:32.76,1:08:34.01,نص عام,,0,0,0,,نعم؟
Dialogue: 0,1:08:38.31,1:08:41.65,ذكريات بخط مائل,,0,0,0,,خادمتي خاطرت بحياتها لتلبية طلبي
Dialogue: 0,1:08:42.36,1:08:43.73,ذكريات بخط مائل,,0,0,0,,لقد كانت فكرتي
Dialogue: 0,1:08:56.75,1:08:58.08,نص عام,,0,0,0,,إذا فكرت في الأمر،
Dialogue: 0,1:08:59.83,1:09:02.00,نص عام,,0,0,0,,إنها دائمًا بجوار تشان ووك
Dialogue: 0,1:09:04.04,1:09:05.71,نص عام,,0,0,0,,عذراء مو دوك...
Dialogue: 0,1:09:11.55,1:09:15.35,general text,,0,0,0,,الكتاب الذي قرأته كان عبارة عن رسالة حب من المعلم سيو كيونغ
Dialogue: 0,1:09:18.14,1:09:19.31,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,1:09:20.14,1:09:22.23,general text,,0,0,0,,لماذا جعلها غير مرئية؟
Dialogue: 0,1:09:22.98,1:09:26.57,general text,,0,0,0,,حبيبته كانت عمياء، أرادها أن تقرأها بقلبها
Dialogue: 0,1:09:27.94,1:09:29.40,نص عام,,0,0,0,,ذكي
Dialogue: 0,1:09:29.99,1:09:31.11,نص عام,,0,0,0,,لا أعتقد ذلك،
Dialogue: 0,1:09:31.95,1:09:33.70,نص عام,,0,0,0,,أن الرسالة وصلت إلى المرسل إليه
Dialogue: 0,1:09:34.45,1:09:36.53,نص عام,,0,0,0,,ثم سيكون في جينيوون
Dialogue: 0,1:09:37.29,1:09:38.87,نص عام,,0,0,0,,ليس في سوسنوفي بور
Dialogue: 0,1:09:39.45,1:09:42.62,general text,,0,0,0,,رسالة حب غير مرئية لم تُرسل قط؟
Dialogue: 0,1:09:44.75,1:09:45.84,نص عام,,0,0,0,,كم هو جبان
Dialogue: 0,1:09:47.80,1:09:50.13,نص عام,,0,0,0,,اكتب مشاعرك ولم تخبرها
Dialogue: 0,1:09:51.63,1:09:53.01,نص عام,,0,0,0,,كم هذا غبي
Dialogue: 0,1:09:54.34,1:09:55.89,نص عام,,0,0,0,,ورسالة حب مثيرة للشفقة
Dialogue: 0,1:10:01.52,1:10:03.44,نص عام,,0,0,0,,أنت على حق. كان يجب عليه...
Dialogue: 0,1:10:06.52,1:10:08.36,نص عام,,0,0,0,,أرسل رسالة كما فعلت
Dialogue: 0,1:10:09.82,1:10:12.45,نقشات,,0,0,0,,نستأجر خدمًا في سوسنوفي بور
Dialogue: 0,1:10:13.82,1:10:15.28,نص عام,,0,0,0,,هذه ليست رسالة
Dialogue: 0,1:10:15.37,1:10:16.74,نص عام,,0,0,0,,ما هذا إذن؟
Dialogue: 0,1:10:16.83,1:10:19.54,general text,,0,0,0,,إذا كان ينقل مشاعرك فهذه رسالة
Dialogue: 0,1:10:21.08,1:10:23.58,ذكريات,,0,0,0,,انتظريني. سأكون هناك قريبا
Dialogue: 0,1:10:23.67,1:10:25.42,ذكريات,,0,0,0,,لا يتم القبض عليك. أتمنى لك رحلة سعيدة
Dialogue: 0,1:10:34.80,1:10:38.97,general text,,0,0,0,,ربما بدوت مثير للشفقة في محاولاتي للوصول إلى هنا كخادمة
Dialogue: 0,1:10:39.97,1:10:42.60,النص العام,,0,0,0,,لقد كنت معلمًا ذا خبرة لا تصدق
Dialogue: 0,1:10:43.10,1:10:44.89,نص عام,,0,0,0,,أشعر بالأسف عليك
Dialogue: 0,1:10:45.85,1:10:48.36,النص العام,,0,0,0,,على الأقل تعلمت الولاء\N وقمت بواجباتك
Dialogue: 0,1:10:48.44,1:10:50.48,نص عام,,0,0,0,,لقد حاول معلمي جاهداً من أجلي
Dialogue: 0,1:10:50.57,1:10:53.95,نص عام,,0,0,0,,اعتقدت أنني يجب أن أبذل قصارى جهدي
Dialogue: 0,1:10:56.24,1:10:57.95,نص عام,,0,0,0,,هل أزعجك هذا الأمر؟
Dialogue: 0,1:10:58.74,1:11:01.54,نص عام,,0,0,0,,ليس حقًا. لكنني شككت
Dialogue: 0,1:11:02.33,1:11:07.08,نص عام,,0,0,0,,أجيبك كطالب أو أستاذ
Dialogue: 0,1:11:07.67,1:11:10.42,نص عام,,0,0,0,,أو أجب بأسلوب ما قرأته
Dialogue: 0,1:11:16.26,1:11:17.80,نص عام,,0,0,0,,وماذا قرأت؟
Dialogue: 0,1:11:18.72,1:11:22.43,نص عام,,0,0,0,,ثم أجيب بنفس السؤال؟
Dialogue: 0,1:11:24.06,1:11:25.60,نص عام,,0,0,0,,نفس الشيء؟ ما الذي تتحدث عنه؟
Dialogue: 0,1:11:26.14,1:11:30.27,نص عام,,0,0,0,,إنه مكتوب هناك. "سأتحمل أي شيء فقط من أجل رؤيتك"
Dialogue: 0,1:11:30.98,1:11:34.28,general text,,0,0,0,،"أستطيع أن أفعل أي شيء، فقط لأحظى بفرصة رؤيتك"
Dialogue: 0,1:11:34.90,1:11:36.28,نص عام,,0,0,0,,وهذا جوابي
Dialogue: 0,1:11:41.41,1:11:45.87,تعليق صوتي,,0,0,0,,كان ينبغي أن نكون مستعدين قبل أن نسمح له بالاقتراب إلى هذا الحد
Dialogue: 0,1:11:50.00,1:11:51.50,نص عام,,0,0,0,,واشتقت لك أيضاً
Dialogue: 0,1:11:55.42,1:11:56.76,نص عام,,0,0,0,,هذه إجابتي
Dialogue: 0,1:12:05.93,1:12:07.73,خلف الكواليس,,0,0,0,,ماذا قدمت له,
Dialogue: 0,1:12:09.27,1:12:13.27,خلف الكواليس,,0,0,0,,لا يستحق القراءة أو النقل إطلاقاً
Dialogue: 0,1:12:15.15,1:12:16.78,خارج الإطار,,0,0,0,,كان هذا غبيًا ومثيرًا للشفقة
Dialogue: 0,1:12:18.57,1:12:20.16,خلف الكواليس,,0,0,0,,رسالة حب
Dialogue: 0,1:12:52.00,1:12:53.19,preview,,0,0,0,,افتح عيني - أنا أفتقدك بالفعل
Dialogue: 0,1:12:53.27,1:12:55.19,preview,,0,0,0,,- اشتقت لك طوال اليوم\N- يكفي
Dialogue: 0,1:12:55.28,1:12:57.36,preview,,0,0,0,,لا مفر من هذا السم
Dialogue: 0,1:12:57.44,1:12:59.40,preview,,0,0,0,,الترياق هو الرجل الذي سممك
Dialogue: 0,1:12:59.49,1:13:00.86,preview,,0,0,0,,هل أنت مجنون تمامًا؟
Dialogue: 0,1:13:00.95,1:13:02.82,معاينة,,0,0,0,,هذه أعراض تسممي
Dialogue: 0,1:13:02.91,1:13:06.04,preview,,0,0,0,,ناك سو، هناك شخص واحد فقط في أفكارك. وهذا تشان ووك
Dialogue: 0,1:13:06.12,1:13:08.25,preview,,0,0,0,,لم تصدق عندما قلت إنني أحبك
Dialogue: 0,1:13:08.33,1:13:10.29,معاينة,,0,0,0,,إذن اجعلني أصدق
Dialogue: 0,1:13:10.37,1:13:12.83,preview,,0,0,0,,هذا هو أثمن شيء تلقيته
Dialogue: 0,1:13:12.92,1:13:15.84,معاينة,,0,0,0,,افعل كل ما بوسعك لاستعادته
Dialogue: 0,1:13:15.92,1:13:18.72,معاينة,,0,0,0,,لقد تشاجرت مع خادمتك
Dialogue: 0,1:13:18.80,1:13:21.01,معاينة,,0,0,0,,قاتل ومُت، تشان ووك
Dialogue: 0,1:13:21.09,1:13:22.18,معاينة,,0,0,0,,قلت اشتقت إليك،
Dialogue: 0,1:13:22.26,1:13:23.68,preview,,0,0,0,,وقلت أن هذه هي نقطة ضعفي
Dialogue: 0,1:13:23.76,1:13:25.10,معاينة,,0,0,0,,لا تذهب
Dialogue: 0,1:13:25.76,1:13:29.39,معاينة,,0,0,0,,أنا حقًا أحب مو ديوك
الحوار: 0,0:02:55.14,0:02:57.14,النكات,,0,0,0,,

