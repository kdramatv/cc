Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialogue: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:01:15.77,0:01:19.11,teks umum,,0,0,0,,Kudengar kamu pergi memancing bersama Inggris
Dialog: 0,0:01:20.15,0:01:23.40,teks umum,,0,0,0,,Ya. Membosankan memancing sendirian
Dialog: 0,0:01:24.15,0:01:25.95,teks umum,,0,0,0,,Kamu pernah berkata,
Dialog: 0,0:01:26.03,0:01:29.45,teks umum,,0,0,0,,bahwa Chan Wook bernasib sama dengan Master Seo Kyung
Dialogue: 0,0:01:29.54,0:01:33.00,teks umum,,0,0,0,,Jadi kamu dukung dan bantu dia?
Dialog: 0,0:01:33.50,0:01:36.42,teks umum,,0,0,0,,Bukan hanya aku yang membantunya
Dialog: 0,0:01:38.71,0:01:40.96,teks umum,,0,0,0,,Apakah ada orang lain yang mengarahkannya?
Dialog: 0,0:01:41.92,0:01:43.42,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:01:44.17,0:01:45.84,teks umum,,0,0,0,,Apakah kamu kenal orang ini?
Dialog: 0,0:01:52.52,0:01:56.15,teks umum,,0,0,0,,Tidak ada yang mengajari Uka merapal mantra
Dialog: 0,0:01:56.65,0:01:57.65,teks umum,,0,0,0,,Saya yakin
Dialog: 0,0:01:58.23,0:02:00.94,teks umum,,0,0,0,,Ini dikonfirmasi oleh pembantunya
Dialog: 0,0:02:01.69,0:02:05.82,teks umum,,0,0,0,,Jadi, dia sendiri mencapai ketinggian seperti itu?
Dialog: 0,0:02:05.90,0:02:07.87,teks umum,,0,0,0,,Mungkin dia menjadi penyihir Jeonjingak
Dialog: 0,0:02:07.95,0:02:10.33,teks umum,,0,0,0,,berkat trik dan keberuntungan
Dialog: 0,0:02:10.41,0:02:11.91,teks umum,,0,0,0,,Tapi dia tidak punya keahlian
Dialog: 0,0:02:11.99,0:02:14.79,teks umum,,0,0,0,,Saya yakin Anda pernah mendengar tentang argumen kami
Dialog: 0,0:02:16.17,0:02:17.50,teks umum,,0,0,0,,Satu pertarungan tersisa
Dialog: 0,0:02:19.21,0:02:20.25,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:02:20.34,0:02:23.88,teks umum,,0,0,0,,Guru akan mencegah penghinaannya
Dialog: 0,0:02:24.55,0:02:27.09,teks umum,,0,0,0,,Setelah membaca “Kata-Kata Hati”, dia mendapat rasa hormat
Dialog: 0,0:02:27.18,0:02:29.18,teks umum,,0,0,0,,Dan argumen kami mempermalukannya
Dialog: 0,0:02:29.26,0:02:32.77,teks umum,,0,0,0,,Dia dengan keras kepala terus berjuang
Dialog: 0,0:02:32.85,0:02:34.43,teks umum,,0,0,0,,Jadi ini
Dialog: 0,0:02:35.56,0:02:38.31,teks umum,,0,0,0,,sangat berarti baginya
Dialog: 0,0:02:41.69,0:02:43.44,kenangan,,0,0,0,,Apakah kamu baik-baik saja? Bisakah kamu melihat?
Dialog: 0,0:02:43.53,0:02:45.40,kenangan,,0,0,0,,Ya. Dan kamu, tuan?
Dialog: 0,0:02:45.49,0:02:47.57,kenangan,,0,0,0,,Kamu tidak terluka?
Dialog: 0,0:02:49.20,0:02:50.28,teks umum,,0,0,0,,Kamu benar
Dialogue: 0,0:02:51.95,0:02:55.20,teks umum,,0,0,0,,Aku tidak pernah memikirkan betapa pentingnya batu giok baginya
Dialog: 0,0:02:59.50,0:03:01.04,teks umum,,0,0,0,,Segera setelah Inggris kembali,
Dialog: 0,0:03:01.71,0:03:03.96,teks umum,,0,0,0,,Bom ingin bertarung
Dialog: 0,0:03:04.05,0:03:05.42,teks umum,,0,0,0,,Apakah dia sedang memancing?
Dialog: 0,0:03:06.30,0:03:08.51,teks umum,,0,0,0,,Dan Moo Dok menutup mata terhadap hal ini?
Dialog: 0,0:03:09.64,0:03:11.14,teks umum,,0,0,0,,Sepertinya dia tidak akan senang dengan hal ini
Dialog: 0,0:03:11.22,0:03:14.72,teks umum,,0,0,0,,Jadi kamu juga memperhatikan bahwa Uk mendengarkannya
Dialog: 0,0:03:14.81,0:03:18.77,teks umum,,0,0,0,,Dia keras kepala, tidak peduli apa yang orang katakan padanya
Dialog: 0,0:03:18.85,0:03:20.81,teks umum,,0,0,0,,Tapi dia selalu mendengarkan Moo Deok
Dialog: 0,0:03:23.86,0:03:26.61,kenangan,,0,0,0,,Kita bisa melindungi monster dari dunia ini
Dialog: 0,0:03:28.45,0:03:30.41,di luar layar,,0,0,0,,Saat itu dia sedang membicarakan Nak Soo
Dialogue: 0,0:03:32.95,0:03:37.37,sulih suara,,0,0,0,,Jika dia mencari batu untuk melindunginya...
Dialog: 0,0:03:39.92,0:03:42.38,teks umum,,0,0,0,,- Mereka tidak bisa bersama\N- Apa?
Dialog: 0,0:03:43.67,0:03:44.71,teks umum,,0,0,0,,Mengapa?
Dialogue: 0,0:03:44.80,0:03:47.46,teks umum,,0,0,0,,Tidakkah kamu suka kalau mereka dekat?
Dialog: 0,0:03:49.84,0:03:50.84,teks umum,,0,0,0,,Bukan itu intinya
Dialog: 0,0:03:51.34,0:03:54.72,teks umum,,0,0,0,,Jika mereka memilih jalan yang salah,
Dialog: 0,0:03:56.93,0:03:59.39,teks umum,,0,0,0,,Saya tidak bisa membantu
Dialogue: 0,0:04:08.36,0:04:14.45,italic,,0,0,0,,Uk bisa membawa kekacauan pada dunia ini
Dialog: 0,0:04:15.58,0:04:19.46,teks umum,,0,0,0,,Tiba-tiba dukungan kita membuatnya tak terkendali,
Dialog: 0,0:04:19.54,0:04:22.00,teks umum,,0,0,0,,setelah itu akan menarik perhatian?
Dialog: 0,0:04:22.08,0:04:25.42,teks umum,,0,0,0,,Takut dia akan melanggar batas takhta dan membawa
Dialog: 0,0:04:25.50,0:04:28.59,teks umum,,0,0,0,,kehancuran di Deho?
Dialog: 0,0:04:30.09,0:04:33.34,teks umum,,0,0,0,,Ini mungkin jika dia mengikuti bintang Raja
Dialog: 0,0:04:33.93,0:04:35.89,teks umum,,0,0,0,,Ini akan memperluas wawasannya
Dialog: 0,0:04:35.97,0:04:40.52,teks umum,,0,0,0,,dan keinginan untuk mencapai kehebatan
Dialog: 0,0:04:42.27,0:04:43.31,teks umum,,0,0,0,,Jin
Dialogue: 0,0:04:44.31,0:04:46.90,teks umum,,0,0,0,,Berapa lama waktu yang kamu butuhkan untuk menguasai Chisa?
Dialog: 0,0:04:47.73,0:04:48.69,teks umum,,0,0,0,,Chisu?
Dialog: 0,0:04:49.19,0:04:52.32,teks umum,,0,0,0,,Saya dengan cepat menguasai Ryusu,
Dialog: 0,0:04:52.40,0:04:56.58,teks umum,,0,0,0,,tapi lebih sulit menguasai Chisu
Dialog: 0,0:05:01.91,0:05:04.71,miring,,0,0,0,,Selama tiga tahun saya belajar memahami energi surga
Dialogue: 0,0:05:05.83,0:05:08.46,italic,,0,0,0,,Butuh waktu tiga tahun untuk memanfaatkan energi bumi
Dialog: 0,0:05:09.63,0:05:14.30,miring,,0,0,0,,dan empat tahun untuk merasakan energi di sekitar
Dialog: 0,0:05:16.43,0:05:20.43,miring,,0,0,0,,Energi langit, bumi dan air yang mengalir diantara keduanya
Dialog: 0,0:05:21.31,0:05:24.31,miring,,0,0,0,,Saya menguasai semua ini selama sepuluh tahun
Dialog: 0,0:05:26.48,0:05:28.36,miring,,0,0,0,,dan memahami Chisa
Dialog: 0,0:05:28.44,0:05:29.53,teks umum,,0,0,0,,Mengesankan
Dialog: 0,0:05:30.61,0:05:32.32,teks umum,,0,0,0,,Membutuhkan waktu 13 tahun
Dialog: 0,0:05:32.40,0:05:34.70,teks umum,,0,0,0,,Yom mempelajari semuanya dua kali lebih lama
Dialog: 0,0:05:35.32,0:05:39.24,teks umum,,0,0,0,,Saya berada di urutan kedua setelah Chang Gang
Dialog: 0,0:05:39.74,0:05:40.91,teks umum,,0,0,0,,Hanya ini...
Dialog: 0,0:05:48.59,0:05:52.21,teks umum,,0,0,0,,Kita melihat energi yang mengalir antara langit dan bumi,
Dialog: 0,0:05:52.30,0:05:55.72,teks umum,,0,0,0,,tapi intinya itu hanya air
Dialog: 0,0:05:58.10,0:06:02.56,teks umum,,0,0,0,,Kami telah mencoba menguasainya selama bertahun-tahun
Dialog: 0,0:06:04.39,0:06:06.94,teks umum,,0,0,0,,Tapi ada yang bisa melakukan ini sejak lahir
Dialog: 0,0:06:24.16,0:06:26.62,miring,,0,0,0,,Sederhananya, jenius
Dialog: 0,0:06:27.50,0:06:29.71,miring,,0,0,0,,Tetapi seluruh dunia
Dialog: 0,0:06:29.79,0:06:33.51,miring,,0,0,0,,menganggap mereka ceroboh, tidak bisa diandalkan
Dialog: 0,0:06:33.59,0:06:36.22,miring,,0,0,0,,dan terkadang berbahaya
Dialog: 0,0:06:39.51,0:06:40.60,teks umum,,0,0,0,,Apa aku...
Dialog: 0,0:06:41.72,0:06:43.31,teks umum,,0,0,0,,menguasai Chisu?
Dialog: 0,0:06:46.44,0:06:49.10,miring,,0,0,0,,Karena berbeda dari yang lain
Dialog: 0,0:06:56.82,0:06:59.07,miring,,0,0,0,,Beberapa iri pada mereka
Dialog: 0,0:07:06.91,0:07:09.33,miring,,0,0,0,,Yang lain takut padanya
Dialog: 0,0:07:12.00,0:07:13.42,teks umum,,0,0,0,,Saya pasti menang besok
Dialog: 0,0:07:16.17,0:07:17.47,teks umum,,0,0,0,,Aku menangkapnya
Dialog: 0,0:07:19.84,0:07:21.01,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:07:21.68,0:07:22.76,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:07:23.85,0:07:25.06,teks umum,,0,0,0,,Kamu sudah menguasai Chisa
Dialog: 0,0:07:30.31,0:07:34.90,miring,,0,0,0,,Kami bereaksi seperti ini karena kami tidak tahu bagaimana mereka menggunakan kekuatan luar biasa mereka
Dialogue: 0,0:07:35.53,0:07:39.53,teks umum,,0,0,0,,Akankah dia menyelamatkan dunia sebagai Master So Kyung
Dialog: 0,0:07:39.61,0:07:42.99,teks umum,,0,0,0,,atau akankah hancur? Kami tidak tahu
Dialog: 0,0:07:44.20,0:07:45.62,teks umum,,0,0,0,,Dengan kata lain,
Dialog: 0,0:07:46.95,0:07:50.00,teks umum,,0,0,0,,terus awasi dia?
Dialog: 0,0:07:51.83,0:07:55.13,teks umum,,0,0,0,,Jangan khawatir. Saya mengerti segalanya
Dialog: 0,0:07:57.38,0:07:59.34,teks umum,,0,0,0,,Jika kamu harus menghilangkan kekuatan ini,
Dialog: 0,0:08:00.55,0:08:03.10,teks umum,,0,0,0,,Saya akan melakukannya dengan tangan saya sendiri
Dialog: 0,0:08:10.06,0:08:11.98,teks umum,,0,0,0,,Chan Wook, apakah hukumanmu sudah berakhir?
Dialog: 0,0:08:12.06,0:08:13.31,teks umum,,0,0,0,,Jadi aku kembali
Dialogue: 0,0:08:13.40,0:08:14.82,teks umum,,0,0,0,,Jadi kamu menghancurkan Jeonbugwan?
Dialog: 0,0:08:14.90,0:08:16.15,teks umum,,0,0,0,,Jangan melebih-lebihkan
Dialogue: 0,0:08:17.28,0:08:20.03,teks umum,,0,0,0,,- Hai\N- Akhirnya kamu kembali
Dialog: 0,0:08:20.74,0:08:23.66,teks umum,,0,0,0,,Aku lawan terakhirmu
Dialogue: 0,0:08:24.32,0:08:26.66,teks umum,,0,0,0,,- Begitu\N- Sayang sekali kamu tidak menang,
Dialog: 0,0:08:27.70,0:08:31.92,teks umum,,0,0,0,,karena aku akan bertarung denganmu
Dialog: 0,0:08:37.38,0:08:38.80,teks umum,,0,0,0,,Jangan terlalu khawatir
Dialog: 0,0:08:39.46,0:08:41.88,teks umum,,0,0,0,,Saya harap pertarungan terakhir akan menarik
Dialog: 0,0:08:42.72,0:08:43.80,teks umum,,0,0,0,,Mengandalkanmu
Dialog: 0,0:08:53.77,0:08:55.23,teks umum,,0,0,0,,Apa itu tadi?
Dialog: 0,0:08:55.31,0:08:57.07,teks umum,,0,0,0,,Apakah dia mempelajari sesuatu yang baru?
Dialogue: 0,0:08:57.15,0:08:59.07,teks umum,,0,0,0,,Kudengar dia sedang memancing
Dialog: 0,0:08:59.15,0:09:01.57,teks umum,,0,0,0,,Jangan khawatir, dia hanya bersikap berani
Dialog: 0,0:09:02.61,0:09:06.78,teks umum,,0,0,0,,Aku akan mempermalukannya di depan Putra Mahkota
Dialog: 0,0:09:08.83,0:09:09.95,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:09:10.75,0:09:13.54,teks umum,,0,0,0,,Tuan bodohku kalah sembilan kali,
Dialog: 0,0:09:13.62,0:09:17.42,teks umum,,0,0,0,,karena itu kamu kehilangan sembilan katak emas
Dialog: 0,0:09:18.05,0:09:20.38,teks umum,,0,0,0,,Aku tak berani menatap matamu
Dialog: 0,0:09:22.76,0:09:24.22,teks umum,,0,0,0,,Pertarungan terakhir tersisa?
Dialog: 0,0:09:24.30,0:09:26.09,teks umum,,0,0,0,,Dia berlatih keras,
Dialog: 0,0:09:26.18,0:09:28.51,teks umum,,0,0,0,,agar tidak mengecewakanmu kali ini
Dialog: 0,0:09:28.60,0:09:30.22,teks umum,,0,0,0,,Supaya saya tidak kecewa,
Dialog: 0,0:09:30.81,0:09:31.89,teks umum,,0,0,0,,dia harus kalah
Dialog: 0,0:09:36.48,0:09:39.07,teks umum,,0,0,0,,Kau menganggapku bodoh
Dialog: 0,0:09:39.15,0:09:42.19,teks umum,,0,0,0,,Menggunakan emasku untuk melatih tuannya
Dialog: 0,0:09:43.74,0:09:45.32,teks umum,,0,0,0,,Berkat duel
Dialog: 0,0:09:45.41,0:09:49.24,teks umum,,0,0,0,,Anda senang menyaksikan penghinaan pemiliknya
Dialog: 0,0:09:49.33,0:09:51.91,teks umum,,0,0,0,,Saya yakin itu sepadan dengan emasnya
Dialog: 0,0:09:52.75,0:09:54.41,teks umum,,0,0,0,,Ya, menyenangkan
Dialog: 0,0:09:54.50,0:09:56.67,teks umum,,0,0,0,,kuharap dia kalah lagi,
Dialog: 0,0:09:57.46,0:10:00.00,teks umum,,0,0,0,,sehingga kamu menangis saat kehilangan giokmu
Dialog: 0,0:10:00.67,0:10:02.88,teks umum,,0,0,0,,Chan Wook punya separuh lainnya, kan?
Dialog: 0,0:10:03.67,0:10:06.13,teks umum,,0,0,0,,Dia memberimu yang kedua,
Dialog: 0,0:10:06.22,0:10:08.39,teks umum,,0,0,0,,jadi ini simbol cinta?
Dialog: 0,0:10:10.76,0:10:12.56,teks umum,,0,0,0,,Berikan padaku untuk menggunakanku?
Dialog: 0,0:10:16.65,0:10:19.31,teks umum,,0,0,0,,Jika Inggris kalah,
Dialog: 0,0:10:19.90,0:10:20.98,teks umum,,0,0,0,,Aku akan menghancurkan giok
Dialog: 0,0:10:22.44,0:10:23.90,miring,,0,0,0,,Kamu pasti kehilangan sesuatu
Dialog: 0,0:10:24.40,0:10:25.86,teks umum,,0,0,0,,Sayang sekali
Dialog: 0,0:10:25.95,0:10:28.24,teks umum,,0,0,0,,Cintamu yang penuh hormat akan terlupakan
Dialog: 0,0:10:33.54,0:10:34.96,teks umum,,0,0,0,,Lakukan sesukamu
Dialog: 0,0:10:35.91,0:10:37.33,teks umum,,0,0,0,,Jade menyelesaikan tugasnya
Dialog: 0,0:10:37.42,0:10:39.58,teks umum,,0,0,0,,Memaksa pemiliknya melalui 10 pertarungan
Dialog: 0,0:10:39.67,0:10:42.71,teks umum,,0,0,0,,Kamu bilang kamu akan mempertaruhkan nyawamu demi batu giok
Dialog: 0,0:10:43.96,0:10:46.47,teks umum,,0,0,0,,Jika kita bisa mempertaruhkan nyawa demi perasaan kita,
Dialog: 0,0:10:47.88,0:10:51.22,teks umum,,0,0,0,,hilangnya batu ini tidak akan mempengaruhi mereka
Dialog: 0,0:10:58.40,0:11:00.98,teks umum,,0,0,0,,Jadi kamu tidak peduli apakah kamu kehilangan dia atau tidak?
Dialog: 0,0:11:02.19,0:11:03.28,teks umum,,0,0,0,,Oke
Dialog: 0,0:11:04.28,0:11:05.69,teks umum,,0,0,0,,Kalau begitu aku akan membuangnya
Dialog: 0,0:11:16.16,0:11:17.75,teks umum,,0,0,0,,Jadi sebenarnya tidak berarti apa-apa
Dialog: 0,0:11:18.79,0:11:20.88,teks umum,,0,0,0,,Kamu menipuku
Dialog: 0,0:11:20.96,0:11:23.25,teks umum,,0,0,0,,Dia bilang ini adalah hal yang paling berharga
Dialog: 0,0:11:23.34,0:11:26.17,teks umum,,0,0,0,,Dan jika kamu tidak mengkhawatirkannya, berarti kamu berbohong
Dialogue: 0,0:11:27.38,0:11:29.59,teks umum,,0,0,0,,Bagaimana caramu membayar kebohongan?
Dialogue: 0,0:11:29.68,0:11:31.43,teks umum,,0,0,0,,Kau mempertaruhkan nyawamu, kan?
Dialog: 0,0:11:32.10,0:11:33.22,teks umum,,0,0,0,,Luar Biasa
Dialogue: 0,0:11:34.06,0:11:36.73,teks umum,,0,0,0,,Kau dipertaruhkan kali ini
Dialog: 0,0:11:38.60,0:11:40.69,teks umum,,0,0,0,,Saya sudah kehilangan sembilan kodok
Dialog: 0,0:11:41.31,0:11:42.77,teks umum,,0,0,0,,Saya tidak ingin kehilangan satu sama lain
Dialog: 0,0:11:42.86,0:11:44.61,teks umum,,0,0,0,,Kamu akan mendapat hadiah
Dialog: 0,0:11:45.90,0:11:47.19,teks umum,,0,0,0,,dalam pertarungan ini
Dialog: 0,0:11:49.57,0:11:51.20,teks umum,,0,0,0,,Saat Anda memesan
Dialog: 0,0:11:51.28,0:11:52.45,teks umum,,0,0,0,,Jika Chang Wook kalah,
Dialog: 0,0:11:53.41,0:11:56.37,teks umum,,0,0,0,,kamu akan menjadi pelayan pemenang
Dialog: 0,0:11:57.62,0:12:00.92,teks umum,,0,0,0,,Ya, saya akan memikirkannya
Dialog: 0,0:12:16.77,0:12:19.60,teks umum,,0,0,0,,Jadi kamu lawan terakhir Chan Wook?
Dialog: 0,0:12:20.98,0:12:22.60,teks umum,,0,0,0,,Saya Cha Bum
Dialogue: 0,0:12:22.69,0:12:24.40,teks umum,,0,0,0,,Aku akan menang apapun yang terjadi
Dialogue: 0,0:12:25.44,0:12:27.19,teks umum,,0,0,0,,Kamu harus
Dialog: 0,0:12:27.28,0:12:28.82,teks umum,,0,0,0,,Jika kalah,
Dialog: 0,0:12:28.90,0:12:31.57,teks umum,,0,0,0,,Saya akan pastikan bahwa Anda tidak akan berhasil sebagai pesulap
Dialogue: 0,0:12:33.41,0:12:35.33,teks umum,,0,0,0,,Bisakah kamu memberikan penjelasannya?
Dialog: 0,0:12:36.58,0:12:39.62,teks umum,,0,0,0,,Selalu ada kemungkinan...
Dialog: 0,0:12:39.70,0:12:40.83,teks umum,,0,0,0,,Cukup!
Dialog: 0,0:12:41.96,0:12:44.25,teks umum,,0,0,0,,Aku butuh seseorang yang pasti menang
Dialog: 0,0:12:44.33,0:12:45.71,teks umum,,0,0,0,,Berikan kata-katamu
Dialog: 0,0:12:45.79,0:12:48.34,teks umum,,0,0,0,,Saya khawatir saya tidak bisa, Yang Mulia
Dialog: 0,0:12:48.42,0:12:50.09,teks umum,,0,0,0,,Tidak ada orang selain dia...
Dialog: 0,0:12:51.93,0:12:53.47,teks umum,,0,0,0,,tidak akan memberikan kata ini
Dialog: 0,0:12:55.10,0:12:58.52,teks umum,,0,0,0,,Hanya tersisa satu orang,
Dialog: 0,0:12:59.60,0:13:01.18,teks umum,,0,0,0,,siapa yang bisa menang
Dialog: 0,0:13:01.27,0:13:02.27,teks umum,,0,0,0,,So Yul
Dialog: 0,0:13:08.23,0:13:09.48,teks umum,,0,0,0,,Jadi Yul?
Dialog: 0,0:13:22.12,0:13:24.25,teks umum,,0,0,0,,Perselisihannya tidak serius
Dialog: 0,0:13:25.08,0:13:27.09,teks umum,,0,0,0,,Tapi dia menggangguku
Dialog: 0,0:13:27.17,0:13:31.67,teks umum,,0,0,0,,Aku kehilangan sembilan kodok untuk menempatkan Uka di tempatnya
Dialog: 0,0:13:32.26,0:13:35.64,teks umum,,0,0,0,,Bayangkan betapa lucunya penampilanku,
Dialog: 0,0:13:35.72,0:13:39.60,teks umum,,0,0,0,,jika dia memenangkan pertarungan terakhir
Dialog: 0,0:13:41.14,0:13:43.73,teks umum,,0,0,0,,Jadi aku butuh seseorang yang pasti menang
Dialog: 0,0:13:43.81,0:13:46.48,teks umum,,0,0,0,,Kamu adalah pesulap terbaik Jeongjingak dan sepupuku
Dialog: 0,0:13:46.56,0:13:48.02,teks umum,,0,0,0,,Aku yakin hanya kamu satu-satunya
Dialog: 0,0:13:49.69,0:13:52.99,teks umum,,0,0,0,,Aku tahu kamu berteman dengannya
Dialog: 0,0:13:54.74,0:13:58.16,teks umum,,0,0,0,,Tapi sebagai pangeran dan sepupumu,
Dialog: 0,0:13:58.91,0:14:00.49,teks umum,,0,0,0,,Saya mohon bantuannya
Dialog: 0,0:14:04.33,0:14:05.62,teks umum,,0,0,0,,Baik, Yang Mulia
Dialog: 0,0:14:07.92,0:14:08.75,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:14:09.92,0:14:11.88,teks umum,,0,0,0,,Maukah kamu melawannya?
Dialog: 0,0:14:12.46,0:14:13.67,teks umum,,0,0,0,,Saya akan menang
Dialog: 0,0:14:14.38,0:14:15.84,teks umum,,0,0,0,,Aku berjanji
Dialog: 0,0:14:17.01,0:14:20.47,teks umum,,0,0,0,,Tepat. Dari semua orang, hanya Anda yang bisa
Dialog: 0,0:14:20.56,0:14:22.93,teks umum,,0,0,0,,Mu Dok benar-benar berjanji akan mengabdi
Dialog: 0,0:14:23.02,0:14:24.85,teks umum,,0,0,0,,pemenang?
Dialog: 0,0:14:24.93,0:14:27.56,teks umum,,0,0,0,,Ya, alih-alih katak yang dia taruh
Dialog: 0,0:14:32.61,0:14:34.65,teks umum,,0,0,0,,pada diri sendiri
Dialog: 0,0:14:34.74,0:14:36.70,teks umum,,0,0,0,,Kalau begitu aku akan kalahkan Uka
Dialog: 0,0:14:38.07,0:14:39.82,teks umum,,0,0,0,,dan aku akan menjadikannya pelayanku
Dialog: 0,0:14:44.37,0:14:45.50,teks umum,,0,0,0,,Oke
Dialog: 0,0:14:46.12,0:14:48.54,teks umum,,0,0,0,,Lawan terakhir Chang Wook, maju ke depan
Dialog: 0,0:15:16.82,0:15:17.82,teks umum,,0,0,0,,Chang Wook,
Dialog: 0,0:15:18.91,0:15:20.78,teks umum,,0,0,0,,bertarung denganmu hari ini
Dialog: 0,0:15:21.49,0:15:22.74,teks umum,,0,0,0,,saya akan
Dialog: 0,0:15:42.01,0:15:45.01,teks umum,,0,0,0,,Apakah So Yul bertarung dengannya agar dia menang?
Dialog: 0,0:15:45.10,0:15:46.10,miring,,0,0,0,,Tidak
Dialog: 0,0:15:46.18,0:15:49.27,miring,,0,0,0,,Saat Dan Gu mengajukan diri, Chang Wook langsung menyerah
Dialog: 0,0:15:49.35,0:15:50.77,miring,,0,0,0,,Dia tidak akan membiarkan Uku menang
Dialog: 0,0:15:50.85,0:15:54.40,teks umum,,0,0,0,,Dia berjanji pada pangeran bahwa dia akan mengalahkan Chan Wook
Dialog: 0,0:15:58.65,0:15:59.90,teks umum,,0,0,0,,Mulai
Dialog: 0,0:16:14.92,0:16:16.21,di belakang layar,,0,0,0,,Yul benar
Dialog: 0,0:16:16.92,0:16:19.09,teks umum,,0,0,0,,Inggris telah meningkat pesat
Dialog: 0,0:16:34.11,0:16:35.52,teks umum,,0,0,0,,Ini mantra pelindungku
Dialog: 0,0:16:35.61,0:16:36.73,teks umum,,0,0,0,,Kapan dia menguasainya?
Dialog: 0,0:16:38.57,0:16:41.32,miring,,0,0,0,,Dia mempelajari semua yang dia lihat di pertarungan sebelumnya
Dialog: 0,0:16:41.40,0:16:45.33,teks umum,,0,0,0,,Apakah dia sudah menguasai mantra lawan sebelumnya?
Dialog: 0,0:16:45.41,0:16:49.16,teks umum,,0,0,0,,Dia mempelajari mantra yang dia lihat dan mengulanginya
Dialogue: 0,0:17:49.22,0:17:50.35,teks umum,,0,0,0,,Dia berhasil
Dialog: 0,0:18:26.34,0:18:27.84,teks umum,,0,0,0,,Pertarungan telah usai
Dialog: 0,0:18:27.93,0:18:30.43,teks umum,,0,0,0,,Jadi Yul menang
Dialog: 0,0:18:34.56,0:18:35.69,teks umum,,0,0,0,,Aku mengetahuinya
Dialog: 0,0:18:37.10,0:18:39.90,teks umum,,0,0,0,,Inggris kalah dalam sepuluh pertarungan
Dialog: 0,0:18:40.69,0:18:43.65,teks umum,,0,0,0,,Bagaimana dia menggunakan Tansa di akhir?
Dialogue: 0,0:18:43.74,0:18:46.78,italic,,0,0,0,,Dia mengumpulkan energi di udara dan mengubahnya menjadi air
Dialogue: 0,0:18:46.86,0:18:47.78,teks umum,,0,0,0,,Jangan melucu
Dialog: 0,0:18:48.70,0:18:51.41,teks umum,,0,0,0,,Hanya mereka yang memiliki Chisu yang dapat melakukan ini
Dialog: 0,0:19:03.84,0:19:05.21,teks umum,,0,0,0,,Kapan kamu menguasai Chisa?
Dialog: 0,0:19:05.80,0:19:09.51,teks umum,,0,0,0,,Aku bilang kemarin bahwa aku akan memberitahumu sesuatu yang luar biasa
Dialog: 0,0:19:09.59,0:19:11.05,teks umum,,0,0,0,,Bagus sekali
Dialog: 0,0:19:11.85,0:19:13.22,teks umum,,0,0,0,,Selamat
Dialog: 0,0:19:13.31,0:19:14.18,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:19:15.18,0:19:17.64,teks umum,,0,0,0,,Anda telah menguasai Chisu. Selamat, sobat!
Dialog: 0,0:19:18.65,0:19:19.60,miring,,0,0,0,,Apakah kamu melihatnya?
Dialog: 0,0:19:20.23,0:19:22.94,teks umum,,0,0,0,,Chan Wook kita telah menguasai Chisa!
Dialog: 0,0:19:24.28,0:19:26.03,teks umum,,0,0,0,,- Benarkah?\N- Hai
Dialog: 0,0:19:26.11,0:19:28.07,teks umum,,0,0,0,,- Selamat\N- Selamat
Dialog: 0,0:19:28.15,0:19:30.62,miring,,0,0,0,,- Luar biasa\N- Selamat
Dialog: 0,0:19:30.70,0:19:31.78,teks umum,,0,0,0,,Hei
Dialog: 0,0:19:32.95,0:19:34.45,teks umum,,0,0,0,,Waktunya ke Saejukwon
Dialog: 0,0:19:43.75,0:19:46.21,teks umum,,0,0,0,,Moo Dok pergi bersama sang pangeran
Dialog: 0,0:19:46.80,0:19:49.47,teks umum,,0,0,0,,Mungkin membahas akhir perselisihan
Dialog: 0,0:19:49.55,0:19:52.22,teks umum,,0,0,0,,Aku hanya khawatir mereka akan melakukan hal seperti itu lagi
Dialog: 0,0:19:52.30,0:19:53.97,teks umum,,0,0,0,,saya akan periksa
Dialog: 0,0:19:54.06,0:19:57.56,teks umum,,0,0,0,,Ya. Jaga dia. Anda adalah pemiliknya sekarang
Dialogue: 0,0:20:01.69,0:20:04.11,teks umum,,0,0,0,,Jadi kami ingin sang pangeran berpikir
Dialog: 0,0:20:06.15,0:20:08.78,teks umum,,0,0,0,,Jadi Yul, pergilah ke Moo Deok
Dialog: 0,0:20:08.86,0:20:10.61,teks umum,,0,0,0,,Uk, dan kamu bersamaku di Saejukwon
Dialog: 0,0:20:11.32,0:20:13.32,teks umum,,0,0,0,,Ayo berangkat. Cepat
Dialog: 0,0:20:14.58,0:20:16.54,miring,,0,0,0,,- Hati-hati. Yah!\N- Sakit
Dialog: 0,0:20:16.62,0:20:18.12,miring,,0,0,0,,Lihat ke bawah kakimu
Dialog: 0,0:20:23.25,0:20:27.42,teks umum,,0,0,0,,Seperti yang Anda katakan, pemiliknya kalah sepuluh kali
Dialog: 0,0:20:28.05,0:20:29.84,teks umum,,0,0,0,,Anda menang, Yang Mulia
Dialog: 0,0:20:30.72,0:20:34.39,teks umum,,0,0,0,,Kamu tahu kalau dia menguasai Chisu
Dialog: 0,0:20:35.97,0:20:38.77,teks umum,,0,0,0,,Jadi aku dengan berani mempertaruhkan diriku sendiri
Dialog: 0,0:20:38.85,0:20:41.06,teks umum,,0,0,0,,Jika Cha Bum tidak menolak pertarungan,
Dialog: 0,0:20:41.73,0:20:43.40,teks umum,,0,0,0,,pemilik akan menang
Dialog: 0,0:20:44.81,0:20:46.48,teks umum,,0,0,0,,Dia bukan lagi tuanmu
Dialog: 0,0:20:48.36,0:20:50.36,teks umum,,0,0,0,,Sekarang kamu melayani Seo Yul
Dialog: 0,0:20:53.24,0:20:56.03,teks umum,,0,0,0,,Kamu bilang kamu punya perasaan yang sama
Dialog: 0,0:20:57.37,0:20:58.45,teks umum,,0,0,0,,Luar biasa
Dialog: 0,0:20:59.29,0:21:01.96,teks umum,,0,0,0,,Saya harap Anda tidak kehilangannya saat Anda melakukan servis yang lain
Dialog: 0,0:21:24.40,0:21:25.77,miring,,0,0,0,,Ini lucu
Dialog: 0,0:21:25.86,0:21:28.15,teks umum,,0,0,0,,Bagaimana dia bisa menguasai Chisa begitu cepat?
Dialog: 0,0:21:28.23,0:21:30.86,teks umum,,0,0,0,,Itu benar. Kami telah melihat semuanya
Dialog: 0,0:21:31.49,0:21:32.36,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:22:00.56,0:22:02.27,teks umum,,0,0,0,,Astaga!
Dialog: 0,0:22:03.56,0:22:05.77,teks umum,,0,0,0,,Kamu benar-benar jenius!
Dialog: 0,0:22:05.85,0:22:07.40,teks umum,,0,0,0,,Benar, Uk!
Dialog: 0,0:22:07.48,0:22:09.65,teks umum,,0,0,0,,- Sakit\N- Maaf
Dialog: 0,0:22:10.69,0:22:12.36,teks umum,,0,0,0,,Tuan Huo, itu menyakitkan bagiku
Dialog: 0,0:22:12.94,0:22:15.20,teks umum,,0,0,0,,Anda bergabung karena khawatir,
Dialog: 0,0:22:15.28,0:22:17.41,teks umum,,0,0,0,,bahwa aku harus melayani Cha Bum, kan?
Dialog: 0,0:22:17.49,0:22:19.83,teks umum,,0,0,0,,Terima kasih atas kebaikan Anda
Dialog: 0,0:22:19.91,0:22:21.70,teks umum,,0,0,0,,Sekarang kau layani aku
Dialog: 0,0:22:22.75,0:22:25.37,teks umum,,0,0,0,,Inilah janji yang kubuat pada pangeran
Dialog: 0,0:22:26.04,0:22:27.67,teks umum,,0,0,0,,Dan aku harus berpura-pura mengikutinya
Dialog: 0,0:22:27.75,0:22:28.84,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:22:28.92,0:22:32.42,teks umum,,0,0,0,,Jika kamu butuh sesuatu, bicaralah kapan saja
Dialog: 0,0:22:32.51,0:22:33.67,teks umum,,0,0,0,,Tidak diperlukan
Dialog: 0,0:22:34.22,0:22:36.34,teks umum,,0,0,0,,Kamu dapat mengunjungi Uka kapan saja
Dialog: 0,0:22:38.22,0:22:39.39,teks umum,,0,0,0,,Saya punya
Dialog: 0,0:22:40.97,0:22:42.60,teks umum,,0,0,0,,hanya satu permintaan
Dialog: 0,0:22:44.27,0:22:47.60,teks umum,,0,0,0,,Setelah aku menyelesaikan studiku, aku akan kembali ke Soho
Dialog: 0,0:22:48.56,0:22:50.61,teks umum,,0,0,0,,Aku ingin membawa satu orang bersamaku
Dialog: 0,0:22:51.52,0:22:53.48,teks umum,,0,0,0,,Tolong bantu saya
Dialog: 0,0:22:54.90,0:22:55.95,teks umum,,0,0,0,,lakukan
Dialog: 0,0:22:57.78,0:23:00.24,teks umum,,0,0,0,,Aku tidak tahu kamu punya orang seperti itu
Dialog: 0,0:23:00.32,0:23:03.62,teks umum,,0,0,0,,Berikan kata-katamu. Berjanjilah kamu akan membantu
Dialog: 0,0:23:07.87,0:23:10.42,teks umum,,0,0,0,,Kamu meminta menjadi tuanku
Dialog: 0,0:23:11.00,0:23:13.05,teks umum,,0,0,0,,Saya pasti akan membantu Anda
Dialog: 0,0:23:24.14,0:23:27.31,teks umum,,0,0,0,,Sekarang ada penelan jiwa di Saejukwon
Dialog: 0,0:23:27.39,0:23:29.15,teks umum,,0,0,0,,Dan kamu membawa Uka ke sini
Dialog: 0,0:23:29.23,0:23:31.56,teks umum,,0,0,0,,Apa yang bisa kulakukan? Dia terluka
Dialogue: 0,0:23:32.15,0:23:35.32,teks umum,,0,0,0,,Aku suruh dia istirahat beberapa hari
Dialog: 0,0:23:36.61,0:23:38.65,teks umum,,0,0,0,,- Apakah dia terluka parah?\N- Tidak
Dialog: 0,0:23:38.74,0:23:40.16,teks umum,,0,0,0,,Tidak ada yang serius
Dialog: 0,0:23:41.49,0:23:44.91,teks umum,,0,0,0,,Bagaimana dia bisa melawan Yul begitu sembrono
Dialog: 0,0:23:44.99,0:23:47.54,teks umum,,0,0,0,,Saya akan terus memancing bersama Guru Li
Dialog: 0,0:23:47.62,0:23:49.29,teks umum,,0,0,0,,Kamu seharusnya tidak meneleponnya kembali
Dialogue: 0,0:23:50.21,0:23:53.88,teks umum,,0,0,0,,Mereka pasti melakukan lebih dari sekedar memancing
Dialog: 0,0:23:55.84,0:23:59.05,teks umum,,0,0,0,,Uk, bajingan, menguasai Chisu
Dialog: 0,0:23:59.88,0:24:00.89,teks umum,,0,0,0,,Apa?
Dialog: 0,0:24:02.30,0:24:03.76,teks umum,,0,0,0,,Luar biasa bukan?
Dialog: 0,0:24:03.85,0:24:05.26,miring,,0,0,0,,Tidak bisa dimengerti
Dialog: 0,0:24:05.35,0:24:07.22,teks umum,,0,0,0,,Dia benar-benar jenius!
Dialog: 0,0:24:15.11,0:24:17.53,teks umum,,0,0,0,,Apa yang kamu pelajari
Dialog: 0,0:24:18.36,0:24:22.24,teks umum,,0,0,0,,saat memancing
Dialog: 0,0:24:22.32,0:24:23.95,teks umum,,0,0,0,,dengan Guru Li?
Dialog: 0,0:24:25.62,0:24:27.50,teks umum,,0,0,0,,Saya belajar menangkap Ikan Mas
Dialog: 0,0:24:27.58,0:24:30.92,teks umum,,0,0,0,,Jadi dia ingin membantumu menguasai Chisa
Dialog: 0,0:24:31.50,0:24:34.59,teks umum,,0,0,0,,- Apakah dia menganggapmu sebagai murid?{\i1}\N- Tidak juga
Dialogue: 0,0:24:34.67,0:24:36.63,teks umum,,0,0,0,,Ada alasan dia membantuku
Dialog: 0,0:24:37.59,0:24:39.97,teks umum,,0,0,0,,Yang mana?
Dialogue: 0,0:24:41.18,0:24:43.97,italic,,0,0,0,,Master untukmu
Dialog: 0,0:24:44.72,0:24:45.89,teks umum,,0,0,0,,sesuatu...
Dialog: 0,0:24:47.43,0:24:48.72,teks umum,,0,0,0,,diceritakan?
Dialog: 0,0:24:50.64,0:24:52.48,teks umum,,0,0,0,,Ini menyangkut keluargaku
Dialog: 0,0:24:52.56,0:24:54.98,teks umum,,0,0,0,,Saya memperhatikannya sendiri dan menanyakannya secara langsung
Dialog: 0,0:24:59.28,0:25:02.45,teks umum,,0,0,0,,Sepertinya kamu juga mengetahuinya
Dialog: 0,0:25:04.99,0:25:06.20,teks umum,,0,0,0,,Aku berharap
Dialog: 0,0:25:08.24,0:25:09.79,teks umum,,0,0,0,,yang tidak akan kamu kenali
Dialog: 0,0:25:10.71,0:25:11.96,miring,,0,0,0,,Tidak
Dialog: 0,0:25:12.04,0:25:15.25,teks umum,,0,0,0,,Aku tidak bisa menutup mata saat mengetahui semuanya
Dialog: 0,0:25:16.67,0:25:18.17,miring,,0,0,0,,Apa yang akan kamu lakukan sekarang?
Dialog: 0,0:25:22.72,0:25:23.97,teks umum,,0,0,0,,Dengan pembantu Kim
Dialog: 0,0:25:32.48,0:25:33.81,teks umum,,0,0,0,,Apa hubungannya dengan itu?
Dialog: 0,0:25:33.89,0:25:36.56,teks umum,,0,0,0,,Tuan Lee mencoba merayu pelayan Kim,
Dialog: 0,0:25:36.65,0:25:38.61,teks umum,,0,0,0,,membantuku
Dialog: 0,0:25:39.94,0:25:41.49,teks umum,,0,0,0,,Jadi apa yang akan kamu lakukan?
Dialog: 0,0:25:42.70,0:25:47.24,teks umum,,0,0,0,,Guru Li adalah orang luar biasa yang banyak membantu saya
Dialog: 0,0:25:48.87,0:25:49.70,miring,,0,0,0,,Tapi tetap saja
Dialog: 0,0:25:50.70,0:25:54.12,teks umum,,0,0,0,,Kupikir aku harus memberimu kesempatan dulu
Dialog: 0,0:25:54.21,0:25:55.79,teks umum,,0,0,0,,Jika kita mempertimbangkan hubungan kita
Dialogue: 0,0:25:59.55,0:26:01.01,teks umum,,0,0,0,,Kesempatan apa?
Dialog: 0,0:26:02.13,0:26:05.22,teks umum,,0,0,0,,Tahukah Anda bahwa Guru Li tinggal bersama kita?
Dialog: 0,0:26:06.34,0:26:08.93,teks umum,,0,0,0,,Dan aku bertanya-tanya di mana dia berhenti
Dialog: 0,0:26:09.01,0:26:11.22,teks umum,,0,0,0,,Jadi dia tinggal di rumahmu
Dialog: 0,0:26:11.31,0:26:12.31,teks umum,,0,0,0,,Ya
Dialog: 0,0:26:12.39,0:26:15.56,teks umum,,0,0,0,,Aku di sini sekarang, dan mereka mungkin sedang minum teh di sana, ngobrol
Dialog: 0,0:26:15.64,0:26:17.73,teks umum,,0,0,0,,Pembantu Kim sangat baik
Dialogue: 0,0:26:17.81,0:26:20.32,teks umum,,0,0,0,,Dia suka merawat dan memberi makan orang lain
Dialog: 0,0:26:20.40,0:26:22.82,teks umum,,0,0,0,,Ini masalah waktu sebelum dia jatuh cinta padanya
Dialog: 0,0:26:24.90,0:26:26.61,teks umum,,0,0,0,,Saya sangat berharap
Dialog: 0,0:26:26.70,0:26:29.53,teks umum,,0,0,0,,bahwa dia akan menikah dengan pria baik
Dialog: 0,0:26:32.91,0:26:34.54,teks umum,,0,0,0,,Jika Anda tidak keberatan,
Dialog: 0,0:26:35.37,0:26:38.21,teks umum,,0,0,0,,Saya ingin mendukung mereka
Dialog: 0,0:26:51.85,0:26:54.73,teks umum,,0,0,0,,Guru Li dua kali usianya
Dialog: 0,0:26:55.31,0:26:58.56,teks umum,,0,0,0,,Tapi dia terlihat lebih muda darimu
Dialog: 0,0:26:58.65,0:27:00.19,miring,,0,0,0,,Ini omong kosong
Dialogue: 0,0:27:00.27,0:27:03.48,teks umum,,0,0,0,,Dia mengamalkan kesucian
Dialog: 0,0:27:04.36,0:27:06.11,teks umum,,0,0,0,,Bagaimana mereka bisa menikah?
Dialog: 0,0:27:06.70,0:27:10.24,teks umum,,0,0,0,,Aku menekan naluriku demi latihan, tapi kemudian segera pulih
Dialog: 0,0:27:10.32,0:27:11.87,teks umum,,0,0,0,,Itu mungkin
Dialog: 0,0:27:11.95,0:27:13.99,teks umum,,0,0,0,,Pernikahan harus atas persetujuan bersama
Dialog: 0,0:27:15.25,0:27:17.21,teks umum,,0,0,0,,Dia pasti menginginkannya juga
Dialog: 0,0:27:17.29,0:27:18.96,teks umum,,0,0,0,,Dia selama ini
Dialog: 0,0:27:19.96,0:27:23.75,teks umum,,0,0,0,,mencintai satu orang
Dialog: 0,0:27:25.21,0:27:26.38,teks umum,,0,0,0,,Jin
Dialog: 0,0:27:26.47,0:27:32.43,teks umum,,0,0,0,,Apakah menurutmu dia masih mencintai Chang Gang?
Dialog: 0,0:27:34.35,0:27:36.73,teks umum,,0,0,0,,Aku mengenalnya lebih baik dari siapa pun
Dialog: 0,0:27:37.31,0:27:40.27,teks umum,,0,0,0,,Jadi saya mohon, jangan terburu-buru mengambil kesimpulan
Dialogue: 0,0:27:42.31,0:27:44.73,teks umum,,0,0,0,,Apa yang harus kulakukan padamu?
Dialog: 0,0:27:44.82,0:27:46.86,teks umum,,0,0,0,,Dan dia menyebut orang lain bodoh,
Dialog: 0,0:27:46.94,0:27:49.41,teks umum,,0,0,0,,ketika dia tidak melihat apa pun di bawah hidungnya
Dialog: 0,0:27:49.49,0:27:50.87,teks umum,,0,0,0,,Apa yang kamu tahu!
Dialog: 0,0:27:51.45,0:27:54.29,teks umum,,0,0,0,,Dia sudah lama berhenti mencintai Chang Gan
Dialog: 0,0:28:18.98,0:28:20.23,teks umum,,0,0,0,,Pada hari itu
Dialog: 0,0:28:21.85,0:28:23.15,teks umum,,0,0,0,,dia juga ada di sini
Dialog: 0,0:28:27.99,0:28:30.07,teks umum,,0,0,0,,Ini teh quince yang baru diseduh
Dialogue: 0,0:28:30.15,0:28:31.24,teks umum,,0,0,0,,Aromanya enak sekali
Dialog: 0,0:28:32.87,0:28:35.74,teks umum,,0,0,0,,Tidak baik menyimpan bunga layu di dalam rumah
Dialog: 0,0:28:35.83,0:28:38.08,teks umum,,0,0,0,,Cuaca dingin telah tiba, bunga sulit ditemukan sekarang
Dialog: 0,0:28:38.79,0:28:40.71,teks umum,,0,0,0,,Tapi aku akan mendengarkanmu dan membuangnya
Dialogue: 0,0:28:42.04,0:28:43.71,teks umum,,0,0,0,,Aku suka cara bunganya
Dialog: 0,0:28:43.79,0:28:45.67,teks umum,,0,0,0,,menemaniku
Dialog: 0,0:28:59.98,0:29:03.02,teks umum,,0,0,0,,Aku benar-benar lupa soal cangkir dan hanya membawa teko
Dialogue: 0,0:29:09.61,0:29:11.61,teks umum,,0,0,0,,Bagaimana mereka bisa mekar lagi?
Dialog: 0,0:29:12.78,0:29:14.57,teks umum,,0,0,0,,Guru Li melakukan ini?
Dialog: 0,0:29:16.53,0:29:17.37,teks umum,,0,0,0,,Betapa indahnya
Dialog: 0,0:29:34.76,0:29:36.01,teks umum,,0,0,0,,Pasti,
Dialog: 0,0:29:36.97,0:29:39.22,teks umum,,0,0,0,,dia memberinya bunga
Dialog: 0,0:29:40.85,0:29:42.43,teks umum,,0,0,0,,hari itu
Dialog: 0,0:29:51.07,0:29:53.57,teks umum,,0,0,0,,Guru Li, Anda sangat baik dan simpatik
Dialog: 0,0:29:54.45,0:29:55.61,teks umum,,0,0,0,,Saya?
Dialog: 0,0:29:56.28,0:29:58.78,teks umum,,0,0,0,,Tetap di sini selama yang kamu mau
Dialog: 0,0:29:58.87,0:30:00.62,teks umum,,0,0,0,,Aku akan menjagamu
Dialog: 0,0:30:02.33,0:30:03.41,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:30:06.63,0:30:09.13,teks umum,,0,0,0,,Apakah gadis ini istri Chang Gan?
Dialog: 0,0:30:11.46,0:30:14.63,teks umum,,0,0,0,,Ya, cantik kan?
Dialogue: 0,0:30:14.72,0:30:18.39,teks umum,,0,0,0,,Apakah Jin yang jatuh cinta padanya? Yeom memberitahu
Dialog: 0,0:30:21.97,0:30:27.02,teks umum,,0,0,0,,Dia tidak layu dan menjaga kecantikannya tetap utuh
Dialog: 0,0:30:28.81,0:30:31.53,miring,,0,0,0,,Mungkin itu sebabnya dia masih belum bisa melupakannya
Dialog: 0,0:30:32.94,0:30:34.28,teks umum,,0,0,0,,Atau
Dialog: 0,0:30:35.11,0:30:36.66,teks umum,,0,0,0,,dia hanya tidak menyukaiku
Dialog: 0,0:30:37.49,0:30:38.70,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:30:44.83,0:30:46.92,teks umum,,0,0,0,,Saya mengerti, itulah yang diperintahkan pangeran
Dialog: 0,0:30:47.00,0:30:49.25,teks umum,,0,0,0,,Tapi bagaimana dia bisa melarang Moo Deok mengunjungiku?
Dialog: 0,0:30:49.34,0:30:51.17,teks umum,,0,0,0,,Dia khawatir sepanjang waktu
Dialog: 0,0:30:51.25,0:30:53.84,miring,,0,0,0,,Aku yakin dia hanya sibuk
Dialog: 0,0:30:53.92,0:30:55.72,teks umum,,0,0,0,,Aku bilang padanya kamu baik-baik saja
Dialog: 0,0:30:55.80,0:30:56.72,miring,,0,0,0,,Yah, tidak
Dialog: 0,0:30:56.80,0:30:59.22,teks umum,,0,0,0,,Apakah menurutmu dia langsung santai setelah kata-katamu?
Dialog: 0,0:30:59.85,0:31:00.93,teks umum,,0,0,0,,Kita perlu memeriksa
Dialog: 0,0:31:02.10,0:31:03.02,teks umum,,0,0,0,,Kemarilah
Dialog: 0,0:31:06.06,0:31:07.98,teks umum,,0,0,0,,Ini hanya akan membuatmu kesakitan
Dialog: 0,0:31:09.69,0:31:13.98,teks umum,,0,0,0,,Burung ini mengantarkan suratku ke Soho
Dialog: 0,0:31:16.95,0:31:20.91,teks umum,,0,0,0,,Dibutuhkan tiga hingga empat hari untuk sampai ke sana dengan kuda
Dialogue: 0,0:31:20.99,0:31:22.66,teks umum,,0,0,0,,Dapatkah seekor burung terbang sejauh ini?
Dialog: 0,0:31:23.24,0:31:24.37,teks umum,,0,0,0,,Luar biasa
Dialog: 0,0:31:37.34,0:31:38.97,teks umum,,0,0,0,,Apakah kamu punya peluit?
Dialog: 0,0:31:40.05,0:31:42.68,teks umum,,0,0,0,,Maaf, saya tidak membawanya
Dialogue: 0,0:31:45.89,0:31:48.35,teks umum,,0,0,0,,Ini hadiah dari kekasihmu
Dialog: 0,0:31:48.44,0:31:49.27,teks umum,,0,0,0,,Aku terluka
Dialog: 0,0:31:59.91,0:32:02.83,teks umum,,0,0,0,,Kamu perlu meniup dua kali agar burung itu kembali
Dialog: 0,0:32:04.12,0:32:05.54,teks umum,,0,0,0,,Kamu melakukannya dengan baik
Dialog: 0,0:32:06.12,0:32:07.33,teks umum,,0,0,0,,Coba
Dialog: 0,0:32:37.03,0:32:38.19,teks umum,,0,0,0,,Lihat
Dialog: 0,0:32:41.32,0:32:42.82,teks umum,,0,0,0,,Burung kembali
Dialog: 0,0:32:45.16,0:32:46.74,teks umum,,0,0,0,,Sekarang tiup dua kali dengan cepat
Dialog: 0,0:33:09.64,0:33:12.44,kenangan miring,,0,0,0,,Aku mengatakan itu untuk menenangkannya
Dialog: 0,0:33:12.52,0:33:15.23,kenangan,,0,0,0,,Dia khawatir burung jinaknya kesulitan di musim dingin,
Dialog: 0,0:33:16.15,0:33:17.77,kenangan,,0,0,0,,jadi aku berbohong
Dialog: 0,0:33:20.32,0:33:23.03,teks umum,,0,0,0,,Lihat? Moo Deok baik-baik saja
Dialog: 0,0:33:27.03,0:33:29.08,teks umum,,0,0,0,,Tunggu, tunggu, Inggris
Dialog: 0,0:33:29.16,0:33:32.37,teks umum,,0,0,0,,Apa sebenarnya yang diperdebatkan Moo Dok dengan Putra Mahkota?
Dialog: 0,0:33:32.46,0:33:33.83,teks umum,,0,0,0,,Hal yang ingin kamu kembalikan
Dialog: 0,0:33:36.79,0:33:39.17,teks umum,,0,0,0,,Tidak masalah. Sekarang saya tidak bisa mendapatkannya kembali sejak saya kalah
Dialogue: 0,0:33:45.68,0:33:49.64,teks umum,,0,0,0,,Tapi kenapa dia begitu riang saat kehilangan dia?
Dialog: 0,0:33:57.94,0:34:00.15,miring,,0,0,0,,- Jadi apa itu tadi?\N- Jangan tanya
Dialogue: 0,0:34:00.73,0:34:04.36,teks umum,,0,0,0,,Kenapa kamu belum pernah mengunjungi Wook di Saejukwon?
Dialog: 0,0:34:05.78,0:34:08.53,teks umum,,0,0,0,,Saya master barumu, tapi kamu tidak perlu mengkhawatirkannya
Dialog: 0,0:34:09.37,0:34:11.16,teks umum,,0,0,0,,Bukan itu intinya
Dialog: 0,0:34:11.66,0:34:13.66,teks umum,,0,0,0,,Aku hanya berusaha untuk tidak malu
Dialog: 0,0:34:25.34,0:34:27.72,kenangan miring,,0,0,0,,Jadi kamu tidak peduli apakah kamu kehilangan dia atau tidak?
Dialog: 0,0:34:31.31,0:34:34.81,di luar layar,,0,0,0,,Aku harus menemukannya. Aku harus menemukannya hari ini
Dialog: 0,0:34:36.10,0:34:38.94,di luar layar,,0,0,0,,Hanya dengan begitu aku bisa menatap matanya
Dialog: 0,0:34:50.95,0:34:52.29,miring,,0,0,0,,Aku mengetahuinya
Dialog: 0,0:34:55.50,0:34:57.00,teks umum,,0,0,0,,Dia meminum teh itu
Dialog: 0,0:34:58.96,0:35:00.92,teks umum,,0,0,0,,Dia mempermalukan para penyihir dan melarikan diri
Dialog: 0,0:35:01.00,0:35:04.80,teks umum,,0,0,0,,Dan kemudian dia meningkatkan dan mengalahkan Putra Mahkota. Ini aneh
Dialog: 0,0:35:04.88,0:35:07.26,teks umum,,0,0,0,,Dia memutuskan untuk menjadi murid Guru Li
Dialog: 0,0:35:07.34,0:35:09.09,teks umum,,0,0,0,,dan mengamalkan kesucian
Dialog: 0,0:35:09.18,0:35:10.60,teks umum,,0,0,0,,Apakah kalian semua melihat Guru Li?
Dialog: 0,0:35:11.18,0:35:12.60,teks umum,,0,0,0,,Dia adalah murid master So Kyung,
Dialog: 0,0:35:12.68,0:35:14.47,miring,,0,0,0,,dan Tuan Ho Yeom adalah muridnya
Dialogue: 0,0:35:14.56,0:35:16.69,teks umum,,0,0,0,,Tapi dia terlihat lebih muda dari kepala kita
Dialogue: 0,0:35:16.77,0:35:19.19,teks umum,,0,0,0,,Dan semua itu karena dia mengamalkan kesucian
Dialog: 0,0:35:19.27,0:35:23.11,teks umum,,0,0,0,,Saya dengar dia tidak menua karena dia mencapai level tertinggi di masa mudanya
Dialog: 0,0:35:23.19,0:35:26.24,teks umum,,0,0,0,,Benarkah? Kudengar dia menjadi lebih muda berkat mantra
Dialog: 0,0:35:26.32,0:35:27.20,miring,,0,0,0,,Mantra?
Dialog: 0,0:35:27.28,0:35:30.20,teks umum,,0,0,0,,Itu tidak penting. Inggris bertekad
Dialog: 0,0:35:30.28,0:35:31.74,teks umum,,0,0,0,,Dan bagaimana jika dia mencapai Chisu?
Dialog: 0,0:35:32.33,0:35:33.66,teks umum,,0,0,0,,Aku di tempatnya
Dialog: 0,0:35:35.79,0:35:37.54,teks umum,,0,0,0,,tidak akan menahan diri
Dialog: 0,0:35:38.25,0:35:39.83,teks umum,,0,0,0,,Tentu saja, aku juga
Dialog: 0,0:35:39.92,0:35:41.75,teks umum,,0,0,0,,- Dia benar-benar keras kepala\N- Dan jangan bilang
Dialogue: 0,0:35:45.30,0:35:46.67,teks umum,,0,0,0,,Mereka semua iri
Dialog: 0,0:35:48.47,0:35:51.80,teks umum,,0,0,0,,Ada begitu banyak rumor buruk tentang Tuan Chang Wook
Dialog: 0,0:35:59.69,0:36:00.94,teks umum,,0,0,0,,Saya bisa
Dialog: 0,0:36:01.73,0:36:05.15,teks umum,,0,0,0,,tidurlah berkat obat-obatannya
Dialog: 0,0:36:07.82,0:36:10.95,teks umum,,0,0,0,,Saya senang tanaman obat bermanfaat
Dialog: 0,0:36:11.99,0:36:15.49,teks umum,,0,0,0,,Saya menggunakan akar valerian, yang tumbuh di rawa-rawa benteng Vol
Dialog: 0,0:36:15.58,0:36:17.37,teks umum,,0,0,0,,Dia terkenal menenangkan
Dialog: 0,0:36:17.45,0:36:21.25,teks umum,,0,0,0,,Ini akan membantumu rileks dan meningkatkan kualitas tidurmu
Dialog: 0,0:36:21.79,0:36:24.25,teks umum,,0,0,0,,Saya mengerti mengapa Guru Ho Yeom merekomendasikan Anda
Dialog: 0,0:36:25.71,0:36:28.17,teks umum,,0,0,0,,Untungnya, sekarang aku bisa tidur
Dialog: 0,0:36:28.26,0:36:31.55,teks umum,,0,0,0,,Tetapi tinnitus dan sakit kepala masih tetap ada
Dialog: 0,0:36:31.64,0:36:34.01,teks umum,,0,0,0,,Berita tentang perantau semakin memburuk
Dialog: 0,0:36:34.10,0:36:35.89,teks umum,,0,0,0,,keadaanmu
Dialog: 0,0:36:35.97,0:36:38.52,teks umum,,0,0,0,,Seorang pengembara mencoba memasuki istana
Dialog: 0,0:36:38.60,0:36:41.44,teks umum,,0,0,0,,Di dalam, mungkin mereka juga ada di sana
Dialog: 0,0:36:42.02,0:36:43.44,miring,,0,0,0,,Deputi Gwangju Jin Moo
Dialog: 0,0:36:43.52,0:36:45.52,teks umum,,0,0,0,,keamanan ditingkatkan, jadi jangan khawatir
Dialog: 0,0:36:45.61,0:36:48.24,teks umum,,0,0,0,,Orangnya yang mencoba sampai ke sini!
Dialog: 0,0:36:48.99,0:36:50.11,miring,,0,0,0,,Dan ada rumor,
Dialog: 0,0:36:50.20,0:36:53.16,teks umum,,0,0,0,,pengembara lain terlihat di Chonbugwan
Dialog: 0,0:36:54.99,0:36:56.74,teks umum,,0,0,0,,Saya tidak bisa mempercayai siapa pun
Dialog: 0,0:36:59.62,0:37:03.00,teks umum,,0,0,0,,Sepertinya kegelisahan anda berasal dari hati, Yang Mulia
Dialog: 0,0:37:03.08,0:37:06.59,teks umum,,0,0,0,,Mungkin kami bisa mencari cara lain untuk menenangkanmu?
Dialog: 0,0:37:07.67,0:37:11.13,teks umum,,0,0,0,,Apakah kamu kenal Hemp Master Li?
Dialog: 0,0:37:11.22,0:37:13.26,teks umum,,0,0,0,,Murid terakhir master So Kyung
Dialog: 0,0:37:13.84,0:37:15.93,miring,,0,0,0,,Saya mendengar tentang dia,
Dialog: 0,0:37:16.01,0:37:17.97,teks umum,,0,0,0,,tapi hanya terlihat sekali di Sosnovy Bor
Dialog: 0,0:37:18.77,0:37:22.98,teks umum,,0,0,0,,Kakekku adalah muridnya, jadi aku banyak mendengar tentang dia
Dialogue: 0,0:37:23.06,0:37:27.02,teks umum,,0,0,0,,Mungkin bisa meredakan kegelisahanmu
Dialog: 0,0:37:27.98,0:37:29.82,teks umum,,0,0,0,,Apakah maksudmu dia bisa menentukan,
Dialog: 0,0:37:29.90,0:37:31.99,teks umum,,0,0,0,,apakah ada pengembara di sekitarku?
Dialog: 0,0:37:32.07,0:37:34.61,teks umum,,0,0,0,,Saya tidak mengenalnya secara pribadi, jadi saya tidak tahu
Dialog: 0,0:37:34.70,0:37:38.33,teks umum,,0,0,0,,Saya pikir Anda bisa mengundangnya ke istana dan meminta bantuan
Dialog: 0,0:37:44.75,0:37:46.59,teks umum,,0,0,0,,Sudah kubilang bersihkan di sini setiap hari!
Dialog: 0,0:37:46.67,0:37:49.21,teks umum,,0,0,0,,Air dalam vas sudah rusak!
Dialog: 0,0:37:50.51,0:37:51.47,teks umum,,0,0,0,,Maaf
Dialog: 0,0:37:52.38,0:37:54.01,miring,,0,0,0,,Bagaimana jika Boo Young kembali
Dialog: 0,0:37:54.09,0:37:56.14,teks umum,,0,0,0,,dan melihat vas dengan air tergenang di sini?
Dialog: 0,0:37:56.22,0:37:57.89,teks umum,,0,0,0,,Dia akan kecewa padaku
Dialog: 0,0:37:58.93,0:38:00.56,miring,,0,0,0,,Ganti seprai
Dialog: 0,0:38:00.64,0:38:02.02,teks umum,,0,0,0,,dan hilangkan
Dialogue: 0,0:38:02.10,0:38:04.06,teks umum,,0,0,0,,Dia buta, jadi kenapa kamu taruh ini di sini?
Dialog: 0,0:38:04.14,0:38:05.81,miring,,0,0,0,,Untuk dia tersandung?
Dialog: 0,0:38:18.70,0:38:20.95,teks umum,,0,0,0,,Puluhan gadis telah mendatangi kami,
Dialog: 0,0:38:22.12,0:38:23.62,teks umum,,0,0,0,,tapi Bu Young tidak ada di antara mereka
Dialog: 0,0:38:24.16,0:38:28.38,teks umum,,0,0,0,,Dia kesal dengan hal ini, menjadi sangat sensitif
Dialog: 0,0:38:28.46,0:38:29.80,teks umum,,0,0,0,,Saya juga menyadarinya
Dialog: 0,0:38:30.71,0:38:33.55,teks umum,,0,0,0,,Tapi ulang tahunmu akan segera tiba
Dialog: 0,0:38:36.55,0:38:39.55,teks umum,,0,0,0,,- Ini\N- Apa ini?
Dialog: 0,0:38:42.56,0:38:45.14,teks umum,,0,0,0,,Ayah, mereka cantik sekali
Dialog: 0,0:38:46.69,0:38:48.77,teks umum,,0,0,0,,Tapi ulang tahunku bukan hari ini
Dialog: 0,0:38:48.86,0:38:51.48,teks umum,,0,0,0,,Pada hari ini aku akan memberikan sesuatu yang lebih indah
Dialog: 0,0:38:53.07,0:38:55.45,teks umum,,0,0,0,,Saya ingin mencobanya. Bisakah Anda membantu saya?
Dialog: 0,0:38:56.95,0:38:58.03,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:39:02.37,0:39:06.25,teks umum,,0,0,0,,Mari kita lihat betapa cantiknya putriku
Dialog: 0,0:39:06.92,0:39:10.63,teks umum,,0,0,0,,Saat aku kecil, kamu selalu mengepang rambutku
Dialog: 0,0:39:15.26,0:39:19.05,teks umum,,0,0,0,,Ibu tidak pernah melakukan ini
Dialog: 0,0:39:21.51,0:39:23.43,teks umum,,0,0,0,,Maaf. Apakah itu sangat menyakitkan?
Dialog: 0,0:39:24.52,0:39:25.64,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:39:40.16,0:39:43.74,teks umum,,0,0,0,,Aku mungkin lupa cara mengepang rambut, sudah lama aku tidak melakukannya
Dialog: 0,0:39:43.83,0:39:44.83,teks umum,,0,0,0,,Maaf
Dialog: 0,0:39:44.91,0:39:48.00,teks umum,,0,0,0,,Semuanya baik-baik saja. Seperti apa rupaku?
Dialog: 0,0:39:48.62,0:39:50.25,teks umum,,0,0,0,,Kamu selalu cantik
Dialog: 0,0:40:23.78,0:40:25.83,teks umum,,0,0,0,,Pak Jin menembakku dengan busur ini
Dialog: 0,0:40:28.58,0:40:30.08, sulih suara,,0,0,0,,Aku kalah hari itu
Dialogue: 0,0:40:30.17,0:40:33.54, sulih suara,,0,0,0,,Aku tidak bisa memberikan alasan atau tidak menerima hasil pertarungan
Dialogue: 0,0:40:36.09,0:40:38.05, sulih suara,,0,0,0,,Tapi ketika kekuatanku kembali,
Dialog: 0,0:40:39.01,0:40:42.01, sulih suara,,0,0,0,,Saya ingin melawannya secara nyata
Dialog: 0,0:40:53.98,0:40:55.07,miring,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:40:56.65,0:40:58.53,teks umum,,0,0,0,,Keluar, bab
Dialog: 0,0:41:00.57,0:41:02.11,teks umum,,0,0,0,,Jangan sentuh semuanya
Dialog: 0,0:41:02.70,0:41:05.87,teks umum,,0,0,0,,Senjata yang mengandung energi penyihir yang kuat,
Dialog: 0,0:41:05.95,0:41:08.75,teks umum,,0,0,0,,berbahaya bagi gadis rapuh
Dialog: 0,0:41:10.37,0:41:12.58,teks umum,,0,0,0,,Bahkan aku tahu ini
Dialog: 0,0:41:13.17,0:41:16.38,teks umum,,0,0,0,,Tapi kenapa kamu menaruhnya di sini?
Dialog: 0,0:41:16.46,0:41:19.05,teks umum,,0,0,0,,Saya harus bersih-bersih di sini
Dialog: 0,0:41:19.13,0:41:21.88,teks umum,,0,0,0,,Saya biasanya menggantungnya di dinding
Dialog: 0,0:41:22.97,0:41:24.14,teks umum,,0,0,0,,saya lupa kali ini
Dialog: 0,0:41:24.22,0:41:25.93,teks umum,,0,0,0,,Tapi kamu masih sangat muda
Dialog: 0,0:41:26.01,0:41:29.60,teks umum,,0,0,0,,Aku tidak percaya kamu sudah begitu pelupa
Dialog: 0,0:41:30.31,0:41:33.56,teks umum,,0,0,0,,Aku hanya khawatir, seperti pelayan Sosnovy Bor
Dialog: 0,0:41:33.65,0:41:36.65,teks umum,,0,0,0,,Bagaimana jika kamu lupa membayarku?
Dialog: 0,0:41:37.44,0:41:38.53,miring,,0,0,0,,Bab
Dialog: 0,0:41:38.61,0:41:42.11,teks umum,,0,0,0,,Tolong sehatlah. Kamu masih sangat muda
Dialog: 0,0:41:45.41,0:41:48.41,teks umum,,0,0,0,,Saya akan kembali lagi nanti untuk menyelesaikan pembersihan
Dialog: 0,0:41:54.42,0:41:56.58,teks umum,,0,0,0,,Betapa cerdasnya,
Dialog: 0,0:41:57.38,0:41:59.00,teks umum,,0,0,0,,tapi gadis kurang ajar
Dialog: 0,0:41:59.71,0:42:01.26,teks umum,,0,0,0,,Seperti Moo Dok
Dialog: 0,0:42:01.34,0:42:04.34,teks umum,,0,0,0,,bertemu dengan Inggris?
Dialog: 0,0:42:04.43,0:42:05.93,teks umum,,0,0,0,,Saya tidak tahu detailnya
Dialog: 0,0:42:06.01,0:42:09.85,teks umum,,0,0,0,,Tapi kudengar dia membayar utangnya dan mengambilnya dari Chwisongru
Dialog: 0,0:42:09.93,0:42:12.06,teks umum,,0,0,0,,Lalu pergi ke Chwisongru
Dialog: 0,0:42:12.14,0:42:14.77,teks umum,,0,0,0,,dan bertanya tentang dia
Dialog: 0,0:42:15.48,0:42:19.02,teks umum,,0,0,0,,Pelajari tentang masa lalunya dan karakternya
Dialog: 0,0:42:20.11,0:42:21.94,teks umum,,0,0,0,,Saya hanya penasaran
Dialog: 0,0:42:25.49,0:42:27.37,teks umum,,0,0,0,,Saya juga tidak tahu banyak
Dialog: 0,0:42:27.45,0:42:30.49,teks umum,,0,0,0,,Tapi pedagang yang membawanya sekarang ada di ibu kota
Dialog: 0,0:42:30.58,0:42:33.20,teks umum,,0,0,0,,Saya akan menyuruhnya datang ke Sosnovy Bor
Dialog: 0,0:42:35.83,0:42:38.04,miring,,0,0,0,,Halo
Dialog: 0,0:42:40.50,0:42:42.21,teks umum,,0,0,0,,Apakah kita pernah bertemu di desa Sari?
Dialog: 0,0:42:42.80,0:42:44.51,teks umum,,0,0,0,,Apa yang kamu perlukan kali ini?
Dialogue: 0,0:42:44.59,0:42:45.76,teks umum,,0,0,0,,Jadi aku
Dialog: 0,0:42:45.84,0:42:47.80,miring,,0,0,0,,Apakah kamu pernah bertemu dengannya di ibu kota?
Dialog: 0,0:42:48.30,0:42:50.60,teks umum,,0,0,0,,Tahukah kamu di mana dia berada?
Dialog: 0,0:42:50.68,0:42:53.77,teks umum,,0,0,0,,Saya tidak tahu. Dia bukan penduduk Sari
Dialogue: 0,0:42:54.35,0:42:57.60,teks umum,,0,0,0,,Dia disana selama beberapa bulan, lalu dia merampok penduduk desa
Dialog: 0,0:42:57.69,0:42:59.06,teks umum,,0,0,0,,Beri tahu aku jika kamu menangkapnya
Dialog: 0,0:43:04.07,0:43:06.49,teks umum,,0,0,0,,Di mana saya bisa menemukannya?
Dialog: 0,0:43:10.41,0:43:11.45,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:43:12.20,0:43:14.58,teks umum,,0,0,0,,So Yi, kamu punya teman yang buruk
Dialog: 0,0:43:16.08,0:43:19.13,teks umum,,0,0,0,,Mungkin dia pergi mencari Moo Deok?
Dialog: 0,0:43:22.63,0:43:25.22,teks umum,,0,0,0,,Segera aku akan membawamu ke Jinyeowon
Dialog: 0,0:43:25.30,0:43:27.88,teks umum,,0,0,0,,Tapi pertama-tama kita perlu mengurus sesuatu
Dialog: 0,0:43:37.81,0:43:40.27,kenangan,,0,0,0,,Ini, makan
Dialogue: 0,0:43:40.36,0:43:42.52,kenangan,,0,0,0,,Kau mencuri uangku
Dialog: 0,0:43:42.61,0:43:43.86,kenangan,,0,0,0,,Kembalikan cincinku
Dialog: 0,0:43:49.57,0:43:52.37,teks umum,,0,0,0,,Apakah kamu bertemu mereka di ibu kota?
Dialog: 0,0:43:52.45,0:43:55.50,teks umum,,0,0,0,,Ya, tapi kenapa kamu membawanya ke sini?
Dialog: 0,0:43:55.58,0:43:58.37,teks umum,,0,0,0,,Aku suka kamu cerdas dan gigih
Dialog: 0,0:43:58.92,0:44:00.83,teks umum,,0,0,0,,Tapi itu juga membuatmu berbahaya
Dialogue: 0,0:44:01.92,0:44:03.92,teks umum,,0,0,0,,Saya ingin kamu melihat sesuatu
Dialog: 0,0:44:20.73,0:44:21.94,teks umum,,0,0,0,,Deputi Gwangju
Dialog: 0,0:44:22.48,0:44:25.28,teks umum,,0,0,0,,Terima kasih telah memberiku makan
Dialog: 0,0:45:27.00,0:45:28.46,teks umum,,0,0,0,,Takut
Dialog: 0,0:45:28.55,0:45:32.47,teks umum,,0,0,0,,Mengkhianatiku atau mengungkapkan identitasmu, dan kamu akan mengalami nasib yang sama
Dialog: 0,0:45:38.39,0:45:39.39,teks umum,,0,0,0,,Oke
Dialog: 0,0:45:40.35,0:45:42.98,teks umum,,0,0,0,,Beri tahu saya jika ada orang lain yang mungkin mengenali Anda
Dialog: 0,0:45:43.48,0:45:44.81,miring,,0,0,0,,Aku harus membuangnya
Dialog: 0,0:45:46.31,0:45:47.69,teks umum,,0,0,0,,Ya?
Dialog: 0,0:45:51.65,0:45:52.82,teks umum,,0,0,0,,Ya
Dialog: 0,0:45:56.20,0:45:59.79,teks umum,,0,0,0,,Cari lebih teliti. Saya pasti melemparkannya ke sana
Dialog: 0,0:45:59.87,0:46:01.25,teks umum,,0,0,0,,Saya tidak melihat apa pun
Dialog: 0,0:46:01.83,0:46:04.12,teks umum,,0,0,0,,Lihat disana
Dialog: 0,0:46:04.21,0:46:06.96,teks umum,,0,0,0,,Saya perhatikan baik-baik, tidak ada apa-apa di sana
Dialog: 0,0:46:07.04,0:46:08.75,teks umum,,0,0,0,,Lihat lagi
Dialog: 0,0:46:08.84,0:46:10.21,teks umum,,0,0,0,,Saya hampir tidak bisa melihat...
Dialog: 0,0:46:11.38,0:46:12.59,teks umum,,0,0,0,,Ya, Yang Mulia
Dialogue: 0,0:46:13.13,0:46:15.09,teks umum,,0,0,0,,Aku yakin dia ada di suatu tempat
Dialog: 0,0:46:15.18,0:46:16.84,teks umum,,0,0,0,,Ya, lihat di sana
Dialog: 0,0:46:21.43,0:46:22.77,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:46:24.98,0:46:26.27,teks umum,,0,0,0,,Bukan urusanmu. Pergilah
Dialog: 0,0:46:27.44,0:46:30.98,teks umum,,0,0,0,,Aku khawatir kasim O menderita sia-sia
Dialog: 0,0:46:31.07,0:46:34.65,teks umum,,0,0,0,,Saya harus mengatakan sesuatu. Bisa?
Dialog: 0,0:46:34.74,0:46:36.28,teks umum,,0,0,0,,Apa yang kamu punya?
Dialog: 0,0:46:37.70,0:46:38.66,teks umum,,0,0,0,,Mungkin,
Dialog: 0,0:46:39.70,0:46:40.79,teks umum,,0,0,0,,yang anda cari
Dialog: 0,0:46:41.58,0:46:43.12,teks umum,,0,0,0,,apakah ini?
Dialog: 0,0:46:44.71,0:46:45.71,teks umum,,0,0,0,,Sudahkah kamu menemukannya?
Dialog: 0,0:46:45.79,0:46:49.21,teks umum,,0,0,0,,Saya mencari siang dan malam, menemukannya belum lama ini
Dialogue: 0,0:46:53.84,0:46:55.26,teks umum,,0,0,0,,Kau membuangnya
Dialog: 0,0:46:55.93,0:46:58.51,teks umum,,0,0,0,,Dan aku mengambilnya, artinya itu milikku lagi
Dialog: 0,0:47:02.89,0:47:05.27,teks umum,,0,0,0,,Kasim Oh, kamu bisa keluar dari sana
Dialog: 0,0:47:06.60,0:47:07.90,teks umum,,0,0,0,,Ya
Dialog: 0,0:47:11.07,0:47:14.32,teks umum,,0,0,0,,Berkat kamu, aku mendapatkan sesuatu yang berharga
Dialog: 0,0:47:14.90,0:47:18.07,teks umum,,0,0,0,,Aku mendapatkannya lagi terima kasih padamu
Dialog: 0,0:47:19.66,0:47:20.70,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:47:20.78,0:47:24.75,teks umum,,0,0,0,,Saya tidak merusaknya, tidak membuangnya jauh-jauh
Dialog: 0,0:47:24.83,0:47:27.33,teks umum,,0,0,0,,Kamu menemukannya karena aku melemparkannya ke dekat
Dialog: 0,0:47:27.42,0:47:32.92,teks umum,,0,0,0,,Saya berani mencoba memahami Anda, Yang Mulia
Dialog: 0,0:47:33.00,0:47:36.13,teks umum,,0,0,0,,Kamu membuat alasan dan marah karena
Dialog: 0,0:47:36.22,0:47:38.26,teks umum,,0,0,0,,apa yang kamu minta maaf?
Dialog: 0,0:47:38.89,0:47:41.85,teks umum,,0,0,0,,Von Moo Deok seharusnya hanya mendengarkan tanpa berusaha memahami
Dialogue: 0,0:47:41.93,0:47:43.72,teks umum,,0,0,0,,Beraninya kamu mencoba?
Dialog: 0,0:47:43.81,0:47:45.77,teks umum,,0,0,0,,Maaf, Yang Mulia
Dialog: 0,0:47:49.06,0:47:50.15,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:47:53.94,0:47:55.07,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:47:55.15,0:47:58.82,teks umum,,0,0,0,,Guru Ho memintaku untuk memberitahumu bahwa Guru Li telah tiba
Dialog: 0,0:47:58.91,0:48:01.07,teks umum,,0,0,0,,Oke. Apakah dia di Saejukwon?
Dialog: 0,0:48:01.16,0:48:04.62,teks umum,,0,0,0,,Ya. Muridnya Chang Wook bersamanya
Dialog: 0,0:48:06.41,0:48:08.83,teks umum,,0,0,0,,Mereka bilang Chan Wook telah mencapai kesuksesan seperti itu
Dialog: 0,0:48:08.92,0:48:10.83,teks umum,,0,0,0,,terima kasih atas instruksi Guru Li
Dialog: 0,0:48:10.92,0:48:12.67,teks umum,,0,0,0,,Jika bukan karena ini,
Dialog: 0,0:48:12.75,0:48:14.88,teks umum,,0,0,0,,dia tidak akan mengalahkanmu
Dialog: 0,0:48:17.88,0:48:18.84,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:48:30.94,0:48:33.44,teks umum,,0,0,0,,Sekarang kamu melayani Seo Yul, bukan Chan Wook
Dialog: 0,0:48:34.07,0:48:36.48,teks umum,,0,0,0,,Jika aku mengalahkan Chang Wook,
Dialog: 0,0:48:36.57,0:48:38.28,teks umum,,0,0,0,,maukah kamu melayaniku
Dialog: 0,0:48:38.36,0:48:40.15,teks umum,,0,0,0,,Jika kamu tidak menolak pertarungan,
Dialog: 0,0:48:40.86,0:48:43.87,teks umum,,0,0,0,,kamu tidak perlu melayaniku
Dialog: 0,0:48:43.95,0:48:46.66,teks umum,,0,0,0,,Aku akan membiarkan dia menang karena kasihan
Dialog: 0,0:48:47.25,0:48:48.66,teks umum,,0,0,0,,Apakah kamu tidak merasa kasihan padanya?
Dialog: 0,0:48:48.75,0:48:50.41,teks umum,,0,0,0,,Semua orang di Sosnovy Bor tahu,
Dialog: 0,0:48:50.50,0:48:52.75,teks umum,,0,0,0,,bahwa Chan Wook mengamalkan kesucian
Dialog: 0,0:48:53.33,0:48:55.17,teks umum,,0,0,0,,- Begitukah?\N- Jangan berpura-pura tidak tahu
Dialog: 0,0:48:55.25,0:48:56.55,teks umum,,0,0,0,,Kamu lebih tahu dari siapa pun
Dialog: 0,0:48:57.13,0:48:59.17,teks umum,,0,0,0,,Kamu tidak membawanya kepadanya
Dialog: 0,0:48:59.76,0:49:01.18,teks umum,,0,0,0,,teh kesucian?
Dialog: 0,0:49:01.26,0:49:02.43,teks umum,,0,0,0,,Saya belum pernah melakukan ini
Dialog: 0,0:49:02.51,0:49:05.60,teks umum,,0,0,0,,Bagaimana lagi dia menguasai Chisa begitu cepat?
Dialog: 0,0:49:06.97,0:49:08.98,teks umum,,0,0,0,,Dia bahkan bukan putra Chang Gan
Dialog: 0,0:49:10.31,0:49:14.02,teks umum,,0,0,0,,Ibunya menikah dengan Chang Gan dan melahirkan seorang putra
Dialog: 0,0:49:14.73,0:49:17.36,teks umum,,0,0,0,,Dan sekarang putranya akan mewarisi segalanya
Dialog: 0,0:49:18.69,0:49:22.49,teks umum,,0,0,0,,Ayahnya menutup gerbangnya untuk mengakhiri barisan Uka
Dialog: 0,0:49:22.57,0:49:25.53,teks umum,,0,0,0,,Tapi Chan Wook membukanya, dia harusnya suci
Dialog: 0,0:49:26.45,0:49:27.54,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:49:28.83,0:49:32.04,teks umum,,0,0,0,,Licik dan jahat
Dialog: 0,0:49:32.62,0:49:33.46,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:35.00,0:49:36.25,teks umum,,0,0,0,,Apa katamu?
Dialogue: 0,0:49:37.50,0:49:40.17,teks umum,,0,0,0,,- Kamu dengar\N- Beraninya kamu?
Dialog: 0,0:49:40.67,0:49:43.22,teks umum,,0,0,0,,- Ulangi\N- Lalu kamu akan memukulku
Dialog: 0,0:49:43.30,0:49:44.55,teks umum,,0,0,0,,Kalau begitu beritahu aku!
Dialog: 0,0:49:46.93,0:49:48.18,miring,,0,0,0,,Beri tahu mereka
Dialog: 0,0:49:58.48,0:49:59.69,teks umum,,0,0,0,,Jika mereka mendengar,
Dialog: 0,0:49:59.78,0:50:03.57,teks umum,,0,0,0,,ucapkan dengan lantang dan jelas
Dialog: 0,0:50:09.37,0:50:12.46,teks umum,,0,0,0,,Kamu keji dan jahat
Dialog: 0,0:50:14.50,0:50:17.04,teks umum,,0,0,0,,Itulah yang dia katakan. Mengerti?
Dialog: 0,0:50:17.67,0:50:18.50,teks umum,,0,0,0,,Ya
Dialog: 0,0:50:19.59,0:50:22.34,teks umum,,0,0,0,,Moo Dok, aku memberimu sesuatu
Dialog: 0,0:50:22.42,0:50:23.59,teks umum,,0,0,0,,Tunjukkan pada mereka
Dialog: 0,0:50:30.47,0:50:32.23,teks umum,,0,0,0,,Sachet ini adalah hadiahku
Dialog: 0,0:50:32.31,0:50:36.44,teks umum,,0,0,0,,Jika seseorang memukul, menegur, atau menghinamu saat aku tidak ada,
Dialog: 0,0:50:36.52,0:50:38.31,teks umum,,0,0,0,,beritahu saja padaku
Dialog: 0,0:50:39.57,0:50:40.52,teks umum,,0,0,0,,Ya
Dialog: 0,0:50:42.61,0:50:43.86,teks umum,,0,0,0,,Kamu boleh pergi
Dialogue: 0,0:50:53.08,0:50:55.62,teks umum,,0,0,0,,Bodoh sekali kalau punya musuh
Dialog: 0,0:50:55.71,0:50:59.29,teks umum,,0,0,0,,karena iri karena ada yang lebih kuat
Dialog: 0,0:51:08.72,0:51:10.39,teks umum,,0,0,0,,Ada tinta di bajumu
Dialog: 0,0:51:11.06,0:51:13.77,teks umum,,0,0,0,,Bisa dibiakkan dengan nasi putih
Dialog: 0,0:51:15.02,0:51:17.10,teks umum,,0,0,0,,Ini adalah dua warna yang sangat berbeda
Dialog: 0,0:51:17.94,0:51:20.56,teks umum,,0,0,0,,Tapi bersama-sama mereka bisa menghilangkan noda
Dialog: 0,0:51:21.19,0:51:22.69,teks umum,,0,0,0,,Kata-kata bijak
Dialog: 0,0:51:23.44,0:51:25.86,teks umum,,0,0,0,,Di mana Anda membacanya, Yang Mulia?
Dialog: 0,0:51:27.32,0:51:28.74,teks umum,,0,0,0,,Disini sana-sini
Dialog: 0,0:51:28.82,0:51:31.08,teks umum,,0,0,0,,Ini hanya ditanyakan pada ujian tersulit
Dialog: 0,0:51:45.55,0:51:47.43,teks umum,,0,0,0,,Tuanku tidak ada di sini?
Dialog: 0,0:51:50.85,0:51:53.72,teks umum,,0,0,0,,Kudengar kamu terluka. Apakah kamu baik-baik saja?
Dialog: 0,0:51:54.31,0:51:57.27,teks umum,,0,0,0,,Ya, terima kasih. Terima kasih untuk obat-obatan itu
Dialog: 0,0:51:59.27,0:52:03.36,teks umum,,0,0,0,,Pembantu Kim mengundangku makan malam
Dialog: 0,0:52:04.69,0:52:07.78,teks umum,,0,0,0,,Mungkin Anda mau bergabung dengan kami?
Dialog: 0,0:52:08.74,0:52:09.66,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:52:11.78,0:52:14.70,teks umum,,0,0,0,,Lalu aku akan memilih hari dan memberitahu Moo Deok
Dialog: 0,0:52:15.58,0:52:17.08,teks umum,,0,0,0,,Apakah kamu kenal pembantuku?
Dialog: 0,0:52:17.16,0:52:20.21,teks umum,,0,0,0,,Aku pernah datang menemuimu,
Dialog: 0,0:52:20.29,0:52:21.92,teks umum,,0,0,0,,tapi tidak berhasil bagiku
Dialog: 0,0:52:22.71,0:52:25.25,teks umum,,0,0,0,,Dia masuk ke kamarmu lalu
Dialog: 0,0:52:30.97,0:52:32.14,kenangan,,0,0,0,,Jangan pergi
Dialog: 0,0:52:33.35,0:52:35.14,kenangan,,0,0,0,,Jangan pergi ke tempatmu, tetaplah di sini
Dialog: 0,0:52:36.10,0:52:37.89,kenangan,,0,0,0,,Aku akan membawakan pakaianmu
Dialog: 0,0:52:39.98,0:52:41.02,teks umum,,0,0,0,,Apa itu tadi?
Dialog: 0,0:52:41.90,0:52:43.23,teks umum,,0,0,0,,Sebuah langkah menuju?
Dialog: 0,0:52:43.77,0:52:45.32,teks umum,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:52:47.23,0:52:48.36,teks umum,,0,0,0,,Ya begitu
Dialog: 0,0:52:55.49,0:52:56.49,teks umum,,0,0,0,,Tunggu sebentar
Dialog: 0,0:52:57.75,0:52:59.79,teks umum,,0,0,0,,Tenang
Dialog: 0,0:53:00.75,0:53:01.92,teks umum,,0,0,0,,Terbang jauh
Dialog: 0,0:53:02.71,0:53:04.09,teks umum,,0,0,0,,- Benarkah?\N- Ya
Dialogue: 0,0:53:06.21,0:53:08.13,italic,,0,0,0,,aku sangat takut
Dialog: 0,0:53:21.19,0:53:22.31,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,0:53:38.62,0:53:40.96,teks umum,,0,0,0,,Moo Dok, kita bertemu lagi
Dialog: 0,0:53:44.38,0:53:46.25,teks umum,,0,0,0,,Jaga dirimu sendiri
Dialog: 0,0:53:46.34,0:53:47.67,teks umum,,0,0,0,,Sampai jumpa di istana
Dialog: 0,0:53:47.75,0:53:49.09,teks umum,,0,0,0,,Ya
Dialog: 0,0:54:02.64,0:54:04.27,teks umum,,0,0,0,,Apa itu? Apakah kamu lari ke sini?
Dialog: 0,0:54:05.19,0:54:06.11,teks umum,,0,0,0,,Ya
Dialog: 0,0:54:06.19,0:54:08.86,teks umum,,0,0,0,,Sudah lama sekali sejak kau mengunjungiku saat aku terluka
Dialog: 0,0:54:08.94,0:54:09.78,teks umum,,0,0,0,,Ada apa?
Dialog: 0,0:54:09.86,0:54:12.15,teks umum,,0,0,0,,Sesuatu yang lebih serius daripada pergantian pemilik?
Dialog: 0,0:54:12.24,0:54:13.20,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:13.28,0:54:15.24,teks umum,,0,0,0,,Penyihir lain bergosip tentangmu
Dialogue: 0,0:54:15.32,0:54:16.49,teks umum,,0,0,0,,Aku ingin mengetahui kebenarannya
Dialog: 0,0:54:16.57,0:54:18.91,teks umum,,0,0,0,,Mengerti. Pernahkah Anda mendengar tentang teh itu?
Dialog: 0,0:54:18.99,0:54:20.74,teks umum,,0,0,0,,Tapi kamu tahu yang sebenarnya
Dialog: 0,0:54:20.83,0:54:24.12,teks umum,,0,0,0,,Bagaimana jika? Anda menangkap Ikan Emas saat saya pergi
Dialogue: 0,0:54:24.87,0:54:27.04,teks umum,,0,0,0,,Mungkin kamu benar-benar menjadi murid Guru Li
Dialog: 0,0:54:27.13,0:54:29.25,teks umum,,0,0,0,,Apa? Tidak, tentu saja
Dialog: 0,0:54:29.34,0:54:30.38,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:54:30.46,0:54:32.47,teks umum,,0,0,0,,Saya sendiri yang menyarankannya kepada Anda
Dialog: 0,0:54:33.26,0:54:34.88,teks umum,,0,0,0,,Mungkin tidak bisa menolak
Dialog: 0,0:54:34.97,0:54:36.84,teks umum,,0,0,0,,Bagaimana saya bisa membuktikannya kepada Anda?
Dialog: 0,0:54:38.01,0:54:39.35,teks umum,,0,0,0,,Anda sendiri yang mengatakannya
Dialog: 0,0:54:49.15,0:54:50.15,teks umum,,0,0,0,,Lihat?
Dialog: 0,0:54:52.65,0:54:54.07,teks umum,,0,0,0,,Kamu tidak melihat seorang wanita dalam diriku
Dialog: 0,0:54:54.15,0:54:57.20,teks umum,,0,0,0,,Seharusnya aku memeluk gadis manis itu sebagai bukti
Dialogue: 0,0:54:58.57,0:55:00.62,teks umum,,0,0,0,,Haruskah aku memeluknya?
Dialog: 0,0:55:01.83,0:55:03.87,teks umum,,0,0,0,,Ya. Ayolah
Dialog: 0,0:55:03.95,0:55:05.62,teks umum,,0,0,0,,Jangan berubah pikiran nanti
Dialog: 0,0:55:05.71,0:55:07.08,teks umum,,0,0,0,,Oke, ayo!
Dialog: 0,0:55:42.33,0:55:43.99,teks umum,,0,0,0,,Kamu bilang kita perlu menyerang,
Dialog: 0,0:55:44.08,0:55:46.46,teks umum,,0,0,0,,ketika musuh tidak menduganya
Dialog: 0,0:55:47.62,0:55:51.00,teks umum,,0,0,0,,Saya mengikuti saran Anda, guru
Dialog: 0,0:55:53.80,0:55:56.59,teks umum,,0,0,0,,Ya. Bagus sekali. aku bangga padamu
Dialog: 0,0:55:58.84,0:56:00.01,teks umum,,0,0,0,,Ngomong-ngomong, guru,
Dialog: 0,0:56:00.64,0:56:04.31,teks umum,,0,0,0,,Kudengar kau bertemu dengannya di kamarku
Dialog: 0,0:56:06.48,0:56:07.56,teks umum,,0,0,0,,Jadi apa?
Dialog: 0,0:56:07.64,0:56:09.35,teks umum,,0,0,0,,Itukah sebabnya kamu menghentikanku?
Dialog: 0,0:56:13.15,0:56:14.69,teks umum,,0,0,0,,Apakah ini benar-benar terjadi?
Dialog: 0,0:56:15.53,0:56:17.03,teks umum,,0,0,0,,Saya tidak ingat
Dialog: 0,0:56:17.74,0:56:19.82,teks umum,,0,0,0,,Memahamimu lebih sulit daripada mengendalikanmu
Dialog: 0,0:56:19.91,0:56:21.28,teks umum,,0,0,0,,energi Gyeongcheongdaeho
Dialogue: 0,0:56:22.74,0:56:24.49,teks umum,,0,0,0,,Kau menghentikanku
Dialog: 0,0:56:27.00,0:56:29.50,teks umum,,0,0,0,,Guru, saya akan ke istana hari ini
Dialog: 0,0:56:29.58,0:56:31.46,teks umum,,0,0,0,,Raja mengundang Guru Li,
Dialog: 0,0:56:32.08,0:56:34.17,teks umum,,0,0,0,,dan aku akan menemaninya
Dialog: 0,0:56:34.25,0:56:36.88,teks umum,,0,0,0,,Aku ingin bertemu ratu, dan sekarang aku mendapat kesempatan
Dialog: 0,0:56:37.63,0:56:39.17,teks umum,,0,0,0,,Hati-hati
Dialog: 0,0:56:40.47,0:56:43.30,teks umum,,0,0,0,,Saya akan. Aku akan menceritakan semuanya padamu saat aku kembali
Dialog: 0,0:56:51.27,0:56:52.31,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:56:56.61,0:56:57.90,teks umum,,0,0,0,,Saya menemukannya
Dialog: 0,0:56:59.65,0:57:03.66,teks umum,,0,0,0,,Itu terjadi, jadi kupikir aku harus memberitahumu
Dialog: 0,0:57:05.91,0:57:06.91,teks umum,,0,0,0,,Pergi
Dialog: 0,0:57:26.26,0:57:28.60,teks umum,,0,0,0,,Mengapa kepala Sosnovy Bor mencari saya?
Dialog: 0,0:57:29.64,0:57:31.73,teks umum,,0,0,0,,- Ingat Moo Dok?\N- Ya
Dialog: 0,0:57:31.81,0:57:34.81,teks umum,,0,0,0,,Dia ingin tahu lebih banyak tentang kehidupannya di Sari
Dialog: 0,0:57:34.90,0:57:38.15,teks umum,,0,0,0,,Dia bisa menanyakannya sendiri
Dialog: 0,0:57:38.23,0:57:39.19,teks umum,,0,0,0,,Dia ada di sini
Dialog: 0,0:57:39.28,0:57:41.74,teks umum,,0,0,0,,No. Dia ada di Sosnovy Bor
Dialog: 0,0:57:41.82,0:57:42.95,teks umum,,0,0,0,,Ya?
Dialogue: 0,0:57:43.74,0:57:46.58,teks umum,,0,0,0,,Apa yang dilakukan wanita buta itu di sana?
Dialog: 0,0:57:48.87,0:57:51.41,teks umum,,0,0,0,,Tuan Lee menginginkan kalian berdua dan Chan Wook
Dialog: 0,0:57:51.50,0:57:53.33,teks umum,,0,0,0,,mengantarnya ke istana
Dialog: 0,0:57:54.50,0:57:55.83,teks umum,,0,0,0,,Apakah Inggris juga akan berfungsi?
Dialogue: 0,0:57:57.34,0:57:58.46,teks umum,,0,0,0,,Apakah dia sudah merasa lebih baik?
Dialog: 0,0:57:58.55,0:58:00.42,teks umum,,0,0,0,,Kami segera berangkat. Bersiaplah
Dialog: 0,0:58:08.72,0:58:11.39,teks umum,,0,0,0,,Hati-hati di istana
Dialog: 0,0:58:11.48,0:58:13.85,teks umum,,0,0,0,,Ada batu es
Dialog: 0,0:58:15.52,0:58:17.11,teks umum,,0,0,0,,Saya sendiri mengetahuinya
Dialog: 0,0:58:17.19,0:58:20.36,teks umum,,0,0,0,,Karena mereka tanpa malu-malu menyembunyikannya,
Dialog: 0,0:58:20.44,0:58:23.40,teks umum,,0,0,0,,Aku memutuskan untuk bergerak dengan berani
Dialog: 0,0:58:28.99,0:58:31.58,teks umum,,0,0,0,,Kapan terakhir kali aku diundang ke istana,
Dialog: 0,0:58:32.16,0:58:34.58,teks umum,,0,0,0,,kamu masih sangat kecil
Dialog: 0,0:58:35.12,0:58:38.13,teks umum,,0,0,0,,Aku ingat betapa aku menyukai yang manis-manis,
Dialog: 0,0:58:38.21,0:58:40.50,teks umum,,0,0,0,,yang kemudian kamu bawa
Dialog: 0,0:58:40.59,0:58:41.76,teks umum,,0,0,0,,Omong-omong,
Dialogue: 0,0:58:42.34,0:58:45.97,teks umum,,0,0,0,,maukah kamu memberikan hadiah kepada raja?
Dialog: 0,0:58:46.05,0:58:48.01,teks umum,,0,0,0,,Saya sudah menyiapkan satu
Dialog: 0,0:58:48.10,0:58:48.97,teks umum,,0,0,0,,Yom
Dialog: 0,0:58:49.05,0:58:51.89,teks umum,,0,0,0,,Kirim hadiah ke istana pada waktu yang ditentukan
Dialog: 0,0:58:51.97,0:58:53.52,miring,,0,0,0,,Ya, guru
Dialog: 0,0:58:53.60,0:58:55.19,teks umum,,0,0,0,,Di suatu tempat antara jam 5 dan 7 malam?
Dialog: 0,0:58:55.27,0:58:56.69,teks umum,,0,0,0,,Antara 7 dan 9, bodoh!
Dialog: 0,0:58:57.27,0:58:59.02,teks umum,,0,0,0,,Tepat. Maaf
Dialog: 0,0:58:59.73,0:59:01.73,teks umum,,0,0,0,,Tuliskan jika kamu tidak dapat mengingatnya
Dialog: 0,0:59:02.65,0:59:04.15,teks umum,,0,0,0,,Kamu linglung sebelumnya,
Dialog: 0,0:59:04.24,0:59:07.16,teks umum,,0,0,0,,dan seiring bertambahnya usia segalanya menjadi lebih buruk
Dialog: 0,0:59:09.45,0:59:10.58,teks umum,,0,0,0,,Maju
Dialog: 0,0:59:11.08,0:59:12.75,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,0:59:13.95,0:59:16.62,teks umum,,0,0,0,,Aku tidak akan pernah terbiasa dengan ini kawan
Dialog: 0,0:59:45.24,0:59:46.36,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:59:47.99,0:59:49.87,teks umum,,0,0,0,,Kepala ingin bertemu denganmu
Dialog: 0,0:59:51.33,0:59:52.53,teks umum,,0,0,0,,Bab?
Dialog: 0,1:00:01.42,1:00:02.42,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:00:15.64,1:00:20.15,teks umum,,0,0,0,,Segala sesuatu tentangmu telah terungkap
Dialog: 0,1:00:21.11,1:00:24.69,teks umum,,0,0,0,,Aku bercerita padanya tentang matamu
Dialog: 0,1:00:29.28,1:00:30.82,di belakang layar,,0,0,0,,Sekarang semuanya akan terbuka?
Dialog: 0,1:00:32.45,1:00:35.12,teks umum,,0,0,0,,Bab, kamu lihat...
Dialog: 0,1:00:36.70,1:00:39.12,teks umum,,0,0,0,,Dia bukan satu-satunya yang berbohong
Dialog: 0,1:00:40.46,1:00:44.13,teks umum,,0,0,0,,Neneknya memohon padaku, jadi aku ikut bermain
Dialog: 0,1:00:44.92,1:00:48.30,teks umum,,0,0,0,,Keluarganya sangat miskin
Dialog: 0,1:00:48.38,1:00:50.30,teks umum,,0,0,0,,Dia berbohong bahwa dia buta,
Dialog: 0,1:00:50.88,1:00:53.35,teks umum,,0,0,0,,agar dia tidak dijual untuk melunasi hutang
Dialog: 0,1:00:53.43,1:00:55.64,teks umum,,0,0,0,,Seperti orang yang pura-pura timpang,
Dialog: 0,1:00:55.72,1:00:57.68,teks umum,,0,0,0,,agar tidak berperang
Dialogue: 0,1:00:57.77,1:01:01.56,teks umum,,0,0,0,,Kenapa kamu berbohong saat sampai di Chwisongra?
Dialog: 0,1:01:04.11,1:01:06.61,miring,,0,0,0,,Dia ingin melarikan diri
Dialog: 0,1:01:07.28,1:01:09.11,teks umum,,0,0,0,,Tentu saja, sudah terjual
Dialog: 0,1:01:09.19,1:01:12.66,teks umum,,0,0,0,,Tetapi menjadi buta akan lebih mudah untuk melarikan diri
Dialog: 0,1:01:13.28,1:01:15.62,teks umum,,0,0,0,,- Benar kan?\N- Ya
Dialog: 0,1:01:15.70,1:01:18.66,teks umum,,0,0,0,,Saya mencoba melarikan diri ketika bertemu dengan pemiliknya
Dialog: 0,1:01:19.37,1:01:22.04,teks umum,,0,0,0,,Dia kasihan padaku dan menerimaku
Dialog: 0,1:01:24.92,1:01:27.09,teks umum,,0,0,0,,Maaf berbohong, bab
Dialog: 0,1:01:28.30,1:01:29.55,teks umum,,0,0,0,,Saya berbuat salah
Dialog: 0,1:01:30.88,1:01:32.34,teks umum,,0,0,0,,Kecuali kebohongan ini,
Dialog: 0,1:01:32.43,1:01:34.26,teks umum,,0,0,0,,dia tidak memiliki dosa lain
Dialog: 0,1:01:34.34,1:01:38.06,teks umum,,0,0,0,,Dia selalu menjadi cucu yang baik dan gadis yang baik hati
Dialog: 0,1:01:49.82,1:01:51.99,teks umum,,0,0,0,,Kenapa kamu berbohong?
Dialog: 0,1:01:53.07,1:01:56.03,teks umum,,0,0,0,,Hanya menghasilkan uangku
Dialog: 0,1:01:56.62,1:01:57.91,teks umum,,0,0,0,,Apakah kamu mendapat uang?
Dialog: 0,1:02:00.66,1:02:03.00,teks umum,,0,0,0,,Apakah kamu tidak buta?
Dialog: 0,1:02:06.21,1:02:07.09,teks umum,,0,0,0,,Ya, ya
Dialogue: 0,1:02:07.17,1:02:10.63,teks umum,,0,0,0,,Bagiku selalu terasa aneh
Dialog: 0,1:02:11.63,1:02:13.76,teks umum,,0,0,0,,- Apa?\N- Meski buta,
Dialog: 0,1:02:13.84,1:02:16.09,teks umum,,0,0,0,,kamu selalu tahu siapa yang berdiri di depanmu
Dialog: 0,1:02:16.18,1:02:18.22,teks umum,,0,0,0,,Tahu apakah akan hujan atau salju
Dialogue: 0,1:02:18.81,1:02:23.31,teks umum,,0,0,0,,Penduduk desa mengira kamu berbohong tentang kebutaan
Dialog: 0,1:02:23.39,1:02:26.31,teks umum,,0,0,0,,Mereka takut dan menghindarimu
Dialog: 0,1:02:27.48,1:02:29.15,teks umum,,0,0,0,,- Begitu\N- Secara umum,
Dialog: 0,1:02:29.23,1:02:31.69,teks umum,,0,0,0,,kalau butuh bantuan, datanglah ke penginapan
Dialog: 0,1:02:31.78,1:02:32.82,teks umum,,0,0,0,,Oke?
Dialog: 0,1:02:33.57,1:02:34.49,teks umum,,0,0,0,,Omong-omong
Dialog: 0,1:02:35.03,1:02:37.32,teks umum,,0,0,0,,Apakah kamu sudah bertemu So Yi?
Dialog: 0,1:02:38.41,1:02:39.58,teks umum,,0,0,0,,Jadi saya?
Dialog: 0,1:02:39.66,1:02:41.66,teks umum,,0,0,0,,Dia sekarang berada di ibu kota
Dialog: 0,1:02:41.75,1:02:43.54,teks umum,,0,0,0,,Beberapa bandit sedang mencarinya
Dialog: 0,1:02:43.62,1:02:46.04,teks umum,,0,0,0,,Apa yang dia lakukan kali ini?
Dialog: 0,1:02:46.12,1:02:49.42,teks umum,,0,0,0,,Dia merampok rumahmu setelah nenekmu meninggal
Dialog: 0,1:02:50.25,1:02:52.38,teks umum,,0,0,0,,Jangan main-main dengannya
Dialog: 0,1:02:52.46,1:02:55.05,teks umum,,0,0,0,,Sepertinya Anda menyembunyikan sesuatu dari Sosnovy Bor
Dialog: 0,1:02:56.43,1:02:59.64,teks umum,,0,0,0,,Kamu bilang kamu bekerja untuk mendapatkan uang. Siapa yang membayarmu?
Dialog: 0,1:02:59.72,1:03:00.81,teks umum,,0,0,0,,Ju Wol
Dialog: 0,1:03:05.73,1:03:07.23,teks umum,,0,0,0,,Jangan berterima kasih padaku
Dialog: 0,1:03:07.73,1:03:09.77,teks umum,,0,0,0,,Itu uang Tuan Chan
Dialog: 0,1:03:14.24,1:03:19.12,kenangan,,0,0,0,,Jika ada yang bertanya tentang Moo Deok,
Dialog: 0,1:03:19.20,1:03:20.33,kenangan,,0,0,0,,gunakan uang ini
Dialog: 0,1:03:21.49,1:03:24.08,kenangan,,0,0,0,,Tentu saja, setengahnya milikmu
Dialog: 0,1:03:24.75,1:03:27.67,teks umum,,0,0,0,,Saya tidak menyembunyikan apa pun yang keji
Dialog: 0,1:03:27.75,1:03:29.67,teks umum,,0,0,0,,Dapat bagianku
Dialog: 0,1:03:30.75,1:03:32.55,teks umum,,0,0,0,,Ya, dan aku menyukaimu
Dialog: 0,1:03:33.55,1:03:35.22,teks umum,,0,0,0,,Saya sangat berterima kasih
Dialogue: 0,1:03:35.30,1:03:38.01,teks umum,,0,0,0,,Ada apa sebenarnya dengan matamu?
Dialog: 0,1:03:43.06,1:03:44.18,teks umum,,0,0,0,,Lupakan
Dialog: 0,1:03:44.27,1:03:45.98,teks umum,,0,0,0,,Mungkin ada alasannya
Dialog: 0,1:03:50.52,1:03:54.86,di belakang layar,,0,0,0,,Jika Chang Wook tidak bersiap terlebih dahulu, Park Jin akan mengetahui semuanya
Dialog: 0,1:03:55.49,1:03:59.76, sulih suara,,0,0,0,,Jika mereka menangkapku, Chan Wook juga akan menderita
Dialog: 0,1:04:13.34,1:04:15.26,teks umum,,0,0,0,,Selamat datang Guru Lee Chul
Dialog: 0,1:04:16.17,1:04:18.47,teks umum,,0,0,0,,Terima kasih atas undangannya, Yang Mulia
Dialog: 0,1:04:20.72,1:04:22.64,kenangan,,0,0,0,,Dukun ini Choi
Dialogue: 0,1:04:23.22,1:04:25.18,kenangan,,0,0,0,,memintamu membunuhku?
Dialog: 0,1:04:28.44,1:04:30.65,di belakang layar,,0,0,0,,Dukun Choi
Dialog: 0,1:04:30.73,1:04:32.48, sulih suara,,0,0,0,,Apakah ini ratunya?
Dialog: 0,1:04:38.78,1:04:39.82,teks umum,,0,0,0,,Moo Dok
Dialog: 0,1:04:43.28,1:04:45.08,teks umum,,0,0,0,,Jadi saya, yang Anda sebutkan
Dialog: 0,1:04:45.70,1:04:48.33,teks umum,,0,0,0,,Mungkin ini gadis yang mencarimu akhir-akhir ini
Dialog: 0,1:04:49.58,1:04:51.71,teks umum,,0,0,0,,Kudengar dia berbahaya. Hati-hati
Dialog: 0,1:04:55.13,1:04:58.05,di belakang layar,,0,0,0,,Saya tidak mengenalinya karena saya tidak mengenalnya
Dialog: 0,1:04:58.59,1:05:00.84,di belakang layar,,0,0,0,,Tanya pria itu tentang dia?
Dialog: 0,1:05:01.39,1:05:04.10,kenangan,,0,0,0,,Jika butuh bantuan, datanglah ke penginapan
Dialog: 0,1:05:05.22,1:05:06.77,teks umum,,0,0,0,,Penginapan...
Dialog: 0,1:05:13.36,1:05:17.15, kenangan miring,,0,0,0,, Segala sesuatu tentangmu keluar
Dialog: 0,1:05:36.17,1:05:38.55,teks umum,,0,0,0,,Pedagang Kim dari Desa Sari ada di sini?
Dialog: 0,1:05:38.63,1:05:40.47,teks umum,,0,0,0,,Ya, dia ada di sini
Dialog: 0,1:05:40.97,1:05:42.55,teks umum,,0,0,0,,Ruang terakhir di lantai dua
Dialog: 0,1:05:48.35,1:05:51.64,teks umum,,0,0,0,,Ajusshi, ini Moo Deok
Dialog: 0,1:06:18.38,1:06:19.38,di belakang layar,,0,0,0,,Ajusshi...
Dialog: 0,1:06:32.27,1:06:33.73,miring,,0,0,0,,Master Li
Dialog: 0,1:06:33.81,1:06:36.61,teks umum,,0,0,0,,Jika Anda adalah murid Master So Kyung,
Dialog: 0,1:06:36.69,1:06:38.73,teks umum,,0,0,0,,sekarang usiamu lebih dari seratus tahun
Dialog: 0,1:06:38.82,1:06:41.44,teks umum,,0,0,0,,Bagaimana kamu bisa bertahan seperti ini?
Dialogue: 0,1:06:42.03,1:06:45.16,teks umum,,0,0,0,,Berapa tahun yang mau kamu berikan padaku?
Dialog: 0,1:06:46.36,1:06:48.87,miring,,0,0,0,,Sedikit di atas tiga puluh
Dialog: 0,1:06:48.95,1:06:51.58,teks umum,,0,0,0,,Paling lama empat puluh tahun
Dialog: 0,1:06:52.41,1:06:56.08,teks umum,,0,0,0,,Kamu benar. Ini adalah usia biologis saya
Dialog: 0,1:06:57.00,1:06:57.96,teks umum,,0,0,0,,Apa?
Dialog: 0,1:06:58.04,1:07:00.84,teks umum,,0,0,0,,Jiwaku berumur seratus tahun
Dialog: 0,1:07:01.42,1:07:04.42,teks umum,,0,0,0,,Tubuh yang kubawa sejak lahir telah lama berubah menjadi debu
Dialog: 0,1:07:04.51,1:07:07.18,teks umum,,0,0,0,,Tubuh ini bukan milikku
Dialog: 0,1:07:09.39,1:07:10.26,miring,,0,0,0,,Tunggu
Dialog: 0,1:07:11.01,1:07:13.77,teks umum,,0,0,0,,Jadi kamu pengembara?
Dialog: 0,1:07:13.85,1:07:14.85,teks umum,,0,0,0,,Ya
Dialog: 0,1:07:15.89,1:07:18.27,teks umum,,0,0,0,,Saya pengembara
Dialog: 0,1:07:26.95,1:07:28.24,teks umum,,0,0,0,,Yang Mulia,
Dialog: 0,1:07:28.32,1:07:32.45,teks umum,,0,0,0,,Anda memanggil saya untuk mencari pengembara lain?
Dialog: 0,1:07:33.04,1:07:34.20,teks umum,,0,0,0,,Aku akan menemukannya
Dialog: 0,1:07:34.87,1:07:38.17,teks umum,,0,0,0,,Saya tahu siapa yang nomaden
Dialog: 0,1:07:49.51,1:07:53.56, sulih suara,,0,0,0,,Dia tahu sejak awal bahwa Moo Deok adalah seorang pengembara
Dialog: 0,1:08:18.71,1:08:19.58,teks umum,,0,0,0,,Itu kamu
Dialog: 0,1:08:20.79,1:08:22.38,teks umum,,0,0,0,,membunuhnya
Dialog: 0,1:09:04.92,1:09:06.55,pratinjau,,0,0,0,,Kenapa banyak sekali mayat disini?
Dialog: 0,1:09:06.63,1:09:09.05,pratinjau,,0,0,0,,Kehidupan seperti apa yang dijalani Moo Deok?
Dialog: 0,1:09:09.13,1:09:11.93,pratinjau,,0,0,0,,Moo Dok menyembunyikan sesuatu
Dialog: 0,1:09:12.01,1:09:14.80,pratinjau,,0,0,0,,- Apa yang tidak bisa diungkapkan\N- Ibu!
Dialog: 0,1:09:15.68,1:09:17.64,pratinjau,,0,0,0,,Dia malah mulai menggonggong
Dialog: 0,1:09:18.39,1:09:22.10,pratinjau,,0,0,0,,Sudah kuduga, ada lebih dari satu pengembara di istana
Dialog: 0,1:09:22.19,1:09:24.69,pratinjau,,0,0,0,,Jika ternyata bintang Raja itu adalah ciptaan ilmu hitam,
Dialog: 0,1:09:24.77,1:09:27.19,pratinjau,,0,0,0,,Hutan Pinus akan segera berakhir
Dialog: 0,1:09:27.73,1:09:28.57,pratinjau,,0,0,0,,Ini berbahaya
Dialog: 0,1:09:28.65,1:09:31.24,pratinjau,,0,0,0,,Kamu tidak kenal dia, tapi dia kenal Moo Deok
Dialog: 0,1:09:31.32,1:09:32.49,pratinjau,,0,0,0,,Kita membutuhkan Chang Gang
Dialog: 0,1:09:32.57,1:09:35.08,pratinjau,,0,0,0,,Kami tunggu kepulangannya
Dialog: 0,1:09:36.37,1:09:37.95,pratinjau,,0,0,0,,Moo Dok, kenapa kamu ada di sini?
Dialog: 0,1:09:38.04,1:09:40.25,pratinjau,,0,0,0,,Aku tidak bisa meninggalkan tuanku
Dialog: 0,1:09:40.33,1:09:43.50,pratinjau,,0,0,0,,Cintai aku sampai kamu mati
Dialog: 0,0:23:37.32,0:23:39.32,pratinjau,,0,0,0,,

