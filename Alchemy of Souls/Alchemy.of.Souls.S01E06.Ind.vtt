Dialog: 0,0:02:47.39,0:02:49.39,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.39,0:02:51.39,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:51.39,0:02:53.39,nicks,,0,0,0,,Penerjemah penata huruf: {\c&HFFF4C5&} Ria_Lee, Zero_Amamiya
Dialog: 0,0:01:04.34,0:01:06.39,kenangan,,0,0,0,,Yul dari keluarga So
Dialog: 0,0:01:08.10,0:01:09.68,kenangan,,0,0,0,,Jangan kembali ke sini
Dialog: 0,0:01:16.06,0:01:17.48,kenangan,,0,0,0,,Kamu akan datang lagi -
Dialog: 0,0:01:18.90,0:01:20.53,kenangan,,0,0,0,,Aku akan membunuhmu
Dialog: 0,0:01:25.99,0:01:26.82,kenangan,,0,0,0,,Tunggu...
Dialog: 0,0:01:52.85,0:01:55.69, sulih suara,,0,0,0,,Aku tidak bisa menghentikannya
Dialog: 0,0:01:57.10,0:01:58.94,di belakang layar,,0,0,0,,Aku tidak bertanya kenapa
Dialog: 0,0:02:00.19,0:02:03.44, sulih suara,,0,0,0,,Saat dia memotong ketulusanku menjadi beberapa bagian,
Dialog: 0,0:02:04.86,0:02:07.53,di belakang layar,,0,0,0,,Aku berhenti menghargai kenangan kita
Dialog: 0,0:02:08.82,0:02:11.45, sulih suara,,0,0,0,,Semuanya menjadi rahasia yang harus kusimpan di hatiku
Dialog: 0,0:02:17.79,0:02:21.21,teks umum,,0,0,0,,Kamu bangun pagi. Apa yang kamu lakukan di sini?
Dialog: 0,0:02:25.51,0:02:26.80,teks umum,,0,0,0,,Kenapa kamu
Dialog: 0,0:02:27.80,0:02:29.26,teks umum,,0,0,0,,datang ke sini?
Dialog: 0,0:02:32.01,0:02:34.35,teks umum,,0,0,0,,Tangkap burung. Aku akan menyiapkannya untukmu
Dialogue: 0,0:02:37.23,0:02:38.73,teks umum,,0,0,0,,Makanan tidak membuatku bahagia
Dialog: 0,0:02:38.81,0:02:40.77,teks umum,,0,0,0,,Saya akan memasak nasi dengan kastanye
Dialog: 0,0:02:41.90,0:02:44.15,teks umum,,0,0,0,,Kacang di sini manis sekali
Dialogue: 0,0:02:48.03,0:02:50.82,teks umum,,0,0,0,,Ada chestnut yang sangat manis di Danhyangk
Dialog: 0,0:03:04.00,0:03:05.46,teks umum,,0,0,0,,Dan aku juga tidak suka yang manis-manis
Dialog: 0,0:03:08.80,0:03:11.01,teks umum,,0,0,0,,Kamu bisa saja menolak
Dialog: 0,0:03:11.09,0:03:13.47,teks umum,,0,0,0,,Mengingat kekuatanmu, aku bisa saja mati
Dialog: 0,0:03:16.02,0:03:17.43,teks umum,,0,0,0,,Jangan berlebihan
Dialog: 0,0:03:18.39,0:03:21.73,teks umum,,0,0,0,,Aku mendorongmu, tapi aku tidak berniat membunuhmu
Dialog: 0,0:03:21.81,0:03:23.40,teks umum,,0,0,0,,Tapi mereka mendorong
Dialog: 0,0:03:24.02,0:03:25.94,teks umum,,0,0,0,,Tak perlu repot sarapan
Dialog: 0,0:03:26.03,0:03:27.49,teks umum,,0,0,0,,Aku akan pergi saat Dan Gu bangun
Dialog: 0,0:03:27.57,0:03:30.11,teks umum,,0,0,0,,Tidak mau, sesuai keinginan
Dialog: 0,0:03:46.76,0:03:48.13,teks umum,,0,0,0,,Kenapa kamu masih di sini?
Dialog: 0,0:03:50.01,0:03:51.26,teks umum,,0,0,0,,Aku akan makan sebelum berangkat
Dialog: 0,0:03:51.84,0:03:52.93,teks umum,,0,0,0,,Masak makanan
Dialog: 0,0:03:53.01,0:03:54.64,teks umum,,0,0,0,,Saya kira kamu tidak mau
Dialog: 0,0:03:55.22,0:03:57.52,teks umum,,0,0,0,,Saya tidak mengatakan itu. Jangan memfitnah
Dialog: 0,0:04:00.23,0:04:04.56,teks umum,,0,0,0,,Kamu minum terlalu banyak kemarin, kupikir kamu akan merasa tidak enak di pagi hari
Dialog: 0,0:04:04.65,0:04:07.19,teks umum,,0,0,0,,Saya menolak agar tidak mengganggu Anda
Dialog: 0,0:04:08.28,0:04:09.49,teks umum,,0,0,0,,Dimengerti
Dialog: 0,0:04:10.28,0:04:11.45,teks umum,,0,0,0,,Lalu
Dialog: 0,0:04:11.53,0:04:14.12,teks umum,,0,0,0,,- kita perlu mencuci beras lebih banyak\N- Di mana itu?
Dialogue: 0,0:04:14.78,0:04:17.49,teks umum,,0,0,0,,- Aku akan mencuci\N- Pernahkah kamu memasak nasi sebelumnya?
Dialog: 0,0:04:17.58,0:04:20.87,teks umum,,0,0,0,,Tidak, tapi aku bisa jika kamu mengajariku
Dialog: 0,0:04:22.00,0:04:23.42,teks umum,,0,0,0,,Sangat sederhana
Dialog: 0,0:04:24.08,0:04:27.55,teks umum,,0,0,0,,Basuh beras dengan air, tambahkan air secukupnya
Dialog: 0,0:04:27.63,0:04:29.09,teks umum,,0,0,0,,dan masak dengan api besar
Dialog: 0,0:04:29.92,0:04:32.09,teks umum,,0,0,0,,Lalu diamkan
Dialog: 0,0:04:33.43,0:04:35.14,teks umum,,0,0,0,,Cukup sederhana
Dialog: 0,0:04:43.85,0:04:46.31,teks umum,,0,0,0,,Kamu bilang bisa kalau aku jelaskan
Dialog: 0,0:04:46.40,0:04:48.11,teks umum,,0,0,0,,Mereka sendiri bilang itu mudah
Dialog: 0,0:04:49.65,0:04:52.74,teks umum,,0,0,0,,Saya salah. aku minta maaf
Dialog: 0,0:04:53.49,0:04:55.95,teks umum,,0,0,0,,Lihat ini
Dialogue: 0,0:04:56.03,0:04:57.62,teks umum,,0,0,0,,Dia terbakar habis
Dialog: 0,0:04:58.41,0:05:00.50,teks umum,,0,0,0,,Biarkan aku menebus kesalahannya
Dialog: 0,0:05:02.08,0:05:03.62,teks umum,,0,0,0,,Dan sayuran itu
Dialog: 0,0:05:03.71,0:05:05.13,teks umum,,0,0,0,,Ajarkan cara memotong sayuran
Dialog: 0,0:05:09.96,0:05:12.72,teks umum,,0,0,0,,- Buang saja sekarang\N- Wow
Dialog: 0,0:05:19.60,0:05:20.93,teks umum,,0,0,0,,Dan Gu
Dialog: 0,0:05:22.06,0:05:22.93,teks umum,,0,0,0,,Hei
Dialog: 0,0:05:23.52,0:05:25.19,teks umum,,0,0,0,,Berenang sebelum berangkat
Dialog: 0,0:05:25.27,0:05:27.15,teks umum,,0,0,0,,Air mineral akan membuat kulitmu lebih lembut
Dialog: 0,0:05:27.23,0:05:28.82,teks umum,,0,0,0,,Dan sarapan
Dialog: 0,0:05:28.90,0:05:30.23,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:05:30.32,0:05:32.44,teks umum,,0,0,0,,Moo Deok dan Yul menyiapkan sarapan bersama
Dialog: 0,0:05:33.36,0:05:34.74,teks umum,,0,0,0,,- Bersama?\N- Ya
Dialog: 0,0:05:34.82,0:05:37.12,teks umum,,0,0,0,,Yul memasak nasi dengan Moo Deok
Dialog: 0,0:05:49.54,0:05:53.17,teks umum,,0,0,0,,Sudah kubilang potong bawang bombay besar-besar
Dialog: 0,0:05:58.18,0:05:59.26,teks umum,,0,0,0,,- Apakah ini besar?\N- Tidak
Dialog: 0,0:05:59.93,0:06:02.47,teks umum,,0,0,0,,Kamu tidak tahu arti kata "besar"?
Dialog: 0,0:06:02.56,0:06:04.14,teks umum,,0,0,0,,Potongan besar
Dialog: 0,0:06:06.56,0:06:08.27,teks umum,,0,0,0,,Besar...
Dialog: 0,0:06:08.36,0:06:09.65,teks umum,,0,0,0,,Tidak sama
Dialog: 0,0:06:09.73,0:06:11.44,teks umum,,0,0,0,,Ini juga kecil
Dialog: 0,0:06:13.19,0:06:14.15,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:06:14.82,0:06:18.16,teks umum,,0,0,0,,Potongan besar. Seperti ini
Dialog: 0,0:06:19.32,0:06:22.29,teks umum,,0,0,0,,Seharusnya aku menjelaskannya dengan benar
Dialogue: 0,0:06:22.37,0:06:25.29,teks umum,,0,0,0,,Bagaimana aku bisa memahami “potongan besar”mu?
Dialog: 0,0:06:25.37,0:06:27.71,teks umum,,0,0,0,,Saya pikir Anda adalah pesulap terbaik Jeonjingak
Dialogue: 0,0:06:27.79,0:06:31.25,teks umum,,0,0,0,,Tidak bisa membedakan besar dan kecil?
Dialog: 0,0:06:32.46,0:06:33.38,miring,,0,0,0,,Lupakan
Dialog: 0,0:06:33.46,0:06:35.88,teks umum,,0,0,0,,Tuangkan air ke dalam mangkuk
Dialog: 0,0:06:43.72,0:06:44.68,teks umum,,0,0,0,,Tunggu...
Dialogue: 0,0:06:45.48,0:06:47.44,teks umum,,0,0,0,,Mangkuk apa yang kamu bicarakan?
Dialog: 0,0:06:49.48,0:06:50.48,teks umum,,0,0,0,,Yang ini?
Dialog: 0,0:06:54.03,0:06:55.07,teks umum,,0,0,0,,Atau ini?
Dialog: 0,0:06:55.82,0:06:56.70,teks umum,,0,0,0,,Ini?
Dialog: 0,0:06:59.45,0:07:00.74,teks umum,,0,0,0,,Di Sini
Dialogue: 0,0:07:06.91,0:07:09.83,teks umum,,0,0,0,,Kenapa sepertinya Moo Deok memarahinya?
Dialog: 0,0:07:10.63,0:07:12.09,teks umum,,0,0,0,,Apakah kamu yakin dia menyukainya?
Dialog: 0,0:07:12.17,0:07:13.63,teks umum,,0,0,0,,Inilah tipe cewek seperti ini
Dialog: 0,0:07:14.13,0:07:17.84,teks umum,,0,0,0,,Dia tidak menunjukkan kasih sayang atau rasa malu di depan orang lain
Dialog: 0,0:07:21.14,0:07:24.31,teks umum,,0,0,0,,Lihat saja Yulia
Dialog: 0,0:07:25.10,0:07:27.81,teks umum,,0,0,0,,Mereka memarahinya, tapi dia tetap belajar
Dialog: 0,0:07:30.60,0:07:32.31,teks umum,,0,0,0,,- Belajar?\N- Lihat
Dialogue: 0,0:07:33.02,0:07:34.82,teks umum,,0,0,0,,saya bilang cukup
Dialog: 0,0:07:36.19,0:07:37.65,teks umum,,0,0,0,,Aku tidak suka makanan asin
Dialog: 0,0:07:41.28,0:07:42.66,miring,,0,0,0,,Dia tidak pernah seperti itu
Dialog: 0,0:07:42.74,0:07:45.66,teks umum,,0,0,0,,- Cobalah sendiri\N- {\i1}Bahkan di depan Tuan Ho atau pamanku
Dialog: 0,0:07:45.74,0:07:46.95,teks umum,,0,0,0,,Lucu
Dialog: 0,0:07:47.54,0:07:50.46,miring,,0,0,0,,Dia seperti murid yang ketakutan, bukan?
Dialogue: 0,0:07:50.54,0:07:51.92,italic,,0,0,0,,Hambar ya?
Dialog: 0,0:07:52.00,0:07:55.75,teks umum,,0,0,0,,Di Sini. Seharusnya aku berhenti ketika aku berkata
Dialog: 0,0:07:55.84,0:07:59.26,teks umum,,0,0,0,,- maaf\N- {\i1}Guru terkasih dan muridnya yang patuh
Dialog: 0,0:08:00.38,0:08:02.68,teks umum,,0,0,0,,Keluar. Harus menyelesaikan memasak
Dialog: 0,0:08:02.76,0:08:04.89,teks umum,,0,0,0,,- Guru dan murid?\N{\i1}- Duduk
Dialog: 0,0:08:04.97,0:08:07.27,teks umum,,0,0,0,,Kenapa kamu begitu keras kepala,
Dialog: 0,0:08:07.35,0:08:09.48,teks umum,,0,0,0,,jika kamu memasak untuk pertama kalinya?
Dialog: 0,0:08:16.65,0:08:17.61,teks umum,,0,0,0,,Oke
Dialog: 0,0:08:17.69,0:08:21.32,teks umum,,0,0,0,,Mari kita lihat bagaimana kamu mengajarinya, dan bagaimana kamu belajar
Dialog: 0,0:08:21.86,0:08:23.41,teks umum,,0,0,0,,Ayo coba
Dialog: 0,0:08:28.79,0:08:30.08,teks umum,,0,0,0,,Enak
Dialog: 0,0:08:30.16,0:08:31.46,teks umum,,0,0,0,,Enak?
Dialog: 0,0:08:33.88,0:08:36.09,teks umum,,0,0,0,,Aku melakukan segalanya seperti yang dikatakan Moo Deok
Dialog: 0,0:08:39.13,0:08:40.26,teks umum,,0,0,0,,Bagus sekali
Dialog: 0,0:08:41.34,0:08:44.14,teks umum,,0,0,0,,Senang, menurutku, setelah pujian guru
Dialog: 0,0:08:44.72,0:08:48.01,teks umum,,0,0,0,,Kupikir aku pandai dalam segala hal karena orang menyebutku jenius
Dialog: 0,0:08:48.81,0:08:50.98,teks umum,,0,0,0,,Tapi ternyata ada yang tidak bisa kulakukan
Dialog: 0,0:08:51.06,0:08:52.02,teks umum,,0,0,0,,Mu Dok,
Dialog: 0,0:08:52.10,0:08:53.73,teks umum,,0,0,0,,terima kasih telah membantuku mewujudkan hal ini
Dialog: 0,0:08:53.81,0:08:57.98,teks umum,,0,0,0,,Itu tidak mudah karena dia tidak mengerti apa yang saya katakan
Dialog: 0,0:08:58.07,0:09:00.74,teks umum,,0,0,0,,Tapi dia masih terus mencoba
Dialog: 0,0:09:01.40,0:09:03.07,teks umum,,0,0,0,,Jadi saya terus mengajarinya
Dialog: 0,0:09:04.61,0:09:05.99,teks umum,,0,0,0,,Melebih-lebihkan
Dialog: 0,0:09:06.62,0:09:08.91,teks umum,,0,0,0,,Seolah-olah meja kerajaan telah ditata di sini
Dialog: 0,0:09:08.99,0:09:11.79,teks umum,,0,0,0,,Kamu bisa belajar banyak sambil memasak
Dialog: 0,0:09:11.87,0:09:13.46,teks umum,,0,0,0,,- Kamu juga harus belajar\N- Sayangnya,
Dialog: 0,0:09:13.54,0:09:16.25,teks umum,,0,0,0,,Saya tidak punya guru seperti dia
Dialog: 0,0:09:18.17,0:09:20.17,teks umum,,0,0,0,,Maaf, tapi nasinya sedikit gosong
Dialog: 0,0:09:20.26,0:09:22.92,teks umum,,0,0,0,,- Ya\N{\i1}- Anda dapat mencoba lagi
Dialog: 0,0:09:23.01,0:09:26.47,teks umum,,0,0,0,,Moo Dok, menurutmu dia akan melakukannya lebih baik lain kali?
Dialog: 0,0:09:26.55,0:09:29.10,teks umum,,0,0,0,,Dia tidak sepenuhnya putus asa
Dialog: 0,0:09:29.18,0:09:30.85,miring,,0,0,0,,Terima kasih atas kata-katanya
Dialog: 0,0:09:45.82,0:09:47.24,teks umum,,0,0,0,,Kenapa kamu mencucinya sendiri?
Dialog: 0,0:09:47.32,0:09:49.45,teks umum,,0,0,0,,Minta bantuan muridmu yang luar biasa
Dialog: 0,0:09:49.53,0:09:53.25,teks umum,,0,0,0,,Dia memasak makanan, jadi aku akan membereskan semuanya
Dialog: 0,0:09:54.62,0:09:56.17,teks umum,,0,0,0,,Apakah menyenangkan mengajarinya?
Dialog: 0,0:09:56.83,0:09:58.04,teks umum,,0,0,0,,Apakah kamu menginginkan dia
Dialog: 0,0:09:58.71,0:09:59.79,teks umum,,0,0,0,,adalah muridmu?
Dialog: 0,0:09:59.88,0:10:01.88,teks umum,,0,0,0,,Akan lebih mudah jika seperti ini
Dialogue: 0,0:10:02.46,0:10:04.55,teks umum,,0,0,0,,Dia rajin, penurut
Dialog: 0,0:10:05.34,0:10:07.51,teks umum,,0,0,0,,Tidak malas dan sembrono sepertimu
Dialog: 0,0:10:07.59,0:10:10.10,teks umum,,0,0,0,,Guru, jangan curang padaku
Dialog: 0,0:10:11.68,0:10:12.52,teks umum,,0,0,0,,Apa?
Dialog: 0,0:10:12.60,0:10:14.89,teks umum,,0,0,0,,Saya mengerti bahwa Anda menyukai ketekunan dan ketekunannya
Dialog: 0,0:10:14.98,0:10:17.31,teks umum,,0,0,0,,Tapi aku satu-satunya muridmu
Dialog: 0,0:10:17.40,0:10:20.86,teks umum,,0,0,0,,Seorang guru tidak boleh memiliki beberapa siswa dan sebaliknya
Dialog: 0,0:10:20.94,0:10:24.15,teks umum,,0,0,0,,Kesal karena mengajari Yulia memasak?
Dialog: 0,0:10:24.24,0:10:26.15,teks umum,,0,0,0,,Ya. Tepat. Bagaimana Anda bisa mengajar orang lain
Dialog: 0,0:10:26.24,0:10:28.28,teks umum,,0,0,0,,ketika muridmu berada tepat di depanmu?
Dialog: 0,0:10:28.87,0:10:31.03,miring,,0,0,0,,Apakah kamu ingin mengajari seseorang cara memasak? Biarkan itu menjadi aku
Dialog: 0,0:10:31.12,0:10:32.74,teks umum,,0,0,0,,Mengajari orang lain adalah pengkhianatan dan pengkhianatan
Dialog: 0,0:10:33.87,0:10:36.54,teks umum,,0,0,0,,Saya mengerti bagian tentang pengkhianatan
Dialog: 0,0:10:36.62,0:10:37.83,teks umum,,0,0,0,,Tapi pengkhianatan?
Dialog: 0,0:10:37.92,0:10:39.38,teks umum,,0,0,0,,Tanpa kata
Dialog: 0,0:10:42.42,0:10:43.55,teks umum,,0,0,0,,Saya yakin,
Dialog: 0,0:10:44.51,0:10:46.47,teks umum,,0,0,0,,bahwa aku merasa dikhianati
Dialog: 0,0:10:53.81,0:10:55.02,teks umum,,0,0,0,,Apa lagi ini?
Dialog: 0,0:10:56.06,0:10:56.98,teks umum,,0,0,0,,Nah, apa lagi?
Dialogue: 0,0:10:57.06,0:10:58.81,teks umum,,0,0,0,,Moo Dok, jangan curang padaku
Dialog: 0,0:10:58.90,0:11:00.31,teks umum,,0,0,0,,Ini menyakitkan dan membuatku marah
Dialog: 0,0:11:00.40,0:11:03.19,teks umum,,0,0,0,,Saya tidak tahu murid saya begitu terobsesi
Dialog: 0,0:11:03.90,0:11:05.78,teks umum,,0,0,0,,Oke, kamu akan menjadi satu-satunya
Dialog: 0,0:11:05.86,0:11:08.95,teks umum,,0,0,0,,seorang siswa yang mengatakan omong kosong di pagi hari. Apakah kamu puas?
Dialog: 0,0:11:09.03,0:11:10.66,teks umum,,0,0,0,,- Tapi...\N{\i1}- Mu Dok!
Dialog: 0,0:11:11.70,0:11:12.66,miring,,0,0,0,,Moo Dok!
Dialog: 0,0:11:14.29,0:11:15.16,teks umum,,0,0,0,,Host,
Dialog: 0,0:11:15.91,0:11:19.58,teks umum,,0,0,0,,pengkhianatan jika aku menyebut orang lain tuan
Dialog: 0,0:11:20.21,0:11:21.54,teks umum,,0,0,0,,dan jawab panggilan mereka?
Dialog: 0,0:11:21.63,0:11:23.38,teks umum,,0,0,0,,Tidak ada yang bisa dilakukan di sini, tentu saja
Dialog: 0,0:11:23.46,0:11:25.96,teks umum,,0,0,0,,Tapi saat kau menelepon mereka,
Dialog: 0,0:11:26.05,0:11:28.47,teks umum,,0,0,0,,panggil aku master
Dialog: 0,0:11:30.26,0:11:31.59,teks umum,,0,0,0,,Tawa dan tidak lebih
Dialog: 0,0:11:33.97,0:11:37.60,teks umum,,0,0,0,,Tuan Pak, saya datang!
Dialog: 0,0:11:37.68,0:11:40.73,teks umum,,0,0,0,,Moo Dok, kamu menyakiti perasaanku. Sudah kubilang panggil aku tuan!
Dialog: 0,0:11:49.40,0:11:51.16,teks umum,,0,0,0,,Sangat tinggi
Dialog: 0,0:11:53.16,0:11:55.62,teks umum,,0,0,0,,Yul, apakah kamu ingin melihat pohon ini?
Dialog: 0,0:11:56.95,0:11:58.20,teks umum,,0,0,0,,Semacam
Dialog: 0,0:11:59.62,0:12:01.67,teks umum,,0,0,0,,Aku tidak percaya itu ada
Dialog: 0,0:12:09.76,0:12:12.76,kenangan,,0,0,0,,Bagaimana kamu tahu kalau aku terluka?
Dialog: 0,0:12:13.47,0:12:16.26,kenangan,,0,0,0,,Ada pohon tinggi di dekat sini,
Dialog: 0,0:12:18.02,0:12:21.39,kenangan,,0,0,0,,semua Danhyangok terlihat dari atas
Dialogue: 0,0:12:26.86,0:12:29.78,teks umum,,0,0,0,,Danhyangok terlihat keseluruhan dari atas
Dialog: 0,0:12:33.32,0:12:35.24,teks umum,,0,0,0,,Jadi kamu naik
Dialog: 0,0:12:36.41,0:12:37.66,teks umum,,0,0,0,,ke paling atas?
Dialog: 0,0:12:41.66,0:12:44.63,teks umum,,0,0,0,,Saya kira begitu, karena tinggi
Dialog: 0,0:12:46.50,0:12:48.67,teks umum,,0,0,0,,Mau naik?
Dialog: 0,0:12:48.76,0:12:50.42,teks umum,,0,0,0,,Bantu kamu mendaki?
Dialog: 0,0:12:51.09,0:12:53.72,teks umum,,0,0,0,,Dan Gu, kamu tidak bisa memanjatnya
Dialog: 0,0:12:53.80,0:12:57.14,teks umum,,0,0,0,,Kamu setidaknya harus menguasai Chisa untuk bisa naik ke sana
Dialog: 0,0:12:58.39,0:12:59.39,teks umum,,0,0,0,,Ya?
Dialog: 0,0:13:00.02,0:13:01.52,teks umum,,0,0,0,,Mungkin sebaiknya saya coba?
Dialog: 0,0:13:02.10,0:13:03.10,miring,,0,0,0,,Tepat sekali
Dialogue: 0,0:13:03.19,0:13:05.10,teks umum,,0,0,0,,Mungkin kamu bisa melakukannya
Dialog: 0,0:13:05.69,0:13:06.98,teks umum,,0,0,0,,Moo Dok, ayo pergi bersamanya
Dialog: 0,0:13:10.69,0:13:11.78,teks umum,,0,0,0,,Mau mendaki?
Dialog: 0,0:13:17.08,0:13:18.37,teks umum,,0,0,0,,Saya tidak mau
Dialog: 0,0:13:18.45,0:13:21.58,teks umum,,0,0,0,,Aku tidak ingin memanjat pohon ini dengan sembarang orang
Dialog: 0,0:13:26.50,0:13:27.34,teks umum,,0,0,0,,"Dengan siapa saja"?
Dialog: 0,0:13:30.51,0:13:33.72,teks umum,,0,0,0,,Menurutku dia terlalu takut
Dialog: 0,0:13:33.80,0:13:35.13,teks umum,,0,0,0,,Ayo pergi
Dialog: 0,0:13:46.52,0:13:48.52,teks umum,,0,0,0,,Saya mempelajari inti energinya
Dialog: 0,0:13:49.77,0:13:52.57,teks umum,,0,0,0,,Dia adalah orang biasa, bukan penyihir
Dialog: 0,0:13:53.57,0:13:56.74,teks umum,,0,0,0,,Saya yakin masih banyak lagi korbannya
Dialog: 0,0:13:56.82,0:14:00.20,teks umum,,0,0,0,,Ada pengembara di antara kita
Dialog: 0,0:14:00.79,0:14:02.70,teks umum,,0,0,0,,Apa yang harus dilakukan, Guru Li?
Dialog: 0,0:14:02.79,0:14:05.62,teks umum,,0,0,0,,Lebih sulit mengenali asal muasal sihir ini,
Dialog: 0,0:14:05.71,0:14:07.21,teks umum,,0,0,0,,cara menangkap pengembara
Dialog: 0,0:14:08.04,0:14:09.59,teks umum,,0,0,0,,Saya curiga Jeonbugwan
Dialog: 0,0:14:11.42,0:14:14.42,teks umum,,0,0,0,,Pengembara yang menyerbu Sosnovy Bor,
Dialog: 0,0:14:15.34,0:14:17.30,teks umum,,0,0,0,,ada astrolog disana
Dialog: 0,0:14:18.26,0:14:21.06,teks umum,,0,0,0,,Selain itu, itu adalah Jin Mu
Dialog: 0,0:14:21.14,0:14:23.02,teks umum,,0,0,0,,menghancurkan Nak Su selama pemindahan jiwa,
Dialog: 0,0:14:23.81,0:14:25.73,teks umum,,0,0,0,,dan kemudian semua orangnya
Dialog: 0,0:14:27.19,0:14:28.90,teks umum,,0,0,0,,Nak Su...
Dialog: 0,0:14:35.86,0:14:38.62,teks umum,,0,0,0,,Kami menemukan siapa dia
Dialog: 0,0:14:38.70,0:14:39.82,teks umum,,0,0,0,,Dan siapa?
Dialog: 0,0:14:39.91,0:14:42.29,teks umum,,0,0,0,,Salah satu pelayan Jeonbugwan
Dialog: 0,0:14:42.37,0:14:45.83,teks umum,,0,0,0,,Apa? Jeonbugwan terlibat lagi
Dialog: 0,0:14:45.91,0:14:48.58,teks umum,,0,0,0,,Aku akan segera menemui Jin Mu!
Dialog: 0,0:14:48.67,0:14:50.25,teks umum,,0,0,0,,Semua orang di belakangku
Dialog: 0,0:14:50.34,0:14:51.54,teks umum,,0,0,0,,Yom
Dialog: 0,0:14:52.21,0:14:53.17,teks umum,,0,0,0,,Ya?
Dialog: 0,0:14:53.84,0:14:54.96,teks umum,,0,0,0,,Tidak melakukan apa pun
Dialog: 0,0:14:56.84,0:14:59.97,teks umum,,0,0,0,,Pada suatu waktu, kecerobohanmu sangat merusak
Dialog: 0,0:15:00.05,0:15:02.14,teks umum,,0,0,0,,Sekarang kamu sudah dewasa, tapi karaktermu masih sama
Dialog: 0,0:15:03.06,0:15:04.72,teks umum,,0,0,0,,Maaf guru
Dialog: 0,0:15:05.31,0:15:06.43,teks umum,,0,0,0,,Ini belum waktunya
Dialog: 0,0:15:06.52,0:15:10.48,teks umum,,0,0,0,,Kita harus terus mengawasi Jeonbugwan
Dialog: 0,0:15:10.56,0:15:11.86,teks umum,,0,0,0,,Jin
Dialog: 0,0:15:12.86,0:15:14.40,teks umum,,0,0,0,,Kamu tumbuh dengan cerdas
Dialogue: 0,0:15:15.69,0:15:17.82,teks umum,,0,0,0,,Kamu berlarian dengan celana dalammu
Dialog: 0,0:15:17.90,0:15:21.16,teks umum,,0,0,0,,Aku tidak percaya kamu tumbuh seperti itu dan memimpin orang
Dialog: 0,0:15:25.95,0:15:27.04,teks umum,,0,0,0,,Guru
Dialog: 0,0:15:33.29,0:15:34.92,teks umum,,0,0,0,,Siapa dia?
Dialog: 0,0:15:36.38,0:15:37.59,teks umum,,0,0,0,,Dia adalah seorang pelajar
Dialog: 0,0:15:38.13,0:15:41.55,teks umum,,0,0,0,,Master So Kyung, pendiri Sosnovy Bor
Dialog: 0,0:15:42.60,0:15:44.06,teks umum,,0,0,0,,Tapi dia masih sangat muda
Dialog: 0,0:15:45.18,0:15:46.52,teks umum,,0,0,0,,Tidak sama sekali
Dialog: 0,0:15:47.39,0:15:49.10,teks umum,,0,0,0,,Saya masih ingat bernyanyi
Dialog: 0,0:15:51.35,0:15:53.19,teks umum,,0,0,0,,pada perayaan seratus tahunnya
Dialog: 0,0:15:56.86,0:15:58.32,teks umum,,0,0,0,,Aku bahkan menari
Dialog: 0,0:16:02.07,0:16:04.95,teks umum,,0,0,0,,Anjing ini... apakah itu Gwigu?
Dialog: 0,0:16:07.16,0:16:11.62,teks umum,,0,0,0,,Jadi kamu mengambil Gwiga dari Jinyeowon
Dialog: 0,0:16:12.63,0:16:14.96,teks umum,,0,0,0,,Dia akan menemukan pengembara
Dialog: 0,0:16:15.75,0:16:18.21,teks umum,,0,0,0,,Nak Su meninggal saat pemindahan jiwa, kan?
Dialog: 0,0:16:18.30,0:16:19.13,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:19.22,0:16:22.68,teks umum,,0,0,0,,Dia adalah tentara bayaran terkenal dan penyihir berbakat
Dialogue: 0,0:16:25.05,0:16:27.60,teks umum,,0,0,0,,Bukankah jiwanya yang aku rasakan?
Dialog: 0,0:16:39.99,0:16:42.45,teks umum,,0,0,0,,Pedang Chang Gan sekarang
Dialog: 0,0:16:42.53,0:16:44.70,teks umum,,0,0,0,,- anaknya kan?\N- Ya
Dialog: 0,0:16:44.78,0:16:48.62,teks umum,,0,0,0,,Apakah kamu pernah bertemu dengannya?
Dialog: 0,0:16:48.70,0:16:50.58,teks umum,,0,0,0,,Saya melihat seorang pemuda dengan gelang
Dialog: 0,0:16:50.66,0:16:53.83,teks umum,,0,0,0,,dan pelayan yang mengikutinya
Dialog: 0,0:16:55.59,0:16:56.88,teks umum,,0,0,0,,Menarik
Dialog: 0,0:17:03.97,0:17:06.51,teks umum,,0,0,0,,Moo Dok mengumpulkan beberapa buah kastanye
Dialog: 0,0:17:06.60,0:17:09.22,teks umum,,0,0,0,,Manis sekali ya. Beri Kim pelayan itu juga
Dialog: 0,0:17:09.31,0:17:10.18,teks umum,,0,0,0,,Tentu saja
Dialogue: 0,0:17:19.19,0:17:20.74,teks umum,,0,0,0,,Kenapa kamu mengambil pedang ayahmu?
Dialog: 0,0:17:21.36,0:17:23.61,teks umum,,0,0,0,,Oh, ini? Moo Deok mengambilnya
Dialog: 0,0:17:23.70,0:17:26.78,teks umum,,0,0,0,,Kamu tidak akan berlatih, kenapa kamu membawanya ke sini?
Dialog: 0,0:17:27.53,0:17:28.91,teks umum,,0,0,0,,Bawa ke pelayan Kim?
Dialog: 0,0:17:30.83,0:17:31.70,kenangan miring,,0,0,0,,Kamu...
Dialog: 0,0:17:32.75,0:17:34.04,kenangan,,0,0,0,,bukan anak laki-laki
Dialog: 0,0:17:35.33,0:17:36.54,kenangan,,0,0,0,,Chan Gan
Dialog: 0,0:17:40.05,0:17:41.17,teks umum,,0,0,0,,Terserah Anda
Dialog: 0,0:17:45.38,0:17:46.55,teks umum,,0,0,0,,- Ayo\N- Ya
Dialog: 0,0:17:49.26,0:17:51.89,teks umum,,0,0,0,,Kamu bilang sering mengumpulkan tanaman herbal di sini
Dialogue: 0,0:17:53.23,0:17:57.10,teks umum,,0,0,0,,Apakah kamu melihat seseorang yang tinggal di sini?
Dialog: 0,0:17:57.19,0:18:00.19,teks umum,,0,0,0,,No. Siapa yang akan tinggal di sini?
Dialog: 0,0:18:01.57,0:18:02.82,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:18:07.53,0:18:08.74,teks umum,,0,0,0,,Dan banyak lagi
Dialog: 0,0:18:10.79,0:18:12.91,teks umum,,0,0,0,,Apakah sangat dingin di musim dingin?
Dialog: 0,0:18:14.37,0:18:15.79,teks umum,,0,0,0,,Apa?
Dialog: 0,0:18:17.92,0:18:19.67,teks umum,,0,0,0,,Saya belum pernah ke sini saat musim dingin
Dialog: 0,0:18:22.67,0:18:24.67,teks umum,,0,0,0,,Khawatir setiap kali salju turun
Dialog: 0,0:18:26.47,0:18:28.26,teks umum,,0,0,0,,Khawatir apakah cuaca terlalu dingin
Dialog: 0,0:18:29.85,0:18:32.10,teks umum,,0,0,0,,Apakah semuanya baik-baik saja
Dialog: 0,0:18:42.40,0:18:44.11,teks umum,,0,0,0,,Di sini semakin hangat,
Dialog: 0,0:18:45.19,0:18:47.20,teks umum,,0,0,0,,daripada yang terlihat
Dialog: 0,0:18:50.28,0:18:53.29,teks umum,,0,0,0,,Salju mencair dengan cepat di tempat yang cerah
Dialog: 0,0:18:56.21,0:18:58.17,teks umum,,0,0,0,,Ya? saya senang
Dialog: 0,0:19:04.30,0:19:06.72,teks umum,,0,0,0,,Ya, ada banyak makanan di sini bahkan di musim dingin
Dialog: 0,0:19:07.68,0:19:10.34,teks umum,,0,0,0,,Ada tempat untuk bersembunyi dari salju
Dialog: 0,0:19:13.22,0:19:15.60,teks umum,,0,0,0,,- Saya yakin ini enak\N- Sangat
Dialogue: 0,0:19:18.56,0:19:19.98,teks umum,,0,0,0,,Haruskah kita menginap satu hari lagi?
Dialog: 0,0:19:21.40,0:19:23.90,miring,,0,0,0,,Rupanya Moo Deok sangat menyukainya
Dialog: 0,0:19:28.45,0:19:30.20,teks umum,,0,0,0,,Dia memberitahunya
Dialog: 0,0:19:31.32,0:19:32.66,teks umum,,0,0,0,,tidak menyukainya
Dialog: 0,0:19:32.74,0:19:35.24,teks umum,,0,0,0,,Saya bilang kamu menyukainya!
Dialog: 0,0:19:35.95,0:19:36.87,teks umum,,0,0,0,,Lihat
Dialog: 0,0:19:36.95,0:19:41.04,teks umum,,0,0,0,,Dia tidak memandang kita seperti dia memandangnya
Dialog: 0,0:19:49.51,0:19:51.18,teks umum,,0,0,0,,Angin bertiup
Dialog: 0,0:19:59.85,0:20:01.56,teks umum,,0,0,0,,Apakah itu datang dari dia?
Dialog: 0,0:20:05.32,0:20:06.28,teks umum,,0,0,0,,Dan Gu, ayo berangkat
Dialog: 0,0:20:06.90,0:20:07.99,teks umum,,0,0,0,,Ya
Dialog: 0,0:20:12.28,0:20:14.03,miring,,0,0,0,,Sampai jumpa, Moo Deok
Dialog: 0,0:20:19.50,0:20:20.54,miring,,0,0,0,,Ayo pergi
Dialog: 0,0:20:27.92,0:20:29.47,teks umum,,0,0,0,,aku akan memamerkannya
Dialog: 0,0:20:42.23,0:20:44.40,teks umum,,0,0,0,,- Semoga perjalananmu menyenangkan\N- Sampai jumpa lagi
Dialog: 0,0:20:45.31,0:20:47.53,teks umum,,0,0,0,,Coba ingat di mana kamu kehilangan jimat roh
Dialog: 0,0:20:48.11,0:20:50.19,teks umum,,0,0,0,,- Oke\N- Dan tundukkan kepalamu
Dialog: 0,0:20:50.70,0:20:52.86,teks umum,,0,0,0,,Karena kamu, bahkan Dewan Terpadu pun dibentuk
Dialog: 0,0:20:52.95,0:20:55.87,teks umum,,0,0,0,,Saya pikir ke-12 mantan guru saya ada di sana
Dialog: 0,0:20:55.95,0:20:58.79,teks umum,,0,0,0,,Mereka semua sangat tidak berperasaan terhadapmu
Dialog: 0,0:20:59.45,0:21:02.33,teks umum,,0,0,0,,Mereka bahkan menawarkan untuk menyegel seluruh energimu
Dialog: 0,0:21:03.08,0:21:05.33,teks umum,,0,0,0,,- Mengapa mereka mengatakan itu?\N- Apa?
Dialog: 0,0:21:07.84,0:21:09.59,teks umum,,0,0,0,,Karena kamu lari dari pertarungan
Dialog: 0,0:21:11.26,0:21:13.05,miring,,0,0,0,,Tapi ini bodoh sekali
Dialog: 0,0:21:13.13,0:21:14.97,teks umum,,0,0,0,,Kamu juga tidak menginginkan hal itu terjadi
Dialog: 0,0:21:15.05,0:21:17.26,miring,,0,0,0,,Tidak ada yang mengharapkanmu muncul
Dialog: 0,0:21:17.35,0:21:21.02,teks umum,,0,0,0,,Jadi diam saja di sini dan hidup dengan tenang
Dialog: 0,0:21:23.39,0:21:25.10,miring,,0,0,0,,Kepala ingin mengetahui sesuatu
Dialog: 0,0:21:26.65,0:21:28.73,teks umum,,0,0,0,,Dia bertanya apakah kamu melakukan apa yang diperintahkan
Dialog: 0,0:21:30.99,0:21:31.99,kenangan miring,,0,0,0,,Kamu
Dialog: 0,0:21:32.49,0:21:35.53,kenangan,,0,0,0,,buah pengkhianatan ibumu
Dialog: 0,0:21:35.61,0:21:38.16,kenangan,,0,0,0,,Tapi kami tidak bisa membiarkanmu menjadi kepala Jeonbugwan
Dialogue: 0,0:21:38.24,0:21:41.41,kenangan,,0,0,0,,Jadi berhentilah bermimpi mengikuti jejak
Dialog: 0,0:21:44.54,0:21:45.75,kenangan,,0,0,0,,tentang ayahnya
Dialog: 0,0:21:46.33,0:21:48.38,kenangan,,0,0,0,,Tetap menjadi pewaris yang tidak tahu apa-apa
Dialog: 0,0:21:49.75,0:21:52.47,kenangan,,0,0,0,,keluarga Chan
Dialog: 0,0:21:55.84,0:21:58.18,teks umum,,0,0,0,,Bisakah saya memberinya jawaban positif?
Dialogue: 0,0:21:58.26,0:22:00.18,teks umum,,0,0,0,,Apakah saya pernah taat?
Dialog: 0,0:22:00.81,0:22:03.68,teks umum,,0,0,0,,Katakan padanya aku melakukan yang sebaliknya, ceroboh
Dialog: 0,0:22:06.94,0:22:08.11,teks umum,,0,0,0,,Dan Gu, tinggalkan pedangnya di sini
Dialog: 0,0:22:09.11,0:22:10.02,teks umum,,0,0,0,,Mengapa?
Dialog: 0,0:22:10.90,0:22:13.19,teks umum,,0,0,0,,Saya ingin membantu Mu Deok menangkap burung pegar
Dialog: 0,0:22:17.62,0:22:18.82,teks umum,,0,0,0,,Sampai jumpa
Dialogue: 0,0:22:24.29,0:22:26.87,teks umum,,0,0,0,,Apakah kita melukai harga dirinya?
Dialog: 0,0:22:26.96,0:22:27.83,miring,,0,0,0,,Tinggalkan dia
Dialog: 0,0:22:27.92,0:22:30.42,teks umum,,0,0,0,,Kita tidak bisa memintanya kembali dan mati dengan bermartabat di sana
Dialogue: 0,0:22:38.39,0:22:40.72,teks umum,,0,0,0,,Apakah kamu kembali dengan pedang yang kamu berikan?
Dialog: 0,0:22:43.27,0:22:45.27,teks umum,,0,0,0,,Aku telah menjadi bahan tertawaan dan melukai harga diriku
Dialog: 0,0:22:47.39,0:22:50.15,teks umum,,0,0,0,,Kalau begitu, mari kita berlatih seolah-olah hidup kita bergantung padanya
Dialog: 0,0:22:51.48,0:22:52.61,teks umum,,0,0,0,,Sepertinya anda terhibur dengan,
Dialog: 0,0:22:54.32,0:22:56.11,teks umum,,0,0,0,,bahwa muridmu telah menjadi bahan tertawaan
Dialog: 0,0:22:56.90,0:22:59.32,teks umum,,0,0,0,,Selain itu, saya akan menambahkan
Dialog: 0,0:23:00.57,0:23:03.87,teks umum,,0,0,0,,Temanmu tidak mengajakmu pulang bersama mereka
Dialog: 0,0:23:03.95,0:23:06.71,teks umum,,0,0,0,,Jika mereka jadi kamu, mereka akan bertarung sampai mati
Dialog: 0,0:23:06.79,0:23:09.71,teks umum,,0,0,0,,Dan kamu disuruh lari dan bersembunyi
Dialog: 0,0:23:10.79,0:23:11.92,teks umum,,0,0,0,,Tahukah kamu alasannya?
Dialog: 0,0:23:14.38,0:23:16.97,teks umum,,0,0,0,,Karena kamu tidak berguna
Dialog: 0,0:23:18.88,0:23:20.85,teks umum,,0,0,0,,Lidahmu lebih tajam dari pedang
Dialog: 0,0:23:21.72,0:23:24.72,teks umum,,0,0,0,,Jadi kata-katanya menyakitkan. Tanpa ampun
Dialog: 0,0:23:24.81,0:23:27.06,teks umum,,0,0,0,,Aku tidak akan segan-segan menikammu dengan pedang,
Dialog: 0,0:23:27.14,0:23:29.14,teks umum,,0,0,0,,jika itu bisa membuatmu kembali ke jalur yang benar
Dialog: 0,0:23:29.23,0:23:30.27,teks umum,,0,0,0,,Ya, master
Dialog: 0,0:23:30.35,0:23:32.61,teks umum,,0,0,0,,Kalahkan murid tak bergunamu sampai mati
Dialogue: 0,0:23:35.32,0:23:37.36,teks umum,,0,0,0,,Kenapa kamu tidak bersemangat setelah kata-kataku?
Dialog: 0,0:23:37.44,0:23:38.74,teks umum,,0,0,0,,Kenapa rusak sekali?
Dialog: 0,0:23:41.24,0:23:43.45,teks umum,,0,0,0,,Kata-kata jahatmu membuatku kesal pada akhirnya
Dialog: 0,0:23:44.20,0:23:45.66,teks umum,,0,0,0,,Saya perlu mandi dan bersantai
Dialogue: 0,0:23:47.45,0:23:49.42,teks umum,,0,0,0,,Kenapa dia sering mandi?
Dialog: 0,0:23:49.50,0:23:51.00,teks umum,,0,0,0,,Idiot yang tidak berharga dan malas
Dialog: 0,0:23:51.08,0:23:52.42,teks umum,,0,0,0,,Saya harap Anda merebusnya dalam air mendidih!
Dialog: 0,0:23:53.79,0:23:57.26,teks umum,,0,0,0,,Luar biasa! Guru macam apa yang berkata seperti itu kepada muridnya?
Dialog: 0,0:24:02.47,0:24:06.64,teks umum,,0,0,0,,Uk ingat bagaimana dia kehilangan jimat rohnya?
Dialog: 0,0:24:07.60,0:24:09.73,teks umum,,0,0,0,,Mungkin seseorang menjualnya setelah Inggris menjatuhkannya
Dialog: 0,0:24:09.81,0:24:12.06,teks umum,,0,0,0,,Jadi jimat itu sampai ke tangan mereka
Dialog: 0,0:24:12.15,0:24:14.11,teks umum,,0,0,0,,Kudengar ada tempat yang menjual jimat seperti itu
Dialog: 0,0:24:15.32,0:24:18.11,teks umum,,0,0,0,,Kalau begitu, coba cari tahu semuanya
Dialog: 0,0:24:19.28,0:24:20.57,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:24:20.65,0:24:21.91,teks umum,,0,0,0,,Bagaimana...
Dialog: 0,0:24:24.03,0:24:26.33,teks umum,,0,0,0,,apa yang dilakukan Uka?
Dialog: 0,0:24:28.95,0:24:31.50,teks umum,,0,0,0,,Semuanya baik-baik saja, dia cukup makan dan sehat
Dialog: 0,0:24:32.58,0:24:34.71,teks umum,,0,0,0,,Dia masih belum melepaskan gelangnya
Dialog: 0,0:24:37.05,0:24:38.13,teks umum,,0,0,0,,Kamu boleh pergi
Dialog: 0,0:24:59.40,0:25:00.86,teks umum,,0,0,0,,Tidak terlalu berat lagi
Dialog: 0,0:25:00.95,0:25:02.49,teks umum,,0,0,0,,Dan tidak mengganggu berjalan
Dialogue: 0,0:25:02.57,0:25:05.16,teks umum,,0,0,0,,Beberapa pesulap berlatih dengan beban besi,
Dialog: 0,0:25:05.24,0:25:07.28,teks umum,,0,0,0,,untuk memperkuat tanganmu dan menggunakan pedang dengan lebih baik
Dialog: 0,0:25:07.79,0:25:10.96,miring,,0,0,0,,Kamu tanpa sadar menjadi lebih kuat,
Dialog: 0,0:25:11.04,0:25:13.25,teks umum,,0,0,0,,sambil memakai gelang berat ini sepanjang hari
Dialog: 0,0:25:13.33,0:25:14.75,teks umum,,0,0,0,,Tidak Disengaja,
Dialog: 0,0:25:14.83,0:25:17.13,teks umum,,0,0,0,,tetapi Anda menemukan alat pelatihan yang hebat untuk diri Anda sendiri
Dialog: 0,0:25:18.42,0:25:19.96,teks umum,,0,0,0,,Kamu sungguh beruntung
Dialog: 0,0:25:20.05,0:25:23.43,teks umum,,0,0,0,,Jika aku melepasnya, aku akan menjadi lebih cepat dan lebih kuat
Dialog: 0,0:25:24.01,0:25:27.47,teks umum,,0,0,0,,Tetapi jika kamu tidak belajar mengendalikan diri, kamu akan menjadi lebih menyedihkan
Dialog: 0,0:25:29.22,0:25:30.27,teks umum,,0,0,0,,Saya...
Dialog: 0,0:25:30.93,0:25:31.93,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:25:35.85,0:25:38.94,teks umum,,0,0,0,,Apa yang kamu dan Yul bicarakan?
Dialog: 0,0:25:41.36,0:25:42.86,teks umum,,0,0,0,,Tentang Danhyangok
Dialog: 0,0:25:44.86,0:25:47.87,teks umum,,0,0,0,,Dia bertanya bagaimana keadaan di sini di musim dingin
Dialog: 0,0:25:52.04,0:25:53.91,miring,,0,0,0,,Anda bertemu Naxu,
Dialog: 0,0:25:54.67,0:25:56.33,teks umum,,0,0,0,,ketika kamu masih muda?
Dialog: 0,0:25:58.29,0:26:01.34,teks umum,,0,0,0,,Aku tidak yakin saat melihat tubuhnya
Dialog: 0,0:26:01.42,0:26:03.97,teks umum,,0,0,0,,Tapi perjalanan ke Danhyangk membantuku memastikan hal ini
Dialog: 0,0:26:04.05,0:26:05.13,teks umum,,0,0,0,,Jadi aku hanya mengatakan ini sekarang
Dialog: 0,0:26:06.22,0:26:10.01,teks umum,,0,0,0,,Danhyangok - lembah yang dalam dan berbahaya
Dialog: 0,0:26:10.10,0:26:12.77,teks umum,,0,0,0,,Gadis kecil itu tidak mungkin bertahan di sana tanpa bantuan seseorang
Dialog: 0,0:26:12.85,0:26:15.56,teks umum,,0,0,0,,Dia tinggal di sana, seolah bersembunyi dari seseorang
Dialog: 0,0:26:16.98,0:26:19.36,miring,,0,0,0,,Saat dia mengetahui siapa aku dan dari keluarga mana aku berasal,
Dialog: 0,0:26:20.11,0:26:22.03,miring,,0,0,0,,Aku tidak pernah melihatnya lagi
Dialog: 0,0:26:23.24,0:26:25.70,miring,,0,0,0,,Jadi aku tahu namamu...
Dialog: 0,0:26:26.49,0:26:29.58,teks umum,,0,0,0,,Ceritakan semua yang kamu ketahui tentang dia
Dialog: 0,0:26:32.37,0:26:33.75,teks umum,,0,0,0,,Saya tidak tahu apa-apa
Dialog: 0,0:26:34.37,0:26:36.12,teks umum,,0,0,0,,Tanpa nama, tanpa usia
Dialog: 0,0:26:36.79,0:26:38.67,teks umum,,0,0,0,,Kecuali tebing tempat kami mengamati burung...
Dialog: 0,0:26:38.75,0:26:40.42,teks umum,,0,0,0,,Saya tidak pernah melihat di mana dia tinggal
Dialog: 0,0:26:44.55,0:26:45.51,teks umum,,0,0,0,,Hanya satu
Dialog: 0,0:26:48.43,0:26:50.35,teks umum,,0,0,0,,Saat dia menyebut ayahnya
Dialog: 0,0:27:01.40,0:27:05.15,kenangan,,0,0,0,,Ayahku menggambarkan bintang-bintang
Dialog: 0,0:27:07.07,0:27:09.49,miring,,0,0,0,,Lalu aku tidak memperhatikannya
Dialog: 0,0:27:09.57,0:27:12.20,teks umum,,0,0,0,,Tapi inilah yang dilakukan para pengamat bintang
Dialog: 0,0:27:12.28,0:27:13.87,teks umum,,0,0,0,,dari Jeonbugwan
Dialog: 0,0:27:15.25,0:27:16.37,miring,,0,0,0,,Master,
Dialog: 0,0:27:16.87,0:27:18.92,teks umum,,0,0,0,,di antara para penyihir pengamat bintang
Dialog: 0,0:27:20.00,0:27:21.92,teks umum,,0,0,0,,apakah ada yang marah padamu?
Dialog: 0,0:27:24.92,0:27:26.22,teks umum,,0,0,0,,Pengamat Bintang
Dialog: 0,0:27:27.55,0:27:28.88,teks umum,,0,0,0,,dari Jeonbugwan?
Dialog: 0,0:27:30.89,0:27:31.97,teks umum,,0,0,0,,Penyihir?
Dialog: 0,0:27:36.81,0:27:40.48,miring,,0,0,0,,Dua puluh tahun yang lalu ada seorang peramal yang meninggal...
Dialog: 0,0:27:41.11,0:27:43.82,miring,,0,0,0,,di tangan empat keluarga
Dialog: 0,0:27:45.69,0:27:48.99,teks umum,,0,0,0,,Seluruh keluarganya terbunuh hari itu
Dialog: 0,0:27:49.66,0:27:51.07,teks umum,,0,0,0,,Kecuali satu orang
Dialog: 0,0:27:51.16,0:27:53.95,teks umum,,0,0,0,,Putrinya tidak ditemukan malam itu
Dialog: 0,0:28:20.35,0:28:22.23,miring,,0,0,0,,Ternyata keluarga kami bersalah
Dialog: 0,0:28:23.19,0:28:25.11,teks umum,,0,0,0,,dalam kematian ayahnya
Dialog: 0,0:28:25.69,0:28:27.40,teks umum,,0,0,0,,Dia pasti punya dendam padamu,
Dialog: 0,0:28:27.48,0:28:29.82,teks umum,,0,0,0,,karena keluargamu ikut serta dalam hal ini
Dialog: 0,0:28:29.90,0:28:32.82,teks umum,,0,0,0,,Apakah kamu ingat hal lain?
Dialog: 0,0:28:33.41,0:28:35.08,teks umum,,0,0,0,,Itu sudah lama sekali
Dialog: 0,0:28:36.12,0:28:37.83,teks umum,,0,0,0,,Sepertinya aku tidak dapat mengingat hal lain
Dialog: 0,0:29:00.81,0:29:02.52,kenangan miring,,0,0,0,,Karena aku ingin melihatnya
Dialogue: 0,0:29:03.81,0:29:06.02,kenangan miring,,0,0,0,,Patah kaki tak menggangguku
Dialog: 0,0:29:06.11,0:29:07.90,kenangan miring,,0,0,0,,Dan aku tidak takut mereka akan memarahiku
Dialog: 0,0:29:12.32,0:29:14.16,kenangan,,0,0,0,,Aku sangat menyukainya
Dialog: 0,0:29:23.37,0:29:27.50,kenangan miring,,0,0,0,,Saya melihat Anda menggunakan ini untuk memanggil burung Anda
Dialog: 0,0:29:29.42,0:29:30.67,kenangan,,0,0,0,,aku ingin mencobanya juga
Dialog: 0,0:29:31.67,0:29:33.59,kenangan,,0,0,0,,Bolehkah aku memilikinya?
Dialog: 0,0:30:29.48,0:30:31.11,di belakang layar,,0,0,0,,Putra Mahkota itu kuat
Dialog: 0,0:30:31.73,0:30:36.15, sulih suara,,0,0,0,,Hanya ada satu cara bagi Uka untuk mengalahkannya dan tetap hidup
Dialog: 0,0:30:37.07,0:30:38.45,teks umum,,0,0,0,,Tansu
Dialog: 0,0:31:12.48,0:31:14.23,teks umum,,0,0,0,,Apa yang kamu inginkan dariku?
Dialogue: 0,0:31:15.94,0:31:17.86,teks umum,,0,0,0,,Potong tetesan air yang jatuh
Dialogue: 0,0:31:19.28,0:31:20.57,teks umum,,0,0,0,,Bukan rintik hujan
Dialog: 0,0:31:20.66,0:31:23.04,teks umum,,0,0,0,,Bahkan seseorang yang tidak beruntung sepertimu
Dialog: 0,0:31:23.12,0:31:25.58,teks umum,,0,0,0,,akan mampu memotong tetesan yang menetes begitu pelan
Dialog: 0,0:31:26.25,0:31:27.12,teks umum,,0,0,0,,Maju
Dialog: 0,0:31:48.44,0:31:50.31,teks umum,,0,0,0,,Hanya tiga tetes sekaligus
Dialog: 0,0:31:51.19,0:31:52.36,miring,,0,0,0,,Tidak masalah
Dialog: 0,0:31:52.44,0:31:55.98,teks umum,,0,0,0,,Tarian yang akan kamu pelajari mengharuskanmu memotong satu saja
Dialog: 0,0:31:56.07,0:31:57.19,teks umum,,0,0,0,,Tansu?
Dialog: 0,0:31:58.74,0:31:59.91,teks umum,,0,0,0,,Guru...
Dialog: 0,0:32:00.41,0:32:03.91,teks umum,,0,0,0,,Saya mengerti, saya pembelajar yang cukup cepat,
Dialog: 0,0:32:03.99,0:32:05.33,teks umum,,0,0,0,,tapi Tansu... tidak terlalu banyak?
Dialog: 0,0:32:05.41,0:32:08.00,teks umum,,0,0,0,,Sepertinya gurumu mengajarimu sesuatu
Dialog: 0,0:32:08.08,0:32:09.08,teks umum,,0,0,0,,Benar
Dialog: 0,0:32:09.16,0:32:11.96,teks umum,,0,0,0,,Kamu dapat mempelajari Tansu hanya setelah menguasai Chisu
Dialog: 0,0:32:12.63,0:32:14.59,teks umum,,0,0,0,,Kamu baru saja menguasai Ryusu
Dialog: 0,0:32:14.67,0:32:17.30,teks umum,,0,0,0,,Kamu masih belum bisa mengendalikan energimu
Dialog: 0,0:32:17.38,0:32:19.22,teks umum,,0,0,0,,Siswa setingkatmu tidak dapat mempelajari ini
Dialog: 0,0:32:20.55,0:32:21.68,teks umum,,0,0,0,,Tapi?
Dialog: 0,0:32:22.30,0:32:23.64,teks umum,,0,0,0,,Tapi hanya dengan cara ini
Dialog: 0,0:32:25.31,0:32:29.60,teks umum,,0,0,0,,kamu akan mengalahkan putra mahkota dan tetap hidup
Dialog: 0,0:33:04.09,0:33:07.18,di balik layar,,0,0,0,,Tansu adalah pergerakan energi dengan pedang
Dialog: 0,0:33:07.26,0:33:09.06, sulih suara,,0,0,0,,Tangan kananmu lemah,
Dialog: 0,0:33:09.77,0:33:12.35,di belakang layar,,0,0,0,,tapi diperkuat berkat gelangnya
Dialog: 0,0:33:13.48,0:33:14.35,di belakang layar,,0,0,0,,Hanya satu tetes
Dialog: 0,0:33:15.44,0:33:18.44,di belakang layar,,0,0,0,,Tekan satu tetes sehingga kamu dapat mengumpulkan dan mengarahkan energi
Dialog: 0,0:33:30.79,0:33:32.54,teks umum,,0,0,0,,Kamu tidak akan bisa menguasai Tansu secepat itu
Dialog: 0,0:33:33.21,0:33:34.67,teks umum,,0,0,0,,Ayo makan dan lanjutkan
Dialog: 0,0:34:22.84,0:34:24.01,teks umum,,0,0,0,,Tansu?
Dialog: 0,0:34:24.80,0:34:26.59,teks umum,,0,0,0,,Ya, dia tidak akan pernah bisa menguasainya
Dialog: 0,0:34:29.30,0:34:32.14,miring,,0,0,0,,Ini bukan pembantu dan majikannya
Dialog: 0,0:34:32.85,0:34:34.89,teks umum,,0,0,0,,Cepat guru dan murid
Dialog: 0,0:36:14.16,0:36:15.33,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:36:17.41,0:36:19.58,miring,,0,0,0,,Jadi kamu melatihnya
Dialog: 0,0:36:22.63,0:36:24.50,teks umum,,0,0,0,,Saya melihatnya berlatih Tansu
Dialog: 0,0:36:25.38,0:36:26.59,teks umum,,0,0,0,,Dari mana kamu mempelajarinya?
Dialog: 0,0:36:27.17,0:36:31.18,teks umum,,0,0,0,,Pemiliknya pintar, dia punya 12 guru
Dialog: 0,0:36:31.26,0:36:33.30,teks umum,,0,0,0,,Dia mencoba berlari tanpa benar-benar belajar berjalan
Dialog: 0,0:36:33.39,0:36:35.51,teks umum,,0,0,0,,Perjalanannya masih panjang
Dialog: 0,0:36:35.60,0:36:37.85,teks umum,,0,0,0,,Setidaknya patut dicoba
Dialog: 0,0:36:38.43,0:36:41.14,teks umum,,0,0,0,,Langkah selanjutnya bisa menyebabkan kematiannya
Dialog: 0,0:36:45.15,0:36:47.36,teks umum,,0,0,0,,Apakah tuanmu tahu tentang ini?
Dialog: 0,0:37:22.73,0:37:24.73,teks umum,,0,0,0,,Kenapa kamu tidak menghindar?
Dialog: 0,0:37:24.81,0:37:25.90,teks umum,,0,0,0,,Serius
Dialog: 0,0:37:41.75,0:37:44.00,teks umum,,0,0,0,,Ini adalah hasil dari pelepasan energimu ke luar
Dialog: 0,0:37:45.17,0:37:47.21,teks umum,,0,0,0,,Lenganmu mungkin patah jika melanjutkan
Dialog: 0,0:37:53.38,0:37:56.72,teks umum,,0,0,0,,Dia akan mulai membusuk. Maka Anda harus memotongnya
Dialog: 0,0:37:57.39,0:37:58.51,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:38:02.68,0:38:05.77,teks umum,,0,0,0,,Jika energi yang membusuk menyebar ke seluruh tubuhmu,
Dialog: 0,0:38:06.40,0:38:07.65,teks umum,,0,0,0,,kamu akan mati
Dialog: 0,0:38:27.38,0:38:29.63,teks umum,,0,0,0,,Panasnya sudah mereda. Apakah kamu baik-baik saja?
Dialog: 0,0:38:29.71,0:38:31.34,teks umum,,0,0,0,,Tidur. Tidur adalah obat terbaik
Dialog: 0,0:38:32.13,0:38:33.13,teks umum,,0,0,0,,Pembohong
Dialog: 0,0:38:35.30,0:38:37.09,teks umum,,0,0,0,,Benarkah yang dia katakan?
Dialog: 0,0:38:37.64,0:38:39.47,miring,,0,0,0,,Tidak masalah jika aku mati karena racun,
Dialog: 0,0:38:39.55,0:38:42.35,teks umum,,0,0,0,,mencambuk, memukul dengan pedang atau karena lenganmu patah
Dialog: 0,0:38:43.06,0:38:46.44,teks umum,,0,0,0,,Guruku tidak peduli dengan muridnya
Dialog: 0,0:38:48.02,0:38:49.44,teks umum,,0,0,0,,Benar
Dialog: 0,0:38:50.36,0:38:54.36,teks umum,,0,0,0,,Ini karena kamu sangat beruntung dan beruntung
Dialogue: 0,0:38:55.11,0:38:57.45,teks umum,,0,0,0,,Apakah berbohong adalah nama tengahmu?
Dialog: 0,0:39:00.62,0:39:02.70,teks umum,,0,0,0,,Aku hanya tidak ingin membuatmu takut
Dialog: 0,0:39:03.29,0:39:06.46,teks umum,,0,0,0,,Mengerti. Terima kasih guruku yang tanpa ampun
Dialog: 0,0:39:06.54,0:39:09.13,teks umum,,0,0,0,,Tapi menjauhlah saat aku memegang pedang lagi
Dialog: 0,0:39:09.21,0:39:10.79,teks umum,,0,0,0,,Aku hampir menikammu hari ini
Dialog: 0,0:39:10.88,0:39:14.26,teks umum,,0,0,0,,Aku berdiri karena aku ingin kamu mengendalikan energinya sendiri
Dialog: 0,0:39:14.88,0:39:16.17,teks umum,,0,0,0,,Saya tidak bermaksud ikut campur
Dialog: 0,0:39:16.26,0:39:19.01,teks umum,,0,0,0,,Kamu tidak ikut campur. Aku hanya mengkhawatirkanmu
Dialog: 0,0:39:25.64,0:39:27.69,teks umum,,0,0,0,,Anggaplah aku sebagai induk burung yang cemas...
Dialog: 0,0:39:27.77,0:39:29.81,teks umum,,0,0,0,,telurnya akan pecah. Bisakah Anda bayangkan?
Dialog: 0,0:39:29.90,0:39:32.44,teks umum,,0,0,0,,Tidak masalah. Ini tidak akan merugikan saya
Dialog: 0,0:39:32.52,0:39:33.65,teks umum,,0,0,0,,Aku bisa mengelak
Dialog: 0,0:39:34.40,0:39:35.61,teks umum,,0,0,0,,Tidakkah berbahaya?
Dialogue: 0,0:39:35.69,0:39:37.90,teks umum,,0,0,0,,Bagaimana kamu bisa mengelak kalau aku begitu cepat?
Dialog: 0,0:39:37.99,0:39:39.66,teks umum,,0,0,0,,Tidak terlalu cepat
Dialog: 0,0:39:40.32,0:39:41.70,teks umum,,0,0,0,,Bajingan...
Dialog: 0,0:39:43.54,0:39:45.12,teks umum,,0,0,0,,Cepat, kan? Jangan menghindar
Dialog: 0,0:39:45.20,0:39:46.70,teks umum,,0,0,0,,Kamu menyerang tanpa peringatan!
Dialog: 0,0:39:46.79,0:39:48.54,teks umum,,0,0,0,,Ya? Lalu ini dia
Dialog: 0,0:39:48.62,0:39:49.71,teks umum,,0,0,0,,Mu Dok, mata
Dialog: 0,0:39:52.34,0:39:53.38,teks umum,,0,0,0,,Bajingan
Dialog: 0,0:39:53.46,0:39:55.46,teks umum,,0,0,0,,Kamu membelinya lagi, aku tidak percaya
Dialog: 0,0:40:00.43,0:40:01.68,teks umum,,0,0,0,,Ayo lagi
Dialog: 0,0:40:02.72,0:40:04.18,teks umum,,0,0,0,,Dari jarak ini?
Dialog: 0,0:40:04.26,0:40:05.85,teks umum,,0,0,0,,- Serius?\N- Ayolah
Dialog: 0,0:40:10.56,0:40:11.69,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:40:12.94,0:40:15.11,teks umum,,0,0,0,,tanda biru terlihat di mata
Dialog: 0,0:40:15.98,0:40:17.32,teks umum,,0,0,0,,Dan itu sangat indah
Dialog: 0,0:40:21.20,0:40:24.78,teks umum,,0,0,0,,Dan sebaiknya kau tidak memprovokasiku dengan bersikap begitu dekat
Dialogue: 0,0:40:25.45,0:40:26.74,teks umum,,0,0,0,,Pikirkan aku bisa
Dialog: 0,0:40:26.83,0:40:28.25,teks umum,,0,0,0,,dari jarak ini
Dialog: 0,0:40:32.50,0:40:34.50,teks umum,,0,0,0,,Saya pikir Anda memahami kata-kata saya dengan benar
Dialogue: 0,0:40:35.38,0:40:37.51,teks umum,,0,0,0,,Mungkin ada yang bisa kuajarkan padamu
Dialog: 0,0:40:41.97,0:40:43.14,teks umum,,0,0,0,,Chang Wook
Dialogue: 0,0:40:46.39,0:40:50.10,teks umum,,0,0,0,,Apakah menurutmu aku naif jika tinggal di sini sendirian?
Dialog: 0,0:40:51.52,0:40:52.81,teks umum,,0,0,0,,Ya, ya
Dialog: 0,0:40:54.77,0:40:57.78,teks umum,,0,0,0,,Saya ingin Anda tahu bahwa saya bisa mengajari Anda banyak hal
Dialog: 0,0:40:58.99,0:41:00.11,teks umum,,0,0,0,,Misalnya?
Dialog: 0,0:41:07.24,0:41:08.54,teks umum,,0,0,0,,Hei! kamu...
Dialog: 0,0:41:08.62,0:41:10.79,teks umum,,0,0,0,,Serangan yang benar-benar efektif adalah
Dialog: 0,0:41:10.87,0:41:14.00,teks umum,,0,0,0,,ketika musuh tidak menduganya sama sekali
Dialog: 0,0:41:14.54,0:41:16.38,teks umum,,0,0,0,,Ingat ini, muridku
Dialog: 0,0:41:17.59,0:41:21.05,teks umum,,0,0,0,,Aku hampir tidak menyentuhmu, dan kamu memberikan segalanya!
Dialog: 0,0:41:21.13,0:41:22.76,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:41:24.43,0:41:26.76,teks umum,,0,0,0,,Hei, Moo Deok
Dialog: 0,0:41:36.98,0:41:38.78,miring,,0,0,0,,Selir baru?
Dialog: 0,0:41:39.61,0:41:42.70,teks umum,,0,0,0,,Sekarang dia bahkan tidak mengikuti formalitas
Dialog: 0,0:41:43.32,0:41:45.57,miring,,0,0,0,,Dia berasal dari keluarga kecil penyihir di timur
Dialog: 0,0:41:45.66,0:41:48.91,miring,,0,0,0,,Pada hari ulang tahunnya, sebuah komet melesat melewati Biduk
Dialog: 0,0:41:48.99,0:41:52.71,teks umum,,0,0,0,,Jadi dia akan mengumpulkan semua wanita yang lahir pada malam yang tidak biasa
Dialog: 0,0:41:52.79,0:41:55.42,miring,,0,0,0,,Dia ingin menangkap bintang Raja
Dialog: 0,0:42:06.43,0:42:08.35,teks umum,,0,0,0,,Saat mendiang raja naik takhta,
Dialog: 0,0:42:08.43,0:42:12.64,teks umum,,0,0,0,,diramalkan yang berikutnya akan lahir di bawah bintang Raja
Dialog: 0,0:42:13.77,0:42:16.52,teks umum,,0,0,0,,Penduduk Deho bahagia
Dialog: 0,0:42:16.60,0:42:17.48,teks umum,,0,0,0,,Tapi
Dialog: 0,0:42:17.56,0:42:20.69,teks umum,,0,0,0,,takhta diambil oleh ayahmu, lahir di malam biasa
Dialogue: 0,0:42:20.78,0:42:22.57,teks umum,,0,0,0,,Jika tidak, seperti kamu
Dialog: 0,0:42:23.36,0:42:24.90,teks umum,,0,0,0,,Jadi percakapan dimulai
Dialog: 0,0:42:25.78,0:42:27.62,teks umum,,0,0,0,,Prediksi salah
Dialog: 0,0:42:27.70,0:42:31.41,teks umum,,0,0,0,,Gwangju Chang Gang lolos setelah membuat prediksi yang lucu
Dialog: 0,0:42:31.49,0:42:33.54,teks umum,,0,0,0,,Ayahmu percaya padanya
Dialog: 0,0:42:34.12,0:42:35.87,teks umum,,0,0,0,,Jadi kamu takut
Dialog: 0,0:42:38.33,0:42:39.79,teks umum,,0,0,0,,Saya tidak takut
Dialog: 0,0:42:39.88,0:42:42.67,teks umum,,0,0,0,,Kamu takut seseorang dengan energi seperti itu akan muncul,
Dialog: 0,0:42:42.76,0:42:44.92,teks umum,,0,0,0,,atau ayahmu akan mempunyai seorang putra
Dialog: 0,0:42:45.80,0:42:47.64,miring,,0,0,0,,Saya tahu itu
Dialog: 0,0:42:51.06,0:42:53.81,teks umum,,0,0,0,,Pertarunganmu dengan Chan Wook sudah dekat
Dialog: 0,0:42:53.89,0:42:57.23,teks umum,,0,0,0,,Hancurkan anak orang yang membuat prediksi ini
Dialog: 0,0:42:58.86,0:43:01.65,teks umum,,0,0,0,,Singkirkan ketakutanmu sekarang karena kamu punya kesempatan
Dialog: 0,0:43:04.28,0:43:05.45,teks umum,,0,0,0,,Menurutmu,
Dialog: 0,0:43:06.32,0:43:07.78,teks umum,,0,0,0,,apakah akan muncul?
Dialog: 0,0:43:08.78,0:43:09.87,teks umum,,0,0,0,,Kudengar dia berlari
Dialog: 0,0:43:10.78,0:43:14.25,teks umum,,0,0,0,,Ada rumor bahkan dia siap menikah, hanya saja tidak untuk bertengkar
Dialog: 0,0:43:15.41,0:43:16.71,teks umum,,0,0,0,,Pernikahan?
Dialog: 0,0:43:16.79,0:43:20.71,teks umum,,0,0,0,,Kudengar dia akan bergabung dengan keluarga Jin untuk menggunakan jimat keluarga mereka
Dialogue: 0,0:43:27.13,0:43:29.14,teks umum,,0,0,0,,Apakah Wook dan Jo Young akan menikah?
Dialog: 0,0:43:29.93,0:43:31.76,teks umum,,0,0,0,,Mereka memutuskan pertunangan mereka satu kali
Dialog: 0,0:43:32.68,0:43:34.64,teks umum,,0,0,0,,Jadi lebih mudah mempersiapkan pernikahan
Dialog: 0,0:43:35.43,0:43:38.64,teks umum,,0,0,0,,Dia masih memiliki hadiah pernikahan
Dialog: 0,0:43:38.73,0:43:40.90,teks umum,,0,0,0,,dari terakhir kali
Dialog: 0,0:43:43.94,0:43:45.03,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:43:45.53,0:43:48.40,miring,,0,0,0,,Setelah pernikahan Chan Wook...
Dialog: 0,0:43:48.49,0:43:51.45,teks umum,,0,0,0,,Artinya, suamiku akan pindah ke sini
Dialog: 0,0:43:51.95,0:43:54.45,teks umum,,0,0,0,,Tapi kamarku terlalu kecil untuk kita berdua
Dialog: 0,0:43:54.54,0:43:59.00,teks umum,,0,0,0,,Bisakah kita menggunakan ruangan besar di sayap timur?
Dialog: 0,0:43:59.58,0:44:02.34,teks umum,,0,0,0,,Ini kamar kakakmu
Dialog: 0,0:44:03.84,0:44:06.38,teks umum,,0,0,0,,Ini ruangan terbaik kami
Dialogue: 0,0:44:06.46,0:44:09.51,teks umum,,0,0,0,,Sayang sekali jika dibiarkan kosong selama bertahun-tahun
Dialog: 0,0:44:10.51,0:44:11.97,teks umum,,0,0,0,,Tidak kosong
Dialog: 0,0:44:12.68,0:44:14.39,teks umum,,0,0,0,,Boo Young akan kembali
Dialog: 0,0:44:15.81,0:44:17.56,teks umum,,0,0,0,,Maaf ibu
Dialog: 0,0:44:20.31,0:44:22.19,teks umum,,0,0,0,,Ayahmu sedang mencarinya
Dialog: 0,0:44:23.36,0:44:26.44,teks umum,,0,0,0,,Adikmu akan segera pulang
Dialogue: 0,0:44:28.86,0:44:31.24,teks umum,,0,0,0,,Bawakan aku giok Yin-dan-Yang dari Jinyeowon
Dialog: 0,0:44:33.66,0:44:34.95,teks umum,,0,0,0,,Yin-dan-Yang?
Dialog: 0,0:44:35.03,0:44:36.41,teks umum,,0,0,0,,Kamu menginginkan dia
Dialog: 0,0:44:37.95,0:44:41.00,teks umum,,0,0,0,,Mereka bilang jika pasangan memakai cincin yang terbuat dari batu giok tersebut,
Dialog: 0,0:44:41.08,0:44:42.79,teks umum,,0,0,0,,cinta hanya akan tumbuh lebih kuat
Dialog: 0,0:44:44.92,0:44:47.92,teks umum,,0,0,0,,Biarkan mereka membuat cincin darinya
Dialog: 0,0:44:49.34,0:44:51.09,teks umum,,0,0,0,,Terima kasih bu
Dialog: 0,0:45:14.62,0:45:16.99,teks umum,,0,0,0,,Guci yang mengganggu. Apakah itu kamu?
Dialog: 0,0:45:17.49,0:45:19.04,teks umum,,0,0,0,,Menyebalkan
Dialog: 0,0:45:26.00,0:45:27.25,teks umum,,0,0,0,,Menurutku kamu marah,
Dialog: 0,0:45:27.34,0:45:29.42,teks umum,,0,0,0,,bahwa aku akan menikah
Dialog: 0,0:45:29.51,0:45:30.55,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:45:30.63,0:45:32.22,teks umum,,0,0,0,,Kamu akan semakin marah,
Dialog: 0,0:45:32.30,0:45:34.05,teks umum,,0,0,0,,saat aku memakai cincin giok ini
Dialog: 0,0:45:46.36,0:45:47.94,teks umum,,0,0,0,,Makan
Dialog: 0,0:45:48.94,0:45:50.23,teks umum,,0,0,0,,Jadi
Dialog: 0,0:45:52.61,0:45:55.11,teks umum,,0,0,0,,Saya membawa burung pegar
Dialog: 0,0:45:55.20,0:45:57.16,teks umum,,0,0,0,,Mengapa hanya ada tanaman hijau di sini?
Dialog: 0,0:45:57.24,0:45:58.66,teks umum,,0,0,0,,Dia disana...
Dialog: 0,0:45:59.33,0:46:00.24,teks umum,,0,0,0,,Dia ada di dalam sup
Dialog: 0,0:46:00.33,0:46:02.08,teks umum,,0,0,0,,Burung pegar itu sangat kecil
Dialog: 0,0:46:02.16,0:46:03.92,teks umum,,0,0,0,,Hanya ada sedikit yang tersisa saat aku menyiapkan kuahnya
Dialog: 0,0:46:14.84,0:46:16.93,teks umum,,0,0,0,,Rasanya sangat lemah
Dialog: 0,0:46:21.93,0:46:24.73,teks umum,,0,0,0,,Saya mendengar sesuatu saat menjual jamu di Sosnovy Bor
Dialog: 0,0:46:24.81,0:46:27.19,teks umum,,0,0,0,,Dua keluarga bangsawan menikahkan anak mereka
Dialog: 0,0:46:27.77,0:46:29.69,teks umum,,0,0,0,,Dan siapa ini?
Dialog: 0,0:46:29.77,0:46:32.69,teks umum,,0,0,0,,Putri Nyonya Jin akan menikah
Dialog: 0,0:46:33.40,0:46:36.45,teks umum,,0,0,0,,Apakah Young sudah mendapatkan calon pengantin pria? Siapa dia?
Dialog: 0,0:46:36.53,0:46:38.66,teks umum,,0,0,0,,Putra Gwangju Jeonbugwan
Dialog: 0,0:46:40.95,0:46:42.33,teks umum,,0,0,0,,Bukankah itu kamu?
Dialog: 0,0:46:53.26,0:46:56.47,teks umum,,0,0,0,,Saya tidak mengatakan bahwa saya akan menikah. Apa yang terjadi?
Dialogue: 0,0:46:56.55,0:46:58.22,teks umum,,0,0,0,,Apa yang dilakukan pembantu Kim di sana?
Dialog: 0,0:46:58.30,0:47:01.06,teks umum,,0,0,0,,Pernikahan tergesa-gesa terjadi karena kemunculan seorang anak
Dialog: 0,0:47:01.14,0:47:02.18,teks umum,,0,0,0,,Tidak
Dialog: 0,0:47:02.77,0:47:04.35,teks umum,,0,0,0,,Kamu sudah bertunangan
Dialog: 0,0:47:05.02,0:47:06.60,teks umum,,0,0,0,,Mungkin kamu tidak bisa menahan diri
Dialog: 0,0:47:06.69,0:47:09.90,teks umum,,0,0,0,,Kita belum pernah sedekat ini, bagaimana dia bisa hamil?
Dialog: 0,0:47:10.73,0:47:12.86,teks umum,,0,0,0,,Ya, kamu sangat pandai berbicara
Dialog: 0,0:47:12.94,0:47:14.11,teks umum,,0,0,0,,Apa?
Dialogue: 0,0:47:14.19,0:47:16.07,teks umum,,0,0,0,,Lalu kenapa kamu menolak minum teh kesucian?
Dialog: 0,0:47:16.15,0:47:17.15,teks umum,,0,0,0,,Ini karena...
Dialog: 0,0:47:19.57,0:47:21.24,teks umum,,0,0,0,,bahwa kamu harus menikah
Dialog: 0,0:47:23.08,0:47:24.83,teks umum,,0,0,0,,Jadi, aku ingin menikah
Dialog: 0,0:47:26.12,0:47:27.67,teks umum,,0,0,0,,Ya, saya ingin
Dialog: 0,0:47:27.75,0:47:28.87,teks umum,,0,0,0,,Saya sangat ingin
Dialog: 0,0:47:29.63,0:47:32.17,teks umum,,0,0,0,,Saya pasti akan menikah
Dialog: 0,0:47:32.25,0:47:33.50,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:47:48.73,0:47:50.44,miring,,0,0,0,,Kenapa kamu ingin bertemu denganku?
Dialog: 0,0:47:51.23,0:47:54.65,teks umum,,0,0,0,,Kapan lemari mutiara yang saya pesan dari Sosnovy Bor akan tiba?
Dialog: 0,0:47:55.28,0:47:56.53,teks umum,,0,0,0,,Dia untuk Inggris dan aku
Dialog: 0,0:47:56.61,0:48:00.61,teks umum,,0,0,0,,Barang dari selatan akan tiba pada hari dalam seminggu
Dialog: 0,0:48:01.37,0:48:02.66,teks umum,,0,0,0,,Sudah larut
Dialog: 0,0:48:03.66,0:48:05.12,teks umum,,0,0,0,,Seharusnya dipesan lebih awal
Dialog: 0,0:48:05.20,0:48:07.08,teks umum,,0,0,0,,Lupakan lemari
Dialogue: 0,0:48:07.62,0:48:09.54,teks umum,,0,0,0,,Aku harus beritahu Uku
Dialog: 0,0:48:10.88,0:48:12.21,teks umum,,0,0,0,,Dia tidak tahu
Dialog: 0,0:48:14.30,0:48:16.92,teks umum,,0,0,0,,Jadi aku menulis surat padanya
Dialog: 0,0:48:17.72,0:48:19.18,teks umum,,0,0,0,,Baca dan bagikan pemikiranmu
Dialog: 0,0:48:20.89,0:48:22.01,teks umum,,0,0,0,,Oke
Dialog: 0,0:48:25.72,0:48:26.85,teks umum,,0,0,0,,Baunya
Dialog: 0,0:48:26.93,0:48:29.23,teks umum,,0,0,0,,Inilah dupa yang membawa cinta
Dialog: 0,0:48:30.14,0:48:31.60,teks umum,,0,0,0,,Harta Karun Jinyeowon
Dialog: 0,0:48:33.36,0:48:35.98,teks umum,,0,0,0,,Baunya enak sekali
Dialogue: 0,0:48:57.80,0:48:59.55,teks umum,,0,0,0,,Kenapa kamu menciumnya?
Dialog: 0,0:48:59.63,0:49:00.59,teks umum,,0,0,0,,Hentikan!
Dialog: 0,0:49:01.72,0:49:03.64,teks umum,,0,0,0,,Dan tutup hidungmu!
Dialog: 0,0:49:15.98,0:49:17.82,teks umum,,0,0,0,,Aku hampir menyia-nyiakan semuanya
Dialog: 0,0:49:21.03,0:49:22.74,teks umum,,0,0,0,,Berikan surat itu pada Uku
Dialog: 0,0:49:23.32,0:49:26.53,teks umum,,0,0,0,,Dan pastikan tidak ada wanita di dekatnya saat dia membuka
Dialog: 0,0:49:29.33,0:49:30.16,teks umum,,0,0,0,,Oke
Dialog: 0,0:49:35.50,0:49:36.63,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:49:36.71,0:49:41.38,teks umum,,0,0,0,,Kamu dan Inggris punya tangan yang sama kan?
Dialog: 0,0:49:43.38,0:49:44.59,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:45.39,0:49:47.89,teks umum,,0,0,0,,Ikut aku membeli cincin kawin
Dialogue: 0,0:49:47.97,0:49:49.31,teks umum,,0,0,0,,Tolong bantu aku
Dialog: 0,0:49:50.06,0:49:52.52,teks umum,,0,0,0,,Kenapa aku harus pergi ke sana bersamamu?
Dialogue: 0,0:49:52.60,0:49:53.77,teks umum,,0,0,0,,Pergilah bersama tunanganmu
Dialog: 0,0:49:54.81,0:49:58.94,teks umum,,0,0,0,,Pernikahan harus diakhiri dengan persetujuan bersama
Dialog: 0,0:49:59.57,0:50:02.32,teks umum,,0,0,0,,Sedih sekali kamu bersikap seperti ini
Dialog: 0,0:50:03.61,0:50:04.45,teks umum,,0,0,0,,Mengapa?
Dialogue: 0,0:50:06.03,0:50:07.99,teks umum,,0,0,0,,Apa menurutmu aku terburu-buru?
Dialog: 0,0:50:08.70,0:50:10.74,teks umum,,0,0,0,,Atau dia akan menolak lagi?
Dialog: 0,0:50:15.71,0:50:18.42,teks umum,,0,0,0,,Apakah kamu sedang terburu-buru atau tidak,
Dialog: 0,0:50:19.96,0:50:21.38,teks umum,,0,0,0,,saya akan bantu
Dialog: 0,0:50:22.21,0:50:23.38,teks umum,,0,0,0,,Kalau saja berhasil
Dialog: 0,0:50:28.43,0:50:30.18,teks umum,,0,0,0,,Dan aku juga akan membantumu
Dialog: 0,0:50:39.36,0:50:40.94,miring,,0,0,0,,Kalau dipikir-pikir,
Dialog: 0,0:50:41.03,0:50:43.65,teks umum,,0,0,0,,pembantu Kim menentangku tinggal bersama keluarga istriku,
Dialog: 0,0:50:43.74,0:50:45.82,teks umum,,0,0,0,,kapan terakhir kali kita membahas pernikahan dengan Cho Young
Dialog: 0,0:50:47.20,0:50:50.49,teks umum,,0,0,0,,Hanya ada satu alasan kenapa mereka mulai membicarakan pernikahan lagi
Dialog: 0,0:50:50.99,0:50:52.20,teks umum,,0,0,0,,Pertahananku
Dialog: 0,0:50:52.79,0:50:55.04,teks umum,,0,0,0,,Dia membuat kesepakatan dengan keluarga Jin,
Dialog: 0,0:50:55.12,0:50:57.46,teks umum,,0,0,0,,untuk membantumu menghindari perkelahian
Dialog: 0,0:50:57.54,0:50:59.54,teks umum,,0,0,0,,Dia mungkin membutuhkan pengaruh Nyonya Jin
Dialog: 0,0:51:01.00,0:51:02.63,teks umum,,0,0,0,,Dalam hal ini,
Dialog: 0,0:51:03.67,0:51:05.09,teks umum,,0,0,0,,menikah?
Dialog: 0,0:51:06.84,0:51:09.85,teks umum,,0,0,0,,Apa yang harus saya lakukan, guru? Kawin?
Dialog: 0,0:51:12.22,0:51:13.35,teks umum,,0,0,0,,Apakah itu layak?
Dialog: 0,0:51:15.18,0:51:18.90,teks umum,,0,0,0,,Dalam hal ini, tidak ada alasan untuk tinggal di sini lagi
Dialog: 0,0:51:19.48,0:51:21.40,teks umum,,0,0,0,,Tepat. Kita harus kembali ke rumah
Dialog: 0,0:51:21.48,0:51:23.69,teks umum,,0,0,0,,Tapi hubungan kita tentu saja tidak akan bertahan
Dialog: 0,0:51:23.78,0:51:26.65,teks umum,,0,0,0,,Mengapa? Kamu masih bisa menjadi pembantuku
Dialog: 0,0:51:28.86,0:51:31.53,teks umum,,0,0,0,,Rencanaku tidak termasuk menjadi dia selamanya
Dialog: 0,0:51:49.76,0:51:51.39,teks umum,,0,0,0,,Maka kamu akan berlayar sendiri
Dialog: 0,0:51:51.47,0:51:52.97,teks umum,,0,0,0,,Saya akan berada di Chwisongru
Dialog: 0,0:51:54.31,0:51:57.39,teks umum,,0,0,0,,Jika kamu tidak datang untukku, aku akan pergi sendiri
Dialog: 0,0:52:12.12,0:52:13.87,teks umum,,0,0,0,,Chwisongru
Dialog: 0,0:52:19.33,0:52:20.33,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:52:20.42,0:52:22.08,teks umum,,0,0,0,,Kami dari Jeonbugwan
Dialog: 0,0:52:22.17,0:52:24.04,teks umum,,0,0,0,,Kami akan mengantarmu ke sana
Dialog: 0,0:52:24.13,0:52:24.96,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:52:28.38,0:52:30.30,miring,,0,0,0,,Ini bungkusan Yang Mulia
Dialog: 0,0:52:30.38,0:52:34.05,teks umum,,0,0,0,,Aku di bawah perlindungan sang pangeran sendiri, kamu jangan berani menyentuhku
Dialog: 0,0:52:37.27,0:52:39.73,teks umum,,0,0,0,,Apa yang kamu lakukan? Melepaskan!
Dialog: 0,0:52:39.81,0:52:41.69,teks umum,,0,0,0,,Ini bungkusan Putra Mahkota
Dialog: 0,0:52:53.70,0:52:55.91,teks umum,,0,0,0,,Kami menyampaikannya dari Chwisongru
Dialog: 0,0:52:56.54,0:52:58.33,teks umum,,0,0,0,,Chwisongru?
Dialog: 0,0:53:07.13,0:53:09.55,teks umum,,0,0,0,,Gadis yang kamu tanya telah tiba
Dialog: 0,0:53:10.17,0:53:11.30,teks umum,,0,0,0,,Dimana dia?
Dialog: 0,0:53:15.01,0:53:16.10,teks umum,,0,0,0,,Di Sini
Dialog: 0,0:53:18.43,0:53:19.39,teks umum,,0,0,0,,Dia?
Dialog: 0,0:53:19.93,0:53:21.52,teks umum,,0,0,0,,Angkat kepalamu
Dialogue: 0,0:53:33.07,0:53:34.70,teks umum,,0,0,0,,Kenapa kamu berpakaian seperti itu?
Dialog: 0,0:53:35.28,0:53:36.78,teks umum,,0,0,0,,Tidak tahu
Dialog: 0,0:53:37.32,0:53:40.53,teks umum,,0,0,0,,Dia mengganti pakaianku begitu mereka membawaku ke sini
Dialog: 0,0:53:41.49,0:53:43.66,teks umum,,0,0,0,,Apakah ini ulahmu?
Dialogue: 0,0:53:43.75,0:53:45.83,teks umum,,0,0,0,,Bukankah dia seorang kisaeng...
Dialog: 0,0:53:46.71,0:53:47.96,teks umum,,0,0,0,,dari Chwisongru?
Dialog: 0,0:53:49.13,0:53:50.29,teks umum,,0,0,0,,Tidak
Dialog: 0,0:53:51.84,0:53:54.26,teks umum,,0,0,0,,- Dia Bau Mu Dok\N- V-Bau?
Dialog: 0,0:53:56.34,0:53:57.59,teks umum,,0,0,0,,Keluar
Dialog: 0,0:53:58.51,0:53:59.76,teks umum,,0,0,0,,Pergi
Dialog: 0,0:54:02.89,0:54:04.14,teks umum,,0,0,0,,Lihat saja dirimu sendiri
Dialog: 0,0:54:08.35,0:54:10.36,teks umum,,0,0,0,,Mengapa kamu ingin bertemu denganku?
Dialog: 0,0:54:10.44,0:54:14.28,teks umum,,0,0,0,,Aku ingin mengatakan sesuatu, jadi aku perintahkan kamu diantar
Dialog: 0,0:54:14.36,0:54:16.36,teks umum,,0,0,0,,Tapi sekarang kamu bukan Won Moo Deok
Dialogue: 0,0:54:16.45,0:54:18.07,teks umum,,0,0,0,,Bau dan sutra tidak berjalan beriringan
Dialog: 0,0:54:18.78,0:54:21.37,teks umum,,0,0,0,,Dalam kamusmu itu sangat
Dialog: 0,0:54:22.41,0:54:23.79,teks umum,,0,0,0,,Apakah kamu baru saja mengambil jepretan?
Dialog: 0,0:54:23.87,0:54:25.41,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:25.50,0:54:28.46,teks umum,,0,0,0,,Aku bersyukur mereka mendandaniku dengan sutra
Dialog: 0,0:54:30.08,0:54:33.34,teks umum,,0,0,0,,Dapat diterima. Tampilan baru ini...
Dialog: 0,0:54:35.21,0:54:36.59,teks umum,,0,0,0,,tidak cocok untukmu
Dialog: 0,0:54:39.38,0:54:42.85,teks umum,,0,0,0,,Kamu tidak menyukainya, aku tidak nyaman dengan ini,
Dialog: 0,0:54:42.93,0:54:44.18,teks umum,,0,0,0,,Aku akan ganti baju
Dialog: 0,0:54:44.26,0:54:45.35,teks umum,,0,0,0,,Tidak
Dialog: 0,0:54:46.52,0:54:49.10,teks umum,,0,0,0,,Tidak masalah. Biarkan apa adanya
Dialog: 0,0:54:51.56,0:54:55.65,teks umum,,0,0,0,,Katakan apa yang kamu mau dan aku akan melakukannya
Dialog: 0,0:54:55.73,0:54:58.03,teks umum,,0,0,0,,Beri tahu tuanmu...
Dialog: 0,0:54:58.65,0:54:59.95,teks umum,,0,0,0,,jangan datang hari itu
Dialog: 0,0:55:01.11,0:55:02.45,teks umum,,0,0,0,,Saya tidak ingin membunuhnya
Dialog: 0,0:55:02.53,0:55:05.70,miring,,0,0,0,,dan menjadi musuh Hutan Pinus dan keluarga Chan
Dialog: 0,0:55:06.41,0:55:08.71,teks umum,,0,0,0,,Akan lebih baik jika dia melarikan diri dan membiarkan semuanya apa adanya
Dialog: 0,0:55:10.25,0:55:12.71,teks umum,,0,0,0,,Artinya, dia hanya perlu tetap menjadi bahan tertawaan
Dialog: 0,0:55:13.38,0:55:14.42,miring,,0,0,0,,Benar
Dialog: 0,0:55:15.05,0:55:18.34,teks umum,,0,0,0,,Jika dia keras kepala, bujuk dia untuk tidak melakukannya
Dialog: 0,0:55:18.42,0:55:20.34,teks umum,,0,0,0,,Dia tidak akan selamat jika bertarung denganku
Dialog: 0,0:55:22.93,0:55:26.06,teks umum,,0,0,0,,Biarkan dia duduk dengan tenang lalu menikah dengan Jin Cho Young
Dialog: 0,0:55:27.35,0:55:30.44,teks umum,,0,0,0,,Jadi benar pernikahan akan menyelamatkan nyawanya
Dialogue: 0,0:55:33.19,0:55:35.48,teks umum,,0,0,0,,Apa yang akan terjadi padamu jika dia menikah?
Dialogue: 0,0:55:35.57,0:55:36.69,teks umum,,0,0,0,,Maukah kamu tinggal bersamanya?
Dialog: 0,0:55:37.36,0:55:38.65,teks umum,,0,0,0,,Saya tidak akan tinggal
Dialog: 0,0:55:39.28,0:55:41.95,teks umum,,0,0,0,,Mengapa? Apakah dia menyerah padamu?
Dialog: 0,0:55:44.37,0:55:47.24,teks umum,,0,0,0,,Dan kamu siap minum air dari pispot demi dia
Dialog: 0,0:55:47.33,0:55:49.00,miring,,0,0,0,,Dia tidak punya kesetiaan,
Dialog: 0,0:55:49.08,0:55:50.41,teks umum,,0,0,0,,tanpa martabat
Dialog: 0,0:55:51.62,0:55:55.84,teks umum,,0,0,0,,Ada sesuatu, Yang Mulia
Dialog: 0,0:55:55.92,0:55:58.34,teks umum,,0,0,0,,Apakah kamu melindunginya? Dan biasanya dia mengatakan hal-hal buruk
Dialog: 0,0:55:58.42,0:56:00.22,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:56:01.17,0:56:03.47,teks umum,,0,0,0,,Kamu akan senang mendengar hal-hal buruk tentang dia,
Dialog: 0,0:56:04.30,0:56:08.06,teks umum,,0,0,0,,tapi sekarang aku tidak mempunyai kekuatan untuk berbicara
Dialog: 0,0:56:09.60,0:56:12.23,teks umum,,0,0,0,,Kamu adalah anjing kampung kotor yang akan ditinggalkan oleh pemilikmu
Dialog: 0,0:56:23.57,0:56:24.61,teks umum,,0,0,0,,Apakah kamu ingin aku membawanya ke kamu?
Dialog: 0,0:56:26.74,0:56:27.99,teks umum,,0,0,0,,saya bisa
Dialog: 0,0:56:28.58,0:56:30.87,teks umum,,0,0,0,,Anda juga akan menemukan pekerjaan di sini
Dialog: 0,0:56:32.21,0:56:33.08,teks umum,,0,0,0,,Saya tidak mau
Dialog: 0,0:56:34.50,0:56:37.38,teks umum,,0,0,0,,Biarkan aku menjadi Won Mu Deok, yang dihindari semua orang,
Dialog: 0,0:56:37.96,0:56:40.76,teks umum,,0,0,0,,tapi saya tidak melayani semua orang
Dialog: 0,0:56:44.26,0:56:46.89,teks umum,,0,0,0,,Lupakan. Kamu juga tidak menyerah padaku
Dialog: 0,0:56:47.51,0:56:49.56,miring,,0,0,0,,- Anda boleh pergi\N-{\i0} Ya
Dialog: 0,0:56:55.10,0:56:56.65,teks umum,,0,0,0,,Kalau begitu aku pergi,
Dialog: 0,0:56:57.23,0:56:58.48,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:57:08.03,0:57:09.41,teks umum,,0,0,0,,"Kepada semua orang"?
Dialog: 0,0:57:10.74,0:57:12.04,teks umum,,0,0,0,,Saya seorang pangeran
Dialog: 0,0:57:12.12,0:57:14.12,teks umum,,0,0,0,,Won Moo Deok tidak mengerti,
Dialog: 0,0:57:14.21,0:57:15.75,teks umum,,0,0,0,,dengan siapa dia berbicara
Dialog: 0,0:57:33.23,0:57:35.98,teks umum,,0,0,0,,- Hati-hati. Jangan terburu-buru\N- Ya, Nyonya
Dialog: 0,0:57:38.11,0:57:38.94,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:57:40.36,0:57:41.23,teks umum,,0,0,0,,Apa kabar?
Dialog: 0,0:57:42.48,0:57:43.57,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:57:44.19,0:57:45.70,teks umum,,0,0,0,,Sayangku!
Dialog: 0,0:57:47.70,0:57:49.57,teks umum,,0,0,0,,- Tuan Muda!\N- Apakah Anda khawatir?
Dialog: 0,0:57:49.66,0:57:50.87,teks umum,,0,0,0,,Apakah kamu makan dengan baik?
Dialog: 0,0:57:50.95,0:57:52.58,teks umum,,0,0,0,,Ya, bagus
Dialog: 0,0:57:52.66,0:57:54.12,teks umum,,0,0,0,,Betapa bahagianya
Dialogue: 0,0:57:54.20,0:57:55.71,teks umum,,0,0,0,,Kulitmu bersinar
Dialog: 0,0:57:55.79,0:57:56.92,teks umum,,0,0,0,,Apa yang kamu bicarakan!
Dialog: 0,0:57:57.00,0:57:58.29,teks umum,,0,0,0,,Ayo masuk ke dalam
Dialog: 0,0:58:01.96,0:58:03.80,teks umum,,0,0,0,,Dia mencoba menjualnya
Dialog: 0,0:58:06.47,0:58:07.84,teks umum,,0,0,0,,jimat dari Sosnovy Bor?
Dialog: 0,0:58:15.77,0:58:17.85,teks umum,,0,0,0,,Itu bukan aku. Itu semua Moo Deok
Dialog: 0,0:58:18.65,0:58:20.86,teks umum,,0,0,0,,Moo Dok mencoba menjual jimat Wook?
Dialog: 0,0:58:20.94,0:58:23.19,teks umum,,0,0,0,,Saya baru saja memperkenalkannya kepada penjual
Dialog: 0,0:58:23.28,0:58:25.28,teks umum,,0,0,0,,Pada akhirnya, Ah Hyang mencurinya
Dialog: 0,0:58:25.36,0:58:27.32,teks umum,,0,0,0,,Jadi Moo Deok dan aku tidak ada hubungannya dengan itu
Dialog: 0,0:58:45.05,0:58:46.34,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:58:47.72,0:58:49.97,teks umum,,0,0,0,,Kenapa dia berpakaian seperti itu?
Dialog: 0,0:58:50.72,0:58:52.43,teks umum,,0,0,0,,Cerita panjang
Dialogue: 0,0:58:52.51,0:58:55.27,teks umum,,0,0,0,,Apakah kamu sudah kembali ke Chwisong-ra?
Dialogue: 0,0:58:56.14,0:58:58.39,teks umum,,0,0,0,,Apakah Uk menjualmu kembali karena dia akan menikah?
Dialog: 0,0:58:58.48,0:58:59.77,teks umum,,0,0,0,,Tidak
Dialog: 0,0:58:59.85,0:59:03.77,teks umum,,0,0,0,,Kalaupun laku, aku tidak akan kembali ke sini
Dialog: 0,0:59:03.86,0:59:05.86,teks umum,,0,0,0,,Joo Wol akhirnya menyerah dan memberitahuku,
Dialog: 0,0:59:05.94,0:59:07.65,teks umum,,0,0,0,,bahwa kamu mencoba menjual jimat Uka
Dialog: 0,0:59:10.99,0:59:12.82,teks umum,,0,0,0,,Ya, saya mencoba
Dialog: 0,0:59:13.70,0:59:14.62,teks umum,,0,0,0,,Mengapa?
Dialog: 0,0:59:15.74,0:59:17.50,teks umum,,0,0,0,,Karena aku butuh uang
Dialog: 0,0:59:17.58,0:59:20.29,teks umum,,0,0,0,,Aku ingin memakai sutra, makan yang manis-manis,
Dialog: 0,0:59:20.37,0:59:22.88,teks umum,,0,0,0,,dan bersenang-senang di tempat seperti itu
Dialog: 0,0:59:22.96,0:59:26.46,teks umum,,0,0,0,,Itulah sebabnya kamu mabuk terakhir kali
Dialog: 0,0:59:27.38,0:59:30.63,teks umum,,0,0,0,,Ya. Saya mencuri uang pemilik saya dan mabuk
Dialog: 0,0:59:35.22,0:59:37.27,teks umum,,0,0,0,,Saya benar-benar bingung
Dialog: 0,0:59:38.98,0:59:41.48,teks umum,,0,0,0,,Aku hanya tidak memahamimu
Dialog: 0,0:59:44.90,0:59:47.19,teks umum,,0,0,0,,Dan kamu tidak memerlukannya
Dialog: 0,0:59:47.28,0:59:49.07,teks umum,,0,0,0,,Biarkan semuanya apa adanya
Dialog: 0,0:59:51.15,0:59:52.78,teks umum,,0,0,0,,Saya masuk
Dialog: 0,0:59:52.86,0:59:54.53,teks umum,,0,0,0,,Mau bergabung denganku?
Dialog: 0,0:59:55.33,0:59:56.24,teks umum,,0,0,0,,Tidak
Dialog: 0,0:59:57.49,0:59:58.62,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,1:00:11.80,1:00:13.26,teks umum,,0,0,0,,Jimat...
Dialog: 0,1:00:14.64,1:00:17.81,teks umum,,0,0,0,,Jadi itu kamu, Nak Su
Dialog: 0,1:00:27.94,1:00:29.07,teks umum,,0,0,0,,Mr.
Dialog: 0,1:00:30.86,1:00:32.86,teks umum,,0,0,0,,kenapa kamu tidak ingin menikah?
Dialog: 0,1:00:34.70,1:00:36.24,teks umum,,0,0,0,,Kamu tidak suka Bu Jin?
Dialog: 0,1:00:36.32,1:00:38.66,teks umum,,0,0,0,,Bukannya aku tidak menyukainya
Dialog: 0,1:00:39.70,1:00:41.58,teks umum,,0,0,0,,Saya hanya tidak tertarik
Dialog: 0,1:00:42.21,1:00:44.33,teks umum,,0,0,0,,Apakah kamu menyukai orang lain?
Dialog: 0,1:00:45.71,1:00:46.92,teks umum,,0,0,0,,Siapa?
Dialog: 0,1:00:47.50,1:00:49.00,teks umum,,0,0,0,,Apakah aku mengenalnya?
Dialog: 0,1:00:50.01,1:00:52.05,teks umum,,0,0,0,,Tidak, kamu tidak mengenalnya
Dialog: 0,1:00:52.63,1:00:53.84,teks umum,,0,0,0,,Jadi ada seseorang
Dialog: 0,1:00:53.93,1:00:55.18,teks umum,,0,0,0,,Aku mengetahuinya
Dialog: 0,1:00:55.26,1:00:56.30,teks umum,,0,0,0,,Siapa dia?
Dialog: 0,1:00:57.85,1:00:58.89,teks umum,,0,0,0,,Yah...
Dialog: 0,1:00:58.97,1:01:01.89,teks umum,,0,0,0,,Dia seperti telur yang kesepian di sarang, bukan di puncak pohon
Dialog: 0,1:01:02.52,1:01:06.06,teks umum,,0,0,0,,Dia tidak punya siapa-siapa selain aku, jadi bagaimana aku bisa menikah dengan orang lain?
Dialog: 0,1:01:06.15,1:01:09.07,teks umum,,0,0,0,,Gadis-gadis seperti itu yang paling berbahaya!
Dialog: 0,1:01:09.15,1:01:11.40,teks umum,,0,0,0,,Mereka tidak punya apa-apa untuk dibanggakan, tapi mereka akan melekat erat!
Dialog: 0,1:01:11.48,1:01:12.99,teks umum,,0,0,0,,Dia tidak seperti itu
Dialog: 0,1:01:13.07,1:01:15.53,teks umum,,0,0,0,,Siapa dia? Bicaralah
Dialog: 0,1:01:15.61,1:01:16.91,teks umum,,0,0,0,,Aku akan menjaganya
Dialog: 0,1:01:16.99,1:01:18.16,teks umum,,0,0,0,,Bagaimana tepatnya?
Dialog: 0,1:01:18.24,1:01:20.70,teks umum,,0,0,0,,Aku akan memberinya sekantong uang,
Dialog: 0,1:01:20.79,1:01:23.37,teks umum,,0,0,0,,dia akan menetas dari telur dan terbang menjauh
Dialog: 0,1:01:23.46,1:01:26.88,teks umum,,0,0,0,,Dia tidak bisa terbang, tidak sesederhana itu
Dialog: 0,1:01:28.17,1:01:30.30,teks umum,,0,0,0,,Bagaimanapun, saya tidak bisa menikah
Dialog: 0,1:01:30.38,1:01:31.59,teks umum,,0,0,0,,Atasi
Dialog: 0,1:01:32.55,1:01:34.72,teks umum,,0,0,0,,Cari tahu saja. Bagus?
Dialog: 0,1:01:35.51,1:01:36.84,teks umum,,0,0,0,,Mr.
Dialog: 0,1:01:39.35,1:01:42.06,teks umum,,0,0,0,,Apa itu? Apakah kamu terluka?
Dialog: 0,1:01:42.14,1:01:43.39,teks umum,,0,0,0,,Tampilkan
Dialog: 0,1:01:45.56,1:01:47.48,teks umum,,0,0,0,,Ada apa dengan tangan?
Dialog: 0,1:01:49.27,1:01:50.94,teks umum,,0,0,0,,Tidak terkendali lagi?
Dialog: 0,1:01:58.16,1:01:59.78,teks umum,,0,0,0,,Jual gaun ini
Dialog: 0,1:01:59.87,1:02:03.50,teks umum,,0,0,0,,- Ini sutra, jual dengan harga lebih tinggi\N- Bagus
Dialog: 0,1:02:04.08,1:02:06.54,teks umum,,0,0,0,,Wanita itu sekarang kedatangan tamu
Dialog: 0,1:02:06.62,1:02:08.33,teks umum,,0,0,0,,Nona Muda Jin dari Jinyeowon ada di sini
Dialog: 0,1:02:09.08,1:02:12.63,miring,,0,0,0,,Dia mencari master yang akan membuatkan cincin kawin untuknya
Dialog: 0,1:02:12.71,1:02:14.55,teks umum,,0,0,0,,Dia menikah dengan penyihir dari Sosnovy Bor
Dialog: 0,1:02:18.51,1:02:20.76,teks umum,,0,0,0,,Bagaimana kamu menyukai cincin ini?
Dialog: 0,1:02:23.77,1:02:27.48,teks umum,,0,0,0,,Inilah karya pengrajin terbaik dari Deho
Dialog: 0,1:02:29.27,1:02:32.15,teks umum,,0,0,0,,Cantik, tapi sedikit hambar
Dialogue: 0,1:02:33.78,1:02:36.03,teks umum,,0,0,0,,Bolehkah aku melihat batu giok yin-yang?
Dialog: 0,1:02:36.11,1:02:38.78,teks umum,,0,0,0,,Setelah melihatnya sendiri, saya dapat memilih opsi yang lebih baik
Dialog: 0,1:02:43.62,1:02:45.62,teks umum,,0,0,0,,Mereka bilang kalau sepasang kekasih memakai cincin giok,
Dialog: 0,1:02:45.70,1:02:48.21,teks umum,,0,0,0,,cinta mereka semakin kuat
Dialog: 0,1:03:02.43,1:03:04.14,di balik layar,,0,0,0,,Mengapa gioknya retak?
Dialog: 0,1:03:04.97,1:03:07.35, sulih suara,,0,0,0,,Saat saya mengambilnya, semuanya baik-baik saja
Dialogue: 0,1:03:13.15,1:03:15.86,sulih suara,,0,0,0,,Apakah dia mogok saat itu?
Dialog: 0,1:03:18.86,1:03:19.95,miring,,0,0,0,,Moo Dok
Dialog: 0,1:03:26.62,1:03:27.87,miring,,0,0,0,,Ms.
Dialog: 0,1:03:28.46,1:03:30.75,teks umum,,0,0,0,,Kenapa kamu pergi tiba-tiba?
Dialog: 0,1:03:30.83,1:03:33.92,teks umum,,0,0,0,,Apakah ini Moo Dok? Inggris juga ada di sini?
Dialog: 0,1:03:34.00,1:03:35.21,teks umum,,0,0,0,,Tidak
Dialog: 0,1:03:36.55,1:03:39.17,teks umum,,0,0,0,,- Begitukah?\N- Dia mengikutinya dengan ekornya,
Dialog: 0,1:03:39.26,1:03:41.05,teks umum,,0,0,0,,dia pasti ada di suatu tempat di kota
Dialog: 0,1:03:41.13,1:03:42.93,teks umum,,0,0,0,,Berjalan dengan ekornya?
Dialog: 0,1:03:43.01,1:03:44.72,teks umum,,0,0,0,,Dia adalah pelayannya!
Dialog: 0,1:03:45.85,1:03:47.27,teks umum,,0,0,0,,Perhatikan bahasamu
Dialog: 0,1:03:48.73,1:03:52.31,teks umum,,0,0,0,,Moo Dok bukan sekedar pelayan baginya
Dialogue: 0,1:03:53.48,1:03:56.94,teks umum,,0,0,0,,Moo Dok baru-baru ini mabuk, dan dia datang menjemputnya
Dialog: 0,1:03:57.61,1:03:59.40,miring,,0,0,0,,Dia menyayanginya
Dialog: 0,1:03:59.49,1:04:01.99,teks umum,,0,0,0,,Aku hanya membawanya di punggungku
Dialog: 0,1:04:02.66,1:04:03.57,miring,,0,0,0,,Tentu saja
Dialog: 0,1:04:03.66,1:04:07.37,teks umum,,0,0,0,,mengambilnya dari sini karena saya menyukainya
Dialog: 0,1:04:07.91,1:04:11.21,teks umum,,0,0,0,,Mu Dok dari sini? Apakah dia seorang gisaeng?
Dialog: 0,1:04:11.29,1:04:12.75,teks umum,,0,0,0,,Dia gadis malang
Dialogue: 0,1:04:13.42,1:04:16.71,teks umum,,0,0,0,,Pantas saja dia begitu meributkan dirinya
Dialog: 0,1:04:31.06,1:04:32.10,teks umum,,0,0,0,,Hei
Dialog: 0,1:04:32.73,1:04:34.52,teks umum,,0,0,0,,Kamu tahu siapa aku kan?
Dialog: 0,1:04:35.90,1:04:38.02,teks umum,,0,0,0,,Tentu saja
Dialog: 0,1:04:38.11,1:04:40.57,teks umum,,0,0,0,,Kamu adalah Nona Jin muda dari Jinyeowon
Dialog: 0,1:04:42.57,1:04:45.70,teks umum,,0,0,0,,Sebentar lagi kau akan memanggilku nyonya
Dialog: 0,1:04:46.91,1:04:50.58,teks umum,,0,0,0,,Karena aku dan Uk akan menikah
Dialog: 0,1:04:52.12,1:04:54.83,teks umum,,0,0,0,,Selamat
Dialog: 0,1:04:54.92,1:04:58.13,teks umum,,0,0,0,,Aku akan menjadi istrinya, dan kamu akan menjadi pembantuku
Dialog: 0,1:04:59.55,1:05:01.09,teks umum,,0,0,0,,Lakukan sesuatu sekarang juga
Dialog: 0,1:05:03.34,1:05:05.05,teks umum,,0,0,0,,Ambil kotaknya
Dialog: 0,1:05:06.09,1:05:07.72,teks umum,,0,0,0,,Apa ini?
Dialog: 0,1:05:14.56,1:05:15.85,di belakang layar,,0,0,0,,Ada apa?
Dialog: 0,1:05:17.02,1:05:18.69,di belakang layar,,0,0,0,,Batu pecah
Dialog: 0,1:05:21.28,1:05:23.70,teks umum,,0,0,0,,Ini adalah hal yang berharga
Dialog: 0,1:05:23.78,1:05:25.91,teks umum,,0,0,0,,Jika rusak,
Dialog: 0,1:05:25.99,1:05:28.03,teks umum,,0,0,0,,kamu yang harus disalahkan
Dialog: 0,1:05:29.16,1:05:31.83, sulih suara,,0,0,0,,Kamu bilang ini saat dia sudah patah
Dialog: 0,1:05:32.75,1:05:33.79,teks umum,,0,0,0,,Ambil dan ikuti aku
Dialog: 0,1:05:35.04,1:05:36.17,teks umum,,0,0,0,,Ms.
Dialog: 0,1:05:36.92,1:05:38.75,teks umum,,0,0,0,,Selagi aku tidak melayanimu
Dialog: 0,1:05:39.38,1:05:42.09,teks umum,,0,0,0,,Sudah waktunya aku menemui tuanku. Selamat tinggal
Dialog: 0,1:05:46.38,1:05:48.93,teks umum,,0,0,0,,Apakah dia meremehkanku?
Dialog: 0,1:05:56.69,1:05:59.23,teks umum,,0,0,0,,Saya tidak membayangkannya?
Dialog: 0,1:06:09.82,1:06:12.20,di belakang layar,,0,0,0,,Lebih baik aku tidak berpapasan dengannya
Dialog: 0,1:06:14.33,1:06:16.37,teks umum,,0,0,0,,Hei! Anda!
Dialog: 0,1:06:18.46,1:06:19.38,di belakang layar,,0,0,0,,Pria berbahaya
Dialog: 0,1:06:21.21,1:06:22.67,di belakang layar,,0,0,0,,atau apakah ini bocah keji?
Dialog: 0,1:06:24.26,1:06:25.34,teks umum,,0,0,0,,Nyonya
Dialog: 0,1:06:26.13,1:06:28.51,teks umum,,0,0,0,,Berikan padaku. aku akan membawanya
Dialog: 0,1:06:31.72,1:06:32.85,teks umum,,0,0,0,,Oke
Dialog: 0,1:06:32.93,1:06:35.48,teks umum,,0,0,0,,Hati-hati
Dialog: 0,1:06:40.06,1:06:41.56,di luar layar,,0,0,0,,Ya sudah rusak
Dialogue: 0,1:06:42.15,1:06:44.36,sulih suara,,0,0,0,,Dia ingin menyalahkanku dalam hal ini?
Dialog: 0,1:07:13.26,1:07:15.26,sulih suara,,0,0,0,,Jadi ini berarti keluarga Jin tinggal di sini?
Dialog: 0,1:07:48.05,1:07:49.51,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:08:01.77,1:08:02.81,teks umum,,0,0,0,,Ibu
Dialog: 0,1:08:24.50,1:08:26.13,miring,,0,0,0,,Kamu tidak bisa pergi begitu saja
Dialog: 0,1:08:27.42,1:08:30.80,teks umum,,0,0,0,,Bersumpahlah di depan potret mendiang ibumu bahwa kamu akan menikah
Dialog: 0,1:08:30.88,1:08:33.43,teks umum,,0,0,0,,Inilah satu-satunya cara untuk melindungi status ayahmu
Dialog: 0,1:08:35.85,1:08:37.18,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,1:08:37.26,1:08:38.47,teks umum,,0,0,0,,Menurutmu...
Dialog: 0,1:08:39.52,1:08:41.64,teks umum,,0,0,0,,bahwa dia adalah ayahku?
Dialog: 0,1:08:45.19,1:08:46.56,teks umum,,0,0,0,,Kau tahu...
Dialog: 0,1:08:47.86,1:08:49.53,teks umum,,0,0,0,,siapa ayah kandungku?
Dialog: 0,1:08:51.19,1:08:52.86,teks umum,,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:08:53.78,1:08:55.99,teks umum,,0,0,0,,Kamu adalah putra Gwangju Chang Gang
Dialog: 0,1:08:57.91,1:09:00.12,teks umum,,0,0,0,,Ya, itulah yang aku yakini sepanjang hidupku
Dialog: 0,1:09:00.20,1:09:02.04,miring,,0,0,0,,Aku tidak ingin menyangkalnya sekarang
Dialog: 0,1:09:02.12,1:09:03.08,miring,,0,0,0,,Jadi...
Dialog: 0,1:09:05.17,1:09:07.17,teks umum,,0,0,0,,Saya tidak akan duduk diam
Dialog: 0,1:09:08.63,1:09:10.00,teks umum,,0,0,0,,Jangan hentikan aku,
Dialog: 0,1:09:11.13,1:09:12.47,teks umum,,0,0,0,,apapun yang kulakukan
Dialog: 0,1:09:20.47,1:09:23.60,teks umum,,0,0,0,,Maiden Kim, keluarga Jin mengirim sesuatu
Dialog: 0,1:09:24.19,1:09:26.52,teks umum,,0,0,0,,Dari Jinyeowon? Ada apa?
Dialog: 0,1:09:26.60,1:09:28.06,teks umum,,0,0,0,,Sesuatu terjadi disana
Dialog: 0,1:09:28.94,1:09:32.03,teks umum,,0,0,0,,Mereka ingin Tuan Muda Chan bergegas menemui mereka
Dialog: 0,1:10:12.90,1:10:14.19,teks umum,,0,0,0,,Apakah kamu mencariku?
Dialog: 0,1:10:14.28,1:10:15.57,teks umum,,0,0,0,,Apa maksudnya semua ini?
Dialog: 0,1:10:16.15,1:10:18.87,teks umum,,0,0,0,,Pusaka keluarga kita telah hilang
Dialog: 0,1:10:19.66,1:10:20.78,teks umum,,0,0,0,,Dan pelayan...
Dialog: 0,1:10:22.12,1:10:24.25,teks umum,,0,0,0,,menghilang bersamanya
Dialog: 0,1:10:31.59,1:10:34.34, sulih suara,,0,0,0,,Itulah dia, Jinyoewon
Dialog: 0,1:10:42.81,1:10:43.89,teks umum,,0,0,0,,Hei
Dialog: 0,1:10:51.15,1:10:52.65,teks umum,,0,0,0,,Jadi itu kamu
Dialog: 0,1:10:56.78,1:10:58.36,teks umum,,0,0,0,,Lama tidak bertemu
Dialog: 0,1:11:28.64,1:11:29.94,miring,,0,0,0,,Kamu bilang Mu Dok...
Dialog: 0,1:11:30.81,1:11:33.48,teks umum,,0,0,0,,- hilang di sini?\N- Ya
Dialog: 0,1:11:34.07,1:11:35.48,teks umum,,0,0,0,,Pembantumu, Moo Deok,
Dialog: 0,1:11:36.19,1:11:38.61,teks umum,,0,0,0,,mencuri giok yin-yang dan melarikan diri
Dialog: 0,1:12:10.81,1:12:13.10,pratinjau,,0,0,0,,Anda memikirkan saya, Yang Mulia,
Dialog: 0,1:12:13.19,1:12:14.65,pratinjau,,0,0,0,,makanya aku datang
Dialog: 0,1:12:14.73,1:12:17.36,pratinjau,,0,0,0,,Kamu ketinggalan yang kamu temui di Danhyangok
Dialog: 0,1:12:17.44,1:12:18.78,pratinjau,,0,0,0,,Apakah aku merindukanmu?
Dialog: 0,1:12:18.86,1:12:20.11,pratinjau,,0,0,0,,Tidak ada hal seperti itu
Dialog: 0,1:12:20.19,1:12:21.45,pratinjau,,0,0,0,,Buka pintunya
Dialog: 0,1:12:21.53,1:12:24.49,pratinjau,,0,0,0,,Buka pintu ke Jinyeowon, tempat relik disimpan
Dialog: 0,1:12:24.57,1:12:26.66,pratinjau,,0,0,0,,Anda mungkin kerasukan sihir dan tidak dapat kembali
Dialog: 0,1:12:26.74,1:12:28.49,pratinjau,,0,0,0,,Kamu terlalu takut untuk menyentuhnya
Dialog: 0,1:12:30.00,1:12:31.25,pratinjau,,0,0,0,,Apa itu tadi?
Dialog: 0,1:12:31.33,1:12:32.92,pratinjau,,0,0,0,,Bawakan Chan Wook
Dialog: 0,1:12:33.00,1:12:35.08,pratinjau,,0,0,0,,Aku harus menyerahkanmu untuk hidup
Dialog: 0,1:12:35.17,1:12:36.13,pratinjau,,0,0,0,,Begini seharusnya
Dialog: 0,1:12:37.34,1:12:39.88,pratinjau,,0,0,0,,Jadi Moo Deok adalah Nak Soo
Dialog: 0,1:12:43.01,1:12:45.26,pratinjau,,0,0,0,,Bertarung seolah hidupmu bergantung padanya
Dialog: 0,0:20:53.07,0:20:55.07,teks umum,,0,0,0,,

