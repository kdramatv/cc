Dialogue: 0,0:02:47.14,0:02:52.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee، تومو
Dialogue: 0,0:01:15.77,0:01:19.11,نص عام,,0,0,0,,سمعت أنك ذهبت للصيد مع المملكة المتحدة
Dialogue: 0,0:01:20.15,0:01:23.40,نص عام,,0,0,0,,نعم. من الممل الصيد بمفردك
Dialogue: 0,0:01:24.15,0:01:25.95,نص عام,,0,0,0,,قلت ذات مرة،
Dialogue: 0,0:01:26.03,0:01:29.45,general text,,0,0,0,,أن تشان ووك له نفس مصير المعلم سيو كيونغ.
Dialogue: 0,0:01:29.54,0:01:33.00,النص العام,,0,0,0,,فأنت تدعمه وتساعده؟
Dialogue: 0,0:01:33.50,0:01:36.42,نص عام,,0,0,0,,لست الوحيد الذي يساعده
Dialogue: 0,0:01:38.71,0:01:40.96,النص العام,,0,0,0,,هل يوجهه أحد آخر؟
Dialogue: 0,0:01:41.92,0:01:43.42,نص عام,,0,0,0,,من؟
Dialogue: 0,0:01:44.17,0:01:45.84,نص عام,,0,0,0,,هل تعرف هذا الشخص؟
Dialogue: 0,0:01:52.52,0:01:56.15,نص عام,,0,0,0,,لا أحد يعلم أوكا إلقاء التعويذات
Dialogue: 0,0:01:56.65,0:01:57.65,نص عام,,0,0,0,,أنا متأكد
Dialogue: 0,0:01:58.23,0:02:00.94,نص عام,,0,0,0,,هذا ما أكدته خادمته
Dialogue: 0,0:02:01.69,0:02:05.82,general text,,0,0,0,,فهو نفسه وصل إلى هذه المرتفعات؟
Dialogue: 0,0:02:05.90,0:02:07.87,النص العام,,0,0,0,,ربما أصبح ساحر جيونجينغاك
Dialogue: 0,0:02:07.95,0:02:10.33,نص عام,,0,0,0,,بفضل الحيل والحظ
Dialogue: 0,0:02:10.41,0:02:11.91,نص عام,,0,0,0,,لكنه لا يملك أي مهارات
Dialogue: 0,0:02:11.99,0:02:14.79,نص عام,,0,0,0,,أنا متأكد من أنك سمعت عن جدالنا
Dialogue: 0,0:02:16.17,0:02:17.50,نص عام,,0,0,0,,بقيت معركة واحدة
Dialogue: 0,0:02:19.21,0:02:20.25,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:02:20.34,0:02:23.88,النص العام,,0,0,0,,كان المعلم سيمنع إذلاله
Dialogue: 0,0:02:24.55,0:02:27.09,general text,,0,0,0,,بعد قراءة "كلمات من القلب" نال الاحترام
Dialogue: 0,0:02:27.18,0:02:29.18,general text,,0,0,0,,وحجتنا أذلته
Dialogue: 0,0:02:29.26,0:02:32.77,النص العام,,0,0,0,,يواصل القتال بعناد
Dialogue: 0,0:02:32.85,0:02:34.43,نص عام,,0,0,0,,إذًا هذا هو
Dialogue: 0,0:02:35.56,0:02:38.31,نص عام,,0,0,0,,يعني له الكثير
Dialogue: 0,0:02:41.69,0:02:43.44,ذكريات,,0,0,0,,هل أنت بخير؟ هل تستطيع أن ترى؟
Dialogue: 0,0:02:43.53,0:02:45.40,ذكريات,,0,0,0,,نعم. وأنت يا سيد؟
Dialogue: 0,0:02:45.49,0:02:47.57,ذكريات,,0,0,0,,لم تتأذى؟
Dialogue: 0,0:02:49.20,0:02:50.28,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:02:51.95,0:02:55.20,general text,,0,0,0,,لم أفكر أبدًا في مدى أهمية اليشم بالنسبة له
Dialogue: 0,0:02:59.50,0:03:01.04,نص عام,,0,0,0,,بمجرد عودة المملكة المتحدة،
Dialogue: 0,0:03:01.71,0:03:03.96,نص عام,,0,0,0,,بوم يريد القتال
Dialogue: 0,0:03:04.05,0:03:05.42,نص عام,,0,0,0,,هل يصطاد السمك؟
Dialogue: 0,0:03:06.30,0:03:08.51,general text,,0,0,0,,ومو دوك يغض الطرف عن هذا؟
Dialogue: 0,0:03:09.64,0:03:11.14,نص عام,,0,0,0,,من غير المرجح أن تكون سعيدة بهذا الأمر
Dialogue: 0,0:03:11.22,0:03:14.72,general text,,0,0,0,,لذلك لاحظت أيضًا أن المملكة المتحدة تستمع إليها
Dialogue: 0,0:03:14.81,0:03:18.77,general text,,0,0,0,,عنيد مهما قال له أحد
Dialogue: 0,0:03:18.85,0:03:20.81,النص العام,,0,0,0,,لكنه يستمع دائمًا إلى مو ديوك
Dialogue: 0,0:03:23.86,0:03:26.61,الذكريات,,0,0,0,,يمكننا حماية الوحوش من هذا العالم
Dialogue: 0,0:03:28.45,0:03:30.41,خارج الإطار,,0,0,0,,كان يتحدث عن ناك سو حينها
Dialogue: 0,0:03:32.95,0:03:37.37,التعليق الصوتي,,0,0,0,,إذا كان يبحث عن حجر ليحميها...
Dialogue: 0,0:03:39.92,0:03:42.38,النص العام,,0,0,0,,- لا يمكن أن يكونا معًا\N- ماذا؟
Dialogue: 0,0:03:43.67,0:03:44.71,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:03:44.80,0:03:47.46,نص عام,,0,0,0,,ألا يعجبك أنهما قريبان؟
Dialogue: 0,0:03:49.84,0:03:50.84,نص عام,,0,0,0,,ليس هذا هو الهدف
Dialogue: 0,0:03:51.34,0:03:54.72,نص عام,,0,0,0,,إذا اختاروا الطريق الخطأ،
Dialogue: 0,0:03:56.93,0:03:59.39,نص عام,,0,0,0,,لا أستطيع المساعدة
Dialogue: 0,0:04:08.36,0:04:14.45,خط مائل,,0,0,0,,يمكن للمملكة المتحدة أن تجلب الفوضى إلى هذا العالم
Dialogue: 0,0:04:15.58,0:04:19.46,general text,,0,0,0,,فجأة دعمنا سيجعل الأمر خارج نطاق السيطرة،
Dialogue: 0,0:04:19.54,0:04:22.00,نص عام,,0,0,0,,وبعد ذلك سوف يلفت الانتباه؟
Dialogue: 0,0:04:22.08,0:04:25.42,النص العام,,0,0,0,,أخشى أن يتعدى على العرش ويجلب
Dialogue: 0,0:04:25.50,0:04:28.59,نص عام,,0,0,0,,دمار في ديهو؟
Dialogue: 0,0:04:30.09,0:04:33.34,general text,,0,0,0,,هذا ممكن لو تبع نجم الملك
Dialogue: 0,0:04:33.93,0:04:35.89,نص عام,,0,0,0,,هذا سيوسع آفاقه
Dialogue: 0,0:04:35.97,0:04:40.52,نص عام,,0,0,0,,والرغبة في تحقيق العظمة
Dialogue: 0,0:04:42.27,0:04:43.31,نص عام,,0,0,0,,جين
Dialogue: 0,0:04:44.31,0:04:46.90,general text,,0,0,0,,كم من الوقت استغرقك لإتقان تشيسا؟
Dialogue: 0,0:04:47.73,0:04:48.69,نص عام,,0,0,0,,شيسو؟
Dialogue: 0,0:04:49.19,0:04:52.32,نص عام,,0,0,0,,لقد أتقنت ريوسو بسرعة،
Dialogue: 0,0:04:52.40,0:04:56.58,نص عام,,0,0,0,,لكن إتقان تشيسو كان أكثر صعوبة
Dialogue: 0,0:05:01.91,0:05:04.71,مائل,,0,0,0,,درست لمدة ثلاث سنوات لفهم طاقة السماء
Dialogue: 0,0:05:05.83,0:05:08.46,خط مائل,,0,0,0,,استغرق تسخير طاقة الأرض ثلاث سنوات
Dialogue: 0,0:05:09.63,0:05:14.30,خط مائل,,0,0,0,,وأربع سنوات لتشعر بالطاقة المحيطة
Dialogue: 0,0:05:16.43,0:05:20.43,مائل,,0,0,0,,طاقة السماء والأرض والماء التي تتدفق بينهما
Dialogue: 0,0:05:21.31,0:05:24.31,خط مائل,,0,0,0,,لقد أتقنت كل هذا لمدة عشر سنوات
Dialogue: 0,0:05:26.48,0:05:28.36,خط مائل,,0,0,0,,ومفهومة تشيسا
Dialogue: 0,0:05:28.44,0:05:29.53,نص عام,,0,0,0,,مثير للإعجاب
Dialogue: 0,0:05:30.61,0:05:32.32,نص عام,,0,0,0,,استغرقني 13 عامًا
Dialogue: 0,0:05:32.40,0:05:34.70,نص عام,,0,0,0,,يوم تعلمت كل شيء مرتين
Dialogue: 0,0:05:35.32,0:05:39.24,نص عام,,0,0,0,,كنت في المركز الثاني بعد تشانغ جانج
Dialogue: 0,0:05:39.74,0:05:40.91,نص عام,,0,0,0,,هذا فقط...
Dialogue: 0,0:05:48.59,0:05:52.21,نص عام,,0,0,0,,نرى الطاقة التي تتدفق بين السماء والأرض،
Dialogue: 0,0:05:52.30,0:05:55.72,نص عام,,0,0,0,,لكنه في الأساس مجرد ماء
Dialogue: 0,0:05:58.10,0:06:02.56,النص العام,,0,0,0,,نحن نحاول إتقان هذا الأمر منذ سنوات
Dialogue: 0,0:06:04.39,0:06:06.94,النص العام,,0,0,0,,ولكن هناك من يستطيع فعل ذلك منذ ولادته
Dialogue: 0,0:06:24.16,0:06:26.62,خط مائل,,0,0,0,,ببساطة أيها العباقرة
Dialogue: 0,0:06:27.50,0:06:29.71,خط مائل,,0,0,0,,لكن بقية العالم
Dialogue: 0,0:06:29.79,0:06:33.51,مائل,,0,0,0,,يعتبرهم متهورين وغير موثوقين
Dialogue: 0,0:06:33.59,0:06:36.22,خط مائل,,0,0,0,,وخطيرة في بعض الأحيان
Dialogue: 0,0:06:39.51,0:06:40.60,نص عام,,0,0,0,,ما أنا...
Dialogue: 0,0:06:41.72,0:06:43.31,نص عام,,0,0,0,,تتقن شيسو؟
Dialogue: 0,0:06:46.44,0:06:49.10,مائل,,0,0,0,,لأنهم مختلفون عن البقية
Dialogue: 0,0:06:56.82,0:06:59.07,مائل,,0,0,0,,البعض يحسدهم
Dialogue: 0,0:07:06.91,0:07:09.33,خط مائل,,0,0,0,,الآخرون يخافون منهم
Dialogue: 0,0:07:12.00,0:07:13.42,نص عام,,0,0,0,,سأفوز غدًا بالتأكيد
Dialogue: 0,0:07:16.17,0:07:17.47,نص عام,,0,0,0,,قبضت عليها
Dialogue: 0,0:07:19.84,0:07:21.01,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:07:21.68,0:07:22.76,نص عام,,0,0,0,,شان ووك
Dialogue: 0,0:07:23.85,0:07:25.06,النص العام,,0,0,0,,لقد أتقنت تشيسا
Dialogue: 0,0:07:30.31,0:07:34.90,مائل,,0,0,0,,رد فعلنا بهذه الطريقة لأننا لا نعرف كيف يستخدمون قوتهم المذهلة
Dialogue: 0,0:07:35.53,0:07:39.53,general text,,0,0,0,,هل سينقذ العالم بصفته المعلمة سو كيونغ
Dialogue: 0,0:07:39.61,0:07:42.99,النص العام,,0,0,0,,أم أنها ستدمر؟ نحن لا نعرف
Dialogue: 0,0:07:44.20,0:07:45.62,نص عام,,0,0,0,,بمعنى آخر,
Dialogue: 0,0:07:46.95,0:07:50.00,نص عام,,0,0,0,,هل تستمر في مراقبته؟
Dialogue: 0,0:07:51.83,0:07:55.13,نص عام,,0,0,0,,لا تقلق. أنا أفهم كل شيء
Dialogue: 0,0:07:57.38,0:07:59.34,النص العام,,0,0,0,,إذا كان عليك التخلص من هذه القوة،
Dialogue: 0,0:08:00.55,0:08:03.10,نص عام,,0,0,0,,سأفعل ذلك بيدي
Dialogue: 0,0:08:10.06,0:08:11.98,general text,,0,0,0,,تشان ووك، هل انتهت عقوبتك؟
Dialogue: 0,0:08:12.06,0:08:13.31,نص عام,,0,0,0,,فعدت
Dialogue: 0,0:08:13.40,0:08:14.82,general text,,0,0,0,,إذًا دمرت جيونبوغوان؟
الحوار: 0,0:08:14.90,0:08:16.15,نص عام,,0,0,0,,لا تبالغ
Dialogue: 0,0:08:17.28,0:08:20.03,نص عام,,0,0,0,,- يا\N- لقد عدت أخيراً
Dialogue: 0,0:08:20.74,0:08:23.66,النص العام,,0,0,0,,أنا خصمك الأخير
Dialogue: 0,0:08:24.32,0:08:26.66,النص العام,,0,0,0,,- أرى\N- من المؤسف أنك لن تفوز،
Dialogue: 0,0:08:27.70,0:08:31.92,نص عام,,0,0,0,,لأنني سأقاتل معك
Dialogue: 0,0:08:37.38,0:08:38.80,نص عام,,0,0,0,,لا تقلق كثيرًا
Dialogue: 0,0:08:39.46,0:08:41.88,نص عام,,0,0,0,,آمل أن تكون المعركة الأخيرة مثيرة للاهتمام
Dialogue: 0,0:08:42.72,0:08:43.80,نص عام,,0,0,0,,نعتمد عليك
Dialogue: 0,0:08:53.77,0:08:55.23,نص عام,,0,0,0,,ماذا كان ذلك؟
Dialogue: 0,0:08:55.31,0:08:57.07,نص عام,,0,0,0,,هل تعلم شيئاً جديداً؟
Dialogue: 0,0:08:57.15,0:08:59.07,نص عام,,0,0,0,,سمعت أنه كان يصطاد السمك فقط
Dialogue: 0,0:08:59.15,0:09:01.57,النص العام,,0,0,0,,لا تقلق، إنه مجرد شجاع
Dialogue: 0,0:09:02.61,0:09:06.78,نص عام,,0,0,0,,سأخزيه أمام ولي العهد
Dialogue: 0,0:09:08.83,0:09:09.95,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:09:10.75,0:09:13.54,النص العام,,0,0,0,,سيدي الغبي خسر تسع مرات،
Dialogue: 0,0:09:13.62,0:09:17.42,نص عام,,0,0,0,,بسببه فقدت تسعة ضفادع ذهبية
Dialogue: 0,0:09:18.05,0:09:20.38,نص عام,,0,0,0,,لا أجرؤ على النظر في عينيك
Dialogue: 0,0:09:22.76,0:09:24.22,نص عام,,0,0,0,,آخر معركة متبقية؟
Dialogue: 0,0:09:24.30,0:09:26.09,نص عام,,0,0,0,,لقد تدرب بجد،
Dialogue: 0,0:09:26.18,0:09:28.51,نص عام,,0,0,0,,حتى لا يخيب ظنك هذه المرة
Dialogue: 0,0:09:28.60,0:09:30.22,نص عام,,0,0,0,,حتى لا أشعر بخيبة الأمل،
Dialogue: 0,0:09:30.81,0:09:31.89,النص العام,,0,0,0,,يجب أن يخسر
Dialogue: 0,0:09:36.48,0:09:39.07,نص عام,,0,0,0,,لقد ظننتني أحمقاً
Dialogue: 0,0:09:39.15,0:09:42.19,النص العام,,0,0,0,,استخدمت ذهبي لتدريب سيدها
Dialogue: 0,0:09:43.74,0:09:45.32,نص عام,,0,0,0,,شكرًا للمبارزة
Dialogue: 0,0:09:45.41,0:09:49.24,النص العام,,0,0,0,,لقد كان من دواعي سروري مشاهدة إذلال المالك
Dialogue: 0,0:09:49.33,0:09:51.91,نص عام,,0,0,0,,أنا متأكد من أنه يستحق الذهب
Dialogue: 0,0:09:52.75,0:09:54.41,نص عام,,0,0,0,,نعم كان ممتعاً
Dialogue: 0,0:09:54.50,0:09:56.67,نص عام,,0,0,0,,أتمنى أن يخسر مرة أخرى،
Dialogue: 0,0:09:57.46,0:10:00.00,نص عام,,0,0,0,,حتى تبكي عندما تفقد اليشم الخاص بك
Dialogue: 0,0:10:00.67,0:10:02.88,general text,,0,0,0,,تشان ووك لديه النصف الآخر، أليس كذلك؟
Dialogue: 0,0:10:03.67,0:10:06.13,النص العام,,0,0,0,,أعطاك واحدة ثانية،
Dialogue: 0,0:10:06.22,0:10:08.39,نص عام,,0,0,0,,فهذا رمز الحب؟
Dialogue: 0,0:10:10.76,0:10:12.56,general text,,0,0,0,,أعطيتني لتستخدمني؟
Dialogue: 0,0:10:16.65,0:10:19.31,النص العام,,0,0,0,,إذا خسرت المملكة المتحدة,
Dialogue: 0,0:10:19.90,0:10:20.98,نص عام,,0,0,0,,سأدمر اليشم
Dialogue: 0,0:10:22.44,0:10:23.90,خط مائل,,0,0,0,,يجب أن تفقد شيئًا ما
Dialogue: 0,0:10:24.40,0:10:25.86,نص عام,,0,0,0,,يا له من عار
Dialogue: 0,0:10:25.95,0:10:28.24,النص العام,,0,0,0,,حبك الموقر سيغرق في غياهب النسيان
Dialogue: 0,0:10:33.54,0:10:34.96,نص عام,,0,0,0,,افعل ما يحلو لك
Dialogue: 0,0:10:35.91,0:10:37.33,نص عام,,0,0,0,,أكملت جايد مهمتها
Dialogue: 0,0:10:37.42,0:10:39.58,النص العام,,0,0,0,,أجبر المالك على خوض 10 معارك
Dialogue: 0,0:10:39.67,0:10:42.71,النص العام,,0,0,0,,قلت إنك ستخاطر بحياتك من أجل اليشم
Dialogue: 0,0:10:43.96,0:10:46.47,general text,,0,0,0,,إذا كان بإمكاننا المخاطرة بحياتنا من أجل مشاعرنا،
Dialogue: 0,0:10:47.88,0:10:51.22,النص العام,,0,0,0,,خسارة هذا الحجر لن تؤثر عليهم
Dialogue: 0,0:10:58.40,0:11:00.98,general text,,0,0,0,,إذن أنت لا تهتم هل ستفقده أم لا؟
Dialogue: 0,0:11:02.19,0:11:03.28,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:11:04.28,0:11:05.69,نص عام,,0,0,0,,إذن سأرميها بعيدًا
Dialogue: 0,0:11:16.16,0:11:17.75,نص عام,,0,0,0,,لذا فهو لا يعني شيئًا حقًا
Dialogue: 0,0:11:18.79,0:11:20.88,النص العام,,0,0,0,,لقد خدعتني
Dialogue: 0,0:11:20.96,0:11:23.25,نص عام,,0,0,0,,قالت هذا هو أثمن شيء
Dialogue: 0,0:11:23.34,0:11:26.17,general text,,0,0,0,,وإذا لم تقلق عليها فقد كذبت
Dialogue: 0,0:11:27.38,0:11:29.59,general text,,0,0,0,,كيف ستدفع ثمن الكذبة؟
Dialogue: 0,0:11:29.68,0:11:31.43,general text,,0,0,0,,أنت تخاطر بحياتك، أليس كذلك؟
Dialogue: 0,0:11:32.10,0:11:33.22,نص عام,,0,0,0,,ممتاز
Dialogue: 0,0:11:34.06,0:11:36.73,نص عام,,0,0,0,,أنت على المحك هذه المرة
Dialogue: 0,0:11:38.60,0:11:40.69,النص العام,,0,0,0,,لقد فقدت بالفعل تسعة ضفادع
Dialogue: 0,0:11:41.31,0:11:42.77,نص عام,,0,0,0,,لا أريد أن أخسر شخصًا آخر
Dialogue: 0,0:11:42.86,0:11:44.61,نص عام,,0,0,0,,لك الأجر
Dialogue: 0,0:11:45.90,0:11:47.19,نص عام,,0,0,0,,في هذه المعركة
Dialogue: 0,0:11:49.57,0:11:51.20,نص عام,,0,0,0,,حسب الطلب
Dialogue: 0,0:11:51.28,0:11:52.45,النص العام,,0,0,0,,إذا خسر تشانغ ووك,
Dialogue: 0,0:11:53.41,0:11:56.37,النص العام,,0,0,0,,سوف تصبحين خادمة الفائز
Dialogue: 0,0:11:57.62,0:12:00.92,نص عام,,0,0,0,,نعم، سأفكر في الأمر
Dialogue: 0,0:12:16.77,0:12:19.60,general text,,0,0,0,,إذن أنت الخصم الأخير لتشان ووك؟
Dialogue: 0,0:12:20.98,0:12:22.60,نص عام,,0,0,0,,أنا تشا بوم
Dialogue: 0,0:12:22.69,0:12:24.40,النص العام,,0,0,0,,سأنتصر مهما حدث
Dialogue: 0,0:12:25.44,0:12:27.19,نص عام,,0,0,0,,يجب عليك
Dialogue: 0,0:12:27.28,0:12:28.82,نص عام,,0,0,0,,إذا خسرت,
Dialogue: 0,0:12:28.90,0:12:31.57,general text,,0,0,0,,سأتأكد من أنك لن تنجح كساحر
Dialogue: 0,0:12:33.41,0:12:35.33,نص عام,,0,0,0,,هل يمكنك إعطاء الكلمة؟
Dialogue: 0,0:12:36.58,0:12:39.62,نص عام,,0,0,0,,هناك دائمًا احتمال...
Dialogue: 0,0:12:39.70,0:12:40.83,نص عام,,0,0,0,,كفى!
Dialogue: 0,0:12:41.96,0:12:44.25,النص العام,,0,0,0,,أحتاج إلى شخص سيفوز بالتأكيد
Dialogue: 0,0:12:44.33,0:12:45.71,نص عام,,0,0,0,,أعطني كلمتك
Dialogue: 0,0:12:45.79,0:12:48.34,النص العام,,0,0,0,,أخشى أنني لا أستطيع يا صاحب السمو
Dialogue: 0,0:12:48.42,0:12:50.09,نص عام,,0,0,0,,لا أحد سواه...
Dialogue: 0,0:12:51.93,0:12:53.47,نص عام,,0,0,0,,لن اعطي هذه الكلمة
Dialogue: 0,0:12:55.10,0:12:58.52,نص عام,,0,0,0,,بقي شخص واحد فقط،
Dialogue: 0,0:12:59.60,0:13:01.18,نص عام,,0,0,0,,من يستطيع الفوز
Dialogue: 0,0:13:01.27,0:13:02.27,نص عام,,0,0,0,,سو يول
Dialogue: 0,0:13:08.23,0:13:09.48,نص عام,,0,0,0,,إذن يول؟
Dialogue: 0,0:13:22.12,0:13:24.25,نص عام,,0,0,0,,لم يكن الخلاف جديًا
Dialogue: 0,0:13:25.08,0:13:27.09,نص عام,,0,0,0,,لكنه يضايقني
Dialogue: 0,0:13:27.17,0:13:31.67,general text,,0,0,0,,لقد فقدت تسعة ضفادع لوضع أوكا في مكانه
Dialogue: 0,0:13:32.26,0:13:35.64,نص عام,,0,0,0,,تخيل كم سأبدو مضحكاً،
Dialogue: 0,0:13:35.72,0:13:39.60,النص العام,,0,0,0,,إذا فاز في المعركة الأخيرة
Dialogue: 0,0:13:41.14,0:13:43.73,النص العام,,0,0,0,,لذا أحتاج إلى شخص سيفوز بالتأكيد
Dialogue: 0,0:13:43.81,0:13:46.48,النص العام,,0,0,0,,أنت أفضل ساحر في جيونججينجاك وابن عمي
Dialogue: 0,0:13:46.56,0:13:48.02,نص عام,,0,0,0,,أنا متأكد أنك الوحيد
Dialogue: 0,0:13:49.69,0:13:52.99,نص عام,,0,0,0,,أعلم أنك صديق له
Dialogue: 0,0:13:54.74,0:13:58.16,general text,,0,0,0,,لكن كأمير وابن عمك،
Dialogue: 0,0:13:58.91,0:14:00.49,نص عام,,0,0,0,,أطلب مساعدتكم
Dialogue: 0,0:14:04.33,0:14:05.62,نص عام,,0,0,0,,حسنًا يا صاحب السمو
Dialogue: 0,0:14:07.92,0:14:08.75,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:14:09.92,0:14:11.88,النص العام,,0,0,0,,هل ستقاتله؟
Dialogue: 0,0:14:12.46,0:14:13.67,نص عام,,0,0,0,,سأفوز
Dialogue: 0,0:14:14.38,0:14:15.84,نص عام,,0,0,0,,أنا أعطي كلمتي
Dialogue: 0,0:14:17.01,0:14:20.47,نص عام,,0,0,0,,بالضبط. من بين الجميع، أنت فقط من تستطيع ذلك
Dialogue: 0,0:14:20.56,0:14:22.93,النص العام,,0,0,0,,لقد وعد مو دوك بالخدمة حقًا
Dialogue: 0,0:14:23.02,0:14:24.85,نص عام,,0,0,0,,الفائز؟
Dialogue: 0,0:14:24.93,0:14:27.56,النص العام,,0,0,0,,نعم بدلاً من الضفادع وضعت
Dialogue: 0,0:14:32.61,0:14:34.65,نص عام,,0,0,0,,على نفسك
Dialogue: 0,0:14:34.74,0:14:36.70,general text,,0,0,0,,ثم سأهزم أوكا
Dialogue: 0,0:14:38.07,0:14:39.82,النص العام,,0,0,0,,وسأجعلها خادمتي
Dialogue: 0,0:14:44.37,0:14:45.50,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:14:46.12,0:14:48.54,general text,,0,0,0,,الخصم الأخير لتشانغ ووك، تقدم
Dialogue: 0,0:15:16.82,0:15:17.82,نص عام,,0,0,0,,تشانغ ووك,
Dialogue: 0,0:15:18.91,0:15:20.78,نص عام,,0,0,0,,أقاتلك اليوم
Dialogue: 0,0:15:21.49,0:15:22.74,نص عام,,0,0,0,,سأكون
Dialogue: 0,0:15:42.01,0:15:45.01,general text,,0,0,0,,هل يتقاتل معه يول للسماح له بالفوز؟
Dialogue: 0,0:15:45.10,0:15:46.10,خط مائل,,0,0,0,,لا
Dialogue: 0,0:15:46.18,0:15:49.27,مائل,,0,0,0,,عندما تطوع دان غو، استسلم تشانغ ووك على الفور
Dialogue: 0,0:15:49.35,0:15:50.77,مائل,,0,0,0,,لن يسمح لأوكو بالفوز
Dialogue: 0,0:15:50.85,0:15:54.40,general text,,0,0,0,,أعطى الأمير كلمته بأنه سيهزم تشان ووك
Dialogue: 0,0:15:58.65,0:15:59.90,نص عام,,0,0,0,,ابدأ
Dialogue: 0,0:16:14.92,0:16:16.21,خلف الكواليس,,0,0,0,,كان يول على حق
Dialogue: 0,0:16:16.92,0:16:19.09,النص العام,,0,0,0,,لقد تحسنت المملكة المتحدة بشكل كبير
Dialogue: 0,0:16:34.11,0:16:35.52,نص عام,,0,0,0,,هذه هي تعويذتي الوقائية
Dialogue: 0,0:16:35.61,0:16:36.73,نص عام,,0,0,0,,متى أتقنها؟
Dialogue: 0,0:16:38.57,0:16:41.32,مائل,,0,0,0,,لقد تعلم كل ما رآه في المعارك السابقة
Dialogue: 0,0:16:41.40,0:16:45.33,general text,,0,0,0,,هل أتقن تعويذات الخصوم السابقين؟
Dialogue: 0,0:16:45.41,0:16:49.16,النص العام,,0,0,0,,تعلم التعاويذ التي رآها ويكررها
Dialogue: 0,0:17:49.22,0:17:50.35,نص عام,,0,0,0,,لقد فعلها
Dialogue: 0,0:18:26.34,0:18:27.84,نص عام,,0,0,0,,لقد انتهت المعركة
Dialogue: 0,0:18:27.93,0:18:30.43,نص عام,,0,0,0,,ففاز يول
Dialogue: 0,0:18:34.56,0:18:35.69,نص عام,,0,0,0,,كنت أعرف ذلك
Dialogue: 0,0:18:37.10,0:18:39.90,general text,,0,0,0,,خسرت المملكة المتحدة جميع معاركها العشرة
Dialogue: 0,0:18:40.69,0:18:43.65,general text,,0,0,0,,كيف استخدم طنسا في النهاية؟
Dialogue: 0,0:18:43.74,0:18:46.78,italics,,0,0,0,,جمع الطاقة في الهواء وحولها إلى ماء
Dialogue: 0,0:18:46.86,0:18:47.78,نص عام,,0,0,0,,لا تكن مضحكاً
Dialogue: 0,0:18:48.70,0:18:51.41,general text,,0,0,0,,فقط من يملك Chisu يمكنه فعل هذا
Dialogue: 0,0:19:03.84,0:19:05.21,النص العام,,0,0,0,,متى أتقنت تشيسا؟
Dialogue: 0,0:19:05.80,0:19:09.51,نص عام,,0,0,0,,قلت بالأمس أنني سأخبرك بشيء مذهل
Dialogue: 0,0:19:09.59,0:19:11.05,نص عام,,0,0,0,,كان ذلك رائعًا
Dialogue: 0,0:19:11.85,0:19:13.22,نص عام,,0,0,0,,مبروك
Dialogue: 0,0:19:13.31,0:19:14.18,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:19:15.18,0:19:17.64,general text,,0,0,0,,لقد أتقنت تشيسو. تهانينا يا صديقي!
Dialogue: 0,0:19:18.65,0:19:19.60,خط مائل,,0,0,0,,هل رأيت؟
Dialogue: 0,0:19:20.23,0:19:22.94,general text,,0,0,0,,لقد أتقن تشان ووك تشيسا!
Dialogue: 0,0:19:24.28,0:19:26.03,نص عام,,0,0,0,,- حقاً؟\N- مرحبًا
Dialogue: 0,0:19:26.11,0:19:28.07,نص عام,,0,0,0,,- مبروك\N- مبروك
Dialogue: 0,0:19:28.15,0:19:30.62,خط مائل,,0,0,0,,- مذهل\N- تهانينا
Dialogue: 0,0:19:30.70,0:19:31.78,نص عام,,0,0,0,,يا
Dialogue: 0,0:19:32.95,0:19:34.45,نص عام,,0,0,0,,حان وقت سايجوكون
Dialogue: 0,0:19:43.75,0:19:46.21,النص العام,,0,0,0,,غادر مو دوك مع الأمير
Dialogue: 0,0:19:46.80,0:19:49.47,نص عام,,0,0,0,,ربما يناقش نهاية الخلاف
Dialogue: 0,0:19:49.55,0:19:52.22,general text,,0,0,0,,أنا فقط قلق من أنهم سيفعلون شيئًا كهذا مرة أخرى
Dialogue: 0,0:19:52.30,0:19:53.97,نص عام,,0,0,0,,سوف أتحقق
Dialogue: 0,0:19:54.06,0:19:57.56,نص عام,,0,0,0,,نعم. اعتني بها. أنت مالكها الآن
Dialogue: 0,0:20:01.69,0:20:04.11,نص عام,,0,0,0,,لذلك نريد من الأمير أن يفكر
Dialogue: 0,0:20:06.15,0:20:08.78,النص العام,,0,0,0,,إذا يول، اذهب إلى مو دوك
Dialogue: 0,0:20:08.86,0:20:10.61,general text,,0,0,0,,المملكة المتحدة، وأنت معي في سايجوكون
Dialogue: 0,0:20:11.32,0:20:13.32,نص عام,,0,0,0,,لنذهب. اسرع
Dialogue: 0,0:20:14.58,0:20:16.54,خط مائل,,0,0,0,,- كن حذرًا. حسنا!\N- أنه لأمر مؤلم
Dialogue: 0,0:20:16.62,0:20:18.12,خط مائل,,0,0,0,,انظر تحت قدميك
Dialogue: 0,0:20:23.25,0:20:27.42,النص العام,,0,0,0,,كما قلت خسر المالك العشر مرات كلها
Dialogue: 0,0:20:28.05,0:20:29.84,النص العام,,0,0,0,,فزت يا صاحب السمو
Dialogue: 0,0:20:30.72,0:20:34.39,general text,,0,0,0,,كنت تعلم أنه يتقن تشيسو
Dialogue: 0,0:20:35.97,0:20:38.77,نص عام,,0,0,0,,لذلك أضع نفسي على المحك بجرأة
Dialogue: 0,0:20:38.85,0:20:41.06,general text,,0,0,0,,إذا لم يرفض تشا بوم القتال،
Dialogue: 0,0:20:41.73,0:20:43.40,نص عام,,0,0,0,,المالك سيفوز
Dialogue: 0,0:20:44.81,0:20:46.48,النص العام,,0,0,0,,لم يعد سيدك
Dialogue: 0,0:20:48.36,0:20:50.36,نص عام,,0,0,0,,الآن تخدم سيو يول
Dialogue: 0,0:20:53.24,0:20:56.03,نص عام,,0,0,0,,قلت إنكما تشاطران نفس المشاعر
Dialogue: 0,0:20:57.37,0:20:58.45,نص عام,,0,0,0,,ممتاز
Dialogue: 0,0:20:59.29,0:21:01.96,النص العام,,0,0,0,,أتمنى ألا تخسرهم بينما تخدم آخر
Dialogue: 0,0:21:24.40,0:21:25.77,خط مائل,,0,0,0,,هذا مضحك
Dialogue: 0,0:21:25.86,0:21:28.15,general text,,0,0,0,,كيف يمكنه السيطرة على تشيسا بهذه السرعة؟
Dialogue: 0,0:21:28.23,0:21:30.86,نص عام,,0,0,0,,هذا صحيح. لقد رأينا كل شيء
Dialogue: 0,0:21:31.49,0:21:32.36,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:22:00.56,0:22:02.27,نص عام,,0,0,0,,يا إلهي!
Dialogue: 0,0:22:03.56,0:22:05.77,نص عام,,0,0,0,,أنت حقًا عبقري!
Dialogue: 0,0:22:05.85,0:22:07.40,نص عام,,0,0,0,,هذا صحيح، المملكة المتحدة!
Dialogue: 0,0:22:07.48,0:22:09.65,نص عام,,0,0,0,,- هذا مؤلم\N- آسف
Dialogue: 0,0:22:10.69,0:22:12.36,نص عام,,0,0,0,,سيد هوو، هذا يؤلمني
Dialogue: 0,0:22:12.94,0:22:15.20,general text,,0,0,0,,انضممت لأنك كنت قلقاً،
Dialogue: 0,0:22:15.28,0:22:17.41,نص عام,,0,0,0,,أنني سأضطر إلى خدمة تشا بوم، أليس كذلك؟
Dialogue: 0,0:22:17.49,0:22:19.83,نص عام,,0,0,0,,شكرًا على لطفك
Dialogue: 0,0:22:19.91,0:22:21.70,نص عام,,0,0,0,,الآن أنت تخدمني
Dialogue: 0,0:22:22.75,0:22:25.37,النص العام,,0,0,0,,هذا هو الوعد الذي قطعته للأمير
Dialogue: 0,0:22:26.04,0:22:27.67,نص عام,,0,0,0,,وعلي أن أتظاهر بإتباعه
Dialogue: 0,0:22:27.75,0:22:28.84,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:22:28.92,0:22:32.42,النص العام,,0,0,0,,إذا كنت بحاجة إلى أي شيء، تحدث في أي وقت
Dialogue: 0,0:22:32.51,0:22:33.67,نص عام,,0,0,0,,ليس هناك حاجة
Dialogue: 0,0:22:34.22,0:22:36.34,نص عام,,0,0,0,,يمكنك زيارة أوكا في أي وقت
Dialogue: 0,0:22:38.22,0:22:39.39,نص عام,,0,0,0,,لقد
Dialogue: 0,0:22:40.97,0:22:42.60,نص عام,,0,0,0,,طلب واحد فقط
Dialogue: 0,0:22:44.27,0:22:47.60,النص العام,,0,0,0,,عندما أنتهي من دراستي سأعود إلى سوهو
Dialogue: 0,0:22:48.56,0:22:50.61,نص عام,,0,0,0,,أريد اصطحاب شخص واحد معي
Dialogue: 0,0:22:51.52,0:22:53.48,نص عام,,0,0,0,,أرجو مساعدتي
Dialogue: 0,0:22:54.90,0:22:55.95,نص عام,,0,0,0,,افعلها
Dialogue: 0,0:22:57.78,0:23:00.24,نص عام,,0,0,0,,لم أكن أعلم أن لديك مثل هذا الشخص
Dialogue: 0,0:23:00.32,0:23:03.62,نص عام,,0,0,0,,قل كلمتك. وعد أنك سوف تساعد
Dialogue: 0,0:23:07.87,0:23:10.42,نص عام,,0,0,0,,أنت تطلب أن تكون سيدي
Dialogue: 0,0:23:11.00,0:23:13.05,نص عام,,0,0,0,,سأساعدك بالتأكيد
Dialogue: 0,0:23:24.14,0:23:27.31,النص العام,,0,0,0,,هناك الآن مبتلع روح في سايجوكون
Dialogue: 0,0:23:27.39,0:23:29.15,نص عام,,0,0,0,,ولقد أحضرت أوكا إلى هنا
Dialogue: 0,0:23:29.23,0:23:31.56,نص عام,,0,0,0,,ماذا يمكنني أن أفعل؟ لقد أصيب
Dialogue: 0,0:23:32.15,0:23:35.32,نص عام,,0,0,0,,قلت له أن يستريح لبضعة أيام
Dialogue: 0,0:23:36.61,0:23:38.65,general text,,0,0,0,,- هل إصابته خطيرة؟\N- لا
Dialogue: 0,0:23:38.74,0:23:40.16,نص عام,,0,0,0,,لا يوجد شيء جدي
Dialogue: 0,0:23:41.49,0:23:44.91,general text,,0,0,0,,كيف يمكنه قتال يول بهذا التهور
Dialogue: 0,0:23:44.99,0:23:47.54,النص العام,,0,0,0,,سأواصل الصيد مع المعلم "لي"
Dialogue: 0,0:23:47.62,0:23:49.29,النص العام,,0,0,0,,لم يكن عليك معاودة الاتصال به
Dialogue: 0,0:23:50.21,0:23:53.88,general text,,0,0,0,,لا بد أنهم فعلوا أكثر من مجرد صيد الأسماك
Dialogue: 0,0:23:55.84,0:23:59.05,general text,,0,0,0,,المملكة المتحدة، مثل هذا اللقيط، أتقن تشيسو
Dialogue: 0,0:23:59.88,0:24:00.89,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:24:02.30,0:24:03.76,نص عام,,0,0,0,,لا يصدق ، أليس كذلك؟
Dialogue: 0,0:24:03.85,0:24:05.26,خط مائل,,0,0,0,,غير مفهوم
Dialogue: 0,0:24:05.35,0:24:07.22,النص العام,,0,0,0,,إنه حقًا عبقري!
Dialogue: 0,0:24:15.11,0:24:17.53,نص عام,,0,0,0,,ماذا درست
Dialogue: 0,0:24:18.36,0:24:22.24,نص عام,,0,0,0,,أثناء الصيد
Dialogue: 0,0:24:22.32,0:24:23.95,نص عام,,0,0,0,,مع السيد لي؟
Dialogue: 0,0:24:25.62,0:24:27.50,نص عام,,0,0,0,,تعلمت صيد السمكة الذهبية
Dialogue: 0,0:24:27.58,0:24:30.92,general text,,0,0,0,,فأراد أن يساعدك في إتقان تشيسا
Dialogue: 0,0:24:31.50,0:24:34.59,general text,,0,0,0,,- هل اعتبرك تلميذاً؟{\i1}\N- ليس حقًا
Dialogue: 0,0:24:34.67,0:24:36.63,نص عام,,0,0,0,,هناك سبب لمساعدتي
Dialogue: 0,0:24:37.59,0:24:39.97,نص عام,,0,0,0,,أي واحد؟
Dialogue: 0,0:24:41.18,0:24:43.97,خط مائل,,0,0,0,,سيدتي لك
Dialogue: 0,0:24:44.72,0:24:45.89,نص عام,,0,0,0,,شيء ما...
Dialogue: 0,0:24:47.43,0:24:48.72,نص عام,,0,0,0,,أخبرني؟
Dialogue: 0,0:24:50.64,0:24:52.48,نص عام,,0,0,0,,هذا يتعلق بعائلتي
Dialogue: 0,0:24:52.56,0:24:54.98,نص عام,,0,0,0,,لاحظت ذلك بنفسي وسألته مباشرة
Dialogue: 0,0:24:59.28,0:25:02.45,نص عام,,0,0,0,,يبدو أنك تعرف هذا أيضًا
Dialogue: 0,0:25:04.99,0:25:06.20,نص عام,,0,0,0,,كنت أتمنى
Dialogue: 0,0:25:08.24,0:25:09.79,نص عام,,0,0,0,,لن تتعرف عليه
Dialogue: 0,0:25:10.71,0:25:11.96,خط مائل,,0,0,0,,لا
Dialogue: 0,0:25:12.04,0:25:15.25,نص عام,,0,0,0,,لم أستطع أن أغمض عيني عن هذا عندما اكتشفت كل شيء
Dialogue: 0,0:25:16.67,0:25:18.17,خط مائل,,0,0,0,,ماذا ستفعل الآن؟
Dialogue: 0,0:25:22.72,0:25:23.97,نص عام,,0,0,0,,مع الخادمة كيم
Dialogue: 0,0:25:32.48,0:25:33.81,نص عام,,0,0,0,,ما دخلها بالموضوع؟
Dialogue: 0,0:25:33.89,0:25:36.56,general text,,0,0,0,,يحاول السيد "لي" استمالة الخادمة "كيم"،
Dialogue: 0,0:25:36.65,0:25:38.61,نص عام,,0,0,0,,مساعدتي
Dialogue: 0,0:25:39.94,0:25:41.49,نص عام,,0,0,0,,فماذا ستفعل؟
Dialogue: 0,0:25:42.70,0:25:47.24,general text,,0,0,0,,السيد لي شخص رائع ساعدني كثيرًا
Dialogue: 0,0:25:48.87,0:25:49.70,خط مائل,,0,0,0,,لكن لا يزال
Dialogue: 0,0:25:50.70,0:25:54.12,نص عام,,0,0,0,,أعتقد أنه يجب أن أعطيك فرصة أولاً
Dialogue: 0,0:25:54.21,0:25:55.79,نص عام,,0,0,0,,إذا أخذنا علاقتنا بعين الاعتبار
Dialogue: 0,0:25:59.55,0:26:01.01,نص عام,,0,0,0,,أي فرصة؟
Dialogue: 0,0:26:02.13,0:26:05.22,general text,,0,0,0,,هل تعلم أن السيد "لي" يعيش معنا؟
Dialogue: 0,0:26:06.34,0:26:08.93,نص عام,,0,0,0,,وكنت أتساءل أين توقف
Dialogue: 0,0:26:09.01,0:26:11.22,نص عام,,0,0,0,,فعاش في منزلك
Dialogue: 0,0:26:11.31,0:26:12.31,نص عام,,0,0,0,,نعم
Dialogue: 0,0:26:12.39,0:26:15.56,general text,,0,0,0,,أنا هنا الآن، ومن المحتمل أنهم يشربون الشاي هناك، ويتحدثون
Dialogue: 0,0:26:15.64,0:26:17.73,نص عام,,0,0,0,,الخادمة كيم لطيفة جداً
Dialogue: 0,0:26:17.81,0:26:20.32,نص عام,,0,0,0,,تحب رعاية الآخرين وإطعامهم
Dialogue: 0,0:26:20.40,0:26:22.82,general text,,0,0,0,,إنها مسألة وقت قبل أن تقع في حبه.
Dialogue: 0,0:26:24.90,0:26:26.61,نص عام,,0,0,0,,آمل حقاً
Dialogue: 0,0:26:26.70,0:26:29.53,نص عام,,0,0,0,,أنها ستتزوج رجلاً صالحاً
Dialogue: 0,0:26:32.91,0:26:34.54,نص عام,,0,0,0,,إذا كنت لا تمانع،
Dialogue: 0,0:26:35.37,0:26:38.21,نص عام,,0,0,0,,أود أن أدعمهم
Dialogue: 0,0:26:51.85,0:26:54.73,النص العام,,0,0,0,,المعلمة "لي" عمرها ضعف عمرها
Dialogue: 0,0:26:55.31,0:26:58.56,النص العام,,0,0,0,,لكنه يبدو أصغر سناً منك
Dialogue: 0,0:26:58.65,0:27:00.19,خط مائل,,0,0,0,,هذا هراء على أية حال
Dialogue: 0,0:27:00.27,0:27:03.48,النص العام,,0,0,0,,يمارس العفة
Dialogue: 0,0:27:04.36,0:27:06.11,نص عام,,0,0,0,,كيف يتزوجون؟
Dialogue: 0,0:27:06.70,0:27:10.24,general text,,0,0,0,,قمعت غرائزي من أجل التدريب، ولكن بعد ذلك تعافيت بسرعة
Dialogue: 0,0:27:10.32,0:27:11.87,نص عام,,0,0,0,,ممكن
Dialogue: 0,0:27:11.95,0:27:13.99,النص العام,,0,0,0,,الزواج يجب أن يكون بالتراضي
Dialogue: 0,0:27:15.25,0:27:17.21,نص عام,,0,0,0,,لا بد أنها تريد ذلك أيضًا
Dialogue: 0,0:27:17.29,0:27:18.96,نص عام,,0,0,0,,هي طوال هذه السنوات
Dialogue: 0,0:27:19.96,0:27:23.75,نص عام,,0,0,0,,يحب شخص واحد
Dialogue: 0,0:27:25.21,0:27:26.38,نص عام,,0,0,0,,جين
Dialogue: 0,0:27:26.47,0:27:32.43,general text,,0,0,0,,هل تعتقد حقًا أنها لا تزال تحب تشانغ جانج؟
Dialogue: 0,0:27:34.35,0:27:36.73,نص عام,,0,0,0,,أنا أعرفها أكثر من أي شخص آخر
Dialogue: 0,0:27:37.31,0:27:40.27,النص العام,,0,0,0,,لذا أطلب منك عدم التسرع في الاستنتاجات
Dialogue: 0,0:27:42.31,0:27:44.73,نص عام,,0,0,0,,ماذا أفعل معك؟
Dialogue: 0,0:27:44.82,0:27:46.86,النص العام,,0,0,0,,ويصف شخصًا آخر بالغبي،
Dialogue: 0,0:27:46.94,0:27:49.41,النص العام,,0,0,0,,عندما لا يرى شيئاً تحت أنفه
Dialogue: 0,0:27:49.49,0:27:50.87,نص عام,,0,0,0,,ماذا تعرف!
Dialogue: 0,0:27:51.45,0:27:54.29,general text,,0,0,0,,لقد توقفت عن حب تشانغ غان منذ وقت طويل
Dialogue: 0,0:28:18.98,0:28:20.23,نص عام,,0,0,0,,في ذلك اليوم
Dialogue: 0,0:28:21.85,0:28:23.15,نص عام,,0,0,0,,لقد كان هنا أيضاً
Dialogue: 0,0:28:27.99,0:28:30.07,نص عام,,0,0,0,,هذا شاي السفرجل الطازج
Dialogue: 0,0:28:30.15,0:28:31.24,نص عام,,0,0,0,,يا لها من رائحة طيبة
Dialogue: 0,0:28:32.87,0:28:35.74,النص العام,,0,0,0,,ليس من الجيد الاحتفاظ بالزهور الذابلة في المنزل
Dialogue: 0,0:28:35.83,0:28:38.08,general text,,0,0,0,,لقد وصل الطقس البارد، ومن الصعب العثور على الزهور الآن
Dialogue: 0,0:28:38.79,0:28:40.71,النص العام,,0,0,0,,لكنني سأستمع إليك وأرميهم بعيداً
Dialogue: 0,0:28:42.04,0:28:43.71,نص عام,,0,0,0,,أعجبني شكل الزهور
Dialogue: 0,0:28:43.79,0:28:45.67,نص عام,,0,0,0,,رافقني
Dialogue: 0,0:28:59.98,0:29:03.02,general text,,0,0,0,,لقد نسيت أمر الأكواب تمامًا ولم أحضر سوى إبريق الشاي
Dialogue: 0,0:29:09.61,0:29:11.61,النص العام,,0,0,0,,كيف يمكن أن يزدهروا من جديد؟
Dialogue: 0,0:29:12.78,0:29:14.57,النص العام,,0,0,0,,هل السيد "لي" فعل هذا؟
Dialogue: 0,0:29:16.53,0:29:17.37,نص عام,,0,0,0,,ما هذا الجمال
Dialogue: 0,0:29:34.76,0:29:36.01,نص عام,,0,0,0,,يجب أن يكون كذلك،
Dialogue: 0,0:29:36.97,0:29:39.22,نص عام,,0,0,0,,أعطاها الزهور
Dialogue: 0,0:29:40.85,0:29:42.43,نص عام,,0,0,0,,في ذلك اليوم
Dialogue: 0,0:29:51.07,0:29:53.57,النص العام,,0,0,0,,سيد لي، أنت طيب للغاية ومتعاطف
Dialogue: 0,0:29:54.45,0:29:55.61,نص عام,,0,0,0,,أنا؟
Dialogue: 0,0:29:56.28,0:29:58.78,نص عام,,0,0,0,,ابق هنا بقدر ما تريد
Dialogue: 0,0:29:58.87,0:30:00.62,نص عام,,0,0,0,,سأعتني بك
Dialogue: 0,0:30:02.33,0:30:03.41,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:30:06.63,0:30:09.13,النص العام,,0,0,0,,هل هذه الفتاة زوجة تشانغ غان؟
Dialogue: 0,0:30:11.46,0:30:14.63,نص عام,,0,0,0,,نعم جميلة أليس كذلك؟
Dialogue: 0,0:30:14.72,0:30:18.39,general text,,0,0,0,,هل جين هو الذي كان يحبها بشدة؟ قال يوم
Dialogue: 0,0:30:21.97,0:30:27.02,النص العام,,0,0,0,,لم تذبل وحافظت على جمالها
Dialogue: 0,0:30:28.81,0:30:31.53,مائل,,0,0,0,,ربما لهذا السبب لا يزال غير قادر على نسيانها
Dialogue: 0,0:30:32.94,0:30:34.28,نص عام,,0,0,0,,أو
Dialogue: 0,0:30:35.11,0:30:36.66,نص عام,,0,0,0,,هو فقط لا يحبني
Dialogue: 0,0:30:37.49,0:30:38.70,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,0:30:44.83,0:30:46.92,النص العام,,0,0,0,,أفهم أن هذا ما أمر به الأمير
Dialogue: 0,0:30:47.00,0:30:49.25,general text,,0,0,0,,ولكن كيف يمنع مو دوك من زيارتي؟
Dialogue: 0,0:30:49.34,0:30:51.17,نص عام,,0,0,0,,كانت قلقة طوال الوقت
Dialogue: 0,0:30:51.25,0:30:53.84,مائل,,0,0,0,,أنا متأكد من أنها مشغولة فقط
Dialogue: 0,0:30:53.92,0:30:55.72,نص عام,,0,0,0,,قلت لها أنك بخير
Dialogue: 0,0:30:55.80,0:30:56.72,خط مائل,,0,0,0,,حسنًا، لا
Dialogue: 0,0:30:56.80,0:30:59.22,general text,,0,0,0,,هل تعتقد أنها استرخت فورًا بعد كلامك؟
Dialogue: 0,0:30:59.85,0:31:00.93,نص عام,,0,0,0,,علينا أن نتحقق
Dialogue: 0,0:31:02.10,0:31:03.02,نص عام,,0,0,0,,تعال هنا
Dialogue: 0,0:31:06.06,0:31:07.98,النص العام,,0,0,0,,هذا لن يسبب لك إلا الألم
Dialogue: 0,0:31:09.69,0:31:13.98,النص العام,,0,0,0,,هذا الطائر يوصل رسائلي إلى سوهو
Dialogue: 0,0:31:16.95,0:31:20.91,النص العام,,0,0,0,,يستغرق الوصول إلى هناك بالحصان من ثلاثة إلى أربعة أيام
Dialogue: 0,0:31:20.99,0:31:22.66,general text,,0,0,0,,هل يستطيع الطير أن يطير هذه المسافة؟
Dialogue: 0,0:31:23.24,0:31:24.37,نص عام,,0,0,0,,لا يصدق
Dialogue: 0,0:31:37.34,0:31:38.97,النص العام,,0,0,0,,هل لديك صفارة؟
Dialogue: 0,0:31:40.05,0:31:42.68,نص عام,,0,0,0,,عذراً، لا أحمله معي
Dialogue: 0,0:31:45.89,0:31:48.35,النص العام,,0,0,0,,هذه هدية من من تحب
Dialogue: 0,0:31:48.44,0:31:49.27,نص عام,,0,0,0,,أنا مجروح
Dialogue: 0,0:31:59.91,0:32:02.83,النص العام,,0,0,0,,عليك أن تنفخ مرتين حتى يعود الطائر
Dialogue: 0,0:32:04.12,0:32:05.54,نص عام,,0,0,0,,لقد أحسنت صنعاً
Dialogue: 0,0:32:06.12,0:32:07.33,نص عام,,0,0,0,,حاول
Dialogue: 0,0:32:37.03,0:32:38.19,نص عام,,0,0,0,,انظر
Dialogue: 0,0:32:41.32,0:32:42.82,نص عام,,0,0,0,,لقد عاد الطائر
Dialogue: 0,0:32:45.16,0:32:46.74,نص عام,,0,0,0,,الآن انفخ مرتين بسرعة
Dialogue: 0,0:33:09.64,0:33:12.44,ذكريات بخط مائل,,0,0,0,,قلت ذلك لتهدئته
Dialogue: 0,0:33:12.52,0:33:15.23,ذكريات,,0,0,0,,كان قلقًا من أن يواجه طائره الأليف وقتًا عصيبًا في الشتاء،
Dialogue: 0,0:33:16.15,0:33:17.77,ذكريات,,0,0,0,,فكذبت
Dialogue: 0,0:33:20.32,0:33:23.03,نص عام,,0,0,0,,أرأيت؟ مو دوك في حالة جيدة
Dialogue: 0,0:33:27.03,0:33:29.08,نص عام,,0,0,0,,انتظر، انتظر، المملكة المتحدة
Dialogue: 0,0:33:29.16,0:33:32.37,general text,,0,0,0,,ما الذي تجادل فيه مو دوك مع ولي العهد بالضبط؟
Dialogue: 0,0:33:32.46,0:33:33.83,نص عام,,0,0,0,,الشيء الذي أردت استعادته
Dialogue: 0,0:33:36.79,0:33:39.17,نص عام,,0,0,0,,لا يهم. الآن لا أستطيع استعادتها منذ أن خسرت
Dialogue: 0,0:33:45.68,0:33:49.64,general text,,0,0,0,,لكن لماذا كانت مطمئنة إلى هذه الدرجة عندما فقدته؟
Dialogue: 0,0:33:57.94,0:34:00.15,مائل,,0,0,0,,- إذن ما هذا؟\N- لا تسأل
Dialogue: 0,0:34:00.73,0:34:04.36,general text,,0,0,0,,لماذا لم تقم بزيارة ووك في سايجوكون من قبل؟
Dialogue: 0,0:34:05.78,0:34:08.53,general text,,0,0,0,,أنا سيدك الجديد، لكن لا داعي للقلق بشأن ذلك
Dialogue: 0,0:34:09.37,0:34:11.16,نص عام,,0,0,0,,ليس هذا هو الهدف
Dialogue: 0,0:34:11.66,0:34:13.66,نص عام,,0,0,0,,أنا فقط أحاول ألا أكون وقحًا
Dialogue: 0,0:34:25.34,0:34:27.72,ذكريات بخط مائل,,0,0,0,,إذن لا يهمك هل ستفقدينه أم لا؟
Dialogue: 0,0:34:31.31,0:34:34.81,خارج الشاشة,,0,0,0,,يجب أن أجده. يجب أن أجده اليوم
Dialogue: 0,0:34:36.10,0:34:38.94,خارج الإطار,,0,0,0,,عندها فقط سأتمكن من النظر في عينيه
Dialogue: 0,0:34:50.95,0:34:52.29,خط مائل,,0,0,0,,كنت أعرف ذلك
Dialogue: 0,0:34:55.50,0:34:57.00,نص عام,,0,0,0,,يشرب هذا الشاي
Dialogue: 0,0:34:58.96,0:35:00.92,general text,,0,0,0,,فضح السحرة وهرب
Dialogue: 0,0:35:01.00,0:35:04.80,general text,,0,0,0,, وبعدها تحسن وهزم ولي العهد. هذا غريب
Dialogue: 0,0:35:04.88,0:35:07.26,النص العام,,0,0,0,,قرر أن يصبح تلميذ المعلم لي
Dialogue: 0,0:35:07.34,0:35:09.09,نص عام,,0,0,0,,وممارسة العفة
Dialogue: 0,0:35:09.18,0:35:10.60,النص العام,,0,0,0,,هل رأيتم جميعاً السيد "لي"؟
Dialogue: 0,0:35:11.18,0:35:12.60,النص العام,,0,0,0,,كان تلميذاً للمعلم سو كيونغ،
Dialogue: 0,0:35:12.68,0:35:14.47,مائل,,0,0,0,,والسيد هو يوم هو تلميذه
Dialogue: 0,0:35:14.56,0:35:16.69,general text,,0,0,0,,لكنه يبدو أصغر سناً من رأسنا
Dialogue: 0,0:35:16.77,0:35:19.19,النص العام,,0,0,0,,وكل ذلك لأنه يمارس العفة
Dialogue: 0,0:35:19.27,0:35:23.11,general text,,0,0,0,,سمعت أنه لا يكبر لأنه وصل إلى أعلى المستويات في شبابه
Dialogue: 0,0:35:23.19,0:35:26.24,نص عام,,0,0,0,,هل هذا صحيح؟ سمعت أنه أصبح أصغر سنا بفضل التعويذة
Dialogue: 0,0:35:26.32,0:35:27.20,خط مائل,,0,0,0,,التهجئة؟
Dialogue: 0,0:35:27.28,0:35:30.20,نص عام,,0,0,0,,هذا ليس مهماً. تم تحديد المملكة المتحدة
Dialogue: 0,0:35:30.28,0:35:31.74,general text,,0,0,0,,وماذا لو وصل إلى تشيسو؟
Dialogue: 0,0:35:32.33,0:35:33.66,نص عام,,0,0,0,,أنا في مكانه
Dialogue: 0,0:35:35.79,0:35:37.54,نص عام,,0,0,0,,لن أمتنع
Dialogue: 0,0:35:38.25,0:35:39.83,نص عام,,0,0,0,,وبالطبع أنا أيضاً
Dialogue: 0,0:35:39.92,0:35:41.75,النص العام,,0,0,0,,- إنه عنيد حقاً\N- ولا تخبرني
Dialogue: 0,0:35:45.30,0:35:46.67,النص العام,,0,0,0,,كلهم غيورون
Dialogue: 0,0:35:48.47,0:35:51.80,general text,,0,0,0,,هناك الكثير من الشائعات الفظيعة حول السيد تشانغ ووك
Dialogue: 0,0:35:59.69,0:36:00.94,نص عام,,0,0,0,,لقد تمكنت
Dialogue: 0,0:36:01.73,0:36:05.15,نص عام,,0,0,0,,احصل على قسط من النوم بفضل أدويتها
Dialogue: 0,0:36:07.82,0:36:10.95,نص عام,,0,0,0,,أنا سعيد لأن الأعشاب الطبية كانت مفيدة
Dialogue: 0,0:36:11.99,0:36:15.49,general text,,0,0,0,,لقد استخدمت جذر حشيشة الهر، الذي ينمو في مستنقعات قلعة فول.
Dialogue: 0,0:36:15.58,0:36:17.37,النص العام,,0,0,0,,وهو معروف بأنه مهدئ
Dialogue: 0,0:36:17.45,0:36:21.25,النص العام,,0,0,0,,من المفترض أن يساعدك على الاسترخاء وتحسين نومك
Dialogue: 0,0:36:21.79,0:36:24.25,النص العام,,0,0,0,,أنا أفهم لماذا أوصى السيد هو يوم بك
Dialogue: 0,0:36:25.71,0:36:28.17,النص العام,,0,0,0,,لحسن الحظ، أستطيع الآن الحصول على قسط من النوم
Dialogue: 0,0:36:28.26,0:36:31.55,النص العام,,0,0,0,,لكن طنين الأذن والصداع ما زالا موجودين
Dialogue: 0,0:36:31.64,0:36:34.01,نص عام,,0,0,0,,لقد ساءت أخبار البدو
Dialogue: 0,0:36:34.10,0:36:35.89,نص عام,,0,0,0,,حالتك
Dialogue: 0,0:36:35.97,0:36:38.52,نص عام,,0,0,0,,بدوي حاول دخول القصر
Dialogue: 0,0:36:38.60,0:36:41.44,نص عام,,0,0,0,,في الداخل، ربما هم هناك أيضًا
Dialogue: 0,0:36:42.02,0:36:43.44,خط مائل,,0,0,0,,غوانغجو نائب جين مو
Dialogue: 0,0:36:43.52,0:36:45.52,نص عام,,0,0,0,,تشديد الأمن فلا تقلق
Dialogue: 0,0:36:45.61,0:36:48.24,general text,,0,0,0,,لقد كان رجله هو من حاول الوصول إلى هنا!
Dialogue: 0,0:36:48.99,0:36:50.11,خط مائل,,0,0,0,,وهناك شائعات،
Dialogue: 0,0:36:50.20,0:36:53.16,النص العام,,0,0,0,,أن بدويًا آخر شوهد في تشونبوغوان
Dialogue: 0,0:36:54.99,0:36:56.74,نص عام,,0,0,0,,لا أستطيع أن أثق بأحد
Dialogue: 0,0:36:59.62,0:37:03.00,general text,,0,0,0,,يبدو أن قلقك نابع من القلب يا صاحب الجلالة.
Dialogue: 0,0:37:03.08,0:37:06.59,general text,,0,0,0,,ربما يمكننا البحث عن طريقة أخرى لتهدئتك؟
Dialogue: 0,0:37:07.67,0:37:11.13,نص عام,,0,0,0,,هل تعرف سيد القنب "لي"؟
Dialogue: 0,0:37:11.22,0:37:13.26,نص عام,,0,0,0,,آخر طالب للمعلمة سو كيونغ
Dialogue: 0,0:37:13.84,0:37:15.93,خط مائل,,0,0,0,,سمعت عنه،
Dialogue: 0,0:37:16.01,0:37:17.97,نص عام,,0,0,0,,ولكن رأيت مرة واحدة فقط في سوسنوفي بور
Dialogue: 0,0:37:18.77,0:37:22.98,general text,,0,0,0,,كان جدي تلميذه فسمعت عنه الكثير
Dialogue: 0,0:37:23.06,0:37:27.02,نص عام,,0,0,0,,ربما يخفف ذلك من قلقك
Dialogue: 0,0:37:27.98,0:37:29.82,general text,,0,0,0,,هل تقول أنه يستطيع التحديد،
Dialogue: 0,0:37:29.90,0:37:31.99,نص عام,,0,0,0,,هل هناك أي بدو حولي؟
Dialogue: 0,0:37:32.07,0:37:34.61,نص عام,,0,0,0,,لا أعرفه شخصياً، لذا لا أعرف
Dialogue: 0,0:37:34.70,0:37:38.33,نص عام,,0,0,0,,أعتقد أنه يمكنك دعوته إلى القصر وطلب المساعدة
Dialogue: 0,0:37:44.75,0:37:46.59,نص عام,,0,0,0,,قلت لك أن تنظف هنا كل يوم!
Dialogue: 0,0:37:46.67,0:37:49.21,general text,,0,0,0,,لقد فسد الماء في المزهرية!
Dialogue: 0,0:37:50.51,0:37:51.47,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:37:52.38,0:37:54.01,خط مائل,,0,0,0,,ماذا لو عاد بو يونغ
Dialogue: 0,0:37:54.09,0:37:56.14,النص العام,,0,0,0,,ورأيت هنا مزهرية بها مياه راكدة؟
Dialogue: 0,0:37:56.22,0:37:57.89,النص العام,,0,0,0,,ستصاب بخيبة أمل
Dialogue: 0,0:37:58.93,0:38:00.56,خط مائل,,0,0,0,,تغيير الأوراق
Dialogue: 0,0:38:00.64,0:38:02.02,نص عام,,0,0,0,,وتخلص منه
Dialogue: 0,0:38:02.10,0:38:04.06,general text,,0,0,0,,إنها عمياء، فلماذا وضعت هذا هنا؟
Dialogue: 0,0:38:04.14,0:38:05.81,مائل,,0,0,0,,هل تتعثر؟
Dialogue: 0,0:38:18.70,0:38:20.95,general text,,0,0,0,,لقد أتت إلينا بالفعل عشرات الفتيات،
Dialogue: 0,0:38:22.12,0:38:23.62,النص العام,,0,0,0,,لكن بو يونغ لم يكن من بينهم
Dialogue: 0,0:38:24.16,0:38:28.38,general text,,0,0,0,,إنها منزعجة من هذا الأمر، وأصبحت حساسة للغاية
Dialogue: 0,0:38:28.46,0:38:29.80,نص عام,,0,0,0,,ولاحظت ذلك أيضاً
Dialogue: 0,0:38:30.71,0:38:33.55,نص عام,,0,0,0,,لكن عيد ميلادك سيأتي قريباً
Dialogue: 0,0:38:36.55,0:38:39.55,نص عام,,0,0,0,,- هنا\N- ما هذا؟
Dialogue: 0,0:38:42.56,0:38:45.14,نص عام,,0,0,0,,أبي، إنهم جميلون جدًا
Dialogue: 0,0:38:46.69,0:38:48.77,نص عام,,0,0,0,,لكن عيد ميلادي ليس اليوم
Dialogue: 0,0:38:48.86,0:38:51.48,النص العام,,0,0,0,,في هذا اليوم سأقدم شيئًا أجمل
Dialogue: 0,0:38:53.07,0:38:55.45,نص عام,,0,0,0,,أريد تجربتها. هل يمكنك مساعدتي؟
Dialogue: 0,0:38:56.95,0:38:58.03,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:39:02.37,0:39:06.25,نص عام,,0,0,0,,دعونا نرى كم هي جميلة ابنتي
Dialogue: 0,0:39:06.92,0:39:10.63,النص العام,,0,0,0,,عندما كنت صغيراً كنت دائماً تجدل شعري
Dialogue: 0,0:39:15.26,0:39:19.05,النص العام,,0,0,0,,الأم لم تفعل هذا أبدًا
Dialogue: 0,0:39:21.51,0:39:23.43,نص عام,,0,0,0,,عذراً. هل هو مؤلم جدا؟
Dialogue: 0,0:39:24.52,0:39:25.64,نص عام,,0,0,0,,كل شيء على ما يرام
Dialogue: 0,0:39:40.16,0:39:43.74,general text,,0,0,0,,ربما نسيت كيفية تجديل شعري، لم أفعل ذلك منذ وقت طويل.
Dialogue: 0,0:39:43.83,0:39:44.83,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:39:44.91,0:39:48.00,نص عام,,0,0,0,,كل شيء على ما يرام. كيف أبدو؟
Dialogue: 0,0:39:48.62,0:39:50.25,النص العام,,0,0,0,,أنتِ جميلة دائمًا
Dialogue: 0,0:40:23.78,0:40:25.83,النص العام,,0,0,0,,باك جين أطلق عليّ هذا القوس
Dialogue: 0,0:40:28.58,0:40:30.08,تعليق صوتي,,0,0,0,,لقد خسرت ذلك اليوم
Dialogue: 0,0:40:30.17,0:40:33.54,تعليق صوتي,,0,0,0,,لا أستطيع أن أختلق الأعذار أو لا أتقبل نتيجة المعركة
Dialogue: 0,0:40:36.09,0:40:38.05,التعليق الصوتي,,0,0,0,,لكن عندما أستعيد قوتي،
Dialogue: 0,0:40:39.01,0:40:42.01,التعليق الصوتي,,0,0,0,,أود أن أقاتله حقًا
Dialogue: 0,0:40:53.98,0:40:55.07,مائل,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:40:56.65,0:40:58.53,نص عام,,0,0,0,,الخروج, فصل
Dialogue: 0,0:41:00.57,0:41:02.11,نص عام,,0,0,0,,لا تلمس كل شيء
Dialogue: 0,0:41:02.70,0:41:05.87,general text,,0,0,0,,أسلحة تحتوي على طاقة ساحر قوي،
Dialogue: 0,0:41:05.95,0:41:08.75,نص عام,,0,0,0,,خطر على الفتاة الهشة
Dialogue: 0,0:41:10.37,0:41:12.58,نص عام,,0,0,0,,حتى أنا أعرف هذا
Dialogue: 0,0:41:13.17,0:41:16.38,نص عام,,0,0,0,,ولكن لماذا وضعته هنا؟
Dialogue: 0,0:41:16.46,0:41:19.05,نص عام,,0,0,0,,يجب أن أنظف هنا
Dialogue: 0,0:41:19.13,0:41:21.88,نص عام,,0,0,0,,عادةً ما أعلقه على الحائط
Dialogue: 0,0:41:22.97,0:41:24.14,نص عام,,0,0,0,,لقد نسيت هذه المرة
Dialogue: 0,0:41:24.22,0:41:25.93,نص عام,,0,0,0,,لكنك مازلت صغيراً جداً
Dialogue: 0,0:41:26.01,0:41:29.60,النص العام,,0,0,0,,لا أستطيع أن أصدق أنك كثير النسيان بالفعل
Dialogue: 0,0:41:30.31,0:41:33.56,general text,,0,0,0,,أنا فقط قلق، مثل خادم سوسنوفي بور
Dialogue: 0,0:41:33.65,0:41:36.65,النص العام,,0,0,0,,ماذا لو نسيت أن تدفع لي؟
Dialogue: 0,0:41:37.44,0:41:38.53,خط مائل,,0,0,0,,فصل
Dialogue: 0,0:41:38.61,0:41:42.11,نص عام,,0,0,0,,من فضلك، كن بصحة جيدة. أنت لا تزال صغيرا جدا
Dialogue: 0,0:41:45.41,0:41:48.41,نص عام,,0,0,0,,سأعود لاحقًا لإنهاء التنظيف
Dialogue: 0,0:41:54.42,0:41:56.58,نص عام,,0,0,0,,كم أنت ذكي،
Dialogue: 0,0:41:57.38,0:41:59.00,نص عام,,0,0,0,,لكنها فتاة وقحة
Dialogue: 0,0:41:59.71,0:42:01.26,نص عام,,0,0,0,,مثل مو دوك
Dialogue: 0,0:42:01.34,0:42:04.34,نص عام,,0,0,0,,هل التقيت بالمملكة المتحدة؟
Dialogue: 0,0:42:04.43,0:42:05.93,نص عام,,0,0,0,,لا أعرف التفاصيل
Dialogue: 0,0:42:06.01,0:42:09.85,general text,,0,0,0,,لكنني سمعت أنه دفع ديونها وأخذها من تشويسنجرو
Dialogue: 0,0:42:09.93,0:42:12.06,نص عام,,0,0,0,,ثم اذهب إلى تشويسنجرو
Dialogue: 0,0:42:12.14,0:42:14.77,نص عام,,0,0,0,,واسأل عنها
Dialogue: 0,0:42:15.48,0:42:19.02,نص عام,,0,0,0,,تعرف على ماضيها وشخصيتها
Dialogue: 0,0:42:20.11,0:42:21.94,نص عام,,0,0,0,,أنا فقط فضولي
Dialogue: 0,0:42:25.49,0:42:27.37,نص عام,,0,0,0,,لا أعرف الكثير أيضًا
Dialogue: 0,0:42:27.45,0:42:30.49,النص العام,,0,0,0,,لكن التاجر الذي أحضرها موجود الآن في العاصمة
Dialogue: 0,0:42:30.58,0:42:33.20,النص العام,,0,0,0,,سأخبره أن يأتي إلى سوسنوفي بور
Dialogue: 0,0:42:35.83,0:42:38.04,خط مائل,,0,0,0,,مرحبًا
Dialogue: 0,0:42:40.50,0:42:42.21,general text,,0,0,0,,هل التقينا بالفعل في قرية ساري؟
Dialogue: 0,0:42:42.80,0:42:44.51,نص عام,,0,0,0,,ماذا تحتاج هذه المرة؟
Dialogue: 0,0:42:44.59,0:42:45.76,نص عام,,0,0,0,,فأنا
Dialogue: 0,0:42:45.84,0:42:47.80,مائل,,0,0,0,,هل قابلتها في العاصمة؟
Dialogue: 0,0:42:48.30,0:42:50.60,النص العام,,0,0,0,,هل تعرف أين يمكن أن تكون؟
Dialogue: 0,0:42:50.68,0:42:53.77,نص عام,,0,0,0,,لا أعرف. هي ليست من سكان ساري
Dialogue: 0,0:42:54.35,0:42:57.60,general text,,0,0,0,,كانت هناك لبضعة أشهر، ثم قامت بسرقة القرويين
Dialogue: 0,0:42:57.69,0:42:59.06,نص عام,,0,0,0,,أخبرني إذا قبضت عليها
Dialogue: 0,0:43:04.07,0:43:06.49,نص عام,,0,0,0,,أين أجده؟
Dialogue: 0,0:43:10.41,0:43:11.45,نص عام,,0,0,0,,تفضل
Dialogue: 0,0:43:12.20,0:43:14.58,النص العام,,0,0,0,,حسنًا يا يي، لقد كونت بعض الأصدقاء السيئين.
Dialogue: 0,0:43:16.08,0:43:19.13,general text,,0,0,0,,ربما ذهبت للبحث عن مو ديوك؟
Dialogue: 0,0:43:22.63,0:43:25.22,نص عام,,0,0,0,,قريباً سأخذك إلى جينيوون
Dialogue: 0,0:43:25.30,0:43:27.88,نص عام,,0,0,0,,لكن علينا أولاً أن نهتم بشيء ما
Dialogue: 0,0:43:37.81,0:43:40.27,ذكريات,,0,0,0,,هنا تناول الطعام
Dialogue: 0,0:43:40.36,0:43:42.52,ذكريات,,0,0,0,,لقد سرقت أموالي
Dialogue: 0,0:43:42.61,0:43:43.86,ذكريات,,0,0,0,,أعيدوا خاتمي
Dialogue: 0,0:43:49.57,0:43:52.37,النص العام,,0,0,0,,هل التقيت بهم في العاصمة؟
Dialogue: 0,0:43:52.45,0:43:55.50,general text,,0,0,0,,نعم، لكن لماذا أحضرتهم إلى هنا؟
Dialogue: 0,0:43:55.58,0:43:58.37,النص العام,,0,0,0,,يعجبني أنك ذكي ومثابر
Dialogue: 0,0:43:58.92,0:44:00.83,نص عام,,0,0,0,,لكن هذا أيضًا يجعلك خطيرًا
Dialogue: 0,0:44:01.92,0:44:03.92,نص عام,,0,0,0,,أريدك أن ترى شيئاً
Dialogue: 0,0:44:20.73,0:44:21.94,نص عام,,0,0,0,,نائب غوانغجو
Dialogue: 0,0:44:22.48,0:44:25.28,نص عام,,0,0,0,,شكرًا لأنك أطعمتني
Dialogue: 0,0:45:27.00,0:45:28.46,نص عام,,0,0,0,,خافوا
Dialogue: 0,0:45:28.55,0:45:32.47,general text,,0,0,0,,خيانة لي أو الكشف عن هويتك، وسوف تعاني من نفس المصير
Dialogue: 0,0:45:38.39,0:45:39.39,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:45:40.35,0:45:42.98,general text,,0,0,0,,أخبرني إذا كان هناك أي شخص آخر قد يتعرف عليك
Dialogue: 0,0:45:43.48,0:45:44.81,خط مائل,,0,0,0,,يجب أن أتخلص منهم
Dialogue: 0,0:45:46.31,0:45:47.69,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:45:51.65,0:45:52.82,نص عام,,0,0,0,,نعم
Dialogue: 0,0:45:56.20,0:45:59.79,نص عام,,0,0,0,,ابحث بعناية أكبر. لقد رميتها هناك بالتأكيد
Dialogue: 0,0:45:59.87,0:46:01.25,نص عام,,0,0,0,,لا أرى شيئًا
Dialogue: 0,0:46:01.83,0:46:04.12,نص عام,,0,0,0,,انظر هناك
Dialogue: 0,0:46:04.21,0:46:06.96,نص عام,,0,0,0,,ألقيت نظرة جيدة، لا يوجد شيء هناك
Dialogue: 0,0:46:07.04,0:46:08.75,نص عام,,0,0,0,,أنظر مرة أخرى
Dialogue: 0,0:46:08.84,0:46:10.21,نص عام,,0,0,0,,بالكاد أستطيع الرؤية...
Dialogue: 0,0:46:11.38,0:46:12.59,نص عام,,0,0,0,,نعم سمو الأمير
Dialogue: 0,0:46:13.13,0:46:15.09,نص عام,,0,0,0,,أنا متأكد من أنه هنا في مكان ما.
Dialogue: 0,0:46:15.18,0:46:16.84,نص عام,,0,0,0,,نعم، انظر هناك
Dialogue: 0,0:46:21.43,0:46:22.77,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:46:24.98,0:46:26.27,نص عام,,0,0,0,,ليس من شأنك. اذهب بعيدا
Dialogue: 0,0:46:27.44,0:46:30.98,النص العام,,0,0,0,,أخشى أن الخصي يا يعاني عبثاً
Dialogue: 0,0:46:31.07,0:46:34.65,نص عام,,0,0,0,,يجب أن أقول شيئًا. يستطيع؟
Dialogue: 0,0:46:34.74,0:46:36.28,نص عام,,0,0,0,,ماذا لديك؟
Dialogue: 0,0:46:37.70,0:46:38.66,نص عام,,0,0,0,,ربما,
Dialogue: 0,0:46:39.70,0:46:40.79,نص عام,,0,0,0,,أنت تبحث عنه
Dialogue: 0,0:46:41.58,0:46:43.12,نص عام,,0,0,0,,أهذا؟
Dialogue: 0,0:46:44.71,0:46:45.71,نص عام,,0,0,0,,هل وجدته؟
Dialogue: 0,0:46:45.79,0:46:49.21,نص عام,,0,0,0,,بحثت ليل نهار ولم أجده منذ وقت ليس ببعيد
Dialogue: 0,0:46:53.84,0:46:55.26,نص عام,,0,0,0,,لقد رميتها بعيداً
Dialogue: 0,0:46:55.93,0:46:58.51,general text,,0,0,0,,والتقطتها، مما يعني أنها ملكي مرة أخرى
Dialogue: 0,0:47:02.89,0:47:05.27,نص عام,,0,0,0,,الخصي أوه، يمكنك الخروج من هناك
Dialogue: 0,0:47:06.60,0:47:07.90,نص عام,,0,0,0,,نعم
Dialogue: 0,0:47:11.07,0:47:14.32,نص عام,,0,0,0,,بفضلك اكتسبت شيئاً ثميناً
Dialogue: 0,0:47:14.90,0:47:18.07,نص عام,,0,0,0,,لقد استعدته مرة أخرى بفضلك
Dialogue: 0,0:47:19.66,0:47:20.70,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:47:20.78,0:47:24.75,نص عام,,0,0,0,,لم أكسره ولم أرميه بعيدًا
Dialogue: 0,0:47:24.83,0:47:27.33,نص عام,,0,0,0,,لقد وجدته لأنني رميته بالقرب
Dialogue: 0,0:47:27.42,0:47:32.92,النص العام,,0,0,0,,أجرؤ على محاولة فهمك يا صاحب السمو
Dialogue: 0,0:47:33.00,0:47:36.13,general text,,0,0,0,,تلتمس الأعذار وتغضب لأنه
Dialogue: 0,0:47:36.22,0:47:38.26,نص عام,,0,0,0,,ما الذي تأسف عليه؟
Dialogue: 0,0:47:38.89,0:47:41.85,general text,,0,0,0,,على فون مو ديوك أن يستمع فقط دون أن يحاول الفهم.
Dialogue: 0,0:47:41.93,0:47:43.72,نص عام,,0,0,0,,كيف تجرؤ على المحاولة؟
Dialogue: 0,0:47:43.81,0:47:45.77,نص عام,,0,0,0,,عذراً سمو الأمير
Dialogue: 0,0:47:49.06,0:47:50.15,خط مائل,,0,0,0,,صاحب السمو
Dialogue: 0,0:47:53.94,0:47:55.07,النص العام,,0,0,0,,صاحب السمو
Dialogue: 0,0:47:55.15,0:47:58.82,general text,,0,0,0,,طلب مني السيد هو أن أخبرك أن السيد لي قد وصل
Dialogue: 0,0:47:58.91,0:48:01.07,نص عام,,0,0,0,,حسنًا. هل هو في سايجوكون؟
Dialogue: 0,0:48:01.16,0:48:04.62,نص عام,,0,0,0,,نعم. تلميذه تشانغ ووك معه
Dialogue: 0,0:48:06.41,0:48:08.83,general text,,0,0,0,,يقولون أن تشان ووك قد حقق هذا النجاح
Dialogue: 0,0:48:08.92,0:48:10.83,نص عام,,0,0,0,,بفضل تعليمات المعلم لي
Dialogue: 0,0:48:10.92,0:48:12.67,نص عام,,0,0,0,,إن لم يكن لهذا،
Dialogue: 0,0:48:12.75,0:48:14.88,general text,,0,0,0,,لن يهزمك
Dialogue: 0,0:48:17.88,0:48:18.84,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:48:30.94,0:48:33.44,النص العام,,0,0,0,,أنت الآن تخدم سيو يول، وليس تشان ووك
Dialogue: 0,0:48:34.07,0:48:36.48,النص العام,,0,0,0,,إذا كنت قد هزمت تشانغ ووك،
Dialogue: 0,0:48:36.57,0:48:38.28,نص عام,,0,0,0,,هل تخدمني؟
Dialogue: 0,0:48:38.36,0:48:40.15,النص العام,,0,0,0,,إذا لم تكن رفضت القتال،
Dialogue: 0,0:48:40.86,0:48:43.87,نص عام,,0,0,0,,ليس عليك أن تخدمني
Dialogue: 0,0:48:43.95,0:48:46.66,النص العام,,0,0,0,,سأسمح له بالفوز من باب الشفقة
Dialogue: 0,0:48:47.25,0:48:48.66,نص عام,,0,0,0,,ألا تشعر بالأسف عليه؟
Dialogue: 0,0:48:48.75,0:48:50.41,النص العام,,0,0,0,,الجميع في سوسنوفي بور يعلم،
Dialogue: 0,0:48:50.50,0:48:52.75,نص عام,,0,0,0,,أن تشان ووك يمارس العفة
Dialogue: 0,0:48:53.33,0:48:55.17,general text,,0,0,0,,- أهذا صحيح؟\N- لا تتظاهر بأنك لا تعرف
Dialogue: 0,0:48:55.25,0:48:56.55,نص عام,,0,0,0,,أنت تعرف أفضل من أي شخص آخر
Dialogue: 0,0:48:57.13,0:48:59.17,نص عام,,0,0,0,,لم تحضره له
Dialogue: 0,0:48:59.76,0:49:01.18,نص عام,,0,0,0,,شاي العفة؟
Dialogue: 0,0:49:01.26,0:49:02.43,نص عام,,0,0,0,,لم أفعل هذا من قبل
Dialogue: 0,0:49:02.51,0:49:05.60,general text,,0,0,0,,كيف تمكن من إتقان تشيسا بهذه السرعة؟
Dialogue: 0,0:49:06.97,0:49:08.98,نص عام,,0,0,0,,إنه ليس حتى ابن تشانغ غان
Dialogue: 0,0:49:10.31,0:49:14.02,general text,,0,0,0,,تزوجت والدته من تشانغ غان وأنجبت ولداً.
Dialogue: 0,0:49:14.73,0:49:17.36,النص العام,,0,0,0,,والآن سيرث ابنها كل شيء
Dialogue: 0,0:49:18.69,0:49:22.49,general text,,0,0,0,,أغلق والده بوابته لينهي خط أوكا
Dialogue: 0,0:49:22.57,0:49:25.53,general text,,0,0,0,,لكن تشان ووك فتحهم، يجب أن يكون عفيفاً
Dialogue: 0,0:49:26.45,0:49:27.54,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:49:28.83,0:49:32.04,نص عام,,0,0,0,,مخادع ومقرف
Dialogue: 0,0:49:32.62,0:49:33.46,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:49:35.00,0:49:36.25,نص عام,,0,0,0,,ماذا قلت؟
Dialogue: 0,0:49:37.50,0:49:40.17,النص العام,,0,0,0,,- سمعت\N- كيف تجرؤ؟
Dialogue: 0,0:49:40.67,0:49:43.22,النص العام,,0,0,0,,- كرر\N- إذًا ستضربني
Dialogue: 0,0:49:43.30,0:49:44.55,نص عام,,0,0,0,,إذن أخبرني!
Dialogue: 0,0:49:46.93,0:49:48.18,خط مائل,,0,0,0,,أخبرهم
Dialogue: 0,0:49:58.48,0:49:59.69,النص العام,,0,0,0,,لو سمعوا,
Dialogue: 0,0:49:59.78,0:50:03.57,نص عام,,0,0,0,,قلها بصوت عالٍ وواضح
Dialogue: 0,0:50:09.37,0:50:12.46,النص العام,,0,0,0,,أنت حقير وسيئ
Dialogue: 0,0:50:14.50,0:50:17.04,نص عام,,0,0,0,,هذا ما قالته. فهمتها؟
Dialogue: 0,0:50:17.67,0:50:18.50,نص عام,,0,0,0,,نعم
Dialogue: 0,0:50:19.59,0:50:22.34,النص العام,,0,0,0,,مو دوك، لقد أعطيتك شيئاً
Dialogue: 0,0:50:22.42,0:50:23.59,نص عام,,0,0,0,,أريهم
Dialogue: 0,0:50:30.47,0:50:32.23,نص عام,,0,0,0,,هذا الكيس هديتي
Dialogue: 0,0:50:32.31,0:50:36.44,general text,,0,0,0,,إذا قام شخص ما بضربك أو وبخك أو أهانك عندما لا أكون موجودًا،
Dialogue: 0,0:50:36.52,0:50:38.31,نص عام,,0,0,0,,فقط أخبرني
Dialogue: 0,0:50:39.57,0:50:40.52,نص عام,,0,0,0,,نعم
Dialogue: 0,0:50:42.61,0:50:43.86,نص عام,,0,0,0,,يمكنك الذهاب
Dialogue: 0,0:50:53.08,0:50:55.62,النص العام,,0,0,0,,من الغباء أن تصنع عدواً
Dialogue: 0,0:50:55.71,0:50:59.29,النص العام,,0,0,0,,من الحسد أن هناك من هو أقوى
Dialogue: 0,0:51:08.72,0:51:10.39,نص عام,,0,0,0,,لديك حبر على ملابسك
Dialogue: 0,0:51:11.06,0:51:13.77,نص عام,,0,0,0,,يمكن تربيتها مع الأرز الأبيض
Dialogue: 0,0:51:15.02,0:51:17.10,نص عام,,0,0,0,,هذان لونان مختلفان تمامًا
Dialogue: 0,0:51:17.94,0:51:20.56,النص العام,,0,0,0,,لكنهما معًا يستطيعان إزالة البقعة
Dialogue: 0,0:51:21.19,0:51:22.69,نص عام,,0,0,0,,كلمات حكيمة
Dialogue: 0,0:51:23.44,0:51:25.86,النص العام,,0,0,0,,أين قرأتها يا صاحب السمو؟
Dialogue: 0,0:51:27.32,0:51:28.74,نص عام,,0,0,0,,هنا وهناك
Dialogue: 0,0:51:28.82,0:51:31.08,نص عام,,0,0,0,,هذا لا يُسأل إلا في أصعب الامتحانات
Dialogue: 0,0:51:45.55,0:51:47.43,نص عام,,0,0,0,,سيدي ليس هنا؟
Dialogue: 0,0:51:50.85,0:51:53.72,general text,,0,0,0,,سمعت أنك جُرحت. هل أنت بخير؟
Dialogue: 0,0:51:54.31,0:51:57.27,نص عام,,0,0,0,,نعم شكرًا لك. شكرا على تلك الأدوية
Dialogue: 0,0:51:59.27,0:52:03.36,نص عام,,0,0,0,,لقد دعتني الخادمة كيم لتناول العشاء
Dialogue: 0,0:52:04.69,0:52:07.78,النص العام,,0,0,0,,ربما ستنضم إلينا؟
Dialogue: 0,0:52:08.74,0:52:09.66,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:52:11.78,0:52:14.70,general text,,0,0,0,,ثم سأختار يومًا وأخبر مو دوك
Dialogue: 0,0:52:15.58,0:52:17.08,نص عام,,0,0,0,,هل تعرفين خادمتي؟
Dialogue: 0,0:52:17.16,0:52:20.21,النص العام,,0,0,0,,جئت ذات مرة لرؤيتك،
Dialogue: 0,0:52:20.29,0:52:21.92,نص عام,,0,0,0,,لكن الأمر لم ينجح معي
Dialogue: 0,0:52:22.71,0:52:25.25,النص العام,,0,0,0,,لقد دخلت غرفتك إذن
Dialogue: 0,0:52:30.97,0:52:32.14,ذكريات,,0,0,0,,لا تذهب
Dialogue: 0,0:52:33.35,0:52:35.14,ذكريات,,0,0,0,,لا تذهب إلى مكانك، ابق هنا
Dialogue: 0,0:52:36.10,0:52:37.89,ذكريات,,0,0,0,,سأحضر ملابسك
Dialogue: 0,0:52:39.98,0:52:41.02,نص عام,,0,0,0,,ماذا كان ذلك؟
Dialogue: 0,0:52:41.90,0:52:43.23,نص عام,,0,0,0,,خطوة نحو؟
Dialogue: 0,0:52:43.77,0:52:45.32,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:52:47.23,0:52:48.36,نص عام,,0,0,0,,نعم كذلك
Dialogue: 0,0:52:55.49,0:52:56.49,نص عام,,0,0,0,,ثانية واحدة فقط
Dialogue: 0,0:52:57.75,0:52:59.79,نص عام,,0,0,0,,هادئ
Dialogue: 0,0:53:00.75,0:53:01.92,نص عام,,0,0,0,,طار بعيدا
Dialogue: 0,0:53:02.71,0:53:04.09,نص عام,,0,0,0,,- حقاً؟\N- نعم
Dialogue: 0,0:53:06.21,0:53:08.13,خط مائل,,0,0,0,,كنت خائفًا جدًا
Dialogue: 0,0:53:21.19,0:53:22.31,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:53:38.62,0:53:40.96,نص عام,,0,0,0,,مو دوك، نلتقي مرة أخرى
Dialogue: 0,0:53:44.38,0:53:46.25,نص عام,,0,0,0,,اعتني بنفسك
Dialogue: 0,0:53:46.34,0:53:47.67,نص عام,,0,0,0,,أراك في القصر
Dialogue: 0,0:53:47.75,0:53:49.09,نص عام,,0,0,0,,نعم
Dialogue: 0,0:54:02.64,0:54:04.27,نص عام,,0,0,0,,ما هذا؟ هل ركضت هنا؟
Dialogue: 0,0:54:05.19,0:54:06.11,نص عام,,0,0,0,,نعم
Dialogue: 0,0:54:06.19,0:54:08.86,general text,,0,0,0,,مر وقت طويل منذ زرتني عندما كنت مجروحاً
Dialogue: 0,0:54:08.94,0:54:09.78,نص عام,,0,0,0,,ما الأمر؟
Dialogue: 0,0:54:09.86,0:54:12.15,النص العام,,0,0,0,,هناك شيء أكثر خطورة من تغيير المالك؟
Dialogue: 0,0:54:12.24,0:54:13.20,نص عام,,0,0,0,,لا
Dialogue: 0,0:54:13.28,0:54:15.24,نص عام,,0,0,0,,كان السحرة الآخرون يثرثرون عنك
Dialogue: 0,0:54:15.32,0:54:16.49,نص عام,,0,0,0,,أردت أن أعرف الحقيقة
Dialogue: 0,0:54:16.57,0:54:18.91,نص عام,,0,0,0,,فهمت. هل سمعت عن ذلك الشاي؟
Dialogue: 0,0:54:18.99,0:54:20.74,نص عام,,0,0,0,,لكنك تعرف الحقيقة
Dialogue: 0,0:54:20.83,0:54:24.12,نص عام,,0,0,0,,ماذا لو؟ لقد اصطدت السمكة الذهبية بينما كنت بعيدًا
Dialogue: 0,0:54:24.87,0:54:27.04,نص عام,,0,0,0,,ربما أصبحت بالفعل تلميذ المعلم "لي"
Dialogue: 0,0:54:27.13,0:54:29.25,نص عام,,0,0,0,,ماذا؟ لا، بالطبع
Dialogue: 0,0:54:29.34,0:54:30.38,نص عام,,0,0,0,,انسى
Dialogue: 0,0:54:30.46,0:54:32.47,نص عام,,0,0,0,,اقترحتها عليك بنفسي
Dialogue: 0,0:54:33.26,0:54:34.88,نص عام,,0,0,0,,ربما لم أستطع المقاومة
Dialogue: 0,0:54:34.97,0:54:36.84,نص عام,,0,0,0,,كيف يمكنني إثبات ذلك لك؟
Dialogue: 0,0:54:38.01,0:54:39.35,نص عام,,0,0,0,,لقد قلتها بنفسك
Dialogue: 0,0:54:49.15,0:54:50.15,نص عام,,0,0,0,,أرأيت؟
Dialogue: 0,0:54:52.65,0:54:54.07,نص عام,,0,0,0,,أنت لا ترى بداخلي امرأة
Dialogue: 0,0:54:54.15,0:54:57.20,النص العام,,0,0,0,,كان يجب أن أعانق تلك الفتاة الجميلة كدليل
Dialogue: 0,0:54:58.57,0:55:00.62,النص العام,,0,0,0,,هل يجب أن أعانقها حقًا؟
Dialogue: 0,0:55:01.83,0:55:03.87,نص عام,,0,0,0,,نعم. هيا
Dialogue: 0,0:55:03.95,0:55:05.62,نص عام,,0,0,0,,لا تغير رأيك لاحقًا
Dialogue: 0,0:55:05.71,0:55:07.08,نص عام,,0,0,0,,حسنًا، اذهب!
Dialogue: 0,0:55:42.33,0:55:43.99,النص العام,,0,0,0,,قلت أننا بحاجة للهجوم،
Dialogue: 0,0:55:44.08,0:55:46.46,النص العام,,0,0,0,,عندما لا يتوقع العدو ذلك على الإطلاق
Dialogue: 0,0:55:47.62,0:55:51.00,نص عام,,0,0,0,,لقد اتبعت نصيحتك يا معلم
Dialogue: 0,0:55:53.80,0:55:56.59,نص عام,,0,0,0,,نعم. أحسنت. أنا فخور بك
Dialogue: 0,0:55:58.84,0:56:00.01,نص عام,,0,0,0,,بالمناسبة يا أستاذ،
Dialogue: 0,0:56:00.64,0:56:04.31,نص عام,,0,0,0,,سمعت أنك صادفتها في غرفتي
Dialogue: 0,0:56:06.48,0:56:07.56,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:56:07.64,0:56:09.35,general text,,0,0,0,,أهذا هو سبب إيقافي إذن؟
Dialogue: 0,0:56:13.15,0:56:14.69,نص عام,,0,0,0,,هل حدث هذا بالفعل؟
Dialogue: 0,0:56:15.53,0:56:17.03,نص عام,,0,0,0,,لا أتذكر
Dialogue: 0,0:56:17.74,0:56:19.82,general text,,0,0,0,,فهمك أصعب من التحكم بك
Dialogue: 0,0:56:19.91,0:56:21.28,نص عام,,0,0,0,,طاقة جيونج تشيونج دايهو
Dialogue: 0,0:56:22.74,0:56:24.49,نص عام,,0,0,0,,لقد أوقفتني
Dialogue: 0,0:56:27.00,0:56:29.50,نص عام,,0,0,0,,يا معلم، سأذهب إلى القصر اليوم
Dialogue: 0,0:56:29.58,0:56:31.46,النص العام,,0,0,0,,الملك دعا السيد لي،
Dialogue: 0,0:56:32.08,0:56:34.17,نص عام,,0,0,0,,وسأرافقه
Dialogue: 0,0:56:34.25,0:56:36.88,نص عام,,0,0,0,,أردت رؤية الملكة والآن سنحت لي الفرصة
Dialogue: 0,0:56:37.63,0:56:39.17,نص عام,,0,0,0,,كن حذراً
Dialogue: 0,0:56:40.47,0:56:43.30,نص عام,,0,0,0,,سأفعل. سأخبرك بكل شيء عندما أعود
Dialogue: 0,0:56:51.27,0:56:52.31,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:56:56.61,0:56:57.90,نص عام,,0,0,0,,لقد وجدته
Dialogue: 0,0:56:59.65,0:57:03.66,النص العام,,0,0,0,,لقد حدث ذلك، لذا فكرت أن أخبرك
Dialogue: 0,0:57:05.91,0:57:06.91,نص عام,,0,0,0,,انطلق
Dialogue: 0,0:57:26.26,0:57:28.60,general text,,0,0,0,,لماذا يبحث عني رئيس سوسنوفي بور؟
Dialogue: 0,0:57:29.64,0:57:31.73,نص عام,,0,0,0,,- هل تتذكر مو دوك؟\N- نعم
Dialogue: 0,0:57:31.81,0:57:34.81,general text,,0,0,0,,يريد أن يعرف المزيد عن حياتها في ساري
Dialogue: 0,0:57:34.90,0:57:38.15,نص عام,,0,0,0,,يمكن أن يسألها بنفسه
Dialogue: 0,0:57:38.23,0:57:39.19,نص عام,,0,0,0,,إنها هنا
Dialogue: 0,0:57:39.28,0:57:41.74,نص عام,,0,0,0,,لا. هي في سوسنوفي بور
Dialogue: 0,0:57:41.82,0:57:42.95,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:57:43.74,0:57:46.58,general text,,0,0,0,,ماذا تفعل المرأة العمياء هناك؟
Dialogue: 0,0:57:48.87,0:57:51.41,النص العام,,0,0,0,,السيد لي يريدكما أنتما الاثنان وتشان ووك
Dialogue: 0,0:57:51.50,0:57:53.33,نص عام,,0,0,0,,اصطحبته إلى القصر
Dialogue: 0,0:57:54.50,0:57:55.83,النص العام,,0,0,0,,هل ستنجح المملكة المتحدة أيضًا؟
Dialogue: 0,0:57:57.34,0:57:58.46,general text,,0,0,0,,هل يشعر بالتحسن بالفعل؟
Dialogue: 0,0:57:58.55,0:58:00.42,نص عام,,0,0,0,,سنغادر قريبًا. استعد
Dialogue: 0,0:58:08.72,0:58:11.39,نص عام,,0,0,0,,كن حذراً في القصر
Dialogue: 0,0:58:11.48,0:58:13.85,نص عام,,0,0,0,,هناك حجر جليدي
Dialogue: 0,0:58:15.52,0:58:17.11,نص عام,,0,0,0,,أنا أعرف ذلك بنفسي
Dialogue: 0,0:58:17.19,0:58:20.36,النص العام,,0,0,0,,لأنهم يخفون ذلك بلا خجل،
Dialogue: 0,0:58:20.44,0:58:23.40,النص العام,,0,0,0,,قررت أن أتحرك بوقاحة
Dialogue: 0,0:58:28.99,0:58:31.58,النص العام,,0,0,0,,متى كانت آخر مرة دعيت فيها إلى القصر،
Dialogue: 0,0:58:32.16,0:58:34.58,نص عام,,0,0,0,,كنت صغيراً جداً
Dialogue: 0,0:58:35.12,0:58:38.13,نص عام,,0,0,0,,أتذكر كم كنت أحب الحلويات،
Dialogue: 0,0:58:38.21,0:58:40.50,نص عام,,0,0,0,,الذي أحضرته بعد ذلك
Dialogue: 0,0:58:40.59,0:58:41.76,نص عام,,0,0,0,,بالمناسبة,
Dialogue: 0,0:58:42.34,0:58:45.97,النص العام,,0,0,0,,ألن تقدم للملك هدية؟
Dialogue: 0,0:58:46.05,0:58:48.01,نص عام,,0,0,0,,لقد قمت بالفعل بإعداد واحدة
Dialogue: 0,0:58:48.10,0:58:48.97,نص عام,,0,0,0,,يوم
Dialogue: 0,0:58:49.05,0:58:51.89,نص عام,,0,0,0,,أرسل هدية إلى القصر في الوقت المحدد
Dialogue: 0,0:58:51.97,0:58:53.52,مائل,,0,0,0,,نعم يا معلمة
Dialogue: 0,0:58:53.60,0:58:55.19,نص عام,,0,0,0,,في مكان ما بين 5 و 7 مساءً؟
Dialogue: 0,0:58:55.27,0:58:56.69,النص العام,,0,0,0,,بين 7 و 9 أيها الغبي!
Dialogue: 0,0:58:57.27,0:58:59.02,نص عام,,0,0,0,,بالضبط. آسف
Dialogue: 0,0:58:59.73,0:59:01.73,نص عام,,0,0,0,,اكتبها إذا كنت لا تستطيع التذكر
Dialogue: 0,0:59:02.65,0:59:04.15,النص العام,,0,0,0,,كنت شارد الذهن من قبل،
Dialogue: 0,0:59:04.24,0:59:07.16,نص عام,,0,0,0,,ومع التقدم في السن أصبح كل شيء أسوأ
Dialogue: 0,0:59:09.45,0:59:10.58,نص عام,,0,0,0,,إلى الأمام
Dialogue: 0,0:59:11.08,0:59:12.75,نص عام,,0,0,0,,وداعا
Dialogue: 0,0:59:13.95,0:59:16.62,نص عام,,0,0,0,,لن أعتاد على هذا أبدًا يا شباب
Dialogue: 0,0:59:45.24,0:59:46.36,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:59:47.99,0:59:49.87,النص العام,,0,0,0,,الرأس يريد رؤيتك
Dialogue: 0,0:59:51.33,0:59:52.53,نص عام,,0,0,0,,الفصل؟
Dialogue: 0,1:00:01.42,1:00:02.42,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:00:15.64,1:00:20.15,نص عام,,0,0,0,,لقد ظهر كل شيء عنك للنور
Dialogue: 0,1:00:21.11,1:00:24.69,نص عام,,0,0,0,,أخبرته عن عينيك
Dialogue: 0,1:00:29.28,1:00:30.82,خلف الكواليس,,0,0,0,,الآن سينفتح كل شيء؟
Dialogue: 0,1:00:32.45,1:00:35.12,نص عام,,0,0,0,,الفصل، كما ترى...
Dialogue: 0,1:00:36.70,1:00:39.12,نص عام,,0,0,0,,لم تكن الوحيدة التي تكذب
Dialogue: 0,1:00:40.46,1:00:44.13,general text,,0,0,0,,جدتها توسلت إلي فوافقت عليها.
Dialogue: 0,1:00:44.92,1:00:48.30,نص عام,,0,0,0,,كانت عائلتها فقيرة جدًا
Dialogue: 0,1:00:48.38,1:00:50.30,نص عام,,0,0,0,,كذبت أنها كانت عمياء،
Dialogue: 0,1:00:50.88,1:00:53.35,نص عام,,0,0,0,,حتى لا يتم بيعها لسداد الديون
Dialogue: 0,1:00:53.43,1:00:55.64,النص العام,,0,0,0,,مثل أولئك الذين يتظاهرون بالعرج،
Dialogue: 0,1:00:55.72,1:00:57.68,نص عام,,0,0,0,,حتى لا نخوض الحرب
Dialogue: 0,1:00:57.77,1:01:01.56,general text,,0,0,0,,لماذا كذبت عندما وصلت إلى تشويسونغرا؟
Dialogue: 0,1:01:04.11,1:01:06.61,مائل,,0,0,0,,أرادت الهروب
Dialogue: 0,1:01:07.28,1:01:09.11,نص عام,,0,0,0,,طبعا تم البيع
Dialogue: 0,1:01:09.19,1:01:12.66,general text,,0,0,0,,ولكن كونك أعمى سيكون من الأسهل الهروب
Dialogue: 0,1:01:13.28,1:01:15.62,نص عام,,0,0,0,,- هل أنا على حق؟\N- نعم
Dialogue: 0,1:01:15.70,1:01:18.66,general text,,0,0,0,,حاولت الهرب عندما قابلت المالك
Dialogue: 0,1:01:19.37,1:01:22.04,نص عام,,0,0,0,,لقد أشفق عليّ واحتضنني
Dialogue: 0,1:01:24.92,1:01:27.09,نص عام,,0,0,0,,آسف على الكذب، الفصل
Dialogue: 0,1:01:28.30,1:01:29.55,نص عام,,0,0,0,,لقد أخطأت
Dialogue: 0,1:01:30.88,1:01:32.34,نص عام,,0,0,0,,إلا هذه الكذبة،
Dialogue: 0,1:01:32.43,1:01:34.26,النص العام,,0,0,0,,ليس لها ذنوب أخرى
Dialogue: 0,1:01:34.34,1:01:38.06,النص العام,,0,0,0,,كانت دائمًا حفيدة جيدة وفتاة لطيفة
Dialogue: 0,1:01:49.82,1:01:51.99,النص العام,,0,0,0,,لماذا كذبت؟
Dialogue: 0,1:01:53.07,1:01:56.03,نص عام,,0,0,0,,فقط أكسب أموالي
Dialogue: 0,1:01:56.62,1:01:57.91,نص عام,,0,0,0,,هل ربحت المال؟
Dialogue: 0,1:02:00.66,1:02:03.00,نص عام,,0,0,0,,ألست أعمى؟
Dialogue: 0,1:02:06.21,1:02:07.09,نص عام,,0,0,0,,حسنًا، نعم
Dialogue: 0,1:02:07.17,1:02:10.63,نص عام,,0,0,0,,كان الأمر يبدو غريباً دائماً بالنسبة لي
Dialogue: 0,1:02:11.63,1:02:13.76,النص العام,,0,0,0,,- ماذا؟\N- حتى لو كنت أعمى،
Dialogue: 0,1:02:13.84,1:02:16.09,نص عام,,0,0,0,,دائما كنت تعرف من يقف أمامك
Dialogue: 0,1:02:16.18,1:02:18.22,نص عام,,0,0,0,,كنت أعرف إذا كان سيهطل المطر أم الثلج
Dialogue: 0,1:02:18.81,1:02:23.31,نص عام,,0,0,0,,ظن القرويون أنك تكذب بشأن العمى
Dialogue: 0,1:02:23.39,1:02:26.31,نص عام,,0,0,0,,خافوا وتجنبوك
Dialogue: 0,1:02:27.48,1:02:29.15,نص عام,,0,0,0,,- أرى\N- بشكل عام،
Dialogue: 0,1:02:29.23,1:02:31.69,نص عام,,0,0,0,,إذا كنت بحاجة إلى مساعدة، تعال إلى النزل
Dialogue: 0,1:02:31.78,1:02:32.82,نص عام,,0,0,0,,حسنًا؟
Dialogue: 0,1:02:33.57,1:02:34.49,نص عام,,0,0,0,,بالمناسبة
Dialogue: 0,1:02:35.03,1:02:37.32,نص عام,,0,0,0,,هل قابلت سو يي بعد؟
Dialogue: 0,1:02:38.41,1:02:39.58,نص عام,,0,0,0,,وأنا كذلك؟
Dialogue: 0,1:02:39.66,1:02:41.66,نص عام,,0,0,0,,هي الآن في العاصمة
Dialogue: 0,1:02:41.75,1:02:43.54,نص عام,,0,0,0,,كان بعض قطاع الطرق يبحثون عنها
Dialogue: 0,1:02:43.62,1:02:46.04,نص عام,,0,0,0,,ماذا فعلت هذه المرة؟
Dialogue: 0,1:02:46.12,1:02:49.42,general text,,0,0,0,,لقد سرقت منزلك بعد وفاة جدتك
Dialogue: 0,1:02:50.25,1:02:52.38,نص عام,,0,0,0,,لا تعبث معها
Dialogue: 0,1:02:52.46,1:02:55.05,general text,,0,0,0,,يبدو أنك تخفي شيئًا عن سوسنوفي بور
Dialogue: 0,1:02:56.43,1:02:59.64,النص العام,,0,0,0,,قلت أنك عملت على تحصيل المال. من دفع لك؟
Dialogue: 0,1:02:59.72,1:03:00.81,نص عام,,0,0,0,,جو وول
Dialogue: 0,1:03:05.73,1:03:07.23,نص عام,,0,0,0,,لا تشكرني
Dialogue: 0,1:03:07.73,1:03:09.77,نص عام,,0,0,0,,لقد كانت أموال السيد تشان
Dialogue: 0,1:03:14.24,1:03:19.12,ذكريات,,0,0,0,,إذا سأل أحد عن مو ديوك،
Dialogue: 0,1:03:19.20,1:03:20.33,ذكريات,,0,0,0,,استخدم هذا المال
Dialogue: 0,1:03:21.49,1:03:24.08,ذكريات,,0,0,0,,بالطبع النصف لك
Dialogue: 0,1:03:24.75,1:03:27.67,نص عام,,0,0,0,,لم أخفي شيئاً خسيساً
Dialogue: 0,1:03:27.75,1:03:29.67,نص عام,,0,0,0,,حصلت على نصيبي
Dialogue: 0,1:03:30.75,1:03:32.55,نص عام,,0,0,0,,نعم وأنا معجب بك
Dialogue: 0,1:03:33.55,1:03:35.22,نص عام,,0,0,0,,أنا ممتن حقًا
Dialogue: 0,1:03:35.30,1:03:38.01,نص عام,,0,0,0,,ما خطب عينيك حقًا؟
Dialogue: 0,1:03:43.06,1:03:44.18,نص عام,,0,0,0,,انسى
Dialogue: 0,1:03:44.27,1:03:45.98,نص عام,,0,0,0,,ربما هناك أسباب
Dialogue: 0,1:03:50.52,1:03:54.86,خلف الكواليس,,0,0,0,,إذا لم يستعد تشانغ ووك مسبقًا، لكان بارك جين اكتشف كل شيء.
Dialogue: 0,1:03:55.49,1:03:59.76,التعليق الصوتي,,0,0,0,,إذا أمسكوا بي، سيعاني تشان ووك أيضًا
Dialogue: 0,1:04:13.34,1:04:15.26,نص عام,,0,0,0,,مرحبًا بالسيد لي تشول
Dialogue: 0,1:04:16.17,1:04:18.47,نص عام,,0,0,0,,شكرًا على الدعوة يا صاحب الجلالة
Dialogue: 0,1:04:20.72,1:04:22.64,ذكريات,,0,0,0,,هذا الشامان تشوي
Dialogue: 0,1:04:23.22,1:04:25.18,ذكريات,,0,0,0,,قلت لك أن تقتلني؟
Dialogue: 0,1:04:28.44,1:04:30.65,خلف الكواليس,,0,0,0,,شامان تشوي
Dialogue: 0,1:04:30.73,1:04:32.48,التعليق الصوتي,,0,0,0,,هل هذه الملكة؟
Dialogue: 0,1:04:38.78,1:04:39.82,نص عام,,0,0,0,,مو دوك
Dialogue: 0,1:04:43.28,1:04:45.08,نص عام,,0,0,0,,فأنا الذي ذكرته
Dialogue: 0,1:04:45.70,1:04:48.33,نص عام,,0,0,0,,ربما هذه هي الفتاة التي كانت تبحث عنك مؤخراً
Dialogue: 0,1:04:49.58,1:04:51.71,نص عام,,0,0,0,,سمعت أنها خطيرة. كن حذرا
Dialogue: 0,1:04:55.13,1:04:58.05,خلف الكواليس,,0,0,0,,لا أعرفها لأنني لا أعرفها
Dialogue: 0,1:04:58.59,1:05:00.84,خلف الكواليس,,0,0,0,,اسأل عنها ذلك الرجل؟
Dialogue: 0,1:05:01.39,1:05:04.10,ذكريات,,0,0,0,,إذا كنت بحاجة إلى مساعدة، تعال إلى النزل
Dialogue: 0,1:05:05.22,1:05:06.77,نص عام,,0,0,0,,نزل...
Dialogue: 0,1:05:13.36,1:05:17.15,ذكريات بخط مائل,,0,0,0,,ظهر كل شيء عنك
Dialogue: 0,1:05:36.17,1:05:38.55,general text,,0,0,0,,هل التاجر كيم من قرية ساري هنا؟
Dialogue: 0,1:05:38.63,1:05:40.47,نص عام,,0,0,0,,نعم إنه هنا
Dialogue: 0,1:05:40.97,1:05:42.55,نص عام,,0,0,0,,الغرفة الأخيرة في الطابق الثاني
Dialogue: 0,1:05:48.35,1:05:51.64,النص العام,,0,0,0,,أجاشي، هذا مو دوك
Dialogue: 0,1:06:18.38,1:06:19.38,خلف الكواليس,,0,0,0,,اجاشي...
Dialogue: 0,1:06:32.27,1:06:33.73,خط مائل,,0,0,0,,السيد لي
Dialogue: 0,1:06:33.81,1:06:36.61,نص عام,,0,0,0,,لو كنت تلميذاً للمعلمة سو كيونغ،
Dialogue: 0,1:06:36.69,1:06:38.73,نص عام,,0,0,0,,عمرك الآن أكثر من مائة عام
Dialogue: 0,1:06:38.82,1:06:41.44,النص العام,,0,0,0,,كيف نجوت بهذه الطريقة؟
Dialogue: 0,1:06:42.03,1:06:45.16,نص عام,,0,0,0,,كم سنة ستعطيني؟
Dialogue: 0,1:06:46.36,1:06:48.87,خط مائل,,0,0,0,,ما يزيد قليلاً عن الثلاثين
Dialogue: 0,1:06:48.95,1:06:51.58,نص عام,,0,0,0,,أربعون سنة على الأكثر
Dialogue: 0,1:06:52.41,1:06:56.08,نص عام,,0,0,0,,أنت على حق. هذا هو عمري البيولوجي
Dialogue: 0,1:06:57.00,1:06:57.96,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:06:58.04,1:07:00.84,نص عام,,0,0,0,,عمر روحي مائة عام
Dialogue: 0,1:07:01.42,1:07:04.42,general text,,0,0,0,,الجسد الذي ولدت به قد تحول منذ زمن طويل إلى غبار
Dialogue: 0,1:07:04.51,1:07:07.18,نص عام,,0,0,0,,هذا الجسد لم يكن ملكي
Dialogue: 0,1:07:09.39,1:07:10.26,خط مائل,,0,0,0,,انتظر
Dialogue: 0,1:07:11.01,1:07:13.77,نص عام,,0,0,0,,إذن أنت بدويّ؟
Dialogue: 0,1:07:13.85,1:07:14.85,نص عام,,0,0,0,,نعم
Dialogue: 0,1:07:15.89,1:07:18.27,نص عام,,0,0,0,,أنا بدوي
Dialogue: 0,1:07:26.95,1:07:28.24,نص عام,,0,0,0,,صاحب الجلالة،
Dialogue: 0,1:07:28.32,1:07:32.45,general text,,0,0,0,,اتصلت بي للعثور على بدو آخر؟
Dialogue: 0,1:07:33.04,1:07:34.20,نص عام,,0,0,0,,سوف أجده
Dialogue: 0,1:07:34.87,1:07:38.17,نص عام,,0,0,0,,أستطيع أن أعرف من هو البدو
Dialogue: 0,1:07:49.51,1:07:53.56,تعليق صوتي,,0,0,0,,كان يعلم منذ البداية أن مو دوك كان بدويًا
Dialogue: 0,1:08:18.71,1:08:19.58,نص عام,,0,0,0,,إنه أنت
Dialogue: 0,1:08:20.79,1:08:22.38,النص العام,,0,0,0,,قتله
Dialogue: 0,1:09:04.92,1:09:06.55,preview,,0,0,0,,لماذا يوجد الكثير من الجثث هنا؟
Dialogue: 0,1:09:06.63,1:09:09.05,preview,,0,0,0,,ما نوع الحياة التي عاشها مو ديوك؟
Dialogue: 0,1:09:09.13,1:09:11.93,معاينة,,0,0,0,,مو دوك يخفي شيئًا ما
Dialogue: 0,1:09:12.01,1:09:14.80,preview,,0,0,0,,- ما الذي لا يمكن كشفه\N- أيتها الأمهات!
Dialogue: 0,1:09:15.68,1:09:17.64,معاينة,,0,0,0,,سيبدأ بدلاً من ذلك بالنباح
Dialogue: 0,1:09:18.39,1:09:22.10,preview,,0,0,0,,كما اعتقدت، هناك أكثر من بدو في القصر
Dialogue: 0,1:09:22.19,1:09:24.69,preview,,0,0,0,,إذا تبين أن نجم الملك هو من صنع السحر الأسود،
Dialogue: 0,1:09:24.77,1:09:27.19,معاينة,,0,0,0,,غابة الصنوبر ستنتهي
Dialogue: 0,1:09:27.73,1:09:28.57,معاينة,,0,0,0,,هذا أمر خطير
Dialogue: 0,1:09:28.65,1:09:31.24,preview,,0,0,0,,أنت لا تعرفها، لكنها تعرف مو دوك
Dialogue: 0,1:09:31.32,1:09:32.49,معاينة,,0,0,0,,نحن بحاجة إلى تشانغ جانج
Dialogue: 0,1:09:32.57,1:09:35.08,معاينة,,0,0,0,,سننتظر عودته
Dialogue: 0,1:09:36.37,1:09:37.95,preview,,0,0,0,,مو دوك، لماذا أنت هنا؟
Dialogue: 0,1:09:38.04,1:09:40.25,معاينة,,0,0,0,,لا أستطيع ترك سيدي
Dialogue: 0,1:09:40.33,1:09:43.50,معاينة,,0,0,0,,أحبني حتى تموت
Dialogue: 0,0:23:37.32,0:23:39.32,معاينة,,0,0,0,,

