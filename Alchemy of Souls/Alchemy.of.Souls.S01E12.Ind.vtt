Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Koordinator dan editor proyek: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:01:18.77,0:01:21.19,teks umum,,0,0,0,,Orang akan bergosip jika kamu tiba-tiba menghilang
Dialog: 0,0:01:21.28,0:01:23.49,teks umum,,0,0,0,,Kematian di depan saksi
Dialog: 0,0:01:23.57,0:01:25.78,teks umum,,0,0,0,,akan menyederhanakan segalanya
Dialog: 0,0:01:27.91,0:01:29.66,teks umum,,0,0,0,,Saya ingin menyelamatkan muka
Dialog: 0,0:01:30.66,0:01:32.62,teks umum,,0,0,0,,Saya berharap kematian itu layak
Dialog: 0,0:01:37.71,0:01:39.88,teks umum,,0,0,0,,- Guru!\N- Guru!
Dialog: 0,0:01:43.26,0:01:44.34,teks umum,,0,0,0,,Apa yang dia katakan?
Dialog: 0,0:01:44.43,0:01:46.34,teks umum,,0,0,0,,- Apa ini?\N- Lihat!
Dialog: 0,0:01:47.05,0:01:48.93,teks umum,,0,0,0,,Tentara Bayaran!
Dialog: 0,0:02:18.46,0:02:20.42,teks umum,,0,0,0,,Master
Dialogue: 0,0:02:29.09,0:02:32.31,teks umum,,0,0,0,,Aku menggunakan tubuhmu dengan bermartabat
Dialog: 0,0:03:25.94,0:03:26.82,teks umum,,0,0,0,,Host
Dialog: 0,0:03:30.07,0:03:32.24,teks umum,,0,0,0,,Astaga
Dialog: 0,0:03:38.83,0:03:40.00,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:03:40.96,0:03:41.96,teks umum,,0,0,0,,Jangan datang
Dialog: 0,0:03:46.84,0:03:47.76,miring,,0,0,0,,Malu
Dialog: 0,0:03:47.84,0:03:50.47,teks umum,,0,0,0,,Hari ini dia semakin menderita
Dialog: 0,0:03:50.55,0:03:52.80,teks umum,,0,0,0,,- Tinggal dua lagi?\N- Ya
Dialog: 0,0:03:54.18,0:03:56.43,teks umum,,0,0,0,,Besok Cha Bum
Dialog: 0,0:03:56.52,0:03:58.52,teks umum,,0,0,0,,Aku tidak ingin melihat Inggris kalah darinya
Dialog: 0,0:03:59.18,0:04:00.56,teks umum,,0,0,0,,Mungkin aku harus bertarung?
Dialog: 0,0:04:01.27,0:04:03.23,miring,,0,0,0,,Aku akan membiarkan Uku menang dan selesailah
Dialog: 0,0:04:03.31,0:04:04.77,teks umum,,0,0,0,,Uk akan senang dengan ini
Dialog: 0,0:04:05.27,0:04:07.36,teks umum,,0,0,0,,Perselisihan dengan Putra Mahkota
Dialog: 0,0:04:07.44,0:04:09.03,teks umum,,0,0,0,,Kita harus mengecohnya
Dialog: 0,0:04:12.20,0:04:14.12,teks umum,,0,0,0,,Inggris kalah, tapi mendapat pengalaman
Dialog: 0,0:04:16.20,0:04:17.20,teks umum,,0,0,0,,Host
Dialog: 0,0:04:17.29,0:04:19.96,teks umum,,0,0,0,,Masuk ke kamarmu, aku akan membawakan handuk
Dialog: 0,0:04:28.09,0:04:30.88,teks umum,,0,0,0,,Saya tidak tahu siapa yang terakhir melawannya,
Dialog: 0,0:04:32.89,0:04:34.85,teks umum,,0,0,0,,tapi mengalahkan Uka tidak akan semudah itu
Dialog: 0,0:04:49.32,0:04:50.32,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:04:54.53,0:04:55.78,teks umum,,0,0,0,,Di mana pemiliknya?
Dialog: 0,0:04:56.37,0:04:57.87,teks umum,,0,0,0,,Oh, apakah kamu mencari dia?
Dialog: 0,0:04:58.66,0:04:59.66,teks umum,,0,0,0,,Ya
Dialogue: 0,0:05:00.45,0:05:02.21,teks umum,,0,0,0,,Kamu adalah Mu Dok, mungkin
Dialog: 0,0:05:03.42,0:05:05.58,teks umum,,0,0,0,,- Ya\N- Begitu
Dialog: 0,0:05:05.67,0:05:08.63,teks umum,,0,0,0,,Orang yang selalu berada di samping Chan Wook
Dialog: 0,0:05:09.21,0:05:12.42,di belakang layar,,0,0,0,,Burung bangau yang dibicarakan oleh pelayan Kim
Dialog: 0,0:05:12.93,0:05:15.76,miring,,0,0,0,,Aku datang menemuinya sebelum pergi
Dialog: 0,0:05:15.84,0:05:17.26,teks umum,,0,0,0,,Enter. A...
Dialog: 0,0:05:17.35,0:05:20.31,teks umum,,0,0,0,,Saya membawa makanan ringan. Ingin?
Dialog: 0,0:05:21.14,0:05:22.14,teks umum,,0,0,0,,Tidak, terima kasih
Dialog: 0,0:05:30.65,0:05:33.78,teks umum,,0,0,0,,Dia anggun dan lembut, seperti yang dikatakan pelayan Kim
Dialog: 0,0:06:34.01,0:06:36.30,teks umum,,0,0,0,,Kenapa kamu berdiri di sini basah?
Dialog: 0,0:06:38.30,0:06:39.68,teks umum,,0,0,0,,Hei, lihat
Dialogue: 0,0:06:57.45,0:06:59.07,teks umum,,0,0,0,,Orang itu yang melakukannya, bukan?
Dialog: 0,0:06:59.66,0:07:01.83,teks umum,,0,0,0,,Kita harus mencobanya dengan pedang
Dialog: 0,0:07:02.74,0:07:05.62,teks umum,,0,0,0,,Kupikir kamu kesal karena terjatuh ke air
Dialog: 0,0:07:06.50,0:07:08.42,teks umum,,0,0,0,,Dan kamu menilai pertarunganmu
Dialog: 0,0:07:08.92,0:07:11.75,teks umum,,0,0,0,,Beberapa kali pertama seperti ini
Dialog: 0,0:07:11.84,0:07:13.84,teks umum,,0,0,0,,Aku hanya marah karena kalah delapan kali
Dialog: 0,0:07:15.92,0:07:19.38,teks umum,,0,0,0,,Kamu terbiasa berjalan-jalan dalam keadaan bersih dan menyetrika,
Dialog: 0,0:07:19.47,0:07:22.35,teks umum,,0,0,0,,dan sekarang kamu berdiri dalam keadaan basah dan kotor, yang artinya,
Dialog: 0,0:07:23.47,0:07:24.85,teks umum,,0,0,0,,apakah kamu serius
Dialog: 0,0:07:28.10,0:07:29.65,teks umum,,0,0,0,,Kotor banget
Dialog: 0,0:07:34.82,0:07:36.82,teks umum,,0,0,0,,Kamu terburu-buru hari ini
Dialog: 0,0:07:36.90,0:07:40.24,teks umum,,0,0,0,,Tidak perlu menyerang saat dia bertahan
Dialog: 0,0:07:40.32,0:07:43.28,teks umum,,0,0,0,,Layak menunggu dia melemahkan pertahanannya
Dialog: 0,0:07:44.33,0:07:45.49,teks umum,,0,0,0,,Ya
Dialog: 0,0:07:45.58,0:07:48.33,teks umum,,0,0,0,,Jika kamu mundur selangkah setelah pukulan,
Dialog: 0,0:07:48.41,0:07:51.79,teks umum,,0,0,0,,dia akan rileks dan melemah
Dialog: 0,0:07:51.88,0:07:53.34,teks umum,,0,0,0,,perlindungan
Dialog: 0,0:07:54.09,0:07:56.13,teks umum,,0,0,0,,Pertempuran adalah permainan tarik tambang
Dialog: 0,0:07:56.76,0:07:59.51,teks umum,,0,0,0,,Musuh akan menarikmu ketika dia memutuskan bahwa kamu melemah
Dialog: 0,0:08:00.68,0:08:02.64,teks umum,,0,0,0,,Maka kamu perlu menyerang
Dialog: 0,0:08:04.30,0:08:06.14,teks umum,,0,0,0,,Terima kasih atas sarannya, tuan
Dialog: 0,0:08:11.56,0:08:12.52,teks umum,,0,0,0,,Mau kemana?
Dialog: 0,0:08:14.06,0:08:16.07,teks umum,,0,0,0,,Berenang dan berganti pakaian
Dialog: 0,0:08:16.15,0:08:17.78,teks umum,,0,0,0,,aku sudah mencium
Dialog: 0,0:08:19.19,0:08:21.36,kenangan,,0,0,0,,Ah, kamu sedang mencari dia
Dialog: 0,0:08:28.91,0:08:30.21,teks umum,,0,0,0,,Jangan pergi
Dialog: 0,0:08:33.88,0:08:35.88,teks umum,,0,0,0,,Jangan pergi ke tempatmu, tetap di sini
Dialog: 0,0:08:36.75,0:08:39.30,teks umum,,0,0,0,,- Saya akan membawa pakaian\N- Mengapa?
Dialog: 0,0:08:39.38,0:08:41.22,teks umum,,0,0,0,,Aku bisa ganti baju
Dialogue: 0,0:08:42.18,0:08:43.93,teks umum,,0,0,0,,Kenapa terlalu memaksakan diri seperti orang bodoh?
Dialog: 0,0:08:49.31,0:08:50.39,teks umum,,0,0,0,,Kamu benar
Dialog: 0,0:08:52.48,0:08:54.10,teks umum,,0,0,0,,Berperilaku seperti orang bodoh
Dialog: 0,0:08:58.48,0:08:59.40,teks umum,,0,0,0,,Pergi
Dialog: 0,0:09:04.07,0:09:05.12,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:09:05.20,0:09:06.62,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:09:08.45,0:09:09.49,teks umum,,0,0,0,,Apa?
Dialog: 0,0:09:16.59,0:09:17.75,teks umum,,0,0,0,,Duduk
Dialog: 0,0:09:18.59,0:09:19.76,teks umum,,0,0,0,,Ya, duduk
Dialog: 0,0:09:25.68,0:09:27.85,teks umum,,0,0,0,,Lihat sepatunya. Semua basah
Dialog: 0,0:09:31.14,0:09:31.98,teks umum,,0,0,0,,Mengapa...
Dialog: 0,0:09:33.23,0:09:35.94,teks umum,,0,0,0,,Kenapa kamu malah mengikutiku ke dalam air?
Dialogue: 0,0:09:38.82,0:09:43.03,teks umum,,0,0,0,,Terkadang kamu bekerja terlalu keras
Dialogue: 0,0:09:43.11,0:09:45.74,teks umum,,0,0,0,,Kenapa susah payah bersih-bersih?
Dialog: 0,0:09:45.82,0:09:48.20,teks umum,,0,0,0,,Istirahat, mengacu pada saya
Dialogue: 0,0:09:50.45,0:09:53.41,teks umum,,0,0,0,,Pembantu Kim mengirim telinga kering ke Corwin
Dialog: 0,0:09:53.50,0:09:56.37,teks umum,,0,0,0,,Makan sendiri juga, jangan serahkan semuanya padaku
Dialog: 0,0:09:57.67,0:09:58.88,teks umum,,0,0,0,,Jangan khawatir
Dialogue: 0,0:10:00.96,0:10:03.67,teks umum,,0,0,0,,Mereka memperlakukanku dengan baik karena aku dekat dengan Dan Gu,
Dialog: 0,0:10:03.76,0:10:05.18,teks umum,,0,0,0,,pewaris Sosnovy Bor
Dialog: 0,0:10:07.26,0:10:08.39,teks umum,,0,0,0,,Begini caranya
Dialog: 0,0:10:09.51,0:10:13.60,teks umum,,0,0,0,,Saya tahu Anda menggunakan kekuatan untuk keuntungan Anda
Dialog: 0,0:10:20.65,0:10:22.07,teks umum,,0,0,0,,Kamu terluka
Dialogue: 0,0:10:24.49,0:10:26.36,teks umum,,0,0,0,,Aku bertarung selama delapan hari berturut-turut
Dialog: 0,0:10:27.45,0:10:28.87,teks umum,,0,0,0,,Ini bukan satu-satunya luka
Dialog: 0,0:10:31.37,0:10:32.74,teks umum,,0,0,0,,Di mana lagi?
Dialog: 0,0:10:33.58,0:10:35.50,teks umum,,0,0,0,,Kita harus pergi ke Sejukwon
Dialog: 0,0:10:35.58,0:10:37.17,teks umum,,0,0,0,,Masih ada pertempuran tersisa
Dialog: 0,0:10:39.63,0:10:41.46,teks umum,,0,0,0,,Kita harus sangat menderita,
Dialog: 0,0:10:42.80,0:10:44.55,teks umum,,0,0,0,,sejauh tuanku menunggu
Dialog: 0,0:11:00.86,0:11:02.23,teks umum,,0,0,0,,Kaki akan membeku
Dialog: 0,0:11:03.36,0:11:04.78,teks umum,,0,0,0,,Kamu juga ganti baju
Dialog: 0,0:11:46.53,0:11:47.65,teks umum,,0,0,0,,Maiden Kim?
Dialog: 0,0:12:01.54,0:12:03.25,teks umum,,0,0,0,,Selesai, Yang Mulia
Dialog: 0,0:12:03.34,0:12:06.34,teks umum,,0,0,0,,Obatnya pahit. Ada yang manis-manis?
Dialog: 0,0:12:06.42,0:12:08.59,teks umum,,0,0,0,,Aku akan membawa sesuatu
Dialogue: 0,0:12:19.35,0:12:21.56,memori miring,,0,0,0,,Harus ada giok merahnya juga
Dialog: 0,0:12:22.44,0:12:24.48,kenangan miring,,0,0,0,,Mereka hanya bernilai berpasangan
Dialogue: 0,0:12:26.19,0:12:27.82,teks umum,,0,0,0,,Mungkin sebaiknya aku membuangnya saja?
Dialog: 0,0:13:07.23,0:13:08.57,teks umum,,0,0,0,,Apa?..
Dialog: 0,0:13:09.15,0:13:10.36,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:13:18.87,0:13:21.00,di belakang layar,,0,0,0,,Apa ini?
Dialog: 0,0:13:33.22,0:13:37.64,di luar layar,,0,0,0,,Sesuatu memanggilku dengan kekuatan luar biasa
Dialog: 0,0:13:41.47,0:13:43.10,di belakang layar,,0,0,0,,Atraksi yang tak bisa dijelaskan...
Dialogue: 0,0:13:44.23,0:13:45.19, sulih suara,,0,0,0,,Dia memanggilku
Dialog: 0,0:14:37.53,0:14:39.03,teks umum,,0,0,0,,- Sial\N- Betul
Dialog: 0,0:14:39.12,0:14:41.45,teks umum,,0,0,0,,Mengapa perlu menuangkan energi ke dalam batu giok
Dialog: 0,0:14:41.53,0:14:43.54,teks umum,,0,0,0,,dan jadi membuatku bingung?
Dialog: 0,0:14:43.62,0:14:45.50,teks umum,,0,0,0,,Ini cukup menyinggung
Dialog: 0,0:14:45.58,0:14:46.41,teks umum,,0,0,0,,Hal yang sama
Dialog: 0,0:14:46.50,0:14:51.04,teks umum,,0,0,0,,Aku tersinggung karena jantungku berdebar kencang karenamu!
Dialogue: 0,0:14:55.88,0:14:56.93,teks umum,,0,0,0,,Dan kamu...
Dialogue: 0,0:14:57.97,0:14:59.14,teks umum,,0,0,0,,merasakan juga?
Dialog: 0,0:15:00.51,0:15:03.93,teks umum,,0,0,0,,Jantungku berdebar begitu...
Dialog: 0,0:15:06.56,0:15:08.31,teks umum,,0,0,0,,- Oh...\N- Jangan bilang
Dialog: 0,0:15:11.02,0:15:12.15,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:15:12.94,0:15:14.15,teks umum,,0,0,0,,Kamu sangat terkejut,
Dialog: 0,0:15:14.98,0:15:17.03,teks umum,,0,0,0,,yang berarti saya belum pernah menggunakannya
Dialog: 0,0:15:17.86,0:15:18.78,teks umum,,0,0,0,,Ya
Dialog: 0,0:15:18.86,0:15:20.41,teks umum,,0,0,0,,Moo Dok tidak punya sihir
Dialog: 0,0:15:21.07,0:15:22.70,teks umum,,0,0,0,,Kamu tidak bisa bertukar energi
Dialog: 0,0:15:22.78,0:15:23.87,teks umum,,0,0,0,,Ya
Dialogue: 0,0:15:24.41,0:15:27.08,teks umum,,0,0,0,,Aku tidak tahu giok ini punya kekuatan sebesar itu
Dialog: 0,0:15:42.68,0:15:44.39,teks umum,,0,0,0,,Cukup
Dialog: 0,0:15:45.77,0:15:47.77,teks umum,,0,0,0,,Pokoknya,
Dialog: 0,0:15:48.56,0:15:50.06,teks umum,,0,0,0,,Saya belajar sesuatu yang baru
Dialog: 0,0:15:50.90,0:15:52.81,teks umum,,0,0,0,,- Terima kasih\N- Apa?
Dialog: 0,0:15:52.90,0:15:53.98,teks umum,,0,0,0,,Apakah menurut Anda saya harus menggunakannya?
Dialog: 0,0:15:55.02,0:15:56.36,teks umum,,0,0,0,,Sepertinya kamu tidak bisa
Dialog: 0,0:15:57.78,0:15:59.15,teks umum,,0,0,0,,Moo Dok tidak akan mendapatkannya kembali
Dialog: 0,0:15:59.24,0:16:01.20,teks umum,,0,0,0,,Aku punya dua pertarungan lagi
Dialog: 0,0:16:01.74,0:16:03.78,teks umum,,0,0,0,,Saya akan mengembalikannya dan menggunakannya
Dialog: 0,0:16:03.87,0:16:05.83,teks umum,,0,0,0,,Simpan sampai saat itu
Dialog: 0,0:16:07.33,0:16:08.83,teks umum,,0,0,0,,Dan tolong,
Dialog: 0,0:16:09.50,0:16:10.92,teks umum,,0,0,0,,jangan bermain-main dengan energi
Dialog: 0,0:16:12.88,0:16:14.42,teks umum,,0,0,0,,Kamu juga
Dialog: 0,0:16:19.80,0:16:22.18,teks umum,,0,0,0,,Yang Mulia, dari mana saja Anda?
Dialogue: 0,0:16:23.60,0:16:24.76,kenangan miring,,0,0,0,,Bawa kamu masuk?
Dialog: 0,0:16:26.26,0:16:27.31,kenangan,,0,0,0,,aku bisa
Dialog: 0,0:16:27.93,0:16:30.23,kenangan,,0,0,0,,Kamu akan mencari pekerjaan di sini
Dialog: 0,0:16:31.64,0:16:32.77,kenangan,,0,0,0,,aku tidak mau
Dialog: 0,0:16:33.86,0:16:35.69,teks umum,,0,0,0,,- Kasim O\N- Ya?
Dialog: 0,0:16:35.77,0:16:38.69,teks umum,,0,0,0,,Cari tahu siapa selanjutnya yang bertarung melawan Uka
Dialog: 0,0:16:39.28,0:16:40.24,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:40.86,0:16:42.03,teks umum,,0,0,0,,Jangan salah
Dialog: 0,0:16:42.70,0:16:43.87,prasasti,,0,0,0,,Seni Hyonggon
Dialog: 0,0:16:43.95,0:16:44.82,teks umum,,0,0,0,,Hei,
Dialog: 0,0:16:44.91,0:16:46.83,teks umum,,0,0,0,,bagaimana kamu menyukai pertarungannya?
Dialog: 0,0:16:46.91,0:16:50.04,teks umum,,0,0,0,,Dengan Chan Wook? Semudah mengupas buah pir
Dialogue: 0,0:16:50.96,0:16:53.17,italic,,0,0,0,,- Siapkah kamu?\N- Tentu saja
Dialog: 0,0:16:53.25,0:16:55.71,teks umum,,0,0,0,,Lagipula aku pakai Hyunggon...
Dialog: 0,0:16:59.38,0:17:02.05,di belakang layar,,0,0,0,,Seorang pesulap dari keluarga Cha pemilik Hyunggon
Dialog: 0,0:17:02.72,0:17:04.76,di luar layar,,0,0,0,,Dia memperhatikan Inggris sepanjang waktu
Dialog: 0,0:17:04.84,0:17:08.68,di belakang layar,,0,0,0,,Seorang pengecut yang memutuskan bertarung hanya setelah Chan Wook kalah
Dialogue: 0,0:17:09.56,0:17:11.48,italic,,0,0,0,,Uk bisa kalahkan dia
Dialog: 0,0:17:15.10,0:17:18.15,teks umum,,0,0,0,,Hyonggon adalah seni yang menakjubkan
Dialog: 0,0:17:18.82,0:17:21.19,teks umum,,0,0,0,,Tapi tidak ada gunanya jika kamu kurang keterampilan
Dialog: 0,0:17:22.11,0:17:24.16,teks umum,,0,0,0,,Cha Bum terlihat cukup menakutkan,
Dialog: 0,0:17:24.24,0:17:25.66,teks umum,,0,0,0,,tapi ini hanya fasad
Dialog: 0,0:17:26.70,0:17:29.16, sulih suara,,0,0,0,,Jadi Yul membaca orang lain dengan mudah, tak heran
Dialog: 0,0:17:29.66,0:17:30.75,teks umum,,0,0,0,,Ya?
Dialog: 0,0:17:31.29,0:17:33.67,teks umum,,0,0,0,,Dan dia berkeliling memberi tahu semua orang betapa mudahnya hal itu
Dialog: 0,0:17:34.21,0:17:35.96,teks umum,,0,0,0,,kalahkan pemiliknya
Dialog: 0,0:17:36.04,0:17:37.13,teks umum,,0,0,0,,Dia hanya takut
Dialog: 0,0:17:38.00,0:17:40.42,teks umum,,0,0,0,,Inggris telah meningkat secara signifikan akhir-akhir ini
Dialog: 0,0:17:41.05,0:17:43.63,teks umum,,0,0,0,,Bom takut Inggris akan mengalahkannya
Dialog: 0,0:17:44.84,0:17:49.10,teks umum,,0,0,0,,Jadi tuanku telah meningkat pesat sehingga dia membuat orang lain khawatir
Dialogue: 0,0:17:51.85,0:17:54.10,teks umum,,0,0,0,,Apakah kamu senang Inggris menjadi lebih kuat?
Dialog: 0,0:17:54.19,0:17:57.11,teks umum,,0,0,0,,Tentu saja. Kebanggaan langsung ke langit
Dialog: 0,0:17:58.52,0:18:01.48,sulih suara,,0,0,0,,Nak Soo melatih Wook
Dialog: 0,0:18:01.57,0:18:02.65,miring,,0,0,0,,Yul
Dialogue: 0,0:18:05.53,0:18:06.91,teks umum,,0,0,0,,Pernah dengar?
Dialog: 0,0:18:06.99,0:18:08.70,teks umum,,0,0,0,,Ada keributan di ibu kota
Dialog: 0,0:18:09.58,0:18:10.74,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:18:10.83,0:18:14.46,teks umum,,0,0,0,,Tuan Kang dari Degantongun meninggal karena sakit
Dialog: 0,0:18:15.83,0:18:16.87,teks umum,,0,0,0,,Tapi ada rumor,
Dialog: 0,0:18:17.54,0:18:19.67,teks umum,,0,0,0,,bahwa dia diserang oleh tentara bayaran tadi malam
Dialog: 0,0:18:20.96,0:18:23.84,miring,,0,0,0,,Paman dan Tuan Huo pergi ke pemakaman
Dialog: 0,0:18:24.42,0:18:27.18,teks umum,,0,0,0,,Dan apakah ini tentara bayaran yang sama dengan Nak Su?
Dialog: 0,0:18:39.19,0:18:41.73,prasasti,,0,0,0,,Almarhum Kang Man Jung
Dialog: 0,0:18:43.69,0:18:46.03,miring,,0,0,0,,Mengapa kami tidak bisa menyampaikan belasungkawa?
Dialog: 0,0:18:47.82,0:18:50.78,teks umum,,0,0,0,,Keluarga kami mengangkut barang-barang mahal
Dialog: 0,0:18:50.87,0:18:53.45,teks umum,,0,0,0,,Jika orang mengetahui bahwa kepala rumah
Dialog: 0,0:18:53.54,0:18:57.25,teks umum,,0,0,0,,dibunuh oleh tentara bayaran, keluarga akan kehilangan pekerjaan
Dialog: 0,0:18:57.96,0:18:59.54,teks umum,,0,0,0,,Diumumkan bahwa dia meninggal karena penyakit menular
Dialog: 0,0:19:00.13,0:19:01.46,teks umum,,0,0,0,,Jadi tidak ada yang bisa masuk
Dialog: 0,0:19:04.76,0:19:06.42,teks umum,,0,0,0,,Mengerti
Dialog: 0,0:19:06.51,0:19:09.30,teks umum,,0,0,0,,Apakah ada petunjuk yang bisa membantu menemukan tentara bayaran?
Dialog: 0,0:19:11.26,0:19:12.93,teks umum,,0,0,0,,Sudahkah Anda melakukan otopsi?
Dialog: 0,0:19:14.64,0:19:18.06,teks umum,,0,0,0,,Tuan Kahn ditikam sampai mati dengan pedang di depan mata kita
Dialog: 0,0:19:18.65,0:19:19.98,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:19:21.61,0:19:23.40,teks umum,,0,0,0,,Tubuhnya akan dibakar malam ini
Dialog: 0,0:19:23.48,0:19:25.03,teks umum,,0,0,0,,Sebentar lagi?
Dialog: 0,0:19:25.61,0:19:26.74,teks umum,,0,0,0,,Ini sangat disayangkan,
Dialog: 0,0:19:26.82,0:19:28.66,teks umum,,0,0,0,,tapi kita harus cepat sebelum rumor menyebar
Dialog: 0,0:19:28.74,0:19:32.66,teks umum,,0,0,0,,Saya yakin Guru Kan juga menginginkan hal yang sama
Dialog: 0,0:19:32.74,0:19:33.79,teks umum,,0,0,0,,Ini tidak bisa diterima
Dialog: 0,0:19:33.87,0:19:36.00,teks umum,,0,0,0,,Jika kamu mengkremasinya,
Dialog: 0,0:19:36.66,0:19:39.25,teks umum,,0,0,0,,tidak akan ada bukti pembunuhan
Dialog: 0,0:19:41.67,0:19:43.13,teks umum,,0,0,0,,Ini masalah keluarga
Dialog: 0,0:19:44.46,0:19:46.30,teks umum,,0,0,0,,Saya mengerti Anda khawatir
Dialog: 0,0:19:47.30,0:19:50.30,teks umum,,0,0,0,,Tetapi kepala Sosnovy Bor tidak perlu terlibat dalam hal ini
Dialog: 0,0:19:51.59,0:19:54.01,teks umum,,0,0,0,,Otopsi diperlukan
Dialog: 0,0:19:54.10,0:19:55.81,teks umum,,0,0,0,,Tunda kremasi
Dialog: 0,0:19:57.18,0:20:01.02,teks umum,,0,0,0,,Sosnovy Bor sudah sampai pada titik mengganggu pemakaman orang lain?
Dialog: 0,0:20:04.40,0:20:05.73,teks umum,,0,0,0,,Kami tidak ikut campur
Dialog: 0,0:20:06.48,0:20:10.74,teks umum,,0,0,0,,Saya mencoba memperingatkan kepala rumah yang baru
Dialog: 0,0:20:10.82,0:20:12.74,teks umum,,0,0,0,,dari kesalahan yang tidak dapat diperbaiki
Dialogue: 0,0:20:12.82,0:20:14.87,teks umum,,0,0,0,,Mengapa kamu menentangnya?
Dialog: 0,0:20:14.95,0:20:16.49,teks umum,,0,0,0,,Hak apa yang kamu punya?
Dialog: 0,0:20:16.58,0:20:20.12,miring,,0,0,0,,Belum lama ini, para penyihir diserang oleh Nak Su
Dialog: 0,0:20:20.21,0:20:22.29,teks umum,,0,0,0,,Sekarang tentara bayaran baru telah muncul
Dialog: 0,0:20:23.04,0:20:25.75,teks umum,,0,0,0,,Mungkin ada hubungan antara kasus ini dan keajaiban Nak Su
Dialogue: 0,0:20:26.42,0:20:27.63,teks umum,,0,0,0,,Jadi aku ikut campur
Dialog: 0,0:20:28.84,0:20:30.68,teks umum,,0,0,0,,Tidak ada keajaiban
Dialog: 0,0:20:30.76,0:20:31.68,teks umum,,0,0,0,,Saya dapat mengonfirmasi
Dialog: 0,0:20:31.76,0:20:33.64,teks umum,,0,0,0,,Dari mana datangnya keyakinan seperti itu tanpa otopsi?!
Dialog: 0,0:20:35.05,0:20:38.47,teks umum,,0,0,0,,Kepala tidak mau melakukan otopsi
Dialog: 0,0:20:38.56,0:20:40.77,teks umum,,0,0,0,,Jin Mu, diam saja
Dialog: 0,0:20:41.35,0:20:43.40,teks umum,,0,0,0,,Kami berhak campur tangan,
Dialog: 0,0:20:43.48,0:20:45.06,teks umum,,0,0,0,,jika kita berbicara tentang sihir
Dialog: 0,0:20:45.15,0:20:47.61,teks umum,,0,0,0,,Apakah Anda setuju, Bu Jin?
Dialog: 0,0:20:49.57,0:20:50.95,teks umum,,0,0,0,,menurutku,
Dialog: 0,0:20:52.53,0:20:55.12,teks umum,,0,0,0,,kali ini deputinya benar
Dialog: 0,0:20:58.95,0:21:01.50,teks umum,,0,0,0,,Kepala baru mengkonfirmasi kematian Master Kahn
Dialog: 0,0:21:01.58,0:21:05.13,teks umum,,0,0,0,,Dan dia tidak punya pilihan selain menyembunyikan alasan sebenarnya
Dialog: 0,0:21:07.00,0:21:09.96,teks umum,,0,0,0,,Tidak ada bukti yang menunjukkan sihir
Dialog: 0,0:21:11.30,0:21:15.14,teks umum,,0,0,0,,Jadi saya ragu Sosnovy Bor punya sesuatu untuk ditangkap di sini
Dialog: 0,0:21:21.98,0:21:24.19,teks umum,,0,0,0,,Saya hanya ingin menjaga martabat tuan
Dialog: 0,0:21:24.27,0:21:27.73,teks umum,,0,0,0,,Mari kita lanjutkan dengan pemakaman
Dialog: 0,0:21:50.71,0:21:53.93,teks umum,,0,0,0,,Jin Mu terang-terangan mengabaikan kita
Dialogue: 0,0:21:56.93,0:21:59.22,teks umum,,0,0,0,,Mengapa mereka begitu menentangnya?
Dialog: 0,0:22:00.39,0:22:02.56,teks umum,,0,0,0,,- Aneh\N- Dan juga,
Dialog: 0,0:22:02.64,0:22:06.77,teks umum,,0,0,0,,Saya tidak mengira Nyonya Jin akan memihaknya
Dialog: 0,0:22:07.36,0:22:09.69,teks umum,,0,0,0,,Dia membenci saudara tirinya
Dialog: 0,0:22:13.90,0:22:17.11,teks umum,,0,0,0,,Aku senang saat kamu memihakku
Dialog: 0,0:22:18.99,0:22:20.03,teks umum,,0,0,0,,Nilai sendiri
Dialog: 0,0:22:20.12,0:22:24.33,teks umum,,0,0,0,,Segera setelah kita bersatu, Sosnovny Bor harus menyerah
Dialogue: 0,0:22:26.08,0:22:28.04,teks umum,,0,0,0,,Bagaimana pencarian Boo Young?
Dialog: 0,0:22:30.55,0:22:32.96,teks umum,,0,0,0,,Kami mencari di sekeliling danau
Dialog: 0,0:22:33.05,0:22:36.09,teks umum,,0,0,0,,mencari gadis buta seumuran
Dialog: 0,0:22:37.68,0:22:41.26,teks umum,,0,0,0,,Saya telah melakukan ini selama sepuluh tahun terakhir
Dialog: 0,0:22:41.35,0:22:42.39,teks umum,,0,0,0,,Sejujurnya,
Dialogue: 0,0:22:43.18,0:22:45.81,teks umum,,0,0,0,,Sepertinya aku tahu apa yang terjadi pada Boo Young
Dialog: 0,0:22:47.27,0:22:50.52,teks umum,,0,0,0,,Sepuluh tahun yang lalu, seorang gadis kecil terdampar di tepi sungai
Dialog: 0,0:22:52.19,0:22:54.15,teks umum,,0,0,0,,- Ya?\N- Hanya di sini
Dialog: 0,0:22:56.07,0:22:57.78,teks umum,,0,0,0,,dia sudah lama meninggal
Dialog: 0,0:23:04.70,0:23:08.54,teks umum,,0,0,0,,Ibu, aku yakin itu bukan dia
Dialog: 0,0:23:08.62,0:23:11.25,teks umum,,0,0,0,,Aku suruh orang-orangku menggali kubur
Dialog: 0,0:23:12.09,0:23:14.46,teks umum,,0,0,0,,Jika Boo Young benar-benar mati,
Dialog: 0,0:23:14.55,0:23:18.13,teks umum,,0,0,0,,Aku akan membawakanmu jenazahnya berapa pun biayanya
Dialog: 0,0:23:18.97,0:23:20.51,teks umum,,0,0,0,,Ini tidak akan berhasil
Dialog: 0,0:23:21.39,0:23:24.06,teks umum,,0,0,0,,Bawakan putriku hidup kembali
Dialog: 0,0:23:25.22,0:23:27.39,teks umum,,0,0,0,,Pastinya, tenang saja
Dialog: 0,0:23:28.56,0:23:30.52,teks umum,,0,0,0,,Kita akan menemukannya hidup
Dialog: 0,0:23:46.41,0:23:48.04,miring,,0,0,0,,Apakah kamu melihatnya dengan baik?
Dialogue: 0,0:23:48.91,0:23:51.21,teks umum,,0,0,0,,calon ibu dan adikmu
Dialog: 0,0:23:51.92,0:23:53.04,teks umum,,0,0,0,,Menurutmu,
Dialog: 0,0:23:53.92,0:23:56.17,teks umum,,0,0,0,,akankah mereka percaya bahwa aku adalah putri mereka?
Dialog: 0,0:23:56.26,0:23:57.59,teks umum,,0,0,0,,Apakah kamu berpakaian?
Dialog: 0,0:23:58.92,0:24:01.80,teks umum,,0,0,0,,seperti Boo Young saat kecil
Dialog: 0,0:24:01.89,0:24:03.89,teks umum,,0,0,0,,Tapi menurutku Ho Kyung tidak akan membelinya
Dialog: 0,0:24:06.35,0:24:08.60,teks umum,,0,0,0,,Lalu pakaian yang indah
Dialog: 0,0:24:10.39,0:24:12.23,teks umum,,0,0,0,,tidak akan menguntungkan kita
Dialog: 0,0:24:12.81,0:24:15.36,teks umum,,0,0,0,,Aku pasti terlihat menyedihkan
Dialog: 0,0:24:16.65,0:24:18.69,teks umum,,0,0,0,,Dia kehilangan putrinya
Dialog: 0,0:24:18.78,0:24:22.82,teks umum,,0,0,0,,Jika dia mengasihaniku, aku hanya akan memenangkan hatinya
Dialog: 0,0:24:25.66,0:24:26.79,teks umum,,0,0,0,,Ya
Dialog: 0,0:24:27.75,0:24:29.46,teks umum,,0,0,0,,Kamu benar, Jadi aku
Dialog: 0,0:24:33.71,0:24:34.96,teks umum,,0,0,0,,Saya pasti akan
Dialog: 0,0:24:37.67,0:24:40.55,teks umum,,0,0,0,,Aku akan menjadi putri keluarga Jin
Dialog: 0,0:24:53.69,0:24:55.31,teks umum,,0,0,0,,Kamu terlihat lebih baik
Dialog: 0,0:24:55.98,0:24:58.23,teks umum,,0,0,0,,Ya, saya cepat pulih
Dialog: 0,0:25:09.62,0:25:11.79,teks umum,,0,0,0,,Seni Hyonggon
Dialog: 0,0:25:12.75,0:25:14.13,teks umum,,0,0,0,,diuraikan
Dialog: 0,0:25:20.13,0:25:23.93,teks umum,,0,0,0,,Saya mempunyai kecurigaan mengenai kematian Tuan Kahn
Dialog: 0,0:25:36.31,0:25:40.07,teks umum,,0,0,0,,Dia kuat, dia ahli dalam mantra
Dialog: 0,0:25:40.15,0:25:42.82,teks umum,,0,0,0,,Tapi dia sudah sekarat karena sakit
Dialog: 0,0:25:43.61,0:25:46.99,teks umum,,0,0,0,,Tidak perlu dikirim sebagai tentara bayaran
Dialog: 0,0:25:47.07,0:25:49.20,teks umum,,0,0,0,,Mungkin ada yang menaruh dendam padanya
Dialog: 0,0:25:49.99,0:25:52.08,teks umum,,0,0,0,,dan ingin bunuh diri
Dialog: 0,0:25:52.16,0:25:53.08,miring,,0,0,0,,Tidak
Dialog: 0,0:25:53.16,0:25:55.00,teks umum,,0,0,0,,Kami belum tahu,
Dialog: 0,0:25:56.21,0:25:58.79,teks umum,,0,0,0,,tapi pasti ada alasan penyerangan itu
Dialog: 0,0:26:01.80,0:26:05.09,teks umum,,0,0,0,,Saat jiwa berpindah ke tubuh baru, tubuh lama tidak diperlukan lagi
Dialog: 0,0:26:05.68,0:26:07.72,teks umum,,0,0,0,,Tetapi menghilangkannya tidaklah mudah
Dialog: 0,0:26:07.80,0:26:11.27,teks umum,,0,0,0,,Di mata orang-orang, ini adalah penyihir yang kuat,
Dialog: 0,0:26:11.35,0:26:13.23,teks umum,,0,0,0,,pejabat atau pedagang
Dialog: 0,0:26:13.89,0:26:16.52,teks umum,,0,0,0,,Jika dia tiba-tiba menghilang, kecurigaan akan muncul
Dialog: 0,0:26:18.31,0:26:23.03,teks umum,,0,0,0,,Nak Soo mengurus ini
Dialogue: 0,0:26:23.11,0:26:25.15,teks umum,,0,0,0,,Apakah kamu berbicara tentang pejuang kegelapan?
Dialog: 0,0:26:27.49,0:26:30.08,teks umum,,0,0,0,,Terima kasih kepada pejuang ini,
Dialog: 0,0:26:30.66,0:26:34.96,teks umum,,0,0,0,,Sosnovy Bor bahkan tidak berpikir bahwa saya menciptakan pengembara
Dialog: 0,0:26:36.29,0:26:38.58,miring,,0,0,0,,Saat aku memburu Nak Su,
Dialog: 0,0:26:38.67,0:26:42.17,teks umum,,0,0,0,,Saya pikir dia gila, yang ingin membuktikan dirinya
Dialog: 0,0:26:42.25,0:26:46.22,teks umum,,0,0,0,,Jadi aku tidak pernah melihat siapa yang dia bunuh
Dialogue: 0,0:26:48.84,0:26:50.76,teks umum,,0,0,0,,Artinya, dia membunuh mereka
Dialog: 0,0:26:51.51,0:26:53.81,teks umum,,0,0,0,,jiwa siapa yang digerakkan Jin Mu?
Dialog: 0,0:26:53.89,0:26:55.31,teks umum,,0,0,0,,Lebih tepatnya itu,
Dialog: 0,0:26:56.39,0:26:59.48,teks umum,,0,0,0,,yang tidak diperlukan setelah perpindahan
Dialog: 0,0:26:59.56,0:27:02.19,teks umum,,0,0,0,,Kamu bilang dia putri Cho Chun
Dialog: 0,0:27:02.98,0:27:07.78,teks umum,,0,0,0,,Jadi dia mengambil gadis kecil itu dan menjadikannya tentara bayaran?
Dialog: 0,0:27:09.57,0:27:11.99,miring,,0,0,0,,Itulah sebabnya aku tidak mengungkapkan identitasku padanya
Dialog: 0,0:27:12.74,0:27:14.95,teks umum,,0,0,0,,dan memaksaku tinggal sendirian di pegunungan
Dialogue: 0,0:27:16.46,0:27:18.71,teks umum,,0,0,0,,Beri dia tidak lebih dari yang dia perlukan untuk bertahan hidup
Dialog: 0,0:27:19.54,0:27:23.46,teks umum,,0,0,0,,Tapi dia bertekad dan tumbuh kuat
Dialog: 0,0:27:25.01,0:27:26.55,teks umum,,0,0,0,,Karena...
Dialog: 0,0:27:27.13,0:27:29.97,teks umum,,0,0,0,,Dia mengira beginilah cara dia membalas dendam pada keluarganya
Dialog: 0,0:27:30.05,0:27:31.55,teks umum,,0,0,0,,Oleh karena itu, aku menuruti Jin Mu
Dialog: 0,0:27:33.47,0:27:35.93,miring,,0,0,0,,Dia sangat membantu
Dialog: 0,0:27:36.52,0:27:39.44,teks umum,,0,0,0,,Dan kemudian seorang pengembara berubah menjadi penelan jiwa
Dialog: 0,0:27:40.10,0:27:41.40,teks umum,,0,0,0,,Untuk alasan ini
Dialog: 0,0:27:42.44,0:27:44.69,teks umum,,0,0,0,,Sosnovy Bor mencurigai alkimia jiwa
Dialog: 0,0:27:45.73,0:27:47.90,teks umum,,0,0,0,,Ketika Jin Mu mengetahui bahwa kami sedang mencarinya,
Dialogue: 0,0:27:48.74,0:27:51.45,teks umum,,0,0,0,,dia takut ketahuan
Dialog: 0,0:27:52.24,0:27:57.16,teks umum,,0,0,0,,Tentunya dia mengirimnya ke Sosnovy Bor, mengetahui bahwa dia akan mati
Dialog: 0,0:28:10.47,0:28:12.76,teks umum,,0,0,0,,Mu Dok, bawakan air
Dialog: 0,0:28:12.85,0:28:13.89,teks umum,,0,0,0,,Oke
Dialogue: 0,0:28:22.44,0:28:25.69,teks umum,,0,0,0,,Moo Dok, apa kamu tidak mendengarkanku?
Dialog: 0,0:28:25.77,0:28:27.82,teks umum,,0,0,0,,Sudah kubilang istirahat
Dialog: 0,0:28:30.82,0:28:32.41,teks umum,,0,0,0,,Dan bagaimana dengan dirimu sendiri?
Dialogue: 0,0:28:32.49,0:28:34.45,teks umum,,0,0,0,,Sudah kubilang sembuhkan lukanya
Dialog: 0,0:28:34.53,0:28:37.75,teks umum,,0,0,0,,Saya pergi ke Sejukwon. Aku mendengarkanmu
Dialog: 0,0:28:41.46,0:28:42.67,teks umum,,0,0,0,,Anda dapat memeriksanya
Dialog: 0,0:28:45.96,0:28:47.17,teks umum,,0,0,0,,Baunya seperti apsintus
Dialog: 0,0:28:54.35,0:28:55.68,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:28:55.76,0:28:59.10,teks umum,,0,0,0,,Aku bertengkar setiap hari. Hanya lelah
Dialog: 0,0:29:06.32,0:29:07.65,teks umum,,0,0,0,,Kehangatan
Dialog: 0,0:29:10.32,0:29:12.45,teks umum,,0,0,0,,Apakah mereka menggosokmu dengan apsintus hangat?
Dialogue: 0,0:29:13.24,0:29:15.37,teks umum,,0,0,0,,Aku hangat ya?
Dialog: 0,0:29:16.83,0:29:19.37,teks umum,,0,0,0,,Ya. Hangat
Dialog: 0,0:29:23.67,0:29:27.46,kenangan miring,,0,0,0,,Dia ditipu dan dikirim ke kematian tertentu
Dialog: 0,0:29:28.50,0:29:29.51,kenangan miring,,0,0,0,,Nak Su...
Dialog: 0,0:29:29.59,0:29:32.42,kenangan miring,,0,0,0,,Kasihan banget sama anak ini
Dialog: 0,0:29:41.85,0:29:43.48,teks umum,,0,0,0,,Kamu sudah tenang. Lepaskan
Dialog: 0,0:29:46.36,0:29:49.40,teks umum,,0,0,0,,- Apakah kamu sudah mengganti sepatumu?\N- Ya
Dialog: 0,0:29:49.48,0:29:51.15,teks umum,,0,0,0,,Apakah kamu makan apa yang dibawakan oleh pelayan Kim?
Dialog: 0,0:29:51.24,0:29:54.53,teks umum,,0,0,0,,Ya. Sebenarnya, aku sudah makan sebelum kamu menyarankannya.
Dialog: 0,0:29:55.11,0:29:57.07,teks umum,,0,0,0,,Bagus sekali, Moo Deok
Dialog: 0,0:29:59.12,0:30:01.75,teks umum,,0,0,0,,Saya tidak tahu kalau batu ini bisa
Dialog: 0,0:30:04.50,0:30:05.58,teks umum,,0,0,0,,Jade yin-yang?
Dialog: 0,0:30:05.67,0:30:07.67,teks umum,,0,0,0,,Aku hanya mengerti karena kamu memberikannya pada pangeran
Dialog: 0,0:30:08.42,0:30:10.00,teks umum,,0,0,0,,Dan apa yang bisa dia lakukan?
Dialog: 0,0:30:10.09,0:30:12.05,teks umum,,0,0,0,,- Tunjukkan\N- Saya tidak bisa
Dialog: 0,0:30:12.13,0:30:13.72,teks umum,,0,0,0,,Saya akan tunjukkan,
Dialog: 0,0:30:13.80,0:30:15.93,teks umum,,0,0,0,,kapan aku akan mengembalikan milikmu
Dialog: 0,0:30:17.43,0:30:18.72,teks umum,,0,0,0,,Kau akan memberikannya padaku
Dialog: 0,0:30:19.72,0:30:21.14,teks umum,,0,0,0,,kapan kamu akan mengambilnya?
Dialog: 0,0:30:22.89,0:30:25.31,teks umum,,0,0,0,,Apa? Tidakkah kamu menerimanya?
Dialog: 0,0:30:28.98,0:30:32.65,teks umum,,0,0,0,,Saya akan mengembalikannya dan menyerahkannya ke tangan Anda
Dialogue: 0,0:30:32.74,0:30:35.53,teks umum,,0,0,0,,Ia mempunyai kekuatan yang besar
Dialog: 0,0:30:35.61,0:30:36.95,teks umum,,0,0,0,,Syukurlah kita tidak mengetahuinya
Dialog: 0,0:30:37.03,0:30:39.58,teks umum,,0,0,0,,Kamu akan terkejut saat melihatnya
Dialog: 0,0:30:43.66,0:30:45.83,teks umum,,0,0,0,,Kekuatan macam apa? Tunjukkan padaku
Dialog: 0,0:30:46.50,0:30:49.38,teks umum,,0,0,0,,Putra Mahkota jatuh ke tanah, mulutnya berbusa
Dialog: 0,0:30:49.96,0:30:51.38,teks umum,,0,0,0,,Mengerikan sekali
Dialog: 0,0:30:51.46,0:30:53.96,teks umum,,0,0,0,,Masuk akal. Dia dari Jinyeowon
Dialog: 0,0:30:54.05,0:30:56.05,teks umum,,0,0,0,,Ini bisa menjadi senjata yang serius
Dialog: 0,0:31:18.74,0:31:20.32,teks umum,,0,0,0,,Halo, Deputi
Dialog: 0,0:31:25.75,0:31:27.33,miring,,0,0,0,,Kepala Sosnovy Bor
Dialog: 0,0:31:27.41,0:31:30.54,teks umum,,0,0,0,,kembali mengamati kremasi secara pribadi
Dialog: 0,0:31:31.21,0:31:33.34,teks umum,,0,0,0,,Apa yang kamu lakukan kali ini?
Dialog: 0,0:31:33.42,0:31:36.17,teks umum,,0,0,0,,Saya datang hanya untuk melihat
Dialog: 0,0:31:37.13,0:31:40.09,teks umum,,0,0,0,,Tetap saja, aku bertemu Guru Kahn untuk terakhir kalinya
Dialog: 0,0:31:40.18,0:31:42.60,teks umum,,0,0,0,,Saya wajib melaksanakannya
Dialog: 0,0:32:15.42,0:32:18.47,kenangan miring,,0,0,0,,Apakah kamu sudah melihat pengembara,
Dialog: 0,0:32:18.55,0:32:20.47,kenangan,,0,0,0,,jadi kamu kenali tanda birunya
Dialog: 0,0:32:21.39,0:32:24.76,kenangan,,0,0,0,,Lihat apakah Tuan Kan mempunyai tanda seperti itu di tubuhnya
Dialog: 0,0:32:24.85,0:32:27.10,kenangan,,0,0,0,,Bahkan jika kita mengungkap alkimia jiwa,
Dialog: 0,0:32:27.18,0:32:29.35,kenangan,,0,0,0,,kita tidak tahu dia pindah ke tubuh siapa
Dialog: 0,0:32:30.73,0:32:34.69,kenangan,,0,0,0,,Kamu harus melakukan sesuatu untuk membantu memecahkan masalah ini
Dialog: 0,0:33:06.31,0:33:09.73,kenangan,,0,0,0,,Saya tahu kamu sudah menguasai Chisa
Dialog: 0,0:33:10.85,0:33:12.85,kenangan,,0,0,0,,Aku tidak sengaja diam mengenai hal ini
Dialog: 0,0:33:12.94,0:33:14.35,kenangan,,0,0,0,,Aku tidak memarahimu
Dialog: 0,0:33:15.27,0:33:16.98,kenangan,,0,0,0,,Apa yang aku minta kamu lakukan,
Dialog: 0,0:33:17.07,0:33:19.61,kenangan,,0,0,0,,sangat berbahaya dan dapat menghilangkan energimu
Dialog: 0,0:33:20.40,0:33:22.74,kenangan,,0,0,0,,Tetapi hanya mereka yang memiliki Chisu yang dapat melakukan ini
Dialog: 0,0:33:23.82,0:33:26.95,kenangan miring,,0,0,0,,Pengembara berubah menjadi penelan jiwa ketika dia kehilangan energi
Dialog: 0,0:33:27.70,0:33:30.12,kenangan miring,,0,0,0,,Badannya masih hangat
Dialogue: 0,0:33:30.87,0:33:33.17,kenangan miring,,0,0,0,,Tuangkan energimu ke dalamnya,
Dialog: 0,0:33:33.75,0:33:36.34,kenangan miring,,0,0,0,,untuk membuatnya liar
Dialog: 0,0:34:03.53,0:34:05.20,teks umum,,0,0,0,,Tuan...
Dialog: 0,0:34:08.78,0:34:10.12,teks umum,,0,0,0,,Apa itu?
Dialog: 0,0:34:10.20,0:34:12.83,teks umum,,0,0,0,,Dia...
Dialog: 0,0:34:27.14,0:34:29.72,teks umum,,0,0,0,,Aku akan mengumpulkan tulang-tulangnya, semuanya mundur
Dialog: 0,0:34:32.81,0:34:35.73,teks umum,,0,0,0,,Ini pengembara,
Dialog: 0,0:34:35.81,0:34:38.98,teks umum,,0,0,0,,yang berubah menjadi batu
Dialog: 0,0:34:41.65,0:34:45.03,teks umum,,0,0,0,,Tak ada yang meragukan keterlibatan sihir di sini
Dialog: 0,0:34:46.41,0:34:48.66,teks umum,,0,0,0,,Bisakah Sosnovy Bor turun tangan sekarang?
Dialog: 0,0:34:56.12,0:35:00.54,teks umum,,0,0,0,,Kamu tidak kesal, kamu bahkan mencoba menyembunyikannya
Dialogue: 0,0:35:01.13,0:35:03.59,teks umum,,0,0,0,,Jadi kamu sudah mengetahuinya
Dialog: 0,0:35:05.92,0:35:06.97,miring,,0,0,0,,Kau tahu,
Dialog: 0,0:35:07.63,0:35:12.51,teks umum,,0,0,0,,bahwa ini adalah pengembara yang menjadi liar
Dialog: 0,0:35:36.25,0:35:38.04,teks umum,,0,0,0,,Keahlianmu menunjukkan hal itu
Dialog: 0,0:35:38.12,0:35:41.25,teks umum,,0,0,0,,bahwa jiwa Guru Kan ada di dalam tubuh ini
Dialog: 0,0:35:42.92,0:35:44.80,teks umum,,0,0,0,,Jadi jiwanya
Dialog: 0,0:35:44.88,0:35:46.97,teks umum,,0,0,0,,mati di tubuhmu
Dialog: 0,0:35:47.05,0:35:48.76,teks umum,,0,0,0,,Omong kosong!
Dialog: 0,0:36:08.24,0:36:09.45,teks umum,,0,0,0,,Kamu jadi liar,
Dialog: 0,0:36:10.03,0:36:11.99,teks umum,,0,0,0,,tanpa darah dan energi
Dialog: 0,0:36:15.24,0:36:18.50,teks umum,,0,0,0,,Semakin banyak energi yang kamu gunakan, semakin cepat kamu berubah menjadi batu
Dialog: 0,0:36:19.12,0:36:20.42,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:36:26.88,0:36:29.09,teks umum,,0,0,0,,Sebaiknya jangan bergerak!
Dialog: 0,0:36:35.35,0:36:37.35,teks umum,,0,0,0,,- Jangan bunuh dia\N- Bunuh dia
Dialogue: 0,0:38:22.87,0:38:25.21,teks umum,,0,0,0,,Pengembara liar itu berbahaya
Dialog: 0,0:38:25.71,0:38:27.50,teks umum,,0,0,0,,Syukurlah, Jeonbugwan menanganinya
Dialog: 0,0:38:28.08,0:38:29.59,teks umum,,0,0,0,,Anda membantu kami,
Dialogue: 0,0:38:29.67,0:38:32.92,teks umum,,0,0,0,,jadi kamu bisa mengambil sedikit kemuliaan
Dialog: 0,0:38:37.01,0:38:39.01,teks umum,,0,0,0,,Tn.
Dialog: 0,0:38:49.06,0:38:51.57,teks umum,,0,0,0,,Karena kita pantas menjadi bagian dari kemuliaan,
Dialog: 0,0:38:51.65,0:38:53.69,teks umum,,0,0,0,,kita akan mengambil tubuhnya dan mempelajarinya
Dialog: 0,0:38:56.15,0:38:57.57,teks umum,,0,0,0,,Tolong
Dialog: 0,0:39:10.92,0:39:12.59,teks umum,,0,0,0,,Aku menutup gerbangnya,
Dialog: 0,0:39:12.67,0:39:15.38,teks umum,,0,0,0,,agar energi tidak bocor
Dialog: 0,0:39:16.13,0:39:18.22,teks umum,,0,0,0,,Hidupkan dia kembali untuk menginterogasinya
Dialog: 0,0:39:19.22,0:39:20.55,teks umum,,0,0,0,,Apakah ini mungkin?
Dialog: 0,0:39:21.60,0:39:25.48,teks umum,,0,0,0,,Anggap saja itu batu pernapasan. Apakah Anda ingin dia berbicara?
Dialog: 0,0:39:25.56,0:39:27.02,teks umum,,0,0,0,,Ini tidak akan mudah
Dialogue: 0,0:39:35.36,0:39:38.45,teks umum,,0,0,0,,Apakah kamu takut dia masih hidup?
Dialog: 0,0:39:40.87,0:39:42.66,teks umum,,0,0,0,,Meski begitu, mereka tidak akan berhasil
Dialogue: 0,0:39:43.58,0:39:46.16,teks umum,,0,0,0,,Ini bisa dilakukan dengan batu es
Dialog: 0,0:39:46.66,0:39:48.25,teks umum,,0,0,0,,Tetapi mereka tidak memilikinya
Dialog: 0,0:39:48.92,0:39:52.04,teks umum,,0,0,0,,Jadi bisa dihidupkan kembali dengan batu?
Dialog: 0,0:39:52.13,0:39:53.13,teks umum,,0,0,0,,Ya
Dialogue: 0,0:39:54.13,0:39:56.67,teks umum,,0,0,0,,Dan kamu punya batu ini?
Dialog: 0,0:39:57.80,0:39:59.26,teks umum,,0,0,0,,Kamu tidak perlu tahu
Dialog: 0,0:40:00.64,0:40:02.47,teks umum,,0,0,0,,Siapkan tentara bayaran
Dialog: 0,0:40:03.22,0:40:04.76,teks umum,,0,0,0,,Saya akan menemukan jalan,
Dialog: 0,0:40:04.85,0:40:07.39,teks umum,,0,0,0,,bahkan jika kamu harus memindahkan jiwa ke dalam tubuh penyihir Jeonjingak
Dialog: 0,0:40:14.48,0:40:16.69,teks umum,,0,0,0,,- Hei, Bom\N- Apa?
Dialog: 0,0:40:16.78,0:40:17.74,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:40:26.12,0:40:27.37,prasasti,,0,0,0,,Seni Hyonggon
Dialog: 0,0:40:27.45,0:40:29.04,prasasti,,0,0,0,,sikap tekan kepala macan tutul
Dialog: 0,0:40:29.12,0:40:30.96,prasasti,,0,0,0,,Sikap serangan langsung
Dialog: 0,0:42:04.30,0:42:05.47,teks umum,,0,0,0,,Yul
Dialog: 0,0:42:07.22,0:42:08.64,teks umum,,0,0,0,,Inggris
Dialog: 0,0:42:09.60,0:42:10.97,teks umum,,0,0,0,,Apakah kamu akan berlatih?
Dialog: 0,0:42:12.14,0:42:13.10,teks umum,,0,0,0,,Ya
Dialog: 0,0:42:13.89,0:42:14.81,teks umum,,0,0,0,,Dan kamu?
Dialog: 0,0:42:20.86,0:42:22.19,teks umum,,0,0,0,,Dan aku bertarung
Dialog: 0,0:42:24.15,0:42:25.49,teks umum,,0,0,0,,dengan pengembara
Dialog: 0,0:42:29.41,0:42:32.54,teks umum,,0,0,0,,Almarhum tuan Kan adalah seorang pengembara
Dialog: 0,0:42:34.04,0:42:35.37,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:42:35.46,0:42:37.29,teks umum,,0,0,0,,Bagaimana kamu tahu?
Dialog: 0,0:42:38.63,0:42:40.30,teks umum,,0,0,0,,Jika Anda menyembunyikan tanda biru,
Dialog: 0,0:42:40.38,0:42:42.55,teks umum,,0,0,0,,tidak ada cara membedakannya dengan orang lain
Dialog: 0,0:42:43.47,0:42:45.22,teks umum,,0,0,0,,Tapi begitu mereka menjadi liar,
Dialog: 0,0:42:46.43,0:42:47.93,teks umum,,0,0,0,,tidak ada jalan untuk kembali
Dialog: 0,0:42:54.73,0:42:57.56,teks umum,,0,0,0,,Kehilangan energi, mereka berubah menjadi batu
Dialog: 0,0:42:58.44,0:43:01.48,teks umum,,0,0,0,,Dan kamu hanya bisa pulih dengan menyedot energi orang lain
Dialog: 0,0:43:02.98,0:43:04.49,teks umum,,0,0,0,,Setelah melakukan ini sekali,
Dialog: 0,0:43:06.61,0:43:08.57,teks umum,,0,0,0,,mereka berubah menjadi monster
Dialog: 0,0:43:11.79,0:43:12.95,teks umum,,0,0,0,,Monster?
Dialog: 0,0:43:28.01,0:43:30.39,teks umum,,0,0,0,,Dan tugas kita adalah melindungi dunia
Dialog: 0,0:43:34.52,0:43:36.10,teks umum,,0,0,0,,dari mereka
Dialog: 0,0:43:44.78,0:43:47.36,teks umum,,0,0,0,,Kita bisa melindungi monster-monster ini dari dunia
Dialog: 0,0:43:49.28,0:43:50.91,teks umum,,0,0,0,,Kami akan mengawasinya,
Dialog: 0,0:43:51.74,0:43:53.62,teks umum,,0,0,0,,dan akan ada perdamaian di dunia
Dialog: 0,0:43:54.83,0:43:57.50,teks umum,,0,0,0,,Semua orang menaruh harapan besar padamu sejak kecil,
Dialog: 0,0:43:57.58,0:44:00.54,teks umum,,0,0,0,,jadi menurutmu kamu harus melakukan sesuatu yang bermanfaat
Dialog: 0,0:44:00.63,0:44:01.96,teks umum,,0,0,0,,Yah, mereka bilang padaku,
Dialog: 0,0:44:03.21,0:44:05.26,teks umum,,0,0,0,,jadi aku tidak mau mengeluarkan kepalaku
Dialog: 0,0:44:07.72,0:44:08.93,teks umum,,0,0,0,,I
Dialog: 0,0:44:10.47,0:44:12.26,teks umum,,0,0,0,,ikuti kata hatiku
Dialog: 0,0:44:38.83,0:44:42.13,teks umum,,0,0,0,,Jin Mu biarkan Hutan Pinus tutup
Dialog: 0,0:44:42.21,0:44:44.92,teks umum,,0,0,0,,Bagaimana jika mereka mulai mencurigai istana?
Dialog: 0,0:44:45.67,0:44:46.96,teks umum,,0,0,0,,Istana...
Dialog: 0,0:44:47.96,0:44:52.43,teks umum,,0,0,0,,bukan tempat yang bisa dibobol Park Jin begitu saja, seperti di Daegantonggun
Dialog: 0,0:44:52.51,0:44:55.56,teks umum,,0,0,0,,Tetapi jika dia muncul, aku akan berada dalam bahaya
Dialog: 0,0:44:56.14,0:44:57.97,teks umum,,0,0,0,,Sejak kematian Kil Ju
Dialog: 0,0:44:58.06,0:44:59.85,teks umum,,0,0,0,,Saya tidak makan energi
Dialog: 0,0:45:01.64,0:45:04.27,teks umum,,0,0,0,,Aku takut jadi liar
Dialog: 0,0:45:07.65,0:45:10.11,teks umum,,0,0,0,,Anda dapat berbagi dengan saya
Dialog: 0,0:45:11.03,0:45:12.61,teks umum,,0,0,0,,dengan kekuatan batu es?
Dialog: 0,0:45:13.95,0:45:14.95,teks umum,,0,0,0,,Apa?
Dialog: 0,0:45:15.03,0:45:18.45,teks umum,,0,0,0,,Satu-satunya yang bisa melayanimu, mengetahui wajah aslimu,
Dialog: 0,0:45:22.67,0:45:24.33,teks umum,,0,0,0,,ini aku, setujukah kamu?
Dialog: 0,0:45:25.54,0:45:26.75,teks umum,,0,0,0,,Dukun
Dialog: 0,0:45:28.00,0:45:29.63,teks umum,,0,0,0,,Bajingan...
Dialog: 0,0:45:29.71,0:45:32.22,teks umum,,0,0,0,,Sudah kubilang jangan memanggilku seperti itu
Dialog: 0,0:45:34.26,0:45:36.51,teks umum,,0,0,0,,Apakah kamu ingin segera berubah menjadi batu?
Dialogue: 0,0:45:39.10,0:45:40.31,teks umum,,0,0,0,,Aku tahu kamu tidak bisa
Dialog: 0,0:45:41.98,0:45:44.52,teks umum,,0,0,0,,Aku satu-satunya di istana yang tahu,
Dialog: 0,0:45:44.60,0:45:47.52,teks umum,,0,0,0,,bahwa kamu adalah dukun Choi,
Dialog: 0,0:45:47.61,0:45:50.65,teks umum,,0,0,0,,bermigrasi ke tubuh ratu
Dialog: 0,0:45:52.07,0:45:53.53,teks umum,,0,0,0,,Jika aku mati,
Dialog: 0,0:45:53.61,0:45:57.83,teks umum,,0,0,0,,bisakah kamu memindahkan adikmu dari Jinyeowon ke sini?
Dialog: 0,0:46:02.16,0:46:03.37,teks umum,,0,0,0,,Selain itu,
Dialog: 0,0:46:04.12,0:46:09.09,teks umum,,0,0,0,,ratu sejati dalam tubuhmu
Dialogue: 0,0:46:11.13,0:46:15.39,teks umum,,0,0,0,,Haruskah aku berhenti mengunjunginya?
Dialog: 0,0:46:15.97,0:46:17.01,teks umum,,0,0,0,,Hah?
Dialog: 0,0:46:21.56,0:46:23.69,teks umum,,0,0,0,,Ini semakin sulit bagiku
Dialog: 0,0:46:24.73,0:46:26.65,teks umum,,0,0,0,,hidup dalam tubuh ini
Dialog: 0,0:46:28.65,0:46:30.86,teks umum,,0,0,0,,Beritahu Jin Mu
Dialog: 0,0:46:30.94,0:46:34.78,teks umum,,0,0,0,,pindahkan jiwaku ke tubuh lain
Dialog: 0,0:46:36.49,0:46:37.74,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:46:41.16,0:46:42.41,teks umum,,0,0,0,,Oke
Dialog: 0,0:46:43.50,0:46:44.87,teks umum,,0,0,0,,Kamu boleh pergi
Dialog: 0,0:47:10.94,0:47:12.23,teks umum,,0,0,0,,Mengapa kamu ada di sini?
Dialog: 0,0:47:13.19,0:47:15.40,teks umum,,0,0,0,,Aku akan menyerah padamu dan semuanya akan berakhir
Dialogue: 0,0:47:20.32,0:47:22.16,teks umum,,0,0,0,,aku menyerah
Dialog: 0,0:47:22.74,0:47:24.04,teks umum,,0,0,0,,Hei, Uk... Uk!
Dialog: 0,0:47:31.29,0:47:32.84,teks umum,,0,0,0,,Kau ingin pergi sebelum aku
Dialog: 0,0:47:32.92,0:47:34.17,teks umum,,0,0,0,,Dan kamu menang
Dialog: 0,0:47:41.18,0:47:43.60,teks umum,,0,0,0,,Dan Gu ingin membiarkanmu menang
Dialog: 0,0:47:43.68,0:47:45.06,teks umum,,0,0,0,,Bagaimana kamu bisa menolak?
Dialog: 0,0:47:45.14,0:47:47.52,teks umum,,0,0,0,,Aku tidak tahu kamu begitu bangga pada dirimu sendiri
Dialog: 0,0:47:47.60,0:47:50.52,teks umum,,0,0,0,,Hei, kamu melakukan hal seperti ini hingga membuatku menolak
Dialog: 0,0:47:50.61,0:47:51.69,teks umum,,0,0,0,,Kapan ini?
Dialog: 0,0:47:51.77,0:47:53.61,teks umum,,0,0,0,,Tampak lega
Dialog: 0,0:47:53.69,0:47:55.44,teks umum,,0,0,0,,Seharusnya ditampilkan
Dialog: 0,0:47:56.11,0:47:57.03,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:47:57.11,0:47:58.40,teks umum,,0,0,0,,Saya melakukan hal itu
Dialog: 0,0:47:59.49,0:48:02.78,teks umum,,0,0,0,,Dan bagaimana hal ini dapat dipahami? Jika saya mengerti, saya setuju
Dialog: 0,0:48:04.33,0:48:05.91,teks umum,,0,0,0,,Satu pertarungan tersisa
Dialog: 0,0:48:06.62,0:48:07.87,teks umum,,0,0,0,,Apa yang akan kamu lakukan?
Dialog: 0,0:48:07.96,0:48:09.46,teks umum,,0,0,0,,Tunggu, apakah kamu menyalahkanku?
Dialog: 0,0:48:10.04,0:48:12.67,teks umum,,0,0,0,,Kamu sendiri yang memberinya giok, dan apakah kamu marah padaku?
Dialog: 0,0:48:12.75,0:48:15.30,teks umum,,0,0,0,,Apakah kamu menggerakkan panahnya sekarang?
Dialog: 0,0:48:15.38,0:48:16.84,teks umum,,0,0,0,,Betapa kekanak-kanakan
Dialog: 0,0:48:16.92,0:48:19.43,teks umum,,0,0,0,,Kekanak-kanakan? Tunjukkan perilaku yang sangat kekanak-kanakan?
Dialog: 0,0:48:19.51,0:48:20.47,teks umum,,0,0,0,,Aku menyerahkan segalanya
Dialog: 0,0:48:21.59,0:48:22.60,teks umum,,0,0,0,,Haruskah aku bersikap seperti ini?
Dialog: 0,0:48:32.69,0:48:35.48,teks umum,,0,0,0,,Penyihir telah menjaga Saejukwon sejak tadi malam
Dialog: 0,0:48:36.57,0:48:39.49,teks umum,,0,0,0,,Pastinya jasad si penelan jiwa ada disana
Dialog: 0,0:48:39.57,0:48:42.32,teks umum,,0,0,0,,Jika dia mati, jenazahnya akan dibawa ke ruang rahasia
Dialogue: 0,0:48:42.82,0:48:45.54,teks umum,,0,0,0,,Kenapa dia dimasukkan ke dalam Sejukwon, yang untuk yang hidup?
Dialog: 0,0:48:54.59,0:48:58.05,teks umum,,0,0,0,,Saya datang untuk mencari tahu apa yang terjadi pada tubuh
Dialog: 0,0:48:58.13,0:49:00.38,teks umum,,0,0,0,,Tunggu. Saya akan memberi tahu kepala
Dialog: 0,0:49:17.07,0:49:20.49,teks umum,,0,0,0,,Kudengar kepalanya ada di Saejukwon, jadi aku datang menemuinya
Dialog: 0,0:49:20.57,0:49:23.07,teks umum,,0,0,0,,Belum ada yang diizinkan masuk ke Sejukwon
Dialog: 0,0:49:23.16,0:49:25.45,teks umum,,0,0,0,,Kalau begitu dulu saya akan bertemu dengan Pak.
Dialog: 0,0:49:25.53,0:49:27.62,teks umum,,0,0,0,,Katakan pada kepala bahwa aku di sini
Dialog: 0,0:49:29.20,0:49:30.45,teks umum,,0,0,0,,Jin Mu telah tiba
Dialog: 0,0:49:31.83,0:49:34.83,teks umum,,0,0,0,,periksa apakah pemakan jiwa itu benar-benar mati
Dialog: 0,0:49:35.96,0:49:38.34,teks umum,,0,0,0,,Suruh aku pergi selagi kita masih menyelidiki
Dialog: 0,0:49:38.42,0:49:41.51,teks umum,,0,0,0,,Ya. Ada orang lain yang datang menemui Anda
Dialog: 0,0:49:42.34,0:49:43.47,teks umum,,0,0,0,,Biarkan dia pergi
Dialog: 0,0:49:43.55,0:49:46.14,teks umum,,0,0,0,,Jangan biarkan siapa pun masuk ke Saejukwon
Dialog: 0,0:49:46.22,0:49:47.18,teks umum,,0,0,0,,Ya
Dialog: 0,0:49:47.26,0:49:49.72,teks umum,,0,0,0,,Aku akan menyuruh pelayan Kim pergi
Dialog: 0,0:49:51.02,0:49:52.14,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:53.23,0:49:54.40,teks umum,,0,0,0,,Maiden Kim?
Dialog: 0,0:49:54.48,0:49:57.36,teks umum,,0,0,0,,Saya akan memberitahunya bahwa kepala tidak dapat menerima siapa pun
Dialog: 0,0:50:00.28,0:50:01.49,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:50:02.78,0:50:06.20,teks umum,,0,0,0,,Dia bisa sebagai pengecualian
Dialog: 0,0:50:15.88,0:50:18.25,teks umum,,0,0,0,,Lama tidak bertemu, pembantu Kim
Dialog: 0,0:50:37.56,0:50:40.98,teks umum,,0,0,0,,Saya tinggal di rumah Gwangju Chang Gan ketika saya melayaninya,
Dialog: 0,0:50:41.65,0:50:44.61,teks umum,,0,0,0,,dan kamu memasak makanan lezat
Dialog: 0,0:50:45.74,0:50:47.20,teks umum,,0,0,0,,Kamu makan banyak sekali,
Dialog: 0,0:50:47.70,0:50:51.12,teks umum,,0,0,0,,bahwa mangkuk nasimu adalah yang terbesar
Dialog: 0,0:50:52.25,0:50:53.37,teks umum,,0,0,0,,Apakah kamu ingat?
Dialog: 0,0:50:53.45,0:50:56.62,teks umum,,0,0,0,,Mangkukmu sangat besar
Dialog: 0,0:50:56.71,0:50:59.67,teks umum,,0,0,0,,Saat itu aku selalu lapar
Dialog: 0,0:51:00.59,0:51:04.17,teks umum,,0,0,0,,Kamu mungkin memasak sesuatu yang enak lagi
Dialog: 0,0:51:04.76,0:51:07.89,teks umum,,0,0,0,,Ya. Saya menyiapkannya sendiri
Dialog: 0,0:51:12.06,0:51:15.64,teks umum,,0,0,0,,Kue madu. Saya sangat mencintai mereka sebelumnya
Dialog: 0,0:51:15.73,0:51:16.94,teks umum,,0,0,0,,Itu dia
Dialog: 0,0:51:17.02,0:51:20.02,teks umum,,0,0,0,,Saya meminta Anda untuk menyampaikan Gwangju,
Dialog: 0,0:51:20.11,0:51:23.15,teks umum,,0,0,0,,dan kamu memasukkan sepasang ke dalam sakumu
Dialog: 0,0:51:24.36,0:51:28.03,teks umum,,0,0,0,,Karena aku hanya bisa makan\N setelah dia selesai
Dialog: 0,0:51:28.86,0:51:32.99,teks umum,,0,0,0,,Bagaimanapun, aku mendapatkan banyak hal dengan mengikuti Gwangju
Dialog: 0,0:51:33.08,0:51:35.12,teks umum,,0,0,0,,makan enak,
Dialog: 0,0:51:36.08,0:51:38.54,teks umum,,0,0,0,,mengajarkan mantra khusus
Dialogue: 0,0:51:43.71,0:51:47.13,teks umum,,0,0,0,,Rasanya lebih enak jika dimakan diam-diam, bukan?
Dialog: 0,0:51:53.93,0:51:55.14,teks umum,,0,0,0,,Oleh karena itu
Dialogue: 0,0:51:56.10,0:51:58.56,teks umum,,0,0,0,,permen selalu berbahaya
Dialog: 0,0:51:58.64,0:52:02.65,teks umum,,0,0,0,,Setelah kamu mencobanya, kamu tidak bisa berhenti
Dialog: 0,0:52:06.03,0:52:07.61,teks umum,,0,0,0,,Kamu tidak membeda-bedakan,
Dialog: 0,0:52:09.16,0:52:10.74,teks umum,,0,0,0,,apa yang bisa kamu makan,
Dialog: 0,0:52:12.45,0:52:14.16,teks umum,,0,0,0,,dan apa yang tidak
Dialog: 0,0:52:16.25,0:52:19.00,teks umum,,0,0,0,,Kau menyakitiku dengan tidak mengizinkanku mencoba
Dialog: 0,0:52:21.00,0:52:24.55,teks umum,,0,0,0,,Jangan serakah
Dialogue: 0,0:52:28.76,0:52:32.05,teks umum,,0,0,0,,Gwangju sangat menyukai kue ini
Dialog: 0,0:52:32.14,0:52:34.01,teks umum,,0,0,0,,Dan putranya?
Dialogue: 0,0:52:34.10,0:52:37.14,teks umum,,0,0,0,,Tuan muda juga menyukainya
Dialog: 0,0:52:37.22,0:52:39.69,teks umum,,0,0,0,,Maka kamu perlu membaginya dengannya
Dialog: 0,0:52:40.85,0:52:45.15,teks umum,,0,0,0,,Aku bisa bercerita banyak padanya tentang ayahku
Dialog: 0,0:52:52.74,0:52:56.04,teks umum,,0,0,0,,Tidak ada yang perlu dibicarakan antara kamu dan Inggris
Dialog: 0,0:52:56.12,0:52:57.83,teks umum,,0,0,0,,Kamu boleh pergi
Dialog: 0,0:52:57.91,0:53:00.75,teks umum,,0,0,0,,Dia hanya ingin kue. Ada apa denganmu?
Dialog: 0,0:53:01.46,0:53:04.63,teks umum,,0,0,0,,Jangan biarkan aku berbagi kenangan dengannya
Dialog: 0,0:53:04.71,0:53:05.67,teks umum,,0,0,0,,Pasti,
Dialog: 0,0:53:07.46,0:53:09.92,teks umum,,0,0,0,,sekali lagi, kamu tidak ingin aku menyentuh milikmu
Dialog: 0,0:53:12.76,0:53:13.89,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:53:14.76,0:53:17.97,teks umum,,0,0,0,,Ini untuk pria terhormat,
Dialog: 0,0:53:18.06,0:53:19.60,teks umum,,0,0,0,,tapi kamu bisa ambil
Dialog: 0,0:53:20.14,0:53:21.23,teks umum,,0,0,0,,Maiden Kim
Dialogue: 0,0:53:22.14,0:53:23.35,teks umum,,0,0,0,,Jangan beri dia
Dialog: 0,0:53:24.27,0:53:26.32,teks umum,,0,0,0,,Jika aku benar-benar menginginkannya,
Dialogue: 0,0:53:26.86,0:53:29.32,teks umum,,0,0,0,,Aku pasti sudah mencuri sepasang
Dialog: 0,0:53:29.99,0:53:32.20,teks umum,,0,0,0,,Tapi aku akan membiarkanmu menang
Dialog: 0,0:53:34.66,0:53:38.91,teks umum,,0,0,0,,Kita sudah lama tidak bertemu. Sayang sekali untuk mengucapkan selamat tinggal
Dialog: 0,0:53:47.80,0:53:49.05,teks umum,,0,0,0,,Jin Mu biasa membalas dendam,
Dialog: 0,0:53:49.13,0:53:52.01,teks umum,,0,0,0,,jika dia dimarahi karena makan
Dialog: 0,0:53:52.68,0:53:54.26,teks umum,,0,0,0,,Ini hanya kue
Dialog: 0,0:53:54.34,0:53:55.97,teks umum,,0,0,0,,Seharusnya memberinya sedikit
Dialog: 0,0:53:56.05,0:53:58.14,teks umum,,0,0,0,,Aku hanya tidak ingin dia memakannya,
Dialog: 0,0:53:59.52,0:54:03.31,teks umum,,0,0,0,,apa yang sulit kamu persiapkan
Dialog: 0,0:54:05.15,0:54:06.27,teks umum,,0,0,0,,Duduk
Dialog: 0,0:54:06.36,0:54:08.48,teks umum,,0,0,0,,Kita sudah lama tidak bertemu
Dialog: 0,0:54:08.57,0:54:11.99,teks umum,,0,0,0,,Mari kita ngobrol sambil minum teh
Dialog: 0,0:54:15.61,0:54:17.32,teks umum,,0,0,0,,Apakah ada yang salah?
Dialog: 0,0:54:18.16,0:54:19.70,teks umum,,0,0,0,,Kamu terlihat lelah
Dialog: 0,0:54:23.71,0:54:25.00,teks umum,,0,0,0,,Jangan khawatir
Dialog: 0,0:54:26.17,0:54:30.46,teks umum,,0,0,0,,Aku akan makan kuemu dan segera sadar
Dialog: 0,0:54:40.43,0:54:41.72,miring,,0,0,0,,Moo Dok
Dialog: 0,0:54:42.89,0:54:44.52,teks umum,,0,0,0,,Saya ada tugas
Dialog: 0,0:54:44.60,0:54:46.56,teks umum,,0,0,0,,Pesanan? Yang?
Dialog: 0,0:54:46.65,0:54:47.86,teks umum,,0,0,0,,Pergi ke Jeonbugwan
Dialog: 0,0:54:49.06,0:54:52.36,teks umum,,0,0,0,,Ini masih salah. Sampaikan ini
Dialog: 0,0:54:53.69,0:54:54.95,teks umum,,0,0,0,,Tentu saja
Dialog: 0,0:54:59.70,0:55:01.62,teks umum,,0,0,0,,Apa terjadi sesuatu di Sejukwon?
Dialog: 0,0:55:02.70,0:55:05.21,teks umum,,0,0,0,,Saya tidak tahu segalanya
Dialog: 0,0:55:05.29,0:55:08.79,teks umum,,0,0,0,,Tapi sepertinya ini ada hubungannya dengan apa yang terjadi dengan Degantongun
Dialogue: 0,0:55:09.59,0:55:11.75,teks umum,,0,0,0,,Kudengar Jeonbugwan dan Sosnovy Bor sedang bertarung
Dialog: 0,0:55:17.22,0:55:18.09,teks umum,,0,0,0,,Dimana Yul?
Dialog: 0,0:55:18.18,0:55:19.89,teks umum,,0,0,0,,Aku belum melihatnya sejak tadi malam
Dialog: 0,0:55:19.97,0:55:21.89,teks umum,,0,0,0,,Melaksanakan instruksi dari kepala, mungkin
Dialog: 0,0:55:23.14,0:55:24.27,teks umum,,0,0,0,,Ya?
Dialogue: 0,0:55:25.85,0:55:27.14,kenangan miring,,0,0,0,,Dan aku bertarung
Dialog: 0,0:55:29.27,0:55:30.69,kenangan,,0,0,0,,dengan pengembara
Dialog: 0,0:55:43.29,0:55:45.45,teks umum,,0,0,0,,Kita harus memperkuat perbatasan
Dialog: 0,0:55:45.54,0:55:48.37,teks umum,,0,0,0,,Anda dilarang meninggalkan Sosnovy Bor
Dialog: 0,0:55:50.29,0:55:52.04,miring,,0,0,0,,Mereka yang memiliki Ryusu dan banyak lagi,
Dialog: 0,0:55:52.13,0:55:55.55,teks umum,,0,0,0,,pergi ke Saejukwon dan ikuti perintah Sang Ho
Dialog: 0,0:55:55.63,0:55:56.76,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:55:57.63,0:55:58.55,miring,,0,0,0,,Chang Wook
Dialog: 0,0:55:59.89,0:56:00.89,teks umum,,0,0,0,,Kamu tetap di sini
Dialog: 0,0:56:02.30,0:56:04.01,teks umum,,0,0,0,,Semua orang kecuali Chan Wook,
Dialog: 0,0:56:04.10,0:56:06.89,teks umum,,0,0,0,,ikuti Sang Ho ke Saejukwon
Dialog: 0,0:56:06.98,0:56:08.27,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:56:13.82,0:56:14.98,teks umum,,0,0,0,,Bab
Dialog: 0,0:56:15.86,0:56:17.78,teks umum,,0,0,0,,Mengapa saya tidak pergi?
Dialog: 0,0:56:17.86,0:56:20.66,teks umum,,0,0,0,,Kamu tidak memerlukannya karena kamu tidak dibutuhkan disana
Dialog: 0,0:56:21.91,0:56:23.78,teks umum,,0,0,0,,Apakah ada sesuatu yang berbahaya di sana?
Dialog: 0,0:56:24.83,0:56:26.20,teks umum,,0,0,0,,Apakah ada pengembara di sana?
Dialog: 0,0:56:26.79,0:56:28.87,teks umum,,0,0,0,,Itu bukan urusanmu
Dialog: 0,0:56:29.62,0:56:31.04,teks umum,,0,0,0,,Jangan tertarik
Dialogue: 0,0:56:31.13,0:56:33.92,teks umum,,0,0,0,,Kenapa kamu menyembunyikan semuanya dariku? Saya juga seorang pesulap di sini
Dialog: 0,0:56:34.00,0:56:37.34,teks umum,,0,0,0,,Anda adalah pengecualian terhadap semua aturan
Dialog: 0,0:56:37.92,0:56:40.72,teks umum,,0,0,0,,Jika bosan, tinggalkan Sosnovy Bor
Dialog: 0,0:56:40.80,0:56:44.18,teks umum,,0,0,0,,Pulanglah dan lakukan sesukamu
Dialog: 0,0:56:46.85,0:56:50.35,teks umum,,0,0,0,,Ya. Terima kasih sudah khawatir
Dialog: 0,0:57:08.45,0:57:09.62,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:57:10.79,0:57:13.00,teks umum,,0,0,0,,Ayo pergi ke Chwisonra dan makan sesuatu yang enak
Dialog: 0,0:57:14.63,0:57:18.09,teks umum,,0,0,0,,Semua penyihir di Sejukwon. Kenapa tidak?
Dialog: 0,0:57:19.67,0:57:21.13,teks umum,,0,0,0,,Saya disuruh jangan ikut campur
Dialogue: 0,0:57:21.22,0:57:24.22,teks umum,,0,0,0,,dan itu bukan urusanku
Dialog: 0,0:57:24.80,0:57:27.43,teks umum,,0,0,0,,- Ayo\N- Pembantu Kim memberiku tugas
Dialog: 0,0:57:28.14,0:57:30.60,teks umum,,0,0,0,,Oke. Ayo pergi bersama. Kemana saya harus pergi?
Dialog: 0,0:57:31.44,0:57:32.56,teks umum,,0,0,0,,Jeonbugwan
Dialog: 0,0:57:34.31,0:57:35.23,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,0:57:39.99,0:57:44.66,teks umum,,0,0,0,,Kudengar kamu bilang padanya kamu menginginkan tubuh lain
Dialog: 0,0:57:46.78,0:57:48.12,teks umum,,0,0,0,,Maukah kamu memberikannya padaku?
Dialog: 0,0:57:48.91,0:57:53.17,teks umum,,0,0,0,,Lalu aku ingin tubuh gadis yang akan bergabung dengan Jinyoung sebagai Boo Young
Dialog: 0,0:57:55.54,0:57:57.25,teks umum,,0,0,0,,Setelah berada di tubuh seorang kasim,
Dialogue: 0,0:57:58.00,0:57:59.71,teks umum,,0,0,0,,Aku tidak keberatan berada di tubuh wanita
Dialog: 0,0:58:00.51,0:58:05.43,teks umum,,0,0,0,,Saya ingin tubuh yang kuat, seperti dukun
Dialog: 0,0:58:07.10,0:58:08.35,teks umum,,0,0,0,,"Dukun"?
Dialog: 0,0:58:09.60,0:58:11.93,teks umum,,0,0,0,,Dia kesal karena kamu mengingatkannya pada
Dialog: 0,0:58:12.02,0:58:15.15,teks umum,,0,0,0,,bahwa dia adalah seorang dukun, seorang peramal
Dialogue: 0,0:58:15.77,0:58:17.36,teks umum,,0,0,0,,Aku tidak berbohong
Dialog: 0,0:58:19.82,0:58:24.49,teks umum,,0,0,0,,Aku juga teringat bagaimana aku meminta makanan dan mencuri permen
Dialog: 0,0:58:26.16,0:58:30.20,teks umum,,0,0,0,,Itu tidak bohong, tapi aku tidak senang mendengar hal seperti itu
Dialog: 0,0:58:40.05,0:58:43.22,teks umum,,0,0,0,,Jin Mu ingin makan kue,
Dialog: 0,0:58:43.30,0:58:45.09,teks umum,,0,0,0,,tapi Park Jin tidak membiarkannya
Dialog: 0,0:58:45.72,0:58:47.72,teks umum,,0,0,0,,Maiden Kim khawatir Ji Moo akan tersinggung,
Dialog: 0,0:58:47.80,0:58:49.76,teks umum,,0,0,0,,jadi aku memintamu memberikan ini padanya
Dialogue: 0,0:58:49.85,0:58:52.81,teks umum,,0,0,0,,Jadi, mereka berdebat seperti anak kecil soal makanan?
Dialog: 0,0:58:52.89,0:58:55.64,teks umum,,0,0,0,,Bab ini terkadang sangat remeh
Dialog: 0,0:58:55.73,0:58:58.56,teks umum,,0,0,0,,Berdebat soal kue madu?!
Dialog: 0,0:58:58.65,0:59:00.94,teks umum,,0,0,0,,Kamu benar, ini remeh
Dialog: 0,0:59:08.07,0:59:09.62, kenangan miring,,0,0,0,,Di sini, di Jeonbugwan
Dialog: 0,0:59:09.70,0:59:12.49, kenangan miring,,0,0,0,,kita tuliskan semua bintangnya
Dialog: 0,0:59:35.73,0:59:39.19,teks umum,,0,0,0,,Saya akan memberitahu deputi bahwa ini dari keluarga Chan
Dialog: 0,0:59:39.98,0:59:43.61,teks umum,,0,0,0,,Katakan padanya itu dari pelayan Kim
Dialog: 0,0:59:44.90,0:59:47.24,teks umum,,0,0,0,,Dan juga mengandung banyak minyak
Dialog: 0,0:59:47.32,0:59:49.62,teks umum,,0,0,0,,dan harus dicuci dengan teh hijau
Dialog: 0,0:59:49.70,0:59:50.78,teks umum,,0,0,0,,Ya pak
Dialog: 0,0:59:50.87,0:59:53.49,teks umum,,0,0,0,,Dan tentu saja ada madu
Dialog: 0,0:59:53.58,0:59:55.87,teks umum,,0,0,0,,Mereka harus disimpan di tempat dingin, kalau tidak mereka akan saling menempel
Dialog: 0,0:59:55.95,0:59:58.37,teks umum,,0,0,0,,- Ya, pak\N- Dan karena kami membawanya,
Dialog: 0,0:59:58.46,1:00:00.42,teks umum,,0,0,0,,- bolehkah saya masuk ke dalam?\N- Ya...
Dialog: 0,1:00:00.50,1:00:02.92,teks umum,,0,0,0,,- Apa?\N- Terima kasih. Kami tidak akan bertahan lama
Dialog: 0,1:00:03.00,1:00:03.92,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,1:00:05.59,1:00:06.55,teks umum,,0,0,0,,Tapi...
Dialog: 0,1:00:14.39,1:00:16.31,teks umum,,0,0,0,,Saya selalu ingin berkunjung ke sini
Dialog: 0,1:00:16.39,1:00:19.85,teks umum,,0,0,0,,Meskipun ayahku adalah Gwangju, aku tidak diizinkan berada di sini
Dialog: 0,1:00:24.36,1:00:26.65,teks umum,,0,0,0,,Hei, apa ini?
Dialog: 0,1:00:28.45,1:00:31.03,teks umum,,0,0,0,,Kamu di sini kan?
Dialog: 0,1:00:31.12,1:00:33.24,teks umum,,0,0,0,,Ayahmu adalah seorang peramal di sini
Dialog: 0,1:00:34.41,1:00:36.33,teks umum,,0,0,0,,Apakah kamu datang ke sini untukku?
Dialogue: 0,1:00:38.96,1:00:42.04,teks umum,,0,0,0,,Kamu bisa saja meminta seseorang mengantarkan kue
Dialog: 0,1:00:42.71,1:00:45.75,teks umum,,0,0,0,,Tapi aku datang sendiri karena aku ingin, benar kan?
Dialog: 0,1:00:50.43,1:00:53.47,teks umum,,0,0,0,,Waktu kecil, ayahku sering membawaku ke sini
Dialog: 0,1:00:54.60,1:00:58.02,teks umum,,0,0,0,,Bahkan menunjukkan rekaman hari kelahiranku
Dialog: 0,1:00:59.48,1:01:01.10,teks umum,,0,0,0,,Dia ayah yang baik
Dialog: 0,1:01:04.61,1:01:06.15,teks umum,,0,0,0,,Jika dipikir-pikir,
Dialog: 0,1:01:06.23,1:01:09.32,teks umum,,0,0,0,,pasti disini ada rekaman dari hari ulang tahunmu juga
Dialog: 0,1:01:11.70,1:01:13.20,teks umum,,0,0,0,,Menurutmu?
Dialog: 0,1:01:14.53,1:01:18.04,teks umum,,0,0,0,,Jadi, rekaman hari itu seharusnya ada di sini di suatu tempat
Dialog: 0,1:01:31.38,1:01:33.93,teks umum,,0,0,0,,Kau menjanjikanku tubuh baru
Dialog: 0,1:01:34.47,1:01:37.10,teks umum,,0,0,0,,Tetapi kamu malah berubah menjadi batu
Dialog: 0,1:01:37.76,1:01:39.18,teks umum,,0,0,0,,Kamu tidak dibutuhkan lagi
Dialog: 0,1:01:39.85,1:01:42.27,teks umum,,0,0,0,,Dan kamu akan berubah menjadi batu
Dialog: 0,1:01:57.99,1:01:59.29,teks umum,,0,0,0,,Bajingan...
Dialog: 0,1:02:18.22,1:02:20.47,teks umum,,0,0,0,,Saat malam tiba, para penyihir akan datang
Dialog: 0,1:02:21.10,1:02:22.64,teks umum,,0,0,0,,Mari kita lihat bagaimana mereka membuat catatan?
Dialog: 0,1:02:22.73,1:02:24.81,teks umum,,0,0,0,,Mereka bilang itu pemandangan yang menakjubkan
Dialog: 0,1:02:27.02,1:02:30.73,teks umum,,0,0,0,,Bagus sekali, tapi akan ada masalah jika kita ketahuan
Dialog: 0,1:02:30.82,1:02:31.94,teks umum,,0,0,0,,Ayo pulang
Dialog: 0,1:02:45.58,1:02:47.25,teks umum,,0,0,0,,Kasim Kim menjadi liar
Dialog: 0,1:02:47.33,1:02:49.71,teks umum,,0,0,0,,Tidak seorang pun boleh tahu bahwa dia adalah seorang pengembara
Dialog: 0,1:02:50.30,1:02:53.72,teks umum,,0,0,0,,Dia masih di Jeonbugwan. Kita harus menemukannya sebelum fajar
Dialog: 0,1:02:53.80,1:02:54.97,teks umum,,0,0,0,,Ya
Dialog: 0,1:03:38.39,1:03:39.85,teks umum,,0,0,0,,Saya tahu kamu di sini
Dialog: 0,1:03:40.39,1:03:42.68,teks umum,,0,0,0,,Tidak perlu membuat masalah, keluarlah
Dialog: 0,1:03:42.76,1:03:44.31,teks umum,,0,0,0,,Saya akan memberikan apa yang Anda inginkan
Dialog: 0,1:03:52.40,1:03:53.65,teks umum,,0,0,0,,Keluar
Dialog: 0,1:03:55.94,1:03:57.86,teks umum,,0,0,0,,- Sekarang!\N- Saya berangkat
Dialog: 0,1:04:02.91,1:04:04.87,teks umum,,0,0,0,,- Chan Wook\N- Ya
Dialog: 0,1:04:10.42,1:04:12.04,teks umum,,0,0,0,,Mengapa kamu ada di sini?
Dialog: 0,1:04:12.54,1:04:14.21,teks umum,,0,0,0,,Maaf. Aku sedang ada tugas
Dialog: 0,1:04:14.30,1:04:15.84,teks umum,,0,0,0,,Baiklah, saya ingin menonton
Dialog: 0,1:04:20.14,1:04:21.30,teks umum,,0,0,0,,Pesanan?
Dialog: 0,1:04:21.93,1:04:25.52,teks umum,,0,0,0,,Kudengar kamu ingin kue madu
Dialog: 0,1:04:26.68,1:04:28.06,teks umum,,0,0,0,,Cookie?
Dialog: 0,1:04:28.14,1:04:30.19,teks umum,,0,0,0,,Hamba Kim memperhatikan bahwa kamu sedang kesal,
Dialog: 0,1:04:30.27,1:04:32.02,teks umum,,0,0,0,,dan memintaku memberimu beberapa
Dialog: 0,1:04:34.65,1:04:37.07,teks umum,,0,0,0,,Terima kasih. Katakan padanya aku bersyukur
Dialog: 0,1:04:37.82,1:04:38.95,miring,,0,0,0,,Apa?
Dialog: 0,1:04:40.36,1:04:43.28,teks umum,,0,0,0,,Saya pikir Anda akan marah karena saya masuk tanpa izin
Dialog: 0,1:04:44.03,1:04:44.91,teks umum,,0,0,0,,Apakah kamu tidak marah?
Dialog: 0,1:04:44.99,1:04:48.29,teks umum,,0,0,0,,Kamu datang memberiku kue. Anda bisa pergi
Dialog: 0,1:04:49.58,1:04:51.58,teks umum,,0,0,0,,Bagus. Sejujurnya...
Dialog: 0,1:04:53.13,1:04:54.13,teks umum,,0,0,0,,Aku tidak sendirian
Dialog: 0,1:04:55.55,1:04:57.42,teks umum,,0,0,0,,Moo Dok, keluar. Dia tidak marah
Dialog: 0,1:04:58.55,1:05:00.47,teks umum,,0,0,0,,Ini pembantuku
Dialog: 0,1:05:02.01,1:05:03.80,teks umum,,0,0,0,,Saya Moo Dok,
Dialog: 0,1:05:03.89,1:05:05.43,teks umum,,0,0,0,,pembantunya
Dialog: 0,1:05:07.97,1:05:09.52,teks umum,,0,0,0,,Kamu juga di sini
Dialog: 0,1:05:10.23,1:05:12.23,teks umum,,0,0,0,,Saya pikir kamu akan marah
Dialog: 0,1:05:12.31,1:05:15.44,teks umum,,0,0,0,,Terima kasih atas keramahtamahannya
Dialog: 0,1:05:15.52,1:05:16.82,teks umum,,0,0,0,,Makan kue
Dialog: 0,1:05:16.90,1:05:19.24,teks umum,,0,0,0,,Jika kamu ingin lebih banyak, katakan saja padaku
Dialog: 0,1:05:21.99,1:05:23.24,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:05:23.32,1:05:24.45,teks umum,,0,0,0,,Ayo berangkat
Dialog: 0,1:05:39.63,1:05:42.84,kenangan,,0,0,0,,Ini adalah kasim kerajaan
Dialogue: 0,1:05:43.89,1:05:45.30,kenangan miring,,0,0,0,,Ada apa dengan dia?
Dialog: 0,1:05:46.56,1:05:47.97,kenangan,,0,0,0,,Dia pengembara
Dialog: 0,1:05:48.85,1:05:51.44,kenangan,,0,0,0,,Lihat. Dia menjadi liar
Dialog: 0,1:05:59.40,1:06:01.82,kenangan miring,,0,0,0,,Aku tidak percaya pengembara itu ada di istana
Dialog: 0,1:06:01.90,1:06:02.95,kenangan,,0,0,0,,Mungkin
Dialog: 0,1:06:03.82,1:06:05.12,kenangan,,0,0,0,,ini ulahnya
Dialog: 0,1:06:08.45,1:06:09.83, kenangan miring,,0,0,0,,Aku tahu kamu di sini
Dialog: 0,1:06:10.33,1:06:12.71,kenangan,,0,0,0,,Tak perlu membuat masalah, keluarlah
Dialog: 0,1:06:12.79,1:06:14.54,kenangan,,0,0,0,,Aku akan memberikan apa yang kamu inginkan
Dialog: 0,1:06:21.34,1:06:22.76, kenangan miring,,0,0,0,,Keluar!
Dialog: 0,1:06:31.35,1:06:32.60,kenangan,,0,0,0,,aku berangkat
Dialog: 0,1:06:58.50,1:06:59.71,teks umum,,0,0,0,,Jalankan
Dialog: 0,1:07:02.84,1:07:04.09,teks umum,,0,0,0,,Di belakang kita ada pintu lain
Dialog: 0,1:07:17.10,1:07:18.73,teks umum,,0,0,0,,Mengapa kamu tidak membiarkan kami pergi?
Dialog: 0,1:07:19.73,1:07:23.82,teks umum,,0,0,0,,Tidak benar rasanya melepaskan penyihir yang sampai di sini dengan begitu mudah
Dialog: 0,1:07:23.90,1:07:26.07,teks umum,,0,0,0,,Anda akan mendapat masalah,
Dialog: 0,1:07:27.07,1:07:28.53,teks umum,,0,0,0,,jika saya menghilang di Jeonbugwan
Dialog: 0,1:07:28.62,1:07:30.08,teks umum,,0,0,0,,Dan aku tidak akan menyakitimu
Dialog: 0,1:07:31.24,1:07:33.45,teks umum,,0,0,0,,Tubuhmu akan aman
Dialog: 0,1:07:42.96,1:07:43.96,teks umum,,0,0,0,,Chan Uk...
Dialog: 0,1:08:46.61,1:08:48.90,miring,,0,0,0,,Kamu berada di dalam penghalang yang aku buat
Dialog: 0,1:08:53.49,1:08:54.62,miring,,0,0,0,,Jangan khawatir
Dialog: 0,1:08:55.49,1:08:57.62,teks umum,,0,0,0,,Diam dan kamu tidak akan terluka
Dialog: 0,1:08:59.25,1:09:01.17,teks umum,,0,0,0,,Tunggu di sini
Dialog: 0,1:09:14.72,1:09:16.22,teks umum,,0,0,0,,Namamu Mu Dok?
Dialog: 0,1:09:17.89,1:09:19.85,teks umum,,0,0,0,,Pelayan yang sama,
Dialog: 0,1:09:19.93,1:09:24.15,teks umum,,0,0,0,,siapa yang selalu bersamanya dan dari siapa ia selalu mendapat masalah
Dialog: 0,1:09:27.40,1:09:29.40,teks umum,,0,0,0,,Ada orang di sini
Dialog: 0,1:09:29.94,1:09:32.07,teks umum,,0,0,0,,Keluar dan pulihkan energimu
Dialog: 0,1:09:43.75,1:09:45.21,teks umum,,0,0,0,,Dan kemudian
Dialog: 0,1:09:45.79,1:09:49.71,teks umum,,0,0,0,,Saya akan memindahkan Anda ke tubuh tuan muda, seperti yang Anda inginkan
Dialog: 0,1:10:03.69,1:10:05.23,teks umum,,0,0,0,,Penyihir ini... dukun Choi
Dialog: 0,1:10:06.69,1:10:08.82,teks umum,,0,0,0,,berkata untuk membunuhku?
Dialog: 0,1:10:09.86,1:10:11.82,teks umum,,0,0,0,,Saya butuh bantuanmu
Dialog: 0,1:10:12.57,1:10:15.45,teks umum,,0,0,0,,Jika kamu tidak percaya padaku, aku akan pergi
Dialog: 0,1:10:17.37,1:10:19.58,teks umum,,0,0,0,,Kamu bisa makan camilan bersamanya
Dialog: 0,1:11:11.25,1:11:12.84,teks umum,,0,0,0,,Kita harus keluar dari sini
Dialog: 0,1:12:07.77,1:12:10.69,teks umum,,0,0,0,,Guru, bantu saya lagi
Dialog: 0,1:12:11.44,1:12:13.82,teks umum,,0,0,0,,Berikan kepercayaan diri siswamu
Dialog: 0,1:12:25.33,1:12:26.50,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:13:06.62,1:13:07.66,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:13:10.21,1:13:11.37,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,1:13:44.24,1:13:45.37,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:14:13.77,1:14:14.98,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:14:18.27,1:14:19.44,teks umum,,0,0,0,,Saya...
Dialog: 0,1:14:21.74,1:14:23.70,teks umum,,0,0,0,,hanya menguras tenaganya
Dialog: 0,1:14:30.91,1:14:32.12,teks umum,,0,0,0,,I...
Dialog: 0,1:14:33.75,1:14:35.29,teks umum,,0,0,0,,berjalan liar?
Dialog: 0,1:14:49.64,1:14:51.56,teks umum,,0,0,0,,- Mu Dok..\N- Jangan mendekat
Dialog: 0,1:15:04.95,1:15:06.49,teks umum,,0,0,0,,No. Semuanya baik-baik saja
Dialog: 0,1:15:07.24,1:15:08.62,teks umum,,0,0,0,,Apakah kamu baik-baik saja
Dialog: 0,1:15:10.37,1:15:12.20,teks umum,,0,0,0,,- Dan kamu akan baik-baik saja\N- Tidak
Dialog: 0,1:15:13.20,1:15:14.25,teks umum,,0,0,0,,Jangan sentuh aku
Dialog: 0,1:15:16.33,1:15:17.96,teks umum,,0,0,0,,Jika aku menjadi liar,
Dialog: 0,1:15:20.17,1:15:22.01,teks umum,,0,0,0,,sebaiknya jangan sentuh aku
Dialog: 0,1:15:25.51,1:15:27.22,teks umum,,0,0,0,,Kalau tidak, aku akan menguras energimu juga
Dialog: 0,1:15:28.09,1:15:29.22,teks umum,,0,0,0,,dan kamu akan mati
Dialog: 0,1:17:10.36,1:17:12.53,pratinjau,,0,0,0,,Terdengar suara berisik dari ruang rekaman
Dialog: 0,1:17:12.62,1:17:13.99,pratinjau,,0,0,0,,Keluar!
Dialog: 0,1:17:14.08,1:17:17.04,pratinjau,,0,0,0,,Apakah kamu marah karena kami mengubah temanmu menjadi batu?
Dialog: 0,1:17:17.12,1:17:19.87,pratinjau,,0,0,0,,Kamu tidak akan pernah meninggalkan tempat ini
Dialog: 0,1:17:19.96,1:17:23.00,pratinjau,,0,0,0,,Jadi, ini anggota keluarga Cho?
Dialogue: 0,1:17:23.08,1:17:26.92,preview,,0,0,0,,Dan jika arwahnya melekat pada Uka, lalu bagaimana?
Dialog: 0,1:17:27.00,1:17:30.93,pratinjau,,0,0,0,,Jika aku tidak meninggalkanmu di pegunungan,
Dialog: 0,1:17:31.01,1:17:32.93,pratinjau,,0,0,0,,ini tidak akan terjadi padamu
Dialog: 0,1:17:33.01,1:17:34.43,pratinjau,,0,0,0,,Apakah kamu mempertaruhkan nyawamu?
Dialog: 0,1:17:34.51,1:17:36.51,pratinjau,,0,0,0,,Tawarkan dirimu sebagai balasannya kali ini
Dialog: 0,1:17:36.60,1:17:38.22,pratinjau,,0,0,0,,saya pasti menang besok
Dialog: 0,1:17:38.31,1:17:40.39,pratinjau,,0,0,0,,Aku butuh seseorang yang pasti menang
Dialog: 0,1:17:40.48,1:17:43.06,pratinjau,,0,0,0,,Jika dia mencari batu untuk melindunginya...
Dialog: 0,1:17:43.15,1:17:44.15,pratinjau,,0,0,0,,Mereka tidak bisa bersama
Dialog: 0,1:17:44.23,1:17:46.69,pratinjau,,0,0,0,,Segala sesuatu tentangmu telah muncul ke permukaan
Dialog: 0,0:02:55.14,0:02:57.14, torehan,,0,0,0,,

