Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:01:18.77,0:01:21.19,teks umum,,0,0,0,,Orang akan bergosip jika anda tiba-tiba hilang
Dialog: 0,0:01:21.28,0:01:23.49,teks umum,,0,0,0,,Kematian di hadapan saksi
Dialog: 0,0:01:23.57,0:01:25.78,teks umum,,0,0,0,,akan memudahkan segalanya
Dialog: 0,0:01:27.91,0:01:29.66,teks umum,,0,0,0,,Saya mahu selamatkan muka
Dialog: 0,0:01:30.66,0:01:32.62,teks umum,,0,0,0,,Saya harap kematian itu layak
Dialog: 0,0:01:37.71,0:01:39.88,teks umum,,0,0,0,,- Cikgu!\N- Cikgu!
Dialog: 0,0:01:43.26,0:01:44.34,teks umum,,0,0,0,,Apa yang dia cakap?
Dialog: 0,0:01:44.43,0:01:46.34,teks umum,,0,0,0,,- Apa ini?\N- Tengok!
Dialog: 0,0:01:47.05,0:01:48.93,teks am,,0,0,0,, Tentera upahan!
Dialog: 0,0:02:18.46,0:02:20.42,teks umum,,0,0,0,,Guru
Dialog: 0,0:02:29.09,0:02:32.31,teks umum,,0,0,0,,Saya menggunakan badan awak dengan bermaruah
Dialog: 0,0:03:25.94,0:03:26.82,teks umum,,0,0,0,,Hos
Dialog: 0,0:03:30.07,0:03:32.24,teks umum,,0,0,0,,Sial
Dialog: 0,0:03:38.83,0:03:40.00,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:03:40.96,0:03:41.96,teks umum,,0,0,0,,Jangan datang
Dialog: 0,0:03:46.84,0:03:47.76,miring,,0,0,0,,Malu
Dialog: 0,0:03:47.84,0:03:50.47,teks umum,,0,0,0,,Hari ini dia lebih menderita
Dialog: 0,0:03:50.55,0:03:52.80,teks umum,,0,0,0,,- Tinggal dua lagi?\N- Ya
Dialog: 0,0:03:54.18,0:03:56.43,teks umum,,0,0,0,,Esok Cha Bum
Dialog: 0,0:03:56.52,0:03:58.52,teks umum,,0,0,0,,Saya tidak mahu melihat Uk kalah kepadanya
Dialog: 0,0:03:59.18,0:04:00.56,teks umum,,0,0,0,,Mungkin saya patut lawan?
Dialog: 0,0:04:01.27,0:04:03.23,italic,,0,0,0,,Saya akan biarkan Uku menang dan selesai dengannya
Dialog: 0,0:04:03.31,0:04:04.77,teks umum,,0,0,0,,Uk akan gembira tentang ini
Dialog: 0,0:04:05.27,0:04:07.36,teks umum,,0,0,0,,Pertikaian dengan Putera Mahkota
Dialog: 0,0:04:07.44,0:04:09.03,teks umum,,0,0,0,,Kita perlu menipu dia
Dialog: 0,0:04:12.20,0:04:14.12,teks umum,,0,0,0,,UK kalah, tetapi memperoleh pengalaman
Dialog: 0,0:04:16.20,0:04:17.20,teks umum,,0,0,0,,Hos
Dialog: 0,0:04:17.29,0:04:19.96,teks umum,,0,0,0,,Pergi ke bilik awak, saya bawa tuala
Dialog: 0,0:04:28.09,0:04:30.88,teks umum,,0,0,0,,Saya tidak tahu siapa yang terakhir melawannya,
Dialog: 0,0:04:32.89,0:04:34.85,teks umum,,0,0,0,,tetapi mengalahkan Uka tidak akan begitu mudah
Dialog: 0,0:04:49.32,0:04:50.32,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:04:54.53,0:04:55.78,teks umum,,0,0,0,,Di manakah pemiliknya?
Dialog: 0,0:04:56.37,0:04:57.87,teks umum,,0,0,0,,Oh, adakah anda mencari dia?
Dialog: 0,0:04:58.66,0:04:59.66,teks umum,,0,0,0,,Ya
Dialog: 0,0:05:00.45,0:05:02.21,teks umum,,0,0,0,,Anda Mu Dok, mungkin
Dialog: 0,0:05:03.42,0:05:05.58,teks umum,,0,0,0,,- Ya\N- Saya faham
Dialog: 0,0:05:05.67,0:05:08.63,teks umum,,0,0,0,,Orang yang sentiasa berada di sebelah Chan Wook
Dialog: 0,0:05:09.21,0:05:12.42,di sebalik tabir,,0,0,0,,Burung bangau yang dikatakan pembantu rumah Kim
Dialog: 0,0:05:12.93,0:05:15.76,contact,,0,0,0,,Saya datang berjumpa dia sebelum pergi
Dialog: 0,0:05:15.84,0:05:17.26,teks umum,,0,0,0,,Enter. A...
Dialog: 0,0:05:17.35,0:05:20.31,teks umum,,0,0,0,,Saya membawa makanan ringan. nak?
Dialog: 0,0:05:21.14,0:05:22.14,teks umum,,0,0,0,,Tidak, terima kasih
Dialog: 0,0:05:30.65,0:05:33.78,teks umum,,0,0,0,,Dia anggun dan lembut, seperti yang dikatakan pembantu rumah Kim
Dialog: 0,0:06:34.01,0:06:36.30,teks umum,,0,0,0,,Kenapa awak berdiri di sini dalam keadaan basah?
Dialog: 0,0:06:38.30,0:06:39.68,teks umum,,0,0,0,,Hei, lihat
Dialog: 0,0:06:57.45,0:06:59.07,teks umum,,0,0,0,,Lelaki itu buat begitu, bukan?
Dialog: 0,0:06:59.66,0:07:01.83,teks umum,,0,0,0,,Kita harus mencubanya dengan pedang
Dialog: 0,0:07:02.74,0:07:05.62,teks umum,,0,0,0,,Saya fikir awak kecewa kerana jatuh ke dalam air
Dialog: 0,0:07:06.50,0:07:08.42,teks umum,,0,0,0,,Dan anda menilai pertempuran anda
Dialog: 0,0:07:08.92,0:07:11.75,teks umum,,0,0,0,,Beberapa kali pertama ia seperti ini
Dialog: 0,0:07:11.84,0:07:13.84,teks umum,,0,0,0,,Saya hanya marah kerana saya kalah lapan kali
Dialog: 0,0:07:15.92,0:07:19.38,teks umum,,0,0,0,,Anda biasa berjalan-jalan dengan bersih dan diseterika,
Dialog: 0,0:07:19.47,0:07:22.35,teks umum,,0,0,0,,dan kini anda berdiri dalam keadaan basah dan kotor, yang bermaksud,
Dialog: 0,0:07:23.47,0:07:24.85,teks umum,,0,0,0,, adakah anda serius
Dialog: 0,0:07:28.10,0:07:29.65,teks umum,,0,0,0,,Ia benar-benar kotor
Dialog: 0,0:07:34.82,0:07:36.82,teks umum,,0,0,0,,Anda tergesa-gesa hari ini
Dialog: 0,0:07:36.90,0:07:40.24,teks umum,,0,0,0,,Tidak perlu menyerang ketika dia bertahan
Dialog: 0,0:07:40.32,0:07:43.28,teks umum,,0,0,0,,Adalah berbaloi menunggu dia melemahkan pertahanannya
Dialog: 0,0:07:44.33,0:07:45.49,teks umum,,0,0,0,,Ya
Dialog: 0,0:07:45.58,0:07:48.33,teks umum,,0,0,0,,Jika anda berundur selangkah selepas pukulan,
Dialog: 0,0:07:48.41,0:07:51.79,teks umum,,0,0,0,,dia akan berehat dan lemah
Dialog: 0,0:07:51.88,0:07:53.34,teks umum,,0,0,0,,perlindungan
Dialog: 0,0:07:54.09,0:07:56.13,teks umum,,0,0,0,,Pertempuran ialah permainan tarik tali
Dialog: 0,0:07:56.76,0:07:59.51,teks umum,,0,0,0,,Musuh akan menarik anda apabila dia memutuskan bahawa anda lemah
Dialog: 0,0:08:00.68,0:08:02.64,teks umum,,0,0,0,,Maka anda perlu menyerang
Dialog: 0,0:08:04.30,0:08:06.14,teks umum,,0,0,0,,Terima kasih atas nasihat, tuan
Dialog: 0,0:08:11.56,0:08:12.52,teks umum,,0,0,0,,Nak ke mana?
Dialog: 0,0:08:14.06,0:08:16.07,teks umum,,0,0,0,,Berenang dan tukar pakaian
Dialog: 0,0:08:16.15,0:08:17.78,teks umum,,0,0,0,,saya sudah berbau
Dialog: 0,0:08:19.19,0:08:21.36,kenangan,,0,0,0,,Ah, awak cari dia
Dialog: 0,0:08:28.91,0:08:30.21,teks umum,,0,0,0,,Jangan pergi
Dialog: 0,0:08:33.88,0:08:35.88,teks umum,,0,0,0,,Jangan pergi ke tempat anda, tinggal di sini
Dialog: 0,0:08:36.75,0:08:39.30,teks umum,,0,0,0,,- Saya akan bawa baju\N- Kenapa?
Dialog: 0,0:08:39.38,0:08:41.22,teks umum,,0,0,0,,Saya boleh tukar
Dialog: 0,0:08:42.18,0:08:43.93,teks umum,,0,0,0,,Mengapa terlalu banyak bekerja seperti orang bodoh?
Dialog: 0,0:08:49.31,0:08:50.39,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:08:52.48,0:08:54.10,teks umum,,0,0,0,,Bertindak seperti orang bodoh
Dialog: 0,0:08:58.48,0:08:59.40,teks umum,,0,0,0,,Go
Dialog: 0,0:09:04.07,0:09:05.12,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:09:05.20,0:09:06.62,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:09:08.45,0:09:09.49,teks umum,,0,0,0,,Apa?
Dialog: 0,0:09:16.59,0:09:17.75,teks umum,,0,0,0,,Duduk
Dialog: 0,0:09:18.59,0:09:19.76,teks umum,,0,0,0,,Ya, duduk
Dialog: 0,0:09:25.68,0:09:27.85,teks umum,,0,0,0,,Tengok kasut. Semua basah
Dialog: 0,0:09:31.14,0:09:31.98,teks umum,,0,0,0,,Kenapa...
Dialog: 0,0:09:33.23,0:09:35.94,teks umum,,0,0,0,,Kenapa awak ikut saya ke dalam air?
Dialog: 0,0:09:38.82,0:09:43.03,teks umum,,0,0,0,,Kadang-kadang anda bekerja keras secara tidak munasabah
Dialog: 0,0:09:43.11,0:09:45.74,teks umum,,0,0,0,,Mengapa cuba bersungguh-sungguh dengan pembersihan?
Dialog: 0,0:09:45.82,0:09:48.20,teks umum,,0,0,0,,Rehat, merujuk kepada saya
Dialog: 0,0:09:50.45,0:09:53.41,teks umum,,0,0,0,,Pembantu rumah Kim menghantar telinga kering kepada Corwin
Dialog: 0,0:09:53.50,0:09:56.37,teks umum,,0,0,0,,Makan untuk diri sendiri juga, jangan serahkan semuanya kepada saya
Dialog: 0,0:09:57.67,0:09:58.88,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:10:00.96,0:10:03.67,teks umum,,0,0,0,,Mereka melayan saya dengan baik kerana saya rapat dengan Dan Gu,
Dialog: 0,0:10:03.76,0:10:05.18,teks umum,,0,0,0,,waris kepada Sosnovy Bor
Dialog: 0,0:10:07.26,0:10:08.39,teks umum,,0,0,0,,Begini caranya
Dialog: 0,0:10:09.51,0:10:13.60,teks umum,,0,0,0,,Saya tahu anda menggunakan kuasa untuk kelebihan anda
Dialog: 0,0:10:20.65,0:10:22.07,teks umum,,0,0,0,,Anda cedera
Dialog: 0,0:10:24.49,0:10:26.36,teks umum,,0,0,0,,Saya bertarung selama lapan hari berturut-turut
Dialog: 0,0:10:27.45,0:10:28.87,teks umum,,0,0,0,,Ini bukan satu-satunya luka
Dialog: 0,0:10:31.37,0:10:32.74,teks umum,,0,0,0,,Di mana lagi?
Dialog: 0,0:10:33.58,0:10:35.50,teks umum,,0,0,0,,Kita mesti pergi ke Sejukwon
Dialog: 0,0:10:35.58,0:10:37.17,teks umum,,0,0,0,,Masih ada pertempuran lagi
Dialog: 0,0:10:39.63,0:10:41.46,teks umum,,0,0,0,,Kita mesti sangat menderita,
Dialog: 0,0:10:42.80,0:10:44.55,teks umum,,0,0,0,,sejauh mana tuanku menunggu
Dialog: 0,0:11:00.86,0:11:02.23,teks umum,,0,0,0,,Kaki akan membeku
Dialog: 0,0:11:03.36,0:11:04.78,teks umum,,0,0,0,,Awak tukar baju juga
Dialog: 0,0:11:46.53,0:11:47.65,teks umum,,0,0,0,,Maiden Kim?
Dialog: 0,0:12:01.54,0:12:03.25,teks umum,,0,0,0,,Selesai, Yang Amat Mulia
Dialog: 0,0:12:03.34,0:12:06.34,teks am,,0,0,0,,Ubatnya pahit. Ada gula-gula?
Dialog: 0,0:12:06.42,0:12:08.59,teks umum,,0,0,0,,Saya akan bawa sesuatu
Dialog: 0,0:12:19.35,0:12:21.56,kenangan miring,,0,0,0,,Mesti ada jed merah
Dialog: 0,0:12:22.44,0:12:24.48,kenangan miring,,0,0,0,,Ia mempunyai nilai hanya berpasangan
Dialog: 0,0:12:26.19,0:12:27.82,teks umum,,0,0,0,,Mungkin saya perlu membuangnya?
Dialog: 0,0:13:07.23,0:13:08.57,teks umum,,0,0,0,,Apa?..
Dialog: 0,0:13:09.15,0:13:10.36,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:13:18.87,0:13:21.00,di sebalik tabir,,0,0,0,,Apa ini?
Dialog: 0,0:13:33.22,0:13:37.64,luar skrin,,0,0,0,,Sesuatu memanggil saya dengan kekuatan yang luar biasa
Dialog: 0,0:13:41.47,0:13:43.10,di sebalik tabir,,0,0,0,, Tarikan yang tidak dapat dijelaskan...
Dialog: 0,0:13:44.23,0:13:45.19,suara,,0,0,0,,Ia memanggil saya
Dialog: 0,0:14:37.53,0:14:39.03,teks umum,,0,0,0,,- Sial\N- Betul
Dialog: 0,0:14:39.12,0:14:41.45,teks umum,,0,0,0,,Mengapa perlu menuangkan tenaga ke dalam jed
Dialog: 0,0:14:41.53,0:14:43.54,teks umum,,0,0,0,,dan jadi mengelirukan saya?
Dialog: 0,0:14:43.62,0:14:45.50,teks umum,,0,0,0,,Ini agak menyinggung
Dialog: 0,0:14:45.58,0:14:46.41,teks umum,,0,0,0,,Perkara yang sama
Dialog: 0,0:14:46.50,0:14:51.04,teks umum,,0,0,0,,Saya tersinggung kerana jantung saya berdegup kencang kerana awak!
Dialog: 0,0:14:55.88,0:14:56.93,teks umum,,0,0,0,,Dan anda...
Dialog: 0,0:14:57.97,0:14:59.14,teks umum,,0,0,0,,rasa juga?
Dialog: 0,0:15:00.51,0:15:03.93,teks umum,,0,0,0,,Jantung saya berdegup kencang...
Dialog: 0,0:15:06.56,0:15:08.31,teks umum,,0,0,0,,- Oh...\N- Jangan cakap
Dialog: 0,0:15:11.02,0:15:12.15,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:15:12.94,0:15:14.15,teks umum,,0,0,0,,Anda sangat terkejut,
Dialog: 0,0:15:14.98,0:15:17.03,teks umum,,0,0,0,,yang bermaksud saya tidak pernah menggunakannya
Dialog: 0,0:15:17.86,0:15:18.78,teks umum,,0,0,0,,Ya
Dialog: 0,0:15:18.86,0:15:20.41,teks umum,,0,0,0,,Moo Dok tidak mempunyai sihir
Dialog: 0,0:15:21.07,0:15:22.70,teks umum,,0,0,0,,Anda tidak boleh bertukar tenaga
Dialog: 0,0:15:22.78,0:15:23.87,teks umum,,0,0,0,,Ya
Dialog: 0,0:15:24.41,0:15:27.08,teks umum,,0,0,0,,Saya tidak tahu jed ini mempunyai kuasa sedemikian
Dialog: 0,0:15:42.68,0:15:44.39,teks umum,,0,0,0,,Cukup
Dialog: 0,0:15:45.77,0:15:47.77,teks umum,,0,0,0,,Bagaimanapun,
Dialog: 0,0:15:48.56,0:15:50.06,teks umum,,0,0,0,,Saya belajar sesuatu yang baharu
Dialog: 0,0:15:50.90,0:15:52.81,teks umum,,0,0,0,,- Terima kasih\N- Apa?
Dialog: 0,0:15:52.90,0:15:53.98,teks umum,,0,0,0,,Adakah anda fikir saya patut menggunakannya?
Dialog: 0,0:15:55.02,0:15:56.36,teks umum,,0,0,0,,Mungkin anda tidak boleh
Dialog: 0,0:15:57.78,0:15:59.15,teks umum,,0,0,0,,Moo Dok tidak akan mendapatkannya kembali
Dialog: 0,0:15:59.24,0:16:01.20,teks umum,,0,0,0,,Saya ada dua pergaduhan lagi
Dialog: 0,0:16:01.74,0:16:03.78,teks umum,,0,0,0,,Saya akan mengembalikannya dan menggunakannya
Dialog: 0,0:16:03.87,0:16:05.83,teks umum,,0,0,0,,Simpan sehingga itu
Dialog: 0,0:16:07.33,0:16:08.83,teks umum,,0,0,0,,Dan tolong,
Dialog: 0,0:16:09.50,0:16:10.92,teks umum,,0,0,0,,jangan bermain dengan tenaga
Dialog: 0,0:16:12.88,0:16:14.42,teks umum,,0,0,0,,Anda juga
Dialog: 0,0:16:19.80,0:16:22.18,teks umum,,0,0,0,,Yang Mulia, di manakah anda pergi?
Dialog: 0,0:16:23.60,0:16:24.76,kenangan miring,,0,0,0,,Ambil anda masuk?
Dialog: 0,0:16:26.26,0:16:27.31,kenangan,,0,0,0,,Saya boleh
Dialog: 0,0:16:27.93,0:16:30.23,kenangan,,0,0,0,,Anda akan mendapat pekerjaan di sini
Dialog: 0,0:16:31.64,0:16:32.77,kenangan,,0,0,0,,Saya tidak mahu
Dialog: 0,0:16:33.86,0:16:35.69,teks umum,,0,0,0,,- Kasim O\N- Ya?
Dialog: 0,0:16:35.77,0:16:38.69,teks umum,,0,0,0,,Ketahui siapa yang akan menentang Uka seterusnya
Dialog: 0,0:16:39.28,0:16:40.24,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:40.86,0:16:42.03,teks umum,,0,0,0,,Jangan silap
Dialog: 0,0:16:42.70,0:16:43.87,prasasti,,0,0,0,,Seni Hyonggon
Dialog: 0,0:16:43.95,0:16:44.82,teks umum,,0,0,0,,Hei,
Dialog: 0,0:16:44.91,0:16:46.83,teks umum,,0,0,0,,bagaimana anda suka pergaduhan?
Dialog: 0,0:16:46.91,0:16:50.04,teks umum,,0,0,0,,Dengan Chan Wook? Semudah merebus buah pir
Dialog: 0,0:16:50.96,0:16:53.17,italic,,0,0,0,,- Adakah anda bersedia untuk anda?\N- Sudah tentu
Dialog: 0,0:16:53.25,0:16:55.71,teks umum,,0,0,0,,Saya menggunakan Hyunggon, lagipun...
Dialog: 0,0:16:59.38,0:17:02.05,di sebalik tabir,,0,0,0,,Seorang ahli silap mata daripada keluarga Cha yang memiliki Hyunggon
Dialog: 0,0:17:02.72,0:17:04.76,luar skrin,,0,0,0,,Dia menonton Uk sepanjang masa
Dialog: 0,0:17:04.84,0:17:08.68,di sebalik tabir,,0,0,0,,Seorang pengecut yang memutuskan untuk melawan hanya selepas Chan Wook kalah
Dialog: 0,0:17:09.56,0:17:11.48,contact,,0,0,0,,Uk boleh kalahkan dia
Dialog: 0,0:17:15.10,0:17:18.15,teks umum,,0,0,0,,Hyonggon ialah seni yang menarik
Dialog: 0,0:17:18.82,0:17:21.19,teks umum,,0,0,0,,Tetapi tidak berguna jika anda kurang kemahiran
Dialog: 0,0:17:22.11,0:17:24.16,teks umum,,0,0,0,,Cha Bum kelihatan agak menakutkan,
Dialog: 0,0:17:24.24,0:17:25.66,teks umum,,0,0,0,,tetapi ini hanyalah fasad
Dialog: 0,0:17:26.70,0:17:29.16,suara,,0,0,0,,Jadi Yul membaca orang lain dengan mudah, tidak hairanlah
Dialog: 0,0:17:29.66,0:17:30.75,teks umum,,0,0,0,,Ya?
Dialog: 0,0:17:31.29,0:17:33.67,teks umum,,0,0,0,,Dan dia pergi berkeliling memberitahu semua orang betapa mudahnya
Dialog: 0,0:17:34.21,0:17:35.96,teks umum,,0,0,0,,mengalahkan pemilik
Dialog: 0,0:17:36.04,0:17:37.13,teks umum,,0,0,0,,Dia cuma takut
Dialog: 0,0:17:38.00,0:17:40.42,teks umum,,0,0,0,,UK telah meningkat dengan ketara pada hari ini
Dialog: 0,0:17:41.05,0:17:43.63,teks umum,,0,0,0,,Bom takut Uk akan mengalahkannya
Dialog: 0,0:17:44.84,0:17:49.10,teks umum,,0,0,0,,Jadi tuanku telah bertambah baik sehingga membuatkan orang lain bimbang
Dialog: 0,0:17:51.85,0:17:54.10,teks umum,,0,0,0,,Adakah anda sangat gembira kerana Uk telah menjadi lebih kuat?
Dialog: 0,0:17:54.19,0:17:57.11,teks umum,,0,0,0,,Sudah tentu. Bangga terus ke langit
Dialog: 0,0:17:58.52,0:18:01.48,suara,,0,0,0,,Nak Soo melatih Wook
Dialog: 0,0:18:01.57,0:18:02.65,italic,,0,0,0,,Yul
Dialog: 0,0:18:05.53,0:18:06.91,teks umum,,0,0,0,,Pernah dengar?
Dialog: 0,0:18:06.99,0:18:08.70,teks umum,,0,0,0,,Kecoh di ibu negara
Dialog: 0,0:18:09.58,0:18:10.74,teks umum,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:18:10.83,0:18:14.46,teks umum,,0,0,0,,Master Kang dari Degantongun meninggal dunia kerana sakit
Dialog: 0,0:18:15.83,0:18:16.87,teks umum,,0,0,0,,Tetapi ada khabar angin,
Dialog: 0,0:18:17.54,0:18:19.67,teks umum,,0,0,0,,bahawa dia diserang oleh askar upahan malam tadi
Dialog: 0,0:18:20.96,0:18:23.84,contact,,0,0,0,,Pakcik dan Cikgu Huo pergi ke pengebumian
Dialog: 0,0:18:24.42,0:18:27.18,teks umum,,0,0,0,,Dan jika mereka ini adalah askar upahan yang sama seperti Nak Su?
Dialog: 0,0:18:39.19,0:18:41.73,prasasti,,0,0,0,,Allahyarham Kang Man Jung
Dialog: 0,0:18:43.69,0:18:46.03,contact,,0,0,0,,Mengapa kita tidak boleh mengucapkan takziah?
Dialog: 0,0:18:47.82,0:18:50.78,teks umum,,0,0,0,,Keluarga kami mengangkut barang mahal
Dialog: 0,0:18:50.87,0:18:53.45,teks umum,,0,0,0,,Jika orang mengetahui bahawa ketua rumah
Dialog: 0,0:18:53.54,0:18:57.25,teks umum,,0,0,0,,dibunuh oleh askar upahan, keluarga akan kehilangan pekerjaan
Dialog: 0,0:18:57.96,0:18:59.54,teks umum,,0,0,0,,Diumumkan bahawa dia telah meninggal dunia akibat penyakit berjangkit
Dialog: 0,0:19:00.13,0:19:01.46,teks umum,,0,0,0,,Jadi tiada siapa boleh masuk
Dialog: 0,0:19:04.76,0:19:06.42,teks umum,,0,0,0,,Faham
Dialog: 0,0:19:06.51,0:19:09.30,teks umum,,0,0,0,,Adakah terdapat sebarang petunjuk yang akan membantu mencari askar upahan?
Dialog: 0,0:19:11.26,0:19:12.93,teks umum,,0,0,0,,Adakah anda melakukan bedah siasat?
Dialog: 0,0:19:14.64,0:19:18.06,teks umum,,0,0,0,,Master Kahn mati ditikam dengan pedang di depan mata kita
Dialog: 0,0:19:18.65,0:19:19.98,teks umum,,0,0,0,,Tidak perlu
Dialog: 0,0:19:21.61,0:19:23.40,teks umum,,0,0,0,,Mayatnya akan dibakar malam ini
Dialog: 0,0:19:23.48,0:19:25.03,teks umum,,0,0,0,,Tidak lama lagi?
Dialog: 0,0:19:25.61,0:19:26.74,teks umum,,0,0,0,,Ini adalah malang,
Dialog: 0,0:19:26.82,0:19:28.66,teks umum,,0,0,0,,tetapi kita mesti cepat sebelum khabar angin tersebar
Dialog: 0,0:19:28.74,0:19:32.66,teks umum,,0,0,0,,Saya pasti Master Kan mahu perkara yang sama
Dialog: 0,0:19:32.74,0:19:33.79,teks umum,,0,0,0,,Ini tidak boleh diterima
Dialog: 0,0:19:33.87,0:19:36.00,teks umum,,0,0,0,,Jika anda membakar dia,
Dialog: 0,0:19:36.66,0:19:39.25,teks umum,,0,0,0,,tidak akan ada bukti pembunuhan
Dialog: 0,0:19:41.67,0:19:43.13,teks umum,,0,0,0,,Ini urusan keluarga
Dialog: 0,0:19:44.46,0:19:46.30,teks umum,,0,0,0,,Saya faham awak risau
Dialog: 0,0:19:47.30,0:19:50.30,teks umum,,0,0,0,,Tetapi ketua Sosnovy Bor tidak perlu terlibat dalam perkara ini
Dialog: 0,0:19:51.59,0:19:54.01,teks umum,,0,0,0,,Bedah siasat diperlukan
Dialog: 0,0:19:54.10,0:19:55.81,teks umum,,0,0,0,,Tangguhkan pembakaran mayat
Dialog: 0,0:19:57.18,0:20:01.02,teks umum,,0,0,0,,Sosnovy Bor telah sampai ke tahap di mana ia mengganggu pengebumian orang lain?
Dialog: 0,0:20:04.40,0:20:05.73,teks umum,,0,0,0,,Kami tidak campur tangan
Dialog: 0,0:20:06.48,0:20:10.74,teks umum,,0,0,0,,Saya cuba memberi amaran kepada ketua rumah yang baharu
Dialog: 0,0:20:10.82,0:20:12.74,teks umum,,0,0,0,,daripada ralat yang tidak boleh diperbaiki
Dialog: 0,0:20:12.82,0:20:14.87,teks umum,,0,0,0,,Mengapa anda menentangnya?
Dialog: 0,0:20:14.95,0:20:16.49,teks umum,,0,0,0,,Apa hak anda?
Dialog: 0,0:20:16.58,0:20:20.12,italics,,0,0,0,,Tidak lama dahulu ahli sihir diserang oleh Nak Su
Dialog: 0,0:20:20.21,0:20:22.29,teks umum,,0,0,0,,Kini tentera upahan baharu telah muncul
Dialog: 0,0:20:23.04,0:20:25.75,teks umum,,0,0,0,,Mungkin ada kaitan antara kes ini dengan sihir Nak Su
Dialog: 0,0:20:26.42,0:20:27.63,teks umum,,0,0,0,,Jadi saya campur tangan
Dialog: 0,0:20:28.84,0:20:30.68,teks umum,,0,0,0,,Tiada sihir
Dialog: 0,0:20:30.76,0:20:31.68,teks umum,,0,0,0,,Saya boleh mengesahkan
Dialog: 0,0:20:31.76,0:20:33.64,teks umum,,0,0,0,,Dari manakah keyakinan itu datang tanpa bedah siasat?!
Dialog: 0,0:20:35.05,0:20:38.47,teks umum,,0,0,0,,Kepala tidak mahu melakukan bedah siasat
Dialog: 0,0:20:38.56,0:20:40.77,teks umum,,0,0,0,,Jin Mu, diam saja
Dialog: 0,0:20:41.35,0:20:43.40,teks umum,,0,0,0,,Kami mempunyai hak untuk campur tangan,
Dialog: 0,0:20:43.48,0:20:45.06,teks umum,,0,0,0,,jika kita bercakap tentang sihir
Dialog: 0,0:20:45.15,0:20:47.61,teks umum,,0,0,0,,Adakah anda setuju, Cikgu Jin?
Dialog: 0,0:20:49.57,0:20:50.95,teks umum,,0,0,0,,Saya rasa,
Dialog: 0,0:20:52.53,0:20:55.12,teks umum,,0,0,0,,kali ini timbalannya betul
Dialog: 0,0:20:58.95,0:21:01.50,teks umum,,0,0,0,,Ketua baharu mengesahkan kematian Master Kahn
Dialog: 0,0:21:01.58,0:21:05.13,teks umum,,0,0,0,,Dan dia tiada pilihan selain menyembunyikan sebab sebenar
Dialog: 0,0:21:07.00,0:21:09.96,teks umum,,0,0,0,,Tiada bukti yang menunjukkan sihir
Dialog: 0,0:21:11.30,0:21:15.14,teks umum,,0,0,0,,Jadi saya ragu bahawa Sosnovy Bor mempunyai apa-apa untuk ditangkap di sini
Dialog: 0,0:21:21.98,0:21:24.19,teks am,,0,0,0,,Saya cuma nak jaga maruah tuan
Dialog: 0,0:21:24.27,0:21:27.73,teks umum,,0,0,0,,Mari kita teruskan pengebumian
Dialog: 0,0:21:50.71,0:21:53.93,teks umum,,0,0,0,,Jin Mu secara terbuka mengabaikan kami
Dialog: 0,0:21:56.93,0:21:59.22,teks umum,,0,0,0,,Mengapa mereka sangat menentangnya?
Dialog: 0,0:22:00.39,0:22:02.56,teks umum,,0,0,0,,- Pelik\N- Dan juga,
Dialog: 0,0:22:02.64,0:22:06.77,teks umum,,0,0,0,,Saya tidak sangka Puan Jin akan menyebelahinya
Dialog: 0,0:22:07.36,0:22:09.69,teks umum,,0,0,0,,Dia benci abang tiri
Dialog: 0,0:22:13.90,0:22:17.11,teks umum,,0,0,0,,Saya gembira apabila anda memihak kepada saya
Dialog: 0,0:22:18.99,0:22:20.03,teks umum,,0,0,0,,Nilai sendiri
Dialog: 0,0:22:20.12,0:22:24.33,teks umum,,0,0,0,,Sebaik sahaja kami bersatu, Sosnovny Bor terpaksa mengalah
Dialog: 0,0:22:26.08,0:22:28.04,teks umum,,0,0,0,,Bagaimanakah perjalanan pencarian Boo Young?
Dialog: 0,0:22:30.55,0:22:32.96,teks umum,,0,0,0,,Kami mencari semua persekitaran tasik
Dialog: 0,0:22:33.05,0:22:36.09,teks umum,,0,0,0,,mencari gadis buta sebaya
Dialog: 0,0:22:37.68,0:22:41.26,teks umum,,0,0,0,,Saya telah melakukan ini selama sepuluh tahun yang lalu
Dialog: 0,0:22:41.35,0:22:42.39,teks umum,,0,0,0,,Sejujurnya,
Dialog: 0,0:22:43.18,0:22:45.81,teks umum,,0,0,0,,Saya rasa saya tahu apa yang berlaku kepada Boo Young
Dialog: 0,0:22:47.27,0:22:50.52,teks umum,,0,0,0,,Sepuluh tahun lalu, seorang gadis kecil terdampar di tebing sungai
Dialog: 0,0:22:52.19,0:22:54.15,teks umum,,0,0,0,,- Ya?\N- Hanya di sini
Dialog: 0,0:22:56.07,0:22:57.78,teks umum,,0,0,0,,dia sudah lama mati
Dialog: 0,0:23:04.70,0:23:08.54,teks umum,,0,0,0,,Ibu, saya pasti itu bukan dia
Dialog: 0,0:23:08.62,0:23:11.25,teks umum,,0,0,0,,Saya suruh orang saya gali kubur
Dialog: 0,0:23:12.09,0:23:14.46,teks umum,,0,0,0,,Jika Boo Young benar-benar mati,
Dialog: 0,0:23:14.55,0:23:18.13,teks umum,,0,0,0,,Saya akan bawa awak mayat dia pada apa-apa kos
Dialog: 0,0:23:18.97,0:23:20.51,teks umum,,0,0,0,,Ini tidak akan berfungsi
Dialog: 0,0:23:21.39,0:23:24.06,teks umum,,0,0,0,,Bawa kembali anak perempuan saya hidup-hidup
Dialog: 0,0:23:25.22,0:23:27.39,teks umum,,0,0,0,,Sudah pasti, bertenang sahaja
Dialog: 0,0:23:28.56,0:23:30.52,teks umum,,0,0,0,,Kami akan mendapati dia masih hidup
Dialog: 0,0:23:46.41,0:23:48.04,italic,,0,0,0,,Adakah anda melihatnya dengan baik?
Dialog: 0,0:23:48.91,0:23:51.21,teks umum,,0,0,0,,Bakal ibu dan adik perempuan anda
Dialog: 0,0:23:51.92,0:23:53.04,teks umum,,0,0,0,,Adakah anda fikir,
Dialog: 0,0:23:53.92,0:23:56.17,teks umum,,0,0,0,, adakah mereka akan percaya bahawa saya adalah anak perempuan mereka?
Dialog: 0,0:23:56.26,0:23:57.59,teks umum,,0,0,0,,Adakah anda berpakaian?
Dialog: 0,0:23:58.92,0:24:01.80,teks umum,,0,0,0,,seperti Boo Young semasa kecil
Dialog: 0,0:24:01.89,0:24:03.89,teks umum,,0,0,0,,Tetapi saya tidak fikir Ho Kyung akan membelinya
Dialog: 0,0:24:06.35,0:24:08.60,teks umum,,0,0,0,,Kemudian pakaian yang cantik
Dialog: 0,0:24:10.39,0:24:12.23,teks umum,,0,0,0,,tidak akan bermain di tangan kita
Dialog: 0,0:24:12.81,0:24:15.36,teks umum,,0,0,0,,Saya mesti nampak menyedihkan
Dialog: 0,0:24:16.65,0:24:18.69,teks umum,,0,0,0,,Dia kehilangan anak perempuannya
Dialog: 0,0:24:18.78,0:24:22.82,teks umum,,0,0,0,,Jika dia mengasihani saya, saya hanya akan memenangi hatinya
Dialog: 0,0:24:25.66,0:24:26.79,teks umum,,0,0,0,,Ya
Dialog: 0,0:24:27.75,0:24:29.46,teks umum,,0,0,0,,Anda betul, Jadi saya
Dialog: 0,0:24:33.71,0:24:34.96,teks umum,,0,0,0,,Saya pasti akan
Dialog: 0,0:24:37.67,0:24:40.55,teks umum,,0,0,0,,Saya akan menjadi anak kepada keluarga Jin
Dialog: 0,0:24:53.69,0:24:55.31,teks umum,,0,0,0,,Anda kelihatan lebih baik
Dialog: 0,0:24:55.98,0:24:58.23,teks umum,,0,0,0,,Ya, saya cepat sembuh
Dialog: 0,0:25:09.62,0:25:11.79,teks umum,,0,0,0,,Hyonggon Art
Dialog: 0,0:25:12.75,0:25:14.13,teks umum,,0,0,0,,dihuraikan
Dialog: 0,0:25:20.13,0:25:23.93,teks umum,,0,0,0,,Saya mempunyai syak wasangka mengenai kematian Master Kahn
Dialog: 0,0:25:36.31,0:25:40.07,teks umum,,0,0,0,,Dia kuat, dia pandai jampi
Dialog: 0,0:25:40.15,0:25:42.82,teks umum,,0,0,0,,Tetapi dia sudah mati kerana sakit
Dialog: 0,0:25:43.61,0:25:46.99,teks umum,,0,0,0,,Tidak perlu menghantar sebagai askar upahan
Dialog: 0,0:25:47.07,0:25:49.20,teks umum,,0,0,0,,Mungkin seseorang menyimpan dendam terhadapnya
Dialog: 0,0:25:49.99,0:25:52.08,teks umum,,0,0,0,,dan ingin membunuh diri
Dialog: 0,0:25:52.16,0:25:53.08,condong,,0,0,0,,Tidak
Dialog: 0,0:25:53.16,0:25:55.00,teks umum,,0,0,0,,Kami belum tahu lagi,
Dialog: 0,0:25:56.21,0:25:58.79,teks umum,,0,0,0,,tetapi mesti ada sebab untuk serangan itu
Dialog: 0,0:26:01.80,0:26:05.09,teks umum,,0,0,0,,Apabila jiwa masuk ke badan baru, tidak perlu yang lama
Dialog: 0,0:26:05.68,0:26:07.72,teks umum,,0,0,0,,Tetapi untuk menyingkirkannya tidak begitu mudah
Dialog: 0,0:26:07.80,0:26:11.27,teks umum,,0,0,0,,Di mata orang, ini adalah ahli silap mata yang kuat,
Dialog: 0,0:26:11.35,0:26:13.23,teks umum,,0,0,0,,rasmi atau pedagang
Dialog: 0,0:26:13.89,0:26:16.52,teks umum,,0,0,0,,Jika dia tiba-tiba hilang, syak wasangka akan timbul
Dialog: 0,0:26:18.31,0:26:23.03,teks umum,,0,0,0,,Nak Soo uruskan ini
Dialog: 0,0:26:23.11,0:26:25.15,teks umum,,0,0,0,,Adakah anda bercakap tentang pahlawan kegelapan?
Dialog: 0,0:26:27.49,0:26:30.08,teks umum,,0,0,0,,Terima kasih kepada pahlawan ini,
Dialog: 0,0:26:30.66,0:26:34.96,teks umum,,0,0,0,,Sosnovy Bor langsung tidak menyangka bahawa saya mencipta nomad
Dialog: 0,0:26:36.29,0:26:38.58,miring,,0,0,0,,Ketika saya memburu Nak Su,
Dialog: 0,0:26:38.67,0:26:42.17,teks umum,,0,0,0,,Saya fikir dia gila, siapa yang mahu membuktikan dirinya
Dialog: 0,0:26:42.25,0:26:46.22,teks umum,,0,0,0,,Jadi saya tidak pernah melihat siapa yang dia bunuh
Dialog: 0,0:26:48.84,0:26:50.76,teks umum,,0,0,0,,Iaitu, dia membunuh mereka
Dialog: 0,0:26:51.51,0:26:53.81,teks umum,,0,0,0,,jiwa siapa yang Jin Mu gerakkan?
Dialog: 0,0:26:53.89,0:26:55.31,teks umum,,0,0,0,,Lebih tepat lagi,
Dialog: 0,0:26:56.39,0:26:59.48,teks umum,,0,0,0,,yang tidak diperlukan selepas berpindah
Dialog: 0,0:26:59.56,0:27:02.19,teks umum,,0,0,0,,Anda kata dia anak perempuan Cho Chun
Dialog: 0,0:27:02.98,0:27:07.78,teks umum,,0,0,0,,Jadi dia mengambil gadis kecil itu dan menjadikannya sebagai upahan?
Dialog: 0,0:27:09.57,0:27:11.99,italic,,0,0,0,,Sebab itu saya tidak mendedahkan identiti saya kepadanya
Dialog: 0,0:27:12.74,0:27:14.95,teks umum,,0,0,0,,dan memaksa saya tinggal bersendirian di pergunungan
Dialog: 0,0:27:16.46,0:27:18.71,teks umum,,0,0,0,,Beri dia tidak lebih daripada yang dia perlukan untuk terus hidup
Dialog: 0,0:27:19.54,0:27:23.46,teks umum,,0,0,0,,Tetapi dia bertekad dan membesar dengan kuat
Dialog: 0,0:27:25.01,0:27:26.55,teks umum,,0,0,0,,Sebab...
Dialog: 0,0:27:27.13,0:27:29.97,teks umum,,0,0,0,,Dia fikir beginilah cara dia membalas dendam untuk keluarganya
Dialog: 0,0:27:30.05,0:27:31.55,teks umum,,0,0,0,,Oleh itu, saya mematuhi Jin Mu
Dialog: 0,0:27:33.47,0:27:35.93,miring,,0,0,0,,Dia membantu
Dialog: 0,0:27:36.52,0:27:39.44,teks umum,,0,0,0,,Dan kemudian seorang nomad bertukar menjadi penelan jiwa
Dialog: 0,0:27:40.10,0:27:41.40,teks umum,,0,0,0,,Atas sebab ini
Dialog: 0,0:27:42.44,0:27:44.69,teks umum,,0,0,0,,Sosnovy Bor mengesyaki alkimia jiwa
Dialog: 0,0:27:45.73,0:27:47.90,teks umum,,0,0,0,,Apabila Jin Mu mengetahui yang kami sedang mencarinya,
Dialog: 0,0:27:48.74,0:27:51.45,teks umum,,0,0,0,,dia takut dia akan ditangkap
Dialog: 0,0:27:52.24,0:27:57.16,teks umum,,0,0,0,,Sudah tentu dia menghantarnya kepada Sosnovy Bor, mengetahui bahawa dia akan mati
Dialog: 0,0:28:10.47,0:28:12.76,teks am,,0,0,0,,Mu Dok, bawa air
Dialog: 0,0:28:12.85,0:28:13.89,teks umum,,0,0,0,,Okey
Dialog: 0,0:28:22.44,0:28:25.69,teks umum,,0,0,0,,Moo Dok, awak tak dengar cakap saya?
Dialog: 0,0:28:25.77,0:28:27.82,teks umum,,0,0,0,,Saya suruh awak berehat
Dialog: 0,0:28:30.82,0:28:32.41,teks umum,,0,0,0,,Dan bagaimana pula dengan diri anda?
Dialog: 0,0:28:32.49,0:28:34.45,teks umum,,0,0,0,,Saya suruh awak sembuhkan luka
Dialog: 0,0:28:34.53,0:28:37.75,teks umum,,0,0,0,,Saya pergi ke Sejukwon. Saya mendengar anda
Dialog: 0,0:28:41.46,0:28:42.67,teks umum,,0,0,0,,Anda boleh menyemak
Dialog: 0,0:28:45.96,0:28:47.17,teks umum,,0,0,0,,Bau seperti wormwood
Dialog: 0,0:28:54.35,0:28:55.68,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:28:55.76,0:28:59.10,teks umum,,0,0,0,,Saya bergaduh setiap hari. Cuma penat
Dialog: 0,0:29:06.32,0:29:07.65,teks umum,,0,0,0,,Kemesraan
Dialog: 0,0:29:10.32,0:29:12.45,teks umum,,0,0,0,,Adakah mereka menggosok anda dengan wormwood hangat?
Dialog: 0,0:29:13.24,0:29:15.37,teks umum,,0,0,0,,saya panas kan?
Dialog: 0,0:29:16.83,0:29:19.37,teks umum,,0,0,0,,Ya. hangat
Dialog: 0,0:29:23.67,0:29:27.46,kenangan miring,,0,0,0,,Dia telah ditipu dan dihantar ke kematian tertentu
Dialog: 0,0:29:28.50,0:29:29.51,kenangan condong,,0,0,0,,Nak Su...
Dialog: 0,0:29:29.59,0:29:32.42,kenangan miring,,0,0,0,,Saya sangat kasihan dengan kanak-kanak ini
Dialog: 0,0:29:41.85,0:29:43.48,teks umum,,0,0,0,,Anda telah reda. lepaskan
Dialog: 0,0:29:46.36,0:29:49.40,teks umum,,0,0,0,,- Adakah anda telah menukar kasut anda?\N- Ya
Dialog: 0,0:29:49.48,0:29:51.15,teks umum,,0,0,0,,Adakah kamu makan apa yang dibawa oleh pembantu rumah Kim?
Dialog: 0,0:29:51.24,0:29:54.53,teks umum,,0,0,0,,Ya. Sebenarnya saya dah makan sebelum awak cadangkan.
Dialog: 0,0:29:55.11,0:29:57.07,teks umum,,0,0,0,,Syabas, Moo Deok
Dialog: 0,0:29:59.12,0:30:01.75,teks umum,,0,0,0,,Saya tidak tahu bahawa batu ini boleh
Dialog: 0,0:30:04.50,0:30:05.58,teks umum,,0,0,0,,Jade yin-yang?
Dialog: 0,0:30:05.67,0:30:07.67,teks umum,,0,0,0,,Saya hanya faham kerana kamu memberikannya kepada putera raja
Dialog: 0,0:30:08.42,0:30:10.00,teks umum,,0,0,0,,Dan apa yang dia boleh buat?
Dialog: 0,0:30:10.09,0:30:12.05,teks umum,,0,0,0,,- Tunjukkan\N- Saya tidak boleh
Dialog: 0,0:30:12.13,0:30:13.72,teks umum,,0,0,0,,Saya akan tunjukkan,
Dialog: 0,0:30:13.80,0:30:15.93,teks umum,,0,0,0,,bila saya akan pulangkan milik kamu
Dialog: 0,0:30:17.43,0:30:18.72,teks umum,,0,0,0,,Anda akan memberikannya kepada saya
Dialog: 0,0:30:19.72,0:30:21.14,teks umum,,0,0,0,,bila anda akan mengambilnya?
Dialog: 0,0:30:22.89,0:30:25.31,teks umum,,0,0,0,,Apa? takkan awak terima?
Dialog: 0,0:30:28.98,0:30:32.65,teks umum,,0,0,0,,Saya akan mengembalikannya dan meletakkannya di tangan anda
Dialog: 0,0:30:32.74,0:30:35.53,teks umum,,0,0,0,,Ia mempunyai banyak kuasa
Dialog: 0,0:30:35.61,0:30:36.95,teks umum,,0,0,0,,Syukurlah kami tidak mengetahuinya
Dialog: 0,0:30:37.03,0:30:39.58,teks umum,,0,0,0,,Anda akan terkejut apabila anda melihat
Dialog: 0,0:30:43.66,0:30:45.83,teks umum,,0,0,0,,Kuasa apa? Tunjukkan saya
Dialog: 0,0:30:46.50,0:30:49.38,teks umum,,0,0,0,,Putera Mahkota jatuh ke tanah, berbuih mulut
Dialog: 0,0:30:49.96,0:30:51.38,teks umum,,0,0,0,,Memang dahsyat
Dialog: 0,0:30:51.46,0:30:53.96,teks umum,,0,0,0,,Itu masuk akal. Dia dari Jinyeowon
Dialog: 0,0:30:54.05,0:30:56.05,teks umum,,0,0,0,,Ini boleh menjadi senjata yang serius
Dialog: 0,0:31:18.74,0:31:20.32,teks umum,,0,0,0,,Helo, Timbalan
Dialog: 0,0:31:25.75,0:31:27.33,contact,,0,0,0,,Ketua Sosnovy Bor
Dialog: 0,0:31:27.41,0:31:30.54,teks umum,,0,0,0,,kembali untuk memerhatikan pembakaran mayat secara peribadi
Dialog: 0,0:31:31.21,0:31:33.34,teks umum,,0,0,0,,Apa yang anda buat kali ini?
Dialog: 0,0:31:33.42,0:31:36.17,teks umum,,0,0,0,,Saya datang hanya untuk melihat
Dialog: 0,0:31:37.13,0:31:40.09,teks umum,,0,0,0,,Namun, saya melihat Master Kahn buat kali terakhir
Dialog: 0,0:31:40.18,0:31:42.60,teks umum,,0,0,0,,Saya bertanggungjawab untuk menjalankannya
Dialog: 0,0:32:15.42,0:32:18.47,kenangan miring,,0,0,0,,Adakah anda sudah melihat nomad,
Dialog: 0,0:32:18.55,0:32:20.47,kenangan,,0,0,0,,supaya anda mengenali tanda biru
Dialog: 0,0:32:21.39,0:32:24.76,kenangan,,0,0,0,,Tengok kalau Cikgu Kan ada kesan sebegitu di badannya
Dialog: 0,0:32:24.85,0:32:27.10,kenangan,,0,0,0,,Walaupun kita mendedahkan alkimia jiwa,
Dialog: 0,0:32:27.18,0:32:29.35,kenangan,,0,0,0,,kita tidak tahu badan siapa dia pindah
Dialog: 0,0:32:30.73,0:32:34.69,kenangan,,0,0,0,,Anda perlu melakukan sesuatu untuk membantu memikirkan perkara ini
Dialog: 0,0:33:06.31,0:33:09.73,kenangan,,0,0,0,,Saya tahu awak telah pun menguasai Chisa
Dialog: 0,0:33:10.85,0:33:12.85,kenangan,,0,0,0,,Saya tidak sengaja berdiam diri tentang perkara ini
Dialog: 0,0:33:12.94,0:33:14.35,kenangan,,0,0,0,,Saya tidak memarahi awak
Dialog: 0,0:33:15.27,0:33:16.98,kenangan,,0,0,0,,Apa yang saya minta awak lakukan,
Dialog: 0,0:33:17.07,0:33:19.61,kenangan,,0,0,0,,sangat berbahaya dan boleh menghilangkan tenaga anda
Dialog: 0,0:33:20.40,0:33:22.74,kenangan,,0,0,0,,Tetapi hanya mereka yang memiliki Chisu boleh melakukan ini
Dialog: 0,0:33:23.82,0:33:26.95,kenangan miring,,0,0,0,,Perantau bertukar menjadi penelan jiwa apabila kehilangan tenaga
Dialog: 0,0:33:27.70,0:33:30.12,kenangan miring,,0,0,0,,Badannya masih hangat
Dialog: 0,0:33:30.87,0:33:33.17,kenangan miring,,0,0,0,,Tuangkan tenaga anda ke dalamnya,
Dialog: 0,0:33:33.75,0:33:36.34,kenangan miring,,0,0,0,,untuk menjadikannya liar
Dialog: 0,0:34:03.53,0:34:05.20,teks umum,,0,0,0,,Encik...
Dialog: 0,0:34:08.78,0:34:10.12,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:34:10.20,0:34:12.83,teks umum,,0,0,0,,Dia...
Dialog: 0,0:34:27.14,0:34:29.72,teks umum,,0,0,0,,Saya akan kumpulkan tulang, semua orang berundur
Dialog: 0,0:34:32.81,0:34:35.73,teks umum,,0,0,0,,Ini seorang nomad,
Dialog: 0,0:34:35.81,0:34:38.98,teks umum,,0,0,0,,yang bertukar menjadi batu
Dialog: 0,0:34:41.65,0:34:45.03,teks umum,,0,0,0,,Tiada siapa yang meragui bahawa sihir terlibat di sini
Dialog: 0,0:34:46.41,0:34:48.66,teks umum,,0,0,0,,Bolehkah Sosnovy Bor campur tangan sekarang?
Dialog: 0,0:34:56.12,0:35:00.54,teks umum,,0,0,0,,Anda tidak kecewa, malah anda cuba menyembunyikannya
Dialog: 0,0:35:01.13,0:35:03.59,teks umum,,0,0,0,,Jadi anda tahu mengenainya
Dialog: 0,0:35:05.92,0:35:06.97,italic,,0,0,0,,Anda tahu,
Dialog: 0,0:35:07.63,0:35:12.51,teks umum,,0,0,0,,bahawa ini seorang nomad yang telah menjadi liar
Dialog: 0,0:35:36.25,0:35:38.04,teks umum,,0,0,0,,Kemahiran anda menunjukkan bahawa
Dialog: 0,0:35:38.12,0:35:41.25,teks umum,,0,0,0,,bahawa jiwa Guru Kan ada di dalam badan ini
Dialog: 0,0:35:42.92,0:35:44.80,teks umum,,0,0,0,,Jadi jiwanya
Dialog: 0,0:35:44.88,0:35:46.97,teks umum,,0,0,0,,mati dalam badan anda
Dialog: 0,0:35:47.05,0:35:48.76,teks umum,,0,0,0,,Karut!
Dialog: 0,0:36:08.24,0:36:09.45,teks umum,,0,0,0,,Anda menjadi liar,
Dialog: 0,0:36:10.03,0:36:11.99,teks umum,,0,0,0,,tanpa darah dan tenaga
Dialog: 0,0:36:15.24,0:36:18.50,teks umum,,0,0,0,,Lebih banyak tenaga yang anda gunakan, semakin cepat anda bertukar menjadi batu
Dialog: 0,0:36:19.12,0:36:20.42,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:36:26.88,0:36:29.09,teks umum,,0,0,0,,Lebih baik kamu jangan bergerak!
Dialog: 0,0:36:35.35,0:36:37.35,teks umum,,0,0,0,,- Jangan bunuh dia\N- Bunuh dia
Dialog: 0,0:38:22.87,0:38:25.21,teks umum,,0,0,0,,Perantau liar berbahaya
Dialog: 0,0:38:25.71,0:38:27.50,teks umum,,0,0,0,,Syukurlah, Jeonbugwan berurusan dengannya
Dialog: 0,0:38:28.08,0:38:29.59,teks umum,,0,0,0,,Anda telah membantu kami,
Dialog: 0,0:38:29.67,0:38:32.92,teks umum,,0,0,0,,supaya anda boleh mengambil sedikit kejayaan
Dialog: 0,0:38:37.01,0:38:39.01,teks umum,,0,0,0,,En.
Dialog: 0,0:38:49.06,0:38:51.57,teks umum,,0,0,0,,Oleh kerana kita adalah sebahagian daripada kemuliaan,
Dialog: 0,0:38:51.65,0:38:53.69,teks umum,,0,0,0,,kami akan mengambil badan dan mengkajinya
Dialog: 0,0:38:56.15,0:38:57.57,teks umum,,0,0,0,,Sila
Dialog: 0,0:39:10.92,0:39:12.59,teks umum,,0,0,0,,Saya menutup pintu pagarnya,
Dialog: 0,0:39:12.67,0:39:15.38,teks umum,,0,0,0,,supaya tenaga tidak bocor keluar
Dialog: 0,0:39:16.13,0:39:18.22,teks umum,,0,0,0,,Bawa dia hidup semula untuk menyoal siasatnya
Dialog: 0,0:39:19.22,0:39:20.55,teks umum,,0,0,0,,Adakah ini mungkin?
Dialog: 0,0:39:21.60,0:39:25.48,teks umum,,0,0,0,,Anggap ia sebagai batu pernafasan. Adakah anda mahu dia bercakap?
Dialog: 0,0:39:25.56,0:39:27.02,teks umum,,0,0,0,,Ia tidak akan mudah
Dialog: 0,0:39:35.36,0:39:38.45,teks umum,,0,0,0,,Adakah anda takut dia mungkin masih hidup?
Dialog: 0,0:39:40.87,0:39:42.66,teks umum,,0,0,0,,Walaupun begitu, mereka tidak akan berjaya
Dialog: 0,0:39:43.58,0:39:46.16,teks umum,,0,0,0,,Ini boleh dilakukan dengan batu ais
Dialog: 0,0:39:46.66,0:39:48.25,teks umum,,0,0,0,,Tetapi mereka tidak memilikinya
Dialog: 0,0:39:48.92,0:39:52.04,teks umum,,0,0,0,,Jadi ia boleh dihidupkan semula dengan batu?
Dialog: 0,0:39:52.13,0:39:53.13,teks umum,,0,0,0,,Ya
Dialog: 0,0:39:54.13,0:39:56.67,teks umum,,0,0,0,,Dan anda mempunyai batu ini?
Dialog: 0,0:39:57.80,0:39:59.26,teks umum,,0,0,0,,Anda tidak perlu tahu
Dialog: 0,0:40:00.64,0:40:02.47,teks am,,0,0,0,,Sediakan tentera upahan
Dialog: 0,0:40:03.22,0:40:04.76,teks umum,,0,0,0,,Saya akan cari jalan,
Dialog: 0,0:40:04.85,0:40:07.39,teks umum,,0,0,0,,walaupun anda perlu memindahkan jiwa ke dalam badan ahli silap mata Jeonjingak
Dialog: 0,0:40:14.48,0:40:16.69,teks umum,,0,0,0,,- Hei, Bom\N- Apa?
Dialog: 0,0:40:16.78,0:40:17.74,teks umum,,0,0,0,,Jom
Dialog: 0,0:40:26.12,0:40:27.37,prasasti,,0,0,0,,Seni Hyonggon
Dialog: 0,0:40:27.45,0:40:29.04,prasasti,,0,0,0,,Pendirian tekan kepala Leopard
Dialog: 0,0:40:29.12,0:40:30.96, inskripsi,,0,0,0,,Pendirian serangan langsung
Dialog: 0,0:42:04.30,0:42:05.47,teks umum,,0,0,0,,Yul
Dialog: 0,0:42:07.22,0:42:08.64,teks umum,,0,0,0,,Uk
Dialog: 0,0:42:09.60,0:42:10.97,teks umum,,0,0,0,,Adakah anda akan pergi ke latihan?
Dialog: 0,0:42:12.14,0:42:13.10,teks umum,,0,0,0,,Ya
Dialog: 0,0:42:13.89,0:42:14.81,teks umum,,0,0,0,,Dan awak?
Dialog: 0,0:42:20.86,0:42:22.19,teks umum,,0,0,0,,Dan saya bertarung
Dialog: 0,0:42:24.15,0:42:25.49,teks umum,,0,0,0,,dengan nomad
Dialog: 0,0:42:29.41,0:42:32.54,teks umum,,0,0,0,,Arwah tuan Kan adalah seorang nomad
Dialog: 0,0:42:34.04,0:42:35.37,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:42:35.46,0:42:37.29,teks umum,,0,0,0,,Bagaimana anda tahu?
Dialog: 0,0:42:38.63,0:42:40.30,teks umum,,0,0,0,,Jika anda menyembunyikan tanda biru,
Dialog: 0,0:42:40.38,0:42:42.55,teks umum,,0,0,0,,tidak ada cara untuk membezakan mereka daripada orang lain
Dialog: 0,0:42:43.47,0:42:45.22,teks umum,,0,0,0,,Tetapi apabila mereka menjadi liar,
Dialog: 0,0:42:46.43,0:42:47.93,teks umum,,0,0,0,,tidak berpatah balik
Dialog: 0,0:42:54.73,0:42:57.56,teks umum,,0,0,0,,Kehilangan tenaga, mereka bertukar menjadi batu
Dialog: 0,0:42:58.44,0:43:01.48,teks umum,,0,0,0,,Dan anda hanya boleh pulih dengan menyedut tenaga orang lain
Dialog: 0,0:43:02.98,0:43:04.49,teks umum,,0,0,0,,Setelah melakukan ini sekali,
Dialog: 0,0:43:06.61,0:43:08.57,teks umum,,0,0,0,,mereka bertukar menjadi raksasa
Dialog: 0,0:43:11.79,0:43:12.95,teks umum,,0,0,0,,Raksasa?
Dialog: 0,0:43:28.01,0:43:30.39,teks umum,,0,0,0,,Dan tugas kita adalah untuk melindungi dunia
Dialog: 0,0:43:34.52,0:43:36.10,teks umum,,0,0,0,,daripada mereka
Dialog: 0,0:43:44.78,0:43:47.36,teks umum,,0,0,0,,Kita boleh melindungi raksasa ini daripada dunia
Dialog: 0,0:43:49.28,0:43:50.91,teks umum,,0,0,0,,Kami akan memerhatikannya,
Dialog: 0,0:43:51.74,0:43:53.62,teks umum,,0,0,0,,dan akan ada keamanan di dunia
Dialog: 0,0:43:54.83,0:43:57.50,teks umum,,0,0,0,,Semua orang menaruh harapan yang tinggi untuk anda sejak kecil,
Dialog: 0,0:43:57.58,0:44:00.54,teks umum,,0,0,0,,jadi anda fikir anda patut melakukan sesuatu yang berbaloi
Dialog: 0,0:44:00.63,0:44:01.96,teks umum,,0,0,0,,Nah, mereka memberitahu saya,
Dialog: 0,0:44:03.21,0:44:05.26,teks umum,,0,0,0,,jadi saya tidak menjulurkan kepala saya
Dialog: 0,0:44:07.72,0:44:08.93,teks umum,,0,0,0,,I
Dialog: 0,0:44:10.47,0:44:12.26,teks umum,,0,0,0,,ikut kata hati saya
Dialog: 0,0:44:38.83,0:44:42.13,teks umum,,0,0,0,,Jin Mu membiarkan Hutan Pine ditutup
Dialog: 0,0:44:42.21,0:44:44.92,teks umum,,0,0,0,,Bagaimana jika mereka mula mengesyaki istana?
Dialog: 0,0:44:45.67,0:44:46.96,teks umum,,0,0,0,,Istana...
Dialog: 0,0:44:47.96,0:44:52.43,teks umum,,0,0,0,,bukan tempat di mana Park Jin boleh menceroboh, seperti di Daegantonggun
Dialog: 0,0:44:52.51,0:44:55.56,teks umum,,0,0,0,,Tetapi jika dia muncul, saya akan berada dalam bahaya
Dialog: 0,0:44:56.14,0:44:57.97,teks umum,,0,0,0,,Sejak kematian Kil Ju
Dialog: 0,0:44:58.06,0:44:59.85,teks umum,,0,0,0,,Saya tidak makan tenaga
Dialog: 0,0:45:01.64,0:45:04.27,teks umum,,0,0,0,,Saya takut saya menjadi liar
Dialog: 0,0:45:07.65,0:45:10.11,teks umum,,0,0,0,,Anda boleh berkongsi dengan saya
Dialog: 0,0:45:11.03,0:45:12.61,teks am,,0,0,0,,dengan kuasa batu ais?
Dialog: 0,0:45:13.95,0:45:14.95,teks umum,,0,0,0,,Apa?
Dialog: 0,0:45:15.03,0:45:18.45,teks umum,,0,0,0,,Satu-satunya yang boleh melayani anda, mengetahui wajah sebenar anda,
Dialog: 0,0:45:22.67,0:45:24.33,teks umum,,0,0,0,,ini saya, adakah anda bersetuju?
Dialog: 0,0:45:25.54,0:45:26.75,teks umum,,0,0,0,,Shaman
Dialog: 0,0:45:28.00,0:45:29.63,teks umum,,0,0,0,,Bajingan...
Dialog: 0,0:45:29.71,0:45:32.22,teks umum,,0,0,0,,Saya dah cakap jangan cakap saya macam tu
Dialog: 0,0:45:34.26,0:45:36.51,teks umum,,0,0,0,,Adakah anda mahu bertukar menjadi batu secepat mungkin?
Dialog: 0,0:45:39.10,0:45:40.31,teks umum,,0,0,0,,Saya tahu anda tidak boleh
Dialog: 0,0:45:41.98,0:45:44.52,teks umum,,0,0,0,,Saya seorang sahaja di istana yang tahu,
Dialog: 0,0:45:44.60,0:45:47.52,teks umum,,0,0,0,,bahawa awak adalah bomoh Choi,
Dialog: 0,0:45:47.61,0:45:50.65,teks umum,,0,0,0,,berhijrah ke badan permaisuri
Dialog: 0,0:45:52.07,0:45:53.53,teks umum,,0,0,0,,Jika saya mati,
Dialog: 0,0:45:53.61,0:45:57.83,teks umum,,0,0,0,,bolehkah awak pindahkan adik awak dari Jinyeowon ke sini?
Dialog: 0,0:46:02.16,0:46:03.37,teks umum,,0,0,0,,Selain itu,
Dialog: 0,0:46:04.12,0:46:09.09,teks umum,,0,0,0,,seorang ratu sebenar dalam badan anda
Dialog: 0,0:46:11.13,0:46:15.39,teks umum,,0,0,0,, Patutkah saya berhenti melawatnya?
Dialog: 0,0:46:15.97,0:46:17.01,teks umum,,0,0,0,,Hah?
Dialog: 0,0:46:21.56,0:46:23.69,teks umum,,0,0,0,,Ia semakin sukar bagi saya
Dialog: 0,0:46:24.73,0:46:26.65,teks umum,,0,0,0,,hidup dalam badan ini
Dialog: 0,0:46:28.65,0:46:30.86,teks umum,,0,0,0,,Beritahu Jin Mu
Dialog: 0,0:46:30.94,0:46:34.78,teks umum,,0,0,0,,pindah jiwa saya ke badan lain
Dialog: 0,0:46:36.49,0:46:37.74,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:46:41.16,0:46:42.41,teks umum,,0,0,0,,Okay
Dialog: 0,0:46:43.50,0:46:44.87,teks umum,,0,0,0,,Anda boleh pergi
Dialog: 0,0:47:10.94,0:47:12.23,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:47:13.19,0:47:15.40,teks umum,,0,0,0,,Saya akan mengalah kepada anda dan semuanya akan berakhir
Dialog: 0,0:47:20.32,0:47:22.16,teks umum,,0,0,0,,Saya menyerah
Dialog: 0,0:47:22.74,0:47:24.04,teks umum,,0,0,0,,Hei, Uk... Uk!
Dialog: 0,0:47:31.29,0:47:32.84,teks umum,,0,0,0,,Anda mahu pergi sebelum saya
Dialog: 0,0:47:32.92,0:47:34.17,teks umum,,0,0,0,,Dan anda menang
Dialog: 0,0:47:41.18,0:47:43.60,teks umum,,0,0,0,,Dan Gu mahu membenarkan anda menang
Dialog: 0,0:47:43.68,0:47:45.06,teks umum,,0,0,0,,Bagaimana anda boleh menolak?
Dialog: 0,0:47:45.14,0:47:47.52,teks umum,,0,0,0,,Saya tidak tahu awak begitu bangga dengan diri sendiri
Dialog: 0,0:47:47.60,0:47:50.52,teks umum,,0,0,0,,Hei, awak melakukan sesuatu seperti ini untuk membuat saya menolak
Dialog: 0,0:47:50.61,0:47:51.69,teks umum,,0,0,0,,Bila ini?
Dialog: 0,0:47:51.77,0:47:53.61,teks umum,,0,0,0,,Ia kelihatan lega
Dialog: 0,0:47:53.69,0:47:55.44,teks umum,,0,0,0,,Sepatutnya ditunjukkan
Dialog: 0,0:47:56.11,0:47:57.03,teks umum,,0,0,0,,Seperti ini
Dialog: 0,0:47:57.11,0:47:58.40,teks umum,,0,0,0,,saya buat begitu sahaja
Dialog: 0,0:47:59.49,0:48:02.78,teks umum,,0,0,0,,Dan bagaimanakah perkara ini difahami? Jika saya faham, saya akan bersetuju
Dialog: 0,0:48:04.33,0:48:05.91,teks umum,,0,0,0,,Tinggal satu pertarungan
Dialog: 0,0:48:06.62,0:48:07.87,teks umum,,0,0,0,,Apa yang anda akan lakukan?
Dialog: 0,0:48:07.96,0:48:09.46,teks umum,,0,0,0,,Tunggu, adakah anda menyalahkan saya?
Dialog: 0,0:48:10.04,0:48:12.67,teks umum,,0,0,0,,Anda sendiri yang memberikan jed kepadanya, dan adakah anda marah kepada saya?
Dialog: 0,0:48:12.75,0:48:15.30,teks umum,,0,0,0,,Adakah anda menggerakkan anak panah sekarang?
Dialog: 0,0:48:15.38,0:48:16.84,teks umum,,0,0,0,,Sungguh kebudak-budakan
Dialog: 0,0:48:16.92,0:48:19.43,teks umum,,0,0,0,, Kebudak-budakan? Tunjukkan perangai sangat kebudak-budakan?
Dialog: 0,0:48:19.51,0:48:20.47,teks umum,,0,0,0,,Saya menyerahkan segala-galanya
Dialog: 0,0:48:21.59,0:48:22.60,teks umum,,0,0,0,, Patutkah saya berkelakuan seperti ini?
Dialog: 0,0:48:32.69,0:48:35.48,teks umum,,0,0,0,,Mages telah menjaga Saejukwon sejak malam tadi
Dialog: 0,0:48:36.57,0:48:39.49,teks umum,,0,0,0,, Pasti jasad penelan jiwa ada di sana
Dialog: 0,0:48:39.57,0:48:42.32,teks umum,,0,0,0,,Jika dia mati, mayat akan dibawa ke bilik rahsia
Dialog: 0,0:48:42.82,0:48:45.54,teks umum,,0,0,0,,Mengapa dia diletakkan di Sejukwon, iaitu untuk yang hidup?
Dialog: 0,0:48:54.59,0:48:58.05,teks umum,,0,0,0,,Saya datang untuk mengetahui apa yang berlaku kepada mayat
Dialog: 0,0:48:58.13,0:49:00.38,teks umum,,0,0,0,,Tunggu. Saya akan maklumkan kepada ketua
Dialog: 0,0:49:17.07,0:49:20.49,teks umum,,0,0,0,,Saya mendengar bahawa kepala berada di Saejukwon, jadi saya datang berjumpa dengannya
Dialog: 0,0:49:20.57,0:49:23.07,teks umum,,0,0,0,,Tiada sesiapa dibenarkan masuk ke Sejukwon lagi
Dialog: 0,0:49:23.16,0:49:25.45,teks umum,,0,0,0,,Kalau begitu saya akan berjumpa dengan En.
Dialog: 0,0:49:25.53,0:49:27.62,teks umum,,0,0,0,,Beritahu ketua bahawa saya di sini
Dialog: 0,0:49:29.20,0:49:30.45,teks umum,,0,0,0,,Jin Mu telah tiba
Dialog: 0,0:49:31.83,0:49:34.83,teks umum,,0,0,0,,semak sama ada pemakan jiwa itu benar-benar mati
Dialog: 0,0:49:35.96,0:49:38.34,teks umum,,0,0,0,,Suruh saya pergi sementara kita masih menyiasat
Dialog: 0,0:49:38.42,0:49:41.51,teks umum,,0,0,0,,Ya. Orang lain telah datang untuk melihat anda
Dialog: 0,0:49:42.34,0:49:43.47,teks umum,,0,0,0,,Biarkan dia pergi
Dialog: 0,0:49:43.55,0:49:46.14,teks umum,,0,0,0,,Jangan benarkan sesiapa masuk ke Saejukwon
Dialog: 0,0:49:46.22,0:49:47.18,teks umum,,0,0,0,,Ya
Dialog: 0,0:49:47.26,0:49:49.72,teks umum,,0,0,0,,Saya akan memberitahu pembantu rumah Kim untuk pergi
Dialog: 0,0:49:51.02,0:49:52.14,teks umum,,0,0,0,,Apa?
Dialog: 0,0:49:53.23,0:49:54.40,teks umum,,0,0,0,,Maiden Kim?
Dialog: 0,0:49:54.48,0:49:57.36,teks umum,,0,0,0,,Saya akan memberitahunya bahawa ketua tidak boleh menerima sesiapa
Dialog: 0,0:50:00.28,0:50:01.49,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:50:02.78,0:50:06.20,teks umum,,0,0,0,,Dia boleh sebagai pengecualian
Dialog: 0,0:50:15.88,0:50:18.25,teks umum,,0,0,0,,Lama tidak berjumpa, pembantu rumah Kim
Dialog: 0,0:50:37.56,0:50:40.98,teks umum,,0,0,0,,Saya tinggal di rumah Gwangju Chang Gan semasa saya berkhidmat kepadanya,
Dialog: 0,0:50:41.65,0:50:44.61,teks umum,,0,0,0,,dan anda memasak makanan yang lazat
Dialog: 0,0:50:45.74,0:50:47.20,teks umum,,0,0,0,,Anda makan banyak sekali,
Dialog: 0,0:50:47.70,0:50:51.12,teks umum,,0,0,0,,bahawa mangkuk nasi anda adalah yang terbesar
Dialog: 0,0:50:52.25,0:50:53.37,teks umum,,0,0,0,,Awak ingat?
Dialog: 0,0:50:53.45,0:50:56.62,teks umum,,0,0,0,,Anda mempunyai mangkuk yang sangat besar
Dialog: 0,0:50:56.71,0:50:59.67,teks umum,,0,0,0,,Saya selalu lapar ketika itu
Dialog: 0,0:51:00.59,0:51:04.17,teks umum,,0,0,0,,Anda mungkin memasak sesuatu yang lazat lagi
Dialog: 0,0:51:04.76,0:51:07.89,teks umum,,0,0,0,,Ya. Saya menyediakan mereka sendiri
Dialog: 0,0:51:12.06,0:51:15.64,teks umum,,0,0,0,,Kuki madu. Saya sangat menyayangi mereka sebelum ini
Dialog: 0,0:51:15.73,0:51:16.94,teks umum,,0,0,0,,Itu sahaja
Dialog: 0,0:51:17.02,0:51:20.02,teks umum,,0,0,0,,Saya minta awak sampaikan Gwangju,
Dialog: 0,0:51:20.11,0:51:23.15,teks umum,,0,0,0,,dan anda masukkan pasangan ke dalam poket anda
Dialog: 0,0:51:24.36,0:51:28.03,teks umum,,0,0,0,,Sebab saya boleh makan\N hanya apabila dia selesai
Dialog: 0,0:51:28.86,0:51:32.99,teks umum,,0,0,0,,Dalam apa jua keadaan, saya mendapat banyak dengan mengikuti Gwangju
Dialog: 0,0:51:33.08,0:51:35.12,teks umum,,0,0,0,,makan dengan sedap,
Dialog: 0,0:51:36.08,0:51:38.54,teks umum,,0,0,0,,mengajar mantra khas
Dialog: 0,0:51:43.71,0:51:47.13,teks umum,,0,0,0,,Rasanya lebih sedap apabila anda memakannya secara rahsia, bukan?
Dialog: 0,0:51:53.93,0:51:55.14,teks umum,,0,0,0,,Oleh itu
Dialog: 0,0:51:56.10,0:51:58.56,teks umum,,0,0,0,,gula-gula sentiasa berbahaya
Dialog: 0,0:51:58.64,0:52:02.65,teks umum,,0,0,0,,Sebaik sahaja anda mencubanya, anda tidak boleh berhenti
Dialog: 0,0:52:06.03,0:52:07.61,teks umum,,0,0,0,,Anda tidak membezakan,
Dialog: 0,0:52:09.16,0:52:10.74,teks umum,,0,0,0,,apa yang anda boleh makan,
Dialog: 0,0:52:12.45,0:52:14.16,teks umum,,0,0,0,,dan apa yang tidak
Dialog: 0,0:52:16.25,0:52:19.00,teks umum,,0,0,0,,Anda menyakiti saya dengan tidak membenarkan saya mencuba
Dialog: 0,0:52:21.00,0:52:24.55,teks umum,,0,0,0,,Jangan tamak sangat
Dialog: 0,0:52:28.76,0:52:32.05,teks umum,,0,0,0,,Gwangju sangat menyukai kuki ini
Dialog: 0,0:52:32.14,0:52:34.01,teks umum,,0,0,0,,Dan anaknya?
Dialog: 0,0:52:34.10,0:52:37.14,teks umum,,0,0,0,,Tuan muda juga menyayangi mereka
Dialog: 0,0:52:37.22,0:52:39.69,teks umum,,0,0,0,,Maka anda perlu berkongsi dengannya
Dialog: 0,0:52:40.85,0:52:45.15,teks umum,,0,0,0,,Saya boleh bercerita tentang ayah saya kepadanya
Dialog: 0,0:52:52.74,0:52:56.04,teks umum,,0,0,0,,Anda dan Uk tiada apa-apa untuk dibincangkan
Dialog: 0,0:52:56.12,0:52:57.83,teks umum,,0,0,0,,Anda boleh pergi
Dialog: 0,0:52:57.91,0:53:00.75,teks umum,,0,0,0,,Dia hanya mahukan kuki. Apa masalah awak?
Dialog: 0,0:53:01.46,0:53:04.63,teks umum,,0,0,0,,Jangan biarkan saya berkongsi kenangan dengannya
Dialog: 0,0:53:04.71,0:53:05.67,teks umum,,0,0,0,,Mestilah,
Dialog: 0,0:53:07.46,0:53:09.92,teks umum,,0,0,0,,sekali lagi, anda tidak mahu saya menyentuh milik anda
Dialog: 0,0:53:12.76,0:53:13.89,teks umum,,0,0,0,,Tunggu
Dialog: 0,0:53:14.76,0:53:17.97,teks umum,,0,0,0,,Ini untuk lelaki budiman,
Dialog: 0,0:53:18.06,0:53:19.60,teks umum,,0,0,0,,tetapi anda boleh ambil
Dialog: 0,0:53:20.14,0:53:21.23,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:53:22.14,0:53:23.35,teks umum,,0,0,0,,Jangan beri dia
Dialog: 0,0:53:24.27,0:53:26.32,teks umum,,0,0,0,,Jika saya benar-benar mahu,
Dialog: 0,0:53:26.86,0:53:29.32,teks umum,,0,0,0,,Saya sudah pun mencuri pasangan
Dialog: 0,0:53:29.99,0:53:32.20,teks umum,,0,0,0,,Tetapi saya akan benarkan anda menang
Dialog: 0,0:53:34.66,0:53:38.91,teks umum,,0,0,0,,Kami sudah lama tidak berjumpa. Sayang sekali untuk mengucapkan selamat tinggal
Dialog: 0,0:53:47.80,0:53:49.05,teks umum,,0,0,0,,Jin Mu pernah membalas dendam,
Dialog: 0,0:53:49.13,0:53:52.01,teks umum,,0,0,0,,jika dia dimarahi kerana makan
Dialog: 0,0:53:52.68,0:53:54.26,teks umum,,0,0,0,,Itu hanya kuki
Dialog: 0,0:53:54.34,0:53:55.97,teks umum,,0,0,0,,Sepatutnya memberinya sedikit
Dialog: 0,0:53:56.05,0:53:58.14,teks umum,,0,0,0,,Saya hanya tidak mahu dia makan itu,
Dialog: 0,0:53:59.52,0:54:03.31,teks umum,,0,0,0,,apa yang anda hadapi kesukaran sediakan
Dialog: 0,0:54:05.15,0:54:06.27,teks umum,,0,0,0,,Duduk
Dialog: 0,0:54:06.36,0:54:08.48,teks umum,,0,0,0,,Kami sudah lama tidak berjumpa
Dialog: 0,0:54:08.57,0:54:11.99,teks umum,,0,0,0,,Mari kita bincang sambil minum teh
Dialog: 0,0:54:15.61,0:54:17.32,teks umum,,0,0,0,,Ada sesuatu yang salah?
Dialog: 0,0:54:18.16,0:54:19.70,teks umum,,0,0,0,,Anda kelihatan letih
Dialog: 0,0:54:23.71,0:54:25.00,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:54:26.17,0:54:30.46,teks umum,,0,0,0,,Saya akan makan kuki anda dan segera sedar
Dialog: 0,0:54:40.43,0:54:41.72,miring,,0,0,0,,Moo Dok
Dialog: 0,0:54:42.89,0:54:44.52,teks umum,,0,0,0,,Saya ada urusan
Dialog: 0,0:54:44.60,0:54:46.56,teks umum,,0,0,0,,Arahan? yang mana?
Dialog: 0,0:54:46.65,0:54:47.86,teks umum,,0,0,0,,Pergi ke Jeonbugwan
Dialog: 0,0:54:49.06,0:54:52.36,teks umum,,0,0,0,,Ini masih salah. Sampaikan ini
Dialog: 0,0:54:53.69,0:54:54.95,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:54:59.70,0:55:01.62,teks umum,,0,0,0,,Adakah sesuatu berlaku di Sejukwon?
Dialog: 0,0:55:02.70,0:55:05.21,teks umum,,0,0,0,,Saya tidak tahu semuanya
Dialog: 0,0:55:05.29,0:55:08.79,teks umum,,0,0,0,,Tetapi nampaknya ini berkaitan dengan apa yang berlaku dengan Degantongun
Dialog: 0,0:55:09.59,0:55:11.75,teks umum,,0,0,0,,Saya dengar Jeonbugwan dan Sosnovy Bor sedang bergaduh
Dialog: 0,0:55:17.22,0:55:18.09,teks umum,,0,0,0,,Di mana Yul?
Dialog: 0,0:55:18.18,0:55:19.89,teks umum,,0,0,0,,Saya tidak berjumpa dia sejak malam tadi
Dialog: 0,0:55:19.97,0:55:21.89,teks umum,,0,0,0,,Menjalankan arahan daripada ketua, mungkin
Dialog: 0,0:55:23.14,0:55:24.27,teks umum,,0,0,0,,Ya?
Dialog: 0,0:55:25.85,0:55:27.14,kenangan miring,,0,0,0,,Dan saya berjuang
Dialog: 0,0:55:29.27,0:55:30.69,kenangan,,0,0,0,,dengan nomad
Dialog: 0,0:55:43.29,0:55:45.45,teks umum,,0,0,0,,Kita mesti mengukuhkan sempadan
Dialog: 0,0:55:45.54,0:55:48.37,teks umum,,0,0,0,,Anda dilarang meninggalkan Sosnovy Bor
Dialog: 0,0:55:50.29,0:55:52.04,miring,,0,0,0,,Mereka yang memiliki Ryusu dan banyak lagi,
Dialog: 0,0:55:52.13,0:55:55.55,teks umum,,0,0,0,,pergi ke Saejukwon dan ikut arahan Sang Ho
Dialog: 0,0:55:55.63,0:55:56.76,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:55:57.63,0:55:58.55,contact,,0,0,0,,Chang Wook
Dialog: 0,0:55:59.89,0:56:00.89,teks umum,,0,0,0,,Anda tinggal
Dialog: 0,0:56:02.30,0:56:04.01,teks umum,,0,0,0,,Semua orang kecuali Chan Wook,
Dialog: 0,0:56:04.10,0:56:06.89,teks umum,,0,0,0,,ikut Sang Ho ke Saejukwon
Dialog: 0,0:56:06.98,0:56:08.27,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:56:13.82,0:56:14.98,teks umum,,0,0,0,,Bab
Dialog: 0,0:56:15.86,0:56:17.78,teks umum,,0,0,0,,Mengapa saya tidak pergi?
Dialog: 0,0:56:17.86,0:56:20.66,teks umum,,0,0,0,,Anda tidak memerlukannya kerana anda tidak diperlukan di sana
Dialog: 0,0:56:21.91,0:56:23.78,teks umum,,0,0,0,,Adakah ada sesuatu yang berbahaya di sana?
Dialog: 0,0:56:24.83,0:56:26.20,teks umum,,0,0,0,,Adakah orang nomad di sana?
Dialog: 0,0:56:26.79,0:56:28.87,teks umum,,0,0,0,,Ini bukan urusan anda
Dialog: 0,0:56:29.62,0:56:31.04,teks umum,,0,0,0,,Tidak berminat pun
Dialog: 0,0:56:31.13,0:56:33.92,teks umum,,0,0,0,,Kenapa awak sembunyikan segala-galanya daripada saya? Saya juga ahli silap mata di sini
Dialog: 0,0:56:34.00,0:56:37.34,teks umum,,0,0,0,,Anda adalah pengecualian kepada semua peraturan
Dialog: 0,0:56:37.92,0:56:40.72,teks umum,,0,0,0,,Jika anda bosan, anda boleh meninggalkan Sosnovy Bor
Dialog: 0,0:56:40.80,0:56:44.18,teks umum,,0,0,0,,Pulang ke rumah dan lakukan apa yang anda suka
Dialog: 0,0:56:46.85,0:56:50.35,teks umum,,0,0,0,,Ya. Terima kasih kerana risau
Dialog: 0,0:57:08.45,0:57:09.62,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:57:10.79,0:57:13.00,teks umum,,0,0,0,,Jom ke Chwisonra dan makan sesuatu yang sedap
Dialog: 0,0:57:14.63,0:57:18.09,teks umum,,0,0,0,,Semua ahli silap mata di Sejukwon. Mengapa tidak anda?
Dialog: 0,0:57:19.67,0:57:21.13,teks umum,,0,0,0,,Saya diberitahu untuk tidak campur tangan
Dialog: 0,0:57:21.22,0:57:24.22,teks umum,,0,0,0,, dan itu bukan masalah saya
Dialog: 0,0:57:24.80,0:57:27.43,teks umum,,0,0,0,,- Jom\N- Pembantu Kim memberi saya tugas
Dialog: 0,0:57:28.14,0:57:30.60,teks umum,,0,0,0,,Baiklah. Jom pergi sama-sama. Ke mana saya harus pergi?
Dialog: 0,0:57:31.44,0:57:32.56,teks umum,,0,0,0,,Jeonbugwan
Dialog: 0,0:57:34.31,0:57:35.23,teks umum,,0,0,0,,Jom pergi kemudian
Dialog: 0,0:57:39.99,0:57:44.66,teks umum,,0,0,0,,Saya dengar awak beritahu dia yang awak nak badan lain
Dialog: 0,0:57:46.78,0:57:48.12,teks umum,,0,0,0,,Adakah anda akan memberikannya kepada saya?
Dialog: 0,0:57:48.91,0:57:53.17,teks umum,,0,0,0,,Kemudian saya mahu tubuh gadis yang akan menyertai Jinyoung sebagai Boo Young
Dialog: 0,0:57:55.54,0:57:57.25,teks umum,,0,0,0,,Setelah berada di dalam tubuh seorang sida,
Dialog: 0,0:57:58.00,0:57:59.71,teks umum,,0,0,0,,Saya tidak keberatan berada dalam tubuh wanita
Dialog: 0,0:58:00.51,0:58:05.43,teks umum,,0,0,0,,Saya mahukan badan yang kuat, seperti bomoh
Dialog: 0,0:58:07.10,0:58:08.35,teks umum,,0,0,0,,"Dukun"?
Dialog: 0,0:58:09.60,0:58:11.93,teks umum,,0,0,0,,Dia kecewa kerana anda mengingatkannya tentang
Dialog: 0,0:58:12.02,0:58:15.15,teks umum,,0,0,0,,bahawa dia seorang bomoh, tukang tilik
Dialog: 0,0:58:15.77,0:58:17.36,teks umum,,0,0,0,,Saya tidak berbohong
Dialog: 0,0:58:19.82,0:58:24.49,teks umum,,0,0,0,,Saya juga teringat bagaimana saya meminta makanan dan mencuri gula-gula
Dialog: 0,0:58:26.16,0:58:30.20,teks umum,,0,0,0,,Ia bukan satu pembohongan, tetapi saya tidak gembira mendengar sesuatu seperti itu
Dialog: 0,0:58:40.05,0:58:43.22,teks umum,,0,0,0,,Jin Mu ingin makan biskut,
Dialog: 0,0:58:43.30,0:58:45.09,teks umum,,0,0,0,,tetapi Park Jin tidak membenarkannya
Dialog: 0,0:58:45.72,0:58:47.72,teks umum,,0,0,0,,Maiden Kim bimbang Ji Moo akan tersinggung,
Dialog: 0,0:58:47.80,0:58:49.76,teks umum,,0,0,0,,jadi saya minta awak berikan ini kepadanya
Dialog: 0,0:58:49.85,0:58:52.81,teks umum,,0,0,0,,Jadi, mereka bertengkar seperti kanak-kanak kerana makanan?
Dialog: 0,0:58:52.89,0:58:55.64,teks umum,,0,0,0,,Bab ini kadang-kadang sangat remeh
Dialog: 0,0:58:55.73,0:58:58.56,teks umum,,0,0,0,,Bertengkar pasal biskut madu?!
Dialog: 0,0:58:58.65,0:59:00.94,teks umum,,0,0,0,,Anda betul, ini remeh
Dialog: 0,0:59:08.07,0:59:09.62,kenangan miring,,0,0,0,,Di sini di Jeonbugwan
Dialog: 0,0:59:09.70,0:59:12.49,kenangan miring,,0,0,0,,kami tulis semua bintang
Dialog: 0,0:59:35.73,0:59:39.19,teks umum,,0,0,0,,Saya akan memberitahu timbalan bahawa ini adalah dari keluarga Chan
Dialog: 0,0:59:39.98,0:59:43.61,teks umum,,0,0,0,,Beritahu dia ia daripada pembantu rumah Kim
Dialog: 0,0:59:44.90,0:59:47.24,teks umum,,0,0,0,,Dan juga ia mengandungi banyak minyak
Dialog: 0,0:59:47.32,0:59:49.62,teks umum,,0,0,0,,dan harus dibasuh dengan teh hijau
Dialog: 0,0:59:49.70,0:59:50.78,teks umum,,0,0,0,,Ya, tuan
Dialog: 0,0:59:50.87,0:59:53.49,teks umum,,0,0,0,,Dan di sana, sudah tentu, ada madu
Dialog: 0,0:59:53.58,0:59:55.87,teks umum,,0,0,0,,Ia mesti disimpan dalam keadaan sejuk, jika tidak ia akan melekat bersama
Dialog: 0,0:59:55.95,0:59:58.37,teks umum,,0,0,0,,- Ya, tuan\N- Dan sejak kami membawanya,
Dialog: 0,0:59:58.46,1:00:00.42,teks umum,,0,0,0,,- boleh saya masuk ke dalam?\N- Ya...
Dialog: 0,1:00:00.50,1:00:02.92,teks umum,,0,0,0,,- Apa?\N- Terima kasih. Kami tidak akan bertahan lama
Dialog: 0,1:00:03.00,1:00:03.92,teks umum,,0,0,0,,Jom
Dialog: 0,1:00:05.59,1:00:06.55,teks umum,,0,0,0,,Tetapi...
Dialog: 0,1:00:14.39,1:00:16.31,teks umum,,0,0,0,,Saya sentiasa mahu melawat ke sini
Dialog: 0,1:00:16.39,1:00:19.85,teks umum,,0,0,0,,Walaupun ayah saya Gwangju, saya tidak dibenarkan ke sini
Dialog: 0,1:00:24.36,1:00:26.65,teks umum,,0,0,0,,Hei, apa ini?
Dialog: 0,1:00:28.45,1:00:31.03,teks umum,,0,0,0,,Anda berada di sini, bukan?
Dialog: 0,1:00:31.12,1:00:33.24,teks umum,,0,0,0,,Ayah kamu seorang ahli nujum di sini
Dialog: 0,1:00:34.41,1:00:36.33,teks umum,,0,0,0,,Adakah anda datang ke sini untuk saya?
Dialog: 0,1:00:38.96,1:00:42.04,teks umum,,0,0,0,,Anda boleh meminta seseorang menghantar kuki
Dialog: 0,1:00:42.71,1:00:45.75,teks umum,,0,0,0,,Tetapi saya datang sendiri kerana saya mahu, betulkah saya?
Dialog: 0,1:00:50.43,1:00:53.47,teks umum,,0,0,0,,Semasa kecil, ayah saya sering membawa saya ke sini
Dialog: 0,1:00:54.60,1:00:58.02,teks umum,,0,0,0,,Malah menunjukkan kepada saya rakaman hari saya dilahirkan
Dialog: 0,1:00:59.48,1:01:01.10,teks umum,,0,0,0,,Dia seorang bapa yang baik
Dialog: 0,1:01:04.61,1:01:06.15,teks umum,,0,0,0,,Jika anda memikirkannya,
Dialog: 0,1:01:06.23,1:01:09.32,teks umum,,0,0,0,,pasti ada rakaman di sini dari hari lahir anda juga
Dialog: 0,1:01:11.70,1:01:13.20,teks umum,,0,0,0,,Adakah anda fikir?
Dialog: 0,1:01:14.53,1:01:18.04,teks umum,,0,0,0,,Jadi, rakaman dari hari itu sepatutnya ada di sini di suatu tempat
Dialog: 0,1:01:31.38,1:01:33.93,teks umum,,0,0,0,,Anda menjanjikan saya badan baharu
Dialog: 0,1:01:34.47,1:01:37.10,teks umum,,0,0,0,,Tetapi sebaliknya anda bertukar menjadi batu
Dialog: 0,1:01:37.76,1:01:39.18,teks umum,,0,0,0,,Anda tidak diperlukan lagi
Dialog: 0,1:01:39.85,1:01:42.27,teks umum,,0,0,0,,Dan anda hanya akan bertukar menjadi batu
Dialog: 0,1:01:57.99,1:01:59.29,teks umum,,0,0,0,,Bajingan...
Dialog: 0,1:02:18.22,1:02:20.47,teks umum,,0,0,0,,Apabila malam tiba, ahli sihir akan datang
Dialog: 0,1:02:21.10,1:02:22.64,teks umum,,0,0,0,,Mari kita lihat bagaimana mereka membuat nota?
Dialog: 0,1:02:22.73,1:02:24.81,teks umum,,0,0,0,,Mereka kata ia pemandangan yang menakjubkan
Dialog: 0,1:02:27.02,1:02:30.73,teks umum,,0,0,0,,Memang bagus, tetapi akan ada masalah jika kita ditangkap
Dialog: 0,1:02:30.82,1:02:31.94,teks umum,,0,0,0,,Jom pulang
Dialog: 0,1:02:45.58,1:02:47.25,teks umum,,0,0,0,,Eunuch Kim menjadi liar
Dialog: 0,1:02:47.33,1:02:49.71,teks umum,,0,0,0,,Tiada sesiapa yang tahu bahawa dia seorang nomad
Dialog: 0,1:02:50.30,1:02:53.72,teks umum,,0,0,0,,Dia masih di Jeonbugwan. Kita mesti cari dia sebelum subuh
Dialog: 0,1:02:53.80,1:02:54.97,teks umum,,0,0,0,,Ya
Dialog: 0,1:03:38.39,1:03:39.85,teks umum,,0,0,0,,Saya tahu awak ada di sini
Dialog: 0,1:03:40.39,1:03:42.68,teks umum,,0,0,0,,Tidak perlu membuat masalah, keluar
Dialog: 0,1:03:42.76,1:03:44.31,teks umum,,0,0,0,,Saya akan berikan apa yang anda mahu
Dialog: 0,1:03:52.40,1:03:53.65,teks umum,,0,0,0,,Keluar
Dialog: 0,1:03:55.94,1:03:57.86,teks umum,,0,0,0,,- Sekarang!\N- Saya akan pergi
Dialog: 0,1:04:02.91,1:04:04.87,teks umum,,0,0,0,,- Chan Wook\N- Ya
Dialog: 0,1:04:10.42,1:04:12.04,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,1:04:12.54,1:04:14.21,teks umum,,0,0,0,,Maaf. Saya ada urusan
Dialog: 0,1:04:14.30,1:04:15.84,teks umum,,0,0,0,,Baiklah, saya mahu menonton
Dialog: 0,1:04:20.14,1:04:21.30,teks umum,,0,0,0,,Arahan?
Dialog: 0,1:04:21.93,1:04:25.52,teks umum,,0,0,0,,Saya dengar awak mahukan biskut madu
Dialog: 0,1:04:26.68,1:04:28.06,teks umum,,0,0,0,,Kuki?
Dialog: 0,1:04:28.14,1:04:30.19,teks umum,,0,0,0,,Hamba Kim perasan yang awak kecewa,
Dialog: 0,1:04:30.27,1:04:32.02,teks umum,,0,0,0,,dan meminta saya untuk memberi anda sedikit
Dialog: 0,1:04:34.65,1:04:37.07,teks umum,,0,0,0,,Terima kasih. Beritahu dia saya bersyukur
Dialog: 0,1:04:37.82,1:04:38.95,contact,,0,0,0,,Apa?
Dialog: 0,1:04:40.36,1:04:43.28,teks umum,,0,0,0,,Saya sangka awak akan marah saya masuk tanpa kebenaran
Dialog: 0,1:04:44.03,1:04:44.91,teks umum,,0,0,0,,Awak tak marah ke?
Dialog: 0,1:04:44.99,1:04:48.29,teks umum,,0,0,0,,Anda datang untuk memberi saya kuki. awak boleh pergi
Dialog: 0,1:04:49.58,1:04:51.58,teks umum,,0,0,0,,Baik. Sejujurnya...
Dialog: 0,1:04:53.13,1:04:54.13,teks umum,,0,0,0,,Saya tidak bersendirian
Dialog: 0,1:04:55.55,1:04:57.42,teks umum,,0,0,0,,Moo Dok, keluar. Dia tak marah
Dialog: 0,1:04:58.55,1:05:00.47,teks umum,,0,0,0,,Ini pembantu rumah saya
Dialog: 0,1:05:02.01,1:05:03.80,teks umum,,0,0,0,,Saya Moo Dok,
Dialog: 0,1:05:03.89,1:05:05.43,teks umum,,0,0,0,,pembantu rumahnya
Dialog: 0,1:05:07.97,1:05:09.52,teks umum,,0,0,0,,Anda di sini juga
Dialog: 0,1:05:10.23,1:05:12.23,teks umum,,0,0,0,,Saya fikir awak akan marah
Dialog: 0,1:05:12.31,1:05:15.44,teks umum,,0,0,0,,Terima kasih atas layanan anda
Dialog: 0,1:05:15.52,1:05:16.82,teks umum,,0,0,0,,Makan kuki
Dialog: 0,1:05:16.90,1:05:19.24,teks umum,,0,0,0,,Jika anda mahu lebih, beritahu saya
Dialog: 0,1:05:21.99,1:05:23.24,teks umum,,0,0,0,,Terima kasih
Dialog: 0,1:05:23.32,1:05:24.45,teks umum,,0,0,0,,Jom
Dialog: 0,1:05:39.63,1:05:42.84,kenangan,,0,0,0,,Ini sida diraja
Dialog: 0,1:05:43.89,1:05:45.30,kenangan condong,,0,0,0,,Ada apa dengan dia?
Dialog: 0,1:05:46.56,1:05:47.97,kenangan,,0,0,0,,Dia seorang nomad
Dialog: 0,1:05:48.85,1:05:51.44,kenangan,,0,0,0,,Tengok. Dia menjadi liar
Dialog: 0,1:05:59.40,1:06:01.82,kenangan miring,,0,0,0,,Saya tidak percaya bahawa perantau itu berada di dalam istana
Dialog: 0,1:06:01.90,1:06:02.95,kenangan,,0,0,0,,Mungkin
Dialog: 0,1:06:03.82,1:06:05.12,kenangan,,0,0,0,,ini perbuatan dia
Dialog: 0,1:06:08.45,1:06:09.83,kenangan condong,,0,0,0,,Saya tahu awak ada di sini
Dialog: 0,1:06:10.33,1:06:12.71,kenangan,,0,0,0,,Tak perlu buat masalah, keluarlah
Dialog: 0,1:06:12.79,1:06:14.54,kenangan,,0,0,0,,Saya akan berikan apa yang awak mahu
Dialog: 0,1:06:21.34,1:06:22.76,kenangan condong,,0,0,0,,Keluar!
Dialog: 0,1:06:31.35,1:06:32.60,kenangan,,0,0,0,,Saya akan pergi
Dialog: 0,1:06:58.50,1:06:59.71,teks umum,,0,0,0,,Jalankan
Dialog: 0,1:07:02.84,1:07:04.09,teks umum,,0,0,0,,Di belakang kami ada pintu lain
Dialog: 0,1:07:17.10,1:07:18.73,teks umum,,0,0,0,,Mengapa anda tidak mahu melepaskan kami?
Dialog: 0,1:07:19.73,1:07:23.82,teks umum,,0,0,0,,Sukar betul untuk melepaskan ahli silap mata yang begitu mudah sampai ke sini
Dialog: 0,1:07:23.90,1:07:26.07,teks umum,,0,0,0,,Anda akan menghadapi masalah,
Dialog: 0,1:07:27.07,1:07:28.53,teks umum,,0,0,0,,jika saya hilang dalam Jeonbugwan
Dialog: 0,1:07:28.62,1:07:30.08,teks umum,,0,0,0,,Dan saya tidak akan membahayakan awak
Dialog: 0,1:07:31.24,1:07:33.45,teks umum,,0,0,0,,Badan anda akan selamat
Dialog: 0,1:07:42.96,1:07:43.96,teks umum,,0,0,0,,Chan Uk...
Dialog: 0,1:08:46.61,1:08:48.90,miring,,0,0,0,,Anda berada di dalam penghalang yang saya cipta
Dialog: 0,1:08:53.49,1:08:54.62,contact,,0,0,0,,Jangan risau
Dialog: 0,1:08:55.49,1:08:57.62,teks umum,,0,0,0,,Berdiri dan anda tidak akan cedera
Dialog: 0,1:08:59.25,1:09:01.17,teks umum,,0,0,0,,Tunggu di sini
Dialog: 0,1:09:14.72,1:09:16.22,teks umum,,0,0,0,,Nama awak Mu Dok?
Dialog: 0,1:09:17.89,1:09:19.85,teks umum,,0,0,0,,Pembantu rumah yang sama,
Dialog: 0,1:09:19.93,1:09:24.15,teks umum,,0,0,0,,yang sentiasa bersamanya dan dari siapa dia sentiasa dalam kesusahan
Dialog: 0,1:09:27.40,1:09:29.40,teks umum,,0,0,0,,Ada seseorang di sini
Dialog: 0,1:09:29.94,1:09:32.07,teks umum,,0,0,0,,Keluar dan pulihkan tenaga anda
Dialog: 0,1:09:43.75,1:09:45.21,teks umum,,0,0,0,,Dan kemudian
Dialog: 0,1:09:45.79,1:09:49.71,teks umum,,0,0,0,,Saya akan memindahkan awak ke dalam badan tuan muda, seperti yang awak mahu
Dialog: 0,1:10:03.69,1:10:05.23,teks umum,,0,0,0,,Ahli sihir ini... bomoh Choi
Dialog: 0,1:10:06.69,1:10:08.82,teks umum,,0,0,0,,kata nak bunuh saya?
Dialog: 0,1:10:09.86,1:10:11.82,teks umum,,0,0,0,,saya perlukan bantuan anda
Dialog: 0,1:10:12.57,1:10:15.45,teks umum,,0,0,0,,Jika anda tidak percaya saya, saya akan pergi
Dialog: 0,1:10:17.37,1:10:19.58,teks umum,,0,0,0,,Anda boleh makan snek bersamanya
Dialog: 0,1:11:11.25,1:11:12.84,teks umum,,0,0,0,,Kita perlu keluar dari sini
Dialog: 0,1:12:07.77,1:12:10.69,teks umum,,0,0,0,,Cikgu, tolong saya sekali lagi
Dialog: 0,1:12:11.44,1:12:13.82,teks umum,,0,0,0,,Beri keyakinan pelajar anda
Dialog: 0,1:12:25.33,1:12:26.50,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:13:06.62,1:13:07.66,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:13:10.21,1:13:11.37,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,1:13:44.24,1:13:45.37,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:14:13.77,1:14:14.98,teks umum,,0,0,0,,Mu Dok...
Dialog: 0,1:14:18.27,1:14:19.44,teks umum,,0,0,0,,Saya...
Dialog: 0,1:14:21.74,1:14:23.70,teks umum,,0,0,0,,hanya menghabiskan tenaganya
Dialog: 0,1:14:30.91,1:14:32.12,teks umum,,0,0,0,,Saya...
Dialog: 0,1:14:33.75,1:14:35.29,teks umum,,0,0,0,,berlari?
Dialog: 0,1:14:49.64,1:14:51.56,teks umum,,0,0,0,,- Mu Dok..\N- Jangan dekati
Dialog: 0,1:15:04.95,1:15:06.49,teks umum,,0,0,0,,No. Semuanya baik-baik saja
Dialog: 0,1:15:07.24,1:15:08.62,teks umum,,0,0,0,,Awak okay
Dialog: 0,1:15:10.37,1:15:12.20,teks umum,,0,0,0,,- Dan anda akan baik-baik saja\N- Tidak
Dialog: 0,1:15:13.20,1:15:14.25,teks umum,,0,0,0,,Jangan sentuh saya
Dialog: 0,1:15:16.33,1:15:17.96,teks umum,,0,0,0,,Jika saya menjadi liar,
Dialog: 0,1:15:20.17,1:15:22.01,teks umum,,0,0,0,,lebih baik kamu jangan sentuh saya
Dialog: 0,1:15:25.51,1:15:27.22,teks umum,,0,0,0,,Jika tidak, saya akan menghabiskan tenaga anda juga
Dialog: 0,1:15:28.09,1:15:29.22,teks umum,,0,0,0,,dan kamu akan mati
Dialog: 0,1:17:10.36,1:17:12.53,pratonton,,0,0,0,,Ada bunyi bising dari bilik rakaman
Dialog: 0,1:17:12.62,1:17:13.99,pratonton,,0,0,0,,Keluar!
Dialog: 0,1:17:14.08,1:17:17.04,pratonton,,0,0,0,,Adakah anda marah kerana kami menjadikan rakan anda menjadi batu?
Dialog: 0,1:17:17.12,1:17:19.87,pratonton,,0,0,0,,Anda tidak akan pernah meninggalkan tempat ini
Dialog: 0,1:17:19.96,1:17:23.00,pratonton,,0,0,0,,Jadi, ini ahli keluarga Cho?
Dialog: 0,1:17:23.08,1:17:26.92,pratonton,,0,0,0,,Dan jika rohnya melekat pada Uka, bagaimana pula?
Dialog: 0,1:17:27.00,1:17:30.93,pratonton,,0,0,0,,Jika saya tidak meninggalkan awak di pergunungan,
Dialog: 0,1:17:31.01,1:17:32.93,pratonton,,0,0,0,,ini tidak akan berlaku kepada anda
Dialog: 0,1:17:33.01,1:17:34.43,pratonton,,0,0,0,,Adakah anda mempertaruhkan nyawa anda?
Dialog: 0,1:17:34.51,1:17:36.51,pratonton,,0,0,0,,Tawarkan diri anda sebagai balasan kali ini
Dialog: 0,1:17:36.60,1:17:38.22,pratonton,,0,0,0,,Saya pasti menang esok
Dialog: 0,1:17:38.31,1:17:40.39,pratonton,,0,0,0,,Saya perlukan seseorang yang pasti menang
Dialog: 0,1:17:40.48,1:17:43.06,pratonton,,0,0,0,,Jika dia sedang mencari batu untuk melindunginya...
Dialog: 0,1:17:43.15,1:17:44.15,pratonton,,0,0,0,,Mereka tidak boleh bersama
Dialog: 0,1:17:44.23,1:17:46.69,pratonton,,0,0,0,,Semua tentang anda telah muncul
Dialog: 0,0:02:55.14,0:02:57.14,nicks,,0,0,0,,

