Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:00:47.49,0:00:51.04,teks umum,,0,0,0,,Bilik akan kosong sementara lelaki itu berada di Sosnovy Bor
Dialog: 0,0:00:51.12,0:00:53.92,teks umum,,0,0,0,,Bersihkan di sini
Dialog: 0,0:00:54.00,0:00:55.13,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:00:57.75,0:01:02.01,teks umum,,0,0,0,,Dia keluar rumah dan balik berkali-kali
Dialog: 0,0:01:02.59,0:01:05.05,teks umum,,0,0,0,,Tunggu beberapa hari, mungkin dia akan kembali
Dialog: 0,0:01:05.89,0:01:07.14,teks umum,,0,0,0,,Kali ini semuanya berbeza
Dialog: 0,0:01:07.89,0:01:10.85,teks umum,,0,0,0,,Dia telah berubah
Dialog: 0,0:01:12.14,0:01:14.35,teks umum,,0,0,0,,Dan mungkin dia akan berkahwin tidak lama lagi
Dialog: 0,0:01:15.06,0:01:16.61,miring,,0,0,0,,Jadi kita perlu membersihkan di mana-mana
Dialog: 0,0:01:17.27,0:01:19.44,italic,,0,0,0,,Dia tunang lagi ke?
Dialog: 0,0:01:20.36,0:01:23.70,teks umum,,0,0,0,,Jika dia tidak berkahwin kali ini, dia tidak mungkin mendapat isteri
Dialog: 0,0:01:24.28,0:01:25.86,italic,,0,0,0,,Kali ini semuanya berbeza!
Dialog: 0,0:01:25.95,0:01:30.83,teks umum,,0,0,0,,Tuan muda amat menyayangi seseorang
Dialog: 0,0:01:32.37,0:01:33.46,teks umum,,0,0,0,,Betulkah, Moo Deok?
Dialog: 0,0:01:35.08,0:01:37.75,teks umum,,0,0,0,,Telur burung yang disebutnya
Dialog: 0,0:01:38.75,0:01:42.80,teks umum,,0,0,0,,Saya pasti ini gadis yang saya lihat di Sosnovy Bor
Dialog: 0,0:01:43.59,0:01:46.26,teks umum,,0,0,0,,Telur dalam sarang di atas pokok
Dialog: 0,0:01:46.34,0:01:48.89,teks umum,,0,0,0,,Ini mungkin gadis yang canggih,
Dialog: 0,0:01:49.47,0:01:51.27,teks umum,,0,0,0,,yang perlu dilindungi
Dialog: 0,0:01:51.35,0:01:54.06,teks umum,,0,0,0,,Sesuatu seperti bangau putih
Dialog: 0,0:01:54.14,0:01:55.19,teks umum,,0,0,0,,Seperti saya
Dialog: 0,0:01:55.27,0:01:56.56,teks umum,,0,0,0,,Siapa tahu?
Dialog: 0,0:01:57.31,0:02:02.03,teks umum,,0,0,0,,Menetas dan ternyata helang yang dahagakan darah,
Dialog: 0,0:02:02.11,0:02:04.19,teks umum,,0,0,0,,bukan bangau yang canggih
Dialog: 0,0:02:04.78,0:02:05.86,teks umum,,0,0,0,,Ya?
Dialog: 0,0:02:06.66,0:02:08.24,teks umum,,0,0,0,,Helang yang dahagakan darah, sungguh ngeri
Dialog: 0,0:02:09.07,0:02:11.45,teks umum,,0,0,0,,Saya harap telur itu bukan burung belatuk atau burung cuckoo
Dialog: 0,0:02:11.54,0:02:13.12,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:02:13.70,0:02:16.71,teks umum,,0,0,0,,Anak ayam akan menetas dan terbang pergi
Dialog: 0,0:02:18.29,0:02:21.38,teks umum,,0,0,0,,Bagaimana jika dia juga mencintainya?
Dialog: 0,0:02:22.67,0:02:27.34,teks umum,,0,0,0,,Jika mereka begitu rapat, saya pasti perasaan itu bersama
Dialog: 0,0:02:28.18,0:02:30.39,teks umum,,0,0,0,,Anak ayam mesti jatuh cinta dengannya
Dialog: 0,0:02:33.22,0:02:35.39,teks umum,,0,0,0,,Saya harap ini Cik Ho
Dialog: 0,0:02:36.27,0:02:37.81,teks umum,,0,0,0,,Dia kelihatan seperti Puan Do Hwa
Dialog: 0,0:02:40.65,0:02:41.98,teks umum,,0,0,0,,- Kasim Li\N- Ya?
Dialog: 0,0:02:42.07,0:02:44.28,teks umum,,0,0,0,,Letakkan di sana. Ini adalah buku-buku Chan Wook
Dialog: 0,0:02:45.69,0:02:47.11,teks umum,,0,0,0,,Cepat
Dialog: 0,0:02:51.08,0:02:53.16,di sebalik tabir,,0,0,0,,Apa yang menghubungkan kita dengan Chan Wook:
Dialog: 0,0:02:54.41,0:02:56.54,di sebalik tabir,,0,0,0,, keinginan terdesak untuk terus hidup
Dialog: 0,0:02:59.92,0:03:02.46,di sebalik tabir,,0,0,0,,dan temui diri anda
Dialog: 0,0:03:12.10,0:03:14.01,di sebalik tabir,,0,0,0,,Apabila kita mendapat apa yang kita mahu,
Dialog: 0,0:03:15.39,0:03:18.02,di belakang tabir,,0,0,0,,kami akan segera berselerak ke arah yang berbeza
Dialog: 0,0:03:20.81,0:03:23.07,di sebalik tabir,,0,0,0,,Cinta yang pembantu Kim cakapkan,
Dialog: 0,0:03:25.53,0:03:27.74,luar skrin,,0,0,0,,mungkin dia tergelincir di antara kita,
Dialog: 0,0:03:28.82,0:03:33.49,suara,,0,0,0,,tetapi ini tidak lebih daripada cangkerang yang akan saya buang apabila saya menetas
Dialog: 0,0:03:55.64,0:03:58.93,teks umum,,0,0,0,,Adakah anda sudah belajar dan menulis segala-galanya?
Dialog: 0,0:03:59.02,0:04:02.81,teks umum,,0,0,0,,Ya, anda boleh menyemak. Saya pasti saya ingat semuanya
Dialog: 0,0:04:05.73,0:04:06.90,teks umum,,0,0,0,,Masih,
Dialog: 0,0:04:06.98,0:04:09.24,teks umum,,0,0,0,,ini sepatutnya mengambil masa sekurang-kurangnya sebulan
Dialog: 0,0:04:09.32,0:04:13.03,teks umum,,0,0,0,,Saya mempunyai 12 guru, saya membaca buku ini sebanyak 12 kali
Dialog: 0,0:04:13.62,0:04:14.74,teks umum,,0,0,0,,Orang mungkin berkata,
Dialog: 0,0:04:14.83,0:04:17.20,teks umum,,0,0,0,,tugasnya adalah sekeping kek
Dialog: 0,0:04:17.29,0:04:20.71,teks umum,,0,0,0,,Dan saya tertanya-tanya mengapa dia bersetuju untuk mengikut peraturan
Dialog: 0,0:04:20.79,0:04:22.33,teks umum,,0,0,0,,Dia ada sebab
Dialog: 0,0:04:22.42,0:04:25.71,teks umum,,0,0,0,,Sekarang saya boleh meninggalkan Sosnovy Bor bila-bila masa saya mahu. saya pulang
Dialog: 0,0:04:26.30,0:04:27.50,miring,,0,0,0,,Tidak begitu pantas
Dialog: 0,0:04:35.47,0:04:37.06,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:04:37.14,0:04:40.27,teks umum,,0,0,0,,Peraturan mengatakan saya boleh keluar jika saya menguasai asasnya
Dialog: 0,0:04:40.35,0:04:42.52,teks umum,,0,0,0,,Apabila saya meminta untuk membaca buku,
Dialog: 0,0:04:42.60,0:04:44.65,teks umum,,0,0,0,,Saya tidak bermaksud untuk mengingati mereka sahaja
Dialog: 0,0:04:44.73,0:04:46.65,teks umum,,0,0,0,,Anda sepatutnya mempelajari segala-galanya dengan hati
Dialog: 0,0:04:47.48,0:04:49.78,teks umum,,0,0,0,,Tetapi oleh kerana anda agak licik,
Dialog: 0,0:04:49.86,0:04:53.16,teks umum,,0,0,0,,Saya tidak percaya anda menghafal semuanya
Dialog: 0,0:04:54.74,0:04:56.16,teks umum,,0,0,0,,Saya tidak tahu,
Dialog: 0,0:04:56.87,0:04:59.75,teks umum,,0,0,0,,bahawa ketua Sosnovy Bor boleh menukar peraturan sesuka hati
Dialog: 0,0:05:01.21,0:05:02.04,teks umum,,0,0,0,,Di sini
Dialog: 0,0:05:02.75,0:05:04.67,teks umum,,0,0,0,,Saya ada tugas lain
Dialog: 0,0:05:05.25,0:05:07.50,teks umum,,0,0,0,,Jika anda membaca buku ini,
Dialog: 0,0:05:09.09,0:05:12.13,teks umum,,0,0,0,,Saya akan membenarkan anda meninggalkan Sosnovy Bor bila-bila masa anda mahu
Dialog: 0,0:05:15.68,0:05:16.97,teks umum,,0,0,0,,Tidak!
Dialog: 0,0:05:24.48,0:05:26.36,teks umum,,0,0,0,,Saya pasti boleh keluar,
Dialog: 0,0:05:27.61,0:05:29.07,teks umum,,0,0,0,,jika saya membacanya?
Dialog: 0,0:05:29.15,0:05:30.23,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:05:31.07,0:05:33.86,teks umum,,0,0,0,,Saya harap membaca buku ini
Dialog: 0,0:05:34.61,0:05:37.20,teks umum,,0,0,0,,juga tidak sukar
Dialog: 0,0:05:38.66,0:05:40.33,teks umum,,0,0,0,,Semuanya buruk
Dialog: 0,0:05:40.41,0:05:42.75,teks umum,,0,0,0,,Moo Deok tidak akan dapat melihat Wook untuk seketika
Dialog: 0,0:05:56.39,0:05:58.05,teks umum,,0,0,0,,Apa? Kat sini kosong
Dialog: 0,0:06:00.47,0:06:04.52,teks umum,,0,0,0,,Tidak sama sekali. Ada kata-kata
Dialog: 0,0:06:05.77,0:06:06.77,teks umum,,0,0,0,,Tidak, tiada apa-apa di sini
Dialog: 0,0:06:06.85,0:06:08.36,teks umum,,0,0,0,,Adakah anda nampak apa-apa?
Dialog: 0,0:06:09.73,0:06:11.19,teks umum,,0,0,0,,Anda tidak nampak apa-apa
Dialog: 0,0:06:12.11,0:06:14.65,teks umum,,0,0,0,,Anda boleh membaca buku ini hanya dengan menumpukan tenaga anda
Dialog: 0,0:06:14.74,0:06:17.24,teks umum,,0,0,0,,Ini adalah buku Master Seo Kyung "Words of the Heart"
Dialog: 0,0:06:20.95,0:06:21.91,teks umum,,0,0,0,,Faham
Dialog: 0,0:06:22.87,0:06:25.71,teks umum,,0,0,0,,Jadi ini sebenarnya perkataan?
Dialog: 0,0:06:25.79,0:06:28.50,teks umum,,0,0,0,,Dan adakah saya seorang sahaja yang tidak boleh membacanya?
Dialog: 0,0:06:33.59,0:06:35.59,teks umum,,0,0,0,,Rakan awak Chan Wook,
Dialog: 0,0:06:35.67,0:06:37.43,teks umum,,0,0,0,,mesti tidak tahu jenis buku ini
Dialog: 0,0:06:37.51,0:06:41.05,teks umum,,0,0,0,,Dia tidak pernah berlatih. Bagaimana dia tahu?
Dialog: 0,0:06:41.14,0:06:43.02,teks umum,,0,0,0,,Dia akan dikurung di dalam dewan latihan sehingga
Dialog: 0,0:06:43.10,0:06:44.56,teks umum,,0,0,0,,sehingga dia membacanya
Dialog: 0,0:06:45.27,0:06:46.44,teks umum,,0,0,0,,Saya kasihan kepadanya
Dialog: 0,0:06:46.52,0:06:48.40,teks umum,,0,0,0,,Dia terperangkap di sana selama enam bulan
Dialog: 0,0:06:49.44,0:06:51.86,teks umum,,0,0,0,,Enam bulan tidak lama
Dialog: 0,0:06:51.94,0:06:55.40,teks umum,,0,0,0,,Dia menguasai Ryusu melalui nasib, bukan latihan
Dialog: 0,0:06:56.32,0:06:58.74,teks umum,,0,0,0,,Ia akan mengambil masa lebih setahun
Dialog: 0,0:07:07.83,0:07:10.46,teks umum,,0,0,0,,Bagaimana kami mengenali anda jika kami sendiri tidak melihat buku ini?
Dialog: 0,0:07:10.54,0:07:13.42,teks umum,,0,0,0,,Saya pasti anda memerlukan masa yang tidak kurang
Dialog: 0,0:07:13.50,0:07:16.01,teks umum,,0,0,0,,Selain itu, dia telah maju lebih jauh daripada kamu,
Dialog: 0,0:07:16.76,0:07:18.43,teks umum,,0,0,0,,yang, tidak seperti itu
Dialog: 0,0:07:19.26,0:07:20.64,teks umum,,0,0,0,,kami tidak memegang buku ini di tangan kami
Dialog: 0,0:07:25.77,0:07:28.52,teks umum,,0,0,0,,Dia betul. Jangan cakap sia-sia
Dialog: 0,0:07:28.60,0:07:29.69,teks umum,,0,0,0,,Jumpa
Dialog: 0,0:07:31.36,0:07:32.52,teks umum,,0,0,0,,Anda...
Dialog: 0,0:07:37.57,0:07:40.07,teks umum,,0,0,0,,Mengapa bapa saudaranya sudah memberikan buku ini kepadanya?
Dialog: 0,0:07:41.70,0:07:42.95,teks umum,,0,0,0,,Saya bingung
Dialog: 0,0:07:43.03,0:07:46.79,teks umum,,0,0,0,,Dia tidak akan dapat berbuat apa-apa semasa dia terperangkap di sana
Dialog: 0,0:07:53.63,0:07:54.71,teks umum,,0,0,0,,I
Dialog: 0,0:07:55.63,0:07:57.67,teks umum,,0,0,0,,Saya tidak akan mengajar Uka
Dialog: 0,0:07:58.30,0:08:01.64,teks umum,,0,0,0,,Saya akan pastikan dia dekat dan perhatikan dia
Dialog: 0,0:08:01.72,0:08:04.55,teks umum,,0,0,0,,Jadi dia tidak akan menimbulkan lebih banyak masalah
Dialog: 0,0:08:04.64,0:08:09.56,teks umum,,0,0,0,,Jadi anda tidak mengambil dia di bawah sayap anda, tetapi hanya menguncinya dalam Sosnovy Bor?
Dialog: 0,0:08:11.19,0:08:13.65,teks umum,,0,0,0,,Uk dengan kuat memasuki Sosnovy Bor,
Dialog: 0,0:08:14.23,0:08:15.86,teks umum,,0,0,0,,bapanya akan tiba tidak lama lagi
Dialog: 0,0:08:15.94,0:08:18.03,teks umum,,0,0,0,,Ayah? Geng Chang?
Dialog: 0,0:08:18.11,0:08:21.11,teks umum,,0,0,0,,Ketakutan terbesar Chang Gang ialah Wook akan membuka pintu pagar
Dialog: 0,0:08:22.66,0:08:25.33,teks umum,,0,0,0,,dan akan dikeluarkan secara terbuka kepada dunia
Dialog: 0,0:08:25.91,0:08:27.29,teks umum,,0,0,0,,Sebaik sahaja Chang Gang mengetahui,
Dialog: 0,0:08:28.20,0:08:30.08,teks umum,,0,0,0,,dia akan kembali serta-merta
Dialog: 0,0:08:30.16,0:08:34.50,teks umum,,0,0,0,,Gwangju mesti kembali dan menghalang Jin Mu
Dialog: 0,0:08:35.75,0:08:37.67,teks umum,,0,0,0,,Semuanya akan diselesaikan,
Dialog: 0,0:08:39.13,0:08:41.30,teks umum,,0,0,0,,apabila dia kembali
Dialog: 0,0:08:42.93,0:08:45.01,teks umum,,0,0,0,,Maaf untuk Chan Wook
Dialog: 0,0:08:45.85,0:08:47.76,teks umum,,0,0,0,,Dia datang sejauh ini
Dialog: 0,0:08:47.85,0:08:50.10,teks umum,,0,0,0,,tiada latihan langsung
Dialog: 0,0:08:50.18,0:08:51.56,teks umum,,0,0,0,,Bagaimana dia akan membaca "Kata-Kata Hati"?
Dialog: 0,0:08:51.64,0:08:52.89,teks umum,,0,0,0,,Ini mustahil
Dialog: 0,0:09:01.40,0:09:03.86,teks umum,,0,0,0,,Kenapa dia juga perlu membawa makanan?
Dialog: 0,0:09:04.78,0:09:06.74,teks umum,,0,0,0,,Saya mendengar sesuatu tentang dia
Dialog: 0,0:09:06.83,0:09:09.12,teks umum,,0,0,0,,Ada khabar angin pelik tentang keluarga, tiada kemahiran,
Dialog: 0,0:09:09.20,0:09:11.50,teks umum,,0,0,0,,- watak jahat\N- Tidak benar
Dialog: 0,0:09:13.71,0:09:14.88,teks umum,,0,0,0,,Dia baik
Dialog: 0,0:09:14.96,0:09:17.04,teks umum,,0,0,0,,Di manakah anda mendapat idea itu?
Dialog: 0,0:09:17.13,0:09:18.67,teks umum,,0,0,0,,Dia sangat berbahaya,
Dialog: 0,0:09:18.75,0:09:21.97,teks umum,,0,0,0,,bahawa satu-satunya orang yang boleh mengatasinya ialah Moo Deok
Dialog: 0,0:09:24.22,0:09:25.76,teks umum,,0,0,0,,- Mu Dok?\N- Ya
Dialog: 0,0:09:25.84,0:09:28.81,teks umum,,0,0,0,,Inilah pembantu rumah yang sentiasa bersamanya
Dialog: 0,0:09:33.98,0:09:35.15,kenangan,,0,0,0,,Moo Dok
Dialog: 0,0:09:35.81,0:09:38.48,kenangan,,0,0,0,,Saya dengar awak ada sepanjang malam
Dialog: 0,0:09:38.57,0:09:41.69,kenangan,,0,0,0,,Saya sangka itu Moo Deok. Maaf
Dialog: 0,0:09:43.24,0:09:45.95,teks umum,,0,0,0,,Itu sebab dia fikir saya Moo Deok
Dialog: 0,0:09:52.08,0:09:53.16,teks umum,,0,0,0,,Helo
Dialog: 0,0:09:55.37,0:09:56.79,teks umum,,0,0,0,,Kami dari Sejukwon
Dialog: 0,0:09:57.67,0:09:59.09,teks umum,,0,0,0,,Di sini, puan
Dialog: 0,0:10:37.08,0:10:39.42,teks umum,,0,0,0,,Ini... api...
Dialog: 0,0:11:05.69,0:11:06.70,kenangan condong,,0,0,0,,Di sini
Dialog: 0,0:11:06.78,0:11:08.41,kenangan,,0,0,0,,Saya ada tugas lain
Dialog: 0,0:11:13.83,0:11:15.08,teks umum,,0,0,0,,Dia menipu saya
Dialog: 0,0:11:15.16,0:11:17.12,teks umum,,0,0,0,,Melilit jari saya!
Dialog: 0,0:11:34.26,0:11:36.10,teks umum,,0,0,0,,Awak lagi!
Dialog: 0,0:11:36.18,0:11:39.94,teks umum,,0,0,0,,Ya. Adakah anda pergi ke suatu tempat?
Dialog: 0,0:11:40.02,0:11:42.40,teks umum,,0,0,0,,Nah, ya. Saya perlu berjumpa seseorang
Dialog: 0,0:11:43.69,0:11:45.57,teks umum,,0,0,0,,Tetapi kenapa melalui tingkap?
Dialog: 0,0:11:47.86,0:11:49.20,teks umum,,0,0,0,,Ini adalah pelarian
Dialog: 0,0:11:51.24,0:11:53.99,teks umum,,0,0,0,, Berpura-pura anda tidak melihat apa-apa
Dialog: 0,0:11:57.50,0:12:01.79,contact,,0,0,0,,Cik Huo sangat tidak sabar. Kenapa dia tidak menunggu saya?
Dialog: 0,0:12:01.88,0:12:04.21,italic,,0,0,0,,Dia pergi tanpa saya
Dialog: 0,0:12:08.84,0:12:10.22,teks umum,,0,0,0,,Apakah itu?
Dialog: 0,0:12:11.84,0:12:13.39,teks umum,,0,0,0,,Adakah Chan Wook tiada?
Dialog: 0,0:12:13.97,0:12:15.56,teks umum,,0,0,0,,Tidak, dia ada di sana
Dialog: 0,0:12:16.18,0:12:17.52,teks umum,,0,0,0,,Mari kita naik ke atas kemudian
Dialog: 0,0:12:17.60,0:12:21.31,teks umum,,0,0,0,,Saya perlu bercakap dengannya
Dialog: 0,0:12:21.39,0:12:23.10,teks umum,,0,0,0,,Sendirian
Dialog: 0,0:12:25.61,0:12:28.78,teks umum,,0,0,0,,Ini akan mengambil masa. Tunggu di luar
Dialog: 0,0:12:48.63,0:12:51.59,teks umum,,0,0,0,,Mu Dok, lelaki dari Sosnovy Bor telah tiba
Dialog: 0,0:12:51.68,0:12:53.18,teks umum,,0,0,0,,Mencari awak
Dialog: 0,0:13:10.86,0:13:12.53,teks umum,,0,0,0,,Hello, En. Yul
Dialog: 0,0:13:15.12,0:13:16.83,teks umum,,0,0,0,,Menunggu Uka?
Dialog: 0,0:13:18.79,0:13:20.83,teks umum,,0,0,0,,Dia tidak akan ada untuk seketika
Dialog: 0,0:13:21.62,0:13:23.54,teks umum,,0,0,0,,Dia diberi tugas yang sangat sukar
Dialog: 0,0:13:24.29,0:13:25.79,teks umum,,0,0,0,,Dia boleh menanganinya
Dialog: 0,0:13:26.67,0:13:28.75,teks umum,,0,0,0,,Perkara utama adalah kekal di sana
Dialog: 0,0:13:29.34,0:13:31.84,teks umum,,0,0,0,,dan teruskan belajar
Dialog: 0,0:13:32.59,0:13:35.59,teks umum,,0,0,0,,Saya risaukan awak sejak hari itu, tetapi awak kelihatan baik
Dialog: 0,0:13:36.64,0:13:38.51,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:13:39.26,0:13:42.98,teks umum,,0,0,0,,Saya seorang pembantu rumah di sini, saya bekerja, sudah tentu
Dialog: 0,0:13:43.77,0:13:45.98,teks umum,,0,0,0,,Maiden Kim tiada di sini sekarang
Dialog: 0,0:13:46.06,0:13:47.56,teks umum,,0,0,0,,Anda boleh menunggu di dalam
Dialog: 0,0:13:48.15,0:13:49.90,teks umum,,0,0,0,,Saya datang kepada kamu, bukan kepadanya
Dialog: 0,0:13:51.90,0:13:52.94,teks umum,,0,0,0,,Kepada saya?
Dialog: 0,0:13:53.65,0:13:56.32,teks umum,,0,0,0,,Kenapa awak perlu jumpa saya?
Dialog: 0,0:13:57.16,0:13:58.20,teks umum,,0,0,0,,Nah...
Dialog: 0,0:13:58.83,0:14:00.04,teks umum,,0,0,0,,Payung
Dialog: 0,0:14:00.95,0:14:04.71,teks umum,,0,0,0,,Saya datang untuk mengambil payung yang anda masih ada
Dialog: 0,0:14:06.08,0:14:07.46,teks umum,,0,0,0,,Payung?
Dialog: 0,0:14:07.54,0:14:10.34,teks am,,0,0,0,,Koyak kena angin, saya buang
Dialog: 0,0:14:11.76,0:14:12.71,teks umum,,0,0,0,,Begitukah?
Dialog: 0,0:14:15.05,0:14:16.01,teks umum,,0,0,0,,Kalau begitu mari kita pergi
Dialog: 0,0:14:16.72,0:14:17.55,teks umum,,0,0,0,,Apa?
Dialog: 0,0:14:17.64,0:14:19.22,teks umum,,0,0,0,,Untuk baharu
Dialog: 0,0:14:19.30,0:14:21.93,teks umum,,0,0,0,,Beli saya payung baharu
Dialog: 0,0:14:24.56,0:14:27.35,prasasti,,0,0,0,,Payung
Dialog: 0,0:14:30.61,0:14:33.44,teks umum,,0,0,0,,Yang ini betul-betul sama dengan anda
Dialog: 0,0:14:33.53,0:14:34.90,teks umum,,0,0,0,,Murah...
Dialog: 0,0:14:36.78,0:14:39.12,teks umum,,0,0,0,,Payung untuk satu kali dan kertas murah
Dialog: 0,0:14:39.20,0:14:41.37,teks am,,0,0,0,,Lombong diperbuat daripada kulit biri-biri dan buluh yang mahal
Dialog: 0,0:14:42.95,0:14:44.37,teks umum,,0,0,0,,Sayang?
Dialog: 0,0:14:45.08,0:14:47.37,teks umum,,0,0,0,,Kenapa awak beri payung mahal kepada pembantu rumah?
Dialog: 0,0:14:47.46,0:14:49.38,teks umum,,0,0,0,,saya pinjamkan kepada awak
Dialog: 0,0:14:49.46,0:14:51.63,teks umum,,0,0,0,,Kini tiba masanya untuk mengembalikannya kepada saya
Dialog: 0,0:14:54.34,0:14:56.59,teks umum,,0,0,0,,Ini adalah satu-satunya payung saya
Dialog: 0,0:14:56.67,0:14:59.80,teks umum,,0,0,0,,Mengapa anda hanya mempunyai satu payung?
Dialog: 0,0:14:59.89,0:15:02.01,teks umum,,0,0,0,,Saya jarang berjalan dalam hujan
Dialog: 0,0:15:03.22,0:15:07.14,teks umum,,0,0,0,,Saya patah kaki semasa kecil,\Nit masih sakit apabila hujan
Dialog: 0,0:15:08.31,0:15:11.44,teks umum,,0,0,0,,Adakah kaki anda yang sakit masih sakit?
Dialog: 0,0:15:15.69,0:15:18.61,teks umum,,0,0,0,,En. Park memberitahu saya bagaimana anda memecahkannya
Dialog: 0,0:15:20.03,0:15:21.87,teks umum,,0,0,0,,Dalam Danhyangk
Dialog: 0,0:15:21.95,0:15:25.58,teks umum,,0,0,0,,Sayang sekali anda seorang ahli silap mata yang lemah kaki
Dialog: 0,0:15:26.37,0:15:28.79,teks umum,,0,0,0,,Mungkin sembuh dengan teruk
Dialog: 0,0:15:31.21,0:15:32.50,teks umum,,0,0,0,,Ada seorang kawan,
Dialog: 0,0:15:33.38,0:15:35.67,teks umum,,0,0,0,,yang menunggu saya di Danhyangk
Dialog: 0,0:15:38.26,0:15:40.47,teks umum,,0,0,0,,Dia menyelamatkan saya dan menambal luka
Dialog: 0,0:15:41.72,0:15:43.97,teks umum,,0,0,0,,Mungkin kaki tidak sembuh kerana
Dialog: 0,0:15:45.52,0:15:47.10,teks umum,,0,0,0,,bahawa saya tidak berterima kasih kepadanya
Dialog: 0,0:16:00.61,0:16:02.62,teks umum,,0,0,0,,- Saya suka yang ini\N- Apa?
Dialog: 0,0:16:02.70,0:16:04.78,teks umum,,0,0,0,,Saya akan ambil yang ini. Bayar
Dialog: 0,0:16:06.91,0:16:08.16,teks umum,,0,0,0,,Ya
Dialog: 0,0:16:12.96,0:16:14.50,teks umum,,0,0,0,,- Kita ambil yang ini\N- Okay
Dialog: 0,0:16:14.59,0:16:17.05,teks umum,,0,0,0,,Tulis atas nama tuan Chang Gan
Dialog: 0,0:16:17.63,0:16:20.51,teks umum,,0,0,0,,Kenapa dengan namanya? Anda sepatutnya membayar
Dialog: 0,0:16:21.13,0:16:23.55,teks am,,0,0,0,,Dari mana pembantu rumah dapat duit?
Dialog: 0,0:16:23.64,0:16:24.89,teks umum,,0,0,0,,Anda ada
Dialog: 0,0:16:25.39,0:16:27.02,teks umum,,0,0,0,,Saya nampak. Adakah anda pergi
Dialog: 0,0:16:27.10,0:16:29.39,teks umum,,0,0,0,,beli pakaian dengan wang yang disimpan
Dialog: 0,0:16:29.48,0:16:30.85,teks umum,,0,0,0,,Ini kerana...
Dialog: 0,0:16:35.73,0:16:38.57,teks umum,,0,0,0,,- Berapa banyak yang saya kenakan?\N- Anda mempunyai citarasa yang baik
Dialog: 0,0:16:38.65,0:16:41.11,teks umum,,0,0,0,,Ini adalah payung kami yang paling mahal
Dialog: 0,0:16:46.45,0:16:47.54,teks umum,,0,0,0,,Nah...
Dialog: 0,0:16:53.04,0:16:54.25,italic,,0,0,0,,Moo Doc tiada?
Dialog: 0,0:16:55.42,0:16:58.30,teks umum,,0,0,0,,Kenapa dia pergi sekarang?
Dialog: 0,0:16:58.38,0:17:00.88,teks am,,0,0,0,,Tuan, adakah anda telah ditendang keluar lagi?
Dialog: 0,0:17:01.47,0:17:03.97,teks umum,,0,0,0,,No. Saya datang sekejap
Dialog: 0,0:17:04.05,0:17:05.89,teks umum,,0,0,0,,Kembali segera
Dialog: 0,0:17:05.97,0:17:06.80,teks umum,,0,0,0,,Faham
Dialog: 0,0:17:06.89,0:17:08.72,teks umum,,0,0,0,,Moo Dok akan kembali tidak lama lagi
Dialog: 0,0:17:09.31,0:17:11.77,teks umum,,0,0,0,,Adakah anda mahu berenang dahulu?
Dialog: 0,0:17:12.48,0:17:13.39,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,0:17:13.48,0:17:15.90,teks umum,,0,0,0,,Sudah lama saya tidak menyimbah air di rumah
Dialog: 0,0:17:15.98,0:17:18.15,teks umum,,0,0,0,,- Saya akan sediakan semuanya\N- Okay
Dialog: 0,0:17:34.08,0:17:35.38,teks umum,,0,0,0,,Mereka...
Dialog: 0,0:17:36.58,0:17:38.80,teks umum,,0,0,0,,Adakah biskut madu ini sentiasa manis?
Dialog: 0,0:17:41.01,0:17:43.38,teks umum,,0,0,0,,Mengapa tiada perkara sedemikian dalam Sosnovy Bor?
Dialog: 0,0:17:43.97,0:17:46.09,teks umum,,0,0,0,,Kepala juga mempunyai gigi manis
Dialog: 0,0:18:03.28,0:18:07.20,teks umum,,0,0,0,,Adakah kita berpisah hari ini?
Dialog: 0,0:18:08.12,0:18:09.53,teks umum,,0,0,0,,Ya
Dialog: 0,0:18:10.12,0:18:13.16,teks umum,,0,0,0,,Tiga adik perempuan yang cerewet itu akan menamatkan pelajaran florikultur mereka tidak lama lagi
Dialog: 0,0:18:13.25,0:18:14.46,teks umum,,0,0,0,,dan mereka akan melewati kita
Dialog: 0,0:18:15.04,0:18:17.33,teks umum,,0,0,0,,Jika kita bertengkar di hadapan mereka,
Dialog: 0,0:18:17.42,0:18:20.04,teks umum,,0,0,0,,mereka akan mulakan khabar angin bahawa kami putus cinta
Dialog: 0,0:18:25.93,0:18:27.51,teks umum,,0,0,0,,Seperti yang dijanjikan,
Dialog: 0,0:18:27.59,0:18:30.01,teks umum,,0,0,0,,Saya akan menjadi sebab perpisahan kita
Dialog: 0,0:18:30.64,0:18:33.06,teks umum,,0,0,0,,Pukul muka saya dahulu
Dialog: 0,0:18:33.14,0:18:35.94,teks umum,,0,0,0,,Kemudian tolak apabila saya cuba menangkap awak dan pergi
Dialog: 0,0:18:36.52,0:18:38.56,teks umum,,0,0,0,,Ini sedikit...
Dialog: 0,0:18:38.65,0:18:40.36,teks umum,,0,0,0,,Beginilah sepatutnya
Dialog: 0,0:18:40.44,0:18:43.44,teks umum,,0,0,0,,mereka percaya kami bergaduh dan memutuskan pertunangan
Dialog: 0,0:18:43.53,0:18:47.03,teks umum,,0,0,0,,Kemudian orang akan berkata buruk tentang anda
Dialog: 0,0:18:47.11,0:18:50.62,teks umum,,0,0,0,,Dan dengan reputasi yang buruk, sukar untuk mencari pengantin yang sesuai
Dialog: 0,0:18:53.54,0:18:54.70,teks umum,,0,0,0,,Saya...
Dialog: 0,0:18:55.41,0:18:57.46,teks umum,,0,0,0,,Saya tidak mahu mereka mencari pasangan untuk saya
Dialog: 0,0:19:01.09,0:19:02.75,teks umum,,0,0,0,,Saya akan mengahwini si dia,
Dialog: 0,0:19:03.88,0:19:05.09,teks umum,,0,0,0,,apa yang saya suka
Dialog: 0,0:19:13.85,0:19:15.18,teks umum,,0,0,0,,saya tetap tidak akan memukul awak
Dialog: 0,0:19:16.56,0:19:19.15,teks umum,,0,0,0,,Lebih baik dengan kesakitan ini
Dialog: 0,0:19:19.73,0:19:22.65,teks umum,,0,0,0,,Ya. Boleh jadi macam tu
Dialog: 0,0:19:26.11,0:19:27.61,teks umum,,0,0,0,,Teh terlalu panas
Dialog: 0,0:19:28.78,0:19:30.91,teks umum,,0,0,0,,Muka saya akan terbakar
Dialog: 0,0:19:36.25,0:19:37.71,teks umum,,0,0,0,,Ayuh
Dialog: 0,0:19:38.54,0:19:39.79,teks umum,,0,0,0,,Tiada apa-apa
Dialog: 0,0:19:41.88,0:19:45.30,teks umum,,0,0,0,,Persembahan ajaib akan datang tidak lama lagi
Dialog: 0,0:19:47.01,0:19:48.76,teks umum,,0,0,0,,Saya sangat ingin menonton
Dialog: 0,0:19:49.47,0:19:52.35,teks umum,,0,0,0,,Tetapi saya tidak boleh jika kita berpisah hari ini
Dialog: 0,0:19:52.97,0:19:55.22,teks umum,,0,0,0,,Tetapi... dan... kenapa?
Dialog: 0,0:19:55.31,0:19:59.14,teks umum,,0,0,0,,Saya masih di rumah, dan ini hampir sebulan,
Dialog: 0,0:20:00.06,0:20:02.40,teks umum,,0,0,0,,selepas pembubaran pertunangan
Dialog: 0,0:20:03.77,0:20:06.19,teks umum,,0,0,0,,Faham
Dialog: 0,0:20:09.99,0:20:14.16,teks umum,,0,0,0,,Kalau begitu mari kita tangguhkan perpisahan selama beberapa hari?
Dialog: 0,0:20:14.24,0:20:15.08,teks umum,,0,0,0,,Ya?
Dialog: 0,0:20:18.16,0:20:21.29,teks umum,,0,0,0,,Tetapi ketiga-tiga gosip itu akan ada juga
Dialog: 0,0:20:22.13,0:20:25.55,teks umum,,0,0,0,,Saya rasa tidak berbaloi pergi ke sana seorang diri
Dialog: 0,0:20:26.55,0:20:30.22,teks umum,,0,0,0,,Oleh kerana mereka sudah menganggap bahawa kami adalah pasangan, saya akan pergi bersama anda
Dialog: 0,0:20:32.51,0:20:34.80,teks umum,,0,0,0,,Nah, saya rasa kita boleh...
Dialog: 0,0:20:39.81,0:20:42.56,teks umum,,0,0,0,,Saya mahu labu dan gula-gula nasi,
Dialog: 0,0:20:42.65,0:20:44.69,teks umum,,0,0,0,,dan juga biskut madu
Dialog: 0,0:20:44.77,0:20:45.94,teks umum,,0,0,0,,Sudah tentu
Dialog: 0,0:20:47.57,0:20:49.65,teks umum,,0,0,0,,Tuan saya seperti kanak-kanak
Dialog: 0,0:20:49.74,0:20:51.86,teks umum,,0,0,0,,Dia nakal apabila tiada apa-apa untuk dimakan
Dialog: 0,0:20:52.78,0:20:53.99,teks umum,,0,0,0,,Beritahu dia
Dialog: 0,0:20:56.99,0:20:59.29,teks umum,,0,0,0,,Saya suka ini daripada debunga pain
Dialog: 0,0:20:59.37,0:21:02.00,teks umum,,0,0,0,,Saya fikir pilihan anda mahal
Dialog: 0,0:21:02.08,0:21:04.46,teks umum,,0,0,0,,- Berikan mereka?\N- Tidak
Dialog: 0,0:21:15.76,0:21:17.93, inskripsi,,0,0,0,,Kami sedang mengupah pelayan di Sosnovy Bor
Dialog: 0,0:21:19.93,0:21:21.35, inskripsi,,0,0,0,,Kami mengupah pekerja di Sosnovy Bor
Dialog: 0,0:21:21.43,0:21:24.40, inskripsi,,0,0,0,,Keperluan: sihat, celik huruf, tidak disabitkan kesalahan
Dialog: 0,0:21:26.86,0:21:28.94,teks umum,,0,0,0,,Saya menulisnya kepada keluarga Chan
Dialog: 0,0:21:35.41,0:21:37.07,teks umum,,0,0,0,,Beritahu ini kepada pemilik
Dialog: 0,0:21:38.20,0:21:41.79,teks umum,,0,0,0,,Saya masih ada kerja lagi. saya akan pergi
Dialog: 0,0:21:58.89,0:21:59.93,teks umum,,0,0,0,,Di sini
Dialog: 0,0:22:00.01,0:22:01.43,teks umum,,0,0,0,,- Lihat sekeliling\N- Ya
Dialog: 0,0:22:02.23,0:22:03.35,teks umum,,0,0,0,,- Maaf\N- Ya?
Dialog: 0,0:22:03.43,0:22:04.60,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,0:22:09.82,0:22:11.86,teks umum,,0,0,0,,Itukah dia?
Dialog: 0,0:22:11.94,0:22:13.11,teks umum,,0,0,0,,Dia
Dialog: 0,0:22:14.90,0:22:16.11,teks umum,,0,0,0,,Hei
Dialog: 0,0:22:16.20,0:22:18.37,teks umum,,0,0,0,,- Awak curi duit saya\N- Kembalikan cincin saya
Dialog: 0,0:22:23.33,0:22:24.87,teks umum,,0,0,0,,- Mak...\N- Di mana dia?
Dialog: 0,0:22:24.96,0:22:27.42,teks umum,,0,0,0,,- Hei, berhenti!\N- Hei!
Dialog: 0,0:22:27.50,0:22:28.67,teks umum,,0,0,0,,Berhenti!
Dialog: 0,0:22:28.75,0:22:31.05,teks umum,,0,0,0,,- Hentikan\N- Penipu!
Dialog: 0,0:22:31.13,0:22:33.51,teks umum,,0,0,0,,- Pencuri!\N- Kembalilah!
Dialog: 0,0:22:33.59,0:22:36.88,teks umum,,0,0,0,,Saya akan tangkap awak, awak akan faham!
Dialog: 0,0:22:37.47,0:22:39.51,teks umum,,0,0,0,,- Berhenti!\N- Tunggu!
Dialog: 0,0:22:41.76,0:22:43.43,teks umum,,0,0,0,,- Cepat!\N- Awak tengah buat apa?
Dialog: 0,0:22:43.52,0:22:44.64,teks umum,,0,0,0,,Kecil...
Dialog: 0,0:22:44.73,0:22:46.35,teks umum,,0,0,0,,Tangkap dia!
Dialog: 0,0:22:46.44,0:22:48.56,teks umum,,0,0,0,,- Dia melarikan diri!\N- Betul
Dialog: 0,0:22:48.65,0:22:50.48,teks umum,,0,0,0,,- Adakah itu dia?\N- Ya
Dialog: 0,0:22:57.82,0:22:59.32,teks umum,,0,0,0,,Ini Mu Dok
Dialog: 0,0:22:59.41,0:23:00.24,teks umum,,0,0,0,,Moo Dok!
Dialog: 0,0:23:05.75,0:23:07.33,teks umum,,0,0,0,,Di sini anda...
Dialog: 0,0:23:07.42,0:23:09.08,teks umum,,0,0,0,,- Ayuh...\N- Tangkap dia!
Dialog: 0,0:23:09.17,0:23:12.21,teks umum,,0,0,0,,Kemari! Saya akan menguruskan ini untuk anda!
Dialog: 0,0:23:12.30,0:23:13.55,teks umum,,0,0,0,,Hei!
Dialog: 0,0:23:13.63,0:23:14.80,contact,,0,0,0,,Oh awak...
Dialog: 0,0:23:27.06,0:23:28.60,teks umum,,0,0,0,,Itu pasti dia
Dialog: 0,0:23:30.40,0:23:32.23,teks umum,,0,0,0,,Tetapi kenapa dia nampak sekarang?
Dialog: 0,0:23:46.04,0:23:48.21,teks umum,,0,0,0,,Dia selalu menutup matanya dengan ini
Dialog: 0,0:23:50.33,0:23:51.96,teks umum,,0,0,0,,Bukankah itu dia?
Dialog: 0,0:24:11.77,0:24:13.52,teks umum,,0,0,0,,Kami bertemu semula,
Dialog: 0,0:24:14.36,0:24:15.48,teks umum,,0,0,0,,Jadi saya
Dialog: 0,0:24:16.07,0:24:19.07,teks umum,,0,0,0,,Saya datang dari kampung Sari kerana saya dengar awak ada di sini
Dialog: 0,0:24:19.15,0:24:20.78,teks umum,,0,0,0,,Memanjat jauh
Dialog: 0,0:24:21.41,0:24:23.62,teks umum,,0,0,0,,Saya fikir awak akan bersembunyi di ibu negara?
Dialog: 0,0:24:25.41,0:24:26.33,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:24:27.70,0:24:31.29,teks umum,,0,0,0,, Berpura-pura buta?
Dialog: 0,0:24:33.58,0:24:36.00,teks umum,,0,0,0,,Berpura-pura menjadi orang miskin,
Dialog: 0,0:24:36.09,0:24:39.51,teks umum,,0,0,0,,dan kemudian dia mencuri secara diam-diam
Dialog: 0,0:24:41.97,0:24:43.18,teks umum,,0,0,0,,Apa khabar
Dialog: 0,0:24:44.64,0:24:46.43,teks umum,,0,0,0,,berani merompak saya?
Dialog: 0,0:24:48.52,0:24:50.23,teks umum,,0,0,0,,Saya tidak tahu siapa...
Dialog: 0,0:24:51.98,0:24:53.90,teks umum,,0,0,0,,Anda...
Dialog: 0,0:24:54.69,0:24:58.03,teks umum,,0,0,0,,Sekali lagi awak cuba menipu saya
Dialog: 0,0:24:58.65,0:24:59.53,teks umum,,0,0,0,,Tangkap dia
Dialog: 0,0:25:04.07,0:25:05.28,teks umum,,0,0,0,,Bantuan!
Dialog: 0,0:25:05.37,0:25:07.03,teks umum,,0,0,0,,Tolong bantu!
Dialog: 0,0:25:09.37,0:25:11.62,teks umum,,0,0,0,,Saya buta!
Dialog: 0,0:25:11.71,0:25:14.08,teks umum,,0,0,0,,Saya tidak mengenali mereka,
Dialog: 0,0:25:14.17,0:25:16.54,teks umum,,0,0,0,,mereka cuba menculik saya
Dialog: 0,0:25:17.25,0:25:20.88,teks umum,,0,0,0,,Tolong bantu saya!
Dialog: 0,0:25:20.97,0:25:23.55,teks umum,,0,0,0,,Dia berusaha keras, lihat
Dialog: 0,0:25:26.47,0:25:27.43,condong,,0,0,0,,Simpan!
Dialog: 0,0:25:27.51,0:25:28.76,teks umum,,0,0,0,,Apa yang kamu tatap?
Dialog: 0,0:25:28.85,0:25:31.27,teks umum,,0,0,0,,- Kemari\N- Lepaskan!
Dialog: 0,0:25:41.94,0:25:44.49,teks umum,,0,0,0,,Tidak boleh diseret bersama bertentangan dengan kehendak anda
Dialog: 0,0:25:45.61,0:25:48.28,teks umum,,0,0,0,,Saya ada sebab untuk ini,
Dialog: 0,0:25:48.37,0:25:49.83,teks umum,,0,0,0,,so out of the way
Dialog: 0,0:25:50.54,0:25:52.37,teks umum,,0,0,0,,Saya buta,
Dialog: 0,0:25:52.46,0:25:54.42,teks umum,,0,0,0,,- dan saya tidak mengenali mereka\N{\i1}- Apa khabar...
Dialog: 0,0:25:57.04,0:25:58.29,teks umum,,0,0,0,,Tangkap dia!
Dialog: 0,0:26:10.35,0:26:12.10,teks umum,,0,0,0,,Dia seorang ahli silap mata
Dialog: 0,0:26:12.18,0:26:13.31,teks umum,,0,0,0,,Jalankan
Dialog: 0,0:26:21.61,0:26:22.99,teks umum,,0,0,0,,Bolehkah anda berdiri?
Dialog: 0,0:26:28.24,0:26:29.78,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:26:29.87,0:26:31.62,teks umum,,0,0,0,,Ia kelihatan berbahaya
Dialog: 0,0:26:31.70,0:26:33.91,teks umum,,0,0,0,,Minta bantuan pengawal
Dialog: 0,0:26:34.66,0:26:35.71,teks umum,,0,0,0,,Saya akan membawa anda kepada mereka
Dialog: 0,0:26:35.79,0:26:38.58,teks umum,,0,0,0,,Tidak perlu. Semuanya baik-baik saja
Dialog: 0,0:26:40.29,0:26:41.75,teks umum,,0,0,0,,Tongkat awak patah
Dialog: 0,0:26:48.39,0:26:49.35,teks umum,,0,0,0,,Ini adalah payung
Dialog: 0,0:26:50.39,0:26:51.68,teks umum,,0,0,0,,Anda boleh ambil
Dialog: 0,0:27:08.61,0:27:11.20,teks umum,,0,0,0,,Tuan, lebih baik tinggalkan dia
Dialog: 0,0:27:11.28,0:27:13.83,teks umum,,0,0,0,,Dan dia tidak mahu pergi ke pengawal
Dialog: 0,0:27:13.91,0:27:16.21,teks umum,,0,0,0,,Saya tidak tahu apa-apa tentang masa lalunya,
Dialog: 0,0:27:16.29,0:27:18.04,teks umum,,0,0,0,,tetapi ini adalah penyamun
Dialog: 0,0:27:18.71,0:27:22.88,teks umum,,0,0,0,,Lebih baik jangan campur tangan dalam perniagaan mereka, anda akan selamat
Dialog: 0,0:27:32.47,0:27:33.64,kenangan miring,,0,0,0,,Saya akan membawa anda kepada mereka
Dialog: 0,0:27:34.52,0:27:36.93,kenangan miring,,0,0,0,,Minta bantuan pengawal
Dialog: 0,0:27:41.19,0:27:43.07,teks umum,,0,0,0,,Mungkin saya sepatutnya bersetuju
Dialog: 0,0:28:04.13,0:28:06.71,teks umum,,0,0,0,,Nombor 125
Dialog: 0,0:28:08.22,0:28:10.72,teks umum,,0,0,0,,Begitu ramai orang telah mendaftar di sana?
Dialog: 0,0:28:10.80,0:28:12.14, inskripsi,,0,0,0,,Seratus dua puluh lima
Dialog: 0,0:28:13.22,0:28:15.06,teks umum,,0,0,0,,Dan mereka hanya akan mengambil lima
Dialog: 0,0:28:16.27,0:28:18.35,teks umum,,0,0,0,,Adakah harapan?
Dialog: 0,0:28:18.93,0:28:20.06,miring,,0,0,0,,Hei, Moo Deok
Dialog: 0,0:28:21.69,0:28:22.90,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:28:22.98,0:28:24.44,teks umum,,0,0,0,, Lelaki itu sedang mencari awak
Dialog: 0,0:28:24.52,0:28:26.98,teks umum,,0,0,0,,Adakah Encik Yul datang lagi?
Dialog: 0,0:28:27.07,0:28:29.15,teks umum,,0,0,0,,Bukan dia, Encik Chan
Dialog: 0,0:28:29.90,0:28:32.82,teks umum,,0,0,0,,Dia melarikan diri dan pulang ke rumah
Dialog: 0,0:28:42.08,0:28:45.63,teks umum,,0,0,0,,Saya perlu kembali sebelum matahari terbenam. Di mana dia memakainya?
Dialog: 0,0:29:28.30,0:29:29.42,teks umum,,0,0,0,,Di manakah tuannya?
Dialog: 0,0:29:29.51,0:29:31.67,teks umum,,0,0,0,,Dia baru sahaja pergi, tetapi saya juga tidak melihatnya
Dialog: 0,0:29:34.22,0:29:36.26,teks umum,,0,0,0,,Dia kata dia akan ikut peraturan, kenapa dia lari?
Dialog: 0,0:29:38.14,0:29:39.93,teks umum,,0,0,0,,Saya harap dia tidak ditangkap
Dialog: 0,0:29:42.94,0:29:44.35,teks umum,,0,0,0,,Baru pergi
Dialog: 0,0:29:44.94,0:29:45.94,teks umum,,0,0,0,,Tadi
Dialog: 0,0:29:47.86,0:29:49.65,teks umum,,0,0,0,,Ada apa dengan dia?
Dialog: 0,0:30:14.13,0:30:15.30,teks umum,,0,0,0,,Chan Uk...
Dialog: 0,0:30:15.88,0:30:16.80,teks umum,,0,0,0,,Tuan!
Dialog: 0,0:30:21.56,0:30:24.31,teks umum,,0,0,0,,Di manakah anda? Saya fikir kita tidak akan berjumpa antara satu sama lain
Dialog: 0,0:30:53.38,0:30:55.76,teks umum,,0,0,0,,Tetapi kami berjumpa. Saya gembira
Dialog: 0,0:30:58.34,0:31:00.80,teks umum,,0,0,0,,Saya perlu pergi. Jika mereka tahu saya pergi, saya akan kacau
Dialog: 0,0:31:01.72,0:31:04.35,teks umum,,0,0,0,,Tunggu saya. Saya akan ke sana tidak lama lagi
Dialog: 0,0:31:06.02,0:31:10.23,teks umum,,0,0,0,,Saya jumpa jalan, jadi buat apa yang perlu
Dialog: 0,0:31:10.31,0:31:12.02,teks umum,,0,0,0,,Dan saya akan melakukan apa yang saya mesti
Dialog: 0,0:31:13.44,0:31:16.07,teks umum,,0,0,0,,Okay. Apakah jenis kaedah?
Dialog: 0,0:31:17.45,0:31:19.37,teks umum,,0,0,0,,Mereka sedang merekrut orang
Dialog: 0,0:31:40.05,0:31:41.26,teks umum,,0,0,0,,Jangan ditangkap. Selamat melancong
Dialog: 0,0:32:07.29,0:32:10.50,teks umum,,0,0,0,,Yang Mulia, kenapa pergi sendiri ke Sejukwon?
Dialog: 0,0:32:10.58,0:32:12.58,teks umum,,0,0,0,,Anda sepatutnya memanggil Master Ho ke tempat anda
Dialog: 0,0:32:14.09,0:32:17.38,teks umum,,0,0,0,,Hentikan. Ia memberi saya alasan untuk keluar dan mengambil udara.
Dialog: 0,0:32:17.46,0:32:18.97,teks umum,,0,0,0,,Saya suka berjalan
Dialog: 0,0:32:24.97,0:32:26.06,teks umum,,0,0,0,,Ini Chan Wook
Dialog: 0,0:32:36.23,0:32:37.86,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:32:37.94,0:32:40.03,teks umum,,0,0,0,,Saya dengar awak tidak dibenarkan keluar dari dewan latihan
Dialog: 0,0:32:40.11,0:32:41.82,teks umum,,0,0,0,,sehingga anda membaca "Kata Hati"
Dialog: 0,0:32:41.91,0:32:44.32,teks umum,,0,0,0,,Mula-mula mereka datang ke Chwisonru untuk saya,
Dialog: 0,0:32:44.41,0:32:46.08,teks umum,,0,0,0,,sekarang ikut saya
Dialog: 0,0:32:46.79,0:32:49.96,teks umum,,0,0,0,,Dari mana datangnya minat terhadap saya ini? Ia menakutkan
Dialog: 0,0:32:50.04,0:32:52.04,teks umum,,0,0,0,,Cikgu Ho memberitahu saya
Dialog: 0,0:32:53.00,0:32:56.63,teks umum,,0,0,0,,Saya dengar awak tidak dapat berdiri selepas minuman yang saya berikan kepada awak
Dialog: 0,0:32:56.71,0:32:59.01,teks umum,,0,0,0,,Kenapa awak datang ke Sejukwon?
Dialog: 0,0:32:59.72,0:33:04.22,teks umum,,0,0,0,,Adakah luka akibat pukulan saya masih menyakitkan?
Dialog: 0,0:33:04.30,0:33:05.39,teks umum,,0,0,0,,Teruk...
Dialog: 0,0:33:05.47,0:33:08.56,teks umum,,0,0,0,,Mereka tidak menyakitkan. saya sihat
Dialog: 0,0:33:08.64,0:33:11.10,teks umum,,0,0,0,,Saya datang untuk mengambil beberapa ubat yang berguna
Dialog: 0,0:33:11.89,0:33:15.36,teks umum,,0,0,0,,Saya harap anda mengambil banyak perkara. Anda harus menjalani kehidupan yang panjang dan sihat
Dialog: 0,0:33:17.40,0:33:20.11,teks umum,,0,0,0,,Apa yang kamu sembunyikan?
Dialog: 0,0:33:21.20,0:33:22.20,teks umum,,0,0,0,,Tunjukkan
Dialog: 0,0:33:39.84,0:33:40.88,teks umum,,0,0,0,,Kuki madu
Dialog: 0,0:33:41.47,0:33:44.13,teks umum,,0,0,0,,Saya mahu makan sendiri. Bagaimana awak tahu?
Dialog: 0,0:33:44.72,0:33:45.84,teks umum,,0,0,0,,Ambil
Dialog: 0,0:33:52.18,0:33:55.27,teks umum,,0,0,0,,Tiada gula-gula seperti itu dalam Sosnovy Bor
Dialog: 0,0:33:56.73,0:33:57.86,teks umum,,0,0,0,,Adakah anda pulang ke rumah?
Dialog: 0,0:34:04.78,0:34:07.91,teks umum,,0,0,0,,Anda akan menghadapi masalah jika mereka mengetahui bahawa anda melarikan diri
Dialog: 0,0:34:08.53,0:34:11.79,teks umum,,0,0,0,,Anda membawa saya minum, anda memberi saya pujian
Dialog: 0,0:34:11.87,0:34:14.83,teks umum,,0,0,0,,Adakah anda benar-benar akan memberitahu saya tentang kesalahan kecil saya?
Dialog: 0,0:34:18.46,0:34:20.88,teks umum,,0,0,0,,Saya... memberi awak biskut madu
Dialog: 0,0:34:26.22,0:34:30.60,teks umum,,0,0,0,,Pergi di sekeliling pokok pain besar itu. Terdapat ramai ahli silap mata di sana
Dialog: 0,0:34:33.56,0:34:35.69,teks umum,,0,0,0,,Terima kasih, Yang Amat Mulia. selamat tinggal
Dialog: 0,0:34:39.98,0:34:42.07,teks umum,,0,0,0,,Saya tidak faham kenapa saya begitu baik dengannya
Dialog: 0,0:34:46.57,0:34:48.12,teks umum,,0,0,0,,Sedap
Dialog: 0,0:34:48.91,0:34:50.08,teks umum,,0,0,0,,Ya?
Dialog: 0,0:34:54.08,0:34:55.87,teks umum,,0,0,0,,- Sedapkah Tuanku?\N- Ya
Dialog: 0,0:34:56.46,0:34:58.42,teks umum,,0,0,0,,Saya fikir Putera Mahkota
Dialog: 0,0:34:59.29,0:35:02.00,teks umum,,0,0,0,,akan memusuhi ahli silap mata
Dialog: 0,0:35:03.17,0:35:05.09,teks umum,,0,0,0,,Dan dia menyarung pedang
Dialog: 0,0:35:05.76,0:35:07.93,teks umum,,0,0,0,,dan menjadi lebih dekat dengan mereka
Dialog: 0,0:35:08.55,0:35:11.81,teks umum,,0,0,0,,Mungkin dia memutuskan untuk menjadikan mereka kawannya untuk menggunakan,
Dialog: 0,0:35:11.89,0:35:13.52,teks umum,,0,0,0,,bila dia akan menjadi raja seterusnya
Dialog: 0,0:35:15.23,0:35:18.60,teks umum,,0,0,0,,Adakah anda pasti anda tidak perlu melakukan apa-apa?
Dialog: 0,0:35:18.69,0:35:19.94,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:35:20.02,0:35:21.98,teks umum,,0,0,0,,Tidak sukar untuk mengubah pendapatnya
Dialog: 0,0:35:22.61,0:35:24.94,teks umum,,0,0,0,,Kami mempunyai tanda dengan buruj Chang Wook
Dialog: 0,0:35:26.74,0:35:30.20,teks umum,,0,0,0,,Putera Mahkota tidak akan mempunyai pilihan selain membunuhnya
Dialog: 0,0:35:41.17,0:35:45.76,teks umum,,0,0,0,,Adakah kita menggunakan ini untuk menundukkan Jin Ho Kyung?
Dialog: 0,0:35:45.84,0:35:49.18,teks umum,,0,0,0,,Jinyeowon akan menjadi milik kita tidak lama lagi
Dialog: 0,0:36:09.82,0:36:12.41,teks umum,,0,0,0,,Empat jam telah berlalu sejak wanita itu masuk
Dialog: 0,0:36:15.12,0:36:16.37,teks umum,,0,0,0,,Jangan campur
Dialog: 0,0:36:16.45,0:36:17.79,teks umum,,0,0,0,,Nampaknya banyak yang perlu dibincangkan
Dialog: 0,0:36:21.50,0:36:24.29,teks umum,,0,0,0,,Hei, tunggu!
Dialog: 0,0:36:25.30,0:36:27.55,teks umum,,0,0,0,,Saya minta awak jangan ganggu mereka!
Dialog: 0,0:36:27.63,0:36:28.80,teks umum,,0,0,0,,Sesuatu yang tidak kena
Dialog: 0,0:36:28.88,0:36:31.09,teks umum,,0,0,0,,saya kena semak sama ada Chan Wook ada atau tidak
Dialog: 0,0:36:31.18,0:36:33.39,teks umum,,0,0,0,,Adakah anda fikir wanita saya berbohong?
Dialog: 0,0:36:38.98,0:36:41.02,teks umum,,0,0,0,,Kenapa dia belum balik lagi?
Dialog: 0,0:36:42.73,0:36:46.15,teks umum,,0,0,0,,Akan pelik jika mereka mengetahui bahawa dia tiada di sini
Dialog: 0,0:36:56.28,0:36:58.16,teks umum,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:36:59.12,0:37:03.29,teks umum,,0,0,0,,Saya berkata bahawa kita akan bersama supaya anda tidak ditangkap
Dialog: 0,0:37:04.33,0:37:06.21,teks umum,,0,0,0,,Saya sedang menunggu kepulangan anda
Dialog: 0,0:37:12.76,0:37:15.76,teks umum,,0,0,0,,Nampak? Mereka bersama
Dialog: 0,0:37:17.81,0:37:19.14,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:37:19.64,0:37:22.73,teks umum,,0,0,0,,Selamat bercakap dengan awak
Dialog: 0,0:37:24.10,0:37:25.31,teks umum,,0,0,0,,Ya, saling
Dialog: 0,0:37:25.90,0:37:27.19,teks umum,,0,0,0,,Selamat tinggal
Dialog: 0,0:37:37.70,0:37:39.95,teks umum,,0,0,0,,Apakah yang anda lakukan selama empat jam ini?
Dialog: 0,0:37:41.37,0:37:42.58,teks umum,,0,0,0,,Memang
Dialog: 0,0:37:43.37,0:37:46.79,teks umum,,0,0,0,,Apa yang kami lakukan?
Dialog: 0,0:38:09.27,0:38:10.73,teks umum,,0,0,0,,Dia bosan
Dialog: 0,0:38:15.16,0:38:17.62,teks umum,,0,0,0,,Adakah anda mahu menjadi pembantu rumah di Sosnovy Bor?
Dialog: 0,0:38:18.20,0:38:20.24,teks umum,,0,0,0,,Ya. Anda tahu apa yang berlaku hari ini
Dialog: 0,0:38:20.33,0:38:24.62,teks umum,,0,0,0,,Pemilik memerlukan saya berdekatan
Dialog: 0,0:38:25.46,0:38:26.42,teks umum,,0,0,0,,Saya setuju
Dialog: 0,0:38:27.17,0:38:30.80,teks umum,,0,0,0,,Nampaknya, dia sangat tidak selesa di sana sehingga dia pulang ke rumah untuk mencuci dan makan.
Dialog: 0,0:38:31.63,0:38:34.93,teks umum,,0,0,0,,Tuan kami sangat lembut. Semua orang berlari mengelilinginya semasa dia membesar.
Dialog: 0,0:38:35.01,0:38:37.22,teks umum,,0,0,0,,Kehidupan bersama orang lain di Sosnovy Bor tidak sesuai untuknya
Dialog: 0,0:38:37.80,0:38:39.05, inskripsi,,0,0,0,,Seratus dua puluh lima
Dialog: 0,0:38:39.14,0:38:40.35,teks umum,,0,0,0,,Saya telah pun mendaftar
Dialog: 0,0:38:41.26,0:38:42.39,teks umum,,0,0,0,,Saya pasti akan sampai ke sana
Dialog: 0,0:38:43.39,0:38:45.31,teks umum,,0,0,0,,Ya, ya, tetapi ini tidak perlu
Dialog: 0,0:38:45.98,0:38:47.48,teks umum,,0,0,0,,Kami adalah hamba kepada keluarga Chan
Dialog: 0,0:38:47.56,0:38:49.02,teks umum,,0,0,0,,Kita boleh sampai ke sana dengan mudah
Dialog: 0,0:38:49.65,0:38:50.57,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:38:50.65,0:38:53.65,teks umum,,0,0,0,,Saya tidak perlu mengambil peperiksaan?
Dialog: 0,0:38:53.74,0:38:56.28,teks umum,,0,0,0,,Sudah tentu. Percayalah
Dialog: 0,0:38:59.49,0:39:00.95,teks umum,,0,0,0,,Tidak mungkin
Dialog: 0,0:39:01.62,0:39:05.46,italic,,0,0,0,,Pekhidmat di Sosnovy Bor diupah hanya melalui pemilihan terbuka
Dialog: 0,0:39:05.54,0:39:06.79,miring,,0,0,0,,Tiada pengecualian
Dialog: 0,0:39:06.87,0:39:09.04,teks umum,,0,0,0,,Saya tidak meminta untuk memberinya tempat secara percuma
Dialog: 0,0:39:09.13,0:39:11.88,teks umum,,0,0,0,,Dia hanya perlukan azimat. Tulis nama dia
Dialog: 0,0:39:11.96,0:39:13.55,teks umum,,0,0,0,,Maka dia akan dapat
Dialog: 0,0:39:13.63,0:39:15.38,teks umum,,0,0,0,,Kami akan bayar setiap bulan
Dialog: 0,0:39:18.93,0:39:20.18,teks umum,,0,0,0,,Dan...
Dialog: 0,0:39:20.85,0:39:21.89,teks umum,,0,0,0,,Di sini
Dialog: 0,0:39:23.35,0:39:26.56,teks umum,,0,0,0,,Saya fikir ia sesuai dengan awak, jadi saya bawa bersama saya, pembantu rumah Pak
Dialog: 0,0:39:57.59,0:40:01.47,teks umum,,0,0,0,,Mereka kata anda mencuba
Dialog: 0,0:40:01.55,0:40:05.43,teks am,,0,0,0,,suap pak pembantu rumah dengan ini
Dialog: 0,0:40:06.06,0:40:09.14,teks umum,,0,0,0,,- Ini hanya hadiah...\N- Anda bertanya kepadanya
Dialog: 0,0:40:10.06,0:40:12.40,teks umum,,0,0,0,,berikan Moo Deok tempat di sini
Dialog: 0,0:40:12.48,0:40:15.53,teks umum,,0,0,0,,Tuan kami sangat sensitif,
Dialog: 0,0:40:15.61,0:40:17.57,teks umum,,0,0,0,,jadi saya fikir jika Moo Deok
Dialog: 0,0:40:17.65,0:40:21.62,teks umum,,0,0,0,,lebih mudah dengan dia, lebih mudah bagi lelaki itu, jadi saya meminta bantuan
Dialog: 0,0:40:23.16,0:40:24.37,teks umum,,0,0,0,,Jadi ini benar-benar rasuah!
Dialog: 0,0:40:25.74,0:40:29.04,teks umum,,0,0,0,,Saya minta maaf. tak sangka
Dialog: 0,0:40:29.12,0:40:31.17,teks umum,,0,0,0,,Apabila Pak pembantu rumah membawa ini kepada saya,
Dialog: 0,0:40:31.25,0:40:34.09,teks umum,,0,0,0,,Saya memberitahunya bahawa anda tidak akan berbuat demikian
Dialog: 0,0:40:34.88,0:40:36.00,teks umum,,0,0,0,,Saya pasti
Dialog: 0,0:40:36.09,0:40:40.09,teks umum,,0,0,0,,Bagaimana saya boleh memandang matanya sekarang?
Dialog: 0,0:40:40.18,0:40:41.43,teks umum,,0,0,0,,Saya...
Dialog: 0,0:40:45.72,0:40:48.18,teks umum,,0,0,0,,Saya akan meminta maaf kepadanya
Dialog: 0,0:40:48.81,0:40:50.02,teks umum,,0,0,0,,Apakah yang orang akan fikirkan?
Dialog: 0,0:40:50.85,0:40:54.31,teks umum,,0,0,0,,Mereka akan fikir anda mengambil kesempatan daripada hubungan kita,
Dialog: 0,0:40:54.40,0:40:56.27,teks umum,,0,0,0,,untuk memberi seseorang rasuah
Dialog: 0,0:40:56.36,0:40:59.82,teks umum,,0,0,0,,Saya memberi dia selendang, tetapi saya tidak menyebut anda
Dialog: 0,0:40:59.90,0:41:01.07,teks umum,,0,0,0,,Walaupun begitu,
Dialog: 0,0:41:01.15,0:41:03.78,teks umum,,0,0,0,,semua orang di Sosnovy Bor tahu bahawa kami rapat
Dialog: 0,0:41:03.87,0:41:07.54,teks umum,,0,0,0,,Jika anda melakukan ini, saya tidak akan dapat lagi...
Dialog: 0,0:41:10.91,0:41:14.96,teks umum,,0,0,0,,kekalkan hubungan rapat kita
Dialog: 0,0:41:16.80,0:41:20.51,teks umum,,0,0,0,,Lalu... Saya tidak akan datang ke sini lagi
Dialog: 0,0:41:21.68,0:41:22.88,teks umum,,0,0,0,,Jadi bagaimana?
Dialog: 0,0:41:22.97,0:41:26.60,teks umum,,0,0,0,,Adakah anda dan saya begitu rapat?
Dialog: 0,0:41:27.22,0:41:29.02,teks umum,,0,0,0,,Jika begitu, anda tidak akan dapat
Dialog: 0,0:41:29.10,0:41:32.14,teks umum,,0,0,0,,sangat mudah untuk bercakap tentang memutuskan hubungan
Dialog: 0,0:41:32.23,0:41:33.56,teks umum,,0,0,0,,Okey
Dialog: 0,0:41:34.27,0:41:37.61,teks umum,,0,0,0,,- Maid Kim, saya...\N- Saya akan beritahu Maid Park,
Dialog: 0,0:41:37.69,0:41:40.11,teks am,,0,0,0,,bahawa saya, yang berani memberi rasuah,
Dialog: 0,0:41:40.19,0:41:41.61,teks umum,,0,0,0,,sama sekali
Dialog: 0,0:41:41.70,0:41:44.82,teks umum,,0,0,0,,tidak rapat dengan ketua Sosnovy Bor
Dialog: 0,0:41:44.91,0:41:46.20,teks umum,,0,0,0,,- Ini...\N- Ya
Dialog: 0,0:41:46.78,0:41:48.79,teks umum,,0,0,0,,Saya minta maaf kerana saya
Dialog: 0,0:41:48.87,0:41:50.25,teks umum,,0,0,0,,kamu hilang muka
Dialog: 0,0:41:51.12,0:41:52.62,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:41:54.37,0:41:56.29,teks umum,,0,0,0,,Anda tidak boleh pergi begitu sahaja
Dialog: 0,0:42:03.17,0:42:04.38,teks umum,,0,0,0,,Ambil ini
Dialog: 0,0:42:06.34,0:42:09.85,teks umum,,0,0,0,,Jika saya menyimpannya, ini bermakna saya menerima rasuah
Dialog: 0,0:42:26.82,0:42:28.53,teks umum,,0,0,0,,Dan...
Dialog: 0,0:42:29.78,0:42:31.79,teks umum,,0,0,0,,Saya tidak bermaksud,
Dialog: 0,0:42:33.46,0:42:36.62,teks umum,,0,0,0,, bahawa saya tidak mahu berjumpa dengan awak...
Dialog: 0,0:42:36.71,0:42:37.79,teks umum,,0,0,0,,Perkhidmatan...
Dialog: 0,0:42:37.88,0:42:39.54,teks umum,,0,0,0,,Maiden Kim!
Dialog: 0,0:42:44.88,0:42:46.09,teks umum,,0,0,0,,Betapa rumitnya segala-galanya
Dialog: 0,0:43:03.99,0:43:05.49,italic,,0,0,0,,Anda tidak akan membaca
Dialog: 0,0:43:08.24,0:43:09.37,teks umum,,0,0,0,,Cikgu Li
Dialog: 0,0:43:10.03,0:43:12.95,teks umum,,0,0,0,,Dengan penumpuan semasa anda, anda tidak akan dapat membaca
Dialog: 0,0:43:13.62,0:43:16.79,teks umum,,0,0,0,,Anda tidak pernah berlatih keras, tidak seperti yang lain
Dialog: 0,0:43:16.87,0:43:19.88,teks umum,,0,0,0,,Berapa lama masa yang diambil jika saya mula berlatih sekarang?
Dialog: 0,0:43:19.96,0:43:22.38,teks umum,,0,0,0,,Terpantas - tahun
Dialog: 0,0:43:23.42,0:43:26.63,teks umum,,0,0,0,,Tidak sesuai. Saya enggan duduk di sini selama setahun
Dialog: 0,0:43:26.72,0:43:29.84,teks umum,,0,0,0,,Saya rasa itulah sebabnya Park Jin memberi anda buku ini
Dialog: 0,0:43:34.39,0:43:35.85,teks umum,,0,0,0,,Anda akan mengurangkan masa,
Dialog: 0,0:43:36.60,0:43:40.36,teks umum,,0,0,0,,jika anda menjadi pelajar saya dan mengikuti ajaran saya
Dialog: 0,0:43:40.44,0:43:41.61,teks umum,,0,0,0,,Itulah...
Dialog: 0,0:43:42.98,0:43:44.69,teks umum,,0,0,0,,minum teh itu?
Dialog: 0,0:43:47.95,0:43:50.28,teks umum,,0,0,0,,Beri saya masa untuk berfikir
Dialog: 0,0:43:51.70,0:43:54.12,teks umum,,0,0,0,,Ini buku guru saya
Dialog: 0,0:43:54.20,0:43:58.54,teks umum,,0,0,0,,Ini adalah puisi oleh tuan Seo Kyung
Dialog: 0,0:43:58.62,0:43:59.79,teks umum,,0,0,0,,Ayat?
Dialog: 0,0:43:59.87,0:44:01.88,teks umum,,0,0,0,,Ia tidak begitu panjang
Dialog: 0,0:44:02.88,0:44:05.46,teks umum,,0,0,0,,Baca perkataan pertama,
Dialog: 0,0:44:05.55,0:44:07.51,teks umum,,0,0,0,,selebihnya akan menyusul dengan sendirinya
Dialog: 0,0:44:08.97,0:44:11.72,teks umum,,0,0,0,,Tepat sekali. Anda belum boleh membacanya
Dialog: 0,0:44:12.68,0:44:15.72,teks umum,,0,0,0,,Adakah seronok mengejek saya? Anda tidak akan memberitahu saya apa yang ada
Dialog: 0,0:44:15.81,0:44:17.10,teks umum,,0,0,0,,Seronok ditonton
Dialog: 0,0:44:19.10,0:44:21.60,teks umum,,0,0,0,,Bantu anda kali ini?
Dialog: 0,0:44:23.48,0:44:24.32,teks umum,,0,0,0,,Ya
Dialog: 0,0:44:25.23,0:44:28.61,teks umum,,0,0,0,,Saya akan memberitahu anda rahsia yang tidak diketahui
Dialog: 0,0:44:29.90,0:44:33.49,teks umum,,0,0,0,,Sebenarnya ini surat cinta
Dialog: 0,0:44:35.08,0:44:36.45,teks umum,,0,0,0,,Surat cinta?
Dialog: 0,0:44:36.54,0:44:37.58,teks umum,,0,0,0,,Ya
Dialog: 0,0:44:37.66,0:44:41.58,teks umum,,0,0,0,,Beratus-ratus ahli silap mata telah membaca buku ini, tetapi tiada siapa yang mengetahuinya
Dialog: 0,0:44:45.50,0:44:49.55,teks umum,,0,0,0,,Cikgu So Kyung menulis buku ini kepada orang yang tidak dapat melihat,
Dialog: 0,0:44:49.63,0:44:52.47,teks umum,,0,0,0,,supaya dia membacanya dengan hati
Dialog: 0,0:44:57.10,0:45:00.31,teks umum,,0,0,0,,Buku boleh dibaca dengan menumpukan tenaga
Dialog: 0,0:45:00.39,0:45:04.40,teks umum,,0,0,0,,Fikirkan bagaimana lagi ini boleh dilakukan, mengetahui bahawa ini adalah surat cinta
Dialog: 0,0:45:05.98,0:45:09.69,teks umum,,0,0,0,,Bagaimanakah surat cinta bermula?
Dialog: 0,0:45:16.95,0:45:18.12,teks umum,,0,0,0,,Apa yang ada?
Dialog: 0,0:45:21.12,0:45:22.37,teks umum,,0,0,0,,Adakah dia sesat?
Dialog: 0,0:45:22.46,0:45:26.04,teks umum,,0,0,0,,Kenapa benarkan seseorang membaca surat cinta anda?
Dialog: 0,0:45:26.54,0:45:29.26,teks umum,,0,0,0,,Mengapa saya perlu membaca ini? Saya masih tidak nampak apa-apa
Dialog: 0,0:45:30.09,0:45:31.63,teks umum,,0,0,0,,Adakah dia benar-benar sesat?
Dialog: 0,0:45:34.59,0:45:39.02,teks umum,,0,0,0,,Cikgu Li, cuaca sudah semakin sejuk. Mengapa anda perlu kembali ke Danhyangok?
Dialog: 0,0:45:39.10,0:45:42.23,teks umum,,0,0,0,,Tinggal di sini. Saya akan jaga awak
Dialog: 0,0:45:42.98,0:45:44.02,teks umum,,0,0,0,,Yom
Dialog: 0,0:45:44.10,0:45:48.82,teks umum,,0,0,0,,Pakaian hangat dan perumahan yang selesa tidak akan membantu anda berlatih
Dialog: 0,0:45:48.90,0:45:53.07,teks umum,,0,0,0,,Saya hanya mahu guru saya hidup mesra
Dialog: 0,0:45:56.66,0:45:59.54,teks umum,,0,0,0,,Adakah anda sudah dewasa?
Dialog: 0,0:46:17.60,0:46:20.14,teks umum,,0,0,0,,Ini pembantu rumah Kim dari rumah Chan
Dialog: 0,0:46:20.72,0:46:23.73,teks umum,,0,0,0,,Dia kelihatan sedih, rupa-rupanya dia bergaduh dengan Jin lagi
Dialog: 0,0:46:25.23,0:46:27.11,teks umum,,0,0,0,,Oh, tuan!
Dialog: 0,0:46:31.65,0:46:32.90,teks umum,,0,0,0,,Cikgu Li,
Dialog: 0,0:46:33.74,0:46:36.16,teks umum,,0,0,0,,kenapa awak pergi begitu tergesa-gesa waktu itu?
Dialog: 0,0:46:36.24,0:46:37.95,teks umum,,0,0,0,,Saya tidak dapat mengucapkan terima kasih
Dialog: 0,0:46:38.03,0:46:41.24,teks umum,,0,0,0,,Awak pernah jumpa sebelum ini?
Dialog: 0,0:46:41.87,0:46:44.58,teks umum,,0,0,0,,Semasa percutian di Chwisongru
Dialog: 0,0:46:45.67,0:46:47.17,teks umum,,0,0,0,,Bagaimana dengan pakaian anda?
Dialog: 0,0:46:47.25,0:46:49.46,teks umum,,0,0,0,,Dia putus cinta
Dialog: 0,0:46:50.75,0:46:51.96,teks umum,,0,0,0,,Semuanya baik-baik saja
Dialog: 0,0:46:52.46,0:46:53.72,teks umum,,0,0,0,,Dilarutkan?
Dialog: 0,0:46:53.80,0:46:55.09,teks umum,,0,0,0,,Faham
Dialog: 0,0:46:55.68,0:46:56.80,teks umum,,0,0,0,,Sejuk
Dialog: 0,0:46:56.88,0:46:58.76,teks umum,,0,0,0,,Adakah anda tidak beku dalam hal ini?
Dialog: 0,0:47:00.26,0:47:02.06,teks umum,,0,0,0,,Ambil selendang
Dialog: 0,0:47:02.14,0:47:04.52,teks umum,,0,0,0,,Saya ingin mengucapkan terima kasih entah bagaimana
Dialog: 0,0:47:07.60,0:47:10.69,teks umum,,0,0,0,,Ini adalah hadiah, bukan rasuah
Dialog: 0,0:47:11.27,0:47:12.40,teks umum,,0,0,0,,Di sini
Dialog: 0,0:47:31.84,0:47:33.46,teks umum,,0,0,0,,Sesuai dengan anda
Dialog: 0,0:47:43.72,0:47:46.52,teks umum,,0,0,0,,Adakah anda selesa memakai selendang?
Dialog: 0,0:47:55.11,0:47:59.28, inskripsi,,0,0,0,,Pertandingan untuk memilih pelayan di Sosnovy Bor
Dialog: 0,0:48:02.45,0:48:03.49,teks umum,,0,0,0,,Sekarang
Dialog: 0,0:48:04.24,0:48:06.75,teks umum,,0,0,0,,kami akan memulakan pemilihan pelayan
Dialog: 0,0:48:06.83,0:48:10.75,teks umum,,0,0,0,,Mereka yang lulus akan berakhir di Sosnovy Bor
Dialog: 0,0:48:11.33,0:48:13.59,miring,,0,0,0,,Saya akan menyemak senarai
Dialog: 0,0:48:14.30,0:48:16.55,teks umum,,0,0,0,,Jawab apabila saya memanggil nama awak
Dialog: 0,0:48:19.43,0:48:21.51,teks umum,,0,0,0,,Nombor 1: Park Joon Hwa
Dialog: 0,0:48:22.10,0:48:22.97,teks umum,,0,0,0,,Di sini
Dialog: 0,0:48:23.05,0:48:24.97,teks umum,,0,0,0,,Nombor dua: Ahn So-jeong
Dialog: 0,0:48:25.06,0:48:26.14,teks umum,,0,0,0,,Di sini
Dialog: 0,0:48:27.93,0:48:29.02,teks umum,,0,0,0,,Ahn So Jeong...
Dialog: 0,0:48:29.10,0:48:30.35, inskripsi,,0,0,0,,Dua
Dialog: 0,0:48:30.44,0:48:31.44,teks umum,,0,0,0,,An...
Dialog: 0,0:48:33.11,0:48:35.44,teks umum,,0,0,0,,- Tiga: Lee Young Ok\N{\i1}- Di sini
Dialog: 0,0:48:35.53,0:48:37.40,teks umum,,0,0,0,,- Empat: Park Hyun Soo\N{\i1}- Di sini
Dialog: 0,0:48:38.40,0:48:40.70,teks umum,,0,0,0,,- Lima: Bae Hwi Young\N-{\i1} Di sini
Dialog: 0,0:48:48.08,0:48:49.16,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:48:49.25,0:48:50.75,teks umum,,0,0,0,,Saya mahu pastikan
Dialog: 0,0:48:54.54,0:48:56.88, inskripsi,,0,0,0,,125: Moo Dok
Dialog: 0,0:48:58.63,0:48:59.88,teks umum,,0,0,0,,Ini dia datang
Dialog: 0,0:48:59.97,0:49:02.84,teks umum,,0,0,0,,Nombor 125: Moo Deok
Dialog: 0,0:49:04.26,0:49:05.30,teks umum,,0,0,0,,Di sini!
Dialog: 0,0:49:10.48,0:49:14.40,teks umum,,0,0,0,,Pembantu rumah anda, Mu Dok, berada di Sosnovy Bor hari ini
Dialog: 0,0:49:15.61,0:49:17.36,teks umum,,0,0,0,,Saya memberi amaran kepada anda
Dialog: 0,0:49:17.44,0:49:18.94,teks umum,,0,0,0,,Jangan terfikir untuk meninggalkan bilik ini
Dialog: 0,0:49:19.03,0:49:20.40,teks umum,,0,0,0,,Boleh awak buat dengan saya...
Dialog: 0,0:49:23.28,0:49:24.82,teks umum,,0,0,0,,Boleh tak awak jangan buat bising?
Dialog: 0,0:49:24.91,0:49:27.37,teks umum,,0,0,0,,Saya cuba menumpukan perhatian untuk membaca
Dialog: 0,0:49:27.45,0:49:28.87,teks umum,,0,0,0,,Saya tidak akan campur tangan
Dialog: 0,0:49:42.38,0:49:46.14,teks umum,,0,0,0,,Dalam tiga hari saya menunggu tuanku, Yang Amat Mulia
Dialog: 0,0:49:46.22,0:49:50.06,teks umum,,0,0,0,,Mengapa Sosnovy Bor begitu sesak hari ini?
Dialog: 0,0:49:50.89,0:49:55.15,teks umum,,0,0,0,,Hari ini mereka mengadakan pertandingan untuk mengambil pekerja baharu
Dialog: 0,0:49:55.81,0:49:58.61,teks umum,,0,0,0,,- Adakah perlu menganjurkan pertandingan keseluruhan?\N- Yang Amat Mulia
Dialog: 0,0:49:59.19,0:50:01.49,teks umum,,0,0,0,,Terdapat ramai orang yang ingin bekerja di sini
Dialog: 0,0:50:01.57,0:50:04.70,teks umum,,0,0,0,,Pembantu rumah keluarga Chan turut berada di sini
Dialog: 0,0:50:06.07,0:50:08.16,teks umum,,0,0,0,,- Won Mu Deok?\N- Ya
Dialog: 0,0:50:21.46,0:50:23.09,teks umum,,0,0,0,,Tugas pertama akan dihargai
Dialog: 0,0:50:23.67,0:50:28.22,teks umum,,0,0,0,,keupayaan anda membaca dan mengira
Dialog: 0,0:50:29.01,0:50:30.72,teks umum,,0,0,0,,Kita perlu menyelesaikan semuanya dengan betul
Dialog: 0,0:50:30.81,0:50:33.48,teks umum,,0,0,0,,Satu jawapan yang salah dan anda serta-merta dihapuskan
Dialog: 0,0:50:41.73,0:50:43.74,teks umum,,0,0,0,,Yul!
Dialog: 0,0:50:46.07,0:50:47.41,teks umum,,0,0,0,,Ini adalah tugas daripada pertandingan
Dialog: 0,0:50:49.33,0:50:51.83,teks umum,,0,0,0,,Banyak soalan. Walaupun dengan jawapan yang ringkas
Dialog: 0,0:50:52.45,0:50:53.96,teks umum,,0,0,0,,Moo Dok bijak,
Dialog: 0,0:50:54.04,0:50:55.54,teks umum,,0,0,0,,dia boleh tahan?
Dialog: 0,0:50:58.75,0:51:00.13,teks umum,,0,0,0,,Ia rumit
Dialog: 0,0:51:00.21,0:51:03.01,teks umum,,0,0,0,,Kasim Oh, bagaimana anda boleh mengeluarkan dakwat daripada pakaian?
Dialog: 0,0:51:03.09,0:51:04.22,contact,,0,0,0,,Berikut ialah soalan
Dialog: 0,0:51:04.30,0:51:06.68,teks umum,,0,0,0,,Pes nasi memang betul
Dialog: 0,0:51:07.30,0:51:08.55,italic,,0,0,0,,Dan apakah yang perlu anda lakukan dengannya?
Dialog: 0,0:51:08.64,0:51:11.47,teks umum,,0,0,0,,Mula-mula anda perlukan sedikit pada noda...
Dialog: 0,0:51:17.69,0:51:20.69,teks umum,,0,0,0,,"Anda menjemput 20 orang daripada 3 keluarga berbeza"
Dialog: 0,0:51:20.77,0:51:24.15,teks umum,,0,0,0,,"Empat orang boleh duduk di satu meja, berapa meja yang anda perlukan?"
Dialog: 0,0:51:26.11,0:51:29.57,teks umum,,0,0,0,,20 daripada setiap keluarga - iaitu 60 kesemuanya
Dialog: 0,0:51:31.66,0:51:35.29,teks umum,,0,0,0,,Ada empat orang di satu meja,
Dialog: 0,0:51:36.16,0:51:37.42,teks umum,,0,0,0,,- perlu 15\N- Tidak
Dialog: 0,0:51:38.33,0:51:40.38,teks umum,,0,0,0,,Tiga keluarga disebut secara khusus
Dialog: 0,0:51:41.29,0:51:45.34,teks umum,,0,0,0,,Wakil keluarga yang sama harus duduk semeja
Dialog: 0,0:51:46.05,0:51:48.38,teks umum,,0,0,0,,Maka kita memerlukan lebih banyak jadual
Dialog: 0,0:51:48.47,0:51:50.76,teks umum,,0,0,0,,Terdapat 9 meja untuk setiap keluarga
Dialog: 0,0:51:52.22,0:51:53.60,teks umum,,0,0,0,,Kemudian terdapat 27 jadual kesemuanya
Dialog: 0,0:52:00.02,0:52:01.48,teks umum,,0,0,0,,Ini adalah jemputan
Dialog: 0,0:52:01.56,0:52:03.11, inskripsi,,0,0,0,,9 x 3 = 27
Dialog: 0,0:52:03.19,0:52:05.86,teks umum,,0,0,0,,Hos juga memerlukan jadual
Dialog: 0,0:52:06.61,0:52:08.15,label,,0,0,0,,27 + hos = 2...
Dialog: 0,0:52:08.24,0:52:09.74,teks umum,,0,0,0,,28 jumlah
Dialog: 0,0:52:12.16,0:52:14.33,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:52:14.95,0:52:16.95,prasasti,,0,0,0,,28
Dialog: 0,0:52:17.46,0:52:20.21,teks umum,,0,0,0,,Seterusnya ialah persoalan bagaimana hendak menyiapkan tugasan dan tidak tersesat
Dialog: 0,0:52:21.00,0:52:23.38,teks umum,,0,0,0,,Saya akan dapatkan peta ibu kota
Dialog: 0,0:52:24.63,0:52:26.80, inskripsi,,0,0,0,,Bagaimana anda boleh mengeluarkan dakwat daripada pakaian?
Dialog: 0,0:52:27.47,0:52:29.76,teks umum,,0,0,0,,Apa yang perlu dilakukan jika dakwat tertumpah pada pakaian anda?
Dialog: 0,0:52:29.84,0:52:32.47,teks umum,,0,0,0,,Tidak boleh dibuang? Kasim O
Dialog: 0,0:52:33.39,0:52:34.64,teks umum,,0,0,0,,Ya, Yang Amat Mulia
Dialog: 0,0:52:34.72,0:52:37.73,teks umum,,0,0,0,,Bagaimana untuk mengeluarkan dakwat daripada pakaian?
Dialog: 0,0:52:37.81,0:52:39.89,teks umum,,0,0,0,,Ambil pes nasi hangat
Dialog: 0,0:52:39.98,0:52:41.85,teks umum,,0,0,0,,- dan smear...\N- Tepat
Dialog: 0,0:52:42.98,0:52:44.19,teks umum,,0,0,0,,Tulis
Dialog: 0,0:52:44.98,0:52:46.82,teks umum,,0,0,0,,"Pes nasi hangat"
Dialog: 0,0:52:51.57,0:52:53.28,teks umum,,0,0,0,,Semuanya betul-betul betul
Dialog: 0,0:52:53.37,0:52:55.49,teks umum,,0,0,0,,Saya tidak sangka saya akan melakukan sesuatu seperti ini dengan anda, tetapi ia menyeronokkan
Dialog: 0,0:52:56.12,0:52:58.45,teks umum,,0,0,0,,Moo Dok sendiri tidak dapat menanganinya
Dialog: 0,0:53:02.58,0:53:07.25,teks umum,,0,0,0,,Jadi kita perlu memberikan kertas ini kepadanya
Dialog: 0,0:53:08.76,0:53:12.26,teks umum,,0,0,0,,Dan bagaimana? Ia akan menjadi terlalu jelas
Dialog: 0,0:53:13.26,0:53:17.56,teks umum,,0,0,0,,Mungkin seseorang yang sangat ketara akan mengelakkan syak wasangka
Dialog: 0,0:53:37.45,0:53:38.66,sebalik tabir,,0,0,0,,Sukar
Dialog: 0,0:53:39.29,0:53:41.04,di sebalik tabir,,0,0,0,,Lebih sukar daripada yang saya sangka
Dialog: 0,0:53:43.08,0:53:45.17,teks umum,,0,0,0,,Jangan mengintip!
Dialog: 0,0:53:48.25,0:53:51.67,teks umum,,0,0,0,,Putera Mahkota telah tiba! Sampaikan salam kepadanya!
Dialog: 0,0:53:55.09,0:53:56.60,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:53:56.68,0:53:59.72,teks umum,,0,0,0,,- Yang Amat Mulia!\N- Yang Amat Mulia!
Dialog: 0,0:54:05.77,0:54:09.11,teks umum,,0,0,0,,Saya dengar ada pertandingan penting di sini, jadi saya datang untuk menyokong anda
Dialog: 0,0:54:11.15,0:54:12.70,teks umum,,0,0,0,,Ia adalah satu penghormatan bagi kami
Dialog: 0,0:54:12.78,0:54:15.87,teks umum,,0,0,0,,Jangan beri perhatian kepada saya, lakukan tugas
Dialog: 0,0:54:33.88,0:54:34.80,teks umum,,0,0,0,,Berfungsi!
Dialog: 0,0:54:36.26,0:54:37.60,teks umum,,0,0,0,, Tentukan!
Dialog: 0,0:54:38.18,0:54:39.39,miring,,0,0,0,,Tentukan
Dialog: 0,0:54:39.47,0:54:40.81,teks umum,,0,0,0,,- Anda juga\N- Memutuskan...
Dialog: 0,0:54:41.35,0:54:42.52,teks umum,,0,0,0,,Kembali bekerja
Dialog: 0,0:55:24.43,0:55:28.65,teks umum,,0,0,0,,Sekarang saya akan mengumumkan mereka yang lulus
Dialog: 0,0:55:31.36,0:55:34.32,teks umum,,0,0,0,,Park Jung Hwa. lulus
Dialog: 0,0:55:35.03,0:55:37.32,italic,,0,0,0,,Lee Young Ok gagal
Dialog: 0,0:55:37.40,0:55:40.49,italic,,0,0,0,,Hwang Young Ji gagal
Dialog: 0,0:55:41.33,0:55:43.37,italic,,0,0,0,,Oh Jae Ho lulus
Dialog: 0,0:55:45.87,0:55:47.54,teks umum,,0,0,0,,Nombor 125
Dialog: 0,0:55:47.62,0:55:48.96,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:55:58.93,0:56:00.34,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:56:02.68,0:56:04.14,teks umum,,0,0,0,,Dia lulus!
Dialog: 0,0:56:04.22,0:56:05.77,teks umum,,0,0,0,,Ya!
Dialog: 0,0:56:10.02,0:56:11.27,teks umum,,0,0,0,,Cemerlang
Dialog: 0,0:56:12.06,0:56:16.19,italic,,0,0,0,,40 orang menyelesaikan tugasan pertama
Dialog: 0,0:56:16.28,0:56:19.82,teks umum,,0,0,0,,Dan kemudian tugas praktikal
Dialog: 0,0:56:22.32,0:56:26.70,contact,,0,0,0,,Tugas ini akan menilai kemahiran mereka
Dialog: 0,0:56:27.58,0:56:28.91,contact,,0,0,0,,Masak makanan,
Dialog: 0,0:56:29.00,0:56:31.83,teks umum,,0,0,0,,bersih, basuh barang
Dialog: 0,0:56:31.92,0:56:34.38,teks umum,,0,0,0,,Dan kemudian mereka juga akan menguji ketahanan anda
Dialog: 0,0:57:03.70,0:57:06.33,teks umum,,0,0,0,,Nombor 125, Mu Deok
Dialog: 0,0:57:06.41,0:57:07.83,teks umum,,0,0,0,,Lulus!
Dialog: 0,0:57:36.86,0:57:38.94,teks umum,,0,0,0,,Nombor 125, Mu Deok
Dialog: 0,0:57:39.03,0:57:39.94,teks umum,,0,0,0,,Lulus!
Dialog: 0,0:57:42.99,0:57:44.16,prasasti,,0,0,0,,Seratus dua puluh lima
Dialog: 0,0:57:54.88,0:57:56.84,teks umum,,0,0,0,,Nombor 125, Mu Deok
Dialog: 0,0:57:57.34,0:57:58.67,teks umum,,0,0,0,,Lulus!
Dialog: 0,0:58:01.97,0:58:04.51,teks umum,,0,0,0,,Moo Dok sangat mengagumkan
Dialog: 0,0:58:04.59,0:58:06.39,teks umum,,0,0,0,,Tugas terakhir tinggal
Dialog: 0,0:58:06.47,0:58:08.39,teks umum,,0,0,0,,Kita mesti pergi dan menyokongnya
Dialog: 0,0:58:09.14,0:58:12.06,teks umum,,0,0,0,,Terdapat ramai orang baik di sana
Dialog: 0,0:58:12.14,0:58:14.40,teks umum,,0,0,0,,Saya ragu bahawa dia akan menjadi antara mereka yang lulus
Dialog: 0,0:58:14.48,0:58:16.73,teks umum,,0,0,0,,Yang Mulia, terima kasih atas bantuan anda
Dialog: 0,0:58:17.31,0:58:18.27,teks umum,,0,0,0,,Untuk ini
Dialog: 0,0:58:20.57,0:58:22.70,teks umum,,0,0,0,,- Jom\N- Ya
Dialog: 0,0:58:25.24,0:58:29.16,teks umum,,0,0,0,,Adakah itu yang dia suruh saya jangan datang?
Dialog: 0,0:58:29.24,0:58:31.66,teks umum,,0,0,0,,Kenapa nak marah sangat?
Dialog: 0,0:58:31.75,0:58:33.87,italic,,0,0,0,,Saya tidak percaya
Dialog: 0,0:58:34.79,0:58:36.38,teks umum,,0,0,0,,Tidak mengapa. jom pergi
Dialog: 0,0:58:37.17,0:58:38.46,teks umum,,0,0,0,,Yang Mulia, kita patut pergi ke sana
Dialog: 0,0:58:41.46,0:58:43.47,teks umum,,0,0,0,,- Saya tahu\N- Ya, Yang Amat Mulia
Dialog: 0,0:58:44.47,0:58:48.89,teks umum,,0,0,0,,Kita mesti berjalan lima ri dan kembali dengan air*
Dialog: 0,0:58:44.47,0:58:48.89,nota,,0,0,0,,*kira-kira 20 km
Dialog: 0,0:58:48.97,0:58:50.43,teks umum,,0,0,0,,Lima pertama
Dialog: 0,0:58:51.10,0:58:54.39,teks umum,,0,0,0,,akan memenangi pertandingan
Dialog: 0,0:58:55.64,0:58:56.90,di sebalik tabir,,0,0,0,,Halangan terakhir
Dialog: 0,0:58:58.11,0:59:00.11,di sebalik tabir,,0,0,0,,Saya sepatutnya antara yang pertama
Dialog: 0,0:59:12.29,0:59:13.12,teks umum,,0,0,0,,Maju!
Dialog: 0,0:59:21.71,0:59:24.84,teks umum,,0,0,0,,Dia merenung “Words of the Heart” selama berhari-hari
Dialog: 0,0:59:26.59,0:59:27.72,teks umum,,0,0,0,,Ya?
Dialog: 0,0:59:35.98,0:59:37.98,teks umum,,0,0,0,,Anda tidak boleh membacanya secepat itu
Dialog: 0,0:59:38.06,0:59:39.52,teks umum,,0,0,0,,Sabar
Dialog: 0,0:59:41.73,0:59:43.03,teks umum,,0,0,0,,Ya
Dialog: 0,0:59:43.73,0:59:47.03,teks umum,,0,0,0,,Hamba Kim sangat risau tentang kamu
Dialog: 0,0:59:47.91,0:59:49.70,teks umum,,0,0,0,, Beritahu saya jika anda memerlukan apa-apa
Dialog: 0,0:59:49.78,0:59:53.95,teks umum,,0,0,0,,Saya akan memesan katil, makanan dan pakaian yang anda ingin sediakan
Dialog: 0,0:59:55.79,0:59:57.21,teks umum,,0,0,0,,Tidak berbaloi
Dialog: 0,1:00:06.38,1:00:08.72,teks umum,,0,0,0,,Angin lebih sejuk
Dialog: 0,1:00:08.80,1:00:11.22,teks umum,,0,0,0,,Tutup tetingkap
Dialog: 0,1:00:12.76,1:00:16.93,kenangan miring,,0,0,0,,Cikgu So Kyung menulis buku ini kepada orang yang tidak dapat melihat,
Dialog: 0,1:00:17.02,1:00:19.98,kenangan,,0,0,0,,supaya dia boleh membacanya dengan hati
Dialog: 0,1:00:21.61,1:00:23.23,teks umum,,0,0,0,,Saya ada soalan
Dialog: 0,1:00:24.32,1:00:28.20,teks umum,,0,0,0,,Cikgu So Kyung kenal perempuan buta?
Dialog: 0,1:00:32.07,1:00:34.45,teks umum,,0,0,0,,Semasa huru-hara besar dua ratus tahun lalu
Dialog: 0,1:00:35.12,1:00:37.37,teks umum,,0,0,0,,ada
Dialog: 0,1:00:37.45,1:00:39.83,teks umum,,0,0,0,,bab pertama Jinyeowon
Dialog: 0,1:00:39.92,1:00:42.88,teks umum,,0,0,0,,Dan dia buta
Dialog: 0,1:00:44.09,1:00:47.84,di sebalik tabir,,0,0,0,,Dia menulis mesej ini kepada ketua Jinyeowon
Dialog: 0,1:00:49.72,1:00:53.80,teks umum,,0,0,0,,Dan ini pasti boleh dibaca oleh semua orang?
Dialog: 0,1:00:54.47,1:00:56.60,teks umum,,0,0,0,,Dan jika perasaannya diterangkan di sini,
Dialog: 0,1:00:56.68,1:00:58.77,teks umum,,0,0,0,,yang anda letakkan pada paparan umum?
Dialog: 0,1:01:02.81,1:01:05.82,teks umum,,0,0,0,,Cuba gunakan saya untuk membaca buku
Dialog: 0,1:01:06.48,1:01:08.28,teks umum,,0,0,0,,Saya akan katakan ini
Dialog: 0,1:01:08.36,1:01:13.41,teks umum,,0,0,0,,Buku ini tiada kena mengena dengan perasaan tuan
Dialog: 0,1:01:15.66,1:01:20.21,kenangan,,0,0,0,,Beratus-ratus ahli silap mata telah membaca buku ini, tetapi tiada siapa yang mengetahuinya
Dialog: 0,1:01:20.79,1:01:23.63,di sebalik tabir,,0,0,0,,Tepat sekali. Tiada siapa tahu ini surat cinta
Dialog: 0,1:01:23.71,1:01:25.67,teks umum,,0,0,0,,Daripada licik,
Dialog: 0,1:01:25.75,1:01:28.21,teks umum,,0,0,0,,buat latihan
Dialog: 0,1:01:29.01,1:01:32.22,di sebalik tabir,,0,0,0,,Bagaimana tiada siapa yang memahami perkara ini?
Dialog: 0,1:01:37.14,1:01:40.48,di sebalik tabir,,0,0,0,,Buku boleh dibaca dengan menumpukan tenaga
Dialog: 0,1:01:40.56,1:01:45.15,suara,,0,0,0,,Fikirkan bagaimana lagi ini boleh dilakukan, mengetahui bahawa ini adalah surat cinta
Dialog: 0,1:01:45.98,1:01:49.65,di sebalik tabir,,0,0,0,,Jadi mesti ada cara lain
Dialog: 0,1:01:50.69,1:01:52.86,di sebalik tabir,,0,0,0,,Selebihnya tidak tahu ini
Dialog: 0,1:01:52.95,1:01:55.45,di sebalik tabir,,0,0,0,,Ini hanya diketahui oleh mereka yang tahu tentang surat cinta
Dialog: 0,1:01:56.03,1:01:57.41,di sebalik tabir,,0,0,0,,Tetapi bagaimana?
Dialog: 0,1:01:57.49,1:02:00.66,kenangan,,0,0,0,,Bagaimanakah surat cinta bermula?
Dialog: 0,1:02:11.72,1:02:13.13,teks umum,,0,0,0,,Soalan lain
Dialog: 0,1:02:14.09,1:02:15.76,teks umum,,0,0,0,,Siapa nama awak
Dialog: 0,1:02:16.76,1:02:18.31,teks umum,,0,0,0,,bab pertama Jinyeowon?
Dialog: 0,1:02:30.61,1:02:32.53,teks umum,,0,0,0,,Semua surat cinta
Dialog: 0,1:02:33.99,1:02:35.86,teks umum,,0,0,0,,mulakan dengan nama penerima
Dialog: 0,1:02:36.78,1:02:37.91,teks umum,,0,0,0,,Nama terakhirnya
Dialog: 0,1:02:38.49,1:02:41.66,teks umum,,0,0,0,,adalah Jin, dan namanya Seol Ran
Dialog: 0,1:02:42.66,1:02:45.00,teks umum,,0,0,0,,Penerima surat itu ialah Sol Ran
Dialog: 0,1:02:45.08,1:02:46.71,teks umum,,0,0,0,,"Bunga orkid,"
Dialog: 0,1:02:47.88,1:02:49.17,teks umum,,0,0,0,,"yang dilitupi salji"
Dialog: 0,1:02:50.75,1:02:51.96,teks umum,,0,0,0,,Nama dia
Dialog: 0,1:02:53.17,1:02:55.05,teks umum,,0,0,0,,akan membuka surat ini
Dialog: 0,1:03:33.55,1:03:34.76,teks umum,,0,0,0,,Saya faham
Dialog: 0,1:03:42.93,1:03:44.93,teks umum,,0,0,0,,Hei, ini dia
Dialog: 0,1:03:46.94,1:03:48.56,teks umum,,0,0,0,,Inilah Moo Dok
Dialog: 0,1:04:03.12,1:04:04.66,di sebalik tabir,,0,0,0,,"Jangan sekat aliran air"
Dialog: 0,1:04:06.16,1:04:07.71,di sebalik tabir,,0,0,0,,"Tetapi setiap tahun bumi ini berbunga"
Dialog: 0,1:04:09.50,1:04:11.54,di sebalik tabir,,0,0,0,,"Kami tidak akan mengambil api ke tangan kami"
Dialog: 0,1:04:11.63,1:04:13.05,di sebalik tabir,,0,0,0,,"Mari kita nyalakan api dengan kayu"
Dialog: 0,1:04:15.38,1:04:17.26,di sebalik tabir,,0,0,0,,"Dan angin bertiup juga"
Dialog: 0,1:04:18.88,1:04:20.34,di sebalik tabir,,0,0,0,,"batu atau batu akan berhenti"
Dialog: 0,1:04:22.05,1:04:25.81,di sebalik tabir,,0,0,0,,"Jika anda memberi mereka kebebasan, mereka akan bersurai sepuas-puasnya"
Dialog: 0,1:04:27.60,1:04:29.02,di sebalik tabir,,0,0,0,,"Saya melihat langit biru"
Dialog: 0,1:04:30.69,1:04:32.02,luar skrin,,0,0,0,,"Esakan perlahan kedengaran"
Dialog: 0,1:04:34.86,1:04:37.03,di sebalik tabir,,0,0,0,,"Saya bernafas sejuk dan menghilang"
Dialog: 0,1:04:37.61,1:04:39.82,di sebalik tabir,,0,0,0,,"Saya mengubah keluhan saya menjadi salji dan air mata"
Dialog: 0,1:04:40.95,1:04:43.74,di sebalik tabir,,0,0,0,,"Tetapi saya tidak boleh menitiskan air mata. Saya menyembunyikannya sebaik mungkin"
Dialog: 0,1:04:45.33,1:04:48.08,di sebalik tabir,,0,0,0,,"Saya tahu mata saya akan penuh dengan air mata lagi"
Dialog: 0,1:04:48.79,1:04:53.13,di sebalik tabir,,0,0,0,,"Tetapi saya bodoh, tiada satu pun air mata mengalir di pipi saya"
Dialog: 0,1:04:58.42,1:05:00.05,teks umum,,0,0,0,,Kedua-duanya sudah kembali
Dialog: 0,1:05:02.68,1:05:03.89,teks umum,,0,0,0,,Saya tidak nampak Moo Deok
Dialog: 0,1:05:12.48,1:05:14.56,teks umum,,0,0,0,,Sudah ada enam orang di hadapannya
Dialog: 0,1:05:14.65,1:05:16.86,teks umum,,0,0,0,,Kita mesti memintas sekurang-kurangnya dua
Dialog: 0,1:05:27.33,1:05:30.41,kapsyen,,0,0,0,,"Tetapi saya bodoh, tiada satu pun air mata mengalir di pipi saya"
Dialog: 0,1:05:46.56,1:05:47.64,teks umum,,0,0,0,,Nak ke mana?
Dialog: 0,1:05:48.68,1:05:49.85,teks umum,,0,0,0,,Tepat sekali
Dialog: 0,1:05:52.31,1:05:53.40,teks umum,,0,0,0,,Saya baca
Dialog: 0,1:06:15.83,1:06:16.84,teks umum,,0,0,0,,Nombor 29,
Dialog: 0,1:06:16.92,1:06:18.80,teks umum,,0,0,0,,Jang Jong Do, awak lulus
Dialog: 0,1:06:19.80,1:06:22.01,teks umum,,0,0,0,,Tinggal seorang lagi
Dialog: 0,1:06:55.00,1:06:57.08,kenangan miring,,0,0,0,,Saya tidak memerlukan pelajar yang tidak membuat kemajuan
Dialog: 0,1:06:57.58,1:06:59.67,kenangan,,0,0,0,,Jika anda tidak melakukan apa-apa, mati sahaja
Dialog: 0,1:07:00.71,1:07:02.71,kenangan,,0,0,0,,Hei, ini berbahaya!
Dialog: 0,1:07:02.80,1:07:04.51,kenangan,,0,0,0,,Awak bukan lagi Nak Soo
Dialog: 0,1:07:11.18,1:07:13.14,suara,,0,0,0, "Tidak kira betapa buruknya perasaan anda,"
Dialog: 0,1:07:14.23,1:07:16.31,di sebalik tabir,,0,0,0,,"anda perlu melakukan apa yang anda boleh"
Dialog: 0,1:07:18.77,1:07:20.65,di sebalik tabir,,0,0,0,,Jika saya tidak mahu berbuat apa-apa,
Dialog: 0,1:07:22.23,1:07:23.69,suara,,0,0,0,,Saya lebih rela mati
Dialog: 0,1:07:43.17,1:07:45.05,teks umum,,0,0,0,,Nombor 125, Mu Dok,
Dialog: 0,1:07:47.47,1:07:48.80,teks umum,,0,0,0,,anda lulus!
Dialog: 0,1:07:58.02,1:08:00.81,teks umum,,0,0,0,,Ini adalah perkataan demi perkataan "Kata Hati"
Dialog: 0,1:08:01.52,1:08:03.44,teks umum,,0,0,0,,Chan Wook melakukannya
Dialog: 0,1:08:05.86,1:08:07.32,teks umum,,0,0,0,,Adakah dia berjaya?
Dialog: 0,1:08:12.16,1:08:15.33,teks umum,,0,0,0,,- Di mana dia sekarang?\N- Di Saejukwon
Dialog: 0,1:08:15.41,1:08:18.71,teks umum,,0,0,0,,Pembantu rumahnya pengsan semasa pertandingan,
Dialog: 0,1:08:18.79,1:08:20.00,teks umum,,0,0,0,,dia membawanya ke sana
Dialog: 0,1:08:21.17,1:08:22.34,teks umum,,0,0,0,,Hamba?
Dialog: 0,1:08:23.00,1:08:24.96,teks umum,,0,0,0,,- Adakah anda bercakap tentang Mu Dok?\N- Ya
Dialog: 0,1:08:25.05,1:08:27.01,teks umum,,0,0,0,,Dia lulus pertandingan
Dialog: 0,1:08:27.72,1:08:29.93,teks umum,,0,0,0,,Dia jatuh pada penghujungnya,
Dialog: 0,1:08:30.01,1:08:32.05,teks umum,,0,0,0,,tetapi dia berjaya
Dialog: 0,1:08:32.76,1:08:34.01,teks umum,,0,0,0,,Ya?
Dialog: 0,1:08:38.31,1:08:41.65,kenangan miring,,0,0,0,,Pembantu rumah saya mempertaruhkan nyawanya untuk memenuhi permintaan saya
Dialog: 0,1:08:42.36,1:08:43.73,kenangan miring,,0,0,0,,Itu adalah idea saya
Dialog: 0,1:08:56.75,1:08:58.08,teks umum,,0,0,0,,Jika anda memikirkannya,
Dialog: 0,1:08:59.83,1:09:02.00,teks umum,,0,0,0,,dia sentiasa di sebelah Chan Wook
Dialog: 0,1:09:04.04,1:09:05.71,teks umum,,0,0,0,,Maiden Mu Dok...
Dialog: 0,1:09:11.55,1:09:15.35,teks umum,,0,0,0,,Buku yang saya baca ialah surat cinta daripada Master Seo Kyung
Dialog: 0,1:09:18.14,1:09:19.31,teks umum,,0,0,0,,Betulkah?
Dialog: 0,1:09:20.14,1:09:22.23,teks umum,,0,0,0,,Mengapa dia membuatkan dia tidak kelihatan?
Dialog: 0,1:09:22.98,1:09:26.57,teks umum,,0,0,0,,Kekasihnya buta, dia mahu dia membacanya dengan hati
Dialog: 0,1:09:27.94,1:09:29.40,teks umum,,0,0,0,,Smart
Dialog: 0,1:09:29.99,1:09:31.11,teks umum,,0,0,0,,Saya tidak fikir begitu,
Dialog: 0,1:09:31.95,1:09:33.70,teks umum,,0,0,0,,bahawa surat itu telah sampai kepada penerima
Dialog: 0,1:09:34.45,1:09:36.53,teks umum,,0,0,0,,Kemudian ia akan berada di Jinyowon
Dialog: 0,1:09:37.29,1:09:38.87,teks umum,,0,0,0,,Tiada dalam Sosnovy Bor
Dialog: 0,1:09:39.45,1:09:42.62,teks umum,,0,0,0,,Surat cinta halimunan yang tidak pernah dihantar?
Dialog: 0,1:09:44.75,1:09:45.84,teks umum,,0,0,0,,Betapa pengecutnya
Dialog: 0,1:09:47.80,1:09:50.13,teks umum,,0,0,0,,Tuliskan perasaan dan jangan beritahu dia
Dialog: 0,1:09:51.63,1:09:53.01,teks umum,,0,0,0,,Betapa bodohnya
Dialog: 0,1:09:54.34,1:09:55.89,teks umum,,0,0,0,,dan surat cinta yang menyedihkan
Dialog: 0,1:10:01.52,1:10:03.44,teks umum,,0,0,0,,Kamu betul. Dia sepatutnya...
Dialog: 0,1:10:06.52,1:10:08.36,teks umum,,0,0,0,,hantar surat seperti yang anda lakukan
Dialog: 0,1:10:09.82,1:10:12.45,prasasti,,0,0,0,,Kami mengupah pekerja di Sosnovy Bor
Dialog: 0,1:10:13.82,1:10:15.28,teks umum,,0,0,0,,Ini bukan surat
Dialog: 0,1:10:15.37,1:10:16.74,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,1:10:16.83,1:10:19.54,teks umum,,0,0,0,,Jika ia menyampaikan perasaan anda, ini adalah surat
Dialog: 0,1:10:21.08,1:10:23.58,kenangan,,0,0,0,,Tunggu saya. Saya akan ke sana tidak lama lagi
Dialog: 0,1:10:23.67,1:10:25.42,kenangan,,0,0,0,,Jangan terperangkap. Selamat melancong
Dialog: 0,1:10:34.80,1:10:38.97,teks umum,,0,0,0,,Saya mungkin kelihatan menyedihkan dalam percubaan saya untuk ke sini sebagai pelayan
Dialog: 0,1:10:39.97,1:10:42.60,teks umum,,0,0,0,,Anda seorang guru yang sangat berpengalaman
Dialog: 0,1:10:43.10,1:10:44.89,teks umum,,0,0,0,,Saya kasihan dengan awak
Dialog: 0,1:10:45.85,1:10:48.36,teks umum,,0,0,0,,Sekurang-kurangnya anda belajar kesetiaan\N dan menunaikan kewajipan anda
Dialog: 0,1:10:48.44,1:10:50.48,teks umum,,0,0,0,,Guru saya berusaha keras untuk saya
Dialog: 0,1:10:50.57,1:10:53.95,teks umum,,0,0,0,,Saya fikir saya harus memberikan yang terbaik
Dialog: 0,1:10:56.24,1:10:57.95,teks umum,,0,0,0,,Adakah ini membuatkan anda tertekan?
Dialog: 0,1:10:58.74,1:11:01.54,teks umum,,0,0,0,,Tidak juga. Tetapi saya ragu-ragu
Dialog: 0,1:11:02.33,1:11:07.08,teks umum,,0,0,0,,Jawab anda sebagai pelajar atau sebagai sarjana
Dialog: 0,1:11:07.67,1:11:10.42,teks umum,,0,0,0,,Atau jawab mengikut gaya apa yang anda baca
Dialog: 0,1:11:16.26,1:11:17.80,teks umum,,0,0,0,,Dan apakah yang anda baca?
Dialog: 0,1:11:18.72,1:11:22.43,teks umum,,0,0,0,,Kemudian jawab sama?
Dialog: 0,1:11:24.06,1:11:25.60,teks umum,,0,0,0,,Sama? apa yang awak cakap ni?
Dialog: 0,1:11:26.14,1:11:30.27,teks umum,,0,0,0,,Ia tertulis di sana. "Saya akan melalui apa sahaja untuk berjumpa dengan awak"
Dialog: 0,1:11:30.98,1:11:34.28,teks umum,,0,0,0,,"Saya boleh buat apa sahaja, hanya untuk berpeluang berjumpa dengan awak"
Dialog: 0,1:11:34.90,1:11:36.28,teks umum,,0,0,0,,Dan ini jawapan saya
Dialog: 0,1:11:41.41,1:11:45.87,suara,,0,0,0,,Kita sepatutnya bersedia sebelum membiarkan dia begitu dekat
Dialog: 0,1:11:50.00,1:11:51.50,teks umum,,0,0,0,,Saya juga merindui awak
Dialog: 0,1:11:55.42,1:11:56.76,teks umum,,0,0,0,,Ini jawapan saya
Dialog: 0,1:12:05.93,1:12:07.73,di sebalik tabir,,0,0,0,,Apa yang saya berikan kepadanya,
Dialog: 0,1:12:09.27,1:12:13.27,di sebalik tabir,,0,0,0,,tidak berbaloi untuk dibaca atau disebarkan
Dialog: 0,1:12:15.15,1:12:16.78,luar skrin,,0,0,0,,Itu bodoh dan menyedihkan saya
Dialog: 0,1:12:18.57,1:12:20.16,di sebalik tabir,,0,0,0,,surat cinta
Dialog: 0,1:12:52.00,1:12:53.19,pratonton,,0,0,0,,Buka mata saya - Saya sudah merindui awak
Dialog: 0,1:12:53.27,1:12:55.19,pratonton,,0,0,0,,- Saya rindu awak sepanjang hari\N- Cukuplah
Dialog: 0,1:12:55.28,1:12:57.36,pratonton,,0,0,0,,Tiada jalan keluar dari racun ini
Dialog: 0,1:12:57.44,1:12:59.40,pratonton,,0,0,0,,Penawarnya ialah lelaki yang meracuni anda
Dialog: 0,1:12:59.49,1:13:00.86,pratonton,,0,0,0,,Adakah anda benar-benar gila?
Dialog: 0,1:13:00.95,1:13:02.82,pratonton,,0,0,0,,Ini adalah simptom keracunan saya
Dialog: 0,1:13:02.91,1:13:06.04,pratonton,,0,0,0,,Nak Su, hanya ada seorang dalam fikiran kamu. Dan ini Chan Wook
Dialog: 0,1:13:06.12,1:13:08.25,pratonton,,0,0,0,,Anda tidak percaya apabila saya berkata saya jatuh cinta dengan awak
Dialog: 0,1:13:08.33,1:13:10.29,pratonton,,0,0,0,,Kemudian buat saya percaya
Dialog: 0,1:13:10.37,1:13:12.83,pratonton,,0,0,0,,Ini adalah perkara paling berharga yang saya terima
Dialog: 0,1:13:12.92,1:13:15.84,pratonton,,0,0,0,,Lakukan semua yang anda boleh untuk mendapatkannya kembali
Dialog: 0,1:13:15.92,1:13:18.72,pratonton,,0,0,0,,Saya bertengkar dengan pembantu rumah awak
Dialog: 0,1:13:18.80,1:13:21.01,pratonton,,0,0,0,,Berjuang dan mati, Chan Wook
Dialog: 0,1:13:21.09,1:13:22.18,pratonton,,0,0,0,,Saya kata saya rindu awak,
Dialog: 0,1:13:22.26,1:13:23.68,pratonton,,0,0,0,,dan anda berkata bahawa ini adalah kelemahan saya
Dialog: 0,1:13:23.76,1:13:25.10,pratonton,,0,0,0,,Jangan pergi
Dialog: 0,1:13:25.76,1:13:29.39,pratonton,,0,0,0,,Saya sangat suka Moo Deok
Dialog: 0,0:02:55.14,0:02:57.14,nicks,,0,0,0,,

