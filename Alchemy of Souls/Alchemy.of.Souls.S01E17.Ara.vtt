Dialogue: 0,0:02:47.14,0:02:52.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,النكات,,0,0,0,,مترجمو الطباعة:{\c&HFFF4C5&} Ria_Lee، ألينا، زيرو أماميا
Dialogue: 0,0:00:44.10,0:00:45.98,النص العام,,0,0,0,,من أنت ولماذا تلاحقني؟
Dialogue: 0,0:00:46.77,0:00:47.73,نص عام,,0,0,0,,أنا أسأل...
Dialogue: 0,0:00:49.90,0:00:51.15,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:01:11.17,0:01:13.05,نص عام,,0,0,0,,بالحكم على حقيقة أنك تعرفت على السيف،
Dialogue: 0,0:01:13.63,0:01:14.84,نص عام,,0,0,0,,يجب أن تكون ساحرًا
Dialogue: 0,0:01:17.43,0:01:19.22,نص عام,,0,0,0,,ضع سيفك جانباً
Dialogue: 0,0:01:21.22,0:01:24.94,النص العام,,0,0,0,,من الخطر سحب سيف جيونبوغوان هنا
Dialogue: 0,0:01:27.94,0:01:29.98,نص عام,,0,0,0,,هذه قرية جيما
Dialogue: 0,0:01:31.07,0:01:34.15,general text,,0,0,0,,سحرة جيونبوغوان الذين أتوا من أجل السحر يعتبرون أعداء هنا
Dialogue: 0,0:01:35.90,0:01:37.07,نص عام,,0,0,0,,إذا دخلت في قتال
Dialogue: 0,0:01:37.16,0:01:39.62,نص عام,,0,0,0,,وسوف يعرف الناس أنك هنا،
Dialogue: 0,0:01:40.66,0:01:42.70,نص عام,,0,0,0,,سوف تكون في خطر
Dialogue: 0,0:01:50.59,0:01:51.71,نص عام,,0,0,0,,يبدو هكذا،
Dialogue: 0,0:01:52.71,0:01:54.47,نص عام,,0,0,0,,كأنك تعرف من أنا
Dialogue: 0,0:01:56.34,0:01:58.64,النص العام,,0,0,0,,أنت تحمل سيف غوانغجو لجيونبوغوان
Dialogue: 0,0:02:00.31,0:02:01.90,نص عام,,0,0,0,,أعتقد أنك ابنه
Dialogue: 0,0:02:09.03,0:02:12.24,مائل,,0,0,0,,هل يعرف كيف يبدو والده؟
Dialogue: 0,0:02:14.79,0:02:18.46,general text,,0,0,0,,أبوه ليس لديه صور مثل والدته؟
Dialogue: 0,0:02:18.54,0:02:20.92,نص عام,,0,0,0,,ليس لدينا صور لغوانغجو
Dialogue: 0,0:02:21.88,0:02:23.84,النص العام,,0,0,0,,والسيد لم يسأل عنه
Dialogue: 0,0:02:24.71,0:02:28.01,general text,,0,0,0,,لم ير أباه إلا وهو طفل فلا يتذكر وجهه
Dialogue: 0,0:02:29.18,0:02:31.39,نص عام,,0,0,0,,لا يتعرف على والده،
Dialogue: 0,0:02:31.47,0:02:33.14,نص عام,,0,0,0,,حتى لو اصطدمت به
Dialogue: 0,0:02:36.56,0:02:39.60,general text,,0,0,0,,تابعتك فقط لأنني تعرفت على السيف.
Dialogue: 0,0:02:44.19,0:02:45.94,نص عام,,0,0,0,,هل تعرف صاحب السيف؟
Dialogue: 0,0:02:48.53,0:02:51.28,النص العام,,0,0,0,,الرجل الذي ترك مثل هذا السيف مجنون
Dialogue: 0,0:02:52.91,0:02:54.95,general text,,0,0,0,,زوجته خانته وماتت
Dialogue: 0,0:02:56.16,0:02:59.16,general text,,0,0,0,,بعد ذلك تخلى عن ابنه واستقال من منصبه واختفى
Dialogue: 0,0:03:01.08,0:03:02.92,النص العام,,0,0,0,,هذا الشخص المجنون هو تشانغ جانج
Dialogue: 0,0:03:07.05,0:03:08.84,نص عام,,0,0,0,,يقولون عنه أشياء كهذه من وراء ظهره
Dialogue: 0,0:03:09.63,0:03:11.80,النص العام,,0,0,0,,لم يقل أحد هذا في وجهي من قبل
Dialogue: 0,0:03:13.10,0:03:14.93,general text,,0,0,0,,هل لديك حساباتك الخاصة لتصفيتها معه؟
Dialogue: 0,0:03:17.77,0:03:18.89,نص عام,,0,0,0,,ماذا لو كان الأمر كذلك؟
Dialogue: 0,0:03:19.99,0:03:22.95,general text,,0,0,0,,تنتقم لي من أجل والدك؟
Dialogue: 0,0:03:26.99,0:03:28.41,نص عام,,0,0,0,,لا
Dialogue: 0,0:03:28.50,0:03:30.46,النص العام,,0,0,0,,لن أفعل ذلك حتى كابنه
Dialogue: 0,0:03:31.58,0:03:33.00,نص عام,,0,0,0,,لا يريد ذلك
Dialogue: 0,0:03:35.21,0:03:38.09,general text,,0,0,0,,إذن لماذا تحمل سيف أبيك معك؟
Dialogue: 0,0:03:38.17,0:03:40.17,general text,,0,0,0,,إذا أنكرت أنه والدي،
Dialogue: 0,0:03:41.13,0:03:42.26,نص عام,,0,0,0,,أمي
Dialogue: 0,0:03:43.14,0:03:44.72,النص العام,,0,0,0,,سيبدو مثيرًا للشفقة
Dialogue: 0,0:03:48.81,0:03:49.93,نص عام,,0,0,0,,قبل الحفا...
Dialogue: 0,0:03:53.65,0:03:56.11,النص العام,,0,0,0,,دو هوا كان الضحية الأكبر
Dialogue: 0,0:04:05.95,0:04:07.62,نص عام,,0,0,0,,هل تعرف أمي أيضاً؟
Dialogue: 0,0:04:09.70,0:04:13.12,general text,,0,0,0,,دو هوا كانت أجمل امرأة في دايهو كلها
Dialogue: 0,0:04:15.04,0:04:18.05,نص عام,,0,0,0,,كل من في ديهو يعرفها
Dialogue: 0,0:04:18.63,0:04:21.72,النص العام,,0,0,0,,يبدو أن كل فرد في عائلتي مشهور بشيء ما
Dialogue: 0,0:04:23.34,0:04:24.72,نص عام,,0,0,0,,يجب أن أقول،
Dialogue: 0,0:04:24.80,0:04:28.35,general text,,0,0,0,,لم أتوقع أن أقابل شخصًا هنا يمكنه التعرف عليّ
Dialogue: 0,0:04:56.43,0:04:58.85,general text,,0,0,0,,هذا مكان يمارس فيه الناس السحر سرًا،
Dialogue: 0,0:04:58.93,0:05:00.81,نص عام,,0,0,0,,رغم حظر سوسنوفي بور
Dialogue: 0,0:05:01.47,0:05:05.27,general text,,0,0,0,,ماذا يفعل ابن غوانغجو جيونبوغوان في مثل هذا المكان؟
Dialogue: 0,0:05:05.35,0:05:06.90,نص عام,,0,0,0,,حسنًا، لقد أخبروني أنني أستطيع ذلك
Dialogue: 0,0:05:06.98,0:05:10.07,نص عام,,0,0,0,,انظر هنا سحر اللعنات والنفوس
Dialogue: 0,0:05:10.15,0:05:11.86,النص العام,,0,0,0,,أنت ساحر جيونجينغاك،
Dialogue: 0,0:05:12.40,0:05:14.40,النص العام,,0,0,0,,وهل أنت مهتم بالسحر الأسود؟
Dialogue: 0,0:05:15.70,0:05:16.78,نص عام,,0,0,0,,ليس حقًا
Dialogue: 0,0:05:17.91,0:05:20.49,النص العام,,0,0,0,,أنا هنا للعثور على الشامان الذي يستخدم هذا السحر
Dialogue: 0,0:05:22.49,0:05:23.58,نص عام,,0,0,0,"شامان"؟
Dialogue: 0,0:05:24.45,0:05:27.04,النص العام,,0,0,0,,هذا الشامان يمتلك سحر الروح،
Dialogue: 0,0:05:27.67,0:05:29.63,نص عام,,0,0,0,,الذي سحر الناس ودفعهم إلى الجنون
Dialogue: 0,0:05:31.63,0:05:33.17,خط مائل,,0,0,0,,قبل عشرين عامًا تم القبض عليها
Dialogue: 0,0:05:33.26,0:05:36.51,general text,,0,0,0,,سحرة جيونبوغوان لكنها هربت بعد أن احترق منزلها
Dialogue: 0,0:05:38.93,0:05:40.93,نص عام,,0,0,0,,ماذا تحتاج من الشامان تشوي؟
Dialogue: 0,0:05:41.43,0:05:43.52,نص عام,,0,0,0,,كيف عرفت أن الأمر يتعلق بها؟
Dialogue: 0,0:05:45.98,0:05:49.56,general text,,0,0,0,,وأنت، بالصدفة، لست ساحر جيونبوغوان،
Dialogue: 0,0:05:50.31,0:05:51.94,نص عام,,0,0,0,,من كان يعمل مع والدي؟
Dialogue: 0,0:05:53.86,0:05:56.15,general text,,0,0,0,,كانت عائلة تشوي عائلة من السحرة،
Dialogue: 0,0:05:57.24,0:06:00.50,النص العام,,0,0,0,,الذي دمره المعلم سو كيونغ منذ زمن طويل
Dialogue: 0,0:06:02.92,0:06:04.67,نص عام,,0,0,0,,لا تكن فضولياً
Dialogue: 0,0:06:05.42,0:06:08.13,مائل,,0,0,0,,إذا كان هذا الاهتمام يأكلك،
Dialogue: 0,0:06:09.26,0:06:12.22,general text,,0,0,0,,ظلمة هذا السحر ستسيطر على روحك،
Dialogue: 0,0:06:12.30,0:06:14.18,النص العام,,0,0,0,,وفي النهاية ستخسر كل شيء
Dialogue: 0,0:06:16.35,0:06:17.81,نص عام,,0,0,0,,عندما يحدث هذا،
Dialogue: 0,0:06:18.98,0:06:20.69,نص عام,,0,0,0,,لن يكون هناك رجوع إلى الوراء
Dialogue: 0,0:06:27.53,0:06:30.32,النص العام,,0,0,0,,لا تبحث عن من يمارس السحر الأسود
Dialogue: 0,0:06:31.24,0:06:33.49,النص العام,,0,0,0,,العالم لا يوافق على مثل هذه الأمور،
Dialogue: 0,0:06:34.53,0:06:35.99,نص عام,,0,0,0,,ولن يغفر لك
Dialogue: 0,0:06:42.79,0:06:43.88,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:06:49.30,0:06:50.47,نص عام,,0,0,0,,هنا
Dialogue: 0,0:06:56.10,0:06:57.43,نص عام,,0,0,0,,هل أنت مصاب؟
Dialogue: 0,0:06:58.14,0:07:00.23,نص عام,,0,0,0,,نعم مجروح
Dialogue: 0,0:07:02.02,0:07:04.61,النص العام,,0,0,0,,أنا مجروح في أعماق روحي
Dialogue: 0,0:07:17.79,0:07:19.88,general text,,0,0,0,,هل هو حقًا هكذا بسبب السحر الأسود؟
Dialogue: 0,0:07:51.08,0:07:52.21,نص عام,,0,0,0,,بو يونغ!
Dialogue: 0,0:07:53.62,0:07:54.79,نص عام,,0,0,0,,بو يونغ!
Dialogue: 0,0:08:16.44,0:08:19.07,التعليق الصوتي,,0,0,0,,هل نظرت إلي للتو؟
Dialogue: 0,0:08:21.57,0:08:23.03,ذكريات بخط مائل,,0,0,0,,عذرًا
Dialogue: 0,0:08:23.11,0:08:25.24,ذكريات,,0,0,0,,هل يمكنك مساعدتي في رفع العكاز؟
Dialogue: 0,0:08:26.28,0:08:28.58,التعليق الصوتي,,0,0,0,,هذه هي الفتاة التي التقيت بها في المنزل
Dialogue: 0,0:08:47.10,0:08:48.40,خط مائل,,0,0,0,,أمي!
Dialogue: 0,0:08:54.07,0:08:55.03,نص عام,,0,0,0,,الأم
Dialogue: 0,0:08:56.40,0:08:57.78,general text,,0,0,0,,هل هي حقًا بو يونغ أوني؟
Dialogue: 0,0:08:58.70,0:09:01.12,النص العام,,0,0,0,,نعم هذه أختك
Dialogue: 0,0:09:02.33,0:09:03.75,نص عام,,0,0,0,,أوني
Dialogue: 0,0:09:09.04,0:09:12.00,النص العام,,0,0,0,,بو يونغ، سآخذك إلى غرفتك
Dialogue: 0,0:09:44.12,0:09:47.21,نص عام,,0,0,0,,أنت خادمة تشان ووك
Dialogue: 0,0:09:47.87,0:09:49.96,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:09:51.92,0:09:55.21,النص العام,,0,0,0,,جئت لمساعدة السيدة جين على الهروب من المنزل
Dialogue: 0,0:09:55.30,0:09:57.81,نص عام,,0,0,0,,ولكن يبدو أنه من الأفضل أن أغادر
Dialogue: 0,0:09:57.89,0:09:59.52,نص عام,,0,0,0,,سأغادر بالفعل
Dialogue: 0,0:10:10.24,0:10:11.87,خلف الكواليس,,0,0,0,,ماذا كان يفعل مو دوك هنا؟
Dialogue: 0,0:10:12.45,0:10:14.28,خارج الشاشة,,0,0,0,,كنت متأكدًا من أنها لم تتعرف علي
Dialogue: 0,0:10:15.41,0:10:17.20,خارج الشاشة,,0,0,0,,هل كان يجب أن أقتلها للتو؟
Dialogue: 0,0:10:18.71,0:10:21.88,النص العام,,0,0,0,,بو يونغ، لم يتغير شيء في غرفتك
Dialogue: 0,0:10:22.63,0:10:25.88,نص عام,,0,0,0,,كنت أعلم أن هذا اليوم سيأتي يومًا ما
Dialogue: 0,0:10:37.22,0:10:38.43,نص عام,,0,0,0,,دعونا ندخل
Dialogue: 0,0:10:55.70,0:10:57.95,نص عام,,0,0,0,,كل أشيائك
Dialogue: 0,0:10:59.00,0:11:00.54,نص عام,,0,0,0,,مازلت هنا
Dialogue: 0,0:11:01.62,0:11:04.17,النص العام,,0,0,0,,منذ أن كدت أموت في البحيرة،
Dialogue: 0,0:11:05.63,0:11:09.46,general text,,0,0,0,,كل مساء كان علي أن أتجول بحثًا عن مكان للإقامة ليلاً
Dialogue: 0,0:11:10.22,0:11:11.93,نص عام,,0,0,0,,والآن لدي غرفة
Dialogue: 0,0:11:15.64,0:11:18.32,نص عام,,0,0,0,,لم أكن أعلم أن لي أماً تنتظرني
Dialogue: 0,0:11:21.15,0:11:25.28,النص العام,,0,0,0,,كل يوم أعاني وأعاني
Dialogue: 0,0:11:30.50,0:11:31.91,نص عام,,0,0,0,,طفلي المسكين
Dialogue: 0,0:11:33.33,0:11:35.71,نص عام,,0,0,0,,الآن ستكون سعيدًا كل يوم
Dialogue: 0,0:11:37.13,0:11:38.55,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:11:42.42,0:11:43.59,نص عام,,0,0,0,,أمي
Dialogue: 0,0:12:00.03,0:12:04.28,مائل,,0,0,0,,هل وجدت جين مو ابنتها حقًا؟
Dialogue: 0,0:12:06.53,0:12:09.62,نص عام,,0,0,0,,نعم. فتحت الفتاة الباب لجينيونغ
Dialogue: 0,0:12:10.66,0:12:12.58,النص العام,,0,0,0,,- ماذا؟\N- هل فتحت الأبواب؟
Dialogue: 0,0:12:12.66,0:12:16.04,النص العام,,0,0,0,,هذه الأبواب لا يمكن فتحها بأي حيل
Dialogue: 0,0:12:16.12,0:12:19.54,general text,,0,0,0,,فقط ابنة عائلة جين هي القادرة على ذلك
Dialogue: 0,0:12:22.63,0:12:27.22,النص العام,,0,0,0,,هل عاد جين بو يونغ؟
Dialogue: 0,0:12:36.82,0:12:40.45,general text,,0,0,0,,لماذا تؤلمني عيناي كثيرًا في كل مرة أذهب فيها إلى جينيوون؟
Dialogue: 0,0:12:47.71,0:12:49.63,التعليق الصوتي,,0,0,0,,هل بسبب آثارهم؟
Dialogue: 0,0:13:09.31,0:13:10.86,general text,,0,0,0,,مو دوك، ماذا تفعل هنا؟
Dialogue: 0,0:13:11.98,0:13:13.78,نص عام,,0,0,0,,هل نظرت في المرآة؟
Dialogue: 0,0:13:17.74,0:13:19.28,النص العام,,0,0,0,,هل تريد أن تصبح ألطف معي؟
Dialogue: 0,0:13:20.53,0:13:21.91,نص عام,,0,0,0,,لا تتحدث بالهراء
Dialogue: 0,0:13:22.58,0:13:23.70,نص عام,,0,0,0,,أوه انتظر
Dialogue: 0,0:13:23.79,0:13:25.58,نص عام,,0,0,0,,أريد أن أصبح أجمل
Dialogue: 0,0:13:26.20,0:13:29.17,نص عام,,0,0,0,,اختر ما يناسب مالك
Dialogue: 0,0:13:31.96,0:13:33.42,نص عام,,0,0,0,,سأختاره بنفسي
Dialogue: 0,0:13:38.30,0:13:39.93,نص عام,,0,0,0,,فكيف؟ يناسبني
Dialogue: 0,0:13:40.01,0:13:42.97,نص عام,,0,0,0,,نعم. تبدو رائعا
Dialogue: 0,0:13:43.51,0:13:45.64,نص عام,,0,0,0,,بالطبع يناسبني
Dialogue: 0,0:13:46.52,0:13:47.89,نص عام,,0,0,0,,دعونا نرى
Dialogue: 0,0:13:50.06,0:13:51.65,نص عام,,0,0,0,,أوه وهذا مناسب
Dialogue: 0,0:13:51.73,0:13:53.61,نص عام,,0,0,0,,من الصعب الاختيار. كل شيء يناسبني
Dialogue: 0,0:13:59.16,0:14:00.50,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:14:01.00,0:14:04.04,نص عام,,0,0,0,,أعطني إياه. الآن سأرسمك
Dialogue: 0,0:14:09.92,0:14:13.22,نص عام,,0,0,0,,انظروا كم هو لطيف
Dialogue: 0,0:14:13.72,0:14:16.10,نص عام,,0,0,0,,أنا بالفعل لطيفة بما فيه الكفاية،
Dialogue: 0,0:14:16.18,0:14:17.68,نص عام,,0,0,0,,الآن حان دورك
Dialogue: 0,0:14:23.31,0:14:25.19,النص العام,,0,0,0,,يا لها من لطيف مو ديوك لدينا
Dialogue: 0,0:14:27.28,0:14:30.32,نص عام,,0,0,0,,طفولية. اعتقدت أنك أحببت عيني فقط
Dialogue: 0,0:14:30.40,0:14:33.07,نص عام,,0,0,0,,بالضبط. اعتقدت أن العيون فقط هي الجميلة
Dialogue: 0,0:14:34.45,0:14:37.04,نص عام,,0,0,0,,لكن سمك لعب معي نكتة قاسية
Dialogue: 0,0:14:37.12,0:14:38.95,نص عام,,0,0,0,,الآن أنا معجب بك على أية حال
Dialogue: 0,0:14:48.96,0:14:52.59,النص العام,,0,0,0,,أرى كيف تحاول ألا تقع في حبي
Dialogue: 0,0:14:52.68,0:14:53.68,نص عام,,0,0,0,,الأمر صعب عليك
Dialogue: 0,0:14:58.18,0:15:00.48,نص عام,,0,0,0,,لكن لا. لا على الاطلاق
Dialogue: 0,0:15:03.98,0:15:07.57,general text,,0,0,0,,إذا كنت ستكذب على وجهي، على الأقل العب بشكل أفضل.
Dialogue: 0,0:15:07.65,0:15:10.24,نص عام,,0,0,0,,تحول المكان كله إلى اللون الأحمر
Dialogue: 0,0:15:12.99,0:15:15.96,نص عام,,0,0,0,,إنه بسبب احمرار الخدود!
Dialogue: 0,0:15:16.04,0:15:17.17,نص عام,,0,0,0,,دعني
Dialogue: 0,0:15:19.92,0:15:22.30,نص عام,,0,0,0,,على ما يبدو أنني ذهبت بعيداً. لا تؤتي ثمارها
Dialogue: 0,0:15:25.43,0:15:26.89,نص عام,,0,0,0,,أنت الآن
Dialogue: 0,0:15:27.64,0:15:30.27,نص عام,,0,0,0,,تبدو مثل كلب مخمور
Dialogue: 0,0:15:33.64,0:15:36.94,النص العام,,0,0,0,,لا تبدو هكذا، فهي تبدو مثل كلب على وشك أن يعض
Dialogue: 0,0:15:37.02,0:15:39.36,نص عام,,0,0,0,,أستطيع حقًا أن أعض
Dialogue: 0,0:15:41.57,0:15:43.78,نص عام,,0,0,0,,لن أعض. اجلس
Dialogue: 0,0:15:47.28,0:15:49.83,نص عام,,0,0,0,,هيا هذا يكفي
Dialogue: 0,0:15:53.08,0:15:55.42,نص عام,,0,0,0,,كان علي أن أشتري هذا بسببك
Dialogue: 0,0:15:56.50,0:15:59.79,general text,,0,0,0,,إذا لم يعجبك فلا تستخدمه. سأحتفظ بها لنفسي
Dialogue: 0,0:16:01.38,0:16:03.13,نص عام,,0,0,0,,هذا لطيف أيضًا
Dialogue: 0,0:17:05.24,0:17:06.12,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:17:23.22,0:17:24.85,النص العام,,0,0,0,,لقد كدت أن تدهس
Dialogue: 0,0:17:34.32,0:17:35.69,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:17:35.78,0:17:38.82,النص العام,,0,0,0,,هل أنت سكران حقاً؟ هل شربت بدوني؟
Dialogue: 0,0:17:41.53,0:17:44.41,نص عام,,0,0,0,,شربت أيضًا. ربما معا الآن؟
Dialogue: 0,0:17:45.16,0:17:46.74,نص عام,,0,0,0,,لست ثملاً
Dialogue: 0,0:17:47.66,0:17:49.12,نص عام,,0,0,0,,هل ذهبت لتناول مشروب؟
Dialogue: 0,0:17:49.21,0:17:52.00,general text,,0,0,0,,كنت في قرية جيما، عالجوني هناك
Dialogue: 0,0:17:52.58,0:17:54.97,النص العام,,0,0,0,,هل قابلت الشامان تشوي هناك؟
Dialogue: 0,0:17:56.47,0:17:58.93,general text,,0,0,0,,وجدت صلة بينها وبين جين مو
Dialogue: 0,0:17:59.02,0:18:01.85,general text,,0,0,0,,ولقد التقيت أيضًا بولي العهد هناك
Dialogue: 0,0:18:02.60,0:18:03.69,نص عام,,0,0,0,,مع الأمير؟
Dialogue: 0,0:18:03.77,0:18:07.19,النص العام,,0,0,0,,ويشتبه أيضًا في جين مو والملكة
Dialogue: 0,0:18:15.03,0:18:16.03,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,0:18:17.45,0:18:19.25,general text,,0,0,0,,هل أنت عائد من قرية جيما؟
Dialogue: 0,0:18:20.33,0:18:21.25,نص عام,,0,0,0,,نعم
Dialogue: 0,0:18:21.83,0:18:24.67,النص العام,,0,0,0,,القصر يشبه المتاهة. بالكاد وجدت طريقي
Dialogue: 0,0:18:25.38,0:18:26.38,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:18:26.92,0:18:29.84,general text,,0,0,0,,- هل حدث شيء ما؟\N- النائب جين مو هنا
Dialogue: 0,0:18:50.65,0:18:54.70,general text,,0,0,0,,أين ذهبت وحدك دون حراس؟
Dialogue: 0,0:18:55.36,0:18:58.58,general text,,0,0,0,,أشعر بالحرج لأن هجومي لم يمر دون أن يلاحظه أحد. دعونا نترك الأمر
Dialogue: 0,0:19:01.00,0:19:03.00,نص عام,,0,0,0,,رأيت جلالته
Dialogue: 0,0:19:03.71,0:19:05.67,نص عام,,0,0,0,,ذكر نجم الملك مرة أخرى
Dialogue: 0,0:19:07.59,0:19:09.00,النص العام,,0,0,0,,إنه مهووس بها
Dialogue: 0,0:19:09.09,0:19:12.72,general text,,0,0,0,,أعطه على الأقل جهاز لوحي مزيف مع هذه النجمة
Dialogue: 0,0:19:12.80,0:19:15.14,general text,,0,0,0,,ثم عليه أن يجد كل من ولد في ذلك اليوم
Dialogue: 0,0:19:15.23,0:19:16.73,نص عام,,0,0,0,,وقتل
Dialogue: 0,0:19:18.44,0:19:19.65,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:19:20.15,0:19:22.07,النص العام,,0,0,0,,قد يكون هذا بطلاً
Dialogue: 0,0:19:22.15,0:19:25.07,general text,,0,0,0,,أشبه بالسيد سو كيونغ، وليس خائنًا ومتآمرًا.
Dialogue: 0,0:19:25.15,0:19:27.66,general text,,0,0,0,,يقولون أن سيو كيونغ أنقذ العالم بحجر جليدي
Dialogue: 0,0:19:27.74,0:19:28.70,نص عام,,0,0,0,,لكن الأمر ليس كذلك
Dialogue: 0,0:19:30.49,0:19:33.00,general text,,0,0,0,,في الأساس، كان يسيطر على العالم، ويمنع الجميع
Dialogue: 0,0:19:33.08,0:19:34.62,نص عام,,0,0,0,,استخدم هذه القوة الهائلة
Dialogue: 0,0:19:35.62,0:19:38.42,general text,,0,0,0,,هذا الحجر يخلق سحرًا أسودًا، وهو خطير
Dialogue: 0,0:19:38.50,0:19:40.67,نص عام,,0,0,0,,هكذا يعتقد سوسنوفي بور
Dialogue: 0,0:19:41.55,0:19:45.05,general text,,0,0,0,,حجر الجليد يمكن أن يجلب الخلود في حياتنا
Dialogue: 0,0:19:46.26,0:19:47.76,نص عام,,0,0,0,,دعونا نتوقف عن التقدم في السن والموت
Dialogue: 0,0:19:47.84,0:19:51.51,general text,,0,0,0,,قوته ستجعلنا شبابًا وجميلين إلى الأبد
Dialogue: 0,0:19:51.60,0:19:53.31,النص العام,,0,0,0,,هل تتحدث عن كيمياء النفوس؟
Dialogue: 0,0:19:53.39,0:19:55.31,general text,,0,0,0,,سوسنوفي بور حظرت هذا السحر
Dialogue: 0,0:19:55.39,0:19:56.94,نص عام,,0,0,0,,وإذا رفع الحظر
Dialogue: 0,0:19:57.02,0:19:58.94,نص عام,,0,0,0,,وهل تسمح لك باستخدام حجر الجليد؟
Dialogue: 0,0:19:59.02,0:20:00.11,نص عام,,0,0,0,,صاحب السمو,
Dialogue: 0,0:20:00.90,0:20:02.61,النص العام,,0,0,0,,ماذا سيحدث حينها، ما رأيك؟
Dialogue: 0,0:20:06.03,0:20:09.49,general text,,0,0,0,,من معه الحجر فإنه يحيا إلى الأبد
Dialogue: 0,0:20:10.70,0:20:13.83,general text,,0,0,0,,ولكن من الخطر منح مثل هذه السلطة للجميع
Dialogue: 0,0:20:13.91,0:20:15.79,نص عام,,0,0,0,,ليس للجميع
Dialogue: 0,0:20:15.87,0:20:18.62,general text,,0,0,0,,سنصدر مرسومًا يقتصر بموجبه على المختارين فقط،
Dialogue: 0,0:20:18.71,0:20:20.96,نص عام,,0,0,0,,كيف يمكنك مثلاً استخدام هذا السحر
Dialogue: 0,0:20:24.80,0:20:26.63,general text,,0,0,0,,ثم عليك أن تجد الحجر،
Dialogue: 0,0:20:26.72,0:20:29.34,نص عام,,0,0,0,,لجعل هذا ممكنًا
Dialogue: 0,0:20:30.01,0:20:32.81,general text,,0,0,0,,جين بو يونغ، ابنة جينيونغ المفقودة، عادت
Dialogue: 0,0:20:32.89,0:20:34.90,النص العام,,0,0,0,,- جينيوون؟\N- امرأة,
Dialogue: 0,0:20:34.98,0:20:39.20,general text,,0,0,0,,الذي ساعد المعلم سيو كيونغ في العثور على الحجر، كان الفصل الأول من جينيوون
Dialogue: 0,0:20:39.28,0:20:41.49,النص العام,,0,0,0,,وجين بو يونغ قوي جدًا،
Dialogue: 0,0:20:41.57,0:20:43.37,نص عام,,0,0,0,,مثل الفصل الأول
Dialogue: 0,0:20:48.21,0:20:51.13,general text,,0,0,0,,إذا ظهر الحجر الجليدي، مثل مائتي عام مضت،
Dialogue: 0,0:20:51.21,0:20:53.04,نص عام,,0,0,0,,وريثة جينيوون
Dialogue: 0,0:20:54.25,0:20:56.30,النص العام,,0,0,0,,سوف تجده على الفور
Dialogue: 0,0:21:00.26,0:21:02.55,مائل,,0,0,0,,عادت ابنة جينيوون الكبرى على قيد الحياة
Dialogue: 0,0:21:03.05,0:21:05.93,النص العام,,0,0,0,,تبدو كفتاة عمياء عادية
Dialogue: 0,0:21:06.64,0:21:08.43,النص العام,,0,0,0,,اعتقدت أنها كانت قوية بشكل لا يصدق
Dialogue: 0,0:21:09.27,0:21:10.69,general text,,0,0,0,,لماذا فقدت قوتها؟
Dialogue: 0,0:21:10.77,0:21:12.15,نص عام,,0,0,0,,رغم,
Dialogue: 0,0:21:12.23,0:21:15.23,نص عام,,0,0,0,,لم تتمكن من العثور على منزل لمدة عشر سنوات، لذا فمن الممكن
Dialogue: 0,0:21:18.15,0:21:21.74,general text,,0,0,0,,أحضرها جين مو، لا يمكن أن يكون كل شيء نظيفًا هناك
Dialogue: 0,0:21:21.82,0:21:23.41,نص عام,,0,0,0,,هل لاحظت أي شيء غريب؟
Dialogue: 0,0:21:26.83,0:21:29.54,general text,,0,0,0,,قابلتها ذات مرة في منزلك
Dialogue: 0,0:21:31.54,0:21:34.29,مائل,,0,0,0,,تذكرت لأنني ساعدتها في رفع عكازها
Dialogue: 0,0:21:36.59,0:21:37.92,نص عام,,0,0,0,,في منزلي؟
Dialogue: 0,0:21:38.01,0:21:40.26,نص عام,,0,0,0,,لم ألاحظ أي شيء غريب عنها حينها
Dialogue: 0,0:21:40.34,0:21:41.97,نص عام,,0,0,0,,اليوم أيضاً
Dialogue: 0,0:21:45.76,0:21:46.72,نص عام,,0,0,0,,مظلة...
Dialogue: 0,0:21:50.43,0:21:52.44,نص عام,,0,0,0,,كان لديها مظلة
Dialogue: 0,0:21:52.52,0:21:54.45,نص عام,,0,0,0,,لقد رأيته بالفعل في مكان ما
Dialogue: 0,0:21:55.03,0:21:57.91,نص عام,,0,0,0,,المظلة؟ ما هو الشيء المميز في المظلة؟
Dialogue: 0,0:21:57.99,0:21:59.04,نص عام,,0,0,0,,ليس هذا هو الهدف
Dialogue: 0,0:21:59.12,0:22:01.91,النص العام,,0,0,0,,هذه المظلة مصنوعة من جلد الغنم والخيزران عالي الجودة
Dialogue: 0,0:22:02.71,0:22:04.21,نص عام,,0,0,0,,لقد كان مكلفًا للغاية
Dialogue: 0,0:22:05.42,0:22:07.67,general text,,0,0,0,,- كيف حصلت عليها؟\N{\i1}- ماذا؟{\i0}
Dialogue: 0,0:22:07.75,0:22:09.34,نص عام,,0,0,0,,من كان يملكها من قبل؟
Dialogue: 0,0:22:11.59,0:22:12.63,خط مائل,,0,0,0,,المظلة؟
Dialogue: 0,0:22:13.22,0:22:15.01,نص عام,,0,0,0,,ليس لدي
Dialogue: 0,0:22:15.59,0:22:17.05,نص عام,,0,0,0,,أعطيت لشخص ما
Dialogue: 0,0:22:17.14,0:22:18.47,نص عام,,0,0,0,,إلى من وأين؟
Dialogue: 0,0:22:19.27,0:22:20.98,نص عام,,0,0,0,,لم أفعل ذلك عمداً
Dialogue: 0,0:22:21.06,0:22:22.89,نص عام,,0,0,0,,عذراً، لقد اشتريته لي
Dialogue: 0,0:22:23.52,0:22:25.10,نص عام,,0,0,0,,لست بحاجة إلى اعتذار
Dialogue: 0,0:22:25.60,0:22:27.52,النص العام,,0,0,0,,هل أعطيته للفتاة؟
Dialogue: 0,0:22:28.15,0:22:30.15,نص عام,,0,0,0,,نعم للفتاة
Dialogue: 0,0:22:30.23,0:22:31.24,نص عام,,0,0,0,,فقط لا تغضب
Dialogue: 0,0:22:32.95,0:22:35.24,نص عام,,0,0,0,,لماذا يجب أن أغضب؟
Dialogue: 0,0:22:35.32,0:22:36.74,نص عام,,0,0,0,,من هذه الفتاة؟
Dialogue: 0,0:22:37.32,0:22:38.33,نص عام,,0,0,0,,هاه؟
Dialogue: 0,0:22:38.41,0:22:40.87,نص عام,,0,0,0,,أجب بالفعل! تعبت من الانتظار
Dialogue: 0,0:22:40.95,0:22:42.79,النص العام,,0,0,0,,لأي فتاة أهديته؟
Dialogue: 0,0:22:46.29,0:22:47.84,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:22:47.92,0:22:50.34,النص العام,,0,0,0,,هذه ليست الطريقة الصحيحة للسؤال. يول...
Dialogue: 0,0:22:51.71,0:22:53.92,النص العام,,0,0,0,,أصبح شاحباً من الخوف
Dialogue: 0,0:22:54.01,0:22:56.30,general text,,0,0,0,,توبخه مثل الزوجة التي ضبطته يخونه
Dialogue: 0,0:22:56.39,0:22:59.05,general text,,0,0,0,,لا يمكنك أن تسأل بهذه النبرة... متطلبة
Dialogue: 0,0:22:59.89,0:23:01.72,خط مائل,,0,0,0,,شاهد وتذكر. يول،
Dialogue: 0,0:23:01.81,0:23:04.69,نص عام,,0,0,0,,هل أعطيت المظلة للفتاة العمياء؟
Dialogue: 0,0:23:05.44,0:23:06.44,نص عام,,0,0,0,,كيف عرفت؟
Dialogue: 0,0:23:07.73,0:23:10.69,general text,,0,0,0,,ربما هذه هي "سو يي" التي سبق ذكرها من قبل؟
Dialogue: 0,0:23:11.98,0:23:14.16,نص عام,,0,0,0,,نعم أعطيتها المظلة
Dialogue: 0,0:23:14.25,0:23:15.37,خط مائل,,0,0,0,,ماذا؟
Dialogue: 0,0:23:16.42,0:23:17.67,نص عام,,0,0,0,,اليوم كنت في جينيوون
Dialogue: 0,0:23:18.54,0:23:20.67,general text,,0,0,0,,هناك رأيت ابنتهم المفقودة جين بو يونغ
Dialogue: 0,0:23:20.75,0:23:22.34,نص عام,,0,0,0,,كانت عمياء،
Dialogue: 0,0:23:22.42,0:23:24.67,نص عام,,0,0,0,,لكن بدلاً من العكاز كانت لديها مظلة
Dialogue: 0,0:23:25.59,0:23:26.76,نص عام,,0,0,0,,نفس المظلة؟
Dialogue: 0,0:23:30.30,0:23:31.18,خط مائل,,0,0,0,,يا رفاق!
Dialogue: 0,0:23:32.43,0:23:34.06,خط مائل,,0,0,0,,هل سمعت الأخبار؟
Dialogue: 0,0:23:34.14,0:23:37.44,general text,,0,0,0,,تم العثور على الأخت الكبرى تشو يونغ. لقد وجدوا جين بو يونغ!
Dialogue: 0,0:23:39.23,0:23:40.27,نص عام,,0,0,0,,هاه؟
Dialogue: 0,0:23:40.98,0:23:42.73,النص العام,,0,0,0,,ما هذه الوجوه الحامضة؟
Dialogue: 0,0:23:43.32,0:23:44.78,نص عام,,0,0,0,,عن ماذا كنت تتحدث؟
Dialogue: 0,0:23:44.86,0:23:47.40,نص عام,,0,0,0,,عن إذن أنا الذي كنا نبحث عنه
Dialogue: 0,0:23:48.03,0:23:48.86,نص عام,,0,0,0,,وأنا كذلك؟
Dialogue: 0,0:23:49.91,0:23:51.12,نص عام,,0,0,0,,هذا المحتال؟
Dialogue: 0,0:23:51.70,0:23:52.66,نص عام,,0,0,0,,هل وجدتها؟
Dialogue: 0,0:23:52.74,0:23:55.04,النص العام,,0,0,0,,جين بو يونغ، أحضره جين مو،
Dialogue: 0,0:23:55.91,0:23:57.12,النص العام,,0,0,0,,هذا محتال سو يي
Dialogue: 0,0:23:57.92,0:23:59.79,general text,,0,0,0,,على ما يبدو، قُتل كل هؤلاء الأشخاص،
Dialogue: 0,0:23:59.88,0:24:01.79,نص عام,,0,0,0,,لإخفاء هويتها
Dialogue: 0,0:24:17.52,0:24:18.73,نص عام,,0,0,0,,جين بو يونغ
Dialogue: 0,0:24:22.73,0:24:25.15,نص عام,,0,0,0,,سأصبح نسختك الدقيقة
Dialogue: 0,0:24:42.76,0:24:45.14,النص العام,,0,0,0,,عصابة الرأس هي نفس عصابة مو ديوك
Dialogue: 0,0:24:48.31,0:24:49.98,نص عام,,0,0,0,,لماذا هي هنا؟
Dialogue: 0,0:24:51.90,0:24:53.02,خط مائل,,0,0,0,,بو يونغ!
Dialogue: 0,0:25:01.20,0:25:02.36,نص عام,,0,0,0,,لقد اكتشفت...
Dialogue: 0,0:25:03.49,0:25:04.53,نص عام,,0,0,0,,هذه الضمادة؟
Dialogue: 0,0:25:11.75,0:25:13.79,خط مائل,,0,0,0,,شعار جينيوون
Dialogue: 0,0:25:13.88,0:25:17.13,نص عام,,0,0,0,,طرزت على كل العصابات
Dialogue: 0,0:25:17.88,0:25:20.05,النص العام,,0,0,0,,كنت قلقة من أن يحدث لك شيء ما،
Dialogue: 0,0:25:20.13,0:25:23.09,نص عام,,0,0,0,,لأنك أعمى
Dialogue: 0,0:25:23.18,0:25:27.51,general text,,0,0,0,,لهذا السبب جعلتك ترتدي عصابة رأس عليها شعار عائلتنا
Dialogue: 0,0:25:30.06,0:25:31.31,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:25:35.56,0:25:37.90,ذكريات,,0,0,0,,الضمادة قديمة لكن حرير
Dialogue: 0,0:25:38.57,0:25:41.28,ذكريات,,0,0,0,,ربما يكون والديك الحقيقيان أغنياء
Dialogue: 0,0:25:43.78,0:25:45.78,ذكريات,,0,0,0,,هل أنت أعمى حقاً؟
Dialogue: 0,0:25:46.70,0:25:48.70,ذكريات,,0,0,0,,أرى كل شيء، لكن لا أستطيع العثور على البث
Dialogue: 0,0:25:48.79,0:25:50.91,ذكريات,,0,0,0,,لكن الأمر ليس صعبًا بالنسبة لك
Dialogue: 0,0:25:53.55,0:25:58.22,مائل,,0,0,0,,بو يونغ، منذ الطفولة كان لديك القدرة على الشعور بالطاقة
Dialogue: 0,0:25:58.93,0:26:03.02,general text,,0,0,0,,لقد تمكنت من العثور على الأشياء بشكل أسرع من المبصرين
Dialogue: 0,0:26:03.60,0:26:06.44,نص عام,,0,0,0,,لم تحتار في الطريق ولم تضيع
Dialogue: 0,0:26:07.73,0:26:10.15,خلف الكواليس,,0,0,0,,مثل مو دوك في قرية ساري
Dialogue: 0,0:26:10.23,0:26:13.20,خلف الكواليس,,0,0,0,,كانت تجد الأشياء بسهولة وكانت تعرف دائمًا إلى أين تذهب
Dialogue: 0,0:26:13.28,0:26:15.11,النص العام,,0,0,0,,كنت ترتدي نفس الضمادة بالضبط...
Dialogue: 0,0:26:16.74,0:26:19.58,نص عام,,0,0,0,,يوم اختفائك
Dialogue: 0,0:26:20.74,0:26:24.21,نص عام,,0,0,0,,لذلك كنت أتمنى أن تستفيد منه،
Dialogue: 0,0:26:25.58,0:26:26.92,نص عام,,0,0,0,,لتجد طريقك إلى المنزل
Dialogue: 0,0:26:28.04,0:26:30.38,خارج الإطار,,0,0,0,,كانت تتعامل دائمًا مع هذه الضمادة بخوف
Dialogue: 0,0:26:30.46,0:26:32.92,التعليق الصوتي,,0,0,0,,قالت إن هذه هي الطريقة الوحيدة للعثور على منزل
Dialogue: 0,0:26:34.68,0:26:36.47,نص عام,,0,0,0,,لو كنت قد حفظته،
Dialogue: 0,0:26:37.85,0:26:40.93,نص عام,,0,0,0,,سوف أتعرف عليك على الفور
Dialogue: 0,0:26:42.02,0:26:45.48,خلف الكواليس,,0,0,0,,هذه المرأة قامت بخياطة عصابة الرأس التي سرقتها من مو دوك
Dialogue: 0,0:26:46.60,0:26:48.19,خط مائل,,0,0,0,,شكرًا جزيلا لك،
Dialogue: 0,0:26:48.27,0:26:52.07,النص العام,,0,0,0,,أنها عادت سالمة غانمة، بو يونغ
Dialogue: 0,0:26:58.95,0:27:01.54,خلف الكواليس,,0,0,0,,بو يونغ الحقيقية، ابنة هذه المرأة...
Dialogue: 0,0:27:02.29,0:27:04.37,خلف الكواليس,,0,0,0,,صديقي مو ديوك
Dialogue: 0,0:27:27.45,0:27:28.66,ذكريات,,0,0,0,,بو يونغ!
Dialogue: 0,0:27:31.58,0:27:35.08,خارج الإطار,,0,0,0,,هل فتحت أبواب جينيوون بسببها؟
Dialogue: 0,0:27:37.21,0:27:38.71,general text,,0,0,0,,مو ديوك هو جين بو يونغ الحقيقي
Dialogue: 0,0:27:40.25,0:27:42.71,general text,,0,0,0,,ماذا سيحدث لي إذا علمت بهذا؟
Dialogue: 0,0:27:45.55,0:27:47.01,general text,,0,0,0,,هل سيقتلونني؟
Dialogue: 0,0:27:52.97,0:27:54.22,خط مائل,,0,0,0,,أوني
Dialogue: 0,0:27:55.43,0:27:56.93,نص عام,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:27:57.60,0:27:59.02,النص العام,,0,0,0,,هل تريد فتح الأبواب مرة أخرى؟
Dialogue: 0,0:27:59.10,0:28:00.27,نص عام,,0,0,0,,لا
Dialogue: 0,0:28:03.40,0:28:06.61,النص العام,,0,0,0,,لا أستطيع أن أصدق أنك عائلتي حقًا
Dialogue: 0,0:28:07.82,0:28:09.36,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,0:28:10.03,0:28:11.20,نص عام,,0,0,0,,صدق
Dialogue: 0,0:28:11.28,0:28:14.20,نص عام,,0,0,0,,لقد رأينا جميعًا كيف فتحت الأبواب
Dialogue: 0,0:28:17.87,0:28:21.88,النص العام,,0,0,0,,بالمناسبة، تلك الفتاة التي كانت معك الليلة الماضية...
Dialogue: 0,0:28:21.96,0:28:23.09,general text,,0,0,0,,هل تتحدث عن مو ديوك؟
Dialogue: 0,0:28:23.84,0:28:25.30,النص العام,,0,0,0,,إنها لا تخدم جينيوون
Dialogue: 0,0:28:25.38,0:28:28.63,نص عام,,0,0,0,,هل تأتي إلى هنا كثيرًا؟ يبدو أن الأم تعرفها أيضًا
Dialogue: 0,0:28:28.72,0:28:30.43,نص عام,,0,0,0,,الأم لا تحبها
Dialogue: 0,0:28:30.51,0:28:32.60,النص العام,,0,0,0,,كما ترى، إنها ليست سوى مشاكل
Dialogue: 0,0:28:32.69,0:28:33.98,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:28:36.28,0:28:37.61,نص عام,,0,0,0,,يبدو أن هذا هو السبب...
Dialogue: 0,0:28:37.69,0:28:39.70,نص عام,,0,0,0,,شعرت بالطاقة السلبية
Dialogue: 0,0:28:40.74,0:28:43.20,نص عام,,0,0,0,,طاقة سلبية؟
Dialogue: 0,0:28:43.28,0:28:47.20,general text,,0,0,0,,الطاقة التي شعرت بها كانت مظلمة وغير سارة
Dialogue: 0,0:28:48.08,0:28:51.08,النص العام,,0,0,0,,ابتعد عن الأشخاص الذين لديهم هذا النوع من الطاقة
Dialogue: 0,0:28:51.67,0:28:54.79,نص عام,,0,0,0,,إنها ليست شخصًا سيئًا
Dialogue: 0,0:28:55.88,0:28:57.21,خط مائل,,0,0,0,,ها أنتم يا فتيات
Dialogue: 0,0:28:59.38,0:29:00.38,نص عام,,0,0,0,,أبي
Dialogue: 0,0:29:00.47,0:29:01.38,نص عام,,0,0,0,,أبتاه
Dialogue: 0,0:29:02.22,0:29:03.93,النص العام,,0,0,0,,تشو يونغ، أمي تبحث عنك
Dialogue: 0,0:29:04.51,0:29:05.60,نص عام,,0,0,0,,الأم؟
Dialogue: 0,0:29:07.01,0:29:09.10,نص عام,,0,0,0,,اعتقدت أنها لم تعد غاضبة بعد الآن
Dialogue: 0,0:29:10.48,0:29:12.98,نص عام,,0,0,0,,- أنا خارج\N- حسنًا
Dialogue: 0,0:29:17.98,0:29:20.53,نص عام,,0,0,0,,قلت لك ابتعد عن ابنتي
Dialogue: 0,0:29:21.28,0:29:22.40,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:29:23.32,0:29:25.82,general text,,0,0,0,,في اليوم الأخير من الشهر ينتظروننا في جيونبوغوان
Dialogue: 0,0:29:25.91,0:29:27.91,نص عام,,0,0,0,,- كن مستعداً\N- حسناً
Dialogue: 0,0:29:29.33,0:29:30.58,نص عام,,0,0,0,,أبت، انتظر
Dialogue: 0,0:29:33.12,0:29:34.37,نص عام,,0,0,0,,هل أنت متأكد،
Dialogue: 0,0:29:37.00,0:29:39.46,النص العام,,0,0,0,,أن جين بو يونغ مات؟
Dialogue: 0,0:29:40.92,0:29:43.34,general text,,0,0,0,,ماذا سيحدث لي إذا عادت؟
Dialogue: 0,0:29:44.59,0:29:46.55,النص العام,,0,0,0,,لا تشغل رأسك بمثل هذه الأفكار
Dialogue: 0,0:29:48.97,0:29:50.14,نص عام,,0,0,0,,لقد ماتت
Dialogue: 0,0:29:59.70,0:30:01.70,general text,,0,0,0,,حتى لو كانت مو دوك هي ابنتهما الحقيقية،
Dialogue: 0,0:30:01.79,0:30:03.46,نص عام,,0,0,0,,لا أحد منهم يعلم بهذا الأمر
Dialogue: 0,0:30:04.62,0:30:06.54,نص عام,,0,0,0,,لا يمكننا أن نسمح لهم بمعرفة ذلك
Dialogue: 0,0:30:09.92,0:30:11.38,نص عام,,0,0,0,,أنا جين بو يونغ
Dialogue: 0,0:30:23.56,0:30:25.14,نص عام,,0,0,0,,لقد كنت أفكر في هذا طوال الليل
Dialogue: 0,0:30:25.77,0:30:28.06,general text,,0,0,0,,هذا قد يعرض حبي للخطر،
Dialogue: 0,0:30:28.15,0:30:31.65,general text,,0,0,0,,لكنني سأقوم بواجبي كوريث لسوسنوفي بور
Dialogue: 0,0:30:31.73,0:30:34.28,النص العام,,0,0,0,,- سأذهب وأخبر عمي بكل شيء\N- لا
Dialogue: 0,0:30:34.36,0:30:37.66,النص العام,,0,0,0,,هل تتذكر كيف تشاجر مع السيدة جين؟
Dialogue: 0,0:30:37.74,0:30:39.53,نص عام,,0,0,0,,إن لم يكن لدينا دليل
Dialogue: 0,0:30:39.62,0:30:42.24,general text,,0,0,0,,دعونا نعلن أن ابنتها بو يونغ الكاذبة والقاتلة،
Dialogue: 0,0:30:42.74,0:30:45.00,النص العام,,0,0,0,,سوف تتدهور العلاقات مع جينيوون تمامًا
Dialogue: 0,0:30:46.21,0:30:47.33,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:30:47.42,0:30:51.34,general text,,0,0,0,,إذا ظهرت الحقيقة، فسوف تندلع الحرب بين جين مو وجيني وون.
Dialogue: 0,0:30:52.00,0:30:54.51,النص العام,,0,0,0,,لا يمكننا التدخل حتى نكتشف كل شيء
Dialogue: 0,0:30:56.47,0:30:59.05,general text,,0,0,0,,لكن لماذا أحضروا المحتال...
Dialogue: 0,0:30:59.14,0:31:00.85,النص العام,,0,0,0,,وقالوا أنها وريثة؟
Dialogue: 0,0:31:00.93,0:31:03.02,general text,,0,0,0,,لأنهم بحاجة إلى رجلهم في جينيوون
Dialogue: 0,0:31:03.93,0:31:05.06,نص عام,,0,0,0,,ماذا لو تم القبض عليها؟
Dialogue: 0,0:31:05.14,0:31:07.14,نص عام,,0,0,0,,الأم تتعرف على طفلها
Dialogue: 0,0:31:07.23,0:31:10.66,general text,,0,0,0,,في النهاية، سيتم القبض عليها. لماذا تأخذ مثل هذه المخاطرة؟
Dialogue: 0,0:31:11.45,0:31:13.20,نص عام,,0,0,0,,لأنه لا شيء بالنسبة له
Dialogue: 0,0:31:15.45,0:31:17.04,نص عام,,0,0,0,,ربما لدى جين مو شيء ما،
Dialogue: 0,0:31:17.12,0:31:19.92,نص عام,,0,0,0,,الذي لن يسمح لـ Jin Ho Kyung بفعل أي شيء،
Dialogue: 0,0:31:21.08,0:31:23.17,نص عام,,0,0,0,,حتى لو اعترف بالاستبدال
Dialogue: 0,0:31:30.93,0:31:32.51,خارج الشاشة,,0,0,0,,هناك خطأ ما معها
Dialogue: 0,0:31:33.18,0:31:38.06,التعليق الصوتي,,0,0,0,,لديها نفس الندبة والشامة التي كانت لدى بو يونغ
Dialogue: 0,0:31:39.44,0:31:41.02,خلف الكواليس,,0,0,0,,لكن شكل الأذنين مختلف
Dialogue: 0,0:31:42.77,0:31:45.23,خارج الإطار,,0,0,0,,الآذان لا تتغير أبدًا
Dialogue: 0,0:31:47.74,0:31:49.74,general text,,0,0,0,,ذاكرتي تخونني؟
Dialogue: 0,0:31:51.87,0:31:53.08,نص عام,,0,0,0,,أختي
Dialogue: 0,0:32:11.13,0:32:12.84,نص عام,,0,0,0,,للمساعدة في البحث عن Boo Young
Dialogue: 0,0:32:13.39,0:32:16.52,النص العام,,0,0,0,,لقد طلبت الإذن بدخول جينيوون، أنا متفاجئ.
Dialogue: 0,0:32:17.18,0:32:19.98,نص عام,,0,0,0,,لم يكن مسموحًا لي هنا،
Dialogue: 0,0:32:20.06,0:32:22.23,نص عام,,0,0,0,,رغم أنني فرد من عائلة جين
Dialogue: 0,0:32:22.31,0:32:24.56,general text,,0,0,0,,لقد عاقبتك بشدة في كل مرة،
Dialogue: 0,0:32:25.40,0:32:27.15,نص عام,,0,0,0,,عندما اقتربت من جينيوون
Dialogue: 0,0:32:28.90,0:32:30.79,نص عام,,0,0,0,,لقد كنت صارمًا جدًا معك حقًا
Dialogue: 0,0:32:31.54,0:32:34.21,general text,,0,0,0,,كرهتك رغم ظهورك بسبب مغامرات والدك
Dialogue: 0,0:32:34.29,0:32:36.67,general text,,0,0,0,,أحتقر كل محاولاتك المجتهدة
Dialogue: 0,0:32:36.75,0:32:38.67,نص عام,,0,0,0,,يرجى وإرضاء الجميع من حولك
Dialogue: 0,0:32:39.42,0:32:40.76,نص عام,,0,0,0,,سامحوني
Dialogue: 0,0:32:44.55,0:32:46.30,نص عام,,0,0,0,,كل هذا أصبح في الماضي
Dialogue: 0,0:33:04.41,0:33:06.16,نص عام,,0,0,0,,الآن عاد بو يونغ
Dialogue: 0,0:33:09.24,0:33:12.25,النص العام,,0,0,0,,أعلنها وريثتك بسرعة
Dialogue: 0,0:33:14.08,0:33:17.79,general text,,0,0,0,,تعيين بو يونغ كرئيس جديد لجينيونغ؟
Dialogue: 0,0:33:18.30,0:33:22.80,النص العام,,0,0,0,,الفصل الجديد سوف يبث الحياة في جينيوون مرة أخرى
Dialogue: 0,0:33:22.88,0:33:24.01,نص عام,,0,0,0,,وبعد ذلك
Dialogue: 0,0:33:24.09,0:33:28.10,النص العام,,0,0,0,,سأجعل تشو يون وليةً للأميرة
Dialogue: 0,0:33:32.31,0:33:33.69,نص عام,,0,0,0,,لا داعي للاستعجال
Dialogue: 0,0:33:33.77,0:33:35.98,النص العام,,0,0,0,,ذاكرة بو يونغ لم تعد بعد
Dialogue: 0,0:33:36.69,0:33:39.15,نص عام,,0,0,0,,وما زلت قادرًا على التحكم في جينيوون
Dialogue: 0,0:33:39.23,0:33:43.78,general text,,0,0,0,,قوتك ليست كافية للعثور على حجر الجليد
Dialogue: 0,0:33:46.03,0:33:48.16,general text,,0,0,0,,عندما حملت "بو يونغ" تحت قلبك،
Dialogue: 0,0:33:48.24,0:33:51.17,general text,,0,0,0,,أخذت الحجر من جينيونغ وأعطيته لتشانغ جانج...
Dialogue: 0,0:33:51.80,0:33:53.13,النص العام,,0,0,0,,لإنقاذ حياتها
Dialogue: 0,0:33:55.38,0:33:57.93,نص عام,,0,0,0,,كيف عرفت بهذا؟
Dialogue: 0,0:33:58.01,0:33:59.22,نص عام,,0,0,0,,لا داعي للخوف
Dialogue: 0,0:33:59.30,0:34:01.56,النص العام,,0,0,0,,أنا لا أحاول إدانتك بجرائم
Dialogue: 0,0:34:02.93,0:34:05.98,general text,,0,0,0,,أنا متأكد من أن تشانغ جانج أصر على ختم الحجر في مكان آخر.
Dialogue: 0,0:34:06.06,0:34:07.60,نص عام,,0,0,0,,لم يعيدها إليك
Dialogue: 0,0:34:08.52,0:34:11.15,نص عام,,0,0,0,,هل تعلم أين اختبأ...
Dialogue: 0,0:34:11.23,0:34:12.90,نص عام,,0,0,0,,حجر جليدي من جينيوون؟
Dialogue: 0,0:34:12.98,0:34:14.69,النص العام,,0,0,0,,وريثة جينيوون هنا،
Dialogue: 0,0:34:14.78,0:34:18.91,نص عام,,0,0,0,,لذلك سأعيد الحجر إلى مكانه
Dialogue: 0,0:34:20.03,0:34:22.45,نص عام,,0,0,0,,جين مو، أنت...
Dialogue: 0,0:34:22.54,0:34:23.45,خط مائل,,0,0,0,,أختي,
Dialogue: 0,0:34:23.54,0:34:25.37,نص عام,,0,0,0,,قلت للتو أنني سأعيده
Dialogue: 0,0:34:26.12,0:34:28.08,نص عام,,0,0,0,,لا تبحث عن صيد
Dialogue: 0,0:34:28.17,0:34:30.88,general text,,0,0,0,,اعتبر هذه هدية جاءت مع Boo Young
Dialogue: 0,0:34:30.96,0:34:34.59,النص العام,,0,0,0,,كل ما هو مطلوب هو قبولها مع الامتنان
Dialogue: 0,0:34:54.15,0:34:56.49,نص عام,,0,0,0,,يبدو أنك تسأل
Dialogue: 0,0:34:57.07,0:35:01.07,نص عام,,0,0,0,,اعترف بشكل أعمى لبو يونغ إذا كنت أريد الحصول على الحجر
Dialogue: 0,0:35:01.16,0:35:04.62,النص العام,,0,0,0,,تخلص من الشبهات والشكوك ثم تجد كل شيء
Dialogue: 0,0:35:05.70,0:35:09.12,نص عام,,0,0,0,,والحجر والابنة الضالة
Dialogue: 0,0:35:10.84,0:35:12.47,نص عام,,0,0,0,,ماذا تريد؟
Dialogue: 0,0:35:16.60,0:35:19.02,نص عام,,0,0,0,,لحماية حجر الجليد،
Dialogue: 0,0:35:19.64,0:35:21.77,نص عام,,0,0,0,,سحق سوسنوفي بور
Dialogue: 0,0:35:23.48,0:35:25.86,general text,,0,0,0,,هل تريدني أن أدمر سوسنوفي بور؟
Dialogue: 0,0:35:25.94,0:35:27.57,نص عام,,0,0,0,,انهيار سوسنوفي بور
Dialogue: 0,0:35:28.61,0:35:32.16,نص عام,,0,0,0,,سيسمح لنا بالاستيلاء على القوة الكاملة لحجر الجليد
Dialogue: 0,0:35:48.84,0:35:50.84,ذكريات بخط مائل,,0,0,0,,هل تتحدث عن كيمياء النفوس؟
Dialogue: 0,0:35:50.93,0:35:53.01,ذكريات,,0,0,0,,غابة الصنوبر منعت هذا السحر
Dialogue: 0,0:35:54.22,0:35:55.72,ذكريات,,0,0,0,,وإذا رفع الحظر
Dialogue: 0,0:35:55.81,0:35:57.81,ذكريات,,0,0,0,,وهل تسمح لك باستخدام حجر الجليد؟
Dialogue: 0,0:35:57.89,0:35:59.02,ذكريات,,0,0,0,,صاحب السمو،
Dialogue: 0,0:35:59.77,0:36:01.60,ذكريات,,0,0,0,,ماذا سيحدث حينها، ما رأيك؟
Dialogue: 0,0:36:04.48,0:36:06.32,نص عام,,0,0,0,,الحياة الأبدية؟
Dialogue: 0,0:36:13.03,0:36:15.45,general text,,0,0,0,,هل توقفت عملية التحجير؟
Dialogue: 0,0:36:15.53,0:36:17.99,نص عام,,0,0,0,,الآن يمكنه التنفس
Dialogue: 0,0:36:19.12,0:36:21.00,نص عام,,0,0,0,,وحرك أصابعك
Dialogue: 0,0:36:21.83,0:36:24.33,general text,,0,0,0,,كان المعلم "كان" ساحرًا يتمتع بخبرة واسعة
Dialogue: 0,0:36:25.13,0:36:27.34,النص العام,,0,0,0,,متى أصبح مهتماً بالسحر؟
Dialogue: 0,0:36:27.42,0:36:30.60,general text,,0,0,0,,إذا أخبرني جين مو أنني أستطيع تحريك الروح
Dialogue: 0,0:36:30.68,0:36:33.52,النص العام,,0,0,0,,في جسم شاب وجميل سأنقر
Dialogue: 0,0:36:35.69,0:36:39.61,نص عام,,0,0,0,,فقط أمزح. لكنني متأكد من أن الكثيرين سيقعون في حبها
Dialogue: 0,0:36:39.69,0:36:41.19,نص عام,,0,0,0,,الناس لا يتحدثون عنها علناً
Dialogue: 0,0:36:41.28,0:36:42.82,نص عام,,0,0,0,,فقط بسبب سوسنوفي بور
Dialogue: 0,0:36:44.78,0:36:47.70,نص عام,,0,0,0,,أولاً، جيونبوغوان والقصر
Dialogue: 0,0:36:47.78,0:36:52.08,general text,,0,0,0,,الآن، يبدو أن يدي جين مو قد وصلت إلى جينيوون
Dialogue: 0,0:36:52.16,0:36:53.29,نص عام,,0,0,0,,لكننا نستطيع
Dialogue: 0,0:36:53.37,0:36:56.71,نص عام,,0,0,0,,يثبت أنه استخدم كيمياء الروح
Dialogue: 0,0:36:56.79,0:36:59.09,النص العام,,0,0,0,,بمجرد استجوابنا للسيد خان،
Dialogue: 0,0:36:59.17,0:37:01.42,نص عام,,0,0,0,,يمكننا أخيرًا القبض على جين مو
Dialogue: 0,0:37:02.01,0:37:04.01,نص عام,,0,0,0,,إنه لا يخشى أن يتم القبض عليه
Dialogue: 0,0:37:04.88,0:37:06.68,general text,,0,0,0,,بالعكس يخطط لشيء ما من جديد
Dialogue: 0,0:37:08.14,0:37:10.22,خط مائل,,0,0,0,,لا أستطيع حتى أن أتخيل،
Dialogue: 0,0:37:10.89,0:37:13.35,نص عام,,0,0,0,,إلى أي مدى هو على استعداد للذهاب
Dialogue: 0,0:37:14.81,0:37:16.27,نص عام,,0,0,0,,وهذا يخيفني
Dialogue: 0,0:37:24.07,0:37:27.49,general text,,0,0,0,,لماذا يجب أن أذهب إلى جيونبوغوان هذه المرة؟
Dialogue: 0,0:37:27.57,0:37:30.62,general text,,0,0,0,,هل ستعاني مرة أخرى بسبب دودة أخرى؟
Dialogue: 0,0:37:30.70,0:37:32.70,نص عام,,0,0,0,,فقط افعل ما يقولونه
Dialogue: 0,0:37:34.66,0:37:37.92,نص عام,,0,0,0,,سيكون هناك الكثير من الناس هناك. انتبه لما تقوله وتفعله
Dialogue: 0,0:38:03.24,0:38:07.42,نص عام,,0,0,0,,اليوم سأريكم أخيراً
Dialogue: 0,0:38:09.08,0:38:10.84,نص عام,,0,0,0,,دانتشو الخاص بنا
Dialogue: 0,0:38:15.51,0:38:19.30,نص عام,,0,0,0,,تقدم وأظهر نفسك للجميع
Dialogue: 0,0:38:37.90,0:38:40.62,general text,,0,0,0,,دانزو لدينا ليست فقط أقوى كاهنة ديهو،
Dialogue: 0,0:38:40.70,0:38:43.79,نص عام,,0,0,0,,ولكن أيضًا الفصل المستقبلي من Jinyeowon. اسمها جين بو يونغ
Dialogue: 0,0:38:46.33,0:38:48.71,نص عام,,0,0,0,,الانحناء لدانتشو
Dialogue: 0,0:39:04.14,0:39:07.06,general text,,0,0,0,,سأستخدمه لكشف حجر الجليد للعالم
Dialogue: 0,0:39:08.36,0:39:10.24,general text,,0,0,0,,وبعد ذلك سأنقل روحي إلى جسدها
Dialogue: 0,0:39:10.91,0:39:14.03,النص العام,,0,0,0,,إذن يمكنني أن أكون بالقرب منك وأخدمك،
Dialogue: 0,0:39:15.12,0:39:16.37,نص عام,,0,0,0,,أختي
Dialogue: 0,0:39:31.34,0:39:34.89,general text,,0,0,0,,عقد رئيس جينيوون مجلسًا موحدًا
Dialogue: 0,0:39:34.97,0:39:36.97,general text,,0,0,0,,- ألم تناقش الأمر حتى مع سوسنوفي بور؟\N- نعم
Dialogue: 0,0:39:37.06,0:39:40.27,نص عام,,0,0,0,,أرسلت رسائل إلى جميع العائلات. إنهم يتجهون إلى هنا الآن
Dialogue: 0,0:39:43.81,0:39:44.98,خط مائل,,0,0,0,,ماذا هذه المرة...
Dialogue: 0,0:39:45.06,0:39:48.86,النص العام,,0,0,0,,هل سينجح جينيوون في ذلك؟
Dialogue: 0,0:39:54.37,0:39:58.49,general text,,0,0,0,,ابنها الآن في سيجوكون
Dialogue: 0,0:40:02.12,0:40:03.54,نص عام,,0,0,0,,لماذا الجميع هنا؟
Dialogue: 0,0:40:05.29,0:40:07.80,general text,,0,0,0,,عقد جينيوون مجلسًا موحدًا
Dialogue: 0,0:40:11.42,0:40:12.84,خط مائل,,0,0,0,,تشو يونغ هنا أيضًا
Dialogue: 0,0:40:13.59,0:40:16.22,مائل,,0,0,0,,الفتاة العمياء التي بجانبك هي بو يونغ؟
Dialogue: 0,0:40:17.35,0:40:18.31,نص عام,,0,0,0,,وأنا كذلك؟
Dialogue: 0,0:40:19.60,0:40:20.52,نص عام,,0,0,0,,نعم
Dialogue: 0,0:40:23.90,0:40:25.56,مائل,,0,0,0,,كل شيء يحدث بشكل أسرع مما كنا نعتقد
Dialogue: 0,0:40:25.65,0:40:28.16,general text,,0,0,0,,سوف يستخدمون بو يونغ المزيف،
Dialogue: 0,0:40:28.24,0:40:30.12,خط مائل,,0,0,0,,لفعل شيئًا اليوم
Dialogue: 0,0:40:38.42,0:40:40.67,نص عام,,0,0,0,,يجب أن يكون هذا جين بو يونغ
Dialogue: 0,0:41:08.87,0:41:11.29,خط مائل,,0,0,0,,رئيس جينيون دعا العائلة المالكة
Dialogue: 0,0:41:11.37,0:41:14.66,النص العام,,0,0,0,,وجيونبوغوان في المجلس الموحد
Dialogue: 0,0:41:14.75,0:41:16.37,نص عام,,0,0,0,,النصيحة الموحدة؟
Dialogue: 0,0:41:18.21,0:41:19.34,نص عام,,0,0,0,,لماذا؟
Dialogue: 0,0:41:19.42,0:41:21.34,نص عام,,0,0,0,,للإعلان عن قرار مهم،
Dialogue: 0,0:41:21.42,0:41:24.38,نص عام,,0,0,0,,الذي سيحدد مستقبل كل ديهو
Dialogue: 0,0:41:33.68,0:41:37.19,general text,,0,0,0,,لقد اندلعت فوضى حقيقية في العاصمة بسبب كثرة الحالات،
Dialogue: 0,0:41:37.27,0:41:39.31,نص عام,,0,0,0,,متعلق بالبدو الرحل,
Dialogue: 0,0:41:39.40,0:41:41.02,نص عام,,0,0,0,,رغم عودة ناك سو
Dialogue: 0,0:41:41.82,0:41:45.65,general text,,0,0,0,,لذا حاول جينيوون مساعدة سوسنوفي بور،
Dialogue: 0,0:41:45.74,0:41:47.58,نص عام,,0,0,0,,للبحث عن مصدر السحر
Dialogue: 0,0:41:48.71,0:41:49.67,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:41:51.21,0:41:54.01,النص العام,,0,0,0,,دعمنا كان أمراً مفروغاً منه
Dialogue: 0,0:41:55.01,0:41:59.97,نص عام,,0,0,0,,وطرح مطالب وطلبات غير معقولة بغطرسة
Dialogue: 0,0:42:02.14,0:42:05.43,مائل,,0,0,0,,لقد اقتحموا جينيوون بنفس الطريقة التي اقتحموا بها جيونبوغوان،
Dialogue: 0,0:42:05.52,0:42:08.73,خط مائل,,0,0,0,,مبررين أنفسهم بالقول إنهم يبحثون عن آثار السحر الأسود
Dialogue: 0,0:42:08.81,0:42:12.23,italics,,0,0,0,,وفضلاً عن ذلك، حاولوا استخدام آثار جينياوون،
Dialogue: 0,0:42:12.32,0:42:14.15,نص عام,,0,0,0,,للتحقق من جميع عائلات السحرة
Dialogue: 0,0:42:14.23,0:42:17.03,general text,,0,0,0,,وكأن كل من هو خارج أسوار سوسنوفي بور يلجأ إلى السحر
Dialogue: 0,0:42:18.96,0:42:20.07,خط مائل,,0,0,0,,علاوة على ذلك,
Dialogue: 0,0:42:20.16,0:42:24.08,نص عام,,0,0,0,,لقد أحضروا إحدى آثارنا إلى القصر
Dialogue: 0,0:42:24.58,0:42:26.58,general text,,0,0,0,,سوسنوفي بور لا تثق بنا؟
Dialogue: 0,0:42:26.66,0:42:28.00,خط مائل,,0,0,0,,هذا كثير جدًا
Dialogue: 0,0:42:31.83,0:42:33.71,مائل,,0,0,0,,الرئيس جين، لقد قمت بدعوة المجلس الموحد إلى الانعقاد،
Dialogue: 0,0:42:33.80,0:42:36.92,النص العام,,0,0,0,,التحدث والشكوى من سوسنوفي بور؟
Dialogue: 0,0:42:37.01,0:42:37.97,خط مائل,,0,0,0,,انظر بنفسك
Dialogue: 0,0:42:38.05,0:42:40.34,نص عام,,0,0,0,,حالما بدأت الحديث،
Dialogue: 0,0:42:40.43,0:42:42.30,النص العام,,0,0,0,,كيف يسارع فوراً لإسكاتي
Dialogue: 0,0:42:42.89,0:42:44.93,مائل,,0,0,0,,أنا، جين هو كيونغ، رئيس جينيوون
Dialogue: 0,0:42:45.01,0:42:49.77,general text,,0,0,0,,أريد أن أوقف هذا الغضب المزعوم أنه ملتزم بالبحث عن السحر الأسود
Dialogue: 0,0:42:49.85,0:42:52.48,general text,,0,0,0,,وبهذا أخالف القاعدة التي تم تقديمها منذ 200 عام،
Dialogue: 0,0:42:52.56,0:42:57.53,نص عام,,0,0,0,,ملاحظ حتى يومنا هذا. ولهذا السبب جمعتكم جميعا هنا
Dialogue: 0,0:43:01.28,0:43:02.20,نص عام,,0,0,0,,بو يونغ
Dialogue: 0,0:43:12.51,0:43:16.97,مائل,,0,0,0,,هذه جين بو يونغ، وريثة جينيونغ،
Dialogue: 0,0:43:17.06,0:43:18.43,نص عام,,0,0,0,,عودة بعد 10 سنوات
Dialogue: 0,0:43:22.02,0:43:23.27,خط مائل,,0,0,0,,سمعت أنها عثرت على ابنتها
Dialogue: 0,0:43:23.86,0:43:24.73,نص عام,,0,0,0,,على ما يبدو أن هذه هي
Dialogue: 0,0:43:28.48,0:43:31.53,مائل,,0,0,0,,لدي شيء لأريكم إياه، وابنتي
Dialogue: 0,0:43:31.61,0:43:34.20,نص عام,,0,0,0,,سوف يساعدني في هذا
Dialogue: 0,0:43:46.13,0:43:50.88,general text,,0,0,0,,كانت غابة الصنوبر تبحث عن حجر جليدي في كل مكان،
Dialogue: 0,0:43:50.97,0:43:52.88,نص عام,,0,0,0,,وهو مصدر كيمياء النفوس
Dialogue: 0,0:43:52.97,0:43:55.68,general text,,0,0,0,,ومع ذلك، طوال هذا الوقت، كان في جينيوون
Dialogue: 0,0:44:43.57,0:44:45.49,مائل,,0,0,0,,إذًا هذه هي خطة جين مو
Dialogue: 0,0:44:46.03,0:44:49.33,النص العام,,0,0,0,,استخدم جينيوون لتقديم حجر الجليد إلى العالم
Dialogue: 0,0:44:49.41,0:44:50.91,نص عام,,0,0,0,,هذه مجرد البداية
Dialogue: 0,0:44:51.83,0:44:55.29,general text,,0,0,0,,سيحاول المشبوهون تحريك النفوس
Dialogue: 0,0:44:58.21,0:44:59.38,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:45:00.00,0:45:01.00,نص عام,,0,0,0,,أنت لا تفهم؟
Dialogue: 0,0:45:01.59,0:45:04.30,general text,,0,0,0,,الملكة كان لديها حجر الجليد، لكنه الآن مع جينيوون
Dialogue: 0,0:45:04.38,0:45:06.26,general text,,0,0,0,,إذن الشامان تشوي سيترك جسد الملكة
Dialogue: 0,0:45:07.34,0:45:09.51,مائل,,0,0,0,,وسينتقل إلى جسد شخص من جينيوون
Dialogue: 0,0:45:12.31,0:45:14.18,نص عام,,0,0,0,,سوف تغادر جسد الملكة
Dialogue: 0,0:45:16.02,0:45:19.73,general text,,0,0,0,,وسيهاجر إلى جسد رئيس جينيوون المستقبلي،
Dialogue: 0,0:45:21.02,0:45:22.48,نص عام,,0,0,0,,استخدام كيمياء الروح
Dialogue: 0,0:45:35.50,0:45:37.21,خط مائل,,0,0,0,,الأول جميل جدًا
Dialogue: 0,0:45:37.92,0:45:39.33,نص عام,,0,0,0,,انعقد مجلس موحد كما يقولون
Dialogue: 0,0:45:39.42,0:45:41.88,نص عام,,0,0,0,,سيتحدثون عن البدو
Dialogue: 0,0:45:41.96,0:45:43.67,نص عام,,0,0,0,,على ما يبدو
Dialogue: 0,0:45:44.80,0:45:47.64,نص عام,,0,0,0,,لا تشتري المجوهرات غير الضرورية. من الأفضل أن تأخذ الذهب
Dialogue: 0,0:45:47.73,0:45:50.23,النص العام,,0,0,0,,في الأوقات المظلمة، لا يمكنك إلا أن تأمل الذهب
Dialogue: 0,0:45:50.31,0:45:53.15,النص العام,,0,0,0,,سيكون هناك الكثير من العمل الذي يجب القيام به عندما ينتهي المجلس
Dialogue: 0,0:45:53.23,0:45:54.07,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:45:54.15,0:45:56.57,general text,,0,0,0,,سوف ينتهون وسيذهب الجميع للشرب على الفور
Dialogue: 0,0:45:56.65,0:45:59.32,general text,,0,0,0,,- سيخبر الناس أشياء سيئة عن سوسنوفي بور\N-{\i1} مرحبًا{\i0}
Dialogue: 0,0:45:59.41,0:46:01.95,نص عام,,0,0,0,,توقف عن تجربة كل شيء، اشتريه بالفعل
Dialogue: 0,0:46:02.03,0:46:04.54,نص عام,,0,0,0,,ما بك؟ امنحها الوقت
Dialogue: 0,0:46:04.62,0:46:06.08,خط مائل,,0,0,0,,أريد شراء كل شيء
Dialogue: 0,0:46:06.16,0:46:08.16,مائل,,0,0,0,,- دعني أحاول\N- هذه؟
Dialogue: 0,0:46:12.84,0:46:15.42,نص عام,,0,0,0,,الجميع في العاصمة يتحدثون فقط عن المجلس الموحد
Dialogue: 0,0:46:15.50,0:46:17.30,نص عام,,0,0,0,,نعم عن العائلة المالكة
Dialogue: 0,0:46:18.30,0:46:21.51,النص العام,,0,0,0,,سيعود بسبب كل هذه الضجة
Dialogue: 0,0:46:22.97,0:46:24.72,نص عام,,0,0,0,,هل تتحدث عن السيد تشان؟
Dialogue: 0,0:46:25.85,0:46:30.23,النص العام,,0,0,0,,أعتقد أيضًا أنه من الغريب أن يسألني دان جو
Dialogue: 0,0:46:30.31,0:46:32.02,نص عام,,0,0,0,,عن السيد تشانغ غان
Dialogue: 0,0:46:32.10,0:46:35.65,general text,,0,0,0,,يبدو أن رئيس سوسنوفي بور ينتظر ظهوره.
Dialogue: 0,0:46:43.24,0:46:44.91,نص عام,,0,0,0,,خذ هذا
Dialogue: 0,0:46:44.99,0:46:46.79,مائل,,0,0,0,,أعط "تشانغ غون" عندما يظهر
Dialogue: 0,0:46:47.75,0:46:48.83,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:46:49.66,0:46:50.79,نص عام,,0,0,0,,هل يمكنني رؤيته؟
Dialogue: 0,0:47:01.68,0:47:03.14,نص عام,,0,0,0,,فارغ على الفور
Dialogue: 0,0:47:03.22,0:47:07.02,general text,,0,0,0,,هل استخدمت نفس التعويذة المستخدمة في "كلمات القلب"؟
Dialogue: 0,0:47:09.07,0:47:12.61,النص العام,,0,0,0,,عندما يقرأها تشانغ جانج، سيفعل ما يقوله
Dialogue: 0,0:47:19.04,0:47:23.42,general text,,0,0,0,,بالمناسبة، ألا تحتاج إلى حضور المجلس؟
Dialogue: 0,0:47:24.00,0:47:26.09,نص عام,,0,0,0,,أنا تلميذة للمعلمة سيو كيونغ
Dialogue: 0,0:47:27.59,0:47:29.17,نص عام,,0,0,0,,إذا ذهبت إلى هناك،
Dialogue: 0,0:47:29.26,0:47:34.22,general text,,0,0,0,,لا أستطيع أن أؤيد أو أدين تصرفات أستاذي
Dialogue: 0,0:47:40.31,0:47:44.52,مائل,,0,0,0,,إذًا احتفظ المعلم سو كيونغ بحجر الجليد؟
Dialogue: 0,0:47:44.60,0:47:46.98,مائل,,0,0,0,,اعتقدت أنه دمرهم جميعًا
Dialogue: 0,0:47:47.06,0:47:48.77,general text,,0,0,0,,هل علم سوسنوفي بور بهذا الأمر؟
Dialogue: 0,0:47:48.86,0:47:51.11,general text,,0,0,0,,إذا كان الأمر كذلك، فكل ما فعلته سوسنوفي بور،
Dialogue: 0,0:47:51.19,0:47:54.16,النص العام,,0,0,0,,تبريره كلام المعلمة سو كيونغ، خداع؟
Dialogue: 0,0:47:54.24,0:47:56.74,general text,,0,0,0,,- هراء!\N-{\i1} نعم، هذه عملية احتيال حقيقية{\i0}
Dialogue: 0,0:47:56.82,0:47:58.78,italics,,0,0,0,,لقد تم إدخال العديد من القواعد لعائلات السحرة،
Dialogue: 0,0:47:58.87,0:48:01.37,نص عام,,0,0,0,,يشرح كل شيء بالقول أن السحر الأسود مراقب
Dialogue: 0,0:48:01.45,0:48:02.66,نص عام,,0,0,0,,هل أنا مخطئ؟
Dialogue: 0,0:48:02.75,0:48:05.00,نص عام,,0,0,0,,- بالضبط\N- كل شيء صحيح
Dialogue: 0,0:48:05.08,0:48:07.00,مائل,,0,0,0,,غابة الصنوبر قادتنا من أنفنا؟
Dialogue: 0,0:48:07.08,0:48:08.42,نص عام,,0,0,0,,هل نحن مخدوعون؟
Dialogue: 0,0:48:08.50,0:48:10.88,italics,,0,0,0,,- هل تم خداعك حقًا؟\N{\i0}- اهدأ!
Dialogue: 0,0:48:12.42,0:48:13.63,النص العام,,0,0,0,,لم يشك سحرتنا...
Dialogue: 0,0:48:13.72,0:48:17.60,نص عام,,0,0,0,,أن حجر الجليد محفوظ في جينيوون
Dialogue: 0,0:48:18.30,0:48:20.35,خط مائل,,0,0,0,,لا نريد أن نستمع إلى أعذارك
Dialogue: 0,0:48:20.43,0:48:21.77,نص عام,,0,0,0,,علينا أن نقرر ما هو التالي
Dialogue: 0,0:48:21.85,0:48:25.70,نص عام,,0,0,0,,افعل بالحجر الذي بقي
Dialogue: 0,0:48:25.78,0:48:28.82,نص عام,,0,0,0,,يجب تدميره. وهذا هو مصدر السحر
Dialogue: 0,0:48:29.33,0:48:31.20,النص العام,,0,0,0,,هذا ما ورثه المعلم سو كيونغ
Dialogue: 0,0:48:31.95,0:48:33.45,النص العام,,0,0,0,,يجب أن نهدم الحجر...
Dialogue: 0,0:48:34.29,0:48:36.46,نص عام,,0,0,0,,أمام جميع الحاضرين
Dialogue: 0,0:48:36.96,0:48:39.79,general text,,0,0,0,,هو نفسه ترك حجر الجليد في جينيوون
Dialogue: 0,0:48:39.88,0:48:42.71,general text,,0,0,0,,دعونا نتبع قراره ونترك الحجر هناك
Dialogue: 0,0:48:42.80,0:48:46.09,النص العام,,0,0,0,,فلا داعي لإحضاره هنا
Dialogue: 0,0:48:46.18,0:48:49.68,مائل,,0,0,0,,كيف يمكنك الجلوس ساكناً الآن بعد أن أظهرت للجميع وجوده؟
Dialogue: 0,0:48:49.76,0:48:52.56,general text,,0,0,0,,هل تحاول أن تجعل سوسنوفي بور أضحوكة؟
Dialogue: 0,0:48:52.64,0:48:55.43,نص عام,,0,0,0,,رئيس جينيوون يقول كل شيء
Dialogue: 0,0:48:55.52,0:48:56.98,النص العام,,0,0,0,,إنها تتبع إرادة السيد،
Dialogue: 0,0:48:57.06,0:48:59.10,نص عام,,0,0,0,,ما تركه حجر الجليد في جينيوون
Dialogue: 0,0:48:59.19,0:49:03.90,general text,,0,0,0,,لم يعد لسوسنوفي بور الحق في إخبارنا بما يجب فعله بحجر الجليد
Dialogue: 0,0:49:03.98,0:49:07.74,نص عام,,0,0,0,,فاحشة! هل لم تعد تهتم برأي سوسنوفي بور؟
Dialogue: 0,0:49:08.32,0:49:09.91,نص عام,,0,0,0,,لقد جئنا هنا للمناقشة...
Dialogue: 0,0:49:09.99,0:49:12.83,نص عام,,0,0,0,,كيفية استخدام الحجر بناء على وصية المعلم سيو كيونغ
Dialogue: 0,0:49:12.91,0:49:15.29,النص العام,,0,0,0,,إذا لم يعجب سوسنوفي بور بشيء ما، فارحل
Dialogue: 0,0:49:15.37,0:49:16.91,خط مائل,,0,0,0,,- أنت على حق\N - بالضبط
Dialogue: 0,0:49:17.00,0:49:19.33,مائل,,0,0,0,,لقد كذبت علينا، لذا ليس من حقك أن تقرر الآن
Dialogue: 0,0:49:19.42,0:49:22.09,خط مائل,,0,0,0,,- بالضبط، ليس لديك حق التصويت\N- لا تتدخل
Dialogue: 0,0:49:22.17,0:49:23.38,مائل,,0,0,0,,إذا كنت ضد ذلك، فارحل
Dialogue: 0,0:49:23.46,0:49:25.84,خط مائل,,0,0,0,,- فقط ارحل!\N- اخرج!
Dialogue: 0,0:49:25.92,0:49:27.30,خلف الكواليس,,0,0,0,,لهذا السبب جين مو...
Dialogue: 0,0:49:27.38,0:49:30.64,خارج الإطار,,0,0,0,,أظهر حجر الجليد للجميع
Dialogue: 0,0:49:30.72,0:49:33.64,general text,,0,0,0,,الآن رأي سوسنوفي بور غير مبرر،
Dialogue: 0,0:49:33.72,0:49:36.10,خط مائل,,0,0,0,,لا أحد يريد الاستماع إليهم
Dialogue: 0,0:49:43.15,0:49:44.48,خط مائل,,0,0,0,,ماذا تفعل هناك؟
Dialogue: 0,0:49:45.08,0:49:46.33,خط مائل,,0,0,0,,إذا سوسنوفي بور
Dialogue: 0,0:49:46.41,0:49:49.04,مائل,,0,0,0,,ضد الحجر المتبقي في جينيون،
Dialogue: 0,0:49:49.58,0:49:52.63,general text,,0,0,0,,هل نعطيه لطرف ثالث للتخزين؟
Dialogue: 0,0:49:53.59,0:49:54.96,نص عام,,0,0,0,,هذا هو اقتراحي
Dialogue: 0,0:49:55.05,0:49:56.96,general text,,0,0,0,,هل ننقله إلى جيسان؟
Dialogue: 0,0:49:57.55,0:49:59.38,نص عام,,0,0,0,,ما هذا الهراء؟
Dialogue: 0,0:49:59.47,0:50:01.34,general text,,0,0,0,,لماذا يذهب هذا مباشرة إلى جيسان؟
Dialogue: 0,0:50:01.43,0:50:03.10,general text,,0,0,0,,أنت وعائلتك سحرة من المستوى المنخفض!
Dialogue: 0,0:50:03.18,0:50:04.14,نص عام,,0,0,0,,ماذا قلت؟
Dialogue: 0,0:50:04.22,0:50:07.02,general text,,0,0,0,,ليس لعائلتك الحق في الاحتفاظ بحجر الجليد
Dialogue: 0,0:50:07.10,0:50:09.02,general text,,0,0,0,,- نحن ضد\N- أليس لنا الحق؟
Dialogue: 0,0:50:09.60,0:50:12.81,النص العام,,0,0,0,,عائلتنا هي الأقدم في ديهو
Dialogue: 0,0:50:12.90,0:50:15.15,النص العام,,0,0,0,,لدينا كافة الحقوق لحماية حجر الجليد
Dialogue: 0,0:50:15.23,0:50:17.32,نص عام,,0,0,0,,أين تسحب يديك؟
Dialogue: 0,0:50:17.40,0:50:20.03,general text,,0,0,0,,-هل تبحث عن قتال؟ \N- وأنا!
Dialogue: 0,0:50:20.11,0:50:22.57,مائل,,0,0,0,,- ماذا تفعل؟\N- انتبه إلى لغتك
Dialogue: 0,0:50:23.16,0:50:25.16,خط مائل,,0,0,0,,من تظن نفسك؟
Dialogue: 0,0:50:25.24,0:50:27.29,نص عام,,0,0,0,,موريل صغير!
Dialogue: 0,0:50:27.37,0:50:28.83,النص العام,,0,0,0,,هل أنا الموريل؟
Dialogue: 0,0:50:28.91,0:50:30.33,نص عام,,0,0,0,,توقف!
Dialogue: 0,0:50:30.41,0:50:31.37,نص عام,,0,0,0,,ابتعد عن الطريق!
Dialogue: 0,0:50:35.34,0:50:37.50,نص عام,,0,0,0,,اضربني؟
Dialogue: 0,0:50:37.59,0:50:39.63,خط مائل,,0,0,0,,اللعنة عليك أيها الرجل العجوز!
Dialogue: 0,0:50:41.47,0:50:42.80,نص عام,,0,0,0,,يا لك...
Dialogue: 0,0:50:42.89,0:50:45.35,النص العام,,0,0,0,,ارفع يديك عني أيها الغبي!
Dialogue: 0,0:50:49.31,0:50:50.48,النص العام,,0,0,0,,هل تصوب نحوي؟
Dialogue: 0,0:50:50.56,0:50:52.81,نص عام,,0,0,0,,ممتاز. هيا، الهجوم
Dialogue: 0,0:50:55.06,0:50:55.98,خط مائل,,0,0,0,,أنت...
Dialogue: 0,0:50:56.07,0:50:58.19,نص عام,,0,0,0,,هل تعتقد أنني لا أستطيع؟
Dialogue: 0,0:50:58.28,0:50:59.65,النص العام,,0,0,0,,كما تبدو وقحًا
Dialogue: 0,0:50:59.74,0:51:01.74,general text,,0,0,0,,من ستصدر بقرتها الخوار!
Dialogue: 0,0:51:02.57,0:51:04.83,مائل,,0,0,0,,الجد في المجلس الموحد؟
Dialogue: 0,0:51:04.92,0:51:05.75,خط مائل,,0,0,0,,نعم
Dialogue: 0,0:51:06.34,0:51:09.42,نص عام,,0,0,0,,لم أجد الكتاب المدرسي الذي طلبته في جيونجينغاك
Dialogue: 0,0:51:10.17,0:51:12.34,نص عام,,0,0,0,,سأذهب إلى هناك وأبحث عنه بنفسي
Dialogue: 0,0:51:13.55,0:51:15.72,نص عام,,0,0,0,,المجلس يناقش أمراً مهماً ربما
Dialogue: 0,0:51:15.80,0:51:18.68,النص العام,,0,0,0,,ذهب جميع سحرة سيجوكون إلى هناك
Dialogue: 0,0:51:22.60,0:51:26.11,نص عام,,0,0,0,,قالوا ابني مازال على قيد الحياة
Dialogue: 0,0:51:51.30,0:51:52.38,نص عام,,0,0,0,,جي هو...
Dialogue: 0,0:52:11.40,0:52:12.74,نص عام,,0,0,0,,أنت على قيد الحياة
Dialogue: 0,0:52:21.45,0:52:22.49,نص عام,,0,0,0,,جي هو؟
Dialogue: 0,0:52:49.49,0:52:51.58,نص عام,,0,0,0,,اهدأ واجلس!
Dialogue: 0,0:52:55.00,0:52:56.37,نص عام,,0,0,0,,حان الوقت
Dialogue: 0,0:52:56.46,0:52:59.21,general text,,0,0,0,,حان الوقت لجين هو كيونغ للتدخل وحل الخلاف
Dialogue: 0,0:53:08.59,0:53:11.68,نص عام,,0,0,0,,كفى!
Dialogue: 0,0:53:14.06,0:53:16.60,مائل,,0,0,0,,- سأتعامل معك لاحقاً!\N- حسناً، هيا!
Dialogue: 0,0:53:16.68,0:53:18.23,خط مائل,,0,0,0,,اعتبر نفسك محظوظًا
Dialogue: 0,0:53:19.02,0:53:19.90,خط مائل,,0,0,0,,سأستمر
Dialogue: 0,0:53:21.10,0:53:23.02,نص عام,,0,0,0,,بناءً على الرأي العام،
Dialogue: 0,0:53:23.11,0:53:25.15,نص عام,,0,0,0,,من الأفضل أن نستخدم حجر الجليد
Dialogue: 0,0:53:25.23,0:53:29.20,نص عام,,0,0,0,,لمصلحة جميع الحاضرين
Dialogue: 0,0:53:30.41,0:53:31.49,خط مائل,,0,0,0,,لذلك أنا,
Dialogue: 0,0:53:31.57,0:53:36.12,general text,,0,0,0,,جين هو كيونغ، رئيس جينيوون، أود أن أقترح ما يلي
Dialogue: 0,0:53:36.20,0:53:39.58,النص العام,,0,0,0,,من الآن فصاعدا حق انعقاد المجلس الموحد
Dialogue: 0,0:53:40.25,0:53:44.18,general text,,0,0,0,,جينيوون، وليس سوسنوفي بور، سيكون لديه
Dialogue: 0,0:53:49.23,0:53:51.94,مائل,,0,0,0,,إذا وافق الجميع على هذا الاقتراح،
Dialogue: 0,0:53:52.02,0:53:53.86,نص عام,,0,0,0,,سننتهي هنا
Dialogue: 0,0:53:53.94,0:53:57.53,general text,,0,0,0,,الآن ستجري جينيوون كل المناقشات المتعلقة بالحجر،
Dialogue: 0,0:53:58.40,0:54:00.95,نص عام,,0,0,0,,ليس سوسنوفى بور
Dialogue: 0,0:54:06.66,0:54:08.16,مائل,,0,0,0,,سأعتبر هذا بمثابة اتفاق
الحوار: 0,0:54:08.25,0:54:10.00,نص عام,,0,0,0,,وسأختتم اجتماع اليوم
Dialogue: 0,0:54:11.87,0:54:15.25,نص عام,,0,0,0,,حجر الجليد سيبقى في جينيوون
Dialogue: 0,0:54:16.46,0:54:18.01,نص عام,,0,0,0,,يجب أن نهدم الحجر
Dialogue: 0,0:54:18.92,0:54:22.97,نص عام,,0,0,0,,بهذه الطريقة سنمنع الخلافات المستقبلية
Dialogue: 0,0:54:23.05,0:54:25.51,general text,,0,0,0,,ما الذي يمنحك الحق في اتخاذ مثل هذا القرار؟
Dialogue: 0,0:54:25.60,0:54:26.93,نص عام,,0,0,0,,جميع الحاضرين ضد
Dialogue: 0,0:54:27.01,0:54:30.06,نص عام,,0,0,0,,تم تسجيل حالة من كيمياء الروح
Dialogue: 0,0:54:30.14,0:54:32.52,النص العام,,0,0,0,,وكل ذلك بسبب العاكسات المصنوعة من الحجر
Dialogue: 0,0:54:32.60,0:54:34.73,general text,,0,0,0,,في البداية شككوا في جيونبوغوان والعائلة المالكة.
Dialogue: 0,0:54:34.81,0:54:37.15,نص عام,,0,0,0,,الآن افعل الشيء نفسه مع جينيوون
Dialogue: 0,0:54:38.73,0:54:42.03,نص عام,,0,0,0,,لن أترك المجلس الموحد ينتهي هكذا
Dialogue: 0,0:54:43.57,0:54:44.74,نص عام,,0,0,0,,فصل جين,
Dialogue: 0,0:54:44.82,0:54:50.83,النص العام,,0,0,0,,أمنعك من إخراج حجر الجليد من سوسنوفي بور
Dialogue: 0,0:54:50.91,0:54:54.04,general text,,0,0,0,,هل ستذهب ضد الجميع؟
Dialogue: 0,0:54:54.12,0:54:55.50,نص عام,,0,0,0,,لا أحد
Dialogue: 0,0:54:56.67,0:54:59.05,النص العام,,0,0,0,,لن تأخذ حجر الجليد من سوسنوفي بور
Dialogue: 0,0:55:08.23,0:55:09.65,مائل,,0,0,0,,سوف نستخدم القوة ضد أي شخص،
Dialogue: 0,0:55:11.07,0:55:13.28,نص عام,,0,0,0,,من سيحاول القيام بذلك
Dialogue: 0,0:55:17.24,0:55:19.28,نص عام,,0,0,0,,ثم ستبدأ الحرب
Dialogue: 0,0:55:27.58,0:55:29.29,نص عام,,0,0,0,,لقد وصل الوضع إلى ذروته
Dialogue: 0,0:55:29.38,0:55:31.21,النص العام,,0,0,0,,جلالة الملك عليك التدخل
Dialogue: 0,0:55:31.92,0:55:34.26,نص عام,,0,0,0,,السيد لي كان على حق
Dialogue: 0,0:55:34.34,0:55:37.05,ذكريات,,0,0,0,,أراد الجميع الحصول على الحجر، فبدأ القتال
Dialogue: 0,0:55:37.14,0:55:38.72,ذكريات,,0,0,0,,لهذا السبب تم تدمير الحجارة
Dialogue: 0,0:55:40.68,0:55:42.60,مائل,,0,0,0,,الجميع يتقاتلون على حجر
Dialogue: 0,0:55:43.27,0:55:44.48,خط مائل,,0,0,0,,نجم الملك...
Dialogue: 0,0:55:44.56,0:55:46.90,نص عام,,0,0,0,,صحيح أيضًا
Dialogue: 0,0:56:31.53,0:56:34.41,نص عام,,0,0,0,,أرى كل أساتذتي السابقين هنا
Dialogue: 0,0:56:35.20,0:56:38.04,نص عام,,0,0,0,,دع تلميذك السابق يرحب بك
Dialogue: 0,0:56:39.00,0:56:40.75,مائل,,0,0,0,,من هذا الشاب؟
Dialogue: 0,0:56:40.83,0:56:42.09,خط مائل,,0,0,0,,هذا تشان ووك
Dialogue: 0,0:56:42.17,0:56:44.96,النص العام,,0,0,0,,جاهل من عائلة تشان. وكان أيضا تلميذي
Dialogue: 0,0:56:45.84,0:56:48.26,italics,,0,0,0,,إذا لم أكن مرتبكًا، فعائلتك حاولت تعليمه
Dialogue: 0,0:56:48.88,0:56:51.30,نص عام,,0,0,0,,بالضبط. وهرب بعد ثلاثة أيام
Dialogue: 0,0:56:51.39,0:56:54.51,نص عام,,0,0,0,,آسف على مقاطعة مناقشتك العاطفية
Dialogue: 0,0:56:55.10,0:56:57.85,خط مائل,,0,0,0,,قرع الطبل
Dialogue: 0,0:57:00.60,0:57:03.36,general text,,0,0,0,,- هل أوقفه؟\N- دعه يتكلم
Dialogue: 0,0:57:03.94,0:57:06.99,general text,,0,0,0,,تمكن من وقف معاركهم
Dialogue: 0,0:57:07.69,0:57:09.32,نص عام,,0,0,0,,تشانغ ووك، ابن تشانغ جانج
Dialogue: 0,0:57:11.41,0:57:14.49,نص عام,,0,0,0,,آمل أن يكون لديك سبب وجيه للتبجح بهذه الطريقة.
Dialogue: 0,0:57:14.58,0:57:16.83,نص عام,,0,0,0,,قبل جلالته
Dialogue: 0,0:57:21.04,0:57:23.46,general text,,0,0,0,,لقد جئت لأعلن وصية المعلمة سو كيونغ
Dialogue: 0,0:57:34.64,0:57:37.10,نص عام,,0,0,0,,كشفت له عن النوايا الحقيقية للمعلم
Dialogue: 0,0:57:37.18,0:57:38.93,نص عام,,0,0,0,,أتمنى أن يتصرف بحكمة
Dialogue: 0,0:57:45.03,0:57:48.66,general text,,0,0,0,,أنا أتحدث نيابة عن المعلم لي، أحد طلاب سو كيونغ
Dialogue: 0,0:57:48.75,0:57:51.04,نص عام,,0,0,0,,لذا آمل أن يظهر الجميع الاحترام...
Dialogue: 0,0:57:51.12,0:57:53.00,نص عام,,0,0,0,,واستمع إلى وصية السيد سو
Dialogue: 0,0:58:01.68,0:58:03.76,نص عام,,0,0,0,,بحسب المعلم لي،
Dialogue: 0,0:58:03.84,0:58:06.30,نص عام,,0,0,0,,وصية السيد سيو كيونغ بخصوص الحجر
Dialogue: 0,0:58:06.39,0:58:08.10,نص عام,,0,0,0,,مكتوب في “كلمات من القلب”
Dialogue: 0,0:58:10.60,0:58:12.98,general text,,0,0,0,,وذكر هناك لماذا لم يحطم الحجر،
Dialogue: 0,0:58:13.06,0:58:15.65,نص عام,,0,0,0,,وتركت الكتاب لجميع السحرة ليعلم الجميع
Dialogue: 0,0:58:15.73,0:58:18.94,نص عام,,0,0,0,,غابة الصنوبر لم تخفي شيئاً
Dialogue: 0,0:58:22.07,0:58:25.57,general text,,0,0,0,,أغلب الحاضرين يقرأون "كلمات من القلب"
Dialogue: 0,0:58:26.07,0:58:29.79,general text,,0,0,0,,واجبنا هو العثور على إرادة المعلمة سو كيونغ في الكتاب
Dialogue: 0,0:58:32.62,0:58:34.29,نص عام,,0,0,0,,هل تتذكر ما كان يدور حوله؟
Dialogue: 0,0:58:34.37,0:58:37.04,نص عام,,0,0,0,,لا، قرأته منذ زمن طويل
Dialogue: 0,0:58:37.13,0:58:38.80,مائل,,0,0,0,,هل تريد أن تقول في هذه القصيدة...
Dialogue: 0,0:58:38.88,0:58:40.92,general text,,0,0,0,,كتب لماذا ترك الحجر؟
Dialogue: 0,0:58:42.72,0:58:43.80,نص عام,,0,0,0,,صحيح
Dialogue: 0,0:58:43.88,0:58:47.47,general text,,0,0,0,,قيل لي أن الجميع يتبع مسلمات المعلمة سو كيونغ.
Dialogue: 0,0:58:47.55,0:58:50.02,general text,,0,0,0,,لذا لا داعي للجدال حول حجر الجليد،
Dialogue: 0,0:58:50.10,0:58:52.35,نص عام,,0,0,0,,وحول معنى "كلام القلب"
Dialogue: 0,0:58:52.43,0:58:55.56,general text,,0,0,0,,أين "كلمات القلب" التي يتحدث عنها؟
Dialogue: 0,0:58:56.27,0:58:58.06,general text,,0,0,0,,تم حفظ هذه القصيدة في سوسنوفي بور،
Dialogue: 0,0:58:58.15,0:59:02.04,نص عام,,0,0,0,,ولكن بأمر من السيد لي، أرسلناها مؤخرًا إلى جينيوون
Dialogue: 0,0:59:03.75,0:59:06.33,نص عام,,0,0,0,,محفوظ في جينيوون
Dialogue: 0,0:59:06.42,0:59:08.54,نص عام,,0,0,0,,ثم أحضر الكتاب هنا
Dialogue: 0,0:59:10.67,0:59:11.84,نص عام,,0,0,0,,نعم
Dialogue: 0,0:59:20.26,0:59:21.93,النص العام,,0,0,0,,أنا جين تشو يونغ من جينيونغ
Dialogue: 0,0:59:22.72,0:59:24.60,النص العام,,0,0,0,,سأحضر "كلمات من القلب"
Dialogue: 0,0:59:25.27,0:59:27.02,نص عام,,0,0,0,,الكتاب كان موجوداً لدينا سابقاً،
Dialogue: 0,0:59:27.10,0:59:29.27,نص عام,,0,0,0,,سأرسل أحداً أيضاً
Dialogue: 0,0:59:30.02,0:59:32.57,النص العام,,0,0,0,,باك دان جو، اذهب معها
Dialogue: 0,0:59:38.49,0:59:39.66,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:59:55.55,0:59:56.68,نص عام,,0,0,0,,لقد كنت منذ زمن طويل
Dialogue: 0,0:59:57.59,1:00:01.35,نص عام,,0,0,0,"كلمات من القلب" لم تُعاد قراءتها
Dialogue: 0,1:00:01.43,1:00:03.56,نص عام,,0,0,0,,هل يمكنك أن تذكرني بموضوع الأمر؟
Dialogue: 0,1:00:03.64,1:00:05.85,نص عام,,0,0,0,,مجرد قصيدة قصيرة
Dialogue: 0,1:00:07.06,1:00:09.48,general text,,0,0,0,,اتضح أن المملكة المتحدة تكذب؟
Dialogue: 0,1:00:09.56,1:00:11.65,نص عام,,0,0,0,,لا يذكر شيئًا عن حجر الجليد
Dialogue: 0,1:00:12.40,1:00:16.49,general text,,0,0,0,,لا أفهم لماذا بدأ فجأة بالحديث عن "كلمات من القلب"
Dialogue: 0,1:00:19.53,1:00:22.04,نص عام,,0,0,0,,ماذا تحتوي "كلمات القلب" هذه؟
Dialogue: 0,1:00:22.13,1:00:23.50,نص عام,,0,0,0,,لا أعرف أيضًا
Dialogue: 0,1:00:24.59,1:00:28.38,نص عام,,0,0,0,,أعتقد أنه يخادع. يريد شراء الوقت
Dialogue: 0,1:00:28.93,1:00:31.22,نص عام,,0,0,0,,لكن هذا الكتاب كتبه سيو كيونغ نفسه
Dialogue: 0,1:00:31.93,1:00:34.64,النص العام,,0,0,0,,كنا على وشك تقويض الثقة في سوسنوفي بور
Dialogue: 0,1:00:34.72,1:00:37.06,النص العام,,0,0,0,,ماذا لو تحول كل شيء إلى عبث؟
Dialogue: 0,1:00:39.69,1:00:42.94,نص عام,,0,0,0,,سيدتي، يبدو أنهم غاضبون
Dialogue: 0,1:00:43.02,1:00:45.19,نص عام,,0,0,0,,وقريباً سيتفاجئون جداً
Dialogue: 0,1:00:46.07,1:00:47.28,نص عام,,0,0,0,,لكن لهذا
Dialogue: 0,1:00:48.28,1:00:49.53,نص عام,,0,0,0,,أحتاج إلى مساعدته
Dialogue: 0,1:01:02.29,1:01:04.50,نص عام,,0,0,0,,إنها مجرد قصيدة
Dialogue: 0,1:01:05.59,1:01:07.46,نص عام,,0,0,0,,هل هناك معنى خفي فيه؟
Dialogue: 0,1:01:08.88,1:01:10.05,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,1:01:11.09,1:01:13.76,تعليق صوتي,,0,0,0,,ربما استخدم الكتاب لكسب الوقت
Dialogue: 0,1:01:14.39,1:01:16.35,خلف الكواليس,,0,0,0,,إذا كان هذا هو الحال،
Dialogue: 0,1:01:16.85,1:01:18.64,التعليق الصوتي,,0,0,0,,أريد مساعدته
Dialogue: 0,1:01:19.31,1:01:20.27,نص عام,,0,0,0,,فلنسرع
Dialogue: 0,1:01:20.94,1:01:22.10,نص عام,,0,0,0,,انتظر...
Dialogue: 0,1:01:22.19,1:01:25.02,نص عام,,0,0,0,,أنا جائع جدًا. هل هناك أي شيء للأكل هنا؟
Dialogue: 0,1:01:26.11,1:01:27.82,نص عام,,0,0,0,,لم يكن لدي الوقت حتى لتناول وجبة الإفطار
Dialogue: 0,1:01:28.49,1:01:31.74,general text,,0,0,0,,هل تحاول عمدا شراء الوقت لسوسنوفي بور؟
Dialogue: 0,1:01:34.82,1:01:37.74,general text,,0,0,0,,هل تريد العودة ومشاهدة الجميع يصابون بالجنون مرة أخرى؟
Dialogue: 0,1:01:37.83,1:01:39.87,نص عام,,0,0,0,,ليس لدي وقت للتجادل
Dialogue: 0,1:01:39.95,1:01:41.47,نص عام,,0,0,0,,الأم والأخت ينتظران
Dialogue: 0,1:01:42.30,1:01:43.76,نص عام,,0,0,0,,تشو يونغ
Dialogue: 0,1:01:45.30,1:01:46.81,نص عام,,0,0,0,,هل أنت متأكد،
Dialogue: 0,1:01:47.85,1:01:49.68,نص عام,,0,0,0,,ما هذه أختك الحقيقية؟
Dialogue: 0,1:01:51.35,1:01:52.39,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:01:52.48,1:01:57.77,general text,,0,0,0,,الجاني الحقيقي لجرائم القتل التي اتهم بها مو دوك،
Dialogue: 0,1:01:57.86,1:01:59.57,نص عام,,0,0,0,,فتاة تدعى سو يي
Dialogue: 0,1:02:02.03,1:02:03.95,نص عام,,0,0,0,,الفتاة التي تناديها بالأخت،
Dialogue: 0,1:02:05.32,1:02:06.62,نص عام,,0,0,0,,نفس الشيء لذلك أنا
Dialogue: 0,1:02:08.91,1:02:10.08,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:02:29.39,1:02:33.18,النص العام,,0,0,0,,سمعت أنك أخبرت تشو يونغ أنك لا تحب هذه الفتاة
Dialogue: 0,1:02:35.90,1:02:37.02,نص عام,,0,0,0,,نعم
Dialogue: 0,1:02:38.90,1:02:40.98,نص عام,,0,0,0,,الطاقة السيئة تأتي منها
Dialogue: 0,1:02:41.07,1:02:43.86,نص عام,,0,0,0,,لا أريدها أن تقترب مني مرة أخرى
Dialogue: 0,1:02:49.87,1:02:52.29,نص عام,,0,0,0,,سأتأكد من سلامتك دائمًا
Dialogue: 0,1:02:53.12,1:02:54.41,نص عام,,0,0,0,,سأتخلص منها
Dialogue: 0,1:03:00.68,1:03:02.27,نص عام,,0,0,0,,شكرًا لك يا أمي
Dialogue: 0,1:03:30.04,1:03:31.34,خلف الكواليس,,0,0,0,,لقد تغيرت
Dialogue: 0,1:03:32.21,1:03:33.88,التعليق الصوتي,,0,0,0,,هل تعرف أنه بديل؟
Dialogue: 0,1:03:35.30,1:03:37.30,خارج الشاشة,,0,0,0,,أستخدمها وأنت تعلم أنها مزيفة؟
Dialogue: 0,1:03:39.55,1:03:42.31,general text,,0,0,0,,لماذا تماطلون في الزمن وتختبئون خلف قصيدة؟
Dialogue: 0,1:03:46.31,1:03:49.31,نقوش,,0,0,0,,تاريخ جيونبوغوان
Dialogue: 0,1:03:52.02,1:03:53.69,خط مائل,,0,0,0,,الخامس من مايو
Dialogue: 0,1:03:53.78,1:03:55.94,مائل,,0,0,0,,عندما حاول غوانغجو تشانغ غان القبض على الشامان تشوي،
Dialogue: 0,1:03:56.03,1:03:58.70,مائل,,0,0,0,,من أجل إدانتها باستخدام السحر الأسود،
Dialogue: 0,1:03:58.78,1:04:01.28,مائل,,0,0,0,,قفزت في النار
Dialogue: 0,1:04:01.37,1:04:03.12,مائل,,0,0,0,,ميت
Dialogue: 0,1:04:04.58,1:04:06.58,نص عام,,0,0,0,,قصة الشامان بون من قرية جيما
Dialogue: 0,1:04:07.33,1:04:08.67,نص عام,,0,0,0,,محفوظ في السجلات
Dialogue: 0,1:04:09.25,1:04:13.09,نص عام,,0,0,0,,ربما التقى الشامان تشوي وجين مو حينها
Dialogue: 0,1:04:13.17,1:04:16.30,general text,,0,0,0,,لماذا تبحث بإصرار عن هذا الشامان تشوي؟
Dialogue: 0,1:04:16.38,1:04:19.80,general text,,0,0,0,,هل وجدت المنزل الذي زاره الخصي كيم في جيما؟
Dialogue: 0,1:04:21.19,1:04:22.52,نص عام,,0,0,0,,نعم
Dialogue: 0,1:04:23.02,1:04:25.69,النص العام,,0,0,0,,كان يذهب في كثير من الأحيان إلى متجر للأعشاب الطبية
Dialogue: 0,1:04:25.78,1:04:27.15,نص عام,,0,0,0,,متجر إذن؟
Dialogue: 0,1:04:27.78,1:04:30.36,نص عام,,0,0,0,,شاركتها معكم. الآن حان دورك
Dialogue: 0,1:04:31.95,1:04:33.12,نص عام,,0,0,0,,الخصي كيم
Dialogue: 0,1:04:33.95,1:04:36.37,نص عام,,0,0,0,,يُطلق على الشخص الذي كان بمثابة الشامان تشوي
Dialogue: 0,1:04:40.25,1:04:42.17,نص عام,,0,0,0,,الرجل الذي خدمه كيم الخصي...
Dialogue: 0,1:04:42.25,1:04:44.00,نص عام,,0,0,0,,جلالة الملكة
Dialogue: 0,1:04:46.55,1:04:48.67,مائل,,0,0,0,,أعلم أنك شككت بها بنفسك
Dialogue: 0,1:04:48.76,1:04:51.63,نص عام,,0,0,0,,روح الملكة الحقيقية لا تزال على قيد الحياة
Dialogue: 0,1:04:52.47,1:04:55.31,نص عام,,0,0,0,,على الأغلب هي المكان الذي ذهب إليه الخصي كيم
Dialogue: 0,1:04:56.26,1:04:58.10,نص عام,,0,0,0,,كيف تعرف أنها على قيد الحياة؟
Dialogue: 0,1:05:03.15,1:05:05.61,النص العام,,0,0,0,,فانوس الحياة للملكة ما زال مشتعلاً
Dialogue: 0,1:05:05.69,1:05:07.53,النص العام,,0,0,0,,إنها فرد من عائلة So
Dialogue: 0,1:05:08.19,1:05:09.53,نص عام,,0,0,0,,سأجد الملكة الحقيقية...
Dialogue: 0,1:05:09.61,1:05:12.66,النص العام,,0,0,0,,وسأكشف الجوهر الحقيقي لمن يجلس الآن في المجلس الموحد
Dialogue: 0,1:05:17.66,1:05:20.04,نص عام,,0,0,0,,هل تريد توريطني في هذا؟
Dialogue: 0,1:05:20.12,1:05:22.29,نص عام,,0,0,0,,هذا يخص والدتك
Dialogue: 0,1:05:28.00,1:05:29.30,نص عام,,0,0,0,,أ بحجر
Dialogue: 0,1:05:29.38,1:05:31.51,نص عام,,0,0,0,,ماذا ستفعل حينها؟
Dialogue: 0,1:05:31.59,1:05:33.47,نص عام,,0,0,0,,كما ورث المعلم سيو كيونغ
Dialogue: 0,1:05:33.55,1:05:35.47,النص العام,,0,0,0,,سأفعل كما هو مكتوب في "كلمات من القلب"
Dialogue: 0,1:05:35.55,1:05:36.43,خط مائل,,0,0,0,,المملكة المتحدة
Dialogue: 0,1:05:37.39,1:05:39.61,نص عام,,0,0,0,,كلام القلب لا يتحدث عن الحجر
Dialogue: 0,1:05:39.69,1:05:43.32,نص عام,,0,0,0,,ظننتك تكذب لكسب الوقت
Dialogue: 0,1:05:43.40,1:05:44.74,نص عام,,0,0,0,,لم أكذب
Dialogue: 0,1:05:45.45,1:05:47.12,نص عام,,0,0,0,,السبب حقًا
Dialogue: 0,1:05:47.20,1:05:50.12,نص عام,,0,0,0,,مكتوب في القصيدة للأستاذ سو كيونغ
Dialogue: 0,1:05:55.46,1:05:58.13,general text,,0,0,0,,يحتوي حجر الجليد على قوة هوانجسو. يمين؟
Dialogue: 0,1:05:58.21,1:06:00.84,نص عام,,0,0,0,,وفيه القوى التي تتحكم في الماء والنار والرياح
Dialogue: 0,1:06:00.92,1:06:03.84,نص عام,,0,0,0,,وكذلك القوة التي تسيطر على نفوس الناس
Dialogue: 0,1:06:04.80,1:06:05.89,مائل,,0,0,0,,لذلك قوته
Dialogue: 0,1:06:05.97,1:06:08.18,نص عام,,0,0,0,,يجب حظره على البشرية
Dialogue: 0,1:06:08.26,1:06:11.56,general text,,0,0,0,,من الصعب تصديق وجود قطعة صغيرة كهذه من الجليد
Dialogue: 0,1:06:11.64,1:06:12.81,نص عام,,0,0,0,,قوة كبيرة
Dialogue: 0,1:06:12.89,1:06:14.39,نص عام,,0,0,0,,أريد أن أرى بنفسي
Dialogue: 0,1:06:18.48,1:06:21.28,general text,,0,0,0,,هل رأى أحدكم الحجر وهو يتحرك؟
Dialogue: 0,1:06:24.32,1:06:27.95,general text,,0,0,0,,هل تقاتلت حقًا على قطعة من الجليد لم ترى قوتها حتى؟
Dialogue: 0,1:06:31.04,1:06:32.66,نص عام,,0,0,0,,ثم... ربما سنتحقق،
Dialogue: 0,1:06:33.79,1:06:36.08,نص عام,,0,0,0,,دعونا نتحقق من قوتها أمام الجميع؟
Dialogue: 0,1:06:36.87,1:06:38.92,نص عام,,0,0,0,,كيف تريد أن تفعل هذا بالضبط؟
Dialogue: 0,1:06:39.00,1:06:40.21,النص العام,,0,0,0,,إذا سيطر على النفوس،
Dialogue: 0,1:06:40.92,1:06:43.59,النص العام,,0,0,0,,حتى تتمكن من إعادة الموتى إلى الحياة؟
Dialogue: 0,1:06:45.09,1:06:47.80,general text,,0,0,0,,هوانغسو ليس سحراً ولا يوجد حظر عليه
Dialogue: 0,1:06:47.89,1:06:49.60,general text,,0,0,0,,نعم سنعيد الموتى، إنه أمر جيد
Dialogue: 0,1:06:51.35,1:06:52.85,general text,,0,0,0,,أيها الرئيس جين، لقد أحضرت حجرًا إلى هنا،
Dialogue: 0,1:06:54.14,1:06:55.60,نص عام,,0,0,0,,أظهر قوته
Dialogue: 0,1:06:57.06,1:06:58.40,نص عام,,0,0,0,,صاحب الجلالة،
Dialogue: 0,1:06:58.48,1:07:01.53,نص عام,,0,0,0,,الجميع هنا على قيد الحياة. من تقترح القيامة؟
Dialogue: 0,1:07:02.95,1:07:04.62,نص عام,,0,0,0,,ثم اقتل شخصًا
Dialogue: 0,1:07:10.54,1:07:11.42,نص عام,,0,0,0,,ها أنت ذا
Dialogue: 0,1:07:14.88,1:07:17.05,نص عام,,0,0,0,,تعال هنا
Dialogue: 0,1:07:19.34,1:07:20.26,نص عام,,0,0,0,,نعم
Dialogue: 0,1:07:25.60,1:07:27.23,general text,,0,0,0,,اقتلها وأرجعها إلى الحياة
Dialogue: 0,1:07:27.81,1:07:29.35,general text,,0,0,0,,إنها خادمة، لا تعرف أي تعويذة.
Dialogue: 0,1:07:29.94,1:07:33.15,مائل,,0,0,0,,لذا لا داعي للقلق بشأن السماح لها بالاقتراب من حجر الجليد
Dialogue: 0,1:07:33.23,1:07:34.07,خط مائل,,0,0,0,,جلالة الملك،
Dialogue: 0,1:07:34.15,1:07:36.53,general text,,0,0,0,,لا يمكنك قتل شخص لمجرد الفضول.
Dialogue: 0,1:07:36.61,1:07:38.49,النص العام,,0,0,0,,أريد فقط رؤيتها تعود إلى الحياة
Dialogue: 0,1:07:39.07,1:07:39.95,نص عام,,0,0,0,,استخدام هذا
Dialogue: 0,1:07:40.03,1:07:42.08,خط مائل,,0,0,0,,كيف يمكنك أن تسأل فتاة ضعيفة...
Dialogue: 0,1:07:42.16,1:07:44.45,نص عام,,0,0,0,,هل جربت هذا؟
Dialogue: 0,1:07:48.08,1:07:49.17,نص عام,,0,0,0,,الإجابة
Dialogue: 0,1:07:50.25,1:07:51.54,نص عام,,0,0,0,,هل أنت خائف؟
Dialogue: 0,1:07:55.09,1:07:56.59,نص عام,,0,0,0,,سأدفع لك 100 مربية ذهبية
Dialogue: 0,1:07:57.30,1:07:58.63,نص عام,,0,0,0,,ماذا تقول؟
Dialogue: 0,1:08:02.01,1:08:03.10,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:08:03.89,1:08:05.06,نص عام,,0,0,0,,أوافق
Dialogue: 0,1:08:06.47,1:08:07.60,مائل,,0,0,0,,سأضحي بنفسي،
Dialogue: 0,1:08:08.35,1:08:11.90,نص عام,,0,0,0,,لإظهار القوة التي يريدون رؤيتها
Dialogue: 0,1:08:12.98,1:08:14.86,نص عام,,0,0,0,,الجميع حاضرون
Dialogue: 0,1:08:43.31,1:08:45.69,التعليق الصوتي,,0,0,0,,ها هي فرصتي للحصول على حجر الجليد
Dialogue: 0,1:08:47.44,1:08:51.95,التعليق الصوتي,,0,0,0,,لهذا يجب أن أموت أولاً
Dialogue: 0,1:08:53.66,1:08:57.66,خارج الشاشة,,0,0,0,,لا أحد هنا يهتم سواء مت أم لا
Dialogue: 0,1:08:58.91,1:09:01.50,خلف الكواليس,,0,0,0,,إنهم مجرد فضول لرؤيتهم
Dialogue: 0,1:09:02.00,1:09:03.96,خلف الكواليس,,0,0,0,,قوة الحجر
Dialogue: 0,1:09:24.35,1:09:26.52,التعليق الصوتي,,0,0,0,,لا أعرف إذا كنت سأموت...
Dialogue: 0,1:09:27.02,1:09:30.82,خلف الكواليس,,0,0,0,,وإلا سأستعيد قوتي بفضل الحجر
Dialogue: 0,1:09:32.07,1:09:34.16,خارج الإطار,,0,0,0,,أنا أقف على حافة الهاوية،
Dialogue: 0,1:09:35.11,1:09:38.16,خارج الشاشة,,0,0,0,,وأمامي حجر جليدي
Dialogue: 0,1:09:38.24,1:09:39.75,ذكريات بخط مائل,,0,0,0,,لقد اشتقت إليك أيضًا
Dialogue: 0,1:09:43.05,1:09:44.05,ذكريات,,0,0,0,,هذه إجابتي
Dialogue: 0,1:09:45.22,1:09:48.64,التعليق الصوتي,,0,0,0,,أنا سعيد لأنك لست هنا
Dialogue: 0,1:09:49.81,1:09:52.56,مائل,,0,0,0,,كلمات من القلب تتحدث عن الرغبة في إنقاذ شخص عزيز
Dialogue: 0,1:09:53.14,1:09:55.19,النص العام,,0,0,0,,هذه رسالة من المعلم سيو كيونغ
Dialogue: 0,1:09:55.27,1:09:57.69,نص عام,,0,0,0,,إهداء إلى شخص عزيز يحتضر
Dialogue: 0,1:09:57.77,1:10:00.61,general text,,0,0,0,,كتب أنه ترك شيئًا من شأنه أن يساعد في إبقاء محبوبته قريبة
Dialogue: 0,1:10:00.69,1:10:02.44,نص عام,,0,0,0,,هل تريد أن تقول أن البطل العظيم،
Dialogue: 0,1:10:03.36,1:10:05.78,النص العام,,0,0,0,,تدمير الحجارة لإنقاذ العالم,
Dialogue: 0,1:10:05.86,1:10:09.08,general text,,0,0,0,,هل تريد استخدامه لإنقاذ شخص ما؟
Dialogue: 0,1:10:09.16,1:10:11.24,النص العام,,0,0,0,,الرسالة تعكس جنون الإنسان وألمه،
Dialogue: 0,1:10:11.91,1:10:14.54,general text,,0,0,0,,مستعد لمخالفة قوانين الطبيعة، فقط من أجل إنقاذ حبيبته.
Dialogue: 0,1:10:15.37,1:10:20.38,general text,,0,0,0,"كلمات القلب" هي اعتراف المعلمة سو كيونغ
Dialogue: 0,1:10:25.26,1:10:28.01,نص عام,,0,0,0,,أنا لا أحب ذلك أيضًا
Dialogue: 0,1:10:29.80,1:10:32.18,نص عام,,0,0,0,,لذلك سأقتلك دون ألم
Dialogue: 0,1:10:33.89,1:10:36.23,نص عام,,0,0,0,,هذا ليس لإظهار موتي
Dialogue: 0,1:10:37.52,1:10:39.56,general text,,0,0,0,,نحن نفعل هذا لنبين كيف سأقوم من الموت
Dialogue: 0,1:10:43.19,1:10:44.61,نص عام,,0,0,0,,أحييني
Dialogue: 0,1:10:45.65,1:10:47.24,نص عام,,0,0,0,,ولا تخيب ظن أحد
Dialogue: 0,1:10:49.28,1:10:50.99,نص عام,,0,0,0,,فلا نخيب آمال أحد
Dialogue: 0,1:10:54.66,1:10:56.79,خارج الشاشة,,0,0,0,,أم ستقتل ابنتها
Dialogue: 0,1:11:52.94,1:11:54.11,ذكريات,,0,0,0,,جميلتي
Dialogue: 0,1:11:55.61,1:11:57.40,ذكريات,,0,0,0,,يا بو يونغ
Dialogue: 0,1:12:06.24,1:12:07.37,نص عام,,0,0,0,,الأم
Dialogue: 0,1:13:06.90,1:13:08.36,معاينة,,0,0,0,,حدث خطأ ما
Dialogue: 0,1:13:08.44,1:13:09.94,preview,,0,0,0,,هل حدث شيء لحجر الجليد؟
Dialogue: 0,1:13:10.03,1:13:13.40,preview,,0,0,0,,عندما اقتربنا من البوابة، هبت علينا ريح قوية.
Dialogue: 0,1:13:13.49,1:13:15.20,preview,,0,0,0,,حدث هذا بالتأكيد بسبب مو ديوك
Dialogue: 0,1:13:16.07,1:13:17.70,preview,,0,0,0,,الأطفال هناك!
Dialogue: 0,1:13:17.78,1:13:18.83,معاينة,,0,0,0,,يونغ أوك!
Dialogue: 0,1:13:18.91,1:13:21.08,معاينة,,0,0,0,,طاقتي خرجت للتو من خلال السيف
Dialogue: 0,1:13:21.16,1:13:23.29,preview,,0,0,0,,أعتقد أن المشكلة برمتها هي العائق
Dialogue: 0,1:13:23.37,1:13:25.25,preview,,0,0,0,,لقد اختفى السيد خان؟
Dialogue: 0,1:13:26.42,1:13:30.09,preview,,0,0,0,,لا أحد منا يستطيع إلقاء التعويذات هنا. لماذا ينجح؟
Dialogue: 0,1:13:30.17,1:13:31.92,معاينة,,0,0,0,,لا يمكن أن نموت جميعنا
Dialogue: 0,1:13:32.01,1:13:34.01,معاينة,,0,0,0,,سوف استدرجه وأحبسه في غرفة سرية
Dialogue: 0,1:13:34.09,1:13:35.68,معاينة,,0,0,0,,قد يموت تشان ووك
Dialogue: 0,1:13:36.22,1:13:39.36,preview,,0,0,0,,إذا كانت الغرفة مغلقة، فمن المحتمل أنه مات بالفعل
Dialogue: 0,1:13:41.07,1:13:42.69,preview,,0,0,0,,تشان ووك، تلميذي...
الحوار: 0,0:02:55.18,0:02:57.18,النكات,,0,0,0,,
