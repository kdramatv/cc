Dialogue: 0,0:02:57.14,0:03:02.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee, tommo, Zero_Amamiya
Dialogue: 0,0:00:54.21,0:00:57.38,مائل,,0,0,0,,في أحد الأيام، أصيب ديهو بجفاف رهيب
Dialogue: 0,0:01:00.26,0:01:02.72,مائل,,0,0,0,,قوي جدًا لدرجة أن بحيرة جيونج تشونج دايهو
Dialogue: 0,0:01:02.80,0:01:04.55,خط مائل,,0,0,0,,مرهق
Dialogue: 0,0:01:11.89,0:01:15.56,italics,,0,0,0,,أدى سحرة ديهو حفلاً عظيماً،
Dialogue: 0,0:01:15.65,0:01:17.36,خط مائل,,0,0,0,,لملء البحيرة بالطاقة
Dialogue: 0,0:01:23.24,0:01:26.62,خط مائل,,0,0,0,,تسببت الطقوس في سقوط بَرَدٍ كثيف
Dialogue: 0,0:01:38.04,0:01:39.67,مائل,,0,0,0,,بين كل حبات البرد
Dialogue: 0,0:01:39.75,0:01:42.63,مائل,,0,0,0,,كان هناك من لم يذوب
Dialogue: 0,0:01:44.72,0:01:49.55,مائل,,0,0,0,,حجر البرد هذا تحول أولاً إلى نار،
Dialogue: 0,0:01:50.22,0:01:51.52,خط مائل,,0,0,0,,ثم حجر,
Dialogue: 0,0:01:52.02,0:01:53.81,خط مائل,,0,0,0,,ثم في الماء
Dialogue: 0,0:01:54.77,0:01:58.23,italics,,0,0,0,,ثم عادت إلى البداية من جديد - أصبحت ثلجاً
Dialogue: 0,0:01:59.11,0:02:01.78,مائل,,0,0,0,,وفي نفس الوقت انطلق الغبار الأسود
Dialogue: 0,0:02:03.69,0:02:07.49,مائل,,0,0,0,,كان هذا الغبار يسمى العاكس وكان يستخدم في كيمياء النفوس
Dialogue: 0,0:02:11.08,0:02:14.04,مائل,,0,0,0,,قوة العاكس كانت مذهلة حقًا
Dialogue: 0,0:02:15.91,0:02:19.79,مائل,,0,0,0,,يمكنك إعادة الميت إلى الحياة من خلال استدعاء روحه
Dialogue: 0,0:02:20.38,0:02:23.30,خط مائل,,0,0,0,,يمكننا تبادل الجثث
Dialogue: 0,0:02:25.17,0:02:27.26,مائل,,0,0,0,,يمكنك حتى طرد الروح من الجسد
Dialogue: 0,0:02:27.34,0:02:29.85,خط مائل,,0,0,0,,واستحوذ على طاقته
Dialogue: 0,0:02:36.23,0:02:41.02,مائل,,0,0,0,,ونتيجة لذلك، خلقت هذه القوة اللامحدودة الفوضى
Dialogue: 0,0:02:49.99,0:02:54.12,مائل,,0,0,0,,تحولت البلاد إلى فوضى دموية بسبب السحرة،
Dialogue: 0,0:02:54.87,0:02:59.79,مائل,,0,0,0,,الذي أطلق مذبحة للعاكس
Dialogue: 0,0:03:08.93,0:03:11.60,مائل,,0,0,0,,الرجل الذي أوقف هذه الفوضى،
Dialogue: 0,0:03:13.31,0:03:17.31,مائل,,0,0,0,,كان السيد سو كيونغ، مؤسس سوسنوفي بور
Dialogue: 0,0:03:27.07,0:03:28.86,نص عام,,0,0,0,,كنت تلميذته
Dialogue: 0,0:03:28.95,0:03:31.62,نص عام,,0,0,0,,يا له من حجر جليدي مذهل
Dialogue: 0,0:03:31.70,0:03:34.66,نص عام,,0,0,0,,أين هو الآن؟ أريد أن أرى
Dialogue: 0,0:03:34.74,0:03:37.29,نص عام,,0,0,0,,هذا حجر مخيف جدًا
Dialogue: 0,0:03:37.37,0:03:39.08,نص عام,,0,0,0,,سحر هذا الحجر
Dialogue: 0,0:03:39.16,0:03:42.79,نص عام,,0,0,0,,ابتكر أشياء فظيعة يمكن أن تؤذي الناس
Dialogue: 0,0:03:43.63,0:03:46.55,النص العام,,0,0,0,,عزيزي أين وجدت هذه الدمية؟
Dialogue: 0,0:03:46.63,0:03:48.51,نص عام,,0,0,0,,في الجبال
Dialogue: 0,0:03:52.30,0:03:54.39,النص العام,,0,0,0,,هل ستتاجر بهذا؟
Dialogue: 0,0:03:54.97,0:03:55.93,نص عام,,0,0,0,,نعم
Dialogue: 0,0:04:04.52,0:04:07.15,نص عام,,0,0,0,,هذه بقايا لعينة
Dialogue: 0,0:04:16.24,0:04:17.58,نص عام,,0,0,0,,- ماذا كان ذلك؟\N- ماذا كان ذلك؟
Dialogue: 0,0:04:17.66,0:04:20.71,نص عام,,0,0,0,,عنصر خطير تم إنشاؤه بواسطة السحر
Dialogue: 0,0:04:20.79,0:04:23.04,نص عام,,0,0,0,,أعرف ما هو. الآثار
Dialogue: 0,0:04:24.25,0:04:25.46,نص عام,,0,0,0,,جينيوون مليء بهم
Dialogue: 0,0:04:27.17,0:04:28.38,نص عام,,0,0,0,,نعم
Dialogue: 0,0:04:28.46,0:04:31.30,النص العام,,0,0,0,,هناك العديد من الأشياء الأكثر خطورة في جينيوون
Dialogue: 0,0:04:32.63,0:04:34.97,مائل,,0,0,0,,هناك العديد من الأشياء الغريبة هناك،
Dialogue: 0,0:04:35.05,0:04:37.35,مائل,,0,0,0,,تم إنشاؤه بقوة حجر الجليد
Dialogue: 0,0:04:44.19,0:04:48.69,النص العام,,0,0,0,,إنهم ينتظرون الفرصة للخروج إلى النور من جديد
Dialogue: 0,0:05:02.25,0:05:03.79,ذكريات بخط مائل,,0,0,0,,هل تريدني أن آخذها معك؟
Dialogue: 0,0:05:04.62,0:05:05.75,ذكريات بخط مائل,,0,0,0,,لا أريد
Dialogue: 0,0:05:06.96,0:05:09.67,ذكريات,,0,0,0,,دعني أكون وون مو دوك، الذي يتجنبه الجميع،
Dialogue: 0,0:05:10.30,0:05:13.13,ذكريات,,0,0,0,,لكنني لا أخدم الجميع
Dialogue: 0,0:05:13.22,0:05:15.39,نص عام,,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:05:16.30,0:05:17.89,نص عام,,0,0,0,,كان ينبغي أن تكون ممتنة
Dialogue: 0,0:05:17.97,0:05:21.60,النص العام,,0,0,0,,نبيذ القرفة والزنجبيل هذا له رائحة قرفة قوية جدًا
Dialogue: 0,0:05:22.43,0:05:23.94,ذكريات مائلة,,0,0,0,,شكرًا لك يا صاحب السمو
Dialogue: 0,0:05:26.98,0:05:28.61,ذكريات,,0,0,0,,رائحته مثل القرفة
Dialogue: 0,0:05:32.32,0:05:33.53,نص عام,,0,0,0,,وقحة جدًا
Dialogue: 0,0:05:33.61,0:05:35.11,نص عام,,0,0,0,,هل يزعجك شيء؟
Dialogue: 0,0:05:35.20,0:05:37.91,general text,,0,0,0,,من الواضح أنني أخطأت بشأن وون مو ديوك
Dialogue: 0,0:05:38.49,0:05:40.37,نص عام,,0,0,0,,الرائحة الكريهة لا تزول
Dialogue: 0,0:05:41.41,0:05:42.91,نص عام,,0,0,0,,رائحته طيبة
Dialogue: 0,0:05:46.42,0:05:47.83,نص عام,,0,0,0,,انسى. اذهب
Dialogue: 0,0:05:48.88,0:05:49.84,نص عام,,0,0,0,,اذهب بعيدًا بالفعل
Dialogue: 0,0:05:49.92,0:05:51.42,نص عام,,0,0,0,,نعم سمو الأمير
Dialogue: 0,0:05:58.85,0:06:01.85,النص العام,,0,0,0,,كنت رحيمة وأنقذتها من المتاعب
Dialogue: 0,0:06:01.93,0:06:04.02,النص العام,,0,0,0,,أعطاها كيسًا وفستانًا حريريًا
Dialogue: 0,0:06:12.73,0:06:14.07,نص عام,,0,0,0,,ناكر للجميل جدًا
Dialogue: 0,0:06:19.03,0:06:21.74,نص عام,,0,0,0,,- أنا ممتن\N- طلبت منك الرحيل...
Dialogue: 0,0:06:28.37,0:06:29.75,نص عام,,0,0,0,,ستنك مو ديوك؟
Dialogue: 0,0:06:29.83,0:06:31.29,نص عام,,0,0,0,,كيف وصلت إلى هنا؟
Dialogue: 0,0:06:32.46,0:06:35.30,نص عام,,0,0,0,,لدي كيسك
Dialogue: 0,0:06:36.93,0:06:40.26,النص العام,,0,0,0,,لقد جئت لأنك تحتاج إلى شيء مني مرة أخرى
Dialogue: 0,0:06:40.35,0:06:42.93,النص العام,,0,0,0,,كنت أفكر في نفسي يا صاحب السمو،
Dialogue: 0,0:06:43.01,0:06:44.10,نص عام,,0,0,0,,لهذا السبب أتيت
Dialogue: 0,0:06:44.18,0:06:46.31,نص عام,,0,0,0,,هل تقول أنك قرأت أفكاري؟
Dialogue: 0,0:06:49.81,0:06:50.86,نص عام,,0,0,0,,ممتاز
Dialogue: 0,0:06:52.23,0:06:56.49,النص العام,,0,0,0,,اشرب بعضًا من نبيذ القرفة والزنجبيل. الرائحة أقوى من المرة السابقة
Dialogue: 0,0:07:05.41,0:07:07.54,نص عام,,0,0,0,,رائحته رائعة
Dialogue: 0,0:07:09.37,0:07:10.42,نص عام,,0,0,0,,نعم؟
Dialogue: 0,0:07:14.71,0:07:18.47,نص عام,,0,0,0,,يجب أن أقول، أنا أحب هذا المكان
Dialogue: 0,0:07:20.30,0:07:23.68,النص العام,,0,0,0,,أتمنى أن تستمر في التفكير بي كما تفعل اليوم
Dialogue: 0,0:07:24.26,0:07:26.14,نص عام,,0,0,0,,سآتي إليك في كل مرة
Dialogue: 0,0:07:38.19,0:07:40.24,نص عام,,0,0,0,,القصر مكان جيد
Dialogue: 0,0:07:43.99,0:07:45.70,نص عام,,0,0,0,,تلبسين الحرير,
Dialogue: 0,0:07:47.50,0:07:50.17,نص عام,,0,0,0,,شرب النبيذ العطر
Dialogue: 0,0:07:52.00,0:07:54.46,نص عام,,0,0,0,,هل تعلم لماذا فكرت فيك؟
Dialogue: 0,0:07:58.47,0:08:00.13,نص عام,,0,0,0,,لأنك وون مو دوك
Dialogue: 0,0:08:03.18,0:08:05.26,نص عام,,0,0,0,,لكن الآن لم تعد رائحتك كريهة
Dialogue: 0,0:08:06.76,0:08:08.68,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,0:08:08.77,0:08:09.64,نص عام,,0,0,0,,من أنت؟
Dialogue: 0,0:08:19.32,0:08:20.86,نص عام,,0,0,0,,لقد قبضت علي
Dialogue: 0,0:08:34.58,0:08:36.21,نص عام,,0,0,0,,تسلل الشرير إلى هنا
Dialogue: 0,0:08:36.29,0:08:37.75,general text,,0,0,0,,- ابحث في كل شيء\N{\i1}- نعم سمو الأمير
Dialogue: 0,0:08:42.84,0:08:44.68,نص عام,,0,0,0,,لكن لماذا تحت ستار مو دوك؟
Dialogue: 0,0:08:52.64,0:08:54.06,نص عام,,0,0,0,,شاهد كل زاوية
Dialogue: 0,0:08:54.15,0:08:55.44,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:08:59.53,0:09:01.24,نص عام,,0,0,0,,ولي العهد هنا
Dialogue: 0,0:09:02.03,0:09:03.28,نص عام,,0,0,0,,الأمير؟
Dialogue: 0,0:09:10.25,0:09:11.96,نص عام,,0,0,0,,أنا أبحث عن شخص ما
Dialogue: 0,0:09:12.04,0:09:13.79,نص عام,,0,0,0,,قالوا لي سأجده هنا
Dialogue: 0,0:09:15.42,0:09:18.46,نص عام,,0,0,0,,هل حدث شيء ما؟ تبدو قلقة
Dialogue: 0,0:09:19.05,0:09:22.30,general text,,0,0,0,,الخادمة خلقت مشاكل واختفت نحن نبحث عنها
Dialogue: 0,0:09:22.38,0:09:23.38,نص عام,,0,0,0,,خادم؟
Dialogue: 0,0:09:23.47,0:09:25.22,نص عام,,0,0,0,,إنها لا تعمل لدينا
Dialogue: 0,0:09:25.30,0:09:27.47,نص عام,,0,0,0,,مو دوك. خادمة عائلة تشان
Dialogue: 0,0:09:27.55,0:09:29.18,نص عام,,0,0,0,,هذا ما أبحث عنه
Dialogue: 0,0:09:30.18,0:09:31.72,نص عام,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:09:33.48,0:09:34.48,نص عام,,0,0,0,,هذه الخادمة...
Dialogue: 0,0:09:35.94,0:09:38.90,general text,,0,0,0,,كسرت بالخطأ يشم يين يانغ الذي كان مقصودًا
Dialogue: 0,0:09:39.52,0:09:40.82,نص عام,,0,0,0,,لخواتم الزفاف
Dialogue: 0,0:09:45.66,0:09:47.74,ذكريات,,0,0,0,,قلت لك أن تكون حذراً
Dialogue: 0,0:09:47.82,0:09:49.16,ذكريات,,0,0,0,,ماذا ستفعل الآن؟
Dialogue: 0,0:09:49.87,0:09:51.08,ذكريات,,0,0,0,,عذراً سيدتي
Dialogue: 0,0:09:51.70,0:09:52.95,ذكريات,,0,0,0,,سامحني
Dialogue: 0,0:09:53.50,0:09:55.29,ذكريات,,0,0,0,,سأتصل بصاحبها هنا
Dialogue: 0,0:09:55.37,0:09:57.46,ذكريات,,0,0,0,,احبسها في الملحق
Dialogue: 0,0:10:00.63,0:10:01.59,ذكريات,,0,0,0,,عذراً
Dialogue: 0,0:10:02.42,0:10:03.46,ذكريات,,0,0,0,,عذراً!
Dialogue: 0,0:10:03.55,0:10:05.76,خط مائل,,0,0,0,,ربما خائف من العقاب
Dialogue: 0,0:10:05.84,0:10:09.05,مائل,,0,0,0,,بينما كانت محبوسة سرقت حجر اليشم وهربت.
Dialogue: 0,0:10:13.18,0:10:15.35,النص العام,,0,0,0,,بالنظر إلى أننا لم نعثر عليها بعد،
Dialogue: 0,0:10:15.44,0:10:18.27,نص عام,,0,0,0,,أعتقد أنها غادرت هذا المكان بالفعل
Dialogue: 0,0:10:20.15,0:10:21.73,general text,,0,0,0,,هل أنت خائف وهربت؟
Dialogue: 0,0:10:22.61,0:10:24.11,نص عام,,0,0,0,,هذه الفتاة الشجاعة؟
Dialogue: 0,0:10:26.78,0:10:28.74,general text,,0,0,0,,لقد وصل سحرة جيونجينغاك
Dialogue: 0,0:10:37.17,0:10:40.17,النص العام,,0,0,0,,صاحب السمو، ما الذي أتى بك إلى هنا؟
Dialogue: 0,0:10:40.25,0:10:41.84,نص عام,,0,0,0,,وأنت يا يول؟
Dialogue: 0,0:10:42.42,0:10:43.42,نص عام,,0,0,0,,أبحث عن شخص ما
Dialogue: 0,0:10:44.34,0:10:46.97,general text,,0,0,0,,هل تبحث أيضًا عن Moo Dok؟
Dialogue: 0,0:10:47.68,0:10:48.51,نص عام,,0,0,0,,نعم
Dialogue: 0,0:10:49.76,0:10:50.97,نص عام,,0,0,0,,جئت بسببها
Dialogue: 0,0:10:58.98,0:11:01.19,نص عام,,0,0,0,,لقد كسرت اليشم،
Dialogue: 0,0:11:01.27,0:11:03.57,general text,,0,0,0,,ثم هرب حتى لا يُعاقب
Dialogue: 0,0:11:04.23,0:11:07.70,general text,,0,0,0,,لماذا لم ترن في ذلك اليوم؟
Dialogue: 0,0:11:08.32,0:11:12.58,general text,,0,0,0,,جئت إلى تشويسنجرو "لأمد" يدي، لكنهم قالوا لي أنك غادرت
Dialogue: 0,0:11:14.16,0:11:16.45,نص عام,,0,0,0,,قررت أن أفعلها لاحقًا
Dialogue: 0,0:11:18.71,0:11:20.42,general text,,0,0,0,,يول، لماذا تبحث عن مو دوك؟
Dialogue: 0,0:11:21.04,0:11:24.88,general text,,0,0,0,,لقد رأيت نفس رؤيتك يا صاحب السمو
Dialogue: 0,0:11:44.69,0:11:46.32,نص عام,,0,0,0,,كيف وصلت إلى هنا؟
Dialogue: 0,0:11:48.95,0:11:51.49,نص عام,,0,0,0,,أتيت لأنك اشتقت لي
Dialogue: 0,0:11:54.66,0:11:55.91,نص عام,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:11:57.25,0:11:59.58,النص العام,,0,0,0,,لقد فاتك الشخص الذي قابلته في دانهيانغوك
Dialogue: 0,0:11:59.66,0:12:01.08,نص عام,,0,0,0,,توقف عن خداعي
Dialogue: 0,0:12:01.17,0:12:02.46,نص عام,,0,0,0,,اشتقت لك؟
Dialogue: 0,0:12:03.17,0:12:05.00,النص العام,,0,0,0,,- لا شيء من هذا القبيل\N- {\i1}خطأ
Dialogue: 0,0:12:05.09,0:12:06.92,نص عام,,0,0,0,,لقد صفرت
Dialogue: 0,0:12:11.43,0:12:13.18,النص العام,,0,0,0,,الساق المكسورة لم تزعجك
Dialogue: 0,0:12:14.76,0:12:16.85,general text,,0,0,0,,ولم تكن تخشى أن يوبخوك
Dialogue: 0,0:12:19.06,0:12:20.89,نص عام,,0,0,0,,لأنك أحببتها
Dialogue: 0,0:12:26.73,0:12:28.78,نص عام,,0,0,0,,واصل التفكير فيها
Dialogue: 0,0:12:36.74,0:12:38.12,نص عام,,0,0,0,,ثم سأعود إليك مرة أخرى
Dialogue: 0,0:12:44.08,0:12:45.08,نص عام,,0,0,0,,أنت...
Dialogue: 0,0:12:45.96,0:12:46.96,نص عام,,0,0,0,,ليس بشريًا
Dialogue: 0,0:12:58.10,0:12:59.81,نص عام,,0,0,0,,هل ستتخلص مني؟
Dialogue: 0,0:13:01.23,0:13:03.27,نص عام,,0,0,0,,ثم لن نرى بعضنا البعض مرة أخرى
Dialogue: 0,0:13:34.47,0:13:36.39,نص عام,,0,0,0,,لم تكن هي. مجرد رؤية
Dialogue: 0,0:13:37.97,0:13:40.64,نص عام,,0,0,0,,فكانت رؤيا؟
Dialogue: 0,0:13:40.72,0:13:43.52,general text,,0,0,0,,كان الأمر غريبًا، لذلك أتيت إلى Jwiseonru للعثور على Moo Deok
Dialogue: 0,0:13:44.10,0:13:45.65,نص عام,,0,0,0,,قيل لي إنها سُحبت إلى هنا
Dialogue: 0,0:13:46.52,0:13:49.11,general text,,0,0,0,,لم يجروها. كان لديها مهمة
Dialogue: 0,0:13:49.90,0:13:52.53,النص العام,,0,0,0,,واختفت مع أثر مهم
Dialogue: 0,0:13:53.36,0:13:56.11,النص العام,,0,0,0,,نحن نبحث عن لص لا عن رؤية
Dialogue: 0,0:14:01.79,0:14:02.91,نص عام,,0,0,0,,وهنا صاحبتها
Dialogue: 0,0:14:18.47,0:14:21.35,general text,,0,0,0,,السيد لي ليس هنا مرة أخرى اليوم؟
Dialogue: 0,0:14:21.85,0:14:24.14,نص عام,,0,0,0,,هذا الرجل كالريح
Dialogue: 0,0:14:24.85,0:14:26.35,نص عام,,0,0,0,,تركني الكلب ورحل
Dialogue: 0,0:14:27.10,0:14:30.06,general text,,0,0,0,,هل غويغو أيضاً مخلوق من حجر الجليد؟
Dialogue: 0,0:14:30.15,0:14:33.94,general text,,0,0,0,,صنعها المعلم سو كيونغ من طاقة الحجر،
Dialogue: 0,0:14:34.03,0:14:36.15,نص عام,,0,0,0,,للبحث عن آثار السحر
Dialogue: 0,0:14:37.28,0:14:39.91,general text,,0,0,0,,المملكة المتحدة كسرت جرة غويجا،
Dialogue: 0,0:14:39.99,0:14:42.99,general text,,0,0,0,,فأعاد السيد لي روحه من جينيون
Dialogue: 0,0:14:43.70,0:14:45.33,نص عام,,0,0,0,,وضعها في هذا الكلب
Dialogue: 0,0:14:45.41,0:14:48.71,النص العام,,0,0,0,,أنت حقًا لا تعرف أين هو السيد سيو كيونغ
Dialogue: 0,0:14:49.88,0:14:51.13,نص عام,,0,0,0,,ختم الحجر؟
Dialogue: 0,0:14:53.00,0:14:53.96,نص عام,,0,0,0,,لا أعرف
Dialogue: 0,0:14:54.96,0:14:57.84,general text,,0,0,0,,هل تظن أن كيمياء النفوس قد انتشرت من جديد،
Dialogue: 0,0:14:57.93,0:15:00.09,نص عام,,0,0,0,,لأن أحدهم وجد حجراً؟
Dialogue: 0,0:15:01.64,0:15:04.97,general text,,0,0,0,,الطريقة الوحيدة لنقل الروح دون إتقان هوانغسو هي
Dialogue: 0,0:15:05.73,0:15:07.23,نص عام,,0,0,0,,استخدم الحجر
Dialogue: 0,0:15:07.77,0:15:10.56,نص عام,,0,0,0,,أنا متأكد من أن أحدهم طبعه
Dialogue: 0,0:15:11.23,0:15:12.77,نص عام,,0,0,0,,والعودة إلى النور
Dialogue: 0,0:15:14.03,0:15:16.07,نص عام,,0,0,0,,حسنًا، هذا ليس جيدًا
Dialogue: 0,0:15:16.15,0:15:20.28,general text,,0,0,0,,لا يمكن السماح للرعب الذي حدث قبل 200 عام أن يتكرر مرة أخرى
Dialogue: 0,0:15:21.78,0:15:24.91,نص عام,,0,0,0,,نحن بحاجة للعثور على حجر الجليد
Dialogue: 0,0:15:34.59,0:15:37.09,نص عام,,0,0,0,,لقد أمرت أن أعطيك هذه
Dialogue: 0,0:15:47.39,0:15:50.14,خط مائل,,0,0,0,,ظننت أنك ستظل منخفضًا الآن
Dialogue: 0,0:15:50.23,0:15:53.61,general text,,0,0,0,,هل يمكنك مساعدة شخص آخر على الهجرة؟
Dialogue: 0,0:15:57.53,0:15:59.36,نص عام,,0,0,0,,أخبرني أنني استلمت الطرد
Dialogue: 0,0:16:00.45,0:16:01.49,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:08.20,0:16:10.92,general text,,0,0,0,,أسرعوا وأبحثوا لي عن خصي ليحل محله
Dialogue: 0,0:16:13.04,0:16:16.84,general text,,0,0,0,,سوف تهاجر روحك إلى جسده، اختر بحكمة
Dialogue: 0,0:16:16.92,0:16:18.09,نص عام,,0,0,0,,نعم
Dialogue: 0,0:16:19.38,0:16:21.18,التعليق الصوتي,,0,0,0,,لقد خدمت دان تشو
Dialogue: 0,0:16:21.26,0:16:23.26,خارج الشاشة,,0,0,0,,عدم الهجرة إلى جسد الخصي
Dialogue: 0,0:16:25.35,0:16:27.35,التعليق الصوتي,,0,0,0,,أنا أستخدم ناك سو،
Dialogue: 0,0:16:27.93,0:16:29.77,خلف الكواليس,,0,0,0,,لأحصل على الجسد الذي أريده
Dialogue: 0,0:16:38.90,0:16:41.20,نص عام,,0,0,0,,خادمتي فعلت شيئاً فظيعاً
Dialogue: 0,0:16:41.70,0:16:43.70,general text,,0,0,0,,باعتباري مالكها سأتحمل المسؤولية كاملة
Dialogue: 0,0:16:45.03,0:16:46.16,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:16:49.50,0:16:53.08,general text,,0,0,0,,ربما تكون منزعجًا من كسر اليشم الخاص بالخواتم
Dialogue: 0,0:16:54.29,0:16:56.63,نص عام,,0,0,0,,توسلت لأمي من أجل هذا اليشم،
Dialogue: 0,0:16:57.75,0:16:59.59,نص عام,,0,0,0,,لأن الخواتم مصنوعة منه
Dialogue: 0,0:16:59.67,0:17:01.84,نص عام,,0,0,0,,سيجعل الزواج طويلًا وسعيدًا
Dialogue: 0,0:17:02.80,0:17:04.18,نص عام,,0,0,0,,لكنه معطل
Dialogue: 0,0:17:04.26,0:17:06.43,نص عام,,0,0,0,,لم أكن أعلم أن لها مثل هذا المعنى العميق
Dialogue: 0,0:17:07.22,0:17:08.89,نص عام,,0,0,0,,يجب أن أقول إنني منزعج أيضًا
Dialogue: 0,0:17:10.39,0:17:14.48,نص عام,,0,0,0,,سوف نجد يشمًا أكثر ملاءمة للخواتم
Dialogue: 0,0:17:17.23,0:17:19.86,نص عام,,0,0,0,,أقبل اعتذارك
Dialogue: 0,0:17:20.48,0:17:22.65,نص عام,,0,0,0,,- يمكنك الذهاب\N- شكرًا لك.
Dialogue: 0,0:17:22.74,0:17:23.65,نص عام,,0,0,0,,لا أستطيع
Dialogue: 0,0:17:25.95,0:17:27.20,نص عام,,0,0,0,,يجب أن أجد مو ديوك
Dialogue: 0,0:17:30.08,0:17:32.41,النص العام,,0,0,0,,أريد العثور على هذه الخادمة الشريرة،
Dialogue: 0,0:17:32.91,0:17:35.12,نص عام,,0,0,0,,حتى تعيد يشم يين يانغ
Dialogue: 0,0:17:35.96,0:17:39.71,general text,,0,0,0,,هي ضعيفة، ساقاها قصيرتان، لا تستطيع الذهاب بعيداً
Dialogue: 0,0:17:41.01,0:17:44.34,نص عام,,0,0,0,,أرجو أن تسمحوا لي بالبحث عنه بنفسي
Dialogue: 0,0:17:48.97,0:17:50.31,نص عام,,0,0,0,,أسمح
Dialogue: 0,0:17:51.22,0:17:52.27,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,0:17:52.93,0:17:56.27,نص عام,,0,0,0,,الآن أود منك أن تفتح الباب
Dialogue: 0,0:17:58.56,0:18:00.15,نص عام,,0,0,0,,باب جينيوون,
Dialogue: 0,0:18:01.36,0:18:02.99,نص عام,,0,0,0,,مكان حفظ الآثار
Dialogue: 0,0:18:22.67,0:18:26.09,general text,,0,0,0,,فقط فرد من عائلة جين يمكنه فتح هذا الباب
Dialogue: 0,0:18:26.18,0:18:30.14,general text,,0,0,0,,الآن فقط أنا وتشو يونغ قادران على هذا
Dialogue: 0,0:18:30.93,0:18:33.06,نص عام,,0,0,0,,لا يمكنها أن تكون هناك
Dialogue: 0,0:18:33.14,0:18:34.64,نص عام,,0,0,0,,رأيت رؤيا
Dialogue: 0,0:18:37.52,0:18:39.02,نص عام,,0,0,0,,ربما كنت تحلم
Dialogue: 0,0:18:39.81,0:18:42.98,general text,,0,0,0,,لماذا أنت متأكد من أن الرؤيا خلقت من بقايا؟
Dialogue: 0,0:18:43.07,0:18:44.03,نص عام,,0,0,0,,لقد رأيته أيضاً
Dialogue: 0,0:18:45.95,0:18:47.78,نص عام,,0,0,0,,الرؤية في صورة مو دوك
Dialogue: 0,0:18:49.74,0:18:53.12,general text,,0,0,0,,جميع الآثار التي يمكن أن تخلقها الرؤى موجودة في جينيوون
Dialogue: 0,0:18:53.20,0:18:54.50,نص عام,,0,0,0,,دعونا نتحقق
Dialogue: 0,0:18:55.62,0:18:57.92,نص عام,,0,0,0,,حسنًا، سأفتح الباب
Dialogue: 0,0:18:59.46,0:19:03.25,نص عام,,0,0,0,,هذا المكان مليء بالآثار الخطيرة
Dialogue: 0,0:19:04.67,0:19:06.84,general text,,0,0,0,,قد يمتلكك الشر فلا تستطيع العودة
Dialogue: 0,0:19:08.26,0:19:10.64,نص عام,,0,0,0,,سيدي هذا خطير جداً
Dialogue: 0,0:19:11.80,0:19:13.51,خط مائل,,0,0,0,,سأذهب معه
Dialogue: 0,0:19:17.27,0:19:18.27,نص عام,,0,0,0,,سأذهب أيضًا
Dialogue: 0,0:19:23.07,0:19:24.32,نص عام,,0,0,0,,يبدو ممتعًا
Dialogue: 0,0:19:24.94,0:19:27.44,general text,,0,0,0,,متى ستتاح لك الفرصة للوصول إلى جينيوون؟
Dialogue: 0,0:19:51.80,0:19:53.18,نص عام,,0,0,0,,أدخل
Dialogue: 0,0:19:53.26,0:19:54.81,نص عام,,0,0,0,,لديك ساعة واحدة
Dialogue: 0,0:20:10.15,0:20:11.95,نص عام,,0,0,0,,يجب أن أخبر الرئيس
Dialogue: 0,0:20:15.99,0:20:17.12,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:20:18.00,0:20:19.33,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:20:24.42,0:20:26.88,نص عام,,0,0,0,,لذا هذا جينيوون
Dialogue: 0,0:20:27.67,0:20:31.76,general text,,0,0,0,,يقولون أن كل شيء هنا باهظ الثمن. لا يمكن لأي مبلغ من المال أن يشتريك
Dialogue: 0,0:20:31.84,0:20:34.22,نص عام,,0,0,0,,هل يمكنك أن تكون هادئاً؟ نحن لسنا في نزهة على الأقدام
Dialogue: 0,0:20:35.43,0:20:36.47,نص عام,,0,0,0,,هل أنت المالك؟
Dialogue: 0,0:20:37.56,0:20:40.68,general text,,0,0,0,,رغم أن هذا هو الحال إذا تزوجت جين تشو يونغ
Dialogue: 0,0:20:42.56,0:20:43.65,نص عام,,0,0,0,,محظوظ
Dialogue: 0,0:20:43.73,0:20:46.40,النص العام,,0,0,0,,كل هذه الجواهر ستكون لك يا جين ووك
Dialogue: 0,0:20:47.36,0:20:50.65,general text,,0,0,0,,إذا كنت تحسدني كثيرًا، فيمكنك أن تتزوجها بنفسك
Dialogue: 0,0:20:51.45,0:20:54.99,general text,,0,0,0,,ولكن حتى بعد أن تصبح المالك، كيف ستتحكم في كل هذا؟
Dialogue: 0,0:20:55.07,0:20:56.33,نص عام,,0,0,0,,ساحر منخفض الدرجة
Dialogue: 0,0:20:56.41,0:20:58.74,general text,,0,0,0,,إذا كنت رائعًا جدًا، هل يمكنك لمس شيء ما هنا؟
Dialogue: 0,0:20:59.62,0:21:02.62,general text,,0,0,0,,قال الرئيس جينيوون ألا تلمس أي شيء هنا
Dialogue: 0,0:21:02.71,0:21:05.71,نص عام,,0,0,0,,التبرير. أنت خائف فقط
Dialogue: 0,0:21:11.72,0:21:13.05,نص عام,,0,0,0,,- هذا هو\N- ما هذا؟
Dialogue: 0,0:21:13.13,0:21:14.55,نص عام,,0,0,0,,لا أعرف. ماذا كان هذا؟
Dialogue: 0,0:21:16.47,0:21:17.43,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:21:18.18,0:21:19.60,نص عام,,0,0,0,,شيء غريب هنا
Dialogue: 0,0:21:20.64,0:21:22.18,نص عام,,0,0,0,,ألست خائفًا؟
Dialogue: 0,0:21:23.44,0:21:24.77,نص عام,,0,0,0,,خائف
Dialogue: 0,0:21:25.94,0:21:27.77,نص عام,,0,0,0,,الجو مظلم هنا، كن حذرًا
Dialogue: 0,0:21:30.86,0:21:32.32,general text,,0,0,0,,هل كان خائفًا حقًا؟
Dialogue: 0,0:21:32.40,0:21:34.86,نص عام,,0,0,0,,نعم. عندما يشعر "يول" بالخوف، فإنه يخلط بين الاتجاه
Dialogue: 0,0:21:34.95,0:21:36.16,نص عام,,0,0,0,,يول، طريقة خاطئة!
Dialogue: 0,0:21:37.87,0:21:38.83,نص عام,,0,0,0,,من هنا
Dialogue: 0,0:21:39.58,0:21:41.62,نص عام,,0,0,0,,هناك نعم
Dialogue: 0,0:21:46.08,0:21:47.54,نص عام,,0,0,0,,فلنكن حذرين جميعاً
Dialogue: 0,0:21:50.80,0:21:52.17,خط مائل,,0,0,0,,يول هادئ جدًا دائمًا،
Dialogue: 0,0:21:52.88,0:21:55.34,خط مائل,,0,0,0,,وشارد الذهن عندما يخاف
Dialogue: 0,0:21:55.93,0:21:57.01,نص عام,,0,0,0,,شيء من هذا القبيل
Dialogue: 0,0:22:02.68,0:22:04.18,نص عام,,0,0,0,,فلنكن حذرين
Dialogue: 0,0:22:04.94,0:22:06.69,نص عام,,0,0,0,,كن نفسك
Dialogue: 0,0:22:08.19,0:22:09.61,نص عام,,0,0,0,,دعونا نذهب معًا
Dialogue: 0,0:22:46.73,0:22:48.48,نص عام,,0,0,0,,كيف انتهى بي الأمر محبوسًا هنا؟
Dialogue: 0,0:23:00.20,0:23:01.70,نص عام,,0,0,0,,كان علي أن أضبط نفسي
Dialogue: 0,0:23:03.37,0:23:05.37,النص العام,,0,0,0,,لم يكن هناك داعي لاستفزازها
Dialogue: 0,0:23:07.33,0:23:08.87,ذكريات بخط مائل,,0,0,0,,أخبرتك أن تكون حذراً
Dialogue: 0,0:23:08.96,0:23:12.00,ذكريات,,0,0,0,,انتظر هنا. سوف يأتي سيدك قريبا
Dialogue: 0,0:23:12.59,0:23:15.21,ذكريات,,0,0,0,,سيدتي ماذا سيحدث لي الآن؟
Dialogue: 0,0:23:15.30,0:23:18.38,ذكريات,,0,0,0,,وماذا أيضًا؟ سوف تتم معاقبتك
Dialogue: 0,0:23:19.18,0:23:21.43,ذكريات,,0,0,0,,ليس هذا ما يقلقني
Dialogue: 0,0:23:21.51,0:23:24.22,ذكريات,,0,0,0,,يقولون إذا كسرت يشم يين يانغ،
Dialogue: 0,0:23:24.31,0:23:27.06,ذكريات,,0,0,0,,لن تكون سعيدًا أبدًا في الزواج
Dialogue: 0,0:23:29.10,0:23:30.94,ذكريات,,0,0,0,,ماذا علي أن أفعل الآن؟
Dialogue: 0,0:23:32.11,0:23:33.98,ذكريات,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:23:34.07,0:23:35.40,ذكريات,,0,0,0,,لا تتحدث بالهراء
Dialogue: 0,0:23:36.53,0:23:38.28,ذكريات,,0,0,0,,يقولون إذا كسرت هذا اليشم،
Dialogue: 0,0:23:38.36,0:23:41.41,ذكريات,,0,0,0,,الشخص الذي تحبه لن يحبك أبدًا
Dialogue: 0,0:23:42.03,0:23:44.91,ذكريات,,0,0,0,,جميع الجيسينغ في جويسيونرو قالوا ذلك
Dialogue: 0,0:23:44.99,0:23:47.50,ذكريات,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:23:47.58,0:23:48.71,ذكريات,,0,0,0,,نعم
Dialogue: 0,0:23:49.37,0:23:53.17,ذكريات,,0,0,0,,ألا تعلمين يا سيدتي؟
Dialogue: 0,0:23:53.79,0:23:55.34,ذكريات,,0,0,0,,هذا لا يمكن أن يكون
Dialogue: 0,0:23:57.71,0:23:59.51,ذكريات,,0,0,0,,ثم ماذا سيحدث لي؟
Dialogue: 0,0:24:03.22,0:24:04.89,ذكريات,,0,0,0,,لماذا أنت قلقة،
Dialogue: 0,0:24:05.60,0:24:07.35,ذكريات,,0,0,0,,إذا كسرتها؟
Dialogue: 0,0:24:11.81,0:24:13.77,ذكريات,,0,0,0,,أنت من كسرها، أليس كذلك؟
Dialogue: 0,0:24:14.69,0:24:17.78,ذكريات,,0,0,0,,جعلوني أحمله لألومه على هذا
Dialogue: 0,0:24:18.65,0:24:19.61,ذكريات,,0,0,0,,هل أنا على حق؟
Dialogue: 0,0:24:20.86,0:24:24.45,ذكريات,,0,0,0,,مسكينة. كان يجب أن أقول شيئًا على الأقل لأمي في ذلك الوقت.
Dialogue: 0,0:24:25.12,0:24:27.41,ذكريات,,0,0,0,,إذا أذلت ابنتها أمام الجميع،
Dialogue: 0,0:24:28.20,0:24:30.37,ذكريات,,0,0,0,,لن تسامحني
Dialogue: 0,0:24:30.96,0:24:32.25,ذكريات,,0,0,0,,لست خائفًا منك،
Dialogue: 0,0:24:32.92,0:24:36.46,ذكريات,,0,0,0,,لكنني أخشى والدتك رأس جينيونغ
Dialogue: 0,0:24:39.76,0:24:41.26,ذكريات,,0,0,0,,هل أنت خائف جدًا من والدتك؟
Dialogue: 0,0:24:41.84,0:24:44.76,ذكريات,,0,0,0,,ربما أخاف من أمي، لكني أكرهك
Dialogue: 0,0:24:45.89,0:24:46.93,ذكريات,,0,0,0,,سأبيعك
Dialogue: 0,0:24:47.81,0:24:50.23,ذكريات بخط مائل,,0,0,0,,كما قلت، أمي مخيفة جدًا
Dialogue: 0,0:24:50.31,0:24:53.69,ذكريات,,0,0,0,,سوف يتم بيعك لكسر اليشم
Dialogue: 0,0:24:54.27,0:24:55.48,ذكريات,,0,0,0,,بعيد جداً!
Dialogue: 0,0:25:36.40,0:25:38.40,general text,,0,0,0,,هل هربت؟
Dialogue: 0,0:26:09.97,0:26:12.14,general text,,0,0,0,,ربما يجب أن أحاول تسلق الجدار؟
Dialogue: 0,0:26:50.72,0:26:52.76,التعليق الصوتي,,0,0,0,,كيف تمكنت من فتح باب جينيوون؟
Dialogue: 0,0:27:00.31,0:27:02.98,التعليق الصوتي,,0,0,0,,لذا هذا جينيوون
Dialogue: 0,0:27:06.57,0:27:10.12,general text,,0,0,0,,إذا حبستها بالداخل، قد تموت
Dialogue: 0,0:27:36.93,0:27:38.06,نص عام,,0,0,0,,يا
Dialogue: 0,0:27:45.36,0:27:46.82,نص عام,,0,0,0,,إذًا أنت
Dialogue: 0,0:27:51.03,0:27:52.53,نص عام,,0,0,0,,لم أراك منذ وقت طويل
Dialogue: 0,0:28:20.02,0:28:21.19,خط مائل,,0,0,0,,لن تتمكن من المغادرة
Dialogue: 0,0:28:23.19,0:28:24.44,خط مائل,,0,0,0,,لن ينكسر
Dialogue: 0,0:28:26.27,0:28:27.61,نص عام,,0,0,0,,لن ينجح الأمر!
Dialogue: 0,0:28:31.82,0:28:32.99,نص عام,,0,0,0,,اخرس
Dialogue: 0,0:28:43.42,0:28:46.92,خارج الإطار,,0,0,0,,هل ماتت حقًا لأنها لم يكن لديها سحر؟
Dialogue: 0,0:28:48.09,0:28:49.97,تعليق صوتي,,0,0,0,,ماذا لو كانت مجرد رؤية...
Dialogue: 0,0:28:54.05,0:28:55.14,نص عام,,0,0,0,,تشو يونغ
Dialogue: 0,0:28:56.39,0:29:00.31,النص العام,,0,0,0,,أسمع صوت كل تحركاتك
Dialogue: 0,0:29:02.19,0:29:03.31,نص عام,,0,0,0,,يبدو هكذا،
Dialogue: 0,0:29:03.81,0:29:06.06,نص عام,,0,0,0,,مثل اثنين من اليشم يضربان بعضهما البعض
Dialogue: 0,0:29:20.25,0:29:21.08,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:29:29.55,0:29:31.63,نص عام,,0,0,0,,مرت ساعة وعلينا الرحيل
Dialogue: 0,0:29:31.72,0:29:34.01,النص العام,,0,0,0,,لن أذهب إلى أي مكان، يجب أن أجدها
Dialogue: 0,0:29:34.09,0:29:37.47,general text,,0,0,0,,هذا المكان كبير جدًا، ولن نتمكن نحن الثلاثة من العثور عليها
Dialogue: 0,0:29:37.55,0:29:40.81,نص عام,,0,0,0,,لقد جئت إلى هنا لتنظر حولك على أية حال، حتى تتمكن من الذهاب
Dialogue: 0,0:29:42.68,0:29:44.48,general text,,0,0,0,,متى جاءتك رؤيا مو دوك؟
Dialogue: 0,0:29:45.52,0:29:47.31,نص عام,,0,0,0,,لا أعرف كيف ظهرت
Dialogue: 0,0:29:47.81,0:29:49.02,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:29:51.74,0:29:54.45,ذكريات,,0,0,0,,جئت لأنك اشتقت لي
Dialogue: 0,0:29:54.53,0:29:55.61,خط مائل,,0,0,0,,بالضبط
Dialogue: 0,0:29:55.70,0:29:56.87,نص عام,,0,0,0,,لقد أخبرتني بذلك أيضاً
Dialogue: 0,0:29:57.49,0:29:58.99,النص العام,,0,0,0,,لقد جاءت لأنني كنت أفكر فيها
Dialogue: 0,0:29:59.08,0:30:02.83,general text,,0,0,0,,فرؤيتها تأتي بالتفكير فيها؟
Dialogue: 0,0:30:03.58,0:30:04.83,نص عام,,0,0,0,,إذًا لم تراها
Dialogue: 0,0:30:05.50,0:30:07.08,مائل,,0,0,0,,جاءت إلي ويوليا،
Dialogue: 0,0:30:07.17,0:30:09.75,النص العام,,0,0,0,,ولكن ليس لك رغم أنك صاحبه
Dialogue: 0,0:30:09.84,0:30:12.63,general text,,0,0,0,,لماذا فكرت في مو ديوك أصلاً؟
Dialogue: 0,0:30:16.51,0:30:18.68,نص عام,,0,0,0,,شربت القرفة ونبيذ الزنجبيل
Dialogue: 0,0:30:18.76,0:30:21.77,general text,,0,0,0,,هل جعلتها ثملة لدرجة أن رائحة القرفة كانت على بعد متر؟
Dialogue: 0,0:30:21.85,0:30:22.81,نص عام,,0,0,0,,نعم
Dialogue: 0,0:30:23.81,0:30:25.77,النص العام,,0,0,0,,لقد أعطيتها ساشا أخرى في ذلك اليوم
Dialogue: 0,0:30:25.85,0:30:28.69,النص العام,,0,0,0,,لا بد أن رائحة القرفة جاءت منه
Dialogue: 0,0:30:29.69,0:30:30.94,نص عام,,0,0,0,,أوه، أنت تتحدث عن ذلك الكيس،
Dialogue: 0,0:30:31.73,0:30:34.40,general text,,0,0,0,,التي علقتها بالقرب من المرحاض لطرد الذباب؟
Dialogue: 0,0:30:35.07,0:30:36.49,نص عام,,0,0,0,,بالقرب من المرحاض؟
Dialogue: 0,0:30:36.57,0:30:39.87,النص العام,,0,0,0,,شكرًا لك يا صاحب السمو. إنه يبقي الذباب بعيدًا جيدًا
Dialogue: 0,0:30:41.79,0:30:44.33,general text,,0,0,0,,يول، ماذا كنت تفعل عندما جاءتك الرؤيا؟
Dialogue: 0,0:30:47.25,0:30:48.33,نص عام,,0,0,0,,مرآة
Dialogue: 0,0:30:49.63,0:30:52.09,النص العام,,0,0,0,,- مرآتي تحطمت\N- ومرآتي أيضاً
Dialogue: 0,0:30:54.92,0:30:56.76,نص عام,,0,0,0,,تظهر من المرآة؟
Dialogue: 0,0:30:59.09,0:31:00.26,نص عام,,0,0,0,,مرآة؟
Dialogue: 0,0:31:05.64,0:31:06.77,نص عام,,0,0,0,,هل هذا هو؟
Dialogue: 0,0:31:18.03,0:31:20.16,مائل,,0,0,0,,هذا ليس أنت، إنه مزيف
Dialogue: 0,0:31:20.24,0:31:21.45,نص عام,,0,0,0,,الرؤية
Dialogue: 0,0:31:30.42,0:31:31.84,نص عام,,0,0,0,,إذًا أنت
Dialogue: 0,0:31:37.92,0:31:39.72,النص العام,,0,0,0,,هل هي محبوسة في المرآة؟
Dialogue: 0,0:31:40.68,0:31:41.80,نص عام,,0,0,0,,نعم
Dialogue: 0,0:31:41.89,0:31:44.97,general text,,0,0,0,,لم نتمكن من رؤية ما بالداخل، لكننا متأكدون من أنها هناك.
Dialogue: 0,0:31:45.64,0:31:46.85,general text,,0,0,0,,لقد ابتلعتها مرآة توسكا
Dialogue: 0,0:31:48.02,0:31:49.27,نص عام,,0,0,0,,مرآة الشوق؟
Dialogue: 0,0:31:49.35,0:31:51.73,النص العام,,0,0,0,,هذا الأثر يخلق الرؤى
Dialogue: 0,0:31:52.36,0:31:53.69,خط مائل,,0,0,0,,استخدام المرايا الأخرى,
Dialogue: 0,0:31:53.77,0:31:56.36,نص عام,,0,0,0,,لإظهار ما يريد الإنسان رؤيته
Dialogue: 0,0:31:57.65,0:32:00.20,general text,,0,0,0,,ليس لديها سحر، لذا لا بد أنه استهلكها،
Dialogue: 0,0:32:00.28,0:32:01.66,نص عام,,0,0,0,,عندما نظرت إليه
Dialogue: 0,0:32:03.37,0:32:05.70,general text,,0,0,0,,نحن بحاجة إلى استخراج مو دوك من المرآة
Dialogue: 0,0:32:05.79,0:32:09.25,general text,,0,0,0,,تعاويذنا لن تنجح لأن الطاقة بداخلها قوية جدًا
Dialogue: 0,0:32:10.67,0:32:12.46,نص عام,,0,0,0,,من فضلك أخرج مرآة توسكا من جينيون
Dialogue: 0,0:32:13.50,0:32:14.67,نص عام,,0,0,0,,هذا مستحيل
Dialogue: 0,0:32:16.00,0:32:17.96,النص العام,,0,0,0,,بقايا ابتلعت رجلاً
Dialogue: 0,0:32:18.05,0:32:20.01,نص عام,,0,0,0,,إن إخراج المرآة من هناك خطير جدًا
Dialogue: 0,0:32:21.47,0:32:23.26,نص عام,,0,0,0,,آمرك ولياً للعهد
Dialogue: 0,0:32:23.35,0:32:24.47,نص عام,,0,0,0,,خذ المرآة للخارج
Dialogue: 0,0:32:26.93,0:32:30.73,general text,,0,0,0,,لقد أعطانا المجلس الموحد تميمة لحماية جينيون
Dialogue: 0,0:32:30.81,0:32:32.94,نص عام,,0,0,0,,تحديدًا في مثل هذه المواقف
Dialogue: 0,0:32:35.86,0:32:39.15,النص العام,,0,0,0,,لا أستطيع التحمل حتى بأمر الملك
Dialogue: 0,0:32:41.99,0:32:43.49,نص عام,,0,0,0,,المملكة المتحدة لن تعمل
Dialogue: 0,0:32:44.66,0:32:45.95,نص عام,,0,0,0,,بدون مو دوك
Dialogue: 0,0:32:46.03,0:32:48.50,general text,,0,0,0,,إذن سيتعين عليه البقاء في الداخل.
Dialogue: 0,0:32:49.33,0:32:51.71,نص عام,,0,0,0,,عندما تقوم الساعة،
Dialogue: 0,0:32:51.79,0:32:53.67,نص عام,,0,0,0,,سأغلق الباب
Dialogue: 0,0:32:56.80,0:32:57.71,نص عام,,0,0,0,,الأم
Dialogue: 0,0:32:58.59,0:33:00.59,نص عام,,0,0,0,,لقد وجدت يشم يين يانغ
Dialogue: 0,0:33:04.43,0:33:05.97,النص العام,,0,0,0,,مو دوك لم يسرقها
Dialogue: 0,0:33:07.01,0:33:08.56,خط مائل,,0,0,0,,لقد وجدته،
Dialogue: 0,0:33:08.64,0:33:11.14,مائل,,0,0,0,,أخرج مرآة Melancholy وأنقذ Moo Deok.
Dialogue: 0,0:33:11.23,0:33:13.94,general text,,0,0,0,,سيموت تشان ووك إذا تم حبسه بالداخل
Dialogue: 0,0:33:14.73,0:33:15.81,نص عام,,0,0,0,,لا تتدخل
Dialogue: 0,0:33:17.77,0:33:20.86,النص العام,,0,0,0,,بمجرد انتهاء الوقت الموعود، سأغلق الباب
Dialogue: 0,0:33:36.58,0:33:38.09,خط مائل,,0,0,0,,لا تهدر طاقتك
Dialogue: 0,0:33:38.17,0:33:40.26,نص عام,,0,0,0,,أنت تعلم أنك لا تستطيع كسره
Dialogue: 0,0:33:40.34,0:33:42.26,نص عام,,0,0,0,,اخرس! أنت مجرد رؤية
Dialogue: 0,0:33:42.34,0:33:44.84,النص العام,,0,0,0,,نعم أنا رؤيا
Dialogue: 0,0:33:46.09,0:33:47.93,نص عام,,0,0,0,,الرؤية التي تظهر حقيقتك
Dialogue: 0,0:33:52.52,0:33:55.31,النص العام,,0,0,0,,لا يستطيع الإنسان النظر إلى نفسه من الخارج
Dialogue: 0,0:33:55.40,0:33:57.77,النص العام,,0,0,0,,فقط المرآة يمكنها مساعدتهم في هذا
Dialogue: 0,0:33:58.94,0:34:01.44,نص عام,,0,0,0,,لذلك فكرتك عن نفسك
Dialogue: 0,0:34:02.57,0:34:04.24,نص عام,,0,0,0,,أيضاً مجرد رؤية
Dialogue: 0,0:34:07.95,0:34:10.99,النص العام,,0,0,0,,هكذا ينظر الآخرون إليك
Dialogue: 0,0:34:11.87,0:34:15.87,general text,,0,0,0,,إنهم لا يرون إلا ما يريدون، ويقومون بأنفسهم بإنشاء الصورة التي يحتاجونها
Dialogue: 0,0:34:18.54,0:34:19.88,نص عام,,0,0,0,,وهذه رؤية أيضًا
Dialogue: 0,0:34:20.55,0:34:21.92,نص عام,,0,0,0,,إذا كنت تقول الحقيقة،
Dialogue: 0,0:34:23.09,0:34:25.59,نص عام,,0,0,0,,مما يعني أن الناس لا يرون سوى الرؤى وليس أكثر.
Dialogue: 0,0:34:26.84,0:34:27.84,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:34:28.68,0:34:31.72,general text,,0,0,0,,أتحول إلى أكثر ما يريدون رؤيته وأريه لهم
Dialogue: 0,0:34:36.06,0:34:37.73,نص عام,,0,0,0,,سأفعل نفس الشيء معك
Dialogue: 0,0:34:45.15,0:34:46.70,نص عام,,0,0,0,,أعطني طاقتك
Dialogue: 0,0:34:46.78,0:34:47.82,نص عام,,0,0,0,,ثم أنا
Dialogue: 0,0:34:49.03,0:34:51.41,النص العام,,0,0,0,,سوف أتحول إلى النسخة المثالية منك
Dialogue: 0,0:34:57.04,0:34:58.21,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:34:59.71,0:35:02.71,النص العام,,0,0,0,,أنت بحاجة إلى تفكيري لتخلق مثل هذه الرؤية
Dialogue: 0,0:35:03.96,0:35:05.13,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:35:05.72,0:35:07.51,نص عام,,0,0,0,,إذا لم يكن هناك شيء للتفكير فيه،
Dialogue: 0,0:35:09.39,0:35:10.93,نص عام,,0,0,0,,ستصبح المرآة عديمة الفائدة
Dialogue: 0,0:35:31.28,0:35:33.83,نص عام,,0,0,0,,أنت مجرد قطعة زجاج
Dialogue: 0,0:35:35.58,0:35:37.16,نص عام,,0,0,0,,كفى كلاماً
Dialogue: 0,0:35:38.33,0:35:39.58,نص عام,,0,0,0,,مو دوك!
Dialogue: 0,0:35:40.75,0:35:42.34,نص عام,,0,0,0,,هل أنت هناك؟
Dialogue: 0,0:35:44.00,0:35:45.13,خط مائل,,0,0,0,,مو دوك!
Dialogue: 0,0:35:46.71,0:35:47.88,نص عام,,0,0,0,,تشان ووك
Dialogue: 0,0:35:50.64,0:35:51.68,نص عام,,0,0,0,,تشان ووك!
Dialogue: 0,0:35:53.56,0:35:55.31,خط مائل,,0,0,0,,تشان ووك، أنا هنا
Dialogue: 0,0:35:57.52,0:35:58.77,نص عام,,0,0,0,,تم العثور عليه
Dialogue: 0,0:36:06.19,0:36:07.82,خط مائل,,0,0,0,,انتهى الوقت
Dialogue: 0,0:36:08.49,0:36:10.66,نص عام,,0,0,0,,تشو يونغ، أغلق الباب
Dialogue: 0,0:36:10.74,0:36:11.82,نص عام,,0,0,0,,الأم
Dialogue: 0,0:36:12.82,0:36:15.41,نص عام,,0,0,0,,- الآن{\i1}\N- يرجى الانتظار
Dialogue: 0,0:36:27.30,0:36:28.88,نص عام,,0,0,0,,أريد تسجيل الدخول
Dialogue: 0,0:36:30.34,0:36:32.30,مائل,,0,0,0,,إذا لم يكن بالإمكان أخذ الأثر إلى الخارج،
Dialogue: 0,0:36:32.39,0:36:36.76,general text,,0,0,0,,ثم سأدخل بنفسي هناك وأخرجها من المرآة
Dialogue: 0,0:36:36.85,0:36:39.93,النص العام,,0,0,0,,كيف يمكنني السماح لساحر قوي بالدخول؟
Dialogue: 0,0:36:40.02,0:36:41.31,نص عام,,0,0,0,,صدقني
Dialogue: 0,0:36:42.10,0:36:44.69,النص العام,,0,0,0,,لن أضع إصبعي على قطعة أثرية واحدة
Dialogue: 0,0:36:44.77,0:36:46.15,نص عام,,0,0,0,,لا أعرف حتى
Dialogue: 0,0:36:46.23,0:36:49.53,general text,,0,0,0,,الساحر من سوسنوفي بور قد خذل ثقتي بالفعل
Dialogue: 0,0:36:51.65,0:36:55.07,general text,,0,0,0,,هل سمحت بالفعل لساحر غابة الصنوبر بالدخول إلى جينيوون؟
Dialogue: 0,0:36:57.99,0:36:59.70,النص العام,,0,0,0,,إذا كنت تريد إنقاذ تشان ووك،
Dialogue: 0,0:36:59.79,0:37:03.54,general text,,0,0,0,,سيتعين عليك أن تطلب من سحرة جيونجينغاك إخراجه من هناك.
Dialogue: 0,0:37:07.71,0:37:08.76,نص عام,,0,0,0,,الفصل,
Dialogue: 0,0:37:08.84,0:37:10.01,نص عام,,0,0,0,,ليس لدينا الكثير من الوقت
Dialogue: 0,0:37:13.55,0:37:15.93,نص عام,,0,0,0,,يول، أريدك أن تدخل
Dialogue: 0,0:37:16.68,0:37:18.26,نص عام,,0,0,0,,وأخرج أوكا من هناك
Dialogue: 0,0:37:23.81,0:37:24.94,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:37:26.02,0:37:27.36,نص عام,,0,0,0,,بينما كنت بعيدًا،
Dialogue: 0,0:37:28.61,0:37:30.24,نص عام,,0,0,0,,كنت أفكر فيه
Dialogue: 0,0:37:31.95,0:37:33.24,نص عام,,0,0,0,,ماذا يمكنني أن أفعل،
Dialogue: 0,0:37:34.57,0:37:36.66,خط مائل,,0,0,0,,لإبقائك قريبًا
Dialogue: 0,0:37:39.95,0:37:41.83,النص العام,,0,0,0,,إذا أصبحت غوانغجو جيونبوغوان،
Dialogue: 0,0:37:43.75,0:37:45.42,النص العام,,0,0,0,,يمكنك أن تصبح نائبي
Dialogue: 0,0:37:46.33,0:37:48.00,نص عام,,0,0,0,,لماذا أحتاج هذا؟
Dialogue: 0,0:37:48.09,0:37:50.76,مائل,,0,0,0,,قلت أنك لا تريدين أن تظلي خادمتي
Dialogue: 0,0:37:50.84,0:37:53.68,نص عام,,0,0,0,,لا نستطيع أن نقول لأحد أنك أستاذي
Dialogue: 0,0:37:53.76,0:37:56.30,النص العام,,0,0,0,,ولكن يمكنك البقاء إذا أصبحت مساعدتي
Dialogue: 0,0:37:56.39,0:37:59.51,general text,,0,0,0,,هل سيحتفظ غوانغجو جيونغبوغوان ببدوٍ بجانبه؟
Dialogue: 0,0:38:01.47,0:38:02.68,نص عام,,0,0,0,,هل أنت مجنون؟
Dialogue: 0,0:38:05.90,0:38:08.27,نص عام,,0,0,0,,فكرت في هذا عندما سمعت خبر زفافي
Dialogue: 0,0:38:09.27,0:38:11.23,general text,,0,0,0,"أخيرًا أصبح لديه طريق للهروب"
Dialogue: 0,0:38:12.32,0:38:14.07,نص عام,,0,0,0,"كيف سأعيش بدونه؟"
Dialogue: 0,0:38:15.82,0:38:17.74,نص عام,,0,0,0,,أنا متأكد أنك شعرت بالضياع
Dialogue: 0,0:38:23.71,0:38:25.33,النص العام,,0,0,0,,عندما لا تكون بالجوار، ولا أنا كذلك
Dialogue: 0,0:38:27.67,0:38:28.96,نص عام,,0,0,0,,الشعور بالضياع
Dialogue: 0,0:38:43.89,0:38:45.06,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:38:47.15,0:38:48.44,نص عام,,0,0,0,,اشتقت لك
Dialogue: 0,0:39:22.43,0:39:24.18,ذكريات بخط مائل,,0,0,0,,إذا قبضوا علي، فتظاهر بأنك لا تعرف شيئًا
Dialogue: 0,0:39:25.02,0:39:27.85,ذكريات,,0,0,0,,لن يسمح أحد هنا لهذا الوحش بمهاجمتي
Dialogue: 0,0:39:34.19,0:39:35.90,ذكريات بخط مائل,,0,0,0,,إذن ساعدني
Dialogue: 0,0:39:35.99,0:39:37.86,ذكريات بخط مائل,,0,0,0,,اصعد هناك
Dialogue: 0,0:39:38.53,0:39:39.36,ذكريات,,0,0,0,,حسنًا
Dialogue: 0,0:39:39.45,0:39:42.91,ذكريات,,0,0,0,,سأخذك إلى أعلى هذه الشجرة
Dialogue: 0,0:40:15.78,0:40:16.69,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:40:17.19,0:40:18.19,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:40:20.49,0:40:21.66,خط مائل,,0,0,0,,إنها هنا
Dialogue: 0,0:40:21.74,0:40:22.95,خط مائل,,0,0,0,,من؟
Dialogue: 0,0:40:23.53,0:40:25.49,مائل,,0,0,0,,إنها هي، الفتاة العمياء!
Dialogue: 0,0:40:26.33,0:40:27.70,خط مائل,,0,0,0,,إنه حجر جليدي!
Dialogue: 0,0:40:32.00,0:40:33.50,نص عام,,0,0,0,,سوف تتكسر المرآة إلى أجزاء
Dialogue: 0,0:40:34.21,0:40:35.13,نص عام,,0,0,0,,ابتعد
Dialogue: 0,0:41:38.86,0:41:39.90,خط مائل,,0,0,0,,سيد.
Dialogue: 0,0:41:40.40,0:41:41.65,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:41:41.74,0:41:44.07,النص العام,,0,0,0,,- هل أنت بخير؟\N- كل شيء على ما يرام
Dialogue: 0,0:41:44.16,0:41:46.07,general text,,0,0,0,,- هل مو دوك آمن؟\N- بالطبع
Dialogue: 0,0:42:15.31,0:42:17.90,نص عام,,0,0,0,,تعثرت وأنا أحمل يشم يين يانغ
Dialogue: 0,0:42:19.02,0:42:21.36,نص عام,,0,0,0,,أعتقد أنه انكسر إذن
Dialogue: 0,0:42:22.65,0:42:25.49,general text,,0,0,0,,لذلك حاولت إلقاء اللوم على الخادمة بسبب اليشم المكسور بالفعل
Dialogue: 0,0:42:27.32,0:42:28.57,نص عام,,0,0,0,,ومرآة توسكا؟
Dialogue: 0,0:42:29.78,0:42:31.70,نص عام,,0,0,0,,وكان يقف بالقرب،
Dialogue: 0,0:42:31.79,0:42:33.50,نص عام,,0,0,0,,لكنني لم أتطرق إليه حتى
Dialogue: 0,0:42:34.12,0:42:37.17,general text,,0,0,0,,المملكة المتحدة ليست قوية بما يكفي لكسرها
Dialogue: 0,0:42:38.08,0:42:39.54,مائل,,0,0,0,,إذن يجب أن يكون،
Dialogue: 0,0:42:39.63,0:42:42.80,general text,,0,0,0,,لقد أتلفت المرآة أثناء السقوط
Dialogue: 0,0:42:46.93,0:42:48.26,نص عام,,0,0,0,,آ مو ديوك
Dialogue: 0,0:42:49.05,0:42:51.97,general text,,0,0,0,,هل حبست نفسك أيضًا في جينيون؟
Dialogue: 0,0:42:52.06,0:42:55.69,general text,,0,0,0,,أنا من أغلقت الباب، لكنها دخلت بنفسها
Dialogue: 0,0:42:55.77,0:42:59.52,general text,,0,0,0,,فقط أفراد عائلة جين هم من يمكنهم فتح أبواب جينيوون
Dialogue: 0,0:43:01.19,0:43:02.69,general text,,0,0,0,,هل تقول أن مو دوك كان قادرًا على فتحهما؟
Dialogue: 0,0:43:04.78,0:43:06.20,نص عام,,0,0,0,,ربما إذن،
Dialogue: 0,0:43:07.15,0:43:08.78,نص عام,,0,0,0,,فتحتهم
Dialogue: 0,0:43:09.57,0:43:12.45,نص عام,,0,0,0,,لقد رأيتها للتو تدخل إلى هناك وأغلقت الباب غاضبة
Dialogue: 0,0:43:15.12,0:43:16.16,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:43:17.71,0:43:19.08,نص عام,,0,0,0,,سأقول،
Dialogue: 0,0:43:20.67,0:43:23.59,نص عام,,0,0,0,,حتى لا يتحدث أحد عما حدث
Dialogue: 0,0:43:26.13,0:43:29.14,general text,,0,0,0,,لن أقول أي شيء أيضاً،\Nحتى لا أفسد سمعتك
Dialogue: 0,0:43:30.39,0:43:32.14,نص عام,,0,0,0,,خالص اعتذاري
Dialogue: 0,0:43:36.06,0:43:37.31,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:43:38.06,0:43:39.40,نص عام,,0,0,0,,أما زلت لا ترى أي شيء؟
Dialogue: 0,0:43:41.23,0:43:42.15,نص عام,,0,0,0,,لا
Dialogue: 0,0:43:42.73,0:43:44.98,نص عام,,0,0,0,,عندما انكسرت المرآة، كان الضوء ساطعًا جدًا
Dialogue: 0,0:43:45.61,0:43:47.15,نص عام,,0,0,0,,لا أستطيع فتح عيني
Dialogue: 0,0:43:50.45,0:43:52.37,نص عام,,0,0,0,,نحن بحاجة إلى تغطية عينيك
Dialogue: 0,0:43:56.00,0:43:57.12,نص عام,,0,0,0,,هنا
Dialogue: 0,0:44:01.54,0:44:05.34,general text,,0,0,0,,إذا نظرت إلى الشمس لفترة طويلة، فمن الممكن أن تفقد رؤيتك لفترة من الوقت.
Dialogue: 0,0:44:06.09,0:44:07.30,نص عام,,0,0,0,,سوف تتحسن قريبًا
Dialogue: 0,0:44:09.05,0:44:10.55,نص عام,,0,0,0,,سامحوني
Dialogue: 0,0:44:11.14,0:44:12.60,نص عام,,0,0,0,,ليس خطأك
Dialogue: 0,0:44:13.39,0:44:14.97,نص عام,,0,0,0,,كل هذا خطأ السيدة جين
Dialogue: 0,0:44:25.65,0:44:27.49,مائل,,0,0,0,,مو دوك، هل أنت بخير؟
Dialogue: 0,0:44:28.32,0:44:30.78,النص العام,,0,0,0,,ماذا تفعل هنا يا سيد دان جو؟
Dialogue: 0,0:44:32.57,0:44:33.99,نص عام,,0,0,0,,كنت قلقة
Dialogue: 0,0:44:34.62,0:44:35.99,خط مائل,,0,0,0,,لقد جرحت عيني
Dialogue: 0,0:44:36.58,0:44:38.20,نص عام,,0,0,0,,سيد. يول، هل أتيت أيضًا؟
Dialogue: 0,0:44:42.71,0:44:45.84,general text,,0,0,0,,دعهم يفحصونك في سيجوكون، وسوف آخذك إلى هناك
Dialogue: 0,0:44:45.92,0:44:47.84,مائل,,0,0,0,,القصر ليس بعيدًا، يمكنها الذهاب إلى هناك
Dialogue: 0,0:44:48.34,0:44:50.59,general text,,0,0,0,,صاحب السمو، هل أنت هنا أيضًا؟
Dialogue: 0,0:44:56.10,0:44:57.85,النص العام,,0,0,0,,سأزودك بمعالجي الملك
Dialogue: 0,0:44:58.47,0:44:59.85,خط مائل,,0,0,0,,ليس هناك حاجة
Dialogue: 0,0:44:59.93,0:45:03.19,general text,,0,0,0,,أعمىها النور ولم تتضرر عيناها
Dialogue: 0,0:45:04.23,0:45:07.36,general text,,0,0,0,,أعلم أن هذا ليس خطأك،\Nلكنهم أتوا إلى هنا بسببك
Dialogue: 0,0:45:07.44,0:45:10.15,نص عام,,0,0,0,,فأعتذر وأشكر الجميع
Dialogue: 0,0:45:13.20,0:45:14.66,نص عام,,0,0,0,,آسف على إزعاجك
Dialogue: 0,0:45:15.32,0:45:16.83,نص عام,,0,0,0,,شكرًا جزيلا لك
Dialogue: 0,0:45:29.30,0:45:30.42,نص عام,,0,0,0,,ماجستير...
Dialogue: 0,0:45:32.01,0:45:33.05,نص عام,,0,0,0,,دعونا نعود للمنزل
Dialogue: 0,0:45:57.24,0:45:59.20,نص عام,,0,0,0,,بعد ما حدث
Dialogue: 0,0:46:00.41,0:46:03.21,نص عام,,0,0,0,,لا أعرف ماذا سيحدث لحفل الزفاف
Dialogue: 0,0:46:03.29,0:46:04.67,نص عام,,0,0,0,,هل سمعت ما قالته؟
Dialogue: 0,0:46:05.50,0:46:08.50,general text,,0,0,0,,كانت مستعدة لإغلاق الباب رغم وجود السيد بالداخل.
Dialogue: 0,0:46:09.13,0:46:10.25,نص عام,,0,0,0,,يا له من رعب
Dialogue: 0,0:46:10.34,0:46:13.34,general text,,0,0,0,,يخشى أن يكون لديه مثل هذه الحماة
Dialogue: 0,0:46:13.42,0:46:15.51,general text,,0,0,0,,لقد فعلت هذا لحماية جينيوون
Dialogue: 0,0:46:16.26,0:46:18.26,مائل,,0,0,0,,عندما يكون لديك شيء تحميه،
Dialogue: 0,0:46:18.35,0:46:21.47,نص عام,,0,0,0,,أحيانًا يتعين عليك اتخاذ قرارات صعبة
Dialogue: 0,0:46:22.14,0:46:23.31,نص عام,,0,0,0,,لذا...
Dialogue: 0,0:46:24.31,0:46:25.94,نص عام,,0,0,0,,هل ستفعل الشيء نفسه؟
Dialogue: 0,0:46:27.35,0:46:30.23,نص عام,,0,0,0,,أجرؤ على القول إنني وأنا قريبان
Dialogue: 0,0:46:30.32,0:46:33.74,نص عام,,0,0,0,,لو كنت بالداخل؟ هل ستغلق الباب؟
Dialogue: 0,0:46:34.61,0:46:35.53,نص عام,,0,0,0,,إلى هذا الحد؟
Dialogue: 0,0:46:40.16,0:46:41.29,نص عام,,0,0,0,,حقاً...
Dialogue: 0,0:46:42.16,0:46:43.37,نص عام,,0,0,0,,يبدو أنك ستفعل هذا
Dialogue: 0,0:46:44.75,0:46:46.87,general text,,0,0,0,,حتى لو كانت حياتي على المحك؟
Dialogue: 0,0:46:46.96,0:46:49.42,نص عام,,0,0,0,,لا تضعني في موقف صعب
Dialogue: 0,0:46:50.63,0:46:52.25,نص عام,,0,0,0,,بسبب حدث وهمي
Dialogue: 0,0:46:52.34,0:46:54.17,نص عام,,0,0,0,,لست مقفلاً حقًا
Dialogue: 0,0:46:54.92,0:46:57.30,خط مائل,,0,0,0,,من الصعب أن تكذب وتقول،
Dialogue: 0,0:46:57.38,0:46:59.60,النص العام,,0,0,0,,- أنك لن تغلق الباب أبدًا؟{\i1}\N- لا أستطيع
Dialogue: 0,0:47:00.10,0:47:03.64,نص عام,,0,0,0,,أكذب عليك
Dialogue: 0,0:47:05.60,0:47:06.77,نص عام,,0,0,0,,بالضبط
Dialogue: 0,0:47:07.81,0:47:09.86,نص عام,,0,0,0,,هذا ما يجب عليك فعله
Dialogue: 0,0:47:14.36,0:47:16.45,نص عام,,0,0,0,,يجب أن تلقي التحية على السيد.
Dialogue: 0,0:47:17.11,0:47:20.91,النص العام,,0,0,0,,الأمر لا يستحق كل هذا العناء، ليس لدي ما أقوله له
Dialogue: 0,0:47:22.12,0:47:24.29,النص العام,,0,0,0,,لا أستطيع أن أتصرف وكأن كل شيء على ما يرام
Dialogue: 0,0:47:25.08,0:47:28.17,نص عام,,0,0,0,,فهمت. شكرا على كل شيء
Dialogue: 0,0:47:28.75,0:47:29.58,خط مائل,,0,0,0,,حان الوقت بالنسبة لك
Dialogue: 0,0:47:39.09,0:47:40.34,نص عام,,0,0,0,,لكن مع ذلك أيتها الخادمة كيم،
Dialogue: 0,0:47:42.72,0:47:44.31,نص عام,,0,0,0,,إذا اضطررت لإغلاق الباب،
Dialogue: 0,0:47:45.81,0:47:47.43,نص عام,,0,0,0,,من شأنه أن يكسر قلبي
Dialogue: 0,0:47:50.15,0:47:51.52,نص عام,,0,0,0,,إلى أجزاء
Dialogue: 0,0:47:59.15,0:48:01.95,نص عام,,0,0,0,,غير مرن وبطيء الفهم
Dialogue: 0,0:48:04.16,0:48:06.79,general text,,0,0,0,،"كيف يمكنني إغلاق الباب إذا كنت بالداخل؟"
Dialogue: 0,0:48:08.25,0:48:10.37,نص عام,,0,0,0,,ألا أستطيع قول ذلك فحسب؟
Dialogue: 0,0:48:25.68,0:48:26.93,نص عام,,0,0,0,,كان الأمر خطيرًا
Dialogue: 0,0:48:28.68,0:48:30.44,خط مائل,,0,0,0,,أدخل جينيوون
Dialogue: 0,0:48:30.52,0:48:33.11,النص العام,,0,0,0,,كان تصرفاً طفولياً طائشاً
Dialogue: 0,0:48:33.19,0:48:34.77,نص عام,,0,0,0,,لا تغضب كثيراً
Dialogue: 0,0:48:36.36,0:48:38.36,نص عام,,0,0,0,,قد تعتقد أنني مثير للشفقة،
Dialogue: 0,0:48:39.45,0:48:40.57,نص عام,,0,0,0,,ولكن هذه مجرد رؤيتك
Dialogue: 0,0:48:42.62,0:48:43.45,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:48:43.53,0:48:45.70,general text,,0,0,0,,أخبرتني المرآة في جينيون،
Dialogue: 0,0:48:46.29,0:48:48.16,نص عام,,0,0,0,,أن الناس لا يرون إلا ما
Dialogue: 0,0:48:48.25,0:48:50.50,نص عام,,0,0,0,,ماذا يريدون
Dialogue: 0,0:48:51.46,0:48:52.50,نص عام,,0,0,0,,هذه رؤية
Dialogue: 0,0:48:52.58,0:48:54.75,general text,,0,0,0,,هل تريد أن تقول إنك بمثابة رؤيا بالنسبة لي؟
Dialogue: 0,0:48:54.84,0:48:55.92,نص عام,,0,0,0,,إذا لم يكن الأمر كذلك،
Dialogue: 0,0:48:57.13,0:48:59.17,النص العام,,0,0,0,,لماذا تريدني أن أجلس خاملاً؟
Dialogue: 0,0:49:02.55,0:49:04.26,النص العام,,0,0,0,,طوال حياتي كنت أحاول يائسًا
Dialogue: 0,0:49:05.26,0:49:07.64,نص عام,,0,0,0,,أثبت للجميع أنني ابن أبي
Dialogue: 0,0:49:07.72,0:49:08.68,نص عام,,0,0,0,,لكن
Dialogue: 0,0:49:09.98,0:49:11.23,نص عام,,0,0,0,,قلت أن هذا غير صحيح
Dialogue: 0,0:49:11.31,0:49:13.27,النص العام,,0,0,0,,آلمني لكنه ساعدني على التخلص من الأوهام
Dialogue: 0,0:49:13.98,0:49:15.48,خط مائل,,0,0,0,,لكن حتى بعد كل شيء،
Dialogue: 0,0:49:15.56,0:49:17.73,general text,,0,0,0,,لماذا تريدني أن أبقى رؤيا؟
Dialogue: 0,0:49:17.82,0:49:19.32,نص عام,,0,0,0,,لا يهمني من أنت
Dialogue: 0,0:49:20.65,0:49:22.32,نص عام,,0,0,0,,أريد شيئًا واحدًا فقط
Dialogue: 0,0:49:23.41,0:49:24.78,النص العام,,0,0,0,,دمتم سالمين...
Dialogue: 0,0:49:26.28,0:49:27.83,نص عام,,0,0,0,,من الأخطار
Dialogue: 0,0:49:32.16,0:49:35.63,النص العام,,0,0,0,,لقد فقد هدفي الآن كل معنى
Dialogue: 0,0:49:37.92,0:49:39.34,نص عام,,0,0,0,,فمن الآن فصاعدا...
Dialogue: 0,0:49:40.84,0:49:42.34,نص عام,,0,0,0,,سأحاول
Dialogue: 0,0:49:43.80,0:49:45.18,نص عام,,0,0,0,,اكتشف من أنا
Dialogue: 0,0:49:46.72,0:49:48.22,نص عام,,0,0,0,,ومن يجب أن يصبح
Dialogue: 0,0:50:19.59,0:50:20.88,نص عام,,0,0,0,,هل ترى الآن؟
Dialogue: 0,0:50:21.76,0:50:23.76,نص عام,,0,0,0,,نعم. أرى
Dialogue: 0,0:50:28.60,0:50:29.51,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:50:29.60,0:50:31.89,general text,,0,0,0,,قيل لي أن تلك المرآة تلعب بالخيال
Dialogue: 0,0:50:31.97,0:50:34.81,نص عام,,0,0,0,,كان علي أن أتحقق مما إذا كنت قد أنقذتك حقًا
Dialogue: 0,0:50:36.19,0:50:38.61,نص عام,,0,0,0,,أنت لم تنقذني. لقد كسرته وخرجت بنفسي
Dialogue: 0,0:50:39.48,0:50:40.32,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:50:40.40,0:50:42.15,نص عام,,0,0,0,,عندما علقت في المرآة،
Dialogue: 0,0:50:42.82,0:50:45.07,النص العام,,0,0,0,,في لحظة عادت لي قوتي،
Dialogue: 0,0:50:45.15,0:50:46.91,نص عام,,0,0,0,,كما في بحيرة جيونج تشونج دايهو
Dialogue: 0,0:50:47.91,0:50:50.20,النص العام,,0,0,0,,أنا متأكد أنني كسرت المرآة بقوتي
Dialogue: 0,0:50:50.28,0:50:51.87,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:50:51.95,0:50:54.04,نص عام,,0,0,0,,كنت سعيدًا جدًا، اعتقدت أنني أنقذتك
Dialogue: 0,0:50:54.12,0:50:55.21,نص عام,,0,0,0,,مدرت شفتي
Dialogue: 0,0:50:55.29,0:50:57.92,النص العام,,0,0,0,,يجب أن تكون ممتنًا لأنك لم تنجرف إلى هذا الأمر
Dialogue: 0,0:50:58.00,0:51:01.00,النص العام,,0,0,0,,كنت بالداخل، كنت أفكر في الأمر
Dialogue: 0,0:51:01.09,0:51:02.63,نص عام,,0,0,0,,ما هذا الهراء
Dialogue: 0,0:51:03.13,0:51:05.05,النص العام,,0,0,0,,لن يستبدلني بك
Dialogue: 0,0:51:05.13,0:51:07.47,نص عام,,0,0,0,,ماذا لو امتصتني؟ إذن هذه ليست كذبة؟
Dialogue: 0,0:51:07.55,0:51:08.93,النص العام,,0,0,0,,حسنًا، إذن كنت سأنجو
Dialogue: 0,0:51:09.01,0:51:10.35,نص عام,,0,0,0,,وسأموت!
Dialogue: 0,0:51:12.10,0:51:15.10,نص عام,,0,0,0,,اسمع أيها الطالب. عندما يكون الوضع ميئوسا منه،
Dialogue: 0,0:51:15.18,0:51:18.40,النص العام,,0,0,0,,الحل الأمثل هو أن تضحي بنفسك وتنقذني
Dialogue: 0,0:51:18.48,0:51:19.81,نص عام,,0,0,0,,نعم، الآن!
Dialogue: 0,0:51:21.27,0:51:22.65,النص العام,,0,0,0,,إذا مت، فعليك أنت أيضًا
Dialogue: 0,0:51:22.73,0:51:24.40,النص العام,,0,0,0,,لا يمكنك العيش بشكل مريح بدوني
Dialogue: 0,0:51:26.07,0:51:27.74,نص عام,,0,0,0,,ولا شيء آخر!
Dialogue: 0,0:51:27.82,0:51:31.03,general text,,0,0,0,,إذا عرضت حياة طالب للخطر، فعليك المخاطرة بحياتك
Dialogue: 0,0:51:31.95,0:51:34.04,نص عام,,0,0,0,,حسنًا. سأضع هذا في الاعتبار للمستقبل
Dialogue: 0,0:51:34.91,0:51:36.83,نص عام,,0,0,0,,ماذا ستفعل بشأن الزواج من امرأة،
Dialogue: 0,0:51:36.91,0:51:39.63,نص عام,,0,0,0,,من كاد أن يقتل معلمك؟
Dialogue: 0,0:51:40.67,0:51:44.13,نص عام,,0,0,0,,الزواج منها ضمان لسلامتي
Dialogue: 0,0:51:46.80,0:51:48.76,general text,,0,0,0,,لكنك كدت أن تفقد حياتك،
Dialogue: 0,0:51:49.38,0:51:51.18,النص العام,,0,0,0,,لذلك يجب عليّ أيضًا أن أخاطر بنفسي
Dialogue: 0,0:51:57.64,0:51:59.56,خط مائل,,0,0,0,,هذا زواج المصلحة
Dialogue: 0,0:52:00.19,0:52:03.23,نص عام,,0,0,0,,سنحل كل سوء التفاهم بعد الزفاف
Dialogue: 0,0:52:03.32,0:52:05.86,النص العام,,0,0,0,,أنت تعتبرني صهراً،
Dialogue: 0,0:52:06.65,0:52:08.28,نص عام,,0,0,0,,لأنني وريث عائلة تشان
Dialogue: 0,0:52:08.36,0:52:10.36,نص عام,,0,0,0,,ومرشح محتمل لمنصب غوانغجو جيونبوغوان
Dialogue: 0,0:52:11.24,0:52:13.37,النص العام,,0,0,0,,سوف تتحد عائلاتنا وتصبح أكثر تأثيراً
Dialogue: 0,0:52:14.33,0:52:17.37,general text,,0,0,0,,لأن هذا زواج المصلحة،
Dialogue: 0,0:52:18.16,0:52:20.62,نص عام,,0,0,0,,علينا أن نتحدث بصراحة عن نقاط القوة والضعف لدينا
Dialogue: 0,0:52:21.42,0:52:23.92,النص العام,,0,0,0,,ربما لست ابن غوانغجو تشانغ جانج
Dialogue: 0,0:52:26.80,0:52:28.80,نص عام,,0,0,0,,مثل هذه الشائعات لا تزعجني
Dialogue: 0,0:52:31.26,0:52:33.10,نص عام,,0,0,0,,ولكن ماذا لو كانت هذه الشائعات...
Dialogue: 0,0:52:34.30,0:52:35.35,نص عام,,0,0,0,,حقاً؟
Dialogue: 0,0:52:38.27,0:52:40.19,النص العام,,0,0,0,,هل أنت مستعد لتحمل المخاطرة...
Dialogue: 0,0:52:40.94,0:52:43.81,النص العام,,0,0,0,,وتقبلني صهرك؟
Dialogue: 0,0:52:56.03,0:52:58.54,نص عام,,0,0,0,,أرى أنك لا تزال ترتدي السوار
Dialogue: 0,0:53:01.46,0:53:02.58,نص عام,,0,0,0,,نعم
Dialogue: 0,0:53:05.54,0:53:07.67,نص عام,,0,0,0,,وقحة كالعادة
Dialogue: 0,0:53:16.89,0:53:20.73,general text,,0,0,0,,لماذا قررت الزواج من تشو يونغ دون مناقشة الأمر معي؟
Dialogue: 0,0:53:21.85,0:53:25.23,general text,,0,0,0,,من أنت لتتدخل في شؤون عائلتنا؟
Dialogue: 0,0:53:25.31,0:53:26.44,نص عام,,0,0,0,,أختي,
Dialogue: 0,0:53:28.36,0:53:30.07,نص عام,,0,0,0,,أنا أيضًا عضو في عائلة جين
Dialogue: 0,0:53:31.82,0:53:36.45,general text,,0,0,0,,لقب جين يُعطى فقط لأولئك الذين كانت أمهاتهم من عشيرة جين
Dialogue: 0,0:53:37.70,0:53:41.41,general text,,0,0,0,,كانت والدتي غبية، إذ أعطت هذا الاسم الأخير،
Dialogue: 0,0:53:42.08,0:53:44.25,نص عام,,0,0,0,,التي حبل بها أبونا خارج إطار الزواج
Dialogue: 0,0:53:44.96,0:53:47.88,general text,,0,0,0,,سوف تتخلص مني بمجرد أن تصبح رئيس جينيون.
Dialogue: 0,0:53:49.13,0:53:51.51,نص عام,,0,0,0,,هل ما زلت غاضبًا مني؟
Dialogue: 0,0:53:51.59,0:53:52.72,نص عام,,0,0,0,,ليست مسألة إهانة
Dialogue: 0,0:53:53.84,0:53:55.39,نص عام,,0,0,0,,أنا أحتقرك
Dialogue: 0,0:53:58.35,0:54:01.06,general text,,0,0,0,,أنت خائن ولهذا أحتقرك
Dialogue: 0,0:54:04.94,0:54:08.11,general text,,0,0,0,,لا ينبغي لرئيس جينيوون أن يتخذ قرارات بناءً على التفضيلات الشخصية.
Dialogue: 0,0:54:09.40,0:54:11.90,النص العام,,0,0,0,,اختيار تشان ووك، أنت ترتكب خطأً
Dialogue: 0,0:54:11.99,0:54:13.40,النص العام,,0,0,0,,لا تتزوج تشو يونغ من ووك
Dialogue: 0,0:54:13.49,0:54:14.70,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:54:15.41,0:54:19.24,نص عام,,0,0,0,,أعرف الخيار الأفضل لها
Dialogue: 0,0:54:19.99,0:54:21.37,نص عام,,0,0,0,,كيف تحب ولي العهد...
Dialogue: 0,0:54:22.20,0:54:23.83,نص عام,,0,0,0,,كصهر؟
Dialogue: 0,0:54:27.79,0:54:31.09,general text,,0,0,0,,هل تريد أن ينضم ولي العهد إلى عائلتنا ونعيش معًا؟
Dialogue: 0,0:54:31.84,0:54:33.51,النص العام,,0,0,0,,تشو يونغ هي الابنة الثانية للعائلة
Dialogue: 0,0:54:33.59,0:54:36.13,general text,,0,0,0,,بو يونغ هي الكبرى، ستقود العائلة
Dialogue: 0,0:54:37.01,0:54:39.22,مائل,,0,0,0,,زوجها المستقبلي سينضم إلى العائلة،
Dialogue: 0,0:54:39.30,0:54:40.89,النص العام,,0,0,0,,حتى يتمكن تشو يونغ من العيش مع الأمير في القصر
Dialogue: 0,0:54:42.43,0:54:46.60,نص عام,,0,0,0,,ما الذي تنوي فعله؟ كيف تجرؤ على التحدث عن بو يونغ
Dialogue: 0,0:54:51.36,0:54:54.90,general text,,0,0,0,,أعلم أن زوجك لا يزال يبحث عن بو يونغ
Dialogue: 0,0:54:55.53,0:54:58.20,النص العام,,0,0,0,,بصفتي نائب غوانغجو جيونبوغوان،
Dialogue: 0,0:54:58.28,0:55:01.08,general text,,0,0,0,,سأبذل قصارى جهدي لمساعدتك في العثور على ابنتك،
Dialogue: 0,0:55:01.83,0:55:03.16,النص العام,,0,0,0,,الذي تبحث عنه بشدة
Dialogue: 0,0:55:05.00,0:55:08.92,general text,,0,0,0,,سأجعل بو يونغ رئيسًا لجينيونغ، وستصبح جو يونغ الملكة
Dialogue: 0,0:55:09.00,0:55:10.00,نص عام,,0,0,0,,فمن فضلك،
Dialogue: 0,0:55:10.09,0:55:11.92,نص عام,,0,0,0,,لا تعتبرها أوكا
Dialogue: 0,0:55:14.46,0:55:15.72,نص عام,,0,0,0,,كيف حال أخوك،
Dialogue: 0,0:55:16.47,0:55:19.93,نص عام,,0,0,0,,أصبح غوانغجو جيونبوغوان، سأدعم جينيوون
Dialogue: 0,0:55:21.39,0:55:23.47,النص العام,,0,0,0,,على أية حال، أنا عضو في عائلة جين
Dialogue: 0,0:55:38.70,0:55:41.66,النص العام,,0,0,0,,اسمع يا يول هذا هو الغريب
Dialogue: 0,0:55:42.37,0:55:44.37,النص العام,,0,0,0,,لماذا كنت تفكر في مو ديوك؟
Dialogue: 0,0:55:45.70,0:55:47.41,نص عام,,0,0,0,,لم أفكر بها
Dialogue: 0,0:55:48.58,0:55:51.42,general text,,0,0,0,,أنا أيضًا لا أفهم لماذا أظهرت المرآة مو دوك...
Dialogue: 0,0:55:52.17,0:55:54.21,general text,,0,0,0,,- وكلماتها تلك...\N- ماذا قالت؟
Dialogue: 0,0:55:54.96,0:55:56.13,نص عام,,0,0,0,,مرحبًا يول
Dialogue: 0,0:55:56.21,0:55:57.59,نص عام,,0,0,0,,نحن في الواقع نسير في هذا الاتجاه
Dialogue: 0,0:55:58.22,0:56:00.97,نص عام,,0,0,0,,ما الذي تفكر فيه هناك؟ ما الذي يخيفك؟
Dialogue: 0,0:56:05.64,0:56:07.02,نص عام,,0,0,0,,كل شيء على ما يرام
Dialogue: 0,0:56:09.85,0:56:11.27,نص عام,,0,0,0,,الأرواح المقدسة
Dialogue: 0,0:56:14.52,0:56:15.90,نص عام,,0,0,0,,عربة الطرود
Dialogue: 0,0:56:16.65,0:56:20.91,general text,,0,0,0,,على ما يبدو، سيتم تسليم هدايا زفاف تشو يونغ إلى سوسنوفي بور اليوم
Dialogue: 0,0:56:21.70,0:56:23.58,نص عام,,0,0,0,,لا أحد يستطيع رؤيتهم
Dialogue: 0,0:56:24.66,0:56:26.12,نص عام,,0,0,0,,علينا مساعدتها
Dialogue: 0,0:56:39.09,0:56:41.55,خط مائل,,0,0,0,,طائر! قبض على الطائر!
Dialogue: 0,0:56:41.64,0:56:42.93,النص العام,,0,0,0,,- ما هذا؟\N- أمسكها!
Dialogue: 0,0:56:43.60,0:56:44.97,مائل,,0,0,0,,- ما هذا!\N- إلى أين طارت؟
Dialogue: 0,0:56:45.64,0:56:48.18,خط مائل,,0,0,0,,- هناك! \N- إنها هناك!
Dialogue: 0,0:56:49.27,0:56:50.81,مائل,,0,0,0,,- كيف يمكن أن يكون هذا؟\N- حسنًا...
Dialogue: 0,0:56:51.77,0:56:53.94,خط مائل,,0,0,0,,- يا\N- هناك
Dialogue: 0,0:57:28.10,0:57:29.98,ذكريات بخط مائل,,0,0,0,,ناك سو يتقن كيمياء الأرواح
Dialogue: 0,0:57:33.27,0:57:36.15,ذكريات بخط مائل,,0,0,0,,لو فارقت روحها جسدها، ربما لا تزال على قيد الحياة
Dialogue: 0,0:57:43.99,0:57:46.12,ذكريات,,0,0,0,,لقد افتقدت الشخص الذي قابلته في دانهيانغوك
Dialogue: 0,0:57:47.87,0:57:49.70,ذكريات,,0,0,0,,واصل التفكير فيها
Dialogue: 0,0:57:51.46,0:57:52.79,ذكريات,,0,0,0,,ثم سأعود إليك مرة أخرى
Dialogue: 0,0:57:54.37,0:57:58.17,ذكريات,,0,0,0,,الشتاء في دانهيانجوك أكثر دفئًا مما تعتقد
Dialogue: 0,0:57:59.17,0:58:02.47,ذكريات,,0,0,0,,حيث تشرق الشمس يذوب الثلج بسرعة
Dialogue: 0,0:58:09.60,0:58:10.89,نص عام,,0,0,0,,إذن يا مو دوك...
Dialogue: 0,0:58:12.18,0:58:13.52,نص عام,,0,0,0,,هذا ناك سو
Dialogue: 0,0:59:15.87,0:59:18.96,النص العام,,0,0,0,,أنت من تركت تميمة الروح في دانهيانغوك
Dialogue: 0,0:59:24.30,0:59:26.63,نص عام,,0,0,0,,إذن أنت على قيد الحياة يا ناك سو
Dialogue: 0,0:59:49.07,0:59:50.16,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:59:50.74,0:59:52.41,نص عام,,0,0,0,,لقد سئمت انتظارك
Dialogue: 0,0:59:53.03,0:59:54.62,نص عام,,0,0,0,,ألم يخبرك الخادم كيم؟
Dialogue: 0,0:59:54.70,0:59:56.25,النص العام,,0,0,0,,كان ينبغي أن تصل بحلول الظهر
Dialogue: 0,0:59:58.12,1:00:00.96,نص عام,,0,0,0,,دعونا نسرع. نحن بحاجة للوصول إلى Danhyangok قبل غروب الشمس
Dialogue: 0,1:00:01.04,1:00:02.38,نص عام,,0,0,0,,بدلاً من دانهيانغوك،
Dialogue: 0,1:00:04.42,1:00:05.84,نص عام,,0,0,0,,لنذهب إلى مكان آخر
Dialogue: 0,1:00:07.01,1:00:08.09,نص عام,,0,0,0,,أين؟
Dialogue: 0,1:00:09.13,1:00:11.72,نص عام,,0,0,0,,في الشرق يوجد معبد فارغ بالقرب من غابة الخيزران
Dialogue: 0,1:00:12.22,1:00:13.43,نص عام,,0,0,0,,يمكننا الذهاب إلى هناك
Dialogue: 0,1:00:19.64,1:00:21.98,ذكريات,,0,0,0,,أحضر تشان ووك إلى هناك
Dialogue: 0,1:00:22.06,1:00:23.61,ذكريات,,0,0,0,,إذن سأنقذ حياتك
Dialogue: 0,1:00:29.45,1:00:31.28,تعليق صوتي,,0,0,0,,يجب أن أنقلك لأعيش
Dialogue: 0,1:00:32.07,1:00:33.28,خلف الكواليس,,0,0,0,,هكذا ينبغي أن يكون
Dialogue: 0,1:00:36.08,1:00:37.54,نص عام,,0,0,0,,لن أتزوج
Dialogue: 0,1:00:38.54,1:00:40.54,نص عام,,0,0,0,,أعطيتهم سببًا لرفض ترشيحي
Dialogue: 0,1:00:41.50,1:00:42.63,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,1:00:43.38,1:00:44.42,نص عام,,0,0,0,,لكن...
Dialogue: 0,1:00:47.59,1:00:50.30,نص عام,,0,0,0,,لقد حصلت الخادمة كيم بالفعل على يشم يين يانغ
Dialogue: 0,1:00:50.97,1:00:52.68,نص عام,,0,0,0,,فصنعت منه شيئاً
Dialogue: 0,1:01:00.10,1:01:01.85,نص عام,,0,0,0,,- هذا بيض الطيور\N- صحيح
Dialogue: 0,1:01:02.52,1:01:03.98,نص عام,,0,0,0,,خذ واحدة. سيكون لدينا واحدة لكل منهما
Dialogue: 0,1:01:07.94,1:01:10.24,نص عام,,0,0,0,,لدينا علاقة غريبة نوعًا ما
Dialogue: 0,1:01:10.32,1:01:13.03,نص عام,,0,0,0,,السيد الشاب والخادمة. المعلم والطالب
Dialogue: 0,1:01:13.11,1:01:15.83,نص عام,,0,0,0,,لذلك اعتقدت أنه يمكنهم تذكيرنا بذلك
Dialogue: 0,1:01:16.95,1:01:18.50,نص عام,,0,0,0,,حتى نبقى مخلصين لبعضنا البعض
Dialogue: 0,1:01:22.21,1:01:23.46,نص عام,,0,0,0,,سأكون أول من يختار
Dialogue: 0,1:01:23.54,1:01:25.38,نص عام,,0,0,0,,سأخذ اللون الأحمر، وأنت تأخذ اللون الأزرق
Dialogue: 0,1:01:29.76,1:01:33.80,نص عام,,0,0,0,,يا معلم، دعونا نبقى مخلصين لبعضنا البعض
Dialogue: 0,1:01:40.81,1:01:42.81,نص عام,,0,0,0,,- تشان ووك\N- نعم؟
Dialogue: 0,1:01:45.36,1:01:46.98,نص عام,,0,0,0,,ها نحن نقول وداعاً
Dialogue: 0,1:01:51.36,1:01:53.32,نص عام,,0,0,0,,سأعود من حيث أتيت
Dialogue: 0,1:01:55.57,1:01:58.49,general text,,0,0,0,,- لكنهم تخلوا عنك\N{\i1}- اليوم التقيت بهم مرة أخرى
Dialogue: 0,1:01:59.12,1:02:00.62,نص عام,,0,0,0,,إنهم يعرفون من أنا
Dialogue: 0,1:02:01.45,1:02:03.21,نص عام,,0,0,0,,فطلبوا مني أن أعود إليهم
Dialogue: 0,1:02:03.29,1:02:06.13,general text,,0,0,0,,- اعتقدت أنهم يريدون قتلك\N- كما ترون، مازلت على قيد الحياة
Dialogue: 0,1:02:06.75,1:02:09.13,general text,,0,0,0,,لو أرادوا أن يقتلوا لقتلوا منذ زمن طويل
Dialogue: 0,1:02:09.80,1:02:13.84,نص عام,,0,0,0,,إذا عدت أستطيع استعادة طاقتي
Dialogue: 0,1:02:21.56,1:02:22.93,نص عام,,0,0,0,,لقد وعدتك بمساعدتك...
Dialogue: 0,1:02:23.02,1:02:25.65,نص عام,,0,0,0,,وقلت إنني سأدفعك من الهاوية
Dialogue: 0,1:02:26.86,1:02:30.11,نص عام,,0,0,0,,أعلم أنني دربتك بشدة،
Dialogue: 0,1:02:32.19,1:02:33.36,النص العام,,0,0,0,,ولقد فعلت كل ما في وسعك
Dialogue: 0,1:02:34.70,1:02:37.12,نص عام,,0,0,0,,- يمكننا الاستمرار...\N- لا
Dialogue: 0,1:02:37.20,1:02:40.24,النص العام,,0,0,0,,إذا بقينا معًا، ستموت
Dialogue: 0,1:02:40.99,1:02:42.58,نص عام,,0,0,0,,وسوف يتم القبض علي
Dialogue: 0,1:03:03.89,1:03:08.06,general text,,0,0,0,,ما الذي جعل رئيس سوسنوفي بور يأتي سراً إلى هنا؟
Dialogue: 0,1:03:08.15,1:03:09.61,نص عام,,0,0,0,,أردت أن أسأل
Dialogue: 0,1:03:10.27,1:03:14.32,نص عام,,0,0,0,,عن ساحر جيونبوغوان اسمه تشو تشون والذي توفي منذ 20 عامًا
Dialogue: 0,1:03:19.74,1:03:21.53,مائل,,0,0,0,,الأب ناك سو، تشو تشون,
Dialogue: 0,1:03:22.45,1:03:23.62,نص عام,,0,0,0,,أتقن كيمياء النفوس
Dialogue: 0,1:03:25.62,1:03:27.58,نص عام,,0,0,0,,عندما وجدناه،
Dialogue: 0,1:03:28.08,1:03:30.34,نص عام,,0,0,0,,لقد أصبح جامحًا بالفعل
Dialogue: 0,1:03:30.42,1:03:34.34,general text,,0,0,0,,وقتل عائلته بأكملها
Dialogue: 0,1:03:41.30,1:03:43.43,مائل,,0,0,0,,كان على أربع عائلات أن تتأقلم،
Dialogue: 0,1:03:44.14,1:03:45.77,خط مائل,,0,0,0,,لوقف إراقة الدماء
Dialogue: 0,1:03:53.11,1:03:55.86,general text,,0,0,0,,كان والد ناك سو أيضًا من البدو الرحل؟
Dialogue: 0,1:03:56.53,1:03:58.20,نص عام,,0,0,0,,في عيون الطفل,
Dialogue: 0,1:03:58.28,1:04:01.78,نص عام,,0,0,0,,ربما نحن قتلة والدها
Dialogue: 0,1:04:03.99,1:04:07.08,general text,,0,0,0,,أكيد لامتنا على موته
Dialogue: 0,1:04:07.87,1:04:10.46,نص عام,,0,0,0,,ولهذا السبب أتيت إلى سوسنوفي بور
Dialogue: 0,1:04:12.75,1:04:15.67,نص عام,,0,0,0,,ما هي القضية المهمة التي تريد مناقشتها؟
Dialogue: 0,1:04:15.76,1:04:18.55,نص عام,,0,0,0,,هل تتذكر شيئًا عن ناك سو؟
Dialogue: 0,1:04:22.76,1:04:25.89,ذكريات,,0,0,0,,إذا التقينا مرة أخرى سأقتلك
Dialogue: 0,1:04:30.98,1:04:32.86,نص عام,,0,0,0,,التلميح,
Dialogue: 0,1:04:32.94,1:04:36.23,النص العام,,0,0,0,,أنني أخذت ابنة تشو تشون تحت جناحي وجعلتها مرتزقة؟
Dialogue: 0,1:04:36.32,1:04:39.61,general text,,0,0,0,,لقد أحرقت جثتها بمجرد العثور عليها.
Dialogue: 0,1:04:39.70,1:04:42.70,general text,,0,0,0,,ألا تخفي هويتها؟
Dialogue: 0,1:04:44.66,1:04:48.41,general text,,0,0,0,,بدلًا من الإجابة، سأخبرك بما حدث قبل 20 عامًا
Dialogue: 0,1:04:52.04,1:04:53.96,نص عام,,0,0,0,,هنا في جيونبوغوان نسجل النجوم...
Dialogue: 0,1:04:54.04,1:04:56.30,نص عام,,0,0,0,,من الساعة الواحدة صباحًا إلى الساعة الثالثة، عندما تكون الطاقة في ذروتها
Dialogue: 0,1:04:57.42,1:05:00.93,نص عام,,0,0,0,,غوانغجو تتحقق من التسجيل عند الظهر، ويتم تخزين اللافتات هنا
Dialogue: 0,1:05:02.30,1:05:07.27,نص عام,,0,0,0,,ذات يوم اختفت اللافتة المكتوبة في ذلك الصباح
Dialogue: 0,1:05:09.27,1:05:12.56,النص العام,,0,0,0,,لحسن الحظ تمكنا من العثور عليها
Dialogue: 0,1:05:15.19,1:05:17.86,نص عام,,0,0,0,,متى كان هذا؟
Dialogue: 0,1:05:21.70,1:05:25.58,general text,,0,0,0,,اليوم الذي ماتت فيه زوجة تشانغ جانج، دو هوا، وولد تشانغ ووك
Dialogue: 0,1:05:26.74,1:05:28.79,النص العام,,0,0,0,,كتب تشو تشون النجوم في ذلك اليوم،
Dialogue: 0,1:05:28.87,1:05:32.42,نص عام,,0,0,0,,وأنا من وجدت العلامة المفقودة
Dialogue: 0,1:05:46.72,1:05:49.22,ذكريات بخط مائل,,0,0,0,,لقد تمكنت من سرقة العلامة الحقيقية
Dialogue: 0,1:05:49.31,1:05:52.60,ذكريات,,0,0,0,,في جيونبوغوان وهمي بدون نجمة الملك
Dialogue: 0,1:05:58.19,1:05:59.78,نص عام,,0,0,0,,هل تريد أن تقول،
Dialogue: 0,1:06:00.46,1:06:01.90,نص عام,,0,0,0,,ماذا تعرف
Dialogue: 0,1:06:03.03,1:06:04.99,نص عام,,0,0,0,,حول ما حدث عندما...
Dialogue: 0,1:06:06.87,1:06:08.24,نص عام,,0,0,0,,هل ولد تشان ووك؟
Dialogue: 0,1:06:11.83,1:06:15.17,general text,,0,0,0,,ظهر في السماء نجم مستعد لتغيير العالم.
Dialogue: 0,1:06:20.34,1:06:23.01,نص عام,,0,0,0,,هل تعلم عن نجم الملك؟
Dialogue: 0,1:06:23.09,1:06:25.97,general text,,0,0,0,,هل اعتقدت أن السر سيموت مع تشو تشون؟
Dialogue: 0,1:06:27.55,1:06:30.97,general text,,0,0,0,,من برأيك حوله إلى ابتلاع الروح؟
Dialogue: 0,1:06:34.02,1:06:36.77,نص عام,,0,0,0,,لا تسأل أسئلة لا تريد أن تعرف إجابتها
Dialogue: 0,1:06:36.85,1:06:40.02,general text,,0,0,0,,هذه هي الطريقة الوحيدة التي ستحمي بها سوسنوفي بور وسكانها.
Dialogue: 0,1:06:52.83,1:06:56.00,ذكريات بخط مائل,,0,0,0,,دان جو لا يعلم أنك مازلت على قيد الحياة، ناك سو
Dialogue: 0,1:06:57.88,1:06:59.38,ذكريات,,0,0,0,,لم أخبره
Dialogue: 0,1:07:00.21,1:07:01.67,ذكريات,,0,0,0,,أحضر تشان ووك
Dialogue: 0,1:07:01.75,1:07:03.72,ذكريات,,0,0,0,,إذن سأبقي فمي مغلقًا
Dialogue: 0,1:07:08.26,1:07:10.72,ذكريات,,0,0,0,,سوف أنقل روحي إلى جسده
Dialogue: 0,1:07:30.24,1:07:31.58,نص عام,,0,0,0,,أين تشان ووك؟
Dialogue: 0,1:07:32.37,1:07:33.75,نص عام,,0,0,0,,سيأتي قريباً
Dialogue: 0,1:07:40.42,1:07:43.00,general text,,0,0,0,,ما الذي أتى بك إلى هنا في مثل هذا الوقت المتأخر؟
Dialogue: 0,1:07:46.47,1:07:47.97,نص عام,,0,0,0,,قبل أن تولد المملكة المتحدة...
Dialogue: 0,1:07:49.09,1:07:51.35,نص عام,,0,0,0,,منذ حوالي 20 عامًا...
Dialogue: 0,1:07:51.43,1:07:52.72,نص عام,,0,0,0,,هل يستطيع تشانغ غان...
Dialogue: 0,1:07:53.97,1:07:56.06,نص عام,,0,0,0,,تتقن نوعًا معينًا من السحر؟
Dialogue: 0,1:07:59.40,1:08:00.77,نص عام,,0,0,0,,كان تشان غان قادرًا...
Dialogue: 0,1:08:02.27,1:08:04.11,نص عام,,0,0,0,,نقل الروح؟
Dialogue: 0,1:08:19.58,1:08:21.04,نص عام,,0,0,0,,لماذا يستغرق الأمر كل هذا الوقت؟
Dialogue: 0,1:08:24.55,1:08:26.01,نص عام,,0,0,0,,أخيرًا بدأ المطر يهطل
Dialogue: 0,1:08:26.96,1:08:28.26,نص عام,,0,0,0,,سيكون هنا الآن
Dialogue: 0,1:08:32.55,1:08:33.89,نص عام,,0,0,0,,هل خدعتني؟
Dialogue: 0,1:08:36.22,1:08:38.27,نص عام,,0,0,0,,ماذا تنتظر؟
Dialogue: 0,1:08:39.81,1:08:42.90,النص العام,,0,0,0,,بما أن دان تشو لم يظهر بعد،
Dialogue: 0,1:08:42.98,1:08:45.57,نص عام,,0,0,0,,إذن أنت حقًا لم تخبره بأي شيء
Dialogue: 0,1:08:47.28,1:08:48.57,نص عام,,0,0,0,,يا أنت...
Dialogue: 0,1:09:12.97,1:09:14.30,ذكريات بخط مائل,,0,0,0,,ها نحن نقول وداعاً
Dialogue: 0,1:09:16.35,1:09:18.56,ذكريات,,0,0,0,,ماذا عن المعبد الفارغ في الغابة؟
Dialogue: 0,1:09:20.23,1:09:22.85,ذكريات,,0,0,0,,لماذا لا تريد أن تأخذني معك؟
Dialogue: 0,1:09:22.94,1:09:25.02,ذكريات,,0,0,0,,كنت سأتخلص منك هناك لكي أنقذ نفسي.
Dialogue: 0,1:09:26.86,1:09:28.90,ذكريات,,0,0,0,,الآن كما تعلم، لا تفكر حتى في متابعتي
Dialogue: 0,1:09:29.65,1:09:32.49,ذكريات,,0,0,0,,إذن ما كان عليك أن تخبرني عن ذلك المعبد
Dialogue: 0,1:09:33.70,1:09:35.74,ذكريات,,0,0,0,,دعك تذهب وحدك،
Dialogue: 0,1:09:36.53,1:09:38.54,ذكريات,,0,0,0,,هل تعلم أن الوضع خطير هناك؟
Dialogue: 0,1:09:41.79,1:09:43.29,ذكريات,,0,0,0,,أشعر الآن بالسوء أكثر منك
Dialogue: 0,1:09:43.37,1:09:45.92,ذكريات,,0,0,0,,لقد ضيعت فرصتي في الحياة بسبب بيضة طائر ما
Dialogue: 0,1:09:46.00,1:09:48.13,ذكريات,,0,0,0,,أنا سعيد لأنني تمكنت من تذكيرك بالإخلاص
Dialogue: 0,1:09:48.21,1:09:49.76,ذكريات,,0,0,0,,كان من الممكن أن أموت حقًا
Dialogue: 0,1:09:53.68,1:09:55.72,ذكريات,,0,0,0,,لقد ساعدتك على تجنب الموت،
Dialogue: 0,1:09:56.97,1:09:59.10,ذكريات,,0,0,0,,فقاتل حتى الموت
Dialogue: 0,1:10:00.18,1:10:03.85,ذكريات,,0,0,0,,تحدث وكأنك أنقذتني
Dialogue: 0,1:10:05.35,1:10:08.02,ذكريات,,0,0,0,,إذا أنعمت علينا السماء الملبدة بالغيوم بالمطر،
Dialogue: 0,1:10:09.69,1:10:11.74,ذكريات,,0,0,0,,ثم يمكننا أن نعيش معًا
Dialogue: 0,1:10:20.54,1:10:22.29,general text,,0,0,0,,الحظ والحقيقة إلى جانبك، المملكة المتحدة
Dialogue: 0,1:10:22.83,1:10:24.58,نص عام,,0,0,0,,هناك أمطار غزيرة في الخارج
Dialogue: 0,1:10:25.50,1:10:27.71,general text,,0,0,0,,أعتقد أن خصمي ليس أقوى مني بكثير
Dialogue: 0,1:10:28.96,1:10:30.59,general text,,0,0,0,,إنه ساحر من جيونبوغوان
Dialogue: 0,1:10:30.67,1:10:32.26,نص عام,,0,0,0,,مرحباً. هل تتذكرني؟
Dialogue: 0,1:12:46.27,1:12:48.68,خلف الكواليس,,0,0,0,,ها هو. الآن هو الوقت المناسب لاستخدام تانسو
Dialogue: 0,1:12:48.77,1:12:52.06,خارج الشاشة,,0,0,0,,لا تحاول تقسيم القطرات بسيف غير منضبط،
Dialogue: 0,1:12:52.15,1:12:54.44,خارج الشاشة,,0,0,0,,امسك السيف حتى تسقط عليه القطرات
Dialogue: 0,1:13:52.58,1:13:53.79,نص عام,,0,0,0,,لا...
Dialogue: 0,1:13:57.50,1:13:58.80,نص عام,,0,0,0,,ما الأمر؟
Dialogue: 0,1:13:58.88,1:13:59.84,نص عام,,0,0,0,,كيمياء النفوس
Dialogue: 0,1:14:51.10,1:14:53.43,خلف الكواليس,,0,0,0,,روحي...
Dialogue: 0,1:14:54.02,1:14:55.52,خارج الشاشة,,0,0,0,,تتحرك الآن؟
Dialogue: 0,1:15:17.00,1:15:18.42,معاينة,,0,0,0,,شان ووك
Dialogue: 0,1:15:19.75,1:15:23.46,preview,,0,0,0,,إذًا قمت بتبادل الجثث مع تلميذي جيل جو
Dialogue: 0,1:15:23.55,1:15:26.09,preview,,0,0,0,,أعتقد أن المملكة المتحدة أصبحت ضحية تهجير النفوس
Dialogue: 0,1:15:26.18,1:15:27.09,معاينة,,0,0,0,,ماذا؟
Dialogue: 0,1:15:27.18,1:15:29.68,preview,,0,0,0,,الرجل الذي نقل روح والدي...
Dialogue: 0,1:15:29.76,1:15:31.89,معاينة,,0,0,0,,هل هذا جين مو من جيونبوغوان؟
Dialogue: 0,1:15:33.93,1:15:36.44,معاينة,,0,0,0,,هل هذا أنت؟ أليس كذلك؟
Dialogue: 0,1:15:36.52,1:15:39.69,preview,,0,0,0,,هل أنت متأكد من تدمير حجر الجليد؟
Dialogue: 0,1:15:40.31,1:15:42.65,preview,,0,0,0,,اطلب من جميع سحرتنا العثور على جيل تشو
Dialogue: 0,1:15:42.73,1:15:45.15,preview,,0,0,0,,يجب أن يبقى سراً أنهم بدو
الحوار: 0,1:15:45.15,1:15:47.15,نص عام,,0,0,0,,
الحوار: 0,0:02:55.14,0:02:57.14,النكات,,0,0,0,,

التعليق: 0,0:02:45.14,0:02:47.14,niks,,0,0,0,,محرر النسخة التجريبية: {\c&HFFF4C5&} سناء
