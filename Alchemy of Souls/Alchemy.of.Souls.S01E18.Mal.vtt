Dialog: 0,0:02:47.14,0:02:52.14,nicks,,0,0,0,,Penyelaras projek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:52.14,0:02:57.14,nicks,,0,0,0,,Pembantu penyelaras:{\c&HFFF4C5&} Martini, gaarysn
Dialog: 0,0:02:57.14,0:03:02.14,nicks,,0,0,0,,Penterjemah penaip:{\c&HFFF4C5&} Ria_Lee, tommo, Zero Amamiya
Dialog: 0,0:00:45.24,0:00:47.66,teks umum,,0,0,0,,Ini adalah sejenis kegilaan!
Dialog: 0,0:00:47.74,0:00:51.04,teks umum,,0,0,0,,Adakah membunuh dan menghidupkan semula seseorang itu hiburan?
Dialog: 0,0:00:51.12,0:00:53.00,teks umum,,0,0,0,,Kami tidak boleh campur tangan,
Dialog: 0,0:00:53.08,0:00:55.79,teks umum,,0,0,0,,kerana Moo Dok bersetuju secara bodoh
Dialog: 0,0:00:57.09,0:00:58.30,teks umum,,0,0,0,,Gadis ini
Dialog: 0,0:01:00.76,0:01:02.05,teks umum,,0,0,0,,tersenyum
Dialog: 0,0:01:02.13,0:01:04.68,kenangan,,0,0,0,,Okay. saya setuju
Dialog: 0,0:01:09.60,0:01:11.39,teks umum,,0,0,0,,Dia bersetuju
Dialog: 0,0:01:11.48,0:01:14.31,teks umum,,0,0,0,,kerana emas yang akan dia terima
Dialog: 0,0:01:14.90,0:01:17.11,teks umum,,0,0,0,,Adakah ia benar-benar kerana emas
Dialog: 0,0:01:19.53,0:01:21.61,teks umum,,0,0,0,,adakah dia tersenyum?
Dialog: 0,0:01:33.71,0:01:35.96,teks umum,,0,0,0,,saya pun tak suka
Dialog: 0,0:01:37.04,0:01:39.30,teks umum,,0,0,0,,Jadi saya akan membunuh awak tanpa rasa sakit
Dialog: 0,0:01:39.38,0:01:41.80,teks umum,,0,0,0,,Ini bukan untuk menunjukkan kematian saya
Dialog: 0,0:01:42.88,0:01:45.05,teks umum,,0,0,0,,Kami melakukan ini untuk menunjukkan bagaimana saya akan dibangkitkan
Dialog: 0,0:01:47.30,0:01:51.64,teks umum,,0,0,0,,Dengan bantuan buku mereka cuba meluangkan masa untuk mendedahkan anda
Dialog: 0,0:01:52.22,0:01:54.73,miring,,0,0,0,,Apabila dia mati, mereka akan memanggil kuasa batu,
Dialog: 0,0:01:54.81,0:01:58.44,miring,,0,0,0,,gunakan masa ini untuk bergerak ke dalam badannya
Dialog: 0,0:01:58.52,0:02:02.19,teks umum,,0,0,0,,Majlis akan berakhir apabila permaisuri meninggal dunia
Dialog: 0,0:02:03.11,0:02:07.03,teks umum,,0,0,0,,Dan kami akan dengan tenang meninggalkan Hutan Pine dengan batu
Dialog: 0,0:02:09.78,0:02:13.37,teks umum,,0,0,0,,Saya tertanya-tanya mengapa Baginda memilihnya daripada semua orang?
Dialog: 0,0:02:13.45,0:02:16.25,teks umum,,0,0,0,,Dia paling lemah antara kita
Dialog: 0,0:02:16.33,0:02:17.96,contact,,0,0,0,,Dia membuat pilihan yang tepat
Dialog: 0,0:03:26.11,0:03:27.32,kenangan,,0,0,0,,Kecantikanku
Dialog: 0,0:03:28.57,0:03:30.36,kenangan,,0,0,0,,My Boo Young
Dialog: 0,0:03:39.21,0:03:40.33,teks umum,,0,0,0,,Ibu
Dialog: 0,0:04:10.49,0:04:12.87,teks umum,,0,0,0,,Tiada sesiapa melihat anda
Dialog: 0,0:04:12.95,0:04:14.70,teks umum,,0,0,0,,Gerakan jiwa anda
Dialog: 0,0:04:15.53,0:04:17.08,teks umum,,0,0,0,,Ini bukan saya
Dialog: 0,0:04:17.16,0:04:20.00,teks umum,,0,0,0,,Saya tidak mengawal batu itu
Dialog: 0,0:04:20.58,0:04:21.75,teks umum,,0,0,0,,Kemudian siapa?
Dialog: 0,0:05:08.34,0:05:09.63,teks umum,,0,0,0,,Hentikan ini
Dialog: 0,0:05:21.39,0:05:23.81,teks umum,,0,0,0,,Ibu, awak okay?
Dialog: 0,0:05:28.02,0:05:29.11,teks umum,,0,0,0,,Bu Young...
Dialog: 0,0:05:33.15,0:05:35.70,luar skrin,,0,0,0,,Adakah dia mengenalinya? Ini teruk
Dialog: 0,0:05:36.28,0:05:38.20,di sebalik tabir,,0,0,0,,Dia akan hidup sekarang
Dialog: 0,0:05:38.78,0:05:40.12,di sebalik tabir,,0,0,0,,Ini tidak boleh dibenarkan
Dialog: 0,0:05:40.20,0:05:41.54,suara,,0,0,0,,Dia mesti mati
Dialog: 0,0:06:27.08,0:06:28.33,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:06:28.83,0:06:30.59,teks umum,,0,0,0,,Di manakah batu itu?
Dialog: 0,0:06:34.46,0:06:35.59,teks umum,,0,0,0,,Apa yang berlaku?
Dialog: 0,0:06:48.31,0:06:49.56,italic,,0,0,0,,Pernahkah anda melihatnya?
Dialog: 0,0:06:49.65,0:06:52.82,teks umum,,0,0,0,,Kuasa batu dan syurga telah bersatu
Dialog: 0,0:06:52.90,0:06:55.99,teks umum,,0,0,0,,Nampaknya langit mengambil batu itu
Dialog: 0,0:06:57.07,0:06:58.61,teks umum,,0,0,0,,Batu itu tidak diambil
Dialog: 0,0:07:03.29,0:07:04.45,teks umum,,0,0,0,,Dia masih
Dialog: 0,0:07:05.41,0:07:06.50,teks umum,,0,0,0,,suatu tempat di sini
Dialog: 0,0:07:06.58,0:07:10.50,teks umum,,0,0,0,,Di manakah sebenarnya?
Dialog: 0,0:07:36.03,0:07:40.24,teks umum,,0,0,0,, Guruh, kilat, kini juga kabus di tengah hari?
Dialog: 0,0:07:40.32,0:07:41.95,teks umum,,0,0,0,,Bukan itu sahaja
Dialog: 0,0:07:42.03,0:07:43.41,teks umum,,0,0,0,,Sesuatu telah berlaku
Dialog: 0,0:07:50.71,0:07:53.34,teks umum,,0,0,0,,- Adakah ini yang mereka gunakan untuk menutup batu?\N- Ya
Dialog: 0,0:07:53.42,0:07:54.59,teks umum,,0,0,0,,Sesuatu telah berlaku pada batu itu?
Dialog: 0,0:07:56.00,0:07:57.46,teks umum,,0,0,0,,Adakah ini mimpi atau apa?
Dialog: 0,0:07:57.55,0:08:00.63,teks umum,,0,0,0,,- Bunga di mana-mana\N - Semuanya entah bagaimana tidak nyata
Dialog: 0,0:08:01.34,0:08:03.35,teks umum,,0,0,0,,Adakah kita sudah mati?
Dialog: 0,0:08:03.97,0:08:06.43,teks umum,,0,0,0,,- Adakah ini akhirat?\N- Hei!
Dialog: 0,0:08:06.52,0:08:08.14,teks umum,,0,0,0,,Berhenti bercakap kosong
Dialog: 0,0:08:08.23,0:08:11.06,teks umum,,0,0,0,,Kalau begitu saya adalah maharaja jed, dan dia adalah bidadari?
Dialog: 0,0:08:12.94,0:08:14.36,teks umum,,0,0,0,,Peri!
Dialog: 0,0:08:24.32,0:08:25.62,teks umum,,0,0,0,,Apakah ini?
Dialog: 0,0:08:26.49,0:08:27.95,teks umum,,0,0,0,,Sudah tentu bukan dongeng
Dialog: 0,0:08:28.83,0:08:30.00,teks umum,,0,0,0,, Hantu?
Dialog: 0,0:08:39.13,0:08:41.68,teks umum,,0,0,0,,Adakah anda ahli silap mata?
Dialog: 0,0:08:42.38,0:08:44.64,teks umum,,0,0,0,,Ya, ahli silap mata Jeonjingak
Dialog: 0,0:08:48.64,0:08:50.02,teks umum,,0,0,0,,Anda di sini juga, Cik Ho
Dialog: 0,0:08:54.31,0:08:55.56,teks umum,,0,0,0,,Lepaskan saya
Dialog: 0,0:08:58.53,0:09:01.78,teks umum,,0,0,0,,Chan Wook, jangan pergi mana-mana, jaga tempat ini
Dialog: 0,0:09:02.49,0:09:03.82,teks umum,,0,0,0,,Kamu bertiga
Dialog: 0,0:09:04.61,0:09:05.62,teks umum,,0,0,0,,Lihat sekeliling kawasan
Dialog: 0,0:09:05.70,0:09:09.37,teks umum,,0,0,0,,- Saya akan ke bilik latihan\N- Kami akan menemani anda
Dialog: 0,0:09:12.12,0:09:13.87,teks umum,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:09:13.96,0:09:15.21,teks umum,,0,0,0,,Saya mendengar guruh
Dialog: 0,0:09:15.29,0:09:17.42,teks umum,,0,0,0,,Kami juga tidak tahu
Dialog: 0,0:09:18.21,0:09:21.21,teks umum,,0,0,0,,Kami akan mengetahui apabila kabus hilang
Dialog: 0,0:09:21.88,0:09:23.63,teks umum,,0,0,0,,Jika ini bukan mimpi atau kehidupan akhirat,
Dialog: 0,0:09:24.22,0:09:26.09,teks umum,,0,0,0,,dari mana datangnya semua bunga ini?
Dialog: 0,0:09:27.18,0:09:28.76,teks umum,,0,0,0,,Adakah kabus itu nyata?
Dialog: 0,0:10:04.72,0:10:06.18,teks umum,,0,0,0,,Apa yang awak buat?
Dialog: 0,0:10:06.26,0:10:07.18,teks umum,,0,0,0,,Anda tidak faham
Dialog: 0,0:10:07.26,0:10:10.72,teks umum,,0,0,0,,Kami cuba keluar dari pintu pagar, tetapi tiupan angin melemparkan kami ke belakang
Dialog: 0,0:10:10.81,0:10:11.93,teks umum,,0,0,0,,Angin?
Dialog: 0,0:10:13.31,0:10:14.56,teks umum,,0,0,0,,Tiada angin
Dialog: 0,0:10:18.23,0:10:20.48,teks umum,,0,0,0,,Jangan mendekati. Kami tidak nampak
Dialog: 0,0:10:20.57,0:10:22.44,teks umum,,0,0,0,,tetapi tenaga yang luar biasa mengelilingi kita
Dialog: 0,0:10:22.53,0:10:24.78,teks umum,,0,0,0,,Apa yang berlaku di sini?
Dialog: 0,0:10:24.86,0:10:25.82,teks umum,,0,0,0,,Ini adalah penghalang
Dialog: 0,0:10:27.24,0:10:29.95,teks umum,,0,0,0,,Saya rasa ada penghalang di sekeliling Jeongjingak
Dialog: 0,0:10:30.95,0:10:32.04,teks umum,,0,0,0,,Penghalang?
Dialog: 0,0:10:32.12,0:10:33.62,teks umum,,0,0,0,,Siapa yang membinanya di sini?
Dialog: 0,0:10:33.70,0:10:34.87,miring,,0,0,0,,Yang Mulia
Dialog: 0,0:10:37.08,0:10:38.33,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:10:38.42,0:10:40.71,teks umum,,0,0,0,,Waris Jinyeowon ada di sini
Dialog: 0,0:10:41.46,0:10:43.80,teks umum,,0,0,0,,Jin Bu Young, yang membawa batu ais
Dialog: 0,0:10:43.88,0:10:45.55,teks umum,,0,0,0,,pengsan
Dialog: 0,0:10:56.89,0:10:57.77,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:11:14.12,0:11:17.79,teks umum,,0,0,0,,Tenaga batu menembusi Jeonjingak
Dialog: 0,0:11:17.87,0:11:19.88,teks umum,,0,0,0,,dan mencipta penghalang
Dialog: 0,0:11:21.33,0:11:23.75,teks umum,,0,0,0,,Siapa di dalam sekarang?
Dialog: 0,0:11:24.67,0:11:26.59,teks umum,,0,0,0,,Chan Wook dan Seo Yul tiada di mana-mana
Dialog: 0,0:11:26.67,0:11:27.97,teks umum,,0,0,0,,Kemungkinan besar mereka ada di sana
Dialog: 0,0:11:28.93,0:11:30.51,teks umum,,0,0,0,,Cik Ho ada di sana juga
Dialog: 0,0:11:30.59,0:11:33.10,teks umum,,0,0,0,,- Mudaku Ok!\N-{\i1} Putera Mahkota
Dialog: 0,0:11:33.18,0:11:34.72,teks umum,,0,0,0,,Baginda juga ada di sana
Dialog: 0,0:11:35.47,0:11:38.94,teks umum,,0,0,0,,- Apa?\N- Adakah Bom juga ada?
Dialog: 0,0:11:39.02,0:11:41.15,teks umum,,0,0,0,,Di mana Jin Ho?
Dialog: 0,0:11:42.11,0:11:43.11,contact,,0,0,0,,Ketua Jin,
Dialog: 0,0:11:43.19,0:11:44.40,teks umum,,0,0,0,,buat sesuatu
Dialog: 0,0:11:44.48,0:11:47.69,teks umum,,0,0,0,,Batu itu menelan anak perempuan anda juga, dia mungkin ada di sana juga
Dialog: 0,0:11:48.32,0:11:50.32,teks umum,,0,0,0,,Anda tidak boleh tergesa-gesa
Dialog: 0,0:11:50.41,0:11:53.78,teks umum,,0,0,0,,Kami melihat apa yang berlaku selepas campur tangan Jin Bu Young
Dialog: 0,0:11:55.08,0:11:57.83,teks umum,,0,0,0,,Ini salah Jinyeowon
Dialog: 0,0:11:59.29,0:12:01.83,teks umum,,0,0,0,,Anda mahu melihat kekuatan batu ais
Dialog: 0,0:12:01.92,0:12:03.71,teks umum,,0,0,0,,Sekarang awak nak salahkan kami?
Dialog: 0,0:12:04.75,0:12:07.30,teks umum,,0,0,0,,Adakah anda akan bergaduh lagi?
Dialog: 0,0:12:07.38,0:12:10.05,teks umum,,0,0,0,,Cukup sudah. Kanak-kanak ada di sana
Dialog: 0,0:12:10.13,0:12:11.72,teks umum,,0,0,0,,Yong Ok!
Dialog: 0,0:12:28.90,0:12:31.15,teks umum,,0,0,0,,Anda boleh melakukan sesuatu
Dialog: 0,0:12:31.24,0:12:33.99,teks umum,,0,0,0,,dengan penghalang di sekeliling Jeonjingak?
Dialog: 0,0:12:34.07,0:12:35.87,teks umum,,0,0,0,,Apa yang berlaku di dewan latihan?
Dialog: 0,0:12:37.16,0:12:38.20,teks umum,,0,0,0,,Ini...
Dialog: 0,0:12:47.96,0:12:50.30,suara,,0,0,0,,Ini pasti kerana Moo Deok
Dialog: 0,0:12:50.38,0:12:53.76,di sebalik tabir,,0,0,0,,Namun, dia adalah Jin Bu Young sebenar dari Jinyoung
Dialog: 0,0:12:54.34,0:12:56.26,di sebalik tabir,,0,0,0,,Dan semua orang fikir itu saya
Dialog: 0,0:12:56.35,0:12:58.60,luar skrin,,0,0,0,,Saya tidak boleh mengatakan itu dia
Dialog: 0,0:12:58.68,0:12:59.56,di sebalik tabir,,0,0,0,,Apa yang perlu saya lakukan?
Dialog: 0,0:13:00.52,0:13:01.85,teks umum,,0,0,0,,Jawapan
Dialog: 0,0:13:01.94,0:13:03.19,teks umum,,0,0,0,,Saya...
Dialog: 0,0:13:04.69,0:13:05.98,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:13:06.06,0:13:09.32,teks umum,,0,0,0,,Saya buta, jadi saya tidak nampak apa yang berlaku
Dialog: 0,0:13:09.40,0:13:12.15,teks umum,,0,0,0,,Saya tidak sedarkan diri apabila angin naik dan baru bangun dari tidur
Dialog: 0,0:13:12.24,0:13:14.16,teks umum,,0,0,0,,Anda tidak tahu bagaimana anda berada di sini?
Dialog: 0,0:13:14.24,0:13:16.70,teks umum,,0,0,0,,Saya pun tidak tahu di mana saya berada
Dialog: 0,0:13:16.78,0:13:19.58,teks umum,,0,0,0,,Bagaimanakah saya tahu bagaimana saya sampai ke sini?
Dialog: 0,0:13:24.00,0:13:26.21,teks umum,,0,0,0,,Dia tidak kelihatan sangat baik
Dialog: 0,0:13:27.25,0:13:29.92,teks umum,,0,0,0,,Semua pucat, peluh di dahi saya
Dialog: 0,0:13:30.01,0:13:31.59,teks umum,,0,0,0,,Apa kata anda?
Dialog: 0,0:13:33.38,0:13:36.22,teks umum,,0,0,0,,Dia perlu berehat dahulu, Yang Amat Mulia
Dialog: 0,0:13:39.68,0:13:40.68,teks umum,,0,0,0,,Biar dia berehat
Dialog: 0,0:13:42.02,0:13:43.02,teks umum,,0,0,0,,Jom
Dialog: 0,0:13:48.57,0:13:49.94,teks umum,,0,0,0,,Semuanya bohong
Dialog: 0,0:13:51.40,0:13:52.69,teks umum,,0,0,0,,Apa yang dia sembunyikan?
Dialog: 0,0:13:52.78,0:13:54.15,teks umum,,0,0,0,,Mungkin Moo Dok tahu
Dialog: 0,0:13:54.90,0:13:56.57,teks umum,,0,0,0,,Mu Dok, adakah awak bersamanya?
Dialog: 0,0:13:59.20,0:14:00.87,teks umum,,0,0,0,,Moo Dok, bagaimana awak sampai ke sini?
Dialog: 0,0:14:02.12,0:14:04.79,teks umum,,0,0,0,,Saya berada di sini sepanjang masa
Dialog: 0,0:14:07.92,0:14:09.00,teks umum,,0,0,0,,Awak pernah ke sini?
Dialog: 0,0:14:10.05,0:14:12.51,teks umum,,0,0,0,,Awak tak tumpahkan teh di dewan belajar?
Dialog: 0,0:14:13.47,0:14:16.89,teks umum,,0,0,0,,Ya, tetapi kemudian saya terus mengikuti anda
Dialog: 0,0:14:16.97,0:14:19.97,teks umum,,0,0,0,,Saya tidak tahu apa yang berlaku kemudian
Dialog: 0,0:14:20.93,0:14:23.85,teks umum,,0,0,0,,Apa yang boleh anda tanyakan kepada pembantu rumah yang hanya tahu bagaimana
Dialog: 0,0:14:24.43,0:14:28.23,teks umum,,0,0,0,, kejar tuanmu seperti anjing kecil?
Dialog: 0,0:14:28.31,0:14:29.86,condong,,0,0,0,,Jangan risau
Dialog: 0,0:14:30.36,0:14:32.82,teks umum,,0,0,0,,Di sebalik penghalang terdapat ahli silap mata terbaik Majlis Bersatu
Dialog: 0,0:14:32.90,0:14:35.28,teks umum,,0,0,0,,Mereka akan menyelamatkan kita dengan cepat
Dialog: 0,0:14:36.45,0:14:38.28,teks umum,,0,0,0,,Bawa teh Yang Amat Mulia
Dialog: 0,0:14:38.37,0:14:39.45,teks umum,,0,0,0,,Ya
Dialog: 0,0:14:51.92,0:14:55.34,teks umum,,0,0,0,,Anjing yang mengejar pemiliknya
Dialog: 0,0:14:55.42,0:14:57.38,teks umum,,0,0,0,,Hamba yang tidak tahu apa-apa
Dialog: 0,0:14:58.93,0:15:00.64,teks umum,,0,0,0,,Ini Mu Dok
Dialog: 0,0:15:06.94,0:15:08.31,teks umum,,0,0,0,,Betul
Dialog: 0,0:15:08.40,0:15:10.11,teks umum,,0,0,0,,Dan tiada air
Dialog: 0,0:16:09.79,0:16:12.75,teks umum,,0,0,0,,Teh yang direbus dengan jampi adalah yang paling lazat
Dialog: 0,0:16:14.50,0:16:15.80,teks umum,,0,0,0,,Banyak masa telah berlalu
Dialog: 0,0:16:18.51,0:16:22.97,suara,,0,0,0,,Saya akhirnya mendapat kekuatan saya semula berkat batu itu
Dialog: 0,0:16:32.06,0:16:34.81,kenangan,,0,0,0,,Apa yang sedang berlaku? di mana saya?
Dialog: 0,0:16:36.57,0:16:38.86,kenangan,,0,0,0,,Kita tidak akan kalah kali ini
Dialog: 0,0:16:39.69,0:16:41.70,kenangan,,0,0,0,,Kita berada di dalam batu ais
Dialog: 0,0:16:43.32,0:16:45.20,kenangan,,0,0,0,,Adakah ini batu?
Dialog: 0,0:16:45.78,0:16:48.95,kenangan,,0,0,0,,Batu ais tidak terhad mengikut saiz atau bentuk
Dialog: 0,0:16:49.58,0:16:51.79,kenangan,,0,0,0,,Ia boleh jadi air, api
Dialog: 0,0:16:51.87,0:16:53.54,kenangan,,0,0,0,,atau angin
Dialog: 0,0:16:57.67,0:17:00.01,kenangan,,0,0,0,,Jadi batu itu milik saya sekarang?
Dialog: 0,0:17:06.97,0:17:09.60,kenangan,,0,0,0,,Tiada siapa boleh memiliki batu itu
Dialog: 0,0:17:10.98,0:17:13.06,kenangan,,0,0,0,,Anda hanya boleh menggunakan kuasanya
Dialog: 0,0:17:13.14,0:17:15.77,kenangan,,0,0,0,,Ia seperti memberi dan menerima
Dialog: 0,0:17:15.86,0:17:17.90,kenangan,,0,0,0,,Anda mendapat sesuatu, anda kehilangan sesuatu
Dialog: 0,0:17:17.98,0:17:20.94,kenangan,,0,0,0,,Ini adalah beban yang perlu anda tanggung
Dialog: 0,0:17:21.03,0:17:23.53,kenangan,,0,0,0,,Saya akan menerimanya dengan gembira
Dialog: 0,0:17:23.61,0:17:25.20,kenangan,,0,0,0,,Nah, cubalah
Dialog: 0,0:17:25.28,0:17:27.33,kenangan,,0,0,0,,Tenaga yang berlebihan akan membawa kepada
Dialog: 0,0:17:27.95,0:17:30.66,kenangan,,0,0,0,,bahawa anda tidak boleh mengawal kuasa yang anda gunakan
Dialog: 0,0:17:31.45,0:17:34.00,kenangan,,0,0,0,,Kalau nak hujan kena banjir
Dialog: 0,0:17:34.83,0:17:37.54,kenangan,,0,0,0,,Kalau nak angin, kena taufan
Dialog: 0,0:17:38.50,0:17:39.59,kenangan,,0,0,0,,Cuba hadapi
Dialog: 0,0:17:40.09,0:17:41.30,kenangan,,0,0,0,,Apa awak?
Dialog: 0,0:17:41.88,0:17:43.51,kenangan,,0,0,0,,Peninggalan Jinyoewon?
Dialog: 0,0:17:44.43,0:17:46.84,kenangan,,0,0,0,,Beraninya jiwa yang hidup dalam tubuhku,
Dialog: 0,0:17:47.76,0:17:49.22,kenangan,,0,0,0,,panggil saya peninggalan?
Dialog: 0,0:18:17.96,0:18:19.17,kenangan,,0,0,0,,Jeonjingak?
Dialog: 0,0:18:25.47,0:18:26.88,di sebalik tabir,,0,0,0,,Apa itu?
Dialog: 0,0:18:28.05,0:18:31.26,di sebalik tabir,,0,0,0,, peninggalan Jinyewon yang melekat pada batu?
Dialog: 0,0:18:37.56,0:18:39.81,teks umum,,0,0,0,,Moo Dok, apakah ini?
Dialog: 0,0:18:39.90,0:18:42.57,teks umum,,0,0,0,,Membawa putera cawan pecah?
Dialog: 0,0:18:42.65,0:18:44.36,teks umum,,0,0,0,,Maaf
Dialog: 0,0:18:44.44,0:18:45.53,teks umum,,0,0,0,,Saya akan tukar
Dialog: 0,0:18:46.07,0:18:49.41,luar skrin,,0,0,0,,Berhenti. Saya tidak perlu melayan lagi
Dialog: 0,0:18:49.49,0:18:50.95,teks umum,,0,0,0,,- Mu Dok\N- Ya
Dialog: 0,0:18:51.53,0:18:53.95,teks umum,,0,0,0,,Seratus kotor. Lap ke bawah
Dialog: 0,0:18:54.04,0:18:56.16,luar skrin,,0,0,0,,Tidak perlu patuh
Dialog: 0,0:18:56.75,0:18:58.33,di sebalik tabir,,0,0,0,,Adakah saya menjadi Moo Deok hingga ke inti?
Dialog: 0,0:19:04.13,0:19:05.76,suara,,0,0,0,,Saya bukan Moo Deok lagi
Dialog: 0,0:19:05.84,0:19:06.76,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:19:12.01,0:19:14.93,teks umum,,0,0,0,,Kami tidak makan apa-apa sejak awal majlis
Dialog: 0,0:19:15.02,0:19:16.43,teks umum,,0,0,0,,Ada sesuatu untuk dimakan?
Dialog: 0,0:19:17.10,0:19:19.73,teks umum,,0,0,0,,Sujebi sesuai untuk kita*
Dialog: 0,0:19:17.10,0:19:19.73,nota,,0,0,0,,*sup tradisional Korea dengan kepingan doh
Dialog: 0,0:19:19.81,0:19:20.73,teks umum,,0,0,0,,Bolehkah anda melakukannya?
Dialog: 0,0:19:27.49,0:19:29.95,teks umum,,0,0,0,,I Mu Dok sehingga saya selesai memasak
Dialog: 0,0:19:30.66,0:19:34.29,teks umum,,0,0,0,,Dan kemudian saya akan berhenti menjadi dia
Dialog: 0,0:19:35.37,0:19:37.71,teks umum,,0,0,0,,Apabila saya boleh menenangkan jiwa semula,
Dialog: 0,0:19:37.79,0:19:40.17,teks umum,,0,0,0,,Saya akan memilih mana-mana badan
Dialog: 0,0:19:42.42,0:19:43.96,teks umum,,0,0,0,,Saya pun boleh jadi raja
Dialog: 0,0:19:51.64,0:19:53.18,teks umum,,0,0,0,,Atau lebih baik untuk membunuh musuh
Dialog: 0,0:19:53.26,0:19:55.60,teks umum,,0,0,0,,dan ambil mayatnya untuk diri sendiri?
Dialog: 0,0:20:04.77,0:20:05.98,teks umum,,0,0,0,,Saya tidak mahu
Dialog: 0,0:20:07.24,0:20:09.45,teks umum,,0,0,0,,Lebih baik menjadi Park Jin
Dialog: 0,0:20:19.46,0:20:21.37,teks umum,,0,0,0,,Anda boleh memilih sesiapa sahaja
Dialog: 0,0:20:21.96,0:20:23.50,teks umum,,0,0,0,,Kita perlu berfikir
Dialog: 0,0:20:24.96,0:20:26.71,teks umum,,0,0,0,,Sempurna
Dialog: 0,0:20:26.80,0:20:29.09,teks umum,,0,0,0,,Sayang sekali membiarkan dia pergi ke Suzhebi*
Dialog: 0,0:20:26.80,0:20:29.09,nota,,0,0,0,,*doh sup dikoyakkan dengan tangan
Dialog: 0,0:20:29.17,0:20:30.76,teks umum,,0,0,0,,Mungkin kita patut buat kuksa?*
Dialog: 0,0:20:29.17,0:20:30.76,nota,,0,0,0,,* mi sup sejuk
Dialog: 0,0:20:30.84,0:20:32.80,teks umum,,0,0,0,,Chan Wook suka kuksu
Dialog: 0,0:20:38.56,0:20:40.64,kenangan,,0,0,0,,Baunya sangat lemah
Dialog: 0,0:20:47.40,0:20:51.32,teks umum,,0,0,0,,Ini adalah hidangan terakhir yang Moo Deok sediakan untuk pemiliknya
Dialog: 0,0:21:01.29,0:21:02.87,teks umum,,0,0,0,,- Guru\N- Ya?
Dialog: 0,0:21:04.25,0:21:07.04,teks umum,,0,0,0,,saya buat kuksu, makan
Dialog: 0,0:21:07.13,0:21:08.34,teks umum,,0,0,0,,Okey
Dialog: 0,0:21:12.05,0:21:15.43,teks umum,,0,0,0,,Sekarang pembantu rumah anda meninggalkan anda
Dialog: 0,0:21:17.35,0:21:18.51,teks umum,,0,0,0,,Dan banyak lagi...
Dialog: 0,0:21:20.39,0:21:22.56,teks umum,,0,0,0,,di sini saya akan berhenti menjadi guru kamu
Dialog: 0,0:21:24.27,0:21:25.31,teks umum,,0,0,0,,Adakah anda berhenti?
Dialog: 0,0:21:27.02,0:21:29.07,teks umum,,0,0,0,,Anda mungkin tidak faham,
Dialog: 0,0:21:29.82,0:21:31.44,teks umum,,0,0,0,,kita berada di dalam batu ais
Dialog: 0,0:21:32.15,0:21:34.32,teks umum,,0,0,0,,Saya mendapat semula kuasa seperti di Tasik Gyeongcheongdaeho
Dialog: 0,0:21:36.95,0:21:38.79,teks umum,,0,0,0,,Dan saya menggunakan batu ini untuk alkimia,
Dialog: 0,0:21:39.74,0:21:41.37,teks umum,,0,0,0,,untuk meninggalkan badan ini
Dialog: 0,0:21:43.37,0:21:44.67,teks umum,,0,0,0,,Itulah...
Dialog: 0,0:21:45.71,0:21:47.38,teks umum,,0,0,0,,kita tidak akan berjumpa lagi?
Dialog: 0,0:21:47.46,0:21:49.34,teks umum,,0,0,0,,Kami telah komited untuk menyelesaikan segala-galanya,
Dialog: 0,0:21:49.92,0:21:51.88,teks umum,,0,0,0,,apabila saya mendapat semula kuasa saya
Dialog: 0,0:21:51.96,0:21:54.84,teks umum,,0,0,0,,Dan kemudian mereka komited untuk membincangkan masa depan kita
Dialog: 0,0:22:01.85,0:22:03.35,teks umum,,0,0,0,,Bukan untuk kami
Dialog: 0,0:22:05.52,0:22:06.77,teks umum,,0,0,0,,masa depan yang lain
Dialog: 0,0:22:15.82,0:22:17.87,kenangan miring,,0,0,0,,Anda mendapat sesuatu, anda kehilangan sesuatu
Dialog: 0,0:22:17.95,0:22:20.83,kenangan,,0,0,0,,Ini adalah beban yang perlu anda tanggung
Dialog: 0,0:22:22.29,0:22:24.41,teks umum,,0,0,0,,Jika saya perlu kehilangan awak sebagai pertukaran kuasa,
Dialog: 0,0:22:26.00,0:22:27.42,teks umum,,0,0,0,,jadilah
Dialog: 0,0:22:39.68,0:22:41.60,teks umum,,0,0,0,,- Guru\N- Ya?
Dialog: 0,0:22:41.68,0:22:43.77,teks umum,,0,0,0,,saya buat kuksu, makan
Dialog: 0,0:22:44.52,0:22:46.06,teks umum,,0,0,0,,- Dan...\N- Mu Dok
Dialog: 0,0:22:46.14,0:22:48.23,teks umum,,0,0,0,,Saya rasa halangan di sekeliling Jeonjingak
Dialog: 0,0:22:48.31,0:22:50.19,teks umum,,0,0,0,,ini adalah batu ais
Dialog: 0,0:22:50.77,0:22:51.61,di sebalik tabir,,0,0,0,,Apa?
Dialog: 0,0:22:52.23,0:22:54.69,luar skrin,,0,0,0,,Dia tidak sepatutnya faham itu
Dialog: 0,0:22:56.20,0:22:58.49,teks umum,,0,0,0,,Mereka mengatakan bahawa batu adalah air, api dan angin
Dialog: 0,0:22:59.03,0:23:01.03,teks umum,,0,0,0,,Saya rasa kuasa angin sedang menyelubungi kita
Dialog: 0,0:23:01.91,0:23:04.37,contact,,0,0,0,,Jika kita berada di dalam batu,
Dialog: 0,0:23:04.91,0:23:08.25,teks umum,,0,0,0,,bolehkah ia diambil tanpa sesiapa memahami?
Dialog: 0,0:23:10.96,0:23:12.17,teks umum,,0,0,0,,Saya tidak tahu
Dialog: 0,0:23:12.25,0:23:13.88,teks umum,,0,0,0,,Saya menguasai Chisa
Dialog: 0,0:23:14.63,0:23:16.47,teks umum,,0,0,0,,Mungkin saya boleh tangkap dia seperti Ikan Emas?
Dialog: 0,0:23:16.55,0:23:19.01,teks umum,,0,0,0,,Kekuatan semasa anda tidak boleh dibandingkan
Dialog: 0,0:23:19.59,0:23:20.80,teks umum,,0,0,0,,dengan batu ais
Dialog: 0,0:23:23.10,0:23:26.39,teks am,,0,0,0,,Saya harap awak boleh dapatkan semula kekuatan awak, seperti yang awak lakukan di tasik
Dialog: 0,0:23:29.19,0:23:30.56,teks umum,,0,0,0,,Saya rasa anda boleh melakukannya
Dialog: 0,0:23:33.73,0:23:35.44,teks umum,,0,0,0,,Jika saya mengembalikan kuasa
Dialog: 0,0:23:36.11,0:23:38.28,teks umum,,0,0,0,,dan lari dengan batu?
Dialog: 0,0:23:40.24,0:23:42.99,teks umum,,0,0,0,,Jika ditangkap, anda mungkin akan dibunuh
Dialog: 0,0:23:44.20,0:23:45.41,teks umum,,0,0,0,,Awak tak takut ke?
Dialog: 0,0:23:45.49,0:23:48.21,teks umum,,0,0,0,,Kebarangkalian anda akan lari dengan batu itu
Dialog: 0,0:23:48.29,0:23:50.21,teks umum,,0,0,0,,selalu wujud
Dialog: 0,0:23:51.17,0:23:55.05,teks umum,,0,0,0,,Dan saya sudah berkata bahawa saya akan bertanggungjawab sepenuhnya
Dialog: 0,0:24:00.09,0:24:01.18,teks umum,,0,0,0,,Tetapi
Dialog: 0,0:24:02.01,0:24:03.55,teks umum,,0,0,0,,Saya agak takut
Dialog: 0,0:24:04.93,0:24:09.39,teks umum,,0,0,0,,Saya takut awak akan mungkir janji kita dan tinggalkan saya tanpa mengucapkan selamat tinggal.
Dialog: 0,0:24:11.48,0:24:12.44,teks umum,,0,0,0,,Guru,
Dialog: 0,0:24:12.52,0:24:16.23,teks umum,,0,0,0,,jangan tinggalkan saya, kalau tidak saya akan menangis seperti orang gila
Dialog: 0,0:24:18.99,0:24:22.66,teks umum,,0,0,0,,Anda bercakap perkara yang memalukan begitu mudah
Dialog: 0,0:24:23.99,0:24:25.99,teks umum,,0,0,0,,Maka anda akan menyesal
Dialog: 0,0:24:28.33,0:24:31.25,teks umum,,0,0,0,,Mengatakan perkara seperti ini tidak sukar, saya boleh menanggung malu
Dialog: 0,0:24:31.33,0:24:34.92,teks umum,,0,0,0,,Tetapi saya tidak akan memutarkan masa, walaupun saya menyesali sesuatu
Dialog: 0,0:24:36.59,0:24:39.30,teks umum,,0,0,0,,Cikgu, elakkan rasa malu
Dialog: 0,0:24:39.38,0:24:40.88,teks umum,,0,0,0,,dan jujurlah pada diri sendiri
Dialog: 0,0:24:40.97,0:24:43.89,teks umum,,0,0,0,,Maka anda tidak akan menyesali apa-apa
Dialog: 0,0:24:49.73,0:24:52.02,teks umum,,0,0,0,,- Chan Wook, saya...\N{\i1}- Tuan
Dialog: 0,0:24:55.65,0:24:56.73,teks umum,,0,0,0,,Saya akan ke sana
Dialog: 0,0:24:57.48,0:24:59.57,teks umum,,0,0,0,,Dia mempunyai kunci dewan dengan buku terlarang
Dialog: 0,0:24:59.65,0:25:02.32,teks umum,,0,0,0,,Oleh kerana kita berada di sini, saya ingin mencari sesuatu
Dialog: 0,0:25:03.36,0:25:04.45,contact,,0,0,0,,By the way
Dialog: 0,0:25:10.29,0:25:11.87,teks umum,,0,0,0,,Makanlah sendiri. Jangan kongsi dengan sesiapa
Dialog: 0,0:25:37.69,0:25:41.28,teks umum,,0,0,0,,Mencari buku tentang sihir gelap?
Dialog: 0,0:25:41.36,0:25:43.49,teks umum,,0,0,0,,Ya, saya dengar ayah saya pergi dari sini
Dialog: 0,0:25:43.57,0:25:47.03,teks umum,,0,0,0,,semua buku tentang sihir gelap yang saya terima daripada bomoh
Dialog: 0,0:25:48.83,0:25:50.33,teks umum,,0,0,0,,Saya mahu mencarinya
Dialog: 0,0:25:53.41,0:25:55.42,teks umum,,0,0,0,,Jadi ini adalah buku Gwangju Chang Gang
Dialog: 0,0:25:56.50,0:25:57.96,teks umum,,0,0,0,,Saya akan membantu
Dialog: 0,0:25:58.04,0:26:01.51,teks umum,,0,0,0,,Saya boleh mengendalikannya sendiri. Anda boleh meninggalkan saya kunci dan pergi
Dialog: 0,0:26:02.92,0:26:05.38,teks umum,,0,0,0,,Datuk mempercayakannya kepada saya
Dialog: 0,0:26:05.47,0:26:07.43,teks umum,,0,0,0,,Bagaimanakah saya boleh yakin bahawa anda tidak akan kehilangannya?
Dialog: 0,0:26:07.51,0:26:11.52,teks umum,,0,0,0,,Nah, ya. Tiada kepercayaan pada saya. Terima kasih atas bantuan anda
Dialog: 0,0:26:29.33,0:26:31.41,teks umum,,0,0,0,,Jadi, perhatian
Dialog: 0,0:26:32.12,0:26:36.75,teks umum,,0,0,0,, Terdapat bilik dan makanan percuma yang mencukupi di Jeongjingak
Dialog: 0,0:26:36.83,0:26:40.25,italic,,0,0,0,,Jadi jangan terlalu risau
Dialog: 0,0:26:40.34,0:26:41.42,miring,,0,0,0,,Mari kita bertenang
Dialog: 0,0:26:41.50,0:26:42.63,teks umum,,0,0,0,,Okay?
Dialog: 0,0:26:51.64,0:26:54.60,teks umum,,0,0,0,,Pergi ke Kisan dan hantar semua orang ke sini
Dialog: 0,0:26:54.68,0:26:57.44,teks umum,,0,0,0,,Kami juga mempunyai hak ke atas kuasa batu ais
Dialog: 0,0:26:57.52,0:26:58.60,teks umum,,0,0,0,,Ya
Dialog: 0,0:27:01.73,0:27:03.94,teks umum,,0,0,0,,Kumpulkan semua orang yang boleh mengucapkan mantra
Dialog: 0,0:27:04.03,0:27:05.90,teks umum,,0,0,0,,Malah kanak-kanak dan orang tua
Dialog: 0,0:27:05.99,0:27:07.24,teks umum,,0,0,0,,- Ya, tuan\N- Okay
Dialog: 0,0:27:15.16,0:27:18.29,teks umum,,0,0,0,,Kumpulkan semua ahli silap mata Jeonbugwan dan hantar mereka ke Sosnovy Bor
Dialog: 0,0:27:18.37,0:27:20.92,teks am,,0,0,0,,Pergaduhan mungkin tercetus kerana batu ais
Dialog: 0,0:27:21.42,0:27:22.92,teks umum,,0,0,0,,Kita mesti bersedia
Dialog: 0,0:27:23.00,0:27:24.21,teks umum,,0,0,0,,Okay
Dialog: 0,0:27:31.97,0:27:32.85,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:27:32.93,0:27:34.77,teks umum,,0,0,0,,Anda kelihatan sakit
Dialog: 0,0:27:34.85,0:27:36.85,teks umum,,0,0,0,,Anda harus kembali ke istana
Dialog: 0,0:27:37.69,0:27:40.73,teks umum,,0,0,0,,Saya perlu melihat ini dengan mata kepala saya sendiri
Dialog: 0,0:27:41.77,0:27:43.27,teks umum,,0,0,0,,Kami melihat batu ais,
Dialog: 0,0:27:44.36,0:27:46.28,teks umum,,0,0,0,,yang bermaksud bintang Raja tidak jauh
Dialog: 0,0:28:01.50,0:28:04.96,teks umum,,0,0,0,,Mungkin semua orang sedang menunggu kami untuk membawakan "Kata-Kata Hati"
Dialog: 0,0:28:06.51,0:28:07.84,teks umum,,0,0,0,,Jom cepat
Dialog: 0,0:28:16.39,0:28:17.43,teks umum,,0,0,0,,En.
Dialog: 0,0:28:17.52,0:28:18.89,teks umum,,0,0,0,,Kami membawakan "Kata-Kata Hati"
Dialog: 0,0:28:18.98,0:28:20.81,teks umum,,0,0,0,,Tiada masa untuk mereka sekarang
Dialog: 0,0:28:20.90,0:28:22.69,teks umum,,0,0,0,,Penghalang telah muncul di sekeliling Jeongjingak
Dialog: 0,0:28:23.27,0:28:24.40,teks umum,,0,0,0,,Apa?
Dialog: 0,0:28:32.32,0:28:34.12,luar skrin,,0,0,0,,Adakah saya akan ditangkap?
Dialog: 0,0:28:36.29,0:28:38.33,luar skrin,,0,0,0,,Maka mereka pasti akan membunuh
Dialog: 0,0:29:00.02,0:29:01.35,teks umum,,0,0,0,,Ini adalah biskut madu
Dialog: 0,0:29:02.19,0:29:05.06,teks umum,,0,0,0,,Anda hampir tidak makan apa-apa. Bantu diri sendiri
Dialog: 0,0:29:09.61,0:29:11.28,teks umum,,0,0,0,,Terima kasih
Dialog: 0,0:29:13.16,0:29:16.24,teks umum,,0,0,0,,Adakah anda sangat terkejut apabila anda mengetahui bahawa saya adalah anak kepada keluarga Jin?
Dialog: 0,0:29:16.78,0:29:19.75,teks umum,,0,0,0,,Semasa kami mula-mula bertemu, saya belum mengenali ibu bapa saya
Dialog: 0,0:29:21.12,0:29:22.54,teks umum,,0,0,0,,Ini payung anda
Dialog: 0,0:29:24.17,0:29:26.42,teks umum,,0,0,0,,Saya membawanya ke mana-mana
Dialog: 0,0:29:26.50,0:29:28.71,teks umum,,0,0,0,,Saya harap awak akan mengenali saya jika kita berjumpa lagi
Dialog: 0,0:29:32.01,0:29:35.14,teks umum,,0,0,0,,Timbalan Gwangju Jin Mu membantu anda mencari ibu bapa anda?
Dialog: 0,0:29:35.22,0:29:36.22,teks umum,,0,0,0,,Ya
Dialog: 0,0:29:38.18,0:29:42.43,teks umum,,0,0,0,,Tolong jangan beritahu dia yang kita pernah berjumpa sebelum ini
Dialog: 0,0:29:44.60,0:29:46.69,teks umum,,0,0,0,,Jika ibu dapat tahu,
Dialog: 0,0:29:46.77,0:29:49.40,teks umum,,0,0,0,,apa yang saya lalui akan menghancurkan hatinya
Dialog: 0,0:29:51.15,0:29:53.11,teks umum,,0,0,0,,Jadi jangan beritahu dia
Dialog: 0,0:29:54.53,0:29:56.66,luar skrin,,0,0,0,,Semua orang yang mengenalinya telah dibunuh
Dialog: 0,0:29:57.24,0:29:58.66,suara,,0,0,0,,Dia menyelamatkan saya?
Dialog: 0,0:30:01.37,0:30:04.50,kenangan,,0,0,0,,Jin Mu tidak tahu bahawa kita tahu siapa dia
Dialog: 0,0:30:05.04,0:30:06.29,kenangan,,0,0,0,,Ini adalah kelemahannya
Dialog: 0,0:30:06.79,0:30:10.42,kenangan,,0,0,0,,Dia pasti membunuh semua orang untuk menyembunyikan identitinya
Dialog: 0,0:30:10.50,0:30:13.26,kenangan,,0,0,0,,Akhirnya, dia akan mati juga
Dialog: 0,0:30:13.88,0:30:16.64,kenangan,,0,0,0,,Jika permaisuri bercadang untuk memindahkan roh ke dalam tubuhnya...
Dialog: 0,0:30:17.22,0:30:18.55,kenangan,,0,0,0,,Dia dibawa ke sini untuk membunuh
Dialog: 0,0:30:18.64,0:30:21.31,kenangan,,0,0,0,,Dia tidak tahu apa-apa dan melakukan semua yang dia boleh
Dialog: 0,0:30:21.39,0:30:23.06,kenangan,,0,0,0,,Jin Mu menggunakan dia
Dialog: 0,0:30:24.27,0:30:26.23,kenangan,,0,0,0,,Sama seperti Nak Soo
Dialog: 0,0:30:29.94,0:30:32.15,kenangan,,0,0,0,,So Yi juga seorang gadis miskin
Dialog: 0,0:30:34.61,0:30:35.78,teks umum,,0,0,0,,En.
Dialog: 0,0:30:36.36,0:30:37.61,teks umum,,0,0,0,,Tahukah anda,
Dialog: 0,0:30:37.70,0:30:40.03,teks umum,,0,0,0,,bahawa payung ini tidak menjalankan tugasnya?
Dialog: 0,0:30:42.08,0:30:45.29,teks umum,,0,0,0,,Lihat. Dah koyak dah
Dialog: 0,0:30:46.96,0:30:48.04,teks umum,,0,0,0,,Memang benar
Dialog: 0,0:30:48.13,0:30:50.38,teks umum,,0,0,0,,Ia mahal, penjual berkata ia berkualiti tinggi
Dialog: 0,0:30:50.46,0:30:52.25,teks umum,,0,0,0,,Anda pasti telah ditipu
Dialog: 0,0:30:58.47,0:31:00.01,teks umum,,0,0,0,,Saya sangat percaya
Dialog: 0,0:31:00.93,0:31:02.18,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:31:42.55,0:31:44.68,italic,,0,0,0,,Adakah Cikgu Kahn hilang?
Dialog: 0,0:31:45.35,0:31:48.23,teks umum,,0,0,0,,Dia menyerap tenaganya dan pergi
Dialog: 0,0:31:48.73,0:31:51.23,teks umum,,0,0,0,,Kami tidak dapat mencarinya Saejukwon
Dialog: 0,0:31:51.31,0:31:54.36,teks umum,,0,0,0,,Majlis bersatu berlangsung di sebelah dewan latihan
Dialog: 0,0:31:54.44,0:31:55.65,teks umum,,0,0,0,,Tidak mungkin dia pergi ke sana
Dialog: 0,0:31:55.73,0:31:57.65,teks umum,,0,0,0,,Terdapat kekeliruan sepanjang hari,
Dialog: 0,0:31:57.74,0:31:59.45,teks umum,,0,0,0,,tetapi kami akan menyedarinya
Dialog: 0,0:31:59.53,0:32:02.78,teks umum,,0,0,0,,Ada tempat di mana dia boleh bersembunyi
Dialog: 0,0:32:03.45,0:32:04.83,teks umum,,0,0,0,,dan pergi tanpa disedari
Dialog: 0,0:32:07.54,0:32:09.37,teks umum,,0,0,0,,Di dalam penghalang
Dialog: 0,0:32:10.46,0:32:12.42,teks umum,,0,0,0,,Dia mungkin ada di sana
Dialog: 0,0:32:50.33,0:32:51.62,teks umum,,0,0,0,,Nomad
Dialog: 0,0:32:54.59,0:32:56.00,teks umum,,0,0,0,,Saya bersama Jin Mu
Dialog: 0,0:33:00.84,0:33:02.09,teks umum,,0,0,0,,Saya kenal awak
Dialog: 0,0:33:02.76,0:33:04.72,teks umum,,0,0,0,,Saya nampak awak menggerakkan jiwa awak di Jeonbugwan
Dialog: 0,0:33:04.80,0:33:07.10,teks umum,,0,0,0,,Jiwa anda telah meninggalkan jasad lama anda
Dialog: 0,0:33:17.82,0:33:20.99,teks umum,,0,0,0,,Kami berada di pihak yang sama. Lepaskan saya
Dialog: 0,0:33:23.41,0:33:25.41,teks umum,,0,0,0,,Sekarang saya perlukan tenaga manusia
Dialog: 0,0:33:25.49,0:33:27.12,teks umum,,0,0,0,,Saya akan bawakan seseorang untuk anda
Dialog: 0,0:33:27.20,0:33:28.99,teks umum,,0,0,0,,Tenaga ahli silap mata Jeonjingak
Dialog: 0,0:33:29.08,0:33:31.58,teks umum,,0,0,0,,akan lebih baik daripada saya
Dialog: 0,0:33:32.21,0:33:33.75,italic,,0,0,0,,Tunggu di sini,
Dialog: 0,0:33:33.83,0:33:35.79,teks umum,,0,0,0,,Saya akan pikat seseorang ke sini
Dialog: 0,0:33:37.50,0:33:39.59,teks umum,,0,0,0,,- Majusi Jeonjingak?\N- {\i1}Ya
Dialog: 0,0:33:39.67,0:33:41.34,teks umum,,0,0,0,,Oleh kerana halangan, tiada siapa yang boleh
Dialog: 0,0:33:41.42,0:33:43.72,teks umum,,0,0,0,,tidak meninggalkan atau memasuki Chongjingak
Dialog: 0,0:33:44.34,0:33:46.09,teks umum,,0,0,0,,Penghalang?
Dialog: 0,0:34:01.65,0:34:03.03,teks umum,,0,0,0,,Cik Jin?
Dialog: 0,0:34:03.61,0:34:05.28,teks umum,,0,0,0,,Apa yang awak buat di sini?
Dialog: 0,0:34:05.36,0:34:07.28,teks umum,,0,0,0,,Saya sedang mencari sesuatu,
Dialog: 0,0:34:07.37,0:34:09.91,teks umum,,0,0,0,,tetapi kemudian saya menjatuhkan payung saya, saya tidak boleh berjalan tanpanya
Dialog: 0,0:34:11.66,0:34:12.91,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:34:49.24,0:34:50.53,italic,,0,0,0,,Saya tidak akan membunuh awak
Dialog: 0,0:34:50.62,0:34:53.12,teks umum,,0,0,0,,Bawa lebih ramai ahli silap mata
Dialog: 0,0:34:53.70,0:34:54.79,teks umum,,0,0,0,,Okey
Dialog: 0,0:34:58.50,0:34:59.96,teks umum,,0,0,0,,So Yul...
Dialog: 0,0:35:00.67,0:35:02.21,teks umum,,0,0,0,,juga dalam Jeonjingak?
Dialog: 0,0:35:04.88,0:35:05.80,teks umum,,0,0,0,,Apa?
Dialog: 0,0:35:09.30,0:35:10.93,contact,,0,0,0,,Dia cederakan saya dengan pedang
Dialog: 0,0:35:11.51,0:35:13.10,teks umum,,0,0,0,,Saya akan bunuh dia dulu
Dialog: 0,0:35:14.43,0:35:15.60,teks umum,,0,0,0,,Ini dia
Dialog: 0,0:35:16.48,0:35:17.64,teks umum,,0,0,0,,tidak
Dialog: 0,0:35:21.11,0:35:22.48,teks umum,,0,0,0,,Jika anda menolak,
Dialog: 0,0:35:24.19,0:35:25.53,teks umum,,0,0,0,,Saya akan bunuh awak
Dialog: 0,0:35:25.61,0:35:26.61,teks umum,,0,0,0,,Saya akan lakukan segalanya
Dialog: 0,0:35:28.20,0:35:30.74,teks umum,,0,0,0,,Ada seseorang yang ingin saya singkirkan
Dialog: 0,0:35:32.16,0:35:33.83,teks umum,,0,0,0,,Saya akan berikannya
Dialog: 0,0:35:35.33,0:35:37.00,teks umum,,0,0,0,,Tolong bunuh dia
Dialog: 0,0:35:50.89,0:35:53.18,teks umum,,0,0,0,,Snek tidak sedap
Dialog: 0,0:35:53.26,0:35:54.47,teks umum,,0,0,0,,Kuksu juga
Dialog: 0,0:35:56.02,0:35:57.77,suara,,0,0,0,,Saya belum bercakap dengan Chan Wook lagi,
Dialog: 0,0:35:58.35,0:36:00.10,di sebalik tabir,,0,0,0,,jadi saya akan tinggal bersama Moo Deok lebih lama lagi
Dialog: 0,0:36:01.15,0:36:02.69,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:36:03.94,0:36:05.86,teks umum,,0,0,0,,Ini adalah wain bab yang Dan Gu sembunyikan
Dialog: 0,0:36:13.62,0:36:14.95,teks umum,,0,0,0,,Bagaimanakah anda menyukai rasanya?
Dialog: 0,0:36:16.24,0:36:17.79,teks umum,,0,0,0,,Tidak buruk
Dialog: 0,0:36:18.37,0:36:20.04,contact,,0,0,0,,Saya tertanya-tanya apa yang mereka lakukan di luar,
Dialog: 0,0:36:20.12,0:36:22.67,teks umum,,0,0,0,,- memandangkan masalah ini masih belum selesai\N{\i1}- Namun,
Dialog: 0,0:36:22.75,0:36:26.21,teks umum,,0,0,0,,ada bunga di sekeliling, cuaca cantik,
Dialog: 0,0:36:26.30,0:36:28.97,teks umum,,0,0,0,,semuanya wangi. Ia tidak begitu teruk
Dialog: 0,0:36:30.13,0:36:31.05,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:36:31.13,0:36:32.89,teks umum,,0,0,0,,Mengagumi bunga membosankan
Dialog: 0,0:36:32.97,0:36:34.93,teks umum,,0,0,0,,Adakah anda ingin melihat teknik Hyonggon?
Dialog: 0,0:36:35.56,0:36:38.14,teks umum,,0,0,0,,Ini adalah teknik yang cukup menarik
Dialog: 0,0:36:38.23,0:36:39.27,teks umum,,0,0,0,,Betulkah?
Dialog: 0,0:36:40.06,0:36:41.19,teks umum,,0,0,0,,Baiklah, tunjukkan saya
Dialog: 0,0:36:41.77,0:36:42.94,miring,,0,0,0,,Ya
Dialog: 0,0:37:28.86,0:37:29.90,contact,,0,0,0,,Apa?..
Dialog: 0,0:37:29.99,0:37:31.78,teks umum,,0,0,0,,- Bom!\N - Bom!
Dialog: 0,0:37:32.90,0:37:34.41,teks umum,,0,0,0,,Bom, bangun
Dialog: 0,0:37:34.49,0:37:35.70,contact,,0,0,0,,- Ayuh!\N- Hei
Dialog: 0,0:37:35.78,0:37:37.91,contact,,0,0,0,,- Jom naikkan\N- Bom
Dialog: 0,0:37:40.45,0:37:42.54,teks umum,,0,0,0,,Selepas mantra, adakah tenaga anda meninggalkan anda?
Dialog: 0,0:37:42.62,0:37:43.46,teks umum,,0,0,0,,Ya
Dialog: 0,0:37:43.54,0:37:45.75,teks umum,,0,0,0,,Saya rasa tenaga meninggalkan saya
Dialog: 0,0:37:45.83,0:37:46.92,teks umum,,0,0,0,,Seolah-olah
Dialog: 0,0:37:48.13,0:37:50.30,teks umum,,0,0,0,,tenaga dicurahkan seperti dari pasu yang pecah
Dialog: 0,0:37:51.17,0:37:52.72,teks umum,,0,0,0,,Saya memeriksa teras tenaganya,
Dialog: 0,0:37:52.80,0:37:54.55,teks umum,,0,0,0,,dia kehilangan sebahagian besarnya
Dialog: 0,0:37:56.34,0:37:57.85,teks umum,,0,0,0,,Bagaimana saya boleh kehilangan tenaga?
Dialog: 0,0:38:08.40,0:38:09.86,teks umum,,0,0,0,,Mungkin itu pedang?
Dialog: 0,0:38:27.75,0:38:30.17,teks umum,,0,0,0,,Tenaga saya baru sahaja keluar melalui pedang
Dialog: 0,0:38:30.75,0:38:32.76,teks umum,,0,0,0,,Saya rasa masalahnya adalah dalam penghalang
Dialog: 0,0:38:34.80,0:38:36.76,teks umum,,0,0,0,,Nampaknya dia sedang mengambil tenaga,
Dialog: 0,0:38:38.97,0:38:40.51,teks umum,,0,0,0,,apabila anda menggunakan mantra
Dialog: 0,0:38:54.53,0:38:56.32,teks umum,,0,0,0,,Anda tidak boleh menggunakan mantra
Dialog: 0,0:38:56.40,0:38:58.03,teks umum,,0,0,0,,dan lukis pedang
Dialog: 0,0:38:58.82,0:39:00.41,teks umum,,0,0,0,,Mari kita tinggalkan pedang di sini
Dialog: 0,0:39:09.13,0:39:11.63,teks umum,,0,0,0,,Ini adalah pedang Nak Su. Cikgu Li mengambilnya daripada saya
Dialog: 0,0:39:12.17,0:39:13.30,teks umum,,0,0,0,,Adakah anda memilikinya?
Dialog: 0,0:39:13.38,0:39:15.97,teks umum,,0,0,0,,Ya. Dia meminta saya menyimpannya
Dialog: 0,0:39:16.05,0:39:17.84,teks umum,,0,0,0,,Tetapi pembantu rumah Kim tidak suka dia berada di rumah
Dialog: 0,0:39:17.93,0:39:19.34,teks umum,,0,0,0,,Jadi saya tinggalkan di sini
Dialog: 0,0:39:34.03,0:39:35.86,kenangan miring,,0,0,0,,Ambil ini
Dialog: 0,0:39:35.94,0:39:37.61,kenangan,,0,0,0,,dan berikan kepadanya apabila dia kembali
Dialog: 0,0:39:39.57,0:39:42.16,teks umum,,0,0,0,,Saya tidak boleh pergi apabila saya telah diamanahkan dengan ini
Dialog: 0,0:39:43.29,0:39:44.49,contact,,0,0,0,,Maiden Kim
Dialog: 0,0:39:45.62,0:39:46.87,teks umum,,0,0,0,,Apa yang ada?
Dialog: 0,0:39:46.96,0:39:49.42,teks am,,0,0,0,,Adakah majlis bersatu berjalan dengan baik?
Dialog: 0,0:39:49.50,0:39:50.83,teks umum,,0,0,0,,Hampir tidak
Dialog: 0,0:39:50.92,0:39:54.17,teks umum,,0,0,0,,Mage dari semua keluarga kini menuju ke Sosnovy Bor
Dialog: 0,0:39:55.09,0:39:57.05,teks umum,,0,0,0,,Sesuatu pasti telah berlaku
Dialog: 0,0:39:58.63,0:40:01.93,kenangan miring,,0,0,0,,Dia perlu kembali kerana semua kegawatan ini
Dialog: 0,0:40:09.23,0:40:11.98,teks umum,,0,0,0,,Adakah Geng Gwangju Chang benar-benar akan kembali?
Dialog: 0,0:40:36.09,0:40:38.13,teks umum,,0,0,0,,Siapa awak?
Dialog: 0,0:40:41.22,0:40:42.43,teks umum,,0,0,0,,Gwangju
Dialog: 0,0:40:47.43,0:40:51.65,teks am,,0,0,0,,Siapakah pembantu Timbalan Jin Mu sekarang?
Dialog: 0,0:41:16.54,0:41:19.76,kenangan,,0,0,0,,Cho Chan mengancam untuk mendedahkan kebenaran tentang Tuan Muda Chan
Dialog: 0,0:41:19.84,0:41:23.09,kenangan,,0,0,0,,Saya tiada pilihan selain mengajarnya alkimia jiwa
Dialog: 0,0:41:23.64,0:41:27.10,kenangan,,0,0,0,,Dia menjadi liar dan mati, jadi semuanya sudah berakhir?
Dialog: 0,0:41:27.93,0:41:31.27,kenangan miring,,0,0,0,,Saya melakukan ini hanya untuk awak dan anak awak
Dialog: 0,0:41:32.10,0:41:35.94,kenangan,,0,0,0,,Kerana sihir, saya kehilangan isteri dan kawan rapat
Dialog: 0,0:41:37.19,0:41:39.28,kenangan,,0,0,0,,Saya akan menyingkirkan semua pemantul yang tinggal
Dialog: 0,0:41:39.90,0:41:42.15,kenangan,,0,0,0,,Saya akan menutup batu ais di Tasik Gyeongcheongdaeho
Dialog: 0,0:41:42.78,0:41:43.91,kenangan,,0,0,0,,Jangan...
Dialog: 0,0:41:44.86,0:41:47.49,kenangan,,0,0,0,,Anda telah melalui begitu banyak untuk mendapatkannya...
Dialog: 0,0:41:47.58,0:41:49.45,kenangan,,0,0,0,,Bagaimana anda boleh membuang batu itu?
Dialog: 0,0:41:49.54,0:41:50.66,kenangan,,0,0,0,,Anda tidak boleh berbuat demikian!
Dialog: 0,0:41:52.21,0:41:54.29,kenangan,,0,0,0,,Anda juga tahu alkimia,
Dialog: 0,0:41:55.13,0:41:57.96,kenangan,,0,0,0,,jadi saya akan musnahkan teras tenaga awak
Dialog: 0,0:41:58.04,0:41:59.46,kenangan,,0,0,0,,Hancurkan inti?
Dialog: 0,0:42:00.71,0:42:02.17,kenangan,,0,0,0,,Jangan
Dialog: 0,0:42:09.22,0:42:12.02,kenangan miring,,0,0,0,,Tolong jangan musnahkannya
Dialog: 0,0:42:12.10,0:42:15.27,kenangan,,0,0,0,,Saya bersumpah untuk tidak menggunakan alkimia jiwa,
Dialog: 0,0:42:15.77,0:42:19.11,kenangan,,0,0,0,,yang awak ajar saya. Saya berjanji!
Dialog: 0,0:42:37.58,0:42:40.84,di sebalik tabir,,0,0,0,,Ia patut dimusnahkan terasnya ketika itu
Dialog: 0,0:42:43.13,0:42:46.34,luar skrin,,0,0,0,,Daripada menyembunyikan batu ais,
Dialog: 0,0:42:46.93,0:42:48.85,luar skrin,,0,0,0,,Saya sepatutnya memusnahkan dia juga
Dialog: 0,0:42:51.18,0:42:53.89,di sebalik tabir,,0,0,0,,Bagaimana dia berjaya mendapatkannya
Dialog: 0,0:42:55.27,0:42:57.23,di sebalik tabir,,0,0,0,,dari Tasik Gyeongcheongdaeho?
Dialog: 0,0:42:58.31,0:42:59.90,luar skrin,,0,0,0,,Adakah seseorang menolongnya?
Dialog: 0,0:43:31.68,0:43:33.43,teks umum,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:43:35.14,0:43:37.56,teks umum,,0,0,0,,Tetapi ada satu perbezaan antara kita
Dialog: 0,0:43:38.94,0:43:40.19,teks umum,,0,0,0,,I
Dialog: 0,0:43:42.44,0:43:43.94,teks umum,,0,0,0,,nomad
Dialog: 0,0:43:47.32,0:43:48.66,teks umum,,0,0,0,,Hey Bom
Dialog: 0,0:43:49.53,0:43:50.91,teks umum,,0,0,0,,Senaman akan membuatkan anda kembali sihat
Dialog: 0,0:43:51.49,0:43:54.16,miring,,0,0,0,,Dia betul, semuanya akan baik-baik saja
Dialog: 0,0:43:54.24,0:43:55.45,teks umum,,0,0,0,,Bergembiralah
Dialog: 0,0:43:55.54,0:43:58.62,luar skrin,,0,0,0,,Batu ais menyerap tenaga mereka
Dialog: 0,0:43:58.71,0:44:01.67,luar skrin,,0,0,0,,Jika saya menukar badan saya dan mengambil batu itu,
Dialog: 0,0:44:02.25,0:44:04.92,suara,,0,0,0,,adakah saya akan mengambil tenaga mereka juga?
Dialog: 0,0:44:05.63,0:44:08.01,kenangan miring,,0,0,0,,Anda mendapat sesuatu, anda kehilangan sesuatu
Dialog: 0,0:44:08.09,0:44:10.84,kenangan,,0,0,0,,Ini adalah beban yang perlu anda tanggung
Dialog: 0,0:44:11.89,0:44:13.72,teks umum,,0,0,0,,Jika saya mahukan kuasa saya kembali,
Dialog: 0,0:44:15.85,0:44:18.14,teks umum,,0,0,0,,Saya perlu menyerap tenaga mereka
Dialog: 0,0:44:19.44,0:44:20.35,condong,,0,0,0,,Kemudian
Dialog: 0,0:44:21.02,0:44:22.48,teks umum,,0,0,0,,mereka semua akan mati
Dialog: 0,0:44:33.58,0:44:35.20,teks umum,,0,0,0,,Saya akan bertanggungjawab
Dialog: 0,0:44:36.16,0:44:38.04,teks umum,,0,0,0,,dalam kematian mereka
Dialog: 0,0:44:41.79,0:44:44.54,teks umum,,0,0,0,,Won Moo Deok, awak buat apa di sini?
Dialog: 0,0:44:50.80,0:44:52.34,luar skrin,,0,0,0,,Dia akan mati juga
Dialog: 0,0:44:53.14,0:44:54.47,contact,,0,0,0,,Merbahaya di sini
Dialog: 0,0:44:54.55,0:44:56.60,teks umum,,0,0,0,,Jika anda menyentuh penghalang,
Dialog: 0,0:44:56.68,0:44:58.64,teks umum,,0,0,0,,anda akan patahkan semua tulang anda
Dialog: 0,0:44:58.73,0:45:00.23,teks umum,,0,0,0,,Alih pergi
Dialog: 0,0:45:04.40,0:45:06.11,teks umum,,0,0,0,,Adakah anda ingin mengucapkan terima kasih kepada saya?
Dialog: 0,0:45:07.94,0:45:10.24,teks umum,,0,0,0,,Saya menunjukkan kebimbangan terhadap anda
Dialog: 0,0:45:13.28,0:45:15.33,teks umum,,0,0,0,,Awak hilang tenaga tadi
Dialog: 0,0:45:16.24,0:45:17.54,teks umum,,0,0,0,,Apakah perasaan anda?
Dialog: 0,0:45:19.70,0:45:22.17,teks umum,,0,0,0,,Adakah anda menyatakan rasa terima kasih dengan risau tentang saya?
Dialog: 0,0:45:23.25,0:45:24.38,teks umum,,0,0,0,,Tidak buruk
Dialog: 0,0:45:25.50,0:45:27.25,teks umum,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:45:28.42,0:45:29.59,teks umum,,0,0,0,,Maafkan saya
Dialog: 0,0:45:29.67,0:45:30.92,teks umum,,0,0,0,,Untuk apa?
Dialog: 0,0:45:31.01,0:45:34.51,teks umum,,0,0,0,,Untuk menyediakan makanan ringan dan kuksa yang dahsyat
Dialog: 0,0:45:35.05,0:45:36.72,teks umum,,0,0,0,,Anda tidak boleh makan pun
Dialog: 0,0:45:42.35,0:45:43.94,teks umum,,0,0,0,,Ambil ini
Dialog: 0,0:45:48.36,0:45:49.98,teks umum,,0,0,0,,kuki kegemaran Chan Wook
Dialog: 0,0:45:50.49,0:45:52.86,teks umum,,0,0,0,,Adakah anda berkongsi dengan saya apa yang dia berikan kepada anda?
Dialog: 0,0:45:52.95,0:45:55.45,miring,,0,0,0,,Tidak perlu, simpan untuk diri sendiri
Dialog: 0,0:45:57.37,0:46:00.37,teks umum,,0,0,0,,Saya tahu saya perlu mengambilnya
Dialog: 0,0:46:01.87,0:46:05.67,teks umum,,0,0,0,,Tetapi saya memutuskan untuk memberikannya kepada anda. Semua
Dialog: 0,0:46:08.63,0:46:10.25,teks umum,,0,0,0,,Saya berikan kepada anda
Dialog: 0,0:46:11.80,0:46:14.88,suara,,0,0,0,,Dia bukan orang yang paling baik, tetapi dia menjaga saya selama ini
Dialog: 0,0:46:18.47,0:46:19.35,condong,,0,0,0,,Ambil
Dialog: 0,0:46:19.43,0:46:21.56,teks umum,,0,0,0,,Saya ingin mengucapkan terima kasih yang ikhlas
Dialog: 0,0:46:22.93,0:46:24.89,teks umum,,0,0,0,,- Yang ikhlas?{\i1}\N- Ya
Dialog: 0,0:46:25.56,0:46:26.94,teks umum,,0,0,0,,Dari lubuk hati saya
Dialog: 0,0:46:28.40,0:46:30.23,teks umum,,0,0,0,,Saya sentiasa berterima kasih kepada anda
Dialog: 0,0:46:34.65,0:46:37.28,teks umum,,0,0,0,,Jika anda ingin berterima kasih kepada saya dengan ikhlas,
Dialog: 0,0:46:38.12,0:46:41.33,teks umum,,0,0,0,,beri saya sesuatu yang lebih
Dialog: 0,0:46:42.79,0:46:44.33,teks umum,,0,0,0,,Sesuatu yang lebih penting
Dialog: 0,0:46:51.63,0:46:52.92,teks umum,,0,0,0,,Terima sahaja
Dialog: 0,0:46:54.42,0:46:56.34,teks umum,,0,0,0,,Ini yang anda perlukan
Dialog: 0,0:47:00.22,0:47:02.14,teks umum,,0,0,0,,Anda luar biasa
Dialog: 0,0:47:04.18,0:47:07.15,teks umum,,0,0,0,,Sentiasa berani dan capai matlamat anda
Dialog: 0,0:47:07.73,0:47:10.52,miring,,0,0,0,,Tetapi setiap kali saya menghubungi awak, awak berundur
Dialog: 0,0:47:13.65,0:47:16.45,teks umum,,0,0,0,,Sebab saya tidak cuba menahan awak ialah,
Dialog: 0,0:47:17.11,0:47:19.49,teks umum,,0,0,0,,bagaimana jika akhirnya awak tetap menolak saya, saya...
Dialog: 0,0:47:24.79,0:47:27.54,teks umum,,0,0,0,,Lupakan, saya tidak akan menerima ucapan terima kasih anda dalam kuantiti sedemikian
Dialog: 0,0:47:41.01,0:47:43.77,teks umum,,0,0,0,,Saya akan berasa kurang teruk jika dia menerimanya
Dialog: 0,0:47:47.77,0:47:48.90,di sebalik tabir,,0,0,0,,Itu lebih baik
Dialog: 0,0:47:49.69,0:47:52.15,suara,,0,0,0,,Saya tidak sepatutnya rasa bersalah
Dialog: 0,0:48:16.46,0:48:17.30,miring,,0,0,0,,Moo Dok
Dialog: 0,0:48:20.18,0:48:21.64,teks umum,,0,0,0,,Saya ada permintaan untuk anda
Dialog: 0,0:48:22.35,0:48:24.60,teks umum,,0,0,0,,Bolehkah awak pergi ke sayap ahli sihir untuk saya?
Dialog: 0,0:48:25.89,0:48:27.06,teks umum,,0,0,0,,Kenapa?
Dialog: 0,0:48:27.14,0:48:30.14,teks umum,,0,0,0,,Sejuk di sini. Boleh awak bawakan saya selimut?
Dialog: 0,0:48:31.06,0:48:32.65,teks umum,,0,0,0,,Saya mendengar bahawa ia disimpan di sana
Dialog: 0,0:48:46.83,0:48:48.04,teks umum,,0,0,0,,Okey
Dialog: 0,0:49:08.18,0:49:09.85,teks umum,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:49:09.93,0:49:12.06,teks umum,,0,0,0,,Cuba memadamkan api di dalam brazier
Dialog: 0,0:49:31.00,0:49:32.00,teks umum,,0,0,0,,Wah
Dialog: 0,0:49:32.92,0:49:34.21,teks umum,,0,0,0,,Adakah anda serius?
Dialog: 0,0:49:34.79,0:49:36.04,teks umum,,0,0,0,,Adakah anda benar-benar bodoh?
Dialog: 0,0:49:38.71,0:49:39.92,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:49:43.01,0:49:45.80,teks umum,,0,0,0,,Awak baru panggil saya bodoh?
Dialog: 0,0:49:45.89,0:49:47.56,teks umum,,0,0,0,,Terdapat ratusan buku di sini
Dialog: 0,0:49:47.64,0:49:49.22,teks umum,,0,0,0,,Anda boleh membakar semuanya
Dialog: 0,0:49:49.31,0:49:51.27,teks umum,,0,0,0,,Saya mengawal api dengan jampi
Dialog: 0,0:49:51.35,0:49:52.77,teks umum,,0,0,0,,Saya tidak boleh menggunakan kekerasan,
Dialog: 0,0:49:54.02,0:49:55.31,teks umum,,0,0,0,,sangat keliru
Dialog: 0,0:49:55.40,0:49:58.77,teks umum,,0,0,0,,Tetapi anda boleh menutupnya dengan penutup
Dialog: 0,0:49:58.86,0:50:00.57,contact,,0,0,0,,Orang memanggil anda genius
Dialog: 0,0:50:00.65,0:50:02.57,teks umum,,0,0,0,,Tetapi anda hilang kawalan dalam situasi yang sukar
Dialog: 0,0:50:02.65,0:50:05.03,teks umum,,0,0,0,,- Anda hanya seorang yang bodoh{\i1}\N- Jangan menghina saya
Dialog: 0,0:50:05.11,0:50:06.66,teks umum,,0,0,0,,Saya akan tersinggung
Dialog: 0,0:50:08.49,0:50:10.08,teks umum,,0,0,0,,Jadi anda tahu bagaimana untuk tersinggung
Dialog: 0,0:50:11.37,0:50:13.54,teks umum,,0,0,0,,Anda sentiasa tenang seperti air
Dialog: 0,0:50:14.04,0:50:16.79,teks umum,,0,0,0,,Malah air boleh mendidih atau membeku
Dialog: 0,0:50:17.67,0:50:19.17,miring,,0,0,0,,Dia tidak sentiasa tenang
Dialog: 0,0:50:27.43,0:50:29.85,teks umum,,0,0,0,,Ia menjadi lembap kerana kabus
Dialog: 0,0:50:29.93,0:50:32.48,teks umum,,0,0,0,,Adakah anda menyalakan api kerana kaki anda sakit?
Dialog: 0,0:50:34.85,0:50:37.40,teks umum,,0,0,0,,Adakah anda ingat ini
Dialog: 0,0:50:38.86,0:50:40.02,contact,,0,0,0,,Saya tidak apa-apa
Dialog: 0,0:50:40.11,0:50:41.28,teks umum,,0,0,0,,Jangan risau
Dialog: 0,0:50:45.28,0:50:47.66,teks umum,,0,0,0,,Adakah anda suka teh jarum pain
Dialog: 0,0:50:49.66,0:50:51.16,teks umum,,0,0,0,,Tetapi saya tidak dapat membancuhnya untuk anda
Dialog: 0,0:50:52.20,0:50:53.70,teks umum,,0,0,0,,Anda ingat ini juga
Dialog: 0,0:50:55.54,0:50:57.08,teks umum,,0,0,0,,Dan apakah maksudnya?
Dialog: 0,0:50:57.79,0:50:59.54,teks umum,,0,0,0,,Hanya ingat
Dialog: 0,0:51:00.42,0:51:02.67,teks umum,,0,0,0,,Bancuh lain kali
Dialog: 0,0:51:05.72,0:51:07.30,di sebalik tabir,,0,0,0,,Tiada masa akan datang
Dialog: 0,0:51:07.39,0:51:11.51,suara,,0,0,0,,Kalau saya tukar badan, dia akan mati juga
Dialog: 0,0:51:11.60,0:51:12.47,miring,,0,0,0,,Atau lebih baik
Dialog: 0,0:51:12.56,0:51:14.85,teks umum,,0,0,0,,ajar saya
Dialog: 0,0:51:14.93,0:51:17.90,teks umum,,0,0,0,,Kemudian saya akan membancuhnya sendiri. Macam lepas
Dialog: 0,0:51:18.56,0:51:19.86,contact,,0,0,0,,Ingat?
Dialog: 0,0:51:27.11,0:51:28.24,teks umum,,0,0,0,,Saya menghargai
Dialog: 0,0:51:29.12,0:51:31.12,teks umum,,0,0,0,,semua kenangan daripada Danhyangok
Dialog: 0,0:51:40.79,0:51:43.75,luar skrin,,0,0,0,,Jadi Yul akan mati
Dialog: 0,0:51:48.63,0:51:51.60,teks umum,,0,0,0,,Saya pergi ke sayap ahli silap mata untuk mendapatkan selimut
Dialog: 0,0:51:51.68,0:51:53.06,teks umum,,0,0,0,,Saya akan pergi
Dialog: 0,0:52:01.15,0:52:04.07,teks umum,,0,0,0,,Saya akan pergi, dan anda pergi ke Uku
Dialog: 0,0:52:13.58,0:52:15.33,teks umum,,0,0,0,,Dia mencari anda di mana-mana
Dialog: 0,0:52:27.92,0:52:29.63,suara,,0,0,0,,Saya cuma perlu jadi Nak Soo semula
Dialog: 0,0:52:30.89,0:52:33.18,suara,,0,0,0,,Saya sudah memutuskan hubungan dengannya pada masa lalu
Dialog: 0,0:52:35.22,0:52:36.97,suara,,0,0,0,,Saya akan melakukan perkara yang sama dengan orang lain
Dialog: 0,0:52:50.24,0:52:53.12,teks umum,,0,0,0,,Penghalang tidak akan terlepas dari pandangan anda
Dialog: 0,0:52:59.71,0:53:00.79,teks umum,,0,0,0,,Adakah anda lihat?
Dialog: 0,0:53:01.62,0:53:03.21,teks umum,,0,0,0,,Batu itu melaluinya
Dialog: 0,0:53:04.04,0:53:05.09,teks umum,,0,0,0,,Anda betul
Dialog: 0,0:53:06.00,0:53:08.21,teks umum,,0,0,0,,Mungkin hanya benda yang diperbuat daripada air tidak boleh lulus
Dialog: 0,0:53:08.30,0:53:09.80,contact,,0,0,0,,Sungguh pelik halangan
Dialog: 0,0:53:09.88,0:53:12.76,teks umum,,0,0,0,,Dia memutuskan perkara yang hendak dilangkau
Dialog: 0,0:53:12.84,0:53:14.30,teks umum,,0,0,0,,Apakah jenis penghalang ini?
Dialog: 0,0:53:15.01,0:53:16.68,teks umum,,0,0,0,,Dan apakah yang sedang dilakukan oleh yang lain?
Dialog: 0,0:53:16.76,0:53:20.52,teks umum,,0,0,0,,Terdapat banyak ahli silap mata yang hebat di sana, tetapi mereka masih belum dapat memecahkannya
Dialog: 0,0:53:21.94,0:53:23.69,teks umum,,0,0,0,,Adakah kerana batu ais menciptanya?
Dialog: 0,0:53:23.77,0:53:27.61,teks umum,,0,0,0,,Mereka mungkin sibuk bertengkar tentang siapa yang dapat batu
Dialog: 0,0:53:27.69,0:53:30.82,teks umum,,0,0,0,,Tetapi mereka tahu bahawa saya dikunci di sini
Dialog: 0,0:53:32.45,0:53:37.20,teks umum,,0,0,0,,Mungkin anda tidak begitu penting kepada permaisuri yang mempunyai batu ais
Dialog: 0,0:53:38.66,0:53:40.12,contact,,0,0,0,,Bagaimana seorang ibu boleh berkelakuan seperti ini?
Dialog: 0,0:53:41.12,0:53:43.04,teks umum,,0,0,0,,Atau adakah dia kelihatan seperti bapa saya?
Dialog: 0,0:53:45.21,0:53:46.71,teks umum,,0,0,0,,Betul
Dialog: 0,0:53:46.79,0:53:50.46,teks umum,,0,0,0,,Seperti yang anda tahu, dia bukan ibu kandung saya
Dialog: 0,0:53:51.55,0:53:53.47,teks umum,,0,0,0,,Seperti bapa kamu kepada kamu
Dialog: 0,0:53:55.64,0:53:57.14,teks umum,,0,0,0,,Semua orang bercakap mengenainya
Dialog: 0,0:53:57.97,0:53:59.89,teks umum,,0,0,0,,Saya tidak akan meminta maaf, walaupun ia menyakiti anda
Dialog: 0,0:54:00.60,0:54:02.48,teks umum,,0,0,0,,Maka saya juga tidak akan berpusing-pusing
Dialog: 0,0:54:03.19,0:54:06.90,teks umum,,0,0,0,,Jika permaisuri dan Jin Mu menawarkan anda kuasa batu ais,
Dialog: 0,0:54:06.98,0:54:08.36,teks umum,,0,0,0,,bolehkah anda menyingkirkannya?
Dialog: 0,0:54:11.36,0:54:15.66,teks umum,,0,0,0,,Sukar untuk menolak kuasa yang luar biasa itu
Dialog: 0,0:54:16.62,0:54:17.83,teks umum,,0,0,0,,Anda berani
Dialog: 0,0:54:19.33,0:54:21.95,teks umum,,0,0,0,,Memerlukan keberanian untuk mengakui ketamakan anda secara terbuka
Dialog: 0,0:54:26.29,0:54:29.80,teks umum,,0,0,0,,Dan awak? Apa yang anda akan lakukan jika anda memilikinya?
Dialog: 0,0:54:33.30,0:54:35.18,teks umum,,0,0,0,,Saya akan bertindak seperti Master So Kyung
Dialog: 0,0:54:35.26,0:54:36.43,teks umum,,0,0,0,,So Kyung?
Dialog: 0,0:54:38.01,0:54:40.76,teks umum,,0,0,0,,Adakah anda ingin menjadi wira dengan takdir bintang diraja,
Dialog: 0,0:54:40.85,0:54:42.77,teks umum,,0,0,0,,musnahkan semua batu dan selamatkan dunia?
Dialog: 0,0:54:42.85,0:54:46.44,teks umum,,0,0,0,,Saya pasti dia melakukannya dengan niat yang terbaik
Dialog: 0,0:54:47.52,0:54:50.86,teks umum,,0,0,0,,Dan saya percaya dia meninggalkan satu batu untuk menyelamatkan orang yang dia sayang
Dialog: 0,0:54:51.48,0:54:53.11,teks umum,,0,0,0,,juga dengan niat yang terbaik
Dialog: 0,0:54:53.61,0:54:56.07,teks umum,,0,0,0,,Anda lihat, bahagian ini paling bergema dengan saya
Dialog: 0,0:54:59.41,0:55:01.91,teks umum,,0,0,0,,Jadi, inilah yang dia tulis dalam bukunya
Dialog: 0,0:55:01.99,0:55:05.29,teks umum,,0,0,0,,Ini hanyalah alasan untuk tidak dapat menyingkirkan batu itu
Dialog: 0,0:55:06.08,0:55:07.37,teks umum,,0,0,0,,Siapa yang akan percaya ini?
Dialog: 0,0:55:07.46,0:55:08.83,teks umum,,0,0,0,,Saya percaya
Dialog: 0,0:55:10.79,0:55:13.46,teks umum,,0,0,0,, Kerana saya akan melakukan perkara yang sama
Dialog: 0,0:55:31.02,0:55:32.19,teks umum,,0,0,0,,Apa?
Dialog: 0,0:55:32.27,0:55:34.07,teks umum,,0,0,0,,Batu melepasi penghalang
Dialog: 0,0:55:34.15,0:55:36.61,teks umum,,0,0,0,,Hantar mesej kepada mereka supaya mereka dapat menyelamatkan anda dengan cepat
Dialog: 0,0:55:39.82,0:55:40.66,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:55:42.12,0:55:43.24,teks umum,,0,0,0,,Anda seorang genius
Dialog: 0,0:55:47.25,0:55:48.33,teks umum,,0,0,0,,Mari kita lihat
Dialog: 0,0:55:51.67,0:55:53.84,teks umum,,0,0,0,,- Penghalang{\i1}\N- Hey Chan Wook
Dialog: 0,0:55:54.59,0:55:56.42,teks umum,,0,0,0,,Adakah batu yang lebih besar?
Dialog: 0,0:55:56.51,0:55:58.30,teks umum,,0,0,0,,Mereka hanya perlu membaca mesej anda
Dialog: 0,0:55:58.38,0:56:00.09,teks umum,,0,0,0,,Anda tidak memerlukan batu besar
Dialog: 0,0:56:00.18,0:56:01.68,italic,,0,0,0,,Mesti ditulis dengan huruf besar
Dialog: 0,0:56:02.39,0:56:04.56,teks umum,,0,0,0,,Batu ini tidak boleh diangkat?
Dialog: 0,0:56:07.43,0:56:08.69,teks umum,,0,0,0,,- Jom minum\N- Jom minum
Dialog: 0,0:56:09.69,0:56:12.27,teks umum,,0,0,0,,By the way, kenapa Dan Gu tidak pernah memberitahu kami
Dialog: 0,0:56:12.36,0:56:14.86,miring,,0,0,0,,tentang bekalan rahsia alkohol anda?
Dialog: 0,0:56:14.94,0:56:17.28,miring,,0,0,0,,Kita mesti minum semua di sini, minum
Dialog: 0,0:56:17.36,0:56:19.78,contact,,0,0,0,,- Jom minum\N- Jom minum
Dialog: 0,0:56:24.49,0:56:25.87,teks umum,,0,0,0,,Saya bawa satu lagi brazier
Dialog: 0,0:56:28.25,0:56:29.46,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:56:30.04,0:56:31.83,teks umum,,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:56:31.92,0:56:33.00,teks umum,,0,0,0,,Dalam erti kata apa?
Dialog: 0,0:56:35.00,0:56:37.59,teks umum,,0,0,0,,En. Yul pergi ambil sendiri selimut
Dialog: 0,0:56:40.84,0:56:42.64,kenangan miring,,0,0,0,,Jadi Yul juga berada di Jeonjingak
Dialog: 0,0:56:42.72,0:56:44.60,kenangan,,0,0,0,,saya akan bunuh dia dulu
Dialog: 0,0:57:15.09,0:57:17.59,teks umum,,0,0,0,,En. Yul, kamu tidak dibenarkan masuk ke sana
Dialog: 0,0:57:18.84,0:57:21.18,teks umum,,0,0,0,,- Apa yang berlaku?\N- Balik
Dialog: 0,0:57:22.89,0:57:25.30,teks umum,,0,0,0,,Boleh jumpa saya?
Dialog: 0,0:57:25.89,0:57:27.43,teks umum,,0,0,0,,Nah...
Dialog: 0,0:58:00.18,0:58:01.72,teks umum,,0,0,0,,En!
Dialog: 0,0:58:32.17,0:58:33.38,italic,,0,0,0,,Mr.
Dialog: 0,0:58:35.34,0:58:38.55,teks umum,,0,0,0,,Tuan, apakah yang perlu kami lakukan?
Dialog: 0,0:58:56.99,0:58:58.15,contact,,0,0,0,,Apa yang perlu dilakukan?
Dialog: 0,0:59:22.22,0:59:23.47,italic,,0,0,0,,Apa ini?
Dialog: 0,0:59:23.55,0:59:25.64,teks umum,,0,0,0,,Siapa awak?
Dialog: 0,0:59:54.29,0:59:55.71,teks umum,,0,0,0,,Yul!
Dialog: 0,0:59:55.79,0:59:56.63,teks umum,,0,0,0,,Yul!
Dialog: 0,1:00:03.09,1:00:05.47,teks umum,,0,0,0,,- Tuan\N- Awak okay?
Dialog: 0,1:00:37.25,1:00:38.38,teks umum,,0,0,0,,Yul
Dialog: 0,1:00:40.05,1:00:41.84,teks umum,,0,0,0,,- Apa yang berlaku?{\i1}\N- Nomad
Dialog: 0,1:00:41.92,1:00:43.09,teks umum,,0,0,0,,Ada nomad di sini
Dialog: 0,1:00:43.18,1:00:44.43,teks umum,,0,0,0,,Apa?
Dialog: 0,1:00:47.93,1:00:49.26,teks umum,,0,0,0,,Ada seorang nomad
Dialog: 0,1:00:49.35,1:00:51.98,contact,,0,0,0,,Dia menyerap tenaga Yoon Soo dan Jin Ho
Dialog: 0,1:01:07.62,1:01:10.79,teks umum,,0,0,0,,The Nomad ialah master Kan Degantongun, dia sangat kuat
Dialog: 0,1:01:10.87,1:01:14.21,teks umum,,0,0,0,,Dan dia menggunakan tenaga untuk mengucapkan mantra
Dialog: 0,1:01:14.29,1:01:16.54,teks umum,,0,0,0,,Tiada seorang pun daripada kita boleh menggunakan kekerasan di sini
Dialog: 0,1:01:17.21,1:01:18.63,teks umum,,0,0,0,,Kenapa dia berjaya?
Dialog: 0,1:01:18.71,1:01:21.09,teks umum,,0,0,0,,Tempat ini menyerap tenaga kita,
Dialog: 0,1:01:21.17,1:01:22.63,teks umum,,0,0,0,,tetapi bagi mereka sebaliknya, nampaknya
Dialog: 0,1:01:25.59,1:01:27.43,kenangan miring,,0,0,0,,Jika saya mendapat semula kuasa saya
Dialog: 0,1:01:28.05,1:01:30.22,kenangan,,0,0,0,,dan lari dengan batu?
Dialog: 0,1:01:30.89,1:01:33.64,kenangan,,0,0,0,,Jika anda ditangkap, anda mungkin akan dibunuh
Dialog: 0,1:01:35.10,1:01:36.31,kenangan,,0,0,0,,Awak tak takut ke?
Dialog: 0,1:01:36.40,1:01:38.48,kenangan,,0,0,0,,saya agak takut
Dialog: 0,1:01:38.56,1:01:41.07,kenangan,,0,0,0,,saya takut awak mungkir janji kita
Dialog: 0,1:01:41.15,1:01:42.99,kenangan,,0,0,0,,dan awak tinggalkan saya tanpa mengucapkan selamat tinggal
Dialog: 0,1:01:45.40,1:01:47.70,kenangan,,0,0,0,,- Chan Wook, saya...\N{\i1}- Tuan
Dialog: 0,1:01:52.16,1:01:55.12,teks umum,,0,0,0,,Di manakah Moo Dok?
Dialog: 0,1:01:55.71,1:01:57.50,teks umum,,0,0,0,,Dia berada di sini tidak lama dahulu
Dialog: 0,1:01:58.13,1:01:59.38,contact,,0,0,0,,Ke mana dia pergi?
Dialog: 0,1:02:06.09,1:02:07.97,teks umum,,0,0,0,,Masalah telah muncul
Dialog: 0,1:02:18.44,1:02:20.77,teks umum,,0,0,0,,Jika dia tidak dihentikan, mereka semua akan mati
Dialog: 0,1:02:22.82,1:02:25.69,teks umum,,0,0,0,,Mereka tetap akan mati jika saya menukar mayat
Dialog: 0,1:02:25.78,1:02:27.70,teks umum,,0,0,0,,Lucu untuk menyelamatkan mereka sekarang
Dialog: 0,1:02:28.82,1:02:30.70,teks umum,,0,0,0,,Jadi saya akan memutuskan hubungan dengan mereka
Dialog: 0,1:02:35.50,1:02:37.75,teks umum,,0,0,0,,Tetapi saya masih resah
Dialog: 0,1:02:38.33,1:02:41.08,teks umum,,0,0,0,,Ini akan menjadi kali terakhir saya menyimpannya
Dialog: 0,1:02:42.00,1:02:43.17,teks umum,,0,0,0,,Sekali lagi
Dialog: 0,1:02:45.63,1:02:46.72,teks umum,,0,0,0,,Anda...
Dialog: 0,1:02:48.01,1:02:50.72,teks umum,,0,0,0,,- Awak ke mana?\N- Saya datang
Dialog: 0,1:02:51.22,1:02:52.30,teks umum,,0,0,0,,Uk...
Dialog: 0,1:02:52.93,1:02:54.14,teks umum,,0,0,0,,Chan Wook boleh mati!
Dialog: 0,1:03:15.58,1:03:17.37,kenangan miring,,0,0,0,,Tiada siapa yang boleh mengalahkannya sekarang
Dialog: 0,1:03:18.08,1:03:19.71,kenangan miring,,0,0,0,,Kita tidak boleh mati
Dialog: 0,1:03:19.79,1:03:22.25,kenangan miring,,0,0,0,,Saya akan cuba pikat dia masuk ke bilik rahsia
Dialog: 0,1:03:25.92,1:03:28.92,contact,,0,0,0,,Apabila dia mengunci nomad bersamanya di dalam bilik rahsia,
Dialog: 0,1:03:29.01,1:03:30.34,teks umum,,0,0,0,,Uk juga akan mati
Dialog: 0,1:03:30.88,1:03:31.97,teks umum,,0,0,0,,Kenapa?
Dialog: 0,1:03:32.72,1:03:34.30,teks umum,,0,0,0,,Kenapa dia pergi seorang diri?
Dialog: 0,1:03:35.22,1:03:37.60,italic,,0,0,0,,Dia kata dia terpaksa
Dialog: 0,1:03:37.68,1:03:39.10,teks umum,,0,0,0,,Kata itu tanggungjawab dia
Dialog: 0,1:03:46.48,1:03:49.07,teks umum,,0,0,0,,- Awak nak ke mana?\N- Ke bilik rahsia
Dialog: 0,1:03:50.45,1:03:52.45,teks umum,,0,0,0,,Jika pintu bilik rahsia terbuka,
Dialog: 0,1:03:53.87,1:03:56.41,teks umum,,0,0,0,,yang bermaksud Uk mati dan tidak dapat memikatnya ke sana
Dialog: 0,1:03:56.49,1:03:57.99,contact,,0,0,0,,Jika pintu ditutup,
Dialog: 0,1:03:58.91,1:04:00.54,condong,,0,0,0,,maka dia mungkin sudah mati
Dialog: 0,1:04:01.29,1:04:02.50,teks umum,,0,0,0,,Ini tidak masuk akal
Dialog: 0,1:04:04.79,1:04:07.67,teks umum,,0,0,0,,Kamu kata kamu tidak akan cuba menahan saya
Dialog: 0,1:04:08.63,1:04:10.38,teks umum,,0,0,0,,Anda tidak boleh menghalang saya
Dialog: 0,1:04:11.38,1:04:12.76,teks umum,,0,0,0,,Tolong lepaskan saya
Dialog: 0,1:05:11.40,1:05:14.99,kenangan miring,,0,0,0,,Jika pintu ditutup, maka dia mungkin sudah mati
Dialog: 0,1:05:19.33,1:05:22.87,kenangan miring,,0,0,0,,Tetapi saya tidak akan memutarkan masa, walaupun saya menyesali sesuatu
Dialog: 0,1:05:24.33,1:05:25.54,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:08:19.42,1:08:20.84,teks umum,,0,0,0,,Anda masih hidup,
Dialog: 0,1:08:23.01,1:08:24.43,teks umum,,0,0,0,,pelajar saya
Dialog: 0,1:08:43.61,1:08:45.24,teks umum,,0,0,0,,Kenapa awak sembunyikan perkara ini daripada saya?
Dialog: 0,1:08:49.49,1:08:50.62,teks umum,,0,0,0,,Sebab
Dialog: 0,1:08:52.62,1:08:53.87,teks umum,,0,0,0,,mahu kamu mati
Dialog: 0,1:08:55.67,1:08:56.84,teks umum,,0,0,0,,Kemudian
Dialog: 0,1:08:58.09,1:08:59.38,teks umum,,0,0,0,,kenapa awak datang?
Dialog: 0,1:09:02.72,1:09:03.84,teks umum,,0,0,0,,Sebab
Dialog: 0,1:09:08.05,1:09:09.56,teks umum,,0,0,0,,anda boleh mati
Dialog: 0,1:09:16.23,1:09:17.98,teks umum,,0,0,0,,Sejak kamu mengambil pedang,
Dialog: 0,1:09:19.36,1:09:20.69,teks umum,,0,0,0,,buat pilihan anda
Dialog: 0,1:09:23.65,1:09:25.41,teks umum,,0,0,0,,Saya tahu awak mengelak saya
Dialog: 0,1:09:25.49,1:09:28.12,teks umum,,0,0,0,,Saya tahu bahawa hidup kami di tangan anda
Dialog: 0,1:09:32.54,1:09:33.87,teks umum,,0,0,0,,Seperti yang dijanjikan,
Dialog: 0,1:09:34.96,1:09:36.54,teks umum,,0,0,0,,acukan pedang awak kepada saya dahulu
Dialog: 0,1:09:50.93,1:09:51.97,kenangan,,0,0,0,,Anda akan membunuh,
Dialog: 0,1:09:52.68,1:09:55.27,kenangan,,0,0,0,,Saya akan menjadi orang yang mati,
Dialog: 0,1:09:56.02,1:09:57.40,kenangan,,0,0,0,,membebaskan tentera upahan
Dialog: 0,1:09:59.56,1:10:00.86,kenangan,,0,0,0,,Ampunilah -
Dialog: 0,1:10:01.69,1:10:03.69,kenangan,,0,0,0,,Saya akan berjanji lagi
Dialog: 0,1:10:27.09,1:10:28.22,teks umum,,0,0,0,,Sekarang,
Dialog: 0,1:10:32.68,1:10:34.56,teks umum,,0,0,0,,seperti yang anda katakan,
Dialog: 0,1:10:36.14,1:10:37.98,teks umum,,0,0,0,,beri saya janji lagi
Dialog: 0,1:11:51.42,1:11:54.60,pratonton,,0,0,0,,Orang jenis apakah yang boleh menolak kuasa yang luar biasa itu?
Dialog: 0,1:11:54.68,1:11:56.97,pratonton,,0,0,0,,Untuk melindungi apa yang kita mesti...
Dialog: 0,1:11:57.06,1:11:58.47,pratonton,,0,0,0,,Bagaimana jika saya memberikan segalanya?
Dialog: 0,1:11:58.56,1:12:00.35,pratonton,,0,0,0,,Saya cuba melindungi kamu juga
Dialog: 0,1:12:01.10,1:12:02.94,pratonton,,0,0,0,,Apa yang dia buat di sini?
Dialog: 0,1:12:03.02,1:12:05.52,pratonton,,0,0,0,,Kuasa ketuhanan yang luar biasa Jin Bu Young
Dialog: 0,1:12:05.61,1:12:07.69,pratonton,,0,0,0,,dia mendapatnya bukan sahaja daripada ibunya, ahli keluarga Jin
Dialog: 0,1:12:07.78,1:12:11.07,pratonton,,0,0,0,,Park Jin! Anda menyembunyikan kebenaran, mengetahui segala-galanya dengan sempurna
Dialog: 0,1:12:12.99,1:12:17.49,pratonton,,0,0,0,,Dan kini mereka yang mesti pergi akan pergi, dan mereka yang mesti kembali akan kembali
Dialog: 0,1:12:17.58,1:12:20.16,pratonton,,0,0,0,,Tuan, lakukan apa yang anda fikir perlu
Dialog: 0,1:12:20.25,1:12:23.42,pratonton,,0,0,0,,Saya akan cuba melakukan ini bukan kerana kebodohan, tetapi kerana semangat
Dialog: 0,1:12:23.50,1:12:25.00,pratonton,,0,0,0,,Guru saya mengajar saya ini
Dialog: 0,1:12:25.08,1:12:27.42,pratonton,,0,0,0,,- Nampak bagus\N- Wow
Dialog: 0,1:12:27.50,1:12:29.84,pratonton,,0,0,0,,Saya dengar ada pengantin perempuan di sini yang perkahwinannya akan datang tidak lama lagi
Dialog: 0,0:02:56.94,0:02:58.94,nicks,,0,0,0,,

