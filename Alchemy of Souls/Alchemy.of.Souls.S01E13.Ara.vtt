Dialogue: 0,0:02:47.14,0:02:52.14,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.14,0:02:57.14,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.14,0:03:02.14,النكات,,0,0,0,,مترجمو الطباعة: {\c&HFFF4C5&} Ria_Lee, tommo, Zero_Amamiya
Dialogue: 0,0:00:59.00,0:01:00.71,خط مائل,,0,0,0,,يمكنك علاج البدو
Dialogue: 0,0:01:00.80,0:01:03.84,النص العام,,0,0,0,,وأجعله إنساناً ولو متوحشاً؟
Dialogue: 0,0:01:05.18,0:01:08.18,النص العام,,0,0,0,,نحن لا نحاول أن نجعله إنساناً مرة أخرى
Dialogue: 0,0:01:08.68,0:01:12.73,general text,,0,0,0,,نحاول إبقائه واعياً حتى يتمكن من التحدث
Dialogue: 0,0:01:16.15,0:01:18.73,نص عام,,0,0,0,,إذن أنت لا تحاول إنقاذه
Dialogue: 0,0:01:18.82,0:01:21.99,general text,,0,0,0,,عندما يتحول البدو إلى آكل روح، فلا رجعة إلى الوراء
Dialogue: 0,0:01:22.95,0:01:24.24,نص عام,,0,0,0,,إنهم وحوش
Dialogue: 0,0:01:26.12,0:01:29.03,italics,,0,0,0,,إما أن يتغذوا على الطاقة البشرية،
Dialogue: 0,0:01:29.12,0:01:31.29,مائل,,0,0,0,,وإلا سيتحجرون. واحد من اثنين
Dialogue: 0,0:01:38.54,0:01:40.30,نص عام,,0,0,0,,نحن غير قادرين على منع هذا
Dialogue: 0,0:01:44.72,0:01:45.72,نص عام,,0,0,0,,حجر الجليد
Dialogue: 0,0:01:47.85,0:01:50.26,general text,,0,0,0,,سمعت أن لديه قوة هوانجسو
Dialogue: 0,0:01:50.35,0:01:52.35,نص عام,,0,0,0,,هل يمكن للحجر أن يوقف الدورة الدموية؟
Dialogue: 0,0:01:53.98,0:01:55.98,نص عام,,0,0,0,,ربما. لكن...
Dialogue: 0,0:01:57.19,0:02:01.03,general text,,0,0,0,,يجب ألا يستخدم الناس مثل هذه القوة تحت أي ظرف من الظروف.
Dialogue: 0,0:02:14.58,0:02:16.37,نص عام,,0,0,0,,يبدو أنها ستمطر
Dialogue: 0,0:02:18.50,0:02:21.30,نص عام,,0,0,0,,ولم أتمكن من استخدام قوة العواكس
Dialogue: 0,0:02:21.38,0:02:24.34,نص عام,,0,0,0,,يبدو أن المطر سيغسل كل شيء
Dialogue: 0,0:02:24.42,0:02:27.38,general text,,0,0,0,,عندما يهطل المطر هل تختفي قوة العاكس؟
Dialogue: 0,0:02:27.47,0:02:30.05,نص عام,,0,0,0,,قوة حجر الجليد جاءت من السماء
Dialogue: 0,0:02:30.14,0:02:32.72,نص عام,,0,0,0,,حتى تأخذ الجنة هذه القوة
Dialogue: 0,0:02:53.91,0:02:56.62,التعليق الصوتي,,0,0,0,,هل حاولت استدعاء قوة السماء،
Dialogue: 0,0:02:56.71,0:02:59.17,خارج الإطار,,0,0,0,,لإخفاء الحجر؟
Dialogue: 0,0:03:03.92,0:03:05.46,نص عام,,0,0,0,,جين بو يونغ
Dialogue: 0,0:03:06.80,0:03:09.97,general text,,0,0,0,,لو كانت على قيد الحياة لأصبحت كاهنة قوية،
Dialogue: 0,0:03:10.51,0:03:13.22,نص عام,,0,0,0,,الذي يمكنه التحكم في قوة السماء
Dialogue: 0,0:03:37.37,0:03:38.83,نص عام,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:03:39.46,0:03:42.38,نص عام,,0,0,0,,أنا بخير أيضًا. أنت لم تذهب البرية
Dialogue: 0,0:04:01.15,0:04:03.02,نص عام,,0,0,0,,لقد انفتحت البوابة فوق وعاء الأبراج
Dialogue: 0,0:04:03.69,0:04:05.98,general text,,0,0,0,,- والسقف لم يكن هكذا دائماً؟\N- لا
Dialogue: 0,0:04:06.53,0:04:08.03,نص عام,,0,0,0,,الجميع يعتقد ذلك،
Dialogue: 0,0:04:08.99,0:04:10.78,نص عام,,0,0,0,,لكن قيل لي أن الأمر ليس كذلك
Dialogue: 0,0:04:10.86,0:04:13.12,نص عام,,0,0,0,,من؟ والدك؟
Dialogue: 0,0:04:14.62,0:04:17.75,نص عام,,0,0,0,,قال لفتح البوابة فوق الوعاء
Dialogue: 0,0:04:17.83,0:04:20.29,نص عام,,0,0,0,,لا يستطيع ذلك إلا الساحر المنجم
Dialogue: 0,0:04:20.91,0:04:22.67,نص عام,,0,0,0,,كيف حدث هذا؟
Dialogue: 0,0:04:22.75,0:04:26.00,النص العام,,0,0,0,,يبدو أننا فعلنا شيئًا لم يكن ينبغي علينا فعله
Dialogue: 0,0:04:26.09,0:04:27.42,مائل,,0,0,0,,ولكن كيف؟
Dialogue: 0,0:04:29.42,0:04:30.51,خط مائل,,0,0,0,,هذا أنا
Dialogue: 0,0:04:32.59,0:04:33.97,نص عام,,0,0,0,,فتحت البوابة
Dialogue: 0,0:04:35.05,0:04:36.85,نص عام,,0,0,0,,طاقتي تسربت إلى الماء
Dialogue: 0,0:04:37.68,0:04:39.43,نص عام,,0,0,0,,كما في بحيرة جيونج تشونج دايهو
Dialogue: 0,0:04:40.27,0:04:41.89,نص عام,,0,0,0,,وفي مرآة توسكا
Dialogue: 0,0:04:43.77,0:04:46.02,النص العام,,0,0,0,,لقد عادت طاقتي بفضل هذه المياه
Dialogue: 0,0:05:05.13,0:05:06.46,نص عام,,0,0,0,,ماذا تقصد بضرب البرق؟
Dialogue: 0,0:05:06.54,0:05:08.59,نص عام,,0,0,0,,جاء صوت عالٍ من غرفة التسجيل
Dialogue: 0,0:05:09.38,0:05:12.42,النص العام,,0,0,0,,الخصي كيم وتشان ووك موجودان الآن
Dialogue: 0,0:05:20.47,0:05:22.35,نص عام,,0,0,0,,هذه هي قوة العاكس
Dialogue: 0,0:05:23.02,0:05:25.94,general text,,0,0,0,,نفس الطاقة المظلمة التي ظهرت عندما حاول كيل جو تبادل الجثث
Dialogue: 0,0:05:28.36,0:05:29.61,نص عام,,0,0,0,,ما هذا؟
Dialogue: 0,0:05:30.19,0:05:33.28,نص عام,,0,0,0,,لا أرى شيئاً كما في حالة المرآة
Dialogue: 0,0:05:33.78,0:05:35.36,نص عام,,0,0,0,,دوار وغثيان
Dialogue: 0,0:05:35.45,0:05:37.53,النص العام,,0,0,0,,سيأتي جين مو قريبًا، يجب أن نغادر
Dialogue: 0,0:05:49.96,0:05:51.34,نص عام,,0,0,0,,بالضبط. باب
Dialogue: 0,0:05:53.84,0:05:56.39,general text,,0,0,0,,أغلق الباب بالطاقة، وعاء الأبراج مكسور،
Dialogue: 0,0:05:56.47,0:05:57.89,النص العام,,0,0,0,,وآكل الروح مات
Dialogue: 0,0:05:59.39,0:06:00.39,نص عام,,0,0,0,,لدينا مشاكل
Dialogue: 0,0:06:01.18,0:06:03.64,نص عام,,0,0,0,,يوجد مخرج للخدم بجوار وعاء الأبراج
Dialogue: 0,0:06:04.69,0:06:06.85,نص عام,,0,0,0,,قادني أبي عبر هذا الباب
Dialogue: 0,0:06:07.44,0:06:09.44,نص عام,,0,0,0,,لكننا سنظل في جيونبوغوان
Dialogue: 0,0:06:13.74,0:06:16.61,نص عام,,0,0,0,,أنت لا ترى ولا أعرف الطريق
Dialogue: 0,0:06:17.99,0:06:21.37,نص عام,,0,0,0,,إذا ضلنا الطريق سنُقبض علينا
Dialogue: 0,0:06:21.45,0:06:23.70,general text,,0,0,0,,سنبقى هنا - سيأتي جين مو ويقتلنا
Dialogue: 0,0:06:23.79,0:06:25.54,النص العام,,0,0,0,,لن أنتصر عليه
Dialogue: 0,0:06:29.21,0:06:31.96,نص عام,,0,0,0,,علينا أن ننادي منقذي
Dialogue: 0,0:06:33.26,0:06:35.09,النص العام,,0,0,0,,- المنقذ؟\N- هناك واحد
Dialogue: 0,0:06:37.05,0:06:40.64,general text,,0,0,0,,سوف يرتجف قلبه، وسيأتي على الفور
Dialogue: 0,0:06:41.31,0:06:42.76,نص عام,,0,0,0,,منقذي
Dialogue: 0,0:07:06.91,0:07:09.25,النص العام,,0,0,0,,تشان ووك، هل تمزح معي؟
Dialogue: 0,0:07:14.84,0:07:16.55,نص عام,,0,0,0,,هل سمعت صوتًا عاليًا؟
Dialogue: 0,0:07:16.63,0:07:19.68,general text,,0,0,0,,نعم لكنك قلت عدم الدخول فانتظرنا
Dialogue: 0,0:07:19.76,0:07:22.47,نص عام,,0,0,0,,يوم سو، اتبعني. والآخرون يحرسون الباب
Dialogue: 0,0:07:38.20,0:07:40.36,general text,,0,0,0,,شان ووك كسر الحاجز وهرب
Dialogue: 0,0:07:40.45,0:07:41.28,خط مائل,,0,0,0,,نائب
Dialogue: 0,0:07:42.07,0:07:43.37,نص عام,,0,0,0,,وعاء الأبراج...
Dialogue: 0,0:07:44.53,0:07:46.41,نص عام,,0,0,0,,ماذا حدث لها؟
Dialogue: 0,0:07:47.45,0:07:49.00,نص عام,,0,0,0,,علينا العثور عليه
Dialogue: 0,0:07:49.08,0:07:50.96,النص العام,,0,0,0,,لا يمكننا أن نسمح له بالخروج من هنا حياً
Dialogue: 0,0:07:51.58,0:07:53.34,نص عام,,0,0,0,,نقل الجثة إلى الغرفة السرية
Dialogue: 0,0:07:53.42,0:07:56.05,النص العام,,0,0,0,,- لا ينبغي لأحد أن يراك\N{\i1}- نعم
Dialogue: 0,0:08:02.64,0:08:04.81,نص عام,,0,0,0,,أغلق جميع المخارج
Dialogue: 0,0:08:04.89,0:08:06.68,نص عام,,0,0,0,,ابحث عن تشان ووك وخادمته
Dialogue: 0,0:08:07.31,0:08:09.77,general text,,0,0,0,,إذا حدث شيء ما، يمكنك قتلهم
Dialogue: 0,0:08:09.85,0:08:10.81,خط مائل,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:08:25.49,0:08:29.16,general text,,0,0,0,,لن يخرج تشان ووك من هذه المتاهة أبدًا
Dialogue: 0,0:08:30.46,0:08:31.96,النص العام,,0,0,0,,سوف يضيع وسيتم القبض عليه
Dialogue: 0,0:08:34.29,0:08:35.29,نص عام,,0,0,0,,أو ربما...
Dialogue: 0,0:08:36.25,0:08:40.17,general text,,0,0,0,,علم أنه سيضيع، لذا اختبأ في الداخل.
Dialogue: 0,0:08:43.51,0:08:45.26,نص عام,,0,0,0,,لقد كدت أن تفهم الأمر
Dialogue: 0,0:08:46.47,0:08:47.76,نص عام,,0,0,0,,هل أنت هنا؟
Dialogue: 0,0:08:48.85,0:08:51.52,النص العام,,0,0,0,,لقد كسرت الحاجز الذي صنعته
Dialogue: 0,0:08:51.60,0:08:53.65,نص عام,,0,0,0,,دعونا نفعل شيئًا آخر. ناري
Dialogue: 0,0:08:55.44,0:08:58.07,نص عام,,0,0,0,,إذا أشعلت النار في هذا المكان،
Dialogue: 0,0:08:58.15,0:09:00.90,نص عام,,0,0,0,,من المحتمل أن يكون الجو حارًا جدًا،
Dialogue: 0,0:09:01.61,0:09:03.28,نص عام,,0,0,0,,لإظهارك
Dialogue: 0,0:09:03.36,0:09:07.41,مائل,,0,0,0,,حاول إقناعي كما في السابق، دون تهديدات
Dialogue: 0,0:09:09.58,0:09:11.62,general text,,0,0,0,,لماذا إذا لم يكن لدي ما أخسره؟
Dialogue: 0,0:09:12.21,0:09:15.96,general text,,0,0,0,,أنت مجرم دخلت هنا دون إذن وكسرت الكأس أيضًا
Dialogue: 0,0:09:16.04,0:09:18.09,نص عام,,0,0,0,,ومهمتي هي القبض على المجرم
Dialogue: 0,0:09:18.17,0:09:20.13,نص عام,,0,0,0,,أنا نائب غوانغجو
Dialogue: 0,0:09:23.47,0:09:26.26,general text,,0,0,0,,أنت قاسٍ جدًا مع الضيف الذي جاء بهدية
Dialogue: 0,0:09:26.34,0:09:29.81,general text,,0,0,0,,هل أنت منزعج لأننا حولنا صديقك إلى حجر؟
Dialogue: 0,0:09:29.89,0:09:30.97,نص عام,,0,0,0,,أي صديق؟
Dialogue: 0,0:09:31.77,0:09:36.19,النص العام,,0,0,0,,لم يكن هناك أحد هنا غيري وأنا
Dialogue: 0,0:09:36.86,0:09:39.07,general text,,0,0,0,,آه آه... هل تريد إخفاء جسد حجري؟
Dialogue: 0,0:09:40.07,0:09:41.36,خط مائل,,0,0,0,,ولكن ماذا تفعل؟
Dialogue: 0,0:09:42.69,0:09:45.36,general text,,0,0,0,,- سيتم القبض عليك\N- {\u0\i1}هذا لن يحدث
Dialogue: 0,0:09:45.86,0:09:48.74,النص العام,,0,0,0,,لأنك أنت وخادمتك ستموتان
Dialogue: 0,0:09:49.79,0:09:50.91,خط مائل,,0,0,0,,اخرج
Dialogue: 0,0:09:51.50,0:09:52.62,نص عام,,0,0,0,,اخرج!
Dialogue: 0,0:10:20.02,0:10:21.73,نص عام,,0,0,0,,هل رأيت؟
Dialogue: 0,0:10:21.82,0:10:24.11,النص العام,,0,0,0,,ضرب البرق بالقرب من جيونبوغوان
Dialogue: 0,0:10:24.19,0:10:26.78,نص عام,,0,0,0,,جيونبوغوان بجوار القصر
Dialogue: 0,0:10:26.86,0:10:29.53,نص عام,,0,0,0,,نحن بحاجة للتحقق مما إذا كان كل شيء على ما يرام
Dialogue: 0,0:10:29.62,0:10:31.45,نص عام,,0,0,0,,ضرب البرق بشدة
Dialogue: 0,0:10:31.54,0:10:33.95,نص عام,,0,0,0,,آمل أن يكون ذلك مباشرة من جين مو
Dialogue: 0,0:10:49.30,0:10:50.47,نص عام,,0,0,0,,يا له من عار
Dialogue: 0,0:10:51.47,0:10:54.10,نص عام,,0,0,0,,ربما جئت إلى هنا سعيدًا،
Dialogue: 0,0:10:54.18,0:10:56.39,النص العام,,0,0,0,,تخيل أنك ستصبح غوانغجو
Dialogue: 0,0:10:56.48,0:10:58.06,النص العام,,0,0,0,,لكن بدلاً من ذلك ستموت
Dialogue: 0,0:10:58.15,0:10:59.90,خط مائل,,0,0,0,,لم يحالفك الحظ
Dialogue: 0,0:11:01.48,0:11:02.40,نص عام,,0,0,0,,هذا لن ينجح
Dialogue: 0,0:11:03.15,0:11:04.28,نص عام,,0,0,0,,إذا مت,
Dialogue: 0,0:11:04.36,0:11:06.61,النص العام,,0,0,0,,يمكنك بسهولة أن تصبح غوانغجو
Dialogue: 0,0:11:06.70,0:11:08.28,نص عام,,0,0,0,,وهذا لا يجوز
Dialogue: 0,0:11:08.36,0:11:09.36,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:11:11.95,0:11:13.62,نص عام,,0,0,0,,هل سمعت عن يشم يين يانغ؟
Dialogue: 0,0:11:15.12,0:11:17.62,نص عام,,0,0,0,,هذا زوج من اليشم الأحمر والأزرق
Dialogue: 0,0:11:17.71,0:11:20.29,general text,,0,0,0,,إذا سكبت الطاقة في حجر واحد، سيشعر بها الحجر الثاني
Dialogue: 0,0:11:20.38,0:11:21.71,نص عام,,0,0,0,,إذا كانوا قريبين،
Dialogue: 0,0:11:22.50,0:11:24.55,نص عام,,0,0,0,,سيجدون بعضهم البعض
Dialogue: 0,0:11:25.80,0:11:26.76,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:11:26.84,0:11:28.30,نص عام,,0,0,0,,أحد الحجرين أزرق,
Dialogue: 0,0:11:29.18,0:11:31.14,نص عام,,0,0,0,,الآن مع ولي العهد
Dialogue: 0,0:11:33.22,0:11:34.35,ذكريات مائلة,,0,0,0,,عزيزي اليشم
Dialogue: 0,0:11:34.43,0:11:36.98,ذكريات,,0,0,0,,لقد استلمتها مقابل الضفادع
Dialogue: 0,0:11:37.06,0:11:38.23,ذكريات,,0,0,0,,هل له قيمة؟
Dialogue: 0,0:11:40.23,0:11:42.02,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:11:42.11,0:11:44.32,نص عام,,0,0,0,,كان عندي اللون الأحمر
Dialogue: 0,0:11:44.40,0:11:46.94,general text,,0,0,0,,سكبت فيه الطاقة وهو ما يعني صاحب السمو.
Dialogue: 0,0:11:47.82,0:11:49.40,نص عام,,0,0,0,,في الطريق إلى هنا الآن
Dialogue: 0,0:11:59.33,0:12:01.04,general text,,0,0,0,,هل ستقتلني وتأخذ الحجر؟
Dialogue: 0,0:12:02.46,0:12:05.17,نص عام,,0,0,0,,ظننت ذلك فأخفيت الحجر
Dialogue: 0,0:12:07.67,0:12:10.13,نص عام,,0,0,0,,ملأته طاقة وأخفته
Dialogue: 0,0:12:10.22,0:12:12.18,نص عام,,0,0,0,,في ثوب الخصي ابتلاع الروح
Dialogue: 0,0:12:21.90,0:12:25.65,مائل,,0,0,0,,ربما يكون سموه الآن في عجلة من أمره إلى الجثة الحجرية
Dialogue: 0,0:12:28.99,0:12:31.32,النص العام,,0,0,0,,تخيل رد فعله عندما يرى هذا
Dialogue: 0,0:12:32.20,0:12:34.82,نص عام,,0,0,0,,سيكون أكثر من متفاجئ
Dialogue: 0,0:12:47.30,0:12:48.30,نص عام,,0,0,0,,جونبوغوان
Dialogue: 0,0:12:50.84,0:12:52.88,النص العام,,0,0,0,,تشان ووك في مكان ما في جيونبوغوان
Dialogue: 0,0:13:00.39,0:13:02.02,النص العام,,0,0,0,,لا تضيع وقتك في قتلي،
Dialogue: 0,0:13:02.85,0:13:04.90,نص عام,,0,0,0,,من الأفضل أن يتوقف ولي العهد
Dialogue: 0,0:13:09.57,0:13:11.11,نص عام,,0,0,0,,سأعود قريباً
Dialogue: 0,0:13:12.20,0:13:14.70,النص العام,,0,0,0,,ما زلت غير قادر على الهروب من هنا
Dialogue: 0,0:13:26.46,0:13:28.46,النص العام,,0,0,0,,- أين الجثة؟\N- في الغرفة السرية
Dialogue: 0,0:13:28.55,0:13:31.09,نص عام,,0,0,0,,إذا طلبت ذلك سأخرجه من هناك
Dialogue: 0,0:13:40.85,0:13:42.06,نص عام,,0,0,0,,أين...
Dialogue: 0,0:13:45.10,0:13:48.61,نص عام,,0,0,0,,إنه ليس هنا. هذا اللقيط خدعني
Dialogue: 0,0:13:51.57,0:13:53.03,نص عام,,0,0,0,,نائب
Dialogue: 0,0:13:53.11,0:13:55.91,general text,,0,0,0,,لقد أمرت بعدم السماح لأي شخص بالدخول، ولكن لم يكن هناك خيار آخر
Dialogue: 0,0:13:56.49,0:13:59.16,نص عام,,0,0,0,,ماذا؟ هل ولي العهد هنا؟
Dialogue: 0,0:13:59.24,0:14:00.20,نص عام,,0,0,0,,نعم
Dialogue: 0,0:14:02.33,0:14:04.50,نص عام,,0,0,0,,لذا فهو لم يكذب بشأن اليشم
Dialogue: 0,0:14:21.18,0:14:22.22,نص عام,,0,0,0,,نائب
Dialogue: 0,0:14:22.31,0:14:25.39,النص العام,,0,0,0,,الخصي الملكي تحول إلى ابتلاع الروح؟
Dialogue: 0,0:14:28.56,0:14:31.19,general text,,0,0,0,,وحاولت قتل تشان ووك سراً؟
Dialogue: 0,0:14:31.27,0:14:33.19,النص العام,,0,0,0,,هذا سوء فهم يا صاحب السمو
Dialogue: 0,0:15:10.31,0:15:11.52,نص عام,,0,0,0,,لقد حاولت
Dialogue: 0,0:15:11.61,0:15:14.23,نص عام,,0,0,0,,أطعم خادمتي لهذه الروح المبتلعة
Dialogue: 0,0:15:14.32,0:15:18.24,نص عام,,0,0,0,,من الأفضل تقديم تفسير عادي لما يحدث
Dialogue: 0,0:15:30.50,0:15:33.50,النص العام,,0,0,0,,أنت تسأل عن تشو تشون الذي عمل
Dialogue: 0,0:15:33.59,0:15:35.80,نص عام,,0,0,0,,نجم في جيونبوغوان؟
Dialogue: 0,0:15:36.30,0:15:40.05,النص العام,,0,0,0,,سمعت أن تشانغ غان وتشو تشون كانا مقربين
Dialogue: 0,0:15:40.14,0:15:41.18,نص عام,,0,0,0,,نعم
Dialogue: 0,0:15:41.93,0:15:43.60,نص عام,,0,0,0,,لقد كانا صديقين حميمين
Dialogue: 0,0:15:44.26,0:15:45.93,نص عام,,0,0,0,,تشو تشون كثيرًا ما كان يزورنا
Dialogue: 0,0:15:46.52,0:15:50.06,النص العام,,0,0,0,,كان شخصًا مرحًا ولطيفًا
Dialogue: 0,0:15:51.19,0:15:52.86,النص العام,,0,0,0,,استخدم "تشو تشون" السحر الأسود،
Dialogue: 0,0:15:52.94,0:15:55.57,النص العام,,0,0,0,,الذي دمر عائلته بأكملها
Dialogue: 0,0:15:55.65,0:15:57.24,نص عام,,0,0,0,,لقد كان رجلاً صالحاً
Dialogue: 0,0:15:57.94,0:16:01.41,نص عام,,0,0,0,,مازلت لا أصدق أن هذا قد حدث
Dialogue: 0,0:16:02.82,0:16:06.66,نص عام,,0,0,0,,كان لديه ابنة. هل عرفتها؟
Dialogue: 0,0:16:07.54,0:16:09.00,نص عام,,0,0,0,,نعم أتذكرها
Dialogue: 0,0:16:09.50,0:16:13.25,general text,,0,0,0,,كانت دائمًا مع والدها، وكانا قريبين
Dialogue: 0,0:16:13.33,0:16:15.38,نص عام,,0,0,0,,سمعت أنها مفقودة
Dialogue: 0,0:16:16.25,0:16:17.17,نص عام,,0,0,0,,أعتقد,
Dialogue: 0,0:16:18.09,0:16:19.47,نص عام,,0,0,0,,لقد ماتت
Dialogue: 0,0:16:20.47,0:16:22.76,النص العام,,0,0,0,,لماذا قررت هذا؟
Dialogue: 0,0:16:22.84,0:16:26.76,general text,,0,0,0,,السيد تشانغ غان كان يبحث عن هذه الفتاة لفترة طويلة جدًا
Dialogue: 0,0:16:27.77,0:16:30.98,general text,,0,0,0,,لو كانت على قيد الحياة لوجدها بالفعل
Dialogue: 0,0:16:31.06,0:16:33.02,نص عام,,0,0,0,,إلا إذا كان مخفياً
Dialogue: 0,0:16:34.27,0:16:35.69,نص عام,,0,0,0,,ماتت الآنسة دو هوا
Dialogue: 0,0:16:36.61,0:16:38.69,النص العام,,0,0,0,,هذا ما حدث لصديقه المفضل
Dialogue: 0,0:16:38.78,0:16:41.99,general text,,0,0,0,,لم يكن السيد تشان هو نفسه حينها
Dialogue: 0,0:16:42.53,0:16:45.91,general text,,0,0,0,,ألقى باللوم على نفسه في كلتا الحالتين.
Dialogue: 0,0:16:46.58,0:16:48.16,نص عام,,0,0,0,,وعانيت كثيراً
Dialogue: 0,0:16:49.37,0:16:51.83,general text,,0,0,0,,غادر المنزل بحثاً عن ابنة صديقه
Dialogue: 0,0:16:51.92,0:16:54.13,نص عام,,0,0,0,,ظننت أنه سيعود عندما يجدها
Dialogue: 0,0:16:54.67,0:16:55.67,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:16:56.42,0:17:00.26,general text,,0,0,0,,العجيب أنه ترك المنزل 20 سنة ليجد فتاة
Dialogue: 0,0:17:01.05,0:17:03.72,نص عام,,0,0,0,,بدأت أشك في أنه غادر
Dialogue: 0,0:17:03.80,0:17:05.26,نص عام,,0,0,0,,لسبب آخر
Dialogue: 0,0:17:05.76,0:17:09.47,general text,,0,0,0,,لو كان قد وجد تلك الفتاة قبل 20 عامًا،
Dialogue: 0,0:17:10.27,0:17:12.89,النص العام,,0,0,0,,لن تكون حياتها بهذه الصعوبة
Dialogue: 0,0:17:12.98,0:17:16.94,النص العام,,0,0,0,,وتشانغ غان لن يشعر بالذنب
Dialogue: 0,0:17:17.02,0:17:18.57,نص عام,,0,0,0,"اللوم"؟
Dialogue: 0,0:17:18.65,0:17:22.61,general text,,0,0,0,,هل تلمح إلى أن السيد تشان تصرف بشكل غير صحيح تجاه صديقه؟
Dialogue: 0,0:17:23.24,0:17:25.32,مائل,,0,0,0,,لقد عاقبه على السحر الأسود
Dialogue: 0,0:17:25.41,0:17:27.37,النص العام,,0,0,0,,كساحر، كان عليه أن يفعل ذلك
Dialogue: 0,0:17:27.45,0:17:31.54,general text,,0,0,0,,لا يهم مدى قربهما، كان من المستحيل خلاف ذلك
Dialogue: 0,0:17:31.62,0:17:35.88,general text,,0,0,0,,لا يمكنك الحكم على ما هو صحيح وما لا يعتمد على ما رأيته
Dialogue: 0,0:17:36.46,0:17:38.96,نص عام,,0,0,0,,هناك قصة وراء كل شيء
Dialogue: 0,0:17:39.05,0:17:42.26,نص عام,,0,0,0,,القدر منسوج من القصص والعلاقات
Dialogue: 0,0:17:42.34,0:17:44.22,نص عام,,0,0,0,,أي العلاقات المؤلمة
Dialogue: 0,0:17:44.30,0:17:49.22,general text,,0,0,0,,عائلة تشو وتشان لم تنتهي بعد؟
Dialogue: 0,0:17:50.89,0:17:51.89,نص عام,,0,0,0,,أو أنت...
Dialogue: 0,0:17:52.93,0:17:56.90,general text,,0,0,0,,هل تقول أن تلك الفتاة موجودة في هذا المنزل الآن؟
Dialogue: 0,0:17:57.90,0:18:00.19,general text,,0,0,0,,هل وجدتها سوسنوفي بور؟
Dialogue: 0,0:18:02.74,0:18:04.07,نص عام,,0,0,0,,تلك الفتاة
Dialogue: 0,0:18:06.36,0:18:07.53,النص العام,,0,0,0,,مات
Dialogue: 0,0:18:13.00,0:18:14.08,نص عام,,0,0,0,,فهمت
Dialogue: 0,0:18:14.91,0:18:16.08,نص عام,,0,0,0,,إنه أمر مؤسف
Dialogue: 0,0:18:17.29,0:18:19.25,نص عام,,0,0,0,,علينا أن نوقظها
Dialogue: 0,0:18:22.59,0:18:23.76,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,0:18:24.88,0:18:26.43,نص عام,,0,0,0,,أنت لطيف جدًا
Dialogue: 0,0:18:26.51,0:18:28.47,خط مائل,,0,0,0,,هذه ليست بادرة طيبة
Dialogue: 0,0:18:28.55,0:18:31.72,general text,,0,0,0,,أنا فقط لا أريد أن ينتهي الأمر بروحها في هذا العالم.
Dialogue: 0,0:18:32.27,0:18:33.73,نص عام,,0,0,0,,وعذب السيد الشاب
Dialogue: 0,0:18:34.31,0:18:38.61,general text,,0,0,0,,ماذا لو كانت روحها تطارد تشان ووك؟
Dialogue: 0,0:18:38.69,0:18:41.65,نص عام,,0,0,0,,علينا أن نتخلص منه. لا بد أن هذه روح شريرة
Dialogue: 0,0:18:41.73,0:18:43.57,general text,,0,0,0,,لن أسمح لها بملاحقته
Dialogue: 0,0:18:45.19,0:18:46.95,نص عام,,0,0,0,,روح شريرة؟
Dialogue: 0,0:18:50.99,0:18:52.54,النص العام,,0,0,0,,أين مو دوك؟
Dialogue: 0,0:18:52.62,0:18:53.83,نص عام,,0,0,0,,مو دوك؟
Dialogue: 0,0:18:54.41,0:18:57.50,general text,,0,0,0,,أرسلتها إلى جيونبوغوان في مهمة.
Dialogue: 0,0:19:04.63,0:19:06.05,نص عام,,0,0,0,,هل أنت بخير؟ هل تستطيع أن ترى؟
Dialogue: 0,0:19:06.80,0:19:08.64,نص عام,,0,0,0,,نعم فهمت
Dialogue: 0,0:19:09.22,0:19:10.30,نص عام,,0,0,0,,وأنت يا سيدي؟
Dialogue: 0,0:19:10.39,0:19:12.64,general text,,0,0,0,,هل أنت مصاب في أي مكان؟
Dialogue: 0,0:19:12.72,0:19:13.85,خط مائل,,0,0,0,,أنا بخير
Dialogue: 0,0:19:13.93,0:19:16.31,ذكريات,,0,0,0,,ماذا يعني إذا احتفظ شخصان بشيء مطابق؟
Dialogue: 0,0:19:16.39,0:19:18.60,ذكريات,,0,0,0,,أنهما متزوجان أو يتواعدان
Dialogue: 0,0:19:22.02,0:19:25.19,general text,,0,0,0,,وصل رئيس سوسنوفي بور بناءً على طلبك
Dialogue: 0,0:19:45.84,0:19:47.51,النص العام,,0,0,0,,لقد وصلت إلى جيونبوغوان
Dialogue: 0,0:19:48.26,0:19:50.93,نص عام,,0,0,0,,مرر كعك العسل للنائب؟؟
Dialogue: 0,0:19:51.01,0:19:54.85,نص عام,,0,0,0,,نعم. سمعت أنك كنت تتقاتل عليهم
Dialogue: 0,0:19:55.52,0:19:57.77,النص العام,,0,0,0,,الخادم كيم لم يرد أن ينزعج،
Dialogue: 0,0:19:57.85,0:19:59.85,نص عام,,0,0,0,,فجئت لأسلم طردها
Dialogue: 0,0:19:59.94,0:20:01.35,نص عام,,0,0,0,,عذر مثير للشفقة
Dialogue: 0,0:20:02.40,0:20:03.56,نص عام,,0,0,0,,رئيس سوسنوفي بور
Dialogue: 0,0:20:03.65,0:20:06.65,general text,,0,0,0,,وكان نائب غوانغجو يتشاجرون على الكعك؟
Dialogue: 0,0:20:08.24,0:20:10.70,general text,,0,0,0,,وحتى لو كان هذا صحيحاً، كان يستحق الصمت عنه
Dialogue: 0,0:20:10.78,0:20:12.99,نص عام,,0,0,0,,ماذا كنت تفعل في غرفة التسجيل؟
Dialogue: 0,0:20:13.07,0:20:15.41,نص عام,,0,0,0,,أردت رؤية وعاء الأبراج
Dialogue: 0,0:20:15.49,0:20:18.29,general text,,0,0,0,,ولكن في النهاية رأيت شيئًا لم يكن يجب أن أحصل عليه
Dialogue: 0,0:20:19.58,0:20:23.13,general text,,0,0,0,,هل أنت متأكد أنك رأيت الروح وهي تبتلع؟
Dialogue: 0,0:20:23.21,0:20:26.67,نص عام,,0,0,0,,نعم. لقد وضع حاجزًا حولي لإخفائه
Dialogue: 0,0:20:26.75,0:20:29.30,general text,,0,0,0,,وألقى مو دوك إليه حتى يكتفي
Dialogue: 0,0:20:29.38,0:20:30.84,نص عام,,0,0,0,,إنه يكذب
Dialogue: 0,0:20:32.47,0:20:35.51,نص عام,,0,0,0,,دخل تشان ووك غرفة التسجيل دون إذن
Dialogue: 0,0:20:35.60,0:20:37.52,نص عام,,0,0,0,,وكسرت وعاء الأبراج
Dialogue: 0,0:20:37.60,0:20:39.93,نص عام,,0,0,0,,وعندما تم القبض عليه،
Dialogue: 0,0:20:40.02,0:20:42.94,general text,,0,0,0,,بدأت في التوصل إلى كل أنواع الأشياء حول ابتلاع الروح
Dialogue: 0,0:20:44.81,0:20:46.52,نص عام,,0,0,0,,أنا متأكد من أنه كان ابتلاع الروح
Dialogue: 0,0:20:46.61,0:20:48.57,نص عام,,0,0,0,,تحول إلى حجر
Dialogue: 0,0:20:48.65,0:20:50.78,نص عام,,0,0,0,,شاهدته خادمتي أيضًا
Dialogue: 0,0:20:50.86,0:20:52.95,نص عام,,0,0,0,,عندما وصلت لم أر الجثة
Dialogue: 0,0:20:53.03,0:20:54.62,نص عام,,0,0,0,,ربما أخفاها
Dialogue: 0,0:20:54.70,0:20:56.45,نص عام,,0,0,0,,أغلق جميع المخارج
Dialogue: 0,0:20:56.53,0:20:59.37,النص العام,,0,0,0,,والعثور على مبتلع الروح قبل أن يخرجه
Dialogue: 0,0:21:02.37,0:21:06.59,general text,,0,0,0,,أعتقد أن الحقيقة ستنكشف عندما نجد الجثة
Dialogue: 0,0:21:09.51,0:21:12.43,النص العام,,0,0,0,,سأتصل بالسحرة لتفقد جيونبوغوان
Dialogue: 0,0:21:12.51,0:21:15.93,نص عام,,0,0,0,,لا يمكنك فعل ذلك. لا أستطيع السماح لهم بفعل هذا
Dialogue: 0,0:21:16.01,0:21:18.35,نص عام,,0,0,0,,بسبب كذبة لا أساس لها من الصحة
Dialogue: 0,0:21:23.98,0:21:25.31,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:21:26.48,0:21:28.52,general text,,0,0,0,,هل كان الخصي الملكي هو من يبتلع الروح؟
Dialogue: 0,0:21:28.61,0:21:29.48,نص عام,,0,0,0,,نعم
Dialogue: 0,0:21:29.57,0:21:33.20,النص العام,,0,0,0,,رأيته مع الملكة عندما تشاجرنا
Dialogue: 0,0:21:33.28,0:21:35.82,general text,,0,0,0,,الخصي أوه، من كان هناك ذلك اليوم؟
Dialogue: 0,0:21:35.91,0:21:38.49,نص عام,,0,0,0,,الخصي كيم. يخدم الملكة
Dialogue: 0,0:21:39.79,0:21:42.83,general text,,0,0,0,,لذا، علينا التحقق مما إذا كان موجودًا في القصر الآن أم لا
Dialogue: 0,0:21:43.41,0:21:45.04,خط مائل,,0,0,0,,تحقق
Dialogue: 0,0:21:45.12,0:21:47.17,نص عام,,0,0,0,,هذا ليس ضرورياً
Dialogue: 0,0:22:10.36,0:22:11.61,خط مائل,,0,0,0,,لقد وصلت الملكة!
Dialogue: 0,0:22:11.69,0:22:13.28,خط مائل,,0,0,0,,أحييها
Dialogue: 0,0:22:20.91,0:22:21.99,نص عام,,0,0,0,,الأم
Dialogue: 0,0:22:23.33,0:22:25.62,نص عام,,0,0,0,,أخبرني النائب بما حدث
Dialogue: 0,0:22:25.71,0:22:27.63,نص عام,,0,0,0,,تفاجأت فحضرت شخصياً
Dialogue: 0,0:22:31.25,0:22:34.22,general text,,0,0,0,,هل وجدوا حقاً ابتلاع الروح هنا؟
Dialogue: 0,0:22:34.88,0:22:37.26,مائل,,0,0,0,,الخصي الذي خدمك كان بدوياً
Dialogue: 0,0:22:37.34,0:22:39.93,general text,,0,0,0,,لقد أصبح متوحشًا ومتحجرًا هنا
Dialogue: 0,0:22:41.72,0:22:44.02,general text,,0,0,0,,- أهذا صحيح؟\N- هذا غير صحيح
Dialogue: 0,0:22:44.60,0:22:46.98,نص عام,,0,0,0,,لم يتحول أحد هنا إلى حجر
Dialogue: 0,0:22:47.06,0:22:48.27,نص عام,,0,0,0,,هذا كذب،
Dialogue: 0,0:22:49.56,0:22:51.23,نص عام,,0,0,0,,الذي اخترعه تشان ووك
Dialogue: 0,0:22:51.32,0:22:55.95,general text,,0,0,0,,سنعرف إذا كان هذا صحيحًا أم خطأ عندما نعرف مكان الخصي
Dialogue: 0,0:22:58.78,0:23:02.62,general text,,0,0,0,,من هو هذا الخصي الذي زعم أنه تحول إلى حجر؟
Dialogue: 0,0:23:03.70,0:23:05.00,نص عام,,0,0,0,,الخصي كيم
Dialogue: 0,0:23:12.59,0:23:15.97,نص عام,,0,0,0,,وصل كيم الخصي إلى هنا معي
Dialogue: 0,0:23:26.73,0:23:28.52,نص عام,,0,0,0,,الخصي كيم، أدخل
Dialogue: 0,0:24:01.68,0:24:03.22,نص عام,,0,0,0,,هذا الخصي
Dialogue: 0,0:24:04.30,0:24:06.22,نص عام,,0,0,0,,لقد رأيت
Dialogue: 0,0:24:06.81,0:24:08.47,نص عام,,0,0,0,,متحجرة؟
Dialogue: 0,0:24:10.23,0:24:11.27,نص عام,,0,0,0,,نعم
Dialogue: 0,0:24:11.35,0:24:13.98,خط مائل,,0,0,0,,قلت أنه أصبح جامحًا
Dialogue: 0,0:24:14.06,0:24:16.40,النص العام,,0,0,0,,لكنه يقف هنا حياً وبصحة جيدة
Dialogue: 0,0:24:17.82,0:24:19.07,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:24:23.07,0:24:24.62,نص عام,,0,0,0,,إنه بخير
Dialogue: 0,0:24:33.29,0:24:35.46,مائل,,0,0,0,,الطريقة الوحيدة لحل هذه المشكلة هي،
Dialogue: 0,0:24:38.46,0:24:41.01,نص عام,,0,0,0,,أعيده إلى الحياة
Dialogue: 0,0:24:57.15,0:24:58.77,خارج الإطار,,0,0,0,,إنه بخير، بخير تمامًا
Dialogue: 0,0:24:59.90,0:25:01.94,التعليق الصوتي,,0,0,0,,إذا كانت هذه هي قوة الحجر الجليدي،
Dialogue: 0,0:25:02.03,0:25:04.49,التعليق الصوتي,,0,0,0,,مما يعني أنني أستطيع إنقاذ مو دوك، حتى لو أصبحت جامحة
Dialogue: 0,0:25:05.41,0:25:06.41,نص عام,,0,0,0,,مو دوك,
Dialogue: 0,0:25:07.70,0:25:09.58,نص عام,,0,0,0,,لابد أننا ارتكبنا خطأً
Dialogue: 0,0:25:11.41,0:25:12.79,نص عام,,0,0,0,,ربما المالك
Dialogue: 0,0:25:15.04,0:25:17.63,نص عام,,0,0,0,,لست مخطئًا. لقد كذبت
Dialogue: 0,0:25:17.71,0:25:19.80,نص عام,,0,0,0,,إنه يقف هنا حياً،
Dialogue: 0,0:25:20.67,0:25:22.84,نص عام,,0,0,0,,اتضح أنني كنت أكذب حقًا
Dialogue: 0,0:25:27.30,0:25:29.26,general text,,0,0,0,,لقد حاول خداع الجميع،
Dialogue: 0,0:25:29.35,0:25:32.56,نص عام,,0,0,0,,لأنني كسرت كأس الأبراج
Dialogue: 0,0:25:32.64,0:25:33.85,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:25:35.23,0:25:36.98,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:25:38.61,0:25:42.23,نص عام,,0,0,0,,نعم. كل ما قلته هو كذب
Dialogue: 0,0:25:45.07,0:25:48.28,general text,,0,0,0,,شقت طريقي إلى جيونبوغوان، وكسرت الأثر،
Dialogue: 0,0:25:48.37,0:25:52.20,general text,,0,0,0,,ثم كذبت لتخفيه؟
Dialogue: 0,0:25:52.29,0:25:55.00,نص عام,,0,0,0,,آسف، أنا آسف
Dialogue: 0,0:25:57.71,0:25:59.46,general text,,0,0,0,,إنه ساحر سوسنوفي بور،
Dialogue: 0,0:25:59.54,0:26:02.38,نص عام,,0,0,0,,أنا شخصياً أعتذر عن ذلك
Dialogue: 0,0:26:04.09,0:26:07.01,نص عام,,0,0,0,,أعتذر للنائب جين مو
Dialogue: 0,0:26:11.18,0:26:15.81,نص عام,,0,0,0,,غابة الصنوبر ستصلح الوعاء
Dialogue: 0,0:26:18.19,0:26:19.40,نص عام,,0,0,0,,لا حاجة
Dialogue: 0,0:26:19.48,0:26:20.69,خط مائل,,0,0,0,,لا ترفض
Dialogue: 0,0:26:20.77,0:26:23.23,general text,,0,0,0,,هذه هي الطريقة الوحيدة التي يمكن أن نتحمل بها المسؤولية عن هذا
Dialogue: 0,0:26:24.94,0:26:26.40,النص العام,,0,0,0,,- لا يستحق\N- سموك
Dialogue: 0,0:26:26.99,0:26:29.66,النص العام,,0,0,0,,دع سوسنوفي بور يصحح الخطأ
Dialogue: 0,0:26:31.95,0:26:33.49,نص عام,,0,0,0,,دعهم يا أماه
Dialogue: 0,0:26:35.54,0:26:37.41,نص عام,,0,0,0,,افعل ما يحلو لك
Dialogue: 0,0:26:38.54,0:26:40.63,نص عام,,0,0,0,,حان وقت عودتي
Dialogue: 0,0:27:03.44,0:27:06.40,نص عام,,0,0,0,,سأرسل شعبي غدًا،
Dialogue: 0,0:27:06.49,0:27:08.36,نص عام,,0,0,0,,لإصلاح الوعاء المكسور
Dialogue: 0,0:27:09.11,0:27:12.41,general text,,0,0,0,,والآن يجب أن أعود لمعاقبة الساحر بشكل صحيح،
Dialogue: 0,0:27:12.49,0:27:15.70,النص العام,,0,0,0,,من كذب على الأمير وأهل جيونبوغوان
Dialogue: 0,0:27:16.75,0:27:18.21,نص عام,,0,0,0,,- إعادة التوجيه\N- هذا لن ينجح
Dialogue: 0,0:27:18.91,0:27:22.21,general text,,0,0,0,,سيبقى تشان ووك وسيُعاقب هنا
Dialogue: 0,0:27:27.46,0:27:29.26,نص عام,,0,0,0,,أعتقد ذلك أيضًا...
Dialogue: 0,0:27:30.26,0:27:32.09,نص عام,,0,0,0,,ماذا يحدث يا صاحب السمو
Dialogue: 0,0:27:32.89,0:27:34.60,نص عام,,0,0,0,,احفظ سيدي
Dialogue: 0,0:27:35.22,0:27:37.39,general text,,0,0,0,,إذا تم نقله إلى سوسنوفي بور،
Dialogue: 0,0:27:40.06,0:27:43.81,general text,,0,0,0,,سيضرب هناك حتى الموت
Dialogue: 0,0:27:46.19,0:27:47.69,خط مائل,,0,0,0,,آخر مرة
Dialogue: 0,0:27:47.78,0:27:49.90,النص العام,,0,0,0,,تلقى مائة ضربة
Dialogue: 0,0:27:50.61,0:27:52.70,نص عام,,0,0,0,,هذه المرة سيكون الأمر أسوأ
Dialogue: 0,0:27:52.78,0:27:54.91,نص عام,,0,0,0,,لا تدع هذا يحدث
Dialogue: 0,0:27:56.91,0:27:58.12,نص عام,,0,0,0,,مو دوك، هذا يكفي
Dialogue: 0,0:28:00.12,0:28:03.25,النص العام,,0,0,0,,لقد أخطأت وسوف أعاقب
Dialogue: 0,0:28:06.88,0:28:09.05,نص عام,,0,0,0,,لم أبدي الاحترام الواجب لسموه
Dialogue: 0,0:28:11.63,0:28:13.43,نص عام,,0,0,0,,لا أجرؤ على طلب الرحمة
Dialogue: 0,0:28:13.51,0:28:17.35,general text,,0,0,0,,فليأخذوك ويقتلوك؟
Dialogue: 0,0:28:18.06,0:28:20.27,نص عام,,0,0,0,,إذا أراد الرأس ذلك فنعم
Dialogue: 0,0:28:23.15,0:28:23.98,نص عام,,0,0,0,,الجنة...
Dialogue: 0,0:28:29.94,0:28:31.40,نص عام,,0,0,0,,يمكنك اصطحابي
Dialogue: 0,0:28:33.82,0:28:35.57,نص عام,,0,0,0,,كيف ذلك يا معلم!
Dialogue: 0,0:28:35.66,0:28:37.28,نص عام,,0,0,0,,سوف تموت!
Dialogue: 0,0:28:37.91,0:28:41.96,general text,,0,0,0,,سوف تموت إذا عدت إلى سوسنوفي بور!
Dialogue: 0,0:28:44.58,0:28:49.05,general text,,0,0,0,,سأعاقبه كما تقتضيه مجموعة القواعد
Dialogue: 0,0:28:53.26,0:28:54.93,نص عام,,0,0,0,,يا أنت. انتظر
Dialogue: 0,0:28:59.47,0:29:01.52,general text,,0,0,0,,سيتم معاقبة تشان ووك,
Dialogue: 0,0:29:01.60,0:29:03.23,نص عام,,0,0,0,,انسوا ما حدث
Dialogue: 0,0:29:04.27,0:29:05.81,نص عام,,0,0,0,,هذا مجرد مضحك
Dialogue: 0,0:29:05.90,0:29:06.94,نص عام,,0,0,0,,لكن
Dialogue: 0,0:29:07.48,0:29:09.98,نص عام,,0,0,0,,قصة ملفات تعريف الارتباط أسوأ من ذلك
Dialogue: 0,0:29:10.69,0:29:13.32,نص عام,,0,0,0,,رئيس غابة الصنوبر ونائب غوانغجو
Dialogue: 0,0:29:13.40,0:29:15.03,نص عام,,0,0,0,,شجار حول ملفات تعريف الارتباط؟
Dialogue: 0,0:29:15.99,0:29:16.99,نص عام,,0,0,0,,فقط أضحك
Dialogue: 0,0:29:17.74,0:29:19.16,نص عام,,0,0,0,,أغبى عذر
Dialogue: 0,0:29:20.99,0:29:21.83,نص عام,,0,0,0,,أنت على حق
Dialogue: 0,0:29:24.25,0:29:26.17,general text,,0,0,0,,لكن كيف انكسر وعاء الأبراج؟
Dialogue: 0,0:29:29.13,0:29:31.09,نص عام,,0,0,0,,إذا ضرب البرق،
Dialogue: 0,0:29:31.17,0:29:33.63,نص عام,,0,0,0,,يعني أن البوابة فوق الوعاء قد انفتحت
Dialogue: 0,0:29:33.72,0:29:36.93,general text,,0,0,0,,ولكن فقط أولئك الذين أتقنوا تشيسا يمكنهم فعل ذلك
Dialogue: 0,0:29:37.93,0:29:39.14,نص عام,,0,0,0,,هذا كل شيء
Dialogue: 0,0:29:42.27,0:29:44.69,general text,,0,0,0,,تشان ووك لا يملك تشيسو
Dialogue: 0,0:29:48.98,0:29:51.02,نص عام,,0,0,0,,كيف انكسر الكأس؟
Dialogue: 0,0:29:56.99,0:30:00.95,خارج الإطار,,0,0,0,,هل كان هناك أي شخص آخر هنا يملك تشيسو؟
Dialogue: 0,0:30:01.70,0:30:03.37,خلف الكواليس,,0,0,0,,هذا مستحيل
Dialogue: 0,0:30:19.89,0:30:23.14,النص العام,,0,0,0,,لقد خرجنا من هناك بفضلك يا مو دوك
Dialogue: 0,0:30:23.22,0:30:25.02,النص العام,,0,0,0,,إذا حاولت المغادرة فسوف يمنعونك
Dialogue: 0,0:30:25.10,0:30:27.27,general text,,0,0,0,,وإذا قررت البقاء سيحاولون إبعادك
Dialogue: 0,0:30:27.35,0:30:31.15,general text,,0,0,0,,إذًا تعمدت تقديم هذا الأداء؟ ذكي
Dialogue: 0,0:30:31.23,0:30:34.15,النص العام,,0,0,0,,قررت أنك لن تقنعهم،
Dialogue: 0,0:30:34.23,0:30:36.45,نص عام,,0,0,0,,فتدخلت بدون استئذان
Dialogue: 0,0:30:36.53,0:30:38.57,نص عام,,0,0,0,,آسف على التطفل
Dialogue: 0,0:30:39.41,0:30:42.49,نص عام,,0,0,0,,لم أتوقع هذا فتفاجأت
Dialogue: 0,0:30:44.49,0:30:45.66,نص عام,,0,0,0,,لكنك عظيم
Dialogue: 0,0:30:47.33,0:30:48.54,نص عام,,0,0,0,,الفصل
Dialogue: 0,0:30:48.62,0:30:50.58,نص عام,,0,0,0,,لم نكذب
Dialogue: 0,0:30:50.67,0:30:54.34,general text,,0,0,0,,رأينا كيف أصبح الخصي كيم جامحًا ومتحجرًا
Dialogue: 0,0:30:54.42,0:30:55.71,نص عام,,0,0,0,,أعلم أنهم لم يكذبوا
Dialogue: 0,0:30:56.34,0:30:58.72,خط مائل,,0,0,0,,أحيانًا لا أفكر بوضوح،
Dialogue: 0,0:30:58.80,0:31:00.68,نص عام,,0,0,0,,لكنني أستطيع تمييز الكذب من الحقيقة
Dialogue: 0,0:31:01.64,0:31:03.39,مائل,,0,0,0,,لقد تحجر، لكنه عاد إلى رشده
Dialogue: 0,0:31:03.47,0:31:07.10,general text,,0,0,0,,إذن لديهم حجر ثلج؟
Dialogue: 0,0:31:07.89,0:31:09.56,نص عام,,0,0,0,,سوسنوفي بور منذ فترة طويلة
Dialogue: 0,0:31:10.52,0:31:13.27,نص عام,,0,0,0,,يشاهد جين مو
Dialogue: 0,0:31:13.94,0:31:15.44,نص عام,,0,0,0,,كل شيء كما توقعنا
Dialogue: 0,0:31:17.74,0:31:19.70,نص عام,,0,0,0,,أعتقد أن الحجر معهم
Dialogue: 0,0:31:25.70,0:31:29.58,general text,,0,0,0,,هل استخدمت الحجر لإحيائي؟
Dialogue: 0,0:31:29.66,0:31:32.00,general text,,0,0,0,,قوته مذهلة بكل بساطة
Dialogue: 0,0:31:33.00,0:31:35.42,نص عام,,0,0,0,,أشعر حقًا أنني على قيد الحياة
Dialogue: 0,0:31:36.76,0:31:40.13,general text,,0,0,0,,شان ووك حولك إلى حجر؟
Dialogue: 0,0:31:41.05,0:31:44.10,general text,,0,0,0,,بدأت الطاقة تغادر جسدي فجأة،
Dialogue: 0,0:31:44.76,0:31:48.68,النص العام,,0,0,0,,عندما كنت على وشك الاكتفاء من خادمته
Dialogue: 0,0:31:49.60,0:31:50.98,النص العام,,0,0,0,,ثم فقدت الوعي
Dialogue: 0,0:31:52.15,0:31:55.65,general text,,0,0,0,,هل رأيت كيف فتح تشانغ ووك السقف فوق وعاء الأبراج؟
Dialogue: 0,0:31:56.36,0:31:57.57,نص عام,,0,0,0,,لا لم أره
Dialogue: 0,0:31:58.82,0:32:01.36,general text,,0,0,0,,ربما كان هناك ساحر آخر إلى جانب تشان ووك؟
Dialogue: 0,0:32:02.32,0:32:03.57,نص عام,,0,0,0,,لا شيء
Dialogue: 0,0:32:04.74,0:32:06.91,general text,,0,0,0,,ماذا لو كان تشانغ ووك قد امتلك تشيسو بالفعل؟
Dialogue: 0,0:32:07.66,0:32:08.95,نص عام,,0,0,0,,ربما يخفي الأمر فقط
Dialogue: 0,0:32:10.66,0:32:14.29,general text,,0,0,0,,عندما هاجمني، لم يبدُ ماهرًا بشكل خاص
Dialogue: 0,0:32:14.38,0:32:17.50,general text,,0,0,0,,لقد أتقن ريوسو في وقت قصير بشكل لا يصدق
Dialogue: 0,0:32:18.34,0:32:19.67,نص عام,,0,0,0,,فمن الممكن
Dialogue: 0,0:32:22.63,0:32:24.68,خط مائل,,0,0,0,,الآن هناك حجر جليدي بداخلي،
Dialogue: 0,0:32:24.76,0:32:27.97,النص العام,,0,0,0,,هل هذا يعني أنني أملك هوانسو؟
Dialogue: 0,0:32:31.23,0:32:33.40,النص العام,,0,0,0,,لديك هذه القوة حقًا
Dialogue: 0,0:32:34.44,0:32:37.32,النص العام,,0,0,0,,لكنك لا تعرف كيفية إلقاء التعويذات،
Dialogue: 0,0:32:37.40,0:32:40.28,نص عام,,0,0,0,,لذلك لا يمكنك استخدام هذه القوة
Dialogue: 0,0:32:45.95,0:32:48.79,النص العام,,0,0,0,,ولكن حجر الجليد ملكي الآن
Dialogue: 0,0:32:48.87,0:32:51.83,general text,,0,0,0,,لقد أعدتك إلى الحياة لبعض الوقت لأنه لم يكن لدينا خيار آخر
Dialogue: 0,0:33:45.76,0:33:47.76,نص عام,,0,0,0,,إذن يا حجر
Dialogue: 0,0:33:47.84,0:33:50.35,نص عام,,0,0,0,,يمكن أن يمنع تحول البدو
Dialogue: 0,0:33:51.31,0:33:52.85,general text,,0,0,0,,يجب أن نجده وندمره
Dialogue: 0,0:33:53.64,0:33:57.27,general text,,0,0,0,,علينا أن ندمر كل البدو، ويعيدهم إلى الحياة.
Dialogue: 0,0:33:57.35,0:33:59.19,general text,,0,0,0,,قوته فظيعة حقًا
Dialogue: 0,0:34:00.86,0:34:01.90,نص عام,,0,0,0,,ولكن هذا...
Dialogue: 0,0:34:03.74,0:34:07.24,مائل,,0,0,0,,المملكة المتحدة، سيكتشفون قريبًا عقابك،
Dialogue: 0,0:34:07.32,0:34:09.16,نص عام,,0,0,0,,حتى لا تتمكن من العودة
Dialogue: 0,0:34:09.87,0:34:11.24,نص عام,,0,0,0,,ابقِ في المنزل لبعض الوقت
Dialogue: 0,0:34:11.33,0:34:15.16,النص العام,,0,0,0,,حسنًا، مو ديوك وأنا سنعود للمنزل
Dialogue: 0,0:34:15.25,0:34:19.58,نص عام,,0,0,0,,حاول ألا تلفت انتباه جين مو
Dialogue: 0,0:34:20.84,0:34:21.84,نص عام,,0,0,0,,نعم
Dialogue: 0,0:34:23.88,0:34:25.01,نص عام,,0,0,0,,لنذهب
Dialogue: 0,0:34:33.27,0:34:35.39,general text,,0,0,0,,سوف يتخلص من الحجر بمجرد استلامه
Dialogue: 0,0:34:35.48,0:34:37.39,نص عام,,0,0,0,,علينا العثور عليه مبكرًا
Dialogue: 0,0:34:37.48,0:34:39.06,نص عام,,0,0,0,,كيل جو كان على حق
Dialogue: 0,0:34:39.77,0:34:42.48,نص عام,,0,0,0,,حجر في القصر
Dialogue: 0,0:34:43.02,0:34:46.19,النص العام,,0,0,0,,دان تشو، الذي يملك الحجر...
Dialogue: 0,0:34:47.15,0:34:48.45,نص عام,,0,0,0,,هذا هو ذلك الشخص
Dialogue: 0,0:34:52.74,0:34:55.12,نص عام,,0,0,0,,تعامل مع كل شيء بهدوء
Dialogue: 0,0:34:55.20,0:34:57.79,نص عام,,0,0,0,,سأرسل سيدة البلاط خان بدلاً من ذلك
Dialogue: 0,0:34:57.87,0:35:00.08,نص عام,,0,0,0,,سوف ترسل رسائل من خلاله
Dialogue: 0,0:35:00.75,0:35:01.92,نص عام,,0,0,0,,أنا أفهمك
Dialogue: 0,0:35:02.63,0:35:06.80,general text,,0,0,0,,بسبب ما حدث، سوف يشتبه بي سوسنوفي بور الآن
Dialogue: 0,0:35:07.38,0:35:12.01,general text,,0,0,0,,حدث هذا لأنك قللت من شأن تشان ووك
Dialogue: 0,0:35:12.60,0:35:15.43,النص العام,,0,0,0,,لم أكن أعتقد أنه سيحرر نفسه بهذه السرعة
Dialogue: 0,0:35:15.52,0:35:17.77,general text,,0,0,0,,إنه عبقري أتقن ريوسو على الفور
Dialogue: 0,0:35:17.85,0:35:20.02,النص العام,,0,0,0,,ولد بطاقة نجم الملك
Dialogue: 0,0:35:20.10,0:35:21.73,نص عام,,0,0,0,,لم أبدأ على الفور بالتقليل من شأنه
Dialogue: 0,0:35:22.69,0:35:24.32,خط مائل,,0,0,0,,اعتقدت أنه مميز،
Dialogue: 0,0:35:24.40,0:35:27.19,نص عام,,0,0,0,,منذ أن ولد تحت برج مثل هذا النجم
Dialogue: 0,0:35:27.28,0:35:30.53,general text,,0,0,0,,ومع ذلك، تبين أن تشان ووك كان مخيبا للآمال تماما
Dialogue: 0,0:35:30.61,0:35:33.33,نص عام,,0,0,0,,كان فتى بسيطاً، لا شيء مميز
Dialogue: 0,0:35:36.41,0:35:40.08,general text,,0,0,0,,غاضب من العالم وأخفى عجزه وكسله
Dialogue: 0,0:35:40.17,0:35:44.29,نص عام,,0,0,0,,تحت ستار رباطة الجأش. لم يكن لديه هدف قط
Dialogue: 0,0:35:44.88,0:35:47.34,italics,,0,0,0,,لقد كان مجرد شاب نبيل يتمتع بتقدير كبير لذاته،
Dialogue: 0,0:35:47.92,0:35:50.26,نص عام,,0,0,0,,فكان كافياً لخدمته
Dialogue: 0,0:35:51.22,0:35:53.14,نص عام,,0,0,0,,فلقد تغير
Dialogue: 0,0:35:54.22,0:35:55.85,نص عام,,0,0,0,,كنت أظنه ضعيفاً
Dialogue: 0,0:35:55.93,0:35:58.73,general text,,0,0,0,,لكنه فتح باب الطاقة بشرب السم
Dialogue: 0,0:35:58.81,0:36:02.15,general text,,0,0,0,,كنت أظنه مجرد متفاخر، لكنه هزم ولي العهد فعلاً
Dialogue: 0,0:36:03.19,0:36:05.27,general text,,0,0,0,,ما الذي جعله يتغير إلى هذا الحد؟
Dialogue: 0,0:36:05.36,0:36:07.19,نص عام,,0,0,0,,الناس تتغير
Dialogue: 0,0:36:08.69,0:36:10.15,نص عام,,0,0,0,,من أجل الآخرين
Dialogue: 0,0:36:11.45,0:36:14.20,general text,,0,0,0,,ابحث عن الشخص الذي ظهر في حياته قبل فترة وجيزة من كل التغييرات
Dialogue: 0,0:36:17.24,0:36:18.41,نص عام,,0,0,0,,هذا سيكون الجواب
Dialogue: 0,0:36:22.29,0:36:25.84,general text,,0,0,0,,تم رفض تشان ووك من قبل اثني عشر معلمًا، لكنه وجد طريقه
Dialogue: 0,0:36:29.46,0:36:31.13,النص العام,,0,0,0,,من يستطيع مساعدته في هذا؟
Dialogue: 0,0:36:34.89,0:36:37.47,النص العام,,0,0,0,,يا معلمة، هل يمكننا الذهاب إلى دانهيانغوك على الفور؟
Dialogue: 0,0:36:38.81,0:36:41.43,النص العام,,0,0,0,,بفضل عقابي، أصبح لدينا الوقت
Dialogue: 0,0:36:42.02,0:36:43.77,نص عام,,0,0,0,,دعونا نتدرب في دانهيانغك
Dialogue: 0,0:36:43.85,0:36:46.65,نص عام,,0,0,0,,يمكننا أن نحاول تسلق تلك الشجرة
Dialogue: 0,0:36:50.78,0:36:52.74,نص عام,,0,0,0,,الجو بارد جداً في دانهيانغك الآن
Dialogue: 0,0:36:53.66,0:36:56.12,نص عام,,0,0,0,,إذا علقنا هناك بسبب الثلج،
Dialogue: 0,0:36:57.12,0:36:58.58,النص العام,,0,0,0,,قد نموت من الجوع
Dialogue: 0,0:36:58.66,0:37:01.66,النص العام,,0,0,0,,اعتقدت أن الجو دافئ هناك في الشتاء وكان هناك الكثير من الطعام
Dialogue: 0,0:37:01.75,0:37:04.08,نص عام,,0,0,0,,لقد قلت ذلك ليوليا في المرة الماضية
Dialogue: 0,0:37:08.00,0:37:11.34,نص عام,,0,0,0,,قلت ذلك لتهدئته
Dialogue: 0,0:37:15.84,0:37:19.22,general text,,0,0,0,,كان يشعر بالقلق من أن طائره الأليف يواجه صعوبة في الشتاء،
Dialogue: 0,0:37:19.31,0:37:20.72,نص عام,,0,0,0,,فكذبت
Dialogue: 0,0:37:21.56,0:37:25.94,general text,,0,0,0,,هل تتحدث عن ذلك الطائر الذي نادى عليه بصافرته عندما كان في دانهيانغوك؟
Dialogue: 0,0:37:47.79,0:37:50.96,general text,,0,0,0,,كاد جين مو أن يقتل ووك؟
Dialogue: 0,0:37:52.38,0:37:56.38,general text,,0,0,0,,اعتذرت لأوكا وأخذته بعيداً عن هناك
Dialogue: 0,0:37:56.47,0:37:59.22,general text,,0,0,0,,لكن جين مو قد يحاول إيذائه
Dialogue: 0,0:38:02.35,0:38:05.60,general text,,0,0,0,,لحسن الحظ أصررت أن نصلح وعاء الكوكبة،
Dialogue: 0,0:38:05.69,0:38:07.40,نص عام,,0,0,0,,حتى نتمكن من الوصول إلى جيونبوغوان
Dialogue: 0,0:38:09.81,0:38:13.03,النص العام,,0,0,0,,سوف تذهب إلى جيونبوجوان مع عمال سوسنوفي بور
Dialogue: 0,0:38:13.74,0:38:15.36,نص عام,,0,0,0,,وسوف تعتني بجين مو
Dialogue: 0,0:38:16.74,0:38:18.07,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:38:27.42,0:38:28.67,نص عام,,0,0,0,,سانغ هو
Dialogue: 0,0:38:29.58,0:38:32.34,general text,,0,0,0,,سمعت أن مو دوك كان أيضًا في جيونبوغوان
Dialogue: 0,0:38:32.42,0:38:34.09,نص عام,,0,0,0,,هل هي بخير؟
Dialogue: 0,0:38:34.17,0:38:35.47,نص عام,,0,0,0,,نعم
Dialogue: 0,0:38:38.97,0:38:42.64,general text,,0,0,0,,البدوي الذي أصبح متوحشًا وتحول إلى حجر،
Dialogue: 0,0:38:42.72,0:38:44.56,النص العام,,0,0,0,,هل حقاً عدت إلى الحياة؟
Dialogue: 0,0:38:44.64,0:38:48.10,general text,,0,0,0,,فكان على الفصل أن يعود دون أن يقول أي شيء
Dialogue: 0,0:38:50.61,0:38:52.40,general text,,0,0,0,,كيف كان رد فعل المملكة المتحدة على هذا؟
Dialogue: 0,0:38:52.98,0:38:54.86,نص عام,,0,0,0,,يبدو أنه لم يتفاجأ
Dialogue: 0,0:38:55.40,0:38:58.20,general text,,0,0,0,,سأل الرأس إذا كان حجر الجليد
Dialogue: 0,0:38:58.28,0:39:00.91,نص عام,,0,0,0,,أعيد ابتلاع الروح إلى الحياة
Dialogue: 0,0:39:00.99,0:39:03.03,النص العام,,0,0,0,,يبدو أنه كان على علم بالأمر بالفعل
Dialogue: 0,0:39:05.54,0:39:08.54,general text,,0,0,0,,لذا فقد رأى بنفسه كيف عاد البدو إلى الحياة
Dialogue: 0,0:39:08.62,0:39:11.08,general text,,0,0,0,,قال له الرئيس أنهم بحاجة إلى التدمير
Dialogue: 0,0:39:12.25,0:39:14.25,مائل,,0,0,0,,والبدو والحجر
Dialogue: 0,0:39:14.34,0:39:16.51,النص العام,,0,0,0,,تخلص من كل ما هو شر
Dialogue: 0,0:39:19.43,0:39:21.80,general text,,0,0,0,,وماذا ردت المملكة المتحدة على هذا؟
Dialogue: 0,0:39:21.89,0:39:23.81,خط مائل,,0,0,0,,هذا مجرد تخميني،
Dialogue: 0,0:39:24.76,0:39:26.31,نص عام,,0,0,0,,لكن يبدو أنه لا يوافق عليه
Dialogue: 0,0:39:27.14,0:39:30.40,مائل,,0,0,0,,تشان ووك دائمًا خالي من الهموم وخالي من الهموم
Dialogue: 0,0:39:30.48,0:39:34.44,general text,,0,0,0,,لكن لا يمكنك التعامل مع السحر الأسود بهذه الطريقة
Dialogue: 0,0:39:35.53,0:39:37.49,خط مائل,,0,0,0,,أنت والمملكة المتحدة قريبتان
Dialogue: 0,0:39:37.57,0:39:39.57,نص عام,,0,0,0,,عليك أن تحذره
Dialogue: 0,0:39:51.75,0:39:54.25,النص العام,,0,0,0,,الجو ليس باردًا فقط في دانهيانجك،
Dialogue: 0,0:39:54.34,0:39:56.67,نص عام,,0,0,0,,لا يوجد أحد هناك على الإطلاق
Dialogue: 0,0:39:57.55,0:39:59.88,نص عام,,0,0,0,,لا يمكننا أن نكون وحدنا الآن
Dialogue: 0,0:40:00.72,0:40:02.22,نص عام,,0,0,0,,لماذا حدث هذا فجأة؟
Dialogue: 0,0:40:04.97,0:40:06.14,نص عام,,0,0,0,,أخشى,
Dialogue: 0,0:40:08.77,0:40:10.31,نص عام,,0,0,0,,سأمتص طاقتك
Dialogue: 0,0:40:10.89,0:40:14.15,نص عام,,0,0,0,,أنت لم تتوحش. لم يحدث شيء، حتى بعد اتصالنا
Dialogue: 0,0:40:14.23,0:40:16.57,النص العام,,0,0,0,,لأنني استوعبت طاقة ذلك الخصي
Dialogue: 0,0:40:17.15,0:40:18.57,خط مائل,,0,0,0,,كل شيء على ما يرام الآن،
Dialogue: 0,0:40:18.65,0:40:21.11,نص عام,,0,0,0,,لكننا لا نعرف متى قد يحدث هذا مرة أخرى
Dialogue: 0,0:40:22.95,0:40:24.41,نص عام,,0,0,0,,إذا لزم الأمر,
Dialogue: 0,0:40:25.20,0:40:26.95,النص العام,,0,0,0,,إما أن تهرب أو تقتلني
Dialogue: 0,0:40:29.41,0:40:31.33,نص عام,,0,0,0,,ولكن إذا استوعبت طاقتك،
Dialogue: 0,0:40:33.54,0:40:35.04,نص عام,,0,0,0,,لا أستطيع تحمل هذا
Dialogue: 0,0:40:44.09,0:40:45.30,نص عام,,0,0,0,,ما المضحك؟
Dialogue: 0,0:40:45.97,0:40:47.47,نص عام,,0,0,0,,هل تستمتع؟
Dialogue: 0,0:40:48.26,0:40:49.60,نص عام,,0,0,0,,لا، ليس هذا هو الهدف
Dialogue: 0,0:40:52.56,0:40:53.73,نص عام,,0,0,0,,رفرف قلبي
Dialogue: 0,0:40:56.36,0:40:57.90,نص عام,,0,0,0,,هذه كلماتك
Dialogue: 0,0:40:59.19,0:41:01.57,نص عام,,0,0,0,,يحمل معنى أكبر من "اشتقت إليك"
Dialogue: 0,0:41:04.61,0:41:06.99,نص عام,,0,0,0,,أخيرًا أجاب محارب الظل
Dialogue: 0,0:41:08.33,0:41:10.95,النص العام,,0,0,0,,إلى إعلان حبي الساذج والصادق
Dialogue: 0,0:41:20.17,0:41:22.05,نص عام,,0,0,0,,سوف أجد حجرًا،
Dialogue: 0,0:41:22.76,0:41:26.01,نص عام,,0,0,0,,حتى لا تضطر أبدًا إلى استيعاب طاقتي
Dialogue: 0,0:41:33.06,0:41:35.19,general text,,0,0,0,,سيتعين عليك مواجهة بارك جين
Dialogue: 0,0:41:35.27,0:41:38.11,النص العام,,0,0,0,,حينها سأصبح قوياً
Dialogue: 0,0:41:42.49,0:41:45.49,general text,,0,0,0,,لقد خسرت تسع معارك متتالية أمام سحرة جيونجينغاك
Dialogue: 0,0:41:46.78,0:41:48.12,نص عام,,0,0,0,,مغرور
Dialogue: 0,0:41:51.41,0:41:54.96,نص عام,,0,0,0,,بالضبط، يشم يين يانغ. لا بد لي من إعادته
Dialogue: 0,0:41:56.12,0:41:59.71,general text,,0,0,0,,ولكن كيف اتصلت بولي العهد؟
Dialogue: 0,0:42:01.59,0:42:03.80,نص عام,,0,0,0,,هناك طريقة واحدة...
Dialogue: 0,0:42:04.88,0:42:06.59,النص العام,,0,0,0,,يجعل قلبي ينبض بعنف
Dialogue: 0,0:42:26.74,0:42:29.41,مائل,,0,0,0,,تشان ووك، الجاني المزعوم، لم يكن معه سيف
Dialogue: 0,0:42:30.87,0:42:33.83,general text,,0,0,0,,ولكن جين مو كان يملكها رغم إصراره على براءته
Dialogue: 0,0:42:46.67,0:42:48.13,نص عام,,0,0,0,,سيدي.
Dialogue: 0,0:42:48.22,0:42:51.10,نص عام,,0,0,0,,سيد لي، ما الذي أتى بك إلى هنا؟
Dialogue: 0,0:42:51.18,0:42:53.22,general text,,0,0,0,,لماذا لست في سوسنوفي بور، بل في المنزل؟
Dialogue: 0,0:42:54.47,0:42:56.06,النص العام,,0,0,0,,يعاقب
Dialogue: 0,0:42:58.48,0:43:00.19,نص عام,,0,0,0,,معاقبة؟ لماذا؟
Dialogue: 0,0:43:00.94,0:43:02.77,نص عام,,0,0,0,,ماذا فعلت هذه المرة؟
Dialogue: 0,0:43:02.86,0:43:04.23,نص عام,,0,0,0,,لا ليس الأمر كذلك
Dialogue: 0,0:43:04.32,0:43:07.15,نص عام,,0,0,0,,الخادم كيم، لا تقلق كثيرًا
Dialogue: 0,0:43:07.24,0:43:08.57,خط مائل,,0,0,0,,إنه مثل...
Dialogue: 0,0:43:09.99,0:43:11.99,نص عام,,0,0,0,,ليس عقابًا حقيقيًا
Dialogue: 0,0:43:12.08,0:43:15.20,النص العام,,0,0,0,,إنها أقرب إلى إجازة مقنعة كعقاب
Dialogue: 0,0:43:18.50,0:43:19.83,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,0:43:21.33,0:43:22.38,خط مائل,,0,0,0,,يسعدني سماع ذلك
Dialogue: 0,0:43:23.63,0:43:26.80,النص العام,,0,0,0,,ثم سنصطاد في بحيرة جيونج تشونج دايهو
Dialogue: 0,0:43:28.26,0:43:29.51,خط مائل,,0,0,0,,فكرة رائعة
Dialogue: 0,0:43:29.59,0:43:33.93,النص العام,,0,0,0,,يجب أن تستريح هنا بعد قضاء الوقت مع السيد تشان
Dialogue: 0,0:43:35.06,0:43:38.64,نص عام,,0,0,0,,مستحيل يا خادمة كيم. لا أستطيع أن أهدأ الآن
Dialogue: 0,0:43:38.73,0:43:40.10,خط مائل,,0,0,0,,سيد لي، آسف
Dialogue: 0,0:43:40.19,0:43:42.73,general text,,0,0,0,,لقد خسرت بالفعل تسع معارك من أصل عشر
Dialogue: 0,0:43:42.81,0:43:44.61,النص العام,,0,0,0,,الفرصة الأخيرة المتبقية للفوز
Dialogue: 0,0:43:45.27,0:43:48.03,نص عام,,0,0,0,,سأتدرب. آمل أن تفهمكم
Dialogue: 0,0:43:49.36,0:43:52.41,النص العام,,0,0,0,,لقد أصبحت فجأة مجتهداً للغاية
Dialogue: 0,0:43:52.49,0:43:55.66,general text,,0,0,0,,نعم، هدفي هو جعل الخادمة كيم فخورة بي
Dialogue: 0,0:43:55.74,0:43:57.70,نص عام,,0,0,0,,لا أستطيع الجلوس والصيد
Dialogue: 0,0:43:58.96,0:44:02.83,النص العام,,0,0,0,,مؤخراً كلماتك لامست روحي
Dialogue: 0,0:44:03.63,0:44:04.59,مائل,,0,0,0,,حسنًا
Dialogue: 0,0:44:04.67,0:44:06.13,نص عام,,0,0,0,,إلى الأمام للتدريب
Dialogue: 0,0:44:06.21,0:44:09.05,نص عام,,0,0,0,,وسأعد لك بعض الحلويات
Dialogue: 0,0:44:17.81,0:44:20.98,general text,,0,0,0,,قل الحقيقة، لماذا تمت معاقبتك؟
Dialogue: 0,0:44:25.02,0:44:27.28,نص عام,,0,0,0,,لقد كسرت كأس الأبراج في جيونبوغوان
Dialogue: 0,0:44:28.36,0:44:30.19,نص عام,,0,0,0,,لا تخبري ذلك للخادمة كيم
Dialogue: 0,0:44:30.28,0:44:33.24,النص العام,,0,0,0,,رأيت ضربة صاعقة فوق جيونبوجوان مباشرةً
Dialogue: 0,0:44:33.32,0:44:34.78,نص عام,,0,0,0,,أعتقد أنها لمست الكأس
Dialogue: 0,0:44:35.66,0:44:39.37,general text,,0,0,0,,لا يمكننا إخبارك بالتفاصيل، لكن المالك ليس مسؤولاً عن أي شيء
Dialogue: 0,0:44:40.87,0:44:43.33,نص عام,,0,0,0,,سيخبرك رئيس سوسنوفي بور بالباقي
Dialogue: 0,0:44:45.08,0:44:46.54,خط مائل,,0,0,0,,سأقرضك صنارات الصيد الخاصة بي
Dialogue: 0,0:44:46.63,0:44:48.46,نص عام,,0,0,0,,كنت أحب الصيد
Dialogue: 0,0:44:48.55,0:44:51.13,نص عام,,0,0,0,,لدي اثنين من الأشياء الجيدة جدًا
Dialogue: 0,0:44:51.22,0:44:52.09,نص عام,,0,0,0,,سأحضره الآن
Dialogue: 0,0:44:57.43,0:44:58.64,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:45:00.35,0:45:04.10,نص عام,,0,0,0,,أردت أن أعلمه كيف يصطاد سمكة ذهبية
Dialogue: 0,0:45:05.06,0:45:06.11,نص عام,,0,0,0,,السمكة الذهبية؟
Dialogue: 0,0:45:06.69,0:45:10.19,نص عام,,0,0,0,,أنت تتحدث عن الشخص الذي لا يمكن القبض عليه إلا
Dialogue: 0,0:45:10.28,0:45:11.86,خط مائل,,0,0,0,,في بحيرة جيونج تشونج دايهو؟
Dialogue: 0,0:45:12.57,0:45:13.82,نص عام,,0,0,0,,هل تعرف ما هذا؟
Dialogue: 0,0:45:13.91,0:45:17.12,نص عام,,0,0,0,,سمعت عنها. الأسماك التي تتشكل من طاقة البحيرة
Dialogue: 0,0:45:17.20,0:45:21.41,general text,,0,0,0,,سمعت أن السحرة الذين أتقنوا تشيسو أو أعلى هم فقط من يمكنهم الإمساك بها
Dialogue: 0,0:45:21.50,0:45:23.66,نص عام,,0,0,0,,أنت تعرف الكثير حقًا
Dialogue: 0,0:45:24.25,0:45:26.29,النص العام,,0,0,0,,عندما اصطدت هذه السمكة وسيطرت عليها
Dialogue: 0,0:45:26.38,0:45:28.00,خط مائل,,0,0,0,,طاقة بحيرة جيونج تشونج دايهو...
Dialogue: 0,0:45:29.55,0:45:30.76,نص عام,,0,0,0,,شعور لطيف
Dialogue: 0,0:45:32.13,0:45:35.76,نص عام,,0,0,0,,شارك هذا مع المالك
Dialogue: 0,0:45:35.84,0:45:36.84,نص عام,,0,0,0,,إنه مشغول
Dialogue: 0,0:45:37.60,0:45:39.22,خط مائل,,0,0,0,,السيد لي
Dialogue: 0,0:45:39.31,0:45:41.18,نص عام,,0,0,0,,سيد لي، ألقِ نظرة
Dialogue: 0,0:45:41.27,0:45:43.35,النص العام,,0,0,0,,هذه أفضل صنارة صيد، فهي مصنوعة من الخيزران...
Dialogue: 0,0:45:43.43,0:45:45.98,النص العام,,0,0,0,,إنه ليس مشغولاً، ابتداءً من الغد
Dialogue: 0,0:45:46.06,0:45:48.94,النص العام,,0,0,0,,سيصطاد معك
Dialogue: 0,0:45:50.48,0:45:52.49,نص عام,,0,0,0,,ما الذي تتحدث عنه؟ انا بحاجة للتدريب
Dialogue: 0,0:45:52.57,0:45:55.86,general text,,0,0,0,,الآن لا ينبغي أن تمسك سيفًا، بل صنارة صيد
Dialogue: 0,0:45:57.16,0:46:00.24,النص العام,,0,0,0,,اذهب إلى بحيرة جيونج تشونج دايهو واصطاد السمكة الذهبية
Dialogue: 0,0:46:00.91,0:46:02.08,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:46:14.63,0:46:16.09,نص عام,,0,0,0,,يبدو أنه مكان جيد
Dialogue: 0,0:46:16.72,0:46:18.14,نص عام,,0,0,0,,لا لا يا سيد لي
Dialogue: 0,0:46:18.84,0:46:22.52,نص عام,,0,0,0,,كنت أصطاد هنا. الماء بارد جداً
Dialogue: 0,0:46:22.60,0:46:25.35,مائل,,0,0,0,,لا توجد أسماك هنا لأنه ليس لديهم ما يأكلونه
Dialogue: 0,0:46:25.89,0:46:28.90,النص العام,,0,0,0,,وأخذنا صنارات صيد سيئة
Dialogue: 0,0:46:28.98,0:46:32.40,general text,,0,0,0,,يجب اصطياد السمكة الذهبية بصنارة صيد تنحني بسهولة
Dialogue: 0,0:46:33.40,0:46:34.99,نص عام,,0,0,0,,تمامًا هكذا
Dialogue: 0,0:46:36.65,0:46:38.86,النص العام,,0,0,0,,هل هذا طُعم للأسماك؟
Dialogue: 0,0:46:39.45,0:46:40.62,نص عام,,0,0,0,,هذه حلويات
Dialogue: 0,0:46:40.70,0:46:44.12,general text,,0,0,0,,جمعتهم البكر كيم للسيد لي
Dialogue: 0,0:46:44.83,0:46:47.75,نص عام,,0,0,0,,الخادمة كيم امرأة لطيفة جداً
Dialogue: 0,0:46:48.33,0:46:50.25,نص عام,,0,0,0,,أين الطعم؟
Dialogue: 0,0:46:50.33,0:46:52.42,نص عام,,0,0,0,,نحتاج إلى ديدان أو أسماك صغيرة
Dialogue: 0,0:46:52.50,0:46:53.92,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,0:46:55.63,0:46:57.68,النص العام,,0,0,0,,هل تصطاد بدون طعم؟
Dialogue: 0,0:46:57.76,0:47:01.05,النص العام,,0,0,0,,لقد أخبرتك أن السمكة الذهبية تتغذى على الطاقة
Dialogue: 0,0:47:01.80,0:47:04.47,خط مائل,,0,0,0,,طاقتي ستذهب على طول عصا الخيزران
Dialogue: 0,0:47:05.10,0:47:07.02,نص عام,,0,0,0,,وسيكون بمثابة طعم
Dialogue: 0,0:47:08.60,0:47:09.60,نص عام,,0,0,0,,طاقتك؟
Dialogue: 0,0:47:10.69,0:47:13.77,نص عام,,0,0,0,,سيدة، كرر بعد السيد
Dialogue: 0,0:47:14.36,0:47:15.36,نص عام,,0,0,0,,الآن
Dialogue: 0,0:47:22.32,0:47:26.37,نص عام,,0,0,0,,الآن كل ما تحتاجه هو التحكم في طاقة البحيرة
Dialogue: 0,0:47:26.45,0:47:28.66,النص العام,,0,0,0,,وانتظر حتى تعض السمكة الذهبية
Dialogue: 0,0:47:36.17,0:47:37.26,نص عام,,0,0,0,,مو دوك
Dialogue: 0,0:47:37.84,0:47:40.93,نص عام,,0,0,0,,أشعر وكأنني أحمق. هل يجب علي الاستمرار؟
Dialogue: 0,0:47:48.56,0:47:49.52,نص عام,,0,0,0,,منقر!
Dialogue: 0,0:48:00.65,0:48:02.36,نص عام,,0,0,0,,هذه هي السمكة الذهبية
Dialogue: 0,0:48:03.03,0:48:06.66,النص العام,,0,0,0,,هذه جلطة من الماء تتشكل من طاقة البحيرة
Dialogue: 0,0:48:07.33,0:48:10.58,general text,,0,0,0,,فقط أولئك الذين أتقنوا تشيسو أو أعلى هم القادرون على التحكم في المياه،
Dialogue: 0,0:48:10.66,0:48:12.33,نص عام,,0,0,0,,يمكن الإمساك بها
Dialogue: 0,0:48:15.04,0:48:16.46,خط مائل,,0,0,0,,لم أصطاد منذ فترة طويلة
Dialogue: 0,0:48:16.55,0:48:19.84,general text,,0,0,0,,ولكن يجب أن أعترف أنه لا يزال من المثير اصطياد سمكة ذهبية
Dialogue: 0,0:48:22.13,0:48:24.68,general text,,0,0,0,,إذًا هذه ليست سمكة حقيقية؟
Dialogue: 0,0:48:25.26,0:48:27.56,النص العام,,0,0,0,,لم يحضرك السيد "لي" إلى هنا لتصطاد السمك
Dialogue: 0,0:48:28.27,0:48:31.31,general text,,0,0,0,,إنه هنا لمساعدتك في إتقان تشيسو
Dialogue: 0,0:48:32.23,0:48:33.56,مائل,,0,0,0,,فقط من يملك القوة،
Dialogue: 0,0:48:33.65,0:48:36.52,خط مائل,,0,0,0,,يمكن التقاط كتلة من الطاقة من بحيرة جيونج تشونج دايهو
Dialogue: 0,0:48:37.61,0:48:39.36,نص عام,,0,0,0,,والمعلم تشيسو
Dialogue: 0,0:48:41.15,0:48:42.45,نص عام,,0,0,0,,شيسو؟
Dialogue: 0,0:48:50.91,0:48:53.21,نص عام,,0,0,0,,بطيء
Dialogue: 0,0:48:53.29,0:48:54.17,نص عام,,0,0,0,,بطيء
Dialogue: 0,0:48:54.25,0:48:57.25,النص العام,,0,0,0,,لا، أنت في عجلة من أمرك. ببطء
Dialogue: 0,0:48:57.96,0:48:59.46,نص عام,,0,0,0,,- بطيء\N- لا
Dialogue: 0,0:49:12.52,0:49:14.73,general text,,0,0,0,,لا بد أن جيونبوغوان وجد فتاة عمياء أخرى
Dialogue: 0,0:49:14.81,0:49:17.23,general text,,0,0,0,,يقول تشو يونغ إنهم يجلبون فتيات عمياء
Dialogue: 0,0:49:17.31,0:49:19.19,نص عام,,0,0,0,,من جميع أنحاء البلاد كل يوم
Dialogue: 0,0:49:21.78,0:49:23.65,نص عام,,0,0,0,,- هيا بنا\N- نعم
Dialogue: 0,0:49:36.08,0:49:38.13,خط مائل,,0,0,0,,إذاً أنت تقول،
Dialogue: 0,0:49:38.21,0:49:41.09,نص عام,,0,0,0,,ربما يوجد بدو في كل عائلة،
Dialogue: 0,0:49:41.17,0:49:43.22,النص العام,,0,0,0,,الذي شارك في مقتل والد ناك سو،
Dialogue: 0,0:49:43.30,0:49:45.30,النص الرئيسي,,0,0,0,,وعلينا استخدام مقطع جينيفون,
Dialogue: 0,0:49:46.34,0:49:47.51,نص عام,,0,0,0,,للعثور عليهم؟
Dialogue: 0,0:49:47.60,0:49:49.81,النص العام,,0,0,0,,كنا سننتظر حتى البدو،
Dialogue: 0,0:49:49.89,0:49:52.31,النص العام,,0,0,0,,من ديغانتونغون سيعود إلى وعيه،
Dialogue: 0,0:49:52.39,0:49:54.19,نص عام,,0,0,0,,لكن لا يمكننا الانتظار أكثر
Dialogue: 0,0:49:54.27,0:49:55.69,نص عام,,0,0,0,,الحقيقة هي أن
Dialogue: 0,0:49:56.60,0:49:58.77,نص عام,,0,0,0,,عثرنا الليلة الماضية على واحد آخر
Dialogue: 0,0:50:00.02,0:50:01.36,نص عام,,0,0,0,,سمعت
Dialogue: 0,0:50:01.44,0:50:05.03,general text,,0,0,0,,تم العثور على بدوي كان خصيًا في تشونبوغوان
Dialogue: 0,0:50:05.11,0:50:08.41,النص العام,,0,0,0,,لا بد أن جين مو قد زارك بالفعل
Dialogue: 0,0:50:09.37,0:50:13.87,general text,,0,0,0,,قال أخي جين مو أن سوسنوفي بور أرسل لصًا إلى جيونبوغوان،
Dialogue: 0,0:50:14.50,0:50:17.75,النص العام,,0,0,0,,الذي حاول الإيقاع به. لقد كان مستاءً للغاية
Dialogue: 0,0:50:17.83,0:50:20.96,general text,,0,0,0,,لمعرفة ما إذا كان جين مو مذنبًا أم لا،
Dialogue: 0,0:50:21.67,0:50:25.67,النص العام,,0,0,0,,نحن بحاجة إلى آثار وقوى رأس جينيوون
Dialogue: 0,0:50:25.76,0:50:27.09,نص عام,,0,0,0,,ساعدونا
Dialogue: 0,0:50:28.89,0:50:29.93,نص عام,,0,0,0,,عذراً,
Dialogue: 0,0:50:31.43,0:50:32.81,نص عام,,0,0,0,,لكنني أرفض
Dialogue: 0,0:50:34.81,0:50:38.56,general text,,0,0,0,,ليس هناك شيء أكثر عارًا على الساحر من اتهامه باستخدام السحر الأسود
Dialogue: 0,0:50:39.40,0:50:40.86,نص عام,,0,0,0,,إذا كنا
Dialogue: 0,0:50:40.94,0:50:45.19,مائل,,0,0,0,,اختبر السحرة بآثارهم دون أي دليل،
Dialogue: 0,0:50:46.15,0:50:48.91,النص العام,,0,0,0,,سنجعل الناس يكرهون جينيوون فقط
Dialogue: 0,0:50:48.99,0:50:50.32,نص عام,,0,0,0,,سمعت، جين مو
Dialogue: 0,0:50:51.20,0:50:53.91,نص عام,,0,0,0,,تبحث عن ابنتك الكبرى
Dialogue: 0,0:50:54.83,0:50:58.17,general text,,0,0,0,,طلب منك عدم مساعدة سوسنوفي بور
Dialogue: 0,0:50:58.67,0:51:00.92,general text,,0,0,0,,مقابل المساعدة في العثور على ابنتك؟
Dialogue: 0,0:51:01.50,0:51:03.38,general text,,0,0,0,,- هذا ليس له علاقة...{\i1}\N- لا، إنه كذلك.
Dialogue: 0,0:51:03.46,0:51:07.97,general text,,0,0,0,,سلوكك تجاه سوسنوفي بور تغير فجأة
Dialogue: 0,0:51:08.05,0:51:11.51,general text,,0,0,0,,هل تريدني أن أفعل دائمًا ما تطلبه؟
Dialogue: 0,0:51:11.60,0:51:12.97,general text,,0,0,0,,هل هذا هو السلوك الذي تتوقعه؟
Dialogue: 0,0:51:14.39,0:51:18.31,النص العام,,0,0,0,,جينيونغ وون لا يطيع
Dialogue: 0,0:51:18.39,0:51:19.90,نص عام,,0,0,0,,سوسنوفوي بور
Dialogue: 0,0:51:19.98,0:51:21.81,النص العام,,0,0,0,,- الفصل جين!\N- اترك
Dialogue: 0,0:51:22.40,0:51:25.48,نص عام,,0,0,0,,لدي موعد
Dialogue: 0,0:51:36.29,0:51:39.25,general text,,0,0,0,,عندما يجدون أختك الكبرى،
Dialogue: 0,0:51:39.33,0:51:42.75,general text,,0,0,0,,لن يكون هناك بعد الآن أي عوائق أمام حبنا
Dialogue: 0,0:51:42.84,0:51:46.17,general text,,0,0,0,,لأن سوسنوفي بور وجينيفون تربطهما علاقات جيدة
Dialogue: 0,0:51:46.76,0:51:48.01,نص عام,,0,0,0,,أوه بالضبط...
Dialogue: 0,0:51:50.59,0:51:51.72,نص عام,,0,0,0,,هنا
Dialogue: 0,0:51:53.22,0:51:55.81,نص عام,,0,0,0,,هذه هي الزخرفة التي أعجبتني المرة الماضية
Dialogue: 0,0:51:56.47,0:51:58.77,النص العام,,0,0,0,,لقد تمكن شخص ما بالفعل من شرائه
Dialogue: 0,0:51:58.85,0:52:00.44,نص عام,,0,0,0,,كيف حصلت عليه؟
Dialogue: 0,0:52:00.52,0:52:03.61,النص العام,,0,0,0,,دفعت لذلك الشخص أربعة أضعاف المبلغ
Dialogue: 0,0:52:03.69,0:52:05.40,نص عام,,0,0,0,,أعتقد أنه سيعجبك
Dialogue: 0,0:52:05.48,0:52:07.57,نص عام,,0,0,0,,أعجبني حقًا
Dialogue: 0,0:52:08.49,0:52:11.24,نص عام,,0,0,0,,ابتسامتك السعيدة
Dialogue: 0,0:52:11.32,0:52:15.03,نص عام,,0,0,0,,يجعلني أسعد شخص في العالم
Dialogue: 0,0:52:26.13,0:52:28.05,general text,,0,0,0,,لماذا يبدو عمك منزعجًا جدًا؟
Dialogue: 0,0:52:28.13,0:52:29.47,نص عام,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:52:30.51,0:52:33.14,النص العام,,0,0,0,,أعتقد أنه خاض معركة كبيرة مع رأس جينيوون
Dialogue: 0,0:52:52.95,0:52:55.32,general text,,0,0,0,,رسمت شامة حمراء داكنة خلف أذنها
Dialogue: 0,0:52:56.99,0:53:01.08,general text,,0,0,0,,سقط بو يونغ عندما كان طفلاً. لديها ندبة على ذراعها اليسرى
Dialogue: 0,0:53:03.58,0:53:06.04,نص عام,,0,0,0,,حوالي ثلث إصبع طويل
Dialogue: 0,0:53:38.41,0:53:41.58,general text,,0,0,0,,من الضروري أن تصبح جين بو يونغ، اصبر.
Dialogue: 0,0:53:42.66,0:53:44.50,النص العام,,0,0,0,,كل ندبة، كل شامة...
Dialogue: 0,0:53:44.58,0:53:47.75,نص عام,,0,0,0,,أي شيء صغير يمكن أن تتذكره والدتها
Dialogue: 0,0:53:49.67,0:53:50.75,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:53:50.84,0:53:54.38,general text,,0,0,0,,سأسكب حمضًا على بشرتك لجعل الندبة أكثر وضوحًا.
Dialogue: 0,0:54:38.09,0:54:41.51,general text,,0,0,0,,ما نوع السمك الذي يحاول السيد تشان الشاب اصطياده؟
Dialogue: 0,0:54:41.60,0:54:43.35,النص العام,,0,0,0,,كل ما يفعله هو الذهاب إلى البحيرة
Dialogue: 0,0:54:43.93,0:54:46.48,نص عام,,0,0,0,,أريد أن آخذ لهم الطعام
Dialogue: 0,0:54:46.56,0:54:48.56,نص عام,,0,0,0,,سأطلب من الخادم "لي" أن يحملني
Dialogue: 0,0:54:48.65,0:54:50.77,نص عام,,0,0,0,,وأنت تبقى وتساعدني
Dialogue: 0,0:54:52.61,0:54:56.53,نص عام,,0,0,0,,نحن بحاجة إلى تنظيف المنزل وإعداد الطعام لحفل التأبين
Dialogue: 0,0:54:58.03,0:54:59.28,نص عام,,0,0,0,,لمن؟
Dialogue: 0,0:54:59.36,0:55:01.58,نص عام,,0,0,0,,فتاة صغيرة ماتت موتاً رهيباً
Dialogue: 0,0:55:02.08,0:55:04.33,general text,,0,0,0,,لقد أهانتها عائلتنا،
Dialogue: 0,0:55:04.41,0:55:06.41,نص عام,,0,0,0,,لذا أريد أن أحييها
Dialogue: 0,0:55:07.96,0:55:09.29,خط مائل,,0,0,0,,عذراء كيم
Dialogue: 0,0:55:09.37,0:55:10.88,نص عام,,0,0,0,,لقد عدت من المعبد
Dialogue: 0,0:55:10.96,0:55:12.13,نص عام,,0,0,0,,- حسنًا\N- هنا
Dialogue: 0,0:55:12.21,0:55:14.55,نص عام,,0,0,0,,كتب راهب بوذي خطابًا
Dialogue: 0,0:55:15.88,0:55:17.59,نص عام,,0,0,0,,ما أروع الكلام
Dialogue: 0,0:55:18.68,0:55:20.30,نص عام,,0,0,0,,ولكن أين أسمائهم؟
Dialogue: 0,0:55:20.39,0:55:22.55,نص عام,,0,0,0,,كان يجب أن أكتب أسماء الأرواح
Dialogue: 0,0:55:22.64,0:55:23.93,خط مائل,,0,0,0,,ها هم
Dialogue: 0,0:55:24.01,0:55:26.81,نص عام,,0,0,0,,هنا. تشو تشون وتشو يونغ
Dialogue: 0,0:55:28.14,0:55:30.35,خلف الكواليس,,0,0,0,,تشو يونغ؟ هذا هو اسمي
Dialogue: 0,0:55:30.94,0:55:32.94,مائل,,0,0,0,,آه، هذا كل شيء. الآن أرى
Dialogue: 0,0:55:33.02,0:55:34.57,نص عام,,0,0,0,,تشو تشون وتشو يونغ
Dialogue: 0,0:55:35.98,0:55:37.32,خط مائل,,0,0,0,,خطاب رائع
Dialogue: 0,0:55:37.40,0:55:39.78,نص عام,,0,0,0,,الخادم لي، تعال معي
Dialogue: 0,0:55:40.32,0:55:41.91,نص عام,,0,0,0,,أحضر الطعام إلى السيد
Dialogue: 0,0:55:41.99,0:55:43.12,خط مائل,,0,0,0,,نعم بالطبع
Dialogue: 0,0:55:44.62,0:55:46.70,خلف الكواليس,,0,0,0,,العذراء كيم تقيم مراسم العزاء
Dialogue: 0,0:55:47.54,0:55:49.62,خلف الكواليس,,0,0,0,,عنّي وعن والدي؟
Dialogue: 0,0:56:28.16,0:56:30.54,النص العام,,0,0,0,,لقد أحضروا لنا الأرز مع الفطر. المفضل لدي
Dialogue: 0,0:56:30.62,0:56:33.88,نص عام,,0,0,0,,الخادمة كيم طباخة ماهرة
Dialogue: 0,0:56:41.09,0:56:42.51,نص عام,,0,0,0,,مكاييل! أمسكت به!
Dialogue: 0,0:56:53.02,0:56:55.48,نص عام,,0,0,0,,لقد ربطت دودة. لقد وقعت في حبه
Dialogue: 0,0:56:56.65,0:56:58.23,نص عام,,0,0,0,,يمكننا أن نأكلها
Dialogue: 0,0:57:03.78,0:57:05.16,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:57:23.01,0:57:24.01,نص عام,,0,0,0,,انتظر
Dialogue: 0,0:57:29.93,0:57:31.64,نص عام,,0,0,0,,خذ وقتك
Dialogue: 0,0:57:33.23,0:57:35.81,النص العام,,0,0,0,,يومًا ما ستشعر بهذا الشعور،
Dialogue: 0,0:57:35.90,0:57:38.27,نص عام,,0,0,0,,عندما تعض السمكة الذهبية
Dialogue: 0,0:57:38.36,0:57:41.94,general text,,0,0,0,,سيكون هذا تشيسو - القدرة على التحكم في الطاقة
Dialogue: 0,0:57:43.65,0:57:44.66,نص عام,,0,0,0,,أرى
Dialogue: 0,0:57:45.74,0:57:48.70,general text,,0,0,0,,سيد لي، لقد علمتني قراءة "كلمات القلب"
Dialogue: 0,0:57:49.41,0:57:51.70,general text,,0,0,0,,لماذا تستمر في مساعدتي؟
Dialogue: 0,0:57:52.96,0:57:55.83,النص العام,,0,0,0,,صدفة بلا سبب,
Dialogue: 0,0:57:56.33,0:57:59.38,نص عام,,0,0,0,,ما الذي يجب أن يبقى سراً؟
Dialogue: 0,0:58:01.30,0:58:02.76,نص عام,,0,0,0,,هذا ليس من شأنك
Dialogue: 0,0:58:02.84,0:58:04.51,نص عام,,0,0,0,,هل ظننت أنني لن أعرف ذلك؟
Dialogue: 0,0:58:07.05,0:58:08.51,نص عام,,0,0,0,,هذا يتعلق بعائلتي
Dialogue: 0,0:58:13.52,0:58:15.10,نص عام,,0,0,0,,إنه بسبب الخادمة كيم، أليس كذلك؟
Dialogue: 0,0:58:17.02,0:58:20.32,نص عام,,0,0,0,,أنت تمطرها باستمرار بالمجاملات
Dialogue: 0,0:58:20.40,0:58:22.73,النص العام,,0,0,0,,وأنت أيضًا لديك وشاح حول رقبتك...
Dialogue: 0,0:58:22.82,0:58:25.11,نص عام,,0,0,0,,إنه من المتجر الذي تذهب إليه
Dialogue: 0,0:58:26.15,0:58:27.36,النص العام,,0,0,0,,هذه هديتها، أليس كذلك؟
Dialogue: 0,0:58:28.41,0:58:29.62,نص عام,,0,0,0,,والأهم من ذلك،
Dialogue: 0,0:58:29.70,0:58:33.41,نص عام,,0,0,0,,رأيت الزهور البرية المجففة في غرفة الخادمة كيم
Dialogue: 0,0:58:33.50,0:58:35.75,نص عام,,0,0,0,,دانهيانجوك مليء بهم
Dialogue: 0,0:58:35.83,0:58:37.37,النص العام,,0,0,0,,وهذه هديتك، أليس كذلك؟
Dialogue: 0,0:58:38.96,0:58:41.59,النص العام,,0,0,0,,- نعم هذا صحيح\N- هذا ما كنت أعرفه
Dialogue: 0,0:58:42.92,0:58:44.97,النص العام,,0,0,0,,لكنك تمارس العفة...
Dialogue: 0,0:58:45.05,0:58:48.30,general text,,0,0,0,,ليس لدي "تلك" المشاعر تجاهها!
Dialogue: 0,0:58:48.89,0:58:51.51,النص العام,,0,0,0,,أعتقد أنها جميلة وطيبة القلب.
Dialogue: 0,0:58:51.60,0:58:53.02,نص عام,,0,0,0,,هذا كل شيء
Dialogue: 0,0:58:53.56,0:58:56.60,general text,,0,0,0,,إنه نفس الاعتراف بمشاعرك تجاهها
Dialogue: 0,0:58:56.69,0:58:58.73,general text,,0,0,0,,العلاقات بين الرجل والمرأة دائماً "هكذا"
Dialogue: 0,0:58:59.31,0:59:00.19,نص عام,,0,0,0,,وماذا عن نفسك؟
Dialogue: 0,0:59:00.86,0:59:03.90,general text,,0,0,0,,أنت رجل، ومو دوك امرأة. ماذا بينكما؟
Dialogue: 0,0:59:05.90,0:59:07.49,نص عام,,0,0,0,,أما أنا...
Dialogue: 0,0:59:09.11,0:59:10.28,نص عام,,0,0,0,,أنا أحبها
Dialogue: 0,0:59:15.75,0:59:18.71,general text,,0,0,0,,لا أستطيع أن أصدق أنني أقول هذا لشخص يمارس العفة
Dialogue: 0,0:59:18.79,0:59:22.25,general text,,0,0,0,,فقط الخادمة كيم معجبة بشخص ما بالفعل
Dialogue: 0,0:59:22.34,0:59:23.71,نص عام,,0,0,0,,أتمنى ألا أجرح مشاعرك
Dialogue: 0,0:59:23.80,0:59:25.38,نص عام,,0,0,0,,وأنا أيضاً يجب أن أقول
Dialogue: 0,0:59:26.21,0:59:28.84,general text,,0,0,0,,سمعت أن مو دوك يحب يول
Dialogue: 0,0:59:28.93,0:59:31.51,نص عام,,0,0,0,,أخبرك دان جو بهذا؟ أي نوع من الحديث هذا الدنيوي؟
Dialogue: 0,0:59:31.60,0:59:33.51,نص عام,,0,0,0,,أنا لا أعبث معك هنا فحسب
Dialogue: 0,0:59:35.64,0:59:37.31,نص عام,,0,0,0,,أدركت أن المحادثات الدنيوية...
Dialogue: 0,0:59:38.14,0:59:40.02,نص عام,,0,0,0,,مفيد في بعض الأحيان
Dialogue: 0,0:59:42.15,0:59:44.23,النص العام,,0,0,0,,شكرًا لقصة حب جوليا الأول،
Dialogue: 0,0:59:44.32,0:59:47.24,general text,,0,0,0,,لقد تمكنت من التعرف على القاتل ناك سو.
Dialogue: 0,0:59:50.24,0:59:53.24,نص عام,,0,0,0,,الفتاة التي التقى بها في دانهيانغوك،
Dialogue: 0,0:59:54.33,0:59:55.70,نص عام,,0,0,0,,تبين أنه ناك سو
Dialogue: 0,0:59:56.83,0:59:58.29,general text,,0,0,0,,أدرك أنها هي...
Dialogue: 0,0:59:58.37,1:00:01.08,النص العام,,0,0,0,,بسبب الصافرة التي أُعطيت له. كان يرقد بجانب جسدها
Dialogue: 0,1:00:03.29,1:00:07.34,نص عام,,0,0,0,,أعلم أنك سمعت محادثتي مع جين في سيجوكون
Dialogue: 0,1:00:10.09,1:00:12.72,نص عام,,0,0,0,,إذن أنت نفسك تعرف تاريخ ناك سو
Dialogue: 0,1:00:16.52,1:00:18.39,نص عام,,0,0,0,,عد إلى المنزل مبكرًا اليوم
Dialogue: 0,1:00:19.35,1:00:20.94,نص عام,,0,0,0,,العذراء كيم تقيم حفل عزاء...
Dialogue: 0,1:00:21.73,1:00:25.11,نص عام,,0,0,0,,عن فتاة صغيرة ماتت ميتة رهيبة
Dialogue: 0,1:00:41.58,1:00:42.96,نص عام,,0,0,0,,هذا كل شيء
Dialogue: 0,1:00:43.54,1:00:44.88,نص عام,,0,0,0,,تم تركيب وعاء الأبراج
Dialogue: 0,1:00:44.96,1:00:47.92,نص عام,,0,0,0,,أعد خدمك إلى سوسنوفي بور
Dialogue: 0,1:00:48.00,1:00:51.13,نص عام,,0,0,0,,لا، لست مثاليًا بعد
Dialogue: 0,1:00:51.22,1:00:52.68,نص عام,,0,0,0,,نحن نحب كل شيء
Dialogue: 0,1:00:52.76,1:00:54.01,نص عام,,0,0,0,,ما رأيك؟
Dialogue: 0,1:00:54.09,1:00:55.47,نص عام,,0,0,0,,فقط ألقِ نظرة
Dialogue: 0,1:00:55.55,1:00:59.35,نص عام,,0,0,0,,ألوان الوعاء والساق مختلفة
Dialogue: 0,1:00:59.93,1:01:01.98,نص عام,,0,0,0,,نحن بحاجة إلى تغيير الساق
Dialogue: 0,1:01:02.06,1:01:04.10,نص عام,,0,0,0,,لقد قمنا بالفعل بتغييره عدة مرات
Dialogue: 0,1:01:04.60,1:01:05.94,نص عام,,0,0,0,,نحن نحب كل شيء
Dialogue: 0,1:01:06.02,1:01:07.44,نص عام,,0,0,0,,وعد رئيس سوسنوفي بور،
Dialogue: 0,1:01:07.52,1:01:10.40,نص عام,,0,0,0,,الذي سيعيد كل شيء كما كان
Dialogue: 0,1:01:10.99,1:01:12.78,نص عام,,0,0,0,,يجب عدم ارتكاب الأخطاء
Dialogue: 0,1:01:14.28,1:01:16.87,نص عام,,0,0,0,,عادة لا يستغرق الأمر أكثر من يومين
Dialogue: 0,1:01:17.58,1:01:19.20,نص عام,,0,0,0,,ولكن هذه المرة تأخر كل شيء بطريقة ما
Dialogue: 0,1:01:19.29,1:01:21.66,نص عام,,0,0,0,,ألا تحب أن نأتي إلى هنا؟
Dialogue: 0,1:01:21.75,1:01:23.67,نص عام,,0,0,0,,لماذا يكون هذا؟
Dialogue: 0,1:01:23.75,1:01:28.38,النص العام,,0,0,0,,أعتقد فقط أن سوسنوفي بور يهدر الوقت والمال
Dialogue: 0,1:01:32.22,1:01:35.43,نص عام,,0,0,0,,لا تقلق بشأن أموال سوسنوفي بور
Dialogue: 0,1:01:37.68,1:01:40.39,general text,,0,0,0,,يول، آخر مرة التقينا فيها لاحظت مهاراتك
Dialogue: 0,1:01:40.47,1:01:42.14,مائل,,0,0,0,,هل أتقنت تشيسو بالفعل؟
Dialogue: 0,1:01:43.98,1:01:45.06,نص عام,,0,0,0,,نعم
Dialogue: 0,1:01:46.15,1:01:48.40,general text,,0,0,0,,اتضح أنك الساحر الأول لجونججينجاك،
Dialogue: 0,1:01:48.48,1:01:50.65,نص عام,,0,0,0,,ممسوس شيسو
Dialogue: 0,1:01:51.28,1:01:54.32,نص عام,,0,0,0,,كل شيء مثل والدي. لا بد وأن Seo Il فخور جدًا بك
Dialogue: 0,1:01:55.32,1:01:57.07,general text,,0,0,0,,هل هو ساحر جيونجينغاك؟
Dialogue: 0,1:01:58.74,1:02:00.79,ذكريات بخط مائل,,0,0,0,,لا يمكنك جر إنسان رغماً عنه
Dialogue: 0,1:02:06.25,1:02:07.92,ذكريات,,0,0,0,,هل تستطيع الوقوف؟
Dialogue: 0,1:02:10.17,1:02:11.30,خط مائل,,0,0,0,,إلى ماذا تنظر؟
Dialogue: 0,1:02:14.55,1:02:16.64,general text,,0,0,0,,هل هو ساحر جيونجينغاك؟
Dialogue: 0,1:02:16.72,1:02:19.18,النص العام,,0,0,0,,- اسمه سيو يول؟\N- نعم
Dialogue: 0,1:02:19.26,1:02:21.93,general text,,0,0,0,,هم أبناء عائلات نبيلة، التوت ليس من حقلك
Dialogue: 0,1:02:22.52,1:02:24.43,نص عام,,0,0,0,,توقف عن التجول هنا، واجلس بهدوء
Dialogue: 0,1:02:30.90,1:02:33.78,general text,,0,0,0,,ربما يكون اللص فلا نظير له
Dialogue: 0,1:02:37.03,1:02:39.95,general text,,0,0,0,,ولكن بمجرد أن أصبح جين بو يونغ، رئيس جينيونغ المستقبلي،
Dialogue: 0,1:02:41.62,1:02:43.16,نص عام,,0,0,0,,كل شيء يمكن أن يتغير
Dialogue: 0,1:02:51.92,1:02:54.63,نص عام,,0,0,0,,هذا لصديق السيد تشان وابنته
Dialogue: 0,1:02:56.97,1:02:58.72,مائل,,0,0,0,,لم يتم دفن جثثهم،
Dialogue: 0,1:02:59.72,1:03:02.22,خط مائل,,0,0,0,,وقلما يتذكرهم أحد
Dialogue: 0,1:03:02.97,1:03:04.81,نص عام,,0,0,0,,لذلك سأقيم خدمة واحدة على الأقل
Dialogue: 0,1:03:06.73,1:03:07.85,نص عام,,0,0,0,,العذراء كيم
Dialogue: 0,1:03:10.73,1:03:11.98,نص عام,,0,0,0,,شكرًا لك
Dialogue: 0,1:03:13.02,1:03:14.32,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:03:16.44,1:03:17.90,نص عام,,0,0,0,,سيكونون ممتنين لك جدًا
Dialogue: 0,1:03:18.99,1:03:21.41,نص عام,,0,0,0,,أنا متأكد من أنهم ممتنون للغاية
Dialogue: 0,1:03:23.12,1:03:24.79,نص عام,,0,0,0,,سعيد لسماع ذلك
Dialogue: 0,1:03:26.41,1:03:28.75,نص عام,,0,0,0,,لا تطفئ أعواد البخور حتى تحترق
Dialogue: 0,1:03:56.69,1:03:58.90,نقوش,,0,0,0,,تشو تشون، تشو يونغ
Dialogue: 0,1:04:15.50,1:04:19.47,تعليقات توضيحية,,0,0,0,,تشو تشون، تشو يونغ
Dialogue: 0,1:04:27.60,1:04:28.81,نص عام,,0,0,0,,أبي...
Dialogue: 0,1:04:41.15,1:04:43.28,نص عام,,0,0,0,,سيد. ذهب تشان للصيد
Dialogue: 0,1:04:43.37,1:04:46.08,نص عام,,0,0,0,,سيعود قريبًا، يمكنك الانتظار بالداخل
Dialogue: 0,1:04:47.58,1:04:49.41,general text,,0,0,0,,ذهب مو دوك معه؟
Dialogue: 0,1:04:49.50,1:04:51.71,نص عام,,0,0,0,,لا، إنها في المنزل
Dialogue: 0,1:04:51.79,1:04:53.33,نص عام,,0,0,0,,ساعدت في الاستيقاظ
Dialogue: 0,1:05:07.81,1:05:10.23,تعليقات توضيحية,,0,0,0,,تشو تشون، تشو يونغ
Dialogue: 0,1:05:12.81,1:05:14.15,خارج الشاشة,,0,0,0,,لو لم أتركك...
Dialogue: 0,1:05:15.48,1:05:17.07,خلف الكواليس,,0,0,0,,وحدي في الجبال،
Dialogue: 0,1:05:20.90,1:05:25.03,خلف الكواليس,,0,0,0,,لن تضطر إلى حبس دموعك الآن
Dialogue: 0,1:05:25.87,1:05:28.24,خارج الشاشة,,0,0,0,,وتظاهر بأنك شخص آخر
Dialogue: 0,1:05:33.58,1:05:35.17,خلف الكواليس,,0,0,0,,لكن حتى الآن،
Dialogue: 0,1:05:37.17,1:05:39.63,خارج الإطار,,0,0,0,,لا أستطيع الاقتراب...
Dialogue: 0,1:05:40.59,1:05:42.63,التعليق الصوتي,,0,0,0,,وأخبرك أنني أعرف من أنت
Dialogue: 0,1:05:55.69,1:05:57.31,تعليقات توضيحية,,0,0,0,,تشو تشون، تشو يونغ
Dialogue: 0,1:06:03.40,1:06:04.65,نص عام,,0,0,0,,هل احترقت العصي؟
Dialogue: 0,1:06:06.28,1:06:07.32,نص عام,,0,0,0,,نعم
Dialogue: 0,1:06:07.99,1:06:09.03,نص عام,,0,0,0,,محترقة
Dialogue: 0,1:06:09.62,1:06:10.54,نص عام,,0,0,0,,هل كنت تجلس هنا؟
Dialogue: 0,1:06:14.04,1:06:15.37,نص عام,,0,0,0,,دعونا ننظف كل شيء
Dialogue: 0,1:06:55.29,1:06:58.21,نص عام,,0,0,0,,متى عدت؟ سمعت أنك ذهبت لصيد الأسماك
Dialogue: 0,1:06:58.29,1:07:00.34,نص عام,,0,0,0,,نعم لقد عدت للتو
Dialogue: 0,1:07:00.42,1:07:01.75,نص عام,,0,0,0,,هل أنت وحدك؟ أين دان جو؟
Dialogue: 0,1:07:01.84,1:07:04.59,النص العام,,0,0,0,,لديه شيء ليفعله. أعتقد أنه يواعد شخصًا ما
Dialogue: 0,1:07:04.67,1:07:05.92,نص عام,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,1:07:07.18,1:07:08.43,نص عام,,0,0,0,,لماذا أتيت؟
Dialogue: 0,1:07:08.51,1:07:11.51,نص عام,,0,0,0,,قال الرئيس أنه يمكنك العودة
Dialogue: 0,1:07:12.10,1:07:14.52,نص عام,,0,0,0,,أسرع مما ظننت
Dialogue: 0,1:07:15.48,1:07:18.69,نص عام,,0,0,0,,اجلس وتناول مشروبًا. ما زلت بحاجة للتحدث معك
Dialogue: 0,1:07:18.77,1:07:20.40,نص عام,,0,0,0,,لا أستطيع، آسف
Dialogue: 0,1:07:21.15,1:07:23.69,general text,,0,0,0,,- أريد العودة إلى سوسنوفي بور\N- نعم؟
Dialogue: 0,1:07:23.78,1:07:26.90,نص عام,,0,0,0,,ثم سنتحدث لاحقًا، في جيونجينجاك
Dialogue: 0,1:07:27.45,1:07:29.16,نص عام,,0,0,0,,سوف تتفاجأ جدًا
Dialogue: 0,1:07:30.82,1:07:34.41,نص عام,,0,0,0,,المملكة المتحدة، سأعود إلى قلعة سوهو قريبًا
Dialogue: 0,1:07:36.16,1:07:38.04,النص العام,,0,0,0,,لقد وعدت والدي بأنني سأبقى في جيونجينغاك
Dialogue: 0,1:07:38.12,1:07:40.71,نص عام,,0,0,0,,حتى أتقن تشيسو
Dialogue: 0,1:07:41.42,1:07:43.88,general text,,0,0,0,,كتب السيد هو رسالة إلى والده،
Dialogue: 0,1:07:43.96,1:07:45.84,نص عام,,0,0,0,,قريباً سيطلب مني العودة
Dialogue: 0,1:07:46.42,1:07:47.51,نص عام,,0,0,0,,إذن سأضطر للمغادرة
Dialogue: 0,1:07:47.59,1:07:49.18,النص العام,,0,0,0,,لكن قلعة سوهو بعيدة جدًا
Dialogue: 0,1:07:50.05,1:07:52.97,النص العام,,0,0,0,,دان جو وأنا سنفتقدك كثيرًا
Dialogue: 0,1:07:54.64,1:07:56.31,نص عام,,0,0,0,,أريد أن آخذه معي
Dialogue: 0,1:07:58.02,1:07:59.85,نص عام,,0,0,0,,شخص ما
Dialogue: 0,1:08:02.56,1:08:04.52,نص عام,,0,0,0,,- من؟\N- لا أستطيع أن أقول بعد
Dialogue: 0,1:08:06.65,1:08:07.90,نص عام,,0,0,0,,سأخبرك عندما يحين الوقت
Dialogue: 0,1:08:10.15,1:08:11.86,نص عام,,0,0,0,,سأذهب. نراكم غدا
Dialogue: 0,1:08:12.99,1:08:14.08,نص عام,,0,0,0,,حسنًا. وداعا
Dialogue: 0,1:08:48.36,1:08:49.78,ذكريات بخط مائل,,0,0,0,,لأنني كنت أشعر بالملل
Dialogue: 0,1:08:49.86,1:08:51.95,ذكريات,,0,0,0,,لقد أحببت هذا الشخص حقًا
Dialogue: 0,1:08:55.74,1:08:58.75,ذكريات بخط مائل,,0,0,0,,لا يمكن للبدو أن يتعافوا إلا من خلال امتصاص طاقة شخص آخر
Dialogue: 0,1:08:58.83,1:09:00.12,ذكريات بخط مائل,,0,0,0,,فعلت هذا مرة واحدة،
Dialogue: 0,1:09:01.21,1:09:02.79,الذكريات بخط مائل,,0,0,0,,تتحول إلى وحوش
Dialogue: 0,1:09:04.00,1:09:05.92,ذكريات بخط مائل,,0,0,0,,ومهمتنا هي
Dialogue: 0,1:09:06.88,1:09:08.21,ذكريات بخط مائل,,0,0,0,,احمي العالم منهم
Dialogue: 0,1:09:11.26,1:09:14.43,خلف الكواليس,,0,0,0,,هل يعرف يول حقًا كل شيء؟
Dialogue: 0,1:09:15.72,1:09:17.56,ذكريات بخط مائل,,0,0,0,,أريد أن آخذها معي
Dialogue: 0,1:09:18.14,1:09:20.02,ذكريات,,0,0,0,,شخص ما
Dialogue: 0,1:09:26.56,1:09:27.90,نص عام,,0,0,0,,المضيف
Dialogue: 0,1:09:27.98,1:09:29.11,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:09:32.15,1:09:35.03,general text,,0,0,0,,هل غادر يول بالفعل؟ أعطتها له الخادمة كيم
Dialogue: 0,1:09:42.33,1:09:43.83,نص عام,,0,0,0,,يبدو أنه كان يتحدث عنك
Dialogue: 0,1:09:44.71,1:09:47.67,نص عام,,0,0,0,,من؟ هل قال سيو يول شيئا؟
Dialogue: 0,1:09:51.21,1:09:52.84,نص عام,,0,0,0,,يمكنني العودة
Dialogue: 0,1:09:53.72,1:09:55.05,general text,,0,0,0,,هل هذا سبب انزعاجك الشديد؟
Dialogue: 0,1:09:55.84,1:09:57.93,نص عام,,0,0,0,,عند عودتك إلى الغابة،
Dialogue: 0,1:09:58.47,1:10:00.93,general text,,0,0,0,,ستحدث مبارزة مع تشا بوم
Dialogue: 0,1:10:01.02,1:10:02.14,نص عام,,0,0,0,,هل أنت خائف من الخسارة؟
Dialogue: 0,1:10:03.02,1:10:04.52,نص عام,,0,0,0,,لن أخسر غداً
Dialogue: 0,1:10:07.27,1:10:08.48,نص عام,,0,0,0,,وأخيرًا فهمت
Dialogue: 0,1:10:27.83,1:10:30.00,general text,,0,0,0,,اليوم هو قتال تشان ووك الأخير
Dialogue: 0,1:10:33.17,1:10:35.43,النص العام,,0,0,0,,لقد قمنا بتغيير شروط الرهان قليلاً
Dialogue: 0,1:10:35.51,1:10:37.26,نص عام,,0,0,0,,الفائز في مباراة اليوم
Dialogue: 0,1:10:38.09,1:10:40.39,نص عام,,0,0,0,,لن يحصل على الضفدع الذهبي، بل شيئًا آخر
Dialogue: 0,1:10:54.82,1:10:56.36,نص عام,,0,0,0,,الفائز
Dialogue: 0,1:10:57.78,1:10:59.07,النص العام,,0,0,0,,سوف تفوز بالخادمة
Dialogue: 0,1:11:05.41,1:11:07.08,نص عام,,0,0,0,,لقد وافقت على خدمت ذلك،
Dialogue: 0,1:11:09.00,1:11:11.21,نص عام,,0,0,0,,من سيفوز اليوم
Dialogue: 0,1:11:20.85,1:11:23.01,نص عام,,0,0,0,,- ماذا يحدث؟\N{\i1} - ممتاز
Dialogue: 0,1:11:23.68,1:11:25.31,النص العام,,0,0,0,,الخصم الأخير لتشانغ ووك،
Dialogue: 0,1:11:26.06,1:11:27.02,نص عام,,0,0,0,,تقدم
Dialogue: 0,1:11:55.46,1:11:56.38,نص عام,,0,0,0,,شان ووك
Dialogue: 0,1:11:58.30,1:12:00.09,نص عام,,0,0,0,,اليوم أقاتل معك
Dialogue: 0,1:12:01.30,1:12:02.60,نص عام,,0,0,0,,سأكون هناك
Dialogue: 0,1:12:57.02,1:13:01.99,معاينة,,0,0,0,,يمكن للمملكة المتحدة أن تجلب الفوضى إلى هذا العالم
Dialogue: 0,1:13:02.07,1:13:04.28,preview,,0,0,0,,ماذا يحدث إذا جذب الانتباه؟
Dialogue: 0,1:13:04.37,1:13:06.20,معاينة,,0,0,0,,علينا أن نختار من سيفوز بالتأكيد
Dialogue: 0,1:13:06.28,1:13:08.79,preview,,0,0,0,,سوف أفوز وآخذها معي كخادمة
Dialogue: 0,1:13:08.87,1:13:12.75,preview,,0,0,0,,هل أتقن تقنيات الخصوم التسعة السابقين؟
Dialogue: 0,1:13:12.83,1:13:13.79,معاينة,,0,0,0,,يجب أن أجده
Dialogue: 0,1:13:13.88,1:13:15.00,معاينة,,0,0,0,,إذًا عليك أن تخسر شيئًا ما
Dialogue: 0,1:13:15.08,1:13:17.09,معاينة,,0,0,0,,حبك الموقر لم يستسلم لأحد
Dialogue: 0,1:13:17.17,1:13:20.01,preview,,0,0,0,,عندها فقط سأتمكن من النظر في عينيه دون خجل
Dialogue: 0,1:13:20.09,1:13:23.84,preview,,0,0,0,,اسأل حول مو ديوك. أي نوع من الفتاة هي
Dialogue: 0,1:13:23.93,1:13:26.10,معاينة,,0,0,0,"نظرة مليئة بالحنان" نفس الشيء بالنسبة لي
Dialogue: 0,1:13:26.18,1:13:27.35,معاينة,,0,0,0,,أنت لا تعتبرني امرأة
Dialogue: 0,1:13:27.43,1:13:29.93,preview,,0,0,0,,- لا تندم لاحقًا\N- حسنًا، تفضل!
Dialogue: 0,1:13:31.14,1:13:34.81,معاينة,,0,0,0,,أنا حقًا معجب بك يا سيد
الحوار: 0,0:02:57.14,0:02:59.14,النكات,,0,0,0,,

