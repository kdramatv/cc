Dialogue: 0,0:02:47.24,0:02:52.24,niks,,0,0,0,,منسق المشروع ومحرره: {\c&HFFF4C5&} Ria_Lee
Dialogue: 0,0:02:52.24,0:02:57.24,النيكس,,0,0,0,,مساعدو المنسقين:{\c&HFFF4C5&} مارتيني، غاريسن
Dialogue: 0,0:02:57.24,0:03:02.24,النكات,,0,0,0,,مترجمو الطباعة:{\c&HFFF4C5&} Ria_Lee, Mina_Mi, Zero Amamiya
Dialogue: 0,0:00:51.18,0:00:56.44,general text,,0,0,0,,بو يونغ، أين شعرت بقوة حجر الجليد؟
Dialogue: 0,0:00:56.52,0:00:57.64,نص عام,,0,0,0,,أبتاه
Dialogue: 0,0:00:57.73,0:00:58.94,نص عام,,0,0,0,,نحن قريبون
Dialogue: 0,0:01:00.27,0:01:03.57,النص العام,,0,0,0,,صخرة في مكان قريب تحت الماء
Dialogue: 0,0:01:10.12,0:01:13.29,النص العام,,0,0,0,,هل تعتقد حقًا أنها عثرت على حجر الجليد؟
Dialogue: 0,0:01:13.87,0:01:14.95,نص عام,,0,0,0,,نعم، ينبغي أن يكون هو.
Dialogue: 0,0:01:15.91,0:01:17.58,نص عام,,0,0,0,,قبل 10 سنوات أستاذي تشانغ غان
Dialogue: 0,0:01:17.67,0:01:20.29,نص عام,,0,0,0,,أخفى الحجر هنا في بحيرة جيونج تشونج دايهو
Dialogue: 0,0:01:20.38,0:01:23.30,نص عام,,0,0,0,,والآن تم العثور على الحجر بواسطة فتاة ولدت
Dialogue: 0,0:01:23.88,0:01:25.67,نص عام,,0,0,0,,استخدام قوة الحجر
Dialogue: 0,0:01:27.01,0:01:30.76,نص عام,,0,0,0,,أنا متأكد من أن بو يونغ هي ابنة تشانغ غون.
Dialogue: 0,0:01:31.64,0:01:34.10,general text,,0,0,0,,وهذا ما يفسر سبب إنقاذها بالسحر
Dialogue: 0,0:01:35.77,0:01:37.43,نص عام,,0,0,0,,ألا تحبها؟
Dialogue: 0,0:01:46.94,0:01:48.57,نص عام,,0,0,0,,شكرًا لهذه الفتاة
Dialogue: 0,0:01:48.65,0:01:51.78,نص عام,,0,0,0,,لا قيمة لها، لقد تمكنت من الزواج
Dialogue: 0,0:01:52.87,0:01:55.24,نص عام,,0,0,0,,بنات عائلة جين
Dialogue: 0,0:01:57.33,0:01:59.04,نص عام,,0,0,0,,أعتقد أنني يجب أن أكون ممتنًا
Dialogue: 0,0:02:02.17,0:02:05.96,نص عام,,0,0,0,,هنا. الصخرة تحتنا مباشرة
Dialogue: 0,0:02:17.85,0:02:20.60,خلف الكواليس,,0,0,0,,عقدة الأب وغيرته,
Dialogue: 0,0:02:20.69,0:02:23.44,خارج الإطار,,0,0,0,,قاد جين بو يونغ إلى الموت
Dialogue: 0,0:02:25.90,0:02:27.15,نص عام,,0,0,0,,يناسبك
Dialogue: 0,0:02:28.19,0:02:31.41,نص عام,,0,0,0,,إذا أعجبك فأعجبني يا أمي
Dialogue: 0,0:02:33.37,0:02:35.16,خط مائل,,0,0,0,,دعونا نجرب شيئًا آخر
Dialogue: 0,0:02:38.75,0:02:40.37,خلف الكواليس,,0,0,0,,قوة جين بو يونغ المذهلة
Dialogue: 0,0:02:40.96,0:02:43.50,خلف الكواليس,,0,0,0,,لم تحصل عليها فقط من والدتها، أحد أفراد عائلة جين
Dialogue: 0,0:02:44.42,0:02:48.88,خلف الكواليس,,0,0,0,,وهي أيضًا قوية بفضل دماء والدها، سليل عائلة تشوي التي سقطت.
Dialogue: 0,0:02:52.26,0:02:55.26,خلف الكواليس,,0,0,0,,الأخ والأخت تشوي، اللذين كانا يكسبان رزقهما من قراءة الطالع،
Dialogue: 0,0:02:55.85,0:02:58.72,خلف الكواليس,,0,0,0,,كان أحفاد الساحر تشوي أول من ارتكب الجريمة
Dialogue: 0,0:02:58.81,0:03:00.56,خلف الكواليس,,0,0,0,,كيمياء النفوس
Dialogue: 0,0:03:03.27,0:03:05.56,التعليق الصوتي,,0,0,0,,جين بو يونغ كان من نسل العائلتين،
Dialogue: 0,0:03:05.65,0:03:09.32,التعليق الصوتي,,0,0,0,,مما جعلها أقوى كاهنة شهدها العالم
Dialogue: 0,0:03:10.69,0:03:12.24,نص عام,,0,0,0,,لقد وجدته أخيرًا
Dialogue: 0,0:03:13.32,0:03:14.16,نص عام,,0,0,0,,بو يونغ,
Dialogue: 0,0:03:14.74,0:03:16.12,نص عام,,0,0,0,,أعطني الحجر
Dialogue: 0,0:03:28.30,0:03:29.46,نص عام,,0,0,0,,أعيديه!
Dialogue: 0,0:03:34.76,0:03:35.80,نص عام,,0,0,0,,بو يونغ...
Dialogue: 0,0:03:36.39,0:03:38.18,نص عام,,0,0,0,,بو يونغ
Dialogue: 0,0:03:40.06,0:03:41.14,نص عام,,0,0,0,,بو يونغ!
Dialogue: 0,0:04:07.17,0:04:08.84,نص عام,,0,0,0,,تناول الطعام
Dialogue: 0,0:04:09.92,0:04:11.34,نص عام,,0,0,0,,هنا أمسك الملعقة
Dialogue: 0,0:04:12.51,0:04:14.63,نص عام,,0,0,0,,من المؤسف أنك أعمى
Dialogue: 0,0:04:14.72,0:04:17.43,نص عام,,0,0,0,,أسوأ ما في الأمر هو أنك لا تتذكر حتى اسمك
Dialogue: 0,0:04:19.89,0:04:22.02,نص عام,,0,0,0,,هل تريد أن تعيش معي؟
Dialogue: 0,0:04:22.89,0:04:26.65,نص عام,,0,0,0,,اسم حفيدتي المتوفاة مو دوك
Dialogue: 0,0:04:26.73,0:04:27.90,نص عام,,0,0,0,,هل يمكنني أن أدعوك بهذا الاسم؟
Dialogue: 0,0:04:30.48,0:04:31.98,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:04:32.07,0:04:33.61,نص عام,,0,0,0,,من الآن فصاعدا أنت مو دوك
Dialogue: 0,0:04:34.53,0:04:36.15,نص عام,,0,0,0,,ما أحلى
Dialogue: 0,0:04:36.24,0:04:38.12,خط مائل,,0,0,0,,دعونا نأكل
Dialogue: 0,0:04:44.16,0:04:45.54,نص عام,,0,0,0,,مو دوك...
Dialogue: 0,0:05:28.17,0:05:29.33,نص عام,,0,0,0,,الأم
Dialogue: 0,0:05:36.76,0:05:38.30,ذكريات,,0,0,0,,بو يونغ...
Dialogue: 0,0:05:53.77,0:05:54.98,نص عام,,0,0,0,,كيف يكون هذا ممكنًا؟
Dialogue: 0,0:05:56.78,0:05:59.74,النص العام,,0,0,0,,حدث هذا في يوم اختفاء بو يونغ
Dialogue: 0,0:06:12.75,0:06:14.25,نص عام,,0,0,0,,لم يعد مو دوك
Dialogue: 0,0:06:14.34,0:06:17.71,النص العام,,0,0,0,,ربما قتله البدو هو وتشان ووك
Dialogue: 0,0:06:17.80,0:06:20.13,نص عام,,0,0,0,,ثم سنموت جميعًا
Dialogue: 0,0:06:26.56,0:06:27.68,نص عام,,0,0,0,,جين بو يونغ
Dialogue: 0,0:06:27.77,0:06:30.48,النص العام,,0,0,0,,أنت بنفسك أحضرت الحجر من جينيوون
Dialogue: 0,0:06:31.23,0:06:33.48,general text,,0,0,0,,أنت كاهنة ولكنك لا تستطيع السيطرة عليه؟
Dialogue: 0,0:06:34.90,0:06:37.73,نص عام,,0,0,0,,لقد اتبعت تعليمات والدتي
Dialogue: 0,0:06:38.61,0:06:39.82,نص عام,,0,0,0,,أنت مثير للشفقة
Dialogue: 0,0:06:41.36,0:06:44.20,النص العام,,0,0,0,,فقد يول الكثير من الدماء
Dialogue: 0,0:06:45.03,0:06:47.54,النص العام,,0,0,0,,بدون نقل الدم قد يموت
Dialogue: 0,0:06:48.41,0:06:50.71,النص العام,,0,0,0,,إذا كنت بحاجة إلى الدم، يمكنك أن تأخذ دمي
Dialogue: 0,0:06:50.79,0:06:53.08,نص عام,,0,0,0,,لا يمكنك إلقاء التعويذات هنا،
Dialogue: 0,0:06:53.17,0:06:55.00,نص عام,,0,0,0,,حتى لا يستخدم دمك
Dialogue: 0,0:07:02.55,0:07:03.93,ذكريات بخط مائل,,0,0,0,,مد يدك
Dialogue: 0,0:07:13.65,0:07:16.69,ذكريات,,0,0,0,,دودة من دم ابنتي تشو يونغ
Dialogue: 0,0:07:16.77,0:07:19.57,ذكريات بخط مائل,,0,0,0,,سوف تمنحك صلاحيات عائلة جين
Dialogue: 0,0:07:22.82,0:07:26.41,خط مائل,,0,0,0,,شان ووك خدعنا جميعًا
Dialogue: 0,0:07:28.74,0:07:32.04,general text,,0,0,0,,يتناوب سحرة المجلس الموحد على قراءة "كلمات القلب".
Dialogue: 0,0:07:32.12,0:07:34.12,نص عام,,0,0,0,,لكن ليس هناك كلمة عن الحجر
Dialogue: 0,0:07:34.21,0:07:36.84,نص عام,,0,0,0,,ليس أكثر من قصيدة
Dialogue: 0,0:07:40.38,0:07:42.26,general text,,0,0,0,,ماذا سيقول سوسنوفي بور لهذا؟
Dialogue: 0,0:07:45.30,0:07:46.72,نص عام,,0,0,0,,يقرأه كل السحرة,
Dialogue: 0,0:07:47.68,0:07:49.81,نص عام,,0,0,0,,لكن لم يعرف أحد شيئاً
Dialogue: 0,0:07:57.11,0:07:59.98,ذكريات,,0,0,0,"كلمات من القلب" - رسالة حب
Dialogue: 0,0:08:00.07,0:08:01.40,ذكريات,,0,0,0,,السيد سيو كيونغ
Dialogue: 0,0:08:01.49,0:08:04.20,ذكريات,,0,0,0,,الرسالة؟
Dialogue: 0,0:08:04.78,0:08:08.33,ذكريات,,0,0,0,,رسالة حب إلى جين سيول ران,
Dialogue: 0,0:08:08.41,0:08:09.87,ذكريات,,0,0,0,,الفصل الأول من جينيوون
Dialogue: 0,0:08:11.29,0:08:15.37,general text,,0,0,0,,هذا اعتراف بأنه لم يحطم الحجر لأنه
Dialogue: 0,0:08:16.12,0:08:19.50,نص عام,,0,0,0,,أنني لم أستطع أن أتخلى عن حبيبي الذي كان يموت
Dialogue: 0,0:08:21.59,0:08:23.51,نص عام,,0,0,0,,إذاً يا معلمة سو كيونغ
Dialogue: 0,0:08:23.59,0:08:26.93,النص العام,,0,0,0,,ألم يحطموا الحجر بسبب الحب؟
Dialogue: 0,0:08:27.89,0:08:29.55,نص عام,,0,0,0,,إنه يحاول خداعك
Dialogue: 0,0:08:30.14,0:08:33.73,نص عام,,0,0,0,,أستطيع أن أثبت أن هذه رسالة حب
Dialogue: 0,0:08:35.56,0:08:38.11,نص عام,,0,0,0,,يكفي أن تسمي اسم المستلم في عقلك
Dialogue: 0,0:08:38.69,0:08:42.07,نص عام,,0,0,0,,ويمكنك قراءة هذه الرسالة بنفسك يا صاحب الجلالة
Dialogue: 0,0:08:42.15,0:08:43.86,نص عام,,0,0,0,,أستطيع قراءة القصيدة
Dialogue: 0,0:08:44.99,0:08:46.66,نص عام,,0,0,0,,حتى بدون أن تكون ساحراً؟
Dialogue: 0,0:08:47.36,0:08:48.70,خط مائل,,0,0,0,,اسم المستلم
Dialogue: 0,0:08:48.78,0:08:53.08,نص عام,,0,0,0,,سوف يذكرك بـ “زهرة الأوركيد المغطاة بالثلج”
Dialogue: 0,0:08:55.00,0:08:56.50,نص عام,,0,0,0,,هذا سول ران
Dialogue: 0,0:08:57.87,0:08:59.21,نص عام,,0,0,0,"سولت ران"؟
Dialogue: 0,0:09:31.53,0:09:34.95,النص العام,,0,0,0,"أرى السماء الزرقاء. وسمع تنهيدة هادئة"
Dialogue: 0,0:09:43.42,0:09:46.88,النص العام,,0,0,0,"أعلم أن عيني ستمتلئ بالدموع مرة أخرى"
Dialogue: 0,0:09:47.97,0:09:49.13,نص عام,,0,0,0,"لكنني أحمق"
Dialogue: 0,0:09:49.72,0:09:53.01,نص عام,,0,0,0,"لم أتدحرج على خدي"
Dialogue: 0,0:09:54.22,0:09:56.39,خط مائل,,0,0,0,"ولا دمعة واحدة"
Dialogue: 0,0:09:58.73,0:10:00.40,نص عام,,0,0,0,,هذا هو اعترافه
الحوار: 0,0:10:00.48,0:10:03.90,نص عام,,0,0,0,,أنه لم يحطم الحجر من أجل حبيبته
Dialogue: 0,0:10:07.49,0:10:09.53,النص العام,,0,0,0,,لكن الرئيس جين سيول ران مات
Dialogue: 0,0:10:09.61,0:10:11.62,نص عام,,0,0,0,,بعد حوالي ستة أشهر
Dialogue: 0,0:10:11.70,0:10:16.08,general text,,0,0,0,,بعد تأسيس جينياوون بسبب الإصابات التي لحقت به أثناء الفوضى الكبرى
Dialogue: 0,0:10:16.16,0:10:17.58,نص عام,,0,0,0,,لو كان الحجر لها،
Dialogue: 0,0:10:17.66,0:10:19.83,general text,,0,0,0,,لماذا لم تستخدمه وتنقذ نفسها؟
Dialogue: 0,0:10:20.46,0:10:24.25,نص عام,,0,0,0,,أنا متأكد من أن هذا حتى لا يعرف العالم
Dialogue: 0,0:10:24.92,0:10:26.67,نص عام,,0,0,0,,هذه القوة الخطيرة
Dialogue: 0,0:10:27.84,0:10:31.30,general text,,0,0,0,,من يرفض مثل هذه القوة؟
Dialogue: 0,0:10:31.38,0:10:32.80,نص عام,,0,0,0,,شخص مثلك
Dialogue: 0,0:10:33.85,0:10:36.31,النص العام,,0,0,0,,لن تتصرف مثلها أبدًا
Dialogue: 0,0:10:36.39,0:10:39.10,general text,,0,0,0,,وفعلت ذلك من أجل الإنسانية
Dialogue: 0,0:10:40.48,0:10:41.73,نص عام,,0,0,0,,فعلت الصواب
Dialogue: 0,0:10:43.44,0:10:45.90,نص عام,,0,0,0,,لحماية الحق
Dialogue: 0,0:10:48.36,0:10:53.62,نص عام,,0,0,0,,أحيانًا يجب على شخص ما أن يتخلى عن كل شيء
Dialogue: 0,0:11:10.42,0:11:12.26,نص عام,,0,0,0,,منذ أن التقطت السيف،
Dialogue: 0,0:11:13.68,0:11:15.39,نص عام,,0,0,0,,حدد اختيارك
Dialogue: 0,0:11:20.14,0:11:21.64,نص عام,,0,0,0,,أعلم أنك كنت تتجنبني
Dialogue: 0,0:11:21.73,0:11:24.73,نص عام,,0,0,0,,أعلم أن حياتنا بين يديك
Dialogue: 0,0:11:27.07,0:11:30.74,النص العام,,0,0,0,,كما وعدتك، صوب سيفك نحوي أولاً
Dialogue: 0,0:11:43.12,0:11:45.08,ذكريات بخط مائل,,0,0,0,,الطاقة الزائدة ستؤدي إلى
Dialogue: 0,0:11:45.17,0:11:47.84,ذكريات بخط مائل,,0,0,0,,أنك لا تستطيع التحكم في الطاقة التي تستخدمها
Dialogue: 0,0:11:48.80,0:11:51.42,ذكريات,,0,0,0,,إذا أردت المطر سيأتيك الفيضان
Dialogue: 0,0:11:52.17,0:11:54.76,ذكريات,,0,0,0,,إذا أردت الريح سيأتيك إعصار
Dialogue: 0,0:11:54.84,0:11:56.51,ذكريات,,0,0,0,,حاول التأقلم
Dialogue: 0,0:11:56.59,0:11:59.47,ذكريات,,0,0,0,,لذا لن أتمكن من التحكم بهذه القوة؟
Dialogue: 0,0:12:00.77,0:12:03.60,ذكريات,,0,0,0,,شيء يمكنك القيام به بمحض إرادتك
Dialogue: 0,0:12:05.85,0:12:07.02,الذكريات,,0,0,0,,لا تستخدمها
Dialogue: 0,0:12:08.36,0:12:11.65,ذكريات,,0,0,0,,الخيار لك: استخدام القوة أم لا
Dialogue: 0,0:12:25.37,0:12:27.33,نص عام,,0,0,0,,والآن كما قلت،
Dialogue: 0,0:12:29.42,0:12:31.05,نص عام,,0,0,0,,أعطني وعدًا آخر
Dialogue: 0,0:12:47.77,0:12:49.11,مائل,,0,0,0,,بين النجوم
Dialogue: 0,0:12:49.19,0:12:52.48,مائل,,0,0,0,,هناك الشيء الأكثر حزناً - نجم الملك
Dialogue: 0,0:12:54.61,0:12:56.78,نص عام,,0,0,0,,أي نوع من النجوم هذا؟
Dialogue: 0,0:12:57.49,0:12:58.82,نص عام,,0,0,0,,ولدت تحت برجها
Dialogue: 0,0:12:58.91,0:13:01.20,نص عام,,0,0,0,,يمكن التحكم في طاقة السماء
Dialogue: 0,0:13:01.28,0:13:03.87,النص العام,,0,0,0,,فهل سيكون الشخص قوياً؟
Dialogue: 0,0:13:03.95,0:13:05.62,نص عام,,0,0,0,,هذا جيد
Dialogue: 0,0:13:06.50,0:13:09.96,النص العام,,0,0,0,,كيف تقول... ليس الأمر جيدًا دائمًا
Dialogue: 0,0:13:10.04,0:13:12.00,نص عام,,0,0,0,,كلما زادت القوة -
Dialogue: 0,0:13:12.09,0:13:14.05,نص عام,,0,0,0,,كلما زادت المسؤولية
Dialogue: 0,0:13:14.13,0:13:16.09,نص عام,,0,0,0,,ما هي "المسؤولية"؟
Dialogue: 0,0:13:16.17,0:13:18.64,general text,,0,0,0,,هذا هو الوقت الذي يتعين عليك فيه القيام بشيء لا تريد القيام به،
Dialogue: 0,0:13:18.72,0:13:20.97,نص عام,,0,0,0,,حتى لو شعرت بالحزن والوحدة لاحقًا
Dialogue: 0,0:13:21.05,0:13:24.60,general text,,0,0,0,,أجاشي، هل يمكنني أكل هذا؟
Dialogue: 0,0:13:25.81,0:13:26.77,نص عام,,0,0,0,,بالطبع
Dialogue: 0,0:13:27.81,0:13:30.73,النص العام,,0,0,0,,- كان يجب أن أعطيها من قبل\N- شكراً لك.
Dialogue: 0,0:13:30.81,0:13:34.48,نص عام,,0,0,0,,فقط لا تتقاتل عليهم
Dialogue: 0,0:13:34.57,0:13:36.15,نص عام,,0,0,0,,حسنًا. ذهبنا
Dialogue: 0,0:13:46.54,0:13:48.25,نص عام,,0,0,0,,النجم سيظهر قريباً
Dialogue: 0,0:13:49.37,0:13:52.29,general text,,0,0,0,,ثم أولئك الذين يجب أن يختفوا،
Dialogue: 0,0:13:52.38,0:13:54.92,نص عام,,0,0,0,,ومن يحتاجه سيعود
Dialogue: 0,0:14:01.93,0:14:05.77,نص عام,,0,0,0,,ولي العهد كان يبحث عن هذا المكان
Dialogue: 0,0:14:06.43,0:14:08.48,نص عام,,0,0,0,,المحل فيه كل شهر
Dialogue: 0,0:14:08.56,0:14:10.94,نص عام,,0,0,0,,مشي كيم الخصي خادم الملكة
Dialogue: 0,0:14:11.02,0:14:13.27,نص عام,,0,0,0,,أنت تعرف طريقك جيدًا
Dialogue: 0,0:14:13.98,0:14:16.44,النص العام,,0,0,0,,وذلك الطلسم حتى يقع الحبيب في الحب...
Dialogue: 0,0:14:16.53,0:14:17.86,نص عام,,0,0,0,,هل حصلت عليه هنا؟
Dialogue: 0,0:14:19.07,0:14:22.16,general text,,0,0,0,,لم يفلح الأمر حتى، توقف عن السخرية مني
Dialogue: 0,0:14:22.74,0:14:26.20,النص العام,,0,0,0,,كيف "لم ينجح"؟ نحن معا الآن
Dialogue: 0,0:14:27.54,0:14:28.50,نص عام,,0,0,0,,حسنًا...
Dialogue: 0,0:14:28.58,0:14:31.33,نص عام,,0,0,0,,لسنا على موعد
Dialogue: 0,0:14:39.88,0:14:43.01,نص عام,,0,0,0,,لماذا هو هنا؟
Dialogue: 0,0:14:45.01,0:14:47.27,نقوش,,0,0,0,,محل الأعشاب
Dialogue: 0,0:14:48.31,0:14:49.48,نص عام,,0,0,0,,أبي؟
Dialogue: 0,0:15:27.51,0:15:29.77,نص عام,,0,0,0,,عود إلى رشدك
Dialogue: 0,0:15:29.85,0:15:32.44,general text,,0,0,0,,لقد حاولوا إيذاء أنفسهم مرة أخرى يا صاحب السمو
Dialogue: 0,0:15:32.52,0:15:34.60,general text,,0,0,0,,لماذا تبقيني على قيد الحياة؟
Dialogue: 0,0:15:35.36,0:15:37.52,نص عام,,0,0,0,,فقط اقتل بالفعل
Dialogue: 0,0:15:37.61,0:15:40.82,نص عام,,0,0,0,,ليس بعد. فانوس الملكة للحياة
Dialogue: 0,0:15:41.65,0:15:44.49,نص عام,,0,0,0,,يجب أن يحترق وجثة الملكة لا تزال على قيد الحياة
Dialogue: 0,0:15:47.78,0:15:50.45,النص العام,,0,0,0,,من المخيف أن تنظر إلي بهذه الطريقة
Dialogue: 0,0:15:51.58,0:15:53.96,نص عام,,0,0,0,, بوجه أختي
Dialogue: 0,0:15:54.04,0:15:56.29,نص عام,,0,0,0,,لا ينبغي أن تغضب مني
Dialogue: 0,0:15:56.38,0:15:58.17,نص عام,,0,0,0,,اللوم على من وضعه
Dialogue: 0,0:15:59.34,0:16:01.38,نص عام,,0,0,0,,أنا وأختي في هذا الوضع
Dialogue: 0,0:16:13.31,0:16:15.81,ذكريات,,0,0,0,,شامان تشوي، أنت ملعون وآذيت الناس
Dialogue: 0,0:16:15.90,0:16:17.94,ذكريات,,0,0,0,,استخدام التعويذات المحرمة
Dialogue: 0,0:16:18.90,0:16:20.40,ذكريات,,0,0,0,,هل تعترف بذنوبك؟
Dialogue: 0,0:16:25.99,0:16:29.78,ذكريات,,0,0,0,,فعلت من أجل المال ما طلبه الناس
Dialogue: 0,0:16:29.87,0:16:33.50,ذكريات,,0,0,0,,ذنب من طلب مني أن أشتم أحداً
Dialogue: 0,0:16:33.58,0:16:35.42,ذكريات,,0,0,0,,لعنتك أدت إلى الموت!
Dialogue: 0,0:16:36.46,0:16:38.33,ذكريات,,0,0,0,,هل تتظاهر بالبراءة؟
Dialogue: 0,0:16:42.01,0:16:44.72,ذكريات,,0,0,0,,تعاويذ يمكن أن تقتل...
Dialogue: 0,0:16:44.80,0:16:46.34,ذكريات,,0,0,0,,مندهش من قوتك
Dialogue: 0,0:16:46.97,0:16:48.09,ذكريات,,0,0,0,,هذه القوة
Dialogue: 0,0:16:49.01,0:16:53.47,الذكريات,,0,0,0,,قد تكون كافية لقتلك.
Dialogue: 0,0:16:58.73,0:17:02.78,الذكريات,,0,0,0,,اعثر على جميع كتب التعويذة، وكل شيء استخدمته!
Dialogue: 0,0:17:02.86,0:17:03.78,ذكريات,,0,0,0,,- نعم!\N- نعم!
Dialogue: 0,0:17:21.25,0:17:22.92,ذكريات,,0,0,0,,لا، ليس هذا!
Dialogue: 0,0:17:23.80,0:17:25.05,ذكريات,,0,0,0,,نحن عائلة فقيرة،
Dialogue: 0,0:17:25.13,0:17:27.13,ذكريات,,0,0,0,,لكن هذا هو إرث عائلتنا
Dialogue: 0,0:17:27.22,0:17:29.51,ذكريات,,0,0,0,,لم أخمن معها!
Dialogue: 0,0:17:29.59,0:17:30.76,ذكريات,,0,0,0,,لا تحترق
Dialogue: 0,0:17:31.35,0:17:32.51,نقوش,,0,0,0,,تشونغان
Dialogue: 0,0:17:32.60,0:17:33.77,ذكريات,,0,0,0,,هذا كتاب التعويذات
Dialogue: 0,0:17:33.85,0:17:34.89,ذكريات,,0,0,0,,لا...
Dialogue: 0,0:17:35.68,0:17:36.60,ذكريات,,0,0,0,,حرق
Dialogue: 0,0:17:39.52,0:17:43.27,ذكريات,,0,0,0,,لا!
Dialogue: 0,0:17:43.78,0:17:45.19,نقوش,,0,0,0,,تشونغان
Dialogue: 0,0:18:01.54,0:18:03.13,نص عام,,0,0,0,,أطفئ النار. عجل!
Dialogue: 0,0:18:03.21,0:18:04.25,نص عام,,0,0,0,,- نعم\N- نعم
Dialogue: 0,0:18:10.05,0:18:15.10,نقوش,,0,0,0,,تشونغان
Dialogue: 0,0:18:23.11,0:18:25.40,نقوش,,0,0,0,,كيمياء النفوس
Dialogue: 0,0:18:25.98,0:18:27.53,ذكريات,,0,0,0,"كيمياء النفوس"؟
Dialogue: 0,0:18:41.71,0:18:43.04,ذكريات,,0,0,0,,اصبري يا أختي.
Dialogue: 0,0:19:01.39,0:19:03.27,مائل,,0,0,0,,بدأ كل شيء معه
Dialogue: 0,0:19:03.35,0:19:04.90,نص عام,,0,0,0,,لقد ترك هذه الندوب
Dialogue: 0,0:19:04.98,0:19:08.15,general text,,0,0,0,,بسببه نقلت أختي روحها إلى جسدك
Dialogue: 0,0:19:08.23,0:19:10.24,نص عام,,0,0,0,,إنه خطأه
Dialogue: 0,0:19:11.65,0:19:12.82,نص عام,,0,0,0,,تشان غان
Dialogue: 0,0:19:14.62,0:19:15.66,نص عام,,0,0,0,,تشان...
Dialogue: 0,0:19:16.53,0:19:18.16,نص عام,,0,0,0,,غان...
Dialogue: 0,0:19:19.50,0:19:21.16,نص عام,,0,0,0,,لا يمكن أن تموت بعد
Dialogue: 0,0:19:21.96,0:19:23.83,نص عام,,0,0,0,,أعيش في جسد أختي
Dialogue: 0,0:19:25.04,0:19:26.34,نص عام,,0,0,0,,فقط أكثر قليلاً،
Dialogue: 0,0:19:27.34,0:19:28.38,نص عام,,0,0,0,,صاحب السمو
Dialogue: 0,0:19:33.76,0:19:36.26,النص العام,,0,0,0,,لقد مرت أكثر من عشر سنوات منذ أن حصلت على هذا الجسد
Dialogue: 0,0:19:37.43,0:19:40.77,general text,,0,0,0,,ولكن في كل مرة تستعيد وعيها يؤثر عليّ.
Dialogue: 0,0:19:41.73,0:19:44.73,general text,,0,0,0,,لولا فانوس الحياة لقتلتها
Dialogue: 0,0:19:44.81,0:19:47.36,النص العام,,0,0,0,,أحضر لها أخوك الدواء
Dialogue: 0,0:19:48.44,0:19:50.36,نص عام,,0,0,0,,سوف تشعر بتحسن قريبًا
Dialogue: 0,0:19:51.78,0:19:52.78,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:19:54.20,0:19:56.82,general text,,0,0,0,,كيف انتهى الأمر بالحجر في تشونغجينجاك؟
Dialogue: 0,0:19:56.91,0:19:58.62,النص العام,,0,0,0,,ربما كان جين هو كيونغ مخطئًا،
Dialogue: 0,0:19:58.70,0:20:00.75,نص عام,,0,0,0,,لأنني استخدمت الحجر لأول مرة
Dialogue: 0,0:20:01.75,0:20:03.21,نص عام,,0,0,0,,عندما يحين الوقت،
Dialogue: 0,0:20:04.00,0:20:07.04,النص العام,,0,0,0,,أنا أستخدم قوة الحجر في كيمياء النفوس
Dialogue: 0,0:20:09.30,0:20:12.63,general text,,0,0,0,,إذا فعلت هذا الآن، سيموت الجميع في جيونججينجاك
Dialogue: 0,0:20:12.72,0:20:13.84,نص عام,,0,0,0,,نعم أعرف
Dialogue: 0,0:20:14.38,0:20:15.97,نص عام,,0,0,0,,ولي العهد هناك أيضاً
Dialogue: 0,0:20:17.80,0:20:18.97,نص عام,,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:20:20.52,0:20:23.06,general text,,0,0,0,,يجب أن ننتظر حتى يتم إنقاذه من هناك
Dialogue: 0,0:20:23.14,0:20:24.56,النص العام,,0,0,0,,ثم يمكنك جمع قوة الحجر
Dialogue: 0,0:20:24.64,0:20:26.02,general text,,0,0,0,,ماذا لو لم ينقذوه؟
Dialogue: 0,0:20:27.10,0:20:29.15,النص العام,,0,0,0,,هل يجب أن أجلس وأنتظر؟
Dialogue: 0,0:20:29.23,0:20:32.74,general text,,0,0,0,,ماذا لو أخذ الحجر أمامي؟
Dialogue: 0,0:20:32.82,0:20:36.41,النص العام,,0,0,0,,الحمد لله، لا أحد يفعل أي شيء، الجميع في حالة تأهب فقط
Dialogue: 0,0:20:37.66,0:20:41.58,general text,,0,0,0,,يجب أن نجد طريقة لإنقاذ ولي العهد
Dialogue: 0,0:20:55.72,0:20:56.88,ذكريات,,0,0,0,,الأم
Dialogue: 0,0:21:03.43,0:21:04.81,نص عام,,0,0,0,,سمعته
Dialogue: 0,0:21:05.56,0:21:07.23,general text,,0,0,0,,لماذا تناديني بهذا الاسم؟
Dialogue: 0,0:21:08.10,0:21:09.27,نص عام,,0,0,0,,ضحك ولا أكثر
Dialogue: 0,0:21:16.15,0:21:17.20,نص عام,,0,0,0,,الكل
Dialogue: 0,0:21:18.78,0:21:21.03,نص عام,,0,0,0,,أكثر قلقًا بشأن حجر الجليد،
Dialogue: 0,0:21:23.04,0:21:25.54,نص عام,,0,0,0,,من الأطفال المحبوسين هناك
Dialogue: 0,0:21:27.21,0:21:30.04,النص العام,,0,0,0,,يجب أن نحاول أنا وأنت تدمير الحاجز
Dialogue: 0,0:21:31.75,0:21:34.67,النص العام,,0,0,0,,دعونا نفعل شيئًا دون موافقة المجلس،
Dialogue: 0,0:21:35.38,0:21:37.09,نص عام,,0,0,0,,ستكون هناك فضيحة مرة أخرى
Dialogue: 0,0:21:39.01,0:21:41.35,النص العام,,0,0,0,,الحجر يخص جينيوون
Dialogue: 0,0:21:41.43,0:21:44.06,general text,,0,0,0,,سوسنوفي بور ليس له الحق في اتخاذ القرارات
Dialogue: 0,0:21:44.14,0:21:45.18,نص عام,,0,0,0,,فصل جين,
Dialogue: 0,0:21:45.73,0:21:49.56,النص العام,,0,0,0,,الحجر لم يغادر جدران جينيوون أبدًا
Dialogue: 0,0:21:49.65,0:21:51.94,نص عام,,0,0,0,,على مدى 200 عام الماضية؟
Dialogue: 0,0:21:54.57,0:21:57.28,مائل,,0,0,0,,قلت ذات مرة أن ساحر سوسنوفي بور قد دخل جينيوون بالفعل
Dialogue: 0,0:21:57.78,0:21:59.07,نص عام,,0,0,0,,هذا عشوائي
Dialogue: 0,0:22:01.07,0:22:02.33,نص عام,,0,0,0,,ألم يكن تشانغ غان؟
Dialogue: 0,0:22:06.33,0:22:08.04,نص عام,,0,0,0,,لقد طرحت سؤالاً
Dialogue: 0,0:22:09.04,0:22:12.79,general text,,0,0,0,,هل استخدم تشانغ جانج الحجر من قبل؟
Dialogue: 0,0:22:24.31,0:22:26.22,ذكريات,,0,0,0,,الطفل الذي بداخله لا يتحرك
Dialogue: 0,0:22:26.31,0:22:28.02,ذكريات,,0,0,0,,حملتها 13 شهرًا
Dialogue: 0,0:22:28.89,0:22:30.02,ذكريات,,0,0,0,,لا أستطيع أن أتركها تذهب
Dialogue: 0,0:22:32.36,0:22:33.61,ذكريات,,0,0,0,,يجب أن أنقذها
Dialogue: 0,0:22:34.23,0:22:35.94,ذكريات,,0,0,0,,أنا آسف
Dialogue: 0,0:22:36.98,0:22:38.69,ذكريات,,0,0,0,,لقد ماتت بالفعل
Dialogue: 0,0:22:43.87,0:22:45.20,ذكريات,,0,0,0,,في جينيوون
Dialogue: 0,0:22:46.91,0:22:47.87,ذكريات,,0,0,0,,هناك حجر ثلج
Dialogue: 0,0:22:49.83,0:22:51.17,ذكريات,,0,0,0,,حجر الجليد؟
Dialogue: 0,0:22:51.25,0:22:53.67,ذكريات,,0,0,0,,لماذا المفاجأة؟ لقد شككت بالفعل
Dialogue: 0,0:22:53.75,0:22:57.09,ذكريات,,0,0,0,,لقد طلبت الذهاب إلى جينيوون عدة مرات
Dialogue: 0,0:22:57.92,0:23:00.55,ذكريات,,0,0,0,,أعلم أنك أردت العثور على حجر هناك
Dialogue: 0,0:23:04.14,0:23:05.76,ذكريات,,0,0,0,,يقولون أن الحجر يستطيع
Dialogue: 0,0:23:05.85,0:23:09.89,ذكريات,,0,0,0,,إعادة الموتى إلى الحياة
Dialogue: 0,0:23:11.31,0:23:12.48,ذكريات,,0,0,0,,ليس لدي القوة الكافية
Dialogue: 0,0:23:14.19,0:23:15.90,ذكريات,,0,0,0,,السيطرة على الحجر
Dialogue: 0,0:23:16.73,0:23:17.82,ذكريات,,0,0,0,,ولكن لك يا تشانغ غان
Dialogue: 0,0:23:18.69,0:23:20.78,ذكريات,,0,0,0,,قد تكون القوة كافية
Dialogue: 0,0:23:22.95,0:23:25.03,ذكريات,,0,0,0,,هل تطلب استخدام السحر الأسود؟
Dialogue: 0,0:23:25.12,0:23:27.79,ذكريات,,0,0,0,,سأفعل كل شيء لإنقاذ طفلي
Dialogue: 0,0:23:30.58,0:23:31.54,ذكريات,,0,0,0,,من فضلك
Dialogue: 0,0:23:32.75,0:23:34.92,ذكريات,,0,0,0,,ساعدني في إنقاذه
Dialogue: 0,0:23:45.68,0:23:49.39,التعليق الصوتي,,0,0,0,,في تلك الليلة فتحت باب جينيوون وسمحت له بالدخول
Dialogue: 0,0:23:50.02,0:23:52.31,تعليق صوتي,,0,0,0,,آمل أن ينقذ ابنتي
Dialogue: 0,0:23:53.35,0:23:56.98,خلف الكواليس,,0,0,0,,ونتيجة لذلك، خسر جينيوون حجر الجليد
Dialogue: 0,0:24:05.36,0:24:06.66,نص عام,,0,0,0,,وحتى لو كان الأمر كذلك،
Dialogue: 0,0:24:07.66,0:24:09.91,general text,,0,0,0,,هناك المزيد من الذنب وراء سوسنوفي بور
Dialogue: 0,0:24:09.99,0:24:13.54,general text,,0,0,0,,ساحرك يصور الصالحين دائمًا، لكنه لا يزال
Dialogue: 0,0:24:13.62,0:24:15.46,نص عام,,0,0,0,,أخذت حجر الجليد
Dialogue: 0,0:24:15.54,0:24:18.96,النص العام,,0,0,0,,خلق كيمياء النفوس وألقى الفوضى على الأرض
Dialogue: 0,0:24:21.59,0:24:23.76,نص عام,,0,0,0,,فأردت إخفاءه
Dialogue: 0,0:24:25.18,0:24:26.22,نص عام,,0,0,0,,لكن
Dialogue: 0,0:24:27.43,0:24:30.64,general text,,0,0,0,,سأفعل كل شيء لكشف الحقيقة وتصحيح كل شيء،
Dialogue: 0,0:24:31.77,0:24:34.23,النص العام,,0,0,0,,حتى لو كان عليك أن تكشف خطايا سوسنوفي بور
Dialogue: 0,0:24:35.98,0:24:37.40,نص عام,,0,0,0,,ومعاقبة المذنب
Dialogue: 0,0:24:41.11,0:24:44.82,general text,,0,0,0,,إذن عليك أن تحكم على الشخص العزيز عليك
Dialogue: 0,0:24:47.20,0:24:48.53,نص عام,,0,0,0,,لن يكون الأمر سهلاً
Dialogue: 0,0:24:50.58,0:24:51.79,نص عام,,0,0,0,,أعلم
Dialogue: 0,0:24:54.16,0:24:55.12,نص عام,,0,0,0,,لكن...
Dialogue: 0,0:24:55.87,0:25:00.09,نص عام,,0,0,0,,إذا كانت هذه هي الطريقة الوحيدة لإصلاح الوضع،
Dialogue: 0,0:25:03.30,0:25:05.67,نص عام,,0,0,0,,سأفعل ذلك
Dialogue: 0,0:25:15.52,0:25:17.69,general text,,0,0,0,,روح أختي ستحل محل جسدك
Dialogue: 0,0:25:17.77,0:25:21.69,نص عام,,0,0,0,,على جثة فتاة تتظاهر بأنها ابنتي الكبرى
Dialogue: 0,0:25:22.48,0:25:24.07,خط مائل,,0,0,0,,ثم
Dialogue: 0,0:25:24.15,0:25:27.74,النص العام,,0,0,0,,سأقتلك كما تطلب
Dialogue: 0,0:25:43.00,0:25:44.05,نص عام,,0,0,0,,تشو يونغ,
Dialogue: 0,0:25:46.09,0:25:47.30,خط مائل,,0,0,0,,ماذا...
Dialogue: 0,0:25:47.38,0:25:48.72,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:25:51.51,0:25:52.72,نص عام,,0,0,0,,أبتاه,
Dialogue: 0,0:25:53.81,0:25:54.93,نص عام,,0,0,0,,ما..
Dialogue: 0,0:25:56.23,0:25:58.06,نص عام,,0,0,0,,هراء... أنا فقط
Dialogue: 0,0:25:59.23,0:26:00.48,نص عام,,0,0,0,,سمعت؟
Dialogue: 0,0:26:04.86,0:26:07.86,نص عام,,0,0,0,,من هذه المرأة؟
Dialogue: 0,0:26:09.03,0:26:11.28,مائل,,0,0,0,,سجين في هذا الجسد
Dialogue: 0,0:26:13.58,0:26:15.54,نص عام,,0,0,0,,روح الملكة الحقيقية؟
Dialogue: 0,0:26:45.11,0:26:47.40,نص عام,,0,0,0,,أبتاه توقف
Dialogue: 0,0:27:49.25,0:27:50.30,نص عام,,0,0,0,,غوانغجو,
Dialogue: 0,0:27:51.30,0:27:52.55,النص العام,,0,0,0,,هل هذا أنت؟
Dialogue: 0,0:28:02.27,0:28:03.35,نص عام,,0,0,0,,العذراء كيم,
Dialogue: 0,0:28:04.35,0:28:05.77,نص عام,,0,0,0,,لم أرك منذ وقت طويل
Dialogue: 0,0:28:10.07,0:28:11.28,نص عام,,0,0,0,,السيد تشانغ جانج
Dialogue: 0,0:28:51.32,0:28:52.69,نص عام,,0,0,0,,هذا ابتلاع الروح
Dialogue: 0,0:28:55.65,0:28:57.87,خط مائل,,0,0,0,,لا بد أن تشان ووك قتله
Dialogue: 0,0:28:58.45,0:28:59.53,النص العام,,0,0,0,,هزم بضربة واحدة
Dialogue: 0,0:29:01.04,0:29:03.95,نص عام,,0,0,0,,لا يمكن إلقاء التعويذات هنا. كيف فعل ذلك؟
Dialogue: 0,0:29:06.33,0:29:08.00,general text,,0,0,0,,أين تشان ووك ومو دوك؟
Dialogue: 0,0:29:08.08,0:29:09.17,نص عام,,0,0,0,,ابحث عنهم
Dialogue: 0,0:29:09.88,0:29:11.13,نص عام,,0,0,0,,نعم
Dialogue: 0,0:29:21.89,0:29:25.02,general text,,0,0,0,,لقد راودتني رؤية عندما أحسست بالطاقة الموجودة في حجر الجليد
Dialogue: 0,0:29:26.06,0:29:28.56,نص عام,,0,0,0,,قالت الفتاة أنه لا يمكن لأحد أن يمتلك الحجر
Dialogue: 0,0:29:28.65,0:29:30.31,نص عام,,0,0,0,,لا يمكنك إلا استخدام القوة
Dialogue: 0,0:29:31.44,0:29:33.07,نص عام,,0,0,0,,لأن هذه هي طاقة السماء
Dialogue: 0,0:29:33.82,0:29:35.49,نص عام,,0,0,0,,يجب أن نتدرب،
Dialogue: 0,0:29:36.07,0:29:39.24,النص العام,,0,0,0,,للتحكم حتى في الطاقة التي بداخلنا
Dialogue: 0,0:29:39.32,0:29:42.20,general text,,0,0,0,,طاقة السماء بالطبع تفوق قدراتنا
Dialogue: 0,0:29:42.28,0:29:46.62,general text,,0,0,0,,لا يمكننا استخدامه بحرية لأنه ليس ملكنا
Dialogue: 0,0:29:49.42,0:29:50.83,نص عام,,0,0,0,,إذا كنت لا تستطيع إتقانها؟
Dialogue: 0,0:29:51.92,0:29:53.50,general text,,0,0,0,,ماذا لو تخليت عن كل ما أملك؟
Dialogue: 0,0:29:54.21,0:29:55.59,نص عام,,0,0,0,,أعطني ما لديك؟
Dialogue: 0,0:29:55.67,0:29:59.30,general text,,0,0,0,,ماذا لو وضعت كل طاقتي في السماء؟
Dialogue: 0,0:30:00.01,0:30:02.35,النص العام,,0,0,0,,حينها ستصبح طاقتي طاقة السماء
Dialogue: 0,0:30:05.93,0:30:08.06,نص عام,,0,0,0,,قرأت الملاحظات حول حجر الجليد
Dialogue: 0,0:30:08.14,0:30:10.02,نص عام,,0,0,0,,في مكتبة جيونجينجاك السرية
Dialogue: 0,0:30:11.81,0:30:14.73,خط مائل,,0,0,0,,يقولون إن حجر الجليد ليس له شكل
Dialogue: 0,0:30:14.82,0:30:17.65,مائل,,0,0,0,,يمكن أن يكون الماء أو النار أو الرياح
Dialogue: 0,0:30:17.74,0:30:19.95,خط مائل,,0,0,0,,غير قادر على معرفة حجمه
Dialogue: 0,0:30:20.03,0:30:23.37,مائل,,0,0,0,,يمكن أن تكون صغيرة أو ضخمة
Dialogue: 0,0:30:25.41,0:30:28.37,النص العام,,0,0,0,,وهذا يعني أن الحاجز المحيط بجونجينجاك
Dialogue: 0,0:30:28.46,0:30:30.29,نص عام,,0,0,0,,ليس الشكل الحقيقي لحجر الجليد
Dialogue: 0,0:30:30.83,0:30:32.88,النص العام,,0,0,0,,يمكن أن يتحول إلى ماء أو نار،
Dialogue: 0,0:30:32.96,0:30:35.67,نص عام,,0,0,0,,أصبح أكبر أو أصغر من الآن
Dialogue: 0,0:30:36.42,0:30:37.46,نص عام,,0,0,0,,نعم
Dialogue: 0,0:30:37.55,0:30:41.09,general text,,0,0,0,,هل تعتقد أننا نستطيع تحويل الضباب إلى مطر؟
Dialogue: 0,0:30:41.72,0:30:42.72,نص عام,,0,0,0,,تحت المطر؟
Dialogue: 0,0:30:42.80,0:30:45.64,general text,,0,0,0,,قلت إن قوتي لا تقارن بقوة الحجر
Dialogue: 0,0:30:46.27,0:30:48.14,النص العام,,0,0,0,,في وسعي قطرة ماء فقط
Dialogue: 0,0:30:48.23,0:30:52.73,general text,,0,0,0,,وإذا تحولت هذه القطرة إلى آلاف قطرات المطر؟
Dialogue: 0,0:30:54.69,0:30:56.82,نص عام,,0,0,0,,سوف تمطر
Dialogue: 0,0:30:56.90,0:30:58.44,نص عام,,0,0,0,,قد ينجح هذا
Dialogue: 0,0:30:59.32,0:31:01.24,نص عام,,0,0,0,,ولكن لهذا عليك استخدام Tansu
Dialogue: 0,0:31:01.32,0:31:03.66,general text,,0,0,0,,- إذًا...\N- إذن سأفقد كل طاقتي.
Dialogue: 0,0:31:04.70,0:31:07.83,نص عام,,0,0,0,,لذلك قلت أنه يجب علي أن أتخلى عن كل شيء
Dialogue: 0,0:31:12.00,0:31:13.00,نص عام,,0,0,0,,لا
Dialogue: 0,0:31:13.08,0:31:14.79,نص عام,,0,0,0,,ابتكر طريقة أخرى
Dialogue: 0,0:31:14.88,0:31:17.75,general text,,0,0,0,,يجب أن نسرع، وإلا ستجمع الملكة كل قوة الحجر
Dialogue: 0,0:31:18.76,0:31:19.92,النص العام,,0,0,0,,ثم سنموت جميعًا
Dialogue: 0,0:31:20.01,0:31:23.76,general text,,0,0,0,,المجلس يراقبها، ولن تفعل أي شيء متهور
Dialogue: 0,0:31:24.39,0:31:26.89,نص عام,,0,0,0,,تشان ووك، لا داعي لذلك
Dialogue: 0,0:31:27.51,0:31:29.14,نص عام,,0,0,0,,كمعلمكم، أنا آمر
Dialogue: 0,0:31:37.90,0:31:40.53,general text,,0,0,0,,لقد توقفت عن محاولة استعادة قوتي،
Dialogue: 0,0:31:40.61,0:31:42.32,نص عام,,0,0,0,,لكنني لن أسمح لك بإضاعة ما لدي
Dialogue: 0,0:31:43.74,0:31:45.82,نص عام,,0,0,0,,لقد وصلنا أنا وأنت حتى الآن
Dialogue: 0,0:31:46.66,0:31:48.24,النص العام,,0,0,0,,لقد حفزتك كثيرًا،
Dialogue: 0,0:31:48.33,0:31:50.91,النص العام,,0,0,0,,ولقد خاطرت بحياتك مرات عديدة
Dialogue: 0,0:31:56.50,0:31:59.96,general text,,0,0,0,,وهل أنت مستعد للتخلي عن كل شيء مقابل قطرة واحدة؟
Dialogue: 0,0:32:03.51,0:32:05.18,النص العام,,0,0,0,,يول أصيب بجروح خطيرة
Dialogue: 0,0:32:05.26,0:32:07.89,general text,,0,0,0,,إذا لم يفعلوا شيئاً فسوف يموت
Dialogue: 0,0:32:13.60,0:32:14.94,خط مائل,,0,0,0,,مو دوك
Dialogue: 0,0:32:15.56,0:32:18.73,النص العام,,0,0,0,,لقد تخليت عن كل شيء لحمايتي
Dialogue: 0,0:32:22.19,0:32:23.61,نص عام,,0,0,0,,أريد أن أحميك أيضًا
Dialogue: 0,0:32:24.49,0:32:28.53,general text,,0,0,0,,ويول أيضًا كان يحميك طوال هذا الوقت
Dialogue: 0,0:32:39.13,0:32:42.13,ذكريات بخط مائل,,0,0,0,,بدون نقل الدم يمكن أن يموت
Dialogue: 0,0:32:45.51,0:32:48.05,مائل,,0,0,0,,هذه الدودة من دماء عائلة جين...
Dialogue: 0,0:32:48.14,0:32:49.76,نص عام,,0,0,0,,إذا أعطيته إياها...
Dialogue: 0,0:33:26.38,0:33:28.09,نص عام,,0,0,0,,لا تمت يا سيدي
Dialogue: 0,0:33:29.60,0:33:31.10,نص عام,,0,0,0,,ابقَ على قيد الحياة
Dialogue: 0,0:34:01.63,0:34:04.09,نص عام,,0,0,0,,أزل العاكس. ماذا لو رأى شخص ما؟
Dialogue: 0,0:34:04.67,0:34:06.72,نص عام,,0,0,0,,لم أعد أحتمل المزيد
Dialogue: 0,0:34:07.22,0:34:09.09,نص عام,,0,0,0,,يجب أن أعيد الحجر
Dialogue: 0,0:34:09.18,0:34:11.35,نص عام,,0,0,0,,باستخدام العاكس
Dialogue: 0,0:34:13.76,0:34:15.02,نص عام,,0,0,0,,هل أنت مجنون؟
Dialogue: 0,0:34:15.10,0:34:16.85,general text,,0,0,0,,لا يمكنك إلقاء السحر باستخدام عاكس،
Dialogue: 0,0:34:16.93,0:34:18.60,نص عام,,0,0,0,,بينما المجلس الموحد هنا
Dialogue: 0,0:34:20.15,0:34:21.31,نص عام,,0,0,0,,تستحضر؟
Dialogue: 0,0:34:24.73,0:34:27.19,نص عام,,0,0,0,,هذا العاكس مصنوع من حجر الجليد
Dialogue: 0,0:34:27.28,0:34:30.11,general text,,0,0,0,,لكن الحجر يعتبر طيباً والعاكس شرير
Dialogue: 0,0:34:30.20,0:34:32.32,نص عام,,0,0,0,,هذا سخيف
Dialogue: 0,0:34:32.41,0:34:36.41,النص العام,,0,0,0,,اعتبره سخيفًا، لكن هذا هو نظام هذا العالم
Dialogue: 0,0:34:36.50,0:34:39.25,النص العام,,0,0,0,,نحن نفعل هذا حتى تتمكن من الخروج من الظلام
Dialogue: 0,0:34:39.33,0:34:41.79,نص عام,,0,0,0,,بدون وصم الساحرة
Dialogue: 0,0:34:42.54,0:34:43.54,نص عام,,0,0,0,,وصمة عار مخزية؟
Dialogue: 0,0:34:45.13,0:34:48.01,general text,,0,0,0,,لقد وصلت إلى هذا الحد باستخدام كيمياء عائلتي
Dialogue: 0,0:34:48.09,0:34:50.63,general text,,0,0,0,,كيف تجرؤ على التعامل مع هذا بازدراء؟
Dialogue: 0,0:34:53.55,0:34:58.35,general text,,0,0,0,,أنا فقط أقول أن كيمياء النفوس هي سحر غير معروف
Dialogue: 0,0:34:59.81,0:35:02.19,general text,,0,0,0,,لماذا يجب على العالم أن يعترف بذلك؟
Dialogue: 0,0:35:02.90,0:35:06.07,general text,,0,0,0,,عندما وجدنا حجر الجليد في بحيرة جيونج تشونج دايهو قبل عشر سنوات،
Dialogue: 0,0:35:06.15,0:35:09.78,general text,,0,0,0,,يمكننا استخدام قوته لرفع مستوى عائلة تشوي
Dialogue: 0,0:35:09.86,0:35:10.86,نص عام,,0,0,0,,ومع ذلك,
Dialogue: 0,0:35:10.95,0:35:14.03,النص العام,,0,0,0,,أصررت على أن أدخل جسد الملكة،
Dialogue: 0,0:35:14.12,0:35:16.41,النص العام,,0,0,0,,أنشأت منظمة سرية في جيونبوغوان،
Dialogue: 0,0:35:16.49,0:35:17.66,نص عام,,0,0,0,,والآن
Dialogue: 0,0:35:18.54,0:35:22.46,general text,,0,0,0,,تطالبون بالكشف عن حجر الجليد للعالم من خلال جينيوون
Dialogue: 0,0:35:23.79,0:35:27.84,general text,,0,0,0,,كان من الخطير جدًا أن تذهب ضد العالم بمساعدة السحر.
Dialogue: 0,0:35:27.92,0:35:31.76,النص العام,,0,0,0,,الأمر لا يتعلق بالخطر، بل بازدرائك
Dialogue: 0,0:35:32.26,0:35:34.72,نص عام,,0,0,0,,لم أرغب في أن أوصم بالسحر
Dialogue: 0,0:35:34.80,0:35:38.93,general text,,0,0,0,,أردت أن أستخدم القوة حتى يعبدك الجميع
Dialogue: 0,0:35:42.27,0:35:44.77,general text,,0,0,0,,لماذا تبحثين بشدة عن الاعتراف؟
Dialogue: 0,0:35:46.77,0:35:50.03,نص عام,,0,0,0,,لأنك لا تستطيع أن تتصالح مع حقيقة أن
Dialogue: 0,0:35:50.90,0:35:53.99,النص العام,,0,0,0,,ولد بسبب علاقة والده ولم يتم التعرف عليه أبدًا
Dialogue: 0,0:35:54.61,0:35:59.45,general text,,0,0,0,,أحد أفراد عائلة جين، لماذا كان عليك أن تهز ذيلك مثل كلب صغير أمام الجميع؟
Dialogue: 0,0:36:13.05,0:36:18.10,general text,,0,0,0,,على ما يبدو أن منصب الملكة أصبح عبئاً عليها،
Dialogue: 0,0:36:18.18,0:36:22.39,نص عام,,0,0,0,,أنها حصلت في السابق على بنسات مقابل قراءة حظها
Dialogue: 0,0:36:26.73,0:36:31.53,general text,,0,0,0,,إذا كان الأمر صعبًا للغاية، فسأحضر لك ضحيتين من البشر
Dialogue: 0,0:36:31.61,0:36:36.11,النص العام,,0,0,0,,اكتفي من أرواحهم واستجمع قواك
Dialogue: 0,0:37:03.39,0:37:06.48,مائل,,0,0,0,,هل وجدت الملكة الحقيقية؟
Dialogue: 0,0:37:07.73,0:37:11.27,general text,,0,0,0,,هل أحضرتها إلى سوسنوفي بور؟
Dialogue: 0,0:37:11.36,0:37:12.32,نص عام,,0,0,0,,نعم
Dialogue: 0,0:37:12.40,0:37:14.24,نص عام,,0,0,0,,إنها مع جين تشو يونغ
Dialogue: 0,0:37:17.07,0:37:18.82,نص عام,,0,0,0,,خذها إلى القاعة العلمية
Dialogue: 0,0:37:18.91,0:37:20.45,نص عام,,0,0,0,,سأكشف الحقيقة للجميع
Dialogue: 0,0:37:21.16,0:37:22.29,نص عام,,0,0,0,,لا, الفصل
Dialogue: 0,0:37:22.95,0:37:26.12,النص العام,,0,0,0,,قل هذا فقط للعائلة المالكة وشعب جينيوون
Dialogue: 0,0:37:27.50,0:37:31.71,general text,,0,0,0,,أنت رئيس سوسنوفي بور المستقبلي،
Dialogue: 0,0:37:31.80,0:37:35.59,general text,,0,0,0,,لكنك تقف هنا وتقلق بشأن سمعة جينيوون؟
Dialogue: 0,0:37:37.30,0:37:38.89,نص عام,,0,0,0,,لا أنكر ذلك
Dialogue: 0,0:37:40.68,0:37:43.89,general text,,0,0,0,,لكن سوسنوفي بور مسؤول أيضًا عن هذا
Dialogue: 0,0:37:45.60,0:37:49.27,general text,,0,0,0,,كان ساحر سوسنوفي بور هو بداية كل شيء
Dialogue: 0,0:37:49.35,0:37:52.36,نص عام,,0,0,0,,ساحر من سوسنوفي بور؟ من؟
Dialogue: 0,0:37:53.15,0:37:56.95,النص العام,,0,0,0,,والد جانغ ووك، غوانغجو تشانغ غانغ
Dialogue: 0,0:38:16.63,0:38:18.38,مائل,,0,0,0,,بناءً على طلب سوسنوفي بور
Dialogue: 0,0:38:18.47,0:38:21.64,general text,,0,0,0,,أرسلت الجميع بعيدًا باستثناء السحرة جيونبوغوان وجيني وون
Dialogue: 0,0:38:23.05,0:38:24.68,نص عام,,0,0,0,,ماذا تريد أن تخبرنا؟
Dialogue: 0,0:38:26.18,0:38:30.73,general text,,0,0,0,,سمعت أن ولي العهد كان يبحث عن شخص ما مؤخراً
Dialogue: 0,0:38:31.48,0:38:33.52,مائل,,0,0,0,,باك دان غو، ساحر جيونجينغاك،
Dialogue: 0,0:38:33.61,0:38:36.78,general text,,0,0,0,,وجين تشو يونغ، كاهنة جينيونغ وجدت هذا الرجل
Dialogue: 0,0:38:38.24,0:38:40.16,general text,,0,0,0,,هل كان ولي العهد يبحث عن أحد؟
Dialogue: 0,0:38:41.28,0:38:42.57,نص عام,,0,0,0,,ومن هو؟
Dialogue: 0,0:38:44.20,0:38:46.75,نص عام,,0,0,0,,هذا الشخص هنا الآن
Dialogue: 0,0:38:51.71,0:38:53.00,النص العام,,0,0,0,,سمعت أحدهم يرمي حجراً،
Dialogue: 0,0:38:53.08,0:38:55.80,نص عام,,0,0,0,,حيث مكتوب أن حجر الجليد ينزع القوة عند إلقاء التعويذات
Dialogue: 0,0:38:55.88,0:38:58.84,النص العام,,0,0,0,,لا يمكنهم إلقاء التعويذات؟
Dialogue: 0,0:38:58.92,0:39:01.30,النص العام,,0,0,0,,نفس القوة تستخدم في كيمياء النفوس
Dialogue: 0,0:39:01.38,0:39:04.76,النص العام,,0,0,0,,أعتقد أن الحجر يسلب القوة بنفس الطريقة التي يمتص بها النفوس
Dialogue: 0,0:39:04.85,0:39:08.43,general text,,0,0,0,,ثم ماذا سيحدث لأطفالنا؟
Dialogue: 0,0:39:08.52,0:39:10.73,general text,,0,0,0,,جميعكم أردتم قتل شخص ما بشدة،
Dialogue: 0,0:39:10.81,0:39:13.40,نص عام,,0,0,0,,لرؤية قوة الحجر
Dialogue: 0,0:39:13.48,0:39:15.36,نص عام,,0,0,0,,هل أنت خائف الآن؟
Dialogue: 0,0:39:15.94,0:39:19.86,general text,,0,0,0,,قوة حجر الجليد خارجة عن سيطرة البشر
Dialogue: 0,0:39:19.95,0:39:22.78,general text,,0,0,0,,لهذا السبب أصر سوسنوفي بور على تدميرها
Dialogue: 0,0:39:22.86,0:39:24.91,general text,,0,0,0,,ثم يجب على سوسنوفي بور اتخاذ الإجراءات اللازمة
Dialogue: 0,0:39:25.45,0:39:27.41,نص عام,,0,0,0,,ابني هناك
Dialogue: 0,0:39:27.49,0:39:28.95,نص عام,,0,0,0,,حفيدتي أيضًا
Dialogue: 0,0:39:29.45,0:39:32.33,النص العام,,0,0,0,,لو كنت أعرف ماذا أفعل لما وقفت هنا فحسب
Dialogue: 0,0:39:33.67,0:39:35.21,نص عام,,0,0,0,,الجميع هنا كان عطشانًا
Dialogue: 0,0:39:35.29,0:39:37.63,النص العام,,0,0,0,,قوة السماء وانظر إلى أين قادت
Dialogue: 0,0:39:38.42,0:39:40.84,النص العام,,0,0,0,,ماذا لو أدى هذا إلى الفوضى،
Dialogue: 0,0:39:40.92,0:39:43.68,نص عام,,0,0,0,,مثل 200 عام مضت؟
Dialogue: 0,0:39:44.26,0:39:45.35,نص عام,,0,0,0,,سو كيونغ...
Dialogue: 0,0:39:46.35,0:39:48.35,general text,,0,0,0,,المعلمة سو كيونغ حطمت حجارة الجليد
Dialogue: 0,0:39:49.47,0:39:52.31,general text,,0,0,0,,لم يترك سوى "كلمات القلب"؟
Dialogue: 0,0:39:52.39,0:39:56.27,نص عام,,0,0,0,,هذه القصيدة هي الشيء الوحيد الذي لدينا
Dialogue: 0,0:39:57.32,0:39:59.57,general text,,0,0,0,,لقد استدعينا قوة الحجر الجليدي،
Dialogue: 0,0:39:59.65,0:40:02.28,النص العام,,0,0,0,,يحتاج أحدنا إلى إصلاح هذا،
Dialogue: 0,0:40:03.24,0:40:05.78,نص عام,,0,0,0,,مثل المعلمة سو كيونغ منذ سنوات عديدة
Dialogue: 0,0:40:12.21,0:40:15.04,general text,,0,0,0,,أطلق المطر لتبديد قوة الحجر؟
Dialogue: 0,0:40:16.13,0:40:17.92,نص عام,,0,0,0,,لست متأكدًا مما إذا كانت ستمطر أم لا،
Dialogue: 0,0:40:18.00,0:40:21.17,النص العام,,0,0,0,,وهل سيتمكن هذا المطر من تخليصنا من الحاجز
Dialogue: 0,0:40:22.01,0:40:23.55,نص عام,,0,0,0,,هناك شيء واحد مؤكد
Dialogue: 0,0:40:24.47,0:40:26.05,نص عام,,0,0,0,,إذا كنت تستخدم Tansu هنا...
Dialogue: 0,0:40:27.01,0:40:28.10,نص عام,,0,0,0,,تشان أوك...
Dialogue: 0,0:40:29.01,0:40:31.02,النص العام,,0,0,0,,سوف تفقد كل طاقتك
Dialogue: 0,0:40:32.14,0:40:33.52,نص عام,,0,0,0,,أعلم
Dialogue: 0,0:40:33.60,0:40:35.10,نص عام,,0,0,0,,وما زلت تريد المحاولة؟
Dialogue: 0,0:40:38.02,0:40:40.28,نص عام,,0,0,0,,ربما لست ساحرًا من الطراز الأول،
Dialogue: 0,0:40:40.86,0:40:43.82,نص عام,,0,0,0,,لكنك رغم ذلك مررت بالكثير لتصل إلى هذا الحد
Dialogue: 0,0:40:44.49,0:40:46.03,general text,,0,0,0,,وتوافقون على خسارة كل شيء؟
Dialogue: 0,0:40:49.12,0:40:50.79,نص عام,,0,0,0,,سأتعامل مع الأمر
Dialogue: 0,0:40:51.37,0:40:53.46,نص عام,,0,0,0,,لكنني أريدك أن تساعدني في شيء ما
Dialogue: 0,0:40:55.12,0:40:57.79,النص العام,,0,0,0,,إذا اختفى حجر الجليد،
Dialogue: 0,0:40:58.46,0:41:01.30,نص عام,,0,0,0,,اهتم بالباقي
Dialogue: 0,0:41:03.97,0:41:06.55,general text,,0,0,0,,أولئك الذين اشتاقوا إلى قوته سيسخطون
Dialogue: 0,0:41:06.63,0:41:10.31,general text,,0,0,0,,قد يشتبهون في وجود خطأ ما ويعتقدون أنه مخفي في مكان ما
Dialogue: 0,0:41:10.39,0:41:14.60,النص العام,,0,0,0,,أي تصرف وكأني دمرت الحجر
Dialogue: 0,0:41:14.68,0:41:16.81,نص عام,,0,0,0,,والتعامل مع العواقب؟
Dialogue: 0,0:41:16.90,0:41:20.15,النص العام,,0,0,0,,تتحمل مسؤولية ما فعلته؟
Dialogue: 0,0:41:20.23,0:41:22.28,نص عام,,0,0,0,,أطلب منك ترتيب كل شيء
Dialogue: 0,0:41:22.36,0:41:25.07,نص عام,,0,0,0,,بعد الفوضى التي أحدثتها
Dialogue: 0,0:41:30.16,0:41:31.24,نص عام,,0,0,0,,شان ووك,
Dialogue: 0,0:41:31.95,0:41:34.20,النص العام,,0,0,0,,بالإضافة إلى الطاقة، يمكن أن تفقد حياتك
Dialogue: 0,0:41:34.29,0:41:36.08,نص عام,,0,0,0,,لا تكن غبيًا، فقط انسَ الأمر
Dialogue: 0,0:41:39.08,0:41:41.00,نص عام,,0,0,0,,أستاذتي الرائعة
Dialogue: 0,0:41:41.54,0:41:44.76,general text,,0,0,0,,دائماً ما يدفعني إلى حافة الهاوية ويقول ما يلي:
Dialogue: 0,0:41:45.30,0:41:48.76,مائل,,0,0,0,,"الموت خير من عدم القيام بأي شيء"
Dialogue: 0,0:41:51.10,0:41:54.85,النص العام,,0,0,0,,سأحاول ليس من باب الغباء، بل من باب العناد
Dialogue: 0,0:41:55.73,0:41:57.64,نص عام,,0,0,0,,هذا ما علمني إياه معلمي
Dialogue: 0,0:42:01.90,0:42:03.82,نص عام,,0,0,0,,لم أكن أعلم أن لديك معلمًا
Dialogue: 0,0:42:03.90,0:42:07.74,نص عام,,0,0,0,,من هذا؟ سيد لي تشول؟
Dialogue: 0,0:42:09.78,0:42:10.78,خط مائل,,0,0,0,,المضيف
Dialogue: 0,0:42:14.58,0:42:15.75,نص عام,,0,0,0,,لقد أحضرت سيفاً
Dialogue: 0,0:42:22.54,0:42:23.50,نص عام,,0,0,0,,وون مو ديوك
Dialogue: 0,0:42:24.96,0:42:27.63,general text,,0,0,0,,ألا تريد أن تقنعه بالعدول عن هذا التهور؟
Dialogue: 0,0:42:29.01,0:42:32.76,النص العام,,0,0,0,,الموت خير من عدم القيام بأي شيء
Dialogue: 0,0:42:36.60,0:42:37.56,نص عام,,0,0,0,,المضيف,
Dialogue: 0,0:42:39.06,0:42:40.60,نص عام,,0,0,0,,افعل ما عليك
Dialogue: 0,0:42:41.19,0:42:42.23,نص عام,,0,0,0,,و...
Dialogue: 0,0:42:43.15,0:42:44.73,نص عام,,0,0,0,,أنا أؤمن بك
Dialogue: 0,0:43:03.21,0:43:08.21,general text,,0,0,0,,الشخص الذي سيدخل هنا في حالة مزرية
Dialogue: 0,0:43:08.80,0:43:10.13,نص عام,,0,0,0,,قبل 20 عامًا
Dialogue: 0,0:43:10.22,0:43:13.60,general text,,0,0,0,,ألقت بنفسها في النار لتختبئ من جيونبوغوان
Dialogue: 0,0:43:19.43,0:43:21.64,النص العام,,0,0,0,,هذه شامان، كانت تقول الطالع.
Dialogue: 0,0:43:22.81,0:43:24.15,نص عام,,0,0,0,,وشعب ملعون
Dialogue: 0,0:43:27.28,0:43:28.53,نص عام,,0,0,0,,شامان؟
Dialogue: 0,0:43:29.28,0:43:33.07,general text,,0,0,0,,لقد كانت محبوسة كالحيوان لفترة طويلة جدًا،
Dialogue: 0,0:43:33.16,0:43:36.74,نص عام,,0,0,0,,في زنزانة صغيرة في محل الأعشاب في قرية جيما
Dialogue: 0,0:43:39.20,0:43:42.04,نص عام,,0,0,0,,لماذا كانت مقفلة؟
Dialogue: 0,0:43:42.12,0:43:44.29,نص عام,,0,0,0,,لقد طلبت منكم عقد هذا الاجتماع
Dialogue: 0,0:43:45.00,0:43:47.42,نص عام,,0,0,0,,أتمنى أن أعرف ذلك يا صاحب الجلالة
Dialogue: 0,0:43:49.17,0:43:50.72,خط مائل,,0,0,0,,جميع الموجودين هنا،
Dialogue: 0,0:43:50.80,0:43:56.26,general text,,0,0,0,,متصل بشامان تشوي، المرأة التي ستدخل هذه الغرفة قريبًا
Dialogue: 0,0:43:58.06,0:44:00.31,النص العام,,0,0,0,,- هذا كل شيء؟\N- {\i1}جلالتك
Dialogue: 0,0:44:00.39,0:44:02.73,نص عام,,0,0,0,,الآن ليس الوقت المناسب لهذا
Dialogue: 0,0:44:03.31,0:44:04.85,خط مائل,,0,0,0,,حجر الجليد أكثر أهمية
Dialogue: 0,0:44:04.94,0:44:06.90,النص العام,,0,0,0,,الأهم هو إنقاذ ولي العهد
Dialogue: 0,0:44:13.40,0:44:18.20,نص عام,,0,0,0,,الرئيس باك، أحضر الشامان هنا
Dialogue: 0,0:44:23.75,0:44:25.08,نص عام,,0,0,0,,تفضل بالدخول
Dialogue: 0,0:45:12.55,0:45:16.13,نص عام,,0,0,0,,شامان تشوي، أظهر وجهك
Dialogue: 0,0:45:43.62,0:45:45.08,نص عام,,0,0,0,,جلالتك
Dialogue: 0,0:45:46.75,0:45:51.59,general text,,0,0,0,,حتى في أحلامي لم أتخيل أنني سأرى وجهك مرة أخرى
Dialogue: 0,0:45:52.67,0:45:55.42,نص عام,,0,0,0,,هل تعرفني؟
Dialogue: 0,0:45:55.51,0:45:58.43,نص عام,,0,0,0,,أنا زوجتك يا صاحب السمو
Dialogue: 0,0:45:58.97,0:46:02.18,نص عام,,0,0,0,,أنا، سو ها سون، الملكة دايهو
Dialogue: 0,0:46:03.14,0:46:04.14,خط مائل,,0,0,0,,اخرس!
Dialogue: 0,0:46:04.22,0:46:07.35,general text,,0,0,0,,كيف تجرؤ على قول اسمي بفمك القذر؟
Dialogue: 0,0:46:08.02,0:46:09.77,نص عام,,0,0,0,,أنا ملكة هذا البلد!
Dialogue: 0,0:46:09.85,0:46:11.44,نص عام,,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:46:12.19,0:46:13.78,النص العام,,0,0,0,,لقد فعلت هذا بي
Dialogue: 0,0:46:14.36,0:46:17.70,النص العام,,0,0,0,,أيها الشامان المثير للشفقة، استخدمت كيمياء الروح
Dialogue: 0,0:46:17.78,0:46:20.32,نص عام,,0,0,0,,لنقل روحك القذرة...
Dialogue: 0,0:46:21.57,0:46:25.91,نص عام,,0,0,0,,إلى جسدي المقدس، جسد الملكة!
Dialogue: 0,0:46:26.00,0:46:27.83,النص العام,,0,0,0,,لقد اكتفيت من أكاذيبك
Dialogue: 0,0:46:28.50,0:46:30.12,نص عام,,0,0,0,,أيها النائب غوانغجو، لا تقف هناك!
Dialogue: 0,0:46:30.21,0:46:32.29,مائل,,0,0,0,,اخرس تلك المرأة المجنونة الآن!
Dialogue: 0,0:46:34.34,0:46:38.47,مائل,,0,0,0,,أولاً، علينا التحقق
Dialogue: 0,0:46:38.55,0:46:40.84,نص عام,,0,0,0,,هل تكذب أم لا
Dialogue: 0,0:46:42.35,0:46:43.39,نص عام,,0,0,0,,حسنًا
Dialogue: 0,0:46:44.47,0:46:46.27,النص العام,,0,0,0,,تقول إن روحها انتقلت
Dialogue: 0,0:46:46.35,0:46:49.56,general text,,0,0,0,,دعونا نتحقق مما إذا كانت الملكة لديها علامة زرقاء على جسدها
Dialogue: 0,0:46:54.23,0:46:58.15,general text,,0,0,0,,سيكون من دواعي سروري أن أعرضها عليك للمساعدة في التخلص من الشبهات
Dialogue: 0,0:47:08.58,0:47:12.21,النص العام,,0,0,0,,هل يجب أن أكشف كتفي هنا؟
Dialogue: 0,0:47:12.29,0:47:16.50,نص عام,,0,0,0,,يمكن إزالة العلامة الزرقاء بسهولة
Dialogue: 0,0:47:16.59,0:47:18.09,نص عام,,0,0,0,,وإلا فلا يمكن إثبات أي شيء
Dialogue: 0,0:47:21.80,0:47:23.30,نص عام,,0,0,0,,لدينا غويغو
Dialogue: 0,0:47:32.35,0:47:33.69,خط مائل,,0,0,0,,لدي رماد
Dialogue: 0,0:47:33.77,0:47:38.90,النص العام,,0,0,0,,كلب محروق عاشت فيه روح غويغو
Dialogue: 0,0:47:40.61,0:47:43.03,general text,,0,0,0,,ما تبقى من قوات غويغو سيساعدنا...
Dialogue: 0,0:47:48.54,0:47:49.41,نص عام,,0,0,0,,كشف الحقيقة
Dialogue: 0,0:47:54.21,0:47:56.00,نص عام,,0,0,0,,لا!
Dialogue: 0,0:47:59.84,0:48:02.26,نص عام,,0,0,0,,لا!
Dialogue: 0,0:48:09.27,0:48:10.52,نص عام,,0,0,0,,كما ترى,
Dialogue: 0,0:48:11.48,0:48:12.60,نص عام,,0,0,0,,كان...
Dialogue: 0,0:48:13.90,0:48:15.61,نص عام,,0,0,0,,لقد جمعت الرماد للتو
Dialogue: 0,0:48:16.56,0:48:18.07,نص عام,,0,0,0,,من الموقدة
Dialogue: 0,0:48:32.00,0:48:33.83,نص عام,,0,0,0,,لقد أثبتت ذلك بنفسك،
Dialogue: 0,0:48:34.42,0:48:37.92,نص عام,,0,0,0,,إنك بدويّ
Dialogue: 0,0:48:47.35,0:48:49.14,نص عام,,0,0,0,,امسك الشامان تشوي,
Dialogue: 0,0:48:49.22,0:48:53.43,نص عام,,0,0,0,,من استخدم كيمياء الروح للاستيلاء على السلطة
Dialogue: 0,0:48:53.52,0:48:54.81,نص عام,,0,0,0,,في جسد الملكة!
Dialogue: 0,0:48:54.89,0:48:55.98,خط مائل,,0,0,0,,- نعم!\N- نعم!
Dialogue: 0,0:48:56.60,0:48:57.73,نص عام,,0,0,0,,لا!
Dialogue: 0,0:49:00.27,0:49:04.03,النص العام,,0,0,0,,لا تؤذيها. هذا هو جسدي
Dialogue: 0,0:49:04.78,0:49:08.03,general text,,0,0,0,,لا بد أن تعود روحي إلى هذا الجسد. لا تؤذيه
Dialogue: 0,0:49:09.12,0:49:10.74,نص عام,,0,0,0,,لا تقترب
Dialogue: 0,0:49:12.20,0:49:16.37,نص عام,,0,0,0,,وإلا سأمزق هذا الجسد إرباً
Dialogue: 0,0:49:16.96,0:49:18.83,general text,,0,0,0,,هي من نسل الساحر تشوي،
Dialogue: 0,0:49:18.92,0:49:22.17,النص العام,,0,0,0,,الذي تسبب في الفوضى الكبرى قبل 200 عام
Dialogue: 0,0:49:23.59,0:49:26.80,النص العام,,0,0,0,,والعاكسات على الأغلب هي عملها
Dialogue: 0,0:49:27.72,0:49:30.22,general text,,0,0,0,,وهذا ما يفسر ظهور ابتلاع الروح مؤخراً
Dialogue: 0,0:49:31.26,0:49:33.22,مائل,,0,0,0,,هذه ساحرة شريرة
Dialogue: 0,0:49:33.31,0:49:35.89,خط مائل,,0,0,0,,أظهر حجر الجليد أمام المجلس الموحد
Dialogue: 0,0:49:36.48,0:49:38.44,نص عام,,0,0,0,,وجعل الجميع يبدو كالحمقى تمامًا
Dialogue: 0,0:49:39.61,0:49:41.44,النص العام,,0,0,0,,جميع السحرة في ديهو
Dialogue: 0,0:49:42.57,0:49:45.86,النص العام,,0,0,0,,العائلة المالكة، جيونبوغوان وجيني وون
Dialogue: 0,0:49:46.45,0:49:48.49,خط مائل,,0,0,0,,لقد تم خداع الجميع
Dialogue: 0,0:49:48.57,0:49:53.62,نص عام,,0,0,0,,أخ وأخت عائلة تشوي
Dialogue: 0,0:49:55.04,0:49:56.21,نص عام,,0,0,0,"أخ وأخت"؟
Dialogue: 0,0:50:03.30,0:50:04.67,نص عام,,0,0,0,,لذا،
Dialogue: 0,0:50:05.80,0:50:09.22,general text,,0,0,0,,هل أنت وهذا الشامان أخ وأخت؟
Dialogue: 0,0:50:13.76,0:50:15.56,general text,,0,0,0,,هل أنت فرد من عائلة تشوي؟
Dialogue: 0,0:50:23.52,0:50:24.98,نص عام,,0,0,0,,نعم
Dialogue: 0,0:50:29.36,0:50:30.61,نص عام,,0,0,0,,عذراً
Dialogue: 0,0:50:34.04,0:50:36.41,مائل,,0,0,0,,الابنة التي وجدتها مؤخرًا، جين بو يونغ،
Dialogue: 0,0:50:36.50,0:50:38.12,نص عام,,0,0,0,,وهمي أيضاً,
Dialogue: 0,0:50:39.33,0:50:40.46,نص عام,,0,0,0,,التي التقطوها
Dialogue: 0,0:50:41.83,0:50:45.96,general text,,0,0,0,,كانت خطتها التالية هي الانتقال إلى الجسد
Dialogue: 0,0:50:46.05,0:50:48.38,نص عام,,0,0,0,,ورثة جينيوون
Dialogue: 0,0:51:00.52,0:51:01.73,خط مائل,,0,0,0,,شامان تشوي,
Dialogue: 0,0:51:01.81,0:51:03.40,نص عام,,0,0,0,,ضع الخنجر جانباً
Dialogue: 0,0:51:03.48,0:51:06.44,نص عام,,0,0,0,,وإعادة هذا الجسد إلى صاحبة السمو الملكي
Dialogue: 0,0:51:06.53,0:51:07.74,نص عام,,0,0,0,,افعل كما أقول،
Dialogue: 0,0:51:08.65,0:51:13.49,النص العام,,0,0,0,,وسأنقذ حياة أخيك
Dialogue: 0,0:51:25.80,0:51:27.51,نص عام,,0,0,0,,تقول أنا شرير
Dialogue: 0,0:51:30.17,0:51:31.80,نص عام,,0,0,0,,لكن لا أحد هنا
Dialogue: 0,0:51:32.84,0:51:35.89,نص عام,,0,0,0,,ليس من حقي أن تناديني بهذا الاسم
Dialogue: 0,0:51:37.39,0:51:38.85,خط مائل,,0,0,0,,أريد أن أعرف
Dialogue: 0,0:51:38.93,0:51:42.73,general text,,0,0,0,,كيف تمكنت من الاستيلاء على جسد الملكة المقدس؟
Dialogue: 0,0:51:44.61,0:51:49.07,general text,,0,0,0,,أعطتني جسدها بسعادة لأنها أرادت تحريك روحها
Dialogue: 0,0:51:49.15,0:51:51.74,نص عام,,0,0,0,,لجسم شاب وجميل
Dialogue: 0,0:51:51.82,0:51:52.78,نص عام,,0,0,0,,جين هو كيونغ!
Dialogue: 0,0:51:54.07,0:51:56.95,general text,,0,0,0,,أليس أنت من أعلن عن حجر الجليد للعالم أجمع؟
Dialogue: 0,0:51:58.12,0:52:01.37,مائل,,0,0,0,,أنت رأس جينيوون، حامي آثاره
Dialogue: 0,0:52:01.46,0:52:02.79,نص عام,,0,0,0,,وترك الحجر
Dialogue: 0,0:52:02.87,0:52:06.25,نص عام,,0,0,0,,اترك جينيوون ليستخدمه في الكيمياء
Dialogue: 0,0:52:07.84,0:52:11.76,general text,,0,0,0,,والذي أجرى كيمياء النفوس،
Dialogue: 0,0:52:13.22,0:52:15.01,النص العام,,0,0,0,,كان ساحرًا من سوسنوفي بور
Dialogue: 0,0:52:16.05,0:52:17.56,خط مائل,,0,0,0,,بارك جين!
Dialogue: 0,0:52:17.64,0:52:20.35,general text,,0,0,0,,لقد أخفيت الحقيقة رغم أنك تعرف كل شيء
Dialogue: 0,0:52:21.06,0:52:25.27,general text,,0,0,0,,تصرفت كما لو كنت لا تستطيع الانتظار للقبض على كل من يمارس السحر
Dialogue: 0,0:52:25.35,0:52:30.23,general text,,0,0,0,,لكنك كنت تحاول فقط إخفاء خطيئة ذلك الساحر
Dialogue: 0,0:52:39.95,0:52:41.41,نص عام,,0,0,0,,أما أنت يا جين مو
Dialogue: 0,0:52:42.83,0:52:46.63,general text,,0,0,0,,لماذا تقف هناك ولا تفعل شيئًا؟
Dialogue: 0,0:52:48.59,0:52:52.80,general text,,0,0,0,,أنا الشرير الوحيد، بحكم منطقك ومبرراتك،
Dialogue: 0,0:52:54.26,0:52:56.09,نص عام,,0,0,0,,الذي توصلت إليه
Dialogue: 0,0:53:07.35,0:53:09.40,نص عام,,0,0,0,,المنطق تحدده القوة
Dialogue: 0,0:53:09.48,0:53:14.36,general text,,0,0,0,,لقد فقدت قوتك وهذا يجعلك شريرًا
Dialogue: 0,0:53:18.20,0:53:20.16,النص العام,,0,0,0,,جين مو، لن تفشل في خيبة أملك
Dialogue: 0,0:53:21.20,0:53:25.08,النص العام,,0,0,0,,إخلاصك متقلب كالريح
Dialogue: 0,0:53:25.16,0:53:27.21,نص عام,,0,0,0,,اجتياز بقية العواكس
Dialogue: 0,0:53:28.00,0:53:29.50,نص عام,,0,0,0,,سنعيد جثمان الملكة،
Dialogue: 0,0:53:29.59,0:53:31.67,نص عام,,0,0,0,,ولن تتحجر
Dialogue: 0,0:53:32.88,0:53:37.13,النص العام,,0,0,0,,أنصحك أن تتبع كلامي إذا كنت تريد أن يعيش أخوك
Dialogue: 0,0:53:38.22,0:53:39.72,خط مائل,,0,0,0,,الأخت
Dialogue: 0,0:53:39.80,0:53:42.52,النص العام,,0,0,0,,استخدم العاكس المتبقي للهروب
Dialogue: 0,0:53:44.60,0:53:47.39,نص عام,,0,0,0,,هذا هو الشيء الوحيد الذي يمكنني فعله من أجلك
Dialogue: 0,0:53:49.94,0:53:51.02,نص عام,,0,0,0,,أنا آسف جدًا
Dialogue: 0,0:53:54.53,0:53:55.86,نص عام,,0,0,0,,أبي!
Dialogue: 0,0:53:55.95,0:53:57.07,خط مائل,,0,0,0,,أبي!
Dialogue: 0,0:53:58.61,0:53:59.57,خط مائل,,0,0,0,,أبي!
Dialogue: 0,0:54:07.46,0:54:08.62,خط مائل,,0,0,0,,أبي...
Dialogue: 0,0:54:20.84,0:54:22.30,خط مائل,,0,0,0,,أبي...
Dialogue: 0,0:54:42.41,0:54:46.58,general text,,0,0,0,,سأفعل ما تريد وأتخلص من حجر الجليد الشرير!
Dialogue: 0,0:54:46.66,0:54:47.87,نص عام,,0,0,0,,ومع ذلك,
Dialogue: 0,0:54:48.58,0:54:50.54,نص عام,,0,0,0,,عندما يختفي حجر الجليد،
Dialogue: 0,0:54:51.38,0:54:56.34,النص العام,,0,0,0,,سوف تموتون جميعاً أيضاً
Dialogue: 0,0:56:31.39,0:56:32.89,خط مائل,,0,0,0,,- انظر\N- ما هذا؟
Dialogue: 0,0:57:31.83,0:57:32.66,نص عام,,0,0,0,,تشان غان؟
Dialogue: 0,0:57:33.33,0:57:34.29,خط مائل,,0,0,0,,هل هذا "تشانغ غان"؟
Dialogue: 0,0:57:35.00,0:57:37.79,general text,,0,0,0,,جانغ جانج، غوانغجو جيونغبوغوان؟
Dialogue: 0,0:57:38.38,0:57:41.05,مائل,,0,0,0,,تشان جانج، هل هذا أنت حقًا؟
Dialogue: 0,0:57:41.63,0:57:43.46,نص عام,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:58:07.86,0:58:09.20,نص عام,,0,0,0,,عاكس الروح...
Dialogue: 0,0:58:19.46,0:58:21.59,نص عام,,0,0,0,,لقد اختفت الطاقة العاكسة
Dialogue: 0,0:58:22.46,0:58:25.30,نص عام,,0,0,0,,أحدهم أوقفه
Dialogue: 0,0:58:29.05,0:58:30.51,نص عام,,0,0,0,,غوانغجو تشانغ جانج هنا
Dialogue: 0,0:58:47.32,0:58:48.74,نص عام,,0,0,0,,تشان غان...
Dialogue: 0,0:58:49.95,0:58:52.83,النص العام,,0,0,0,,لقد استوعبت طاقة العاكس...
Dialogue: 0,0:58:54.16,0:58:55.70,نص عام,,0,0,0,,في جسمك؟
Dialogue: 0,0:59:02.54,0:59:05.71,خط مائل,,0,0,0,,لا تقترب منه
Dialogue: 0,0:59:05.80,0:59:08.09,general text,,0,0,0,,تشان غان بدوي وقد أصبح جامحًا
Dialogue: 0,0:59:08.80,0:59:10.05,خط مائل,,0,0,0,,انظر
Dialogue: 0,0:59:10.13,0:59:13.01,مائل,,0,0,0,,يتحول جسده كله إلى حجر
Dialogue: 0,0:59:15.64,0:59:16.52,نص عام,,0,0,0,,إنه على حق
Dialogue: 0,0:59:17.85,0:59:20.98,general text,,0,0,0,,لقد قمت بكيمياء النفوس المحرمة وأصبحت بدوياً
Dialogue: 0,0:59:21.69,0:59:22.90,نص عام,,0,0,0,,الآن أنا مجنون
Dialogue: 0,0:59:24.40,0:59:26.11,النص العام,,0,0,0,,أنت غوانغجو جيونبوغوان
Dialogue: 0,0:59:26.19,0:59:28.15,النص العام,,0,0,0,,ولقد استخدمت السحر؟
Dialogue: 0,0:59:28.24,0:59:31.07,النص العام,,0,0,0,,السيد لي تشول، تلميذ المعلم سو كيونغ،
Dialogue: 0,0:59:32.36,0:59:35.99,general text,,0,0,0,,أمرني أن أعترف بذنوبي أمام المجلس الموحد
Dialogue: 0,0:59:37.24,0:59:38.91,نص عام,,0,0,0,,لهذا السبب أنا هنا
Dialogue: 0,0:59:43.67,0:59:46.21,ذكريات بخط مائل,,0,0,0,,إذا كان لا يزال لديك القوة لقراءة هذه الرسالة،
Dialogue: 0,0:59:46.30,0:59:49.26,ذكريات بخط مائل,,0,0,0,,استخدم قوتك المتبقية لمساعدة أولئك الذين يعانون
Dialogue: 0,0:59:49.34,0:59:51.01,ذكريات بخط مائل,,0,0,0,,الفوضى التي أحدثتها
Dialogue: 0,0:59:52.47,0:59:55.26,ذكريات بخط مائل,,0,0,0,,هذه فرصة لك لإكمال ما بدأته
Dialogue: 0,0:59:56.10,0:59:58.93,ذكريات مائلة,,0,0,0,,ثم سيشرق نجم،
Dialogue: 0,0:59:59.02,1:00:01.06,ذكريات مائلة,,0,0,0,,وسيغرق الحجر
Dialogue: 0,1:00:05.52,1:00:07.32,نص عام,,0,0,0,,أنا مسؤول
Dialogue: 0,1:00:08.40,1:00:11.49,النص العام,,0,0,0,,لكل أخطاء سوسنوفي بور وجيني وون وجيونبوغوان
Dialogue: 0,1:00:12.99,1:00:15.03,نص عام,,0,0,0,,لقد أخذت حجر الجليد من جينيوون
Dialogue: 0,1:00:16.12,1:00:18.12,مائل,,0,0,0,,ومارس السحر
Dialogue: 0,1:00:19.54,1:00:22.25,خط مائل,,0,0,0,,حاولت إبقاء الأمر سراً
Dialogue: 0,1:00:23.75,1:00:26.67,general text,,0,0,0,,سوف أتحجر هنا للتكفير عن كل خطاياي
Dialogue: 0,1:00:29.17,1:00:32.05,general text,,0,0,0,,كان غوانغجو تشانغ جانج هو من بدأ كل شيء،
Dialogue: 0,1:00:32.13,1:00:34.68,نص عام,,0,0,0,,لذلك سأدعه يضع حداً لهذا
Dialogue: 0,1:00:35.76,1:00:37.05,نص عام,,0,0,0,,الموت
Dialogue: 0,1:00:44.94,1:00:47.73,نص عام,,0,0,0,,شاهد السقوط المأساوي للإنسان،
Dialogue: 0,1:00:48.69,1:00:50.11,نص عام,,0,0,0,,من قام بالسحر
Dialogue: 0,1:00:50.19,1:00:52.19,نص عام,,0,0,0,,ربما هو بدوي،
Dialogue: 0,1:00:52.28,1:00:53.99,نص عام,,0,0,0,,لكن لا يمكنك تركه يموت هكذا
Dialogue: 0,1:00:54.07,1:00:56.57,نص عام,,0,0,0,,ابنه تشان ووك داخل جيونجينغاك
Dialogue: 0,1:00:56.66,1:00:59.74,مائل,,0,0,0,,انتظر حتى يخرج تشانغ ووك من هناك
Dialogue: 0,1:00:59.83,1:01:03.21,نص عام,,0,0,0,,يستحق أن يودع والده
Dialogue: 0,1:01:03.29,1:01:05.00,نص عام,,0,0,0,,إنه ليس ابني!
Dialogue: 0,1:01:05.62,1:01:07.67,general text,,0,0,0,,تعلمون جميعًا أنني أغلقت بوابة الطاقة الخاصة به،
Dialogue: 0,1:01:07.75,1:01:10.00,نص عام,,0,0,0,,لمنعه من السير على خطاي
Dialogue: 0,1:01:13.84,1:01:15.55,نص عام,,0,0,0,,كانت طفولته حزينة بالفعل
Dialogue: 0,1:01:16.80,1:01:19.10,نص عام,,0,0,0,,لا تدعه يُعرف بابن الخاطئ
Dialogue: 0,1:02:26.87,1:02:28.33,خلف الكواليس,,0,0,0,,أين أنا؟
Dialogue: 0,1:02:34.09,1:02:36.80,خلف الكواليس,,0,0,0,,ماذا يحدث؟ هل أنا ميت؟
Dialogue: 0,1:02:49.52,1:02:50.69,نص عام,,0,0,0,,حسنًا، لقد حدث ذلك
Dialogue: 0,1:02:51.77,1:02:53.52,نص عام,,0,0,0,,لقد اختفت طاقتي
Dialogue: 0,1:03:14.29,1:03:15.59,general text,,0,0,0,,هل هذا حجر جليدي؟
Dialogue: 0,1:03:16.80,1:03:20.84,general text,,0,0,0,,وجدته عندما تركتني كل قوتي
Dialogue: 0,1:03:22.39,1:03:23.68,نص عام,,0,0,0,,بالنسبة لي الآن
Dialogue: 0,1:03:24.89,1:03:26.64,نص عام,,0,0,0,,هذا ليس أكثر من مجرد حجر
Dialogue: 0,1:03:51.21,1:03:53.00,مائل,,0,0,0,,هذا هو نجم الملك!
Dialogue: 0,1:03:53.08,1:03:55.63,نص عام,,0,0,0,,نجم الملك أضاء في السماء
Dialogue: 0,1:04:32.12,1:04:35.00,general text,,0,0,0,,أشرق نجم الملك في السماء ونام الحاجز
Dialogue: 0,1:04:49.81,1:04:51.56,مائل,,0,0,0,,لقد اختفى حجر الجليد،
Dialogue: 0,1:04:52.52,1:04:54.69,خط مائل,,0,0,0,,وظهر نجم الملك
Dialogue: 0,1:04:55.90,1:04:58.23,general text,,0,0,0,,عندما أوقف المعلم سو كيونغ الفوضى الكبرى
Dialogue: 0,1:04:58.32,1:05:00.69,نص عام,,0,0,0,,كما ظهر نجم الملك
Dialogue: 0,1:05:01.53,1:05:04.70,مائل,,0,0,0,,هناك شخص ما داخل جيونجينجاك
Dialogue: 0,1:05:04.78,1:05:07.82,مائل,,0,0,0,,ولد بنفس مصير السيد سيو كيونغ؟
Dialogue: 0,1:05:27.93,1:05:29.76,نص عام,,0,0,0,,نجم الملك فوقه
Dialogue: 0,1:05:29.85,1:05:31.77,نص عام,,0,0,0,,إنه هو!
Dialogue: 0,1:05:46.70,1:05:48.53,نص عام,,0,0,0,,ولي العهد
Dialogue: 0,1:05:49.12,1:05:52.20,general text,,0,0,0,,لقد أشرق لك نجم الملك!
Dialogue: 0,1:05:52.29,1:05:54.50,النص العام,,0,0,0,,- سموك!\N- سموك!
Dialogue: 0,1:06:09.09,1:06:12.01,خلف الكواليس,,0,0,0,,ولد تشان ووك تحت برج نجم الملك
Dialogue: 0,1:06:13.31,1:06:16.10,التعليق الصوتي,,0,0,0,,هل تخلص من حجر الجليد؟
Dialogue: 0,1:06:44.30,1:06:46.38,التعليق الصوتي,,0,0,0,,يا طالبي، لقد فقدت كل طاقتك
Dialogue: 0,1:06:48.22,1:06:52.22,خلف الكواليس,,0,0,0,,يا معلم، أنت أيضًا أصبحت مجرد مو دوك
Dialogue: 0,1:06:54.85,1:06:56.39,نص عام,,0,0,0,,لا مانع لدي
Dialogue: 0,1:06:57.39,1:06:58.98,نص عام,,0,0,0,,بينما نحن معًا
Dialogue: 0,1:07:35.51,1:07:38.10,general text,,0,0,0,,سمعت أن حفل الزفاف سيقام في سوسنوفي بور
Dialogue: 0,1:07:38.18,1:07:40.94,نص عام,,0,0,0,,بالطبع. العريس - ساحر سوسنوفي بور
Dialogue: 0,1:07:41.44,1:07:43.23,نص عام,,0,0,0,,أنا لا أوافق على زواجهما
Dialogue: 0,1:07:43.31,1:07:45.73,نص عام,,0,0,0,,لا أصدق أنهم سيتزوجون
Dialogue: 0,1:07:45.82,1:07:47.78,نص عام,,0,0,0,,لقد رأيتهم معًا عدة مرات
Dialogue: 0,1:07:47.86,1:07:49.53,نص عام,,0,0,0,,يبدوان جيدين معًا
Dialogue: 0,1:07:49.61,1:07:52.41,نص عام,,0,0,0,,ماذا؟ كان بإمكانهم اختيار عريس أفضل
Dialogue: 0,1:07:52.49,1:07:53.87,نص عام,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,1:07:53.95,1:07:55.87,خط مائل,,0,0,0,,ويمكن قول الشيء نفسه عن العروس
Dialogue: 0,1:07:55.95,1:07:57.66,نص عام,,0,0,0,,كان الناس يتحدثون فقط
Dialogue: 0,1:07:57.74,1:08:00.08,نص عام,,0,0,0,,عن المجلس المتحد ونجم الملك
Dialogue: 0,1:08:00.16,1:08:03.00,نص عام,,0,0,0,,والآن يناقشون حفل الزفاف القادم
Dialogue: 0,1:08:04.63,1:08:07.88,نص عام,,0,0,0,,لهذا السبب أصر الرئيس على العرس
Dialogue: 0,1:08:07.96,1:08:11.34,general text,,0,0,0,,يجب أن أعترف، ما زلت لا أصدق أن هذين الاثنين سيتزوجان
Dialogue: 0,1:08:14.01,1:08:17.39,نص عام,,0,0,0,,سيد. يول، سمعت أنك لم تأكل أي شيء
Dialogue: 0,1:08:18.06,1:08:19.97,نص عام,,0,0,0,,سآكل عندما أشعر بالجوع
Dialogue: 0,1:08:20.06,1:08:21.77,نص عام,,0,0,0,,دعني أعد لك بعض الكوكسا
Dialogue: 0,1:08:22.39,1:08:24.02,نص عام,,0,0,0,,وتحتاج إلى تناول الدواء
Dialogue: 0,1:08:26.11,1:08:29.15,النص العام,,0,0,0,,لم أعد بحاجة إلى الدواء. توقف عن إزعاجي بهم
Dialogue: 0,1:08:29.73,1:08:31.61,النص العام,,0,0,0,,ستعود إلى قلعة سوهو قريبًا
Dialogue: 0,1:08:31.70,1:08:33.66,نص عام,,0,0,0,,عليك أن تأكل جيداً أثناء وجودك هنا...
Dialogue: 0,1:08:40.04,1:08:41.54,نص عام,,0,0,0,,لقد شفى جرحي
Dialogue: 0,1:08:42.54,1:08:43.92,النص العام,,0,0,0,,لقد عادت الطاقة أيضًا
Dialogue: 0,1:08:45.46,1:08:47.67,النص العام,,0,0,0,,سمعتك تئن من الألم أثناء نومك
Dialogue: 0,1:08:48.59,1:08:50.00,نص عام,,0,0,0,,أعلم أنك تكذب
Dialogue: 0,1:08:52.59,1:08:54.09,نص عام,,0,0,0,,الجرح لا يكاد يؤلم
Dialogue: 0,1:09:00.06,1:09:03.39,نص عام,,0,0,0,,أنت كذاب سيئ
Dialogue: 0,1:09:05.19,1:09:08.23,general text,,0,0,0,,إن قلبك نقي، فكلما كذبت،
Dialogue: 0,1:09:08.82,1:09:10.82,نص عام,,0,0,0,,هذا واضح
Dialogue: 0,1:09:12.78,1:09:14.53,نص عام,,0,0,0,,إنه مكتوب على وجهك مباشرة
Dialogue: 0,1:09:16.70,1:09:19.62,general text,,0,0,0,,لا بد أنه كان من الصعب عليك إخفاء ذلك لفترة طويلة
Dialogue: 0,1:09:27.25,1:09:28.42,نص عام,,0,0,0,,عذراً
Dialogue: 0,1:09:30.55,1:09:32.01,نص عام,,0,0,0,,وشكرًا لك،
Dialogue: 0,1:09:33.88,1:09:35.09,نص عام,,0,0,0,,ما دافعوا عنه
Dialogue: 0,1:09:41.68,1:09:45.14,ذكريات بخط مائل,,0,0,0,,يول كان يحميك طوال هذا الوقت
Dialogue: 0,1:09:48.77,1:09:50.82,ذكريات,,0,0,0,,إنه يعرف من أنت
Dialogue: 0,1:09:52.19,1:09:53.69,ذكريات,,0,0,0,,يعرف أنك بدويّ
Dialogue: 0,1:09:53.78,1:09:55.65,ذكريات,,0,0,0,,يعرف أنك ناك سو
Dialogue: 0,1:09:56.53,1:09:58.32,ذكريات,,0,0,0,,لقد حاول جاهداً ألا يُظهر ذلك
Dialogue: 0,1:10:03.70,1:10:07.46,ذكريات,,0,0,0,,لقد أراد حقًا حماية الفتاة التي التقى بها في دانهيانغوك
Dialogue: 0,1:10:15.92,1:10:17.38,نص عام,,0,0,0,,هذا
Dialogue: 0,1:10:17.47,1:10:20.60,نص عام,,0,0,0,,ملك لصديقك من Danhyangk
Dialogue: 0,1:10:22.10,1:10:23.22,نص عام,,0,0,0,,نعم
Dialogue: 0,1:10:25.31,1:10:27.60,نص عام,,0,0,0,,أردت أن آخذها معي
Dialogue: 0,1:10:27.69,1:10:29.77,نص عام,,0,0,0,,إلى قلعة سوهو
Dialogue: 0,1:10:35.53,1:10:39.07,النص العام,,0,0,0,,كان لديها سر تخفيه عن الجميع
Dialogue: 0,1:10:41.16,1:10:43.45,general text,,0,0,0,,فأردت أن آخذها إلى هناك وأخفيها
Dialogue: 0,1:10:48.25,1:10:49.92,نص عام,,0,0,0,,لقد وعدتك بأنني سأساعدك
Dialogue: 0,1:10:50.75,1:10:53.67,نص عام,,0,0,0,,خذها معك
Dialogue: 0,1:10:55.71,1:10:59.59,general text,,0,0,0,,لكن هذا الشخص الآن موجود فقط في ذكرياتك
Dialogue: 0,1:11:00.55,1:11:02.43,نص عام,,0,0,0,,إنها لم تعد في هذا العالم
Dialogue: 0,1:11:11.65,1:11:13.15,نص عام,,0,0,0,,في البداية اعتقدت،
Dialogue: 0,1:11:13.23,1:11:16.48,النص العام,,0,0,0,,حرقها سيمحوها من ذاكرتك
Dialogue: 0,1:11:17.94,1:11:20.57,النص العام,,0,0,0,,لكنك قلت أنك تعتز بذكريات دانهيانغوك
Dialogue: 0,1:11:26.33,1:11:27.66,نص عام,,0,0,0,,خذه معك
Dialogue: 0,1:11:41.05,1:11:43.18,نص عام,,0,0,0,,أريد التأكد من أنك في تحسن
Dialogue: 0,1:11:44.14,1:11:46.39,نص عام,,0,0,0,,أريد أن أشعر بأنفاسك الثلاثة
Dialogue: 0,1:12:07.20,1:12:09.16,نص عام,,0,0,0,,دعونا نودع بعضنا البعض
Dialogue: 0,1:12:12.00,1:12:14.79,نص عام,,0,0,0,,بينما تدوم هذه الأنفاس الثلاثة
Dialogue: 0,1:12:27.31,1:12:29.68,النص العام,,0,0,0,,كانت الذكريات عزيزة عليّ أيضاً
Dialogue: 0,1:12:31.73,1:12:33.60,نص عام,,0,0,0,,من Danhyanggok
Dialogue: 0,1:12:40.74,1:12:42.07,نص عام,,0,0,0,,شكرًا لك على كل شيء
Dialogue: 0,1:13:22.94,1:13:25.53,نص عام,,0,0,0,,يبدو أن جرحك يلتئم جيداً
Dialogue: 0,1:13:26.91,1:13:31.37,general text,,0,0,0,,أعلم أن الدواء مر، لكن تناوله بانتظام
Dialogue: 0,1:13:38.38,1:13:39.50,نص عام,,0,0,0,,حسنًا
Dialogue: 0,1:13:41.17,1:13:43.38,النص العام,,0,0,0,,سأشرب مهما كانت مرارته
Dialogue: 0,1:13:48.18,1:13:49.89,نص عام,,0,0,0,,هذه المرة سيلتئم الجرح كله
Dialogue: 0,1:14:29.26,1:14:32.60,نص عام,,0,0,0,,التضحية بحياتي,
Dialogue: 0,1:14:32.68,1:14:38.02,نص عام,,0,0,0,,والدك يتحمل مسؤولية ما حدث
Dialogue: 0,1:14:38.90,1:14:42.07,italics,,0,0,0,,بفضل تضحيته، لم يُعاقب سوسنوفي بور وجيني وون
Dialogue: 0,1:14:49.95,1:14:52.49,general text,,0,0,0,,ربما أنكر أنك ابنه،
Dialogue: 0,1:14:53.20,1:14:57.62,general text,,0,0,0,,لأنه لم يرد أن تُلام على خطاياه
الحوار: 0,1:15:01.29,1:15:02.63,نص عام,,0,0,0,,لا تقلق
Dialogue: 0,1:15:03.13,1:15:07.26,general text,,0,0,0,,لم أعد أهتم بحقيقة أنه قد لا يكون والدي
Dialogue: 0,1:15:11.43,1:15:14.89,نص عام,,0,0,0,,هل تعرفت على والدك؟
Dialogue: 0,1:15:15.77,1:15:17.89,نص عام,,0,0,0,,لم تلتقي من قبل
Dialogue: 0,1:15:20.52,1:15:21.90,نص عام,,0,0,0,,التقينا مرة واحدة
Dialogue: 0,1:15:23.31,1:15:24.73,نص عام,,0,0,0,,ربما إذن
Dialogue: 0,1:15:26.03,1:15:27.49,نص عام,,0,0,0,,لقد تعرف علي
Dialogue: 0,1:15:28.57,1:15:29.86,ذكريات بخط مائل,,0,0,0,,يبدو أنك
Dialogue: 0,1:15:30.57,1:15:32.24,ذكريات,,0,0,0,,أنت تعرف من أنا
Dialogue: 0,1:15:32.91,1:15:35.24,ذكريات,,0,0,0,,لديك سيف غوانغجو جيونبوغوان
Dialogue: 0,1:15:35.33,1:15:36.83,ذكريات,,0,0,0,,لا بد أنك ابنه
Dialogue: 0,1:16:08.73,1:16:12.11,general text,,0,0,0,,هذا هو السيف والرداء الذي أهدته العائلة المالكة لتشانغ غان،
Dialogue: 0,1:16:12.20,1:16:15.49,general text,,0,0,0,,غوانغجو السابق من جيونبوغوان، الذي توفي بسبب السحر
Dialogue: 0,1:16:15.58,1:16:20.29,النص العام,,0,0,0,,نود منك أن تقرر ما يجب أن نفعله بأغراضه
Dialogue: 0,1:16:20.87,1:16:22.33,نص عام,,0,0,0,,اترك في سوسنوفي بور
Dialogue: 0,1:16:23.75,1:16:25.84,نص عام,,0,0,0,,هل وجدت النائب جين مو؟
Dialogue: 0,1:16:26.59,1:16:27.71,نص عام,,0,0,0,,مازلنا نبحث عنه
Dialogue: 0,1:16:28.71,1:16:31.51,نص عام,,0,0,0,,نحن على يقين أنه لم يغادر العاصمة بعد
Dialogue: 0,1:16:31.59,1:16:33.30,النص العام,,0,0,0,,يمكن أن يستولي على جسد آخر
Dialogue: 0,1:16:34.55,1:16:36.97,general text,,0,0,0,,إذا فعل بنفسه مثل ما أفعل بي،
Dialogue: 0,1:16:37.05,1:16:38.64,general text,,0,0,0,,هل يتعرف عليه سوسنوفي بور؟
Dialogue: 0,1:16:39.77,1:16:41.98,النص العام,,0,0,0,,لقد تم خداعك طوال هذه السنوات
Dialogue: 0,1:16:45.90,1:16:47.23,خط مائل,,0,0,0,,صاحب السمو
Dialogue: 0,1:16:47.32,1:16:51.03,general text,,0,0,0,,لقد أصيب السيد "كانغ" من "ديجانجتونجون" بالجنون والذعر،
Dialogue: 0,1:16:51.11,1:16:53.20,general text,,0,0,0,,لكن سايجوكون تمكن من إنقاذه
Dialogue: 0,1:16:53.82,1:16:57.37,general text,,0,0,0,,إذا أصبحت جامحًا وبدأت تتحول إلى حجر،
Dialogue: 0,1:16:57.45,1:16:59.29,نص عام,,0,0,0,,نعرف طريقة لإنقاذك
Dialogue: 0,1:17:00.54,1:17:01.83,نص عام,,0,0,0,,ما الفائدة؟
Dialogue: 0,1:17:02.37,1:17:07.04,general text,,0,0,0,,سأضطر إلى العيش في هذا الجسد الرهيب لبقية أيامي
Dialogue: 0,1:17:09.17,1:17:11.92,general text,,0,0,0,,لقد سمحت لتشان ووك بالعيش، رغم أن والده مذنب بارتكاب جريمة
Dialogue: 0,1:17:12.01,1:17:14.13,نص عام,,0,0,0,,ماذا حدث لي
Dialogue: 0,1:17:14.22,1:17:15.51,خط مائل,,0,0,0,,تشانغ غان
Dialogue: 0,1:17:16.09,1:17:18.60,النص العام,,0,0,0,,تحمل المسؤولية كاملة مضحياً بنفسه
Dialogue: 0,1:17:19.51,1:17:21.47,general text,,0,0,0,,كما حرمنا تشان ووك من حقوقه
Dialogue: 0,1:17:22.35,1:17:25.94,نص عام,,0,0,0,,أصبح غوانغجو التالي لجيونبوغوان
Dialogue: 0,1:17:27.15,1:17:28.94,general text,,0,0,0,,غسل خطاياه،
Dialogue: 0,1:17:29.82,1:17:32.19,نص عام,,0,0,0,,فقد كل ما أملك
Dialogue: 0,1:17:34.03,1:17:37.57,general text,,0,0,0,,عندما مات تشانغ جانج، اعترف بأن ووك ليس ابنه
Dialogue: 0,1:17:37.66,1:17:39.70,general text,,0,0,0,,لا نستطيع أن ننقل المسؤولية إليه
Dialogue: 0,1:17:39.78,1:17:43.45,general text,,0,0,0,,مات تشانغ جانج دون الكشف عن اسم والد ووك الحقيقي
Dialogue: 0,1:17:51.63,1:17:53.26,ذكريات,,0,0,0,,أراد السيد تشانغ غان،
Dialogue: 0,1:17:54.22,1:17:56.51,ذكريات,,0,0,0,,لذلك أقدم لك هذه
Dialogue: 0,1:18:01.35,1:18:03.93,ذكريات,,0,0,0,,قال أنه سيكشف الحقيقة
Dialogue: 0,1:18:04.93,1:18:07.14,ذكريات,,0,0,0,,عن والد السيد تشان ووك الحقيقي
Dialogue: 0,1:18:30.42,1:18:31.59,ذكريات,,0,0,0,,أعتقد,
Dialogue: 0,1:18:32.84,1:18:35.88,ذكريات,,0,0,0,,الآن أنت أيتها الخادمة كيم، تعرفين الحقيقة.
Dialogue: 0,1:18:37.51,1:18:38.97,ذكريات,,0,0,0,,لا أصدق ذلك
Dialogue: 0,1:18:40.01,1:18:43.81,ذكريات,,0,0,0,,أنجبت السيدة دو هوا ابن الملك الراحل؟
Dialogue: 0,1:18:44.47,1:18:47.64,memories,,0,0,0,,حمل بأوكا عندما حرك الملك الراحل روحه...
Dialogue: 0,1:18:48.77,1:18:51.48,ذكريات,,0,0,0,,والاستلقاء مع دو هوا
Dialogue: 0,1:18:52.19,1:18:56.53,ذكريات,,0,0,0,,أجرى تشان غان الكيمياء وتبادل الأرواح...
Dialogue: 0,1:18:58.57,1:19:00.20,ذكريات,,0,0,0,,مع الملك الراحل
Dialogue: 0,1:19:02.28,1:19:07.12,ذكريات,,0,0,0,,السيد تشانغ غان دمر حياة ابنه
Dialogue: 0,1:19:08.96,1:19:10.58,general text,,0,0,0,,إذا علم السيد بهذا الأمر...
Dialogue: 0,1:19:12.08,1:19:13.67,نص عام,,0,0,0,,لن أكشف عن هذا
Dialogue: 0,1:19:15.17,1:19:18.80,نص عام,,0,0,0,,ليس فقط Uku,
Dialogue: 0,1:19:19.97,1:19:21.93,نص عام,,0,0,0,,سأبقي هذا سراً عن الجميع
Dialogue: 0,1:19:25.93,1:19:29.27,general text,,0,0,0,,النجم الذي ظهر في السماء عندما دمرت حجر الجليد،
Dialogue: 0,1:19:29.35,1:19:31.73,نص عام,,0,0,0,,تم نقشه على لوح الكوكبة
Dialogue: 0,1:19:31.81,1:19:35.48,النص العام,,0,0,0,,الجميع سعداء بالترحيب بالملك المولود في ظل قانون نجم الملك
Dialogue: 0,1:19:35.57,1:19:37.23,مائل,,0,0,0,,هل ترغب في النظر إلى العلامة؟
Dialogue: 0,1:19:39.15,1:19:40.32,نص عام,,0,0,0,,لا
Dialogue: 0,1:19:52.71,1:19:54.09,نص عام,,0,0,0,,نائب غوانغجو
Dialogue: 0,1:19:55.13,1:19:57.51,general text,,0,0,0,,نقلت الروح واختفت؟
Dialogue: 0,1:20:28.29,1:20:30.50,general text,,0,0,0,,مختبئ في جيونبوجوان كل هذا الوقت؟
Dialogue: 0,1:20:31.00,1:20:34.21,النص العام,,0,0,0,,كنت أنتظر فرصة مقابلتك يا صاحب السمو
Dialogue: 0,1:20:36.75,1:20:39.17,general text,,0,0,0,,هل تطلب مني إنقاذ حياتك؟
Dialogue: 0,1:20:39.26,1:20:41.88,نص عام,,0,0,0,,أنت وحدك من يستطيع إنقاذي،
Dialogue: 0,1:20:41.97,1:20:45.64,نص عام,,0,0,0,,وأنا وحدي من يستطيع حمايتك
Dialogue: 0,1:20:46.39,1:20:49.14,نص عام,,0,0,0,,تحميني؟ من ماذا؟
Dialogue: 0,1:20:49.22,1:20:52.14,general text,,0,0,0,,سأحميك من الوريث الحقيقي لنجم الملك
Dialogue: 0,1:20:53.19,1:20:56.44,general text,,0,0,0,,- ما الذي تتحدث عنه؟\N{\i1}- أنت تعلم بالفعل،
Dialogue: 0,1:20:56.52,1:20:58.94,النص العام,,0,0,0,,لست الوريث الحقيقي
Dialogue: 0,1:21:04.82,1:21:08.74,general text,,0,0,0,,الرجل الذي سوف يتفوق عليك... الرجل الذي سيُعبد
Dialogue: 0,1:21:08.83,1:21:12.66,general text,,0,0,0,,الرجل الذي سيهزمك
Dialogue: 0,1:21:13.25,1:21:14.67,النص العام,,0,0,0,,أنت الثاني فقط في ترتيب ولاية العرش
Dialogue: 0,1:21:14.75,1:21:17.71,general text,,0,0,0,,لا ينبغي السماح بتشان ووك، وريث النجم،
Dialogue: 0,1:21:18.50,1:21:19.75,نص عام,,0,0,0,,يرتفع فوقك
Dialogue: 0,1:21:21.92,1:21:26.59,general text,,0,0,0,,أعدك أن أنقذك من هذا النور المشؤوم.
Dialogue: 0,1:21:32.39,1:21:34.64,general text,,0,0,0,,الشيء الوحيد الذي كنت أسعى إليه بشدة...
Dialogue: 0,1:21:37.35,1:21:39.11,نص عام,,0,0,0,,في الواقع ينتمي إلى تشان ووك
Dialogue: 0,1:22:07.01,1:22:10.18,نص عام,,0,0,0,,كم هو لطيف. أنت جميلة
Dialogue: 0,1:22:11.76,1:22:14.48,نص عام,,0,0,0,,تبدين رائعة
Dialogue: 0,1:22:16.64,1:22:18.10,نص عام,,0,0,0,,امسح لعابك
Dialogue: 0,1:22:18.69,1:22:20.81,النص العام,,0,0,0,,- يمكنك خلعها الآن\N- لماذا...
Dialogue: 0,1:22:20.90,1:22:23.65,نص عام,,0,0,0,,هل طلبت مني فعلاً أن أرتدي هذا؟ لماذا لا العروس؟
Dialogue: 0,1:22:23.73,1:22:27.07,general text,,0,0,0,,والدها في حالة سيئة للغاية لذا لم تتمكن من الحضور
Dialogue: 0,1:22:27.15,1:22:29.53,general text,,0,0,0,,أنت وهي لديكما نفس اللياقة البدنية، لذا
Dialogue: 0,1:22:30.12,1:22:31.33,نص عام,,0,0,0,,يمكنك تغيير ملابسك
Dialogue: 0,1:22:32.87,1:22:35.12,نص عام,,0,0,0,,هيا. دعنا نذهب حتى تتمكن من تغيير الملابس
Dialogue: 0,1:22:35.87,1:22:38.79,خط مائل,,0,0,0,,- توقف عن التحديق. دعونا go\N- أنها أجمل فتاة رأيته في حياتي
Dialogue: 0,1:22:38.87,1:22:40.21,نص عام,,0,0,0,,هذا صحيح
Dialogue: 0,1:22:44.00,1:22:45.13,نص عام,,0,0,0,,أعتقد,
Dialogue: 0,1:22:46.09,1:22:47.72,نص عام,,0,0,0,,أبدو لطيفًا
Dialogue: 0,1:22:49.55,1:22:50.64,نص عام,,0,0,0,,انتظر
Dialogue: 0,1:22:50.72,1:22:52.47,general text,,0,0,0,,هل مو دوك هنا؟ أين هي؟
Dialogue: 0,1:22:52.56,1:22:53.81,نص عام,,0,0,0,,مو دوك الآن...
Dialogue: 0,1:22:56.64,1:22:58.44,نص عام,,0,0,0,,إنها في تلك الغرفة
Dialogue: 0,1:22:58.52,1:22:59.98,نص عام,,0,0,0,,- ادخل\N- حسنًا
Dialogue: 0,1:23:10.70,1:23:11.95,نص عام,,0,0,0,,واو...
Dialogue: 0,1:23:12.74,1:23:15.08,نص عام,,0,0,0,,سمعت أن هناك من سيتزوج قريباً
Dialogue: 0,1:23:15.87,1:23:16.79,نص عام,,0,0,0,,أليس هذا أنت؟
Dialogue: 0,1:23:17.71,1:23:18.71,نص عام,,0,0,0,,لا
Dialogue: 0,1:23:23.84,1:23:25.71,نص عام,,0,0,0,,انظر، هذه أستاذتي
Dialogue: 0,1:23:26.46,1:23:28.59,نص عام,,0,0,0,,قلت لك أن تنتظرني في سيجوكون
Dialogue: 0,1:23:28.67,1:23:31.51,general text,,0,0,0,,- لماذا أنت هنا؟\N- أرسلني هو يوم لتناول النبيذ
Dialogue: 0,1:23:31.59,1:23:33.26,النص العام,,0,0,0,,آه جو وول طلب ارتداء هذا
Dialogue: 0,1:23:33.35,1:23:36.18,نص عام,,0,0,0,,أحتاج إلى تغيير ملابسي. انتظر بالخارج
Dialogue: 0,1:23:36.27,1:23:37.56,نص عام,,0,0,0,,لا، انتظر
Dialogue: 0,1:23:37.64,1:23:40.77,نص عام,,0,0,0,,هذا المكان مناسب. هذا هو المكان الذي التقينا فيه لأول مرة
Dialogue: 0,1:23:42.31,1:23:43.98,نص عام,,0,0,0,,مناسب لماذا؟
Dialogue: 0,1:23:45.82,1:23:48.19,النص العام,,0,0,0,,للطقوس التي يجب أن نقوم بها
Dialogue: 0,1:23:49.15,1:23:50.82,خط مائل,,0,0,0,,أولاً، اجلس هنا
Dialogue: 0,1:24:01.71,1:24:03.17,نص عام,,0,0,0,,ماذا يحدث؟
Dialogue: 0,1:24:04.00,1:24:05.21,نص عام,,0,0,0,,هذا اختياري
Dialogue: 0,1:24:08.84,1:24:12.26,نص عام,,0,0,0,,توقف. أنت تحرجني. ما مشكلتك؟
Dialogue: 0,1:24:17.43,1:24:19.31,نص عام,,0,0,0,,هذا مربك فقط في البداية
Dialogue: 0,1:24:19.39,1:24:21.19,نص عام,,0,0,0,,لكن بعد المرة الثالثة عشر تعتاد عليه
Dialogue: 0,1:24:22.48,1:24:23.56,نص عام,,0,0,0,,ماذا؟
Dialogue: 0,1:24:24.19,1:24:26.27,نص عام,,0,0,0,,هل تقدمت بطلب الزواج 13 مرة؟
Dialogue: 0,1:24:28.78,1:24:29.90,نص عام,,0,0,0,,يا معلمة,
Dialogue: 0,1:24:30.61,1:24:34.16,نص عام,,0,0,0,,اليوم أريد أن أنهي تدريبي معك
Dialogue: 0,1:24:37.24,1:24:40.25,نص عام,,0,0,0,,شكرًا لأنك جعلتني أتدرب بجد
Dialogue: 0,1:24:40.83,1:24:43.08,نص عام,,0,0,0,,رغم أنني كنت أحمق تماماً
Dialogue: 0,1:24:45.25,1:24:46.42,خط مائل,,0,0,0,,أعلم,
Dialogue: 0,1:24:46.50,1:24:48.88,النص العام,,0,0,0,,لقد تركت الفرصة لاستعادة قوتك
Dialogue: 0,1:24:49.67,1:24:52.93,general text,,0,0,0,,تمامًا كما تخليت عن الطاقة التي أردت امتلاكها
Dialogue: 0,1:24:53.72,1:24:57.76,general text,,0,0,0,,ولكن لدي شيء أريد أن أبقيه بجانبي طوال حياتي
Dialogue: 0,1:25:01.56,1:25:05.98,نص عام,,0,0,0,,لا أريد أن يتم استغلالي وإلقائي بعيدًا. أريد الحماية والعناية
Dialogue: 0,1:25:06.65,1:25:09.61,نص عام,,0,0,0,,لذا... دعني أذهب
Dialogue: 0,1:25:14.99,1:25:16.49,نص عام,,0,0,0,,معلمك مو ديوك,
Dialogue: 0,1:25:17.57,1:25:19.70,نص عام,,0,0,0,,يسمح لتلميذه تشان ووك بالمغادرة
Dialogue: 0,1:25:24.46,1:25:25.50,نص عام,,0,0,0,,حسنًا إذن...
Dialogue: 0,1:25:26.71,1:25:29.55,النص العام,,0,0,0,,تتزوجني يا مو دوك؟
Dialogue: 0,1:26:01.83,1:26:04.58,معاينة,,0,0,0,,قررت الزواج من المالك
Dialogue: 0,1:26:04.66,1:26:05.87,معاينة,,0,0,0,,لم يكن لديك حتى صديقة
Dialogue: 0,1:26:05.96,1:26:07.67,معاينة,,0,0,0,,هذا كل شيء بالنسبة لمو ديوك
Dialogue: 0,1:26:07.75,1:26:08.67,معاينة,,0,0,0,,مستحيل!
Dialogue: 0,1:26:08.75,1:26:12.55,preview,,0,0,0,,سوف أجد سيفًا يسمح لك بضرب تشان ووك
Dialogue: 0,1:26:12.63,1:26:14.97,معاينة,,0,0,0,,جين مو يجب أن يموت
Dialogue: 0,1:26:15.05,1:26:18.59,preview,,0,0,0,,هل تقول أنهم جميعًا خدعوني وسخروا مني؟
Dialogue: 0,1:26:18.68,1:26:20.97,preview,,0,0,0,,إنهم يحاولون حماية تشان ووك
Dialogue: 0,1:26:21.05,1:26:23.10,معاينة,,0,0,0,,لقد ظهر قاتل في سايجوكون
Dialogue: 0,1:26:23.18,1:26:25.10,preview,,0,0,0,,أعتقد أن جثة مو ديوك تنتمي في الأصل إلى...
Dialogue: 0,1:26:25.18,1:26:27.10,معاينة,,0,0,0,,لشخص يتمتع بقدرة إلهية عظيمة
Dialogue: 0,1:26:28.27,1:26:31.98,معاينة,,0,0,0,,ناك سو، لقد منحتني الأمل
الحوار: 0,0:02:55.24,0:02:57.24,النكات,,0,0,0,,

