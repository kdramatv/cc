Dialog: 0,0:02:47.14,0:02:49.14,nicks,,0,0,0,,Koordinator proyek dan editor: {\c&HFFF4C5&} Ria_Lee
Dialog: 0,0:02:49.14,0:02:51.14,nicks,,0,0,0,,Asisten koordinator:{\c&HFFF4C5&} Sana, Martini
Dialogue: 0,0:02:51.14,0:02:53.14,nicks,,0,0,0,,Penerjemah juru ketik: {\c&HFFF4C5&} Ria_Lee, tommo
Dialog: 0,0:00:48.70,0:00:50.70,teks umum,,0,0,0,,Tunggu sebentar, Nyonya
Dialog: 0,0:00:50.79,0:00:52.54,teks umum,,0,0,0,,Jangan tutup matamu
Dialog: 0,0:00:52.62,0:00:53.83,teks umum,,0,0,0,,Jangan tertidur
Dialog: 0,0:01:04.30,0:01:06.26,caption,,0,0,0,,Aku harus menjadikan Do Hwa milikku. Jika dia hamil, maka anak itu milikku
Dialogue: 0,0:01:06.35,0:01:08.35,kenangan miring,,0,0,0,,Terima kasih
Dialog: 0,0:01:09.10,0:01:12.27,kenangan,,0,0,0,,minggu lalu luar biasa
Dialog: 0,0:01:17.23,0:01:18.69,kenangan,,0,0,0,,Do Hwa segera
Dialog: 0,0:01:20.03,0:01:21.99,kenangan,,0,0,0,,akan melahirkan anakku
Dialog: 0,0:01:24.41,0:01:25.53,kenangan,,0,0,0,,Yang Mulia
Dialog: 0,0:01:26.24,0:01:30.04,kenangan,,0,0,0,,Ingat prediksi yang kuterima di hari penobatanku?
Dialog: 0,0:01:30.62,0:01:34.12,kenangan,,0,0,0,,Kamu bilang aku akan punya anak laki-laki
Dialog: 0,0:01:34.92,0:01:37.96,kenangan,,0,0,0,,siapa yang akan memiliki energi bintang kerajaan
Dialog: 0,0:01:38.54,0:01:42.21,kenangan,,0,0,0,,Prediksinya salah. Itu tidak mungkin
Dialog: 0,0:01:44.68,0:01:45.88,kenangan,,0,0,0,,Tidak
Dialog: 0,0:01:47.43,0:01:50.06,kenangan,,0,0,0,,Ini harus menjadi kenyataan
Dialog: 0,0:01:51.06,0:01:54.18,kenangan,,0,0,0,,Aku akan mempunyai seorang putra berkat alkimia jiwamu
Dialog: 0,0:01:55.98,0:01:57.69,kenangan,,0,0,0,,Ingat ini
Dialogue: 0,0:01:58.90,0:02:00.77,kenangan,,0,0,0,,Do Hwa mengandung dan melahirkan
Dialog: 0,0:02:02.69,0:02:04.15,kenangan,,0,0,0,,anakku
Dialog: 0,0:02:07.20,0:02:08.53,kenangan,,0,0,0,,Dia akan menjadi milikku
Dialog: 0,0:03:07.01,0:03:10.64,kenangan miring,,0,0,0,,Bintang di tengah Biduk yang artinya rahasia alam,
Dialog: 0,0:03:10.72,0:03:15.35,kenangan miring,,0,0,0,,hanya muncul ketika langit dipenuhi energi perairan Deho
Dialogue: 0,0:03:23.36,0:03:26.19,kenangan miring,,0,0,0,,Anakku akan lahir saat bintang ini bersinar
Dialog: 0,0:03:36.58,0:03:39.96,kenangan,,0,0,0,,Mulai sekarang, aku melarang Chan Wook memasuki Sosnovy Bor
Dialog: 0,0:03:41.29,0:03:42.63,kenangan,,0,0,0,,Satu pukulan tersisa
Dialog: 0,0:03:42.71,0:03:44.09,kenangan,,0,0,0,,Dan terapkan sendiri yang terakhir ini
Dialog: 0,0:03:59.98,0:04:01.06,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:04:02.31,0:04:05.69,teks umum,,0,0,0,,Apakah tuan muda masih diam?
Dialog: 0,0:04:06.73,0:04:10.70,teks umum,,0,0,0,,Ya. Mereka memukul punggung saya, dan rasanya lidah saya terluka
Dialog: 0,0:04:10.78,0:04:13.20,teks umum,,0,0,0,,Dia menangis bahkan ketika jarinya dipukul
Dialog: 0,0:04:13.28,0:04:15.95,teks umum,,0,0,0,,Dan setelah seratus pukulan dia diam, seperti ikan
Dialog: 0,0:04:16.03,0:04:17.12,teks umum,,0,0,0,,aku khawatir
Dialog: 0,0:04:17.20,0:04:20.29,teks umum,,0,0,0,,Dia cengeng, jadi menurutku dia masih bisa menanggungnya
Dialog: 0,0:04:21.71,0:04:25.75,teks umum,,0,0,0,,Bukan punggungnya yang sakit, tapi hatinya
Dialog: 0,0:04:26.88,0:04:30.80,teks umum,,0,0,0,,Dia ditinggalkan oleh pria yang dia anggap ayahnya
Dialog: 0,0:04:30.88,0:04:32.43,teks umum,,0,0,0,,Bayangkan bagaimana rasanya baginya
Dialog: 0,0:04:33.76,0:04:35.55,teks umum,,0,0,0,,Betapa dia merasa ditinggalkan
Dialogue: 0,0:04:59.58,0:05:01.46,teks umum,,0,0,0,,Syukurlah kamu dipukul
Dialog: 0,0:05:02.16,0:05:05.33,teks umum,,0,0,0,,Mereka tidak akan mampu mengambil energinya saat ini
Dialog: 0,0:05:05.42,0:05:07.34,teks umum,,0,0,0,,Kamu punya lebih banyak waktu untuk berlatih
Dialog: 0,0:05:18.35,0:05:19.47,teks umum,,0,0,0,,Host
Dialog: 0,0:05:20.31,0:05:21.31,teks umum,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:05:41.62,0:05:43.75,teks umum,,0,0,0,,Mu Dok, lihat
Dialog: 0,0:05:43.83,0:05:46.12,teks umum,,0,0,0,,Menurutku lingkaran di atas air ini adalah kelebihanku
Dialog: 0,0:05:50.96,0:05:52.38,teks umum,,0,0,0,,Itu hanya riak
Dialogue: 0,0:05:54.09,0:05:56.89,teks umum,,0,0,0,,Kenapa tidak berhasil? Saya melatih pernapasan saya
Dialog: 0,0:05:56.97,0:05:59.30,teks umum,,0,0,0,,Jadi inilah yang kamu lakukan dalam diam
Dialog: 0,0:05:59.39,0:06:02.60,teks umum,,0,0,0,,Dan kupikir kau tenggelam dalam lautan kesedihan karena kau mengusirku
Dialog: 0,0:06:02.68,0:06:05.27,teks umum,,0,0,0,,- Aku salah\N- Apakah aku tenggelam dalam lautan kesedihan?
Dialog: 0,0:06:05.35,0:06:07.35,teks umum,,0,0,0,,Aku telah ditinggalkan sejak lahir
Dialog: 0,0:06:07.44,0:06:09.69,teks umum,,0,0,0,,Dan ini bukan pertama kalinya aku diusir dari suatu tempat
Dialog: 0,0:06:09.77,0:06:11.23,teks umum,,0,0,0,,Tidak menggangguku
Dialog: 0,0:06:17.03,0:06:18.53,teks umum,,0,0,0,,Anda akan lihat
Dialog: 0,0:06:18.62,0:06:22.04,teks umum,,0,0,0,,Aku akan membuat mereka memohon padaku untuk kembali ke Sosnovy Bor
Dialog: 0,0:06:23.45,0:06:25.12,teks umum,,0,0,0,,Kebodohan terkadang berguna, rupanya
Dialog: 0,0:06:25.71,0:06:26.71,teks umum,,0,0,0,,Ini adalah perwujudan kekuatan!
Dialogue: 0,0:06:30.34,0:06:33.09,teks umum,,0,0,0,,Mengapa panas sekali di sini?
Dialog: 0,0:06:33.71,0:06:35.59,teks umum,,0,0,0,,Panaskah? saya kedinginan
Dialog: 0,0:06:38.34,0:06:40.14,teks umum,,0,0,0,,Mengapa airnya menjadi panas sekali?
Dialog: 0,0:06:42.47,0:06:43.97,teks umum,,0,0,0,,Kenapa kamu terbakar?
Dialog: 0,0:06:44.93,0:06:48.69,teks umum,,0,0,0,,Saya merasa aneh. Suhu meningkat
Dialog: 0,0:06:48.77,0:06:50.11,teks umum,,0,0,0,,Ini adalah energi
Dialog: 0,0:06:51.23,0:06:52.44,teks umum,,0,0,0,,Tapi begitu cepat?
Dialogue: 0,0:06:55.32,0:06:56.90,teks umum,,0,0,0,,Ini soal tamparan
Dialog: 0,0:06:56.99,0:06:59.16,teks umum,,0,0,0,,Karena dia, terjadilah gelombang energi
Dialogue: 0,0:06:59.91,0:07:01.58,teks umum,,0,0,0,,Senang kamu dipukul
Dialog: 0,0:07:04.49,0:07:06.25,teks umum,,0,0,0,,Moo Dok, aku bersemangat
Dialog: 0,0:07:06.33,0:07:09.67,teks umum,,0,0,0,,Kamu akan menjadi panas sementara energi berubah menjadi panas
Dialog: 0,0:07:09.75,0:07:11.88,teks umum,,0,0,0,,Dan akan menjadi dingin ketika sudah dingin
Dialog: 0,0:07:11.96,0:07:14.59,teks umum,,0,0,0,,Energi hanya akan menjadi milikmu jika kamu menanganinya
Dialog: 0,0:07:15.76,0:07:18.55,teks umum,,0,0,0,,Bernafas perlahan
Dialog: 0,0:07:26.39,0:07:27.81,teks umum,,0,0,0,,Ini air dingin
Dialog: 0,0:07:41.49,0:07:42.62,teks umum,,0,0,0,,Moo Dok,
Dialog: 0,0:07:43.37,0:07:45.04,teks umum,,0,0,0,,apakah tuan muda masih mandi?
Dialog: 0,0:07:45.12,0:07:47.08,teks umum,,0,0,0,,Satu jam hampir berlalu
Dialog: 0,0:07:47.75,0:07:51.88,di belakang layar,,0,0,0,,Jika dia mengetahuinya, dia akan menceritakan semuanya di Sosnovy Bor, dan kita akan kehilangan energi
Dialogue: 0,0:07:51.96,0:07:52.83,teks umum,,0,0,0,,Obat herbal
Dialog: 0,0:07:54.38,0:07:56.63,teks umum,,0,0,0,,Dia mandi dengan ramuan herbal
Dialog: 0,0:07:57.21,0:07:58.92,teks umum,,0,0,0,,Saya sudah menyiapkan ramuannya,
Dialog: 0,0:07:59.01,0:08:01.84,teks umum,,0,0,0,,dan dia mandi di dalamnya agar lukanya sembuh
Dialog: 0,0:08:03.10,0:08:03.93,teks umum,,0,0,0,,Benarkah?
Dialog: 0,0:08:05.31,0:08:06.56,teks umum,,0,0,0,,Ide bagus
Dialog: 0,0:08:09.64,0:08:10.73,teks umum,,0,0,0,,Berdiri
Dialogue: 0,0:08:17.90,0:08:19.74,teks umum,,0,0,0,,Lalu kenapa airnya dingin?
Dialog: 0,0:08:19.82,0:08:21.03,teks umum,,0,0,0,,Apa?
Dialog: 0,0:08:21.11,0:08:24.07,teks umum,,0,0,0,,Air seharusnya sudah mendingin selama satu jam terakhir
Dialogue: 0,0:08:24.16,0:08:26.08,teks umum,,0,0,0,,Kenapa kamu masih membawanya dingin bukannya panas?
Dialog: 0,0:08:28.79,0:08:30.25,teks umum,,0,0,0,,Apakah dia demam?
Dialog: 0,0:08:32.08,0:08:33.25,teks umum,,0,0,0,,Tuan...
Dialog: 0,0:08:38.46,0:08:39.46,teks umum,,0,0,0,,Dia sedingin es
Dialogue: 0,0:08:40.17,0:08:41.76,teks umum,,0,0,0,,Bagaimana kamu membiarkan ini terjadi?
Dialog: 0,0:08:41.84,0:08:43.30,teks umum,,0,0,0,,Bagaimana jika dia sakit?
Dialog: 0,0:08:50.14,0:08:53.06,di balik layar,,0,0,0,,Air mendidih tiba-tiba berubah menjadi sedingin es
Dialog: 0,0:08:53.15,0:08:54.23,miring,,0,0,0,,Tn.
Dialog: 0,0:08:55.77,0:08:57.07,teks umum,,0,0,0,,Dimana dia?
Dialogue: 0,0:09:02.82,0:09:05.28,teks umum,,0,0,0,,Pak, kamu baik-baik saja?
Dialog: 0,0:09:05.99,0:09:07.20,miring,,0,0,0,,Ya
Dialog: 0,0:09:07.28,0:09:10.54,teks umum,,0,0,0,,Berenang membuat tubuhku rileks dan aku mulai mengantuk
Dialog: 0,0:09:13.33,0:09:15.88,miring,,0,0,0,,Berapa nilaimu? Siapkan tempat untuk tidur
Dialog: 0,0:09:17.17,0:09:20.46,teks umum,,0,0,0,,Dingin. Sekarang dia kedinginan
Dialog: 0,0:09:26.68,0:09:29.77,teks umum,,0,0,0,,Aku kedinginan. Sepertinya aku berubah menjadi es
Dialog: 0,0:09:30.68,0:09:34.39,teks umum,,0,0,0,,Dingin menyebar. Energi Anda tumbuh lebih cepat dari yang saya kira
Dialogue: 0,0:09:35.65,0:09:36.81,teks umum,,0,0,0,,Teruslah bernapas
Dialog: 0,0:10:02.51,0:10:03.97,teks umum,,0,0,0,,Dingin sekali hingga pikiran menjadi keruh
Dialog: 0,0:10:06.18,0:10:08.26,teks umum,,0,0,0,,Tunggu. Anda harus
Dialog: 0,0:10:10.64,0:10:13.18,teks umum,,0,0,0,,Chan Wook! Jangan tertidur!
Dialog: 0,0:10:13.27,0:10:15.06,teks umum,,0,0,0,,Jika kamu tertidur, kamu akan mati kedinginan
Dialog: 0,0:10:15.14,0:10:16.27,teks umum,,0,0,0,,Bangun
Dialog: 0,0:10:18.81,0:10:20.07,teks umum,,0,0,0,,Bernafas
Dialog: 0,0:10:31.03,0:10:34.54,teks umum,,0,0,0,,Paman, Yul dan aku adalah satu-satunya teman Uka
Dialog: 0,0:10:34.62,0:10:37.12,teks umum,,0,0,0,,Dan Sosnovy Bor adalah satu-satunya tempat yang dia sebut sebagai rumah
Dialog: 0,0:10:37.21,0:10:40.00,teks umum,,0,0,0,,Biarkan dia kembali
Dialog: 0,0:10:40.09,0:10:41.80,teks umum,,0,0,0,,Dia masih belum bisa berlatih
Dialog: 0,0:10:42.30,0:10:43.96,teks umum,,0,0,0,,Mereka tidak akan menerimanya di mana pun,
Dialog: 0,0:10:44.05,0:10:46.34,teks umum,,0,0,0,,ketika mereka mengetahui bahwa mereka juga mengusir mereka dari sini
Dialog: 0,0:10:47.88,0:10:49.76,teks umum,,0,0,0,,Cukup membicarakan dia
Dialog: 0,0:10:49.85,0:10:53.10,teks umum,,0,0,0,,Mulai sekarang, fokus pada pengembara dan jiwa yang menelan
Dialog: 0,0:11:01.94,0:11:04.23,teks umum,,0,0,0,,Dia seperti batu
Dialog: 0,0:11:05.53,0:11:06.90,teks umum,,0,0,0,,Jadi dia berubah menjadi batu
Dialog: 0,0:11:10.37,0:11:11.78,teks umum,,0,0,0,,Saat pengembara menjadi liar,
Dialog: 0,0:11:11.87,0:11:15.00,teks umum,,0,0,0,,mereka kehilangan energi, jadi mereka menyedotnya keluar dari manusia
Dialog: 0,0:11:17.25,0:11:19.29,teks umum,,0,0,0,,Seperti roh jahat
Dialogue: 0,0:11:19.37,0:11:22.00,teks umum,,0,0,0,,Sudah jelas kenapa santet ini dilarang
Dialog: 0,0:11:22.09,0:11:24.96,teks umum,,0,0,0,,Alkimia jiwa pada awalnya bukanlah ilmu sihir
Dialog: 0,0:11:25.55,0:11:27.17,teks umum,,0,0,0,,Bisa dikuasai
Dialog: 0,0:11:27.26,0:11:30.68,teks umum,,0,0,0,,baru menguasai Chipsu, Ryusa, Chisa dan terakhir Hwansu
Dialog: 0,0:11:30.76,0:11:32.26,teks umum,,0,0,0,,Hwangsu... Ini...
Dialog: 0,0:11:32.35,0:11:35.77,teks umum,,0,0,0,,kapan kamu bisa menukar api dengan air dan sebaliknya?
Dialog: 0,0:11:35.85,0:11:38.06,teks umum,,0,0,0,,- Orang tidak bisa melakukan ini\N- Tepat sekali
Dialog: 0,0:11:38.14,0:11:40.73,teks umum,,0,0,0,,Tetapi Tuan So Kyung, pendiri Hutan Pinus, mampu
Dialog: 0,0:11:40.81,0:11:42.56,teks umum,,0,0,0,,Ada satu lagi
Dialog: 0,0:11:42.65,0:11:43.69,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:11:43.77,0:11:45.69,teks umum,,0,0,0,,Kalau tidak, aku akan memberitahumu namanya dan kamu akan mengerti
Dialog: 0,0:11:47.15,0:11:49.82,teks umum,,0,0,0,,Siapa yang berani mencoba alkimia ini
Dialog: 0,0:11:49.91,0:11:52.57,teks umum,,0,0,0,,tentang siswa kita yang malang?
Dialog: 0,0:11:52.66,0:11:56.37,teks umum,,0,0,0,,Dia seharusnya bekerja di Jeonbugwan, membaca bintang
Dialog: 0,0:11:56.45,0:11:58.71,teks umum,,0,0,0,,Dia sering ke sana selama beberapa bulan terakhir
Dialog: 0,0:11:59.62,0:12:02.21,miring,,0,0,0,,Tepat. Ada juga yang menangkap orang Nak Su
Dialog: 0,0:12:02.29,0:12:04.71,teks umum,,0,0,0,,Kami tidak bisa, tapi ini sepertinya menunggu mereka
Dialog: 0,0:12:04.79,0:12:07.21,teks umum,,0,0,0,,Saya yakin itu ada hubungannya dengan
Dialog: 0,0:12:07.30,0:12:09.42,teks umum,,0,0,0,,kepada penelan jiwa ini
Dialog: 0,0:12:11.38,0:12:14.18,teks umum,,0,0,0,,Yul, Dan Gu, tonton Jeonbugwan
Dialog: 0,0:12:14.26,0:12:16.10,teks umum,,0,0,0,,Tiba-tiba kamu melihat sesuatu yang aneh
Dialog: 0,0:12:16.68,0:12:17.56,teks umum,,0,0,0,,- Ya\N- Ya
Dialog: 0,0:12:20.06,0:12:21.65,teks umum,,0,0,0,,Bagaimana dengan dia?
Dialog: 0,0:12:21.73,0:12:24.02,teks umum,,0,0,0,,Pintunya berfungsi sebentar-sebentar sejak Inggris mendobraknya
Dialog: 0,0:12:25.07,0:12:27.15,teks umum,,0,0,0,,- Chan Wook...\N- Jangan bergerak!
Dialog: 0,0:12:27.86,0:12:29.07,teks umum,,0,0,0,,Lantai akan runtuh
Dialog: 0,0:12:32.49,0:12:33.82,teks umum,,0,0,0,,Jangan bergerak
Dialog: 0,0:12:34.41,0:12:36.12,teks umum,,0,0,0,,Tunggu hingga pintu tertutup sepenuhnya
Dialog: 0,0:12:37.20,0:12:38.08,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:12:38.62,0:12:41.50,teks umum,,0,0,0,,Sudah kubilang jangan bergerak!
Dialog: 0,0:12:41.58,0:12:43.33,teks umum,,0,0,0,,Tolong aku!
Dialog: 0,0:12:45.46,0:12:46.59,teks umum,,0,0,0,,Diam
Dialog: 0,0:12:47.96,0:12:49.01,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:13:20.33,0:13:22.25,teks umum,,0,0,0,,Berbaring dulu
Dialog: 0,0:13:40.85,0:13:42.06,teks umum,,0,0,0,,Sapsari
Dialog: 0,0:13:43.06,0:13:44.23,teks umum,,0,0,0,,Keluar
Dialog: 0,0:13:44.94,0:13:46.65,teks umum,,0,0,0,,Ikut aku
Dialog: 0,0:14:31.15,0:14:32.94,teks umum,,0,0,0,,Senang kamu kembali
Dialog: 0,0:14:36.61,0:14:40.87,teks umum,,0,0,0,,Aku akan memberimu hadiah jika kamu menemukan pengembara
Dialog: 0,0:14:40.95,0:14:42.45,teks umum,,0,0,0,,Saya harap kita bekerja sama
Dialog: 0,0:15:12.65,0:15:13.78,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:15:15.65,0:15:17.36,teks umum,,0,0,0,,Jika aku mati kedinginan,
Dialog: 0,0:15:18.95,0:15:20.62,teks umum,,0,0,0,,ambil tenagaku,
Dialog: 0,0:15:22.83,0:15:24.91,teks umum,,0,0,0,,kalau bisa
Dialog: 0,0:15:26.20,0:15:29.08,teks umum,,0,0,0,,Jika aku bisa, aku sudah membunuhmu sejak lama dan membawamu pergi
Dialog: 0,0:15:32.00,0:15:33.67,teks umum,,0,0,0,,Aku kedinginan di sini,
Dialog: 0,0:15:35.26,0:15:37.26,teks umum,,0,0,0,,dan kamu melontarkan frasa dingin
Dialogue: 0,0:15:39.26,0:15:40.76,teks umum,,0,0,0,,Ucapkan sesuatu yang hangat
Dialog: 0,0:15:41.34,0:15:43.43,teks umum,,0,0,0,,Apakah kamu kehilangan akal sehat?
Dialog: 0,0:15:43.51,0:15:44.81,teks umum,,0,0,0,,Kamu akan mengatakan hal yang sama
Dialog: 0,0:15:49.64,0:15:51.73,teks umum,,0,0,0,,Chan Wook, buka matamu
Dialog: 0,0:15:52.52,0:15:55.44,teks umum,,0,0,0,,Oke, aku akan bilang sesuatu yang hangat
Dialog: 0,0:15:58.36,0:16:01.82,teks umum,,0,0,0,,Di tempat aku tinggal, sebuah pohon besar tumbuh
Dialog: 0,0:16:03.74,0:16:06.62,teks umum,,0,0,0,,Di paling atas ada sarang
Dialog: 0,0:16:07.29,0:16:09.04,teks umum,,0,0,0,,Ada satu telur di dalamnya
Dialog: 0,0:16:10.54,0:16:11.92,teks umum,,0,0,0,,Apakah kamu memakannya?
Dialog: 0,0:16:12.92,0:16:14.92,teks umum,,0,0,0,,Kamu akan merasa hangat mendengar kata-kataku
Dialog: 0,0:16:20.30,0:16:22.97,teks umum,,0,0,0,,Induk burung terbang masuk dan duduk di atasnya
Dialog: 0,0:16:27.43,0:16:31.85,teks umum,,0,0,0,,Aku seperti telur di puncak pohon
Dialog: 0,0:16:35.27,0:16:36.86,teks umum,,0,0,0,,Saya tidak kenal siapa pun,
Dialog: 0,0:16:38.78,0:16:40.65,teks umum,,0,0,0,,dan aku tidak berdaya
Dialog: 0,0:16:44.82,0:16:47.41,teks umum,,0,0,0,,Hanya kamu yang bisa menjagaku
Dialog: 0,0:16:51.46,0:16:52.71,teks umum,,0,0,0,,Hidupku
Dialog: 0,0:16:54.00,0:16:55.84,teks umum,,0,0,0,,di tanganmu
Dialog: 0,0:17:03.30,0:17:04.59,teks umum,,0,0,0,,Betapa hangatnya
Dialog: 0,0:17:10.73,0:17:12.02,teks umum,,0,0,0,,Lanjutkan
Dialog: 0,0:17:16.44,0:17:19.48,teks umum,,0,0,0,,Dan ada juga sebuah gua
Dialog: 0,0:17:21.78,0:17:24.03,teks umum,,0,0,0,,Seekor anak beruang tinggal di dalamnya
Dialog: 0,0:17:55.06,0:17:57.44,kenangan,,0,0,0,,Kamu bahkan tidak bisa mengambil pedang ayahmu
Dialog: 0,0:17:57.52,0:17:59.27,kenangan,,0,0,0,,Bagaimana kamu ingin belajar mantra?
Dialog: 0,0:18:01.03,0:18:03.49,kenangan,,0,0,0,,Tak seorang pun di Daeho bisa menolak ayahmu
Dialog: 0,0:18:03.57,0:18:05.70,kenangan,,0,0,0,,dan buka gerbang energimu
Dialog: 0,0:18:05.78,0:18:08.58,kenangan,,0,0,0,,Inilah takdir yang diberikan padamu
Dialog: 0,0:18:09.58,0:18:11.16,kenangan,,0,0,0,,ayahmu
Dialog: 0,0:18:32.52,0:18:33.68,teks umum,,0,0,0,,Kamu belum siap
Dialog: 0,0:18:39.98,0:18:42.44,teks umum,,0,0,0,,menggambar pedang ajaib
Dialog: 0,0:18:43.07,0:18:46.15,teks umum,,0,0,0,,Kamu harus menguasai Ryusu dan belajar cara melepaskan energi
Dialog: 0,0:18:46.95,0:18:50.16,teks umum,,0,0,0,,Kamu belum bisa melakukan ini, karena kamu tidak bisa mengendalikan energimu
Dialog: 0,0:18:50.91,0:18:53.79,teks umum,,0,0,0,,Ayahku meninggalkan pedang ini ketika dia meninggalkanku
Dialog: 0,0:18:53.87,0:18:56.08,teks umum,,0,0,0,,Saya hanya akan sampai ke Sosnovy Bor dengan mengeksposnya
Dialog: 0,0:18:58.83,0:19:00.92,teks umum,,0,0,0,,Saya ingin melakukan ini dan menunjukkannya kepada mereka
Dialog: 0,0:19:02.13,0:19:03.46,teks umum,,0,0,0,,Apakah ini manifestasi kebodohan?
Dialog: 0,0:19:03.55,0:19:04.84,teks umum,,0,0,0,,Tidak, kekuatan
Dialog: 0,0:19:07.09,0:19:09.97,teks umum,,0,0,0,,Kuatlah, Chan Wook
Dialog: 0,0:19:29.03,0:19:30.16,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:19:30.24,0:19:32.70,teks umum,,0,0,0,,Kami tiba di rumah Chang Gan, gwangju Jeonbugwan
Dialog: 0,0:19:37.04,0:19:38.25,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:19:40.29,0:19:42.67,teks umum,,0,0,0,,Anda kedatangan tamu
Dialog: 0,0:19:43.38,0:19:44.30,teks umum,,0,0,0,,Siapa?
Dialog: 0,0:19:44.38,0:19:47.63,teks umum,,0,0,0,,Putra Mahkota telah tiba
Dialog: 0,0:20:09.99,0:20:12.82,miring,,0,0,0,,Cuacanya benar-benar sempurna
Dialog: 0,0:20:12.91,0:20:16.08,miring,,0,0,0,,untuk memancing bersama Wook di dekat Gyeongcheongdaeho
Dialog: 0,0:20:18.16,0:20:20.96,teks umum,,0,0,0,,Aku ingin tahu apakah dia sudah sadar
Dialog: 0,0:20:22.54,0:20:24.63,teks umum,,0,0,0,,Aku memutuskan untuk mengunjunginya karena aku khawatir
Dialog: 0,0:20:24.71,0:20:26.38,teks umum,,0,0,0,,Mengapa kamu terlibat?
Dialog: 0,0:20:27.80,0:20:29.17,teks umum,,0,0,0,,Saya ingin memeriksa sesuatu
Dialog: 0,0:20:29.26,0:20:31.38,teks umum,,0,0,0,,Aku mengatakan sesuatu pada pembantunya
Dialog: 0,0:20:32.39,0:20:35.01,teks umum,,0,0,0,,Kami mengunjunginya sebagai teman,
Dialog: 0,0:20:35.10,0:20:36.68,teks umum,,0,0,0,,mengapa kamu ada di sini?
Dialog: 0,0:20:37.81,0:20:39.93,teks umum,,0,0,0,,Aku tidak sengaja menemukanmu
Dialog: 0,0:20:40.02,0:20:43.69,teks umum,,0,0,0,,Dan aku juga punya sesuatu untuk mencari-cari kesalahannya
Dialog: 0,0:20:43.77,0:20:46.32,teks umum,,0,0,0,,Begitu, tadinya aku akan menangkapnya
Dialog: 0,0:20:46.90,0:20:48.44,teks umum,,0,0,0,,Apa isi paketnya?
Dialogue: 0,0:20:51.32,0:20:53.49,teks umum,,0,0,0,,Obat lukanya
Dialog: 0,0:20:54.03,0:20:57.83,teks umum,,0,0,0,,Pertama kamu beri dia obat, lalu kamu duduk di telinganya
Dialog: 0,0:20:59.04,0:21:01.33,miring,,0,0,0,,Luar biasa
Dialog: 0,0:21:03.37,0:21:05.54,teks umum,,0,0,0,,Apakah kamu datang untuk pedang Nak Su?
Dialog: 0,0:21:05.63,0:21:07.55,teks umum,,0,0,0,,Raja mempercayakannya pada Jeonbugwan
Dialog: 0,0:21:08.05,0:21:11.30,teks umum,,0,0,0,,Jin Mu, wakil Gwangju harus menyimpannya, karena Gwangju sendiri tidak ada
Dialog: 0,0:21:15.51,0:21:18.31,teks umum,,0,0,0,,Karena Anda datang ke sini secara langsung, saya akan menyampaikannya kepada Anda
Dialog: 0,0:21:18.39,0:21:19.47,teks umum,,0,0,0,,Ambillah
Dialog: 0,0:21:20.10,0:21:20.93,miring,,0,0,0,,Bawakan pedang
Dialog: 0,0:21:22.73,0:21:23.85,teks umum,,0,0,0,,Itu belum semuanya
Dialog: 0,0:21:24.60,0:21:26.98,teks umum,,0,0,0,,Ada pedang lain di sini yang tidak bisa kamu tarik
Dialog: 0,0:21:28.65,0:21:32.15,teks umum,,0,0,0,,Mendiang raja memberikannya kepada Gwangju Chang Gang
Dialog: 0,0:21:32.78,0:21:34.36,teks umum,,0,0,0,,Aku ingin membawanya juga
Dialog: 0,0:21:34.45,0:21:37.24,teks umum,,0,0,0,,Tapi itu milik ayahnya
Dialog: 0,0:21:37.95,0:21:39.66,teks umum,,0,0,0,,Pedang di sebelah kanan tuan muda
Dialog: 0,0:21:39.74,0:21:41.29,teks umum,,0,0,0,,Tapi dia tidak pernah dipercaya dengan pedang ini
Dialog: 0,0:21:42.66,0:21:44.87,teks umum,,0,0,0,,Sebelumnya disimpan di Sosnovy Bor
Dialog: 0,0:21:44.96,0:21:47.88,teks umum,,0,0,0,,Kamu mengambilnya ketika kamu diusir dari sana, benarkan?
Dialog: 0,0:21:49.59,0:21:53.09,teks umum,,0,0,0,,Istana Kerajaan akan menyimpannya sampai pemilihan Gwangju baru
Dialog: 0,0:21:54.93,0:21:56.05,teks umum,,0,0,0,,Bawakan aku pedang
Dialog: 0,0:22:03.39,0:22:04.89,teks umum,,0,0,0,,Saya tidak bisa memberikannya begitu saja
Dialog: 0,0:22:06.52,0:22:10.32,teks umum,,0,0,0,,Seperti yang kalian tahu, mereka tidak mengenaliku sebagai anak ayah mereka
Dialog: 0,0:22:11.86,0:22:14.61,teks umum,,0,0,0,,Jika aku juga kehilangan pedangku, itu tidak akan berakhir baik bagiku
Dialog: 0,0:22:15.74,0:22:18.24,teks umum,,0,0,0,,Ini akan saya simpan, meskipun hanya sebagai hiasan
Dialog: 0,0:22:21.87,0:22:23.91,teks umum,,0,0,0,,Aku harus menjemputnya,
Dialog: 0,0:22:24.66,0:22:26.96,teks umum,,0,0,0,,dan kamu menolak. Tidak ada hubungannya
Dialog: 0,0:22:29.29,0:22:30.96,teks umum,,0,0,0,,Pemenang mengambil pedang
Dialog: 0,0:22:49.02,0:22:51.65,teks umum,,0,0,0,,Kamu tidak terlalu terlatih untuk bertarung dalam pertarungan sesungguhnya
Dialog: 0,0:22:58.53,0:23:00.70,teks umum,,0,0,0,,Bisakah kamu melampaui garis ini,
Dialog: 0,0:23:01.28,0:23:02.58,teks umum,,0,0,0,,aku pergi
Dialog: 0,0:23:17.30,0:23:21.93,teks umum,,0,0,0,,Aku yakin kamu berharap aku merendahkan diri di hadapanmu
Dialog: 0,0:23:23.26,0:23:26.60,teks umum,,0,0,0,,Melawanmu adalah manifestasi kebodohan
Dialog: 0,0:23:26.68,0:23:29.31,teks umum,,0,0,0,,Tetap saja, beberapa orang menganggap ini sebagai perwujudan kekuatan
Dialog: 0,0:23:29.40,0:23:30.44,teks umum,,0,0,0,,Jadi aku akan mencoba
Dialogue: 0,0:24:23.82,0:24:25.16,kenangan,,0,0,0,,Inilah energi
Dialogue: 0,0:24:25.24,0:24:26.54,kenangan,,0,0,0,,Ini tentang tamparan
Dialog: 0,0:24:26.62,0:24:28.66,kenangan,,0,0,0,,Ada gelombang energi karena dia
Dialogue: 0,0:24:29.54,0:24:30.54,kenangan,,0,0,0,,Senang kamu dipukul
Dialog: 0,0:24:31.17,0:24:34.88,di luar layar,,0,0,0,,Oke, kamu bisa memukul sebanyak yang kamu mau
Dialog: 0,0:25:54.00,0:25:55.29,teks umum,,0,0,0,,Kembali!
Dialog: 0,0:25:55.92,0:25:57.67,teks umum,,0,0,0,,Perhatian! Itu dari pispot!
Dialog: 0,0:26:10.06,0:26:11.60,teks umum,,0,0,0,,Apa yang telah kamu lakukan!
Dialog: 0,0:26:13.02,0:26:13.89,teks umum,,0,0,0,,Siapa ini?
Dialogue: 0,0:26:15.31,0:26:18.15,teks umum,,0,0,0,,- Aku melayani majikan\N- Beraninya pelayan ikut campur?
Dialog: 0,0:26:21.86,0:26:23.28,teks umum,,0,0,0,,Maaf, Yang Mulia
Dialogue: 0,0:26:23.36,0:26:25.03,teks umum,,0,0,0,,Pembantuku kurang ajar
Dialog: 0,0:26:27.62,0:26:28.53,teks umum,,0,0,0,,Apa ini?
Dialog: 0,0:26:31.33,0:26:33.79,teks umum,,0,0,0,,Menjijikkan
Dialog: 0,0:26:33.87,0:26:35.87,teks umum,,0,0,0,,Pulang, ganti baju
Dialog: 0,0:26:36.37,0:26:38.54,teks umum,,0,0,0,,- Apa?\N - Anda melewati batas
Dialog: 0,0:26:41.63,0:26:44.55,teks umum,,0,0,0,,Tentu saja, kamu tidak ingin menjadi kotor, tapi tetap saja,
Dialog: 0,0:26:44.63,0:26:45.80,teks umum,,0,0,0,,ini rugi
Dialog: 0,0:26:45.88,0:26:49.26,teks umum,,0,0,0,,Tepati janjimu dan tinggalkan pedang ayahku
Dialog: 0,0:26:50.26,0:26:51.81,miring,,0,0,0,,Seperti yang Anda lihat,
Dialog: 0,0:26:51.89,0:26:54.43,teks umum,,0,0,0,,Aku tidak bisa menemanimu karena aku terluka parah
Dialog: 0,0:27:02.15,0:27:03.44,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,0:27:04.44,0:27:05.65,miring,,0,0,0,,Oke
Dialog: 0,0:27:05.74,0:27:07.57,teks umum,,0,0,0,,Aku akan menepati janjiku dan meninggalkan pedang
Dialog: 0,0:27:08.28,0:27:09.28,teks umum,,0,0,0,,Tapi,
Dialog: 0,0:27:10.37,0:27:11.91,teks umum,,0,0,0,,Aku akan menghukumnya
Dialog: 0,0:27:17.12,0:27:19.71,teks umum,,0,0,0,,Aku tidak akan memaafkannya karena pakaiannya yang kotor
Dialog: 0,0:28:12.60,0:28:15.14,teks umum,,0,0,0,,Aku menghunus pedangku...
Dialog: 0,0:28:29.19,0:28:30.91,teks umum,,0,0,0,,Chan Wook!
Dialog: 0,0:28:30.99,0:28:33.57,teks umum,,0,0,0,,Kupikir kamu tidak bisa merapal mantra,
Dialog: 0,0:28:33.66,0:28:35.41,teks umum,,0,0,0,,dan kamu membodohi kami semua
Dialog: 0,0:28:35.99,0:28:36.83,teks umum,,0,0,0,,Tidak...
Dialog: 0,0:28:37.45,0:28:39.54,teks umum,,0,0,0,,Apa?
Dialog: 0,0:28:46.63,0:28:48.05,teks umum,,0,0,0,,Kamu!
Dialog: 0,0:28:48.13,0:28:50.42,teks umum,,0,0,0,,Beraninya kamu mengangkat pedang melawan Putra Mahkota?
Dialog: 0,0:28:50.51,0:28:52.68,teks umum,,0,0,0,,- Bukan, ini bukan aku\N- Uk, letakkan pedangmu!
Dialog: 0,0:28:53.68,0:28:55.89,teks umum,,0,0,0,,- Turunkan sekarang\N- Saya mencoba
Dialog: 0,0:28:56.47,0:28:57.47,teks umum,,0,0,0,,Tapi aku tidak bisa
Dialog: 0,0:29:20.87,0:29:22.48,teks umum,,0,0,0,,Berhenti sekarang, idiot!
Dialog: 0,0:29:23.50,0:29:25.17,teks umum,,0,0,0,,Saya tidak mengendalikannya!
Dialog: 0,0:29:37.64,0:29:38.64,teks umum,,0,0,0,,Chan Wook,
Dialog: 0,0:29:39.64,0:29:40.89,teks umum,,0,0,0,,mati!
Dialog: 0,0:29:50.78,0:29:51.82,teks umum,,0,0,0,,Berhenti
Dialog: 0,0:30:00.20,0:30:02.29,teks umum,,0,0,0,,- Berhenti\N- Aku tidak bisa mengendalikan tanganku
Dialog: 0,0:30:02.37,0:30:03.71,teks umum,,0,0,0,,Apa?
Dialog: 0,0:30:05.12,0:30:07.13,teks umum,,0,0,0,,Saya... Saya tidak bermaksud demikian
Dialog: 0,0:30:07.63,0:30:10.00,teks umum,,0,0,0,,Tuan Muda!
Dialog: 0,0:30:17.01,0:30:18.01,teks umum,,0,0,0,,Ini adalah gelang pengikat
Dialog: 0,0:30:18.10,0:30:20.76,teks umum,,0,0,0,,Berat badannya akan menjaga tanganmu tetap terkendali
Dialog: 0,0:30:27.15,0:30:30.82,di luar layar,,0,0,0,,Energinya mengalir ke satu tangan dan tak terkendali
Dialog: 0,0:30:32.44,0:30:33.61,teks umum,,0,0,0,,Lepaskan dia!
Dialog: 0,0:30:36.16,0:30:37.20,teks umum,,0,0,0,,Chan Wook
Dialog: 0,0:30:38.28,0:30:39.41,teks umum,,0,0,0,,Ambil pedang
Dialog: 0,0:30:41.62,0:30:42.58,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:30:42.66,0:30:44.66,teks umum,,0,0,0,,Dia bukan tandinganmu
Dialog: 0,0:30:44.75,0:30:46.33,teks umum,,0,0,0,,Anda adalah saksinya
Dialog: 0,0:30:46.42,0:30:48.96,teks umum,,0,0,0,,Dia mengarahkan pedang ayahnya ke arahku
Dialog: 0,0:30:49.04,0:30:51.59,teks umum,,0,0,0,,Dia hanya tidak mengendalikan energinya
Dialog: 0,0:30:51.67,0:30:54.17,teks umum,,0,0,0,,- Dia bahkan memukulku, kamu melihat\N- Diam!
Dialog: 0,0:30:56.18,0:30:58.76,teks umum,,0,0,0,,Yang Mulia, Anda adalah orang pertama yang mengarahkan bilah pedang Anda ke arahnya
Dialog: 0,0:30:59.35,0:31:01.39,teks umum,,0,0,0,,Pedang yang kamu lambaikan dalam kemarahan telah patah
Dialog: 0,0:31:01.47,0:31:03.89,teks umum,,0,0,0,,Kamu harus mematuhi adat istiadat para penyihir dan kembali ke istana
Dialog: 0,0:31:07.02,0:31:09.98,teks umum,,0,0,0,,Beraninya kamu menolak kemauanku?
Dialog: 0,0:31:12.40,0:31:16.03,teks umum,,0,0,0,,Chan, Jin, Seo dan Park. Keempatnya ada di depanku
Dialog: 0,0:31:16.95,0:31:19.57,teks umum,,0,0,0,,Aku menolak untuk kalah
Dialog: 0,0:31:19.66,0:31:20.82,teks umum,,0,0,0,,Apa yang akan kamu lakukan?
Dialog: 0,0:31:22.08,0:31:24.83,teks umum,,0,0,0,,Kalian berempat menyerang
Dialog: 0,0:31:32.63,0:31:34.51,teks umum,,0,0,0,,Gawat
Dialog: 0,0:31:34.59,0:31:37.59,teks umum,,0,0,0,,Sepertinya keluarga kita menentang keluarga kerajaan
Dialog: 0,0:31:37.67,0:31:39.59,miring,,0,0,0,,Semuanya menjadi serius
Dialog: 0,0:31:39.68,0:31:41.26,teks umum,,0,0,0,,Cho Young memprovokasi dia
Dialog: 0,0:31:41.35,0:31:43.01,teks umum,,0,0,0,,Apa yang kulakukan?
Dialog: 0,0:31:43.56,0:31:46.39,teks umum,,0,0,0,,Kalau begitu kita beri dia Uka saja
Dialog: 0,0:31:46.48,0:31:47.56,teks umum,,0,0,0,,Yang Mulia
Dialog: 0,0:31:48.27,0:31:50.69,teks umum,,0,0,0,,Ini adalah keluarga utama Deho
Dialog: 0,0:31:51.31,0:31:52.73,teks umum,,0,0,0,,Raja akan murka,
Dialog: 0,0:31:52.82,0:31:54.40,teks umum,,0,0,0,,jika dia mendengar tentang pertarungan ini
Dialog: 0,0:31:55.90,0:31:58.24,teks umum,,0,0,0,,Jadi apa? Haruskah aku pergi saja?
Dialog: 0,0:31:59.45,0:32:01.53,teks umum,,0,0,0,,Kamu seharusnya menghentikanku lebih awal
Dialog: 0,0:32:15.67,0:32:16.63,teks umum,,0,0,0,,Mu Dok...
Dialogue: 0,0:32:25.10,0:32:26.77,teks umum,,0,0,0,,Saya sungguh minta maaf, Yang Mulia
Dialog: 0,0:32:28.14,0:32:31.15,teks umum,,0,0,0,,Beraninya aku, tikus seperti itu, menumpahkan kotoran
Dialog: 0,0:32:31.23,0:32:32.48,teks umum,,0,0,0,,di bajumu?
Dialog: 0,0:32:37.65,0:32:39.95,teks umum,,0,0,0,,Maafkan aku. Sangat
Dialog: 0,0:32:40.03,0:32:41.16,teks umum,,0,0,0,,Pergi
Dialog: 0,0:32:41.24,0:32:43.53,teks umum,,0,0,0,,Hilang. Kamu bau
Dialog: 0,0:32:44.58,0:32:46.91,teks umum,,0,0,0,,Maafkan kami
Dialog: 0,0:32:50.75,0:32:55.54,teks umum,,0,0,0,,Sebagai tanda penyesalan yang tulus, aku akan menyelesaikan apa yang tersisa
Dialog: 0,0:32:56.46,0:32:58.71,teks umum,,0,0,0,,Jadi maafkan kami
Dialog: 0,0:33:08.68,0:33:09.64,teks umum,,0,0,0,,Moo Dok!
Dialogue: 0,0:33:11.98,0:33:14.10,teks umum,,0,0,0,,Kenapa kamu minum?
Dialog: 0,0:33:16.86,0:33:17.82,teks umum,,0,0,0,,Tuan!
Dialog: 0,0:33:21.07,0:33:22.61,teks umum,,0,0,0,,Aku harus minum ini
Dialog: 0,0:33:24.49,0:33:25.82,teks umum,,0,0,0,,Apa?
Dialog: 0,0:33:27.62,0:33:29.20,teks umum,,0,0,0,,Ini tidak benar
Dialog: 0,0:33:29.29,0:33:31.12,teks umum,,0,0,0,,Kenapa kamu?
Dialog: 0,0:33:31.21,0:33:33.71,teks umum,,0,0,0,,Akulah alasannya, jadi aku akan minum
Dialog: 0,0:33:33.79,0:33:36.63,teks umum,,0,0,0,,Tidak sama sekali. Yang Mulia marah padaku
Dialogue: 0,0:33:36.71,0:33:38.75,teks umum,,0,0,0,,Aku harus minum
Dialogue: 0,0:33:42.38,0:33:44.38,teks umum,,0,0,0,,Dan masih banyak lagi...
Dialog: 0,0:33:45.22,0:33:47.89,teks umum,,0,0,0,,Ayo kemari, aku mau minum
Dialog: 0,0:33:47.97,0:33:49.10,teks umum,,0,0,0,,Kalau begitu, bolehkah kita berbagi?
Dialog: 0,0:33:50.43,0:33:52.64,teks umum,,0,0,0,,Mengapa membagikan ini?
Dialog: 0,0:33:52.73,0:33:54.06,teks umum,,0,0,0,,Apa?
Dialog: 0,0:33:54.14,0:33:55.23,teks umum,,0,0,0,,Ambil semuanya
Dialog: 0,0:33:57.36,0:33:59.53,teks umum,,0,0,0,,Kalau begitu aku akan minum sedikit dan memberikannya padamu
Dialog: 0,0:33:59.61,0:34:02.32,teks umum,,0,0,0,,Bantu aku mengangkat, tanganku tidak bisa bergerak
Dialog: 0,0:34:06.32,0:34:07.16,teks umum,,0,0,0,,Tuan!
Dialog: 0,0:34:11.83,0:34:13.25,teks umum,,0,0,0,,Saya...
Dialog: 0,0:34:14.50,0:34:15.46,teks umum,,0,0,0,,minum
Dialog: 0,0:34:16.63,0:34:17.58,teks umum,,0,0,0,,Lupakan
Dialog: 0,0:34:17.67,0:34:19.55,teks umum,,0,0,0,,Mengapa Anda membutuhkannya?
Dialog: 0,0:34:19.63,0:34:20.75,teks umum,,0,0,0,,Keluar dari sini
Dialog: 0,0:34:20.84,0:34:23.09,miring,,0,0,0,,Ada berapa?
Dialog: 0,0:34:23.17,0:34:24.80,teks umum,,0,0,0,,Apakah Anda ingin saya membantu?
Dialog: 0,0:34:25.43,0:34:27.72,teks umum,,0,0,0,,- Serius?\N- Kemarilah
Dialog: 0,0:34:31.39,0:34:32.47,teks umum,,0,0,0,,Inilah kebenaran dari dalam pot...
Dialog: 0,0:34:35.85,0:34:37.06,teks umum,,0,0,0,,Yang Mulia
Dialogue: 0,0:34:37.15,0:34:39.15,teks umum,,0,0,0,,Beraninya kami bersaing denganmu?
Dialog: 0,0:34:39.86,0:34:41.28,teks umum,,0,0,0,,Apakah mereka benar-benar perlu minum
Dialog: 0,0:34:41.36,0:34:43.61,teks umum,,0,0,0,,omong kosong ini sebagai permintaan maaf?
Dialog: 0,0:34:46.99,0:34:48.37,teks umum,,0,0,0,,Untukmu
Dialog: 0,0:34:49.49,0:34:52.70,teks umum,,0,0,0,,Berhenti. Aku muak denganmu
Dialog: 0,0:34:55.16,0:34:56.33,teks umum,,0,0,0,,Ayo pergi
Dialogue: 0,0:34:58.08,0:35:01.46,teks umum,,0,0,0,,Yang Mulia berangkat! Tundukkan kepalamu!
Dialogue: 0,0:35:07.18,0:35:09.64,teks umum,,0,0,0,,Kenapa dia malah datang?
Dialogue: 0,0:35:10.26,0:35:12.22,teks umum,,0,0,0,,Dibalik pedang Nak Su
Dialog: 0,0:35:12.93,0:35:14.85,teks umum,,0,0,0,,Dan kemudian tiba-tiba perkelahian dimulai
Dialog: 0,0:35:15.52,0:35:18.35,teks umum,,0,0,0,,Hari ini dia pergi, tapi mengetahui karakternya,
Dialog: 0,0:35:18.85,0:35:20.52,teks umum,,0,0,0,,dia pasti akan membalas dendam
Dialog: 0,0:35:24.03,0:35:26.36,teks umum,,0,0,0,,- Apakah kamu baik-baik saja?\N- Dia memukulku berkali-kali
Dialog: 0,0:35:26.45,0:35:28.99,miring,,0,0,0,,Dan kamu memukulku dengan keras!
Dialog: 0,0:35:31.45,0:35:33.16,miring,,0,0,0,,- Apakah kamu baik-baik saja?\N- Saya kira begitu
Dialogue: 0,0:35:33.24,0:35:34.49,teks umum,,0,0,0,,- Sakit\N- Sakit?
Dialogue: 0,0:35:34.58,0:35:35.91,teks umum,,0,0,0,,- Apa di sini sakit?\N- Sakit
Dialog: 0,0:35:36.00,0:35:38.58,teks umum,,0,0,0,,- Sakit dimana-mana\N- Jangan sentuh dia
Dialog: 0,0:35:41.54,0:35:44.38,teks umum,,0,0,0,,Yang Mulia!
Dialog: 0,0:35:48.34,0:35:49.64,teks umum,,0,0,0,,Apa yang kamu inginkan?
Dialog: 0,0:35:50.51,0:35:53.51,teks umum,,0,0,0,,Kamu datang untuk pedang Nak Su, ini dia
Dialog: 0,0:35:55.39,0:35:56.48,teks umum,,0,0,0,,Kamu benar
Dialogue: 0,0:35:57.31,0:35:58.85,teks umum,,0,0,0,,Aku datang menjemputnya
Dialog: 0,0:35:58.94,0:36:02.77,teks umum,,0,0,0,,Aku membawanya sehingga kamu tidak perlu kembali lagi untuk kedua kalinya
Dialog: 0,0:36:02.86,0:36:04.23,teks umum,,0,0,0,,Silakan ambil
Dialog: 0,0:36:04.98,0:36:08.28,teks umum,,0,0,0,,Apakah kamu ingin memberitahuku untuk mengambil tujuan kedatanganku dan tidak kembali?
Dialog: 0,0:36:09.53,0:36:13.58,teks umum,,0,0,0,,Kamu sangat cerdas, berwawasan luas, dan kuat
Dialog: 0,0:36:13.66,0:36:15.87,teks umum,,0,0,0,,Apakah kamu menertawakanku karena aku kalah?
Dialog: 0,0:36:15.95,0:36:18.79,teks umum,,0,0,0,,Kalah? Anda mendapatkan apa yang Anda inginkan
Dialog: 0,0:36:18.87,0:36:20.87,teks umum,,0,0,0,,Dan dia kehilangannya
Dialog: 0,0:36:20.96,0:36:23.96,teks umum,,0,0,0,,Pemenangnya di sini adalah kamu
Dialog: 0,0:36:26.46,0:36:30.05,teks umum,,0,0,0,,Dia benar, Yang Mulia. Anda menang
Dialog: 0,0:36:30.88,0:36:33.10,teks umum,,0,0,0,,Selamat, Yang Mulia
Dialog: 0,0:36:35.18,0:36:36.47,teks umum,,0,0,0,,Jadilah
Dialog: 0,0:36:40.44,0:36:42.60,teks umum,,0,0,0,,Lagipula, kamu sangat murah hati
Dialog: 0,0:36:42.69,0:36:45.65,teks umum,,0,0,0,,Tidak ada orang yang begitu mulia di dunia sepertimu
Dialog: 0,0:36:50.20,0:36:51.36,teks umum,,0,0,0,,Siapa namamu?
Dialog: 0,0:36:53.49,0:36:55.12,teks umum,,0,0,0,,Moo Dok, Yang Mulia
Dialog: 0,0:36:56.28,0:36:57.29,teks umum,,0,0,0,,Moo Dok
Dialog: 0,0:36:57.79,0:36:59.62,teks umum,,0,0,0,,Kamu menumpahkan air dari panci ke arahku
Dialog: 0,0:36:59.71,0:37:01.33,teks umum,,0,0,0,,Mulai sekarang aku akan memanggilmu Won Mu Deok
Dialog: 0,0:37:02.00,0:37:05.96,teks umum,,0,0,0,,Seperti namamu, kamu bau kotoran
Dialog: 0,0:37:12.59,0:37:14.34,teks umum,,0,0,0,,Kamu bahkan memberiku nama
Dialog: 0,0:37:14.43,0:37:17.89,teks umum,,0,0,0,,Terima kasih banyak atas kebaikan Anda
Dialog: 0,0:37:22.31,0:37:23.69,teks umum,,0,0,0,,Selamat tinggal, Yang Mulia
Dialog: 0,0:37:25.77,0:37:26.73,teks umum,,0,0,0,,Maju
Dialog: 0,0:37:35.82,0:37:39.33, sulih suara,,0,0,0,,Muridku masih terlalu lemah untuk melawanmu
Dialog: 0,0:37:39.41,0:37:43.08, sulih suara,,0,0,0,,Sampai dia menjadi lebih kuat, sebaiknya dia tidak merusak hubungannya denganmu
Dialogue: 0,0:37:50.21,0:37:53.01,teks umum,,0,0,0,,Kamu mudah jatuh cinta atau mengambil hati orang lain
Dialog: 0,0:37:53.09,0:37:54.47,teks umum,,0,0,0,,demi tuanmu?
Dialogue: 0,0:37:54.55,0:37:57.14,teks umum,,0,0,0,,Aku tidak bisa melawannya, jadi aku menyiramnya
Dialog: 0,0:37:59.14,0:38:02.02,teks umum,,0,0,0,,Aku bau, sebaiknya jangan mendekatiku
Dialog: 0,0:38:08.11,0:38:08.94,teks umum,,0,0,0,,Usap dirimu
Dialogue: 0,0:38:12.57,0:38:15.28,teks umum,,0,0,0,,Beraninya aku menodai barang pria yang kucintai?
Dialog: 0,0:38:16.28,0:38:17.53,teks umum,,0,0,0,,Tidak, terima kasih
Dialog: 0,0:38:53.49,0:38:55.53,teks umum,,0,0,0,,Aku benar-benar menjadi Stinky Moo Deok
Dialog: 0,0:39:01.49,0:39:04.37,teks umum,,0,0,0,,Kamu juga cuci muka, kamu mungkin bau
Dialog: 0,0:39:21.43,0:39:24.52,teks umum,,0,0,0,,Guru, akhirnya saya berhasil
Dialog: 0,0:39:50.83,0:39:54.92,teks umum,,0,0,0,,Gwiga dicuri dari Jinyeowon
Dialog: 0,0:39:56.05,0:39:59.80,teks umum,,0,0,0,,Hanya anggota keluarga Jin yang bisa membuka pintu ini
Dialog: 0,0:40:00.51,0:40:03.76,teks umum,,0,0,0,,Mereka pasti memanggilnya dari luar
Dialog: 0,0:40:05.47,0:40:06.89,teks umum,,0,0,0,,Pencurian di Jinyeowon?
Dialogue: 0,0:40:06.98,0:40:10.15,teks umum,,0,0,0,,Kau berduka atas kematian putrimu selama bertahun-tahun,
Dialog: 0,0:40:10.23,0:40:13.61,teks umum,,0,0,0,,ini pasti melemahkanmu
Dialog: 0,0:40:14.73,0:40:16.94,teks umum,,0,0,0,,Tidak tahu malu kasar
Dialog: 0,0:40:17.53,0:40:20.99,teks umum,,0,0,0,,Kamu mungkin tidak sah, tapi masih bagian dari keluarga Jin
Dialog: 0,0:40:21.07,0:40:23.16,teks umum,,0,0,0,,Beraninya kamu memfitnah saudara tirimu?
Dialog: 0,0:40:23.24,0:40:24.37,teks umum,,0,0,0,,Bajingan
Dialog: 0,0:40:24.45,0:40:25.74,teks umum,,0,0,0,,Saya wakil Gwangju
Dialog: 0,0:40:25.83,0:40:28.46,teks umum,,0,0,0,,Saya akan menghargai jika Anda lebih menunjukkan rasa hormat
Dialog: 0,0:40:36.38,0:40:39.67,teks umum,,0,0,0,,Pak, silakan keluar ke halaman. Chan Wook datang menemuimu
Dialog: 0,0:41:01.15,0:41:03.11,teks umum,,0,0,0,,Saya melarang dia muncul di sini
Dialog: 0,0:41:03.20,0:41:06.74,teks umum,,0,0,0,,Kenapa kamu membawanya bersamamu?
Dialog: 0,0:41:07.66,0:41:09.45,teks umum,,0,0,0,,Anda perlu melihat sesuatu
Dialog: 0,0:41:16.67,0:41:18.55,teks umum,,0,0,0,,Ini pedang ayahku
Dialog: 0,0:41:19.34,0:41:22.72,miring,,0,0,0,,Saat aku masih muda, kamu bilang kamu akan menerimaku jika aku bisa telanjang
Dialog: 0,0:41:23.39,0:41:24.34,teks umum,,0,0,0,,Apakah kamu ingat?
Dialog: 0,0:42:05.30,0:42:08.01,teks umum,,0,0,0,,Kupikir dia baru saja membuka gerbang energinya
Dialog: 0,0:42:08.72,0:42:11.73,teks umum,,0,0,0,,Saya melihat dia telah menguasai aliran energi saya
Dialog: 0,0:42:12.39,0:42:14.48,miring,,0,0,0,,Seperti yang kamu harapkan dari putra Chang Gang
Dialog: 0,0:42:14.56,0:42:16.69,teks umum,,0,0,0,,Dia menguasai Ryusu dalam sekejap mata
Dialog: 0,0:42:17.40,0:42:20.65,teks umum,,0,0,0,,Tolong bawa aku ke tempatmu,
Dialog: 0,0:42:21.48,0:42:22.40,teks umum,,0,0,0,,master
Dialog: 0,0:42:27.24,0:42:28.87,teks umum,,0,0,0,,Apa yang ada di tanganmu?
Dialog: 0,0:42:29.45,0:42:31.70,teks umum,,0,0,0,,Energinya terkonsentrasi di tangan kanannya
Dialog: 0,0:42:31.79,0:42:33.08,miring,,0,0,0,,Dia belum mengendalikannya,
Dialog: 0,0:42:33.16,0:42:35.12,teks umum,,0,0,0,,jadi kami memasangkan gelang penahan padanya
Dialog: 0,0:42:46.72,0:42:48.68,teks umum,,0,0,0,,Lepaskan
Dialog: 0,0:42:49.60,0:42:52.14,teks umum,,0,0,0,,Jika kita melepasnya, tangannya akan berhenti menuruti
Dialog: 0,0:42:52.22,0:42:55.06,teks umum,,0,0,0,,Biarkan dia memfilmkannya nanti, setelah latihan
Dialog: 0,0:42:56.10,0:42:57.23,teks umum,,0,0,0,,Tembak
Dialogue: 0,0:43:23.63,0:43:27.05,teks umum,,0,0,0,,Aku ingin melihat caramu memegang pedang
Dialog: 0,0:43:58.54,0:44:00.46,teks umum,,0,0,0,,Ikat lengannya
Dialog: 0,0:44:13.60,0:44:15.89,teks umum,,0,0,0,,Apakah kamu... baik-baik saja?
Dialog: 0,0:44:16.93,0:44:18.85,teks umum,,0,0,0,,Apa gunanya menghunus pedang,
Dialog: 0,0:44:20.81,0:44:22.56,teks umum,,0,0,0,,jika kamu bahkan tidak bisa menahannya?
Dialog: 0,0:44:28.74,0:44:30.66,miring,,0,0,0,,Dia belum bisa mengendalikannya
Dialog: 0,0:44:30.74,0:44:32.91,miring,,0,0,0,,Tapi dia mempunyai kekuatan yang luar biasa
Dialog: 0,0:44:32.99,0:44:34.49,teks umum,,0,0,0,,Dia bahkan mengalahkan Putra Mahkota
Dialog: 0,0:44:35.54,0:44:37.91,miring,,0,0,0,,Dia mematahkan pedang Yang Mulia
Dialog: 0,0:44:38.50,0:44:40.54,miring,,0,0,0,,Padahal dia sudah lama menguasai Ryusu
Dialogue: 0,0:44:40.62,0:44:42.17,italic,,0,0,0,,UK menang
Dialog: 0,0:44:43.71,0:44:45.92,teks umum,,0,0,0,,Jin Cho Young, jangan ikut campur
Dialog: 0,0:44:47.09,0:44:48.46,teks umum,,0,0,0,,Ya ibu
Dialog: 0,0:44:49.34,0:44:54.10,teks umum,,0,0,0,,Uk, apakah kamu benar-benar mengarahkan pedang ke arah Putra Mahkota?
Dialog: 0,0:44:54.68,0:44:56.43,teks umum,,0,0,0,,Ne Uk memulai perkelahian
Dialog: 0,0:44:56.51,0:44:58.39,teks umum,,0,0,0,,Kau mengacungkan pedang ke Putra Mahkota?!
Dialog: 0,0:45:00.44,0:45:01.52,teks umum,,0,0,0,,Ya
Dialog: 0,0:45:02.81,0:45:05.52,teks umum,,0,0,0,,Yang Mulia ingin mengambil pedang Gwangju
Dialog: 0,0:45:05.61,0:45:07.48,teks umum,,0,0,0,,Itu adalah perselisihan
Dialogue: 0,0:45:08.19,0:45:10.15,italic,,0,0,0,,Bahkan Putra Mahkota pun memaafkannya
Dialog: 0,0:45:11.36,0:45:15.66,miring,,0,0,0,,Pedang Yang Mulia patah, tapi Uk masih mengarahkannya ke arahnya!
Dialog: 0,0:45:15.74,0:45:18.58,teks umum,,0,0,0,,Dia membahayakan nyawa Putra Mahkota
Dialog: 0,0:45:18.66,0:45:19.66,teks umum,,0,0,0,,Kami juga ada di sana
Dialog: 0,0:45:20.79,0:45:21.87,teks umum,,0,0,0,,Kami mampu menghentikannya
Dialog: 0,0:45:21.96,0:45:24.00,teks umum,,0,0,0,,Artinya kalian berempat menonton,
Dialog: 0,0:45:24.08,0:45:26.25,teks umum,,0,0,0,,bagaimana mereka mengejek Yang Mulia
Dialog: 0,0:45:28.71,0:45:31.72,teks umum,,0,0,0,,Ini penghinaan terhadap keluarga kerajaan!
Dialog: 0,0:45:34.72,0:45:36.51,teks umum,,0,0,0,,Kunci Chan Wook
Dialog: 0,0:45:39.39,0:45:41.56,teks umum,,0,0,0,,Ini tak terkendali dan berbahaya
Dialog: 0,0:45:41.64,0:45:42.77,miring,,0,0,0,,Ya
Dialog: 0,0:46:02.21,0:46:04.17,teks umum,,0,0,0,,Ada baiknya membuka gerbang energi,
Dialog: 0,0:46:04.25,0:46:08.17,teks umum,,0,0,0,,bagaimana Chang Wook mulai mengancam Putra Mahkota
Dialog: 0,0:46:11.17,0:46:14.01,teks umum,,0,0,0,,Chonbugwan tidak akan meninggalkan ini begitu saja
Dialog: 0,0:47:14.07,0:47:16.86,teks umum,,0,0,0,,Lukanya belum kau obati, kau kehilangan banyak darah
Dialog: 0,0:47:19.24,0:47:21.62,teks umum,,0,0,0,,Bagaimana tanganmu?
Dialog: 0,0:47:25.33,0:47:27.54,teks umum,,0,0,0,,Gelang tidak memungkinkan dia bergerak
Dialog: 0,0:47:28.37,0:47:29.63,teks umum,,0,0,0,,Tapi aku baik-baik saja
Dialogue: 0,0:47:31.38,0:47:34.55,teks umum,,0,0,0,,Kamu mampu menguasai aliran energi dari Master Ho Yeom
Dialog: 0,0:47:34.63,0:47:36.13,teks umum,,0,0,0,,dalam waktu sesingkat itu
Dialog: 0,0:47:37.30,0:47:38.51,teks umum,,0,0,0,,Saya sangat terkesan
Dialog: 0,0:47:41.14,0:47:43.06,teks umum,,0,0,0,,Awalnya tubuhku terbakar api,
Dialog: 0,0:47:43.64,0:47:46.10,teks umum,,0,0,0,,dan kemudian tampak tertutup es
Dialogue: 0,0:47:47.85,0:47:50.10,teks umum,,0,0,0,,Bagaimana lukamu akibat pukulan itu?
Dialogue: 0,0:47:50.19,0:47:51.52,teks umum,,0,0,0,,Apakah sakit?
Dialog: 0,0:47:54.36,0:47:58.40,teks umum,,0,0,0,,Tampaknya pukulan itu membantu mengumpulkan energi
Dialog: 0,0:48:00.36,0:48:02.49,teks umum,,0,0,0,,Putra Mahkota memberiku banyak pukulan,
Dialog: 0,0:48:04.45,0:48:07.58,teks umum,,0,0,0,,setelah itu aku merasakan gelombang energi
Dialog: 0,0:48:07.66,0:48:09.04,teks umum,,0,0,0,,Dan kemudian aku bisa mendapatkan pedangnya
Dialog: 0,0:48:11.42,0:48:12.42,teks umum,,0,0,0,,Pantas saja
Dialog: 0,0:48:13.17,0:48:17.59,teks umum,,0,0,0,,Kamu selalu mempelajari segalanya lebih cepat dari yang lain
Dialog: 0,0:48:18.76,0:48:22.60,miring,,0,0,0,,Kamu belajar berjalan dan berlari jauh lebih awal dari Dan Gu
Dialog: 0,0:48:23.39,0:48:25.68,teks umum,,0,0,0,,Dan mulai berbicara lebih awal
Dialog: 0,0:48:26.85,0:48:28.27,teks umum,,0,0,0,,Saya ingat ini
Dialog: 0,0:48:29.06,0:48:32.52,teks umum,,0,0,0,,Sampai kuketahui gerbang energiku terkunci,
Dialog: 0,0:48:34.15,0:48:36.65,teks umum,,0,0,0,,Kupikir aku akan menjadi orang terkuat
Dialog: 0,0:48:42.03,0:48:43.28,teks umum,,0,0,0,,Uk
Dialog: 0,0:48:44.74,0:48:48.79,teks umum,,0,0,0,,Kamu cerdas dan mempelajari semuanya dengan cepat
Dialog: 0,0:48:51.29,0:48:55.59,teks umum,,0,0,0,,Mungkin kamu akan menjadi pedagang, belajar cara berbisnis?
Dialog: 0,0:48:56.17,0:49:00.84,teks umum,,0,0,0,,Atau tuan Ho Yeom akan menganggapnya sebagai murid dan mengajarinya pengobatan
Dialog: 0,0:49:05.64,0:49:06.68,teks umum,,0,0,0,,Saya menolak
Dialog: 0,0:49:09.73,0:49:12.98,teks umum,,0,0,0,,Saya akan berlatih di Jeonjingak dan menjadi pesulap
Dialog: 0,0:49:13.65,0:49:14.73,teks umum,,0,0,0,,Mengapa?
Dialogue: 0,0:49:15.69,0:49:18.40,teks umum,,0,0,0,,Karena itu yang dilakukan ayahmu?
Dialog: 0,0:49:20.32,0:49:23.49,teks umum,,0,0,0,,Apakah kamu ingin menjadi Gwangju Jeonbugwan selanjutnya?
Dialog: 0,0:49:24.16,0:49:26.91,teks umum,,0,0,0,,Ya, dan aku akan menjadi salah satunya
Dialog: 0,0:49:27.99,0:49:29.62,teks umum,,0,0,0,,Aku akan menggantikannya
Dialog: 0,0:49:29.70,0:49:32.75,teks umum,,0,0,0,,dan aku akan membuktikan kepada para bajingan yang tidak percaya bahwa aku adalah putranya
Dialog: 0,0:49:34.33,0:49:36.25,teks umum,,0,0,0,,- Aku akan membungkam mereka semua{\i1}\N- Kamu...
Dialog: 0,0:49:38.46,0:49:39.96,teks umum,,0,0,0,,bukan nak
Dialog: 0,0:49:41.22,0:49:42.30,teks umum,,0,0,0,,Chan Gan
Dialog: 0,0:49:45.64,0:49:46.93,miring,,0,0,0,,Kamu
Dialog: 0,0:49:47.64,0:49:50.85,teks umum,,0,0,0,,buah pengkhianatan ibumu
Dialog: 0,0:49:52.94,0:49:56.31,miring,,0,0,0,,Kami menerimamu ke dalam keluarga Chan untuk menunjukkan rasa hormat kepada mendiang ibumu
Dialog: 0,0:49:56.40,0:49:59.19,miring,,0,0,0,,Tapi kami tidak bisa membiarkanmu menjadi kepala Jeonbugwan
Dialog: 0,0:49:59.28,0:50:02.40,teks umum,,0,0,0,,Jadi berhentilah bermimpi untuk mengikuti jejak
Dialog: 0,0:50:05.45,0:50:06.41,teks umum,,0,0,0,,ayahnya
Dialog: 0,0:50:07.87,0:50:11.20,miring,,0,0,0,,Tetap menjadi pewaris yang tidak tahu apa-apa
Dialog: 0,0:50:11.91,0:50:14.46,miring,,0,0,0,,keluarga Chan
Dialog: 0,0:50:16.33,0:50:17.46,teks umum,,0,0,0,,Dan kemudian
Dialog: 0,0:50:19.21,0:50:21.30,teks umum,,0,0,0,,kami akan terus menjagamu
Dialog: 0,0:50:28.97,0:50:30.06,teks umum,,0,0,0,,Lalu...
Dialog: 0,0:50:33.23,0:50:34.85,teks umum,,0,0,0,,Lalu siapa ayahku?
Dialog: 0,0:50:37.61,0:50:41.48,teks umum,,0,0,0,,Bagaimana kami tahu dengan siapa mendiang ibumu?
Dialog: 0,0:50:44.15,0:50:45.91,teks umum,,0,0,0,,selingkuh?
Dialog: 0,0:51:20.40,0:51:24.15,teks umum,,0,0,0,,Uka punya banyak pemikiran di kepalanya saat ini, biarkan dia sendiri
Dialog: 0,0:51:30.87,0:51:32.74,teks umum,,0,0,0,,Pastikan dia makan semuanya
Dialog: 0,0:51:42.55,0:51:45.42,teks umum,,0,0,0,,Maiden Kim memerintahkanku untuk memastikan kamu memakan semuanya
Dialog: 0,0:51:49.09,0:51:50.47,teks umum,,0,0,0,,Apakah dia memarahimu lagi?
Dialogue: 0,0:51:52.81,0:51:55.35,teks umum,,0,0,0,,Kupikir kamu sudah terbiasa dimarahi...
Dialog: 0,0:52:07.70,0:52:08.86,teks umum,,0,0,0,,Saya tidak ada hubungannya dengan itu
Dialog: 0,0:52:08.95,0:52:12.24,teks umum,,0,0,0,,Mereka mungkin belum memperbaiki bagiannya setelah kejadian itu
Dialog: 0,0:52:14.95,0:52:15.87,teks umum,,0,0,0,,Jangan bergerak
Dialog: 0,0:52:17.66,0:52:19.00,teks umum,,0,0,0,,Berdiri saja disana
Dialog: 0,0:52:22.75,0:52:24.80,teks umum,,0,0,0,,Semuanya bisa runtuh
Dialog: 0,0:52:27.21,0:52:28.80,teks umum,,0,0,0,,Jadi diam saja
Dialogue: 0,0:52:41.69,0:52:44.69,teks umum,,0,0,0,,Kenapa kamu tidak menghindari pedangnya?
Dialog: 0,0:52:45.73,0:52:46.78,teks umum,,0,0,0,,Ini karena
Dialog: 0,0:52:47.28,0:52:49.74,teks umum,,0,0,0,,apakah kamu memerlukan alasan lain untuk mengusirnya?
Dialog: 0,0:52:50.78,0:52:52.78,teks umum,,0,0,0,,Saya pantas mendapatkannya
Dialog: 0,0:52:52.87,0:52:56.45,teks umum,,0,0,0,,Lagipula, aku patah hati dia
Dialog: 0,0:52:58.04,0:53:02.33,teks umum,,0,0,0,,Menghancurkan hatinya pasti lebih menyakitkan daripada menerima pukulan
Dialog: 0,0:53:04.17,0:53:05.29,teks umum,,0,0,0,,Maiden Kim
Dialog: 0,0:53:06.13,0:53:11.13,teks umum,,0,0,0,,Kamu bilang ada rumor kalau aku ayah Uka?
Dialogue: 0,0:53:11.68,0:53:13.59,teks umum,,0,0,0,,Bagaimana jika kubilang,
Dialog: 0,0:53:14.26,0:53:18.35,teks umum,,0,0,0,,bahwa saya benar-benar ayahnya?
Dialog: 0,0:53:22.14,0:53:24.36,teks umum,,0,0,0,,Saya akan meninggalkan posisi saya
Dialog: 0,0:53:25.98,0:53:28.32,teks umum,,0,0,0,,Saya akan memulai bisnis kecil-kecilan
Dialog: 0,0:53:29.53,0:53:31.65,teks umum,,0,0,0,,dan saya akan mulai berdagang dengan Ukom
Dialog: 0,0:53:32.24,0:53:34.99,teks umum,,0,0,0,,Sosnovoy Bor membutuhkan bab
Dialog: 0,0:53:37.03,0:53:38.58,teks umum,,0,0,0,,Atau mungkin berkata,
Dialog: 0,0:53:39.50,0:53:41.54,teks umum,,0,0,0,,bahwa saya ibunya?
Dialog: 0,0:53:42.33,0:53:43.54,teks umum,,0,0,0,,Saya pikir akan lebih baik,
Dialog: 0,0:53:43.62,0:53:47.09,teks umum,,0,0,0,,jika aku dan Wook pergi ke desa asalku, tempat kami dibesarkan bersama Nyonya Do Hwa
Dialog: 0,0:53:49.59,0:53:52.30,teks umum,,0,0,0,,Ini tidak akan terjadi
Dialog: 0,0:53:53.93,0:53:58.43,teks umum,,0,0,0,,Wook mirip dengan Do Hwa, jadi
Dialog: 0,0:53:59.56,0:54:01.85,teks umum,,0,0,0,,dia cantik sekali
Dialog: 0,0:54:02.94,0:54:04.15,teks umum,,0,0,0,,Siapa yang akan percaya itu
Dialog: 0,0:54:06.44,0:54:08.02,teks umum,,0,0,0,,bahwa kamu adalah ibunya?
Dialog: 0,0:54:10.23,0:54:11.24,teks umum,,0,0,0,,Berhenti
Dialogue: 0,0:54:12.03,0:54:15.87,teks umum,,0,0,0,,Jadi, jika aku jadi ibunya, dia akan menakutkan?
Dialog: 0,0:54:16.87,0:54:19.24,teks umum,,0,0,0,,Dalam hal ini, kamu juga tidak bisa menjadi ayahnya
Dialog: 0,0:54:19.33,0:54:20.83,teks umum,,0,0,0,,Tentu saja bisa
Dialog: 0,0:54:21.58,0:54:24.04,miring,,0,0,0,,Chang Gang dan aku selalu mengimbangi,
Dialog: 0,0:54:28.29,0:54:30.71,teks umum,,0,0,0,,ketika muncul
Dialog: 0,0:54:33.84,0:54:34.97,teks umum,,0,0,0,,Tidak, kamu kalah
Dialog: 0,0:54:35.55,0:54:37.09,miring,,0,0,0,,Kamu bahkan tidak berdiri di sampingnya
Dialog: 0,0:54:37.18,0:54:41.31,teks umum,,0,0,0,,Do Hwa bilang dia menyukai segala sesuatu tentangmu kecuali penampilanmu
Dialog: 0,0:54:41.39,0:54:43.56,teks umum,,0,0,0,,Jangan mengada-ada!
Dialog: 0,0:54:44.77,0:54:46.60,teks umum,,0,0,0,,Kamu bahkan tidak bergeming saat dipukul dengan pedang
Dialog: 0,0:54:46.69,0:54:48.98,teks umum,,0,0,0,,Tapi, menurutku, mendengar bahwa kamu menakutkan itu lebih menyakitkan
Dialog: 0,0:54:49.06,0:54:50.32,teks umum,,0,0,0,,Rana
Dialog: 0,0:54:51.86,0:54:53.86,teks umum,,0,0,0,,sangat menyakitkan
Dialogue: 0,0:54:53.94,0:54:55.61,teks umum,,0,0,0,,Kamu tidak berpura-pura?
Dialog: 0,0:54:55.70,0:54:58.24,teks umum,,0,0,0,,Jangan bergerak, kalau tidak luka akan terbuka
Dialog: 0,0:55:00.28,0:55:01.49,teks umum,,0,0,0,,Kami berbagi
Dialog: 0,0:55:03.70,0:55:05.75,teks umum,,0,0,0,,rasa sakit yang sama
Dialog: 0,0:55:07.25,0:55:09.84,miring,,0,0,0,,ditolak orang,
Dialog: 0,0:55:09.92,0:55:12.42,miring,,0,0,0,,yang dicintai
Dialog: 0,0:55:12.92,0:55:14.34,teks umum,,0,0,0,,Jadi mari kita
Dialog: 0,0:55:15.59,0:55:17.01,teks umum,,0,0,0,,jangan saling menyakiti
Dialog: 0,0:55:18.80,0:55:22.39,teks umum,,0,0,0,,Saya akui saya tidak ingin menyinggung perasaan Anda
Dialog: 0,0:55:22.47,0:55:23.85,teks umum,,0,0,0,,Kamu...
Dialog: 0,0:55:25.98,0:55:26.98,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:30.19,0:55:31.27,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:32.53,0:55:34.03,teks umum,,0,0,0,,indah
Dialog: 0,0:55:36.40,0:55:40.45,teks umum,,0,0,0,,Kamu juga, pembantu Kim,
Dialog: 0,0:55:41.74,0:55:42.95,teks umum,,0,0,0,,kra...
Dialog: 0,0:55:44.08,0:55:47.29,teks umum,,0,0,0,,indah...I
Dialog: 0,0:55:55.01,0:55:57.97,teks umum,,0,0,0,,Biarkan aku meniup lukamu
Dialog: 0,0:55:58.63,0:55:59.84,teks umum,,0,0,0,,Sakit
Dialog: 0,0:56:03.26,0:56:04.93,teks umum,,0,0,0,,Tepat di bawah
Dialog: 0,0:56:05.02,0:56:06.56,teks umum,,0,0,0,,Ya, ya, di sana
Dialogue: 0,0:56:18.11,0:56:19.53,memori miring,,0,0,0,,Sepertinya jimatnya ada di Chwisongru
Dialog: 0,0:56:19.61,0:56:21.62,kenangan,,0,0,0,,milik Chan Wook
Dialog: 0,0:56:22.91,0:56:23.91,kenangan,,0,0,0,,Chan Wook?
Dialog: 0,0:56:23.99,0:56:26.79,kenangan,,0,0,0,,Dia baru-baru ini dihukum karena kehilangan jimat
Dialog: 0,0:56:26.87,0:56:30.62,kenangan,,0,0,0,,Dan kudengar pembantunya sering pergi ke tempat itu
Dialog: 0,0:56:33.67,0:56:36.46,di belakang layar,,0,0,0,,Gadis dari Sosnovy Bor ini adalah pembantunya,
Dialog: 0,0:56:37.67,0:56:40.84, sulih suara,,0,0,0,,dan dia ada di kedai hari itu
Dialogue: 0,0:56:43.22,0:56:44.51,teks umum,,0,0,0,,Bisakah dia menjadi
Dialog: 0,0:56:45.47,0:56:46.47,teks umum,,0,0,0,,Nak Su?
Dialog: 0,0:56:50.52,0:56:53.69,teks umum,,0,0,0,,Apakah kita masih jauh dari Jeonbugwan?
Dialogue: 0,0:56:57.11,0:57:00.45,teks umum,,0,0,0,,Kalau begini terus aku akan jadi batu
Dialog: 0,0:57:01.32,0:57:03.07,teks umum,,0,0,0,,Kami akan mempercepat, bersabar
Dialog: 0,0:57:03.62,0:57:05.53,teks umum,,0,0,0,,Kamu tidak boleh kehilangan kendali sekarang
Dialogue: 0,0:57:06.41,0:57:09.00,teks umum,,0,0,0,,Pak, kamu baik-baik saja?
Dialog: 0,0:57:36.98,0:57:39.61,teks umum,,0,0,0,,Balik kembali
Dialog: 0,0:58:00.30,0:58:04.89,miring,,0,0,0,,Tanganmu... Kamu memahami Ryusa seperti itu
Dialog: 0,0:58:04.97,0:58:07.39,teks umum,,0,0,0,,waktu singkat
Dialog: 0,0:58:08.76,0:58:11.98,miring,,0,0,0,,Kamu sama pintarnya dengan ayahmu
Dialog: 0,0:58:14.85,0:58:16.31,miring,,0,0,0,,Jin Moo dari Jeonbugwan
Dialog: 0,0:58:16.40,0:58:20.32,teks umum,,0,0,0,,memulai pertengkaran hanya karena dia menyadari bahwa jabatan Gwangju tidak akan menimpanya
Dialog: 0,0:58:20.40,0:58:22.57,miring,,0,0,0,,Dia menyadari bahwa kamu,
Dialog: 0,0:58:22.65,0:58:25.70,miring,,0,0,0,,putra sulung keluarga Chan, maukah kamu mengambil posisi ini
Dialog: 0,0:58:34.29,0:58:37.17,teks umum,,0,0,0,,Luka paman tidak terlalu dalam
Dialog: 0,0:58:37.25,0:58:38.71,teks umum,,0,0,0,,Jangan khawatirkan dia
Dialog: 0,0:58:38.79,0:58:42.26,teks umum,,0,0,0,,Aku akan bicara dengan Jin Mu
Dialog: 0,0:58:42.34,0:58:43.38,miring,,0,0,0,,Oke?
Dialog: 0,0:58:49.43,0:58:50.93,teks umum,,0,0,0,,Jaga dia
Dialog: 0,0:59:19.38,0:59:21.34,teks umum,,0,0,0,,Saat kamu ada, Inggris selalu dalam bahaya
Dialog: 0,0:59:23.01,0:59:24.67,teks umum,,0,0,0,,Kau bersamanya saat dia meminum racun
Dialog: 0,0:59:24.76,0:59:27.59,teks umum,,0,0,0,,dan saat dia bergulat dengan Putra Mahkota
Dialog: 0,0:59:29.80,0:59:33.39,teks umum,,0,0,0,,Jadi, apakah kamu ingin memisahkan kami?
Dialog: 0,0:59:33.47,0:59:34.68,teks umum,,0,0,0,,Saya tidak bisa melakukan ini
Dialog: 0,0:59:38.02,0:59:40.23,teks umum,,0,0,0,,Dia selalu mendapatkan apa yang diinginkannya
Dialog: 0,0:59:40.86,0:59:42.65,teks umum,,0,0,0,,Dan kau mempertaruhkan nyawamu untuk menyelamatkannya
Dialog: 0,0:59:49.32,0:59:51.20,teks umum,,0,0,0,,Ini pedang ayahnya
Dialog: 0,0:59:51.28,0:59:52.99,teks umum,,0,0,0,,Ambillah
Dialog: 0,1:00:21.44,1:00:23.48,teks umum,,0,0,0,,Saya tidak dapat melihat ini lagi!
Dialog: 0,1:00:23.57,1:00:25.23,teks umum,,0,0,0,,Berapa lama kamu akan mengasihani diri sendiri?
Dialog: 0,1:00:32.20,1:00:33.41,miring,,0,0,0,,Bangun
Dialog: 0,1:00:45.67,1:00:48.84,teks umum,,0,0,0,,Kamu menerima energi yang sangat besar dan mampu mengatasinya
Dialogue: 0,1:00:49.59,1:00:53.39,italic,,0,0,0,,Orang butuh 10 tahun untuk melakukan ini, kamu butuh 10 hari
Dialog: 0,1:00:53.47,1:00:55.47,teks umum,,0,0,0,,- Pelatihan kita...\N- Lupakan saja
Dialog: 0,1:00:55.56,1:00:56.97,teks umum,,0,0,0,,Saya tidak mau!
Dialog: 0,1:00:59.98,1:01:01.69,teks umum,,0,0,0,,Menolak karena beberapa kata dari Park Jin?
Dialog: 0,1:01:02.44,1:01:04.52,miring,,0,0,0,,Jadi itu bukan kekuatan, tapi kebodohan
Dialog: 0,1:01:04.61,1:01:07.48,teks umum,,0,0,0,,Pantas saja kamu begitu putus asa. Kamu terlalu lemah!
Dialog: 0,1:01:07.57,1:01:10.36,teks umum,,0,0,0,,Ya, saya lemah, jadi saya tidak akan melakukan apa pun
Dialog: 0,1:01:10.45,1:01:11.91,teks umum,,0,0,0,,Jadi diam saja
Dialog: 0,1:01:13.70,1:01:15.33,teks umum,,0,0,0,,Tutup mulutmu dan jangan ganggu aku
Dialog: 0,1:01:23.17,1:01:25.38,teks umum,,0,0,0,,Saya tidak membutuhkan siswa yang tidak aktif
Dialog: 0,1:01:29.72,1:01:31.30,teks umum,,0,0,0,,Kalau begitu jangan jadi guruku,
Dialog: 0,1:01:32.43,1:01:33.93,teks umum,,0,0,0,,kamu akan menjadi pembantuku
Dialog: 0,1:01:35.01,1:01:36.93,teks umum,,0,0,0,,Jika kamu membuatku marah lagi, aku akan menjualnya
Dialog: 0,1:02:16.09,1:02:17.22,teks umum,,0,0,0,,Mr.
Dialog: 0,1:02:19.43,1:02:24.06,teks umum,,0,0,0,,Pemiliknya sangat khawatir hingga dia bahkan tidak minum air
Dialog: 0,1:02:24.14,1:02:26.10,teks umum,,0,0,0,,Tolong, tolong
Dialog: 0,1:02:26.19,1:02:27.77,teks umum,,0,0,0,,Tapi apa yang bisa kulakukan?
Dialog: 0,1:02:28.44,1:02:30.28,teks umum,,0,0,0,,Sebaiknya kita menunggu paman membereskan semuanya
Dialog: 0,1:02:30.36,1:02:33.61,teks umum,,0,0,0,,Tuan Ho Yeom berkata dia akan membantu
Dialog: 0,1:02:33.70,1:02:37.41,teks umum,,0,0,0,,Minta dia segera menemui Jin Mu dan mengakhiri ini
Dialog: 0,1:02:42.16,1:02:46.83,teks umum,,0,0,0,,Aku datang kepadamu karena aku khawatir betapa kecilnya dirimu
Dialog: 0,1:02:46.92,1:02:49.34,teks umum,,0,0,0,,tidak membesar-besarkan masalah
Dialog: 0,1:02:49.42,1:02:53.80,teks umum,,0,0,0,,Bagaimana bisa ancaman terhadap nyawa Putra Mahkota hanyalah hal kecil?
Dialog: 0,1:02:56.34,1:02:59.51,teks umum,,0,0,0,,Jadi pemimpin kita mengurungnya
Dialog: 0,1:03:00.14,1:03:02.89,teks umum,,0,0,0,,Hutan pinus akan menghukumnya
Dialog: 0,1:03:02.98,1:03:05.81,teks umum,,0,0,0,,Kalau menyangkut keluarga kerajaan, Hutan Pinus tidak boleh ikut campur
Dialog: 0,1:03:06.52,1:03:10.27,teks umum,,0,0,0,,Ini tanggung jawab Jeonbugwan, kami sendiri yang akan menghukumnya
Dialog: 0,1:03:11.02,1:03:13.15,teks umum,,0,0,0,,Dan apa yang akan kamu lakukan?
Dialog: 0,1:03:13.24,1:03:17.07,teks umum,,0,0,0,,Dia mengancam Putra Mahkota, dia harus dieksekusi
Dialog: 0,1:03:19.28,1:03:23.16,teks umum,,0,0,0,,Tapi kita tidak bisa membunuh putra tunggal Gwangju
Dialog: 0,1:03:23.83,1:03:27.67,teks umum,,0,0,0,,Jadi, potong saja tangan yang mengarahkan pedang ke arah sang pangeran
Dialog: 0,1:03:28.33,1:03:30.25,miring,,0,0,0,,Potong tanganmu?
Dialog: 0,1:03:30.34,1:03:31.88,teks umum,,0,0,0,,Anda mungkin tersinggung oleh,
Dialog: 0,1:03:31.96,1:03:34.21,miring,,0,0,0,,bahwa muridmu tidak bisa mengalahkan Uka,
Dialog: 0,1:03:34.30,1:03:37.01,teks umum,,0,0,0,,gerbang energinya dibuka sepuluh hari yang lalu
Dialog: 0,1:03:37.09,1:03:39.89,miring,,0,0,0,,Bodoh, aku di sini mencoba menyelamatkan reputasimu dan pangeran
Dialog: 0,1:03:39.97,1:03:42.22,teks umum,,0,0,0,,Aku akan bersikap baik
Dialog: 0,1:03:42.31,1:03:43.93,teks umum,,0,0,0,,Tapi kamu benar-benar gila!
Dialog: 0,1:03:44.02,1:03:47.77,teks umum,,0,0,0,,Biarkan Jeongbugwan memutuskan apakah aku gila atau Chan Wook
Dialog: 0,1:03:47.85,1:03:50.90,teks umum,,0,0,0,,- Bajingan...\N- Tuan, dengan tenang
Dialog: 0,1:03:52.65,1:03:55.32,teks umum,,0,0,0,,Pertarungan mereka terjadi atas persetujuan bersama
Dialog: 0,1:03:55.90,1:03:58.28,teks umum,,0,0,0,,Pembantu Uka yang harus disalahkan atas apa yang terjadi
Dialog: 0,1:04:01.24,1:04:03.04,teks umum,,0,0,0,,Pertarungan itu adil
Dialog: 0,1:04:04.24,1:04:08.92,teks umum,,0,0,0,,Jika kamu tidak mempercayai kami, biarkan mereka bertarung lagi
Dialog: 0,1:04:13.17,1:04:16.76,teks umum,,0,0,0,,Lagi? Ide bagus
Dialog: 0,1:04:18.26,1:04:21.26,teks umum,,0,0,0,,Karena Anda menyatakan bahwa Inggris tidak mengancam Putra Mahkota,
Dialog: 0,1:04:21.35,1:04:22.93,teks umum,,0,0,0,,dan pertarungan berlangsung adil,
Dialog: 0,1:04:23.81,1:04:26.77,teks umum,,0,0,0,,biarkan pertandingan resmi berlangsung
Dialog: 0,1:04:27.39,1:04:29.69,teks umum,,0,0,0,,Duel antara Inggris dan pangeran?
Dialog: 0,1:04:30.27,1:04:33.23,teks umum,,0,0,0,,Jika kamu tidak dapat menerima ini, berikan Uka kepada kami
Dialog: 0,1:04:33.32,1:04:34.73,teks umum,,0,0,0,,Tetapi jika Anda setuju,
Dialog: 0,1:04:34.82,1:04:39.24,teks umum,,0,0,0,,kami tidak akan meminta pertanggungjawaban siapa pun, bahkan jika salah satu dari mereka meninggal
Dialog: 0,1:04:40.11,1:04:42.49,teks umum,,0,0,0,,Sesuai dengan kebiasaan para penyihir Deho
Dialog: 0,1:04:53.42,1:04:56.21,teks umum,,0,0,0,,Kami datang untuk memikirkan semuanya, dan apa hasil akhirnya?
Dialog: 0,1:04:56.80,1:05:00.97,teks umum,,0,0,0,,Ular bawah airlah yang mengalahkanku
Dialog: 0,1:05:01.05,1:05:04.05,teks umum,,0,0,0,,Inggris akan mati dalam pertempuran resmi. Apa yang harus kita lakukan?
Dialog: 0,1:05:04.14,1:05:05.43,teks umum,,0,0,0,,Jangan khawatir
Dialog: 0,1:05:05.51,1:05:07.85,teks umum,,0,0,0,,Putra Mahkota tidak akan menerima tantangan
Dialog: 0,1:05:08.93,1:05:11.48,teks umum,,0,0,0,,Sejak Guru So Kyung mendirikan Hutan Pinus,
Dialog: 0,1:05:11.56,1:05:14.94,teks umum,,0,0,0,,keluarga kerajaan dan para penyihir tidak bersaing
Dialog: 0,1:05:15.02,1:05:16.53,teks umum,,0,0,0,,Kedua belah pihak dipatuhi
Dialog: 0,1:05:16.61,1:05:21.49,teks umum,,0,0,0,,aturan tak terucapkan ini, agar tidak membuang-buang energi
Dialog: 0,1:05:22.07,1:05:23.16,teks umum,,0,0,0,,Tidak mungkin,
Dialog: 0,1:05:23.24,1:05:26.62,teks umum,,0,0,0,,agar Putra Mahkota melanggar peraturan ini dan melawan Uka
Dialog: 0,1:05:35.63,1:05:37.34,teks umum,,0,0,0,,Terima tantangannya
Dialog: 0,1:05:38.51,1:05:42.72,teks umum,,0,0,0,,Saya tidak mengerti mengapa saya harus melawan Sosnovy Bor karena idiot ini
Dialog: 0,1:05:42.80,1:05:46.81,teks umum,,0,0,0,,Mereka sendiri yang membuatnya agar mereka tidak menuding kita
Dialog: 0,1:05:46.89,1:05:51.18,teks umum,,0,0,0,,Tunjukkan pada Sosnovy Bor betapa kuatnya dirimu
Dialog: 0,1:06:11.33,1:06:13.42,teks umum,,0,0,0,,Pengawal kerajaan dan rakyat Jeonbugwan
Dialog: 0,1:06:14.00,1:06:15.17,teks umum,,0,0,0,,Apa yang terjadi?
Dialog: 0,1:06:15.79,1:06:17.79,teks umum,,0,0,0,,Diberkati, Tuan Ho
Dialog: 0,1:06:18.59,1:06:20.55,teks umum,,0,0,0,,Dia bilang itu tidak akan terjadi
Dialog: 0,1:06:20.63,1:06:22.30,miring,,0,0,0,,Tapi lihat
Dialog: 0,1:06:23.18,1:06:24.72,teks umum,,0,0,0,,Apa yang harus kita lakukan sekarang?
Dialog: 0,1:06:27.68,1:06:30.56,teks umum,,0,0,0,,Saya tidak mengerti mengapa mereka ada di sini?
Dialog: 0,1:06:30.64,1:06:34.31,teks umum,,0,0,0,,Aku baru saja hendak memberitahumu
Dialog: 0,1:06:34.39,1:06:36.52,teks umum,,0,0,0,,Tapi Jin Mu mendahuluiku
Dialog: 0,1:06:37.94,1:06:39.11,teks umum,,0,0,0,,Jin Mu?
Dialog: 0,1:06:39.90,1:06:42.24,teks umum,,0,0,0,,Apa terjadi sesuatu lagi?
Dialog: 0,1:06:44.15,1:06:45.57,teks umum,,0,0,0,,Biarkan semuanya!
Dialog: 0,1:06:45.66,1:06:47.49,teks umum,,0,0,0,,Putra Mahkota
Dialog: 0,1:06:47.57,1:06:50.24,teks umum,,0,0,0,,menantang Chan Wook berduel
Dialog: 0,1:06:52.50,1:06:56.46,teks umum,,0,0,0,,Deputi Gwangju berkata kita harus mengantarkan Chang Wook ke Jeonbugwan,
Dialog: 0,1:06:56.54,1:06:58.96,teks umum,,0,0,0,,jika dia menolak pertarungan
Dialog: 0,1:06:59.54,1:07:02.46,teks umum,,0,0,0,,Chan Wook sudah terkunci di sini
Dialog: 0,1:07:04.30,1:07:07.80,teks umum,,0,0,0,,Kirim ke Jeonbugwan? Untuk apa?
Dialog: 0,1:07:07.89,1:07:09.60,teks umum,,0,0,0,,Tanya Guru Ho
Dialog: 0,1:07:10.39,1:07:13.68,teks umum,,0,0,0,,Saya diberitahu bahwa Anda menyetujui ketentuan ini
Dialog: 0,1:07:22.48,1:07:25.45,teks umum,,0,0,0,,Uk, bangun. Anda harus lari dari sini
Dialog: 0,1:07:26.20,1:07:27.28,teks umum,,0,0,0,,Ada apa?
Dialog: 0,1:07:27.36,1:07:30.74,teks umum,,0,0,0,,Tidak ada waktu untuk menjelaskan. Jika kami tidak bergegas, Anda akan kehilangan tangan Anda
Dialog: 0,1:07:31.66,1:07:33.41,teks umum,,0,0,0,,Kamu bahkan mungkin mati
Dialog: 0,1:07:34.00,1:07:35.29,teks umum,,0,0,0,,- Apa?\N- Host
Dialog: 0,1:07:35.87,1:07:37.42,teks umum,,0,0,0,,Semuanya menjadi lebih serius
Dialog: 0,1:07:37.50,1:07:40.00,teks umum,,0,0,0,,Tetap di sini, maka kamu akan kehilangan tangan atau nyawamu
Dialog: 0,1:07:41.04,1:07:42.50,teks umum,,0,0,0,,Apakah kamu akan duduk seperti itu?
Dialog: 0,1:07:53.85,1:07:58.40,teks umum,,0,0,0,,Aku akan pergi bersama Uk ke istana dan bertemu dengan Putra Mahkota
Dialog: 0,1:07:58.98,1:08:00.94,teks umum,,0,0,0,,Inggris akan segera hadir
Dialog: 0,1:08:05.53,1:08:06.49,teks umum,,0,0,0,,Di mana Inggris?
Dialog: 0,1:08:06.57,1:08:09.82,teks umum,,0,0,0,,Dia tidak ada di ruang rahasia. Saya pikir dia melarikan diri
Dialog: 0,1:08:10.53,1:08:11.53,teks umum,,0,0,0,,Apa?
Dialog: 0,1:08:18.71,1:08:21.17,teks umum,,0,0,0,,Saat terjebak di antara batu dan tempat yang keras,
Dialog: 0,1:08:21.25,1:08:23.21,teks umum,,0,0,0,,melarikan diri adalah satu-satunya jalan keluar
Dialog: 0,1:08:31.18,1:08:34.10,teks umum,,0,0,0,,Dia ada di sini sepanjang waktu. Hanya pembantunya yang keluar masuk
Dialog: 0,1:08:34.68,1:08:36.27,teks umum,,0,0,0,,Saya tidak mengerti bagaimana dia bisa lolos
Dialog: 0,1:08:38.89,1:08:40.85,teks umum,,0,0,0,,Di mana Yul dan Dan Gu?
Dialog: 0,1:08:49.61,1:08:53.24,teks umum,,0,0,0,,Bab ini akan menyelesaikan semuanya. Tundukkan kepala Anda sampai keadaan menjadi tenang
Dialog: 0,1:08:54.58,1:08:57.33,teks umum,,0,0,0,,Moo Dok, jaga dia
Dialog: 0,1:08:58.25,1:09:01.25,teks umum,,0,0,0,,Apakah kamu yakin kami tidak membutuhkanmu?
Dialog: 0,1:09:01.33,1:09:03.84,teks umum,,0,0,0,,Ya, kami akan pergi ke desa asalku
Dialog: 0,1:09:03.92,1:09:05.88,teks umum,,0,0,0,,Desa Sari ya?
Dialog: 0,1:09:05.96,1:09:08.80,teks umum,,0,0,0,,Tetap disana. Kami akan datang untukmu
Dialog: 0,1:09:14.89,1:09:17.10,teks umum,,0,0,0,,Kau menempatkan dia dalam bahaya lagi
Dialog: 0,1:09:20.35,1:09:22.73,teks umum,,0,0,0,,Dan dia akan mendapatkan apa yang diinginkannya lagi
Dialog: 0,1:09:50.01,1:09:51.34,teks umum,,0,0,0,,Pertarungan akan berlangsung
Dialog: 0,1:09:52.63,1:09:56.43,teks umum,,0,0,0,,di pertengahan bulan depan
Dialog: 0,1:09:59.89,1:10:01.23,teks umum,,0,0,0,,Tetapi jika
Dialog: 0,1:10:02.10,1:10:03.98,teks umum,,0,0,0,,dia tidak akan muncul pada hari itu,
Dialog: 0,1:10:05.81,1:10:07.82,teks umum,,0,0,0,,anggap ini sebagai kekalahan
Dialog: 0,1:10:07.90,1:10:10.36,teks umum,,0,0,0,,Ini adalah pelarian, bukan kekalahan
Dialog: 0,1:10:12.45,1:10:15.12,teks umum,,0,0,0,,Saya pikir pengecut seperti itu harus dihukum
Dialog: 0,1:10:17.70,1:10:19.33,teks umum,,0,0,0,,Saya setuju dengannya
Dialog: 0,1:10:19.95,1:10:22.25,teks umum,,0,0,0,,Jika Chang Wook tidak kembali,
Dialog: 0,1:10:22.83,1:10:25.13,teks umum,,0,0,0,,dia akan dicabut haknya untuk menjadi
Dialog: 0,1:10:26.08,1:10:27.17,teks umum,,0,0,0,,selanjutnya Gwangju
Dialog: 0,1:10:35.09,1:10:37.35,teks umum,,0,0,0,,Baiklah, Yang Mulia
Dialog: 0,1:10:54.95,1:10:57.03,teks umum,,0,0,0,,Mengapa kamu mengambilnya jika kita melarikan diri?
Dialog: 0,1:10:58.37,1:10:59.78,teks umum,,0,0,0,,Untuk pelatihan
Dialog: 0,1:10:59.87,1:11:01.08,teks umum,,0,0,0,,Latihan?
Dialog: 0,1:11:01.16,1:11:02.45,teks umum,,0,0,0,,Apakah kita akan berlatih?
Dialogue: 0,1:11:04.04,1:11:05.08,teks umum,,0,0,0,,Apakah kamu di balik ini?
Dialog: 0,1:11:05.17,1:11:06.62,teks umum,,0,0,0,,Kontribusi
Dialog: 0,1:11:07.13,1:11:09.96,teks umum,,0,0,0,,Kamu akhirnya pindah saat aku bilang kamu dalam bahaya
Dialog: 0,1:11:12.05,1:11:13.30,teks umum,,0,0,0,,Apa?
Dialog: 0,1:11:13.38,1:11:15.47,teks umum,,0,0,0,,Saya tidak membutuhkan siswa yang tidak membuat kemajuan
Dialogue: 0,1:11:16.26,1:11:18.85,teks umum,,0,0,0,,Matilah saja kalau tak mau berbuat apa-apa
Dialog: 0,1:11:18.93,1:11:20.76,teks umum,,0,0,0,,Kau meracuniku lagi,
Dialog: 0,1:11:21.93,1:11:23.64,teks umum,,0,0,0,,tuanku yang gila
Dialog: 0,1:11:24.31,1:11:25.35,teks umum,,0,0,0,,Chan Wook
Dialog: 0,1:11:26.14,1:11:29.52,teks umum,,0,0,0,,Kita pergi ke tempat saya berlatih. Bersiaplah
Dialog: 0,1:11:30.15,1:11:33.61,teks umum,,0,0,0,,Tidak akan ada pemandian air hangat di sana
Dialog: 0,1:11:33.69,1:11:38.28,teks umum,,0,0,0,,Tidak ada tempat tidur, tidak ada makanan favoritmu
Dialog: 0,1:11:40.45,1:11:43.41,teks umum,,0,0,0,,Apakah Desa Sari begitu menakutkan?
Dialog: 0,1:11:44.25,1:11:46.87,teks umum,,0,0,0,,Moo Dok tinggal di Sari
Dialog: 0,1:11:46.96,1:11:48.92,teks umum,,0,0,0,,Nak Su berasal dari tempat yang sama
Dialog: 0,1:11:50.00,1:11:51.38,teks umum,,0,0,0,,dari Danhyanggok
Dialog: 0,1:11:53.76,1:11:55.47,teks umum,,0,0,0,,Ke sanalah tujuan kita
Dialog: 0,1:12:51.94,1:12:53.73,pratinjau,,0,0,0,,Apa semua ini?
Dialog: 0,1:12:53.82,1:12:54.94,pratinjau,,0,0,0,,Moo Dok!
Dialog: 0,1:12:55.02,1:12:58.03,pratinjau,,0,0,0,,Saya hampir menganggap ini sebagai upaya untuk menculik saya dan tinggal bersama saya
Dialog: 0,1:12:58.11,1:12:59.78,pratinjau,,0,0,0,,dengan kedok pelatihan
Dialog: 0,1:12:59.86,1:13:02.82,pratinjau,,0,0,0,,Asal tahu saja, saya bisa mengajarimu secara berbeda
Dialog: 0,1:13:02.91,1:13:05.62,pratinjau,,0,0,0,,Gadis-gadis seperti itu adalah yang paling berbahaya
Dialog: 0,1:13:05.70,1:13:07.20,pratinjau,,0,0,0,,Saya tidak suka yang manis-manis
Dialog: 0,1:13:07.29,1:13:09.50,pratinjau,,0,0,0,,Baiklah, jika Anda tidak menyukainya
Dialog: 0,1:13:09.58,1:13:12.92,pratinjau,,0,0,0,,- Yul sedang memasak nasi dengan Moo Deok!\N- Sudah kubilang...
Dialog: 0,1:13:13.00,1:13:16.92,pratinjau,,0,0,0,,Bagaimana kamu bisa mengajar orang lain ketika muridmu ada di sini?
Dialog: 0,1:13:17.01,1:13:20.09,pratinjau,,0,0,0,,Bagaimana jika kita mencabut haknya untuk disebut pesulap?
Dialog: 0,1:13:20.17,1:13:23.05,pratinjau,,0,0,0,,Ke mana pun dia pergi, dia tidak dapat menemukan guru
Dialog: 0,1:13:23.14,1:13:26.31,pratinjau,,0,0,0,,Jiwa yang menakjubkan bermigrasi ke tubuh ini
Dialog: 0,1:13:26.39,1:13:27.35,pratinjau,,0,0,0,,Moo Dok, lari!
Dialog: 0,1:13:27.43,1:13:28.73,pratinjau,,0,0,0,,Saya tidak ingin melakukan apa pun...
Dialog: 0,1:13:28.81,1:13:30.31,pratinjau,,0,0,0,,tapi ada yang menggangguku
Dialog: 0,0:35:38.58,0:35:40.58,pratinjau,,0,0,0,,

Komentar: 0,0:02:45.14,0:02:47.14,nicks,,0,0,0,,Editor beta: {\c&HFFF4C5&} Sana
