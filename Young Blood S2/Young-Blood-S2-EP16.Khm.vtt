ចារកម្មជាន់ខ្ពស់នៅក្នុងកូនសៀវភៅនេះ។

509
00:26:33.658 --> 00:26:35.160
ទាំងអស់​លែង​មាន​ជីវិត​ទៀត​ហើយ។

510
00:26:35.627 --> 00:26:37.462
យើងទាំងអស់គ្នាត្រូវបានបញ្ឆោតដោយ Polaris

511
00:26:39.798 --> 00:26:40.832
និយាយយ៉ាងតឹងរឹងវាមិនរាប់បញ្ចូលទេ។

512
00:26:40.832 --> 00:26:41.800
តើគាត់បានបោក?

513
00:26:41.866 --> 00:26:42.834
យ៉ាងណាមិញ អ្វីដែលខ្ញុំនិយាយនៅពេលនោះគឺ

514
00:26:42.834 --> 00:26:44.302
ផ្តល់ឱ្យយើងនូវបញ្ជីឈ្មោះបន្ទាប់ពីបីឆ្នាំ

515
00:26:44.936 --> 00:26:46.438
មិន​មាន​ការ​ព្រមព្រៀង​ថា​រស់​ឬ​ស្លាប់​ទេ។

516
00:26:47.772 --> 00:26:48.640
ធ្វើឱ្យយល់

517
00:26:49.307 --> 00:26:50.275
មិនត្រូវបានបោកប្រាស់

518
00:27:01.353 --> 00:27:03.121
នេះគឺជាឥស្សរជនយោធារបស់ Xixia

519
00:27:04.356 --> 00:27:05.256
ជាមួយនេះ។

520
00:27:05.256 --> 00:27:06.491
អ្នកអាចចូលទៅក្នុងប្រទេសដោយរលូន

521
00:27:20.505 --> 00:27:21.773
នេះគឺជាផែនទីរបស់ Xixia

522
00:27:21.940 --> 00:27:22.941
ឆ្លងកាត់ផ្សេងៗ

523
00:27:22.941 --> 00:27:24.576
ការបង្កើតយោធភូមិស្ថិតក្នុងចំណោមពួកគេ។

524
00:27:24.643 --> 00:27:25.343
ជាមួយវា។

525
00:27:25.577 --> 00:27:27.779
អ្វី​ដែល​ហៅ​ថា​ប្រទេស​សត្រូវ​បាន​ក្លាយ​ជា​ច្រក​ទ្វារ

526
00:27:28.313 --> 00:27:29.080
មិនអាចទៅរួច

527
00:27:29.814 --> 00:27:30.782
មិនអាចទៅរួច

528
00:27:31.216 --> 00:27:32.150
ក្នុង​រយៈ​ពេល​បី​ឆ្នាំ​កន្លង​មក​នេះ​អ្នក​បាន​

529
00:27:32.150 --> 00:27:33.318
— ជាមួយ Won Jong-shin

530
00:27:33.451 --> 00:27:34.853
តើអ្នកមានពេលរៀបចំវាដោយរបៀបណា?

531
00:27:35.220 --> 00:27:36.321
មិនបានរៀបចំដោយខ្ញុំ

532
00:27:36.554 --> 00:27:37.222
តើនោះជាអ្នកណា

533
00:27:38.523 --> 00:27:39.691
តើអ្នកធ្លាប់គិតអំពី

534
00:27:40.025 --> 00:27:40.859
ហេតុអ្វី Xue Ying

535
00:27:40.859 --> 00:27:41.860
មិន​បាន​ត្រឡប់​មក​រក​អ្នក​វិញ​

536
00:27:46.598 --> 00:27:47.399
យន់ធាងគួ

537
00:27:47.599 --> 00:27:48.733
តោះធ្វើកិច្ចព្រមព្រៀង

538
00:27:51.936 --> 00:27:52.937
ខ្ញុំសន្យានឹងអ្នក។

539
00:27:53.138 --> 00:27:53.772
ក្នុងរយៈពេលបីឆ្នាំ

540
00:27:53.772 --> 00:27:55.340
កុំអោយ Yuan Zhongxin ទៅ Xixia

541
00:27:55.340 --> 00:27:56.675
តើខ្ញុំចង់ផ្តល់អ្វី

542
00:27:56.741 --> 00:27:57.709
សាមញ្ញណាស់។

543
00:27:58.743 --> 00:27:59.778
អ្នកមានជំនាញល្អ។

544
00:28:00.779 --> 00:28:01.946
ជួយនាំ Xue Ying មកជាមួយផង។

545
00:28:01.946 --> 00:28:02.614
លោក Xue Ying

546
00:28:02.947 --> 00:28:03.948
អ្នកដែលមានដាវពីរ

547
00:28:05.083 --> 00:28:06.351
ខ្ញុំត្រូវទៅ Xixia

548
00:28:06.351 --> 00:28:07.385
គាត់ក៏នឹងទៅដែរ។

549
00:28:08.787 --> 00:28:09.854
បីឆ្នាំនេះ។

550
00:28:09.988 --> 00:28:11.656
Xue Ying បាននៅ Xixia

551
00:28:12.057 --> 00:28:13.024
ដូច្នេះបីឆ្នាំ

552
00:28:13.024 --> 00:28:14.059
អ្នកកំពុងរៀបចំ

553
00:28:14.059 --> 00:28:15.026
របស់ទាំងនេះ

554
00:28:15.794 --> 00:28:17.195
ខ្ញុំបានសន្យាជាមួយ Yuantianguan

555
00:28:17.195 --> 00:28:17.862
ក្នុងរយៈពេលបីឆ្នាំ

556
00:28:17.862 --> 00:28:19.264
Yuan Zhongxin មិនត្រូវបានអនុញ្ញាតឱ្យចូលទៅក្នុង Xixia ទេ។

557
00:28:19.264 --> 00:28:20.098
ប៉ុន្តែបីឆ្នាំនេះ

558
00:28:20.098 --> 00:28:21.299
គាត់បានសន្យា Polaris

559
00:28:21.299 --> 00:28:22.667
ជួយ Beihexing ដើម្បីកម្ចាត់បិសាច។

560
00:28:22.667 --> 00:28:24.002
គាត់មិនចាំបាច់ទៅ Xixia តាំងពីដំបូងទេ។

561
00:28:24.002 --> 00:28:24.869
បែបហ្នឹងឬ

562
00:28:24.869 --> 00:28:26.304
ប៉ុន្តែ Yuan Tianguan មិនដឹងទេ។

563
00:28:26.304 --> 00:28:27.505
ជំរាបសួរ Zhao Jian

564
00:28:27.939 --> 00:28:28.840
សម្លាប់សត្វស្លាបពីរក្បាលដោយថ្មមួយ។

565
00:28:28.840 --> 00:28:30.175
អ្នក​កំពុង​ដេក​ទាំង​សងខាង

566
00:28:30.442 --> 00:28:31.876
នេះមិនអាចចាត់ទុកថាជាការកុហកបានទេ?

567
00:28:31.876 --> 00:28:32.877
យ៉ាងណាមិញ Yuan Zhongxin

568
00:28:32.877 --> 00:28:33.912
ខ្ញុំពិតជាមិនបានទៅ Xixia ទេ។

569
00:28:33.912 --> 00:28:34.746
បាទ

570
00:28:34.746 --> 00:28:36.181
យើងទាំងអស់គ្នាជាមនុស្សស្មោះត្រង់

571
00:28:37.549 --> 00:28:38.917
បន្ទាប់ពីបីឆ្នាំនៃការខិតខំ

572
00:28:38.917 --> 00:28:40.585
អ្នកនៅតែចង់ទៅ Xixia

573
00:28:41.753 --> 00:28:43.188
ទោះបីជាអ្នកដឹងច្បាស់ក៏ដោយ។

574
00:28:43.188 --> 00:28:44.656
ការ​ទៅ​ទី​នោះ​ប្រៀប​ដូច​ជា​បញ្ជូន​ខ្លួន​ទៅ​រក​សេចក្ដី​ស្លាប់

575
00:28:47.425 --> 00:28:48.359
ខ្មោច​ពូ

576
00:28:48.993 --> 00:28:50.161
បីឆ្នាំ

577
00:28:50.762 --> 00:28:51.863
បានផ្លាស់ប្តូរមនុស្សជាច្រើន

578
00:28:52.197 --> 00:28:53.465
យើង​ក៏​មាន​បទពិសោធន៍​ច្រើន​ដែរ។

579
00:28:53.798 --> 00:28:55.266
ប្រហែលជាពួកគេកាន់តែចាស់ទុំហើយ។

580
00:28:55.500 --> 00:28:57.235
ប៉ុន្តែអ្នកណាថា Qianfan យឺតពេល?

581
00:28:58.403 --> 00:28:59.771
មនុស្សម្នាក់មិនអាចនៅក្មេងបានទេ។

582
00:29:23.361 --> 00:29:26.731
នៅតែជាក្មេងជំទង់

583
00:29:43.214 --> 00:29:43.815
មេ

584
00:29:44.149 --> 00:29:44.783
តើមានអ្វីខុស

585
00:29:45.150 --> 00:29:46.151
តើអ្នកមិនអង្គុយទេ?

586
00:29:46.918 --> 00:29:48.319
តើមានកៅអីសម្រាប់ខ្ញុំនៅខាងក្នុងទេ?

587
00:29:51.156 --> 00:29:51.790
ផងដែរ។

588
00:29:52.657 --> 00:29:53.892
តើអ្នកគិតថាអ្នកមិនអីទេ?

589
00:29:54.225 --> 00:29:55.894
យករបស់ជាច្រើនជាមួយអ្នកនៅពេលអ្នកចេញទៅក្រៅ

590
00:29:55.894 --> 00:29:57.295
ត្រៀមខ្លួន

591
00:29:59.297 --> 00:30:00.465
ដើម្បីប្រាប់អ្នកពីការពិត

592
00:30:00.732 --> 00:30:02.467
ខ្ញុំ​ជា​អ្នក​មាន​ឥឡូវ​នេះ។

593
00:30:02.901 --> 00:30:04.235
ប្រសិនបើពេលវេលាមិនតឹងតែង

594
00:30:04.235 --> 00:30:05.203
ខ្ញុំ​អាច​ធ្វើ​វា​ក្នុង​ទំហំ​ធំ​ជាង​នេះ។

595
00:30:05.203 --> 00:30:05.870
តើអ្នកជឿទេ?

596
00:30:10.475 --> 00:30:11.276
សម្បូរបែបប៉ុណ្ណា

597
00:30:13.178 --> 00:30:14.879
នេះពិបាកពិពណ៌នាណាស់។

598
00:30:16.114 --> 00:30:17.182
បានបើកហាងមួយ។

599
00:30:17.615 --> 00:30:19.117
តើហាងជាអ្វី?

600
00:30:21.119 --> 00:30:22.420
បន្ទាប់មកអ្នកទៅ Xixia ជាមួយយើង

601
00:30:22.420 --> 00:30:23.822
អ្វីដែលត្រូវធ្វើជាមួយឧស្សាហកម្មរបស់អ្នក?

602
00:30:24.155 --> 00:30:25.056
អ្នកណាខ្វល់?

603
00:30:33.031 --> 00:30:33.698
ឈុតតូច

604
00:30:34.098 --> 00:30:34.899
តើមានអ្វីខុសជាមួយអ្នក

605
00:30:35.834 --> 00:30:36.668
ខ្ញុំមិនអីទេ។

606
00:30:37.202 --> 00:30:38.069
ហេតុអ្វីបានជាអ្នកគ្រប់វិធី?

607
00:30:38.069 --> 00:30:39.103
មិននិយាយសូម្បីតែ

608
00:30:40.471 --> 00:30:41.940
មានអារម្មណ៍មិនស្រួលបន្តិច

609
00:30:43.908 --> 00:30:44.676
ហេតុអ្វី?

610
00:30:46.511 --> 00:30:47.779
មឈូសរបស់ខ្ញុំលើកនេះ។

611
00:30:47.779 --> 00:30:49.147
ខ្ញុំ​មិន​អាច​យក Xixia ទៅ​ជាមួយ​បាន​ទេ។

612
00:30:49.314 --> 00:30:50.548
ខ្ញុំច្បាស់ជាមិនអាចយកវាមកជាមួយបានទេ។

613
00:30:50.815 --> 00:30:51.783
សំណាងពេកហើយ។

614
00:30:52.150 --> 00:30:53.551
សំខាន់​ព្រោះ​ខ្ញុំ​មិន​អាច​លែង​បាន។

615
00:30:53.852 --> 00:30:54.986
អ្នកបាននៅជាមួយមឈូសអស់រយៈពេល 3 ឆ្នាំមកហើយ

616
00:30:54.986 --> 00:30:55.987
ដេកជាមួយអារម្មណ៍

617
00:30:56.054 --> 00:30:58.323
តើអ្នកណានឹងលង់ស្នេហ៍ជាមួយមឈូស?

618
00:30:58.423 --> 00:31:00.091
ចុះហេតុអ្វីបានជាអ្នកសោកសៅ?

619
00:31:00.625 --> 00:31:01.993
ព្រោះពេលខ្ញុំចាកចេញ

620
00:31:01.993 --> 00:31:03.428
អ្នក​ភូមិ​គោរព​បូជា​មឈូស

621
00:31:04.696 --> 00:31:05.730
ថ្វាយបង្គំ​មឈូស

622
00:31:07.332 --> 00:31:08.700
ពន្យល់ថាអ្នក, វេជ្ជបណ្ឌិតស្ត្រី

623
00:31:08.700 --> 00:31:09.801
គោរព

624
00:31:10.134 --> 00:31:11.803
សូម្បីតែមឈូសក៏ប្រឡាក់ដោយពន្លឺដែរ។

625
00:31:12.437 --> 00:31:13.972
យើង​បាន​ចំណាយ​ការ​ប្រឹងប្រែង​យ៉ាង​ខ្លាំង

626
00:31:14.239 --> 00:31:15.139
មិនមែនគ្រាន់តែកាត់ក្បាលទេឬ?

627
00:31:15.139 --> 00:31:16.474
តើមានខ្មោចក្នុងចិត្តទេ?

628
00:31:17.075 --> 00:31:18.543
នៅទីបញ្ចប់វានៅតែបែបនេះ

629
00:31:18.943 --> 00:31:20.011
គ្រាន់តែគិត

630
00:31:20.778 --> 00:31:21.746
អស់សង្ឃឹមណាស់។

631
00:31:22.280 --> 00:31:23.114
គ្មានផ្លូវទេ។

632
00:31:23.381 --> 00:31:24.349
អ្វីមួយ

633
00:31:24.349 --> 00:31:26.017
វាមិនអាចផ្លាស់ប្តូរក្នុងរយៈពេលពីរឬបីឆ្នាំបានទេ។

634
00:31:26.417 --> 00:31:28.253
សូម្បីតែមួយជំនាន់ ឬពីរជំនាន់

635
00:31:28.253 --> 00:31:29.220
