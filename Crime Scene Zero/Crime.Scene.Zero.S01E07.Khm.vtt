វាត្រូវបានរារាំងរហូតដល់ម៉ោង 10:30 យប់។

1577
01:05:42.229 --> 01:05:44.649
ដូច្នេះមានរយៈពេលខ្លី
នៅពេលដែលវាមិនត្រូវបានរារាំង។

1578
01:05:44.732 --> 01:05:47.234
{\an8}អូ ដូច្នេះមានពេលមួយ។
នៅពេលដែលចរាចរណ៍មិនត្រូវបានរឹតបន្តឹង?

1579
01:05:47.318 --> 01:05:48.486
{\an8}អំឡុងពេលនោះ...

1580
01:05:49.779 --> 01:05:51.989
{\an8}អ្នកស៊ើបអង្កេត ពេលនេះខ្ញុំគិតអំពីវា

1581
01:05:52.073 --> 01:05:53.699
{\an8}ប្រសិនបើផ្លូវនោះត្រូវបានបិទ

1582
01:05:53.783 --> 01:05:56.369
{\an8}យើងត្រូវដើរផ្លូវវាង
ឆ្លងកាត់ប៉ុស្តិ៍ប៉ូលីស។

1583
01:05:56.452 --> 01:06:01.457
{\an8}ប៉ុន្តែតែងតែមានមន្ត្រីម្នាក់
ឈរយាមនៅខាងក្រៅ។

1584
01:06:01.540 --> 01:06:03.918
{\an8}ប្រសិនបើពិរុទ្ធជនមិនចង់ឃើញ

1585
01:06:04.001 --> 01:06:06.087
{\an8}ពួកគេត្រូវឆ្លងកាត់
តំបន់ហាមឃាត់។

1586
01:06:06.170 --> 01:06:07.463
{\an8}អ្នកក៏មិនអាចទៅខាងក្រោយបានទេ?

1587
01:06:07.546 --> 01:06:09.340
{\an8}នោះជាអ្វីដែលត្រូវគិត។

1588
01:06:09.423 --> 01:06:10.925
{\an8}ទោះយ៉ាងណា នោះជាអ្វីទាំងអស់ដែលខ្ញុំមានសម្រាប់ពេលនេះ។

1589
01:06:11.008 --> 01:06:12.426
{\an8}ផ្លូវរបស់ CULPRIT អាស្រ័យលើពេលវេលា
ឧក្រិដ្ឋកម្មត្រូវបានប្រព្រឹត្ត

1590
01:06:12.510 --> 01:06:14.762
{\an8}ឥឡូវ​នេះ តោះ​ស្តាប់​ពី​កញ្ញា​មាន់។

1591
01:06:14.845 --> 01:06:16.555
{\an8}- ប្រាកដ។
- សូមទៅមុខ។

1592
01:06:16.639 --> 01:06:19.183
{\an8}ខ្ញុំមានសំណួរតាមដានមួយចំនួនសម្រាប់នាង។

1593
01:06:19.266 --> 01:06:21.018
{\an8}កំពុងប្រើឈ្មោះសត្វ
ប្រពៃណីដាក់ឈ្មោះគ្រួសារ?

1594
01:06:21.102 --> 01:06:22.186
{\an8}បិទវា។

1595
01:06:23.562 --> 01:06:25.189
{\an8}មើលអាកប្បកិរិយារបស់អ្នក...

1596
01:06:25.272 --> 01:06:27.984
{\an8}ចាប់តាំងពីហាង C មករកខ្ញុំ ខ្ញុំនឹងខាំមកវិញ។

1597
01:06:28.067 --> 01:06:32.154
{\an8}ខ្ញុំបានរកឃើញអត្ថបទរវាងគាត់ និងជនរងគ្រោះ
នៅលើទូរស័ព្ទរបស់ជនរងគ្រោះ។

1598
01:06:32.238 --> 01:06:33.114
{\an8}ពិតទេ?

1599
01:06:33.197 --> 01:06:36.617
{\an8}នៅម៉ោង 9:05 យប់,
C-store បាន​សរសេរ​ថា "នេះ​ជា​អ្វី?"

1600
01:06:36.701 --> 01:06:38.285
{\an8} ដល់នោះ ជនរងគ្រោះបានឆ្លើយថា
"សង្ឃឹមថាអ្នកបានត្រៀមខ្លួនរួចរាល់ហើយ។"

1601
01:06:38.953 --> 01:06:39.996
{\an8}នាងដឹងអ្វីមួយ។

1602
01:06:40.079 --> 01:06:42.039
{\an8}ខ្ញុំសង្ស័យថាវាជាការភ្ញាក់ផ្អើលដ៏ល្អមួយ។

1603
01:06:42.123 --> 01:06:43.082
{\an8}នោះជាអ្វីដែលពិតប្រាកដ។

1604
01:06:43.165 --> 01:06:45.793
{\an8}វា​ជា​ការ​ភ្ញាក់​ផ្អើល?
តើវានិយាយអំពីអ្វី? ប្រាប់ខ្ញុំ។

1605
01:06:45.876 --> 01:06:47.128
{\an8}កុំជាប់គាំង និងកំពប់។

1606
01:06:47.211 --> 01:06:48.796
{\an8}តើអ្វីបានធ្វើឱ្យអ្នកនិយាយថា "នេះជាអ្វី?"

1607
01:06:48.879 --> 01:06:50.881
{\an8}- អំណោយមួយ។
- តើអំណោយប្រភេទណា?

1608
01:06:50.965 --> 01:06:53.050
{\an8}- គ្រាន់តែជាអំណោយមួយ។
- តើមានអ្វីនៅក្នុងអំណោយ?

1609
01:06:53.134 --> 01:06:53.968
{\an8}អំណោយមួយ។

1610
01:06:54.051 --> 01:06:56.220
{\an8}មិនអីទេ អ្វីក៏ដោយ កាត់តែសំបក។

1611
01:06:56.303 --> 01:06:59.890
ហេតុអ្វីបានជាអ្នកហៅនាងនៅម៉ោង 9:57 យប់?

1612
01:06:59.974 --> 01:07:02.018
- ហេ! ហេតុអ្វីបានជាអ្នកហៅនាងនៅម៉ោង 9:57 យប់?
- សុំទោស?

1613
01:07:02.101 --> 01:07:03.394
មែនហើយ ខ្ញុំចង់ដឹងចង់ឃើញ។

1614
01:07:03.477 --> 01:07:05.980
{\an8}- តើគាត់បានទូរស័ព្ទទៅ Gun-mi នៅម៉ោង 9:57 យប់ទេ?
- ហាង C ហៅនាង។

1615
01:07:06.063 --> 01:07:06.981
{\an8}គ្មាន​អ្នក​ណា​ម្នាក់​យក​ទេ។

1616
01:07:07.064 --> 01:07:09.150
{\an8}តើ​អ្នក​បាន​សម្លាប់​នាង​ដោយ​សារ​មិន​យក​ឬ?

1617
01:07:09.233 --> 01:07:12.111
មក។ ខ្ញុំមិនសម្លាប់នរណាម្នាក់ទេ។
សម្រាប់ការមិនទទួលការហៅរបស់ខ្ញុំ។

1618
01:07:12.194 --> 01:07:13.029
ខ្ញុំធ្ងន់ធ្ងរ។

1619
01:07:13.112 --> 01:07:15.364
{\an8}ទោះយ៉ាងណា ខ្ញុំបានពិនិត្យផ្ទះ
Gun-mi នោះ

1620
01:07:15.448 --> 01:07:18.576
{\an8}ឬខ្ញុំគួរនិយាយថា Gun-jun រស់នៅ។

1621
01:07:18.659 --> 01:07:21.537
{\an8}នាងបានទទួលការជូនដំណឹងមួយ។
អំពីអគ្គីសនីរបស់នាងត្រូវបានកាត់ផ្តាច់។

1622
01:07:21.620 --> 01:07:24.165
{\an8}នោះ ក្នុងចំណោមរបស់ផ្សេងទៀត
បានណែនាំថានាងកំពុងរៀបចំចាកចេញពីទីក្រុង។

1623
01:07:24.248 --> 01:07:27.543
{\an8}នាងបានជួលផ្ទះតែប៉ុណ្ណោះ
ប្រហែលមួយខែ។

1624
01:07:27.626 --> 01:07:29.170
នាងប្រាប់ខ្ញុំថា នាងមកសងសឹក

1625
01:07:29.253 --> 01:07:33.132
ដូច្នេះប្រហែលជានាងចាកចេញដោយសារតែ
នាងបានធ្វើរួចហើយនូវអ្វីដែលនាងមកធ្វើ។

1626
01:07:33.215 --> 01:07:35.926
តើអ្នកមិនបានឃើញសំបុត្រយន្តហោះទេ។
នាងមាននៅក្នុងកាបូបរបស់នាង?

1627
01:07:36.010 --> 01:07:36.969
{\an8}- ខ្ញុំបានឃើញវា។
- មានមួយ។

1628
01:07:37.053 --> 01:07:37.928
{\an8}នាងបានកក់ជើងហោះហើរ

1629
01:07:38.012 --> 01:07:41.640
{\an8}- ជាប់សម្រាប់ប្រទេសរុស្ស៊ី។
- ម៉ោង ១១:៥៩ យប់ នៅថ្ងៃទី 12 ។

1630
01:07:41.724 --> 01:07:42.850
{\an8}- ត្រូវ។
- ម៉ោង 11:59 យប់?

1631
01:07:42.933 --> 01:07:45.936
{\an8}ខ្ញុំជឿ
នេះ​ជា​ការ​ទាក់​ទង​នឹង​ករណី​នេះ

1632
01:07:46.020 --> 01:07:47.897
{\an8} ដូច្នេះយើងគួរតែពិនិត្យមើលវា។

1633
01:07:48.481 --> 01:07:49.356
{\an8}លោកម្ចាស់

1634
01:07:50.024 --> 01:07:50.858
{\an8}ខ្ញុំ?

1635
01:07:50.941 --> 01:07:52.943
{\an8}តើអ្នកបានធ្វើអ្វីមុនពេលដំណើរការក្លឹប?

1636
01:07:53.569 --> 01:07:54.653
{\an8}ខ្ញុំ?

1637
01:07:54.737 --> 01:07:56.030
{\an8}ខ្ញុំធ្លាប់ធ្វើការឱ្យក្រុមហ៊ុនមួយ។

1638
01:07:56.113 --> 01:07:57.406
{\an8}តើក្រុមហ៊ុនប្រភេទណា?

1639
01:07:57.990 --> 01:07:59.617
{\an8}- ខ្ញុំជាមន្ត្រីរាជការ។
- មន្ត្រីរាជការ?

1640
01:08:00.201 --> 01:08:01.660
{\an8}គាត់ធ្លាប់ជាមនុស្សល្ងីល្ងើ។

1641
01:08:02.244 --> 01:08:03.079
{\an8}អ្វី?

1642
01:08:03.162 --> 01:08:04.455
{\an8}អូ មក។

1643
01:08:04.538 --> 01:08:06.624
{\an8}ខ្ញុំជាអ្នកស៊ើបអង្កេត ដូច្នេះតើមានអ្វីកើតឡើង?
នោះមិនមែនជាឧក្រិដ្ឋកម្មទេមែនទេ?

1644
01:08:06.707 --> 01:08:09.502
{\an8}- គាត់ជាប៉ូលីសឆបោក។
- ដូច្នេះអ្នកទទួលបានព័ត៌មានខាងក្នុង។

1645
01:08:09.585 --> 01:08:13.005
{\an8}ខ្ញុំបានរកឃើញការសុំទោសជាផ្លូវការ
គាត់បានសរសេរមួយរយៈមុន។

1646
01:08:13.089 --> 01:08:15.758
{\an8}គាត់ស្ថិតក្នុងក្រុមគ្រឿងញៀន
នៅស្ថានីយ៍ប៉ូលីស Gangdam ។

1647
01:08:15.841 --> 01:08:17.051
បាទ ខ្ញុំ​បាន​ដោះស្រាយ​ករណី​គ្រឿងញៀន។

1648
01:08:17.134 --> 01:08:19.970
គាត់បានធ្វើការនៅស្ថានីយ៍ប៉ូលីស Gangdam
និងអនុវត្តការស៊ើបអង្កេតដោយបង្ខំ។

1649
01:08:20.054 --> 01:08:22.890
- សូម្បីតែនៅពេលនោះគាត់មានកំហឹងខ្លាំង
- ត្រូវហើយ។

1650
01:08:22.973 --> 01:08:25.059
ទោះយ៉ាងណាក៏ដោយ ខ្ញុំបានរកឃើញ
ការសុំទោសជាផ្លូវការដែលគាត់បានសរសេរ។

1651
01:08:25.142 --> 01:08:27.478
{\an8}ប៉ុន្តែតើអ្នកដឹងទេថាអ្នកណាមានវា?

1652
01:08:28.354 --> 01:08:30.856
{\an8}Lee Gun-jun។ គាត់មានវា។

1653
01:08:30.940 --> 01:08:31.857
{\an8}- អ្វី?
- អ្វី?

1654
01:08:31.941 --> 01:08:33.234
{\an8}Lee Gun-jun មានវា។

1655
01:08:33.317 --> 01:08:36.862
{\an8}តើគាត់បញ្ចប់សំបុត្រដោយរបៀបណា
តើអ្នកបានសរសេរនៅឆ្នាំ 2000 ទេ?

1656
01:08:36.946 --> 01:08:40.741
{\an8}ខ្ញុំ​បាន​រក​ឃើញ​ធាតុ​គួរ​ឱ្យ​សង្ស័យ​មួយ​ទៀត,
ប៉ុន្តែ​ខ្ញុំ​មិន​ប្រាកដ​ថា​វា​ពាក់ព័ន្ធ​ឬ​អត់​ទេ។

1657
01:08:40.825 --> 01:08:43.119
{\an8}នៅលើតុរបស់ Lee Gun-jun នៅកន្លែងរបស់គាត់

1658
01:08:43.202 --> 01:08:45.579
{\an8}មានស៊ុមរូបភាព
ជាមួយនឹងរូបថតមួយសន្លឹកដែលហែកចេញពីវា។

1659
01:08:45.663 --> 01:08:48.415
{\an8}នៅសល់តែជ្រុងដែលហែកចេញ

1660
01:08:48.499 --> 01:08:51.502
{\an8}ហើយអ្នកអាចមើលឃើញ
អ្វីដែលស្រដៀងនឹងឡូហ្គោប៉ូលីស។

1661
01:08:51.585 --> 01:08:55.005
{\an8} ដូច្នេះហើយ ទើបខ្ញុំគិតដូច្នេះ
លោក Club មាន​ការ​ព្រួយ​បារម្ភ

1662
01:08:55.089 --> 01:08:57.341
{\an8}អំពីការភ្ជាប់ទៅ Gun-jun
ហើយបានថតរូបជាមួយគាត់។

1663
01:08:57.424 --> 01:08:59.135
{\an8}តើអ្នកធ្លាប់នៅក្នុងបន្ទប់របស់គាត់ទេ?

1664
01:08:59.218 --> 01:09:02.513
{\an8}- នេះជាការអាម៉ាស់ក្នុងការនិយាយ។
- បន្ត។

1665
01:09:03.180 --> 01:09:05.891
{\an8}ខ្ញុំបានជួបក្មេងស្រីនោះ។

1666
01:09:05.975 --> 01:09:08.477
{\an8}- ពេលកំពុងផឹកស្រា។
- មិនអីទេ។

1667
01:09:08.561 --> 01:09:11.480
{\an8}ខ្ញុំចង់ចាប់ផ្តើម
អ្វីមួយជាមួយនាងបន្តិច

1668
01:09:12.314 --> 01:09:13.941
{\an8}ប៉ុន្តែនៅពេលខ្ញុំភ្ញាក់ឡើងនៅព្រឹកបន្ទាប់

1669
01:09:14.024 --> 01:09:15.693
{\an8}ខ្ញុំបានកត់សម្គាល់ឃើញថាខ្ញុំត្រូវបានគេប្លន់អ្វីៗទាំងអស់។

1670
01:09:15.776 --> 01:09:17.653
{\an8}- នៅសណ្ឋាគារ។
- ខ្ញុំឃើញ។

1671
01:09:17.736 --> 01:09:19.530
{\an8}- មិនគួរឱ្យជឿ។
- ហើយឆ្កេញីនោះបានចាកចេញទៅហើយ។

1672
01:09:19.613 --> 01:09:23.742
{\an8}ខ្ញុំស្មានថានោះជាពេលដែលនាងយក
កាបូបរបស់ខ្ញុំ និងការសុំទោសជាលាយលក្ខណ៍អក្សរ។

1673
01:09:23.826 --> 01:09:26.287
