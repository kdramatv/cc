Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Pembawa Acara, Penyanyi, Februari
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.96,0:01:06.46,Default,Lily,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.46,0:01:08.66,Default,Lily,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialogue: 0,0:01:15.70,0:01:18.84,Default,Lily,0,0,0,,Mereka bilang anak panah tidak terbang lurus saat kamu cemas.
Dialog: 0,0:01:20.07,0:01:22.94,Default,Lily,0,0,0,,11 episode
Dialog: 0,0:01:34.39,0:01:37.26,Default,Lily,0,0,0,,Saya minta maaf karena meminta pertemuan terlambat.
Dialog: 0,0:01:37.42,0:01:39.33,Default,Lily,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:01:39.66,0:01:41.09,Default,Lily,0,0,0,,Kamu membutuhkan aku,
Dialog: 0,0:01:41.09,0:01:42.56,Default,Lily,0,0,0,,dan aku bersyukur untuk itu.
Dialogue: 0,0:01:43.70,0:01:46.73,Default,Lily,0,0,0,,Kalau saja ini mimpi.
Dialog: 0,0:01:47.73,0:01:51.57,Default,Lily,0,0,0,,Kalau saja semuanya hilang saat aku bangun.
Dialog: 0,0:01:56.68,0:01:58.25,Default,Lily,0,0,0,,Aku punya sesuatu untukmu.
Dialog: 0,0:02:14.03,0:02:15.76,Default,Lily,0,0,0,,Rahasia
Dialog: 0,0:02:33.08,0:02:37.15,Default,Lily,0,0,0,,Benamkan ratu dalam mimpi buruk yang aku tinggali.
Dialog: 0,0:02:48.46,0:02:49.70,Default,Lily,0,0,0,,Rajaku.
Dialog: 0,0:02:52.00,0:02:56.27,Default,Lily,0,0,0,,Tadi malam kamu datang kepadaku dalam mimpi
Dialog: 0,0:02:56.97,0:03:00.51,Default,Lily,0,0,0,,dan kekuatan besar jatuh ke tanganku.
Dialog: 0,0:03:15.16,0:03:18.53,Default,Lily,0,0,0,,Kamus Ratu
Dialogue: 0,0:03:24.50,0:03:26.40,Default,Lily,0,0,0,,Jarak sosial
Dialog: 0,0:03:30.17,0:03:32.84,Default,Lily,0,0,0,,menakjubkan, masa ajaib, haus akan perhatian,
Dialogue: 0,0:03:32.84,0:03:36.34,Default,Lily,0,0,0,,showdown, teh melati, kasar
Dialog: 0,0:03:51.36,0:03:53.03,Default,Lily,0,0,0,,Manis.
Dialog: 0,0:03:56.43,0:03:57.46,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:59.60,0:04:03.14,Default,Lily,0,0,0,,Kehilangan suaramu, panggil aku serak?
Dialog: 0,0:04:08.71,0:04:09.78,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:04:13.81,0:04:14.85,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:04:17.52,0:04:19.05,Default,Lily,0,0,0,,Apakah airnya cukup hangat?
Dialog: 0,0:04:20.22,0:04:21.96,Default,Lily,0,0,0,,Apakah airnya cukup hangat?
Dialog: 0,0:04:24.46,0:04:26.19,Default,Lily,0,0,0,,Saya menyukainya.
Dialogue: 0,0:04:26.19,0:04:28.70,Default,Lily,0,0,0,,Kenapa kamu lupa di sini?
Dialogue: 0,0:04:33.47,0:04:34.60,Default,Lily,0,0,0,,Ratuku.
Dialog: 0,0:04:37.74,0:04:38.97,Default,Lily,0,0,0,,Hari ini
Dialog: 0,0:04:40.34,0:04:42.18,Default,Lily,0,0,0,,tidak ada jarak sosial.
Dialog: 0,0:04:52.72,0:04:55.42,Default,Lily,0,0,0,,Yang Mulia, apakah Anda sudah bangun?
Dialog: 0,0:04:59.66,0:05:00.69,Default,Lily,0,0,0,,Tuhan.
Dialogue: 0,0:05:01.19,0:05:03.70,Default,Lily,0,0,0,,Kenapa kamu kelihatan menakutkan sekali?
Dialogue: 0,0:05:04.00,0:05:06.73,Default,Lily,0,0,0,,Beraninya kau menghancurkan mimpi erotisku?
Dialog: 0,0:05:07.93,0:05:09.37,Default,Lily,0,0,0,,Hubungi dia segera!
Dialog: 0,0:05:09.74,0:05:10.90,Default,Lily,0,0,0,,Oke.
Dialog: 0,0:05:11.81,0:05:12.97,Default,Lily,0,0,0,,Panggilan...
Dialog: 0,0:05:15.58,0:05:16.71,Default,Lily,0,0,0,,Siapa yang harus kita hubungi?
Dialog: 0,0:05:27.05,0:05:28.49,Default,Lily,0,0,0,,Kamus Ratu
Dialog: 0,0:05:29.19,0:05:31.42,Default,Lily,0,0,0,,Suasana hati Anda sedang baik, Yang Mulia.
Dialog: 0,0:05:32.86,0:05:35.13,Default,Lily,0,0,0,,Tidur semalaman tanpa terbangun.
Dialog: 0,0:05:36.33,0:05:38.63,Default,Lily,0,0,0,,Mulai mempersiapkan pesta.
Dialog: 0,0:05:39.87,0:05:40.93,Default,Lily,0,0,0,,Oke.
Dialog: 0,0:05:47.07,0:05:50.44,Default,Lily,0,0,0,,11 episode. Orang yang tidak bisa dimaafkan
Dialog: 0,0:05:51.55,0:05:52.61,Default,Lily,0,0,0,,Dr.
Dialog: 0,0:05:53.85,0:05:55.42,Default,Lily,0,0,0,,Saya bermimpi buruk.
Dialogue: 0,0:05:55.85,0:05:57.95,Default,Lily,0,0,0,,Tapi yang lebih buruk dari mimpi buruk ini,
Dialog: 0,0:05:57.95,0:05:59.49,Default,Lily,0,0,0,,bahwa aku tidak menyukainya
Dialog: 0,0:06:00.89,0:06:03.02,Default,Lily,0,0,0,,dan menyukainya pada saat yang sama.
Dialog: 0,0:06:03.39,0:06:06.29,Default,Lily,0,0,0,,Aku tidak tahu apakah aku merasakannya atau tubuhku.
Dialog: 0,0:06:07.16,0:06:10.53,Default,Lily,0,0,0,,Rasanya seperti aku disatukan.
Dialog: 0,0:06:11.43,0:06:12.50,Default,Lily,0,0,0,,Tepat.
Dialogue: 0,0:06:13.63,0:06:16.90,Default,Lily,0,0,0,,Sepertinya aku berubah menjadi konstruktor Lego.
Dialogue: 0,0:06:17.30,0:06:20.57,Default,Lily,0,0,0,,Siapakah aku ini?
Dialogue: 0,0:06:22.71,0:06:24.61,Default,Lily,0,0,0,,Tapi kenapa
Dialogue: 0,0:06:25.45,0:06:28.42,Default,Lily,0,0,0,,apakah kamu memanggilku “dokter”?
Dialog: 0,0:06:29.25,0:06:31.08,Default,Lily,0,0,0,,Anda menyela saya.
Dialog: 0,0:06:31.08,0:06:33.49,Default,Lily,0,0,0,,Dengarkan saja. Ini memang perlu.
Dialog: 0,0:06:37.19,0:06:40.16,Default,Lily,0,0,0,,Jadi bagaimana pendapat ahlinya?
Dialog: 0,0:06:40.53,0:06:45.07,Default,Lily,0,0,0,,Perubahan pada tubuh adalah efek samping dari keadaan vegetatif.
Dialog: 0,0:06:46.33,0:06:47.40,Default,Lily,0,0,0,,Jadi apakah ini normal?
Dialog: 0,0:06:50.70,0:06:52.71,Default,Lily,0,0,0,,Tidak ada yang aneh.
Dialogue: 0,0:06:54.21,0:06:57.48,Default,Lily,0,0,0,,Sebenarnya cukup menghibur.
Dialog: 0,0:06:57.91,0:07:01.75,Default,Lily,0,0,0,,Mendengar kata-katamu, kegelisahan mulai hilang.
Dialog: 0,0:07:03.58,0:07:06.22,Default,Lily,0,0,0,,Dia yang menyembuhkan tanpa akupunktur -
Dialog: 0,0:07:06.52,0:07:08.25,Default,Lily,0,0,0,,penyembuh hebat.
Dialog: 0,0:07:09.16,0:07:10.19,Default,Lily,0,0,0,,Ternyata
Dialog: 0,0:07:10.92,0:07:14.13,Default,Lily,0,0,0,,dokter kerajaan dan ahli psikologi.
Dialogue: 0,0:07:15.56,0:07:19.17,Default,Lily,0,0,0,,Jadi kapan kondisi bermuka dua campuranku
Dialog: 0,0:07:19.17,0:07:20.53,Default,Lily,0,0,0,,maukah kamu melepaskanku?
Dialog: 0,0:07:20.77,0:07:23.27,Default,Lily,0,0,0,,Semua masalah berhubungan dengan hatimu.
Dialogue: 0,0:07:23.40,0:07:26.67,Default,Lily,0,0,0,,Segera setelah kamu menerima ini, kekhawatiran akan hilang.
Dialog: 0,0:07:26.67,0:07:29.81,Default,Lily,0,0,0,,Kamu bisa mulai hidup kembali tanpa khawatir.
Dialogue: 0,0:07:29.81,0:07:33.58,Default,Lily,0,0,0,,Haruskah aku menerima diriku apa adanya?
Dialog: 0,0:07:36.22,0:07:40.09,Default,Lily,0,0,0,,Masuk akal. Satu-satunya hal yang konstan tentang saya adalah kontradiksi saya.
Dialog: 0,0:07:41.22,0:07:42.26,Default,Lily,0,0,0,,Omong-omong.
Dialogue: 0,0:07:42.99,0:07:45.56,Default,Lily,0,0,0,,Ramuan untuk menutupi kecantikan sungguh luar biasa.
Dialog: 0,0:07:47.29,0:07:48.53,Default,Lily,0,0,0,,Gunakan,
Dialog: 0,0:07:48.53,0:07:50.73,Default,Lily,0,0,0,,untuk membuat produk wajah.
Dialog: 0,0:07:51.50,0:07:53.20,Default,Lily,0,0,0,,Elastisitas, cahaya dan pencerahan.
Dialogue: 0,0:07:53.20,0:07:55.57,Default,Lily,0,0,0,,Tujuannya harus menarik perhatian.
Dialog: 0,0:07:55.57,0:07:57.60,Default,Lily,0,0,0,,Dibutuhkan setiap 28 hari, hasilkan lebih banyak.
Dialog: 0,0:07:58.74,0:08:01.17,Default,Lily,0,0,0,,Mengapa 28 hari?
Dialog: 0,0:08:01.17,0:08:02.48,Default,Lily,0,0,0,,Inilah seberapa banyak kulit diperbarui.
Dialog: 0,0:08:02.98,0:08:04.61,Default,Lily,0,0,0,,Saat kulitnya menjadi keratin,
Dialog: 0,0:08:04.61,0:08:05.98,Default,Lily,0,0,0,,dia akan membutuhkanku.
Dialog: 0,0:08:06.81,0:08:08.21,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:08:08.45,0:08:11.45,Default,Lily,0,0,0,,Tn. Youngjin telah datang kepadamu.
Dialog: 0,0:08:17.56,0:08:19.59,Default,Lily,0,0,0,,Apakah ini benar-benar pelayan Hwajin?
Dialog: 0,0:08:19.89,0:08:21.80,Default,Lily,0,0,0,,Dia yakin akan hal itu.
Dialogue: 0,0:08:23.06,0:08:26.97,Default,Lilia,0,0,0,,Tapi kuharap Ovol sendiri yang menjual noriganya.
Dialog: 0,0:08:27.20,0:08:28.94,Default,Lilia,0,0,0,,Hwajin mungkin kesal.
Dialogue: 0,0:08:30.37,0:08:32.07,Default,Lily,0,0,0,,Kita harus mengunjunginya.
Dialog: 0,0:08:34.37,0:08:37.34,Default,Lily,0,0,0,,Yang Mulia. Selir utama meminta audiensi.
Dialog: 0,0:08:37.38,0:08:38.51,Default,Lily,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:08:42.48,0:08:43.48,Default,Lily,0,0,0,,Selir.
Dialog: 0,0:08:51.49,0:08:52.59,Default,Lily,0,0,0,,Maaf.
Dialog: 0,0:08:55.50,0:08:57.70,Default,Lily,0,0,0,,Saya menggambar Ovol.
Dialogue: 0,0:08:58.43,0:09:01.60,Default,Lily,0,0,0,,Persis seperti itulah aku mengingatnya.
Dialog: 0,0:09:01.97,0:09:03.07,Default,Lily,0,0,0,,Saya yakin,
Dialogue: 0,0:09:03.94,0:09:05.77,Default,Lilia,0,0,0,,bahwa Ovol sendiri menjualnya ke noriga.
Dialog: 0,0:09:06.17,0:09:08.01,Default,Lily,0,0,0,,Dia tidak akan berakhir seperti itu di istana.
Dialog: 0,0:09:09.61,0:09:11.28,Default,Lily,0,0,0,,Anda dapat yakin dengan gambarnya.
Dialog: 0,0:09:16.05,0:09:17.32,Default,Lily,0,0,0,,Permisi.
Dialog: 0,0:09:18.08,0:09:19.15,Default,Lily,0,0,0,,Tentu saja.
Dialog: 0,0:09:26.66,0:09:28.16,Default,Lily,0,0,0,,Saya baru tahu.
Dialog: 0,0:09:29.03,0:09:31.46,Default,Lily,0,0,0,,Kamu mengalami kesulitan tadi malam.
Dialog: 0,0:09:33.13,0:09:36.34,Default,Lily,0,0,0,,Aku menghabiskan sepanjang malam mengumpulkan pikiranku, jangan khawatir.
Dialog: 0,0:09:39.77,0:09:41.88,Default,Lily,0,0,0,,Aku perlu memberitahumu sesuatu.
Dialog: 0,0:09:45.04,0:09:47.68,Default,Lily,0,0,0,,Ini menyangkut perasaanmu terhadap ratu.
Dialog: 0,0:09:48.31,0:09:49.68,Default,Lily,0,0,0,,Lebih sulit mengatasi diri sendiri,
Dialog: 0,0:09:50.45,0:09:53.72,Default,Lily,0,0,0,,daripada mengalahkan orang lain. Oleh karena itu
Dialog: 0,0:09:55.02,0:09:56.56,Default,Lily,0,0,0,,menyerah pada perasaanmu.
Dialog: 0,0:09:58.06,0:10:01.69,Default,Lily,0,0,0,,Saya tidak butuh permintaan maaf Anda.
Dialog: 0,0:10:18.34,0:10:20.21,Default,Lily,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:10:21.65,0:10:23.25,Default,Lily,0,0,0,,Baru sehari sejak aku kembali ke istana,
Dialog: 0,0:10:23.25,0:10:24.85,Default,Lily,0,0,0,,jadi oke.
Dialog: 0,0:10:24.85,0:10:27.72,Default,Lily,0,0,0,,Namun, saya akan sibuk memilih selir.
Dialog: 0,0:10:27.72,0:10:29.56,Default,Lily,0,0,0,,Pemilihan selir.
Dialog: 0,0:10:33.43,0:10:36.90,Default,Lily,0,0,0,,Tiba di kamarku,
Dialog: 0,0:10:37.50,0:10:40.13,Default,Lily,0,0,0,,apakah kamu memperhatikan sesuatu yang aneh?
Dialog: 0,0:10:41.67,0:10:43.67,Default,Lily,0,0,0,,Ada yang aneh?
Dialog: 0,0:10:44.54,0:10:47.31,Default,Lily,0,0,0,,Aku menyeret raja dari sumur, tapi...
Dialog: 0,0:10:47.71,0:10:49.51,Default,Lily,0,0,0,,Tidak. Apakah terjadi sesuatu?
Dialog: 0,0:10:50.68,0:10:51.85,Default,Lily,0,0,0,,Yah...
Dialogue: 0,0:10:53.88,0:10:57.02,Default,Lily,0,0,0,,Kalian berdua mengunjungiku,
Dialog: 0,0:10:57.02,0:10:58.92,Default,Lily,0,0,0,,tanpamu rumah terasa kosong.
Dialogue: 0,0:10:58.92,0:11:00.95,Default,Lily,0,0,0,,Tampaknya inilah inti permasalahannya.
Dialog: 0,0:11:02.19,0:11:04.02,Default,Lily,0,0,0,,Maukah Anda melihat Yang Mulia?
Dialogue: 0,0:11:04.22,0:11:06.36,Default,Lily,0,0,0,,Pisahkan sendiri.
Dialog: 0,0:11:06.36,0:11:07.46,Default,Lily,0,0,0,,Tidak sepadan.
Dialog: 0,0:11:08.33,0:11:10.16,Default,Lily,0,0,0,,Saya pikir dia sedang sibuk menyiapkan pesta.
Dialog: 0,0:11:10.16,0:11:13.37,Default,Lily,0,0,0,,Yang Mulia, saya membawa\N surat ke rumah pengantin wanita.
Dialog: 0,0:11:13.60,0:11:16.24,Default,Lily,0,0,0,,Anda harus mengurus bisnis. aku akan pergi.
Dialog: 0,0:11:25.61,0:11:26.68,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:11:27.95,0:11:30.15,Default,Lily,0,0,0,,Bahkan jika ada 100 selir,
Dialog: 0,0:11:31.48,0:11:33.09,Default,Lily,0,0,0,,mereka tidak akan berani
Dialog: 0,0:11:34.65,0:11:37.06,Default,Lily,0,0,0,,mengambil tempat ratu.
Dialog: 0,0:11:37.66,0:11:39.59,Default,Lily,0,0,0,,Ya. Tentu.
Dialogue: 0,0:11:40.73,0:11:42.70,Default,Lily,0,0,0,,Harap jaga dirimu baik-baik.
Dialog: 0,0:11:45.27,0:11:46.90,Default,Lily,0,0,0,,Selamat tinggal.
Dialog: 0,0:11:54.71,0:11:56.74,Default,Lily,0,0,0,,Han Siok
Dialog: 0,0:11:59.35,0:12:00.51,Default,Lily,0,0,0,,Buang keluarga Khan.
Dialog: 0,0:12:00.81,0:12:02.52,Default,Lily,0,0,0,,Kita bisa melakukannya tanpa Romeo dan Juliet.
Dialogue: 0,0:12:02.95,0:12:05.39,Default,Lily,0,0,0,,Sudahkah kamu membawa silsilah keluarga Han?
Dialog: 0,0:12:07.99,0:12:09.36,Default,Lily,0,0,0,,Han dari Pyeongsan.
Dialog: 0,0:12:11.56,0:12:12.99,Default,Lily,0,0,0,,Khan dari Hanyang.
Dialog: 0,0:12:13.46,0:12:14.76,Default,Lily,0,0,0,,Han dari Anbyon.
Dialog: 0,0:12:15.16,0:12:17.56,Default,Lily,0,0,0,,-Khan dari Yangju.\N-Tunggu.
Dialogue: 0,0:12:18.70,0:12:21.43,Default,Lily,0,0,0,,Apakah ini semua garis keturunan keluarga Han?
Dialog: 0,0:12:22.70,0:12:24.00,Default,Lily,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:12:24.10,0:12:26.61,Default,Lily,0,0,0,,Sial, banyak sekali.
Dialog: 0,0:12:28.61,0:12:32.58,Default,Lily,0,0,0,,Ini tidak akan berhasil. Saya perlu mendapatkan bantuannya.
Dialog: 0,0:12:34.41,0:12:37.12,Default,Lily,0,0,0,,Penjual Bepergian. Saya membutuhkan hal yang sama.
Dialog: 0,0:12:37.82,0:12:40.45,Default,Lily,0,0,0,,-Penjual.\N-Penjualan rumah.
Dialog: 0,0:12:44.19,0:12:46.09,Default,Lily,0,0,0,,Apakah sudah waktunya makan siang?
Dialogue: 0,0:12:47.59,0:12:51.90,Default,Lily,0,0,0,,Waktunya memanjakan kulitmu.
Dialog: 0,0:13:03.14,0:13:04.51,Default,Lily,0,0,0,,Kamu mempesona.
Dialog: 0,0:13:05.71,0:13:09.32,Default,Lily,0,0,0,,Hanya cahaya yang tidak wajar.
Dialog: 0,0:13:09.48,0:13:13.12,Default,Lily,0,0,0,,Terima kasih, hariku dipenuhi dengan perawatan diri.
Dialog: 0,0:13:13.39,0:13:15.86,Default,Lily,0,0,0,,Saya lupa tentang pemilihan selir.
Dialogue: 0,0:13:16.92,0:13:18.49,Default,Lily,0,0,0,,Bagaimana caramu mengatasinya?
Dialog: 0,0:13:19.06,0:13:21.43,Default,Lily,0,0,0,,Saya mencoba yang terbaik.
Dialog: 0,0:13:21.43,0:13:24.40,Default,Lily,0,0,0,,Tentu saja. Berbakat dalam satu hal, berbakat dalam segala hal.
Dialog: 0,0:13:24.40,0:13:27.20,Default,Lily,0,0,0,,Kamu melakukannya dengan baik,
Dialog: 0,0:13:27.20,0:13:28.97,Default,Lily,0,0,0,,bahwa aku percaya padamu.
Dialog: 0,0:13:30.97,0:13:32.57,Default,Lily,0,0,0,,Ada sesuatu yang aku
Dialogue: 0,0:13:32.57,0:13:35.48,Default,Lily,0,0,0,,disiapkan khusus untukmu.
Dialogue: 0,0:13:37.71,0:13:39.51,Default,Lily,0,0,0,,Jika kamu membedaki rambutmu dengan ini,
Dialogue: 0,0:13:39.51,0:13:41.28,Default,Lily,0,0,0,,kamu akan terlihat 10 tahun lebih muda.
Dialogue: 0,0:13:41.65,0:13:43.05,Default,Lily,0,0,0,,Bubuk rambut.
Dialog: 0,0:13:45.28,0:13:49.22,Default,Lily,0,0,0,,Tidak perlu menggunakan jus murbei
Dialog: 0,0:13:49.22,0:13:51.26,Default,Lily,0,0,0,,di kepalaku setiap pagi.
Dialog: 0,0:13:52.16,0:13:53.83,Default,Lily,0,0,0,,Wow.
Dialog: 0,0:13:55.60,0:13:58.23,Default,Lily,0,0,0,,Bubuk dengan lembut.
Dialog: 0,0:13:58.33,0:13:59.93,Default,Lily,0,0,0,,Bubuk.
Dialogue: 0,0:14:04.27,0:14:05.91,Default,Second,0,0,0,,Ini orang yang sama sekali berbeda.
Dialogue: 0,0:14:06.61,0:14:10.31,Default,Second,0,0,0,,Matanya lebih sipit.
Dialog: 0,0:14:10.61,0:14:12.98,Default,Second,0,0,0,,Atau mungkin hanya mata kirinya yang menyipit?
Dialogue: 0,0:14:12.98,0:14:15.38,Default,Second,0,0,0,,Betapa laparnya aku.
Dialog: 0,0:14:21.65,0:14:23.12,Default,Kedua,0,0,0,,Luar Biasa.
Dialogue: 0,0:14:24.32,0:14:27.43,Default,Second,0,0,0,,Wajahnya kurus dengan pipi chubby.
Dialogue: 0,0:14:27.83,0:14:29.50,Default,Second,0,0,0,,Dengan dahi lebar
Dialog: 0,0:14:29.60,0:14:31.26,Default,Second,0,0,0,,dan mata bersinar.
Dialogue: 0,0:14:31.36,0:14:32.97,Default,Second,0,0,0,,Semacam itu.
Dialog: 0,0:14:33.10,0:14:35.47,Default,Kedua,0,0,0,,Cerat lurus dengan ujung membulat.
Dialog: 0,0:15:12.97,0:15:15.91,Default,Kedua,0,0,0,,Yang Mulia, juru masak kerajaan telah tiba.
Dialogue: 0,0:15:17.68,0:15:20.28,Default,Second,0,0,0,,Menurutku minuman keras calamus bisa digunakan. Bagaimana menurutmu?
Dialog: 0,0:15:20.75,0:15:21.81,Default,Kedua,0,0,0,,Apa?
Dialogue: 0,0:15:22.18,0:15:25.49,Default,Second,0,0,0,,Aku terlalu terbawa pikiran.
Dialog: 0,0:15:25.79,0:15:27.95,Default,Second,0,0,0,,Aku sedang memikirkan minuman keras mana yang harus dipilih untuk pesta.
Dialog: 0,0:15:29.69,0:15:33.99,Default,Kedua,0,0,0,,Yang Mulia, saya sudah menyiapkan sesuatu di sini.
Dialogue: 0,0:15:43.04,0:15:45.00,Default,Second,0,0,0,,Aku pantas mati.
Dialog: 0,0:16:01.65,0:16:02.86,Default,Kedua,0,0,0,,Tenang.
Dialogue: 0,0:16:03.59,0:16:05.29,Default,Second,0,0,0,,Maka semuanya akan berjalan lancar.
Dialog: 0,0:16:06.56,0:16:07.99,Default,Kedua,0,0,0,,Seperti yang Anda katakan.
Dialogue: 0,0:16:13.93,0:16:16.07,Default,Second,0,0,0,,Apakah kamu nyaman? Lalu perhatikan.
Dialog: 0,0:16:17.40,0:16:18.64,Default,Kedua,0,0,0,,Apa?
Dialogue: 0,0:16:21.01,0:16:23.21,Default,Second,0,0,0,,Ini adalah rencana pesta tradisional.
Dialog: 0,0:16:23.68,0:16:25.91,Default,Second,0,0,0,,Saya ingin mengubahnya sedikit.
Dialogue: 0,0:16:26.28,0:16:30.05,Default,Second,0,0,0,,Saya ingin mengurangi jumlah piring dan membuangnya
Dialog: 0,0:16:30.05,0:16:32.59,Default,Kedua,0,0,0,,meja besar yang tidak diperlukan dengan makanan di tengahnya.
Dialog: 0,0:16:32.99,0:16:34.89,Default,Kedua,0,0,0,,-Permisi, Baginda.\N-Ya?
Dialog: 0,0:16:35.39,0:16:37.86,Default,Kedua,0,0,0,,Pesta kerajaan
Dialogue: 0,0:16:37.86,0:16:40.66,Default,Second,0,0,0,,harus megah dan mewah.
Dialogue: 0,0:16:40.66,0:16:42.43,Default,Second,0,0,0,,Tidak peduli betapa tidak perlunya...
Dialog: 0,0:16:43.80,0:16:45.06,Default,Kedua,0,0,0,,Apakah kamu sudah gila?
Dialogue: 0,0:16:49.47,0:16:51.90,Default,Second,0,0,0,,Rakyatku menderita kelaparan.
Dialogue: 0,0:16:52.21,0:16:54.07,Default,Second,0,0,0,,Apakah saya akan menerjemahkan makanan untuk bersenang-senang?
Dialogue: 0,0:16:54.27,0:16:56.58,Default,Second,0,0,0,,Lalu makanan yang akan kita siapkan,
Dialog: 0,0:16:57.68,0:17:00.48,Default,Yang kedua,0,0,0,,akan kita berikan kepada yang kelaparan di luar istana.
Dialogue: 0,0:17:04.28,0:17:06.29,Default,Second,0,0,0,,Sederhana, tapi tidak pelit.
Dialogue: 0,0:17:06.85,0:17:09.62,Default,Second,0,0,0,,Indah, tapi tidak megah.
Dialogue: 0,0:17:09.99,0:17:11.52,Default,Second,0,0,0,,Saya ingin pesta seperti itu.
Dialog: 0,0:17:16.63,0:17:20.83,Default,Second,0,0,0,,Saya akan melakukan yang terbaik dalam 2 minggu ke depan.
Dialog: 0,0:17:24.60,0:17:25.67,Default,Second,0,0,0,,Saya harap kita bisa bekerja sama.
Dialog: 0,0:17:32.14,0:17:33.18,Default,Kedua,0,0,0,,Yang Mulia.
Dialogue: 0,0:17:38.12,0:17:40.39,Default,Second,0,0,0,,Apakah semudah itu membuat pria menangis?
Dialogue: 0,0:17:48.43,0:17:50.76,Default,Second,0,0,0,,Aku bahkan tidak percaya,
Dialog: 0,0:17:50.76,0:17:53.07,Default,Second,0,0,0,,seperti penjelasan rinci tentang sumber suap.
Dialogue: 0,0:17:54.63,0:17:57.94,Default,Second,0,0,0,,Ayah ratu lebih teliti dari yang kukira.
Dialog: 0,0:17:58.37,0:18:02.34,Default,Kedua,0,0,0,,Musuh selir kerajaan Cho\N bukanlah klan Kim, melainkan ratu.
Dialog: 0,0:18:04.08,0:18:06.48,Default,Second,0,0,0,,Jadi dia tidak bisa melihat gambaran besarnya.
Dialogue: 0,0:18:15.39,0:18:19.19,Default,Second,0,0,0,,Kita harus mengelola buku besar dengan benar.
Dialogue: 0,0:18:19.19,0:18:21.66,Default,Second,0,0,0,,Dan kemudian kita akan menghancurkan keluarga Kim
Dialog: 0,0:18:22.09,0:18:25.06,Default,Kedua,0,0,0,,dan kami akan menggulingkan ratu dari takhta.
Dialog: 0,0:18:31.27,0:18:32.41,Default,Kedua,0,0,0,,Buku akun?
Dialogue: 0,0:18:33.91,0:18:36.51,Default,Second,0,0,0,,Apa yang dia pikirkan? Bagaimana dia bisa menyimpan sesuatu yang begitu berbahaya?
Dialog: 0,0:18:36.51,0:18:37.68,Default,Kedua,0,0,0,,Saya harus...
Dialogue: 0,0:18:40.78,0:18:42.38,Default,Second,0,0,0,,Rahasiakan ini untuk saat ini.
Dialogue: 0,0:18:42.38,0:18:44.38,Default,Second,0,0,0,,Jika anggota keluarga yang lain mengetahuinya, mereka akan membuat keributan.
Dialogue: 0,0:18:44.38,0:18:47.15,Default,Second,0,0,0,,Bagaimana bisa. Bodoh sekali.
Dialog: 0,0:18:48.79,0:18:49.89,Default,Kedua,0,0,0,,Namun,
Dialog: 0,0:18:50.99,0:18:52.83,Default,Kedua,0,0,0,,Menurut Anda siapa yang memiliki buku itu?
Dialog: 0,0:18:52.83,0:18:55.49,Default,Kedua,0,0,0,,Raja menghabiskan 2 hari di rumahnya,
Dialog: 0,0:18:55.49,0:18:57.66,Default,Second,0,0,0,,dia mengabaikan permintaan untuk kembali ke istana.
Dialog: 0,0:18:57.66,0:18:58.70,Default,Kedua,0,0,0,,Jadi,
Dialog: 0,0:19:00.30,0:19:01.33,Default,Kedua,0,0,0,,raja?
Dialog: 0,0:19:03.20,0:19:06.61,Default,Second,0,0,0,,Dia ingin mengungkapkan kita pada pesta di Hari Kereta.
Dialog: 0,0:19:07.01,0:19:08.91,Default,Kedua,0,0,0,,Mungkin senjata ada di tangannya,
Dialog: 0,0:19:09.81,0:19:12.88,Default,Second,0,0,0,,tapi kita harus melemahkannya agar tidak memanfaatkannya.
Dialog: 0,0:19:14.45,0:19:15.75,Default,Kedua,0,0,0,,Kim Moon-geun berpikir,
Dialogue: 0,0:19:16.75,0:19:19.55,Default,Second,0,0,0,,bahwa akulah satu-satunya tersangka yang tersisa.
Dialog: 0,0:19:19.55,0:19:22.15,Default,Kedua,0,0,0,,Tapi dia tidak bisa bertanya pada raja apakah dia mencuri buku itu.
Dialogue: 0,0:19:22.52,0:19:23.76,Default,Second,0,0,0,,Pasti sulit baginya.
Dialog: 0,0:19:24.59,0:19:27.36,Default,Second,0,0,0,,Sudahkah kita mengetahui siapa yang bersembunyi di balik topeng?
Dialog: 0,0:19:27.36,0:19:28.83,Default,Kedua,0,0,0,,Di Departemen Detektif
Dialogue: 0,0:19:28.83,0:19:30.70,Default,Second,0,0,0,,tidak ada yang mempunyai bekas luka di pipinya.
Dialogue: 0,0:19:31.50,0:19:33.87,Default,Second,0,0,0,,Bahkan jika kita tidak menerima buku besarnya,
Dialog: 0,0:19:34.37,0:19:37.37,Default,Second,0,0,0,,kita harus menyiapkan konspirasi untuk mencapai tujuan kita.
Dialog: 0,0:19:38.30,0:19:40.84,Default,Second,0,0,0,,Sudahkah Anda mempelajari posisi genera lain?
Dialogue: 0,0:19:51.88,0:19:53.32,Default,Second,0,0,0,,Hukum Lima Detik.
Dialogue: 0,0:19:53.82,0:19:56.59,Default,Second,0,0,0,,Lima detik sudah cukup untuk jatuh cinta.
Dialog: 0,0:19:59.13,0:20:01.59,Default,Kedua,0,0,0,,Yang Mulia, semuanya ada di sini.
Dialog: 0,0:20:01.59,0:20:03.13,Default,Kedua,0,0,0,,-Apakah itu saja?\N-Ya.
Dialog: 0,0:20:08.40,0:20:09.50,Default,Kedua,0,0,0,,Senang bertemu denganmu.
Dialog: 0,0:20:11.00,0:20:12.04,Default,Kedua,0,0,0,,Senang bertemu denganmu.
Dialogue: 0,0:20:12.71,0:20:17.08,Default,Second,0,0,0,,Senang bertemu denganmu.
Dialogue: 0,0:20:17.81,0:20:19.11,Default,Second,0,0,0,,Mari kita lihat.
Dialogue: 0,0:20:19.11,0:20:21.48,Default,Second,0,0,0,,Sebuah percikan muncul antara aku dan...
Dialogue: 0,0:20:29.66,0:20:30.86,Default,Second,0,0,0,,Saya juga suka yang ini.
Dialogue: 0,0:20:36.66,0:20:41.60,Default,Second,0,0,0,,Nona Yun, kamu cantik sekali, boleh ceritakan lebih banyak tentang dirimu kepada kami?
Dialog: 0,0:20:43.50,0:20:47.71,Default,Kedua,0,0,0,,Ada gunung yang indah di kampung halamanku.
Dialog: 0,0:20:48.17,0:20:50.01,Default,Kedua,0,0,0,,Disebut Gunung Kamaksan.
Dialogue: 0,0:20:50.21,0:20:52.38,Default,Second,0,0,0,,-Kamaksan?\N-Ya, ratu.
Dialogue: 0,0:20:54.51,0:20:56.12,Default,Second,0,0,0,,Sungguh menakjubkan.
Dialog: 0,0:20:56.12,0:20:57.22,Default,Kedua,0,0,0,,-Luar Biasa?\N-Luar Biasa?
Dialog: 0,0:20:59.59,0:21:00.65,Default,Kedua,0,0,0,,-Yang Mulia.\N-Ya?
Dialogue: 0,0:21:00.65,0:21:03.59,Default,Second,0,0,0,,Ada sebuah istana besar di kotaku.
Dialogue: 0,0:21:03.59,0:21:05.76,Default,Second,0,0,0,,Dibangun oleh Raja Jeongjo.
Dialogue: 0,0:21:05.76,0:21:08.29,Default,Second,0,0,0,,Kamu hanya bisa menyombongkan Istana Hwaseong?
Dialogue: 0,0:21:09.83,0:21:12.13,Default,Second,0,0,0,,Hanya bicara tentang dia.
Dialogue: 0,0:21:12.63,0:21:15.07,Default,Second,0,0,0,,Kamu bisa menyombongkan satu hal lagi,
Dialogue: 0,0:21:15.07,0:21:17.90,Default,Second,0,0,0,,jika kamu menjadi selir, Ny. Hong.
Dialog: 0,0:21:19.17,0:21:21.07,Default,Kedua,0,0,0,,Ratu, terima kasih!
Dialogue: 0,0:21:23.98,0:21:27.18,Default,Second,0,0,0,,Di kampung halamanku terdapat banyak ladang pohon persik.
Dialog: 0,0:21:27.18,0:21:29.38,Default,Kedua,0,0,0,,Selama periode pembungaan
Dialogue: 0,0:21:30.12,0:21:31.75,Default,Second,0,0,0,,tidak ada tempat yang lebih megah.
Dialogue: 0,0:21:33.89,0:21:36.62,Default,Second,0,0,0,,Ibuku memimpikan buah persik saat aku lahir.
Dialogue: 0,0:21:37.12,0:21:39.06,Default,Second,0,0,0,,Tidak mengherankan.
Dialogue: 0,0:21:39.06,0:21:41.23,Default,Second,0,0,0,,Jika kamu bisa membandingkan seseorang dengan buah persik,
Dialog: 0,0:21:41.59,0:21:44.60,Default,Second,0,0,0,,jadi hanya kamu saja, Bu Min.
Dialog: 0,0:21:46.73,0:21:48.63,Default,Kedua,0,0,0,,Persikku.
Dialogue: 0,0:21:49.24,0:21:52.40,Default,Second,0,0,0,,Jika kamu memenangkan ketiga jenis ini di pihakmu,
Dialogue: 0,0:21:53.81,0:21:57.78,Default,Second,0,0,0,,maka akan ada seekor naga dan dua burung phoenix di sisimu.
Dialog: 0,0:21:59.18,0:22:01.21,Default,Kedua,0,0,0,,Dan kemudian kamu bisa menaklukkan harimau putih.
Dialog: 0,0:22:08.29,0:22:10.49,Default,Kedua,0,0,0,,Sementara Istana Hwaseong menjaga gerbang,
Dialogue: 0,0:22:11.62,0:22:13.86,Default,Second,0,0,0,,pemandangan Gunung Camaksan memanjakan mataku,
Dialog: 0,0:22:14.56,0:22:19.23,Default,Second,0,0,0,,dan aroma manis buah persik memenuhi kamarku.
Dialog: 0,0:22:37.12,0:22:39.99,Default,Kedua,0,0,0,,Klan Phapyeong Yun. Klan Namyan, Hon.
Dialog: 0,0:22:40.55,0:22:41.79,Default,Kedua,0,0,0,,Klan Johyn Min.
Dialogue: 0,0:22:42.19,0:22:44.06,Default,Second,0,0,0,,Keseimbangan kekuatan yang luar biasa.
Dialog: 0,0:22:46.83,0:22:50.06,Default,Kedua,0,0,0,,Lugu, seksi dan manis.
Dialog: 0,0:22:50.50,0:22:51.93,Default,Kedua,0,0,0,,Harmoni sejati.
Dialog: 0,0:22:58.84,0:23:00.67,Default,Kedua,0,0,0,,Yun Gyonok dari keluarga Phapyeong Yun.
Dialog: 0,0:23:01.44,0:23:03.21,Default,Second,0,0,0,,Min Jayon dari klan Yohyn Min.
Dialogue: 0,0:23:03.94,0:23:06.01,Default,Second,0,0,0,,Khon Simkhyan dari keluarga Namyang Khon.
Dialog: 0,0:23:06.75,0:23:10.18,Default,Kedua,0,0,0,,Saya menunjuk Anda sebagai selir peringkat kedua.
Dialog: 0,0:23:13.82,0:23:18.09,Default,Kedua,0,0,0,,Ketiga selir dan keluarganya bergabung dengan keluarga kerajaan.
Dialogue: 0,0:23:18.66,0:23:21.33,Default,Second,0,0,0,,Beri tahu keluargamu
Dialog: 0,0:23:21.33,0:23:23.93,Default,Kedua,0,0,0,,undangan ke pesta di Hari Kereta.
Dialog: 0,0:23:24.40,0:23:27.50,Default,Kedua,0,0,0,,-Terima kasih, Yang Mulia.\N-Terima kasih, Yang Mulia.
Dialogue: 0,0:23:32.74,0:23:34.27,Default,Second,0,0,0,,Yah, akhirnya.
Dialog: 0,0:23:35.07,0:23:37.74,Default,Kedua,0,0,0,,Raja mulai mengumpulkan sekutu di sekelilingnya.
Dialog: 0,0:23:38.28,0:23:40.45,Default,Kedua,0,0,0,,Tapi mereka akan memutuskan semua hubungan dengannya,
Dialog: 0,0:23:40.45,0:23:42.62,Default,Second,0,0,0,,segera setelah mereka mengetahui betapa lemahnya dia.
Dialog: 0,0:23:44.68,0:23:48.62,Default,Kedua,0,0,0,,Raja bersikeras mengadakan pesta.
Dialogue: 0,0:23:48.89,0:23:50.16,Default,Second,0,0,0,,Inikah yang diinginkannya?
Dialog: 0,0:23:51.42,0:23:54.33,Default,Second,0,0,0,,-Saya harap Anda bersiap-siap.\N-Jangan khawatir.
Dialog: 0,0:24:04.20,0:24:05.24,Default,Kedua,0,0,0,,Lainnya!
Dialog: 0,0:24:08.74,0:24:11.28,Default,Second,0,0,0,,Semua orang mungkin sangat ingin tahu apa yang ada di balik tembok.
Dialogue: 0,0:24:12.88,0:24:15.38,Default,Second,0,0,0,,Mereka melakukannya dengan sangat baik.
Dialog: 0,0:24:16.58,0:24:17.88,Default,Kedua,0,0,0,,Ibu Suri akan datang.
Dialogue: 0,0:24:22.05,0:24:24.79,Default,Second,0,0,0,,Semoga kamu baik-baik saja, Ibu Suri.
Dialog: 0,0:24:27.29,0:24:29.63,Default,Kedua,0,0,0,,Lama tidak bertemu, selir kerajaan Cho.
Dialog: 0,0:24:30.96,0:24:33.43,Default,Ketiga,0,0,0,,Halo, Yang Mulia.
Dialog: 0,0:24:36.14,0:24:39.10,Default,Ketiga,0,0,0,,Jika kamu mengizinkanku, aku akan meninggalkanmu, aku ingin berlatih menembak.
Dialog: 0,0:24:48.45,0:24:49.52,Default,Ketiga,0,0,0,,Kamu sudah lama berada di sini
Dialog: 0,0:24:49.52,0:24:51.22,Default,Ketiga,0,0,0,,sadar setelah sakit.
Dialog: 0,0:24:51.22,0:24:53.19,Default,Ketiga,0,0,0,,Tapi dia tidak pernah mengunjungiku.
Dialog: 0,0:24:54.89,0:24:56.36,Default,Ketiga,0,0,0,,Saya sibuk memilih pasangan
Dialog: 0,0:24:56.36,0:24:57.79,Default,Ketiga,0,0,0,,untuk Yang Mulia.
Dialog: 0,0:24:58.79,0:25:00.46,Default,Ketiga,0,0,0,,Maafkan saya.
Dialog: 0,0:25:01.06,0:25:04.70,Default,Ketiga,0,0,0,,Bagi seseorang yang telah menghadapi kematian, kamu sangat segar.
Dialog: 0,0:25:06.20,0:25:08.30,Default,Ketiga,0,0,0,,Saya tidak pernah mengeluh tentang kesehatan saya.
Dialog: 0,0:25:09.97,0:25:12.62,Default,Ketiga,0,0,0,,Jadi kamu menyerah,\Nkamu tidak mau berburu di Hari Kereta?
Dialog: 0,0:25:13.04,0:25:15.31,Default,Ketiga,0,0,0,,Daripada berlatih dengan busur
Dialog: 0,0:25:15.47,0:25:17.28,Default,Ketiga,0,0,0,,Anda bersenang-senang di sini.
Dialogue: 0,0:25:17.28,0:25:19.28,Default,Ketiga,0,0,0,,Permaisuri Cho tetap akan menang.
Dialog: 0,0:25:19.28,0:25:21.41,Default,Ketiga,0,0,0,,Saya memutuskan untuk menikmati liburan.
Dialog: 0,0:25:22.25,0:25:24.35,Default,Ketiga,0,0,0,,Mungkin aku pandai menguntit "mangsa"
Dialog: 0,0:25:24.35,0:25:26.39,Default,Ketiga,0,0,0,,tapi berburu bukanlah kesukaanku.
Dialog: 0,0:25:27.32,0:25:28.49,Default,Ketiga,0,0,0,,Penganiayaan?
Dialog: 0,0:25:28.49,0:25:29.96,Default,Ketiga,0,0,0,,Kau tahu,
Dialog: 0,0:25:29.96,0:25:33.03,Default,Ketiga,0,0,0,,mengapa gadis-gadis muda di halaman berpartisipasi dalam perburuan
Dialog: 0,0:25:33.03,0:25:34.63,Default,Ketiga,0,0,0,,pada Hari Keranjang?
Dialog: 0,0:25:35.63,0:25:37.96,Default,Ketiga,0,0,0,,Tidak, tidak juga.
Dialog: 0,0:25:42.00,0:25:45.64,Default,Ketiga,0,0,0,,Pada hari ini kita mengusir roh jahat.
Dialog: 0,0:25:46.17,0:25:47.91,Default,Ketiga,0,0,0,,Sebelumnya, roh jahat diusir
Dialog: 0,0:25:47.91,0:25:49.61,Default,Ketiga,0,0,0,,darah orang yang terbunuh.
Dialog: 0,0:25:50.11,0:25:53.48,Default,Ketiga,0,0,0,,Tapi kita malah berburu binatang.
Dialog: 0,0:26:02.52,0:26:06.13,Default,Ketiga,0,0,0,,Sebenarnya, ada mayat yang ditemukan di sumur istana.
Dialog: 0,0:26:06.73,0:26:08.84,Default,Ketiga,0,0,0,,Dikatakan bahwa nyonya istana ini \Nmelayani Selir Cho.
Dialog: 0,0:26:09.53,0:26:10.63,Default,Ketiga,0,0,0,,Di dalam sumur?
Dialog: 0,0:26:12.36,0:26:13.90,Default,Ketiga,0,0,0,,Bagaimana?
Dialog: 0,0:26:15.33,0:26:16.37,Default,Ketiga,0,0,0,,Yang Mulia.
Dialog: 0,0:26:16.37,0:26:18.20,Default,Ketiga,0,0,0,,-Datanglah kepada kami.\N-Datanglah kepada kami.
Dialog: 0,0:26:18.67,0:26:19.91,Default,Ketiga,0,0,0,,Oke.
Dialog: 0,0:26:26.75,0:26:29.11,Default,Ketiga,0,0,0,,-Wow.\N-Luar Biasa.
Dialog: 0,0:26:29.58,0:26:31.95,Default,Ketiga,0,0,0,,Yang Mulia adalah seorang master.
Dialog: 0,0:26:35.02,0:26:36.32,Default,Ketiga,0,0,0,,Triple Axel.
Dialog: 0,0:26:49.51,0:26:52.41,Default,Ketiga,0,0,0,,Aku tidak bisa tidur dan berguling-guling.
Dialogue: 0,0:26:55.88,0:26:58.09,Default,Ketiga,0,0,0,,Mungkin sebaiknya aku menulis pesan pada selir tersayang?
Dialog: 0,0:27:01.39,0:27:03.13,Default,Ketiga,0,0,0,,Apa yang harus saya tulis?
Dialog: 0,0:27:04.06,0:27:08.13,Default,Ketiga,0,0,0,,Permulaan yang sederhana tidak mengharuskan Anda melakukan apa pun, tetapi membangkitkan emosi.
Dialog: 0,0:27:09.40,0:27:10.47,Default,Ketiga,0,0,0,,Tepat.
Dialog: 0,0:27:32.19,0:27:34.12,Default,Ketiga,0,0,0,,Kirimkan pada mereka.
Dialog: 0,0:27:34.72,0:27:35.76,Default,Ketiga,0,0,0,,Ya.
Dialog: 0,0:27:36.39,0:27:37.39,Default,Ketiga,0,0,0,,Tunggu sebentar.
Dialog: 0,0:27:38.06,0:27:40.76,Default,Ketiga,0,0,0,,Perintah untuk menjaga matamu tetap terbuka untuk melihat apakah raja akan muncul.
Dialog: 0,0:27:41.50,0:27:42.53,Default,Ketiga,0,0,0,,Ya.
Dialog: 0,0:27:47.14,0:27:49.14,Default,Ketiga,0,0,0,,Satu pesan untuk setiap pasangan.
Dialog: 0,0:27:49.14,0:27:50.97,Default,Ketiga,0,0,0,,-Dan periksa di mana raja berada.\N-Dan periksa di mana raja berada.
Dialog: 0,0:27:50.97,0:27:52.71,Default,Ketiga,0,0,0,,Satu pesan untuk pasangan.
Dialog: 0,0:27:52.71,0:27:54.14,Default,Ketiga,0,0,0,,Dan periksa di mana rajanya berada.
Dialog: 0,0:27:59.25,0:28:00.38,Default,Ketiga,0,0,0,,Untukmu.
Dialog: 0,0:28:03.05,0:28:04.59,Default,Ketiga,0,0,0,,Masuk.
Dialog: 0,0:28:05.42,0:28:07.22,Default,Ketiga,0,0,0,,Satu pesan untuk raja.
Dialog: 0,0:28:07.22,0:28:08.99,Default,Ketiga,0,0,0,,Dan periksa di mana pasangannya berada.
Dialog: 0,0:28:08.99,0:28:10.06,Default,Ketiga,0,0,0,,Apa?
Dialog: 0,0:28:10.06,0:28:12.06,Default,Ketiga,0,0,0,,-Satu pesan untuk raja.\N-Sesuatu telah berubah.
Dialog: 0,0:28:12.06,0:28:13.86,Default,Ketiga,0,0,0,,Dan periksa di mana pasangannya berada.
Dialog: 0,0:28:19.13,0:28:20.44,Default,Ketiga,0,0,0,,"Apakah kamu sedang tidur?"
Dialog: 0,0:28:21.17,0:28:22.30,Default,Ketiga,0,0,0,,Apakah kamu sedang tidur?
Dialog: 0,0:28:24.14,0:28:25.21,Default,Ketiga,0,0,0,,Yah...
Dialog: 0,0:28:29.01,0:28:30.05,Default,Ketiga,0,0,0,,"Apakah kamu sedang tidur?"
Dialog: 0,0:28:36.22,0:28:37.32,Default,Ketiga,0,0,0,,"Apakah kamu sedang tidur?"
Dialogue: 0,0:28:40.89,0:28:44.43,Default,Ketiga,0,0,0,,Kenapa dia begitu tertarik pada apakah aku sedang tidur atau tidak?
Dialog: 0,0:28:45.33,0:28:46.93,Default,Ketiga,0,0,0,,Saya bertanya tiga kali.
Dialog: 0,0:28:53.34,0:28:54.80,Default,Ketiga,0,0,0,,Jawaban telah tiba.
Dialog: 0,0:28:55.64,0:28:58.64,Default,Ketiga,0,0,0,,Saya kirim 3, kenapa hanya ada satu jawaban?
Dialog: 0,0:29:00.41,0:29:02.64,Default,Ketiga,0,0,0,,Apakah mereka menulis novel untukku di sana?
Dialog: 0,0:29:06.95,0:29:09.38,Default,Ketiga,0,0,0,,Baiklah, mari kita lihat.
Dialogue: 0,0:29:11.29,0:29:14.39,Default,Third,0,0,0,,Tulisan tangan yang indah sekali.\NItulah artinya berasal dari keluarga baik-baik.
Dialog: 0,0:29:17.03,0:29:19.66,Default,Ketiga,0,0,0,,Pada malam tanpa tidur aku berjalan.
Dialog: 0,0:29:20.93,0:29:24.07,Default,Ketiga,0,0,0,,Cahaya menerobos langit malam yang gelap.
Dialog: 0,0:29:25.03,0:29:28.74,Default,Ketiga,0,0,0,,Aku mengangkat kepalaku - mungkin itu bulan?\NNTidak, ini sahabatku.
Dialog: 0,0:29:30.74,0:29:32.91,Default,Ketiga,0,0,0,,Malu Spanyol.\NTapi itu menyentuh jiwa.
Dialog: 0,0:29:33.64,0:29:35.64,Default,Ketiga,0,0,0,,Kita juga harus...
Dialog: 0,0:30:00.54,0:30:02.30,Default,Ketiga,0,0,0,,-Hon Young.\N-Ya, Yang Mulia.
Dialog: 0,0:30:03.54,0:30:05.87,Default,Ketiga,0,0,0,,Inilah jawabannya. Kirimkan ke pengirim surat itu.
Dialog: 0,0:30:06.48,0:30:09.11,Default,Ketiga,0,0,0,,Saya memikirkan banyak hal.
Dialog: 0,0:30:09.11,0:30:11.21,Default,Ketiga,0,0,0,,Dengan hati bahagia aku tenggelam dalam pikiranmu.
Dialog: 0,0:30:11.21,0:30:13.92,Default,Ketiga,0,0,0,,Tolong, baris ke saya.
Dialog: 0,0:30:14.52,0:30:18.99,Default,Ketiga,0,0,0,,Aku tidak melepaskan pikiran tentangmu.
Dialog: 0,0:30:21.86,0:30:22.96,Default,Ketiga,0,0,0,,Ratuku.
Dialog: 0,0:30:28.23,0:30:30.47,Default,Ketiga,0,0,0,,Jadi pengetahuan dari kursus pengantar berguna.
Dialog: 0,0:30:30.93,0:30:34.00,Default,Ketiga,0,0,0,,Bagus, begitulah caraku mendapatkan kembali kejantananku.
Dialog: 0,0:30:36.14,0:30:37.21,Default,Ketiga,0,0,0,,Oke.
Dialog: 0,0:31:25.95,0:31:27.39,Default,Ketiga,0,0,0,,Ikuti resep yang sama,
Dialogue: 0,0:31:27.89,0:31:29.73,Default,Third,0,0,0,,tapi lebih baik ganti croakernya
Dialog: 0,0:31:31.16,0:31:32.23,Default,Ketiga,0,0,0,,untuk ikan air tawar.
Dialog: 0,0:31:32.23,0:31:33.23,Default,Ketiga,0,0,0,,
Dialogue: 0,0:31:35.26,0:31:38.23,Default,Third,0,0,0,,Dapatkan inspirasi untuk puisi dan suratmu?
Dialogue: 0,0:31:38.90,0:31:40.04,Default,Ketiga,0,0,0,,Ratuku.
Dialog: 0,0:31:40.60,0:31:41.70,Default,Ketiga,0,0,0,,Astaga.
Dialog: 0,0:31:42.07,0:31:43.14,Default,Ketiga,0,0,0,,Ratu.
Dialog: 0,0:31:43.81,0:31:45.64,Default,Ketiga,0,0,0,,Kamu! Sudah kubilang kamu tidak bisa datang ke sini.
Dialog: 0,0:31:46.14,0:31:47.24,Default,Ketiga,0,0,0,,Tapi...
Dialog: 0,0:31:47.38,0:31:48.74,Default,Ketiga,0,0,0,,Aku bertingkah seolah kita pasangan,
Dialog: 0,0:31:48.74,0:31:50.65,Default,Ketiga,0,0,0,,karena ini adalah acara resmi.
Dialog: 0,0:31:50.65,0:31:53.02,Default,Ketiga,0,0,0,,Bagiku sekarang sangat penting untuk menemukan diriku lagi.
Dialog: 0,0:31:53.02,0:31:54.12,Default,Ketiga,0,0,0,,Tolong jangan ikut campur.
Dialog: 0,0:31:54.62,0:31:55.62,Default,Ketiga,0,0,0,,Kasar.
Dialog: 0,0:31:55.62,0:31:56.65,Default,Ketiga,0,0,0,,Apa itu.
Dialog: 0,0:31:58.49,0:32:00.22,Default,Ketiga,0,0,0,,Bagaimana dia bisa berubah seperti itu?
Dialog: 0,0:32:02.62,0:32:04.73,Default,Ketiga,0,0,0,,Sang Ratu lebih pemalu dari kelihatannya.
Dialog: 0,0:32:09.90,0:32:11.80,Default,Ketiga,0,0,0,,Daftar hidangan untuk upacara sudah siap.
Dialogue: 0,0:32:12.67,0:32:13.77,Default,Ketiga,0,0,0,,Kerja bagus.
Dialog: 0,0:32:15.77,0:32:18.57,Default,Ketiga,0,0,0,,Sudahkah Anda memeriksa daftar persembahan untuk upacara tersebut?
Dialog: 0,0:32:18.94,0:32:20.48,Default,Ketiga,0,0,0,,Ini daftarnya.
Dialogue: 0,0:32:20.48,0:32:22.41,Default,Third,0,0,0,,Kenapa semuanya bilang “bone-on”?
Dialog: 0,0:32:23.71,0:32:26.95,Default,Ketiga,0,0,0,,Daftar hidangan adalah menunya.
Dialog: 0,0:32:27.18,0:32:30.29,Default,Ketiga,0,0,0,,Daftar persembahan adalah daftar hal-hal untuk ritual.
Dialog: 0,0:32:30.85,0:32:32.15,Default,Ketiga,0,0,0,,Ada apa dengan anda, Yang Mulia?
Dialog: 0,0:32:32.25,0:32:34.39,Default,Ketiga,0,0,0,,Benarkah? Jadi, apakah aku orang mesum yang tuli?
Dialog: 0,0:32:37.56,0:32:39.29,Default,Ketiga,0,0,0,,Yang Mulia!
Dialog: 0,0:32:43.30,0:32:45.27,Default,Ketiga,0,0,0,,Kamu banyak bekerja.
Dialog: 0,0:32:45.27,0:32:47.87,Default,Ketiga,0,0,0,,Istirahatlah, Yang Mulia.
Dialog: 0,0:32:48.64,0:32:49.77,Default,Ketiga,0,0,0,,Tidak.
Dialog: 0,0:32:50.71,0:32:52.27,Default,Ketiga,0,0,0,,Tidak ada waktu. Mari kita lanjutkan.
Dialog: 0,0:32:54.48,0:32:55.74,Default,Ketiga,0,0,0,,Aku hampir merasa kasihan padanya.
Dialog: 0,0:32:56.81,0:32:58.91,Default,Ketiga,0,0,0,,Bukan itu intinya. Hari ini saya akan menulis surat dengan lebih marah.
Dialog: 0,0:32:59.55,0:33:01.02,Default,Ketiga,0,0,0,,Boner adalah kata yang berbahaya menurut Freud.
Dialog: 0,0:33:01.02,0:33:03.15,Default,Ketiga,0,0,0,,Mimisannya jelas bukan karena pekerjaan.
Dialog: 0,0:33:07.32,0:33:09.96,Default,Ketiga,0,0,0,,Dengan namamu di bibirku aku akan mati!
Dialog: 0,0:33:10.29,0:33:13.33,Default,Ketiga,0,0,0,,Itu akan tetap ada dalam ingatanku - jangan lupakan itu.
Dialogue: 0,0:33:15.00,0:33:17.07,Default,Ketiga,0,0,0,,Bagaimana dia bisa menjadi satu malam dan satu malam lagi di siang hari?
Dialog: 0,0:33:17.73,0:33:20.34,Default,Ketiga,0,0,0,,Tidak dapat memutuskan apakah akan memaafkanku
Dialog: 0,0:33:20.34,0:33:21.90,Default,Ketiga,0,0,0,,atau tidak?
Dialog: 0,0:33:30.65,0:33:33.15,Default,Ketiga,0,0,0,,Saya tidak menyesal atas patah hati saya.
Dialog: 0,0:33:33.85,0:33:36.32,Default,Ketiga,0,0,0,,Apakah ada jalan yang bisa kita lewati bersama?
Dialog: 0,0:33:44.63,0:33:48.20,Default,Ketiga,0,0,0,,Saya harap lain kali kami\Nakan mengikutinya dari awal.
Dialog: 0,0:33:48.63,0:33:51.20,Default,Ketiga,0,0,0,,Bahkan dalam mimpi.
Dialog: 0,0:34:06.48,0:34:08.22,Default,Ketiga,0,0,0,,Berlatih dengan pedang di malam hari?
Dialog: 0,0:34:08.45,0:34:10.32,Default,Ketiga,0,0,0,,Satu orang abnormal sudah cukup bagi kita.
Dialog: 0,0:34:10.32,0:34:12.65,Default,Ketiga,0,0,0,,Kita perlu mempersiapkan pertempuran untuk liburan.
Dialog: 0,0:34:13.12,0:34:14.96,Default,Ketiga,0,0,0,,Nah, lalu berlatihlah dengan seseorang dari Syskny.
Dialogue: 0,0:34:17.49,0:34:20.60,Default,Ketiga,0,0,0,,Bagaimana kamu menilai kemampuan pedangmu?
Dialog: 0,0:34:20.80,0:34:21.96,Default,Ketiga,0,0,0,,Saya tidak tahu.
Dialog: 0,0:34:22.10,0:34:24.27,Default,Ketiga,0,0,0,,Saya tidak pernah memberikan segalanya.
Dialog: 0,0:34:25.80,0:34:27.50,Default,Ketiga,0,0,0,,Itulah sebabnya aku membutuhkanmu.
Dialog: 0,0:34:28.34,0:34:30.17,Default,Ketiga,0,0,0,,Musuh yang kekuatannya tidak kuketahui.
Dialog: 0,0:35:04.34,0:35:07.34,Default,Ketiga,0,0,0,,Hari Kereta
Dialogue: 0,0:35:07.44,0:35:08.94,Default,Ketiga,0,0,0,,Panjang umur dan semoga beruntung
Dialog: 0,0:35:14.68,0:35:17.72,Default,Ketiga,0,0,0,,
Dialog: 0,0:35:29.83,0:35:31.53,Default,Ketiga,0,0,0,,Cuacanya bagus, Yang Mulia.
Dialog: 0,0:35:31.53,0:35:32.97,Default,Ketiga,0,0,0,,Benarkah? Ini bagus.
Dialog: 0,0:35:32.97,0:35:35.43,Default,Ketiga,0,0,0,,Aku benci kalau hujan pada hari pertandingan olahraga.
Dialog: 0,0:35:38.24,0:35:41.11,Default,Keempat,0,0,0,,Ayahku akan datang. Oleh karena itu, Anda harus lebih cantik lagi.
Dialog: 0,0:35:41.28,0:35:44.05,Default,Keempat,0,0,0,,Ini hari pertama aku akan tampil di depan semua orang.
Dialog: 0,0:35:44.05,0:35:45.48,Default,Keempat,0,0,0,,Perhatikan lebih lanjut.
Dialog: 0,0:35:49.22,0:35:50.92,Default,Keempat,0,0,0,,Ya. saya cantik.
Dialog: 0,0:35:52.02,0:35:53.42,Default,Keempat,0,0,0,,Semua orang akan menatapku, kan?
Dialog: 0,0:36:06.27,0:36:09.24,Default,Keempat,0,0,0,,Apakah Anda akan menggunakan \Ntip logam?
Dialog: 0,0:36:10.41,0:36:11.54,Default,Keempat,0,0,0,,Hari ini saya perlu
Dialog: 0,0:36:15.48,0:36:16.88,Default,Keempat,0,0,0,,tangkap hewan besar.
Dialog: 0,0:36:20.25,0:36:22.25,Default,Keempat,0,0,0,,Oke, kami harus mengirimkan ini secepatnya.
Dialog: 0,0:36:22.25,0:36:23.65,Default,Keempat,0,0,0,,Pindah.
Dialog: 0,0:36:26.02,0:36:27.42,Default,Keempat,0,0,0,,Halo pak.
Dialog: 0,0:36:27.62,0:36:31.09,Default,Keempat,0,0,0,,Kami punya makanan segar untuk jamuan makan dalam rangka Hari Kereta
Dialog: 0,0:36:31.09,0:36:32.96,Default,Keempat,0,0,0,,dan persembahan kerajaan.
Dialog: 0,0:36:33.13,0:36:36.03,Default,Keempat,0,0,0,,Kita harus bergegas ke istana. Maaf.
Dialog: 0,0:36:36.53,0:36:38.90,Default,Keempat,0,0,0,,-Apakah Anda memiliki dokumennya?\N-Tentu saja.
Dialog: 0,0:36:39.73,0:36:40.84,Default,Keempat,0,0,0,,Di Sini.
Dialog: 0,0:37:17.01,0:37:18.81,Default,Keempat,0,0,0,,Waktunya berganti pakaian, Yang Mulia.
Dialog: 0,0:37:19.71,0:37:20.71,Default,Keempat,0,0,0,,Tunggu sebentar.
Dialog: 0,0:37:22.14,0:37:24.05,Default,Keempat,0,0,0,,Hari ini adalah hari yang sangat penting.
Dialog: 0,0:37:24.78,0:37:28.42,Default,Keempat,0,0,0,,Setidaknya kita harus mencoba memprediksi nasib orang-orang ini.
Dialog: 0,0:37:30.89,0:37:35.09,Default,Keempat,0,0,0,,Baiklah, mari kita lihat. Peta untuk klan Cho.
Dialog: 0,0:37:44.97,0:37:46.20,Default,Keempat,0,0,0,,Thojang adalah kartu terendah dalam permainan Thujong.
Dialog: 0,0:37:46.20,0:37:47.60,Default,Keempat,0,0,0,,Kartu kelinci.
Dialog: 0,0:37:53.34,0:37:57.01,Default,Keempat,0,0,0,,Yah, keberuntungan itu relatif.
Dialog: 0,0:37:58.31,0:38:02.58,Default,Keempat,0,0,0,,Ayo. Sebuah kartu untuk raja kita.
Dialog: 0,0:38:09.36,0:38:10.43,Default,Keempat,0,0,0,,Apa?
Dialog: 0,0:38:17.37,0:38:19.93,Default,Keempat,0,0,0,,"Injeong." Kartu kesembilan.
Dialogue: 0,0:38:20.44,0:38:21.74,Default,Keempat,0,0,0,,Apakah semuanya akan berbalik sebaliknya?
Dialog: 0,0:38:26.07,0:38:27.71,Default,Keempat,0,0,0,,Dan sekarang kartu untuk ratu.
Dialog: 0,0:38:36.58,0:38:37.75,Default,Keempat,0,0,0,,Naga?
Dialog: 0,0:38:39.49,0:38:41.49,Default,Keempat,0,0,0,,Ojan, kartu kedelapan.
Dialogue: 0,0:38:44.76,0:38:47.43,Default,Keempat,0,0,0,,Aku benci ramalanku hari ini.
Dialog: 0,0:38:54.20,0:38:55.94,Default,Keempat,0,0,0,,Ratu
Dialog: 0,0:38:56.87,0:39:01.14,Default,Keempat,0,0,0,,merencanakan sesuatu lagi?
Dialog: 0,0:39:02.98,0:39:04.65,Default,Keempat,0,0,0,,Ibu Suri telah tiba.
Dialog: 0,0:39:05.15,0:39:08.32,Default,Keempat,0,0,0,,Anda dapat memberi tahu kami terlebih dahulu bahwa Anda akan berkunjung.
Dialog: 0,0:39:08.32,0:39:11.05,Default,Keempat,0,0,0,,Kamu bahkan tidak menyembunyikan ketidaksukaanmu padaku.
Dialog: 0,0:39:11.52,0:39:14.09,Default,Keempat,0,0,0,,Saat aku menjadi ratu,\Nperilaku seperti itu tidak pernah terdengar.
Dialog: 0,0:39:14.52,0:39:15.66,Default,Keempat,0,0,0,,Apapun eranya
Dialog: 0,0:39:15.66,0:39:18.63,Default,Keempat,0,0,0,,tidak ada menantu perempuan yang ingin dikejutkan oleh ibu mertuanya.
Dialog: 0,0:39:18.63,0:39:20.93,Default,Keempat,0,0,0,,Nah, lihat dia, dia membentakku.
Dialog: 0,0:39:23.06,0:39:27.14,Default,Keempat,0,0,0,,Kudengar kamu memasak untuk Janda Ratu.
Dialog: 0,0:39:27.74,0:39:31.54,Default,Keempat,0,0,0,,Dan dia bahkan tidak pernah menawariku camilan.
Dialog: 0,0:39:32.24,0:39:33.51,Default,Keempat,0,0,0,,Kamu pasti takut
Dialog: 0,0:39:33.51,0:39:36.41,Default,Keempat,0,0,0,,nenek suamiku lebih besar dariku.
Dialog: 0,0:39:37.11,0:39:39.18,Default,Keempat,0,0,0,,Apa maksudmu, bukan begitu.
Dialog: 0,0:39:39.18,0:39:42.42,Default,Keempat,0,0,0,,Janda Ratu menjaga dirinya dengan sangat baik,
Dialog: 0,0:39:42.42,0:39:43.72,Default,Keempat,0,0,0,,jadi dia terlihat muda.
Dialog: 0,0:39:44.19,0:39:46.39,Default,Keempat,0,0,0,,Kamu tidak bisa menipu waktu.
Dialog: 0,0:39:47.79,0:39:49.46,Default,Keempat,0,0,0,,Anda perlu berpikir dengan hati-hati.
Dialog: 0,0:39:49.89,0:39:52.99,Default,Keempat,0,0,0,,Aku akan hidup lebih lama dari Janda Ratu.
Dialog: 0,0:39:56.66,0:39:58.47,Default,Keempat,0,0,0,,Aku akan menyajikan makananku padamu suatu hari nanti.
Dialog: 0,0:39:58.47,0:40:00.07,Default,Keempat,0,0,0,,Saya harus mencobanya sekarang.
Dialog: 0,0:40:00.90,0:40:04.87,Default,Keempat,0,0,0,,Saya sangat penasaran dengan masakan Anda,\N yang hanya pernah saya dengar.
Dialog: 0,0:40:04.87,0:40:07.04,Default,Keempat,0,0,0,,Tidak ada kekuatan untuk menunggu.
Dialog: 0,0:40:08.24,0:40:10.81,Default,Keempat,0,0,0,,Sekarang?
Dialog: 0,0:40:11.71,0:40:14.65,Default,Keempat,0,0,0,,Jadi penganiayaanku oleh ibu mertuaku dimulai?
Dialog: 0,0:40:29.50,0:40:31.37,Default,Keempat,0,0,0,,Sial, ini menyebalkan.
Dialog: 0,0:40:35.87,0:40:39.41,Default,Keempat,0,0,0,,Di mana dia bersembunyi?
Dialog: 0,0:40:42.51,0:40:44.11,Default,Keempat,0,0,0,,Royal Chef. Saya butuh sirup jagung.
Dialog: 0,0:40:44.11,0:40:47.28,Default,Keempat,0,0,0,,Dan apa yang harus kulakukan jika jamuan makan tanpa makanan segar?
Dialog: 0,0:40:47.68,0:40:50.62,Default,Keempat,0,0,0,,Semua penjaga di dekat kereta mati.
Dialogue: 0,0:40:50.62,0:40:51.75,Default,Keempat,0,0,0,,Apa yang bisa kulakukan?
Dialog: 0,0:40:51.75,0:40:54.19,Default,Keempat,0,0,0,,Ya Tuhan. Ayo.
Dialog: 0,0:40:55.62,0:40:57.83,Default,Keempat,0,0,0,,-Ikan kering.\N-Apa?
Dialog: 0,0:40:58.23,0:41:01.16,Default,Keempat,0,0,0,,Ikan kering. Ikan kering!
Dialog: 0,0:41:03.80,0:41:06.07,Default,Keempat,0,0,0,,Koki kerajaan terlalu sibuk.
Dialog: 0,0:41:06.47,0:41:08.10,Default,Keempat,0,0,0,,Saya tidak bisa memerintahkannya.
Dialog: 0,0:41:10.54,0:41:12.57,Default,Keempat,0,0,0,,Di mana sirup gandumnya?
Dialog: 0,0:41:29.79,0:41:32.23,Default,Keempat,0,0,0,,Pada malam tanpa tidur aku berjalan.
Dialog: 0,0:41:32.83,0:41:34.50,Default,Keempat,0,0,0,,"Pada malam tanpa tidur aku berjalan"
Dialog: 0,0:41:34.90,0:41:37.53,Default,Keempat,0,0,0,,Koki Kerajaan! Koki Kerajaan!
Dialog: 0,0:41:37.53,0:41:39.80,Default,Keempat,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialogue: 0,0:41:39.80,0:41:41.00,Default,Keempat,0,0,0,,Apa yang terjadi?
Dialog: 0,0:41:42.94,0:41:44.01,Default,Keempat,0,0,0,,Yang Mulia.
Dialog: 0,0:41:57.52,0:42:02.42,Default,Keempat,0,0,0,,Ini adalah produk berharga. Semua orang busuk!
Dialog: 0,0:42:02.66,0:42:04.63,Default,Keempat,0,0,0,,Mereka mungkin disimpan dengan tidak benar.
Dialog: 0,0:42:05.03,0:42:08.30,Default,Keempat,0,0,0,,Saya pantas mati, Yang Mulia.
Dialog: 0,0:42:09.20,0:42:10.50,Default,Keempat,0,0,0,,Ini tidak mungkin.
Dialog: 0,0:42:11.23,0:42:14.64,Default,Keempat,0,0,0,,Tak seorang pun akan menghancurkannya,\N jika keamanannya terjamin.
Dialog: 0,0:42:17.51,0:42:18.54,Default,Keempat,0,0,0,,Koki Kerajaan!
Dialog: 0,0:42:19.51,0:42:20.51,Default,Keempat,0,0,0,,Yang Mulia.
Dialog: 0,0:42:21.14,0:42:22.18,Default,Keempat,0,0,0,,Kami mempunyai masalah.
Dialog: 0,0:42:22.18,0:42:24.28,Default,Keempat,0,0,0,,Seseorang menambahkan batu ke dalam nasi.
Dialog: 0,0:42:24.51,0:42:27.32,Default,Keempat,0,0,0,,-Apa?\N-Kami tidak dapat mengirimkan apa pun.
Dialog: 0,0:42:29.38,0:42:32.09,Default,Keempat,0,0,0,,Jangan khawatir. Lakukan semua yang Anda bisa pada bagian Anda.
Dialog: 0,0:42:32.85,0:42:36.52,Default,Keempat,0,0,0,,Saya akan melakukan yang terbaik untuk mendapatkan produk tersebut.
Dialog: 0,0:42:38.99,0:42:40.03,Default,Keempat,0,0,0,,Ya.
Dialog: 0,0:42:49.24,0:42:51.47,Default,Keempat,0,0,0,,Ya Tuhan, apa yang kamu lakukan?
Dialog: 0,0:42:52.51,0:42:55.21,Default,Keempat,0,0,0,,Koki Kerajaan! Hai!
Dialog: 0,0:42:55.48,0:42:58.98,Default,Keempat,0,0,0,,Aku harus menunjukkan padanya cara membawa makanan sendiri.
Dialogue: 0,0:42:59.41,0:43:01.55,Default,Fourth,0,0,0,,Ini akan membuatnya merasa lebih baik, bukan?
Dialog: 0,0:43:10.22,0:43:12.46,Default,Keempat,0,0,0,,Kombinasi sirup manis dan garam menjadikannya
Dialog: 0,0:43:12.46,0:43:13.83,Default,Keempat,0,0,0,,hidangan manis dan asin yang ideal.
Dialog: 0,0:43:24.64,0:43:32.51,Default,Keempat,0,0,0,,Di sana aku melihat gunung yang indah...
Dialog: 0,0:43:44.53,0:43:45.73,Default,Keempat,0,0,0,,Direktur Han?
Dialogue: 0,0:43:47.50,0:43:48.50,Default,Keempat,0,0,0,,Dasar bajingan!
Dialog: 0,0:43:49.50,0:43:50.50,Default,Keempat,0,0,0,,Bagaimana bisa?
Dialogue: 0,0:44:06.38,0:44:09.88,Default,Keempat,0,0,0,,Pocornku!
Dialog: 0,0:44:13.05,0:44:14.12,Default,Keempat,0,0,0,,Sial!
Dialogue: 0,0:44:17.49,0:44:19.13,Default,Keempat,0,0,0,,Dasar bajingan!
Dialog: 0,0:44:38.18,0:44:40.11,Default,Keempat,0,0,0,,Dimana suguhannya?
Dialog: 0,0:44:40.48,0:44:41.68,Default,Keempat,0,0,0,,Yah...
Dialog: 0,0:44:51.69,0:44:52.76,Default,Keempat,0,0,0,,Di Sini.
Dialog: 0,0:44:56.13,0:44:58.67,Default,Keempat,0,0,0,,Nantikan hidupmu di istana.
Dialog: 0,0:45:08.34,0:45:09.61,Default,Keempat,0,0,0,,Mengingat apa yang terjadi,
Dialog: 0,0:45:09.61,0:45:11.28,Default,Keempat,0,0,0,,kamu harus mendapatkan makanan,
Dialog: 0,0:45:11.28,0:45:13.41,Default,Keempat,0,0,0,,setelah kamu selesai dengan seni bela diri.
Dialog: 0,0:45:13.95,0:45:14.95,Default,Keempat,0,0,0,,Ya.
Dialog: 0,0:45:23.09,0:45:26.69,Default,Keempat,0,0,0,,Terima kasih telah mengundang kami ke jamuan makan.
Dialog: 0,0:45:27.90,0:45:29.90,Default,Keempat,0,0,0,,Anda berhak berada di sini.
Dialog: 0,0:45:30.97,0:45:32.83,Default,Keempat,0,0,0,,Para selir baik-baik saja.
Dialog: 0,0:45:33.50,0:45:35.20,Default,Keempat,0,0,0,,Saya harap semuanya baik-baik saja dengan Anda juga.
Dialog: 0,0:45:35.34,0:45:36.60,Default,Keempat,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:45:37.07,0:45:40.07,Default,Keempat,0,0,0,,Bagaimanapun, semoga harimu menyenangkan hari ini.
Dialog: 0,0:46:54.85,0:46:56.58,Default,Keempat,0,0,0,,Apakah Ibu Suri sudah tiba?
Dialog: 0,0:46:57.12,0:46:58.62,Default,Keempat,0,0,0,,Saya akan mencari tahu.
Dialogue: 0,0:47:09.33,0:47:11.90,Default,Keempat,0,0,0,,Kukira kau kabur.
Dialog: 0,0:47:12.00,0:47:13.20,Default,Keempat,0,0,0,,Tentu saja tidak.
Dialog: 0,0:47:13.70,0:47:17.41,Default,Keempat,0,0,0,,Jika seseorang melakukan kejahatan,\Ndia harus dihukum setimpal.
Dialog: 0,0:47:17.57,0:47:19.74,Default,Keempat,0,0,0,,Senang Anda menyadarinya.
Dialog: 0,0:47:21.18,0:47:23.71,Default,Keempat,0,0,0,,Ratu mengirimiku camilan pagi ini,
Dialog: 0,0:47:23.71,0:47:26.58,Default,Keempat,0,0,0,,dan saya mulai bersiap-siap terlambat karena saya mencobanya.
Dialog: 0,0:47:27.72,0:47:28.98,Default,Keempat,0,0,0,,Ratu?
Dialog: 0,0:47:36.92,0:47:39.03,Default,Keempat,0,0,0,,Rasanya aku akan mati, terjebak di antara dua api.
Dialog: 0,0:47:44.33,0:47:46.60,Default,Keempat,0,0,0,,Ada kesalahpahaman lagi?
Dialog: 0,0:47:49.97,0:47:51.81,Default,Keempat,0,0,0,,Ayo.
Dialog: 0,0:48:26.17,0:48:29.91,Default,Keempat,0,0,0,,Para pengawal kerajaan telah menyiapkan\N pertunjukan seni bela diri.
Dialog: 0,0:48:48.23,0:48:49.60,Default,Keempat,0,0,0,,Perhatian!
Dialog: 0,0:48:50.46,0:48:51.70,Default,Keempat,0,0,0,,Putaran pertama.
Dialog: 0,0:48:55.84,0:48:59.87,Default,Keempat,0,0,0,,Beraninya dia mencoba \Nmenyakiti ratu dengan pedang itu?
Dialog: 0,0:49:04.95,0:49:06.08,Default,Keempat,0,0,0,,Pertempuran.
Dialog: 0,0:50:34.44,0:50:38.17,Default,Keempat,0,0,0,,Wow. Raja sudah sangat siap.
Dialog: 0,0:50:54.05,0:50:58.23,Default,Keempat,0,0,0,,Janda Ratu. Saatnya berburu.
Dialog: 0,0:51:00.49,0:51:03.30,Default,Keempat,0,0,0,,Yang Mulia. \NISaatnya berganti pakaian berburu.
Dialog: 0,0:51:08.57,0:51:10.77,Default,Keempat,0,0,0,,Aku akan kembali, Janda Ratu.
Dialogue: 0,0:51:12.77,0:51:14.88,Default,Keempat,0,0,0,,Aku akan kembali.
Dialog: 0,0:52:05.59,0:52:08.53,Default,Keempat,0,0,0,,Baris pertama, siap menembak.
Dialog: 0,0:52:11.93,0:52:13.10,Default,Keempat,0,0,0,,Api!
Dialog: 0,0:52:22.34,0:52:23.44,Default,Keempat,0,0,0,,Api!
Dialog: 0,0:52:28.38,0:52:29.48,Default,Keempat,0,0,0,,Api!
Dialog: 0,0:52:44.00,0:52:45.67,Default,Keempat,0,0,0,,Saya pikir itu hanya untuk pertunjukan.
Dialog: 0,0:53:09.82,0:53:12.06,Default,Keempat,0,0,0,,Hal-hal yang utama.
Dialog: 0,0:53:15.33,0:53:16.80,Default,Keempat,0,0,0,,Menurutku aku terlihat keren.
Dialog: 0,0:53:17.03,0:53:19.53,Default,Keempat,0,0,0,,Saya menyukainya. Saya terlihat keren.
Dialogue: 0,0:53:27.31,0:53:29.21,Default,Fifth,0,0,0,,Kenapa dia begitu agresif?
Dialogue: 0,0:53:29.44,0:53:32.15,Default,Fifth,0,0,0,,Selalu ada orang yang menganggap serius kompetisi.
Dialogue: 0,0:53:33.51,0:53:34.82,Default,Fifth,0,0,0,,Tampilan macam apa ini?
Dialogue: 0,0:53:36.42,0:53:39.49,Default,Fifth,0,0,0,,1 poin untuk burung, 2 poin untuk kelinci,
Dialog: 0,0:53:39.79,0:53:42.92,Default,Fifth,0,0,0,,untuk luak - 3 poin, untuk babi hutan - 4,
Dialog: 0,0:53:43.19,0:53:46.09,Default,Kelima,0,0,0,,rusa - 5 poin, serigala - 7,
Dialog: 0,0:53:46.16,0:53:50.20,Default,Fifth,0,0,0,,beruang - 9 dan harimau - 10 poin.
Dialog: 0,0:53:50.20,0:53:51.23,Default,Kelima,0,0,0,,Serigala, harimau, kelinci, rusa.
Dialogue: 0,0:53:51.23,0:53:52.97,Default,Fifth,0,0,0,,Masing-masing akan diberikan 10 anak panah.
Dialogue: 0,0:53:53.43,0:53:56.37,Default,Fifth,0,0,0,,Demi pertarungan yang adil, nyonya istana dan pelayanmu
Dialog: 0,0:53:56.37,0:53:57.67,Default,Fifth,0,0,0,,tidak akan berpartisipasi.
Dialog: 0,0:53:58.61,0:54:00.21,Default,Fifth,0,0,0,,Itu sulit.
Dialogue: 0,0:54:00.64,0:54:02.04,Default,Fifth,0,0,0,,Saat ini hal ini akan membuat orang
Dialog: 0,0:54:02.04,0:54:03.48,Default,Fifth,0,0,0,,tanda tangani petisi nasional.
Dialog: 0,0:54:03.91,0:54:06.65,Default,Fifth,0,0,0,,Maka saatnya memulai.
Dialogue: 0,0:54:17.06,0:54:19.46,Default,Fifth,0,0,0,,Kamu sudah bisa keluar.
Dialog: 0,0:54:26.17,0:54:28.90,Default,Fifth,0,0,0,,Kita hanya perlu menghabiskan waktu di sini dan kembali.
Dialog: 0,0:54:46.09,0:54:49.29,Default,Fifth,0,0,0,,Pertandingan tembak-menembak hari ini sangat mudah ditebak.
Dialogue: 0,0:54:50.26,0:54:52.59,Default,Fifth,0,0,0,,Ini pertarungan demi kehormatan keluarga,
Dialog: 0,0:54:53.06,0:54:55.80,Default,Fifth,0,0,0,,tapi ratu sepertinya tidak tertarik.
Dialog: 0,0:54:56.03,0:54:59.63,Default,Fifth,0,0,0,,Saya tidak tahu Anda punya waktu untuk khawatir tentang pertengkaran lelucon.
Dialog: 0,0:55:00.07,0:55:03.14,Default,Fifth,0,0,0,,Kamu mungkin akan bertemu putramu hari ini.
Dialogue: 0,0:55:08.58,0:55:10.94,Default,Fifth,0,0,0,,Waktunya telah tiba untuk mempersembahkan hadiahku.
Dialogue: 0,0:55:12.35,0:55:14.58,Default,Fifth,0,0,0,,Malam itu ketika ratu jatuh ke kondisi vegetatif,
Dialogue: 0,0:55:14.58,0:55:17.55,Default,Fifth,0,0,0,,selir kerajaan dan raja hendak berbagi tempat tidur.
Dialogue: 0,0:55:17.95,0:55:19.95,Default,Fifth,0,0,0,,Sang Ratu sudah bangun
Dialog: 0,0:55:19.95,0:55:22.66,Default,Fifth,0,0,0,,hanya sehari setelah itu.
Dialog: 0,0:55:25.29,0:55:26.66,Default,Fifth,0,0,0,,Maksudmu dia berpura-pura,
Dialog: 0,0:55:26.66,0:55:29.66,Default,Fifth,0,0,0,,untuk menghentikan mereka?
Dialog: 0,0:55:31.23,0:55:33.97,Default,Fifth,0,0,0,,Sang Ratu mempertaruhkan semuanya,
Dialog: 0,0:55:33.97,0:55:35.67,Default,Fifth,0,0,0,,untuk memenangkan hati raja.
Dialogue: 0,0:55:36.24,0:55:37.87,Default,Fifth,0,0,0,,Melemparkan dirinya ke dalam danau,
Dialogue: 0,0:55:37.87,0:55:40.24,Default,Fifth,0,0,0,,melindungi selir kerajaan dari pedang.
Dialogue: 0,0:55:40.97,0:55:43.81,Default,Fifth,0,0,0,,Mengorbankan benda terakhir yang tersisa.
Dialogue: 0,0:55:47.05,0:55:49.88,Default,Fifth,0,0,0,,Sang ratu menolak keluarganya.
Dialogue: 0,0:55:59.16,0:56:02.63,Default,Fifth,0,0,0,,Aku bosan, dan kamu menghiburku.
Dialogue: 0,0:56:03.43,0:56:07.43,Default,Fifth,0,0,0,,Raja mengadakan pesta tanpa alasan.
Dialogue: 0,0:56:07.87,0:56:10.04,Default,Fifth,0,0,0,,Dan ratu bergegas mengambil selir-selir itu
Dialog: 0,0:56:10.04,0:56:12.54,Default,Fifth,0,0,0,,dari keluarga paling berpengaruh.
Dialog: 0,0:56:12.71,0:56:15.84,Default,Fifth,0,0,0,,Saya memilih mereka yang dapat mendukung raja.
Dialogue: 0,0:56:16.64,0:56:19.78,Default,Fifth,0,0,0,,Hari ini raja akan menampakkan wajah aslinya,
Dialog: 0,0:56:19.78,0:56:22.28,Default,Fifth,0,0,0,,yang masih disembunyikan dari pejabat.
Dialogue: 0,0:56:22.62,0:56:25.09,Default,Fifth,0,0,0,,Wajah penguasa yang kuat.
Dialogue: 0,0:56:28.56,0:56:30.49,Default,Fifth,0,0,0,,Apakah kamu mengerti sekarang?
Dialogue: 0,0:56:31.16,0:56:33.86,Default,Fifth,0,0,0,,Ratu menyatu dengan raja.
Dialogue: 0,0:56:33.86,0:56:37.50,Default,Fifth,0,0,0,,Apakah kamu tidak takut dengan hidupmu, mengatakan ini?
Dialogue: 0,0:56:37.86,0:56:41.03,Default,Fifth,0,0,0,,Dan kamu mungkin percaya bahwa ratu tidak akan pernah mengkhianatimu.
Dialog: 0,0:56:42.30,0:56:44.50,Default,Fifth,0,0,0,,Saya sangat kecewa.
Dialogue: 0,0:56:44.91,0:56:47.21,Default,Fifth,0,0,0,,Tertarik pada trik murahannya
Dialog: 0,0:56:47.21,0:56:48.84,Default,Fifth,0,0,0,,dan biarkan diri mereka tertipu.
Dialogue: 0,0:56:49.48,0:56:52.21,Default,Fifth,0,0,0,,Rupanya, mereka sudah cukup tua.
Dialogue: 0,0:56:53.98,0:56:56.38,Default,Fifth,0,0,0,,Aku akan merobek bibir keji ini.
Dialogue: 0,0:56:56.38,0:56:59.65,Default,Fifth,0,0,0,,Ratu pura-pura pingsan, tak ada dosa bagiku.
Dialogue: 0,0:56:59.65,0:57:03.46,Default,Fifth,0,0,0,,Dan aku tidak perlu takut lagi!
Dialog: 0,0:57:08.46,0:57:10.46,Default,Fifth,0,0,0,,Mengapa kamu berhenti bermain?
Dialogue: 0,0:57:10.76,0:57:13.83,Default,Fifth,0,0,0,,Kau mengecewakan ratu janda.
Dialogue: 0,0:57:27.75,0:57:29.15,Default,Fifth,0,0,0,,Dan sekarang
Dialogue: 0,0:57:29.15,0:57:33.45,Default,Fifth,0,0,0,,raja akan memberimu penggemar.
Dialogue: 0,0:57:55.38,0:57:58.61,Default,Fifth,0,0,0,,Kamu melakukan pekerjaan dengan baik. Saya menantikan pesta itu.
Dialog: 0,0:57:59.68,0:58:02.35,Default,Fifth,0,0,0,,Kamu juga melakukan pekerjaan dengan baik.
Dialogue: 0,0:58:08.62,0:58:11.26,Default,Fifth,0,0,0,,Janda Ratu telah tiba.
Dialogue: 0,0:58:16.10,0:58:17.20,Default,Fifth,0,0,0,,Anda di sini.
Dialogue: 0,0:58:21.20,0:58:23.47,Default,Fifth,0,0,0,,Membosankan sekali disana.
Dialogue: 0,0:58:23.47,0:58:24.87,Default,Fifth,0,0,0,,Aku tidak tahan.
Dialog: 0,0:58:26.87,0:58:29.51,Default,Fifth,0,0,0,,Saya ingin tahu apakah akan lebih baik di sini.
Dialog: 0,0:58:30.21,0:58:32.51,Default,Fifth,0,0,0,,Maaf saya tidak bisa menyenangkan Anda.
Dialog: 0,0:58:34.55,0:58:37.25,Default,Fifth,0,0,0,,Saya ingin melihat seni bela diri, tapi saya terlambat.
Dialog: 0,0:58:39.75,0:58:43.59,Default,Fifth,0,0,0,,Meskipun menonton pertunjukan juga membosankan.
Dialog: 0,0:58:45.93,0:58:49.10,Default,Fifth,0,0,0,,Saya lebih suka pertarungan sesungguhnya.
Dialogue: 0,0:58:50.53,0:58:52.63,Default,Fifth,0,0,0,,Saya akan memerintahkan pengawal kerajaan untuk saling berkompetisi.
Dialogue: 0,0:58:53.53,0:58:55.24,Default,Fifth,0,0,0,,Bagaimana kalau berbicara sendiri?
Dialogue: 0,0:58:59.44,0:59:01.58,Default,Fifth,0,0,0,,Kudengar kamu memotong kayu di Ganghwado
Dialog: 0,0:59:01.58,0:59:04.31,Default,Fifth,0,0,0,,dan dia membawa airnya sendiri.
Dialogue: 0,0:59:05.18,0:59:08.05,Default,Fifth,0,0,0,,Dengan pembangkit tenaga listrik ini dan itu tidak akan sulit.
Dialog: 0,0:59:11.12,0:59:13.79,Default,Fifth,0,0,0,,Pekerjaan manual dan seni bela diri sangat berbeda.
Dialog: 0,0:59:14.39,0:59:17.49,Default,Fifth,0,0,0,,Dan dalam beberapa tahun terakhir saya semakin sering duduk di singgasana.
Dialogue: 0,0:59:17.49,0:59:18.89,Default,Fifth,0,0,0,,Bodinya sudah seluruhnya terbuat dari kayu.
Dialog: 0,0:59:18.89,0:59:21.26,Default,Fifth,0,0,0,,Nah, gunakan kipas angin sebagai pengganti senjata.
Dialog: 0,0:59:24.80,0:59:27.70,Default,Fifth,0,0,0,,Bagaimana kalau kompetisi dengan kepala Departemen Detektif?
Dialogue: 0,0:59:27.70,0:59:29.20,Default,Fifth,0,0,0,,Umurmu hampir sama.
Dialog: 0,0:59:32.41,0:59:33.64,Default,Kelima,0,0,0,,Kepala Departemen Detektif -
Dialog: 0,0:59:33.64,0:59:35.91,Default,Fifth,0,0,0,,seorang pejuang profesional yang telah berlatih selama bertahun-tahun.
Dialogue: 0,0:59:36.88,0:59:38.95,Default,Fifth,0,0,0,,Aku takut raja terluka.
Dialog: 0,0:59:38.95,0:59:40.35,Default,Fifth,0,0,0,,Jika kamu ingin melihat pertarungannya, aku akan mengundang...
Dialog: 0,0:59:40.35,0:59:43.22,Default,Fifth,0,0,0,,Saya ingin melihat raja bertarung.
Dialogue: 0,0:59:48.92,0:59:50.26,Default,Fifth,0,0,0,,Bagaimana menurutmu?
Dialogue: 0,0:59:53.39,0:59:55.40,Default,Fifth,0,0,0,,Ayah salah.
Dialog: 0,0:59:57.03,1:00:00.93,Default,Fifth,0,0,0,,Silakan lihat wajah aslinya di Cart Day.
Dialog: 0,1:00:11.81,1:00:13.21,Default,Kelima,0,0,0,,Rusa.
Dialogue: 0,1:00:21.42,1:00:22.46,Default,Fifth,0,0,0,,Bagaimana bisa?
Dialog: 0,1:00:23.62,1:00:24.66,Default,Kelima,0,0,0,,Beruang.
Dialog: 0,1:00:54.02,1:00:55.16,Default,Fifth,0,0,0,,Go.
Dialog: 0,1:00:55.16,1:00:57.32,Default,Fifth,0,0,0,,Kamu bukan mangsa yang aku cari.
Dialog: 0,1:01:10.97,1:01:12.11,Default,Fifth,0,0,0,,Pergi ke tempat yang salah?
Dialog: 0,1:01:16.08,1:01:17.64,Default,Fifth,0,0,0,,Sepertinya saya sudah melihat pohon ini.
Dialogue: 0,1:01:19.75,1:01:21.68,Default,Fifth,0,0,0,,Dan kemana aku harus pergi?
Dialog: 0,1:01:25.82,1:01:27.52,Default,Fifth,0,0,0,,Kami akan memiliki penggemar di tangan kami.
Dialog: 0,1:01:27.89,1:01:30.72,Default,Kelima,0,0,0,,Orang yang mengambil kipas dari lawan akan menang.
Dialog: 0,1:01:34.19,1:01:35.53,Default,Kelima,0,0,0,,Mudah.
Dialogue: 0,1:02:04.19,1:02:06.36,Default,Fifth,0,0,0,,Apa yang terjadi?
Dialog: 0,1:02:08.19,1:02:10.06,Default,Fifth,0,0,0,,saya bilang santai saja.
Dialog: 0,1:02:11.16,1:02:13.73,Default,Fifth,0,0,0,,Bagaimana responsmu jika melukai raja?
Dialogue: 0,1:02:15.70,1:02:18.31,Default,Fifth,0,0,0,,Ini adalah perintah dari Janda Ratu.
Dialogue: 0,1:02:18.31,1:02:20.07,Default,Fifth,0,0,0,,Tak ada lagi yang bisa dilakukan selain menyelesaikannya.
Dialog: 0,1:02:25.11,1:02:28.11,Default,Fifth,0,0,0,,Jadi ratu janda ada di belakangmu.
Dialogue: 0,1:02:32.69,1:02:35.22,Default,Fifth,0,0,0,,Jadi aku harus memberimu pelajaran.
Dialogue: 0,1:02:35.22,1:02:37.32,Default,Fifth,0,0,0,,Akan kutunjukkan siapa bos di istana.
Dialog: 0,1:03:00.78,1:03:02.42,Default,Fifth,0,0,0,,Kamu bilang dia berbeda dari mendiang raja.
Dialogue: 0,1:03:02.98,1:03:04.58,Default,Fifth,0,0,0,,Dan kenyataannya berbeda.
Dialogue: 0,1:03:08.79,1:03:10.42,Default,Fifth,0,0,0,,Baiklah.
Dialogue: 0,1:03:10.42,1:03:13.13,Default,Fifth,0,0,0,,Saya perlu tidur siang. Mereka akan menemukanku ketika semuanya sudah berakhir.
Dialogue: 0,1:03:16.26,1:03:17.36,Default,Fifth,0,0,0,,Sial, aku membuatmu takut!
Dialogue: 0,1:03:19.07,1:03:20.23,Default,Fifth,0,0,0,,Apa yang kamu lakukan disini?
Dialogue: 0,1:03:22.04,1:03:25.14,Default,Fifth,0,0,0,,Bagaimana menurut anda? Aku bersembunyi untuk bertahan hidup.
Dialog: 0,1:03:25.71,1:03:28.17,Default,Fifth,0,0,0,,Yah, kamu benar-benar tidak akan mati. Mengapa kamu begitu takut?
Dialog: 0,1:03:28.41,1:03:32.31,Default,Fifth,0,0,0,,Saya tahu, tapi panahnya masih sakit.
Dialog: 0,1:03:32.91,1:03:34.95,Default,Fifth,0,0,0,,Saya masih mengalami memar dari tahun lalu.
Dialogue: 0,1:03:34.95,1:03:36.12,Default,Fifth,0,0,0,,Sungguh merengek.
Dialog: 0,1:03:37.78,1:03:39.85,Default,Fifth,0,0,0,,Jangan takut, berburu tidak menggodaku.
Dialog: 0,1:03:40.45,1:03:43.86,Default,Fifth,0,0,0,,Yah, yang lain akan memukulku.
Dialog: 0,1:03:55.50,1:03:56.87,Default,Kelima,0,0,0,,Di Sini.
Dialogue: 0,1:03:57.20,1:03:59.31,Default,Fifth,0,0,0,,Bagaimana kamu bisa kembali seperti itu?
Dialog: 0,1:04:00.44,1:04:01.47,Default,Kelima,0,0,0,,Harimau.
Dialogue: 0,1:04:06.88,1:04:07.95,Default,Fifth,0,0,0,,Jadi?
Dialog: 0,1:04:08.88,1:04:11.62,Default,Kelima,0,0,0,,Terima kasih, Yang Mulia.
Dialogue: 0,1:04:11.62,1:04:12.89,Default,Fifth,0,0,0,,Simpan souvenirnya.
Dialog: 0,1:04:14.12,1:04:15.22,Default,Fifth,0,0,0,,Go.
Dialogue: 0,1:04:17.19,1:04:18.96,Default,Fifth,0,0,0,,Sudah?
Dialog: 0,1:04:20.83,1:04:22.60,Default,Fifth,0,0,0,,Aku tidak tahu ratu begitu pandai menembak,
Dialog: 0,1:04:22.60,1:04:25.30,Default,Fifth,0,0,0,,untuk memukul harimau begitu cepat.
Dialogue: 0,1:04:25.30,1:04:27.57,Default,Fifth,0,0,0,,Ya, dia terlahir sebagai pemanah.
Dialog: 0,1:04:27.57,1:04:30.87,Default,Fifth,0,0,0,,Aku bahkan tidak melihatnya, hanya angin yang bersiul di telingaku.
Dialogue: 0,1:04:30.87,1:04:33.47,Default,Fifth,0,0,0,,Jadi mereka menembakku.
Dialogue: 0,1:04:33.47,1:04:34.57,Default,Fifth,0,0,0,,Benarkah?
Dialogue: 0,1:06:13.11,1:06:14.21,Default,Fifth,0,0,0,,Jadi itu kamu.
Dialogue: 0,1:06:14.97,1:06:16.91,Default,Fifth,0,0,0,,Kamu adalah orang itu.
Dialogue: 0,1:06:20.21,1:06:22.05,Default,Fifth,0,0,0,,Aku tidak akan memaafkanmu.
Dialogue: 0,1:06:42.00,1:06:44.97,Default,Fifth,0,0,0,,Aku akan membunuhmu.
Dialogue: 0,1:07:05.53,1:07:10.00,Default,Fifth,0,0,0,,Bagaimana aku menjadi seorang ratu
Dialog: 0,1:07:25.41,1:07:27.68,Default,Fifth,0,0,0,,Saya punya berita sedih.
Dialogue: 0,1:07:27.68,1:07:29.05,Default,Fifth,0,0,0,,Tanganku gemetar
Dialog: 0,1:07:29.05,1:07:30.98,Default,Fifth,0,0,0,,dan saya berperan sebagai ratu.
Dialog: 0,1:07:30.98,1:07:33.25,Default,Fifth,0,0,0,,Pesta akan segera dimulai, tapi bahan-bahannya belum tiba.
Dialogue: 0,1:07:33.25,1:07:34.32,Default,Fifth,0,0,0,,Apakah itu saja?
Dialogue: 0,1:07:34.32,1:07:35.89,Default,Fifth,0,0,0,,Apakah kamu menambahkan racunnya?
Dialog: 0,1:07:36.06,1:07:37.56,Default,Kelima,0,0,0,,Nama - Lee Senman.
Dialog: 0,1:07:37.89,1:07:39.76,Default,Fifth,0,0,0,,Saya akan membuat menu baru dari bahan-bahan yang tersedia.
Dialogue: 0,1:07:39.76,1:07:41.93,Default,Fifth,0,0,0,,Beraninya kau menggoreng jarum berhargaku.
Dialog: 0,1:07:41.93,1:07:44.40,Default,Fifth,0,0,0,,Apa yang akan kita masak hari ini bukanlah makanan sederhana.
Dialog: 0,1:07:44.40,1:07:45.67,Default,Fifth,0,0,0,,Dia layak menjadi presiden.
Dialog: 0,1:07:45.93,1:07:47.97,Default,Fifth,0,0,0,,Beraninya kamu tidak menaati perintah tuanmu?
Dialogue: 0,1:07:47.97,1:07:50.40,Default,Fifth,0,0,0,,{\i1}-Tangkap mereka!\N-Ini bukan pengkhianatan, tapi pemberontakan!{\i}
Dialog: 0,1:07:50.40,1:07:53.67,Default,Fifth,0,0,0,,Anda harus membayar untuk kemampuan mengendalikan karakter Anda.
Dialog: 0,0:13:59.93,0:14:01.93,Default,,0,0,0,,


