Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:04.02,bekerja,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Penyanyi, Hein, Pembawa Acara
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:17.36,0:01:20.36,Default,LILY,0,0,0,,Malam itu seluruh ruangan berbau melati.
Dialogue: 0,0:01:25.57,0:01:29.04,Default,LILY,0,0,0,,Baunya bahkan meresap ke dalam lengan bajunya.
Dialog: 0,0:01:56.16,0:01:57.26,Default,LILY,0,0,0,,Itu kamu.
Dialog: 0,0:02:00.67,0:02:01.84,Default,LILY,0,0,0,,Itu kamu...
Dialog: 0,0:02:02.17,0:02:04.67,Default,LILY,0,0,0,,Sebagai upaya terakhir, ada selongsong kiri.
Dialogue: 0,0:02:13.38,0:02:16.88,Default,LILY,0,0,0,,Kaulah yang kubutuhkan.
Dialog: 0,0:02:16.98,0:02:18.02,Default,LILY,0,0,0,,4 episode
Dialogue: 0,0:02:18.38,0:02:19.59,Default,LILY,0,0,0,,Teh ini.
Dialogue: 0,0:02:23.99,0:02:25.73,Default,LILY,0,0,0,,Senang kamu menyukainya.
Dialog: 0,0:02:29.20,0:02:31.43,Default,LILY,0,0,0,,Dia tidak membiarkanku mencari tahu
Dialog: 0,0:02:31.43,0:02:32.77,Default,LILY,0,0,0,,apakah saya ingat.
Dialog: 0,0:02:32.77,0:02:36.07,Default,LILY,0,0,0,,Yang Mulia, mengapa wajah Anda menjadi pucat?
Dialog: 0,0:02:36.07,0:02:37.37,Default,LILY,0,0,0,,Dan berkeringat.
Dialog: 0,0:02:40.47,0:02:42.08,Default,LILY,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:02:42.61,0:02:44.48,Default,LILY,0,0,0,,Lelah karena tidak tidur semalaman.
Dialog: 0,0:02:45.38,0:02:48.58,Default,LILY,0,0,0,,Dalam hal ini, teh akan bermanfaat.
Dialogue: 0,0:02:49.15,0:02:51.62,Default,LILY,0,0,0,,Minum dan tidur.
Dialog: 0,0:02:53.32,0:02:54.35,Default,LILY,0,0,0,,Coba.
Dialog: 0,0:03:06.73,0:03:08.07,Default,LILY,0,0,0,,Kamu bisa minum.
Dialog: 0,0:03:09.67,0:03:11.80,Default,LILY,0,0,0,,Aku akan menuangkannya sendiri. Anda bisa bebas.
Dialog: 0,0:03:33.53,0:03:35.90,Default,LILY,0,0,0,,Minum. Baunya sangat enak.
Dialog: 0,0:03:49.24,0:03:51.84,Default,LILY,0,0,0,,Aku akan berpura-pura tidak tahu. Inilah satu-satunya cara agar saya bisa bertahan.
Dialogue: 0,0:03:57.52,0:03:59.35,Default,LILY,0,0,0,,Kenapa dia mencoba membujukmu untuk minum teh?
Dialog: 0,0:03:59.59,0:04:01.09,Default,LILY,0,0,0,,Benarkah keracunan?
Dialogue: 0,0:04:04.42,0:04:05.66,Default,LILY,0,0,0,,Apa yang terjadi?
Dialogue: 0,0:04:06.56,0:04:07.66,Default,LILY,0,0,0,,Rasa
Dialog: 0,0:04:10.70,0:04:11.83,Default,LILY,0,0,0,,sangat menyenangkan.
Dialog: 0,0:04:14.53,0:04:15.60,Default,LILY,0,0,0,,Saya sangat senang.
Dialogue: 0,0:04:16.30,0:04:18.74,Default,LILY,0,0,0,,Apakah kamu sudah makan malam akhir-akhir ini?
Dialog: 0,0:04:20.84,0:04:22.78,Default,LILY,0,0,0,,Racun akan bekerja lebih cepat saat perut kosong.
Dialog: 0,0:04:23.31,0:04:24.58,Default,LILY,0,0,0,,Jadi dia bertanya.
Dialogue: 0,0:04:25.38,0:04:27.65,Default,LILY,0,0,0,,Anda bertanya-tanya apa yang saya lakukan.
Dialog: 0,0:04:28.15,0:04:29.62,Default,LILY,0,0,0,,Saya sedang sibuk.
Dialogue: 0,0:04:29.95,0:04:31.99,Default,LILY,0,0,0,,Tapi aku selalu tertarik
Dialog: 0,0:04:31.99,0:04:34.15,Default,LILY,0,0,0,,kamu dan kerabatmu.
Dialog: 0,0:04:36.42,0:04:37.46,Default,LILY,0,0,0,,Lalu
Dialog: 0,0:04:42.00,0:04:43.16,Default,LILY,0,0,0,,minum juga.
Dialog: 0,0:04:45.20,0:04:46.57,Default,LILY,0,0,0,,Sebagai tanda simpati.
Dialog: 0,0:04:51.37,0:04:52.61,Default,LILY,0,0,0,,Jika Anda bersikeras.
Dialog: 0,0:05:00.98,0:05:02.05,Default,LILY,0,0,0,,Tidak diracuni.
Dialogue: 0,0:05:15.46,0:05:16.73,Default,LILY,0,0,0,,Kamu idiot.
Dialog: 0,0:05:17.26,0:05:18.73,Default,LILY,0,0,0,,Dia mengatakannya sendiri, sebagai tanda simpati.
Dialog: 0,0:05:20.77,0:05:21.90,Default,LILY,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:05:21.90,0:05:23.54,Default,LILY,0,0,0,,Biarkan aku pergi, aku perlu mengosongkan perutku.
Dialogue: 0,0:05:26.71,0:05:29.08,Default,LILY,0,0,0,,Apakah menurutmu aku meracunimu?
Dialog: 0,0:05:29.38,0:05:31.91,Default,LILY,0,0,0,,Mengapa? Apakah ada alasan untuk berpikir demikian?
Dialog: 0,0:05:34.08,0:05:35.25,Default,LILY,0,0,0,,Mari kita tunggu.
Dialog: 0,0:05:36.25,0:05:38.65,Default,LILY,0,0,0,,Jika tidak terjadi apa-apa padamu,
Dialog: 0,0:05:39.25,0:05:40.92,Default,LILY,0,0,0,,kepolosan saya akan terbukti.
Dialog: 0,0:05:41.72,0:05:42.82,Default,LILY,0,0,0,,Bagaimana jika saya tidak mau?
Dialog: 0,0:05:49.73,0:05:52.60,Default,LILY,0,0,0,,Jika kamu diracuni, lidahmu akan mati rasa dulu.
Dialog: 0,0:05:53.27,0:05:54.57,Default,LILY,0,0,0,,Kamu akan merasa mati rasa,
Dialog: 0,0:05:55.00,0:05:56.80,Default,LILY,0,0,0,,jangan ragu dan serang.
Dialog: 0,0:05:58.54,0:05:59.81,Default,LILY,0,0,0,,Menurutmu aku tidak bisa?
Dialog: 0,0:06:00.71,0:06:01.97,Default,LILY,0,0,0,,Saya yakin Anda bisa.
Dialogue: 0,0:06:02.71,0:06:04.38,Default,LILY,0,0,0,,Kamu bisa melakukannya.
Dialog: 0,0:06:06.28,0:06:07.45,Default,LILY,0,0,0,,Dipahami dengan benar.
Dialog: 0,0:06:08.61,0:06:11.25,Default,LILY,0,0,0,,Jika aku mati, setidaknya tidak sendirian.
Dialog: 0,0:06:18.50,0:06:21.90,Default,LILY,0,0,0,,4 episode: Pria yang Tahu Terlalu Banyak
Dialog: 0,0:06:29.54,0:06:31.70,Default,LILY,0,0,0,,-Yang Mulia.\N-Saya tidak bisa melakukannya lagi.
Dialog: 0,0:06:33.37,0:06:35.11,Default,LILY,0,0,0,,Bahkan jika hidupku bergantung padanya.
Dialog: 0,0:06:36.18,0:06:37.84,Default,LILY,0,0,0,,Aku juga akan segera mati.
Dialog: 0,0:06:43.98,0:06:45.25,Default,LILY,0,0,0,,Hati-hati.
Dialogue: 0,0:06:46.55,0:06:48.52,Default,LILY,0,0,0,,Maukah kamu menyakitiku dalam tidurku?
Dialog: 0,0:06:50.56,0:06:51.76,Default,LILY,0,0,0,,Ada yang salah dengan diriku.
Dialog: 0,0:06:52.46,0:06:54.29,Default,LILY,0,0,0,,Apa yang kamu berikan padaku?
Dialog: 0,0:06:54.96,0:06:56.16,Default,LILY,0,0,0,,Jawab pertanyaannya.
Dialog: 0,0:06:57.46,0:06:59.17,Default,LILY,0,0,0,,Kemana kamu pergi saat aku
Dialogue: 0,0:06:59.57,0:07:01.30,Default,LILY,0,0,0,,pergi ke istana musim panas?
Dialogue: 0,0:07:01.30,0:07:02.77,Default,LILY,0,0,0,,Aku ingin pergi.
Dialogue: 0,0:07:03.34,0:07:04.80,Default,LILY,0,0,0,,Kita harus keluar.
Dialog: 0,0:07:05.27,0:07:09.31,Default,LILY,0,0,0,,Aku tidak bisa mati ketika pintu keluar tepat di depanku.
Dialog: 0,0:07:17.72,0:07:20.69,Default,LILY,0,0,0,,Apa yang terjadi padamu malam itu?
Dialog: 0,0:07:21.59,0:07:24.52,Default,LILY,0,0,0,,Ini berbahaya. Anda harus diam.
Dialog: 0,0:07:24.52,0:07:25.89,Default,LILY,0,0,0,,I...
Dialog: 0,0:07:27.13,0:07:28.36,Default,LILY,0,0,0,,Apa katamu?
Dialog: 0,0:07:28.43,0:07:29.73,Default,LILY,0,0,0,,Malam itu
Dialog: 0,0:07:30.80,0:07:32.00,Default,LILY,0,0,0,,Anda mencoba
Dialog: 0,0:07:35.43,0:07:36.84,Default,LILY,0,0,0,,bunuh aku.
Dialogue: 0,0:07:37.74,0:07:38.87,Default,LILY,0,0,0,,Dia tahu.
Dialog: 0,0:07:39.94,0:07:41.67,Default,LILY,0,0,0,,Jika Anda tahu,
Dialog: 0,0:07:42.31,0:07:44.68,Default,LILY,0,0,0,,kenapa kamu tidak mengatakan apa-apa?
Dialog: 0,0:07:45.01,0:07:46.98,Default,LILY,0,0,0,,Apa yang sedang kamu lakukan?
Dialog: 0,0:07:48.05,0:07:49.48,Default,LILY,0,0,0,,Aku bahkan tidak tahu.
Dialog: 0,0:07:49.85,0:07:52.75,Default,LILY,0,0,0,,Baru tahu, terima kasih untuk tehmu.
Dialogue: 0,0:07:55.35,0:07:56.69,Default,LILY,0,0,0,,Sayang sekali.
Dialog: 0,0:07:56.76,0:07:59.63,Default,LILY,0,0,0,,Jika aku tahu lebih awal, aku pasti akan membunuhmu.
Dialogue: 0,0:08:01.43,0:08:03.06,Default,LILY,0,0,0,,Spawn of evil.
Dialog: 0,0:08:03.36,0:08:05.93,Default,LILY,0,0,0,,Bahkan jika kamu tergila-gila pada orang lain,
Dialogue: 0,0:08:05.93,0:08:07.27,Default,LILY,0,0,0,,mengapa membunuh istrimu?
Dialogue: 0,0:08:07.53,0:08:09.20,Default,LILY,0,0,0,,Apakah kamu menyebut dirimu manusia?
Dialog: 0,0:08:09.54,0:08:11.87,Default,LILY,0,0,0,,Cho Hwajin adalah selirmu.
Dialogue: 0,0:08:12.37,0:08:14.44,Default,LILY,0,0,0,,Kamu tidak bisa melakukan perzinahan begitu saja?
Dialogue: 0,0:08:14.77,0:08:17.34,Default,LILY,0,0,0,,Apakah kamu akan membunuh istrimu dengan tanganmu sendiri?
Dialog: 0,0:08:17.78,0:08:19.31,Default,LILY,0,0,0,,Dia tidak tahu alasannya.
Dialogue: 0,0:08:23.85,0:08:24.98,Default,LILY,0,0,0,,Ratuku.
Dialogue: 0,0:08:25.62,0:08:28.62,Default,LILY,0,0,0,,Malam itu kamu mendengar sesuatu yang seharusnya tidak kamu dengar.
Dialog: 0,0:08:29.12,0:08:30.82,Default,LILY,0,0,0,,Apa yang kamu dengar?
Dialog: 0,0:08:31.92,0:08:34.46,Default,LILY,0,0,0,,Jawab! Apa yang kamu dengar?
Dialog: 0,0:08:37.90,0:08:39.90,Default,LILY,0,0,0,,Jadi bukan itu alasannya?
Dialog: 0,0:08:41.33,0:08:43.74,Default,LILY,0,0,0,,Anda punya alasan bagus,
Dialog: 0,0:08:44.07,0:08:47.11,Default,LILY,0,0,0,,untuk membunuh wanita ini?
Dialog: 0,0:08:47.87,0:08:49.21,Default,LILY,0,0,0,,Apakah saya memahaminya dengan benar?
Dialog: 0,0:08:50.68,0:08:52.38,Default,LILY,0,0,0,,Jangan tertipu.
Dialog: 0,0:08:52.71,0:08:54.31,Default,LILY,0,0,0,,Apakah karena aku mendengar sesuatu,
Dialog: 0,0:08:54.31,0:08:55.88,Default,LILY,0,0,0,,atau karena cinta pada wanita lain -
Dialog: 0,0:08:55.88,0:08:57.82,Default,LILY,0,0,0,,satu alasan pembunuhan.
Dialog: 0,0:08:58.62,0:09:00.45,Default,LILY,0,0,0,,Aku hanya lebih lemah.
Dialogue: 0,0:09:02.62,0:09:05.66,Default,LILY,0,0,0,,Jika aku lebih kuat, kamu tidak akan menyerangku.
Dialog: 0,0:09:05.76,0:09:07.83,Default,LILY,0,0,0,,Aku mudah dibunuh,
Dialogue: 0,0:09:07.83,0:09:09.76,Default,LILY,0,0,0,,karena aku lebih lemah.
Dialog: 0,0:09:10.53,0:09:12.27,Default,LILY,0,0,0,,Inilah alasan sebenarnya.
Dialog: 0,0:09:18.10,0:09:20.47,Default,LILY,0,0,0,,Ayo. Di sini.
Dialog: 0,0:09:21.37,0:09:24.98,Default,LILY,0,0,0,,Buktikan bahwa kamu hanya membunuh mereka yang lebih lemah.
Dialog: 0,0:09:40.99,0:09:42.23,Default,LILY,0,0,0,,Sial.
Dialog: 0,0:09:42.80,0:09:44.10,Default,LILY,0,0,0,,Aku gila.
Dialog: 0,0:09:44.33,0:09:45.83,Default,LILY,0,0,0,,Yang Mulia.
Dialog: 0,0:09:47.30,0:09:49.50,Default,LILY,0,0,0,,Dia tidak menganggapku serius.
Dialog: 0,0:09:51.27,0:09:54.14,Default,LILY,0,0,0,,Jika aku jadi diriku sendiri, aku akan menjatuhkannya dengan satu pukulan!
Dialog: 0,0:09:54.14,0:09:55.27,Default,LILY,0,0,0,,Sial!
Dialogue: 0,0:10:35.45,0:10:36.85,Default,LILY,0,0,0,,Apa yang terjadi?
Dialog: 0,0:10:37.62,0:10:41.55,Default,LILY,0,0,0,,Saya selalu berpikir bahwa saya adalah orang lemah yang melawan seseorang yang lebih kuat.
Dialog: 0,0:10:42.76,0:10:45.02,Default,LILY,0,0,0,,Oleh karena itu, saya percaya bahwa teknik apa pun
Dialog: 0,0:10:46.79,0:10:48.69,Default,LILY,0,0,0,,dapat diterima.
Dialogue: 0,0:10:53.80,0:10:55.90,Default,LILY,0,0,0,,Sang Ratu tahu,
Dialog: 0,0:10:56.14,0:10:57.94,Default,LILY,0,0,0,,bahwa saya mencoba membunuhnya.
Dialog: 0,0:11:05.08,0:11:09.65,Default,LILY,0,0,0,,Saya pikir ada banyak alasan\N untuk membunuh ratu.
Dialog: 0,0:11:10.02,0:11:12.28,Default,LILY,0,0,0,,Bukan hanya karena percakapan yang terdengar.
Dialog: 0,0:11:12.28,0:11:15.55,Default,LILY,0,0,0,,Tetapi juga karena dia berkontribusi pada tirani.
Dialog: 0,0:11:16.26,0:11:19.49,Default,LILY,0,0,0,,Jadi kupikir aku bisa membunuh ratu.
Dialogue: 0,0:11:24.26,0:11:27.13,Default,LILY,0,0,0,,Namun, ini adalah alasan yang pengecut.
Dialog: 0,0:11:27.83,0:11:30.40,Default,LILY,0,0,0,,Saya belum siap melawan lawan yang kuat,
Dialog: 0,0:11:30.40,0:11:33.11,Default,LILY,0,0,0,,jadi saya menargetkan ratu yang lemah.
Dialog: 0,0:11:35.04,0:11:37.68,Default,LILY,0,0,0,,-Yang Mulia.\N-Jika saya menyerang yang lemah,
Dialog: 0,0:11:39.01,0:11:41.88,Default,LILY,0,0,0,,apa bedanya saya dengan yang lain?
Dialog: 0,0:11:44.38,0:11:46.42,Default,LILY,0,0,0,,Fokus pada tujuan yang benar.
Dialogue: 0,0:11:47.09,0:11:50.79,Default,LILY,0,0,0,,Segala cara baik untuk tujuan yang baik.
Dialog: 0,0:11:51.49,0:11:54.26,Default,LILY,0,0,0,,Klan Kim tidak dapat dikalahkan dengan metode yang benar.
Dialog: 0,0:12:00.43,0:12:01.83,Default,LILY,0,0,0,,Jangan meragukannya.
Dialog: 0,0:12:02.07,0:12:04.47,Default,LILY,0,0,0,,Saya yakin rencana mereka berbahaya.
Dialog: 0,0:12:05.14,0:12:07.44,Default,LILY,0,0,0,,Hanya ratu yang mengetahui hal ini sekarang,
Dialog: 0,0:12:08.07,0:12:10.31,Default,LILY,0,0,0,,tebak saja.
Dialog: 0,0:12:10.44,0:12:12.38,Default,LILY,0,0,0,,Dia harus diam.
Dialogue: 0,0:12:12.78,0:12:15.05,Default,LILY,0,0,0,, Cepat atau lambat semuanya akan menjadi jelas.
Dialog: 0,0:12:17.28,0:12:20.12,Default,LILY,0,0,0,,Saya tidak akan lagi menggunakan taktik pengecut.
Dialog: 0,0:12:20.15,0:12:21.22,Default,LILY,0,0,0,,Yang Mulia.
Dialog: 0,0:12:21.42,0:12:24.36,Default,LILY,0,0,0,,Saya mengutuk ratu karena dia berasal dari keluarga Kim.
Dialog: 0,0:12:24.36,0:12:27.06,Default,LILY,0,0,0,,Namun, dia berperilaku tak terduga.
Dialog: 0,0:12:28.43,0:12:31.70,Default,LILY,0,0,0,,Secara umum, saya tidak seperti yang Anda pikirkan.
Dialogue: 0,0:12:31.70,0:12:33.03,Default,LILY,0,0,0,,Penampilan bisa menipu lho.
Dialog: 0,0:12:34.13,0:12:36.97,Default,LILY,0,0,0,,Ratu berkata dia adalah orang yang berbeda.
Dialogue: 0,0:12:37.74,0:12:40.61,Default,LILY,0,0,0,,Mungkin dia mencoba berkata,
Dialog: 0,0:12:40.61,0:12:43.78,Default,LILY,0,0,0,,bahwa dia dibentuk dari adonan yang berbeda dan bertindak berbeda.
Dialog: 0,0:12:43.91,0:12:45.71,Default,LILY,0,0,0,,Apa yang dapat kamu harapkan darinya?
Dialog: 0,0:12:46.15,0:12:47.41,Default,LILY,0,0,0,,Ratunya sama,
Dialog: 0,0:12:48.31,0:12:49.65,Default,LILY,0,0,0,,seperti Kim lainnya.
Dialog: 0,0:12:50.28,0:12:52.52,Default,LILY,0,0,0,,Mungkin aku raja boneka,
Dialog: 0,0:12:53.49,0:12:56.39,Default,LILY,0,0,0,,tapi kata-kata ratu tidak akan memberi mereka hasil apa pun.
Dialog: 0,0:12:56.56,0:12:58.46,Default,LILY,0,0,0,,Tidak ada bukti yang meyakinkan.
Dialogue: 0,0:13:00.19,0:13:02.43,Default,LILY,0,0,0,,Akan kulihat apa yang ratu lakukan.
Dialog: 0,0:13:02.96,0:13:05.93,Default,LILY,0,0,0,,Pada saat yang sama, aku akan mencari tahu orang seperti apa dia.
Dialog: 0,0:13:19.25,0:13:22.58,Default,LILY,0,0,0,,Saya mencari tahu dari mana kain ini berasal,
Dialog: 0,0:13:23.82,0:13:24.98,Default,LILY,0,0,0,,dia dari istana.
Dialog: 0,0:13:26.52,0:13:29.12,Default,LILY,0,0,0,,Jika seseorang mencoba mencurinya dari raja,
Dialog: 0,0:13:29.49,0:13:31.12,Default,LILY,0,0,0,,dia pasti sudah ditangkap.
Dialogue: 0,0:13:32.53,0:13:35.39,Default,LILY,0,0,0,,Artinya, manusia biasa tidak bisa melakukan ini.
Dialog: 0,0:13:35.63,0:13:40.33,Default,LILY,0,0,0,,Tuhan. Saya bertanya-tanya berapa banyak mereka akan membayar saya untuk layanan saya.
Dialog: 0,0:13:40.57,0:13:43.00,Default,LILY,0,0,0,,Itu tidak mudah pak.
Dialog: 0,0:13:46.74,0:13:47.91,Default,LILY,0,0,0,,Bagus sekali.
Dialog: 0,0:13:50.61,0:13:54.15,Default,LILY,0,0,0,,Mulai sekarang, percayakan padaku yang terberat
Dialog: 0,0:13:54.15,0:13:56.22,Default,LILY,0,0,0,,dan pekerjaan kotor.
Dialog: 0,0:13:57.18,0:13:58.55,Default,LILY,0,0,0,,Istana.
Dialog: 0,0:14:59.51,0:15:00.71,Default,LILY,0,0,0,,Karena satu
Dialog: 0,0:15:01.58,0:15:05.72,Default,LILY,0,0,0,,kami tidak akan memenangkan raja sebagai istri yang mulia.
Dialogue: 0,0:15:06.25,0:15:10.92,Default,LILY,0,0,0,,Kita butuh sesuatu yang bisa meluluhkan hatinya.
Dialog: 0,0:15:12.36,0:15:16.46,Default,LILY,0,0,0,,Titik rentan selir adalah insiden di danau.
Dialog: 0,0:15:18.33,0:15:19.70,Default,LILY,0,0,0,,Kalau begitu...
Dialog: 0,0:15:20.13,0:15:22.47,Default,LILY,0,0,0,,Kita perlu mencari kambing hitam.
Dialog: 0,0:15:23.00,0:15:25.74,Default,LILY,0,0,0,,Lemah dan tak berdaya,
Dialog: 0,0:15:26.77,0:15:29.51,Default,LILY,0,0,0,,seperti anak rusa tanpa induk.
Dialog: 0,0:15:33.15,0:15:34.51,Default,LILY,0,0,0,,Seseorang yang serupa.
Dialog: 0,0:16:17.89,0:16:20.09,Default,LILY,0,0,0,,Kemana perginya pemain tudjon itu?
Dialog: 0,0:16:20.09,0:16:21.66,Default,LILY,0,0,0,,Tidak bisakah kamu memasukkan kartunya?
Dialogue: 0,0:16:21.66,0:16:25.06,Default,LILY,0,0,0,,Kamu tidak akan menyadarinya meski aku mencuri hidungmu.
Dialog: 0,0:16:26.00,0:16:27.07,Default,LILY,0,0,0,,Masalahnya...
Dialog: 0,0:16:28.60,0:16:30.47,Default,LILY,0,0,0,,Tidak. Tidak ada apa-apa.
Dialogue: 0,0:16:31.14,0:16:32.94,Default,LILY,0,0,0,,Ada yang mengganggumu.
Dialog: 0,0:16:34.21,0:16:39.08,Default,LILY,0,0,0,,Terlalu banyak penjahat yang berkeliaran di luar istana.
Dialog: 0,0:16:39.81,0:16:42.25,Default,LILY,0,0,0,,Aku berteman dengan satu pria,
Dialog: 0,0:16:42.25,0:16:43.38,Default,LILY,0,0,0,,Lee Senman.
Dialog: 0,0:16:43.92,0:16:45.15,Default,LILY,0,0,0,,menurutku,
Dialog: 0,0:16:45.88,0:16:48.55,Default,LILY,0,0,0,,dia juga diserang oleh penjahat,
Dialog: 0,0:16:48.55,0:16:50.26,Default,LILY,0,0,0,,berjalan di luar istana.
Dialog: 0,0:16:50.32,0:16:52.29,Default,LILY,0,0,0,,"Juga"? Siapa lagi yang diserang?
Dialogue: 0,0:16:52.39,0:16:54.63,Default,LILY,0,0,0,,Kau tahu, aku sangat tanggap.
Dialogue: 0,0:16:55.03,0:16:57.50,Default,LILY,0,0,0,,Sepupuku Benin,
Dialog: 0,0:16:58.20,0:17:00.63,Default,LILY,0,0,0,,tampaknya mencoba
Dialog: 0,0:17:00.83,0:17:05.04,Default,LILY,0,0,0,,temukan seseorang menggunakan sepotong kain.
Dialogue: 0,0:17:06.47,0:17:08.57,Default,LILY,0,0,0,,Naluriku memberitahuku,
Dialog: 0,0:17:08.81,0:17:12.24,Default,LILY,0,0,0,,pemilik pakaian, penjahat terkenal,
Dialog: 0,0:17:12.68,0:17:13.88,Default,LILY,0,0,0,,terluka
Dialog: 0,0:17:15.05,0:17:16.48,Default,LILY,0,0,0,,temanku
Dialog: 0,0:17:17.05,0:17:19.42,Default,LILY,0,0,0,,dan bertemu dengan saudaraku.
Dialog: 0,0:17:21.92,0:17:23.32,Default,LILY,0,0,0,,Bagaimana menurut anda?
Dialogue: 0,0:17:25.19,0:17:27.73,Default,LILY,0,0,0,,Sia-sia punya bakat sepertimu,
Dialog: 0,0:17:27.73,0:17:29.19,Default,LILY,0,0,0,,tidak menjadi ilmuwan.
Dialog: 0,0:17:29.19,0:17:31.33,Default,LILY,0,0,0,,Kerugian besar bagi kerajaan.
Dialogue: 0,0:17:32.73,0:17:36.64,Default,LILY,0,0,0,,Kamu berwawasan luas seperti saya.
Dialog: 0,0:17:40.07,0:17:45.04,Default,LILY,0,0,0,,Sesuatu yang aneh sedang terjadi di luar istana.
Dialog: 0,0:18:00.63,0:18:01.79,Default,LILY,0,0,0,,Kasihanilah.
Dialog: 0,0:18:01.79,0:18:04.86,Default,LILY,0,0,0,,Saya akan melakukan apa yang Anda minta. Jangan membunuh.
Dialog: 0,0:18:05.36,0:18:07.10,Default,LILY,0,0,0,,Tn.
Dialog: 0,0:18:07.10,0:18:08.23,Default,LILY,0,0,0,,Ny.
Dialog: 0,0:18:09.27,0:18:12.30,Default,LILY,0,0,0,,Saya tidak tahu siapa Anda, tapi saya mohon.
Dialog: 0,0:18:12.64,0:18:13.67,Default,LILY,0,0,0,,Tolong.
Dialog: 0,0:18:16.84,0:18:18.51,Default,LILY,0,0,0,,Saya tidak melihat apa pun.
Dialog: 0,0:18:18.51,0:18:19.78,Default,LILY,0,0,0,,Angkat kepalamu.
Dialog: 0,0:18:20.05,0:18:23.02,Default,LILY,0,0,0,,Tidak. Saya tidak ingin mati.
Dialogue: 0,0:18:31.62,0:18:33.86,Default,LILY,0,0,0,,Kamu tetap tidak bisa melihat wajahku.
Dialog: 0,0:18:44.34,0:18:47.11,Default,LILY,0,0,0,,Orang berpengaruh sedang menunggu jawabanmu.
Dialog: 0,0:18:48.04,0:18:51.01,Default,LILY,0,0,0,,Saya tidak tahu apa-apa.
Dialog: 0,0:18:51.61,0:18:54.21,Default,LILY,0,0,0,,Bagaimana saya tahu sesuatu?
Dialogue: 0,0:18:55.01,0:18:56.18,Default,LILY,0,0,0,,Kau tahu,
Dialog: 0,0:18:56.18,0:18:58.98,Default,LILY,0,0,0,,yang mencoba menyakiti ratu dengan mendorongnya ke dalam danau.
Dialog: 0,0:19:00.52,0:19:02.75,Default,LILY,0,0,0,,Kamu akan selamat jika menyebutkan namanya.
Dialogue: 0,0:19:56.64,0:19:57.81,Default,LILY,0,0,0,,Permisi, Yang Mulia.
Dialog: 0,0:19:58.54,0:20:00.41,Default,LILY,0,0,0,,Rasanya tidak enak,
Dialog: 0,0:20:00.41,0:20:02.11,Default,LILY,0,0,0,,tapi sangat berguna.
Dialog: 0,0:20:09.05,0:20:12.06,Default,LILY,0,0,0,,Ayah ratu membawa sesuatu kemarin.
Dialog: 0,0:20:12.32,0:20:13.66,Default,LILY,0,0,0,,Saya minum saat perut kosong
Dialogue: 0,0:20:14.19,0:20:16.09,Default,LILY,0,0,0,,dan aku merasa segar kembali.
Dialog: 0,0:20:17.13,0:20:20.53,Default,LILY,0,0,0,,Dia selalu tahu di mana mendapatkan sesuatu yang tidak biasa.
Dialog: 0,0:20:21.27,0:20:23.57,Default,LILY,0,0,0,,Sebagai penasihat dapur kerajaan
Dialog: 0,0:20:23.57,0:20:25.37,Default,LILY,0,0,0,,ini memberikan hasil maksimal
Dialog: 0,0:20:25.37,0:20:26.61,Default,LILY,0,0,0,,hal yang cocok.
Dialog: 0,0:20:39.99,0:20:41.02,Default,LILY,0,0,0,,Omong-omong,
Dialog: 0,0:20:41.02,0:20:43.86,Default,LILY,0,0,0,,bagaimana dengan urusan kita di istana?
Dialog: 0,0:20:44.66,0:20:46.73,Default,LILY,0,0,0,,Ada seseorang dalam pikiran,
Dialog: 0,0:20:46.73,0:20:48.23,Default,LILY,0,0,0,,bersiap.
Dialog: 0,0:20:49.43,0:20:52.33,Default,LILY,0,0,0,,Saya mengerti. Segera setelah semuanya berakhir,
Dialogue: 0,0:20:52.90,0:20:55.70,Default,LILY,0,0,0,,bagi saya tidak ada lagi hal yang perlu dikhawatirkan.
Dialog: 0,0:20:56.40,0:20:57.44,Default,LILY,0,0,0,,Ya.
Dialogue: 0,0:20:58.24,0:21:01.01,Default,LILY,0,0,0,,Tidak boleh ada kesalahan kali ini.
Dialog: 0,0:21:17.12,0:21:18.32,Default,LILY,0,0,0,,Kim Byunin
Dialog: 0,0:21:19.56,0:21:21.13,Default,LILY,0,0,0,,mencoba mencari seseorang
Dialogue: 0,0:21:21.13,0:21:22.56,Default,LILY,0,0,0,,sepotong pakaian raja.
Dialog: 0,0:21:29.23,0:21:30.94,Default,LILY,0,0,0,,Aku menghancurkan pakaiannya.
Dialog: 0,0:21:31.44,0:21:34.54,Default,LILY,0,0,0,,Tapi sejak ratu mengetahui kebenarannya...
Dialogue: 0,0:21:34.91,0:21:37.48,Default,LILY,0,0,0,,Jika Benin mengetahui semuanya dan datang mencariku,
Dialog: 0,0:21:37.81,0:21:40.25,Default,LILY,0,0,0,,jadi saya membuat kesalahan tentang ratu.
Dialog: 0,0:21:40.25,0:21:42.45,Default,ZINA,0,0,0,,-Game seperti itu terlalu berbahaya.\N-Saya tahu.
Dialog: 0,0:21:43.52,0:21:46.08,Default,ZINA,0,0,0,,Tetapi jika saya benar,
Dialog: 0,0:21:46.72,0:21:49.12,Default,ZINA,0,0,0,,maka orang yang tidak bersalah tidak akan menderita.
Dialogue: 0,0:21:53.96,0:21:56.93,Default,ZINA,0,0,0,,Hari ini adalah hari pertama ayah mertuaku menjabat.
Dialog: 0,0:22:07.04,0:22:08.04,Default,ZINA,0,0,0,,Yang Mulia.
Dialog: 0,0:22:09.47,0:22:11.61,Default,ZINA,0,0,0,,Saya kira kamu masih di aula Daejeon.
Dialog: 0,0:22:11.88,0:22:13.58,Default,ZINA,0,0,0,,Datang ke sini untuk memeriksa.
Dialog: 0,0:22:14.18,0:22:17.78,Default,ZINA,0,0,0,,Saya perlu berbagi pengetahuan penting dengan Pangeran Yeonpyeong.
Dialog: 0,0:22:22.82,0:22:24.16,Default,ZINA,0,0,0,,Apakah kamu begitu terkejut?
Dialog: 0,0:22:29.69,0:22:31.00,Default,ZINA,0,0,0,,Kepala Kasim.
Dialog: 0,0:22:33.17,0:22:34.20,Default,ZINA,0,0,0,,Ya.
Dialogue: 0,0:22:44.18,0:22:46.08,Default,ZINA,0,0,0,,Dasar psikopat.
Dialog: 0,0:22:46.24,0:22:48.81,Default,ZINA,0,0,0,,Saya pikir dia hanya orang bodoh, dan ini semua hanya pertunjukan.
Dialog: 0,0:22:49.51,0:22:51.82,Default,ZINA,0,0,0,,Apakah raja mencoba membunuh ratu dengan tangannya sendiri?
Dialog: 0,0:22:52.55,0:22:54.89,Default,ZINA,0,0,0,,Jika saya memulai skandal besar,
Dialog: 0,0:22:54.89,0:22:56.66,Default,ZINA,0,0,0,,Saya akan menemukan diri saya di pusat gempa, ini bahkan lebih berbahaya.
Dialog: 0,0:22:57.16,0:22:59.02,Default,ZINA,0,0,0,,Saya tunggu sampai danau terisi.
Dialog: 0,0:22:59.02,0:23:01.69,Default,ZINA,0,0,0,,Sampai saat itu aku akan menundukkan kepalaku dan kembali ke kehidupanku.
Dialog: 0,0:23:03.40,0:23:04.86,Default,ZINA,0,0,0,,Tanganmu mungkin mati rasa.
Dialogue: 0,0:23:04.86,0:23:06.47,Default,ZINA,0,0,0,,Tetap bersilang sekian lama.
Dialog: 0,0:23:07.60,0:23:09.37,Default,ZINA,0,0,0,,Ini membuatku tenang.
Dialog: 0,0:23:13.87,0:23:16.21,Default,ZINA,0,0,0,,Pikiran tak kunjung tenang, meski ingin berhenti.
Dialog: 0,0:23:17.21,0:23:18.94,Default,ZINA,0,0,0,,Apa yang dia masukkan ke dalam tehku?
Dialogue: 0,0:23:18.94,0:23:21.48,Default,ZINA,0,0,0,,Aku mengetahuinya. Anda tidak bisa bersantai sedetik pun.
Dialog: 0,0:23:22.91,0:23:25.82,Default,ZINA,0,0,0,,Tetapi jika dia ingin menghabisiku, dia bisa saja meracuniku.
Dialog: 0,0:23:26.55,0:23:27.62,Default,ZINA,0,0,0,,Jadi kenapa...
Dialogue: 0,0:23:27.62,0:23:28.99,Default,ZINA,0,0,0,,Persetan.
Dialog: 0,0:23:28.99,0:23:30.89,Default,ZINA,0,0,0,,Mengapa saya harus mengkhawatirkan pasien ini?
Dialogue: 0,0:23:32.76,0:23:34.59,Default,ZINA,0,0,0,,Mari kita periksa bagaimana keadaan danaunya.
Dialog: 0,0:23:35.13,0:23:36.96,Default,ZINA,0,0,0,,Apakah kamu punya semacam cambuk?
Dialog: 0,0:23:36.96,0:23:38.46,Default,ZINA,0,0,0,,Kita harus mempercepatnya.
Dialog: 0,0:23:38.46,0:23:39.63,Default,ZINA,0,0,0,,Yang Mulia.
Dialogue: 0,0:23:46.40,0:23:49.04,Default,ZINA,0,0,0,,Janda Ratu mengundangmu ke tempatnya.
Dialog: 0,0:23:50.37,0:23:53.04,Default,ZINA,0,0,0,,Saya tidak membutuhkannya sekarang.
Dialog: 0,0:23:53.04,0:23:54.05,Default,ZINA,0,0,0,,Sial.
Dialogue: 0,0:24:20.41,0:24:22.77,Default,ZINA,0,0,0,,Menyebalkan. Apa lagi yang dia inginkan dariku?
Dialog: 0,0:24:22.77,0:24:23.91,Default,ZINA,0,0,0,,Sial.
Dialog: 0,0:24:56.17,0:24:59.28,Default,ZINA,0,0,0,,Lanjutkan. Semuanya akan berhasil! Tetap bertahan.
Dialog: 0,0:25:00.28,0:25:02.15,Default,ZINA,0,0,0,,Apa yang kamu lakukan? Lebih cepat.
Dialog: 0,0:25:02.15,0:25:04.42,Default,ZINA,0,0,0,,-Di Sini.\N-Pindah.
Dialog: 0,0:25:04.72,0:25:06.12,Default,ZINA,0,0,0,,Hati, lebih hidup.
Dialog: 0,0:25:06.12,0:25:08.32,Default,ZINA,0,0,0,,Lebih hidup. Kita harus bergegas.
Dialog: 0,0:25:08.32,0:25:10.06,Default,ZINA,0,0,0,,Segera. Ayo cepat.
Dialog: 0,0:25:10.06,0:25:12.26,Default,ZINA,0,0,0,,Lanjutkan.
Dialog: 0,0:25:15.13,0:25:16.70,Default,ZINA,0,0,0,,Hati-hati. Pindah.
Dialog: 0,0:25:18.90,0:25:21.07,Default,ZINA,0,0,0,,Aku tidak tahan lagi.
Dialogue: 0,0:25:21.07,0:25:22.87,Default,ZINA,0,0,0,,Aku mau ke kamar kecil. Saya akan segera kembali.
Dialogue: 0,0:25:23.13,0:25:24.90,Default,ZINA,0,0,0,,Banyak pekerjaan. Cepat kembali.
Dialog: 0,0:25:25.77,0:25:26.91,Default,ZINA,0,0,0,,Lebih hidup.
Dialog: 0,0:25:32.61,0:25:36.25,Default,ZINA,0,0,0,,Saya dengar kamu akan datang, jadi saya menunggumu.
Dialog: 0,0:25:37.35,0:25:39.15,Default,ZINA,0,0,0,,Tapi ada apa?
Dialog: 0,0:25:39.52,0:25:43.96,Default,ZINA,0,0,0,,Ibu Suri sangat tertarik padamu.
Dialog: 0,0:25:44.06,0:25:45.66,Default,ZINA,0,0,0,,Suatu kehormatan bagi saya.
Dialog: 0,0:25:46.12,0:25:48.26,Default,ZINA,0,0,0,,Kudengar adikmu sedang dalam perbudakan
Dialog: 0,0:25:48.26,0:25:49.96,Default,ZINA,0,0,0,,karena hutang keluarga.
Dialog: 0,0:25:49.96,0:25:52.76,Default,ZINA,0,0,0,,Ya. Di seluruh dunia, aku hanya punya saudara laki-laki yang tersisa.
Dialog: 0,0:25:53.23,0:25:55.23,Default,ZINA,0,0,0,,Saya dengar Anda sangat khawatir
Dialog: 0,0:25:55.90,0:25:58.07,Default,ZINA,0,0,0,,dan Anda akan melakukan apa pun untuk memulihkan
Dialog: 0,0:25:58.07,0:25:59.37,Default,ZINA,0,0,0,,posisi kakaknya.
Dialogue: 0,0:25:59.37,0:26:02.74,Default,ZINA,0,0,0,,Saya menabung uang secepat yang saya bisa.
Dialog: 0,0:26:03.41,0:26:05.51,Default,ZINA,0,0,0,,Tetapi utangnya sangat besar.
Dialog: 0,0:26:06.24,0:26:08.68,Default,ZINA,0,0,0,,Karena Ibu Suri menghargaimu,
Dialog: 0,0:26:08.68,0:26:10.12,Default,ZINA,0,0,0,,dia melamarmu.
Dialog: 0,0:26:11.15,0:26:13.89,Default,ZINA,0,0,0,,Anda tidak akan memiliki kesempatan seperti itu lagi.
Dialog: 0,0:26:18.42,0:26:19.72,Default,ZINA,0,0,0,,Berapa lama waktu yang dibutuhkan?
Dialog: 0,0:26:20.99,0:26:22.49,Default,ZINA,0,0,0,,Sedikit.
Dialog: 0,0:26:25.46,0:26:27.27,Default,ZINA,0,0,0,,Buat dia mengakuinya juga.
Dialog: 0,0:26:28.43,0:26:30.00,Default,ZINA,0,0,0,,Orang yang mengirim surat,
Dialog: 0,0:26:31.44,0:26:32.57,Default,ZINA,0,0,0,,ibu suri.
Dialog: 0,0:26:34.74,0:26:35.77,Default,ZINA,0,0,0,,Saya mengerti.
Dialog: 0,0:26:37.61,0:26:39.21,Default,ZINA,0,0,0,,Jika saya yang disalahkan dalam hal ini,
Dialog: 0,0:26:39.21,0:26:41.91,Default,ZINA,0,0,0,,aku dan adikku tidak akan selamat.
Dialog: 0,0:26:41.91,0:26:44.18,Default,ZINA,0,0,0,,Tidak perlu mengkhawatirkan saudaramu.
Dialogue: 0,0:26:44.45,0:26:45.62,Default,ZINA,0,0,0,,Dedikasimu
Dialog: 0,0:26:45.62,0:26:48.39,Default,ZINA,0,0,0,,memberinya kehidupan baru.
Dialog: 0,0:26:48.62,0:26:49.69,Default,ZINA,0,0,0,,Tapi...
Dialog: 0,0:26:50.69,0:26:53.06,Default,ZINA,0,0,0,,Menurutmu berapa lama,
Dialog: 0,0:26:53.79,0:26:56.80,Default,ZINA,0,0,0,,mampukah dia menjalani kehidupan yang sulit seperti itu?
Dialog: 0,0:26:57.33,0:27:00.93,Default,ZINA,0,0,0,,Bagaimana jika sesuatu yang buruk terjadi besok, seperti kecelakaan?
Dialog: 0,0:27:03.67,0:27:05.74,Default,ZINA,0,0,0,,Ada yang buruk?
Dialog: 0,0:27:14.08,0:27:16.78,Default,ZINA,0,0,0,,Anda menelepon saya, Yang Mulia?
Dialog: 0,0:27:17.58,0:27:19.28,Default,ZINA,0,0,0,,Saya mengundang Anda,
Dialog: 0,0:27:19.45,0:27:22.65,Default,ZINA,0,0,0,,karena saya ingin mempercayakan sesuatu yang penting kepada Anda.
Dialog: 0,0:27:22.85,0:27:25.09,Default,ZINA,0,0,0,,Sial, apa lagi? Sungguh merepotkan.
Dialog: 0,0:27:25.52,0:27:27.99,Default,ZINA,0,0,0,,Masih terlalu dini bagi saya untuk mengambil tanggung jawab dalam hal-hal penting,
Dialog: 0,0:27:27.99,0:27:30.46,Default,ZINA,0,0,0,,karena masih banyak yang harus dipelajari.
Dialog: 0,0:27:31.43,0:27:33.33,Default,ZINA,0,0,0,,Ya?
Dialogue: 0,0:27:33.93,0:27:35.33,Default,ZINA,0,0,0,,Sayang sekali.
Dialog: 0,0:27:35.63,0:27:38.34,Default,ZINA,0,0,0,,Saya ingin memilih selir yang paling anggun untuk raja,
Dialog: 0,0:27:38.34,0:27:41.57,Default,ZINA,0,0,0,,siapa yang bisa memukau dan memikat raja.
Dialog: 0,0:27:41.84,0:27:43.74,Default,ZINA,0,0,0,,Saya kira tidak ada pilihan selain mencari tahu sendiri.
Dialog: 0,0:27:44.78,0:27:45.81,Default,ZINA,0,0,0,,Mengzi berkata,
Dialog: 0,0:27:46.08,0:27:48.38,Default,ZINA,0,0,0,,bahwa orang-orang berbudi luhur menikmati dukungan.
Dialog: 0,0:27:48.38,0:27:49.81,Default,ZINA,0,0,0,,Kembangkan kebajikan - Anda akan mendapatkan bantuan.
Dialog: 0,0:27:50.22,0:27:51.68,Default,ZINA,0,0,0,,Padahal aku harus banyak belajar,
Dialog: 0,0:27:51.68,0:27:54.19,Default,ZINA,0,0,0,,banyak yang siap membantu saya \Nberkat kebajikan saya.
Dialog: 0,0:27:55.12,0:27:57.36,Default,ZINA,0,0,0,,Jadi saya akan mencoba yang terbaik.
Dialog: 0,0:27:57.96,0:27:59.06,Default,ZINA,0,0,0,,Omong-omong,
Dialog: 0,0:27:59.42,0:28:02.26,Default,ZINA,0,0,0,,berapa jumlah maksimal selir?
Dialog: 0,0:28:03.33,0:28:04.40,Default,ZINA,0,0,0,,Maksimum?
Dialog: 0,0:28:04.66,0:28:07.13,Default,ZINA,0,0,0,,Maksudku, berapa banyak
Dialog: 0,0:28:07.33,0:28:10.07,Default,ZINA,0,0,0,,bisakah kita memilih?
Dialog: 0,0:28:10.74,0:28:13.34,Default,ZINA,0,0,0,,Saya bahkan tidak tahu. Menurut klasik,
Dialog: 0,0:28:13.47,0:28:16.84,Default,ZINA,0,0,0,,harus ada 6 selir peringkat pertama, 3 selir kedua,
Dialog: 0,0:28:16.84,0:28:19.44,Default,ZINA,0,0,0,,9 ketiga, 27 keempat,
Dialog: 0,0:28:19.44,0:28:21.65,Default,ZINA,0,0,0,,dan 81 kelima,
Dialog: 0,0:28:21.65,0:28:24.28,Default,ZINA,0,0,0,,-siapa yang akan mengabdi pada raja.\N-Ayo.
Dialog: 0,0:28:24.72,0:28:27.42,Default,ZINA,0,0,0,,6 ditambah 3.
Dialog: 0,0:28:27.92,0:28:29.02,Default,ZINA,0,0,0,,9.
Dialog: 0,0:28:29.55,0:28:30.76,Default,ZINA,0,0,0,,27.
Dialog: 0,0:28:31.26,0:28:32.62,Default,ZINA,0,0,0,,Dan 81?
Dialog: 0,0:28:33.53,0:28:36.16,Default,ZINA,0,0,0,,Tapi kita perlu menahan diri, kita pilih 3 saja.
Dialog: 0,0:28:36.33,0:28:37.63,Default,ZINA,0,0,0,,Aduh.
Dialog: 0,0:28:39.73,0:28:40.97,Default,ZINA,0,0,0,,Luar Biasa!
Dialog: 0,0:28:41.50,0:28:43.57,Default,ZINA,0,0,0,,Tentu saja.
Dialog: 0,0:28:44.40,0:28:45.97,Default,ZINA,0,0,0,,Yang Mulia sudah mempunyai selir,
Dialog: 0,0:28:45.97,0:28:48.04,Default,ZINA,0,0,0,,Anda harus memilih 2 lagi, bukan?
Dialog: 0,0:28:48.04,0:28:50.54,Default,ZINA,0,0,0,,Tidak, kami akan memilih 3.
Dialog: 0,0:28:51.68,0:28:54.91,Default,ZINA,0,0,0,,Selir itu membawa serta nyonya istana Ovol.
Dialog: 0,0:28:55.11,0:28:57.28,Default,ZINA,0,0,0,,Ya, gadis yang mengejarnya.
Dialog: 0,0:28:57.65,0:28:59.32,Default,ZINA,0,0,0,,Dia mengatakan sesuatu yang gila
Dialog: 0,0:28:59.65,0:29:01.79,Default,ZINA,0,0,0,,karena pengabdian kepada selir.
Dialog: 0,0:29:02.49,0:29:04.86,Default,ZINA,0,0,0,,Kenapa kamu terjun ke danau
Dialog: 0,0:29:04.86,0:29:07.29,Default,ZINA,0,0,0,,tepat di depan Cho Hwajin untuk mencemarkan nama baik dia.
Dialog: 0,0:29:07.29,0:29:08.66,Default,ZINA,0,0,0,,Sebarkan rumor tersebut.
Dialog: 0,0:29:09.63,0:29:13.63,Default,ZINA,0,0,0,,Raja berbohong untuk melindungi Hwajin, dan dia menghancurkan segalanya.
Dialog: 0,0:29:14.57,0:29:15.57,Default,ZINA,0,0,0,,Raja?
Dialog: 0,0:29:15.57,0:29:18.54,Default,ZINA,0,0,0,,Aku akan merampas mainan favorit raja,
Dialog: 0,0:29:18.54,0:29:21.01,Default,ZINA,0,0,0,,jadi saya ingin memberinya yang baru.
Dialog: 0,0:29:23.31,0:29:27.78,Default,ZINA,0,0,0,,Ya. Aku juga ingin kamu menyiapkan makan siang untukku.
Dialog: 0,0:29:27.78,0:29:31.05,Default,ZINA,0,0,0,,Saya tidak bisa lagi memakan sesuatu yang disiapkan oleh orang lain.
Dialogue: 0,0:29:31.98,0:29:34.15,Default,ZINA,0,0,0,,Sial, ini kurang bagus.
Dialog: 0,0:29:38.42,0:29:40.66,Default,ZINA,0,0,0,,Dan jika kamu makan makanan sehat yang aku siapkan setiap hari
Dialogue: 0,0:29:41.29,0:29:43.40,Default,ZINA,0,0,0,,dan kamu akan mulai terlihat lebih muda dariku?
Dialog: 0,0:29:43.76,0:29:45.83,Default,ZINA,0,0,0,,Saya tidak suka ini.
Dialog: 0,0:29:54.44,0:29:57.58,Default,ZINA,0,0,0,,Kamu harus menjaga hubungan baik dengannya sampai danau terisi.
Dialog: 0,0:30:02.74,0:30:05.34,Default,ZINA,0,0,0,,Semuanya terjadi persis seperti yang diinginkan Kim So-yeon.
Dialog: 0,0:30:06.08,0:30:08.11,Default,ZINA,0,0,0,,Dia membawa Hwajin ke dalam jebakan nyata.
Dialog: 0,0:30:09.55,0:30:11.88,Default,ZINA,0,0,0,,Hei, gadis. Ini akan kembali menghantui Anda.
Dialog: 0,0:30:13.18,0:30:14.92,Default,ZINA,0,0,0,,Aku kasihan pada Hwajin.
Dialog: 0,0:30:15.89,0:30:18.06,Default,ZINA,0,0,0,,Tapi apa bedanya? \NI tidak akan peduli ketika saya kembali.
Dialog: 0,0:30:18.06,0:30:19.56,Default,ZINA,0,0,0,,Belum ada waktu untuk mengkhawatirkan orang lain.
Dialog: 0,0:30:19.56,0:30:21.46,Default,ZINA,0,0,0,,Kamu harus membereskan dirimu terlebih dahulu.
Dialog: 0,0:30:23.29,0:30:24.53,Default,ZINA,0,0,0,,Lebih hidup.
Dialog: 0,0:30:24.93,0:30:28.40,Default,ZINA,0,0,0,,Kalian berdua bisa meluangkan waktu.
Dialog: 0,0:30:28.53,0:30:30.20,Default,ZINA,0,0,0,,Kamu akan jatuh lagi, terluka.
Dialog: 0,0:30:33.81,0:30:35.04,Default,ZINA,0,0,0,,Hati, lebih hidup!
Dialog: 0,0:30:37.21,0:30:39.78,Default,ZINA,0,0,0,,Hati, lebih hidup!
Dialog: 0,0:30:40.01,0:30:42.91,Default,ZINA,0,0,0,,Hati, lebih hidup! Ya ya! Bahkan lebih hidup!
Dialog: 0,0:31:00.97,0:31:03.23,Default,ZINA,0,0,0,,Itu dia!
Dialog: 0,0:31:13.48,0:31:15.11,Default,ZINA,0,0,0,,Sial, ini keren.
Dialogue: 0,0:31:15.48,0:31:17.85,Default,ZINA,0,0,0,,Hanya masyarakat kelas atas yang memiliki barang seperti itu.
Dialog: 0,0:31:18.75,0:31:21.25,Default,ZINA,0,0,0,,Pengawal Kerajaan.
Dialog: 0,0:31:23.96,0:31:25.56,Default,ZINA,0,0,0,,Bagus!
Dialog: 0,0:31:32.10,0:31:33.57,Default,ZINA,0,0,0,,Halo, Tuan Kim.
Dialog: 0,0:31:33.57,0:31:35.97,Default,ZINA,0,0,0,,Hari terakhir ya?
Dialog: 0,0:31:36.23,0:31:38.10,Default,ZINA,0,0,0,,Suram, mungkin.
Dialog: 0,0:31:38.10,0:31:41.57,Default,ZINA,0,0,0,,Tidak, saya yakin Anda bisa melakukan pekerjaan yang jauh lebih baik.
Dialog: 0,0:31:41.74,0:31:42.87,Default,ZINA,0,0,0,,Oh, kamu.
Dialogue: 0,0:31:46.61,0:31:48.45,Default,ZINA,0,0,0,,Kuda yang luar biasa.
Dialog: 0,0:31:51.45,0:31:54.49,Default,ZINA,0,0,0,,Ini adalah hadiah dari Yang Mulia kepada komandan pengawal kerajaan.
Dialog: 0,0:31:55.02,0:31:56.29,Default,ZINA,0,0,0,,Duduk.
Dialog: 0,0:31:56.42,0:32:00.23,Default,ZINA,0,0,0,,Ayo. Berapa tahun telah berlalu sejak terakhir kali saya menunggang kuda?
Dialog: 0,0:32:00.56,0:32:04.30,Default,ZINA,0,0,0,,Dan posisi itu bukan milik saya secara resmi,\Sampai saya menerima sertifikat hari ini.
Dialog: 0,0:32:05.06,0:32:07.27,Default,ZINA,0,0,0,,-Baiklah, lain kali.\N-Ya.
Dialog: 0,0:32:08.23,0:32:12.10,Default,ZINA,0,0,0,,Oh, Tuan Kim. Bisakah kamu menunggang kuda?
Dialog: 0,0:32:13.67,0:32:14.74,Default,ZINA,0,0,0,,Siapa kamu?
Dialog: 0,0:32:17.41,0:32:19.48,Default,ZINA,0,0,0,,Saya sahabat Yang Mulia.
Dialog: 0,0:32:19.48,0:32:22.28,Default,ZINA,0,0,0,,Dan para pelayan menganggapku \Tak satu pun dari 5 yang paling menawan...
Dialog: 0,0:32:22.28,0:32:25.25,Default,ZINA,0,0,0,,Kamu tidak perlu tahu siapa dia.
Dialog: 0,0:32:25.58,0:32:27.65,Default,ZINA,0,0,0,,Pangeran Yeonpyeong bahkan tidak termasuk dalam rating.
Dialogue: 0,0:32:27.92,0:32:30.29,Default,ZINA,0,0,0,,Tapi fisikmu
Dialog: 0,0:32:30.29,0:32:32.79,Default,ZINA,0,0,0,,sangat tidak cocok untuk dikendarai.
Dialogue: 0,0:32:32.86,0:32:34.86,Default,ZINA,0,0,0,,Dan kuda yang tinggi sekali.
Dialogue: 0,0:32:34.86,0:32:36.83,Default,ZINA,0,0,0,,Setidaknya lompat ke arahnya dengan kaki pendekmu?
Dialog: 0,0:32:41.37,0:32:42.43,Default,ZINA,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:32:42.67,0:32:44.00,Default,ZINA,0,0,0,,Ya di masa lalu
Dialog: 0,0:32:44.70,0:32:46.44,Default,ZINA,0,0,0,,Saya melompat tanpa tangan.
Dialogue: 0,0:32:46.44,0:32:48.37,Default,ZINA,0,0,0,,Betapa bagusnya dia.
Dialog: 0,0:32:48.37,0:32:50.01,Default,ZINA,0,0,0,,Dia sedang duduk mengangkang di kursi.
Dialog: 0,0:32:50.01,0:32:53.21,Default,ZINA,0,0,0,,Suatu hari aku tertidur di atas kuda dan bahkan melihat mimpi.
Dialog: 0,0:32:55.28,0:32:56.58,Default,ZINA,0,0,0,,Ya, saya serius.
Dialogue: 0,0:32:56.92,0:32:59.02,Default,ZINA,0,0,0,,Akan kubuktikan padamu. Ini dia.
Dialog: 0,0:33:02.52,0:33:05.36,Default,ZINA,0,0,0,,Anda tidak perlu melakukan ini.\N Jangan memaksakan diri.
Dialog: 0,0:33:05.36,0:33:07.33,Default,ZINA,0,0,0,,Oh, diam!
Dialog: 0,0:33:07.86,0:33:09.83,Default,ZINA,0,0,0,,Saya masih bisa.
Dialog: 0,0:33:14.37,0:33:15.60,Default,ZINA,0,0,0,,Sepertinya salah.
Dialog: 0,0:33:17.27,0:33:20.17,Default,ZINA,0,0,0,,Hei, bisakah...
Dialog: 0,0:33:20.41,0:33:22.31,Default,ZINA,0,0,0,,Itu dia.
Dialog: 0,0:33:27.15,0:33:29.75,Default,ZINA,0,0,0,,Apa yang kamu lihat? Ini sangat sederhana.
Dialog: 0,0:33:42.86,0:33:45.23,Default,ZINA,0,0,0,,Oh, ibu.
Dialog: 0,0:33:47.10,0:33:48.23,Default,ZINA,0,0,0,,Tertangkap.
Dialog: 0,0:34:00.18,0:34:03.18,Default,ZINA,0,0,0,,Oh, kamu kucing besar.
Dialog: 0,0:34:04.05,0:34:05.48,Default,ZINA,0,0,0,,Oh, ibu-ibu.
Dialog: 0,0:34:05.48,0:34:08.12,Default,ZINA,0,0,0,,-Mr. Kim!\N-Kakiku! Kaki!
Dialog: 0,0:34:08.12,0:34:10.42,Default,ZINA,0,0,0,,Kaki kecil!
Dialog: 0,0:34:10.52,0:34:13.26,Default,ZINA,0,0,0,,Kentang, garam dan susu.
Dialog: 0,0:34:14.29,0:34:15.36,Default,ZINA,0,0,0,,Susu?
Dialog: 0,0:34:16.13,0:34:17.86,Default,ZINA,0,0,0,,Belum pernah mendengar hal ini sebelumnya.
Dialog: 0,0:34:19.86,0:34:21.47,Default,ZINA,0,0,0,,Disebut juga susu.
Dialog: 0,0:34:21.67,0:34:22.87,Default,ZINA,0,0,0,,Mengerti.
Dialogue: 0,0:34:22.87,0:34:25.44,Default,ZINA,0,0,0,,Bahan yang langka,\Nit tenggelam seperti air.
Dialog: 0,0:34:25.44,0:34:26.94,Default,ZINA,0,0,0,,Anda tidak akan memiliki minyak.
Dialogue: 0,0:34:28.41,0:34:29.47,Default,ZINA,0,0,0,,Apakah kamu punya lada hitam?
Dialog: 0,0:34:29.64,0:34:30.91,Default,ZINA,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:34:31.38,0:34:35.05,Default,ZINA,0,0,0,,Lebih berharga dari emas, tapi tenggelam seperti pasir.
Dialog: 0,0:34:35.05,0:34:38.02,Default,ZINA,0,0,0,,Tapi dia tidak mau mendengarkanku,\Njadi aku tidak akan mengatakan apa pun.
Dialog: 0,0:34:39.88,0:34:41.02,Default,ZINA,0,0,0,,Saya dengar, oke?
Dialog: 0,0:34:43.66,0:34:46.22,Default,ZINA,0,0,0,,-Yang Mulia!\N-Oh, Anda.
Dialog: 0,0:34:46.22,0:34:49.13,Default,ZINA,0,0,0,,Sudah kubilang jangan terburu-buru. Mengapa kamu lari?
Dialog: 0,0:34:51.86,0:34:54.33,Default,ZINA,0,0,0,,Nyonya Choi juga sedang terburu-buru ke sini.
Dialog: 0,0:34:54.73,0:34:57.17,Default,ZINA,0,0,0,,Dia tidak muda. Bagaimana jika Anda pingsan dan pingsan saat berlari?
Dialogue: 0,0:34:57.17,0:34:59.17,Default,ZINA,0,0,0,,Aku disana!
Dialog: 0,0:35:01.07,0:35:03.04,Default,ZINA,0,0,0,,Mungkin saya agak lambat,
Dialog: 0,0:35:03.04,0:35:05.14,Default,ZINA,0,0,0,,tapi aku tidak akan pernah pingsan.
Dialogue: 0,0:35:12.85,0:35:14.05,Default,ZINA,0,0,0,,Wanita yang keras kepala.
Dialog: 0,0:35:18.62,0:35:21.43,Default,ZINA,0,0,0,,-Baik, tuangkan.\N-Ya, Yang Mulia.
Dialog: 0,0:35:32.84,0:35:33.87,Default,ZINA,0,0,0,,Dan itu saja?
Dialogue: 0,0:35:35.04,0:35:37.91,Default,ZINA,0,0,0,,Apakah kamu bercanda?\N-Nah, masalahnya...
Dialog: 0,0:35:37.94,0:35:41.71,Default,ZINA,0,0,0,,Yang Mulia, ini adalah hal yang sangat langka.
Dialog: 0,0:35:41.98,0:35:43.82,Default,ZINA,0,0,0,,Itulah mengapa saya membutuhkannya.
Dialog: 0,0:35:44.12,0:35:45.82,Default,ZINA,0,0,0,,Dalam memasak, produk menentukan segalanya.
Dialog: 0,0:35:46.15,0:35:49.42,Default,ZINA,0,0,0,,Jika kamu memerah semuanya, anak sapi akan kelaparan.
Dialog: 0,0:35:49.89,0:35:51.39,Default,ZINA,0,0,0,,Dan perhatian juga.
Dialog: 0,0:35:51.46,0:35:53.29,Default,ZINA,0,0,0,,Sial, kesedihan.
Dialog: 0,0:35:54.56,0:35:56.13,Default,ZINA,0,0,0,,Pernahkah Anda mendengar tentang hari puasa?
Dialogue: 0,0:35:56.13,0:35:58.26,Default,ZINA,0,0,0,,Puasa intermiten baik untuk kesehatanmu.
Dialog: 0,0:35:59.73,0:36:01.83,Default,ZINA,0,0,0,,Isi kuali saya dari sini.
Dialogue: 0,0:36:02.40,0:36:05.14,Default,ZINA,0,0,0,,Kurangi satu tetes saja... Kamu tahu kan?
Dialog: 0,0:36:08.91,0:36:10.24,Default,ZINA,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:36:16.08,0:36:17.18,Default,ZINA,0,0,0,,Hmmm.
Dialog: 0,0:36:19.68,0:36:20.82,Default,ZINA,0,0,0,,Siapa kamu?
Dialogue: 0,0:36:21.22,0:36:22.82,Default,ZINA,0,0,0,,Beraninya gadis itu muncul...
Dialog: 0,0:36:32.76,0:36:33.80,Default,ZINA,0,0,0,,Kemarilah.
Dialog: 0,0:36:38.60,0:36:39.70,Default,ZINA,0,0,0,,Siapa namamu?
Dialog: 0,0:36:39.70,0:36:41.31,Default,ZINA,0,0,0,,Damhyan.
Dialog: 0,0:36:42.31,0:36:43.94,Default,ZINA,0,0,0,,Kamu membesarkan anak anjing di istana.
Dialog: 0,0:36:44.61,0:36:47.61,Default,ZINA,0,0,0,,Anjing itu statusnya lebih tinggi dariku.
Dialog: 0,0:36:48.01,0:36:50.65,Default,ZINA,0,0,0,,Utusan dari Min. membawa anjing itu.
Dialog: 0,0:36:50.65,0:36:53.25,Default,ZINA,0,0,0,,Mereka bilang itu jenis langka atau semacamnya.
Dialog: 0,0:36:54.79,0:36:57.12,Default,ZINA,0,0,0,,Min? Ini terjadi 200 tahun yang lalu.
Dialog: 0,0:36:58.32,0:37:00.73,Default,ZINA,0,0,0,,Jika selama berabad-abad ini ras tersebut bercampur dengan ras lain,
Dialog: 0,0:37:00.73,0:37:03.13,Default,ZINA,0,0,0,,maka itu hanya anjing kampung.
Dialog: 0,0:37:04.36,0:37:05.66,Default,TIRAMISU,0,0,0,,Dan siapa namanya?
Dialog: 0,0:37:05.96,0:37:07.90,Default,TIRAMISU,0,0,0,,Anjing itu belum punya nama.
Dialog: 0,0:37:07.90,0:37:09.57,Default,TIRAMISU,0,0,0,,Benarkah? Lalu
Dialog: 0,0:37:10.70,0:37:13.24,Default,TIRAMISU,0,0,0,,-sebut saja dia Iblis.\N-Iblis?
Dialog: 0,0:37:13.50,0:37:14.51,Default,TIRAMISU,0,0,0,,Lihat.
Dialog: 0,0:37:15.17,0:37:16.94,Default,TIRAMISU,0,0,0,,Jadi, ayo menulis.
Dialog: 0,0:37:18.91,0:37:23.61,Default,TIRAMISU,0,0,0,,P - E - S. Gantikan p dengan konsonan berpasangan.
Dialog: 0,0:37:23.81,0:37:25.42,Default,TIRAMISU,0,0,0,,PES
Dialog: 0,0:37:25.44,0:37:26.52,Default,TIRAMISU,0,0,0,,B
Dialog: 0,0:37:27.69,0:37:28.75,Default,TIRAMISU,0,0,0,,E
Dialog: 0,0:37:29.65,0:37:31.92,Default,TIRAMISU,0,0,0,,Dan kita punya iblis.
Dialog: 0,0:37:32.36,0:37:33.69,Default,TIRAMISU,0,0,0,,Oleh karena itu Setan.
Dialog: 0,0:37:33.69,0:37:36.06,Default,TIRAMISU,0,0,0,,Sekarang saya mengerti.
Dialog: 0,0:37:40.33,0:37:42.53,Default,TIRAMISU,0,0,0,,Kamu sering datang ke sini, mungkin lapar.
Dialog: 0,0:37:44.60,0:37:45.67,Default,TIRAMISU,0,0,0,,Tunggu sebentar.
Dialog: 0,0:37:48.51,0:37:49.54,Default,TIRAMISU,0,0,0,,Jadi.
Dialog: 0,0:37:53.04,0:37:54.31,Default,TIRAMISU,0,0,0,,Voila.
Dialog: 0,0:37:57.92,0:37:58.98,Default,TIRAMISU,0,0,0,,Cobalah.
Dialog: 0,0:38:02.02,0:38:03.09,Default,TIRAMISU,0,0,0,,Di Sini.
Dialogue: 0,0:38:09.03,0:38:10.19,Default,TIRAMISU,0,0,0,,Kenapa kamu tidak makan?
Dialog: 0,0:38:10.19,0:38:12.90,Default,TIRAMISU,0,0,0,,Karena terlalu indah.
Dialog: 0,0:38:14.43,0:38:16.17,Default,TIRAMISU,0,0,0,,Jangan khawatir. Ini tidak gratis.
Dialogue: 0,0:38:16.17,0:38:18.50,Default,TIRAMISU,0,0,0,,Segera setelah kamu memakannya, bantu aku dengan kentangnya.
Dialog: 0,0:38:18.50,0:38:19.54,Default,TIRAMISU,0,0,0,,Kamu tidak bisa melakukan itu.
Dialog: 0,0:38:20.67,0:38:23.24,Default,TIRAMISU,0,0,0,,Aku siap menerima kehadiranmu, karena kamu adalah seorang ratu.
Dialog: 0,0:38:23.24,0:38:24.78,Default,TIRAMISU,0,0,0,,Lama-lama wanita tak berani
Dialog: 0,0:38:24.78,0:38:26.81,Default,TIRAMISU,0,0,0,,sentuh makanan kerajaan.
Dialog: 0,0:38:26.81,0:38:28.41,Default,TIRAMISU,0,0,0,,Mereka diperbolehkan untuk menghias hidangan
Dialog: 0,0:38:28.41,0:38:29.81,Default,TIRAMISU,0,0,0,,dan sajikan di atas meja.
Dialog: 0,0:38:29.81,0:38:32.15,Default,TIRAMISU,0,0,0,,Tanpa akar dan tanpa posisi resmi...
Dialogue: 0,0:38:33.38,0:38:34.52,Default,TIRAMISU,0,0,0,,Anak ini
Dialog: 0,0:38:34.52,0:38:38.19,Default,TIRAMISU,0,0,0,,tidak dapat membantu memasak.
Dialogue: 0,0:38:40.79,0:38:43.36,Default,TIRAMISU,0,0,0,,Dasar kentut tua.
Dialogue: 0,0:38:44.66,0:38:47.20,Default,TIRAMISU,0,0,0,,Dan kamu mencobanya. "Kentut tua".
Dialog: 0,0:38:47.20,0:38:49.03,Default,TIRAMISU,0,0,0,,-Kentut tua.\N-Apa?
Dialogue: 0,0:38:49.03,0:38:51.84,Default,TIRAMISU,0,0,0,,Wow, kamu mengatakannya dengan sangat jelas.
Dialog: 0,0:38:52.90,0:38:54.57,Default,TIRAMISU,0,0,0,,Sekarang sebut saja dia si tua bangka.
Dialog: 0,0:38:55.37,0:38:56.57,Default,TIRAMISU,0,0,0,,Jangan terganggu. Makan.
Dialogue: 0,0:39:01.18,0:39:03.71,Default,TIRAMISU,0,0,0,,Rasanya seperti sedang memakan awan.
Dialog: 0,0:39:05.25,0:39:07.29,Default,TIRAMISU,0,0,0,,Perbandingan luar biasa.
Dialog: 0,0:39:07.65,0:39:09.79,Default,TIRAMISU,0,0,0,,Anda dapat menjadi pembawa acara.
Dialog: 0,0:39:10.66,0:39:11.69,Default,TIRAMISU,0,0,0,,Pf.
Dialogue: 0,0:39:13.16,0:39:15.63,Default,TIRAMISU,0,0,0,,Ngomong-ngomong, bukankah dia terlalu muda untuk masuk istana?
Dialog: 0,0:39:16.69,0:39:18.86,Default,TIRAMISU,0,0,0,,Orang tuanya tidak membayar pajak,
Dialog: 0,0:39:18.86,0:39:20.10,Default,TIRAMISU,0,0,0,,jadi diambil.
Dialog: 0,0:39:20.10,0:39:22.03,Default,TIRAMISU,0,0,0,,Semua orang di keluarganya menjadi budak,
Dialogue: 0,0:39:22.63,0:39:25.64,Default,TIRAMISU,0,0,0,,dan ayahnya lari dengan pengecut.
Dialog: 0,0:39:25.64,0:39:28.04,Default,TIRAMISU,0,0,0,,Wow. Ayah macam apa ini?
Dialog: 0,0:39:29.41,0:39:30.51,Default,TIRAMISU,0,0,0,,Koki Kerajaan.
Dialog: 0,0:39:31.38,0:39:32.78,Default,TIRAMISU,0,0,0,,Apakah kamu tidak punya hati nurani sama sekali?
Dialog: 0,0:39:35.51,0:39:36.65,Default,TIRAMISU,0,0,0,,Damhyan.
Dialog: 0,0:39:36.65,0:39:39.62,Default,TIRAMISU,0,0,0,,Jangan perhatikan semua hal buruknya ya?
Dialogue: 0,0:39:42.42,0:39:43.62,Default,TIRAMISU,0,0,0,,Doo-kanker.
Dialog: 0,0:39:44.32,0:39:45.36,Default,TIRAMISU,0,0,0,,Ulangi.
Dialog: 0,0:39:45.99,0:39:47.12,Default,TIRAMISU,0,0,0,,Bodoh.
Dialog: 0,0:39:47.99,0:39:50.33,Default,TIRAMISU,0,0,0,,Apa? Bodoh?
Dialog: 0,0:39:50.49,0:39:51.66,Default,TIRAMISU,0,0,0,,Bodoh!
Dialogue: 0,0:40:04.68,0:40:07.24,Default,TIRAMISU,0,0,0,,Mengapa bola kentang begitu besar?
Dialogue: 0,0:40:07.88,0:40:09.78,Default,TIRAMISU,0,0,0,,Kapan mereka akan membawa susunya?
Dialog: 0,0:40:10.61,0:40:11.75,Default,TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:40:14.22,0:40:19.32,Default,TIRAMISU,0,0,0,,Aku memerah semua sapi sampai tetes terakhir.
Dialog: 0,0:40:24.40,0:40:26.26,Default,TIRAMISU,0,0,0,,Bagus sekali.
Dialog: 0,0:40:27.50,0:40:28.73,Default,TIRAMISU,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:40:36.21,0:40:37.74,Default,TIRAMISU,0,0,0,,Bubur susu.
Dialogue: 0,0:40:46.05,0:40:48.49,Default,TIRAMISU,0,0,0,,Mengapa kamu menambahkan kentang ke dalam buburmu?
Dialog: 0,0:40:48.49,0:40:49.62,Default,TIRAMISU,0,0,0,,Bagaimana bisa.
Dialogue: 0,0:40:49.79,0:40:52.06,Default,TIRAMISU,0,0,0,,Apakah kamu ibu mertuaku?
Dialogue: 0,0:40:52.06,0:40:53.92,Default,TIRAMISU,0,0,0,,Ibu mertua tidak boleh mengganggu menantunya.
Dialog: 0,0:40:54.96,0:40:55.96,Default,TIRAMISU,0,0,0,,Apa?
Dialogue: 0,0:40:56.19,0:40:58.76,Default,TIRAMISU,0,0,0,,Mengapa ibu mertua tidak boleh main-main dengan menantu perempuannya?
Dialog: 0,0:40:58.76,0:41:00.26,Default,TIRAMISU,0,0,0,,Ini salah.
Dialog: 0,0:41:07.17,0:41:08.17,Default,TIRAMISU,0,0,0,,Oke.
Dialog: 0,0:41:20.72,0:41:22.72,Default,TIRAMISU,0,0,0,,Aku akan menyampaikannya secara pribadi.
Dialogue: 0,0:41:54.79,0:41:56.02,Default,TIRAMISU,0,0,0,,Cukup enak.
Dialog: 0,0:41:59.42,0:42:00.52,Default,TIRAMISU,0,0,0,,Namun,
Dialogue: 0,0:42:01.56,0:42:04.26,Default,TIRAMISU,0,0,0,,saat kentang mendingin, kentang menjadi keras.
Dialog: 0,0:42:04.83,0:42:07.67,Default,TIRAMISU,0,0,0,,Dan bubur susu terciprat ke piring.
Dialog: 0,0:42:07.67,0:42:09.20,Default,TIRAMISU,0,0,0,,Ini semua, tentu saja, tidak menyenangkan.
Dialog: 0,0:42:09.60,0:42:10.67,Default,TIRAMISU,0,0,0,,Tapi saya mengerti
Dialog: 0,0:42:11.44,0:42:13.47,Default,TIRAMISU,0,0,0,,tidak ada yang sempurna.
Dialog: 0,0:42:18.28,0:42:19.94,Default,TIRAMISU,0,0,0,,Tidak mungkin menyiapkan hidangan yang sempurna
Dialog: 0,0:42:19.94,0:42:21.71,Default,TIRAMISU,0,0,0,,tanpa layanan yang tepat.
Dialogue: 0,0:42:22.78,0:42:24.95,Default,TIRAMISU,0,0,0,,Bagaimana cara menyajikan hidangan agar tidak menjadi dingin
Dialog: 0,0:42:24.95,0:42:26.78,Default,TIRAMISU,0,0,0,,dan tidak tumpah?
Dialog: 0,0:42:26.78,0:42:28.32,Default,TIRAMISU,0,0,0,,Ini pertanyaan utamanya.
Dialog: 0,0:43:20.97,0:43:22.51,Default,TIRAMISU,0,0,0,,Mari kita bertanya pada ahlinya.
Dialog: 0,0:43:26.51,0:43:27.51,Default,TIRAMISU,0,0,0,,Ambillah.
Dialogue: 0,0:43:27.51,0:43:29.05,Default,TIRAMISU,0,0,0,,Kenapa kamu belum menempelkan ini?
Dialog: 0,0:43:29.05,0:43:30.71,Default,TIRAMISU,0,0,0,,Apakah kamu masih belum selesai?
Dialog: 0,0:43:30.71,0:43:32.95,Default,TIRAMISU,0,0,0,,-Apa yang kamu lakukan?\N-Cepatlah.
Dialog: 0,0:43:36.19,0:43:40.19,Default,TIRAMISU,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:43:40.19,0:43:41.23,Default,TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:43:45.86,0:43:48.70,Default,TIRAMISU,0,0,0,,Tandu. Saya membutuhkan tandu untuk makanan.
Dialog: 0,0:43:48.70,0:43:49.70,Default,TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:43:50.07,0:43:52.14,Default,TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:43:52.47,0:43:53.57,Default,TIRAMISU,0,0,0,,Tandu untuk makanan?
Dialog: 0,0:43:53.57,0:43:55.31,Default,TIRAMISU,0,0,0,,-Tandu untuk makanan?\N-Tandu untuk makanan?
Dialogue: 0,0:43:55.31,0:43:57.54,Default,TIRAMISU,0,0,0,,-Jenis tandu untuk makanan apa?\N-Tandu untuk makanan?
Dialog: 0,0:43:58.84,0:44:00.78,Default,TIRAMISU,0,0,0,,Tandu untuk makanan?
Dialog: 0,0:44:00.78,0:44:02.68,Default,TIRAMISU,0,0,0,,-Apa?\N-Tandu untuk makanan?
Dialog: 0,0:44:02.95,0:44:04.38,Default,TIRAMISU,0,0,0,,-Apa yang kamu bisikkan di sana?\N-Tandu untuk makanan?
Dialog: 0,0:44:05.65,0:44:06.85,Default,TIRAMISU,0,0,0,,-Apa?\N-Tandu untuk makanan?
Dialog: 0,0:44:07.72,0:44:09.32,Default,TIRAMISU,0,0,0,,Hati-hati.
Dialog: 0,0:44:10.72,0:44:11.76,Default,TIRAMISU,0,0,0,,Lulus.
Dialog: 0,0:44:12.96,0:44:13.99,Default,TIRAMISU,0,0,0,,Itu dia.
Dialog: 0,0:44:15.09,0:44:16.59,Default,TIRAMISU,0,0,0,,Yang Mulia ada di sini.
Dialog: 0,0:44:18.16,0:44:20.86,Default,TIRAMISU,0,0,0,,-Berkumpul bersama. Satu-dua.\N-Satu-dua.
Dialog: 0,0:44:20.86,0:44:24.50,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:44:24.50,0:44:26.30,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Baiklah, mari kita lihat.
Dialog: 0,0:44:26.30,0:44:29.31,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:44:29.31,0:44:31.04,Default,TIRAMISU,0,0,0,,-Apa? Dan itu saja?\N-Satu-dua.
Dialog: 0,0:44:31.04,0:44:32.98,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:44:32.98,0:44:34.14,Default,TIRAMISU,0,0,0,,-Satu-dua.\N-Satu-dua.
Dialog: 0,0:44:34.14,0:44:35.88,Default,TIRAMISU,0,0,0,,-Apakah Anda bekerja sepanjang malam?\N-Ya.
Dialog: 0,0:44:35.88,0:44:37.25,Default,TIRAMISU,0,0,0,,Kami bekerja dalam shift.
Dialog: 0,0:44:37.25,0:44:39.68,Default,TIRAMISU,0,0,0,,Mereka mengumpulkan air dan menuangkannya ke danau sepanjang malam.
Dialog: 0,0:44:39.68,0:44:41.29,Default,TIRAMISU,0,0,0,,Tapi danaunya sangat besar.
Dialog: 0,0:44:41.29,0:44:42.32,Default,TIRAMISU,0,0,0,,-Satu-dua.\N-Satu-dua.
Dialog: 0,0:44:42.32,0:44:44.19,Default,TIRAMISU,0,0,0,,Butuh waktu sehari untuk mengeringkan danau.
Dialogue: 0,0:44:44.19,0:44:45.59,Default,TIRAMISU,0,0,0,,Kenapa lama sekali pengisiannya?
Dialog: 0,0:44:45.59,0:44:47.59,Default,TIRAMISU,0,0,0,,Danaunya di atas bukit, jadi
Dialogue: 0,0:44:47.59,0:44:50.23,Default,TIRAMISU,0,0,0,,mudah mengurasnya - cukup buat sumur.
Dialog: 0,0:44:51.40,0:44:54.10,Default,TIRAMISU,0,0,0,,Saya yakin mereka santai,
Dialog: 0,0:44:54.10,0:44:55.97,Default,TIRAMISU,0,0,0,,karena tidak ada pengurusnya.
Dialog: 0,0:44:57.57,0:44:58.74,Default,TIRAMISU,0,0,0,,-Satu-dua.\N-Satu-dua.
Dialogue: 0,0:45:05.58,0:45:08.18,Default,TIRAMISU,0,0,0,,Mungkin setelah kita selesai,
Dialogue: 0,0:45:08.58,0:45:11.38,Default,TIRAMISU,0,0,0,,bisakah kita minum segelas?
Dialog: 0,0:45:12.68,0:45:13.75,Default,TIRAMISU,0,0,0,,
Dialog: 0,0:45:13.75,0:45:15.72,Default,TIRAMISU,0,0,0,,Bagaimana menurut anda? A?
Dialog: 0,0:45:16.82,0:45:19.36,Default,TIRAMISU,0,0,0,,Saya mengajukan pertanyaan! Ini adalah anak-anak nakal.
Dialog: 0,0:45:20.29,0:45:21.63,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:45:22.86,0:45:24.96,Default,TIRAMISU,0,0,0,,Apa yang membawamu kesini?
Dialog: 0,0:45:25.16,0:45:28.93,Default,TIRAMISU,0,0,0,,Yang Mulia ingin minuman ringan.
Dialog: 0,0:45:29.67,0:45:30.83,Default,TIRAMISU,0,0,0,,Ratu?
Dialog: 0,0:45:34.44,0:45:35.47,Default,TIRAMISU,0,0,0,,Benarkah?
Dialogue: 0,0:45:36.97,0:45:40.68,Default,TIRAMISU,0,0,0,,Lalu saya akan membuat pukulan azalea sederhana.
Dialog: 0,0:45:41.35,0:45:42.71,Default,TIRAMISU,0,0,0,,Untuk panen pertama
Dialog: 0,0:45:42.71,0:45:45.78,Default,TIRAMISU,0,0,0,,Berry Schisandra sudah matang.
Dialog: 0,0:45:46.15,0:45:48.92,Default,TIRAMISU,0,0,0,,Seduh teh dari buah beri dan maniskan dengan madu.
Dialogue: 0,0:45:48.92,0:45:51.92,Default,TIRAMISU,0,0,0,,Saya akan menambahkan pir dan jeruk keprok untuk kesegaran.
Dialog: 0,0:45:52.36,0:45:54.43,Default,TIRAMISU,0,0,0,,Untuk menjaga kesegaran dan
Dialog: 0,0:45:54.43,0:45:56.43,Default,TIRAMISU,0,0,0,,dinginkan minuman, tambahkan es.
Dialog: 0,0:45:57.09,0:45:59.90,Default,TIRAMISU,0,0,0,,Karena azalea belum mekar,
Dialog: 0,0:46:00.10,0:46:03.00,Default,TIRAMISU,0,0,0,,Saya menggunakan Evening Primrose. Kami menghapus alu,
Dialogue: 0,0:46:03.00,0:46:04.84,Default,TIRAMISU,0,0,0,,sedikit kanji,
Dialog: 0,0:46:04.84,0:46:06.90,Default,TIRAMISU,0,0,0,,masukkan ke dalam air mendidih
Dialog: 0,0:46:06.90,0:46:08.61,Default,TIRAMISU,0,0,0,,dan dinginkan dalam air dingin.
Dialogue: 0,0:46:08.77,0:46:11.21,Default,TIRAMISU,0,0,0,,Gunakan bunga untuk menghias pukulannya.
Dialog: 0,0:46:11.71,0:46:15.18,Default,TIRAMISU,0,0,0,,Sentuhan akhir adalah tiga kacang pinus.
Dialog: 0,0:46:21.25,0:46:24.36,Default,TIRAMISU,0,0,0,,Saya bisa menyiapkan minuman seperti itu dengan mata tertutup.
Dialog: 0,0:46:24.52,0:46:25.62,Default,TIRAMISU,0,0,0,,Itu saja.
Dialogue: 0,0:46:28.53,0:46:32.43,Default,TIRAMISU,0,0,0,,Baiklah, saya melihat bagaimana Anda membuatnya dengan mata terbuka lebar.
Dialogue: 0,0:46:39.34,0:46:41.77,Default,TIRAMISU,0,0,0,,Kenapa dia hanya menatapku?
Dialogue: 0,0:46:43.07,0:46:44.21,Default,TIRAMISU,0,0,0,,Memalukan sekali.
Dialog: 0,0:46:59.36,0:47:01.16,Default,TIRAMISU,0,0,0,,Menjaga ritme.
Dialog: 0,0:47:05.76,0:47:08.87,Default,TIRAMISU,0,0,0,,Yang Mulia, ini minuman Anda.
Dialog: 0,0:47:09.27,0:47:13.14,Default,TIRAMISU,0,0,0,,Apa? Ya. Mari kita lihat.
Dialog: 0,0:47:13.84,0:47:15.97,Default,TIRAMISU,0,0,0,,Tentu saja, saya tidak dalam posisi itu,
Dialog: 0,0:47:16.27,0:47:17.98,Default,TIRAMISU,0,0,0,,tetapi Anda tidak dapat menghindarinya - nikmatilah.
Dialog: 0,0:47:21.55,0:47:22.61,Default,TIRAMISU,0,0,0,,Oke.
Dialog: 0,0:47:25.18,0:47:26.18,Default,TIRAMISU,0,0,0,,
Dialog: 0,0:47:30.82,0:47:32.06,Default,TIRAMISU,0,0,0,,Berapa banyak lagi?
Dialog: 0,0:47:32.19,0:47:34.39,Default,TIRAMISU,0,0,0,,Kalau begini terus kita akan selesai saat malam tiba.
Dialog: 0,0:47:34.39,0:47:35.49,Default,TIRAMISU,0,0,0,,Sampai matahari terbenam.
Dialog: 0,0:47:35.99,0:47:38.10,Default,TIRAMISU,0,0,0,,Ini tidak mungkin.
Dialog: 0,0:47:38.10,0:47:40.40,Default,TIRAMISU,0,0,0,,Beraninya kamu. Pastikan Anda menyelesaikannya hari ini.
Dialog: 0,0:47:40.40,0:47:42.53,Default,TIRAMISU,0,0,0,,Jika tidak, kepala akan berputar.
Dialog: 0,0:47:43.60,0:47:44.64,Default,TIRAMISU,0,0,0,,Saya patuh.
Dialog: 0,0:47:47.94,0:47:50.47,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:47:50.47,0:47:52.01,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:47:52.01,0:47:53.14,Default,TIRAMISU,0,0,0,,Beri tahu koki kerajaan
Dialog: 0,0:47:53.31,0:47:56.31,Default,TIRAMISU,0,0,0,,-siapkan minuman ini untuk semua orang yang ada di sini.\N-Satu-dua, satu-dua.
Dialog: 0,0:47:56.31,0:47:58.22,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:47:58.22,0:47:59.78,Default,TIRAMISU,0,0,0,,-Untuk semua pelayan ini?\N-Satu-dua, satu-dua.
Dialog: 0,0:47:59.78,0:48:01.99,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:48:01.99,0:48:05.02,Default,TIRAMISU,0,0,0,,-Satu-dua, satu-dua.\N-Satu-dua, satu-dua.
Dialog: 0,0:48:11.83,0:48:15.30,Default,TIRAMISU,0,0,0,,Dia kesini lagi, pasti jatuh cinta dengan bakatku.
Dialog: 0,0:48:16.33,0:48:19.84,Default,TIRAMISU,0,0,0,,Saya yakin dia akan meminta pukulan lagi.
Dialogue: 0,0:48:21.67,0:48:23.01,Default,TIRAMISU,0,0,0,,Ya, aku mendengarkanmu.
Dialogue: 0,0:48:23.01,0:48:25.61,Default,TIRAMISU,0,0,0,,Sang Ratu memintamu menyiapkan lebih banyak pukulan.
Dialog: 0,0:48:26.98,0:48:29.15,Default,TIRAMISU,0,0,0,,Saya tahu dia menginginkan lebih.
Dialogue: 0,0:48:29.55,0:48:33.65,Default,TIRAMISU,0,0,0,,Apakah dia tidak sengaja menjatuhkan mangkuknya karena rasanya yang enak?
Dialog: 0,0:48:34.32,0:48:37.19,Default,TIRAMISU,0,0,0,,Atau mungkin dia menitikkan air mata?
Dialogue: 0,0:48:40.36,0:48:43.16,Default,TIRAMISU,0,0,0,,Nyonya Choi, begini,
Dialog: 0,0:48:44.16,0:48:45.33,Default,TIRAMISU,0,0,0,,orang macam apa saya ini.
Dialog: 0,0:48:47.40,0:48:49.40,Default,TIRAMISU,0,0,0,,-Royal Chef.\N-Royal Chef.
Dialog: 0,0:48:49.40,0:48:51.03,Default,TIRAMISU,0,0,0,,Baiklah, berhenti di situ.
Dialog: 0,0:48:52.34,0:48:54.17,Default,TIRAMISU,0,0,0,,Koki kerajaan, masalahnya...
Dialogue: 0,0:48:54.17,0:48:58.38,Default,TIRAMISU,0,0,0,,Tentu saja aku akan membuatkan sedikit untukmu juga.
Dialogue: 0,0:48:59.31,0:49:02.88,Default,TIRAMISU,0,0,0,,Menurutku kamu juga suka minumannya
Dialog: 0,0:49:03.28,0:49:05.32,Default,TIRAMISU,0,0,0,,lebih dari biasanya.
Dialog: 0,0:49:11.29,0:49:12.59,Default,TIRAMISU,0,0,0,,Apakah Anda melihat apa yang saya lakukan?
Dialog: 0,0:49:12.59,0:49:14.59,Default,TIRAMISU,0,0,0,,Itu lucu.
Dialog: 0,0:49:24.30,0:49:26.90,Default,TIRAMISU,0,0,0,,Saya akan membuat yang lain. Tunggu sebentar.
Dialogue: 0,0:49:27.14,0:49:31.28,Default,TIRAMISU,0,0,0,,Sementara kamu menyiapkannya, maukah kamu membuat sedikit lagi?
Dialog: 0,0:49:32.18,0:49:35.75,Default,TIRAMISU,0,0,0,,Tentu saja. Berapa banyak yang Anda butuhkan?
Dialog: 0,0:49:37.01,0:49:39.38,Default,TIRAMISU,0,0,0,,-Ini dia.\N-Enak sekali.
Dialog: 0,0:49:39.38,0:49:41.08,Default,TIRAMISU,0,0,0,,Terima kasih.
Dialog: 0,0:49:41.29,0:49:43.72,Default,TIRAMISU,0,0,0,,Terima kasih, Yang Mulia.
Dialogue: 0,0:49:53.53,0:49:56.43,Default,TIRAMISU,0,0,0,,Mahal sekali. Terima kasih, Yang Mulia.
Dialog: 0,0:49:56.87,0:49:58.20,Default,TIRAMISU,0,0,0,,Setidaknya Anda sadar.
Dialog: 0,0:49:59.10,0:50:02.01,Default,TIRAMISU,0,0,0,,Terima kasih atas kemurahan hati Anda, Yang Mulia.
Dialog: 0,0:50:02.01,0:50:05.44,Default,TIRAMISU,0,0,0,,Terima kasih atas kemurahan hati Anda, Yang Mulia.
Dialog: 0,0:50:05.61,0:50:07.78,Default,TIRAMISU,0,0,0,,Ya, ya. Tidak ada yang istimewa.
Dialog: 0,0:50:08.28,0:50:09.61,Default,TIRAMISU,0,0,0,,Jangan berdiri disana, minum.
Dialog: 0,0:50:12.72,0:50:14.45,Default,TIRAMISU,0,0,0,,Ini enak sekali.
Dialogue: 0,0:50:15.45,0:50:17.52,Default,TIRAMISU,0,0,0,,Mereka sangat mudah untuk dibuat.
Dialog: 0,0:50:24.36,0:50:28.23,Default,TIRAMISU,0,0,0,,Aku bersembunyi dengan sangat baik hingga seekor burung pun tidak menyadarinya.
Dialogue: 0,0:50:31.37,0:50:33.44,Default,TIRAMISU,0,0,0,,Aku berusaha keras,
Dialog: 0,0:50:33.94,0:50:35.61,Default,TIRAMISU,0,0,0,,tapi aku hanya ingin minum sekarang.
Dialog: 0,0:50:46.92,0:50:48.85,Default,TIRAMISU,0,0,0,,Kamu sibuk sekali sejak kemarin.
Dialog: 0,0:50:49.25,0:50:51.72,Default,TIRAMISU,0,0,0,,Meskipun saya tidak yakin apa yang Anda lakukan.
Dialog: 0,0:50:52.16,0:50:54.52,Default,TIRAMISU,0,0,0,,Apakah kamu melihatku?
Dialog: 0,0:50:54.96,0:50:58.40,Default,TIRAMISU,0,0,0,,Tentu saja. Anda mudah dikenali.
Dialog: 0,0:50:58.56,0:50:59.56,Default,TIRAMISU,0,0,0,,Mudah diperhatikan?
Dialogue: 0,0:51:01.23,0:51:02.50,Default,TIRAMISU,0,0,0,,Begitulah maksudnya.
Dialog: 0,0:51:02.50,0:51:04.77,Default,TIRAMISU,0,0,0,,Sebelum itu, kedua dayang tidak memperhatikanku
Dialog: 0,0:51:04.77,0:51:06.50,Default,TIRAMISU,0,0,0,,dan berbicara secara terbuka.
Dialog: 0,0:51:06.50,0:51:09.31,Default,TIRAMISU,0,0,0,,Saya harus kembali ke ratu.
Dialog: 0,0:51:11.94,0:51:13.01,Default,TIRAMISU,0,0,0,,Mangkuk.
Dialog: 0,0:51:58.79,0:52:00.26,Default,TIRAMISU,0,0,0,,Sejak aku tertangkap,
Dialog: 0,0:52:00.96,0:52:02.33,Default,TIRAMISU,0,0,0,,maka saya akan menyelesaikannya untuk hari ini.
Dialog: 0,0:52:08.87,0:52:11.00,Default,TIRAMISU,0,0,0,,Saat dia melihatku,
Dialog: 0,0:52:11.60,0:52:15.97,Default,TIRAMISU,0,0,0,,Aku muncul di hadapannya seperti bunga.
Dialog: 0,0:52:27.18,0:52:28.39,Default,TIRAMISU,0,0,0,,Bagaimana bisa.
Dialog: 0,0:52:35.83,0:52:36.96,Default,TIRAMISU,0,0,0,,Kamu akan terluka.
Dialog: 0,0:52:47.77,0:52:49.21,Default,TIRAMISU,0,0,0,,Jangan sentuh dengan tangan kosong.
Dialog: 0,0:53:09.56,0:53:12.96,Default,TIRAMISU,0,0,0,,Perasaan yang membuatmu menginginkan rasa sakit, -
Dialog: 0,0:53:13.56,0:53:14.56,Default,TIRAMISU,0,0,0,,cinta.
Dialog: 0,0:53:31.52,0:53:33.18,Default,TIRAMISU,0,0,0,,Aku akan bertanya-tanya.
Dialog: 0,0:53:33.65,0:53:36.79,Default,TIRAMISU,0,0,0,,Saya yakin tidak ada yang serius, jadi jangan khawatir.
Dialog: 0,0:53:36.79,0:53:39.19,Default,TIRAMISU,0,0,0,,Ovol bukanlah salah satu dari mereka yang akan menghilang tanpa berkata apa-apa.
Dialogue: 0,0:53:39.69,0:53:41.46,Default,TIRAMISU,0,0,0,,Aku yakin terjadi sesuatu padanya.
Dialog: 0,0:53:42.13,0:53:43.93,Default,TIRAMISU,0,0,0,,Ibu Suri akan datang.
Dialog: 0,0:53:47.33,0:53:48.40,Default,TIRAMISU,0,0,0,,Ibu Suri.
Dialog: 0,0:53:49.63,0:53:51.03,Default,TIRAMISU,0,0,0,,Tinggalkan kami.
Dialog: 0,0:53:58.68,0:54:01.71,Default,TIRAMISU,0,0,0,,Ingat semua yang saya katakan sekarang.
Dialog: 0,0:54:02.78,0:54:05.38,Default,TIRAMISU,0,0,0,,Di seluruh istana kamu hanya bisa mempercayaiku,
Dialog: 0,0:54:05.38,0:54:07.68,Default,TIRAMISU,0,0,0,,karena aku senasib denganmu.
Dialog: 0,0:54:08.39,0:54:12.59,Default,TIRAMISU,0,0,0,,Kamu harus memberitahuku segalanya, tanpa menyembunyikan apa pun.
Dialogue: 0,0:54:13.69,0:54:16.69,Default,TIRAMISU,0,0,0,,Inilah satu-satunya cara aku dan gadis itu bisa bertahan.
Dialogue: 0,0:54:45.36,0:54:47.09,Default,TIRAMISU,0,0,0,,Bagus sekali.
Dialog: 0,0:54:47.79,0:54:51.09,Default,TIRAMISU,0,0,0,,Pangeran Yeonpyeong, kepala kasim dan aku.
Dialog: 0,0:54:52.93,0:54:54.06,Default,TIRAMISU,0,0,0,,Kepala Kasim.
Dialogue: 0,0:54:54.93,0:54:57.73,Default,TIRAMISU,0,0,0,,Karena ratu ingin membaca “Septateuch”,
Dialog: 0,0:54:57.73,0:54:59.97,Default,TIRAMISU,0,0,0,,Saya meminta Anda untuk memberikan saya salinan lainnya.
Dialog: 0,0:55:01.07,0:55:02.11,Default,TIRAMISU,0,0,0,,Apa?
Dialog: 0,0:55:04.57,0:55:07.28,Default,TIRAMISU,0,0,0,,Kamu tidak memintaku untuk ini.
Dialog: 0,0:55:07.38,0:55:08.41,Default,HEIN,0,0,0,,Kepala Kasim.
Dialogue: 0,0:55:08.98,0:55:11.72,Default,HEIN,0,0,0,,Selama bertahun-tahun, apakah Anda pernah menderita demensia?
Dialog: 0,0:55:12.12,0:55:13.98,Default,HEIN,0,0,0,,Saya ingat dengan jelas apa yang saya pesan.
Dialog: 0,0:55:14.38,0:55:17.16,Default,HEIN,0,0,0,,Segera pergi ke Kyujangak dan sampaikan perintahku.
Dialog: 0,0:55:17.75,0:55:19.69,Default,HEIN,0,0,0,,Apakah kamu ingin aku segera pergi?
Dialog: 0,0:55:19.69,0:55:21.99,Default,HEIN,0,0,0,,Mungkin kita harus menunggu sampai kamu lupa lagi?
Dialog: 0,0:55:21.99,0:55:26.03,Default,HEIN,0,0,0,,Aku akan menemanimu ke aula Daejojon, dan tiba di sana dalam sekejap.
Dialog: 0,0:55:27.20,0:55:30.23,Default,HEIN,0,0,0,,Aku tidak berjalan sendirian, Pangeran Yeonpyeong akan melindungiku jika terjadi sesuatu.
Dialog: 0,0:55:30.23,0:55:31.80,Default,HEIN,0,0,0,,Mengapa begitu khawatir?
Dialog: 0,0:55:32.24,0:55:33.50,Default,HEIN,0,0,0,,Saya menyarankan Anda untuk bergegas.
Dialog: 0,0:55:36.44,0:55:37.71,Default,HEIN,0,0,0,,Ya, baiklah.
Dialog: 0,0:56:00.30,0:56:02.53,Default,HEIN,0,0,0,,Wah, apa aku baru saja dibunuh babi hutan?
Dialog: 0,0:56:03.67,0:56:04.73,Default,HEIN,0,0,0,,Kepala Kasim.
Dialog: 0,0:56:05.44,0:56:07.64,Default,HEIN,0,0,0,,-Apakah kamu tidak terluka?\N-Saya baik-baik saja.
Dialog: 0,0:56:09.21,0:56:11.24,Default,HEIN,0,0,0,,Sepertinya hidungmu patah.
Dialog: 0,0:56:11.24,0:56:12.38,Default,HEIN,0,0,0,,Tidak, hidungku!
Dialogue: 0,0:56:12.68,0:56:14.28,Default,HEIN,0,0,0,,Wah, ini darah?
Dialog: 0,0:56:14.48,0:56:16.35,Default,HEIN,0,0,0,,Ya, hidungku selalu seperti itu!
Dialog: 0,0:56:16.68,0:56:20.02,Default,HEIN,0,0,0,,Ayo. Bisakah hidung manusia terlihat seperti ini?
Dialog: 0,0:56:20.02,0:56:21.65,Default,HEIN,0,0,0,,Cepat pergi ke rumah sakit.
Dialog: 0,0:56:21.65,0:56:23.82,Default,HEIN,0,0,0,,Ya Tuhan. Dia bilang dia baik-baik saja.
Dialog: 0,0:56:25.18,0:56:26.82,Default,HEIN,0,0,0,,Ovol, nyonya istana yang hilang,
Dialog: 0,0:56:26.82,0:56:28.53,Default,HEINE,0,0,0,,berada di istana bersama Selir Cho
Dialog: 0,0:56:28.53,0:56:30.69,Default,HAIN,0,0,0,,pada hari ratu jatuh ke danau.
Dialogue: 0,0:56:31.34,0:56:33.56,Default,HAINE,0,0,0,,Mereka akan memaksanya memberikan kesaksian palsu.
Dialog: 0,0:56:33.70,0:56:36.40,Default,HEIN,0,0,0,,Itu semua terjadi saat ratu mengetahuinya
Dialogue: 0,0:56:36.40,0:56:37.57,Default,HEIN,0,0,0,,bahwa kamu menyerangnya.
Dialog: 0,0:56:38.80,0:56:41.00,Default,HEINE,0,0,0,,Targetnya adalah Selir Cho, bukan aku.
Dialog: 0,0:56:42.41,0:56:43.44,Default,HEIN,0,0,0,,Balas dendam.
Dialog: 0,0:56:44.01,0:56:45.88,Default,HEINE,0,0,0,,Inikah yang diinginkan ratu?
Dialog: 0,0:56:51.01,0:56:52.05,Default,HEIN,0,0,0,,Yang Mulia.
Dialog: 0,0:56:53.05,0:56:54.05,Default,HEIN,0,0,0,,Hwajin.
Dialog: 0,0:57:01.59,0:57:02.69,Default,HEIN,0,0,0,,Maaf.
Dialog: 0,0:57:03.26,0:57:05.43,Default,HEIN,0,0,0,,Hwajin, tidak ada yang perlu kamu minta maaf.
Dialog: 0,0:57:05.96,0:57:07.50,Default,HEINE,0,0,0,,Ini semua salahku.
Dialog: 0,0:57:08.50,0:57:09.60,Default,HEIN,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:57:14.16,0:57:16.77,Default,HAINE,0,0,0,,Baru-baru ini saya juga mencoba menyingkirkan ratu.
Dialog: 0,0:57:18.07,0:57:19.48,Default,HEIN,0,0,0,,Dia membalas dendam padaku, itu sebabnya
Dialog: 0,0:57:19.48,0:57:21.95,Default,HEIN,0,0,0,,berusaha menyalahkanmu atas kejadian di danau.
Dialog: 0,0:57:23.71,0:57:25.45,Default,HEIN,0,0,0,,Trik yang selalu sama.
Dialog: 0,0:57:25.94,0:57:28.56,Default,HEIN,0,0,0,,Memalsukan bukti,\Nmenjebak orang yang tidak bersalah.
Dialog: 0,0:57:31.02,0:57:33.49,Default,HAINE,0,0,0,,Aku akan memberitahu semua orang bahwa aku mencoba membunuh ratu.
Dialog: 0,0:57:34.39,0:57:35.43,Default,HEIN,0,0,0,,Yang Mulia.
Dialogue: 0,0:57:37.03,0:57:40.26,Default,HEIN,0,0,0,,Kau dan aku tahu lebih banyak tentang balas dendam daripada kebanyakan orang.
Dialog: 0,0:57:40.46,0:57:42.03,Default,HEIN,0,0,0,,Lebih dari mengembalikan semua rasa sakit dan penderitaan.
Dialogue: 0,0:57:42.03,0:57:43.43,Default,HEIN,0,0,0,,Itulah yang namanya balas dendam.
Dialog: 0,0:57:44.10,0:57:45.47,Default,HEIN,0,0,0,,Ratu juga haus
Dialog: 0,0:57:45.94,0:57:47.84,Default,HEIN,0,0,0,,taruh pedang di tenggorokan Hwajin.
Dialogue: 0,0:57:49.84,0:57:52.21,Default,HAINE,0,0,0,,Satu-satunya cara menenangkan amarahnya adalah
Dialog: 0,0:57:53.61,0:57:55.11,Default,HEIN,0,0,0,,berlutut di depannya.
Dialog: 0,0:57:56.58,0:57:57.71,Default,HEIN,0,0,0,,Tidak ada cara lain.
Dialog: 0,0:57:59.82,0:58:02.72,Default,HEINE,0,0,0,,Dia merencanakan semuanya,
Dialogue: 0,0:58:02.72,0:58:04.19,Default,HEINE,0,0,0,,untuk menjebakku.
Dialog: 0,0:58:04.72,0:58:06.46,Default,HEINE,0,0,0,,Saya akan turun tangan dan mengakhiri ini.
Dialogue: 0,0:58:08.54,0:58:11.40,Default,HEIN,0,0,0,,Jangan lupa tentang tujuan besar\Nyang sedang Anda perjuangkan.
Dialog: 0,0:58:11.46,0:58:14.20,Default,HEIN,0,0,0,,Atau apakah kamu sudah lupa berapa banyak hinaan yang harus kamu tanggung di akhir-akhir ini?
Dialog: 0,0:58:14.20,0:58:16.10,Default,HEINE,0,0,0,,2 tahun untuk mempersiapkan diri dengan baik?
Dialog: 0,0:58:16.33,0:58:17.53,Default,HEIN,0,0,0,,Untuk tujuan besar
Dialogue: 0,0:58:18.12,0:58:20.30,Default,HEIN,0,0,0,,kamu harus lolos begitu saja.
Dialogue: 0,0:58:23.44,0:58:26.38,Default,HEIN,0,0,0,,Belum pernah dalam hidupku aku ingin menjadi raja,
Dialog: 0,0:58:27.71,0:58:29.21,Default,HEIN,0,0,0,,boneka di tangan yang salah.
Dialog: 0,0:58:30.95,0:58:34.82,Default,HEIN,0,0,0,,Saya datang ke istana ini karena satu alasan.
Dialog: 0,0:58:37.65,0:58:39.52,Default,HEIN,0,0,0,,Tidak ada lagi yang melarikan diri.
Dialog: 0,0:58:53.50,0:58:55.64,Default,HEIN,0,0,0,,Tidak perlu menyarankan saya untuk menjalankannya lagi.
Dialog: 0,0:58:56.01,0:58:57.87,Default,HEIN,0,0,0,,Saya pasti tidak akan lari.
Dialog: 0,0:59:00.28,0:59:02.31,Default,HEIN,0,0,0,,Saya akan mencari setiap celah
Dialog: 0,0:59:02.31,0:59:04.11,Default,HEIN,0,0,0,,dan saya akan menemukan Ovol.
Dialog: 0,0:59:05.00,0:59:07.46,Default,HEIN,0,0,0,,Kemungkinan besar, mereka menginterogasinya di suatu tempat di istana,
Dialog: 0,0:59:07.78,0:59:09.38,Default,HEIN,0,0,0,,segera setelah mereka mengalahkan pengakuannya,
Dialog: 0,0:59:09.62,0:59:11.75,Default,HEIN,0,0,0,,Anda akan segera dihukum.
Dialog: 0,0:59:12.59,0:59:13.92,Default,HEIN,0,0,0,,Harap tunggu,
Dialog: 0,0:59:15.43,0:59:16.56,Default,HEIN,0,0,0,,sampai aku menemukannya.
Dialog: 0,0:59:17.39,0:59:18.46,Default,HEIN,0,0,0,,Oke.
Dialog: 0,0:59:18.70,0:59:21.90,Default,HEIN,0,0,0,,Tetapi jika terjadi kesalahan, saya akan segera turun tangan.
Dialogue: 0,0:59:22.83,0:59:24.70,Default,HEIN,0,0,0,,Dan jangan menghalangi jalanku.
Dialog: 0,0:59:25.50,0:59:27.00,Default,HEIN,0,0,0,,Ini adalah perintah.
Dialog: 0,0:59:27.67,0:59:29.64,Default,HEIN,0,0,0,,Terlalu banyak nyawa yang hilang.
Dialog: 0,0:59:30.41,0:59:31.57,Default,HEIN,0,0,0,,Hari ini
Dialog: 0,0:59:32.78,0:59:34.61,Default,HEIN,0,0,0,,Saya tidak ingin kehilangan siapa pun.
Dialog: 0,0:59:48.66,0:59:52.53,Default,HEIN,0,0,0,,Yang Mulia, Anda harus menjaga diri sendiri.
Dialog: 0,0:59:53.76,0:59:55.06,Default,HEIN,0,0,0,,Saya akan mencoba.
Dialog: 0,0:59:55.63,0:59:58.06,Default,HEIN,0,0,0,,Berlutut atau merangkak di kaki mereka,
Dialog: 0,0:59:58.06,1:00:00.34,Default,HEIN,0,0,0,,pura-pura bodoh, seolah-olah ini salah paham, -
Dialog: 0,1:00:01.00,1:00:02.97,Default,HEIN,0,0,0,,Saya akan melakukan apa pun untuk menghindari masalah.
Dialog: 0,1:00:04.91,1:00:05.94,Default,HEIN,0,0,0,,Yang Mulia.
Dialog: 0,1:00:24.83,1:00:27.26,Default,HEIN,0,0,0,,Kalian semua harus mengenakan seragam kalian.
Dialog: 0,1:00:27.92,1:00:30.20,Default,HEIN,0,0,0,,Kami pergi mencari nyonya istana.
Dialog: 0,1:00:30.67,1:00:32.67,Default,HEIN,0,0,0,,Diyakini bahwa dia ada di istana.
Dialog: 0,1:00:34.54,1:00:36.71,Default,HEIN,0,0,0,,Pastikan tidak ada yang melihatmu.
Dialog: 0,1:00:37.04,1:00:39.28,Default,HEIN,0,0,0,,Berhati-hatilah.
Dialog: 0,1:00:55.89,1:00:58.96,Default,HEIN,0,0,0,,Kebosanan yang mematikan.
Dialog: 0,1:01:02.06,1:01:03.93,Default,HEIN,0,0,0,,Apa yang harus dilakukan untuk bersenang-senang?
Dialog: 0,1:01:05.64,1:01:06.74,Default,HEIN,0,0,0,,Yang Mulia.
Dialog: 0,1:01:06.74,1:01:08.91,Default,HEIN,0,0,0,,Suatu hari saya berhasil mendapatkannya
Dialog: 0,1:01:08.91,1:01:10.81,Default,HEIN,0,0,0,,benang sutra ini dari Qing.
Dialog: 0,1:01:12.58,1:01:14.18,Default,HEIN,0,0,0,,Apakah Anda memiliki gudang di saku Anda?
Dialog: 0,1:01:14.18,1:01:17.75,Default,HEIN,0,0,0,,Saya pikir suatu hari nanti Anda\Ningin kembali ke hobi Anda.
Dialog: 0,1:01:19.25,1:01:21.02,Default,HEIN,0,0,0,,Maaf, tentu saja, tapi tidak, terima kasih.
Dialog: 0,1:01:21.06,1:01:22.35,Default,HEIN,0,0,0,,Ada baiknya mengambil jarumnya,
Dialog: 0,1:01:22.35,1:01:24.25,Default,HEIN,0,0,0,,tidak ada ruang tersisa di jariku.
Dialog: 0,1:01:24.25,1:01:25.29,Default,HEIN,0,0,0,,Oleh karena itu
Dialog: 0,1:01:26.49,1:01:28.12,Default,HEIN,0,0,0,,Saya bersenjata lengkap.
Dialog: 0,1:01:30.53,1:01:32.36,Default,HEIN,0,0,0,,Apakah Anda baru saja menunjukkan triknya kepada saya?
Dialog: 0,1:01:33.46,1:01:35.73,Default,HEIN,0,0,0,,Apa yang kamu bicarakan? Ini disebut bidal.
Dialog: 0,1:01:36.07,1:01:38.30,Default,HEIN,0,0,0,,Sudahkah Anda memutuskan ini mainan, Yang Mulia?
Dialog: 0,1:01:39.44,1:01:40.54,Default,HEIN,0,0,0,,Nyonya Choi.
Dialog: 0,1:01:41.27,1:01:42.74,Default,HEIN,0,0,0,,Apakah Anda benar-benar keluar topik?
Dialog: 0,1:01:47.24,1:01:48.48,Default,HEIN,0,0,0,,Honyoung, dan kamu?
Dialogue: 0,1:01:52.64,1:01:54.98,Default,HEIN,0,0,0,,Apakah bidal memiliki makna tersembunyi?
Dialog: 0,1:01:55.28,1:01:58.42,Default,HEIN,0,0,0,,Saya menyiapkannya agar jari Anda\Ntidak tertusuk saat menjahit.
Dialog: 0,1:01:59.76,1:02:02.02,Default,HEIN,0,0,0,,Saya tersiksa oleh keraguan yang samar-samar.
Dialog: 0,1:02:13.20,1:02:16.74,Default,HEIN,0,0,0,,Yang Mulia, saya sangat mengkhawatirkan Anda.
Dialogue: 0,1:02:16.74,1:02:18.34,Default,HEIN,0,0,0,,Kau mendahuluiku.
Dialog: 0,1:02:19.28,1:02:22.22,Default,HEIN,0,0,0,,Raja seharusnya tidak lari,\Nheels berkilau, dia berlama-lama.
Dialog: 0,1:02:25.45,1:02:26.92,Default,HAINE,0,0,0,,Apakah Ratu ada di rumah?
Dialog: 0,1:02:28.28,1:02:30.52,Default,HEIN,0,0,0,,Saya mendengar Yang Mulia berjalan di tepi danau.
Dialog: 0,1:02:32.15,1:02:33.59,Default,HEIN,0,0,0,,Di tepi danau? Kenapa tiba-tiba?
Dialog: 0,1:02:35.16,1:02:36.83,Default,HEIN,0,0,0,,Kata-kata Selir Cho bertepatan
Dialog: 0,1:02:37.23,1:02:40.63,Default,HEIN,0,0,0,,dengan kata-kata Yang Mulia.
Dialog: 0,1:02:41.30,1:02:44.33,Default,HAINE,0,0,0,,Dia bilang dia bahkan tidak bertemu ratu malam itu.
Dialog: 0,1:02:45.33,1:02:48.67,Default,HEIN,0,0,0,,Bahwa dia lari setelah mendengar suara keras.
Dialog: 0,1:02:49.74,1:02:53.14,Default,HEIN,0,0,0,,Tapi apakah itu benar atau salah, saya tidak tahu.
Dialog: 0,1:02:53.71,1:02:55.04,Default,HEIN,0,0,0,,Hanya saja kelihatannya seperti seorang wanita,
Dialog: 0,1:02:55.04,1:02:58.28,Default,HEIN,0,0,0,,yang dilihat oleh kasim dan pelayan yang mencuri hadiah kerajaan,
Dialog: 0,1:02:58.85,1:03:02.92,Default,HEINE,0,0,0,,benar-benar selir Cho.
Dialog: 0,1:03:03.59,1:03:06.96,Default,HAINE,0,0,0,,Atau dia jatuh ke dalam perangkap ratu.
Dialog: 0,1:03:08.72,1:03:10.83,Default,HEINE,0,0,0,,Sebelum dia melebarkan sayapnya.
Dialog: 0,1:03:14.70,1:03:15.73,Default,HEIN,0,0,0,,Yang Mulia.
Dialog: 0,1:03:16.12,1:03:18.20,Default,HAIN,0,0,0,,Selir Cho sekarang berada di Aula Dongmyeongjong.
Dialog: 0,1:03:37.45,1:03:40.09,Default,HEIN,0,0,0,,Saya akan melindungi Anda, Yang Mulia.
Dialog: 0,1:03:46.33,1:03:48.03,Default,HEIN,0,0,0,,Dia datang atas kemauannya sendiri.
Dialog: 0,1:03:49.87,1:03:52.97,Default,HEIN,0,0,0,,Rupanya, Ovol lebih dekat dengannya dari yang kita duga.
Dialog: 0,1:03:53.30,1:03:55.91,Default,HEIN,0,0,0,,Bagus sekali. Ternyata ternyata lebih mudah dari yang kita duga.
Dialog: 0,1:03:56.24,1:03:57.54,Default,HEIN,0,0,0,,Karena dia datang sendiri,
Dialog: 0,1:03:57.54,1:03:59.71,Default,HEINE,0,0,0,,kamu harus membuatnya mengakui segalanya.
Dialog: 0,1:04:00.18,1:04:02.65,Default,HEIN,0,0,0,,Kesehatan lebih penting bagi saya,
Dialog: 0,1:04:03.05,1:04:04.78,Default,HEIN,0,0,0,,Saya selesaikan makan saya dulu.
Dialog: 0,1:04:04.78,1:04:06.42,Default,HEIN,0,0,0,,Anda memang benar.
Dialog: 0,1:04:57.36,1:04:58.83,Default,HEIN,0,0,0,,Semuanya salah.
Dialog: 0,1:04:59.80,1:05:03.57,Default,HEIN,0,0,0,,Nyonya Hwajin tidak akan pernah melakukan hal seperti itu.
Dialog: 0,1:05:05.31,1:05:09.31,Default,HEIN,0,0,0,,Bahkan jika kamu membunuhku, kebenarannya tidak akan berubah.
Dialog: 0,1:05:17.12,1:05:18.25,Default,HEIN,0,0,0,,Kasihan.
Dialog: 0,1:05:18.72,1:05:21.59,Default,HEIN,0,0,0,,Kamu seperti anjing setia yang menjilat
Dialog: 0,1:05:21.59,1:05:24.13,Default,HEIN,0,0,0,,tangan nyonya hendak menusukmu.
Dialog: 0,1:05:26.03,1:05:28.06,Default,HEIN,0,0,0,,Sudah terlambat untuk mengakuinya.
Dialogue: 0,1:05:30.07,1:05:32.77,Default,HEIN,0,0,0,,Nyonyamu, Hwajin, menyalahkanmu segalanya.
Dialog: 0,1:05:36.14,1:05:37.31,Default,HEIN,0,0,0,,Ini tidak mungkin.
Dialog: 0,1:05:45.08,1:05:46.15,Default,HEIN,0,0,0,,Di Sini.
Dialogue: 0,1:05:47.38,1:05:48.75,Default,HEIN,0,0,0,,Wow, kamu hebat.
Dialog: 0,1:05:49.95,1:05:51.02,Default,HEIN,0,0,0,,Itu saja.
Dialog: 0,1:05:59.36,1:06:02.00,Default,HEIN,0,0,0,,-Tuhan.\N-Benang yang sangat berharga.
Dialog: 0,1:06:02.06,1:06:04.03,Default,HEIN,0,0,0,,Masalah abadi dengan tchotchkes yang mahal.
Dialog: 0,1:06:04.03,1:06:05.57,Default,HEIN,0,0,0,,Sangat rapuh.
Dialog: 0,1:06:06.40,1:06:07.47,Default,HEIN,0,0,0,,Mari kita lihat.
Dialog: 0,1:06:08.04,1:06:10.71,Default,HEIN,0,0,0,,Ayo temukan sesuatu yang lebih kuat.
Dialog: 0,1:06:19.38,1:06:21.72,Default,HEIN,0,0,0,,"Tinggalkan dirimu yang palsu"?
Dialog: 0,1:06:22.22,1:06:24.35,Default,HEIN,0,0,0,,"Tinggalkan dirimu yang palsu"?
Dialog: 0,1:06:24.35,1:06:25.49,Default,HEIN,0,0,0,,Apa ini?
Dialog: 0,1:06:25.49,1:06:28.82,Default,HEIN,0,0,0,,Anda menyulam sendiri hieroglif ini saat Anda punya waktu luang.
Dialog: 0,1:06:29.09,1:06:31.46,Default,HEIN,0,0,0,,Saya tidak tahu apa maksudnya, saya buta huruf,
Dialog: 0,1:06:31.46,1:06:33.30,Default,HEINE,0,0,0,,tapi menurut saya ini ayat yang indah.
Dialogue: 0,1:06:33.66,1:06:35.63,Default,HEINE,0,0,0,,Ini pertama kalinya aku melihat ini.
Dialogue: 0,1:06:36.17,1:06:39.64,Default,HEIN,0,0,0,,Kebetulan Anda\Ntidak melihat ratu sedang melakukan pekerjaan ini.
Dialogue: 0,1:06:40.94,1:06:42.67,Default,HEIN,0,0,0,,Ini puisi cinta?
Dialog: 0,1:06:42.67,1:06:45.78,Default,HEINE,0,0,0,,Ini adalah catatan bunuh diri.
Dialogue: 0,1:06:47.61,1:06:49.58,Default,HEINE,0,0,0,,Apakah aku menyulamnya sebelum jatuh ke danau?
Dialog: 0,1:06:49.58,1:06:51.95,Default,HEIN,0,0,0,,Apakah saya memahaminya dengan benar?
Dialog: 0,1:06:51.95,1:06:52.98,Default,HEIN,0,0,0,,Ya.
Dialog: 0,1:06:53.02,1:06:54.22,Default,HEIN,0,0,0,,Dan saya tidak punya
Dialog: 0,1:06:54.28,1:06:56.65,Default,HEIN,0,0,0,,masalah tidur dan kehilangan nafsu makan?
Dialog: 0,1:06:56.82,1:06:59.29,Default,HEIN,0,0,0,,Ada. Dan kamu menghela nafas terus-menerus.
Dialog: 0,1:06:59.29,1:07:01.09,Default,HEINE,0,0,0,,Selalu terlihat tertekan.
Dialogue: 0,1:07:01.20,1:07:03.23,Default,HEIN,0,0,0,,Terkadang kamu mulai menangis tanpa alasan.
Dialog: 0,1:07:04.79,1:07:07.80,Default,HEIN,0,0,0,,Yang Mulia, jadi apakah Anda ingat semuanya?
Dialog: 0,1:07:08.03,1:07:09.20,Default,HEIN,0,0,0,,Tidak.
Dialog: 0,1:07:09.87,1:07:13.24,Default,HEIN,0,0,0,,Dan saya tidak memberikan barang-barang yang saya sayangi kepada siapa pun?
Dialog: 0,1:07:16.04,1:07:18.41,Default,HEIN,0,0,0,,Anda memberikannya kepada saya,
Dialog: 0,1:07:18.41,1:07:19.91,Default,HEIN,0,0,0,,meskipun mereka dulu sangat menghargainya.
Dialog: 0,1:07:20.11,1:07:21.21,Default,HEIN,0,0,0,,Dan
Dialog: 0,1:07:21.58,1:07:23.81,Default,HEIN,0,0,0,,memberi cincin pada Nyonya Choi.
Dialog: 0,1:07:27.18,1:07:28.35,Default,HEIN,0,0,0,,Cho Hwajin salah.
Dialogue: 0,1:07:28.88,1:07:31.72,Default,HAIN,0,0,0,,Kim So-yeon tidak mencoba memancingnya ke dalam jebakan.
Dialog: 0,1:07:32.42,1:07:33.69,Default,HEIN,0,0,0,,Dan saya ingin bunuh diri.
Dialogue: 0,1:07:37.06,1:07:38.26,Default,HEIN,0,0,0,,Bukankah ini Cheoljong?
Dialog: 0,1:07:38.46,1:07:40.46,Default,HEIN,0,0,0,,Raja Akan Datang!
Dialog: 0,1:07:40.96,1:07:43.00,Default,HEIN,0,0,0,,Bukankah dia mengatakan bahwa raja tidak boleh lari?
Dialogue: 0,1:07:43.43,1:07:46.07,Default,HEIN,0,0,0,,Hanya wajahnya yang membuat tekanan darahku meroket.
Dialog: 0,1:07:48.17,1:07:49.27,Default,HEIN,0,0,0,,Apa?
Dialog: 0,1:07:49.94,1:07:51.21,Default,HEIN,0,0,0,,Apakah kamu ingin berkelahi?
Dialogue: 0,1:07:52.84,1:07:54.04,Default,HEIN,0,0,0,,Haruskah kita menetap seperti laki-laki?
Dialog: 0,1:07:54.98,1:07:58.18,Default,HEIN,0,0,0,,Apakah itu saja? Apakah ini pilihanmu?
Dialog: 0,1:07:59.08,1:08:00.38,Default,HEIN,0,0,0,,Ada apa?
Dialog: 0,1:08:00.38,1:08:02.52,Default,HEIN,0,0,0,,Apakah kamu membodohi dirimu sendiri lagi?
Dialog: 0,1:08:03.69,1:08:06.59,Default,HEIN,0,0,0,,Apakah saya benar-benar tertipu oleh mata dan ucapan bohong Anda?
Dialog: 0,1:08:07.76,1:08:10.83,Default,HEIN,0,0,0,,Kaulah yang menipuku sepanjang waktu.
Dialog: 0,1:08:11.88,1:08:15.26,Default,HEIN,0,0,0,,Aku tidak tahu kalau kamulah yang mencoba membunuhku, aku bahkan tidur sekamar denganmu.
Dialog: 0,1:08:15.26,1:08:17.37,Default,HEIN,0,0,0,,Jadi, bukankah aku harus marah sekarang?
Dialog: 0,1:08:17.53,1:08:19.00,Default,HEIN,0,0,0,,Anda sendiri yang mengatakannya,
Dialog: 0,1:08:20.14,1:08:23.57,Default,HEIN,0,0,0,,bahwa hanya pengecut yang menyerang yang lebih lemah.
Dialog: 0,1:08:25.02,1:08:26.31,Default,HEIN,0,0,0,,Apakah kamu mencoba membalas dendam padaku?
Dialog: 0,1:08:27.44,1:08:30.05,Default,HEIN,0,0,0,,Dalam hal ini, saya juga tidak akan duduk diam
Dialog: 0,1:08:31.55,1:08:33.78,Default,HEIN,0,0,0,,dan tutup mata terhadap semua intrik Anda.
Dialog: 0,1:08:40.92,1:08:42.49,Default,HEIN,0,0,0,,Apa yang dia bicarakan?
Dialog: 0,1:09:00.81,1:09:01.88,Default,HEIN,0,0,0,,Apa?
Dialog: 0,1:09:15.12,1:09:16.73,Default,HEIN,0,0,0,,Apa yang harus saya lakukan
Dialog: 0,1:09:17.83,1:09:20.60,Default,HEIN,0,0,0,,dengan orang lemah bodoh ini?
Dialog: 0,1:09:43.72,1:09:45.05,Default,HAINE,0,0,0,,Ratu Janda.
Dialog: 0,1:09:45.40,1:09:47.16,Default,HEIN,0,0,0,,Jika Anda mencari seseorang untuk disalahkan atas apa yang terjadi,
Dialog: 0,1:09:47.16,1:09:48.62,Default,HEIN,0,0,0,,Saya siap menerima hukuman.
Dialog: 0,1:09:49.56,1:09:53.16,Default,HEIN,0,0,0,,Bisakah Anda menjelaskan siapa yang saya cari?
Dialog: 0,1:09:54.73,1:09:58.17,Default,HEIN,0,0,0,,Nyonya pelayanku, Ovol, telah menghilang.
Dialog: 0,1:09:58.77,1:10:00.07,Default,HEIN,0,0,0,,Apa yang harus saya lakukan dengan ini?
Dialogue: 0,1:10:01.00,1:10:02.24,Default,HEINE,0,0,0,,Menurutmu aku yang melakukan ini?
Dialog: 0,1:10:02.38,1:10:04.66,Default,HEIN,0,0,0,,Karena kamu membutuhkan sesuatu dariku.
Dialog: 0,1:10:07.04,1:10:10.75,Default,HEIN,0,0,0,,Dan saya siap menyuarakan apa yang benar-benar ingin Anda dengar.
Dialog: 0,1:10:12.85,1:10:14.95,Default,HEIN,0,0,0,,Kalau begitu mari kita dengarkan.
Dialog: 0,1:10:17.12,1:10:19.36,Default,HEIN,0,0,0,,Saat ratu jatuh ke danau,
Dialog: 0,1:10:19.99,1:10:21.59,Default,HEIN,0,0,0,,Saya ada di dekatnya.
Dialog: 0,1:10:23.99,1:10:25.49,Default,HEIN,0,0,0,,Suatu hari nanti kamu akan kalah
Dialog: 0,1:10:26.66,1:10:29.16,Default,HEIN,0,0,0,,orang tersayang.
Dialog: 0,1:10:47.85,1:10:50.29,Default,HEIN,0,0,0,,Untuk sesaat emosiku menguasai diriku,
Dialogue: 0,1:10:52.76,1:10:54.89,Default,HEIN,0,0,0,,dan aku mendorong ratu ke dalam danau.
Dialog: 0,1:11:04.62,1:11:07.04,Default,HEIN,0,0,0,,Biarkan saya bertanggung jawab\Natas apa yang terjadi.
Dialog: 0,1:11:07.24,1:11:10.14,Default,HEIN,0,0,0,,Tolong, kasihanilah mereka\Nyang tidak melakukan kesalahan apa pun.
Dialog: 0,1:11:12.07,1:11:15.88,Default,HEINE,0,0,0,,Saya dengan senang hati akan menerima hukuman apa pun\Natas perbuatan saya.
Dialog: 0,1:11:18.21,1:11:19.28,Default,HEIN,0,0,0,,Serius?
Dialog: 0,1:11:26.09,1:11:28.79,Default,HEIN,0,0,0,,Anda tahu isi surat ini.
Dialog: 0,1:11:30.19,1:11:32.90,Default,HAINE,0,0,0,,Anda menerimanya dari Ibu Suri.
Dialog: 0,1:11:34.73,1:11:37.17,Default,HEIN,0,0,0,,Ovol memberikannya kepada kami.
Dialog: 0,1:11:38.10,1:11:41.30,Default,HEIN,0,0,0,,Tempat, tanggal dan waktu yang tertera di dalamnya,
Dialog: 0,1:11:41.44,1:11:44.76,Default,HAINE,0,0,0,,bertepatan dengan kapan dan di mana\Nkecelakaan ratu terjadi.
Dialog: 0,1:11:45.14,1:11:47.58,Default,HEINE,0,0,0,,Menurut Anda apa artinya ini?
Dialog: 0,1:11:48.08,1:11:51.61,Default,HEIN,0,0,0,,Ini pertama kalinya aku melihatnya.
Dialog: 0,1:11:53.08,1:11:57.79,Default,HEIN,0,0,0,,Apakah Anda benar-benar berpikir bahwa Anda dapat menyembunyikan semuanya?
Dialog: 0,1:11:59.39,1:12:01.96,Default,HEIN,0,0,0,,Dan Anda mempunyai pendapat yang sangat tinggi tentang diri Anda sendiri.
Dialog: 0,1:12:02.96,1:12:05.49,Default,HEIN,0,0,0,,Kamu tahu kamu hanya bayangan.
Dialog: 0,1:12:10.17,1:12:11.93,Default,HAINE,0,0,0,,Ratu Janda.
Dialog: 0,1:12:12.37,1:12:15.77,Default,HEIN,0,0,0,,Saya jamin, surat ini palsu.
Dialog: 0,1:12:16.04,1:12:17.47,Default,HEIN,0,0,0,,Dan saya yakin sebaliknya.
Dialog: 0,1:12:17.97,1:12:19.88,Default,HEIN,0,0,0,,Karena mereka berasal dari keluarga Cho yang sama,
Dialog: 0,1:12:19.88,1:12:22.88,Default,HEIN,0,0,0,,tentu saja, mereka memutuskan untuk bersatu demi tujuan masing-masing.
Dialog: 0,1:12:22.88,1:12:26.68,Default,HAINE,0,0,0,,Ibu Suri\Ntidak pernah bersekongkol dengan siapa pun,
Dialog: 0,1:12:26.68,1:12:30.22,Default,HEIN,0,0,0,,meskipun mereka berasal dari keluarga yang sama.
Dialog: 0,1:12:31.15,1:12:36.06,Default,HEIN,0,0,0,,Lalu siapa yang memalsukan surat ini?
Dialog: 0,1:12:40.30,1:12:42.83,Default,HEIN,0,0,0,,Rupanya, Anda membutuhkan seseorang untuk mendukung
Dialog: 0,1:12:43.37,1:12:45.47,Default,HEIN,0,0,0,,rencana Anda.
Dialog: 0,1:12:50.97,1:12:53.08,Default,HEIN,0,0,0,,Raja ada di sini!
Dialog: 0,1:12:55.64,1:12:56.78,Default,HEIN,0,0,0,,Yang Mulia.
Dialog: 0,1:12:58.61,1:13:00.08,Default,HAINE,0,0,0,,Ratu Janda.
Dialog: 0,1:13:00.12,1:13:02.52,Default,HEIN,0,0,0,,Anda telah tiba. Besar.
Dialog: 0,1:13:02.89,1:13:05.02,Default,XO,0,0,0,,Selir kerajaan mengaku.
Dialog: 0,1:13:05.79,1:13:08.36,Default,XO,0,0,0,,Dia berkata bahwa dia mendorong ratu ke dalam danau dengan niat jahat.
Dialog: 0,1:13:10.86,1:13:12.80,Default,XO,0,0,0,,Ini semua bohong.
Dialog: 0,1:13:12.80,1:13:15.33,Default,XO,0,0,0,,Yang Mulia, sadarlah.
Dialogue: 0,1:13:17.77,1:13:20.14,Default,XO,0,0,0,,Aku tahu kamu tergila-gila padanya,
Dialog: 0,1:13:20.14,1:13:22.97,Default,XO,0,0,0,,tapi saya tidak bisa membiarkan Anda menilai,
Dialog: 0,1:13:22.97,1:13:24.81,Default,XO,0,0,0,,mengetahui bahwa Anda bias.
Dialog: 0,1:13:25.24,1:13:29.28,Default,XO,0,0,0,,Apakah Anda mencoba melindungi penjahat?
Dialog: 0,1:13:29.81,1:13:32.51,Default,XO,0,0,0,,Dia mencoba menyakiti ratu, istrimu.
Dialog: 0,1:13:34.18,1:13:35.98,Default,XO,0,0,0,,Katakan sendiri padanya!
Dialogue: 0,1:13:36.39,1:13:39.09,Default,XO,0,0,0,,Siapa yang mendorong ratu ke dalam danau?
Dialog: 0,1:13:51.03,1:13:52.23,Default,XO,0,0,0,,Itu aku.
Dialog: 0,1:13:52.70,1:13:53.77,Default,XO,0,0,0,,Hwajin.
Dialog: 0,1:13:58.11,1:13:59.27,Default,XO,0,0,0,,Apakah kamu dengar?
Dialog: 0,1:14:03.01,1:14:05.98,Default,XO,0,0,0,,Jika Anda bersikeras bahwa dia hanya menyalahkan orang lain,
Dialog: 0,1:14:06.28,1:14:09.02,Default,XO,0,0,0,,Saya akan memberi Anda kesempatan untuk membuktikannya.
Dialog: 0,1:14:11.15,1:14:12.45,Default,XO,0,0,0,,Masuk!
Dialog: 0,1:14:39.72,1:14:43.05,Default,XO,0,0,0,,Dia mengakui, apa yang akan kita lakukan sekarang?
Dialog: 0,1:14:43.19,1:14:46.36,Default,XO,0,0,0,,Dia akan dibutuhkan sebagai saksi, jagalah dia.
Dialog: 0,1:14:50.36,1:14:51.49,Default,XO,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:15:12.45,1:15:13.48,Default,XO,0,0,0,,Ambil!
Dialog: 0,1:15:35.74,1:15:38.57,Default,XO,0,0,0,,Jika kamu mengaku di sini
Dialog: 0,1:15:38.57,1:15:40.08,Default,XO,0,0,0,,dan setuju untuk dipenggal,
Dialog: 0,1:15:40.84,1:15:43.71,Default,XO,0,0,0,,Saya tidak akan meragukannya.
Dialog: 0,1:15:54.59,1:15:56.09,Default,XO,0,0,0,,Cheoljong mengatakan itu setiap malam
Dialogue: 0,1:15:56.09,1:15:57.69,Default,XO,0,0,0,,melihat kepalanya terpenggal.
Dialog: 0,1:15:59.03,1:16:00.50,Default,XO,0,0,0,,Dia jelas merasa tidak enak sekarang.
Dialog: 0,1:16:01.53,1:16:02.60,Default,XO,0,0,0,,Ini gagal.
Dialog: 0,1:16:18.25,1:16:19.85,Default,XO,0,0,0,,Saya akan mengungkapkan kebenaran!
Dialog: 0,1:16:21.25,1:16:24.12,Default,XO,0,0,0,,Saya akan menerima keinginan Anda, Yang Mulia!
Dialog: 0,1:16:25.75,1:16:27.92,Default,XO,0,0,0,,Bukan dia yang perlu dieksekusi!
Dialog: 0,1:16:34.93,1:16:36.00,Default,XO,0,0,0,,Yang Mulia!
Dialog: 0,1:16:38.53,1:16:39.60,Default,XO,0,0,0,,Saya mohon.
Dialog: 0,1:16:46.61,1:16:48.68,Default,XO,0,0,0,,Maukah kamu melawan kehendak raja?
Dialog: 0,1:17:23.41,1:17:25.01,Default,XO,0,0,0,,Choljong, bajingan.
Dialog: 0,1:17:26.25,1:17:27.42,Default,XO,0,0,0,,Dia keren.
Dialog: 0,1:17:31.99,1:17:33.66,Default,XO,0,0,0,,Dia berpura-pura menjadi pahlawan seperti apa?
Dialog: 0,1:17:37.89,1:17:38.93,Default,XO,0,0,0,,Tunggu sebentar.
Dialogue: 0,1:17:39.26,1:17:41.63,Default,XO,0,0,0,,Danau akan terisi hari ini.
Dialog: 0,1:17:42.06,1:17:43.30,Default,XO,0,0,0,,Jadi saya bisa kembali.
Dialog: 0,1:17:44.40,1:17:46.40,Default,XO,0,0,0,,Menyakiti ratu...
Dialog: 0,1:17:47.17,1:17:48.17,Default,XO,0,0,0,,Berhenti!
Dialog: 0,1:18:09.83,1:18:11.43,Default,XO,0,0,0,,Dewa!
Dialog: 0,1:18:13.50,1:18:14.66,Default,XO,0,0,0,,Ada apa?
Dialogue: 0,1:18:14.66,1:18:16.87,Default,XO,0,0,0,,Airnya habis.
Dialog: 0,1:18:17.50,1:18:18.53,Default,XO,0,0,0,,Apa?
Dialog: 0,1:18:21.44,1:18:22.60,Default,XO,0,0,0,,
Dialog: 0,1:18:23.00,1:18:24.91,Default,XO,0,0,0,,Kami mengambil banyak air,
Dialog: 0,1:18:24.91,1:18:26.74,Default,XO,0,0,0,,bahwa sumur telah mengering.
Dialog: 0,1:18:27.91,1:18:29.64,Default,XO,0,0,0,,Oh tidak!
Dialog: 0,1:18:31.11,1:18:33.55,Default,XO,0,0,0,,Saya selesai.
Dialog: 0,1:19:03.75,1:19:05.85,Default,XO,0,0,0,,Izinkan saya, sebagai korban kejadian ini,
Dialog: 0,1:19:05.88,1:19:07.62,Default,XO,0,0,0,,menjelaskan peristiwa tersebut.
Dialog: 0,1:19:13.72,1:19:15.02,Default,XO,0,0,0,,I
Dialog: 0,1:19:20.10,1:19:21.60,Default,XO,0,0,0,,mencoba bunuh diri.
Dialogue: 0,1:19:25.97,1:19:28.17,Default,XO,0,0,0,,Menurutmu hanya ada satu pria keren di sini?
Dialog: 0,1:19:28.60,1:19:30.44,Default,XO,0,0,0,,Saya pahlawan di sini.
Dialog: 0,1:19:37.25,1:19:39.15,Default,XO,0,0,0,,Saya kembali, jadi tidak masalah.
Dialog: 0,1:19:41.05,1:19:46.32,Default,XO,0,0,0,,Saya mohon, jangan sentuh mereka yang tidak bersalah atas apa pun.
Dialog: 0,1:19:52.29,1:19:53.43,Default,XO,0,0,0,,Luar Biasa.
Dialog: 0,1:20:32.40,1:20:34.97,Default,XO,0,0,0,,Pangeran Yeonpyeong memasuki istana bersama preman.
Dialog: 0,1:20:34.97,1:20:36.87,Default,XO,0,0,0,,Mereka tampaknya terlatih dengan baik.
Dialog: 0,1:20:36.87,1:20:39.47,Default,XO,0,0,0,,Masalah harus dipotong sampai ke akar-akarnya.
Dialog: 0,1:20:39.47,1:20:41.88,Default,XO,0,0,0,,Sumur telah mengering.
Dialog: 0,1:20:41.88,1:20:43.41,Default,XO,0,0,0,,Saya percaya bahwa saya harus melakukannya
Dialog: 0,1:20:43.41,1:20:45.65,Default,XO,0,0,0,,meninggalkanmu untuk membuatmu bahagia.
Dialogue: 0,1:20:45.65,1:20:47.32,Default,XO,0,0,0,,Penampilan berani itu!
Dialog: 0,1:20:47.32,1:20:49.32,Default,XO,0,0,0,,Beraninya dia?
Dialog: 0,1:20:49.32,1:20:51.75,Default,XO,0,0,0,,Kondisi ratu semakin buruk setiap hari.
Dialog: 0,1:20:51.75,1:20:53.39,Default,XO,0,0,0,,Mungkin patut ditanyakan
Dialog: 0,1:20:53.39,1:20:54.76,Default,XO,0,0,0,,gulingkan dia?
Dialog: 0,1:20:56.26,1:20:58.29,Default,XO,0,0,0,,Sekarang semuanya akan kembali ke tempatnya.


