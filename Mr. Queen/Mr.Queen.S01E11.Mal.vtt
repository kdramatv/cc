Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,bekerja,,0,0,0,,{\pos(801,256)}Bekerja pada siri:\N Lily, Tiramisu, Biryulka, Hos, Penyanyi, Februari
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.96,0:01:06.46,Lalai,Lily,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.46,0:01:08.66, Lalai, Lily,0,0,0,,dan acara yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:15.70,0:01:18.84,Lalai,Lily,0,0,0,,Mereka mengatakan anak panah tidak terbang lurus apabila anda cemas.
Dialog: 0,0:01:20.07,0:01:22.94,Lalai,Lily,0,0,0,,11 episod
Dialog: 0,0:01:34.39,0:01:37.26,Lalai,Lily,0,0,0,,Saya minta maaf kerana meminta mesyuarat lewat.
Dialog: 0,0:01:37.42,0:01:39.33,Lalai,Lily,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:01:39.66,0:01:41.09,Lalai,Lily,0,0,0,,Anda perlukan saya,
Dialog: 0,0:01:41.09,0:01:42.56, Lalai, Lily,0,0,0,, dan saya berterima kasih untuk itu.
Dialog: 0,0:01:43.70,0:01:46.73,Lalai,Lily,0,0,0,,Kalaulah ini mimpi.
Dialog: 0,0:01:47.73,0:01:51.57,Lalai,Lily,0,0,0,,Kalaulah semuanya hilang apabila saya bangun.
Dialog: 0,0:01:56.68,0:01:58.25,Lalai,Lily,0,0,0,,Saya ada sesuatu untuk awak.
Dialog: 0,0:02:14.03,0:02:15.76,Lalai,Lily,0,0,0,,Rahsia
Dialog: 0,0:02:33.08,0:02:37.15,Lalai,Lily,0,0,0,,Benamkan ratu dalam mimpi ngeri tempat saya tinggal.
Dialog: 0,0:02:48.46,0:02:49.70,Lalai,Lily,0,0,0,,Rajaku.
Dialog: 0,0:02:52.00,0:02:56.27,Lalai,Lily,0,0,0,,Malam tadi awak datang kepada saya dalam mimpi
Dialog: 0,0:02:56.97,0:03:00.51,Lalai,Lily,0,0,0,,dan kuasa besar jatuh ke tangan saya.
Dialog: 0,0:03:15.16,0:03:18.53,Lalai,Lily,0,0,0,,Kamus Ratu
Dialog: 0,0:03:24.50,0:03:26.40,Lalai,Lily,0,0,0,,Jarak sosial
Dialog: 0,0:03:30.17,0:03:32.84,Lalai,Lily,0,0,0,,menakjubkan, masa sihir, lapar untuk perhatian,
Dialog: 0,0:03:32.84,0:03:36.34,Default,Lily,0,0,0,,showdown, teh melati, kurang ajar
Dialog: 0,0:03:51.36,0:03:53.03,Lalai,Lily,0,0,0,,Cuties.
Dialog: 0,0:03:56.43,0:03:57.46,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:59.60,0:04:03.14,Lalai,Lily,0,0,0,,Hilang suara awak, panggil saya serak?
Dialog: 0,0:04:08.71,0:04:09.78,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:04:13.81,0:04:14.85,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:04:17.52,0:04:19.05,Lalai,Lily,0,0,0,,Adakah airnya cukup suam?
Dialog: 0,0:04:20.22,0:04:21.96,Lalai,Lily,0,0,0,,Adakah airnya cukup suam?
Dialog: 0,0:04:24.46,0:04:26.19,Lalai,Lily,0,0,0,,Saya sukakannya.
Dialog: 0,0:04:26.19,0:04:28.70,Lalai,Lily,0,0,0,,Kenapa awak terlupa di sini?
Dialog: 0,0:04:33.47,0:04:34.60,Lalai,Lily,0,0,0,,Permaisuriku.
Dialog: 0,0:04:37.74,0:04:38.97,Lalai,Lily,0,0,0,,Hari ini
Dialog: 0,0:04:40.34,0:04:42.18, Lalai, Lily,0,0,0,,tiada penjarakan sosial.
Dialog: 0,0:04:52.72,0:04:55.42,Lalai,Lily,0,0,0,,Yang Mulia, adakah anda sudah bangun?
Dialog: 0,0:04:59.66,0:05:00.69,Lalai,Lily,0,0,0,,Tuhan.
Dialog: 0,0:05:01.19,0:05:03.70,Lalai,Lily,0,0,0,,Mengapa awak kelihatan begitu menakutkan?
Dialog: 0,0:05:04.00,0:05:06.73,Lalai,Lily,0,0,0,,Beraninya awak merosakkan impian erotik saya?
Dialog: 0,0:05:07.93,0:05:09.37, Lalai, Lily,0,0,0,, Hubungi dia segera!
Dialog: 0,0:05:09.74,0:05:10.90,Lalai,Lily,0,0,0,,Baik.
Dialog: 0,0:05:11.81,0:05:12.97,Lalai,Lily,0,0,0,,Panggil...
Dialog: 0,0:05:15.58,0:05:16.71,Lalai,Lily,0,0,0,,Siapa yang patut kita hubungi?
Dialog: 0,0:05:27.05,0:05:28.49,Lalai,Lily,0,0,0,,Kamus Ratu
Dialog: 0,0:05:29.19,0:05:31.42,Lalai,Lily,0,0,0,,Anda berada dalam suasana yang baik, Yang Mulia.
Dialog: 0,0:05:32.86,0:05:35.13,Lalai,Lily,0,0,0,,Tidur sepanjang malam tanpa bangun.
Dialog: 0,0:05:36.33,0:05:38.63,Lalai,Lily,0,0,0,,Mula bersiap untuk kenduri.
Dialog: 0,0:05:39.87,0:05:40.93,Lalai,Lily,0,0,0,,Baik.
Dialog: 0,0:05:47.07,0:05:50.44, Lalai,Lily,0,0,0,,11 episod. Yang tidak boleh dimaafkan
Dialog: 0,0:05:51.55,0:05:52.61,Lalai,Lily,0,0,0,,Dr.
Dialog: 0,0:05:53.85,0:05:55.42,Lalai,Lily,0,0,0,,Saya mengalami mimpi ngeri.
Dialog: 0,0:05:55.85,0:05:57.95,Lalai,Lily,0,0,0,,Tetapi lebih teruk daripada mimpi ngeri ini,
Dialog: 0,0:05:57.95,0:05:59.49,Lalai,Lily,0,0,0,,bahawa saya tidak menyukainya
Dialog: 0,0:06:00.89,0:06:03.02, Lalai, Lily,0,0,0,,dan menyukainya pada masa yang sama.
Dialog: 0,0:06:03.39,0:06:06.29,Lalai,Lily,0,0,0,,Saya tidak tahu sama ada saya merasakannya atau badan saya.
Dialog: 0,0:06:07.16,0:06:10.53, Lalai, Lily,0,0,0,,Rasanya seperti saya disatukan.
Dialog: 0,0:06:11.43,0:06:12.50,Lalai,Lily,0,0,0,,Tepat sekali.
Dialog: 0,0:06:13.63,0:06:16.90, Lalai, Lily,0,0,0,,Ia seperti saya bertukar menjadi pembina Lego.
Dialog: 0,0:06:17.30,0:06:20.57,Lalai,Lily,0,0,0,,Siapa saya?
Dialog: 0,0:06:22.71,0:06:24.61,Lalai,Lily,0,0,0,,Tetapi kenapa
Dialog: 0,0:06:25.45,0:06:28.42, Lalai, Lily,0,0,0,, adakah anda memanggil saya "doktor"?
Dialog: 0,0:06:29.25,0:06:31.08, Lalai, Lily,0,0,0,, Awak mengganggu saya.
Dialog: 0,0:06:31.08,0:06:33.49, Lalai, Lily,0,0,0,, Dengar sahaja. Ini adalah dengan cara yang perlu.
Dialog: 0,0:06:37.19,0:06:40.16,Lalai,Lily,0,0,0,,Jadi apa pendapat pakar?
Dialog: 0,0:06:40.53,0:06:45.07,Lalai,Lily,0,0,0,,Perubahan dalam badan adalah kesan sampingan keadaan vegetatif.
Dialog: 0,0:06:46.33,0:06:47.40,Lalai,Lily,0,0,0,,Jadi adakah ini normal?
Dialog: 0,0:06:50.70,0:06:52.71, Lalai, Lily,0,0,0,,Tiada apa-apa yang luar biasa.
Dialog: 0,0:06:54.21,0:06:57.48,Lalai,Lily,0,0,0,,Agak menghiburkan, sebenarnya.
Dialog: 0,0:06:57.91,0:07:01.75,Lalai,Lily,0,0,0,,Pada kata-kata anda, kebimbangan mula hilang.
Dialog: 0,0:07:03.58,0:07:06.22,Lalai,Lily,0,0,0,,Dia yang menyembuhkan tanpa akupunktur -
Dialog: 0,0:07:06.52,0:07:08.25,Lalai,Lily,0,0,0,,penyembuh yang hebat.
Dialog: 0,0:07:09.16,0:07:10.19,Lalai,Lily,0,0,0,,Ternyata
Dialog: 0,0:07:10.92,0:07:14.13, Lalai, Lily,0,0,0,, doktor diraja dan pakar dalam psikologi.
Dialog: 0,0:07:15.56,0:07:19.17,Lalai,Lily,0,0,0,,Jadi bilakah keadaan saya bercampur dua muka
Dialog: 0,0:07:19.17,0:07:20.53,Lalai,Lily,0,0,0,,sudikah awak lepaskan saya?
Dialog: 0,0:07:20.77,0:07:23.27,Lalai,Lily,0,0,0,,Semua masalah berkaitan dengan hati anda.
Dialog: 0,0:07:23.40,0:07:26.67,Lalai,Lily,0,0,0,,Sebaik sahaja anda menerima ini, kebimbangan akan hilang.
Dialog: 0,0:07:26.67,0:07:29.81,Lalai,Lily,0,0,0,,Anda boleh mula hidup semula tanpa risau.
Dialog: 0,0:07:29.81,0:07:33.58, Lalai, Lily,0,0,0,, Patutkah saya menerima diri saya seadanya?
Dialog: 0,0:07:36.22,0:07:40.09,Lalai,Lily,0,0,0,,Muasabah. Satu-satunya perkara yang berterusan tentang saya ialah percanggahan saya.
Dialog: 0,0:07:41.22,0:07:42.26,Lalai,Lily,0,0,0,,By the way.
Dialog: 0,0:07:42.99,0:07:45.56,Lalai,Lily,0,0,0,,Herba untuk penutup kecantikan adalah hebat.
Dialog: 0,0:07:47.29,0:07:48.53,Lalai,Lily,0,0,0,,Gunakannya,
Dialog: 0,0:07:48.53,0:07:50.73, Lalai, Lily,0,0,0,,untuk mencipta produk muka.
Dialog: 0,0:07:51.50,0:07:53.20,Lalai,Lily,0,0,0,,Keanjalan, sinaran dan pencerahan.
Dialog: 0,0:07:53.20,0:07:55.57,Lalai,Lily,0,0,0,,Tujuan harus menarik perhatian.
Dialog: 0,0:07:55.57,0:07:57.60,Lalai,Lily,0,0,0,,Diperlukan setiap 28 hari, buat lebih.
Dialog: 0,0:07:58.74,0:08:01.17,Lalai,Lily,0,0,0,,Kenapa 28 hari?
Dialog: 0,0:08:01.17,0:08:02.48,Lalai,Lily,0,0,0,,Inilah berapa banyak kulit diperbaharui.
Dialog: 0,0:08:02.98,0:08:04.61, Lalai, Lily,0,0,0,,Apabila kulitnya menjadi keratin,
Dialog: 0,0:08:04.61,0:08:05.98, Lalai, Lily,0,0,0,, dia perlukan saya.
Dialog: 0,0:08:06.81,0:08:08.21,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:08:08.45,0:08:11.45,Lalai,Lily,0,0,0,,Mr. Youngjin telah datang kepada anda.
Dialog: 0,0:08:17.56,0:08:19.59,Lalai,Lily,0,0,0,,Adakah ini benar-benar pembantu rumah Hwajin?
Dialog: 0,0:08:19.89,0:08:21.80,Lalai,Lily,0,0,0,,Dia pastinya.
Dialog: 0,0:08:23.06,0:08:26.97,Lalai,Lilia,0,0,0,,Tetapi saya harap Ovol sendiri menjual noriga itu.
Dialog: 0,0:08:27.20,0:08:28.94,Lalai,Lilia,0,0,0,,Hwajin mungkin kecewa.
Dialog: 0,0:08:30.37,0:08:32.07,Lalai,Lily,0,0,0,,Kita perlu melawat dia.
Dialog: 0,0:08:34.37,0:08:37.34,Lalai,Lily,0,0,0,,Yang Mulia. Gundik utama meminta penonton.
Dialog: 0,0:08:37.38,0:08:38.51,Lalai,Lily,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:08:42.48,0:08:43.48,Lalai,Lily,0,0,0,,Gunting.
Dialog: 0,0:08:51.49,0:08:52.59,Lalai,Lily,0,0,0,,Maaf.
Dialog: 0,0:08:55.50,0:08:57.70,Lalai,Lily,0,0,0,,Saya melukis Ovol.
Dialog: 0,0:08:58.43,0:09:01.60,Lalai,Lily,0,0,0,,Begitulah saya mengingatinya.
Dialog: 0,0:09:01.97,0:09:03.07,Lalai,Lily,0,0,0,,Saya pasti,
Dialog: 0,0:09:03.94,0:09:05.77, Lalai, Lilia,0,0,0,,yang Ovol sendiri jual kepada noriga.
Dialog: 0,0:09:06.17,0:09:08.01, Lalai, Lily,0,0,0,, Dia tidak akan berakhir seperti itu di istana.
Dialog: 0,0:09:09.61,0:09:11.28,Lalai,Lily,0,0,0,,Anda boleh yakin dengan gambar itu.
Dialog: 0,0:09:16.05,0:09:17.32,Lalai,Lily,0,0,0,,Maafkan saya.
Dialog: 0,0:09:18.08,0:09:19.15,Lalai,Lily,0,0,0,,Sudah tentu.
Dialog: 0,0:09:26.66,0:09:28.16,Lalai,Lily,0,0,0,,Saya baru tahu.
Dialog: 0,0:09:29.03,0:09:31.46,Lalai,Lily,0,0,0,,Anda mengalami kesukaran malam tadi.
Dialog: 0,0:09:33.13,0:09:36.34,Lalai,Lily,0,0,0,,Saya menghabiskan sepanjang malam mengumpul fikiran saya, jangan risau.
Dialog: 0,0:09:39.77,0:09:41.88,Lalai,Lily,0,0,0,,Saya perlu memberitahu anda sesuatu.
Dialog: 0,0:09:45.04,0:09:47.68,Lalai,Lily,0,0,0,,Ini menyangkut perasaan anda terhadap permaisuri.
Dialog: 0,0:09:48.31,0:09:49.68,Lalai,Lily,0,0,0,,Lebih sukar untuk mengatasi diri sendiri,
Dialog: 0,0:09:50.45,0:09:53.72,Lalai,Lily,0,0,0,, daripada mengatasi orang lain. Oleh itu
Dialog: 0,0:09:55.02,0:09:56.56,Lalai,Lily,0,0,0,,menyerahkan perasaan anda.
Dialog: 0,0:09:58.06,0:10:01.69, Lalai, Lily,0,0,0,,Saya tidak perlukan permohonan maaf anda.
Dialog: 0,0:10:18.34,0:10:20.21,Lalai,Lily,0,0,0,,Adakah anda sihat?
Dialog: 0,0:10:21.65,0:10:23.25,Lalai,Lily,0,0,0,,Baru sehari saya kembali ke istana,
Dialog: 0,0:10:23.25,0:10:24.85,Lalai,Lily,0,0,0,,baiklah.
Dialog: 0,0:10:24.85,0:10:27.72,Lalai,Lily,0,0,0,,Namun, saya akan sibuk memilih gundik.
Dialog: 0,0:10:27.72,0:10:29.56,Lalai,Lily,0,0,0,,Pemilihan gundik.
Dialog: 0,0:10:33.43,0:10:36.90,Lalai,Lily,0,0,0,,Tiba di bilik saya,
Dialog: 0,0:10:37.50,0:10:40.13,Lalai,Lily,0,0,0,,adakah anda perasan sesuatu yang pelik?
Dialog: 0,0:10:41.67,0:10:43.67, Lalai, Lily,0,0,0,,Ada yang pelik?
Dialog: 0,0:10:44.54,0:10:47.31,Lalai,Lily,0,0,0,,Saya menyeret raja dari perigi, tetapi...
Dialog: 0,0:10:47.71,0:10:49.51,Lalai,Lily,0,0,0,,No. Adakah sesuatu berlaku?
Dialog: 0,0:10:50.68,0:10:51.85,Lalai,Lily,0,0,0,,Nah...
Dialog: 0,0:10:53.88,0:10:57.02,Lalai,Lily,0,0,0,,Kamu berdua melawat saya,
Dialog: 0,0:10:57.02,0:10:58.92,Lalai,Lily,0,0,0,,tanpa awak rumah nampak kosong.
Dialog: 0,0:10:58.92,0:11:00.95,Lalai,Lily,0,0,0,,Nampaknya inilah intinya.
Dialog: 0,0:11:02.19,0:11:04.02,Lalai,Lily,0,0,0,,Adakah anda akan melihat Baginda?
Dialog: 0,0:11:04.22,0:11:06.36,Lalai,Lily,0,0,0,,Isih antara anda sendiri.
Dialog: 0,0:11:06.36,0:11:07.46,Lalai,Lily,0,0,0,,Tidak berbaloi.
Dialog: 0,0:11:08.33,0:11:10.16,Default,Lily,0,0,0,,Saya rasa dia sedang sibuk menyiapkan jamuan.
Dialog: 0,0:11:10.16,0:11:13.37,Lalai,Lily,0,0,0,,Yang Mulia, saya bawa\N sepucuk surat ke rumah pengantin perempuan.
Dialog: 0,0:11:13.60,0:11:16.24,Lalai,Lily,0,0,0,,Anda perlu menguruskan perniagaan. saya akan pergi.
Dialog: 0,0:11:25.61,0:11:26.68,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:11:27.95,0:11:30.15,Lalai,Lily,0,0,0,,Walaupun terdapat 100 gundik,
Dialog: 0,0:11:31.48,0:11:33.09,Lalai,Lily,0,0,0,,mereka tidak akan berani
Dialog: 0,0:11:34.65,0:11:37.06, Lalai, Lily,0,0,0,, ambil tempat permaisuri.
Dialog: 0,0:11:37.66,0:11:39.59,Lalai,Lily,0,0,0,,Ya. Sudah tentu.
Dialog: 0,0:11:40.73,0:11:42.70,Lalai,Lily,0,0,0,,Sila jaga diri anda.
Dialog: 0,0:11:45.27,0:11:46.90,Lalai,Lily,0,0,0,,Selamat tinggal.
Dialog: 0,0:11:54.71,0:11:56.74,Lalai,Lily,0,0,0,,Han Siok
Dialog: 0,0:11:59.35,0:12:00.51,Lalai,Lily,0,0,0,,Buang keluarga Khan.
Dialog: 0,0:12:00.81,0:12:02.52,Lalai,Lily,0,0,0,,Kita boleh melakukannya tanpa Romeo dan Juliet.
Dialog: 0,0:12:02.95,0:12:05.39,Lalai,Lily,0,0,0,,Adakah anda membawa silsilah keluarga Han?
Dialog: 0,0:12:07.99,0:12:09.36,Lalai,Lily,0,0,0,,Han dari Pyeongsan.
Dialog: 0,0:12:11.56,0:12:12.99,Lalai,Lily,0,0,0,,Khan dari Hanyang.
Dialog: 0,0:12:13.46,0:12:14.76,Lalai,Lily,0,0,0,,Han dari Anbyon.
Dialog: 0,0:12:15.16,0:12:17.56,Lalai,Lily,0,0,0,,-Khan dari Yangju.\N-Tunggu.
Dialog: 0,0:12:18.70,0:12:21.43,Lalai,Lily,0,0,0,,Adakah ini semua keturunan keluarga Han?
Dialog: 0,0:12:22.70,0:12:24.00,Lalai,Lily,0,0,0,,Ya, Tuanku.
Dialog: 0,0:12:24.10,0:12:26.61,Lalai,Lily,0,0,0,,Sial, terdapat banyak daripada mereka.
Dialog: 0,0:12:28.61,0:12:32.58, Lalai, Lily,0,0,0,,Ini tidak akan berfungsi. Saya perlu mendapatkan bantuannya.
Dialog: 0,0:12:34.41,0:12:37.12, Lalai, Lily,0,0,0,, Jurujual Perjalanan. Saya perlukan perkara yang sama.
Dialog: 0,0:12:37.82,0:12:40.45,Lalai,Lily,0,0,0,,-Jurujual.\N-Jualan rumah.
Dialog: 0,0:12:44.19,0:12:46.09,Lalai,Lily,0,0,0,,Adakah sudah waktu makan tengah hari?
Dialog: 0,0:12:47.59,0:12:51.90,Lalai,Lily,0,0,0,,Masa untuk memanjakan kulit anda.
Dialog: 0,0:13:03.14,0:13:04.51,Lalai,Lily,0,0,0,,Anda mempesonakan.
Dialog: 0,0:13:05.71,0:13:09.32,Lalai,Lily,0,0,0,,Hanya cahaya yang tidak wajar.
Dialog: 0,0:13:09.48,0:13:13.12,Lalai,Lily,0,0,0,,Terima kasih kepada anda, hari saya dipenuhi dengan penjagaan diri.
Dialog: 0,0:13:13.39,0:13:15.86,Lalai,Lily,0,0,0,,Saya terlupa tentang pemilihan gundik.
Dialog: 0,0:13:16.92,0:13:18.49,Lalai,Lily,0,0,0,,Bagaimana anda menghadapinya?
Dialog: 0,0:13:19.06,0:13:21.43,Lalai,Lily,0,0,0,,Saya cuba yang terbaik.
Dialog: 0,0:13:21.43,0:13:24.40,Lalai,Lily,0,0,0,,Sudah tentu. Berbakat dalam satu perkara, berbakat dalam segala-galanya.
Dialog: 0,0:13:24.40,0:13:27.20,Lalai,Lily,0,0,0,,Anda melakukannya dengan baik,
Dialog: 0,0:13:27.20,0:13:28.97,Lalai,Lily,0,0,0,,saya percayakan awak.
Dialog: 0,0:13:30.97,0:13:32.57,Lalai,Lily,0,0,0,,Ada sesuatu yang saya
Dialog: 0,0:13:32.57,0:13:35.48,Lalai,Lily,0,0,0,,menyediakannya khas untuk anda.
Dialog: 0,0:13:37.71,0:13:39.51,Lalai,Lily,0,0,0,,Jika anda serbuk rambut anda dengan ini,
Dialog: 0,0:13:39.51,0:13:41.28,Lalai,Lily,0,0,0,,anda akan kelihatan 10 tahun lebih muda.
Dialog: 0,0:13:41.65,0:13:43.05,Lalai,Lily,0,0,0,,Serbuk rambut.
Dialog: 0,0:13:45.28,0:13:49.22,Lalai,Lily,0,0,0,,Tidak perlu menggunakan jus mulberi
Dialog: 0,0:13:49.22,0:13:51.26,Lalai,Lily,0,0,0,,di kepala saya setiap pagi.
Dialog: 0,0:13:52.16,0:13:53.83,Lalai,Lily,0,0,0,,Wah.
Dialog: 0,0:13:55.60,0:13:58.23, Lalai, Lily,0,0,0,, Serbuk perlahan-lahan.
Dialog: 0,0:13:58.33,0:13:59.93, Lalai, Lily,0,0,0,, Serbuk.
Dialog: 0,0:14:04.27,0:14:05.91,Lalai,Kedua,0,0,0,,Ini adalah orang yang berbeza sama sekali.
Dialog: 0,0:14:06.61,0:14:10.31, Lalai, Kedua, 0,0,0,, Dia mempunyai mata yang lebih senget.
Dialog: 0,0:14:10.61,0:14:12.98,Lalai,Kedua,0,0,0,,Atau mungkin hanya mata kiri yang juling?
Dialog: 0,0:14:12.98,0:14:15.38, Lalai, Kedua, 0,0,0,, Betapa saya lapar.
Dialog: 0,0:14:21.65,0:14:23.12, Lalai, Kedua, 0,0,0,, Cemerlang.
Dialog: 0,0:14:24.32,0:14:27.43,Lalai,Kedua,0,0,0,,Muka kurus dengan pipi tembam.
Dialog: 0,0:14:27.83,0:14:29.50,Lalai,Kedua,0,0,0,,Dengan dahi lebar
Dialog: 0,0:14:29.60,0:14:31.26, Lalai, Kedua, 0,0,0,, dan mata yang bersinar.
Dialog: 0,0:14:31.36,0:14:32.97,Lalai,Kedua,0,0,0,,Sesuatu seperti itu.
Dialog: 0,0:14:33.10,0:14:35.47, Lalai, Kedua, 0,0,0,, Muncung lurus dengan hujung bulat.
Dialog: 0,0:15:12.97,0:15:15.91,Lalai,Kedua,0,0,0,,Tuanku, tukang masak diraja telah tiba.
Dialog: 0,0:15:17.68,0:15:20.28,Lalai,Kedua,0,0,0,,Saya rasa minuman keras calamus akan berkesan. Apa pendapat anda?
Dialog: 0,0:15:20.75,0:15:21.81,Lalai,Kedua,0,0,0,,Apa?
Dialog: 0,0:15:22.18,0:15:25.49,Lalai,Kedua,0,0,0,,Saya terlalu terbawa-bawa dengan fikiran saya.
Dialog: 0,0:15:25.79,0:15:27.95,Lalai,Kedua,0,0,0,,Saya sedang memikirkan tentang minuman keras yang hendak dipilih untuk hari raya.
Dialog: 0,0:15:29.69,0:15:33.99,Lalai,Kedua,0,0,0,,Yang Mulia, saya telah menyediakan sesuatu di sini.
Dialog: 0,0:15:43.04,0:15:45.00,Lalai,Kedua,0,0,0,,Saya layak mati.
Dialog: 0,0:16:01.65,0:16:02.86, Lalai, Kedua, 0,0,0,, Bersantai.
Dialog: 0,0:16:03.59,0:16:05.29,Lalai,Kedua,0,0,0,,Kemudian semuanya akan berjalan lancar.
Dialog: 0,0:16:06.56,0:16:07.99,Lalai,Kedua,0,0,0,,Seperti yang anda katakan.
Dialog: 0,0:16:13.93,0:16:16.07,Lalai,Kedua,0,0,0,,Adakah anda selesa? Kemudian tonton.
Dialog: 0,0:16:17.40,0:16:18.64,Lalai,Kedua,0,0,0,,Apa?
Dialog: 0,0:16:21.01,0:16:23.21,Lalai,Kedua,0,0,0,,Ini ialah rancangan jamuan tradisional.
Dialog: 0,0:16:23.68,0:16:25.91,Lalai,Kedua,0,0,0,,Saya mahu menukarnya sedikit.
Dialog: 0,0:16:26.28,0:16:30.05,Lalai,Kedua,0,0,0,,Saya ingin mengurangkan bilangan hidangan dan mengeluarkan
Dialog: 0,0:16:30.05,0:16:32.59,Lalai,Kedua,0,0,0,,meja besar yang tidak diperlukan dengan makanan di tengahnya.
Dialog: 0,0:16:32.99,0:16:34.89,Lalai,Kedua,0,0,0,,-Maafkan saya, raja.\N-Ya?
Dialog: 0,0:16:35.39,0:16:37.86,Lalai,Kedua,0,0,0,,Pesta diraja
Dialog: 0,0:16:37.86,0:16:40.66,Lalai,Kedua,0,0,0,,hendaklah megah dan mewah.
Dialog: 0,0:16:40.66,0:16:42.43,Lalai,Kedua,0,0,0,,Tidak kira betapa tidak perlu...
Dialog: 0,0:16:43.80,0:16:45.06,Lalai,Kedua,0,0,0,,Adakah anda hilang akal?
Dialog: 0,0:16:49.47,0:16:51.90,Lalai,Kedua,0,0,0,,Umat saya menderita kelaparan.
Dialog: 0,0:16:52.21,0:16:54.07,Lalai,Kedua,0,0,0,,Adakah saya akan menterjemah makanan untuk keseronokan?
Dialog: 0,0:16:54.27,0:16:56.58,Lalai,Kedua,0,0,0,,Kemudian makanan yang akan kami sediakan,
Dialog: 0,0:16:57.68,0:17:00.48,Lalai,Yang kedua,0,0,0,,kami akan berikan kepada yang kelaparan di luar istana.
Dialog: 0,0:17:04.28,0:17:06.29,Lalai,Kedua,0,0,0,,Sederhana, tetapi tidak kedekut.
Dialog: 0,0:17:06.85,0:17:09.62,Lalai,Kedua,0,0,0,,Elok, tetapi tidak berlagak.
Dialog: 0,0:17:09.99,0:17:11.52,Lalai,Kedua,0,0,0,,Saya mahu jamuan sebegitu.
Dialog: 0,0:17:16.63,0:17:20.83,Lalai,Kedua,0,0,0,,Saya akan melakukan yang terbaik dalam 2 minggu akan datang.
Dialog: 0,0:17:24.60,0:17:25.67,Lalai,Kedua,0,0,0,,Saya harap kita boleh bekerjasama.
Dialog: 0,0:17:32.14,0:17:33.18,Lalai,Kedua,0,0,0,,Yang Mulia.
Dialog: 0,0:17:38.12,0:17:40.39,Lalai,Kedua,0,0,0,,Adakah begitu mudah untuk membuat lelaki menangis?
Dialog: 0,0:17:48.43,0:17:50.76,Lalai,Kedua,0,0,0,,Saya tidak percaya,
Dialog: 0,0:17:50.76,0:17:53.07,Lalai,Kedua,0,0,0,,perakaunan sedemikian terperinci tentang sumber rasuah.
Dialog: 0,0:17:54.63,0:17:57.94,Lalai,Kedua,0,0,0,,Ayah permaisuri lebih teliti daripada yang saya sangka.
Dialog: 0,0:17:58.37,0:18:02.34,Lalai,Kedua,0,0,0,,Musuh gundik diraja Cho\N bukanlah puak Kim, tetapi permaisuri.
Dialog: 0,0:18:04.08,0:18:06.48, Lalai, Kedua, 0,0,0,, Jadi dia tidak dapat melihat gambaran besarnya.
Dialog: 0,0:18:15.39,0:18:19.19,Lalai,Kedua,0,0,0,,Kita mesti mengurus lejar dengan betul.
Dialog: 0,0:18:19.19,0:18:21.66,Lalai,Kedua,0,0,0,,Dan kemudian kita akan memusnahkan keluarga Kim
Dialog: 0,0:18:22.09,0:18:25.06,Lalai,Kedua,0,0,0,,dan kami akan menggulingkan permaisuri daripada takhta.
Dialog: 0,0:18:31.27,0:18:32.41,Lalai,Kedua,0,0,0,,Buku akaun?
Dialog: 0,0:18:33.91,0:18:36.51,Lalai,Kedua,0,0,0,,Apa yang dia fikirkan? Bagaimana dia boleh menyimpan sesuatu yang begitu berbahaya?
Dialog: 0,0:18:36.51,0:18:37.68,Lalai,Kedua,0,0,0,,Saya mesti...
Dialog: 0,0:18:40.78,0:18:42.38,Lalai,Kedua,0,0,0,,Rahsiakan perkara ini buat masa ini.
Dialog: 0,0:18:42.38,0:18:44.38,Lalai,Kedua,0,0,0,,Jika orang lain dalam keluarga mengetahuinya, mereka akan membuat kekecohan.
Dialog: 0,0:18:44.38,0:18:47.15,Lalai,Kedua,0,0,0,,Macam mana. Bodoh betul.
Dialog: 0,0:18:48.79,0:18:49.89,Lalai,Kedua,0,0,0,,Namun,
Dialog: 0,0:18:50.99,0:18:52.83,Lalai,Kedua,0,0,0,,Anda fikir siapa yang mempunyai buku itu?
Dialog: 0,0:18:52.83,0:18:55.49,Lalai,Kedua,0,0,0,,Raja menghabiskan 2 hari di rumahnya,
Dialog: 0,0:18:55.49,0:18:57.66,Lalai,Kedua,0,0,0,,dia tidak mengendahkan permintaan untuk kembali ke istana.
Dialog: 0,0:18:57.66,0:18:58.70,Lalai,Kedua,0,0,0,,Jadi,
Dialog: 0,0:19:00.30,0:19:01.33, Lalai, Kedua, 0,0,0,, raja?
Dialog: 0,0:19:03.20,0:19:06.61,Lalai,Kedua,0,0,0,,Dia mahu mendedahkan kita semasa hari raya pada Hari Kereta.
Dialog: 0,0:19:07.01,0:19:08.91,Lalai,Kedua,0,0,0,,Mungkin senjata itu ada di tangannya,
Dialog: 0,0:19:09.81,0:19:12.88,Lalai,Kedua,0,0,0,,tetapi kita mesti melemahkannya supaya ia tidak mengambil kesempatan daripadanya.
Dialog: 0,0:19:14.45,0:19:15.75,Lalai,Kedua,0,0,0,,Kim Moon-geun berfikir,
Dialog: 0,0:19:16.75,0:19:19.55,Lalai,Kedua,0,0,0,,bahawa saya adalah satu-satunya suspek yang tinggal.
Dialog: 0,0:19:19.55,0:19:22.15,Lalai,Kedua,0,0,0,,Tetapi dia tidak boleh bertanya kepada raja jika dia mencuri buku itu.
Dialog: 0,0:19:22.52,0:19:23.76,Lalai,Kedua,0,0,0,,Mesti sukar untuknya.
Dialog: 0,0:19:24.59,0:19:27.36,Lalai,Kedua,0,0,0,,Adakah kita sudah mengetahui siapa yang bersembunyi di sebalik topeng?
Dialog: 0,0:19:27.36,0:19:28.83,Lalai,Kedua,0,0,0,,Di Jabatan Detektif
Dialog: 0,0:19:28.83,0:19:30.70,Lalai,Kedua,0,0,0,,tiada sesiapa yang mempunyai parut di pipi mereka.
Dialog: 0,0:19:31.50,0:19:33.87,Lalai,Kedua,0,0,0,,Walaupun kami tidak menerima lejar,
Dialog: 0,0:19:34.37,0:19:37.37,Lalai,Kedua,0,0,0,,kita mesti menyediakan konspirasi untuk mencapai matlamat kita.
Dialog: 0,0:19:38.30,0:19:40.84,Lalai,Kedua,0,0,0,,Adakah anda telah mengkaji kedudukan genera lain?
Dialog: 0,0:19:51.88,0:19:53.32,Lalai,Kedua,0,0,0,,Hukum Lima Saat.
Dialog: 0,0:19:53.82,0:19:56.59,Lalai,Kedua,0,0,0,,Lima saat sudah cukup untuk jatuh cinta.
Dialog: 0,0:19:59.13,0:20:01.59,Lalai,Kedua,0,0,0,,Yang Mulia, semua orang ada di sini.
Dialog: 0,0:20:01.59,0:20:03.13,Lalai,Kedua,0,0,0,,-Itu sahaja?\N-Ya.
Dialog: 0,0:20:08.40,0:20:09.50,Lalai,Kedua,0,0,0,,Selamat berkenalan.
Dialog: 0,0:20:11.00,0:20:12.04,Lalai,Kedua,0,0,0,,Selamat berkenalan.
Dialog: 0,0:20:12.71,0:20:17.08,Lalai,Kedua,0,0,0,,Selamat berkenalan.
Dialog: 0,0:20:17.81,0:20:19.11,Lalai,Kedua,0,0,0,,Mari kita lihat.
Dialog: 0,0:20:19.11,0:20:21.48,Lalai,Kedua,0,0,0,,Percikan api melompat antara saya dan...
Dialog: 0,0:20:29.66,0:20:30.86,Lalai,Kedua,0,0,0,,Saya juga menyukai yang ini.
Dialog: 0,0:20:36.66,0:20:41.60,Lalai,Kedua,0,0,0,,Cik Yun, anda sangat cantik, mungkin beritahu kami lebih lanjut tentang diri anda?
Dialog: 0,0:20:43.50,0:20:47.71,Lalai,Kedua,0,0,0,,Terdapat sebuah gunung yang indah di kampung halaman saya.
Dialog: 0,0:20:48.17,0:20:50.01, Lalai, Kedua, 0,0,0,, Dipanggil Gunung Kamaksan.
Dialog: 0,0:20:50.21,0:20:52.38,Lalai,Kedua,0,0,0,,-Kamaksan?\N-Ya, ratu.
Dialog: 0,0:20:54.51,0:20:56.12, Lalai, Kedua, 0,0,0,, Cukup menakjubkan.
Dialog: 0,0:20:56.12,0:20:57.22,Lalai,Kedua,0,0,0,,-Hebat?\N-Hebat?
Dialog: 0,0:20:59.59,0:21:00.65,Lalai,Kedua,0,0,0,,-Yang Mulia.\N-Ya?
Dialog: 0,0:21:00.65,0:21:03.59,Lalai,Kedua,0,0,0,,Terdapat sebuah istana besar di bandar saya.
Dialog: 0,0:21:03.59,0:21:05.76,Lalai,Kedua,0,0,0,,Ia dibina oleh Raja Jeongjo.
Dialog: 0,0:21:05.76,0:21:08.29,Lalai,Kedua,0,0,0,,Anda hanya boleh bermegah tentang Istana Hwaseong?
Dialog: 0,0:21:09.83,0:21:12.13,Lalai,Kedua,0,0,0,,Cuma bercakap tentang dia.
Dialog: 0,0:21:12.63,0:21:15.07,Lalai,Kedua,0,0,0,,Anda boleh bermegah tentang satu perkara lagi,
Dialog: 0,0:21:15.07,0:21:17.90,Lalai,Kedua,0,0,0,,jika anda menjadi gundik, Puan Hong.
Dialog: 0,0:21:19.17,0:21:21.07, Lalai, Kedua, 0,0,0,, Ratu, terima kasih!
Dialog: 0,0:21:23.98,0:21:27.18,Lalai,Kedua,0,0,0,,Di kampung halaman saya terdapat seluruh ladang pokok pic.
Dialog: 0,0:21:27.18,0:21:29.38,Lalai,Kedua,0,0,0,,Semasa tempoh berbunga
Dialog: 0,0:21:30.12,0:21:31.75,Lalai,Kedua,0,0,0,,tiada tempat yang lebih indah.
Dialog: 0,0:21:33.89,0:21:36.62,Lalai,Kedua,0,0,0,,Ibu saya mengimpikan buah pic semasa saya dilahirkan.
Dialog: 0,0:21:37.12,0:21:39.06,Lalai,Kedua,0,0,0,,Tidak menghairankan.
Dialog: 0,0:21:39.06,0:21:41.23,Lalai,Kedua,0,0,0,,Jika anda boleh membandingkan seseorang dengan pic,
Dialog: 0,0:21:41.59,0:21:44.60,Lalai,Kedua,0,0,0,,jadi hanya awak, Puan Min.
Dialog: 0,0:21:46.73,0:21:48.63, Lalai, Kedua, 0,0,0,, Pic saya.
Dialog: 0,0:21:49.24,0:21:52.40,Lalai,Kedua,0,0,0,,Jika anda memenangi tiga jenis ini di pihak anda,
Dialog: 0,0:21:53.81,0:21:57.78,Lalai,Kedua,0,0,0,,maka akan ada seekor naga dan dua burung phoenix di sebelah anda.
Dialog: 0,0:21:59.18,0:22:01.21,Lalai,Kedua,0,0,0,,Dan kemudian anda boleh menakluki harimau putih.
Dialog: 0,0:22:08.29,0:22:10.49,Lalai,Kedua,0,0,0,,Sementara Istana Hwaseong menjaga pintu pagar,
Dialog: 0,0:22:11.62,0:22:13.86,Lalai,Kedua,0,0,0,,landskap Gunung Camaksan menggembirakan mata saya,
Dialog: 0,0:22:14.56,0:22:19.23,Lalai,Kedua,0,0,0,,dan aroma manis pic memenuhi ruang saya.
Dialog: 0,0:22:37.12,0:22:39.99, Lalai, Kedua, 0,0,0,, Puak Phapyeong Yun. Puak Namyan Hon.
Dialog: 0,0:22:40.55,0:22:41.79,Lalai,Kedua,0,0,0,,Puak John Min.
Dialog: 0,0:22:42.19,0:22:44.06,Lalai,Kedua,0,0,0,,Imbangan kuasa yang sangat baik.
Dialog: 0,0:22:46.83,0:22:50.06,Lalai,Kedua,0,0,0,,Tidak bersalah, seksi dan manis.
Dialog: 0,0:22:50.50,0:22:51.93,Lalai,Kedua,0,0,0,,Keharmonian sebenar.
Dialog: 0,0:22:58.84,0:23:00.67,Lalai,Kedua,0,0,0,,Yun Gyonok daripada keluarga Phapyeong Yun.
Dialog: 0,0:23:01.44,0:23:03.21,Lalai,Kedua,0,0,0,,Min Jayon daripada puak Yohyn Min.
Dialog: 0,0:23:03.94,0:23:06.01,Lalai,Kedua,0,0,0,,Khon Simkhyan daripada keluarga Namyang Khon.
Dialog: 0,0:23:06.75,0:23:10.18,Lalai,Kedua,0,0,0,,Saya melantik kamu sebagai gundik pangkat kedua.
Dialog: 0,0:23:13.82,0:23:18.09,Lalai,Kedua,0,0,0,,Tiga gundik ini dan keluarga mereka menyertai keluarga diraja.
Dialog: 0,0:23:18.66,0:23:21.33,Lalai,Kedua,0,0,0,,Beritahu keluarga anda
Dialog: 0,0:23:21.33,0:23:23.93,Lalai,Kedua,0,0,0,,jemputan ke jamuan pada Hari Troli.
Dialog: 0,0:23:24.40,0:23:27.50,Lalai,Kedua,0,0,0,,-Terima kasih, Yang Mulia.\N-Terima kasih, Yang Mulia.
Dialog: 0,0:23:32.74,0:23:34.27,Lalai,Kedua,0,0,0,,Nah, akhirnya.
Dialog: 0,0:23:35.07,0:23:37.74,Lalai,Kedua,0,0,0,,Raja mula mengumpulkan sekutu di sekelilingnya.
Dialog: 0,0:23:38.28,0:23:40.45,Lalai,Kedua,0,0,0,,Tetapi mereka akan memutuskan semua hubungan dengannya,
Dialog: 0,0:23:40.45,0:23:42.62, Lalai, Kedua, 0,0,0,, sebaik sahaja mereka mengetahui betapa lemahnya dia.
Dialog: 0,0:23:44.68,0:23:48.62,Lalai,Kedua,0,0,0,,Raja berkeras mahu mengadakan jamuan.
Dialog: 0,0:23:48.89,0:23:50.16,Lalai,Kedua,0,0,0,,Adakah ini yang dia mahukan?
Dialog: 0,0:23:51.42,0:23:54.33,Lalai,Kedua,0,0,0,,-Saya harap anda sedang bersedia.\N-Jangan risau.
Dialog: 0,0:24:04.20,0:24:05.24,Lalai,Kedua,0,0,0,,Lagi!
Dialog: 0,0:24:08.74,0:24:11.28, Lalai, Kedua, 0,0,0,,Semua orang mungkin terdesak ingin tahu apa yang ada di sebalik dinding.
Dialog: 0,0:24:12.88,0:24:15.38,Lalai,Kedua,0,0,0,,Mereka melakukannya dengan baik.
Dialog: 0,0:24:16.58,0:24:17.88,Lalai,Kedua,0,0,0,,Ibu Permaisuri akan datang.
Dialog: 0,0:24:22.05,0:24:24.79,Lalai,Kedua,0,0,0,,Semoga anda sihat, Ibu Permaisuri.
Dialog: 0,0:24:27.29,0:24:29.63,Lalai,Kedua,0,0,0,,Lama tidak berjumpa, gundik diraja Cho.
Dialog: 0,0:24:30.96,0:24:33.43,Lalai,Ketiga,0,0,0,,Salam, Yang Mulia.
Dialog: 0,0:24:36.14,0:24:39.10,Lalai,Ketiga,0,0,0,,Jika awak benarkan saya, saya akan tinggalkan awak, saya mahu berlatih menembak.
Dialog: 0,0:24:48.45,0:24:49.52,Lalai,Ketiga,0,0,0,,Anda telah berada di sini untuk masa yang lama
Dialog: 0,0:24:49.52,0:24:51.22,Lalai,Ketiga,0,0,0,,dia sedar selepas sakit.
Dialog: 0,0:24:51.22,0:24:53.19,Lalai,Ketiga,0,0,0,,Tetapi dia tidak pernah melawat saya.
Dialog: 0,0:24:54.89,0:24:56.36,Lalai,Ketiga,0,0,0,,Saya sibuk memilih pasangan
Dialog: 0,0:24:56.36,0:24:57.79,Lalai,Ketiga,0,0,0,,untuk Baginda.
Dialog: 0,0:24:58.79,0:25:00.46,Lalai,Ketiga,0,0,0,,Maafkan saya.
Dialog: 0,0:25:01.06,0:25:04.70,Lalai,Ketiga,0,0,0,,Bagi seseorang yang telah menghadapi kematian, anda sangat segar.
Dialog: 0,0:25:06.20,0:25:08.30,Lalai,Ketiga,0,0,0,,Saya tidak pernah merungut tentang kesihatan saya.
Dialog: 0,0:25:09.97,0:25:12.62, Lalai, Ketiga, 0,0,0,, Jadi anda berputus asa,\Anda tidak akan memburu pada Hari Troli?
Dialog: 0,0:25:13.04,0:25:15.31, Lalai, Ketiga, 0,0,0,, Daripada berlatih dengan busur
Dialog: 0,0:25:15.47,0:25:17.28,Lalai,Ketiga,0,0,0,,anda berseronok di sini.
Dialog: 0,0:25:17.28,0:25:19.28, Lalai, Ketiga, 0,0,0,, Permaisuri Diraja Cho akan menang juga.
Dialog: 0,0:25:19.28,0:25:21.41,Lalai,Ketiga,0,0,0,,Saya memutuskan untuk menikmati percutian itu.
Dialog: 0,0:25:22.25,0:25:24.35,Lalai,Ketiga,0,0,0,,Mungkin saya pandai mengintai "mangsa"
Dialog: 0,0:25:24.35,0:25:26.39,Lalai,Ketiga,0,0,0,,tetapi memburu bukan perkara saya.
Dialog: 0,0:25:27.32,0:25:28.49,Lalai,Ketiga,0,0,0,,Penganiayaan?
Dialog: 0,0:25:28.49,0:25:29.96,Lalai,Ketiga,0,0,0,,Anda tahu,
Dialog: 0,0:25:29.96,0:25:33.03,Lalai,Ketiga,0,0,0,,mengapa gadis muda di halaman mengambil bahagian dalam pemburuan
Dialog: 0,0:25:33.03,0:25:34.63, Lalai, Ketiga, 0,0,0,, pada Hari Troli?
Dialog: 0,0:25:35.63,0:25:37.96,Lalai,Ketiga,0,0,0,,Tidak, tidak juga.
Dialog: 0,0:25:42.00,0:25:45.64,Lalai,Ketiga,0,0,0,,Pada hari ini kita menghalau roh jahat.
Dialog: 0,0:25:46.17,0:25:47.91,Lalai,Ketiga,0,0,0,,Sebelum ini, roh jahat telah diusir
Dialog: 0,0:25:47.91,0:25:49.61,Lalai,Ketiga,0,0,0,,darah orang yang terbunuh.
Dialog: 0,0:25:50.11,0:25:53.48, Lalai, Ketiga, 0,0,0,, Tetapi sebaliknya kami memburu haiwan.
Dialog: 0,0:26:02.52,0:26:06.13,Lalai,Ketiga,0,0,0,,Sebenarnya, sebuah mayat ditemui di dalam perigi istana.
Dialog: 0,0:26:06.73,0:26:08.84,Lalai,Ketiga,0,0,0,,Dikatakan bahawa wanita mahkamah ini \Melayani Gundik Cho.
Dialog: 0,0:26:09.53,0:26:10.63, Lalai, Ketiga, 0,0,0,, Dalam perigi?
Dialog: 0,0:26:12.36,0:26:13.90,Lalai,Ketiga,0,0,0,,Bagaimana?
Dialog: 0,0:26:15.33,0:26:16.37,Lalai,Ketiga,0,0,0,,Yang Mulia.
Dialog: 0,0:26:16.37,0:26:18.20,Lalai,Ketiga,0,0,0,,-Datang kepada kami.\N-Datang kepada kami.
Dialog: 0,0:26:18.67,0:26:19.91,Lalai,Ketiga,0,0,0,,Okey.
Dialog: 0,0:26:26.75,0:26:29.11, Lalai, Ketiga, 0,0,0,,-Wah.\N-Sungguh luar biasa.
Dialog: 0,0:26:29.58,0:26:31.95,Lalai,Ketiga,0,0,0,,Yang Mulia ialah seorang tuan.
Dialog: 0,0:26:35.02,0:26:36.32, Lalai, Ketiga, 0,0,0,, Tiga Axel.
Dialog: 0,0:26:49.51,0:26:52.41, Lalai, Ketiga,0,0,0,,Saya tidak boleh tidur dan berbolak-balik.
Dialog: 0,0:26:55.88,0:26:58.09,Lalai,Ketiga,0,0,0,,Mungkin saya patut menulis mesej kepada gundik yang saya sayangi?
Dialog: 0,0:27:01.39,0:27:03.13,Lalai,Ketiga,0,0,0,,Apa yang perlu saya tulis?
Dialog: 0,0:27:04.06,0:27:08.13,Lalai,Ketiga,0,0,0,,Permulaan yang mudah tidak mewajibkan anda melakukan apa-apa, tetapi membangkitkan emosi.
Dialog: 0,0:27:09.40,0:27:10.47,Lalai,Ketiga,0,0,0,,Tepat sekali.
Dialog: 0,0:27:32.19,0:27:34.12, Lalai, Ketiga, 0,0,0,, Sampaikan kepada mereka.
Dialog: 0,0:27:34.72,0:27:35.76,Lalai,Ketiga,0,0,0,,Ya.
Dialog: 0,0:27:36.39,0:27:37.39,Lalai,Ketiga,0,0,0,,Tunggu sebentar.
Dialog: 0,0:27:38.06,0:27:40.76,Lalai,Ketiga,0,0,0,,Perintah untuk menjaga mata anda untuk melihat jika raja akan muncul.
Dialog: 0,0:27:41.50,0:27:42.53,Lalai,Ketiga,0,0,0,,Ya.
Dialog: 0,0:27:47.14,0:27:49.14,Lalai,Ketiga,0,0,0,,Satu mesej untuk setiap pasangan.
Dialog: 0,0:27:49.14,0:27:50.97, Lalai, Ketiga,0,0,0,,-Dan periksa di mana raja itu.\N-Dan periksa di mana raja itu.
Dialog: 0,0:27:50.97,0:27:52.71,Lalai,Ketiga,0,0,0,,Satu mesej untuk pasangan.
Dialog: 0,0:27:52.71,0:27:54.14, Lalai, Ketiga,0,0,0,,Dan periksa di mana raja berada.
Dialog: 0,0:27:59.25,0:28:00.38, Lalai, Ketiga, 0,0,0,, Kepada anda.
Dialog: 0,0:28:03.05,0:28:04.59,Lalai,Ketiga,0,0,0,,Masuk.
Dialog: 0,0:28:05.42,0:28:07.22,Lalai,Ketiga,0,0,0,,Satu mesej untuk raja.
Dialog: 0,0:28:07.22,0:28:08.99,Lalai,Ketiga,0,0,0,,Dan semak di mana pasangan itu berada.
Dialog: 0,0:28:08.99,0:28:10.06,Lalai,Ketiga,0,0,0,,Apa?
Dialog: 0,0:28:10.06,0:28:12.06, Lalai, Ketiga,0,0,0,,-Satu mesej untuk raja.\N-Sesuatu telah berubah.
Dialog: 0,0:28:12.06,0:28:13.86,Lalai,Ketiga,0,0,0,,Dan periksa di mana pasangan itu berada.
Dialog: 0,0:28:19.13,0:28:20.44, Lalai, Ketiga,0,0,0, "Adakah anda tidur?"
Dialog: 0,0:28:21.17,0:28:22.30,Lalai,Ketiga,0,0,0,,Adakah anda sedang tidur?
Dialog: 0,0:28:24.14,0:28:25.21,Lalai,Ketiga,0,0,0,,Nah...
Dialog: 0,0:28:29.01,0:28:30.05, Lalai, Ketiga, 0,0,0, "Adakah anda tidur?"
Dialog: 0,0:28:36.22,0:28:37.32, Lalai, Ketiga,0,0,0, "Adakah anda tidur?"
Dialog: 0,0:28:40.89,0:28:44.43, Lalai, Ketiga,0,0,0,,Mengapa dia begitu berminat sama ada saya sedang tidur atau tidak?
Dialog: 0,0:28:45.33,0:28:46.93,Lalai,Ketiga,0,0,0,,Saya bertanya tiga kali.
Dialog: 0,0:28:53.34,0:28:54.80,Lalai,Ketiga,0,0,0,,Jawapan telah tiba.
Dialog: 0,0:28:55.64,0:28:58.64,Lalai,Ketiga,0,0,0,,Saya hantar 3, kenapa hanya ada satu jawapan?
Dialog: 0,0:29:00.41,0:29:02.64,Lalai,Ketiga,0,0,0,,Adakah mereka menulis novel untuk saya di sana?
Dialog: 0,0:29:06.95,0:29:09.38,Lalai,Ketiga,0,0,0,,Nah, mari kita lihat.
Dialog: 0,0:29:11.29,0:29:14.39, Lalai, Ketiga, 0,0,0,, Sungguh indah tulisan tangan.\NTItulah ertinya menjadi daripada keluarga yang baik.
Dialog: 0,0:29:17.03,0:29:19.66,Lalai,Ketiga,0,0,0,,Pada malam tanpa tidur saya berjalan.
Dialog: 0,0:29:20.93,0:29:24.07,Lalai,Ketiga,0,0,0,,Cahaya menembusi langit malam yang gelap.
Dialog: 0,0:29:25.03,0:29:28.74,Lalai,Ketiga,0,0,0,,Saya angkat kepala - mungkin ini bulan?\NO, ini kawan sayang saya.
Dialog: 0,0:29:30.74,0:29:32.91,Lalai,Ketiga,0,0,0,,Aib Sepanyol.\Ntapi ia menyentuh jiwa.
Dialog: 0,0:29:33.64,0:29:35.64,Lalai,Ketiga,0,0,0,,Kita mesti juga...
Dialog: 0,0:30:00.54,0:30:02.30,Lalai,Ketiga,0,0,0,,-Yang Mulia.\N-Ya, Tuanku.
Dialog: 0,0:30:03.54,0:30:05.87,Lalai,Ketiga,0,0,0,,Inilah jawapannya. Sampaikan kepada pengirim surat itu.
Dialog: 0,0:30:06.48,0:30:09.11,Lalai,Ketiga,0,0,0,,Saya memikirkan banyak perkara.
Dialog: 0,0:30:09.11,0:30:11.21,Lalai,Ketiga,0,0,0,,Dengan hati yang gembira saya tenggelam dalam fikiran tentang awak.
Dialog: 0,0:30:11.21,0:30:13.92,Lalai,Ketiga,0,0,0,,Sila, berbaris dengan saya.
Dialog: 0,0:30:14.52,0:30:18.99,Lalai,Ketiga,0,0,0,,Saya tidak melepaskan fikiran tentang anda.
Dialog: 0,0:30:21.86,0:30:22.96, Lalai, Ketiga, 0,0,0,, Permaisuriku.
Dialog: 0,0:30:28.23,0:30:30.47, Lalai, Ketiga, 0,0,0,, Jadi pengetahuan dari kursus pengenalan berguna.
Dialog: 0,0:30:30.93,0:30:34.00,Lalai,Ketiga,0,0,0,,Bagus, begitulah cara saya akan mengembalikan kejantanan saya.
Dialog: 0,0:30:36.14,0:30:37.21,Lalai,Ketiga,0,0,0,,Baik.
Dialog: 0,0:31:25.95,0:31:27.39,Lalai,Ketiga,0,0,0,,Ikut resipi yang sama,
Dialog: 0,0:31:27.89,0:31:29.73,Lalai,Ketiga,0,0,0,,tetapi lebih baik gantikan croaker
Dialog: 0,0:31:31.16,0:31:32.23, Lalai, Ketiga, 0,0,0,, untuk ikan bream.
Dialog: 0,0:31:32.23,0:31:33.23,Lalai,Ketiga,0,0,0,,
Dialog: 0,0:31:35.26,0:31:38.23, Lalai, Ketiga,0,0,0,, Dapatkan inspirasi untuk puisi dan surat anda?
Dialog: 0,0:31:38.90,0:31:40.04, Lalai, Ketiga, 0,0,0,, Permaisuriku.
Dialog: 0,0:31:40.60,0:31:41.70,Lalai,Ketiga,0,0,0,,Sial.
Dialog: 0,0:31:42.07,0:31:43.14,Lalai,Ketiga,0,0,0,,Ratu.
Dialog: 0,0:31:43.81,0:31:45.64, Lalai, Ketiga, 0,0,0,, Anda! Saya dah cakap awak tak boleh datang sini.
Dialog: 0,0:31:46.14,0:31:47.24,Lalai,Ketiga,0,0,0,,Tetapi...
Dialog: 0,0:31:47.38,0:31:48.74,Lalai,Ketiga,0,0,0,,Saya berlakon seperti kami pasangan,
Dialog: 0,0:31:48.74,0:31:50.65, Lalai, Ketiga, 0,0,0,, kerana ia adalah acara rasmi.
Dialog: 0,0:31:50.65,0:31:53.02,Lalai,Ketiga,0,0,0,,Bagi saya sekarang adalah sangat penting untuk mencari diri saya semula.
Dialog: 0,0:31:53.02,0:31:54.12,Lalai,Ketiga,0,0,0,,Sila jangan campur.
Dialog: 0,0:31:54.62,0:31:55.62,Lalai,Ketiga,0,0,0,,Kasar.
Dialog: 0,0:31:55.62,0:31:56.65,Lalai,Ketiga,0,0,0,,Apa itu.
Dialog: 0,0:31:58.49,0:32:00.22,Lalai,Ketiga,0,0,0,,Bagaimana dia boleh berubah seperti itu?
Dialog: 0,0:32:02.62,0:32:04.73, Lalai, Ketiga, 0,0,0,, Permaisuri lebih pemalu daripada yang kelihatan.
Dialog: 0,0:32:09.90,0:32:11.80,Lalai,Ketiga,0,0,0,,Senarai hidangan untuk majlis sudah siap.
Dialog: 0,0:32:12.67,0:32:13.77,Lalai,Ketiga,0,0,0,,Bagus.
Dialog: 0,0:32:15.77,0:32:18.57,Lalai,Ketiga,0,0,0,,Sudahkah anda menyemak senarai persembahan untuk majlis itu?
Dialog: 0,0:32:18.94,0:32:20.48,Lalai,Ketiga,0,0,0,,Berikut ialah senarainya.
Dialog: 0,0:32:20.48,0:32:22.41,Lalai,Ketiga,0,0,0,,Mengapa mereka semua menyebut "bone-on"?
Dialog: 0,0:32:23.71,0:32:26.95,Lalai,Ketiga,0,0,0,,Senarai hidangan ialah menu.
Dialog: 0,0:32:27.18,0:32:30.29,Lalai,Ketiga,0,0,0,,Senarai persembahan ialah senarai perkara untuk upacara itu.
Dialog: 0,0:32:30.85,0:32:32.15,Lalai,Ketiga,0,0,0,,Ada apa dengan Tuanku?
Dialog: 0,0:32:32.25,0:32:34.39,Lalai,Ketiga,0,0,0,,Betulkah? Jadi adakah saya seorang pekak pekak?
Dialog: 0,0:32:37.56,0:32:39.29,Lalai,Ketiga,0,0,0,,Yang Mulia!
Dialog: 0,0:32:43.30,0:32:45.27,Lalai,Ketiga,0,0,0,,Anda bekerja sangat.
Dialog: 0,0:32:45.27,0:32:47.87,Lalai,Ketiga,0,0,0,,Pergi berehat, Tuanku.
Dialog: 0,0:32:48.64,0:32:49.77,Lalai,Ketiga,0,0,0,,No.
Dialog: 0,0:32:50.71,0:32:52.27,Lalai,Ketiga,0,0,0,,Tiada masa. Jom sambung.
Dialog: 0,0:32:54.48,0:32:55.74,Lalai,Ketiga,0,0,0,,Saya hampir berasa kasihan kepadanya.
Dialog: 0,0:32:56.81,0:32:58.91,Lalai,Ketiga,0,0,0,,Bukan maksudnya. Hari ini saya akan menulis surat dengan lebih marah.
Dialog: 0,0:32:59.55,0:33:01.02,Lalai,Ketiga,0,0,0,,Boner ialah perkataan berbahaya menurut Freud.
Dialog: 0,0:33:01.02,0:33:03.15,Lalai,Ketiga,0,0,0,,Darah hidungnya jelas bukan kerana kerja.
Dialog: 0,0:33:07.32,0:33:09.96,Lalai,Ketiga,0,0,0,,Dengan nama awak di bibir saya saya akan mati!
Dialog: 0,0:33:10.29,0:33:13.33,Lalai,Ketiga,0,0,0,,Ia akan kekal dalam ingatan saya - jangan lupakannya.
Dialog: 0,0:33:15.00,0:33:17.07,Lalai,Ketiga,0,0,0,,Bagaimana dia boleh menjadi satu malam dan satu lagi pada siang hari?
Dialog: 0,0:33:17.73,0:33:20.34,Lalai,Ketiga,0,0,0,,Tidak dapat memutuskan sama ada untuk memaafkan saya
Dialog: 0,0:33:20.34,0:33:21.90, Lalai, Ketiga, 0,0,0,, atau tidak?
Dialog: 0,0:33:30.65,0:33:33.15,Lalai,Ketiga,0,0,0,,Saya tidak minta maaf atas patah hati saya.
Dialog: 0,0:33:33.85,0:33:36.32,Lalai,Ketiga,0,0,0,,Adakah ada jalan di mana kita boleh berjalan bersama?
Dialog: 0,0:33:44.63,0:33:48.20,Lalai,Ketiga,0,0,0,,Saya harap lain kali kita\Nakan mengikutinya dari awal lagi.
Dialog: 0,0:33:48.63,0:33:51.20,Lalai,Ketiga,0,0,0,,Walaupun dalam mimpi.
Dialog: 0,0:34:06.48,0:34:08.22,Lalai,Ketiga,0,0,0,,Berlatih dengan pedang pada waktu malam?
Dialog: 0,0:34:08.45,0:34:10.32,Lalai,Ketiga,0,0,0,,Seorang yang tidak normal sudah cukup untuk kita.
Dialog: 0,0:34:10.32,0:34:12.65,Lalai,Ketiga,0,0,0,,Kita perlu bersedia untuk pertempuran untuk percutian.
Dialog: 0,0:34:13.12,0:34:14.96,Lalai,Ketiga,0,0,0,,Nah, kemudian berlatih dengan seseorang dari Syskny.
Dialog: 0,0:34:17.49,0:34:20.60,Lalai,Ketiga,0,0,0,,Bagaimanakah anda menilai kemahiran pedang anda?
Dialog: 0,0:34:20.80,0:34:21.96,Lalai,Ketiga,0,0,0,,Saya tidak tahu.
Dialog: 0,0:34:22.10,0:34:24.27,Lalai,Ketiga,0,0,0,,Saya tidak pernah memberikan segalanya.
Dialog: 0,0:34:25.80,0:34:27.50,Lalai,Ketiga,0,0,0,,Itulah sebabnya saya perlukan awak.
Dialog: 0,0:34:28.34,0:34:30.17,Lalai,Ketiga,0,0,0,,Musuh yang kekuatannya tidak saya ketahui.
Dialog: 0,0:35:04.34,0:35:07.34,Lalai,Ketiga,0,0,0,,Hari Troli
Dialog: 0,0:35:07.44,0:35:08.94, Lalai, Ketiga, 0,0,0,, Panjang umur dan semoga berjaya
Dialog: 0,0:35:14.68,0:35:17.72,Lalai,Ketiga,0,0,0,,
Dialog: 0,0:35:29.83,0:35:31.53,Lalai,Ketiga,0,0,0,,Cuaca baik, Tuanku.
Dialog: 0,0:35:31.53,0:35:32.97,Lalai,Ketiga,0,0,0,,Betulkah? Ini bagus.
Dialog: 0,0:35:32.97,0:35:35.43,Lalai,Ketiga,0,0,0,,Saya benci apabila hujan pada hari-hari perlawanan sukan.
Dialog: 0,0:35:38.24,0:35:41.11,Lalai,Keempat,0,0,0,,Ayah saya akan datang. Oleh itu, anda perlu menjadi lebih bergaya.
Dialog: 0,0:35:41.28,0:35:44.05,Lalai,Keempat,0,0,0,,Ini adalah hari pertama saya akan muncul di hadapan semua orang.
Dialog: 0,0:35:44.05,0:35:45.48,Lalai,Keempat,0,0,0,,Beri perhatian lebih.
Dialog: 0,0:35:49.22,0:35:50.92,Lalai,Keempat,0,0,0,,Ya. saya cantik.
Dialog: 0,0:35:52.02,0:35:53.42,Lalai,Keempat,0,0,0,,Semua orang akan merenung saya, bukan?
Dialog: 0,0:36:06.27,0:36:09.24,Lalai,Keempat,0,0,0,,Adakah anda akan menggunakan \Npetua logam?
Dialog: 0,0:36:10.41,0:36:11.54,Lalai,Keempat,0,0,0,,Hari ini saya perlukan
Dialog: 0,0:36:15.48,0:36:16.88,Lalai,Keempat,0,0,0,,tangkap haiwan besar.
Dialog: 0,0:36:20.25,0:36:22.25,Lalai,Keempat,0,0,0,,Baiklah, kami perlu menyampaikannya dengan cepat.
Dialog: 0,0:36:22.25,0:36:23.65, Lalai, Keempat,0,0,0,, Beralih.
Dialog: 0,0:36:26.02,0:36:27.42,Lalai,Keempat,0,0,0,,Helo, tuan.
Dialog: 0,0:36:27.62,0:36:31.09,Lalai,Keempat,0,0,0,,Kami mempunyai makanan segar untuk jamuan sempena Hari Troli
Dialog: 0,0:36:31.09,0:36:32.96, Lalai, Keempat, 0,0,0,, dan persembahan diraja.
Dialog: 0,0:36:33.13,0:36:36.03,Lalai,Keempat,0,0,0,,Kita perlu cepat ke istana. Maaf.
Dialog: 0,0:36:36.53,0:36:38.90,Lalai,Keempat,0,0,0,,-Adakah anda mempunyai dokumen untuk mereka?\N-Sudah tentu.
Dialog: 0,0:36:39.73,0:36:40.84,Lalai,Keempat,0,0,0,,Di sini.
Dialog: 0,0:37:17.01,0:37:18.81,Lalai,Keempat,0,0,0,,Masa untuk menukar pakaian, Tuanku.
Dialog: 0,0:37:19.71,0:37:20.71,Lalai,Keempat,0,0,0,,Tunggu sebentar.
Dialog: 0,0:37:22.14,0:37:24.05,Lalai,Keempat,0,0,0,,Hari ini ialah hari yang sangat penting.
Dialog: 0,0:37:24.78,0:37:28.42,Lalai,Keempat,0,0,0,,Sekurang-kurangnya kita harus cuba meramalkan nasib orang-orang ini.
Dialog: 0,0:37:30.89,0:37:35.09,Lalai,Keempat,0,0,0,,Nah, mari kita lihat. Peta untuk puak Cho.
Dialog: 0,0:37:44.97,0:37:46.20,Lalai,Keempat,0,0,0,,Thojang ialah kad terendah dalam permainan Thujong.
Dialog: 0,0:37:46.20,0:37:47.60,Lalai,Keempat,0,0,0,,Kad Arnab.
Dialog: 0,0:37:53.34,0:37:57.01,Lalai,Keempat,0,0,0,,Nah, nasib adalah sesuatu yang relatif.
Dialog: 0,0:37:58.31,0:38:02.58,Lalai,Keempat,0,0,0,,Ayuh. Kad untuk raja kita.
Dialog: 0,0:38:09.36,0:38:10.43,Lalai,Keempat,0,0,0,,Apa?
Dialog: 0,0:38:17.37,0:38:19.93,Lalai,Keempat,0,0,0,,"Injeong." Kad kesembilan.
Dialog: 0,0:38:20.44,0:38:21.74, Lalai, Keempat,0,0,0,,Adakah semuanya akan bertukar sebaliknya?
Dialog: 0,0:38:26.07,0:38:27.71,Lalai,Keempat,0,0,0,,Dan kini kad untuk permaisuri.
Dialog: 0,0:38:36.58,0:38:37.75,Lalai,Keempat,0,0,0,,Naga?
Dialog: 0,0:38:39.49,0:38:41.49,Lalai,Keempat,0,0,0,,Ojan, kad kelapan.
Dialog: 0,0:38:44.76,0:38:47.43,Lalai,Keempat,0,0,0,,Saya benci ramalan nasib saya hari ini.
Dialog: 0,0:38:54.20,0:38:55.94,Lalai,Keempat,0,0,0,,Ratu
Dialog: 0,0:38:56.87,0:39:01.14,Lalai,Keempat,0,0,0,,sehingga sesuatu lagi?
Dialog: 0,0:39:02.98,0:39:04.65,Lalai,Keempat,0,0,0,,Ibu Permaisuri telah tiba.
Dialog: 0,0:39:05.15,0:39:08.32,Lalai,Keempat,0,0,0,,Anda boleh memaklumkan kami terlebih dahulu bahawa anda akan melawat.
Dialog: 0,0:39:08.32,0:39:11.05,Lalai,Keempat,0,0,0,,Anda tidak menyembunyikan rasa tidak suka kepada saya.
Dialog: 0,0:39:11.52,0:39:14.09,Lalai,Keempat,0,0,0,,Semasa saya menjadi ratu,\Tingkah laku sebegitu tidak pernah didengari.
Dialog: 0,0:39:14.52,0:39:15.66,Lalai,Keempat,0,0,0,,Tidak kira zaman
Dialog: 0,0:39:15.66,0:39:18.63,Lalai,Keempat,0,0,0,,tiada menantu perempuan mahu dikejutkan oleh ibu mertuanya.
Dialog: 0,0:39:18.63,0:39:20.93,Lalai,Keempat,0,0,0,,Nah, lihat dia, dia membentak saya.
Dialog: 0,0:39:23.06,0:39:27.14,Lalai,Keempat,0,0,0,,Saya dengar awak sedang memasak untuk Ratu Janda.
Dialog: 0,0:39:27.74,0:39:31.54,Lalai,Keempat,0,0,0,,Dan dia tidak pernah menawarkan saya snek.
Dialog: 0,0:39:32.24,0:39:33.51,Lalai,Keempat,0,0,0,,Anda mesti takut
Dialog: 0,0:39:33.51,0:39:36.41,Lalai,Keempat,0,0,0,,nenek suami saya lebih besar daripada saya.
Dialog: 0,0:39:37.11,0:39:39.18,Lalai,Keempat,0,0,0,,Apa yang kamu katakan, ini tidak begitu.
Dialog: 0,0:39:39.18,0:39:42.42,Lalai,Keempat,0,0,0,,Janda Permaisuri menjaga dirinya dengan sangat baik,
Dialog: 0,0:39:42.42,0:39:43.72,Lalai,Keempat,0,0,0,,jadi dia nampak muda.
Dialog: 0,0:39:44.19,0:39:46.39,Lalai,Keempat,0,0,0,,Anda tidak boleh menipu masa.
Dialog: 0,0:39:47.79,0:39:49.46,Lalai,Keempat,0,0,0,,Anda perlu berfikir dengan teliti.
Dialog: 0,0:39:49.89,0:39:52.99,Lalai,Keempat,0,0,0,,Saya akan hidup lebih lama daripada Ratu Janda.
Dialog: 0,0:39:56.66,0:39:58.47,Lalai,Keempat,0,0,0,,Saya akan menghidangkan makanan saya kepada anda suatu hari nanti.
Dialog: 0,0:39:58.47,0:40:00.07,Lalai,Keempat,0,0,0,,Saya patut mencubanya sekarang.
Dialog: 0,0:40:00.90,0:40:04.87,Lalai,Keempat,0,0,0,,Saya sangat ingin tahu tentang masakan anda,\N yang hanya saya dengar.
Dialog: 0,0:40:04.87,0:40:07.04,Lalai,Keempat,0,0,0,,Tiada kekuatan untuk menunggu.
Dialog: 0,0:40:08.24,0:40:10.81,Lalai,Keempat,0,0,0,,Sekarang?
Dialog: 0,0:40:11.71,0:40:14.65,Lalai,Keempat,0,0,0,,Jadi penganiayaan saya oleh ibu mertua saya bermula?
Dialog: 0,0:40:29.50,0:40:31.37, Lalai, Keempat, 0,0,0,, Sial, ini menjengkelkan.
Dialog: 0,0:40:35.87,0:40:39.41,Lalai,Keempat,0,0,0,,Di mana dia bersembunyi?
Dialog: 0,0:40:42.51,0:40:44.11, Lalai, Keempat,0,0,0,, Chef Diraja. Saya perlukan sirap jagung.
Dialog: 0,0:40:44.11,0:40:47.28,Lalai,Keempat,0,0,0,,Dan apakah yang perlu saya lakukan dengan jamuan tanpa makanan segar?
Dialog: 0,0:40:47.68,0:40:50.62,Lalai,Keempat,0,0,0,,Semua pengawal berhampiran troli telah mati.
Dialog: 0,0:40:50.62,0:40:51.75,Lalai,Keempat,0,0,0,,Apa yang boleh saya lakukan?
Dialog: 0,0:40:51.75,0:40:54.19,Lalai,Keempat,0,0,0,,Ya Tuhanku. Ayuh.
Dialog: 0,0:40:55.62,0:40:57.83,Lalai,Keempat,0,0,0,,-Ikan kering.\N-Apa?
Dialog: 0,0:40:58.23,0:41:01.16,Lalai,Keempat,0,0,0,,Ikan kering. Ikan kering!
Dialog: 0,0:41:03.80,0:41:06.07,Lalai,Keempat,0,0,0,,Chef diraja terlalu sibuk.
Dialog: 0,0:41:06.47,0:41:08.10,Lalai,Keempat,0,0,0,,Saya tidak boleh perintah dia.
Dialog: 0,0:41:10.54,0:41:12.57,Lalai,Keempat,0,0,0,,Di manakah sirap bijirin?
Dialog: 0,0:41:29.79,0:41:32.23,Lalai,Keempat,0,0,0,,Pada malam tanpa tidur saya berjalan.
Dialog: 0,0:41:32.83,0:41:34.50,Lalai,Keempat,0,0,0,,"Pada malam tanpa tidur saya berjalan"
Dialog: 0,0:41:34.90,0:41:37.53,Lalai,Keempat,0,0,0,,Chef Diraja! Chef Diraja!
Dialog: 0,0:41:37.53,0:41:39.80,Lalai,Keempat,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:41:39.80,0:41:41.00,Lalai,Keempat,0,0,0,,Apa yang berlaku?
Dialog: 0,0:41:42.94,0:41:44.01,Lalai,Keempat,0,0,0,,Yang Mulia.
Dialog: 0,0:41:57.52,0:42:02.42,Lalai,Keempat,0,0,0,,Ini adalah produk yang berharga. Semua orang busuk!
Dialog: 0,0:42:02.66,0:42:04.63,Lalai,Keempat,0,0,0,,Ia mungkin disimpan dengan salah.
Dialog: 0,0:42:05.03,0:42:08.30,Lalai,Keempat,0,0,0,,Saya layak mati, Tuanku.
Dialog: 0,0:42:09.20,0:42:10.50, Lalai, Keempat, 0,0,0,, Ini tidak boleh.
Dialog: 0,0:42:11.23,0:42:14.64,Lalai,Keempat,0,0,0,,Tiada siapa yang akan memusnahkan mereka,\N jika keselamatan mereka telah dipastikan.
Dialog: 0,0:42:17.51,0:42:18.54,Lalai,Keempat,0,0,0,,Chef Diraja!
Dialog: 0,0:42:19.51,0:42:20.51,Lalai,Keempat,0,0,0,,Yang Mulia.
Dialog: 0,0:42:21.14,0:42:22.18,Lalai,Keempat,0,0,0,,Kami menghadapi masalah.
Dialog: 0,0:42:22.18,0:42:24.28,Lalai,Keempat,0,0,0,,Seseorang menambah batu pada nasi.
Dialog: 0,0:42:24.51,0:42:27.32, Lalai, Keempat,0,0,0,,-Apa?\N-Kami tidak akan dapat menyerahkan apa-apa.
Dialog: 0,0:42:29.38,0:42:32.09,Lalai,Keempat,0,0,0,,Jangan risau. Lakukan semua yang anda boleh di pihak anda.
Dialog: 0,0:42:32.85,0:42:36.52,Lalai,Keempat,0,0,0,,Saya akan melakukan yang terbaik untuk mendapatkan produk tersebut.
Dialog: 0,0:42:38.99,0:42:40.03,Lalai,Keempat,0,0,0,,Ya.
Dialog: 0,0:42:49.24,0:42:51.47,Lalai,Keempat,0,0,0,,Tuhan, apa yang kamu lakukan?
Dialog: 0,0:42:52.51,0:42:55.21,Lalai,Keempat,0,0,0,,Chef Diraja! Hei!
Dialog: 0,0:42:55.48,0:42:58.98,Lalai,Keempat,0,0,0,,Saya perlu menunjukkan kepadanya cara saya membawa makanan sendiri.
Dialog: 0,0:42:59.41,0:43:01.55,Lalai,Keempat,0,0,0,,Ini akan membuatkan dia berasa lebih baik, bukan?
Dialog: 0,0:43:10.22,0:43:12.46,Lalai,Keempat,0,0,0,,Gabungan sirap manis dan garam menjadikannya
Dialog: 0,0:43:12.46,0:43:13.83,Lalai,Keempat,0,0,0,,hidangan manis dan masin yang ideal.
Dialog: 0,0:43:24.64,0:43:32.51,Lalai,Keempat,0,0,0,,Di sana saya melihat gunung yang indah...
Dialog: 0,0:43:44.53,0:43:45.73,Lalai,Keempat,0,0,0,,Pengarah Han?
Dialog: 0,0:43:47.50,0:43:48.50,Lalai,Keempat,0,0,0,,Bajingan!
Dialog: 0,0:43:49.50,0:43:50.50,Lalai,Keempat,0,0,0,,Bagaimana anda boleh?
Dialog: 0,0:44:06.38,0:44:09.88, Lalai, Keempat,0,0,0,, Popcorn saya!
Dialog: 0,0:44:13.05,0:44:14.12,Lalai,Keempat,0,0,0,,Sial!
Dialog: 0,0:44:17.49,0:44:19.13,Lalai,Keempat,0,0,0,,Bajingan!
Dialog: 0,0:44:38.18,0:44:40.11,Lalai,Keempat,0,0,0,,Di manakah hidangan itu?
Dialog: 0,0:44:40.48,0:44:41.68,Lalai,Keempat,0,0,0,,Nah...
Dialog: 0,0:44:51.69,0:44:52.76,Lalai,Keempat,0,0,0,,Di sini.
Dialog: 0,0:44:56.13,0:44:58.67,Lalai,Keempat,0,0,0,,Nantikan kehidupan anda di istana.
Dialog: 0,0:45:08.34,0:45:09.61,Lalai,Keempat,0,0,0,,Memandangkan apa yang berlaku,
Dialog: 0,0:45:09.61,0:45:11.28,Lalai,Keempat,0,0,0,,anda mesti mendapatkan makanan,
Dialog: 0,0:45:11.28,0:45:13.41,Lalai,Keempat,0,0,0,,sebaik sahaja anda selesai dengan seni mempertahankan diri.
Dialog: 0,0:45:13.95,0:45:14.95,Lalai,Keempat,0,0,0,,Ya.
Dialog: 0,0:45:23.09,0:45:26.69,Lalai,Keempat,0,0,0,,Terima kasih kerana menjemput kami ke jamuan.
Dialog: 0,0:45:27.90,0:45:29.90,Lalai,Keempat,0,0,0,,Anda layak berada di sini.
Dialog: 0,0:45:30.97,0:45:32.83,Lalai,Keempat,0,0,0,,Gunting-gundik itu baik.
Dialog: 0,0:45:33.50,0:45:35.20,Lalai,Keempat,0,0,0,,Saya harap semuanya baik-baik saja dengan awak juga.
Dialog: 0,0:45:35.34,0:45:36.60,Lalai,Keempat,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:45:37.07,0:45:40.07,Lalai,Keempat,0,0,0,,Dalam apa jua keadaan, selamat hari ini.
Dialog: 0,0:46:54.85,0:46:56.58,Lalai,Keempat,0,0,0,,Adakah Ibu Permaisuri sudah tiba?
Dialog: 0,0:46:57.12,0:46:58.62,Lalai,Keempat,0,0,0,,Saya akan tahu.
Dialog: 0,0:47:09.33,0:47:11.90,Lalai,Keempat,0,0,0,,Fikir awak lari.
Dialog: 0,0:47:12.00,0:47:13.20,Lalai,Keempat,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:47:13.70,0:47:17.41,Lalai,Keempat,0,0,0,,Jika seseorang telah melakukan jenayah,\Ndia mesti dihukum dengan sewajarnya.
Dialog: 0,0:47:17.57,0:47:19.74,Lalai,Keempat,0,0,0,,Gembira anda sedar.
Dialog: 0,0:47:21.18,0:47:23.71,Lalai,Keempat,0,0,0,,Permaisuri menghantar saya makanan ringan pagi ini,
Dialog: 0,0:47:23.71,0:47:26.58,Lalai,Keempat,0,0,0,,dan saya mula bersiap lambat kerana saya mencubanya.
Dialog: 0,0:47:27.72,0:47:28.98,Lalai,Keempat,0,0,0,,Ratu?
Dialog: 0,0:47:36.92,0:47:39.03, Lalai, Keempat,0,0,0,,Saya rasa seperti akan mati, tersepit di antara dua kebakaran.
Dialog: 0,0:47:44.33,0:47:46.60,Lalai,Keempat,0,0,0,,Ada jenis salah faham lagi?
Dialog: 0,0:47:49.97,0:47:51.81,Lalai,Keempat,0,0,0,,Ayuh.
Dialog: 0,0:48:26.17,0:48:29.91,Lalai,Keempat,0,0,0,,Pengawal diraja telah menyediakan\N pertunjukan seni mempertahankan diri.
Dialog: 0,0:48:48.23,0:48:49.60,Lalai,Keempat,0,0,0,,Perhatian!
Dialog: 0,0:48:50.46,0:48:51.70,Lalai,Keempat,0,0,0,,Pusingan pertama.
Dialog: 0,0:48:55.84,0:48:59.87,Lalai,Keempat,0,0,0,,Beraninya dia cuba \Nuntuk mencederakan ratu dengan pedang itu?
Dialog: 0,0:49:04.95,0:49:06.08,Lalai,Keempat,0,0,0,,Pertempuran.
Dialog: 0,0:50:34.44,0:50:38.17,Lalai,Keempat,0,0,0,,Wah. Raja sangat bersedia.
Dialog: 0,0:50:54.05,0:50:58.23, Lalai, Keempat,0,0,0,, Permaisuri Janda. Sudah tiba masanya untuk memburu.
Dialog: 0,0:51:00.49,0:51:03.30,Lalai,Keempat,0,0,0,,Yang Mulia. \NISudah tiba masanya untuk menukar pakaian memburu anda.
Dialog: 0,0:51:08.57,0:51:10.77,Lalai,Keempat,0,0,0,,Saya akan kembali, Permaisuri Janda.
Dialog: 0,0:51:12.77,0:51:14.88,Lalai,Keempat,0,0,0,,Saya akan kembali.
Dialog: 0,0:52:05.59,0:52:08.53, Lalai, Keempat,0,0,0,,Barisan pertama, sedia untuk menembak.
Dialog: 0,0:52:11.93,0:52:13.10, Lalai, Keempat, 0,0,0,, Api!
Dialog: 0,0:52:22.34,0:52:23.44, Lalai, Keempat, 0,0,0,, Api!
Dialog: 0,0:52:28.38,0:52:29.48, Lalai, Keempat, 0,0,0,, Api!
Dialog: 0,0:52:44.00,0:52:45.67,Lalai,Keempat,0,0,0,,Saya fikir ia hanya untuk pertunjukan.
Dialog: 0,0:53:09.82,0:53:12.06,Lalai,Keempat,0,0,0,,Perkara adalah perkara utama.
Dialog: 0,0:53:15.33,0:53:16.80,Lalai,Keempat,0,0,0,,Saya rasa saya kelihatan hebat.
Dialog: 0,0:53:17.03,0:53:19.53,Lalai,Keempat,0,0,0,,Saya sukakannya. Saya nampak cool.
Dialog: 0,0:53:27.31,0:53:29.21,Lalai,Kelima,0,0,0,,Mengapa dia begitu agresif?
Dialog: 0,0:53:29.44,0:53:32.15,Lalai,Kelima,0,0,0,,Selalu ada mereka yang mengambil pertandingan dengan begitu serius.
Dialog: 0,0:53:33.51,0:53:34.82, Lalai, Kelima,0,0,0,, Rupa apakah ini?
Dialog: 0,0:53:36.42,0:53:39.49,Lalai,Kelima,0,0,0,,1 mata untuk seekor burung, 2 mata untuk seekor arnab,
Dialog: 0,0:53:39.79,0:53:42.92,Lalai,Kelima,0,0,0,,untuk luak - 3 mata, untuk babi hutan - 4,
Dialog: 0,0:53:43.19,0:53:46.09,Lalai,Kelima,0,0,0,,rusa - 5 mata, serigala - 7,
Dialog: 0,0:53:46.16,0:53:50.20,Lalai,Kelima,0,0,0,,beruang - 9 dan harimau - 10 mata.
Dialog: 0,0:53:50.20,0:53:51.23,Lalai,Kelima,0,0,0,,Serigala, harimau, arnab, rusa.
Dialog: 0,0:53:51.23,0:53:52.97, Lalai, Kelima,0,0,0,, Setiap anak panah akan diberikan 10 anak panah.
Dialog: 0,0:53:53.43,0:53:56.37,Lalai,Kelima,0,0,0,,Demi perjuangan yang adil, puan-puan mahkamah dan pembantu rumah anda
Dialog: 0,0:53:56.37,0:53:57.67,Lalai,Kelima,0,0,0,,tidak akan mengambil bahagian.
Dialog: 0,0:53:58.61,0:54:00.21, Lalai, Kelima,0,0,0,, Sukar.
Dialog: 0,0:54:00.64,0:54:02.04,Lalai,Kelima,0,0,0,,Pada masa kini ini akan membuatkan orang ramai
Dialog: 0,0:54:02.04,0:54:03.48,Lalai,Kelima,0,0,0,,tandatangani petisyen kebangsaan.
Dialog: 0,0:54:03.91,0:54:06.65, Lalai, Kelima,0,0,0,, Kemudian tiba masanya untuk bermula.
Dialog: 0,0:54:17.06,0:54:19.46,Lalai,Kelima,0,0,0,,Anda sudah boleh keluar.
Dialog: 0,0:54:26.17,0:54:28.90,Lalai,Kelima,0,0,0,,Kita hanya perlu menghabiskan masa di sini dan kembali.
Dialog: 0,0:54:46.09,0:54:49.29,Lalai,Kelima,0,0,0,,Perlawanan menembak hari ini sangat boleh diramal.
Dialog: 0,0:54:50.26,0:54:52.59,Lalai,Kelima,0,0,0,,Ini adalah pertempuran untuk maruah keluarga,
Dialog: 0,0:54:53.06,0:54:55.80, Lalai, Kelima,0,0,0,,tetapi ratu nampaknya tidak berminat.
Dialog: 0,0:54:56.03,0:54:59.63, Lalai, Kelima,0,0,0,,Saya tidak tahu anda mempunyai masa untuk bimbang tentang pergaduhan jenaka.
Dialog: 0,0:55:00.07,0:55:03.14,Lalai,Kelima,0,0,0,,Anda mungkin akan berjumpa dengan anak anda hari ini.
Dialog: 0,0:55:08.58,0:55:10.94,Lalai,Kelima,0,0,0,,Masanya telah tiba untuk menyampaikan hadiah saya.
Dialog: 0,0:55:12.35,0:55:14.58,Lalai,Kelima,0,0,0,,Malam itu apabila ratu jatuh ke dalam keadaan vegetatif,
Dialog: 0,0:55:14.58,0:55:17.55,Lalai,Kelima,0,0,0,,gundik diraja dan raja hendak berkongsi katil.
Dialog: 0,0:55:17.95,0:55:19.95,Lalai,Kelima,0,0,0,,Permaisuri telah bangun
Dialog: 0,0:55:19.95,0:55:22.66, Lalai, Kelima,0,0,0,, hanya sehari selepas itu.
Dialog: 0,0:55:25.29,0:55:26.66,Lalai,Kelima,0,0,0,,Maksudnya dia berpura-pura,
Dialog: 0,0:55:26.66,0:55:29.66, Lalai, Kelima,0,0,0,,untuk menghentikannya?
Dialog: 0,0:55:31.23,0:55:33.97,Lalai,Kelima,0,0,0,,Permaisuri meletakkan semuanya dalam talian,
Dialog: 0,0:55:33.97,0:55:35.67,Lalai,Kelima,0,0,0,,untuk memenangi hati raja.
Dialog: 0,0:55:36.24,0:55:37.87,Lalai,Kelima,0,0,0,,Melemparkan dirinya ke dalam tasik,
Dialog: 0,0:55:37.87,0:55:40.24,Lalai,Kelima,0,0,0,,melindungi gundik diraja daripada pedang.
Dialog: 0,0:55:40.97,0:55:43.81, Lalai, Kelima,0,0,0,, Mengorbankan perkara terakhir yang dia tinggalkan.
Dialog: 0,0:55:47.05,0:55:49.88, Lalai, Kelima,0,0,0,, Permaisuri menolak keluarganya.
Dialog: 0,0:55:59.16,0:56:02.63, Lalai, Kelima,0,0,0,,Saya bosan, dan awak menghiburkan saya.
Dialog: 0,0:56:03.43,0:56:07.43,Lalai,Kelima,0,0,0,,Raja mengadakan jamuan tanpa sebab.
Dialog: 0,0:56:07.87,0:56:10.04,Lalai,Kelima,0,0,0,,Dan permaisuri bergegas mengambil gundik-gundik
Dialog: 0,0:56:10.04,0:56:12.54,Lalai,Kelima,0,0,0,,daripada keluarga yang paling berpengaruh.
Dialog: 0,0:56:12.71,0:56:15.84,Lalai,Kelima,0,0,0,,Saya memilih mereka yang boleh menyokong raja.
Dialog: 0,0:56:16.64,0:56:19.78,Lalai,Kelima,0,0,0,,Hari ini raja akan mendedahkan wajahnya yang sebenar,
Dialog: 0,0:56:19.78,0:56:22.28,Lalai,Kelima,0,0,0,,yang masih tersembunyi daripada pegawai.
Dialog: 0,0:56:22.62,0:56:25.09,Lalai,Kelima,0,0,0,,Wajah seorang penguasa yang kuat.
Dialog: 0,0:56:28.56,0:56:30.49,Lalai,Kelima,0,0,0,,Adakah anda faham sekarang?
Dialog: 0,0:56:31.16,0:56:33.86,Lalai,Kelima,0,0,0,,Permaisuri sehaluan dengan raja.
Dialog: 0,0:56:33.86,0:56:37.50, Lalai, Kelima,0,0,0,, Adakah anda tidak takut untuk hidup anda, mengatakan ini?
Dialog: 0,0:56:37.86,0:56:41.03, Lalai, Kelima,0,0,0,,Dan anda mungkin percaya bahawa ratu tidak akan mengkhianati anda.
Dialog: 0,0:56:42.30,0:56:44.50,Lalai,Kelima,0,0,0,,Saya sangat kecewa.
Dialog: 0,0:56:44.91,0:56:47.21,Lalai,Kelima,0,0,0,,Terjatuh kerana helah murahannya
Dialog: 0,0:56:47.21,0:56:48.84, Lalai, Kelima,0,0,0,,dan biarkan diri mereka tertipu.
Dialog: 0,0:56:49.48,0:56:52.21,Lalai,Kelima,0,0,0,,Nampaknya, mereka sudah agak tua.
Dialog: 0,0:56:53.98,0:56:56.38,Lalai,Kelima,0,0,0,,Saya akan mencabut bibir keji ini.
Dialog: 0,0:56:56.38,0:56:59.65,Lalai,Kelima,0,0,0,,Permaisuri berpura-pura pengsan, tiada dosa pada saya.
Dialog: 0,0:56:59.65,0:57:03.46,Lalai,Kelima,0,0,0,,Dan saya tidak perlu takut lagi!
Dialog: 0,0:57:08.46,0:57:10.46,Lalai,Kelima,0,0,0,,Mengapa anda berhenti bermain?
Dialog: 0,0:57:10.76,0:57:13.83,Lalai,Kelima,0,0,0,,Anda kecewakan ratu janda.
Dialog: 0,0:57:27.75,0:57:29.15,Lalai,Kelima,0,0,0,,Dan sekarang
Dialog: 0,0:57:29.15,0:57:33.45,Lalai,Kelima,0,0,0,,raja akan memberi anda peminat.
Dialog: 0,0:57:55.38,0:57:58.61,Lalai,Kelima,0,0,0,,Anda telah melakukan kerja yang hebat. Saya tidak sabar untuk kenduri.
Dialog: 0,0:57:59.68,0:58:02.35, Lalai, Kelima,0,0,0,,Anda juga melakukan kerja yang hebat.
Dialog: 0,0:58:08.62,0:58:11.26,Lalai,Kelima,0,0,0,,Permaisuri Janda telah tiba.
Dialog: 0,0:58:16.10,0:58:17.20,Lalai,Kelima,0,0,0,,Anda di sini.
Dialog: 0,0:58:21.20,0:58:23.47,Lalai,Kelima,0,0,0,,Ia sangat membosankan di sana.
Dialog: 0,0:58:23.47,0:58:24.87, Lalai, Kelima,0,0,0,,Saya tidak tahan.
Dialog: 0,0:58:26.87,0:58:29.51,Lalai,Kelima,0,0,0,,Saya tertanya-tanya sama ada ia akan menjadi lebih baik di sini.
Dialog: 0,0:58:30.21,0:58:32.51, Lalai, Kelima,0,0,0,, Maaf saya tidak dapat menggembirakan anda.
Dialog: 0,0:58:34.55,0:58:37.25,Lalai,Kelima,0,0,0,,Saya ingin melihat seni mempertahankan diri, tetapi saya terlambat.
Dialog: 0,0:58:39.75,0:58:43.59,Lalai,Kelima,0,0,0,,Walaupun menonton persembahan juga membosankan.
Dialog: 0,0:58:45.93,0:58:49.10,Lalai,Kelima,0,0,0,,Saya lebih suka pertempuran sebenar.
Dialog: 0,0:58:50.53,0:58:52.63,Lalai,Kelima,0,0,0,,Saya akan mengarahkan pengawal diraja untuk bersaing antara satu sama lain.
Dialog: 0,0:58:53.53,0:58:55.24,Lalai,Kelima,0,0,0,,Bagaimana pula dengan bercakap sendiri?
Dialog: 0,0:58:59.44,0:59:01.58,Lalai,Kelima,0,0,0,,Saya dengar awak potong kayu di Ganghwado
Dialog: 0,0:59:01.58,0:59:04.31, Lalai, Kelima,0,0,0,, dan dia membawa air itu sendiri.
Dialog: 0,0:59:05.18,0:59:08.05, Lalai, Kelima, 0,0,0,, Dengan kuasa ini dan ini ia tidak akan sukar.
Dialog: 0,0:59:11.12,0:59:13.79, Lalai, Kelima,0,0,0,,Buruh manual dan seni mempertahankan diri sangat berbeza.
Dialog: 0,0:59:14.39,0:59:17.49,Lalai,Kelima,0,0,0,,Dan dalam beberapa tahun kebelakangan ini saya semakin banyak duduk di atas takhta.
Dialog: 0,0:59:17.49,0:59:18.89,Lalai,Kelima,0,0,0,,Badan telah menjadi kayu sepenuhnya.
Dialog: 0,0:59:18.89,0:59:21.26,Lalai,Kelima,0,0,0,,Nah, gunakan kipas dan bukannya senjata.
Dialog: 0,0:59:24.80,0:59:27.70,Lalai,Kelima,0,0,0,,Bagaimana pula dengan pertandingan dengan ketua Jabatan Detektif?
Dialog: 0,0:59:27.70,0:59:29.20,Lalai,Kelima,0,0,0,,Anda hampir sebaya.
Dialog: 0,0:59:32.41,0:59:33.64,Lalai,Kelima,0,0,0,,Ketua Jabatan Detektif -
Dialog: 0,0:59:33.64,0:59:35.91,Lalai,Kelima,0,0,0,,seorang pahlawan profesional yang telah berlatih selama bertahun-tahun.
Dialog: 0,0:59:36.88,0:59:38.95,Lalai,Kelima,0,0,0,,Saya takut raja akan cedera.
Dialog: 0,0:59:38.95,0:59:40.35,Lalai,Kelima,0,0,0,,Jika anda mahu melihat pertarungan, saya akan menjemput...
Dialog: 0,0:59:40.35,0:59:43.22,Lalai,Kelima,0,0,0,,Saya mahu melihat raja berlawan.
Dialog: 0,0:59:48.92,0:59:50.26,Lalai,Kelima,0,0,0,,Apa kata anda?
Dialog: 0,0:59:53.39,0:59:55.40,Lalai,Kelima,0,0,0,,Ayah silap.
Dialog: 0,0:59:57.03,1:00:00.93,Lalai,Kelima,0,0,0,,Sila lihat wajah sebenar beliau pada Hari Troli.
Dialog: 0,1:00:11.81,1:00:13.21,Lalai,Kelima,0,0,0,,Rusa.
Dialog: 0,1:00:21.42,1:00:22.46,Lalai,Kelima,0,0,0,,Bagaimana?
Dialog: 0,1:00:23.62,1:00:24.66,Lalai,Kelima,0,0,0,,Beruang.
Dialog: 0,1:00:54.02,1:00:55.16,Lalai,Kelima,0,0,0,,Go.
Dialog: 0,1:00:55.16,1:00:57.32,Lalai,Kelima,0,0,0,,Anda bukan mangsa yang saya cari.
Dialog: 0,1:01:10.97,1:01:12.11, Lalai, Kelima,0,0,0,, Pergi ke tempat yang salah?
Dialog: 0,1:01:16.08,1:01:17.64,Lalai,Kelima,0,0,0,,Nampaknya saya sudah melihat pokok ini.
Dialog: 0,1:01:19.75,1:01:21.68,Lalai,Kelima,0,0,0,,Dan ke mana saya harus pergi?
Dialog: 0,1:01:25.82,1:01:27.52,Lalai,Kelima,0,0,0,,Kami akan mempunyai peminat di tangan kami.
Dialog: 0,1:01:27.89,1:01:30.72,Lalai,Kelima,0,0,0,,Orang yang mengambil kipas daripada pihak lawan akan menang.
Dialog: 0,1:01:34.19,1:01:35.53,Lalai,Kelima,0,0,0,,Mudah.
Dialog: 0,1:02:04.19,1:02:06.36,Lalai,Kelima,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:02:08.19,1:02:10.06,Lalai,Kelima,0,0,0,,Saya kata, bertenang.
Dialog: 0,1:02:11.16,1:02:13.73,Lalai,Kelima,0,0,0,,Bagaimana anda akan bertindak balas jika anda melukakan raja?
Dialog: 0,1:02:15.70,1:02:18.31,Lalai,Kelima,0,0,0,,Ini adalah perintah Ratu Janda.
Dialog: 0,1:02:18.31,1:02:20.07,Lalai,Kelima,0,0,0,,Tiada apa yang perlu dilakukan selain melengkapkannya.
Dialog: 0,1:02:25.11,1:02:28.11,Lalai,Kelima,0,0,0,,Jadi ratu janda berada di belakang kamu.
Dialog: 0,1:02:32.69,1:02:35.22,Lalai,Kelima,0,0,0,,Jadi saya perlu mengajar anda satu pengajaran.
Dialog: 0,1:02:35.22,1:02:37.32,Lalai,Kelima,0,0,0,,Saya akan tunjukkan kepada anda siapa bos di istana.
Dialog: 0,1:03:00.78,1:03:02.42,Lalai,Kelima,0,0,0,,Kamu kata dia berbeza dengan mendiang raja.
Dialog: 0,1:03:02.98,1:03:04.58,Lalai,Kelima,0,0,0,,Dan kebenarannya berbeza.
Dialog: 0,1:03:08.79,1:03:10.42,Lalai,Kelima,0,0,0,,Baiklah, okey.
Dialog: 0,1:03:10.42,1:03:13.13,Lalai,Kelima,0,0,0,,Saya perlu tidur sebentar. Mereka akan mencari saya apabila semuanya berakhir.
Dialog: 0,1:03:16.26,1:03:17.36,Lalai,Kelima,0,0,0,,Sial, saya takutkan awak!
Dialog: 0,1:03:19.07,1:03:20.23,Lalai,Kelima,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,1:03:22.04,1:03:25.14,Lalai,Kelima,0,0,0,,Apa pendapat anda? Saya bersembunyi untuk terus hidup.
Dialog: 0,1:03:25.71,1:03:28.17,Lalai,Kelima,0,0,0,,Nah, anda benar-benar tidak akan mati. Kenapa awak takut sangat?
Dialog: 0,1:03:28.41,1:03:32.31,Lalai,Kelima,0,0,0,,Saya tahu, tetapi anak panah masih sakit.
Dialog: 0,1:03:32.91,1:03:34.95,Lalai,Kelima,0,0,0,,Saya masih mengalami lebam dari tahun lepas.
Dialog: 0,1:03:34.95,1:03:36.12,Lalai,Kelima,0,0,0,,Merengek sungguh.
Dialog: 0,1:03:37.78,1:03:39.85,Lalai,Kelima,0,0,0,,Jangan takut, memburu tidak menggoda saya.
Dialog: 0,1:03:40.45,1:03:43.86,Lalai,Kelima,0,0,0,,Nah, orang lain akan memukul saya.
Dialog: 0,1:03:55.50,1:03:56.87,Lalai,Kelima,0,0,0,,Di sini.
Dialog: 0,1:03:57.20,1:03:59.31,Lalai,Kelima,0,0,0,,Bagaimana anda berjaya kembali seperti itu?
Dialog: 0,1:04:00.44,1:04:01.47,Lalai,Kelima,0,0,0,,Harimau.
Dialog: 0,1:04:06.88,1:04:07.95,Lalai,Kelima,0,0,0,,Jadi?
Dialog: 0,1:04:08.88,1:04:11.62,Lalai,Kelima,0,0,0,,Terima kasih, Yang Mulia.
Dialog: 0,1:04:11.62,1:04:12.89,Lalai,Kelima,0,0,0,,Simpan cenderahati.
Dialog: 0,1:04:14.12,1:04:15.22,Lalai,Kelima,0,0,0,,Pergi.
Dialog: 0,1:04:17.19,1:04:18.96,Lalai,Kelima,0,0,0,,Sudah?
Dialog: 0,1:04:20.83,1:04:22.60,Lalai,Kelima,0,0,0,,Saya tidak tahu permaisuri itu pandai menembak,
Dialog: 0,1:04:22.60,1:04:25.30,Lalai,Kelima,0,0,0,,untuk memukul harimau dengan pantas.
Dialog: 0,1:04:25.30,1:04:27.57,Lalai,Kelima,0,0,0,,Ya, dia pemanah lahir.
Dialog: 0,1:04:27.57,1:04:30.87,Lalai,Kelima,0,0,0,,Saya tidak nampak pun dia, hanya angin bersiul di telinga saya.
Dialog: 0,1:04:30.87,1:04:33.47,Lalai,Kelima,0,0,0,,Jadi mereka menembak saya.
Dialog: 0,1:04:33.47,1:04:34.57,Lalai,Kelima,0,0,0,,Betulkah?
Dialog: 0,1:06:13.11,1:06:14.21,Lalai,Kelima,0,0,0,,Jadi andalah.
Dialog: 0,1:06:14.97,1:06:16.91,Lalai,Kelima,0,0,0,,Anda adalah orang itu.
Dialog: 0,1:06:20.21,1:06:22.05,Lalai,Kelima,0,0,0,,Saya tidak akan memaafkan awak.
Dialog: 0,1:06:42.00,1:06:44.97,Lalai,Kelima,0,0,0,,Saya akan bunuh awak.
Dialog: 0,1:07:05.53,1:07:10.00,Lalai,Kelima,0,0,0,,Bagaimana saya menjadi seorang ratu
Dialog: 0,1:07:25.41,1:07:27.68,Lalai,Kelima,0,0,0,,Saya ada berita sedih.
Dialog: 0,1:07:27.68,1:07:29.05,Lalai,Kelima,0,0,0,,Tangan saya menggeletar
Dialog: 0,1:07:29.05,1:07:30.98,Lalai,Kelima,0,0,0,,dan saya memainkan watak ratu.
Dialog: 0,1:07:30.98,1:07:33.25,Lalai,Kelima,0,0,0,,Kenduri akan bermula, tetapi bahan-bahan belum tiba.
Dialog: 0,1:07:33.25,1:07:34.32,Lalai,Kelima,0,0,0,,Itu sahaja?
Dialog: 0,1:07:34.32,1:07:35.89,Lalai,Kelima,0,0,0,,Adakah anda menambah racun?
Dialog: 0,1:07:36.06,1:07:37.56,Lalai,Kelima,0,0,0,,Nama - Lee Senman.
Dialog: 0,1:07:37.89,1:07:39.76,Lalai,Kelima,0,0,0,,Saya akan mencipta menu baharu daripada bahan-bahan yang tersedia.
Dialog: 0,1:07:39.76,1:07:41.93,Lalai,Kelima,0,0,0,,Beraninya awak menggoreng jarum saya yang berharga.
Dialog: 0,1:07:41.93,1:07:44.40,Lalai,Kelima,0,0,0,,Apa yang akan kita masak hari ini bukanlah makanan ringkas.
Dialog: 0,1:07:44.40,1:07:45.67,Lalai,Kelima,0,0,0,,Dia layak menjadi presiden.
Dialog: 0,1:07:45.93,1:07:47.97,Lalai,Kelima,0,0,0,,Beraninya kamu mengingkari perintah tuan kamu?
Dialog: 0,1:07:47.97,1:07:50.40,Lalai,Kelima,0,0,0,,{\i1}-Tangkap mereka!\N-Ini bukan pengkhianatan, tetapi pemberontakan!{\i}
Dialog: 0,1:07:50.40,1:07:53.67,Lalai,Kelima,0,0,0,,Anda perlu membayar untuk keupayaan mengawal watak anda.
Dialog: 0,0:13:59.93,0:14:01.93,Lalai,,0,0,0,,


