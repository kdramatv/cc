Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:24.85,0:01:25.88,Default,Spilik1,0,0,0,,هواجين.
Dialogue: 0,0:01:26.78,0:01:27.78,Default,Spilik1,0,0,0,,هواجين.
Dialogue: 0,0:01:38.66,0:01:40.03,Default,Spilik1,0,0,0,,ما الذي يكمن هناك؟
Dialogue: 0,0:01:43.40,0:01:45.70,Default,Spikyulka1,0,0,0,,-فهمت، أنا أطلب المساعدة.\N-لا.
Dialogue: 0,0:01:46.90,0:01:49.44,Default,Spilik1,0,0,0,,لا ينبغي لأحد أن يعرف أنني...
Dialogue: 0,0:01:50.67,0:01:52.77,Default,Spilyk1,0,0,0,,ما أنا...
Dialogue: 0,0:01:54.17,0:01:55.18,Default,Spilyk1,0,0,0,,انتظر.
Dialogue: 0,0:01:59.38,0:02:02.28,Default,Spilik1,0,0,0,,10 حلقة.
Dialogue: 0,0:02:03.42,0:02:06.49,Default,Spikyulka1,0,0,0,,لماذا ذهبت إلى هناك، حيث توجد مثل هذه الذكريات الرهيبة؟
Dialogue: 0,0:02:07.29,0:02:08.86,Default,Spilyk1,0,0,0,,هل أنت متأكد أنك لا تستطيع الاتصال بأي شخص؟
Dialogue: 0,0:02:09.72,0:02:11.29,Default,Spikyulka1,0,0,0,,ماذا لو مات في النهاية؟
Dialogue: 0,0:02:15.06,0:02:16.46,Default,Spilik1,0,0,0,,هل تراودك الكوابيس مرة أخرى؟
Dialogue: 0,0:02:16.66,0:02:19.03,Default,Spilik1,0,0,0,,مرحبًا، استيقظ.
Dialogue: 0,0:02:25.34,0:02:26.34,Default,Spilik1,0,0,0,,هواجين.
Dialogue: 0,0:02:28.14,0:02:30.91,Default,Spilik1,0,0,0,,ممتاز. فكر فيما تريد.
Dialogue: 0,0:02:38.29,0:02:40.39,Default,Spilik1,0,0,0,,هذا ليس جيدًا. سأذهب للعثور على شخص ما.
Dialogue: 0,0:02:43.96,0:02:45.03,Default,Spilik1,0,0,0,,حسناً، ها أنت ذا مرة أخرى.
Dialogue: 0,0:02:45.23,0:02:46.83,Default,Spilik1,0,0,0,,كان لدي كابوس،
Dialogue: 0,0:02:50.10,0:02:52.23,Default,Spilik1,0,0,0,,أنني مت ملكاً لا قيمة له.
Dialogue: 0,0:02:53.37,0:02:55.07,Default,Spilik1,0,0,0,,كابوس مخيف، أين أنا
Dialogue: 0,0:02:56.64,0:02:59.87,Default,Spilyk1,0,0,0,,شاهدت العالم ينهار
Dialogue: 0,0:03:00.67,0:03:03.91,Default,Spilik1,0,0,0,,ولم أستطع فعل أي شيء.
Dialogue: 0,0:03:07.45,0:03:08.82,Default,Spilyk1,0,0,0,,لم يسأل أحد.
Dialogue: 0,0:03:11.15,0:03:13.65,Default,Spilik1,0,0,0,,دعونا نستلقي هناك لبعض الوقت.
Dialogue: 0,0:03:15.79,0:03:17.02,Default,Spilik1,0,0,0,,لحظة واحدة.
Dialogue: 0,0:03:24.76,0:03:28.27,Default,Spilik1,0,0,0,,سأتظاهر بأنني هواجين للحظة.
Dialogue: 0,0:03:40.15,0:03:42.95,Default,Spilik1,0,0,0,,10 حلقة: الحياة في كابوس
Dialogue: 0,0:03:44.78,0:03:46.52,Default,Spilik1,0,0,0,,أخيرًا، أصبحت ملكة.
Dialogue: 0,0:03:47.12,0:03:49.12,Default,Spilik1,0,0,0,,كنت أعلم أن الأمر سيكون هكذا.
Dialogue: 0,0:04:44.84,0:04:46.55,Default,Spilyk1,0,0,0,,سر
Dialogue: 0,0:04:53.89,0:04:55.66,Default,Spilik1,0,0,0,,سأخبر جلالته بكل شيء.
Dialogue: 0,0:04:56.42,0:04:58.26,Default,Spilik1,0,0,0,,حتى لا يعود الماضي يؤثر فينا.
Dialogue: 0,0:05:06.80,0:05:07.83,Default,Spilik1,0,0,0,,صاحب السمو.
Dialogue: 0,0:05:09.60,0:05:11.24,Default,Spilik1,0,0,0,,أريد التحدث إلى جلالته.
Dialogue: 0,0:05:11.67,0:05:14.71,Default,Spilik1,0,0,0,,خرج الملك والملكة،
Dialogue: 0,0:05:15.04,0:05:17.01,Default,Spikyulka1,0,0,0,,وحتى السيد كيم ليس في المنزل.
Dialogue: 0,0:06:07.96,0:06:09.00,Default,Spilyk1,0,0,0,,أوفول.
Dialogue: 0,0:06:09.46,0:06:13.30,Default,Spilik1,0,0,0,,يمكنني مساعدة الملك وتدمير الملكة.
Dialogue: 0,0:06:14.50,0:06:15.80,Default,Spilik1,0,0,0,,ماذا علي أن أفعل؟
Dialogue: 0,0:07:00.91,0:07:02.02,Default,Spilik1,0,0,0,,جلالتك.
Dialogue: 0,0:07:06.65,0:07:09.59,Default,Spilyk1,0,0,0,,وقت الغسل.
Dialogue: 0,0:07:58.57,0:07:59.71,Default,Spilik1,0,0,0,,صباح الخير.
Dialogue: 0,0:08:02.98,0:08:05.31,Default,Spikyulka1,0,0,0,,-ماذا حدث؟\N-سؤال جيد.
Dialogue: 0,0:08:05.31,0:08:08.28,Default,Silk1,0,0,0,,كدت أتطرق إليك... أي أنني كدت أموت.
Dialogue: 0,0:08:08.78,0:08:10.45,Default,Spilyk1,0,0,0,,أنت ثقيل جدًا.
Dialogue: 0,0:08:13.42,0:08:14.62,Default,Spilik1,0,0,0,,كان الأمر خطيراً.
Dialogue: 0,0:08:17.16,0:08:19.03,Default,Spikyulka1,0,0,0,,دفتر المحاسبة لم يكن موجوداً.
Dialogue: 0,0:08:20.43,0:08:22.13,Default,Spilik1,0,0,0,,لقد أنقذتني
Dialogue: 0,0:08:22.63,0:08:23.70,Default,Spilik1,0,0,0,,نفسها؟
Dialogue: 0,0:08:26.53,0:08:28.13,Default,Spilik1,0,0,0,,لم تكن تريد مني أن أطلب المساعدة.
Dialogue: 0,0:08:30.34,0:08:33.24,Default,Spikyulka1,0,0,0,,كان عليّ أن أجهد كل قوتي.
Dialogue: 0,0:08:37.84,0:08:40.75,Default,Spilyk1,0,0,0,,أستطيع. تذكر اليوم الذي كان عليك فيه رفع 150 كجم.
Dialogue: 0,0:08:41.61,0:08:43.35,Default,Spilik1,0,0,0,,القوة ليست في العضلات،
Dialogue: 0,0:08:43.72,0:08:46.95,Default,Spilik1,0,0,0,,وفي العزم.
Dialogue: 0,0:08:53.09,0:08:56.06,Default,Spikyulka1,0,0,0,,لماذا صعدت إلى البئر في مثل هذا الوقت؟
Dialogue: 0,0:08:58.70,0:09:02.90,Default,Spikyulka1,0,0,0,,كان الظلام مظلماً، ولم أتمكن من الرؤية جيداً وسقطت.
Dialogue: 0,0:09:04.30,0:09:06.04,Default,Spilik1,0,0,0,,هل أنت مصاب بالعمى الليلي؟
Dialogue: 0,0:09:06.04,0:09:07.84,Default,Spilik1,0,0,0,,من الصعب الخروج من البئر.
Dialogue: 0,0:09:10.58,0:09:12.15,Default,Spilik1,0,0,0,,هل أنت مستيقظ؟
Dialogue: 0,0:09:13.25,0:09:14.51,Default,Spilik1,0,0,0,,انتظر.
Dialogue: 0,0:09:16.15,0:09:19.29,Default,Spilik1,0,0,0,,تعال هنا. أسرع.
Dialogue: 0,0:09:20.15,0:09:21.62,Default,Spilik1,0,0,0,,انتظر قليلاً.
Dialogue: 0,0:09:23.79,0:09:25.96,Default,Spilik1,0,0,0,,تسجيل الدخول.
Dialogue: 0,0:09:40.47,0:09:43.74,Default,Spikyulka1,0,0,0,,كنت أعلم أنك ستبقى في المنزل الرئيسي،
Dialogue: 0,0:09:43.78,0:09:46.58,Default,Spilyk1,0,0,0,,سيجهز سريراً أكبر.
Dialogue: 0,0:09:46.78,0:09:50.42,Default,Spillie1,0,0,0,,أبي، لا! لا حاجة يا أبي!
Dialogue: 0,0:09:50.42,0:09:53.25,Default,Spilyk1,0,0,0,,أبي! لا تفعل هذا!
Dialogue: 0,0:09:53.25,0:09:55.72,Default,Spilik1,0,0,0,,لا! أب!
Dialogue: 0,0:09:55.72,0:09:56.99,Default,Spillie1,0,0,0,,أبي!
Dialogue: 0,0:09:57.06,0:09:58.62,Default,Spilik1,0,0,0,,عذراً.
Dialogue: 0,0:09:59.06,0:10:00.49,Default,Spillit1,0,0,0,,لا حاجة.
Dialogue: 0,0:10:00.89,0:10:03.06,Default,Spilik1,0,0,0,,شكراً لجهودكم
Dialogue: 0,0:10:03.06,0:10:04.60,Default,Spilyk1,0,0,0,,شعرت بالراحة هنا.
Dialogue: 0,0:10:05.23,0:10:08.63,Default,Spilik1,0,0,0,,لا داعي لإزعاجك بعد الآن،\NI سيعود إلى القصر.
Dialogue: 0,0:10:09.10,0:10:12.71,Default,Spilyk1,0,0,0,,ماذا تعني "مشكلة"؟ لا تقل ذلك.
Dialogue: 0,0:10:13.04,0:10:16.18,Default,Spilik1,0,0,0,,جئت لتوصيل رسالة
Dialogue: 0,0:10:16.18,0:10:18.64,Default,Spilik1,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:10:22.32,0:10:27.02,Default,Spilyk1,0,0,0,,ترسل لك كل يوم، مما يعني
Dialogue: 0,0:10:27.02,0:10:29.72,Default,Spilik1,0,0,0,,إنها حقاً بحاجة إليك.
Dialogue: 0,0:10:30.02,0:10:33.89,Default,Spikyulka1,0,0,0,,كل شيء يسير على نحو خاطئ في القصر بدوني.
Dialogue: 0,0:10:36.16,0:10:37.23,Default,Spilyk1,0,0,0,,حسناً.
Dialogue: 0,0:10:38.33,0:10:41.10,Default,Spilik1,0,0,0,,حتى لو كنت مشغولاً ومتعباً، فهذا جيد.
Dialogue: 0,0:10:41.50,0:10:45.84,Default,Spilik1,0,0,0,,لا تقلق بشأن أي شيء، ركز على دور الملكة.
Dialogue: 0,0:10:46.67,0:10:49.61,Default,Spilik1,0,0,0,,قد لا أكون أفضل أب، لكن تذكر،
Dialogue: 0,0:10:49.61,0:10:51.38,Default,Spilik1,0,0,0,,سأدعمك دائمًا.
Dialogue: 0,0:10:54.45,0:10:55.55,Default,Spilyk1,0,0,0,,نعم.
Dialogue: 0,0:10:58.52,0:11:00.59,Default,Spilik1,0,0,0,,الوصول بأمان إلى القصر.
Dialogue: 0,0:11:01.12,0:11:04.96,Default,Spilik1,0,0,0,,أفهم أن هذا وقح، لكني أطلب منك أن تعتني بالملكة.
Dialogue: 0,0:11:07.03,0:11:11.63,Default,Spiky1,0,0,0,,سأوليها المزيد من الاهتمام، فلن تكون وحيدة.
Dialogue: 0,0:11:12.13,0:11:15.64,Default,Spilik1,0,0,0,,يا لها من سعادة. أنا ممتن جدا ومحرج.
Dialogue: 0,0:11:17.30,0:11:18.54,Default,Spilyk1,0,0,0,,هل يمكننا الذهاب؟
Dialogue: 0,0:11:33.62,0:11:35.92,Default,Spilik1,0,0,0,,يصور الأب الحنون،
Dialogue: 0,0:11:36.22,0:11:39.43,Default,Spikyulka1,0,0,0,,وهو نفسه مجرد مختطف يستخدم طفله لتحقيق الربح.
Dialogue: 0,0:11:41.69,0:11:44.46,Default,Spikyulka1,0,0,0,,لقد أعطى ابنته لشخص حاول قتله.
Dialogue: 0,0:11:47.07,0:11:49.20,Default,Spilik1,0,0,0,,إذًا أراد الملك قتل كيم سو يون؟
Dialogue: 0,0:11:53.07,0:11:54.81,Default,Spikyulka1,0,0,0,,لماذا تبدو وكأنك فقدت وطنك؟
Dialogue: 0,0:11:55.54,0:11:56.61,Default,Spilik1,0,0,0,,الأمر ليس كذلك.
Dialogue: 0,0:11:57.08,0:12:00.35,Default,Spikyulka1,0,0,0,,إذا لم تكن دولة، فشيئاً آخر؟
Dialogue: 0,0:12:01.61,0:12:03.48,Default,Spikyulka1,0,0,0,,انتظر، أضاعته حقاً؟
Dialogue: 0,0:12:03.48,0:12:04.68,Default,Spilik1,0,0,0,,بالطبع لا.
Dialogue: 0,0:12:05.92,0:12:08.75,Default,Spilik1,0,0,0,,في مثل هذا اليوم الجميل تعود سالماً إلى القصر.
Dialogue: 0,0:12:09.39,0:12:12.49,Default,Spilik1,0,0,0,,رغم وجهي، إلا أنني سعيد للغاية.
Dialogue: 0,0:12:13.93,0:12:15.16,Default,Spilik1,0,0,0,,حسنًا، إذا كان الأمر كذلك.
Dialogue: 0,0:12:17.96,0:12:20.63,Default,Spikyulka1,0,0,0,,ألم يحن الوقت لبدء الثأر؟
Dialogue: 0,0:12:21.63,0:12:26.44,Default,Spikyulka1,0,0,0,,ولكن يبدو أنني نسيت شيئاً مهماً.
Dialogue: 0,0:12:27.87,0:12:30.28,Default,Spilik1,0,0,0,,يبدو أن لدي مهمة مهمة...
Dialogue: 0,0:12:31.44,0:12:32.85,Default,Spilik1,0,0,0,,يا له من رجل وسيم.
Dialogue: 0,0:12:33.61,0:12:35.01,Default,Spilik1,0,0,0,,إنه وسيم جدًا.
Dialogue: 0,0:12:35.08,0:12:36.92,Default,Spilik1,0,0,0,,وسيم حقًا.
Dialogue: 0,0:12:46.49,0:12:47.76,Default,Spilyk1,0,0,0,,اختيار المحظيات الملكية.
Dialogue: 0,0:12:48.26,0:12:50.06,Default,Spikyulka1,0,0,0,,كيف يمكنني أن أنسى أمراً عظيماً كهذا؟
Dialogue: 0,0:12:50.33,0:12:52.06,Default,Spikyulka1,0,0,0,,أحتاج إلى القيام بشيء مهم، لذا في الوقت الحالي.
Dialogue: 0,0:12:52.10,0:12:53.60,Default,Spilik1,0,0,0,,حضرة يونغ، دعنا نذهب. أسرع.
Dialogue: 0,0:12:53.77,0:12:55.84,Default,Spilik1,0,0,0,,انتظر. لماذا تهرب؟
Dialogue: 0,0:12:55.97,0:12:57.14,Default,Spilik1,0,0,0,,عذراً.
Dialogue: 0,0:12:58.54,0:13:00.17,Default,Spilik1,0,0,0,,خذ وقتك.
Dialogue: 0,0:13:00.51,0:13:03.04,Default,Spilyk1,0,0,0,,هذه فكرة سريعة. ملكة.
Dialogue: 0,0:13:05.85,0:13:06.91,Default,Spilik1,0,0,0,,جلالتك.
Dialogue: 0,0:13:16.42,0:13:17.62,Default,Spilik1,0,0,0,,لنذهب.
Dialogue: 0,0:13:32.51,0:13:34.54,Default,Silk1,0,0,0,,-أين كبير الخصيان؟\N-لقد تحققت، فهو مشغول.
Dialogue: 0,0:13:35.07,0:13:36.48,Default,Spikyulka1,0,0,0,,لم تتمكن من العثور عليها؟
Dialogue: 0,0:13:36.54,0:13:38.14,Default,Spilik1,0,0,0,,اختفى الكتاب في الهواء.
Dialogue: 0,0:13:39.95,0:13:41.68,Default,Spikyulka1,0,0,0,,ربما خمن والد زوجي الأمر وأخفاه؟
Dialogue: 0,0:13:43.02,0:13:44.35,Default,Spilik1,0,0,0,,ليس الأمر كذلك.
Dialogue: 0,0:13:44.35,0:13:46.89,Default,Spikyulka1,0,0,0,,لم يتغير سلوكه حتى رحيلي.
Dialogue: 0,0:13:47.55,0:13:50.26,Default,Spikyulka1,0,0,0,,وهو بالتأكيد لا يعرف كيف يخفي مشاعره.
Dialogue: 0,0:13:50.79,0:13:52.19,Default,Spikyulka1,0,0,0,,إذًا كان هذا؟
Dialogue: 0,0:13:52.99,0:13:54.56,Default,Spilik1,0,0,0,,في قناع من قسم المباحث.
Dialogue: 0,0:13:54.56,0:13:58.63,Default,Spiky1,0,0,0,,إذا وقع دفتر المحاسبة في يد كيم جواجين، فلن نراه مرة أخرى.
Dialogue: 0,0:13:58.63,0:14:00.63,Default,Spilik1,0,0,0,,ليس لديه طريقة لمعرفة المكان الذي تم نقلها إليه.
Dialogue: 0,0:14:00.63,0:14:02.50,Default,Spilik1,0,0,0,,هذا شيء من هذا القبيل،
Dialogue: 0,0:14:02.50,0:14:04.90,Default,Spiky1,0,0,0,,أن والد زوجك لن يتمكن من إخبار أحد بأنه فقده.
Dialogue: 0,0:14:05.17,0:14:07.17,Default,Spilik1,0,0,0,,سيعاني وحده.
Dialogue: 0,0:14:07.37,0:14:10.88,Default,Spikyulka1,0,0,0,,سيبدأ بالبحث عن دفتر المحاسبة.
Dialogue: 0,0:14:12.31,0:14:13.75,Default,Spikyulka1,0,0,0,,وسوف يفعل ذلك بنفسه.
Dialogue: 0,0:14:13.75,0:14:15.38,Default,Spikyulka1,0,0,0,,دعهم يتبعونه.
Dialogue: 0,0:14:15.48,0:14:16.52,Default,Spilik1,0,0,0,,نعم.
Dialogue: 0,0:14:16.62,0:14:18.99,Default,Spikyulka1,0,0,0,,أعتقد أن العثور عليها أمر ميؤوس منه.
Dialogue: 0,0:14:19.22,0:14:20.45,Default,Spilik1,0,0,0,,حان وقت الاستسلام.
Dialogue: 0,0:14:20.45,0:14:22.82,Default,Spikyulka1,0,0,0,,بدون دفتر الأستاذ، ستذهب كل خططنا سدى.
Dialogue: 0,0:14:24.32,0:14:26.19,Default,Spikyulka1,0,0,0,,لن أستسلم بسهولة.
Dialogue: 0,0:14:28.13,0:14:31.06,Default,Spilik1,0,0,0,,تصرفي كملكة هنا، كوني مهذبة.
Dialogue: 0,0:14:31.13,0:14:32.93,Default,Spilyk1,0,0,0,,أسرع، لنذهب.
Dialogue: 0,0:14:34.70,0:14:35.77,Default,Spilik1,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:14:36.47,0:14:37.67,Default,Spilik1,0,0,0,,مرحباً سيدة البلاط تشوي!
Dialogue: 0,0:14:43.08,0:14:44.08,Default,Spilyk1,0,0,0,,جلالتك.
Dialogue: 0,0:14:44.94,0:14:46.78,Default,Spilik1,0,0,0,,اشتقت إليك كثيراً.
Dialogue: 0,0:14:47.11,0:14:50.48,Default,Spillit1,0,0,0,,سيدة البلاط تشوي. \NBring جميع الفتيات جوسون هنا.
Dialogue: 0,0:14:51.12,0:14:53.75,Default,Spilik1,0,0,0,,ولا يفوتك سجل عائلة عشيرة خان،
Dialogue: 0,0:14:53.75,0:14:54.85,Default,Spilik1,0,0,0,,أحضره لي.
Dialogue: 0,0:14:56.09,0:14:58.89,Default,Spilik1,0,0,0,,لقد بدأت في اختيار المحظيات الملكية.
Dialogue: 0,0:15:00.19,0:15:02.86,Default,Silk1,0,0,0,,بحجة اختيار المحظيات، سأدرس هذه العائلة.
Dialogue: 0,0:15:03.73,0:15:05.90,Default,Spilik1,0,0,0,,اختيار المحظيات الملكية هو الحل.
Dialogue: 0,0:15:07.20,0:15:11.27,Default,Spilik1,0,0,0,,نعم، بالضبط، أريد أن أحيي الملكة الأرملة.
Dialogue: 0,0:15:11.84,0:15:13.67,Default,Spilik1,0,0,0,,حسناً، انتظر.
Dialogue: 0,0:15:13.77,0:15:16.48,Default,Spillit1,0,0,0,,روح جانغ بونغ هوان وذكريات كيم سو يون -
Dialogue: 0,0:15:16.48,0:15:19.88,Default,Spilik1,0,0,0,,خليط مثالي لإنشاء\N ملكة خالية من العيوب.
Dialogue: 0,0:15:23.62,0:15:25.02,Default,Spilik1,0,0,0,,جلالتك.
Dialogue: 0,0:15:25.35,0:15:27.72,Default,Spilik1,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:15:28.39,0:15:30.79,Default,Spilik1,0,0,0,,هل تغير شيء؟
Dialogue: 0,0:15:30.99,0:15:33.23,Default,Spilyk1,0,0,0,,أنت تبدو مختلفاً.
Dialogue: 0,0:15:33.36,0:15:37.03,Default,Spikyulka1,0,0,0,,لقد تمكنت من البدء من جديد بعد عودتي إلى المنزل.
Dialogue: 0,0:15:37.33,0:15:39.40,Default,Spilik1,0,0,0,,هذا جيد.
Dialogue: 0,0:15:39.40,0:15:41.83,Default,Spilik1,0,0,0,,آسف لجعلك تقلق كثيراً.
Dialogue: 0,0:15:42.03,0:15:46.11,Default,Spikyulka1,0,0,0,,وأشكرك على الرغم من هذا،
Dialogue: 0,0:15:46.11,0:15:47.77,Default,Spikyulka1,0,0,0,,لقد فهمتني جيدًا.
Dialogue: 0,0:15:49.68,0:15:52.24,Default,Spilik1,0,0,0,,للتكفير عما حدث في الماضي،
Dialogue: 0,0:15:52.24,0:15:55.25,Default,Spilik1,0,0,0,,سأحاول جاهداً
Dialogue: 0,0:15:55.25,0:15:57.32,Default,Spilyk1,0,0,0,,لعب دور الملكة.
Dialogue: 0,0:15:57.62,0:16:01.12,Default,Spikyulka1,0,0,0,,إذن ستصل إلى أهم الأمور فورًا؟
Dialogue: 0,0:16:01.69,0:16:02.92,Default,Spikyulka1,0,0,0,,الآن أعرف بالضبط ما يدور حوله هذا الأمر.
Dialogue: 0,0:16:03.49,0:16:06.29,Default,Spikyulka1,0,0,0,,حالما شعرت بالتحسن، جئت،
Dialogue: 0,0:16:06.29,0:16:09.03,Default,Spilik1,0,0,0,,لفعل هذا.
Dialogue: 0,0:16:09.26,0:16:10.80,Default,Spilik1,0,0,0,,كما هو متوقع.
Dialogue: 0,0:16:10.80,0:16:12.73,Default,Spilyk1,0,0,0,,لقد رحلت لبضعة أيام فقط،
Dialogue: 0,0:16:12.90,0:16:15.77,Default,Spikyulka1,0,0,0,,ولكن لم يسعني إلا أن أفكر في الأمر.
Dialogue: 0,0:16:15.77,0:16:18.74,Default,Spilik1,0,0,0,,إذن لدينا نفس المشاعر؟
Dialogue: 0,0:16:19.71,0:16:20.94,Default,Spilik1,0,0,0,,-ثم...\N-الآن...
Dialogue: 0,0:16:20.94,0:16:22.21,Default,Spilik1,0,0,0,,-من هذه اللحظة؟\N-هل نبدأ؟
Dialogue: 0,0:16:22.21,0:16:24.21,Default,Spillie1,0,0,0,,-الملكة.\N-عمل جيد!
Dialogue: 0,0:16:29.78,0:16:32.25,Default,Spikyulka1,0,0,0,,لم أكن أفكر في ذلك على الإطلاق.
Dialogue: 0,0:16:40.36,0:16:41.43,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:16:41.66,0:16:45.06,Default,,0,0,0,,أتطلع إلى تدريبك.
Dialogue: 0,0:16:47.83,0:16:50.47,Default,,0,0,0,,على ما يبدو، لا يمكن الاستغناء عني.
Dialogue: 0,0:16:50.47,0:16:51.97,Default,,0,0,0,,لا أصدق أنني أشارك الوصفات.
Dialogue: 0,0:16:52.37,0:16:55.21,Default,,0,0,0,,لست مستعداً لأن أصبح معلماً.
Dialogue: 0,0:16:57.78,0:16:59.15,Default,,0,0,0,,ما الأمر؟ خارج الطريق.
Dialogue: 0,0:17:03.82,0:17:04.85,Default,,0,0,0,,أيها الأمهات.
Dialogue: 0,0:17:06.79,0:17:09.19,Default,,0,0,0,,يمكنك أن تأتي إلى هنا وقتما تشاء.
Dialogue: 0,0:17:09.19,0:17:11.52,Default,,0,0,0,,لكنني أخشى أن هذا لن ينجح مع الإصدار.
Dialogue: 0,0:17:35.38,0:17:36.38,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,0:17:36.92,0:17:39.32,Default,,0,0,0,,عاد جلالته إلى القصر.
Dialogue: 0,0:17:40.09,0:17:41.09,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:17:41.09,0:17:42.82,Default,,0,0,0,,هل يجب أن نذهب إلى قاعة سيونغجيونغجونغ؟
Dialogue: 0,0:17:43.59,0:17:45.62,Default,,0,0,0,,لا. دعنا نذهب إلى الحوزة الملكية.
Dialogue: 0,0:17:55.10,0:17:57.14,Default,,0,0,0,,النار ضعيفة جداً.
Dialogue: 0,0:17:57.14,0:17:58.60,Default,,0,0,0,,لذلك سيتحول كل شيء إلى هريسة.
Dialogue: 0,0:18:04.38,0:18:05.95,Default,,0,0,0,,اللهب في كل مكان.
Dialogue: 0,0:18:08.68,0:18:11.18,Default,,0,0,0,,يمكنك أيضًا رؤية اللهب في عينيك.
Dialogue: 0,0:18:11.18,0:18:13.09,Default,,0,0,0,,هذا لا يمكن أن يكون.
Dialogue: 0,0:18:13.09,0:18:14.82,Default,,0,0,0,,أنا ملتزم بالتعلم منك،
Dialogue: 0,0:18:14.82,0:18:17.49,Default,,0,0,0,,فتتألق عيناي من البهجة.
Dialogue: 0,0:18:18.59,0:18:20.33,Default,,0,0,0,,بالمناسبة، متى ستعلم الوصفة؟
Dialogue: 0,0:18:20.63,0:18:23.13,Default,,0,0,0,,أنا متأكد من أنك تعرف كيف يعمل كل شيء في المطبخ\N. لا تفعل ذلك.
Dialogue: 0,0:18:23.53,0:18:24.80,Default,,0,0,0,,للوافدين الجدد إلى المطاعم الصينية
Dialogue: 0,0:18:24.80,0:18:26.63,Default,,0,0,0,,في الشهر الأول يُسمح لك فقط بتقشير البصل.
Dialogue: 0,0:18:26.63,0:18:27.83,Default,,0,0,0,,شاهد النار.
Dialogue: 0,0:18:29.13,0:18:31.34,Default,,0,0,0,,في نهاية المطاف، أنا أعمل في المطبخ الملكي منذ 30 عاماً.
Dialogue: 0,0:18:31.34,0:18:33.51,Default,,0,0,0,,و12 عاماً كطاهٍ ملكي.
Dialogue: 0,0:18:33.51,0:18:35.24,Default,,0,0,0,,لست بحاجة إلى سيرة ذاتية.
Dialogue: 0,0:18:35.71,0:18:37.44,Default,,0,0,0,,لماذا لا نبدأ بعدّ الأيام إذن؟
Dialogue: 0,0:18:39.95,0:18:41.75,Default,,0,0,0,,أنا لا أحب موقفك.
Dialogue: 0,0:18:42.18,0:18:43.48,Default,,0,0,0,,انس الأمر.
Dialogue: 0,0:18:43.48,0:18:45.08,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:18:45.08,0:18:46.55,Default,,0,0,0,,وهكذا؟ هل هذا أفضل؟
Dialogue: 0,0:18:47.45,0:18:50.22,Default,,0,0,0,,الأفضل؟ مثله.
Dialogue: 0,0:18:50.22,0:18:51.56,Default,,0,0,0,,مرحبًا، افتح.
Dialogue: 0,0:18:53.93,0:18:55.09,Default,,0,0,0,,جانباً.
Dialogue: 0,0:19:04.44,0:19:05.77,Default,,0,0,0,,هل نظرت الآن؟
Dialogue: 0,0:19:06.14,0:19:07.77,Default,,0,0,0,,هذا جاسوس صناعي.
Dialogue: 0,0:19:08.07,0:19:10.61,Default,,0,0,0,,كنت أتساءل عما إذا تم ضبط الحرارة بشكل صحيح.
Dialogue: 0,0:19:10.61,0:19:12.95,Default,,0,0,0,,لست بحاجة إلى التفكير.\NI يمكنه التعامل مع هذا بنفسي.
Dialogue: 0,0:19:14.08,0:19:15.92,Default,,0,0,0,,لماذا تبالغ باستمرار؟
Dialogue: 0,0:19:30.00,0:19:32.20,Default,,0,0,0,,الكوكباب هو طعام تقليدي لعامة الناس.
Dialogue: 0,0:19:32.20,0:19:34.50,Default,,0,0,0,,والقائد هو المجتمع الراقي.
Dialogue: 0,0:19:39.87,0:19:43.44,Default,,0,0,0,,سأضيف بعض مرق اللحم،\N كباب لحم البقر الفرنسي.
Dialogue: 0,0:19:45.61,0:19:47.95,Default,,0,0,0,,سأتخلص من الطعم اللذيذ بمساعدة البروتينات.
Dialogue: 0,0:19:51.15,0:19:54.39,Default,,0,0,0,,يستخدم بياض البيض بطريقة جديدة تمامًا.
Dialogue: 0,0:19:55.29,0:19:57.82,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:19:58.89,0:20:00.56,Default,,0,0,0,,هل هذا جيد؟
Dialogue: 0,0:20:00.56,0:20:02.19,Default,,0,0,0,,ممتاز.
Dialogue: 0,0:20:02.19,0:20:06.00,Default,,0,0,0,,هل لي أن أعرف ما هو نوع الطعام\N الذي تحاول طهيه؟
Dialogue: 0,0:20:06.40,0:20:08.23,Default,,0,0,0,,طعام يلامس الروح.
Dialogue: 0,0:20:10.14,0:20:11.50,Default,,0,0,0,,الروح؟
Dialogue: 0,0:20:27.55,0:20:28.85,Default,,0,0,0,,ممتاز.
Dialogue: 0,0:20:28.85,0:20:31.22,Default,,0,0,0,,واللمسة الأخيرة.
Dialogue: 0,0:20:34.03,0:20:36.80,Default,,0,0,0,,-إنهم جاهزون، أليس كذلك؟\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:20:40.80,0:20:42.97,Default,,0,0,0,"إذا ماتت الرغوة، أموت أنا أيضاً."
Dialogue: 0,0:20:43.87,0:20:46.97,Default,,0,0,0,,بهذا الموقف، حاول توفير الطعام والتصرف بسرعة.
Dialogue: 0,0:20:46.97,0:20:48.91,Default,,0,0,0,,لذا. إلى الأمام!
Dialogue: 0,0:20:49.14,0:20:50.28,Default,,0,0,0,,-نعم يا صاحب الجلالة.\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:20:51.11,0:20:52.21,Default,,0,0,0,,أسرع.
Dialogue: 0,0:20:56.15,0:20:58.15,Default,,0,0,0,,سوف يعجبها أكثر،\N لأنها تعرف مذاقها.
Dialogue: 0,0:21:01.79,0:21:02.86,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:21:04.02,0:21:07.29,Default,,0,0,0,,دامهيانغ!
Dialogue: 0,0:21:09.46,0:21:14.33,Default,,0,0,0,,كنت خائفاً جداً\N لدرجة أنني لن أتمكن من رؤيتك مرة أخرى.
Dialogue: 0,0:21:16.30,0:21:19.67,Default,,0,0,0,,صحيح. شكراً جزيلاً.
Dialogue: 0,0:21:22.11,0:21:23.88,Default,,0,0,0,,لقد جعلتك تقلق.
Dialogue: 0,0:21:24.61,0:21:26.85,Default,,0,0,0,,يجب أن أُوبخ.
Dialogue: 0,0:21:28.45,0:21:30.62,Default,,0,0,0,,عذراً.
Dialogue: 0,0:21:42.03,0:21:43.06,Default,,0,0,0,,ماذا...
Dialogue: 0,0:21:44.83,0:21:47.17,Default,,0,0,0,,أنا لا أتخيل ذلك؟
Dialogue: 0,0:21:47.83,0:21:49.80,Default,,0,0,0,,هل هذا أرز وحساء؟
Dialogue: 0,0:21:49.80,0:21:53.94,Default,,0,0,0,,ويبدو لي أيضاً أن هذا هو الأرز.
Dialogue: 0,0:21:55.11,0:21:57.71,Default,,0,0,0,,هل أعطتني الكوكباب؟
Dialogue: 0,0:21:58.68,0:22:01.41,Default,,0,0,0,,للوجبات الملكية\N عليك فصل الأرز عن الحساء.
Dialogue: 0,0:22:01.41,0:22:03.85,Default,,0,0,0,,كيف تجرؤ على وضع الأرز في الحساء،\N مثل بعض الفلاحين؟
Dialogue: 0,0:22:04.62,0:22:05.95,Default,,0,0,0,,هل يجب أن آخذها بعيداً؟
Dialogue: 0,0:22:05.95,0:22:07.09,Default,,0,0,0,,بالطبع!
Dialogue: 0,0:22:10.19,0:22:11.29,Default,,0,0,0,,ولكن
Dialogue: 0,0:22:12.93,0:22:15.09,Default,,0,0,0,,بذلت الملكة الكثير من الجهد في هذا الأمر.
Dialogue: 0,0:22:17.60,0:22:19.60,Default,,0,0,0,,سأحاول على الأقل.
Dialogue: 0,0:22:20.10,0:22:21.13,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:22:36.62,0:22:40.12,Default,,0,0,0,,كنت أعدّ أيام مسيرتي المهنية
Dialogue: 0,0:22:41.02,0:22:43.16,Default,,0,0,0,,في المطبخ الملكي.
Dialogue: 0,0:22:43.62,0:22:46.23,Default,,0,0,0,,وعاش حياة نبيلة كطباخ ملكي.
Dialogue: 0,0:22:47.89,0:22:52.87,Default,,0,0,0,,لكنني أصبحت خادماً عادياً يراقب النار طوال الليل.
Dialogue: 0,0:22:54.90,0:22:57.07,Default,,0,0,0,,كل هذا بسبب الملكة.
Dialogue: 0,0:22:57.94,0:22:59.67,Default,,0,0,0,,ليس لأنني طباخة سيئة.
Dialogue: 0,0:23:00.14,0:23:03.04,Default,,0,0,0,,وذلك لأن الملكة جيدة على غير العادة.
Dialogue: 0,0:23:03.04,0:23:04.08,Default,,0,0,0,,اللعنة.
Dialogue: 0,0:23:04.08,0:23:06.61,Default,,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:23:12.62,0:23:13.82,Default,,0,0,0,,اللعنة.
Dialogue: 0,0:23:14.19,0:23:16.76,Default,,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:23:25.80,0:23:27.80,Default,,0,0,0,,-وأنت؟\N-وأنت؟
Dialogue: 0,0:23:33.21,0:23:35.01,Default,,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:23:35.01,0:23:37.11,Default,,0,0,0,,أنت قاسٍ للغاية!
Dialogue: 0,0:23:37.11,0:23:39.08,Default,,0,0,0,,الحليب لم يجف على شفتيك بعد!
Dialogue: 0,0:23:39.08,0:23:40.28,Default,,0,0,0,,يا له من القليل...
Dialogue: 0,0:23:40.95,0:23:42.55,Default,,0,0,0,,اللعنة عليك!
Dialogue: 0,0:23:42.55,0:23:44.42,Default,,0,0,0,,هل تعتقد أنني مزحة؟
Dialogue: 0,0:23:44.42,0:23:46.75,Default,,0,0,0,,أنا طباخة ماهرة!
Dialogue: 0,0:23:50.76,0:23:52.93,Default,,0,0,0,,واو، هذا ما نحتاجه بالضبط.
Dialogue: 0,0:23:59.57,0:24:01.13,Default,,0,0,0,,متى تمكنت من الاقتراب إلى هذا الحد؟
Dialogue: 0,0:24:01.83,0:24:03.47,Default,,0,0,0,,أنا لا أكرهها إلى هذه الدرجة.
Dialogue: 0,0:24:06.14,0:24:07.74,Default,,0,0,0,,لقد هاجمتني للتو.
Dialogue: 0,0:24:07.74,0:24:10.28,Default,,0,0,0,,لابد أنني فاسد،\Nمثل الخضار الفاسدة في الصيف.
Dialogue: 0,0:24:11.08,0:24:13.21,Default,,0,0,0,,كانت النار مشتعلة طوال اليوم.
Dialogue: 0,0:24:18.32,0:24:19.69,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:24:20.19,0:24:22.49,Default,,0,0,0,,لا. لم أحاول التقبيل.
Dialogue: 0,0:24:22.49,0:24:24.52,Default,,0,0,0,,-حاولت أن أشرح لك...\N-اخرج!
Dialogue: 0,0:24:25.92,0:24:27.53,Default,,0,0,0,,-أنا...\N-أغادر.
Dialogue: 0,0:24:30.76,0:24:31.83,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:24:32.87,0:24:33.93,Default,,0,0,0,,عذراً.
Dialogue: 0,0:24:34.93,0:24:36.24,Default,,0,0,0,,هنا.
Dialogue: 0,0:24:41.31,0:24:43.34,Default,,0,0,0,,لا أستطيع إهانة صاحبة الجلالة،
Dialogue: 0,0:24:43.91,0:24:45.91,Default,,0,0,0,,حتى لا تكون في نفس مستواه.
Dialogue: 0,0:24:46.48,0:24:48.61,Default,,0,0,0,,لكنني بحاجة للتنفيس.
Dialogue: 0,0:24:50.32,0:24:54.12,Default,,0,0,0,,كنت سأوقف هذا حقاً.
Dialogue: 0,0:25:17.48,0:25:19.85,Default,,0,0,0,,من أين وجهه؟
Dialogue: 0,0:25:30.89,0:25:33.93,Default,,0,0,0,,لا، لا!
Dialogue: 0,0:25:33.93,0:25:36.03,Default,,0,0,0,,لا. لا حاجة.
Dialogue: 0,0:25:37.43,0:25:40.23,Default,,0,0,0,,لا! لا! هذا لا يمكن أن يكون!
Dialogue: 0,0:25:42.51,0:25:45.85,Default,,0,0,0,,الملكة الأرملة،\Nالملكة تطلب مقابلة.
Dialogue: 0,0:25:46.05,0:25:47.25,Default,,0,0,0,,دعه يدخل.
Dialogue: 0,0:25:57.43,0:25:58.70,Default,,0,0,0,,لقد انتهيت.
Dialogue: 0,0:25:59.36,0:26:02.30,Default,,0,0,0,,بالطبع، مثل هذا الشخص عديم القلب لن يقدر غذاء الروح.
Dialogue: 0,0:26:05.54,0:26:07.74,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:26:08.81,0:26:11.54,Default,,0,0,0,,لا بد أنني فقدت مهاراتي لأنني
Dialogue: 0,0:26:11.54,0:26:14.15,Default,,0,0,0,,كان غائباً عن المطبخ لبعض الوقت.
Dialogue: 0,0:26:18.15,0:26:20.02,Default,,0,0,0,,طعمه مألوف وغريب.
Dialogue: 0,0:26:20.55,0:26:22.45,Default,,0,0,0,,مألوف ولكنه غريب.
Dialogue: 0,0:26:23.42,0:26:25.92,Default,,0,0,0,,مواهبك المتميزة في الطهي بدأت تخيفني.
Dialogue: 0,0:26:27.16,0:26:29.96,Default,,0,0,0,,حتى أنك أعدت لي ذكريات منسية منذ زمن طويل.
Dialogue: 0,0:26:30.96,0:26:32.13,Default,,0,0,0,,هنا.
Dialogue: 0,0:26:36.80,0:26:39.00,Default,,0,0,0,,أيتها الفتاة الطيبة، تناولي الطعام.
Dialogue: 0,0:26:40.91,0:26:41.97,Default,,0,0,0,,أمي.
Dialogue: 0,0:26:45.41,0:26:46.48,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:26:48.31,0:26:51.02,Default,,0,0,0,,-لديك حبة أرز هنا.\N-كيف تجرؤ!
Dialogue: 0,0:26:57.92,0:27:01.36,Default,,0,0,0,,لكنني سمعت أنك لا تريد\Nمشاركة مهاراتك.
Dialogue: 0,0:27:01.59,0:27:04.50,Default,,0,0,0,,هل تعتقد أنك لا تستطيع تدريب الشيف الملكي؟
Dialogue: 0,0:27:05.10,0:27:06.16,Default,,0,0,0,,حسناً...
Dialogue: 0,0:27:06.83,0:27:09.57,Default,,0,0,0,,هذا الرجل العجوز يثير أعصابي قليلاً.
Dialogue: 0,0:27:09.67,0:27:12.47,Default,,0,0,0,, إذًا عليك التخلص منه فورًا.
Dialogue: 0,0:27:12.80,0:27:14.74,Default,,0,0,0,,إلى جانب ذلك، كانت هناك حادثة تتعلق بالزرنيخ.
Dialogue: 0,0:27:16.01,0:27:17.24,Default,,0,0,0,,الزرنيخ؟
Dialogue: 0,0:27:17.54,0:27:18.98,Default,,0,0,0,,ألا تعلم؟
Dialogue: 0,0:27:18.98,0:27:20.75,Default,,0,0,0,,لقد وقعت في حالة غيبوبة،
Dialogue: 0,0:27:20.75,0:27:23.12,Default,,0,0,0,,لأنني ابتلعت\Npoison في المطبخ الملكي.
Dialogue: 0,0:27:23.52,0:27:24.55,Default,,0,0,0,,السم؟
Dialogue: 0,0:27:24.95,0:27:27.59,Default,,0,0,0,,إذن لم أكن لأتعافى بهذه السرعة.
Dialogue: 0,0:27:27.59,0:27:29.59,Default,,0,0,0,,
Dialogue: 0,0:27:28.42,0:27:30.42,Default,,0,0,0,,الطباخ الملكي رجل عجوز غبي،
Dialogue: 0,0:27:30.99,0:27:33.56,Default,,0,0,0,,ولكن إذا أعفيته من منصبه...
Dialogue: 0,0:27:33.56,0:27:35.09,Default,,0,0,0,,هل أعفيك من منصبك؟
Dialogue: 0,0:27:36.46,0:27:38.56,Default,,0,0,0,,سنقطع رأسه.
Dialogue: 0,0:27:47.11,0:27:49.57,Default,,0,0,0,,أتساءل من لديه دفتر المحاسبة الآن؟
Dialogue: 0,0:27:50.64,0:27:51.78,Default,,0,0,0,,والأهم من ذلك،
Dialogue: 0,0:27:52.41,0:27:54.48,Default,,0,0,0,,لماذا أخذها؟
Dialogue: 0,0:27:56.48,0:27:58.42,Default,,0,0,0,,هل سيأتي هذا بنتائج عكسية علينا؟
Dialogue: 0,0:27:59.22,0:28:00.82,Default,,0,0,0,,أم أنها ستساعدنا؟
Dialogue: 0,0:28:02.32,0:28:04.72,Default,,0,0,0,,سوف يفقد منصبه أو رأسه،
Dialogue: 0,0:28:05.12,0:28:06.39,Default,,0,0,0,,ما الذي يهمني؟
Dialogue: 0,0:28:07.93,0:28:10.26,Default,,0,0,0,,يطلبون مني مشاركة الوصفات،
Dialogue: 0,0:28:10.26,0:28:12.23,Default,,0,0,0,,مما يعني أن الحديث عن الإطاحة ليس مزحة.
Dialogue: 0,0:28:13.40,0:28:15.60,Default,,0,0,0,,ليس الرجل العجوز الذي يجب أن أقلق عليه.
Dialogue: 0,0:28:15.60,0:28:17.10,Default,,0,0,0,,أنا على وشك أن أفقد رأسي.
Dialogue: 0,0:28:19.94,0:28:22.61,Default,,0,0,0,,أوه، تشيولجونغ!
Dialogue: 0,0:28:27.08,0:28:30.12,Default,,0,0,0,,جلالة الملك، الملكة هنا.
Dialogue: 0,0:28:49.94,0:28:51.30,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:28:51.30,0:28:53.74,Default,,0,0,0,,قيل لي أن هذه هي الطريقة التي يسير بها أفراد العائلة المالكة.
Dialogue: 0,0:28:54.07,0:28:57.21,Default,,0,0,0,,أنا ملكتك المثالية.
Dialogue: 0,0:28:57.74,0:28:59.54,Default,,0,0,0,,ماذا؟ من قال؟
Dialogue: 0,0:29:00.75,0:29:02.75,Default,,0,0,0,,السيدة تشوي. خدع؟
Dialogue: 0,0:29:02.75,0:29:03.85,Default,,0,0,0,,لا، أعني...
Dialogue: 0,0:29:04.18,0:29:06.65,Default,,0,0,0,,من هي ملكتي المثالية؟
Dialogue: 0,0:29:07.89,0:29:10.76,Default,,0,0,0,,أنا كما ترون.
Dialogue: 0,0:29:14.09,0:29:16.80,Default,,0,0,0,,أنت تخيفني. كن هو نفسه كما هو الحال دائما.
Dialogue: 0,0:29:18.26,0:29:21.60,Default,,0,0,0,,بالمناسبة، أي نوع من النساء تحبين؟
Dialogue: 0,0:29:21.70,0:29:24.44,Default,,0,0,0,,جنسي؟ محبوب؟ البريء؟
Dialogue: 0,0:29:25.94,0:29:27.24,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:29:28.47,0:29:29.84,Default,,0,0,0,,قالت الملكة الأرملة
Dialogue: 0,0:29:29.84,0:29:31.21,Default,,0,0,0,,اختر لك محظيات.
Dialogue: 0,0:29:31.84,0:29:33.48,Default,,0,0,0,,الخليلات لك،
Dialogue: 0,0:29:33.48,0:29:35.11,Default,,0,0,0,,أيهما تفضل؟
Dialogue: 0,0:29:35.71,0:29:36.82,Default,,0,0,0,,المحظيات؟
Dialogue: 0,0:29:37.75,0:29:38.92,Default,,0,0,0,,المحظيات الملكية...
Dialogue: 0,0:29:39.35,0:29:40.92,Default,,0,0,0,,يا له من أحمق.
Dialogue: 0,0:29:41.65,0:29:44.29,Default,,0,0,0,,هل تريد إظهار ألوانك الحقيقية؟
Dialogue: 0,0:29:48.53,0:29:50.43,Default,,0,0,0,,فكرة رائعة.
Dialogue: 0,0:30:11.55,0:30:14.09,Default,,0,0,0,,عذراً. كنت سعيدا جدا.
Dialogue: 0,0:30:14.55,0:30:15.59,Default,,0,0,0,,حسناً.
Dialogue: 0,0:30:16.22,0:30:17.89,Default,,0,0,0,,لنكن واضحين.
Dialogue: 0,0:30:18.46,0:30:19.89,Default,,0,0,0,,أنت ملك، لكن هذا لا يعني
Dialogue: 0,0:30:19.89,0:30:22.89,Default,,0,0,0,,إنهم ملكك. إنه قديم الطراز.
Dialogue: 0,0:30:22.89,0:30:24.56,Default,,0,0,0,,إنها ليست لك.
Dialogue: 0,0:30:26.40,0:30:27.63,Default,,0,0,0,,نصيحة عظيمة.
Dialogue: 0,0:30:27.83,0:30:29.97,Default,,0,0,0,,-هذا يعني أن...\N-إنهم ملكي.
Dialogue: 0,0:30:30.20,0:30:31.87,Default,,0,0,0,,-ماذا؟\N-إنهم ملكي.
Dialogue: 0,0:30:32.64,0:30:34.81,Default,,0,0,0,,لا تقترب من الحريم.
Dialogue: 0,0:30:35.44,0:30:37.41,Default,,0,0,0,,لديك محظية رئيسية.
Dialogue: 0,0:30:37.91,0:30:39.14,Default,,0,0,0,,فهمت.
Dialogue: 0,0:30:40.38,0:30:43.05,Default,,0,0,0,,تحت شرط واحد.
Dialogue: 0,0:30:44.38,0:30:45.98,Default,,0,0,0,,-في أذنك.\N-ماذا؟ لماذا؟
Dialogue: 0,0:30:45.98,0:30:47.35,Default,,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:30:49.92,0:30:51.46,Default,,0,0,0,,سأختار جنسهم.
Dialogue: 0,0:30:52.09,0:30:53.16,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:30:53.53,0:30:57.40,Default,,0,0,0,,لا! أحتاج إلى المظهر وليس النسب.
Dialogue: 0,0:30:57.90,0:31:01.13,Default,,0,0,0,,ثم سأخبر الملكة الأرملة،
Dialogue: 0,0:31:01.13,0:31:03.94,Default,,0,0,0,,أنني لست بحاجة إلى محظيات.
Dialogue: 0,0:31:03.94,0:31:05.34,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:31:05.34,0:31:07.94,Default,,0,0,0,,دعونا لا ننتهك حدود الآخرين.
Dialogue: 0,0:31:08.27,0:31:10.61,Default,,0,0,0,,خلف مظهري، تتفقد عائلاتهم.
Dialogue: 0,0:31:11.68,0:31:14.51,Default,,0,0,0,,أنت خصمي الحقيقي.
Dialogue: 0,0:31:16.18,0:31:19.72,Default,,0,0,0,,كنت قلقة، لكنني الآن وجدت طريقة للخروج.
Dialogue: 0,0:31:24.76,0:31:25.86,Default,,0,0,0,,لا تبتسم.
Dialogue: 0,0:31:27.76,0:31:29.19,Default,,0,0,0,,ليس مسموحاً لك أن تبتسم.
Dialogue: 0,0:31:29.29,0:31:31.56,Default,,0,0,0,,ولا يمكنك الإمساك بيدي
Dialogue: 0,0:31:31.56,0:31:33.13,Default,,0,0,0,,واستلقي على بطني!
Dialogue: 0,0:31:35.03,0:31:36.57,Default,,0,0,0,,إذن لا أستطيع فعل أي شيء؟
Dialogue: 0,0:31:36.57,0:31:38.30,الافتراضي,,0,0,0,,بالضبط. كل شيء محظور.
Dialogue: 0,0:31:38.30,0:31:39.87,Default,,0,0,0,,لا تفعل شيئاً!
Dialogue: 0,0:31:42.21,0:31:43.71,Default,,0,0,0,,ليس هناك وقت لهذا.
Dialogue: 0,0:31:46.08,0:31:47.11,Default,,0,0,0,,لنذهب.
Dialogue: 0,0:31:50.68,0:31:52.48,Default,,0,0,0,,هذه ملكتي.
Dialogue: 0,0:31:53.69,0:31:56.49,Default,,0,0,0,,هل تتحدث مع جلالته؟
Dialogue: 0,0:31:58.42,0:32:00.13,Default,,0,0,0,,أعود إلى نفسي.
Dialogue: 0,0:32:04.83,0:32:06.60,Default,,0,0,0,,هل بحثت عن هذا؟
Dialogue: 0,0:32:10.54,0:32:12.34,Default,,0,0,0,,هل باعك خادمة المحكمة؟
Dialogue: 0,0:32:12.34,0:32:15.21,Default,,0,0,0,,نعم، إنها صغيرة جدًا.
Dialogue: 0,0:32:16.27,0:32:18.84,Default,,0,0,0,,كانت ترتدي زي خادمة البلاط.
Dialogue: 0,0:32:18.84,0:32:20.18,Default,,0,0,0,,هل تتذكر كيف كانت تبدو؟
Dialogue: 0,0:32:20.51,0:32:23.75,Default,,0,0,0,,يعتمد على المبلغ الذي تدفعه.
Dialogue: 0,0:32:25.35,0:32:26.95,Default,,0,0,0,,سأعود مع الفنانة.
Dialogue: 0,0:32:26.95,0:32:29.09,Default,,0,0,0,,كلما كانت ذكرياتك أوضح،
Dialogue: 0,0:32:29.65,0:32:31.16,Default,,0,0,0,,كلما سأقدم المزيد.
Dialogue: 0,0:32:44.27,0:32:45.40,Default,,0,0,0,,مرحبًا.
Dialogue: 0,0:32:51.74,0:32:53.41,Default,,0,0,0,,
Dialogue: 0,0:32:53.41,0:32:55.08,Default,,0,0,0,,استراحة
Dialogue: 0,0:33:00.49,0:33:02.82,Default,,0,0,0,,زائف، أنا متأكد من ذلك.
Dialogue: 0,0:33:02.99,0:33:05.12,Default,,0,0,0,,هل هذه المستندات مزورة؟
Dialogue: 0,0:33:05.12,0:33:07.49,Default,,0,0,0,,هذه ليست هويات زائفة تماماً.
Dialogue: 0,0:33:07.49,0:33:11.23,Default,,0,0,0,,هذه هي الوثائق المستردة للمتوفى أو المفقود.
Dialogue: 0,0:33:12.20,0:33:14.83,Default,,0,0,0,,لم يتم ذلك بطريقة خرقاء.
Dialogue: 0,0:33:15.93,0:33:18.80,Default,,0,0,0,,ربما كانت باهظة الثمن.
Dialogue: 0,0:33:25.11,0:33:26.71,Default,,0,0,0,,شكرًا لك.
Dialogue: 0,0:33:31.85,0:33:33.75,Default,,0,0,0,,مجهود كبير،
Dialogue: 0,0:33:34.92,0:33:37.16,Default,,0,0,0,,أصبح مسؤولاً منخفض الرتبة؟
Dialogue: 0,0:33:55.84,0:33:59.98,Default,,0,0,0,,جلالتك، يجب أن أعطيك شيئاً سراً.
Dialogue: 0,0:34:00.48,0:34:02.71,Default,,0,0,0,,سأنتظر في مكاننا المعتاد.
Dialogue: 0,0:34:04.28,0:34:05.45,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,0:34:12.62,0:34:15.49,Default,,0,0,0,,غادر الأمير يونبيونغ القصر.
Dialogue: 0,0:34:18.93,0:34:22.50,Default,,0,0,0,,إذًا خذ هذا إلى جلالته.
Dialogue: 0,0:34:22.87,0:34:23.90,Default,,0,0,0,,نعم.
Dialogue: 0,0:34:28.47,0:34:30.24,Default,,0,0,0,,هل لديها شيء للملك؟
Dialogue: 0,0:34:31.24,0:34:34.75,Default,,0,0,0,,لأنها لم تستطع إعطائه إياها بعد أن رأت مدى انسجامه مع الملكة،
Dialogue: 0,0:34:35.31,0:34:38.02,Default,,0,0,0,,يبدو وكأنه شيء مميز.
Dialogue: 0,0:34:40.65,0:34:43.66,Default,,0,0,0,,الجمهور الملكي في 15 دقيقة؟
Dialogue: 0,0:34:43.99,0:34:44.99,Default,,0,0,0,,نعم.
Dialogue: 0,0:34:45.02,0:34:46.59,Default,,0,0,0,,استرح قليلاً.
Dialogue: 0,0:34:47.13,0:34:48.16,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:34:56.17,0:34:58.90,Default,,0,0,0,,كتبت لك المحظية الرئيسية رسالة.
Dialogue: 0,0:35:31.54,0:35:33.17,Default,,0,0,0,,شخصياً
Dialogue: 0,0:35:42.51,0:35:45.98,Default,,0,0,0,,بينما كنت بعيداً، لم تتوقف عن العمل.
Dialogue: 0,0:35:45.98,0:35:47.99,Default,,0,0,0,,شكراً لك، ليس لدي ما أفعله هنا.
Dialogue: 0,0:35:48.25,0:35:51.56,Default,,0,0,0,,-شكراً لك يا صاحب الجلالة.\N-شكراً لك يا صاحب الجلالة.
Dialogue: 0,0:35:52.39,0:35:54.46,Default,,0,0,0,,للتعبير عن امتناني،
Dialogue: 0,0:35:54.46,0:35:56.86,Default,,0,0,0,,سأقيم وليمة في يوم العربة.
Dialogue: 0,0:35:57.46,0:35:59.66,Default,,0,0,0,,الناس لديهم شكاوى كثيرة، بما في ذلك الكوارث الطبيعية.
Dialogue: 0,0:35:59.66,0:36:02.23,Default,,0,0,0,,كرمك سيجعل الناس يفكرون،
Dialogue: 0,0:36:02.23,0:36:04.44,Default,,0,0,0,,أننا لسنا مهتمين بالأمر
Dialogue: 0,0:36:04.44,0:36:07.17,Default,,0,0,0,,ونريد فقط أن نقيم ولائم.
Dialogue: 0,0:36:07.17,0:36:10.91,Default,,0,0,0,,أعتقد أنه لا ينبغي للملك أن يتصرف بهذه الطريقة.
Dialogue: 0,0:36:11.08,0:36:12.91,Default,,0,0,0,,لكن يونغجو
Dialogue: 0,0:36:12.91,0:36:15.41,Default,,0,0,0,,الاحتفال بالتعافي,
Dialogue: 0,0:36:15.41,0:36:17.65,Default,,0,0,0,,ترتيب وليمة فاخرة.
Dialogue: 0,0:36:18.68,0:36:21.95,Default,,0,0,0,,كانت الملكة منهكة من العمل الشاق
Dialogue: 0,0:36:21.95,0:36:23.66,Default,,0,0,0,,وخرج من الحالة الخضرية.
Dialogue: 0,0:36:24.02,0:36:25.52,Default,,0,0,0,,علينا أن نحتفل بهذا.
Dialogue: 0,0:36:25.72,0:36:29.23,Default,,0,0,0,,ما زلنا نبحث عن سبب مرضها.
Dialogue: 0,0:36:29.46,0:36:31.90,Default,,0,0,0,,لم يتم تثبيته في الوقت الحالي.
Dialogue: 0,0:36:31.90,0:36:34.77,Default,,0,0,0,,لقد تعافت تماماً بعد يومين.
Dialogue: 0,0:36:34.77,0:36:36.30,Default,,0,0,0,,فقط أحتاج إلى الراحة.
Dialogue: 0,0:36:36.30,0:36:38.60,Default,,0,0,0,,-ومع ذلك...\N-Queen
Dialogue: 0,0:36:39.67,0:36:43.34,Default,,0,0,0,,تغلب على مرض خطير وتعافي.
Dialogue: 0,0:36:43.78,0:36:47.65,Default,,0,0,0,,علينا أن نحتفل بهذا الحدث الجيد.
Dialogue: 0,0:36:48.48,0:36:50.85,Default,,0,0,0,,القضية مناسبة تمامًا.
Dialogue: 0,0:36:51.42,0:36:52.45,Default,,0,0,0,,نعم.
Dialogue: 0,0:36:52.45,0:36:56.25,Default,,0,0,0,,إنه واجبي كملك وكزوج.
Dialogue: 0,0:36:56.69,0:36:59.32,Default,,0,0,0,,جلالة الملك، هذا لن ينجح.
Dialogue: 0,0:36:59.76,0:37:02.63,Default,,0,0,0,,محاولة اغتيال الملكة جريمة خطيرة.
Dialogue: 0,0:37:02.96,0:37:05.23,Default,,0,0,0,,إذا كنت مستعجلاً لترتيب وليمة...
Dialogue: 0,0:37:05.23,0:37:06.50,Default,,0,0,0,,وزير الحرب.
Dialogue: 0,0:37:07.33,0:37:09.67,Default,,0,0,0,,ألست سعيداً بشفاء الملكة؟
Dialogue: 0,0:37:10.17,0:37:11.44,Default,,0,0,0,,حقاً
Dialogue: 0,0:37:11.44,0:37:14.81,Default,,0,0,0,,هل أردت أن تتأذى الملكة؟
Dialogue: 0,0:37:15.31,0:37:17.71,Default,,0,0,0,,لا، بالطبع لا.
Dialogue: 0,0:37:18.04,0:37:19.78,Default,,0,0,0,,استخدم هذه الحالة
Dialogue: 0,0:37:20.18,0:37:23.08,Default,,0,0,0,,هل للأغراض السياسية أهم من صحة الملكة؟
Dialogue: 0,0:37:29.42,0:37:31.29,Default,,0,0,0,,اهدأ يا صاحب الجلالة.
Dialogue: 0,0:37:31.29,0:37:36.06,Default,,0,0,0,,إذا كانت هذه هي رغبتك،\N فسوف نقبل إرادتك بكل سرور.
Dialogue: 0,0:37:36.59,0:37:38.06,Default,,0,0,0,,ثم انتظر.
Dialogue: 0,0:37:39.90,0:37:43.00,Default,,0,0,0,,لقد حصلت على راحة جيدة. فقط تفيض بالطاقة.
Dialogue: 0,0:37:56.38,0:37:57.55,Default,,0,0,0,,عدو عدوّي.
Dialogue: 0,0:37:58.05,0:38:00.22,Default,,0,0,0,,سأهزم بربريًا ببربري آخر.
Dialogue: 0,0:38:00.82,0:38:02.22,Default,,0,0,0,,بحاجة إلى إنشاء عشيرة،
Dialogue: 0,0:38:02.22,0:38:03.79,Default,,0,0,0,,معارضة آل كيم.
Dialogue: 0,0:38:04.06,0:38:05.62,افتراضي,,0,0,0,,-إنشاء؟\N-استخدام
Dialogue: 0,0:38:05.62,0:38:07.49,Default,,0,0,0,,خليلة اختارتها الملكة.
Dialogue: 0,0:38:10.19,0:38:11.86,Default,معرض الرماية,0,0,0,,الشيف الملكي، أنظر؟
Dialogue: 0,0:38:11.86,0:38:14.20,Default,,0,0,0,,نعم، هيا. هل هو نفس الطعم؟
Dialogue: 0,0:38:14.20,0:38:15.80,Default,,0,0,0,,دعني أحاول.
Dialogue: 0,0:38:18.70,0:38:20.04,Default,,0,0,0,,أحضر المزيد من التوابل.
Dialogue: 0,0:38:20.04,0:38:21.37,Default,,0,0,0,,نعم. سأضيف أكثر من ذلك بقليل.
Dialogue: 0,0:38:22.37,0:38:24.78,Default,,0,0,0,,لا، لن ينجح هذا، إنه مائي. أعد ذلك.
Dialogue: 0,0:38:25.61,0:38:27.98,Default,,0,0,0,,ولماذا تحاول جاهداً؟
Dialogue: 0,0:38:30.35,0:38:33.85,Default,,0,0,0,,سوف تزداد شعبية أطباق الحليب.
Dialogue: 0,0:38:34.15,0:38:36.82,Default,,0,0,0,,لا يمكننا تجويع العجول الصغيرة.
Dialogue: 0,0:38:37.66,0:38:41.76,Default,,0,0,0,,أريد استبدال الحليب بشيء ذي طعم مماثل.
Dialogue: 0,0:38:43.96,0:38:46.23,Default,,0,0,0,,فن الطهي الجزيئي في جوسون؟
Dialogue: 0,0:38:48.57,0:38:50.94,Default,,0,0,0,,إنه يحاول جاهداً، خاصة اليوم.
Dialogue: 0,0:38:52.97,0:38:54.11,Default,,0,0,0,,الشيف الملكي.
Dialogue: 0,0:38:56.21,0:38:57.81,Default,,0,0,0,,هناك الكثير من الحزن في هاتين العينين.
Dialogue: 0,0:38:58.71,0:39:01.61,Default,,0,0,0,,أنا متأكد من أن لديه عائلة بأكملها ليطعمها.
Dialogue: 0,0:39:02.35,0:39:03.48,Default,,0,0,0,,أنا أستمع إليك.
Dialogue: 0,0:39:05.15,0:39:06.68,Default,,0,0,0,,أشعل النار.
Dialogue: 0,0:39:13.86,0:39:15.39,Default,,0,0,0,,
Dialogue: 0,0:39:17.13,0:39:19.66,Default,,0,0,0,,على هذه الأكتاف الصغيرة لرب الأسرة
Dialogue: 0,0:39:19.66,0:39:21.40,Default,,0,0,0,,يقع عبء ثقيل.
Dialogue: 0,0:39:23.90,0:39:25.80,Default,,0,0,0,,أعتقد أنني مازلت لا أعرف اسمك.
Dialogue: 0,0:39:25.80,0:39:26.90,Default,,0,0,0,,ما اسمك؟
Dialogue: 0,0:39:28.51,0:39:29.67,Default,,0,0,0,,منبوك.
Dialogue: 0,0:39:30.91,0:39:32.28,Default,,0,0,0,,أخبرني عن عائلتك.
Dialogue: 0,0:39:32.84,0:39:35.38,Default,,0,0,0,,أعتقد أن هناك 10 أشخاص في عائلتك، والجميع بحاجة إلى إطعام.
Dialogue: 0,0:39:36.31,0:39:37.45,Default,,0,0,0,,أنا وحيد.
Dialogue: 0,0:39:38.52,0:39:39.55,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:39:39.55,0:39:42.39,Default,,0,0,0,,لقد كنت أستمتع بحياة العازب لفترة طويلة.
Dialogue: 0,0:39:46.92,0:39:49.29,Default,,0,0,0,,أليس لديك عائلة تطعمها؟
Dialogue: 0,0:39:49.96,0:39:51.13,Default,,0,0,0,,فكر مرة أخرى.
Dialogue: 0,0:39:53.36,0:39:56.57,Default,,0,0,0,,حسنًا، أحيانًا أطعم القطط الضالة رؤوس الأسماك.
Dialogue: 0,0:39:56.70,0:39:58.80,الافتراضي,,0,0,0,,صحيح. هل ترى؟
Dialogue: 0,0:39:59.24,0:40:01.91,Default,,0,0,0,,بدونك ستموت القطط الضالة جوعاً.
Dialogue: 0,0:40:03.14,0:40:06.18,Default,,0,0,0,,أنا لا أفعل هذا من أجلك، ولكن من أجل تلك القطط الضالة.
Dialogue: 0,0:40:08.68,0:40:10.01,Default,,0,0,0,,سوف أشارككم الوصفة.
Dialogue: 0,0:40:10.41,0:40:13.48,Default,,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:40:14.65,0:40:16.05,Default,,0,0,0,,ما الذي تتحدث عنه. أنت مخيف.
Dialogue: 0,0:40:18.56,0:40:21.29,Default,,0,0,0,,حسناً، أحضر لي الورقة.
Dialogue: 0,0:40:32.04,0:40:33.14,Default,,0,0,0,,حضرة يونغ.
Dialogue: 0,0:40:33.14,0:40:35.17,Default,,0,0,0,,سلّم هذا إلى الطبيب الملكي.
Dialogue: 0,0:40:35.57,0:40:36.61,Default,,0,0,0,,نعم.
Dialogue: 0,0:40:44.05,0:40:46.68,Default,,0,0,0,,انصح بالأعشاب العطرية المفيدة للبشرة.
Dialogue: 0,0:40:47.65,0:40:50.25,Default,,0,0,0,,إذا لم يعجبني الأمر، احصل على مهمة جديدة.
Dialogue: 0,0:40:52.42,0:40:54.39,Default,,0,0,0,,مهمة جديدة؟
Dialogue: 0,0:40:54.73,0:40:56.43,Default,,0,0,0,,إنه أيضًا في الجانب الخلفي.
Dialogue: 0,0:40:58.60,0:41:01.50,Default,,0,0,0,,أحتاج إلى خصي هنا لاختيار محظية ملكية.
Dialogue: 0,0:41:02.60,0:41:06.50,Default,,0,0,0,,لماذا تحاول دائماً أن تجعل مني خصياً؟
Dialogue: 0,0:41:17.75,0:41:18.78,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:41:19.45,0:41:22.05,Default,,0,0,0,,خذ وقتك. يمكنك أن تؤذي نفسك بهذه الطريقة.
Dialogue: 0,0:41:26.79,0:41:29.29,Default,,0,0,0,,أين يمكنني العثور على كتب عن الأعياد الملكية؟
Dialogue: 0,0:41:30.66,0:41:32.90,Default,,0,0,0,,سأبحث عنك.
Dialogue: 0,0:41:40.74,0:41:43.61,Default,,0,0,0,,أنا مهتم بالوليمة الملكية في "يونغجو".
Dialogue: 0,0:41:44.58,0:41:45.61,Default,,0,0,0,,نعم.
Dialogue: 0,0:41:58.36,0:42:00.29,Default,,0,0,0,,ذهبت إلى قاعة سيونغ وونجونغ،
Dialogue: 0,0:42:00.29,0:42:01.93,Default,,0,0,0,,وقيل لي أنك متجه إلى هنا.
Dialogue: 0,0:42:02.96,0:42:05.33,Default,,0,0,0,,إلى ماذا أدين بفرحة رؤيتك؟
Dialogue: 0,0:42:05.83,0:42:09.87,Default,,0,0,0,,لقد اعتقدت أننا نادراً ما نرى بعضنا البعض.
Dialogue: 0,0:42:10.50,0:42:12.67,Default,,0,0,0,,أردت التحدث معك.
Dialogue: 0,0:42:28.19,0:42:29.29,Default,,0,0,0,,ساعد نفسك.
Dialogue: 0,0:42:42.93,0:42:45.94,Default,,0,0,0,,هل لأنك أعددت الشاي بنفسك؟
Dialogue: 0,0:42:46.87,0:42:48.67,Default,,0,0,0,,الطعم أصبح أكثر دقة.
Dialogue: 0,0:42:50.94,0:42:54.21,Default,,0,0,0,,عندما أنظر إليك أتذكر الملك الراحل.
Dialogue: 0,0:42:54.75,0:42:59.18,Default,,0,0,0,,لذا كان من الصعب عليّ البقاء بالقرب منك.
Dialogue: 0,0:43:00.05,0:43:03.29,Default,,0,0,0,,آسف لأنني لم أدرك ذلك سابقاً.
Dialogue: 0,0:43:03.85,0:43:08.43,Default,,0,0,0,,ظننت أنني أعرف الكثير عن الملك الراحل.
Dialogue: 0,0:43:09.33,0:43:11.16,Default,,0,0,0,,لكن ربما الملك الراحل،
Dialogue: 0,0:43:13.73,0:43:15.07,Default,,0,0,0,,يابني،
Dialogue: 0,0:43:15.73,0:43:19.27,Default,,0,0,0,,كان ملكاً أعظم مما ظننت،
Dialogue: 0,0:43:20.30,0:43:21.84,Default,,0,0,0,,بالحكم على الحقيقة
Dialogue: 0,0:43:21.84,0:43:24.74,Default,,0,0,0,,كيف حارب آل كيم من أجل السلطة العليا.
Dialogue: 0,0:43:26.94,0:43:28.78,Default,,0,0,0,,ألوم نفسي على ذلك
Dialogue: 0,0:43:29.31,0:43:32.42,Default,,0,0,0,,أنها لم تستطع استدعاء نوعها
Dialogue: 0,0:43:33.18,0:43:35.59,Default,,0,0,0,,ادعموا الملك وقضيته.
Dialogue: 0,0:43:38.42,0:43:40.56,Default,,0,0,0,,لا تلم نفسك.
Dialogue: 0,0:43:40.96,0:43:44.86,Default,,0,0,0,,أنا متأكد من أن الملك الراحل لم يكن يريد هذا.
Dialogue: 0,0:43:45.96,0:43:49.23,Default,,0,0,0,,ظننت أنه لو استطعت
Dialogue: 0,0:43:49.97,0:43:53.97,Default,,0,0,0,,أصحح خطأي بمساعدتك؟
Dialogue: 0,0:44:18.03,0:44:21.10,Default,,0,0,0,,أنا أدنى شأناً من الملك الراحل في كثير من النواحي.
Dialogue: 0,0:44:24.47,0:44:25.97,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:44:27.67,0:44:30.57,Default,,0,0,0,,إذا كنت تشارك هدف الملك الراحل،
Dialogue: 0,0:44:31.21,0:44:35.18,Default,,0,0,0,,دعني أساعدك.
Dialogue: 0,0:44:36.95,0:44:40.48,Default,,0,0,0,,لن أكرر خطئي.
Dialogue: 0,0:44:41.42,0:44:43.12,Default,,0,0,0,,سأضع ذلك في الاعتبار.
Dialogue: 0,0:44:46.22,0:44:50.53,Default,,0,0,0,,أنا سعيد جدًا لأنني تمكنت من التعرف عليك قليلًا اليوم.
Dialogue: 0,0:44:50.53,0:44:52.56,Default,,0,0,0,,لا شكرًا.
Dialogue: 0,0:44:53.16,0:44:54.43,Default,,0,0,0,,سأتركك.
Dialogue: 0,0:45:07.78,0:45:09.68,Default,,0,0,0,,سأنتظر في مكاننا المعتاد.
Dialogue: 0,0:45:31.37,0:45:33.60,Default,,0,0,0,,لقد وصل جلالته.
Dialogue: 0,0:45:40.54,0:45:43.11,Default,,0,0,0,,عذراً. منذ متى وأنت تنتظرني؟
Dialogue: 0,0:45:43.98,0:45:45.35,Default,,0,0,0,,انتظر في الخارج.
Dialogue: 0,0:45:49.12,0:45:52.26,Default,,0,0,0,,ظننت أنك لن تأتي، لذا عدت.
Dialogue: 0,0:45:52.89,0:45:54.53,Default,,0,0,0,,قرأت الرسالة متأخراً.
Dialogue: 0,0:45:55.09,0:45:56.33,Default,,0,0,0,,لذا كنت مشغولاً.
Dialogue: 0,0:45:57.29,0:45:59.06,Default,,0,0,0,, لدرجة أنهم نسوا الرسالة.
Dialogue: 0,0:45:59.06,0:46:01.57,Default,,0,0,0,,في الحقيقة جاءت الملكة الأم
Dialogue: 0,0:46:01.57,0:46:03.00,Default,,0,0,0,,تحدث معي.
Dialogue: 0,0:46:05.00,0:46:06.97,Default,,0,0,0,,ما الذي كنت تتحدث عنه؟
Dialogue: 0,0:46:07.47,0:46:08.94,Default,,0,0,0,,مجرد محادثة عادية.
Dialogue: 0,0:46:11.38,0:46:12.61,Default,,0,0,0,,يبدو أنك قد فعلت ذلك
Dialogue: 0,0:46:13.81,0:46:16.85,Default,,0,0,0,,المزيد والمزيد من الأسرار مني.
Dialogue: 0,0:46:17.85,0:46:20.92,Default,,0,0,0,,إذن ماذا تناقشت مع الملكة؟
Dialogue: 0,0:46:21.55,0:46:23.59,Default,,0,0,0,,عندما كنت في البحيرة.
Dialogue: 0,0:46:25.12,0:46:27.73,Default,,0,0,0,,-هل رأيت؟\N-ألا ينبغي عليك؟
Dialogue: 0,0:46:28.16,0:46:29.33,Default,,0,0,0,,لا.
Dialogue: 0,0:46:29.86,0:46:32.43,Default,,0,0,0,,ناقشنا اختيار المحظيات الملكية.
Dialogue: 0,0:46:33.96,0:46:35.03,Default,,0,0,0,,المحظيات.
Dialogue: 0,0:46:37.13,0:46:38.57,Default,,0,0,0,,أنا متأكد أنك رفضت.
Dialogue: 0,0:46:38.97,0:46:41.31,Default,,0,0,0,,علينا صرف انتباه آل "كيم".
Dialogue: 0,0:46:41.31,0:46:43.67,Default,,0,0,0,,إذا اصطدمنا بهم مع عدو آخر،
Dialogue: 0,0:46:43.67,0:46:45.68,Default,,0,0,0,,سوف ينسون أمر العرش لبعض الوقت.
Dialogue: 0,0:46:45.68,0:46:48.71,Default,,0,0,0,,إذن وافقت على هذا؟
Dialogue: 0,0:46:49.15,0:46:51.92,Default,,0,0,0,,-نعم.\N-هذه كل مكائد الملكة!
Dialogue: 0,0:46:52.88,0:46:53.95,Default,,0,0,0,,القرين الملكي.
Dialogue: 0,0:46:53.95,0:46:56.25,Default,,0,0,0,,لماذا تناديني بالقرينة الملكية؟
Dialogue: 0,0:46:56.49,0:46:59.19,Default,,0,0,0,,لماذا لم تناديني بالاسم بعد الآن؟
Dialogue: 0,0:47:00.06,0:47:04.76,Default,,0,0,0,,قلت إنني وحدي من يستطيع أن يجعلك سعيداً أو حزيناً.
Dialogue: 0,0:47:05.50,0:47:06.90,Default,,0,0,0,,ولكن الآن
Dialogue: 0,0:47:07.26,0:47:09.97,Default,,0,0,0,,لم يعد الأمر متعلقًا بي، أليس كذلك؟
Dialogue: 0,0:47:11.17,0:47:14.51,Default,,0,0,0,,-هواجين.\N-من فضلك أخبرني كيف تشعر.
Dialogue: 0,0:47:15.57,0:47:16.81,Default,,0,0,0,,حقاً
Dialogue: 0,0:47:18.78,0:47:21.15,Default,,0,0,0,,هل وقعت في حب الملكة؟
Dialogue: 0,0:47:30.82,0:47:32.82,Default,,0,0,0,,أساس المطبخ الغربي هو الصلصة والصلصة.
Dialogue: 0,0:47:33.09,0:47:35.03,Default,,0,0,0,,وفي الوقت نفسه، يعد التزود بالوقود هو أهم ما يميز السيارة.
Dialogue: 0,0:47:35.86,0:47:36.89,Default,,0,0,0,,حاول.
Dialogue: 0,0:47:38.46,0:47:41.80,Default,,0,0,0,,إذا استخدمت هذا، هل يمكنني صنع الحليب من الفول؟
Dialogue: 0,0:47:43.90,0:47:45.04,Default,,0,0,0,,ولكن لماذا أنت وحدك؟
Dialogue: 0,0:47:45.67,0:47:46.70,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:47:49.11,0:47:51.61,Default,,0,0,0,,لم يكن لدي الوقت للزواج بسبب وظيفتي بدوام كامل.
Dialogue: 0,0:47:52.64,0:47:53.91,Default,,0,0,0,,ماذا عن الوالدين والأقارب الآخرين؟
Dialogue: 0,0:47:55.68,0:47:58.35,Default,,0,0,0,,في عام 1839، قُتل جميع الكاثوليك.
Dialogue: 0,0:47:58.35,0:47:59.68,Default,,0,0,0,,فبقيت وحدي.
Dialogue: 0,0:48:01.92,0:48:04.05,Default,,0,0,0,,لماذا أصبحوا كاثوليك؟
Dialogue: 0,0:48:04.76,0:48:07.22,Default,,0,0,0,,لهذا السبب لا أؤمن بأي شيء.
Dialogue: 0,0:48:08.43,0:48:09.73,Default,,0,0,0,,الاضطهاد الكاثوليكي.
Dialogue: 0,0:48:12.43,0:48:13.53,Default,,0,0,0,,لا بد أنك وحيد.
Dialogue: 0,0:48:14.70,0:48:16.97,Default,,0,0,0,,لست الوحيد الذي انتهى به الأمر بهذه الطريقة.
Dialogue: 0,0:48:18.84,0:48:21.64,Default,,0,0,0,,من المحزن بعض الشيء قضاء العطلة بمفردك،
Dialogue: 0,0:48:22.81,0:48:24.17,Default,,0,0,0,,لكن علامة الزائد هي،
Dialogue: 0,0:48:25.61,0:48:29.61,Default,,0,0,0,,أنهما ماتا في نفس اليوم،\Nلذا يكون التشييع مرة واحدة فقط في السنة.
Dialogue: 0,0:48:37.62,0:48:39.22,Default,,0,0,0,,ما خطبكم جميعاً؟
Dialogue: 0,0:48:39.36,0:48:41.93,Default,,0,0,0,,كيف عرفت أنني عرضة لرائحة الحزن؟
Dialogue: 0,0:48:43.43,0:48:45.43,Default,,0,0,0,,-رائحة الحزن؟\N-الطعام له رائحة الحزن.
Dialogue: 0,0:48:46.56,0:48:48.90,Default,,0,0,0,,عندما يكون الطباخ حزيناً والطعام مشبعاً بالحزن.
Dialogue: 0,0:48:50.20,0:48:51.27,Default,,0,0,0,,كنت أعرف.
Dialogue: 0,0:48:51.57,0:48:53.84,Default,,0,0,0,,لذلك سواء كان الأمر سعادة أو حزناً،
Dialogue: 0,0:48:53.84,0:48:57.04,Default,,0,0,0,,تركت كل مشاعري عند الباب،
Dialogue: 0,0:48:57.04,0:48:58.94,Default,,0,0,0,,قبل دخول المطبخ.
Dialogue: 0,0:48:59.41,0:49:00.91,Default,,0,0,0,,لكنك تغضب دائماً.
Dialogue: 0,0:49:00.91,0:49:04.52,Default,,0,0,0,,لأنك كلما أتيت تزعلني.
Dialogue: 0,0:49:06.38,0:49:09.29,Default,,0,0,0,,لوم نفسك على قلة الممارسة. ليست هناك حاجة للآخرين.
Dialogue: 0,0:49:09.49,0:49:11.76,Default,,0,0,0,,فقط أنظر إلى هذا.
Dialogue: 0,0:49:11.76,0:49:12.99,Default,,0,0,0,,انظر إلى هذا؟
Dialogue: 0,0:49:13.56,0:49:14.73,Default,,0,0,0,,هل قلت "هذا"؟
Dialogue: 0,0:49:14.93,0:49:16.49,Default,,0,0,0,,انظر إليك.
Dialogue: 0,0:49:17.96,0:49:19.20,Default,,0,0,0,,الأمر أسوأ من ذلك!
Dialogue: 0,0:49:19.80,0:49:21.90,Default,,0,0,0,,كان يجب أن نسمح لك بالقتل.
Dialogue: 0,0:49:23.03,0:49:25.27,Default,,0,0,0,,أنا لطيف جدًا.
Dialogue: 0,0:49:38.12,0:49:40.45,Default,,0,0,0,,لقد أكلت للتو.
Dialogue: 0,0:49:41.42,0:49:42.75,Default,,0,0,0,,لا أعرف السبب.
Dialogue: 0,0:49:54.43,0:49:57.23,Default,,0,0,0,,هذا ليس من أجل الطعام. نعلق
Dialogue: 0,0:49:57.97,0:49:59.44,Default,,0,0,0,,على وجهك.
Dialogue: 0,0:50:01.91,0:50:04.38,Default,,0,0,0,,لذلك سأصبح لا غنى عني:
Dialogue: 0,0:50:05.28,0:50:07.95,Default,,0,0,0,,الطعام الكوري والعناية الشخصية الكورية.
Dialogue: 0,0:50:13.52,0:50:15.89,Default,,0,0,0,,الطقس المناسب لتجفيف الخضار.
Dialogue: 0,0:50:36.07,0:50:37.17,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:50:38.18,0:50:40.54,Default,,0,0,0,,لم أراك بالأمس.
Dialogue: 0,0:50:40.54,0:50:43.11,Default,,0,0,0,,آمل ألا تكون مصابًا بمخلفات سيئة.
Dialogue: 0,0:50:50.75,0:50:52.66,Default,,0,0,0,,آسف لترك مشاركتي.
Dialogue: 0,0:50:54.19,0:50:56.19,Default,,0,0,0,,أود التحدث معك.
Dialogue: 0,0:50:58.10,0:51:00.96,Default,,0,0,0,,هل تتذكر ماذا حدث قبل أن تدخل في حالة غيبوبة؟
Dialogue: 0,0:51:01.37,0:51:04.60,Default,,0,0,0,,لم ألاحظ أي شيء أو أي شخص مريب؟
Dialogue: 0,0:51:05.10,0:51:07.20,Default,,0,0,0,,تحت شخص مشبوه
Dialogue: 0,0:51:07.37,0:51:09.54,Default,,0,0,0,,من تقصد؟
Dialogue: 0,0:51:09.64,0:51:10.97,Default,,0,0,0,,أياً كان.
Dialogue: 0,0:51:11.21,0:51:13.71,Default,,0,0,0,,حسنًا، لأكون صادقًا،
Dialogue: 0,0:51:13.71,0:51:16.51,Default,,0,0,0,,أعتقد أن حالتي كانت مرتبطة بقوى دنيوية أخرى.
Dialogue: 0,0:51:16.51,0:51:19.28,Default,,0,0,0,,بالقوى الدنيوية الأخرى\N هل تقصد العدو؟
Dialogue: 0,0:51:19.28,0:51:20.48,Default,,0,0,0,,لا.
Dialogue: 0,0:51:22.22,0:51:26.69,Default,dash,0,0,0,,أعني أن الأمر حدث بشكل طبيعي.
Dialogue: 0,0:51:27.69,0:51:30.19,Default,,0,0,0,,سوف تُصدم، لكنني سأقولها على أية حال.
Dialogue: 0,0:51:30.86,0:51:33.43,Default,,0,0,0,,أظن أن الملك متورط في هذا.
Dialogue: 0,0:51:34.20,0:51:36.20,Default,,0,0,0,,حسب التحقيقات,
Dialogue: 0,0:51:36.20,0:51:38.20,Default,,0,0,0,,الرجل الذي هاجمك في "أوكتاجيون"،
Dialogue: 0,0:51:39.27,0:51:41.47,Default,,0,0,0,,أرسله جلالته.
Dialogue: 0,0:51:42.64,0:51:44.44,Default,,0,0,0,,عرفت أنك ستصاب بالصدمة.
Dialogue: 0,0:51:44.94,0:51:46.11,Default,,0,0,0,,كيف عرفت؟
Dialogue: 0,0:51:46.81,0:51:48.25,Default,,0,0,0,,أنا الوحيد الذي يعرف هذا الأمر.
Dialogue: 0,0:51:49.28,0:51:50.95,Default,,0,0,0,,هل تعلم؟
Dialogue: 0,0:51:51.92,0:51:53.38,Default,,0,0,0,,حسناً، هذا هو الأمر.
Dialogue: 0,0:51:54.08,0:51:56.09,Default,,0,0,0,,كل شيء محير للغاية،
Dialogue: 0,0:51:56.09,0:51:58.12,Default,,0,0,0,,لذلك قررنا أن ننسى هذه الحادثة.
Dialogue: 0,0:51:58.12,0:52:01.06,Default,,0,0,0,,وتصرفت وكأن شيئاً لم يحدث؟
Dialogue: 0,0:52:01.56,0:52:04.76,Default,,0,0,0,,هل مازلت تحبينه رغم ما فعله؟
Dialogue: 0,0:52:05.13,0:52:07.33,Default,,0,0,0,,ماذا؟ حب؟
Dialogue: 0,0:52:07.87,0:52:10.50,Default,,0,0,0,,يا له من رجس!
Dialogue: 0,0:52:11.13,0:52:14.40,Default,,0,0,0,,أريد أن أعيش هنا بسعادة،\N يجب أن أنسجم مع الملك.
Dialogue: 0,0:52:14.51,0:52:16.61,Default,,0,0,0,,ليس لدي خيار!
Dialogue: 0,0:52:16.61,0:52:17.88,Default,,0,0,0,,إذن كيف يمكنك...
Dialogue: 0,0:52:17.88,0:52:18.98,Default,,0,0,0,,أنا بالفعل في حيرة من أمري،
Dialogue: 0,0:52:18.98,0:52:20.48,Default,,0,0,0,,وأنت تتحدث عن الحب هنا.
Dialogue: 0,0:52:22.35,0:52:24.21,Default,,0,0,0,,كيف يتم اختيار المحظيات؟
Dialogue: 0,0:52:24.55,0:52:25.75,Default,,0,0,0,,السيدة تشوي!
Dialogue: 0,0:52:25.98,0:52:27.28,Default,,0,0,0,,السيدة تشوي!
Dialogue: 0,0:52:35.32,0:52:37.72,Default,,0,0,0,,يا فتيات، أنا هنا!..
Dialogue: 0,0:52:40.16,0:52:41.96,Default,,0,0,0,,أين المرشحين؟
Dialogue: 0,0:52:42.63,0:52:45.30,Default,,0,0,0,,إنهم هنا.
Dialogue: 0,0:52:56.78,0:52:57.78,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:52:57.78,0:52:59.91,Default,,0,0,0,,كنت أتطلع إلى هذا.
Dialogue: 0,0:53:01.68,0:53:04.92,Default,,0,0,0,,ما الأمر؟
Dialogue: 0,0:53:22.17,0:53:26.04,Default,,0,0,0,,لا أستطيع رفض المشكال.
Dialogue: 0,0:53:35.05,0:53:37.92,Default,,0,0,0,,لقد ذهبت إلى هذا الحد من أجل عائلتنا؟
Dialogue: 0,0:53:47.03,0:53:49.10,Default,,0,0,0,,مرة أخرى، ما اسمه؟
Dialogue: 0,0:53:50.03,0:53:52.23,Default,,0,0,0,,أطلقت عليه حجاب الجمال.
Dialogue: 0,0:53:52.70,0:53:54.77,Default,,0,0,0,,كنت أبحث عن شخص ليحل محلها،
Dialogue: 0,0:53:55.17,0:53:57.47,Default,,0,0,0,,وأعطتني علاجاً جديداً.
Dialogue: 0,0:54:00.11,0:54:01.74,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:54:01.74,0:54:03.38,Default,,0,0,0,,هذا هو رئيس قسم المباحث، كيم بيونغين.
Dialogue: 0,0:54:05.31,0:54:06.58,Default,,0,0,0,,في هذه الساعة؟
Dialogue: 0,0:54:08.98,0:54:10.12,Default,,0,0,0,,أدخل.
Dialogue: 0,0:54:26.37,0:54:28.84,Default,,0,0,0,,ذكرتك في حديث مع أخي فقال لك تعال،
Dialogue: 0,0:54:29.27,0:54:31.04,Default,,0,0,0,,لكن الوقت قد فات الآن.
Dialogue: 0,0:54:31.24,0:54:33.37,Default,,0,0,0,,لم أتلق مثل هذه الرسالة.
Dialogue: 0,0:54:34.84,0:54:37.18,Default,,0,0,0,,تجرأت وأصررت على مقابلتك، كما يجب عليّ
Dialogue: 0,0:54:37.54,0:54:40.18,Default,,0,0,0,,قل شيئاً لتتجاوز والدك.
Dialogue: 0,0:54:42.45,0:54:43.65,Default,,0,0,0,,ربما والدي
Dialogue: 0,0:54:44.85,0:54:47.19,Default,,0,0,0,,قال إن جلالته يختلف عن سلفه.
Dialogue: 0,0:54:49.99,0:54:51.89,Default,,0,0,0,,لكنه كان مخطئاً.
Dialogue: 0,0:55:08.24,0:55:09.28,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:55:12.48,0:55:13.48,Default,,0,0,0,,لا...
Dialogue: 0,0:55:17.05,0:55:18.92,Default,,0,0,0,,لا تتبعني.
Dialogue: 0,0:55:24.12,0:55:25.53,Default,,0,0,0,,إنها مجرد أشياء تافهة.
Dialogue: 0,0:55:26.96,0:55:28.33,Default,,0,0,0,,القليل من الجينسنغ الأحمر.
Dialogue: 0,0:55:28.93,0:55:31.36,Default,,0,0,0,,-هنا، خذها.\N-شكراً لك.
Dialogue: 0,0:55:34.00,0:55:38.11,Default,,0,0,0,,بالمناسبة، هل كل شيء على ما يرام؟
Dialogue: 0,0:55:38.11,0:55:39.91,Default,,0,0,0,,بماذا؟
Dialogue: 0,0:55:40.71,0:55:43.04,Default,,0,0,0,,لا داعي للحديث عن الألغاز، ادخل في صلب الموضوع.
Dialogue: 0,0:55:43.04,0:55:44.98,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:55:45.65,0:55:48.88,Default,,0,0,0,,كنت أتساءل فقط كيف تسير الأمور.
Dialogue: 0,0:55:50.55,0:55:55.46,Default,,0,0,0,,أفترض أن بنين لا تزال في القصر؟
Dialogue: 0,0:56:03.56,0:56:05.13,Default,,0,0,0,,تحياتي.
Dialogue: 0,0:56:06.43,0:56:08.90,Default,,0,0,0,,-لقد عدت.\N-لقد تأخرت اليوم.
Dialogue: 0,0:56:08.90,0:56:12.37,Default,,0,0,0,,ليس هناك وقت أبدًا للتواجد مع الزملاء فقط،
Dialogue: 0,0:56:12.37,0:56:14.04,Default,,0,0,0,,فشربت معهم في قسم المباحث.
Dialogue: 0,0:56:14.51,0:56:15.58,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:56:16.18,0:56:18.51,Default,,0,0,0,,لقد فات الأوان. اذهب للحصول على بعض الراحة.
Dialogue: 0,0:56:19.01,0:56:21.68,Default,,0,0,0,,حسنًا، عد إلى محادثتك.
Dialogue: 0,0:56:22.78,0:56:25.25,Default,,0,0,0,,حسنًا. طاب مساؤك.
Dialogue: 0,0:56:30.49,0:56:32.23,Default,,0,0,0,,-الوزير\N-نعم.
Dialogue: 0,0:56:32.99,0:56:34.49,Default,,0,0,0,,تبدو قلقاً.
Dialogue: 0,0:56:35.90,0:56:39.33,Default,,0,0,0,,القضم أكثر مما تستطيع مضغه سيجعلك متوتراً.
Dialogue: 0,0:56:39.33,0:56:42.40,Default,,0,0,0,,ماذا... لا أفهم تماماً.
Dialogue: 0,0:56:42.94,0:56:44.27,Default,,0,0,0,,أنت لا تفهم أنك تستطيع
Dialogue: 0,0:56:44.27,0:56:48.11,Default,,0,0,0,,هل تجلب الكارثة لنفسك وللملكة بتهورك؟
Dialogue: 0,0:56:48.34,0:56:49.94,Default,,0,0,0,,إذا كنت قلقًا، فهذا بسبب
Dialogue: 0,0:56:51.11,0:56:53.88,Default,,0,0,0,,لم يكن من الممكن القبض على الشخص الذي هاجم الملكة.
Dialogue: 0,0:56:55.28,0:56:58.32,Default,,0,0,0,,-هل هذا صحيح؟\N-حسناً، لقد فات الأوان.
Dialogue: 0,0:56:58.32,0:56:59.89,Default,,0,0,0,,لا بد أنك متعب.
Dialogue: 0,0:57:00.65,0:57:03.02,Default,,0,0,0,,لقد جئت للتو لتقديم هدية،
Dialogue: 0,0:57:03.49,0:57:04.86,Default,,0,0,0,,يجب أن أذهب.
Dialogue: 0,0:57:12.33,0:57:14.40,Default,,0,0,0,,لقد فقد دفتر الأستاذ.
Dialogue: 0,0:57:15.07,0:57:17.30,Default,,0,0,0,,إذا لم يكن له علاقة بالأمر، فهل هذا يعني أن بيونين تصرف من تلقاء نفسه؟
Dialogue: 0,0:57:18.27,0:57:19.44,Default,,0,0,0,,وإن لم يكن...
Dialogue: 0,0:57:20.67,0:57:21.71,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:57:49.07,0:57:52.01,Default,,0,0,0,,شكرًا لك، هذا ليس أنا.
Dialogue: 0,0:57:53.81,0:57:56.34,Default,,0,0,0,,لقد استغرق وقتاً طويلاً
Dialogue: 0,0:57:56.88,0:57:58.85,Default,,0,0,0,,العثور على جثة مماثلة.
Dialogue: 0,0:57:59.08,0:58:00.78,Default,,0,0,0,,أخبرني عنها.
Dialogue: 0,0:58:00.78,0:58:02.55,Default,,0,0,0,,لقد غرقت.
Dialogue: 0,0:58:02.55,0:58:06.75,Default,,0,0,0,,لا يمكن التعرف على الوجه لأنه ظل في الماء لفترة طويلة.
Dialogue: 0,0:58:11.16,0:58:13.93,Default,,0,0,0,,من فضلك أخبرني بما تشعر به.
Dialogue: 0,0:58:15.96,0:58:17.13,Default,,0,0,0,,هل أنت
Dialogue: 0,0:58:19.17,0:58:21.33,Default,,0,0,0,,هل وقعت في حب الملكة؟
Dialogue: 0,0:58:27.34,0:58:28.38,Default,,0,0,0,,أنا
Dialogue: 0,0:58:30.94,0:58:33.21,Default,,0,0,0,,يجب ألا تحب الملكة.
Dialogue: 0,0:58:35.68,0:58:37.42,Default,,0,0,0,,أنت لا تنكر أنك واقع في الحب.
Dialogue: 0,0:58:38.65,0:58:40.39,Default,,0,0,0,,فقط قل أنه لا ينبغي أن تحب.
Dialogue: 0,0:58:55.17,0:58:57.30,Default,,0,0,0,,صاحب السمو، الأمير يونبيونغ هنا.
Dialogue: 0,0:58:58.17,0:58:59.64,Default,,0,0,0,,نعم، سجل الدخول.
Dialogue: 0,0:59:08.18,0:59:09.92,Default,,0,0,0,,آسف على الزيارة المتأخرة.
Dialogue: 0,0:59:09.92,0:59:11.18,Default,,0,0,0,,لدي الأخبار التي كنت تنتظرها.
Dialogue: 0,0:59:12.19,0:59:13.69,Default,,0,0,0,,هل وجدت أوفول؟
Dialogue: 0,0:59:25.00,0:59:27.23,Default,,0,0,0,,هل أعطيتها هذه؟
Dialogue: 0,0:59:28.77,0:59:31.34,Default,,0,0,0,,نعم، هذه هديتي.
Dialogue: 0,0:59:31.34,0:59:34.17,Default,,0,0,0,,باعته سيدة البلاط.
Dialogue: 0,0:59:37.14,0:59:40.11,Default,,0,0,0,,إذن أوفول على قيد الحياة. يا لها من نعمة.
Dialogue: 0,0:59:41.92,0:59:44.72,Default,,0,0,0,,لماذا ترسلني لطلب الماء في منتصف الليل؟
Dialogue: 0,0:59:45.95,0:59:47.55,Default,,0,0,0,,لم يتمكنوا من السؤال من قبل.
Dialogue: 0,0:59:57.06,0:59:58.30,Default,,0,0,0,,هل هناك شيء عالق هناك؟
Dialogue: 0,1:00:02.60,1:00:03.94,Default,,0,0,0,,ما هذا؟
Dialogue: 0,1:00:17.68,1:00:20.29,Default,,0,0,0,,لقد استأجرت فناناً ليرسم صورة لتلك السيدة.
Dialogue: 0,1:00:20.62,1:00:22.32,Default,,0,0,0,,بمجرد أن نراها، سنعرف ذلك على وجه اليقين.
Dialogue: 0,1:00:29.66,1:00:32.50,Default,,0,0,0,,لقد فكرت حقاً في طريقة لمساعدة الملك...
Dialogue: 0,1:00:32.50,1:00:33.53,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,1:00:35.54,1:00:36.70,Default,,0,0,0,,في البئر...
Dialogue: 0,1:00:37.67,1:00:40.11,Default,,0,0,0,,-في البئر؟\N-وجدوا جثة هناك.
Dialogue: 0,1:00:40.11,1:00:43.54,Default,,0,0,0,,يبدو مثل أوفول، خادمتك.
Dialogue: 0,1:00:44.18,1:00:45.18,Default,,0,0,0,,أوفول؟
Dialogue: 0,1:00:48.25,1:00:49.35,Default,,0,0,0,,-ماذا يجب أن نفعل؟\N-هذه هي المشكلة.
Dialogue: 0,1:00:59.76,1:01:01.19,Default,,0,0,0,,قد يؤذيك هذا.
Dialogue: 0,1:01:01.66,1:01:03.46,Default,,0,0,0,,-دعني...\N-No.
Dialogue: 0,1:01:04.30,1:01:06.40,Default,,0,0,0,,يجب أن أرى بنفسي.
Dialogue: 0,1:01:42.00,1:01:43.34,Default,,0,0,0,,-هل رأيت هذا؟\N-هذا فظيع.
Dialogue: 0,1:01:45.54,1:01:47.84,Default,,0,0,0,,يبدو أنها كانت تحت الماء لفترة طويلة.
Dialogue: 0,1:01:48.98,1:01:52.95,Default,,0,0,0,,أنا أفهم كم يجب أن يكون هذا مؤلمًا.
Dialogue: 0,1:02:19.94,1:02:21.07,Default,,0,0,0,,من فضلك توقف.
Dialogue: 0,1:02:22.81,1:02:24.54,Default,,0,0,0,,لقد بدأت للتو.
Dialogue: 0,1:02:24.94,1:02:25.95,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,1:02:27.48,1:02:28.98,Default,,0,0,0,,أريد أن أكون وحدي.
Dialogue: 0,1:03:11.66,1:03:12.86,Default,,0,0,0,,هذا,
Dialogue: 0,1:03:14.09,1:03:16.16,Default,,0,0,0,,من يسعدني ويحزنني.
Dialogue: 0,1:03:17.70,1:03:20.73,Default,,0,0,0,,جلالتك، الملكة الأرملة هنا.
Dialogue: 0,1:03:29.81,1:03:31.01,Default,,0,0,0,,ما الذي جاء بك؟
Dialogue: 0,1:03:42.32,1:03:44.39,Default,,0,0,0,,ماذا قرأت؟
Dialogue: 0,1:03:44.99,1:03:47.93,Default,,0,0,0,,إذن أحد الطلبات التي فاتني.
Dialogue: 0,1:03:47.93,1:03:50.60,Default,,0,0,0,,تبدو أكثر حيوية من المعتاد،
Dialogue: 0,1:03:51.30,1:03:53.33,Default,,0,0,0,,لذا أشعر بالفضول حول كيفية قضاء وقتي خارج القصر.
Dialogue: 0,1:03:53.33,1:03:54.87,Default,,0,0,0,,هذا ما جئت لأسأل عنه.
Dialogue: 0,1:03:55.20,1:03:56.97,Default,,0,0,0,,كان من الجيد أن أنسى لبعض الوقت
Dialogue: 0,1:03:56.97,1:03:58.71,Default,,0,0,0,,عن شؤون القصر.
Dialogue: 0,1:04:00.11,1:04:01.24,Default,,0,0,0,,سعيد لسماع ذلك.
Dialogue: 0,1:04:04.48,1:04:05.48,Default,,0,0,0,,كما تعلم،
Dialogue: 0,1:04:06.41,1:04:08.98,Default,,0,0,0,,أتمنى لك السعادة.
Dialogue: 0,1:04:12.39,1:04:13.62,Default,,0,0,0,,شكراً جزيلا لك.
Dialogue: 0,1:04:14.35,1:04:17.29,Default,,0,0,0,,لقد مررت بالكثير.
Dialogue: 0,1:04:18.83,1:04:20.29,Default,,0,0,0,,هل نسيت كل شيء بالفعل؟
Dialogue: 0,1:04:21.63,1:04:24.50,Default,,0,0,0,,يمكن توريث القدر.
Dialogue: 0,1:04:25.57,1:04:28.13,Default,,0,0,0,,سوف تتعلم أن تكون ممتنًا لموقفك ولا تفعل شيئًا،
Dialogue: 0,1:04:28.13,1:04:32.34,Default,,0,0,0,,ستظل أنت ومن تحب آمناً.
Dialogue: 0,1:04:33.51,1:04:36.91,Default,,0,0,0,,فلماذا لا يمكنك الجلوس وعدم فعل أي شيء؟
Dialogue: 0,1:04:40.25,1:04:43.18,Default,,0,0,0,,كن ذكياً أيها الملك.
Dialogue: 0,1:04:46.25,1:04:48.76,Default,,0,0,0,,سأفعل يا صاحب الجلالة.
Dialogue: 0,1:05:20.29,1:05:21.95,افتراضي,,0,0,0,,سرّي
Dialogue: 0,1:05:49.28,1:05:50.88,Default,,0,0,0,,كن ذكياً,
Dialogue: 0,1:05:51.62,1:05:52.79,Default,,0,0,0,,حبيبتي.
Dialogue: 0,1:06:35.23,1:06:37.76,Default,,0,0,0,,بعض الناس يعيشون في كابوس.
Dialogue: 0,1:07:02.02,1:07:05.19,Default,,0,0,0,,قاموس الملكة.
Dialogue: 0,1:07:11.30,1:07:14.43,Default,,0,0,0,,التباعد الاجتماعي
Dialogue: 0,1:07:18.87,1:07:23.08,Default,,0,0,0,,لذلك كل شخص بمفرده.
Dialogue: 0,1:07:25.31,1:07:29.12,Default,,0,0,0,,أنتيفان: المرشد الروحي القوي
Dialogue: 0,1:07:29.12,1:07:31.52,Default,,0,0,0,,مروحة, الشبكات الاجتماعية, الهاتف,
Dialogue: 0,1:07:31.52,1:07:33.12,Default,,0,0,0,,المواجهة، هيا نضيء،
Dialogue: 0,1:07:33.12,1:07:34.89,Default,,0,0,0,,القوات الخاصة، اليانصيب، الجائزة الكبرى.
Dialogue: 0,1:07:38.49,1:07:39.83,Default,,0,0,0,,لكنهم غالباً ما يجدون
Dialogue: 0,1:07:40.26,1:07:42.86,Default,,0,0,0,,بإمكانك التغلب على الكوابيس.
Dialogue: 0,1:08:13.69,1:08:15.90,Default,,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,1:08:16.06,1:08:17.60,Default,,0,0,0,,تعال إلينا.
Dialogue: 0,1:08:17.60,1:08:18.73,Default,,0,0,0,,سارع إلينا.
Dialogue: 0,1:08:18.73,1:08:19.87,Default,,0,0,0,,حسناً، تعال هنا.
Dialogue: 0,1:08:33.98,1:08:35.95,Default,,0,0,0,,لكن للأحلام السعيدة فقط
Dialogue: 0,1:08:36.42,1:08:38.62,Default,,0,0,0,,أبعد كابوسك...
Dialogue: 0,1:08:45.06,1:08:47.43,Default,,0,0,0,,-أريد عناقاً أيضاً.\N-وأنت؟
Dialogue: 0,1:08:47.89,1:08:49.36,Default,,0,0,0,,حسنًا.
Dialogue: 0,1:08:52.00,1:08:53.17,Default,,0,0,0,,-بليس!\N-Queen.
Dialogue: 0,1:08:56.10,1:08:58.30,Default,,0,0,0,,كابوس جديد
Dialogue: 0,1:08:59.31,1:09:01.51,Default,,0,0,0,,وجدك.
Dialogue: 0,1:09:02.34,1:09:03.44,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:09:04.64,1:09:09.25,Default,,0,0,0,,فقدت صوتك، هل أنت أجش، هل يجب أن تتصل بي؟
Dialogue: 0,1:09:13.52,1:09:15.66,Default,,0,0,0,,لماذا نسيت هنا بحق الجحيم؟
Dialogue: 0,1:09:18.16,1:09:19.33,Default,,0,0,0,,ملكتي.
Dialogue: 0,1:09:23.23,1:09:24.56,Default,,0,0,0,,اليوم
Dialogue: 0,1:09:25.93,1:09:27.90,Default,,0,0,0,,لا يوجد تباعد اجتماعي.
Dialogue: 0,1:10:01.40,1:10:04.20,Default,,0,0,0,,هل هذا قلبي؟ أم أن الجسد يسأل؟
Dialogue: 0,1:10:05.47,1:10:06.67,Default,,0,0,0,,المدير هان؟
Dialogue: 0,1:10:06.84,1:10:08.37,Default,,0,0,0,,كل شيء فاسد!
Dialogue: 0,1:10:08.37,1:10:11.28,Default,,0,0,0,,سنبذل قصارى جهدنا للحصول على المكونات.
Dialogue: 0,1:10:11.28,1:10:15.35,Default,,0,0,0,,يريد الملك في يوم العربة أن يبدو قوياً.
Dialogue: 0,1:10:15.35,1:10:16.52,Default,,0,0,0,,نار!
Dialogue: 0,1:10:17.55,1:10:20.49,Default,,0,0,0,,هناك دائمًا من يأخذ المسابقات على محمل الجد.
Dialogue: 0,1:10:20.49,1:10:21.49,Default,,0,0,0,,أي نوع من الوهج هذا؟
Dialogue: 0,1:10:21.49,1:10:23.66,Default,,0,0,0,,لذا يجب أن ألقنك درساً.
Dialogue: 0,1:10:23.66,1:10:25.16,Default,,0,0,0,,سأريك من هو الرئيس في القصر.
Dialogue: 0,1:10:25.16,1:10:26.83,Default,,0,0,0,,لن أسامحك.
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


