Dialogue: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Singer, Hein, Host
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:04.02,pangalan,,0,0,0,,{\pos(112,666)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:17.36,0:01:20.36,Default,LILY,0,0,0,,Nang gabing iyon ay amoy jasmine ang buong kwarto.
Dialogue: 0,0:01:25.57,0:01:29.04,Default,LILY,0,0,0,,Babad pa sa manggas ang amoy.
Dialogue: 0,0:01:56.16,0:01:57.26,Default,LILY,0,0,0,,Ikaw iyon.
Dialogue: 0,0:02:00.67,0:02:01.84,Default,LILY,0,0,0,,Ikaw...
Dialogue: 0,0:02:02.17,0:02:04.67,Default,LILY,0,0,0,,Bilang huling paraan, may kaliwang manggas.
Dialogue: 0,0:02:13.38,0:02:16.88,Default,LILY,0,0,0,,Ikaw ang kailangan ko.
Dialogue: 0,0:02:16.98,0:02:18.02,Default,LILY,0,0,0,,4 na episode
Dialogue: 0,0:02:18.38,0:02:19.59,Default,LILY,0,0,0,,Itong tsaa.
Dialogue: 0,0:02:23.99,0:02:25.73,Default,LILY,0,0,0,,Natutuwa kang gusto mo siya.
Dialogue: 0,0:02:29.20,0:02:31.43,Default,LILY,0,0,0,,Hindi niya ako iniwan para alamin
Dialogue: 0,0:02:31.43,0:02:32.77,Default,LILY,0,0,0,,naaalala ko ba.
Dialogue: 0,0:02:32.77,0:02:36.07,Default,LILY,0,0,0,,Kamahalan, bakit ka namutla?
Dialogue: 0,0:02:36.07,0:02:37.37,Default,LILY,0,0,0,,At pinagpawisan.
Dialogue: 0,0:02:40.47,0:02:42.08,Default,LILY,0,0,0,, Maayos ang lahat.
Dialogue: 0,0:02:42.61,0:02:44.48,Default,LILY,0,0,0,,Pagod dahil hindi ako nakatulog buong gabi.
Dialogue: 0,0:02:45.38,0:02:48.58,Default,LILY,0,0,0,,Sa kasong ito, ang tsaa ay magiging kapaki-pakinabang.
Dialogue: 0,0:02:49.15,0:02:51.62,Default,LILY,0,0,0,,Uminom at matulog.
Dialogue: 0,0:02:53.32,0:02:54.35,Default,LILY,0,0,0,,Subukan.
Dialogue: 0,0:03:06.73,0:03:08.07,Default,LILY,0,0,0,,Maaari kang uminom.
Dialogue: 0,0:03:09.67,0:03:11.80,Default,LILY,0,0,0,,Ako mismo ang magbubuhos. Maaari kang maging malaya.
Dialogue: 0,0:03:33.53,0:03:35.90,Default,LILY,0,0,0,,Inumin. Napakasarap ng amoy nito.
Dialogue: 0,0:03:49.24,0:03:51.84,Default,LILY,0,0,0,,Magpapanggap akong hindi ko alam. Ito lang ang paraan para mabuhay ako.
Dialogue: 0,0:03:57.52,0:03:59.35,Default,LILY,0,0,0,,Bakit sinusubukan ka niyang hikayatin na uminom ng tsaa?
Dialogue: 0,0:03:59.59,0:04:01.09,Default,LILY,0,0,0,,Nalason talaga?
Dialogue: 0,0:04:04.42,0:04:05.66,Default,LILY,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:04:06.56,0:04:07.66,Default,LILY,0,0,0,,Mga panlasa
Dialogue: 0,0:04:10.70,0:04:11.83,Default,LILY,0,0,0,,napakaganda.
Dialogue: 0,0:04:14.53,0:04:15.60,Default,LILY,0,0,0,,Masayang-masaya ako.
Dialogue: 0,0:04:16.30,0:04:18.74,Default,LILY,0,0,0,,Naghapunan ka na ba kamakailan?
Dialogue: 0,0:04:20.84,0:04:22.78,Default,LILY,0,0,0,,Mas mabilis na kikilos ang lason kapag walang laman ang tiyan.
Dialogue: 0,0:04:23.31,0:04:24.58,Default,LILY,0,0,0,,So nagtanong siya.
Dialogue: 0,0:04:25.38,0:04:27.65,Default,LILY,0,0,0,,Nagtataka ka sa ginagawa ko.
Dialogue: 0,0:04:28.15,0:04:29.62,Default,LILY,0,0,0,,Naging abala ako.
Dialogue: 0,0:04:29.95,0:04:31.99,Default,LILY,0,0,0,,Ngunit palagi akong interesado
Dialogue: 0,0:04:31.99,0:04:34.15,Default,LILY,0,0,0,,ikaw at ang iyong mga kamag-anak.
Dialogue: 0,0:04:36.42,0:04:37.46,Default,LILY,0,0,0,,Pagkatapos
Dialogue: 0,0:04:42.00,0:04:43.16,Default,LILY,0,0,0,,uminom din.
Dialogue: 0,0:04:45.20,0:04:46.57,Default,LILY,0,0,0,,Bilang tanda ng pakikiramay.
Dialogue: 0,0:04:51.37,0:04:52.61,Default,LILY,0,0,0,,Kung pipilitin mo.
Dialogue: 0,0:05:00.98,0:05:02.05,Default,LILY,0,0,0,,Hindi nalason.
Dialogue: 0,0:05:15.46,0:05:16.73,Default,LILY,0,0,0,,Idiot ka.
Dialogue: 0,0:05:17.26,0:05:18.73,Default,LILY,0,0,0,,Siya mismo ang nagsabi, bilang tanda ng pakikiramay.
Dialogue: 0,0:05:20.77,0:05:21.90,Default,LILY,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:05:21.90,0:05:23.54,Default,LILY,0,0,0,,Bitawan mo ako, kailangan kong linisin ang tiyan ko.
Dialogue: 0,0:05:26.71,0:05:29.08,Default,LILY,0,0,0,,Sa tingin mo ba nilason kita?
Dialogue: 0,0:05:29.38,0:05:31.91,Default,LILY,0,0,0,,Bakit? Mayroon bang anumang dahilan upang isipin ito?
Dialogue: 0,0:05:34.08,0:05:35.25,Default,LILY,0,0,0,,Maghintay tayo.
Dialogue: 0,0:05:36.25,0:05:38.65,Default,LILY,0,0,0,,Kung walang nangyari sa iyo,
Dialogue: 0,0:05:39.25,0:05:40.92,Default,LILY,0,0,0,,mapapatunayan ang pagiging inosente ko.
Dialogue: 0,0:05:41.72,0:05:42.82,Default,LILY,0,0,0,,Paano kung ayaw ko?
Dialogue: 0,0:05:49.73,0:05:52.60,Default,LILY,0,0,0,,Kung nalason ka, manhid muna ang dila mo.
Dialogue: 0,0:05:53.27,0:05:54.57,Default,LILY,0,0,0,,Manhid ka,
Dialogue: 0,0:05:55.00,0:05:56.80,Default,LILY,0,0,0,,huwag mag-alinlangan at hampasin.
Dialogue: 0,0:05:58.54,0:05:59.81,Default,LILY,0,0,0,,Sa tingin mo hindi ko kaya?
Dialogue: 0,0:06:00.71,0:06:01.97,Default,LILY,0,0,0,,Sigurado akong kaya mo.
Dialogue: 0,0:06:02.71,0:06:04.38,Default,LILY,0,0,0,,Kaya mo ito.
Dialogue: 0,0:06:06.28,0:06:07.45,Default,LILY,0,0,0,,Naintindihan ng tama.
Dialogue: 0,0:06:08.61,0:06:11.25,Default,LILY,0,0,0,,Kung mamamatay ako, hindi bababa sa hindi nag-iisa.
Dialogue: 0,0:06:18.50,0:06:21.90,Default,LILY,0,0,0,,4 episode: The Man Who Knew So much
Dialogue: 0,0:06:29.54,0:06:31.70,Default,LILY,0,0,0,,-Kamahalan.\N-Hindi ko na kaya.
Dialogue: 0,0:06:33.37,0:06:35.11,Default,LILY,0,0,0,,Kahit buhay ko ang nakasalalay dito.
Dialogue: 0,0:06:36.18,0:06:37.84,Default,LILY,0,0,0,,Mamamatay din ako sa lalong madaling panahon.
Dialogue: 0,0:06:43.98,0:06:45.25,Default,LILY,0,0,0,,Mag-ingat.
Dialogue: 0,0:06:46.55,0:06:48.52,Default,LILY,0,0,0,,Sasaktan mo ba ako sa aking pagtulog?
Dialogue: 0,0:06:50.56,0:06:51.76,Default,LILY,0,0,0,,May mali sa akin.
Dialogue: 0,0:06:52.46,0:06:54.29,Default,LILY,0,0,0,,Ano ang ibinigay mo sa akin?
Dialogue: 0,0:06:54.96,0:06:56.16,Default,LILY,0,0,0,,Sagutin ang tanong.
Dialogue: 0,0:06:57.46,0:06:59.17,Default,LILY,0,0,0,,Saan ka nagpunta noong ako
Dialogue: 0,0:06:59.57,0:07:01.30,Default,LILY,0,0,0,,napunta sa summer palace?
Dialogue: 0,0:07:01.30,0:07:02.77,Default,LILY,0,0,0,,Gusto kong lumayo.
Dialogue: 0,0:07:03.34,0:07:04.80,Default,LILY,0,0,0,,Kailangan na nating lumabas.
Dialogue: 0,0:07:05.27,0:07:09.31,Default,LILY,0,0,0,,Hindi ako mamamatay kapag nasa harapan ko ang labasan.
Dialogue: 0,0:07:17.72,0:07:20.69,Default,LILY,0,0,0,,Ano ang nangyari sa iyo noong gabing iyon?
Dialogue: 0,0:07:21.59,0:07:24.52,Default,LILY,0,0,0,,Delikado ito. Kailangan mong tumahimik.
Dialogue: 0,0:07:24.52,0:07:25.89,Default,LILY,0,0,0,,I...
Dialogue: 0,0:07:27.13,0:07:28.36,Default,LILY,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,0:07:28.43,0:07:29.73,Default,LILY,0,0,0,,Nang gabing iyon
Dialogue: 0,0:07:30.80,0:07:32.00,Default,LILY,0,0,0,,sinubukan mo
Dialogue: 0,0:07:35.43,0:07:36.84,Default,LILY,0,0,0,,patayin mo ako.
Dialogue: 0,0:07:37.74,0:07:38.87,Default,LILY,0,0,0,,Alam niya.
Dialogue: 0,0:07:39.94,0:07:41.67,Default,LILY,0,0,0,,Kung alam mo,
Dialogue: 0,0:07:42.31,0:07:44.68,Default,LILY,0,0,0,,bakit wala kang sinabi?
Dialogue: 0,0:07:45.01,0:07:46.98,Default,LILY,0,0,0,,Anong balak mo?
Dialogue: 0,0:07:48.05,0:07:49.48,Default,LILY,0,0,0,,Hindi ko alam.
Dialogue: 0,0:07:49.85,0:07:52.75,Default,LILY,0,0,0,,Nalaman ko lang, salamat sa tsaa mo.
Dialogue: 0,0:07:55.35,0:07:56.69,Default,LILY,0,0,0,,Sayang naman.
Dialogue: 0,0:07:56.76,0:07:59.63,Default,LILY,0,0,0,,Kung alam ko lang kanina, siguradong pinatay na kita.
Dialogue: 0,0:08:01.43,0:08:03.06,Default,LILY,0,0,0,,Spawn of evil.
Dialogue: 0,0:08:03.36,0:08:05.93,Default,LILY,0,0,0,,Kahit baliw ka sa iba,
Dialogue: 0,0:08:05.93,0:08:07.27,Default,LILY,0,0,0,,bakit papatayin ang asawa mo?
Dialogue: 0,0:08:07.53,0:08:09.20,Default,LILY,0,0,0,,Tinatawag mo ba ang iyong sarili na tao?
Dialogue: 0,0:08:09.54,0:08:11.87,Default,LILY,0,0,0,,Si Cho Hwajin ang iyong concubine.
Dialogue: 0,0:08:12.37,0:08:14.44,Default,LILY,0,0,0,,Hindi ba pwedeng magpakasawa ka na lang?
Dialogue: 0,0:08:14.77,0:08:17.34,Default,LILY,0,0,0,,Papatayin mo ba ang iyong asawa gamit ang iyong sariling mga kamay?
Dialogue: 0,0:08:17.78,0:08:19.31,Default,LILY,0,0,0,,Hindi niya alam ang dahilan.
Dialogue: 0,0:08:23.85,0:08:24.98,Default,LILY,0,0,0,,My queen.
Dialogue: 0,0:08:25.62,0:08:28.62,Default,LILY,0,0,0,,Nang gabing iyon ay may narinig kang hindi dapat.
Dialogue: 0,0:08:29.12,0:08:30.82,Default,LILY,0,0,0,,Ano ang narinig mo?
Dialogue: 0,0:08:31.92,0:08:34.46,Default,LILY,0,0,0,,Sagot! Ano ang narinig mo?
Dialogue: 0,0:08:37.90,0:08:39.90,Default,LILY,0,0,0,,So hindi iyon ang dahilan?
Dialogue: 0,0:08:41.33,0:08:43.74,Default,LILY,0,0,0,,Mayroon kang magandang dahilan,
Dialogue: 0,0:08:44.07,0:08:47.11,Default,LILY,0,0,0,,na patayin ang babaeng ito?
Dialogue: 0,0:08:47.87,0:08:49.21,Default,LILY,0,0,0,,Naintindihan ko ba nang tama?
Dialogue: 0,0:08:50.68,0:08:52.38,Default,LILY,0,0,0,,Huwag malinlang.
Dialogue: 0,0:08:52.71,0:08:54.31,Default,LILY,0,0,0,,Dahil ba may narinig ako,
Dialogue: 0,0:08:54.31,0:08:55.88,Default,LILY,0,0,0,,o dahil sa pagmamahal sa ibang babae -
Dialogue: 0,0:08:55.88,0:08:57.82,Default,LILY,0,0,0,,isang dahilan ng pagpatay.
Dialogue: 0,0:08:58.62,0:09:00.45,Default,LILY,0,0,0,,Mas mahina lang ako.
Dialogue: 0,0:09:02.62,0:09:05.66,Default,LILY,0,0,0,,Kung mas malakas ako, hindi mo ako aatake.
Dialogue: 0,0:09:05.76,0:09:07.83,Default,LILY,0,0,0,,Madali akong pumatay,
Dialogue: 0,0:09:07.83,0:09:09.76,Default,LILY,0,0,0,,dahil mas mahina ako.
Dialogue: 0,0:09:10.53,0:09:12.27,Default,LILY,0,0,0,,Ito ang totoong dahilan.
Dialogue: 0,0:09:18.10,0:09:20.47,Default,LILY,0,0,0,,Halika. Dito mismo.
Dialogue: 0,0:09:21.37,0:09:24.98,Default,LILY,0,0,0,,Patunayan mo na pinapatay mo lang ang mga mas mahina.
Dialogue: 0,0:09:40.99,0:09:42.23,Default,LILY,0,0,0,,Damn.
Dialogue: 0,0:09:42.80,0:09:44.10,Default,LILY,0,0,0,,Katabi ko.
Dialogue: 0,0:09:44.33,0:09:45.83,Default,LILY,0,0,0,,Kamahalan.
Dialogue: 0,0:09:47.30,0:09:49.50,Default,LILY,0,0,0,,Hindi niya ako sineryoso.
Dialogue: 0,0:09:51.27,0:09:54.14,Default,LILY,0,0,0,,Kung ako sa sarili ko, ipapatumba ko siya sa isang suntok!
Dialogue: 0,0:09:54.14,0:09:55.27,Default,LILY,0,0,0,,Damn!
Dialogue: 0,0:10:35.45,0:10:36.85,Default,LILY,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:10:37.62,0:10:41.55,Default,LILY,0,0,0,,Palagi kong iniisip na ako ay isang mahina na lumalaban sa isang taong mas malakas.
Dialogue: 0,0:10:42.76,0:10:45.02,Default,LILY,0,0,0,,Samakatuwid, naniniwala ako na anumang mga diskarte
Dialogue: 0,0:10:46.79,0:10:48.69,Default,LILY,0,0,0,,katanggap-tanggap.
Dialogue: 0,0:10:53.80,0:10:55.90,Default,LILY,0,0,0,,Alam ng Reyna,
Dialogue: 0,0:10:56.14,0:10:57.94,Default,LILY,0,0,0,,na sinubukan kong patayin siya.
Dialogue: 0,0:11:05.08,0:11:09.65,Default,LILY,0,0,0,,Akala ko maraming dahilan\N para patayin ang reyna.
Dialogue: 0,0:11:10.02,0:11:12.28,Default,LILY,0,0,0,,Hindi lang dahil sa narinig na usapan.
Dialogue: 0,0:11:12.28,0:11:15.55,Default,LILY,0,0,0,,Pero dahil nag-ambag din siya sa paniniil.
Dialogue: 0,0:11:16.26,0:11:19.49,Default,LILY,0,0,0,,Kaya naisip kong mapapatay ko ang reyna.
Dialogue: 0,0:11:24.26,0:11:27.13,Default,LILY,0,0,0,,Gayunpaman, ito ay isang duwag na dahilan.
Dialogue: 0,0:11:27.83,0:11:30.40,Default,LILY,0,0,0,,Hindi ako handang lumaban sa malalakas na kalaban,
Dialogue: 0,0:11:30.40,0:11:33.11,Default,LILY,0,0,0,,kaya pinuntirya ko ang mahinang reyna.
Dialogue: 0,0:11:35.04,0:11:37.68,Default,LILY,0,0,0,,-Kamahalan.\N-Kung sasalakayin ko ang mahihina,
Dialogue: 0,0:11:39.01,0:11:41.88,Default,LILY,0,0,0,,paano ako naiiba sa iba?
Dialogue: 0,0:11:44.38,0:11:46.42,Default,LILY,0,0,0,,Tumutok sa matuwid na layunin.
Dialogue: 0,0:11:47.09,0:11:50.79,Default,LILY,0,0,0,,Lahat ng paraan ay mabuti para sa isang mabuting layunin.
Dialogue: 0,0:11:51.49,0:11:54.26,Default,LILY,0,0,0,,Ang Kim clan ay hindi matatalo sa matuwid na pamamaraan.
Dialogue: 0,0:12:00.43,0:12:01.83,Default,LILY,0,0,0,,Huwag pagdudahan ito.
Dialogue: 0,0:12:02.07,0:12:04.47,Default,LILY,0,0,0,,Sigurado akong malikot ang mga plano nila.
Dialogue: 0,0:12:05.14,0:12:07.44,Default,LILY,0,0,0,,Ang reyna lang ang nakakaalam nito ngayon,
Dialogue: 0,0:12:08.07,0:12:10.31,Default,LILY,0,0,0,,hulaan lang.
Dialogue: 0,0:12:10.44,0:12:12.38,Default,LILY,0,0,0,,Kailangan niyang tumahimik.
Dialogue: 0,0:12:12.78,0:12:15.05,Default,LILY,0,0,0,,Maaga o huli ang lahat ay magiging malinaw.
Dialogue: 0,0:12:17.28,0:12:20.12,Default,LILY,0,0,0,,Hindi na ako gagamit ng duwag na taktika.
Dialogue: 0,0:12:20.15,0:12:21.22,Default,LILY,0,0,0,,Kamahalan.
Dialogue: 0,0:12:21.42,0:12:24.36,Default,LILY,0,0,0,,Kinondena ko ang reyna dahil siya ay mula sa pamilya Kim.
Dialogue: 0,0:12:24.36,0:12:27.06,Default,LILY,0,0,0,,Gayunpaman, hindi nahuhulaang kumilos siya.
Dialogue: 0,0:12:28.43,0:12:31.70,Default,LILY,0,0,0,,Sa pangkalahatan, hindi ako ang iniisip mo.
Dialogue: 0,0:12:31.70,0:12:33.03,Default,LILY,0,0,0,,Ang mga hitsura ay maaaring mapanlinlang, alam mo.
Dialogue: 0,0:12:34.13,0:12:36.97,Default,LILY,0,0,0,,Sinabi ng Reyna na ibang tao siya.
Dialogue: 0,0:12:37.74,0:12:40.61,Default,LILY,0,0,0,,Marahil ay sinusubukan niyang sabihin,
Dialogue: 0,0:12:40.61,0:12:43.78,Default,LILY,0,0,0,,na siya ay hinulma mula sa ibang kuwarta at iba ang kilos.
Dialogue: 0,0:12:43.91,0:12:45.71,Default,LILY,0,0,0,,Ano ang aasahan mo sa kanya?
Dialogue: 0,0:12:46.15,0:12:47.41,Default,LILY,0,0,0,,Ang Reyna ay pareho,
Dialogue: 0,0:12:48.31,0:12:49.65,Default,LILY,0,0,0,,like the rest of the Kims.
Dialogue: 0,0:12:50.28,0:12:52.52,Default,LILY,0,0,0,,Siguro isa akong puppet king,
Dialogue: 0,0:12:53.49,0:12:56.39,Default,LILY,0,0,0,,ngunit walang ibibigay sa kanila ang mga salita ng reyna.
Dialogue: 0,0:12:56.56,0:12:58.46,Default,LILY,0,0,0,,Walang tiyak na ebidensya.
Dialogue: 0,0:13:00.19,0:13:02.43,Default,LILY,0,0,0,,Titingnan ko kung ano ang ginagawa ng reyna.
Dialogue: 0,0:13:02.96,0:13:05.93,Default,LILY,0,0,0,,At the same time, malalaman ko kung anong klaseng tao siya.
Dialogue: 0,0:13:19.25,0:13:22.58,Default,LILY,0,0,0,,Nalaman ko kung saan nanggaling ang telang ito,
Dialogue: 0,0:13:23.82,0:13:24.98,Default,LILY,0,0,0,,mula siya sa palasyo.
Dialogue: 0,0:13:26.52,0:13:29.12,Default,LILY,0,0,0,,Kung may nagtangkang nakawin siya sa hari,
Dialogue: 0,0:13:29.49,0:13:31.12,Default,LILY,0,0,0,, siguradong nahuli na siya.
Dialogue: 0,0:13:32.53,0:13:35.39,Default,LILY,0,0,0,,Ibig sabihin, hindi ito magagawa ng isang mortal lang.
Dialogue: 0,0:13:35.63,0:13:40.33,Default,LILY,0,0,0,,Lord. Nagtataka ako kung magkano ang ibabayad nila sa akin para sa aking mga serbisyo.
Dialogue: 0,0:13:40.57,0:13:43.00,Default,LILY,0,0,0,,Hindi naging madali, sir.
Dialogue: 0,0:13:46.74,0:13:47.91,Default,LILY,0,0,0,,Magaling.
Dialogue: 0,0:13:50.61,0:13:54.15,Default,LILY,0,0,0,,Mula ngayon, pagkatiwalaan mo ako sa pinakamabigat
Dialogue: 0,0:13:54.15,0:13:56.22,Default,LILY,0,0,0,,at maruming trabaho.
Dialogue: 0,0:13:57.18,0:13:58.55,Default,LILY,0,0,0,,Palasyo.
Dialogue: 0,0:14:59.51,0:15:00.71,Default,LILY,0,0,0,,Dahil sa isa
Dialogue: 0,0:15:01.58,0:15:05.72,Default,LILY,0,0,0,,hindi namin \N mananalo sa hari bilang isang marangal na asawa.
Dialogue: 0,0:15:06.25,0:15:10.92,Default,LILY,0,0,0,,Kailangan natin ng bagay na magpapatunaw ng puso niya.
Dialogue: 0,0:15:12.36,0:15:16.46,Default,LILY,0,0,0,,Ang vulnerable spot ng concubine ay isang insidente sa lawa.
Dialogue: 0,0:15:18.33,0:15:19.70,Default,LILY,0,0,0,,Kung ganoon...
Dialogue: 0,0:15:20.13,0:15:22.47,Default,LILY,0,0,0,,Kailangan nating maghanap ng scapegoat.
Dialogue: 0,0:15:23.00,0:15:25.74,Default,LILY,0,0,0,,Mahina at walang magawa,
Dialogue: 0,0:15:26.77,0:15:29.51,Default,LILY,0,0,0,,parang isang usa na walang ina.
Dialogue: 0,0:15:33.15,0:15:34.51,Default,LILY,0,0,0,,Isang katulad.
Dialogue: 0,0:16:17.89,0:16:20.09,Default,LILY,0,0,0,,Saan napunta ang tudjon player?
Dialogue: 0,0:16:20.09,0:16:21.66,Default,LILY,0,0,0,,Hindi mo ba mailagay ang card?
Dialogue: 0,0:16:21.66,0:16:25.06,Default,LILY,0,0,0,,Hindi mo mapapansin kahit ninakaw ko ang ilong mo.
Dialogue: 0,0:16:26.00,0:16:27.07,Default,LILY,0,0,0,,Ang bagay ay...
Dialogue: 0,0:16:28.60,0:16:30.47,Default,LILY,0,0,0,,No. wala.
Dialogue: 0,0:16:31.14,0:16:32.94,Default,LILY,0,0,0,,May bumabagabag sa iyo.
Dialogue: 0,0:16:34.21,0:16:39.08,Default,LILY,0,0,0,,Masyadong maraming kontrabida ang gumagala sa labas ng palasyo.
Dialogue: 0,0:16:39.81,0:16:42.25,Default,LILY,0,0,0,,Nakipagkaibigan ako sa isang lalaki,
Dialogue: 0,0:16:42.25,0:16:43.38,Default,LILY,0,0,0,,Lee Senman.
Dialogue: 0,0:16:43.92,0:16:45.15,Default,LILY,0,0,0,,Sa tingin ko,
Dialogue: 0,0:16:45.88,0:16:48.55,Default,LILY,0,0,0,,inatake din siya ng kontrabida,
Dialogue: 0,0:16:48.55,0:16:50.26,Default,LILY,0,0,0,,naglalakad sa labas ng palasyo.
Dialogue: 0,0:16:50.32,0:16:52.29,Default,LILY,0,0,0,,"Gayundin"? Sino pa ang inatake?
Dialogue: 0,0:16:52.39,0:16:54.63,Default,LILY,0,0,0,,Alam mo, I’m very perceptive.
Dialogue: 0,0:16:55.03,0:16:57.50,Default,LILY,0,0,0,,Ang aking pinsan na si Benin,
Dialogue: 0,0:16:58.20,0:17:00.63,Default,LILY,0,0,0,,mukhang sinusubukan
Dialogue: 0,0:17:00.83,0:17:05.04,Default,LILY,0,0,0,,hanapin ang isang tao gamit ang isang piraso ng tela.
Dialogue: 0,0:17:06.47,0:17:08.57,Default,LILY,0,0,0,,Sinasabi sa akin ng puso ko,
Dialogue: 0,0:17:08.81,0:17:12.24,Default,LILY,0,0,0,,may-ari ng isang piraso ng damit, isang kilalang-kilalang kontrabida,
Dialogue: 0,0:17:12.68,0:17:13.88,Default,LILY,0,0,0,,sugatan
Dialogue: 0,0:17:15.05,0:17:16.48,Default,LILY,0,0,0,,kaibigan ko
Dialogue: 0,0:17:17.05,0:17:19.42,Default,LILY,0,0,0,,at bumangga sa kapatid ko.
Dialogue: 0,0:17:21.92,0:17:23.32,Default,LILY,0,0,0,,Ano sa tingin mo?
Dialogue: 0,0:17:25.19,0:17:27.73,Default,LILY,0,0,0,,Walang kabuluhan ang magkaroon ng talentong tulad mo,
Dialogue: 0,0:17:27.73,0:17:29.19,Default,LILY,0,0,0,,hindi naging scientist.
Dialogue: 0,0:17:29.19,0:17:31.33,Default,LILY,0,0,0,,Isang malaking kawalan para sa kaharian.
Dialogue: 0,0:17:32.73,0:17:36.64,Default,LILY,0,0,0,,Ikaw ay kasing-unawa ko.
Dialogue: 0,0:17:40.07,0:17:45.04,Default,LILY,0,0,0,,May kakaibang nangyayari sa labas ng palasyo.
Dialogue: 0,0:18:00.63,0:18:01.79,Default,LILY,0,0,0,,Maawa ka.
Dialogue: 0,0:18:01.79,0:18:04.86,Default,LILY,0,0,0,,Gagawin ko ang hinihiling mo. Huwag patayin.
Dialogue: 0,0:18:05.36,0:18:07.10,Default,LILY,0,0,0,,Mr.
Dialogue: 0,0:18:07.10,0:18:08.23,Default,LILY,0,0,0,,Mrs.
Dialogue: 0,0:18:09.27,0:18:12.30,Default,LILY,0,0,0,,Hindi ko alam kung sino ka, pero nakikiusap ako sa iyo.
Dialogue: 0,0:18:12.64,0:18:13.67,Default,LILY,0,0,0,,Pakiusap.
Dialogue: 0,0:18:16.84,0:18:18.51,Default,LILY,0,0,0,,Wala akong nakikita.
Dialogue: 0,0:18:18.51,0:18:19.78,Default,LILY,0,0,0,,Itaas ang iyong ulo.
Dialogue: 0,0:18:20.05,0:18:23.02,Default,LILY,0,0,0,,No. Ayokong mamatay.
Dialogue: 0,0:18:31.62,0:18:33.86,Default,LILY,0,0,0,,Hindi mo pa rin makikita ang mukha ko.
Dialogue: 0,0:18:44.34,0:18:47.11,Default,LILY,0,0,0,,Naghihintay sa iyong sagot ang isang maimpluwensyang tao.
Dialogue: 0,0:18:48.04,0:18:51.01,Default,LILY,0,0,0,,Wala akong alam.
Dialogue: 0,0:18:51.61,0:18:54.21,Default,LILY,0,0,0,,Paano ko malalaman ang anuman?
Dialogue: 0,0:18:55.01,0:18:56.18,Default,LILY,0,0,0,,Alam mo,
Dialogue: 0,0:18:56.18,0:18:58.98,Default,LILY,0,0,0,,na nagtangkang saktan ang reyna sa pamamagitan ng pagtulak sa kanya sa lawa.
Dialogue: 0,0:19:00.52,0:19:02.75,Default,LILY,0,0,0,,Mabubuhay ka kung sasabihin mo ang pangalan.
Dialogue: 0,0:19:56.64,0:19:57.81,Default,LILY,0,0,0,,Excuse me, Your Majesty.
Dialogue: 0,0:19:58.54,0:20:00.41,Default,LILY,0,0,0,,Nakakatakot ang lasa,
Dialogue: 0,0:20:00.41,0:20:02.11,Default,LILY,0,0,0,,ngunit lubhang kapaki-pakinabang.
Dialogue: 0,0:20:09.05,0:20:12.06,Default,LILY,0,0,0,,May dala ang ama ng reyna kahapon.
Dialogue: 0,0:20:12.32,0:20:13.66,Default,LILY,0,0,0,,Umiinom ako nang walang laman ang tiyan
Dialogue: 0,0:20:14.19,0:20:16.09,Default,LILY,0,0,0,,at nakakaramdam ako ng rejuvenated.
Dialogue: 0,0:20:17.13,0:20:20.53,Default,LILY,0,0,0,,Lagi niyang alam kung saan kukuha ng hindi pangkaraniwan.
Dialogue: 0,0:20:21.27,0:20:23.57,Default,LILY,0,0,0,,Bilang tagapayo sa royal kitchen
Dialogue: 0,0:20:23.57,0:20:25.37,Default,LILY,0,0,0,,nagdudulot ito ng pinakamaraming
Dialogue: 0,0:20:25.37,0:20:26.61,Default,LILY,0,0,0,,angkop na mga bagay.
Dialogue: 0,0:20:39.99,0:20:41.02,Default,LILY,0,0,0,,Nga pala,
Dialogue: 0,0:20:41.02,0:20:43.86,Default,LILY,0,0,0,,kumusta naman ang mga affairs natin sa palasyo?
Dialogue: 0,0:20:44.66,0:20:46.73,Default,LILY,0,0,0,,May taong nasa isip,
Dialogue: 0,0:20:46.73,0:20:48.23,Default,LILY,0,0,0,,paghahanda.
Dialogue: 0,0:20:49.43,0:20:52.33,Default,LILY,0,0,0,,Nakikita ko. Sa sandaling matapos ito,
Dialogue: 0,0:20:52.90,0:20:55.70,Default,LILY,0,0,0,,para sa akin ito ay isang mas kaunting bagay na dapat ipag-alala.
Dialogue: 0,0:20:56.40,0:20:57.44,Default,LILY,0,0,0,,Oo.
Dialogue: 0,0:20:58.24,0:21:01.01,Default,LILY,0,0,0,,Walang pinapayagang mga pagkakamali sa pagkakataong ito.
Dialogue: 0,0:21:17.12,0:21:18.32,Default,LILY,0,0,0,,Kim Byunin
Dialogue: 0,0:21:19.56,0:21:21.13,Default,LILY,0,0,0,,sinusubukang maghanap ng tao
Dialogue: 0,0:21:21.13,0:21:22.56,Default,LILY,0,0,0,,isang piraso ng damit ng hari.
Dialogue: 0,0:21:29.23,0:21:30.94,Default,LILY,0,0,0,,sinira ko ang mga damit.
Dialogue: 0,0:21:31.44,0:21:34.54,Default,LILY,0,0,0,,Pero simula nang malaman ng reyna ang totoo...
Dialogue: 0,0:21:34.91,0:21:37.48,Default,LILY,0,0,0,,Kung nalaman ng Benin ang lahat at darating para sa akin,
Dialogue: 0,0:21:37.81,0:21:40.25,Default,LILY,0,0,0,,kaya nagkamali ako sa reyna.
Dialogue: 0,0:21:40.25,0:21:42.45,Default,ZINA,0,0,0,,-Masyadong delikado ang mga ganyang laro.\N-Alam ko.
Dialogue: 0,0:21:43.52,0:21:46.08,Default,ZINA,0,0,0,,Pero kung tama ako,
Dialogue: 0,0:21:46.72,0:21:49.12,Default,ZINA,0,0,0,,kung gayon ang isang inosenteng tao ay hindi magdurusa.
Dialogue: 0,0:21:53.96,0:21:56.93,Default,ZINA,0,0,0,,Ngayon ang unang araw ng aking biyenan sa opisina.
Dialogue: 0,0:22:07.04,0:22:08.04,Default,ZINA,0,0,0,,Kamahalan.
Dialogue: 0,0:22:09.47,0:22:11.61,Default,ZINA,0,0,0,,Akala ko nasa Daejeon hall ka pa.
Dialogue: 0,0:22:11.88,0:22:13.58,Default,ZINA,0,0,0,,Pumunta dito para tingnan.
Dialogue: 0,0:22:14.18,0:22:17.78,Default,ZINA,0,0,0,,Kailangan kong magbahagi ng mahalagang kaalaman kay Prince Yeonpyeong.
Dialogue: 0,0:22:22.82,0:22:24.16,Default,ZINA,0,0,0,,Nagulat ka ba?
Dialogue: 0,0:22:29.69,0:22:31.00,Default,ZINA,0,0,0,,Chief Eunuch.
Dialogue: 0,0:22:33.17,0:22:34.20,Default,ZINA,0,0,0,,Oo.
Dialogue: 0,0:22:44.18,0:22:46.08,Default,ZINA,0,0,0,,Anong psychopath.
Dialogue: 0,0:22:46.24,0:22:48.81,Default,ZINA,0,0,0,,Akala ko isa lang siyang tanga, at ito ay isang performance.
Dialogue: 0,0:22:49.51,0:22:51.82,Default,ZINA,0,0,0,,Sinubukan bang patayin ng hari ang reyna gamit ang sarili niyang mga kamay?
Dialogue: 0,0:22:52.55,0:22:54.89,Default,ZINA,0,0,0,,Kung magsisimula ako ng napakalaking iskandalo,
Dialogue: 0,0:22:54.89,0:22:56.66,Default,ZINA,0,0,0,,I'll find myself at the epicenter, mas delikado ito.
Dialogue: 0,0:22:57.16,0:22:59.02,Default,ZINA,0,0,0,,Maghihintay ako hanggang sa mapuno ang lawa.
Dialogue: 0,0:22:59.02,0:23:01.69,Default,ZINA,0,0,0,,Hanggang sa panahong iyon, ibababa ko ang aking ulo at babalik sa aking buhay.
Dialogue: 0,0:23:03.40,0:23:04.86,Default,ZINA,0,0,0,,Marahil namamanhid ang iyong mga kamay.
Dialogue: 0,0:23:04.86,0:23:06.47,Default,ZINA,0,0,0,,Panatilihing tumawid nang napakatagal.
Dialogue: 0,0:23:07.60,0:23:09.37,Default,ZINA,0,0,0,,Pinapatahimik ako nito.
Dialogue: 0,0:23:13.87,0:23:16.21,Default,ZINA,0,0,0,,Hindi tumahimik ang mga pag-iisip, bagama't gusto kong huminto.
Dialogue: 0,0:23:17.21,0:23:18.94,Default,ZINA,0,0,0,,Ano ang nilagay niya sa tea ko?
Dialogue: 0,0:23:18.94,0:23:21.48,Default,ZINA,0,0,0,,Alam ko. Hindi ka makakapagpahinga kahit isang segundo.
Dialogue: 0,0:23:22.91,0:23:25.82,Default,ZINA,0,0,0,,Pero kung gusto niya akong tapusin, lason niya lang sana ako.
Dialogue: 0,0:23:26.55,0:23:27.62,Default,ZINA,0,0,0,,Kaya bakit...
Dialogue: 0,0:23:27.62,0:23:28.99,Default,ZINA,0,0,0,,Sa impiyerno.
Dialogue: 0,0:23:28.99,0:23:30.89,Default,ZINA,0,0,0,,Bakit ako mag-aalala tungkol sa pasyenteng ito?
Dialogue: 0,0:23:32.76,0:23:34.59,Default,ZINA,0,0,0,,Tingnan natin kung ano ang nangyayari sa lawa.
Dialogue: 0,0:23:35.13,0:23:36.96,Default,ZINA,0,0,0,,Mayroon ka bang uri ng latigo?
Dialogue: 0,0:23:36.96,0:23:38.46,Default,ZINA,0,0,0,,Kailangan natin silang bilisan.
Dialogue: 0,0:23:38.46,0:23:39.63,Default,ZINA,0,0,0,,Kamahalan.
Dialogue: 0,0:23:46.40,0:23:49.04,Default,ZINA,0,0,0,,Iniimbitahan ka ng Dowager Queen sa kanyang lugar.
Dialogue: 0,0:23:50.37,0:23:53.04,Default,ZINA,0,0,0,,Hindi ko siya kailangan ngayon.
Dialogue: 0,0:23:53.04,0:23:54.05,Default,ZINA,0,0,0,,Damn.
Dialogue: 0,0:24:20.41,0:24:22.77,Default,ZINA,0,0,0,,Nakakagalit. Ano pa ba ang gusto niya sa akin?
Dialogue: 0,0:24:22.77,0:24:23.91,Default,ZINA,0,0,0,,Damn.
Dialogue: 0,0:24:56.17,0:24:59.28,Default,ZINA,0,0,0,,Magpatuloy. Lahat ay gagana! Tumabi ka dyan.
Dialogue: 0,0:25:00.28,0:25:02.15,Default,ZINA,0,0,0,,Anong ginagawa mo? Mas mabilis.
Dialogue: 0,0:25:02.15,0:25:04.42,Default,ZINA,0,0,0,,-Dito.\N-Ilipat.
Dialogue: 0,0:25:04.72,0:25:06.12,Default,ZINA,0,0,0,,Atay, mas masigla.
Dialogue: 0,0:25:06.12,0:25:08.32,Default,ZINA,0,0,0,,Mas masigla. Kailangan na nating magmadali.
Dialogue: 0,0:25:08.32,0:25:10.06,Default,ZINA,0,0,0,,Apurahan. Bilisan natin.
Dialogue: 0,0:25:10.06,0:25:12.26,Default,ZINA,0,0,0,,Magpatuloy.
Dialogue: 0,0:25:15.13,0:25:16.70,Default,ZINA,0,0,0,,Mag-ingat. Lumipat.
Dialogue: 0,0:25:18.90,0:25:21.07,Default,ZINA,0,0,0,,Hindi ko na matiis.
Dialogue: 0,0:25:21.07,0:25:22.87,Default,ZINA,0,0,0,,Pupunta ako sa restroom. babalik ako agad.
Dialogue: 0,0:25:23.13,0:25:24.90,Default,ZINA,0,0,0,,Napakaraming trabaho. Bumalik ka dali.
Dialogue: 0,0:25:25.77,0:25:26.91,Default,ZINA,0,0,0,,Mas masigla.
Dialogue: 0,0:25:32.61,0:25:36.25,Default,ZINA,0,0,0,,Nabalitaan ko na darating ka, kaya hinihintay kita.
Dialogue: 0,0:25:37.35,0:25:39.15,Default,ZINA,0,0,0,,Ngunit ano ang problema?
Dialogue: 0,0:25:39.52,0:25:43.96,Default,ZINA,0,0,0,,Labis na interesado sa iyo ang Inang Reyna.
Dialogue: 0,0:25:44.06,0:25:45.66,Default,ZINA,0,0,0,,Ito ay isang karangalan para sa akin.
Dialogue: 0,0:25:46.12,0:25:48.26,Default,ZINA,0,0,0,,Nabalitaan kong nasa alipin ang iyong nakababatang kapatid
Dialogue: 0,0:25:48.26,0:25:49.96,Default,ZINA,0,0,0,,dahil sa utang ng pamilya.
Dialogue: 0,0:25:49.96,0:25:52.76,Default,ZINA,0,0,0,,Oo. Sa buong mundo isa na lang akong kapatid na natitira.
Dialogue: 0,0:25:53.23,0:25:55.23,Default,ZINA,0,0,0,,Narinig kong nag-aalala ka
Dialogue: 0,0:25:55.90,0:25:58.07,Default,ZINA,0,0,0,,at gagawin mo ang lahat para maibalik
Dialogue: 0,0:25:58.07,0:25:59.37,Default,ZINA,0,0,0,,ang posisyon ng kanyang kapatid.
Dialogue: 0,0:25:59.37,0:26:02.74,Default,ZINA,0,0,0,,Nag-iipon ako ng pera sa lalong madaling panahon.
Dialogue: 0,0:26:03.41,0:26:05.51,Default,ZINA,0,0,0,,Pero napakalaki ng utang.
Dialogue: 0,0:26:06.24,0:26:08.68,Default,ZINA,0,0,0,,Dahil pinahahalagahan ka ng Inang Reyna,
Dialogue: 0,0:26:08.68,0:26:10.12,Default,ZINA,0,0,0,,nag-propose siya sa iyo.
Dialogue: 0,0:26:11.15,0:26:13.89,Default,ZINA,0,0,0,,Hindi ka na magkakaroon ng ganoong pagkakataon muli.
Dialogue: 0,0:26:18.42,0:26:19.72,Default,ZINA,0,0,0,,Gaano katagal ito?
Dialogue: 0,0:26:20.99,0:26:22.49,Default,ZINA,0,0,0,,Medyo.
Dialogue: 0,0:26:25.46,0:26:27.27,Default,ZINA,0,0,0,,Paaminin mo rin siya.
Dialogue: 0,0:26:28.43,0:26:30.00,Default,ZINA,0,0,0,,Ang taong nagpadala ng sulat,
Dialogue: 0,0:26:31.44,0:26:32.57,Default,ZINA,0,0,0,,queen mother.
Dialogue: 0,0:26:34.74,0:26:35.77,Default,ZINA,0,0,0,,Naiintindihan ko.
Dialogue: 0,0:26:37.61,0:26:39.21,Default,ZINA,0,0,0,,Kung sisisihin ko ito,
Dialogue: 0,0:26:39.21,0:26:41.91,Default,ZINA,0,0,0,,hindi kami mabubuhay ng kapatid ko.
Dialogue: 0,0:26:41.91,0:26:44.18,Default,ZINA,0,0,0,,Hindi mo kailangang mag-alala tungkol sa iyong kapatid.
Dialogue: 0,0:26:44.45,0:26:45.62,Default,ZINA,0,0,0,,Ang iyong dedikasyon
Dialogue: 0,0:26:45.62,0:26:48.39,Default,ZINA,0,0,0,,nagbibigay sa kanya ng bagong buhay.
Dialogue: 0,0:26:48.62,0:26:49.69,Default,ZINA,0,0,0,,Pero...
Dialogue: 0,0:26:50.69,0:26:53.06,Default,ZINA,0,0,0,,Gaano katagal sa tingin mo,
Dialogue: 0,0:26:53.79,0:26:56.80,Default,ZINA,0,0,0,,kaya ba niyang tiisin ang ganito kahirap na buhay?
Dialogue: 0,0:26:57.33,0:27:00.93,Default,ZINA,0,0,0,,Paano kung may masamang mangyari bukas, parang aksidente?
Dialogue: 0,0:27:03.67,0:27:05.74,Default,ZINA,0,0,0,,May masama ba?
Dialogue: 0,0:27:14.08,0:27:16.78,Default,ZINA,0,0,0,,Tinawagan mo ako, Kamahalan?
Dialogue: 0,0:27:17.58,0:27:19.28,Default,ZINA,0,0,0,,Inimbitahan kita,
Dialogue: 0,0:27:19.45,0:27:22.65,Default,ZINA,0,0,0,,dahil gusto kong ipagkatiwala sa iyo ang isang bagay na mahalaga.
Dialogue: 0,0:27:22.85,0:27:25.09,Default,ZINA,0,0,0,,Damn, ano pa ba? Ang gulo.
Dialogue: 0,0:27:25.52,0:27:27.99,Default,ZINA,0,0,0,,Masyado pang maaga para sa akin na managot sa mahahalagang bagay,
Dialogue: 0,0:27:27.99,0:27:30.46,Default,ZINA,0,0,0,,dahil marami pang dapat matutunan.
Dialogue: 0,0:27:31.43,0:27:33.33,Default,ZINA,0,0,0,,Oo?
Dialogue: 0,0:27:33.93,0:27:35.33,Default,ZINA,0,0,0,,Sayang naman.
Dialogue: 0,0:27:35.63,0:27:38.34,Default,ZINA,0,0,0,,Nais kong pumili ng pinakamagagandang babae para sa hari,
Dialogue: 0,0:27:38.34,0:27:41.57,Default,ZINA,0,0,0,,na kayang humanga at gayumahin ang hari.
Dialogue: 0,0:27:41.84,0:27:43.74,Default,ZINA,0,0,0,,Sa palagay ko walang pagpipilian kundi ang alamin ito sa iyong sarili.
Dialogue: 0,0:27:44.78,0:27:45.81,Default,ZINA,0,0,0,,sabi ni Mengzi,
Dialogue: 0,0:27:46.08,0:27:48.38,Default,ZINA,0,0,0,,na ang mga mabubuting tao ay nasisiyahan sa suporta.
Dialogue: 0,0:27:48.38,0:27:49.81,Default,ZINA,0,0,0,,Bumuo ng birtud - makakakuha ka ng tulong.
Dialogue: 0,0:27:50.22,0:27:51.68,Default,ZINA,0,0,0,,Kahit na marami akong dapat matutunan,
Dialogue: 0,0:27:51.68,0:27:54.19,Default,ZINA,0,0,0,,maraming handang tumulong sa akin \Nsalamat sa aking kabutihan.
Dialogue: 0,0:27:55.12,0:27:57.36,Default,ZINA,0,0,0,,Kaya susubukan ko ang aking makakaya.
Dialogue: 0,0:27:57.96,0:27:59.06,Default,ZINA,0,0,0,,Nga pala,
Dialogue: 0,0:27:59.42,0:28:02.26,Default,ZINA,0,0,0,,ano ang maximum na bilang ng mga concubines?
Dialogue: 0,0:28:03.33,0:28:04.40,Default,ZINA,0,0,0,,Maximum?
Dialogue: 0,0:28:04.66,0:28:07.13,Default,ZINA,0,0,0,,Well, I mean, ilan
Dialogue: 0,0:28:07.33,0:28:10.07,Default,ZINA,0,0,0,,maari ba tayong pumili?
Dialogue: 0,0:28:10.74,0:28:13.34,Default,ZINA,0,0,0,,Hindi ko rin alam. Ayon sa mga klasiko,
Dialogue: 0,0:28:13.47,0:28:16.84,Default,ZINA,0,0,0,,dapat mayroong 6 na babae sa unang ranggo, 3 sa pangalawa,
Dialogue: 0,0:28:16.84,0:28:19.44,Default,ZINA,0,0,0,,9 pangatlo, 27 pang-apat,
Dialogue: 0,0:28:19.44,0:28:21.65,Default,ZINA,0,0,0,,at 81 panglima,
Dialogue: 0,0:28:21.65,0:28:24.28,Default,ZINA,0,0,0,,-na maglilingkod sa hari.\N-Halika.
Dialogue: 0,0:28:24.72,0:28:27.42,Default,ZINA,0,0,0,,6 plus 3.
Dialogue: 0,0:28:27.92,0:28:29.02,Default,ZINA,0,0,0,,9.
Dialogue: 0,0:28:29.55,0:28:30.76,Default,ZINA,0,0,0,,27.
Dialogue: 0,0:28:31.26,0:28:32.62,Default,ZINA,0,0,0,,At 81?
Dialogue: 0,0:28:33.53,0:28:36.16,Default,ZINA,0,0,0,,Ngunit kailangan nating pigilan, 3 lang ang pipiliin natin.
Dialogue: 0,0:28:36.33,0:28:37.63,Default,ZINA,0,0,0,,Oh damn.
Dialogue: 0,0:28:39.73,0:28:40.97,Default,ZINA,0,0,0,,Magaling!
Dialogue: 0,0:28:41.50,0:28:43.57,Default,ZINA,0,0,0,,Tiyak.
Dialogue: 0,0:28:44.40,0:28:45.97,Default,ZINA,0,0,0,,May asawa na ang kanyang kamahalan,
Dialogue: 0,0:28:45.97,0:28:48.04,Default,ZINA,0,0,0,,kailangan mong pumili ng 2 pa, tama?
Dialogue: 0,0:28:48.04,0:28:50.54,Default,ZINA,0,0,0,,Hindi, pipiliin natin ang 3.
Dialogue: 0,0:28:51.68,0:28:54.91,Default,ZINA,0,0,0,,Dinala ng concubine ang court lady na si Ovol.
Dialogue: 0,0:28:55.11,0:28:57.28,Default,ZINA,0,0,0,,Oo, yung babaeng humahabol sa kanya.
Dialogue: 0,0:28:57.65,0:28:59.32,Default,ZINA,0,0,0,,Nakakabaliw ang sinabi niya
Dialogue: 0,0:28:59.65,0:29:01.79,Default,ZINA,0,0,0,,out of devotion to the concubine.
Dialogue: 0,0:29:02.49,0:29:04.86,Default,ZINA,0,0,0,,Bakit ka tumalon sa lawa
Dialogue: 0,0:29:04.86,0:29:07.29,Default,ZINA,0,0,0,,sa harap mismo ni Cho Hwajin para siraan siya.
Dialogue: 0,0:29:07.29,0:29:08.66,Default,ZINA,0,0,0,,Ipagkalat ang mga ganyang tsismis.
Dialogue: 0,0:29:09.63,0:29:13.63,Default,ZINA,0,0,0,,Nagsinungaling ang hari para protektahan si Hwajin, at sinira niya ang lahat.
Dialogue: 0,0:29:14.57,0:29:15.57,Default,ZINA,0,0,0,,Hari?
Dialogue: 0,0:29:15.57,0:29:18.54,Default,ZINA,0,0,0,,Aalisin ko ang hari ng paborito niyang laruan,
Dialogue: 0,0:29:18.54,0:29:21.01,Default,ZINA,0,0,0,,kaya gusto ko siyang bigyan ng mga bago.
Dialogue: 0,0:29:23.31,0:29:27.78,Default,ZINA,0,0,0,,Oo. Gusto ko ring ipaghanda mo ako ng tanghalian.
Dialogue: 0,0:29:27.78,0:29:31.05,Default,ZINA,0,0,0,,Hindi na ako makakain ng bagay na inihanda ng iba.
Dialogue: 0,0:29:31.98,0:29:34.15,Default,ZINA,0,0,0,,Damn, hindi ito masyadong maganda.
Dialogue: 0,0:29:38.42,0:29:40.66,Default,ZINA,0,0,0,,At kung kumain ka ng masustansyang pagkain na inihanda ko araw-araw
Dialogue: 0,0:29:41.29,0:29:43.40,Default,ZINA,0,0,0,,at magsisimula kang magmukhang mas bata sa akin?
Dialogue: 0,0:29:43.76,0:29:45.83,Default,ZINA,0,0,0,,Hindi ko gusto ito.
Dialogue: 0,0:29:54.44,0:29:57.58,Default,ZINA,0,0,0,,Kailangan mong panatilihin ang magandang relasyon sa kanya hanggang sa mapuno ang lawa.
Dialogue: 0,0:30:02.74,0:30:05.34,Default,ZINA,0,0,0,,Nangyari ang lahat ayon sa gusto ni Kim So-yeon.
Dialogue: 0,0:30:06.08,0:30:08.11,Default,ZINA,0,0,0,,Itinulak niya si Hwajin sa isang tunay na bitag.
Dialogue: 0,0:30:09.55,0:30:11.88,Default,ZINA,0,0,0,,Hoy, babae. Babalik ito para yakapin ka.
Dialogue: 0,0:30:13.18,0:30:14.92,Default,ZINA,0,0,0,,Naaawa ako kay Hwajin.
Dialogue: 0,0:30:15.89,0:30:18.06,Default,ZINA,0,0,0,,Ngunit ano ang pagkakaiba? Walang pakialam si \NI pagbalik ko.
Dialogue: 0,0:30:18.06,0:30:19.56,Default,ZINA,0,0,0,,Wala pang oras para mag-alala tungkol sa iba.
Dialogue: 0,0:30:19.56,0:30:21.46,Default,ZINA,0,0,0,,Dapat mong ayusin muna ang iyong sarili.
Dialogue: 0,0:30:23.29,0:30:24.53,Default,ZINA,0,0,0,,Mas masigla.
Dialogue: 0,0:30:24.93,0:30:28.40,Default,ZINA,0,0,0,,Makakapagtagal kayong dalawa.
Dialogue: 0,0:30:28.53,0:30:30.20,Default,ZINA,0,0,0,,Babangga ka ulit, masasaktan.
Dialogue: 0,0:30:33.81,0:30:35.04,Default,ZINA,0,0,0,,Atay, mas masigla!
Dialogue: 0,0:30:37.21,0:30:39.78,Default,ZINA,0,0,0,,Atay, mas masigla!
Dialogue: 0,0:30:40.01,0:30:42.91,Default,ZINA,0,0,0,,Atay, mas masigla! Oo, oo! Mas buhay pa!
Dialogue: 0,0:31:00.97,0:31:03.23,Default,ZINA,0,0,0,,Iyon lang!
Dialogue: 0,0:31:13.48,0:31:15.11,Default,ZINA,0,0,0,,Damn, ito ay cool.
Dialogue: 0,0:31:15.48,0:31:17.85,Default,ZINA,0,0,0,,Tanging mataas na lipunan ang may ganoong kabutihan.
Dialogue: 0,0:31:18.75,0:31:21.25,Default,ZINA,0,0,0,,Royal Guard.
Dialogue: 0,0:31:23.96,0:31:25.56,Default,ZINA,0,0,0,,Magaling!
Dialogue: 0,0:31:32.10,0:31:33.57,Default,ZINA,0,0,0,,Hello, Mr. Kim.
Dialogue: 0,0:31:33.57,0:31:35.97,Default,ZINA,0,0,0,,Huling araw, di ba?
Dialogue: 0,0:31:36.23,0:31:38.10,Default,ZINA,0,0,0,,Dreary, malamang.
Dialogue: 0,0:31:38.10,0:31:41.57,Default,ZINA,0,0,0,,Hindi, sigurado akong makakagawa ka ng mas mahusay na trabaho.
Dialogue: 0,0:31:41.74,0:31:42.87,Default,ZINA,0,0,0,,Oh, ikaw.
Dialogue: 0,0:31:46.61,0:31:48.45,Default,ZINA,0,0,0,,Napakagandang kabayo.
Dialogue: 0,0:31:51.45,0:31:54.49,Default,ZINA,0,0,0,,Ito ay regalo mula sa Kanyang Kamahalan sa kumander ng royal guard.
Dialogue: 0,0:31:55.02,0:31:56.29,Default,ZINA,0,0,0,,Umupo.
Dialogue: 0,0:31:56.42,0:32:00.23,Default,ZINA,0,0,0,,Halika. Ilang taon na ba ang lumipas mula noong huli akong sumakay ng kabayo?
Dialogue: 0,0:32:00.56,0:32:04.30,Default,ZINA,0,0,0,,At hindi opisyal na akin ang posisyon,\Hanggang makatanggap ako ng certificate ngayon.
Dialogue: 0,0:32:05.06,0:32:07.27,Default,ZINA,0,0,0,,-Well, next time.\N-Oo.
Dialogue: 0,0:32:08.23,0:32:12.10,Default,ZINA,0,0,0,,Oh, Mr. Kim. Kaya mo bang sumakay ng kabayo?
Dialogue: 0,0:32:13.67,0:32:14.74,Default,ZINA,0,0,0,,Sino ka?
Dialogue: 0,0:32:17.41,0:32:19.48,Default,ZINA,0,0,0,,Ako ang matalik na kaibigan ng Kanyang Kamahalan.
Dialogue: 0,0:32:19.48,0:32:22.28,Default,ZINA,0,0,0,,At itinuturing ako ng mga kasambahay \Wala sa 5 pinakakaakit-akit...
Dialogue: 0,0:32:22.28,0:32:25.25,Default,ZINA,0,0,0,,Hindi mo kailangang malaman kung sino siya.
Dialogue: 0,0:32:25.58,0:32:27.65,Default,ZINA,0,0,0,,Hindi man lang kasama sa rating si Prince Yeonpyeong.
Dialogue: 0,0:32:27.92,0:32:30.29,Default,ZINA,0,0,0,,Pero ang iyong pangangatawan
Dialogue: 0,0:32:30.29,0:32:32.79,Default,ZINA,0,0,0,,hindi masyadong angkop para sa pagsakay.
Dialogue: 0,0:32:32.86,0:32:34.86,Default,ZINA,0,0,0,,At anong matangkad na kabayo.
Dialogue: 0,0:32:34.86,0:32:36.83,Default,ZINA,0,0,0,,Talon man lang sa kanya gamit ang maiksi mong binti?
Dialogue: 0,0:32:41.37,0:32:42.43,Default,ZINA,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:32:42.67,0:32:44.00,Default,ZINA,0,0,0,,Oo noong unang panahon
Dialogue: 0,0:32:44.70,0:32:46.44,Default,ZINA,0,0,0,,Tumatalon ako nang walang kamay.
Dialogue: 0,0:32:46.44,0:32:48.37,Default,ZINA,0,0,0,,Ganyan siya kagaling.
Dialogue: 0,0:32:48.37,0:32:50.01,Default,ZINA,0,0,0,,Nakaupo siya sa isang upuan.
Dialogue: 0,0:32:50.01,0:32:53.21,Default,ZINA,0,0,0,,Isang araw nakatulog ako sa isang kabayo at nakakita pa ako ng mga panaginip.
Dialogue: 0,0:32:55.28,0:32:56.58,Default,ZINA,0,0,0,,Oo, seryoso ako.
Dialogue: 0,0:32:56.92,0:32:59.02,Default,ZINA,0,0,0,,Papatunayan ko ito sa iyo. Eto na.
Dialogue: 0,0:33:02.52,0:33:05.36,Default,ZINA,0,0,0,,Hindi mo kailangang gawin ito.\N Huwag pilitin ang iyong sarili.
Dialogue: 0,0:33:05.36,0:33:07.33,Default,ZINA,0,0,0,,Oh, tumahimik ka!
Dialogue: 0,0:33:07.86,0:33:09.83,Default,ZINA,0,0,0,,Kaya ko pa.
Dialogue: 0,0:33:14.37,0:33:15.60,Default,ZINA,0,0,0,,Mukhang mali.
Dialogue: 0,0:33:17.27,0:33:20.17,Default,ZINA,0,0,0,,Hoy, pwede ba...
Dialogue: 0,0:33:20.41,0:33:22.31,Default,ZINA,0,0,0,,Iyon lang.
Dialogue: 0,0:33:27.15,0:33:29.75,Default,ZINA,0,0,0,,Ano ang nakita mo? Hindi ito maaaring maging mas simple.
Dialogue: 0,0:33:42.86,0:33:45.23,Default,ZINA,0,0,0,,Naku, mga mommies.
Dialogue: 0,0:33:47.10,0:33:48.23,Default,ZINA,0,0,0,,Nahuli.
Dialogue: 0,0:34:00.18,0:34:03.18,Default,ZINA,0,0,0,,Oh, ang laki mong pusa.
Dialogue: 0,0:34:04.05,0:34:05.48,Default,ZINA,0,0,0,,Naku, mga mommies.
Dialogue: 0,0:34:05.48,0:34:08.12,Default,ZINA,0,0,0,,-Mr. Kim!\N-My legs! Mga binti!
Dialogue: 0,0:34:08.12,0:34:10.42,Default,ZINA,0,0,0,,Little feet!
Dialogue: 0,0:34:10.52,0:34:13.26,Default,ZINA,0,0,0,,Patatas, asin at gatas.
Dialogue: 0,0:34:14.29,0:34:15.36,Default,ZINA,0,0,0,,Gatas?
Dialogue: 0,0:34:16.13,0:34:17.86,Default,ZINA,0,0,0,,Hindi kailanman narinig ito bago.
Dialogue: 0,0:34:19.86,0:34:21.47,Default,ZINA,0,0,0,,Tinatawag ding gatas.
Dialogue: 0,0:34:21.67,0:34:22.87,Default,ZINA,0,0,0,,Got it.
Dialogue: 0,0:34:22.87,0:34:25.44,Default,ZINA,0,0,0,,Pambihirang sangkap,\Nit ay lumulubog na parang tubig.
Dialogue: 0,0:34:25.44,0:34:26.94,Default,ZINA,0,0,0,,Wala kang langis.
Dialogue: 0,0:34:28.41,0:34:29.47,Default,ZINA,0,0,0,,May black pepper ka ba?
Dialogue: 0,0:34:29.64,0:34:30.91,Default,ZINA,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:34:31.38,0:34:35.05,Default,ZINA,0,0,0,,Mas mahalaga kaysa ginto, ngunit lumulubog na parang buhangin.
Dialogue: 0,0:34:35.05,0:34:38.02,Default,ZINA,0,0,0,,Pero hindi siya makikinig sa akin,\Nkaya wala akong sasabihin.
Dialogue: 0,0:34:39.88,0:34:41.02,Default,ZINA,0,0,0,,Naririnig ko, okay?
Dialogue: 0,0:34:43.66,0:34:46.22,Default,ZINA,0,0,0,,-Kamahalan!\N-Oh, ikaw.
Dialogue: 0,0:34:46.22,0:34:49.13,Default,ZINA,0,0,0,,Sabi ko wag kang magmadali. Bakit ka tumakbo?
Dialogue: 0,0:34:51.86,0:34:54.33,Default,ZINA,0,0,0,,Nagmamadali din si Court lady Choi dito.
Dialogue: 0,0:34:54.73,0:34:57.17,Default,ZINA,0,0,0,,Hindi siya bata. Paano kung nahimatay ka at natumba habang tumatakbo?
Dialogue: 0,0:34:57.17,0:34:59.17,Default,ZINA,0,0,0,,Nandiyan ako!
Dialogue: 0,0:35:01.07,0:35:03.04,Default,ZINA,0,0,0,,Marahil medyo mabagal ako,
Dialogue: 0,0:35:03.04,0:35:05.14,Default,ZINA,0,0,0,,pero hinding-hindi ako hihimatayin.
Dialogue: 0,0:35:12.85,0:35:14.05,Default,ZINA,0,0,0,,Matigas ang ulo na babae.
Dialogue: 0,0:35:18.62,0:35:21.43,Default,ZINA,0,0,0,,-Okay, ibuhos mo.\N-Oo, Kamahalan.
Dialogue: 0,0:35:32.84,0:35:33.87,Default,ZINA,0,0,0,,At iyon lang?
Dialogue: 0,0:35:35.04,0:35:37.91,Default,ZINA,0,0,0,,Are you kidding me?\N-Well, the thing is...
Dialogue: 0,0:35:37.94,0:35:41.71,Default,ZINA,0,0,0,,Kamahalan, ito ay isang napakabihirang bagay.
Dialogue: 0,0:35:41.98,0:35:43.82,Default,ZINA,0,0,0,,Kaya kailangan ko ito.
Dialogue: 0,0:35:44.12,0:35:45.82,Default,ZINA,0,0,0,,Sa pagluluto, ang mga produkto ang magpapasya sa lahat.
Dialogue: 0,0:35:46.15,0:35:49.42,Default,ZINA,0,0,0,,Kung gatasan mo lahat, magugutom ang mga guya.
Dialogue: 0,0:35:49.89,0:35:51.39,Default,ZINA,0,0,0,,At nagmamalasakit din.
Dialogue: 0,0:35:51.46,0:35:53.29,Default,ZINA,0,0,0,,Damn, kalungkutan.
Dialogue: 0,0:35:54.56,0:35:56.13,Default,ZINA,0,0,0,,Narinig mo na ba ang tungkol sa mga araw ng pag-aayuno?
Dialogue: 0,0:35:56.13,0:35:58.26,Default,ZINA,0,0,0,,Ang paulit-ulit na pag-aayuno ay mabuti para sa iyong kalusugan.
Dialogue: 0,0:35:59.73,0:36:01.83,Default,ZINA,0,0,0,,Punan ang aking kaldero mula rito.
Dialogue: 0,0:36:02.40,0:36:05.14,Default,ZINA,0,0,0,,Bawasan kahit isang patak... Alam mo, di ba?
Dialogue: 0,0:36:08.91,0:36:10.24,Default,ZINA,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:36:16.08,0:36:17.18,Default,ZINA,0,0,0,,Hmmm.
Dialogue: 0,0:36:19.68,0:36:20.82,Default,ZINA,0,0,0,,Sino ka?
Dialogue: 0,0:36:21.22,0:36:22.82,Default,ZINA,0,0,0,,How dare the girl show up...
Dialogue: 0,0:36:32.76,0:36:33.80,Default,ZINA,0,0,0,,Halika rito.
Dialogue: 0,0:36:38.60,0:36:39.70,Default,ZINA,0,0,0,,Ano ang pangalan mo?
Dialogue: 0,0:36:39.70,0:36:41.31,Default,ZINA,0,0,0,,Damhyan.
Dialogue: 0,0:36:42.31,0:36:43.94,Default,ZINA,0,0,0,,Nagpapalaki ka ng tuta sa palasyo.
Dialogue: 0,0:36:44.61,0:36:47.61,Default,ZINA,0,0,0,,Mas mataas ang status ng aso kaysa sa akin.
Dialogue: 0,0:36:48.01,0:36:50.65,Default,ZINA,0,0,0,,Mga Envoy mula sa Min. dinala ang aso.
Dialogue: 0,0:36:50.65,0:36:53.25,Default,ZINA,0,0,0,,Bihira lang daw ang breed or something like that.
Dialogue: 0,0:36:54.79,0:36:57.12,Default,ZINA,0,0,0,,Min? Ito ay 200 taon na ang nakalilipas.
Dialogue: 0,0:36:58.32,0:37:00.73,Default,ZINA,0,0,0,,Kung sa mga siglong ito ang lahi ay nahahalo sa iba,
Dialogue: 0,0:37:00.73,0:37:03.13,Default,ZINA,0,0,0,,tapos isang mongrel lang.
Dialogue: 0,0:37:04.36,0:37:05.66,Default,TIRAMISU,0,0,0,,At ano ang pangalan niya?
Dialogue: 0,0:37:05.96,0:37:07.90,Default,TIRAMISU,0,0,0,,Wala pang pangalan ang aso.
Dialogue: 0,0:37:07.90,0:37:09.57,Default,TIRAMISU,0,0,0,,Talaga? Pagkatapos
Dialogue: 0,0:37:10.70,0:37:13.24,Default,TIRAMISU,0,0,0,,-tawagin natin siyang Demon.\N-Demonyo?
Dialogue: 0,0:37:13.50,0:37:14.51,Default,TIRAMISU,0,0,0,,Tingnan mo.
Dialogue: 0,0:37:15.17,0:37:16.94,Default,TIRAMISU,0,0,0,,So, magsulat tayo.
Dialogue: 0,0:37:18.91,0:37:23.61,Default,TIRAMISU,0,0,0,,P - E - S. Palitan ang p ng pinagtambal na katinig.
Dialogue: 0,0:37:23.81,0:37:25.42,Default,TIRAMISU,0,0,0,,PES
Dialogue: 0,0:37:25.44,0:37:26.52,Default,TIRAMISU,0,0,0,,B
Dialogue: 0,0:37:27.69,0:37:28.75,Default,TIRAMISU,0,0,0,,E
Dialogue: 0,0:37:29.65,0:37:31.92,Default,TIRAMISU,0,0,0,,At mayroon tayong demonyo.
Dialogue: 0,0:37:32.36,0:37:33.69,Default,TIRAMISU,0,0,0,,Kaya Demonyo.
Dialogue: 0,0:37:33.69,0:37:36.06,Default,TIRAMISU,0,0,0,,Ngayon naiintindihan ko na.
Dialogue: 0,0:37:40.33,0:37:42.53,Default,TIRAMISU,0,0,0,,Madalas kang pumupunta dito, gutom siguro.
Dialogue: 0,0:37:44.60,0:37:45.67,Default,TIRAMISU,0,0,0,,Maghintay sandali.
Dialogue: 0,0:37:48.51,0:37:49.54,Default,TIRAMISU,0,0,0,,So.
Dialogue: 0,0:37:53.04,0:37:54.31,Default,TIRAMISU,0,0,0,,Voila.
Dialogue: 0,0:37:57.92,0:37:58.98,Default,TIRAMISU,0,0,0,,Subukan ito.
Dialogue: 0,0:38:02.02,0:38:03.09,Default,TIRAMISU,0,0,0,,Narito.
Dialogue: 0,0:38:09.03,0:38:10.19,Default,TIRAMISU,0,0,0,,Bakit hindi ka kumakain?
Dialogue: 0,0:38:10.19,0:38:12.90,Default,TIRAMISU,0,0,0,,Dahil sobrang ganda.
Dialogue: 0,0:38:14.43,0:38:16.17,Default,TIRAMISU,0,0,0,,Huwag mag-alala. Ito ay hindi libre.
Dialogue: 0,0:38:16.17,0:38:18.50,Default,TIRAMISU,0,0,0,,Pagkakain mo, tulungan mo ako sa patatas.
Dialogue: 0,0:38:18.50,0:38:19.54,Default,TIRAMISU,0,0,0,,Hindi mo magagawa iyon.
Dialogue: 0,0:38:20.67,0:38:23.24,Default,TIRAMISU,0,0,0,,Handa akong tiisin ang presensya mo, dahil reyna ka.
Dialogue: 0,0:38:23.24,0:38:24.78,Default,TIRAMISU,0,0,0,,Sa mahabang panahon, hindi nangangahas ang mga babae
Dialogue: 0,0:38:24.78,0:38:26.81,Default,TIRAMISU,0,0,0,,hawakan ang royal food.
Dialogue: 0,0:38:26.81,0:38:28.41,Default,TIRAMISU,0,0,0,,Pinapayagan silang magdekorasyon ng mga pinggan
Dialogue: 0,0:38:28.41,0:38:29.81,Default,TIRAMISU,0,0,0,,at ihain sila sa mesa.
Dialogue: 0,0:38:29.81,0:38:32.15,Default,TIRAMISU,0,0,0,,Walang ugat at walang opisyal na posisyon...
Dialogue: 0,0:38:33.38,0:38:34.52,Default,TIRAMISU,0,0,0,,Itong batang ito
Dialogue: 0,0:38:34.52,0:38:38.19,Default,TIRAMISU,0,0,0,,hindi makakatulong sa pagluluto.
Dialogue: 0,0:38:40.79,0:38:43.36,Default,TIRAMISU,0,0,0,,Anong matandang umutot.
Dialogue: 0,0:38:44.66,0:38:47.20,Default,TIRAMISU,0,0,0,,At subukan mo ito. "Matandang umutot".
Dialogue: 0,0:38:47.20,0:38:49.03,Default,TIRAMISU,0,0,0,,-Matandang umutot.\N-Ano?
Dialogue: 0,0:38:49.03,0:38:51.84,Default,TIRAMISU,0,0,0,,Wow, sinabi mo nang malinaw.
Dialogue: 0,0:38:52.90,0:38:54.57,Default,TIRAMISU,0,0,0,,Tawagin mo siyang matandang umutot.
Dialogue: 0,0:38:55.37,0:38:56.57,Default,TIRAMISU,0,0,0,,Huwag magambala. Kumain.
Dialogue: 0,0:39:01.18,0:39:03.71,Default,TIRAMISU,0,0,0,,Para akong kumakain ng ulap.
Dialogue: 0,0:39:05.25,0:39:07.29,Default,TIRAMISU,0,0,0,,Mahusay na paghahambing.
Dialogue: 0,0:39:07.65,0:39:09.79,Default,TIRAMISU,0,0,0,,Maaari kang mag-host ng palabas.
Dialogue: 0,0:39:10.66,0:39:11.69,Default,TIRAMISU,0,0,0,,Pf.
Dialogue: 0,0:39:13.16,0:39:15.63,Default,TIRAMISU,0,0,0,,Nga pala, hindi ba siya masyadong bata para sa palasyo?
Dialogue: 0,0:39:16.69,0:39:18.86,Default,TIRAMISU,0,0,0,,Hindi nagbabayad ng buwis ang kanyang mga magulang,
Dialogue: 0,0:39:18.86,0:39:20.10,Default,TIRAMISU,0,0,0,,kaya inalis ito.
Dialogue: 0,0:39:20.10,0:39:22.03,Default,TIRAMISU,0,0,0,,Naging alipin ang lahat sa kanyang pamilya,
Dialogue: 0,0:39:22.63,0:39:25.64,Default,TIRAMISU,0,0,0,,at ang kanyang tinaguriang ama ay tumakbo nang duwag.
Dialogue: 0,0:39:25.64,0:39:28.04,Default,TIRAMISU,0,0,0,,Wow. Anong klaseng ama ito?
Dialogue: 0,0:39:29.41,0:39:30.51,Default,TIRAMISU,0,0,0,,Royal Chef.
Dialogue: 0,0:39:31.38,0:39:32.78,Default,TIRAMISU,0,0,0,,Wala ka bang konsensya?
Dialogue: 0,0:39:35.51,0:39:36.65,Default,TIRAMISU,0,0,0,,Damhyan.
Dialogue: 0,0:39:36.65,0:39:39.62,Default,TIRAMISU,0,0,0,,Wag mong pansinin lahat ng masasamang bagay, okay?
Dialogue: 0,0:39:42.42,0:39:43.62,Default,TIRAMISU,0,0,0,,Doo-cancer.
Dialogue: 0,0:39:44.32,0:39:45.36,Default,TIRAMISU,0,0,0,,Ulitin.
Dialogue: 0,0:39:45.99,0:39:47.12,Default,TIRAMISU,0,0,0,,Fool.
Dialogue: 0,0:39:47.99,0:39:50.33,Default,TIRAMISU,0,0,0,,Ano? tanga?
Dialogue: 0,0:39:50.49,0:39:51.66,Default,TIRAMISU,0,0,0,,Tanga!
Dialogue: 0,0:40:04.68,0:40:07.24,Default,TIRAMISU,0,0,0,,Bakit napakalaki ng mga bola ng patatas?
Dialogue: 0,0:40:07.88,0:40:09.78,Default,TIRAMISU,0,0,0,,Kailan nila dadalhin ang gatas?
Dialogue: 0,0:40:10.61,0:40:11.75,Default,TIRAMISU,0,0,0,,Kamahalan.
Dialogue: 0,0:40:14.22,0:40:19.32,Default,TIRAMISU,0,0,0,,Ginatasan ko lahat ng baka hanggang sa huling patak.
Dialogue: 0,0:40:24.40,0:40:26.26,Default,TIRAMISU,0,0,0,,Magaling.
Dialogue: 0,0:40:27.50,0:40:28.73,Default,TIRAMISU,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:40:36.21,0:40:37.74,Default,TIRAMISU,0,0,0,,Sigang na gatas.
Dialogue: 0,0:40:46.05,0:40:48.49,Default,TIRAMISU,0,0,0,,Bakit ka nagdadagdag ng patatas sa sinigang mo?
Dialogue: 0,0:40:48.49,0:40:49.62,Default,TIRAMISU,0,0,0,,Paano kaya.
Dialogue: 0,0:40:49.79,0:40:52.06,Default,TIRAMISU,0,0,0,,Ikaw ba ang aking biyenan?
Dialogue: 0,0:40:52.06,0:40:53.92,Default,TIRAMISU,0,0,0,,Hindi dapat makialam ang mga biyenan sa kanilang mga manugang.
Dialogue: 0,0:40:54.96,0:40:55.96,Default,TIRAMISU,0,0,0,,Ano?
Dialogue: 0,0:40:56.19,0:40:58.76,Default,TIRAMISU,0,0,0,,Bakit hindi dapat guluhin ng mga biyenan ang kanilang mga manugang?
Dialogue: 0,0:40:58.76,0:41:00.26,Default,TIRAMISU,0,0,0,,Mali ito.
Dialogue: 0,0:41:07.17,0:41:08.17,Default,TIRAMISU,0,0,0,,Okay.
Dialogue: 0,0:41:20.72,0:41:22.72,Default,TIRAMISU,0,0,0,,Ihahatid ko sa kanya ng personal.
Dialogue: 0,0:41:54.79,0:41:56.02,Default,TIRAMISU,0,0,0,,Masarap lang.
Dialogue: 0,0:41:59.42,0:42:00.52,Default,TIRAMISU,0,0,0,,Gayunpaman,
Dialogue: 0,0:42:01.56,0:42:04.26,Default,TIRAMISU,0,0,0,,habang lumalamig ang patatas, tumitigas sila.
Dialogue: 0,0:42:04.83,0:42:07.67,Default,TIRAMISU,0,0,0,,At tumalsik sa plato ang sinigang na gatas.
Dialogue: 0,0:42:07.67,0:42:09.20,Default,TIRAMISU,0,0,0,,Ito ay lahat, siyempre, hindi kasiya-siya.
Dialogue: 0,0:42:09.60,0:42:10.67,Default,TIRAMISU,0,0,0,,Pero naiintindihan ko
Dialogue: 0,0:42:11.44,0:42:13.47,Default,TIRAMISU,0,0,0,,walang perpekto.
Dialogue: 0,0:42:18.28,0:42:19.94,Default,TIRAMISU,0,0,0,,Imposibleng ihanda ang perpektong ulam
Dialogue: 0,0:42:19.94,0:42:21.71,Default,TIRAMISU,0,0,0,,nang walang maayos na serbisyo.
Dialogue: 0,0:42:22.78,0:42:24.95,Default,TIRAMISU,0,0,0,,Paano ko ihahain ang ulam nang hindi lumalamig
Dialogue: 0,0:42:24.95,0:42:26.78,Default,TIRAMISU,0,0,0,,at hindi ito tumagas?
Dialogue: 0,0:42:26.78,0:42:28.32,Default,TIRAMISU,0,0,0,,Narito ang pangunahing tanong.
Dialogue: 0,0:43:20.97,0:43:22.51,Default,TIRAMISU,0,0,0,,Tanungin natin ang mga eksperto.
Dialogue: 0,0:43:26.51,0:43:27.51,Default,TIRAMISU,0,0,0,,Kunin mo.
Dialogue: 0,0:43:27.51,0:43:29.05,Default,TIRAMISU,0,0,0,,Bakit hindi mo pa ito idinidikit?
Dialogue: 0,0:43:29.05,0:43:30.71,Default,TIRAMISU,0,0,0,,Hindi ka pa rin tapos?
Dialogue: 0,0:43:30.71,0:43:32.95,Default,TIRAMISU,0,0,0,,-Anong ginagawa mo?\N-Bilisan mo.
Dialogue: 0,0:43:36.19,0:43:40.19,Default,TIRAMISU,0,0,0,,-Kamahalan.\N-Kamahalan.
Dialogue: 0,0:43:40.19,0:43:41.23,Default,TIRAMISU,0,0,0,,Kamahalan.
Dialogue: 0,0:43:45.86,0:43:48.70,Default,TIRAMISU,0,0,0,,Palanquin. Kailangan ko ng palanquin para sa pagkain.
Dialogue: 0,0:43:48.70,0:43:49.70,Default,TIRAMISU,0,0,0,,Kamahalan.
Dialogue: 0,0:43:50.07,0:43:52.14,Default,TIRAMISU,0,0,0,,Kamahalan.
Dialogue: 0,0:43:52.47,0:43:53.57,Default,TIRAMISU,0,0,0,,Palanquin para sa pagkain?
Dialogue: 0,0:43:53.57,0:43:55.31,Default,TIRAMISU,0,0,0,,-Palanquin para sa pagkain?\N-Palanquin para sa pagkain?
Dialogue: 0,0:43:55.31,0:43:57.54,Default,TIRAMISU,0,0,0,,-Anong klaseng palanquin para sa pagkain?\N-Isang palanquin para sa pagkain?
Dialogue: 0,0:43:58.84,0:44:00.78,Default,TIRAMISU,0,0,0,,Palanquin para sa pagkain?
Dialogue: 0,0:44:00.78,0:44:02.68,Default,TIRAMISU,0,0,0,,-Ano?\N-Palanquin para sa pagkain?
Dialogue: 0,0:44:02.95,0:44:04.38,Default,TIRAMISU,0,0,0,,-Ano ang ibinubulong mo diyan?\N-Palanquin para sa pagkain?
Dialogue: 0,0:44:05.65,0:44:06.85,Default,TIRAMISU,0,0,0,,-Ano?\N-Palanquin para sa pagkain?
Dialogue: 0,0:44:07.72,0:44:09.32,Default,TIRAMISU,0,0,0,,Mag-ingat.
Dialogue: 0,0:44:10.72,0:44:11.76,Default,TIRAMISU,0,0,0,,Passing.
Dialogue: 0,0:44:12.96,0:44:13.99,Default,TIRAMISU,0,0,0,,Iyon lang.
Dialogue: 0,0:44:15.09,0:44:16.59,Default,TIRAMISU,0,0,0,,Nandito na ang Kamahalan.
Dialogue: 0,0:44:18.16,0:44:20.86,Default,TIRAMISU,0,0,0,,-Nagsama-sama. Isa-dalawa.\N-Isa-dalawa.
Dialogue: 0,0:44:20.86,0:44:24.50,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:44:24.50,0:44:26.30,Default,TIRAMISU,0,0,0,,-One-two, one-two.\N-Well, tingnan natin.
Dialogue: 0,0:44:26.30,0:44:29.31,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:44:29.31,0:44:31.04,Default,TIRAMISU,0,0,0,,-Ano? At iyon lang?\N-Isa-dalawa.
Dialogue: 0,0:44:31.04,0:44:32.98,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:44:32.98,0:44:34.14,Default,TIRAMISU,0,0,0,,-Isa-dalawa.\N-Isa-dalawa.
Dialogue: 0,0:44:34.14,0:44:35.88,Default,TIRAMISU,0,0,0,,-Nagtatrabaho ka ba buong gabi?\N-Oo.
Dialogue: 0,0:44:35.88,0:44:37.25,Default,TIRAMISU,0,0,0,,Nagtrabaho kami sa shift.
Dialogue: 0,0:44:37.25,0:44:39.68,Default,TIRAMISU,0,0,0,,Nag-ipon sila ng tubig at ibinuhos ito sa lawa magdamag.
Dialogue: 0,0:44:39.68,0:44:41.29,Default,TIRAMISU,0,0,0,,Ngunit napakalaki ng lawa.
Dialogue: 0,0:44:41.29,0:44:42.32,Default,TIRAMISU,0,0,0,,-Isa-dalawa.\N-Isa-dalawa.
Dialogue: 0,0:44:42.32,0:44:44.19,Default,TIRAMISU,0,0,0,,Inabot ng isang araw para maubos ang lawa.
Dialogue: 0,0:44:44.19,0:44:45.59,Default,TIRAMISU,0,0,0,,Bakit napakatagal mapuno?
Dialogue: 0,0:44:45.59,0:44:47.59,Default,TIRAMISU,0,0,0,,Nasa burol ang lawa, kaya
Dialogue: 0,0:44:47.59,0:44:50.23,Default,TIRAMISU,0,0,0,,madaling maubos - gumawa ka lang ng balon.
Dialogue: 0,0:44:51.40,0:44:54.10,Default,TIRAMISU,0,0,0,,I bet na relax sila,
Dialogue: 0,0:44:54.10,0:44:55.97,Default,TIRAMISU,0,0,0,,dahil walang caretaker.
Dialogue: 0,0:44:57.57,0:44:58.74,Default,TIRAMISU,0,0,0,,-Isa-dalawa.\N-Isa-dalawa.
Dialogue: 0,0:45:05.58,0:45:08.18,Default,TIRAMISU,0,0,0,,Siguro pagkatapos natin,
Dialogue: 0,0:45:08.58,0:45:11.38,Default,TIRAMISU,0,0,0,,may baso ba tayo?
Dialogue: 0,0:45:12.68,0:45:13.75,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:45:13.75,0:45:15.72,Default,TIRAMISU,0,0,0,,Ano sa tingin mo? A?
Dialogue: 0,0:45:16.82,0:45:19.36,Default,TIRAMISU,0,0,0,,Tinanong kita! Ito ang mga brats.
Dialogue: 0,0:45:20.29,0:45:21.63,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:45:22.86,0:45:24.96,Default,TIRAMISU,0,0,0,,Ano ang nagdadala sa iyo dito?
Dialogue: 0,0:45:25.16,0:45:28.93,Default,TIRAMISU,0,0,0,,Gusto ng Kamahalan ng softdrinks.
Dialogue: 0,0:45:29.67,0:45:30.83,Default,TIRAMISU,0,0,0,,Reyna?
Dialogue: 0,0:45:34.44,0:45:35.47,Default,TIRAMISU,0,0,0,,Ganun ba?
Dialogue: 0,0:45:36.97,0:45:40.68,Default,TIRAMISU,0,0,0,,Tapos gagawa ako ng simpleng azalea punch.
Dialogue: 0,0:45:41.35,0:45:42.71,Default,TIRAMISU,0,0,0,,Para sa unang ani
Dialogue: 0,0:45:42.71,0:45:45.78,Default,TIRAMISU,0,0,0,,Schisandra berries ay hinog na mabuti.
Dialogue: 0,0:45:46.15,0:45:48.92,Default,TIRAMISU,0,0,0,,Brew tea mula sa berries at sweeten with honey.
Dialogue: 0,0:45:48.92,0:45:51.92,Default,TIRAMISU,0,0,0,,Magdaragdag ako ng mga peras at tangerines para sa pagiging bago.
Dialogue: 0,0:45:52.36,0:45:54.43,Default,TIRAMISU,0,0,0,,Upang mapanatili ang pagiging bago at
Dialogue: 0,0:45:54.43,0:45:56.43,Default,TIRAMISU,0,0,0,,palamigin ang inumin, magdagdag ng yelo.
Dialogue: 0,0:45:57.09,0:45:59.90,Default,TIRAMISU,0,0,0,,Dahil hindi pa namumulaklak ang azaleas,
Dialogue: 0,0:46:00.10,0:46:03.00,Default,TIRAMISU,0,0,0,,Gumagamit ako ng evening primrose. Tinatanggal namin ang halo,
Dialogue: 0,0:46:03.00,0:46:04.84,Default,TIRAMISU,0,0,0,,isang maliit na almirol,
Dialogue: 0,0:46:04.84,0:46:06.90,Default,TIRAMISU,0,0,0,,ihulog sa kumukulong tubig
Dialogue: 0,0:46:06.90,0:46:08.61,Default,TIRAMISU,0,0,0,,at palamig sa malamig na tubig.
Dialogue: 0,0:46:08.77,0:46:11.21,Default,TIRAMISU,0,0,0,,Gumamit ng mga bulaklak para palamutihan ang suntok.
Dialogue: 0,0:46:11.71,0:46:15.18,Default,TIRAMISU,0,0,0,,Ang panghuling touch ay tatlong pine nuts.
Dialogue: 0,0:46:21.25,0:46:24.36,Default,TIRAMISU,0,0,0,,Nakakapaghanda ako ng ganoong inumin na nakapikit.
Dialogue: 0,0:46:24.52,0:46:25.62,Default,TIRAMISU,0,0,0,,Iyon lang.
Dialogue: 0,0:46:28.53,0:46:32.43,Default,TIRAMISU,0,0,0,,Well, nakita ko kung paano mo ginawa ito nang nakadilat ang iyong mga mata.
Dialogue: 0,0:46:39.34,0:46:41.77,Default,TIRAMISU,0,0,0,,Bakit sa akin lang siya nakatingin?
Dialogue: 0,0:46:43.07,0:46:44.21,Default,TIRAMISU,0,0,0,,Nakakahiya.
Dialogue: 0,0:46:59.36,0:47:01.16,Default,TIRAMISU,0,0,0,,Pinapanatili ang ritmo.
Dialogue: 0,0:47:05.76,0:47:08.87,Default,TIRAMISU,0,0,0,,Kamahalan, narito ang iyong inumin.
Dialogue: 0,0:47:09.27,0:47:13.14,Default,TIRAMISU,0,0,0,,Ano? Oo. Tingnan natin.
Dialogue: 0,0:47:13.84,0:47:15.97,Default,TIRAMISU,0,0,0,,Siyempre, wala ako sa posisyon na iyon,
Dialogue: 0,0:47:16.27,0:47:17.98,Default,TIRAMISU,0,0,0,,ngunit hindi mo ito maiiwasan - i-enjoy ito.
Dialogue: 0,0:47:21.55,0:47:22.61,Default,TIRAMISU,0,0,0,,Okay.
Dialogue: 0,0:47:25.18,0:47:26.18,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:47:30.82,0:47:32.06,Default,TIRAMISU,0,0,0,,Ilan pa?
Dialogue: 0,0:47:32.19,0:47:34.39,Default,TIRAMISU,0,0,0,,Sa bilis na ito matatapos tayo pagsapit ng gabi.
Dialogue: 0,0:47:34.39,0:47:35.49,Default,TIRAMISU,0,0,0,,Hanggang sa paglubog ng araw.
Dialogue: 0,0:47:35.99,0:47:38.10,Default,TIRAMISU,0,0,0,,Ito ay imposible.
Dialogue: 0,0:47:38.10,0:47:40.40,Default,TIRAMISU,0,0,0,,How dare you. Siguraduhing tapusin mo ngayon.
Dialogue: 0,0:47:40.40,0:47:42.53,Default,TIRAMISU,0,0,0,,Kung hindi, magulong ang mga ulo.
Dialogue: 0,0:47:43.60,0:47:44.64,Default,TIRAMISU,0,0,0,,Sinusunod ko.
Dialogue: 0,0:47:47.94,0:47:50.47,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:47:50.47,0:47:52.01,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:47:52.01,0:47:53.14,Default,TIRAMISU,0,0,0,,Sabihin sa royal chef
Dialogue: 0,0:47:53.31,0:47:56.31,Default,TIRAMISU,0,0,0,,-ihanda mo itong inumin para sa lahat ng naririto.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:47:56.31,0:47:58.22,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:47:58.22,0:47:59.78,Default,TIRAMISU,0,0,0,,-Para sa lahat ng mga tagapaglingkod na ito?\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:47:59.78,0:48:01.99,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:48:01.99,0:48:05.02,Default,TIRAMISU,0,0,0,,-Isa-dalawa, isa-dalawa.\N-Isa-dalawa, isa-dalawa.
Dialogue: 0,0:48:11.83,0:48:15.30,Default,TIRAMISU,0,0,0,,Pumunta na naman siya dito, siguradong nainlove sa talent ko.
Dialogue: 0,0:48:16.33,0:48:19.84,Default,TIRAMISU,0,0,0,,I'm sure hihingi pa siya ng suntok.
Dialogue: 0,0:48:21.67,0:48:23.01,Default,TIRAMISU,0,0,0,,Oo, nakikinig ako sa iyo.
Dialogue: 0,0:48:23.01,0:48:25.61,Default,TIRAMISU,0,0,0,,Hinihiling sa iyo ng Reyna na maghanda ng higit pang suntok.
Dialogue: 0,0:48:26.98,0:48:29.15,Default,TIRAMISU,0,0,0,,Alam kong mas gusto pa niya.
Dialogue: 0,0:48:29.55,0:48:33.65,Default,TIRAMISU,0,0,0,,Nahulog ba niya ang bowl dahil sa sarap?
Dialogue: 0,0:48:34.32,0:48:37.19,Default,TIRAMISU,0,0,0,,O baka lumuha siya?
Dialogue: 0,0:48:40.36,0:48:43.16,Default,TIRAMISU,0,0,0,,Court lady Choi, kita mo,
Dialogue: 0,0:48:44.16,0:48:45.33,Default,TIRAMISU,0,0,0,,anong klaseng tao ako.
Dialogue: 0,0:48:47.40,0:48:49.40,Default,TIRAMISU,0,0,0,,-Royal Chef.\N-Royal Chef.
Dialogue: 0,0:48:49.40,0:48:51.03,Default,TIRAMISU,0,0,0,,Well, well, tumigil ka diyan.
Dialogue: 0,0:48:52.34,0:48:54.17,Default,TIRAMISU,0,0,0,,Royal chef, ang bagay ay...
Dialogue: 0,0:48:54.17,0:48:58.38,Default,TIRAMISU,0,0,0,,Syempre gagawa din ako ng kaunti para sayo.
Dialogue: 0,0:48:59.31,0:49:02.88,Default,TIRAMISU,0,0,0,,Palagay ko nagustuhan mo rin ang inumin
Dialogue: 0,0:49:03.28,0:49:05.32,Default,TIRAMISU,0,0,0,,higit sa karaniwan.
Dialogue: 0,0:49:11.29,0:49:12.59,Default,TIRAMISU,0,0,0,,Nakita mo ba ang ginawa ko?
Dialogue: 0,0:49:12.59,0:49:14.59,Default,TIRAMISU,0,0,0,,Nakakatawa iyon.
Dialogue: 0,0:49:24.30,0:49:26.90,Default,TIRAMISU,0,0,0,,Gumawa ako ng isa pa. Sandali lang.
Dialogue: 0,0:49:27.14,0:49:31.28,Default,TIRAMISU,0,0,0,,Habang naghahanda ka ng isa, gagawa ka pa ba ng kaunti?
Dialogue: 0,0:49:32.18,0:49:35.75,Default,TIRAMISU,0,0,0,,Siyempre. Magkano ang kailangan mo?
Dialogue: 0,0:49:37.01,0:49:39.38,Default,TIRAMISU,0,0,0,,-Eto na.\N-Ang sarap.
Dialogue: 0,0:49:39.38,0:49:41.08,Default,TIRAMISU,0,0,0,,Salamat.
Dialogue: 0,0:49:41.29,0:49:43.72,Default,TIRAMISU,0,0,0,,Salamat, Kamahalan.
Dialogue: 0,0:49:53.53,0:49:56.43,Default,TIRAMISU,0,0,0,,Napakamahal. Salamat, Kamahalan.
Dialogue: 0,0:49:56.87,0:49:58.20,Default,TIRAMISU,0,0,0,,At least aware ka.
Dialogue: 0,0:49:59.10,0:50:02.01,Default,TIRAMISU,0,0,0,,Salamat sa iyong kabutihang-loob, Kamahalan.
Dialogue: 0,0:50:02.01,0:50:05.44,Default,TIRAMISU,0,0,0,,Salamat sa iyong kabutihang-loob, Kamahalan.
Dialogue: 0,0:50:05.61,0:50:07.78,Default,TIRAMISU,0,0,0,,Oo, oo. Walang espesyal.
Dialogue: 0,0:50:08.28,0:50:09.61,Default,TIRAMISU,0,0,0,,Huwag kang tumayo diyan, uminom ka.
Dialogue: 0,0:50:12.72,0:50:14.45,Default,TIRAMISU,0,0,0,,Napakasarap nito.
Dialogue: 0,0:50:15.45,0:50:17.52,Default,TIRAMISU,0,0,0,,Napakadali nilang gawin.
Dialogue: 0,0:50:24.36,0:50:28.23,Default,TIRAMISU,0,0,0,,Nagtago ako ng husto na kahit isang ibon ay hindi mapansin.
Dialogue: 0,0:50:31.37,0:50:33.44,Default,TIRAMISU,0,0,0,,Nagsikap ako,
Dialogue: 0,0:50:33.94,0:50:35.61,Default,TIRAMISU,0,0,0,,pero gusto ko lang uminom ngayon.
Dialogue: 0,0:50:46.92,0:50:48.85,Default,TIRAMISU,0,0,0,,Napaka-busy mo simula kahapon.
Dialogue: 0,0:50:49.25,0:50:51.72,Default,TIRAMISU,0,0,0,,Bagaman hindi ako sigurado sa ginagawa mo.
Dialogue: 0,0:50:52.16,0:50:54.52,Default,TIRAMISU,0,0,0,,Nakita mo na ba ako?
Dialogue: 0,0:50:54.96,0:50:58.40,Default,TIRAMISU,0,0,0,,Siyempre. Madali kang makita.
Dialogue: 0,0:50:58.56,0:50:59.56,Default,TIRAMISU,0,0,0,,Madaling mapansin?
Dialogue: 0,0:51:01.23,0:51:02.50,Default,TIRAMISU,0,0,0,,Ganyan ang sinadya.
Dialogue: 0,0:51:02.50,0:51:04.77,Default,TIRAMISU,0,0,0,,Noon, hindi ako napansin ng dalawang court ladies
Dialogue: 0,0:51:04.77,0:51:06.50,Default,TIRAMISU,0,0,0,,at nakipag-usap nang hayagan.
Dialogue: 0,0:51:06.50,0:51:09.31,Default,TIRAMISU,0,0,0,,Dapat akong bumalik sa reyna.
Dialogue: 0,0:51:11.94,0:51:13.01,Default,TIRAMISU,0,0,0,,Bowl.
Dialogue: 0,0:51:58.79,0:52:00.26,Default,TIRAMISU,0,0,0,,Mula nang mahuli ako,
Dialogue: 0,0:52:00.96,0:52:02.33,Default,TIRAMISU,0,0,0,,tapos tatapusin ko para sa araw na ito.
Dialogue: 0,0:52:08.87,0:52:11.00,Default,TIRAMISU,0,0,0,,Nung nakita niya ako,
Dialogue: 0,0:52:11.60,0:52:15.97,Default,TIRAMISU,0,0,0,,Nagpakita ako sa kanya na parang bulaklak.
Dialogue: 0,0:52:27.18,0:52:28.39,Default,TIRAMISU,0,0,0,,Paano kaya.
Dialogue: 0,0:52:35.83,0:52:36.96,Default,TIRAMISU,0,0,0,,Masasaktan ka.
Dialogue: 0,0:52:47.77,0:52:49.21,Default,TIRAMISU,0,0,0,,Huwag hawakan nang walang kamay.
Dialogue: 0,0:53:09.56,0:53:12.96,Default,TIRAMISU,0,0,0,,Isang pakiramdam na gusto mo ng sakit, -
Dialogue: 0,0:53:13.56,0:53:14.56,Default,TIRAMISU,0,0,0,,love.
Dialogue: 0,0:53:31.52,0:53:33.18,Default,TIRAMISU,0,0,0,,Magtatanong ako sa paligid.
Dialogue: 0,0:53:33.65,0:53:36.79,Default,TIRAMISU,0,0,0,,Sigurado akong walang seryoso, kaya huwag kang mag-alala.
Dialogue: 0,0:53:36.79,0:53:39.19,Default,TIRAMISU,0,0,0,,Hindi isa si Ovol sa mga mawawala nang walang sinasabi.
Dialogue: 0,0:53:39.69,0:53:41.46,Default,TIRAMISU,0,0,0,,Sigurado akong may nangyari sa kanya.
Dialogue: 0,0:53:42.13,0:53:43.93,Default,TIRAMISU,0,0,0,,Darating na ang Inang Reyna.
Dialogue: 0,0:53:47.33,0:53:48.40,Default,TIRAMISU,0,0,0,,Inang Reyna.
Dialogue: 0,0:53:49.63,0:53:51.03,Default,TIRAMISU,0,0,0,,Iwan mo kami.
Dialogue: 0,0:53:58.68,0:54:01.71,Default,TIRAMISU,0,0,0,,Tandaan ang lahat ng sinasabi ko ngayon.
Dialogue: 0,0:54:02.78,0:54:05.38,Default,TIRAMISU,0,0,0,,Sa buong palasyo mapagkakatiwalaan mo lang ako,
Dialogue: 0,0:54:05.38,0:54:07.68,Default,TIRAMISU,0,0,0,,dahil nasa iisang bangka ako kasama mo.
Dialogue: 0,0:54:08.39,0:54:12.59,Default,TIRAMISU,0,0,0,,Dapat mong sabihin sa akin ang lahat, nang walang itinatago.
Dialogue: 0,0:54:13.69,0:54:16.69,Default,TIRAMISU,0,0,0,,Ito lang ang paraan para mabuhay kami ng babae.
Dialogue: 0,0:54:45.36,0:54:47.09,Default,TIRAMISU,0,0,0,,So good.
Dialogue: 0,0:54:47.79,0:54:51.09,Default,TIRAMISU,0,0,0,,Prinsipe Yeonpyeong, ang punong eunuch at ako.
Dialogue: 0,0:54:52.93,0:54:54.06,Default,TIRAMISU,0,0,0,,Chief Eunuch.
Dialogue: 0,0:54:54.93,0:54:57.73,Default,TIRAMISU,0,0,0,,Dahil gustong basahin ng reyna ang "Septateuch",
Dialogue: 0,0:54:57.73,0:54:59.97,Default,TIRAMISU,0,0,0,,Hiniling ko sa iyo na kumuha ako ng isa pang kopya.
Dialogue: 0,0:55:01.07,0:55:02.11,Default,TIRAMISU,0,0,0,,Ano?
Dialogue: 0,0:55:04.57,0:55:07.28,Default,TIRAMISU,0,0,0,,Hindi mo ito tinanong sa akin.
Dialogue: 0,0:55:07.38,0:55:08.41,Default,HEIN,0,0,0,,Chief Eunuch.
Dialogue: 0,0:55:08.98,0:55:11.72,Default,HEIN,0,0,0,,Sa paglipas ng mga taon, nagkasakit ka ba ng dementia?
Dialogue: 0,0:55:12.12,0:55:13.98,Default,HEIN,0,0,0,,Naalala ko kung ano ang inorder ko.
Dialogue: 0,0:55:14.38,0:55:17.16,Default,HEIN,0,0,0,,Pumunta kaagad sa Kyujangak at ihatid ang aking mga order.
Dialogue: 0,0:55:17.75,0:55:19.69,Default,HEIN,0,0,0,,Gusto mo bang umalis ako agad?
Dialogue: 0,0:55:19.69,0:55:21.99,Default,HEIN,0,0,0,,Siguro dapat tayong maghintay hanggang sa makalimutan mo muli?
Dialogue: 0,0:55:21.99,0:55:26.03,Default,HEIN,0,0,0,,Samahan na lang kita sa Daejojon hall, at makarating doon sa isang iglap.
Dialogue: 0,0:55:27.20,0:55:30.23,Default,HEIN,0,0,0,,Hindi ako naglalakad mag-isa, poprotektahan ako ni Prince Yeonpyeong kung may mangyari.
Dialogue: 0,0:55:30.23,0:55:31.80,Default,HEIN,0,0,0,,Bakit mag-alala masyado?
Dialogue: 0,0:55:32.24,0:55:33.50,Default,HEIN,0,0,0,,Payuhan kitang magmadali.
Dialogue: 0,0:55:36.44,0:55:37.71,Default,HEIN,0,0,0,,Oo, well.
Dialogue: 0,0:56:00.30,0:56:02.53,Default,HEIN,0,0,0,,Wow, napatay lang ba ako ng baboy-ramo?
Dialogue: 0,0:56:03.67,0:56:04.73,Default,HEIN,0,0,0,,Chief Eunuch.
Dialogue: 0,0:56:05.44,0:56:07.64,Default,HEIN,0,0,0,,-Hindi ka ba nasaktan?\N-Okay lang ako.
Dialogue: 0,0:56:09.21,0:56:11.24,Default,HEIN,0,0,0,,Mukhang nabali ang ilong mo.
Dialogue: 0,0:56:11.24,0:56:12.38,Default,HEIN,0,0,0,,Hindi, ilong ko!
Dialogue: 0,0:56:12.68,0:56:14.28,Default,HEIN,0,0,0,,Wow, dugo ba ito?
Dialogue: 0,0:56:14.48,0:56:16.35,Default,HEIN,0,0,0,,Oo, laging ganyan ang ilong ko!
Dialogue: 0,0:56:16.68,0:56:20.02,Default,HEIN,0,0,0,,Halika. Pwede bang ganito ang ilong ng tao?
Dialogue: 0,0:56:20.02,0:56:21.65,Default,HEIN,0,0,0,,Bilisan mo at pumunta sa infirmary.
Dialogue: 0,0:56:21.65,0:56:23.82,Default,HEIN,0,0,0,,Good God. Sabi niya ayos lang siya.
Dialogue: 0,0:56:25.18,0:56:26.82,Default,HEIN,0,0,0,,Ovol, ang nawawalang court lady,
Dialogue: 0,0:56:26.82,0:56:28.53,Default,HEINE,0,0,0,,nasa palasyo kasama si Concubine Cho
Dialogue: 0,0:56:28.53,0:56:30.69,Default,HAIN,0,0,0,,sa araw na nahulog ang reyna sa lawa.
Dialogue: 0,0:56:31.34,0:56:33.56,Default,HAINE,0,0,0,,Pilipilitin nila siyang magbigay ng maling patotoo.
Dialogue: 0,0:56:33.70,0:56:36.40,Default,HEIN,0,0,0,,Nangyari ang lahat nang malaman ng reyna
Dialogue: 0,0:56:36.40,0:56:37.57,Default,HEIN,0,0,0,,na inatake mo siya.
Dialogue: 0,0:56:38.80,0:56:41.00,Default,HEINE,0,0,0,,Ang target niya ay si Concubine Cho, hindi ako.
Dialogue: 0,0:56:42.41,0:56:43.44,Default,HEIN,0,0,0,,Revenge.
Dialogue: 0,0:56:44.01,0:56:45.88,Default,HEINE,0,0,0,,Ito ba ang gusto ng reyna?
Dialogue: 0,0:56:51.01,0:56:52.05,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,0:56:53.05,0:56:54.05,Default,HEIN,0,0,0,,Hwajin.
Dialogue: 0,0:57:01.59,0:57:02.69,Default,HEIN,0,0,0,,Paumanhin.
Dialogue: 0,0:57:03.26,0:57:05.43,Default,HEIN,0,0,0,,Hwajin, wala kang dapat ihingi ng tawad.
Dialogue: 0,0:57:05.96,0:57:07.50,Default,HEINE,0,0,0,,Kasalanan ko ang lahat.
Dialogue: 0,0:57:08.50,0:57:09.60,Default,HEIN,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:57:14.16,0:57:16.77,Default,HAINE,0,0,0,,Kamakailan ay sinubukan ko ring tanggalin ang reyna.
Dialogue: 0,0:57:18.07,0:57:19.48,Default,HEIN,0,0,0,,Ginaganti niya ako, kaya lang
Dialogue: 0,0:57:19.48,0:57:21.95,Default,Sinusubukan ka ni HEIN,0,0,0,, na sisihin sa insidente sa lawa.
Dialogue: 0,0:57:23.71,0:57:25.45,Default,HEIN,0,0,0,,Patuloy ang parehong mga trick.
Dialogue: 0,0:57:25.94,0:57:28.56,Default,HEIN,0,0,0,,Forge evidence,\Ntrapping the innocent.
Dialogue: 0,0:57:31.02,0:57:33.49,Default,HAINE,0,0,0,,Sasabihin ko sa lahat na sinubukan kong patayin ang reyna.
Dialogue: 0,0:57:34.39,0:57:35.43,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,0:57:37.03,0:57:40.26,Default,HEIN,0,0,0,,Ikaw at ako ay higit na nakakaalam tungkol sa paghihiganti kaysa sa karamihan.
Dialogue: 0,0:57:40.46,0:57:42.03,Default,HEIN,0,0,0,,Higit pa sa pagbabalik ng lahat ng sakit at paghihirap.
Dialogue: 0,0:57:42.03,0:57:43.43,Default,HEIN,0,0,0,,Ganyan ang paghihiganti.
Dialogue: 0,0:57:44.10,0:57:45.47,Default,HEIN,0,0,0,,Nauuhaw din ang Reyna
Dialogue: 0,0:57:45.94,0:57:47.84,Default,HEIN,0,0,0,,ilagay ang espada sa lalamunan ni Hwajin.
Dialogue: 0,0:57:49.84,0:57:52.21,Default,HAINE,0,0,0,,Ang tanging paraan para mapawi ang kanyang galit ay
Dialogue: 0,0:57:53.61,0:57:55.11,Default,HEIN,0,0,0,,luhod ka sa harap niya.
Dialogue: 0,0:57:56.58,0:57:57.71,Default,HEIN,0,0,0,,Wala nang ibang paraan.
Dialogue: 0,0:57:59.82,0:58:02.72,Default,HEINE,0,0,0,,Plano niya lahat,
Dialogue: 0,0:58:02.72,0:58:04.19,Default,HEINE,0,0,0,,para i-set up ako.
Dialogue: 0,0:58:04.72,0:58:06.46,Default,HEINE,0,0,0,,Makikialam ako at tatapusin ko ito.
Dialogue: 0,0:58:08.54,0:58:11.40,Default,HEIN,0,0,0,,Huwag kalimutan ang tungkol sa dakilang layunin\N kung saan ka nagsusumikap.
Dialogue: 0,0:58:11.46,0:58:14.20,Default,HEIN,0,0,0,,O nakalimutan mo na ba kung ilang insulto ang kailangan mong tiisin sa huli
Dialogue: 0,0:58:14.20,0:58:16.10,Default,HEINE,0,0,0,,2 taon para maayos na maghanda?
Dialogue: 0,0:58:16.33,0:58:17.53,Default,HEIN,0,0,0,,Para sa isang mahusay na layunin
Dialogue: 0,0:58:18.12,0:58:20.30,Default,HEIN,0,0,0,,dapat kang lumayo dito.
Dialogue: 0,0:58:23.44,0:58:26.38,Default,HEIN,0,0,0,,Ni minsan sa buhay ko hindi ko ginustong maging hari,
Dialogue: 0,0:58:27.71,0:58:29.21,Default,HEIN,0,0,0,,isang puppet sa maling kamay.
Dialogue: 0,0:58:30.95,0:58:34.82,Default,HEIN,0,0,0,,Pumunta ako sa palasyong ito sa isang dahilan.
Dialogue: 0,0:58:37.65,0:58:39.52,Default,HEIN,0,0,0,,Wala nang tumakas.
Dialogue: 0,0:58:53.50,0:58:55.64,Default,HEIN,0,0,0,,Hindi na kailangang payuhan akong tumakbo ulit.
Dialogue: 0,0:58:56.01,0:58:57.87,Default,HEIN,0,0,0,,Hindi talaga ako tatakas.
Dialogue: 0,0:59:00.28,0:59:02.31,Default,HEIN,0,0,0,,Hahanapin ko ang bawat siwang
Dialogue: 0,0:59:02.31,0:59:04.11,Default,HEIN,0,0,0,,at hahanapin ko si Ovol.
Dialogue: 0,0:59:05.00,0:59:07.46,Default,HEIN,0,0,0,,Malamang, ini-interrogate siya sa isang lugar sa palasyo,
Dialogue: 0,0:59:07.78,0:59:09.38,Default,HEIN,0,0,0,,sa sandaling matalo nila ang pag-amin,
Dialogue: 0,0:59:09.62,0:59:11.75,Default,HEIN,0,0,0,,paparusahan ka kaagad.
Dialogue: 0,0:59:12.59,0:59:13.92,Default,HEIN,0,0,0,,Maghintay,
Dialogue: 0,0:59:15.43,0:59:16.56,Default,HEIN,0,0,0,,hanggang sa mahanap ko siya.
Dialogue: 0,0:59:17.39,0:59:18.46,Default,HEIN,0,0,0,,Okay.
Dialogue: 0,0:59:18.70,0:59:21.90,Default,HEIN,0,0,0,,Pero kung may mali, makialam ako kaagad.
Dialogue: 0,0:59:22.83,0:59:24.70,Default,HEIN,0,0,0,,At pagkatapos ay huwag humarang sa aking daan.
Dialogue: 0,0:59:25.50,0:59:27.00,Default,HEIN,0,0,0,,Ito ay isang order.
Dialogue: 0,0:59:27.67,0:59:29.64,Default,HEIN,0,0,0,,Masyadong maraming buhay ang nawala.
Dialogue: 0,0:59:30.41,0:59:31.57,Default,HEIN,0,0,0,,Ngayon
Dialogue: 0,0:59:32.78,0:59:34.61,Default,HEIN,0,0,0,,Ayokong mawalan ng kahit sino.
Dialogue: 0,0:59:48.66,0:59:52.53,Default,HEIN,0,0,0,,Kamahalan, kailangan mong alagaan ang iyong sarili.
Dialogue: 0,0:59:53.76,0:59:55.06,Default,HEIN,0,0,0,,Susubukan ko.
Dialogue: 0,0:59:55.63,0:59:58.06,Default,HEIN,0,0,0,,Lumuhod o gumapang sa kanilang paanan,
Dialogue: 0,0:59:58.06,1:00:00.34,Default,HEIN,0,0,0,,magpanggap na tanga, na parang hindi pagkakaunawaan, -
Dialogue: 0,1:00:01.00,1:00:02.97,Default,HEIN,0,0,0,,Gagawin ko ang lahat para maiwasan ang mga problema.
Dialogue: 0,1:00:04.91,1:00:05.94,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,1:00:24.83,1:00:27.26,Default,HEIN,0,0,0,,Dapat magsuot kayong lahat ng uniporme.
Dialogue: 0,1:00:27.92,1:00:30.20,Default,HEIN,0,0,0,,Hinahanap namin ang court lady.
Dialogue: 0,1:00:30.67,1:00:32.67,Default,HEIN,0,0,0,,Pinaniniwalaang nasa palasyo siya.
Dialogue: 0,1:00:34.54,1:00:36.71,Default,HEIN,0,0,0,,Siguraduhing walang makakakita sa iyo.
Dialogue: 0,1:00:37.04,1:00:39.28,Default,HEIN,0,0,0,,Mag-ingat nang husto.
Dialogue: 0,1:00:55.89,1:00:58.96,Default,HEIN,0,0,0,,Pagkabagot.
Dialogue: 0,1:01:02.06,1:01:03.93,Default,HEIN,0,0,0,,Ano ang gagawin para masaya?
Dialogue: 0,1:01:05.64,1:01:06.74,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,1:01:06.74,1:01:08.91,Default,HEIN,0,0,0,,Noong isang araw nakuha ko
Dialogue: 0,1:01:08.91,1:01:10.81,Default,HEIN,0,0,0,,itong silk yarn mula sa Qing.
Dialogue: 0,1:01:12.58,1:01:14.18,Default,HEIN,0,0,0,,May bodega ka ba sa iyong bulsa?
Dialogue: 0,1:01:14.18,1:01:17.75,Default,HEIN,0,0,0,,Akala ko balang araw ay gusto mong bumalik sa iyong libangan.
Dialogue: 0,1:01:19.25,1:01:21.02,Default,HEIN,0,0,0,,Paumanhin, siyempre, ngunit hindi, salamat.
Dialogue: 0,1:01:21.06,1:01:22.35,Default,HEIN,0,0,0,,Sulit na kunin ang karayom,
Dialogue: 0,1:01:22.35,1:01:24.25,Default,HEIN,0,0,0,,wala nang natira sa mga daliri ko.
Dialogue: 0,1:01:24.25,1:01:25.29,Default,HEIN,0,0,0,,Samakatuwid
Dialogue: 0,1:01:26.49,1:01:28.12,Default,HEIN,0,0,0,,Lubos akong armado.
Dialogue: 0,1:01:30.53,1:01:32.36,Default,HEIN,0,0,0,,Kakapakita mo lang ba sa akin ng trick?
Dialogue: 0,1:01:33.46,1:01:35.73,Default,HEIN,0,0,0,,Ano ang sinasabi mo? Ito ay tinatawag na didal.
Dialogue: 0,1:01:36.07,1:01:38.30,Default,HEIN,0,0,0,,Napagpasyahan mo na ba na laruan ito, Kamahalan?
Dialogue: 0,1:01:39.44,1:01:40.54,Default,HEIN,0,0,0,,Lady Choi.
Dialogue: 0,1:01:41.27,1:01:42.74,Default,HEIN,0,0,0,,Labas ka ba talaga sa topic?
Dialogue: 0,1:01:47.24,1:01:48.48,Default,HEIN,0,0,0,,Honyoung, at ikaw?
Dialogue: 0,1:01:52.64,1:01:54.98,Default,HEIN,0,0,0,,May nakatagong kahulugan ba ang didal?
Dialogue: 0,1:01:55.28,1:01:58.42,Default,HEIN,0,0,0,,Inihanda ko ito para hindi mo matutusok ang iyong mga daliri habang nananahi.
Dialogue: 0,1:01:59.76,1:02:02.02,Default,HEIN,0,0,0,,Ako ay pinahihirapan ng hindi malinaw na mga pagdududa.
Dialogue: 0,1:02:13.20,1:02:16.74,Default,HEIN,0,0,0,,Kamahalan, labis akong nag-alala sa iyo.
Dialogue: 0,1:02:16.74,1:02:18.34,Default,HEIN,0,0,0,,Nauna ka sa akin.
Dialogue: 0,1:02:19.28,1:02:22.22,Default,HEIN,0,0,0,,Hindi dapat tumakbo ang hari,\Nheels sparkling, nagtagal siya.
Dialogue: 0,1:02:25.45,1:02:26.92,Default,HAINE,0,0,0,,Nasa bahay ba ang Reyna?
Dialogue: 0,1:02:28.28,1:02:30.52,Default,HEIN,0,0,0,,Narinig ko ang Her Majesty na naglalakad sa tabi ng lawa.
Dialogue: 0,1:02:32.15,1:02:33.59,Default,HEIN,0,0,0,,Sa tabi ng lawa? Bakit biglaan?
Dialogue: 0,1:02:35.16,1:02:36.83,Default,HEIN,0,0,0,,Nagkasabay ang mga salita ni Concubine Cho
Dialogue: 0,1:02:37.23,1:02:40.63,Default,HEIN,0,0,0,,na may mga salita ng Kanyang Kamahalan.
Dialogue: 0,1:02:41.30,1:02:44.33,Default,HAINE,0,0,0,,Hindi man lang daw niya nakilala ang reyna noong gabing iyon.
Dialogue: 0,1:02:45.33,1:02:48.67,Default,HEIN,0,0,0,,Na tumakbo siya palayo matapos makarinig ng malakas na tunog.
Dialogue: 0,1:02:49.74,1:02:53.14,Default,HEIN,0,0,0,,Pero kung totoo o mali, hindi ko alam.
Dialogue: 0,1:02:53.71,1:02:55.04,Default,HEIN,0,0,0,,Mukhang babae lang,
Dialogue: 0,1:02:55.04,1:02:58.28,Default,HEIN,0,0,0,,na nakita ng eunuch at mga katulong na nagnanakaw ng mga regalo ng hari,
Dialogue: 0,1:02:58.85,1:03:02.92,Default,HEINE,0,0,0,,talagang concubine ni Cho.
Dialogue: 0,1:03:03.59,1:03:06.96,Default,HAINE,0,0,0,,O nahulog siya sa bitag ng reyna.
Dialogue: 0,1:03:08.72,1:03:10.83,Default,HEINE,0,0,0,,Bago niya ibuka ang kanyang mga pakpak.
Dialogue: 0,1:03:14.70,1:03:15.73,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,1:03:16.12,1:03:18.20,Default,HAIN,0,0,0,,Nasa Dongmyeongjong Hall na ngayon si Concubine Cho.
Dialogue: 0,1:03:37.45,1:03:40.09,Default,HEIN,0,0,0,,poprotektahan kita, Kamahalan.
Dialogue: 0,1:03:46.33,1:03:48.03,Default,HEIN,0,0,0,,Dumating siya sa sarili niyang kusa.
Dialogue: 0,1:03:49.87,1:03:52.97,Default,HEIN,0,0,0,,Mukhang mas malapit si Ovol sa kanya kaysa sa inaasahan namin.
Dialogue: 0,1:03:53.30,1:03:55.91,Default,HEIN,0,0,0,,Maganda iyan. Ito ay naging mas madali kaysa sa naisip namin.
Dialogue: 0,1:03:56.24,1:03:57.54,Default,HEIN,0,0,0,,Mula nang siya mismo ang dumating,
Dialogue: 0,1:03:57.54,1:03:59.71,Default,HEINE,0,0,0,,dapat mong ipaamin sa kanya ang lahat.
Dialogue: 0,1:04:00.18,1:04:02.65,Default,HEIN,0,0,0,,Mas mahalaga sa akin ang kalusugan,
Dialogue: 0,1:04:03.05,1:04:04.78,Default,HEIN,0,0,0,,Tatapusin ko muna ang pagkain ko.
Dialogue: 0,1:04:04.78,1:04:06.42,Default,HEIN,0,0,0,,Tama ka.
Dialogue: 0,1:04:57.36,1:04:58.83,Default,HEIN,0,0,0,,Mali ang lahat.
Dialogue: 0,1:04:59.80,1:05:03.57,Default,HEIN,0,0,0,,Hinding-hindi gagawin ni Mistress Hwajin ang ganoong bagay.
Dialogue: 0,1:05:05.31,1:05:09.31,Default,HEIN,0,0,0,,Kahit patayin mo ako, hindi magbabago ang katotohanan.
Dialogue: 0,1:05:17.12,1:05:18.25,Default,HEIN,0,0,0,,Kaawa-awa.
Dialogue: 0,1:05:18.72,1:05:21.59,Default,HEIN,0,0,0,,Para kang isang tapat na aso na dumidilaan
Dialogue: 0,1:05:21.59,1:05:24.13,Default,HEIN,0,0,0,,mga kamay ng ginang na sasaksakin ka.
Dialogue: 0,1:05:26.03,1:05:28.06,Default,HEIN,0,0,0,,Huli na para umamin.
Dialogue: 0,1:05:30.07,1:05:32.77,Default,HEIN,0,0,0,,Ang iyong maybahay, si Hwajin, ay sinisi ang lahat sa iyo.
Dialogue: 0,1:05:36.14,1:05:37.31,Default,HEIN,0,0,0,,Hindi ito maaaring.
Dialogue: 0,1:05:45.08,1:05:46.15,Default,HEIN,0,0,0,,Narito.
Dialogue: 0,1:05:47.38,1:05:48.75,Default,HEIN,0,0,0,,Wow, ang galing mo.
Dialogue: 0,1:05:49.95,1:05:51.02,Default,HEIN,0,0,0,,Iyon lang.
Dialogue: 0,1:05:59.36,1:06:02.00,Default,HEIN,0,0,0,,-God.\N-Ganong mahalagang sinulid.
Dialogue: 0,1:06:02.06,1:06:04.03,Default,HEIN,0,0,0,,Ang walang hanggang problema sa mamahaling tchotchkes.
Dialogue: 0,1:06:04.03,1:06:05.57,Default,HEIN,0,0,0,,Napakarupok.
Dialogue: 0,1:06:06.40,1:06:07.47,Default,HEIN,0,0,0,,Tingnan natin.
Dialogue: 0,1:06:08.04,1:06:10.71,Default,HEIN,0,0,0,,Maghanap tayo ng mas malakas.
Dialogue: 0,1:06:19.38,1:06:21.72,Default,HEIN,0,0,0,,"Iwanan mo ang iyong huwad na sarili"?
Dialogue: 0,1:06:22.22,1:06:24.35,Default,HEIN,0,0,0,,"Iwan mo ang iyong huwad na sarili"?
Dialogue: 0,1:06:24.35,1:06:25.49,Default,HEIN,0,0,0,,Ano ito?
Dialogue: 0,1:06:25.49,1:06:28.82,Default,HEIN,0,0,0,,Ikaw mismo ang nagburda ng mga hieroglyph na ito noong mayroon kang libreng minuto.
Dialogue: 0,1:06:29.09,1:06:31.46,Default,HEIN,0,0,0,,Hindi ko alam kung ano ang ibig nilang sabihin, I'm illiterate,
Dialogue: 0,1:06:31.46,1:06:33.30,Default,HEINE,0,0,0,,pero sa tingin ko ito ay isang magandang talata.
Dialogue: 0,1:06:33.66,1:06:35.63,Default,HEINE,0,0,0,,Ito ang unang pagkakataon na nakita ko ito.
Dialogue: 0,1:06:36.17,1:06:39.64,Default,HEIN,0,0,0,,Nagkataon na hindi mo nahuli ang reyna na gumagawa ng gawaing ito.
Dialogue: 0,1:06:40.94,1:06:42.67,Default,HEIN,0,0,0,,Ito ay isang tula ng pag-ibig?
Dialogue: 0,1:06:42.67,1:06:45.78,Default,HEINE,0,0,0,,Ito ay isang suicide note.
Dialogue: 0,1:06:47.61,1:06:49.58,Default,HEINE,0,0,0,,Burdahan ko ba ito bago ako nahulog sa lawa?
Dialogue: 0,1:06:49.58,1:06:51.95,Default,HEIN,0,0,0,,Naintindihan ko ba nang tama?
Dialogue: 0,1:06:51.95,1:06:52.98,Default,HEIN,0,0,0,,Oo.
Dialogue: 0,1:06:53.02,1:06:54.22,Default,HEIN,0,0,0,,At wala akong
Dialogue: 0,1:06:54.28,1:06:56.65,Default,HEIN,0,0,0,,mga problema sa pagtulog at kawalan ng gana?
Dialogue: 0,1:06:56.82,1:06:59.29,Default,HEIN,0,0,0,,Were. At panay ang buntong-hininga mo.
Dialogue: 0,1:06:59.29,1:07:01.09,Default,HEINE,0,0,0,,Palaging mukhang depress.
Dialogue: 0,1:07:01.20,1:07:03.23,Default,HEIN,0,0,0,,Minsan umiiyak ka ng walang dahilan.
Dialogue: 0,1:07:04.79,1:07:07.80,Default,HEIN,0,0,0,,Kamahalan, kaya naalala mo ba ang lahat?
Dialogue: 0,1:07:08.03,1:07:09.20,Default,HEIN,0,0,0,,No.
Dialogue: 0,1:07:09.87,1:07:13.24,Default,HEIN,0,0,0,,At hindi ako nagbigay ng mga bagay na mahal sa akin sa sinuman?
Dialogue: 0,1:07:16.04,1:07:18.41,Default,HEIN,0,0,0,,Ibinigay mo sa akin,
Dialogue: 0,1:07:18.41,1:07:19.91,Default,HEIN,0,0,0,,bagama't pinahalagahan nila siya noon.
Dialogue: 0,1:07:20.11,1:07:21.21,Default,HEIN,0,0,0,,At
Dialogue: 0,1:07:21.58,1:07:23.81,Default,HEIN,0,0,0,,nagbigay ng singsing kay Lady Choi.
Dialogue: 0,1:07:27.18,1:07:28.35,Default,HEIN,0,0,0,,Si Cho Hwajin ay mali.
Dialogue: 0,1:07:28.88,1:07:31.72,Default,HAIN,0,0,0,,Hindi sinubukan ni Kim So-yeon na akitin siya sa isang bitag.
Dialogue: 0,1:07:32.42,1:07:33.69,Default,HEIN,0,0,0,,At gusto kong magpakamatay.
Dialogue: 0,1:07:37.06,1:07:38.26,Default,HEIN,0,0,0,,Hindi ba ito Cheoljong?
Dialogue: 0,1:07:38.46,1:07:40.46,Default,HEIN,0,0,0,,The King is Coming!
Dialogue: 0,1:07:40.96,1:07:43.00,Default,HEIN,0,0,0,,Diba sabi niya hindi dapat tumakbo ang mga hari?
Dialogue: 0,1:07:43.43,1:07:46.07,Default,HEIN,0,0,0,,Mukha lang niya nagpapataas ng presyon ng dugo ko.
Dialogue: 0,1:07:48.17,1:07:49.27,Default,HEIN,0,0,0,,Ano?
Dialogue: 0,1:07:49.94,1:07:51.21,Default,HEIN,0,0,0,,Naghahanap ka ba ng away?
Dialogue: 0,1:07:52.84,1:07:54.04,Default,HEIN,0,0,0,,Magkaayos ba tayo na parang mga lalaki?
Dialogue: 0,1:07:54.98,1:07:58.18,Default,HEIN,0,0,0,,Yun lang ba? Ito ba ang iyong pinili?
Dialogue: 0,1:07:59.08,1:08:00.38,Default,HEIN,0,0,0,,Ano ang problema?
Dialogue: 0,1:08:00.38,1:08:02.52,Default,HEIN,0,0,0,,Gumagawa ka na naman ba ng tanga?
Dialogue: 0,1:08:03.69,1:08:06.59,Default,HEIN,0,0,0,,Naloko ba talaga ako sa mga sinungaling mong mata at pananalita?
Dialogue: 0,1:08:07.76,1:08:10.83,Default,HEIN,0,0,0,,Ikaw ang laging niloko sa akin.
Dialogue: 0,1:08:11.88,1:08:15.26,Default,HEIN,0,0,0,,Hindi ko alam na ikaw pala ang nagtangkang pumatay sa akin, natulog pa ako sa iisang kwarto kasama mo.
Dialogue: 0,1:08:15.26,1:08:17.37,Default,HEIN,0,0,0,,So hindi ba dapat ako magalit ngayon?
Dialogue: 0,1:08:17.53,1:08:19.00,Default,HEIN,0,0,0,,Ikaw na mismo ang nagsabi,
Dialogue: 0,1:08:20.14,1:08:23.57,Default,HEIN,0,0,0,,na isang duwag lang ang umaatake sa mas mahina.
Dialogue: 0,1:08:25.02,1:08:26.31,Default,HEIN,0,0,0,,Sinusubukan mo bang maghiganti sa akin?
Dialogue: 0,1:08:27.44,1:08:30.05,Default,HEIN,0,0,0,,Kung ganoon, hindi rin ako uupo
Dialogue: 0,1:08:31.55,1:08:33.78,Default,HEIN,0,0,0,,at pumikit sa lahat ng iyong mga pakana.
Dialogue: 0,1:08:40.92,1:08:42.49,Default,HEIN,0,0,0,,Ano ang sinasabi niya?
Dialogue: 0,1:09:00.81,1:09:01.88,Default,HEIN,0,0,0,,Ano?
Dialogue: 0,1:09:15.12,1:09:16.73,Default,HEIN,0,0,0,,Ano ang dapat kong gawin
Dialogue: 0,1:09:17.83,1:09:20.60,Default,HEIN,0,0,0,,na may ganitong hangal na mahina?
Dialogue: 0,1:09:43.72,1:09:45.05,Default,HAINE,0,0,0,,The Dowager Queen.
Dialogue: 0,1:09:45.40,1:09:47.16,Default,HEIN,0,0,0,,Kung naghahanap ka ng dapat sisihin sa nangyari,
Dialogue: 0,1:09:47.16,1:09:48.62,Default,HEIN,0,0,0,,Handa akong tumanggap ng parusa.
Dialogue: 0,1:09:49.56,1:09:53.16,Default,HEIN,0,0,0,,Maari mo bang linawin kung sino ang hinahanap ko?
Dialogue: 0,1:09:54.73,1:09:58.17,Default,HEIN,0,0,0,,Nawala na ang aking binibini, si Ovol.
Dialogue: 0,1:09:58.77,1:10:00.07,Default,HEIN,0,0,0,,Ano ang kinalaman ko dito?
Dialogue: 0,1:10:01.00,1:10:02.24,Default,HEINE,0,0,0,,Sa tingin mo ba ginawa ko ito?
Dialogue: 0,1:10:02.38,1:10:04.66,Default,HEIN,0,0,0,,Dahil may kailangan ka sa akin.
Dialogue: 0,1:10:07.04,1:10:10.75,Default,HEIN,0,0,0,,At handa akong sabihin kung ano talaga ang gusto mong marinig.
Dialogue: 0,1:10:12.85,1:10:14.95,Default,HEIN,0,0,0,,Tapos makinig tayo.
Dialogue: 0,1:10:17.12,1:10:19.36,Default,HEIN,0,0,0,,Nang nahulog ang reyna sa lawa,
Dialogue: 0,1:10:19.99,1:10:21.59,Default,HEIN,0,0,0,,Nasa malapit ako.
Dialogue: 0,1:10:23.99,1:10:25.49,Default,HEIN,0,0,0,,Balang araw matatalo ka
Dialogue: 0,1:10:26.66,1:10:29.16,Default,HEIN,0,0,0,,taong mahal mo.
Dialogue: 0,1:10:47.85,1:10:50.29,Default,HEIN,0,0,0,,Saglit na gumanda ang emosyon ko,
Dialogue: 0,1:10:52.76,1:10:54.89,Default,HEIN,0,0,0,,at tinulak ko ang reyna sa lawa.
Dialogue: 0,1:11:04.62,1:11:07.04,Default,HEIN,0,0,0,,Hayaan mo akong managot\Nsa nangyari.
Dialogue: 0,1:11:07.24,1:11:10.14,Default,HEIN,0,0,0,,Pakiusap, maawa ka sa mga\Nna walang ginawang mali.
Dialogue: 0,1:11:12.07,1:11:15.88,Default,HEINE,0,0,0,,Masaya kong tatanggapin ang anumang parusa\Nsa aking ginawa.
Dialogue: 0,1:11:18.21,1:11:19.28,Default,HEIN,0,0,0,,Seryoso?
Dialogue: 0,1:11:26.09,1:11:28.79,Default,HEIN,0,0,0,,Alam mo kung tungkol saan ang sulat na ito.
Dialogue: 0,1:11:30.19,1:11:32.90,Default,HAINE,0,0,0,,Natanggap mo ito mula sa Inang Reyna.
Dialogue: 0,1:11:34.73,1:11:37.17,Default,HEIN,0,0,0,,Ibinigay ito sa amin ni Ovol.
Dialogue: 0,1:11:38.10,1:11:41.30,Default,HEIN,0,0,0,,Ang lugar, petsa at oras na nakasaad doon,
Dialogue: 0,1:11:41.44,1:11:44.76,Default,HAINE,0,0,0,,nagtutugma kung kailan at saan\Nnaganap ang aksidente ng reyna.
Dialogue: 0,1:11:45.14,1:11:47.58,Default,HEINE,0,0,0,,Ano sa tingin mo ang ibig sabihin nito?
Dialogue: 0,1:11:48.08,1:11:51.61,Default,HEIN,0,0,0,,Ito ang unang pagkakataon na nakita ko siya.
Dialogue: 0,1:11:53.08,1:11:57.79,Default,HEIN,0,0,0,,Naisip mo ba talaga na kaya mong itago ang lahat?
Dialogue: 0,1:11:59.39,1:12:01.96,Default,HEIN,0,0,0,,At mayroon kang napakataas na opinyon sa iyong sarili.
Dialogue: 0,1:12:02.96,1:12:05.49,Default,HEIN,0,0,0,,Alam mong anino ka lang.
Dialogue: 0,1:12:10.17,1:12:11.93,Default,HAINE,0,0,0,,The Dowager Queen.
Dialogue: 0,1:12:12.37,1:12:15.77,Default,HEIN,0,0,0,,Sigurado ako sa iyo, peke ang sulat na ito.
Dialogue: 0,1:12:16.04,1:12:17.47,Default,HEIN,0,0,0,,At sigurado akong kabaligtaran.
Dialogue: 0,1:12:17.97,1:12:19.88,Default,HEIN,0,0,0,,Dahil sila ay mula sa parehong pamilyang Cho,
Dialogue: 0,1:12:19.88,1:12:22.88,Default,HEIN,0,0,0,,malinaw na nagpasya silang magkaisa para sa kanilang sariling mga layunin.
Dialogue: 0,1:12:22.88,1:12:26.68,Default,HAINE,0,0,0,,Ang Inang Reyna\Nhindi kailanman nakipagsabwatan sa sinuman,
Dialogue: 0,1:12:26.68,1:12:30.22,Default,HEIN,0,0,0,,kahit na sila ay mula sa iisang pamilya.
Dialogue: 0,1:12:31.15,1:12:36.06,Default,HEIN,0,0,0,,Kung gayon sino ang nagpeke ng liham na ito?
Dialogue: 0,1:12:40.30,1:12:42.83,Default,HEIN,0,0,0,,Mukhang kailangan mo ng susuporta
Dialogue: 0,1:12:43.37,1:12:45.47,Default,HEIN,0,0,0,,iyong mga plano.
Dialogue: 0,1:12:50.97,1:12:53.08,Default,HEIN,0,0,0,,Narito na ang Hari!
Dialogue: 0,1:12:55.64,1:12:56.78,Default,HEIN,0,0,0,,Kamahalan.
Dialogue: 0,1:12:58.61,1:13:00.08,Default,HAINE,0,0,0,,The Dowager Queen.
Dialogue: 0,1:13:00.12,1:13:02.52,Default,HEIN,0,0,0,,Dumating ka na. Mahusay.
Dialogue: 0,1:13:02.89,1:13:05.02,Default,XO,0,0,0,,Nagtapat ang royal concubine.
Dialogue: 0,1:13:05.79,1:13:08.36,Default,XO,0,0,0,,Sinabi niya na itinulak niya ang reyna sa lawa na may masamang layunin.
Dialogue: 0,1:13:10.86,1:13:12.80,Default,XO,0,0,0,,Ito ay kasinungalingan.
Dialogue: 0,1:13:12.80,1:13:15.33,Default,XO,0,0,0,,Kamahalan, matauhan ka.
Dialogue: 0,1:13:17.77,1:13:20.14,Default,XO,0,0,0,,Alam kong baliw ka sa kanya,
Dialogue: 0,1:13:20.14,1:13:22.97,Default,XO,0,0,0,,pero hindi ko kayo hahayaang humusga,
Dialogue: 0,1:13:22.97,1:13:24.81,Default,XO,0,0,0,,alam na may kinikilingan ka.
Dialogue: 0,1:13:25.24,1:13:29.28,Default,XO,0,0,0,,Sinusubukan mo bang protektahan ang isang kriminal?
Dialogue: 0,1:13:29.81,1:13:32.51,Default,XO,0,0,0,,Sinubukan niyang saktan ang reyna, ang asawa mo.
Dialogue: 0,1:13:34.18,1:13:35.98,Default,XO,0,0,0,,Sabihin mo mismo sa kanya!
Dialogue: 0,1:13:36.39,1:13:39.09,Default,XO,0,0,0,,Sino ang nagtulak sa reyna sa lawa?
Dialogue: 0,1:13:51.03,1:13:52.23,Default,XO,0,0,0,,Ako iyon.
Dialogue: 0,1:13:52.70,1:13:53.77,Default,XO,0,0,0,,Hwajin.
Dialogue: 0,1:13:58.11,1:13:59.27,Default,XO,0,0,0,,Narinig mo ba?
Dialogue: 0,1:14:03.01,1:14:05.98,Default,XO,0,0,0,,Kung ipipilit mo na sinisisi lang niya ang ibang tao,
Dialogue: 0,1:14:06.28,1:14:09.02,Default,XO,0,0,0,,Bibigyan kita ng pagkakataong patunayan ito.
Dialogue: 0,1:14:11.15,1:14:12.45,Default,XO,0,0,0,,Pasok!
Dialogue: 0,1:14:39.72,1:14:43.05,Default,XO,0,0,0,,Umamin siya, ano ang gagawin natin ngayon?
Dialogue: 0,1:14:43.19,1:14:46.36,Default,XO,0,0,0,,Kailangan siya bilang saksi, ingatan mo siya.
Dialogue: 0,1:14:50.36,1:14:51.49,Default,XO,0,0,0,,Anong ginagawa mo?
Dialogue: 0,1:15:12.45,1:15:13.48,Default,XO,0,0,0,,Grab!
Dialogue: 0,1:15:35.74,1:15:38.57,Default,XO,0,0,0,,Kung umamin ka dito mismo
Dialogue: 0,1:15:38.57,1:15:40.08,Default,XO,0,0,0,,at pumayag na pugutan ng ulo,
Dialogue: 0,1:15:40.84,1:15:43.71,Default,XO,0,0,0,,Hindi ko siya pagdududahan.
Dialogue: 0,1:15:54.59,1:15:56.09,Default,XO,0,0,0,,Sinabi yan ni Cheoljong tuwing gabi
Dialogue: 0,1:15:56.09,1:15:57.69,Default,XO,0,0,0,,nakikita ang kanyang ulo na pinuputol.
Dialogue: 0,1:15:59.03,1:16:00.50,Default,XO,0,0,0,,Malinaw na masama ang pakiramdam niya ngayon.
Dialogue: 0,1:16:01.53,1:16:02.60,Default,XO,0,0,0,,Ito ay isang pagkabigo.
Dialogue: 0,1:16:18.25,1:16:19.85,Default,XO,0,0,0,,Ibubunyag ko ang katotohanan!
Dialogue: 0,1:16:21.25,1:16:24.12,Default,XO,0,0,0,,Tatanggapin ko ang iyong kalooban, Kamahalan!
Dialogue: 0,1:16:25.75,1:16:27.92,Default,XO,0,0,0,,Hindi siya ang kailangang patayin!
Dialogue: 0,1:16:34.93,1:16:36.00,Default,XO,0,0,0,,Kamahalan!
Dialogue: 0,1:16:38.53,1:16:39.60,Default,XO,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,1:16:46.61,1:16:48.68,Default,XO,0,0,0,,Labag ka ba sa kalooban ng hari?
Dialogue: 0,1:17:23.41,1:17:25.01,Default,XO,0,0,0,,Choljong, scoundrel.
Dialogue: 0,1:17:26.25,1:17:27.42,Default,XO,0,0,0,,Ang cool niya.
Dialogue: 0,1:17:31.99,1:17:33.66,Default,XO,0,0,0,,Anong klaseng bayani ang nagpapanggap siya?
Dialogue: 0,1:17:37.89,1:17:38.93,Default,XO,0,0,0,,Sandali lang.
Dialogue: 0,1:17:39.26,1:17:41.63,Default,XO,0,0,0,,Mapupuno ang lawa ngayon.
Dialogue: 0,1:17:42.06,1:17:43.30,Default,XO,0,0,0,,Para makabalik ako.
Dialogue: 0,1:17:44.40,1:17:46.40,Default,XO,0,0,0,,Saktan ang reyna...
Dialogue: 0,1:17:47.17,1:17:48.17,Default,XO,0,0,0,,Stop!
Dialogue: 0,1:18:09.83,1:18:11.43,Default,XO,0,0,0,,Mga Diyos!
Dialogue: 0,1:18:13.50,1:18:14.66,Default,XO,0,0,0,,Ano ang problema?
Dialogue: 0,1:18:14.66,1:18:16.87,Default,XO,0,0,0,,Ubos na ang tubig.
Dialogue: 0,1:18:17.50,1:18:18.53,Default,XO,0,0,0,,Ano?
Dialogue: 0,1:18:21.44,1:18:22.60,Default,XO,0,0,0,,
Dialogue: 0,1:18:23.00,1:18:24.91,Default,XO,0,0,0,,Napakaraming tubig ang kinuha namin,
Dialogue: 0,1:18:24.91,1:18:26.74,Default,XO,0,0,0,,na ang balon ay natuyo.
Dialogue: 0,1:18:27.91,1:18:29.64,Default,XO,0,0,0,,Naku!
Dialogue: 0,1:18:31.11,1:18:33.55,Default,XO,0,0,0,,Tapos na ako.
Dialogue: 0,1:19:03.75,1:19:05.85,Default,XO,0,0,0,,Payagan mo ako, bilang biktima ng insidenteng ito,
Dialogue: 0,1:19:05.88,1:19:07.62,Default,XO,0,0,0,,nagbigay liwanag sa mga kaganapan.
Dialogue: 0,1:19:13.72,1:19:15.02,Default,XO,0,0,0,,I
Dialogue: 0,1:19:20.10,1:19:21.60,Default,XO,0,0,0,, sinubukang magpakamatay.
Dialogue: 0,1:19:25.97,1:19:28.17,Default,XO,0,0,0,,Sa tingin mo isa lang ang cool na lalaki dito?
Dialogue: 0,1:19:28.60,1:19:30.44,Default,XO,0,0,0,,Ako ang bida dito.
Dialogue: 0,1:19:37.25,1:19:39.15,Default,XO,0,0,0,,Babalik ako, kaya bale.
Dialogue: 0,1:19:41.05,1:19:46.32,Default,XO,0,0,0,,Hinihiling ko sa iyo, huwag hawakan ang mga walang kasalanan sa anumang bagay.
Dialogue: 0,1:19:52.29,1:19:53.43,Default,XO,0,0,0,,Mahusay.
Dialogue: 0,1:20:32.40,1:20:34.97,Default,XO,0,0,0,,Pumasok si Prince Yeonpyeong sa palasyo kasama ang mga tulisan.
Dialogue: 0,1:20:34.97,1:20:36.87,Default,XO,0,0,0,,Mukhang sanay na sila.
Dialogue: 0,1:20:36.87,1:20:39.47,Default,XO,0,0,0,,Kailangang putulin ang mga problema sa ugat.
Dialogue: 0,1:20:39.47,1:20:41.88,Default,XO,0,0,0,,Natuyo ang balon.
Dialogue: 0,1:20:41.88,1:20:43.41,Default,XO,0,0,0,,Naniniwala ako na dapat kong
Dialogue: 0,1:20:43.41,1:20:45.65,Default,XO,0,0,0,,iiwan ka para mapasaya ka.
Dialogue: 0,1:20:45.65,1:20:47.32,Default,XO,0,0,0,,Yung matapang na tingin!
Dialogue: 0,1:20:47.32,1:20:49.32,Default,XO,0,0,0,,How dare he?
Dialogue: 0,1:20:49.32,1:20:51.75,Default,XO,0,0,0,,Lalong lumalala ang kalagayan ng reyna araw-araw.
Dialogue: 0,1:20:51.75,1:20:53.39,Default,XO,0,0,0,,Siguro sulit na itanong
Dialogue: 0,1:20:53.39,1:20:54.76,Default,XO,0,0,0,,depose her?
Dialogue: 0,1:20:56.26,1:20:58.29,Default,XO,0,0,0,,Ngayon ay babalik ang lahat sa kanyang lugar.


