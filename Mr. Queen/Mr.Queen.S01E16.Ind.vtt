Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Host, Nanas, Hazelnut
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.08,0:01:06.55,Default,,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.55,0:01:08.59,Default,,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:09.16,0:01:11.63,Default,,0,0,0,,Oh, ibu! Apa yang harus dilakukan?\NIni adalah buku yang sangat berharga.
Dialog: 0,0:01:11.63,0:01:12.63,Default,,0,0,0,,16 episode
Dialogue: 0,0:01:27.91,0:01:30.21,Default,,0,0,0,,Kenapa kamu bilang buku ini tak ternilai harganya?
Dialogue: 0,0:01:32.68,0:01:36.25,Default,,0,0,0,,Apa Nilai Pelajaran Dasar untuk Anak bagi Anda?
Dialogue: 0,0:01:37.98,0:01:39.82,Default,,0,0,0,,-Itu...\N-Apakah itu kamu?
Dialogue: 0,0:01:41.72,0:01:44.32,Default,,0,0,0,,Orang yang menyelamatkanku adalah kamu?
Dialogue: 0,0:01:44.69,0:01:46.79,Default,,0,0,0,,Kau menyelamatkanku dari sumur?
Dialog: 0,0:01:56.47,0:01:58.84,Default,,0,0,0,,Ya. Itu aku.
Dialog: 0,0:02:04.68,0:02:05.98,Default,,0,0,0,,Apakah kamu lupa segalanya?
Dialog: 0,0:02:06.35,0:02:08.25,Default,,0,0,0,,Ya, aku menyeretmu ke punukku.
Dialogue: 0,0:02:09.62,0:02:12.02,Default,,0,0,0,,Tangan masih terjatuh.
Dialog: 0,0:02:12.52,0:02:15.92,Default,,0,0,0,,Aku tidak percaya kamu melupakan segalanya.\NKamu tidak ingat hal baik sama sekali.
Dialog: 0,0:02:16.26,0:02:18.73,Default,,0,0,0,,Tidak, saya sedang membicarakan kejadian delapan tahun lalu.
Dialogue: 0,0:02:19.19,0:02:20.89,Default,,0,0,0,,Jadi ini bukan pertama kalinya kamu terjatuh ke dalam sumur?
Dialog: 0,0:02:21.80,0:02:23.93,Default,,0,0,0,,Apakah kamu tidak melihat sekeliling sama sekali?
Dialogue: 0,0:02:27.50,0:02:29.64,Default,,0,0,0,,Lalu kenapa buku ini begitu berharga?
Dialog: 0,0:02:31.51,0:02:33.87,Default,,0,0,0,,Sepertinya salah satu mahakarya sejati.
Dialog: 0,0:02:36.01,0:02:37.98,Default,,0,0,0,,Sekali lagi Anda berbicara omong kosong.
Dialogue: 0,0:02:39.68,0:02:41.82,Default,,0,0,0,,Bangun dari mimpi buruk,\Nseperti aku dikurung di dalam sumur,
Dialog: 0,0:02:41.82,0:02:43.32,Default,,0,0,0,,Aku langsung teringat padamu.
Dialogue: 0,0:02:44.89,0:02:47.39,Default,,0,0,0,,Aku putuskan itu karena kamu membantuku keluar,
Dialog: 0,0:02:48.66,0:02:50.79,Default,,0,0,0,,tapi sejak itu aku menjadi
Dialog: 0,0:02:50.79,0:02:52.89,Default,,0,0,0,,menyadari betapa mirip\Nkamu dengan gadis yang menyelamatkanku.
Dialogue: 0,0:02:55.06,0:02:57.96,Default,,0,0,0,,Kupikir itu mungkin kamu.
Dialogue: 0,0:03:01.30,0:03:04.27,Default,,0,0,0,,Jika mie membengkak,\Nit rasanya tidak enak.
Dialog: 0,0:03:05.57,0:03:06.67,Default,,0,0,0,,Maukah?
Dialog: 0,0:03:09.41,0:03:11.18,Default,,0,0,0,,Selamat makan.
Dialog: 0,0:03:16.25,0:03:17.35,Default,,0,0,0,,Manis.
Dialog: 0,0:03:19.85,0:03:23.32,Default,,0,0,0,,Tiup untuk mendinginkannya, dan jangan terburu-buru.
Dialogue: 0,0:03:32.33,0:03:33.90,Default,,0,0,0,,Apa yang menarik darimu?
Dialog: 0,0:03:34.37,0:03:36.47,Default,,0,0,0,,Manual Taktik Dinasti Ming.
Dialog: 0,0:03:36.67,0:03:37.94,Default,,0,0,0,,Manual taktik?
Dialogue: 0,0:03:38.77,0:03:39.84,Default,,0,0,0,,Taktik militer?
Dialog: 0,0:03:41.01,0:03:42.48,Default,,0,0,0,,Apakah kamu berencana memulai perang?
Dialog: 0,0:03:42.84,0:03:44.84,Default,,0,0,0,,Jika saya ingin memperkuat kekuatan,
Dialog: 0,0:03:44.84,0:03:46.85,Default,,0,0,0,,Saya memerlukan dukungan tentara.
Dialog: 0,0:03:48.55,0:03:50.72,Default,,0,0,0,,Aku masih bermimpi buruk tentang
Dialogue: 0,0:03:51.45,0:03:53.09,Default,,0,0,0,,bagaimana kamu akan mati tanpa mencapai apa pun?
Dialog: 0,0:03:53.45,0:03:54.69,Default,,0,0,0,,Kasus per kasus.
Dialogue: 0,0:04:00.69,0:04:04.93,Default,,0,0,0,,Jika ini terjadi,\Nit bukan karena kamu bodoh.
Dialog: 0,0:04:05.13,0:04:07.17,Default,,0,0,0,,Ini awalnya dimaksudkan.
Dialogue: 0,0:04:07.53,0:04:11.17,Default,,0,0,0,,Kamu hanya kurang beruntung.
Dialog: 0,0:04:11.17,0:04:12.34,Default,,0,0,0,,Itu bukan salahmu.
Dialogue: 0,0:04:12.97,0:04:14.41,Default,,0,0,0,,Mungkin kamu benar.
Dialogue: 0,0:04:15.28,0:04:18.88,Default,,0,0,0,,Jadi berhentilah menyiksa dirimu seperti itu.
Dialog: 0,0:04:19.38,0:04:20.81,Default,,0,0,0,,Kamu tetap tidak bisa
Dialog: 0,0:04:22.18,0:04:23.38,Default,,0,0,0,,mengganggu takdir.
Dialogue: 0,0:04:28.42,0:04:30.02,Default,,0,0,0,,Terkadang aku terbangun dari mimpi buruk,
Dialog: 0,0:04:30.66,0:04:33.16,Default,,0,0,0,,dan pikiran aneh muncul di benak.
Dialog: 0,0:04:35.00,0:04:36.56,Default,,0,0,0,,Bahwa mimpi ini nyata,
Dialog: 0,0:04:37.63,0:04:39.17,Default,,0,0,0,,dan kita hidup di masa lalu.
Dialog: 0,0:04:46.44,0:04:49.88,Default,,0,0,0,,Seolah-olah semua ini adalah penglihatanku
Dialog: 0,0:04:50.61,0:04:52.01,Default,,0,0,0,,tepat sebelum kematian.
Dialog: 0,0:04:55.82,0:04:57.45,Default,,0,0,0,,Dan pada saat ini
Dialog: 0,0:05:00.29,0:05:03.96,Default,,0,0,0,,Saya mempunyai kesempatan untuk melakukan sesuatu, untuk memperbaiki segalanya.
Dialog: 0,0:05:08.43,0:05:10.10,Default,,0,0,0,,Sangat mungkin sekarang
Dialog: 0,0:05:12.43,0:05:15.64,Default,,0,0,0,,Aku melakukan segalanya untuk melawan takdir.
Dialogue: 0,0:05:24.74,0:05:29.42,Default,,0,0,0,,Demi pria ini, yang takdirnya kalah,\NI ingin mengorbankan segalanya.
Dialog: 0,0:05:35.96,0:05:38.76,Default,,0,0,0,,All-in
Dialog: 0,0:05:44.76,0:05:47.17,Default,,0,0,0,,Kamu pasti akan mengalahkan mereka semua.
Dialog: 0,0:05:48.87,0:05:50.70,Default,,0,0,0,,Saya selalu berada di pihak pemenang.
Dialog: 0,0:05:50.70,0:05:53.74,Default,,0,0,0,,Dan selagi aku ada,\Nkemenangan ada di tanganmu.
Dialogue: 0,0:05:56.21,0:05:59.55,Default,,0,0,0,,Sikapmu sangat membesarkan hati.
Dialog: 0,0:06:01.08,0:06:03.12,Default,,0,0,0,,Saya punya senjata rahasia.
Dialog: 0,0:06:04.32,0:06:05.59,Default,,0,0,0,,Saya tahu masa depan.
Dialog: 0,0:06:07.05,0:06:08.66,Default,,0,0,0,,Ingat?
Dialog: 0,0:06:08.66,0:06:10.29,Default,,0,0,0,,Seperti yang Anda katakan,\Nbahwa saya adalah pria dari masa depan yang jauh?
Dialogue: 0,0:06:10.29,0:06:12.86,Default,,0,0,0,,Tentu saja saya ingat.\NIsulit untuk dilupakan.
Dialog: 0,0:06:13.16,0:06:14.79,Default,,0,0,0,,Bagaimana jika ini benar,
Dialog: 0,0:06:15.60,0:06:18.10,Default,,0,0,0,,dan saya akan berbagi pengetahuan saya dengan Anda?
Dialogue: 0,0:06:19.13,0:06:21.37,Default,,0,0,0,,Menurutmu aku akan percaya ini?
Dialog: 0,0:06:22.67,0:06:23.84,Default,,0,0,0,,Dalam hal ini,
Dialog: 0,0:06:25.00,0:06:28.71,Default,,0,0,0,,anggap aku bermimpi.\NA mimpi kenabian yang berguna.
Dialog: 0,0:06:31.01,0:06:32.08,Default,,0,0,0,,Omong kosong.
Dialog: 0,0:06:35.25,0:06:40.45,Default,,0,0,0,,Karena ini hanya mimpi,\NI tidak akan mempercayai ceritamu,
Dialog: 0,0:06:40.82,0:06:42.49,Default,,0,0,0,,tapi saya akan mendengarkan dengan senang hati.
Dialogue: 0,0:06:43.39,0:06:45.23,Default,,0,0,0,,Seperti apa Joseon 200 tahun kemudian?
Dialog: 0,0:06:46.39,0:06:47.39,Default,,0,0,0,,Baiklah.
Dialog: 0,0:06:50.30,0:06:52.63,Default,,0,0,0,,Ini hanya cerita yang aku buat,
Dialog: 0,0:06:54.07,0:06:56.24,Default,,0,0,0,,tapi kami tidak lagi menyebut negara kami Joseon.
Dialog: 0,0:06:57.37,0:06:59.94,Default,,0,0,0,,Republik Korea.\NInilah yang ditunggu Joseon.
Dialog: 0,0:07:01.84,0:07:02.94,Default,,0,0,0,,Republik Korea?
Dialog: 0,0:07:02.94,0:07:05.88,Default,,0,0,0,,Di negeri ini, rakyat sendiri yang memilih\Nsiapa yang akan memerintah.
Dialog: 0,0:07:06.15,0:07:07.55,Default,,0,0,0,,Omong kosong.
Dialogue: 0,0:07:08.11,0:07:11.89,Default,,0,0,0,,Beri tahu aku sesuatu yang lebih bisa dipercaya agar aku percaya.
Dialogue: 0,0:07:12.22,0:07:13.75,Default,,0,0,0,,Jika kamu tidak percaya padaku sekarang,\Nkita punya masalah.
Dialogue: 0,0:07:13.75,0:07:15.69,Default,,0,0,0,,Ini hanya penemuanku.
Dialog: 0,0:07:16.72,0:07:20.03,Default,,0,0,0,,200 tahun kemudian tidak ada bangsawan dan rakyat jelata.
Dialog: 0,0:07:21.36,0:07:23.30,Default,,0,0,0,,Orang tidak lagi dibagi ke dalam kelas?
Dialog: 0,0:07:24.33,0:07:26.63,Default,,0,0,0,,Yah, orang-orang datang dengan sesuatu yang baru.
Dialogue: 0,0:07:26.97,0:07:28.43,Default,,0,0,0,,Apakah kamu kantong uang atau bukan.
Dialogue: 0,0:07:29.74,0:07:32.41,Default,,0,0,0,,Status seseorang ditentukan oleh tasnya?
Dialog: 0,0:07:33.47,0:07:36.34,Default,,0,0,0,,Dan apa, semua orang memilih penggaris menggunakan tas?
Dialogue: 0,0:07:36.68,0:07:38.78,Default,,0,0,0,,Ini disebut voting.
Dialog: 0,0:07:38.78,0:07:40.65,Default,,0,0,0,,Saat kamu berumur 18 tahun,
Dialog: 0,0:07:40.65,0:07:44.12,Default,,0,0,0,,Anda dapat memilih penggaris.
Dialog: 0,0:07:44.85,0:07:47.12,Default,,0,0,0,,-Pilih penggaris?\N-Ya.
Dialogue: 0,0:07:47.12,0:07:48.59,Default,,0,0,0,,Kenapa tepatnya jam 18?
Dialogue: 0,0:07:53.73,0:07:57.63,Default,,0,0,0,,Beginilah hari ratu berlalu.
Dialog: 0,0:08:01.03,0:08:02.37,Default,,0,0,0,,Kamu hebat.
Dialog: 0,0:08:06.97,0:08:10.68,Default,,0,0,0,,Sekarang perhatikan setiap tindakannya.
Dialog: 0,0:08:22.86,0:08:24.12,Default,,0,0,0,,Benin,
Dialog: 0,0:08:24.99,0:08:27.69,Default,,0,0,0,,Anda sekarang\Menteri Perang termuda
Dialog: 0,0:08:28.23,0:08:30.10,Default,,0,0,0,,dan menjadi lebih menarik.
Dialogue: 0,0:08:30.50,0:08:31.80,Default,,0,0,0,,Benarkah begitu?
Dialog: 0,0:08:32.10,0:08:34.17,Default,,0,0,0,,-Tentu saja tidak.\N-Aku mengetahuinya.
Dialog: 0,0:08:36.10,0:08:37.44,Default,,0,0,0,,Selamat!
Dialogue: 0,0:08:46.01,0:08:47.51,Default,,0,0,0,,Omong-omong, Benin,
Dialog: 0,0:08:47.95,0:08:50.48,Default,,0,0,0,,tidak ada sama sekali untuk keluarga kita
Dialog: 0,0:08:50.68,0:08:52.85,Default,,0,0,0,,tidak bisa akur dengan raja?
Dialog: 0,0:08:54.25,0:08:55.96,Default,,0,0,0,,Dia sangat penting bagi ratu
Dialog: 0,0:08:57.12,0:08:59.06,Default,,0,0,0,,dan dia tidak terlihat seperti orang jahat.
Dialog: 0,0:08:59.06,0:09:01.59,Default,,0,0,0,,Semua simpatinya pada ratu adalah bohong.
Dialog: 0,0:09:03.96,0:09:07.03,Default,,0,0,0,,Demi keuntungannya sendiri\Ndia akan selalu mempertaruhkan nyawanya.
Dialog: 0,0:09:08.00,0:09:09.80,Default,,0,0,0,,Saya tidak akan mengatakan itu.
Dialog: 0,0:09:09.80,0:09:11.64,Default,,0,0,0,,Ini adalah hal yang paling menjengkelkan tentang dia.
Dialog: 0,0:09:12.74,0:09:15.41,Default,,0,0,0,,Bersembunyi di balik topeng dan wanita.
Dialog: 0,0:09:16.31,0:09:19.15,Default,,0,0,0,,Berperilaku bermuka dua\Ndan menipu semua orang di sekitar.
Dialog: 0,0:09:20.35,0:09:22.48,Default,,0,0,0,,Sang Ratu juga menyerah pada pesonanya,
Dialog: 0,0:09:22.48,0:09:24.95,Default,,0,0,0,,dan sekarang demi raja\NI aku siap menyerahkan keluargaku.
Dialog: 0,0:09:26.15,0:09:28.45,Default,,0,0,0,,Namun, raja hanya menggunakan dia.
Dialog: 0,0:09:29.46,0:09:32.03,Default,,0,0,0,,Tapi kudengar itu ratu
Dialog: 0,0:09:32.03,0:09:33.73,Default,,0,0,0,,memutar raja sesuai keinginannya.
Dialog: 0,0:09:34.26,0:09:36.53,Default,,0,0,0,,Dan siapa,
Dialog: 0,0:09:36.53,0:09:39.60,Default,,0,0,0,,jadi para pelayan lebih tahu dari siapa pun tentang kehidupan pribadi raja.
Dialog: 0,0:09:40.43,0:09:44.77,Default,,0,0,0,,Mereka bilang mereka di sana sampai subuh tadi malam
Dialog: 0,0:09:45.10,0:09:49.11,Default,,0,0,0,,mereka mengobrol di kamar raja.
Dialogue: 0,0:10:15.23,0:10:17.20,Default,,0,0,0,,Jika Cheoljong gagal,
Dialogue: 0,0:10:17.20,0:10:19.14,Default,,0,0,0,,akankah dunia berubah setelah 200 tahun juga?
Dialog: 0,0:10:19.51,0:10:22.28,Default,,0,0,0,,Dan kemudian tidak akan ada aneksasi Jepang,
Dialog: 0,0:10:22.58,0:10:24.81,Default,,0,0,0,,dan Direktur Khan bajingan itu tidak akan dilahirkan.
Dialog: 0,0:10:28.18,0:10:29.95,Default,,0,0,0,,Semua ini bukan untuk Cheoljong.
Dialogue: 0,0:10:30.28,0:10:32.99,Default,,0,0,0,,Aku melakukan ini untuk diriku sendiri.
Dialog: 0,0:10:34.65,0:10:36.36,Default,,0,0,0,,Membantu Anda,
Dialogue: 0,0:10:38.59,0:10:40.29,Default,,0,0,0,,Saya sedang menyelamatkan diri.
Dialog: 0,0:10:51.70,0:10:52.81,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:10:54.47,0:10:58.01,Default,,0,0,0,,Yang Mulia!\NAyahmu jatuh pingsan!
Dialogue: 0,0:11:03.25,0:11:04.85,Default,,0,0,0,,Sungguh mimpi buruk.
Dialog: 0,0:11:05.02,0:11:06.79,Default,,0,0,0,,Jangan bangun!
Dialog: 0,0:11:13.09,0:11:15.23,Default,,0,0,0,,-Apa yang terjadi?\N-Berbahaya di sini.
Dialog: 0,0:11:15.23,0:11:17.33,Default,,0,0,0,,Kenapa kamu datang?
Dialog: 0,0:11:18.87,0:11:21.70,Default,,0,0,0,,Tidak! Jauh lebih berbahaya di istana.
Dialogue: 0,0:11:23.60,0:11:26.34,Default,,0,0,0,,Ratu, diamlah di rumah.
Dialog: 0,0:11:26.51,0:11:28.94,Default,,0,0,0,,Aku akan melakukan segalanya untuk melindungimu.
Dialogue: 0,0:11:30.91,0:11:33.25,Default,,0,0,0,,Kamu pasti pingsan\Nkarena mengkhawatirkanku.
Dialogue: 0,0:11:34.28,0:11:36.88,Default,,0,0,0,,Ini salahku.
Dialogue: 0,0:11:37.42,0:11:41.09,Default,,0,0,0,,Seolah-olah aku sendiri yang memberimu racun ini.
Dialogue: 0,0:11:42.32,0:11:45.19,Default,,0,0,0,,Saya menulis buku bodoh itu\Ndan tidak mengikutinya.
Dialog: 0,0:11:45.63,0:11:47.56,Default,,0,0,0,,Mereka melakukan hal yang salah.
Dialog: 0,0:11:48.39,0:11:52.03,Default,,0,0,0,,Ini bukan salahmu, jadi berhentilah.
Dialogue: 0,0:11:52.13,0:11:54.37,Default,,0,0,0,,Lebih baik jaga kesehatanmu.
Dialogue: 0,0:11:54.37,0:11:55.90,Default,,0,0,0,,Aku sehat seperti lembu.
Dialogue: 0,0:11:57.20,0:12:00.74,Default,,0,0,0,,Selama kamu bahagia, aku juga.
Dialog: 0,0:12:02.34,0:12:03.51,Default,,0,0,0,,Oleh karena itu, sayang,
Dialog: 0,0:12:05.45,0:12:07.35,Default,,0,0,0,,lepaskan gelar ratu.
Dialog: 0,0:12:09.18,0:12:10.92,Default,,0,0,0,,-Ayah.\N-Soyeon.
Dialog: 0,0:12:12.72,0:12:14.49,Default,,0,0,0,,Saat ibumu hamil,
Dialog: 0,0:12:14.82,0:12:17.06,Default,,0,0,0,,dia selalu mengulangi sesuatu.
Dialogue: 0,0:12:17.96,0:12:20.73,Default,,0,0,0,,Dia ingin anaknya jauh lebih bahagia darinya.
Dialogue: 0,0:12:21.69,0:12:24.46,Default,,0,0,0,,Supaya kamu menjalani hidupmu dengan cara yang dia tidak bisa lakukan.
Dialogue: 0,0:12:24.93,0:12:27.30,Default,,0,0,0,,Agar hidupmu lebih baik\Ndaripada ibumu.
Dialog: 0,0:12:28.67,0:12:30.84,Default,,0,0,0,,Ini adalah permintaan terakhirnya.
Dialog: 0,0:12:31.87,0:12:33.07,Default,,0,0,0,,Sejak setelah kematian
Dialogue: 0,0:12:33.34,0:12:36.11,Default,,0,0,0,,bolehkah aku menatap mata ibumu?
Dialog: 0,0:12:38.71,0:12:39.85,Default,,0,0,0,,Ayah.
Dialog: 0,0:12:40.88,0:12:44.58,Default,,0,0,0,,Aku pasti akan memenuhi keinginan ibuku.
Dialog: 0,0:12:44.92,0:12:48.86,Default,,0,0,0,,Aku akan membalas dendam pada mereka atas semua yang mereka lakukan padaku.
Dialog: 0,0:12:50.06,0:12:51.09,Default,,0,0,0,,Ratu!
Dialog: 0,0:12:51.09,0:12:53.46,Default,,0,0,0,,Jadi Anda tidak dapat melakukan root untuk apa pun.
Dialog: 0,0:12:57.33,0:12:59.37,Default,,0,0,0,,Saya punya permintaan untuk Anda.
Dialog: 0,0:13:00.33,0:13:04.14,Default,,0,0,0,,Dengarkan. Anda bisa meminta apa saja.
Dialog: 0,0:13:04.30,0:13:06.87,Default,,0,0,0,,Saya akan melakukan segalanya.
Dialogue: 0,0:13:08.37,0:13:10.11,Default,,0,0,0,,Dijual dari stok
Dialog: 0,0:13:11.14,0:13:13.95,Default,,0,0,0,,Pemiliknya sudah gila!
Dialog: 0,0:13:16.38,0:13:17.98,Default,,0,0,0,,Dalam hidupku, aku tidak akan pernah menyangka dia seperti ini!
Dialogue: 0,0:13:18.22,0:13:21.22,Default,,0,0,0,,Bagaimana jika mereka kemudian memaksamu membayar dua kali lipat?
Dialog: 0,0:13:21.22,0:13:22.26,Default,,0,0,0,,Apa?
Dialog: 0,0:13:23.02,0:13:24.49,Default,,0,0,0,,Terima kasih!
Dialog: 0,0:13:24.52,0:13:27.13,Default,,0,0,0,,Tn. Kim! Yang Mulia!
Dialogue: 0,0:13:27.13,0:13:29.70,Default,,0,0,0,,Panjang umur!
Dialog: 0,0:13:30.70,0:13:32.30,Default,,0,0,0,,Menjualnya sekantong beras?
Dialog: 0,0:13:32.30,0:13:33.77,Default,,0,0,0,,Itu terbang seperti burung kukuk!
Dialog: 0,0:13:35.30,0:13:38.37,Default,,0,0,0,,Pria itu kehilangan akal sehatnya!
Dialog: 0,0:13:42.68,0:13:44.64,Default,,0,0,0,,Saya punya permintaan untuk Anda.
Dialog: 0,0:13:44.78,0:13:46.51,Default,,0,0,0,,Lupakan korupsi,
Dialog: 0,0:13:46.95,0:13:48.98,Default,,0,0,0,, jaga reputasimu.
Dialog: 0,0:13:51.85,0:13:55.19,Default,,0,0,0,,Apakah kamu yakin ingin menjual semua ini kepada orang-orang?
Dialog: 0,0:13:55.19,0:13:56.19,Default,,0,0,0,,Tepat!
Dialogue: 0,0:13:56.66,0:13:59.99,Default,,0,0,0,,Aku tidak bisa menyeret semua ini ke kubur.
Dialog: 0,0:14:07.73,0:14:11.34,Default,,0,0,0,,Maaf, maukah kamu melepaskanku?
Dialog: 0,0:14:14.01,0:14:16.74,Default,,0,0,0,,Keserakahan adalah kebiasaan buruk.
Dialog: 0,0:14:28.29,0:14:30.72,Default,,0,0,0,,Ayahmu membuat keputusan penting.
Dialog: 0,0:14:30.79,0:14:31.82,Default,,0,0,0,,Dan bukan itu saja.
Dialogue: 0,0:14:35.33,0:14:37.16,Default,,0,0,0,,Anda sedang mencari buku akuntansi.
Dialog: 0,0:14:37.16,0:14:39.50,Default,,0,0,0,,Papa mengingat semua yang tertulis di dalamnya.
Dialogue: 0,0:14:43.67,0:14:45.74,Default,,0,0,0,,Bukan menteri, tapi tikus sampah.
Dialog: 0,0:14:45.74,0:14:48.81,Default,Spikyulka2,0,0,0,,Penasihat kiri melakukan penipuan dengan gandum.
Dialog: 0,0:14:48.98,0:14:51.01,Default,Spikyulka2,0,0,0,,Dalam berbagai cara dia mengambil alih
Dialog: 0,0:14:51.14,0:14:52.81,Default,Spilyk2,0,0,0,,jumlahnya sangat besar.
Dialogue: 0,0:14:55.58,0:14:58.08,Default,Spilyk2,0,0,0,,Kepala penasihat menghangatkan tangannya di daratan.
Dialog: 0,0:14:58.08,0:15:01.25,Default,Spikyulka2,0,0,0,,Misalnya, dia akan menyelipkan tambang kepada seseorang dan memaksa mereka mengerjakannya,
Dialog: 0,0:15:01.25,0:15:02.76,Default,Spikyulka2,0,0,0,,lalu menindasmu dengan pajak selangit.
Dialog: 0,0:15:05.22,0:15:06.39,Default,Spikyulka2,0,0,0,,Tidak ada orang yang tidak mencuri,
Dialog: 0,0:15:06.39,0:15:07.56,Default,Spikyulka2,0,0,0,,dan tidak ada yang tidak dicuri.
Dialog: 0,0:15:07.96,0:15:10.03,Default,Spikyulka2,0,0,0,,Dan juga korupsi militer dan pembelian posisi.
Dialog: 0,0:15:10.70,0:15:12.10,Default,Spilyk2,0,0,0,,Daripada mengirim perahu dengan garam,
Dialog: 0,0:15:12.10,0:15:13.50,Default,Spikyulka2,0,0,0,,mereka mengisinya dengan batu dan menenggelamkannya,
Dialogue: 0,0:15:13.50,0:15:15.03,Default,Spilyk2,0,0,0,,dan mereka mengambil garamnya sendiri.
Dialog: 0,0:15:15.20,0:15:17.87,Default,Spikyulka2,0,0,0,,Trik serupa dilakukan dengan hadiah untuk raja.
Dialog: 0,0:15:18.30,0:15:20.24,Default,Spikyulka2,0,0,0,,Dan di antara semua ini,\N siapa yang paling membuatku kesal,
Dialog: 0,0:15:20.74,0:15:22.14,Default,Spikyulka2,0,0,0,,jadi ini rentenir.
Dialog: 0,0:15:22.14,0:15:24.08,Default,Spikyulka2,0,0,0,,Mereka menaikkan pajak pada para petani,
Dialog: 0,0:15:24.08,0:15:25.81,Default,Spikyulka2,0,0,0,,dan kemudian meminjamkan mereka uang sebesar 5%.
Dialog: 0,0:15:25.98,0:15:28.18,Default,Spikyulka2,0,0,0,,Jadi hutang akan bertambah setiap tarikan napas.
Dialog: 0,0:15:28.98,0:15:31.82,Default,Spilyk2,0,0,0,,Perilaku seperti gangster.
Dialog: 0,0:15:31.82,0:15:34.59,Default,Spikyulka2,0,0,0,,Kenangan ayahmu tentang keuntungan
Dialog: 0,0:15:35.52,0:15:37.09,Default,Spillik2,0,0,0,,sangat mengesankan.
Dialogue: 0,0:15:37.66,0:15:40.79,Default,Spikyulka2,0,0,0,,Ngomong-ngomong, beritahu aku,
Dialog: 0,0:15:40.83,0:15:44.10,Default,Spikyulka2,0,0,0,,apa yang akan kamu lakukan dengan informan?
Dialog: 0,0:15:45.53,0:15:48.93,Default,Spikyulka2,0,0,0,,Ayahmu adalah tokoh kunci dalam semua intrik ini.
Dialog: 0,0:15:49.74,0:15:51.90,Default,Spillik2,0,0,0,,Kejahatannya tidak akan hilang begitu saja.
Dialog: 0,0:15:53.41,0:15:55.51,Default,Spikyulka2,0,0,0,,-Namun...\N-Apa itu "namun"?
Dialog: 0,0:15:55.51,0:15:58.44,Default,Spikyulka2,0,0,0,,Bagiku, ayahmu adalah penjahat korup lainnya.
Dialog: 0,0:16:01.61,0:16:02.68,Default,Spilyk2,0,0,0,,Namun
Dialog: 0,0:16:04.08,0:16:06.25,Default,Spikyulka2,0,0,0,,dia satu-satunya saudara sedarahmu.
Dialog: 0,0:16:10.29,0:16:11.86,Default,Spillik2,0,0,0,,Bagaimana jika demikian?
Dialogue: 0,0:16:13.93,0:16:15.06,Default,Spikyulka2,0,0,0,,Mereka bilang
Dialog: 0,0:16:15.06,0:16:16.20,Default,Spikyulka2,0,0,0,,yang banyak manfaatnya
Dialog: 0,0:16:16.20,0:16:17.73,Default,Spikyulka2,0,0,0,,bisa membenarkan kekurangannya.
Dialog: 0,0:16:19.53,0:16:20.67,Default,Spillik2,0,0,0,,Apakah dia membutuhkan lebih banyak pahala?
Dialog: 0,0:16:21.00,0:16:22.07,Default,Spillik2,0,0,0,,Misalnya?
Dialog: 0,0:16:22.10,0:16:23.47,Default,Spilyk2,0,0,0,,Misalnya,
Dialog: 0,0:16:23.90,0:16:26.51,Default,Spikyulka2,0,0,0,,dia bisa membantu mendapatkan bukti.
Dialogue: 0,0:16:28.07,0:16:31.14,Default,Spikyulka2,0,0,0,,Sulit menghukum mereka hanya dengan buku besar.
Dialog: 0,0:16:33.21,0:16:35.15,Default,Spikyulka2,0,0,0,,Sebagai imbalannya Anda menjamin perlindungan
Dialog: 0,0:16:35.61,0:16:37.12,Default,Spilyk2,0,0,0,,informan.
Dialog: 0,0:16:37.58,0:16:38.65,Default,Spillik2,0,0,0,,Tentu saja.
Dialog: 0,0:16:44.99,0:16:48.09,Default,Spikyulka2,0,0,0,,Yang Mulia, ini waktunya dewan kerajaan.
Dialog: 0,0:16:48.43,0:16:49.60,Default,Spillik2,0,0,0,,Oke.
Dialog: 0,0:16:56.27,0:16:57.54,Default,Spillik2,0,0,0,,Dewan Kerajaan?
Dialog: 0,0:16:59.57,0:17:02.98,Default,Spikyulka2,0,0,0,,Jika ingin membakar sampah, pergilah ke TPA.
Dialog: 0,0:17:03.91,0:17:05.88,Default,Spillik2,0,0,0,,Hanya saja, kecuali bupati - ratu janda,
Dialog: 0,0:17:06.25,0:17:08.45,Default,Spikyulka2,0,0,0,,wanita tidak diperbolehkan berada di sana.
Dialogue: 0,0:17:09.15,0:17:11.45,Default,Spikyulka2,0,0,0,,Aku menunjuk adikku, Pangeran Yeonpyeong,
Dialog: 0,0:17:11.45,0:17:14.09,Default,Spilyk2,0,0,0,,oleh kepala Ijeongcheon.
Dialog: 0,0:17:14.25,0:17:16.22,Default,Spikyulka2,0,0,0,,-Kamu tidak boleh melakukan itu.\N-Kamu tidak boleh melakukan itu.
Dialogue: 0,0:17:18.06,0:17:19.26,Default,Spillik2,0,0,0,,Kenapa begini?
Dialog: 0,0:17:19.26,0:17:22.19,Default,Spikyulka2,0,0,0,,Pekerjaan dan tanggung jawab seperti itu terlalu besar
Dialog: 0,0:17:22.19,0:17:25.43,Default,Spikyulka2,0,0,0,,untuk pemuda yang tidak berpengalaman seperti Pangeran Yeonpyeong, dia tidak akan mampu mengatasinya.
Dialog: 0,0:17:27.27,0:17:29.44,Default,Spikyulka2,0,0,0,,Sebaliknya, dia tidak dikaitkan dengan siapa pun yang berkuasa.
Dialog: 0,0:17:30.60,0:17:34.27,Default,Spillie2,0,0,0,,Ini adalah kebajikan tertinggi dalam mengelola Ijeongcheon.
Dialog: 0,0:17:35.27,0:17:36.48,Default,Spilyk2,0,0,0,,Selain itu,
Dialogue: 0,0:17:38.21,0:17:41.85,Default,Spikyulka2,0,0,0,,apakah sepertinya aku bertanya padamu sekarang?
Dialog: 0,0:17:47.52,0:17:49.89,Default,Spillik2,0,0,0,,Bakar, Cheoljong.
Dialog: 0,0:17:51.46,0:17:55.49,Default,Spikyulka2,0,0,0,,Saya mengirim inspektur rahasia ke Yeungnam.
Dialog: 0,0:17:56.46,0:17:58.06,Default,Spikyulka2,0,0,0,,Pelaku penyalahgunaan kekuasaan
Dialog: 0,0:17:58.06,0:17:59.70,Default,Spikyulka2,0,0,0,,akan dihukum sesuai dengan hukum.
Dialog: 0,0:17:59.70,0:18:01.60,Default,Spikyulka2,0,0,0,,Semua yang mereka salah gunakan,
Dialog: 0,0:18:02.37,0:18:04.40,Default,Spikyulka2,0,0,0,,akan digunakan untuk membantu rakyat.
Dialog: 0,0:18:05.17,0:18:08.81,Default,Spikyulka2,0,0,0,,Ini akan menjadi contoh bagi delapan gubernur kita
Dialog: 0,0:18:09.81,0:18:11.31,Default,Spikyulka2,0,0,0,,dan akan memaksa mereka untuk mengaku.
Dialog: 0,0:18:12.21,0:18:14.31,Default,Silk2,0,0,0,,-Kami keberatan, Yang Mulia.\N-Kami keberatan, Yang Mulia.
Dialog: 0,0:18:14.55,0:18:19.12,Default,Spikyulka2,0,0,0,,Menteri Perang sudah mengirimkan pemimpin militer ke sana.
Dialog: 0,0:18:20.59,0:18:22.82,Default,Spikyulka2,0,0,0,,Mereka dikirim tanpa izin saya?
Dialog: 0,0:18:23.12,0:18:24.62,Default,Spikyulka2,0,0,0,,Baru-baru ini
Dialog: 0,0:18:24.62,0:18:26.93,Default,Spillik2,0,0,0,,insiden mengerikan yang disebabkan oleh pengikut Tonhak,
Dialog: 0,0:18:26.93,0:18:28.79,Default,Biryulka2,0,0,0,,mengingatkan pada pemberontakan yang dulu terjadi
Dialog: 0,0:18:28.79,0:18:31.16,Default,Spikyulka2,0,0,0,,mengancam kedaulatan Joseon.
Dialog: 0,0:18:31.53,0:18:34.87,Default,Spikyulka2,0,0,0,,Ada krisis, dan memerlukan solusi cepat.
Dialog: 0,0:18:34.87,0:18:36.94,Default,Spikyulka2,0,0,0,,Saya yakin departemen perbatasan melakukan apa yang diinginkannya.
Dialogue: 0,0:18:42.51,0:18:44.58,Default,Spikyulka2,0,0,0,,Pengikut Tonghak membuat kerusuhan
Dialog: 0,0:18:44.58,0:18:46.41,Default,Spikyulka2,0,0,0,,dan mengancam pegawai negeri.
Dialog: 0,0:18:46.41,0:18:48.78,Default,Spikyulka2,0,0,0,,Pada akhirnya merugikan pejabat.
Dialog: 0,0:18:50.52,0:18:53.65,Default,Spikyulka2,0,0,0,,Kami harus segera menangkap dan menghukum pemimpin geng.
Dialog: 0,0:18:54.19,0:18:56.42,Default,Spikyulka2,0,0,0,,Untuk menghindari pengulangan,
Dialogue: 0,0:18:56.96,0:18:58.62,Default,Spikyulka2,0,0,0,,perlu untuk membasmi sumber kejahatan.
Dialog: 0,0:18:59.69,0:19:01.13,Default,Spillik2,0,0,0,,Membasmi sumber kejahatan?
Dialog: 0,0:19:01.36,0:19:03.00,Default,Spikyulka2,0,0,0,,Kami menangkap, memenjarakan, dan menghukum
Dialog: 0,0:19:03.00,0:19:06.97,Default,Spilyk2,0,0,0,,pengikut dan penyebar ajaran Tonhak.
Dialog: 0,0:19:07.97,0:19:10.20,Default,Spikyulka2,0,0,0,,Mereka menyalahkan semua masalah Joseon
Dialog: 0,0:19:10.20,0:19:12.00,Default,Spillik2,0,0,0,,pada sekelompok bandit!
Dialog: 0,0:19:12.51,0:19:14.01,Default,Spikyulka2,0,0,0,,Untuk membasmi sumber kejahatan yang sebenarnya,
Dialog: 0,0:19:14.01,0:19:16.84,Default,Spikyulka2,0,0,0,,Saya akan mengizinkan Ijeongcheon melakukan penyelidikan demi kepentingan rakyat!
Dialog: 0,0:19:18.21,0:19:20.38,Default,Spillik2,0,0,0,,Duduk di singgasana
Dialog: 0,0:19:20.38,0:19:22.11,Default,Spikyulka2,0,0,0,,esensi masyarakat tidak dapat dipahami.
Dialogue: 0,0:19:22.85,0:19:25.75,Default,Spikyulka2,0,0,0,,Setelah kamu mulai memenuhi permintaan mereka, itu tidak akan ada habisnya.
Dialog: 0,0:19:26.42,0:19:28.45,Default,Spilyk2,0,0,0,,Kita harus menekan mereka dengan paksa,
Dialog: 0,0:19:29.56,0:19:32.22,Default,Spikyulka2,0,0,0,,untuk memastikan pemberontakan tidak terjadi lagi.
Dialog: 0,0:19:32.42,0:19:35.06,Default,Spikyulka2,0,0,0,,-Kami setuju, Yang Mulia.\N-Kami setuju, Yang Mulia.
Dialog: 0,0:19:44.54,0:19:46.34,Default,Spilyk2,0,0,0,,Saya akan memeriksa semua tahanan untuk memastikan
Dialog: 0,0:19:47.01,0:19:49.14,Default,Spikyulka2,0,0,0,,bahwa di antara mereka tidak ada korban pelanggaran hukum yang tidak bersalah.
Dialogue: 0,0:19:49.91,0:19:52.61,Default,Spikyulka2,0,0,0,,Selain itu, aku akan menghukum berat para bandit,
Dialog: 0,0:19:52.61,0:19:54.71,Default,Spilyk2,0,0,0,,agar ada contoh bagi semua orang.
Dialog: 0,0:19:55.41,0:19:57.78,Default,Spikyulka2,0,0,0,,Dan saya akan memerintahkan para gubernur dan pemimpin militer untuk dihukum,
Dialog: 0,0:19:58.58,0:20:00.05,Default,Spilyk2,0,0,0,,mereka yang bertanggung jawab atas masalah kita.
Dialog: 0,0:20:15.37,0:20:18.60,Default,Spikyulka2,0,0,0,,Ingin menekan pemberontakan hanya dengan bantuan hukum.
Dialog: 0,0:20:20.27,0:20:22.37,Default,Spillik2,0,0,0,,Naif sekali.
Dialog: 0,0:20:23.84,0:20:25.81,Default,Silk2,0,0,0,,Sebelum pemberontakan menjadi tidak terkendali,
Dialog: 0,0:20:26.08,0:20:29.01,Default,Spikyulka2,0,0,0,,Saya akan mengirim pasukan dan menundukkan pengikut Tonhak.
Dialog: 0,0:20:31.25,0:20:32.55,Default,Spillik2,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:20:32.72,0:20:35.45,Default,Spillik2,0,0,0,,Oleskan obat mujarab sebelum wajahku menjadi kering.
Dialog: 0,0:20:35.79,0:20:39.53,Default,Spikyulka2,0,0,0,,Yang Mulia, sudah berakhir.
Dialog: 0,0:20:43.60,0:20:48.23,Default,Spikyulka2,0,0,0,,Haruskah aku meminta ratu berbuat lebih banyak?
Dialog: 0,0:20:48.50,0:20:49.77,Default,Spillik2,0,0,0,,Tidak layak.
Dialog: 0,0:20:49.77,0:20:51.57,Default,Spikyulka2,0,0,0,,Tentu saja tidak. Lupakan apa yang saya katakan.
Dialog: 0,0:20:51.57,0:20:53.44,Default,Spilyk2,0,0,0,,-Anda boleh pergi.\N-Ya.
Dialog: 0,0:21:05.05,0:21:08.29,Default,Silk2,0,0,0,,Masih tidak bisa memaafkan ratu?
Dialog: 0,0:21:08.49,0:21:10.42,Default,Spilyk2,0,0,0,,Saya akan membaca korespondensinya dengan raja,
Dialog: 0,0:21:10.42,0:21:12.36,Default,Spilyk2,0,0,0,,tidak akan bertanya.
Dialog: 0,0:21:12.52,0:21:14.73,Default,Spillik2,0,0,0,,Pengampunan tidak akan menyelesaikan masalah.
Dialog: 0,0:21:15.03,0:21:17.70,Default,Spillik2,0,0,0,,Tidak ada yang lain selain omong kosong dalam surat cinta mereka.
Dialog: 0,0:21:18.63,0:21:20.97,Default,Spikyulka2,0,0,0,,Mereka bahkan ingin memberikan nyawa mereka untuk satu sama lain.
Dialog: 0,0:21:40.89,0:21:42.92,Default,Spikyulka2,0,0,0,,Dan ini hadiah atas pengabdianku pada keluargamu?
Dialog: 0,0:21:43.22,0:21:45.02,Default,Spikyulka2,0,0,0,,Kamu menjebak keluargaku dan kami diusir.
Dialogue: 0,0:21:45.02,0:21:46.29,Default,Spikyulka2,0,0,0,,Membuat kami menjadi pemberontak
Dialog: 0,0:21:46.29,0:21:47.53,Default,Spikyulka2,0,0,0,,dan kehilangan masa depan.
Dialogue: 0,0:21:47.53,0:21:49.80,Default,Spikyulka2,0,0,0,,Bagaimana bisa kau membiarkan kami pada takdir kami?
Dialog: 0,0:21:51.50,0:21:54.90,Default,Spikyulka2,0,0,0,,Anggaplah dirimu beruntung karena tidak dieksekusi.
Dialog: 0,0:21:56.47,0:22:00.21,Default,Spillik2,0,0,0,,Setidaknya keluargamu masih hidup.
Dialog: 0,0:22:13.15,0:22:14.95,Default,Spillik2,0,0,0,,Ayo bekerja untukku di istana.
Dialog: 0,0:22:16.49,0:22:17.99,Default,Spikyulka2,0,0,0,,Saya akan buktikan,
Dialogue: 0,0:22:18.99,0:22:20.96,Default,Spilyk2,0,0,0,,bahwa aku berbeda dengan ayahku.
Dialog: 0,0:22:31.30,0:22:32.40,Default,Spillik2,0,0,0,,Minuman keras rasanya paling enak di siang hari.
Dialog: 0,0:22:32.40,0:22:33.51,Default,Spillik2,0,0,0,,Tentu saja.
Dialog: 0,0:22:35.17,0:22:37.54,Default,Spillik2,0,0,0,,Minum di tengah hari.
Dialogue: 0,0:22:39.11,0:22:42.41,Default,Spillit2,0,0,0,,Oh, udang. Produk langka.
Dialog: 0,0:22:46.59,0:22:48.82,Default,Spilyk2,0,0,0,,-Siapa kamu?\N-Siapa kamu?
Dialogue: 0,0:22:49.22,0:22:51.19,Default,Spillik2,0,0,0,,Kamu sudah minum di sini seharian.
Dialog: 0,0:22:51.42,0:22:54.19,Default,Spilyk2,0,0,0,,Apa? Beraninya kamu berbicara seperti itu padaku?
Dialog: 0,0:22:54.66,0:22:56.53,Default,Spilyk2,0,0,0,,Siapa kamu sih?
Dialog: 0,0:22:57.66,0:22:58.80,Default,Spillik2,0,0,0,,Izinkan saya memperkenalkan diri.
Dialog: 0,0:23:01.60,0:23:02.74,Default,Spillik2,0,0,0,,Ya.
Dialog: 0,0:23:03.44,0:23:04.64,Default,Spillik2,0,0,0,,Saya seorang inspektur rahasia.
Dialog: 0,0:23:09.31,0:23:10.64,Default,Spilyk2,0,0,0,,Oh, begitulah seharusnya.
Dialogue: 0,0:23:14.11,0:23:17.52,Default,Spikyulka2,0,0,0,,Kudengar akhir-akhir ini ada inspektur rahasia palsu di sini.
Dialog: 0,0:23:17.52,0:23:19.22,Default,Spikyulka2,0,0,0,,Saya tidak percaya tipuanmu.
Dialog: 0,0:23:20.05,0:23:23.02,Default,Spillit2,0,0,0,,Token tidak lagi memiliki kekuatan yang sama seperti sebelumnya.
Dialog: 0,0:23:31.96,0:23:34.87,Default,Spikyulka2,0,0,0,,Inspektur Rahasia telah tiba.
Dialog: 0,0:23:35.50,0:23:37.47,Default,Spillik2,0,0,0,,Kasihanilah.
Dialog: 0,0:23:37.47,0:23:42.04,Default,Spikyulka2,0,0,0,,Saat ini, senjata bekerja lebih andal daripada token.
Dialog: 0,0:23:51.08,0:23:52.38,Default,Spilyk2,0,0,0,,Ini serpihannya.
Dialog: 0,0:23:52.38,0:23:54.52,Default,Spilyk2,0,0,0,,Kami laki-laki. Kami tidak menyajikan teh dengan manisan.
Dialog: 0,0:23:56.29,0:23:58.49,Default,Silk2,0,0,0,,Aku penasaran kenapa dia menelepon kita.
Dialog: 0,0:23:58.49,0:24:01.73,Default,Spillik2,0,0,0,,Raja menggunakan cambuk. Dan ratunya adalah roti jahe.
Dialog: 0,0:24:02.16,0:24:03.70,Default,Spikyulka2,0,0,0,,Mungkin ini rencana mereka.
Dialog: 0,0:24:05.56,0:24:08.50,Default,Silk2,0,0,0,,Mungkin ingin menunjukkan bahwa kita berasal dari klan yang sama.
Dialog: 0,0:24:09.30,0:24:10.40,Default,Spikyulka2,0,0,0,,Tapi ini tidak akan berhasil.
Dialog: 0,0:24:11.00,0:24:13.67,Default,Spillik2,0,0,0,,Kita bisa ikut bermain saja.
Dialog: 0,0:24:14.77,0:24:16.71,Default,Spilyk2,0,0,0,,-Tentu saja.\N-Ayo berangkat.
Dialog: 0,0:24:21.05,0:24:23.45,Default,Spikyulka2,0,0,0,, Cukup lama telah berlalu sejak aku naik takhta.
Dialog: 0,0:24:23.92,0:24:26.82,Default,Silk2,0,0,0,,Tapi aku tidak pernah mengundang klanku ke pesta.
Dialog: 0,0:24:27.89,0:24:29.72,Default,Spikyulka2,0,0,0,,Akhir-akhir ini aku sangat sibuk.
Dialog: 0,0:24:30.69,0:24:31.99,Default,Spikyulka2,0,0,0,,Maafkan saya.
Dialogue: 0,0:24:37.03,0:24:39.36,Default,Silk2,0,0,0,,Tidak banyak di sini, tapi aku sendiri yang memasaknya untukmu.
Dialog: 0,0:24:40.60,0:24:41.70,Default,Spillik2,0,0,0,,Selamat menikmati.
Dialog: 0,0:24:51.84,0:24:54.45,Default,Spikyulka2,0,0,0,,Ini anggur, bukan teh.
Dialogue: 0,0:24:55.85,0:24:57.32,Default,Spillik2,0,0,0,,Berpura-pura itu teh.
Dialog: 0,0:24:57.32,0:24:59.52,Default,Spillik2,0,0,0,,Raja memerintahkan untuk mengurangi jumlah hidangan.
Dialog: 0,0:24:59.65,0:25:02.25,Default,Spikyulka2,0,0,0,,Bagaimana lagi rakyatnya bisa berkumpul dan minum?
Dialog: 0,0:25:02.55,0:25:03.69,Default,Spikyulka2,0,0,0,,Tetapi jika dia mengetahuinya...
Dialog: 0,0:25:15.03,0:25:18.20,Default,Spikyulka2,0,0,0,,Anda menipu kami, Yang Mulia.
Dialog: 0,0:25:18.74,0:25:21.04,Default,Spilyk2,0,0,0,,Sudahkah Anda menjebak kami?
Dialog: 0,0:25:21.14,0:25:23.14,Default,Spillik2,0,0,0,,-Luar biasa.\N-Bagaimana dia bisa?
Dialog: 0,0:25:25.38,0:25:28.11,Default,Spillik2,0,0,0,,Berhenti membuatku marah. Merusak suasana hati.
Dialog: 0,0:25:28.85,0:25:31.15,Default,Spikyulka2,0,0,0,,Tapi kamu membuat kami marah.
Dialog: 0,0:25:31.15,0:25:34.62,Default,Spillik2,0,0,0,,Apa? Untuk siapa kamu menganggap kami?
Dialog: 0,0:25:36.02,0:25:39.79,Default,Spilyk2,0,0,0,,Saya tahu persis siapa Anda.
Dialog: 0,0:25:41.56,0:25:43.90,Default,Spikyulka2,0,0,0,,Kamu adalah penjahat di masyarakat ini.
Dialog: 0,0:25:44.60,0:25:46.83,Default,Spillik2,0,0,0,,-Jahat?\N-Jahat?
Dialogue: 0,0:25:48.33,0:25:53.01,Default,Spikyulka2,0,0,0,,Dalam bahasamu - kamu adalah wabah zaman ini.
Dialog: 0,0:25:53.01,0:25:54.81,Default,Spillik2,0,0,0,,-Apa?\N-Apa?
Dialogue: 0,0:25:54.81,0:25:57.34,Default,Spikyulka2,0,0,0,,Mengapa kita harus mentoleransi perlakuan seperti itu?
Dialog: 0,0:25:57.68,0:25:58.84,Default,Spillik2,0,0,0,,Meninggalkan.
Dialogue: 0,0:25:59.48,0:26:01.31,Default,Spilyk2,0,0,0,,Mengapa kamu mengatur ini untuk kami?
Dialog: 0,0:26:02.41,0:26:04.52,Default,Spilyk2,0,0,0,,Pertanyaan bagus. Senang Anda bertanya.
Dialog: 0,0:26:05.18,0:26:07.62,Default,Spikyulka2,0,0,0,,Pantas saja penasihat utama, Anda sangat pintar.
Dialog: 0,0:26:07.62,0:26:08.75,Default,Spilyk2,0,0,0,,Apa...
Dialogue: 0,0:26:09.66,0:26:11.66,Default,Spikyulka2,0,0,0,,Apakah kamu bertanya kenapa aku mengatur ini?
Dialog: 0,0:26:12.82,0:26:17.66,Default,Spikyulka2,0,0,0,,Aku mencoba memberitahumu untuk tidak menghalangi raja.
Dialog: 0,0:26:19.60,0:26:23.17,Default,Spikyulka2,0,0,0,,Kamu akan menolak idenya,
Dialog: 0,0:26:23.87,0:26:27.07,Default,Spikyulka2,0,0,0,,ketahuilah bahwa aku akan datang dari belakang dan sekaligus
Dialog: 0,0:26:27.07,0:26:29.47,Default,Spilyk2,0,0,0,,Aku akan membunuh semuanya.
Dialog: 0,0:26:30.71,0:26:31.94,Default,Spillik2,0,0,0,,Anggap saja Anda sudah diperingatkan.
Dialogue: 0,0:26:40.25,0:26:42.02,Default,Spikyulka2,0,0,0,,Jika tujuanmu adalah menciptakan pelanggaran hukum,
Dialog: 0,0:26:42.02,0:26:44.19,Default,Spilyk2,0,0,0,,bersembunyi di balik klan,
Dialog: 0,0:26:45.69,0:26:48.29,Default,Spilyk2,0,0,0,,waspada.
Dialog: 0,0:26:49.06,0:26:51.06,Default,Spikyulka2,0,0,0,,Ratu, kamu juga salah satu Kim Andonian.
Dialog: 0,0:26:51.06,0:26:53.80,Default,Biryulka2,0,0,0,,Jadi saya memutuskan untuk mengganti nama belakang saya.
Dialogue: 0,0:26:53.80,0:26:56.47,Default,Spikyulka2,0,0,0,,Sekarang aku bukan Kim So-yeon. Aku Chan Soyeon.
Dialog: 0,0:26:56.47,0:26:59.17,Default,Spikyulka2,0,0,0,,-Apa?\N-Apa-apaan ini...
Dialog: 0,0:27:01.14,0:27:04.38,Default,Spikyulka2,0,0,0,,Saya kira mereka sangat padat, karena klan membantu mereka mendapatkan posisi.
Dialog: 0,0:27:04.38,0:27:05.61,Default,Spillik2,0,0,0,,Tusuk hidungmu.
Dialog: 0,0:27:05.61,0:27:07.45,Default,Spikyulka2,0,0,0,,Tidak ada keberatan lagi.
Dialog: 0,0:27:07.81,0:27:09.72,Default,Spikyulka2,0,0,0,,Tidak ada perselisihan. Tidak ada kolusi.
Dialog: 0,0:27:09.72,0:27:11.18,Default,Spilyk2,0,0,0,,Tidak ada perjalanan ke Okthajeong.
Dialog: 0,0:27:11.18,0:27:13.25,Default,Spikyulka2,0,0,0,,Apa hubungannya Okthajon dengan itu?
Dialog: 0,0:27:14.52,0:27:15.82,Default,Spilyk2,0,0,0,,Yah, saya tidak bisa pergi.
Dialog: 0,0:27:18.02,0:27:20.87,Default,Lily,0,0,0,,Pesanan dilakukan tanpa masalah.
Dialog: 0,0:27:22.17,0:27:26.61,Default,Lily,0,0,0,,Janda Ratu mengurusnya.
Dialog: 0,0:27:29.00,0:27:31.43,Default,Lily,0,0,0,,Saya datang hari ini dengan sebuah permintaan.
Dialog: 0,0:27:32.81,0:27:35.31,Default,Lily,0,0,0,,Sekarang kamu sudah bersatu dengan klanku,
Dialog: 0,0:27:35.31,0:27:38.62,Default,Lily,0,0,0,,jangan mengancam atau menyakiti ratu lagi,
Dialogue: 0,0:27:38.74,0:27:40.24,Default,Lily,0,0,0,,dia juga dari klan kita.
Dialog: 0,0:27:43.28,0:27:45.16,Default,Lily,0,0,0,,Musuh kita adalah raja.
Dialogue: 0,0:27:46.42,0:27:50.63,Default,Lily,0,0,0,, Saling mengancam dengan pedang,\Nkita hanya akan membantu musuh.
Dialog: 0,0:27:51.86,0:27:53.67,Default,Lily,0,0,0,,Saya setuju.
Dialog: 0,0:27:53.67,0:27:57.80,Default,Lily,0,0,0,,Tidak ada lagi ritual dan jimat perdukunan. Saya meninggalkan mereka.
Dialog: 0,0:28:01.93,0:28:05.31,Default,Lily,0,0,0,,-Yang Mulia.\N-Ada sesuatu yang ingin saya sampaikan kepada Anda.
Dialog: 0,0:28:16.62,0:28:18.82,Default,Lily,0,0,0,,Ya, saya harus membaca buku kali ini,
Dialog: 0,0:28:18.82,0:28:20.39,Default,Lily,0,0,0,,untuk lebih memahami bahasanya.
Dialogue: 0,0:28:20.83,0:28:23.13,Default,Lily,0,0,0,,Sulit mengumpat dengan ramah.
Dialogue: 0,0:28:24.02,0:28:27.46,Default,Lily,0,0,0,,Di mana aku bisa membaca tentang kata-kata gaul Joseon?
Dialog: 0,0:28:27.46,0:28:30.43,Default,Lily,0,0,0,,Tidak ada buku seperti itu di perpustakaan ini.
Dialog: 0,0:28:30.80,0:28:31.96,Default,Lily,0,0,0,,Di mana itu?
Dialog: 0,0:28:32.14,0:28:34.64,Default,Lily,0,0,0,,Beralih ke novel,
Dialog: 0,0:28:34.64,0:28:36.77,Default,Lily,0,0,0,,dijual di toko di luar istana.
Dialog: 0,0:28:38.00,0:28:39.20,Default,Lily,0,0,0,,Apa yang mereka bicarakan?
Dialog: 0,0:28:39.97,0:28:43.88,Default,Lily,0,0,0,,Saya mendengar tentang mereka. Tapi saya tidak pernah membacanya.
Dialog: 0,0:28:44.82,0:28:46.24,Default,Lily,0,0,0,,Saya tahu beberapa.
Dialog: 0,0:28:47.71,0:28:49.18,Default,Lily,0,0,0,,Tentang istri yang setia,
Dialog: 0,0:28:49.18,0:28:51.01,Default,Lilia,0,0,0,,meninggal setelah pengkhianatan suaminya.
Dialog: 0,0:28:51.01,0:28:53.56,Default,Lily,0,0,0,,Semangatnya kembali dengan tahi lalat di dekat mulutnya,
Dialog: 0,0:28:53.56,0:28:54.98,Default,Lily,0,0,0,,untuk membalas dendam.
Dialog: 0,0:28:56.16,0:28:57.80,Default,Lily,0,0,0,,Cerita yang familiar.
Dialog: 0,0:28:57.86,0:28:59.06,Default,Lily,0,0,0,,Apa nama bukunya?
Dialogue: 0,0:28:59.13,0:29:00.49,Default,Lily,0,0,0,,"Godaan sang istri."
Dialogue: 0,0:29:01.90,0:29:02.99,Default,Lily,0,0,0,,Kamu belum membaca.
Dialog: 0,0:29:03.10,0:29:06.10,Default,Lily,0,0,0,,Saya hanya tahu namanya.
Dialog: 0,0:29:07.70,0:29:09.41,Default,Lily,0,0,0,,Dan juga? Apa lagi?
Dialog: 0,0:29:09.67,0:29:11.00,Default,Lily,0,0,0,,Yang ini keluar baru-baru ini.
Dialog: 0,0:29:11.00,0:29:12.64,Default,Lily,0,0,0,,Tentang wanita bangsawan.
Dialog: 0,0:29:12.64,0:29:15.67,Default,Lilia,0,0,0,,Suaminya mulai berselingkuh dengan putri tetangganya.
Dialog: 0,0:29:15.67,0:29:17.32,Default,Lily,0,0,0,,"Dunia pasangan suami istri."
Dialog: 0,0:29:19.38,0:29:22.24,Default,Lily,0,0,0,,Nyonya Choi, kenapa kamu begitu khawatir, belumkah kamu membacanya?
Dialog: 0,0:29:23.12,0:29:24.56,Default,Lily,0,0,0,,Maaf.
Dialogue: 0,0:29:26.42,0:29:29.45,Default,Lily,0,0,0,,Semua wanita bereaksi dengan cara yang sama terhadap cerita seperti itu.
Dialog: 0,0:29:35.72,0:29:37.19,Default,Lily,0,0,0,,Mengapa kamu melakukan ini?
Dialog: 0,0:29:38.46,0:29:39.76,Default,Lily,0,0,0,,Tinggalkan kami.
Dialog: 0,0:29:42.07,0:29:43.14,Default,Lily,0,0,0,,Ya.
Dialog: 0,0:29:49.44,0:29:52.62,Default,Lily,0,0,0,,Anda memerlukan dukungan klan untuk memastikan keselamatan Anda.
Dialogue: 0,0:29:53.05,0:29:55.12,Default,Lily,0,0,0,,Mengapa merusak hubunganmu dengan mereka?
Dialog: 0,0:29:55.51,0:29:56.95,Default,Lily,0,0,0,,Sepertinya kamu lupa,
Dialog: 0,0:29:56.98,0:29:59.45,Default,Lily,0,0,0,,bahwa orang-orang tua ini mencoba membunuhku.
Dialog: 0,0:29:59.45,0:30:01.72,Default,Lily,0,0,0,,Saya melakukan yang terbaik untuk membangun jembatan,
Dialog: 0,0:30:01.72,0:30:03.45,Default,Lily,0,0,0,,jadi kamu bisa kembali.
Dialog: 0,0:30:03.45,0:30:05.13,Default,Lily,0,0,0,,Saya tidak ingin kembali.
Dialog: 0,0:30:06.49,0:30:07.96,Default,Lily,0,0,0,,Saya mencoba yang terbaik,
Dialog: 0,0:30:07.96,0:30:10.46,Default,Lily,0,0,0,,untuk merayu Janda Ratu.
Dialog: 0,0:30:10.46,0:30:12.93,Default,Lily,0,0,0,,Aku tidak bekerja terlalu keras bahkan di Gedung Biru.
Dialog: 0,0:30:14.73,0:30:16.20,Default,Lily,0,0,0,,Dan apa tanggapan yang saya dapatkan?
Dialog: 0,0:30:16.58,0:30:17.70,Default,Lily,0,0,0,,Es beracun.
Dialog: 0,0:30:17.70,0:30:19.85,Default,Lily,0,0,0,,Ini karena rumor yang disebarkan oleh klan Cho.
Dialog: 0,0:30:20.55,0:30:22.74,Default,Lily,0,0,0,,Aku akan menjagamu tetap aman.
Dialog: 0,0:30:23.27,0:30:24.97,Default,Lily,0,0,0,,Mari kita perjelas.
Dialogue: 0,0:30:24.97,0:30:26.94,Default,Lily,0,0,0,,Lebih baik cepat daripada nanti.
Dialog: 0,0:30:28.01,0:30:30.39,Default,Lily,0,0,0,,Aku tidak akan membalas perasaanmu
Dialog: 0,0:30:30.39,0:30:32.28,Default,Lily,0,0,0,,dan saya tidak bisa menggunakannya.
Dialog: 0,0:30:32.78,0:30:33.86,Default,Lily,0,0,0,,I
Dialog: 0,0:30:35.56,0:30:37.42,Default,Lily,0,0,0,,memilih jalan yang berbeda,
Dialog: 0,0:30:37.80,0:30:39.90,Default,Lily,0,0,0,,sebaiknya kita menempuh jalan kita masing-masing.
Dialog: 0,0:30:43.84,0:30:45.87,Default,Lily,0,0,0,,Saya milik Anda, Yang Mulia.
Dialog: 0,0:30:51.97,0:30:53.85,Default,Lily,0,0,0,,Mengapa raja?
Dialog: 0,0:30:54.41,0:30:57.12,Default,Lily,0,0,0,,Jika dia menghilang, aku akan melakukan segalanya,
Dialog: 0,0:30:57.12,0:30:59.58,Default,Lily,0,0,0,,apapun yang kamu minta. Kenapa dia?
Dialog: 0,0:31:04.82,0:31:06.72,Default,Lily,0,0,0,,Ini bukan tentang dia.
Dialog: 0,0:31:07.89,0:31:09.92,Default,Lily,0,0,0,,Aku tidak punya perasaan padamu.
Dialog: 0,0:31:23.03,0:31:25.31,Default,Lily,0,0,0,,Jangan lepaskan tanganku, Soyeon.
Dialog: 0,0:31:28.11,0:31:29.88,Default,Lily,0,0,0,,Kamu adalah segalanya bagiku.
Dialog: 0,0:32:11.71,0:32:13.45,Default,Lily,0,0,0,,Kamu harus menggambarkan
Dialog: 0,0:32:13.45,0:32:15.18,Default,Lily,0,0,0,,setiap detail, setiap helai rambut.
Dialog: 0,0:32:16.25,0:32:18.13,Default,Lily,0,0,0,,Tidak hanya mencerminkan penampilan,
Dialog: 0,0:32:18.13,0:32:19.66,Default,Lily,0,0,0,,tetapi juga kekuatan batin dan martabat.
Dialog: 0,0:32:19.66,0:32:21.80,Default,Lily,0,0,0,,Jangan gunakan gayamu sendiri.
Dialogue: 0,0:32:31.17,0:32:32.27,Default,Lily,0,0,0,,Ratuku.
Dialog: 0,0:32:33.24,0:32:35.11,Default,Lily,0,0,0,,Apakah kamu mengkhawatirkan sesuatu?
Dialog: 0,0:32:36.31,0:32:37.55,Default,Lily,0,0,0,,Tidak, saya tidak akan mengatakannya.
Dialogue: 0,0:32:39.27,0:32:41.18,Default,Lily,0,0,0,,Aku merasa tidak enak.
Dialogue: 0,0:32:44.51,0:32:45.75,Default,Lily,0,0,0,,Ratuku.
Dialogue: 0,0:32:50.10,0:32:51.40,Default,Lily,0,0,0,,Apa yang merasukimu?
Dialog: 0,0:32:52.90,0:32:55.67,Default,Lily,0,0,0,,Saat aku tersenyum seperti itu, suaraku terdengar seperti raja.
Dialog: 0,0:32:55.67,0:32:58.99,Default,Lily,0,0,0,,Dan saat mata juling, suaranya terdengar seperti kasim.
Dialog: 0,0:33:03.88,0:33:05.27,Default,Lily,0,0,0,,Tidak lucu?
Dialog: 0,0:33:05.97,0:33:09.24,Default,Lily,0,0,0,,Sangat sulit membuatmu tertawa.
Dialog: 0,0:33:09.58,0:33:10.67,Default,Lily,0,0,0,,Lalu...
Dialog: 0,0:33:11.55,0:33:14.35,Default,Lily,0,0,0,,Saat aku membungkuk, aku berbicara seperti seorang pelayan.
Dialogue: 0,0:33:14.35,0:33:17.92,Default,Lily,0,0,0,,Dan saat aku berdiri tegak, aku berbicara seperti seorang pejuang.
Dialog: 0,0:33:17.92,0:33:19.39,Default,Lily,0,0,0,,Tidak lucu?
Dialog: 0,0:33:27.83,0:33:29.13,Default,Lily,0,0,0,,Kamu tertawa.
Dialog: 0,0:33:30.23,0:33:31.37,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:33:31.69,0:33:34.00,Default,Lily,0,0,0,,-Ambil posemu.\N-Oke.
Dialog: 0,0:33:35.11,0:33:36.73,Default,Lily,0,0,0,,Aku akan membuatmu tertawa nanti.
Dialogue: 0,0:33:39.31,0:33:42.08,Default,Lily,0,0,0,,Ngomong-ngomong, kenapa kamu memerlukan potret ini?
Dialog: 0,0:33:42.08,0:33:44.35,Default,Lily,0,0,0,,Menurut aturan “Cho” dan “Chon”,
Dialog: 0,0:33:44.35,0:33:46.65,Default,Lily,0,0,0,,Raja Seongjong akan dipanggil Sunjo dengan hormat,
Dialog: 0,0:33:48.65,0:33:51.21,Default,Lily,0,0,0,,yang berarti mereka juga akan menghormatiku,
Dialog: 0,0:33:51.21,0:33:52.75,Default,Lily,0,0,0,,karena ingin menghormati ingatannya.
Dialog: 0,0:33:52.75,0:33:55.16,Default,Lily,0,0,0,,Aturan "Cho" dan "Chon"...
Dialog: 0,0:33:55.33,0:33:57.66,Default,Lily,0,0,0,,Saya mendengar tentang dia.
Dialog: 0,0:33:57.92,0:34:00.26,Default,Lily,0,0,0,,Saat memilih nama anumerta raja
Dialog: 0,0:34:00.26,0:34:02.72,Default,Lily,0,0,0,,"Cho" digunakan untuk mereka yang telah memberikan kontribusi besar,
Dialog: 0,0:34:02.72,0:34:05.19,Default,Lily,0,0,0,,dan “Chon” adalah untuk mereka yang terkenal karena kebajikan.
Dialogue: 0,0:34:06.34,0:34:07.74,Default,Lily,0,0,0,,Tepat sekali, sekarang aku ingat.
Dialog: 0,0:34:13.70,0:34:15.78,Default,Lily,0,0,0,,Yang Mulia, saya membawa apa yang Anda minta.
Dialog: 0,0:34:16.68,0:34:18.34,Default,Lily,0,0,0,,Mari kita lihat.
Dialog: 0,0:34:26.32,0:34:28.13,Default,Lily,0,0,0,,Kelihatannya keren.
Dialogue: 0,0:34:28.13,0:34:30.09,Default,Lily,0,0,0,,Apakah kamu ingin belajar anggar?
Dialogue: 0,0:34:30.40,0:34:31.72,Default,Lily,0,0,0,,Aku baik-baik saja.
Dialog: 0,0:34:32.36,0:34:34.47,Default,Lily,0,0,0,,Aku bahkan tidak perlu belajar.
Dialogue: 0,0:34:34.67,0:34:36.59,Default,Lily,0,0,0,,Aku ahli menggunakan pisau.
Dialog: 0,0:34:37.20,0:34:41.76,Default,Lily,0,0,0,,Ini adalah hadiah untuk orang yang spesial.
Dialog: 0,0:34:43.61,0:34:44.88,Default,Lily,0,0,0,,Khusus?
Dialogue: 0,0:35:07.26,0:35:08.59,Default,Lily,0,0,0,,Giliranku?
Dialog: 0,0:35:08.97,0:35:10.43,Default,Lily,0,0,0,,Jadi kamu menunggu ini?
Dialog: 0,0:35:10.67,0:35:12.07,Default,Lily,0,0,0,,Maaf.
Dialog: 0,0:35:12.40,0:35:14.51,Default,Lily,0,0,0,,Kamu diusir,
Dialogue: 0,0:35:14.51,0:35:17.03,Default,Lily,0,0,0,,Aku tidak yakin pantas untuk mempermainkanmu.
Dialog: 0,0:35:17.97,0:35:19.18,Default,Lily,0,0,0,,Lucu.
Dialog: 0,0:35:20.28,0:35:21.95,Default,Lily,0,0,0,,Anda mengusulkan aliansi,
Dialogue: 0,0:35:21.95,0:35:23.61,Default,Lily,0,0,0,,tapi mereka pergi tanpa pamit.
Dialogue: 0,0:35:23.68,0:35:25.92,Default,Lily,0,0,0,,Kamu tidak bisa mengendalikan suamimu.
Dialog: 0,0:35:25.92,0:35:28.82,Default,Lily,0,0,0,,Jadi kamu tidak menjamin keselamatanku?
Dialogue: 0,0:35:32.22,0:35:34.26,Default,Lily,0,0,0,,Soalnya, aku punya rencana.
Dialog: 0,0:35:34.26,0:35:36.22,Default,Lily,0,0,0,,Sampai kamu menantangku.
Dialog: 0,0:35:36.59,0:35:38.43,Default,Lily,0,0,0,,Apa gunanya?
Dialog: 0,0:35:38.43,0:35:40.97,Default,Lily,0,0,0,,Jalani kehidupan yang tenang dan membosankan.
Dialogue: 0,0:35:44.63,0:35:45.86,Default,Lily,0,0,0,,Tarik pedangmu.
Dialogue: 0,0:35:47.80,0:35:50.51,Default,Lily,0,0,0,,Aku tidak berkelahi dengan wanita.
Dialog: 0,0:35:52.80,0:35:55.68,Default,Lily,0,0,0,,Ini adalah hadiah terkait pemecatan dari jabatan.
Dialog: 0,0:35:57.11,0:36:01.28,Default,Lily,0,0,0,,Semua pencapaianmu ditandai pada bilahnya,
Dialog: 0,0:36:02.22,0:36:03.51,Default,Lily,0,0,0,,lihat.
Dialog: 0,0:36:11.82,0:36:15.22,Default,Lily,0,0,0,,Inilah kehidupan yang kamu jalani.
Dialog: 0,0:36:17.09,0:36:18.57,Default,Lily,0,0,0,,Kamu bilang aku tidak peduli tentang apa pun
Dialog: 0,0:36:19.09,0:36:22.61,Default,Lily,0,0,0,,tidak mampu, karena saya seorang wanita, bukan seorang ratu.
Dialog: 0,0:36:23.84,0:36:26.47,Default,Lily,0,0,0,,Tunggu. Saya akan menunjukkan kemampuan saya.
Dialog: 0,0:36:27.78,0:36:30.32,Default,Lily,0,0,0,,Tidak ada lagi halangan pada perkataan dan perbuatanku,
Dialog: 0,0:36:30.65,0:36:32.18,Default,Lily,0,0,0,,karena tidak ada ruginya.
Dialog: 0,0:36:49.20,0:36:52.20,Default,Lily,0,0,0,,Yang Mulia, selir utama telah tiba.
Dialog: 0,0:36:53.43,0:36:54.63,Default,Lily,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:37:08.84,0:37:10.26,Default,Lily,0,0,0,,Bagaimana perasaanmu?
Dialogue: 0,0:37:13.05,0:37:16.05,Default,Lily,0,0,0,,Aku menata pikiranku selagi aku menembak dengan busur.
Dialogue: 0,0:37:16.05,0:37:17.82,Default,Lily,0,0,0,,Menemukan kedamaian.
Dialogue: 0,0:37:19.05,0:37:20.13,Default,Lily,0,0,0,,Senang mendengarnya.
Dialog: 0,0:37:21.90,0:37:24.09,Default,Lily,0,0,0,,Sudah larut, dan masih banyak pekerjaan yang harus kamu selesaikan.
Dialog: 0,0:37:24.09,0:37:26.13,Default,Lily,0,0,0,,Jangan khawatir.
Dialogue: 0,0:37:32.84,0:37:34.34,Default,Lily,0,0,0,,Instruksi awal untuk anak-anak
Dialogue: 0,0:37:47.49,0:37:50.32,Default,Lily,0,0,0,,Jika saya tahu betapa Anda akan sangat menghargai buku ini,
Dialog: 0,0:37:50.80,0:37:52.49,Default,Lily,0,0,0,,Saya akan mencoba membiarkannya bersih.
Dialogue: 0,0:37:53.49,0:37:54.93,Default,Lily,0,0,0,,Lihat coretan ini.
Dialogue: 0,0:38:02.80,0:38:05.53,Default,Lily,0,0,0,,Sepertinya kamu sedang sibuk. Aku sudah menyita terlalu banyak waktu.
Dialogue: 0,0:38:05.53,0:38:06.63,Default,Lily,0,0,0,,Aku pergi.
Dialog: 0,0:38:12.22,0:38:13.28,Default,Lily,0,0,0,,Selir.
Dialog: 0,0:38:15.49,0:38:17.82,Default,Lily,0,0,0,,Saya tidak punya waktu untuk mengatakan sesuatu.
Dialogue: 0,0:38:20.26,0:38:21.72,Default,Lily,0,0,0,,Aku menyukaimu
Dialog: 0,0:38:23.38,0:38:25.45,Default,Lily,0,0,0,,bukan hanya karena pertemuan di sumur
Dialog: 0,0:38:25.45,0:38:27.43,Default,Lily,0,0,0,,delapan tahun lalu.
Dialog: 0,0:38:28.53,0:38:30.63,Default,Lily,0,0,0,,Saat aku kembali ke Hanyang dan bertemu denganmu,
Dialogue: 0,0:38:31.86,0:38:33.26,Default,Lily,0,0,0,,Aku menyukaimu.
Dialog: 0,0:38:38.34,0:38:40.80,Default,Lily,0,0,0,,Yang Mulia, Pangeran Yeonpyeong telah tiba.
Dialog: 0,0:38:46.47,0:38:48.74,Default,Lily,0,0,0,,Tidak tahu kamu ada di sini.
Dialog: 0,0:38:48.92,0:38:50.28,Default,Lily,0,0,0,,Aku hendak berangkat.
Dialog: 0,0:38:51.68,0:38:53.18,Default,Lily,0,0,0,,Aku akan meninggalkanmu.
Dialog: 0,0:39:06.24,0:39:08.40,Default,Lily,0,0,0,,Apa yang tadi kamu bicarakan?
Dialog: 0,0:39:11.18,0:39:13.34,Default,Lily,0,0,0,,Berpaling dari kebenaran yang tidak dibutuhkan siapa pun,
Dialog: 0,0:39:14.97,0:39:16.70,Default,Lily,0,0,0,,akan lebih tepat.
Dialog: 0,0:39:47.45,0:39:49.40,Default,Lily,0,0,0,,Mata penuh gairah.
Dialogue: 0,0:39:51.11,0:39:53.88,Default,Lily,0,0,0,,Sangat tertarik dengan ilmu sosial.
Dialog: 0,0:39:58.76,0:40:00.88,Default,Lily,0,0,0,,Kamu telah menunggu pelajaranku sepanjang hari.
Dialog: 0,0:40:01.32,0:40:04.13,Default,Lily,0,0,0,,Saya tidak percaya, tapi Anda tahu
Dialog: 0,0:40:04.13,0:40:05.90,Default,Lily,0,0,0,,cerita tentang masa depan, seperti tadi malam.
Dialog: 0,0:40:06.59,0:40:07.97,Default,Lily,0,0,0,,Topik pelajaran hari ini.
Dialog: 0,0:40:26.18,0:40:27.49,Default,Lily,0,0,0,,Monarki konstitusional.
Dialog: 0,0:40:28.92,0:40:30.32,Default,Lily,0,0,0,,Monarki konstitusional?
Dialog: 0,0:40:30.65,0:40:32.68,Default,Lily,0,0,0,,Ada raja, tapi mereka tidak memerintah rakyat.
Dialog: 0,0:40:33.99,0:40:37.09,Default,Lily,0,0,0,,Penguasa itu ada, tapi rakyat juga punya kekuasaan.
Dialog: 0,0:40:40.03,0:40:41.49,Default,Lily,0,0,0,,Ada sebuah negara bernama Bhutan.
Dialogue: 0,0:40:41.90,0:40:43.63,Default,Lily,0,0,0,,Nama yang aneh untuk sebuah negara.
Dialog: 0,0:40:43.86,0:40:46.67,Default,Lily,0,0,0,,Ada seorang raja dengan nama yang lebih asing lagi, Jigme Khesar.
Dialogue: 0,0:40:46.97,0:40:49.43,Default,Lily,0,0,0,,Dulu ada monarki absolut, seperti di Joseon.
Dialog: 0,0:40:49.43,0:40:51.11,Default,Lily,0,0,0,,Tapi dia mengubahnya menjadi monarki konstitusional.
Dialog: 0,0:40:51.51,0:40:52.61,Default,Lily,0,0,0,,Mengapa?
Dialog: 0,0:40:53.11,0:40:55.84,Default,Lily,0,0,0,,Dia takut tiran akan naik takhta,
Dialog: 0,0:40:55.84,0:40:57.28,Default,Lily,0,0,0,,yang akan menghancurkan negara.
Dialog: 0,0:40:57.92,0:41:00.18,Default,Lily,0,0,0,,Jadi dia memperkenalkan sistem ketatanegaraan.
Dialog: 0,0:41:00.45,0:41:02.09,Default,Lily,0,0,0,,Dia memerintah negara berdasarkan hukum.
Dialog: 0,0:41:02.22,0:41:04.26,Default,Lily,0,0,0,,Jadi kerajaan hanyalah sebuah simbol.
Dialog: 0,0:41:04.68,0:41:07.18,Default,Lily,0,0,0,,Jigme Khesar pintar.
Dialog: 0,0:41:08.22,0:41:10.49,Default,Lily,0,0,0,,Karakter Cina apa yang dia gunakan untuk menulis “Ji”?
Dialog: 0,0:41:28.90,0:41:31.45,Default,Lily,0,0,0,,Waktunya pulang.
Dialog: 0,0:41:32.74,0:41:33.78,Default,Lily,0,0,0,,Pulang?
Dialog: 0,0:41:34.88,0:41:35.92,Default,Lily,0,0,0,,Di mana ini?
Dialogue: 0,0:41:35.92,0:41:40.18,Default,Lily,0,0,0,,Bung, kamu terlalu banyak minum.
Dialog: 0,0:41:40.18,0:41:41.63,Default,Lily,0,0,0,,Lupa dimana rumahmu berada.
Dialogue: 0,0:41:42.68,0:41:45.03,Default,Lily,0,0,0,,Tahu tidak? Aku sudah muak.
Dialogue: 0,0:41:45.03,0:41:48.20,Default,Lily,0,0,0,,Aku harus pulang dan istirahat.
Dialog: 0,0:41:56.17,0:41:57.74,Default,Lily,0,0,0,,Saya tidak punya rumah.
Dialog: 0,0:42:00.70,0:42:02.15,Default,Lily,0,0,0,,Saya tidak punya apa-apa.
Dialog: 0,0:42:05.61,0:42:09.34,Default,Lily,0,0,0,,Aku tidak punya tempat tujuan, aku tidak punya apa-apa.
Dialog: 0,0:42:11.68,0:42:13.99,Default,Lily,0,0,0,,Saya tidak punya apa-apa.
Dialogue: 0,0:42:29.24,0:42:33.57,Default,tier 4,0,0,0,,Aku menyukaimu \Nbukan hanya karena pertemuan di sumur
Dialog: 0,0:42:33.57,0:42:35.51,Default,tingkat 4,0,0,0,,delapan tahun lalu.
Dialog: 0,0:42:37.28,0:42:38.32,Default,tingkat 4,0,0,0,,Tidak.
Dialog: 0,0:42:40.01,0:42:41.78,Default,tingkat 4,0,0,0,,Dia tidak dapat menemukan kebenaran.
Dialog: 0,0:42:52.86,0:42:55.09,Default,tingkat 4,0,0,0,,Anda tidak bisa masuk.
Dialog: 0,0:42:55.09,0:42:56.59,Default,tingkat 4,0,0,0,,Saya harus menemui raja.
Dialog: 0,0:42:57.34,0:42:59.20,Default,tingkat 4,0,0,0,,Yah...
Dialog: 0,0:43:04.70,0:43:06.93,Default,menembak 4,0,0,0,,Yang Mulia, ini Hwajin.
Dialog: 0,0:43:45.57,0:43:47.92,Default,tingkat 4,0,0,0,,Jadi yang Anda inginkan,
Dialog: 0,0:43:47.92,0:43:50.22,Default,tingkat 4,0,0,0,,agar saya menyelesaikan buku taktik dengan ratu,
Dialog: 0,0:43:50.49,0:43:52.26,Default,tingkat 4,0,0,0,,berpakaian seperti laki-laki.
Dialog: 0,0:43:53.78,0:43:55.03,Default,tingkat 4,0,0,0,,Bagus.
Dialog: 0,0:43:56.88,0:43:58.22,Default,tingkat 4,0,0,0,,Buang prasangkamu.
Dialog: 0,0:43:58.40,0:43:59.65,Default,tingkat 4,0,0,0,,Dia menciptakan senjata,
Dialog: 0,0:43:59.65,0:44:01.49,Default,tingkat 4,0,0,0,,yang belum pernah dilihat siapa pun sebelumnya.
Dialog: 0,0:44:03.97,0:44:06.57,Default,tingkat 4,0,0,0,,Baiklah, mari kita dengarkan.
Dialog: 0,0:44:07.61,0:44:10.88,Default,tingkat 4,0,0,0,,Sebelum itu, mari kita bicara tentang metode mematikan dalam melatih prajurit.
Dialog: 0,0:44:11.18,0:44:12.84,Default,tingkat 4,0,0,0,,Mengapa tidak memulai dengan ini?
Dialog: 0,0:44:14.95,0:44:16.05,Default,tingkat 4,0,0,0,,Metode mematikan?
Dialog: 0,0:44:18.92,0:44:21.42,Default,tingkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:21.68,0:44:22.72,Default,tingkat 4,0,0,0,,Tujuh.
Dialog: 0,0:44:22.72,0:44:26.26,Default,tingkat 4,0,0,0,,Saya tidak dapat mendengar Anda. Apakah hanya itu yang bisa kamu lakukan?
Dialog: 0,0:44:27.09,0:44:30.18,Default,tingkat 4,0,0,0,,Oke, saya mengerti semuanya. Mari kita bicara tentang senjata.
Dialog: 0,0:44:30.55,0:44:32.99,Default,tingkat 4,0,0,0,,14 pendekatan secara total. Ini tanggal 8.
Dialog: 0,0:44:34.97,0:44:37.09,Default,tingkat 4,0,0,0,,Jangan ucapkan angka terakhir.
Dialog: 0,0:44:37.30,0:44:39.86,Default,tingkat 4,0,0,0,,Jika Anda menyebutkannya, Anda mulai lagi.
Dialog: 0,0:44:41.26,0:44:43.57,Default,tingkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:43.90,0:44:44.90,Default,tingkat 4,0,0,0,,Enam.
Dialog: 0,0:44:45.70,0:44:46.97,Default,tingkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:46.97,0:44:48.90,Default,tingkat 4,0,0,0,,-Terlihat lurus.\N-Tujuh.
Dialog: 0,0:44:49.07,0:44:51.61,Default,tingkat 4,0,0,0,,Berbahaya membiarkannya masuk ke dalam strategi militer.
Dialog: 0,0:44:51.92,0:44:54.82,Default,tingkat 4,0,0,0,,Ratu menyatakan perang terhadap klannya.
Dialog: 0,0:44:55.78,0:44:58.38,Default,tingkat 4,0,0,0,,Dia tidak perlu lagi membuktikan bahwa dia memang untuk kita.
Dialog: 0,0:45:01.09,0:45:02.18,Default,tingkat 4,0,0,0,,Yang Mulia.
Dialog: 0,0:45:02.18,0:45:04.86,Default,tingkat 4,0,0,0,,-Angkat kakimu.\N-2, 3.
Dialog: 0,0:45:05.13,0:45:06.49,Default,tingkat 4,0,0,0,,-Delapan.\N-Past.
Dialog: 0,0:45:07.26,0:45:08.76,Default,tingkat 4,0,0,0,,Delapan adalah angka terakhir.
Dialog: 0,0:45:09.32,0:45:11.09,Default,tingkat 4,0,0,0,,Mulai lagi.
Dialog: 0,0:45:11.09,0:45:12.86,Default,tingkat 4,0,0,0,,Tunggu. Metode mematikan ini
Dialog: 0,0:45:12.86,0:45:14.51,Default,tingkat 4,0,0,0,,berakhir saat aku mati?
Dialog: 0,0:45:14.51,0:45:16.20,Default,tingkat 4,0,0,0,,Mulai lagi.
Dialog: 0,0:45:16.70,0:45:18.01,Default,tingkat 4,0,0,0,,-Ayo.\N-Satu.
Dialog: 0,0:45:19.03,0:45:20.28,Default,tingkat 4,0,0,0,,Yang Mulia.
Dialog: 0,0:45:32.32,0:45:34.13,Default,tingkat 4,0,0,0,,Perlahan berubah menjadi monster -
Dialog: 0,0:45:37.53,0:45:39.59,Default,tingkat 4,0,0,0,,dan Anda sendiri tidak menyadarinya.
Dialog: 0,0:45:50.13,0:45:51.70,Default,tingkat 4,0,0,0,,Entri palsu ini
Dialog: 0,0:45:51.70,0:45:54.01,Default,tingkat 4,0,0,0,,cukup untuk menghapus penasihat kiri.
Dialog: 0,0:45:54.84,0:45:57.20,Default,tingkat 4,0,0,0,,-Jaga dia.\N-Ya.
Dialog: 0,0:46:00.18,0:46:03.05,Default,tingkat 4,0,0,0,,Yang Mulia, selir utama telah tiba.
Dialog: 0,0:46:03.82,0:46:04.99,Default,tingkat 4,0,0,0,,Biarkan saya masuk.
Dialog: 0,0:46:16.86,0:46:18.40,Default,tingkat 4,0,0,0,,Saya perlu memberi tahu Anda sesuatu.
Dialog: 0,0:46:20.84,0:46:23.93,Default,tingkat 4,0,0,0,,Pangeran Yeonpyeong, bisakah Anda meninggalkan kami?
Dialog: 0,0:46:24.61,0:46:26.63,Default,tingkat 4,0,0,0,,-Yang Mulia.\N-Tolong.
Dialog: 0,0:46:36.11,0:46:39.88,Default,tingkat 4,0,0,0,,Akhir-akhir ini kamu sering berbicara dengan ratu di malam hari.
Dialog: 0,0:46:41.05,0:46:42.99,Default,tingkat 4,0,0,0,,Bolehkah saya tahu apa yang Anda diskusikan?
Dialog: 0,0:46:43.36,0:46:45.90,Default,tingkat 4,0,0,0,,Kita berbicara tentang bagaimana saya melihat masa depan Joseon.
Dialog: 0,0:46:47.80,0:46:51.09,Default,tingkat 4,0,0,0,,Saya pikir saya akan menjadi satu-satunya orang yang dapat Anda ajak berbagi impian.
Dialog: 0,0:46:52.30,0:46:53.59,Default,tingkat 4,0,0,0,,Saat ratu semakin dekat denganmu,
Dialog: 0,0:46:53.59,0:46:57.13,Default,tier 4,0,0,0,,yang kulakukan hanyalah ragu karena kebohongan orang lain.
Dialog: 0,0:47:00.90,0:47:03.01,Default,tingkat 4,0,0,0,,Tapi saya tidak akan mengizinkan ini lagi.
Dialog: 0,0:47:05.15,0:47:06.78,Default,tingkat 4,0,0,0,,Instruksi awal untuk anak-anak
Dialog: 0,0:47:08.51,0:47:09.88,Default,tingkat 4,0,0,0,,bukan milikku.
Dialog: 0,0:47:15.15,0:47:16.68,Default,tingkat 4,0,0,0,,Anda sudah tahu tentang ini.
Dialog: 0,0:47:17.95,0:47:20.20,Default,tingkat 4,0,0,0,,Lalu kenapa mereka tidak mengatakan apa-apa?
Dialog: 0,0:47:20.53,0:47:22.57,Default,tingkat 4,0,0,0,,Karena tidak akan mengubah apa pun.
Dialog: 0,0:47:22.57,0:47:24.74,Default,tingkat 4,0,0,0,,Mengapa ini tidak mengubah apa pun?
Dialog: 0,0:47:26.13,0:47:29.24,Default,tingkat 4,0,0,0,,Kamu tidak percaya padaku lagi.
Dialog: 0,0:47:30.90,0:47:34.01,Default,tingkat 4,0,0,0,,Kamu tidak melihatku dengan cara yang sama lagi.
Dialog: 0,0:47:34.38,0:47:36.80,Default,tingkat 4,0,0,0,,Karena satu kebohongan,
Dialog: 0,0:47:37.38,0:47:40.11,Default,tingkat 4,0,0,0,,waktu yang dihabiskan bersamamu tidak akan hilang.
Dialog: 0,0:47:41.68,0:47:44.01,Default,tingkat 4,0,0,0,,Fakta bahwa aku mencintaimu selama dua tahun,
Dialog: 0,0:47:45.15,0:47:46.32,Default,tingkat 4,0,0,0,,tidak akan berubah.
Dialog: 0,0:47:46.68,0:47:48.68,Default,tingkat 4,0,0,0,,Saya yakin Anda melakukan ini demi saya.
Dialog: 0,0:47:50.93,0:47:52.82,Default,tingkat 4,0,0,0,,Karena kamu adalah orang seperti itu.
Dialog: 0,0:47:54.80,0:47:57.36,Default,tingkat 4,0,0,0,,Apakah menurut Anda fakta itu akan membuat saya bahagia,
Dialog: 0,0:47:57.70,0:47:59.74,Default,tingkat 4,0,0,0,,bahwa kamu pura-pura tidak tahu apa-apa?
Dialog: 0,0:47:59.74,0:48:02.70,Default,menembak 4,0,0,0,,-Hwajin.\N-Aku menjebak ratu.
Dialog: 0,0:48:04.28,0:48:05.40,Default,tingkat 4,0,0,0,,I
Dialogue: 0,0:48:06.53,0:48:08.24,Default,tier 4,0,0,0,,menemukan buku akuntansi keluarga Kim
Dialog: 0,0:48:08.24,0:48:09.95,Default,tingkat 4,0,0,0,,dan memberikannya kepada Ibu Suri.
Dialog: 0,0:48:11.55,0:48:12.61,Default,tingkat 4,0,0,0,,Kenapa kamu...
Dialog: 0,0:48:14.38,0:48:15.55,Default,tingkat 4,0,0,0,,Karena
Dialog: 0,0:48:17.68,0:48:18.99,Default,tingkat 4,0,0,0,,Aku benci ratu.
Dialog: 0,0:48:20.11,0:48:22.32,Default,tingkat 4,0,0,0,,Tahukah Anda bahwa buku besar ini
Dialog: 0,0:48:23.15,0:48:25.15,Default,tingkat 4,0,0,0,,apakah itu benar-benar diperlukan bagi saya?
Dialog: 0,0:48:25.32,0:48:26.80,Default,tingkat 4,0,0,0,,Tahu, tapi memberikannya.
Dialog: 0,0:48:29.09,0:48:31.47,Default,tingkat 4,0,0,0,,Bagaimana kamu bisa melakukan ini?
Dialogue: 0,0:48:32.17,0:48:34.84,Default,tier 4,0,0,0,,Kamu lebih tahu dari siapa pun tentang apa yang aku impikan.
Dialog: 0,0:48:36.13,0:48:37.63,Default,tingkat 4,0,0,0,,Kau menginjak-injak mimpiku.
Dialog: 0,0:48:37.63,0:48:38.90,Default,tingkat 4,0,0,0,,Impianku...
Dialog: 0,0:48:39.78,0:48:41.88,Default,tingkat 4,0,0,0,,Kamu adalah impianku.
Dialog: 0,0:48:43.40,0:48:46.92,Default,tingkat 4,0,0,0,,Tapi jantungmu mulai berdetak kencang untuk ratu.
Dialog: 0,0:48:48.24,0:48:50.42,Default,tingkat 4,0,0,0,,Kamu berusaha keras untukku,
Dialog: 0,0:48:51.18,0:48:53.92,Default,tingkat 4,0,0,0,,tapi saya melihat bagaimana Anda meraihnya.
Dialog: 0,0:48:55.63,0:48:58.36,Default,tingkat 4,0,0,0,,Saya merasa sangat menyedihkan.
Dialog: 0,0:49:01.32,0:49:03.47,Default,tingkat 4,0,0,0,,Jadi aku tersesat.
Dialog: 0,0:49:17.45,0:49:18.72,Default,tingkat 4,0,0,0,,Ini salahku.
Dialog: 0,0:49:20.78,0:49:22.49,Default,tingkat 4,0,0,0,,Kamu menjadi seperti ini karena aku.
Dialog: 0,0:49:24.05,0:49:25.68,Default,tingkat 4,0,0,0,,Ini salahku.
Dialog: 0,0:49:27.42,0:49:31.05,Default,tingkat 4,0,0,0,,Aku seharusnya tidak mencintai tanpa menjaga diriku sendiri.
Dialogue: 0,0:49:34.97,0:49:36.32,Default,tingkat 4,0,0,0,,Aku berangkat
Dialog: 0,0:49:37.86,0:49:39.40,Default,tingkat 4,0,0,0,,dan saya akan menemukan diri saya sendiri.
Dialog: 0,0:49:53.28,0:49:54.61,Default,tingkat 4,0,0,0,,"Dunia Pasangan Menikah. Volume 1"
Dialog: 0,0:49:54.61,0:49:56.49,Default,tingkat 4,0,0,0,,Dasar bajingan!
Dialog: 0,0:49:57.65,0:49:58.72,Default,tingkat 4,0,0,0,,Selanjutnya.
Dialog: 0,0:49:59.95,0:50:01.18,Default,tingkat 4,0,0,0,,"Dunia Pasangan Menikah. Volume 2"
Dialog: 0,0:50:03.45,0:50:07.93,Default,jarak tembak 4,0,0,0,,Yang Mulia, maukah Anda pergi ke Aula Hijeongjong hari ini?
Dialog: 0,0:50:08.57,0:50:09.99,Default,tingkat 4,0,0,0,,Mungkin sebaiknya saya lewati hari ini?
Dialog: 0,0:50:13.07,0:50:16.03,Default,tingkat 4,0,0,0,,Cheoljong-ku akan sangat menunggu kedatanganku.
Dialogue: 0,0:50:19.57,0:50:22.65,Default,tier 4,0,0,0,,Siapa sangka\N saya begitu haus akan ilmu pengetahuan.
Dialog: 0,0:50:23.78,0:50:25.11,Default,menembak 4,0,0,0,,Satu halaman lagi.
Dialog: 0,0:50:36.36,0:50:39.40,Default,tingkat 4,0,0,0,,Kim Soyeon
Dialog: 0,0:50:42.47,0:50:45.99,Default,menembak 4,0,0,0,,Choljong, maaf, maaf. Saya hanya ingin membaca satu halaman
Dialog: 0,0:50:45.99,0:50:47.49,Default,tingkat 4,0,0,0,,tapi tidak bisa berhenti.
Dialog: 0,0:50:48.24,0:50:49.70,Default,tingkat 4,0,0,0,,Kenapa kamu belum ganti baju?
Dialog: 0,0:50:58.38,0:51:01.49,Default,tingkat 4,0,0,0,,Apa? Mengapa kamu memberikannya kepadaku?
Dialog: 0,0:51:02.18,0:51:06.72,Default,tingkat 4,0,0,0,,Bukankah kamu bilang aku harus mengembalikannya padamu jika aku ingin hidup?
Dialog: 0,0:51:12.59,0:51:17.32,Default,tingkat 4,0,0,0,,Kamu bisa menyakiti seseorang tanpa mengetahui kebenarannya.
Dialog: 0,0:51:18.47,0:51:20.36,Default,tingkat 4,0,0,0,,Saya sudah menunggu lama sekali,
Dialogue: 0,0:51:20.99,0:51:22.80,Default,tier 4,0,0,0,,untuk mengembalikan buku kepada pemiliknya.
Dialog: 0,0:51:32.24,0:51:33.68,Default,tingkat 4,0,0,0,,Maaf,
Dialog: 0,0:51:34.88,0:51:36.55,Default,tingkat 4,0,0,0,,bahwa saya tidak mengenali Anda.
Dialog: 0,0:51:39.36,0:51:40.72,Default,tingkat 4,0,0,0,,Dan kamu aku.
Dialog: 0,0:51:42.18,0:51:44.65,Default,tingkat 4,0,0,0,,Aku tidak jujur ​​padamu.
Dialog: 0,0:51:47.05,0:51:49.22,Default,tingkat 4,0,0,0,,Dia kembali ke pemiliknya setelah 8 tahun.
Dialog: 0,0:51:49.99,0:51:53.13,Default,tingkat 4,0,0,0,,Kita tidak bisa mendapatkan kembali waktu kita yang hilang.
Dialog: 0,0:51:55.40,0:51:56.97,Default,tingkat 4,0,0,0,,Namun
Dialog: 0,0:51:58.38,0:52:01.20,Default,tingkat 4,0,0,0,,Aku tidak akan pernah meninggalkanmu lagi.
Dialog: 0,0:52:07.11,0:52:10.59,Default,tingkat 4,0,0,0,,Tapi bagaimana kamu hidup
Dialog: 0,0:52:11.01,0:52:13.65,Default,tingkat 4,0,0,0,,selama delapan tahun ini?
Dialog: 0,0:52:14.82,0:52:18.80,Default,tingkat 4,0,0,0,,Saat itu kamu aneh, tapi tidak terlalu aneh.
Dialog: 0,0:52:19.36,0:52:21.22,Default,tingkat 4,0,0,0,,Apakah saya melewatkan sesuatu?
Dialog: 0,0:52:23.30,0:52:24.59,Default,tingkat 4,0,0,0,,Pertanyaan bagus.
Dialog: 0,0:52:40.89,0:52:42.76,Default,tingkat 4,0,0,0,,Kelihatannya bagus, meskipun saya tidak tahu apa itu.
Dialog: 0,0:52:45.03,0:52:46.26,Default,tingkat 4,0,0,0,,Ini obat.
Dialog: 0,0:52:47.50,0:52:49.70,Default,tingkat 4,0,0,0,,Semua yang kamu makan diam-diam pasti enak.
Dialog: 0,0:52:51.70,0:52:52.84,Default,tingkat 4,0,0,0,,Yogurt?
Dialog: 0,0:52:54.34,0:52:56.37,Default,tingkat 4,0,0,0,,-Bau alkohol.\N-Nah, itu...
Dialog: 0,0:52:57.64,0:52:58.91,Default,tingkat 4,0,0,0,,Ini anggur pir.
Dialog: 0,0:52:59.14,0:53:01.04,Default,tingkat 4,0,0,0,,Terbuat dari bunga pir
Dialog: 0,0:53:01.04,0:53:04.82,Default,tingkat 4,0,0,0,,dan minum saat aroma bunga berputar di udara.
Dialog: 0,0:53:05.82,0:53:06.98,Default,tingkat 4,0,0,0,,Maukah kamu menuangkan segelas?
Dialog: 0,0:53:07.15,0:53:08.65,Default,tingkat 4,0,0,0,,Saya hanya punya satu tersisa.
Dialogue: 0,0:53:08.65,0:53:11.66,Default,tier 4,0,0,0,,Pembuatannya membutuhkan banyak usaha, jadi saya menyimpannya.
Dialog: 0,0:53:11.66,0:53:13.16,Default,tingkat 4,0,0,0,,-Tetapi karena kamu...\N-Sial.
Dialog: 0,0:53:15.43,0:53:16.73,Default,tingkat 4,0,0,0,,Bagaimana cara membuatnya?
Dialog: 0,0:53:17.66,0:53:21.30,Default,tier 4,0,0,0,,Pertama, siapkan adonan dengan mencampurkan air dengan bubuk beras rendah lemak.
Dialogue: 0,0:53:21.30,0:53:24.03,Default,tier 4,0,0,0,,Kalau begitu mari kita pipihkan adonannya dan buat lubangnya.
Dialog: 0,0:53:24.03,0:53:25.80,Default,tingkat 4,0,0,0,,Membuat persiapan.
Dialog: 0,0:53:27.91,0:53:29.34,Default,tingkat 4,0,0,0,,Terlihat seperti donat.
Dialog: 0,0:53:32.68,0:53:33.68,Default,tingkat 4,0,0,0,,Lanjutkan.
Dialog: 0,0:53:33.68,0:53:36.95,Default,tingkat 4,0,0,0,,Jadi, masak dengan air panas, angkat,
Dialogue: 0,0:53:36.95,0:53:39.08,Default,tier 4,0,0,0,,uleni dan biarkan dingin.
Dialog: 0,0:53:39.88,0:53:42.82,Default,tingkat 4,0,0,0,,Ambil bunga pir dan ragi yang sudah disiapkan sebelumnya
Dialog: 0,0:53:42.82,0:53:44.56,Default,tingkat 4,0,0,0,,dan buat adonan lagi.
Dialog: 0,0:53:44.82,0:53:48.59,Default,tingkat 4,0,0,0,,Masukkan ke dalam kendi dan tutup.
Dialog: 0,0:53:48.59,0:53:50.96,Default,tingkat 4,0,0,0,,Dalam tiga hari...
Dialog: 0,0:53:50.96,0:53:52.10,Default,tingkat 4,0,0,0,,Bolehkah saya minum?
Dialog: 0,0:53:54.63,0:53:55.97,Default,tingkat 4,0,0,0,,Tentu saja tidak.
Dialog: 0,0:53:56.43,0:53:59.67,Default,tingkat 4,0,0,0,,Goyangkan.
Dialog: 0,0:53:59.67,0:54:01.47,Default,tingkat 4,0,0,0,,Dan setelah 20 hari
Dialog: 0,0:54:02.47,0:54:04.11,Default,tingkat 4,0,0,0,,Anda sudah bisa minum.
Dialog: 0,0:54:06.61,0:54:08.21,Default,tingkat 4,0,0,0,,Biarkan waktu berlalu.
Dialog: 0,0:54:08.88,0:54:10.61,Default,tingkat 4,0,0,0,,Minta cepat.
Dialog: 0,0:54:16.32,0:54:17.89,Default,tingkat 4,0,0,0,,Penasihat Kiri Kim Seok-keun
Dialog: 0,0:54:17.89,0:54:19.46,Default,tingkat 4,0,0,0,,bersama dengan pejabat setempat
Dialogue: 0,0:54:19.46,0:54:23.16,Default,tier 4,0,0,0,,menyalahgunakan tenaga kerja petani dan memalsukan catatan.
Dialog: 0,0:54:23.16,0:54:24.76,Default,tingkat 4,0,0,0,,Sehubungan dengan tuduhan pencurian
Dialog: 0,0:54:24.76,0:54:26.36,Default,tingkat 4,0,0,0,,dia akan dicopot dari posisinya,
Dialog: 0,0:54:26.36,0:54:28.57,Default,tingkat 4,0,0,0,,dan harta bendanya akan disita.
Dialog: 0,0:54:28.80,0:54:30.40,Default,tingkat 4,0,0,0,,Beraninya kamu!
Dialog: 0,0:54:32.97,0:54:35.44,Default,tingkat 4,0,0,0,,Jangan mendekat. Biarkan aku pergi!
Dialog: 0,0:54:35.84,0:54:37.71,Default,tingkat 4,0,0,0,,Lepaskan!
Dialog: 0,0:54:39.14,0:54:40.44,Default,tingkat 4,0,0,0,,Lepaskan tangan!
Dialog: 0,0:54:45.62,0:54:49.12,Default,tingkat 4,0,0,0,,Aku bahkan tidak bisa berpikir bahwa peringatan ratu bukanlah lelucon.
Dialog: 0,0:54:50.32,0:54:52.36,Default,tingkat 4,0,0,0,,Di tempat penasihat kiri
Dialog: 0,0:54:52.66,0:54:54.99,Default,tingkat 4,0,0,0,,Saya menunjuk ayah selir Min,
Dialog: 0,0:54:54.99,0:54:57.29,Default,tingkat 4,0,0,0,,Min Ujina dari klan Yohyn Min.
Dialogue: 0,0:54:57.29,0:54:59.10,Default,tingkat 4,0,0,0,,Pertimbangkan kembali keputusanmu.
Dialog: 0,0:54:59.10,0:55:01.60,Default,tingkat 4,0,0,0,,-Pertimbangkan kembali keputusan Anda.\N-Pertimbangkan kembali keputusan Anda.
Dialog: 0,0:55:16.45,0:55:17.88,Default,tingkat 4,0,0,0,,Percakapan akan singkat.
Dialog: 0,0:55:19.12,0:55:21.42,Default,tingkat 4,0,0,0,,Kapan kabupaten saya akan dipulihkan?
Dialog: 0,0:55:21.49,0:55:24.66,Default,tingkat 4,0,0,0,,Ini harus terjadi sebelum raja menghancurkan Joseon.
Dialog: 0,0:55:24.82,0:55:28.03,Default,tingkat 4,0,0,0,,Keluarga kami tidak akan kehilangan posisinya lagi.
Dialog: 0,0:55:28.59,0:55:30.69,Default,tingkat 4,0,0,0,,Lagi pula, kami sedang mengumpulkan pasukan,
Dialog: 0,0:55:30.89,0:55:33.16,Default,tingkat 4,0,0,0,,jadi raja tidak punya waktu lama lagi.
Dialog: 0,0:55:33.16,0:55:34.43,Default,tingkat 4,0,0,0,,Percepat.
Dialog: 0,0:55:34.43,0:55:36.70,Default,tingkat 4,0,0,0,,Saya tidak dikenal karena kesabaran saya.
Dialog: 0,0:55:36.97,0:55:38.07,Default,tingkat 4,0,0,0,,Ya.
Dialog: 0,0:55:38.57,0:55:42.17,Default,tingkat 4,0,0,0,,Ngomong-ngomong, aku mendengar sesuatu yang aneh.
Dialog: 0,0:55:43.71,0:55:47.24,Default,tingkat 4,0,0,0,,Bahwa ratu memperkenalkan raja pada cita-cita yang menghujat.
Dialog: 0,0:56:00.79,0:56:01.86,Default,tingkat 4,0,0,0,,Pada malam tanpa tidur aku berjalan.
Dialog: 0,0:56:01.86,0:56:02.93,Default,tingkat 4,0,0,0,,Cahaya menerobos langit malam yang gelap.
Dialog: 0,0:56:11.00,0:56:12.30,Default,tingkat 4,0,0,0,,
Dialog: 0,0:56:17.47,0:56:19.61,Default,tingkat 4,0,0,0,,
Dialog: 0,0:56:19.61,0:56:21.21,Default,tingkat 4,0,0,0,,Apakah dia masih memilikinya?
Dialog: 0,0:56:43.70,0:56:45.24,Default,tingkat 4,0,0,0,,Apakah mereka semua pengikut Tonhak?
Dialog: 0,0:56:45.80,0:56:46.80,Default,tingkat 4,0,0,0,,Ya.
Dialog: 0,0:56:46.80,0:56:50.71,Default,menembak 4,0,0,0,,-Keluar.\N-Ibu.
Dialog: 0,0:56:50.71,0:56:53.11,Default,tingkat 4,0,0,0,,Mengapa kamu mengambil anak itu?
Dialog: 0,0:56:53.41,0:56:55.58,Default,tingkat 4,0,0,0,,Mimpi! Mimpi!
Dialogue: 0,0:57:01.49,0:57:02.99,Default,,0,0,0,,Apakah kamu mengenali tulisan tangannya?
Dialog: 0,0:57:12.46,0:57:15.07,Default,,0,0,0,,Ini adalah sandi pengikut Tonhak.
Dialogue: 0,0:57:21.27,0:57:23.64,Default,,0,0,0,,Dalam perang, segala cara adalah adil.
Dialog: 0,0:57:23.64,0:57:24.94,Default,,0,0,0,,"Dana"? Apa maksudnya?
Dialog: 0,0:57:25.28,0:57:26.54,Default,,0,0,0,,Semacam pepatah?
Dialog: 0,0:57:26.88,0:57:29.78,Default,,0,0,0,,Sebuah granat bisa lebih efektif daripada 10 tentara.
Dialog: 0,0:57:30.15,0:57:32.15,Default,,0,0,0,,Sepertinya fiksi.
Dialog: 0,0:57:32.15,0:57:33.18,Default,,0,0,0,,Omong-omong,
Dialog: 0,0:57:33.35,0:57:36.32,Default,,0,0,0,,Saya ingat 15 sesi latihan di sini.
Dialogue: 0,0:57:36.49,0:57:39.66,Default,,0,0,0,,Kedengarannya masuk akal, "granat".
Dialog: 0,0:57:42.26,0:57:44.69,Default,,0,0,0,,Jika kamu memasukkan bubuk mesiu ke dalam tas seperti itu dan membuangnya,
Dialogue: 0,0:57:44.69,0:57:47.16,Default,,0,0,0,,dia akan meledak seperti itu.
Dialog: 0,0:57:48.10,0:57:49.33,Default,,0,0,0,,Kami punya ini.
Dialog: 0,0:57:49.93,0:57:51.27,Default,,0,0,0,,Bom eksplosif.
Dialog: 0,0:57:51.87,0:57:54.54,Default,,0,0,0,,Benarkah? Apakah Anda memiliki rompi antipeluru?
Dialogue: 0,0:57:55.47,0:57:56.91,Default,,0,0,0,,Pakaian antipeluru?
Dialogue: 0,0:57:57.31,0:57:58.71,Default,,0,0,0,,Maksudmu armor?
Dialogue: 0,0:57:59.24,0:58:01.38,Default,,0,0,0,,Tidak, dipakai di bawah armor.
Dialog: 0,0:58:02.78,0:58:03.85,Default,,0,0,0,,Begitulah adanya.
Dialog: 0,0:58:05.45,0:58:06.85,Default,,0,0,0,,Hon!
Dialog: 0,0:58:08.55,0:58:11.35,Default,,0,0,0,,Saya lewat, dan lampu menyala.
Dialogue: 0,0:58:11.96,0:58:13.42,Default,,0,0,0,,Senang melihatnya.
Dialogue: 0,0:58:15.16,0:58:18.30,Default,,0,0,0,,Kamu bersenang-senang tanpa aku di sini.
Dialog: 0,0:58:18.60,0:58:20.50,Default,,0,0,0,,Aku tidak percaya aku tidak diundang.
Dialog: 0,0:58:25.07,0:58:26.24,Default,,0,0,0,,-Apa yang kamu bicarakan.\N-Tuhan!
Dialog: 0,0:58:26.80,0:58:27.97,Default,,0,0,0,,Lee Senman!
Dialog: 0,0:58:28.57,0:58:30.61,Default,,0,0,0,,Langsung!
Dialogue: 0,0:58:33.38,0:58:35.11,Default,,0,0,0,,Betapa khawatirnya aku.
Dialog: 0,0:58:36.45,0:58:38.68,Default,,0,0,0,,Akhirnya kita bertemu. Benar-benar!
Dialogue: 0,0:58:40.85,0:58:43.19,Default,,0,0,0,,Aku juga senang bertemu denganmu.
Dialog: 0,0:58:43.19,0:58:45.62,Default,,0,0,0,,Tidak pernah kembali ke Okthajeong?
Dialogue: 0,0:58:45.62,0:58:47.12,Default,,0,0,0,,Aku minum banyak anggur
Dialog: 0,0:58:47.12,0:58:50.33,Default,,0,0,0,,di sana, berharap bertemu denganmu.
Dialog: 0,0:58:50.86,0:58:52.13,Default,,0,0,0,,Lee Senman!
Dialog: 0,0:58:58.00,0:59:01.10,Default,,0,0,0,,Lepaskan tangan. Mungkin Anda bisa memperkenalkan diri terlebih dahulu?
Dialog: 0,0:59:01.77,0:59:03.34,Default,,0,0,0,,Siapa kamu?
Dialog: 0,0:59:03.51,0:59:07.08,Default,,0,0,0,,Saya teman dekat Lee Sanman.
Dialog: 0,0:59:07.94,0:59:10.08,Default,,0,0,0,,"Teman"? saya...
Dialogue: 0,0:59:10.71,0:59:12.98,Default,,0,0,0,,-Anda...\N-I...
Dialog: 0,0:59:14.55,0:59:17.05,Default,,0,0,0,,Tunggu sebentar. Wajahnya agak familiar.
Dialogue: 0,0:59:18.39,0:59:20.92,Default,,0,0,0,,Temanku, Jeong Chul.
Dialog: 0,0:59:21.16,0:59:22.23,Default,,0,0,0,,Mengapa...
Dialogue: 0,0:59:23.36,0:59:24.93,Default,,0,0,0,,Lalu siapa kamu?
Dialog: 0,0:59:25.46,0:59:26.70,Default,,0,0,0,,Saya Jeong Chul.
Dialog: 0,0:59:30.23,0:59:33.47,Default,,0,0,0,,Ya! Kemenangan!
Dialog: 0,0:59:35.31,0:59:38.44,Default,,0,0,0,,Apa yang perlu kamu lakukan untuk bermain seperti ini?
Dialogue: 0,0:59:39.88,0:59:41.78,Default,,0,0,0,,Katakanlah, masa muda yang terbuang.
Dialog: 0,0:59:42.35,0:59:43.98,Default,,0,0,0,,Tepat sekali temanku.
Dialog: 0,0:59:44.28,0:59:46.35,Default,,0,0,0,,Kita sangat mirip.
Dialog: 0,0:59:46.35,0:59:49.29,Default,,0,0,0,,Ya Tuhan, sepertinya ini tempat yang bagus.
Dialogue: 0,0:59:49.72,0:59:51.69,Default,,0,0,0,,Mungkin kamu menyembunyikan kartunya di suatu tempat?
Dialogue: 0,0:59:52.02,0:59:54.49,Default,,0,0,0,,Sulit mendapatkan kartu truf.
Dialog: 0,0:59:54.49,0:59:55.93,Default,,0,0,0,,Jangan salahkan dirimu atas kesalahanmu
Dialogue: 0,0:59:55.93,0:59:57.59,Default,,0,0,0,,keberuntunganku.
Dialog: 0,0:59:57.93,0:59:59.56,Default,,0,0,0,,Baiklah, mari kita lanjutkan.
Dialog: 0,0:59:59.93,1:00:02.07,Default,,0,0,0,,Yang kalah mendapatkan keinginannya.
Dialog: 0,1:00:05.80,1:00:07.54,Default,,0,0,0,,Perhatikan topimu.
Dialog: 0,1:00:08.44,1:00:09.57,Default,,0,0,0,,Insider.
Dialog: 0,1:00:12.71,1:00:13.74,Default,,0,0,0,,Orang Luar.
Dialog: 0,1:00:15.61,1:00:18.11,Default,,0,0,0,,Dan pengikut keyakinannya, seperti saya.
Dialog: 0,1:00:18.78,1:00:20.25,Default,,0,0,0,,Aliansi yang luar biasa.
Dialogue: 0,1:00:37.63,1:00:38.87,Default,,0,0,0,,saya bantu.
Dialog: 0,1:00:43.07,1:00:44.61,Default,,0,0,0,,Semua berkat noltwigs.
Dialog: 0,1:00:47.71,1:00:49.18,Default,,0,0,0,,Saya yakin akan kemenangan saya.
Dialog: 0,1:01:13.34,1:01:15.97,Default,,0,0,0,,Aku tidak percaya mereka menggunakan itu
Dialog: 0,1:01:15.97,1:01:18.24,Default,,0,0,0,,untuk menggeser penasihat kiri.
Dialogue: 0,1:01:19.81,1:01:24.28,Default,,0,0,0,,Jadi... Aku yakin mereka punya buku besarnya.
Dialog: 0,1:01:25.55,1:01:27.68,Default,,0,0,0,,Sekarang pertempuran sesungguhnya dimulai.
Dialog: 0,1:01:28.25,1:01:29.25,Default,,0,0,0,,Apa?
Dialogue: 0,1:01:30.65,1:01:33.29,Default,,0,0,0,,Mari kita mulai bersih-bersih sebelum pertumpahan darah.
Dialog: 0,1:01:34.59,1:01:36.56,Default,,0,0,0,,Jika kamu tidak ingin terjebak dalam hal ini,
Dialog: 0,1:01:37.09,1:01:40.70,Default,,0,0,0,,kesampingkan keserakahanmu dan bersiaplah untuk menumpahkan darah.
Dialogue: 0,1:01:41.56,1:01:42.87,Default,,0,0,0,,Tumpahkan darah?
Dialog: 0,1:01:44.80,1:01:47.27,Default,,0,0,0,,Mereka yang menjual pekerjaan pemerintah,
Dialog: 0,1:01:47.27,1:01:49.47,Default,,0,0,0,,akan mengundurkan diri atas kemauannya sendiri.
Dialog: 0,1:01:51.04,1:01:52.31,Default,,0,0,0,,Jika kamu menjadi kaya dari biji-bijian
Dialog: 0,1:01:52.31,1:01:53.54,Default,,0,0,0,,atau pada hadiah,
Dialog: 0,1:01:53.54,1:01:54.84,Default,,0,0,0,,kembalikan semua.
Dialog: 0,1:01:56.31,1:01:58.31,Default,,0,0,0,,Dan urus itu
Dialog: 0,1:01:59.22,1:02:02.62,Default,,0,0,0,,yang menyimpan semua catatan dan mengetahui segalanya.
Dialog: 0,1:02:02.62,1:02:03.62,Default,,0,0,0,,Surat Bunuh Diri
Dialog: 0,1:02:03.62,1:02:04.69,Default,,0,0,0,,Itu,
Dialog: 0,1:02:06.72,1:02:09.73,Default,,0,0,0,,yang tidak membersihkan dirinya sendiri dan meninggalkan jejak,
Dialog: 0,1:02:11.46,1:02:13.83,Default,,0,0,0,,harus menjawab semuanya.
Dialog: 0,1:02:18.57,1:02:20.67,Default,,0,0,0,,Meskipun aku menggulingkan klan Kim,
Dialog: 0,1:02:20.67,1:02:22.71,Default,,0,0,0,,Kekuatan Kim Byonin semakin menguat.
Dialog: 0,1:02:23.34,1:02:25.64,Default,,0,0,0,,Rasanya tidak ada kemajuan.
Dialog: 0,1:02:25.64,1:02:27.71,Default,,0,0,0,,Kita perlu menemukan sesuatu pada Kim Byonin.
Dialog: 0,1:02:28.55,1:02:31.05,Default,,0,0,0,,Sepertinya dia membantu seseorang dengan pegawai negeri,
Dialog: 0,1:02:31.05,1:02:34.22,Default,,0,0,0,,tetapi kamu tidak dapat menangkapnya jika dia tidak mendapatkan imbalan apa pun.
Dialog: 0,1:02:34.22,1:02:37.72,Default,,0,0,0,,Dan sepertinya tidak seperti itu sama sekali.
Dialog: 0,1:02:40.72,1:02:42.86,Default,,0,0,0,,Dan mereka yang dia bantu,
Dialog: 0,1:02:42.86,1:02:44.43,Default,,0,0,0,,sangat berterima kasih padanya,
Dialog: 0,1:02:45.36,1:02:46.93,Default,,0,0,0,,kita tidak akan bisa memancing mereka pergi.
Dialog: 0,1:02:46.93,1:02:49.20,Default,,0,0,0,,Dia membangun benteng yang tak terkalahkan.
Dialog: 0,1:02:58.41,1:02:59.71,Default,,0,0,0,,Anda sudah berada di sini.
Dialog: 0,1:03:01.91,1:03:03.31,Default,,0,0,0,,Apakah Lee Senman belum sampai?
Dialog: 0,1:03:04.55,1:03:05.62,Default,,0,0,0,,Oh, tunggu.
Dialog: 0,1:03:06.35,1:03:09.02,Default,,0,0,0,,Harus saya katakan, dia sangat rajin.
Dialog: 0,1:03:09.52,1:03:11.59,Default,,0,0,0,,Setiap hari dia datang untuk bermain bersama kami di tudzhon.
Dialog: 0,1:03:15.46,1:03:16.99,Default,,0,0,0,,Apakah kamu tidak punya pekerjaan?
Dialog: 0,1:03:17.23,1:03:18.60,Default,,0,0,0,,Ini pekerjaanku.
Dialog: 0,1:03:19.13,1:03:20.96,Default,,0,0,0,,Bagaimana ini bisa berhasil?
Dialog: 0,1:03:21.76,1:03:23.63,Default,,0,0,0,,Hei, aku bertanya.
Dialog: 0,1:03:40.65,1:03:44.82,Default,,0,0,0,,Hari ini seolah kau milikku,
Dialog: 0,1:03:44.82,1:03:49.13,Default,,0,0,0,,tapi kamu bukan milikku.
Dialog: 0,1:04:24.33,1:04:25.90,Default,,0,0,0,,Salam.
Dialog: 0,1:04:33.94,1:04:39.61,Default,,0,0,0,,Saya datang untuk mengeluh tentang ratu.
Dialog: 0,1:04:39.61,1:04:41.14,Default,,0,0,0,,Ya, saya juga.
Dialog: 0,1:04:42.25,1:04:43.78,Default,,0,0,0,,Baiklah, Anda mulai.
Dialog: 0,1:04:45.22,1:04:46.22,Default,,0,0,0,,Oke.
Dialog: 0,1:04:49.95,1:04:52.29,Default,,0,0,0,,Yang Mulia!
Dialog: 0,1:04:52.76,1:04:56.76,Default,,0,0,0,,Berhenti membuatku marah!
Dialog: 0,1:05:02.30,1:05:06.10,Default,,0,0,0,,Jika kamu melanjutkan, wajahmu akan bergetar karena kotoran.
Dialog: 0,1:05:08.84,1:05:09.91,Default,,0,0,0,,Oh, sayang.
Dialog: 0,1:05:10.77,1:05:13.38,Default,,0,0,0,,Jarang bertemu seseorang yang bersumpah lebih baik dariku.
Dialog: 0,1:05:13.78,1:05:16.38,Default,,0,0,0,,Tapi izinkan saya memberi Anda beberapa saran. Jika Anda menghembuskan napas dari sini...
Dialogue: 0,1:05:17.75,1:05:19.15,Default,,0,0,0,,Canggung sekali.
Dialog: 0,1:05:20.92,1:05:23.32,Default,,0,0,0,,-Nah, sudah waktunya saya melakukan pemanasan juga.\N-Oke.
Dialogue: 0,1:05:25.32,1:05:28.22,Default,,0,0,0,,Bagianmu... Kau mengejutkanku.
Dialog: 0,1:05:33.16,1:05:34.33,Default,,0,0,0,,Di sini saya akan bertanya kepada Anda!
Dialog: 0,1:05:39.40,1:05:40.40,Default,,0,0,0,,Tuhan.
Dialog: 0,1:05:43.47,1:05:45.44,Default,,0,0,0,,-Mungkin bersama-sama?\N-Tentu saja.
Dialog: 0,1:05:47.61,1:05:49.58,Default,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,1:06:08.40,1:06:11.07,Default,,0,0,0,,Aku cinta kamu, anggurku!
Dialog: 0,1:06:11.07,1:06:13.60,Default,,0,0,0,,Kamu luar biasa, anggurku!
Dialog: 0,1:06:15.37,1:06:17.17,Default,,0,0,0,,Itu dia.
Dialogue: 0,1:06:17.17,1:06:18.61,Default,,0,0,0,,Coba juga.
Dialog: 0,1:06:19.18,1:06:21.21,Default,,0,0,0,,Di bagian bawah. Ini dia.
Dialog: 0,1:06:24.75,1:06:25.82,Default,,0,0,0,,Dan untukmu.
Dialog: 0,1:06:26.98,1:06:28.95,Default,,0,0,0,,Warnanya indah sekali, ratu.
Dialogue: 0,1:06:29.32,1:06:31.19,Default,,0,0,0,,Dan aromanya enak sekali.
Dialog: 0,1:06:32.49,1:06:34.89,Default,,0,0,0,,Tetap. Eksposur sempurna.
Dialogue: 0,1:06:35.79,1:06:39.10,Default,,0,0,0,,Apa yang kalian berdua lakukan hingga kehilangan suara?
Dialog: 0,1:06:45.20,1:06:46.50,Default,,0,0,0,,Mari kita lihat.
Dialog: 0,1:06:49.24,1:06:51.14,Default,,0,0,0,,-Yang Mulia!\N-Yang Mulia.
Dialog: 0,1:06:51.21,1:06:52.78,Default,,0,0,0,,Apakah karena saya tidak makan apa pun?
Dialog: 0,1:06:53.98,1:06:59.35,Default,,0,0,0,,Maka ini untuk hidangan penutup!
Dialog: 0,1:06:59.88,1:07:02.49,Default,,0,0,0,,Aku akan kembali padamu, anggurku!
Dialog: 0,1:07:02.49,1:07:05.89,Default,,0,0,0,,Anggurku yang enak!
Dialog: 0,1:07:09.03,1:07:10.29,Default,,0,0,0,,Dari kelopak pir yang mekar.
Dialog: 0,1:07:11.29,1:07:14.13,Default,,0,0,0,,Saya berlari ke sini karena saya ingin memberikan ini kepada Anda secara pribadi.
Dialog: 0,1:07:14.63,1:07:16.37,Default,,0,0,0,,Akhirnya, bukunya siap.
Dialog: 0,1:07:23.04,1:07:24.24,Default,,0,0,0,,"Direktori Pelatihan Militer"?
Dialog: 0,1:07:24.91,1:07:26.14,Default,,0,0,0,,Nama bagus.
Dialog: 0,1:07:26.31,1:07:27.61,Default,,0,0,0,,Semua terima kasih.
Dialog: 0,1:07:28.58,1:07:30.75,Default,,0,0,0,,Ya, saya baru saja memberi tahu Anda apa yang saya lihat.
Dialog: 0,1:07:32.98,1:07:34.28,Default,,0,0,0,,Di halaman berikutnya.
Dialog: 0,1:07:35.42,1:07:36.62,Default,,0,0,0,,Pada hari itu, Anggota Dewan Yang Terhormat...
Dialog: 0,1:07:38.52,1:07:41.92,Default,,0,0,0,,Dia mengompol setiap kali melihat gambar ini.
Dialog: 0,1:07:43.26,1:07:45.26,Default,,0,0,0,,Ya, gambar di sini tampak bagus.
Dialogue: 0,1:07:49.53,1:07:50.63,Default,,0,0,0,,Ratuku.
Dialog: 0,1:07:52.57,1:07:54.00,Default,,0,0,0,,Apakah kamu kesepian?
Dialog: 0,1:07:57.77,1:08:00.44,Default,,0,0,0,,Aku tidak hidup lama sebagai rakyat jelata, tapi tetap saja
Dialog: 0,1:08:01.34,1:08:03.21,Default,,0,0,0,,berjuang dengan kesepian
Dialog: 0,1:08:03.21,1:08:05.05,Default,,0,0,0,,dan sulit bagi saya untuk beradaptasi ketika saya sampai di sini.
Dialog: 0,1:08:06.92,1:08:09.85,Default,,0,0,0,,Tapi kamu sangat tidak biasa,\Nkamu seharusnya lebih kesepian.
Dialog: 0,1:08:10.49,1:08:11.95,Default,,0,0,0,,Saya khawatir.
Dialog: 0,1:08:12.69,1:08:14.46,Default,,0,0,0,,Saya tidak punya waktu untuk sendirian.
Dialog: 0,1:08:14.66,1:08:17.23,Default,,0,0,0,,Kesulitan setiap hari dan berlarian.
Dialog: 0,1:08:28.17,1:08:31.21,Default,,0,0,0,,Seseorang bahkan memulai kamus untuk memahami saya lebih baik.
Dialog: 0,1:08:31.81,1:08:33.78,Default,,0,0,0,,Berkat dia, aku tidak merasa kesepian sama sekali.
Dialog: 0,1:08:47.39,1:08:48.72,Default,,0,0,0,,Apakah sudah waktunya makan ramen?
Dialog: 0,1:08:52.13,1:08:54.30,Default,,0,0,0,,Boleh kubilang atau tidak?
Dialog: 0,1:08:54.66,1:08:55.80,Default,,0,0,0,,Ya Tuhan!
Dialog: 0,1:09:00.87,1:09:03.27,Default,,0,0,0,,Ini tidak disengaja. Saya merasa sakit.
Dialog: 0,1:09:06.31,1:09:09.48,Default,,0,0,0,,Segera hubungi tabib kerajaan.
Dialog: 0,1:09:42.78,1:09:44.18,Default,,0,0,0,,Ada yang serius?
Dialog: 0,1:09:47.45,1:09:49.15,Default,,0,0,0,,Ratu sedang hamil.
Dialog: 0,1:09:52.12,1:09:53.52,Default,,0,0,0,,Apa? Hamil?
Dialog: 0,1:09:56.36,1:09:57.53,Default,,0,0,0,,Apakah saya hamil?
Dialog: 0,1:10:01.26,1:10:03.77,Default,,0,0,0,,Selamat, Yang Mulia.
Dialogue: 0,1:10:10.21,1:10:11.57,Default,,0,0,0,,Ratuku, terima kasih.
Dialog: 0,1:10:20.48,1:10:23.65,Default,,0,0,0,,-Selamat, Yang Mulia!\N-Selamat, Yang Mulia!
Dialog: 0,1:10:26.46,1:10:28.56,Default,,0,0,0,,Aku akan menjadi seorang ayah!
Dialog: 0,1:10:49.48,1:10:50.68,Default,,0,0,0,,I
Dialog: 0,1:10:52.98,1:10:54.78,Default,,0,0,0,,hamil?
Dialog: 0,1:10:59.49,1:11:03.76,Default,,0,0,0,,Bagaimana aku menjadi ratu
Dialog: 0,1:11:23.55,1:11:25.82,Default,,0,0,0,,Apakah saya hamil?
Dialog: 0,1:11:25.82,1:11:28.95,Default,,0,0,0,,Sekolah ibu hamil yang sebenarnya dimulai hari ini.
Dialog: 0,1:11:28.95,1:11:31.79,Default,,0,0,0,,Kamu harus menolak hidangan yang tidak biasa seperti itu.
Dialog: 0,1:11:31.79,1:11:34.69,Default,,0,0,0,,Saya berasumsi Anda menyebarkan rumor seperti yang saya perintahkan?
Dialogue: 0,1:11:34.69,1:11:36.29,Default,,0,0,0,,Mereka sebenarnya tidak tidur bersama.
Dialog: 0,1:11:36.29,1:11:38.46,Default,,0,0,0,,Apa yang salah dengan posenya? Canggung sekali.
Dialog: 0,1:11:38.46,1:11:40.33,Default,,0,0,0,,Ini tidak cukup untuk meredam rumor tersebut.
Dialog: 0,1:11:40.33,1:11:41.76,Default,,0,0,0,,Jika kamu bilang begitu...
Dialog: 0,1:11:41.83,1:11:44.07,Default,,0,0,0,,Apa yang diyakini semua orang menjadi kenyataan.
Dialog: 0,1:11:44.07,1:11:46.60,Default,,0,0,0,,Pertama bawakan aku kepala ratu.
Dialog: 0,1:11:46.60,1:11:47.97,Default,,0,0,0,,Ini adalah perintah.
Dialog: 0,1:11:47.97,1:11:50.24,Default,,0,0,0,,Jika aku ingin hidup, semua orang di sekitarku akan mati.
Dialog: 0,1:11:50.24,1:11:51.84,Default,,0,0,0,,Jadi aku akan menerima semuanya.
Dialog: 0,0:14:45.74,0:14:47.74,Default,,0,0,0,,


