Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Host, Nanas
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.09,0:01:06.37,Default,nanas 1,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.37,0:01:08.54,Default,nanas 1,0,0,0,,dan kejadian yang ditampilkan adalah fiksi.
Dialog: 0,0:01:10.32,0:01:13.13,Default,nanas 1,0,0,0,,18 episode
Dialog: 0,0:01:14.74,0:01:15.81,Default,nanas 1,0,0,0,,Tunggu!
Dialogue: 0,0:01:16.41,0:01:17.71,Default,nanas 1,0,0,0,,Stop!
Dialog: 0,0:01:24.01,0:01:25.08,Default,nanas 1,0,0,0,,Ayo berangkat.
Dialog: 0,0:01:27.72,0:01:30.79,Default,nanas 1,0,0,0,,Berhenti! Tunggu!
Dialog: 0,0:01:37.09,0:01:38.13,Default,nanas 1,0,0,0,,Mengapa?
Dialogue: 0,0:01:47.74,0:01:49.81,Default,nanas 1,0,0,0,,Apakah raja datang kepadaku ketika aku sedang tidur?
Dialog: 0,0:01:50.41,0:01:51.68,Default,nanas 1,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:01:52.48,0:01:53.71,Default,nanas 1,0,0,0,,Itu bukan mimpi.
Dialogue: 0,0:01:54.44,0:01:56.68,Default,pineapple 1,0,0,0,,Tapi kenapa dia bersikap seperti ini?
Dialog: 0,0:01:56.68,0:01:57.95,Default,nanas 1,0,0,0,,Seolah-olah ada yang mengejarnya.
Dialog: 0,0:01:59.28,0:02:01.42,Default,nanas 1,0,0,0,,Donghak menjadi semakin berpengaruh.
Dialog: 0,0:02:03.12,0:02:04.86,Default,nanas 1,0,0,0,,Saya mengerti, tapi tetap saja...
Dialog: 0,0:02:05.02,0:02:06.99,Default,nanas 1,0,0,0,,Jangan khawatir, Yang Mulia.
Dialog: 0,0:02:07.36,0:02:10.13,Default,nanas 1,0,0,0,,Benar, raja akan segera kembali.
Dialog: 0,0:02:11.23,0:02:12.26,Default,nanas 1,0,0,0,,Oke.
Dialogue: 0,0:02:13.23,0:02:15.50,Default,nanas 1,0,0,0,,Pasti ada alasan mengapa dia pergi begitu cepat.
Dialog: 0,0:02:17.67,0:02:19.44,Default,nanas 1,0,0,0,,Pastikan semuanya baik-baik saja,\Ndan kembali lagi.
Dialog: 0,0:02:19.74,0:02:22.64,Default,nanas 1,0,0,0,,Tentu saja, lebih baik cepat pergi daripada menunggu sampai aku datang untuk mengucapkan selamat tinggal padanya.
Dialog: 0,0:02:23.57,0:02:25.44,Default,nanas 1,0,0,0,,Itu sebabnya dia pergi tanpa peringatan.
Dialog: 0,0:02:36.92,0:02:39.59,Default,nanas 1,0,0,0,,Tahta ini sekarang mempunyai pemilik baru.
Dialog: 0,0:02:41.09,0:02:43.49,Default,nanas 1,0,0,0,,Anda bisa langsung mengetahuinya.
Dialog: 0,0:02:43.86,0:02:46.66,Default,nanas 1,0,0,0,,Semua karena ratu membuat pilihan yang tepat.
Dialog: 0,0:02:49.00,0:02:50.10,Default,nanas 1,0,0,0,,Ratu?
Dialog: 0,0:02:50.43,0:02:52.20,Default,nanas 1,0,0,0,,Demi anakmu
Dialog: 0,0:02:52.20,0:02:54.74,Default,nanas 1,0,0,0,,dia memihak keluarga, bukan raja.
Dialog: 0,0:02:55.71,0:02:58.24,Default,nanas 1,0,0,0,,Jika demikian, maka demi pewaris takhta
Dialog: 0,0:02:59.88,0:03:02.35,Default,nanas 1,0,0,0,,Aku akan menutup mata terhadap dosa ratu.
Dialog: 0,0:03:04.98,0:03:09.02,Default,nanas 1,0,0,0,,Saya akan pastikan Anda tidak perlu khawatir lagi memperebutkan takhta.
Dialogue: 0,0:05:21.55,0:05:23.09,Default,nanas 1,0,0,0,,Menyerah.
Dialog: 0,0:06:09.03,0:06:10.40,Default,nanas 1,0,0,0,,Saya ingin lebih.
Dialog: 0,0:06:12.37,0:06:14.37,Default,nanas 1,0,0,0,,Apakah kamu tidak makan banyak?
Dialog: 0,0:06:14.91,0:06:17.07,Default,nanas 1,0,0,0,,Seseorang terbiasa dengan segalanya.
Dialogue: 0,0:06:17.07,0:06:19.28,Default,nanas 1,0,0,0,,Dulu makanannya hambar,
Dialog: 0,0:06:19.28,0:06:20.64,Default,nanas 1,0,0,0,,tapi sekarang saya menyukainya.
Dialogue: 0,0:06:20.78,0:06:22.45,Default,nanas 1,0,0,0,,Tidak peduli berapa banyak kita makan, kita tidak akan merasa cukup.
Dialog: 0,0:06:22.45,0:06:24.11,Default,nanas 1,0,0,0,,Sebaliknya, kelaparan semakin parah.
Dialog: 0,0:06:25.15,0:06:26.88,Default,nanas 1,0,0,0,,Pangeran Kecil itu pelahap.
Dialog: 0,0:06:36.43,0:06:38.26,Default,nanas 1,0,0,0,,Oke. Saya tidak akan melakukannya lagi.
Dialog: 0,0:06:38.26,0:06:40.70,Default,nanas 1,0,0,0,,Semuanya baik-baik saja bagiku.\NKenapa kamu terlihat seperti itu?
Dialogue: 0,0:06:41.70,0:06:44.77,Default,nanas 1,0,0,0,,Kamu perlu jalan-jalan.\NIbaik untuk pencernaan.
Dialogue: 0,0:06:45.87,0:06:47.17,Default,pineapple 1,0,0,0,,Tapi aku selesaikan dulu.
Dialogue: 0,0:07:00.58,0:07:02.55,Default,nanas 1,0,0,0,,Cuacanya buruk sekali.
Dialog: 0,0:07:05.69,0:07:07.46,Default,nanas 1,0,0,0,,Saya ingin mengambil gambar dan menaruhnya dalam bingkai dan menggantungnya di dinding.
Dialog: 0,0:07:09.59,0:07:11.29,Default,nanas 1,0,0,0,,Belum terlambat untuk menyelesaikannya
Dialog: 0,0:07:11.60,0:07:13.23,Default,nanas 1,0,0,0,,semua kesalahpahaman.
Dialog: 0,0:07:14.30,0:07:15.87,Default,nanas 1,0,0,0,,Mari kita hidup sesuai keinginanmu.
Dialog: 0,0:07:17.80,0:07:18.87,Default,nanas 1,0,0,0,,Jarak sosial.
Dialogue: 0,0:07:20.27,0:07:22.64,Default,nanas 1,0,0,0,,Kamu adalah anti-penggemar sejatiku.
Dialog: 0,0:07:23.97,0:07:27.48,Default,nanas 1,0,0,0,,Saya khawatir, tapi sekarang saya menemukan jalan keluarnya.
Dialog: 0,0:07:27.48,0:07:28.91,Default,nanas 1,0,0,0,,Jadi jangan cintai aku.
Dialogue: 0,0:07:28.91,0:07:30.78,Default,nanas 1,0,0,0,,Tapi aku tetap menyukainya.
Dialog: 0,0:07:30.78,0:07:33.85,Default,nanas 1,0,0,0,,Dan aku akan senang, biarkan kamu memilikinya
Dialog: 0,0:07:34.62,0:07:36.12,Default,nanas 1,0,0,0,,semua kekurangan dunia.
Dialog: 0,0:07:38.19,0:07:39.72,Default,nanas 1,0,0,0,,Mau tak mau aku memikirkan dia!
Dialogue: 0,0:07:39.96,0:07:41.56,Default,nanas 1,0,0,0,,Tempat jelek! Ayo cepat pergi!
Dialog: 0,0:07:41.56,0:07:42.59,Default,nanas 1,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:07:46.16,0:07:47.46,Default,nanas 1,0,0,0,,Nyaris berhasil.
Dialog: 0,0:07:48.10,0:07:50.20,Default,nanas 1,0,0,0,,Bukan danau, tapi jurang kenangan.
Dialog: 0,0:08:02.18,0:08:05.25,Default,nanas 1,0,0,0,,Maka hari ini adalah hari pertama kita.
Dialog: 0,0:08:05.95,0:08:07.28,Default,nanas 1,0,0,0,,Saya mengusulkan aliansi.
Dialog: 0,0:08:10.59,0:08:11.76,Default,nanas 1,0,0,0,,Oke.
Dialog: 0,0:08:13.92,0:08:17.13,Default,nanas 1,0,0,0,,Tidak ada jarak sosial mulai sekarang.
Dialog: 0,0:08:26.44,0:08:27.90,Default,nanas 1,0,0,0,,Astaga.
Dialog: 0,0:08:28.74,0:08:31.37,Default,nanas 1,0,0,0,,Ya, seluruh istana ini adalah satu kenangan yang berkelanjutan.
Dialogue: 0,0:08:33.78,0:08:35.55,Default,nanas 1,0,0,0,,Mengapa orangnya sedikit sekali?
Dialogue: 0,0:08:36.45,0:08:38.25,Default,nanas 1,0,0,0,,Sudah berapa lama istana ini menjadi begitu besar?
Dialogue: 0,0:08:46.65,0:08:49.95,Default,nanas 1,0,0,0,,Memories Strike Back
Dialog: 0,0:08:52.90,0:08:54.26,Default,nanas 1,0,0,0,,Yang Mulia.
Dialog: 0,0:09:01.27,0:09:04.74,Default,nanas 1,0,0,0,,Yang Mulia,\NMenteri Perang telah mendatangi Anda.
Dialog: 0,0:09:07.21,0:09:09.28,Default,nanas 1,0,0,0,,Aku tidak menemukanmu di kamarmu.
Dialogue: 0,0:09:12.15,0:09:14.28,Default,nanas 1,0,0,0,,Apa terjadi sesuatu pada raja?
Dialog: 0,0:09:14.68,0:09:15.75,Default,nanas 1,0,0,0,,Tidak.
Dialog: 0,0:09:20.96,0:09:23.26,Default,nanas 1,0,0,0,,Kamu berdarah!
Dialog: 0,0:09:25.40,0:09:26.73,Default,nanas 1,0,0,0,,Menyakiti diri sendiri di suatu tempat?
Dialog: 0,0:09:27.06,0:09:30.53,Default,nanas 1,0,0,0,,Hanya cedera ringan\Nsetelah latihan.
Dialog: 0,0:09:31.84,0:09:34.77,Default,nanas 1,0,0,0,,Saya tahu ini sudah terlambat,\Ntapi saya datang untuk mengucapkan selamat atas kehamilan Anda.
Dialog: 0,0:09:36.64,0:09:37.84,Default,nanas 1,0,0,0,,Terima kasih.
Dialog: 0,0:09:37.84,0:09:41.34,Default,nanas 1,0,0,0,,Jangan berpikir untuk bergabung kembali dengan klan
Dialog: 0,0:09:41.34,0:09:44.05,Default,nanas 1,0,0,0,,untuk kesejahteraan anak Anda?
Dialog: 0,0:09:45.35,0:09:47.22,Default,nanas 1,0,0,0,,Saya pikir kita sudah membahas semuanya terakhir kali.
Dialog: 0,0:09:47.65,0:09:49.79,Default,nanas 1,0,0,0,,Aku tidak peduli kamu meninggalkanku.
Dialog: 0,0:09:50.72,0:09:52.86,Default,nanas 1,0,0,0,,Aku tetap tidak akan meninggalkanmu sepenuhnya tanpa bantuan.
Dialog: 0,0:09:53.09,0:09:54.32,Default,nanas 1,0,0,0,,Kamu dan dirimu sendiri
Dialog: 0,0:09:55.13,0:09:57.99,Default,nanas 1,0,0,0,,kamu tahu bahwa kamu tidak bisa bertahan sendirian di istana.
Dialog: 0,0:09:59.63,0:10:02.90,Default,nanas 1,0,0,0,,Terima kasih atas sarannya, tapi saya tidak sendirian.
Dialog: 0,0:10:03.73,0:10:05.27,Default,nanas 1,0,0,0,,Dan Anda mengetahui hal ini dengan sangat baik.
Dialog: 0,0:10:06.27,0:10:08.44,Default,nanas 1,0,0,0,,Jika Anda butuh bantuan,
Dialog: 0,0:10:08.44,0:10:10.31,Default,nanas 1,0,0,0,,Saya selalu siap mengulurkan tangan.
Dialog: 0,0:10:10.57,0:10:12.48,Default,nanas 1,0,0,0,,Untuk Anda dan anak Anda
Dialog: 0,0:10:13.01,0:10:15.45,Default,nanas 1,0,0,0,,Saya akan melakukan apa saja.
Dialog: 0,0:10:28.73,0:10:31.83,Default,nanas 1,0,0,0,,Baru-baru ini\Nkemarahan populer meningkat.
Dialog: 0,0:10:32.23,0:10:35.13,Default,nanas 1,0,0,0,,Saya mendapat berita tentang pemberontakan petani,
Dialog: 0,0:10:35.63,0:10:39.27,Default,nanas 1,0,0,0,,Saya bermaksud menyelidiki sendiri\Nsituasi situasi di negara ini.
Dialogue: 0,0:10:40.04,0:10:43.27,Default,pineapple 1,0,0,0,,Segala sesuatu yang berhubungan dengan orang-orang itu penting,\Ndan selagi aku tidak di sini,
Dialog: 0,0:10:44.07,0:10:46.64,Default,nanas 1,0,0,0,,kamu harus mematuhi\Nperintah Janda Ratu.
Dialog: 0,0:10:46.94,0:10:50.45,Default,nanas 1,0,0,0,,Ini adalah keputusan raja.
Dialog: 0,0:10:55.45,0:10:59.69,Default,nanas 1,0,0,0,,Karena saya sekarang menggantikan raja yang menjabat, saya akan mengganti beberapa pejabat,
Dialog: 0,0:10:59.92,0:11:02.19,Default,nanas 1,0,0,0,,untuk melaksanakan perintahnya dengan benar.
Dialog: 0,0:11:02.46,0:11:03.93,Default,nanas 1,0,0,0,,Kim Seokkeun akan kembali
Dialog: 0,0:11:03.93,0:11:05.43,Default,nanas 1,0,0,0,,ke kiriman Anda,
Dialog: 0,0:11:05.80,0:11:07.66,Default,nanas 1,0,0,0,,dan mantan Menteri Perang Kim Changhyup
Dialog: 0,0:11:07.66,0:11:09.57,Default,nanas 1,0,0,0,,akan menggantikan kepala pengawal kerajaan.
Dialog: 0,0:11:10.03,0:11:12.20,Default,nanas 1,0,0,0,,Pangeran Yeonpyeong, yang memegang jabatan ini,
Dialog: 0,0:11:12.20,0:11:15.31,Default,nanas 1,0,0,0,,fokus\Non tugasnya sebagai kepala Ijeongcheon.
Dialog: 0,0:11:37.96,0:11:40.43,Default,nanas 1,0,0,0,,Raja telah memulai jalan yang sulit.
Dialog: 0,0:11:41.26,0:11:45.07,Default,nanas 1,0,0,0,,Jika ada yang mencoba\Nmencoreng reputasinya,
Dialog: 0,0:11:45.70,0:11:49.61,Default,nanas 1,0,0,0,,orang ini harus\Nkhawatir akan keamanan bahasanya.
Dialog: 0,0:12:24.21,0:12:25.38,Default,nanas 1,0,0,0,,Sayang,
Dialogue: 0,0:12:26.48,0:12:27.74,Default,nanas 1,0,0,0,,kamu manis sekali.
Dialog: 0,0:12:30.55,0:12:31.95,Default,nanas 1,0,0,0,,Dalam kehidupan ini
Dialog: 0,0:12:32.25,0:12:33.65,Default,nanas 1,0,0,0,,jangan menyangkal dirimu apa pun.
Dialogue: 0,0:12:41.09,0:12:44.53,Default,nanas 1,0,0,0,,Surat tulisan tangan hanya untuk\Nmenenangkan hati yang memberontak.
Dialog: 0,0:12:50.47,0:12:52.97,Default,nanas 1,0,0,0,,Sayang, apakah kamu juga merindukan ayah?
Dialog: 0,0:12:53.24,0:12:55.07,Default,nanas 1,0,0,0,,Ucapkan: “Ayah, segera kembali!”
Dialogue: 0,0:12:57.04,0:12:59.64,Default,nanas 1,0,0,0,,Apa benar-benar keren? Apakah ini caramu menjawabku?
Dialogue: 0,0:13:00.71,0:13:02.51,Default,nanas 1,0,0,0,,Bukankah buahnya bergerak terlalu dini?
Dialog: 0,0:13:02.51,0:13:03.71,Default,nanas 1,0,0,0,,Sangat awal.
Dialog: 0,0:13:05.75,0:13:07.08,Default,nanas 1,0,0,0,,Apakah anak itu jenius?
Dialog: 0,0:13:07.62,0:13:10.32,Default,nanas 1,0,0,0,,Ya Tuhan! Saya akan melahirkan seorang jenius!
Dialog: 0,0:13:12.26,0:13:14.72,Default,nanas 1,0,0,0,,Dan kenapa aku begitu bahagia?
Dialog: 0,0:13:20.06,0:13:21.10,Default,nanas 1,0,0,0,,Yang Mulia.
Dialog: 0,0:13:21.93,0:13:25.50,Default,nanas 1,0,0,0,,Sesuatu memberitahuku\Nbahwa ini akan menjadi mimpi buruk.
Dialog: 0,0:13:25.84,0:13:27.60,Default,nanas 1,0,0,0,,Aku akan menjadi orang tua yang buruk,
Dialog: 0,0:13:27.60,0:13:30.37,Default,nanas 1,0,0,0,,persilangan yang mengerikan antara ayah yang penuh kasih dan ibu yang gila.
Dialogue: 0,0:13:30.64,0:13:32.34,Default,nanas 1,0,0,0,,Anakmu berharga.
Dialogue: 0,0:13:32.34,0:13:34.21,Default,nanas 1,0,0,0,,Tidak pernah ada terlalu banyak perhatian.
Dialog: 0,0:13:34.51,0:13:38.18,Default,nanas 1,0,0,0,,Saya yakin bayinya akan persis seperti Anda...
Dialogue: 0,0:13:38.92,0:13:40.88,Default,nanas 1,0,0,0,,Kengerian macam apa yang kamu bicarakan?
Dialog: 0,0:13:41.15,0:13:42.22,Default,nanas 1,0,0,0,,Apa?
Dialogue: 0,0:13:43.02,0:13:46.82,Default,nanas 1,0,0,0,,Kenapa, kalau anakku seperti aku, jelek sekali?
Dialog: 0,0:13:46.82,0:13:49.29,Default,nanas 1,0,0,0,,Waktunya minum obat, Yang Mulia.
Dialog: 0,0:13:56.87,0:13:58.47,Default,nanas 1,0,0,0,,Ke bawah.
Dialog: 0,0:13:59.07,0:14:00.80,Default,nanas 1,0,0,0,,Itu saja.
Dialog: 0,0:14:01.57,0:14:03.71,Default,nanas 1,0,0,0,,Yang Mulia menyebut anak itu miliknya.
Dialog: 0,0:14:07.98,0:14:09.78,Default,nanas 1,0,0,0,,Itu saja.
Dialogue: 0,0:14:19.89,0:14:21.99,Default,nanas 1,0,0,0,,Dan apa yang mereka campurkan ke dalam ramuannya?
Dialogue: 0,0:14:23.29,0:14:26.63,Default,nanas 1,0,0,0,,Obat ini pasti anti keguguran,\Nbukan untuk demensia?
Dialogue: 0,0:14:29.40,0:14:32.34,Default,nanas 1,0,0,0,,Horor! Serangan mental macam apa ini?\NKenapa aku terus memikirkan dia?
Dialog: 0,0:14:34.20,0:14:36.54,Default,nanas 1,0,0,0,,Segala sesuatu di istana mengingatkannya.
Dialogue: 0,0:14:52.89,0:14:56.06,Default,nanas 1,0,0,0,,Raja kita adalah Cheoljong,\Ndi sini saya menyulam CJ.
Dialogue: 0,0:14:56.43,0:14:59.00,Default,nanas 1,0,0,0,,Apakah kamu benar-benar menyulam ini hanya dalam satu malam?
Dialogue: 0,0:14:59.16,0:15:01.16,Default,nanas 1,0,0,0,,Itu selalu menarik\Napa yang ditemukan semua orang dalam sulaman.
Dialog: 0,0:15:01.16,0:15:03.40,Default,nanas 1,0,0,0,,Sementara tanganku sibuk, kepalaku kosong dari pikiran.
Dialog: 0,0:15:03.40,0:15:04.47,Default,nanas 1,0,0,0,,Saya menyukainya.
Dialog: 0,0:15:05.03,0:15:06.84,Default,nanas 1,0,0,0,,Kamu adalah pengrajin wanita sejati.
Dialog: 0,0:15:07.20,0:15:08.71,Default,nanas 1,0,0,0,,Sangat cantik.
Dialog: 0,0:15:08.71,0:15:11.07,Default,nanas 1,0,0,0,,Ini sutra dari Jinju, Gyeongsangnam-do.
Dialog: 0,0:15:11.07,0:15:12.81,Default,nanas 1,0,0,0,,pikirku, di hari berangin
Dialog: 0,0:15:12.81,0:15:14.64,Default,nanas 1,0,0,0,,yang terbaik untuk dikenakan adalah syal seperti itu.
Dialog: 0,0:15:14.98,0:15:17.85,Default,nanas 1,0,0,0,,Saya yakin Yang Mulia\Nakan menyukai hadiah Anda.
Dialogue: 0,0:15:18.95,0:15:21.15,Default,nanas 1,0,0,0,,Ini syal yang lain untukku.
Dialog: 0,0:15:22.22,0:15:24.52,Default,nanas 1,0,0,0,,Semua otot kaku karena duduk lama.
Dialogue: 0,0:15:25.66,0:15:27.92,Default,nanas 1,0,0,0,,Apakah kamu ingin memainkan sesuatu yang menyenangkan?
Dialog: 0,0:15:28.49,0:15:29.89,Default,nanas 1,0,0,0,,-Tentu saja, Yang Mulia!\N-Tentu saja, Yang Mulia!
Dialog: 0,0:15:30.89,0:15:32.13,Default,nanas 1,0,0,0,,Kepala Kasim
Dialog: 0,0:15:37.23,0:15:38.67,Default,nanas 1,0,0,0,,Saya tahu! Raja!
Dialog: 0,0:15:42.14,0:15:43.41,Default,Spilyk2,0,0,0,,Di sana.
Dialog: 0,0:15:43.87,0:15:44.91,Default,Spillik2,0,0,0,,Kepala Kasim?
Dialog: 0,0:15:45.58,0:15:48.11,Default,Spikyulka2,0,0,0,,Ya, ada kepala kasim yang melayani raja.
Dialog: 0,0:15:48.58,0:15:50.78,Default,Spikyulka2,0,0,0,,Ya, ini jawabannya - kepala kasim.
Dialogue: 0,0:15:54.15,0:15:56.39,Default,Spillik2,0,0,0,,Jadi, maksudnya? Tidak mengerti.
Dialog: 0,0:15:57.09,0:15:58.09,Default,Spillik2,0,0,0,,Selanjutnya.
Dialog: 0,0:15:58.45,0:16:00.69,Default,Spillik2,0,0,0,,Harimau.
Dialog: 0,0:16:00.69,0:16:01.72,Default,Spillik2,0,0,0,,Raja!
Dialog: 0,0:16:01.72,0:16:02.79,Default,Spillit2,0,0,0,,Monyet.
Dialog: 0,0:16:02.79,0:16:03.79,Default,Spillik2,0,0,0,,Raja.
Dialog: 0,0:16:03.79,0:16:04.96,Default,Spillit2,0,0,0,,Kelinci.
Dialog: 0,0:16:04.96,0:16:06.00,Default,Spillik2,0,0,0,,Raja.
Dialog: 0,0:16:06.00,0:16:08.23,Default,Spillie2,0,0,0,,Anjing.
Dialog: 0,0:16:11.23,0:16:13.30,Default,Spilyk2,0,0,0,,Ini cukup mudah.
Dialog: 0,0:16:13.30,0:16:15.41,Default,Spillik2,0,0,0,,Merengek seperti anak anjing terlantar.
Dialog: 0,0:16:15.91,0:16:16.94,Default,Spillik2,0,0,0,,Raja?
Dialog: 0,0:16:18.88,0:16:19.91,Default,Spillik2,0,0,0,,Yang Mulia.
Dialogue: 0,0:16:20.88,0:16:23.51,Default,Spikyulka2,0,0,0,,Apakah kamu begitu merindukannya?
Dialog: 0,0:16:24.71,0:16:26.78,Default,Spillik2,0,0,0,,Hubungan tinggi.
Dialog: 0,0:16:29.42,0:16:31.62,Default,Spillik2,0,0,0,,Tidak seperti itu. Jangan melebih-lebihkan.
Dialog: 0,0:16:31.89,0:16:32.96,Default,Spikyulka2,0,0,0,,Tuhan, apa yang kamu lakukan?
Dialog: 0,0:16:33.52,0:16:36.13,Default,Spillik2,0,0,0,,Entah kenapa tidak menyenangkan. Beri aku jarum dan benang.
Dialog: 0,0:16:41.93,0:16:44.23,Default,Spillik2,0,0,0,,Ratu, kamu baik-baik saja?
Dialog: 0,0:16:44.87,0:16:45.87,Default,Spillik2,0,0,0,,Tidak.
Dialog: 0,0:16:47.87,0:16:49.14,Default,Spillik2,0,0,0,,Tidak sama sekali.
Dialog: 0,0:16:50.01,0:16:51.61,Default,Spillik2,0,0,0,,Ini sangat menyakitkan.
Dialogue: 0,0:16:53.01,0:16:55.41,Default,Spikyulka2,0,0,0,,Bagaimana jarum yang tipis bisa begitu sakit?
Dialog: 0,0:16:58.51,0:17:00.42,Default,Spillik2,0,0,0,,Semua karena hormon.
Dialog: 0,0:17:01.25,0:17:02.35,Default,Spilyk2,0,0,0,,Karena kehamilan
Dialog: 0,0:17:02.35,0:17:04.62,Default,Spillik2,0,0,0,,Saya mudah marah. Dan saya punya banyak kekhawatiran.
Dialog: 0,0:17:05.02,0:17:06.42,Default,Spikyulka2,0,0,0,,Jadi aku terus mengaum.
Dialogue: 0,0:17:07.46,0:17:09.59,Default,Spillik2,0,0,0,,Itu bukan aku.
Dialog: 0,0:17:10.43,0:17:11.96,Default,Spillik2,0,0,0,,Ini adalah hormon.
Dialogue: 0,0:17:14.56,0:17:18.30,Default,Spillik2,0,0,0,,Hatiku sakit sekali.
Dialog: 0,0:17:21.30,0:17:25.44,Default,Spikyulka2,0,0,0,,Seolah-olah ada jarum yang menusuknya.
Dialog: 0,0:17:25.88,0:17:27.01,Default,Spillik2,0,0,0,,Yang Mulia.
Dialog: 0,0:17:31.11,0:17:33.15,Default,Spillik2,0,0,0,,Oh, tidak.
Dialog: 0,0:17:34.82,0:17:36.45,Default,Spikyulka2,0,0,0,,Ada apa denganku?
Dialogue: 0,0:17:39.72,0:17:41.62,Default,Silk2,0,0,0,,Kami masih mencari jenazahnya.
Dialog: 0,0:17:42.16,0:17:43.59,Default,Spikyulka2,0,0,0,,Tolong beri saya lebih banyak waktu.
Dialog: 0,0:17:43.79,0:17:45.03,Default,Spillik2,0,0,0,,Saya tidak sabar menunggu.
Dialog: 0,0:17:46.10,0:17:49.40,Default,Spikyulka2,0,0,0,,Lebih banyak lagi alasan untuk bergegas,\Seandainya raja masih hidup.
Dialogue: 0,0:17:50.50,0:17:53.00,Default,Spillik2,0,0,0,,Akan kuumumkan nasib yang menimpa raja. Bersiap.
Dialog: 0,0:17:54.50,0:17:55.57,Default,Spilyk2,0,0,0,,Ya.
Dialog: 0,0:17:58.57,0:18:00.04,Default,Spillik2,0,0,0,,Sekarang saya siap.
Dialog: 0,0:18:00.44,0:18:02.31,Default,Spillik2,0,0,0,,Beberapa jarum tidak lagi membuatku menangis.
Dialogue: 0,0:18:04.11,0:18:05.21,Default,Spillik2,0,0,0,,Sungguh mimpi buruk!
Dialog: 0,0:18:05.95,0:18:07.65,Default,Spillik2,0,0,0,,-Yang Mulia.\N-Itu membuatku takut.
Dialog: 0,0:18:07.65,0:18:09.35,Default,Spikyulka2,0,0,0,,Saya hampir mengalami keguguran.
Dialog: 0,0:18:09.35,0:18:11.25,Default,Spilyk2,0,0,0,,Bisakah kamu mengatakan hal seperti itu?
Dialog: 0,0:18:14.12,0:18:15.16,Default,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:18:16.89,0:18:18.26,Default,Spillik2,0,0,0,,Ada apa? Kamu membuatku takut.
Dialog: 0,0:18:21.76,0:18:23.07,Default,Spikyulka2,0,0,0,,Apakah raja menderita?
Dialog: 0,0:18:25.54,0:18:27.27,Default,Spillik2,0,0,0,,Yang Mulia...
Dialog: 0,0:18:29.37,0:18:31.81,Default,Spillik2,0,0,0,,Raja
Dialog: 0,0:18:32.28,0:18:35.98,Default,Spikyulka2,0,0,0,,meninggalkan dunia ini.
Dialogue: 0,0:18:53.03,0:18:57.20,Default,Spikyulka2,0,0,0,,Dan bagaimana jika aku tidak tertidur malam itu?
Dialog: 0,0:18:59.34,0:19:00.44,Default,Spillik2,0,0,0,,Raja
Dialog: 0,0:19:03.01,0:19:05.07,Default,Spikyulka2,0,0,0,,meninggalkan dunia ini.
Dialog: 0,0:19:13.52,0:19:16.42,Default,Spikyulka2,0,0,0,,Bagaimana jika aku memintamu untuk tinggal?
Dialog: 0,0:19:17.89,0:19:21.12,Default,Silk2,0,0,0,,Yang Mulia, kembalilah kepada kami!
Dialog: 0,0:19:22.33,0:19:25.93,Default,Silk2,0,0,0,,Yang Mulia, kembalilah kepada kami!
Dialog: 0,0:19:28.13,0:19:31.67,Default,Silk2,0,0,0,,Yang Mulia, kembalilah kepada kami!
Dialog: 0,0:19:32.57,0:19:35.77,Default,Spillik2,0,0,0,,Jika aku belum pernah sampai ke Joseon
Dialog: 0,0:19:37.14,0:19:38.91,Default,Spilyk2,0,0,0,,dan kita tidak akan bertemu?
Dialog: 0,0:19:40.28,0:19:43.28,Default,Spillik2,0,0,0,,Kamu masih hidup.
Dialog: 0,0:19:43.28,0:19:46.58,Default,Spilyk2,0,0,0,,5 hari sebelum naik takhta
Dialog: 0,0:19:46.58,0:19:48.18,Default,Spillik2,0,0,0,,Kembali?
Dialog: 0,0:19:48.68,0:19:50.52,Default,Spikyulka2,0,0,0,,Apakah mungkin meminta orang mati untuk kembali?
Dialog: 0,0:19:50.52,0:19:52.99,Default,Spillik2,0,0,0,,Permintaan yang sangat buruk.
Dialog: 0,0:19:53.42,0:19:55.66,Default,Spikyulka2,0,0,0,,Dan mayatnya belum ditemukan.
Dialogue: 0,0:19:55.66,0:19:58.49,Default,Spikyulka2,0,0,0,,Teriakan yang memintaku kembali membuat bulu kudukku berdiri.
Dialog: 0,0:19:59.10,0:20:02.23,Default,Silk2,0,0,0,,Jika aku bisa, aku akan memahkotai raja baru.
Dialog: 0,0:20:02.40,0:20:04.23,Default,Spilyk2,0,0,0,,Tetapi jika saya tidak mengikuti tradisi
Dialog: 0,0:20:04.23,0:20:06.14,Default,Spikyulka2,0,0,0,,dan menunggu kebangkitan raja yang telah meninggal,
Dialog: 0,0:20:06.14,0:20:09.44,Default,Spikyulka2,0,0,0,,Saya yakin ini akan menjadi bumerang bagi saya dan merusak semua rencana politik saya.
Dialog: 0,0:20:09.44,0:20:11.47,Default,Spillik2,0,0,0,,Bahkan jika raja masih hidup,
Dialog: 0,0:20:11.87,0:20:13.94,Default,Spikyulka2,0,0,0,,dia tidak akan bisa kembali ke istana.
Dialog: 0,0:20:15.41,0:20:16.95,Default,Spikyulka2,0,0,0,,Saya menutup semua gerbang
Dialog: 0,0:20:16.95,0:20:18.65,Default,Spilyk2,0,0,0,,sampai penobatan baru.
Dialog: 0,0:20:19.28,0:20:20.28,Default,Spillik2,0,0,0,,Ya.
Dialog: 0,0:20:20.62,0:20:23.45,Default,Spikyulka2,0,0,0,,Jika dalam lima hari kita bisa mengadakan penobatan,
Dialog: 0,0:20:24.49,0:20:26.16,Default,Spikyulka2,0,0,0,,dia tidak lagi menjadi raja.
Dialog: 0,0:20:26.59,0:20:28.49,Default,Spikyulka2,0,0,0,,Jadi, jika kita membunuhnya, itu bukan pengkhianatan lagi.
Dialogue: 0,0:20:35.87,0:20:38.40,Default,Silk2,0,0,0,,Berapa lama aku harus menunggu sampai ratu sadar?
Dialog: 0,0:20:39.87,0:20:42.64,Default,Silk2,0,0,0,,Bukankah dia benar-benar ingin bersatu kembali dengan klan?
Dialog: 0,0:20:42.64,0:20:45.51,Default,Spikyulka2,0,0,0,,Aku akan menyuruhnya bersiap-siap dan mengunjungimu
Dialog: 0,0:20:45.51,0:20:46.98,Default,Spillik2,0,0,0,,secepatnya.
Dialog: 0,0:21:08.20,0:21:10.70,Default,Spilyk2,0,0,0,,Buku Harian Kehamilan
Dialog: 0,0:21:14.87,0:21:17.01,Default,Spikyulka2,0,0,0,,Dan mengapa ini diperlukan sekarang,
Dialog: 0,0:21:20.28,0:21:21.54,Default,Spillik2,0,0,0,,saat kamu tidak di sini?
Dialog: 0,0:21:46.80,0:21:47.97,Default,Spikyulka2,0,0,0,,Kekuatan dibeli dengan uang.
Dialog: 0,0:21:56.95,0:21:57.98,Default,Spillik2,0,0,0,,Anakku.
Dialogue: 0,0:21:58.58,0:22:01.08,Default,Spillit2,0,0,0,,Jangan peka terhadap bau makanan.
Dialog: 0,0:22:01.25,0:22:03.32,Default,Spikyulka2,0,0,0,,Jangan mempersulit hidup ibumu yang cantik.
Dialog: 0,0:22:04.99,0:22:07.16,Default,Spikyulka2,0,0,0,,Diam sebanyak yang kamu mau sepanjang hari.
Dialog: 0,0:22:07.49,0:22:11.09,Default,Spikyulka2,0,0,0,,Tapi kalau ibumu ingin tidur, berhentilah.
Dialog: 0,0:22:12.80,0:22:14.56,Default,Spilyk2,0,0,0,,Ketika tiba waktunya untuk pergi ke dunia luar,
Dialog: 0,0:22:14.56,0:22:16.83,Default,Spilyk2,0,0,0,,keluar dengan cepat,
Dialogue: 0,0:22:16.83,0:22:19.10,Default,Spikyulka2,0,0,0,,jangan buat ibumu terlalu menderita.
Dialogue: 0,0:22:20.77,0:22:24.47,Default,Spikyulka2,0,0,0,,Yang terpenting datang ke dunia dengan sehat.
Dialog: 0,0:22:27.08,0:22:31.98,Default,Spikyulka2,0,0,0,,Aku sangat menantikan hari dimana kita bertemu.
Dialog: 0,0:22:38.92,0:22:41.02,Default,Spilyk2,0,0,0,,Aku berjanji akan berada di sisimu,
Dialog: 0,0:22:41.02,0:22:43.16,Default,Spikyulka2,0,0,0,,saat kamu mengambil nafas pertama di dunia ini.
Dialog: 0,0:22:43.79,0:22:47.76,Default,Spillik2,0,0,0,,Bahkan jika dunia tampak aneh bagimu, jangan takut pada apa pun.
Dialog: 0,0:23:33.32,0:23:34.98,Default,Spillik2,0,0,0,,Tunjukkan rasa hormat.
Dialog: 0,0:23:36.45,0:23:38.32,Default,Spikyulka2,0,0,0,,Jadi ini rencanamu awalnya?
Dialog: 0,0:23:39.89,0:23:42.23,Default,Spikyulka2,0,0,0,,Raja tahu tentang bahaya yang mengancamnya.
Dialog: 0,0:23:42.83,0:23:44.83,Default,Spikyulka2,0,0,0,,Tapi demi keselamatanmu
Dialog: 0,0:23:44.83,0:23:46.73,Default,Spikyulka2,0,0,0,,mempertaruhkan nyawanya dan meninggalkan istana.
Dialog: 0,0:23:48.06,0:23:49.40,Default,Spillik2,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:23:58.01,0:23:59.78,Default,Spillie2,0,0,0,,Menjebloskan Pangeran Yeonpyeong ke penjara.
Dialog: 0,0:24:01.84,0:24:02.88,Default,Spikyulka2,0,0,0,,-Tidak!\N-Yang Mulia!
Dialog: 0,0:24:03.15,0:24:04.88,Default,Spillik2,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:24:07.02,0:24:09.55,Default,Spikyulka2,0,0,0,,Kenapa kamu melampiaskan amarahmu pada ratu?
Dialog: 0,0:24:09.55,0:24:12.69,Default,Spillik2,0,0,0,,Raja meninggalkan dunia karena pengikut Tonhak.
Dialogue: 0,0:24:17.06,0:24:20.06,Default,Spilyk2,0,0,0,,Para pemberontak bahkan tidak menyentuh gubernur.
Dialogue: 0,0:24:20.96,0:24:23.77,Default,Spikyulka2,0,0,0,,Kamu bilang mereka berani membunuh raja?
Dialogue: 0,0:24:24.93,0:24:27.24,Default,Spikyulka2,0,0,0,,Apakah menurutmu aku akan mempercayai kebohongan menyedihkan seperti itu?
Dialog: 0,0:24:28.24,0:24:32.44,Default,Spikyulka2,0,0,0,,Kim Byonin, prajuritmu membunuh raja.
Dialog: 0,0:24:34.84,0:24:38.18,Default,Spillik2,0,0,0,,Kau dan ratu menjatuhkan hukuman mati padanya,
Dialog: 0,0:24:39.32,0:24:41.48,Default,Spikyulka2,0,0,0,,jadi saya pribadi harus mengambil nyawanya.
Dialog: 0,0:24:45.02,0:24:46.22,Default,Spillik2,0,0,0,,Tolong, tidak!
Dialog: 0,0:24:46.52,0:24:47.66,Default,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:24:48.56,0:24:50.73,Default,Spillie2,0,0,0,,Demi anak dalam perutnya,
Dialogue: 0,0:24:51.63,0:24:53.86,Default,Spillik2,0,0,0,,mohon jangan menyakitinya.
Dialog: 0,0:24:54.70,0:24:57.20,Default,Spillik2,0,0,0,,Yang Mulia tidak tahu apa-apa.
Dialog: 0,0:24:57.63,0:24:58.80,Default,Spilyk2,0,0,0,,Tolong...
Dialog: 0,0:25:01.04,0:25:02.54,Default,Spilyk2,0,0,0,,Saya mohon...
Dialog: 0,0:25:12.55,0:25:14.55,Default,Spillik2,0,0,0,,Tuhan! Ratu!
Dialog: 0,0:25:20.89,0:25:22.19,Default,Spilyk2,0,0,0,,Bawa dia pergi.
Dialog: 0,0:25:37.64,0:25:39.21,Default,Spillik2,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:25:43.05,0:25:44.58,Default,Spilyk2,0,0,0,,Apa yang dia bicarakan?
Dialog: 0,0:25:45.31,0:25:47.48,Default,Spikyulka2,0,0,0,,Prajuritmu membunuh raja?
Dialog: 0,0:25:49.09,0:25:50.45,Default,Spillik2,0,0,0,,Kalian berdua, tinggalkan ruangan.
Dialog: 0,0:25:52.89,0:25:54.36,Default,Spillik2,0,0,0,,-Yang Mulia.\N-Semuanya baik-baik saja.
Dialog: 0,0:26:07.60,0:26:10.51,Default,Spikyulka2,0,0,0,,Harus ada yang disalahkan atas kemalangan yang menimpa.
Dialog: 0,0:26:12.68,0:26:14.68,Default,Spillie2,0,0,0,,Pangeran Yeonpyeong mengigau,
Dialog: 0,0:26:15.31,0:26:17.15,Default,Spikyulka2,0,0,0,,jangan ambil hati.
Dialog: 0,0:26:18.38,0:26:20.78,Default,Spillik2,0,0,0,,Mengapa Pangeran Yeonpyeong dikirim ke penjara?
Dialog: 0,0:26:21.05,0:26:23.02,Default,Spikyulka2,0,0,0,,Saya punya bukti dia melepaskannya
Dialog: 0,0:26:23.02,0:26:24.79,Default,Spikyulka2,0,0,0,,pengikut Tonhak, menyelinap masuk
Dialog: 0,0:26:24.92,0:26:27.79,Default,Silk2,0,0,0,,kepada pengawal kerajaan, dan membantu mereka melarikan diri.
Dialog: 0,0:26:27.99,0:26:30.53,Default,Spillik2,0,0,0,,Sepertinya ada hubungannya dengan kejadian yang menimpa raja,
Dialog: 0,0:26:30.53,0:26:32.56,Default,Spikyulka2,0,0,0,,karena saya akan menginterogasi Pangeran Yeonpyeong.
Dialog: 0,0:26:33.76,0:26:35.23,Default,Spikyulka2,0,0,0,,Saya seharusnya melakukan ini lebih awal.
Dialog: 0,0:26:35.80,0:26:37.67,Default,Spilyk2,0,0,0,,Apa sebenarnya yang kamu bicarakan?
Dialog: 0,0:26:38.20,0:26:40.60,Default,Spikyulka2,0,0,0,,Kamu berbicara seolah-olah Pangeran Yeonpyeong membunuh raja.
Dialog: 0,0:26:40.60,0:26:43.47,Default,Spillik2,0,0,0,,Seseorang di istana pasti sudah menyerahkannya kepada pengikut Tonhak
Dialog: 0,0:26:43.47,0:26:46.48,Default,Spikyulka2,0,0,0,,informasi tentang kapan raja akan meninggalkan istana.
Dialog: 0,0:26:47.64,0:26:51.01,Default,Spikyulka2,0,0,0,,Seharusnya seseorang yang memiliki akses terhadap informasi,
Dialog: 0,0:26:51.71,0:26:53.78,Default,Spikyulka2,0,0,0,,yang berarti kemungkinan besar ini adalah Pangeran Yeonpyeong.
Dialog: 0,0:26:55.72,0:26:57.99,Default,Spillik2,0,0,0,,Apakah kamu yakin pengikut Tonhak-lah yang menyerang raja?
Dialog: 0,0:26:58.25,0:27:01.76,Default,Spillik2,0,0,0,,Anda harus fokus pada hal yang lebih penting.
Dialog: 0,0:27:02.46,0:27:06.06,Default,Spilyk2,0,0,0,,Sekarang hanya klanmu yang bisa melindungimu
Dialog: 0,0:27:06.06,0:27:07.43,Default,Spilyk2,0,0,0,,dan anak Anda.
Dialog: 0,0:27:08.30,0:27:10.60,Default,Spikyulka2,0,0,0,,Tak ada gunanya mengkhawatirkan hal lain.
Dialog: 0,0:27:10.63,0:27:13.34,Default,Spillik2,0,0,0,,Pertama, kamu harus berdamai dengan ratu janda.
Dialog: 0,0:27:14.00,0:27:15.24,Default,Spilyk2,0,0,0,,Jika Anda melewatkan kesempatan ini,
Dialog: 0,0:27:17.74,0:27:20.84,Default,Silk2,0,0,0,,kamu mungkin selamanya kehilangan kesempatan untuk memperbaiki hubungan dengan klan.
Dialog: 0,0:27:42.00,0:27:45.30,Default,Silk2,0,0,0,,Yeonpyeong, aku ingin menjadi dirimu di kehidupan selanjutnya.
Dialog: 0,0:27:45.73,0:27:48.77,Default,Spillik2,0,0,0,,"Temukan bukti." Kedengarannya sederhana
Dialog: 0,0:27:48.77,0:27:51.41,Default,Spikyulka2,0,0,0,,dan berapa banyak pekerjaan yang diperlukan.
Dialog: 0,0:27:59.32,0:28:00.78,Default,Lily3,0,0,0,,Saya melihat semua orang ada di sini.
Dialog: 0,0:28:05.09,0:28:06.79,Default,Lily3,0,0,0,,Menurutku itu tidak pantas
Dialog: 0,0:28:06.92,0:28:10.86,Default,Lily3,0,0,0,,berkumpul di rumah kisaeng saat raja meninggal.
Dialogue: 0,0:28:10.86,0:28:13.00,Default,Lily3,0,0,0,,Aku sengaja memilih tempat ini untuk bersantai.
Dialogue: 0,0:28:14.83,0:28:18.33,Default,Lily3,0,0,0,,Kita semua bisa jujur ​​selagi kita di sini.
Dialog: 0,0:28:20.04,0:28:21.34,Default,Lily3,0,0,0,,Kematian Raja
Dialog: 0,0:28:23.01,0:28:25.27,Default,Lily3,0,0,0,,kita perlu merayakannya.
Dialog: 0,0:28:30.51,0:28:31.85,Default,Lily3,0,0,0,,Ayo minum.
Dialogue: 0,0:28:32.18,0:28:35.89,Default,Lily3,0,0,0,,Kerumunan pemberontak jadi gila.
Dialog: 0,0:28:36.15,0:28:38.65,Default,Lily3,0,0,0,,Saya khawatir tentang masa depan Joseon.
Dialog: 0,0:28:40.09,0:28:41.66,Default,Lily3,0,0,0,,Kalau terus begini, orang Tonkhakov
Dialog: 0,0:28:41.66,0:28:44.86,Default,Lilia3,0,0,0,,Khanyan akan segera ditangkap.
Dialog: 0,0:28:45.13,0:28:47.83,Default,Lily3,0,0,0,,Jika ini terjadi, semuanya duduk di sini
Dialogue: 0,0:28:48.16,0:28:49.87,Default,Lily3,0,0,0,,akan menderita.
Dialog: 0,0:28:52.03,0:28:54.60,Default,Lily3,0,0,0,,Oleh karena itu, kita perlu memperkuat keamanan istana
Dialog: 0,0:28:54.90,0:28:57.84,Default,Lily3,0,0,0,,dan tembok benteng di sekitar Khanyang.
Dialog: 0,0:28:58.94,0:29:01.44,Default,Lily3,0,0,0,,Kami akan mengumumkan keadaan darurat dan membatasi masuk.
Dialog: 0,0:29:01.81,0:29:04.05,Default,Lily3,0,0,0,,Semua orang yang mencurigakan akan ditahan.
Dialog: 0,0:29:05.25,0:29:07.85,Default,Lily3,0,0,0,,Jadi kita akan menyingkirkan semua orang Tonhak.
Dialog: 0,0:29:11.19,0:29:14.09,Default,Lily3,0,0,0,,Ide cemerlang.
Dialog: 0,0:29:23.33,0:29:26.74,Default,Lily3,0,0,0,,Sepertinya ratu sudah gila.
Dialog: 0,0:29:27.84,0:29:29.81,Default,Lily3,0,0,0,,Dia selalu seperti ini.
Dialog: 0,0:29:32.47,0:29:35.78,Default,Lilia3,0,0,0,,Dia mengira semua kekuasaan ada di tangannya karena kehamilan,
Dialog: 0,0:29:35.98,0:29:39.11,Default,Lily3,0,0,0,,tetapi raja meninggal. Aku yakin dia ketakutan.
Dialog: 0,0:29:40.65,0:29:43.25,Default,Lily3,0,0,0,,Jika dia melahirkan seorang pangeran,
Dialog: 0,0:29:43.25,0:29:46.52,Default,Lily3,0,0,0,,ini akan menghabisinya.
Dialog: 0,0:29:48.26,0:29:50.36,Default,Lily3,0,0,0,,Akhirnya, kata-kata yang masuk akal dari Anda.
Dialog: 0,0:30:04.64,0:30:07.81,Default,Lily3,0,0,0,,Lilin dan dupa perlu diganti.
Dialog: 0,0:30:30.83,0:30:34.30,Default,Lily3,0,0,0,,Yang Mulia, saya akan mati karena serangan jantung.
Dialogue: 0,0:30:34.47,0:30:37.51,Default,Lily3,0,0,0,,Kenapa mereka menjaga orang mati seperti itu?
Dialog: 0,0:30:39.41,0:30:41.34,Default,Lily3,0,0,0,,Apakah tidak ada yang aneh dalam hal ini?
Dialog: 0,0:30:44.15,0:30:45.35,Default,Lily3,0,0,0,,Kita harus cepat.
Dialog: 0,0:30:48.25,0:30:49.65,Default,Lily3,0,0,0,,Terima kasih.
Dialog: 0,0:31:06.14,0:31:09.34,Default,Lily3,0,0,0,,Dia terluka parah.
Dialog: 0,0:31:10.11,0:31:12.17,Default,Lily3,0,0,0,,Terutama wajah.
Dialog: 0,0:31:12.27,0:31:16.81,Default,Lily3,0,0,0,,Sangat kuat hingga dia tidak bisa dikenali.
Dialog: 0,0:31:40.34,0:31:42.07,Default,Lily3,0,0,0,,Eureka!
Dialog: 0,0:31:52.92,0:31:55.45,Default,Lily3,0,0,0,,Hai tikus, aku tidak melakukan apa pun.
Dialog: 0,0:31:55.45,0:31:57.82,Default,Lily3,0,0,0,,Setiap orang yang pantas dikurung mengatakan demikian.
Dialog: 0,0:31:57.92,0:32:00.62,Default,Lily3,0,0,0,,Kamu bersalah karena kehilangan senjatamu.
Dialogue: 0,0:32:01.82,0:32:04.66,Default,Lily3,0,0,0,,Bagaimana kamu bisa menyalahkanku dalam hal ini?
Dialogue: 0,0:32:04.83,0:32:07.53,Default,Lily3,0,0,0,,Orang bodoh apa yang mampu kehilangan senjata?
Dialog: 0,0:32:07.53,0:32:10.23,Default,Lily3,0,0,0,,Sama seperti di depanku.
Dialogue: 0,0:32:11.23,0:32:12.97,Default,Lily3,0,0,0,,Depot senjata dirampok.
Dialog: 0,0:32:16.14,0:32:17.57,Default,Lily3,0,0,0,,Saya rasa Anda tidak tertarik,
Dialogue: 0,0:32:20.11,0:32:21.54,Default,Lily3,0,0,0,,apa kesalahan Pangeran Yeonpyeong.
Dialog: 0,0:32:21.91,0:32:24.91,Default,Lily3,0,0,0,,Jangan khawatir. Kamu tidak akan lama di sini.
Dialogue: 0,0:32:26.05,0:32:27.05,Default,Lily3,0,0,0,,Apa?
Dialogue: 0,0:32:28.85,0:32:31.22,Default,Lily3,0,0,0,,Apa maksudnya ini? kita
Dialog: 0,0:32:31.85,0:32:32.86,Default,Lily3,0,0,0,,dieksekusi?
Dialog: 0,0:32:33.96,0:32:36.13,Default,Lily3,0,0,0,,Saya bisa duduk lebih lama.
Dialogue: 0,0:32:36.13,0:32:37.13,Default,Lily3,0,0,0,,Aku suka tidur di lantai.
Dialog: 0,0:32:37.13,0:32:38.46,Default,Lily3,0,0,0,,Hei, tunggu!
Dialog: 0,0:32:44.63,0:32:45.70,Default,Lily3,0,0,0,,Oke.
Dialog: 0,0:32:46.60,0:32:49.97,Default,Lily3,0,0,0,,Mari berdiskusi. Kita bisa melakukannya.
Dialog: 0,0:32:58.58,0:33:00.45,Default,Lily3,0,0,0,,Byonin mengirim Cheoljong ke pemberontak,
Dialog: 0,0:33:00.45,0:33:02.35,Default,Lily3,0,0,0,,menggunakanku sebagai umpan untuk membunuh.
Dialog: 0,0:33:04.65,0:33:06.82,Default,Lily3,0,0,0,,Tapi ada mayat orang lain di sana, yang artinya
Dialog: 0,0:33:06.82,0:33:08.62,Default,Lily3,0,0,0,,rencananya tidak berhasil.
Dialog: 0,0:33:11.13,0:33:14.96,Default,Lily3,0,0,0,,Dia menahan orang-orang Cheoljong agar mereka tidak membantunya kembali.
Dialog: 0,0:33:21.90,0:33:25.47,Default,Lily3,0,0,0,,Aku tidak bisa berkonsentrasi karena isak tangismu.
Dialogue: 0,0:33:31.65,0:33:33.18,Default,Lily3,0,0,0,,Lebih dekat.
Dialog: 0,0:33:36.65,0:33:39.22,Default,Lily3,0,0,0,,Aku akan memberitahumu sebuah rahasia.
Dialogue: 0,0:33:40.49,0:33:43.13,Default,Lily3,0,0,0,,Kau harus membawanya ke kuburmu.
Dialog: 0,0:33:48.13,0:33:49.46,Default,Lily3,0,0,0,,Raja
Dialog: 0,0:33:51.83,0:33:53.00,Default,Lily3,0,0,0,,hidup.
Dialog: 0,0:33:54.87,0:33:56.91,Default,Lily3,0,0,0,,Ya, tentu saja.
Dialog: 0,0:33:57.11,0:34:02.28,Default,Lily3,0,0,0,,Yang Mulia akan tinggal di hatimu.
Dialog: 0,0:34:03.15,0:34:04.55,Default,Lily3,0,0,0,,...
Dialog: 0,0:34:05.91,0:34:07.92,Default,Lily3,0,0,0,,Aku meraba tubuh dari ujung kepala sampai ujung kaki.
Dialog: 0,0:34:09.02,0:34:10.22,Default,Lily3,0,0,0,,Itu bukan dia.
Dialog: 0,0:34:10.42,0:34:12.39,Default,Lily3,0,0,0,,Dari ujung kepala sampai ujung kaki?
Dialog: 0,0:34:13.82,0:34:15.69,Default,Lily3,0,0,0,,Saya lewati detailnya.
Dialogue: 0,0:34:18.36,0:34:21.06,Default,Lily3,0,0,0,,-Lord.\N-Jika dia masih hidup,
Dialog: 0,0:34:21.73,0:34:24.23,Default,Lily3,0,0,0,,kenapa kamu belum kembali?
Dialog: 0,0:34:25.30,0:34:27.57,Default,Lily3,0,0,0,,Dia terluka atau terikat di suatu tempat.
Dialog: 0,0:34:29.14,0:34:30.47,Default,Lily3,0,0,0,,-Nyonya Choi.\N-Ya.
Dialog: 0,0:34:30.64,0:34:32.98,Default,Lily3,0,0,0,,Ada undang-undang yang melarang naik takhta,
Dialog: 0,0:34:32.98,0:34:35.08,Default,Lily3,0,0,0,,segera setelah kematian raja?
Dialog: 0,0:34:35.54,0:34:38.28,Default,Lily3,0,0,0,,Ya. Adat ini disebut Sanibok.
Dialog: 0,0:34:38.28,0:34:42.15,Default,Lily3,0,0,0,,Anda harus menunggu kembalinya jiwa orang yang meninggal dalam waktu lima hari.
Dialog: 0,0:34:42.15,0:34:44.59,Default,Lily3,0,0,0,,Raja baru dapat naik takhta hanya dalam lima hari.
Dialog: 0,0:34:44.89,0:34:47.79,Default,Lily3,0,0,0,,Maka kita punya enam hari, termasuk hari penobatan.
Dialog: 0,0:34:49.19,0:34:51.23,Default,Lily3,0,0,0,,Mereka akan melakukan apa saja,
Dialog: 0,0:34:51.23,0:34:53.30,Default,Lily3,0,0,0,,sehingga selama enam hari ini raja tidak kembali.
Dialog: 0,0:34:55.20,0:34:56.57,Default,Lily3,0,0,0,,Berapa banyak pelayan yang ada di istana?
Dialogue: 0,0:34:57.03,0:35:01.44,Default,Lily3,0,0,0,,Sekitar 250 pelayan istana.
Dialog: 0,0:35:01.44,0:35:03.47,Default,Lily3,0,0,0,,Jika Anda termasuk pegawai istana,
Dialogue: 0,0:35:03.47,0:35:05.51,Default,Lily3,0,0,0,,akan lebih dari 600.
Dialog: 0,0:35:06.11,0:35:08.74,Default,Lily3,0,0,0,,600 kamera pengintai langsung.
Dialog: 0,0:35:09.51,0:35:11.85,Default,Lily3,0,0,0,,Jika masing-masing mengucapkan satu kata, akan ada 600 kata.
Dialogue: 0,0:35:13.52,0:35:15.08,Default,Lily3,0,0,0,,Ayo kita gunakan.
Dialog: 0,0:35:16.05,0:35:17.09,Default,Lily3,0,0,0,,-Apa?\N-Apa?
Dialog: 0,0:35:17.09,0:35:19.15,Default,Lily3,0,0,0,,Saya akan mengganggu penobatan.
Dialog: 0,0:35:21.29,0:35:22.56,Default,Lily3,0,0,0,,Apakah kamu bersamaku?
Dialog: 0,0:35:23.06,0:35:24.06,Default,Lily3,0,0,0,,Semoga berhasil.
Dialog: 0,0:35:24.46,0:35:26.86,Default,Lily3,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:35:27.83,0:35:28.93,Default,Lily3,0,0,0,,Ya.
Dialog: 0,0:35:30.23,0:35:32.10,Default,Lily3,0,0,0,,Jika Yang Mulia masih hidup...
Dialog: 0,0:35:35.37,0:35:38.07,Default,Lily3,0,0,0,,Negara kita sedang mengalami kesulitan,
Dialog: 0,0:35:38.47,0:35:40.48,Default,Lily3,0,0,0,,penunjukan raja baru tidak bisa ditunda.
Dialog: 0,0:35:40.84,0:35:43.65,Default,Lily3,0,0,0,,Sebagai raja yang menjalankan tugas kerajaan,
Dialog: 0,0:35:44.35,0:35:46.25,Default,Lily3,0,0,0,,Saya umumkan keturunan ke-32
Dialog: 0,0:35:46.25,0:35:48.82,Default,Lily3,0,0,0,,Pangeran Minheung, Lee Kyungwon.
Dialog: 0,0:35:50.22,0:35:52.49,Default,Lily3,0,0,0,,Raja telah meninggalkan dunia ini
Dialog: 0,0:35:53.26,0:35:54.96,Default,Lily3,0,0,0,,karena pemberontakan pemberontak...
Dialog: 0,0:35:55.39,0:35:56.86,Default,Lily3,0,0,0,,Pengikut Tonghak yang mengambil
Dialog: 0,0:35:56.86,0:35:59.16,Default,Lily3,0,0,0,,kehidupan raja kita, tidak pantas mendapatkan belas kasihan.
Dialog: 0,0:35:59.63,0:36:01.53,Default,Lily3,0,0,0,,Saya nyatakan bahwa setiap orang
Dialog: 0,0:36:01.53,0:36:04.33,Default,Lily3,0,0,0,,Pengikut Tonghak akan dihancurkan.
Dialog: 0,0:36:05.40,0:36:07.44,Default,Lily3,0,0,0,,Orang-orang Tonhakov telah membawa masalah pada diri mereka sendiri.
Dialog: 0,0:36:07.44,0:36:08.80,Default,Lily3,0,0,0,,Bajingan.
Dialog: 0,0:36:18.38,0:36:19.38,Default,Lily3,0,0,0,,Benin.
Dialog: 0,0:36:25.89,0:36:26.96,Default,Lily3,0,0,0,,Kenapa kamu menunda
Dialog: 0,0:36:26.96,0:36:28.26,Default,Lily3,0,0,0,,Yeonpyeong dan Hong?
Dialog: 0,0:36:29.36,0:36:30.73,Default,Lily3,0,0,0,,Keseimbangan kekuatan berubah
Dialog: 0,0:36:30.73,0:36:32.26,Default,Lily3,0,0,0,,tergantung siapa yang bertahta.
Dialog: 0,0:36:32.26,0:36:34.00,Default,Lily3,0,0,0,,Ini bukan pertama kalinya hal ini terjadi.
Dialogue: 0,0:36:34.00,0:36:36.40,Default,Lily3,0,0,0,,Baiklah. Raja baru saja meninggal.
Dialog: 0,0:36:36.40,0:36:38.30,Default,Lily3,0,0,0,,Bagaimana cara menahan orang tak bersalah?
Dialog: 0,0:36:38.73,0:36:40.34,Default,Lily3,0,0,0,,Tidak bersalah?
Dialog: 0,0:36:42.20,0:36:44.17,Default,Lily3,0,0,0,,Berada di pihak yang lemah juga merupakan kejahatan.
Dialogue: 0,0:36:44.34,0:36:48.08,Default,Lilia3,0,0,0,,Benin, seberapa jauh kamu bersedia melangkah?
Dialog: 0,0:36:50.65,0:36:52.55,Default,Lily3,0,0,0,,Saya ingin menjadi lebih kuat.
Dialog: 0,0:36:53.08,0:36:55.28,Default,Lily3,0,0,0,,Untuk melindungi mereka yang kusayangi,
Dialog: 0,0:36:57.12,0:36:58.85,Default,Lily3,0,0,0,,Saya butuh lebih banyak tenaga.
Dialogue: 0,0:37:05.73,0:37:07.10,Default,Lily3,0,0,0,,Membuat bibirmu tak bernyawa.
Dialog: 0,0:37:07.76,0:37:09.60,Default,Lily3,0,0,0,,Kamu sudah menjadi mayat hidup.
Dialogue: 0,0:37:09.87,0:37:12.57,Default,Lily3,0,0,0,,Lalu buatlah seperti mayat sungguhan.
Dialogue: 0,0:37:17.27,0:37:19.04,Default,Lily3,0,0,0,,Kenapa sejauh ini?
Dialogue: 0,0:37:20.71,0:37:22.94,Default,Lily3,0,0,0,,Raja hanya punya aku yang tersisa.
Dialog: 0,0:37:24.88,0:37:27.38,Default,Lily3,0,0,0,,Bahkan jika mereka ingin menyingkirkanku,
Dialog: 0,0:37:27.38,0:37:29.68,Default,Lily3,0,0,0,,mereka tidak akan memasukkan wanita hamil ke dalam sangkar.
Dialog: 0,0:37:32.49,0:37:33.72,Default,Lily3,0,0,0,,Seperti apa rupaku?
Dialog: 0,0:37:37.56,0:37:39.76,Default,Lily3,0,0,0,,-Seperti mayat sungguhan.\N-Benarkah?
Dialog: 0,0:37:59.51,0:38:02.22,Default,Lily3,0,0,0,,Janda Ratu telah tiba.
Dialogue: 0,0:38:32.38,0:38:35.55,Default,Lily3,0,0,0,,Keduanya akan tampil cukup menarik di sini.
Dialog: 0,0:38:40.09,0:38:42.69,Default,Lily3,0,0,0,,Hanya hadiah utama yang akan menjadi milikku.
Dialog: 0,0:38:44.63,0:38:48.43,Default,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:38:50.50,0:38:54.44,Default,Lily3,0,0,0,,Bagaimana kamu bisa meninggalkanku?
Dialogue: 0,0:38:55.67,0:38:58.61,Default,Lily3,0,0,0,,Bagaimana dengan anak kita?
Dialog: 0,0:39:00.11,0:39:01.14,Default,Lily3,0,0,0,,...
Dialog: 0,0:39:01.61,0:39:06.01,Default,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:10.55,0:39:13.32,Default,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:13.46,0:39:14.86,Default,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:15.89,0:39:17.66,Default,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:17.93,0:39:21.06,Default,Lily3,0,0,0,,Panggil tabib kerajaan. Sangat!
Dialog: 0,0:39:23.60,0:39:26.23,Default,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialogue: 0,0:39:26.23,0:39:28.17,Default,Lily3,0,0,0,,Jika aku tertunda walau hanya sebentar, aku akan mengutuk mereka.
Dialog: 0,0:39:28.17,0:39:29.24,Default,Lily3,0,0,0,,Seret, seret.
Dialog: 0,0:39:29.24,0:39:32.87,Default,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:34.11,0:39:36.55,Default,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:40.92,0:39:43.42,Default,Lily3,0,0,0,,Bagaimana bisa.
Dialog: 0,0:39:44.69,0:39:46.72,Default,Lily3,0,0,0,,Bagaimana bisa.
Dialog: 0,0:39:47.26,0:39:49.49,Default,Lily3,0,0,0,,Tuhan.
Dialog: 0,0:39:49.82,0:39:54.10,Default,Lily3,0,0,0,,Bagaimana bisa.
Dialog: 0,0:39:57.37,0:39:58.57,Default,Lily3,0,0,0,,Apakah kamu meneleponku?
Dialog: 0,0:40:00.54,0:40:02.17,Default,Lily3,0,0,0,,Apakah kamu ngeri saat mendengar beritanya?
Dialog: 0,0:40:02.34,0:40:05.57,Default,Lily3,0,0,0,,Apa yang terjadi padanya di hari-hari terakhir?
Dialogue: 0,0:40:06.78,0:40:09.38,Default,Lily3,0,0,0,,Bagaimana dia bisa pergi begitu tiba-tiba?
Dialog: 0,0:40:11.71,0:40:12.81,Default,Lily3,0,0,0,,Raja
Dialog: 0,0:40:16.59,0:40:17.72,Default,Lily3,0,0,0,,hidup.
Dialog: 0,0:40:19.59,0:40:21.02,Default,Lily3,0,0,0,,Saya menelepon untuk memberi tahu Anda hal ini.
Dialog: 0,0:40:27.23,0:40:28.33,Default,Lily3,0,0,0,,Terima kasih.
Dialog: 0,0:40:29.70,0:40:31.40,Default,Lily3,0,0,0,,Terima kasih banyak.
Dialog: 0,0:40:36.27,0:40:37.37,Default,Lily3,0,0,0,,Dengar.
Dialog: 0,0:40:38.67,0:40:40.31,Default,Lily3,0,0,0,,Ini baru permulaan.
Dialog: 0,0:40:45.78,0:40:49.62,Default,Lily3,0,0,0,,Kami akan meredakan kerusuhan di negara ini dalam empat hari.
Dialog: 0,0:40:50.75,0:40:53.49,Default,Lily3,0,0,0,,Berkat raja, kita akan menyingkirkan orang Tonhak.
Dialog: 0,0:40:53.89,0:40:56.79,Default,Lily3,0,0,0,,Sisa sampah akan membela diri.
Dialog: 0,0:40:57.39,0:40:59.76,Default,Lily3,0,0,0,,Mengingat apa yang terjadi, kita dapat mengatakan,
Dialog: 0,0:40:59.76,0:41:01.83,Default,Lilia3,0,0,0,,bahwa dia memberikan nyawanya untuk menyelamatkan negara.
Dialog: 0,0:41:07.10,0:41:08.57,Default,Lily3,0,0,0,,Sampai semuanya tenang,
Dialog: 0,0:41:10.57,0:41:13.21,Default,Lily3,0,0,0,,ada beberapa kekhawatiran,
Dialog: 0,0:41:13.41,0:41:16.38,Default,Lily3,0,0,0,,itulah sebabnya aku mengumpulkanmu di sini.
Dialog: 0,0:41:18.71,0:41:20.62,Default,Lily3,0,0,0,,Andong Kims dan Phunyang Chos
Dialog: 0,0:41:20.62,0:41:22.45,Default,Lilia3,0,0,0,,bermusuhan untuk waktu yang lama.
Dialogue: 0,0:41:23.15,0:41:25.75,Default,Lily3,0,0,0,,Kita bersatu sebentar,
Dialog: 0,0:41:25.75,0:41:27.69,Default,Lily3,0,0,0,,untuk menghadapi musuh bersama - raja.
Dialog: 0,0:41:27.96,0:41:29.86,Default,Lily3,0,0,0,,Tetapi sekarang raja telah meninggalkan permainan,
Dialog: 0,0:41:29.86,0:41:32.23,Default,Lily3,0,0,0,,dan aku khawatir kedua klan akan mulai bertengkar lagi
Dialog: 0,0:41:32.23,0:41:34.00,Default,Lily3,0,0,0,,dan bersaing satu sama lain.
Dialog: 0,0:41:35.20,0:41:36.23,Default,Lily3,0,0,0,,Sebelum
Dialog: 0,0:41:37.33,0:41:39.20,Default,Lily3,0,0,0,,mari beralih ke agenda,
Dialog: 0,0:41:40.04,0:41:41.97,Default,Lily3,0,0,0,,Saya menyiapkan sesuatu untuk diperkuat
Dialog: 0,0:41:41.97,0:41:43.64,Default,Lily3,0,0,0,,penyatuan dua keluarga.
Dialog: 0,0:41:52.28,0:41:55.58,Default,Lily3,0,0,0,,Pemberontakan di istana...
Dialog: 0,0:41:59.55,0:42:00.82,Default,Lily3,0,0,0,,Pindahkan atau gulingkan?
Dialog: 0,0:42:02.22,0:42:03.22,Default,Lily3,0,0,0,,Artinya,
Dialog: 0,0:42:04.73,0:42:06.09,Default,Lilia3,0,0,0,,bahwa Anda merencanakan pengkhianatan.
Dialog: 0,0:42:07.33,0:42:10.23,Default,Lily3,0,0,0,,Itu tersembunyi di kedalaman jiwamu.
Dialog: 0,0:42:10.90,0:42:12.90,Default,Lily3,0,0,0,,Raja sudah mati,
Dialog: 0,0:42:12.90,0:42:15.20,Default,Lily3,0,0,0,,mengapa meninggalkan dokumen seperti itu?
Dialog: 0,0:42:15.20,0:42:17.61,Default,Lily3,0,0,0,,Untuk berbagi tanggung jawab.
Dialog: 0,0:42:18.34,0:42:22.08,Default,Lily3,0,0,0,,Ini akan mencegah keluarga mana pun melanggar ketentuan aliansi.
Dialog: 0,0:42:22.38,0:42:24.71,Default,Lily3,0,0,0,,Saya akan meninggalkan bukti untuk menekankan bahwa kita berada di perahu yang sama.
Dialog: 0,0:42:26.11,0:42:27.75,Default,Lily3,0,0,0,,Selama Anda setuju dengan ini,
Dialog: 0,0:42:28.35,0:42:31.92,Default,Lily3,0,0,0,,Saya jamin dua keluarga bisa
Dialog: 0,0:42:32.99,0:42:34.96,Default,Lily3,0,0,0,, hidup berdampingan dalam kekuasaan.
Dialog: 0,0:42:35.49,0:42:36.79,Default,Lily3,0,0,0,,Artinya,
Dialog: 0,0:42:37.46,0:42:40.53,Default,Lily3,0,0,0,,bahwa Anda ingin mengendalikan hidup kami.
Dialog: 0,0:42:46.33,0:42:49.10,Default,Lily3,0,0,0,,Kita tidak bisa melakukan ini.
Dialog: 0,0:42:55.01,0:42:57.05,Default,Lily3,0,0,0,,Apa yang kamu izinkan?
Dialog: 0,0:42:57.05,0:42:58.81,Default,Lily3,0,0,0,,Beraninya kamu mengumpulkan tentara?
Dialog: 0,0:43:00.62,0:43:02.48,Default,Lily3,0,0,0,,Anda harus setuju dengan saya,
Dialog: 0,0:43:03.99,0:43:06.05,Default,Lily3,0,0,0,,untuk keluar dari sini hidup-hidup.
Dialog: 0,0:43:14.10,0:43:15.53,Default,Lily3,0,0,0,,Kim Byunin
Dialog: 0,0:43:37.72,0:43:38.72,Default,galeri tembak4,0,0,0,,Yang Mulia.
Dialog: 0,0:43:38.85,0:43:41.76,Default,tier4,0,0,0,,Ya. Masuk.
Dialog: 0,0:43:48.43,0:43:50.57,Default, galeri menembak4,0,0,0,,-Yang Mulia.\N-Apakah Anda menemukan sesuatu?
Dialogue: 0,0:43:50.57,0:43:53.77,Default,shooting gallery4,0,0,0,,Seperti katamu, gerbang istana
Dialog: 0,0:43:54.97,0:43:58.14,Default, galeri menembak4,0,0,0,,dan semua gerbang di sekitar Hanyang ditutup.
Dialogue: 0,0:43:59.17,0:44:00.24,Default,shooting gallery4,0,0,0,,Aku mengetahuinya.
Dialog: 0,0:44:01.14,0:44:02.31,Default,galeri tembak4,0,0,0,,Bagaimana dengan para pejuang?
Dialog: 0,0:44:02.31,0:44:03.58,Default,galeri tembak4,0,0,0,,Satu tempat tersisa,
Dialog: 0,0:44:03.58,0:44:05.35,Default,galeri tembak4,0,0,0,,tempat para pejuang melanjutkan pencarian mereka.
Dialogue: 0,0:44:06.05,0:44:07.82,Default,shooting gallery4,0,0,0,,Ini di sebelah tebing.
Dialogue: 0,0:44:08.62,0:44:11.75,Default,tyra4,0,0,0,,Aku menemukanmu, Cheoljong. aku akan menyelamatkanmu.
Dialogue: 0,0:44:16.32,0:44:18.99,Default,shooting gallery4,0,0,0,,Ada yang membuatku mengantuk. Anda harus pergi juga.
Dialogue: 0,0:44:22.96,0:44:24.50,Default,shooting gallery4,0,0,0,,Betapa aku ingin tidur!
Dialogue: 0,0:44:27.94,0:44:29.34,Default,shooting gallery4,0,0,0,,Aku mau pingsan sekarang.
Dialog: 0,0:44:29.34,0:44:31.57,Default,tyra4,0,0,0,,Selamat malam, Yang Mulia.
Dialog: 0,0:44:31.97,0:44:33.74,Default,tyra4,0,0,0,,Mimpi indah, ratu.
Dialog: 0,0:44:34.21,0:44:36.34,Default,tier4,0,0,0,,Ya. Selamat malam juga untukmu.
Dialog: 0,0:44:36.54,0:44:37.65,Default,tier4,0,0,0,,Ya.
Dialogue: 0,0:44:41.38,0:44:42.72,Default,tier4,0,0,0,,Jadilah sehat.
Dialog: 0,0:44:44.49,0:44:45.65,Default,galeri tembak4,0,0,0,,Apa?
Dialogue: 0,0:44:45.92,0:44:49.39,Default,tyra4,0,0,0,,Kalau soal kesehatan, jangan gegabah.
Dialog: 0,0:44:51.73,0:44:52.99,Default,tyra4,0,0,0,,-Ya, ratu.\N-Ya, ratu.
Dialog: 0,0:45:25.99,0:45:27.00,Default,galeri tembak4,0,0,0,,Dimana ratunya?
Dialog: 0,0:45:27.03,0:45:29.10,Default,tyra4,0,0,0,,Dia kehilangan kesadaran karena syok,
Dialogue: 0,0:45:29.10,0:45:30.27,Default,shooting gallery4,0,0,0,,tapi dia segera sadar.
Dialog: 0,0:45:30.60,0:45:31.70,Default,galeri tembak4,0,0,0,,Kehilangan kesadaran?
Dialog: 0,0:45:37.94,0:45:39.37,Default,galeri tembak4,0,0,0,,Mau kemana?
Dialogue: 0,0:45:52.52,0:45:56.02,Default,shooting gallery4,0,0,0,,Bukan itu yang aku pikirkan, kan?
Dialogue: 0,0:45:57.43,0:45:59.66,Default,shooting gallery4,0,0,0,,Apakah kamu benar-benar siap melangkah sejauh itu?
Dialogue: 0,0:46:02.33,0:46:04.20,Default,shooting gallery4,0,0,0,,-Lanjutkan saja.\N-Kamu tidak akan pergi.
Dialog: 0,0:46:04.87,0:46:07.20,Default,galeri tembak4,0,0,0,,Jika kamu meninggalkan istana, kamu akan berada dalam bahaya.
Dialogue: 0,0:46:07.27,0:46:08.70,Default,shooting gallery4,0,0,0,,Kamu pikir aku tidak tahu ini?
Dialog: 0,0:46:09.20,0:46:10.41,Default,galeri tembak4,0,0,0,,Aku tahu segalanya.
Dialog: 0,0:46:10.41,0:46:12.71,Default,tyra4,0,0,0,,Kamu menggunakan aku sebagai umpan untuk raja,
Dialog: 0,0:46:12.71,0:46:15.08,Default,tyra4,0,0,0,,dan kaulah yang mengarahkan pedang ke arahnya.
Dialog: 0,0:46:16.21,0:46:17.45,Default, galeri menembak4,0,0,0,,Saya tahu segalanya.
Dialogue: 0,0:46:17.65,0:46:19.88,Default,shooting gallery4,0,0,0,,Selama kamu aman,
Dialogue: 0,0:46:19.88,0:46:21.85,Default,tyra4,0,0,0,,Aku siap menahan kebencianmu.
Dialogue: 0,0:46:22.15,0:46:24.05,Default,shooting gallery4,0,0,0,,Marahlah padaku sesukamu.
Dialogue: 0,0:46:24.32,0:46:25.99,Default,shooting gallery4,0,0,0,,Dan sudah menyerah.
Dialog: 0,0:46:26.42,0:46:28.26,Default,galeri tembak4,0,0,0,,Raja sudah mati.
Dialog: 0,0:46:28.26,0:46:30.79,Default,tier4,0,0,0,,Tidak. Dia masih hidup.
Dialogue: 0,0:46:31.79,0:46:34.30,Default,shooting gallery4,0,0,0,,Kau tahu, raja bukanlah orang yang mudah mati.
Dialogue: 0,0:46:34.66,0:46:37.07,Default,tyra4,0,0,0,,Bukankah itu sebabnya kamu terburu-buru dengan penobatan?
Dialog: 0,0:46:37.07,0:46:38.17,Default,galeri tembak4,0,0,0,,Yang Mulia.
Dialog: 0,0:46:39.37,0:46:40.37,Default, galeri menembak4,0,0,0,,Tolong.
Dialog: 0,0:46:42.07,0:46:44.51,Default,galeri tembak4,0,0,0,,Kamu harus meninggalkan raja untuk bertahan hidup.
Dialogue: 0,0:46:47.68,0:46:49.51,Default,shooting gallery4,0,0,0,,Kamu ingin tahu kenapa aku memilih raja?
Dialogue: 0,0:46:50.61,0:46:52.58,Default,shooting gallery4,0,0,0,,Aku akan menjawabmu.
Dialog: 0,0:46:53.18,0:46:55.25,Default,galeri tembak4,0,0,0,,Jika ada yang pantas menjadi raja,
Dialog: 0,0:46:55.62,0:46:57.52,Default,tier4,0,0,0,,maka hanya Yang Mulia.
Dialogue: 0,0:46:58.32,0:47:00.49,Default,shooting gallery4,0,0,0,,Dia adalah kandidat yang paling cocok.
Dialogue: 0,0:47:01.12,0:47:04.86,Default,shooting gallery4,0,0,0,,Jadi jangan coba-coba menentukan pilihan untukku.
Dialogue: 0,0:47:04.86,0:47:05.99,Default,shooting gallery4,0,0,0,,Jika dilanjutkan,
Dialogue: 0,0:47:12.63,0:47:14.20,Default,shooting gallery4,0,0,0,,kamu tidak akan memberiku pilihan.
Dialogue: 0,0:47:15.94,0:47:18.94,Default,shooting gallery4,0,0,0,,Soyeon, bagaimana kamu bisa mengarahkan panah ke arahku?
Dialog: 0,0:47:19.17,0:47:20.64,Default,menembak4,0,0,0,,Kamu tahu perasaanku.
Dialog: 0,0:47:21.88,0:47:24.11,Default,tyra4,0,0,0,,Jika kamu sangat mencintainya,
Dialog: 0,0:47:24.81,0:47:26.88,Default,tyra4,0,0,0,,bukankah seharusnya aku mengerti,
Dialog: 0,0:47:26.88,0:47:28.72,Default,tyra4,0,0,0,,bahwa Kim So-yeon telah berubah?
Dialogue: 0,0:47:31.39,0:47:32.42,Default,shooting gallery4,0,0,0,,Lihat aku.
Dialogue: 0,0:47:32.69,0:47:35.69,Default,tyra4,0,0,0,, Benarkah aku wanita yang selama ini kamu impikan?
Dialogue: 0,0:47:35.69,0:47:38.23,Default,tyra4,0,0,0,,Aku adalah orang yang benar-benar berbeda di dalam, tapi kamu tidak mengetahuinya.
Dialog: 0,0:47:38.76,0:47:40.06,Default,tyra4,0,0,0,,Orang yang kamu cintai, -
Dialogue: 0,0:47:41.20,0:47:42.83,Default,shooting4,0,0,0,,hanya cangkang.
Dialog: 0,0:47:42.86,0:47:44.80,Default,tyra4,0,0,0,,-Soyeon.\N-Soyeon asli, yang kamu cintai,
Dialog: 0,0:47:44.80,0:47:46.17,Default, galeri menembak4,0,0,0,,tidak lebih.
Dialogue: 0,0:47:47.44,0:47:49.44,Default,shooting gallery4,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:47:54.74,0:47:57.25,Default,galeri tembak4,0,0,0,,Soyeon yang asli tidak bisa menembakmu,
Dialog: 0,0:47:57.91,0:47:59.98,Default,tira4,0,0,0,,karena aku mencintaimu seperti saudara.
Dialogue: 0,0:48:01.12,0:48:02.42,Default,shooting gallery4,0,0,0,,Tapi aku berbeda.
Dialogue: 0,0:48:05.02,0:48:07.12,Default,shooting gallery4,0,0,0,,Aku bisa menembakmu sebanyak yang aku mau.
Dialogue: 0,0:48:18.77,0:48:20.10,Default,shooting gallery4,0,0,0,,Aku sudah memperingatkanmu!
Dialog: 0,0:48:21.67,0:48:23.37,Default,tyra4,0,0,0,,Aku tidak ingin menyakitinya.
Dialog: 0,0:49:03.95,0:49:04.98,Default,galeri tembak4,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:49:06.35,0:49:08.92,Default,shooting gallery4,0,0,0,,Sangat jelas sehingga kami memutuskan itu adalah sebuah petunjuk.
Dialog: 0,0:49:09.42,0:49:11.52,Default,ruang tembak4,0,0,0,,Saya datang karena saya ingin hidup.
Dialog: 0,0:49:11.82,0:49:15.06,Default,tyra4,0,0,0,,Saat aku tidak melihatmu, aku merasa seperti akan mati karena kecemasan.
Dialogue: 0,0:49:16.96,0:49:18.43,Default,shooting gallery4,0,0,0,,Lupakan dan kembali lagi.
Dialog: 0,0:49:19.69,0:49:20.90,Default, galeri menembak4,0,0,0,,Tidak, ratu.
Dialogue: 0,0:49:21.00,0:49:23.36,Default,shooting gallery4,0,0,0,,Jika kamu ingin pergi sendiri, kamu harus menginjakku.
Dialog: 0,0:49:32.91,0:49:34.51,Default,galeri tembak4,0,0,0,,Empat hari lagi.
Dialog: 0,0:49:36.94,0:49:38.68,Default,galeri tembak4,0,0,0,,Penobatan dalam empat hari.
Dialogue: 0,0:49:38.68,0:49:40.95,Default,shooting gallery4,0,0,0,,Bagaimana cara mencari di seluruh hutan
Dialog: 0,0:49:40.95,0:49:43.05,Default, galeri menembak4,0,0,0,,dan akankah kamu menemukan raja sendirian?
Dialogue: 0,0:49:45.92,0:49:47.16,Default,shooting gallery4,0,0,0,,Apakah kamu sedang nyengir sekarang?
Dialog: 0,0:49:47.39,0:49:48.59,Default,galeri tembak4,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:49:49.02,0:49:50.93,Default,galeri tembak4,0,0,0,,Ada banyak hewan liar di pegunungan.
Dialogue: 0,0:49:50.93,0:49:52.63,Default,shooting gallery4,0,0,0,,Kamu tidak akan bertahan lama disana.
Dialog: 0,0:49:52.86,0:49:54.60,Default,galeri tembak4,0,0,0,,Serigala bisa memakanmu.
Dialog: 0,0:49:55.30,0:49:57.97,Default,galeri tembak4,0,0,0,,Atau para pejuang mungkin menemukan tubuhmu yang membeku.
Dialogue: 0,0:49:58.70,0:50:02.47,Default,shooting gallery4,0,0,0,,Bagaimana bisa. Sangat menakutkan! Saya benar-benar gemetar ketakutan.
Dialogue: 0,0:50:02.47,0:50:04.01,Default,shooting gallery4,0,0,0,,Ucapkan apa yang kamu inginkan: jangan menakutiku.
Dialogue: 0,0:50:05.17,0:50:06.21,Default,shooting gallery4,0,0,0,,Ayo kembali.
Dialog: 0,0:50:06.41,0:50:08.58,Default,tyra4,0,0,0,,Karena ratu tidak ingin kita pergi bersamanya,
Dialogue: 0,0:50:08.58,0:50:11.48,Default,shooting gallery4,0,0,0,,kami akan dihukum karena tidak mampu menghentikannya,
Dialog: 0,0:50:11.71,0:50:14.52,Default,tyra4,0,0,0,,akan memaksa kita meminum cawan racun,
Dialogue: 0,0:50:15.28,0:50:17.85,Default,shooting gallery4,0,0,0,,dan kita akan tertidur abadi.
Dialog: 0,0:50:32.33,0:50:34.30,Default, galeri menembak4,0,0,0,,Oke. Kamu bisa ikut denganku.
Dialogue: 0,0:50:38.11,0:50:39.37,Default,shooting gallery4,0,0,0,,Ini bukan liburan,
Dialogue: 0,0:50:39.37,0:50:40.41,Default,shooting gallery4,0,0,0,,mengapa kamu memerlukannya?
Dialog: 0,0:50:40.74,0:50:43.08,Default,galeri tembak4,0,0,0,,Bagaimana caramu melewati benteng di Hanyang?
Dialogue: 0,0:50:44.21,0:50:47.22,Default,shooting gallery4,0,0,0,,Kupikir aku bisa saja melompati tembok,
Dialogue: 0,0:50:47.22,0:50:49.15,Default,shooting gallery4,0,0,0,,tapi sekarang karenamu semuanya tidak akan berjalan seperti itu.
Dialogue: 0,0:50:49.22,0:50:53.59,Default,shooting gallery4,0,0,0,,Benteng di Hanyang sangat tinggi, bagaimana cara melompatinya?
Dialogue: 0,0:50:55.19,0:50:56.52,Default,shooting gallery4,0,0,0,,Apakah kamu menertawakanku lagi?
Dialogue: 0,0:50:58.36,0:51:01.43,Default,shooting gallery4,0,0,0,,Kami sudah mengurus semuanya. Anda tidak perlu khawatir.
Dialog: 0,0:51:14.85,0:51:16.08, Default, galeri menembak4,0,0,0,, Yang Mulia.
Dialogue: 0,0:51:25.37,0:51:26.91,Default,shooting gallery4,0,0,0,,Kupikir kita akan merayakannya,
Dialog: 0,0:51:27.41,0:51:29.51,Default,tier4,0,0,0,,tapi dilihat dari wajahmu, kamu sedang mengalami kekalahan.
Dialogue: 0,0:51:29.68,0:51:31.51,Default,tyra4,0,0,0,,Luka apa yang bisa kamu sembuhkan seperti ini?
Dialog: 0,0:51:31.97,0:51:33.47,Default,galeri tembak4,0,0,0,,Di mana kamu terluka?
Dialogue: 0,0:51:35.72,0:51:38.49,Default,shooting gallery4,0,0,0,,Sentuh cangkirku lagi,
Dialog: 0,0:51:38.95,0:51:41.49,Default,tyra4,0,0,0,,dan aku akan memotong tanganmu.
Dialog: 0,0:51:46.36,0:51:48.43,Default,tyra4,0,0,0,,Jika kamu sangat mencintainya,
Dialog: 0,0:51:48.82,0:51:50.66,Default,tyra4,0,0,0,,bukankah seharusnya aku mengerti,
Dialog: 0,0:51:50.89,0:51:52.74,Default,tyra4,0,0,0,,bahwa Kim So-yeon telah berubah?
Dialogue: 0,0:51:53.37,0:51:56.26,Default,tyra4,0,0,0,,Tadi malam dia tampak persis sepertimu.
Dialog: 0,0:51:58.91,0:52:01.37,Default,galeri tembak4,0,0,0,,Apa? Cinta?
Dialogue: 0,0:52:02.20,0:52:03.70,Default,shooting gallery4,0,0,0,,Sungguh menjijikkan!
Dialogue: 0,0:52:04.18,0:52:05.55,Default,shooting gallery4,0,0,0,,Saya sudah bingung,
Dialogue: 0,0:52:05.55,0:52:06.91,Default,shooting gallery4,0,0,0,,dan yang kamu bicarakan di sini adalah cinta.
Dialogue: 0,0:52:29.91,0:52:31.11,Default,shooting gallery4,0,0,0,,Kamu terlambat.
Dialog: 0,0:52:32.70,0:52:34.34, Default, galeri menembak4,0,0,0,, Pergi ke kamarmu dan istirahat.
Dialogue: 0,0:52:34.70,0:52:37.14,Default,shooting gallery4,0,0,0,,Kompor menyala, jadi hangat.
Dialog: 0,0:52:37.55,0:52:40.22,Default,tyra4,0,0,0,,Kenapa kamu tidak bertanya apa pun?
Dialog: 0,0:52:41.09,0:52:42.78,Default,tyra4,0,0,0,,Karena saya seorang ayah.
Dialog: 0,0:52:53.03,0:52:54.93,Default,galeri tembak4,0,0,0,,Apa yang mereka lakukan?
Dialog: 0,0:52:54.93,0:52:57.70,Default,menembak4,0,0,0,,Surat dengan rencana makar.
Dialogue: 0,0:52:58.09,0:53:00.87,Default,menembak4,0,0,0,,Tanpa sepengetahuanku? Ini sangat berisiko.
Dialogue: 0,0:53:00.87,0:53:02.91,Default,shooting gallery4,0,0,0,,Segera setelah kita mendapatkannya, itu akan menjadi senjata kita,
Dialog: 0,0:53:02.91,0:53:04.24,Default,tier4,0,0,0,,jadi jangan khawatir.
Dialogue: 0,0:53:04.64,0:53:06.43,Default,shooting gallery4,0,0,0,,Aku akan membawakannya padamu.
Dialog: 0,0:53:06.74,0:53:08.05,Default,tyra4,0,0,0,,Anda dituduh melakukan makar.
Dialogue: 0,0:53:08.05,0:53:10.41,Default,shooting gallery4,0,0,0,,Jika kamu kembali segera setelah raja menghilang,
Dialogue: 0,0:53:11.87,0:53:13.24,Default,shooting gallery4,0,0,0,,ini akan mencurigakan.
Dialogue: 0,0:53:13.72,0:53:15.59,Default,shooting gallery4,0,0,0,,Saya tidak ingin kembali.
Dialogue: 0,0:53:16.24,0:53:18.01,Default,shooting gallery4,0,0,0,,Aku akan senang,
Dialogue: 0,0:53:18.86,0:53:22.28,Default,shooting gallery4,0,0,0,,jika aku bisa terus membantumu dari bayang-bayang.
Dialog: 0,0:53:25.62,0:53:29.12,Default,tyra4,0,0,0,,Ngomong-ngomong, kudengar ratu meninggalkan istana pada malam hari.
Dialogue: 0,0:53:29.97,0:53:32.39,Default,tyra4,0,0,0,,Beraninya dia kabur di tengah malam?
Dialog: 0,0:53:33.66,0:53:35.61,Default,tyra4,0,0,0,,Saya tidak memberi tahu siapa pun tentang ini,
Dialog: 0,0:53:35.91,0:53:37.30,Default,tier4,0,0,0,,tetapi Anda sudah mengetahui segalanya.
Dialog: 0,0:53:37.47,0:53:40.24,Default,tyra4,0,0,0,,Mengetahui seperti apa seorang ratu,
Dialogue: 0,0:53:40.70,0:53:42.91,Default,tyra4,0,0,0,,Menurutku dia tidak kabur begitu saja.
Dialog: 0,0:53:43.68,0:53:44.82,Default,galeri tembak4,0,0,0,,Lalu kenapa?
Dialogue: 0,0:53:45.84,0:53:49.51,Default,shooting gallery4,0,0,0,,Aku yakin dia ingin mencari raja untuk mengembalikan semuanya ke tempatnya.
Dialog: 0,0:53:50.34,0:53:54.68,Default,tyra4,0,0,0,,Dia harus yakin bahwa raja masih hidup.
Dialog: 0,0:53:55.62,0:53:59.30,Default,tyra4,0,0,0,,Dia pasti punya alasan untuk mempercayai ini.
Dialog: 0,0:53:59.30,0:54:02.07,Default,tyra4,0,0,0,,Dia melepas gaunnya dan meninggalkan istana,
Dialog: 0,0:54:02.07,0:54:03.30,Default,tier4,0,0,0,,yang artinya
Dialog: 0,0:54:04.49,0:54:07.03,Default,tyra4,0,0,0,,sekarang dia hanyalah wanita biasa.
Dialog: 0,0:54:07.30,0:54:09.20,Default,tyra4,0,0,0,,Bahkan mengetahui bahwa dia berbohong,
Dialog: 0,0:54:09.20,0:54:12.11,Default,tira4,0,0,0,,Saya mencoba menerimanya demi Byonin.
Dialog: 0,0:54:13.53,0:54:15.97,Default,tyra4,0,0,0,,Pasangan kerajaan tampaknya sangat saling mencintai,
Dialog: 0,0:54:16.74,0:54:20.34,Default,tyra4,0,0,0,,jadi kenapa kita tidak menguburnya bersama-sama.
Dialogue: 0,0:54:22.49,0:54:24.51,Default,shooting gallery4,0,0,0,,Jaga ini?
Dialog: 0,0:54:36.57,0:54:37.59,Default,menembak4,0,0,0,,Tn.
Dialog: 0,0:54:37.97,0:54:40.87,Default,tyra4,0,0,0,,Saya telah kembali untuk membantu Janda Ratu.
Dialogue: 0,0:54:42.37,0:54:46.11,Default,tyra4,0,0,0,,Apakah ini yang bertanggung jawab atas kematian raja?
Dialog: 0,0:54:46.74,0:54:47.80,Default,tier4,0,0,0,,Ya.
Dialog: 0,0:54:47.80,0:54:49.68,Default,tyra4,0,0,0,,Kami hanya mengumpulkan tanaman herbal.
Dialog: 0,0:54:49.84,0:54:52.34,Default,tyra4,0,0,0,,Kami belum pernah bertemu raja.
Dialogue: 0,0:54:53.24,0:54:56.34,Default,shooting gallery4,0,0,0,,Ternyata, makhluk tak berakar seperti itu
Dialog: 0,0:54:56.72,0:54:59.01,Default,tyra4,0,0,0,,menangkap seekor naga tanpa menyadarinya.
Dialogue: 0,0:55:25.32,0:55:27.59,Default,shooting gallery4,0,0,0,,Kamu melonjak begitu tajam, rupanya semuanya baik-baik saja denganmu.
Dialogue: 0,0:55:28.14,0:55:29.55,Default,shooting gallery4,0,0,0,,Saya pikir kamu sudah mati.
Dialog: 0,0:55:30.01,0:55:31.05,Default,galeri tembak4,0,0,0,,Siapa kamu?
Dialog: 0,0:55:31.05,0:55:33.59,Default,galeri tembak4,0,0,0,,Bagaimana menurut anda? Tentu saja ahli herbal.
Dialogue: 0,0:55:33.72,0:55:35.66,Default,shooting gallery4,0,0,0,,Kenapa lagi aku harus tinggal di hutan?
Dialogue: 0,0:55:37.43,0:55:38.99,Default,shooting gallery4,0,0,0,,Apakah kamu yang menyelamatkanku?
Dialogue: 0,0:55:39.86,0:55:43.32, Default, galeri menembak4,0,0,0,, Tidak juga. Anggap saja aku menemukanmu dan membawamu ke sini.
Dialog: 0,0:55:43.62,0:55:45.24,Default,tyra4,0,0,0,,Kamu mengenakan pakaian mahal,
Dialog: 0,0:55:45.24,0:55:47.16,Default,tier4,0,0,0,,jadi kupikir kamu
Dialog: 0,0:55:47.16,0:55:49.01,Default,tyra4,0,0,0,,balas aku karena telah menyelamatkan hidupku.
Dialogue: 0,0:55:49.01,0:55:50.43,Default,shooting gallery4,0,0,0,,Kamu harus membayar semuanya, tahu?
Dialog: 0,0:55:51.78,0:55:53.37, Default, galeri menembak4,0,0,0,, Tapi kamu tidak punya apa-apa.
Dialogue: 0,0:55:53.74,0:55:56.11,Default,tyra4,0,0,0,,Kainnya terlihat mahal,
Dialog: 0,0:55:56.11,0:55:58.82,Default,tier4,0,0,0,,tapi saya tidak bisa menjual kain ini.
Dialogue: 0,0:56:00.18,0:56:01.49,Default,shooting gallery4,0,0,0,,Aku baru saja membakar semuanya.
Dialog: 0,0:56:02.78,0:56:03.78,Default,galeri tembak4,0,0,0,,Bakar?
Dialog: 0,0:56:03.78,0:56:07.49,Default,galeri tembak4,0,0,0,,Ada prajurit yang berjalan kemana-mana dan mencari sesuatu.
Dialogue: 0,0:56:09.45,0:56:11.93,Default,shooting gallery4,0,0,0,,Apakah aku salah membawamu kesini?
Dialog: 0,0:56:13.43,0:56:14.47,Default,galeri tembak4,0,0,0,,Kolektor!
Dialogue: 0,0:56:16.20,0:56:18.26,Default,shooting gallery4,0,0,0,,Jika kamu kabur tanpa membayar,
Dialogue: 0,0:56:18.26,0:56:20.09,Default,shooting gallery4,0,0,0,,Aku akan memotong tanganmu.
Dialog: 0,0:56:21.74,0:56:22.84,Default,galeri tembak4,0,0,0,,Ingat.
Dialogue: 0,0:56:34.72,0:56:36.41,Default,shooting gallery4,0,0,0,,Aku membawakanmu yang terbaik.
Dialogue: 0,0:56:53.47,0:56:55.47,Default,shooting gallery4,0,0,0,,Jadi, jadi, dan apa selanjutnya?
Dialog: 0,0:56:55.47,0:56:58.18,Default,tyra4,0,0,0,,Jadi, saat pemakaman mereka menggunakan mayat orang lain.
Dialog: 0,0:56:58.18,0:57:00.74,Default,tyra4,0,0,0,,Jika mereka dapat mengadakan penobatan dalam waktu 6 hari,
Dialog: 0,0:57:01.55,0:57:02.57,Default, galeri menembak4,0,0,0,, permainan berakhir.
Dialogue: 0,0:57:03.55,0:57:05.12,Default,shooting gallery4,0,0,0,,Bagaimana kamu mengetahui hal ini?
Dialogue: 0,0:57:05.12,0:57:07.34,Default,shooting gallery4,0,0,0,,Para idiot ini sangat mudah ditebak!
Dialog: 0,0:57:08.09,0:57:10.84,Default,galeri tembak4,0,0,0,,Para idiot ini pantas mendapat hukuman!
Dialogue: 0,0:57:23.80,0:57:25.59,Default,Spillik,0,0,0,,Ini pengakuan salah satu pengikut Tonhak.
Dialog: 0,0:57:26.24,0:57:28.51,Default,Spillik,0,0,0,,Saya sudah punya gambaran siapa yang harus disalahkan dalam hal ini.
Dialogue: 0,0:57:29.07,0:57:30.70,Default,Spillik,0,0,0,,Cari momen yang tepat setelah penobatan,
Dialog: 0,0:57:30.70,0:57:32.01,Default,Spillik,0,0,0,,untuk mengumumkan ini.
Dialog: 0,0:57:34.24,0:57:35.24,Default,Spillit,0,0,0,,Ayah.
Dialog: 0,0:57:37.82,0:57:40.91,Default,Spillik,0,0,0,,Bolehkah aku memintamu menjaga penjaga istana untuk saat ini?
Dialog: 0,0:57:41.74,0:57:42.89,Default,Spillik,0,0,0,,Mengapa?
Dialogue: 0,0:57:44.14,0:57:45.41,Default,Spillit,0,0,0,,Aku sendiri yang menginginkannya
Dialog: 0,0:57:47.18,0:57:49.95,Default,Spillit,0,0,0,,membawa kepala raja dan ratu.
Dialog: 0,0:57:56.99,0:58:00.26,Default,Spillik,0,0,0,,3 hari sebelum penobatan
Dialog: 0,0:58:02.30,0:58:03.34,Default,Spillik,0,0,0,,Benin!
Dialog: 0,0:58:06.07,0:58:08.05,Default,Spillik,0,0,0,,Apakah kamu akan mencari ratu?
Dialog: 0,0:58:09.07,0:58:11.28,Default,Spillik,0,0,0,,Mengapa dia meninggalkan istana?
Dialog: 0,0:58:11.28,0:58:14.14,Default,Spillik,0,0,0,,Kamu harusnya tahu alasannya, kamu sudah begitu dekat.
Dialogue: 0,0:58:14.95,0:58:18.51,Default,Spillit,0,0,0,,Sang Ratu bukan lagi Soyeon yang kukenal.
Dialog: 0,0:58:19.41,0:58:20.41,Default,Spillik,0,0,0,,Apa?
Dialogue: 0,0:58:39.20,0:58:41.64,Default,Spillik,0,0,0,,Aku harus mengembalikan raja.
Dialog: 0,0:58:41.64,0:58:45.22,Default,Spillit,0,0,0,,Semacam kunci tipis. Mungkin aku bisa membukanya.
Dialogue: 0,0:58:52.28,0:58:54.16,Default,Spillik,0,0,0,,Pasti ada sembelit kedua di suatu tempat.
Dialog: 0,0:58:54.39,0:58:55.78,Default,Spillik,0,0,0,,Saya terkejut Anda membukanya.
Dialog: 0,0:58:55.78,0:58:56.95,Default,Spillik,0,0,0,,Hon.
Dialog: 0,0:59:02.39,0:59:04.16,Default,Spillik,0,0,0,,Pangeran Yeonpyeong, kamu baik-baik saja?
Dialog: 0,0:59:06.34,0:59:07.80,Default,Spillik,0,0,0,,Bagaimana kamu sampai di sini?
Dialog: 0,0:59:08.20,0:59:10.53,Default,Spillik,0,0,0,,Kau tahu, aku berteman dengan semua orang di istana.
Dialog: 0,0:59:11.30,0:59:14.70,Default,Spillik,0,0,0,,Kamu dikunci di sini hanya karena kamu adalah teman raja.
Dialog: 0,0:59:15.68,0:59:16.87,Default,Spillik,0,0,0,,Jangan khawatir tentang apa pun.
Dialog: 0,0:59:17.24,0:59:19.87,Default,Spillik,0,0,0,,Aku akan mengeluarkanmu, apa pun yang terjadi.
Dialog: 0,0:59:19.87,0:59:21.34,Default,Spillik,0,0,0,,Kamu adalah teman sejati.
Dialog: 0,0:59:22.24,0:59:25.66,Default,Spillik,0,0,0,,Pengabdianmu tak tergoyahkan bahkan dalam situasi genting seperti ini.
Dialog: 0,0:59:26.51,0:59:27.59,Default,Spillik,0,0,0,,Tentu saja.
Dialogue: 0,0:59:28.22,0:59:31.05,Default,Spillik,0,0,0,,Kamu berteman denganku bukan karena aku berasal dari Andonian Kim.
Dialog: 0,0:59:31.55,0:59:34.99,Default,Spillik,0,0,0,,Dan aku berteman denganmu bukan karena kamu adalah teman dekat raja.
Dialog: 0,0:59:36.89,0:59:38.24,Default,Spillik,0,0,0,,-Tepat.\N-Masalahnya adalah,
Dialog: 0,0:59:38.24,0:59:40.49,Default,Spikyulka,0,0,0,,bahwa sekarang terjadi kekacauan total di istana,\N dan seterusnya.
Dialog: 0,0:59:40.97,0:59:43.61,Default,Spillik,0,0,0,,Mereka ingin menyalahkan pembunuhan raja pada pengikut Tonhak.
Dialog: 0,0:59:44.57,0:59:46.68,Default,Spillik,0,0,0,,Saya khawatir orang yang tidak bersalah akan menderita.
Dialog: 0,0:59:47.43,0:59:48.51,Default,Spillit,0,0,0,,Bahkan ratu
Dialog: 0,0:59:49.57,0:59:52.34,Default,Spillie,0,0,0,,tiba-tiba menghilang di tengah malam.
Dialog: 0,0:59:55.32,0:59:57.76,Default,Spillit,0,0,0,,Apa maksudmu ratu telah menghilang?
Dialog: 0,0:59:57.76,1:00:00.49,Default,Spillie,0,0,0,,Dia menghilang dari istana
Dialog: 0,1:00:01.12,1:00:03.36,Default,Spillik,0,0,0,,bersama dengan nyonya istana dan pelayan.
Dialog: 0,1:00:03.95,1:00:06.39,Default,Biryulka,0,0,0,,Benin baru saja meninggalkan istana
Dialog: 0,1:00:06.39,1:00:08.66,Default,Spillie,0,0,0,,untuk mencarinya,
Dialog: 0,1:00:09.80,1:00:11.99,Default,Spillik,0,0,0,,tapi penampilannya menggangguku.
Dialog: 0,1:00:11.99,1:00:13.24,Default,Spillik,0,0,0,,Kenapa kamu repot-repot?
Dialogue: 0,1:00:13.24,1:00:15.41,Default,Spillik,0,0,0,,Mungkin aku mengada-ada,
Dialog: 0,1:00:16.24,1:00:17.34,Default,Spillik,0,0,0,,tapi dia terlihat seperti ini,
Dialog: 0,1:00:18.30,1:00:20.24,Default,Spillik,0,0,0,,seolah ingin mencabik-cabiknya.
Dialog: 0,1:00:27.57,1:00:28.62,Default,Spillie,0,0,0,,Ibu.
Dialog: 0,1:00:33.05,1:00:34.28,Default,Spillik,0,0,0,,Apa? Untuk apa?
Dialog: 0,1:00:35.39,1:00:36.43,Default,Spillik,0,0,0,,Apa?
Dialog: 0,1:00:41.57,1:00:42.59,Default,Spillik,0,0,0,,Sekarang semuanya beres.
Dialog: 0,1:00:43.89,1:00:44.97,Default,Spillik,0,0,0,,Ayo berangkat.
Dialog: 0,1:00:44.97,1:00:47.57,Default,Spillikins,0,0,0,,Apa itu tadi, Nyonya Choi? Kamu membuatku takut.
Dialogue: 0,1:00:50.01,1:00:51.74,Default,Spillik,0,0,0,,Kamu harus selalu waspada.
Dialog: 0,1:00:53.03,1:00:54.18,Default,Spillik,0,0,0,,Oke.
Dialog: 0,1:00:55.64,1:00:58.07,Default,Spillik,0,0,0,,Kamu selalu berhati-hati. Lulus.
Dialog: 0,1:00:59.24,1:01:00.51,Default,Spillik,0,0,0,,Ayo, lanjutkan.
Dialog: 0,1:01:01.34,1:01:02.45,Default,Spillik,0,0,0,,Biar saya bantu.
Dialog: 0,1:01:03.91,1:01:05.76,Default,Spillik,0,0,0,,Harap berhati-hati.
Dialog: 0,1:01:06.05,1:01:09.45,Default,Spillik,0,0,0,,Wow, aku tidak percaya kamu membawa begitu banyak!
Dialog: 0,1:01:09.78,1:01:10.86,Default,Spillik,0,0,0,,Apa ini?
Dialog: 0,1:01:11.43,1:01:13.03,Default,Spillit,0,0,0,,Manisan akar lonceng.
Dialogue: 0,1:01:13.36,1:01:14.59,Default,Spillit,0,0,0,,Manisan akar lonceng?
Dialog: 0,1:01:14.59,1:01:17.93,Default,Spillik,0,0,0,,Saya menerimanya dari seseorang yang spesial dan sangat menghargainya.
Dialog: 0,1:01:18.49,1:01:19.87,Default,Spillik,0,0,0,,Anda dapat mengambilnya, Yang Mulia.
Dialog: 0,1:01:20.07,1:01:21.70,Default,Spillik,0,0,0,,-Kalau begitu saya akan mencobanya.\N-Tentu saja.
Dialogue: 0,1:01:24.41,1:01:26.93,Default,Spillit,0,0,0,,Sungguh menakjubkan betapa lezatnya ini. Cobalah satu.
Dialog: 0,1:01:26.93,1:01:28.11,Default,Spillik,0,0,0,,Hon Young, dan kamu?
Dialog: 0,1:01:28.61,1:01:30.30,Default,Spillik,0,0,0,,-Baiklah, oke.\N-Ini, coba saja.
Dialog: 0,1:01:30.30,1:01:31.32,Default,Spillik,0,0,0,,Terima kasih.
Dialog: 0,1:01:32.34,1:01:33.47,Default,Spillit,0,0,0,,Ini enak sekali.
Dialogue: 0,1:01:38.39,1:01:41.09,Default,Spillit,0,0,0,,Nyonya Choi! Bagaimana bisa?
Dialog: 0,1:01:41.09,1:01:42.45,Default,Spillik,0,0,0,,-Saya baik-baik saja.\N-Apakah kamu baik-baik saja?
Dialog: 0,1:01:45.30,1:01:46.72,Default,Spillik,0,0,0,,Ya, semuanya baik-baik saja.
Dialog: 0,1:01:47.49,1:01:49.57,Default,Spillik,0,0,0,,Ya Tuhan, aku baik-baik saja, ratu.
Dialog: 0,1:01:49.99,1:01:51.12,Default,Spillik,0,0,0,,-Lanjutkan.\N-Oke!
Dialog: 0,1:01:54.07,1:01:56.53,Default,Spillik,0,0,0,,Di mana rajanya?
Dialog: 0,1:01:58.74,1:02:00.84,Default,Spillik,0,0,0,,Yang Mulia, Anda dibesarkan seperti bunga yang lembut.
Dialog: 0,1:02:00.84,1:02:02.74,Default,Spillik,0,0,0,,Apakah kamu nyaman sekali tidur seperti itu?
Dialog: 0,1:02:03.20,1:02:04.91,Default,Spillik,0,0,0,,Ya. Saya sudah melakukan ini berkali-kali.
Dialog: 0,1:02:06.22,1:02:07.51,Default,Spillik,0,0,0,,Benarkah? Anda?
Dialog: 0,1:02:08.09,1:02:09.51,Default,Spillik,0,0,0,,Bahkan saya belum pernah melakukannya.
Dialog: 0,1:02:09.91,1:02:11.91,Default,Spillie,0,0,0,,Jatuhkan. Ini tidak masuk akal.
Dialog: 0,1:02:11.91,1:02:14.01,Default,Biryulka,0,0,0,,Sudahkah anda melakukan lari paksa sejauh 400 km dengan beban 50 kg?
Dialog: 0,1:02:14.68,1:02:15.78,Default,Spilyk,0,0,0,,400 kilometer?
Dialogue: 0,1:02:20.09,1:02:22.32,Default,Spillik,0,0,0,,Sungguh pemimpi. 400 km? Ayo.
Dialog: 0,1:02:23.49,1:02:25.43,Default,Spillik,0,0,0,,Ya, saya sedikit melebih-lebihkan.
Dialog: 0,1:02:25.43,1:02:26.74,Default,Spillik,0,0,0,,Tapi sudah pasti melewati 200.
Dialog: 0,1:02:26.74,1:02:29.11,Default,Spikilka,0,0,0,,Selama operasi musim dingin kami mencairkan es dan minum...
Dialogue: 0,1:02:30.57,1:02:33.61,Default,Spillik,0,0,0,,Ya, ya, ya. Kami percaya, kami percaya.
Dialog: 0,1:02:34.80,1:02:37.20,Default,Spillik,0,0,0,,Hei! Saya benar-benar serius!
Dialog: 0,1:02:37.20,1:02:39.51,Default,Spillik,0,0,0,,Tentu saja, Yang Mulia.
Dialog: 0,1:02:39.51,1:02:41.24,Default,Spillit,0,0,0,,Aku tidak ingin kamu masuk angin.
Dialog: 0,1:02:42.78,1:02:44.91,Default,Spillik,0,0,0,,Kita bahkan tidak bisa membuat api tanpa tertangkap.
Dialog: 0,1:02:45.51,1:02:47.95,Default,Spillik,0,0,0,,Aku khawatir bagaimana kita akan tidur di malam yang dingin seperti ini.
Dialogue: 0,1:02:48.76,1:02:50.78,Default,Spillik,0,0,0,,Sayang sekali kau mengalami hal ini, ratu.
Dialogue: 0,1:02:51.43,1:02:53.30,Default,Spillik,0,0,0,,Ini omong kosong. Dan itu tidak dingin sama sekali.
Dialog: 0,1:02:53.45,1:02:55.47,Default,Spilyk,0,0,0,,Tidak ada yang sebanding dengan operasi musim dingin kami.
Dialog: 0,1:02:58.20,1:02:59.39,Default,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,1:03:26.49,1:03:28.37,Default,Spillik,0,0,0,,Matikan AC ya?
Dialog: 0,1:03:29.39,1:03:31.76,Default,Spillit,0,0,0,,Saya mungkin masuk angin.
Dialog: 0,1:04:30.53,1:04:31.66,Default,Spillik,0,0,0,,Kami tidak menemukannya.
Dialog: 0,1:04:32.45,1:04:34.49,Default,Spillik,0,0,0,,Berbagi menjadi beberapa kelompok dan sisir seluruh gunung.
Dialog: 0,1:04:34.72,1:04:35.72,Default,Spillik,0,0,0,,-Ya!\N-Ya!
Dialogue: 0,1:04:58.86,1:05:01.09,Default,Spillik,0,0,0,,Entah kenapa perasaanku enak hari ini.
Dialog: 0,1:05:01.86,1:05:05.59,Default,Spillik,0,0,0,,Dengan sinar matahari ini, aku yakin hari ini kita akan menemukan rajanya.
Dialog: 0,1:05:16.47,1:05:18.93,Default,Spillik,0,0,0,,-Kami tidak punya waktu untuk ini. Silakan.\N-Ya, benar.
Dialog: 0,1:05:20.11,1:05:21.24,Default,Spillik,0,0,0,,-Ayo cepat.\N-Kita harus cepat.
Dialog: 0,1:05:21.95,1:05:24.91,Default,Spillik,0,0,0,,-Apakah ini jalannya?\N-Ya, ratu. Mari kita lanjutkan.
Dialog: 0,1:05:29.01,1:05:30.34,Default,Spillik,0,0,0,,Kita hampir sampai.
Dialog: 0,1:05:30.34,1:05:32.76,Default,Spillit,0,0,0,,Sebentar lagi kita akan mencapai tebing.
Dialog: 0,1:05:33.12,1:05:35.68,Default,Spillik,0,0,0,,Kaulah yang begitu percaya diri di usia 20-an.
Dialog: 0,1:05:36.26,1:05:37.53,Default,Spillik,0,0,0,,Energi mengalir deras!
Dialog: 0,1:05:39.09,1:05:41.53,Default,Spillik,0,0,0,,-Mari kita istirahat sejenak.\N-Ya, Yang Mulia.
Dialog: 0,1:05:51.01,1:05:53.93,Default,Spillik,0,0,0,,Harus saya katakan, dunia lebih cerah sekarang,
Dialog: 0,1:05:54.68,1:05:57.45,Default,Spillik,0,0,0,,saat kita berada di luar istana, ratu.
Dialog: 0,1:05:59.74,1:06:02.12,Default,Spillik,0,0,0,,Dan sebelum dia benci meninggalkan istana.
Dialog: 0,1:06:02.28,1:06:03.28,Default,Spillik,0,0,0,,Ya, ya.
Dialog: 0,1:06:05.05,1:06:06.05,Default,Spillik,0,0,0,,Dan kamu, Hong Young?
Dialog: 0,1:06:06.26,1:06:07.99,Default,Spillik,0,0,0,,Mana yang lebih kamu sukai?\NTIstana atau di luarnya?
Dialog: 0,1:06:08.86,1:06:10.53,Default,Spillik,0,0,0,,Di mana Anda berada, Yang Mulia.
Dialogue: 0,1:06:11.28,1:06:13.53,Default,Spillik,0,0,0,,-Itu yang dia bilang.\N-Hei, hentikan.
Dialog: 0,1:06:18.14,1:06:20.07,Default,Spillik,0,0,0,,Ratu, mereka ada di sini.
Dialog: 0,1:06:21.66,1:06:23.16,Default,Spillik,0,0,0,,Ini dia. Tangkap mereka!
Dialog: 0,1:06:23.16,1:06:24.51,Default,Spillik,0,0,0,,Lari, kamu harus bersembunyi!
Dialog: 0,1:06:24.51,1:06:25.70,Default,Spillik,0,0,0,,-Oke.\N-Lari!
Dialog: 0,1:06:28.57,1:06:30.51,Default,Spillik,0,0,0,,Hon Young, temani ratu. Berlari!
Dialog: 0,1:06:31.07,1:06:33.28,Default,Spillit,0,0,0,,Nyonya Choi, mau kemana? Di mana?
Dialog: 0,1:06:34.01,1:06:36.72,Default,Spillik,0,0,0,,Jangan berani-berani, Geeks! Aku tidak akan mengizinkannya!
Dialog: 0,1:06:36.72,1:06:38.12,Default,Spillik,0,0,0,,Yang Mulia, kita harus lari.
Dialog: 0,1:06:38.45,1:06:40.62,Default,Spillit,0,0,0,,-Nyonya Pengadilan Choi!\N-Saya tidak akan membiarkan Anda masuk!
Dialog: 0,1:06:40.62,1:06:41.78,Default,Spillie,0,0,0,,Biarkan aku pergi!
Dialog: 0,1:06:43.36,1:06:44.53,Default,Spillik,0,0,0,,Yang Mulia...
Dialog: 0,1:06:47.55,1:06:48.57,Default,Spillik,0,0,0,,Tidak!
Dialog: 0,1:06:49.76,1:06:51.37,Default,Spillik,0,0,0,,Kembali!
Dialog: 0,1:07:04.95,1:07:06.24,Default,Spillit,0,0,0,,-Nyonya Choi!\N-Ratu!
Dialog: 0,1:07:06.74,1:07:07.84,Default,Spillik,0,0,0,,Tidak, tolong!
Dialog: 0,1:07:09.84,1:07:10.84,Default,Spillik,0,0,0,,Ambil mereka!
Dialog: 0,1:07:11.18,1:07:12.59,Default,Spillik,0,0,0,,Saya mohon, hentikan.
Dialog: 0,1:07:14.38,1:07:16.96,Default,Spillik,0,0,0,,Tidak! Tidak perlu.
Dialog: 0,1:07:16.96,1:07:20.20,Default,Spillit,0,0,0,,-Nyonya Choi!\N-Ratu! Silakan...
Dialog: 0,1:07:20.92,1:07:24.50,Default,Spillit,0,0,0,,-Nyonya Choi!\N-Tidak. TIDAK!
Dialog: 0,1:07:26.33,1:07:30.33,Default,Spillik,0,0,0,,-Tidak! Nyonya Istana Choi!\N-Kita harus melarikan diri, ratu!
Dialog: 0,1:07:30.63,1:07:31.88,Default,Spillit,0,0,0,,Nyonya Choi!
Dialog: 0,1:07:34.28,1:07:35.34,Default,Spillik,0,0,0,,Yang Mulia!
Dialog: 0,1:07:35.71,1:07:39.92,Default,Spillit,0,0,0,,Lari! Ratu, aku mohon, lari!
Dialog: 0,1:07:50.83,1:07:52.72,Default,Spillik,0,0,0,,Yang Mulia, saya harap Anda menemukan raja.
Dialog: 0,1:07:57.17,1:07:58.33,Default,Spillit,0,0,0,,Hon Young!
Dialog: 0,1:07:59.26,1:08:00.33,Default,Spillie,0,0,0,,Ikuti dia!
Dialog: 0,1:09:22.21,1:09:23.51,Default,Spillik,0,0,0,,Siapa kamu?
Dialog: 0,1:09:25.25,1:09:28.08,Default,Spillik,0,0,0,,Apa yang kamu lakukan dengan Soyeon?
Dialogue: 0,1:09:43.63,1:09:47.91,Default,Spillit,0,0,0,,Bagaimana aku menjadi ratu
Dialog: 0,1:10:07.86,1:10:10.29,Default,Spillik,0,0,0,,Kamu bilang kamu tahu segalanya tentang aku dan Soyeon.
Dialog: 0,1:10:11.59,1:10:13.00,Default,Spillik,0,0,0,,Tiba-tiba mereka kembali padaku
Dialog: 0,1:10:13.17,1:10:14.29,Default,Spillik,0,0,0,,semua kenangannya.
Dialog: 0,1:10:18.50,1:10:21.30,Default,Spillik,0,0,0,,Soyeon masih hidup di dalam dirimu jika ingatannya tersimpan.
Dialog: 0,1:10:21.50,1:10:24.00,Default,Spillik,0,0,0,,Pegang tanganku sampai kamu keluar tanpa cedera.
Dialog: 0,1:10:24.00,1:10:27.01,Default,Spillik,0,0,0,,Saya mengetahuinya. Anda hanya memikirkan diri Anda sendiri.
Dialog: 0,1:10:29.54,1:10:30.62,Default,Spillik,0,0,0,,Ambil mereka.
Dialog: 0,1:10:31.68,1:10:32.92,Default,Spillit,0,0,0,,Ikuti ratu!
Dialog: 0,0:15:38.67,0:15:40.67,Default,,0,0,0,,

Komentar: 0,0:39:42.84,0:39:43.84,Default,Lily3,0,0,0,,Oke.
Komentar: 0,0:41:02.82,0:41:04.22,Default,Lily3,0,0,0,,Perpindahan atau penggulingan raja
