Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:03.95,0:01:06.39,Default,,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.39,0:01:08.96,Default,,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:21.80,0:01:23.60,Default,,0,0,0,,كم سمعت؟
Dialogue: 0,0:01:25.41,0:01:27.17,Default,,0,0,0,,أول ما تقوله
Dialogue: 0,0:01:27.17,0:01:29.38,Default,,0,0,0,,تحت التهديد بالقتل، ستقرر مصيرها.
Dialogue: 0,0:01:30.68,0:01:32.01,Default,,0,0,0,,ستقول إنها لم تسمع شيئاً
Dialogue: 0,0:01:32.01,0:01:34.55,Default,,0,0,0,,أو يطلب حياتها سأقتلها.
Dialogue: 0,0:01:34.55,0:01:36.72,Default,,0,0,0,,هذا يعني أنها سمعت كل شيء.
Dialogue: 0,0:01:37.48,0:01:38.89,Default,,0,0,0,,أنت!
Dialogue: 0,0:01:39.59,0:01:42.12,Default,,0,0,0,,إذا قتلتني، ستسبب لنفسك المشاكل لبقية حياتك.
Dialogue: 0,0:01:47.49,0:01:49.50,Default,,0,0,0,,لا يزال هذا شيئًا صغيرًا.
Dialogue: 0,0:01:54.37,0:01:56.54,Default,,0,0,0,,انقل هذا الشيء بعيدًا.
Dialogue: 0,0:01:57.97,0:01:59.37,Default,,0,0,0,,انتظر لحظة.
Dialogue: 0,0:01:59.37,0:02:02.54,Default,,0,0,0,,3 حلقة
Dialogue: 0,0:02:09.95,0:02:12.79,Default,,0,0,0,,فقط لعلمك، اليوم فزت بالجائزة الكبرى.
Dialogue: 0,0:02:17.69,0:02:20.29,Default,,0,0,0,,أنظري، أليست جميلة؟ كل شيء لك.
Dialogue: 0,0:02:20.76,0:02:22.60,Default,,0,0,0,,هل تماطل في الوقت؟
Dialogue: 0,0:02:22.66,0:02:25.43,Default,,0,0,0,,ما هذا؟ ألست لصاً؟
Dialogue: 0,0:02:26.00,0:02:27.47,Default,,0,0,0,,اللعنة.
Dialogue: 0,0:02:27.87,0:02:30.87,Default,,0,0,0,,هل تعرف حتى من أنا؟
Dialogue: 0,0:02:31.27,0:02:34.34,Default,,0,0,0,,-أنا...\N-الآن ستقول إنها الملكة.
Dialogue: 0,0:02:35.31,0:02:37.88,Default,,0,0,0,,خدم في القوات الخاصة.
Dialogue: 0,0:02:41.62,0:02:43.02,الافتراضي,,0,0,0,,هجوم.
Dialogue: 0,0:02:44.25,0:02:46.72,Default,,0,0,0,,هل تعتقد أن جميع الطهاة في الجيش أغبياء؟
Dialogue: 0,0:02:46.99,0:02:48.59,Default,,0,0,0,,شيف الجيش
Dialogue: 0,0:02:48.59,0:02:51.26,Default,,0,0,0,,سوف يقتل الشبح بسكين المطبخ.
Dialogue: 0,0:02:51.39,0:02:53.89,Default,,0,0,0,,إلى الأمام! أنا لست خائفا منك.
Dialogue: 0,0:02:54.03,0:02:56.60,Default,,0,0,0,,هيا للهجوم.
Dialogue: 0,0:02:56.60,0:03:00.33,Default,,0,0,0,,كيف يمكنها أن تقول مثل هذه الأشياء الغريبة بهذه الثقة؟
Dialogue: 0,0:03:54.56,0:03:56.02,Default,,0,0,0,,وأنت رائع.
Dialogue: 0,0:04:17.91,0:04:19.78,Default,,0,0,0,,الوجه هو نقطة ضعفه.
Dialogue: 0,0:04:31.63,0:04:33.16,Default,,0,0,0,,رائع.
Dialogue: 0,0:04:38.47,0:04:40.00,Default,,0,0,0,,الله.
Dialogue: 0,0:05:55.31,0:05:57.31,Default,,0,0,0,,جلالة الملك يخفي وجهه،
Dialogue: 0,0:05:57.31,0:05:59.38,Default,,0,0,0,,مما يعني أنه لا يريد الكشف عن نفسه.
Dialogue: 0,0:06:38.05,0:06:39.62,Default,,0,0,0,,من أنت؟
Dialogue: 0,0:06:42.29,0:06:44.59,Default,,0,0,0,,أنا كيم بيونغين من عائلة كيم جواجيون.
Dialogue: 0,0:06:46.13,0:06:47.86,Default,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:06:50.30,0:06:51.63,Default,,0,0,0,,هل تعرضت للسرقة؟
Dialogue: 0,0:06:51.63,0:06:53.50,Default,,0,0,0,,لم يستطع الذهاب بعيداً.
Dialogue: 0,0:06:54.50,0:06:56.47,Default,,0,0,0,,ابحث في كل شيء حولك.
Dialogue: 0,0:06:56.70,0:06:58.11,Default,,0,0,0,,لم يكن اللص وحده.
Dialogue: 0,0:06:58.11,0:07:01.04,Default,,0,0,0,,نعم، انقسموا وابحثوا في كل شيء.
Dialogue: 0,0:07:13.22,0:07:15.12,Default,,0,0,0,,أختي، هل أنت بخير؟
Dialogue: 0,0:07:18.49,0:07:19.96,Default,,0,0,0,,أختي؟
Dialogue: 0,0:07:22.50,0:07:26.37,Default,,0,0,0,,لماذا يحدق بأخته بحماس شديد؟
Dialogue: 0,0:07:28.14,0:07:29.57,Default,,0,0,0,,سويون!
Dialogue: 0,0:07:31.51,0:07:33.84,Default,,0,0,0,,لا بد أنك تعرضت لصدمة قوية.
Dialogue: 0,0:07:35.88,0:07:38.08,Default,,0,0,0,,أي وغد تجرأ على فعل هذا بها؟
Dialogue: 0,0:07:47.19,0:07:49.22,Default,,0,0,0,,ذهبي... يا إلهي!
Dialogue: 0,0:07:50.76,0:07:53.03,Default,,0,0,0,,-حسناً، ما.\N-لماذا اقتحمت المكان؟
Dialogue: 0,0:07:54.29,0:07:55.73,Default,,0,0,0,,نحن نبحث عن لص.
Dialogue: 0,0:07:55.73,0:07:56.96,Default,,0,0,0,,الله.
Dialogue: 0,0:07:56.96,0:07:58.70,Default,,0,0,0,,أين تمد يديك؟
Dialogue: 0,0:07:58.70,0:08:02.27,Default,,0,0,0,,لقد أخافوني، فقلت حركتي بصوت عالٍ.
Dialogue: 0,0:08:02.27,0:08:03.37,Default,,0,0,0,,لقد انتهت هذه اللعبة.
Dialogue: 0,0:08:03.37,0:08:04.50,Default,,0,0,0,,من قال ذلك؟
Dialogue: 0,0:08:04.50,0:08:06.31,Default,,0,0,0,,هل ستستمر وأنت تعلم ما بين يدي؟
Dialogue: 0,0:08:06.31,0:08:08.98,Default,,0,0,0,,مشكلتك، لماذا يجب أن أخسر؟
Dialogue: 0,0:08:08.98,0:08:10.71,Default,,0,0,0,,يا له من وغد.
Dialogue: 0,0:08:12.25,0:08:13.55,Default,,0,0,0,,آسفة، لقد ذهبت بعيداً.
Dialogue: 0,0:08:13.55,0:08:15.98,Default,,0,0,0,,هل بصقت في وجهي للتو؟
Dialogue: 0,0:08:15.98,0:08:17.52,Default,,0,0,0,,لا أعرف أي شيء!
Dialogue: 0,0:08:20.05,0:08:21.96,Default,,0,0,0,,لك!
Dialogue: 0,0:08:24.49,0:08:27.13,Default,,0,0,0,,-ألقي القبض عليه.\N-أعتقل؟
Dialogue: 0,0:08:28.20,0:08:30.20,Default,,0,0,0,,ما الذي وقف مثل الأعمدة؟
Dialogue: 0,0:08:30.20,0:08:32.00,Default,,0,0,0,,لا تدع المستشار هونغ يهرب،
Dialogue: 0,0:08:32.00,0:08:33.83,Default,,0,0,0,,أغلق الباب واخرج الآن!
Dialogue: 0,0:08:33.83,0:08:36.90,Default,,0,0,0,,لا يعرف كيف يقاتل، لكنه يُحدث الفوضى في نفسه.
Dialogue: 0,0:08:36.90,0:08:39.91,Default,,0,0,0,,اليوم سأكبح أعصابه!
Dialogue: 0,0:08:40.87,0:08:42.84,Default,,0,0,0,,-احميني.\N-في المرة القادمة.
Dialogue: 0,0:08:42.84,0:08:45.41,Default,,0,0,0,,-التالي؟\N-لماذا لا تزال هنا؟
Dialogue: 0,0:08:45.55,0:08:48.05,Default,,0,0,0,,إذا غادرت للتو...
Dialogue: 0,0:08:48.05,0:08:49.52,Default,,0,0,0,,المستشار حضرة.
Dialogue: 0,0:08:49.52,0:08:52.69,Default,,0,0,0,,اليوم سأكبح أعصابك!
Dialogue: 0,0:08:54.86,0:08:56.46,Default,,0,0,0,,جاء الأمر بشكل مقنع.
Dialogue: 0,0:08:59.59,0:09:02.40,Default,,0,0,0,,ألا أستطيع حتى أن أسخر منك بعد الآن؟
Dialogue: 0,0:09:02.40,0:09:04.76,Default,,0,0,0,,حقاً، هل سترفع سيفك عليّ؟
Dialogue: 0,0:09:07.20,0:09:09.90,Default,,0,0,0,,ولكن ليس هناك! لم أتمكن من الزواج أبداً!
Dialogue: 0,0:09:10.20,0:09:11.64,Default,,0,0,0,,لنذهب.
Dialogue: 0,0:09:12.81,0:09:15.48,Default,,0,0,0,,فاتت. حتى السيف ليس في صفك.
Dialogue: 0,0:09:35.16,0:09:36.96,Default,,0,0,0,,هل تأذيت؟
Dialogue: 0,0:09:36.96,0:09:38.63,Default,,0,0,0,,أنا بخير.
Dialogue: 0,0:09:39.47,0:09:41.67,Default,,0,0,0,,لم أكن أعتقد أن كيم بيونغين سيكون معها.
Dialogue: 0,0:09:42.60,0:09:44.64,Default,,0,0,0,,هل تعتقدين أنه كان فخاً؟
Dialogue: 0,0:09:45.37,0:09:48.01,Default,,0,0,0,,لن يستخدموا الملكة كطعم.
Dialogue: 0,0:09:48.01,0:09:50.08,Default,,0,0,0,,إلى جانب رد فعل الملكة
Dialogue: 0,0:09:50.08,0:09:53.05,Default,,0,0,0,,كان أمراً غير معتاد.\NIيطاردني.
Dialogue: 0,0:09:53.28,0:09:55.18,Default,,0,0,0,,إذا بدأنا التصرف دون أن نفهمه،
Dialogue: 0,0:09:55.18,0:09:57.38,Default,,0,0,0,,دعونا نجعل الأمور أسوأ.
Dialogue: 0,0:09:57.72,0:09:59.89,Default,,0,0,0,,دعونا نفهم أولاً ما الذي يحدث.
Dialogue: 0,0:09:59.89,0:10:01.45,Default,,0,0,0,,لكن ماذا،
Dialogue: 0,0:10:01.82,0:10:04.22,Default,,0,0,0,,إذا سمعت الملكة كل شيء؟
Dialogue: 0,0:10:05.63,0:10:08.16,Default,,0,0,0,,لقد تحدثت إلى الملكة.
Dialogue: 0,0:10:08.86,0:10:11.00,Default,,0,0,0,,ثق في حكمي.
Dialogue: 0,0:10:13.97,0:10:16.34,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:10:17.07,0:10:20.04,Default,,0,0,0,,إذا كنت مخطئًا،
Dialogue: 0,0:10:23.11,0:10:26.48,Default,,0,0,0,,سيبدأ حمام الدم.
Dialogue: 0,0:10:33.89,0:10:37.19,Default,,0,0,0,,3 الحلقة: في السرير مع العدو
Dialogue: 0,0:10:48.47,0:10:49.77,Default,,0,0,0,,الضيف النبيل.
Dialogue: 0,0:10:49.77,0:10:52.07,Default,,0,0,0,,لقد رأيته في التابوت،\Nإلا إذا كان الملك...
Dialogue: 0,0:10:52.97,0:10:55.17,Default,,0,0,0,,ضع سلاحك جانباً، ضعه جانباً.
Dialogue: 0,0:10:59.55,0:11:01.05,Default,,0,0,0,,تخطي.
Dialogue: 0,0:11:07.65,0:11:10.32,Default,,0,0,0,,أود أن تظل زيارتنا سراً.
Dialogue: 0,0:11:10.32,0:11:11.82,Default,,0,0,0,,نعم.
Dialogue: 0,0:11:20.33,0:11:21.83,Default,,0,0,0,,الله.
Dialogue: 0,0:11:26.57,0:11:28.94,Default,,0,0,0,,أغمي عليها من الخوف.
Dialogue: 0,0:11:28.98,0:11:33.41,Default,,0,0,0,,جهزوا سريرها وأرضعوها سراً.
Dialogue: 0,0:11:33.41,0:11:34.85,Default,,0,0,0,,نعم.
Dialogue: 0,0:11:58.94,0:12:00.84,Default,,0,0,0,,صاحب السمو، ماذا تفعل هنا؟
Dialogue: 0,0:12:01.34,0:12:03.24,Default,,0,0,0,,أنت مرة أخرى.
Dialogue: 0,0:12:04.94,0:12:08.78,Default,,0,0,0,,أنت فقط من تبحث عني عندما أهرب.
Dialogue: 0,0:12:09.65,0:12:14.09,Default,,0,0,0,,غداً حفل زفافك.\Nلماذا أنت هنا؟
Dialogue: 0,0:12:14.89,0:12:17.92,Default,,0,0,0,,ظننت أنني سأجن بعد قليل.\Nلهذا السبب غادرت القصر.
Dialogue: 0,0:12:19.23,0:12:20.93,Default,,0,0,0,,فقط اذهب إليّ
Dialogue: 0,0:12:22.20,0:12:23.76,Default,,0,0,0,,لا مكان.
Dialogue: 0,0:12:50.92,0:12:55.96,Default,,0,0,0,,سأعيدك إلى القصر - لن يلاحظ أحد.
Dialogue: 0,0:12:58.67,0:13:01.30,Default,,0,0,0,,غداً حلم طفولتي
Dialogue: 0,0:13:02.67,0:13:05.07,Default,,0,0,0,,سيتحقق.
Dialogue: 0,0:13:05.97,0:13:08.91,Default,,0,0,0,,حلمت بأن أصبح ملكة.
Dialogue: 0,0:13:12.61,0:13:15.45,Default,,0,0,0,,غداً سيتحقق حلمي.
Dialogue: 0,0:13:18.59,0:13:20.72,Default,,0,0,0,,غداً حلمي
Dialogue: 0,0:13:23.06,0:13:24.92,الافتراضي,,0,0,0,,سوف تختفي.
Dialogue: 0,0:13:28.96,0:13:30.83,Default,,0,0,0,,هل هناك خطأ ما؟
Dialogue: 0,0:13:32.70,0:13:34.73,Default,,0,0,0,,أنا خائف.
Dialogue: 0,0:13:35.74,0:13:37.34,Default,,0,0,0,,أنا خائف.
Dialogue: 0,0:13:38.57,0:13:41.07,Default,,0,0,0,,العيش مخيف.
Dialogue: 0,0:13:41.14,0:13:44.18,Default,,0,0,0,,-صاحب السمو.\N-لا تناديني بهذا الاسم.
Dialogue: 0,0:13:45.15,0:13:47.88,Default,,0,0,0,,على الأقل اليوم اتصل بي بالاسم.
Dialogue: 0,0:13:48.58,0:13:50.78,Default,,0,0,0,,حتى لا أنسى من أنا.
Dialogue: 0,0:13:52.69,0:13:54.35,Default,,0,0,0,,إلى
Dialogue: 0,0:13:56.59,0:13:58.29,Default,,0,0,0,,لم أفقد نفسي.
Dialogue: 0,0:13:59.16,0:14:01.79,Default,,0,0,0,,ما الذي تخشاه إلى هذه الدرجة؟
Dialogue: 0,0:14:02.40,0:14:06.10,Default,,0,0,0,,أنا لست أنا على الإطلاق.
Dialogue: 0,0:14:06.93,0:14:09.50,Default,,0,0,0,,عشت كل هذا الوقت وأنا أفكر أن هذا أنا.
Dialogue: 0,0:14:10.67,0:14:12.41,Default,,0,0,0,,لكن الأمر لم يكن كذلك.
Dialogue: 0,0:14:12.47,0:14:15.74,Default,,0,0,0,,ليس هناك شيء حقيقي عني، كل شيء كذب.
Dialogue: 0,0:14:32.03,0:14:34.19,Default,,0,0,0,,أنت سويون.
Dialogue: 0,0:14:39.37,0:14:41.73,Default,,0,0,0,,امرأة عرفتها منذ سنوات عديدة،
Dialogue: 0,0:14:44.57,0:14:47.94,Default,,0,0,0,,محبوب وعزيز سراً.
Dialogue: 0,0:14:57.12,0:14:59.35,Default,,0,0,0,,لن أدعك تخسر نفسك.
Dialogue: 0,0:15:03.92,0:15:05.99,Default,,0,0,0,,ولن أنسى أبدًا.
Dialogue: 0,0:15:57.68,0:15:59.18,Default,,0,0,0,,حسناً
Dialogue: 0,0:16:01.28,0:16:03.78,Default,,0,0,0,,هل حدث تلك الليلة؟
Dialogue: 0,0:16:08.02,0:16:10.89,Default,,0,0,0,,أحدهم يقتلني.
Dialogue: 0,0:16:12.79,0:16:15.76,Default,ليلي,0,0,0,,اتصلت بالمعالج. انتظر يا صاحب الجلالة.
Dialogue: 0,0:16:18.06,0:16:19.77,Default,ليلي,0,0,0,,هذا الدجال.
Dialogue: 0,0:16:20.27,0:16:21.63,Default,ليلي,0,0,0,,أعاني من الصداع بالفعل.
Dialogue: 0,0:16:21.63,0:16:23.47,Default,Lily,0,0,0,,دعها لا تظهر هنا.
Dialogue: 0,0:16:23.47,0:16:26.51,Default,Lily,0,0,0,,وإلا ستُترك بدون عضو تناسلي.
Dialogue: 0,0:16:30.18,0:16:33.45,Default,ليلي,0,0,0,,إذن ربما عليك أن تأكل؟ امسكها.
Dialogue: 0,0:16:39.65,0:16:42.32,Default,ليلي,0,0,0,,أشعر بالمرض. يبدو أنه على وشك التقيؤ.
Dialogue: 0,0:16:43.12,0:16:45.09,Default,Lily,0,0,0,,كم شربت بالأمس؟
Dialogue: 0,0:16:45.09,0:16:47.76,Default,Lily,0,0,0,,هذه المرأة لا تتحمل الكحول جيداً.
Dialogue: 0,0:16:48.13,0:16:50.56,Default,Lily,0,0,0,,لم انقطع الاتصال بهذه الطريقة منذ وقت طويل.
Dialogue: 0,0:16:53.20,0:16:55.13,Default,ليلي,0,0,0,,كيف عدت بالأمس؟
Dialogue: 0,0:16:56.34,0:16:59.41,Default,ليلي,0,0,0,,ابن عمك السيد بنين هو الذي أحضرك.
Dialogue: 0,0:16:59.41,0:17:02.14,Default,ليلي,0,0,0,,قد تقع في مشكلة.
Dialogue: 0,0:17:02.98,0:17:04.81,Default,ليلي,0,0,0,,الشكر له، أنا فقط
Dialogue: 0,0:17:04.81,0:17:06.88,Default,ليلي,0,0,0,,أعلم أنك خرجت بالأمس.
Dialogue: 0,0:17:07.01,0:17:08.51,Default,ليلي,0,0,0,,أخي؟
Dialogue: 0,0:17:08.58,0:17:10.55,Default,ليلي,0,0,0,,أين التقيناه؟
Dialogue: 0,0:17:10.88,0:17:12.75,Default,ليلي,0,0,0,,لا أعرف بالضبط.
Dialogue: 0,0:17:13.52,0:17:17.19,Default,Lily,0,0,0,,بالمناسبة قال أنك أغمي عليك من الخوف.
Dialogue: 0,0:17:17.19,0:17:19.66,Default,ليليا,0,0,0,,-ما الذي أخافك؟\N-لم أفقد الوعي.
Dialogue: 0,0:17:19.66,0:17:21.66,Default,ليلي,0,0,0,,شربت حتى فقدت الوعي.
Dialogue: 0,0:17:21.76,0:17:24.20,Default,Lily,0,0,0,,بالمناسبة، من الرائع أن تكوني ملكة.
Dialogue: 0,0:17:24.20,0:17:25.97,Default,Lily,0,0,0,,كانت البوابات مفتوحة أثناء حظر التجول.
Dialogue: 0,0:17:25.97,0:17:28.00,Default,ليلي,0,0,0,,إنه ابن عمك
Dialogue: 0,0:17:28.00,0:17:30.14,Default,ليلي,0,0,0,,وابن كيم جواجيون بالتبني.
Dialogue: 0,0:17:30.14,0:17:31.67,Default,ليلي,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:17:36.84,0:17:38.28,Default,ليلي,0,0,0,,أين سيدة البلاط تشوي؟
Dialogue: 0,0:17:38.28,0:17:39.78,Default,ليلي,0,0,0,,هل تأخرت؟
Dialogue: 0,0:17:40.91,0:17:42.98,Default,ليلي,0,0,0,,أرسلها أخوك بعيداً عن القصر،
Dialogue: 0,0:17:42.98,0:17:45.62,Default,Lily,0,0,0,,حتى لا يعلم أحد أنك مريض بالمخلفات.
Dialogue: 0,0:17:46.02,0:17:47.69,Default,ليلي,0,0,0,,لم تكن تريد المغادرة،
Dialogue: 0,0:17:47.69,0:17:50.92,Default,ليلي,0,0,0,,كان من الصعب إجبارها.
Dialogue: 0,0:17:50.92,0:17:54.39,Default,Lily,0,0,0,,لماذا يتردد الجميع في مغادرة القصر؟
Dialogue: 0,0:17:54.73,0:17:57.93,Default,ليلي,0,0,0,,الأمر خطير خارج القصر.
Dialogue: 0,0:17:58.16,0:18:01.07,Default,ليلي,0,0,0,,كل ما تحتاجه موجود في القصر.
Dialogue: 0,0:18:01.43,0:18:04.07,Default,Lily,0,0,0,,الجميع هنا منوم مغناطيسياً، أم ماذا؟
Dialogue: 0,0:18:04.07,0:18:06.51,Default,Lily,0,0,0,,هناك شيء لا يمكن العثور عليه في القصر.
Dialogue: 0,0:18:06.61,0:18:08.34,Default,ليلي,0,0,0,,-ما هذا؟\N-الحرية.
Dialogue: 0,0:18:10.54,0:18:12.98,Default,ليلي,0,0,0,,خارج القصر كل شيء هو نفسه.
Dialogue: 0,0:18:13.65,0:18:17.35,Default,ليلي,0,0,0,,حسنًا، أنا سعيد لأنها ليست هناك. إنها تزعجني.
Dialogue: 0,0:18:17.42,0:18:19.99,Default,ليلي,0,0,0,,رأسي الصغير.
Dialogue: 0,0:18:21.52,0:18:24.06,Default,Lily,0,0,0,,أحتاج إلى بعض الرامن الحار لعلاج صداع الكحول.
Dialogue: 0,0:18:24.06,0:18:26.73,Default,ليلى,0,0,0,,والعرق. دواء عظيم.
Dialogue: 0,0:18:27.86,0:18:29.90,Default,ليلي,0,0,0,,لا يوجد رامين هنا.
Dialogue: 0,0:18:29.90,0:18:32.33,Default,ليلي,0,0,0,,ومشروبات الكحول.
Dialogue: 0,0:18:35.10,0:18:37.40,Default,ليلي,0,0,0,,ولكن هنا لدي القوة.
Dialogue: 0,0:18:39.91,0:18:41.87,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:18:42.41,0:18:43.91,Default,ليلي,0,0,0,,أشعل النار.
Dialogue: 0,0:18:44.44,0:18:45.58,Default,ليلي,0,0,0,,-أشعل النار.\N-أشعل النار.
Dialogue: 0,0:18:45.58,0:18:48.98,Default,ليلي,0,0,0,,ليس لدي أي فكرة عما تريده.
Dialogue: 0,0:18:48.98,0:18:50.05,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:18:50.05,0:18:52.32,Default,ليلي,0,0,0,,وجبة لقاعة دايجوجون.
Dialogue: 0,0:18:52.32,0:18:53.72,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:18:57.82,0:18:59.49,Default,ليلي,0,0,0,,ما هذا الهراء؟
Dialogue: 0,0:19:12.11,0:19:14.01,Default,ليلي,0,0,0,,هل اللحم مطبوخ؟
Dialogue: 0,0:19:33.66,0:19:35.26,Default,ليلي,0,0,0,,هذا ليس هو الحال.
Dialogue: 0,0:19:36.73,0:19:38.83,Default,ليلي,0,0,0,,حسناً، حسناً. هذه المرة...
Dialogue: 0,0:19:49.21,0:19:52.28,Default,ليلي,0,0,0,,اللعنة. هل هذا كل ما يمكنه فعله؟
Dialogue: 0,0:19:55.45,0:19:58.62,Default,ليلي,0,0,0,,ما مشكلة طعامي؟ بحق الجحيم؟
Dialogue: 0,0:20:12.06,0:20:14.33,Default,ليلي,0,0,0,,آه، الأكل الصحي.
Dialogue: 0,0:20:30.32,0:20:31.92,Default,Lily,0,0,0,,ليس حاراً على الإطلاق.
Dialogue: 0,0:20:37.76,0:20:40.53,Default,ليلي,0,0,0,,حار جداً. هل أردت قتلي؟
Dialogue: 0,0:20:45.97,0:20:47.57,Default,ليلي,0,0,0,,لقد اكتفيت!
Dialogue: 0,0:20:47.57,0:20:49.97,Default,Lily,0,0,0,,إذا لم يعجبك ذلك، دعه يأتي إلى هنا ويطبخ!
Dialogue: 0,0:20:49.97,0:20:53.61,Default,ليلي,0,0,0,,اضطراب واحد. سأطبخه بنفسي.
Dialogue: 0,0:20:59.71,0:21:01.41,Default,Lily,0,0,0,,للفرن قوة النار،
Dialogue: 0,0:21:01.41,0:21:03.12,Default,ليلي,0,0,0,,لكن من الصعب السيطرة على النار.
Dialogue: 0,0:21:03.12,0:21:06.55,Default,Lily,0,0,0,,التوصيل الحراري للغلاية مرتفع جدًا.
Dialogue: 0,0:21:09.72,0:21:11.86,Default,Lily,0,0,0,,ماذا لو تأذيت يا صاحب الجلالة؟
Dialogue: 0,0:21:11.86,0:21:13.16,Default,ليلي,0,0,0,,لم تدخل المطبخ منذ ذلك الحين،
Dialogue: 0,0:21:13.16,0:21:14.83,Default,ليلي,0,0,0,,كيف توقفنا عن اللعب في المنزل.
Dialogue: 0,0:21:14.83,0:21:17.43,Default,ليلي,0,0,0,,حتى لو جئت إلى هنا فقط للعب في المنزل،
Dialogue: 0,0:21:17.76,0:21:19.60,Default,ليلي,0,0,0,,أنا أطبخ أفضل منه.
Dialogue: 0,0:21:23.64,0:21:25.17,Default,ليلي,0,0,0,,كن حذراً يا صاحب الجلالة.
Dialogue: 0,0:21:25.17,0:21:27.27,Default,ليلي,0,0,0,,هل تحملينه بهذه الطريقة؟
Dialogue: 0,0:21:27.64,0:21:29.54,Default,Lily,0,0,0,,كن حذراً بأصابعك.
Dialogue: 0,0:21:34.48,0:21:35.98,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:21:42.56,0:21:45.16,Default,Lily,0,0,0,,أنا أطبخ للمرة الأولى، لذا لا أعرف إذا كان هذا صحيحًا.
Dialogue: 0,0:21:45.16,0:21:48.79,Default,Lily,0,0,0,,يبدو أنك بحاجة إلى قطعها بهذه الطريقة.
Dialogue: 0,0:22:51.49,0:22:52.99,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:23:06.07,0:23:08.64,Default,Lily,0,0,0,,أنا متأكد من أنها تبدو جميلة.
Dialogue: 0,0:23:08.64,0:23:10.88,Default,Lily,0,0,0,,أراهن أنه ليس متمرسًا حقًا.
Dialogue: 0,0:23:11.28,0:23:12.95,Default,ليلي,0,0,0,,بالطبع.
Dialogue: 0,0:23:12.95,0:23:15.55,Default,ليلي,0,0,0,,نعم. أنت على حق تماما.
Dialogue: 0,0:23:15.55,0:23:16.98,Default,ليلي,0,0,0,,دعني أذهب.
Dialogue: 0,0:23:17.45,0:23:21.15,Default,ليلي,0,0,0,,لقد عملت في المطبخ الملكي لمدة 30 عاماً.
Dialogue: 0,0:23:21.15,0:23:23.39,Default,Lily,0,0,0,,الطبخ هو قمة المهارة.
Dialogue: 0,0:23:24.89,0:23:26.19,Default,ليلي,0,0,0,,حسنًا.
Dialogue: 0,0:23:26.19,0:23:29.33,Default,Lily,0,0,0,,سأحاول بنفسي أن أفهم مدى فظاعة الأمر.
Dialogue: 0,0:23:29.43,0:23:31.53,Default,Lily,0,0,0,,هذا ليس لذيذاً على الإطلاق.
Dialogue: 0,0:23:43.14,0:23:46.18,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:23:55.55,0:23:57.16,Default,ليلي,0,0,0,,هل كل شيء بهذا السوء؟
Dialogue: 0,0:23:59.43,0:24:01.06,Default,ليلي,0,0,0,,رائحة شيتاكي
Dialogue: 0,0:24:01.73,0:24:03.36,Default,ليلى,0,0,0,,وبصل أخضر.
Dialogue: 0,0:24:05.66,0:24:07.97,Default,ليلي,0,0,0,,رائحة اللحم الغنية.
Dialogue: 0,0:24:09.34,0:24:12.84,Default,Lily,0,0,0,,طعم المكونات الثلاثة مختلط. وهذا...
Dialogue: 0,0:24:25.52,0:24:28.75,Default,Lily,0,0,0,"سام" ثلاثة، "هيانغ" رائحة،
Dialogue: 0,0:24:28.75,0:24:31.12,Default,Lily,0,0,0,,و"ra" هو وعاء.
Dialogue: 0,0:24:31.12,0:24:33.73,Default,ليلي,0,0,0,,ثلاثة روائح في وعاء،
Dialogue: 0,0:24:33.73,0:24:35.79,Default,Lily,0,0,0,"samhyanra".
Dialogue: 0,0:24:38.23,0:24:43.47,Default,ليلي,0,0,0,,سامهيانغ رامين!
Dialogue: 0,0:25:11.00,0:25:13.27,Default,ليلي,0,0,0,,تماماً حسب الحاجة.
Dialogue: 0,0:25:13.27,0:25:16.04,Default,ليلي,0,0,0,,غلوتامات الصوديوم هناك.
Dialogue: 0,0:25:16.04,0:25:17.60,Default,ليلي,0,0,0,,لكنه أفضل من لا شيء.
Dialogue: 0,0:25:19.07,0:25:22.88,Default,Lily,0,0,0,,بفضلك، جربت الكثير من الأطباق الشهية،
Dialogue: 0,0:25:22.88,0:25:25.94,Default,ليلي,0,0,0,,لكن لا شيء مذهل.
Dialogue: 0,0:25:25.98,0:25:27.55,Default,ليلي,0,0,0,,حاول مرة أخرى.
Dialogue: 0,0:25:28.85,0:25:33.05,Default,Lily,0,0,0,,اعلم أنه إذا عُرض عليك الرامن، فهذا هو الحب الحقيقي.
Dialogue: 0,0:25:34.02,0:25:36.16,Default,ليلي,0,0,0,,إذاً إذا كنت لا تمانع.
Dialogue: 0,0:25:43.60,0:25:45.56,Default,ليلي,0,0,0,,إنه...
Dialogue: 0,0:25:46.40,0:25:48.33,Default,ليلي,0,0,0,,أنت، الذي لم تحمل سكيناً من قبل،
Dialogue: 0,0:25:48.33,0:25:50.30,Default,ليلي,0,0,0,,الطبخ أفضل من الطاهي الملكي.
Dialogue: 0,0:25:50.47,0:25:53.64,Default,ليلي,0,0,0,,هل هناك شيء لا يمكنك فعله؟
Dialogue: 0,0:25:55.04,0:25:59.24,Default,Lily,0,0,0,,كنت شخصًا مثاليًا، قادرًا على فعل أي شيء.
Dialogue: 0,0:25:59.85,0:26:02.18,Default,ليلي,0,0,0,,لكنني الآن لا أستطيع أن أفعل الشيء الأكثر أهمية.
Dialogue: 0,0:26:02.82,0:26:06.25,Default,Lily,0,0,0,,أكثر ما كنت محترفًا فيه وأحببته أكثر من أي شيء آخر.
Dialogue: 0,0:26:08.19,0:26:11.42,Default,ليلي,0,0,0,,فهمت. تطريز؟
Dialogue: 0,0:26:11.82,0:26:14.59,Default,ليلي,0,0,0,,بالضبط. لقد قمت بعمل جيد.
Dialogue: 0,0:26:16.03,0:26:17.50,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:26:17.90,0:26:19.77,Default,ليلي,0,0,0,,عندما لمست،
Dialogue: 0,0:26:19.77,0:26:23.60,Default,ليلي,0,0,0,,كانت الزهور تتفتح والفراشات ترفرف.
Dialogue: 0,0:26:23.87,0:26:26.41,Default,ليلي,0,0,0,,كان ذلك شيئاً.
Dialogue: 0,0:26:29.07,0:26:31.98,Default,ليلي,0,0,0,,جلالة الملك هنا.
Dialogue: 0,0:26:32.55,0:26:34.51,Default,ليلي,0,0,0,,لماذا الآن؟
Dialogue: 0,0:26:34.51,0:26:37.28,Default,ليلي,0,0,0,,اللعنة. سوف تنضج الشعرية.
Dialogue: 0,0:26:39.72,0:26:41.12,Default,ليلي,0,0,0,,حار.
Dialogue: 0,0:26:44.92,0:26:46.46,Default,ليلي,0,0,0,,ملكتي.
Dialogue: 0,0:26:57.04,0:26:58.84,Default,ليلي,0,0,0,,في الصباح قمت بزيارة الشيوخ
Dialogue: 0,0:26:58.84,0:27:01.97,Default,Lily,0,0,0,,وكنت أتساءل عن شعورك، لذا قمت بزيارة.
Dialogue: 0,0:27:02.84,0:27:05.08,Default,ليلي,0,0,0,,هل يعلم بأمر الليلة الماضية؟
Dialogue: 0,0:27:05.44,0:27:07.68,Default,Lily,0,0,0,,ليس هناك سبب للشعور بالسوء.
Dialogue: 0,0:27:07.88,0:27:10.45,Default,ليلي,0,0,0,,كيف كانت ليلتك؟
Dialogue: 0,0:27:10.45,0:27:12.05,Default,ليلي,0,0,0,,غير الموضوع.
Dialogue: 0,0:27:12.05,0:27:14.09,Default,ليلي,0,0,0,,إنها تغير الموضوع.
Dialogue: 0,0:27:14.95,0:27:16.56,Default,ليلي,0,0,0,,صلواتك.
Dialogue: 0,0:27:19.49,0:27:22.66,Default,ليلي,0,0,0,,الملكة، هل كنت تشرب الخمر؟
Dialogue: 0,0:27:23.73,0:27:26.50,Default,ليلي,0,0,0,,أنا؟ بالطبع لا.
Dialogue: 0,0:27:26.50,0:27:28.20,Default,ليلي,0,0,0,,ألم تشرب الخمر؟
Dialogue: 0,0:27:33.37,0:27:35.01,Default,ليلي,0,0,0,,هل نلعب مسابقة تحديق؟
Dialogue: 0,0:27:39.68,0:27:42.55,Default,Lily,0,0,0,,لم أكن أعلم أنك كاذب بارع.
Dialogue: 0,0:27:50.32,0:27:52.06,Default,ليلي,0,0,0,,أوه، آسف.
Dialogue: 0,0:27:52.32,0:27:54.13,Default,ليلي,0,0,0,,عادةً لا أفعل هذا،
Dialogue: 0,0:27:54.13,0:27:56.46,Default,ليلي,0,0,0,,لكنك اقتربت أكثر من اللازم.
Dialogue: 0,0:27:59.97,0:28:02.20,Default,ليلي,0,0,0,,كاد أن يسقط.
Dialogue: 0,0:28:02.77,0:28:04.44,Default,ليلي,0,0,0,,لدي الكثير لأقوم به. آسف.
Dialogue: 0,0:28:04.44,0:28:06.31,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:28:08.24,0:28:10.08,Default,ليلي,0,0,0,,سأذهب إلى قاعة سونغجيونغجونغ.
Dialogue: 0,0:28:10.08,0:28:11.58,Default,ليلي,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:28:15.88,0:28:19.08,Default,Lily,0,0,0,,لا يبدو أنه مشغول للغاية. \NBut إذا كان الأمر كذلك، لماذا أتيت إلى هنا؟
Dialogue: 0,0:28:20.72,0:28:23.36,Default,ليلي,0,0,0,,اللعنة، لقد خففت الآن.
Dialogue: 0,0:28:33.27,0:28:35.47,Default,Spilik,0,0,0,,تحياتي أيها الملك.
Dialogue: 0,0:28:35.47,0:28:36.94,Default,Spillit,0,0,0,,أخي.
Dialogue: 0,0:28:37.10,0:28:39.51,Default,Spillit,0,0,0,,اقترب أكثر
Dialogue: 0,0:28:39.51,0:28:41.84,Default,Spilik,0,0,0,,وقل لي، هل نتنتي؟
Dialogue: 0,0:28:41.84,0:28:43.38,Default,Spillie,0,0,0,,رائحة كريهة؟
Dialogue: 0,0:28:43.81,0:28:45.78,Default,Spilik,0,0,0,,لا أستطيع أن أقول ذلك بعد.
Dialogue: 0,0:28:46.21,0:28:48.41,Default,Spillit,0,0,0,,أعد كل شيء.
Dialogue: 0,0:28:51.12,0:28:54.02,Default,Spillit,0,0,0,,ماذا أكلت ملكتي بحق الجحيم؟
Dialogue: 0,0:28:54.19,0:28:57.22,Default,Spilik,0,0,0,,يا له من عار!
Dialogue: 0,0:29:05.23,0:29:08.43,Default,Spilik,0,0,0,,جلالتك، لقد وصل كيم بيونغين.
Dialogue: 0,0:29:08.97,0:29:11.50,Default,Spilik,0,0,0,,هاه يا أخي؟
Dialogue: 0,0:29:13.17,0:29:16.24,Default,Spilik,0,0,0,,أنا مدين لك بالكثير الليلة الماضية.
Dialogue: 0,0:29:16.24,0:29:18.78,Default,Spilik,0,0,0,,لقد فعلت ما كان علي فعله.
Dialogue: 0,0:29:22.45,0:29:25.28,Default,Spilik,0,0,0,,بما أن لدي ضيفًا، فيجب أن أقدم الشاي.
Dialogue: 0,0:29:25.28,0:29:27.05,Default,Spilik,0,0,0,,لقد اشتقت إليك.
Dialogue: 0,0:29:27.65,0:29:29.62,Default,Spilik,0,0,0,,هنا سقطت على رأسي.
Dialogue: 0,0:29:29.62,0:29:32.16,Default,Split,0,0,0,,حسنًا. علينا أن نلعب جنبا إلى جنب.
Dialogue: 0,0:29:32.22,0:29:34.49,Default,Spilik,0,0,0,,لقد اشتقت إليك أيضاً.
Dialogue: 0,0:29:35.93,0:29:37.60,Default,Spilik,0,0,0,,سعيد لسماع ذلك.
Dialogue: 0,0:29:38.10,0:29:42.20,Default,XO,0,0,0,,كلماتك بدّدت همومي.
Dialogue: 0,0:29:42.30,0:29:44.74,Default,XO,0,0,0,,ما الذي أثر فيه كثيراً؟
Dialogue: 0,0:29:44.74,0:29:46.57,Default,XO,0,0,0,,لقد سمعت شائعات،
Dialogue: 0,0:29:47.34,0:29:50.01,Default,XO,0,0,0,,أنك سقطت في البحيرة بعد أن قابلتني.
Dialogue: 0,0:29:50.01,0:29:52.28,Default,XO,0,0,0,,في ذلك اليوم قالوا إنهم خائفون.
Dialogue: 0,0:29:52.51,0:29:54.11,Default,XO,0,0,0,,ما الأمر؟
Dialogue: 0,0:29:55.48,0:29:59.15,Default,XO,0,0,0,,قلت ذلك اليوم إنني كنت خائفاً...
Dialogue: 0,0:29:59.15,0:30:02.39,Default,XO,0,0,0,,وكنت خائفاً؟..
Dialogue: 0,0:30:04.12,0:30:08.09,Default,XO,0,0,0,,ليس هناك شيء أسوأ في العالم من البشر.
Dialogue: 0,0:30:08.46,0:30:10.76,Default,XO,0,0,0,,هل أنت مهدد؟
Dialogue: 0,0:30:11.46,0:30:13.73,Default,XO,0,0,0,,أنت تعرف من الذي دفع
Dialogue: 0,0:30:13.73,0:30:15.27,Default,XO,0,0,0,,أنت في البحيرة
Dialogue: 0,0:30:15.27,0:30:16.90,Default,XO,0,0,0,,وهاجمت الليلة الماضية؟
Dialogue: 0,0:30:17.60,0:30:19.10,Default,XO,0,0,0,,توقف.
Dialogue: 0,0:30:19.20,0:30:21.14,Default,XO,0,0,0,,أعرف أمر البحيرة.
Dialogue: 0,0:30:21.17,0:30:23.54,Default,XO,0,0,0,,ماذا عن الليلة الماضية؟
Dialogue: 0,0:30:24.24,0:30:27.01,Default,ХО,0,0,0,,-ما الذي تتحدث عنه؟\N-ألا تتذكر؟
Dialogue: 0,0:30:27.38,0:30:29.62,Default,XO,0,0,0,,لقد حاولوا قتلك الليلة الماضية.
Dialogue: 0,0:30:29.62,0:30:31.12,Default,XO,0,0,0,,تقتل؟
Dialogue: 0,0:30:31.42,0:30:33.12,Default,XO,0,0,0,,هل كدت أن أموت؟
Dialogue: 0,0:30:33.12,0:30:34.95,Default,XO,0,0,0,,من كان؟ لماذا انا؟
Dialogue: 0,0:30:34.95,0:30:36.96,Default,XO,0,0,0,,كنت أتمنى أن تعرف،
Dialogue: 0,0:30:37.86,0:30:39.49,Default,XO,0,0,0,,لكنني لا أرى ذلك.
Dialogue: 0,0:30:40.06,0:30:43.93,Default,XO,0,0,0,,ماذا؟ هل حاول شخصان قتلها بالفعل؟
Dialogue: 0,0:30:44.43,0:30:46.06,Default,XO,0,0,0,,هل هذه المرأة في خطر؟
Dialogue: 0,0:30:46.06,0:30:47.77,Default,XO,0,0,0,,اليوم الذي سقطت فيه في البحيرة
Dialogue: 0,0:30:47.77,0:30:51.27,Default,XO,0,0,0,,قلت إنك خائف. أعتقد أن له علاقة بالموضوع.
Dialogue: 0,0:30:51.54,0:30:55.01,Default,XO,0,0,0,,يبدو أنك لست على علم بذلك بعد.\N لدي مشاكل في ذاكرتي.
Dialogue: 0,0:30:55.01,0:30:58.54,Default,XO,0,0,0,,من الأفضل أن تعرف ما كنا نتحدث عنه.
Dialogue: 0,0:30:59.75,0:31:01.25,Default,XO,0,0,0,,أنت على حق
Dialogue: 0,0:31:03.92,0:31:06.55,Default,XO,0,0,0,,هل نسيت كل شيء عن ذلك اليوم؟
Dialogue: 0,0:31:06.55,0:31:09.32,Default,XO,0,0,0,,نعم، لا أتذكر أي شيء.
Dialogue: 0,0:31:12.22,0:31:13.76,Default,XO,0,0,0,,لا يهم.
Dialogue: 0,0:31:13.76,0:31:15.96,Default,XO,0,0,0,,أخبرني، هذا الرجل...
Dialogue: 0,0:31:16.56,0:31:20.50,Default,XO,0,0,0,,ماذا فعل هذا الوغد بي بالأمس؟
Dialogue: 0,0:31:21.00,0:31:23.24,Default,XO,0,0,0,,كان الوقت يقترب من حظر التجول.
Dialogue: 0,0:31:23.24,0:31:24.97,Default,XO,0,0,0,,بالحكم على الطريقة التي استخدم بها السيف
Dialogue: 0,0:31:24.97,0:31:28.17,Default,XO,0,0,0,,وكان يرتدي ملابسه، وهو ليس شخصاً عادياً.
Dialogue: 0,0:31:28.44,0:31:30.58,Default,XO,0,0,0,,لا أعرف كم كان عددهم،
Dialogue: 0,0:31:30.64,0:31:33.04,Default,XO,0,0,0,,لكنهم ساعدوه.
Dialogue: 0,0:31:33.05,0:31:35.61,Default,XO,0,0,0,,لولاك لكنت ميتاً.
Dialogue: 0,0:31:35.61,0:31:38.42,Default,XO,0,0,0,,أنا سعيد للغاية لأننا التقينا بالأمس.
Dialogue: 0,0:31:44.39,0:31:45.86,Default,XO,0,0,0,,هاه؟
Dialogue: 0,0:31:51.56,0:31:53.27,Default,XO,0,0,0,,مرحباً.
Dialogue: 0,0:31:58.24,0:32:00.84,Default,XO,0,0,0,,لماذا غادرت القصر الليلة الماضية؟
Dialogue: 0,0:32:00.84,0:32:03.88,Default,ХО,0,0,0,,شعرت بالملل وقررت أن أتمشى.
Dialogue: 0,0:32:05.64,0:32:09.58,Default,XO,0,0,0,,إذا اكتشفت الملكة الأرملة الأمر،
Dialogue: 0,0:32:09.58,0:32:12.12,Default,XO,0,0,0,,أنا في ورطة.
Dialogue: 0,0:32:12.55,0:32:15.69,Default,XO,0,0,0,,لن يتم تقييد حريتي في الحركة فحسب،
Dialogue: 0,0:32:15.69,0:32:17.66,Default,XO,0,0,0,,لكن تم إعدام "هونغيون" أيضاً.
Dialogue: 0,0:32:18.26,0:32:21.23,Default,XO,0,0,0,,هل يمكنك إبقاء هذا سراً؟
Dialogue: 0,0:32:21.59,0:32:23.93,Default,XO,0,0,0,,ولكن علينا العثور على المجرم.
Dialogue: 0,0:32:24.36,0:32:26.26,Default,XO,0,0,0,,افعل ذلك بهدوء.
Dialogue: 0,0:32:26.33,0:32:29.20,Default,XO,0,0,0,,سوف أقع في مشكلة، هل تعلم؟
Dialogue: 0,0:32:30.20,0:32:31.70,Default,XO,0,0,0,,أنا أفهم.
Dialogue: 0,0:32:31.70,0:32:34.07,Default,XO,0,0,0,,من عرف أنك غادرت القصر؟
Dialogue: 0,0:32:34.07,0:32:36.27,Default,XO,0,0,0,,هونيونغ فقط.
Dialogue: 0,0:32:37.34,0:32:40.31,Default,XO,0,0,0,,سأجعل الناس يراقبونها.
Dialogue: 0,0:32:40.31,0:32:44.55,Default,XO,0,0,0,,لا، إنها مخلصة لي، بل إنها مستعدة للموت من أجلي.
Dialogue: 0,0:32:44.55,0:32:45.98,Default,XO,0,0,0,,ليس لها علاقة بالأمر.
Dialogue: 0,0:32:45.98,0:32:49.96,Default,XO,0,0,0,,جلالتك، لا تثق بأحد.
Dialogue: 0,0:32:49.96,0:32:51.89,Default,ХО,0,0,0,,أنا أعرفها منذ وقت طويل أيضاً،
Dialogue: 0,0:32:51.89,0:32:54.53,Default,XO,0,0,0,,لكن الأقرب إليك هم دائماً أكثر خطورة.
Dialogue: 0,0:32:55.26,0:32:58.70,Default,XO,0,0,0,,فقط لأنك في القصر لا يعني أنه لا يوجد شيء يهددك. لا.
Dialogue: 0,0:33:00.53,0:33:02.80,Default,XO,0,0,0,,الأمر أكثر خطورة هنا.
Dialogue: 0,0:33:03.20,0:33:07.11,Default,XO,0,0,0,,بالضبط، لقد نسيت أين أنا تماماً.
Dialogue: 0,0:33:07.11,0:33:09.21,Default,XO,0,0,0,,في قصر مليء بالمكائد.
Dialogue: 0,0:33:09.21,0:33:12.78,Default,XO,0,0,0,,المكان الذي تكون فيه حياتك دائمًا في الميزان.
Dialogue: 0,0:33:14.48,0:33:16.78,Default,XO,0,0,0,,لا تقلق.
Dialogue: 0,0:33:16.92,0:33:19.38,Default,XO,0,0,0,,سأحميك.
Dialogue: 0,0:33:19.95,0:33:21.72,Default,XO,0,0,0,,شكرًا، لكن
Dialogue: 0,0:33:21.95,0:33:23.72,Default,XO,0,0,0,,يمكنني التعامل مع الأمر بنفسي.
Dialogue: 0,0:33:24.86,0:33:27.29,Default,XO,0,0,0,,الآن ليس وقت الاسترخاء.
Dialogue: 0,0:33:27.59,0:33:31.06,Default,XO,0,0,0,,لا تحاول أن تبدو قوياً أمامي.
Dialogue: 0,0:33:47.61,0:33:49.75,Default,XO,0,0,0,,ربما نسيت،
Dialogue: 0,0:33:50.18,0:33:52.32,Default,XO,0,0,0,,لكنني سأتذكر إلى الأبد.
Dialogue: 0,0:33:52.75,0:33:55.95,Default,XO,0,0,0,,ستبقى ذكرى تلك الليلة في قلبي إلى الأبد.
Dialogue: 0,0:34:01.23,0:34:04.33,Default,XO,0,0,0,,سأكتشف من كان بأي ثمن.
Dialogue: 0,0:34:06.30,0:34:09.07,Default,XO,0,0,0,,
Dialogue: 0,0:34:11.20,0:34:14.44,Default,XO,0,0,0,,يبيعون خيوط الحرير هنا
Dialogue: 0,0:34:14.94,0:34:16.41,Default,XO,0,0,0,,من تشينغ؟
Dialogue: 0,0:34:36.19,0:34:39.50,Default,XO,0,0,0,,سمعت أن لديك بضائع ثمينة من تشينغ، لذلك جئت.
Dialogue: 0,0:34:46.24,0:34:49.01,Default,XO,0,0,0,,تنتشر الشائعات بسرعة.
Dialogue: 0,0:34:50.84,0:34:52.28,Default,XO,0,0,0,,من فضلك.
Dialogue: 0,0:35:08.56,0:35:13.53,Default,XO,0,0,0,,هل تخزن الأشياء الثمينة في مثل هذا المكان المخيف؟
Dialogue: 0,0:35:14.47,0:35:16.97,Default,XO,0,0,0,,لأنها ذات قيمة.
Dialogue: 0,0:35:30.25,0:35:31.68,Default,XO,0,0,0,,هنا.
Dialogue: 0,0:35:31.85,0:35:33.55,Default,XO,0,0,0,,ما هذا؟
Dialogue: 0,0:35:34.85,0:35:37.82,Default,XO,0,0,0,,أغمض عيناً واحدة.
Dialogue: 0,0:35:38.29,0:35:42.23,Default,XO,0,0,0,,ثم استدر. هذه هي الطريقة التي تعمل بها.
Dialogue: 0,0:35:42.23,0:35:44.56,Default,XO,0,0,0,,سيدتي! هنا؟
Dialogue: 0,0:35:44.56,0:35:46.06,Default,XO,0,0,0,,أنا قادم!
Dialogue: 0,0:35:46.83,0:35:48.90,Default,XO,0,0,0,,يبدو أنك أسأت فهمي.
Dialogue: 0,0:35:48.90,0:35:51.54,Default,XO,0,0,0,,أنا أبحث عن غزل الحرير...
Dialogue: 0,0:35:53.57,0:35:55.74,Default,XO,0,0,0,,أردت شراء خيوط.
Dialogue: 0,0:35:56.61,0:35:59.38,Default,XO,0,0,0,,ماذا علي أن أفعل بهذا الأنبوب؟
Dialogue: 0,0:36:17.23,0:36:20.00,Default,XO,0,0,0,,قال كيم بيونغين ألا يثق بأحد.
Dialogue: 0,0:36:20.00,0:36:21.67,Default,XO,0,0,0,,فكيف يمكنك أن تثق به؟
Dialogue: 0,0:36:22.23,0:36:24.37,Default,XO,0,0,0,,هونيون لن يؤذيني.
Dialogue: 0,0:36:24.64,0:36:27.11,Default,XO,0,0,0,,ربما تشو هواجين مرة أخرى؟
Dialogue: 0,0:36:28.14,0:36:29.47,Default,XO,0,0,0,,الأسبوع هو الدهر.
Dialogue: 0,0:36:29.47,0:36:31.58,Default,XO,0,0,0,,لن يستغرق الموت وقتاً طويلاً.
Dialogue: 0,0:36:32.28,0:36:33.88,Default,XO,0,0,0,,سأفعل ما أجيده.
Dialogue: 0,0:36:33.88,0:36:35.58,Default,XO,0,0,0,,سوف أفوز بالطعام.
Dialogue: 0,0:36:35.61,0:36:37.52,Default,XO,0,0,0,,سوف تهزم أي درع.
Dialogue: 0,0:36:37.52,0:36:39.62,Default,XO,0,0,0,,وسيعمل على الملكة الأرملة.
Dialogue: 0,0:36:42.65,0:36:44.09,Default,XO,0,0,0,,دقيقة واحدة فقط.
Dialogue: 0,0:36:44.26,0:36:46.69,Default,XO,0,0,0,,هل هذه بقايا طعام الملكة الأرملة؟
Dialogue: 0,0:36:46.69,0:36:48.19,Default,XO,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:36:50.30,0:36:52.60,Default,XO,0,0,0,,دعني ألقي نظرة.
Dialogue: 0,0:36:52.80,0:36:54.57,Default,XO,0,0,0,,بقايا الطعام يمكن أن تعطي فكرة
Dialogue: 0,0:36:54.57,0:36:56.94,Default,XO,0,0,0,,حول الصحة والتفضيلات.
Dialogue: 0,0:36:56.94,0:36:59.60,Default,XO,0,0,0,,لا يمكنك النظر إليهم.
Dialogue: 0,0:36:59.60,0:37:01.04,افتراضي,XO,0,0,0,,إزالة.
Dialogue: 0,0:37:01.34,0:37:03.98,Default,XO,0,0,0,,ماذا تفعل؟ أنا الملكة.
Dialogue: 0,0:37:03.98,0:37:05.48,Default,XO,0,0,0,,عذراً,
Dialogue: 0,0:37:05.48,0:37:07.78,Default,XO,0,0,0,,لكنني الشيف الملكي.
Dialogue: 0,0:37:07.78,0:37:09.68,Default,XO,0,0,0,,هذا يعني أنه في المطبخ -
Dialogue: 0,0:37:09.68,0:37:11.98,Default,XO,0,0,0,,أنا الملك.
Dialogue: 0,0:37:12.88,0:37:15.65,Default,XO,0,0,0,,إذن دع مهاراتنا تتحدث عن نفسها.
Dialogue: 0,0:37:16.79,0:37:18.46,Default,XO,0,0,0,,دعونا نرى من هو الملك هنا.
Dialogue: 0,0:37:21.19,0:37:23.03,Default,XO,0,0,0,,لا تقل ذلك.
Dialogue: 0,0:37:23.16,0:37:26.46,Default,XO,0,0,0,,حان وقت طهي الطعام. وداع.
Dialogue: 0,0:37:26.83,0:37:29.37,Default,XO,0,0,0,,ماذا كنت خائفاً من خسارته؟
Dialogue: 0,0:37:30.04,0:37:32.97,Default,XO,0,0,0,,شخص كان يلعب في المطبخ فقط عندما كان طفلاً؟
Dialogue: 0,0:37:46.85,0:37:50.05,Default,XO,0,0,0,,حسناً، كيف هي الاستعدادات؟..
Dialogue: 0,0:38:19.38,0:38:20.92,Default,XO,0,0,0,,أيها الآلهة!
Dialogue: 0,0:38:23.79,0:38:25.52,Default,XO,0,0,0,,الملكة!
Dialogue: 0,0:38:25.52,0:38:28.39,Default,XO,0,0,0,,الملكة!
Dialogue: 0,0:38:28.39,0:38:30.63,Default,XO,0,0,0,,الشيف الملكي!
Dialogue: 0,0:38:30.63,0:38:46.81,Default,XO,0,0,0,,-الملكة!\N-Royal Chef!
Dialogue: 0,0:38:57.52,0:38:59.22,Default,XO,0,0,0,,توقف.
Dialogue: 0,0:39:04.23,0:39:05.76,Default,XO,0,0,0,,لا!
Dialogue: 0,0:39:07.87,0:39:09.30,Default,XO,0,0,0,,اللعنة.
Dialogue: 0,0:39:12.54,0:39:14.04,افتراضي,XO,0,0,0,,الطبخ
Dialogue: 0,0:39:14.64,0:39:16.47,Default,XO,0,0,0,,السرعة مهمة.
Dialogue: 0,0:39:16.47,0:39:19.34,Default,XO,0,0,0,,لكن التذوق أكثر أهمية.
Dialogue: 0,0:39:19.34,0:39:20.85,افتراضي,XO,0,0,0,,صحيح.
Dialogue: 0,0:39:26.62,0:39:28.95,Default,,0,0,0,,-أنت.\N-ماذا تريد؟
Dialogue: 0,0:39:28.95,0:39:31.36,Default,,0,0,0,,بالحكم على ملابسك، أنت لا تعمل هنا.
Dialogue: 0,0:39:31.36,0:39:32.42,Default,,0,0,0,,موقفك؟
Dialogue: 0,0:39:32.42,0:39:34.83,Default,,0,0,0,,أنا أتحقق من العروض الملكية.
Dialogue: 0,0:39:34.83,0:39:37.13,Default,,0,0,0,,رئيس مفتشي المطبخ الملكي.
Dialogue: 0,0:39:37.33,0:39:40.03,Default,,0,0,0,,-ثم تحقق من مذاق الطعام.\N-Me؟
Dialogue: 0,0:39:40.47,0:39:41.93,Default,,0,0,0,,جميع الحاضرين هنا
Dialogue: 0,0:39:41.93,0:39:44.20,Default,,0,0,0,,لن يكون قادراً على تقييم الطعام بصدق.
Dialogue: 0,0:39:44.20,0:39:45.80,Default,,0,0,0,,كن شجاعاً، جرب ذلك.
Dialogue: 0,0:39:46.87,0:39:48.37,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:39:51.64,0:39:53.14,Default,,0,0,0,,كما تقول.
Dialogue: 0,0:40:06.19,0:40:10.06,Default,,0,0,0,,لم أجرّب شيئًا كهذا حتى الآن.
Dialogue: 0,0:40:10.33,0:40:11.66,Default,,0,0,0,,مثل النعيم،
Dialogue: 0,0:40:11.66,0:40:14.43,Default,,0,0,0,,هذا الطبق يُسعد فمي.
Dialogue: 0,0:40:14.67,0:40:19.47,Default,,0,0,0,,في حياتي كلها لم يذق لساني أجمل من هذا...
Dialogue: 0,0:40:19.50,0:40:20.97,Default,,0,0,0,,حسناً...
Dialogue: 0,0:40:28.21,0:40:29.81,Default,,0,0,0,,من أنت؟
Dialogue: 0,0:40:38.59,0:40:41.99,Default,,0,0,0,,كيف تجرؤ فتاة على دخول المطبخ الملكي؟
Dialogue: 0,0:40:41.99,0:40:44.26,Default,,0,0,0,,رجس.
Dialogue: 0,0:40:47.60,0:40:49.73,Default,,0,0,0,,هل كان هذا مقصودًا بالنسبة لي؟
Dialogue: 0,0:40:49.97,0:40:53.24,Default,,0,0,0,,كيف تجرؤ فتاة على دخول المطبخ الملكي؟
Dialogue: 0,0:40:57.21,0:41:01.08,Default,,0,0,0,,لا. بالطبع لا.
Dialogue: 0,0:41:07.19,0:41:10.02,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:41:12.49,0:41:13.89,Default,,0,0,0,,كفى.
Dialogue: 0,0:41:14.59,0:41:16.46,Default,,0,0,0,,كنت الأول،
Dialogue: 0,0:41:16.46,0:41:18.50,Default,,0,0,0,,وطعامي رائع المذاق.
Dialogue: 0,0:41:20.70,0:41:23.13,Default,,0,0,0,,بينما أنا في المطبخ،
Dialogue: 0,0:41:23.33,0:41:25.30,Default,,0,0,0,,كلمتي هي القانون.
Dialogue: 0,0:41:26.84,0:41:28.44,Default,,0,0,0,,هل ستعمل معي.
Dialogue: 0,0:41:28.91,0:41:30.44,Default,,0,0,0,,-نعم يا صاحب الجلالة.\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:41:30.44,0:41:31.91,Default,,0,0,0,,لا يكفيها...
Dialogue: 0,0:41:35.41,0:41:40.62,Default,,0,0,0,,إذا أردت، يمكنني أن أعتبرك طالباً.
Dialogue: 0,0:41:43.62,0:41:47.46,Default,,0,0,0,,جلالة الملك، جلالة الملك موجود الآن في قاعة دايجوجونغ.
Dialogue: 0,0:41:54.57,0:41:56.93,Default,,0,0,0,,لماذا أدين بهذه الزيارة المبكرة؟
Dialogue: 0,0:41:57.04,0:41:59.20,Default,,0,0,0,,اشتقت إليك يا ملكتي.
Dialogue: 0,0:41:59.90,0:42:02.34,Default,,0,0,0,,وأنت لطيف حقًا اليوم.
Dialogue: 0,0:42:02.87,0:42:05.48,Default,,0,0,0,,ولكن ألم يحن الوقت لتعود إلى نفسك؟
Dialogue: 0,0:42:05.48,0:42:08.05,Default,,0,0,0,,-القوات الخاصة.\N-ماذا؟
Dialogue: 0,0:42:09.48,0:42:12.18,Default,,0,0,0,,هل هناك شيء تريد إخباري به بخصوص هذه الكلمة؟
Dialogue: 0,0:42:12.22,0:42:14.59,Default,,0,0,0,,-هل هذا نوع من اللعبة؟\N-حسناً...
Dialogue: 0,0:42:15.59,0:42:18.16,Default,,0,0,0,,حان وقت رحيلك.
Dialogue: 0,0:42:19.59,0:42:21.13,Default,,0,0,0,,طباخ الجيش.
Dialogue: 0,0:42:21.49,0:42:22.96,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:42:24.23,0:42:26.36,Default,,0,0,0,,الله. حسنا، حقا، أنت الملك.
Dialogue: 0,0:42:26.36,0:42:28.57,Default,,0,0,0,,الآن سأقول شيئاً، وسوف تعدمني بسببه؟
Dialogue: 0,0:42:28.57,0:42:30.10,Default,,0,0,0,,تابع.
Dialogue: 0,0:42:31.00,0:42:33.27,Default,,0,0,0,,ما هذا الهراء الذي تتحدث عنه؟
Dialogue: 0,0:42:38.08,0:42:40.41,Default,,0,0,0,,أنت تستخدم لغة بذيئة بدون سبب.
Dialogue: 0,0:42:40.41,0:42:43.21,Default,,0,0,0,,لا بد أنك غير سعيد بحياتك.
Dialogue: 0,0:42:43.21,0:42:45.58,Default,,0,0,0,,أخبرني بكل ما يزعجك.
Dialogue: 0,0:42:45.58,0:42:48.29,Default,,0,0,0,,إذا أردت، يمكنني البقاء.
Dialogue: 0,0:42:48.49,0:42:50.32,Default,,0,0,0,,ماذا تقول، كل شيء على ما يرام معي.
Dialogue: 0,0:42:50.32,0:42:53.99,Default,,0,0,0,,نعم، لا أستطيع الاكتفاء من مدى روعة حياتي.
Dialogue: 0,0:42:55.29,0:42:57.76,Default,,0,0,0,,هل رأيت أحداً اليوم؟
Dialogue: 0,0:42:59.00,0:43:00.27,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:43:00.27,0:43:02.10,Default,,0,0,0,,كم سمعت؟
Dialogue: 0,0:43:02.23,0:43:05.10,Default,,0,0,0,,فقط أريد أن أعرف كيف كان يومك.
Dialogue: 0,0:43:05.24,0:43:07.87,Default,,0,0,0,,سأغادر بعد أن نتحدث قليلاً.
Dialogue: 0,0:43:11.78,0:43:15.25,Default,,0,0,0,,حسناً، جاء ابن عمي لرؤيتي.
Dialogue: 0,0:43:16.48,0:43:17.78,Default,,0,0,0,,ابن العم؟
Dialogue: 0,0:43:17.78,0:43:20.28,Default,,0,0,0,,كيم بيونين، إذا لم أكن مخطئاً؟
Dialogue: 0,0:43:20.35,0:43:21.62,Default,,0,0,0,,ماذا كان يحتاج؟
Dialogue: 0,0:43:21.62,0:43:25.56,Default,,0,0,0,,لماذا أشعر وكأنني يتم استجوابي؟
Dialogue: 0,0:43:25.69,0:43:27.39,Default,,0,0,0,,أنت سريع التأثر للغاية.
Dialogue: 0,0:43:27.53,0:43:30.19,Default,,0,0,0,,أنا فقط قلقة على أقاربي
Dialogue: 0,0:43:30.19,0:43:31.83,Default,,0,0,0,,حدث شيء ما.
Dialogue: 0,0:43:31.83,0:43:33.13,Default,,0,0,0,,لا.
Dialogue: 0,0:43:33.13,0:43:35.17,Default,,0,0,0,,جئت للتو لألقي التحية وأهنئ.
Dialogue: 0,0:43:35.17,0:43:37.60,Default,,0,0,0,,إذا كان الأمر كذلك، فلا داعي للقلق بشأنهم.
Dialogue: 0,0:43:38.04,0:43:42.14,Default,,0,0,0,,هل لي أن أسأل، لماذا تعاملني بهذه الطريقة هذه الأيام؟
Dialogue: 0,0:43:43.14,0:43:46.61,Default,,0,0,0,,إنها تكرهني لأنها تعرف أنني قاتلة؟
Dialogue: 0,0:43:47.15,0:43:49.05,Default,,0,0,0,,نحن الآن زوج وزوجة.
Dialogue: 0,0:43:49.05,0:43:50.78,Default,,0,0,0,,حتى لو كنت تحب بجنون،
Dialogue: 0,0:43:50.78,0:43:52.85,Default,,0,0,0,,بعد الزفاف، تختفي الرومانسية.
Dialogue: 0,0:43:53.32,0:43:56.09,Default,,0,0,0,,راضي؟ يمكنك الذهاب.
Dialogue: 0,0:43:56.92,0:44:00.83,Default,,0,0,0,,استمع إلي. إحضار أغطية السرير.
Dialogue: 0,0:44:00.89,0:44:03.70,Default,,0,0,0,,ماذا تفعل؟ لم نتفق بهذه الطريقة.
Dialogue: 0,0:44:03.70,0:44:06.30,Default,,0,0,0,,لقد أتعبتني المحادثات،
Dialogue: 0,0:44:06.30,0:44:09.03,Default,,0,0,0,,لا توجد قوة للعودة إلى هيجيونغجون.
Dialogue: 0,0:44:12.97,0:44:16.31,Default,,0,0,0,,النصر في النهار، والإعداد في الليل.
Dialogue: 0,0:44:23.11,0:44:25.48,Default,,0,0,0,,إنه مريب نوعًا ما.
Dialogue: 0,0:44:26.82,0:44:28.89,Default,,0,0,0,,بطريقةٍ ما، إنها مشبوهة.
Dialogue: 0,0:44:33.59,0:44:34.99,Default,,0,0,0,,جلالتك,
Dialogue: 0,0:44:35.16,0:44:37.80,Default,,0,0,0,,يجب ألا تثق بأحد.
Dialogue: 0,0:44:37.83,0:44:41.23,Default,,0,0,0,,نعم، بالتأكيد ليس لديه إيمان.
Dialogue: 0,0:44:41.23,0:44:43.00,Default,,0,0,0,,بغض النظر عن المكان والزمان،
Dialogue: 0,0:44:43.00,0:44:46.37,Default,,0,0,0,,والزوج هو أول المتهمين بقتل زوجته.
Dialogue: 0,0:44:52.68,0:44:55.71,Default,,0,0,0,,ربما سيخبرك بشيء أثناء نومه.
Dialogue: 0,0:44:55.88,0:44:58.18,Default,,0,0,0,,ماذا لو كان يخطط لشيء ما وينتظرني حتى أنام؟
Dialogue: 0,0:44:58.45,0:45:00.08,Default,,0,0,0,,-لا أستطيع النوم.\N-لا أستطيع النوم.
Dialogue: 0,0:46:01.15,0:46:02.55,Default,,0,0,0,,لا.
Dialogue: 0,0:46:03.08,0:46:06.08,Default,,0,0,0,,لا! لا، لا!
Dialogue: 0,0:46:09.32,0:46:12.19,Default,,0,0,0,,لا، لا تفعل ذلك!
Dialogue: 0,0:46:12.26,0:46:13.46,Default,,0,0,0,,لا.
Dialogue: 0,0:46:13.46,0:46:16.29,Default,,0,0,0,,مرحباً. ما مشكلتك؟
Dialogue: 0,0:46:16.29,0:46:18.23,Default,,0,0,0,,الله. ربما يموت هكذا.
Dialogue: 0,0:46:18.23,0:46:22.10,Default,,0,0,0,,مرحباً. استيقظ! استيقظ، هيا!
Dialogue: 0,0:46:31.74,0:46:33.34,Default,,0,0,0,,هواجين.
Dialogue: 0,0:46:33.88,0:46:36.38,Default,,0,0,0,,لقد أنقذت حياتي من جديد.
Dialogue: 0,0:46:36.38,0:46:38.02,Default,,0,0,0,,شكرًا لك.
Dialogue: 0,0:46:38.02,0:46:41.09,Default,,0,0,0,,هل أنت مجنون؟
Dialogue: 0,0:46:41.09,0:46:42.49,Default,,0,0,0,,الله.
Dialogue: 0,0:46:43.69,0:46:45.16,Default,,0,0,0,,هواجين.
Dialogue: 0,0:46:48.49,0:46:51.16,Default,,0,0,0,,-ملكتي.\N-اللعنة.
Dialogue: 0,0:46:51.36,0:46:54.63,Default,,0,0,0,,هل تعتقد حقاً أنني سأموت إذا ضربتني بهذه الطريقة؟
Dialogue: 0,0:46:54.93,0:46:56.93,Default,,0,0,0,,كنت ستموت لو لم أوقظك.
Dialogue: 0,0:46:56.93,0:46:59.64,Default,,0,0,0,,تهتز مثل الدودة.
Dialogue: 0,0:47:00.30,0:47:04.04,Default,,0,0,0,,لقد ضربتني لأنني قلت اسم امرأة أخرى.
Dialogue: 0,0:47:04.04,0:47:06.31,Default,,0,0,0,,لا داعي للقلق.
Dialogue: 0,0:47:07.61,0:47:09.85,Default,,0,0,0,,لا يهمني بمن تتصل.
Dialogue: 0,0:47:09.85,0:47:12.82,Default,,0,0,0,,دعونا نحافظ على مسافة بيننا.
Dialogue: 0,0:47:15.05,0:47:16.79,Default,,0,0,0,,لقد قلتها مرة أخرى.
Dialogue: 0,0:47:16.95,0:47:18.22,Default,,0,0,0,,بما أنك استيقظت،
Dialogue: 0,0:47:18.22,0:47:20.46,Default,,0,0,0,,من الأفضل أن تعود إلى مكانك
Dialogue: 0,0:47:20.46,0:47:22.63,Default,,0,0,0,,احصل على قسط من النوم.
Dialogue: 0,0:47:24.20,0:47:28.87,Default,,0,0,0,,إذا غادرت الآن، يجب أن أوقظ خدمي. الريجستري ليس جيدًا.
Dialogue: 0,0:47:31.77,0:47:34.11,Default,,0,0,0,,كم نحن كرماء.
Dialogue: 0,0:47:34.24,0:47:37.41,Default,,0,0,0,,أوه يا ملكتي، شكراً لك على الإطراء.
Dialogue: 0,0:47:42.55,0:47:44.55,Default,,0,0,0,,اللهم ملكتي.
Dialogue: 0,0:47:44.55,0:47:47.15,Default,,0,0,0,,أنت أناني للغاية.
Dialogue: 0,0:47:53.09,0:47:55.56,Default,,0,0,0,,نعم، أنت امرأة قوية حقًا.
Dialogue: 0,0:47:55.56,0:47:57.43,Default,,0,0,0,,فقط استلقي واذهب إلى النوم.
Dialogue: 0,0:47:58.70,0:48:02.20,Default,,0,0,0,,يجب أن يكون الملك الرحيم قادراً على المشاركة.
Dialogue: 0,0:48:22.59,0:48:27.49,Default,,0,0,0,,كلما أنام في دايجون، أشعر بألم في جسدي كله.
Dialogue: 0,0:48:28.73,0:48:31.33,Default,,0,0,0,,لذلك لا ينبغي لنا أن ننام معًا بعد الآن.
Dialogue: 0,0:48:31.33,0:48:33.63,Default,,0,0,0,,لابد أن ذلك لأنني لست معتاداً على هذا المكان.
Dialogue: 0,0:48:33.63,0:48:37.30,Default,,0,0,0,,أحتاج إلى البقاء أكثر حتى أعتاد على ذلك.
Dialogue: 0,0:48:38.57,0:48:41.74,Default,,0,0,0,,لا أريد أن أستيقظ مجددًا بسبب كوابيسك.
Dialogue: 0,0:48:42.31,0:48:44.11,Default,,0,0,0,,لا أتذكر أي كوابيس،
Dialogue: 0,0:48:44.11,0:48:46.31,Default,,0,0,0,,وهكذا ضربوني لأنني قلت اسم شخص آخر،
Dialogue: 0,0:48:46.31,0:48:48.28,Default,,0,0,0,,لا أستطيع أن أنسى.
Dialogue: 0,0:48:49.31,0:48:53.08,Default,,0,0,0,,في المرة القادمة سأذكر اسمك.
Dialogue: 0,0:48:53.08,0:48:55.49,Default,,0,0,0,,سأبدأ هذا المساء.
Dialogue: 0,0:48:58.39,0:49:00.89,Default,,0,0,0,,يا إلهي، لقد فقدت شهيتي حتى.
Dialogue: 0,0:49:01.03,0:49:04.09,Default,,0,0,0,,إذا كنت قد أكلت بالفعل، فيمكنك الذهاب. لدي أشياء للقيام بها.
Dialogue: 0,0:49:04.40,0:49:06.80,Default,,0,0,0,,بماذا أنت مشغول جداً؟
Dialogue: 0,0:49:08.30,0:49:09.73,Default,,0,0,0,,العمل.
Dialogue: 0,0:49:09.80,0:49:12.40,Default,,0,0,0,,لأنني لا أستطيع استخدام هاتفي وشبكات التواصل الاجتماعي،
Dialogue: 0,0:49:12.40,0:49:14.81,Default,,0,0,0,,إذن ليس لدي خيار سوى العمل.
Dialogue: 0,0:49:16.11,0:49:17.98,Default,,0,0,0,,الشبكات الاجتماعية؟
Dialogue: 0,0:49:17.98,0:49:19.84,Default,,0,0,0,,الشبكات الاجتماعية.
Dialogue: 0,0:49:21.31,0:49:25.45,Default,,0,0,0,,أنا أفهم. الحب يجب أن يكون العطاء.
Dialogue: 0,0:49:26.88,0:49:29.72,Default,,0,0,0,,الليلة سأكون الحنان نفسه.
Dialogue: 0,0:49:42.97,0:49:45.50,Default,,0,0,0,,ضربة مباشرة!
Dialogue: 0,0:49:46.64,0:49:49.21,Default,,0,0,0,,رائع!
Dialogue: 0,0:49:49.21,0:49:51.54,Default,,0,0,0,,أين تعلمت هذا؟
Dialogue: 0,0:49:51.61,0:49:53.34,Default,,0,0,0,,أنت تربكني.
Dialogue: 0,0:49:53.95,0:49:57.68,Default,,0,0,0,,هل يجب أن أظهر ما أنا قادر عليه؟
Dialogue: 0,0:49:57.68,0:49:59.18,Default,,0,0,0,,لذا.
Dialogue: 0,0:50:10.06,0:50:11.53,Default,,0,0,0,,حسناً، حسناً...
Dialogue: 0,0:50:12.23,0:50:13.90,Default,,0,0,0,,كل شيء بدأ يدور ويدور،
Dialogue: 0,0:50:13.90,0:50:16.23,Default,,0,0,0,,بشكل عام، قضيت عدة ليالٍ مع الملك.
Dialogue: 0,0:50:16.40,0:50:18.74,Default,,0,0,0,,لكننا لم ننام معه.
Dialogue: 0,0:50:21.24,0:50:23.01,Default,,0,0,0,,كنا نتظاهر فقط.
Dialogue: 0,0:50:23.21,0:50:25.71,Default,,0,0,0,,كما تعلم، عادةً ما يذهب إلى غرفته.
Dialogue: 0,0:50:26.78,0:50:28.61,Default,,0,0,0,,ولكن يبدو أنه تم استبداله بالأمس:
Dialogue: 0,0:50:28.61,0:50:30.58,Default,,0,0,0,,رفض الذهاب إلى مكانه.
Dialogue: 0,0:50:30.65,0:50:32.48,Default,,0,0,0,,لكن لا تقلق.
Dialogue: 0,0:50:32.48,0:50:34.99,Default,,0,0,0,,لم يكن هناك شيء في الليل، ولن يكون هناك شيء في المستقبل.
Dialogue: 0,0:50:34.99,0:50:39.72,Default,,0,0,0,,طلبت أن نلتقي لتخبرني بهذا؟
Dialogue: 0,0:50:39.79,0:50:41.29,Default,,0,0,0,,لا، ليس حقًا.
Dialogue: 0,0:50:41.29,0:50:44.00,Default,,0,0,0,,هل صحيح أنها دفعتني إلى البحيرة؟
Dialogue: 0,0:50:44.00,0:50:45.60,Default,,0,0,0,,وبعد ذلك أيضاً؟
Dialogue: 0,0:50:46.16,0:50:49.70,Default,,0,0,0,,إذن فالأمر يستحق التباطؤ لبضعة أيام.
Dialogue: 0,0:50:50.47,0:50:53.87,Default,,0,0,0,,من الصعب جدًا أن تكرهك فتاة جميلة.
Dialogue: 0,0:50:54.31,0:50:56.41,Default,,0,0,0,,ليتك لا تكرهني.
Dialogue: 0,0:50:58.48,0:51:01.95,Default,,0,0,0,,يبدو أن الريح لم تكن لصالحك هذه المرة.
Dialogue: 0,0:51:02.41,0:51:05.48,Default,,0,0,0,,إذا كنت تثق بي وانتظرت بضعة أيام...
Dialogue: 0,0:51:06.42,0:51:10.39,Default,,0,0,0,,هل تعرف من الذي لا يجب أن أثق به بالتأكيد في القصر؟
Dialogue: 0,0:51:11.79,0:51:14.59,Default,,0,0,0,,لك يا صاحب الجلالة. لذلك
Dialogue: 0,0:51:14.76,0:51:17.90,Default,,0,0,0,,لا أصدق أي شيء قلته.
Dialogue: 0,0:51:19.03,0:51:23.23,Default,,0,0,0,,ولا تحاول أن تدخل بيني وبين جلالته بعد،
Dialogue: 0,0:51:23.23,0:51:24.87,Default,,0,0,0,,من الأفضل أن تستسلم.
Dialogue: 0,0:51:24.87,0:51:27.64,Default,,0,0,0,,لقد بدأت العيش من الصفر.
Dialogue: 0,0:51:27.71,0:51:29.71,Default,,0,0,0,,ألا ترى كيف تغيرت؟
Dialogue: 0,0:51:30.21,0:51:32.01,Default,,0,0,0,,لقد تغيرت إلى الأسوأ.
Dialogue: 0,0:51:32.01,0:51:34.35,Default,,0,0,0,,تبتسم في وجهي،
Dialogue: 0,0:51:34.55,0:51:37.35,Default,,0,0,0,,لكن من وراء ظهري يلومني على ما حدث في البحيرة.
Dialogue: 0,0:51:37.68,0:51:40.55,Default,,0,0,0,,لم ألومك أبداً على هذا.
Dialogue: 0,0:51:40.55,0:51:41.82,Default,,0,0,0,,لا نعرف من يكون،
Dialogue: 0,0:51:41.82,0:51:44.12,Default,,0,0,0,,أنت مشتبه به لأنك كنت هناك.
Dialogue: 0,0:51:44.12,0:51:47.66,Default,,0,0,0,,أنت تعرف من كان.
Dialogue: 0,0:51:52.93,0:51:54.53,Default,,0,0,0,,الشخص الذي فعل هذا هو
Dialogue: 0,0:51:55.57,0:51:57.80,Default,,0,0,0,,هذا أنت يا صاحب الجلالة.
Dialogue: 0,0:52:04.11,0:52:06.64,Default,,0,0,0,,لقد سقطت في الماء عمداً،
Dialogue: 0,0:52:06.98,0:52:09.35,Default,,0,0,0,,لإعدادي.
Dialogue: 0,0:52:17.79,0:52:20.82,Default,,0,0,0,,بالحكم على مدى غضبها، فهي لا تكذب.
Dialogue: 0,0:52:21.63,0:52:24.43,Default,,0,0,0,,الآن أعرف لماذا تنظر إليّ بهذه البرودة.
Dialogue: 0,0:52:25.16,0:52:29.17,Default,,0,0,0,,حادثة البحيرة ملفقة. وما بقي هو القاتل.
Dialogue: 0,0:52:30.10,0:52:34.10,Default,,0,0,0,,حقيقة أن هناك من يتابعني لا تتغير.
Dialogue: 0,0:52:35.37,0:52:39.21,Default,,0,0,0,,جلالة الملك، عليك العودة إلى قاعة دايجوجون.
Dialogue: 0,0:52:39.74,0:52:42.08,Default,,0,0,0,,سيدة البلاط تشوي،\Ngo أولاً إلى دايجوجونغ.
Dialogue: 0,0:52:45.02,0:52:47.22,Default,,0,0,0,,إذا حدث شيء ما، فكر في شيء ما
Dialogue: 0,0:52:47.22,0:52:48.92,Default,,0,0,0,,وأرسل "هونغيون" ورائي.
Dialogue: 0,0:52:48.92,0:52:49.99,Default,,0,0,0,,لا أجرؤ...
Dialogue: 0,0:52:49.99,0:52:51.89,Default,,0,0,0,,هذه هي الطريقة الوحيدة التي يمكنك مساعدتي بها.
Dialogue: 0,0:52:52.29,0:52:53.72,Default,,0,0,0,,من فضلك.
Dialogue: 0,0:52:56.09,0:52:58.06,Default,,0,0,0,,مرحباً هنا.
Dialogue: 0,0:53:00.10,0:53:01.27,Default,,0,0,0,,الشيف الملكي.
Dialogue: 0,0:53:01.27,0:53:03.77,Default,,0,0,0,,كم مرة تخدم الملكة الأرملة؟
Dialogue: 0,0:53:03.77,0:53:05.84,Default,,0,0,0,,لا أستطيع الجزم بذلك،
Dialogue: 0,0:53:05.84,0:53:07.84,Default,,0,0,0,,ولكن عدة مرات في اليوم بالتأكيد.
Dialogue: 0,0:53:15.58,0:53:18.15,Default,,0,0,0,,لم أقصد أن أقول ذلك،
Dialogue: 0,0:53:18.15,0:53:21.49,Default,,0,0,0,,ولكن في جوسون هناك الكثير ممن يمكنهم\Nأن يصبحوا طاهياً ملكياً.
Dialogue: 0,0:53:26.62,0:53:28.13,Default,,0,0,0,,أتناول الإفطار والغداء ووجبة خفيفة بعد الظهر،
Dialogue: 0,0:53:28.13,0:53:29.33,Default,,0,0,0,,وجبات خفيفة، عشاء
Dialogue: 0,0:53:29.33,0:53:32.20,Default,,0,0,0,,والوجبات الخفيفة الليلية.
Dialogue: 0,0:53:32.26,0:53:33.46,Default,,0,0,0,,وتأكله كله؟
Dialogue: 0,0:53:33.46,0:53:35.47,Default,,0,0,0,,مرة كل 3-4 أيام
Dialogue: 0,0:53:35.60,0:53:38.04,Default,,0,0,0,,ترفض الغداء.
Dialogue: 0,0:53:38.04,0:53:42.51,Default,,0,0,0,,في مثل هذا اليوم تطلب العسل ومسحوق الزنجبيل.
Dialogue: 0,0:53:49.15,0:53:50.71,Default,,0,0,0,,لم تأكل
Dialogue: 0,0:53:50.71,0:53:53.62,Default,,0,0,0,,بارد وشيء للمضغ.
Dialogue: 0,0:53:53.62,0:53:55.59,Default,,0,0,0,,لم تطلب تغيير القائمة،
Dialogue: 0,0:53:55.59,0:53:57.52,Default,,0,0,0,,مما يعني أنه يريد إخفاءه.
Dialogue: 0,0:53:59.46,0:54:03.09,Default,,0,0,0,,إنني أنظر إلى وجوههم أكثر من مهاراتهم.
Dialogue: 0,0:54:03.66,0:54:05.96,Default,,0,0,0,,أليسوا جميعهم وسيمين؟
Dialogue: 0,0:54:06.76,0:54:08.20,Default,,0,0,0,,-بام.\N-بام.
Dialogue: 0,0:54:08.33,0:54:09.80,Default,,0,0,0,,مرحبًا!
Dialogue: 0,0:54:09.93,0:54:12.10,Default,,0,0,0,,هل تعتقد أن صوت اللقطة هادئ جدًا؟
Dialogue: 0,0:54:12.10,0:54:15.27,Default,,0,0,0,,يجب أن يكون الصوت أعلى. "بام"!
Dialogue: 0,0:54:15.27,0:54:17.37,Default,,0,0,0,,-بام.\N-بام.
Dialogue: 0,0:54:17.37,0:54:19.91,Default,,0,0,0,,عزيزي وزير الحرب، غطاء رأسك منحرف.
Dialogue: 0,0:54:19.91,0:54:23.01,Default,,0,0,0,,ماذا تسمح لنفسك؟
Dialogue: 0,0:54:23.58,0:54:27.15,Default,,0,0,0,,بالمناسبة، سمعت أنك طلبت من الملك أن ينقلك
Dialogue: 0,0:54:27.15,0:54:28.75,Default,,0,0,0,,إلى مكتب الحرس الملكي.
Dialogue: 0,0:54:28.75,0:54:31.92,Default,,0,0,0,,إدارة الحرس الملكي ليست قوات،
Dialogue: 0,0:54:31.92,0:54:33.66,Default,,0,0,0,,يمكنك العبث هناك.
Dialogue: 0,0:54:33.66,0:54:35.16,Default,,0,0,0,,تنتشر مثل هذه الشائعات،
Dialogue: 0,0:54:35.16,0:54:37.36,Default,,0,0,0,,وفكرت: هذا ما أحتاجه.
Dialogue: 0,0:54:37.36,0:54:40.46,Default,,0,0,0,,لا أحب أن أجهد نفسي.
Dialogue: 0,0:54:53.64,0:54:55.91,Default,,0,0,0,,-متى؟\N-هذه الليلة.
Dialogue: 0,0:54:55.91,0:54:57.35,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:55:05.09,0:55:07.66,Default,,0,0,0,,هذا مسحوق الغاريق الذباب.
Dialogue: 0,0:55:07.66,0:55:09.59,Default,,0,0,0,,عديم الرائحة والمذاق.
Dialogue: 0,0:55:09.59,0:55:12.96,Default,,0,0,0,,اخلطه مع الكحول واكشف كل الأسرار.
Dialogue: 0,0:55:13.50,0:55:16.70,Default,,0,0,0,,ولكن إذا علمت الملكة شيئاً،
Dialogue: 0,0:55:16.70,0:55:18.57,Default,,0,0,0,,لن تجلس صامتة.
Dialogue: 0,0:55:18.60,0:55:20.84,Default,,0,0,0,,إما أنها تخطط لشيء ما،
Dialogue: 0,0:55:20.94,0:55:23.11,Default,,0,0,0,,أو انتظار اللحظة المناسبة.
Dialogue: 0,0:55:23.47,0:55:25.31,Default,,0,0,0,,أحتاج للتأكد.
Dialogue: 0,0:55:34.42,0:55:37.22,Default,,0,0,0,,الأمير يونبيونغ ليس لديه الطموح الكافي.
Dialogue: 0,0:55:37.22,0:55:39.92,Default,,0,0,0,,إنه متمسك بجلالته
Dialogue: 0,0:55:39.92,0:55:42.86,Default,,0,0,0,,وتتسكع مع هونغ بيولغام
Dialogue: 0,0:55:44.13,0:55:46.00,Default,,0,0,0,,في الليل.
Dialogue: 0,0:55:49.30,0:55:51.67,Default,,0,0,0,,حضرة بيولغام
Dialogue: 0,0:55:52.00,0:55:55.14,Default,,0,0,0,,لا يزال نفس المتهرب،\N يتنصل من مسؤولياته.
Dialogue: 0,0:55:55.81,0:55:58.08,Default,,0,0,0,,مكتب الحرس الملكي مجرد اسم.
Dialogue: 0,0:55:58.08,0:55:59.98,Default,,0,0,0,,من الأفضل السماح له بالجلوس هناك.
Dialogue: 0,0:56:00.78,0:56:02.55,Default,,0,0,0,,لم يفقد أباه وأخيه فقط،
Dialogue: 0,0:56:02.55,0:56:05.45,Default,,0,0,0,,ولكن أيضاً أمه وأجداده أمام عينيه.
Dialogue: 0,0:56:05.78,0:56:07.99,Default,,0,0,0,,كان هذا بمثابة درس له.
Dialogue: 0,0:56:08.15,0:56:13.16,Default,,0,0,0,,بالمناسبة، متى سيتم تعيينك رئيساً للحرس الملكي؟
Dialogue: 0,0:56:13.89,0:56:15.29,Default,,0,0,0,,هل هناك مشكلة؟
Dialogue: 0,0:56:15.29,0:56:18.93,Default,,0,0,0,,أريد فقط ترتيب كل شيء قبل تعيينه.
Dialogue: 0,0:56:22.57,0:56:25.70,Default,,0,0,0,,هل استفدت من تبادل المعلومات العسكرية مرة أخرى؟
Dialogue: 0,0:56:27.00,0:56:28.91,Default,,0,0,0,,لا تتجاوز الخط.
Dialogue: 0,0:56:29.11,0:56:31.14,Default,,0,0,0,,كم مرة أخبرتك بالفعل،
Dialogue: 0,0:56:31.14,0:56:33.14,Default,,0,0,0,,أن الجيش غير المستقر خطير جداً؟
Dialogue: 0,0:56:33.74,0:56:35.21,Default,,0,0,0,,أعلم.
Dialogue: 0,0:56:35.88,0:56:37.68,Default,,0,0,0,,سأعتني بكل شيء.
Dialogue: 0,0:56:40.15,0:56:41.79,Default,,0,0,0,,بغض النظر عن مدى تفكيري،
Dialogue: 0,0:56:42.35,0:56:45.56,Default,,0,0,0,,لكنني أشعر أن شيئاً خطيراً يحدث خارج القصر.
Dialogue: 0,0:56:45.56,0:56:46.92,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:56:46.92,0:56:50.33,Default,,0,0,0,,في الطريق إلى "أوكتاجيونغ" قبل يومين...
Dialogue: 0,0:56:50.46,0:56:52.73,Default,,0,0,0,,هل قلت أوكثاجيونغ؟
Dialogue: 0,0:56:52.73,0:56:56.00,Default,,0,0,0,,نعم. لقد كونت صداقات مع رجل واحد
Dialogue: 0,0:56:56.00,0:56:59.80,Default,,0,0,0,,بالاسم الرائع "لي سانمان".
Dialogue: 0,0:57:00.30,0:57:01.97,Default,,0,0,0,,لي سينمان.
Dialogue: 0,0:57:02.17,0:57:03.97,Default,,0,0,0,,هل تعرفه؟
Dialogue: 0,0:57:04.51,0:57:07.81,Default,,0,0,0,,لا. لكن الاسم يبدو مألوفا.
Dialogue: 0,0:57:07.81,0:57:10.21,Default,,0,0,0,,ربما يكون من عائلة نبيلة مشهورة.
Dialogue: 0,0:57:10.21,0:57:12.05,Default,,0,0,0,,لكنني لم أسمع اسمه قط.
Dialogue: 0,0:57:12.92,0:57:16.55,Default,,0,0,0,,لذا، عندما ذهبنا معه إلى أوكثاجيونغ،
Dialogue: 0,0:57:16.55,0:57:19.52,Default,,0,0,0,,فجأة ضربني أحدهم،
Dialogue: 0,0:57:19.52,0:57:21.43,Default,,0,0,0,,ولقد فقدت الوعي.
Dialogue: 0,0:57:22.33,0:57:23.93,Default,,0,0,0,,عندما استيقظت،
Dialogue: 0,0:57:23.93,0:57:29.43,Default,,0,0,0,,أدركت أن "لي سينمان" قد اختفى مثل الشبح.
Dialogue: 0,0:57:29.47,0:57:31.94,Default,,0,0,0,,هل تتذكر كيف كان يرتدي؟
Dialogue: 0,0:57:31.94,0:57:34.17,Default,,0,0,0,,-بالطبع.\N-على ذلك
Dialogue: 0,0:57:36.04,0:57:38.88,Default,,0,0,0,,هل كانت هناك ملابس مصنوعة من هذا القماش؟
Dialogue: 0,0:57:45.02,0:57:46.45,Default,,0,0,0,,لا.
Dialogue: 0,0:57:50.09,0:57:51.52,Default,,0,0,0,,فهمت.
Dialogue: 0,0:57:51.59,0:57:54.46,Default,,0,0,0,,إذا رأيت صديقك مرة أخرى،
Dialogue: 0,0:57:54.46,0:57:56.96,Default,,0,0,0,,اكتشف ما حدث بعد ذلك.
Dialogue: 0,0:57:57.23,0:57:58.90,Default,,0,0,0,,هل هذا يعني،
Dialogue: 0,0:57:59.90,0:58:03.23,Default,,0,0,0,,ما هي المهمة الخاصة التي تكلفني بها؟
Dialogue: 0,0:58:03.23,0:58:05.50,Default,,0,0,0,,لن أسمي هذه مهمة خاصة.
Dialogue: 0,0:58:07.94,0:58:09.41,Default,,0,0,0,,بالمناسبة.
Dialogue: 0,0:58:09.74,0:58:13.18,Default,,0,0,0,,تأتي إلى القصر كل يوم، لكن لا تفعل شيئاً.
Dialogue: 0,0:58:13.18,0:58:15.28,Default,,0,0,0,,ماذا تقصد بأنني لا أفعل أي شيء؟
Dialogue: 0,0:58:15.28,0:58:17.21,Default,,0,0,0,,ويوم كامل لا يكفي،
Dialogue: 0,0:58:17.21,0:58:19.12,Default,,0,0,0,,فقط لتحية الجميع.
Dialogue: 0,0:58:22.55,0:58:25.16,Default,,0,0,0,,هذه المهمة مثالية لك.
Dialogue: 0,0:58:25.52,0:58:27.42,Default,,0,0,0,,هذه المهمة الخاصة.
Dialogue: 0,0:58:27.86,0:58:29.63,Default,,0,0,0,,أخيرًا.
Dialogue: 0,0:58:47.51,0:58:51.31,Default,,0,0,0,,(التباعد الاجتماعي)
Dialogue: 0,0:58:54.89,0:58:57.32,Default,,0,0,0,,(التباعد الاجتماعي)
Dialogue: 0,0:59:00.66,0:59:02.09,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:59:02.09,0:59:04.29,Default,,0,0,0,,لقد وصل الأمير يونبيونغ.
Dialogue: 0,0:59:04.29,0:59:05.70,Default,,0,0,0,,نعم.
Dialogue: 0,0:59:10.23,0:59:13.64,Default,,0,0,0,,هل تعرف ماذا يعني هذا؟
Dialogue: 0,0:59:13.94,0:59:15.37,Default,,0,0,0,,عفوا؟
Dialogue: 0,0:59:15.94,0:59:17.81,Default,,0,0,0,,تعال وألقِ نظرة.
Dialogue: 0,0:59:22.21,0:59:23.55,Default,,0,0,0,,التباعد الاجتماعي؟
Dialogue: 0,0:59:23.55,0:59:27.28,Default,,0,0,0,,بحسب الملكة، هذا يعني "سنعيش بسعادة".
Dialogue: 0,0:59:27.28,0:59:29.95,Default,,0,0,0,,لكن من أين تأتي الكلمات؟
Dialogue: 0,0:59:32.69,0:59:34.89,Default,,0,0,0,,لم أسمع قط.
Dialogue: 0,0:59:36.93,0:59:39.83,Default,,0,0,0,,أو ربما من الكتب البوذية المقدسة؟
Dialogue: 0,0:59:49.34,0:59:52.28,Default,,0,0,0,,أود أن أتناول الشاي مع أخي.
Dialogue: 0,0:59:52.61,0:59:54.95,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,1:00:04.42,1:00:06.66,Default,,0,0,0,,أظل أفكر فيما قالته الملكة،
Dialogue: 0,1:00:06.66,1:00:10.26,Default,,0,0,0,,لأن بعض كلماتها الرائعة\N قد يكون لها بعض المعنى.
Dialogue: 0,1:00:10.36,1:00:11.86,Default,,0,0,0,,نعم.
Dialogue: 0,1:00:14.70,1:00:16.40,Default,,0,0,0,,هذا ما طلبته.
Dialogue: 0,1:00:17.94,1:00:19.64,Default,,0,0,0,,عمل رائع.
Dialogue: 0,1:00:21.57,1:00:23.17,Default,,0,0,0,,هل سيحدث هذا اليوم؟
Dialogue: 0,1:00:23.27,1:00:25.31,Default,,0,0,0,,الأسرع هو الأفضل.
Dialogue: 0,1:00:27.51,1:00:28.98,الافتراضي,,0,0,0,,صحيح.
Dialogue: 0,1:00:30.08,1:00:32.05,Default,,0,0,0,,أعطني المزيد من الطين.
Dialogue: 0,1:00:32.85,1:00:34.25,Default,,0,0,0,,نعم.
Dialogue: 0,1:00:37.32,1:00:39.56,Default,,0,0,0,,هذا طلبك،
Dialogue: 0,1:00:39.56,1:00:41.39,Default,,0,0,0,,لكن إذا أتلفت الفرن...
Dialogue: 0,1:00:41.39,1:00:44.16,Default,,0,0,0,,دعني لا أفسد الأمر. هذه ترقية.
Dialogue: 0,1:00:44.83,1:00:46.90,Default,,0,0,0,,يا لها من امرأة مجنونة.
Dialogue: 0,1:00:54.37,1:00:58.31,Default,,0,0,0,,يا أيها المجنون، ما هذه الحجارة الصغيرة!
Dialogue: 0,1:00:59.01,1:01:00.61,Default,,0,0,0,,ماذا؟ صعب؟
Dialogue: 0,1:01:00.91,1:01:03.28,Default,,0,0,0,,دعني أساعدك. هذا واحد مثالي.
Dialogue: 0,1:01:03.28,1:01:04.38,Default,,0,0,0,,كبير جدًا.
Dialogue: 0,1:01:04.38,1:01:06.02,Default,,0,0,0,,لماذا تضع هذا؟
Dialogue: 0,1:01:06.02,1:01:08.45,Default,,0,0,0,,-جلالتك!\N-النفط أم ماذا؟
Dialogue: 0,1:01:08.45,1:01:11.52,Default,,0,0,0,,نعم. كما طلبت، أحضرت جميع الأصناف - بذور اللفت، والسمسم، والخطر
Dialogue: 0,1:01:11.52,1:01:13.49,Default,,0,0,0,,وعموما كل ما وجدته.
Dialogue: 0,1:01:13.49,1:01:15.46,Default,,0,0,0,,أحسنت.
Dialogue: 0,1:01:20.43,1:01:22.23,Default,,0,0,0,,يا لها من جوهرة!
Dialogue: 0,1:01:22.23,1:01:25.27,Default,,0,0,0,,جلالتك. هذا هو مخزوننا السنوي من النفط.
Dialogue: 0,1:01:25.57,1:01:27.64,Default,,0,0,0,,الطبخ عبارة عن 80% من المكونات.
Dialogue: 0,1:01:27.64,1:01:29.54,Default,,0,0,0,,مصيري يعتمد على هذا الطعام.
Dialogue: 0,1:01:30.64,1:01:31.71,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:01:31.71,1:01:34.81,Default,,0,0,0,,لقد ذهب جلالته إلى الراحة منذ فترة طويلة.
Dialogue: 0,1:01:34.81,1:01:36.78,Default,,0,0,0,,أخبرني، لدي دين أطفال هنا.
Dialogue: 0,1:01:36.78,1:01:39.52,Default,,0,0,0,,لا، لا. لقد سكبت كل شيء، كل شيء.
Dialogue: 0,1:01:58.20,1:02:01.17,Default,,0,0,0,,كيف يمكنك أن تحضر لها كل هدايانا الثمينة؟
Dialogue: 0,1:02:01.17,1:02:04.11,Default,,0,0,0,,نعم، كنت سأستلقي على الأرض بالفعل لو لم أحضرها.
Dialogue: 0,1:02:04.44,1:02:06.71,Default,,0,0,0,,نحن نهدد، وسوف يجروننا أكثر.
Dialogue: 0,1:02:06.71,1:02:08.48,Default,,0,0,0,,لماذا ترتعش؟
Dialogue: 0,1:02:13.95,1:02:16.82,Default,,0,0,0,,لا يزن حتى. ماذا ستفعل؟
Dialogue: 0,1:02:21.26,1:02:24.86,Default,,0,0,0,,مثل هذه المكونات القيمة.
Dialogue: 0,1:02:30.47,1:02:33.67,Default,,0,0,0,,حسنًا، انتهيت. عظيم.
Dialogue: 0,1:02:36.84,1:02:39.21,Default,,0,0,0,,أحسنت.
Dialogue: 0,1:02:39.21,1:02:41.01,Default,,0,0,0,,-خذ هذا. \N-نعم.
Dialogue: 0,1:02:41.01,1:02:43.18,Default,,0,0,0,,-ضعها هناك.\N-ماذا؟
Dialogue: 0,1:02:43.18,1:02:45.55,Default,,0,0,0,,-أقول، ألصقها هنا.\N -نعم يا صاحب الجلالة.
Dialogue: 0,1:02:55.49,1:02:57.13,Default,,0,0,0,,تم.
Dialogue: 0,1:02:57.96,1:03:01.33,Default,,0,0,0,,متذمر عالي الجودة - لقد رميه للتو في النار.
Dialogue: 0,1:03:01.33,1:03:04.50,Default,,0,0,0,,أي نوع من المراوغات.
Dialogue: 0,1:03:22.35,1:03:25.29,Default,,0,0,0,,صاحب الجلالة، أعتذر إذا تجاوزت الحدود،
Dialogue: 0,1:03:25.29,1:03:27.96,Default,,0,0,0,,لكن صاحبة الجلالة في المطبخ الملكي
Dialogue: 0,1:03:27.96,1:03:31.36,Default,,0,0,0,,يراقب إعداد الطعام للملكة الأرملة.
Dialogue: 0,1:03:31.83,1:03:35.10,Default,,0,0,0,,أنا أفهم. سأنتظر.
Dialogue: 0,1:03:35.40,1:03:37.57,Default,,0,0,0,,عذراً.
Dialogue: 0,1:03:49.65,1:03:52.25,Default,,0,0,0,,إنها تتجنبني.
Dialogue: 0,1:04:30.02,1:04:31.22,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:04:31.22,1:04:33.49,Default,,0,0,0,,اللعنة، لقد فقدت الوعي لسبب ما.
Dialogue: 0,1:04:39.70,1:04:42.20,Default,,0,0,0,,مصيري يعتمد عليك.
Dialogue: 0,1:04:57.78,1:04:59.85,Default,,0,0,0,,سوف يحترق.
Dialogue: 0,1:05:13.23,1:05:14.70,Default,,0,0,0,,أخبرها.
Dialogue: 0,1:05:17.50,1:05:21.47,Default,,0,0,0,,لقد أخبرتك أنني لست بحاجة إلى الإفطار.
Dialogue: 0,1:05:22.64,1:05:26.61,Default,,0,0,0,,أعدته الملكة بنفسها.
Dialogue: 0,1:05:30.48,1:05:33.92,Default,,0,0,0,,-هل استعدت الملكة؟\N-نعم يا صاحب الجلالة.
Dialogue: 0,1:05:34.32,1:05:38.32,Default,,0,0,0,,قضيت الليلة بأكملها في هذا.
Dialogue: 0,1:05:38.32,1:05:40.59,Default,,0,0,0,,أقدر هذا الجهد،
Dialogue: 0,1:05:43.56,1:05:46.43,Default,,0,0,0,,لكن من ماذا صنعت؟
Dialogue: 0,1:05:46.43,1:05:48.50,Default,,0,0,0,,يبدو مختلفًا.
Dialogue: 0,1:05:48.80,1:05:50.90,Default,,0,0,0,,لقد طبخت من لحم البقر ولحم الخنزير
Dialogue: 0,1:05:50.90,1:05:55.37,Default,,0,0,0,,والمتذمر - كل ذلك معًا.
Dialogue: 0,1:05:55.74,1:05:59.51,Default,,0,0,0,,أشبه بالتطريز منه بالطعام.
Dialogue: 0,1:06:01.21,1:06:03.48,Default,,0,0,0,,أنا حقاً ليس لدي شهية،
Dialogue: 0,1:06:03.48,1:06:06.85,Default,,0,0,0,,لكنك تقول أنها قضت الليلة بأكملها.
Dialogue: 0,1:06:06.85,1:06:09.12,Default,,0,0,0,,أنا ممتنة، لذا سأحاول قطعة ما.
Dialogue: 0,1:06:36.18,1:06:38.05,Default,,0,0,0,,أليس هناك أخبار بعد؟
Dialogue: 0,1:06:38.75,1:06:40.25,Default,,0,0,0,,نعم.
Dialogue: 0,1:06:45.12,1:06:47.19,Default,,0,0,0,,هذا لن ينجح. سأذهب بنفسي.
Dialogue: 0,1:06:47.19,1:06:50.36,Default,,0,0,0,,لقد وصلت الملكة الأرملة.
Dialogue: 0,1:07:05.24,1:07:08.81,Default,,0,0,0,,-النصر؟\N-كيف يمكنك ذلك؟
Dialogue: 0,1:07:11.48,1:07:12.95,Default,,0,0,0,,إخفاق تام؟
Dialogue: 0,1:07:15.52,1:07:18.72,Default,,0,0,0,,لماذا أخفيت هذه الموهبة؟
Dialogue: 0,1:07:18.89,1:07:20.29,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:07:21.49,1:07:25.16,Default,,0,0,0,,لا أعرف حتى كم من الوقت مضى منذ أن استمتعت بالطعام إلى هذا الحد.
Dialogue: 0,1:07:25.16,1:07:27.40,Default,,0,0,0,,أنا متحمس جدًا بشأن الطعام،
Dialogue: 0,1:07:27.40,1:07:29.63,Default,,0,0,0,,أنني كنت غاضباً حقاً!
Dialogue: 0,1:07:30.67,1:07:32.50,Default,,0,0,0,,انتصار.
Dialogue: 0,1:07:34.17,1:07:37.31,Default,,0,0,0,,أنا سعيد لأنه أعجبك.
Dialogue: 0,1:07:37.44,1:07:39.81,Default,,0,0,0,,بالطبع أعجبتني.
Dialogue: 0,1:07:39.81,1:07:42.88,Default,,0,0,0,,يبدو أنني أستطيع تناول هذا كل يوم.
Dialogue: 0,1:07:43.05,1:07:44.98,Default,,0,0,0,,كيف أعددت هذا؟
Dialogue: 0,1:07:44.98,1:07:47.95,Default,,0,0,0,,لم أجرّب مثل هذا الملمس الدقيق من قبل،
Dialogue: 0,1:07:47.95,1:07:50.52,Default,,0,0,0,,يا له من طعم غني.
Dialogue: 0,1:07:51.82,1:07:57.70,Default,,0,0,0,,طبخت في الزيت على نار خفيفة جداً طوال الليل.
Dialogue: 0,1:07:59.43,1:08:01.73,Default,,0,0,0,,أضع السمك في الزيت على الفحم في الفرن،
Dialogue: 0,1:08:01.73,1:08:03.30,Default,,0,0,0,,لطهي الطعام ببطء طوال الليل.
Dialogue: 0,1:08:03.30,1:08:07.27,Default,,0,0,0,,أردت أن تكون القشرة مقرمشة واللحم طرياً.
Dialogue: 0,1:08:07.37,1:08:10.61,Default,,0,0,0,,لجعل اللحم يمضغ بشكل أفضل،\N أضعه في مرجل مع الزيت
Dialogue: 0,1:08:10.61,1:08:13.81,Default,,0,0,0,,ويطهى على نار خفيفة طوال الليل.
Dialogue: 0,1:08:14.88,1:08:18.38,Default,,0,0,0,,تحافظ هذه الطريقة على العناصر الغذائية في الطعام ورائحته.
Dialogue: 0,1:08:18.45,1:08:21.85,Default,,0,0,0,,وهو مفيد أيضاً للصحة ويساعد\Nفي مكافحة الشيخوخة.
Dialogue: 0,1:08:21.85,1:08:23.29,Default,,0,0,0,,طعام صحي جداً.
Dialogue: 0,1:08:23.29,1:08:27.99,Default,,0,0,0,,وهذا ما يسمى كونفيت -\N وهي تقنية طبخ فرنسية.
Dialogue: 0,1:08:27.99,1:08:30.96,Default,,0,0,0,,ليس لذيذًا فحسب، بل صحيًا أيضًا؟
Dialogue: 0,1:08:32.56,1:08:35.73,Default,,0,0,0,,أين تعلمت هذه الطريقة؟
Dialogue: 0,1:08:36.70,1:08:38.67,Default,,0,0,0,,ربما هذه نظرة ثاقبة؟
Dialogue: 0,1:08:38.67,1:08:41.94,Default,,0,0,0,,على أية حال، كنت أفكر في كيفية إرضاء جلالتك،
Dialogue: 0,1:08:41.94,1:08:44.74,Default,,0,0,0,,لقد مرت عدة أيام بالفعل.
Dialogue: 0,1:08:47.38,1:08:50.38,Default,,0,0,0,,يا لها من ضربة قاتلة.
Dialogue: 0,1:08:50.38,1:08:52.55,Default,,0,0,0,,سوف أساعدك كل يوم.
Dialogue: 0,1:08:52.95,1:08:54.52,Default,,0,0,0,,حتى نهاية الأيام
Dialogue: 0,1:08:54.75,1:08:56.15,Default,,0,0,0,,سوف تكون شاباً
Dialogue: 0,1:08:56.69,1:08:58.59,افتراضي,,0,0,0,,وصحية.
Dialogue: 0,1:09:07.03,1:09:11.30,Default,,0,0,0,,أسمح بملء البحيرة بالماء.
Dialogue: 0,1:09:31.59,1:09:33.26,Default,pineapple,0,0,0,,سوف تملأها بهذه الطريقة حتى انهيار جوسون.
Dialogue: 0,1:09:33.26,1:09:36.09,Default,الأناناس,0,0,0,,نحتاج إلى عشرة أيام، لا أقل.
Dialogue: 0,1:09:36.53,1:09:38.73,Default,الأناناس,0,0,0,,ماذا؟ بحيث يكون هناك ماء في دقيقة واحدة
Dialogue: 0,1:09:38.73,1:09:41.00,Default,الأناناس,0,0,0,,وإلا سأفجر رؤوسكم!
Dialogue: 0,1:09:41.03,1:09:44.10,Default,الأناناس,0,0,0,,أسرع، أسرع!
Dialogue: 0,1:09:48.24,1:09:52.44,Default,الأناناس,0,0,0,,الآن نحن بحاجة إلى يومين إضافيين.
Dialogue: 0,1:09:53.18,1:09:54.81,Default,الأناناس,0,0,0,,توقف، لا تتحرك!
Dialogue: 0,1:09:57.75,1:10:00.35,Default,الأناناس,0,0,0,,لقد توصلت إلى شيء ما.
Dialogue: 0,1:10:00.45,1:10:03.59,Default,أناناس,0,0,0,,المياه الواهبة للحياة تتدفق!
Dialogue: 0,1:10:04.29,1:10:06.19,Default,الأناناس,0,0,0,,-انتظر.\N-شكرًا لك.
Dialogue: 0,1:10:06.19,1:10:08.69,Default,الأناناس,0,0,0,,المياه الواهبة للحياة تتدفق!
Dialogue: 0,1:10:09.39,1:10:12.43,Default,pineapple,0,0,0,,من كان يعلم أن الأمور ستسير بشكل أسرع بهذه الطريقة؟
Dialogue: 0,1:10:12.43,1:10:14.80,Default,الأناناس,0,0,0,,أحسنت! تماما مثل ذلك!
Dialogue: 0,1:10:15.33,1:10:17.87,Default,الأناناس,0,0,0,,-التقطها بسرعة.\N-امسكها.
Dialogue: 0,1:10:27.21,1:10:30.08,Default,pineapple,0,0,0,,نعم، لست ملكة، بل عبقرية في الفكر المحلي.
Dialogue: 0,1:10:30.08,1:10:31.75,Default,الأناناس,0,0,0,,أحسنت. زملاء عظماء.
Dialogue: 0,1:10:31.75,1:10:35.05,Default,pineapple,0,0,0,,حتى تملأ البحيرة، انسَ النوم.
Dialogue: 0,1:10:35.05,1:10:36.52,Default,الأناناس,0,0,0,,-أوي!\N-أوي!
Dialogue: 0,1:10:55.17,1:10:56.91,Default,pineapple,0,0,0,,هونيون، إذًا؟
Dialogue: 0,1:10:57.51,1:11:00.58,Default,الأناناس,0,0,0,,إذا كانت تتظاهر بذلك،
Dialogue: 0,1:11:00.68,1:11:05.68,Default,pineapple,0,0,0,,فبالتأكيد لن يتمكن من خداعي.
Dialogue: 0,1:11:19.73,1:11:22.10,Default,الأناناس,0,0,0,,القماش نادر حقاً،
Dialogue: 0,1:11:22.10,1:11:26.00,Default,أناناس,0,0,0,,لا أستطيع أن أخبرك أين تم نسجها.
Dialogue: 0,1:11:31.41,1:11:33.51,Default,الأناناس,0,0,0,,لكنني أستطيع
Dialogue: 0,1:11:34.18,1:11:36.88,Default,الأناناس,0,0,0,,حاول معرفة ذلك.
Dialogue: 0,1:11:37.58,1:11:41.75,Default,pineapple,0,0,0,,لا يمكنك الاستسلام دون المحاولة، ألا توافقني على ذلك؟
Dialogue: 0,1:11:41.75,1:11:43.89,Default,الأناناس,0,0,0,,يعجبني أسلوبك.
Dialogue: 0,1:11:47.66,1:11:51.56,Default,pineapple,0,0,0,,كنت قلقة من أن الملك لا يهتم بالملكة،
Dialogue: 0,1:11:51.56,1:11:54.40,Default,pineapple,0,0,0,,ولكن يبدو أن كل همومي قد انتهت.
Dialogue: 0,1:11:56.30,1:11:58.10,Default,الأناناس,0,0,0,,ماذا يمكنك أن تخبرني أيضًا؟
Dialogue: 0,1:11:58.70,1:12:01.87,Default,الأناناس,0,0,0,,الليلة الماضية بينما كانت الملكة
Dialogue: 0,1:12:01.87,1:12:04.24,Default,الأناناس,0,0,0,,كان في مطبخ القصر،
Dialogue: 0,1:12:04.24,1:12:06.61,Default,الأناناس,0,0,0,,كان الملك ينتظرها بمفردها
Dialogue: 0,1:12:06.61,1:12:09.88,Default,الأناناس,0,0,0,,في قاعة دايجوجون.
Dialogue: 0,1:12:10.05,1:12:14.32,Default,pineapple,0,0,0,,نصحت الملك بالذهاب إلى قاعة "هويجوجونغ"،\Nلكنه قال إنه لن يذهب إلى أي مكان.
Dialogue: 0,1:12:15.45,1:12:20.46,Default,pineapple,0,0,0,,لا أستطيع أن أصدق ذلك، ملكنا قلق للغاية على زوجته!
Dialogue: 0,1:12:20.56,1:12:23.66,Default,الأناناس,0,0,0,,فهمت، يمكنك الذهاب.
Dialogue: 0,1:12:24.76,1:12:26.23,Default,الأناناس,0,0,0,,حسنًا.
Dialogue: 0,1:12:30.50,1:12:32.10,Default,pineapple,0,0,0,,دعهم يقضون الليالي معًا في كثير من الأحيان،
Dialogue: 0,1:12:32.10,1:12:34.17,Default,الأناناس,0,0,0,,فتشتعل المشاعر بينهما بشكل أسرع.
Dialogue: 0,1:12:34.87,1:12:37.91,Default,pineapple,0,0,0,,أعطتني الملكة كلمتها الملكية.
Dialogue: 0,1:12:38.21,1:12:39.51,Default,الأناناس,0,0,0,,هل أعطيت الكلمة؟
Dialogue: 0,1:12:39.51,1:12:42.38,Default,pineapple,0,0,0,,وعدت بأن تحمل بأمير.
Dialogue: 0,1:12:42.38,1:12:43.78,Default,الأناناس,0,0,0,,ما الذي تتحدث عنه!
Dialogue: 0,1:12:43.78,1:12:45.58,Default,الأناناس,0,0,0,,ثم في عائلتنا
Dialogue: 0,1:12:45.58,1:12:48.22,Default,الأناناس,0,0,0,,هل سيولد وريث الدم للعرش؟
Dialogue: 0,1:12:50.92,1:12:52.62,Default,الأناناس,0,0,0,,ما هذا؟
Dialogue: 0,1:12:53.26,1:12:54.69,Default,الأناناس,0,0,0,,بالضبط,
Dialogue: 0,1:12:55.76,1:12:57.26,Default,الأناناس,0,0,0,,انظر.
Dialogue: 0,1:12:57.33,1:13:01.03,Default,الأناناس,0,0,0,,كلها وستصبح بشرتك كبشرة الأطفال.
Dialogue: 0,1:13:01.33,1:13:03.57,Default,الأناناس,0,0,0,,يا لها من هدية باهظة الثمن.
Dialogue: 0,1:13:04.60,1:13:06.07,Default,pineapple,0,0,0,,إذا أعجبك عملها،
Dialogue: 0,1:13:06.07,1:13:09.57,Default,pineapple,0,0,0,,لن أندم على أي شيء، ولكنني سأجدك أكثر.
Dialogue: 0,1:13:10.31,1:13:11.84,Default,الأناناس,0,0,0,,شكرًا لك.
Dialogue: 0,1:13:14.11,1:13:17.68,Default,pineapple,0,0,0,,ما زلت لا أصدق\Nأن كل شيء سار على ما يرام.
Dialogue: 0,1:13:17.68,1:13:21.02,Default,الأناناس,0,0,0,,عندما سقطت الملكة في البحيرة،
Dialogue: 0,1:13:21.02,1:13:23.49,Default,الأناناس,0,0,0,,كدت أشعر بالجنون من الإثارة!
Dialogue: 0,1:13:24.09,1:13:25.62,Default,الأناناس,0,0,0,,طفل مسكين وبريء.
Dialogue: 0,1:13:25.62,1:13:29.09,Default,pineapple,0,0,0,,أنا فخور جدًا بأنها تمكنت\N من الحفاظ على مكانتها الرفيعة.
Dialogue: 0,1:13:29.83,1:13:32.46,Default,الأناناس,0,0,0,,تمتلئ الدموع بالسعادة.
Dialogue: 0,1:13:33.10,1:13:35.00,Default,الأناناس,0,0,0,,قل الأمر كما هو.
Dialogue: 0,1:13:35.00,1:13:37.30,Default,pineapple,0,0,0,,سأكون صادقًا، الملكة ليست طفلة بريئة على الإطلاق.
Dialogue: 0,1:13:37.30,1:13:40.47,Default,pineapple,0,0,0,,ملكتنا...\Nكيف يمكنني أن أقولها بشكل صحيح أكثر؟
Dialogue: 0,1:13:42.34,1:13:43.84,Default,الأناناس,0,0,0,,ذكية؟
Dialogue: 0,1:13:44.81,1:13:46.41,Default,الأناناس,0,0,0,,كلمة خاطئة قليلاً.
Dialogue: 0,1:13:47.11,1:13:50.08,Default,الأناناس,0,0,0,,-مدقق؟\N-ليس هذا.
Dialogue: 0,1:13:50.15,1:13:52.98,Default,pineapple,0,0,0,,هناك كلمة مثالية.
Dialogue: 0,1:13:53.45,1:13:55.95,Default,الأناناس,0,0,0,,-إذن...\N-متطور؟
Dialogue: 0,1:13:56.12,1:13:57.62,Default,الأناناس,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,1:14:00.76,1:14:02.29,Default,الأناناس,0,0,0,,فريدة من نوعها؟
Dialogue: 0,1:14:02.46,1:14:05.63,Default,الأناناس,0,0,0,,بالضبط! فتاة فريدة من نوعها.
Dialogue: 0,1:14:05.63,1:14:08.03,Default,pineapple,0,0,0,,لا يمكننا العثور على ملكة أفضل!
Dialogue: 0,1:14:08.03,1:14:09.70,Default,الأناناس,0,0,0,,تماماً تماماً!
Dialogue: 0,1:14:09.77,1:14:14.04,Default,Pineapple,0,0,0,,إنني أنظر إليها وأراك في شبابك!
Dialogue: 0,1:14:14.24,1:14:15.87,Default,الأناناس,0,0,0,,ما هذا الهراء!
Dialogue: 0,1:14:23.45,1:14:24.78,Default,الأناناس,0,0,0,,هل جننت؟
Dialogue: 0,1:14:24.78,1:14:27.72,Default,pineapple,0,0,0,,هل رأيت هذا بأم عينيك؟\Nمع هؤلاء؟
Dialogue: 0,1:14:27.72,1:14:30.32,Default,pineapple,0,0,0,,على الأقل شخص ما في القصر رآه شخصياً،
Dialogue: 0,1:14:30.32,1:14:32.22,Default,الأناناس,0,0,0,,هل تدفع المحظية الملكة؟
Dialogue: 0,1:14:33.09,1:14:35.49,Default,pineapple,0,0,0,,هل كان الأمر يستحق ذلك؟\Nالجميع يعرف بالفعل أنها هي!
Dialogue: 0,1:14:35.49,1:14:37.16,Default,أناناس,0,0,0,,-بالضبط!\N-إنها على حق.
Dialogue: 0,1:14:37.16,1:14:38.26,Default,pineapple,0,0,0,,نعم، الجميع يعرف ذلك.
Dialogue: 0,1:14:38.26,1:14:42.13,Default,pineapple,0,0,0,,كما يقولون، قبعة اللص تحترق.
Dialogue: 0,1:14:42.63,1:14:44.40,Default,الأناناس,0,0,0,,هذه الشائعات لم تأتي من فراغ.
Dialogue: 0,1:14:49.94,1:14:51.41,Default,الأناناس,0,0,0,,كيف تجرؤ!
Dialogue: 0,1:14:51.41,1:14:54.48,Default,الأناناس,0,0,0,,استعد! صباح الغد ستكون هناك شائعة بأنك أحمق أصلع!
Dialogue: 0,1:14:54.48,1:14:55.78,Default,الأناناس,0,0,0,,أيها الوغد!
Dialogue: 0,1:14:55.78,1:14:57.65,Default,الأناناس,0,0,0,,دعني أذهب! الآن!
Dialogue: 0,1:14:57.65,1:14:59.28,Default,الأناناس,0,0,0,,دعني أذهب!
Dialogue: 0,1:14:59.75,1:15:01.95,Default,pineapple,0,0,0,,الملكة هي التي نصبتها!
Dialogue: 0,1:15:01.95,1:15:03.62,Default,الأناناس,0,0,0,,عندما مرت سيدتي،
Dialogue: 0,1:15:03.62,1:15:05.89,Default,الأناناس,0,0,0,,قفزت الملكة في الماء عمداً!
Dialogue: 0,1:15:05.89,1:15:08.06,Default,pineapple,0,0,0,,قبل أن تدردش، اكتشف الحقيقة!
Dialogue: 0,1:15:24.51,1:15:26.61,Default,الأناناس,0,0,0,,اليوم بالتأكيد...
Dialogue: 0,1:15:52.17,1:15:55.97,Default,pineapple,0,0,0,,يا صاحب الجلالة، اعتقدت\Nأنك ستتدرب على كتابتك.
Dialogue: 0,1:15:56.14,1:15:57.91,Default,الأناناس,0,0,0,,عندما ذهبت إلى ييجان،
Dialogue: 0,1:15:57.91,1:16:00.51,Default,الأناناس,0,0,0,,للعب التودجون مع السيد هونغ،
Dialogue: 0,1:16:00.51,1:16:02.98,Default,الأناناس,0,0,0,,رأيت شيئاً أذهلني.
Dialogue: 0,1:16:05.78,1:16:10.12,Default,pineapple,0,0,0,,شخص ما من مسافة بعيدة\Nألقى خنجراً نحو الهدف.
Dialogue: 0,1:16:12.69,1:16:15.29,Default,pineapple,0,0,0,,فكرت لماذا لا أجربه.
Dialogue: 0,1:16:16.56,1:16:18.26,Default,الأناناس,0,0,0,,هذا خطير جداً،
Dialogue: 0,1:16:18.26,1:16:20.43,Default,الأناناس,0,0,0,,ماذا لو تأذيت؟
Dialogue: 0,1:16:28.47,1:16:31.24,Default,pineapple,0,0,0,,منذ متى نعرف بعضنا البعض؟
Dialogue: 0,1:16:33.51,1:16:36.41,Default,الأناناس,0,0,0,,سنتان يا سيدي.
Dialogue: 0,1:16:39.95,1:16:41.35,Default,الأناناس,0,0,0,,هكذا هو الحال.
Dialogue: 0,1:16:45.09,1:16:48.86,Default,pineapple,0,0,0,,خلال هذا الوقت تعلمت كل شيء في العالم عني،
Dialogue: 0,1:16:48.86,1:16:50.63,Default,الأناناس,0,0,0,,أصبحت ذراعي ورجلي.
Dialogue: 0,1:16:50.63,1:16:53.63,Default,pineapple,0,0,0,,كما لو أننا نعرف بعضنا البعض منذ سنوات عديدة.
Dialogue: 0,1:16:54.63,1:16:57.90,Default,الأناناس,0,0,0,,أنا فقط أقوم بعملي.
Dialogue: 0,1:16:58.07,1:16:59.57,Default,الأناناس,0,0,0,,وظيفتك؟
Dialogue: 0,1:17:01.97,1:17:03.71,Default,الأناناس,0,0,0,,ربما هذه هي وظيفتك،
Dialogue: 0,1:17:03.71,1:17:05.24,Default,الأناناس,0,0,0,,لكنني لا أستطيع التوقف عن التفكير
Dialogue: 0,1:17:05.24,1:17:08.11,Default,pineapple,0,0,0,,هل أنت مخلص لي، لأنه عليك أن تفعل ذلك؟
Dialogue: 0,1:17:08.61,1:17:10.08,Default,الأناناس,0,0,0,,أو
Dialogue: 0,1:17:11.08,1:17:14.15,Default,الأناناس,0,0,0,,لأنك بنفسك تريد ذلك.
Dialogue: 0,1:17:15.75,1:17:17.99,Default,الأناناس,0,0,0,,أنا متأكد من أن مشاعرك صادقة.
Dialogue: 0,1:17:19.99,1:17:22.96,Default,pineapple,0,0,0,,شكرًا على ملاحظتك يا سيدي!
Dialogue: 0,1:17:22.96,1:17:24.86,Default,الأناناس,0,0,0,,هل تصدقني؟
Dialogue: 0,1:17:25.36,1:17:28.63,Default,pineapple,0,0,0,,إذا لم يكن من أجلك، فمن أجل من؟
Dialogue: 0,1:17:36.04,1:17:37.71,Default,pineapple,0,0,0,,اعتقدت أنه سيكون أسهل.
Dialogue: 0,1:17:38.11,1:17:42.01,Default,الأناناس,0,0,0,,لكن هل شككت بي؟
Dialogue: 0,1:17:44.68,1:17:47.22,Default,الأناناس,0,0,0,,أرجوك سامحني.
Dialogue: 0,1:17:47.22,1:17:49.92,Default,الأناناس,0,0,0,,مع التقدم في السن أصبحت أكثر جبناً.
Dialogue: 0,1:17:51.62,1:17:54.39,Default,pineapple,0,0,0,,سوف يذهب الليلة\NI إلى قاعة دايجوجون مبكراً.
Dialogue: 0,1:17:54.49,1:17:56.36,Default,الأناناس,0,0,0,,سأجهز كل شيء.
Dialogue: 0,1:18:32.96,1:18:35.83,Default,pineapple,0,0,0,,لمقابلتك، كان علينا أن نأتي مبكراً.
Dialogue: 0,1:18:37.20,1:18:39.27,Default,pineapple,0,0,0,,ولكن ما مدى اجتهادك.
Dialogue: 0,1:18:39.27,1:18:41.17,Default,pineapple,0,0,0,,نبذل الكثير من الجهد حتى نتمكن من النوم.
Dialogue: 0,1:18:41.17,1:18:43.81,Default,الأناناس,0,0,0,,قمنا بإعداد المشروبات والوجبات الخفيفة.
Dialogue: 0,1:18:44.94,1:18:46.11,Default,pineapple,0,0,0,,لماذا هذا ضروري أصلاً؟
Dialogue: 0,1:18:46.11,1:18:48.11,Default,الأناناس,0,0,0,,أعلم أنك تحب الشرب،
Dialogue: 0,1:18:48.11,1:18:50.28,Default,pineapple,0,0,0,,لذلك أمرتهم بالاستعداد لك.
Dialogue: 0,1:18:50.35,1:18:51.98,Default,الأناناس,0,0,0,,لقد انتهيت من هذا.
Dialogue: 0,1:18:53.95,1:18:56.05,Default,الأناناس,0,0,0,,فكرت في هذا أيضًا.
Dialogue: 0,1:18:57.42,1:18:59.69,Default,الأناناس,0,0,0,,أحضرنا حلوى الشاي.
Dialogue: 0,1:19:12.37,1:19:14.27,Default,الأناناس,0,0,0,,هذا شاي الياسمين العربي.
Dialogue: 0,1:19:15.27,1:19:17.74,Default,pineapple,0,0,0,,إذا كنت تعاني من الأرق أو القلق،
Dialogue: 0,1:19:17.74,1:19:19.61,Default,الأناناس,0,0,0,,سوف يهدئك.
Dialogue: 0,1:19:26.75,1:19:28.65,Default,الأناناس,0,0,0,,ياسمين نورس؟
Dialogue: 0,1:19:28.82,1:19:31.09,Default,الأناناس,0,0,0,,يا لها من رائحة قوية.
Dialogue: 0,1:19:40.63,1:19:44.10,Default,الأناناس,0,0,0,,في تلك الليلة كانت الغرفة بأكملها تفوح منها رائحة الياسمين.
Dialogue: 0,1:19:48.97,1:19:52.91,Default,الأناناس,0,0,0,,حتى أن الرائحة تغلغلت في كمه.
Dialogue: 0,1:20:25.24,1:20:26.74,Default,الأناناس,0,0,0,,لقد كنت أنت.
Dialogue: 0,1:20:29.68,1:20:31.28,Default,الأناناس,0,0,0,,إنه أنت...
Dialogue: 0,1:20:31.85,1:20:34.45,Default,pineapple,0,0,0,,يجب ألا تكشف كل أوراقك بتهور.
Dialogue: 0,1:20:37.79,1:20:43.29,Default,pineapple,0,0,0,,خاصة في القصر، حيث لكل شخص أسراره الخاصة.
Dialogue: 0,1:20:55.24,1:20:56.64,Default,الأناناس,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:20:56.64,1:20:57.64,Default,الأناناس,0,0,0,,
Dialogue: 0,1:20:57.64,1:20:59.21,Default,الأناناس,0,0,0,,
Dialogue: 0,1:21:16.49,1:21:18.96,Default,pineapple,0,0,0,,هل وقعت حقاً في فخ عيونها وكلماتها المخادعة؟
Dialogue: 0,1:21:18.96,1:21:20.73,Default,الأناناس,0,0,0,,اجعلها تخبرك بكل شيء.
Dialogue: 0,1:21:20.73,1:21:22.90,Default,pineapple,0,0,0,,-من أرسل الرسالة؟\N-الملكة الأرملة.
Dialogue: 0,1:21:22.90,1:21:24.47,Default,الأناناس,0,0,0,,فقط حتى تمتلئ البحيرة بالماء.
Dialogue: 0,1:21:24.47,1:21:26.87,Default,pineapple,0,0,0,,سأتحمل كل هذا، ثم سأعود إلى المنزل.
Dialogue: 0,1:21:26.87,1:21:28.64,Default,pineapple,0,0,0,,الشخص الذي نبحث عنه هو سيدة البلاط.
Dialogue: 0,1:21:28.64,1:21:31.54,Default,pineapple,0,0,0,,افعل كل شيء حتى لا يتم القبض عليك.
Dialogue: 0,1:21:31.54,1:21:34.01,Default,الأناناس,0,0,0,,لقد اكتشفت من أين جاء هذا القماش.
Dialogue: 0,1:21:34.01,1:21:35.28,Default,أناناس,0,0,0,,من القصر.
Dialogue: 0,1:21:35.28,1:21:37.25,Default,pineapple,0,0,0,,حاجتك هي الزوج الملكي، وليس أنا.
Dialogue: 0,1:21:37.25,1:21:39.85,Default,pineapple,0,0,0,,هل تريد إعادة كل شيء إلى سابق عهده؟\Nهذا هو الانتقام.
Dialogue: 0,1:21:39.85,1:21:42.62,Default,pineapple,0,0,0,,-هذا ما فعلته بك.\N-هل تعتقد أنني لا أستطيع ذلك؟
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


