Dialogue: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, А,инасг, А,инасг Бирюлька, Февраль,\NХозяин, Таракан
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:04.02,pangalan,,0,0,0,,{\pos(112,666)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:03.95,0:01:06.39,Default,,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.39,0:01:08.96,Default,,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:01:21.80,0:01:23.60,Default,,0,0,0,,Gaano niya narinig?
Dialogue: 0,0:01:25.41,0:01:27.17,Default,,0,0,0,,Unang sinabi niya
Dialogue: 0,0:01:27.17,0:01:29.38,Default,,0,0,0,,sa ilalim ng banta ng kamatayan, ang magpapasya sa kanyang kapalaran.
Dialogue: 0,0:01:30.68,0:01:32.01,Default,,0,0,0,,Sasabihin niya na wala siyang narinig
Dialogue: 0,0:01:32.01,0:01:34.55,Default,,0,0,0,,o humihingi ng buhay niya, papatayin ko siya.
Dialogue: 0,0:01:34.55,0:01:36.72,Default,,0,0,0,,Ibig sabihin narinig niya ang lahat.
Dialogue: 0,0:01:37.48,0:01:38.89,Default,,0,0,0,,Ikaw!
Dialogue: 0,0:01:39.59,0:01:42.12,Default,,0,0,0,,Kung papatayin mo ako, magkakaroon ka ng mga problema sa iyong sarili sa buong buhay mo.
Dialogue: 0,0:01:47.49,0:01:49.50,Default,,0,0,0,,Maliit na bagay pa rin ito.
Dialogue: 0,0:01:54.37,0:01:56.54,Default,,0,0,0,,Ilayo ang bagay na iyon.
Dialogue: 0,0:01:57.97,0:01:59.37,Default,,0,0,0,,Maghintay sandali.
Dialogue: 0,0:01:59.37,0:02:02.54,Default,,0,0,0,,3 episode
Dialogue: 0,0:02:09.95,0:02:12.79,Default,,0,0,0,,Para sa iyong kaalaman, ngayon ay naka-jackpot ka.
Dialogue: 0,0:02:17.69,0:02:20.29,Default,,0,0,0,,Tingnan mo, hindi ba maganda? Ang lahat ay sa iyo.
Dialogue: 0,0:02:20.76,0:02:22.60,Default,,0,0,0,,Napatigil ba siya sa oras?
Dialogue: 0,0:02:22.66,0:02:25.43,Default,,0,0,0,,Ano ito? Hindi ka ba magnanakaw?
Dialogue: 0,0:02:26.00,0:02:27.47,Default,,0,0,0,,Damn.
Dialogue: 0,0:02:27.87,0:02:30.87,Default,,0,0,0,,Kilala mo pa ba kung sino ako?
Dialogue: 0,0:02:31.27,0:02:34.34,Default,,0,0,0,,-I...\N-Ngayon sasabihin niya na siya ang reyna.
Dialogue: 0,0:02:35.31,0:02:37.88,Default,,0,0,0,,nagsilbi sa mga espesyal na pwersa.
Dialogue: 0,0:02:41.62,0:02:43.02,Default,,0,0,0,,Atake.
Dialogue: 0,0:02:44.25,0:02:46.72,Default,,0,0,0,,Sa tingin mo ba lahat ng kusinero sa hukbo ay bobo?
Dialogue: 0,0:02:46.99,0:02:48.59,Default,,0,0,0,,Army Chef
Dialogue: 0,0:02:48.59,0:02:51.26,Default,,0,0,0,,papatay ng multo gamit ang kutsilyo sa kusina.
Dialogue: 0,0:02:51.39,0:02:53.89,Default,,0,0,0,,Ipasa! Hindi ako natatakot sayo.
Dialogue: 0,0:02:54.03,0:02:56.60,Default,,0,0,0,,Halika sa pag-atake.
Dialogue: 0,0:02:56.60,0:03:00.33, Default,,0,0,0,,Paano niya nasasabi ang mga kakaibang bagay nang buong kumpiyansa?
Dialogue: 0,0:03:54.56,0:03:56.02,Default,,0,0,0,,At cool ka.
Dialogue: 0,0:04:17.91,0:04:19.78,Default,,0,0,0,,Ang mukha ang kahinaan niya.
Dialogue: 0,0:04:31.63,0:04:33.16,Default,,0,0,0,,Cool.
Dialogue: 0,0:04:38.47,0:04:40.00,Default,,0,0,0,,Diyos.
Dialogue: 0,0:05:55.31,0:05:57.31,Default,,0,0,0,,Itinago ng Kanyang Kamahalan ang kanyang mukha,
Dialogue: 0,0:05:57.31,0:05:59.38,Default,,0,0,0,,na ang ibig sabihin ay ayaw niyang ihayag ang kanyang sarili.
Dialogue: 0,0:06:38.05,0:06:39.62,Default,,0,0,0,,Sino ka?
Dialogue: 0,0:06:42.29,0:06:44.59,Default,,0,0,0,,Ako si Kim Byungin mula sa pamilya Kim Jwageun.
Dialogue: 0,0:06:46.13,0:06:47.86,Default,,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:06:50.30,0:06:51.63,Default,,0,0,0,,Nanakawan ka na ba?
Dialogue: 0,0:06:51.63,0:06:53.50,Default,,0,0,0,,Hindi na siya makalayo.
Dialogue: 0,0:06:54.50,0:06:56.47,Default,,0,0,0,,Hanapin ang lahat sa paligid.
Dialogue: 0,0:06:56.70,0:06:58.11,Default,,0,0,0,,Hindi nag-iisa ang magnanakaw.
Dialogue: 0,0:06:58.11,0:07:01.04,Default,,0,0,0,,Oo, maghiwalay at hanapin ang lahat.
Dialogue: 0,0:07:13.22,0:07:15.12,Default,,0,0,0,,Ate, okay ka lang?
Dialogue: 0,0:07:18.49,0:07:19.96,Default,,0,0,0,,Ate?
Dialogue: 0,0:07:22.50,0:07:26.37,Default,,0,0,0,,Bakit matamang nakatitig siya sa kapatid niya?
Dialogue: 0,0:07:28.14,0:07:29.57,Default,,0,0,0,,Soyeon!
Dialogue: 0,0:07:31.51,0:07:33.84,Default,,0,0,0,,Dapat ay nakaranas ng matinding pagkabigla.
Dialogue: 0,0:07:35.88,0:07:38.08,Default,,0,0,0,,Anong hamak ang nangahas na gawin ito sa kanya?
Dialogue: 0,0:07:47.19,0:07:49.22,Default,,0,0,0,,Golden... Diyos ko!
Dialogue: 0,0:07:50.76,0:07:53.03,Default,,0,0,0,,-Well, what the.\N-Bakit ka nakipag break?
Dialogue: 0,0:07:54.29,0:07:55.73,Default,,0,0,0,,Naghahanap kami ng magnanakaw.
Dialogue: 0,0:07:55.73,0:07:56.96,Default,,0,0,0,,Diyos.
Dialogue: 0,0:07:56.96,0:07:58.70,Default,,0,0,0,,Saan mo iniabot ang iyong mga kamay?
Dialogue: 0,0:07:58.70,0:08:02.27,Default,,0,0,0,,Tinakot nila ako, kaya sinabi ko ang aking paglipat nang malakas.
Dialogue: 0,0:08:02.27,0:08:03.37,Default,,0,0,0,,Tapos na ang larong ito.
Dialogue: 0,0:08:03.37,0:08:04.50,Default,,0,0,0,,Sino ang nagsabi niyan?
Dialogue: 0,0:08:04.50,0:08:06.31,Default,,0,0,0,,Ipagpapatuloy mo ba, alam mo kung ano ang nasa kamay ko?
Dialogue: 0,0:08:06.31,0:08:08.98,Default,,0,0,0,,Ang problema mo, bakit ako matatalo?
Dialogue: 0,0:08:08.98,0:08:10.71,Default,,0,0,0,,Nakakaloka.
Dialogue: 0,0:08:12.25,0:08:13.55,Default,,0,0,0,,Paumanhin, masyado akong lumayo.
Dialogue: 0,0:08:13.55,0:08:15.98,Default,,0,0,0,,Dinuraan mo lang ba ako sa mukha?
Dialogue: 0,0:08:15.98,0:08:17.52,Default,,0,0,0,,Wala akong alam!
Dialogue: 0,0:08:20.05,0:08:21.96,Default,,0,0,0,,Sa iyo!
Dialogue: 0,0:08:24.49,0:08:27.13,Default,,0,0,0,,-Arrest him.\N-Arrest?
Dialogue: 0,0:08:28.20,0:08:30.20,Default,,0,0,0,,Ano ang nakatayo na parang mga haligi?
Dialogue: 0,0:08:30.20,0:08:32.00,Default,,0,0,0,,Huwag hayaang makatakas si Konsehal Hong,
Dialogue: 0,0:08:32.00,0:08:33.83,Default,,0,0,0,,isara ang pinto at lumabas ngayon!
Dialogue: 0,0:08:33.83,0:08:36.90,Default,,0,0,0,,Hindi siya marunong lumaban, pero ginagawa niyang gulo ang sarili niya.
Dialogue: 0,0:08:36.90,0:08:39.91,Default,,0,0,0,,Ngayon puputulin ko ang init ng ulo niya!
Dialogue: 0,0:08:40.87,0:08:42.84,Default,,0,0,0,,-Protektahan mo ako.\N-Sa susunod.
Dialogue: 0,0:08:42.84,0:08:45.41,Default,,0,0,0,,-Next?\N-Bakit nandito ka pa?
Dialogue: 0,0:08:45.55,0:08:48.05,Default,,0,0,0,,Kung aalis ka lang...
Dialogue: 0,0:08:48.05,0:08:49.52,Default,,0,0,0,,Advisor Hon.
Dialogue: 0,0:08:49.52,0:08:52.69,Default,,0,0,0,,Ngayon puputulin ko ang init ng ulo mo!
Dialogue: 0,0:08:54.86,0:08:56.46,Default,,0,0,0,,Nakakumbinsi itong lumabas.
Dialogue: 0,0:08:59.59,0:09:02.40,Default,,0,0,0,,Hindi na ba kita pwedeng pagtawanan?
Dialogue: 0,0:09:02.40,0:09:04.76,Default,,0,0,0,,Talaga, itataas mo ba ang iyong espada laban sa akin?
Dialogue: 0,0:09:07.20,0:09:09.90,Default,,0,0,0,,Ngunit wala doon! Hindi pa ako nakakapag-asawa!
Dialogue: 0,0:09:10.20,0:09:11.64,Default,,0,0,0,,Tara na.
Dialogue: 0,0:09:12.81,0:09:15.48,Default,,0,0,0,,Napalampas. Kahit ang espada ay wala sa tabi mo.
Dialogue: 0,0:09:35.16,0:09:36.96,Default,,0,0,0,,Nasaktan ka ba?
Dialogue: 0,0:09:36.96,0:09:38.63,Default,,0,0,0,,Okay lang ako.
Dialogue: 0,0:09:39.47,0:09:41.67,Default,,0,0,0,,Hindi ko akalain na makakasama niya si Kim Byungin.
Dialogue: 0,0:09:42.60,0:09:44.64,Default,,0,0,0,,Sa tingin mo ba ito ay isang bitag?
Dialogue: 0,0:09:45.37,0:09:48.01,Default,,0,0,0,,Hindi nila gagamitin ang reyna bilang pain.
Dialogue: 0,0:09:48.01,0:09:50.08,Default,,0,0,0,,At saka, ang reaksyon ng reyna
Dialogue: 0,0:09:50.08,0:09:53.05,Default,,0,0,0,,ay hindi pangkaraniwan.\NIIto ay nagmumulto sa akin.
Dialogue: 0,0:09:53.28,0:09:55.18,Default,,0,0,0,,Kung magsisimula tayong kumilos nang hindi ito naiintindihan,
Dialogue: 0,0:09:55.18,0:09:57.38,Default,,0,0,0,,palala lang natin.
Dialogue: 0,0:09:57.72,0:09:59.89,Default,,0,0,0,,Intindihin muna natin kung ano ang nangyayari.
Dialogue: 0,0:09:59.89,0:10:01.45,Default,,0,0,0,,Pero ano,
Dialogue: 0,0:10:01.82,0:10:04.22,Default,,0,0,0,,kung narinig ng reyna ang lahat?
Dialogue: 0,0:10:05.63,0:10:08.16,Default,,0,0,0,,Nakausap ko ang reyna.
Dialogue: 0,0:10:08.86,0:10:11.00,Default,,0,0,0,,Magtiwala sa aking paghatol.
Dialogue: 0,0:10:13.97,0:10:16.34,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:10:17.07,0:10:20.04,Default,,0,0,0,,Kung mali ako,
Dialogue: 0,0:10:23.11,0:10:26.48,Default,,0,0,0,,magsisimula ang isang bloodbath.
Dialogue: 0,0:10:33.89,0:10:37.19,Default,,0,0,0,,3 episode: Sa kama kasama ang kaaway
Dialogue: 0,0:10:48.47,0:10:49.77,Default,,0,0,0,,Marangal na panauhin.
Dialogue: 0,0:10:49.77,0:10:52.07,Default,,0,0,0,,Nakita ko siya sa kabaong,\Nunless it's the king...
Dialogue: 0,0:10:52.97,0:10:55.17,Default,,0,0,0,,Alisin mo ang iyong sandata, itabi mo.
Dialogue: 0,0:10:59.55,0:11:01.05,Default,,0,0,0,,Laktawan.
Dialogue: 0,0:11:07.65,0:11:10.32,Default,,0,0,0,,Gusto kong manatiling lihim ang aming pagbisita.
Dialogue: 0,0:11:10.32,0:11:11.82,Default,,0,0,0,,Oo.
Dialogue: 0,0:11:20.33,0:11:21.83,Default,,0,0,0,,Diyos.
Dialogue: 0,0:11:26.57,0:11:28.94,Default,,0,0,0,,Namatay siya sa takot.
Dialogue: 0,0:11:28.98,0:11:33.41,Default,,0,0,0,,Ihanda ang kanyang higaan at alagaan siya ng palihim.
Dialogue: 0,0:11:33.41,0:11:34.85,Default,,0,0,0,,Oo.
Dialogue: 0,0:11:58.94,0:12:00.84,Default,,0,0,0,,Kamahalan, anong ginagawa mo dito?
Dialogue: 0,0:12:01.34,0:12:03.24,Default,,0,0,0,,Ikaw na naman.
Dialogue: 0,0:12:04.94,0:12:08.78,Default,,0,0,0,,Ikaw lang ang naghahanap sa akin kapag tumakas ako.
Dialogue: 0,0:12:09.65,0:12:14.09,Default,,0,0,0,,Bukas ang kasal mo.\NBakit ka nandito?
Dialogue: 0,0:12:14.89,0:12:17.92,Default,,0,0,0,,Akala ko ilang sandali lang ay mababaliw na ako.\NTKaya ako umalis ng palasyo.
Dialogue: 0,0:12:19.23,0:12:20.93,Default,,0,0,0,,Puntahan mo lang ako
Dialogue: 0,0:12:22.20,0:12:23.76,Default,,0,0,0,,wala kahit saan.
Dialogue: 0,0:12:50.92,0:12:55.96,Default,,0,0,0,,Ibabalik kita sa palasyo - walang makakapansin.
Dialogue: 0,0:12:58.67,0:13:01.30,Default,,0,0,0,,Bukas ang pangarap ng aking pagkabata
Dialogue: 0,0:13:02.67,0:13:05.07,Default,,0,0,0,,magkakatotoo.
Dialogue: 0,0:13:05.97,0:13:08.91,Default,,0,0,0,,Nangarap akong maging reyna.
Dialogue: 0,0:13:12.61,0:13:15.45,Default,,0,0,0,,Bukas matutupad na ang pangarap ko.
Dialogue: 0,0:13:18.59,0:13:20.72,Default,,0,0,0,,Bukas ang pangarap ko
Dialogue: 0,0:13:23.06,0:13:24.92,Default,,0,0,0,,mawawala.
Dialogue: 0,0:13:28.96,0:13:30.83,Default,,0,0,0,,May mali ba?
Dialogue: 0,0:13:32.70,0:13:34.73,Default,,0,0,0,,Natatakot ako.
Dialogue: 0,0:13:35.74,0:13:37.34,Default,,0,0,0,,Natatakot ako.
Dialogue: 0,0:13:38.57,0:13:41.07,Default,,0,0,0,,Nakakatakot mabuhay.
Dialogue: 0,0:13:41.14,0:13:44.18,Default,,0,0,0,,-Your Highness.\N-Huwag mo akong tawaging ganyan.
Dialogue: 0,0:13:45.15,0:13:47.88,Default,,0,0,0,,Kahit ngayon ay tawagin mo ako sa pangalan.
Dialogue: 0,0:13:48.58,0:13:50.78,Default,,0,0,0,,Para hindi ko makalimutan kung sino ako.
Dialogue: 0,0:13:52.69,0:13:54.35,Default,,0,0,0,,To
Dialogue: 0,0:13:56.59,0:13:58.29,Default,,0,0,0,,hindi nawala sa sarili ko.
Dialogue: 0,0:13:59.16,0:14:01.79,Default,,0,0,0,,Ano ang kinakatakutan mo?
Dialogue: 0,0:14:02.40,0:14:06.10,Default,,0,0,0,,Hindi ako ako.
Dialogue: 0,0:14:06.93,0:14:09.50,Default,,0,0,0,,Sa lahat ng oras na ito ay nabuhay akong iniisip na ako ito.
Dialogue: 0,0:14:10.67,0:14:12.41,Default,,0,0,0,,Ngunit hindi ganoon.
Dialogue: 0,0:14:12.47,0:14:15.74,Default,,0,0,0,,Walang totoo sa akin, lahat ay kasinungalingan.
Dialogue: 0,0:14:32.03,0:14:34.19,Default,,0,0,0,,Ikaw si Soyeon.
Dialogue: 0,0:14:39.37,0:14:41.73,Default,,0,0,0,,Isang babaeng kilala ko sa loob ng maraming taon,
Dialogue: 0,0:14:44.57,0:14:47.94,Default,,0,0,0,,lihim na minamahal at pinapahalagahan.
Dialogue: 0,0:14:57.12,0:14:59.35,Default,,0,0,0,,Hindi ko hahayaang mawala ka sa sarili mo.
Dialogue: 0,0:15:03.92,0:15:05.99,Default,,0,0,0,,At hinding hindi ko makakalimutan.
Dialogue: 0,0:15:57.68,0:15:59.18,Default,,0,0,0,,Well
Dialogue: 0,0:16:01.28,0:16:03.78,Default,,0,0,0,,nangyari noong gabing iyon?
Dialogue: 0,0:16:08.02,0:16:10.89,Default,,0,0,0,,May pumatay sa akin.
Dialogue: 0,0:16:12.79,0:16:15.76,Default,Lily,0,0,0,,Tinawagan ko ang healer. Maghintay, Kamahalan.
Dialogue: 0,0:16:18.06,0:16:19.77,Default,Lily,0,0,0,,Itong charlatan.
Dialogue: 0,0:16:20.27,0:16:21.63,Default,Lily,0,0,0,,Sakit na ulo ko.
Dialogue: 0,0:16:21.63,0:16:23.47,Default,Lily,0,0,0,,Huwag itong ipakita dito.
Dialogue: 0,0:16:23.47,0:16:26.51,Default,Lily,0,0,0,,Kung hindi, maiiwan kang walang reproductive organ.
Dialogue: 0,0:16:30.18,0:16:33.45,Default,Lily,0,0,0,,Pagkatapos siguro dapat kang kumain? Hawakan mo.
Dialogue: 0,0:16:39.65,0:16:42.32,Default,Lily,0,0,0,,Nasusuka ako. Mukhang masusuka na siya.
Dialogue: 0,0:16:43.12,0:16:45.09,Default,Lily,0,0,0,,At gaano karami ang nainom mo kahapon?
Dialogue: 0,0:16:45.09,0:16:47.76,Default,Lily,0,0,0,,Ang babaeng ito ay hindi matitiis sa alkohol.
Dialogue: 0,0:16:48.13,0:16:50.56,Default,Lily,0,0,0,,Matagal na akong hindi nagdi-disconnect ng ganito.
Dialogue: 0,0:16:53.20,0:16:55.13,Default,Lily,0,0,0,,Paano ako nakabalik kahapon?
Dialogue: 0,0:16:56.34,0:16:59.41,Default,Lily,0,0,0,,Dinala ka ng pinsan mo, Mr. Benin.
Dialogue: 0,0:16:59.41,0:17:02.14,Default,Lily,0,0,0,,Maaari kang magkaroon ng problema.
Dialogue: 0,0:17:02.98,0:17:04.81,Default,Lily,0,0,0,,Salamat sa kanya, ako lang
Dialogue: 0,0:17:04.81,0:17:06.88,Default,Lily,0,0,0,,Alam kong lumabas ka kahapon.
Dialogue: 0,0:17:07.01,0:17:08.51,Default,Lily,0,0,0,,Kapatid ko?
Dialogue: 0,0:17:08.58,0:17:10.55,Default,Lily,0,0,0,,Saan natin siya nakilala?
Dialogue: 0,0:17:10.88,0:17:12.75,Default,Lily,0,0,0,,Hindi ko alam nang eksakto.
Dialogue: 0,0:17:13.52,0:17:17.19,Default,Lily,0,0,0,,Nga pala, nawalan ka daw ng malay sa takot.
Dialogue: 0,0:17:17.19,0:17:19.66,Default,Lilia,0,0,0,,-Anong ikinatakot mo?\N-Hindi ako nahimatay.
Dialogue: 0,0:17:19.66,0:17:21.66,Default,Lily,0,0,0,,uminom ako hanggang sa mahimatay ako.
Dialogue: 0,0:17:21.76,0:17:24.20,Default,Lily,0,0,0,,Nga pala, ang sarap maging reyna.
Dialogue: 0,0:17:24.20,0:17:25.97,Default,Lily,0,0,0,,Nabuksan ang mga gate sa panahon ng curfew.
Dialogue: 0,0:17:25.97,0:17:28.00,Default,Lily,0,0,0,,Siya ay iyong pinsan
Dialogue: 0,0:17:28.00,0:17:30.14,Default,Lily,0,0,0,,at ang adopted son ni Kim Jwageun.
Dialogue: 0,0:17:30.14,0:17:31.67,Default,Lily,0,0,0,,Ganun ba?
Dialogue: 0,0:17:36.84,0:17:38.28,Default,Lily,0,0,0,,Nasaan ang court lady na si Choi?
Dialogue: 0,0:17:38.28,0:17:39.78,Default,Lily,0,0,0,,Late?
Dialogue: 0,0:17:40.91,0:17:42.98,Default,Lily,0,0,0,,Pinaalis siya ng iyong kapatid sa palasyo,
Dialogue: 0,0:17:42.98,0:17:45.62,Default,Lily,0,0,0,,para walang nakakaalam na may hangover ka.
Dialogue: 0,0:17:46.02,0:17:47.69,Default,Lily,0,0,0,,Ayaw niyang umalis,
Dialogue: 0,0:17:47.69,0:17:50.92,Default,Lily,0,0,0,,mahirap pilitin siya.
Dialogue: 0,0:17:50.92,0:17:54.39,Default,Lily,0,0,0,,Bakit ang lahat ay nag-aatubili na umalis sa palasyo?
Dialogue: 0,0:17:54.73,0:17:57.93,Default,Lily,0,0,0,,Delikado sa labas ng palasyo.
Dialogue: 0,0:17:58.16,0:18:01.07,Default,Lily,0,0,0,,Nasa palasyo ang lahat ng kailangan mo.
Dialogue: 0,0:18:01.43,0:18:04.07,Default,Lily,0,0,0,,Na-hypnotize ang lahat dito, o ano?
Dialogue: 0,0:18:04.07,0:18:06.51,Default,Lily,0,0,0,,May isang bagay na hindi makikita sa palasyo.
Dialogue: 0,0:18:06.61,0:18:08.34,Default,Lily,0,0,0,,-Ano ito?\N-Kalayaan.
Dialogue: 0,0:18:10.54,0:18:12.98,Default,Lily,0,0,0,,Sa labas ng palasyo lahat ay pareho.
Dialogue: 0,0:18:13.65,0:18:17.35,Default,Lily,0,0,0,,Okay, natutuwa akong wala siya. Inaasar niya ako.
Dialogue: 0,0:18:17.42,0:18:19.99,Default,Lily,0,0,0,,Ang aking maliit na ulo.
Dialogue: 0,0:18:21.52,0:18:24.06,Default,Lily,0,0,0,,I need some spicy ramen for my hangover
Dialogue: 0,0:18:24.06,0:18:26.73,Default,Lily,0,0,0,,at pawis. Mahusay na gamot.
Dialogue: 0,0:18:27.86,0:18:29.90,Default,Lily,0,0,0,,Walang ramen dito.
Dialogue: 0,0:18:29.90,0:18:32.33,Default,Lily,0,0,0,,At hangover drinks.
Dialogue: 0,0:18:35.10,0:18:37.40,Default,Lily,0,0,0,,Ngunit narito ako ay may kapangyarihan.
Dialogue: 0,0:18:39.91,0:18:41.87,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:18:42.41,0:18:43.91,Default,Lily,0,0,0,,Sindihin ang apoy.
Dialogue: 0,0:18:44.44,0:18:45.58,Default,Lily,0,0,0,,-Sindihin ang apoy.\N-Sindihin ang apoy.
Dialogue: 0,0:18:45.58,0:18:48.98,Default,Lily,0,0,0,,Wala akong ideya kung ano ang gusto niya.
Dialogue: 0,0:18:48.98,0:18:50.05,Default,Lily,0,0,0,,Ano?
Dialogue: 0,0:18:50.05,0:18:52.32,Default,Lily,0,0,0,,Pagkain para sa Daejojon hall.
Dialogue: 0,0:18:52.32,0:18:53.72,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:18:57.82,0:18:59.49,Default,Lily,0,0,0,,Anong kalokohan ito?
Dialogue: 0,0:19:12.11,0:19:14.01,Default,Lily,0,0,0,,Luto ba ang karne?
Dialogue: 0,0:19:33.66,0:19:35.26,Default,Lily,0,0,0,,Hindi ito.
Dialogue: 0,0:19:36.73,0:19:38.83,Default,Lily,0,0,0,,Well, okay. Sa pagkakataong ito...
Dialogue: 0,0:19:49.21,0:19:52.28,Default,Lily,0,0,0,,Damn. Ito lang ba ang kaya niyang gawin?
Dialogue: 0,0:19:55.45,0:19:58.62,Default,Lily,0,0,0,,Ano bang problema sa pagkain ko? What the hell?
Dialogue: 0,0:20:12.06,0:20:14.33,Default,Lily,0,0,0,,Ugh, malusog na pagkain.
Dialogue: 0,0:20:30.32,0:20:31.92,Default,Lily,0,0,0,,Hindi maanghang.
Dialogue: 0,0:20:37.76,0:20:40.53,Default,Lily,0,0,0,,Sobrang maanghang. Gusto mo ba akong patayin?
Dialogue: 0,0:20:45.97,0:20:47.57,Default,Lily,0,0,0,,Sapat na ako!
Dialogue: 0,0:20:47.57,0:20:49.97,Default,Lily,0,0,0,,Kung hindi mo gusto, hayaan mo siyang pumunta dito at magluto!
Dialogue: 0,0:20:49.97,0:20:53.61,Default,Lily,0,0,0,,Isang karamdaman. Ako na mismo magluluto.
Dialogue: 0,0:20:59.71,0:21:01.41,Default,Lily,0,0,0,,Ang furnace ay may kapangyarihan ng apoy,
Dialogue: 0,0:21:01.41,0:21:03.12,Default,Lily,0,0,0,,ngunit mahirap kontrolin ang apoy.
Dialogue: 0,0:21:03.12,0:21:06.55,Default,Lily,0,0,0,,Ang thermal conductivity ng boiler ay medyo mataas.
Dialogue: 0,0:21:09.72,0:21:11.86,Default,Lily,0,0,0,,Paano kung masaktan ka, Kamahalan?
Dialogue: 0,0:21:11.86,0:21:13.16,Default,Lily,0,0,0,,Wala ka na sa kusina mula noon,
Dialogue: 0,0:21:13.16,0:21:14.83,Default,Lily,0,0,0,,kung paano kami tumigil sa paglalaro ng bahay.
Dialogue: 0,0:21:14.83,0:21:17.43,Default,Lily,0,0,0,,Kahit pumunta lang ako dito para maglaro ng bahay,
Dialogue: 0,0:21:17.76,0:21:19.60,Default,Lily,0,0,0,,Mas masarap akong magluto kaysa sa kanya.
Dialogue: 0,0:21:23.64,0:21:25.17,Default,Lily,0,0,0,,Mag-ingat ka, Kamahalan.
Dialogue: 0,0:21:25.17,0:21:27.27,Default,Lily,0,0,0,,Ganyan mo ba siya hawak?
Dialogue: 0,0:21:27.64,0:21:29.54,Default,Lily,0,0,0,,Mag-ingat sa iyong mga daliri.
Dialogue: 0,0:21:34.48,0:21:35.98,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:21:42.56,0:21:45.16,Default,Lily,0,0,0,,First time kong nagluluto, kaya hindi ko alam kung tama ito.
Dialogue: 0,0:21:45.16,0:21:48.79,Default,Lily,0,0,0,,Mukhang kailangan mong i-cut ito ng ganito.
Dialogue: 0,0:22:51.49,0:22:52.99,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:23:06.07,0:23:08.64,Default,Lily,0,0,0,,Sigurado akong maganda lang ito.
Dialogue: 0,0:23:08.64,0:23:10.88,Default,Lily,0,0,0,,I bet hindi talaga ito seasoned.
Dialogue: 0,0:23:11.28,0:23:12.95,Default,Lily,0,0,0,,Siyempre.
Dialogue: 0,0:23:12.95,0:23:15.55,Default,Lily,0,0,0,,Oo. Ikaw ay ganap na tama.
Dialogue: 0,0:23:15.55,0:23:16.98,Default,Lily,0,0,0,,Bitawan mo ako.
Dialogue: 0,0:23:17.45,0:23:21.15,Default,Lily,0,0,0,,Nagtrabaho ako sa royal kitchen sa loob ng 30 taon.
Dialogue: 0,0:23:21.15,0:23:23.39,Default,Lily,0,0,0,,Ang pagluluto ay ang taas ng kasanayan.
Dialogue: 0,0:23:24.89,0:23:26.19,Default,Lily,0,0,0,,Okay.
Dialogue: 0,0:23:26.19,0:23:29.33,Default,Lily,0,0,0,,Susubukan ko mismo para maunawaan kung gaano ito kakila-kilabot.
Dialogue: 0,0:23:29.43,0:23:31.53,Default,Lily,0,0,0,,Hindi talaga ito masarap.
Dialogue: 0,0:23:43.14,0:23:46.18,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:23:55.55,0:23:57.16,Default,Lily,0,0,0,,Ganun na ba kalala ang lahat?
Dialogue: 0,0:23:59.43,0:24:01.06,Default,Lily,0,0,0,,Shiitake scent
Dialogue: 0,0:24:01.73,0:24:03.36,Default,Lily,0,0,0,,at berdeng mga sibuyas.
Dialogue: 0,0:24:05.66,0:24:07.97,Default,Lily,0,0,0,,Mayamang aroma ng karne.
Dialogue: 0,0:24:09.34,0:24:12.84,Default,Lily,0,0,0,,Halo-halo ang lasa ng tatlong sangkap. At ito...
Dialogue: 0,0:24:25.52,0:24:28.75,Default,Lily,0,0,0,,"Sam" ay tatlo, "hyang" ay aroma,
Dialogue: 0,0:24:28.75,0:24:31.12,Default,Lily,0,0,0,,at "ra" ay isang palayok.
Dialogue: 0,0:24:31.12,0:24:33.73,Default,Lily,0,0,0,,Tatlong bango sa isang palayok,
Dialogue: 0,0:24:33.73,0:24:35.79,Default,Lily,0,0,0,,"samhyanra".
Dialogue: 0,0:24:38.23,0:24:43.47,Default,Lily,0,0,0,,Samhyang ramen!
Dialogue: 0,0:25:11.00,0:25:13.27,Default,Lily,0,0,0,,Eksaktong kailangan.
Dialogue: 0,0:25:13.27,0:25:16.04,Default,Lily,0,0,0,,Mosodium glutamate doon.
Dialogue: 0,0:25:16.04,0:25:17.60,Default,Lily,0,0,0,,Ngunit mas mabuti kaysa wala.
Dialogue: 0,0:25:19.07,0:25:22.88,Default,Lily,0,0,0,,Salamat sa iyo, sinubukan ko ang maraming delicacy,
Dialogue: 0,0:25:22.88,0:25:25.94,Default,Lily,0,0,0,,ngunit walang ganoong kahanga-hanga.
Dialogue: 0,0:25:25.98,0:25:27.55,Default,Lily,0,0,0,,Subukan muli.
Dialogue: 0,0:25:28.85,0:25:33.05,Default,Lily,0,0,0,,Alamin na kung bibigyan ka ng ramen, ito ay tunay na pag-ibig.
Dialogue: 0,0:25:34.02,0:25:36.16,Default,Lily,0,0,0,,Then if you don’t mind.
Dialogue: 0,0:25:43.60,0:25:45.56,Default,Lily,0,0,0,,Kaya...
Dialogue: 0,0:25:46.40,0:25:48.33,Default,Lily,0,0,0,,Ikaw, na hindi pa nakahawak ng kutsilyo dati,
Dialogue: 0,0:25:48.33,0:25:50.30,Default,Lily,0,0,0,,mas mahusay na magluto kaysa sa isang royal chef.
Dialogue: 0,0:25:50.47,0:25:53.64,Default,Lily,0,0,0,,May hindi ka kayang gawin?
Dialogue: 0,0:25:55.04,0:25:59.24,Default,Lily,0,0,0,,I was an ideal person, capable of anything.
Dialogue: 0,0:25:59.85,0:26:02.18,Default,Lily,0,0,0,,Ngunit ngayon ay hindi ko magawa ang pinakamahalagang bagay.
Dialogue: 0,0:26:02.82,0:26:06.25,Default,Lily,0,0,0,,Kung ano ang naging pro at minahal ko ng higit sa lahat.
Dialogue: 0,0:26:08.19,0:26:11.42,Default,Lily,0,0,0,,Nakikita ko. pagbuburda?
Dialogue: 0,0:26:11.82,0:26:14.59,Default,Lily,0,0,0,,Eksakto. Maganda ang ginawa mo.
Dialogue: 0,0:26:16.03,0:26:17.50,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:26:17.90,0:26:19.77,Default,Lily,0,0,0,,Nang hinawakan ko,
Dialogue: 0,0:26:19.77,0:26:23.60,Default,Lily,0,0,0,,bulaklak ay namumukadkad at mga paru-paro ay kumakaway.
Dialogue: 0,0:26:23.87,0:26:26.41,Default,Lily,0,0,0,,Bagay iyon.
Dialogue: 0,0:26:29.07,0:26:31.98,Default,Lily,0,0,0,,Narito ang Kanyang Kamahalan.
Dialogue: 0,0:26:32.55,0:26:34.51,Default,Lily,0,0,0,,Bakit ngayon?
Dialogue: 0,0:26:34.51,0:26:37.28,Default,Lily,0,0,0,,Damn. Malalambot ang pansit.
Dialogue: 0,0:26:39.72,0:26:41.12,Default,Lily,0,0,0,,Hot.
Dialogue: 0,0:26:44.92,0:26:46.46,Default,Lily,0,0,0,,My Queen.
Dialogue: 0,0:26:57.04,0:26:58.84,Default,Lily,0,0,0,,Sa umaga binisita ko ang mga matatanda
Dialogue: 0,0:26:58.84,0:27:01.97,Default,Lily,0,0,0,,at iniisip ko kung ano ang nararamdaman mo, kaya bumisita ako.
Dialogue: 0,0:27:02.84,0:27:05.08,Default,Lily,0,0,0,,Alam ba niya ang tungkol kagabi?
Dialogue: 0,0:27:05.44,0:27:07.68,Default,Lily,0,0,0,,Walang dahilan para sumama ang loob.
Dialogue: 0,0:27:07.88,0:27:10.45,Default,Lily,0,0,0,,Kumusta ang gabi mo?
Dialogue: 0,0:27:10.45,0:27:12.05,Default,Lily,0,0,0,,Baguhin ang paksa.
Dialogue: 0,0:27:12.05,0:27:14.09,Default,Lily,0,0,0,,Iniiba niya ang paksa.
Dialogue: 0,0:27:14.95,0:27:16.56,Default,Lily,0,0,0,,Ang iyong mga panalangin.
Dialogue: 0,0:27:19.49,0:27:22.66,Default,Lily,0,0,0,,Queen, nakainom ka na ba?
Dialogue: 0,0:27:23.73,0:27:26.50,Default,Lily,0,0,0,,Ako? Syempre hindi.
Dialogue: 0,0:27:26.50,0:27:28.20,Default,Lily,0,0,0,,Hindi ka ba umiinom?
Dialogue: 0,0:27:33.37,0:27:35.01,Default,Lily,0,0,0,,Naglalaro ba tayo ng staring contest?
Dialogue: 0,0:27:39.68,0:27:42.55,Default,Lily,0,0,0,,Hindi ko alam na napakagaling mong sinungaling.
Dialogue: 0,0:27:50.32,0:27:52.06,Default,Lily,0,0,0,,Oh, sorry.
Dialogue: 0,0:27:52.32,0:27:54.13,Default,Lily,0,0,0,,Karaniwan kong hindi ito ginagawa,
Dialogue: 0,0:27:54.13,0:27:56.46,Default,Lily,0,0,0,,pero masyado kang lumapit.
Dialogue: 0,0:27:59.97,0:28:02.20,Default,Lily,0,0,0,,Muntik nang malaglag ang ilong ko.
Dialogue: 0,0:28:02.77,0:28:04.44,Default,Lily,0,0,0,,Marami akong gagawin. Paumanhin.
Dialogue: 0,0:28:04.44,0:28:06.31,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:28:08.24,0:28:10.08,Default,Lily,0,0,0,,Pupunta ako sa Songjeongjong hall.
Dialogue: 0,0:28:10.08,0:28:11.58,Default,Lily,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:28:15.88,0:28:19.08,Default,Lily,0,0,0,,Mukhang hindi siya masyadong busy. \NBpero kung oo, bakit ka pumunta dito?
Dialogue: 0,0:28:20.72,0:28:23.36,Default,Lily,0,0,0,,Damn, nanlambot na siya ngayon.
Dialogue: 0,0:28:33.27,0:28:35.47,Default,Spillik,0,0,0,,Pagbati, hari.
Dialogue: 0,0:28:35.47,0:28:36.94,Default,Spillit,0,0,0,,Kuya.
Dialogue: 0,0:28:37.10,0:28:39.51,Default,Spillit,0,0,0,,Lumapit
Dialogue: 0,0:28:39.51,0:28:41.84,Default,Spillik,0,0,0,,at sabihin mo sa akin, mabaho ba ako?
Dialogue: 0,0:28:41.84,0:28:43.38,Default,Spillie,0,0,0,,Mabaho?
Dialogue: 0,0:28:43.81,0:28:45.78,Default,Spillik,0,0,0,,Hindi ko pa masasabi.
Dialogue: 0,0:28:46.21,0:28:48.41,Default,Spillit,0,0,0,,Ihanda ang lahat.
Dialogue: 0,0:28:51.12,0:28:54.02,Default,Spillit,0,0,0,,Ano ang nakain ng reyna ko?
Dialogue: 0,0:28:54.19,0:28:57.22,Default,Spillik,0,0,0,,Nakakahiya!
Dialogue: 0,0:29:05.23,0:29:08.43,Default,Spillik,0,0,0,,Kamahalan, Dumating na si Kim Byungin.
Dialogue: 0,0:29:08.97,0:29:11.50,Default,Spillik,0,0,0,,Huh, kuya?
Dialogue: 0,0:29:13.17,0:29:16.24,Default,Spillik,0,0,0,,Malaki ang utang na loob ko sa iyo kagabi.
Dialogue: 0,0:29:16.24,0:29:18.78,Default,Spillik,0,0,0,,Ginawa ko ang dapat kong gawin.
Dialogue: 0,0:29:22.45,0:29:25.28,Default,Spillik,0,0,0,,Dahil may bisita ako, dapat akong mag-alok ng tsaa.
Dialogue: 0,0:29:25.28,0:29:27.05,Default,Spillik,0,0,0,,Na-miss kita.
Dialogue: 0,0:29:27.65,0:29:29.62,Default,Spillik,0,0,0,,Dito nahulog sa ulo ko.
Dialogue: 0,0:29:29.62,0:29:32.16,Default,Spillit,0,0,0,,Okay. Kailangan nating makipaglaro.
Dialogue: 0,0:29:32.22,0:29:34.49,Default,Spillik,0,0,0,,Na-miss din kita.
Dialogue: 0,0:29:35.93,0:29:37.60,Default,Spillik,0,0,0,,Natutuwa akong marinig.
Dialogue: 0,0:29:38.10,0:29:42.20,Default,XO,0,0,0,,Pinaalis ng iyong mga salita ang aking mga alalahanin.
Dialogue: 0,0:29:42.30,0:29:44.74,Default,XO,0,0,0,,Ano ang naantig sa kanya?
Dialogue: 0,0:29:44.74,0:29:46.57,Default,XO,0,0,0,,Nakarinig ako ng mga tsismis,
Dialogue: 0,0:29:47.34,0:29:50.01,Default,XO,0,0,0,,na nahulog ka sa lawa pagkatapos mo akong makilala.
Dialogue: 0,0:29:50.01,0:29:52.28,Default,XO,0,0,0,,Noong araw na sinabi nila na natatakot sila.
Dialogue: 0,0:29:52.51,0:29:54.11,Default,XO,0,0,0,,Tungkol saan ito?
Dialogue: 0,0:29:55.48,0:29:59.15,Default,XO,0,0,0,,Sabi ko nung araw na yun natakot ako...
Dialogue: 0,0:29:59.15,0:30:02.39,Default,XO,0,0,0,,At natakot ako?..
Dialogue: 0,0:30:04.12,0:30:08.09,Default,XO,0,0,0,,Wala nang mas masahol pa sa mundo kaysa sa mga tao.
Dialogue: 0,0:30:08.46,0:30:10.76,Default,XO,0,0,0,,Ikaw ba ay tinatakot?
Dialogue: 0,0:30:11.46,0:30:13.73,Default,XO,0,0,0,,Alam mo kung sino ang nagtulak
Dialogue: 0,0:30:13.73,0:30:15.27,Default,XO,0,0,0,,ikaw sa lawa
Dialogue: 0,0:30:15.27,0:30:16.90,Default,XO,0,0,0,,at inatake kagabi?
Dialogue: 0,0:30:17.60,0:30:19.10,Default,XO,0,0,0,,Stop.
Dialogue: 0,0:30:19.20,0:30:21.14,Default,XO,0,0,0,,Alam ko ang tungkol sa lawa.
Dialogue: 0,0:30:21.17,0:30:23.54,Default,XO,0,0,0,,Kumusta naman kagabi?
Dialogue: 0,0:30:24.24,0:30:27.01,Default,ХО,0,0,0,,-Ano ang sinasabi mo?\N-Hindi mo naaalala?
Dialogue: 0,0:30:27.38,0:30:29.62,Default,XO,0,0,0,,Sinubukan ka nilang patayin kagabi.
Dialogue: 0,0:30:29.62,0:30:31.12,Default,XO,0,0,0,,Patay?
Dialogue: 0,0:30:31.42,0:30:33.12,Default,XO,0,0,0,,Muntik na ba akong mamatay?
Dialogue: 0,0:30:33.12,0:30:34.95,Default,XO,0,0,0,,Sino iyon? bakit ako?
Dialogue: 0,0:30:34.95,0:30:36.96,Default,XO,0,0,0,,Sana alam mo,
Dialogue: 0,0:30:37.86,0:30:39.49,Default,XO,0,0,0,,pero nakikita kong hindi.
Dialogue: 0,0:30:40.06,0:30:43.93,Default,XO,0,0,0,,Ano? May dalawang tao na bang nagtangkang pumatay sa kanya?
Dialogue: 0,0:30:44.43,0:30:46.06,Default,XO,0,0,0,,Nasa panganib ba ang babaeng ito?
Dialogue: 0,0:30:46.06,0:30:47.77,Default,XO,0,0,0,,Sa araw na nahulog ka sa lawa
Dialogue: 0,0:30:47.77,0:30:51.27,Default,XO,0,0,0,,sabi mo natatakot ka. Sa tingin ko ay may kinalaman ito.
Dialogue: 0,0:30:51.54,0:30:55.01,Default,XO,0,0,0,,Mukhang hindi ka pa aware.\N May problema ako sa memorya ko.
Dialogue: 0,0:30:55.01,0:30:58.54,Default,XO,0,0,0,,Mas alam mo kung ano ang pinag-uusapan natin.
Dialogue: 0,0:30:59.75,0:31:01.25,Default,XO,0,0,0,,Tama ka
Dialogue: 0,0:31:03.92,0:31:06.55,Default,XO,0,0,0,,nakalimutan ang lahat tungkol sa araw na iyon?
Dialogue: 0,0:31:06.55,0:31:09.32,Default,XO,0,0,0,,Oo, wala akong maalala.
Dialogue: 0,0:31:12.22,0:31:13.76,Default,XO,0,0,0,,Hindi mahalaga.
Dialogue: 0,0:31:13.76,0:31:15.96,Default,XO,0,0,0,,Tell me, this guy...
Dialogue: 0,0:31:16.56,0:31:20.50,Default,XO,0,0,0,,Ano ang ginawa sa akin ng bastos na ito kahapon?
Dialogue: 0,0:31:21.00,0:31:23.24,Default,XO,0,0,0,,Malapit na sa curfew.
Dialogue: 0,0:31:23.24,0:31:24.97,Default,XO,0,0,0,,Sa paghuhusga sa paraan ng paghawak niya ng espada
Dialogue: 0,0:31:24.97,0:31:28.17,Default,XO,0,0,0,,at nakabihis siya, hindi siya ordinaryong tao.
Dialogue: 0,0:31:28.44,0:31:30.58,Default,XO,0,0,0,,Hindi ko alam kung ilan sila,
Dialogue: 0,0:31:30.64,0:31:33.04,Default,XO,0,0,0,,pero tinulungan nila siya.
Dialogue: 0,0:31:33.05,0:31:35.61,Default,XO,0,0,0,,Kung hindi dahil sa iyo, patay na ako.
Dialogue: 0,0:31:35.61,0:31:38.42,Default,XO,0,0,0,,Natutuwa akong nagkita tayo kahapon.
Dialogue: 0,0:31:44.39,0:31:45.86,Default,XO,0,0,0,,Huh?
Dialogue: 0,0:31:51.56,0:31:53.27,Default,XO,0,0,0,,Hey.
Dialogue: 0,0:31:58.24,0:32:00.84,Default,XO,0,0,0,,Bakit ka umalis ng palasyo kagabi?
Dialogue: 0,0:32:00.84,0:32:03.88,Default,ХО,0,0,0,,Nainis ako at nagpasyang mamasyal.
Dialogue: 0,0:32:05.64,0:32:09.58,Default,XO,0,0,0,,Kung nalaman ng Queen Dowager,
Dialogue: 0,0:32:09.58,0:32:12.12,Default,XO,0,0,0,,May problema ako.
Dialogue: 0,0:32:12.55,0:32:15.69,Default,XO,0,0,0,,Hindi lamang mapipigilan ang aking kalayaan sa paggalaw,
Dialogue: 0,0:32:15.69,0:32:17.66,Default,XO,0,0,0,,pero na-execute din si Hongyeon.
Dialogue: 0,0:32:18.26,0:32:21.23,Default,XO,0,0,0,,Maari mo bang ilihim ito?
Dialogue: 0,0:32:21.59,0:32:23.93,Default,XO,0,0,0,,Ngunit kailangan nating hanapin ang kriminal.
Dialogue: 0,0:32:24.36,0:32:26.26,Default,XO,0,0,0,,Gawin ito nang tahimik.
Dialogue: 0,0:32:26.33,0:32:29.20,Default,XO,0,0,0,,Malalagay ako sa gulo, alam mo ba?
Dialogue: 0,0:32:30.20,0:32:31.70,Default,XO,0,0,0,,Naiintindihan ko.
Dialogue: 0,0:32:31.70,0:32:34.07,Default,XO,0,0,0,,Sino ang nakakaalam na umalis ka sa palasyo?
Dialogue: 0,0:32:34.07,0:32:36.27,Default,XO,0,0,0,,Honyoung lang.
Dialogue: 0,0:32:37.34,0:32:40.31,Default,XO,0,0,0,,Papapanoodin ko siya ng mga tao.
Dialogue: 0,0:32:40.31,0:32:44.55,Default,XO,0,0,0,,Hindi, tapat siya sa akin, handa pa siyang mamatay para sa akin.
Dialogue: 0,0:32:44.55,0:32:45.98,Default,XO,0,0,0,,Wala siyang kinalaman dito.
Dialogue: 0,0:32:45.98,0:32:49.96,Default,XO,0,0,0,,Kamahalan, huwag kang magtiwala sa sinuman.
Dialogue: 0,0:32:49.96,0:32:51.89,Default,ХО,0,0,0,,Matagal ko na rin siyang kilala,
Dialogue: 0,0:32:51.89,0:32:54.53,Default,XO,0,0,0,,ngunit ang mga pinakamalapit sa iyo ay palaging mas mapanganib.
Dialogue: 0,0:32:55.26,0:32:58.70,Default,XO,0,0,0,,Dahil nasa palasyo ka ay hindi nangangahulugan na walang nagbabanta sa iyo. Hindi.
Dialogue: 0,0:33:00.53,0:33:02.80,Default,XO,0,0,0,,Mas delikado dito.
Dialogue: 0,0:33:03.20,0:33:07.11,Default,XO,0,0,0,,Sakto, nakalimutan ko na kung nasaan ako.
Dialogue: 0,0:33:07.11,0:33:09.21,Default,XO,0,0,0,,Sa isang palasyong puno ng intriga.
Dialogue: 0,0:33:09.21,0:33:12.78,Default,XO,0,0,0,,Ang lugar kung saan ang iyong buhay ay palaging nasa balanse.
Dialogue: 0,0:33:14.48,0:33:16.78,Default,XO,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:33:16.92,0:33:19.38,Default,XO,0,0,0,,Poprotektahan kita.
Dialogue: 0,0:33:19.95,0:33:21.72,Default,XO,0,0,0,,Salamat, pero
Dialogue: 0,0:33:21.95,0:33:23.72,Default,XO,0,0,0,,Kaya ko ang sarili ko.
Dialogue: 0,0:33:24.86,0:33:27.29,Default,XO,0,0,0,,Hindi ngayon ang oras para magpahinga.
Dialogue: 0,0:33:27.59,0:33:31.06,Default,XO,0,0,0,,Huwag subukang magmukhang malakas sa harap ko.
Dialogue: 0,0:33:47.61,0:33:49.75,Default,XO,0,0,0,,Baka nakalimutan mo,
Dialogue: 0,0:33:50.18,0:33:52.32,Default,XO,0,0,0,,pero tatandaan ko magpakailanman.
Dialogue: 0,0:33:52.75,0:33:55.95,Default,XO,0,0,0,,Ang alaala ng gabing iyon ay mananatili magpakailanman sa aking puso.
Dialogue: 0,0:34:01.23,0:34:04.33,Default,XO,0,0,0,,Aalamin ko kung sino ito sa anumang halaga.
Dialogue: 0,0:34:06.30,0:34:09.07,Default,XO,0,0,0,,
Dialogue: 0,0:34:11.20,0:34:14.44,Default,XO,0,0,0,,Nagbebenta sila ng silk yarn dito
Dialogue: 0,0:34:14.94,0:34:16.41,Default,XO,0,0,0,,mula sa Qing?
Dialogue: 0,0:34:36.19,0:34:39.50,Default,XO,0,0,0,,Nabalitaan ko na mayroon kang mahalagang mga kalakal mula sa Qing, kaya pumunta ako.
Dialogue: 0,0:34:46.24,0:34:49.01,Default,XO,0,0,0,,Mabilis na lumipad ang mga alingawngaw.
Dialogue: 0,0:34:50.84,0:34:52.28,Default,XO,0,0,0,,Pakiusap.
Dialogue: 0,0:35:08.56,0:35:13.53,Default,XO,0,0,0,,Nag-iimbak ka ba ng mga mahahalagang bagay sa ganoong katakut-takot na lugar?
Dialogue: 0,0:35:14.47,0:35:16.97,Default,XO,0,0,0,,Dahil mahalaga sila.
Dialogue: 0,0:35:30.25,0:35:31.68,Default,XO,0,0,0,,Narito.
Dialogue: 0,0:35:31.85,0:35:33.55,Default,XO,0,0,0,,Ano ito?
Dialogue: 0,0:35:34.85,0:35:37.82,Default,XO,0,0,0,,Ipikit ang isang mata.
Dialogue: 0,0:35:38.29,0:35:42.23,Default,XO,0,0,0,,At lumiko. Ganyan ito gumagana.
Dialogue: 0,0:35:42.23,0:35:44.56,Default,XO,0,0,0,,Master! Dito?
Dialogue: 0,0:35:44.56,0:35:46.06,Default,XO,0,0,0,,Darating ako!
Dialogue: 0,0:35:46.83,0:35:48.90,Default,XO,0,0,0,,Mukhang hindi mo ako naintindihan.
Dialogue: 0,0:35:48.90,0:35:51.54,Default,XO,0,0,0,,Naghahanap ako ng silk yarn...
Dialogue: 0,0:35:53.57,0:35:55.74,Default,XO,0,0,0,,Gusto kong bumili ng sinulid.
Dialogue: 0,0:35:56.61,0:35:59.38,Default,XO,0,0,0,,Ano ang dapat kong gawin sa pipe na ito?
Dialogue: 0,0:36:17.23,0:36:20.00,Default,XO,0,0,0,,Sinabi ni Kim Byungin na huwag magtiwala sa sinuman.
Dialogue: 0,0:36:20.00,0:36:21.67,Default,XO,0,0,0,,Kaya paano ka magtitiwala sa kanya?
Dialogue: 0,0:36:22.23,0:36:24.37,Default,XO,0,0,0,,Hindi ako sasaktan ni Honyeon.
Dialogue: 0,0:36:24.64,0:36:27.11,Default,XO,0,0,0,,Si Cho Hwajin na naman?
Dialogue: 0,0:36:28.14,0:36:29.47,Default,XO,0,0,0,,Ang isang linggo ay walang hanggan.
Dialogue: 0,0:36:29.47,0:36:31.58,Default,XO,0,0,0,,Hindi magtatagal bago mamatay.
Dialogue: 0,0:36:32.28,0:36:33.88,Default,XO,0,0,0,,Gagawin ko kung ano ang galing ko.
Dialogue: 0,0:36:33.88,0:36:35.58,Default,XO,0,0,0,,Manalo ako sa pagkain.
Dialogue: 0,0:36:35.61,0:36:37.52,Default,XO,0,0,0,,Matatalo niya ang anumang armor.
Dialogue: 0,0:36:37.52,0:36:39.62,Default,XO,0,0,0,,At gagana ito sa Dowager Queen.
Dialogue: 0,0:36:42.65,0:36:44.09,Default,XO,0,0,0,,Sandali lang.
Dialogue: 0,0:36:44.26,0:36:46.69,Default,XO,0,0,0,,Ito ba ang mga natira sa Queen Dowager?
Dialogue: 0,0:36:46.69,0:36:48.19,Default,XO,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:36:50.30,0:36:52.60,Default,XO,0,0,0,,Hayaan mo akong tingnan.
Dialogue: 0,0:36:52.80,0:36:54.57,Default,XO,0,0,0,,Maaaring magbigay ng ideya ang mga natira
Dialogue: 0,0:36:54.57,0:36:56.94,Default,XO,0,0,0,,tungkol sa kalusugan at mga kagustuhan.
Dialogue: 0,0:36:56.94,0:36:59.60,Default,XO,0,0,0,,Hindi ka makatingin sa kanila.
Dialogue: 0,0:36:59.60,0:37:01.04,Default,XO,0,0,0,,Alisin.
Dialogue: 0,0:37:01.34,0:37:03.98,Default,XO,0,0,0,,Anong ginagawa mo? Ako ang reyna.
Dialogue: 0,0:37:03.98,0:37:05.48,Default,XO,0,0,0,,Paumanhin,
Dialogue: 0,0:37:05.48,0:37:07.78,Default,XO,0,0,0,,pero ako ang royal chef.
Dialogue: 0,0:37:07.78,0:37:09.68,Default,XO,0,0,0,,Ibig sabihin sa kusina -
Dialogue: 0,0:37:09.68,0:37:11.98,Default,XO,0,0,0,,Ako ang hari.
Dialogue: 0,0:37:12.88,0:37:15.65,Default,XO,0,0,0,,Pagkatapos ay hayaan nating magsalita ang ating mga kakayahan.
Dialogue: 0,0:37:16.79,0:37:18.46,Default,XO,0,0,0,,Tingnan natin kung sino ang hari dito.
Dialogue: 0,0:37:21.19,0:37:23.03,Default,XO,0,0,0,,Huwag mong sabihin iyan.
Dialogue: 0,0:37:23.16,0:37:26.46,Default,XO,0,0,0,,Oras na para magluto ako. Paalam.
Dialogue: 0,0:37:26.83,0:37:29.37,Default,XO,0,0,0,,Ano, natatakot kang matalo?
Dialogue: 0,0:37:30.04,0:37:32.97,Default,XO,0,0,0,,Isang taong naglaro lang sa kusina noong bata?
Dialogue: 0,0:37:46.85,0:37:50.05,Default,XO,0,0,0,,Paano ang paghahanda?..
Dialogue: 0,0:38:19.38,0:38:20.92,Default,XO,0,0,0,,Mga Diyos!
Dialogue: 0,0:38:23.79,0:38:25.52,Default,XO,0,0,0,,Reyna!
Dialogue: 0,0:38:25.52,0:38:28.39,Default,XO,0,0,0,,Reyna!
Dialogue: 0,0:38:28.39,0:38:30.63,Default,XO,0,0,0,,Royal Chef!
Dialogue: 0,0:38:30.63,0:38:46.81,Default,XO,0,0,0,,-Queen!\N-Royal Chef!
Dialogue: 0,0:38:57.52,0:38:59.22,Default,XO,0,0,0,,Stop.
Dialogue: 0,0:39:04.23,0:39:05.76,Default,XO,0,0,0,,Hindi!
Dialogue: 0,0:39:07.87,0:39:09.30,Default,XO,0,0,0,,Damn.
Dialogue: 0,0:39:12.54,0:39:14.04,Default,XO,0,0,0,,Pagluluto
Dialogue: 0,0:39:14.64,0:39:16.47,Default,XO,0,0,0,,mahalaga ang bilis.
Dialogue: 0,0:39:16.47,0:39:19.34,Default,XO,0,0,0,,Ngunit mas mahalaga ang panlasa.
Dialogue: 0,0:39:19.34,0:39:20.85,Default,XO,0,0,0,,Tama.
Dialogue: 0,0:39:26.62,0:39:28.95,Default,,0,0,0,,-Ikaw.\N-Anong gusto mo?
Dialogue: 0,0:39:28.95,0:39:31.36,Default,,0,0,0,,Judging by your clothes, hindi ka nagtatrabaho dito.
Dialogue: 0,0:39:31.36,0:39:32.42,Default,,0,0,0,,Posisyon mo?
Dialogue: 0,0:39:32.42,0:39:34.83,Default,,0,0,0,,Tingnan ko ang mga maharlikang handog.
Dialogue: 0,0:39:34.83,0:39:37.13,Default,,0,0,0,,Chief Inspector ng Royal Kitchen.
Dialogue: 0,0:39:37.33,0:39:40.03,Default,,0,0,0,,-Pagkatapos suriin ang pagkain para sa lasa.\N-Ako?
Dialogue: 0,0:39:40.47,0:39:41.93,Default,,0,0,0,,Lahat ng naririto
Dialogue: 0,0:39:41.93,0:39:44.20,Default,,0,0,0,,hindi masusuri nang tapat ang pagkain.
Dialogue: 0,0:39:44.20,0:39:45.80,Default,,0,0,0,,Maging matapang, subukan ito.
Dialogue: 0,0:39:46.87,0:39:48.37,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:39:51.64,0:39:53.14,Default,,0,0,0,,Gaya ng sinasabi mo.
Dialogue: 0,0:40:06.19,0:40:10.06,Default,,0,0,0,,Hindi ko pa nasusubukan ang ganito hanggang ngayon.
Dialogue: 0,0:40:10.33,0:40:11.66,Default,,0,0,0,,Tulad ng kaligayahan,
Dialogue: 0,0:40:11.66,0:40:14.43,Default,,0,0,0,,napapasaya ng ulam na ito ang bibig ko.
Dialogue: 0,0:40:14.67,0:40:19.47,Default,,0,0,0,,Sa buong buhay ko, hindi pa nakatikim ng mas maganda ang dila ko...
Dialogue: 0,0:40:19.50,0:40:20.97,Default,,0,0,0,,Well...
Dialogue: 0,0:40:28.21,0:40:29.81,Default,,0,0,0,,Sino ka?
Dialogue: 0,0:40:38.59,0:40:41.99,Default,,0,0,0,,How dare a girl enter the royal kitchen?
Dialogue: 0,0:40:41.99,0:40:44.26,Default,,0,0,0,,Kasuklam-suklam.
Dialogue: 0,0:40:47.60,0:40:49.73,Default,,0,0,0,,Para sa akin ba ito?
Dialogue: 0,0:40:49.97,0:40:53.24,Default,,0,0,0,,How dare a girl enter the royal kitchen?
Dialogue: 0,0:40:57.21,0:41:01.08,Default,,0,0,0,,Hindi. Syempre hindi.
Dialogue: 0,0:41:07.19,0:41:10.02,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:41:12.49,0:41:13.89,Default,,0,0,0,,Sapat na.
Dialogue: 0,0:41:14.59,0:41:16.46,Default,,0,0,0,,Ako ang nauna,
Dialogue: 0,0:41:16.46,0:41:18.50,Default,,0,0,0,,at masarap ang aking pagkain.
Dialogue: 0,0:41:20.70,0:41:23.13,Default,,0,0,0,,Habang nasa kusina ako,
Dialogue: 0,0:41:23.33,0:41:25.30,Default,,0,0,0,,ang salita ko ay batas.
Dialogue: 0,0:41:26.84,0:41:28.44,Default,,0,0,0,,Makikipagtulungan ka ba sa akin.
Dialogue: 0,0:41:28.91,0:41:30.44,Default,,0,0,0,,-Oo, Kamahalan.\N-Oo, Kamahalan.
Dialogue: 0,0:41:30.44,0:41:31.91,Default,,0,0,0,,Hindi sapat para sa kanya...
Dialogue: 0,0:41:35.41,0:41:40.62,Default,,0,0,0,,Kung gusto mo, pwede kitang kunin bilang isang estudyante.
Dialogue: 0,0:41:43.62,0:41:47.46,Default,,0,0,0,, Your Majesty, His Majesty is now in the Daejojong Hall.
Dialogue: 0,0:41:54.57,0:41:56.93,Default,,0,0,0,,Ano ang utang ko sa isang maagang pagbisita?
Dialogue: 0,0:41:57.04,0:41:59.20,Default,,0,0,0,,Na-miss kita, aking reyna.
Dialogue: 0,0:41:59.90,0:42:02.34,Default,,0,0,0,,At ang cute mo talaga ngayon.
Dialogue: 0,0:42:02.87,0:42:05.48,Default,,0,0,0,,Pero hindi ba oras na para bumalik ka sa sarili mo?
Dialogue: 0,0:42:05.48,0:42:08.05,Default,,0,0,0,,-Mga Espesyal na Puwersa.\N-Ano?
Dialogue: 0,0:42:09.48,0:42:12.18,Default,,0,0,0,,May gusto ka bang sabihin sa akin tungkol sa salitang ito?
Dialogue: 0,0:42:12.22,0:42:14.59,Default,,0,0,0,,-Isang uri ba ito ng laro?\N-Well...
Dialogue: 0,0:42:15.59,0:42:18.16,Default,,0,0,0,,Panahon na para umalis ka.
Dialogue: 0,0:42:19.59,0:42:21.13,Default,,0,0,0,,Kusinera ng hukbo.
Dialogue: 0,0:42:21.49,0:42:22.96,Default,,0,0,0,,Ano?
Dialogue: 0,0:42:24.23,0:42:26.36,Default,,0,0,0,,Diyos. Well, ikaw talaga ang hari.
Dialogue: 0,0:42:26.36,0:42:28.57,Default,,0,0,0,,Ngayon may sasabihin ako, at papatayin mo ako para dito?
Dialogue: 0,0:42:28.57,0:42:30.10,Default,,0,0,0,,Magpatuloy.
Dialogue: 0,0:42:31.00,0:42:33.27,Default,,0,0,0,,Anong kalokohan ang sinasabi mo?
Dialogue: 0,0:42:38.08,0:42:40.41,Default,,0,0,0,,Gumagamit ka ng masasamang salita nang walang dahilan.
Dialogue: 0,0:42:40.41,0:42:43.21,Default,,0,0,0,,Dapat hindi ka masaya sa iyong buhay.
Dialogue: 0,0:42:43.21,0:42:45.58,Default,,0,0,0,,Sabihin mo sa akin ang lahat ng bumabagabag sa iyo.
Dialogue: 0,0:42:45.58,0:42:48.29,Default,,0,0,0,,Kung gusto mo, kaya ko pang manatili.
Dialogue: 0,0:42:48.49,0:42:50.32,Default,,0,0,0,,Ano bang sinasabi mo, okay lang sa akin ang lahat.
Dialogue: 0,0:42:50.32,0:42:53.99,Default,,0,0,0,,Oo, hindi talaga ako mapakali kung gaano kaganda ang buhay ko.
Dialogue: 0,0:42:55.29,0:42:57.76,Default,,0,0,0,,May nakita ka bang tao ngayon?
Dialogue: 0,0:42:59.00,0:43:00.27,Default,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:43:00.27,0:43:02.10,Default,,0,0,0,,Gaano niya narinig?
Dialogue: 0,0:43:02.23,0:43:05.10,Default,,0,0,0,,Gusto ko lang malaman kung kumusta ang araw mo.
Dialogue: 0,0:43:05.24,0:43:07.87,Default,,0,0,0,,Aalis na ako pagkatapos nating mag-usap ng kaunti.
Dialogue: 0,0:43:11.78,0:43:15.25,Default,,0,0,0,,Well, pinuntahan ako ng pinsan ko.
Dialogue: 0,0:43:16.48,0:43:17.78,Default,,0,0,0,,Pinsan?
Dialogue: 0,0:43:17.78,0:43:20.28,Default,,0,0,0,,Kim Byonin, kung hindi ako nagkakamali?
Dialogue: 0,0:43:20.35,0:43:21.62,Default,,0,0,0,,Ano ang kailangan niya?
Dialogue: 0,0:43:21.62,0:43:25.56,Default,,0,0,0,,Bakit parang ini-interrogate ako?
Dialogue: 0,0:43:25.69,0:43:27.39,Default,,0,0,0,,Masyado kang impressionable.
Dialogue: 0,0:43:27.53,0:43:30.19,Default,,0,0,0,,Nag-aalala lang ako sa mga kamag-anak ko
Dialogue: 0,0:43:30.19,0:43:31.83,Default,,0,0,0,,may nangyari.
Dialogue: 0,0:43:31.83,0:43:33.13,Default,,0,0,0,,Hindi.
Dialogue: 0,0:43:33.13,0:43:35.17,Default,,0,0,0,,Pumunta lang para kumustahin at bumati.
Dialogue: 0,0:43:35.17,0:43:37.60,Default,,0,0,0,,Kung gayon, hindi ko na kailangang mag-alala tungkol sa kanila.
Dialogue: 0,0:43:38.04,0:43:42.14,Default,,0,0,0,,Maaari ba akong magtanong, bakit ganito ang pakikitungo mo sa akin sa mga araw na ito?
Dialogue: 0,0:43:43.14,0:43:46.61,Default,,0,0,0,,Nasusuklam siya sa akin dahil alam niyang mamamatay tao ako?
Dialogue: 0,0:43:47.15,0:43:49.05,Default,,0,0,0,,Mag-asawa na kami.
Dialogue: 0,0:43:49.05,0:43:50.78,Default,,0,0,0,,Kahit magmahal ka ng baliw,
Dialogue: 0,0:43:50.78,0:43:52.85,Default,,0,0,0,,pagkatapos ng kasal, mawawala ang pagmamahalan.
Dialogue: 0,0:43:53.32,0:43:56.09,Default,,0,0,0,,Satisfied? Maaari kang pumunta.
Dialogue: 0,0:43:56.92,0:44:00.83,Default,,0,0,0,,Makinig ka sa akin. Magdala ng bed linen.
Dialogue: 0,0:44:00.89,0:44:03.70,Default,,0,0,0,,Anong ginagawa mo? Hindi kami nagkasundo sa ganyan.
Dialogue: 0,0:44:03.70,0:44:06.30,Default,,0,0,0,,Napapagod ako sa mga pag-uusap,
Dialogue: 0,0:44:06.30,0:44:09.03,Default,,0,0,0,,walang lakas na bumalik sa Hijeongjon.
Dialogue: 0,0:44:12.97,0:44:16.31,Default,,0,0,0,,Tagumpay sa araw, setup sa gabi.
Dialogue: 0,0:44:23.11,0:44:25.48,Default,,0,0,0,,Mukhang kahina-hinala siya.
Dialogue: 0,0:44:26.82,0:44:28.89,Default,,0,0,0,, Kahit papaano ay kahina-hinala siya.
Dialogue: 0,0:44:33.59,0:44:34.99,Default,,0,0,0,,Kamahalan,
Dialogue: 0,0:44:35.16,0:44:37.80,Default,,0,0,0,,hindi ka dapat magtiwala sa sinuman.
Dialogue: 0,0:44:37.83,0:44:41.23,Default,,0,0,0,,Oo, talagang wala siyang pananampalataya.
Dialogue: 0,0:44:41.23,0:44:43.00,Default,,0,0,0,,Kahit saan o kailan,
Dialogue: 0,0:44:43.00,0:44:46.37,Default,,0,0,0,,at ang asawa ang unang pinaghihinalaang pumatay sa kanyang asawa.
Dialogue: 0,0:44:52.68,0:44:55.71,Default,,0,0,0,,Baka may sasabihin siya sa iyo sa kanyang pagtulog.
Dialogue: 0,0:44:55.88,0:44:58.18,Default,,0,0,0,,Paano kung may iniisip siya at hinihintay akong makatulog?
Dialogue: 0,0:44:58.45,0:45:00.08,Default,,0,0,0,,-Hindi ako makatulog.\N-Hindi ako makatulog.
Dialogue: 0,0:46:01.15,0:46:02.55,Default,,0,0,0,,Hindi.
Dialogue: 0,0:46:03.08,0:46:06.08,Default,,0,0,0,,Hindi! Hindi, huwag!
Dialogue: 0,0:46:09.32,0:46:12.19,Default,,0,0,0,,Hindi, huwag!
Dialogue: 0,0:46:12.26,0:46:13.46,Default,,0,0,0,,Hindi.
Dialogue: 0,0:46:13.46,0:46:16.29,Default,,0,0,0,,Hey. Ano bang problema mo?
Dialogue: 0,0:46:16.29,0:46:18.23,Default,,0,0,0,,Diyos. Baka mamatay siya ng ganyan.
Dialogue: 0,0:46:18.23,0:46:22.10,Default,,0,0,0,,Hey. gumising ka na! Gumising ka, tara na!
Dialogue: 0,0:46:31.74,0:46:33.34,Default,,0,0,0,,Hwajin.
Dialogue: 0,0:46:33.88,0:46:36.38,Default,,0,0,0,,Iniligtas mo muli ang buhay ko.
Dialogue: 0,0:46:36.38,0:46:38.02,Default,,0,0,0,,Salamat.
Dialogue: 0,0:46:38.02,0:46:41.09,Default,,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:46:41.09,0:46:42.49,Default,,0,0,0,,Diyos.
Dialogue: 0,0:46:43.69,0:46:45.16,Default,,0,0,0,,Hwajin.
Dialogue: 0,0:46:48.49,0:46:51.16,Default,,0,0,0,,-My queen.\N-Damn.
Dialogue: 0,0:46:51.36,0:46:54.63,Default,,0,0,0,,Akala mo ba mamamatay ako kapag sinaktan mo ako ng ganyan?
Dialogue: 0,0:46:54.93,0:46:56.93,Default,,0,0,0,,Mamatay ka sana kung hindi kita ginising.
Dialogue: 0,0:46:56.93,0:46:59.64,Default,,0,0,0,,Wiggled na parang uod.
Dialogue: 0,0:47:00.30,0:47:04.04,Default,,0,0,0,,Natamaan mo ako dahil sinabi ko ang pangalan ng ibang babae.
Dialogue: 0,0:47:04.04,0:47:06.31,Default,,0,0,0,,Hindi na kailangang mag-alala.
Dialogue: 0,0:47:07.61,0:47:09.85,Default,,0,0,0,,Wala akong pakialam kung sino ang tawagan mo.
Dialogue: 0,0:47:09.85,0:47:12.82,Default,,0,0,0,,Itago natin ang ating distansya.
Dialogue: 0,0:47:15.05,0:47:16.79,Default,,0,0,0,,Sinabi mo ulit.
Dialogue: 0,0:47:16.95,0:47:18.22,Default,,0,0,0,,Dahil gising ka na,
Dialogue: 0,0:47:18.22,0:47:20.46,Default,,0,0,0,,mabuti pang bumalik ka sa iyong lugar
Dialogue: 0,0:47:20.46,0:47:22.63,Default,,0,0,0,,at makatulog.
Dialogue: 0,0:47:24.20,0:47:28.87,Default,,0,0,0,,Kung aalis ako ngayon, kailangan kong gisingin ang mga katulong ko. \NIto ay hindi maganda.
Dialogue: 0,0:47:31.77,0:47:34.11,Default,,0,0,0,,Gaano tayo kabukas-palad.
Dialogue: 0,0:47:34.24,0:47:37.41,Default,,0,0,0,,Oh, aking reyna, salamat sa papuri.
Dialogue: 0,0:47:42.55,0:47:44.55,Default,,0,0,0,,Diyos, aking reyna.
Dialogue: 0,0:47:44.55,0:47:47.15,Default,,0,0,0,,Napaka-selfish mo.
Dialogue: 0,0:47:53.09,0:47:55.56,Default,,0,0,0,,Oo, isa kang tunay na strongwoman.
Dialogue: 0,0:47:55.56,0:47:57.43,Default,,0,0,0,,Higa ka lang at matulog.
Dialogue: 0,0:47:58.70,0:48:02.20,Default,,0,0,0,,Dapat na marunong makibahagi ang isang maawaing hari.
Dialogue: 0,0:48:22.59,0:48:27.49,Default,,0,0,0,,Sa tuwing matutulog ako sa Daejeon, sumasakit ang buong katawan ko.
Dialogue: 0,0:48:28.73,0:48:31.33,Default,,0,0,0,,Kaya hindi na tayo dapat matulog ng magkasama.
Dialogue: 0,0:48:31.33,0:48:33.63,Default,,0,0,0,,Dapat kasi hindi ako sanay sa lugar na ito.
Dialogue: 0,0:48:33.63,0:48:37.30,Default,,0,0,0,,Kailangan kong manatili nang mas madalas hanggang sa masanay ako.
Dialogue: 0,0:48:38.57,0:48:41.74,Default,,0,0,0,,Ayoko nang magising muli dahil sa mga bangungot mo.
Dialogue: 0,0:48:42.31,0:48:44.11,Default,,0,0,0,,Wala akong maalala na bangungot,
Dialogue: 0,0:48:44.11,0:48:46.31,Default,,0,0,0,,at ganito nila ako sinaktan sa pagsasabi ng pangalan ng iba,
Dialogue: 0,0:48:46.31,0:48:48.28,Default,,0,0,0,,Hindi ko makakalimutan.
Dialogue: 0,0:48:49.31,0:48:53.08,Default,,0,0,0,,Sa susunod sasabihin ko ang pangalan mo.
Dialogue: 0,0:48:53.08,0:48:55.49,Default,,0,0,0,,Sisimulan ko ngayong gabi.
Dialogue: 0,0:48:58.39,0:49:00.89,Default,,0,0,0,,God, nawalan pa ako ng gana.
Dialogue: 0,0:49:01.03,0:49:04.09,Default,,0,0,0,,Kung kumain ka na, pwede ka nang umalis. May mga gagawin ako.
Dialogue: 0,0:49:04.40,0:49:06.80,Default,,0,0,0,,Ano ang pinagkakaabalahan mo?
Dialogue: 0,0:49:08.30,0:49:09.73,Default,,0,0,0,,Trabaho.
Dialogue: 0,0:49:09.80,0:49:12.40,Default,,0,0,0,,Dahil hindi ko magamit ang aking telepono at mga social network,
Dialogue: 0,0:49:12.40,0:49:14.81,Default,,0,0,0,,kung gayon wala akong choice kundi magtrabaho.
Dialogue: 0,0:49:16.11,0:49:17.98,Default,,0,0,0,,Mga social network?
Dialogue: 0,0:49:17.98,0:49:19.84,Default,,0,0,0,,Mga social network.
Dialogue: 0,0:49:21.31,0:49:25.45,Default,,0,0,0,,Naiintindihan ko. Ang pag-ibig ay dapat na malambot.
Dialogue: 0,0:49:26.88,0:49:29.72,Default,,0,0,0,,Ngayong gabi ako mismo ang magiging lambing.
Dialogue: 0,0:49:42.97,0:49:45.50,Default,,0,0,0,,Direktang hit!
Dialogue: 0,0:49:46.64,0:49:49.21,Default,,0,0,0,,Magaling!
Dialogue: 0,0:49:49.21,0:49:51.54,Default,,0,0,0,,Saan mo ito natutunan?
Dialogue: 0,0:49:51.61,0:49:53.34,Default,,0,0,0,,Nalilito mo ako.
Dialogue: 0,0:49:53.95,0:49:57.68,Default,,0,0,0,,Dapat ko bang ipakita kung ano ang kaya ko?
Dialogue: 0,0:49:57.68,0:49:59.18,Default,,0,0,0,,So.
Dialogue: 0,0:50:10.06,0:50:11.53,Default,,0,0,0,,Well, well...
Dialogue: 0,0:50:12.23,0:50:13.90,Default,,0,0,0,,Nagsimulang umikot at umiikot ang lahat,
Dialogue: 0,0:50:13.90,0:50:16.23,Default,,0,0,0,,sa pangkalahatan, ilang gabi akong kasama ng hari.
Dialogue: 0,0:50:16.40,0:50:18.74,Default,,0,0,0,,Pero hindi kami natulog sa kanya.
Dialogue: 0,0:50:21.24,0:50:23.01,Default,,0,0,0,,Nagpapanggap lang kami.
Dialogue: 0,0:50:23.21,0:50:25.71,Default,,0,0,0,,Alam mo, madalas siyang pumupunta sa kanyang mga silid.
Dialogue: 0,0:50:26.78,0:50:28.61,Default,,0,0,0,,Pero kahapon parang napalitan ito:
Dialogue: 0,0:50:28.61,0:50:30.58,Default,,0,0,0,,tumanggi siyang pumunta sa kanyang lugar.
Dialogue: 0,0:50:30.65,0:50:32.48,Default,,0,0,0,,Ngunit huwag mag-alala.
Dialogue: 0,0:50:32.48,0:50:34.99,Default,,0,0,0,,Walang nangyari sa gabi, at wala nang mangyayari sa hinaharap.
Dialogue: 0,0:50:34.99,0:50:39.72,Default,,0,0,0,,Humiling kang makipagkita para sabihin sa akin ito?
Dialogue: 0,0:50:39.79,0:50:41.29,Default,,0,0,0,,Hindi, hindi talaga.
Dialogue: 0,0:50:41.29,0:50:44.00,Default,,0,0,0,,Totoo ba na tinulak niya ako sa lawa?
Dialogue: 0,0:50:44.00,0:50:45.60,Default,,0,0,0,,At pagkatapos din?
Dialogue: 0,0:50:46.16,0:50:49.70,Default,,0,0,0,,Kung gayon, sulit ang pagbagal sa loob ng ilang araw.
Dialogue: 0,0:50:50.47,0:50:53.87,Default,,0,0,0,,Napakahirap kapag kinasusuklaman ka ng isang magandang babae.
Dialogue: 0,0:50:54.31,0:50:56.41,Default,,0,0,0,,Kung hindi mo lang ako kinasusuklaman.
Dialogue: 0,0:50:58.48,0:51:01.95,Default,,0,0,0,,Mukhang hindi pabor sa iyo ang hangin sa pagkakataong ito.
Dialogue: 0,0:51:02.41,0:51:05.48,Default,,0,0,0,,Kung nagtitiwala ka sa akin at maghihintay ng ilang araw...
Dialogue: 0,0:51:06.42,0:51:10.39,Default,,0,0,0,,Alam mo ba kung sino ang hindi ko dapat pagkatiwalaan sa palasyo?
Dialogue: 0,0:51:11.79,0:51:14.59,Default,,0,0,0,,Sa iyo, Kamahalan. Samakatuwid
Dialogue: 0,0:51:14.76,0:51:17.90,Default,,0,0,0,,Hindi ako naniniwala sa anumang sinabi mo.
Dialogue: 0,0:51:19.03,0:51:23.23,Default,,0,0,0,,At huwag mo nang subukang sumama sa pagitan namin ng Kanyang Kamahalan,
Dialogue: 0,0:51:23.23,0:51:24.87,Default,,0,0,0,,mas mabuting sumuko na.
Dialogue: 0,0:51:24.87,0:51:27.64,Default,,0,0,0,,Nagsimula akong mamuhay mula sa simula.
Dialogue: 0,0:51:27.71,0:51:29.71,Default,,0,0,0,,Hindi mo ba nakikita kung paano ako nagbago?
Dialogue: 0,0:51:30.21,0:51:32.01,Default,,0,0,0,,Nagbago ka ng mas malala.
Dialogue: 0,0:51:32.01,0:51:34.35,Default,,0,0,0,,Ngumiti ka sa mukha ko,
Dialogue: 0,0:51:34.55,0:51:37.35,Default,,0,0,0,,pero sa likod ko sisihin mo ako sa nangyari sa lawa.
Dialogue: 0,0:51:37.68,0:51:40.55,Default,,0,0,0,,Hindi kita sinisi kahit kailan.
Dialogue: 0,0:51:40.55,0:51:41.82,Default,,0,0,0,,Hindi namin alam kung sino iyon,
Dialogue: 0,0:51:41.82,0:51:44.12,Default,,0,0,0,,hinala ka dahil nandoon ka.
Dialogue: 0,0:51:44.12,0:51:47.66,Default,,0,0,0,,Alam mo kung sino iyon.
Dialogue: 0,0:51:52.93,0:51:54.53,Default,,0,0,0,,Ang taong gumawa nito ay
Dialogue: 0,0:51:55.57,0:51:57.80,Default,,0,0,0,,ikaw ito, Kamahalan.
Dialogue: 0,0:52:04.11,0:52:06.64,Default,,0,0,0,,Kusa kang nahulog sa tubig,
Dialogue: 0,0:52:06.98,0:52:09.35,Default,,0,0,0,,para i-set up ako.
Dialogue: 0,0:52:17.79,0:52:20.82,Default,,0,0,0,,Kung tutuusin kung gaano siya galit, hindi siya nagsisinungaling.
Dialogue: 0,0:52:21.63,0:52:24.43,Default,,0,0,0,,Ngayon alam ko na kung bakit malamig ang tingin niya sa akin.
Dialogue: 0,0:52:25.16,0:52:29.17,Default,,0,0,0,,Ang insidente sa lawa ay gawa-gawa lamang. Ang natitira ay ang pumatay.
Dialogue: 0,0:52:30.10,0:52:34.10,Default,,0,0,0,,Hindi nagbabago ang katotohanang may sumusunod sa akin.
Dialogue: 0,0:52:35.37,0:52:39.21,Default,,0,0,0,,Kamahalan, kailangan mong bumalik sa Daejojeon Hall.
Dialogue: 0,0:52:39.74,0:52:42.08,Default,,0,0,0,,Court Lady Choi, \Ngo muna sa Daejojong.
Dialogue: 0,0:52:45.02,0:52:47.22,Default,,0,0,0,,Kung may mangyari, mag-isip ng isang bagay
Dialogue: 0,0:52:47.22,0:52:48.92,Default,,0,0,0,,at ipadala si Hongyeon pagkatapos ko.
Dialogue: 0,0:52:48.92,0:52:49.99,Default,,0,0,0,,I don't dare...
Dialogue: 0,0:52:49.99,0:52:51.89,Default,,0,0,0,,Ito lang ang paraan para matulungan mo ako.
Dialogue: 0,0:52:52.29,0:52:53.72,Default,,0,0,0,,Pakiusap.
Dialogue: 0,0:52:56.09,0:52:58.06,Default,,0,0,0,,Hey, eto.
Dialogue: 0,0:53:00.10,0:53:01.27,Default,,0,0,0,,Royal Chef.
Dialogue: 0,0:53:01.27,0:53:03.77,Default,,0,0,0,,Gaano ka kadalas naglilingkod sa Dowager Queen?
Dialogue: 0,0:53:03.77,0:53:05.84,Default,,0,0,0,,Hindi ko masasabing sigurado,
Dialogue: 0,0:53:05.84,0:53:07.84,Default,,0,0,0,,ngunit ilang beses sa isang araw sigurado.
Dialogue: 0,0:53:15.58,0:53:18.15,Default,,0,0,0,,Hindi ko sinasadyang sabihin iyon,
Dialogue: 0,0:53:18.15,0:53:21.49,Default,,0,0,0,,ngunit sa Joseon ay maraming maaaring \Nmaging royal chef.
Dialogue: 0,0:53:26.62,0:53:28.13,Default,,0,0,0,,May almusal ako, tanghalian, meryenda sa hapon,
Dialogue: 0,0:53:28.13,0:53:29.33,Default,,0,0,0,,light snacks, hapunan
Dialogue: 0,0:53:29.33,0:53:32.20,Default,,0,0,0,,at mga meryenda sa gabi.
Dialogue: 0,0:53:32.26,0:53:33.46,Default,,0,0,0,,At kinakain niya lahat?
Dialogue: 0,0:53:33.46,0:53:35.47,Default,,0,0,0,,Isang beses bawat 3-4 na araw
Dialogue: 0,0:53:35.60,0:53:38.04,Default,,0,0,0,,tumanggi siya sa tanghalian.
Dialogue: 0,0:53:38.04,0:53:42.51,Default,,0,0,0,,Sa ganoong araw humihingi siya ng pulot at luya na pulbos.
Dialogue: 0,0:53:49.15,0:53:50.71,Default,,0,0,0,,Hindi siya kumain
Dialogue: 0,0:53:50.71,0:53:53.62,Default,,0,0,0,, malamig at may ngumunguya.
Dialogue: 0,0:53:53.62,0:53:55.59,Default,,0,0,0,,Hindi niya hiniling na baguhin ang menu,
Dialogue: 0,0:53:55.59,0:53:57.52,Default,,0,0,0,,na ang ibig sabihin ay gusto niya itong itago.
Dialogue: 0,0:53:59.46,0:54:03.09,Default,,0,0,0,,Mas tinitignan ko ang mga mukha nila kaysa sa kakayahan nila.
Dialogue: 0,0:54:03.66,0:54:05.96,Default,,0,0,0,,Gwapo silang lahat?
Dialogue: 0,0:54:06.76,0:54:08.20,Default,,0,0,0,,-Bam.\N-Bam.
Dialogue: 0,0:54:08.33,0:54:09.80,Default,,0,0,0,,Hey there!
Dialogue: 0,0:54:09.93,0:54:12.10,Default,,0,0,0,,Sa tingin mo ba napakatahimik ng tunog ng isang shot?
Dialogue: 0,0:54:12.10,0:54:15.27,Default,,0,0,0,,Kailangang maging mas malakas. "Bam"!
Dialogue: 0,0:54:15.27,0:54:17.37,Default,,0,0,0,,-Bam.\N-Bam.
Dialogue: 0,0:54:17.37,0:54:19.91,Default,,0,0,0,,Aming mahal na Ministro ng Digmaan, ang iyong headdress ay nakatagilid.
Dialogue: 0,0:54:19.91,0:54:23.01,Default,,0,0,0,,Ano ang pinapayagan mo sa iyong sarili?
Dialogue: 0,0:54:23.58,0:54:27.15,Default,,0,0,0,,Nga pala, narinig kong hiniling mo sa hari na ilipat ka
Dialogue: 0,0:54:27.15,0:54:28.75,Default,,0,0,0,,sa Opisina ng Royal Guard.
Dialogue: 0,0:54:28.75,0:54:31.92,Default,,0,0,0,,Ang pamamahala ng royal guard ay hindi tropa,
Dialogue: 0,0:54:31.92,0:54:33.66,Default,,0,0,0,,pwede kang magulo diyan.
Dialogue: 0,0:54:33.66,0:54:35.16,Default,,0,0,0,,Kumakalat ang mga ganyang tsismis,
Dialogue: 0,0:54:35.16,0:54:37.36,Default,,0,0,0,,at naisip ko: ito ang kailangan ko.
Dialogue: 0,0:54:37.36,0:54:40.46,Default,,0,0,0,,Hindi ko gustong pilitin ang sarili ko.
Dialogue: 0,0:54:53.64,0:54:55.91,Default,,0,0,0,,-Kailan?\N-Ngayong gabi.
Dialogue: 0,0:54:55.91,0:54:57.35,Default,,0,0,0,,Okay.
Dialogue: 0,0:55:05.09,0:55:07.66,Default,,0,0,0,,Ito ay fly agaric powder.
Dialogue: 0,0:55:07.66,0:55:09.59,Default,,0,0,0,,Walang amoy at walang lasa.
Dialogue: 0,0:55:09.59,0:55:12.96,Default,,0,0,0,,Ihalo sa alak at ibunyag ang lahat ng sikreto.
Dialogue: 0,0:55:13.50,0:55:16.70,Default,,0,0,0,,Ngunit kung may alam ang reyna,
Dialogue: 0,0:55:16.70,0:55:18.57,Default,,0,0,0,,hindi siya tahimik.
Dialogue: 0,0:55:18.60,0:55:20.84,Default,,0,0,0,,She's either up to something,
Dialogue: 0,0:55:20.94,0:55:23.11,Default,,0,0,0,,o naghihintay ng tamang sandali.
Dialogue: 0,0:55:23.47,0:55:25.31,Default,,0,0,0,,Kailangang makasigurado.
Dialogue: 0,0:55:34.42,0:55:37.22,Default,,0,0,0,,Walang sapat na ambisyon si Prince Yeonpyeong.
Dialogue: 0,0:55:37.22,0:55:39.92,Default,,0,0,0,,Nananatili siya sa Kanyang Kamahalan
Dialogue: 0,0:55:39.92,0:55:42.86,Default,,0,0,0,,at tumatambay kasama si Hong Byulgam
Dialogue: 0,0:55:44.13,0:55:46.00,Default,,0,0,0,,sa gabi.
Dialogue: 0,0:55:49.30,0:55:51.67,Default,,0,0,0,,Hon Byulgam
Dialogue: 0,0:55:52.00,0:55:55.14,Default,,0,0,0,,parehas pa ring tamad,\N umiiwas sa kanyang mga responsibilidad.
Dialogue: 0,0:55:55.81,0:55:58.08,Default,,0,0,0,,Ang Royal Guard Office ay pangalan lang.
Dialogue: 0,0:55:58.08,0:55:59.98,Default,,0,0,0,,Mas mabuting hayaan siyang umupo doon.
Dialogue: 0,0:56:00.78,0:56:02.55,Default,,0,0,0,,Nawalan siya hindi lamang ng kanyang ama at kapatid,
Dialogue: 0,0:56:02.55,0:56:05.45,Default,,0,0,0,,kundi pati na rin ang kanyang ina at lolo't lola sa harap mismo ng kanyang mga mata.
Dialogue: 0,0:56:05.78,0:56:07.99,Default,,0,0,0,,Nagsilbing aral ito sa kanya.
Dialogue: 0,0:56:08.15,0:56:13.16,Default,,0,0,0,,Nga pala, kailan ka hihiranging pinuno ng royal guard?
Dialogue: 0,0:56:13.89,0:56:15.29,Default,,0,0,0,,May problema ba?
Dialogue: 0,0:56:15.29,0:56:18.93,Default,,0,0,0,,Gusto ko lang ayusin ang lahat bago ito italaga.
Dialogue: 0,0:56:22.57,0:56:25.70,Default,,0,0,0,,Nakinabang ka na ba sa pagpapalitan ng impormasyong militar?
Dialogue: 0,0:56:27.00,0:56:28.91,Default,,0,0,0,,Huwag lumampas sa linya.
Dialogue: 0,0:56:29.11,0:56:31.14,Default,,0,0,0,,Ilang beses ko na bang sinabi sa iyo,
Dialogue: 0,0:56:31.14,0:56:33.14,Default,,0,0,0,,na ang isang hindi matatag na hukbo ay lubhang mapanganib?
Dialogue: 0,0:56:33.74,0:56:35.21,Default,,0,0,0,,Alam ko.
Dialogue: 0,0:56:35.88,0:56:37.68,Default,,0,0,0,,Ako na ang bahala sa lahat.
Dialogue: 0,0:56:40.15,0:56:41.79,Default,,0,0,0,,Gaano man ang iniisip ko,
Dialogue: 0,0:56:42.35,0:56:45.56,Default,,0,0,0,,pero pakiramdam ko may nangyayaring delikado sa labas ng palasyo.
Dialogue: 0,0:56:45.56,0:56:46.92,Default,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:56:46.92,0:56:50.33,Default,,0,0,0,,Papuntang Oktajeong ilang araw ang nakalipas...
Dialogue: 0,0:56:50.46,0:56:52.73,Default,,0,0,0,,Sinabi mo bang Okthajeong?
Dialogue: 0,0:56:52.73,0:56:56.00,Default,,0,0,0,,Oo. Nakipagkaibigan ako sa isang lalaki
Dialogue: 0,0:56:56.00,0:56:59.80,Default,,0,0,0,,na may magandang pangalan na Lee Sanman.
Dialogue: 0,0:57:00.30,0:57:01.97,Default,,0,0,0,,Lee Senman.
Dialogue: 0,0:57:02.17,0:57:03.97,Default,,0,0,0,,Kilala mo ba siya?
Dialogue: 0,0:57:04.51,0:57:07.81,Default,,0,0,0,,Hindi. Pero parang pamilyar ang pangalan.
Dialogue: 0,0:57:07.81,0:57:10.21,Default,,0,0,0,,Marahil siya ay mula sa isang sikat na maharlikang pamilya.
Dialogue: 0,0:57:10.21,0:57:12.05,Default,,0,0,0,,Pero hindi ko pa narinig ang pangalan niya.
Dialogue: 0,0:57:12.92,0:57:16.55,Default,,0,0,0,,So, nung pumunta kami sa Okthajeong kasama siya,
Dialogue: 0,0:57:16.55,0:57:19.52,Default,,0,0,0,,sa hindi inaasahang pagkakataon may nakabangga sa akin,
Dialogue: 0,0:57:19.52,0:57:21.43,Default,,0,0,0,,at nawalan ako ng malay.
Dialogue: 0,0:57:22.33,0:57:23.93,Default,,0,0,0,,Paggising ko,
Dialogue: 0,0:57:23.93,0:57:29.43,Default,,0,0,0,,napagtanto na si Lee Senman ay nawala na parang multo.
Dialogue: 0,0:57:29.47,0:57:31.94,Default,,0,0,0,,Naaalala mo ba kung paano siya nagbihis?
Dialogue: 0,0:57:31.94,0:57:34.17,Default,,0,0,0,,-Siyempre.\N-On
Dialogue: 0,0:57:36.04,0:57:38.88,Default,,0,0,0,,may mga damit ba na gawa sa ganyang tela?
Dialogue: 0,0:57:45.02,0:57:46.45,Default,,0,0,0,,Hindi.
Dialogue: 0,0:57:50.09,0:57:51.52,Default,,0,0,0,,Nakuha ko.
Dialogue: 0,0:57:51.59,0:57:54.46,Default,,0,0,0,,Kung makikita mo muli ang iyong kaibigan,
Dialogue: 0,0:57:54.46,0:57:56.96,Default,,0,0,0,,alamin kung ano ang nangyari noon.
Dialogue: 0,0:57:57.23,0:57:58.90,Default,,0,0,0,,Ibig sabihin ba nito,
Dialogue: 0,0:57:59.90,0:58:03.23,Default,,0,0,0,,ano ang binibigay mo sa akin na espesyal na gawain?
Dialogue: 0,0:58:03.23,0:58:05.50,Default,,0,0,0,,Hindi ko ito tatawaging isang espesyal na gawain.
Dialogue: 0,0:58:07.94,0:58:09.41,Default,,0,0,0,,Nga pala.
Dialogue: 0,0:58:09.74,0:58:13.18,Default,,0,0,0,,Pumupunta ka sa palasyo araw-araw, ngunit wala kang ginagawa.
Dialogue: 0,0:58:13.18,0:58:15.28,Default,,0,0,0,,Anong ibig mong sabihin wala akong ginagawa?
Dialogue: 0,0:58:15.28,0:58:17.21,Default,,0,0,0,,At hindi sapat ang isang buong araw,
Dialogue: 0,0:58:17.21,0:58:19.12,Default,,0,0,0,,para lang batiin ang lahat.
Dialogue: 0,0:58:22.55,0:58:25.16,Default,,0,0,0,,Ang gawaing ito ay perpekto para sa iyo.
Dialogue: 0,0:58:25.52,0:58:27.42,Default,,0,0,0,,Itong espesyal na gawain.
Dialogue: 0,0:58:27.86,0:58:29.63,Default,,0,0,0,,Sa wakas.
Dialogue: 0,0:58:47.51,0:58:51.31,Default,,0,0,0,,(Social distancing)
Dialogue: 0,0:58:54.89,0:58:57.32,Default,,0,0,0,,(Social distancing)
Dialogue: 0,0:59:00.66,0:59:02.09,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:59:02.09,0:59:04.29,Default,,0,0,0,,Dumating na si Prince Yeonpyeong.
Dialogue: 0,0:59:04.29,0:59:05.70,Default,,0,0,0,,Oo.
Dialogue: 0,0:59:10.23,0:59:13.64,Default,,0,0,0,,Alam mo ba kung ano ang ibig sabihin nito?
Dialogue: 0,0:59:13.94,0:59:15.37,Default,,0,0,0,,Excuse me?
Dialogue: 0,0:59:15.94,0:59:17.81,Default,,0,0,0,,Halika at tingnan.
Dialogue: 0,0:59:22.21,0:59:23.55,Default,,0,0,0,,Social distancing?
Dialogue: 0,0:59:23.55,0:59:27.28,Default,,0,0,0,,Ayon sa reyna, ang ibig sabihin nito ay "We will live happily."
Dialogue: 0,0:59:27.28,0:59:29.95,Default,,0,0,0,,Ngunit saan nagmula ang mga salita?
Dialogue: 0,0:59:32.69,0:59:34.89,Default,,0,0,0,,Hindi narinig.
Dialogue: 0,0:59:36.93,0:59:39.83,Default,,0,0,0,,O baka mula sa mga Buddhist na kasulatan?
Dialogue: 0,0:59:49.34,0:59:52.28,Default,,0,0,0,,Kumain ako ng tsaa kasama ang aking kapatid.
Dialogue: 0,0:59:52.61,0:59:54.95,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,1:00:04.42,1:00:06.66,Default,,0,0,0,,Naiisip ko tuloy ang sinabi ng reyna,
Dialogue: 0,1:00:06.66,1:00:10.26,Default,,0,0,0,,dahil ang ilan sa kanyang magagandang salita\N ay maaaring may ilang kahulugan.
Dialogue: 0,1:00:10.36,1:00:11.86,Default,,0,0,0,,Oo.
Dialogue: 0,1:00:14.70,1:00:16.40,Default,,0,0,0,,Ito ang hiniling mo.
Dialogue: 0,1:00:17.94,1:00:19.64,Default,,0,0,0,,Magaling.
Dialogue: 0,1:00:21.57,1:00:23.17,Default,,0,0,0,, Mangyayari ba ito ngayon?
Dialogue: 0,1:00:23.27,1:00:25.31,Default,,0,0,0,,Ang mas mabilis mas maganda.
Dialogue: 0,1:00:27.51,1:00:28.98,Default,,0,0,0,,Tama.
Dialogue: 0,1:00:30.08,1:00:32.05,Default,,0,0,0,,Bigyan mo pa ako ng clay.
Dialogue: 0,1:00:32.85,1:00:34.25,Default,,0,0,0,,Oo.
Dialogue: 0,1:00:37.32,1:00:39.56,Default,,0,0,0,,Ito ang order mo,
Dialogue: 0,1:00:39.56,1:00:41.39,Default,,0,0,0,,pero kung masira mo ang oven...
Dialogue: 0,1:00:41.39,1:00:44.16,Default,,0,0,0,,Huwag ko itong sirain. Ito ay isang pag-upgrade.
Dialogue: 0,1:00:44.83,1:00:46.90,Default,,0,0,0,,Nakakabaliw na babae.
Dialogue: 0,1:00:54.37,1:00:58.31,Default,,0,0,0,,Hoy, lokong tao, ano itong maliliit na bato!
Dialogue: 0,1:00:59.01,1:01:00.61,Default,,0,0,0,,Ano? mahirap?
Dialogue: 0,1:01:00.91,1:01:03.28,Default,,0,0,0,,Tulungan mo ako. Ang isang ito ay perpekto.
Dialogue: 0,1:01:03.28,1:01:04.38,Default,,0,0,0,,Masyadong malaki.
Dialogue: 0,1:01:04.38,1:01:06.02,Default,,0,0,0,,Bakit mo ito inilagay?
Dialogue: 0,1:01:06.02,1:01:08.45,Default,,0,0,0,,-Kamahalan!\N-Oil, o ano?
Dialogue: 0,1:01:08.45,1:01:11.52,Default,,0,0,0,,Oo. Tulad ng iniutos mo, dinala ko ang lahat ng mga varieties - rapeseed, sesame, peril
Dialogue: 0,1:01:11.52,1:01:13.49,Default,,0,0,0,,at sa pangkalahatan lahat ng nahanap ko.
Dialogue: 0,1:01:13.49,1:01:15.46,Default,,0,0,0,,Magaling.
Dialogue: 0,1:01:20.43,1:01:22.23,Default,,0,0,0,,Ang ganda!
Dialogue: 0,1:01:22.23,1:01:25.27,Default,,0,0,0,,Kamahalan. Ito ang aming taunang supply ng langis.
Dialogue: 0,1:01:25.57,1:01:27.64,Default,,0,0,0,,Ang pagluluto ay 80% na sangkap.
Dialogue: 0,1:01:27.64,1:01:29.54,Default,,0,0,0,,Depende sa pagkaing ito ang kapalaran ko.
Dialogue: 0,1:01:30.64,1:01:31.71,Default,,0,0,0,,Kamahalan.
Dialogue: 0,1:01:31.71,1:01:34.81,Default,,0,0,0,,Matagal nang nagpapahinga ang Kanyang Kamahalan.
Dialogue: 0,1:01:34.81,1:01:36.78,Default,,0,0,0,,Sabihin mo, may utang akong bata dito.
Dialogue: 0,1:01:36.78,1:01:39.52,Default,,0,0,0,,Hindi, hindi. Ibinuhos ko lahat, lahat.
Dialogue: 0,1:01:58.20,1:02:01.17,Default,,0,0,0,,Paano mo madadala sa kanya ang lahat ng aming mahalagang regalo?
Dialogue: 0,1:02:01.17,1:02:04.11,Default,,0,0,0,,Oo, nakahiga na ako sa lupa kung hindi ko ito dinala.
Dialogue: 0,1:02:04.44,1:02:06.71,Default,,0,0,0,,Nagbabanta kami, lalo pa nila kaming kakaladkarin.
Dialogue: 0,1:02:06.71,1:02:08.48,Default,,0,0,0,,Bakit ka nanginginig?
Dialogue: 0,1:02:13.95,1:02:16.82,Default,,0,0,0,,Hindi man lang tumitimbang. Ano ang kanyang gagawin?
Dialogue: 0,1:02:21.26,1:02:24.86,Default,,0,0,0,,Mga ganoong mahalagang sangkap.
Dialogue: 0,1:02:30.47,1:02:33.67,Default,,0,0,0,,Okay, tapos na. Mahusay.
Dialogue: 0,1:02:36.84,1:02:39.21,Default,,0,0,0,,Magaling.
Dialogue: 0,1:02:39.21,1:02:41.01,Default,,0,0,0,,-Kunin mo ito. \N-Oo.
Dialogue: 0,1:02:41.01,1:02:43.18,Default,,0,0,0,,-Ilagay mo diyan.\N-Ano?
Dialogue: 0,1:02:43.18,1:02:45.55,Default,,0,0,0,,-Sabi ko, idikit mo diyan.\N -Oo, Kamahalan.
Dialogue: 0,1:02:55.49,1:02:57.13,Default,,0,0,0,,Tapos na.
Dialogue: 0,1:02:57.96,1:03:01.33,Default,,0,0,0,,Pinakamataas na kalidad croaker - \Nand itinapon lang ito sa apoy.
Dialogue: 0,1:03:01.33,1:03:04.50,Default,,0,0,0,,Anong klaseng quirks.
Dialogue: 0,1:03:22.35,1:03:25.29,Default,,0,0,0,,Kamahalan, humihingi ako ng paumanhin kung lumampas ako sa mga hangganan,
Dialogue: 0,1:03:25.29,1:03:27.96,Default,,0,0,0,,ngunit ang Her Majesty ay nasa royal kitchen
Dialogue: 0,1:03:27.96,1:03:31.36,Default,,0,0,0,,sinusubaybayan ang paghahanda ng pagkain para sa dowager queen.
Dialogue: 0,1:03:31.83,1:03:35.10,Default,,0,0,0,,Naiintindihan ko. maghihintay ako.
Dialogue: 0,1:03:35.40,1:03:37.57,Default,,0,0,0,,Paumanhin.
Dialogue: 0,1:03:49.65,1:03:52.25,Default,,0,0,0,,Iniiwasan niya ako.
Dialogue: 0,1:04:30.02,1:04:31.22,Default,,0,0,0,,Okay ka lang?
Dialogue: 0,1:04:31.22,1:04:33.49,Default,,0,0,0,,Damn, nahimatay ako sa hindi malamang dahilan.
Dialogue: 0,1:04:39.70,1:04:42.20,Default,,0,0,0,,Sa iyo nakasalalay ang kapalaran ko.
Dialogue: 0,1:04:57.78,1:04:59.85,Default,,0,0,0,,Susunog ito.
Dialogue: 0,1:05:13.23,1:05:14.70,Default,,0,0,0,,Sabihin mo sa kanya.
Dialogue: 0,1:05:17.50,1:05:21.47,Default,,0,0,0,,Sabi ko sayo hindi ko kailangan ng almusal.
Dialogue: 0,1:05:22.64,1:05:26.61,Default,,0,0,0,,Inihanda ito mismo ng Reyna.
Dialogue: 0,1:05:30.48,1:05:33.92,Default,,0,0,0,,-Naghanda na ba ang Reyna?\N-Oo, Kamahalan.
Dialogue: 0,1:05:34.32,1:05:38.32,Default,,0,0,0,,Gumugol ako buong gabi dito.
Dialogue: 0,1:05:38.32,1:05:40.59,Default,,0,0,0,,I appreciate the effort,
Dialogue: 0,1:05:43.56,1:05:46.43,Default,,0,0,0,,ngunit saan ito gawa?
Dialogue: 0,1:05:46.43,1:05:48.50,Default,,0,0,0,,Mukhang iba.
Dialogue: 0,1:05:48.80,1:05:50.90,Default,,0,0,0,,Nagluto siya mula sa karne ng baka, baboy
Dialogue: 0,1:05:50.90,1:05:55.37,Default,,0,0,0,,at croaker - magkakasama.
Dialogue: 0,1:05:55.74,1:05:59.51,Default,,0,0,0,,Mas parang pagbuburda kaysa pagkain.
Dialogue: 0,1:06:01.21,1:06:03.48,Default,,0,0,0,,Wala talaga akong gana,
Dialogue: 0,1:06:03.48,1:06:06.85,Default,,0,0,0,,pero sabi mo nagpalipas siya buong gabi.
Dialogue: 0,1:06:06.85,1:06:09.12,Default,,0,0,0,,Nagpapasalamat ako, kaya susubukan ko ang isang piraso.
Dialogue: 0,1:06:36.18,1:06:38.05,Default,,0,0,0,,Wala pa ring balita?
Dialogue: 0,1:06:38.75,1:06:40.25,Default,,0,0,0,,Oo.
Dialogue: 0,1:06:45.12,1:06:47.19,Default,,0,0,0,,Hindi ito gagana. Ako na mismo ang pupunta.
Dialogue: 0,1:06:47.19,1:06:50.36,Default,,0,0,0,,Dumating na ang Dowager Queen.
Dialogue: 0,1:07:05.24,1:07:08.81,Default,,0,0,0,,-Victory?\N-Paano mo?
Dialogue: 0,1:07:11.48,1:07:12.95,Default,,0,0,0,, Fiasco?
Dialogue: 0,1:07:15.52,1:07:18.72,Default,,0,0,0,,Bakit mo itinago ang ganoong talento?
Dialogue: 0,1:07:18.89,1:07:20.29,Default,,0,0,0,,Ano?
Dialogue: 0,1:07:21.49,1:07:25.16,Default,,0,0,0,,Hindi ko nga alam kung gaano na ako katagal na nag-enjoy sa pagkain.
Dialogue: 0,1:07:25.16,1:07:27.40,Default,,0,0,0,,Nasasabik ako sa pagkain,
Dialogue: 0,1:07:27.40,1:07:29.63,Default,,0,0,0,,na galit talaga ako!
Dialogue: 0,1:07:30.67,1:07:32.50,Default,,0,0,0,,Triumph.
Dialogue: 0,1:07:34.17,1:07:37.31,Default,,0,0,0,,Natutuwa akong nagustuhan mo ito.
Dialogue: 0,1:07:37.44,1:07:39.81,Default,,0,0,0,,Siyempre nagustuhan ko.
Dialogue: 0,1:07:39.81,1:07:42.88,Default,,0,0,0,,Parang makakain ako nito araw-araw.
Dialogue: 0,1:07:43.05,1:07:44.98,Default,,0,0,0,,Paano mo ito inihanda?
Dialogue: 0,1:07:44.98,1:07:47.95,Default,,0,0,0,,Hindi ko pa nasusubukan ang ganitong pinong texture dati,
Dialogue: 0,1:07:47.95,1:07:50.52,Default,,0,0,0,,ang sarap ng lasa.
Dialogue: 0,1:07:51.82,1:07:57.70,Default,,0,0,0,,Nagluto ako sa mantika sa napakababang init buong gabi.
Dialogue: 0,1:07:59.43,1:08:01.73,Default,,0,0,0,,Inilagay ko ang isda sa langis sa mga uling sa oven,
Dialogue: 0,1:08:01.73,1:08:03.30,Default,,0,0,0,,upang mabagal magluto buong gabi.
Dialogue: 0,1:08:03.30,1:08:07.27,Default,,0,0,0,,Gusto kong malutong ang crust at malambot ang karne.
Dialogue: 0,1:08:07.37,1:08:10.61,Default,,0,0,0,,Para gumanda ang pagnguya ng karne,\N Nilagay ko ito sa isang kaldero na may mantika
Dialogue: 0,1:08:10.61,1:08:13.81,Default,,0,0,0,,at niluto sa mahinang apoy magdamag.
Dialogue: 0,1:08:14.88,1:08:18.38,Default,,0,0,0,,Pinapanatili ng paraang ito ang mga sustansya ng pagkain at ang amoy nito.
Dialogue: 0,1:08:18.45,1:08:21.85,Default,,0,0,0,,Mabuti rin ito para sa kalusugan at\Nnakakatulong laban sa pagtanda.
Dialogue: 0,1:08:21.85,1:08:23.29,Default,,0,0,0,,Napakalusog na pagkain.
Dialogue: 0,1:08:23.29,1:08:27.99,Default,,0,0,0,,Tinatawag itong confit -\N isang French cooking technique.
Dialogue: 0,1:08:27.99,1:08:30.96,Default,,0,0,0,,Hindi lang masarap, kundi malusog din?
Dialogue: 0,1:08:32.56,1:08:35.73,Default,,0,0,0,,Saan mo natutunan ang paraang ito?
Dialogue: 0,1:08:36.70,1:08:38.67,Default,,0,0,0,,Marahil ito ay isang insight?
Dialogue: 0,1:08:38.67,1:08:41.94,Default,,0,0,0,,Kung tutuusin, iniisip ko kung paano pasayahin ang Iyong Kamahalan,
Dialogue: 0,1:08:41.94,1:08:44.74,Default,,0,0,0,, napakaraming araw na.
Dialogue: 0,1:08:47.38,1:08:50.38,Default,,0,0,0,,Nakakakamatay na suntok.
Dialogue: 0,1:08:50.38,1:08:52.55,Default,,0,0,0,,Tutulungan kita araw-araw.
Dialogue: 0,1:08:52.95,1:08:54.52,Default,,0,0,0,,Hanggang sa katapusan ng mga araw
Dialogue: 0,1:08:54.75,1:08:56.15,Default,,0,0,0,,magiging bata ka
Dialogue: 0,1:08:56.69,1:08:58.59,Default,,0,0,0,,at malusog.
Dialogue: 0,1:09:07.03,1:09:11.30,Default,,0,0,0,,Pinapayagan kong mapuno ng tubig ang lawa.
Dialogue: 0,1:09:31.59,1:09:33.26,Default,pinya,0,0,0,,Pupunan mo ito ng ganito hanggang sa pagbagsak ng Joseon.
Dialogue: 0,1:09:33.26,1:09:36.09,Default,pineapple,0,0,0,,Kailangan natin ng sampung araw, hindi bababa.
Dialogue: 0,1:09:36.53,1:09:38.73,Default,pinya,0,0,0,,Ano? Upang sa isang minuto ay magkakaroon ng tubig
Dialogue: 0,1:09:38.73,1:09:41.00,Default,pinya,0,0,0,,o buburahin ko ang ulo mo!
Dialogue: 0,1:09:41.03,1:09:44.10,Default,pinya,0,0,0,,Mas mabilis, mas mabilis!
Dialogue: 0,1:09:48.24,1:09:52.44,Default,pineapple,0,0,0,,Ngayon kailangan natin ng dalawa pang araw.
Dialogue: 0,1:09:53.18,1:09:54.81,Default,pinya,0,0,0,,Tumigil, huwag gumalaw!
Dialogue: 0,1:09:57.75,1:10:00.35,Default,pineapple,0,0,0,,May naisip ako.
Dialogue: 0,1:10:00.45,1:10:03.59,Default,pinya,0,0,0,,Agos ang tubig na nagbibigay-buhay!
Dialogue: 0,1:10:04.29,1:10:06.19,Default,pineapple,0,0,0,,-Hold it.\N-Salamat.
Dialogue: 0,1:10:06.19,1:10:08.69,Default,pinya,0,0,0,,Agos ang tubig na nagbibigay buhay!
Dialogue: 0,1:10:09.39,1:10:12.43,Default,pineapple,0,0,0,,Sino ang nakakaalam na magiging mas mabilis ang mga bagay sa ganitong paraan?
Dialogue: 0,1:10:12.43,1:10:14.80,Default,pinya,0,0,0,,Magaling! Ganun lang!
Dialogue: 0,1:10:15.33,1:10:17.87,Default,pinya,0,0,0,,-Kunin mo agad.\N-Hawakan mo.
Dialogue: 0,1:10:27.21,1:10:30.08,Default,pineapple,0,0,0,,Oo, hindi ako reyna, ngunit isang henyo ng lokal na kaisipan.
Dialogue: 0,1:10:30.08,1:10:31.75,Default,pineapple,0,0,0,,Magaling. Mga dakilang kasama.
Dialogue: 0,1:10:31.75,1:10:35.05,Default,pinya,0,0,0,,Hanggang sa mapuno mo ang lawa, kalimutan ang tungkol sa pagtulog.
Dialogue: 0,1:10:35.05,1:10:36.52,Default,pinya,0,0,0,,-Sumunod!\N-Sumunod!
Dialogue: 0,1:10:55.17,1:10:56.91,Default,pinya,0,0,0,,Honyeon, kung ganoon?
Dialogue: 0,1:10:57.51,1:11:00.58,Default,pinya,0,0,0,,Kung nagpe-peke siya,
Dialogue: 0,1:11:00.68,1:11:05.68,Default,pineapple,0,0,0,,at tiyak na hindi nito ako magagawang lokohin.
Dialogue: 0,1:11:19.73,1:11:22.10,Default,pinya,0,0,0,,Bihira talaga ang tela,
Dialogue: 0,1:11:22.10,1:11:26.00,Default,pineapple,0,0,0,,Hindi ko masabi sa iyo kung saan ito hinabi.
Dialogue: 0,1:11:31.41,1:11:33.51,Default,pinya,0,0,0,,Pero kaya ko
Dialogue: 0,1:11:34.18,1:11:36.88,Default,pineapple,0,0,0,,subukang alamin.
Dialogue: 0,1:11:37.58,1:11:41.75,Default,pinya,0,0,0,,Hindi ka maaaring sumuko nang hindi sinusubukan, hindi ka ba sumasang-ayon?
Dialogue: 0,1:11:41.75,1:11:43.89,Default,pineapple,0,0,0,,Gusto ko ang diskarte mo.
Dialogue: 0,1:11:47.66,1:11:51.56,Default,pinya,0,0,0,,Nag-alala ako na walang pakialam ang hari sa reyna,
Dialogue: 0,1:11:51.56,1:11:54.40,Default,pineapple,0,0,0,,pero parang natapos na lahat ng alalahanin ko.
Dialogue: 0,1:11:56.30,1:11:58.10,Default,pinya,0,0,0,,Ano pa ang masasabi mo sa akin?
Dialogue: 0,1:11:58.70,1:12:01.87,Default,pinya,0,0,0,,Kagabi, habang ang reyna
Dialogue: 0,1:12:01.87,1:12:04.24,Default,pinya,0,0,0,,nasa kusina ng palasyo,
Dialogue: 0,1:12:04.24,1:12:06.61,Default,pinya,0,0,0,,nag-iisa siyang hinihintay ng hari
Dialogue: 0,1:12:06.61,1:12:09.88,Default,pineapple,0,0,0,,sa Daejojeon Hall.
Dialogue: 0,1:12:10.05,1:12:14.32,Default,pinya,0,0,0,,Pinayuhan ko ang hari na pumunta sa Hwijojong Hall,\Nngunit sinabi niya na hindi siya pupunta kahit saan.
Dialogue: 0,1:12:15.45,1:12:20.46,Default,pinya,0,0,0,,Hindi ako makapaniwala, nag-aalala ang hari natin sa asawa niya!
Dialogue: 0,1:12:20.56,1:12:23.66,Default,pineapple,0,0,0,,Got it, you can go.
Dialogue: 0,1:12:24.76,1:12:26.23,Default,pineapple,0,0,0,,Okay.
Dialogue: 0,1:12:30.50,1:12:32.10,Default,pinya,0,0,0,,Hayaan silang magpalipas ng gabing magkasama nang mas madalas,
Dialogue: 0,1:12:32.10,1:12:34.17,Default,pineapple,0,0,0,,kaya mas mabilis na sumiklab ang damdamin sa pagitan nila.
Dialogue: 0,1:12:34.87,1:12:37.91,Default,pinya,0,0,0,,Ibinigay sa akin ng Reyna ang kanyang maharlikang salita.
Dialogue: 0,1:12:38.21,1:12:39.51,Default,pinya,0,0,0,,Naibigay mo na ba ang sahig?
Dialogue: 0,1:12:39.51,1:12:42.38,Default,pinya,0,0,0,,Nangako siyang maglilihi ng prinsipe.
Dialogue: 0,1:12:42.38,1:12:43.78,Default,pinya,0,0,0,,Ano ang pinagsasabi mo!
Dialogue: 0,1:12:43.78,1:12:45.58,Default,pinya,0,0,0,,Tapos sa pamilya namin
Dialogue: 0,1:12:45.58,1:12:48.22,Default,pinya,0,0,0,,ipanganak ba ang isang dugong tagapagmana ng trono?
Dialogue: 0,1:12:50.92,1:12:52.62,Default,pinya,0,0,0,,Ano ito?
Dialogue: 0,1:12:53.26,1:12:54.69,Default,pinya,0,0,0,,Eksakto,
Dialogue: 0,1:12:55.76,1:12:57.26,Default,pineapple,0,0,0,,look.
Dialogue: 0,1:12:57.33,1:13:01.03,Default,pinya,0,0,0,,Kainin mo ito, at ang iyong balat ay magiging parang sanggol.
Dialogue: 0,1:13:01.33,1:13:03.57,Default,pinya,0,0,0,,Mamahaling regalo.
Dialogue: 0,1:13:04.60,1:13:06.07,Default,pinya,0,0,0,,Kung gusto mo ang aksyon nito,
Dialogue: 0,1:13:06.07,1:13:09.57,Default,pineapple,0,0,0,,Wala akong pagsisisihan, ngunit hahanapin pa kita.
Dialogue: 0,1:13:10.31,1:13:11.84,Default,pineapple,0,0,0,,Salamat.
Dialogue: 0,1:13:14.11,1:13:17.68,Default,pineapple,0,0,0,,Hindi pa rin ako makapaniwala\Nna ang lahat ay naging napakahusay.
Dialogue: 0,1:13:17.68,1:13:21.02,Default,pinya,0,0,0,,Nang mahulog ang reyna sa lawa,
Dialogue: 0,1:13:21.02,1:13:23.49,Default,pinya,0,0,0,,halos mabaliw ako sa kilig!
Dialogue: 0,1:13:24.09,1:13:25.62,Default,pinya,0,0,0,,Kaawa-awa, inosenteng bata.
Dialogue: 0,1:13:25.62,1:13:29.09,Default,pineapple,0,0,0,,I'm so proud that she was able\Nto maintain her high position.
Dialogue: 0,1:13:29.83,1:13:32.46,Default,pinya,0,0,0,,Luha ng kaligayahan.
Dialogue: 0,1:13:33.10,1:13:35.00,Default,pinya,0,0,0,,Sabihin mo na lang.
Dialogue: 0,1:13:35.00,1:13:37.30,Default,pinya,0,0,0,,I'll be honest, hindi naman inosenteng bata ang reyna.
Dialogue: 0,1:13:37.30,1:13:40.47,Default,pinya,0,0,0,,Ang aming reyna...\NHPaano ko ito masasabi ng mas tama?
Dialogue: 0,1:13:42.34,1:13:43.84,Default,pinya,0,0,0,,Smart?
Dialogue: 0,1:13:44.81,1:13:46.41,Default,pineapple,0,0,0,,Merong maling salita.
Dialogue: 0,1:13:47.11,1:13:50.08,Default,pineapple,0,0,0,,-Scrupulous?\N-Hindi iyon.
Dialogue: 0,1:13:50.15,1:13:52.98,Default,pinya,0,0,0,,May perpektong salita.
Dialogue: 0,1:13:53.45,1:13:55.95,Default,pinya,0,0,0,,-Tapos...\N-Sopistikado?
Dialogue: 0,1:13:56.12,1:13:57.62,Default,pinya,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,1:14:00.76,1:14:02.29,Default,pinya,0,0,0,,Natatangi?
Dialogue: 0,1:14:02.46,1:14:05.63,Default,pinya,0,0,0,,Eksakto! Natatanging babae.
Dialogue: 0,1:14:05.63,1:14:08.03,Default,pinya,0,0,0,,Wala kaming mahanap na mas mabuting reyna!
Dialogue: 0,1:14:08.03,1:14:09.70,Default,pinya,0,0,0,,Sakto, eksakto!
Dialogue: 0,1:14:09.77,1:14:14.04,Default,pinya,0,0,0,,Tumingin ako sa kanya at nakikita kita sa iyong kabataan!
Dialogue: 0,1:14:14.24,1:14:15.87,Default,pinya,0,0,0,,Anong kalokohan!
Dialogue: 0,1:14:23.45,1:14:24.78,Default,pinya,0,0,0,,Nabaliw ka na ba?
Dialogue: 0,1:14:24.78,1:14:27.72,Default,pineapple,0,0,0,,Nakita mo ba ito ng sarili mong mga mata?\NGamit ang mga ito?
Dialogue: 0,1:14:27.72,1:14:30.32,Default,pinya,0,0,0,,Kahit sino man sa palasyo ang personal na nakakita nito,
Dialogue: 0,1:14:30.32,1:14:32.22,Default,pinya,0,0,0,,para itulak ng concubine ang reyna?
Dialogue: 0,1:14:33.09,1:14:35.49,Default,pinya,0,0,0,, Worth it ba ito?\NEng ​​lahat ay alam na niya ito!
Dialogue: 0,1:14:35.49,1:14:37.16,Default,pineapple,0,0,0,,-Exactly!\N-Tama siya.
Dialogue: 0,1:14:37.16,1:14:38.26,Default,pineapple,0,0,0,,Oo, alam ng lahat ang tungkol dito.
Dialogue: 0,1:14:38.26,1:14:42.13,Default,pineapple,0,0,0,,Gaya ng sabi nila, nasusunog ang takip ng magnanakaw.
Dialogue: 0,1:14:42.63,1:14:44.40,Default,pineapple,0,0,0,,Hindi nagmula ang mga tsismis na ito.
Dialogue: 0,1:14:49.94,1:14:51.41,Default,pinya,0,0,0,,How dare you!
Dialogue: 0,1:14:51.41,1:14:54.48,Default,pinya,0,0,0,,Humanda! Bukas ng umaga may bali-balita na isa kang kalbong tanga!
Dialogue: 0,1:14:54.48,1:14:55.78,Default,pinya,0,0,0,,Bastos ka!
Dialogue: 0,1:14:55.78,1:14:57.65,Default,pinya,0,0,0,,Bitawan mo ako! Ngayon na!
Dialogue: 0,1:14:57.65,1:14:59.28,Default,pinya,0,0,0,,Bitawan mo ako!
Dialogue: 0,1:14:59.75,1:15:01.95,Default,pinya,0,0,0,,Itinakda siya ng Reyna!
Dialogue: 0,1:15:01.95,1:15:03.62,Default,pinya,0,0,0,,Nang dumaan ang aking ginang,
Dialogue: 0,1:15:03.62,1:15:05.89,Default,pinya,0,0,0,,kusa namang tumalon ang reyna sa tubig!
Dialogue: 0,1:15:05.89,1:15:08.06,Default,pinya,0,0,0,,Bago ka magchat, alamin ang totoo!
Dialogue: 0,1:15:24.51,1:15:26.61,Default,pinya,0,0,0,,Ngayon siguradong...
Dialogue: 0,1:15:52.17,1:15:55.97,Default,pinya,0,0,0,,Kamahalan, akala ko'y sanayin mo ang iyong pagsusulat.
Dialogue: 0,1:15:56.14,1:15:57.91,Default,pinya,0,0,0,,Nang pumunta ako kay Yejan,
Dialogue: 0,1:15:57.91,1:16:00.51,Default,pinya,0,0,0,,para maglaro ng tudjon kasama si Mr. Hong,
Dialogue: 0,1:16:00.51,1:16:02.98,Default,pineapple,0,0,0,,May nakita akong nagulat sa akin.
Dialogue: 0,1:16:05.78,1:16:10.12,Default,pinya,0,0,0,,May mula sa malayo\Nnaghagis ng punyal sa target.
Dialogue: 0,1:16:12.69,1:16:15.29,Default,pineapple,0,0,0,,Naisip ko bakit hindi subukan.
Dialogue: 0,1:16:16.56,1:16:18.26,Default,pinya,0,0,0,,Ito ay lubhang mapanganib,
Dialogue: 0,1:16:18.26,1:16:20.43,Default,pinya,0,0,0,,paano kung masaktan ka?
Dialogue: 0,1:16:28.47,1:16:31.24,Default,pinya,0,0,0,,Gaano na ba tayo katagal magkakilala?
Dialogue: 0,1:16:33.51,1:16:36.41,Default,pinya,0,0,0,,Dalawang taon, ginoo.
Dialogue: 0,1:16:39.95,1:16:41.35,Default,pineapple,0,0,0,,Ganyan yan.
Dialogue: 0,1:16:45.09,1:16:48.86,Default,pinya,0,0,0,,Sa panahong ito nalaman mo ang lahat sa mundo tungkol sa akin,
Dialogue: 0,1:16:48.86,1:16:50.63,Default,pinya,0,0,0,,naging mga braso at binti ko.
Dialogue: 0,1:16:50.63,1:16:53.63,Default,pineapple,0,0,0,,Para bang magkakilala tayo sa loob ng maraming taon.
Dialogue: 0,1:16:54.63,1:16:57.90,Default,pineapple,0,0,0,,Ginagawa ko lang ang trabaho ko.
Dialogue: 0,1:16:58.07,1:16:59.57,Default,pinya,0,0,0,,Ang trabaho mo?
Dialogue: 0,1:17:01.97,1:17:03.71,Default,pinya,0,0,0,,Baka ito ang trabaho mo,
Dialogue: 0,1:17:03.71,1:17:05.24,Default,pinya,0,0,0,,pero hindi ko maiwasang isipin
Dialogue: 0,1:17:05.24,1:17:08.11,Default,pinya,0,0,0,, devoted ka ba sa akin, dahil kailangan mong
Dialogue: 0,1:17:08.61,1:17:10.08,Default,pinya,0,0,0,,o
Dialogue: 0,1:17:11.08,1:17:14.15,Default,pinya,0,0,0,,dahil ikaw mismo ang gusto nito.
Dialogue: 0,1:17:15.75,1:17:17.99,Default,pinya,0,0,0,,Sigurado akong tapat ang iyong nararamdaman.
Dialogue: 0,1:17:19.99,1:17:22.96,Default,pinya,0,0,0,,Salamat sa pagpansin, sir!
Dialogue: 0,1:17:22.96,1:17:24.86,Default,pinya,0,0,0,,Naniniwala ka ba sa akin?
Dialogue: 0,1:17:25.36,1:17:28.63,Default,pinya,0,0,0,,Kung hindi para sa iyo, para kanino?
Dialogue: 0,1:17:36.04,1:17:37.71,Default,pineapple,0,0,0,,Akala ko mas madali.
Dialogue: 0,1:17:38.11,1:17:42.01,Default,pinya,0,0,0,,Pero pinagdudahan mo ba ako?
Dialogue: 0,1:17:44.68,1:17:47.22,Default,pinya,0,0,0,,Patawarin mo ako.
Dialogue: 0,1:17:47.22,1:17:49.92,Default,pinya,0,0,0,,Sa pagtanda mas naging duwag ako.
Dialogue: 0,1:17:51.62,1:17:54.39,Default,pineapple,0,0,0,,Maagang pupunta ang NI sa Daejojeon Hall.
Dialogue: 0,1:17:54.49,1:17:56.36,Default,pinya,0,0,0,,Ihahanda ko lahat.
Dialogue: 0,1:18:32.96,1:18:35.83,Default,pineapple,0,0,0,,Para makilala ka,\Nkailangan kaming pumunta ng maaga.
Dialogue: 0,1:18:37.20,1:18:39.27,Default,pinya,0,0,0,,Gaano ka kasipag, gayunpaman.
Dialogue: 0,1:18:39.27,1:18:41.17,Default,pineapple,0,0,0,,Sobrang effort para lang makatulog kami.
Dialogue: 0,1:18:41.17,1:18:43.81,Default,pineapple,0,0,0,,Naghanda kami ng mga inumin at meryenda.
Dialogue: 0,1:18:44.94,1:18:46.11,Default,pinya,0,0,0,,Bakit kailangan pa ito?
Dialogue: 0,1:18:46.11,1:18:48.11,Default,pinya,0,0,0,,Alam kong mahilig kang uminom,
Dialogue: 0,1:18:48.11,1:18:50.28,Default,pineapple,0,0,0,,kaya inutusan ko silang maghanda para sa iyo.
Dialogue: 0,1:18:50.35,1:18:51.98,Default,pineapple,0,0,0,,Tapos na ako dito.
Dialogue: 0,1:18:53.95,1:18:56.05,Default,pineapple,0,0,0,,Naisip ko rin ito.
Dialogue: 0,1:18:57.42,1:18:59.69,Default,pineapple,0,0,0,,Nagdala kami ng mga treat para sa tsaa.
Dialogue: 0,1:19:12.37,1:19:14.27,Default,pineapple,0,0,0,,Ito ay Arabic jasmine tea.
Dialogue: 0,1:19:15.27,1:19:17.74,Default,pinya,0,0,0,,Kung dumaranas ka ng insomnia o pagkabalisa,
Dialogue: 0,1:19:17.74,1:19:19.61,Default,pinya,0,0,0,,papatahimik ka nito.
Dialogue: 0,1:19:26.75,1:19:28.65,Default,pinya,0,0,0,,Jasmine Gull?
Dialogue: 0,1:19:28.82,1:19:31.09,Default,pinya,0,0,0,,Ang bango naman.
Dialogue: 0,1:19:40.63,1:19:44.10,Default,pineapple,0,0,0,,Nang gabing iyon ay amoy jasmine ang buong kwarto.
Dialogue: 0,1:19:48.97,1:19:52.91,Default,pineapple,0,0,0,,Babad pa sa manggas ang amoy.
Dialogue: 0,1:20:25.24,1:20:26.74,Default,pineapple,0,0,0,,Ikaw iyon.
Dialogue: 0,1:20:29.68,1:20:31.28,Default,pinya,0,0,0,,Ikaw pala...
Dialogue: 0,1:20:31.85,1:20:34.45,Default,pineapple,0,0,0,,Hindi mo dapat ibunyag ang lahat ng iyong card nang walang ingat.
Dialogue: 0,1:20:37.79,1:20:43.29,Default,pinya,0,0,0,,Lalo na sa palasyo, kung saan lahat ay may kanya-kanyang sikreto.
Dialogue: 0,1:20:55.24,1:20:56.64,Default,pinya,0,0,0,,Paano ako naging reyna
Dialogue: 0,1:20:56.64,1:20:57.64,Default,pinya,0,0,0,,
Dialogue: 0,1:20:57.64,1:20:59.21,Default,pinya,0,0,0,,
Dialogue: 0,1:21:16.49,1:21:18.96,Default,pinya,0,0,0,,Nahulog na ba talaga ako sa bitag ng kanyang mapanlinlang na mga mata at salita?
Dialogue: 0,1:21:18.96,1:21:20.73,Default,pineapple,0,0,0,,Pasabihin sa kanya ang lahat.
Dialogue: 0,1:21:20.73,1:21:22.90,Default,pineapple,0,0,0,,-Sino ang nagpadala ng sulat?\N-The Dowager Queen.
Dialogue: 0,1:21:22.90,1:21:24.47,Default,pinya,0,0,0,,Hanggang sa mapuno ng tubig ang lawa.
Dialogue: 0,1:21:24.47,1:21:26.87,Default,pinya,0,0,0,,titiisin ko ang lahat ng ito, at pagkatapos ay uuwi ako.
Dialogue: 0,1:21:26.87,1:21:28.64,Default,pineapple,0,0,0,,Ang hinahanap namin ay isang court lady.
Dialogue: 0,1:21:28.64,1:21:31.54,Default,pinya,0,0,0,,Gawin ang lahat para hindi mahuli.
Dialogue: 0,1:21:31.54,1:21:34.01,Default,pineapple,0,0,0,,Nalaman ko kung saan nanggaling ang telang ito.
Dialogue: 0,1:21:34.01,1:21:35.28,Default,pinya,0,0,0,,Mula sa palasyo.
Dialogue: 0,1:21:35.28,1:21:37.25,Default,pineapple,0,0,0,,Ang kailangan mo ay isang maharlikang asawa, hindi ako.
Dialogue: 0,1:21:37.25,1:21:39.85,Default,pineapple,0,0,0,,Gusto mo bang ibalik ang lahat?\NIto ay paghihiganti.
Dialogue: 0,1:21:39.85,1:21:42.62,Default,pinya,0,0,0,,-Iyan ang ginawa ko sa iyo.\N-Sa tingin mo hindi ko kaya?
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


