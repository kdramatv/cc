Dialogue: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Zinger, Pineapple, Host, Marcus
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:04.02,pangalan,,0,0,0,,{\pos(112,666)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:03.92,0:01:06.29,Default,pinya,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.29,0:01:09.09,Default,pineapple,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:01:09.86,0:01:12.23,Default,pinya,0,0,0,,6 na episode
Dialogue: 0,0:01:12.23,0:01:13.86,Default,pineapple,0,0,0,,Eksakto.
Dialogue: 0,0:01:14.09,0:01:18.63,Default,pinya,0,0,0,,Sa seksyong taktika "Mga tala sa mga armas at kagamitan"
Dialogue: 0,0:01:18.63,0:01:21.20,Default,pinya,0,0,0,,sinasabi kung mas kaunti ang mga kaalyado kaysa sa mga kaaway,
Dialogue: 0,0:01:21.20,0:01:23.27,Default,pineapple,0,0,0,,kailangan nating umatras.
Dialogue: 0,0:01:23.27,0:01:27.77,Default,pinya,0,0,0,,Kung hindi mo kayang ipagtanggol, umatras at...
Dialogue: 0,0:01:28.78,0:01:31.01,Default,pinya,0,0,0,,Kakaibang babae.
Dialogue: 0,0:01:32.05,0:01:34.11,Default,pinya,0,0,0,,Kamahalan, hindi ka maniniwala.
Dialogue: 0,0:01:34.11,0:01:36.62,Default,pineapple,0,0,0,,Gumawa nang hindi karaniwan.
Dialogue: 0,0:01:38.75,0:01:41.99,Default,pinya,0,0,0,,Gaano katagal ka makakasayaw sa sinaunang musika ng iyong mga ninuno?
Dialogue: 0,0:01:41.99,0:01:43.62,Default,pinya,0,0,0,,I
Dialogue: 0,0:01:44.56,0:01:47.26,Default,pineapple,0,0,0,,served in special forces.
Dialogue: 0,0:01:47.86,0:01:50.30,Default,pineapple,0,0,0,,-Napakamayabang niyang magsalita.\N-Atake.
Dialogue: 0,0:01:50.30,0:01:51.97,Default,pineapple,0,0,0,,At malamang na iniisip mo ang iyong sarili bilang isang hari.
Dialogue: 0,0:01:51.97,0:01:53.87,Default,pinya,0,0,0,,Ako ang hari.
Dialogue: 0,0:01:56.24,0:01:57.91,Default,pineapple,0,0,0,,Salamat.
Dialogue: 0,0:01:57.91,0:02:00.87,Default,pinya,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:02:04.75,0:02:07.01,Default,pineapple,0,0,0,,Kalimutan mo na, wala akong pakialam.
Dialogue: 0,0:02:07.08,0:02:09.08,Default,pineapple,0,0,0,,Bumaba ka.
Dialogue: 0,0:02:09.08,0:02:11.85,Default,pineapple,0,0,0,,At kumikilos na parang baliw.
Dialogue: 0,0:02:19.96,0:02:22.90,Default,pinya,0,0,0,,At minsan parang siya si Buddha.
Dialogue: 0,0:02:22.90,0:02:28.84,Default,pinya,0,0,0,,Pakiusap, huwag hawakan ang mga walang kasalanan sa anumang bagay.
Dialogue: 0,0:02:28.84,0:02:30.97,Default,pinya,0,0,0,,Pero galit siya na parang sinapian siya ng masasamang espiritu.
Dialogue: 0,0:02:30.97,0:02:33.87,Default,pinya,0,0,0,,Magagalit ang sinuman sa lugar ko ngayon,
Dialogue: 0,0:02:33.87,0:02:35.21,Default,pinya,0,0,0,,kung hindi siya Buddha.
Dialogue: 0,0:02:35.21,0:02:37.71,Default,pinya,0,0,0,,Minsan siya ang mismong sagisag ng sangkatauhan,
Dialogue: 0,0:02:37.74,0:02:40.75,Default,pineapple,0,0,0,,at hindi ko maintindihan kung ano ang nasa\N ng isip ng misteryosong babaeng ito.
Dialogue: 0,0:02:41.65,0:02:44.95,Default,pineapple,0,0,0,,Nawala ang sandali. Walang kwenta ang magsabi ng kahit ano.
Dialogue: 0,0:02:45.19,0:02:47.39,Default,pinya,0,0,0,,Wala ba talagang kwenta?
Dialogue: 0,0:02:49.36,0:02:51.52,Default,pinya,0,0,0,,Mahirap ba akong ipaliwanag?
Dialogue: 0,0:02:53.69,0:02:56.83,Default,pineapple,0,0,0,,-Anong sinabi mo?\N-Hindi ka nakinig sa akin.
Dialogue: 0,0:02:56.83,0:02:58.80,Default,pinya,0,0,0,,Ano ang iniisip mo,
Dialogue: 0,0:02:58.80,0:03:01.50,Default,pinya,0,0,0,,nakalimutan mo na ba ang iyong paboritong libro?
Dialogue: 0,0:03:02.70,0:03:05.41,Default,pineapple,0,0,0,,Dapat ay tungkol kay Gng. Hwajin.
Dialogue: 0,0:03:06.31,0:03:08.01,Default,pineapple,0,0,0,,Hindi naman.
Dialogue: 0,0:03:08.68,0:03:09.91,Default,pineapple,0,0,0,,Hindi na kailangang magpanggap.
Dialogue: 0,0:03:09.91,0:03:14.82,Default,pineapple,0,0,0,,Malinaw sa iyong mga mata na iniisip mo ang babae.
Dialogue: 0,0:03:14.82,0:03:16.72,Default,pineapple,0,0,0,,Iniisip ko ang reyna.
Dialogue: 0,0:03:16.72,0:03:17.72,Default,pinya,0,0,0,,Ano?
Dialogue: 0,0:03:17.72,0:03:20.39,Default,pineapple,0,0,0,,Kaya itigil mo na ang kahihiyan\N sa iyong mga salita.
Dialogue: 0,0:03:20.82,0:03:22.96,Default,pinya,0,0,0,,Babae rin ang Reyna,
Dialogue: 0,0:03:22.96,0:03:25.73,Default,pineapple,0,0,0,,pero hindi ko siya naisip ng ganoon.
Dialogue: 0,0:03:26.49,0:03:28.33,Default,pinya,0,0,0,,Hindi mo mahulaan kung ano ang nasa isip niya,
Dialogue: 0,0:03:28.33,0:03:31.13,Default,pineapple,0,0,0,,hindi nakakagulat na interesado ka.
Dialogue: 0,0:03:33.10,0:03:35.60,Default,pinya,0,0,0,,Ang Reyna ang pinaka hindi pangkaraniwan at kakaibang tao
Dialogue: 0,0:03:35.60,0:03:38.87,Default,pineapple,0,0,0,,sa lahat ng kilala ko.
Dialogue: 0,0:03:39.54,0:03:43.44,Default,pinya,0,0,0,,Para bang hindi siya mula sa ating mundo.
Dialogue: 0,0:03:45.18,0:03:49.35,Default,pinya,0,0,0,,At pinakamahusay na naglalarawan sa ating reyna...
Dialogue: 0,0:03:50.28,0:03:52.32,Default,pineapple,0,0,0,,Pag-isipan ko.
Dialogue: 0,0:03:53.32,0:03:57.12,Default,pinya,0,0,0,,Isang salitang direktang nagsasabi\Nna ang isang tao ay hindi taga-mundo na ito.
Dialogue: 0,0:03:57.12,0:03:58.86,Default,pineapple,0,0,0,,Alien.
Dialogue: 0,0:03:59.06,0:04:01.33,Default,pineapple,0,0,0,,-Alien?\N-Oo.
Dialogue: 0,0:04:04.63,0:04:06.73,Default,pineapple,0,0,0,,Perpekto para sa kanya.
Dialogue: 0,0:04:08.14,0:04:09.84,Default,pineapple,0,0,0,,Alien.
Dialogue: 0,0:04:14.41,0:04:16.81,Default,pinya,0,0,0,,Tumigil na ba ang ulan?
Dialogue: 0,0:04:16.81,0:04:19.15,Default,pineapple,0,0,0,,Umuulan buong gabi.
Dialogue: 0,0:04:19.15,0:04:21.55,Default,pineapple,0,0,0,,Sana walang nasaktan.
Dialogue: 0,0:04:21.55,0:04:23.45,Default,pineapple,0,0,0,,Ako rin.
Dialogue: 0,0:04:23.82,0:04:25.85,Default,pineapple,0,0,0,,Hindi ako mapalagay.
Dialogue: 0,0:04:28.36,0:04:31.39,Default,pinya,0,0,0,,Hanggang kailan ka magsasalita nang kakaiba?
Dialogue: 0,0:04:31.39,0:04:34.33,Default,pineapple,0,0,0,,Ngayon lang. Ito na ang huling araw.
Dialogue: 0,0:04:34.33,0:04:39.53,Default,pinya,0,0,0,,At bukas ang lahat ay mahuhulog sa lugar! Ay oo!
Dialogue: 0,0:04:44.91,0:04:46.54,Default,pinya,0,0,0,,Hindi pwede!
Dialogue: 0,0:04:55.28,0:04:56.88,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,0:05:04.93,0:05:08.03,Default,pinya,0,0,0,,Buksan ang gate! utos ni King!
Dialogue: 0,0:05:08.06,0:05:10.26,Default,pinya,0,0,0,,-Buksan ang gate!\N-Buksan ang gate!
Dialogue: 0,0:05:32.29,0:05:34.89,Default,pinya,0,0,0,,Hindi dapat ako nakarating dito\NJang Bong-hwan
Dialogue: 0,0:07:10.68,0:07:11.75,Default,pinya,0,0,0,,Okay ka lang?
Dialogue: 0,0:07:11.75,0:07:13.42,Default,pinya,0,0,0,,Oh damn!
Dialogue: 0,0:07:13.55,0:07:14.62,Default,pinya,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:07:14.62,0:07:16.32,Default,pinya,0,0,0,,Kamakailan lang ay sinubukan niya akong patayin!
Dialogue: 0,0:07:16.32,0:07:18.13,Default,pinya,0,0,0,,Kailangan kong itanong sa iyo ang parehong bagay!
Dialogue: 0,0:07:18.13,0:07:20.26,Default,pinya,0,0,0,,Hindi ako makapaniwala\Nna sinubukan mong magpakamatay muli!
Dialogue: 0,0:07:20.26,0:07:22.00,Default,pinya,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:07:22.00,0:07:24.73,Default,pinya,0,0,0,,Ano bang pakialam mo kung buhay pa ako o hindi?
Dialogue: 0,0:07:24.73,0:07:27.13,Default,pinya,0,0,0,,Ayaw mo ba akong mamatay?
Dialogue: 0,0:07:30.14,0:07:33.24,Default,pinya,0,0,0,,Huwag mo akong abalahin! Lumabas ka!
Dialogue: 0,0:07:33.91,0:07:37.34,Default,pineapple,0,0,0,,Hindi pa huli para lutasin ang lahat ng hindi pagkakaunawaan.
Dialogue: 0,0:07:38.01,0:07:40.38,Default,pineapple,0,0,0,,Mamuhay tayo sa paraang gusto mo.
Dialogue: 0,0:07:41.48,0:07:43.12,Default,pineapple,0,0,0,,Social distancing.
Dialogue: 0,0:07:47.85,0:07:50.89,Default,pinya,0,0,0,,Tama! Social distancing.
Dialogue: 0,0:07:51.66,0:07:53.93,Default,pinya,0,0,0,,-Hindi pwede!\N-Umalis ka na!
Dialogue: 0,0:07:53.93,0:07:55.83,Default,pinya,0,0,0,,Anong ginagawa mo! Bitawan mo ako!
Dialogue: 0,0:07:55.83,0:07:57.50,Default,pinya,0,0,0,,Bastard!
Dialogue: 0,0:07:58.50,0:08:01.77,Default,pinya,0,0,0,,Sabi niya gusto mong dumistansya,\Nand sinusubukan mong mamatay?
Dialogue: 0,0:08:02.87,0:08:04.54,Default,pinya,0,0,0,,Hindi mo ba ako sinusubukang patayin?
Dialogue: 0,0:08:04.54,0:08:05.91,Default,pinya,0,0,0,,So bakit mo ako hinahawakan?
Dialogue: 0,0:08:05.91,0:08:07.74,Default,pineapple,0,0,0,,Naiintindihan ko kung bakit ka nagagalit.
Dialogue: 0,0:08:07.74,0:08:11.64,Default,pineapple,0,0,0,,Nakagawa ako ng malaking kasalanan at ngayon\Nin isang hindi nabayarang utang sa iyo.
Dialogue: 0,0:08:11.75,0:08:15.85,Default,pineapple,0,0,0,,Naiintindihan ko, parang excuse lang,\Npero nagkamali lang kami ng pagkakaintindihan.
Dialogue: 0,0:08:15.85,0:08:19.32,Default,pineapple,0,0,0,,Wala akong pakialam kung paano kami nagkaintindihan doon.
Dialogue: 0,0:08:19.32,0:08:21.05,Default,pineapple,0,0,0,,Pakinggan mo ako.
Dialogue: 0,0:08:21.05,0:08:23.56,Default,pinya,0,0,0,,Ayokong makinig sa pagbubuhos mo ng tubig sa tenga ko!
Dialogue: 0,0:08:23.69,0:08:25.79,Default,pinya,0,0,0,,-Labas!\N-Hindi pwede!
Dialogue: 0,0:08:25.93,0:08:27.49,Default,pinya,0,0,0,,Sumasang-ayon ako sa pagdistansya,
Dialogue: 0,0:08:27.49,0:08:29.96,Default,pinya,0,0,0,,Hinding-hindi kita iiwan!
Dialogue: 0,0:08:30.86,0:08:34.60,Default,pinya,0,0,0,,Naiintindihan mo ba kung ano ang ibig sabihin ng distancing?
Dialogue: 0,0:08:34.60,0:08:36.20,Default,pineapple,0,0,0,,Siyempre.
Dialogue: 0,0:08:37.04,0:08:40.17,Default,pineapple,0,0,0,,Naaalala ko lahat ng sinabi mo.
Dialogue: 0,0:08:40.71,0:08:42.34,Default,pineapple,0,0,0,,Social distancing.
Dialogue: 0,0:08:43.04,0:08:45.51,Default,pinya,0,0,0,,Mamuhay sa kapayapaan at pagkakaisa.
Dialogue: 0,0:08:46.51,0:08:48.95,Default,pinya,0,0,0,,Mabuhay, aking reyna.
Dialogue: 0,0:08:49.32,0:08:51.52,Default,pinya,0,0,0,,Ngunit nakalimutan mo ang pinakamahalagang bagay!
Dialogue: 0,0:08:51.52,0:08:52.69,Default,pinya,0,0,0,,Lahat para sa kanilang sarili!
Dialogue: 0,0:08:52.69,0:08:54.86,Default,pinya,0,0,0,,Mamuhay ayon sa gusto mo,\Nand ako ay mamumuhay sa sarili kong paraan!
Dialogue: 0,0:08:54.86,0:08:56.72,Default,pinya,0,0,0,,Ang pangunahing bagay sa lahat ng ito ay hindi mabuhay,
Dialogue: 0,0:08:56.72,0:08:59.53,Default,pinya,0,0,0,,at ang katotohanan na ang lahat ay para sa kanyang sarili!
Dialogue: 0,0:08:59.53,0:09:02.13,Default,pinya,0,0,0,,Gagawin ko ang lahat para sundin ang panuntunang ito!
Dialogue: 0,0:09:02.13,0:09:04.93,Default,pineapple,0,0,0,,I will try my best para masiguradong masaya tayong dalawa!
Dialogue: 0,0:09:04.93,0:09:07.97,Default,pineapple,0,0,0,,Kalimutan mo na ito!\NFForget about fucking distancing!
Dialogue: 0,0:09:07.97,0:09:09.14,Default,pinya,0,0,0,,Bakit?
Dialogue: 0,0:09:09.14,0:09:12.51,Default,pinya,0,0,0,,Ikaw at ako ay naglagay ng iba't ibang kahulugan sa pariralang ito!
Dialogue: 0,0:09:12.51,0:09:15.51,Default,pinya,0,0,0,,Napakaliit na bagay, ngunit mayroon nang dalawang magkaibang kahulugan!
Dialogue: 0,0:09:15.51,0:09:17.01,Default,pineapple,0,0,0,,Parehas kami ng iniisip.
Dialogue: 0,0:09:17.01,0:09:19.25,Default,pineapple,0,0,0,,Papatunayan ko ito sa iyo.
Dialogue: 0,0:09:19.38,0:09:22.15,Default,pineapple,0,0,0,,Iminumungkahi kong sumunod sa social distancing.
Dialogue: 0,0:09:22.15,0:09:24.65,Default,pinya,0,0,0,,Hindi ako mananatili dito!
Dialogue: 0,0:09:24.65,0:09:27.32,Default,pinya,0,0,0,,Subukan nating mamuhay ayon sa panuntunang ito!
Dialogue: 0,0:09:27.32,0:09:29.66,Default,pinya,0,0,0,,Nakakagalit!
Dialogue: 0,0:09:40.33,0:09:43.87,Default,pinya,0,0,0,,6 episode: Sa pagitan ng pag-unawa at hindi pagkakaunawaan
Dialogue: 0,0:09:45.51,0:09:47.61,Default,pinya,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:09:49.11,0:09:51.81,Default,pinya,0,0,0,,Kamahalan, anong nangyari?
Dialogue: 0,0:09:51.81,0:09:53.51,Default,pinya,0,0,0,,Tawagan ang punong eunuch ngayon.
Dialogue: 0,0:09:53.51,0:09:57.72,Default,pinya,0,0,0,,Okay lang ako, ingatan mo ang reyna.
Dialogue: 0,0:09:58.18,0:10:00.32,Default,pineapple,0,0,0,,-Oo, Kamahalan.\N-Oo, Kamahalan.
Dialogue: 0,0:10:01.52,0:10:03.19,Default,pinya,0,0,0,,Oh, kawawa namin kayo!
Dialogue: 0,0:10:04.12,0:10:05.76,Default,pinya,0,0,0,,Mas mabilis!
Dialogue: 0,0:10:13.70,0:10:17.34,Default,pinya,0,0,0,,Hindi dapat ako nakarating dito\NJang Bong-hwan
Dialogue: 0,0:11:17.13,0:11:19.10,Default,pineapple,0,0,0,,Namiss kita.
Dialogue: 0,0:11:19.37,0:11:21.73,Default,pineapple,0,0,0,,Na-miss din kita.
Dialogue: 0,0:11:23.90,0:11:25.94,Default,pinya,0,0,0,,Nasa kwarto ka ba?
Dialogue: 0,0:11:26.61,0:11:28.31,Default,pinya,0,0,0,,Oo, ama.
Dialogue: 0,0:11:33.68,0:11:36.25,Default,pinya,0,0,0,,Nakikita kong handa ka na.
Dialogue: 0,0:11:36.62,0:11:38.72,Default,pinya,0,0,0,,Paano ka natulog?
Dialogue: 0,0:11:38.72,0:11:40.32,Default,pinya,0,0,0,,Well,
Dialogue: 0,0:11:40.35,0:11:44.09,Default,pinya,0,0,0,,ngayon ang unang araw mo sa palasyo,\Nkaya maaga akong gumising.
Dialogue: 0,0:11:44.09,0:11:47.89,Default,pinya,0,0,0,,I will try my best
Dialogue: 0,0:11:47.89,0:11:49.66,Default,pineapple,0,0,0,,at hindi ko ipapahiya ang pangalan ng pamilya.
Dialogue: 0,0:11:49.66,0:11:52.73,Default,pinya,0,0,0,,Buti na lang at tumigil na ang ulan,\NGawing madali ang daan patungo sa palasyo.
Dialogue: 0,0:11:52.73,0:11:54.40,Default,pineapple,0,0,0,,Tapos maghanda.
Dialogue: 0,0:11:54.40,0:11:56.07,Default,pineapple,0,0,0,,Oo.
Dialogue: 0,0:12:17.69,0:12:20.03,Default,pinya,0,0,0,,Muntik akong mabulunan,
Dialogue: 0,0:12:20.03,0:12:23.03,Default,pineapple,0,0,0,,honestly, kung hindi dahil kay Cheoljong,\NI ay patay na.
Dialogue: 0,0:12:23.03,0:12:25.50,Default,pinya,0,0,0,,Bakit hindi bumalik ang demonyong ito?
Dialogue: 0,0:12:31.44,0:12:34.27,Default,pinya,0,0,0,,Ano ang nangyari sa pagitan mo at ng hari?
Dialogue: 0,0:12:34.27,0:12:36.68,Default,pinya,0,0,0,,Bakit nasa lawa ka nang ganoong oras?
Dialogue: 0,0:12:39.81,0:12:42.08,Default,pinya,0,0,0,,Hindi ka pa rin tapos?
Dialogue: 0,0:12:42.08,0:12:45.42,Default,pineapple,0,0,0,,Pinalis ko lahat.
Dialogue: 0,0:12:50.36,0:12:54.39,Default,pineapple,0,0,0,,Kailan ka nakatakas?\Ninabantayan ka ni NI.
Dialogue: 0,0:12:55.03,0:12:58.80,Default,pinya,0,0,0,,Talon ka ba ulit sa tubig?
Dialogue: 0,0:12:59.20,0:13:01.77,Default,pineapple,0,0,0,,Hindi naman ganoon.
Dialogue: 0,0:13:03.67,0:13:07.54,Default,pinya,0,0,0,,Kamahalan, nagdala ako ng pampalit na damit.
Dialogue: 0,0:13:07.54,0:13:09.44,Default,pinya,0,0,0,,Bakit basang-basa ka?
Dialogue: 0,0:13:09.44,0:13:13.21,Default,pineapple,0,0,0,,Oo. Natuwa ako na napuno muli ang lawa,
Dialogue: 0,0:13:13.21,0:13:16.18,Default,pineapple,0,0,0,,kaya nagpasya akong lumangoy.
Dialogue: 0,0:13:16.68,0:13:18.22,Default,pinya,0,0,0,,Ano?
Dialogue: 0,0:13:18.22,0:13:20.45,Default,pinya,0,0,0,,Nag-swimming ba kayong dalawa?
Dialogue: 0,0:13:20.55,0:13:22.52,Default,pinya,0,0,0,,Hindi mo dapat gawin iyon!
Dialogue: 0,0:13:22.52,0:13:25.56,Default,pinya,0,0,0,,Paano kung magkasakit ka?
Dialogue: 0,0:13:26.96,0:13:31.00,Default,pineapple,0,0,0,,Mukhang hindi ako matutulungan ng lawa na makabalik.
Dialogue: 0,0:13:32.03,0:13:33.73,Default,pineapple,0,0,0,,Isang uri ng kalokohan.
Dialogue: 0,0:13:44.04,0:13:45.71,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,0:13:46.11,0:13:47.38,Default,pinya,0,0,0,,Ayan ka na!
Dialogue: 0,0:13:47.38,0:13:49.62,Default,pinya,0,0,0,,Hinanap kita kahit saan,
Dialogue: 0,0:13:49.62,0:13:51.92,Default,pinya,0,0,0,,saan ka nagmamadali...
Dialogue: 0,0:13:52.49,0:13:54.72,Default,pinya,0,0,0,,Bakit basang-basa ka?
Dialogue: 0,0:13:54.72,0:13:57.29,Default,pineapple,0,0,0,,-Ayos lang.\N-Paano iyon?
Dialogue: 0,0:14:46.01,0:14:47.61,Default,pinya,0,0,0,,Malaki ang utang ko sa iyo,
Dialogue: 0,0:14:47.61,0:14:50.78,Default,pinya,0,0,0,,kaya mabubuhay ako para tulungan ka, madam.
Dialogue: 0,0:14:59.19,0:15:02.16,Default,pineapple,0,0,0,,Sorry, hindi kita napansin.
Dialogue: 0,0:15:02.16,0:15:04.69,Default,pineapple,0,0,0,,Sigurado ka bang wala kang nakita?
Dialogue: 0,0:15:19.31,0:15:21.11,Default,pinya,0,0,0,,Kapag alam ng maliit na prito,
Dialogue: 0,0:15:21.11,0:15:22.98,Default,pinya,0,0,0,,kamatayan lang ang naghihintay sa kanya.
Dialogue: 0,0:15:24.48,0:15:27.85,Default,pinya,0,0,0,,Ito ang tuntunin ng palasyo.
Dialogue: 0,0:15:28.55,0:15:31.05,Default,pineapple,0,0,0,,Dapat akong mabuhay.
Dialogue: 0,0:15:31.12,0:15:34.82,Default,pineapple,0,0,0,,Sinabi sa akin ni Lady Hwajin na mabuhay.
Dialogue: 0,0:15:59.71,0:16:04.88,Default,pinya,0,0,0,,Ngayon ng madaling araw ay nahulog muli ang reyna sa lawa.
Dialogue: 0,0:16:05.15,0:16:09.32,Default,pinya,0,0,0,,Ngunit sa pagkakataong ito ay kasama niya ang hari...
Dialogue: 0,0:16:09.72,0:16:14.56,Default,pineapple,0,0,0,,Mukhang walang nakakaalam kung bakit napunta silang dalawa sa tubig.
Dialogue: 0,0:16:15.76,0:16:17.63,Default,pinya,0,0,0,,Tama na,
Dialogue: 0,0:16:17.63,0:16:22.30,Default,pinya,0,0,0,,upang patunayan na magiging kapaki-pakinabang ako?
Dialogue: 0,0:16:23.20,0:16:25.91,Default,pinya,0,0,0,,Sabihin ito sa Inang Reyna.
Dialogue: 0,0:16:26.24,0:16:30.14,Default,pinya,0,0,0,,Dapat ko bang ilarawan ang lahat nang eksakto kung ano ito?
Dialogue: 0,0:16:30.14,0:16:32.38,Default,pinya,0,0,0,,Pagkatapos mong magsalita,
Dialogue: 0,0:16:32.68,0:16:34.95,Default,pinya,0,0,0,,sabihin mo sa akin ang lahat ng iyong sinasabi o ginagawa
Dialogue: 0,0:16:34.95,0:16:37.18,Default,pineapple,0,0,0,,queen mother, anumang maliit na bagay.
Dialogue: 0,0:16:38.72,0:16:42.25,Default,pineapple,0,0,0,,Hindi sa iyo ang magpasya kung ano ang maaaring maging kapaki-pakinabang.
Dialogue: 0,0:16:42.46,0:16:44.29,Default,pineapple,0,0,0,,Gagawin ko ang eksaktong iniutos mo.
Dialogue: 0,0:16:45.26,0:16:48.03,Default,pinya,0,0,0,,Mula sa araw na ito, sumunod ka sa ginang ng hukuman
Dialogue: 0,0:16:48.03,0:16:51.00,Default,pineapple,0,0,0,,queen's chambers.
Dialogue: 0,0:16:53.80,0:16:55.50,Default,pinya,0,0,0,,Queen's chambers?
Dialogue: 0,0:16:56.07,0:16:58.30,Default,pinya,0,0,0,,Ito ay napakataas na posisyon!
Dialogue: 0,0:16:58.34,0:16:59.91,Default,pinya,0,0,0,,Salamat, sir!
Dialogue: 0,0:16:59.91,0:17:03.54,Default,pineapple,0,0,0,,Magpapasya ang Inang Reyna na mas magiging kapaki-pakinabang ka sa kanya.
Dialogue: 0,0:17:04.34,0:17:07.75,Default,pineapple,0,0,0,,Maingat na subaybayan ang paligid ng reyna.
Dialogue: 0,0:17:08.11,0:17:10.75,Default,pinya,0,0,0,,Oo, sir.
Dialogue: 0,0:17:21.66,0:17:23.40,Default,Lily,0,0,0,,Gumuhit ng bulaklak
Dialogue: 0,0:17:23.40,0:17:25.46,Default,Lily,0,0,0,,o bud?
Dialogue: 0,0:17:26.47,0:17:28.77,Default,Lily,0,0,0,,Ano sa palagay mo, Ovol?
Dialogue: 0,0:17:33.84,0:17:36.04,Default,Lily,0,0,0,,Maliban sa Kanyang Kamahalan,
Dialogue: 0,0:17:36.48,0:17:38.54,Default,Lily,0,0,0,,Wala akong kasama ngayon.
Dialogue: 0,0:17:41.48,0:17:45.28,Default,Lily,0,0,0,,Your Highness, andito na ang Reyna Ina.
Dialogue: 0,0:17:49.52,0:17:51.72,Default,Lily,0,0,0,,Pagbati, Kamahalan.
Dialogue: 0,0:17:51.72,0:17:54.23,Default,Lily,0,0,0,,Nag-drawing ka ng mga orchid.
Dialogue: 0,0:18:00.57,0:18:02.30,Default,Lily,0,0,0,,Tapos na ba sila?
Dialogue: 0,0:18:02.30,0:18:03.84,Default,Lily,0,0,0,,Hindi pa.
Dialogue: 0,0:18:03.84,0:18:07.27,Default,Lily,0,0,0,,Hindi ko pa napagpasyahan kung mag-drawing ng bulaklak o ng hindi pa nabubuksang usbong.
Dialogue: 0,0:18:07.27,0:18:09.78,Default,Lily,0,0,0,,Tingnan ko.
Dialogue: 0,0:18:09.91,0:18:13.58,Default,Lily,0,0,0,,I think the bud will do.
Dialogue: 0,0:18:14.28,0:18:16.98,Default,Lily,0,0,0,,Magiging interesado ang lahat,
Dialogue: 0,0:18:17.65,0:18:21.52,Default,Lily,0,0,0,,anong bulaklak iyon.
Dialogue: 0,0:18:39.07,0:18:42.01,Default,Lily,0,0,0,,Diyos, anong ganda.
Dialogue: 0,0:18:42.04,0:18:44.91,Default,Lily,0,0,0,,Sana hindi lumipad ang mga buds,
Dialogue: 0,0:18:44.91,0:18:48.15,Default,Lily,0,0,0,,bago ito mamukadkad.
Dialogue: 0,0:18:49.88,0:18:51.12,Default,Lily,0,0,0,,Nga pala.
Dialogue: 0,0:18:51.12,0:18:54.65,Default,Lily,0,0,0,,Naparito ako para bigyan ka ng maliit na regalo.
Dialogue: 0,0:19:07.40,0:19:08.70,Default,Lily,0,0,0,,Salamat.
Dialogue: 0,0:19:08.70,0:19:10.24,Default,Lily,0,0,0,,Hindi ko alam kung ano ang nagustuhan mo,
Dialogue: 0,0:19:10.24,0:19:12.84,Default,Lily,0,0,0,,Kinailangan kong mag-isip nang matagal.
Dialogue: 0,0:19:22.28,0:19:25.65,Default,Lily,0,0,0,,Nabalitaan ko na ikaw ay isang mahusay na mamamana.
Dialogue: 0,0:19:26.72,0:19:28.99,Default,Lily,0,0,0,,Gusto ko ring matuto kung paano mag-shoot ng bow.
Dialogue: 0,0:19:28.99,0:19:31.82,Default,Lily,0,0,0,,Inihanda ko ito para sa sarili ko at para sa iyo.
Dialogue: 0,0:19:35.23,0:19:37.73,Default,Lily,0,0,0,,Maganda at matibay na mga arrow.
Dialogue: 0,0:19:39.17,0:19:40.40,Default,Lily,0,0,0,,Salamat.
Dialogue: 0,0:19:40.40,0:19:43.60,Default,Lily,0,0,0,,Ang tunay na regalo ay hindi arrow.
Dialogue: 0,0:19:44.27,0:19:47.37,Default,Lily,0,0,0,,Ihahatid ang regalo ngayon
Dialogue: 0,0:19:47.37,0:19:50.18,Default,Lily,0,0,0,,Sa Kanyang Kamahalan sa pulong ng korte.
Dialogue: 0,0:19:58.42,0:19:59.99,Default,Lily,0,0,0,,Saan kung hindi sa lawa?
Dialogue: 0,0:19:59.99,0:20:02.35,Default,Lily,0,0,0,,Tubig lang ang nagbubuklod sa atin.
Dialogue: 0,0:20:08.06,0:20:09.90,Default,Lily,0,0,0,,At isa pa.
Dialogue: 0,0:20:10.46,0:20:12.73,Default,Lily,0,0,0,,Pareho kaming nasa bingit ng kamatayan.
Dialogue: 0,0:20:13.00,0:20:15.07,Default,Lily,0,0,0,,Damn, paano kung subukan ko at mamatay talaga?
Dialogue: 0,0:20:15.07,0:20:17.44,Default,Lily,0,0,0,,Sobrang sakit ang mamatay.
Dialogue: 0,0:20:18.74,0:20:22.57,Default,Lily,0,0,0,,Sigurado akong may ligtas na paraan para makabalik.
Dialogue: 0,0:20:23.14,0:20:25.84,Default,Lily,0,0,0,,Una sa lahat, mauunawaan ko kung anong klaseng babae ito.
Dialogue: 0,0:20:29.35,0:20:32.38,Default,Lily,0,0,0,,Ako si Kim So-yeon.
Dialogue: 0,0:20:33.29,0:20:35.39,Default,Lily,0,0,0,,Nagpakamatay.
Dialogue: 0,0:20:35.96,0:20:40.89,Default,Lily,0,0,0,,Iwanan ang iyong huwad na sarili?
Dialogue: 0,0:20:41.89,0:20:45.03,Default,Lily,0,0,0,,Bakit mo sinubukang mamatay? Hindi ko gustong mabuhay.
Dialogue: 0,0:20:47.23,0:20:50.14,Default,Lily,0,0,0,,Syempre, kaya ayaw na niyang bumalik.
Dialogue: 0,0:20:50.34,0:20:53.91,Default,Lily,0,0,0,,Itong babaeng ito... Tumakas?
Dialogue: 0,0:20:57.94,0:21:00.21,Default,Lily,0,0,0,,Naiintindihan ko kung bakit mo ito ginagawa.
Dialogue: 0,0:21:00.21,0:21:02.32,Default,Lily,0,0,0,,Nahuhumaling ka sa lawa
Dialogue: 0,0:21:02.32,0:21:04.68,Default,Lily,0,0,0,,at bumulong sa iyong sarili.
Dialogue: 0,0:21:04.75,0:21:06.85,Default,Lily,0,0,0,,Ikaw kasi...
Dialogue: 0,0:21:10.19,0:21:12.76,Default,Lily,0,0,0,,sinusubukang ibalik ang mga alaala?
Dialogue: 0,0:21:14.76,0:21:16.76,Default,Lily,0,0,0,,Oo. tama ka.
Dialogue: 0,0:21:16.76,0:21:18.16,Default,Lily,0,0,0,,Okay.
Dialogue: 0,0:21:18.16,0:21:20.70,Default,Lily,0,0,0,,May tanong na lumitaw. Nang mahulog ako sa lawa
Dialogue: 0,0:21:20.70,0:21:23.47,Default,Lily,0,0,0,,Nabunutan agad ako, pero nawalan ako ng malay?
Dialogue: 0,0:21:24.04,0:21:25.57,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:21:25.57,0:21:27.61,Default,Lily,0,0,0,,Damn. alam ko na. Tumakas siya.
Dialogue: 0,0:21:28.04,0:21:30.08,Default,Lily,0,0,0,,Ito ay hindi patas.
Dialogue: 0,0:21:30.08,0:21:32.41,Default,Lily,0,0,0,,Gusto kong bumalik.
Dialogue: 0,0:21:33.58,0:21:35.78,Default,Lily,0,0,0,,Ito ay isang pagkidnap!
Dialogue: 0,0:21:36.65,0:21:39.35,Default,Lily,0,0,0,,Ibinabalik ng inihaw na dorosoma ang mga tumakas na asawa.
Dialogue: 0,0:21:39.82,0:21:42.79,Default,Lily,0,0,0,,O ipatawag ang mga espiritu na umalis sa katawan?
Dialogue: 0,0:21:43.29,0:21:44.89,Default,Lily,0,0,0,,Rite?
Dialogue: 0,0:21:45.26,0:21:48.43,Default,Lily,0,0,0,,Oo. Kailangan kong gawin ang seremonya.
Dialogue: 0,0:21:48.43,0:21:50.86,Default,Lily,0,0,0,,Sasaklawin ko lahat dito ng mamahaling anting-anting.
Dialogue: 0,0:21:51.60,0:21:54.03,Default,Lily,0,0,0,,Court lady Choi, nandyan ka ba?
Dialogue: 0,0:21:58.27,0:22:02.34,Default,Lily,0,0,0,,Mayroon bang espesyalista sa mga ritwal o anting-anting dito?
Dialogue: 0,0:22:02.91,0:22:04.51,Default,Lily,0,0,0,,Ano?
Dialogue: 0,0:22:04.51,0:22:07.48,Default,Lily,0,0,0,,Hindi ka dapat maging interesado sa shamanism,
Dialogue: 0,0:22:08.11,0:22:10.48,Default,Lily,0,0,0,,pero gagawin mo pa rin?
Dialogue: 0,0:22:12.12,0:22:16.49,Default,Lily,0,0,0,,Isang tao ang naiisip.
Dialogue: 0,0:22:17.19,0:22:18.82,Default,Lily,0,0,0,,At sino?
Dialogue: 0,0:22:27.63,0:22:31.20,Default,Lily,0,0,0,,Bakit siya pumunta dito? Ano ang gusto niyang malaman?
Dialogue: 0,0:22:31.20,0:22:34.54,Default,Lily,0,0,0,,Ano ang utang ko sa kasiyahang ito?
Dialogue: 0,0:22:35.24,0:22:37.41,Default,Lily,0,0,0,,Nalaman ko na eksperto ka.
Dialogue: 0,0:22:37.54,0:22:40.65,Default,Lily,0,0,0,,Ako? ano?
Dialogue: 0,0:22:41.11,0:22:44.35,Default,Lily,0,0,0,,Kailangan ko ng espirituwal na gabay.
Dialogue: 0,0:22:44.65,0:22:48.22,Default,Lily,0,0,0,,Sa mga bagay tulad ng mga ritwal at anting-anting.
Dialogue: 0,0:22:48.22,0:22:51.59,Default,Lily,0,0,0,,Nahulaan mo ba na mayroon akong bagong anting-anting,
Dialogue: 0,0:22:51.59,0:22:53.66,Default,Lily,0,0,0,,sumpain siya?
Dialogue: 0,0:22:54.03,0:22:57.13,Default,Lily,0,0,0,,Halika, ito ay masamang lasa.
Dialogue: 0,0:22:57.13,0:23:00.33,Default,Lily,0,0,0,,Bakit mo ito kailangan?
Dialogue: 0,0:23:00.33,0:23:02.10,Default,Lily,0,0,0,,Oo, kalokohan iyon.
Dialogue: 0,0:23:02.10,0:23:06.24,Default,Lily,0,0,0,,Kailangan mong ipatawag ang espiritu na umalis sa katawan.
Dialogue: 0,0:23:07.44,0:23:09.44,Default,Lily,0,0,0,,Madalas ba itong mangyari?
Dialogue: 0,0:23:09.44,0:23:12.98,Default,Lily,0,0,0,,Siya ay matalino na sinusubukang mapalapit sa akin.
Dialogue: 0,0:23:12.98,0:23:15.98,Default,Lily,0,0,0,,Nais akong parusahan para sa aking mga anting-anting.
Dialogue: 0,0:23:15.98,0:23:18.02,Default,Lily,0,0,0,,Sly fox.
Dialogue: 0,0:23:18.55,0:23:21.62,Default,Lily,0,0,0,,Hindi ako naniniwala sa mga ganyang bagay.
Dialogue: 0,0:23:21.62,0:23:24.76,Default,Lily,0,0,0,,Ni multo o espiritu.
Dialogue: 0,0:23:26.19,0:23:30.46,Default,Lily,0,0,0,,Kung gayon para saan ito?
Dialogue: 0,0:23:37.50,0:23:39.17,Default,Lily,0,0,0,,Mali ka.
Dialogue: 0,0:23:39.17,0:23:41.47,Default,Lily,0,0,0,,Hindi ito shamanic na lugar.
Dialogue: 0,0:23:41.47,0:23:44.21,Default,Lily,0,0,0,,Dito nililinis ko ang aking kaluluwa.
Dialogue: 0,0:23:44.21,0:23:46.14,Default,Lily,0,0,0,,Nakikita ko.
Dialogue: 0,0:23:48.38,0:23:50.02,Default,Lily,0,0,0,,Ano?
Dialogue: 0,0:23:50.25,0:23:51.95,Default,Lily,0,0,0,,Talaga?
Dialogue: 0,0:23:52.72,0:23:57.56,Default,Lily,0,0,0,,Kaninong espiritu ang gusto mong ipatawag?
Dialogue: 0,0:23:58.86,0:24:03.16,Default,Lily,0,0,0,,Masasabi kong malapit tayo at malapit na konektado.
Dialogue: 0,0:24:04.63,0:24:06.20,Default,Lily,0,0,0,,Babae ito, don't get me wrong.
Dialogue: 0,0:24:06.20,0:24:07.93,Default,Lily,0,0,0,,Nakikita ko.
Dialogue: 0,0:24:08.37,0:24:12.84,Default,Lily,0,0,0,,Marahil ito ang iyong ina,\Nna hindi mo pa nakikita.
Dialogue: 0,0:24:14.24,0:24:18.51,Default,Lily,0,0,0,,God. Nadudurog ang puso ko para sa iyo.
Dialogue: 0,0:24:18.61,0:24:20.61,Default,Lily,0,0,0,,Malungkot ka siguro sa palasyo.
Dialogue: 0,0:24:20.61,0:24:23.32,Default,Lily,0,0,0,,Miss mo na ang yumao mong ina.
Dialogue: 0,0:24:23.32,0:24:25.02,Default,Lily,0,0,0,,Dahil dito
Dialogue: 0,0:24:25.35,0:24:28.02,Default,Lily,0,0,0,, sinubukang magpakamatay?
Dialogue: 0,0:24:30.16,0:24:31.86,Default,Lily,0,0,0,,Sa tingin mo?
Dialogue: 0,0:24:31.86,0:24:34.96,Default,Lily,0,0,0,,Masasabi mo sa akin ang lahat.
Dialogue: 0,0:24:34.96,0:24:37.33,Default,Lily,0,0,0,,Bagaman hindi ako nagsilang ng hari,
Dialogue: 0,0:24:37.33,0:24:41.00,Default,Lily,0,0,0,,pero ayon sa pedigree, nanay niya ako.
Dialogue: 0,0:24:41.00,0:24:46.37,Default,Lily,0,0,0,,Mula sa araw na ito, mamahalin kita bilang aking anak at aalagaan...
Dialogue: 0,0:24:46.97,0:24:49.37,Default,Lily,0,0,0,,Mayroon na akong dalawang nanay.
Dialogue: 0,0:24:50.31,0:24:53.71,Default,Lily,0,0,0,,To be honest, I wasn't trying to kill myself.
Dialogue: 0,0:24:53.71,0:24:57.32,Default,Lily,0,0,0,,Kung gayon bakit mo nasabi iyon?
Dialogue: 0,0:24:57.38,0:24:59.05,Default,Lily,0,0,0,,At nagsasalita ako tungkol sa parehong bagay.
Dialogue: 0,0:24:59.05,0:25:01.19,Default,Lily,0,0,0,,Bakit ko ginawa ito?
Dialogue: 0,0:25:01.32,0:25:03.86,Default,Lily,0,0,0,,Gusto mo hulaan ko?
Dialogue: 0,0:25:04.39,0:25:07.59,Default,Lily,0,0,0,,Kaya may lihim siyang motibo.
Dialogue: 0,0:25:09.33,0:25:13.67,Default,Lily,0,0,0,,Kaya pinagbantaan niya ako at gusto niya akong mag-ingat.
Dialogue: 0,0:25:18.94,0:25:22.34,Default,Lily,0,0,0,,Damn. Nasayang ang oras ko.
Dialogue: 0,0:25:24.31,0:25:26.71,Default,Lily,0,0,0,,Hindi pa nagaganap ang court meeting.
Dialogue: 0,0:25:26.71,0:25:30.05,Default,Lily,0,0,0,,At sinusubukan na niya akong takutin?
Dialogue: 0,0:25:30.92,0:25:34.19,Default,Lily,0,0,0,,Court lady Han, meron din sila
Dialogue: 0,0:25:34.19,0:25:36.96,Default,Lily,0,0,0,,isang ibon na nagdadala ng tsismis.
Dialogue: 0,0:25:36.96,0:25:40.53,Default,Lily,0,0,0,,Ano? Sino kaya ang gumawa nito?
Dialogue: 0,0:25:40.59,0:25:45.93,Default,Lily,0,0,0,,Matapang siyang pumasok at nagbigay ng mga pahiwatig,
Dialogue: 0,0:25:46.47,0:25:50.67,Default,Lily,0,0,0,,kaya hindi ganoon kadaling malaman ang ibon.
Dialogue: 0,0:25:51.67,0:25:54.04,Default,Lily,0,0,0,,Makipag-ugnayan sa manghuhula, court lady Han.
Dialogue: 0,0:25:54.34,0:25:59.08,Default,Lily,0,0,0,,Kailangan ko ng mga hula.
Dialogue: 0,0:26:02.65,0:26:05.25,Default,Lily,0,0,0,,Siya ay pinahirapan ng isang bagay at sinubukang pumatay sa sarili.
Dialogue: 0,0:26:05.25,0:26:06.95,Default,Lily,0,0,0,,Ngunit hindi siya maaaring mamatay.
Dialogue: 0,0:26:06.95,0:26:09.05,Default,Lilia,0,0,0,,At ang kanyang kaluluwa ay parang: "Huwag kang pakialam. Lalabas ako."
Dialogue: 0,0:26:09.22,0:26:12.66,Default,Lily,0,0,0,,At hindi bumalik.
Dialogue: 0,0:26:12.99,0:26:14.69,Default,Lily,0,0,0,,Ano ang nagpapahirap sa kanya?
Dialogue: 0,0:26:14.69,0:26:17.10,Default,Lily,0,0,0,,Hindi niya gustong maging reyna.
Dialogue: 0,0:26:17.10,0:26:18.76,Default,Lily,0,0,0,,Bakit?
Dialogue: 0,0:26:19.23,0:26:22.00,Default,Lily,0,0,0,,Dahil hindi siya minahal ni Cheoljong
Dialogue: 0,0:26:22.00,0:26:24.57,Default,Lily,0,0,0,,at umibig sa iba?
Dialogue: 0,0:26:24.57,0:26:26.14,Default,Lily,0,0,0,,Halika.
Dialogue: 0,0:26:26.14,0:26:28.84,Default,Lily,0,0,0,,Sinubukan bang mamatay dahil sa isang tanga?
Dialogue: 0,0:26:30.21,0:26:33.35,Default,Lily,0,0,0,,Nakausap ng Her Majesty ang kanyang sarili nang higit kaysa karaniwan.
Dialogue: 0,0:26:33.35,0:26:34.91,Default,Lily,0,0,0,,Maraming tao ang nakakarinig.
Dialogue: 0,0:26:34.91,0:26:36.82,Default,Lily,0,0,0,,Iyon ang pinakamaliit sa mga problema ko.
Dialogue: 0,0:26:36.82,0:26:40.42,Default,Lily,0,0,0,,Naguguluhan ako sa kanya tungkol dito, pero oras na para pakawalan siya.
Dialogue: 0,0:26:41.19,0:26:43.56,Default,Lily,0,0,0,,Sa bilis na ito, malapit na niyang papatayin ang isang tao.
Dialogue: 0,0:26:45.06,0:26:47.59,Default,Lily,0,0,0,,Pero muli, naiintindihan ko siya.
Dialogue: 0,0:26:47.59,0:26:50.66,Default,Lily,0,0,0,,Ang pagiging reyna ay parang nakaupo sa kulungan na walang mga bar.
Dialogue: 0,0:26:50.66,0:26:53.80,Default,Lily,0,0,0,,Mula sa isang marangal na pamilya, piniling maging reyna,
Dialogue: 0,0:26:53.80,0:26:56.24,Default,Lilia,0,0,0,,na nangangahulugang wala pa siyang nakilala.
Dialogue: 0,0:26:56.24,0:26:59.24,Default,Lily,0,0,0,,Marahil hindi ko pa nakita ang lalaki bago si Cheoljong.
Dialogue: 0,0:26:59.24,0:27:01.77,Default,Lily,0,0,0,,Isinasaalang-alang na siya ay isang hari at lahat,
Dialogue: 0,0:27:01.77,0:27:04.24,Default,Lily,0,0,0,,malinaw kung bakit siya umibig.
Dialogue: 0,0:27:05.81,0:27:10.15,Default,Lily,0,0,0,,Sandali. Siguradong sobrang saya niya ngayon.
Dialogue: 0,0:27:10.15,0:27:12.52,Default,Lily,0,0,0,,Buong buhay kong namumuno sa isang asetiko na pamumuhay,
Dialogue: 0,0:27:12.52,0:27:15.29,Default,Lily,0,0,0,,nakatuklas ng bagong mundo.
Dialogue: 0,0:27:17.92,0:27:19.82,Default,Lily,0,0,0,,At kung ang babaeng ito...
Dialogue: 0,0:27:20.69,0:27:23.56,Default,Lily,0,0,0,,Huwag niyang paglaruan ang katawan ko!
Dialogue: 0,0:27:37.44,0:27:39.18,Default,Lily,0,0,0,,Ano?
Dialogue: 0,0:27:55.86,0:27:57.76,Default,Lily,0,0,0,,Stop!
Dialogue: 0,0:27:57.76,0:28:00.80,Default,Lily,0,0,0,,Bumalik ka kaagad, tuturuan ka namin ng leksyon!
Dialogue: 0,0:28:00.80,0:28:02.37,Default,Lily,0,0,0,,Ayaw mo ba?
Dialogue: 0,0:28:02.37,0:28:05.84,Default,Lily,0,0,0,,Ano ang kawili-wiling tinitingnan mo?
Dialogue: 0,0:28:06.34,0:28:08.81,Default,Lily,0,0,0,,Pagkatapos ay gagawin ko
Dialogue: 0,0:28:09.14,0:28:11.84,Default,Lily,0,0,0,,hiwain ang iyong katawan. Hanggang sa dumugo ako!
Dialogue: 0,0:28:11.84,0:28:13.75,Default,Lily,0,0,0,,Ito ay magiging napakasakit.
Dialogue: 0,0:28:14.31,0:28:18.82,Default,Lily,0,0,0,,Sa tingin mo hindi ko kaya? kaya ko to. ganito!
Dialogue: 0,0:28:25.22,0:28:26.96,Default,Lily,0,0,0,,Damn, masakit.
Dialogue: 0,0:28:29.70,0:28:32.66,Default,Lily,0,0,0,,Tiyak na magkakaroon ng dugo sa pagkakataong ito.
Dialogue: 0,0:28:37.10,0:28:38.94,Default,Lily,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:28:39.27,0:28:41.04,Default,Lily,0,0,0,,Masakit talaga!
Dialogue: 0,0:28:41.51,0:28:43.44,Default,Lily,0,0,0,,-Sobrang sakit.\N-Bumangon ka.
Dialogue: 0,0:28:44.58,0:28:46.55,Default,Lily,0,0,0,,Masakit.
Dialogue: 0,0:28:46.55,0:28:49.45,Default,Lily,0,0,0,,-God.\N-Ang tasa ng pasensya ay puno na.
Dialogue: 0,0:28:50.28,0:28:54.15,Default,Lily,0,0,0,,Babalik, hindi na babalik.
Dialogue: 0,0:28:54.39,0:28:55.99,Default,Lily,0,0,0,,Babalik.
Dialogue: 0,0:28:57.69,0:28:59.39,Default,Lily,0,0,0,,Hindi na babalik.
Dialogue: 0,0:29:03.73,0:29:05.43,Default,Lily,0,0,0,,Higit pa?
Dialogue: 0,0:29:05.93,0:29:07.77,Default,Lily,0,0,0,,Kamahalan, huwag kang mag-alala.
Dialogue: 0,0:29:07.77,0:29:10.34,Default,Lily,0,0,0,,Babalik pagdating ng panahon.
Dialogue: 0,0:29:10.34,0:29:14.41,Default,Lily,0,0,0,,Sa oras na iyon gagawin ko na...
Dialogue: 0,0:29:20.35,0:29:23.52,Default,Lily,0,0,0,,Tumawag ako sa espiritu. Espiritu dumating.
Dialogue: 0,0:29:23.58,0:29:25.92,Default,Lily,0,0,0,,Nandito ka ba?
Dialogue: 0,0:29:26.92,0:29:30.76,Default,Lily,0,0,0,,Pagtawag sa espiritu. Espiritu dumating.
Dialogue: 0,0:29:30.82,0:29:32.99,Default,Lily,0,0,0,,Nandiyan ka ba?
Dialogue: 0,0:29:34.79,0:29:37.13,Default,Lily,0,0,0,,Dahil may katawan tayo sa isa't isa,
Dialogue: 0,0:29:37.23,0:29:40.23,Default,Lily,0,0,0,,mag-usap tayo ng tapat.
Dialogue: 0,0:29:43.57,0:29:45.84,Default,Lily,0,0,0,,Nakikipag-usap muli sa iyong sarili?
Dialogue: 0,0:29:46.67,0:29:49.07,Default,Lily,0,0,0,,Isaalang-alang ito na isang self-exorcism
Dialogue: 0,0:29:49.78,0:29:51.61,Default,Lily,0,0,0,,o pakikipag-usap sa iyong sarili.
Dialogue: 0,0:29:51.61,0:29:53.48,Default,Lily,0,0,0,,Paano kung kumalat ang tsismis?
Dialogue: 0,0:29:53.48,0:29:56.28,Default,Lily,0,0,0,,Sa palasyo mabilis silang nagkalat.
Dialogue: 0,0:29:56.28,0:29:58.78,Default,Lily,0,0,0,,Ano ito? Mukhang maganda.
Dialogue: 0,0:29:58.78,0:30:01.49,Default,Lily,0,0,0,,Ibinigay ito sa iyo ng Kanyang Kamahalan.
Dialogue: 0,0:30:01.49,0:30:03.29,Default,Lily,0,0,0,,At dinala ko ito.
Dialogue: 0,0:30:12.93,0:30:14.57,Default,Lily,0,0,0,,Aklat ng Mga Pagbabago
Dialogue: 0,0:30:15.63,0:30:17.37,Default,Lily,0,0,0,,May laman sa loob.
Dialogue: 0,0:30:18.00,0:30:19.07,Default,Lily,0,0,0,,Social distancing
Dialogue: 0,0:30:19.07,0:30:22.57,Default,Lily,0,0,0,,Diyos! Sobrang cute.
Dialogue: 0,0:30:23.18,0:30:25.21,Default,Lily,0,0,0,,Tapos na ako sa ganitong distansya.
Dialogue: 0,0:30:25.21,0:30:28.65,Default,Lily,0,0,0,,Inaalok ko siya, tumanggi siya. Ngayon ano?
Dialogue: 0,0:30:34.12,0:30:36.05,Default,tiramisu,0,0,0,,Sinaw ka na ba?
Dialogue: 0,0:30:36.05,0:30:37.66,Default,tiramisu,0,0,0,,Alam kong magiging ganito.
Dialogue: 0,0:30:37.66,0:30:40.39,Default,tiramisu,0,0,0,,Nabasa ka sa ulan at naglalaro pa rin sa tubig.
Dialogue: 0,0:30:40.39,0:30:43.19,Default,tiramisu,0,0,0,,Ano ang gusto mong gawin ko sa iyo?
Dialogue: 0,0:30:45.30,0:30:46.97,Default,tiramisu,0,0,0,,Honyeon.
Dialogue: 0,0:30:48.20,0:30:50.10,Default,tiramisu,0,0,0,,Hindi ito sipon.
Dialogue: 0,0:30:50.10,0:30:51.40,Default,tiramisu,0,0,0,,Ano kung gayon?
Dialogue: 0,0:30:51.40,0:30:53.27,Default,tiramisu,0,0,0,,Ito
Dialogue: 0,0:30:54.87,0:30:57.11,Default,tiramisu,0,0,0,,kawalan ng pag-asa mismo.
Dialogue: 0,0:30:57.94,0:31:00.98,Default,tiramisu,0,0,0,,Akala ko magiging maayos ang lahat kapag napuno na ang lawa.
Dialogue: 0,0:31:01.35,0:31:05.72,Default,tiramisu,0,0,0,,Ngunit nakikita mo, ang pag-asa ay isang malupit na bagay.
Dialogue: 0,0:31:06.99,0:31:10.26,Default,tiramisu,0,0,0,,Upang mabawi ang iyong memorya, handa ka pang pumunta sa mga shaman.
Dialogue: 0,0:31:10.82,0:31:13.96,Default,tiramisu,0,0,0,,Sana itigil mo na ang pagsubok.
Dialogue: 0,0:31:14.09,0:31:16.46,Default,tiramisu,0,0,0,,Kung maayos ang lahat sa iyo,
Dialogue: 0,0:31:16.46,0:31:19.20,Default,tiramisu,0,0,0,,hindi mo susubukang magpakamatay.
Dialogue: 0,0:31:19.60,0:31:21.20,Default,tiramisu,0,0,0,,Para sa iyong kaligayahan,
Dialogue: 0,0:31:21.20,0:31:22.77,Default,tiramisu,0,0,0,,mabuti pa sigurong huwag nang subukang bumalik...
Dialogue: 0,0:31:22.77,0:31:25.87,Default,tiramisu,0,0,0,,Hindi! kailangan ko!
Dialogue: 0,0:31:27.21,0:31:29.87,Default,tiramisu,0,0,0,,Hindi na ako mabubuhay ng ganito.
Dialogue: 0,0:31:32.01,0:31:35.01,Default,tiramisu,0,0,0,,Sasabihin ko sa royal chef na maghanda para sa lamig.
Dialogue: 0,0:31:35.01,0:31:37.25,Default,tiramisu,0,0,0,,Kailangan mong kumain at magpahinga.
Dialogue: 0,0:31:37.68,0:31:40.52,Default,tiramisu,0,0,0,,Hindi, itong babaeng ito
Dialogue: 0,0:31:40.52,0:31:44.36,Default,tiramisu,0,0,0,,gusto niyang bumalik. Binibigyan kita ng ngipin.
Dialogue: 0,0:31:48.19,0:31:50.40,Default,tiramisu,0,0,0,,Heto, hipan mo ang iyong ilong.
Dialogue: 0,0:31:50.40,0:31:53.43,Default,tiramisu,0,0,0,,Hindi ako bata, kaya ko ang sarili ko.
Dialogue: 0,0:31:56.37,0:31:59.27,Default,tiramisu,0,0,0,,Isa pang beses.
Dialogue: 0,0:32:04.51,0:32:06.38,Default,tiramisu,0,0,0,,-Eunuch Chha.\N-Oo.
Dialogue: 0,0:32:07.91,0:32:12.62,Default,tiramisu,0,0,0,,Kamahalan, mayroon kang sipon. Mangyaring bumalik sa iyong silid.
Dialogue: 0,0:32:12.62,0:32:14.82,Default,tiramisu,0,0,0,,Hindi, hindi ito sipon.
Dialogue: 0,0:32:14.82,0:32:16.79,Default,tiramisu,0,0,0,,Ito...
Dialogue: 0,0:32:19.79,0:32:22.96,Default,tiramisu,0,0,0,,I think it's a cold. tama ka.
Dialogue: 0,0:32:23.53,0:32:25.83,Default,tiramisu,0,0,0,,May balita na ba mula sa Daejojeon hall?
Dialogue: 0,0:32:25.83,0:32:28.93,Default,tiramisu,0,0,0,,-Hindi.\N-Nakuha ba niya ang libro?
Dialogue: 0,0:32:28.93,0:32:30.97,Default,tiramisu,0,0,0,,Oo, nakuha ko.
Dialogue: 0,0:32:31.60,0:32:35.07,Default,tiramisu,0,0,0,,Siyempre, hindi madali ang pagbubukas ng pusong sarado.
Dialogue: 0,0:32:35.07,0:32:37.61,Default,tiramisu,0,0,0,,May hihilingin akong pabor sa iyo.
Dialogue: 0,0:32:37.61,0:32:40.28,Default,tiramisu,0,0,0,,Ikuha mo ako ng isang bagay na mahalaga.
Dialogue: 0,0:32:42.48,0:32:45.02,Default,tiramisu,0,0,0,,Sa pamamagitan ng "isang bagay na mahalaga" ang ibig mong sabihin...
Dialogue: 0,0:32:46.55,0:32:49.32,Default,tiramisu,0,0,0,,Ano ang iniisip mo?
Dialogue: 0,0:32:54.59,0:32:56.70,Default,tiramisu,0,0,0,,Itinalaga namin si Kim Byungin
Dialogue: 0,0:32:56.70,0:32:59.36,Default,tiramisu,0,0,0,,head ng Detective Department.
Dialogue: 0,0:32:59.46,0:33:01.33,Default,tiramisu,0,0,0,,Matagumpay na trabaho.
Dialogue: 0,0:33:02.43,0:33:05.00,Default,tiramisu,0,0,0,,Salamat, Kamahalan.
Dialogue: 0,0:33:12.58,0:33:15.55,Default,tiramisu,0,0,0,,Nabalitaan ko na ikaw ang pinakabatang nakapasa sa state exam,
Dialogue: 0,0:33:15.55,0:33:17.75,Default,tiramisu,0,0,0,,malakas din sa martial arts.
Dialogue: 0,0:33:18.38,0:33:20.49,Default,tiramisu,0,0,0,,Ngunit sa kabila nito,
Dialogue: 0,0:33:20.49,0:33:22.35,Default,tiramisu,0,0,0,,tumanggi ka sa isang post sa gobyerno,
Dialogue: 0,0:33:22.35,0:33:24.96,Default,tiramisu,0,0,0,,na nagdulot ng pangkalahatang kalituhan.
Dialogue: 0,0:33:24.96,0:33:28.76,Default,tiramisu,0,0,0,,Ano ang nagpabago sa isip mo?
Dialogue: 0,0:33:29.73,0:33:31.80,Default,tiramisu,0,0,0,,"Iligtas ang bansa sa mahihirap na panahon."
Dialogue: 0,0:33:31.80,0:33:34.63,Default,tiramisu,0,0,0,,Sa mahirap na oras na ito gusto kong tumulong
Dialogue: 0,0:33:34.63,0:33:37.37,Default,tiramisu,0,0,0,,kasama ang pagpapanumbalik ng kaayusan sa bansa.
Dialogue: 0,0:33:41.47,0:33:43.31,Default,tiramisu,0,0,0,,Hard time?
Dialogue: 0,0:33:43.58,0:33:46.61,Default,tiramisu,0,0,0,,Paano, tila, itinago ito sa akin ng mga ministro,
Dialogue: 0,0:33:46.61,0:33:48.15,Default,tiramisu,0,0,0,,kaya hindi ako mag-alala.
Dialogue: 0,0:33:48.15,0:33:51.08,Default,tiramisu,0,0,0,,Sino ito? Qing o Japanese?
Dialogue: 0,0:33:51.08,0:33:54.22,Default,tiramisu,0,0,0,,Mga kahirapan sa loob ng bansa
Dialogue: 0,0:33:54.25,0:33:56.89,Default,tiramisu,0,0,0,,mas mapanganib kaysa sa panlabas na mga banta.
Dialogue: 0,0:33:59.29,0:34:02.33,Default,tiramisu,0,0,0,,Bigla tayong nahihirapan sa loob ng bansa?
Dialogue: 0,0:34:02.33,0:34:04.56,Default,tiramisu,0,0,0,,Ibig sabihin...
Dialogue: 0,0:34:14.01,0:34:17.88,Default,tiramisu,0,0,0,,Nilalamig ako.
Dialogue: 0,0:34:17.88,0:34:22.65,Default,tiramisu,0,0,0,,Dapat alam ng isang matalinong hari kung paano pangalagaan ang kanyang kalusugan.
Dialogue: 0,0:34:27.09,0:34:29.79,Default,tiramisu,0,0,0,,
Dialogue: 0,0:34:34.89,0:34:36.33,Default,tiramisu,0,0,0,,Kailangan mong kumain,
Dialogue: 0,0:34:36.33,0:34:38.20,Default,tiramisu,0,0,0,,at pagkatapos ay mag-relax.
Dialogue: 0,0:34:38.20,0:34:41.20,Default,tiramisu,0,0,0,,Ayoko, uupo ako dito hanggang sa tuluyan na akong magkasakit.
Dialogue: 0,0:34:41.20,0:34:42.80,Default,tiramisu,0,0,0,,Hayaan ang katawan na magdusa.
Dialogue: 0,0:34:43.10,0:34:44.50,Default,tiramisu,0,0,0,,Hindi pa rin bagay sa akin.
Dialogue: 0,0:34:44.50,0:34:47.54,Default,tiramisu,0,0,0,,Hayaan siyang malamig at magutom.
Dialogue: 0,0:34:48.54,0:34:50.64,Default,tiramisu,0,0,0,,Gusto ko pa rin.
Dialogue: 0,0:34:55.48,0:34:56.92,Default,tiramisu,0,0,0,,Kamahalan,
Dialogue: 0,0:34:56.92,0:34:59.68,Default,tiramisu,0,0,0,,hindi maibabalik ng pagpapahirap sa iyong katawan ang iyong memorya.
Dialogue: 0,0:34:59.68,0:35:01.79,Default,tiramisu,0,0,0,,Sasaktan mo lang ang sarili mo.
Dialogue: 0,0:35:01.79,0:35:04.36,Default,tiramisu,0,0,0,,Sabihin mo na hindi ito ang iyong katawan,
Dialogue: 0,0:35:04.36,0:35:07.19,Default,tiramisu,0,0,0,,ngunit sa iyo ito, kahit na wala kang maalala.
Dialogue: 0,0:35:07.19,0:35:10.53,Default,tiramisu,0,0,0,,Sino ang magdurusa? Ikaw, siyempre.
Dialogue: 0,0:35:11.30,0:35:13.13,Default,tiramisu,0,0,0,,Kahit walang alaala
Dialogue: 0,0:35:13.13,0:35:15.70,Default,tiramisu,0,0,0,, siguradong matutuwa ka.
Dialogue: 0,0:35:15.70,0:35:19.40,Default,tiramisu,0,0,0,,Tumingin ka sa langit. Anong magandang panahon ngayon!
Dialogue: 0,0:35:23.38,0:35:26.91,Default,tiramisu,0,0,0,,Oo. Walang alikabok sa hangin.
Dialogue: 0,0:35:30.12,0:35:33.69,Default,tiramisu,0,0,0,,Ang simoy ng hangin ay nagdadala ng amoy ng sariwang pataba.
Dialogue: 0,0:35:34.52,0:35:36.92,Default,tiramisu,0,0,0,, Korean food tatlong beses sa isang araw.
Dialogue: 0,0:35:37.92,0:35:39.46,Default,tiramisu,0,0,0,,Paano ka hindi magiging masaya.
Dialogue: 0,0:35:39.46,0:35:41.73,Default,tiramisu,0,0,0,,Oo, siguradong masaya ako.
Dialogue: 0,0:35:42.73,0:35:44.73,Default,tiramisu,0,0,0,,Sumasang-ayon ako sa iyo.
Dialogue: 0,0:35:47.57,0:35:50.50,Default,tiramisu,0,0,0,,Kamahalan, umiiyak ka ba?
Dialogue: 0,0:35:50.50,0:35:53.57,Default,tiramisu,0,0,0,,Hindi, hindi ako umiiyak. Sobrang saya ko.
Dialogue: 0,0:35:53.71,0:35:54.97,Default,tiramisu,0,0,0,,Gaya ng sinabi mo,
Dialogue: 0,0:35:54.97,0:35:57.68,Default,tiramisu,0,0,0,,Susubukan kong mamuhay ng masaya.
Dialogue: 0,0:35:58.34,0:36:02.41,Default,tiramisu,0,0,0,,Nalulungkot ka ba sa kawalan ng mga alaala?
Dialogue: 0,0:36:08.09,0:36:11.12,Default,tiramisu,0,0,0,,Nag-aalala kami sa kalagayan ng reyna.
Dialogue: 0,0:36:11.12,0:36:13.93,Default,tiramisu,0,0,0,,Samakatuwid, hinihiling namin sa iyo na isaalang-alang
Dialogue: 0,0:36:13.93,0:36:16.23,Default,tiramisu,0,0,0,,aming mensahe.
Dialogue: 0,0:36:16.23,0:36:17.80,Default,tiramisu,0,0,0,,Ano ito?
Dialogue: 0,0:36:17.80,0:36:20.73,Default,tiramisu,0,0,0,,Napag-usapan na ba ninyo ang pagpapatalsik sa reyna?
Dialogue: 0,0:36:21.30,0:36:22.73,Default,tiramisu,0,0,0,,-Ano?\N-Ano?
Dialogue: 0,0:36:22.73,0:36:26.64,Default,tiramisu,0,0,0,,Hindi sumusuko ang Reyna sa pagsusumikap na magpakamatay,
Dialogue: 0,0:36:26.64,0:36:30.01,Default,tiramisu,0,0,0,,at kailangan nating palakasin ang posisyon ng courtyard.
Dialogue: 0,0:36:31.21,0:36:34.35,Default,tiramisu,0,0,0,,Isaalang-alang ang pagpapatalsik sa reyna.
Dialogue: 0,0:36:34.88,0:36:39.25,Default,tiramisu,0,0,0,,Nagsinungaling ang Reyna para protektahan
Dialogue: 0,0:36:39.25,0:36:41.72,Default,tiramisu,0,0,0,,concubine Cho.
Dialogue: 0,0:36:41.72,0:36:44.29,Default,tiramisu,0,0,0,,Pagkatapos mahulog sa lawa, nawalan siya ng malay.
Dialogue: 0,0:36:44.29,0:36:46.29,Default,tiramisu,0,0,0,,Itinuring niya ang kanyang sarili na ibang tao.
Dialogue: 0,0:36:46.29,0:36:48.63,Default,tiramisu,0,0,0,,At sa paningin ng tubig ay sinubukan niyang magpakamatay.
Dialogue: 0,0:36:48.63,0:36:50.63,Default,tiramisu,0,0,0,,Kumalat na ang mga tsismis!
Dialogue: 0,0:36:50.63,0:36:52.80,Default,tiramisu,0,0,0,,Ayon sa mga alingawngaw,
Dialogue: 0,0:36:52.80,0:36:54.77,Default,tiramisu,0,0,0,,tapos ang mga salitang Concubine Cho
Dialogue: 0,0:36:54.77,0:36:57.80,Default,tiramisu,0,0,0,,tulak ang reyna, dapat totoo din.
Dialogue: 0,0:36:57.80,0:36:59.07,Default,tiramisu,0,0,0,,Ano?
Dialogue: 0,0:36:59.07,0:37:01.21,Default,tiramisu,0,0,0,,-How dare?-Ikaw.
Dialogue: 0,0:37:01.41,0:37:03.47,Default,tiramisu,0,0,0,,Tahimik!
Dialogue: 0,0:37:04.58,0:37:08.98,Default,tiramisu,0,0,0,,Tatanggihan ko ang kahilingan para sa paglabag sa utos ng paghahatid.
Dialogue: 0,0:37:08.98,0:37:11.35,Default,tiramisu,0,0,0,,Dapat sumama ka muna sa kanya sa Seungjeongwon.
Dialogue: 0,0:37:11.35,0:37:14.42,Default,tiramisu,0,0,0,,Gayunpaman, para akong asawa ng isang reyna
Dialogue: 0,0:37:14.42,0:37:16.69,Default,tiramisu,0,0,0,,at ang taong pinakamalapit sa kanya,
Dialogue: 0,0:37:17.69,0:37:20.66,Default,tiramisu,0,0,0,,Sinasabi ko na maayos ang kanyang isip.
Dialogue: 0,0:37:22.33,0:37:24.96,Default,tiramisu,0,0,0,,-At gayon pa man...\N-Kailangan nating huminahon.
Dialogue: 0,0:37:24.96,0:37:28.73,Default,tiramisu,0,0,0,,Tapusin natin ang pulong ngayon.
Dialogue: 0,0:37:30.34,0:37:32.07,Default,tiramisu,0,0,0,,Pinapayagan ko ito.
Dialogue: 0,0:37:33.10,0:37:34.71,Default,tiramisu,0,0,0,,Kamahalan.
Dialogue: 0,0:37:38.51,0:37:40.31,Default,tiramisu,0,0,0,,Ano ang nagdadala sa iyo dito?
Dialogue: 0,0:37:40.31,0:37:42.61,Default,tiramisu,0,0,0,,Narinig na nandito ka.
Dialogue: 0,0:37:43.98,0:37:47.02,Default,tiramisu,0,0,0,,Narinig mo na ba ang balita?
Dialogue: 0,0:37:48.17,0:37:50.47,Default,tiramisu,0,0,0,,The King is Coming!
Dialogue: 0,0:37:51.29,0:37:52.92,Default,tiramisu,0,0,0,,My queen.
Dialogue: 0,0:37:56.06,0:37:57.33,Default,tiramisu,0,0,0,,Nandito ka na.
Dialogue: 0,0:37:57.33,0:37:59.46,Default,tiramisu,0,0,0,,Ikaw lang ang huli dito.
Dialogue: 0,0:37:59.46,0:38:01.67,Default,tiramisu,0,0,0,,Akala ko parang sa akin,
Dialogue: 0,0:38:01.67,0:38:03.07,Default,tiramisu,0,0,0,,pero ang pinuno ng Detective Department
Dialogue: 0,0:38:03.07,0:38:05.10,Default,tiramisu,0,0,0,,hindi talaga masaya sa akin.
Dialogue: 0,0:38:05.97,0:38:07.01,Default,tiramisu,0,0,0,,Head ng Detective Department?
Dialogue: 0,0:38:07.01,0:38:10.41,Default,tiramisu,0,0,0,,Tinalikuran mo ang reyna at pinahiya siya,
Dialogue: 0,0:38:10.41,0:38:13.41,Default,tiramisu,0,0,0,,na nagligtas sa iyong minamahal.
Dialogue: 0,0:38:13.51,0:38:17.21,Default,tiramisu,0,0,0,,I can imagine how you treated the queen all this time.
Dialogue: 0,0:38:17.58,0:38:20.22,Default,tiramisu,0,0,0,,Marahil kaya niya sinubukang magpakamatay.
Dialogue: 0,0:38:22.65,0:38:24.39,Default,tiramisu,0,0,0,,Huwag mo akong tingnan.
Dialogue: 0,0:38:24.82,0:38:26.99,Default,tiramisu,0,0,0,,Nalilito ang Reyna,
Dialogue: 0,0:38:26.99,0:38:29.43,Default,tiramisu,0,0,0,,kasi sinubukan kong iligtas ang concubine mo.
Dialogue: 0,0:38:29.43,0:38:31.76,Default,tiramisu,0,0,0,,-Ano ang gagawin mo?\N-Ano?
Dialogue: 0,0:38:31.76,0:38:34.30,Default,tiramisu,0,0,0,,Tutulungan ko siyang harapin ito.
Dialogue: 0,0:38:34.30,0:38:38.30,Default,tiramisu,0,0,0,,Paano? Ano ang maaari mong gawin?
Dialogue: 0,0:38:41.51,0:38:43.21,Default,tiramisu,0,0,0,,Nagtatanong ka ngayon
Dialogue: 0,0:38:43.21,0:38:45.68,Default,tiramisu,0,0,0,,tulad ng kapatid ng reyna
Dialogue: 0,0:38:45.68,0:38:48.28,Default,tiramisu,0,0,0,,o bilang adopted son ni Kim Jwageun?
Dialogue: 0,0:38:48.28,0:38:51.05,Default,tiramisu,0,0,0,,Wala kang lakas para protektahan siya.
Dialogue: 0,0:38:51.05,0:38:53.72,Default,tiramisu,0,0,0,,Sinasabi ko ang nakikita ko.
Dialogue: 0,0:38:54.52,0:38:56.39,Default,tiramisu,0,0,0,,Walang kapangyarihan?
Dialogue: 0,0:38:58.86,0:39:00.62,Default,tiramisu,0,0,0,,Tama.
Dialogue: 0,0:39:01.23,0:39:05.30,Default,tiramisu,0,0,0,,Gayunpaman, hindi ko kailangan ng lakas laban sa malakas.
Dialogue: 0,0:39:05.30,0:39:08.40,Default,tiramisu,0,0,0,,Mayroong mas mapayapang paraan.
Dialogue: 0,0:39:08.50,0:39:11.40,Default,tiramisu,0,0,0,,Kailangan ko lang maging masunurin.
Dialogue: 0,0:39:11.40,0:39:13.70,Default,tiramisu,0,0,0,,Upang protektahan ang reyna,
Dialogue: 0,0:39:14.44,0:39:16.67,Default,tiramisu,0,0,0,,Magiging masunurin ako.
Dialogue: 0,0:39:16.91,0:39:18.88,Default,tiramisu,0,0,0,,Hindi na kailangan para dito.
Dialogue: 0,0:39:18.88,0:39:21.61,Default,tiramisu,0,0,0,,Ako mismo ang magpoprotekta sa reyna.
Dialogue: 0,0:39:23.98,0:39:27.02,Default,tiramisu,0,0,0,,Pipigilan ko ang malakas nang mas malakas.
Dialogue: 0,0:39:35.83,0:39:37.30,Default,tiramisu,0,0,0,,Dito.
Dialogue: 0,0:39:37.30,0:39:39.00,Default,tiramisu,0,0,0,,Ano ang nangyayari dito?
Dialogue: 0,0:39:39.00,0:39:40.40,Default,tiramisu,0,0,0,,Nakikita kong ito ang aking problema.
Dialogue: 0,0:39:40.40,0:39:41.83,Default,tiramisu,0,0,0,,Bakit kailangan mong mag-away?
Dialogue: 0,0:39:41.83,0:39:44.87,Default,tiramisu,0,0,0,,Ano ang nangyari? Anong meron?
Dialogue: 0,0:39:44.87,0:39:48.17,Default,tiramisu,0,0,0,,Nakatanggap ako ng mensahe tungkol sa iyong pagpapatalsik.
Dialogue: 0,0:39:49.47,0:39:52.54,Default,tiramisu,0,0,0,,Paano kaya? Nagpasya lang akong mahalin ang lugar na ito.
Dialogue: 0,0:39:52.54,0:39:53.75,Default,tiramisu,0,0,0,,Gusto nilang pumatay,
Dialogue: 0,0:39:53.75,0:39:55.95,Default,tiramisu,0,0,0,,at ngayon lahat ay sabik na ibagsak.
Dialogue: 0,0:39:56.05,0:39:58.42,Default,tiramisu,0,0,0,,May gustong ibagsak ka?
Dialogue: 0,0:39:58.88,0:40:01.35,Default,tiramisu,0,0,0,,Nagalit sa akin ang Queen Dowager.
Dialogue: 0,0:40:02.02,0:40:04.49,Default,tiramisu,0,0,0,,Kakausapin ko siya.
Dialogue: 0,0:40:04.82,0:40:07.06,Default,tiramisu,0,0,0,,Sa totoo lang, alam ko kung paano ito panghawakan.
Dialogue: 0,0:40:08.16,0:40:11.83,Default,tiramisu,0,0,0,,Paano kasi, nilalamig ka rin yata.
Dialogue: 0,0:40:16.17,0:40:17.90,Default,tiramisu,0,0,0,,Ikaw din?
Dialogue: 0,0:40:19.00,0:40:20.84,Default,tiramisu,0,0,0,,Kahit na ito ay apurahan,
Dialogue: 0,0:40:20.84,0:40:23.97,Default,tiramisu,0,0,0,,kailangan mong bumalik at magpahinga.
Dialogue: 0,0:40:25.08,0:40:28.48,Default,tiramisu,0,0,0,,Kung sinabi mo ang lahat ng gusto mo, maaari kang pumunta.
Dialogue: 0,0:40:28.55,0:40:30.85,Default,tiramisu,0,0,0,,Kailangan nating pag-usapan ang mga personal na bagay.
Dialogue: 0,0:40:31.08,0:40:34.49,Default,tiramisu,0,0,0,,May sasabihin ako sa iyo, kaya maghihintay ako.
Dialogue: 0,0:40:36.22,0:40:39.12,Default,tiramisu,0,0,0,,-Babalik ako.\N-Oo.
Dialogue: 0,0:40:47.53,0:40:49.93,Default,tiramisu,0,0,0,,Gusto kong hintayin ang sagot mo,
Dialogue: 0,0:40:49.93,0:40:51.90,Default,tiramisu,0,0,0,,ngunit walang oras.
Dialogue: 0,0:40:51.94,0:40:55.61,Default,tiramisu,0,0,0,,Mula ngayon susundin ko ang distancing rule.
Dialogue: 0,0:40:55.61,0:40:57.78,Default,tiramisu,0,0,0,,Bakit bigla mo itong pinag-uusapan?
Dialogue: 0,0:40:57.78,0:41:00.61,Default,tiramisu,0,0,0,,Kung ayaw mo, ako na lang ang masusunod.
Dialogue: 0,0:41:00.75,0:41:02.35,Default,tiramisu,0,0,0,,Distansya.
Dialogue: 0,0:41:02.75,0:41:04.62,Default,tiramisu,0,0,0,,Mali mo lahat.
Dialogue: 0,0:41:04.62,0:41:07.38,Default,tiramisu,0,0,0,,-Ibigay mo ang kamay mo.\N-Bakit?
Dialogue: 0,0:41:07.92,0:41:09.69,Default,tiramisu,0,0,0,,Ano ang ginagawa mo?
Dialogue: 0,0:41:24.10,0:41:25.90,Default,tiramisu,0,0,0,,Buhay ko
Dialogue: 0,0:41:26.20,0:41:29.74,Default,tiramisu,0,0,0,,ay palaging nasa kamay ng iyong pamilya.
Dialogue: 0,0:41:30.68,0:41:32.98,Default,tiramisu,0,0,0,,Mukhang nabulag ako nito.
Dialogue: 0,0:41:34.21,0:41:38.38,Default,tiramisu,0,0,0,,At hindi ko nakita na ikaw\N ay isang inosenteng babae na
Dialogue: 0,0:41:38.45,0:41:40.85,Default,tiramisu,0,0,0,,sinusubukan ang makakaya.
Dialogue: 0,0:41:42.09,0:41:44.15,Default,tiramisu,0,0,0,,Paumanhin at huli na.
Dialogue: 0,0:41:45.19,0:41:47.76,Default,tiramisu,0,0,0,,Bigyan mo ako ng isa pang pagkakataon.
Dialogue: 0,0:41:48.89,0:41:51.03,Default,tiramisu,0,0,0,,Pagkataong maintindihan ka
Dialogue: 0,0:41:51.23,0:41:55.63,Default,tiramisu,0,0,0,,bilang isang indibidwal na walang anumang pagkiling.
Dialogue: 0,0:41:59.34,0:42:01.04,Default,tiramisu,0,0,0,,Hindi na kailangang gawin ito.
Dialogue: 0,0:42:01.04,0:42:03.14,Default,tiramisu,0,0,0,,Alam kong hindi ka mahilig magpakitang gilas.
Dialogue: 0,0:42:03.21,0:42:06.78,Default,tiramisu,0,0,0,,Ngunit kailangan kong taimtim na humingi ng tawad kahit isang beses.
Dialogue: 0,0:42:06.78,0:42:07.98,Default,tiramisu,0,0,0,,Gawin ang gusto mo.
Dialogue: 0,0:42:07.98,0:42:09.98,Default,tiramisu,0,0,0,,Okay. Yan ang gagawin natin. Pagdistansya.
Dialogue: 0,0:42:09.98,0:42:12.15,Default,tiramisu,0,0,0,,Wala akong mawawala.
Dialogue: 0,0:42:15.59,0:42:19.06,Default,tiramisu,0,0,0,,Kung gayon ngayon ang aming unang araw.
Dialogue: 0,0:42:19.36,0:42:20.39,Default,tiramisu,0,0,0,,Ano?
Dialogue: 0,0:42:20.39,0:42:22.69,Default,tiramisu,0,0,0,,Unang araw ng pagdistansya.
Dialogue: 0,0:42:23.13,0:42:25.43,Default,tiramisu,0,0,0,,Huwag mong sabihin iyan.
Dialogue: 0,0:42:25.43,0:42:28.27,Default,tiramisu,0,0,0,,-Bakit?\N-Huwag mo na lang sabihin. Huwag kang maglakas-loob.
Dialogue: 0,0:42:28.47,0:42:30.57,Default,tiramisu,0,0,0,,Anong mali ang nasabi ko?
Dialogue: 0,0:42:30.57,0:42:31.84,Default,tiramisu,0,0,0,,Ngayon ang unang araw natin.
Dialogue: 0,0:42:31.84,0:42:34.74,Default,tiramisu,0,0,0,,Ang iyong f. Sinabihan niya akong huwag magsalita!
Dialogue: 0,0:42:35.81,0:42:38.21,Default,tiramisu,0,0,0,,Pero sabi ko lang, today is our...
Dialogue: 0,0:42:38.21,0:42:40.44,Default,tiramisu,0,0,0,,Itigil mo na!
Dialogue: 0,0:42:40.98,0:42:43.28,Default,tiramisu,0,0,0,,I bet alam mo kung ano ang ibig sabihin niyan, di ba?
Dialogue: 0,0:42:43.28,0:42:45.32,Default,tiramisu,0,0,0,,Ngunit ngayon ang una naming...
Dialogue: 0,0:42:45.32,0:42:47.52,Default,tiramisu,0,0,0,,Itigil mo na. Nakakadiri!
Dialogue: 0,0:42:47.52,0:42:48.85,Default,tiramisu,0,0,0,,-Pero ito ang unang araw natin.\N-Tumigil ka na.
Dialogue: 0,0:42:48.85,0:42:50.92,Default,tiramisu,0,0,0,,-Namin...\N-Tigilan mo na.
Dialogue: 0,0:42:52.29,0:42:54.96,Default,tiramisu,0,0,0,,Pagkatapos, dahil inayos na namin ito,
Dialogue: 0,0:42:55.23,0:42:58.00,Default,tiramisu,0,0,0,,Gagawin ko ang lahat para protektahan ka.
Dialogue: 0,0:42:58.00,0:43:00.67,Default,tiramisu,0,0,0,,Oh, eksakto. Walang oras para idle.
Dialogue: 0,0:43:00.67,0:43:02.40,Default,tiramisu,0,0,0,,Bye.
Dialogue: 0,0:43:03.03,0:43:05.84,Default,tiramisu,0,0,0,,Stop. Wag kang tumakbo ng ganyan. Huwag tumakbo.
Dialogue: 0,0:43:07.07,0:43:08.77,Default,tiramisu,0,0,0,,Maaari kang masaktan.
Dialogue: 0,0:43:22.55,0:43:24.36,Default,zinger,0,0,0,,Magsalita.
Dialogue: 0,0:43:24.36,0:43:28.73,Default,zinger,0,0,0,,Kung hindi masaya ang reyna, ikaw din.
Dialogue: 0,0:43:28.96,0:43:31.93,Default,zinger,0,0,0,,-Banta ba ito?\N-Ang concern ko lang.
Dialogue: 0,0:43:33.20,0:43:37.80,Default,zinger,0,0,0,,Kapatid mo lang siya, pero masyado kang protective.
Dialogue: 0,0:43:37.80,0:43:40.80,Default,zinger,0,0,0,,Masyado kang walang malasakit, Kamahalan.
Dialogue: 0,0:43:41.31,0:43:44.24,Default,zinger,0,0,0,,Alam kong wala akong gaanong kapangyarihan,
Dialogue: 0,0:43:44.31,0:43:46.51,Default,zinger,0,0,0,,ngunit kailangang obserbahan ang ilang disente.
Dialogue: 0,0:43:46.51,0:43:49.15,Default,zinger,0,0,0,,Kung tatawid ka ulit sa linya,
Dialogue: 0,0:43:49.15,0:43:52.15,Default,singer,0,0,0,,Itataas ko ang isyu ng iyong pag-uugali.
Dialogue: 0,0:43:53.32,0:43:55.45,Default,zinger,0,0,0,,Halika.
Dialogue: 0,0:43:57.36,0:43:59.52,Default,zinger,0,0,0,,Ipapasulat kita
Dialogue: 0,0:44:00.86,0:44:03.43,Default,zinger,0,0,0,,napakahabang sulat ng paghingi ng tawad.
Dialogue: 0,0:44:05.56,0:44:08.33,Default,zinger,0,0,0,,Mahaba lang.
Dialogue: 0,0:44:08.83,0:44:11.30,Default,zinger,0,0,0,,Maaaring kailanganin mong mapuyat buong gabi.
Dialogue: 0,0:44:12.10,0:44:14.47,Default,zinger,0,0,0,,At sasakit ang iyong mga daliri.
Dialogue: 0,0:44:28.59,0:44:31.52,Default,zinger,0,0,0,,Naniniwala ba talaga sila na maaari siyang mapatalsik?
Dialogue: 0,0:44:31.52,0:44:33.09,Default,zinger,0,0,0,,Dahil sa isang simpleng kahilingan?
Dialogue: 0,0:44:33.09,0:44:36.63,Default,zinger,0,0,0,,Sinusubukan nilang makaipon ng kapangyarihan gamit ito.
Dialogue: 0,0:44:37.26,0:44:39.73,Default,zinger,0,0,0,,Tipunin nila ang mga ayaw sa ating uri,
Dialogue: 0,0:44:39.73,0:44:42.53,Default,zinger,0,0,0,,at tataas ang bilang ng mga kahilingan. Lahat ay halata.
Dialogue: 0,0:44:42.53,0:44:46.40,Default,zinger,0,0,0,,How dare they make their move so recklessly?
Dialogue: 0,0:44:46.40,0:44:48.74,Default,zinger,0,0,0,,Dapat napagdaanan natin ito kahit isang beses.
Dialogue: 0,0:44:48.74,0:44:50.84,Default,zinger,0,0,0,,Kamahalan,
Dialogue: 0,0:44:50.84,0:44:53.54,Default,zinger,0,0,0,,dumating na ang reyna.
Dialogue: 0,0:44:54.98,0:44:56.71,Default,zinger,0,0,0,,Papasukin mo ako.
Dialogue: 0,0:45:16.17,0:45:20.60,Default,zinger,0,0,0,,Paumanhin sa pag-istorbo sa iyo.
Dialogue: 0,0:45:22.71,0:45:26.58,Default,zinger,0,0,0,,Karapat-dapat akong matanggal sa aking titulo.
Dialogue: 0,0:45:27.48,0:45:29.78,Default,zinger,0,0,0,,Ngunit kahit na,
Dialogue: 0,0:45:29.91,0:45:32.65,Default,zinger,0,0,0,,dapat gawin ito ng dowager queen.
Dialogue: 0,0:45:32.65,0:45:37.29,Default,zinger,0,0,0,,Mali kung gagawa nito ang isang tao mula sa pamilyang Cho.
Dialogue: 0,0:45:38.99,0:45:41.29,Default,zinger,0,0,0,,Kahit anong klaseng tanga ka, walang magtitiis,
Dialogue: 0,0:45:41.29,0:45:43.89,Default,zinger,0,0,0,,upang ang kanyang mga nasasakupan \N ay mapangasiwaan ng ibang tao.
Dialogue: 0,0:45:43.90,0:45:45.66,Default,zinger,0,0,0,,Ito ay isang bagay ng pagmamataas.
Dialogue: 0,0:45:45.66,0:45:48.53,Default,zinger,0,0,0,,Kung ang isang tao mula sa pamilyang Cho ay nag-alis sa akin ng aking titulo,
Dialogue: 0,0:45:48.53,0:45:50.84,Default,zinger,0,0,0,,hindi ito ang matatalo ko,
Dialogue: 0,0:45:50.84,0:45:53.54,Default,zinger,0,0,0,,ito ay magiging isang pagkatalo para sa pamilya Kim.
Dialogue: 0,0:45:54.41,0:45:56.41,Default,mang-aawit,0,0,0,,Kung naiintindihan mo ito,
Dialogue: 0,0:45:56.41,0:45:58.38,Default,singer,0,0,0,,paano niya magagawa ang kailangan niyang maging responsable?
Dialogue: 0,0:45:58.38,0:46:00.61,Default,zinger,0,0,0,,Umaasa sila sa mga tsismis.
Dialogue: 0,0:46:00.61,0:46:02.08,Default,zinger,0,0,0,,Ako na ang bahala.
Dialogue: 0,0:46:02.08,0:46:03.11,Default,zinger,0,0,0,,At paano?
Dialogue: 0,0:46:03.11,0:46:04.65,Default,mang-aawit,0,0,0,,Ang krisis ang ating pagkakataon.
Dialogue: 0,0:46:04.65,0:46:07.25,Default,zinger,0,0,0,,Kung bibigyan mo ako ng oras,\NI'll use it,
Dialogue: 0,0:46:07.25,0:46:10.32,Default,zinger,0,0,0,,upang baguhin ang iyong reputasyon.
Dialogue: 0,0:46:20.23,0:46:22.83,Default,zinger,0,0,0,,Ngayon ang hari ay pumanig sa iyo,
Dialogue: 0,0:46:22.83,0:46:25.70,Default,zinger,0,0,0,,noong natanggap ko ang reklamo.
Dialogue: 0,0:46:26.64,0:46:28.67,Default,zinger,0,0,0,,Idiot Cheoljong?
Dialogue: 0,0:46:29.57,0:46:31.64,Default,zinger,0,0,0,,Ano ang ginawa ng reyna,
Dialogue: 0,0:46:31.64,0:46:34.65,Default,zinger,0,0,0,,hindi walang kabuluhan.
Dialogue: 0,0:46:37.55,0:46:41.42,Default,zinger,0,0,0,,Dapat kong turuan ng leksyon ang Inang Reyna.
Dialogue: 0,0:46:41.95,0:46:44.96,Default,zinger,0,0,0,,Ipapakita ko sa kanya kung sino ang boss sa palasyong ito.
Dialogue: 0,0:46:50.96,0:46:53.00,Default,zinger,0,0,0,,Ito ba lahat ang may hawak ng palanquin?
Dialogue: 0,0:46:53.83,0:46:54.83,Default,zinger,0,0,0,,Basta...
Dialogue: 0,0:46:54.83,0:46:56.63,Default,zinger,0,0,0,,Piliin muli. Tiyaking nakakatawa sila.
Dialogue: 0,0:46:56.63,0:46:58.90,Default,zinger,0,0,0,,Oo, Kamahalan. Nakakatuwa.
Dialogue: 0,0:46:59.57,0:47:01.21,Default,zinger,0,0,0,,Ano?
Dialogue: 0,0:47:03.81,0:47:06.21,Default,zinger,0,0,0,,Hayaan silang matangkad at may magandang pigura.
Dialogue: 0,0:47:06.21,0:47:08.18,Default,zinger,0,0,0,,Malinaw ang tuod, at ang bata.
Dialogue: 0,0:47:11.25,0:47:14.59,Default,zinger,0,0,0,,Pipili mo ba talaga ang mga porter?
Dialogue: 0,0:47:14.79,0:47:17.79,Default,zinger,0,0,0,,Pipili ko hindi lang ang mga palanquin bearers.
Dialogue: 0,0:47:18.06,0:47:20.06,Default,zinger,0,0,0,,Magugulat ka kapag naintindihan mo.
Dialogue: 0,0:47:21.73,0:47:24.19,Default,zinger,0,0,0,,Piliin ko...
Dialogue: 0,0:47:32.64,0:47:35.74,Default,zinger,0,0,0,, -Nga pala. May narinig ka bang tsismis?\N-Ano?
Dialogue: 0,0:47:35.74,0:47:38.34,Default,zinger,0,0,0,,Hindi sinubukan ng Reyna na magpakamatay.
Dialogue: 0,0:47:38.34,0:47:40.94,Default,zinger,0,0,0,,Nais niyang iligtas ang hari at ang kanyang asawa.
Dialogue: 0,0:47:43.21,0:47:45.38,Default,zinger,0,0,0,,Nais kong iligtas ang hari at ang kanyang asawa,
Dialogue: 0,0:47:45.38,0:47:47.72,Default,zinger,0,0,0,,kaya nagsinungaling siya at sinabing ito ay pagpapakamatay.
Dialogue: 0,0:47:47.72,0:47:49.15,Default,zinger,0,0,0,,Hot!
Dialogue: 0,0:47:49.15,0:47:50.89,Default,zinger,0,0,0,,-Pamilya...\N-O asawa.
Dialogue: 0,0:47:50.89,0:47:52.62,Default,zinger,0,0,0,,-Iyan ang...\N-Tanong.
Dialogue: 0,0:47:52.62,0:47:56.16,Default,zinger,0,0,0,,At sa huli ay nawalan siya ng tiwala ng dowager queen.
Dialogue: 0,0:47:56.16,0:47:59.26,Default,zinger,0,0,0,,At naglagay siya ng pilak na kutsilyo sa kanyang leeg at sinabing:
Dialogue: 0,0:47:59.26,0:48:02.03,Default,zinger,0,0,0,,"Tatanan ako sa kapus-palad na kapalarang ito,
Dialogue: 0,0:48:02.03,0:48:04.17,Default,zinger,0,0,0,,kung saan hindi ako makapili ng panig."
Dialogue: 0,0:48:05.47,0:48:07.51,Default,singer,0,0,0,,Iyon ang sinabi niya.
Dialogue: 0,0:48:07.51,0:48:09.54,Default,zinger,0,0,0,,Siya ay isang mangkukulam.
Dialogue: 0,0:48:09.54,0:48:12.91,Default,zinger,0,0,0,,Nabalitaan ng tsismis na pumunta siya sa langit.
Dialogue: 0,0:48:13.64,0:48:15.71,Default,zinger,0,0,0,,Dahil nahulog ka sa lawa?
Dialogue: 0,0:48:15.85,0:48:19.92,Default,zinger,0,0,0,,At nang makilala ko ang Jade Emperor, naging fairy ako.
Dialogue: 0,0:48:27.02,0:48:29.09,Default,zinger,0,0,0,,Mahusay.
Dialogue: 0,0:48:29.09,0:48:31.63,Default,zinger,0,0,0,,Hindi lang ako pumipili ng mga porter,
Dialogue: 0,0:48:31.63,0:48:33.10,Default,zinger,0,0,0,,Pumili ako ng mga storyteller.
Dialogue: 0,0:48:33.10,0:48:37.30,Default,singer,0,0,0,,Mga live na tabloid na magpapakalat ng tsismis na parang impeksyon.
Dialogue: 0,0:48:37.74,0:48:39.04,Default,zinger,0,0,0,,Ano?
Dialogue: 0,0:48:39.04,0:48:42.34,Default,zinger,0,0,0,,Kapag nagsimulang kumalat ang mga tsismis,\N ito ay nagiging impeksyon.
Dialogue: 0,0:48:42.34,0:48:45.51,Default,zinger,0,0,0,,Nagkakalat sila nang labis na kahit na ang nagsimula ng lahat ay hindi ito kayang pigilan.
Dialogue: 0,0:48:45.51,0:48:48.55,Default,zinger,0,0,0,,At kumalat sila sa hindi inaasahang paraan.
Dialogue: 0,0:48:48.55,0:48:50.48,Default,zinger,0,0,0,,Kung hindi niya sinubukang magpakamatay,
Dialogue: 0,0:48:50.48,0:48:54.08,Default,zinger,0,0,0,,kaya ang nagtulak sa kanya sa lawa...
Dialogue: 0,0:48:55.15,0:48:58.16,Default,zinger,0,0,0,,Ibig sabihin, itinaya ng reyna ang kanyang buhay upang
Dialogue: 0,0:48:58.16,0:49:00.52,Default,zinger,0,0,0,,iligtas ang concubine na nagtangkang pumatay sa kanya?
Dialogue: 0,0:49:01.73,0:49:03.59,Default,zinger,0,0,0,,Mommies.
Dialogue: 0,0:49:07.97,0:49:10.10,Default,zinger,0,0,0,,Somehow bigla akong nakaramdam ng panginginig.
Dialogue: 0,0:49:11.34,0:49:13.97,Default,zinger,0,0,0,,Panahon na para magpahinga ka.
Dialogue: 0,0:49:14.21,0:49:16.21,Default,zinger,0,0,0,,Hindi ito gagana. Ihahatid kita kung kailangan ko.
Dialogue: 0,0:49:16.21,0:49:18.88,Default,zinger,0,0,0,,Halika. Okay, okay.
Dialogue: 0,0:49:18.88,0:49:22.01,Default,zinger,0,0,0,,Hindi nagmamaktol sa akin si Court lady Choi, kaya ngayon ikaw.
Dialogue: 0,0:49:22.01,0:49:24.58,Default,mang-aawit,0,0,0,,Isang uri ng batas sa pag-iingat para sa pag-ungol, o ano?
Dialogue: 0,0:49:25.78,0:49:29.32,Default,zinger,0,0,0,,Nga pala, matagal ko na siyang hindi nakikita.
Dialogue: 0,0:49:29.39,0:49:31.52,Default,zinger,0,0,0,,Nakakatuwa.
Dialogue: 0,0:49:33.02,0:49:35.86,Default,zinger,0,0,0,,Pwede mo ba akong yakapin ng mahigpit? Malamig.
Dialogue: 0,0:50:12.00,0:50:15.73,Default,zinger,0,0,0,,Kamahalan!
Dialogue: 0,0:50:15.73,0:50:18.34,Default,zinger,0,0,0,,Paano mo mapipinsala ang iyong sarili?
Dialogue: 0,0:50:18.34,0:50:21.77,Default,zinger,0,0,0,,Gusto mo ba akong mabaliw?
Dialogue: 0,0:50:21.77,0:50:25.28,Default,zinger,0,0,0,,Paano mo maaayos ang paglangoy kasama ang hari?
Dialogue: 0,0:50:25.28,0:50:28.41,Default,zinger,0,0,0,,Gusto mo bang ilagay ang bansa sa isang mapanganib na sitwasyon?
Dialogue: 0,0:50:28.41,0:50:30.48,Default,zinger,0,0,0,,Talisman? Ritual?
Dialogue: 0,0:50:30.48,0:50:33.92,Default,zinger,0,0,0,,Hindi ka dapat masangkot sa mga ganitong pagkiling.
Dialogue: 0,0:50:33.92,0:50:37.82,Default,zinger,0,0,0,,At hindi mo rin masasabi iyon.
Dialogue: 0,0:50:37.82,0:50:40.76,Default,zinger,0,0,0,,Mula sa una hanggang sa huli,
Dialogue: 0,0:50:40.76,0:50:45.73,Default,zinger,0,0,0,,wala sa mga ito ang pinapayagan!
Dialogue: 0,0:50:56.11,0:51:00.81, Default, zinger,0,0,0,, Kahit papaano ay hindi na ako gumaan pagkatapos noon.
Dialogue: 0,0:51:00.81,0:51:04.78,Default,zinger,0,0,0,,Kung magreklamo ako sa kanya, hindi mapakali ang Kamahalan.
Dialogue: 0,0:51:05.45,0:51:09.75,Default,zinger,0,0,0,,Kung hindi, hindi ako mapakali.
Dialogue: 0,0:51:10.32,0:51:15.29,Default,zinger,0,0,0,,So ano ang dapat kong gawin?
Dialogue: 0,0:51:21.60,0:51:27.00,Default,zinger,0,0,0,,Kamahalan!
Dialogue: 0,0:51:27.14,0:51:30.04,Default,zinger,0,0,0,,-Narinig mo na ba ang mga tsismis? \N-Ano?
Dialogue: 0,0:51:30.04,0:51:32.44,Default,zinger,0,0,0,,Ito lang ang ibinubulong nila sa palasyo.
Dialogue: 0,0:51:32.44,0:51:35.25,Default,zinger,0,0,0,,Sinasabi nila na itinaya ng reyna ang kanyang buhay,
Dialogue: 0,0:51:35.25,0:51:37.58,Default,zinger,0,0,0,,upang iligtas ka, na nagtangkang pumatay sa kanya.
Dialogue: 0,0:51:37.72,0:51:39.62,Default,zinger,0,0,0,,Sino ang makakapagsabi niyan?
Dialogue: 0,0:51:40.18,0:51:42.22,Default,zinger,0,0,0,,At hindi ang reyna?
Dialogue: 0,0:51:42.35,0:51:44.89,Default,zinger,0,0,0,,Binago ng tsismis na siya ay isang lokal na mangkukulam,
Dialogue: 0,0:51:44.89,0:51:47.22,Default,zinger,0,0,0,,na siya ay isang Buddha, isang diwata, isang banal na babae.
Dialogue: 0,0:51:47.22,0:51:50.36,Default,zinger,0,0,0,,Nagawa niyang baguhin ang mood ng lahat.
Dialogue: 0,0:51:51.80,0:51:56.17,Default,zinger,0,0,0,,Ngayon susumpain ka nila at sasabihing imoral ka.
Dialogue: 0,0:51:57.57,0:52:00.70,Default,zinger,0,0,0,,Siya ang may planong ito sa simula pa lang.
Dialogue: 0,0:52:00.70,0:52:04.18,Default,zinger,0,0,0,,Lumapit siya sa akin sa Sononjong hall at pinagbantaan ako.
Dialogue: 0,0:52:04.18,0:52:06.01,Default,zinger,0,0,0,,Kaya nga.
Dialogue: 0,0:52:07.38,0:52:09.98,Default,zinger,0,0,0,,Pupunta ako sa hari at sasabihin sa kanya,
Dialogue: 0,0:52:09.98,0:52:13.42,Default,zinger,0,0,0,,para hindi na siya malinlang ng reyna.
Dialogue: 0,0:52:13.82,0:52:15.55,Default,zinger,0,0,0,,Hindi sigurado.
Dialogue: 0,0:52:16.15,0:52:20.12,Default,zinger,0,0,0,,Maniniwala ba siya sa iyong mga salita?
Dialogue: 0,0:52:20.36,0:52:23.46,Default,zinger,0,0,0,,Paniniwalaan ng hari ang sasabihin ko sa kanya.
Dialogue: 0,0:52:23.46,0:52:27.70,Default,zinger,0,0,0,,Tinanggihan niya ang kahilingang mapatalsik ang reyna.
Dialogue: 0,0:52:33.07,0:52:35.81,Default,zinger,0,0,0,,Dumating na ang royal concubine.
Dialogue: 0,0:52:40.34,0:52:42.01,Default,zinger,0,0,0,,Hwajin.
Dialogue: 0,0:52:43.45,0:52:47.35,Default,zinger,0,0,0,,Malapit lang sana kitang makita,\NMay kailangan tayong pag-usapan.
Dialogue: 0,0:52:47.95,0:52:50.45,Default,zinger,0,0,0,,Tungkol saan?
Dialogue: 0,0:52:50.45,0:52:52.62,Default,zinger,0,0,0,,Ngayon sa council
Dialogue: 0,0:52:52.62,0:52:55.89,Default,zinger,0,0,0,,Nakatanggap ako ng petisyon para mapatalsik ang reyna.
Dialogue: 0,0:52:57.06,0:52:58.46,Default,zinger,0,0,0,,Ganun ba?
Dialogue: 0,0:52:58.46,0:53:01.63,Default,zinger,0,0,0,,Inilagay ng Reyna ang sarili sa panganib para iligtas tayo,
Dialogue: 0,0:53:01.63,0:53:04.37,Default,zinger,0,0,0,,Akala ko mali ang lumayo.
Dialogue: 0,0:53:04.60,0:53:09.24,Default,zinger,0,0,0,,Kaya gusto kong hilingin sa royal secretariat na ipaalala ito.
Dialogue: 0,0:53:09.27,0:53:11.04,Default,zinger,0,0,0,,Pakialam mo ba?
Dialogue: 0,0:53:11.48,0:53:14.11,Default,zinger,0,0,0,,Gusto mo bang tanungin ko ang tatay ko?
Dialogue: 0,0:53:14.11,0:53:18.35,Default,zinger,0,0,0,,Sobrang iginagalang siya, maraming sumusunod sa kanya.
Dialogue: 0,0:53:21.39,0:53:23.49,Default,Tol,0,0,0,,O masyado bang kumplikado ang kahilingan ko?
Dialogue: 0,0:53:26.72,0:53:28.06,Default,Tanging,0,0,0,,Hindi naman.
Dialogue: 0,0:53:28.06,0:53:31.70,Default,Tol,0,0,0,,Ako mismo ang mag-aabiso sa tatay ko.
Dialogue: 0,0:53:32.26,0:53:33.46,Default,Tol,0,0,0,,Salamat.
Dialogue: 0,0:53:33.46,0:53:35.13,Default,Tol,0,0,0,,Kamahalan.
Dialogue: 0,0:53:35.13,0:53:39.04,Default,Tol,0,0,0,,Pagdating ko dito, isa lang ang gusto ko.
Dialogue: 0,0:53:39.27,0:53:42.21,Default,Toly,0,0,0,,Upang maging suporta mo, tulad ng sa una nating pagkikita.
Dialogue: 0,0:53:42.21,0:53:44.67,Default,Tol,0,0,0,,Para sa tabi ko pwede ka
Dialogue: 0,0:53:44.98,0:53:48.01,Default,Tol,0,0,0,,kalimutan mo ang lahat ng iyong takot.
Dialogue: 0,0:53:49.61,0:53:52.72,Default,Toly,0,0,0,,Malaking aliw ka na sa akin.
Dialogue: 0,0:53:52.98,0:53:56.12,Default,Tol,0,0,0,,Gayunpaman, kami pa rin
Dialogue: 0,0:53:56.82,0:53:59.49,Default,Toly,0,0,0,,wala kaming isang gabing magkasama.
Dialogue: 0,0:54:04.26,0:54:06.63,Default,Toly,0,0,0,,Kasalanan ko kung bakit ka nag-iisa.
Dialogue: 0,0:54:06.96,0:54:09.13,Default,Tol,0,0,0,,Naiintindihan ko lahat, naging busy ka.
Dialogue: 0,0:54:09.13,0:54:11.27,Default,Tolya,0,0,0,,Naligaw ako ng demonyo.
Dialogue: 0,0:54:11.80,0:54:13.94,Default,Toly,0,0,0,,Hintayin mo ako sa iyong mga silid ngayong gabi.
Dialogue: 0,0:54:14.57,0:54:17.34,Default,Tol,0,0,0,,Pero bukas ng gabi dapat
Dialogue: 0,0:54:17.34,0:54:19.31,Default,Tol,0,0,0,,spend with Her Majesty.
Dialogue: 0,0:54:19.68,0:54:21.85,Default,Tol,0,0,0,,Hindi ito ang iyong alalahanin.
Dialogue: 0,0:54:22.55,0:54:24.98,Default,Tol,0,0,0,,Pagkatapos ay bibisitahin ko ang reyna at pasayahin siya ng kaunti.
Dialogue: 0,0:54:24.98,0:54:27.12,Default,Tol,0,0,0,,At pagkatapos ay uupo ako kaagad para sumulat sa aking ama.
Dialogue: 0,0:54:27.12,0:54:29.05,Default,Tol,0,0,0,,Maganda sana.
Dialogue: 0,0:54:37.23,0:54:39.53,Default,Tol,0,0,0,,Dumating si Concubine Cho para bisitahin ang Her Majesty.
Dialogue: 0,0:54:39.53,0:54:41.70,Default,Tol,0,0,0,,Paumanhin, Masama ang kanyang kamahalan,
Dialogue: 0,0:54:41.70,0:54:43.80,Default,Tol,0,0,0,,kaya uminom siya ng medicinal decoction
Dialogue: 0,0:54:43.80,0:54:46.07,Default,Tol,0,0,0,,at nakatulog.
Dialogue: 0,0:54:46.70,0:54:48.37,Default,Tol,0,0,0,,Nakakainis.
Dialogue: 0,0:54:48.41,0:54:50.14,Default,Tol,0,0,0,,Well, babalik ako sa ibang pagkakataon.
Dialogue: 0,0:55:02.89,0:55:04.55,Default,Tolya,0,0,0,,Pumunta ka na ba?
Dialogue: 0,0:55:05.92,0:55:08.69,Default,Tol,0,0,0,,Natutulog ka lang na parang sanggol...
Dialogue: 0,0:55:14.10,0:55:16.87,Default,Tol,0,0,0,,At sinabi nila sa akin na masama ang pakiramdam mo.
Dialogue: 0,0:55:19.17,0:55:21.81,Default,Tol,0,0,0,,Hindi ko pa maipagmamalaki na maayos na ang pakiramdam ko,
Dialogue: 0,0:55:22.81,0:55:25.94,Default,Tol,0,0,0,,gayunpaman, wala akong pinagsisisihan. Kailangan ni Joseon ng isang bayani.
Dialogue: 0,0:55:26.61,0:55:29.48,Default,Tol,0,0,0,,-Bayani? \N-Bakit tayo nakatayo sa pintuan?
Dialogue: 0,0:55:29.48,0:55:31.35,Default,Tol,0,0,0,,Pumasok ka na.
Dialogue: 0,0:55:40.76,0:55:42.29,Default,Tol,0,0,0,,Pabayaan mo kami para...
Dialogue: 0,0:55:42.29,0:55:45.70,Default,Tanging,0,0,0,,Para makapag-usap tayo sa kalmadong kapaligiran.
Dialogue: 0,0:56:00.74,0:56:02.65,Default,Tol,0,0,0,,Gawing komportable ang iyong sarili.
Dialogue: 0,0:56:13.32,0:56:15.59,Default,Tolya,0,0,0,,Bakit ka nakaupo sa malayo?
Dialogue: 0,0:56:16.16,0:56:18.66,Default,Tolya,0,0,0,,As if not native.
Dialogue: 0,0:56:19.06,0:56:20.90,Default,Tolya,0,0,0,,Dapat kang lumapit.
Dialogue: 0,0:56:20.90,0:56:22.63,Default,Tol,0,0,0,,Masarap din ang pakiramdam ko dito.
Dialogue: 0,0:56:24.03,0:56:27.87,Default,Tol,0,0,0,,Pagkatapos ay uupo ako nang mas malapit.
Dialogue: 0,0:56:27.87,0:56:30.14,Default,Tol,0,0,0,,Nagpakita ako bilang isang prinsipe sa isang puting kabayo at iniligtas siya.
Dialogue: 0,0:56:30.14,0:56:33.28,Default,Tolya,0,0,0,,Sa wakas, ang kanyang masamang tingin\N ay mapupuno ng pagmamahal at pagsamba.
Dialogue: 0,0:56:36.41,0:56:38.21,Default,Tol,0,0,0,,Ano? Pero bakit?
Dialogue: 0,0:56:38.88,0:56:40.15,Default,Toly,0,0,0,,Nagbago ang iyong pananaw.
Dialogue: 0,0:56:40.15,0:56:43.42,Default,Tol,0,0,0,,Pero bakit mas malamig pa siya kaysa dati?
Dialogue: 0,0:56:43.89,0:56:46.69,Default,Tol,0,0,0,,Hihilingin ko sa tatay ko na kunin ang petisyon.
Dialogue: 0,0:56:47.42,0:56:50.93,Default,Tol,0,0,0,,Kaya magiging pantay tayo.
Dialogue: 0,0:56:52.33,0:56:54.06,Default,Tol,0,0,0,,Salamat.
Dialogue: 0,0:56:54.06,0:56:58.47,Default,Tol,0,0,0,,Malamang na iniisip mo na ang lahat ay nangyayari sa iyo.
Dialogue: 0,0:56:59.04,0:57:00.64,Default,Tol,0,0,0,,Ano ka ba, hindi naman.
Dialogue: 0,0:57:00.64,0:57:02.71,Default,Tol,0,0,0,,Sa tingin ko ay wala talagang gumagana dito.
Dialogue: 0,0:57:02.71,0:57:04.88,Default,Tol,0,0,0,,Napagpasyahan naming ibalik ang lokasyon sa ganitong paraan
Dialogue: 0,0:57:04.88,0:57:06.84,Default,Tol,0,0,0,,His Majesty after all your lies?
Dialogue: 0,0:57:06.84,0:57:08.58,Default,Tol,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:57:08.58,0:57:12.05,Default,Tol,0,0,0,,Siyempre, hindi ako isa sa mga pinaka-tapat,\N pero hindi ako yumuko sa pagsisinungaling.
Dialogue: 0,0:57:12.38,0:57:14.62,Default,Toly,0,0,0,,Alam kong gagawin mo ang iyong sarili na parang isang simpleng tao.
Dialogue: 0,0:57:14.62,0:57:17.19,Default,Tol,0,0,0,,Ano? Hindi ako nagtatayo ng kahit ano.
Dialogue: 0,0:57:19.76,0:57:21.79,Default,Tol,0,0,0,,Naulit ko na ito ng maraming beses.
Dialogue: 0,0:57:21.79,0:57:25.50,Default,Tol,0,0,0,,Hindi ako interesado sa lahat.
Dialogue: 0,0:57:26.56,0:57:28.23,Default,Tol,0,0,0,,Okay.
Dialogue: 0,0:57:28.47,0:57:31.27,Default,Tol,0,0,0,,Sa pagkakataong ito ay maniniwala na ako.
Dialogue: 0,0:57:32.84,0:57:35.71,Default,Toly,0,0,0,,Siguro pwede kang magpalipas ng gabi\Npara mas mapalapit pa?
Dialogue: 0,0:57:35.71,0:57:37.14,Default,Toly,0,0,0,,Magkakaroon tayo ng pajama party.
Dialogue: 0,0:57:37.14,0:57:40.18,Default,Toly,0,0,0,,Ibig sabihin, isang party na naka-underwear.
Dialogue: 0,0:57:40.18,0:57:44.31,Default,Tol,0,0,0,,Ipapalipas ko ang gabing ito kasama ng Kanyang Kamahalan.
Dialogue: 0,0:57:45.42,0:57:47.05,Default,Tol,0,0,0,,Paano kaya?!
Dialogue: 0,0:57:47.55,0:57:49.35,Default,Tol,0,0,0,,At dinurog mo ang iyong puso,
Dialogue: 0,0:57:49.62,0:57:52.49,Default,Tolya,0,0,0,,kaya pumunta ka rin para sabihin ito sa akin ng personal?
Dialogue: 0,0:57:52.49,0:57:55.96,Default,Tolya,0,0,0,,Ganyan na agad? Walang puso?
Dialogue: 0,0:57:56.69,0:57:59.86,Default,Tol,0,0,0,,Sa paanuman masakit ang iyong galit para sa isang taong hindi interesado sa hari.
Dialogue: 0,0:57:59.86,0:58:01.43,Default,Tol,0,0,0,,Hindi ako interesado sa kanya.
Dialogue: 0,0:58:01.43,0:58:04.17,Default,Toly,0,0,0,,Pero wala akong sinabi tungkol sa iyo.
Dialogue: 0,0:58:04.30,0:58:07.40,Default,Tol,0,0,0,,Kaya patunayan mo na sincere ang pagmamahal mo sa akin.
Dialogue: 0,0:58:07.40,0:58:11.34,Default,Tol,0,0,0,,Kung ang iyong mga kilos ay muling magkakaiba sa iyong mga salita,
Dialogue: 0,0:58:12.51,0:58:15.48,Default,Toly,0,0,0,, sisihin mo ang iyong sarili. Hindi mo ito mahahanap ng sapat.
Dialogue: 0,0:58:17.92,0:58:21.32,Default,Tol,0,0,0,,Dahil determinado ka, naghuhugas ako ng kamay.
Dialogue: 0,0:58:22.49,0:58:24.15,Default,Tol,0,0,0,,So be it.
Dialogue: 0,0:58:24.25,0:58:28.36,Default,Toly,0,0,0,,I surrender, my blessing to you.
Dialogue: 0,0:58:28.53,0:58:30.36,Default,Toly,0,0,0,,Ngunit wala kang ideya kung ano ang nawala sa iyo.
Dialogue: 0,0:58:30.36,0:58:32.80,Default,Tolya,0,0,0,,Hindi ko napansin ang kaligayahan sa ilalim ng aking ilong.
Dialogue: 0,0:58:33.63,0:58:35.27,Default,Tol,0,0,0,,Pupunta ako.
Dialogue: 0,0:58:46.18,0:58:48.51,Default,Tolya,0,0,0,,Ito ay mahirap na basagin.
Dialogue: 0,0:58:50.68,0:58:53.15,Default,Tol,0,0,0,,Ang lupit na babae.
Dialogue: 0,0:59:08.27,0:59:13.07,Default,Toll,0,0,0,,15, 20...
Dialogue: 0,0:59:18.04,0:59:20.01,Default,Tol,0,0,0,,Ano ang pagmamay-ari?
Dialogue: 0,0:59:21.55,0:59:25.01,Default,Toly,0,0,0,,Mabigat ang puso ko, nalulungkot ako.
Dialogue: 0,0:59:25.55,0:59:28.09,Default,Tolya,0,0,0,,Pumunta ako dito para pagalingin ang sugatan kong puso.
Dialogue: 0,0:59:28.09,0:59:31.09,Default,Tol,0,0,0,,Maling address ang napunta mo.
Dialogue: 0,0:59:31.09,0:59:34.12,Default,Tol,0,0,0,,We trade a lot of things,
Dialogue: 0,0:59:34.12,0:59:36.33,Default,Toly,0,0,0,,ngunit wala kaming anumang gamot.
Dialogue: 0,0:59:36.33,0:59:38.26,Default,Tol,0,0,0,,I ask you, magsasara na tayo.
Dialogue: 0,0:59:38.26,0:59:40.30,Default,Tol,0,0,0,,Tara, doon na ang labasan.
Dialogue: 0,0:59:41.03,0:59:43.37,Default,Tol,0,0,0,,-Pero ako...\N-Please.
Dialogue: 0,0:59:45.37,0:59:47.37,Default,Toly,0,0,0,,Gusto ko ang mahimalang bagay na iyon.
Dialogue: 0,0:59:47.67,0:59:49.31,Default,Tol,0,0,0,,Ano?
Dialogue: 0,0:59:51.84,0:59:54.71,Default,Tol,0,0,0,,Ang parehong dinala mula sa Qing.
Dialogue: 0,1:00:34.99,1:00:38.39,Default,Tol,0,0,0,,Tinawagan kita para talakayin ang paksa,
Dialogue: 0,1:00:38.39,1:00:40.82,Default,Tanging,0,0,0,,na itinaas sa pulong ngayon.
Dialogue: 0,1:00:41.12,1:00:43.43,Default,Toly,0,0,0,,Maglakas-loob na lihim na talakayin ang deposisyon ng reyna?
Dialogue: 0,1:00:43.43,1:00:46.36,Default,Tol,0,0,0,,Sa pamamagitan nito ay sinisiraan mo ang buong pamilya ni Kims mula sa Andon!
Dialogue: 0,1:00:46.36,1:00:48.53,Default,Tolya,0,0,0,,Sa looban kung nasaan ang reyna
Dialogue: 0,1:00:48.53,1:00:51.10,Default,Tol,0,0,0,,maaaring magpasya na lunurin ang sarili anumang oras,
Dialogue: 0,1:00:51.10,1:00:53.74,Default,Tanging,0,0,0,,walang katatagan!
Dialogue: 0,1:00:54.57,1:00:56.84,Default,Tol,0,0,0,,How dare you speak ng masama tungkol sa Her Majesty?
Dialogue: 0,1:00:56.97,1:00:59.44,Default,Tanging,0,0,0,,Lason lang ang alam mo!
Dialogue: 0,1:00:59.44,1:01:01.41,Default,Toly,0,0,0,,Spit poison?
Dialogue: 0,1:01:01.88,1:01:06.45,Default,Tol,0,0,0,,Hindi ko kukunsintihin ang ganitong insulto.
Dialogue: 0,1:01:17.36,1:01:19.40,Default,Tol,0,0,0,,Ano ito?
Dialogue: 0,1:01:19.40,1:01:21.60,Default,Toly,0,0,0,,May mali ka bang pinaplano?
Dialogue: 0,1:01:28.81,1:01:32.04,Default,Tol,0,0,0,,Ano ka ba, pakinggan mo lang hanggang dulo.
Dialogue: 0,1:01:32.04,1:01:33.71,Default,Tolya,0,0,0,,Shelmets.
Dialogue: 0,1:01:46.02,1:01:49.63,Default,Tol,0,0,0,,Gaya ng sinabi ko na, walang mawawala sa inyo\N.
Dialogue: 0,1:01:49.66,1:01:53.30,Default,Tol,0,0,0,,Bakit hindi manatili\N at makinig hanggang sa wakas?
Dialogue: 0,1:01:56.70,1:01:58.43,Default,Tolya,0,0,0,,Maupo ka.
Dialogue: 0,1:02:14.18,1:02:17.15,Default,Tol,0,0,0,,Hindi ko alam kung naaalala mo.
Dialogue: 0,1:02:17.15,1:02:21.56,Default,Tol,0,0,0,,Ang sulat na isinulat ng Inang Reyna.
Dialogue: 0,1:02:21.56,1:02:25.00,Default,Tol,0,0,0,,Lugar, petsa at oras na tinukoy dito,
Dialogue: 0,1:02:25.00,1:02:28.43,Default,Tol,0,0,0,,nagtutugma kung kailan at saan\Nnaganap ang aksidente sa reyna.
Dialogue: 0,1:02:28.93,1:02:31.07,Default,Tol,0,0,0,,Palsipikado ang sulat na iyon.
Dialogue: 0,1:02:31.07,1:02:34.00,Default,Tol,0,0,0,,Pero mapapatunayan mo ba?
Dialogue: 0,1:02:38.48,1:02:41.18,Default,Tol,0,0,0,,Iminumungkahi ko na bumalik ka sa iyong katinuan at huwag ibagsak ang reyna,
Dialogue: 0,1:02:42.35,1:02:45.45,Default,Tol,0,0,0,,bilang kapalit ay matatanggap mo ang mensaheng ito.
Dialogue: 0,1:02:45.72,1:02:48.15,Default,Tol,0,0,0,,Kaya sa iyong mga pamilya
Dialogue: 0,1:02:48.15,1:02:50.92,Default,Tol,0,0,0,, hindi na kailangang matakot sa mga kahihinatnan.
Dialogue: 0,1:02:50.92,1:02:53.72,Default,Tol,0,0,0,,Ito ang proposal ko.
Dialogue: 0,1:02:55.93,1:02:57.76,Default,Tol,0,0,0,,Paano mo ito gusto?
Dialogue: 0,1:03:16.61,1:03:18.31,Default,Tol,0,0,0,,Tumawag ka ba?
Dialogue: 0,1:03:19.08,1:03:22.42,Default,Tol,0,0,0,,Tuparin ko ang kahilingan ng Kanyang Kamahalan\N at sumulat sa aking ama.
Dialogue: 0,1:03:22.85,1:03:25.79,Default,Tol,0,0,0,,Ihahatid mo ba ang mensahe ko sa kanya?
Dialogue: 0,1:03:28.36,1:03:29.96,Default,Tol,0,0,0,,Susubukan ko
Dialogue: 0,1:03:30.46,1:03:32.30,Default,Tol,0,0,0,,kumbinsihin ang Kanyang Kamahalan.
Dialogue: 0,1:03:32.30,1:03:36.80,Default,Tol,0,0,0,,Gusto lang ng Kamahalan\N na gantihan ang kabutihan sa kabutihan.
Dialogue: 0,1:03:37.20,1:03:39.80,Default,Tol,0,0,0,,Bagaman iba ang opinyon ng Her Majesty sa bagay na ito.
Dialogue: 0,1:03:40.47,1:03:44.51,Default,Tol,0,0,0,,Ngunit ang nararamdaman ko lamang ng Kanyang Kamahalan.
Dialogue: 0,1:03:46.94,1:03:48.88,Default,Tol,0,0,0,,Kaya lahat ay maayos.
Dialogue: 0,1:03:49.81,1:03:53.72,Default,Tol,0,0,0,,Your Highness, ready na ang lahat para sa swimming.
Dialogue: 0,1:04:17.97,1:04:21.94,Default,Tol,0,0,0,,Okay na ang lahat sa ngayon.
Dialogue: 0,1:04:30.12,1:04:31.92,Default,Tol,0,0,0,,Kamahalan.
Dialogue: 0,1:04:31.99,1:04:34.32,Default,Tol,0,0,0,,Magaling ka ba?
Dialogue: 0,1:04:34.32,1:04:38.76,Default,Toly,0,0,0,,Tatawagan ba kita kung okay lang sa akin ang lahat?
Dialogue: 0,1:04:40.63,1:04:45.27,Default,Tol,0,0,0,,Nababalisa at hindi mapakali ang puso ko.
Dialogue: 0,1:04:46.47,1:04:48.50,Default,Tol,0,0,0,,Kalmado.
Dialogue: 0,1:04:49.01,1:04:52.21,Default,Tol,0,0,0,,Tutulungan kitang mahanap ang sagot sa tanong mo.
Dialogue: 0,1:05:16.70,1:05:19.77,Default,Tol,0,0,0,,Pupuntahan lang ng Kamahalan si Concubine Cho.
Dialogue: 0,1:05:19.77,1:05:21.87,Default,Tol,0,0,0,,May kausap ako sa kanya.
Dialogue: 0,1:05:22.31,1:05:24.51,Default,Tol,0,0,0,,Iwan mo kami.
Dialogue: 0,1:05:25.61,1:05:27.28,Default,Tol,0,0,0,,Oo, Kamahalan.
Dialogue: 0,1:05:35.05,1:05:37.25,Default,Tol,0,0,0,,Ang deposition ng reyna ay makakatulong sa pagsasakatuparan ng plano.
Dialogue: 0,1:05:37.25,1:05:40.06,Default,Tol,0,0,0,,So bakit ka tutol dito?
Dialogue: 0,1:05:40.06,1:05:41.59,Default,Tol,0,0,0,,Ipapatalsik nila ang isang reyna,
Dialogue: 0,1:05:41.59,1:05:44.13,Default,Tol,0,0,0,,may papalit agad sa kanya.
Dialogue: 0,1:05:44.36,1:05:47.30,Default,Toly,0,0,0,,Basta ang mga aksyon ng reyna ay hindi nakakasagabal sa amin, ngunit kabaliktaran.
Dialogue: 0,1:05:47.30,1:05:49.17,Default,Tol,0,0,0,,Siya ang pinakamagandang opsyon
Dialogue: 0,1:05:49.17,1:05:51.60,Default,Tanging,0,0,0,,sa lahat ng posible.
Dialogue: 0,1:05:52.57,1:05:54.57,Default,Tolya,0,0,0,,Naantig ba niya ang iyong puso?
Dialogue: 0,1:05:59.21,1:06:01.98,Default,Tol,0,0,0,,Sagot. Kaya ba nag-aalangan ka?
Dialogue: 0,1:06:02.25,1:06:03.91,Default,Tol,0,0,0,,Oo.
Dialogue: 0,1:06:04.35,1:06:06.22,Default,Tol,0,0,0,,Nahawakan.
Dialogue: 0,1:06:06.72,1:06:09.99,Default,Tol,0,0,0,,Sinubukan ko ang buhay niya,\Ngusto niyang isakripisyo ang kanya,
Dialogue: 0,1:06:09.99,1:06:12.46,Default,Tanging,0,0,0,,para iligtas ako at ang mahal ko.
Dialogue: 0,1:06:12.46,1:06:13.72,Default,Toly,0,0,0,,Hindi dahil sa habag
Dialogue: 0,1:06:13.72,1:06:14.99,Default,Toly,0,0,0,,at hindi dahil nagpatawad ako,
Dialogue: 0,1:06:14.99,1:06:17.89,Default,Toly,0,0,0,,pero dahil hindi niya kayang tiisin ang inhustisya.
Dialogue: 0,1:06:17.89,1:06:21.00,Default,Tol,0,0,0,,Hindi niya inaasahan ang paghingi ng tawad o pasasalamat mula sa akin.
Dialogue: 0,1:06:21.00,1:06:23.67,Default,Toly,0,0,0,,Kumilos lang ayon sa kanyang konsensya.
Dialogue: 0,1:06:23.67,1:06:26.04,Default,Tolya,0,0,0,,Ngayon lahat ay tumalikod sa kanya.
Dialogue: 0,1:06:26.67,1:06:29.57,Default,Tol,0,0,0,,Magagawa ko rin ba?
Dialogue: 0,1:06:29.97,1:06:32.51,Default,Tol,0,0,0,,Itatakwil mo na pala kami
Dialogue: 0,1:06:34.58,1:06:37.15,Default,Toly,0,0,0,,at mula sa iyong concubine?
Dialogue: 0,1:06:39.18,1:06:41.92,Default,Tol,0,0,0,,Wala akong nararamdaman para sa Kamahalan.
Dialogue: 0,1:06:42.12,1:06:44.42,Default,Tolya,0,0,0,,Ngunit hindi natin siya kaaway.
Dialogue: 0,1:06:44.42,1:06:47.56,Default,Toly,0,0,0,,Hindi kita tinatakwil at hindi kita pinagtaksilan.
Dialogue: 0,1:06:47.56,1:06:50.33,Default,Tol,0,0,0,,Masama kung may nararamdaman ka para sa kanya.
Dialogue: 0,1:06:50.33,1:06:52.26,Default,Toly,0,0,0,,Naka-attach sa kanya,
Dialogue: 0,1:06:52.26,1:06:54.76,Default,Tol,0,0,0,,ilalagay mo kaming lahat sa panganib.
Dialogue: 0,1:06:54.76,1:06:57.13,Default,Tol,0,0,0,,Susubukan kong pigilan itong mangyari.
Dialogue: 0,1:06:57.40,1:06:59.20,Default,Tol,0,0,0,,Okay.
Dialogue: 0,1:06:59.70,1:07:02.07,Default,Tol,0,0,0,,Then promise me this.
Dialogue: 0,1:07:02.24,1:07:05.14,Default,Tol,0,0,0,,Pangako na kung ang reyna
Dialogue: 0,1:07:05.14,1:07:09.11,Default,Tol,0,0,0,,ay makakasagabal sa aming mga plano
Dialogue: 0,1:07:09.85,1:07:12.01,Default,Toly,0,0,0,,o kakaibang kilos,
Dialogue: 0,1:07:13.25,1:07:15.15,Default,Tol,0,0,0,,ikaw nang walang pag-aalinlangan
Dialogue: 0,1:07:17.42,1:07:19.66,Default,Toly,0,0,0,,utusan siyang patayin.
Dialogue: 0,1:07:44.51,1:07:46.58,Default,Tol,0,0,0,,Bakit hindi ka sumasagot?
Dialogue: 0,1:07:46.58,1:07:48.62,Default,Tanging,0,0,0,,Kung ang reyna
Dialogue: 0,1:07:49.89,1:07:52.96,Default,Tol,0,0,0,,biglang nagsimulang manghimasok sa aming mga plano,
Dialogue: 0,1:07:56.96,1:08:00.93,Default,Tol,0,0,0,,Ako mismo ang pupugutan ng ulo niya.
Dialogue: 0,1:08:14.31,1:08:17.55,Default,Tol,0,0,0,,Wow, lalo akong gumaganda sa bawat oras.
Dialogue: 0,1:08:20.68,1:08:22.32,Default,Tolya,0,0,0,,Ikaw ba talaga ang nagburda nito?
Dialogue: 0,1:08:22.32,1:08:24.49,Default,Tolya,0,0,0,,Tama, maliliit na bulaklak. Meron ba sa Joseon?
Dialogue: 0,1:08:24.49,1:08:26.46,Default,Toly,0,0,0,,isang taong hindi marunong magburda?
Dialogue: 0,1:08:26.46,1:08:28.22,Default,Tolya,0,0,0,,Mga inapo ng lupain ng pagiging bago sa umaga
Dialogue: 0,1:08:28.22,1:08:29.86,Default,Tol,0,0,0,,I see meron.
Dialogue: 0,1:08:30.89,1:08:34.40,Default,Toly,0,0,0,,At hindi dapat lahat ay marunong magburda.
Dialogue: 0,1:08:34.83,1:08:37.50,Default,Tolya,0,0,0,,Hardy, at magagawa mo ang lahat sa mundo.
Dialogue: 0,1:08:37.50,1:08:41.17,Default,Toly,0,0,0,,Ano bang sinasabi mo, ako ang pinakamasama sa court ladies.
Dialogue: 0,1:08:41.37,1:08:45.01,Default,Toly,0,0,0,,Sabi ng lahat na para akong violet.
Dialogue: 0,1:08:45.84,1:08:49.88,Default,Tol,0,0,0,,Oo, lahat ng tao dito ay napakagaling.
Dialogue: 0,1:08:49.95,1:08:51.75,Default,Tol,0,0,0,,Well, tingnan natin ang ating pagkamalikhain.
Dialogue: 0,1:08:52.78,1:08:54.42,Default,Tol,0,0,0,,Ituwid.
Dialogue: 0,1:08:58.19,1:09:01.46,Default,Tolya,0,0,0,,Mga inapo ng lupain ng kasariwaan sa umaga\NOPagbukas ng paghahatid
Dialogue: 0,1:09:01.62,1:09:04.39,Default,Toly,0,0,0,,Isabit natin ito sa harap ng kuwadra.
Dialogue: 0,1:09:04.39,1:09:07.03,Default,Tol,0,0,0,,Pakiramdam ko ay magiging maganda ang lahat para sa atin.
Dialogue: 0,1:09:07.76,1:09:08.87,Default,Tanging,0,0,0,,Magkano ang dapat kong kunin?
Dialogue: 0,1:09:08.87,1:09:11.17,Default,Tol,0,0,0,,Upang makarating sa Oktaejeon, kailangan mo ng pera.
Dialogue: 0,1:09:11.17,1:09:12.80,Default,Tol,0,0,0,,Kamahalan.
Dialogue: 0,1:09:14.20,1:09:17.04,Default,Toly,0,0,0,,Dalhan kita ng bulaklak. Pambihirang orchid ng hangin.
Dialogue: 0,1:09:17.04,1:09:18.74,Default,Tolya,0,0,0,,Orchid of the winds?
Dialogue: 0,1:09:19.71,1:09:21.95,Default,Tolya,0,0,0,,Nakapagsalita na ba tungkol sa aming paghahatid?
Dialogue: 0,1:09:21.95,1:09:24.41,Default,Tolya,0,0,0,,Kanino galing ang mga bulaklak?
Dialogue: 0,1:09:26.15,1:09:28.35,Default,Tol,0,0,0,,Socially distancing, pero congratulations
Dialogue: 0,1:09:28.55,1:09:31.92,Default,Tol,0,0,0,,Mula sa Kanyang Kamahalan.
Dialogue: 0,1:09:35.69,1:09:37.93,Default,Toly,0,0,0,,Bakit ikaw?
Dialogue: 0,1:09:38.09,1:09:39.76,Default,Tol,0,0,0,,Nakakaloka.
Dialogue: 0,1:09:39.76,1:09:42.37,Default,Tol,0,0,0,,Sinusubukan kong kalimutan ang sarili ko, nababaon ako sa trabaho.
Dialogue: 0,1:09:42.37,1:09:44.53,Default,Tol,0,0,0,,Ano ang ginagawa ng lalaking ito? Anong klaseng palabas ito?
Dialogue: 0,1:09:45.87,1:09:47.87,Default,Toly,0,0,0,,Oo, isang libong beses akong mas cool.
Dialogue: 0,1:09:47.87,1:09:50.07,Default,Tol,0,0,0,,Husga para sa iyong sarili. Yan ang naisip ko!
Dialogue: 0,1:09:50.07,1:09:52.18,Default,Tolya,0,0,0,,Gumagawa ako ng mga trabaho. Ano siya?
Dialogue: 0,1:09:52.18,1:09:55.14,Default,Tol,0,0,0,,At lahat ng ito ay sa oras na walang mga serbisyo sa buong orasan.
Dialogue: 0,1:09:55.21,1:09:57.81,Default,Tol,0,0,0,,Oo, ako ay isang henyo, isang henyo.
Dialogue: 0,1:10:00.08,1:10:02.69,Default,Toly,0,0,0,,Tinatakot ko ba siya sa pagiging cool ko?
Dialogue: 0,1:10:02.85,1:10:05.29,Default,Tol,0,0,0,,Well, oo, naiintindihan ko.
Dialogue: 0,1:10:05.36,1:10:07.16,Default,Tol,0,0,0,,Well, okay.
Dialogue: 0,1:10:08.02,1:10:11.06,Default,Tol,0,0,0,,Ito ay dahil sa mga mapangahas na pananalita
Dialogue: 0,1:10:11.06,1:10:15.97,Default,Toly,0,0,0,,ito pala ay isang masamang bagay? \NBakit walang magandang naidudulot dito?
Dialogue: 0,1:10:16.33,1:10:18.23,Default,Tol,0,0,0,,Stand.
Dialogue: 0,1:10:19.60,1:10:22.40,Default,Tol,0,0,0,,Dahil madilim ang mga tao dito at walang amenities,
Dialogue: 0,1:10:22.61,1:10:25.28,Default,Tol,0,0,0,,sa aking mga ideya maaari akong bumaba sa kasaysayan ng Joseon!
Dialogue: 0,1:10:25.28,1:10:28.68,Default,Tol,0,0,0,,Hindi, global!
Dialogue: 0,1:11:03.68,1:11:06.68,Default,Tol,0,0,0,,Na-motivate talaga ako.
Dialogue: 0,1:11:06.82,1:11:09.52,Default,Tol,0,0,0,,Puwede ba akong maging lokal na \NSteve Jobs o Thomas Edison?
Dialogue: 0,1:11:09.52,1:11:13.32,Default,Tol,0,0,0,,Hindi, binabawasan ko na. Kailangan natin ng isang mahusay.
Dialogue: 0,1:11:13.32,1:11:16.86,Default,Toly,0,0,0,,Tagapagligtas ng sangkatauhan.
Dialogue: 0,1:11:28.97,1:11:31.57,Default,Tol,0,0,0,,Sa katawan ng reyna nakaupo,
Dialogue: 0,1:11:32.68,1:11:36.38,Default,Tanging,0,0,0,,na hindi dapat naroroon.
Dialogue: 0,1:11:36.98,1:11:38.98,Default,Toly,0,0,0,,Evil spirit.
Dialogue: 0,1:11:40.55,1:11:45.02,Default,Toly,0,0,0,,Ang Reyna ay sinapian ng masamang espiritu!
Dialogue: 0,1:11:47.56,1:11:50.43,Default,Tol,0,0,0,,Kailangan nating palayasin ang espiritung ito!
Dialogue: 0,1:11:51.49,1:11:53.56,Default,Toly,0,0,0,,O kaya naman ang buong mundo...
Dialogue: 0,1:11:54.83,1:12:00.57,Default,Toly,0,0,0,,Babaliktad ang buong mundo!
Dialogue: 0,1:12:03.94,1:12:05.57,Default,Toly,0,0,0,,Exactly, Carrier!
Dialogue: 0,1:12:05.64,1:12:07.81,Default,Tolya,0,0,0,,Imbentor ng mga air conditioner!
Dialogue: 0,1:12:14.22,1:12:15.25,Default,Tol,0,0,0,,Kamahalan!
Dialogue: 0,1:12:15.25,1:12:17.69,Default,Tol,0,0,0,,Magkaisip ka, Kamahalan! Halika na.
Dialogue: 0,1:12:17.69,1:12:19.29,Default,Tol,0,0,0,,Kamahalan!
Dialogue: 0,1:12:19.36,1:12:21.56,Default,Toly,0,0,0,,Umalis!
Dialogue: 0,1:12:26.86,1:12:29.47,Default,Tol,0,0,0,,Siya... Hindi siya humihinga.
Dialogue: 0,1:12:36.81,1:12:38.74,Default,Tanging,0,0,0,,At hindi ko nararamdaman ang mga pintig.
Dialogue: 0,1:13:13.44,1:13:15.68,Default,Tol,0,0,0,,Wala nang malay ang Reyna.
Dialogue: 0,1:13:15.68,1:13:17.65,Default,Toly,0,0,0,,Sabi mo ang reyna ay nakahiga na walang buhay?
Dialogue: 0,1:13:17.65,1:13:20.48,Default,Tol,0,0,0,,Upang iligtas siya, kailangan mong simulan\N ang daloy ng male chi energy. Kung hindi...
Dialogue: 0,1:13:20.48,1:13:22.62,Default,Tol,0,0,0,,Ospital? Bumalik na ba ako?
Dialogue: 0,1:13:22.62,1:13:24.52,Default,Tol,0,0,0,,Ipapakita ko na ang hari
Dialogue: 0,1:13:24.52,1:13:26.42,Default,Tol,0,0,0,,ay kung ano talaga ito.
Dialogue: 0,1:13:26.42,1:13:30.76,Default,Tol,0,0,0,,Ang lalaking ito ay dalawang mukha hanggang sa kaibuturan.
Dialogue: 0,1:13:30.76,1:13:32.86,Default,Tol,0,0,0,,Lumayo. Discharge!
Dialogue: 0,1:13:35.03,1:13:38.20,Default,Tol,0,0,0,,-Reyna. \N-Inutusan kita na alamin ang katotohanan.
Dialogue: 0,1:13:38.20,1:13:39.84,Default,Tol,0,0,0,,Hindi isang hakbang pa.
Dialogue: 0,1:13:39.84,1:13:41.97,Default,Tol,0,0,0,,Ito ang babae ko.
Dialogue: 0,0:17:10.95,0:17:12.95,Default,,0,0,0,,


