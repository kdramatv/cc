Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.09,0:01:06.37,Default,li,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.37,0:01:08.54,Default,li,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:01:09.80,0:01:12.30,Default,li,0,0,0,,تهانينا يا صاحب الجلالة.
Dialogue: 0,0:01:18.37,0:01:19.82,Default,li,0,0,0,,ملكتي، شكراً لك.
Dialogue: 0,0:01:28.75,0:01:31.82,Default,li,0,0,0,,-تهانينا يا صاحب الجلالة!\N-تهانينا يا صاحب الجلالة!
Dialogue: 0,0:01:34.60,0:01:36.69,Default,li,0,0,0,,سوف أصبح أباً!
Dialogue: 0,0:01:41.46,0:01:42.54,Default,li,0,0,0,,أنا
Dialogue: 0,0:01:44.90,0:01:46.50,Default,هل,0,0,0,,حامل؟
Dialogue: 0,0:02:07.83,0:02:09.89,Default,li,0,0,0,,توقف!
Dialogue: 0,0:02:23.10,0:02:24.35,Default,li,0,0,0,,-يا رب.\N-اخرج من هنا.
Dialogue: 0,0:02:24.47,0:02:26.08,Default,li,0,0,0,,-جلالتك.\N-يا رب.
Dialogue: 0,0:02:40.30,0:02:42.72,Default,li,0,0,0,,لماذا الملكة منزعجة جداً؟
Dialogue: 0,0:02:43.36,0:02:45.66,Default,li,0,0,0,,إنها ليست منزعجة.
Dialogue: 0,0:02:46.07,0:02:48.21,Default,li,0,0,0,,هكذا تعبر عن فرحتها.
Dialogue: 0,0:02:48.94,0:02:50.00,Default,li,0,0,0,,نعم.
Dialogue: 0,0:02:53.94,0:02:57.10,Default,is,0,0,0,,هل هذا من الآثار الجانبية للحمل؟
Dialogue: 0,0:03:00.64,0:03:03.08,Default,أو,0,0,0,,هذا أكثر من مجرد فشل في تحديد الهوية الذاتية.
Dialogue: 0,0:03:03.08,0:03:05.98,Default,li,0,0,0,,سوف تختفي هويتي وسوف تختفي روحي.
Dialogue: 0,0:03:07.82,0:03:10.22,Default,سواء,0,0,0,,أهكذا ستنتهي حياتي؟
Dialogue: 0,0:03:13.82,0:03:16.50,Default,li,0,0,0,,لقد أخبرتك أنني ضد الزواج.
Dialogue: 0,0:03:16.57,0:03:18.47,Default,أو,0,0,0,,حتى لو كنت متزوجاً،
Dialogue: 0,0:03:18.47,0:03:20.07,Default,li,0,0,0,,لم أرغب في إنجاب الأطفال.
Dialogue: 0,0:03:20.44,0:03:23.10,Default,li,0,0,0,,من الصعب عليّ البقاء على قيد الحياة\N في هذا العالم المعادي،
Dialogue: 0,0:03:23.10,0:03:24.31,Default,سواء,0,0,0,,أي نوع من الحمل؟
Dialogue: 0,0:03:24.54,0:03:26.44,Default,li,0,0,0,,متهور مثل خلع درعك الجسدي
Dialogue: 0,0:03:26.44,0:03:28.67,Default,li,0,0,0,,ورقص السامبا تحت النار.
Dialogue: 0,0:03:29.85,0:03:30.97,Default,li,0,0,0,,وهذا ليس كل شيء.
Dialogue: 0,0:03:31.00,0:03:33.94,Default,سواء,0,0,0,,الحمل والولادة يقصران متوسط ​​العمر المتوقع.
Dialogue: 0,0:03:34.04,0:03:36.54,Default,li,0,0,0,,تتخلى عن حياتك ليعيش طفلك.
Dialogue: 0,0:03:36.88,0:03:38.69,Default,li,0,0,0,,يجب أن أتخلى عن حياتي
Dialogue: 0,0:03:38.69,0:03:40.62,افتراضي,أهي,0,0,0,,من أجل طفل لا أعرفه حتى؟
Dialogue: 0,0:03:42.66,0:03:46.85,Default,أو,0,0,0,,اللعنة على الطبيعة الأم، امنح شخصًا آخر الإنجاب!
Dialogue: 0,0:03:51.54,0:03:57.20,Default,li,0,0,0,,لا أصدق أنني حامل!
Dialogue: 0,0:04:02.88,0:04:05.72,Default,li,0,0,0,,الحمل رائع
Dialogue: 0,0:04:06.44,0:04:08.98,Default,li,0,0,0,,انتظر يا صاحب السمو.
Dialogue: 0,0:04:09.91,0:04:12.66,Default,li,0,0,0,,17 حلقة
Dialogue: 0,0:04:17.53,0:04:19.32,Default,li,0,0,0,,لقد زرعت جثة أخرى.
Dialogue: 0,0:04:19.42,0:04:22.40,Default,li,0,0,0,,هل ظننت أنني لا أستطيع التعرف على أوفول؟
Dialogue: 0,0:04:23.72,0:04:27.13,Default,li,0,0,0,,لقد فعلت هذا حتى تعلم
Dialogue: 0,0:04:27.63,0:04:30.07,Default,أو,0,0,0,,نفسي الحقيقية، التي لم أشك فيها حتى.
Dialogue: 0,0:04:30.66,0:04:34.20,Default,li,0,0,0,,الملكة ابتعدت عن آل كيم الأندونيين.
Dialogue: 0,0:04:34.63,0:04:38.17,Default,li,0,0,0,,لقد اتحدت عائلة كيم الأندونية معنا.
Dialogue: 0,0:04:38.97,0:04:42.72,Default,li,0,0,0,,هذه فرصتك لتصبح ملكة.
Dialogue: 0,0:04:43.75,0:04:47.66,Default,li,0,0,0,,لا تحاول التحكم بي بعد الآن.
Dialogue: 0,0:04:53.19,0:04:55.90,Default,li,0,0,0,,كم سيعيش الطير الذي روضه الإنسان،
Dialogue: 0,0:04:56.87,0:04:59.90,Default,if,0,0,0,,إذا غادر الخلية؟
Dialogue: 0,0:05:02.94,0:05:07.44,Default,li,0,0,0,,هناك أخبار يريد الملك نقلها للعالم أجمع.
Dialogue: 0,0:05:07.91,0:05:09.60,Default,أو,0,0,0,,أيهما؟
Dialogue: 0,0:05:09.97,0:05:11.62,Default,li,0,0,0,,الملكة
Dialogue: 0,0:05:13.28,0:05:15.29,Default,هي,0,0,0,,حامل.
Dialogue: 0,0:05:37.73,0:05:41.58,Default,li,0,0,0,,هذا طبل يعلن عن حدث بهيج.
Dialogue: 0,0:06:16.15,0:06:18.31,Default,li,0,0,0,,الآن بعد أن أصبح مخزني فارغًا،
Dialogue: 0,0:06:18.81,0:06:21.48,Default,أو,0,0,0,,ليس هناك ما يملأ قلباً فارغاً.
Dialogue: 0,0:06:22.68,0:06:26.11,Default,li,0,0,0,,لن يملأ معدتي أي طعام شهي...
Dialogue: 0,0:06:27.39,0:06:31.05,Default,li,0,0,0,,لا يا روحي. كيفية ملئه؟
Dialogue: 0,0:06:31.85,0:06:34.20,Default,li,0,0,0,,لقد أدرت ظهري لعائلتي.
Dialogue: 0,0:06:35.03,0:06:37.77,Default,li,0,0,0,,أنا وحيد.
Dialogue: 0,0:06:40.97,0:06:42.14,Default,li,0,0,0,,سيد!
Dialogue: 0,0:06:42.66,0:06:43.80,Default,li,0,0,0,,سيد!
Dialogue: 0,0:06:45.28,0:06:47.51,Default,li,0,0,0,,-سيد!\N-ماذا؟
Dialogue: 0,0:06:47.51,0:06:49.37,Default,li,0,0,0,,أخبار عاجلة من القصر.
Dialogue: 0,0:06:52.65,0:06:56.29,Default,li,0,0,0,,هل حدث شيء للملكة؟
Dialogue: 0,0:06:56.48,0:06:59.85,Default,li,0,0,0,,الملكة حامل!
Dialogue: 0,0:07:05.70,0:07:07.79,Default,أو,0,0,0,,ما هو السبب؟
Dialogue: 0,0:07:11.47,0:07:14.49,Default,li,0,0,0,,جلالتك، بدلاً من البحث عن سبب،
Dialogue: 0,0:07:14.49,0:07:18.87,Default,أو,0,0,0,,ربما يمكنك أن تحاول أن تجعلها تشعر بالتحسن؟
Dialogue: 0,0:07:19.01,0:07:22.01,Default,li,0,0,0,,فكرة جيدة. كيف تفعل هذا؟
Dialogue: 0,0:07:22.01,0:07:24.21,Default,li,0,0,0,,كيف تجعل المرأة سعيدة؟
Dialogue: 0,0:07:28.35,0:07:30.61,Default,li,0,0,0,,كيف تعرف ذلك.
Dialogue: 0,0:07:32.05,0:07:34.89,Default,li,0,0,0,,ومن يجب أن أسأل عن هذا؟
Dialogue: 0,0:07:40.03,0:07:41.22,Default,li,0,0,0,,لذلك أنا
Dialogue: 0,0:07:41.79,0:07:45.34,Default,li,0,0,0,,دعا أحد الخبراء للمساعدة في حل مشاكلك.
Dialogue: 0,0:08:05.46,0:08:09.29,Default,li,0,0,0,,مؤخراً، هذا هو السؤال الوحيد الذي كان يفكر فيه.
Dialogue: 0,0:08:16.70,0:08:18.27,Default,li,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:08:18.27,0:08:20.34,Default,li,0,0,0,,من المحتمل أن تكون غاضبة بنفس الدرجة.
Dialogue: 0,0:08:21.64,0:08:23.97,Default,li,0,0,0,,وبعد ذلك ستقول.
Dialogue: 0,0:08:26.64,0:08:28.71,Default,li,0,0,0,"لقد سقيت زهرتي."
Dialogue: 0,0:08:30.41,0:08:33.35,Default,li,0,0,0,,إذا فعلت هذا، أشك في أنني سأنجو.
Dialogue: 0,0:08:33.37,0:08:35.11,Default,li,0,0,0,,لذا فهي فتاة ذات شخصية.
Dialogue: 0,0:08:35.52,0:08:37.29,Default,أو,0,0,0,,في هذه الحالة
Dialogue: 0,0:08:37.85,0:08:39.52,Default، هل هناك طريقة فعالة؟
Dialogue: 0,0:08:39.72,0:08:40.98,Default,أو,0,0,0,,أيهما؟
Dialogue: 0,0:08:45.66,0:08:47.90,Default,li,0,0,0,,أنت تصنع مثل هذا الوجه الغبي.
Dialogue: 0,0:08:50.06,0:08:53.47,Default,li,0,0,0,,أنا أكره نفسي لأنني أفكر بنفس الطريقة التي يفكر بها.
Dialogue: 0,0:08:54.06,0:08:55.47,Default,li,0,0,0,,عذراً.
Dialogue: 0,0:08:56.10,0:08:57.91,Default,سواء,0,0,0,,هناك على الأقل بعض الفوائد.
Dialogue: 0,0:08:58.16,0:08:59.21,افتراضي,أو,0,0,0,,لا يمكن أن يكون.
Dialogue: 0,0:08:59.21,0:09:02.91,Default,li,0,0,0,,أدركت مدى غباء البحث عن الإجابة من شخص آخر.
Dialogue: 0,0:09:04.08,0:09:06.97,Default,li,0,0,0,,أنا فقط أعرفها أفضل من أي شخص آخر.
Dialogue: 0,0:09:24.33,0:09:27.04,Default,li,0,0,0,,لماذا تبكين؟ إنه أنا الذي يريد البكاء.
Dialogue: 0,0:09:27.10,0:09:28.77,Default,li,0,0,0,,هذه دموع السعادة.
Dialogue: 0,0:09:30.20,0:09:32.57,Default,li,0,0,0,,يمكنك البكاء بقدر ما تريد اليوم.
Dialogue: 0,0:09:37.84,0:09:39.34,Default,li,0,0,0,,حسنًا. يبكي.
Dialogue: 0,0:09:40.48,0:09:43.25,Default,li,0,0,0,,يمكنك البكاء من أجلي.
Dialogue: 0,0:09:44.79,0:09:47.21,Default,li,0,0,0,,أذرف الدموع على حياتي،
Dialogue: 0,0:09:48.66,0:09:50.45,Default,أو,0,0,0,,حيث ليس لدي خيار.
Dialogue: 0,0:09:55.03,0:09:56.13,Default,li,0,0,0,,جلالتك.
Dialogue: 0,0:09:57.42,0:10:01.04,Default,li,0,0,0,,توقف عن ذرف دموع السعادة.
Dialogue: 0,0:10:02.61,0:10:04.01,Default,li,0,0,0,,ماذا يجب أن أفعل أيضاً؟
Dialogue: 0,0:10:04.01,0:10:08.14,Default,أو,0,0,0,,يجب عليك إخطار الفناء شخصيًا
Dialogue: 0,0:10:08.14,0:10:10.07,Default,li,0,0,0,,وتقبل التهاني.
Dialogue: 0,0:10:11.20,0:10:14.15,Default,أو,0,0,0,,لا أريد. تشاجرت مع أقاربي.
Dialogue: 0,0:10:14.84,0:10:16.34,Default,سواء,0,0,0,,جادل أم لا،
Dialogue: 0,0:10:16.89,0:10:20.55,Default,أو,0,0,0,,إذا انتهكت الأمر المعمول به، فسيتعين عليك الإجابة.
Dialogue: 0,0:10:21.73,0:10:23.68,Default,li,0,0,0,,لذا فأنا أكره الحمل أكثر.
Dialogue: 0,0:10:25.29,0:10:28.05,Default,li,0,0,0,,لقد وصلت الملكة الأرملة.
Dialogue: 0,0:10:28.32,0:10:30.40,Default,li,0,0,0,,الملكة الأم هنا أيضاً.
Dialogue: 0,0:10:30.66,0:10:32.87,Default,li,0,0,0,,لقد سبقوك.
Dialogue: 0,0:10:33.24,0:10:34.90,Default,أو,0,0,0,,ماذا يجب أن نفعل؟
Dialogue: 0,0:10:52.02,0:10:53.29,Default,أو,0,0,0,,مرحبًا.
Dialogue: 0,0:10:58.26,0:11:01.79,Default,li,0,0,0,,كان يجب أن أخطرك شخصياً،
Dialogue: 0,0:11:02.53,0:11:06.46,Default,li,0,0,0,,ولكن كما ترون، لا أستطيع النهوض.
Dialogue: 0,0:11:08.51,0:11:10.04,Default,li,0,0,0,,ما هي الأعراض التي أعاني منها؟
Dialogue: 0,0:11:13.30,0:11:16.07,Default,li,0,0,0,,إنها تشعر بالدوار بسبب غثيان الصباح
Dialogue: 0,0:11:16.07,0:11:18.15,Default,li,0,0,0,,والألم الناتج عن الحمل.
Dialogue: 0,0:11:18.15,0:11:20.15,Default,li,0,0,0,,نعم إنه كذلك.
Dialogue: 0,0:11:21.48,0:11:23.84,Default,li,0,0,0,,لذا جئت بنفسي.
Dialogue: 0,0:11:27.21,0:11:28.41,Default,li,0,0,0,,من فضلك
Dialogue: 0,0:11:29.86,0:11:31.32,Default,أو,0,0,0,,اجلس.
Dialogue: 0,0:11:31.32,0:11:32.63,Default,li,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:11:32.86,0:11:35.87,Default,li,0,0,0,,لابد أن الأمر صعب عليك. اجلس بشكل مريح.
Dialogue: 0,0:11:36.09,0:11:37.73,Default,li,0,0,0,,حسناً بالطبع.
Dialogue: 0,0:11:46.70,0:11:49.51,Default,li,0,0,0,,عندما سمعت الأخبار فرحت.
Dialogue: 0,0:11:49.88,0:11:52.28,Default,li,0,0,0,,حتى أنها أحضرت تعويذة رغم أنها رفضتها.
Dialogue: 0,0:11:53.12,0:11:55.07,Default,li,0,0,0,,أردت التأكد
Dialogue: 0,0:11:55.07,0:11:58.18,Default,سواء,0,0,0,,أنك ستحملين طفلاً سليماً.
Dialogue: 0,0:11:59.52,0:12:02.45,Default,li,0,0,0,,ويبدو الأمر كاللعنة.
Dialogue: 0,0:12:04.82,0:12:08.00,Default,li,0,0,0,,أنا ملحد. أنا لا أؤمن بالتعويذات.
Dialogue: 0,0:12:08.00,0:12:10.23,Default,li,0,0,0,,سوف تدركين عندما تلدين.
Dialogue: 0,0:12:11.09,0:12:13.90,Default,li,0,0,0,,أريد أن أؤمن بشيء لم أؤمن به.
Dialogue: 0,0:12:14.66,0:12:16.77,Default,li,0,0,0,,سوف تقع في اليأس
Dialogue: 0,0:12:16.77,0:12:21.17,Default,أو,0,0,0,,وتريد أن تتمنى أمنية على الحجر الذي يركله الجميع.
Dialogue: 0,0:12:23.84,0:12:26.52,Default,li,0,0,0,,ليس عليك أن تخاف من أي شيء.
Dialogue: 0,0:12:26.78,0:12:30.91,Default,li,0,0,0,,لكنك الآن سوف تخاف من كل شيء.
Dialogue: 0,0:12:32.26,0:12:34.62,Default,li,0,0,0,,فقدان الطفل له تأثير سيء على الأم.
Dialogue: 0,0:12:36.68,0:12:38.63,Default,li,0,0,0,,طلبت من الطبيب تحضير الدواء،
Dialogue: 0,0:12:38.63,0:12:40.36,Default,أو,0,0,0,,الذي سيحميك من الإجهاض.
Dialogue: 0,0:12:40.36,0:12:42.53,Default,li,0,0,0,,تعامل مع الأمر بصرامة كل يوم.
Dialogue: 0,0:12:43.06,0:12:45.09,Default,أو,0,0,0,,إذا حدث شيء للطفل،
Dialogue: 0,0:12:45.09,0:12:47.33,Default,أو,0,0,0,,سوف تكون مسؤولاً عن هذا.
Dialogue: 0,0:12:47.77,0:12:49.87,Default,li,0,0,0,,من الآن فصاعدا، لا تتصرف بتهور.
Dialogue: 0,0:12:50.11,0:12:52.80,Default,li,0,0,0,,كن حذراً من أجل الطفل.
Dialogue: 0,0:12:53.67,0:12:56.04,Default,li,0,0,0,,كلاهما جاء لتخويفني.
Dialogue: 0,0:12:57.20,0:12:58.71,Default,li,0,0,0,,سأكون مريضاً حقاً الآن.
Dialogue: 0,0:13:21.33,0:13:24.14,Default,li,0,0,0,,شكرًا لك على حكمتك.
Dialogue: 0,0:13:40.16,0:13:41.31,Default,lee,0,0,0,,هذا هو الأمير يونبيونغ.
Dialogue: 0,0:13:44.99,0:13:46.09,Default,أو,0,0,0,,أدخل.
Dialogue: 0,0:13:56.01,0:13:57.91,Default,li,0,0,0,,لقد أتيت لأنك كنت قلقاً.
Dialogue: 0,0:13:59.91,0:14:01.07,Default,li,0,0,0,,أنا بخير،
Dialogue: 0,0:14:02.30,0:14:04.61,Default,li,0,0,0,,لكنني لا أستطيع إجبار نفسي على ذلك
Dialogue: 0,0:14:04.61,0:14:06.88,Default,أو,0,0,0,,تهنئة الملك والملكة.
Dialogue: 0,0:14:09.02,0:14:10.89,Default,li,0,0,0,,لدي طريقي الخاص.
Dialogue: 0,0:14:12.91,0:14:15.92,Default,li,0,0,0,,لقد جئت إلى القصر لمساعدة جلالته.
Dialogue: 0,0:14:16.68,0:14:18.29,Default,li,0,0,0,,اعتقدت أنها الطريقة الوحيدة
Dialogue: 0,0:14:19.32,0:14:21.82,Default,if,0,0,0,,مساعدته تعني منحه الراحة النفسية.
Dialogue: 0,0:14:23.27,0:14:25.56,Default,li,0,0,0,,ولكن عندما رأيت الملكة، أدركت أنني كنت مخطئاً.
Dialogue: 0,0:14:28.74,0:14:32.54,Default,li,0,0,0,,هذه فرصتك لتصبح ملكة.
Dialogue: 0,0:14:44.81,0:14:45.95,Default,li,0,0,0,,الملكة الأم.
Dialogue: 0,0:14:46.81,0:14:50.32,Default,li,0,0,0,,إلى ماذا أدين بهذه المتعة؟
Dialogue: 0,0:14:58.23,0:15:01.59,Default,li,0,0,0,,ما الذي أتى بك إلى هنا أيتها المحظية الرئيسية؟
Dialogue: 0,0:15:06.33,0:15:08.33,Default,li,0,0,0,,لقد تعاونت مع عائلة كيم الأندونية.
Dialogue: 0,0:15:10.80,0:15:13.07,Default,li,0,0,0,,-هذه رغبة العشيرة.\N-لا تتاجر باسم العشيرة
Dialogue: 0,0:15:13.07,0:15:14.67,Default,أو,0,0,0,,من أجل قتال بسيط.
Dialogue: 0,0:15:16.25,0:15:18.25,Default,أو,0,0,0,,هل تريد أن تظل المستشار المناسب؟
Dialogue: 0,0:15:20.41,0:15:22.13,Default,أو,0,0,0,,اتخذ القرار الصحيح.
Dialogue: 0,0:15:22.13,0:15:25.45,Default,أو,0,0,0,,وإلا سأجمع أعضاء عشيرتنا،
Dialogue: 0,0:15:25.45,0:15:27.69,Default,سواء,0,0,0,,قلقة بشأن مستقبل جوسون،
Dialogue: 0,0:15:28.19,0:15:30.32,Default,li,0,0,0,,بقيادة والدي.
Dialogue: 0,0:15:38.70,0:15:40.67,Default,أو,0,0,0,,أبي أرسل كل هذا؟
Dialogue: 0,0:15:41.14,0:15:42.17,Default,أو,0,0,0,,نعم.
Dialogue: 0,0:15:42.61,0:15:46.07,Default,li,0,0,0,,هدايا للطفل الذي تحملينه.
Dialogue: 0,0:15:46.54,0:15:48.02,Default,li,0,0,0,,وهناك المزيد.
Dialogue: 0,0:15:48.34,0:15:49.91,Default,li,0,0,0,,هناك أيضًا هدايا في الممر.
Dialogue: 0,0:15:53.52,0:15:55.73,Default,li,0,0,0,,هذا يحيرني أكثر.
Dialogue: 0,0:15:56.36,0:15:59.69,Default,li,0,0,0,,الجو مظلم بالفعل، سأشعل الشموع.
Dialogue: 0,0:16:04.16,0:16:06.43,Default,is,0,0,0,,ما فائدة هذه الشموع؟
Dialogue: 0,0:16:06.87,0:16:08.56,Default,li,0,0,0,,من هذه اللحظة فصاعداً، حياتي
Dialogue: 0,0:16:10.46,0:16:11.74,Default,أو,0,0,0,,سوف يصبح أسود اللون.
Dialogue: 0,0:16:37.13,0:16:38.93,Default,zi,0,0,0,,المستشار الأيسر كيم سيوك كيون
Dialogue: 0,0:16:40.93,0:16:43.04,Default,zi,0,0,0,,هاجموا المسؤول مرة أخرى.
Dialogue: 0,0:16:43.24,0:16:45.24,Default,zi,0,0,0,,لم يقطعوا رأس القائد.
Dialogue: 0,0:16:45.70,0:16:47.17,Default,zi,0,0,0,,لم نجرؤ على لمسه،
Dialogue: 0,0:16:47.17,0:16:50.04,Default,zi,0,0,0,,لأنهم كانوا خائفين من اعتبار ذلك خيانة.
Dialogue: 0,0:16:50.25,0:16:52.41,Default,zi,0,0,0,,هل هؤلاء الفلاحون شجعان إلى هذا الحد؟
Dialogue: 0,0:16:53.17,0:16:56.08,Default,zi,0,0,0,,ليس هناك سبب لبذل كل جهودك للقبض عليهم.
Dialogue: 0,0:16:56.08,0:16:57.29,Default,zi,0,0,0,,هذا يقلقني.
Dialogue: 0,0:16:59.05,0:17:02.99,Default,zi,0,0,0,,بالمناسبة، هل وجدوا رمز أتباع تونهاك في القصر؟
Dialogue: 0,0:17:11.46,0:17:13.50,Default,zi,0,0,0,,كيم سويون
Dialogue: 0,0:17:14.77,0:17:17.00,Default,zi,0,0,0,,تمكن أتباع تونغهاك من دخول القصر،
Dialogue: 0,0:17:17.00,0:17:18.83,Default,zi,0,0,0,,هذا أمر خطير، عليك أن تسرع.
Dialogue: 0,0:17:18.83,0:17:22.48,Default,zi,0,0,0,,ماذا لو لأننا\N لم نفعل أي شيء، سيكون هناك المزيد منهم؟
Dialogue: 0,0:17:25.15,0:17:27.65,Default,zi,0,0,0,,ركز فقط على مهامك.
Dialogue: 0,0:17:35.45,0:17:38.58,Default,zi,0,0,0,,جلالتك من هذا اليوم
Dialogue: 0,0:17:39.42,0:17:40.59,Default,zi,0,0,0,"التعليم قبل الولادة"
Dialogue: 0,0:17:40.59,0:17:42.23,Default,zi,0,0,0,,سوف تبدأين التدريب قبل الولادة.
Dialogue: 0,0:17:48.64,0:17:50.56,Default,zi,0,0,0,,لا يمكنك الاستلقاء على جانبك.
Dialogue: 0,0:17:50.77,0:17:52.70,Default,zi,0,0,0,,لا يمكنك الاتكاء على يديك.
Dialogue: 0,0:17:53.11,0:17:56.30,Default,zi,0,0,0,,لا يمكنك رفع رأسك وأنت مستلقي.
Dialogue: 0,0:17:56.30,0:17:57.30,Default,zi,0,0,0,,اللعنة!
Dialogue: 0,0:18:11.19,0:18:14.46,Default,zi,0,0,0,,لا يمكنك أن تضحك أو تتفاجأ أو تخاف.
Dialogue: 0,0:18:14.73,0:18:16.70,Default,zi,0,0,0,,حزن، بكاء
Dialogue: 0,0:18:16.70,0:18:19.79,Default,zi,0,0,0,,ولا يمكنك التحدث كثيرًا أيضًا.
Dialogue: 0,0:18:25.80,0:18:29.51,Default,zi,0,0,0,,عليك أن تتخلى عن مثل هذه الأطعمة غير العادية.
Dialogue: 0,0:18:31.78,0:18:34.18,Default,zi,0,0,0,,كما لو أن جسدي ليس ملكًا لي!
Dialogue: 0,0:18:35.07,0:18:36.54,Default,zi,0,0,0,,حسناً، هذا صحيح بالطبع.
Dialogue: 0,0:18:36.54,0:18:38.02,Default,zi,0,0,0,,لكنني اعتدت على ذلك للتو!
Dialogue: 0,0:18:38.81,0:18:41.26,Default,zi,0,0,0,,لماذا عاد كل شيء إلى أصله بسبب هذا الحمل\N؟
Dialogue: 0,0:18:42.49,0:18:43.62,Default,zi,0,0,0,,وخاصة أنت.
Dialogue: 0,0:18:44.38,0:18:46.43,Default,zi,0,0,0,,ظننت أنك توقفت عن مضايقتي.
Dialogue: 0,0:18:46.62,0:18:50.89,Default,zi,0,0,0,,هذا كله من أجل طفلك.
Dialogue: 0,0:18:50.89,0:18:52.86,Default,zi,0,0,0,,لكي يبقى الطفل على قيد الحياة، يجب على\NI أولاً أن أنجو بنفسي.
Dialogue: 0,0:18:52.86,0:18:54.20,Default,zi,0,0,0,,هل أنا آلة لختم الأطفال؟
Dialogue: 0,0:18:54.20,0:18:55.44,Default,zi,0,0,0,,حاضنة حية أم ماذا؟
Dialogue: 0,0:18:55.94,0:18:57.77,Default,zi,0,0,0,,بالمناسبة، لست الوحيد الذي يجب أن يعاني.
Dialogue: 0,0:18:57.83,0:18:58.90,Default,zi,0,0,0,,ماذا يفعل أبي؟
Dialogue: 0,0:18:58.90,0:19:00.60,Default,zi,0,0,0,,اذهب إلى تشيولجونغ وأخبره عن التدريب.
Dialogue: 0,0:19:01.18,0:19:04.64,Default,zi,0,0,0,,بشكل عام، السطر 3 من الفصل 1 يقول ذلك
Dialogue: 0,0:19:04.64,0:19:08.07,Default,zi,0,0,0,,يجب أن يخضع الأب أيضًا لتعليم ما قبل الولادة.
Dialogue: 0,0:19:08.07,0:19:10.29,Default,zi,0,0,0,,بمجرد أن ينتهي جلالته من عمله،
Dialogue: 0,0:19:10.29,0:19:11.95,Default,zi,0,0,0,,سوف تدرسان معًا...
Dialogue: 0,0:19:11.95,0:19:13.52,Default,zi,0,0,0,,بدأ يومي بالحمل
Dialogue: 0,0:19:13.52,0:19:15.08,Default,zi,0,0,0,,وهل سينتهي هذا بنفس الطريقة؟
Dialogue: 0,0:19:18.85,0:19:20.93,Default,zi,0,0,0,,لقد فقدت حياتي بالفعل.
Dialogue: 0,0:19:25.70,0:19:26.79,Default,zi,0,0,0,,لا يا صاحب الجلالة.
Dialogue: 0,0:19:28.06,0:19:30.60,Default,zi,0,0,0,,مستحيل يا صاحب الجلالة. خذها.
Dialogue: 0,0:19:30.60,0:19:31.63,Default,zi,0,0,0,,حضرة يونغ.
Dialogue: 0,0:19:33.90,0:19:35.28,Default,zi,0,0,0,,بعد تلك الحادثة
Dialogue: 0,0:19:35.98,0:19:38.45,Default,zi,0,0,0,,كيم بيونين والملكة لم يروا بعضهما البعض مرة أخرى.
Dialogue: 0,0:19:38.75,0:19:41.75,Default,zi,0,0,0,,بعد الرفض، كان يجب أن يكتشف أنها حامل.
Dialogue: 0,0:19:42.54,0:19:44.58,Default,zi,0,0,0,,أنا متأكد من أنه ليس لديه من يعتمد عليه.
Dialogue: 0,0:19:46.88,0:19:48.42,Default,zi,0,0,0,,رجل مسكين.
Dialogue: 0,0:19:57.00,0:19:58.47,Default,zi,0,0,0,,آمل أن تأكل جيداً.
Dialogue: 0,0:19:59.00,0:20:00.09,Default,zi,0,0,0,,وداعا.
Dialogue: 0,0:20:03.97,0:20:05.60,Default,zi,0,0,0,,أنت بحاجة إلى النوم في المنزل.
Dialogue: 0,0:20:07.90,0:20:09.64,Default,zi,0,0,0,,تبدو مرهقاً.
Dialogue: 0,0:20:24.29,0:20:25.96,Default,zi,0,0,0,,التوتر سبب كل الأمراض.
Dialogue: 0,0:20:25.96,0:20:27.73,Default,zi,0,0,0,,وسيكون ضارًا أيضًا بالطفل.
Dialogue: 0,0:20:29.89,0:20:31.00,Default,zee,0,0,0,,استعد.
Dialogue: 0,0:20:32.39,0:20:33.63,Default,zi,0,0,0,,ملعقة واحدة فقط.
Dialogue: 0,0:20:38.54,0:20:39.74,Default,zi,0,0,0,,نبيذ الكمثرى الخاص بي.
Dialogue: 0,0:20:43.07,0:20:45.34,Default,zi,0,0,0,,الشيف الملكي!
Dialogue: 0,0:20:51.45,0:20:52.46,Default,zi,0,0,0,,أين نبيذ الكمثرى؟
Dialogue: 0,0:20:53.29,0:20:55.76,Default,zi,0,0,0,,لقد أفسدت، رميتها بعيداً.
Dialogue: 0,0:21:16.10,0:21:17.40,Default,zi,0,0,0,,شخص ما في مزاج رائع.
Dialogue: 0,0:21:17.78,0:21:20.14,Default,zi,0,0,0,,مازلت كما كنت دائماً.
Dialogue: 0,0:21:26.38,0:21:28.11,Default,zi,0,0,0,,قالوا إنهم توقفوا عن الابتسام منذ وقت طويل.
Dialogue: 0,0:21:28.29,0:21:29.69,Default,zi,0,0,0,,ووجدت الابتسامة مرة أخرى.
Dialogue: 0,0:21:32.39,0:21:35.39,Default,zi,0,0,0,,لقد فقدت النبيذ، ووجدت ابتسامتي.
Dialogue: 0,0:21:38.32,0:21:39.97,Default,zi,0,0,0,,يا لها من صدفة.
Dialogue: 0,0:21:44.71,0:21:46.07,Default,zi,0,0,0,,قل الحقيقة.
Dialogue: 0,0:21:46.51,0:21:47.78,Default,zi,0,0,0,,أنت تستمتع بوقتك، أليس كذلك؟
Dialogue: 0,0:21:48.13,0:21:51.87,Default,zi,0,0,0,,انتقم من معاناتك، بمجرد أن تسنح الفرصة.
Dialogue: 0,0:21:52.54,0:21:55.68,Default,zi,0,0,0,,لا يمكنك أن تهزمني يا صاحب الجلالة.
Dialogue: 0,0:21:55.81,0:22:00.22,Default,zi,0,0,0,,دعه يتقيأ. بصق النبيذ الخاص بي!
Dialogue: 0,0:22:00.22,0:22:01.58,Default,zi,0,0,0,,جلالة الملك، كن هادئاً!
Dialogue: 0,0:22:01.92,0:22:03.53,Default,zi,0,0,0,,من الأفضل مناقشة كل شيء يا صاحب الجلالة.
Dialogue: 0,0:22:03.62,0:22:05.12,Default,zi,0,0,0,,ناقش، نعم الآن!
Dialogue: 0,0:22:07.96,0:22:09.82,Default,zi,0,0,0,,نبيذ الكمثرى الخاص بي.
Dialogue: 0,0:22:10.77,0:22:14.04,Default,zi,0,0,0,,لقد شربوا كل النبيذ.
Dialogue: 0,0:22:14.29,0:22:17.24,Default,zi,0,0,0,,-فينتسو!\N-جلالتك!
Dialogue: 0,0:22:20.74,0:22:22.98,Default,zi,0,0,0,,أعطني النبيذ!
Dialogue: 0,0:22:25.04,0:22:28.04,Default,zi,0,0,0,,-جلالتك.\N-نبيذي!
Dialogue: 0,0:22:28.04,0:22:31.04,Default,zi,0,0,0,,لماذا تبكين يا صاحب الجلالة؟
Dialogue: 0,0:22:41.76,0:22:43.27,Default,zi,0,0,0,,كنت أنتظرك.
Dialogue: 0,0:22:43.27,0:22:46.44,Default,zi,0,0,0,,وأنت رائع، مثل أمير على حصان أبيض.
Dialogue: 0,0:22:46.59,0:22:49.71,Default,zi,0,0,0,,كل شيء كان ممنوعاً عليّ، وأنت تركب حصاناً وتستمتع.
Dialogue: 0,0:22:49.71,0:22:51.90,Default,zi,0,0,0,,أنت منزعج جداً اليوم كالعادة.
Dialogue: 0,0:22:52.48,0:22:53.60,Default,zi,0,0,0,,يا لها من راحة.
Dialogue: 0,0:22:59.54,0:23:00.81,Default,zi,0,0,0,,دعونا نأخذ جولة معًا.
Dialogue: 0,0:23:02.18,0:23:04.11,Default,zi,0,0,0,,هذا غير ممكن يا صاحب الجلالة.
Dialogue: 0,0:23:04.95,0:23:06.96,Default,zi,0,0,0,,صاحبة الجلالة تحمل طفلاً ملكيًا.
Dialogue: 0,0:23:07.29,0:23:10.58,Default,zi,0,0,0,,لا يمكنك الركوب معها يا صاحب الجلالة.
Dialogue: 0,0:23:16.70,0:23:17.97,Default,zi,0,0,0,,جلالتك!
Dialogue: 0,0:23:20.04,0:23:23.06,Default,zi,0,0,0,,يا صاحب الجلالة، هذا أمر خطير!
Dialogue: 0,0:23:23.21,0:23:25.87,Default,zi,0,0,0,,-جلالتك!\N-لا يمكنك ذلك!
Dialogue: 0,0:23:26.87,0:23:27.94,Default,zi,0,0,0,,أوه، لا!
Dialogue: 0,0:23:46.15,0:23:47.35,Default,zi,0,0,0,,أين نحن؟
Dialogue: 0,0:23:48.50,0:23:50.29,Default,zi,0,0,0,,أردت دائمًا أن أقدم لك شيئًا
Dialogue: 0,0:23:50.29,0:23:52.47,Default,zi,0,0,0,,ما هو أكثر شيء تحبه وتريده.
Dialogue: 0,0:23:53.00,0:23:55.54,Default,zi,0,0,0,,ما لا يمكن العثور عليه في القصر، خارجه فقط.
Dialogue: 0,0:23:55.54,0:23:58.24,Default,zi,0,0,0,,-الترفيه؟\N-أنا أتحدث عن الحرية.
Dialogue: 0,0:24:02.28,0:24:03.37,Default,zi,0,0,0,,لا يعجبك هذا أم ماذا؟
Dialogue: 0,0:24:06.54,0:24:09.75,Default,zi,0,0,0,,لذلك أود أن أقول، مجرد نزهة. \Nلماذا الكثير من الأبهة؟
Dialogue: 0,0:24:10.29,0:24:13.22,Default,zi,0,0,0,,لقد جئنا إلى القصر الملكي لنستنشق الهواء المنعش.
Dialogue: 0,0:24:14.08,0:24:15.58,Default,zi,0,0,0,,دعنا نعود إذا لم يعجبك ذلك.
Dialogue: 0,0:24:18.19,0:24:20.53,Default,zi,0,0,0,,العقار الملكي يشبه المنزل الصيفي، أليس كذلك؟
Dialogue: 0,0:24:22.12,0:24:24.56,Default,zi,0,0,0,,جميل. يبدو الأمر وكأن الرجل الغني يغازلني.
Dialogue: 0,0:24:25.23,0:24:27.17,Default,zi,0,0,0,,بما أننا هنا، فلنلقي نظرة حولنا.
Dialogue: 0,0:24:27.83,0:24:30.56,Default,zi,0,0,0,,كنت أعرف أنك ستحبين ذلك يا ملكتي.
Dialogue: 0,0:24:30.56,0:24:32.44,Default,zi,0,0,0,,هنا.
Dialogue: 0,0:24:34.18,0:24:36.01,Default,zi,0,0,0,,من الرائع أن تكون ملكًا.
Dialogue: 0,0:24:36.07,0:24:39.64,Default,zi,0,0,0,,وعقار فخم وحديقة.
Dialogue: 0,0:24:39.92,0:24:43.45,Default,zi,0,0,0,,لقد كنت أتساءل طوال الليل عن سبب غضبك الشديد.
Dialogue: 0,0:24:43.84,0:24:46.72,Default,zi,0,0,0,,عادةً ما يكون الحمل نعمة بالنسبة لنساء القصر\N.
Dialogue: 0,0:24:46.72,0:24:50.08,Default,zi,0,0,0,,ولكن لماذا كانت الملكة منزعجة جداً؟
Dialogue: 0,0:24:50.76,0:24:53.50,Default,zi,0,0,0,,و؟ هل تعرف لماذا؟
Dialogue: 0,0:24:53.89,0:24:57.50,Default,zi,0,0,0,,لا. بغض النظر عن مدى تفكيري، ما زلت لم أفهم.
Dialogue: 0,0:24:58.47,0:25:02.06,Default,zi,0,0,0,,لم أفهم، فقررت القبول.
Dialogue: 0,0:25:03.36,0:25:07.60,Default,zi,0,0,0,,ما هي النعمة للآخرين قد لا تكون كذلك بالنسبة لك.
Dialogue: 0,0:25:07.98,0:25:11.87,Default,zi,0,0,0,,أنت مثل هذا الشخص.
Dialogue: 0,0:25:14.31,0:25:16.61,Default,zi,0,0,0,,يبدو أن قاموس الملكة مفيد حقاً.
Dialogue: 0,0:25:36.13,0:25:38.56,Default,zi,0,0,0,,لماذا تفعل هذا؟ إنه أمر محرج.
Dialogue: 0,0:25:42.90,0:25:44.07,Default,zi,0,0,0,,ملكتي.
Dialogue: 0,0:25:53.49,0:25:54.96,Default,zi,0,0,0,,هل هذا "rrrr"؟
Dialogue: 0,0:25:57.53,0:25:58.73,Default,zi,0,0,0,,Rrrrr!
Dialogue: 0,0:26:05.32,0:26:08.63,Default,zi,0,0,0,,بما أنني أكتب قاموس الملكة، فأنا مهتم بشيء ما.
Dialogue: 0,0:26:09.83,0:26:11.60,Default,zi,0,0,0,,ماذا يعني "الكل في"؟
Dialogue: 0,0:26:12.33,0:26:13.78,Default,zi,0,0,0,,هل قلت ذلك؟
Dialogue: 0,0:26:13.78,0:26:16.40,Default,zi,0,0,0,,هذه هي الكلمة التي صرخت بها أثناء المقامرة في السوق.
Dialogue: 0,0:26:19.72,0:26:20.95,Default,zi,0,0,0,,الكل في -
Dialogue: 0,0:26:21.04,0:26:24.45,Default,zi,0,0,0,,تصرف غبي جداً عندما تكونون جميعاً
Dialogue: 0,0:26:24.88,0:26:27.11,Default,zi,0,0,0,,تضع البيض الهش في سلة واحدة.
Dialogue: 0,0:26:27.81,0:26:31.43,Default,zi,0,0,0,,-البيض؟\N-لقد فعلت هذا الشيء الغبي.
Dialogue: 0,0:26:33.00,0:26:35.50,Default,zi,0,0,0,,اللعنة، في الوقت الذي تحتاج فيه إلى الركض،
Dialogue: 0,0:26:35.65,0:26:37.77,Default,zi,0,0,0,,تعثرت بحجر الحمل وسقطت.
Dialogue: 0,0:26:38.89,0:26:40.50,Default,zi,0,0,0,,لا تقلقي يا ملكتي.
Dialogue: 0,0:26:41.54,0:26:46.07,Default,zi,0,0,0,,سأتخلص بالتأكيد من كل فساد جوسون.
Dialogue: 0,0:26:47.48,0:26:49.18,Default,zi,0,0,0,,من أجل طفلنا،
Dialogue: 0,0:26:50.37,0:26:52.54,Default,zi,0,0,0,,من سيرث البلاد.
Dialogue: 0,0:26:54.95,0:26:56.08,Default,zi,0,0,0,,حسنًا.
Dialogue: 0,0:26:57.72,0:27:00.85,Default,zi,0,0,0,,إذا أصبح هذا الطفل ملكاً\N وورث البلاد...
Dialogue: 0,0:27:02.08,0:27:05.38,Default,zi,0,0,0,,هل يمكنني الحصول على السلطة المطلقة؟
Dialogue: 0,0:27:07.96,0:27:09.67,Default,zi,0,0,0,,عالم سونغ وون
Dialogue: 0,0:27:09.67,0:27:13.00,Default,zi,0,0,0,,عالم سويون
Dialogue: 0,0:27:13.63,0:27:15.63,Default,zi,0,0,0,,لماذا لم أفكر في هذا من قبل؟
Dialogue: 0,0:27:17.17,0:27:18.44,Default,zi,0,0,0,,-عمّا تتحدثين؟\N-عزيزتي!
Dialogue: 0,0:27:18.44,0:27:19.63,Default,zi,0,0,0,,انظر!
Dialogue: 0,0:27:19.87,0:27:23.95,Default,zi,0,0,0,,كل شيء تحت هذه السماء -
Dialogue: 0,0:27:25.64,0:27:26.87,Default,zi,0,0,0,,كله لك.
Dialogue: 0,0:27:28.98,0:27:29.99,Default,zi,0,0,0,,دعونا نعود.
Dialogue: 0,0:27:29.99,0:27:32.34,Default,zi,0,0,0,,الآن سأبدأ التدريب الحقيقي قبل الولادة.
Dialogue: 0,0:27:32.79,0:27:33.99,Default,zi,0,0,0,,الحاضر؟
Dialogue: 0,0:27:33.99,0:27:35.99,Default,zi,0,0,0,,أحتاج إلى تعليمه كيفية الفوز في المعركة.
Dialogue: 0,0:27:36.79,0:27:39.76,Default,zi,0,0,0,,سيتعين على هذا الطفل أن يعيش في قصر معادٍ.
Dialogue: 0,0:27:40.53,0:27:41.65,Default,zi,0,0,0,,لنذهب، لنبدأ بالفعل.
Dialogue: 0,0:27:41.65,0:27:43.73,Default,zi,0,0,0,,لقد وصلنا للتو.
Dialogue: 0,0:27:45.56,0:27:47.77,Default,zi,0,0,0,,حتى لو كتبت 100 مجلد من القاموس،
Dialogue: 0,0:27:49.13,0:27:51.56,Default,zi,0,0,0,,هل سيأتي اليوم الذي أستطيع أن أفهمها فيه؟
Dialogue: 0,0:27:51.56,0:27:54.78,Default,zi,0,0,0,,-انتظر! انتظرني.\N-Hurry!
Dialogue: 0,0:27:59.02,0:28:00.52,Default,المستوى 3,0,0,0,,مذكرات الحمل
Dialogue: 0,0:28:16.31,0:28:17.37,افتراضي,المستوى 3,0,0,0,,عزيزتي,
Dialogue: 0,0:28:18.67,0:28:20.48,Default,المستوى 3,0,0,0,,للبقاء على قيد الحياة في القصر،
Dialogue: 0,0:28:20.48,0:28:23.18,Default,المستوى 3,0,0,0,,يجب أن تجمع حولك أشخاصًا موثوقين.
Dialogue: 0,0:28:28.78,0:28:30.12,Default,المستوى 3,0,0,0,,جلالتك!
Dialogue: 0,0:28:31.52,0:28:34.02,Default,المستوى 3,0,0,0,,إنهم حقًا أفضل المحاربين في جوسون.
Dialogue: 0,0:28:34.39,0:28:35.42,افتراضي,المستوى 3,0,0,0,,عزيزتي,
Dialogue: 0,0:28:35.52,0:28:38.63,Default,المستوى 3,0,0,0,,يجب أن تبقي أعدائك قريبين منك.
Dialogue: 0,0:28:39.19,0:28:40.76,Default,المستوى 3,0,0,0,,قل ألف محارب.
Dialogue: 0,0:28:41.96,0:28:43.43,Default,المستوى 3,0,0,0,,بمثل هذه القوة العسكرية
Dialogue: 0,0:28:44.07,0:28:46.67,Default,نطاق الرماية 3,0,0,0,,هل ستستولي على قاعة سيونغجونغجونغ أم ماذا؟
Dialogue: 0,0:28:47.00,0:28:48.47,Default,المستوى 3,0,0,0,,هل أنت خائف؟
Dialogue: 0,0:28:50.74,0:28:52.98,Default,المستوى 3,0,0,0,,أعتقد أنك الوحيد الخائف هنا،
Dialogue: 0,0:28:52.98,0:28:55.08,Default,المستوى 3,0,0,0,,مرات أعدوا لي ألف محارب.
Dialogue: 0,0:28:55.58,0:28:57.41,Default,المستوى 3,0,0,0,,خفض عدد المحاربين إلى النصف.
Dialogue: 0,0:28:57.41,0:28:59.41,Default,المستوى 3,0,0,0,,والباقي في الحرس الملكي.
Dialogue: 0,0:29:00.05,0:29:03.69,Default,المستوى 3,0,0,0,,عزيزي، يجب أن يكون لديك خزينتك السرية الخاصة.
Dialogue: 0,0:29:05.39,0:29:07.52,Default,المستوى 3,0,0,0,,لقد تم سك هذه العملات للتو.
Dialogue: 0,0:29:07.52,0:29:09.89,Default,المستوى 3,0,0,0,,-كم عددهم هناك؟\N-مليون.
Dialogue: 0,0:29:12.23,0:29:14.73,Default,المستوى 3,0,0,0,,هل هذا هو استثمارك في السياسة؟
Dialogue: 0,0:29:15.56,0:29:17.37,Default,المستوى 3,0,0,0,,من يملك المال يملك السلطة.
Dialogue: 0,0:29:18.70,0:29:22.04,Default,المستوى 3,0,0,0,,وأخيرًا يا عزيزي، الدرس الأهم.
Dialogue: 0,0:29:22.70,0:29:25.81,Default,المستوى 3,0,0,0,,تخلص من كل من ليس إلى جانبك.
Dialogue: 0,0:29:26.21,0:29:28.41,Default,المستوى 3,0,0,0,,الحياة لعبة، والعالم غابة.
Dialogue: 0,0:29:28.41,0:29:31.68,Default,المستوى 3,0,0,0,,سوف تؤكل إذا لم تأكل الآخرين أولاً. هذه حفلة قاتلة!
Dialogue: 0,0:29:32.31,0:29:34.25,Default,المستوى 3,0,0,0,,بالطبع ستحاول إحلال السلام.
Dialogue: 0,0:29:34.78,0:29:36.69,Default,المستوى 3,0,0,0,,ولكن إذا لم يكن هناك أمل،
Dialogue: 0,0:29:36.69,0:29:39.62,Default,المستوى 3,0,0,0,,يجب أن تفوز بأي ثمن يا صغيري.
Dialogue: 0,0:29:43.03,0:29:45.73,Default,المستوى 3,0,0,0,,أنا سعيد جدًا لأن صاحبة الجلالة
Dialogue: 0,0:29:45.86,0:29:47.76,Default,المستوى 3,0,0,0,,تأقلمت مع حماستي.
Dialogue: 0,0:29:47.96,0:29:50.97,Default,tier 3,0,0,0,,لم يولد بعد، وتريد أن تخبره بأشياء كثيرة بالفعل؟
Dialogue: 0,0:29:51.77,0:29:53.67,Default,tier 3,0,0,0,,سوف يستمع وهو جالس في بطنه.
Dialogue: 0,0:29:53.94,0:29:56.27,Default,المستوى 3,0,0,0,,وسيتوقف بمجرد ولادته.
Dialogue: 0,0:29:57.81,0:30:01.11,Default,المستوى 3,0,0,0,,حان وقت الذهاب إلى السرير.
Dialogue: 0,0:30:01.61,0:30:04.85,Default,المستوى 3,0,0,0,,ليس لدي وقت للنوم: هناك الكثير لأفعله.
Dialogue: 0,0:30:05.71,0:30:07.42,Default,المستوى 3,0,0,0,,الحياة مثل جهاز المشي،
Dialogue: 0,0:30:07.42,0:30:10.49,Default,المستوى 3,0,0,0,,ما عليك إلا أن تتوقف لثانية واحدة وسوف تسقط على الفور.
Dialogue: 0,0:30:11.92,0:30:13.82,Default,المستوى 3,0,0,0,,حتى الحمل لن يمنعني.
Dialogue: 0,0:30:15.82,0:30:17.39,Default,المستوى 3,0,0,0,,وإلا سيتوقف.
Dialogue: 0,0:30:19.60,0:30:23.17,Default,tier 3,0,0,0,,في روحي لدي محرك، ولكن في الواقع لدي دواسات.
Dialogue: 0,0:30:38.01,0:30:39.05,Default,المستوى 3,0,0,0,,لم أراك منذ وقت طويل.
Dialogue: 0,0:30:39.48,0:30:40.72,Default,المستوى 3,0,0,0,,لابد أن الأمر كان صعباً عليك.
Dialogue: 0,0:30:41.68,0:30:42.68,Default,المستوى 3,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:30:51.56,0:30:52.90,Default,المستوى 3,0,0,0,,لقد أكملت البرنامج التعليمي للتكتيكات.
Dialogue: 0,0:30:53.00,0:30:55.23,Default,المستوى 3,0,0,0,,هؤلاء الأشخاص لم يحملوا أسلحة قط،
Dialogue: 0,0:30:55.50,0:30:57.47,Default,المستوى 3,0,0,0,,لذلك سيكون من الصعب تدريبهم.
Dialogue: 0,0:30:58.20,0:30:59.33,Default,المستوى 3,0,0,0,,لكن البرنامج التعليمي سيساعد.
Dialogue: 0,0:31:03.17,0:31:04.21,Default,المستوى 3,0,0,0,,كن حذرًا.
Dialogue: 0,0:31:15.65,0:31:17.42,افتراضي,المستوى 3,0,0,0,,لم أكن أعرف
Dialogue: 0,0:31:18.39,0:31:19.89,Default,المستوى 3,0,0,0,,لقد زاد عدد المتابعين كثيرًا.
Dialogue: 0,0:31:20.66,0:31:23.03,Default,المستوى 3,0,0,0,,بمعنى آخر، كثير من الناس
Dialogue: 0,0:31:23.03,0:31:24.96,Default,المستوى 3,0,0,0,,وجدنا أنفسنا في موقف صعب.
Dialogue: 0,0:31:25.49,0:31:28.80,Default,المستوى 3,0,0,0,,لقد اجتذبوا مؤخرًا مجموعة متنوعة من الطبقات:
Dialogue: 0,0:31:29.23,0:31:31.07,Default,المستوى 3,0,0,0,,من النبلاء المدمرين إلى الحراثين.
Dialogue: 0,0:31:31.40,0:31:33.20,Default,المستوى 3,0,0,0,,ربما كما قالت الملكة،
Dialogue: 0,0:31:34.84,0:31:36.81,Default,المستوى 3,0,0,0,,هل الحل لدينا هو إلغاء التقسيم الطبقي؟
Dialogue: 0,0:31:37.37,0:31:39.37,Default,المستوى 3,0,0,0,,علينا الحذر
Dialogue: 0,0:31:40.21,0:31:41.64,Default,المستوى 3,0,0,0,,تغييرات أساسية.
Dialogue: 0,0:31:42.95,0:31:44.71,Default,المستوى 3,0,0,0,,بالطبع، لا يزال هذا طريقًا طويلًا.
Dialogue: 0,0:31:45.65,0:31:47.62,Default,المستوى 3,0,0,0,,ربما لن أتمكن من فعل هذا، لكن،
Dialogue: 0,0:31:49.32,0:31:51.65,Default,المستوى 3,0,0,0,,ربما يستطيع طفلي ذلك.
Dialogue: 0,0:31:59.96,0:32:02.56,Default,المستوى 3,0,0,0,,صاحب الجلالة، صاحب الجلالة...
Dialogue: 0,0:32:03.87,0:32:05.10,Default,المستوى 3,0,0,0,,لا توقظها.
Dialogue: 0,0:32:14.44,0:32:16.35,Default,المستوى 3,0,0,0,,إنها مثل الطفلة تمامًا.
Dialogue: 0,0:32:25.15,0:32:28.26,افتراضي,المستوى 3,0,0,0,,سجل الحمل
Dialogue: 0,0:32:28.29,0:32:30.43,Default,المستوى 3,0,0,0,,يجب أن تبقي أعدائك قريبين منك.
Dialogue: 0,0:32:33.86,0:32:36.30,Default,المستوى 3,0,0,0,,عزيزتي، يجب أن يكون لديك خزينتك السرية الخاصة.
Dialogue: 0,0:32:41.04,0:32:42.54,Default,المستوى 3,0,0,0,,الحياة لعبة، والعالم غابة.
Dialogue: 0,0:32:42.54,0:32:44.57,Default,المستوى 3,0,0,0,,سوف تؤكل إذا لم تأكل الآخرين أولاً. هذه حفلة قاتلة!
Dialogue: 0,0:32:45.24,0:32:46.27,Default,المستوى 3,0,0,0,"الحفلة"؟
Dialogue: 0,0:32:47.68,0:32:48.68,Default,المستوى 3,0,0,0,,المساء...
Dialogue: 0,0:32:51.35,0:32:53.45,Default,المستوى 3,0,0,0,,لا أفهم ماذا تعني "إنكا".
Dialogue: 0,0:32:54.05,0:32:55.35,Default,المستوى 3,0,0,0,,الحفلة.
Dialogue: 0,0:33:00.26,0:33:03.13,Default,tier 3,0,0,0,,بما أن كل شيء على ما يرام مع الملكة، فلم تتأذى.
Dialogue: 0,0:33:03.53,0:33:07.13,Default,المستوى 3,0,0,0,,عرفت أن الطلسم الذي أعطيته يعمل كما ينبغي.
Dialogue: 0,0:33:07.50,0:33:09.70,Default,المستوى 3,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:33:09.70,0:33:10.73,افتراضي،المستوى 3,0,0,0,,أعتقد
Dialogue: 0,0:33:11.40,0:33:14.40,Default,المستوى 3,0,0,0,,هل نشرت الشائعات كما أخبرتك؟
Dialogue: 0,0:33:15.44,0:33:16.51,Default,المستوى 3,0,0,0,,لا يمكن أن يكون.
Dialogue: 0,0:33:17.44,0:33:19.37,Default,المستوى 3,0,0,0,,أنت تثرثر منذ الصباح.
Dialogue: 0,0:33:20.08,0:33:21.91,Default,المستوى 3,0,0,0,,هل ذهبت على الأقل لتغسل وجهك؟
Dialogue: 0,0:33:21.91,0:33:25.08,Default,المستوى 3,0,0,0,,يجب أن تسمع هذا. أنا متأكد من أنك سوف تغفو على الفور.
Dialogue: 0,0:33:27.02,0:33:28.78,Default,التصويب 3,0,0,0,,تعلمين، الملكة...
Dialogue: 0,0:33:33.12,0:33:34.19,Default,المستوى 3,0,0,0,,مثل هذا.
Dialogue: 0,0:33:34.19,0:33:37.93,Default,المستوى 3,0,0,0,,ماذا؟ هل تظاهر جلالة الملك والملكة بالنوم معًا؟
Dialogue: 0,0:33:38.16,0:33:42.46,Default,tier 3,0,0,0,,تظاهر جلالته والملكة بالنوم معًا.
Dialogue: 0,0:33:49.97,0:33:52.34,Default,المستوى 3,0,0,0,,سمعت أنهما لم يناما معًا في الواقع.
Dialogue: 0,0:33:52.34,0:33:54.31,Default,المستوى 3,0,0,0,,لقد أمضوا الليلة في نفس الغرفة.
Dialogue: 0,0:33:56.58,0:34:00.32,Default,المستوى 3,0,0,0,,ماذا؟ ثم من هو طفلها؟
Dialogue: 0,0:34:01.18,0:34:03.22,Default,المستوى 3,0,0,0,,من هو طفلها منذ ذلك الحين؟
Dialogue: 0,0:34:03.22,0:34:05.45,Default,المستوى 3,0,0,0,,-لا يمكن أن يكون.\N-سمعت أنهم كانوا يتظاهرون.
Dialogue: 0,0:34:20.30,0:34:23.64,Default,المستوى 3,0,0,0,,لا بد أنك سمعت الشائعات المنتشرة حول القصر.
Dialogue: 0,0:34:23.64,0:34:26.01,Default,المستوى 3,0,0,0,,الشائعات دائماً خطوة واحدة وراء الحقيقة.
Dialogue: 0,0:34:26.31,0:34:28.11,Default,المستوى 3,0,0,0,,هذه قصة قديمة.
Dialogue: 0,0:34:28.11,0:34:31.51,Default,المستوى 3,0,0,0,,لا ينبغي الاستخفاف بالشائعات في القصر.
Dialogue: 0,0:34:31.51,0:34:34.72,Default,المستوى 3,0,0,0,,يمكنهم استخدامها لعزلك.
Dialogue: 0,0:34:34.72,0:34:36.62,Default,المستوى 3,0,0,0,,بالضبط، هدفهم هو شهادتي.
Dialogue: 0,0:34:36.95,0:34:38.72,Default,المستوى 3,0,0,0,,إنهم يلعبون بطريقة قذرة وتافهة.
Dialogue: 0,0:34:38.72,0:34:40.46,Default,المستوى 3,0,0,0,,لن أسمح لهم بطردي.
Dialogue: 0,0:34:40.99,0:34:42.32,Default,المستوى 3,0,0,0,,-نعم.\N- هونغ يونغ.
Dialogue: 0,0:34:47.26,0:34:48.46,Default,المستوى 3,0,0,0,,لماذا تحتاج إلى دبوس شعر؟
Dialogue: 0,0:35:12.75,0:35:15.39,Default,المستوى 3,0,0,0,,ما نوع هذه الوضعية المتحدية؟
Dialogue: 0,0:35:15.39,0:35:16.99,Default,المستوى 3,0,0,0,,علينا دحض الشائعات.
Dialogue: 0,0:35:17.49,0:35:19.69,Default,إطلاق النار 3,0,0,0,,-انظر فقط.\N-أمام الناس مباشرةً.
Dialogue: 0,0:35:19.69,0:35:21.23,Default,إطلاق النار 3,0,0,0,,-كم هو محرج.\N-لا أستطيع المشاهدة.
Dialogue: 0,0:35:24.43,0:35:25.53,Default,المستوى 3,0,0,0,,في هذه الحالة.
Dialogue: 0,0:35:28.67,0:35:30.67,Default,المستوى 3,0,0,0,,هذا لا يكفي لقمع الشائعات.
Dialogue: 0,0:35:31.81,0:35:33.18,Default,المستوى 3,0,0,0,,دعونا نحاول.
Dialogue: 0,0:35:33.18,0:35:35.08,Default,المستوى 3,0,0,0,,أليس هذا كثيرًا؟
Dialogue: 0,0:35:35.94,0:35:37.45,Default,المستوى 3,0,0,0,,لكنني لم أظهر كل شيء بعد.
Dialogue: 0,0:35:46.45,0:35:47.52,Default,المستوى 3,0,0,0,,غير كافٍ.
Dialogue: 0,0:35:51.13,0:35:52.99,Default,المستوى 3,0,0,0,,تابع، واصل.
Dialogue: 0,0:35:52.99,0:35:56.90,Default,نطاق الرماية 3,0,0,0,,إذا واصلت، فسنحتاج بالفعل إلى خيمة.
Dialogue: 0,0:35:57.83,0:35:59.37,Default,المستوى 3,0,0,0,,هل هذا ما تريده؟
Dialogue: 0,0:36:00.00,0:36:01.34,Default,المستوى 3,0,0,0,,لم أقل ذلك.
Dialogue: 0,0:36:01.34,0:36:03.14,Default,المستوى 3,0,0,0,,نحن بحاجة إلى تحفيز خيالهم.
Dialogue: 0,0:36:03.47,0:36:06.17,Default,المستوى 3,0,0,0,,ثم لنفس الغرض
Dialogue: 0,0:36:07.38,0:36:09.21,Default,المستوى 3,0,0,0,,سأزور دايجوجون اليوم.
Dialogue: 0,0:36:18.39,0:36:20.72,Default,المستوى 3,0,0,0,,ليس لدي خيار، لأنه من الممكن عزلي.
Dialogue: 0,0:36:20.72,0:36:21.72,افتراضي,المستوى 3,0,0,0,,ثم
Dialogue: 0,0:36:23.02,0:36:24.73,Default,المستوى 3,0,0,0,,أراك لاحقاً.
Dialogue: 0,0:36:36.37,0:36:38.91,Default,المستوى 3,0,0,0,,-هل رحلت؟\N-إنهم بطيئون للغاية.
Dialogue: 0,0:36:38.91,0:36:40.71,Default,المستوى 3,0,0,0,,مازلت تنظر إلينا.
Dialogue: 0,0:36:40.71,0:36:42.98,Default,المستوى 3,0,0,0,,ثم لا تترك لي أي خيار.
Dialogue: 0,0:37:04.23,0:37:07.04,Default,المستوى 3,0,0,0,,جلالتك، المحظية الرئيسية قد وصلت.
Dialogue: 0,0:37:14.68,0:37:16.28,Default,المستوى 3,0,0,0,,هل رتبت هذا؟
Dialogue: 0,0:37:21.52,0:37:23.89,Default,المستوى 3,0,0,0,,-ما الذي تتحدث عنه؟\N-أنا أتحدث عن الشائعات.
Dialogue: 0,0:37:25.52,0:37:27.79,Default,المستوى 3,0,0,0,,كل هذا بفضلك.
Dialogue: 0,0:37:28.76,0:37:31.99,Default,المستوى 3,0,0,0,,تذكرت ما قلته لي من قبل.
Dialogue: 0,0:37:32.76,0:37:36.36,Default,المستوى 3,0,0,0,,لقد قلت أن لياليهما معًا كانت مجرد مسرحية.
Dialogue: 0,0:37:37.27,0:37:41.47,Default,المستوى 3,0,0,0,,لذلك لن يتم الاحتفال بحمل الملكة.
Dialogue: 0,0:37:41.94,0:37:43.77,Default,المستوى 3,0,0,0,,كلماتك
Dialogue: 0,0:37:44.07,0:37:46.74,Default,المستوى 3,0,0,0,,أصبح سهمًا وأصاب الملكة.
Dialogue: 0,0:37:46.94,0:37:48.61,Default,المستوى 3,0,0,0,,من فضلك توقف عن هذا.
Dialogue: 0,0:37:48.61,0:37:50.88,Default,المستوى 3,0,0,0,,لا أتحكم في هذا.
Dialogue: 0,0:37:51.11,0:37:53.85,Default,المستوى 3,0,0,0,,بمجرد أن يبدأ الناس بالنميمة،
Dialogue: 0,0:37:53.85,0:37:55.95,Default,المستوى 3,0,0,0,,ولا يمكنهم التوقف.
Dialogue: 0,0:37:57.19,0:38:01.42,Default,المستوى 3,0,0,0,,وقد فات الأوان بالنسبة لك لإعفاء نفسك من المسؤولية.
Dialogue: 0,0:38:03.26,0:38:08.03,Default,المستوى 3,0,0,0,,بينما أنت هنا، لا يمكنك أن تكون حراً.
Dialogue: 0,0:38:09.73,0:38:13.87,Default,tier 3,0,0,0,,وجودك سيكون بمثابة دعم لسمعة عائلتنا.
Dialogue: 0,0:38:14.57,0:38:17.84,Default,المستوى 3,0,0,0,,من الأفضل أن تكون البادئ بدلاً من أن يتم استخدامك.
Dialogue: 0,0:38:21.61,0:38:22.88,Default,المستوى 3,0,0,0,,هذا مخيف.
Dialogue: 0,0:38:23.91,0:38:25.08,Default,المستوى 3,0,0,0,,أنا أفهم.
Dialogue: 0,0:38:27.62,0:38:31.62,Default,المستوى 3,0,0,0,,لكنك لست وحدك، لذا لا تقلق.
Dialogue: 0,0:38:40.93,0:38:44.07,Default,المستوى 3,0,0,0,,أنا أتحول إلى شخص مثلك -
Dialogue: 0,0:38:44.83,0:38:46.03,Default,المستوى 3,0,0,0,,هذا هو المخيف.
Dialogue: 0,0:38:47.77,0:38:50.87,Default,المستوى 3,0,0,0,,هل تعرف لماذا تتبع العائلة تعليماتك؟
Dialogue: 0,0:38:51.51,0:38:54.11,Default,المستوى 3,0,0,0,,لأنك ضحية بريئة،
Dialogue: 0,0:38:54.11,0:38:55.94,Default,المستوى 3,0,0,0,,أعاني من فقدان طفل.
Dialogue: 0,0:38:56.64,0:38:58.68,Default,المستوى 3,0,0,0,,ولكن ماذا لو كنت أماً بلا روح،
Dialogue: 0,0:38:58.68,0:39:00.92,Default,المستوى 3,0,0,0,,ضحت بابنها من أجل البقاء؟
Dialogue: 0,0:39:01.45,0:39:03.92,Default,المستوى 3,0,0,0,,وعلاوة على ذلك، ماذا لو كنت امرأة غبية،
Dialogue: 0,0:39:03.92,0:39:05.22,Default,المستوى 3,0,0,0,,الاعتماد على الشامان
Dialogue: 0,0:39:05.22,0:39:07.46,Default,المستوى 3,0,0,0,,فيما يتعلق بمستقبل نوعنا؟
Dialogue: 0,0:39:08.16,0:39:10.13,Default,المستوى 3,0,0,0,,هل ستبقى مسؤولاً؟
Dialogue: 0,0:39:11.76,0:39:14.66,Default,المستوى 3,0,0,0,,سأكتب كل ما سمعته ورأيته هنا،
Dialogue: 0,0:39:14.66,0:39:16.66,Default,المستوى 3,0,0,0,,لذلك سيعرف الجميع في جوسون من أنت.
Dialogue: 0,0:39:19.80,0:39:22.37,Default,المستوى 3,0,0,0,,الكلمات ليس لديها مثل هذه القوة.
Dialogue: 0,0:39:22.37,0:39:25.41,Default,المستوى 3,0,0,0,,ستظل تعرف قوتهم.
Dialogue: 0,0:39:26.88,0:39:30.15,Default,المستوى 3,0,0,0,,لقد أخبرتني ذات مرة\N أنك لا تريد أن تشعر بالأسف بعد الآن.
Dialogue: 0,0:39:30.65,0:39:32.05,Default,المستوى 3,0,0,0,,أنت لا تستحق
Dialogue: 0,0:39:32.05,0:39:34.42,Default,المستوى 3,0,0,0,,أندم على وفاة الملك الراحل.
Dialogue: 0,0:39:34.78,0:39:37.02,Default,tier 3,0,0,0,,يجب أن تندم لأنك دهست حلمه.
Dialogue: 0,0:39:38.22,0:39:40.92,Default,المستوى 3,0,0,0,,يجب أن تكوني آسفة كوالدته،
Dialogue: 0,0:39:41.42,0:39:42.72,Default,المستوى 3,0,0,0,,الذي دمر حلم ابني.
Dialogue: 0,0:39:43.32,0:39:45.63,Default,المستوى 3,0,0,0,,ربما أراد الملك الراحل فعلاً
Dialogue: 0,0:39:46.39,0:39:48.33,Default,المستوى 3,0,0,0,,اخرج من ظلك.
Dialogue: 0,0:39:48.33,0:39:49.33,Default,المستوى 3,0,0,0,,ماذا؟
Dialogue: 0,0:39:51.47,0:39:53.17,Default,المستوى 3,0,0,0,,أنت لا تعرف شيئًا.
Dialogue: 0,0:39:53.97,0:39:57.01,Default,المستوى 3,0,0,0,,كيف تجرؤ على قول ذلك؟
Dialogue: 0,0:39:57.01,0:39:58.51,Default,المستوى 3,0,0,0,,هذه هي الحقيقة المعروفة للجميع.
Dialogue: 0,0:39:59.67,0:40:01.78,Default,المستوى 3,0,0,0,,وأنا متأكد من أنك تعرف هذا أيضًا.
Dialogue: 0,0:40:03.48,0:40:06.45,Default,tier 3,0,0,0,,لن أسمح لك بتدمير حلم جلالته.
Dialogue: 0,0:40:10.29,0:40:11.42,Default,المستوى 3,0,0,0,,هذه الفتاة...
Dialogue: 0,0:40:24.17,0:40:25.63,Default,Spilik4,0,0,0,,سأذهب إلى قاعة دايجوجون.
Dialogue: 0,0:40:25.93,0:40:27.00,Default,Spilyk4,0,0,0,,نعم.
Dialogue: 0,0:40:39.31,0:40:42.65,Default,Spikyulka4,0,0,0,,يقولون أن الأحلام تتصدى للشائعات.
Dialogue: 0,0:40:43.95,0:40:45.15,Default,Spilyk4,0,0,0,,إشاعات؟
Dialogue: 0,0:40:45.45,0:40:47.02,Default,Spikyulka4,0,0,0,,لم أخبر أحداً،
Dialogue: 0,0:40:47.02,0:40:49.99,Default,Spikyulka4,0,0,0,,بعد كل شيء، الليلة مع الملك هي مسألة حميمة،
Dialogue: 0,0:40:51.49,0:40:54.80,Default,Spikyulka4,0,0,0,,ولكن إذا اكتشفت ذلك، فسوف تتفاجأ للغاية.
Dialogue: 0,0:40:56.90,0:40:58.13,Default,Spillie4,0,0,0,,في السرير...
Dialogue: 0,0:41:23.86,0:41:25.13,Default,Spilyk4,0,0,0,,شيء من هذا القبيل.
Dialogue: 0,0:41:26.03,0:41:27.80,Default,Spikyulka4,0,0,0,,لا يمكنك إخباري عن الليالي الحارة.
Dialogue: 0,0:41:27.80,0:41:29.60,Default,Spilyk4,0,0,0,,إنه أمر مؤسف.
Dialogue: 0,0:41:29.80,0:41:33.80,Default,Spilik4,0,0,0,,الملك ليس كما يبدو على الإطلاق.
Dialogue: 0,0:41:34.34,0:41:37.54,Default,Spilyk4,0,0,0,,سوف يُسجل صبره في التاريخ.
Dialogue: 0,0:41:42.61,0:41:44.31,Default,Spikyulka4,0,0,0,,هل بسببي انتهى الأمر في الكتب المدرسية؟
Dialogue: 0,0:41:44.91,0:41:48.78,Default,Spikyulka4,0,0,0,,من ينشر مثل هذه النميمة الكاذبة؟
Dialogue: 0,0:41:48.78,0:41:52.65,Default,Spilik4,0,0,0,,فقط المحظية الملكية "تشو" قادرة على ذلك.
Dialogue: 0,0:42:01.66,0:42:02.96,Default,Spilik4,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:42:07.00,0:42:09.87,Default,Spilyk4,0,0,0,,ماذا؟ والآن لماذا أتيت للقتال؟
Dialogue: 0,0:42:17.35,0:42:18.81,Default,Spilik4,0,0,0,,هل أنت متأكد؟
Dialogue: 0,0:42:23.69,0:42:25.45,Default,Spikyulka4,0,0,0,,نحن على يقين أنك مع الملك
Dialogue: 0,0:42:25.95,0:42:28.52,Default,Silk4,0,0,0,,هل يمكنك محاربتهم والفوز؟
Dialogue: 0,0:42:30.89,0:42:32.39,Default,Spilyk4,0,0,0,,هذه معركتي أيضًا.
Dialogue: 0,0:42:32.89,0:42:34.93,Default,Spilyk4,0,0,0,,وأحتاج أيضًا إلى النصر.
Dialogue: 0,0:42:44.20,0:42:46.65,Default,Spilyk4,0,0,0,, إذًا أنت بحاجة إلى التدرب على الرماية.
Dialogue: 0,0:42:47.21,0:42:50.75,Default,Spikyulka4,0,0,0,,بمهاراتك الحالية لن تكون سوى عبئاً.
Dialogue: 0,0:42:53.15,0:42:56.85,Default,Spilik4,0,0,0,,إذن هل يمكنك أن تعلمني؟
Dialogue: 0,0:42:59.45,0:43:00.52,Default,Spilyk4,0,0,0,,لقد
Dialogue: 0,0:43:03.29,0:43:05.16,Default,Spilyk4,0,0,0,,لا وقت لهذا.
Dialogue: 0,0:43:08.90,0:43:11.43,Default,Spilik4,0,0,0,,جلالتك، المحظية "تشو" هنا.
Dialogue: 0,0:43:12.70,0:43:13.87,Default,Spilik4,0,0,0,,دعه يدخل.
Dialogue: 0,0:43:27.05,0:43:29.05,Default,Spilyk4,0,0,0,,لدي خدمة أطلبها منك.
Dialogue: 0,0:43:29.35,0:43:30.35,Default,Spilik4,0,0,0,,تكلم.
Dialogue: 0,0:43:30.35,0:43:32.02,Default,Spilik4,0,0,0,,يجب عليك الوفاء بها.
Dialogue: 0,0:43:33.62,0:43:35.49,Default,Spikyulka4,0,0,0,,وما نوع الطلب؟
Dialogue: 0,0:43:37.43,0:43:40.76,Default,Spilik4,0,0,0,,دعني أغادر القصر.
Dialogue: 0,0:43:45.07,0:43:46.43,Default,Spilik4,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:43:46.87,0:43:50.41,Default,Spilik4,0,0,0,,لا أستطيع أن أجد نفسي في القصر.
Dialogue: 0,0:43:51.04,0:43:53.04,Default,Spikyulka4,0,0,0,,أرجوك أخرجني من القصر،
Dialogue: 0,0:43:53.61,0:43:55.64,Default,Spilik4,0,0,0,,حتى أتمكن من عيش حياتي الخاصة.
Dialogue: 0,0:43:57.71,0:43:58.91,Default,Spikyulka4,0,0,0,,لا أستطيع السماح بهذا.
Dialogue: 0,0:43:59.35,0:44:02.28,Default,Spikyulka4,0,0,0,,أنت تعرف كيف يعني العيش كمحظية ملكية في المنفى.
Dialogue: 0,0:44:02.28,0:44:04.52,Default,Spilyk4,0,0,0,,لا يهمني ما يقولونه عني.
Dialogue: 0,0:44:04.52,0:44:08.46,Default,Spilyk4,0,0,0,,لن ألتزم بهذا بعد الآن.
Dialogue: 0,0:44:10.39,0:44:14.13,Default,Spikyulka4,0,0,0,,هذا هو طلبي الأخير،\Nيرجى تلبيته.
Dialogue: 0,0:44:20.70,0:44:23.07,Default,Spilyk4,0,0,0,,أنا لا أعطي الإذن. لا أستطيع أن أعطيها.
Dialogue: 0,0:44:23.97,0:44:26.21,Default,Spikyulka4,0,0,0,,نحن نقدر بعضنا البعض،
Dialogue: 0,0:44:27.24,0:44:29.48,Default,Spilik4,0,0,0,,لكن لم يعد هناك حب لنا.
Dialogue: 0,0:44:30.14,0:44:31.55,Default,Spilik4,0,0,0,,في القصر
Dialogue: 0,0:44:32.41,0:44:34.08,Default,Spilyk4,0,0,0,,أنا في الأسر
Dialogue: 0,0:44:35.15,0:44:37.75,Default,Spilyk4,0,0,0,,تحت اسم المحظية الملكية.
Dialogue: 0,0:45:19.43,0:45:23.06,Default,Spilik4,0,0,0,,جلالتك. يتم جمع جميع المسؤولين.
Dialogue: 0,0:45:26.43,0:45:31.04,Default,Spilik4,0,0,0,,السبب الذي جعلني أجمعك،
Dialogue: 0,0:45:33.71,0:45:36.31,Default,Spikyulka4,0,0,0,,لدي بيان مهم أود الإدلاء به.
Dialogue: 0,0:45:44.05,0:45:46.15,Default,Spilik4,0,0,0,,من الآن فصاعدا
Dialogue: 0,0:45:46.89,0:45:49.89,Default,Spilik4,0,0,0,,تشو هواجين، القرين الملكي،
Dialogue: 0,0:45:54.56,0:45:56.23,Default,Silk4,0,0,0,,تفقد مكانتها كمحظية ملكية.
Dialogue: 0,0:46:04.71,0:46:06.24,Default,Spikyulka4,0,0,0,,يجب أن نتوقف عن هذا.
Dialogue: 0,0:46:07.38,0:46:11.78,Default,Silk4,0,0,0,,لم تعد المحظية الملكية واحدة منا.
Dialogue: 0,0:46:17.29,0:46:20.79,Default,Spilik4,0,0,0,,جلالتك، كن بصحة جيدة.
Dialogue: 0,0:46:22.06,0:46:25.93,Default,Spilik4,0,0,0,,سأصلي من أجلك.
Dialogue: 0,0:46:45.21,0:46:46.38,Default,Spilik4,0,0,0,,صاحب السمو.
Dialogue: 0,0:46:53.42,0:46:56.49,Default,Spilyk4,0,0,0,,من فضلك لا تناديني بذلك مرة أخرى.
Dialogue: 0,0:46:56.49,0:46:57.89,Default,Spikyulka4,0,0,0,,هذا خطأ.
Dialogue: 0,0:46:59.06,0:47:00.46,Default,Spilik4,0,0,0,,لا ينبغي للملك أن يفعل هذا بك.
Dialogue: 0,0:47:00.46,0:47:02.23,Default,Spilik4,0,0,0,,سألته بنفسي.
Dialogue: 0,0:47:04.13,0:47:06.93,Default,Spikyulka4,0,0,0,,-لماذا؟\N-إنه أفضل للجميع.
Dialogue: 0,0:47:07.84,0:47:11.24,Default,Spilik4,0,0,0,,أثناء وجودي في القصر، سأزعج الملك،
Dialogue: 0,0:47:11.71,0:47:13.84,Default,Spilik4,0,0,0,,دون الرغبة في ذلك.
Dialogue: 0,0:47:13.84,0:47:15.78,Default,Spikyulka4,0,0,0,,سأتأكد من عدم حدوث ذلك.
Dialogue: 0,0:47:16.51,0:47:18.15,Default,Silk4,0,0,0,,لم يفت الأوان بعد للعودة.
Dialogue: 0,0:47:18.15,0:47:19.88,Default,Spilik4,0,0,0,,سأذهب وأخبر الملك...
Dialogue: 0,0:47:21.85,0:47:23.99,Default,Spilik4,0,0,0,,لم أعد أصدق نفسي.
Dialogue: 0,0:47:25.09,0:47:29.29,Default,Spikyulka4,0,0,0,,إذا بقيت هنا لفترة أطول، فسوف أفقد نفسي تماماً.
Dialogue: 0,0:47:30.99,0:47:34.53,Default,Spilik4,0,0,0,,تظاهرت بأنني لا أعرف
Dialogue: 0,0:47:35.76,0:47:38.00,Default,Spilik4,0,0,0,,عن مشاعرك تجاهي.
Dialogue: 0,0:47:41.67,0:47:44.37,Default,Spilik4,0,0,0,,-صاحب السمو.\N-لقد استخدمتك لأغراضي الخاصة.
Dialogue: 0,0:47:45.87,0:47:48.28,Default,Spillie4,0,0,0,,عندما اشتقت إلى ملك،
Dialogue: 0,0:47:49.11,0:47:51.98,Default,Spilik4,0,0,0,,الفراغ لأنه لم يفتقدني،
Dialogue: 0,0:47:53.08,0:47:55.08,Default,Spikyulka4,0,0,0,,لقد ملأتها معك.
Dialogue: 0,0:47:55.45,0:47:56.62,Default,Spilik4,0,0,0,,أنا
Dialogue: 0,0:47:59.52,0:48:01.96,Default,Spikyulka4,0,0,0,,سمحت لك عن طيب خاطر باستخدامي.
Dialogue: 0,0:48:03.39,0:48:05.19,Default,Spikyulka4,0,0,0,,هذا فقط ما يمكنني فعله
Dialogue: 0,0:48:07.33,0:48:08.60,Default,Spilyk4,0,0,0,,لك.
Dialogue: 0,0:48:09.63,0:48:11.17,Default,Spilik4,0,0,0,,شكرًا لك.
Dialogue: 0,0:48:12.57,0:48:13.70,Default,Spikyulka4,0,0,0,,و
Dialogue: 0,0:48:14.97,0:48:16.50,Default,Spilik4,0,0,0,,عذراً.
Dialogue: 0,0:48:17.51,0:48:19.31,Default,Spikyulka4,0,0,0,,حان الوقت لكي تتوقف
Dialogue: 0,0:48:19.67,0:48:23.01,Default,Silk4,0,0,0,,تؤذي نفسك بحب الشخص الخطأ.
Dialogue: 0,0:48:43.26,0:48:45.67,Default,Spilik4,0,0,0,,هذا ما قصدته.
Dialogue: 0,0:48:52.17,0:48:53.94,Default,Spilyk4,0,0,0,,امرأة رائعة.
Dialogue: 0,0:48:57.31,0:48:58.91,Default,Spilik4,0,0,0,,هل تشيولجونغ بخير؟
Dialogue: 0,0:49:00.78,0:49:02.58,Default,Spilik4,0,0,0,,لست متأكداً من ذلك.
Dialogue: 0,0:49:25.67,0:49:27.21,Default,Spilyk4,0,0,0,,قاتلني.
Dialogue: 0,0:49:27.48,0:49:28.78,Default,Spilik4,0,0,0,,لست في مزاج جيد.
Dialogue: 0,0:49:28.94,0:49:29.98,Default,Spilik4,0,0,0,,في الطفولة
Dialogue: 0,0:49:31.21,0:49:33.41,Default,Silk4,0,0,0,,في "غانغهوادو" غالباً ما كنا نلعب نفس اللعبة.
Dialogue: 0,0:49:35.88,0:49:38.59,Default,Spillikins4,0,0,0,,حيث يفوز الشخص الذي يخطو أولاً على ظل شخص آخر.
Dialogue: 0,0:49:39.35,0:49:40.79,Default,Spilyk4,0,0,0,,الشخص الذي لا يريد أن يلعب،
Dialogue: 0,0:49:42.79,0:49:44.33,Default,Spilik4,0,0,0,,يخسر على الفور.
Dialogue: 0,0:50:09.12,0:50:10.52,Default,Spilik4,0,0,0,,تذكر؟
Dialogue: 0,0:50:11.22,0:50:14.66,Default,Silk4,0,0,0,,عندما كنت طفلاً، كنت أفوز دائمًا.
Dialogue: 0,0:50:17.93,0:50:20.86,Default,Spikyulka4,0,0,0,,أتذكر، ثم فزت دائمًا.
Dialogue: 0,0:50:24.23,0:50:28.34,Default,Spikyulka4,0,0,0,,كان يجب أن أكون أكثر صرامة مع التسلسل الهرمي لدينا في وقت سابق.
Dialogue: 0,0:50:28.64,0:50:31.64,Default,Spilik4,0,0,0,,التسلسل الهرمي ليس له علاقة بالأمر، أنت فقط لا تستطيع الفوز.
Dialogue: 0,0:50:40.61,0:50:44.69,Default,Spilik4,0,0,0,,كانت المحظية "تشو" قلقة عليك حتى النهاية.
Dialogue: 0,0:50:44.85,0:50:47.22,Default,Spikyulka4,0,0,0,,أنت لا تفهم حتى مدى قيمة هذا.
Dialogue: 0,0:50:47.22,0:50:48.36,Default,Spilyk4,0,0,0,,كما أفهمها.
Dialogue: 0,0:50:49.16,0:50:50.59,Default,Spilyk4,0,0,0,,لهذا السبب أعاني كثيراً.
Dialogue: 0,0:51:02.20,0:51:03.57,Default,Spilik4,0,0,0,,يجب أن تعاني أكثر.
Dialogue: 0,0:51:04.44,0:51:05.51,Default,Spilyk4,0,0,0,,هذا هو الأفضل،
Dialogue: 0,0:51:07.41,0:51:09.48,Default,Spilik4,0,0,0,,ماذا يمكنك أن تفعل لها.
Dialogue: 0,0:51:17.45,0:51:20.09,Default,Spikyulka4,0,0,0,,إلى متى سأعاني\N من الوحدة والقلق؟
Dialogue: 0,0:51:20.59,0:51:21.92,Default,Spilik4,0,0,0,,كم عدد الآخرين؟
Dialogue: 0,0:51:35.96,0:51:39.30,Default,Spilik4,0,0,0,,هل يشرب تشيولجونغ في مكان ما؟
Dialogue: 0,0:51:39.83,0:51:42.07,Default,Silk4,0,0,0,,سيكون من الأفضل لو شربت معه، إن لم يكن من أجل الحمل.
Dialogue: 0,0:51:47.11,0:51:51.18,Default,Spikyulka4,0,0,0,,الحمل لا يعني إنجاب طفل فحسب، بل يعني أن تصبحي طفلاً أيضًا؟
Dialogue: 0,0:51:52.35,0:51:54.32,Default,Spilyk4,0,0,0,,لماذا تشعر بالنعاس طوال الوقت؟
Dialogue: 0,0:52:10.03,0:52:11.47,Default,Spilik4,0,0,0,,سأذهب إلى قاعة Dongmyeongjong.
Dialogue: 0,0:52:13.03,0:52:14.20,Default,Spilik4,0,0,0,,كن حذراً يا صاحب الجلالة.
Dialogue: 0,0:52:14.77,0:52:16.40,Default,Spilyk4,0,0,0,,إشاعة خطيرة,
Dialogue: 0,0:52:16.40,0:52:19.07,Default,Spikyulka4,0,0,0,,إذا اكتشفوا أنه جاء منك...
Dialogue: 0,0:52:19.94,0:52:22.91,Default,Spilik4,0,0,0,,إلى أن اكتشفت الملكة الأرملة الأمر،
Dialogue: 0,0:52:23.41,0:52:25.31,Default,Spilik4,0,0,0,,يجب أن أخبرها بنفسي.
Dialogue: 0,0:52:26.21,0:52:28.35,Default,Silk4,0,0,0,,-لكن..\N-لا تقلق.
Dialogue: 0,0:52:29.08,0:52:32.09,Default,Spilyk4,0,0,0,,إنهم لا يستطيعون حتى التخيل،
Dialogue: 0,0:52:32.09,0:52:33.89,Default,Spikyulka4,0,0,0,,أنني سأشارك إشاعة بدأتها بنفسي.
Dialogue: 0,0:52:37.86,0:52:40.33,Default,Spilik4,0,0,0,,ظهرت بدون دعوة.
Dialogue: 0,0:52:40.69,0:52:42.70,Default,Spikyulka4,0,0,0,,أفترض أنني سأطلب معروفاً مرة أخرى.
Dialogue: 0,0:52:42.70,0:52:45.00,Default,Spikyulka4,0,0,0,,لقد سمعت شائعات مذهلة.
Dialogue: 0,0:52:45.00,0:52:48.14,Default,Spikyulka4,0,0,0,,كنت أخشى أن تصاب بالمرض من مثل هذه الأخبار.
Dialogue: 0,0:52:48.54,0:52:50.84,Default,Spilik4,0,0,0,,لذا جئت على الفور.
Dialogue: 0,0:52:50.84,0:52:52.21,Default,Spilik4,0,0,0,,إشاعات؟
Dialogue: 0,0:52:54.48,0:52:58.45,Default,Spilyk4,0,0,0,,لماذا كل هذا الجهد؟
Dialogue: 0,0:52:58.45,0:53:02.38,Default,Spikyulka4,0,0,0,,إذا كنت تعرف ما الذي نتحدث عنه، فلن تتحدث بهذه الطريقة.
Dialogue: 0,0:53:03.32,0:53:04.75,Default,Spilyk4,0,0,0,,حتى فضولي.
Dialogue: 0,0:53:05.09,0:53:08.49,Default,Spikyulka4,0,0,0,,أي نوع من الشائعات هو أنك اندفعت بجنون.
Dialogue: 0,0:53:09.39,0:53:12.26,Default,Spilik4,0,0,0,,إنه جيد جدًا بحيث لا يمكن تفويته،
Dialogue: 0,0:53:12.56,0:53:16.03,Default,Spill4,0,0,0,,كيف سيتغير وجهك عندما تسمع ذلك.
Dialogue: 0,0:53:18.30,0:53:20.40,Default,Spilyk4,0,0,0,,من غير المرجح أن يتغير وجهي بهذا الشكل بسبب الشائعات،
Dialogue: 0,0:53:20.40,0:53:22.87,Default,Spilik4,0,0,0,,كم تشتاق لرؤيته.
Dialogue: 0,0:53:25.14,0:53:29.81,Default,Spill4,0,0,0,,ابن الملكة ليس ابن الملك.
Dialogue: 0,0:53:31.18,0:53:34.78,Default,Spikyulka4,0,0,0,,إنه من كيم بيونغين.
Dialogue: 0,0:53:36.92,0:53:40.19,Default,Spilik4,0,0,0,,لقد اهتمت كثيراً بنوعك.
Dialogue: 0,0:53:40.45,0:53:44.86,Default,Spikyulka4,0,0,0,,الآن سيُدرج في التاريخ أن عشيرة كيم الأندونية
Dialogue: 0,0:53:44.86,0:53:47.29,Default,Spilik4,0,0,0,,ملطخ بالدم الملكي.
Dialogue: 0,0:54:00.64,0:54:01.78,Default,Spilyk4,0,0,0,,مثير للاهتمام.
Dialogue: 0,0:54:02.88,0:54:05.05,Default,Spilik4,0,0,0,,الآن أصبح كل شيء أكثر إثارة للاهتمام.
Dialogue: 0,0:54:14.99,0:54:16.79,Default,Spikyulka4,0,0,0,,هل سمعت عن ماذا يتحدثون؟
Dialogue: 0,0:54:17.16,0:54:19.29,Default,Spikyulka4,0,0,0,,نعم، سمعت. لا أساس لها من الصحة.
Dialogue: 0,0:54:19.66,0:54:22.50,Default,Spill4,0,0,0,,نام الملك والملكة معًا
Dialogue: 0,0:54:23.20,0:54:26.97,Default,Spilyk4,0,0,0,,كما هو متوقع. \Nلماذا بدأت الحديث عن هذا حتى وقت متأخر؟
Dialogue: 0,0:54:26.97,0:54:28.34,Default,Spilyk4,0,0,0,,هذا ليس ما أتحدث عنه على الإطلاق.
Dialogue: 0,0:54:28.60,0:54:30.90,Default,Spilik4,0,0,0,,يقولون أن الطفل ليس ملك الملك.
Dialogue: 0,0:54:31.24,0:54:32.67,Default,Spikyulka4,0,0,0,,اصمت، ستجلب المشاكل لنفسك.
Dialogue: 0,0:54:43.28,0:54:45.92,Default,Silk4,0,0,0,,الفناء كله يضحك على عشيرتنا.
Dialogue: 0,0:54:46.69,0:54:50.32,Default,Spilyk4,0,0,0,,الصلة بين الملكة ووزير الحربية، أقارب مقربين؟
Dialogue: 0,0:54:51.09,0:54:53.33,Default,Spikyulka4,0,0,0,,كانت لدي آمال كبيرة عليه.
Dialogue: 0,0:54:54.19,0:54:55.63,Default,Spilik4,0,0,0,,يا له من عار.
Dialogue: 0,0:54:57.13,0:54:58.70,Default,Spiky4,0,0,0,,بعد إيداع المحظية تشو،
Dialogue: 0,0:54:58.70,0:55:00.93,Default,Spikyulka4,0,0,0,,ظننت أنني انتهيت.
Dialogue: 0,0:55:00.93,0:55:04.40,Default,Spikyulka4,0,0,0,,ولكن بعد الشائعات حول الملكة،\NI أشعر وكأنني فزت.
Dialogue: 0,0:55:07.27,0:55:10.91,Default,Spikyulka4,0,0,0,,الطفل ليس من دم ملكي، بل من دماء جيدة.
Dialogue: 0,0:55:31.53,0:55:34.57,Default,Spilik4,0,0,0,,عائلتي أهم من حياتي.
Dialogue: 0,0:55:35.74,0:55:38.11,Default,Spilyk4,0,0,0,,لهذا السبب أعيش من أجل عائلتي.
Dialogue: 0,0:55:39.44,0:55:41.44,Default,Spilik4,0,0,0,,ما الذي تعيش من أجله؟
Dialogue: 0,0:55:41.81,0:55:44.24,Default,Spilik4,0,0,0,,لنفس السبب يا صاحب الجلالة.
Dialogue: 0,0:55:46.05,0:55:47.08,Default,Spilik4,0,0,0,,هل الأمر كذلك؟
Dialogue: 0,0:55:48.48,0:55:51.39,Default,Spilyk4,0,0,0,,إذا كان الأمر كذلك، فهل أنت مستعد لفعل أي شيء من أجل عائلتك؟
Dialogue: 0,0:55:52.35,0:55:53.39,Default,Spilyk4,0,0,0,,نعم.
Dialogue: 0,0:55:54.35,0:55:57.49,Default,Spilik4,0,0,0,,إذًا أحضر لي رأس الملكة أولاً.
Dialogue: 0,0:55:58.39,0:55:59.89,Default,,0,0,0,,هذا أمر.
Dialogue: 0,0:56:01.40,0:56:02.90,Default,,0,0,0,,ما هو السبب؟
Dialogue: 0,0:56:02.90,0:56:07.60,Default,,0,0,0,,دمرت الملكة سمعة عائلتنا التي راكمناها لسنوات.
Dialogue: 0,0:56:10.80,0:56:11.97,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:56:12.41,0:56:14.74,Default,,0,0,0,,لا أعرف ما الذي أغضبك،
Dialogue: 0,0:56:14.74,0:56:16.21,Default,,0,0,0,,ولكن من فضلك ارحمني.
Dialogue: 0,0:56:16.21,0:56:18.11,Default,,0,0,0,,جميع من في القصر يثرثرون
Dialogue: 0,0:56:18.11,0:56:20.85,Default,,0,0,0,,أن الملك والملكة لم يناما معاً.
Dialogue: 0,0:56:20.85,0:56:23.75,Default,,0,0,0,,الآن يقولون أن الطفل ملكك.
Dialogue: 0,0:56:24.45,0:56:25.49,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:56:26.49,0:56:28.02,Default,,0,0,0,,هذا ليس صحيحاً.
Dialogue: 0,0:56:28.02,0:56:30.32,Default,,0,0,0,,ما يعتقده الجميع يصبح حقيقة.
Dialogue: 0,0:56:30.89,0:56:34.29,Default,,0,0,0,,بمجرد أن يأتي الصباح، سينشر الناس هذه الإشاعة
Dialogue: 0,0:56:34.80,0:56:37.13,Default,,0,0,0,,وستصبح الملكة آثمة،
Dialogue: 0,0:56:37.13,0:56:38.77,Default,,0,0,0,,التي حملت من شخص آخر
Dialogue: 0,0:56:38.77,0:56:41.94,Default,,0,0,0,,وكذب أن الطفل من الملك وبذلك فضحه.
Dialogue: 0,0:56:42.97,0:56:44.54,Default,,0,0,0,,ظهرت الشائعات بسبب خطأي.
Dialogue: 0,0:56:45.01,0:56:46.47,Default,,0,0,0,,سوف أقبل عقابي.
Dialogue: 0,0:56:46.91,0:56:48.31,Default,,0,0,0,,الإشاعة قد تؤذي الرجل،
Dialogue: 0,0:56:48.31,0:56:50.64,Default,,0,0,0,,لكنه سيقتل امرأة.
Dialogue: 0,0:56:51.31,0:56:53.08,Default,,0,0,0,,لحفظ شرف عائلتنا،
Dialogue: 0,0:56:53.08,0:56:54.65,Default,,0,0,0,,أحتاج إلى رأس ملكة.
Dialogue: 0,0:56:55.02,0:56:57.72,Default,,0,0,0,,إذا أحضرت لي رأسها بنفسك،
Dialogue: 0,0:56:58.29,0:57:00.19,Default,,0,0,0,,لن أعاقبك.
Dialogue: 0,0:57:01.42,0:57:02.92,Default,,0,0,0,,لا أستطيع.
Dialogue: 0,0:57:03.72,0:57:05.89,Default,,0,0,0,,من الأفضل أن تعاقبني.
Dialogue: 0,0:57:05.89,0:57:07.26,Default,,0,0,0,,قال إنك تعيش من أجل عائلتك،
Dialogue: 0,0:57:07.26,0:57:09.50,Default,,0,0,0,,لكن كل هذا من أجل الملكة فقط!
Dialogue: 0,0:57:10.93,0:57:13.03,Default,,0,0,0,,إذن سأعهد بهذا إلى شخص آخر.
Dialogue: 0,0:57:13.50,0:57:15.30,Default,,0,0,0,,-هل هناك أحد بالخارج؟\N-سأفعل ذلك على الفور
Dialogue: 0,0:57:17.37,0:57:19.71,Default,,0,0,0,,سأعيد وصيتك.
Dialogue: 0,0:57:54.61,0:57:56.64,Default,,0,0,0,,فكرتك خطيرة.
Dialogue: 0,0:57:57.88,0:58:00.61,Default,,0,0,0,,في كتاب باسم الملكة
Dialogue: 0,0:58:01.85,0:58:05.05,Default,,0,0,0,,لقد رأيت كود متابعي تونهاك الذي كتبته أنت.
Dialogue: 0,0:58:10.19,0:58:13.46,Default,,0,0,0,,لقد شوهتك أنت والملكة هذه الفكرة الخطيرة.
Dialogue: 0,0:58:14.73,0:58:16.80,Default,,0,0,0,,يريدون إعادة بناء البلاد.
Dialogue: 0,0:58:18.07,0:58:21.10,Default,,0,0,0,,ماذا سيحدث إذا شعر الأرستقراطيون بالخطر؟
Dialogue: 0,0:58:21.57,0:58:23.47,Default,,0,0,0,,سيحاولون إبقاء كل شيء كما هو،
Dialogue: 0,0:58:23.94,0:58:26.11,Default,,0,0,0,,حتى لو كان ذلك يعني إزهاق أرواح الناس.
Dialogue: 0,0:58:28.48,0:58:31.45,Default,,0,0,0,,ستبدأ مذبحة أتباع تونهاك.
Dialogue: 0,0:58:34.31,0:58:37.72,Default,,0,0,0,,إذن لماذا أتيت إليّ ولم تتبعهم؟
Dialogue: 0,0:58:38.62,0:58:41.19,Default,,0,0,0,,لأنه سيؤذي الملكة.
Dialogue: 0,0:58:46.66,0:58:48.50,Default,,0,0,0,,كيم كلان
Dialogue: 0,0:58:51.30,0:58:53.60,Default,,0,0,0,,يستهدف صاحبة الجلالة.
Dialogue: 0,0:58:55.97,0:58:59.14,Default,,0,0,0,,تنشر الشائعات بأن طفلها مني،
Dialogue: 0,0:58:59.64,0:59:01.88,Default,,0,0,0,,يريدون قتلها حفاظاً على شرفهم.
Dialogue: 0,0:59:03.24,0:59:05.31,Default,,0,0,0,,بهذا يريدون مهاجمتي.
Dialogue: 0,0:59:05.75,0:59:08.25,Default,,0,0,0,,-سأوقفهم.\N-لا يمكنك ذلك.
Dialogue: 0,0:59:10.08,0:59:12.42,Default,,0,0,0,,حتى لو أنقذتها الآن،
Dialogue: 0,0:59:12.79,0:59:15.62,Default,,0,0,0,,عائلتها هي من بدأت الإشاعة،
Dialogue: 0,0:59:16.86,0:59:19.49,Default,,0,0,0,,ستضطر للعيش مع سمعة سيئة.
Dialogue: 0,0:59:21.03,0:59:24.16,Default,,0,0,0,,ليست هي فقط، فالطفل يواجه نفس المصير.
Dialogue: 0,0:59:26.37,0:59:33.34,Default,,0,0,0,,ألا تفهمين أن المسؤولين الذين يهددون منصبك لن يتركوها وشأنها؟
Dialogue: 0,0:59:38.95,0:59:41.25,Default,,0,0,0,,أنت فقط من يستطيع إنقاذ صاحبة الجلالة.
Dialogue: 0,0:59:42.68,0:59:43.82,Default,,0,0,0,,كيف؟
Dialogue: 0,0:59:45.05,0:59:46.92,Default,,0,0,0,,كيف يمكنني إنقاذها؟
Dialogue: 0,0:59:47.45,0:59:49.46,Default,,0,0,0,,سحق الانتفاضة.
Dialogue: 0,0:59:51.26,0:59:53.06,افتراضي,,0,0,0,,ملكية
Dialogue: 0,0:59:53.86,0:59:56.03,Default,,0,0,0,,معاقبة أتباع تونهاك.
Dialogue: 0,0:59:57.40,1:00:00.90,Default,,0,0,0,,افتراء على امرأة الملك التي ذهبت للحرب،
Dialogue: 0,1:00:00.90,1:00:04.07,Default,,0,0,0,,من أجل حماية البلد، هذا غير مناسب، وهذا سوف يبدد الشائعات.
Dialogue: 0,1:00:04.67,1:00:08.48,Default,,0,0,0,,إذا أثبتت براءتك بقتل أتباع تونهاك،
Dialogue: 0,1:00:09.41,1:00:12.48,Default,,0,0,0,,الشفرة الموجودة في الكتاب\N لن تشكل تهديدًا لك بعد الآن.
Dialogue: 0,1:00:14.08,1:00:15.25,Default,,0,0,0,,هذا
Dialogue: 0,1:00:17.18,1:00:20.22,Default,,0,0,0,,الطريقة الوحيدة للحفظ
Dialogue: 0,1:00:22.12,1:00:23.79,Default,,0,0,0,,الملكة وطفلك.
Dialogue: 0,1:00:28.53,1:00:30.30,Default,,0,0,0,,لا وقت للتفكير.
Dialogue: 0,1:00:31.30,1:00:33.83,Default,,0,0,0,,في الصباح ستدمر الشائعات الملكة.
Dialogue: 0,1:00:36.10,1:00:37.47,Default,,0,0,0,,مستحيل
Dialogue: 0,1:00:39.77,1:00:42.21,Default,,0,0,0,,لن أتركها تعاني وحدها.
Dialogue: 0,1:01:14.14,1:01:15.68,Default,,0,0,0,,أنا لا أنام.
Dialogue: 0,1:01:16.48,1:01:18.18,Default,,0,0,0,,فقط أفكر.
Dialogue: 0,1:01:18.38,1:01:21.18,Default,,0,0,0,,إذاً الأمر غير مريح، لماذا لا تذهب إلى السرير؟
Dialogue: 0,1:01:21.38,1:01:23.62,Default,,0,0,0,,جئت لتعزيتك.
Dialogue: 0,1:01:24.75,1:01:28.02,Default,,0,0,0,,لكنني كنت أفكر بعمق.
Dialogue: 0,1:01:30.12,1:01:31.99,Default,,0,0,0,,لذا أريد أن أنام.
Dialogue: 0,1:01:32.36,1:01:34.33,Default,,0,0,0,,سوف أواسيك غداً.
Dialogue: 0,1:01:44.20,1:01:46.51,Default,,0,0,0,,أنت عزائي.
Dialogue: 0,1:02:44.10,1:02:47.10,Default,,0,0,0,,انتفاضة "سانغنام" عرّضت البلاد للخطر،
Dialogue: 0,1:02:48.13,1:02:50.50,Default,,0,0,0,,أنا بحاجة للمغادرة.
Dialogue: 0,1:02:51.91,1:02:55.81,Default,,0,0,0,,بمجرد أن أغادر، أطلب منك الانخراط في السياسة.
Dialogue: 0,1:02:55.81,1:02:56.94,Default,,0,0,0,,و
Dialogue: 0,1:03:01.01,1:03:03.35,Default,,0,0,0,,اعتني بالملكة وطفلنا.
Dialogue: 0,1:03:04.28,1:03:06.95,Default,,0,0,0,,أنا متأكد من أنك ستقوم بعمل جيد في هذا.
Dialogue: 0,1:03:07.52,1:03:10.19,Default,,0,0,0,,كنت أشعر بالارتياح بدون السياسة.
Dialogue: 0,1:03:11.76,1:03:13.46,Default,,0,0,0,,ولكن ماذا يمكنك أن تفعل؟
Dialogue: 0,1:03:14.26,1:03:16.63,Default,,0,0,0,,لا تقلق بشأن الملكة.
Dialogue: 0,1:03:16.96,1:03:19.73,Default,,0,0,0,,اهتمي بالتي ذهب زوجها
Dialogue: 0,1:03:20.00,1:03:24.44,Default,,0,0,0,,الحرب والمجازفة بحياتي هو واجبي.
Dialogue: 0,1:03:25.24,1:03:26.91,Default,,0,0,0,,نعتمد عليك
Dialogue: 0,1:03:28.14,1:03:29.78,Default,,0,0,0,,وسأذهب.
Dialogue: 0,1:03:31.04,1:03:32.71,Default,,0,0,0,,اعتني بنفسك.
Dialogue: 0,1:03:35.28,1:03:37.55,Default,,0,0,0,,لقد أشرقت الشمس بالفعل.
Dialogue: 0,1:04:05.91,1:04:06.95,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:04:09.55,1:04:11.18,Default,,0,0,0,,إذن هذا أنا.
Dialogue: 0,1:04:11.99,1:04:13.15,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:04:23.46,1:04:27.07,Default,,0,0,0,,هل صحيح أنك بنفسك ستقمع الانتفاضة؟
Dialogue: 0,1:04:27.37,1:04:28.50,Default,,0,0,0,,نعم.
Dialogue: 0,1:04:28.50,1:04:30.00,Default,,0,0,0,,ماذا يحدث؟
Dialogue: 0,1:04:30.00,1:04:32.71,Default,,0,0,0,,لقد دعمتهم، والآن هل ستقتلهم؟
Dialogue: 0,1:04:32.71,1:04:35.58,Default,,0,0,0,,عثرت كيم بيونين على رمز مخبأ في كتاب الملكة.
Dialogue: 0,1:04:37.88,1:04:41.45,Default,,0,0,0,,إذا لم أفعل هذا، سيعاني الملايين.
Dialogue: 0,1:04:41.45,1:04:42.78,Default,,0,0,0,,سأذهب معك.
Dialogue: 0,1:04:44.75,1:04:47.09,Default,,0,0,0,,يجب أن أذهب وحدي.
Dialogue: 0,1:04:47.85,1:04:49.82,Default,,0,0,0,,ألا يكفي أن أكون رهينة؟
Dialogue: 0,1:04:51.32,1:04:52.73,Default,,0,0,0,,هذا فخ.
Dialogue: 0,1:04:52.76,1:04:54.99,Default,,0,0,0,,ألا تعتقدين أن الملكة نفسها
Dialogue: 0,1:04:55.30,1:04:57.40,Default,,0,0,0,,هل أعطيت الكتاب لكيم بيونغين؟
Dialogue: 0,1:04:57.80,1:04:59.83,Default,,0,0,0,,لقد وعدت.
Dialogue: 0,1:05:00.27,1:05:03.14,Default,,0,0,0,,إذا كان هناك دليل على أنها عدو،
Dialogue: 0,1:05:03.14,1:05:04.54,Default,,0,0,0,,سوف تقطع رأسها شخصياً.
Dialogue: 0,1:05:05.00,1:05:08.34,Default,,0,0,0,,يجب قطع رأسها، وليس الأشخاص الآخرين.
Dialogue: 0,1:05:08.34,1:05:10.91,Default,,0,0,0,,الملكة بالتأكيد ليست عدوتنا.
Dialogue: 0,1:05:11.78,1:05:14.95,Default,,0,0,0,,لقد أدارت ظهرها للجميع فقط لتكون بجانبي.
Dialogue: 0,1:05:14.95,1:05:17.02,Default,,0,0,0,,إذا لم أغادر الآن،
Dialogue: 0,1:05:18.35,1:05:19.95,Default,,0,0,0,,ستموت الملكة.
Dialogue: 0,1:05:19.99,1:05:22.59,Default,,0,0,0,,اهدأ. هذا ليس الوقت المناسب للتشاجر مع بعضكم البعض.
Dialogue: 0,1:05:25.19,1:05:27.43,Default,,0,0,0,,قلت إنني بحاجة إلى المعاناة أكثر.
Dialogue: 0,1:05:29.06,1:05:30.20,الافتراضي,,0,0,0,,صحيح.
Dialogue: 0,1:05:32.83,1:05:34.70,Default,,0,0,0,,سوف أتحمل كل شيء.
Dialogue: 0,1:05:37.24,1:05:38.44,Default,,0,0,0,,حياتك
Dialogue: 0,1:05:40.51,1:05:41.71,Default,,0,0,0,,في خطر.
Dialogue: 0,1:05:44.71,1:05:46.15,Default,,0,0,0,,إذا حاولت النجاة،
Dialogue: 0,1:05:47.65,1:05:49.25,Default,,0,0,0,,كل من حولي سيموت.
Dialogue: 0,1:06:10.97,1:06:12.64,Default,,0,0,0,,أنا متأكد من أنني رأيته.
Dialogue: 0,1:06:14.61,1:06:15.78,Default,,0,0,0,,هل كان هذا حلماً؟
Dialogue: 0,1:06:21.51,1:06:24.15,Default,,0,0,0,,سيدة البلاط تشوي، هونغ يونغ.
Dialogue: 0,1:06:30.09,1:06:32.46,Default,,0,0,0,,دعونا نذهب إلى دايجوجون. لقد اشتقت للملك.
Dialogue: 0,1:06:32.56,1:06:33.93,Default,,0,0,0,,-نعم يا صاحب الجلالة.\N-نعم يا صاحب الجلالة.
Dialogue: 0,1:06:35.36,1:06:36.86,Default,,0,0,0,,جلالة الملك يغادر.
Dialogue: 0,1:06:37.83,1:06:39.53,Default,,0,0,0,,هل ستغادر؟ أين؟
Dialogue: 0,1:06:49.38,1:06:50.84,Default,,0,0,0,,دعونا نغادر.
Dialogue: 0,1:07:14.33,1:07:15.74,Default,,0,0,0,,انتظر!
Dialogue: 0,1:07:25.58,1:07:28.88,Default,,0,0,0,,توقف! انتظر!
Dialogue: 0,1:07:35.82,1:07:36.96,Default,,0,0,0,,لماذا؟
Dialogue: 0,1:07:39.59,1:07:40.59,Default,,0,0,0,,لماذا؟
Dialogue: 0,1:07:47.37,1:07:48.64,Default,,0,0,0,,هل هذا هو الطريق الصحيح؟
Dialogue: 0,1:07:49.74,1:07:52.21,Default,,0,0,0,,لا أعتقد أن هذا الطريق مخصص للناس.
Dialogue: 0,1:07:52.51,1:07:54.44,Default,,0,0,0,,هذا هو أقصر طريق.
Dialogue: 0,1:08:20.10,1:08:21.27,Default,,0,0,0,,توقف.
Dialogue: 0,1:08:27.67,1:08:28.84,Default,,0,0,0,,لقد تأخرت.
Dialogue: 0,1:08:30.21,1:08:34.11,Default,,0,0,0,,إذا كنت ستفعل ذلك على أية حال، فلا تتردد.
Dialogue: 0,1:08:34.45,1:08:38.18,Default,,0,0,0,,هل ستنزل عن الحصان بنفسك أم ستساعد؟
Dialogue: 0,1:08:50.10,1:08:52.07,Default,,0,0,0,,ليس هناك مكان للتراجع.
Dialogue: 0,1:08:53.97,1:08:56.00,Default,,0,0,0,,علينا أن نحاول.
Dialogue: 0,1:08:56.00,1:08:57.40,Default,,0,0,0,,لا تقلق.
Dialogue: 0,1:09:00.24,1:09:02.14,Default,,0,0,0,,أستطيع التعامل مع الأمر وحدي.
Dialogue: 0,1:09:05.24,1:09:07.48,Default,,0,0,0,,كل شيء سيكون على ما يرام إذا تخلصت منك.
Dialogue: 0,1:09:57.16,1:09:58.33,Default,,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:09:58.33,1:09:59.60,Default,,0,0,0,,
Dialogue: 0,1:09:59.60,1:10:00.77,Default,,0,0,0,,
Dialogue: 0,1:10:21.35,1:10:23.89,Default,,0,0,0,,{\i1}هذا الطفل يأكل كثيراً.{\i}
Dialogue: 0,1:10:23.89,1:10:25.49,Default,,0,0,0,,{\i1}قل: "أبي، عد قريبًا."{\i}
Dialogue: 0,1:10:25.49,1:10:26.79,Default,,0,0,0,,{\i1}أعتقد أنه ركل.{\i}
Dialogue: 0,1:10:27.33,1:10:29.86,Default,,0,0,0,,{\i1}جلالة الملك...{\i}
Dialogue: 0,1:10:29.86,1:10:31.93,Default,,0,0,0,,{\i1}الآن سيتغير مالك هذا المكان.{\i}
Dialogue: 0,1:10:31.93,1:10:34.13,Default,,0,0,0,,{\i1}ما المغزى من ذلك،{\i}
Dialogue: 0,1:10:34.80,1:10:36.07,Default,,0,0,0,,{\i1}إذا لم تكن هناك؟{\i}
Dialogue: 0,1:10:36.07,1:10:37.34,Default,,0,0,0,,{\i1}قلت أنك بريء.{\i}
Dialogue: 0,1:10:37.34,1:10:38.97,Default,,0,0,0,,{\i1}الوقوف إلى جانب الضعفاء جريمة أيضًا.{\i}
Dialogue: 0,1:10:38.97,1:10:41.24,Default,,0,0,0,,{\i1}بنين. إلى أي مدى ستذهب؟ {\i}
Dialogue: 0,1:10:41.24,1:10:44.48,Default,,0,0,0,,{\i1}أهم شيء هو أن تولد بصحة جيدة.{\i}
Dialogue: 0,1:10:44.48,1:10:46.41,Default,,0,0,0,,{\i1}سأقتل الملكة،{\i}
Dialogue: 0,1:10:46.41,1:10:49.48,Default,,0,0,0,,{\i1}من تعاون معك لقتل الملك.{\i}
Dialogue: 0,0:16:11.74,0:16:13.74,Default,,0,0,0,,


