Dialogue: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Zinger, Pineapple, Boss, Biryulka
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:04.02,pangalan,,0,0,0,,{\pos(112,666)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:03.88,0:01:06.42,Default,,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.42,0:01:08.99,Default,,0,0,0,,at ang mga kaganapang ipinakita ay fiction.
Dialogue: 0,0:01:09.16,0:01:10.99,Default,,0,0,0,,5 episode
Dialogue: 0,0:01:10.99,0:01:13.73,Default,,0,0,0,,Bawat tao ay may kanya-kanyang kahinaan.
Dialogue: 0,0:01:18.80,0:01:21.74,Default,,0,0,0,,Kahit si Superman kapag nakikipagkita sa kryptonite
Dialogue: 0,0:01:21.74,0:01:25.91,Default,,0,0,0,, nagiging sira-sira lang na nagsusuot ng salawal sa ibabaw ng kanyang pantalon.
Dialogue: 0,0:01:29.41,0:01:31.38,Default,,0,0,0,,Kung napakahina ni Superman,
Dialogue: 0,0:01:31.71,0:01:34.25,Default,,0,0,0,,isipin kung ano ang nangyayari sa mga ordinaryong tao.
Dialogue: 0,0:01:46.09,0:01:48.13,Default,,0,0,0,,Ibubunyag ko ang katotohanan!
Dialogue: 0,0:01:48.70,0:01:52.03,Default,,0,0,0,,Tatanggapin ko ang iyong kalooban, Kamahalan!
Dialogue: 0,0:01:52.23,0:01:54.90,Default,,0,0,0,,Hindi siya ang kailangang patayin!
Dialogue: 0,0:01:59.21,0:02:00.64,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:02:02.91,0:02:04.34,Default,,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,0:02:07.82,0:02:10.15,Default,,0,0,0,,Labag ka ba sa kalooban ng hari?
Dialogue: 0,0:02:20.79,0:02:25.10,Default,,0,0,0,,Para sa isang ordinaryong tao, ang mundong ito ay minahan ng mga kahinaan.
Dialogue: 0,0:02:25.10,0:02:27.53,Default,,0,0,0,,Nagiging kahinaan tayo ng isa't isa
Dialogue: 0,0:02:27.53,0:02:29.94,Default,,0,0,0,,at kinakaladkad namin ang lahat sa underworld.
Dialogue: 0,0:02:31.41,0:02:35.18,Default,,0,0,0,,Kahit ako, ang perpektong Jang Bong Hwan, ay may kahinaan.
Dialogue: 0,0:02:35.68,0:02:37.38,Default,,0,0,0,,At ito ay walang iba kundi...
Dialogue: 0,0:02:40.18,0:02:44.12,Default,,0,0,0,,Hindi makatiis kapag ang ibang lalaki ay mukhang mas cool kaysa sa akin.
Dialogue: 0,0:02:45.92,0:02:47.72,Default,,0,0,0,,Saktan ang reyna...
Dialogue: 0,0:02:47.72,0:02:49.16,Default,,0,0,0,,Stop!
Dialogue: 0,0:02:49.86,0:02:52.46,Default,,0,0,0,,Lalo na sa presensya ng gusto ko.
Dialogue: 0,0:02:52.46,0:02:56.00,Default,,0,0,0,,Ako dapat ang pinaka cool sa paningin niya.
Dialogue: 0,0:02:57.40,0:03:00.37,Default,,0,0,0,,Masasabi mong ito ang Achilles takong ng
Dialogue: 0,0:03:00.37,0:03:02.54,Default,,0,0,0,,sino ang perpekto.
Dialogue: 0,0:03:18.22,0:03:20.19,Default,,0,0,0,,Payagan mo ako, bilang biktima ng insidenteng ito,
Dialogue: 0,0:03:20.19,0:03:22.56,Default,,0,0,0,,nagbigay liwanag sa mga kaganapan.
Dialogue: 0,0:03:24.99,0:03:26.43,Default,,0,0,0,,I
Dialogue: 0,0:03:28.53,0:03:30.46,Default,,0,0,0,, sinubukang magpakamatay.
Dialogue: 0,0:03:34.10,0:03:36.60,Default,,0,0,0,,Sa tingin mo isa lang ang cool na lalaki dito?
Dialogue: 0,0:03:36.60,0:03:38.81,Default,,0,0,0,,Huwag kikibot, Cheoljong.
Dialogue: 0,0:03:38.81,0:03:40.91,Default,,0,0,0,,Ako ang bida dito.
Dialogue: 0,0:03:42.04,0:03:47.68,Default,,0,0,0,,Pakiusap, huwag hawakan ang mga walang kasalanan sa anumang bagay.
Dialogue: 0,0:03:49.62,0:03:51.12,Default,,0,0,0,,Mahusay.
Dialogue: 0,0:03:51.25,0:03:54.72,Default,,0,0,0,,Nakakatawang pahayag?
Dialogue: 0,0:03:54.72,0:03:56.12,Default,,0,0,0,,Ang Dowager Queen.
Dialogue: 0,0:03:56.12,0:04:00.23,Default,,0,0,0,,Paumanhin, ngunit sinubukan kong pumatay.
Dialogue: 0,0:04:01.23,0:04:02.23,Default,,0,0,0,,Iwanan ang iyong huwad na sarili
Dialogue: 0,0:04:02.23,0:04:05.77,Default,,0,0,0,,Dala ko itong suicide note.
Dialogue: 0,0:04:11.21,0:04:13.57,Default,,0,0,0,,Babalik pa rin ako ngayon.
Dialogue: 0,0:04:13.97,0:04:15.98,Default,,0,0,0,,Wala akong pakialam kung maghari ang kaguluhan dito.
Dialogue: 0,0:04:16.68,0:04:18.95,Default,,0,0,0,,Bakit mo ginagawa ito?
Dialogue: 0,0:04:18.95,0:04:21.65,Default,,0,0,0,,At bakit mo papatayin ang iyong sarili
Dialogue: 0,0:04:21.65,0:04:24.05,Default,,0,0,0,,nung gabi bago ka naging reyna?
Dialogue: 0,0:04:26.09,0:04:27.79,Default,,0,0,0,,Ang bagay ay...
Dialogue: 0,0:04:27.79,0:04:30.89,Default,,0,0,0,,Ano ang iyong dahilan?
Dialogue: 0,0:04:31.43,0:04:34.83,Default,,0,0,0,,Na-depress ako at gusto kong mamatay dahil...
Dialogue: 0,0:04:35.36,0:04:37.80,Default,,0,0,0,,Sigurado akong may dahilan.
Dialogue: 0,0:04:40.63,0:04:42.10,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:04:44.94,0:04:46.41,Default,,0,0,0,,Damn!
Dialogue: 0,0:04:48.61,0:04:49.71,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:04:49.71,0:04:51.14,Default,,0,0,0,,Soyeon.
Dialogue: 0,0:05:03.59,0:05:05.39,Default,,0,0,0,,Aalisin na ba niya ako ngayon?
Dialogue: 0,0:05:05.39,0:05:06.43,Default,,0,0,0,,Don't you dare.
Dialogue: 0,0:05:06.43,0:05:08.73,Default,,0,0,0,,Huwag kang lalapit. Malayo!
Dialogue: 0,0:05:31.35,0:05:33.05,Default,,0,0,0,,Ang Dowager Queen.
Dialogue: 0,0:05:33.05,0:05:36.56,Default,,0,0,0,,Nagsisinungaling ang Reyna,
Dialogue: 0,0:05:36.56,0:05:39.49,Default,,0,0,0,,upang iligtas ang buhay\N ng isang hindi gaanong mahalagang tao kaysa sa kanya.
Dialogue: 0,0:05:39.49,0:05:41.63,Default,,0,0,0,,Magtiwala sa isang banal na puso,
Dialogue: 0,0:05:41.63,0:05:43.90,Default,,0,0,0,,pagpapatawad sa isang\N na nakagawa ng kasalanan sa kanya,
Dialogue: 0,0:05:43.90,0:05:45.53,Default,,0,0,0,,at magpakita ng awa.
Dialogue: 0,0:05:45.53,0:05:48.67,Default,,0,0,0,,So ganun niya kinuha lahat?
Dialogue: 0,0:06:10.39,0:06:15.03,Default,,0,0,0,,Ano ang kawili-wili dito?\N Napakaraming tao ang nagtipon.
Dialogue: 0,0:06:18.33,0:06:19.80,Default,,0,0,0,,Ang iyong...
Dialogue: 0,0:06:20.10,0:06:23.30,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:06:23.64,0:06:28.88,Default,,0,0,0,,Ano ang nangyari dito?
Dialogue: 0,0:06:30.34,0:06:31.78,Default,,0,0,0,,Okay.
Dialogue: 0,0:06:32.28,0:06:34.08,Default,,0,0,0,,Ang Reyna ay nagsikap,
Dialogue: 0,0:06:34.08,0:06:37.05,Default,,0,0,0,,kaya nga, magpapakita ako ng awa.
Dialogue: 0,0:07:09.85,0:07:13.15,Default,,0,0,0,,5 episode: takong ni Achilles
Dialogue: 0,0:07:13.25,0:07:16.96,Default,,0,0,0,,Matagal na akong hindi nakakita ng ganoong tanawin.
Dialogue: 0,0:07:16.96,0:07:20.59,Default,,0,0,0,,I wonder kung ano ang iniisip ng reyna noong ginawa niya iyon.
Dialogue: 0,0:07:20.79,0:07:22.83,Default,,0,0,0,,Ganyan ang puso ng isang babae.
Dialogue: 0,0:07:23.13,0:07:26.90,Default,,0,0,0,,Pero sigurado akong walang kinalaman ang mga Kim dito.
Dialogue: 0,0:07:26.90,0:07:28.33,Default,,0,0,0,,Oo.
Dialogue: 0,0:07:28.74,0:07:31.10,Default,,0,0,0,,Pupunta sa Seonjong Hall?
Dialogue: 0,0:07:31.20,0:07:35.28,Default,,0,0,0,,Ngayon kailangan ko ng iba bukod sa panalangin.
Dialogue: 0,0:07:36.04,0:07:38.68,Default,,0,0,0,,Isa lang siyang mahinang royal consort,
Dialogue: 0,0:07:38.68,0:07:41.05,Default,,0,0,0,,pero siya lang ang arrow natin.
Dialogue: 0,0:07:41.31,0:07:44.42,Default,,0,0,0,,Kailangan mong lagyan ng lason ang dulo nito.
Dialogue: 0,0:08:05.37,0:08:06.77,Default,,0,0,0,,Mga Diyos.
Dialogue: 0,0:08:11.51,0:08:13.18,Default,,0,0,0,,Sinubukan ba niyang magpakamatay?
Dialogue: 0,0:08:14.08,0:08:15.55,Default,,0,0,0,,Ano ang ibig sabihin nito?
Dialogue: 0,0:08:15.55,0:08:17.62,Default,,0,0,0,,I will bide my time at gigising sa tamang sandali.
Dialogue: 0,0:08:17.62,0:08:20.15,Default,,0,0,0,,Anong klase akong ama na hindi ko nahulaan?
Dialogue: 0,0:08:20.65,0:08:22.36,Default,,0,0,0,,Nakagawa ako ng malaking kasalanan.
Dialogue: 0,0:08:22.59,0:08:26.16,Default,,0,0,0,,Nagkasala ako.
Dialogue: 0,0:08:26.56,0:08:28.46,Default,,0,0,0,,Kasalanan ko ang lahat.
Dialogue: 0,0:08:28.60,0:08:31.10,Default,,0,0,0,,Dapat ay mas inalagaan niya siya.
Dialogue: 0,0:08:31.10,0:08:33.20,Default,,0,0,0,,Na-miss ko ito.
Dialogue: 0,0:08:33.93,0:08:35.94,Default,,0,0,0,,Bakit niya ginawa ito?
Dialogue: 0,0:08:36.27,0:08:39.14,Default,,0,0,0,,Dapat mong malaman, kasama mo siya sa lahat ng oras.
Dialogue: 0,0:08:39.54,0:08:42.94,Default,,0,0,0,,Sinubukan niyang tumalon sa tubig ng ilang beses,
Dialogue: 0,0:08:42.98,0:08:46.55,Default,,0,0,0,,Akala ko ito ay dahil sa pagkabigla noong taglagas.
Dialogue: 0,0:08:46.55,0:08:48.15,Default,,0,0,0,,Ilang beses?
Dialogue: 0,0:08:51.28,0:08:56.12,Default,,0,0,0,,Paano siya nagdusa?
Dialogue: 0,0:08:56.76,0:08:58.32,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:08:58.39,0:09:01.69,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:09:03.36,0:09:06.30,Default,,0,0,0,,Well damn, tama na.
Dialogue: 0,0:09:06.30,0:09:08.70,Default,,0,0,0,,Iiyak ka, hindi na ako magigising.
Dialogue: 0,0:09:12.01,0:09:15.58,Default,,0,0,0,,Hindi ngayon ang oras para umiyak.
Dialogue: 0,0:09:16.14,0:09:18.31,Default,,0,0,0,,Makikita tayong lumuluha,
Dialogue: 0,0:09:18.98,0:09:22.15,Default,,0,0,0,,ay magiging lubhang masama.
Dialogue: 0,0:09:22.15,0:09:23.65,Default,,0,0,0,,Siyempre.
Dialogue: 0,0:09:23.92,0:09:25.22,Default,,0,0,0,,Tama ka.
Dialogue: 0,0:09:25.22,0:09:28.49,Default,,0,0,0,,Sa mga ganitong pagkakataon kailangan mong maging matapang at maging malapit sa kanya.
Dialogue: 0,0:09:28.79,0:09:31.29,Default,,0,0,0,,Gising na?
Dialogue: 0,0:09:31.29,0:09:34.06,Default,,0,0,0,,-Soyeon.\N-Holy shit.
Dialogue: 0,0:09:35.13,0:09:37.66,Default,,0,0,0,,Nang bigyan ka ng buhay ng iyong ina,
Dialogue: 0,0:09:38.53,0:09:42.34,Default,,0,0,0,,nawala ang kanya.
Dialogue: 0,0:09:42.84,0:09:44.47,Default,,0,0,0,,Nagsimula na naman siya?
Dialogue: 0,0:09:48.71,0:09:50.21,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:09:51.44,0:09:53.28,Default,,0,0,0,,Lumaki na ang kanyang Kamahalan,
Dialogue: 0,0:09:53.31,0:09:56.35,Default,,0,0,0,,walang pagkakataon na makita ang mukha ng aking ina.
Dialogue: 0,0:09:56.35,0:09:58.82,Default,,0,0,0,,Naaawa ako sa kanya.
Dialogue: 0,0:09:59.79,0:10:02.62,Default,,0,0,0,,Hindi ko alam kung bakit siya nagdusa ng husto,
Dialogue: 0,0:10:02.62,0:10:05.29,Default,,0,0,0,,at pinagbawalan ko lang siya mula dito at doon.
Dialogue: 0,0:10:05.29,0:10:08.83,Default,,0,0,0,,Hinahabol ko siya
Dialogue: 0,0:10:09.43,0:10:12.43,Default,,0,0,0,,at nagmumukmok sa lahat ng oras.
Dialogue: 0,0:10:12.87,0:10:15.77,Default,,0,0,0,,Dahil sa akin kaya niya
Dialogue: 0,0:10:16.30,0:10:20.44,Default,,0,0,0,,tumalon sa lawa.
Dialogue: 0,0:10:20.67,0:10:24.28,Default,,0,0,0,,Paano, Kamahalan.
Dialogue: 0,0:10:25.11,0:10:27.75,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:10:29.25,0:10:30.28,Default,,0,0,0,,Sumuko na ako.
Dialogue: 0,0:10:30.28,0:10:33.02,Default,,0,0,0,,Hindi ko makayanan ang sitwasyong ito.
Dialogue: 0,0:10:33.39,0:10:37.22,Default,,0,0,0,,Gwanghwamun
Dialogue: 0,0:10:56.34,0:10:57.94,Default,,0,0,0,,My queen.
Dialogue: 0,0:10:59.51,0:11:00.85,Default,,0,0,0,,Pakiusap,
Dialogue: 0,0:11:00.85,0:11:03.55,Default,,0,0,0,,ingatan mo ang iyong sarili.
Dialogue: 0,0:11:04.65,0:11:06.72,Default,,0,0,0,,Ang iyong kaawa-awang ama
Dialogue: 0,0:11:08.36,0:11:10.49,Default,,0,0,0,,humihingi ng tawad.
Dialogue: 0,0:11:24.77,0:11:26.34,Default,,0,0,0,,Benin.
Dialogue: 0,0:11:29.44,0:11:31.31,Default,,0,0,0,,Ngayon papasok ako sa palasyo.
Dialogue: 0,0:11:31.31,0:11:34.21,Default,,0,0,0,,Makikilala ko ang hari sa unang pagkakataon.
Dialogue: 0,0:11:35.75,0:11:37.28,Default,,0,0,0,,Masaya ba?
Dialogue: 0,0:11:38.22,0:11:40.09,Default,,0,0,0,,Curious lang ako.
Dialogue: 0,0:11:40.22,0:11:42.62,Default,,0,0,0,,Minsan mukha siyang tanga,
Dialogue: 0,0:11:42.62,0:11:45.39,Default,,0,0,0,,at minsan parang gawa sa jade.
Dialogue: 0,0:11:48.09,0:11:49.56,Default,,0,0,0,,Sa aking panaginip.
Dialogue: 0,0:11:50.23,0:11:53.63,Default,,0,0,0,,Kagabi kamukha mo talaga siya.
Dialogue: 0,0:11:57.80,0:12:02.41,Default,,0,0,0,,Naniwala ako na kailangan kong isuko ka para mapasaya ka.
Dialogue: 0,0:12:03.54,0:12:07.15,Default,,0,0,0,,Bago ka bumisita sa palasyo, napakasaya mo.
Dialogue: 0,0:12:07.45,0:12:10.72,Default,,0,0,0,,Gayunpaman, matapos bumisita sa palasyo, sinubukan niyang magpakamatay.
Dialogue: 0,0:12:18.59,0:12:20.66,Default,,0,0,0,,Dahil ba talaga dito?
Dialogue: 0,0:12:38.38,0:12:41.98,Default,,0,0,0,,Nabaliw na siya! Nawala na sa isip ko!
Dialogue: 0,0:12:41.98,0:12:43.85,Default,,0,0,0,,Iwanan ang iyong huwad na sarili
Dialogue: 0,0:12:43.85,0:12:46.72,Default,,0,0,0,,Siya ay gumugol ng ilang gabi kasama ang hari. \NASigurado ka
Dialogue: 0,0:12:46.72,0:12:49.46,Default,,0,0,0,,na hindi niya pinalabo ang utak niya?
Dialogue: 0,0:12:49.46,0:12:51.49,Default,,0,0,0,,Tumahimik ka, Kamahalan.
Dialogue: 0,0:12:51.49,0:12:53.66,Default,,0,0,0,,Walang silbi ang iyong galit.
Dialogue: 0,0:12:53.66,0:12:55.76,Default,,0,0,0,,Paano ako hindi magagalit?
Dialogue: 0,0:12:55.76,0:12:58.60,Default,,0,0,0,,Nalampasan namin ang isang magandang pagkakataon.
Dialogue: 0,0:12:58.60,0:13:01.07,Default,,0,0,0,,Nabaril nila ang kanilang mga sarili sa paa!
Dialogue: 0,0:13:02.14,0:13:04.77,Default,,0,0,0,,Nakita mo ba kung paano kumilos ang hari?
Dialogue: 0,0:13:05.11,0:13:07.04,Default,,0,0,0,,Yung mayabang na tingin.
Dialogue: 0,0:13:07.04,0:13:10.54,Default,,0,0,0,,Iniligtas ko siya mula sa buhay ng isang simpleng magsasaka at ginawa siyang hari,
Dialogue: 0,0:13:10.54,0:13:12.85,Default,,0,0,0,,naglalakas loob ba siyang magmukhang ganyan?
Dialogue: 0,0:13:12.85,0:13:14.98,Default,,0,0,0,,Kailangan natin siyang patahimikin, dahil nagrerebelde siya.
Dialogue: 0,0:13:14.98,0:13:18.15,Default,,0,0,0,,Hihigpitan ko ang rules para malaman mo ang lugar mo.
Dialogue: 0,0:13:23.22,0:13:25.93,Default,,0,0,0,,Bakit mag-aaksaya ng oras sa pag-aalaga sa iyong sarili?
Dialogue: 0,0:13:26.16,0:13:29.73,Default,,0,0,0,,Walang bakas ng pagsisikap, nararapat na mag-alala.
Dialogue: 0,0:13:31.87,0:13:33.90,Default,,0,0,0,,Imbitahan ang manggagamot na si Pak.
Dialogue: 0,0:13:33.97,0:13:35.40,Default,,0,0,0,,Oo.
Dialogue: 0,0:13:41.07,0:13:45.34,Default,,0,0,0,,To be honest, lumapit sa akin ang reyna.
Dialogue: 0,0:13:46.78,0:13:49.62,Default,,0,0,0,,Noong gabing itinapon ko ang sarili ko sa lawa.
Dialogue: 0,0:13:54.69,0:13:57.92,Default,,0,0,0,,Dowager Queen, I
Dialogue: 0,0:14:01.16,0:14:02.96,Default,,0,0,0,,Aalis ako ng palasyo.
Dialogue: 0,0:14:04.16,0:14:05.97,Default,,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:14:05.97,0:14:08.67,Default,,0,0,0,,Hindi ako pwedeng maging reyna.
Dialogue: 0,0:14:08.67,0:14:11.10,Default,,0,0,0,,Ayoko ng ganitong mapait na kapalaran para sa sarili ko.
Dialogue: 0,0:14:12.81,0:14:16.54,Default,,0,0,0,,Nakarinig ako ng tsismis na masama ang ugali mo,
Dialogue: 0,0:14:16.54,0:14:18.61,Default,,0,0,0,,ngunit lahat ng ito ay sinadya,
Dialogue: 0,0:14:18.71,0:14:21.45,Default,,0,0,0,,para hindi maging reyna.
Dialogue: 0,0:14:23.32,0:14:24.75,Default,,0,0,0,,Ang cute.
Dialogue: 0,0:14:24.75,0:14:27.55,Default,,0,0,0,,Akala mo makakamit mo ang isang bagay gamit ito.
Dialogue: 0,0:14:27.95,0:14:29.82,Default,,0,0,0,,Nag-klase ka para maging reyna.
Dialogue: 0,0:14:29.82,0:14:31.69,Default,,0,0,0,,Hindi ko alam kung bakit biglang nagbago ang isip ko
Dialogue: 0,0:14:31.69,0:14:33.76,Default,,0,0,0,,at ayaw kong malaman.
Dialogue: 0,0:14:34.56,0:14:37.56,Default,,0,0,0,,Ang iyong kapalaran ay paunang natukoy mula sa kapanganakan.
Dialogue: 0,0:14:37.56,0:14:40.43,Default,,0,0,0,,Dapat kang maging reyna at pagsilbihan ang iyong pamilya.
Dialogue: 0,0:14:40.53,0:14:43.84,Default,,0,0,0,,Ito ang iyong kapalaran, ito ang iyong pinanganak.
Dialogue: 0,0:14:45.10,0:14:47.94,Default,,0,0,0,,Nakuha mo na ba ang posisyong ito?
Dialogue: 0,0:14:47.94,0:14:49.41,Default,,0,0,0,,Hindi, hindi ang sarili niya.
Dialogue: 0,0:14:49.64,0:14:52.65,Default,,0,0,0,,Kaya hindi ka pwedeng umatras,\N kahit gusto mo.
Dialogue: 0,0:14:53.11,0:14:55.68,Default,,0,0,0,,Kung gusto mong mamatay, mamatay ka sa palasyo.
Dialogue: 0,0:14:56.78,0:14:58.65,Default,,0,0,0,,Akala ko sinabi niya yun kasi
Dialogue: 0,0:14:58.65,0:15:01.96,Default,,0,0,0,,na ang mga kabataan ngayon ay hilig gumawa ng mga bundok mula sa molehills.
Dialogue: 0,0:15:01.96,0:15:04.39,Default,,0,0,0,,Kaya hindi ko ito binigyan ng importansya.
Dialogue: 0,0:15:04.99,0:15:08.83,Default,,0,0,0,,Hindi ko akalain na tumalon siya sa lawa para magpakamatay.
Dialogue: 0,0:15:10.23,0:15:13.77,Default,,0,0,0,,Kung handa na siyang mamatay,\N huwag lang maging reyna,
Dialogue: 0,0:15:15.67,0:15:17.80,Default,,0,0,0,,kaya ang baliw din niyang ugali ngayon...
Dialogue: 0,0:15:18.64,0:15:22.14,Default,,0,0,0,,Isang paraan para umalis sa post ng reyna.
Dialogue: 0,0:15:22.38,0:15:24.44,Default,,0,0,0,,Kung ganito ang sitwasyon,
Dialogue: 0,0:15:24.54,0:15:28.15,Default,,0,0,0,,hindi makakatakas ang reyna nang hindi napaparusahan.
Dialogue: 0,0:15:28.38,0:15:31.78,Default,,0,0,0,,Hintayin mo ako! Paano kung mahulog ka?
Dialogue: 0,0:15:31.78,0:15:34.92,Default,,0,0,0,,Sabi sa iyo, maghintay ka.
Dialogue: 0,0:15:35.86,0:15:39.33,Default,,0,0,0,,Sino ang nangahas na humarang sa aking landas?
Dialogue: 0,0:15:44.76,0:15:46.67,Default,,0,0,0,,Ang Dowager Queen.
Dialogue: 0,0:15:46.67,0:15:49.70,Default,,0,0,0,,Hindi ka na makakauwi.
Dialogue: 0,0:15:50.10,0:15:52.41,Default,,0,0,0,,-Ano?\N-Sa Reyna, Jang Bong-hwan,
Dialogue: 0,0:15:52.41,0:15:57.01,Default,,0,0,0,,inutusang manatili dito magpakailanman hanggang sa katapusan ng aking mga araw
Dialogue: 0,0:15:57.01,0:16:00.95, Default,,0,0,0,,at nabubuhay sa paghihirap, nananatiling walang lakas.
Dialogue: 0,0:16:09.42,0:16:10.82,Default,,0,0,0,,Hindi.
Dialogue: 0,0:16:12.29,0:16:13.69,Default,,0,0,0,,Ayoko.
Dialogue: 0,0:16:13.73,0:16:19.10,Default,,0,0,0,,Ayokong maging impotent!
Dialogue: 0,0:16:21.10,0:16:22.50,Default,Spillik,0,0,0,,Kamahalan!
Dialogue: 0,0:16:25.00,0:16:26.87,Default,Spillik,0,0,0,,Nakakatakot na bangungot.
Dialogue: 0,0:16:27.81,0:16:30.24,Default,Spillik,0,0,0,,Sinubukan mong lunurin ang iyong sarili sa lawa,
Dialogue: 0,0:16:30.24,0:16:32.91,Default,Spillik,0,0,0,,at ngayon ay nahimatay sila, natakot ako...
Dialogue: 0,0:16:32.91,0:16:35.58,Default,Spillit,0,0,0,,Kalmado. Naiintindihan ko ang nararamdaman mo.
Dialogue: 0,0:16:35.58,0:16:38.22,Default,Spillik,0,0,0,,Mamamatay ako kasama mo!
Dialogue: 0,0:16:45.93,0:16:47.53,Default,Spillik,0,0,0,,Sapat na.
Dialogue: 0,0:16:47.53,0:16:50.43,Default,Spillik,0,0,0,,I've had enough tears for today, I can't stand it anymore.
Dialogue: 0,0:16:50.43,0:16:53.83,Default,Spillit,0,0,0,,Hindi ito nakakahawa, kaya bakit ka umiyak ng tatlong beses?
Dialogue: 0,0:16:54.00,0:16:56.40,Default,Spillik,0,0,0,,Nakatulog ako habang hinihintay kong tumigil ka.
Dialogue: 0,0:16:56.40,0:17:00.07,Default,Spillik,0,0,0,,Siyempre ayaw mong makita ang luha ko.
Dialogue: 0,0:17:02.38,0:17:04.04,Default,Spillik,0,0,0,,Ang cute mo kapag nakangiti.
Dialogue: 0,0:17:09.05,0:17:10.52,Default,Spillik,0,0,0,,Nasaan ang court lady na si Choi?
Dialogue: 0,0:17:11.48,0:17:14.59,Default,Spillik,0,0,0,,Ipinilit niya na siya mismo ang magdadala sa iyo ng gamot.
Dialogue: 0,0:17:14.92,0:17:18.93,Default,Spillik,0,0,0,,Naiwan sa iyo ang iyong ama
Dialogue: 0,0:17:18.93,0:17:21.46,Default,Spikyulka,0,0,0,,at umuwi lang pagkatapos ng paglubog ng araw.
Dialogue: 0,0:17:21.86,0:17:24.83,Default,Spillik,0,0,0,,Kung nagising lang tayo ng kaunti, nakita na natin ito.
Dialogue: 0,0:17:25.06,0:17:27.43,Default,Spillik,0,0,0,,Thank heavens na hindi ko siya nakita.
Dialogue: 0,0:17:27.70,0:17:28.87,Default,Spillik,0,0,0,,Ano?
Dialogue: 0,0:17:28.87,0:17:30.74,Default,Spillik,0,0,0,,Kung malalaman niya kung gaano kagandang katawan
Dialogue: 0,0:17:30.74,0:17:32.87,Default,Spillie,0,0,0,,ang kanyang hindi mabibiling anak na babae ay binihag ng kaluluwa ng isang lalaki,
Dialogue: 0,0:17:32.87,0:17:34.87,Default,Spillik,0,0,0,,Dapat magalit ako.
Dialogue: 0,0:17:36.14,0:17:37.74,Default,Spillit,0,0,0,,Dapat tayong magmadali bago bumalik si Lady Choi.
Dialogue: 0,0:17:37.74,0:17:40.15,Default,Spillik,0,0,0,,Napuno na ang lawa?
Dialogue: 0,0:17:40.48,0:17:42.78,Default,Biryulka,0,0,0,,Gusto mo bang pumunta sa lawa sa oras na ito?
Dialogue: 0,0:17:43.45,0:17:46.19,Default,Spillik,0,0,0,,Ngayon ang huling araw.
Dialogue: 0,0:17:49.86,0:17:53.03,Default,Spillik,0,0,0,,-Nasa magandang mood ka ba? \N-Oo naman.
Dialogue: 0,0:17:53.03,0:17:54.93,Default,Spillik,0,0,0,,Ang natitira na lang ay bumalik sa bahay,
Dialogue: 0,0:17:54.93,0:17:57.23,Default,Spillik,0,0,0,,nananatiling pinaka-cool na tao dito.
Dialogue: 0,0:17:57.63,0:17:59.06,Default,Spillik,0,0,0,,Oh, eksakto.
Dialogue: 0,0:17:59.57,0:18:02.17,Default,Spilyk,0,0,0,,-Honyeon. \N-Oo, reyna.
Dialogue: 0,0:18:03.37,0:18:05.20,Default,Spillik,0,0,0,,Nakaya kong tiisin ang lahat ng ito salamat sa iyo.
Dialogue: 0,0:18:05.27,0:18:08.71,Default,Spikyulka,0,0,0,,Ewan ko sa iba, pero mami-miss kita.
Dialogue: 0,0:18:09.38,0:18:12.01,Default,Spillik,0,0,0,,Oo, at mami-miss ko rin ang court lady na si Choi.
Dialogue: 0,0:18:13.11,0:18:17.18,Default,Spillik,0,0,0,,Honyeon, iwanan mo ang ganoong testamento sa iyong mga inapo.
Dialogue: 0,0:18:17.18,0:18:18.58,Default,Spillie,0,0,0,,Will?
Dialogue: 0,0:18:19.19,0:18:21.85,Default,Spillik,0,0,0,,Bumili ng lupa sa Gangnam.
Dialogue: 0,0:18:21.85,0:18:23.39,Default,Spillik,0,0,0,,Kailangan mong sabihin ito sa kanila.
Dialogue: 0,0:18:23.39,0:18:25.22,Default,Spilyk,0,0,0,,Pagkatapos sa 200 taon
Dialogue: 0,0:18:25.22,0:18:27.39,Default,Spillik,0,0,0,,mamumuhay ang mga tagapagmana mo tulad ng mayayamang tao.
Dialogue: 0,0:18:28.26,0:18:30.80,Default,Spillik,0,0,0,,Iyon lang ang maibibigay ko sa iyo.
Dialogue: 0,0:18:34.93,0:18:37.47,Default,Spillik,0,0,0,,Okay, sige.
Dialogue: 0,0:18:38.20,0:18:40.61,Default,Spillik,0,0,0,,Kamahalan, mag-ingat ka.
Dialogue: 0,0:18:40.84,0:18:42.68,Default,Spillik,0,0,0,,Mas masigla.
Dialogue: 0,0:18:46.05,0:18:48.75,Default,Spillik,0,0,0,,Magmadali, kailangan magmadali.
Dialogue: 0,0:18:53.95,0:18:55.25,Default,Spillik,0,0,0,,Ano ito?
Dialogue: 0,0:18:55.25,0:18:57.76,Default,Spillik,0,0,0,,Bakit tayo bumalik sa dating daan,
Dialogue: 0,0:18:57.76,0:18:59.23,Default,Spilyk,0,0,0,,kailan ako nakabuo ng bagong system?
Dialogue: 0,0:18:59.23,0:19:00.73,Default,Spillik,0,0,0,,Ang bagay ay...
Dialogue: 0,0:19:01.09,0:19:04.16,Default,Spillit,0,0,0,,Walang laman ang balon.
Dialogue: 0,0:19:05.70,0:19:08.87,Default,Spillit,0,0,0,,Kaya kami kumukuha ng tubig sa iba
Dialogue: 0,0:19:08.87,0:19:11.80,Default,Spillik,0,0,0,,at dinadala namin ito dito, ngunit...
Dialogue: 0,0:19:12.37,0:19:15.67,Default,Spillik,0,0,0,,Uulitin mo pa ba? May mali akong narinig.
Dialogue: 0,0:19:16.01,0:19:20.25,Default,Spillik,0,0,0,,Mukhang hindi ka matatapos ngayon.
Dialogue: 0,0:19:20.28,0:19:22.48,Default,Spillik,0,0,0,,Patawarin mo kami, reyna.
Dialogue: 0,0:19:22.48,0:19:25.32,Default,Spillik,0,0,0,,-Patawarin mo kami, reyna. \N-Patawarin mo kami, reyna.
Dialogue: 0,0:19:29.49,0:19:32.66,Default,Spillik,0,0,0,,Dapat tuparin ng isang mataas na opisyal ang kanyang salita.
Dialogue: 0,0:19:32.66,0:19:35.66,Default,Spillit,0,0,0,,Nangako kang pupunuin ang lawa ngayon.
Dialogue: 0,0:19:35.66,0:19:38.26,Default,Spillit,0,0,0,,Pinakamalapit na balon
Dialogue: 0,0:19:38.26,0:19:40.57,Default,Spillik,0,0,0,,napakalayo dito.
Dialogue: 0,0:19:40.57,0:19:43.37,Default,Spilyk,0,0,0,,Aabutin ito ng hindi bababa sa 15 araw...
Dialogue: 0,0:19:46.97,0:19:48.67,Default,Spillik,0,0,0,,Pakipatay mo ako!
Dialogue: 0,0:19:48.67,0:19:54.15,Default,Spillik,0,0,0,,-Pakipatay mo ako! \N-Pakipatay mo ako.
Dialogue: 0,0:19:54.15,0:19:56.48,Default,Spillik,0,0,0,,Bakit lagi kang humihingi ng execution?
Dialogue: 0,0:19:57.65,0:20:00.89,Default,Spillik,0,0,0,,Hindi ka siguro naniniwala na papatayin talaga kita?
Dialogue: 0,0:20:00.95,0:20:02.59,Default,Spillik,0,0,0,,Dapat ko bang ipakita ito sa iyo?
Dialogue: 0,0:20:02.59,0:20:05.56,Default,Spillik,0,0,0,,Gusto mo bang maranasan mismo kung anong klaseng scam ang nangyayari?
Dialogue: 0,0:20:09.96,0:20:13.33,Default,Spilyk,0,0,0,,Nakalampas na kami. Sigurado ako na kahit isang hindi kumpletong lawa ay gagana.
Dialogue: 0,0:20:13.90,0:20:15.37,Default,Spillik,0,0,0,,Hindi, Kamahalan.
Dialogue: 0,0:20:15.70,0:20:17.80,Default,Spillik,0,0,0,,Bakit mo ginagawa ito?
Dialogue: 0,0:20:17.80,0:20:20.67,Default,Spillik,0,0,0,,Hindi ako papayag na kitilin mo muli ang iyong buhay.
Dialogue: 0,0:20:21.37,0:20:22.94,Default,Spillik,0,0,0,,Hindi ganoon.
Dialogue: 0,0:20:23.64,0:20:25.55,Default,Spillik,0,0,0,,Hindi ko sinusubukang mamatay.
Dialogue: 0,0:20:25.55,0:20:27.11,Default,Spillik,0,0,0,,Ano ang sinusubukan mong gawin noon?
Dialogue: 0,0:20:27.11,0:20:28.65,Default,Spillik,0,0,0,,Sa madaling sabi...
Dialogue: 0,0:20:29.02,0:20:32.32,Default,Spillik,0,0,0,,Sinusubukang mabuhay. Iyon lang ang magagawa ko!
Dialogue: 0,0:20:38.89,0:20:40.79,Default,Spillik,0,0,0,,Batay ko lang ang dadaanan mo!
Dialogue: 0,0:20:41.29,0:20:42.93,Default,Spillik,0,0,0,,Damn, saan ka kumukuha ng sobrang lakas?
Dialogue: 0,0:20:42.93,0:20:44.40,Default,Spillik,0,0,0,,Bitawan mo ako.
Dialogue: 0,0:20:44.53,0:20:45.97,Default,Spillit,0,0,0,,Kung magbago ang isip ng lola na ito
Dialogue: 0,0:20:45.97,0:20:50.04,Default,Spikilka,0,0,0,,at muling alisin ang tubig sa lawa, nabaliw ako!
Dialogue: 0,0:20:50.07,0:20:51.87,Default,Spillie,0,0,0,,Tulungan pigilan ang reyna!
Dialogue: 0,0:20:51.87,0:20:53.47,Default,Spillie,0,0,0,,How dare you touch her?
Dialogue: 0,0:20:53.47,0:20:55.71,Default,Spillik,0,0,0,,Kamahalan!
Dialogue: 0,0:20:55.71,0:20:58.14,Default,Spillik,0,0,0,,Nakikiusap ako sa iyo, hindi!
Dialogue: 0,0:20:58.14,0:21:00.71,Default,Spillik,0,0,0,,Mula ngayon, walang quibbles!
Dialogue: 0,0:21:00.71,0:21:03.02,Default,Spillik,0,0,0,,Hinding-hindi ko sasabihin sa iyo ang "hindi"!
Dialogue: 0,0:21:03.02,0:21:05.08,Default,Spillik,0,0,0,,Hindi mo magagawa iyon!
Dialogue: 0,0:21:05.08,0:21:06.29,Default,Spillik,0,0,0,,Sabi ko ayaw mo.
Dialogue: 0,0:21:06.29,0:21:09.22,Default,Spillik,0,0,0,,Na hinding hindi mo masasabing "hindi"!
Dialogue: 0,0:21:09.22,0:21:10.66,Default,Spillit,0,0,0,,Damn.
Dialogue: 0,0:21:14.03,0:21:15.96,Default,Spillik,0,0,0,,Hindi gagana.
Dialogue: 0,0:21:17.83,0:21:19.60,Default,Spillik,0,0,0,,Kiliti man lang ako.
Dialogue: 0,0:21:30.41,0:21:33.48,Default,Spillik,0,0,0,,Matagal ko nang nakalimutan kung paano tumawa.
Dialogue: 0,0:21:34.88,0:21:36.32,Default,Spillit,0,0,0,,Damn.
Dialogue: 0,0:21:36.55,0:21:39.09,Default,Spillit,0,0,0,,Ayoko. Tara na.
Dialogue: 0,0:21:39.09,0:21:40.55,Default,Spillik,0,0,0,,Wow.
Dialogue: 0,0:21:41.25,0:21:42.99,Default,Spillie,0,0,0,,Damn, Natigil ako.
Dialogue: 0,0:21:44.72,0:21:46.66,Default,Spillik,0,0,0,,So ayaw mo akong pumunta doon?
Dialogue: 0,0:21:49.40,0:21:50.80,Default,Spillik,0,0,0,,Mahusay.
Dialogue: 0,0:22:02.94,0:22:04.44,Default,Spillik,0,0,0,,Itaas ang iyong ulo.
Dialogue: 0,0:22:04.58,0:22:06.15,Default,Spilyk,0,0,0,,Ituwid ang iyong likod.
Dialogue: 0,0:22:11.12,0:22:12.72,Default,Spilyk,0,0,0,,Marunong ka bang lumangoy?
Dialogue: 0,0:22:18.99,0:22:20.53,Default,Spillik,0,0,0,,Iyon lang ba?
Dialogue: 0,0:22:20.63,0:22:24.76,Default,Spillik,0,0,0,,I'll go further, it will be deeper there.
Dialogue: 0,0:22:24.76,0:22:26.87,Default,Spillik,0,0,0,,Okay, ilipat ito.
Dialogue: 0,0:22:32.31,0:22:34.07,Default,Spillie,0,0,0,,-Mga Ama. \N-Oo, eto na!
Dialogue: 0,0:22:35.11,0:22:37.81,Default,Spillik,0,0,0,,Nabadtrip ako!
Dialogue: 0,0:22:38.61,0:22:41.15,Default,Spillit,0,0,0,,-Bummer. \N-Kamahalan.
Dialogue: 0,0:22:42.15,0:22:46.02,Default,Spillik,0,0,0,,Tinawagan ka ng Queen Dowager na magpakita kaagad.
Dialogue: 0,0:22:46.02,0:22:47.99,Default,Spillik,0,0,0,,Sa iyo!
Dialogue: 0,0:22:48.42,0:22:51.86,Default,Spillik,0,0,0,,Lee Senman. Nag-backfire sa akin ang pangalang ito.
Dialogue: 0,0:22:51.96,0:22:53.43,Default,Spillit,0,0,0,,Damn.
Dialogue: 0,0:22:53.43,0:22:56.06,Default,Spillik,0,0,0,,-Himala. \N-Anong kaligayahan.
Dialogue: 0,0:22:56.30,0:22:57.80,Default,Spillik,0,0,0,,Iyon lang.
Dialogue: 0,0:23:00.13,0:23:01.63,Default,Spillik,0,0,0,,Ano ito?
Dialogue: 0,0:23:01.77,0:23:05.17,Default,Spillik,0,0,0,,Nararamdaman mo rin ba kung minsan?
Dialogue: 0,0:23:05.94,0:23:09.24,Default,Spillik,0,0,0,,Kapag ang lahat ay nagkakagulo, at walang nagmamalasakit sa iyo.
Dialogue: 0,0:23:10.08,0:23:13.08,Default,Spillik,0,0,0,,Sir, ikaw ang sentro ng uniberso para sa akin.
Dialogue: 0,0:23:15.45,0:23:17.52,Default,Spillik,0,0,0,,Well, mga sensitibong tao tulad ko,
Dialogue: 0,0:23:17.52,0:23:20.15,Default,Spillik,0,0,0,,minsan nagkakamali sila sa kanilang premonitions, tulad ngayon.
Dialogue: 0,0:23:23.89,0:23:25.76,Default,Spillik,0,0,0,,Hindi ako umorder ng naengmyeon.
Dialogue: 0,0:23:25.99,0:23:28.79,Default,Spillik,0,0,0,,Pinapasaya mo ako gabi-gabi, na nagpapahintulot sa akin na pagsilbihan ka.
Dialogue: 0,0:23:28.79,0:23:30.43,Default,Spillik,0,0,0,,Ito ay mula sa kaibuturan ng aking puso.
Dialogue: 0,0:23:30.56,0:23:32.33,Default,Spillik,0,0,0,,Hayaan mo akong may sasabihin.
Dialogue: 0,0:23:32.33,0:23:35.30,Default,Spillik,0,0,0,,Mukhang tumatambay ako dito para magsaya, ngunit hindi iyon ang kaso.
Dialogue: 0,0:23:37.77,0:23:42.01,Default,Spillik,0,0,0,,Nandito lang ako para malaman ang kahit isang bagay
Dialogue: 0,0:23:42.01,0:23:44.18,Default,Spillik,0,0,0,,tungkol kay Lee Senman, na biglang nawala.
Dialogue: 0,0:23:44.64,0:23:49.01,Default,Spillik,0,0,0,,Pero bakit mo siya hinahanap-hanap?
Dialogue: 0,0:23:49.22,0:23:52.55,Default,Spillik,0,0,0,,Ito ay parang nasa likod ng kanyang pagkawala
Dialogue: 0,0:23:52.55,0:23:55.72,Default,Spillik,0,0,0,,may mahalagang sikreto.
Dialogue: 0,0:23:56.19,0:23:58.62,Default,Spillik,0,0,0,,Sinasabi sa akin ng sixth sense,
Dialogue: 0,0:23:59.19,0:24:01.63,Default,Spillik,0,0,0,,ano ito Lee Senman
Dialogue: 0,0:24:02.23,0:24:04.50,Default,Spillik,0,0,0,,sa pinakasentro ng problema.
Dialogue: 0,0:24:05.13,0:24:07.93,Default,Spillik,0,0,0,,-Ano ang problema? \N-Wala akong ideya.
Dialogue: 0,0:24:08.47,0:24:09.87,Default,Spillik,0,0,0,,Ano?
Dialogue: 0,0:24:19.18,0:24:22.18,Default,Spillik,0,0,0,,Sinusuri nila ako ngayon.
Dialogue: 0,0:24:23.05,0:24:26.15,Default,Spillik,0,0,0,,-Tungkol sa araw na ito... \N-Kasalanan ko.
Dialogue: 0,0:24:31.62,0:24:34.89,Default,Spillik,0,0,0,,Pinilit kitang pakasalan siya ng labag sa iyong kalooban.
Dialogue: 0,0:24:35.26,0:24:38.00,Default,Spillik,0,0,0,,Ayaw mo ba talagang maging reyna?
Dialogue: 0,0:24:38.00,0:24:40.17,Default,Spillik,0,0,0,,Kaya handa ka nang magpaalam sa buhay?
Dialogue: 0,0:24:40.57,0:24:42.60,Default,Spillit,0,0,0,,At mapatalsik bilang isang reyna?
Dialogue: 0,0:24:42.60,0:24:45.37,Default,Spillik,0,0,0,,Sinubukan niyang magpakamatay para hindi maging reyna?
Dialogue: 0,0:24:45.37,0:24:46.81,Default,Spillik,0,0,0,,Mahusay.
Dialogue: 0,0:24:46.84,0:24:49.61,Default,Spillik,0,0,0,,Kung gusto mo ito nang lubusan,\NI ay hahayaan kang umalis sa palasyo.
Dialogue: 0,0:24:49.98,0:24:52.11,Default,Spillik,0,0,0,,Ipapatalsik kita.
Dialogue: 0,0:24:52.61,0:24:55.31,Default,Spillie,0,0,0,,Makukulong ka sa bahay mo
Dialogue: 0,0:24:55.31,0:24:57.35,Default,Spillik,0,0,0,,at hindi ka aalis sa threshold sa buong buhay mo.
Dialogue: 0,0:24:57.35,0:24:58.38,Default,Spillik,0,0,0,,No.
Dialogue: 0,0:24:58.38,0:25:00.62,Default,Spillik,0,0,0,,Makakabalik lang ako dito sa lawa.
Dialogue: 0,0:25:00.62,0:25:03.79,Default,Spillik,0,0,0,,Hindi ko ito maalala.
Dialogue: 0,0:25:03.79,0:25:06.96,Default,Spillik,0,0,0,,Pagkatapos mahulog sa lawa, nakalimutan ko ang lahat.
Dialogue: 0,0:25:07.09,0:25:08.69,Default,Spillik,0,0,0,,Hindi bumalik ang mga alaala,
Dialogue: 0,0:25:08.69,0:25:11.56,Default,Spillik,0,0,0,,pero naalala mo ba na gusto mong magpakamatay?
Dialogue: 0,0:25:12.83,0:25:15.10,Default,Spillik,0,0,0,,May sakit pa rin akong nararamdaman.
Dialogue: 0,0:25:15.13,0:25:17.87,Default,Spillik,0,0,0,,At sigurado akong burdado ko ang tala na ito.
Dialogue: 0,0:25:18.04,0:25:21.61,Default,Spillik,0,0,0,,Pero bakit gusto kong magpakamatay, hindi ko alam.
Dialogue: 0,0:25:21.67,0:25:23.31,Default,Spillik,0,0,0,,Kung wala kang maalala,
Dialogue: 0,0:25:23.31,0:25:25.68,Default,Spillik,0,0,0,,bakit ka nakialam?
Dialogue: 0,0:25:28.38,0:25:30.08,Default,Spilyk,0,0,0,,Kung hindi ka magbibigay ng dahilan,
Dialogue: 0,0:25:30.12,0:25:32.59,Default,Spillik,0,0,0,,Ipapalagay ko na sinalungat mo ako.
Dialogue: 0,0:25:32.59,0:25:33.59,Default,Spillik,0,0,0,,No.
Dialogue: 0,0:25:33.59,0:25:36.29,Default,Spillik,0,0,0,,At hindi ko naisip na labanan ka.
Dialogue: 0,0:25:36.29,0:25:40.03,Default,Spillik,0,0,0,,Ngayon ay sinira mo ang aking awtoridad.
Dialogue: 0,0:25:40.39,0:25:41.89,Default,Spillik,0,0,0,,Kailangan kong ayusin ito.
Dialogue: 0,0:25:41.89,0:25:44.73,Default,Spillik,0,0,0,,Ngunit wala akong solusyon. Damn, walang pumapasok sa isip.
Dialogue: 0,0:25:44.73,0:25:48.33,Default,Spillik,0,0,0,,At hindi kita mapapatawad dahil diyan.
Dialogue: 0,0:25:50.30,0:25:53.44,Default,Spillik,0,0,0,,Nararapat akong mamatay, Kamahalan.
Dialogue: 0,0:25:53.74,0:25:56.24,Default,Spillie,0,0,0,,Kunin mo ang buhay ko.
Dialogue: 0,0:25:56.58,0:25:59.11,Default,Spillik,0,0,0,,Nalilito ako dahil sa kakulangan ng mga alaala,
Dialogue: 0,0:25:59.11,0:26:00.88,Default,Spillik,0,0,0,,pero hindi ko kayang talikuran ang aking kauri
Dialogue: 0,0:26:00.88,0:26:03.25,Default,Spillik,0,0,0,,at mula sa asawa ko.
Dialogue: 0,0:26:03.85,0:26:05.75,Default,Spillie,0,0,0,,Parusahan mo ako,
Dialogue: 0,0:26:05.75,0:26:09.92,Default,Spillie,0,0,0,,magbigay ng lason para mawala ang sakit na ito.
Dialogue: 0,0:26:13.03,0:26:15.86,Default,Spillik,0,0,0,,Talagang ayaw nilang ibagsak ang reyna.
Dialogue: 0,0:26:15.86,0:26:18.13,Default,Spillik,0,0,0,,Napakadali ba para sa iyo na isuko ang iyong buhay?
Dialogue: 0,0:26:18.36,0:26:20.10,Default,Spillit,0,0,0,,Ibinagsak niya ang sarili sa lawa.
Dialogue: 0,0:26:20.10,0:26:21.83,Default,Spillik,0,0,0,,Ngayon gusto mo bang uminom ng lason?
Dialogue: 0,0:26:21.83,0:26:24.34,Default,Spillik,0,0,0,,Bakit mahina ka?
Dialogue: 0,0:26:24.34,0:26:27.21,Default,Spillik,0,0,0,,Gusto nilang matiyak na may kapangyarihan sila sa reyna.
Dialogue: 0,0:26:27.21,0:26:29.17,Default,Spillit,0,0,0,,Ang hangal kong desisyon na magpaalam sa buhay
Dialogue: 0,0:26:29.17,0:26:31.64,Default,Spillik,0,0,0,,lumikha ng lahat ng hindi pagkakaunawaan.
Dialogue: 0,0:26:31.98,0:26:33.71,Default,Spillik,0,0,0,,Ang aking aksyon ay karapat-dapat sa kamatayan.
Dialogue: 0,0:26:33.71,0:26:38.45,Default,Spillik,0,0,0,,Nakikiusap ako na patayin mo ako, Kamahalan.
Dialogue: 0,0:26:38.45,0:26:41.35,Default,Spillik,0,0,0,,Walang maaayos ang iyong kamatayan.
Dialogue: 0,0:26:41.35,0:26:42.42,Default,Spillik,0,0,0,,Dahil sa trick na ito
Dialogue: 0,0:26:42.42,0:26:44.69,Default,Spillit,0,0,0,,magkakaroon ng advantage ang Inang Reyna.
Dialogue: 0,0:26:44.69,0:26:46.89,Default,Spillik,0,0,0,,Ngunit hindi lang ito makakaapekto sa iyo.
Dialogue: 0,0:26:46.89,0:26:51.06,Default,Spillik,0,0,0,,Maaapektuhan nito ang buong pamilya Kim.
Dialogue: 0,0:26:51.56,0:26:54.87,Default,Spillik,0,0,0,,-Susubukan ko... \N-Tumahimik ka, please.
Dialogue: 0,0:26:59.20,0:27:04.58,Default,Spillik,0,0,0,,Hihilingin kita sa huling pagkakataon.
Dialogue: 0,0:27:07.05,0:27:09.78,Default,Spillik,0,0,0,,Gusto mo ba talagang umalis sa palasyo?
Dialogue: 0,0:27:10.72,0:27:12.35,Default,Spilyk,0,0,0,,Gusto ko
Dialogue: 0,0:27:14.35,0:27:15.99,Default,Spillik,0,0,0,,nakatira sa isang palasyo.
Dialogue: 0,0:27:17.69,0:27:20.13,Default,Spillik,0,0,0,,Ano sa palagay mo, Kamahalan?
Dialogue: 0,0:27:29.34,0:27:32.57,Default,Spillik,0,0,0,,Dahil wala na akong alaala, magiging bagong tao na ako.
Dialogue: 0,0:27:35.64,0:27:38.71,Default,Spillit,0,0,0,,Magiging ideal queen ako.
Dialogue: 0,0:27:41.21,0:27:44.48,Default,Spillik,0,0,0,,Hindi ako naniniwala sa mga walang laman na pangako.
Dialogue: 0,0:27:44.48,0:27:46.35,Default,Spillik,0,0,0,,Papatunayan ko ito sa pagsasanay.
Dialogue: 0,0:27:48.25,0:27:50.96,Default,Spillik,0,0,0,,Pakiusap bigyan siya ng pagkakataon, Kamahalan.
Dialogue: 0,0:27:53.83,0:27:55.06,Default,,0,0,0,,Okay.
Dialogue: 0,0:27:55.06,0:27:58.80,Default,,0,0,0,,Salamat sa iyong kabaitan.
Dialogue: 0,0:28:00.23,0:28:02.50,Default,,0,0,0,,Hindi na kita guguluhin.
Dialogue: 0,0:28:02.50,0:28:04.87,Default,,0,0,0,,Walang dapat ipag-alala.
Dialogue: 0,0:28:08.27,0:28:09.41,Default,,0,0,0,,"Iwan mo ang iyong huwad na sarili"
Dialogue: 0,0:28:09.41,0:28:12.24,Default,,0,0,0,,Dahil wala na tayong kahinaan.
Dialogue: 0,0:28:13.05,0:28:14.75,Default,,0,0,0,,Aalisin namin
Dialogue: 0,0:28:17.38,0:28:19.22,Default,,0,0,0,,anumang problema.
Dialogue: 0,0:28:31.03,0:28:32.90,Default,,0,0,0,,Gagawin niya.
Dialogue: 0,0:28:33.10,0:28:34.70,Default,,0,0,0,,Ito ay isang babala.
Dialogue: 0,0:28:49.95,0:28:51.88,Default,,0,0,0,,Lahat ay hindi malinaw.
Dialogue: 0,0:28:53.55,0:28:55.85,Default,,0,0,0,,Magsindi pa ng mga parol, Kamahalan?
Dialogue: 0,0:28:55.99,0:28:58.72,Default,,0,0,0,,Hindi. Ito ang pinag-uusapan ko tungkol sa aking hinaharap.
Dialogue: 0,0:29:05.43,0:29:09.03,Default,,0,0,0,,Hinanap ni Prince Yeonpyeong at ng kanyang mga tauhan ang palasyo.
Dialogue: 0,0:29:09.07,0:29:10.90,Default,,0,0,0,,Ang kanyang mga tao?
Dialogue: 0,0:29:11.07,0:29:13.11,Default,,0,0,0,,Ito ba ang mga royal guard?
Dialogue: 0,0:29:13.31,0:29:15.44,Default,,0,0,0,,Sila ay mahusay na sinanay.
Dialogue: 0,0:29:15.44,0:29:16.91,Default,,0,0,0,,Magkano?
Dialogue: 0,0:29:17.28,0:29:18.88,Default,,0,0,0,,Medyo.
Dialogue: 0,0:29:19.58,0:29:21.85,Default,,0,0,0,,-Pito.\N-Sa lahat ng oras na ito
Dialogue: 0,0:29:21.85,0:29:25.05,Default,,0,0,0,,pito lang ang sinanay nila?
Dialogue: 0,0:29:28.55,0:29:30.46,Default,,0,0,0,,Wala ka nang gamot.
Dialogue: 0,0:29:30.49,0:29:34.03,Default,,0,0,0,,Kung hindi dahil sa sakit, naging mahusay kang mandirigma.
Dialogue: 0,0:29:34.03,0:29:35.59,Default,,0,0,0,,Buhay pa ako
Dialogue: 0,0:29:35.89,0:29:38.36,Default,,0,0,0,,salamat lang sa iyong tulong.
Dialogue: 0,0:29:38.96,0:29:40.43,Default,,0,0,0,,Salamat.
Dialogue: 0,0:29:45.90,0:29:49.01,Default,,0,0,0,,Kung nagkamali ka ulit,
Dialogue: 0,0:29:49.04,0:29:51.48,Default,,0,0,0,,hindi ka na makakatanggap ng anumang gamot.
Dialogue: 0,0:29:52.11,0:29:53.71,Default,,0,0,0,,Tatandaan ko.
Dialogue: 0,0:30:08.69,0:30:10.53,Default,,0,0,0,,Hanggang ngayon
Dialogue: 0,0:30:11.30,0:30:15.67,Default,,0,0,0,,naisip namin na nahulog ang reyna sa lawa para i-frame ang concubine na si Cho.
Dialogue: 0,0:30:16.14,0:30:20.51,Default,,0,0,0,,Naniniwala kami na siya ay sadyang nagsisinungaling tungkol sa pagkawala ng kanyang mga alaala.
Dialogue: 0,0:30:20.54,0:30:23.01,Default,,0,0,0,,Hindi ako makapaniwalang sinubukan niyang magpakamatay.
Dialogue: 0,0:30:23.01,0:30:26.21,Default,,0,0,0,,Marahil ito ang gusto niyang makuha ang iyong tiwala.
Dialogue: 0,0:30:26.41,0:30:29.55,Default,,0,0,0,,Sa tingin mo ba alam niya na poprotektahan ko si Concubine Cho?
Dialogue: 0,0:30:29.55,0:30:31.88,Default,,0,0,0,,Huwag kang panindigan,
Dialogue: 0,0:30:32.12,0:30:34.62,Default,,0,0,0,,sisisi siya ng reyna.
Dialogue: 0,0:30:34.62,0:30:36.39,Default,,0,0,0,,Naiintindihan niya,
Dialogue: 0,0:30:36.79,0:30:39.29,Default,,0,0,0,,na maaaring makaimpluwensya sa iyo sa ganitong paraan.
Dialogue: 0,0:30:41.79,0:30:45.30,Default,,0,0,0,,Prinsipe Yeonpyeong, kita mo
Dialogue: 0,0:30:45.30,0:30:47.63,Default,,0,0,0,,may masamang hangarin sa bawat aksyon ng reyna.
Dialogue: 0,0:30:47.63,0:30:49.20,Default,,0,0,0,,Reyna -
Dialogue: 0,0:30:49.70,0:30:51.67,Default,,0,0,0,,suporta ng pamilya Kim.
Dialogue: 0,0:30:52.37,0:30:54.34,Default,,0,0,0,,Anong klaseng tao sila?
Dialogue: 0,0:30:54.47,0:30:57.84,Default,,0,0,0,,Sila ang minamasaker ng buong pamilya namin.
Dialogue: 0,0:30:57.84,0:30:59.41,Default,,0,0,0,,Hindi ko kailanman
Dialogue: 0,0:31:00.68,0:31:03.22,Default,,0,0,0,,Hindi ko ito makakalimutan.
Dialogue: 0,0:31:05.35,0:31:07.35,Default,,0,0,0,,Hindi ko rin ito malilimutan.
Dialogue: 0,0:31:07.59,0:31:10.02,Default,,0,0,0,,Ngunit tingnan kung ano ang ginawa ng reyna.
Dialogue: 0,0:31:10.12,0:31:13.83,Default,,0,0,0,,Sa kabila ng pagtatangka kong patayin siya at ang awayan ko kay Concubine Cho,
Dialogue: 0,0:31:13.83,0:31:16.36,Default,,0,0,0,,ipinahayag niya ang katotohanan para sa ating kapakanan.
Dialogue: 0,0:31:17.06,0:31:20.80,Default,,0,0,0,,Isipin mo pa rin ang iyong galit sa kanya
Dialogue: 0,0:31:22.33,0:31:24.17,Default,,0,0,0,, deserved?
Dialogue: 0,0:31:25.54,0:31:29.01,Default,,0,0,0,,-Kamahalan.\N-Kung ito ay isang pagtatangkang magpakamatay,
Dialogue: 0,0:31:29.01,0:31:31.88,Default,,0,0,0,,tapos dalawang beses kong pinatay ang reyna.
Dialogue: 0,0:31:58.10,0:31:59.97,Default,,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:31:59.97,0:32:02.57,Default,,0,0,0,,Kailangan kitang makausap.
Dialogue: 0,0:32:02.57,0:32:05.04,Default,,0,0,0,,Ginakomplikado mo lang ang lahat.
Dialogue: 0,0:32:05.24,0:32:08.38,Default,,0,0,0,,Nasa kamay na ng pamilya mo ang kapalaran ko.
Dialogue: 0,0:32:09.75,0:32:12.82,Default,,0,0,0,,Next time ipapasa ko na lang yung letter.
Dialogue: 0,0:32:13.69,0:32:15.42,Default,,0,0,0,,Hindi mo ako gusto,
Dialogue: 0,0:32:16.42,0:32:18.52,Default,,0,0,0,,dahil galing ako sa Andong family ni Kim?
Dialogue: 0,0:32:18.52,0:32:20.66,Default,,0,0,0,,Hindi ko sinabing hindi kita gusto.
Dialogue: 0,0:32:20.83,0:32:22.89,Default,,0,0,0,,Tapos gusto mo ako?
Dialogue: 0,0:32:30.40,0:32:33.14,Default,,0,0,0,,Kung hindi ako mula sa Andon clan ni Kim,
Dialogue: 0,0:32:34.51,0:32:36.84,Default,,0,0,0,,gusto mo ba ako?
Dialogue: 0,0:32:37.34,0:32:39.11,Default,,0,0,0,,Hindi, sa tingin ko ay hindi.
Dialogue: 0,0:32:39.14,0:32:42.15,Default,,0,0,0,,Naging reyna ka salamat sa pamilya mo.
Dialogue: 0,0:32:43.68,0:32:46.32,Default,,0,0,0,,Nag-effort ako ng husto.
Dialogue: 0,0:32:46.62,0:32:49.42,Default,,0,0,0,,Ayokong maging reyna dahil sa pamilya ko.
Dialogue: 0,0:32:49.72,0:32:52.72,Default,,0,0,0,,Inilaan ko ang buong buhay ko dito, kahit ano pa ang sabihin nila.
Dialogue: 0,0:32:53.83,0:32:57.26,Default,,0,0,0,,Bukas makukuha mo ang gusto mo.
Dialogue: 0,0:32:58.80,0:33:01.77,Default,,0,0,0,,Gabi na, at bukas ay magiging mahirap na araw.
Dialogue: 0,0:33:02.30,0:33:04.34,Default,,0,0,0,,Bumalik sa iyong mga silid.
Dialogue: 0,0:33:08.31,0:33:10.61,Default,,0,0,0,,Dapat mahalin mo ako.
Dialogue: 0,0:33:15.45,0:33:17.78,Default,,0,0,0,,Utos ba ito?
Dialogue: 0,0:33:24.22,0:33:28.99,Default,,0,0,0,, Dahil sa kawalang-interes ko ay tumalon siya sa lawa.
Dialogue: 0,0:33:29.59,0:33:34.47,Default,,0,0,0,,Kung sinubukan niyang magpakamatay dahil sa iyong kawalang-interes,
Dialogue: 0,0:33:34.93,0:33:36.97,Default,,0,0,0,, tatalon lang siya sa lawa.
Dialogue: 0,0:33:36.97,0:33:39.74,Default,,0,0,0,,Ngunit napeke niya ang sulat at nahulog sa harap ni Concubine Cho.
Dialogue: 0,0:33:39.74,0:33:42.24,Default,,0,0,0,,Nakikita ko ang isang lihim na motibo dito.
Dialogue: 0,0:33:42.91,0:33:44.41,Default,,0,0,0,,Motive, magsalita.
Dialogue: 0,0:33:46.21,0:33:48.51,Default,,0,0,0,,Kailangan kong makita ang reyna.
Dialogue: 0,0:33:49.28,0:33:52.32,Default,,0,0,0,,Hindi itinatago ng mga kriminal ang kanilang ngiti.
Dialogue: 0,0:33:52.38,0:33:55.19,Default,,0,0,0,,Kung may lihim na motibo sa kanyang mga aksyon,
Dialogue: 0,0:33:56.42,0:33:59.26,Default,,0,0,0,,Nakikita ko sa ugali niya.
Dialogue: 0,0:33:59.69,0:34:03.09,Default,,0,0,0,,Alagaan si Concubine Cho sa ngayon.
Dialogue: 0,0:34:23.62,0:34:26.65,Default,,0,0,0,,Magpanggap na perpektong reyna sa loob ng 15 araw.
Dialogue: 0,0:34:26.79,0:34:28.65,Default,,0,0,0,,Kaya ko ba?
Dialogue: 0,0:34:28.72,0:34:32.49,Default,,0,0,0,,Kung hindi ko kaya, kung gayon mananatili ako sa nakalulungkot na katawan na ito,
Dialogue: 0,0:34:32.62,0:34:36.63,Default,,0,0,0,,bukod, sa likod ng mga bar bilang isang pinatalsik na reyna sa panahon ng Joseon.
Dialogue: 0,0:34:41.07,0:34:44.34,Default,,0,0,0,,Naghukay ako ng sarili kong libingan. Sino pa ba ang dapat sisihin?
Dialogue: 0,0:34:44.60,0:34:48.97,Default,,0,0,0,,Kamahalan, dumating na ang hari.
Dialogue: 0,0:34:48.97,0:34:53.01,Default,,0,0,0,,Siyempre Cheoljong.\N Kasalanan niya ang lahat.
Dialogue: 0,0:34:53.25,0:34:56.42,Default,,0,0,0,,Hindi ko siya tatayo kung hindi siya masyadong cool.
Dialogue: 0,0:34:56.42,0:34:57.85,Default,,0,0,0,,Buksan.
Dialogue: 0,0:34:57.95,0:35:01.62,Default,,0,0,0,,At bago pa man ay tuluyan na siyang nagkamali.
Dialogue: 0,0:35:04.09,0:35:05.59,Default,,0,0,0,,Hindi susubukan ng babaeng ito
Dialogue: 0,0:35:05.59,0:35:07.23,Default,,0,0,0,,malunod, kung mas mabait siya sa kanya.
Dialogue: 0,0:35:07.23,0:35:09.93,Default,,0,0,0,,-Hindi, kung ginawa niya ito dati...\N-My queen.
Dialogue: 0,0:35:10.80,0:35:12.80,Default,,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,0:35:14.13,0:35:17.64,Default,,0,0,0,,Inilagay mo ang isang espada sa aking leeg,\N saan nanggagaling ang pag-aalalang ito?
Dialogue: 0,0:35:20.27,0:35:23.44,Default,,0,0,0,,Wala pa akong tahimik na araw dito.
Dialogue: 0,0:35:23.44,0:35:25.58,Default,,0,0,0,,Ibuka ko lang ang mata ko, bukas na ang kasal.
Dialogue: 0,0:35:25.58,0:35:28.61,Default,,0,0,0,,Ang asawang kasama ko sa parehong kumot ay sinusubukan akong patayin.
Dialogue: 0,0:35:28.61,0:35:32.12,Default,,0,0,0,,At kahit ang sarili kong pamilya\N ay nagbabanta na ibagsak ako.
Dialogue: 0,0:35:33.75,0:35:34.82,Default,,0,0,0,,Ibagsak?
Dialogue: 0,0:35:34.82,0:35:36.66,Default,,0,0,0,,Ano? Nakatutukso?
Dialogue: 0,0:35:36.66,0:35:40.56,Default,,0,0,0,,Napakagandang pagkakataon para palitan ako ni Cho Hwajin, ha?
Dialogue: 0,0:35:40.56,0:35:43.06,Default,,0,0,0,,Bakit ka excited?
Dialogue: 0,0:35:43.10,0:35:45.43,Default,,0,0,0,,Hindi ako dumating para makipag-away sa iyo.
Dialogue: 0,0:35:45.43,0:35:48.23,Default,,0,0,0,,Kakatingin lang sayo nagagalit na ako.
Dialogue: 0,0:35:48.23,0:35:49.40,Default,,0,0,0,,Naisip mo na ba iyon?
Dialogue: 0,0:35:49.40,0:35:51.07,Default,,0,0,0,,Ikaw na nagtangkang patayin ako,
Dialogue: 0,0:35:51.07,0:35:53.64,Default,,0,0,0,,at ang isa kung kanino ka handa na mamatay.
Dialogue: 0,0:35:54.14,0:35:56.31,Default,,0,0,0,,Malapit na akong mamatay sa pagsisikap na iligtas kayong dalawa.
Dialogue: 0,0:35:56.31,0:35:59.41,Default,,0,0,0,,Oo, papatayin nila ako bago ako magpakamatay.
Dialogue: 0,0:35:59.74,0:36:04.35,Default,,0,0,0,, Kahit sino sa lugar ko ay magagalit ngayon kung hindi siya Buddha.
Dialogue: 0,0:36:06.15,0:36:08.39,Default,,0,0,0,,Naiintindihan ko na galit na galit ka sa akin.
Dialogue: 0,0:36:08.39,0:36:09.79,Default,,0,0,0,,Stop.
Dialogue: 0,0:36:10.02,0:36:11.32,Default,,0,0,0,,Hindi na kailangan.
Dialogue: 0,0:36:11.32,0:36:13.16,Default,,0,0,0,,Don't you dare talk,
Dialogue: 0,0:36:13.16,0:36:15.29,Default,,0,0,0,,na naiintindihan mo ako.
Dialogue: 0,0:36:17.46,0:36:19.06,Default,,0,0,0,,Dapat naintindihan mo ako
Dialogue: 0,0:36:19.06,0:36:22.33,Default,,0,0,0,,bago ilagay ang espada sa leeg ko.
Dialogue: 0,0:36:22.37,0:36:26.20,Default,,0,0,0,,Hindi. Dapat kanina mo pa naiintindihan ang babaeng ito
Dialogue: 0,0:36:26.54,0:36:30.21,Default,,0,0,0,,kung paano niya sinubukang magpakamatay.
Dialogue: 0,0:36:31.44,0:36:34.68,Default,,0,0,0,,Lumipas na ang sandali. Walang kwenta ang magsabi ng kahit ano.
Dialogue: 0,0:36:35.61,0:36:39.48,Default,,0,0,0,,Umalis ka na. Pagod ako habang galit ako.
Dialogue: 0,0:36:41.95,0:36:44.86,Default,,0,0,0,,Babalik ako kapag bumuti na ang pakiramdam mo.
Dialogue: 0,0:36:46.89,0:36:50.33,Default,,0,0,0,,Huwag kang lalapit maliban kung handa kang magmakaawa sa iyong mga tuhod.
Dialogue: 0,0:36:52.60,0:36:54.27,Default,,0,0,0,,Babalik ako.
Dialogue: 0,0:36:56.17,0:36:59.97,Default,,0,0,0,,Sabi ko sayong huwag kang sumama!
Dialogue: 0,0:37:30.60,0:37:33.37,Default,,0,0,0,,Napupuno na naman ba nila ang lawa?
Dialogue: 0,0:37:34.24,0:37:38.28,Default,,0,0,0,,Tinanong ito ng Her Majesty sa Dowager Queen.
Dialogue: 0,0:37:38.28,0:37:39.71,Default,,0,0,0,,Bakit?
Dialogue: 0,0:37:40.01,0:37:42.01,Default,,0,0,0,,Hindi ko alam kung eksakto,
Dialogue: 0,0:37:42.55,0:37:45.72,Default,,0,0,0,,pero narinig kong pumunta ang Her Majesty sa lawa
Dialogue: 0,0:37:45.72,0:37:49.22,Default,,0,0,0,,at personal na sinusubaybayan ang lahat.
Dialogue: 0,0:38:04.20,0:38:05.67,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:38:06.47,0:38:08.84,Default,,0,0,0,,Paumanhin sa abala.
Dialogue: 0,0:38:13.08,0:38:15.35,Default,,0,0,0,,Natatakot ako na baka mawala ka sa akin.
Dialogue: 0,0:38:19.42,0:38:21.49,Default,,0,0,0,,Hindi ka ba nasaktan?
Dialogue: 0,0:38:22.39,0:38:24.36,Default,,0,0,0,,Mas masakit ang sugat mo,
Dialogue: 0,0:38:25.49,0:38:28.19,Default,,0,0,0,,kaysa sa akin.
Dialogue: 0,0:38:30.50,0:38:32.06,Default,,0,0,0,,Ngayon
Dialogue: 0,0:38:33.10,0:38:35.83,Default,,0,0,0,,napakahirap para sa iyo.
Dialogue: 0,0:38:36.57,0:38:40.67,Default,,0,0,0,,Paumanhin sa pagkaladkad sa iyo dito.
Dialogue: 0,0:38:41.57,0:38:44.04,Default,,0,0,0,,Malamang na napakahirap para sa iyo
Dialogue: 0,0:38:44.04,0:38:46.58,Default,,0,0,0,,dahil sa lahat ng problemang ito sa palasyo.
Dialogue: 0,0:38:46.58,0:38:49.08,Default,,0,0,0,,Ayokong magdusa ka.
Dialogue: 0,0:38:49.55,0:38:52.08,Default,,0,0,0,,Kaya huwag mo nang ulitin.
Dialogue: 0,0:38:52.52,0:38:55.29,Default,,0,0,0,,Kung isakripisyo mo ang iyong sarili para sa akin,
Dialogue: 0,0:38:55.55,0:38:57.86,Default,,0,0,0,,paano ko ito haharapin?
Dialogue: 0,0:38:58.06,0:39:02.56,Default,,0,0,0,,Hindi ko gagawin ang kinatatakutan mo.
Dialogue: 0,0:39:03.73,0:39:05.90,Default,,0,0,0,,Hanggang sa umayos ang lahat,
Dialogue: 0,0:39:06.23,0:39:09.30,Default,,0,0,0,,Personal kang babantayan ni Prince Yeonpyeong.
Dialogue: 0,0:39:11.84,0:39:14.91,Default,,0,0,0,,Ano ang mali sa Ovol?
Dialogue: 0,0:39:15.21,0:39:17.61,Default,,0,0,0,,-Well...\N-Mr. Dumating na si Hong.
Dialogue: 0,0:39:18.44,0:39:19.88,Default,,0,0,0,,Enter.
Dialogue: 0,0:39:23.11,0:39:24.48,Default,,0,0,0,,Bilang kasambahay ni Concubine Cho?
Dialogue: 0,0:39:24.48,0:39:26.78,Default,,0,0,0,,Nasa infirmary siya ngayon.
Dialogue: 0,0:39:28.62,0:39:30.69,Default,,0,0,0,,Kuya na ang bahala sa lahat.
Dialogue: 0,0:39:31.42,0:39:32.92,Default,,0,0,0,,Salamat.
Dialogue: 0,0:39:36.93,0:39:39.00,Default,,0,0,0,,Nakilala mo na ba ang reyna?
Dialogue: 0,0:39:40.20,0:39:41.23,Default,,0,0,0,,Oo.
Dialogue: 0,0:39:41.23,0:39:43.90,Default,,0,0,0,,-Kamusta na siya?\N-Nagalit siya.
Dialogue: 0,0:39:44.74,0:39:46.20,Default,,0,0,0,,-Ano?\N-Blamed me
Dialogue: 0,0:39:46.20,0:39:48.27,Default,,0,0,0,,na siya ang nagtulak sa kanya upang magpakamatay.
Dialogue: 0,0:39:48.27,0:39:51.18,Default,,0,0,0,,Hate me for trying to kill her.
Dialogue: 0,0:39:51.18,0:39:53.38,Default,,0,0,0,,Nababalot siya ng emosyon.
Dialogue: 0,0:39:53.51,0:39:55.58,Default,,0,0,0,,Kung gusto niya akong manalo,
Dialogue: 0,0:39:55.58,0:39:57.25,Default,,0,0,0,,tapos hindi ako mag-asal ng ganyan.
Dialogue: 0,0:39:57.25,0:39:58.75,Default,,0,0,0,,At higit pa
Dialogue: 0,0:39:59.05,0:40:02.02,Default,,0,0,0,,Nagbanta ang mga Kim na patalsikin siya.
Dialogue: 0,0:40:02.82,0:40:05.29,Default,,0,0,0,,Hindi pa alam ni Kim Byungin,
Dialogue: 0,0:40:05.29,0:40:08.03,Default,,0,0,0,,yung scrap mula sa damit mo.
Dialogue: 0,0:40:08.13,0:40:09.56,Default,,0,0,0,,Okay.
Dialogue: 0,0:40:10.13,0:40:12.36,Default,,0,0,0,,Walang sinabi ang Reyna.
Dialogue: 0,0:40:12.36,0:40:14.20,Default,,0,0,0,,Hindi ko alam ang intensyon niya,
Dialogue: 0,0:40:14.43,0:40:17.10,Default,,0,0,0,,ngunit parang kumikilos ito nang mag-isa.
Dialogue: 0,0:40:18.00,0:40:19.47,Default,,0,0,0,,Akala ko maiintindihan ko,
Dialogue: 0,0:40:19.47,0:40:22.54,Default,,0,0,0,,anong klaseng tao siya, base sa mga kilos niya.
Dialogue: 0,0:40:23.71,0:40:25.48,Default,,0,0,0,,Pero lalo lang niya akong pinagtaka.
Dialogue: 0,0:40:32.65,0:40:34.82,Default,,0,0,0,,Ama, Benin ito.
Dialogue: 0,0:40:34.82,0:40:36.45,Default,,0,0,0,,Oo. Pumasok ka.
Dialogue: 0,0:40:46.56,0:40:49.13,Default,,0,0,0,,Akala mo huminto ka sa paninigarilyo.
Dialogue: 0,0:40:49.87,0:40:51.34,Default,,0,0,0,, Inabandona.
Dialogue: 0,0:40:58.48,0:41:00.51,Default,,0,0,0,,Paumanhin tungkol sa araw na ito.
Dialogue: 0,0:41:01.48,0:41:03.51,Default,,0,0,0,,Bakit ka humihingi ng tawad?
Dialogue: 0,0:41:04.08,0:41:06.32,Default,,0,0,0,,Ano ang susunod mong gagawin?
Dialogue: 0,0:41:07.15,0:41:09.09,Default,,0,0,0,,Susubukan kong mangatwiran sa kanya.
Dialogue: 0,0:41:09.09,0:41:12.09,Default,,0,0,0,,At kung hindi niya maintindihan, hindi siya iiral.
Dialogue: 0,0:41:13.46,0:41:16.26,Default,,0,0,0,,Sino ang sinasabi mo?
Dialogue: 0,0:41:17.03,0:41:18.73,Default,,0,0,0,,Tungkol sa sinuman.
Dialogue: 0,0:41:18.73,0:41:21.37,Default,,0,0,0,,Walang kaalyado sa loob ng maraming siglo.
Dialogue: 0,0:41:24.77,0:41:28.14,Default,,0,0,0,,Natatakot ako na hindi ngayon ang oras para dito,
Dialogue: 0,0:41:28.37,0:41:30.27,Default,,0,0,0,,pero kailangan kong sabihin sa iyo.
Dialogue: 0,0:41:30.78,0:41:32.34,Default,,0,0,0,,Okay. Anong meron?
Dialogue: 0,0:41:32.81,0:41:36.95,Default,,0,0,0,,Napagpasyahan ko kung hanggang saan ang aking mararating sa aking pangarap.
Dialogue: 0,0:41:37.18,0:41:39.65,Default,,0,0,0,,Natutuwa akong marinig iyon.
Dialogue: 0,0:41:39.98,0:41:41.39,Default,,0,0,0,,Anong posisyon?
Dialogue: 0,0:41:41.39,0:41:43.49,Default,,0,0,0,,Ako ang magiging pinuno ng Detective Department.
Dialogue: 0,0:41:43.66,0:41:45.42,Default,,0,0,0,,Detective department?
Dialogue: 0,0:41:45.99,0:41:49.26,Default,,0,0,0,,Ang pagiging isang mandirigma ang lahat ng pinangarap mo?
Dialogue: 0,0:41:49.26,0:41:52.60,Default,,0,0,0,,Magsisimula ako sa isang posisyon na kakayanin ko,
Dialogue: 0,0:41:52.60,0:41:54.63,Default,,0,0,0,,at pipiliin ko ang aking landas.
Dialogue: 0,0:41:54.90,0:41:56.30,Default,,0,0,0,,Ganun ba?
Dialogue: 0,0:41:58.04,0:42:01.34,Default,,0,0,0,,Sabi mo gusto mong pumili ng sarili mong landas?
Dialogue: 0,0:42:10.58,0:42:12.95,Default,,0,0,0,,Dumating na ang royal concubine.
Dialogue: 0,0:42:15.22,0:42:17.02,Default,,0,0,0,,Huwag gumalaw.
Dialogue: 0,0:42:23.50,0:42:24.93,Default,,0,0,0,,Your Highness.
Dialogue: 0,0:42:30.47,0:42:31.90,Default,,0,0,0,,Paumanhin.
Dialogue: 0,0:42:32.50,0:42:35.37,Default,,0,0,0,,Kinailangan kong tumayo hanggang sa huli.
Dialogue: 0,0:42:36.17,0:42:38.84,Default,,0,0,0,,Patunay ang mga bali mong tuhod.
Dialogue: 0,0:42:39.64,0:42:41.11,Default,,0,0,0,,Alam ko.
Dialogue: 0,0:42:42.65,0:42:44.58,Default,,0,0,0,,Wala ito.
Dialogue: 0,0:42:45.18,0:42:47.39,Default,,0,0,0,,Ilang araw na may mga halamang gamot,
Dialogue: 0,0:42:47.39,0:42:50.05,Default,,0,0,0,,at mapupuyat ako ng wala sa oras.
Dialogue: 0,0:42:50.79,0:42:54.26,Default,,0,0,0,,Oo. Wala akong duda na gagaling ka.
Dialogue: 0,0:42:55.89,0:42:58.20,Default,,0,0,0,,Sino ang maaaring tratuhin ka nang napakalupit?
Dialogue: 0,0:42:58.86,0:43:02.17,Default,,0,0,0,,Hindi ko nakita ang mukha niya, naka-mask siya.
Dialogue: 0,0:43:03.33,0:43:05.74,Default,,0,0,0,,Pero naalala ko ang boses.
Dialogue: 0,0:43:06.70,0:43:08.14,Default,,0,0,0,,Your Highness.
Dialogue: 0,0:43:08.94,0:43:10.54,Default,,0,0,0,,Paumanhin sa pagsasabi nito.
Dialogue: 0,0:43:10.98,0:43:13.18,Default,,0,0,0,,Kung may nasugatan na hindi mula sa royal family,
Dialogue: 0,0:43:13.21,0:43:15.41,Default,,0,0,0,,hindi siya maaaring manatili sa palasyo.
Dialogue: 0,0:43:15.85,0:43:18.72,Default,,0,0,0,,Ngunit paano siya makakaalis sa ganoong kalagayan?
Dialogue: 0,0:43:18.72,0:43:20.95,Default,,0,0,0,,Ito ay isang pasadyang palasyo.
Dialogue: 0,0:43:21.65,0:43:24.49,Default,,0,0,0,,Walang habag sa lugar na ito.
Dialogue: 0,0:43:31.20,0:43:33.16,Default,,0,0,0,,Kung sinuman ang nasa daan
Dialogue: 0,0:43:33.36,0:43:35.97,Default,,0,0,0,,susubukan mong saktan ka, gamitin ito bilang suhol.
Dialogue: 0,0:43:36.20,0:43:38.04,Default,,0,0,0,,Matagumpay na umalis sa palasyo,
Dialogue: 0,0:43:38.04,0:43:39.80,Default,,0,0,0,,samantalahin ito para mamuhay nang maginhawa.
Dialogue: 0,0:43:39.80,0:43:41.87,Default,,0,0,0,,Hindi, sobra.
Dialogue: 0,0:43:42.64,0:43:44.81,Default,,0,0,0,,Magpapadala ako ng sulat sa pamilya ko.
Dialogue: 0,0:43:44.88,0:43:46.61,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:43:49.55,0:43:52.68,Default,,0,0,0,,Salamat sa iyong serbisyo.
Dialogue: 0,0:43:53.15,0:43:56.25,Default,,0,0,0,,Nahihiya akong tingnan ang mukha ni Mr. Cho.
Dialogue: 0,0:43:56.96,0:43:58.56,Default,,0,0,0,,Hindi ako makakapunta.
Dialogue: 0,0:43:59.62,0:44:03.26,Default,,0,0,0,,Ovol, ikaw at ako ay lumaki nang magkasama.
Dialogue: 0,0:44:03.66,0:44:06.00,Default,,0,0,0,,Ikaw ang aking pamilya.
Dialogue: 0,0:44:06.80,0:44:08.50,Default,,0,0,0,,Kailangan mong manatili doon,
Dialogue: 0,0:44:09.07,0:44:10.67,Default,,0,0,0,,kaya ko rin.
Dialogue: 0,0:44:11.90,0:44:14.31,Default,,0,0,0,,Maging matapang ka para sa akin.
Dialogue: 0,0:44:14.91,0:44:16.51,Default,,0,0,0,,Dapat kang mabuhay.
Dialogue: 0,0:44:18.28,0:44:19.94,Default,,0,0,0,,Gawin mo para sa akin.
Dialogue: 0,0:44:49.71,0:44:52.18,Default,,0,0,0,,-Ano ang nangyari?\N -Kahapon ito ay isang baliw.
Dialogue: 0,0:44:52.18,0:44:53.78,Default,,0,0,0,,Reyna...
Dialogue: 0,0:44:56.45,0:44:57.92,Default,,0,0,0,,Aking panginoon.
Dialogue: 0,0:44:58.62,0:45:00.18,Default,,0,0,0,,Narinig mo na ba?
Dialogue: 0,0:45:00.18,0:45:03.49,Default,,0,0,0,,Nagkulog at kumidlat ang Kanyang Kamahalan sa Dowager Queen gamit ang kanyang mga mata.
Dialogue: 0,0:45:03.49,0:45:05.29,Default,,0,0,0,,Ang mga mata ay parang mansanas.
Dialogue: 0,0:45:06.76,0:45:08.66,Default,,0,0,0,,Hoy ikaw.
Dialogue: 0,0:45:08.93,0:45:12.76,Default,,0,0,0,,Kinuha siya ng Kanyang Kamahalan sa harap mismo ng reyna at...
Dialogue: 0,0:45:15.57,0:45:17.77,Default,,0,0,0,,Royal chef, narinig mo na ba?
Dialogue: 0,0:45:17.77,0:45:21.71,Default,,0,0,0,,Hinawakan ng kanyang kamahalan ang espada,\Nand ang dowager queen...
Dialogue: 0,0:45:24.34,0:45:25.88,Default,,0,0,0,,Narinig mo ba na may something sa Tongunjeong Hall?
Dialogue: 0,0:45:25.88,0:45:27.71,Default,,0,0,0,,Narinig kong ginagawa nila ito sa lahat ng oras.
Dialogue: 0,0:45:42.73,0:45:46.60,Default,,0,0,0,,Itatalaga ngayon ang pinuno ng Detective Department.
Dialogue: 0,0:45:46.80,0:45:48.30,Default,,0,0,0,,Magiging ganito ba?
Dialogue: 0,0:45:49.63,0:45:51.74,Default,,0,0,0,,Mayroon kaming kahilingan sa pagtatalaga.
Dialogue: 0,0:45:52.10,0:45:53.47,Default,,0,0,0,,At sino ang inirerekomenda
Dialogue: 0,0:45:53.47,0:45:56.37,Default,,0,0,0,,para sa posisyon ng pinuno ng Detective Department?
Dialogue: 0,0:45:56.37,0:45:59.51,Default,,0,0,0,,Byonin mula sa Andong Kim clan.
Dialogue: 0,0:46:05.52,0:46:07.89,Default,,0,0,0,,Medyo hindi inaasahan.
Dialogue: 0,0:46:07.92,0:46:10.32,Default,,0,0,0,,Sigurado akong maraming kandidato para sa posisyon na ito.
Dialogue: 0,0:46:10.32,0:46:13.59,Default,,0,0,0,,Kung hihirangin ko bilang pinuno ang isang taong nakapasa sa pagsusulit sa lingkod-bayan,
Dialogue: 0,0:46:13.59,0:46:15.36,Default,,0,0,0,,magkakaroon ng mga reklamo, hindi ba?
Dialogue: 0,0:46:15.36,0:46:18.73,Default,,0,0,0,,Kami ay nagkakaisang sumang-ayon\N sa rekomendasyong ito.
Dialogue: 0,0:46:20.43,0:46:22.10,Default,,0,0,0,,Unanimous?
Dialogue: 0,0:46:22.70,0:46:27.17,Default,,0,0,0,,Hindi ko inaasahan ang ganoong harmonious na relasyon sa pagitan ng aking mga sakop.
Dialogue: 0,0:46:28.17,0:46:32.21,Default,,0,0,0,,Balita ko siya ay isang kahanga-hangang tao.
Dialogue: 0,0:46:36.58,0:46:39.68,Default,,0,0,0,,Naihanda na ba ang Royal Notice of Appointment?
Dialogue: 0,0:46:40.02,0:46:44.56,Default,,0,0,0,,Para makasabay sa mabilis mong mga desisyon,
Dialogue: 0,0:46:44.56,0:46:47.32,Default,,0,0,0,,marahil bawasan ko ang oras ng pagtulog.
Dialogue: 0,0:46:47.46,0:46:49.43,Default,,0,0,0,,Huwag mong sabihin iyan.
Dialogue: 0,0:46:49.43,0:46:52.56,Default,,0,0,0,,Kailangan mong pangalagaan ang iyong kalusugan\Nand makabuo ng tagapagmana.
Dialogue: 0,0:46:53.76,0:46:57.60,Default,,0,0,0,,Hindi isang hari, ngunit isang breeding horse.
Dialogue: 0,0:47:12.02,0:47:18.02,Default,,0,0,0,,Palagi kang mapagpakumbaba. \ND'wag mawala ito - pagpapakumbaba.
Dialogue: 0,0:47:18.09,0:47:20.96,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:47:30.27,0:47:32.04,Default,,0,0,0,,Pungyang Cho Clan
Dialogue: 0,0:47:32.04,0:47:34.37,Default,,0,0,0,,nagdala ng problema sa sarili ko.
Dialogue: 0,0:47:34.37,0:47:36.84,Default,,0,0,0,,Dahil sa maling pag-amin ng babae
Dialogue: 0,0:47:37.61,0:47:40.04,Default,,0,0,0,,naranasan namin ang ganitong kahihiyan.
Dialogue: 0,0:47:47.22,0:47:51.26,Default,,0,0,0,,Ang pagkabigo ay isang dahilan, hindi isang resulta.
Dialogue: 0,0:47:51.39,0:47:52.82,Default,,0,0,0,,Ano?
Dialogue: 0,0:47:53.09,0:47:55.96,Default,,0,0,0,,Iyon ang sabi ng Inang Reyna.
Dialogue: 0,0:47:56.29,0:47:58.50,Default,,0,0,0,,Pumayag kami sa appointment ni Kim Byungin
Dialogue: 0,0:47:58.50,0:48:01.90,Default,,0,0,0,,at tinulungan silang palakasin ang kanilang mga posisyon,
Dialogue: 0,0:48:02.20,0:48:04.13,Default,,0,0,0,,natalo kasi kami.
Dialogue: 0,0:48:04.14,0:48:07.30,Default,,0,0,0,,Kung mas maraming talo, mas maliit ang tsansang manalo.
Dialogue: 0,0:48:07.47,0:48:08.94,Default,,0,0,0,,Sabi niya,
Dialogue: 0,0:48:09.67,0:48:12.48,Default,,0,0,0,,dapat nating gawin ang unang hakbang.
Dialogue: 0,0:48:40.20,0:48:42.41,Default,,0,0,0,,Sa tingin mo ba makaka-recover si Ovol?
Dialogue: 0,0:48:42.41,0:48:44.38,Default,,0,0,0,,Titingnan ko kung ano ang nararamdaman niya.
Dialogue: 0,0:48:44.38,0:48:47.44,Default,,0,0,0,,Siya ay aktibo, kaya palagi siyang nagmamadali.
Dialogue: 0,0:48:48.55,0:48:51.25,Default,,0,0,0,,Ngayon ay hindi na nito magagawa iyon.
Dialogue: 0,0:48:52.05,0:48:54.85,Default,,0,0,0,,Kung hindi siya sumama sa akin sa palasyo,..
Dialogue: 0,0:48:56.92,0:48:58.89,Default,,0,0,0,,Huwag mong isipin ito nang madalas.
Dialogue: 0,0:48:59.12,0:49:01.29,Default,,0,0,0,,Minsan ang mga iniisip ay maaaring magdala sa iyo sa isang swamp.
Dialogue: 0,0:49:01.89,0:49:04.80,Default,,0,0,0,,At kapag mas mahirap kang lumaban, mas lumalalim ito. \NIMas sasaktan.
Dialogue: 0,0:49:06.66,0:49:08.43,Default,,0,0,0,,Anong ginagawa mo,
Dialogue: 0,0:49:08.47,0:49:11.30,Default,,0,0,0,,upang alisin ang iyong ulo mula sa kasaganaan ng mga iniisip?
Dialogue: 0,0:49:11.70,0:49:13.17,Default,,0,0,0,,I
Dialogue: 0,0:49:14.51,0:49:16.41,Default,,0,0,0,,pumupunta kay Mr. Hong.
Dialogue: 0,0:49:16.74,0:49:18.94,Default,,0,0,0,,Maaari ka niyang aliwin.
Dialogue: 0,0:49:18.94,0:49:21.71,Default,,0,0,0,,Sobrang tanga niya.
Dialogue: 0,0:49:22.41,0:49:24.52,Default,,0,0,0,,Naiinis ako.
Dialogue: 0,0:49:24.72,0:49:26.42,Default,,0,0,0,,At kapag inilabas ko ang galit ko sa kanya,
Dialogue: 0,0:49:27.92,0:49:30.55,Default,,0,0,0,,pagkatapos ay lumabas ako sa latian nang hindi man lang ito napapansin.
Dialogue: 0,0:49:33.82,0:49:38.03,Default,,0,0,0,,Kung ganon pwede mo ba akong galitin?
Dialogue: 0,0:49:40.26,0:49:42.70,Default,,0,0,0,,-Ito...\N-O...
Dialogue: 0,0:50:33.88,0:50:35.89,Default,,0,0,0,,Huwag gumalaw.
Dialogue: 0,0:50:54.17,0:50:55.74,Default,,0,0,0,,Tapos na ako.
Dialogue: 0,0:51:00.24,0:51:01.65,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:51:01.65,0:51:04.85,Default,,0,0,0,,Walang problema.
Dialogue: 0,0:51:08.05,0:51:09.65,Default,,0,0,0,,May masakit ba?
Dialogue: 0,0:51:10.92,0:51:13.99,Default,,0,0,0,,Hindi mo ako mahahawakan.
Dialogue: 0,0:51:17.86,0:51:20.96,Default,,0,0,0,,Na-cramp ako.
Dialogue: 0,0:51:22.47,0:51:25.30,Default,,0,0,0,,Matagal na, di ba?
Dialogue: 0,0:51:25.30,0:51:26.84,Default,,0,0,0,,Salamat sa langit.
Dialogue: 0,0:51:28.11,0:51:30.64,Default,,0,0,0,,Napaka-focus mo kaya nakalimutan mo ang oras.
Dialogue: 0,0:51:44.86,0:51:48.06,Default,,0,0,0,,Kung gusto mong magburda,\Nkailangan mong pumunta sa Daejojeon Hall.
Dialogue: 0,0:51:48.06,0:51:50.63,Default,,0,0,0,,Ano ang nakalimutan mo sa kusina?
Dialogue: 0,0:51:56.40,0:51:59.10,Default,,0,0,0,,May binuburdahan ka ba?
Dialogue: 0,0:52:01.94,0:52:04.78,Default,,0,0,0,,Nangako akong babaguhin ko ang aking sarili bilang isang huwarang reyna.
Dialogue: 0,0:52:06.24,0:52:08.11,Default,,0,0,0,,Exemplary, tama ba?
Dialogue: 0,0:52:09.85,0:52:12.98,Default,,0,0,0,,Walang gagawin? Bigyan mo ako ng trabaho?
Dialogue: 0,0:52:12.98,0:52:14.72,Default,,0,0,0,,Aking likod.
Dialogue: 0,0:52:15.05,0:52:17.42,Default,,0,0,0,,At kailan ko malalaman ang lahat ng ito?
Dialogue: 0,0:52:19.16,0:52:20.72,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:52:23.06,0:52:25.70,Default,,0,0,0,,-Enter.\N-Teka.
Dialogue: 0,0:52:34.84,0:52:36.97,Default,,0,0,0,,Galing ba ito sa Dongmyeongjong Hall?
Dialogue: 0,0:52:36.97,0:52:38.71,Default,,0,0,0,,-Oo, Kamahalan. \N-Halika.
Dialogue: 0,0:52:44.48,0:52:46.62,Default,,0,0,0,,Sinubukan niya ang aking mga luto,
Dialogue: 0,0:52:46.62,0:52:49.09,Default,,0,0,0,,parang boring sa kanya ngayon ang mga luma.
Dialogue: 0,0:53:00.03,0:53:02.13,Default,,0,0,0,,Okay. Dalhin ito sa kuwadra.
Dialogue: 0,0:53:02.13,0:53:05.90,Default,,0,0,0,,Kung tatakpan nila ang palanquin ng pagkain ng kumot na ganito ang laki,
Dialogue: 0,0:53:05.90,0:53:07.54,Default,,0,0,0,,hindi lalamig ang pagkain.
Dialogue: 0,0:53:07.54,0:53:09.37,Default,,0,0,0,,Sabihin sa kanila na subukan.
Dialogue: 0,0:53:09.37,0:53:10.84,Default,,0,0,0,,Okay.
Dialogue: 0,0:53:14.14,0:53:16.48,Default,,0,0,0,,Susugod ka ba sa lawa sa sandaling maalis mo ako?
Dialogue: 0,0:53:16.65,0:53:19.48,Default,,0,0,0,,Nakita mo na ba ang sinumang nagsisikap nang husto habang sila ay malapit nang mamatay?
Dialogue: 0,0:53:19.65,0:53:22.05,Default,,0,0,0,,At parang nakalimutan mo na,\Nito ang naging kaugalian,
Dialogue: 0,0:53:22.05,0:53:24.29,Default,,0,0,0,,pero nasa ilalim ako ng mga surveillance camera.
Dialogue: 0,0:53:32.83,0:53:34.83,Default,,0,0,0,,Ano ang inaalala mo?
Dialogue: 0,0:53:40.27,0:53:44.07,Default,,0,0,0,,Buweno, gumawa tayo ng mga himala?
Dialogue: 0,0:53:53.02,0:53:54.52,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:53:55.39,0:53:56.82,Default,,0,0,0,,Oo!
Dialogue: 0,0:54:06.90,0:54:08.37,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:54:08.67,0:54:10.90,Default,,0,0,0,,Hey there. Tinadtad mo ba ang karne?
Dialogue: 0,0:54:10.90,0:54:12.40,Default,,0,0,0,,Oo.
Dialogue: 0,0:54:12.77,0:54:14.34,Default,,0,0,0,,Pumunta ka dito dali.
Dialogue: 0,0:54:15.61,0:54:17.54,Default,,0,0,0,,Dalhan mo ako ng asin.
Dialogue: 0,0:54:17.54,0:54:20.01,Default,,0,0,0,,Gusto ng Reyna na pagsilbihan ko muna siya.
Dialogue: 0,0:54:27.12,0:54:28.59,Default,,0,0,0,,Wow.
Dialogue: 0,0:54:29.75,0:54:32.12,Default,,0,0,0,,Well, well, gawin mo ang gusto mo.
Dialogue: 0,0:54:32.92,0:54:34.93,Default,,0,0,0,,Tingnan natin kung ano ang mangyayari.
Dialogue: 0,0:54:45.00,0:54:48.04,Default,,0,0,0,,Hihilingin ko bang magluto ang reyna?
Dialogue: 0,0:54:50.04,0:54:53.61,Default,,0,0,0,,Kamahalan, ito ang Chief Inspector.
Dialogue: 0,0:54:53.61,0:54:57.78,Default,,0,0,0,,Naghanda ng tanghalian ang Reyna para sa iyo.
Dialogue: 0,0:55:01.25,0:55:03.79,Default,,0,0,0,,Sabihin sa kanya na alisin ito?
Dialogue: 0,0:55:06.56,0:55:07.99,Default,,0,0,0,,Mga Mommies.
Dialogue: 0,0:55:07.99,0:55:09.53,Default,,0,0,0,,Ano ito?
Dialogue: 0,0:55:11.16,0:55:14.16,Default,,0,0,0,,Well, wala talagang delicacy.
Dialogue: 0,0:55:16.60,0:55:18.07,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:55:18.17,0:55:21.77,Default,,0,0,0,,Dumating na ang tanghalian mo, pero...
Dialogue: 0,0:55:35.65,0:55:37.39,Default,,0,0,0,,Mag-ingat.
Dialogue: 0,0:55:40.72,0:55:43.26,Default,,0,0,0,,At ito...
Dialogue: 0,0:56:08.69,0:56:11.05,Default,,0,0,0,,Sinabi na ng Reyna
Dialogue: 0,0:56:11.05,0:56:16.93,Default,,0,0,0,,ang paksa ng tanghalian ngayon ay HSNV.
Dialogue: 0,0:56:17.63,0:56:20.06,Default,,0,0,0,,HSNV?
Dialogue: 0,0:56:21.13,0:56:23.50,Default,,0,0,0,,Hindi ko pa ito narinig dati.
Dialogue: 0,0:56:23.50,0:56:25.07,Default,,0,0,0,,Mencius ba ito?
Dialogue: 0,0:56:25.17,0:56:28.51,Default,,0,0,0,,Hindi, hindi. \NSiguro mula sa Analects of Confucius?
Dialogue: 0,0:56:29.21,0:56:30.57,Default,,0,0,0,,Ibig sabihin
Dialogue: 0,0:56:30.57,0:56:34.24,Default,,0,0,0,,ang pagkain ay malutong sa labas
Dialogue: 0,0:56:34.24,0:56:36.45,Default,,0,0,0,,at malambot sa loob.
Dialogue: 0,0:56:37.41,0:56:39.92,Default,,0,0,0,,Talaga?
Dialogue: 0,0:56:49.76,0:56:51.19,Default,,0,0,0,,Dumating na ang palanquin na may dalang pagkain!
Dialogue: 0,0:57:03.77,0:57:06.04,Default,,0,0,0,,Narito. Kunin ang mga plato.
Dialogue: 0,0:57:09.88,0:57:11.48,Default,,0,0,0,,Mag-ingat.
Dialogue: 0,0:57:14.45,0:57:15.85,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:57:16.09,0:57:19.26,Default,,0,0,0,,Labis siyang nasiyahan at pinuri ka.
Dialogue: 0,0:57:21.26,0:57:24.03,Default,,0,0,0,,Nakakita ako ng palanquin para sa pagkain
Dialogue: 0,0:57:24.03,0:57:26.46,Default,,0,0,0,,at nagtanong kung paano ka nakaisip ng napakagandang ideya.
Dialogue: 0,0:57:26.46,0:57:28.30,Default,,0,0,0,,Malinaw ang tuod, kitang-kita ang resulta.
Dialogue: 0,0:57:28.30,0:57:31.53,Default,,0,0,0,,Patok ang bagay na ito\Nin competitive Korea.
Dialogue: 0,0:57:33.54,0:57:35.71,Default,,0,0,0,,Joseon delivery man.
Dialogue: 0,0:57:36.91,0:57:40.68,Default,,0,0,0,,Oh, kung gaano ako ipinagmamalaki sa aking sarili.
Dialogue: 0,0:57:42.05,0:57:43.95,Default,,0,0,0,,Sa pangkalahatan, mga babae mula sa royal family
Dialogue: 0,0:57:43.95,0:57:45.05,Default,,0,0,0,,dapat palaging mahinhin.
Dialogue: 0,0:57:45.05,0:57:46.48,Default,,0,0,0,,Nasa akin ka
Dialogue: 0,0:57:46.65,0:57:48.59,Default,,0,0,0,,nagmumukmok ka ba ngayon, o ano?
Dialogue: 0,0:57:49.49,0:57:53.92,Default,,0,0,0,,Dapat ba tayong maging mahinhin? \NT yan ang tanong.
Dialogue: 0,0:57:54.32,0:57:57.86,Default,,0,0,0,,Hindi. Mahirap ang buhay, kahit na nabubuhay ka sa pride.
Dialogue: 0,0:58:00.23,0:58:03.37,Default,,0,0,0,,Wala akong ideya kung ano ang sinasabi niya,\Npero nagagalit pa rin ito sa akin.
Dialogue: 0,0:58:04.33,0:58:08.21,Default,pineapple,0,0,0,,Dapat tayong matuwa na si Ovol ay nakaligtas.
Dialogue: 0,0:58:08.21,0:58:10.27,Default,pinya,0,0,0,,Ito ay isang sinag ng pag-asa sa dilim ng kabiguan.
Dialogue: 0,0:58:11.41,0:58:14.71,Default,pinya,0,0,0,,Sigurado ako pagkatapos ng nangyari
Dialogue: 0,0:58:14.71,0:58:17.98,Default,pineapple,0,0,0,,mas naiintindihan mo na ngayon kung anong uri ng mga tao ang Kim clan.
Dialogue: 0,0:58:18.28,0:58:21.49,Default,pineapple,0,0,0,,Hindi ko akalain na handa silang pumunta ng ganoon kalayo.
Dialogue: 0,0:58:21.49,0:58:23.65,Default,pineapple,0,0,0,,Dapat matakot ka.
Dialogue: 0,0:58:23.65,0:58:26.86,Default,pineapple,0,0,0,,Gayunpaman, ito ay simula pa lamang.
Dialogue: 0,0:58:27.36,0:58:33.10,Default,pinya,0,0,0,,Hindi nila malilimutan ang pagkatalo na ito.
Dialogue: 0,0:58:34.63,0:58:39.00,Default,pinya,0,0,0,,May mga tsismis na hindi namatay sa sakit ang namatay na hari.
Dialogue: 0,0:58:40.74,0:58:42.17,Default,pinya,0,0,0,,Ito pala...
Dialogue: 0,0:58:44.27,0:58:48.68,Default,pineapple,0,0,0,,Naniniwala siya na ang Kim clan ay ulcer sa katawan ni Joseon.
Dialogue: 0,0:58:49.51,0:58:51.28,Default,pinya,0,0,0,,Alam mo ba kung ano ang mali mo?
Dialogue: 0,0:58:51.28,0:58:52.95,Default,pinya,0,0,0,,Inalis niya ang kapangyarihan ni Kim Hong-geun
Dialogue: 0,0:58:52.95,0:58:54.52,Default,pinya,0,0,0,,at sinentensiyahan siya ng pagpapatapon.
Dialogue: 0,0:58:54.52,0:58:57.95,Default,pinya,0,0,0,,Binago ni King ang batas ng panunuhol,
Dialogue: 0,0:58:58.69,0:58:59.86,Default,pinya,0,0,0,,kaya nga
Dialogue: 0,0:58:59.86,0:59:02.99,Default,pineapple,0,0,0,,crossed the path of the Kim clan.
Dialogue: 0,0:59:03.66,0:59:06.86,Default,pineapple,0,0,0,,Hindi sila ang uri ng tao\Nna tatahimik.
Dialogue: 0,0:59:12.50,0:59:13.54,Default,pinya,0,0,0,,Sa kabutihang palad,
Dialogue: 0,0:59:13.54,0:59:16.17,Default,pinya,0,0,0,,swerte ay nasa panig ng hari,
Dialogue: 0,0:59:16.17,0:59:19.88,Default,pineapple,0,0,0,,at nakakita siya ng ebidensya laban sa lahat ng nasa likod ng mga kalupitan na ito.
Dialogue: 0,0:59:27.08,0:59:30.55,Default,pinya,0,0,0,,Pagkatapos ng kamatayan ng hari
Dialogue: 0,0:59:31.15,0:59:33.46,Default,pineapple,0,0,0,,at ang pantikim ng pagkain nito ay nawala.
Dialogue: 0,0:59:33.52,0:59:35.59,Default,pinya,0,0,0,,Sigurado akong nalason siya.
Dialogue: 0,0:59:36.66,0:59:38.40,Default,pinya,0,0,0,,Kung mas mabilis lang tayo,
Dialogue: 0,0:59:38.40,0:59:41.00,Default,pinya,0,0,0,,buhay pa sana ang hari.
Dialogue: 0,0:59:42.43,0:59:46.14,Default,pinya,0,0,0,,Makinig ka sa akin,\NIhindi pa tapos para sa iyo,
Dialogue: 0,0:59:46.14,0:59:49.37,Default,pineapple,0,0,0,,ngunit kung makaligtaan mo ang sandali, wala kang maibabalik.
Dialogue: 0,0:59:50.04,0:59:52.84,Default,pinya,0,0,0,,Sa pagkakataong ito ang iyong katulong na si Ovol ay nagdusa,
Dialogue: 0,0:59:52.98,0:59:56.08,Default,pineapple,0,0,0,,pero sa susunod ikaw na ang nasa pwesto niya.
Dialogue: 0,0:59:57.18,0:59:59.35,Default,pinya,0,0,0,,Magsusumite ako ng petisyon
Dialogue: 0,1:00:00.15,1:00:02.49,Default,pineapple,0,0,0,,tungkol sa pag-alis sa reyna ng kanyang titulo.
Dialogue: 0,1:00:03.52,1:00:05.82,Default,pinya,0,0,0,,Hindi mo na kailangang gawin,
Dialogue: 0,1:00:05.89,1:00:08.79,Default,pineapple,0,0,0,,kasalubong tayo ng hari.
Dialogue: 0,1:00:08.79,1:00:12.20,Default,pineapple,0,0,0,,Kailangan mo lang aprubahan ang ideyang ito.
Dialogue: 0,1:00:17.53,1:00:21.20,Default,pinya,0,0,0,,Inang Reyna, patawarin mo sana ako,
Dialogue: 0,1:00:24.21,1:00:27.38,Default,pineapple,0,0,0,,pero kailangan ko ng tulong mo.
Dialogue: 0,1:00:30.21,1:00:34.68,Default,pinya,0,0,0,,Kailangan mo lang pangalagaan ang ating hari.
Dialogue: 0,1:00:35.49,1:00:39.82,Default,pinya,0,0,0,,Pagkatapos nito ay magbabago ang hari\Nkanyang saloobin sa reyna,
Dialogue: 0,1:00:39.82,1:00:42.59,Default,pineapple,0,0,0,,hindi makikita kung bakit niya ginagawa ang lahat ng ito.
Dialogue: 0,1:00:47.06,1:00:51.03,Default,pineapple,0,0,0,,Ulap sa labas.\NITila uulan.
Dialogue: 0,1:00:51.03,1:00:52.54,Default,pinya,0,0,0,,Court lady Han,
Dialogue: 0,1:00:52.97,1:00:55.71,Default,pineapple,0,0,0,,madilim ang kwarto, sindihan ang mga kandila.
Dialogue: 0,1:00:55.81,1:00:57.24,Default,pineapple,0,0,0,,Sinusunod ko.
Dialogue: 0,1:01:24.17,1:01:26.90,Default,pinya,0,0,0,,Kung hihintayin mo ang hari, hindi siya darating.
Dialogue: 0,1:01:27.40,1:01:29.34,Default,pinya,0,0,0,,Paano mo malalaman na...
Dialogue: 0,1:01:29.54,1:01:32.71,Default,pinya,0,0,0,,Magpapatahimik ka lang\Nkapag kinuha mo lahat sa akin?
Dialogue: 0,1:01:32.94,1:01:35.41,Default,pinya,0,0,0,,Pinalitan mo ba ang sulat?
Dialogue: 0,1:01:37.41,1:01:39.52,Default,pineapple,0,0,0,,Nagbago ka ng mas seryoso.
Dialogue: 0,1:01:39.78,1:01:41.95,Default,pineapple,0,0,0,,Bakit hindi ko mapalitan ang ganoong kaliit na bagay?
Dialogue: 0,1:01:45.19,1:01:47.16,Default,pineapple,0,0,0,,Hindi ko maintindihan ang ibig mong sabihin.
Dialogue: 0,1:01:48.59,1:01:52.26,Default,pineapple,0,0,0,,Alam kong nagsinungaling ka.
Dialogue: 0,1:01:56.33,1:01:59.07,Default,pinya,0,0,0,,Kung malaman ng hari ang katotohanan,
Dialogue: 0,1:02:00.30,1:02:02.91,Default,pinya,0,0,0,,maiintindihan mo ang nararamdaman ko.
Dialogue: 0,1:02:03.77,1:02:06.94,Default,pineapple,0,0,0,,Yung feeling na nawalan ka ng taong pinapahalagahan mo.
Dialogue: 0,1:02:07.01,1:02:08.48,Default,pinya,0,0,0,,Gaano kahirap para sa iyo
Dialogue: 0,1:02:09.61,1:02:12.42,Default,pinya,0,0,0,, titingin sa kanyang mga mata
Dialogue: 0,1:02:13.55,1:02:15.75,Default,pineapple,0,0,0,,sa natitirang bahagi ng aking buhay.
Dialogue: 0,1:02:23.06,1:02:26.93,Default,pineapple,0,0,0,,Kung gusto mong ilihim ang lahat, umalis ka sa palasyo.
Dialogue: 0,1:02:28.80,1:02:31.13,Default,pinya,0,0,0,,Nahanap mo ang mahina kong punto.
Dialogue: 0,1:02:31.50,1:02:34.74,Default,pinya,0,0,0,,Okay, sabihin mo ito sa hari,
Dialogue: 0,1:02:34.94,1:02:38.47,Default,pineapple,0,0,0,,ngunit kailangan mong pag-usapan ang tungkol sa ibang bagay.
Dialogue: 0,1:02:40.21,1:02:41.74,Default,pinya,0,0,0,,Sinubukan mo
Dialogue: 0,1:02:42.61,1:02:44.58,Default,pinya,0,0,0,,patayin ang hari.
Dialogue: 0,1:02:53.46,1:02:55.73,Default,pineapple,0,0,0,,So alam mo na.
Dialogue: 0,1:02:56.99,1:02:58.53,Default,pinya,0,0,0,,Mayroon kang
Dialogue: 0,1:02:59.63,1:03:01.63,Default,pineapple,0,0,0,,walang gagana.
Dialogue: 0,1:03:07.04,1:03:08.77,Default,pinya,0,0,0,,Balang araw matatalo ka
Dialogue: 0,1:03:09.77,1:03:12.61,Default,pinya,0,0,0,,taong mahal mo.
Dialogue: 0,1:03:52.92,1:03:54.45,Default,pinya,0,0,0,,Ano ang nangyari?
Dialogue: 0,1:03:56.99,1:03:59.09,Default,pineapple,0,0,0,,Alam mo na.
Dialogue: 0,1:03:59.72,1:04:01.22,Default,pinya,0,0,0,,Kamahalan
Dialogue: 0,1:04:02.06,1:04:04.39,Default,pinya,0,0,0,,mahina kapag nakonsensya siya.
Dialogue: 0,1:04:06.06,1:04:08.00,Default,pineapple,0,0,0,,Ito ang presyo ng kaligtasan.
Dialogue: 0,1:04:08.63,1:04:10.30,Default,pineapple,0,0,0,,Guilt.
Dialogue: 0,1:04:16.51,1:04:20.74,Default,pinya,0,0,0,,Kamahalan, ito ang handa mong gawin para makuha ang pabor ng hari?
Dialogue: 0,1:04:36.89,1:04:39.30,Default,pinya,0,0,0,,Bilisan mo, itabi mo bago mabasa ang lahat!
Dialogue: 0,1:04:39.30,1:04:40.96,Default,pinya,0,0,0,,Bilisan mo!
Dialogue: 0,1:04:44.97,1:04:48.14,Default,pinya,0,0,0,,Umuulan nang ilang araw.
Dialogue: 0,1:04:48.27,1:04:50.27,Default,pinya,0,0,0,,At sa wakas ay pumunta siya.
Dialogue: 0,1:04:51.47,1:04:54.44,Default,pinya,0,0,0,,Sa buhay kong ito mas mataas ang posisyon ko kaysa sa kasalukuyan,
Dialogue: 0,1:04:54.95,1:04:57.68,Default,pinya,0,0,0,,pero bakit mas lalo akong sumama?
Dialogue: 0,1:04:57.68,1:04:58.68,Default,pinya,0,0,0,,Kamahalan,
Dialogue: 0,1:04:58.68,1:05:03.02,Default,pinya,0,0,0,,sa tingin mo kaya ko pang magkaroon ng panibagong buhay?
Dialogue: 0,1:05:03.92,1:05:07.39,Default,pineapple,0,0,0,,Ayon sa teorya ng parallel worlds, lahat ay posible.
Dialogue: 0,1:05:11.90,1:05:12.90,Default,pineapple,0,0,0,,Tingnan mo.
Dialogue: 0,1:05:12.90,1:05:15.63,Default,pinya,0,0,0,,Ito ang buhay na ginagalawan mo ngayon.
Dialogue: 0,1:05:16.63,1:05:19.20,Default,pinya,0,0,0,,Ngunit ito ang iyong ibang buhay.\NDNaiintindihan mo ba?
Dialogue: 0,1:05:19.54,1:05:21.47,Default,pinya,0,0,0,,Isang uri ng mapahamak na bagay.
Dialogue: 0,1:05:23.34,1:05:25.34,Default,pinya,0,0,0,,Pagkatapos kong makipag-usap
Dialogue: 0,1:05:25.34,1:05:28.11,Default,pinya,0,0,0,,nagsalita ng ilang kalokohan sa reyna.
Dialogue: 0,1:05:28.71,1:05:33.58,Default,pinya,0,0,0,,Kung gayon ang puppy na ito ay maaaring maging tao sa nakaraang buhay?
Dialogue: 0,1:05:34.18,1:05:35.79,Default,pineapple,0,0,0,,Lahat ay posible.
Dialogue: 0,1:05:35.99,1:05:37.92,Default,pinya,0,0,0,,At tanga ang lutuin?
Dialogue: 0,1:05:41.42,1:05:44.69,Default,pineapple,0,0,0,,Or else. Malamang subordinate ko siya.
Dialogue: 0,1:05:45.50,1:05:47.36,Default,pinya,0,0,0,,Paano ako?
Dialogue: 0,1:05:48.77,1:05:53.04,Default,pineapple,0,0,0,,Palagi kang magiging court lady ni Choi.
Dialogue: 0,1:05:53.90,1:05:56.01,Default,pinya,0,0,0,,At ikaw, Hongyong...
Dialogue: 0,1:05:56.01,1:05:58.74,Default,pinya,0,0,0,,Pagkatapos ang nanay at tatay ko
Dialogue: 0,1:05:58.74,1:06:01.08,Default,pinya,0,0,0,,magiging masaya kaya sila sa kabilang buhay?
Dialogue: 0,1:06:01.08,1:06:02.08,Default,pinya,0,0,0,,Ano?
Dialogue: 0,1:06:02.08,1:06:05.62,Default,pinya,0,0,0,,Apat na lang ang natitira sa nanay ko.
Dialogue: 0,1:06:05.62,1:06:09.09,Default,pineapple,0,0,0,,Naputol ang mga kuko niya noong nagbubukod-bukod siya sa mga bato sa malamig na taglamig.
Dialogue: 0,1:06:09.09,1:06:14.02,Default,pinya,0,0,0,,Sa ibang buhay, ilalagay ba ng nanay ko ang lahat ng kuko niya?
Dialogue: 0,1:06:14.89,1:06:17.43,Default,pineapple,0,0,0,,Siyempre.
Dialogue: 0,1:06:17.43,1:06:19.76,Default,pinya,0,0,0,,At magkakaroon ng dalawang mata ang pari!
Dialogue: 0,1:06:19.76,1:06:21.36,Default,pinya,0,0,0,,Paano ang iyong ama?
Dialogue: 0,1:06:21.36,1:06:24.03,Default,pinya,0,0,0,,-Nabutas ang kanyang mata gamit ang pitchfork.\N-Ano?
Dialogue: 0,1:06:24.03,1:06:25.84,Default,pinya,0,0,0,,Dapat nanghiram ng bigas
Dialogue: 0,1:06:25.84,1:06:28.00,Default,pineapple,0,0,0,,at hindi nagbayad ng interes.
Dialogue: 0,1:06:28.07,1:06:31.01,Default,pineapple,0,0,0,,At pagkatapos ay kinokolekta ng mga nagpapautang ang mga utang.
Dialogue: 0,1:06:31.84,1:06:35.01,Default,pinya,0,0,0,,Sa bawat bakuran ay may nagdusa mula sa mga nagpapautang.
Dialogue: 0,1:06:36.58,1:06:37.81,Default,pineapple,0,0,0,,Huwag mag-alala.
Dialogue: 0,1:06:37.81,1:06:40.72,Default,pinya,0,0,0,,Sa kabilang buhay, ang iyong ina\Nay magkakaroon ng magagandang malusog na mga kuko,
Dialogue: 0,1:06:40.72,1:06:42.25,Default,pineapple,0,0,0,,hindi mo na kakailanganing mag-manicure.
Dialogue: 0,1:06:42.25,1:06:43.75,Default,pinya,0,0,0,,At ang aking ama ay magkakaroon
Dialogue: 0,1:06:43.75,1:06:47.12,Default,pinya,0,0,0,,nagniningning na mga mata, na parang may suot na contact.
Dialogue: 0,1:06:47.89,1:06:52.60,Default,pinya,0,0,0,,Gusto kong makita ang aking ina na may malusog na mga kuko.
Dialogue: 0,1:06:52.93,1:06:54.43,Default,pinya,0,0,0,,Eh!
Dialogue: 0,1:06:56.10,1:06:57.53,Default,pineapple,0,0,0,,At ako.
Dialogue: 0,1:06:58.30,1:07:00.40,Default,pinya,0,0,0,,Gusto ko talagang makita ang nanay ko.
Dialogue: 0,1:07:02.14,1:07:06.21,Default,pinya,0,0,0,,Hindi mo nakita ang mukha ng iyong ina!
Dialogue: 0,1:07:06.31,1:07:07.74,Default,pineapple,0,0,0,,Paano kaya.
Dialogue: 0,1:07:08.48,1:07:11.08,Default,pinya,0,0,0,,Bakit mo naalala ang tungkol sa kanya?
Dialogue: 0,1:07:11.98,1:07:14.32,Default,pinya,0,0,0,,Hindi ko ito pinag-uusapan nanay!
Dialogue: 0,1:07:14.32,1:07:17.42,Default,pinya,0,0,0,,Ang tinutukoy ko ay si Ms. Li Sunxin, siya ay buhay at maayos!
Dialogue: 0,1:07:18.62,1:07:20.56,Default,pinya,0,0,0,,Mag-zumba pa!
Dialogue: 0,1:07:20.56,1:07:22.39,Default,pinya,0,0,0,,Bakit mo ako pinaramdam na ulila?
Dialogue: 0,1:07:27.93,1:07:29.77,Default,pinya,0,0,0,,Nagtipon sa royal kitchen,
Dialogue: 0,1:07:29.77,1:07:32.10,Default,pineapple,0,0,0,,kung saan ang landas ay sarado sa mga babae, at sila ay nagbubulungan.
Dialogue: 0,1:07:32.10,1:07:34.80,Default,pineapple,0,0,0,,Hindi ko maintindihan ang mga babae.
Dialogue: 0,1:07:38.78,1:07:40.24,Default,pinya,0,0,0,,Mommy?
Dialogue: 0,1:07:42.45,1:07:43.88,Default,pinya,0,0,0,,Mommy!
Dialogue: 0,1:07:57.89,1:08:00.33,Default,pineapple,0,0,0,,Umuulan, kaya malungkot ang lahat.
Dialogue: 0,1:08:01.20,1:08:04.00,Default,pineapple,0,0,0,,Makinig, dalhan mo ako ng pajeon na may makgeolli.
Dialogue: 0,1:08:05.27,1:08:06.67,Default,pineapple,0,0,0,,Bumalik sa Daejojeon Hall.
Dialogue: 0,1:08:06.67,1:08:08.87,Default,pinya,0,0,0,,Magpapatuloy ang pagbuhos ng ulan sa mahabang panahon.
Dialogue: 0,1:08:10.27,1:08:11.51,Default,pinya,0,0,0,,Paano mo malalaman?
Dialogue: 0,1:08:11.51,1:08:13.91,Default,pinya,0,0,0,,Naging meteorological computer ka na ba?
Dialogue: 0,1:08:13.91,1:08:16.48,Default,pinya,0,0,0,,Wala akong ideya kung ano ang sinasabi mo,
Dialogue: 0,1:08:16.61,1:08:19.05,Default,pinya,0,0,0,,pero sobrang sakit ng pulso ko,
Dialogue: 0,1:08:19.05,1:08:21.62,Default,pineapple,0,0,0,,na nangangahulugang uulan buong gabi.
Dialogue: 0,1:08:23.82,1:08:25.45,Default,pinya,0,0,0,,Gaano kalakas?
Dialogue: 0,1:08:25.86,1:08:27.96,Default,pinya,0,0,0,,Hindi ko alam,
Dialogue: 0,1:08:29.73,1:08:32.90,Default,pinya,0,0,0,,kapag sobrang sakit, ibig sabihin
Dialogue: 0,1:08:32.90,1:08:36.47,Default,pineapple,0,0,0,,pupuno ang lahat ng barrels sa loob lang ng ilang oras.
Dialogue: 0,1:08:37.27,1:08:39.54,Default,pinya,0,0,0,,Mapupuno ba nito ang mga bariles sa loob ng ilang oras?
Dialogue: 0,1:08:39.80,1:08:43.54,Default,pinya,0,0,0,,Tapos magkakaroon ng tubig sa mga lawa at balon?
Dialogue: 0,1:08:56.55,1:08:58.02,Default,pineapple,0,0,0,,Chief Eunuch.
Dialogue: 0,1:08:58.82,1:09:00.36,Default,pinya,0,0,0,,Nakikinig ako, sir.
Dialogue: 0,1:09:03.33,1:09:04.43,Default,pinya,0,0,0,,Aklat ng Mga Pagbabago
Dialogue: 0,1:09:04.43,1:09:06.80,Default,pinya,0,0,0,,Upang gawing mas produktibo ang ating mga gabi kasama ang reyna,
Dialogue: 0,1:09:06.80,1:09:09.97,Default,pineapple,0,0,0,,Matulog na ako pagkatapos kong magbasa pa ng kaunti.
Dialogue: 0,1:09:10.10,1:09:12.54,Default,pineapple,0,0,0,,Gabi na, pwede ka nang umalis.
Dialogue: 0,1:09:12.80,1:09:14.24,Default,pineapple,0,0,0,,Sinusunod ko.
Dialogue: 0,1:09:22.38,1:09:25.25,Default,pinya,0,0,0,,Mga tala sa mga armas at kagamitan
Dialogue: 0,1:09:53.04,1:09:55.71,Default,flash 5,0,0,0,,Babalik ako kapag bumuti na ang pakiramdam mo.
Dialogue: 0,1:09:55.71,1:09:59.05,Default,flash 5,0,0,0,,Huwag pumunta maliban kung handa kang magmakaawa sa iyong mga tuhod.
Dialogue: 0,1:09:59.08,1:10:01.55,Default,flash 5,0,0,0,,Sabi ko sayong huwag kang sasama!
Dialogue: 0,1:10:11.43,1:10:14.23,Default,pinya,0,0,0,,Araw-araw akong lumuluhod,
Dialogue: 0,1:10:15.83,1:10:19.84,Default,pineapple,0,0,0,,ngunit hindi kung kanino\NI dapat yumukod.
Dialogue: 0,1:10:28.95,1:10:30.41,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,1:10:31.11,1:10:32.98,Default,pinya,0,0,0,,Magkakasakit ka!
Dialogue: 0,1:10:32.98,1:10:34.92,Default,pinya,0,0,0,,Wala akong pakialam sa sakit!
Dialogue: 0,1:10:34.92,1:10:37.02,Default,pinya,0,0,0,,Tingnan mo, nasa panig ko ang langit!
Dialogue: 0,1:10:37.02,1:10:39.62,Default,pinya,0,0,0,,Oh my God, madam, itigil mo na!
Dialogue: 0,1:10:40.09,1:10:42.73,Default,pinya,0,0,0,,Pakiusap, huminahon ka!
Dialogue: 0,1:11:13.89,1:11:15.63,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,1:11:15.63,1:11:16.86,Default,pinya,0,0,0,,Kamahalan?
Dialogue: 0,1:11:16.86,1:11:19.26,Default,pinya,0,0,0,,At isa pa!
Dialogue: 0,1:11:19.26,1:11:20.83,Default,pinya,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,1:11:20.83,1:11:22.83,Default,pinya,0,0,0,,Iyon lang! Hooray! Sa wakas!
Dialogue: 0,1:11:22.83,1:11:24.33,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,1:11:24.33,1:11:26.70,Default,pinya,0,0,0,,Ano ang problema mo?
Dialogue: 0,1:11:33.04,1:11:35.14,Default,pinya,0,0,0,,Anong klaseng babae siya?
Dialogue: 0,1:11:35.71,1:11:37.91,Default,pineapple,0,0,0,,Hindi mo alam kung ano ang nasa isip niya.
Dialogue: 0,1:11:37.91,1:11:40.45,Default,pinya,0,0,0,,Iyon lang! Kahanga-hanga!
Dialogue: 0,1:11:40.52,1:11:43.22,Default,pinya,0,0,0,,Ano ang nangyari sa iyo?
Dialogue: 0,1:11:45.25,1:11:48.16,Default,pineapple,0,0,0,,Bakit wala kang support group?
Dialogue: 0,1:11:57.07,1:11:59.30,Default,pinya,0,0,0,,Nagpasya din na mamasyal sa ulan?
Dialogue: 0,1:12:00.47,1:12:03.04,Default,pineapple,0,0,0,,Pumunta ako para humingi ng tawad.
Dialogue: 0,1:12:04.44,1:12:06.31,Default,pineapple,0,0,0,,Kalimutan mo na, wala akong pakialam.
Dialogue: 0,1:12:06.31,1:12:07.74,Default,pinya,0,0,0,,Hindi,
Dialogue: 0,1:12:07.74,1:12:09.91,Default,pineapple,0,0,0,,Hindi ko ito makakalimutan.
Dialogue: 0,1:12:09.91,1:12:12.52,Default,pinya,0,0,0,,Sinasabi ko sa iyo, wala akong pakialam, bakit ka naka-attach?
Dialogue: 0,1:12:13.08,1:12:14.48,Default,pinya,0,0,0,,Naka-attach?
Dialogue: 0,1:12:16.82,1:12:19.02,Default,pinya,0,0,0,,Ako ay isang simpleng tao.
Dialogue: 0,1:12:19.02,1:12:20.56,Default,pinya,0,0,0,,Natutuwa akong makita ka - I'm swearing,
Dialogue: 0,1:12:20.56,1:12:22.89,Default,pineapple,0,0,0,,nagpapasalamat - Nakikipag-away ako.
Dialogue: 0,1:12:22.89,1:12:24.89,Default,pinya,0,0,0,,Hindi ako makatiis sa mga sikopan,
Dialogue: 0,1:12:25.06,1:12:26.50,Default,pineapple,0,0,0,,bumaba.
Dialogue: 0,1:12:30.70,1:12:32.20,Default,pinya,0,0,0,,Lumabas?
Dialogue: 0,1:12:32.30,1:12:34.27,Default,pinya,0,0,0,,Naglakas loob akong humingi ng tawad,
Dialogue: 0,1:12:34.27,1:12:36.64,Default,pinya,0,0,0,,at ito ang makukuha ko bilang tugon?
Dialogue: 0,1:12:36.67,1:12:39.38,Default,pinya,0,0,0,,Makinig, kung ang nangangailangan lang ng tawad ay
Dialogue: 0,1:12:39.38,1:12:42.51,Default,pinya,0,0,0,,na humihingi ng tawad, at hindi sa tumatanggap sa kanila, sorry ba talaga yun?
Dialogue: 0,1:12:45.98,1:12:48.99,Default,pineapple,0,0,0,,May sariling mga patakaran ang royal family.
Dialogue: 0,1:12:48.99,1:12:52.05,Default,pinya,0,0,0,,Hanggang kailan ka magsasalita nang kakaiba?
Dialogue: 0,1:12:53.16,1:12:55.72,Default,pineapple,0,0,0,,Ngayon lang. Ito na ang huling araw.
Dialogue: 0,1:12:55.73,1:13:00.06,Default,pinya,0,0,0,,At bukas ang lahat ay mahuhulog sa lugar!
Dialogue: 0,1:13:00.06,1:13:02.83,Default,pinya,0,0,0,,Iyon lang! Ay oo!
Dialogue: 0,1:13:02.83,1:13:04.67,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,1:13:04.67,1:13:06.87,Default,pinya,0,0,0,,-Ayan!\N-Reyna!
Dialogue: 0,1:13:06.87,1:13:08.94,Default,pinya,0,0,0,,Ay oo!
Dialogue: 0,1:13:10.41,1:13:13.64,Default,pinya,0,0,0,,Kamahalan, umayos ka!
Dialogue: 0,1:13:13.64,1:13:15.28,Default,pinya,0,0,0,,Ay oo!
Dialogue: 0,1:13:18.08,1:13:21.38,Default,pineapple,0,0,0,,Na-offend mo ako, kaya ngayon magkahiwalay tayong natutulog.
Dialogue: 0,1:13:24.12,1:13:25.65,Default,pineapple,0,0,0,,Spend the night alone.
Dialogue: 0,1:13:27.76,1:13:31.36,Default,pinya,0,0,0,,Salamat sa Diyos! Natutuwa akong marinig ito!
Dialogue: 0,1:13:33.43,1:13:35.33,Default,pinya,0,0,0,,Ang galing kong tao.
Dialogue: 0,1:13:41.17,1:13:42.94,Default,pinya,0,0,0,,Pumunta ka ba sa labas nang walang payong?
Dialogue: 0,1:13:42.94,1:13:45.77,Default,pinya,0,0,0,,Minsan gusto kong mamasyal nang walang payong.
Dialogue: 0,1:13:45.84,1:13:49.51,Default,pinya,0,0,0,,Pakiramdam ko ay hinuhugasan ng ulan ang lahat ng alalahanin ko.
Dialogue: 0,1:13:52.15,1:13:54.25,Default,pinya,0,0,0,,Huwag kang malungkot!
Dialogue: 0,1:13:54.25,1:13:56.12,Default,pinya,0,0,0,,Kamahalan, bumalik ka sa loob!
Dialogue: 0,1:13:56.35,1:13:58.99,Default,pinya,0,0,0,,Nakakatakot na bangungot! Empress!
Dialogue: 0,1:13:58.99,1:14:00.62,Default,pinya,0,0,0,,Tumigil ka!
Dialogue: 0,1:14:01.46,1:14:04.36,Default,pinya,0,0,0,,Ano ito? Bakit magkakaroon ng kulog?
Dialogue: 0,1:14:04.36,1:14:06.43,Default,pinya,0,0,0,,Galit si Heaven!
Dialogue: 0,1:14:07.13,1:14:08.63,Default,pinya,0,0,0,,Magalit!
Dialogue: 0,1:14:08.63,1:14:12.74,Default,pinya,0,0,0,,Ginagalaw ko ang aking pelvis kung ang ibig sabihin ay\Nmagpapatuloy ang pagbuhos ng ulan sa mahabang panahon!
Dialogue: 0,1:14:13.34,1:14:16.27,Default,pinya,0,0,0,,Kamahalan! Itigil mo na!
Dialogue: 0,1:14:16.27,1:14:18.17,Default,pinya,0,0,0,,Ay oo!
Dialogue: 0,1:14:18.17,1:14:19.68,Default,pinya,0,0,0,,Pakiusap!
Dialogue: 0,1:14:20.08,1:14:21.54,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,1:14:21.54,1:14:23.95,Default,pinya,0,0,0,,Ang sakit ng reyna ay lumalala araw-araw,
Dialogue: 0,1:14:23.95,1:14:26.28,Default,pinya,0,0,0,,hindi niya pinalampas ang pagkakataong magpakamatay.
Dialogue: 0,1:14:26.32,1:14:29.39,Default,pinya,0,0,0,,Nanginginig ang buong bakuran dahil sa kanyang mga kalokohan.
Dialogue: 0,1:14:30.25,1:14:33.69,Default,pinya,0,0,0,,Hindi ba mas mabuting magsampa ng petisyon
Dialogue: 0,1:14:33.69,1:14:35.66,Default,pinya,0,0,0,,tungkol sa pagtanggal sa kanya ng kanyang titulo?
Dialogue: 0,1:14:35.89,1:14:38.73,Default,pineapple,0,0,0,,-Tama ka.\N-Tama.
Dialogue: 0,1:14:38.73,1:14:41.70,Default,pinya,0,0,0,,Panahon na para sa aming angkan
Dialogue: 0,1:14:41.70,1:14:44.07,Default,pineapple,0,0,0,,ipon ang iyong lakas.
Dialogue: 0,1:14:58.98,1:15:01.48,Default,pinya,0,0,0,,Kapag binuksan ng kaaway ang kanyang walang pagtatanggol na leeg,
Dialogue: 0,1:15:01.95,1:15:04.45,Default,pinya,0,0,0,,dapat mong kunin kaagad.
Dialogue: 0,1:15:09.49,1:15:12.19,Default,pinya,0,0,0,,Nasa panganib ang core ng ating bansa.
Dialogue: 0,1:15:12.19,1:15:15.86,Default,pinya,0,0,0,,Ang pag-alis sa reyna ng kanyang titulo ay tamang desisyon.
Dialogue: 0,1:15:24.57,1:15:27.41,Default,pinya,0,0,0,,Noong unang panahon ay may isang walang kamatayang nagngangalang Achilles.
Dialogue: 0,1:15:27.41,1:15:29.51,Default,pineapple,0,0,0,,At isa lang ang mahina niya.
Dialogue: 0,1:15:29.51,1:15:32.38,Default,pinya,0,0,0,,Sinasabi ng mga alamat na namatay siya mula sa isang arrow na pumutok sa kanyang sakong.
Dialogue: 0,1:15:32.55,1:15:35.48,Default,pineapple,0,0,0,,Ganito nabuo ang ekspresyong "takong ni Achilles".
Dialogue: 0,1:15:36.42,1:15:37.89,Default,pinya,0,0,0,,Ngunit ang tunay na dahilan ng kanyang pagkamatay ay,
Dialogue: 0,1:15:37.89,1:15:41.02,Default,pineapple,0,0,0,,na si Achilles ay walang taong gagawa sa kanya ng armored shoes.
Dialogue: 0,1:15:41.02,1:15:42.46,Default,pinya,0,0,0,,Sabi nila...
Dialogue: 0,1:15:42.46,1:15:45.90,Default,pinya,0,0,0,,Kung gusto ng mga tao na alisin ang kanilang mga kahinaan, aalisin nila ang isa't isa.
Dialogue: 0,1:15:45.90,1:15:48.30,Default,pinya,0,0,0,,Iwasan ang banta...
Dialogue: 0,1:15:48.30,1:15:51.87,Default,pineapple,0,0,0,,We are each other weak points,\Nthe reasons why we suffer.
Dialogue: 0,1:15:53.94,1:15:57.97,Default,pinya,0,0,0,,Ngunit pinoprotektahan at iniligtas din namin ang isa't isa.
Dialogue: 0,1:16:20.23,1:16:21.73,Default,pinya,0,0,0,,Honyoung,
Dialogue: 0,1:16:22.03,1:16:24.80,Default,pineapple,0,0,0,,siguraduhing bumili ng lupa sa Gangnam.
Dialogue: 0,1:16:24.80,1:16:27.37,Default,pinya,0,0,0,,Oo, Kamahalan.
Dialogue: 0,1:16:29.14,1:16:30.67,Default,pinya,0,0,0,,Lady Choi,
Dialogue: 0,1:16:31.27,1:16:33.38,Default,pineapple,0,0,0,,marami kang pinagdaanan dahil sa akin.
Dialogue: 0,1:17:02.54,1:17:04.07,Default,pineapple,0,0,0,,Sa wakas.
Dialogue: 0,1:17:09.01,1:17:12.11,Default,pinya,0,0,0,,Lake Chhundaji
Dialogue: 0,1:17:26.23,1:17:29.47,Default,pinya,0,0,0,,Hindi dapat ako nakarating dito\NJang Bong-hwan
Dialogue: 0,1:17:30.07,1:17:31.77,Default,pineapple,0,0,0,,Kailangan nating magdiwang kahit papaano.
Dialogue: 0,1:17:55.36,1:17:58.13,Default,pineapple,0,0,0,,Ngayon lahat ay mahuhulog na sa lugar.
Dialogue: 0,1:20:11.73,1:20:14.00,Default,pinya,0,0,0,,{\i1}Ang Reyna ang pinaka kakaiba at kakaibang tao{\i}
Dialogue: 0,1:20:14.00,1:20:16.20,Default,pinya,0,0,0,,{\i1}ng lahat ng kilala ko.{\i}
Dialogue: 0,1:20:16.20,1:20:18.47,Default,pinya,0,0,0,,{\i1}Para bang hindi siya mula sa ating mundo.{\i}
Dialogue: 0,1:20:18.47,1:20:20.87,Default,pinya,0,0,0,,{\i1}Kaninong kaluluwa ang gusto mong ipatawag?{\i}
Dialogue: 0,1:20:20.87,1:20:24.41,Default,pinya,0,0,0,,{\i1}Baliw talaga ang babaeng ito.{\i}
Dialogue: 0,1:20:24.41,1:20:26.88,Default,pinya,0,0,0,,{\i1}Mas malala ang internal na krisis,{\i}
Dialogue: 0,1:20:26.88,1:20:28.78,Default,pineapple,0,0,0,,{\i1}panlabas na problema. Hindi sumasang-ayon?{\i}
Dialogue: 0,1:20:28.78,1:20:30.01,Default,pinya,0,0,0,,{\i1}Gusto mo bang sabihin yan sa bansa{\i}
Dialogue: 0,1:20:30.01,1:20:31.25,Default,pinya,0,0,0,,{\i1}may problemang wala pa dati?{\i}
Dialogue: 0,1:20:31.25,1:20:32.31,Default,pinya,0,0,0,,{\i1}Lumalabas na...{\i}
Dialogue: 0,1:20:32.31,1:20:33.82,Default,pinya,0,0,0,,{\i1}Interes ng Kanyang Kamahalan sa Reyna{\i}
Dialogue: 0,1:20:33.82,1:20:35.95,Default,pinya,0,0,0,,{\i1}ay magiging kahinaan natin.{\i}
Dialogue: 0,1:20:35.95,1:20:39.05,Default,pinya,0,0,0,,{\i1}Kung gayon ngayon ang aming unang araw.{\i}
Dialogue: 0,1:20:39.05,1:20:40.46,Default,pinya,0,0,0,,{\i1}Ano?{\i}
Dialogue: 0,0:16:19.20,0:16:21.20,Default,,0,0,0,,


