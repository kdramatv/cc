Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:04.02,bekerja,,0,0,0,,{\pos(801,256)}Dikerjakan pada seri:\N Lily, Tiramisu, Zinger, Nanas, Boss, Biryulka
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.88,0:01:06.42,Default,,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.42,0:01:08.99,Default,,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:09.16,0:01:10.99,Default,,0,0,0,,5 episode
Dialog: 0,0:01:10.99,0:01:13.73,Default,,0,0,0,,Setiap orang mempunyai kelemahannya masing-masing.
Dialog: 0,0:01:18.80,0:01:21.74,Default,,0,0,0,,Bahkan Superman saat bertemu kryptonite
Dialog: 0,0:01:21.74,0:01:25.91,Default,,0,0,0,,menjadi hanya seorang eksentrik yang memakai celana dalam menutupi celananya.
Dialog: 0,0:01:29.41,0:01:31.38,Default,,0,0,0,,Jika Superman sangat lemah,
Dialog: 0,0:01:31.71,0:01:34.25,Default,,0,0,0,,bayangkan apa yang terjadi pada orang biasa.
Dialog: 0,0:01:46.09,0:01:48.13,Default,,0,0,0,,Saya akan mengungkapkan kebenaran!
Dialog: 0,0:01:48.70,0:01:52.03,Default,,0,0,0,,Saya akan menerima keinginan Anda, Yang Mulia!
Dialog: 0,0:01:52.23,0:01:54.90,Default,,0,0,0,,Bukan dia yang perlu dieksekusi!
Dialog: 0,0:01:59.21,0:02:00.64,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:02:02.91,0:02:04.34,Default,,0,0,0,,Saya mohon.
Dialog: 0,0:02:07.82,0:02:10.15,Default,,0,0,0,,Apakah kamu akan melawan kehendak raja?
Dialog: 0,0:02:20.79,0:02:25.10,Default,,0,0,0,,Bagi orang biasa, dunia ini adalah ladang ranjau kelemahan.
Dialog: 0,0:02:25.10,0:02:27.53,Default,,0,0,0,,Kita menjadi kelemahan satu sama lain
Dialog: 0,0:02:27.53,0:02:29.94,Default,,0,0,0,,dan kami menyeret semua orang ke dunia bawah.
Dialogue: 0,0:02:31.41,0:02:35.18,Default,,0,0,0,,Bahkan aku, Jang Bong Hwan yang sempurna, punya kelemahan.
Dialog: 0,0:02:35.68,0:02:37.38,Default,,0,0,0,,Dan ini tidak lebih dari...
Dialogue: 0,0:02:40.18,0:02:44.12,Default,,0,0,0,,Tak tahan kalau pria lain terlihat lebih keren dariku.
Dialog: 0,0:02:45.92,0:02:47.72,Default,,0,0,0,,Menyakiti ratu...
Dialog: 0,0:02:47.72,0:02:49.16,Default,,0,0,0,,Berhenti!
Dialogue: 0,0:02:49.86,0:02:52.46,Default,,0,0,0,,Apalagi dengan kehadiran orang yang kusuka.
Dialog: 0,0:02:52.46,0:02:56.00,Default,,0,0,0,,Aku harus menjadi yang paling keren di matanya.
Dialogue: 0,0:02:57.40,0:03:00.37,Default,,0,0,0,,Bisa dibilang ini kelemahannya
Dialog: 0,0:03:00.37,0:03:02.54,Default,,0,0,0,,siapa yang sempurna.
Dialog: 0,0:03:18.22,0:03:20.19,Default,,0,0,0,,Izinkan saya, sebagai korban kejadian ini,
Dialog: 0,0:03:20.19,0:03:22.56,Default,,0,0,0,,menjelaskan peristiwa tersebut.
Dialog: 0,0:03:24.99,0:03:26.43,Default,,0,0,0,,I
Dialog: 0,0:03:28.53,0:03:30.46,Default,,0,0,0,,mencoba bunuh diri.
Dialogue: 0,0:03:34.10,0:03:36.60,Default,,0,0,0,,Menurutmu hanya ada satu pria keren di sini?
Dialog: 0,0:03:36.60,0:03:38.81,Default,,0,0,0,,Jangan bergerak-gerak, Cheoljong.
Dialog: 0,0:03:38.81,0:03:40.91,Default,,0,0,0,,Akulah pahlawan di sini.
Dialog: 0,0:03:42.04,0:03:47.68,Default,,0,0,0,,Tolong, jangan sentuh mereka yang tidak bersalah atas apa pun.
Dialog: 0,0:03:49.62,0:03:51.12,Default,,0,0,0,,Luar Biasa.
Dialogue: 0,0:03:51.25,0:03:54.72,Default,,0,0,0,,Pernyataan yang konyol sekali?
Dialogue: 0,0:03:54.72,0:03:56.12,Default,,0,0,0,,Janda Ratu.
Dialog: 0,0:03:56.12,0:04:00.23,Default,,0,0,0,,Maaf, tapi aku mencoba bunuh diri.
Dialogue: 0,0:04:01.23,0:04:02.23,Default,,0,0,0,,Tinggalkan dirimu yang palsu
Dialog: 0,0:04:02.23,0:04:05.77,Default,,0,0,0,,Aku membawa catatan bunuh diri ini.
Dialogue: 0,0:04:11.21,0:04:13.57,Default,,0,0,0,,Saya akan kembali lagi hari ini.
Dialog: 0,0:04:13.97,0:04:15.98,Default,,0,0,0,,Saya tidak peduli jika kekacauan merajalela di sini.
Dialog: 0,0:04:16.68,0:04:18.95,Default,,0,0,0,,Mengapa kamu melakukan ini?
Dialog: 0,0:04:18.95,0:04:21.65,Default,,0,0,0,,Dan kenapa kamu bunuh diri
Dialog: 0,0:04:21.65,0:04:24.05,Default,,0,0,0,,malam sebelum kamu menjadi ratu?
Dialog: 0,0:04:26.09,0:04:27.79,Default,,0,0,0,,Masalahnya...
Dialogue: 0,0:04:27.79,0:04:30.89,Default,,0,0,0,,Apa alasanmu?
Dialogue: 0,0:04:31.43,0:04:34.83,Default,,0,0,0,,Yah, aku depresi dan ingin mati karena...
Dialog: 0,0:04:35.36,0:04:37.80,Default,,0,0,0,,Saya yakin ada alasannya.
Dialog: 0,0:04:40.63,0:04:42.10,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:04:44.94,0:04:46.41,Default,,0,0,0,,Sial!
Dialog: 0,0:04:48.61,0:04:49.71,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:04:49.71,0:04:51.14,Default,,0,0,0,,Soyeon.
Dialog: 0,0:05:03.59,0:05:05.39,Default,,0,0,0,,Apakah dia akan membawaku pergi sekarang?
Dialog: 0,0:05:05.39,0:05:06.43,Default,,0,0,0,,Jangan berani-berani.
Dialogue: 0,0:05:06.43,0:05:08.73,Default,,0,0,0,,Jangan mendekat. Jauh!
Dialogue: 0,0:05:31.35,0:05:33.05,Default,,0,0,0,,Janda Ratu.
Dialog: 0,0:05:33.05,0:05:36.56,Default,,0,0,0,,Ratu berbohong,
Dialog: 0,0:05:36.56,0:05:39.49,Default,,0,0,0,,untuk menyelamatkan nyawa\N orang yang kurang penting darinya.
Dialog: 0,0:05:39.49,0:05:41.63,Default,,0,0,0,,Percayalah pada hati yang berbudi luhur,
Dialog: 0,0:05:41.63,0:05:43.90,Default,,0,0,0,,memaafkan orang\N yang berbuat dosa terhadapnya,
Dialog: 0,0:05:43.90,0:05:45.53,Default,,0,0,0,,dan tunjukkan belas kasihan.
Dialogue: 0,0:05:45.53,0:05:48.67,Default,,0,0,0,,Jadi begitukah cara dia mengambil semuanya?
Dialogue: 0,0:06:10.39,0:06:15.03,Default,,0,0,0,,Apa yang menarik di sini?\N Begitu banyak orang yang berkumpul.
Dialog: 0,0:06:18.33,0:06:19.80,Default,,0,0,0,,...
Dialog: 0,0:06:20.10,0:06:23.30,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:06:23.64,0:06:28.88,Default,,0,0,0,,Apa yang terjadi disini?
Dialog: 0,0:06:30.34,0:06:31.78,Default,,0,0,0,,Oke.
Dialogue: 0,0:06:32.28,0:06:34.08,Default,,0,0,0,,Sang Ratu berusaha keras,
Dialog: 0,0:06:34.08,0:06:37.05,Default,,0,0,0,, biarlah, aku akan menunjukkan belas kasihan.
Dialog: 0,0:07:09.85,0:07:13.15,Default,,0,0,0,,5 episode: kelemahan
Dialog: 0,0:07:13.25,0:07:16.96,Default,,0,0,0,,Sudah lama sekali aku tidak melihat pemandangan seperti itu.
Dialog: 0,0:07:16.96,0:07:20.59,Default,,0,0,0,,Aku penasaran apa yang dipikirkan ratu ketika dia melakukan itu.
Dialogue: 0,0:07:20.79,0:07:22.83,Default,,0,0,0,,Demikianlah hati seorang wanita.
Dialogue: 0,0:07:23.13,0:07:26.90,Default,,0,0,0,,Tapi aku yakin keluarga Kim tidak ada hubungannya dengan itu.
Dialog: 0,0:07:26.90,0:07:28.33,Default,,0,0,0,,Ya.
Dialog: 0,0:07:28.74,0:07:31.10,Default,,0,0,0,,Menuju ke Aula Seonjong?
Dialogue: 0,0:07:31.20,0:07:35.28,Default,,0,0,0,,Hari ini aku butuh hal lain selain doa.
Dialog: 0,0:07:36.04,0:07:38.68,Default,,0,0,0,,Dia hanya permaisuri yang lemah,
Dialogue: 0,0:07:38.68,0:07:41.05,Default,,0,0,0,,tapi dialah satu-satunya anak panah kita.
Dialog: 0,0:07:41.31,0:07:44.42,Default,,0,0,0,,Kamu harus mengoleskan racun pada ujungnya.
Dialog: 0,0:08:05.37,0:08:06.77,Default,,0,0,0,,Dewa.
Dialogue: 0,0:08:11.51,0:08:13.18,Default,,0,0,0,,Apakah dia mencoba bunuh diri?
Dialogue: 0,0:08:14.08,0:08:15.55,Default,,0,0,0,,Apa maksudnya ini?
Dialog: 0,0:08:15.55,0:08:17.62,Default,,0,0,0,,Aku akan menunggu waktuku dan bangun di saat yang tepat.
Dialogue: 0,0:08:17.62,0:08:20.15,Default,,0,0,0,,Ayah macam apa aku ini sehingga aku tidak menebaknya?
Dialog: 0,0:08:20.65,0:08:22.36,Default,,0,0,0,,Saya telah melakukan dosa besar.
Dialog: 0,0:08:22.59,0:08:26.16,Default,,0,0,0,,Saya telah berdosa.
Dialogue: 0,0:08:26.56,0:08:28.46,Default,,0,0,0,,Ini semua salahku.
Dialogue: 0,0:08:28.60,0:08:31.10,Default,,0,0,0,,Dia seharusnya merawatnya dengan lebih baik.
Dialog: 0,0:08:31.10,0:08:33.20,Default,,0,0,0,,Saya melewatkannya.
Dialog: 0,0:08:33.93,0:08:35.94,Default,,0,0,0,,Kenapa dia melakukan ini?
Dialog: 0,0:08:36.27,0:08:39.14,Default,,0,0,0,,Kamu harus tahu, kamu bersamanya sepanjang waktu.
Dialog: 0,0:08:39.54,0:08:42.94,Default,,0,0,0,,Dia mencoba melompat ke dalam air beberapa kali,
Dialogue: 0,0:08:42.98,0:08:46.55,Default,,0,0,0,,Saya pikir itu karena guncangan saat musim gugur.
Dialogue: 0,0:08:46.55,0:08:48.15,Default,,0,0,0,,Beberapa kali?
Dialogue: 0,0:08:51.28,0:08:56.12,Default,,0,0,0,,Bagaimana penderitaannya?
Dialog: 0,0:08:56.76,0:08:58.32,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:08:58.39,0:09:01.69,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:09:03.36,0:09:06.30,Default,,0,0,0,,Yah, sudah cukup.
Dialog: 0,0:09:06.30,0:09:08.70,Default,,0,0,0,,Kamu akan menangis, aku tidak akan bangun.
Dialog: 0,0:09:12.01,0:09:15.58,Default,,0,0,0,,Sekarang bukan waktunya menangis.
Dialog: 0,0:09:16.14,0:09:18.31,Default,,0,0,0,,Akan melihat kita menangis,
Dialog: 0,0:09:18.98,0:09:22.15,Default,,0,0,0,,akan sangat kesal.
Dialog: 0,0:09:22.15,0:09:23.65,Default,,0,0,0,,Tentu saja.
Dialog: 0,0:09:23.92,0:09:25.22,Default,,0,0,0,,Kamu benar.
Dialog: 0,0:09:25.22,0:09:28.49,Default,,0,0,0,,Pada saat seperti itu kamu harus berani dan dekat dengannya.
Dialog: 0,0:09:28.79,0:09:31.29,Default,,0,0,0,,Bangun sekarang?
Dialog: 0,0:09:31.29,0:09:34.06,Default,,0,0,0,,-Soyeon.\N-Astaga.
Dialogue: 0,0:09:35.13,0:09:37.66,Default,,0,0,0,,Saat ibumu memberimu kehidupan,
Dialogue: 0,0:09:38.53,0:09:42.34,Default,,0,0,0,,dia kehilangan miliknya.
Dialog: 0,0:09:42.84,0:09:44.47,Default,,0,0,0,,Dia mulai lagi?
Dialog: 0,0:09:48.71,0:09:50.21,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:09:51.44,0:09:53.28,Default,,0,0,0,,Yang Mulia telah berkembang,
Dialog: 0,0:09:53.31,0:09:56.35,Default,,0,0,0,,tidak sempat melihat wajah ibuku.
Dialogue: 0,0:09:56.35,0:09:58.82,Default,,0,0,0,,Aku kasihan sekali padanya.
Dialog: 0,0:09:59.79,0:10:02.62,Default,,0,0,0,,Saya tidak tahu mengapa dia begitu menderita,
Dialogue: 0,0:10:02.62,0:10:05.29,Default,,0,0,0,,dan aku hanya melarangnya melakukan ini dan itu.
Dialog: 0,0:10:05.29,0:10:08.83,Default,,0,0,0,,Aku mengejarnya
Dialog: 0,0:10:09.43,0:10:12.43,Default,,0,0,0,,dan menggerutu sepanjang waktu.
Dialog: 0,0:10:12.87,0:10:15.77,Default,,0,0,0,,Karena aku dia bisa
Dialog: 0,0:10:16.30,0:10:20.44,Default,,0,0,0,,melompat ke danau.
Dialog: 0,0:10:20.67,0:10:24.28,Default,,0,0,0,,Bagaimana bisa, Yang Mulia.
Dialog: 0,0:10:25.11,0:10:27.75,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:10:29.25,0:10:30.28,Default,,0,0,0,,Saya menyerah.
Dialog: 0,0:10:30.28,0:10:33.02,Default,,0,0,0,,Saya tidak dapat mengatasi situasi ini.
Dialog: 0,0:10:33.39,0:10:37.22,Default,,0,0,0,,Gwanghwamun
Dialogue: 0,0:10:56.34,0:10:57.94,Default,,0,0,0,,Ratuku.
Dialog: 0,0:10:59.51,0:11:00.85,Default,,0,0,0,,Tolong,
Dialogue: 0,0:11:00.85,0:11:03.55,Default,,0,0,0,,jaga dirimu baik-baik.
Dialogue: 0,0:11:04.65,0:11:06.72,Default,,0,0,0,,Ayahmu yang menyedihkan
Dialog: 0,0:11:08.36,0:11:10.49,Default,,0,0,0,,meminta maaf.
Dialog: 0,0:11:24.77,0:11:26.34,Default,,0,0,0,,Benin.
Dialogue: 0,0:11:29.44,0:11:31.31,Default,,0,0,0,,Hari ini aku akan memasuki istana.
Dialog: 0,0:11:31.31,0:11:34.21,Default,,0,0,0,,Aku akan bertemu raja untuk pertama kalinya.
Dialogue: 0,0:11:35.75,0:11:37.28,Default,,0,0,0,,Senang sekali?
Dialogue: 0,0:11:38.22,0:11:40.09,Default,,0,0,0,,Aku hanya penasaran.
Dialog: 0,0:11:40.22,0:11:42.62,Default,,0,0,0,,Terkadang dia terlihat seperti orang bodoh yang jelek,
Dialog: 0,0:11:42.62,0:11:45.39,Default,,0,0,0,,dan terkadang seolah terbuat dari batu giok.
Dialog: 0,0:11:48.09,0:11:49.56,Default,,0,0,0,,Dalam mimpiku.
Dialogue: 0,0:11:50.23,0:11:53.63,Default,,0,0,0,,Tadi malam dia terlihat persis sepertimu.
Dialogue: 0,0:11:57.80,0:12:02.41,Default,,0,0,0,,Aku percaya bahwa aku harus menyerah padamu agar bisa membuatmu bahagia.
Dialogue: 0,0:12:03.54,0:12:07.15,Default,,0,0,0,,Sebelum mengunjungi istana, kamu sangat bahagia.
Dialog: 0,0:12:07.45,0:12:10.72,Default,,0,0,0,,Namun, setelah mengunjungi istana, dia mencoba bunuh diri.
Dialog: 0,0:12:18.59,0:12:20.66,Default,,0,0,0,,Benarkah karena ini?
Dialog: 0,0:12:38.38,0:12:41.98,Default,,0,0,0,,Dia jadi gila! Aku sudah kehilangan seluruh pikiranku!
Dialogue: 0,0:12:41.98,0:12:43.85,Default,,0,0,0,,Tinggalkan dirimu yang palsu
Dialog: 0,0:12:43.85,0:12:46.72,Default,,0,0,0,,Dia menghabiskan beberapa malam bersama raja. \NAApakah Anda yakin
Dialog: 0,0:12:46.72,0:12:49.46,Default,,0,0,0,,bahwa dia tidak mengaburkan otaknya?
Dialog: 0,0:12:49.46,0:12:51.49,Default,,0,0,0,,Tenang, Yang Mulia.
Dialog: 0,0:12:51.49,0:12:53.66,Default,,0,0,0,,Kemarahanmu tidak ada gunanya.
Dialogue: 0,0:12:53.66,0:12:55.76,Default,,0,0,0,,Bagaimana aku tidak marah?
Dialog: 0,0:12:55.76,0:12:58.60,Default,,0,0,0,,Kita melewatkan peluang besar.
Dialogue: 0,0:12:58.60,0:13:01.07,Default,,0,0,0,,Mereka menembak dirinya sendiri di kaki!
Dialog: 0,0:13:02.14,0:13:04.77,Default,,0,0,0,,Apakah kamu melihat bagaimana raja berperilaku?
Dialogue: 0,0:13:05.11,0:13:07.04,Default,,0,0,0,,Tampilan sombong itu.
Dialog: 0,0:13:07.04,0:13:10.54,Default,,0,0,0,,Saya menyelamatkannya dari kehidupan seorang petani sederhana dan menjadikannya seorang raja,
Dialog: 0,0:13:10.54,0:13:12.85,Default,,0,0,0,,apakah dia berani berpenampilan seperti itu?
Dialog: 0,0:13:12.85,0:13:14.98,Default,,0,0,0,,Kita perlu menenangkannya, karena dia memberontak.
Dialog: 0,0:13:14.98,0:13:18.15,Default,,0,0,0,,Saya akan memperketat aturan agar Anda tahu tempat Anda.
Dialogue: 0,0:13:23.22,0:13:25.93,Default,,0,0,0,,Mengapa membuang-buang waktu mengurus diri sendiri?
Dialog: 0,0:13:26.16,0:13:29.73,Default,,0,0,0,,Tidak ada sedikitpun usaha, perlu dikhawatirkan.
Dialog: 0,0:13:31.87,0:13:33.90,Default,,0,0,0,,Undang tabib Pak.
Dialog: 0,0:13:33.97,0:13:35.40,Default,,0,0,0,,Ya.
Dialog: 0,0:13:41.07,0:13:45.34,Default,,0,0,0,,Sejujurnya, ratu mendatangiku.
Dialogue: 0,0:13:46.78,0:13:49.62,Default,,0,0,0,,Malam itu saat aku menceburkan diri ke dalam danau.
Dialogue: 0,0:13:54.69,0:13:57.92,Default,,0,0,0,,Janda Ratu, I
Dialog: 0,0:14:01.16,0:14:02.96,Default,,0,0,0,,Aku akan meninggalkan istana.
Dialog: 0,0:14:04.16,0:14:05.97,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:14:05.97,0:14:08.67,Default,,0,0,0,,Saya tidak bisa menjadi ratu.
Dialog: 0,0:14:08.67,0:14:11.10,Default,,0,0,0,,Aku tidak ingin nasib pahit seperti itu menimpa diriku sendiri.
Dialog: 0,0:14:12.81,0:14:16.54,Default,,0,0,0,,Saya mendengar rumor bahwa Anda berperilaku buruk,
Dialog: 0,0:14:16.54,0:14:18.61,Default,,0,0,0,,tapi semua ini disengaja,
Dialog: 0,0:14:18.71,0:14:21.45,Default,,0,0,0,,agar tidak menjadi ratu.
Dialogue: 0,0:14:23.32,0:14:24.75,Default,,0,0,0,,Lucu sekali.
Dialogue: 0,0:14:24.75,0:14:27.55,Default,,0,0,0,,Anda pikir Anda bisa mencapai sesuatu dengan ini.
Dialogue: 0,0:14:27.95,0:14:29.82,Default,,0,0,0,,Kamu mengambil kelas untuk menjadi ratu.
Dialog: 0,0:14:29.82,0:14:31.69,Default,,0,0,0,,Entah kenapa tiba-tiba aku berubah pikiran
Dialog: 0,0:14:31.69,0:14:33.76,Default,,0,0,0,,dan saya tidak ingin tahu.
Dialog: 0,0:14:34.56,0:14:37.56,Default,,0,0,0,,Nasibmu sudah ditentukan sejak lahir.
Dialog: 0,0:14:37.56,0:14:40.43,Default,,0,0,0,,Kamu harus menjadi ratu dan melayani keluargamu.
Dialogue: 0,0:14:40.53,0:14:43.84,Default,,0,0,0,,Inilah takdirmu, untuk itulah kamu dilahirkan.
Dialog: 0,0:14:45.10,0:14:47.94,Default,,0,0,0,,Apakah Anda sendiri yang mengambil posisi ini?
Dialog: 0,0:14:47.94,0:14:49.41,Default,,0,0,0,,Tidak, bukan dirinya sendiri.
Dialogue: 0,0:14:49.64,0:14:52.65,Default,,0,0,0,,Jadi kamu tidak bisa mundur,\N meskipun kamu mau.
Dialog: 0,0:14:53.11,0:14:55.68,Default,,0,0,0,,Jika kamu ingin mati, matilah di istana.
Dialogue: 0,0:14:56.78,0:14:58.65,Default,,0,0,0,,Saya pikir dia mengatakan itu karena
Dialogue: 0,0:14:58.65,0:15:01.96,Default,,0,0,0,,bahwa anak muda sekarang cenderung membuat gunung dari sarang tikus mondok.
Dialog: 0,0:15:01.96,0:15:04.39,Default,,0,0,0,,Jadi saya tidak terlalu mementingkan hal ini.
Dialog: 0,0:15:04.99,0:15:08.83,Default,,0,0,0,,Aku bahkan tidak menyangka dia melompat ke danau untuk bunuh diri.
Dialog: 0,0:15:10.23,0:15:13.77,Default,,0,0,0,,Jika dia siap mati,\N hanya untuk tidak menjadi ratu,
Dialogue: 0,0:15:15.67,0:15:17.80,Default,,0,0,0,,jadi kelakuan gilanya hari ini juga...
Dialog: 0,0:15:18.64,0:15:22.14,Default,,0,0,0,,Cara meninggalkan jabatan ratu.
Dialog: 0,0:15:22.38,0:15:24.44,Default,,0,0,0,,Jika demikian,
Dialog: 0,0:15:24.54,0:15:28.15,Default,,0,0,0,,ratu tidak akan lolos tanpa hukuman.
Dialog: 0,0:15:28.38,0:15:31.78,Default,,0,0,0,,Tunggu aku! Bagaimana jika kamu terjatuh?
Dialog: 0,0:15:31.78,0:15:34.92,Default,,0,0,0,,Sudah kubilang, luangkan waktumu.
Dialog: 0,0:15:35.86,0:15:39.33,Default,,0,0,0,,Siapa yang berani menghalangi jalanku?
Dialogue: 0,0:15:44.76,0:15:46.67,Default,,0,0,0,,Janda Ratu.
Dialog: 0,0:15:46.67,0:15:49.70,Default,,0,0,0,,Kamu tidak akan bisa kembali ke rumah.
Dialog: 0,0:15:50.10,0:15:52.41,Default,,0,0,0,,-Apa?\N-Kepada Ratu, Jang Bong-hwan,
Dialog: 0,0:15:52.41,0:15:57.01,Default,,0,0,0,,diperintahkan untuk tinggal di sini selamanya sampai akhir hari-hariku
Dialog: 0,0:15:57.01,0:16:00.95,Default,,0,0,0,,dan hidup dalam penderitaan, tetap impoten.
Dialog: 0,0:16:09.42,0:16:10.82,Default,,0,0,0,,Tidak.
Dialog: 0,0:16:12.29,0:16:13.69,Default,,0,0,0,,Saya tidak mau.
Dialog: 0,0:16:13.73,0:16:19.10,Default,,0,0,0,,Saya tidak ingin menjadi impoten!
Dialog: 0,0:16:21.10,0:16:22.50,Default,Spillik,0,0,0,,Yang Mulia!
Dialogue: 0,0:16:25.00,0:16:26.87,Default,Spillik,0,0,0,,Sungguh mimpi buruk yang mengerikan.
Dialog: 0,0:16:27.81,0:16:30.24,Default,Spillik,0,0,0,,Kamu mencoba menenggelamkan diri di danau,
Dialog: 0,0:16:30.24,0:16:32.91,Default,Spillik,0,0,0,,dan hari ini mereka pingsan, aku sangat takut...
Dialog: 0,0:16:32.91,0:16:35.58,Default,Spillit,0,0,0,,Tenang. Saya mengerti perasaan Anda.
Dialog: 0,0:16:35.58,0:16:38.22,Default,Spillik,0,0,0,,Aku akan mati bersamamu!
Dialog: 0,0:16:45.93,0:16:47.53,Default,Spillik,0,0,0,,Sudah cukup.
Dialog: 0,0:16:47.53,0:16:50.43,Default,Spillik,0,0,0,,Aku sudah cukup menangis hari ini, aku tidak tahan lagi.
Dialogue: 0,0:16:50.43,0:16:53.83,Default,Spillit,0,0,0,,Itu tidak menular, jadi kenapa kamu menangis tiga kali?
Dialog: 0,0:16:54.00,0:16:56.40,Default,Spillik,0,0,0,,Aku tertidur saat menunggumu berhenti.
Dialog: 0,0:16:56.40,0:17:00.07,Default,Spillik,0,0,0,,Tentu saja kamu tidak ingin melihat air mataku.
Dialogue: 0,0:17:02.38,0:17:04.04,Default,Spillik,0,0,0,,Kamu manis saat tersenyum.
Dialog: 0,0:17:09.05,0:17:10.52,Default,Spillik,0,0,0,,Di mana nyonya istana Choi?
Dialog: 0,0:17:11.48,0:17:14.59,Default,Spillik,0,0,0,,Dia bersikeras bahwa dia akan membawakanmu obat sendiri.
Dialog: 0,0:17:14.92,0:17:18.93,Default,Spillik,0,0,0,,Ayahmu tinggal bersamamu
Dialog: 0,0:17:18.93,0:17:21.46,Default,Spikyulka,0,0,0,,dan baru pulang setelah matahari terbenam.
Dialog: 0,0:17:21.86,0:17:24.83,Default,Spillik,0,0,0,,Kalau saja kita bangun lebih awal, kita pasti sudah melihatnya.
Dialogue: 0,0:17:25.06,0:17:27.43,Default,Spillik,0,0,0,,Syukurlah aku tidak melihatnya.
Dialog: 0,0:17:27.70,0:17:28.87,Default,Spillik,0,0,0,,Apa?
Dialog: 0,0:17:28.87,0:17:30.74,Default,Spillik,0,0,0,,Jika dia mengetahui betapa indahnya tubuh
Dialog: 0,0:17:30.74,0:17:32.87,Default,Spillie,0,0,0,,putrinya yang tak ternilai ditangkap oleh jiwa seorang pria,
Dialog: 0,0:17:32.87,0:17:34.87,Default,Spillik,0,0,0,,Saya seharusnya kesal.
Dialog: 0,0:17:36.14,0:17:37.74,Default,Spillit,0,0,0,,Kita harus cepat sebelum Nona Choi kembali.
Dialog: 0,0:17:37.74,0:17:40.15,Default,Spillik,0,0,0,,Danau sudah terisi?
Dialog: 0,0:17:40.48,0:17:42.78,Default,Biryulka,0,0,0,,Apakah kamu ingin pergi ke danau saat ini?
Dialog: 0,0:17:43.45,0:17:46.19,Default,Spillik,0,0,0,,Hari ini adalah hari terakhir.
Dialog: 0,0:17:49.86,0:17:53.03,Default,Spillik,0,0,0,,-Apakah suasana hatimu sedang baik? \N-Tentu saja.
Dialog: 0,0:17:53.03,0:17:54.93,Default,Spillik,0,0,0,,Yang tersisa hanyalah pulang ke rumah,
Dialog: 0,0:17:54.93,0:17:57.23,Default,Spillik,0,0,0,,tetap menjadi orang paling keren di sini.
Dialogue: 0,0:17:57.63,0:17:59.06,Default,Spillik,0,0,0,,Oh, tepat sekali.
Dialog: 0,0:17:59.57,0:18:02.17,Default,Spilyk,0,0,0,,-Honyeon. \N-Ya, ratu.
Dialog: 0,0:18:03.37,0:18:05.20,Default,Spillik,0,0,0,,Aku mampu menanggung semua ini berkatmu.
Dialog: 0,0:18:05.27,0:18:08.71,Default,Spikyulka,0,0,0,,Aku tidak tahu tentang yang lain, tapi aku akan merindukanmu.
Dialog: 0,0:18:09.38,0:18:12.01,Default,Spillik,0,0,0,,Ya, dan aku juga akan merindukan nyonya istana Choi.
Dialogue: 0,0:18:13.11,0:18:17.18,Default,Spillik,0,0,0,,Honyeon, serahkan wasiat itu pada keturunanmu.
Dialog: 0,0:18:17.18,0:18:18.58,Default,Spillie,0,0,0,,Akankah?
Dialogue: 0,0:18:19.19,0:18:21.85,Default,Spillik,0,0,0,,Beli tanah di Gangnam.
Dialog: 0,0:18:21.85,0:18:23.39,Default,Spillik,0,0,0,,Kamu harus memberitahu mereka ini.
Dialog: 0,0:18:23.39,0:18:25.22,Default,Spilyk,0,0,0,,Lalu dalam 200 tahun
Dialog: 0,0:18:25.22,0:18:27.39,Default,Spillik,0,0,0,,ahli warismu akan hidup seperti orang kaya.
Dialog: 0,0:18:28.26,0:18:30.80,Default,Spillik,0,0,0,,Hanya itu yang bisa kuberikan padamu.
Dialog: 0,0:18:34.93,0:18:37.47,Default,Spillik,0,0,0,,Oke, silakan.
Dialog: 0,0:18:38.20,0:18:40.61,Default,Spillik,0,0,0,,Yang Mulia, hati-hati.
Dialog: 0,0:18:40.84,0:18:42.68,Default,Spillik,0,0,0,,Lebih energik.
Dialog: 0,0:18:46.05,0:18:48.75,Default,Spillik,0,0,0,,Cepat, perlu cepat.
Dialog: 0,0:18:53.95,0:18:55.25,Default,Spillik,0,0,0,,Apa ini?
Dialog: 0,0:18:55.25,0:18:57.76,Default,Spillik,0,0,0,,Kenapa kita kembali ke cara lama,
Dialog: 0,0:18:57.76,0:18:59.23,Default,Spilyk,0,0,0,,kapan saya membuat sistem baru?
Dialog: 0,0:18:59.23,0:19:00.73,Default,Spillik,0,0,0,,Masalahnya...
Dialogue: 0,0:19:01.09,0:19:04.16,Default,Spillit,0,0,0,,Sumurnya kosong.
Dialogue: 0,0:19:05.70,0:19:08.87,Default,Spillit,0,0,0,,Makanya kita ambil air dari yang lain
Dialog: 0,0:19:08.87,0:19:11.80,Default,Spillik,0,0,0,,dan kami membawanya ke sini, tapi...
Dialogue: 0,0:19:12.37,0:19:15.67,Default,Spillik,0,0,0,,Maukah kamu mengulanginya lagi? Saya mendengar sesuatu yang salah.
Dialog: 0,0:19:16.01,0:19:20.25,Default,Spillik,0,0,0,,Sepertinya kamu tidak akan selesai hari ini.
Dialog: 0,0:19:20.28,0:19:22.48,Default,Spillik,0,0,0,,Maafkan kami, ratu.
Dialog: 0,0:19:22.48,0:19:25.32,Default,Spillik,0,0,0,,-Maafkan kami, ratu. \N-Maafkan kami, ratu.
Dialog: 0,0:19:29.49,0:19:32.66,Default,Spillik,0,0,0,,Pejabat tinggi harus menepati janjinya.
Dialog: 0,0:19:32.66,0:19:35.66,Default,Spillit,0,0,0,,Kamu berjanji akan mengisi danau hari ini.
Dialogue: 0,0:19:35.66,0:19:38.26,Default,Spillit,0,0,0,,Sumur terdekat
Dialog: 0,0:19:38.26,0:19:40.57,Default,Spillik,0,0,0,,sangat, sangat jauh dari sini.
Dialog: 0,0:19:40.57,0:19:43.37,Default,Spilyk,0,0,0,,Ini akan memakan waktu setidaknya 15 hari...
Dialogue: 0,0:19:46.97,0:19:48.67,Default,Spillik,0,0,0,,Tolong eksekusi aku!
Dialogue: 0,0:19:48.67,0:19:54.15,Default,Spillik,0,0,0,,-Tolong eksekusi aku! \N-Tolong eksekusi aku.
Dialogue: 0,0:19:54.15,0:19:56.48,Default,Spillik,0,0,0,,Kenapa kamu selalu meminta eksekusi?
Dialog: 0,0:19:57.65,0:20:00.89,Default,Spillik,0,0,0,,Kamu mungkin tidak percaya kalau aku benar-benar akan mengeksekusimu?
Dialogue: 0,0:20:00.95,0:20:02.59,Default,Spillik,0,0,0,,Haruskah aku menunjukkannya padamu?
Dialogue: 0,0:20:02.59,0:20:05.56,Default,Spillik,0,0,0,,Mau merasakan sendiri penipuan seperti apa yang terjadi?
Dialog: 0,0:20:09.96,0:20:13.33,Default,Spilyk,0,0,0,,Kami telah lulus. Saya yakin danau yang tidak lengkap pun bisa berfungsi.
Dialog: 0,0:20:13.90,0:20:15.37,Default,Spillik,0,0,0,,Tidak, Yang Mulia.
Dialog: 0,0:20:15.70,0:20:17.80,Default,Spillik,0,0,0,,Mengapa kamu melakukan ini?
Dialog: 0,0:20:17.80,0:20:20.67,Default,Spillik,0,0,0,,Aku tidak akan membiarkanmu mengambil nyawamu lagi.
Dialog: 0,0:20:21.37,0:20:22.94,Default,Spillik,0,0,0,,Bukan seperti itu.
Dialog: 0,0:20:23.64,0:20:25.55,Default,Spillik,0,0,0,,Saya tidak mencoba mati.
Dialogue: 0,0:20:25.55,0:20:27.11,Default,Spillik,0,0,0,,Apa yang coba kamu lakukan?
Dialog: 0,0:20:27.11,0:20:28.65,Default,Spillik,0,0,0,,Singkatnya...
Dialog: 0,0:20:29.02,0:20:32.32,Default,Spillik,0,0,0,,Mencoba bertahan. Itulah satu-satunya cara saya bisa melakukannya!
Dialog: 0,0:20:38.89,0:20:40.79,Default,Spillik,0,0,0,,Kamu hanya akan melewati mayatku!
Dialog: 0,0:20:41.29,0:20:42.93,Default,Spillik,0,0,0,,Sial, dari mana kamu dapat kekuatan sebanyak itu?
Dialog: 0,0:20:42.93,0:20:44.40,Default,Spillik,0,0,0,,Lepaskan aku.
Dialogue: 0,0:20:44.53,0:20:45.97,Default,Spillit,0,0,0,,Jika nenek ini berubah pikiran
Dialog: 0,0:20:45.97,0:20:50.04,Default,Spikilka,0,0,0,,dan sekali lagi buang air di danau, aku kacau!
Dialog: 0,0:20:50.07,0:20:51.87,Default,Spillie,0,0,0,,Bantu hentikan ratu!
Dialogue: 0,0:20:51.87,0:20:53.47,Default,Spillie,0,0,0,,Beraninya kau menyentuhnya?
Dialog: 0,0:20:53.47,0:20:55.71,Default,Spillik,0,0,0,,Yang Mulia!
Dialog: 0,0:20:55.71,0:20:58.14,Default,Spillik,0,0,0,,Saya mohon, tidak!
Dialog: 0,0:20:58.14,0:21:00.71,Default,Spillik,0,0,0,,Mulai sekarang, jangan berdalih!
Dialog: 0,0:21:00.71,0:21:03.02,Default,Spillik,0,0,0,,Aku tidak akan pernah bilang "tidak"!
Dialog: 0,0:21:03.02,0:21:05.08,Default,Spillik,0,0,0,,Kamu tidak bisa melakukan itu!
Dialog: 0,0:21:05.08,0:21:06.29,Default,Spillik,0,0,0,,Saya bilang tidak.
Dialog: 0,0:21:06.29,0:21:09.22,Default,Spillik,0,0,0,,Bahwa kamu tidak akan pernah bisa mengatakan "tidak"!
Dialog: 0,0:21:09.22,0:21:10.66,Default,Spillit,0,0,0,,Sial.
Dialog: 0,0:21:14.03,0:21:15.96,Default,Spillik,0,0,0,,Tidak akan berfungsi.
Dialogue: 0,0:21:17.83,0:21:19.60,Default,Spillik,0,0,0,,Setidaknya gelitik aku.
Dialog: 0,0:21:30.41,0:21:33.48,Default,Spillik,0,0,0,,Aku sudah lama lupa cara tertawa.
Dialog: 0,0:21:34.88,0:21:36.32,Default,Spillit,0,0,0,,Sial.
Dialog: 0,0:21:36.55,0:21:39.09,Default,Spillit,0,0,0,,Saya tidak akan melakukannya. Ayo pergi.
Dialog: 0,0:21:39.09,0:21:40.55,Default,Spillik,0,0,0,,Wow.
Dialog: 0,0:21:41.25,0:21:42.99,Default,Spillie,0,0,0,,Sial, aku buntu.
Dialog: 0,0:21:44.72,0:21:46.66,Default,Spillik,0,0,0,,Jadi kamu tidak ingin aku pergi ke sana?
Dialog: 0,0:21:49.40,0:21:50.80,Default,Spillik,0,0,0,,Luar Biasa.
Dialog: 0,0:22:02.94,0:22:04.44,Default,Spillik,0,0,0,,Angkat kepalamu.
Dialog: 0,0:22:04.58,0:22:06.15,Default,Spilyk,0,0,0,,Luruskan punggungmu.
Dialog: 0,0:22:11.12,0:22:12.72,Default,Spilyk,0,0,0,,Bisakah kamu berenang?
Dialogue: 0,0:22:18.99,0:22:20.53,Default,Spillik,0,0,0,,Hanya itu saja?
Dialog: 0,0:22:20.63,0:22:24.76,Default,Spillik,0,0,0,,Saya akan melangkah lebih jauh, akan lebih dalam di sana.
Dialog: 0,0:22:24.76,0:22:26.87,Default,Spillik,0,0,0,,Oke, pindahkan.
Dialog: 0,0:22:32.31,0:22:34.07,Default,Spillie,0,0,0,,-Ayah. \N-Ya, ini dia!
Dialogue: 0,0:22:35.11,0:22:37.81,Default,Spillik,0,0,0,,Aku tersandung!
Dialog: 0,0:22:38.61,0:22:41.15,Default,Spillit,0,0,0,,-Nyebelin. \N-Yang Mulia.
Dialog: 0,0:22:42.15,0:22:46.02,Default,Spillik,0,0,0,,Janda Ratu memanggilmu untuk segera muncul.
Dialog: 0,0:22:46.02,0:22:47.99,Default,Spillik,0,0,0,,Untukmu!
Dialog: 0,0:22:48.42,0:22:51.86,Default,Spillik,0,0,0,,Lee Senman. Nama ini menjadi bumerang bagi saya.
Dialog: 0,0:22:51.96,0:22:53.43,Default,Spillit,0,0,0,,Sial.
Dialog: 0,0:22:53.43,0:22:56.06,Default,Spillik,0,0,0,,-Keajaiban. \N-Sungguh nikmat.
Dialog: 0,0:22:56.30,0:22:57.80,Default,Spillik,0,0,0,,Itu saja.
Dialog: 0,0:23:00.13,0:23:01.63,Default,Spillik,0,0,0,,Apa itu?
Dialogue: 0,0:23:01.77,0:23:05.17,Default,Spillik,0,0,0,,Apakah terkadang kamu juga merasakan hal ini?
Dialog: 0,0:23:05.94,0:23:09.24,Default,Spillik,0,0,0,,Saat semua orang sibuk, dan tak seorang pun peduli padamu.
Dialog: 0,0:23:10.08,0:23:13.08,Default,Spillik,0,0,0,,Pak, bagi saya anda adalah pusat alam semesta.
Dialog: 0,0:23:15.45,0:23:17.52,Default,Spillik,0,0,0,,Nah, orang sensitif seperti saya,
Dialog: 0,0:23:17.52,0:23:20.15,Default,Spillik,0,0,0,,terkadang mereka membuat kesalahan dalam firasatnya, seperti hari ini.
Dialog: 0,0:23:23.89,0:23:25.76,Default,Spillik,0,0,0,,Saya tidak memesan naengmyeon.
Dialog: 0,0:23:25.99,0:23:28.79,Default,Spillik,0,0,0,,Kamu membuatku bahagia setiap malam, izinkan aku melayanimu.
Dialog: 0,0:23:28.79,0:23:30.43,Default,Spillik,0,0,0,,Ini dari lubuk hatiku.
Dialog: 0,0:23:30.56,0:23:32.33,Default,Spillik,0,0,0,,Izinkan saya mengatakan sesuatu.
Dialogue: 0,0:23:32.33,0:23:35.30,Default,Spillik,0,0,0,,Sepertinya aku berkeliaran di sini untuk bersenang-senang, tapi bukan itu masalahnya.
Dialog: 0,0:23:37.77,0:23:42.01,Default,Spillik,0,0,0,,Saya di sini hanya untuk mencari tahu setidaknya sesuatu
Dialog: 0,0:23:42.01,0:23:44.18,Default,Spillik,0,0,0,,tentang Lee Senman yang tiba-tiba menghilang.
Dialogue: 0,0:23:44.64,0:23:49.01,Default,Spillik,0,0,0,,Tapi kenapa kamu begitu putus asa mencarinya?
Dialog: 0,0:23:49.22,0:23:52.55,Default,Spillik,0,0,0,,Rasanya seperti di balik kepergiannya
Dialog: 0,0:23:52.55,0:23:55.72,Default,Spillik,0,0,0,,ada rahasia penting.
Dialogue: 0,0:23:56.19,0:23:58.62,Default,Spillik,0,0,0,,Indra keenam memberitahuku,
Dialog: 0,0:23:59.19,0:24:01.63,Default,Spillik,0,0,0,,apa ini Lee Senman
Dialogue: 0,0:24:02.23,0:24:04.50,Default,Spillik,0,0,0,,di pusat permasalahan.
Dialog: 0,0:24:05.13,0:24:07.93,Default,Spillik,0,0,0,,-Apa masalahnya? \N-Saya tidak tahu.
Dialog: 0,0:24:08.47,0:24:09.87,Default,Spillik,0,0,0,,Apa?
Dialogue: 0,0:24:19.18,0:24:22.18,Default,Spillik,0,0,0,,Mereka sedang memeriksaku sekarang.
Dialogue: 0,0:24:23.05,0:24:26.15,Default,Spillik,0,0,0,,-Tentang hari ini... \N-Ini salahku.
Dialog: 0,0:24:31.62,0:24:34.89,Default,Spillik,0,0,0,,Aku memaksamu menikah dengannya di luar keinginanmu.
Dialog: 0,0:24:35.26,0:24:38.00,Default,Spillik,0,0,0,,Apakah kamu tidak benar-benar ingin menjadi seorang ratu?
Dialog: 0,0:24:38.00,0:24:40.17,Default,Spillik,0,0,0,, Sedemikian rupa sehingga kamu siap mengucapkan selamat tinggal pada kehidupan?
Dialog: 0,0:24:40.57,0:24:42.60,Default,Spillit,0,0,0,,Dan digulingkan sebagai ratu?
Dialog: 0,0:24:42.60,0:24:45.37,Default,Spillik,0,0,0,,Dia mencoba bunuh diri agar tidak menjadi ratu?
Dialog: 0,0:24:45.37,0:24:46.81,Default,Spillik,0,0,0,,Luar Biasa.
Dialog: 0,0:24:46.84,0:24:49.61,Default,Spillik,0,0,0,,Jika kamu sangat menginginkannya,\NI akan membiarkanmu meninggalkan istana.
Dialogue: 0,0:24:49.98,0:24:52.11,Default,Spillik,0,0,0,,Aku akan memecatmu.
Dialog: 0,0:24:52.61,0:24:55.31,Default,Spillie,0,0,0,,Kamu akan dipenjara di rumahmu
Dialog: 0,0:24:55.31,0:24:57.35,Default,Spillik,0,0,0,,dan kamu tidak akan keluar dari ambang batas selama sisa hidupmu.
Dialog: 0,0:24:57.35,0:24:58.38,Default,Spillik,0,0,0,,Tidak.
Dialog: 0,0:24:58.38,0:25:00.62,Default,Spillik,0,0,0,,Saya hanya bisa kembali melalui danau di sini.
Dialog: 0,0:25:00.62,0:25:03.79,Default,Spillik,0,0,0,,Saya tidak ingat ini.
Dialog: 0,0:25:03.79,0:25:06.96,Default,Spillik,0,0,0,,Setelah jatuh ke danau, aku lupa segalanya.
Dialog: 0,0:25:07.09,0:25:08.69,Default,Spillik,0,0,0,,Kenangan tidak kembali,
Dialogue: 0,0:25:08.69,0:25:11.56,Default,Spillik,0,0,0,,but did you remember that you wanted to commit suicide?
Dialog: 0,0:25:12.83,0:25:15.10,Default,Spillik,0,0,0,,Saya masih merasakan sakit.
Dialog: 0,0:25:15.13,0:25:17.87,Default,Spillik,0,0,0,,Dan saya yakin saya menyulam catatan ini.
Dialog: 0,0:25:18.04,0:25:21.61,Default,Spillik,0,0,0,,Tapi kenapa aku ingin bunuh diri, aku tidak tahu.
Dialog: 0,0:25:21.67,0:25:23.31,Default,Spillik,0,0,0,,Jika Anda tidak ingat apa pun,
Dialogue: 0,0:25:23.31,0:25:25.68,Default,Spillik,0,0,0,,kenapa kamu ikut campur?
Dialog: 0,0:25:28.38,0:25:30.08,Default,Spilyk,0,0,0,,Jika Anda tidak memberikan alasan,
Dialog: 0,0:25:30.12,0:25:32.59,Default,Spillik,0,0,0,,Saya akan berasumsi bahwa Anda menentang saya.
Dialog: 0,0:25:32.59,0:25:33.59,Default,Spillik,0,0,0,,Tidak.
Dialog: 0,0:25:33.59,0:25:36.29,Default,Spillik,0,0,0,,Dan aku tidak pernah berpikir untuk menolakmu.
Dialogue: 0,0:25:36.29,0:25:40.03,Default,Spillik,0,0,0,,Hari ini kamu melemahkan otoritasku.
Dialog: 0,0:25:40.39,0:25:41.89,Default,Spillik,0,0,0,,Saya perlu memperbaikinya.
Dialog: 0,0:25:41.89,0:25:44.73,Default,Spillik,0,0,0,,Tapi saya tidak punya solusinya. Sial, tidak ada yang terlintas dalam pikiran.
Dialog: 0,0:25:44.73,0:25:48.33,Default,Spillik,0,0,0,,Dan aku tidak bisa memaafkanmu untuk itu.
Dialog: 0,0:25:50.30,0:25:53.44,Default,Spillik,0,0,0,,Saya pantas mati, Yang Mulia.
Dialog: 0,0:25:53.74,0:25:56.24,Default,Spillie,0,0,0,,Ambil nyawaku.
Dialog: 0,0:25:56.58,0:25:59.11,Default,Spillik,0,0,0,,Saya bingung karena kurangnya ingatan,
Dialog: 0,0:25:59.11,0:26:00.88,Default,Spillik,0,0,0,,tapi aku tidak bisa berpaling dari jenisku
Dialog: 0,0:26:00.88,0:26:03.25,Default,Spillik,0,0,0,,dan dari suamiku.
Dialog: 0,0:26:03.85,0:26:05.75,Default,Spillie,0,0,0,,Tolong hukum saya,
Dialog: 0,0:26:05.75,0:26:09.92,Default,Spillie,0,0,0,,beri racun untuk menghilangkan rasa sakit ini.
Dialog: 0,0:26:13.03,0:26:15.86,Default,Spillik,0,0,0,,Mereka pasti tidak ingin menggulingkan ratu.
Dialogue: 0,0:26:15.86,0:26:18.13,Default,Spillik,0,0,0,,Apakah begitu mudah bagimu untuk menyerahkan hidupmu?
Dialog: 0,0:26:18.36,0:26:20.10,Default,Spillit,0,0,0,,Dia melemparkan dirinya ke dalam danau.
Dialogue: 0,0:26:20.10,0:26:21.83,Default,Spillik,0,0,0,,Sekarang kamu mau minum racun?
Dialogue: 0,0:26:21.83,0:26:24.34,Default,Spillik,0,0,0,,Kenapa kamu begitu lemah?
Dialog: 0,0:26:24.34,0:26:27.21,Default,Spillik,0,0,0,,Mereka ingin memastikan mereka mempunyai kekuasaan atas ratu.
Dialogue: 0,0:26:27.21,0:26:29.17,Default,Spillit,0,0,0,,Keputusan bodohku untuk mengucapkan selamat tinggal pada kehidupan
Dialog: 0,0:26:29.17,0:26:31.64,Default,Spillik,0,0,0,,menciptakan semua kesalahpahaman ini.
Dialog: 0,0:26:31.98,0:26:33.71,Default,Spillik,0,0,0,,Tindakanku pantas dihukum mati.
Dialog: 0,0:26:33.71,0:26:38.45,Default,Spillik,0,0,0,,Saya mohon Anda mengeksekusi saya, Yang Mulia.
Dialog: 0,0:26:38.45,0:26:41.35,Default,Spillik,0,0,0,,Kematianmu tidak akan memperbaiki apa pun.
Dialog: 0,0:26:41.35,0:26:42.42,Default,Spillik,0,0,0,,Karena trik ini
Dialog: 0,0:26:42.42,0:26:44.69,Default,Spillit,0,0,0,,Ibu Suri akan mendapat keuntungan.
Dialog: 0,0:26:44.69,0:26:46.89,Default,Spillik,0,0,0,,Tetapi ini tidak hanya akan mempengaruhi Anda.
Dialog: 0,0:26:46.89,0:26:51.06,Default,Spillik,0,0,0,,Ini akan mempengaruhi seluruh keluarga Kim.
Dialogue: 0,0:26:51.56,0:26:54.87,Default,Spillik,0,0,0,,-Akan kucoba... \N-Tolong tenang.
Dialog: 0,0:26:59.20,0:27:04.58,Default,Spillik,0,0,0,,Aku akan bertanya padamu untuk terakhir kalinya.
Dialog: 0,0:27:07.05,0:27:09.78,Default,Spillik,0,0,0,,Apakah kamu benar-benar ingin meninggalkan istana?
Dialog: 0,0:27:10.72,0:27:12.35,Default,Spilyk,0,0,0,,Saya ingin
Dialog: 0,0:27:14.35,0:27:15.99,Default,Spillik,0,0,0,,tinggal di istana.
Dialog: 0,0:27:17.69,0:27:20.13,Default,Spillik,0,0,0,,Bagaimana menurut Anda, Yang Mulia?
Dialogue: 0,0:27:29.34,0:27:32.57,Default,Spillik,0,0,0,,Karena aku tak punya kenangan lagi, aku akan menjadi orang baru.
Dialog: 0,0:27:35.64,0:27:38.71,Default,Spillit,0,0,0,,Aku akan menjadi ratu yang ideal.
Dialog: 0,0:27:41.21,0:27:44.48,Default,Spillik,0,0,0,,Saya tidak percaya janji kosong.
Dialogue: 0,0:27:44.48,0:27:46.35,Default,Spillik,0,0,0,,Akan saya buktikan di praktek.
Dialog: 0,0:27:48.25,0:27:50.96,Default,Spillik,0,0,0,,Tolong beri dia kesempatan, Yang Mulia.
Dialog: 0,0:27:53.83,0:27:55.06,Default,,0,0,0,,Oke.
Dialog: 0,0:27:55.06,0:27:58.80,Default,,0,0,0,,Terima kasih atas kebaikan Anda.
Dialog: 0,0:28:00.23,0:28:02.50,Default,,0,0,0,,Aku tidak akan mengganggumu lagi.
Dialog: 0,0:28:02.50,0:28:04.87,Default,,0,0,0,,Tidak ada yang perlu dikhawatirkan.
Dialogue: 0,0:28:08.27,0:28:09.41,Default,,0,0,0,,"Tinggalkan dirimu yang palsu"
Dialogue: 0,0:28:09.41,0:28:12.24,Default,,0,0,0,,Karena kelemahan kita sudah tidak ada lagi.
Dialog: 0,0:28:13.05,0:28:14.75,Default,,0,0,0,,Kami akan hilangkan
Dialogue: 0,0:28:17.38,0:28:19.22,Default,,0,0,0,,ada masalah.
Dialog: 0,0:28:31.03,0:28:32.90,Default,,0,0,0,,Dia akan melakukannya.
Dialog: 0,0:28:33.10,0:28:34.70,Default,,0,0,0,,Ini peringatan.
Dialog: 0,0:28:49.95,0:28:51.88,Default,,0,0,0,,Semuanya jadi tidak jelas.
Dialog: 0,0:28:53.55,0:28:55.85,Default,,0,0,0,,Nyalakan lentera lagi, Yang Mulia?
Dialog: 0,0:28:55.99,0:28:58.72,Default,,0,0,0,,Tidak. Ini aku sedang membicarakan masa depanku.
Dialog: 0,0:29:05.43,0:29:09.03,Default,,0,0,0,,Pangeran Yeonpyeong dan anak buahnya menggeledah istana.
Dialogue: 0,0:29:09.07,0:29:10.90,Default,,0,0,0,,Orangnya?
Dialogue: 0,0:29:11.07,0:29:13.11,Default,,0,0,0,,Apakah ini pengawal kerajaan?
Dialogue: 0,0:29:13.31,0:29:15.44,Default,,0,0,0,,Mereka terlatih dengan baik.
Dialog: 0,0:29:15.44,0:29:16.91,Default,,0,0,0,,Berapa?
Dialog: 0,0:29:17.28,0:29:18.88,Default,,0,0,0,,Sedikit.
Dialog: 0,0:29:19.58,0:29:21.85,Default,,0,0,0,,-Tujuh.\N-Selama ini
Dialogue: 0,0:29:21.85,0:29:25.05,Default,,0,0,0,,mereka diam-diam hanya melatih tujuh?
Dialogue: 0,0:29:28.55,0:29:30.46,Default,,0,0,0,,Kamu kehabisan obat.
Dialog: 0,0:29:30.49,0:29:34.03,Default,,0,0,0,,Jika bukan karena penyakit, kamu akan menjadi pejuang yang hebat.
Dialogue: 0,0:29:34.03,0:29:35.59,Default,,0,0,0,,Aku masih hidup
Dialog: 0,0:29:35.89,0:29:38.36,Default,,0,0,0,,hanya berkat bantuanmu.
Dialog: 0,0:29:38.96,0:29:40.43,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:29:45.90,0:29:49.01,Default,,0,0,0,,Jika kamu melakukan kesalahan lagi,
Dialog: 0,0:29:49.04,0:29:51.48,Default,,0,0,0,,Anda tidak akan menerima obat lagi.
Dialog: 0,0:29:52.11,0:29:53.71,Default,,0,0,0,,Saya akan ingat.
Dialog: 0,0:30:08.69,0:30:10.53,Default,,0,0,0,,Sampai saat ini
Dialog: 0,0:30:11.30,0:30:15.67,Default,,0,0,0,,kami mengira ratu jatuh ke danau untuk menjebak selir Cho.
Dialog: 0,0:30:16.14,0:30:20.51,Default,,0,0,0,,Kami yakin dia sengaja berbohong tentang kehilangan ingatannya.
Dialogue: 0,0:30:20.54,0:30:23.01,Default,,0,0,0,,Aku tidak percaya dia mencoba bunuh diri.
Dialogue: 0,0:30:23.01,0:30:26.21,Default,,0,0,0,,Mungkin inilah cara dia ingin mendapatkan kepercayaanmu.
Dialog: 0,0:30:26.41,0:30:29.55,Default,,0,0,0,,Apakah menurutmu dia tahu aku akan melindungi Selir Cho?
Dialog: 0,0:30:29.55,0:30:31.88,Default,,0,0,0,,Jangan membela dia,
Dialogue: 0,0:30:32.12,0:30:34.62,Default,,0,0,0,,ratu akan menyalahkannya.
Dialog: 0,0:30:34.62,0:30:36.39,Default,,0,0,0,,Dia mengerti,
Dialog: 0,0:30:36.79,0:30:39.29,Default,,0,0,0,,yang dapat memengaruhi Anda dengan cara ini.
Dialogue: 0,0:30:41.79,0:30:45.30,Default,,0,0,0,,Pangeran Yeonpyeong, begitulah
Dialog: 0,0:30:45.30,0:30:47.63,Default,,0,0,0,,ada niat jahat dalam setiap tindakan ratu.
Dialog: 0,0:30:47.63,0:30:49.20,Default,,0,0,0,,Ratu -
Dialog: 0,0:30:49.70,0:30:51.67,Default,,0,0,0,,dukungan keluarga Kim.
Dialogue: 0,0:30:52.37,0:30:54.34,Default,,0,0,0,,Orang macam apa mereka?
Dialogue: 0,0:30:54.47,0:30:57.84,Default,,0,0,0,,Merekalah yang membantai seluruh keluarga kami.
Dialog: 0,0:30:57.84,0:30:59.41,Default,,0,0,0,,Saya tidak pernah
Dialogue: 0,0:31:00.68,0:31:03.22,Default,,0,0,0,,Aku tidak bisa melupakan ini.
Dialogue: 0,0:31:05.35,0:31:07.35,Default,,0,0,0,,Aku juga tidak akan melupakan ini.
Dialogue: 0,0:31:07.59,0:31:10.02,Default,,0,0,0,,Tapi lihat apa yang dilakukan ratu.
Dialog: 0,0:31:10.12,0:31:13.83,Default,,0,0,0,,Meskipun aku berusaha membunuhnya dan permusuhanku dengan Selir Cho,
Dialog: 0,0:31:13.83,0:31:16.36,Default,,0,0,0,,dia mengungkapkan kebenaran demi kita.
Dialog: 0,0:31:17.06,0:31:20.80,Default,,0,0,0,,Masih memikirkan permusuhanmu terhadapnya
Dialog: 0,0:31:22.33,0:31:24.17,Default,,0,0,0,,pantas?
Dialog: 0,0:31:25.54,0:31:29.01,Default,,0,0,0,,-Yang Mulia.\N-Jika ini adalah percobaan bunuh diri,
Dialog: 0,0:31:29.01,0:31:31.88,Default,,0,0,0,,lalu aku membunuh ratu dua kali.
Dialog: 0,0:31:58.10,0:31:59.97,Default,,0,0,0,,Kenapa kamu ada di sini?
Dialogue: 0,0:31:59.97,0:32:02.57,Default,,0,0,0,,Aku perlu bicara denganmu.
Dialog: 0,0:32:02.57,0:32:05.04,Default,,0,0,0,,Kamu hanya memperumit segalanya.
Dialog: 0,0:32:05.24,0:32:08.38,Default,,0,0,0,,Nasibku sudah ada di tangan keluargamu.
Dialogue: 0,0:32:09.75,0:32:12.82,Default,,0,0,0,,Lain kali saya sampaikan saja suratnya.
Dialog: 0,0:32:13.69,0:32:15.42,Default,,0,0,0,,Kamu tidak menyukaiku,
Dialog: 0,0:32:16.42,0:32:18.52,Default,,0,0,0,,karena saya dari keluarga Andong Kim?
Dialog: 0,0:32:18.52,0:32:20.66,Default,,0,0,0,,Aku tidak bilang aku tidak menyukaimu.
Dialog: 0,0:32:20.83,0:32:22.89,Default,,0,0,0,,Lalu kamu menyukaiku?
Dialog: 0,0:32:30.40,0:32:33.14,Default,,0,0,0,,Jika saya bukan dari klan Andon Kim,
Dialog: 0,0:32:34.51,0:32:36.84,Default,,0,0,0,,apakah kamu menyukaiku?
Dialog: 0,0:32:37.34,0:32:39.11,Default,,0,0,0,,Tidak, menurutku tidak.
Dialogue: 0,0:32:39.14,0:32:42.15,Default,,0,0,0,,Kamu menjadi ratu berkat keluargamu.
Dialog: 0,0:32:43.68,0:32:46.32,Default,,0,0,0,,Saya berusaha keras.
Dialog: 0,0:32:46.62,0:32:49.42,Default,,0,0,0,,Aku tidak ingin menjadi ratu karena keluargaku.
Dialogue: 0,0:32:49.72,0:32:52.72,Default,,0,0,0,,Aku mengabdikan seluruh hidupku untuk ini, tak peduli apa kata mereka.
Dialogue: 0,0:32:53.83,0:32:57.26,Default,,0,0,0,,Besok kamu akan mendapatkan apa yang sangat kamu inginkan.
Dialog: 0,0:32:58.80,0:33:01.77,Default,,0,0,0,,Sudah larut, dan besok akan menjadi hari yang berat.
Dialog: 0,0:33:02.30,0:33:04.34,Default,,0,0,0,,Kembali ke kamarmu.
Dialog: 0,0:33:08.31,0:33:10.61,Default,,0,0,0,,Kamu harus mencintaiku.
Dialog: 0,0:33:15.45,0:33:17.78,Default,,0,0,0,,Apakah ini perintah?
Dialog: 0,0:33:24.22,0:33:28.99,Default,,0,0,0,,Ketidakpedulianku membuatnya melompat ke danau.
Dialog: 0,0:33:29.59,0:33:34.47,Default,,0,0,0,,Jika dia mencoba bunuh diri karena ketidakpedulianmu,
Dialog: 0,0:33:34.93,0:33:36.97,Default,,0,0,0,,dia akan melompat ke danau.
Dialog: 0,0:33:36.97,0:33:39.74,Default,,0,0,0,,Tapi dia memalsukan surat itu dan jatuh di depan Selir Cho.
Dialog: 0,0:33:39.74,0:33:42.24,Default,,0,0,0,,Saya melihat motif tersembunyi di sini.
Dialog: 0,0:33:42.91,0:33:44.41,Default,,0,0,0,,Motif, bicara.
Dialog: 0,0:33:46.21,0:33:48.51,Default,,0,0,0,,Saya perlu menemui ratu.
Dialog: 0,0:33:49.28,0:33:52.32,Default,,0,0,0,,Penjahat tidak menyembunyikan senyumnya.
Dialog: 0,0:33:52.38,0:33:55.19,Default,,0,0,0,,Jika ada motif tersembunyi dalam tindakannya,
Dialog: 0,0:33:56.42,0:33:59.26,Default,,0,0,0,,Aku tahu dari perilakunya.
Dialog: 0,0:33:59.69,0:34:03.09,Default,,0,0,0,,Jaga Selir Cho untuk saat ini.
Dialog: 0,0:34:23.62,0:34:26.65,Default,,0,0,0,,Berpura-pura menjadi ratu yang sempurna selama 15 hari.
Dialogue: 0,0:34:26.79,0:34:28.65,Default,,0,0,0,,Bisakah aku mengatasinya?
Dialog: 0,0:34:28.72,0:34:32.49,Default,,0,0,0,,Jika aku tidak bisa, maka aku akan tetap berada di tubuh yang menyesakkan ini,
Dialog: 0,0:34:32.62,0:34:36.63,Default,,0,0,0,,selain itu, di balik jeruji besi sebagai ratu yang digulingkan di era Joseon.
Dialogue: 0,0:34:41.07,0:34:44.34,Default,,0,0,0,,Aku menggali kuburku sendiri. Siapa lagi yang harus disalahkan?
Dialog: 0,0:34:44.60,0:34:48.97,Default,,0,0,0,,Yang Mulia, raja telah datang.
Dialogue: 0,0:34:48.97,0:34:53.01,Default,,0,0,0,,Tentu saja Cheoljong.\N Ini semua salahnya.
Dialogue: 0,0:34:53.25,0:34:56.42,Default,,0,0,0,,Aku tidak akan membela dia jika dia tidak begitu keren.
Dialog: 0,0:34:56.42,0:34:57.85,Default,,0,0,0,,Terbuka.
Dialog: 0,0:34:57.95,0:35:01.62,Default,,0,0,0,,Dan bahkan sebelum itu dia melakukan kesalahan total.
Dialogue: 0,0:35:04.09,0:35:05.59,Default,,0,0,0,,Wanita ini tidak mau mencoba
Dialog: 0,0:35:05.59,0:35:07.23,Default,,0,0,0,,tenggelam, jika dia lebih baik padanya.
Dialog: 0,0:35:07.23,0:35:09.93,Default,,0,0,0,,-Tidak, jika dia pernah melakukan ini sebelumnya...\N-Ratuku.
Dialog: 0,0:35:10.80,0:35:12.80,Default,,0,0,0,,Bagaimana perasaanmu?
Dialogue: 0,0:35:14.13,0:35:17.64,Default,,0,0,0,,Kau menaruh pedang di leherku,\N dari mana datangnya kekhawatiran ini?
Dialogue: 0,0:35:20.27,0:35:23.44,Default,,0,0,0,,Aku belum pernah mengalami satu hari pun yang tenang di sini.
Dialog: 0,0:35:23.44,0:35:25.58,Default,,0,0,0,,Aku baru saja membuka mata, dan besok adalah pernikahan.
Dialog: 0,0:35:25.58,0:35:28.61,Default,,0,0,0,,Suami yang berbagi selimut denganku mencoba membunuhku.
Dialog: 0,0:35:28.61,0:35:32.12,Default,,0,0,0,,Dan bahkan keluargaku sendiri\N mengancam akan menggulingkanku.
Dialog: 0,0:35:33.75,0:35:34.82,Default,,0,0,0,,Penggulingan?
Dialog: 0,0:35:34.82,0:35:36.66,Default,,0,0,0,,Apa? Menggoda?
Dialog: 0,0:35:36.66,0:35:40.56,Default,,0,0,0,,Kesempatan yang bagus untuk menggantikanku dengan Cho Hwajin, ya?
Dialog: 0,0:35:40.56,0:35:43.06,Default,,0,0,0,,Kenapa kamu begitu bersemangat?
Dialogue: 0,0:35:43.10,0:35:45.43,Default,,0,0,0,,Aku datang bukan untuk bertarung denganmu.
Dialogue: 0,0:35:45.43,0:35:48.23,Default,,0,0,0,,Hanya melihatmu membuatku marah.
Dialogue: 0,0:35:48.23,0:35:49.40,Default,,0,0,0,,Sudahkah kamu memikirkannya?
Dialogue: 0,0:35:49.40,0:35:51.07,Default,,0,0,0,,You who tried to kill me,
Dialog: 0,0:35:51.07,0:35:53.64,Default,,0,0,0,,dan orang yang kamu siap mati.
Dialogue: 0,0:35:54.14,0:35:56.31,Default,,0,0,0,,Aku hampir mati saat mencoba menyelamatkan kalian berdua.
Dialogue: 0,0:35:56.31,0:35:59.41,Default,,0,0,0,,Ya, mereka akan membunuhku sebelum aku bunuh diri.
Dialogue: 0,0:35:59.74,0:36:04.35,Default,,0,0,0,,Siapa pun di tempat saya akan marah sekarang jika dia bukan seorang Buddha.
Dialog: 0,0:36:06.15,0:36:08.39,Default,,0,0,0,,Saya mengerti bahwa Anda sangat marah kepada saya.
Dialog: 0,0:36:08.39,0:36:09.79,Default,,0,0,0,,Berhenti.
Dialog: 0,0:36:10.02,0:36:11.32,Default,,0,0,0,,Tidak perlu.
Dialog: 0,0:36:11.32,0:36:13.16,Default,,0,0,0,,Jangan berani bicara,
Dialog: 0,0:36:13.16,0:36:15.29,Default,,0,0,0,,bahwa Anda memahami saya.
Dialog: 0,0:36:17.46,0:36:19.06,Default,,0,0,0,,Kamu seharusnya mengerti aku
Dialogue: 0,0:36:19.06,0:36:22.33,Default,,0,0,0,,sebelum menaruh pedang di leherku.
Dialog: 0,0:36:22.37,0:36:26.20,Default,,0,0,0,,Tidak. Anda seharusnya sudah memahami wanita ini sebelumnya
Dialog: 0,0:36:26.54,0:36:30.21,Default,,0,0,0,,bagaimana dia mencoba bunuh diri.
Dialog: 0,0:36:31.44,0:36:34.68,Default,,0,0,0,,Momen telah berlalu. Tidak ada gunanya mengatakan apa pun.
Dialog: 0,0:36:35.61,0:36:39.48,Default,,0,0,0,,Sudah pergi. Saya lelah saat saya marah.
Dialogue: 0,0:36:41.95,0:36:44.86,Default,,0,0,0,,Aku akan kembali saat kamu sudah merasa lebih baik.
Dialogue: 0,0:36:46.89,0:36:50.33,Default,,0,0,0,,Jangan datang kecuali kamu siap untuk berlutut.
Dialogue: 0,0:36:52.60,0:36:54.27,Default,,0,0,0,,Aku akan kembali.
Dialog: 0,0:36:56.17,0:36:59.97,Default,,0,0,0,,Sudah kubilang jangan datang!
Dialogue: 0,0:37:30.60,0:37:33.37,Default,,0,0,0,,Apakah mereka memenuhi danau lagi?
Dialog: 0,0:37:34.24,0:37:38.28,Default,,0,0,0,,Yang Mulia menanyakan hal ini kepada Janda Ratu.
Dialog: 0,0:37:38.28,0:37:39.71,Default,,0,0,0,,Mengapa?
Dialog: 0,0:37:40.01,0:37:42.01,Default,,0,0,0,,Saya tidak tahu persisnya,
Dialog: 0,0:37:42.55,0:37:45.72,Default,,0,0,0,,tapi kudengar Yang Mulia pergi ke danau
Dialog: 0,0:37:45.72,0:37:49.22,Default,,0,0,0,,dan memantau semuanya secara pribadi.
Dialog: 0,0:38:04.20,0:38:05.67,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:38:06.47,0:38:08.84,Default,,0,0,0,,Maaf mengganggu anda.
Dialogue: 0,0:38:13.08,0:38:15.35,Default,,0,0,0,,Aku takut kehilanganmu.
Dialog: 0,0:38:19.42,0:38:21.49,Default,,0,0,0,,Apakah kamu tidak terluka?
Dialogue: 0,0:38:22.39,0:38:24.36,Default,,0,0,0,,Lukamu semakin sakit,
Dialog: 0,0:38:25.49,0:38:28.19,Default,,0,0,0,,daripada milikku.
Dialog: 0,0:38:30.50,0:38:32.06,Default,,0,0,0,,Hari ini
Dialog: 0,0:38:33.10,0:38:35.83,Default,,0,0,0,,sangat sulit bagimu.
Dialog: 0,0:38:36.57,0:38:40.67,Default,,0,0,0,,Maaf telah menyeretmu ke dalam hal ini.
Dialogue: 0,0:38:41.57,0:38:44.04,Default,,0,0,0,,Itu pasti sangat sulit bagimu
Dialog: 0,0:38:44.04,0:38:46.58,Default,,0,0,0,,karena semua masalah di istana ini.
Dialog: 0,0:38:46.58,0:38:49.08,Default,,0,0,0,,Aku tidak ingin kamu menderita.
Dialog: 0,0:38:49.55,0:38:52.08,Default,,0,0,0,,Jadi jangan lakukan itu lagi.
Dialog: 0,0:38:52.52,0:38:55.29,Default,,0,0,0,,Jika kamu mengorbankan dirimu untukku,
Dialog: 0,0:38:55.55,0:38:57.86,Default,,0,0,0,,bagaimana cara mengatasinya?
Dialog: 0,0:38:58.06,0:39:02.56,Default,,0,0,0,,Saya tidak akan melakukan apa yang Anda takuti.
Dialog: 0,0:39:03.73,0:39:05.90,Default,,0,0,0,,Sampai semuanya beres,
Dialog: 0,0:39:06.23,0:39:09.30,Default,,0,0,0,,Pangeran Yeonpyeong akan menjagamu secara pribadi.
Dialogue: 0,0:39:11.84,0:39:14.91,Default,,0,0,0,,Ada apa dengan Ovol?
Dialog: 0,0:39:15.21,0:39:17.61,Default,,0,0,0,,-Yah...\N-Tn. Hong telah tiba.
Dialog: 0,0:39:18.44,0:39:19.88,Default,,0,0,0,,Enter.
Dialog: 0,0:39:23.11,0:39:24.48,Default,,0,0,0,,Sebagai pelayan Selir Cho?
Dialog: 0,0:39:24.48,0:39:26.78,Default,,0,0,0,,Dia ada di rumah sakit sekarang.
Dialog: 0,0:39:28.62,0:39:30.69,Default,,0,0,0,,Adikku akan mengurus semuanya.
Dialog: 0,0:39:31.42,0:39:32.92,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:39:36.93,0:39:39.00,Default,,0,0,0,,Sudahkah kamu bertemu ratu?
Dialog: 0,0:39:40.20,0:39:41.23,Default,,0,0,0,,Ya.
Dialog: 0,0:39:41.23,0:39:43.90,Default,,0,0,0,,-Bagaimana kabarnya?\N-Dia marah.
Dialogue: 0,0:39:44.74,0:39:46.20,Default,,0,0,0,,-Apa?\N-Salahkan aku
Dialog: 0,0:39:46.20,0:39:48.27,Default,,0,0,0,,bahwa dia mendorongnya untuk bunuh diri.
Dialog: 0,0:39:48.27,0:39:51.18,Default,,0,0,0,,Benci aku karena mencoba membunuhnya.
Dialog: 0,0:39:51.18,0:39:53.38,Default,,0,0,0,,Emosi membanjiri dirinya.
Dialog: 0,0:39:53.51,0:39:55.58,Default,,0,0,0,,Jika dia ingin memenangkan hatiku,
Dialog: 0,0:39:55.58,0:39:57.25,Default,,0,0,0,,maka saya tidak akan bersikap seperti itu.
Dialog: 0,0:39:57.25,0:39:58.75,Default,,0,0,0,,Dan banyak lagi
Dialog: 0,0:39:59.05,0:40:02.02,Default,,0,0,0,,Keluarga Kim mengancam akan menggulingkannya.
Dialog: 0,0:40:02.82,0:40:05.29,Default,,0,0,0,,Kim Byungin belum tahu,
Dialog: 0,0:40:05.29,0:40:08.03,Default,,0,0,0,,potongan itu dari pakaianmu.
Dialog: 0,0:40:08.13,0:40:09.56,Default,,0,0,0,,Oke.
Dialogue: 0,0:40:10.13,0:40:12.36,Default,,0,0,0,,Sang Ratu diam saja.
Dialog: 0,0:40:12.36,0:40:14.20,Default,,0,0,0,,Saya tidak tahu niatnya,
Dialog: 0,0:40:14.43,0:40:17.10,Default,,0,0,0,,tetapi tampaknya bertindak sendiri.
Dialog: 0,0:40:18.00,0:40:19.47,Default,,0,0,0,,Saya pikir saya akan mengerti,
Dialog: 0,0:40:19.47,0:40:22.54,Default,,0,0,0,,orang seperti apa dia, berdasarkan tindakannya.
Dialog: 0,0:40:23.71,0:40:25.48,Default,,0,0,0,,Tapi dia hanya membuatku semakin bingung.
Dialog: 0,0:40:32.65,0:40:34.82,Default,,0,0,0,,Ayah, ini Benin.
Dialog: 0,0:40:34.82,0:40:36.45,Default,,0,0,0,,Ya. Masuk.
Dialogue: 0,0:40:46.56,0:40:49.13,Default,,0,0,0,,Kukira kamu sudah berhenti merokok.
Dialog: 0,0:40:49.87,0:40:51.34,Default,,0,0,0,,Ditinggalkan.
Dialogue: 0,0:40:58.48,0:41:00.51,Default,,0,0,0,,Maaf soal hari ini.
Dialogue: 0,0:41:01.48,0:41:03.51,Default,,0,0,0,,Kenapa kamu minta maaf?
Dialog: 0,0:41:04.08,0:41:06.32,Default,,0,0,0,,Apa yang akan kamu lakukan selanjutnya?
Dialogue: 0,0:41:07.15,0:41:09.09,Default,,0,0,0,,Aku akan mencoba bertukar pikiran dengannya.
Dialog: 0,0:41:09.09,0:41:12.09,Default,,0,0,0,,Dan jika dia tidak mengerti, dia tidak akan ada.
Dialog: 0,0:41:13.46,0:41:16.26,Default,,0,0,0,,Siapa yang kamu bicarakan?
Dialog: 0,0:41:17.03,0:41:18.73,Default,,0,0,0,,Tentang siapa pun.
Dialog: 0,0:41:18.73,0:41:21.37,Default,,0,0,0,,Sekutu selama berabad-abad tidak ada.
Dialog: 0,0:41:24.77,0:41:28.14,Default,,0,0,0,,Saya khawatir sekarang bukan waktunya untuk ini,
Dialog: 0,0:41:28.37,0:41:30.27,Default,,0,0,0,,tapi aku harus memberitahumu.
Dialog: 0,0:41:30.78,0:41:32.34,Default,,0,0,0,,Oke. Apa yang ada disana?
Dialog: 0,0:41:32.81,0:41:36.95,Default,,0,0,0,,Aku memutuskan seberapa jauh aku akan mewujudkan impianku.
Dialog: 0,0:41:37.18,0:41:39.65,Default,,0,0,0,,Senang sekali mendengarnya.
Dialog: 0,0:41:39.98,0:41:41.39,Default,,0,0,0,,Posisi apa?
Dialog: 0,0:41:41.39,0:41:43.49,Default,,0,0,0,,Saya akan menjadi kepala Departemen Detektif.
Dialog: 0,0:41:43.66,0:41:45.42,Default,,0,0,0,,Departemen detektif?
Dialogue: 0,0:41:45.99,0:41:49.26,Default,,0,0,0,,Menjadi pejuang adalah segalanya yang kamu impikan?
Dialog: 0,0:41:49.26,0:41:52.60,Default,,0,0,0,,Saya akan mulai dengan posisi yang bisa saya tangani,
Dialogue: 0,0:41:52.60,0:41:54.63,Default,,0,0,0,,dan aku akan memilih jalanku.
Dialog: 0,0:41:54.90,0:41:56.30,Default,,0,0,0,,Benarkah?
Dialog: 0,0:41:58.04,0:42:01.34,Default,,0,0,0,,Kamu bilang ingin memilih jalanmu sendiri?
Dialog: 0,0:42:10.58,0:42:12.95,Default,,0,0,0,,Selir kerajaan telah tiba.
Dialog: 0,0:42:15.22,0:42:17.02,Default,,0,0,0,,Jangan bergerak.
Dialog: 0,0:42:23.50,0:42:24.93,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:42:30.47,0:42:31.90,Default,,0,0,0,,Maaf.
Dialogue: 0,0:42:32.50,0:42:35.37,Default,,0,0,0,,Aku harus berdiri sampai akhir.
Dialogue: 0,0:42:36.17,0:42:38.84,Default,,0,0,0,,Patah lututmu adalah buktinya.
Dialog: 0,0:42:39.64,0:42:41.11,Default,,0,0,0,,Saya tahu.
Dialog: 0,0:42:42.65,0:42:44.58,Default,,0,0,0,,Ini bukan apa-apa.
Dialog: 0,0:42:45.18,0:42:47.39,Default,,0,0,0,,Beberapa hari dengan ramuan obat,
Dialogue: 0,0:42:47.39,0:42:50.05,Default,,0,0,0,,dan aku akan segera bangun.
Dialog: 0,0:42:50.79,0:42:54.26,Default,,0,0,0,,Ya. Saya yakin Anda akan menjadi lebih baik.
Dialogue: 0,0:42:55.89,0:42:58.20,Default,,0,0,0,,Siapa yang bisa memperlakukanmu begitu kejam?
Dialog: 0,0:42:58.86,0:43:02.17,Default,,0,0,0,,Saya tidak melihat wajahnya, dia memakai topeng.
Dialogue: 0,0:43:03.33,0:43:05.74,Default,,0,0,0,,Tapi aku ingat suaranya.
Dialog: 0,0:43:06.70,0:43:08.14,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:43:08.94,0:43:10.54,Default,,0,0,0,,Maaf mengatakan ini.
Dialog: 0,0:43:10.98,0:43:13.18,Default,,0,0,0,,Jika seseorang yang bukan dari keluarga kerajaan terluka,
Dialog: 0,0:43:13.21,0:43:15.41,Default,,0,0,0,,dia tidak bisa tinggal di istana.
Dialogue: 0,0:43:15.85,0:43:18.72,Default,,0,0,0,,Tapi bagaimana dia bisa pergi dalam keadaan seperti itu?
Dialog: 0,0:43:18.72,0:43:20.95,Default,,0,0,0,,Ini adalah adat istiadat istana.
Dialog: 0,0:43:21.65,0:43:24.49,Default,,0,0,0,,Tidak ada belas kasihan di tempat ini.
Dialog: 0,0:43:31.20,0:43:33.16,Default,,0,0,0,,Jika ada yang sedang dalam perjalanan
Dialog: 0,0:43:33.36,0:43:35.97,Default,,0,0,0,,akan mencoba menyakitimu, gunakan itu sebagai suap.
Dialog: 0,0:43:36.20,0:43:38.04,Default,,0,0,0,,Berhasil meninggalkan istana,
Dialog: 0,0:43:38.04,0:43:39.80,Default,,0,0,0,,manfaatkan ini untuk hidup nyaman.
Dialog: 0,0:43:39.80,0:43:41.87,Default,,0,0,0,,Tidak, terlalu banyak.
Dialog: 0,0:43:42.64,0:43:44.81,Default,,0,0,0,,Saya akan mengirimkan surat kepada keluarga saya.
Dialog: 0,0:43:44.88,0:43:46.61,Default,,0,0,0,,Jangan khawatir.
Dialog: 0,0:43:49.55,0:43:52.68,Default,,0,0,0,,Terima kasih atas layanan Anda.
Dialogue: 0,0:43:53.15,0:43:56.25,Default,,0,0,0,,Aku terlalu malu melihat wajah Pak Cho.
Dialog: 0,0:43:56.96,0:43:58.56,Default,,0,0,0,,Saya tidak bisa pergi.
Dialog: 0,0:43:59.62,0:44:03.26,Default,,0,0,0,,Ovol, kamu dan aku tumbuh bersama.
Dialog: 0,0:44:03.66,0:44:06.00,Default,,0,0,0,,Kamu adalah keluargaku.
Dialog: 0,0:44:06.80,0:44:08.50,Default,,0,0,0,,Kamu harus bertahan di sana,
Dialog: 0,0:44:09.07,0:44:10.67,Default,,0,0,0,,jadi saya juga bisa.
Dialogue: 0,0:44:11.90,0:44:14.31,Default,,0,0,0,,Beranilah untukku.
Dialog: 0,0:44:14.91,0:44:16.51,Default,,0,0,0,,Kamu harus hidup.
Dialogue: 0,0:44:18.28,0:44:19.94,Default,,0,0,0,,Lakukan untukku.
Dialogue: 0,0:44:49.71,0:44:52.18,Default,,0,0,0,,-Apa yang terjadi?\N -Kemarin rumah sakit jiwa.
Dialog: 0,0:44:52.18,0:44:53.78,Default,,0,0,0,,Ratu...
Dialog: 0,0:44:56.45,0:44:57.92,Default,,0,0,0,,Tuanku.
Dialog: 0,0:44:58.62,0:45:00.18,Default,,0,0,0,,Pernah dengar?
Dialog: 0,0:45:00.18,0:45:03.49,Default,,0,0,0,,Yang Mulia melemparkan guntur dan kilat ke arah Janda Ratu dengan matanya.
Dialogue: 0,0:45:03.49,0:45:05.29,Default,,0,0,0,,Matanya seperti apel.
Dialog: 0,0:45:06.76,0:45:08.66,Default,,0,0,0,,Hai kamu.
Dialog: 0,0:45:08.93,0:45:12.76,Default,,0,0,0,,Yang Mulia menjemputnya tepat di depan ratu dan...
Dialogue: 0,0:45:15.57,0:45:17.77,Default,,0,0,0,,Koki kerajaan, pernah dengar?
Dialog: 0,0:45:17.77,0:45:21.71,Default,,0,0,0,,Yang Mulia mengambil pedang,\Ndan ratu janda...
Dialog: 0,0:45:24.34,0:45:25.88,Default,,0,0,0,,Apakah kamu dengar ada sesuatu di Aula Tongunjeong?
Dialogue: 0,0:45:25.88,0:45:27.71,Default,,0,0,0,,Kudengar mereka melakukan ini sepanjang waktu.
Dialog: 0,0:45:42.73,0:45:46.60,Default,,0,0,0,,Kepala Departemen Detektif akan ditunjuk hari ini.
Dialogue: 0,0:45:46.80,0:45:48.30,Default,,0,0,0,,Benarkah?
Dialog: 0,0:45:49.63,0:45:51.74,Default,,0,0,0,,Kami memiliki permintaan penugasan.
Dialog: 0,0:45:52.10,0:45:53.47,Default,,0,0,0,,Dan siapa yang direkomendasikan
Dialog: 0,0:45:53.47,0:45:56.37,Default,,0,0,0,,untuk jabatan kepala Departemen Detektif?
Dialog: 0,0:45:56.37,0:45:59.51,Default,,0,0,0,,Byonin dari klan Andong Kim.
Dialog: 0,0:46:05.52,0:46:07.89,Default,,0,0,0,,Agak tak terduga.
Dialog: 0,0:46:07.92,0:46:10.32,Default,,0,0,0,,Saya yakin ada banyak kandidat untuk posisi ini.
Dialog: 0,0:46:10.32,0:46:13.59,Default,,0,0,0,,Jika saya menunjuk sebagai kepala seseorang yang telah lulus ujian pegawai negeri,
Dialog: 0,0:46:13.59,0:46:15.36,Default,,0,0,0,,akan ada keluhan ya?
Dialog: 0,0:46:15.36,0:46:18.73,Default,,0,0,0,,Kami dengan suara bulat setuju\N dengan rekomendasi ini.
Dialog: 0,0:46:20.43,0:46:22.10,Default,,0,0,0,,Dengan suara bulat?
Dialog: 0,0:46:22.70,0:46:27.17,Default,,0,0,0,,Saya tidak mengharapkan hubungan harmonis di antara subjek saya.
Dialog: 0,0:46:28.17,0:46:32.21,Default,,0,0,0,,Kudengar dia orang yang luar biasa.
Dialogue: 0,0:46:36.58,0:46:39.68,Default,,0,0,0,,Apakah Pemberitahuan Penunjukan Kerajaan sudah disiapkan?
Dialogue: 0,0:46:40.02,0:46:44.56,Default,,0,0,0,,Untuk mengikuti keputusan cepatmu,
Dialogue: 0,0:46:44.56,0:46:47.32,Default,,0,0,0,,mungkin aku harus mengurangi waktu tidurku.
Dialog: 0,0:46:47.46,0:46:49.43,Default,,0,0,0,,Jangan katakan itu.
Dialogue: 0,0:46:49.43,0:46:52.56,Default,,0,0,0,,Kamu harus menjaga kesehatanmu\Ndan menghasilkan ahli waris.
Dialog: 0,0:46:53.76,0:46:57.60,Default,,0,0,0,,Bukan raja, tapi kuda pembiakan.
Dialogue: 0,0:47:12.02,0:47:18.02,Default,,0,0,0,,Kamu selalu rendah hati. \NDjangan sampai hilang - kerendahan hati.
Dialog: 0,0:47:18.09,0:47:20.96,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:47:30.27,0:47:32.04,Default,,0,0,0,,Klan Pungyang Cho
Dialogue: 0,0:47:32.04,0:47:34.37,Default,,0,0,0,, membawa masalah pada diriku sendiri.
Dialog: 0,0:47:34.37,0:47:36.84,Default,,0,0,0,,Karena pengakuan palsu selir
Dialog: 0,0:47:37.61,0:47:40.04,Default,,0,0,0,,kami telah mengalami penghinaan seperti itu.
Dialog: 0,0:47:47.22,0:47:51.26,Default,,0,0,0,,Kegagalan adalah sebab, bukan akibat.
Dialog: 0,0:47:51.39,0:47:52.82,Default,,0,0,0,,Apa?
Dialog: 0,0:47:53.09,0:47:55.96,Default,,0,0,0,,Demikian kata Ibu Suri.
Dialog: 0,0:47:56.29,0:47:58.50,Default,,0,0,0,,Kami setuju dengan penunjukan Kim Byungin
Dialog: 0,0:47:58.50,0:48:01.90,Default,,0,0,0,,dan membantu mereka memperkuat posisi mereka,
Dialog: 0,0:48:02.20,0:48:04.13,Default,,0,0,0,,karena kita kalah.
Dialogue: 0,0:48:04.14,0:48:07.30,Default,,0,0,0,,Semakin banyak kekalahan, semakin kecil\N peluang kita untuk menang.
Dialog: 0,0:48:07.47,0:48:08.94,Default,,0,0,0,,Dia berkata,
Dialog: 0,0:48:09.67,0:48:12.48,Default,,0,0,0,,kita harus mengambil langkah pertama.
Dialog: 0,0:48:40.20,0:48:42.41,Default,,0,0,0,,Apakah menurut Anda Ovol akan dapat pulih?
Dialogue: 0,0:48:42.41,0:48:44.38,Default,,0,0,0,,Aku akan memeriksa perasaannya.
Dialog: 0,0:48:44.38,0:48:47.44,Default,,0,0,0,,Dia aktif, jadi dia terus-menerus bergegas.
Dialogue: 0,0:48:48.55,0:48:51.25,Default,,0,0,0,,Sekarang hal itu tidak bisa dilakukan.
Dialog: 0,0:48:52.05,0:48:54.85,Default,,0,0,0,,Jika dia tidak datang ke istana bersamaku,..
Dialogue: 0,0:48:56.92,0:48:58.89,Default,,0,0,0,,Jangan terlalu sering memikirkannya.
Dialogue: 0,0:48:59.12,0:49:01.29,Default,,0,0,0,,Terkadang pikiran bisa membawamu ke rawa.
Dialogue: 0,0:49:01.89,0:49:04.80,Default,,0,0,0,,Dan semakin keras kamu bertarung, semakin dalam pertarungannya. \NIItu akan lebih menyakitkan lagi.
Dialog: 0,0:49:06.66,0:49:08.43,Default,,0,0,0,,Apa yang kamu lakukan,
Dialog: 0,0:49:08.47,0:49:11.30,Default,,0,0,0,,untuk menjernihkan pikiran dari banyaknya pikiran?
Dialog: 0,0:49:11.70,0:49:13.17,Default,,0,0,0,,I
Dialog: 0,0:49:14.51,0:49:16.41,Default,,0,0,0,,pergi ke Tuan Hong.
Dialog: 0,0:49:16.74,0:49:18.94,Default,,0,0,0,,Dia bisa menghiburmu.
Dialogue: 0,0:49:18.94,0:49:21.71,Default,,0,0,0,,Dia bodoh sekali.
Dialogue: 0,0:49:22.41,0:49:24.52,Default,,0,0,0,,Membuatku kesal.
Dialogue: 0,0:49:24.72,0:49:26.42,Default,,0,0,0,,Dan saat aku melampiaskan amarahku padanya,
Dialog: 0,0:49:27.92,0:49:30.55,Default,,0,0,0,,lalu aku keluar dari rawa tanpa menyadarinya.
Dialog: 0,0:49:33.82,0:49:38.03,Default,,0,0,0,,Lalu bisakah kamu membuatku marah?
Dialog: 0,0:49:40.26,0:49:42.70,Default,,0,0,0,,-Ini...\T-Atau...
Dialog: 0,0:50:33.88,0:50:35.89,Default,,0,0,0,,Jangan bergerak.
Dialogue: 0,0:50:54.17,0:50:55.74,Default,,0,0,0,,Saya sudah selesai.
Dialog: 0,0:51:00.24,0:51:01.65,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:51:01.65,0:51:04.85,Default,,0,0,0,,No problem.
Dialog: 0,0:51:08.05,0:51:09.65,Default,,0,0,0,,Apakah ada yang sakit?
Dialog: 0,0:51:10.92,0:51:13.99,Default,,0,0,0,,Kamu tidak bisa menyentuhku.
Dialog: 0,0:51:17.86,0:51:20.96,Default,,0,0,0,,Aku kram.
Dialog: 0,0:51:22.47,0:51:25.30,Default,,0,0,0,,Lama sekali ya?
Dialogue: 0,0:51:25.30,0:51:26.84,Default,,0,0,0,,Syukurlah.
Dialog: 0,0:51:28.11,0:51:30.64,Default,,0,0,0,,Kamu terlalu fokus hingga lupa waktu.
Dialogue: 0,0:51:44.86,0:51:48.06,Default,,0,0,0,,Jika kamu ingin menyulam,\Nmaka kamu harus pergi ke Daejojeon Hall.
Dialogue: 0,0:51:48.06,0:51:50.63,Default,,0,0,0,,Apa yang kamu lupakan di dapur?
Dialogue: 0,0:51:56.40,0:51:59.10,Default,,0,0,0,,Apakah kamu benar-benar menyulam sesuatu?
Dialog: 0,0:52:01.94,0:52:04.78,Default,,0,0,0,,Aku berjanji akan mengubah diriku menjadi ratu teladan.
Dialog: 0,0:52:06.24,0:52:08.11,Default,,0,0,0,,Teladan, kan?
Dialog: 0,0:52:09.85,0:52:12.98,Default,,0,0,0,,Tidak ada hubungannya? Beri aku pekerjaan?
Dialog: 0,0:52:12.98,0:52:14.72,Default,,0,0,0,,Punggungku.
Dialogue: 0,0:52:15.05,0:52:17.42,Default,,0,0,0,,Dan kapan aku bisa memikirkan semua ini?
Dialog: 0,0:52:19.16,0:52:20.72,Default,,0,0,0,,Apa itu?
Dialog: 0,0:52:23.06,0:52:25.70,Default,,0,0,0,,-Enter.\N-Tunggu.
Dialog: 0,0:52:34.84,0:52:36.97,Default,,0,0,0,,Apakah ini dari Aula Dongmyeongjong?
Dialog: 0,0:52:36.97,0:52:38.71,Default,,0,0,0,,-Ya, Yang Mulia. \N-Ayo.
Dialog: 0,0:52:44.48,0:52:46.62,Default,,0,0,0,,Dia mencoba masakanku,
Dialog: 0,0:52:46.62,0:52:49.09,Default,,0,0,0,,yang lama terasa membosankan baginya sekarang.
Dialog: 0,0:53:00.03,0:53:02.13,Default,,0,0,0,,Oke. Bawa ini ke istal.
Dialog: 0,0:53:02.13,0:53:05.90,Default,,0,0,0,,Jika mereka menutupi tandu makanan dengan selimut sebesar ini,
Dialog: 0,0:53:05.90,0:53:07.54,Default,,0,0,0,,makanan tidak akan dingin.
Dialog: 0,0:53:07.54,0:53:09.37,Default,,0,0,0,,Suruh mereka mencoba.
Dialog: 0,0:53:09.37,0:53:10.84,Default,,0,0,0,,Oke.
Dialog: 0,0:53:14.14,0:53:16.48,Default,,0,0,0,,Maukah kamu bergegas ke danau segera setelah kamu menyingkirkanku?
Dialogue: 0,0:53:16.65,0:53:19.48,Default,,0,0,0,,Pernahkah kamu melihat seseorang bekerja begitu keras saat mereka akan mati?
Dialog: 0,0:53:19.65,0:53:22.05,Default,,0,0,0,,Dan sepertinya kamu lupa,\Nini sudah menjadi norma,
Dialog: 0,0:53:22.05,0:53:24.29,Default,,0,0,0,,tapi aku di bawah kamera pengintai.
Dialog: 0,0:53:32.83,0:53:34.83,Default,,0,0,0,,Apa yang kamu khawatirkan?
Dialogue: 0,0:53:40.27,0:53:44.07,Default,,0,0,0,,Baiklah, mari kita ciptakan keajaiban?
Dialog: 0,0:53:53.02,0:53:54.52,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:53:55.39,0:53:56.82,Default,,0,0,0,,Ya!
Dialog: 0,0:54:06.90,0:54:08.37,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:54:08.67,0:54:10.90,Default,,0,0,0,,Halo. Apakah kamu sudah memotong dagingnya?
Dialog: 0,0:54:10.90,0:54:12.40,Default,,0,0,0,,Ya.
Dialog: 0,0:54:12.77,0:54:14.34,Default,,0,0,0,,Segera sampai di sini.
Dialogue: 0,0:54:15.61,0:54:17.54,Default,,0,0,0,,Bawakan aku garam.
Dialog: 0,0:54:17.54,0:54:20.01,Default,,0,0,0,,Ratu ingin aku melayaninya terlebih dahulu.
Dialog: 0,0:54:27.12,0:54:28.59,Default,,0,0,0,,Wow.
Dialogue: 0,0:54:29.75,0:54:32.12,Default,,0,0,0,,Baiklah, lakukan sesukamu.
Dialog: 0,0:54:32.92,0:54:34.93,Default,,0,0,0,,Mari kita lihat apa yang terjadi.
Dialogue: 0,0:54:45.00,0:54:48.04,Default,,0,0,0,,Haruskah aku meminta ratu memasak?
Dialog: 0,0:54:50.04,0:54:53.61,Default,,0,0,0,,Yang Mulia, ini Kepala Inspektur.
Dialog: 0,0:54:53.61,0:54:57.78,Default,,0,0,0,,Ratu telah menyiapkan makan siang untukmu.
Dialog: 0,0:55:01.25,0:55:03.79,Default,,0,0,0,,Suruh dia mengambilnya?
Dialog: 0,0:55:06.56,0:55:07.99,Default,,0,0,0,,Ibu.
Dialog: 0,0:55:07.99,0:55:09.53,Default,,0,0,0,,Apa itu?
Dialog: 0,0:55:11.16,0:55:14.16,Default,,0,0,0,,Nah, tidak ada kelezatannya sama sekali.
Dialog: 0,0:55:16.60,0:55:18.07,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:55:18.17,0:55:21.77,Default,,0,0,0,,Makan siangmu sudah tiba, tapi...
Dialog: 0,0:55:35.65,0:55:37.39,Default,,0,0,0,,Hati-hati.
Dialog: 0,0:55:40.72,0:55:43.26,Default,,0,0,0,,Dan ini...
Dialog: 0,0:56:08.69,0:56:11.05,Default,,0,0,0,,Ratu mengatakan itu
Dialog: 0,0:56:11.05,0:56:16.93,Default,,0,0,0,,topik makan siang hari ini adalah HSNV.
Dialog: 0,0:56:17.63,0:56:20.06,Default,,0,0,0,,HSNV?
Dialog: 0,0:56:21.13,0:56:23.50,Default,,0,0,0,,Saya belum pernah mendengarnya sebelumnya.
Dialogue: 0,0:56:23.50,0:56:25.07,Default,,0,0,0,,Apakah ini Mencius?
Dialog: 0,0:56:25.17,0:56:28.51,Default,,0,0,0,,Tidak, bukan itu. \NMungkin dari Analects of Confucius?
Dialog: 0,0:56:29.21,0:56:30.57,Default,,0,0,0,,Artinya
Dialog: 0,0:56:30.57,0:56:34.24,Default,,0,0,0,,makanan renyah di luar
Dialog: 0,0:56:34.24,0:56:36.45,Default,,0,0,0,,dan empuk di dalam.
Dialog: 0,0:56:37.41,0:56:39.92,Default,,0,0,0,,Benarkah?
Dialog: 0,0:56:49.76,0:56:51.19,Default,,0,0,0,,Tandu berisi makanan telah tiba!
Dialog: 0,0:57:03.77,0:57:06.04,Default,,0,0,0,,Di Sini. Ambil piringnya.
Dialog: 0,0:57:09.88,0:57:11.48,Default,,0,0,0,,Hati-hati.
Dialog: 0,0:57:14.45,0:57:15.85,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:57:16.09,0:57:19.26,Default,,0,0,0,,Dia sangat senang dan memujimu.
Dialog: 0,0:57:21.26,0:57:24.03,Default,,0,0,0,,Saya melihat tandu untuk dimakan
Dialog: 0,0:57:24.03,0:57:26.46,Default,,0,0,0,,dan bertanya bagaimana Anda mendapatkan ide yang begitu bagus.
Dialog: 0,0:57:26.46,0:57:28.30,Default,,0,0,0,,Tunggulnya jelas, hasilnya jelas.
Dialogue: 0,0:57:28.30,0:57:31.53,Default,,0,0,0,,Benda ini populer\Ndi kompetisi Korea.
Dialog: 0,0:57:33.54,0:57:35.71,Default,,0,0,0,,Pengantar Joseon.
Dialog: 0,0:57:36.91,0:57:40.68,Default,,0,0,0,,Oh, betapa bangganya aku pada diriku sendiri.
Dialog: 0,0:57:42.05,0:57:43.95,Default,,0,0,0,,Secara umum, wanita dari keluarga kerajaan
Dialog: 0,0:57:43.95,0:57:45.05,Default,,0,0,0,,harus selalu sederhana.
Dialog: 0,0:57:45.05,0:57:46.48,Default,,0,0,0,,Kamu ada di saya
Dialogue: 0,0:57:46.65,0:57:48.59,Default,,0,0,0,,apakah kamu sedang menggerutu sekarang, atau bagaimana?
Dialogue: 0,0:57:49.49,0:57:53.92,Default,,0,0,0,,Haruskah kita bersikap rendah hati? \NItulah pertanyaannya.
Dialog: 0,0:57:54.32,0:57:57.86,Default,,0,0,0,,Tidak. Hidup itu sulit, bahkan jika Anda hidup dengan harga diri.
Dialog: 0,0:58:00.23,0:58:03.37,Default,,0,0,0,,Aku tidak tahu apa yang dia bicarakan,\Ntapi itu tetap membuatku marah.
Dialog: 0,0:58:04.33,0:58:08.21,Default,nanas,0,0,0,,Kita seharusnya senang Ovol mampu bertahan.
Dialog: 0,0:58:08.21,0:58:10.27,Default,nanas,0,0,0,,Ini adalah secercah harapan di tengah kegelapan kegagalan.
Dialogue: 0,0:58:11.41,0:58:14.71,Default,pineapple,0,0,0,,I’m sure after what happened
Dialog: 0,0:58:14.71,0:58:17.98,Default,nanas,0,0,0,,kamu sekarang lebih memahami orang seperti apa klan Kim itu.
Dialogue: 0,0:58:18.28,0:58:21.49,Default,pineapple,0,0,0,,Saya kira mereka belum siap melangkah sejauh itu.
Dialog: 0,0:58:21.49,0:58:23.65,Default,nanas,0,0,0,,Kamu pasti takut.
Dialog: 0,0:58:23.65,0:58:26.86,Default,nanas,0,0,0,,Namun, ini hanyalah permulaan.
Dialog: 0,0:58:27.36,0:58:33.10,Default,nanas,0,0,0,,Mereka tidak akan melupakan kekalahan ini.
Dialog: 0,0:58:34.63,0:58:39.00,Default,nanas,0,0,0,,Ada rumor bahwa mendiang raja tidak meninggal karena sakit.
Dialog: 0,0:58:40.74,0:58:42.17,Default,nanas,0,0,0,,Ternyata...
Dialog: 0,0:58:44.27,0:58:48.68,Default,nanas,0,0,0,,Dia percaya bahwa klan Kim adalah bisul di tubuh Joseon.
Dialogue: 0,0:58:49.51,0:58:51.28,Default,nanas,0,0,0,,Tahukah kamu apa kesalahanmu?
Dialog: 0,0:58:51.28,0:58:52.95,Default,nanas,0,0,0,,Dia merampas kekuasaan Kim Hong-geun
Dialog: 0,0:58:52.95,0:58:54.52,Default,nanas,0,0,0,,dan menjatuhkan hukuman pengasingan.
Dialog: 0,0:58:54.52,0:58:57.95,Default,nanas,0,0,0,,Raja merevisi undang-undang suap,
Dialog: 0,0:58:58.69,0:58:59.86,Default,nanas,0,0,0,,jadi begitu
Dialog: 0,0:58:59.86,0:59:02.99,Default,nanas,0,0,0,,melintasi jalur klan Kim.
Dialog: 0,0:59:03.66,0:59:06.86,Default,nanas,0,0,0,,Mereka bukan tipe orang\Nyang akan duduk diam.
Dialog: 0,0:59:12.50,0:59:13.54,Default,nanas,0,0,0,,Untungnya,
Dialog: 0,0:59:13.54,0:59:16.17,Default,nanas,0,0,0,,keberuntungan ada di pihak raja,
Dialog: 0,0:59:16.17,0:59:19.88,Default,nanas,0,0,0,,dan dia menemukan bukti yang memberatkan semua orang yang berada di balik kekejaman ini.
Dialog: 0,0:59:27.08,0:59:30.55,Default,nanas,0,0,0,,Setelah kematian raja
Dialog: 0,0:59:31.15,0:59:33.46,Default,nanas,0,0,0,,dan pencicip makanannya telah hilang.
Dialog: 0,0:59:33.52,0:59:35.59,Default,nanas,0,0,0,,Saya yakin dia diracun.
Dialog: 0,0:59:36.66,0:59:38.40,Default,nanas,0,0,0,,Kalau saja kita lebih cepat,
Dialog: 0,0:59:38.40,0:59:41.00,Default,nanas,0,0,0,,raja masih hidup.
Dialog: 0,0:59:42.43,0:59:46.14,Default,nanas,0,0,0,,Dengarkan aku,\NIini belum berakhir untukmu,
Dialog: 0,0:59:46.14,0:59:49.37,Default,nanas,0,0,0,,tetapi jika Anda melewatkan momen ini, Anda tidak akan mendapatkan apa pun kembali.
Dialog: 0,0:59:50.04,0:59:52.84,Default,nanas,0,0,0,,Kali ini pembantumu Ovol menderita,
Dialog: 0,0:59:52.98,0:59:56.08,Default,nanas,0,0,0,,tapi lain kali kamu akan berada di tempatnya.
Dialog: 0,0:59:57.18,0:59:59.35,Default,nanas,0,0,0,,Saya akan mengajukan petisi
Dialog: 0,1:00:00.15,1:00:02.49,Default,nanas,0,0,0,,tentang perampasan gelar ratu.
Dialog: 0,1:00:03.52,1:00:05.82,Default,nanas,0,0,0,,Anda bahkan tidak perlu melakukan apa pun,
Dialog: 0,1:00:05.89,1:00:08.79,Default,nanas,0,0,0,,raja akan menemui kita.
Dialog: 0,1:00:08.79,1:00:12.20,Default,nanas,0,0,0,,Anda hanya perlu menyetujui gagasan ini.
Dialog: 0,1:00:17.53,1:00:21.20,Default,nanas,0,0,0,,Ibu Suri, mohon maafkan saya,
Dialog: 0,1:00:24.21,1:00:27.38,Default,nanas,0,0,0,,tapi aku butuh bantuanmu.
Dialog: 0,1:00:30.21,1:00:34.68,Default,nanas,0,0,0,,Kamu hanya perlu menjaga raja kami.
Dialog: 0,1:00:35.49,1:00:39.82,Default,nanas,0,0,0,,Setelah ini raja akan mengubah\Nsikapnya terhadap ratu,
Dialog: 0,1:00:39.82,1:00:42.59,Default,nanas,0,0,0,,tidak akan mengerti kenapa dia melakukan semua ini.
Dialogue: 0,1:00:47.06,1:00:51.03,Default,nanas,0,0,0,,Di luar mendung.\NISepertinya akan turun hujan.
Dialog: 0,1:00:51.03,1:00:52.54,Default,nanas,0,0,0,,Nyonya Han,
Dialog: 0,1:00:52.97,1:00:55.71,Default,nanas,0,0,0,,ruangan gelap, nyalakan lilin.
Dialog: 0,1:00:55.81,1:00:57.24,Default,nanas,0,0,0,,saya patuh.
Dialog: 0,1:01:24.17,1:01:26.90,Default,nanas,0,0,0,,Jika kamu menunggu raja, dia tidak akan datang.
Dialog: 0,1:01:27.40,1:01:29.34,Default,nanas,0,0,0,,Bagaimana kamu tahu itu...
Dialogue: 0,1:01:29.54,1:01:32.71,Default,nanas,0,0,0,,Maukah kamu tenang\Nsaat kamu mengambil semuanya dariku?
Dialogue: 0,1:01:32.94,1:01:35.41,Default,nanas,0,0,0,,Apakah kamu mengganti hurufnya?
Dialog: 0,1:01:37.41,1:01:39.52,Default,nanas,0,0,0,,Anda mengubah sesuatu yang lebih serius.
Dialogue: 0,1:01:39.78,1:01:41.95,Default,nanas,0,0,0,,Kenapa benda sekecil itu tidak bisa kuganti?
Dialog: 0,1:01:45.19,1:01:47.16,Default,nanas,0,0,0,,Saya tidak mengerti maksud Anda.
Dialog: 0,1:01:48.59,1:01:52.26,Default,nanas,0,0,0,,Aku tahu kamu berbohong.
Dialog: 0,1:01:56.33,1:01:59.07,Default,nanas,0,0,0,,Jika raja mengetahui kebenarannya,
Dialog: 0,1:02:00.30,1:02:02.91,Default,nanas,0,0,0,,maka kamu akan mengerti perasaanku.
Dialog: 0,1:02:03.77,1:02:06.94,Default,nanas,0,0,0,,Perasaan yang kamu rasakan saat kehilangan seseorang yang kamu sayangi.
Dialogue: 0,1:02:07.01,1:02:08.48,Default,nanas,0,0,0,,Betapa sulitnya bagimu
Dialog: 0,1:02:09.61,1:02:12.42,Default,nanas,0,0,0,,akan menatap matanya
Dialog: 0,1:02:13.55,1:02:15.75,Default,nanas,0,0,0,,selama sisa hidupku.
Dialog: 0,1:02:23.06,1:02:26.93,Default,nanas,0,0,0,,Jika kamu ingin merahasiakan semuanya, tinggalkan istana.
Dialog: 0,1:02:28.80,1:02:31.13,Default,nanas,0,0,0,,Kamu menemukan titik lemahku.
Dialog: 0,1:02:31.50,1:02:34.74,Default,nanas,0,0,0,,Oke, beritahukan ini pada raja,
Dialog: 0,1:02:34.94,1:02:38.47,Default,nanas,0,0,0,,tapi kemudian Anda harus membicarakan hal lain.
Dialog: 0,1:02:40.21,1:02:41.74,Default,nanas,0,0,0,,Anda mencoba
Dialog: 0,1:02:42.61,1:02:44.58,Default,nanas,0,0,0,,bunuh raja.
Dialog: 0,1:02:53.46,1:02:55.73,Default,nanas,0,0,0,,Jadi, tahukah Anda.
Dialog: 0,1:02:56.99,1:02:58.53,Default,nanas,0,0,0,,Anda punya
Dialog: 0,1:02:59.63,1:03:01.63,Default,nanas,0,0,0,,tidak ada yang berhasil.
Dialog: 0,1:03:07.04,1:03:08.77,Default,nanas,0,0,0,,Suatu hari nanti kamu akan kalah
Dialogue: 0,1:03:09.77,1:03:12.61,Default,nanas,0,0,0,,orang sayang padamu.
Dialog: 0,1:03:52.92,1:03:54.45,Default,nanas,0,0,0,,Apa yang terjadi?
Dialog: 0,1:03:56.99,1:03:59.09,Default,nanas,0,0,0,,Anda sudah tahu.
Dialog: 0,1:03:59.72,1:04:01.22,Default,nanas,0,0,0,,Yang Mulia
Dialog: 0,1:04:02.06,1:04:04.39,Default,nanas,0,0,0,,lemah saat dia merasa bersalah.
Dialog: 0,1:04:06.06,1:04:08.00,Default,nanas,0,0,0,,Inilah harga kelangsungan hidup.
Dialog: 0,1:04:08.63,1:04:10.30,Default,nanas,0,0,0,,Rasa Bersalah.
Dialog: 0,1:04:16.51,1:04:20.74,Default,nanas,0,0,0,,Yang Mulia, apakah ini yang ingin Anda lakukan untuk memenangkan hati raja?
Dialog: 0,1:04:36.89,1:04:39.30,Default,nanas,0,0,0,,Cepat, simpan sebelum semuanya basah!
Dialog: 0,1:04:39.30,1:04:40.96,Default,nanas,0,0,0,,Percepat!
Dialogue: 0,1:04:44.97,1:04:48.14,Default,nanas,0,0,0,,Hujan turun selama beberapa hari.
Dialog: 0,1:04:48.27,1:04:50.27,Default,nanas,0,0,0,,Dan akhirnya dia pergi.
Dialog: 0,1:04:51.47,1:04:54.44,Default,nanas,0,0,0,,Dalam hidup ini posisiku lebih tinggi dari pada saat ini,
Dialogue: 0,1:04:54.95,1:04:57.68,Default,pineapple,0,0,0,,tapi kenapa aku merasa lebih buruk lagi?
Dialog: 0,1:04:57.68,1:04:58.68,Default,nanas,0,0,0,,Yang Mulia,
Dialogue: 0,1:04:58.68,1:05:03.02,Default,nanas,0,0,0,,apa menurutmu aku bisa mempunyai kehidupan lain?
Dialog: 0,1:05:03.92,1:05:07.39,Default,nanas,0,0,0,,Menurut teori dunia paralel, segalanya mungkin.
Dialog: 0,1:05:11.90,1:05:12.90,Default,nanas,0,0,0,,Lihat.
Dialog: 0,1:05:12.90,1:05:15.63,Default,nanas,0,0,0,,Inilah kehidupan yang kamu jalani sekarang.
Dialog: 0,1:05:16.63,1:05:19.20,Default,nanas,0,0,0,,Tapi ini adalah kehidupanmu yang lain.\NDApakah kamu mengerti?
Dialogue: 0,1:05:19.54,1:05:21.47,Default,nanas,0,0,0,,Semacam hal sialan.
Dialog: 0,1:05:23.34,1:05:25.34,Default,nanas,0,0,0,,Setelah saya mulai berkomunikasi
Dialog: 0,1:05:25.34,1:05:28.11,Default,nanas,0,0,0,,mengatakan omong kosong kepada ratu.
Dialogue: 0,1:05:28.71,1:05:33.58,Default,nanas,0,0,0,,Lalu bisakah anak anjing ini\Nmenjadi manusia di kehidupan lampau?
Dialog: 0,1:05:34.18,1:05:35.79,Default,nanas,0,0,0,,Semuanya mungkin.
Dialog: 0,1:05:35.99,1:05:37.92,Default,nanas,0,0,0,,Dan juru masaknya bodoh?
Dialog: 0,1:05:41.42,1:05:44.69,Default,nanas,0,0,0,,Atau yang lain. Dia mungkin adalah bawahanku.
Dialog: 0,1:05:45.50,1:05:47.36,Default,nanas,0,0,0,,Bagaimana dengan saya?
Dialog: 0,1:05:48.77,1:05:53.04,Default,nanas,0,0,0,,Kamu akan selalu menjadi dayang Choi.
Dialog: 0,1:05:53.90,1:05:56.01,Default,nanas,0,0,0,,Dan kamu, Hongyong...
Dialog: 0,1:05:56.01,1:05:58.74,Default,nanas,0,0,0,,Lalu ayah dan ibuku
Dialog: 0,1:05:58.74,1:06:01.08,Default,nanas,0,0,0,,akankah mereka bahagia di kehidupan selanjutnya?
Dialog: 0,1:06:01.08,1:06:02.08,Default,nanas,0,0,0,,Apa?
Dialogue: 0,1:06:02.08,1:06:05.62,Default,nanas,0,0,0,,Ibuku hanya punya empat kuku tersisa.
Dialog: 0,1:06:05.62,1:06:09.09,Default,nanas,0,0,0,,Dia kehilangan kukunya saat memilah-milah batu di musim dingin.
Dialogue: 0,1:06:09.09,1:06:14.02,Default,nanas,0,0,0,,Di kehidupan lain, akankah ibuku memasang semua kukunya?
Dialog: 0,1:06:14.89,1:06:17.43,Default,nanas,0,0,0,,Tentu saja.
Dialog: 0,1:06:17.43,1:06:19.76,Default,nanas,0,0,0,,Dan pendeta akan memiliki dua mata!
Dialog: 0,1:06:19.76,1:06:21.36,Default,nanas,0,0,0,,Bagaimana dengan ayahmu?
Dialog: 0,1:06:21.36,1:06:24.03,Default,nanas,0,0,0,,-Matanya dicungkil dengan garpu rumput.\N-Apa?
Dialog: 0,1:06:24.03,1:06:25.84,Default,nanas,0,0,0,,Pasti pinjam beras
Dialog: 0,1:06:25.84,1:06:28.00,Default,nanas,0,0,0,,dan tidak membayar bunga.
Dialog: 0,1:06:28.07,1:06:31.01,Default,nanas,0,0,0,,Dan kemudian rentenir menagih utangnya.
Dialog: 0,1:06:31.84,1:06:35.01,Default,nanas,0,0,0,,Di setiap pekarangan ada yang menderita karena rentenir.
Dialog: 0,1:06:36.58,1:06:37.81,Default,nanas,0,0,0,,Jangan khawatir.
Dialog: 0,1:06:37.81,1:06:40.72,Default,nanas,0,0,0,,Di kehidupan selanjutnya, ibumu\Nakan memiliki kuku indah yang sehat,
Dialog: 0,1:06:40.72,1:06:42.25,Default,nanas,0,0,0,,Anda bahkan tidak perlu melakukan manikur.
Dialog: 0,1:06:42.25,1:06:43.75,Default,nanas,0,0,0,,Dan ayahku akan memilikinya
Dialog: 0,1:06:43.75,1:06:47.12,Default,nanas,0,0,0,,matanya berbinar-binar, seolah dia memakai lensa kontak.
Dialog: 0,1:06:47.89,1:06:52.60,Default,nanas,0,0,0,,Saya ingin melihat ibu saya memiliki kuku yang sehat.
Dialog: 0,1:06:52.93,1:06:54.43,Default,nanas,0,0,0,,Eh!
Dialogue: 0,1:06:56.10,1:06:57.53,Default,nanas,0,0,0,,Dan aku.
Dialog: 0,1:06:58.30,1:07:00.40,Default,nanas,0,0,0,,Aku sangat ingin melihat ibuku.
Dialog: 0,1:07:02.14,1:07:06.21,Default,nanas,0,0,0,,Kamu tidak sempat melihat wajah ibumu!
Dialog: 0,1:07:06.31,1:07:07.74,Default,nanas,0,0,0,,Bagaimana bisa.
Dialogue: 0,1:07:08.48,1:07:11.08,Default,nanas,0,0,0,,Nah, kenapa kamu ingat tentang dia?
Dialog: 0,1:07:11.98,1:07:14.32,Default,nanas,0,0,0,,Aku tidak membicarakan ibu ini!
Dialog: 0,1:07:14.32,1:07:17.42,Default,nanas,0,0,0,,Saya sedang berbicara tentang Nona Li Sunxin, dia masih hidup dan sehat!
Dialog: 0,1:07:18.62,1:07:20.56,Default,nanas,0,0,0,,Bahkan Zumba!
Dialogue: 0,1:07:20.56,1:07:22.39,Default,nanas,0,0,0,,Kenapa kamu membuatku merasa seperti yatim piatu?
Dialog: 0,1:07:27.93,1:07:29.77,Default,nanas,0,0,0,,Berkumpul di dapur kerajaan,
Dialog: 0,1:07:29.77,1:07:32.10,Default,nanas,0,0,0,,di mana jalannya tertutup bagi wanita, dan mereka merengek.
Dialog: 0,1:07:32.10,1:07:34.80,Default,nanas,0,0,0,,Saya tidak mengerti wanita.
Dialog: 0,1:07:38.78,1:07:40.24,Default,nanas,0,0,0,,Mama?
Dialog: 0,1:07:42.45,1:07:43.88,Default,nanas,0,0,0,,Bu!
Dialog: 0,1:07:57.89,1:08:00.33,Default,nanas,0,0,0,,Hujan, jadi semua orang sedih.
Dialog: 0,1:08:01.20,1:08:04.00,Default,nanas,0,0,0,,Dengar, bawakan aku pajeon dengan makgeolli.
Dialog: 0,1:08:05.27,1:08:06.67,Default,nanas,0,0,0,,Kembali ke Aula Daejojeon.
Dialog: 0,1:08:06.67,1:08:08.87,Default,nanas,0,0,0,,Hujan akan terus turun dalam waktu yang lama.
Dialog: 0,1:08:10.27,1:08:11.51,Default,nanas,0,0,0,,Bagaimana kamu tahu?
Dialogue: 0,1:08:11.51,1:08:13.91,Default,nanas,0,0,0,,Sudahkah kamu menjadi komputer meteorologi?
Dialog: 0,1:08:13.91,1:08:16.48,Default,nanas,0,0,0,,Saya tidak mengerti apa yang Anda bicarakan,
Dialog: 0,1:08:16.61,1:08:19.05,Default,nanas,0,0,0,,tapi pergelangan tanganku sangat sakit,
Dialog: 0,1:08:19.05,1:08:21.62,Default,nanas,0,0,0,,yang berarti akan turun hujan sepanjang malam.
Dialog: 0,1:08:23.82,1:08:25.45,Default,nanas,0,0,0,,Seberapa kuat?
Dialog: 0,1:08:25.86,1:08:27.96,Default,nanas,0,0,0,,Saya tidak tahu,
Dialog: 0,1:08:29.73,1:08:32.90,Default,nanas,0,0,0,,bila sakit sekali, itu artinya
Dialog: 0,1:08:32.90,1:08:36.47,Default,nanas,0,0,0,,akan mengisi semua tong hanya dalam beberapa jam.
Dialogue: 0,1:08:37.27,1:08:39.54,Default,nanas,0,0,0,,Apakah tong akan terisi dalam beberapa jam?
Dialog: 0,1:08:39.80,1:08:43.54,Default,nanas,0,0,0,,Lalu akankah ada air di danau dan sumur?
Dialog: 0,1:08:56.55,1:08:58.02,Default,nanas,0,0,0,,Kepala Kasim.
Dialog: 0,1:08:58.82,1:09:00.36,Default,nanas,0,0,0,,Saya mendengarkan, Pak.
Dialog: 0,1:09:03.33,1:09:04.43,Default,nanas,0,0,0,,Buku Perubahan
Dialog: 0,1:09:04.43,1:09:06.80,Default,nanas,0,0,0,,Untuk menjadikan malam kita bersama ratu lebih produktif,
Dialog: 0,1:09:06.80,1:09:09.97,Default,nanas,0,0,0,,Saya akan tidur setelah membaca lebih banyak lagi.
Dialog: 0,1:09:10.10,1:09:12.54,Default,nanas,0,0,0,,Sudah larut, kamu boleh pergi.
Dialogue: 0,1:09:12.80,1:09:14.24,Default,nanas,0,0,0,,aku patuh.
Dialog: 0,1:09:22.38,1:09:25.25,Default,nanas,0,0,0,,Catatan tentang senjata dan peralatan
Dialogue: 0,1:09:53.04,1:09:55.71,Default,flash 5,0,0,0,,Aku akan kembali saat kamu sudah merasa lebih baik.
Dialogue: 0,1:09:55.71,1:09:59.05,Default,flash 5,0,0,0,,Jangan datang kecuali kamu siap untuk berlutut.
Dialog: 0,1:09:59.08,1:10:01.55,Default,flash 5,0,0,0,,Sudah kubilang jangan datang!
Dialog: 0,1:10:11.43,1:10:14.23,Default,nanas,0,0,0,,Setiap hari aku berlutut,
Dialog: 0,1:10:15.83,1:10:19.84,Default,nanas,0,0,0,,tetapi bukan kepada siapa\NI harus tunduk.
Dialog: 0,1:10:28.95,1:10:30.41,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,1:10:31.11,1:10:32.98,Default,nanas,0,0,0,,Kamu akan sakit!
Dialog: 0,1:10:32.98,1:10:34.92,Default,nanas,0,0,0,,Saya tidak peduli dengan penyakit!
Dialogue: 0,1:10:34.92,1:10:37.02,Default,nanas,0,0,0,,Lihat, surga ada di pihakku!
Dialog: 0,1:10:37.02,1:10:39.62,Default,nanas,0,0,0,,Ya Tuhan, Nyonya, hentikan!
Dialog: 0,1:10:40.09,1:10:42.73,Default,nanas,0,0,0,,Tolong tenang!
Dialog: 0,1:11:13.89,1:11:15.63,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,1:11:15.63,1:11:16.86,Default,nanas,0,0,0,,Yang Mulia?
Dialog: 0,1:11:16.86,1:11:19.26,Default,nanas,0,0,0,,Dan sekali lagi!
Dialog: 0,1:11:19.26,1:11:20.83,Default,nanas,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,1:11:20.83,1:11:22.83,Default,nanas,0,0,0,,Itu dia! Hore! Akhirnya!
Dialog: 0,1:11:22.83,1:11:24.33,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,1:11:24.33,1:11:26.70,Default,nanas,0,0,0,,Ada apa denganmu?
Dialogue: 0,1:11:33.04,1:11:35.14,Default,nanas,0,0,0,,Wanita seperti apa dia?
Dialogue: 0,1:11:35.71,1:11:37.91,Default,nanas,0,0,0,,Kamu tidak pernah tahu apa yang ada dalam pikirannya.
Dialog: 0,1:11:37.91,1:11:40.45,Default,nanas,0,0,0,,Itu dia! Luar biasa!
Dialog: 0,1:11:40.52,1:11:43.22,Default,nanas,0,0,0,,Apa yang terjadi padamu?
Dialogue: 0,1:11:45.25,1:11:48.16,Default,nanas,0,0,0,,Mengapa kamu tanpa kelompok pendukung?
Dialog: 0,1:11:57.07,1:11:59.30,Default,nanas,0,0,0,,Juga memutuskan untuk berjalan-jalan di tengah hujan?
Dialog: 0,1:12:00.47,1:12:03.04,Default,nanas,0,0,0,,Saya datang untuk meminta maaf.
Dialog: 0,1:12:04.44,1:12:06.31,Default,nanas,0,0,0,,Lupakan saja, saya tidak peduli.
Dialog: 0,1:12:06.31,1:12:07.74,Default,nanas,0,0,0,,Tidak,
Dialog: 0,1:12:07.74,1:12:09.91,Default,nanas,0,0,0,,Saya tidak bisa melupakannya.
Dialog: 0,1:12:09.91,1:12:12.52,Default,nanas,0,0,0,,Sudah kubilang, aku tidak peduli, kenapa kamu terikat?
Dialog: 0,1:12:13.08,1:12:14.48,Default,nanas,0,0,0,,Terlampir?
Dialog: 0,1:12:16.82,1:12:19.02,Default,nanas,0,0,0,,Saya orang yang sederhana.
Dialog: 0,1:12:19.02,1:12:20.56,Default,nanas,0,0,0,,Senang bertemu denganmu - aku bersumpah,
Dialog: 0,1:12:20.56,1:12:22.89,Default,nanas,0,0,0,,bersyukur - Saya akan berkelahi.
Dialog: 0,1:12:22.89,1:12:24.89,Default,nanas,0,0,0,,Saya tidak tahan dengan penjilat,
Dialog: 0,1:12:25.06,1:12:26.50,Default,nanas,0,0,0,,turun.
Dialog: 0,1:12:30.70,1:12:32.20,Default,nanas,0,0,0,,Keluar?
Dialog: 0,1:12:32.30,1:12:34.27,Default,nanas,0,0,0,,Saya mengumpulkan keberanian untuk meminta maaf,
Dialogue: 0,1:12:34.27,1:12:36.64,Default,pineapple,0,0,0,,dan ini balasan yang saya dapat?
Dialog: 0,1:12:36.67,1:12:39.38,Default,nanas,0,0,0,,Dengar, andai saja yang butuh permintaan maaf itu
Dialog: 0,1:12:39.38,1:12:42.51,Default,nanas,0,0,0,,siapa yang meminta maaf, dan bukan kepada yang menerimanya, apakah itu benar-benar permintaan maaf?
Dialog: 0,1:12:45.98,1:12:48.99,Default,nanas,0,0,0,,Keluarga kerajaan mempunyai aturannya sendiri.
Dialogue: 0,1:12:48.99,1:12:52.05,Default,nanas,0,0,0,,Berapa lama kamu akan berbicara begitu aneh?
Dialog: 0,1:12:53.16,1:12:55.72,Default,nanas,0,0,0,,Hanya hari ini. Ini adalah hari terakhir.
Dialog: 0,1:12:55.73,1:13:00.06,Default,nanas,0,0,0,,Dan besok semuanya akan beres!
Dialog: 0,1:13:00.06,1:13:02.83,Default,nanas,0,0,0,,Itu dia! Oh ya!
Dialog: 0,1:13:02.83,1:13:04.67,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,1:13:04.67,1:13:06.87,Default,nanas,0,0,0,,-Itu dia!\N-Ratu!
Dialog: 0,1:13:06.87,1:13:08.94,Default,nanas,0,0,0,,Oh ya!
Dialog: 0,1:13:10.41,1:13:13.64,Default,nanas,0,0,0,,Yang Mulia, sadarlah!
Dialog: 0,1:13:13.64,1:13:15.28,Default,nanas,0,0,0,,Oh ya!
Dialog: 0,1:13:18.08,1:13:21.38,Default,nanas,0,0,0,,Kamu menyinggung perasaanku, jadi hari ini kita tidur terpisah.
Dialog: 0,1:13:24.12,1:13:25.65,Default,nanas,0,0,0,,Menghabiskan malam sendirian.
Dialogue: 0,1:13:27.76,1:13:31.36,Default,nanas,0,0,0,,Alhamdulillah! Saya sangat senang mendengarnya!
Dialogue: 0,1:13:33.43,1:13:35.33,Default,nanas,0,0,0,,Betapa hebatnya saya.
Dialogue: 0,1:13:41.17,1:13:42.94,Default,nanas,0,0,0,,Apakah kamu keluar tanpa payung?
Dialog: 0,1:13:42.94,1:13:45.77,Default,nanas,0,0,0,,Terkadang aku suka jalan-jalan tanpa payung.
Dialogue: 0,1:13:45.84,1:13:49.51,Default,nanas,0,0,0,,Rasanya hujan menghapus semua kekhawatiranku.
Dialog: 0,1:13:52.15,1:13:54.25,Default,nanas,0,0,0,,Jangan sedih!
Dialog: 0,1:13:54.25,1:13:56.12,Default,nanas,0,0,0,,Yang Mulia, kembali ke dalam!
Dialogue: 0,1:13:56.35,1:13:58.99,Default,nanas,0,0,0,,Sungguh mimpi buruk! Permaisuri!
Dialog: 0,1:13:58.99,1:14:00.62,Default,nanas,0,0,0,,Hentikan!
Dialog: 0,1:14:01.46,1:14:04.36,Default,nanas,0,0,0,,Apa ini? Mengapa ada guntur?
Dialog: 0,1:14:04.36,1:14:06.43,Default,nanas,0,0,0,,Surga sedang marah!
Dialog: 0,1:14:07.13,1:14:08.63,Default,nanas,0,0,0,,Marah!
Dialog: 0,1:14:08.63,1:14:12.74,Default,nanas,0,0,0,,Aku menggerakkan panggulku jika itu berarti\Nhujan akan terus turun dalam waktu yang lama!
Dialog: 0,1:14:13.34,1:14:16.27,Default,nanas,0,0,0,,Yang Mulia! Hentikan!
Dialog: 0,1:14:16.27,1:14:18.17,Default,nanas,0,0,0,,Oh ya!
Dialog: 0,1:14:18.17,1:14:19.68,Default,nanas,0,0,0,,Tolong!
Dialog: 0,1:14:20.08,1:14:21.54,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,1:14:21.54,1:14:23.95,Default,nanas,0,0,0,,Penyakit ratu semakin parah dari hari ke hari,
Dialog: 0,1:14:23.95,1:14:26.28,Default,nanas,0,0,0,,dia tidak melewatkan kesempatan untuk bunuh diri.
Dialogue: 0,1:14:26.32,1:14:29.39,Default,nanas,0,0,0,,Seluruh halaman gemetar karena kejenakaannya.
Dialog: 0,1:14:30.25,1:14:33.69,Default,nanas,0,0,0,,Bukankah lebih baik mengajukan petisi
Dialog: 0,1:14:33.69,1:14:35.66,Default,nanas,0,0,0,,tentang pencopotan gelarnya?
Dialog: 0,1:14:35.89,1:14:38.73,Default,nanas,0,0,0,,-Anda benar.\N-Benar.
Dialog: 0,1:14:38.73,1:14:41.70,Default,nanas,0,0,0,,Saatnya untuk klan kita
Dialog: 0,1:14:41.70,1:14:44.07,Default,nanas,0,0,0,,kumpulkan kekuatanmu.
Dialog: 0,1:14:58.98,1:15:01.48,Default,nanas,0,0,0,,Saat musuh membuka lehernya yang tak berdaya,
Dialog: 0,1:15:01.95,1:15:04.45,Default,nanas,0,0,0,,Anda harus segera mengambilnya.
Dialog: 0,1:15:09.49,1:15:12.19,Default,nanas,0,0,0,,Inti negara kita dalam bahaya.
Dialog: 0,1:15:12.19,1:15:15.86,Default,nanas,0,0,0,,Mencabut gelar ratu adalah keputusan yang tepat.
Dialogue: 0,1:15:24.57,1:15:27.41,Default,nanas,0,0,0,,Pada suatu ketika ada seorang yang abadi bernama Achilles.
Dialog: 0,1:15:27.41,1:15:29.51,Default,nanas,0,0,0,,Dan dia hanya punya satu titik lemah.
Dialog: 0,1:15:29.51,1:15:32.38,Default,nanas,0,0,0,,Legenda mengatakan bahwa dia meninggal karena panah yang ditembakkan ke tumitnya.
Dialog: 0,1:15:32.55,1:15:35.48,Default,nanas,0,0,0,,Beginilah ungkapan "tumit Achilles" muncul.
Dialog: 0,1:15:36.42,1:15:37.89,Default,nanas,0,0,0,,Tapi alasan sebenarnya kematiannya adalah,
Dialog: 0,1:15:37.89,1:15:41.02,Default,nanas,0,0,0,,bahwa Achilles tidak memiliki seseorang yang akan membuatkannya sepatu lapis baja.
Dialog: 0,1:15:41.02,1:15:42.46,Default,nanas,0,0,0,,Mereka bilang...
Dialogue: 0,1:15:42.46,1:15:45.90,Default,nanas,0,0,0,,Jika orang ingin menghilangkan kelemahannya, mereka akan saling menyingkirkan.
Dialog: 0,1:15:45.90,1:15:48.30,Default,nanas,0,0,0,,Hindari ancaman...
Dialogue: 0,1:15:48.30,1:15:51.87,Default,nanas,0,0,0,,Kita adalah titik lemah masing-masing,\Nalasan mengapa kita menderita.
Dialog: 0,1:15:53.94,1:15:57.97,Default,nanas,0,0,0,,Tapi kita juga saling melindungi dan menyelamatkan.
Dialog: 0,1:16:20.23,1:16:21.73,Default,nanas,0,0,0,,Honyoung,
Dialog: 0,1:16:22.03,1:16:24.80,Default,nanas,0,0,0,,pastikan membeli tanah di Gangnam.
Dialog: 0,1:16:24.80,1:16:27.37,Default,nanas,0,0,0,,Ya, Yang Mulia.
Dialog: 0,1:16:29.14,1:16:30.67,Default,nanas,0,0,0,,Nyonya Choi,
Dialogue: 0,1:16:31.27,1:16:33.38,Default,nanas,0,0,0,,kamu telah melalui banyak hal karena aku.
Dialog: 0,1:17:02.54,1:17:04.07,Default,nanas,0,0,0,,Akhirnya.
Dialog: 0,1:17:09.01,1:17:12.11,Default,nanas,0,0,0,,Danau Chhundaji
Dialog: 0,1:17:26.23,1:17:29.47,Default,nanas,0,0,0,,Saya seharusnya tidak sampai di sini\NJang Bong-hwan
Dialogue: 0,1:17:30.07,1:17:31.77,Default,nanas,0,0,0,,Kita harus merayakannya.
Dialog: 0,1:17:55.36,1:17:58.13,Default,nanas,0,0,0,,Sekarang semuanya akan beres.
Dialog: 0,1:20:11.73,1:20:14.00,Default,nanas,0,0,0,,{\i1}Ratu adalah orang yang paling luar biasa dan aneh{\i}
Dialog: 0,1:20:14.00,1:20:16.20,Default,nanas,0,0,0,,{\i1}dari semua orang yang saya kenal.{\i}
Dialog: 0,1:20:16.20,1:20:18.47,Default,nanas,0,0,0,,{\i1}Seolah-olah dia bukan dari dunia kita.{\i}
Dialog: 0,1:20:18.47,1:20:20.87,Default,nanas,0,0,0,,{\i1}Jiwa siapa yang ingin kamu panggil?{\i}
Dialogue: 0,1:20:20.87,1:20:24.41,Default,pineapple,0,0,0,,{\i1}Wanita ini benar-benar gila.{\i}
Dialogue: 0,1:20:24.41,1:20:26.88,Default,pineapple,0,0,0,,{\i1}Krisis internal jauh lebih buruk,{\i}
Dialog: 0,1:20:26.88,1:20:28.78,Default,nanas,0,0,0,,{\i1}masalah eksternal. Tidak setuju?{\i}
Dialog: 0,1:20:28.78,1:20:30.01,Default,nanas,0,0,0,,{\i1}Apakah Anda ingin mengatakan itu di negara{\i}
Dialogue: 0,1:20:30.01,1:20:31.25,Default,pineapple,0,0,0,,{\i1}ada masalah yang sebelumnya tidak ada?{\i}
Dialog: 0,1:20:31.25,1:20:32.31,Default,nanas,0,0,0,,{\i1}Ternyata...{\i}
Dialog: 0,1:20:32.31,1:20:33.82,Default,nanas,0,0,0,,{\i1}Ketertarikan Yang Mulia pada Ratu{\i}
Dialog: 0,1:20:33.82,1:20:35.95,Default,nanas,0,0,0,,{\i1}akan menjadi kelemahan kita.{\i}
Dialogue: 0,1:20:35.95,1:20:39.05,Default,pineapple,0,0,0,,{\i1}Maka hari ini adalah hari pertama kita.{\i}
Dialog: 0,1:20:39.05,1:20:40.46,Default,nanas,0,0,0,,{\i1}Apa?{\i}
