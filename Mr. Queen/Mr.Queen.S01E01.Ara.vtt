Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:10.52,0:01:13.41,Default,LILY,0,0,0,,حلقة واحدة
Dialogue: 0,0:01:24.70,0:01:26.90,Default,LILY,0,0,0,,حتى الكلب الأكثر شراً
Dialogue: 0,0:01:26.90,0:01:28.79,Default,LILY,0,0,0,,لن يعض اليد التي تطعمه.
Dialogue: 0,0:01:28.90,0:01:30.16,Default,LILY,0,0,0,,سوف يهز ذيله.
Dialogue: 0,0:01:30.47,0:01:33.37,Default,LILY,0,0,0,,عندما بدأت الطهي في الثالثة عشرة من عمري،
Dialogue: 0,0:01:33.37,0:01:36.27,Default,LILY,0,0,0,,حلمت بالعمل في البيت الأزرق.
Dialogue: 0,0:01:36.34,0:01:39.57,Default,LILY,0,0,0,,أردت أن أصبح الشخص الذي يطعم الشخص الأكثر نفوذاً.
Dialogue: 0,0:01:40.11,0:01:42.07,Default,LILY,0,0,0,,لذا أصبحت طاهياً.
Dialogue: 0,0:01:42.55,0:01:45.18,Default,LILY,0,0,0,,لقد ذكرت سابقًا أنك أصبحت
Dialogue: 0,0:01:45.18,0:01:47.35,Default,LILY,0,0,0,,أصغر طباخة في البيت الأزرق.
Dialogue: 0,0:01:47.35,0:01:49.08,Default,LILY,0,0,0,,-لقد أصبحت الأول.\N-ماذا؟
Dialogue: 0,0:01:55.53,0:01:56.65,Default,LILY,0,0,0,,انتظر.
Dialogue: 0,0:01:57.96,0:01:59.06,Default,LILY,0,0,0,,Cod.
Dialogue: 0,0:02:02.84,0:02:03.96,Default,LILY,0,0,0,,سأفعل.
Dialogue: 0,0:02:09.71,0:02:11.94,Default,LILY,0,0,0,,السفير لا يتحمل العظام في الأسماك.
Dialogue: 0,0:02:11.94,0:02:13.34,Default,LILY,0,0,0,,كن حذراً.
Dialogue: 0,0:02:14.08,0:02:15.27,Default,LILY,0,0,0,,هيا.
Dialogue: 0,0:02:17.78,0:02:19.82,Default,LILY,0,0,0,,إذا كررت هذا مرة أخرى،
Dialogue: 0,0:02:19.82,0:02:21.81,Default,LILY,0,0,0,,سأعطيه رأس السمكة فقط.
Dialogue: 0,0:02:24.22,0:02:27.62,Default,LILY,0,0,0,,الشيف يطبخ السمكة بنفسه،
Dialogue: 0,0:02:27.83,0:02:29.10,Default,LILY,0,0,0,,لا تقلق.
Dialogue: 0,0:02:29.10,0:02:31.12,Default,LILY,0,0,0,,هل هو الإمبراطور تشين شي هوانغ أم ماذا؟
Dialogue: 0,0:02:31.30,0:02:32.59,Default,LILY,0,0,0,,تشين شيهوانغ؟
Dialogue: 0,0:02:33.30,0:02:36.49,Default,LILY,0,0,0,,فطيرة السمك تم اختراعها من أجل تشين شيهوانغ.
Dialogue: 0,0:02:36.60,0:02:38.94,Default,LILY,0,0,0,,كان الإمبراطور تشين شيهوانغ قوياً للغاية،
Dialogue: 0,0:02:38.94,0:02:41.01,Default,LILY,0,0,0,,عندما يأكل سمكته المفضلة كل يوم
Dialogue: 0,0:02:41.01,0:02:42.64,Default,LILY,0,0,0,,وعثر على عظمة،
Dialogue: 0,0:02:42.64,0:02:45.17,Default,LILY,0,0,0,,قطع رأس من أعدها.
Dialogue: 0,0:02:46.21,0:02:48.75,Default,LILY,0,0,0,,كل يوم يموت الطهاة،
Dialogue: 0,0:02:48.75,0:02:50.51,Default,LILY,0,0,0,,وفي أحد الأيام فكر الرئيس الجديد،
Dialogue: 0,0:02:51.22,0:02:53.12,Default,LILY,0,0,0,,أن الموت ينتظره أيضاً.
Dialogue: 0,0:02:53.12,0:02:55.59,Default,LILY,0,0,0,,في حالة من اليأس، آلياً
Dialogue: 0,0:02:55.59,0:02:58.95,Default,LILY,0,0,0,,تقطيع السمك على لوح التقطيع.
Dialogue: 0,0:02:59.83,0:03:00.98,Default,LILY,0,0,0,,يوريكا.
Dialogue: 0,0:03:01.96,0:03:04.22,Default,LILY,0,0,0,,لقد كان محظوظاً جداً.
Dialogue: 0,0:03:06.53,0:03:09.56,Default,LILY,0,0,0,,قد يفاجئك أن يقتل شخص آخر من أجل الطعام،
Dialogue: 0,0:03:09.80,0:03:11.53,Default,LILY,0,0,0,,ولكن هذا ليس مجرد طعام.
Dialogue: 0,0:03:11.80,0:03:15.70,Default,LILY,0,0,0,,الطبق المُعد بشكل صحيح سوف يذيب أصعب القلوب.
Dialogue: 0,0:03:16.21,0:03:20.40,Default,LILY,0,0,0,,هذا هو السلاح الأكثر سحراً في العالم.
Dialogue: 0,0:03:22.52,0:03:26.18,Default,LILY,0,0,0,,هذا بالضبط ما أفكر فيه عندما أطبخ في البيت الأزرق.
Dialogue: 0,0:03:26.92,0:03:29.55,Default,LILY,0,0,0,"الطبخ سياسة."
Dialogue: 0,0:03:30.19,0:03:32.96,Default,LILY,0,0,0,,بما أننا تطرقنا لهذا الموضوع، أجب عن الأسئلة،
Dialogue: 0,0:03:32.96,0:03:35.39,Default,LILY,0,0,0,,الذي يهتم به الجميع.
Dialogue: 0,0:03:35.39,0:03:38.85,Default,LILY,0,0,0,,على سبيل المثال، ما هي الأسرار الموجودة في البيت الأزرق؟
Dialogue: 0,0:03:39.70,0:03:42.06,Default,LILY,0,0,0,,أولاً، أريد توضيح شيء ما.
Dialogue: 0,0:03:42.40,0:03:44.23,Default,LILY,0,0,0,,لن يتم الكشف عن اسمي
Dialogue: 0,0:03:44.47,0:03:47.16,Default,LILY,0,0,0,,وسيدفع نقداً. بخير؟
Dialogue: 0,0:03:53.61,0:03:56.35,Default,LILY,0,0,0,,الكاميرا؟ كان هناك ماس كهربائي بسبب تسرب،
Dialogue: 0,0:03:56.35,0:03:57.67,Default,LILY,0,0,0,,لم يعمل طوال الأسبوع.
Dialogue: 0,0:03:59.82,0:04:02.55,Default,LILY,0,0,0,,هل كسرت نفسها أم كسرها أحد؟
Dialogue: 0,0:04:03.56,0:04:06.72,Default,LILY,0,0,0,,هناك أوقات يتعين عليك فيها غض الطرف عن هذا.
Dialogue: 0,0:04:07.83,0:04:10.65,Default,LILY,0,0,0,,بفضل هذا، كنت محظوظًا.
Dialogue: 0,0:04:12.10,0:04:14.47,Default,LILY,0,0,0,,هل من الطبيعي أن نكون هنا؟
Dialogue: 0,0:04:14.47,0:04:17.07,Default,LILY,0,0,0,,بعد تقديم الطبق الرئيسي، انتهت اللعبة.
Dialogue: 0,0:04:17.07,0:04:20.10,Default,LILY,0,0,0,,الآن يتذوق السفير الصيني الجنة.
Dialogue: 0,0:04:30.72,0:04:32.61,Default,LILY,0,0,0,,
Dialogue: 0,0:04:46.67,0:04:48.86,Default,LILY,0,0,0,,الرئيس تشان! ابحث عنه!
Dialogue: 0,0:04:50.64,0:04:51.79,Default,LILY,0,0,0,,الرئيس تشان!
Dialogue: 0,0:04:52.57,0:04:54.80,Default,LILY,0,0,0,,-أين أنت؟\N-المزعجون.
Dialogue: 0,0:04:55.34,0:04:57.43,Default,LILY,0,0,0,,من المتعب أن تكون رائعًا.
Dialogue: 0,0:04:58.41,0:05:00.48,Default,LILY,0,0,0,,لقد أحب السفير طعامي كثيراً،
Dialogue: 0,0:05:00.48,0:05:02.61,Default,LILY,0,0,0,,ما الذي يريد شخصياً أن يشكره؟
Dialogue: 0,0:05:03.52,0:05:04.85,Default,LILY,0,0,0,,سأعود قريباً يا سيونغيون.
Dialogue: 0,0:05:04.85,0:05:06.31,Default,LILY,0,0,0,,اسمي Hyejeong.
Dialogue: 0,0:05:07.52,0:05:09.08,Default,LILY,0,0,0,,سيونغيون يناسبك أكثر.
Dialogue: 0,0:05:20.67,0:05:24.16,Default,LILY,0,0,0,,حلقة واحدة: جانغ بونغ هوان في بلاد العجائب
Dialogue: 0,0:05:29.04,0:05:30.33,Default,LILY,0,0,0,,كلب غاضب. قد يعض.
Dialogue: 0,0:05:40.52,0:05:41.61,Default,LILY,0,0,0,,يا إلهي.
Dialogue: 0,0:05:41.75,0:05:43.71,Default,LILY,0,0,0,,تيك، هيا.
Dialogue: 0,0:05:45.96,0:05:47.03,Default,LILY,0,0,0,,جانغ بونغ هوان.
Dialogue: 0,0:05:47.03,0:05:48.82,Default,LILY,0,0,0,,شرطة جونغنو.
Dialogue: 0,0:05:51.90,0:05:56.10,Default,LILY,0,0,0,,الرئيس تشان، اسمه الأخير تشان،
Dialogue: 0,0:05:56.10,0:05:58.07,Default,LILY,0,0,0,,يطلق على نفسه لقب أفضل طباخ في المنطقة،
Dialogue: 0,0:05:58.07,0:06:00.20,Default,LILY,0,0,0,,أعتقد أنني أخسر بسبب اسمي.
Dialogue: 0,0:06:00.37,0:06:02.98,Default,LILY,0,0,0,,عندما نبدأ في الترويج للمطبخ الكوري،
Dialogue: 0,0:06:02.98,0:06:06.67,Default,LILY,0,0,0,,سيكون اسم Pu Seungmin معروفًا في جميع أنحاء العالم.
Dialogue: 0,0:06:06.98,0:06:08.31,Default,LILY,0,0,0,,ليس تشان بونغ هوان.
Dialogue: 0,0:06:08.31,0:06:10.48,Default,LILY,0,0,0,,حاول بشكل أفضل ولا تتحدث.
Dialogue: 0,0:06:10.48,0:06:11.61,Default,LILY,0,0,0,,حسنًا.
Dialogue: 0,0:06:12.08,0:06:14.28,Default,LILY,0,0,0,,لن يلومونا على هذا.
Dialogue: 0,0:06:14.92,0:06:16.15,Default,LILY,0,0,0,,نحن نظيفون.
Dialogue: 0,0:06:17.36,0:06:18.81,Default,LILY,0,0,0,,كلب غاضب. قد يعض.
Dialogue: 0,0:06:25.87,0:06:28.17,Default,LILY,0,0,0,,حسناً، اللعنة. لقد أخافونا.
Dialogue: 0,0:06:28.17,0:06:30.00,Default,LILY,0,0,0,,تعال معنا إلى المحطة.
Dialogue: 0,0:06:30.00,0:06:31.37,Default,LILY,0,0,0,,لقد تقرر،
Dialogue: 0,0:06:31.37,0:06:33.37,Default,LILY,0,0,0,,أن الخطاف علق هناك أثناء الصيد،
Dialogue: 0,0:06:33.37,0:06:35.01,Default,LILY,0,0,0,,ولقد تم طردي.
Dialogue: 0,0:06:35.01,0:06:36.04,Default,LILY,0,0,0,,وماذا أيضًا؟
Dialogue: 0,0:06:36.04,0:06:38.13,Default,LILY,0,0,0,,هناك أدلة على وجود رشاوى أثناء تسليم المنتجات.
Dialogue: 0,0:06:39.35,0:06:40.54,Default,LILY,0,0,0,,أي رشاوى؟
Dialogue: 0,0:06:40.78,0:06:43.52,Default,LILY,0,0,0,,مهم جدًا خلال عامين.
Dialogue: 0,0:06:43.52,0:06:45.31,Default,LILY,0,0,0,,هل يشير الدليل إليّ؟
Dialogue: 0,0:06:46.65,0:06:47.72,Default,LILY,0,0,0,,من أين أتيت بالفكرة؟
Dialogue: 0,0:06:47.72,0:06:49.56,Default,LILY,0,0,0,,نحن بحاجة إلى شهادتك.
Dialogue: 0,0:06:49.56,0:06:51.55,Default,LILY,0,0,0,,أنت لا تعرف كيف تتظاهر على الإطلاق.
Dialogue: 0,0:06:54.13,0:06:55.38,Default,LILY,0,0,0,,افتح الباب.
Dialogue: 0,0:06:55.43,0:06:57.70,Default,LILY,0,0,0,,أنا متأكد من أنك، مثل المحققين الجيدين،
Dialogue: 0,0:06:57.70,0:06:58.90,Default,LILY,0,0,0,,من الواضح ما هي الصفقة
Dialogue: 0,0:06:58.90,0:07:00.89,Default,LILY,0,0,0,,لا يمكن لرئيس بسيط أن ينتزعها.
Dialogue: 0,0:07:01.23,0:07:03.54,Default,LILY,0,0,0,,بو سيونغمين، مساعد الطاهي الأبدي،
Dialogue: 0,0:07:03.54,0:07:05.71,Default,LILY,0,0,0,,عملت هناك لفترة أطول مني.
Dialogue: 0,0:07:05.71,0:07:07.07,Default,LILY,0,0,0,,إنه المجرم.
Dialogue: 0,0:07:07.07,0:07:08.61,Default,LILY,0,0,0,,إنه يتعاون مع أحد الشخصيات البارزة
Dialogue: 0,0:07:08.61,0:07:10.51,Default,LILY,0,0,0,,ويحاول إلقاء كل اللوم عليّ.
Dialogue: 0,0:07:10.51,0:07:12.85,Default,LILY,0,0,0,,بالضبط. لهذا السبب عليك الذهاب إلى مركز الشرطة
Dialogue: 0,0:07:12.85,0:07:16.01,Default,LILY,0,0,0,,وقل رأيك في هذا الأمر.
Dialogue: 0,0:07:17.22,0:07:19.22,Default,LILY,0,0,0,,كنت في حيرة من أمري، لماذا أهتم بمثل هذه الحديقة،
Dialogue: 0,0:07:19.22,0:07:20.69,Default,LILY,0,0,0,,لكي أغادر،
Dialogue: 0,0:07:20.69,0:07:21.81,Default,LILY,0,0,0,,لكن هذا هو الأمر.
Dialogue: 0,0:07:22.32,0:07:24.78,Default,LILY,0,0,0,,من الممكن أن يتم ذلك بواسطة المدير أو شخص أعلى منه.
Dialogue: 0,0:07:25.46,0:07:26.92,Default,LILY,0,0,0,,حقاً المخرج خان؟
Dialogue: 0,0:07:27.13,0:07:28.65,Default,LILY,0,0,0,,لماذا هذا المونولوج الغريب؟
Dialogue: 0,0:07:28.89,0:07:30.16,Default,LILY,0,0,0,,الوقت ينفد.
Dialogue: 0,0:07:30.16,0:07:32.15,Default,LILY,0,0,0,,ما رأيك؟ أنا أؤخر اللحظة.
Dialogue: 0,0:07:32.73,0:07:34.22,Default,LILY,0,0,0,,نحن في عجلة من أمرنا.
Dialogue: 0,0:07:35.90,0:07:37.09,Default,LILY,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:07:39.11,0:07:41.66,Default,LILY,0,0,0,,جانغ بونغ هوان، توقف!
Dialogue: 0,0:07:45.64,0:07:47.81,Default,LILY,0,0,0,,أنتم غير صبورين يا رفاق.
Dialogue: 0,0:07:47.81,0:07:49.45,Default,LILY,0,0,0,,سوف أقوم بتعيين محامٍ،
Dialogue: 0,0:07:49.45,0:07:51.75,Default,LILY,0,0,0,,سأبحث عن شيء من أجل Poo Seungmin
Dialogue: 0,0:07:51.75,0:07:53.28,Default,LILY,0,0,0,,وسأتي إليك بنفسي.
Dialogue: 0,0:07:53.52,0:07:55.19,Default,LILY,0,0,0,,سوف تحل القضية،
Dialogue: 0,0:07:55.19,0:07:56.78,Default,LILY,0,0,0,,وستتم ترقيتك، ألا توافقين على ذلك؟
Dialogue: 0,0:07:58.89,0:08:00.48,Default,LILY,0,0,0,,توقف. بخير؟
Dialogue: 0,0:08:00.96,0:08:02.55,Default,LILY,0,0,0,,هل تسمع؟ بخير.
Dialogue: 0,0:08:03.16,0:08:04.42,Default,LILY,0,0,0,,غادر بالفعل.
Dialogue: 0,0:08:07.20,0:08:08.32,Default,LILY,0,0,0,,اللعنة.
Dialogue: 0,0:08:17.54,0:08:18.67,Default,LILY,0,0,0,,مرحبًا!
Dialogue: 0,0:08:20.05,0:08:21.95,Default,LILY,0,0,0,,هل أنت مجنون تمامًا؟
Dialogue: 0,0:08:21.95,0:08:23.68,Default,LILY,0,0,0,,إنه مكتوب - كلب غاضب.
Dialogue: 0,0:08:23.68,0:08:24.85,Default,LILY,0,0,0,,لا تقترب.
Dialogue: 0,0:08:24.85,0:08:28.41,Default,LILY,0,0,0,,جانغ بونغ هوان! أنت في ورطة!
Dialogue: 0,0:08:34.96,0:08:36.05,Default,LILY,0,0,0,,اللعنة.
Dialogue: 0,0:08:37.46,0:08:38.55,Default,LILY,0,0,0,,بالمناسبة.
Dialogue: 0,0:08:39.06,0:08:41.10,Default,LILY,0,0,0,,لدي سؤال مهم. هل ستجيب؟
Dialogue: 0,0:08:41.10,0:08:42.26,Default,LILY,0,0,0,,أيهما؟
Dialogue: 0,0:08:42.37,0:08:44.36,Default,LILY,0,0,0,,لماذا يعطون مثلجات غوكباب في ساحة اللعب؟
Dialogue: 0,0:08:45.04,0:08:46.97,Default,LILY,0,0,0,,ما هذا الهراء.
Dialogue: 0,0:08:46.97,0:08:48.60,Default,LILY,0,0,0,,أنا أكره مثلجات غوكباب.
Dialogue: 0,0:08:48.87,0:08:50.51,Default,LILY,0,0,0,,هل هذا مقهى على جانب الطريق بالنسبة لك؟
Dialogue: 0,0:08:50.51,0:08:52.50,Default,LILY,0,0,0,,هل قررت الاسترخاء على الطريق السريع؟
Dialogue: 0,0:08:52.81,0:08:54.81,Default,LILY,0,0,0,,هل تتذمر من القائمة؟
Dialogue: 0,0:08:54.81,0:08:56.01,Default,LILY,0,0,0,,أنا طاهٍ!
Dialogue: 0,0:08:56.52,0:08:59.02,Default,LILY,0,0,0,,حتى في الأوقات الصعبة أفكر في الطعام.
Dialogue: 0,0:08:59.02,0:09:01.14,Default,LILY,0,0,0,,-أنا أفضل رئيس!\N-حسناً، أنت خارج الخطاف.
Dialogue: 0,0:09:08.66,0:09:10.22,Default,LILY,0,0,0,,امسكني!
Dialogue: 0,0:09:10.90,0:09:13.36,Default,LILY,0,0,0,,اللعنة. كدت أموت.
Dialogue: 0,0:09:17.80,0:09:19.30,Default,LILY,0,0,0,,جميلة، أليس كذلك؟
Dialogue: 0,0:09:46.67,0:09:47.79,Default,LILY,0,0,0,,لا.
Dialogue: 0,0:09:48.00,0:09:51.53,Default,LILY,0,0,0,,عدد كبير جدًا من النساء لم أقابلهن بعد.
Dialogue: 0,0:10:12.66,0:10:15.68,Default,LILY,0,0,0,,مساعدة. أريد أن أعيش.
Dialogue: 0,0:10:16.16,0:10:18.32,Default,LILY,0,0,0,,أريد حقًا أن أعيش.
Dialogue: 0,0:11:08.41,0:11:10.57,Default,LILY,0,0,0,,هل أنا في الجنة؟
Dialogue: 0,0:11:11.55,0:11:13.54,Default,LILY,0,0,0,,لا. سأعيش.
Dialogue: 0,0:11:16.09,0:11:17.35,Default,LILY,0,0,0,,أي نوع من الخرقة؟
Dialogue: 0,0:11:18.39,0:11:20.35,Default,LILY,0,0,0,,هل أنا على قيد الحياة في المشرحة؟
Dialogue: 0,0:11:26.63,0:11:27.86,Default,LILY,0,0,0,,لا، ليس في المشرحة.
Dialogue: 0,0:11:30.10,0:11:32.76,Default,LILY,0,0,0,,معقول، لن أذهب إلى الجنة.
Dialogue: 0,0:11:32.94,0:11:34.51,Default,LILY,0,0,0,,لم أفعل أي خطأ،
Dialogue: 0,0:11:34.51,0:11:35.83,Default,LILY,0,0,0,,لكنها جيدة أيضًا.
Dialogue: 0,0:11:38.48,0:11:41.50,Default,LILY,0,0,0,,ما هذا المكان القديم؟
Dialogue: 0,0:11:53.96,0:11:55.22,Default,LILY,0,0,0,,قرية هانوك؟
Dialogue: 0,0:11:56.60,0:12:00.32,Default,LILY,0,0,0,,لقد سقطت من هذا الارتفاع، لماذا لا يؤلمني شيء؟
Dialogue: 0,0:12:05.67,0:12:08.63,Default,LILY,0,0,0,,بالضبط. القرفصاء يمكن أن ينقذ الأرواح.
Dialogue: 0,0:12:09.21,0:12:11.90,Default,LILY,0,0,0,,هل أنا على قيد الحياة، حسنًا؟ غاليتي ...
Dialogue: 0,0:12:12.51,0:12:14.90,Default,LILY,0,0,0,,ماذا؟ أين ذهبت العضلات؟
Dialogue: 0,0:12:15.65,0:12:18.41,Default,LILY,0,0,0,,أين ذهب أعزائي الذين غمرتهم هذه الصعوبة؟
Dialogue: 0,0:12:19.39,0:12:23.05,Default,LILY,0,0,0,,اللعنة. عندما تفقد العضلات، فإنها تتحول إلى دهون.
Dialogue: 0,0:12:23.69,0:12:25.88,Default,LILY,0,0,0,,كم من الوقت بقيت بالخارج؟
Dialogue: 0,0:12:27.63,0:12:28.82,Default,LILY,0,0,0,,ماذا؟
Dialogue: 0,0:12:29.76,0:12:30.92,Default,LILY,0,0,0,,ما هذا؟
Dialogue: 0,0:13:13.74,0:13:15.53,Default,LILY,0,0,0,,هذا حلم.
Dialogue: 0,0:13:16.08,0:13:18.67,Default,LILY,0,0,0,,كدت أموت، وما زالت النساء في ذهني.
Dialogue: 0,0:13:18.78,0:13:19.97,Default,LILY,0,0,0,,أنا بخير.
Dialogue: 0,0:13:20.45,0:13:24.38,Default,LILY,0,0,0,,ولكن يجب أن أحلم أنني مع امرأة، وليس بدلاً منها.
Dialogue: 0,0:13:24.38,0:13:27.98,Default,LILY,0,0,0,,هناك خط رفيع بين الحلم الجيد والكابوس.
Dialogue: 0,0:13:29.19,0:13:31.95,Default,LILY,0,0,0,,لكنني رأيت هذه المرأة في مكان ما.
Dialogue: 0,0:13:32.29,0:13:33.68,Default,LILY,0,0,0,,على Instagram؟
Dialogue: 0,0:13:34.36,0:13:37.55,Default,LILY,0,0,0,,لا. لقد رأينا بعضنا البعض شخصيا في مكان ما.
Dialogue: 0,0:13:38.03,0:13:40.39,Default,LILY,0,0,0,,سويون؟ تشايونج؟
Dialogue: 0,0:13:46.31,0:13:47.50,Default,LILY,0,0,0,,بحيرة الشبح!
Dialogue: 0,0:13:48.17,0:13:49.68,Default,LILY,0,0,0,,هل تغير صوتك أيضاً؟
Dialogue: 0,0:13:49.68,0:13:50.87,Default,LILY,0,0,0,,صاحب السمو!
Dialogue: 0,0:13:52.61,0:13:54.35,Default,LILY,0,0,0,,لقد استيقظت أخيراً!
Dialogue: 0,0:13:54.35,0:13:56.24,Default,LILY,0,0,0,,كنت أعلم أنك ستستيقظ.
Dialogue: 0,0:13:57.22,0:13:58.47,Default,LILY,0,0,0,,شكرًا لك.
Dialogue: 0,0:13:59.02,0:14:01.01,Default,LILY,0,0,0,,أنا سعيد للغاية.
Dialogue: 0,0:14:03.32,0:14:05.52,Default,LILY,0,0,0,,-لا تتحرك.\N-ماذا؟ لماذا؟
Dialogue: 0,0:14:05.52,0:14:08.85,Default,LILY,0,0,0,,مازلت مريضاً، أنا...
Dialogue: 0,0:14:23.41,0:14:26.64,Default,LILY,0,0,0,,هذا كل شيء. هكذا ينبغي أن يكون الحلم. كم هو جميل...
Dialogue: 0,0:14:30.48,0:14:32.41,Default,LILY,0,0,0,,ما هذا؟ طعم رهيب.
Dialogue: 0,0:14:32.75,0:14:35.01,Default,LILY,0,0,0,,الشرب مزعج للغاية؟
Dialogue: 0,0:14:36.42,0:14:38.88,Default,LILY,0,0,0,,لماذا أشعر بالذوق في أحلامي؟
Dialogue: 0,0:14:40.46,0:14:42.32,Default,LILY,0,0,0,,سأطلب منك إعادة الأمر وإضافة عرق السوس.
Dialogue: 0,0:14:43.33,0:14:46.59,Default,LILY,0,0,0,,أليس هذا حلماً؟
Dialogue: 0,0:14:48.97,0:14:52.26,Default,LILY,0,0,0,,ماذا يحدث بحق الجحيم؟
Dialogue: 0,0:14:55.55,0:14:57.03,Default,LILY,0,0,0,,إنه خطأي.
Dialogue: 0,0:14:57.18,0:15:00.20,Default,LILY,0,0,0,,لم يكن ينبغي لي أن أتركك.
Dialogue: 0,0:15:00.31,0:15:02.35,Default,LILY,0,0,0,,أنا أتوب كثيراً،
Dialogue: 0,0:15:02.35,0:15:05.97,Default,LILY,0,0,0,,أنني لن أتركك لدقيقة أخرى.
Dialogue: 0,0:15:12.16,0:15:13.35,Default,TIRAMISU,0,0,0,,صاحب السمو؟
Dialogue: 0,0:15:34.65,0:15:35.87,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:15:47.09,0:15:48.25,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:15:48.66,0:15:49.75,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:15:50.40,0:15:51.62,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:15:52.36,0:15:53.89,Default,TIRAMISU,0,0,0,,أوه أوه أوه، يا إلهي!
Dialogue: 0,0:15:54.53,0:15:56.33,Default,TIRAMISU,0,0,0,,انتظر يا صاحب السمو!
Dialogue: 0,0:15:56.87,0:15:58.03,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:15:58.44,0:16:00.13,Default,TIRAMISU,0,0,0,,-صاحب السمو!\N-يا رب ارحمني!
Dialogue: 0,0:16:00.31,0:16:02.51,Default,TIRAMISU,0,0,0,,-انهض.\N-أين...
Dialogue: 0,0:16:02.51,0:16:03.60,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:07.38,0:16:08.97,Default,TIRAMISU,0,0,0,,لماذا يتم اضطهادهم؟ إنه مخيف.
Dialogue: 0,0:16:12.12,0:16:15.09,Default,TIRAMISU,0,0,0,,صاحب السمو! لا يجب أن تركض هكذا.
Dialogue: 0,0:16:15.09,0:16:17.38,Default,TIRAMISU,0,0,0,,إلى أين أنت ذاهب يا صاحب السمو؟
Dialogue: 0,0:16:18.49,0:16:20.79,Default,TIRAMISU,0,0,0,,صاحب السمو، إلى أين تهرب؟
Dialogue: 0,0:16:20.79,0:16:23.23,Default,TIRAMISU,0,0,0,,من الخطر الركض بهذه الطريقة! خطير جدا!
Dialogue: 0,0:16:23.23,0:16:24.92,Default,TIRAMISU,0,0,0,,أرجو الانتظار يا صاحب السمو!
Dialogue: 0,0:16:25.13,0:16:26.25,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:27.00,0:16:28.22,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:28.83,0:16:31.59,Default,TIRAMISU,0,0,0,,-صاحب السمو!\N-صاحب السمو!
Dialogue: 0,0:16:31.87,0:16:33.03,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:35.21,0:16:36.53,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:37.11,0:16:38.33,Default,TIRAMISU,0,0,0,,اللعنة!
Dialogue: 0,0:16:38.44,0:16:39.71,Default,TIRAMISU,0,0,0,,انتظر يا صاحب السمو!
Dialogue: 0,0:16:39.71,0:16:41.41,Default,TIRAMISU,0,0,0,,إنها ليست هونغ جيلدون، من أين تأتي مثل هذه القدرات؟
Dialogue: 0,0:16:41.41,0:16:42.45,Default,TIRAMISU,0,0,0,,صاحب السمو.
Dialogue: 0,0:16:42.45,0:16:43.72,Default,TIRAMISU,0,0,0,,-صاحب السمو!\N-أتوسل إليك، لا تركض!
Dialogue: 0,0:16:43.72,0:16:45.11,Default,TIRAMISU,0,0,0,,-صاحب السمو!\N-صاحب السمو!
Dialogue: 0,0:16:45.35,0:16:46.61,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:16:48.22,0:16:49.68,Default,TIRAMISU,0,0,0,,هل هذا قصر؟
Dialogue: 0,0:16:50.56,0:16:53.46,Default,TIRAMISU,0,0,0,,-غريب، غريب جداً.\N-صاحب السمو.
Dialogue: 0,0:16:53.46,0:16:55.02,Default,TIRAMISU,0,0,0,,إذا لم يكن هذا حلماً، فماذا إذن؟
Dialogue: 0,0:16:55.23,0:16:56.43,Default,TIRAMISU,0,0,0,,ماذا يعني كل هذا؟
Dialogue: 0,0:16:56.43,0:16:58.16,Default,TIRAMISU,0,0,0,,-توقف.\N-صاحب السمو.
Dialogue: 0,0:16:58.16,0:17:00.10,Default,TIRAMISU,0,0,0,,-صاحب السمو!\N-صاحب السمو!
Dialogue: 0,0:17:00.10,0:17:01.69,Default,TIRAMISU,0,0,0,,صاحب السمو!
Dialogue: 0,0:17:05.77,0:17:07.70,Default,TIRAMISU,0,0,0,,ولكن الغريب حقاً هو،
Dialogue: 0,0:17:08.34,0:17:11.10,Default,TIRAMISU,0,0,0,,بينما كنت أركض، لم يمنعني شيء.
Dialogue: 0,0:17:13.78,0:17:14.97,Default,TIRAMISU,0,0,0,,لا؟
Dialogue: 0,0:17:16.65,0:17:18.07,Default,TIRAMISU,0,0,0,,أين أقاربي؟
Dialogue: 0,0:17:19.62,0:17:21.51,Default,TIRAMISU,0,0,0,,-يجب ألا تفعل ذلك.\N-أعزائي!
Dialogue: 0,0:17:21.62,0:17:23.21,Default,TIRAMISU,0,0,0,,أين هم؟
Dialogue: 0,0:17:23.52,0:17:25.25,Default,TIRAMISU,0,0,0,,ما الذي تبحث عنه؟
Dialogue: 0,0:17:25.46,0:17:27.92,Default,TIRAMISU,0,0,0,,سأبحث بنفسي عن كل شيء هنا.
Dialogue: 0,0:17:27.93,0:17:29.32,Default,TIRAMISU,0,0,0,,لا تقترب مني!
Dialogue: 0,0:17:32.20,0:17:33.36,Default,TIRAMISU,0,0,0,,اتضح,
Dialogue: 0,0:17:34.83,0:17:36.12,Default,TIRAMISU,0,0,0,,أنا عاجز.
Dialogue: 0,0:17:36.64,0:17:37.67,Default,TIRAMISU,0,0,0,,صاحب السمو.
Dialogue: 0,0:17:37.67,0:17:40.83,Default,TIRAMISU,0,0,0,,لا يمكنك الركض بهذه الطريقة، فقد تتأذى!
Dialogue: 0,0:17:41.51,0:17:45.30,Default,TIRAMISU,0,0,0,,ماذا فعلت بي؟
Dialogue: 0,0:17:46.68,0:17:48.91,Default,TIRAMISU,0,0,0,,إذا كنت قلقاً بشأن صحتك،
Dialogue: 0,0:17:48.91,0:17:51.01,Default,TIRAMISU,0,0,0,,اتصل بالطبيب الملكي.
Dialogue: 0,0:17:52.35,0:17:54.29,Default,TIRAMISU,0,0,0,,لا يهمني من هو، فقط دعه يدس أنفه،
Dialogue: 0,0:17:54.29,0:17:56.68,Default,TIRAMISU,0,0,0,,سأجعله عاجزاً أيضاً!
Dialogue: 0,0:18:00.16,0:18:01.58,Default,TIRAMISU,0,0,0,,ماذا بحق الجحيم.
Dialogue: 0,0:18:01.63,0:18:04.16,Default,TIRAMISU,0,0,0,,هل يفعل المتاجرون بالبشر هذا النوع من الأشياء؟
Dialogue: 0,0:18:04.16,0:18:06.69,Default,TIRAMISU,0,0,0,,لماذا يختطفون رجلاً ويشوهونه بهذه الطريقة؟ لماذا؟
Dialogue: 0,0:18:08.57,0:18:10.67,Default,TIRAMISU,0,0,0,,من عينك؟
Dialogue: 0,0:18:10.67,0:18:13.26,Default,TIRAMISU,0,0,0,,هل هذا الغبي بو سيونغمين\N يفرغ غضبه مني؟
Dialogue: 0,0:18:13.77,0:18:14.86,Default,TIRAMISU,0,0,0,,ماذا؟
Dialogue: 0,0:18:16.14,0:18:17.57,Default,TIRAMISU,0,0,0,,أو ربما المخرج خان؟
Dialogue: 0,0:18:18.04,0:18:20.05,Default,TIRAMISU,0,0,0,,هل هذا سبب إجراء العملية الجراحية لي؟
Dialogue: 0,0:18:20.05,0:18:21.55,Default,TIRAMISU,0,0,0,,ماذا، هل يجب أن أطلب منك،
Dialogue: 0,0:18:21.55,0:18:25.37,Default,TIRAMISU,0,0,0,,هل يمكنك بسهولة تغيير جنس الشخص؟
Dialogue: 0,0:18:34.96,0:18:38.49,Default,TIRAMISU,0,0,0,,ولكن لماذا ترتدين جميعاً ملابس كهذه؟
Dialogue: 0,0:18:40.57,0:18:43.29,Default,TIRAMISU,0,0,0,,كما لو أنني قمت بقفزة زمنية.
Dialogue: 0,0:18:52.18,0:18:54.40,Default,TIRAMISU,0,0,0,,ماذا؟
Dialogue: 0,0:19:04.09,0:19:06.55,Default,TIRAMISU,0,0,0,,في أي عام ولدت؟
Dialogue: 0,0:19:07.09,0:19:09.85,Default,TIRAMISU,0,0,0,,لقد ولدت في 31 مايو 1988 تحت برج الجوزاء.
Dialogue: 0,0:19:11.93,0:19:13.86,Default,TIRAMISU,0,0,0,,أين تعيش؟
Dialogue: 0,0:19:13.97,0:19:15.90,Default,TIRAMISU,0,0,0,,سيول، جونغنو غو، سامبونرو 31
Dialogue: 0,0:19:15.90,0:19:17.56,Default,TIRAMISU,0,0,0,,سوجونغ باركفيل، شقة 302.
Dialogue: 0,0:19:18.67,0:19:21.06,Default,TIRAMISU,0,0,0,,ما اسم والديك؟
Dialogue: 0,0:19:21.44,0:19:23.51,Default,TIRAMISU,0,0,0,,اسم الأب هو تشانغ جيريونغ، واسم الأم لي سوجين.
Dialogue: 0,0:19:23.51,0:19:25.21,Default,TIRAMISU,0,0,0,,أحدهما يعلم اللغة الصينية والآخر يعلم التاريخ الكوري.
Dialogue: 0,0:19:25.21,0:19:26.24,Default,TIRAMISU,0,0,0,,إنهم معلمون مقتنعون،
Dialogue: 0,0:19:26.24,0:19:28.17,Default,TIRAMISU,0,0,0,,وأنا ابنهم المجنون والغبي والوحيد.
Dialogue: 0,0:19:28.55,0:19:30.87,Default,TIRAMISU,0,0,0,,ماذا؟ هل هناك أي شيء آخر تريد معرفته؟
Dialogue: 0,0:19:53.51,0:19:54.90,Default,TIRAMISU,0,0,0,,هل يمكنك دغدغتي؟
Dialogue: 0,0:19:57.68,0:19:58.80,Default,TIRAMISU,0,0,0,,هل أعجبك هذا؟
Dialogue: 0,0:20:03.01,0:20:04.87,Default,TIRAMISU,0,0,0,,لذا فهذا ليس حلماً.
Dialogue: 0,0:20:05.12,0:20:06.64,Default,TIRAMISU,0,0,0,,كل شيء حقيقي للغاية.
Dialogue: 0,0:20:07.45,0:20:09.45,Default,TIRAMISU,0,0,0,,إذن التفسير الوحيد هو روحي
Dialogue: 0,0:20:09.45,0:20:11.81,Default,TIRAMISU,0,0,0,,عاد الزمن إلى الوراء وسكن هذا الجسد.
Dialogue: 0,0:20:13.46,0:20:14.78,Default,TIRAMISU,0,0,0,,يمكنني الاستيقاظ.
Dialogue: 0,0:20:15.66,0:20:17.22,Default,TIRAMISU,0,0,0,,وسوف تغادر روحي هذا الجسد.
Dialogue: 0,0:20:18.96,0:20:20.06,Default,TIRAMISU,0,0,0,,استمع.
Dialogue: 0,0:20:20.27,0:20:22.89,Default,TIRAMISU,0,0,0,,أخبرني بكل ما تعرفه عن هذه المرأة.
Dialogue: 0,0:20:23.57,0:20:24.76,Default,TIRAMISU,0,0,0,,هذه المرأة؟
Dialogue: 0,0:20:24.90,0:20:27.76,Default,TIRAMISU,0,0,0,,أنا أتحدث إلى نفسي. أخبرني ماذا حدث لي.
Dialogue: 0,0:20:28.71,0:20:30.24,Default,TIRAMISU,0,0,0,,كل هذا خطأي.
Dialogue: 0,0:20:30.24,0:20:31.97,Default,TIRAMISU,0,0,0,,لم أعلم أنك رحلت من دوني.
Dialogue: 0,0:20:33.25,0:20:34.74,Default,TIRAMISU,0,0,0,,أنا أستحق أن أموت يا صاحب السمو.
Dialogue: 0,0:20:36.35,0:20:37.92,Default,TIRAMISU,0,0,0,,سأقتلك إذا كان هذا
Dialogue: 0,0:20:37.92,0:20:39.51,Default,TIRAMISU,0,0,0,,سيحل مشكلتي.
Dialogue: 0,0:20:40.45,0:20:41.71,Default,TIRAMISU,0,0,0,,لكن الأمر لن يسير بهذه الطريقة.
Dialogue: 0,0:20:42.69,0:20:44.18,Default,TIRAMISU,0,0,0,,اهدأ.
Dialogue: 0,0:20:44.76,0:20:46.65,Default,TIRAMISU,0,0,0,,لا تبكي. مثله.
Dialogue: 0,0:20:47.36,0:20:50.49,Default,TIRAMISU,0,0,0,,متى وأين ذهبت وحدي؟
Dialogue: 0,0:20:52.30,0:20:53.46,Default,TIRAMISU,0,0,0,,حسناً،
Dialogue: 0,0:20:54.77,0:20:56.70,Default,TIRAMISU,0,0,0,,قبل ليلتين قلت إنك متعب،
Dialogue: 0,0:20:56.70,0:20:58.99,Default,TIRAMISU,0,0,0,,ولذلك طلب مني تجهيز الغرفة للنوم مبكراً.
Dialogue: 0,0:21:00.21,0:21:02.63,Default,TIRAMISU,0,0,0,,وتأكدت بالتأكيد من أنك نائم،
Dialogue: 0,0:21:02.84,0:21:04.67,Default,TIRAMISU,0,0,0,,قبل العودة إلى العمل.
Dialogue: 0,0:21:15.69,0:21:17.09,Default,TIRAMISU,0,0,0,,لماذا يجب علينا القيام بدوريات؟
Dialogue: 0,0:21:17.09,0:21:19.68,Default,TIRAMISU,0,0,0,,وضعنا مرتفع جدًا بالنسبة لهذا.
Dialogue: 0,0:21:20.09,0:21:21.96,Default,TIRAMISU,0,0,0,,أنت تعمل في القصر منذ عامين فقط.
Dialogue: 0,0:21:21.96,0:21:23.52,Default,TIRAMISU,0,0,0,,هل تتمتع بمثل هذه المكانة الرفيعة؟
Dialogue: 0,0:21:23.66,0:21:25.36,Default,TIRAMISU,0,0,0,,أنت الأخ الأكبر لجلالة الملك.
Dialogue: 0,0:21:25.36,0:21:27.09,Default,TIRAMISU,0,0,0,,وأنا أفضل صديق لجلالة الملك.
Dialogue: 0,0:21:27.10,0:21:28.59,Default,TIRAMISU,0,0,0,,هذا هو حالنا.
Dialogue: 0,0:21:28.63,0:21:30.46,Default,TIRAMISU,0,0,0,,تكلم كأحد الوزراء.
Dialogue: 0,0:21:31.20,0:21:33.80,Default,SINGER,0,0,0,,أوه، بالضبط. هل سمعت؟
Dialogue: 0,0:21:33.91,0:21:35.73,Default,SINGER,0,0,0,,عن فتاة أم شبح؟
Dialogue: 0,0:21:35.87,0:21:38.63,Default,SINGER,0,0,0,,في كل مرة تهمس فيها وتشعر بالقلق الشديد،
Dialogue: 0,0:21:38.84,0:21:40.27,Default,SINGER,0,0,0,,تحدث عن واحد منهم.
Dialogue: 0,0:21:40.31,0:21:42.24,Default,SINGER,0,0,0,,أنا أتحدث عن شبح عذراء.
Dialogue: 0,0:21:42.55,0:21:43.74,Default,SINGER,0,0,0,,عن كليهما.
Dialogue: 0,0:21:44.05,0:21:46.68,Default,SINGER,0,0,0,,عن روح الماء من تلك البحيرة.
Dialogue: 0,0:22:02.07,0:22:04.54,Default,SINGER,0,0,0,,لقد قفزوا في الماء وأنقذوك.
Dialogue: 0,0:22:04.54,0:22:06.87,Default,SINGER,0,0,0,,فحص الطبيب النبض وقال إن كل شيء على ما يرام.
Dialogue: 0,0:22:06.87,0:22:08.04,Default,SINGER,0,0,0,,لكن ما الغريب،
Dialogue: 0,0:22:08.04,0:22:12.33,Default,SINGER,0,0,0,,أنت لم تستيقظ طوال اليوم.
Dialogue: 0,0:22:13.41,0:22:15.00,Default,SINGER,0,0,0,,ثم استيقظت للتو؟
Dialogue: 0,0:22:17.32,0:22:18.74,Default,SINGER,0,0,0,,توتشنياك، ماء.
Dialogue: 0,0:22:18.98,0:22:20.99,Default,SINGER,0,0,0,,سقطنا أنا وهي في الماء.
Dialogue: 0,0:22:20.99,0:22:22.74,Default,SINGER,0,0,0,,وهناك اختلطت أرواحنا.
Dialogue: 0,0:22:24.32,0:22:26.25,Default,SINGER,0,0,0,,خذني إلى البحيرة.
Dialogue: 0,0:22:34.23,0:22:35.86,Default,SINGER,0,0,0,,قلت لك ألا تتبعني.
Dialogue: 0,0:22:36.43,0:22:38.50,Default,SINGER,0,0,0,,لا أستطيع التذكر،
Dialogue: 0,0:22:38.50,0:22:40.14,Default,SINGER,0,0,0,,عندما سقطت في الماء.
Dialogue: 0,0:22:40.14,0:22:41.30,Default,SINGER,0,0,0,,هل تشعر بالقلق؟
Dialogue: 0,0:22:42.87,0:22:44.97,Default,SINGER,0,0,0,,أيها الأتباع اللعينون.
Dialogue: 0,0:22:45.38,0:22:47.64,Default,SINGER,0,0,0,,لن يسمحوا لك بالقفز في الماء.
Dialogue: 0,0:22:49.28,0:22:51.25,Default,SINGER,0,0,0,,هل نسير على الطريق الصحيح؟
Dialogue: 0,0:22:51.25,0:22:53.38,Default,SINGER,0,0,0,,هذا قصر واحد. لماذا هو بعيد جدا؟
Dialogue: 0,0:22:54.12,0:22:55.81,Default,SINGER,0,0,0,,كنا على وشك الوصول يا صاحب السمو.
Dialogue: 0,0:22:56.55,0:22:59.81,Default,SINGER,0,0,0,,البحيرة التي سقطت فيها تقع خلف ذلك الحجر.
Dialogue: 0,0:23:01.23,0:23:02.38,Default,SINGER,0,0,0,,كمين!
Dialogue: 0,0:23:03.63,0:23:04.85,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:06.63,0:23:08.79,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:09.17,0:23:10.33,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:10.94,0:23:13.03,Default,SINGER,0,0,0,,صاحب السمو، لا تفعل ذلك!
Dialogue: 0,0:23:13.97,0:23:15.24,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:15.24,0:23:17.23,Default,SINGER,0,0,0,,توقف!
Dialogue: 0,0:23:17.64,0:23:19.47,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:19.88,0:23:21.77,Default,SINGER,0,0,0,,هذا أمر خطير يا صاحب السمو!
Dialogue: 0,0:23:25.48,0:23:29.44,Default,SINGER,0,0,0,,دعونا نعود. أعود إلى حياتي وجسدي الثمين.
Dialogue: 0,0:23:30.59,0:23:32.18,Default,SINGER,0,0,0,,أقوم أحياناً بأعمال صالحة.
Dialogue: 0,0:23:32.49,0:23:34.98,Default,SINGER,0,0,0,,من فضلك، أيها القدير، بوذا، مريم العذراء.
Dialogue: 0,0:23:43.67,0:23:45.39,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:23:56.75,0:23:58.51,Default,SINGER,0,0,0,,هل أنت بخير حقاً؟
Dialogue: 0,0:23:59.08,0:24:01.14,Default,SINGER,0,0,0,,لماذا لا يوجد ماء هناك؟
Dialogue: 0,0:24:02.55,0:24:04.65,Default,SINGER,0,0,0,,جفاف أم قصف أم ماذا؟
Dialogue: 0,0:24:05.16,0:24:06.83,Default,SINGER,0,0,0,,حتى لا يتكرر هذا مرة أخرى،
Dialogue: 0,0:24:06.83,0:24:08.78,Default,SINGER,0,0,0,,لقد تم تجفيف الماء يا صاحب السمو!
Dialogue: 0,0:24:09.06,0:24:11.19,Default,SINGER,0,0,0,,ولم تكن في عجلة من أمرك لتخبرني.
Dialogue: 0,0:24:11.53,0:24:13.37,Default,SINGER,0,0,0,,عذراً يا صاحب السمو.
Dialogue: 0,0:24:13.37,0:24:14.83,Default,SINGER,0,0,0,,صاحب السمو!
Dialogue: 0,0:24:14.83,0:24:16.90,Default,SINGER,0,0,0,,اللعنة. إنه سخيف "صاحب السمو".
Dialogue: 0,0:24:16.90,0:24:18.73,Default,SINGER,0,0,0,,سأكون مريضاً الآن.
Dialogue: 0,0:24:19.47,0:24:20.96,Default,SINGER,0,0,0,,لماذا تناديني بهذا الاسم؟
Dialogue: 0,0:24:22.11,0:24:24.94,Default,SINGER,0,0,0,,صاحبة السمو ليست على ما يرام.
Dialogue: 0,0:24:24.94,0:24:27.00,Default,SINGER,0,0,0,,خاطبها بالسيدة.
Dialogue: 0,0:24:27.15,0:24:28.34,Default,SINGER,0,0,0,,نعم.
Dialogue: 0,0:24:29.98,0:24:32.04,Default,SINGER,0,0,0,"صاحب السمو المقدر"؟ ما الذي تتحدث عنه؟
Dialogue: 0,0:24:33.45,0:24:36.08,Default,SINGER,0,0,0,,لقد تم اختيارك قبل الزفاف.
Dialogue: 0,0:24:36.22,0:24:38.35,Default,SINGER,0,0,0,,لذلك تُدعى صاحب السمو المقدر.
Dialogue: 0,0:24:39.89,0:24:41.12,Default,SINGER,0,0,0,,"مُنتخب"؟
Dialogue: 0,0:24:43.19,0:24:44.30,Default,SINGER,0,0,0,,إذن هذا يعني...
Dialogue: 0,0:24:44.30,0:24:47.09,Default,SINGER,0,0,0,,سوف تصبحين ملكة.
Dialogue: 0,0:24:49.53,0:24:53.70,Default,SINGER,0,0,0,,إذن أنت الآن تقول أنني سأكون زوجة الملك؟
Dialogue: 0,0:24:54.61,0:24:55.76,Default,SINGER,0,0,0,,نعم.
Dialogue: 0,0:24:57.84,0:25:01.54,Default,SINGER,0,0,0,,أنا مجنون الآن، بجدية!
Dialogue: 0,0:25:01.75,0:25:03.68,Default,SINGER,0,0,0,,سامحنا،
Dialogue: 0,0:25:03.68,0:25:05.27,Default,SINGER,0,0,0,,السيدة.
Dialogue: 0,0:25:39.08,0:25:41.19,Default,SINGER,0,0,0,,كيف يمكنك أن تكوني بهذا الجمال؟
Dialogue: 0,0:25:41.19,0:25:42.52,Default,SINGER,0,0,0,,وسيم جداً.
Dialogue: 0,0:25:42.52,0:25:44.46,Default,SINGER,0,0,0,,ويا لها من أصابع رشيقة.
Dialogue: 0,0:25:44.46,0:25:46.41,Default,SINGER,0,0,0,,أوه يا أمهات.
Dialogue: 0,0:26:13.99,0:26:15.18,Default,SINGER,0,0,0,,جلالتك.
Dialogue: 0,0:26:15.42,0:26:17.96,Default,SINGER,0,0,0,,لقد مرت ساعتان بالفعل.
Dialogue: 0,0:26:17.96,0:26:19.68,Default,SINGER,0,0,0,,أنا قلقة على صحتك.
Dialogue: 0,0:26:20.76,0:26:23.18,Default,SINGER,0,0,0,,أنصحك بالانتهاء لهذا اليوم.
Dialogue: 0,0:26:23.50,0:26:24.62,Default,SINGER,0,0,0,,رئيس الخصي.
Dialogue: 0,0:26:25.50,0:26:27.89,Default,SINGER,0,0,0,,للملك المسؤول عن البلاد،
Dialogue: 0,0:26:28.03,0:26:31.53,Default,SINGER,0,0,0,,الرغبة في إنجاب وريث يجب أن تكون الأولوية.
Dialogue: 0,0:26:32.10,0:26:34.94,Default,SINGER,0,0,0,,أنا متعب للغاية، هذه المهمة متعبة جداً بالنسبة لي.
Dialogue: 0,0:26:34.94,0:26:37.37,Default,SINGER,0,0,0,,لا أستطيع التوقف عن التعلم.
Dialogue: 0,0:26:45.55,0:26:47.98,Default,SINGER,0,0,0,,حسنًا، خيار السفر عبر الزمن ليس كهذا.
Dialogue: 0,0:26:48.25,0:26:49.51,Default,SINGER,0,0,0,,لكن لماذا المرأة؟
Dialogue: 0,0:26:49.75,0:26:52.35,Default,SINGER,0,0,0,,وليس فقط من أي نوع، ولكن فقط عن الملكة؟
Dialogue: 0,0:26:53.29,0:26:54.96,Default,SINGER,0,0,0,,أنا لا أؤمن بالزواج.
Dialogue: 0,0:26:54.96,0:26:56.48,Default,SINGER,0,0,0,,لماذا يجب أن أكون زوجة الملك؟
Dialogue: 0,0:26:57.03,0:26:58.15,Default,SINGER,0,0,0,,هيا.
Dialogue: 0,0:26:59.03,0:27:02.02,Default,SINGER,0,0,0,,إذا أصبحت ملكة، فهل هذا يعني أنني أنتمي إلى عائلة نبيلة؟
Dialogue: 0,0:27:03.43,0:27:06.16,Default,SINGER,0,0,0,,هل ترغبين في الاستحمام يا سيدتي؟
Dialogue: 0,0:27:10.21,0:27:12.77,Default,SINGER,0,0,0,,نادني بصاحب السمو. اتصل طوال اليوم.
Dialogue: 0,0:27:14.01,0:27:15.70,Default,SINGER,0,0,0,,صاحب السمو.
Dialogue: 0,0:27:16.41,0:27:18.51,Default,SINGER,0,0,0,,أنا الملكة. أيضًا؟
Dialogue: 0,0:27:18.92,0:27:20.92,Default,SINGER,0,0,0,,نعم يا صاحب السمو.
Dialogue: 0,0:27:20.92,0:27:22.58,Default,SINGER,0,0,0,,لذلك أنا آمرك.
Dialogue: 0,0:27:23.12,0:27:25.45,Default,SINGER,0,0,0,,كان الأمر مثيراً للغضب، لكنه الآن مجرد موسيقى تطرب أذني.
Dialogue: 0,0:27:26.76,0:27:27.98,Default,SINGER,0,0,0,,استمع.
Dialogue: 0,0:27:28.53,0:27:31.03,Default,SINGER,0,0,0,,املأ البحيرة بالماء الآن.
Dialogue: 0,0:27:31.03,0:27:32.22,Default,SINGER,0,0,0,,هذا أمر.
Dialogue: 0,0:27:34.33,0:27:36.32,Default,SINGER,0,0,0,,سهل، ما الذي لم يخطر ببالك على الفور؟
Dialogue: 0,0:27:38.30,0:27:40.29,Default,SINGER,0,0,0,,لا نستطيع يا صاحب السمو.
Dialogue: 0,0:27:41.77,0:27:42.93,Default,SINGER,0,0,0,,ماذا؟
Dialogue: 0,0:27:44.48,0:27:48.30,Default,SINGER,0,0,0,,سوف تعود إلى رشدك عندما أظهر لك قوتي.
Dialogue: 0,0:27:57.22,0:27:58.81,Default,SINGER,0,0,0,,ارحمك يا صاحب السمو.
Dialogue: 0,0:27:59.67,0:28:01.08,Default,SINGER,0,0,0,,أنا أستحق أن أموت.
Dialogue: 0,0:28:01.08,0:28:03.50,Default,SINGER,0,0,0,,ولكن لا يزال. من فضلك ارحم!
Dialogue: 0,0:28:06.41,0:28:08.91,Default,SINGER,0,0,0,,هاه؟ أي نوع من رد الفعل؟
Dialogue: 0,0:28:10.54,0:28:12.56,Default,SINGER,0,0,0,,لقد عدت أخيراً إلى صوابي.
Dialogue: 0,0:28:14.31,0:28:17.08,Default,SINGER,0,0,0,,بما أنه يعذب سيدات البلاط بهذه الطريقة،
Dialogue: 0,0:28:17.08,0:28:19.37,Default,SINGER,0,0,0,,من الواضح أنها تتمتع بصحة جيدة.
Dialogue: 0,0:28:21.14,0:28:22.44,Default,SINGER,0,0,0,,أحضرها.
Dialogue: 0,0:28:23.14,0:28:24.44,Default,SINGER,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:28:32.65,0:28:36.35,Default,SINGER,0,0,0,,جلالة الملك يرغب في رؤيتك في شرفة منزله.
Dialogue: 0,0:28:38.33,0:28:40.69,Default,SINGER,0,0,0,,جلالتك.
Dialogue: 0,0:28:43.04,0:28:44.16,Default,SINGER,0,0,0,,جلالتك؟
Dialogue: 0,0:28:47.90,0:28:50.90,Default,SINGER,0,0,0,,نعم الزعيم المحلي.
Dialogue: 0,0:29:18.24,0:29:22.53,Default,SINGER,0,0,0,,حسناً، كما تتوقع، فلتذهب الطاقة إلى الجحيم.
Dialogue: 0,0:29:24.78,0:29:26.44,Default,PINEAPPELLER,0,0,0,,يا صاحب الجلالة، لن تصدق ذلك.
Dialogue: 0,0:29:30.61,0:29:32.54,Default,PINEAPPELLER,0,0,0,,ماذا حدث لك باسم السلام؟
Dialogue: 0,0:29:33.41,0:29:36.35,Default,PINEAPPELLER,0,0,0,,-نعم، إنها مجرد تافهة.\N-A تافهة؟
Dialogue: 0,0:29:36.36,0:29:40.38,Default,PINEAPPELLER,0,0,0,,يجب أن تبدو أنيقًا وتتصرف وفقًا لحالتك.
Dialogue: 0,0:29:40.38,0:29:42.72,Default,PINEAPPELLER,0,0,0,,نعم، أفهم،\Nفقط استمع، هذا مهم.
Dialogue: 0,0:29:42.72,0:29:44.06,Default,PINEAPPELLER,0,0,0,,عالم
Dialogue: 0,0:29:44.36,0:29:47.50,Default,PINEAPPELLER,0,0,0,,يجب أن يستيقظ مع أول ديوك في الصباح،
Dialogue: 0,0:29:47.50,0:29:50.53,Default,PINEAPPLE,0,0,0,,تبدو أنيقة ولا تحب...
Dialogue: 0,0:29:53.13,0:29:54.67,Default,PINEAPPELLER,0,0,0,,لا تنسَ...
Dialogue: 0,0:29:55.04,0:29:57.97,Default,PINEAPPELLER,0,0,0,,لا تنس ضميرك، كن طيب الطباع دائماً!
Dialogue: 0,0:29:58.87,0:30:01.97,Default,PINEAPPELLER,0,0,0,,ثم سنتحدث عن الفلسفة.\Nحدث شيء مهم.
Dialogue: 0,0:30:02.44,0:30:05.21,Default,PINEAPPELLER,0,0,0,,أحتاج إلى الماء بشكل عاجل.
Dialogue: 0,0:30:05.21,0:30:08.65,Default,PINEANANCE,0,0,0,,أينوك، أحضر الماء إلى الملكة المستقبلية الآن.
Dialogue: 0,0:30:08.65,0:30:11.18,Default,PINEAPPELLER,0,0,0,,ليس هذا ما أتحدث عنه!
Dialogue: 0,0:30:11.18,0:30:12.85,Default,PINEAPPELLER,0,0,0,,أحتاج إلى بحيرة!
Dialogue: 0,0:30:13.80,0:30:15.42,Default,PINEAPPELLER,0,0,0,,لم يبق ماء في البحيرات.
Dialogue: 0,0:30:15.80,0:30:17.62,Default,PINEAPPELLER,0,0,0,,هل تريد,
Dialogue: 0,0:30:17.62,0:30:20.22,Default,PINEAPPELLER,0,0,0,,حتى أملأ البحيرة بالماء؟
Dialogue: 0,0:30:21.57,0:30:23.16,Default,PINEAPPELLER,0,0,0,,صحيح!
Dialogue: 0,0:30:23.19,0:30:24.36,Default,PINEAPPELLER,0,0,0,,لا أستطيع.
Dialogue: 0,0:30:25.27,0:30:29.10,Default,PINEAPPELLER,0,0,0,,-لماذا؟\N-هذا هو ترتيب الملكة الأرملة.
Dialogue: 0,0:30:29.13,0:30:32.87,Default,PINEANANCE,0,0,0,,سأملأ البحيرة بالماء -\NI سوف يخالف أمرها.
Dialogue: 0,0:30:33.64,0:30:35.01,Default,PINEAPPELLER,0,0,0,,حسناً، من منكم هو الملك؟
Dialogue: 0,0:30:36.52,0:30:39.14,Default,PINEAPPELLER,0,0,0,,أي نوع من الملوك أنت،\Nلا يمكنك حتى ملء بحيرة؟
Dialogue: 0,0:30:43.38,0:30:45.48,Default,PINEAPPELLER,0,0,0,,يجب أن أستمع إلى الملكة الأرملة،
Dialogue: 0,0:30:45.49,0:30:49.02,Default,PINEAPPELLER,0,0,0,,إنها قلقة للغاية بشأن ما حدث.
Dialogue: 0,0:30:49.33,0:30:52.52,Default,PINEAPPELLER,0,0,0,,إلى جانب ذلك، أنا أوافق على قرار تجفيف البحيرة.
Dialogue: 0,0:30:55.36,0:30:56.66,Default,PINEAPPELLER,0,0,0,,وما الجيد في ذلك؟
Dialogue: 0,0:30:57.27,0:30:58.80,Default,PINEAPPELLER,0,0,0,,اشرح لي بشكل طبيعي.
Dialogue: 0,0:31:02.47,0:31:03.54,Default,PINEAPPELLER,0,0,0,,بسيطة.
Dialogue: 0,0:31:03.54,0:31:05.17,Default,PINEAPPELLER,0,0,0,,هل تمزح معي؟
Dialogue: 0,0:31:12.25,0:31:14.15,Default,PINEAPPELLER,0,0,0,,كيف تجرؤ على رفع يدك عليّ؟
Dialogue: 0,0:31:14.15,0:31:16.82,Default,PINEAPPELLER,0,0,0,,يبدو أنك قررت أنك عالم محترم.
Dialogue: 0,0:31:16.82,0:31:19.33,Default,PINEAPPELLER,0,0,0,,ولكن هل من الممكن أن تمسك أنفك عند الجلوس أمام شخص ما،
Dialogue: 0,0:31:19.33,0:31:20.82,Default,PINEAPPELLER,0,0,0,,أليس هذا قمة الفحش؟
Dialogue: 0,0:31:26.89,0:31:29.13,Default,PINEAPPELLER,0,0,0,,أنا سعيد لأنك تعافيت.
Dialogue: 0,0:31:29.43,0:31:31.13,Default,PINEAPPELLER,0,0,0,,كنت قلقة للغاية.
Dialogue: 0,0:31:31.43,0:31:34.57,Default,PINEAPPELLER,0,0,0,,نعم، إنه يحمل الإخلاص على بعد كيلومتر واحد.
Dialogue: 0,0:31:35.20,0:31:37.70,Default,PINEAPPELLER,0,0,0,,هل تحدثت دائمًا بهذه الطريقة؟
Dialogue: 0,0:31:38.75,0:31:41.11,Default,PINEAPPELLER,0,0,0,,كدت أموت،\NIلقد امتلأ بالغضب.
Dialogue: 0,0:31:41.55,0:31:43.87,Default,PINEAPPELLER,0,0,0,,كيف سقطت في البحيرة أصلاً؟
Dialogue: 0,0:31:44.35,0:31:49.18,Default,PINEAPPELLER,0,0,0,,ملكة المستقبل لا تتذكر هذا.
Dialogue: 0,0:31:50.62,0:31:52.08,Default,PINEAPPELLER,0,0,0,,ألا تتذكر؟
Dialogue: 0,0:31:52.45,0:31:53.78,Default,PINEAPPELLER,0,0,0,,كيف غريب.
Dialogue: 0,0:31:54.62,0:31:56.95,Default,PINEANANCE,0,0,0,,إذن قرأت "الترجمة السبعينيّة"!
Dialogue: 0,0:31:56.95,0:31:59.22,Default,PINEAPPELLER,0,0,0,,أنا أحب هذه المجموعة!
Dialogue: 0,0:32:01.74,0:32:05.33,Default,PINEAPPELLER,0,0,0,,أكره عندما يلمس الناس كتبي.
Dialogue: 0,0:32:07.37,0:32:09.70,Default,PINEAPPELLER,0,0,0,,كيف يمكن أن يكون هذا؟\NI لمست كتابك.
Dialogue: 0,0:32:11.17,0:32:13.35,Default,PINEAPPELLER,0,0,0,,إنها قذرة بالفعل على أية حال.\Nدعني أرى.
Dialogue: 0,0:32:13.35,0:32:17.44,Default,PINEAPPELLER,0,0,0,,توقف!\NA الزوجة يجب أن تطيع الرجل.
Dialogue: 0,0:32:18.52,0:32:20.11,Default,PINEAPPELLER,0,0,0,,يجب عليها أن تطيع زوجها.
Dialogue: 0,0:32:20.65,0:32:21.91,Default,PINEAPPELLER,0,0,0,,هذا ما قلته.
Dialogue: 0,0:32:21.91,0:32:23.95,Default,PINEAPPELLER,0,0,0,,-لقد قلت "يا رجل".\N-أوقفه!
Dialogue: 0,0:32:23.95,0:32:25.92,Default,PINEAPPELLER,0,0,0,,يين لا يعارض اليانغ،
Dialogue: 0,0:32:25.92,0:32:29.22,Default,PINEAPPELLER,0,0,0,,والزوجة تخضع لزوجها!
Dialogue: 0,0:32:30.00,0:32:31.79,Default,PINEAPPELLER,0,0,0,,هل نعيش في جوسون؟
Dialogue: 0,0:32:31.86,0:32:33.19,Default,PINEAPPELLER,0,0,0,,في جوسون.
Dialogue: 0,0:32:33.53,0:32:35.39,Default,PINEAPPELLER,0,0,0,,وربما تتخيل نفسك ملكاً.
Dialogue: 0,0:32:36.04,0:32:37.96,Default,PINEAPPELLER,0,0,0,,أنا الملك.
Dialogue: 0,0:32:40.63,0:32:41.77,Default,PINEAPPELLER,0,0,0,,أيها الأسلاف، ساعدوها.
Dialogue: 0,0:32:45.44,0:32:47.20,Default,PINEAPPELLER,0,0,0,,امرأة مقرفة.
Dialogue: 0,0:32:50.88,0:32:52.08,Default,PINEAPPELLER,0,0,0,,دعني أذهب.
Dialogue: 0,0:32:55.09,0:32:56.28,Default,PINEAPPELLER,0,0,0,,أطلق سراحه.
Dialogue: 0,0:32:57.49,0:33:00.42,Default,PINEAPPELLER,0,0,0,,اترك الكتاب، ماذا تفعل؟
Dialogue: 0,0:33:00.59,0:33:02.72,Default,PINEAPPELLER,0,0,0,,هناك شيء غير نظيف هنا.
Dialogue: 0,0:33:04.83,0:33:06.16,Default,PINEAPPLE,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:33:08.60,0:33:11.46,Default,PINEAPPELLER,0,0,0,,حان وقت استقبال المسؤولين.
Dialogue: 0,0:33:11.81,0:33:14.20,Default,PINEAPPELLER,0,0,0,,ألم يحن الوقت بعد؟
Dialogue: 0,0:33:14.67,0:33:17.47,Default,PINEAPPELLER,0,0,0,,يوم الملك يحكم البلاد،
Dialogue: 0,0:33:17.47,0:33:19.64,Default,PINEAPPELLER,0,0,0,,يمتد مثل شريط لا نهاية له...
Dialogue: 0,0:33:19.64,0:33:22.84,Default,PINEAPPELLER,0,0,0,,حسناً، أنت مشغول! سأذهب.
Dialogue: 0,0:33:49.67,0:33:52.04,Default,PINEANANCE,0,0,0,,الخصي!
Dialogue: 0,0:33:52.05,0:33:53.94,Default,PINEAPPELLER,0,0,0,,نعم!
Dialogue: 0,0:34:18.03,0:34:19.36,Default,PINEANANCE,0,0,0,,الخصي,
Dialogue: 0,0:34:19.70,0:34:22.67,Default,PINEANANCE,0,0,0,,أنت تعلم كم أقدر هذه المجموعة.
Dialogue: 0,0:34:25.01,0:34:26.78,Default,PINEAPPELLER,0,0,0,,مع التقدم في السن أصبحت أبطأ.
Dialogue: 0,0:34:26.78,0:34:29.17,Default,PINEAPPELLER,0,0,0,,انزلقت اليد يا سيدي.
Dialogue: 0,0:34:29.24,0:34:32.74,Default,PINEAPPELLER,0,0,0,,يكلف هذا الكتاب ثلاثة من راتبك الشهري.
Dialogue: 0,0:34:33.22,0:34:35.18,Default,PINEAPPELLER,0,0,0,,أنا أستحق أن أموت!
Dialogue: 0,0:34:39.55,0:34:41.62,Default,PINEAPPELLER,0,0,0,,لا، لن تموت.
Dialogue: 0,0:34:41.95,0:34:44.20,Default,PINEAPPELLER,0,0,0,,بغض النظر عن ثمن هذا الكتاب،
Dialogue: 0,0:34:44.20,0:34:46.86,Default,PINEAPPELLER,0,0,0,,حياة الإنسان أكثر قيمة بكثير.
Dialogue: 0,0:34:47.07,0:34:50.66,Default,PINEAPPLE,0,0,0,,رحمتك لا حدود لها يا صاحب الجلالة.
Dialogue: 0,0:34:53.03,0:34:56.60,Default,PINEAPPELLER,0,0,0,,أنت تكافح من أجل المعرفة\Nبنفس الحماس الذي أسعى إليه.
Dialogue: 0,0:34:56.91,0:35:00.40,Default,PINEAPPELLER,0,0,0,,سأعدّ لك كتباً جديدة.
Dialogue: 0,0:35:01.01,0:35:03.21,Default,PINEAPPELLER,0,0,0,,ولكن الآن لدي اجتماع مع المسؤولين.
Dialogue: 0,0:35:07.76,0:35:09.01,Default,PINEAPPELLER,0,0,0,,الخدم,
Dialogue: 0,0:35:10.09,0:35:11.75,Default,PINEAPPELLER,0,0,0,,جهز محفتي.
Dialogue: 0,0:35:15.22,0:35:17.89,Default,PINEAPPELLER,0,0,0,,أعطني توصيلة.\Nالأماكن هنا ممتلئة.
Dialogue: 0,0:35:20.20,0:35:22.99,Default,PINEAPPELLER,0,0,0,,لا أريد ذلك، سيكون المكان مكتظاً ببعضه البعض.
Dialogue: 0,0:35:23.74,0:35:26.56,Default,PINEAPPELLER,0,0,0,,وأخيراً اغتسل.
Dialogue: 0,0:35:29.41,0:35:30.77,Default,PINEAPPELLER,0,0,0,,إلى الأمام.
Dialogue: 0,0:35:38.34,0:35:41.25,Default,PINEAPPELLER,0,0,0,,ماذا؟\Nيا لها من دودة ذكية.
Dialogue: 0,0:35:54.34,0:35:57.13,Default,PINEAPPELLER,0,0,0,,صاحب السمو، لا تجلس على الأرض!
Dialogue: 0,0:35:57.16,0:35:59.26,Default,PINEAPPELLER,0,0,0,,كم يؤلمني ظهري.
Dialogue: 0,0:36:10.47,0:36:12.31,Default,PINEAPPELLER,0,0,0,,هل فقدت ذاكرتك؟
Dialogue: 0,0:36:18.28,0:36:21.25,Default,PINEAPPELLER,0,0,0,,أنا متأكد من أن كل شيء ليس بهذه البساطة.
Dialogue: 0,0:36:21.99,0:36:25.03,Default,PINEAPPELLER,0,0,0,,قبل حدث مهم، تفاقم المرض.
Dialogue: 0,0:36:25.03,0:36:26.66,Default,PINEAPPELLER,0,0,0,,أقنعت نفسها بأنها شخص مختلف،
Dialogue: 0,0:36:26.66,0:36:29.03,Default,PINEAPPELLER,0,0,0,,الهروب من الحقيقة.
Dialogue: 0,0:36:53.86,0:36:58.46,Default,PINEAPPELLER,0,0,0,,سمعت هذا أنا والملكة الأرملة فقط.
Dialogue: 0,0:36:58.93,0:37:02.76,Default,PINEAPPELLER,0,0,0,,إذا ذكر أحد ما سمعه...
Dialogue: 0,0:37:05.61,0:37:08.77,Default,PINEAPPELLER,0,0,0,,هذا لن يحدث أبداً.
Dialogue: 0,0:37:10.68,0:37:14.17,Default,PINEAPPELLER,0,0,0,,ابحث عن طريقة لعلاج صاحبة السمو.
Dialogue: 0,0:37:14.84,0:37:16.04,Default,PINEAPPELLER,0,0,0,,مطلوب.
Dialogue: 0,0:37:41.53,0:37:46.94,Default,PINEAPPELLER,0,0,0,,كيف يمكننا أن نجعل من الفتاة ملكة لا تعرف اسمها؟
Dialogue: 0,0:37:47.47,0:37:51.34,Default,PINEAPPELLER,0,0,0,,يمكننا إخبارها باسمها،\Nلمساعدتها في استعادة ذكرياتها.
Dialogue: 0,0:37:51.34,0:37:53.04,Default,PINEAPPELLER,0,0,0,,لا تقلق.
Dialogue: 0,0:37:53.99,0:37:55.75,Default,PINEAPPELLER,0,0,0,,هل تريد مقابلتها؟
Dialogue: 0,0:37:56.22,0:37:57.59,Default,PINEANANCE,0,0,0,,عيون كثيرة موجهة إلينا.
Dialogue: 0,0:37:57.59,0:37:59.66,Default,PINEAPPELLER,0,0,0,,لا حاجة لإعطاء الناس سبباً
Dialogue: 0,0:37:59.66,0:38:01.53,Default,PINEANANCE,0,0,0,,ناقش من لا تتعرف على عائلتها.
Dialogue: 0,0:38:01.53,0:38:04.69,Default,PINEAPPELLER,0,0,0,,قلة قليلة من الناس سيعلمون بهذا.
Dialogue: 0,0:38:05.97,0:38:08.99,Default,PINEAPPELLER,0,0,0,,هذا ما يقلقني،
Dialogue: 0,0:38:08.99,0:38:11.56,Default,PINEAPPELLER,0,0,0,,لماذا كانت تتجول بمفردها في الليل؟
Dialogue: 0,0:38:11.66,0:38:12.96,Default,PINEAPPELLER,0,0,0,,شخص ما
Dialogue: 0,0:38:14.07,0:38:17.50,Default,PINEAPPELLER,0,0,0,,خدعها بتمرير أمر مزيف من الملك.
Dialogue: 0,0:38:18.41,0:38:21.04,Default,PINEAPPELLER,0,0,0,,لذا سيكون من الصعب اكتشاف أي شيء.
Dialogue: 0,0:38:21.95,0:38:23.61,Default,PINEAPPELLER,0,0,0,,لكن من تجرأ؟
Dialogue: 0,0:38:31.89,0:38:32.98,Default,PINEAPPELLER,0,0,0,,لقد استيقظت؟
Dialogue: 0,0:38:37.97,0:38:39.06,Default,PINEAPPELLER,0,0,0,,حقاً؟
Dialogue: 0,0:38:43.09,0:38:45.13,Default,PINEAPPLE,0,0,0,,أنا متأكد من أن الطلسم نجح.
Dialogue: 0,0:38:46.26,0:38:48.07,Default,PINEAPPELLER,0,0,0,,وهذا الشامان جيد.
Dialogue: 0,0:38:52.41,0:38:55.41,Default,PINEAPPELLER,0,0,0,,إذا حدث شيء ما،\Nأبلغني.
Dialogue: 0,0:38:57.22,0:38:59.98,Default,PINEAPPELLER,0,0,0,,تنتشر الشائعات حول القصر،
Dialogue: 0,0:39:00.24,0:39:01.99,Default,PINEAPPELLER,0,0,0,,مثل الفتاة المختارة
Dialogue: 0,0:39:01.99,0:39:04.31,Default,PINEANANCE,0,0,0,,من أجل دور المحظية، دفع\N عروس الملك إلى البحيرة.
Dialogue: 0,0:39:04.49,0:39:06.88,Default,PINEANANCE,0,0,0,,لن تصبح محظية ملكية.
Dialogue: 0,0:39:08.16,0:39:09.93,Default,PINEAPPELLER,0,0,0,,ما اسمها؟ ماذا عن هواجين؟
Dialogue: 0,0:39:09.93,0:39:11.05,Default,PINEAPPELLER,0,0,0,,صحيح.
Dialogue: 0,0:39:12.93,0:39:15.03,Default,PINEAPPELLER,0,0,0,,كنت بحاجة لسبب، ها هو.
Dialogue: 0,0:39:15.34,0:39:17.64,Default,PINEAPPELLER,0,0,0,,إلى جانب ذلك، فإن عائلتها في تدهور.
Dialogue: 0,0:39:17.64,0:39:19.40,Default,PINEAPPELLER,0,0,0,,حتى مع الجمر
Dialogue: 0,0:39:20.30,0:39:22.93,Default,PINEAPPELLER,0,0,0,,يجب أن تكون حذراً للغاية.
Dialogue: 0,0:39:24.20,0:39:25.94,Default,PINEANANCE,0,0,0,,فيما يتعلق بالتغيير في قانون الخدمة المدنية،
Dialogue: 0,0:39:26.11,0:39:29.32,Default,PINEAPPEN,0,0,0,,لم تتمكن الأحزاب المحافظة والتقدمية\Nمن التوصل إلى إجماع.
Dialogue: 0,0:39:29.32,0:39:31.78,Default,PINEAPPELLER,0,0,0,,حل نزاعنا يا سيدي.
Dialogue: 0,0:39:32.41,0:39:33.71,Default,PINEAPPELLER,0,0,0,,أعتقد
Dialogue: 0,0:39:35.36,0:39:37.38,Default,PINEAPPELLER,0,0,0,,أن الحزب التقدمي،
Dialogue: 0,0:39:38.53,0:39:40.65,Default,PINEAPPELLER,0,0,0,,لا، متحفظ...
Dialogue: 0,0:39:41.76,0:39:45.52,Default,PINEAPPELLER,0,0,0,,ماذا علي أن أفعل؟
Dialogue: 0,0:39:52.11,0:39:53.53,Default,PINEAPPELLER,0,0,0,,الحزب التقدمي
Dialogue: 0,0:39:53.53,0:39:55.64,Default,PINEANANCE,0,0,0,,يطالب بإلغاء هذا القانون،
Dialogue: 0,0:39:55.64,0:39:58.01,Default,PINEANANCE,0,0,0,,ولكن بعد ذلك سنواجه أضراراً اقتصادية جسيمة.
Dialogue: 0,0:39:58.01,0:39:59.20,Default,PINEAPPELLER,0,0,0,,نصيحتي -
Dialogue: 0,0:39:59.20,0:40:01.77,Default,PINEAPPELLER,0,0,0,,هذا إلغاء تدريجي للقانون.
Dialogue: 0,0:40:02.47,0:40:05.34,Default,PINEAPPELLER,0,0,0,,بسرعة!
Dialogue: 0,0:40:08.62,0:40:10.78,Default,PINEAPPELLER,0,0,0,,التالي على جدول الأعمال
Dialogue: 0,0:40:10.78,0:40:12.48,Default,PINEAPPELLER,0,0,0,,موضوع الزواج الملكي.
Dialogue: 0,0:40:13.26,0:40:15.02,Default,PINEAPPELLER,0,0,0,,لا أعرف إذا كنت سمعت،
Dialogue: 0,0:40:15.36,0:40:17.79,Default,PINEAPPELLER,0,0,0,,لكن عروسي استيقظت أخيراً.
Dialogue: 0,0:40:18.26,0:40:19.37,Default,PINEAPPLE,0,0,0,,جلالتك,
Dialogue: 0,0:40:19.37,0:40:21.74,Default,PINEAPPELLER,0,0,0,,تنتشر شائعات رهيبة حول القصر،
Dialogue: 0,0:40:21.74,0:40:25.50,Default,PINEAPPELLER,0,0,0,,كما لو أن خطيبتك فقدت عقلها.
Dialogue: 0,0:40:27.16,0:40:28.33,Default,PINEAPPELLER,0,0,0,,بجدية؟
Dialogue: 0,0:40:28.97,0:40:31.13,Default,PINEAPPELLER,0,0,0,,هذه هي المرة الأولى التي أسمع فيها عن شيء كهذا.
Dialogue: 0,0:40:31.97,0:40:33.91,Default,PINEAPPELLER,0,0,0,,وحقيقة أنها استيقظت،
Dialogue: 0,0:40:33.91,0:40:35.77,Default,PINEAPPELLER,0,0,0,,اكتشفت ذلك لأننا التقينا.
Dialogue: 0,0:40:36.28,0:40:39.71,Default,PINEAPPELLER,0,0,0,,هل أنا آخر من يعلم كل الأخبار؟
Dialogue: 0,0:40:40.12,0:40:42.65,Default,PINEAPPELLER,0,0,0,,هذه مجرد شائعات.
Dialogue: 0,0:40:43.05,0:40:46.18,Default,PINEAPPELLER,0,0,0,,لا نريد أن نقلقك،
Dialogue: 0,0:40:46.18,0:40:49.19,Default,PINEAPPELLER,0,0,0,,فصمتوا عن ذلك.
Dialogue: 0,0:40:49.43,0:40:50.86,Default,PINEAPPELLER,0,0,0,,كم أنت مهتم.
Dialogue: 0,0:40:50.86,0:40:52.12,Default,PINEAPPELLER,0,0,0,,أنا متأكد من هذه الشائعات
Dialogue: 0,0:40:52.93,0:40:55.46,Default,PINEAPPELLER,0,0,0,,هناك ذرة من الحقيقة.
Dialogue: 0,0:40:58.11,0:40:59.41,Default,PINEAPPELLER,0,0,0,,عندما التقينا،
Dialogue: 0,0:40:59.41,0:41:01.60,Default,PINEAPPELLER,0,0,0,,لقد تصرفت بشكل مختلف قليلاً في الواقع.
Dialogue: 0,0:41:03.28,0:41:05.87,Default,PINEAPPELLER,0,0,0,,قالت إنها لا تتذكر كيف سقطت في البحيرة.
Dialogue: 0,0:41:06.30,0:41:09.21,Default,PINEAPPELLER,0,0,0,,فقدت العذراء ذكرياتها من الصدمة!
Dialogue: 0,0:41:09.64,0:41:11.45,Default,PINEAPPELLER,0,0,0,,فحدث شيء فظيع.
Dialogue: 0,0:41:11.45,0:41:12.51,Default,PINEAPPELLER,0,0,0,,مخيف؟
Dialogue: 0,0:41:12.51,0:41:14.95,Default,PINEAPPELLER,0,0,0,,لا أصدق سقوطها
Dialogue: 0,0:41:14.95,0:41:17.05,Default,PINEAPPELLER,0,0,0,,كان حادثاً.
Dialogue: 0,0:41:18.05,0:41:19.16,Default,PINEAPPELLER,0,0,0,,ماذا؟
Dialogue: 0,0:41:19.16,0:41:20.32,Default,PINEAPPELLER,0,0,0,,قبل قليل
Dialogue: 0,0:41:20.32,0:41:22.39,Default,PINEANANCER,0,0,0,,الخصي، يمر بالقرب من البحيرة،
Dialogue: 0,0:41:22.39,0:41:24.89,Default,PINEANANCE,0,0,0,,رأى امرأة غريبة.
Dialogue: 0,0:41:24.89,0:41:26.36,Default,PINEAPPELLER,0,0,0,,-امرأة غريبة؟\N-من؟
Dialogue: 0,0:41:37.64,0:41:39.30,Default,PINEAPPELLER,0,0,0,,ومن كان؟
Dialogue: 0,0:41:40.01,0:41:42.07,Default,PINEAPPELLER,0,0,0,,وفقاً لسجلات القصر،
Dialogue: 0,0:41:42.07,0:41:45.41,Default,PINEANANCE,0,0,0,,دخلت القصر في ذلك الوقت امرأة واحدة فقط.
Dialogue: 0,0:41:46.32,0:41:48.35,Default,PINEAPPELLER,0,0,0,,ابنة تشو دايسو,
Dialogue: 0,0:41:48.59,0:41:50.15,Default,PINEAPPELLER,0,0,0,,تشو هواجين.
Dialogue: 0,0:41:53.55,0:41:55.79,Default,PINEAPPELLER,0,0,0,,كيف تجرؤ على الشك بها؟
Dialogue: 0,0:41:56.16,0:42:00.16,Default,PINEAPPELLER,0,0,0,,ليس لدى هواجين أي سبب لإيذاء عروس الملك.
Dialogue: 0,0:42:00.47,0:42:03.46,Default,PINEANANCE,0,0,0,,سوف تصبح المحظية الملكية.
Dialogue: 0,0:42:04.03,0:42:05.76,Default,PINEAPPELLER,0,0,0,,أرادت الفتاة أن تصبح ملكة،
Dialogue: 0,0:42:06.30,0:42:08.87,Default,PINEAPPELLER,0,0,0,,فألحقت الضرر بمنافستها.
Dialogue: 0,0:42:10.28,0:42:12.50,Default,PINEAPPELLER,0,0,0,,تشو هواجين بريء يا سيدي.
Dialogue: 0,0:42:13.14,0:42:17.05,Default,PINEAPPELLER,0,0,0,,يعرف الجميع مدى إخلاص تشو دايسو للمحكمة والدولة.
Dialogue: 0,0:42:17.05,0:42:18.88,Default,PINEAPPELLER,0,0,0,,وابنته
Dialogue: 0,0:42:19.34,0:42:22.26,Default,PINEANANCE,0,0,0,,معروفة بنبالتها.
Dialogue: 0,0:42:22.26,0:42:23.81,Default,PINEAPPELLER,0,0,0,,هذه خيانة!
Dialogue: 0,0:42:25.16,0:42:26.59,Default,PINEAPPELLER,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:42:26.59,0:42:29.05,Default,PINEANANCE,0,0,0,,لماذا أتت سراً إلى القصر؟
Dialogue: 0,0:42:29.05,0:42:31.09,Default,PINEAPPELLER,0,0,0,,هل هو لقاء الملكة الأرملة؟
Dialogue: 0,0:42:31.09,0:42:33.02,Default,PINEAPPELLER,0,0,0,,كن واضحاً، ما الذي تتهمها به؟
Dialogue: 0,0:42:33.97,0:42:35.64,Default,PINEAPPELLER,0,0,0,,لن تفلت من هذا بسهولة!
Dialogue: 0,0:42:35.64,0:42:36.76,Default,PINEAPPELLER,0,0,0,,السيادي,
Dialogue: 0,0:42:37.30,0:42:40.23,Default,PINEAPPELLER,0,0,0,,أطلب منك إجراء تحقيق،\Nاكتشف الحقيقة.
Dialogue: 0,0:42:40.61,0:42:42.17,Default,PINEAPPELLER,0,0,0,,وعاقب الجاني بشدة!
Dialogue: 0,0:43:03.30,0:43:04.52,Default,PINEAPPELLER,0,0,0,,عذراً.
Dialogue: 0,0:43:08.43,0:43:11.86,Default,PINEAPPELLER,0,0,0,,حتى أنه من المحرج إلى حد ما الاعتراف بذلك،
Dialogue: 0,0:43:13.30,0:43:14.77,Default,PINEAPPELLER,0,0,0,,تشو هواجين
Dialogue: 0,0:43:15.64,0:43:18.64,Default,PINEAPPELLER,0,0,0,,قضيت تلك الليلة معي. من البداية إلى النهاية.
Dialogue: 0,0:43:20.84,0:43:22.64,Default,PINEAPPELLER,0,0,0,,-ماذا؟\N-ماذا؟
Dialogue: 0,0:43:22.84,0:43:23.95,Default,PINEAPPELLER,0,0,0,,عفوا؟
Dialogue: 0,0:43:23.95,0:43:26.22,Default,TOLYANYCH,0,0,0,,بالطبع لم يكن هناك أي احتفال بعد
Dialogue: 0,0:43:26.22,0:43:28.01,Default,TOLYANYCH,0,0,0,,ولم يتم إعلانها محظية بعد.
Dialogue: 0,0:43:28.49,0:43:30.55,Default,TOLYANYCH,0,0,0,,لكنني شاب، في مقتبل العمر.
Dialogue: 0,0:43:31.86,0:43:34.89,Default,TOLYANYCH,0,0,0,,رغم أنك بنفسك تعرف كل شيء.
Dialogue: 0,0:43:34.89,0:43:37.95,Default,TOLYANYCH,0,0,0,,سوف تعرف كل شيء قبلي بوقت طويل.
Dialogue: 0,0:43:39.07,0:43:40.76,Default,TOLYANYCH,0,0,0,,بما أننا ناقشنا كل شيء،
Dialogue: 0,0:43:40.76,0:43:42.49,Default,TOLYANYCH,0,0,0,,أقترح عدم تأخير الحفل.
Dialogue: 0,0:43:42.49,0:43:44.70,Default,TOLYANYCH,0,0,0,,حتى أتمكن من اكتساب المحظيات بسرعة. كيف تريده ؟
Dialogue: 0,0:43:45.01,0:43:46.07,Default,TOLYANYCH,0,0,0,,لكن هذا...
Dialogue: 0,0:43:46.07,0:43:47.76,Default,TOLYANYCH,0,0,0,,أما الحادثة الأخيرة،
Dialogue: 0,0:43:47.76,0:43:50.61,Default,TOLYANYCH,0,0,0,,سيتم حل كل شيء عندما تتذكر الملكة المستقبلية كل شيء.
Dialogue: 0,0:43:50.61,0:43:52.94,Default,TOLYANYCH,0,0,0,,دعونا لا نستخلص النتائج في وقت مبكر.
Dialogue: 0,0:43:53.24,0:43:55.45,Default,TOLYANYCH,0,0,0,,لا أستطيع رؤيتك تتشاحنان هنا.
Dialogue: 0,0:43:55.45,0:43:57.47,Default,TOLYANYCH,0,0,0,,بينما تقسم، تكون الأشياء الأخرى خاملة.
Dialogue: 0,0:44:04.59,0:44:05.78,Default,TOLYANYCH,0,0,0,,أليس كذلك؟
Dialogue: 0,0:44:09.49,0:44:11.32,Default,TOLYANYCH,0,0,0,,إذا أقيم الحفل،
Dialogue: 0,0:44:11.32,0:44:12.79,Default,TOLYANYCH,0,0,0,,سيدير آل كيم كل شيء.
Dialogue: 0,0:44:13.03,0:44:15.76,Default,TOLYANYCH,0,0,0,,من الواضح أن جلالته يفضل "تشو هواجين".
Dialogue: 0,0:44:15.76,0:44:17.83,Default,TOLYANYCH,0,0,0,,مما يعني أن كل شيء لم يضيع بعد.
Dialogue: 0,0:44:18.91,0:44:22.47,Default,TOLYANYCH,0,0,0,,مستقبل عائلة بونيان تشو
Dialogue: 0,0:44:22.91,0:44:24.80,Default,TOLYANYCH,0,0,0,,يعتمد على تشو هواجين.
Dialogue: 0,0:44:25.91,0:44:29.57,Default,TOLYANYCH,0,0,0,,لنبدأ بجعل\N خليلة لها الملكية،
Dialogue: 0,0:44:30.47,0:44:32.48,Default,TOLYANYCH,0,0,0,,ثم سنتوصل إلى شيء ما.
Dialogue: 0,0:44:32.62,0:44:35.51,Default,TOLYANYCH,0,0,0,,سيظل الحفل قائماً.
Dialogue: 0,0:44:35.78,0:44:38.62,Default,TOLYANYCH,0,0,0,,إذن لماذا ليس لديك وجه؟
Dialogue: 0,0:44:40.39,0:44:43.25,Default,TOLYANYCH,0,0,0,,المعركة التي تنتظرنا ليست سهلة.
Dialogue: 0,0:44:59.30,0:45:00.94,Default,TOLYANYCH,0,0,0,,أنا أفتقر إلى المعرفة،
Dialogue: 0,0:45:01.28,0:45:03.91,Default,TOLYANYCH,0,0,0,,علينا أن نعتمد عليك في كل شيء.
Dialogue: 0,0:45:03.91,0:45:06.38,Default,TOLYANYCH,0,0,0,,- سامحني. \N-Well، ما الذي تتحدث عنه؟
Dialogue: 0,0:45:07.68,0:45:11.95,Default,TOLYANYCH,0,0,0,,أنت تتحسن كل يوم.
Dialogue: 0,0:45:13.62,0:45:15.22,Default,TOLYANYCH,0,0,0,,أنت طيب للغاية.
Dialogue: 0,0:45:15.49,0:45:17.36,Default,TOLYANYCH,0,0,0,,حتى بمساعدتك
Dialogue: 0,0:45:17.36,0:45:19.46,Default,TOLYANYCH,0,0,0,,أنا بالكاد أستطيع التأقلم.
Dialogue: 0,0:45:19.82,0:45:24.03,Default,TOLYANYCH,0,0,0,,ولم آخذ في الاعتبار أنك بحاجة إلى\N لوضع طاقتك الذكورية في مكان ما.
Dialogue: 0,0:45:25.70,0:45:26.90,Default,TOLYANYCH,0,0,0,,عذراً.
Dialogue: 0,0:45:27.11,0:45:30.83,Default,TOLYANYCH,0,0,0,,لماذا، يجب أن أعتذر عن عدم أخذ هذه التفاصيل المهمة بعين الاعتبار.
Dialogue: 0,0:45:31.37,0:45:34.05,Default,TOLYANYCH,0,0,0,,لكن في العلاقات مع النساء
Dialogue: 0,0:45:34.05,0:45:36.07,Default,TOLYANYCH,0,0,0,,لا تزال بحاجة إلى أن تسترشد برأسك.
Dialogue: 0,0:45:36.18,0:45:38.98,Default,TOLYANYCH,0,0,0,,يظل القصر الداخلي جزءاً من القصر.
Dialogue: 0,0:45:39.55,0:45:40.91,Default,TOLYANYCH,0,0,0,,وعلينا ألا ننسى،
Dialogue: 0,0:45:41.51,0:45:44.28,Default,TOLYANYCH,0,0,0,,أن زوجتك أعلى من محظياتك.
Dialogue: 0,0:45:45.22,0:45:46.95,Default,TOLYANYCH,0,0,0,,سأحاول ألا أنسى.
Dialogue: 0,0:45:47.22,0:45:50.76,Default,TOLYANYCH,0,0,0,,إلى جانب ذلك، نحن بحاجة إلى تحديد هوية تلك السيدة الغامضة،
Dialogue: 0,0:45:50.76,0:45:53.06,Default,TOLYANYCH,0,0,0,,الذي رآه الخصي في الليل.
Dialogue: 0,0:45:53.30,0:45:56.93,Default,TOLYANYCH,0,0,0,,نحن بحاجة للتأكد من أنها لن ينتهي بها الأمر في مثل هذا الموقف الحساس مرة أخرى.
Dialogue: 0,0:45:58.64,0:45:59.80,Default,TOLYANYCH,0,0,0,,بالطبع.
Dialogue: 0,0:46:00.57,0:46:02.03,Default,TOLYANYCH,0,0,0,,أنت على حق، كما هو الحال دائماً.
Dialogue: 0,0:46:32.11,0:46:33.60,Default,TOLYANYCH,0,0,0,,سامحيني يا سيدتي.
Dialogue: 0,0:46:33.84,0:46:37.03,Default,TOLYANYCH,0,0,0,,كيف استغرقت وقتًا طويلاً لكتابة هذا.
Dialogue: 0,0:46:54.18,0:46:57.69,Default,TOLYANYCH,0,0,0,,لولاكم لما انتهيت من كتابة القصيدة.
Dialogue: 0,0:46:58.16,0:46:59.89,Default,TOLYANYCH,0,0,0,,ولن تكون بهذا الجمال.
Dialogue: 0,0:47:01.47,0:47:03.03,Default,TOLYANYCH,0,0,0,,تملقني يا سيدتي.
Dialogue: 0,0:47:04.39,0:47:05.64,Default,TOLYANYCH,0,0,0,,السيدة.
Dialogue: 0,0:47:05.64,0:47:08.60,Default,TOLYANYCH,0,0,0,,لقد أحضروا مرسوماً من القصر.
Dialogue: 0,0:47:14.14,0:47:16.11,Default,TOLYANYCH,0,0,0,,استمع إلى مرسوم جلالة الملك.
Dialogue: 0,0:47:20.72,0:47:23.05,Default,TOLYANYCH,0,0,0,,تشو هواجين، ابنة كبير أمناء المحكمة تشو دايسو،
Dialogue: 0,0:47:23.05,0:47:24.89,Default,TOLYANYCH,0,0,0,,تم الإخطار بأنه سيتم عقد حفل الزفاف غدًا
Dialogue: 0,0:47:24.89,0:47:27.55,Default,TOLYANYCH,0,0,0,,منظر لاختيار المحظية الملكية\N. كأحد المرشحين
Dialogue: 0,0:47:27.55,0:47:29.02,Default,TOLYANYCH,0,0,0,,يجب أن تأتي إلى القصر فوراً.
Dialogue: 0,0:47:35.39,0:47:38.23,Default,TOLYANYCH,0,0,0,,كم هو منعش.
Dialogue: 0,0:47:40.93,0:47:42.33,Default,TOLYANYCH,0,0,0,,تحتاج إلى إضافة المزيد من الماء.
Dialogue: 0,0:47:45.37,0:47:47.10,Default,TOLYANYCH,0,0,0,,الآن سنضيف المزيد من الماء.
Dialogue: 0,0:47:47.87,0:47:50.67,Default,TOLYANYCH,0,0,0,,اسكب بعض الماء، اسكب بعض الماء.
Dialogue: 0,0:47:51.12,0:47:52.44,Default,TOLYANYCH,0,0,0,,بالضبط، الماء.
Dialogue: 0,0:47:52.84,0:47:54.48,Default,TOLYANYCH,0,0,0,,الماء هو المشكلة بالضبط.
Dialogue: 0,0:47:56.41,0:47:59.35,Default,TOLYANYCH,0,0,0,,هل سأتمكن حتى من العودة إذا وقعت في جسم مائي؟
Dialogue: 0,0:47:59.66,0:48:01.92,Default,TOLYANYCH,0,0,0,,هكذا وصلت إلى هنا عبر المسبح.
Dialogue: 0,0:48:02.89,0:48:04.39,Default,TOLYANYCH,0,0,0,,هل هناك بحيرات أخرى هنا؟
Dialogue: 0,0:48:04.39,0:48:07.19,Default,TOLYANYCH,0,0,0,,هناك اثنان آخران على أراضي القصر.
Dialogue: 0,0:48:08.09,0:48:10.23,Default,TOLYANYCH,0,0,0,,-حقاً؟ \N-نعم.
Dialogue: 0,0:48:10.57,0:48:13.03,Default,TOLYANYCH,0,0,0,,لكنها لا تختلف عما رأيته من قبل.
Dialogue: 0,0:48:13.64,0:48:14.97,Default,TOLYANYCH,0,0,0,,كيف هذا؟
Dialogue: 0,0:48:15.70,0:48:18.27,Default,TOLYANYCH,0,0,0,,بموجب مرسوم الملكة الأرملة
Dialogue: 0,0:48:18.37,0:48:21.40,Default,TOLYANYCH,0,0,0,,لقد تم تجفيف جميع البحيرات الموجودة في القصر.
Dialogue: 0,0:48:21.78,0:48:23.74,Default,TOLYANYCH,0,0,0,,كل واحد؟
Dialogue: 0,0:48:24.05,0:48:25.41,Default,TOLYANYCH,0,0,0,,نعم يا صاحب السمو.
Dialogue: 0,0:48:25.95,0:48:27.14,Default,TOLYANYCH,0,0,0,,وهل سيستمر هذا لفترة طويلة؟
Dialogue: 0,0:48:27.45,0:48:29.88,Default,TOLYANYCH,0,0,0,,إلى الأبد يا صاحب السمو.
Dialogue: 0,0:48:31.12,0:48:33.05,Default,TOLYANYCH,0,0,0,,ما الذي يحدث؟
Dialogue: 0,0:48:33.95,0:48:37.12,Default,TOLYANYCH,0,0,0,,هل أنا عالقة هنا إلى الأبد؟
Dialogue: 0,0:48:38.66,0:48:39.82,Default,TOLYANYCH,0,0,0,,إلى الأبد؟!
Dialogue: 0,0:48:43.59,0:48:44.76,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:48:50.07,0:48:53.14,Default,TOLYANYCH,0,0,0,,الماء! نحن بحاجة لاختبار كل المياه في القصر.
Dialogue: 0,0:48:53.78,0:48:56.81,Default,TOLYANYCH,0,0,0,,يجب أن أعود!
Dialogue: 0,0:48:58.84,0:48:59.89,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:48:59.89,0:49:01.04,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:49:02.18,0:49:03.86,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:49:03.86,0:49:06.42,Default,TOLYANYCH,0,0,0,,-صاحب السمو!\N-هذه مياه صرف صحي، يا صاحب السمو!
Dialogue: 0,0:49:06.53,0:49:08.82,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:49:09.70,0:49:11.82,Default,TOLYANYCH,0,0,0,,لا تفعل هذا!
Dialogue: 0,0:49:16.74,0:49:17.89,Default,TOLYANYCH,0,0,0,,صاحب السمو!
Dialogue: 0,0:49:19.53,0:49:21.10,Default,TOLYANYCH,0,0,0,,كان ظهري مقروصاً.
Dialogue: 0,0:49:21.26,0:49:24.17,Default,TOLYANYCH,0,0,0,,- انحنى واسحب! \N-حسنا.
Dialogue: 0,0:49:25.14,0:49:28.24,Default,TOLYANYCH,0,0,0,,-صاحب السمو! لماذا عصا رأسك الصغير هناك!\N-صاحب السمو!
Dialogue: 0,0:49:28.24,0:49:30.47,Default,TOLYANYCH,0,0,0,,مع من تريد أن تتركنا؟!
Dialogue: 0,0:49:34.05,0:49:36.38,Default,TOLYANYCH,0,0,0,,لذا عرفت ذلك. تحتاج إلى القفز في البركة.
Dialogue: 0,0:49:44.80,0:49:47.09,Default,TOLYANYCH,0,0,0,,يا لها من صدمة،
Dialogue: 0,0:49:47.37,0:49:49.69,Default,TOLYANYCH,0,0,0,,أنك تفعل مثل هذه الأشياء عندما ترى الماء.
Dialogue: 0,0:50:01.47,0:50:03.81,Default,TOLYANYCH,0,0,0,,وأنت جميلة. ما اسمك هناك؟
Dialogue: 0,0:50:06.09,0:50:08.51,Default,TOLYANYCH,0,0,0,,Honyong. اسمي هونغيونغ.
Dialogue: 0,0:50:09.45,0:50:12.85,Default,TOLYANYCH,0,0,0,,ما يؤلمك أنك نسيت من اعتنى بك
Dialogue: 0,0:50:13.05,0:50:16.15,Default,TOLYANYCH,0,0,0,,منذ ولادتك.
Dialogue: 0,0:50:22.37,0:50:24.73,Default,TOLYANYCH,0,0,0,,حسناً، لماذا تبكين؟ من المؤلم مشاهدته.
Dialogue: 0,0:50:26.41,0:50:28.67,Default,TOLYANYCH,0,0,0,,صاحب السمو، لقد أحضرت الدواء.
Dialogue: 0,0:50:35.22,0:50:37.07,Default,TOLYANYCH,0,0,0,,ألا تخجل من ذرف الدموع أمام صاحبة السمو؟
Dialogue: 0,0:50:37.22,0:50:39.14,Default,TOLYANYCH,0,0,0,,إذا كان الأمر صعبًا على أي شخص هنا، فهو هي.
Dialogue: 0,0:50:39.39,0:50:40.58,Default,TOLYANYCH,0,0,0,,سامحني.
Dialogue: 0,0:50:40.78,0:50:43.95,Default,TOLYANYCH,0,0,0,,وهذا صحيح. من الصعب بالنسبة لي، من الصعب.
Dialogue: 0,0:50:44.66,0:50:46.28,Default,TOLYANYCH,0,0,0,,لن تفهما أبدًا
Dialogue: 0,0:50:46.93,0:50:48.75,Default,TOLYANYCH,0,0,0,,مرارة فقدان الشيء الأهم.
Dialogue: 0,0:50:54.80,0:50:56.13,Default,TOLYANYCH,0,0,0,,احزم أمتعتك واذهب إلى المنزل.
Dialogue: 0,0:51:01.84,0:51:04.13,Default,TOLYANYCH,0,0,0,,لأنني لن أتمكن من العودة قريباً،
Dialogue: 0,0:51:04.47,0:51:07.24,Default,TOLYANYCH,0,0,0,,سيتعين ضبطها. \NWe بحاجة لمعرفة ماذا وكيف.
Dialogue: 0,0:51:09.74,0:51:10.97,Default,TOLYANYCH,0,0,0,,لدي سؤال.
Dialogue: 0,0:51:11.18,0:51:13.74,Default,TOLYANYCH,0,0,0,,ما اسم تلك الماعز؟
Dialogue: 0,0:51:14.59,0:51:16.01,Default,TOLYANYCH,0,0,0,,ما اسم ملكك؟
Dialogue: 0,0:51:17.59,0:51:20.45,Default,TOLYANYCH,0,0,0,,اسم الملك مقدس، كيف يمكنني أن أقوله.
Dialogue: 0,0:51:20.68,0:51:21.85,Default,TOLYANYCH,0,0,0,,اللعنة، بالضبط.
Dialogue: 0,0:51:21.95,0:51:24.25,Default,TOLYANYCH,0,0,0,,لا يمكنك مناداته بالاسم، ولا مناداته بالاسم فقط.
Dialogue: 0,0:51:24.82,0:51:27.82,Default,TOLYANYCH,0,0,0,,نحن في ولاية جوسون؟ ما هو العام الآن؟
Dialogue: 0,0:51:27.82,0:51:29.26,Default,TOLYANYCH,0,0,0,,1851.
Dialogue: 0,0:51:29.49,0:51:33.03,Default,TOLYANYCH,0,0,0,,السنة الثانية من حكم الأمير توغوان.
Dialogue: 0,0:51:33.41,0:51:36.11,Default,TOLYANYCH,0,0,0,,الأمير توغوان؟
Dialogue: 0,0:51:36.11,0:51:37.90,Default,TOLYANYCH,0,0,0,,سمعت هذا الاسم في مكان ما.
Dialogue: 0,0:51:38.47,0:51:39.84,Default,TOLYANYCH,0,0,0,,هل يمكنني أن أعطيك تلميحاً آخر؟
Dialogue: 0,0:51:41.14,0:51:43.37,Default,TOLYANYCH,0,0,0,,التلميح؟
Dialogue: 0,0:51:44.64,0:51:47.91,Default,TOLYANYCH,0,0,0,,حسنًا، دعونا نفعل ذلك بهذه الطريقة. سوف أغني أغنية.
Dialogue: 0,0:51:47.91,0:51:49.85,Default,TOLYANYCH,0,0,0,,إذا سمعت اسم سلف الملك بعد وفاته، فأعط إشارة.
Dialogue: 0,0:51:50.09,0:51:51.25,Default,TOLYANYCH,0,0,0,,استمع بعناية.
Dialogue: 0,0:51:53.49,0:51:55.86,Default,TOLYANYCH,0,0,0,,تاي, جون, تاي, سي, مون, دان, سي,
Dialogue: 0,0:51:55.86,0:51:58.22,Default,TOLYANYCH,0,0,0,,Ye, Song, Young, Jun, In, Myung, Song.
Dialogue: 0,0:52:01.30,0:52:03.76,Default,TOLYANYCH,0,0,0,,أما زلت لست هناك؟ وهذا يعني أن الملك الريجستري هو أحد الأحدث.
Dialogue: 0,0:52:04.37,0:52:06.53,Default,TOLYANYCH,0,0,0,,كوان، إن، هيو، هيون، سوك، كيونغ، يونغ،
Dialogue: 0,0:52:06.53,0:52:08.43,Default,TOLYANYCH,0,0,0,,تشون, صن, هونغ, تشول, كو.
Dialogue: 0,0:52:09.14,0:52:10.23,Default,TOLYANYCH,0,0,0,,من؟
Dialogue: 0,0:52:13.74,0:52:16.01,Default,TOLYANYCH,0,0,0,,كو، تشول، هونغ، صن...
Dialogue: 0,0:52:18.12,0:52:20.74,Default,TOLYANYCH,0,0,0,,الشمس، حضرة.
Dialogue: 0,0:52:22.95,0:52:24.65,Default,TOLYANYCH,0,0,0,,من أين أتت الذبابة؟
Dialogue: 0,0:52:27.03,0:52:28.85,Default,TOLYANYCH,0,0,0,,إذا جاء بعد الملك هونغجونغ، فهو...
Dialogue: 0,0:52:32.20,0:52:33.56,Default,TOLYANYCH,0,0,0,,Choljong؟
Dialogue: 0,0:52:36.16,0:52:38.63,Default,TOLYANYCH,0,0,0,,Choljong. ولد لي ونبوم.
Dialogue: 0,0:52:38.64,0:52:40.87,Default,TOLYANYCH,0,0,0,,أصبح ملكاً وغير اسمه إلى Lee Byung.
Dialogue: 0,0:52:40.87,0:52:42.57,Default,TOLYANYCH,0,0,0,,أقاربه متهمون بالخيانة
Dialogue: 0,0:52:42.57,0:52:44.03,Default,TOLYANYCH,0,0,0,,ونفي إلى جزيرة "كانغهوادو".
Dialogue: 0,0:52:44.03,0:52:48.10,Default,TOLYANYCH,0,0,0,,جوسون سندريلا، تلك التي بسبب غبائها\N، أصبحت ملكاً بين عشية وضحاها.
Dialogue: 0,0:52:48.28,0:52:51.18,Default,TOLYANYCH,0,0,0,,ملك الدمى الأكثر غباء وعديم الفائدة\N في التاريخ.
Dialogue: 0,0:52:51.18,0:52:53.04,Default,TOLYANYCH,0,0,0,,يكرهه الشعب.
Dialogue: 0,0:52:53.22,0:52:55.41,Default,TOLYANYCH,0,0,0,,مرض ومات في السنة الثالثة عشرة من حكمه.
Dialogue: 0,0:52:56.62,0:53:00.05,Default,TOLYANYCH,0,0,0,,كان المعلمون وأولياء الأمور على حق، وما زال التدريس خفيفًا!
Dialogue: 0,0:53:00.05,0:53:01.28,Default,TOLYANYCH,0,0,0,,ماما، من أعماق قلبي!
Dialogue: 0,0:53:03.89,0:53:05.72,Default,TOLYANYCH,0,0,0,,عندما يُضرب الناس بسرعة كبيرة جدًا، يصبحون كلابًا سلوقية.
Dialogue: 0,0:53:05.93,0:53:08.76,Default,TOLYANYCH,0,0,0,,هذا واحد من هؤلاء، لكنه يتصرف بشكل لائق حتى الآن.
Dialogue: 0,0:53:11.07,0:53:14.76,Default,TOLYANYCH,0,0,0,,لم أكن أعلم بحالتك، وبالتالي كان سلوكي غير لائق.
Dialogue: 0,0:53:16.03,0:53:17.37,Default,TOLYANYCH,0,0,0,,دعني أتحسس جبهتك.
Dialogue: 0,0:53:19.20,0:53:20.40,Default,TOLYANYCH,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:53:23.37,0:53:25.14,Default,TOLYANYCH,0,0,0,,لماذا تشعر بالحرج؟
Dialogue: 0,0:53:25.24,0:53:28.14,Default,TOLYANYCH,0,0,0,,غداً ستصبحين زوجتي.
Dialogue: 0,0:53:30.22,0:53:31.38,Default,TOLYANYCH,0,0,0,,غداً؟
Dialogue: 0,0:53:32.99,0:53:35.62,Default,TOLYANYCH,0,0,0,,طلبت من الوزراء تسريع الأمور.
Dialogue: 0,0:53:35.62,0:53:37.72,Default,TOLYANYCH,0,0,0,,وما زالوا يقيمون الحفل.
Dialogue: 0,0:53:38.72,0:53:41.79,Default,TOLYANYCH,0,0,0,,غداً حفل زفافنا.
Dialogue: 0,0:53:42.43,0:53:45.73,Default,TOLYANYCH,0,0,0,,حسناً، لقد وصلنا، لقد نسيت أهم شيء.
Dialogue: 0,0:53:45.97,0:53:47.03,Default,TOLYANYCH,0,0,0,,وضعها تشولجون على كل شيء
Dialogue: 0,0:53:47.03,0:53:48.77,Default,TOLYANYCH,0,0,0,,بسبب الخمر والفتيات.
Dialogue: 0,0:53:48.97,0:53:50.83,Default,TOLYANYCH,0,0,0,,ذكر جوسون الرئيسي.
Dialogue: 0,0:53:55.18,0:53:56.27,Default,TOLYANYCH,0,0,0,,انتظر.
Dialogue: 0,0:53:58.02,0:54:00.29,Default,TOLYANYCH,0,0,0,,أولاً أريد أن أخبرك بشيء.
Dialogue: 0,0:54:09.57,0:54:13.31,Default,TOLYANYCH,0,0,0,,لقد فعلت كما طلبت وأرسلت الجميع بعيداً.
Dialogue: 0,0:54:13.38,0:54:14.81,Default,TOLYANYCH,0,0,0,,راضي؟
Dialogue: 0,0:54:17.18,0:54:19.78,Default,TOLYANYCH,0,0,0,,بشكل عام، من الصعب جدًا تصديق هذا.
Dialogue: 0,0:54:20.05,0:54:22.35,Default,TOLYANYCH,0,0,0,,لا أعرف حتى كيف أشرح ذلك.
Dialogue: 0,0:54:22.72,0:54:24.15,Default,TOLYANYCH,0,0,0,,لماذا كل شيء معقد للغاية.
Dialogue: 0,0:54:24.72,0:54:27.62,Default,TOLYANYCH,0,0,0,,-لديك شيء ما في شعرك.\N-ماذا؟ ماذا هناك؟
Dialogue: 0,0:54:31.16,0:54:32.53,Default,TOLYANYCH,0,0,0,,البتلة.
Dialogue: 0,0:54:35.73,0:54:37.60,Default,TOLYANYCH,0,0,0,,على العموم ستصدمين،
Dialogue: 0,0:54:37.67,0:54:39.40,Default,TOLYANYCH,0,0,0,,لكن حاول قبول الأمر على أية حال.
Dialogue: 0,0:54:43.27,0:54:45.24,Default,TOLYANYCH,0,0,0,,-في الواقع أنا...\N-هل أنت حقاً؟
Dialogue: 0,0:54:48.58,0:54:49.75,Default,TOLYANYCH,0,0,0,,يا رجل.
Dialogue: 0,0:54:57.45,0:54:59.02,Default,TOLYANYCH,0,0,0,,رجل سليم,
Dialogue: 0,0:54:59.02,0:55:00.96,Default,TOLYANYCH,0,0,0,,يأتي من مستقبل جوسون، الذي جاء بعد 200 عام.
Dialogue: 0,0:55:01.26,0:55:03.13,Default,TOLYANYCH,0,0,0,,لا أعرف كيف حدث هذا.
Dialogue: 0,0:55:03.13,0:55:04.99,Default,TOLYANYCH,0,0,0,,ظننت أنني غرقت.
Dialogue: 0,0:55:04.99,0:55:06.23,Default,TOLYANYCH,0,0,0,,أنا أعود إلى صوابي، وأنا فتاة.
Dialogue: 0,0:55:06.46,0:55:09.77,Default,TOLYANYCH,0,0,0,,بشكل عام، أنا لست من تظنني.
Dialogue: 0,0:55:09.77,0:55:11.43,Default,TOLYANYCH,0,0,0,,المظاهر قد تكون خادعة، كما تعلم.
Dialogue: 0,0:55:14.84,0:55:16.41,Default,TOLYANYCH,0,0,0,,أراهن أنك تعتقد ما الذي أتحدث عنه بحق الجحيم، أليس كذلك؟
Dialogue: 0,0:55:16.51,0:55:19.11,Default,TOLYANYCH,0,0,0,,على أية حال، يجب أن تعيد النظر في كل شيء بجدية!
Dialogue: 0,0:55:19.11,0:55:21.81,Default,TOLYANYCH,0,0,0,,لنفترض أن الحفل قد أقيم،\Nوسيأتي وقت ليلة الزفاف و...
Dialogue: 0,0:55:22.25,0:55:23.98,Default,TOLYANYCH,0,0,0,,كل هذا خطأ.
Dialogue: 0,0:55:24.15,0:55:27.05,Default,TOLYANYCH,0,0,0,,وأنا لا أحب الرجال.
Dialogue: 0,0:55:28.32,0:55:30.65,Default,TOLYANYCH,0,0,0,,ولن تُحسد على الإطلاق.
Dialogue: 0,0:55:30.65,0:55:32.29,Default,TOLYANYCH,0,0,0,,أنا فقط أعاني من اضطراب في الشخصية.
Dialogue: 0,0:55:32.29,0:55:35.63,Default,TOLYANYCH,0,0,0,,ولديك زواج مثلي الجنس! فتاة غير شرعية!
Dialogue: 0,0:55:39.30,0:55:42.47,Default,TOLYANYCH,0,0,0,,أفهم ما تحاول قوله.
Dialogue: 0,0:55:44.50,0:55:46.77,Default,TOLYANYCH,0,0,0,,بجدية أم ماذا؟ واو،
Dialogue: 0,0:55:46.94,0:55:49.77,Default,TOLYANYCH,0,0,0,,أنت رجل عادي، يبدو أن الكتب المدرسية كذبت.
Dialogue: 0,0:55:50.44,0:55:51.61,Default,TOLYANYCH,0,0,0,,استمع هنا!
Dialogue: 0,0:55:53.01,0:55:54.38,Default,TOLYANYCH,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:55:54.38,0:55:56.28,Default,TOLYANYCH,0,0,0,,أخبر طبيب المحكمة،
Dialogue: 0,0:55:56.28,0:55:58.88,Default,TOLYANYCH,0,0,0,,لمعرفة ما خطب خطيبتي وإبلاغي.
Dialogue: 0,0:55:59.72,0:56:00.82,Default,TOLYANYCH,0,0,0,,ماذا؟
Dialogue: 0,0:56:01.15,0:56:02.29,Default,TOLYANYCH,0,0,0,,حسنًا.
Dialogue: 0,0:56:04.99,0:56:06.22,Default,TOLYANYCH,0,0,0,,لا تقلق.
Dialogue: 0,0:56:06.22,0:56:09.73,Default,TOLYANYCH,0,0,0,,سأعالجك بالتأكيد.
Dialogue: 0,0:56:10.23,0:56:13.33,Default,TOLYANYCH,0,0,0,,تذكر أنك لست وحدك.
Dialogue: 0,0:56:13.80,0:56:17.20,Default,TOLYANYCH,0,0,0,,أنا زوجك المستقبلي ولن أتركك مهما كنت سيئاً
Dialogue: 0,0:56:18.87,0:56:21.27,Default,TOLYANYCH,0,0,0,,ومهما كان عقلك متضرراً.
Dialogue: 0,0:56:25.74,0:56:28.81,Default,TOLYANYCH,0,0,0,,أوه، آسف. أنت لست بخير بعد.
Dialogue: 0,0:56:28.88,0:56:29.98,Default,TOLYANYCH,0,0,0,,استمع هنا.
Dialogue: 0,0:56:30.61,0:56:33.08,Default,TOLYANYCH,0,0,0,,خذ عروسي إلى غرفتها فوراً.
Dialogue: 0,0:56:33.08,0:56:34.62,Default,TOLYANYCH,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:56:34.68,0:56:36.12,Default,FE,0,0,0,,لا تقلق.
Dialogue: 0,0:56:36.12,0:56:39.06,Default,FE,0,0,0,,اذهب إلى السرير وارتاح.\Nسوف تشعر بتحسن.
Dialogue: 0,0:56:40.89,0:56:43.33,Default,FE,0,0,0,,كل شيء سيكون على ما يرام.
Dialogue: 0,0:56:43.89,0:56:45.23,Default,FE,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:56:46.20,0:56:47.76,Default,FE,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:56:48.73,0:56:50.60,Default,FE,0,0,0,,الكتب لم تكذب.
Dialogue: 0,0:56:50.93,0:56:53.64,Default,FE,0,0,0,,على ما يبدو أنه أغبى مما كتبوه في الكتاب المدرسي.
Dialogue: 0,0:56:53.64,0:56:55.04,Default,FE,0,0,0,,اكتسب القوة.
Dialogue: 0,0:56:56.34,0:56:58.71,Default,FE,0,0,0,,حسناً، حسناً.
Dialogue: 0,0:57:00.21,0:57:03.61,Default,FE,0,0,0,,صاحب السمو، لا يمكنك المشي بتنورتك مرفوعة.
Dialogue: 0,0:57:04.18,0:57:06.68,Default,FE,0,0,0,,لا ينبغي إظهار الملابس الداخلية عند الوقوف.
Dialogue: 0,0:57:07.05,0:57:10.45,Default,FE,0,0,0,,صاحب السمو، تحرك أبطأ. لا تركض هكذا.
Dialogue: 0,0:57:12.32,0:57:14.89,Default,FE,0,0,0,,ما الذي تنوي فعله؟
Dialogue: 0,0:57:17.36,0:57:19.30,Default,FE,0,0,0,,إذا لم أرغب في ذلك، فلن أفعل ذلك.
Dialogue: 0,0:57:19.30,0:57:21.80,Default,FE,0,0,0,,الطب الغربي يعمل بشكل أفضل بالنسبة لي.
Dialogue: 0,0:57:22.87,0:57:25.80,Default,FE,0,0,0,,افتح فمك.
Dialogue: 0,0:57:26.87,0:57:27.97,Default,FU,0,0,0,,لا.
Dialogue: 0,0:57:28.27,0:57:29.67,Default,FU,0,0,0,,
Dialogue: 0,0:57:30.61,0:57:31.71,Default,FE,0,0,0,,يا رب.
Dialogue: 0,0:57:37.65,0:57:39.48,Default,FE,0,0,0,,لقد أخبرتك...
Dialogue: 0,0:57:56.20,0:57:58.87,Default,FE,0,0,0,,طاقة الماء تملأ رأس صاحبة السمو.
Dialogue: 0,0:57:58.87,0:58:02.04,Default,FE,0,0,0,,أنت بحاجة إلى إزاحتها بطاقة النار باستخدام خشب الصندل.
Dialogue: 0,0:58:02.91,0:58:05.41,Default,FE,0,0,0,,صاحب السمو، يجب أن تتذكر كل شيء.
Dialogue: 0,0:58:05.54,0:58:08.48,Default,FE,0,0,0,,أوه أيها الدجال! هل لديك رخصة طبيب؟!
Dialogue: 0,0:58:08.48,0:58:11.81,Default,FE,0,0,0,,لماذا تصنع مني دجاجة التبغ؟
Dialogue: 0,0:58:20.39,0:58:22.99,Default,FE,0,0,0,,سأفتح لك الشاكرا الثالثة عشرة، وهي الجواب
Dialogue: 0,0:58:22.99,0:58:24.09,Default,FE,0,0,0,,لأمراض العقل.
Dialogue: 0,0:58:24.19,0:58:26.63,Default,FE,0,0,0,,لا تهتم، افعل ما تريد.
Dialogue: 0,0:58:26.63,0:58:28.30,Default,FE,0,0,0,,الجسد ليس ملكي على أية حال.
Dialogue: 0,0:58:42.55,0:58:43.81,Default,FE,0,0,0,,أتذكر!
Dialogue: 0,0:58:46.02,0:58:47.90,Default,FE,0,0,0,,تم إرجاع الذاكرة كما لو كانت بفعل السحر.
Dialogue: 0,0:58:48.68,0:58:49.72,Default,FE,0,0,0,,أنت هونغيون.
Dialogue: 0,0:58:49.72,0:58:52.72,Default,FE,0,0,0,,خادمتي الحبيبة\Nالتي نشأت معها في منزل والدي.
Dialogue: 0,0:58:57.53,0:59:01.20,Default,FE,0,0,0,,ما اسم سيدة البلاط هذه؟
Dialogue: 0,0:59:01.56,0:59:02.80,Default,FE,0,0,0,,أنت...
Dialogue: 0,0:59:04.90,0:59:06.10,Default,FE,0,0,0,,ماذا...
Dialogue: 0,0:59:08.14,0:59:10.27,Default,FE,0,0,0,,تشوي! سيدة المحكمة تشوي.
Dialogue: 0,0:59:12.98,0:59:16.65,Default,FE,0,0,0,,ما اسمي إذن؟
Dialogue: 0,0:59:22.62,0:59:24.45,Default,FE,0,0,0,,كيف أعرف بماذا أتصل بالطبيب في المحكمة؟
Dialogue: 0,0:59:24.45,0:59:25.82,Default,FE,0,0,0,,لماذا أنت جالس؟
Dialogue: 0,0:59:25.82,0:59:27.12,Default,FE,0,0,0,,امسك صاحبة السمو.
Dialogue: 0,0:59:27.12,0:59:29.09,Default,FE,0,0,0,,إذا تحركت،\Nit سوف يزداد سوءًا.
Dialogue: 0,0:59:29.53,0:59:33.00,Default,FE,0,0,0,,كيف يمكنك استخدام\Nأداة الجزار هذه معي؟
Dialogue: 0,0:59:33.00,0:59:34.26,Default,FE,0,0,0,,سقطت من شجرة البلوط؟
Dialogue: 0,0:59:34.26,0:59:36.57,Default,FE,0,0,0,,أنا محترف في الوخز بالإبر.
Dialogue: 0,0:59:36.63,0:59:37.90,Default,FE,0,0,0,,هذه أفضل طريقة لـ
Dialogue: 0,0:59:37.90,0:59:39.24,Default,FE,0,0,0,,تدفق دم واضح.
Dialogue: 0,0:59:39.24,0:59:41.67,Default,FE,0,0,0,,-سألصقها أسفل مؤخرة الرأس...\N-توقف! توقف!
Dialogue: 0,0:59:42.04,0:59:43.27,Default,FE,0,0,0,,توقف من فضلك.
Dialogue: 0,0:59:43.77,0:59:45.27,Default,FE,0,0,0,,إذا عدت إلى رشدي،
Dialogue: 0,0:59:46.71,0:59:48.48,Default,FE,0,0,0,,ثم غداً سأكون ملكة.
Dialogue: 0,0:59:51.11,0:59:52.92,Default,FE,0,0,0,,ماذا سيكون الثأر في رأيك؟
Dialogue: 0,0:59:53.45,0:59:55.02,Default,FE,0,0,0,,على هجومك العنيف؟
Dialogue: 0,0:59:59.02,1:00:01.69,Default,FE,0,0,0,,الإفراط أسوأ من التقصير.
Dialogue: 0,1:00:01.69,1:00:04.86,Default,FE,0,0,0,,وبهذا سأكمل علاجي الابتكاري.
Dialogue: 0,1:00:07.83,1:00:10.77,Default,FE,0,0,0,,هذا صحيح، أنت معالج ممتاز.\NI لقد تعافيت تماماً.
Dialogue: 0,1:00:11.00,1:00:12.80,Default,FE,0,0,0,,أنا بخير. بالترتيب.
Dialogue: 0,1:00:15.44,1:00:18.37,Default,FE,0,0,0,,حسنًا. سوف أصبح ملكة،\Nsince كنت تريد ذلك كثيرا.
Dialogue: 0,1:00:18.77,1:00:20.78,Default,FE,0,0,0,,ملكة بلد بأكمله.
Dialogue: 0,1:00:20.81,1:00:23.31,Default,FE,0,0,0,,هل سيكون ملء بحيرة أو بركة أمرًا سهلاً؟
Dialogue: 0,1:00:45.80,1:00:48.64,Default,FE,0,0,0,,صاحب السمو، هل استيقظت بعد؟
Dialogue: 0,1:01:22.71,1:01:23.87,Default,FU,0,0,0,,أدخل.
Dialogue: 0,1:01:40.26,1:01:41.72,Default,FE,0,0,0,,هل أحتاج إلى ارتداء كل هذا؟
Dialogue: 0,1:01:43.23,1:01:45.66,Default,FE,0,0,0,,رداء الملكة الرسمي
Dialogue: 0,1:01:45.66,1:01:47.26,Default,FE,0,0,0,,الملابس الداخلية، ملابس داخلية طويلة،
Dialogue: 0,1:01:47.26,1:01:49.17,Default,FE,0,0,0,,سروال فضفاض، تنورة تحتية،
Dialogue: 0,1:01:49.17,1:01:51.03,Default,FE,0,0,0,,ملابس خارجية, قميص داخلي,
Dialogue: 0,1:01:51.03,1:01:53.00,Default,FE,0,0,0,,التنورة الأولى، التنورة الثانية،
Dialogue: 0,1:01:53.00,1:01:55.14,Default,FE,0,0,0,,التنورة الثالثة، وسترة بأشرطة ملونة
Dialogue: 0,1:01:55.14,1:01:57.64,Default,FE,0,0,0,,والسترة العلوية.
Dialogue: 0,1:01:58.51,1:02:01.04,Default,FE,0,0,0,,الملابس في الأعلى ذات قصة ضيقة وقريبة من الجسم،
Dialogue: 0,1:02:01.04,1:02:03.11,Default,FU,0,0,0,,الأسفل، على العكس من ذلك، واسع.
Dialogue: 0,1:02:03.11,1:02:05.95,Default,FE,0,0,0,,هذا يخلق وهم الشكل الرشيق المثالي للسيدة.
Dialogue: 0,1:02:05.95,1:02:08.75,Default,FU,0,0,0,,صغير للأعلى، للأسفل كبير
Dialogue: 0,1:02:11.59,1:02:13.06,Default,FE,0,0,0,,لا أستطيع التنفس.
Dialogue: 0,1:02:43.05,1:02:44.85,Default,FE,0,0,0,,خرز اليشم يغمض عينيه،
Dialogue: 0,1:02:45.09,1:02:48.09,Default,FE,0,0,0,,وآذان الياقوت.
Dialogue: 0,1:02:48.19,1:02:50.33,Default,FE,0,0,0,,علامة على أن الملك يجب أن
Dialogue: 0,1:02:50.33,1:02:52.59,Default,FE,0,0,0,,أغمض عينيك وأذنيك واستمع إلى حديقتك.
Dialogue: 0,1:02:58.00,1:02:59.37,Default,FE,0,0,0,,افرد رقبتك.
Dialogue: 0,1:02:59.60,1:03:00.90,Default,FE,0,0,0,,إنه ثقيل.
Dialogue: 0,1:03:00.90,1:03:03.54,Default,FE,0,0,0,,يجب أن تتحمل هذا العبء الثقيل.
Dialogue: 0,1:03:54.49,1:03:57.39,Default,FE,0,0,0,,أنا أول امرأة في جوسون بدون حمالة صدر.
Dialogue: 0,1:04:01.16,1:04:03.67,Default,FE,0,0,0,,القوس المتبادل.
Dialogue: 0,1:04:08.40,1:04:10.61,Default,FE,0,0,0,,-صاحب السمو.\N-ماذا تريد؟
Dialogue: 0,1:04:47.81,1:04:50.11,Default,FE,0,0,0,,نحن لا نحيي ذكرى أسلافنا هنا.
Dialogue: 0,1:04:50.11,1:04:52.55,Default,FE,0,0,0,,الزفاف - نفس الجنازة.
Dialogue: 0,1:04:57.12,1:04:58.65,Default,FE,0,0,0,,كم مرة يجب أن تنحني؟
Dialogue: 0,1:04:58.65,1:05:00.12,Default,FU,0,0,0,,2 أكثر.
Dialogue: 0,1:05:10.10,1:05:12.97,Default,FE,0,0,0,,يا له من زوجين جميلين.
Dialogue: 0,1:05:14.00,1:05:17.57,Default,FE,0,0,0,,كل ذلك بجهودك وصلواتك يا صاحب الجلالة.
Dialogue: 0,1:05:17.57,1:05:20.14,Default,FE,0,0,0,,أنا سعيد لأنك لاحظت هذا يا صاحب الجلالة.
Dialogue: 0,1:05:25.15,1:05:27.92,Default,PU,0,0,0,,ارفع الأوعية.
Dialogue: 0,1:05:59.68,1:06:01.68,Default,FE,0,0,0,,أخي،
Dialogue: 0,1:06:02.15,1:06:04.12,Default,FE,0,0,0,,لماذا تبكين؟
Dialogue: 0,1:06:07.32,1:06:10.19,Default,FE,0,0,0,,أنا سعيد لأن ابنتي أصبحت ملكة هذا البلد،
Dialogue: 0,1:06:11.43,1:06:12.69,Default,FU,0,0,0,,ولكن لا يزال -
Dialogue: 0,1:06:13.16,1:06:16.30,Default,FE,0,0,0,,أشعر وكأنني فقدت طفلي الوحيد.
Dialogue: 0,1:06:17.43,1:06:18.93,Default,FE,0,0,0,,حسنًا.
Dialogue: 0,1:06:19.64,1:06:22.40,Default,FE,0,0,0,,الآن أنت والد الملكة.
Dialogue: 0,1:06:22.94,1:06:25.57,Default,FE,0,0,0,,سيادته يونغجون.
Dialogue: 0,1:06:25.67,1:06:26.88,Default,FE,0,0,0,,حقاً؟
Dialogue: 0,1:06:27.84,1:06:29.14,Default,FU,0,0,0,,صحيح.
Dialogue: 0,1:06:35.68,1:06:38.79,Default,FE,0,0,0,,سويون من عائلة كيم أندونغ
Dialogue: 0,1:06:38.95,1:06:41.86,Default,FE,0,0,0,,أصبحت ملكة جوسون.
Dialogue: 0,1:06:42.36,1:06:44.53,Default,FE,0,0,0,,هذه هي المرة الأولى التي أسمع فيها اسم هذه المرأة.
Dialogue: 0,1:06:44.53,1:06:46.60,Default,FE,0,0,0,,يجب أن تحبني.
Dialogue: 0,1:07:05.31,1:07:07.82,Default,FE,0,0,0,,لا أستطيع، لا أستطيع التنفس.
Dialogue: 0,1:07:08.45,1:07:09.79,Default,FE,0,0,0,,أزمة قلبية؟
Dialogue: 0,1:07:33.18,1:07:35.14,Default,FE,0,0,0,,أظهر الاحترام!
Dialogue: 0,1:07:35.51,1:07:40.18,Default,FE,0,0,0,,حياة طويلة للملك والملكة!
Dialogue: 0,1:07:44.85,1:07:49.36,Default,FE,0,0,0,,ليس هناك أعداء أو حلفاء في القصر.
Dialogue: 0,1:07:49.53,1:07:53.60,Default,FE,0,0,0,,لا تفقد توازنك ولا تدع قلبك يغشى على عقلك.
Dialogue: 0,1:07:53.86,1:07:55.66,Default,FE,0,0,0,,لا تقلق.
Dialogue: 0,1:07:55.66,1:07:57.10,Default,FE,0,0,0,,أنا متوجه إلى القصر،
Dialogue: 0,1:07:57.10,1:07:59.64,Default,FE,0,0,0,,لأنني أريد أن أكون مفيداً لجلالته.
Dialogue: 0,1:07:59.70,1:08:01.00,Default,FE,0,0,0,,يا إلهي.
Dialogue: 0,1:08:05.24,1:08:08.44,Default,FE,0,0,0,,أيتها الممرضة، لن أموت.
Dialogue: 0,1:08:08.44,1:08:10.11,Default,FE,0,0,0,,لا تبكي من أجلي.
Dialogue: 0,1:08:11.61,1:08:13.95,Default,FE,0,0,0,,أيتها الشابة، أنت لطيفة للغاية.
Dialogue: 0,1:08:14.35,1:08:18.02,Default,FE,0,0,0,,لا أعرف إذا كان بإمكانك البقاء على قيد الحياة في القصر.
Dialogue: 0,1:08:18.69,1:08:22.06,Default,FE,0,0,0,,لا تقلق. سأخدم سيدتي بأمانة.
Dialogue: 0,1:09:31.06,1:09:33.36,Default,FE,0,0,0,,أنا أستسلم! أستسلم!
Dialogue: 0,1:09:38.27,1:09:40.50,Default,FE,0,0,0,,ظننت أننا سنقرأ القصائد في شرفة المراقبة.
Dialogue: 0,1:09:40.57,1:09:43.64,Default,FE,0,0,0,,ألم تكن قد حذرت\Nمن أن هذا تدريب وليس راحة؟
Dialogue: 0,1:09:43.81,1:09:45.07,Default,FE,0,0,0,,ألست مستريحاً؟
Dialogue: 0,1:09:45.07,1:09:47.01,Default,FE,0,0,0,,أتعرق في مكان بهذا المنظر.
Dialogue: 0,1:09:47.01,1:09:48.28,Default,FE,0,0,0,,تستريح؟
Dialogue: 0,1:09:48.28,1:09:50.65,Default,FE,0,0,0,,بسبب والد وزير الحرب، فمن الضروري بالفعل
Dialogue: 0,1:09:50.65,1:09:53.32,Default,FE,0,0,0,,أتدرب كل يوم - وأنا لا أحب الشؤون العسكرية حتى.
Dialogue: 0,1:09:53.32,1:09:55.12,Default,FE,0,0,0,,ماذا نفعل هنا؟
Dialogue: 0,1:09:55.22,1:09:57.65,Default,FE,0,0,0,,لو كنت أعلم، لما ذهبت معك أبداً.
Dialogue: 0,1:10:00.39,1:10:02.99,Default,FE,0,0,0,,قد تعتقد أنك تستعد للمعركة مع العدو.
Dialogue: 0,1:10:03.03,1:10:05.16,Default,FE,0,0,0,,لماذا انزعجت من هذه الأخبار الجيدة؟
Dialogue: 0,1:10:05.16,1:10:06.53,Default,FE,0,0,0,,ابنة عمك أصبحت ملكة.
Dialogue: 0,1:10:09.63,1:10:12.13,Default,FE,0,0,0,,لدي هانبوك مليء بالسعادة - لا أعرف ماذا أفعل به.
Dialogue: 0,1:10:13.47,1:10:16.51,Default,FE,0,0,0,,إذا كنت لا تحب القتال بالسيف، فربما يمكننا القتال بالأيدي؟
Dialogue: 0,1:10:17.64,1:10:20.11,Default,FE,0,0,0,,لقد غيرت رأيي. سأذهب للمنزل.
Dialogue: 0,1:10:24.05,1:10:25.61,Default,FE,0,0,0,,سوف تذهب عندما تهزمني.
Dialogue: 0,1:10:29.92,1:10:32.65,Default,FE,0,0,0,,أسرع فأسرع. لقد حفرت في رقبتي.
Dialogue: 0,1:10:34.36,1:10:36.36,Default,FE,0,0,0,,كاد يموت هناك.
Dialogue: 0,1:10:36.89,1:10:39.59,Default,FE,0,0,0,,جلسات التصوير مع مصفف الشعر هي\Ngarbage مقارنة بهذا.
Dialogue: 0,1:10:53.21,1:10:55.98,Default,FE,0,0,0,,لقد حصلنا على ترقية الرقم.
Dialogue: 0,1:10:56.14,1:10:57.68,Default,FE,0,0,0,,هذه قاعة دايجوجون.
Dialogue: 0,1:10:58.65,1:11:01.22,Default,FU,0,0,0,,الاسم يتوافق مع المكان.
Dialogue: 0,1:11:01.38,1:11:04.49,Default,FU,0,0,0,,هذا يعني أنه يتعين عليك تقديم مساهمة كبيرة.
Dialogue: 0,1:11:04.85,1:11:07.19,Default,FE,0,0,0,,هل تريدني أن أنقذ البلد أم ماذا؟
Dialogue: 0,1:11:07.56,1:11:08.76,Default,FE,0,0,0,,يجب أن تلد
Dialogue: 0,1:11:09.62,1:11:11.76,Default,FE,0,0,0,,إلى ملك الورثة.
Dialogue: 0,1:11:17.60,1:11:19.80,Default,FU,0,0,0,,بالضبط. إنها أيضًا ليلة الزفاف.
Dialogue: 0,1:11:21.70,1:11:24.94,Default,FE,0,0,0,,أكبر فوضى في كل 33 عاماً من حياة "جانغ بونغ هوان".
Dialogue: 0,1:11:39.89,1:11:42.69,Default,FE,0,0,0,,يجب أن يكون هناك طريقة للخروج من أي موقف.
Dialogue: 0,1:11:45.79,1:11:47.90,Default,FU,0,0,0,,يجب أن يكون.
Dialogue: 0,1:11:48.20,1:11:50.23,Default,FE,0,0,0,,لقد وصلت المشروبات.
Dialogue: 0,1:12:02.41,1:12:04.65,Default,FE,0,0,0,,بالضبط، الكحول.
Dialogue: 0,1:12:06.52,1:12:08.88,Default,FE,0,0,0,,وكان الأجداد يعرفون ماذا يفعلون.
Dialogue: 0,1:12:35.11,1:12:36.75,Default,FE,0,0,0,,دعني أسكبها لك.
Dialogue: 0,1:12:37.41,1:12:40.98,Default,FE,0,0,0,,ماذا يريد جلالته أن يشرب؟
Dialogue: 0,1:12:41.32,1:12:43.62,Default,FE,0,0,0,,أحب الوجبات الخفيفة أكثر من الكحول نفسه.
Dialogue: 0,1:12:44.02,1:12:45.22,Default,FE,0,0,0,,ما أنت...
Dialogue: 0,1:12:45.59,1:12:49.69,Default,FE,0,0,0,,اليوم يوم خاص.\Nلا تأكل أكثر من اللازم وتشرب بشكل أفضل.
Dialogue: 0,1:12:50.33,1:12:52.79,Default,FE,0,0,0,,الإفراط في تناول النبيذ يضر الجسم.
Dialogue: 0,1:12:53.30,1:12:54.60,Default,FE,0,0,0,,أوه، أيها الصغير...
Dialogue: 0,1:12:55.80,1:12:57.73,Default,FE,0,0,0,,هادئ، هادئ فقط.
Dialogue: 0,1:12:57.97,1:13:01.27,Default,FE,0,0,0,,لا يوجد كوري لا يفتخر بكمية استهلاكه.
Dialogue: 0,1:13:01.94,1:13:04.94,Default,FE,0,0,0,,فهمت. لذلك أنت لا تعرف كيف تشرب.
Dialogue: 0,1:13:04.94,1:13:07.34,Default,FE,0,0,0,,من الواضح على الفور أنك لن تشربني مرة أخرى.
Dialogue: 0,1:13:07.58,1:13:08.78,Default,FE,0,0,0,,وجيد.
Dialogue: 0,1:13:08.78,1:13:11.21,Default,FE,0,0,0,,كل الكحول في صالحك.
Dialogue: 0,1:13:11.95,1:13:14.65,Default,FE,0,0,0,,إنه مضاد للرصاص أم ماذا؟
Dialogue: 0,1:13:15.02,1:13:17.15,Default,FE,0,0,0,,لا يوجد تأثير.
Dialogue: 0,1:13:17.15,1:13:19.32,Default,FU,0,0,0,,حسنًا. هل تريد أن تلعب لعبة؟
Dialogue: 0,1:13:19.89,1:13:22.52,Default,FE,0,0,0,,أعرف بعض الألعاب التي تحتاج إلى الشرب فيها.
Dialogue: 0,1:13:23.36,1:13:24.53,Default,FE,0,0,0,,حقاً؟
Dialogue: 0,1:13:24.93,1:13:26.93,Default,FU,0,0,0,,3, 6, 9, 3, 6, 9,
Dialogue: 0,1:13:26.93,1:13:28.76,Default,FU,0,0,0,,3, 6, 9, 3, 6, 9.
Dialogue: 0,1:13:31.73,1:13:33.74,Default,FE,0,0,0,,متى ظهر جدول الضرب في كوريا؟
Dialogue: 0,1:13:33.74,1:13:36.04,Default,FE,0,0,0,,لا أعرف؟ ثم -
Dialogue: 0,1:13:36.04,1:13:39.31,Default,FU,0,0,0,,غراب العقعق، الغراب العقعق، الغراب العقعق,
Dialogue: 0,1:13:39.31,1:13:41.88,Default,PU,0,0,0,,غراب العقعق، غراب العقعق.
Dialogue: 0,1:13:41.88,1:13:44.88,Default,FE,0,0,0,,يبدو أن كلمة "العار" اخترعت لهذه الحالة.
Dialogue: 0,1:13:44.88,1:13:46.18,Default,FE,0,0,0,,مرحبًا، ماذا لا تفعل؟
Dialogue: 0,1:13:46.38,1:13:47.68,Default,FE,0,0,0,,ماذا علي أن أفعل؟
Dialogue: 0,1:13:48.05,1:13:50.15,Default,FE,0,0,0,,أعجبتني فكرة اللعب،
Dialogue: 0,1:13:50.55,1:13:53.66,Default,FE,0,0,0,,لكنك تصرخ فقط "غراب العقعق". ممل.
Dialogue: 0,1:13:54.36,1:13:55.92,Default,FE,0,0,0,,هذا خطأ.
Dialogue: 0,1:13:57.23,1:14:00.16,Default,FE,0,0,0,,الكحول يتطلب الرقص والموسيقى.
Dialogue: 0,1:14:04.07,1:14:07.50,Default,FE,0,0,0,,إلى متى يمكنك الرقص على موسيقى أسلافك القديمة؟
Dialogue: 0,1:14:07.50,1:14:08.67,Default,FE,0,0,0,,انتبه لأكتافك.
Dialogue: 0,1:14:08.67,1:14:10.34,Default,FU,0,0,0,,إنهم يصعدون لأعلى ولأسفل.
Dialogue: 0,1:14:10.34,1:14:11.67,Default,FE,0,0,0,,وينزل الزجاج،
Dialogue: 0,1:14:11.67,1:14:13.98,Default,FU,0,0,0,,أسفل, أسفل, أسفل.
Dialogue: 0,1:14:13.98,1:14:15.18,Default,FE,0,0,0,,الزجاج ينخفض،
Dialogue: 0,1:14:15.18,1:14:16.18,Default,FU,0,0,0,,أسفل, أسفل, أسفل.
Dialogue: 0,1:14:16.18,1:14:17.65,Default,FE,0,0,0,,هل أنت متحمس لهذه الدرجة؟
Dialogue: 0,1:14:22.18,1:14:25.12,Default,FE,0,0,0,,هل نجحت موسيقى الأجداد؟
Dialogue: 0,1:14:29.56,1:14:30.99,Default,FE,0,0,0,,إذن فلنبدأ؟
Dialogue: 0,1:14:40.07,1:14:42.40,Default,FE,0,0,0,,لا، ليس هذا ما قصدته!
Dialogue: 0,1:14:54.58,1:14:56.95,Default,FE,0,0,0,,سيتعين علينا اتخاذ خطوة متطرفة.
Dialogue: 0,1:15:39.39,1:15:42.20,Default,FE,0,0,0,,كيف يبدو الأمر عند الترحيب بيوم جديد كملكة؟
Dialogue: 0,1:15:42.20,1:15:43.37,Default,FE,0,0,0,,-حماقة.\N-هذا صحيح.
Dialogue: 0,1:15:43.37,1:15:46.37,Default,FE,0,0,0,,نحن نستعد لمعركة من أجل السلطة والانتقام.
Dialogue: 0,1:15:46.37,1:15:49.44,Default,FE,0,0,0,,الطريقة الوحيدة لمعاقبة من هم في السلطة هي
Dialogue: 0,1:15:49.44,1:15:52.17,Default,FE,0,0,0,,العثور على دليل على رشوتهم وسوء ضميرهم.
Dialogue: 0,1:15:52.17,1:15:53.54,Default,FE,0,0,0,,رؤيتها شخصياً،
Dialogue: 0,1:15:53.54,1:15:56.24,Default,FE,0,0,0,,أرى أن الملكة ليست نفسها بعد.
Dialogue: 0,1:15:56.24,1:15:58.51,Default,FE,0,0,0,,الأهم بالنسبة لنا من يجب أن تكون،
Dialogue: 0,1:15:58.51,1:16:01.35,Default,FE,0,0,0,,مما هي عليه.
Dialogue: 0,1:16:01.52,1:16:02.52,Default,FE,0,0,0,,هذه هدية.
Dialogue: 0,1:16:02.52,1:16:04.25,Default,FE,0,0,0,,إذا كانت هناك طريقة جيدة، فاستخدمها.
Dialogue: 0,1:16:04.25,1:16:06.02,Default,FE,0,0,0,,ما هو الملاذ الأخير الذي تتحدث عنه؟
Dialogue: 0,1:16:06.09,1:16:07.26,Default,FE,0,0,0,,جريمة قتل.
الحوار: 0,2:01:37.06,2:01:39.06,الحاضر,,0,0,0,,

التعليق: 0,1:14:21.04,1:14:25.45,Default,FE,0,0,0,,الملكة شخورين
