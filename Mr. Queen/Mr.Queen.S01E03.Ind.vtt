Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Ананас, Зингер, Бирюлька, Февраль,\NХозяин, Таракан
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.95,0:01:06.39,Default,,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.39,0:01:08.96,Default,,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:21.80,0:01:23.60,Default,,0,0,0,,Berapa banyak yang dia dengar?
Dialogue: 0,0:01:25.41,0:01:27.17,Default,,0,0,0,,Hal pertama yang dia ucapkan
Dialog: 0,0:01:27.17,0:01:29.38,Default,,0,0,0,,di bawah ancaman kematian, akan menentukan nasibnya.
Dialog: 0,0:01:30.68,0:01:32.01,Default,,0,0,0,,Dia akan mengatakan bahwa dia tidak mendengar apa pun
Dialog: 0,0:01:32.01,0:01:34.55,Default,,0,0,0,,atau meminta nyawanya, aku akan membunuhnya.
Dialog: 0,0:01:34.55,0:01:36.72,Default,,0,0,0,,Ini berarti dia mendengar semuanya.
Dialog: 0,0:01:37.48,0:01:38.89,Default,,0,0,0,,Kamu!
Dialogue: 0,0:01:39.59,0:01:42.12,Default,,0,0,0,,Jika kamu membunuhku, kamu akan mendapat masalah seumur hidupmu.
Dialog: 0,0:01:47.49,0:01:49.50,Default,,0,0,0,,Ini masih hal kecil.
Dialogue: 0,0:01:54.37,0:01:56.54,Default,,0,0,0,,Singkirkan benda itu.
Dialog: 0,0:01:57.97,0:01:59.37,Default,,0,0,0,,Tunggu sebentar.
Dialog: 0,0:01:59.37,0:02:02.54,Default,,0,0,0,,3 episode
Dialogue: 0,0:02:09.95,0:02:12.79,Default,,0,0,0,,Asal tahu saja, hari ini kamu mendapat jackpot.
Dialogue: 0,0:02:17.69,0:02:20.29,Default,,0,0,0,,Lihat, cantik kan? Semuanya milikmu.
Dialogue: 0,0:02:20.76,0:02:22.60,Default,,0,0,0,,Apakah dia mengulur waktu?
Dialog: 0,0:02:22.66,0:02:25.43,Default,,0,0,0,,Apa ini? Bukankah kamu seorang pencuri?
Dialog: 0,0:02:26.00,0:02:27.47,Default,,0,0,0,,Sial.
Dialogue: 0,0:02:27.87,0:02:30.87,Default,,0,0,0,,Apakah kamu tahu siapa aku?
Dialogue: 0,0:02:31.27,0:02:34.34,Default,,0,0,0,,-I...\N-Sekarang dia akan mengatakan bahwa dia adalah ratu.
Dialog: 0,0:02:35.31,0:02:37.88,Default,,0,0,0,,bertugas di pasukan khusus.
Dialog: 0,0:02:41.62,0:02:43.02,Default,,0,0,0,,Serangan.
Dialog: 0,0:02:44.25,0:02:46.72,Default,,0,0,0,,Apakah menurutmu semua juru masak di tentara itu bodoh?
Dialog: 0,0:02:46.99,0:02:48.59,Default,,0,0,0,,Koki Tentara
Dialog: 0,0:02:48.59,0:02:51.26,Default,,0,0,0,,akan membunuh hantu dengan pisau dapur.
Dialog: 0,0:02:51.39,0:02:53.89,Default,,0,0,0,,Maju! Aku tidak takut padamu.
Dialog: 0,0:02:54.03,0:02:56.60,Default,,0,0,0,,Ayo serang.
Dialogue: 0,0:02:56.60,0:03:00.33,Default,,0,0,0,,Bagaimana dia bisa mengatakan hal aneh seperti itu dengan begitu percaya diri?
Dialogue: 0,0:03:54.56,0:03:56.02,Default,,0,0,0,,Dan kamu keren.
Dialog: 0,0:04:17.91,0:04:19.78,Default,,0,0,0,,Wajah adalah kelemahannya.
Dialog: 0,0:04:31.63,0:04:33.16,Default,,0,0,0,,Keren.
Dialog: 0,0:04:38.47,0:04:40.00,Default,,0,0,0,,Tuhan.
Dialog: 0,0:05:55.31,0:05:57.31,Default,,0,0,0,,Yang Mulia menyembunyikan wajahnya,
Dialog: 0,0:05:57.31,0:05:59.38,Default,,0,0,0,,yang berarti dia tidak ingin mengungkapkan dirinya.
Dialog: 0,0:06:38.05,0:06:39.62,Default,,0,0,0,,Siapa kamu?
Dialog: 0,0:06:42.29,0:06:44.59,Default,,0,0,0,,Saya Kim Byungin dari keluarga Kim Jwageun.
Dialog: 0,0:06:46.13,0:06:47.86,Default,,0,0,0,,Apa yang kamu lakukan di sini?
Dialogue: 0,0:06:50.30,0:06:51.63,Default,,0,0,0,,Apakah kamu pernah dirampok?
Dialog: 0,0:06:51.63,0:06:53.50,Default,,0,0,0,,Dia tidak bisa pergi jauh.
Dialog: 0,0:06:54.50,0:06:56.47,Default,,0,0,0,,Cari segala sesuatu di sekitar.
Dialogue: 0,0:06:56.70,0:06:58.11,Default,,0,0,0,,Pencurinya tidak sendirian.
Dialog: 0,0:06:58.11,0:07:01.04,Default,,0,0,0,,Ya, berpencar dan cari semuanya.
Dialog: 0,0:07:13.22,0:07:15.12,Default,,0,0,0,,Kak, kamu baik-baik saja?
Dialog: 0,0:07:18.49,0:07:19.96,Default,,0,0,0,,Kakak?
Dialogue: 0,0:07:22.50,0:07:26.37,Default,,0,0,0,,Kenapa dia menatap adiknya begitu tajam?
Dialog: 0,0:07:28.14,0:07:29.57,Default,,0,0,0,,Soyeon!
Dialog: 0,0:07:31.51,0:07:33.84,Default,,0,0,0,,Pasti mengalami guncangan yang kuat.
Dialogue: 0,0:07:35.88,0:07:38.08,Default,,0,0,0,,Bajingan apa yang berani melakukan ini padanya?
Dialog: 0,0:07:47.19,0:07:49.22,Default,,0,0,0,,Emas... Ya Tuhan!
Dialogue: 0,0:07:50.76,0:07:53.03,Default,,0,0,0,,-Nah, apa itu.\N-Kenapa kamu menerobos masuk?
Dialog: 0,0:07:54.29,0:07:55.73,Default,,0,0,0,,Kami sedang mencari pencuri.
Dialog: 0,0:07:55.73,0:07:56.96,Default,,0,0,0,,Tuhan.
Dialog: 0,0:07:56.96,0:07:58.70,Default,,0,0,0,,Di mana kamu mengulurkan tanganmu?
Dialog: 0,0:07:58.70,0:08:02.27,Default,,0,0,0,,Mereka membuatku takut, jadi kuucapkan gerakanku keras-keras.
Dialog: 0,0:08:02.27,0:08:03.37,Default,,0,0,0,,Permainan ini berakhir.
Dialogue: 0,0:08:03.37,0:08:04.50,Default,,0,0,0,,Siapa bilang begitu?
Dialog: 0,0:08:04.50,0:08:06.31,Default,,0,0,0,,Maukah Anda melanjutkan, mengetahui apa yang ada di tangan saya?
Dialog: 0,0:08:06.31,0:08:08.98,Default,,0,0,0,,Masalahmu, kenapa aku harus kalah?
Dialogue: 0,0:08:08.98,0:08:10.71,Default,,0,0,0,,Dasar bajingan.
Dialog: 0,0:08:12.25,0:08:13.55,Default,,0,0,0,,Maaf, saya bertindak terlalu jauh.
Dialogue: 0,0:08:13.55,0:08:15.98,Default,,0,0,0,,Apakah kamu baru saja meludahi wajahku?
Dialog: 0,0:08:15.98,0:08:17.52,Default,,0,0,0,,Saya tidak tahu apa-apa!
Dialog: 0,0:08:20.05,0:08:21.96,Default,,0,0,0,,Untukmu!
Dialog: 0,0:08:24.49,0:08:27.13,Default,,0,0,0,,-Tangkap dia.\N-Tangkap?
Dialogue: 0,0:08:28.20,0:08:30.20,Default,,0,0,0,,Apa yang berdiri seperti pilar?
Dialogue: 0,0:08:30.20,0:08:32.00,Default,,0,0,0,,Jangan biarkan Anggota Dewan Hong kabur,
Dialogue: 0,0:08:32.00,0:08:33.83,Default,,0,0,0,,tutup pintunya dan keluar sekarang!
Dialog: 0,0:08:33.83,0:08:36.90,Default,,0,0,0,,Dia tidak tahu cara bertarung, tapi membuat dirinya sendiri kacau.
Dialogue: 0,0:08:36.90,0:08:39.91,Default,,0,0,0,,Hari ini aku akan meredakan emosinya!
Dialog: 0,0:08:40.87,0:08:42.84,Default,,0,0,0,,-Lindungi saya.\N-Lain kali.
Dialog: 0,0:08:42.84,0:08:45.41,Default,,0,0,0,,-Selanjutnya?\N-Kenapa kamu masih di sini?
Dialog: 0,0:08:45.55,0:08:48.05,Default,,0,0,0,,Jika kamu pergi begitu saja...
Dialog: 0,0:08:48.05,0:08:49.52,Default,,0,0,0,,Penasihat Hon.
Dialogue: 0,0:08:49.52,0:08:52.69,Default,,0,0,0,,Hari ini aku akan meredakan amarahmu!
Dialog: 0,0:08:54.86,0:08:56.46,Default,,0,0,0,,Keluarannya meyakinkan.
Dialogue: 0,0:08:59.59,0:09:02.40,Default,,0,0,0,,Tidak bisakah aku mengolok-olokmu lagi?
Dialog: 0,0:09:02.40,0:09:04.76,Default,,0,0,0,,Benarkah, maukah kamu mengacungkan pedangmu ke arahku?
Dialog: 0,0:09:07.20,0:09:09.90,Default,,0,0,0,,Tapi tidak sampai disitu! Saya tidak pernah sempat menikah!
Dialog: 0,0:09:10.20,0:09:11.64,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:09:12.81,0:09:15.48,Default,,0,0,0,,Terlewat. Bahkan pedang pun tidak ada di pihakmu.
Dialog: 0,0:09:35.16,0:09:36.96,Default,,0,0,0,,Apakah kamu terluka?
Dialog: 0,0:09:36.96,0:09:38.63,Default,,0,0,0,,Saya baik-baik saja.
Dialogue: 0,0:09:39.47,0:09:41.67,Default,,0,0,0,,Aku tak mengira Kim Byungin akan bersamanya.
Dialogue: 0,0:09:42.60,0:09:44.64,Default,,0,0,0,,Menurutmu itu jebakan?
Dialog: 0,0:09:45.37,0:09:48.01,Default,,0,0,0,,Mereka tidak akan menggunakan ratu sebagai umpan.
Dialog: 0,0:09:48.01,0:09:50.08,Default,,0,0,0,,Selain itu, reaksi ratu
Dialog: 0,0:09:50.08,0:09:53.05,Default,,0,0,0,,tidak biasa.\NIitu menghantuiku.
Dialog: 0,0:09:53.28,0:09:55.18,Default,,0,0,0,,Jika kita mulai bertindak tanpa memahaminya,
Dialog: 0,0:09:55.18,0:09:57.38,Default,,0,0,0,,mari kita memperburuk keadaan.
Dialogue: 0,0:09:57.72,0:09:59.89,Default,,0,0,0,,Mari kita pahami dulu apa yang terjadi.
Dialogue: 0,0:09:59.89,0:10:01.45,Default,,0,0,0,,Tapi apa,
Dialog: 0,0:10:01.82,0:10:04.22,Default,,0,0,0,,jika ratu mendengar semuanya?
Dialog: 0,0:10:05.63,0:10:08.16,Default,,0,0,0,,Saya berbicara dengan ratu.
Dialogue: 0,0:10:08.86,0:10:11.00,Default,,0,0,0,,Percaya pada penilaianku.
Dialog: 0,0:10:13.97,0:10:16.34,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:10:17.07,0:10:20.04,Default,,0,0,0,,Jika saya salah,
Dialog: 0,0:10:23.11,0:10:26.48,Default,,0,0,0,,pertumpahan darah akan dimulai.
Dialogue: 0,0:10:33.89,0:10:37.19,Default,,0,0,0,,3 episode: Di ranjang bersama musuh
Dialog: 0,0:10:48.47,0:10:49.77,Default,,0,0,0,,Tamu yang mulia.
Dialog: 0,0:10:49.77,0:10:52.07,Default,,0,0,0,,Aku melihatnya di peti mati,\Kecuali itu raja...
Dialog: 0,0:10:52.97,0:10:55.17,Default,,0,0,0,,Singkirkan senjatamu, simpan.
Dialog: 0,0:10:59.55,0:11:01.05,Default,,0,0,0,,Lewati.
Dialog: 0,0:11:07.65,0:11:10.32,Default,,0,0,0,,Saya ingin kunjungan kita tetap dirahasiakan.
Dialog: 0,0:11:10.32,0:11:11.82,Default,,0,0,0,,Ya.
Dialog: 0,0:11:20.33,0:11:21.83,Default,,0,0,0,,Tuhan.
Dialog: 0,0:11:26.57,0:11:28.94,Default,,0,0,0,,Dia pingsan karena ketakutan.
Dialog: 0,0:11:28.98,0:11:33.41,Default,,0,0,0,,Siapkan tempat tidurnya dan rawat dia secara rahasia.
Dialog: 0,0:11:33.41,0:11:34.85,Default,,0,0,0,,Ya.
Dialog: 0,0:11:58.94,0:12:00.84,Default,,0,0,0,,Yang Mulia, apa yang Anda lakukan di sini?
Dialog: 0,0:12:01.34,0:12:03.24,Default,,0,0,0,,Kamu lagi.
Dialog: 0,0:12:04.94,0:12:08.78,Default,,0,0,0,,Hanya kamu yang mencariku saat aku melarikan diri.
Dialogue: 0,0:12:09.65,0:12:14.09,Default,,0,0,0,,Besok adalah pernikahanmu.\NMengapa kamu ada di sini?
Dialogue: 0,0:12:14.89,0:12:17.92,Default,,0,0,0,,Kukira sebentar lagi aku akan jadi gila.\NItulah sebabnya aku meninggalkan istana.
Dialogue: 0,0:12:19.23,0:12:20.93,Default,,0,0,0,,Ikuti aku saja
Dialog: 0,0:12:22.20,0:12:23.76,Default,,0,0,0,,tidak kemana-mana.
Dialog: 0,0:12:50.92,0:12:55.96,Default,,0,0,0,,Aku akan mengembalikanmu ke istana - tak seorang pun akan menyadarinya.
Dialog: 0,0:12:58.67,0:13:01.30,Default,,0,0,0,,Besok adalah impian masa kecilku
Dialog: 0,0:13:02.67,0:13:05.07,Default,,0,0,0,,akan menjadi kenyataan.
Dialog: 0,0:13:05.97,0:13:08.91,Default,,0,0,0,,Saya bermimpi menjadi seorang ratu.
Dialog: 0,0:13:12.61,0:13:15.45,Default,,0,0,0,,Besok impianku akan menjadi kenyataan.
Dialog: 0,0:13:18.59,0:13:20.72,Default,,0,0,0,,Besok adalah mimpiku
Dialog: 0,0:13:23.06,0:13:24.92,Default,,0,0,0,,akan hilang.
Dialog: 0,0:13:28.96,0:13:30.83,Default,,0,0,0,,Apakah ada yang salah?
Dialogue: 0,0:13:32.70,0:13:34.73,Default,,0,0,0,,Aku takut.
Dialogue: 0,0:13:35.74,0:13:37.34,Default,,0,0,0,,Aku takut.
Dialogue: 0,0:13:38.57,0:13:41.07,Default,,0,0,0,,Menakutkan untuk hidup.
Dialog: 0,0:13:41.14,0:13:44.18,Default,,0,0,0,,-Yang Mulia.\N-Jangan panggil saya seperti itu.
Dialog: 0,0:13:45.15,0:13:47.88,Default,,0,0,0,,Setidaknya hari ini panggil namaku.
Dialog: 0,0:13:48.58,0:13:50.78,Default,,0,0,0,,Agar aku tidak lupa siapa diriku.
Dialog: 0,0:13:52.69,0:13:54.35,Default,,0,0,0,,Ke
Dialog: 0,0:13:56.59,0:13:58.29,Default,,0,0,0,,tidak kehilangan diriku sendiri.
Dialog: 0,0:13:59.16,0:14:01.79,Default,,0,0,0,,Apa yang begitu kamu takuti?
Dialog: 0,0:14:02.40,0:14:06.10,Default,,0,0,0,,Saya sama sekali bukan saya.
Dialogue: 0,0:14:06.93,0:14:09.50,Default,,0,0,0,,Selama ini aku hidup dengan berpikir bahwa inilah aku.
Dialog: 0,0:14:10.67,0:14:12.41,Default,,0,0,0,,Tapi bukan itu masalahnya.
Dialog: 0,0:14:12.47,0:14:15.74,Default,,0,0,0,,Tidak ada yang nyata tentang diriku, semuanya bohong.
Dialogue: 0,0:14:32.03,0:14:34.19,Default,,0,0,0,,Kamu adalah Soyeon.
Dialogue: 0,0:14:39.37,0:14:41.73,Default,,0,0,0,,Seorang wanita yang kukenal selama bertahun-tahun,
Dialog: 0,0:14:44.57,0:14:47.94,Default,,0,0,0,,diam-diam dicintai dan berharga.
Dialog: 0,0:14:57.12,0:14:59.35,Default,,0,0,0,,Aku tidak akan membiarkanmu kehilangan dirimu sendiri.
Dialog: 0,0:15:03.92,0:15:05.99,Default,,0,0,0,,Dan aku tidak akan pernah lupa.
Dialog: 0,0:15:57.68,0:15:59.18,Default,,0,0,0,,Yah
Dialog: 0,0:16:01.28,0:16:03.78,Default,,0,0,0,,terjadi malam itu?
Dialogue: 0,0:16:08.02,0:16:10.89,Default,,0,0,0,,Seseorang bunuh aku.
Dialog: 0,0:16:12.79,0:16:15.76,Default,Lily,0,0,0,,Saya menelepon tabib. Tunggu, Yang Mulia.
Dialogue: 0,0:16:18.06,0:16:19.77,Default,Lily,0,0,0,,Penipu ini.
Dialog: 0,0:16:20.27,0:16:21.63,Default,Lily,0,0,0,,Saya sudah sakit kepala.
Dialog: 0,0:16:21.63,0:16:23.47,Default,Lily,0,0,0,,Jangan ditampilkan di sini.
Dialog: 0,0:16:23.47,0:16:26.51,Default,Lily,0,0,0,,Jika tidak, Anda akan dibiarkan tanpa organ reproduksi.
Dialog: 0,0:16:30.18,0:16:33.45,Default,Lily,0,0,0,,Kalau begitu mungkin kamu harus makan? Tahan.
Dialogue: 0,0:16:39.65,0:16:42.32,Default,Lily,0,0,0,,Aku merasa mual. Sepertinya dia akan muntah.
Dialogue: 0,0:16:43.12,0:16:45.09,Default,Lily,0,0,0,,Dan berapa banyak yang kamu minum kemarin?
Dialog: 0,0:16:45.09,0:16:47.76,Default,Lily,0,0,0,,Wanita ini tidak menoleransi alkohol dengan baik.
Dialog: 0,0:16:48.13,0:16:50.56,Default,Lily,0,0,0,,Sudah lama sekali aku tidak memutus sambungan seperti ini.
Dialogue: 0,0:16:53.20,0:16:55.13,Default,Lily,0,0,0,,Bagaimana caraku kembali kemarin?
Dialogue: 0,0:16:56.34,0:16:59.41,Default,Lily,0,0,0,,Sepupumu, Pak Benin, membawakanmu.
Dialog: 0,0:16:59.41,0:17:02.14,Default,Lily,0,0,0,,Anda bisa mendapat masalah.
Dialog: 0,0:17:02.98,0:17:04.81,Default,Lily,0,0,0,,Terima kasih padanya, hanya aku
Dialog: 0,0:17:04.81,0:17:06.88,Default,Lily,0,0,0,,Saya tahu kamu keluar kemarin.
Dialog: 0,0:17:07.01,0:17:08.51,Default,Lily,0,0,0,,Adikku?
Dialog: 0,0:17:08.58,0:17:10.55,Default,Lily,0,0,0,,Di mana kita bertemu dengannya?
Dialog: 0,0:17:10.88,0:17:12.75,Default,Lily,0,0,0,,Saya tidak tahu persisnya.
Dialogue: 0,0:17:13.52,0:17:17.19,Default,Lily,0,0,0,,Ngomong-ngomong, dia bilang kamu pingsan karena ketakutan.
Dialogue: 0,0:17:17.19,0:17:19.66,Default,Lilia,0,0,0,,-Apa yang membuatmu takut?\N-Aku tidak pingsan.
Dialog: 0,0:17:19.66,0:17:21.66,Default,Lily,0,0,0,,Aku minum sampai pingsan.
Dialog: 0,0:17:21.76,0:17:24.20,Default,Lily,0,0,0,,Ngomong-ngomong, menjadi ratu itu keren.
Dialog: 0,0:17:24.20,0:17:25.97,Default,Lily,0,0,0,,Gerbang dibuka saat jam malam.
Dialogue: 0,0:17:25.97,0:17:28.00,Default,Lily,0,0,0,,Dia sepupumu
Dialog: 0,0:17:28.00,0:17:30.14,Default,Lily,0,0,0,,dan anak angkat Kim Jwageun.
Dialog: 0,0:17:30.14,0:17:31.67,Default,Lily,0,0,0,,Benarkah?
Dialog: 0,0:17:36.84,0:17:38.28,Default,Lily,0,0,0,,Di mana nyonya istana Choi?
Dialog: 0,0:17:38.28,0:17:39.78,Default,Lily,0,0,0,,Terlambat?
Dialogue: 0,0:17:40.91,0:17:42.98,Default,Lily,0,0,0,,Adikmu mengusirnya dari istana,
Dialog: 0,0:17:42.98,0:17:45.62,Default,Lily,0,0,0,,agar tidak ada yang tahu kalau kamu sedang sakit mabuk.
Dialog: 0,0:17:46.02,0:17:47.69,Default,Lily,0,0,0,,Dia tidak ingin pergi,
Dialog: 0,0:17:47.69,0:17:50.92,Default,Lily,0,0,0,,sulit untuk memaksanya.
Dialogue: 0,0:17:50.92,0:17:54.39,Default,Lily,0,0,0,,Kenapa semua orang enggan meninggalkan istana?
Dialog: 0,0:17:54.73,0:17:57.93,Default,Lily,0,0,0,,Berbahaya di luar istana.
Dialog: 0,0:17:58.16,0:18:01.07,Default,Lily,0,0,0,,Semua yang kamu butuhkan ada di istana.
Dialog: 0,0:18:01.43,0:18:04.07,Default,Lily,0,0,0,,Semua orang di sini terhipnotis, atau apa?
Dialog: 0,0:18:04.07,0:18:06.51,Default,Lily,0,0,0,,Ada sesuatu yang tidak dapat ditemukan di istana.
Dialog: 0,0:18:06.61,0:18:08.34,Default,Lily,0,0,0,,-Apa ini?\N-Kebebasan.
Dialog: 0,0:18:10.54,0:18:12.98,Default,Lily,0,0,0,,Di luar istana semuanya sama.
Dialog: 0,0:18:13.65,0:18:17.35,Default,Lily,0,0,0,,Oke, aku senang dia tidak ada di sana. Dia mengomeliku.
Dialog: 0,0:18:17.42,0:18:19.99,Default,Lily,0,0,0,,Kepala kecilku.
Dialogue: 0,0:18:21.52,0:18:24.06,Default,Lily,0,0,0,,Aku perlu ramen pedas untuk mengatasi mabukku
Dialog: 0,0:18:24.06,0:18:26.73,Default,Lily,0,0,0,,dan keringat. Obat yang bagus.
Dialog: 0,0:18:27.86,0:18:29.90,Default,Lily,0,0,0,,Tidak ada ramen di sini.
Dialog: 0,0:18:29.90,0:18:32.33,Default,Lily,0,0,0,,Dan minuman mabuk.
Dialog: 0,0:18:35.10,0:18:37.40,Default,Lily,0,0,0,,Tapi di sini aku punya kekuatan.
Dialog: 0,0:18:39.91,0:18:41.87,Default,Lily,0,0,0,,Tuhan.
Dialogue: 0,0:18:42.41,0:18:43.91,Default,Lily,0,0,0,,Nyalakan apinya.
Dialog: 0,0:18:44.44,0:18:45.58,Default,Lily,0,0,0,,-Nyalakan apinya.\N-Nyalakan apinya.
Dialog: 0,0:18:45.58,0:18:48.98,Default,Lily,0,0,0,,Aku tidak tahu apa yang diinginkannya.
Dialog: 0,0:18:48.98,0:18:50.05,Default,Lily,0,0,0,,Apa?
Dialog: 0,0:18:50.05,0:18:52.32,Default,Lily,0,0,0,,Makanan untuk aula Daejojon.
Dialog: 0,0:18:52.32,0:18:53.72,Default,Lily,0,0,0,,Ya.
Dialogue: 0,0:18:57.82,0:18:59.49,Default,Lily,0,0,0,,Omong kosong apa ini?
Dialog: 0,0:19:12.11,0:19:14.01,Default,Lily,0,0,0,,Apakah dagingnya sudah matang?
Dialogue: 0,0:19:33.66,0:19:35.26,Default,Lily,0,0,0,,Bukan ini.
Dialog: 0,0:19:36.73,0:19:38.83,Default,Lily,0,0,0,,Baiklah. Kali ini...
Dialog: 0,0:19:49.21,0:19:52.28,Default,Lily,0,0,0,,Sial. Apakah hanya ini yang bisa dia lakukan?
Dialogue: 0,0:19:55.45,0:19:58.62,Default,Lily,0,0,0,,Ada apa dengan makananku? Apa-apaan?
Dialog: 0,0:20:12.06,0:20:14.33,Default,Lily,0,0,0,,Ugh, makan sehat.
Dialog: 0,0:20:30.32,0:20:31.92,Default,Lily,0,0,0,,Tidak pedas sama sekali.
Dialog: 0,0:20:37.76,0:20:40.53,Default,Lily,0,0,0,,Sangat pedas. Apakah kamu ingin membunuhku?
Dialog: 0,0:20:45.97,0:20:47.57,Default,Lily,0,0,0,,Aku sudah muak!
Dialog: 0,0:20:47.57,0:20:49.97,Default,Lily,0,0,0,,Jika kamu tidak menyukainya, biarkan dia datang ke sini dan memasak!
Dialog: 0,0:20:49.97,0:20:53.61,Default,Lily,0,0,0,,Satu gangguan. Aku akan memasaknya sendiri.
Dialog: 0,0:20:59.71,0:21:01.41,Default,Lily,0,0,0,,Tungku memiliki kekuatan api,
Dialog: 0,0:21:01.41,0:21:03.12,Default,Lily,0,0,0,,tapi apinya sulit dikendalikan.
Dialog: 0,0:21:03.12,0:21:06.55,Default,Lily,0,0,0,,Konduktivitas termal boiler cukup tinggi.
Dialog: 0,0:21:09.72,0:21:11.86,Default,Lily,0,0,0,,Bagaimana jika Anda terluka, Yang Mulia?
Dialog: 0,0:21:11.86,0:21:13.16,Default,Lily,0,0,0,,Kamu belum lagi ke dapur sejak saat itu,
Dialog: 0,0:21:13.16,0:21:14.83,Default,Lily,0,0,0,,bagaimana kita berhenti bermain rumah-rumahan.
Dialog: 0,0:21:14.83,0:21:17.43,Default,Lily,0,0,0,,Meskipun aku hanya datang ke sini untuk bermain rumah-rumahan,
Dialog: 0,0:21:17.76,0:21:19.60,Default,Lily,0,0,0,,Aku memasak lebih baik dari dia.
Dialog: 0,0:21:23.64,0:21:25.17,Default,Lily,0,0,0,,Hati-hati, Yang Mulia.
Dialog: 0,0:21:25.17,0:21:27.27,Default,Lily,0,0,0,,Apakah kamu memeluknya seperti itu?
Dialog: 0,0:21:27.64,0:21:29.54,Default,Lily,0,0,0,,Hati-hati dengan jarimu.
Dialog: 0,0:21:34.48,0:21:35.98,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:21:42.56,0:21:45.16,Default,Lily,0,0,0,,Aku memasak untuk pertama kalinya, jadi aku tidak tahu apakah itu benar.
Dialog: 0,0:21:45.16,0:21:48.79,Default,Lily,0,0,0,,Sepertinya kamu perlu memotongnya seperti ini.
Dialog: 0,0:22:51.49,0:22:52.99,Default,Lily,0,0,0,,Ya.
Dialogue: 0,0:23:06.07,0:23:08.64,Default,Lily,0,0,0,,Saya yakin itu terlihat cantik.
Dialog: 0,0:23:08.64,0:23:10.88,Default,Lily,0,0,0,,Saya yakin itu tidak terlalu berpengalaman.
Dialog: 0,0:23:11.28,0:23:12.95,Default,Lily,0,0,0,,Tentu saja.
Dialog: 0,0:23:12.95,0:23:15.55,Default,Lily,0,0,0,,Ya. Anda benar sekali.
Dialog: 0,0:23:15.55,0:23:16.98,Default,Lily,0,0,0,,Biarkan aku pergi.
Dialog: 0,0:23:17.45,0:23:21.15,Default,Lily,0,0,0,,Saya telah bekerja di dapur kerajaan selama 30 tahun.
Dialog: 0,0:23:21.15,0:23:23.39,Default,Lily,0,0,0,,Memasak adalah puncak keterampilan.
Dialog: 0,0:23:24.89,0:23:26.19,Default,Lily,0,0,0,,Oke.
Dialog: 0,0:23:26.19,0:23:29.33,Default,Lily,0,0,0,,Saya akan mencobanya sendiri untuk memahami betapa buruknya itu.
Dialog: 0,0:23:29.43,0:23:31.53,Default,Lily,0,0,0,,Ini sama sekali tidak enak.
Dialog: 0,0:23:43.14,0:23:46.18,Default,Lily,0,0,0,,Tuhan.
Dialogue: 0,0:23:55.55,0:23:57.16,Default,Lily,0,0,0,,Apakah semuanya seburuk itu?
Dialogue: 0,0:23:59.43,0:24:01.06,Default,Lily,0,0,0,,Aroma Shiitake
Dialog: 0,0:24:01.73,0:24:03.36,Default,Lily,0,0,0,,dan daun bawang.
Dialog: 0,0:24:05.66,0:24:07.97,Default,Lily,0,0,0,,Aroma daging yang kaya.
Dialogue: 0,0:24:09.34,0:24:12.84,Default,Lily,0,0,0,,Rasa ketiga bahannya campur aduk. Dan ini...
Dialogue: 0,0:24:25.52,0:24:28.75,Default,Lily,0,0,0,,"Sam" itu tiga, "hyang" itu aroma,
Dialog: 0,0:24:28.75,0:24:31.12,Default,Lily,0,0,0,,dan “ra” adalah pot.
Dialog: 0,0:24:31.12,0:24:33.73,Default,Lily,0,0,0,,Tiga aroma dalam pot,
Dialog: 0,0:24:33.73,0:24:35.79,Default,Lily,0,0,0,,"samhyanra".
Dialog: 0,0:24:38.23,0:24:43.47,Default,Lily,0,0,0,,Samhyang ramen!
Dialog: 0,0:25:11.00,0:25:13.27,Default,Lily,0,0,0,,Persis sesuai kebutuhan.
Dialog: 0,0:25:13.27,0:25:16.04,Default,Lily,0,0,0,,Mosodium glutamat di sana.
Dialog: 0,0:25:16.04,0:25:17.60,Default,Lily,0,0,0,,Tapi lebih baik daripada tidak sama sekali.
Dialog: 0,0:25:19.07,0:25:22.88,Default,Lily,0,0,0,,Terima kasih, aku mencoba banyak makanan lezat,
Dialog: 0,0:25:22.88,0:25:25.94,Default,Lily,0,0,0,,tapi tidak ada yang luar biasa.
Dialog: 0,0:25:25.98,0:25:27.55,Default,Lily,0,0,0,,Coba lagi.
Dialogue: 0,0:25:28.85,0:25:33.05,Default,Lily,0,0,0,,Ketahuilah jika kamu ditawari ramen, inilah cinta sejati.
Dialog: 0,0:25:34.02,0:25:36.16,Default,Lily,0,0,0,,Lalu jika Anda tidak keberatan.
Dialog: 0,0:25:43.60,0:25:45.56,Default,Lily,0,0,0,,Ini sangat...
Dialog: 0,0:25:46.40,0:25:48.33,Default,Lily,0,0,0,,Kamu, yang belum pernah memegang pisau sebelumnya,
Dialog: 0,0:25:48.33,0:25:50.30,Default,Lily,0,0,0,,memasak lebih baik dari koki kerajaan.
Dialog: 0,0:25:50.47,0:25:53.64,Default,Lily,0,0,0,,Apakah ada yang tidak bisa kamu lakukan?
Dialog: 0,0:25:55.04,0:25:59.24,Default,Lily,0,0,0,,Saya adalah orang yang ideal, mampu melakukan apa pun.
Dialog: 0,0:25:59.85,0:26:02.18,Default,Lily,0,0,0,,Tetapi sekarang saya tidak dapat melakukan hal yang paling penting.
Dialogue: 0,0:26:02.82,0:26:06.25,Default,Lily,0,0,0,,Apa yang saya kuasai dan paling saya sukai.
Dialog: 0,0:26:08.19,0:26:11.42,Default,Lily,0,0,0,,Begitu. Sulaman?
Dialog: 0,0:26:11.82,0:26:14.59,Default,Lily,0,0,0,,Tepat. Kamu melakukannya dengan baik.
Dialog: 0,0:26:16.03,0:26:17.50,Default,Lily,0,0,0,,Ya.
Dialogue: 0,0:26:17.90,0:26:19.77,Default,Lily,0,0,0,,Saat kusentuh,
Dialog: 0,0:26:19.77,0:26:23.60,Default,Lily,0,0,0,,bunga bermekaran dan kupu-kupu beterbangan.
Dialog: 0,0:26:23.87,0:26:26.41,Default,Lily,0,0,0,,Itu adalah sesuatu.
Dialog: 0,0:26:29.07,0:26:31.98,Default,Lily,0,0,0,,Yang Mulia ada di sini.
Dialog: 0,0:26:32.55,0:26:34.51,Default,Lily,0,0,0,,Kenapa sekarang?
Dialog: 0,0:26:34.51,0:26:37.28,Default,Lily,0,0,0,,Sial. Mienya akan melunak.
Dialog: 0,0:26:39.72,0:26:41.12,Default,Lily,0,0,0,,Panas.
Dialog: 0,0:26:44.92,0:26:46.46,Default,Lily,0,0,0,,Ratuku.
Dialog: 0,0:26:57.04,0:26:58.84,Default,Lily,0,0,0,,Di pagi hari saya mengunjungi para tetua
Dialogue: 0,0:26:58.84,0:27:01.97,Default,Lily,0,0,0,,dan aku penasaran bagaimana perasaanmu, jadi aku berkunjung.
Dialog: 0,0:27:02.84,0:27:05.08,Default,Lily,0,0,0,,Apakah dia tahu tentang tadi malam?
Dialog: 0,0:27:05.44,0:27:07.68,Default,Lily,0,0,0,,Tidak ada alasan untuk merasa buruk.
Dialogue: 0,0:27:07.88,0:27:10.45,Default,Lily,0,0,0,,Bagaimana malammu?
Dialog: 0,0:27:10.45,0:27:12.05,Default,Lily,0,0,0,,Ganti topik pembicaraan.
Dialog: 0,0:27:12.05,0:27:14.09,Default,Lily,0,0,0,,Dia mengubah topik pembicaraan.
Dialogue: 0,0:27:14.95,0:27:16.56,Default,Lily,0,0,0,,Doa-Mu.
Dialog: 0,0:27:19.49,0:27:22.66,Default,Lily,0,0,0,,Ratu, apakah kamu sudah minum?
Dialog: 0,0:27:23.73,0:27:26.50,Default,Lily,0,0,0,,Saya? Tentu saja tidak.
Dialog: 0,0:27:26.50,0:27:28.20,Default,Lily,0,0,0,,Apakah kamu belum minum?
Dialogue: 0,0:27:33.37,0:27:35.01,Default,Lily,0,0,0,,Apakah kita sedang bertanding menatap?
Dialog: 0,0:27:39.68,0:27:42.55,Default,Lily,0,0,0,,Aku tidak tahu kamu pembohong yang baik.
Dialog: 0,0:27:50.32,0:27:52.06,Default,Lily,0,0,0,,Oh, maaf.
Dialog: 0,0:27:52.32,0:27:54.13,Default,Lily,0,0,0,,Saya biasanya tidak melakukan ini,
Dialog: 0,0:27:54.13,0:27:56.46,Default,Lily,0,0,0,,tapi kamu terlalu dekat.
Dialogue: 0,0:27:59.97,0:28:02.20,Default,Lily,0,0,0,,Hidungku hampir copot.
Dialog: 0,0:28:02.77,0:28:04.44,Default,Lily,0,0,0,,Banyak yang harus kulakukan. Maaf.
Dialog: 0,0:28:04.44,0:28:06.31,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:28:08.24,0:28:10.08,Default,Lily,0,0,0,,Saya akan pergi ke aula Songjeongjong.
Dialog: 0,0:28:10.08,0:28:11.58,Default,Lily,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:28:15.88,0:28:19.08,Default,Lily,0,0,0,,Sepertinya dia tidak terlalu sibuk. \NTetapi jika demikian, mengapa Anda datang ke sini?
Dialog: 0,0:28:20.72,0:28:23.36,Default,Lily,0,0,0,,Sial, sekarang dia melunak.
Dialog: 0,0:28:33.27,0:28:35.47,Default,Spillik,0,0,0,,Salam, raja.
Dialog: 0,0:28:35.47,0:28:36.94,Default,Spillit,0,0,0,,Saudara.
Dialogue: 0,0:28:37.10,0:28:39.51,Default,Spillit,0,0,0,,Mendekatlah
Dialogue: 0,0:28:39.51,0:28:41.84,Default,Spillik,0,0,0,,dan katakan padaku, apakah aku bau?
Dialog: 0,0:28:41.84,0:28:43.38,Default,Spillie,0,0,0,,Bau?
Dialog: 0,0:28:43.81,0:28:45.78,Default,Spillik,0,0,0,,Saya belum bisa mengatakannya.
Dialog: 0,0:28:46.21,0:28:48.41,Default,Spillit,0,0,0,,Siapkan semuanya.
Dialogue: 0,0:28:51.12,0:28:54.02,Default,Spillit,0,0,0,,Apa yang dimakan ratuku?
Dialogue: 0,0:28:54.19,0:28:57.22,Default,Spillik,0,0,0,,Sayang sekali!
Dialog: 0,0:29:05.23,0:29:08.43,Default,Spillik,0,0,0,,Yang Mulia, Kim Byungin telah tiba.
Dialog: 0,0:29:08.97,0:29:11.50,Default,Spillik,0,0,0,,Hah, saudara?
Dialogue: 0,0:29:13.17,0:29:16.24,Default,Spillik,0,0,0,,Aku berhutang banyak padamu semalam.
Dialog: 0,0:29:16.24,0:29:18.78,Default,Spillik,0,0,0,,Saya melakukan apa yang harus saya lakukan.
Dialog: 0,0:29:22.45,0:29:25.28,Default,Spillik,0,0,0,,Karena aku punya tamu, aku harus menawarkan teh.
Dialog: 0,0:29:25.28,0:29:27.05,Default,Spillik,0,0,0,,Aku merindukanmu.
Dialog: 0,0:29:27.65,0:29:29.62,Default,Spillik,0,0,0,,Ini jatuh di kepalaku.
Dialog: 0,0:29:29.62,0:29:32.16,Default,Spillit,0,0,0,,Oke. Kami harus bermain bersama.
Dialog: 0,0:29:32.22,0:29:34.49,Default,Spillik,0,0,0,,Aku juga merindukanmu.
Dialog: 0,0:29:35.93,0:29:37.60,Default,Spillik,0,0,0,,Senang mendengarnya.
Dialog: 0,0:29:38.10,0:29:42.20,Default,XO,0,0,0,,Kata-katamu menghilangkan kekhawatiranku.
Dialog: 0,0:29:42.30,0:29:44.74,Default,XO,0,0,0,,Apa yang begitu menyentuh hatinya?
Dialog: 0,0:29:44.74,0:29:46.57,Default,XO,0,0,0,,Saya pernah mendengar rumor,
Dialog: 0,0:29:47.34,0:29:50.01,Default,XO,0,0,0,,bahwa kamu jatuh ke danau setelah bertemu denganku.
Dialogue: 0,0:29:50.01,0:29:52.28,Default,XO,0,0,0,,Hari itu mereka bilang takut.
Dialog: 0,0:29:52.51,0:29:54.11,Default,XO,0,0,0,,Tentang apa?
Dialog: 0,0:29:55.48,0:29:59.15,Default,XO,0,0,0,,Saya bilang hari itu bahwa saya takut...
Dialogue: 0,0:29:59.15,0:30:02.39,Default,XO,0,0,0,,Dan aku takut?..
Dialogue: 0,0:30:04.12,0:30:08.09,Default,XO,0,0,0,,Tidak ada yang lebih buruk di dunia ini selain manusia.
Dialogue: 0,0:30:08.46,0:30:10.76,Default,XO,0,0,0,,Apakah kamu diancam?
Dialog: 0,0:30:11.46,0:30:13.73,Default,XO,0,0,0,,Kamu tahu siapa yang mendorong
Dialogue: 0,0:30:13.73,0:30:15.27,Default,XO,0,0,0,,kamu masuk ke dalam danau
Dialog: 0,0:30:15.27,0:30:16.90,Default,XO,0,0,0,,dan diserang tadi malam?
Dialog: 0,0:30:17.60,0:30:19.10,Default,XO,0,0,0,,Berhenti.
Dialog: 0,0:30:19.20,0:30:21.14,Default,XO,0,0,0,,Saya tahu tentang danau.
Dialog: 0,0:30:21.17,0:30:23.54,Default,XO,0,0,0,,Bagaimana dengan tadi malam?
Dialogue: 0,0:30:24.24,0:30:27.01,Default,ХО,0,0,0,,-Apa yang kamu bicarakan?\N-Kamu tidak ingat?
Dialog: 0,0:30:27.38,0:30:29.62,Default,XO,0,0,0,,Mereka mencoba membunuhmu tadi malam.
Dialog: 0,0:30:29.62,0:30:31.12,Default,XO,0,0,0,,Bunuh?
Dialogue: 0,0:30:31.42,0:30:33.12,Default,XO,0,0,0,,Apa aku hampir mati?
Dialog: 0,0:30:33.12,0:30:34.95,Default,XO,0,0,0,,Siapa itu? Mengapa saya?
Dialog: 0,0:30:34.95,0:30:36.96,Default,XO,0,0,0,,Saya harap Anda tahu,
Dialog: 0,0:30:37.86,0:30:39.49,Default,XO,0,0,0,,tapi saya tidak melihat.
Dialog: 0,0:30:40.06,0:30:43.93,Default,XO,0,0,0,,Apa? Apakah dua orang sudah mencoba membunuhnya?
Dialog: 0,0:30:44.43,0:30:46.06,Default,XO,0,0,0,,Apakah wanita ini dalam bahaya?
Dialog: 0,0:30:46.06,0:30:47.77,Default,XO,0,0,0,,Pada hari kamu jatuh ke danau
Dialogue: 0,0:30:47.77,0:30:51.27,Default,XO,0,0,0,,kamu bilang kamu takut. Saya pikir itu ada hubungannya dengan itu.
Dialog: 0,0:30:51.54,0:30:55.01,Default,XO,0,0,0,,Sepertinya Anda belum menyadarinya.\N Saya punya masalah dengan ingatan saya.
Dialog: 0,0:30:55.01,0:30:58.54,Default,XO,0,0,0,,Anda sebaiknya tahu apa yang kita bicarakan.
Dialog: 0,0:30:59.75,0:31:01.25,Default,XO,0,0,0,,Kamu benar
Dialog: 0,0:31:03.92,0:31:06.55,Default,XO,0,0,0,,lupa segalanya tentang hari itu?
Dialog: 0,0:31:06.55,0:31:09.32,Default,XO,0,0,0,,Ya, saya tidak ingat apa pun.
Dialog: 0,0:31:12.22,0:31:13.76,Default,XO,0,0,0,,Tidak masalah.
Dialog: 0,0:31:13.76,0:31:15.96,Default,XO,0,0,0,,Katakan padaku, orang ini...
Dialog: 0,0:31:16.56,0:31:20.50,Default,XO,0,0,0,,Apa yang bajingan ini lakukan padaku kemarin?
Dialogue: 0,0:31:21.00,0:31:23.24,Default,XO,0,0,0,,Sudah hampir jam malam.
Dialog: 0,0:31:23.24,0:31:24.97,Default,XO,0,0,0,,Dilihat dari cara dia memegang pedang
Dialog: 0,0:31:24.97,0:31:28.17,Default,XO,0,0,0,,dan dia berpakaian, dia bukan orang biasa.
Dialog: 0,0:31:28.44,0:31:30.58,Default,XO,0,0,0,,Saya tidak tahu ada berapa,
Dialogue: 0,0:31:30.64,0:31:33.04,Default,XO,0,0,0,,tapi mereka membantunya.
Dialogue: 0,0:31:33.05,0:31:35.61,Default,XO,0,0,0,,Jika bukan karena kamu, aku pasti sudah mati.
Dialogue: 0,0:31:35.61,0:31:38.42,Default,XO,0,0,0,,Senang sekali kita bertemu kemarin.
Dialogue: 0,0:31:44.39,0:31:45.86,Default,XO,0,0,0,,Hah?
Dialog: 0,0:31:51.56,0:31:53.27,Default,XO,0,0,0,,Hei.
Dialog: 0,0:31:58.24,0:32:00.84,Default,XO,0,0,0,,Mengapa kamu meninggalkan istana tadi malam?
Dialog: 0,0:32:00.84,0:32:03.88,Default,ХО,0,0,0,,Aku bosan dan memutuskan untuk berjalan-jalan.
Dialog: 0,0:32:05.64,0:32:09.58,Default,XO,0,0,0,,Jika Janda Ratu mengetahuinya,
Dialog: 0,0:32:09.58,0:32:12.12,Default,XO,0,0,0,,Saya dalam masalah.
Dialog: 0,0:32:12.55,0:32:15.69,Default,XO,0,0,0,,Kebebasan bergerakku tidak hanya akan dibatasi,
Dialog: 0,0:32:15.69,0:32:17.66,Default,XO,0,0,0,,tetapi Hongyeon juga dieksekusi.
Dialog: 0,0:32:18.26,0:32:21.23,Default,XO,0,0,0,,Bisakah kamu merahasiakan ini?
Dialog: 0,0:32:21.59,0:32:23.93,Default,XO,0,0,0,,Tapi kita perlu menemukan penjahatnya.
Dialog: 0,0:32:24.36,0:32:26.26,Default,XO,0,0,0,,Lakukan dengan tenang.
Dialog: 0,0:32:26.33,0:32:29.20,Default,XO,0,0,0,,Aku akan mendapat masalah, tahu?
Dialog: 0,0:32:30.20,0:32:31.70,Default,XO,0,0,0,,Saya mengerti.
Dialog: 0,0:32:31.70,0:32:34.07,Default,XO,0,0,0,,Siapa yang tahu kamu meninggalkan istana?
Dialog: 0,0:32:34.07,0:32:36.27,Default,XO,0,0,0,,Honyoung saja.
Dialog: 0,0:32:37.34,0:32:40.31,Default,XO,0,0,0,,Saya akan suruh orang mengawasinya.
Dialog: 0,0:32:40.31,0:32:44.55,Default,XO,0,0,0,,Tidak, dia setia padaku, dia bahkan siap mati untukku.
Dialog: 0,0:32:44.55,0:32:45.98,Default,XO,0,0,0,,Dia tidak ada hubungannya dengan itu.
Dialog: 0,0:32:45.98,0:32:49.96,Default,XO,0,0,0,,Yang Mulia, jangan percaya siapa pun.
Dialog: 0,0:32:49.96,0:32:51.89,Default,ХО,0,0,0,,Aku juga sudah lama mengenalnya,
Dialogue: 0,0:32:51.89,0:32:54.53,Default,XO,0,0,0,,tapi orang terdekatmu selalu lebih berbahaya.
Dialog: 0,0:32:55.26,0:32:58.70,Default,XO,0,0,0,,Hanya karena kamu berada di istana bukan berarti tidak ada yang mengancammu. Tidak.
Dialogue: 0,0:33:00.53,0:33:02.80,Default,XO,0,0,0,,Lebih berbahaya lagi di sini.
Dialog: 0,0:33:03.20,0:33:07.11,Default,XO,0,0,0,,Tepat sekali, saya benar-benar lupa di mana saya berada.
Dialog: 0,0:33:07.11,0:33:09.21,Default,XO,0,0,0,,Di istana yang penuh intrik.
Dialog: 0,0:33:09.21,0:33:12.78,Default,XO,0,0,0,,Tempat dimana hidupmu selalu seimbang.
Dialog: 0,0:33:14.48,0:33:16.78,Default,XO,0,0,0,,Jangan khawatir.
Dialogue: 0,0:33:16.92,0:33:19.38,Default,XO,0,0,0,,Aku akan melindungimu.
Dialog: 0,0:33:19.95,0:33:21.72,Default,XO,0,0,0,,Terima kasih, tapi
Dialog: 0,0:33:21.95,0:33:23.72,Default,XO,0,0,0,,Saya bisa mengatasinya sendiri.
Dialog: 0,0:33:24.86,0:33:27.29,Default,XO,0,0,0,,Sekarang bukan waktunya bersantai.
Dialog: 0,0:33:27.59,0:33:31.06,Default,XO,0,0,0,,Jangan mencoba tampil kuat di hadapanku.
Dialogue: 0,0:33:47.61,0:33:49.75,Default,XO,0,0,0,,Mungkin kamu lupa,
Dialogue: 0,0:33:50.18,0:33:52.32,Default,XO,0,0,0,,tapi aku akan mengingatnya selamanya.
Dialog: 0,0:33:52.75,0:33:55.95,Default,XO,0,0,0,,Kenangan malam itu akan selamanya tersimpan di hatiku.
Dialog: 0,0:34:01.23,0:34:04.33,Default,XO,0,0,0,,Saya akan mencari tahu siapa orang itu dengan cara apa pun.
Dialog: 0,0:34:06.30,0:34:09.07,Default,XO,0,0,0,,
Dialog: 0,0:34:11.20,0:34:14.44,Default,XO,0,0,0,,Mereka menjual benang sutra di sini
Dialog: 0,0:34:14.94,0:34:16.41,Default,XO,0,0,0,,dari Qing?
Dialog: 0,0:34:36.19,0:34:39.50,Default,XO,0,0,0,,Saya dengar Anda memiliki barang berharga dari Qing, jadi saya datang.
Dialog: 0,0:34:46.24,0:34:49.01,Default,XO,0,0,0,,Rumor menyebar dengan cepat.
Dialog: 0,0:34:50.84,0:34:52.28,Default,XO,0,0,0,,Tolong.
Dialogue: 0,0:35:08.56,0:35:13.53,Default,XO,0,0,0,,Apakah kamu menyimpan barang berharga di tempat yang menyeramkan?
Dialog: 0,0:35:14.47,0:35:16.97,Default,XO,0,0,0,,Karena mereka berharga.
Dialog: 0,0:35:30.25,0:35:31.68,Default,XO,0,0,0,,Di Sini.
Dialog: 0,0:35:31.85,0:35:33.55,Default,XO,0,0,0,,Apa ini?
Dialog: 0,0:35:34.85,0:35:37.82,Default,XO,0,0,0,,Tutup satu mata.
Dialog: 0,0:35:38.29,0:35:42.23,Default,XO,0,0,0,,Dan kemudian putar. Begitulah cara kerjanya.
Dialog: 0,0:35:42.23,0:35:44.56,Default,XO,0,0,0,,Master! Di Sini?
Dialogue: 0,0:35:44.56,0:35:46.06,Default,XO,0,0,0,,Aku datang!
Dialog: 0,0:35:46.83,0:35:48.90,Default,XO,0,0,0,,Sepertinya Anda salah paham.
Dialog: 0,0:35:48.90,0:35:51.54,Default,XO,0,0,0,,Saya mencari benang sutra...
Dialog: 0,0:35:53.57,0:35:55.74,Default,XO,0,0,0,,Saya ingin membeli benang.
Dialog: 0,0:35:56.61,0:35:59.38,Default,XO,0,0,0,,Apa yang harus saya lakukan dengan pipa ini?
Dialogue: 0,0:36:17.23,0:36:20.00,Default,XO,0,0,0,,Kim Byungin bilang jangan percaya siapapun.
Dialog: 0,0:36:20.00,0:36:21.67,Default,XO,0,0,0,,Jadi bagaimana kamu bisa mempercayainya?
Dialog: 0,0:36:22.23,0:36:24.37,Default,XO,0,0,0,,Honyeon tidak akan menyakitiku.
Dialog: 0,0:36:24.64,0:36:27.11,Default,XO,0,0,0,,Mungkin Cho Hwajin lagi?
Dialogue: 0,0:36:28.14,0:36:29.47,Default,XO,0,0,0,,Seminggu adalah selamanya.
Dialog: 0,0:36:29.47,0:36:31.58,Default,XO,0,0,0,,Tidak butuh waktu lama untuk mati.
Dialog: 0,0:36:32.28,0:36:33.88,Default,XO,0,0,0,,Saya akan melakukan apa yang saya kuasai.
Dialogue: 0,0:36:33.88,0:36:35.58,Default,XO,0,0,0,,Aku akan menang dengan makanan.
Dialog: 0,0:36:35.61,0:36:37.52,Default,XO,0,0,0,,Dia akan mengalahkan armor apa pun.
Dialog: 0,0:36:37.52,0:36:39.62,Default,XO,0,0,0,,Dan itu akan bekerja pada Janda Ratu.
Dialogue: 0,0:36:42.65,0:36:44.09,Default,XO,0,0,0,,Tunggu sebentar.
Dialogue: 0,0:36:44.26,0:36:46.69,Default,XO,0,0,0,,Apakah ini sisa Janda Ratu?
Dialog: 0,0:36:46.69,0:36:48.19,Default,XO,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:36:50.30,0:36:52.60,Default,XO,0,0,0,,Biar saya lihat.
Dialog: 0,0:36:52.80,0:36:54.57,Default,XO,0,0,0,,Sisa makanan bisa memberi gambaran
Dialog: 0,0:36:54.57,0:36:56.94,Default,XO,0,0,0,,tentang kesehatan dan preferensi.
Dialog: 0,0:36:56.94,0:36:59.60,Default,XO,0,0,0,,Anda tidak dapat melihatnya.
Dialog: 0,0:36:59.60,0:37:01.04,Default,XO,0,0,0,,Hapus.
Dialog: 0,0:37:01.34,0:37:03.98,Default,XO,0,0,0,,Apa yang kamu lakukan? Saya ratunya.
Dialog: 0,0:37:03.98,0:37:05.48,Default,XO,0,0,0,,Maaf,
Dialog: 0,0:37:05.48,0:37:07.78,Default,XO,0,0,0,,tapi saya adalah koki kerajaan.
Dialog: 0,0:37:07.78,0:37:09.68,Default,XO,0,0,0,,Artinya di dapur -
Dialog: 0,0:37:09.68,0:37:11.98,Default,XO,0,0,0,,Akulah rajanya.
Dialog: 0,0:37:12.88,0:37:15.65,Default,XO,0,0,0,,Kalau begitu biarkan keahlian kita berbicara sendiri.
Dialog: 0,0:37:16.79,0:37:18.46,Default,XO,0,0,0,,Mari kita lihat siapa raja di sini.
Dialog: 0,0:37:21.19,0:37:23.03,Default,XO,0,0,0,,Jangan katakan itu.
Dialog: 0,0:37:23.16,0:37:26.46,Default,XO,0,0,0,,Sudah waktunya aku memasak. Selamat tinggal.
Dialogue: 0,0:37:26.83,0:37:29.37,Default,XO,0,0,0,,Apa, kamu takut kalah?
Dialog: 0,0:37:30.04,0:37:32.97,Default,XO,0,0,0,,Seseorang yang hanya bermain di dapur saat kecil?
Dialog: 0,0:37:46.85,0:37:50.05,Default,XO,0,0,0,,Nah, bagaimana persiapannya?..
Dialog: 0,0:38:19.38,0:38:20.92,Default,XO,0,0,0,,Dewa!
Dialog: 0,0:38:23.79,0:38:25.52,Default,XO,0,0,0,,Ratu!
Dialog: 0,0:38:25.52,0:38:28.39,Default,XO,0,0,0,,Ratu!
Dialog: 0,0:38:28.39,0:38:30.63,Default,XO,0,0,0,,Koki Kerajaan!
Dialog: 0,0:38:30.63,0:38:46.81,Default,XO,0,0,0,,-Ratu!\N-Koki Kerajaan!
Dialog: 0,0:38:57.52,0:38:59.22,Default,XO,0,0,0,,Berhenti.
Dialog: 0,0:39:04.23,0:39:05.76,Default,XO,0,0,0,,Tidak!
Dialog: 0,0:39:07.87,0:39:09.30,Default,XO,0,0,0,,Sial.
Dialog: 0,0:39:12.54,0:39:14.04,Default,XO,0,0,0,,Memasak
Dialog: 0,0:39:14.64,0:39:16.47,Default,XO,0,0,0,,kecepatan itu penting.
Dialogue: 0,0:39:16.47,0:39:19.34,Default,XO,0,0,0,,Tapi rasa lebih penting lagi.
Dialog: 0,0:39:19.34,0:39:20.85,Default,XO,0,0,0,,Benar.
Dialog: 0,0:39:26.62,0:39:28.95,Default,,0,0,0,,-Anda.\N-Apa yang Anda inginkan?
Dialog: 0,0:39:28.95,0:39:31.36,Default,,0,0,0,,Dilihat dari pakaianmu, kamu tidak bekerja di sini.
Dialogue: 0,0:39:31.36,0:39:32.42,Default,,0,0,0,,Posisi anda?
Dialog: 0,0:39:32.42,0:39:34.83,Default,,0,0,0,,Saya sedang memeriksa persembahan kerajaan.
Dialog: 0,0:39:34.83,0:39:37.13,Default,,0,0,0,,Kepala Inspektur Dapur Kerajaan.
Dialog: 0,0:39:37.33,0:39:40.03,Default,,0,0,0,,-Kemudian periksa rasa makanannya.\N-Aku?
Dialog: 0,0:39:40.47,0:39:41.93,Default,,0,0,0,,Semua yang hadir di sini
Dialog: 0,0:39:41.93,0:39:44.20,Default,,0,0,0,,tidak akan bisa menilai makanan dengan jujur.
Dialog: 0,0:39:44.20,0:39:45.80,Default,,0,0,0,,Berani, cobalah.
Dialog: 0,0:39:46.87,0:39:48.37,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:39:51.64,0:39:53.14,Default,,0,0,0,,Seperti yang Anda katakan.
Dialog: 0,0:40:06.19,0:40:10.06,Default,,0,0,0,,Saya belum mencoba hal seperti ini sampai sekarang.
Dialog: 0,0:40:10.33,0:40:11.66,Default,,0,0,0,,Seperti kebahagiaan,
Dialogue: 0,0:40:11.66,0:40:14.43,Default,,0,0,0,,hidangan ini membuat mulutku senang.
Dialogue: 0,0:40:14.67,0:40:19.47,Default,,0,0,0,,Sepanjang hidupku, lidahku belum pernah merasakan sesuatu yang lebih indah...
Dialog: 0,0:40:19.50,0:40:20.97,Default,,0,0,0,,Yah...
Dialog: 0,0:40:28.21,0:40:29.81,Default,,0,0,0,,Siapa kamu?
Dialog: 0,0:40:38.59,0:40:41.99,Default,,0,0,0,,Beraninya seorang gadis memasuki dapur kerajaan?
Dialog: 0,0:40:41.99,0:40:44.26,Default,,0,0,0,,Kekejian.
Dialogue: 0,0:40:47.60,0:40:49.73,Default,,0,0,0,,Apakah ini ditujukan untukku?
Dialog: 0,0:40:49.97,0:40:53.24,Default,,0,0,0,,Beraninya seorang gadis memasuki dapur kerajaan?
Dialog: 0,0:40:57.21,0:41:01.08,Default,,0,0,0,,Tidak. Tentu saja tidak.
Dialog: 0,0:41:07.19,0:41:10.02,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:41:12.49,0:41:13.89,Default,,0,0,0,,Cukup.
Dialog: 0,0:41:14.59,0:41:16.46,Default,,0,0,0,,Saya yang pertama,
Dialog: 0,0:41:16.46,0:41:18.50,Default,,0,0,0,,dan makananku rasanya enak.
Dialog: 0,0:41:20.70,0:41:23.13,Default,,0,0,0,,Saat aku di dapur,
Dialog: 0,0:41:23.33,0:41:25.30,Default,,0,0,0,,kata-kataku adalah hukum.
Dialog: 0,0:41:26.84,0:41:28.44,Default,,0,0,0,,Maukah kamu bekerja denganku.
Dialog: 0,0:41:28.91,0:41:30.44,Default,,0,0,0,,-Ya, Yang Mulia.\N-Ya, Yang Mulia.
Dialog: 0,0:41:30.44,0:41:31.91,Default,,0,0,0,,Tidak cukup untuknya...
Dialog: 0,0:41:35.41,0:41:40.62,Default,,0,0,0,,Jika kamu mau, aku bisa menerimamu sebagai murid.
Dialog: 0,0:41:43.62,0:41:47.46,Default,,0,0,0,,Yang Mulia, Yang Mulia sekarang berada di Aula Daejojong.
Dialogue: 0,0:41:54.57,0:41:56.93,Default,,0,0,0,,Untuk apa aku berhutang kunjungan sepagi ini?
Dialog: 0,0:41:57.04,0:41:59.20,Default,,0,0,0,,Aku merindukanmu, ratuku.
Dialogue: 0,0:41:59.90,0:42:02.34,Default,,0,0,0,,Dan kamu sungguh manis hari ini.
Dialog: 0,0:42:02.87,0:42:05.48,Default,,0,0,0,,Tapi bukankah sudah waktunya bagimu untuk kembali ke dirimu sendiri?
Dialog: 0,0:42:05.48,0:42:08.05,Default,,0,0,0,,-Pasukan Khusus.\N-Apa?
Dialog: 0,0:42:09.48,0:42:12.18,Default,,0,0,0,,Adakah yang ingin kamu sampaikan padaku tentang kata ini?
Dialog: 0,0:42:12.22,0:42:14.59,Default,,0,0,0,,-Apakah ini semacam permainan?\N-Yah...
Dialog: 0,0:42:15.59,0:42:18.16,Default,,0,0,0,,Sudah waktunya kamu berangkat.
Dialog: 0,0:42:19.59,0:42:21.13,Default,,0,0,0,,Koki tentara.
Dialog: 0,0:42:21.49,0:42:22.96,Default,,0,0,0,,Apa?
Dialog: 0,0:42:24.23,0:42:26.36,Default,,0,0,0,,Tuhan. Sebenarnya, kamu adalah rajanya.
Dialogue: 0,0:42:26.36,0:42:28.57,Default,,0,0,0,,Sekarang aku akan mengatakan sesuatu, dan kamu akan mengeksekusiku karenanya?
Dialog: 0,0:42:28.57,0:42:30.10,Default,,0,0,0,,Lanjutkan.
Dialog: 0,0:42:31.00,0:42:33.27,Default,,0,0,0,,Omong kosong apa yang kamu bicarakan?
Dialogue: 0,0:42:38.08,0:42:40.41,Default,,0,0,0,,Kamu menggunakan bahasa kotor tanpa alasan.
Dialog: 0,0:42:40.41,0:42:43.21,Default,,0,0,0,,Kamu pasti tidak bahagia dengan hidupmu.
Dialog: 0,0:42:43.21,0:42:45.58,Default,,0,0,0,,Ceritakan semua yang mengganggumu.
Dialog: 0,0:42:45.58,0:42:48.29,Default,,0,0,0,,Jika kamu mau, aku bahkan bisa tinggal.
Dialog: 0,0:42:48.49,0:42:50.32,Default,,0,0,0,,Apa yang kamu katakan, semuanya baik-baik saja denganku.
Dialogue: 0,0:42:50.32,0:42:53.99,Default,,0,0,0,,Ya, aku benar-benar tidak puas dengan betapa indahnya hidupku.
Dialogue: 0,0:42:55.29,0:42:57.76,Default,,0,0,0,,Apakah kamu bertemu seseorang hari ini?
Dialog: 0,0:42:59.00,0:43:00.27,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialogue: 0,0:43:00.27,0:43:02.10,Default,,0,0,0,,Berapa banyak yang dia dengar?
Dialogue: 0,0:43:02.23,0:43:05.10,Default,,0,0,0,,Hanya ingin tahu bagaimana harimu.
Dialog: 0,0:43:05.24,0:43:07.87,Default,,0,0,0,,Aku akan pergi setelah kita bicara sebentar.
Dialogue: 0,0:43:11.78,0:43:15.25,Default,,0,0,0,,Nah, sepupuku datang menemuiku.
Dialogue: 0,0:43:16.48,0:43:17.78,Default,,0,0,0,,Sepupu?
Dialog: 0,0:43:17.78,0:43:20.28,Default,,0,0,0,,Kim Byonin, kalau tidak salah?
Dialog: 0,0:43:20.35,0:43:21.62,Default,,0,0,0,,Apa yang dia perlukan?
Dialogue: 0,0:43:21.62,0:43:25.56,Default,,0,0,0,,Kenapa aku merasa seperti sedang diinterogasi?
Dialog: 0,0:43:25.69,0:43:27.39,Default,,0,0,0,,Kamu terlalu mudah terpengaruh.
Dialog: 0,0:43:27.53,0:43:30.19,Default,,0,0,0,,Aku hanya mengkhawatirkan kerabatku
Dialog: 0,0:43:30.19,0:43:31.83,Default,,0,0,0,,sesuatu telah terjadi.
Dialog: 0,0:43:31.83,0:43:33.13,Default,,0,0,0,,Tidak.
Dialog: 0,0:43:33.13,0:43:35.17,Default,,0,0,0,,Hanya datang untuk menyapa dan memberi selamat.
Dialogue: 0,0:43:35.17,0:43:37.60,Default,,0,0,0,,Jika demikian, maka saya tidak perlu mengkhawatirkannya.
Dialogue: 0,0:43:38.04,0:43:42.14,Default,,0,0,0,,Bolehkah aku bertanya, kenapa kamu memperlakukanku seperti ini akhir-akhir ini?
Dialogue: 0,0:43:43.14,0:43:46.61,Default,,0,0,0,,Dia membenciku karena dia tahu aku seorang pembunuh?
Dialog: 0,0:43:47.15,0:43:49.05,Default,,0,0,0,,Kita sekarang adalah suami-istri.
Dialog: 0,0:43:49.05,0:43:50.78,Default,,0,0,0,,Bahkan jika kamu sangat mencintai,
Dialog: 0,0:43:50.78,0:43:52.85,Default,,0,0,0,,setelah pernikahan, romansa hilang.
Dialogue: 0,0:43:53.32,0:43:56.09,Default,,0,0,0,,Puas? Anda bisa pergi.
Dialog: 0,0:43:56.92,0:44:00.83,Default,,0,0,0,,Dengarkan aku. Bawalah sprei.
Dialog: 0,0:44:00.89,0:44:03.70,Default,,0,0,0,,Apa yang kamu lakukan? Kami tidak setuju seperti itu.
Dialog: 0,0:44:03.70,0:44:06.30,Default,,0,0,0,,Percakapan membuatku lelah,
Dialog: 0,0:44:06.30,0:44:09.03,Default,,0,0,0,,tidak ada kekuatan untuk kembali ke Hijeongjon.
Dialog: 0,0:44:12.97,0:44:16.31,Default,,0,0,0,,Kemenangan di siang hari, pengaturan di malam hari.
Dialogue: 0,0:44:23.11,0:44:25.48,Default,,0,0,0,,Dia agak mencurigakan.
Dialogue: 0,0:44:26.82,0:44:28.89,Default,,0,0,0,,Entah kenapa dia curiga.
Dialog: 0,0:44:33.59,0:44:34.99,Default,,0,0,0,,Yang Mulia,
Dialog: 0,0:44:35.16,0:44:37.80,Default,,0,0,0,,kamu tidak boleh mempercayai siapa pun.
Dialog: 0,0:44:37.83,0:44:41.23,Default,,0,0,0,,Ya, dia pasti tidak beriman.
Dialog: 0,0:44:41.23,0:44:43.00,Default,,0,0,0,,Tidak peduli di mana atau kapan,
Dialog: 0,0:44:43.00,0:44:46.37,Default,,0,0,0,,dan suamilah yang pertama kali dicurigai membunuh istrinya.
Dialogue: 0,0:44:52.68,0:44:55.71,Default,,0,0,0,,Mungkin dia akan memberitahumu sesuatu dalam tidurnya.
Dialogue: 0,0:44:55.88,0:44:58.18,Default,,0,0,0,,Bagaimana jika dia merencanakan sesuatu dan menungguku tertidur?
Dialog: 0,0:44:58.45,0:45:00.08,Default,,0,0,0,,-Saya tidak bisa tidur.\N-Saya tidak bisa tidur.
Dialog: 0,0:46:01.15,0:46:02.55,Default,,0,0,0,,Tidak.
Dialog: 0,0:46:03.08,0:46:06.08,Default,,0,0,0,,Tidak! Tidak, jangan!
Dialog: 0,0:46:09.32,0:46:12.19,Default,,0,0,0,,Tidak, jangan!
Dialog: 0,0:46:12.26,0:46:13.46,Default,,0,0,0,,Tidak.
Dialog: 0,0:46:13.46,0:46:16.29,Default,,0,0,0,,Hei. Ada apa denganmu?
Dialog: 0,0:46:16.29,0:46:18.23,Default,,0,0,0,,Tuhan. Dia mungkin mati seperti itu.
Dialog: 0,0:46:18.23,0:46:22.10,Default,,0,0,0,,Hei. Bangun! Bangun, ayolah!
Dialog: 0,0:46:31.74,0:46:33.34,Default,,0,0,0,,Hwajin.
Dialog: 0,0:46:33.88,0:46:36.38,Default,,0,0,0,,Kamu menyelamatkan hidupku lagi.
Dialog: 0,0:46:36.38,0:46:38.02,Default,,0,0,0,,Terima kasih.
Dialog: 0,0:46:38.02,0:46:41.09,Default,,0,0,0,,Apakah kamu gila?
Dialog: 0,0:46:41.09,0:46:42.49,Default,,0,0,0,,Tuhan.
Dialog: 0,0:46:43.69,0:46:45.16,Default,,0,0,0,,Hwajin.
Dialogue: 0,0:46:48.49,0:46:51.16,Default,,0,0,0,,-Ratuku.\N-Sial.
Dialog: 0,0:46:51.36,0:46:54.63,Default,,0,0,0,,Apakah kamu benar-benar mengira aku akan mati jika kamu memukulku seperti itu?
Dialogue: 0,0:46:54.93,0:46:56.93,Default,,0,0,0,,Kamu pasti sudah mati kalau aku tidak membangunkanmu.
Dialog: 0,0:46:56.93,0:46:59.64,Default,,0,0,0,,Bergoyang seperti cacing.
Dialog: 0,0:47:00.30,0:47:04.04,Default,,0,0,0,,Kamu memukulku karena aku menyebut nama wanita lain.
Dialog: 0,0:47:04.04,0:47:06.31,Default,,0,0,0,,Tidak perlu khawatir.
Dialog: 0,0:47:07.61,0:47:09.85,Default,,0,0,0,,Saya tidak peduli siapa yang Anda telepon.
Dialogue: 0,0:47:09.85,0:47:12.82,Default,,0,0,0,,Mari jaga jarak.
Dialogue: 0,0:47:15.05,0:47:16.79,Default,,0,0,0,,Kamu mengatakannya lagi.
Dialog: 0,0:47:16.95,0:47:18.22,Default,,0,0,0,,Karena kamu sudah bangun,
Dialog: 0,0:47:18.22,0:47:20.46,Default,,0,0,0,,sebaiknya kamu kembali ke tempatmu
Dialogue: 0,0:47:20.46,0:47:22.63,Default,,0,0,0,,dan tidurlah.
Dialog: 0,0:47:24.20,0:47:28.87,Default,,0,0,0,,Jika aku pergi sekarang, aku harus membangunkan pelayanku. \NIni tidak bagus.
Dialogue: 0,0:47:31.77,0:47:34.11,Default,,0,0,0,,Betapa murah hati kami.
Dialog: 0,0:47:34.24,0:47:37.41,Default,,0,0,0,,Oh, ratuku, terima kasih atas pujiannya.
Dialog: 0,0:47:42.55,0:47:44.55,Default,,0,0,0,,Tuhan, ratuku.
Dialogue: 0,0:47:44.55,0:47:47.15,Default,,0,0,0,,Kamu egois sekali.
Dialog: 0,0:47:53.09,0:47:55.56,Default,,0,0,0,,Ya, kamu benar-benar wanita yang kuat.
Dialog: 0,0:47:55.56,0:47:57.43,Default,,0,0,0,,Berbaring saja dan pergi tidur.
Dialogue: 0,0:47:58.70,0:48:02.20,Default,,0,0,0,,Raja yang pengasih harus bisa berbagi.
Dialogue: 0,0:48:22.59,0:48:27.49,Default,,0,0,0,,Setiap kali aku tidur di Daejeon, seluruh tubuhku sakit.
Dialogue: 0,0:48:28.73,0:48:31.33,Default,,0,0,0,,Jadi sebaiknya kita tidak tidur bersama lagi.
Dialogue: 0,0:48:31.33,0:48:33.63,Default,,0,0,0,,Pasti karena aku belum terbiasa dengan tempat ini.
Dialog: 0,0:48:33.63,0:48:37.30,Default,,0,0,0,,Saya harus lebih sering menginap sampai saya terbiasa.
Dialog: 0,0:48:38.57,0:48:41.74,Default,,0,0,0,,Aku tidak ingin bangun lagi karena mimpi burukmu.
Dialog: 0,0:48:42.31,0:48:44.11,Default,,0,0,0,,Saya tidak ingat mimpi buruk apa pun,
Dialog: 0,0:48:44.11,0:48:46.31,Default,,0,0,0,,dan inilah cara mereka memukulku karena menyebut nama orang lain,
Dialog: 0,0:48:46.31,0:48:48.28,Default,,0,0,0,,Saya tidak bisa lupa.
Dialogue: 0,0:48:49.31,0:48:53.08,Default,,0,0,0,,Lain kali aku akan menyebut namamu.
Dialog: 0,0:48:53.08,0:48:55.49,Default,,0,0,0,,Saya akan mulai malam ini.
Dialog: 0,0:48:58.39,0:49:00.89,Default,,0,0,0,,Ya Tuhan, aku bahkan kehilangan nafsu makanku.
Dialog: 0,0:49:01.03,0:49:04.09,Default,,0,0,0,,Jika kamu sudah makan, silakan berangkat. Ada yang harus kulakukan.
Dialog: 0,0:49:04.40,0:49:06.80,Default,,0,0,0,,Sibuk apa kamu?
Dialog: 0,0:49:08.30,0:49:09.73,Default,,0,0,0,,Kerja.
Dialog: 0,0:49:09.80,0:49:12.40,Default,,0,0,0,,Karena aku tidak bisa menggunakan ponsel dan jaringan sosialku,
Dialog: 0,0:49:12.40,0:49:14.81,Default,,0,0,0,,maka saya tidak punya pilihan selain bekerja.
Dialog: 0,0:49:16.11,0:49:17.98,Default,,0,0,0,,Jaringan sosial?
Dialog: 0,0:49:17.98,0:49:19.84,Default,,0,0,0,,Jejaring sosial.
Dialog: 0,0:49:21.31,0:49:25.45,Default,,0,0,0,,Saya mengerti. Cinta harus lembut.
Dialogue: 0,0:49:26.88,0:49:29.72,Default,,0,0,0,,Malam ini aku akan menjadi kelembutan itu sendiri.
Dialog: 0,0:49:42.97,0:49:45.50,Default,,0,0,0,,Pukulan langsung!
Dialog: 0,0:49:46.64,0:49:49.21,Default,,0,0,0,,Hebat!
Dialog: 0,0:49:49.21,0:49:51.54,Default,,0,0,0,,Dari mana kamu mempelajarinya?
Dialogue: 0,0:49:51.61,0:49:53.34,Default,,0,0,0,,Kamu membuatku bingung.
Dialogue: 0,0:49:53.95,0:49:57.68,Default,,0,0,0,,Haruskah aku menunjukkan kemampuanku?
Dialog: 0,0:49:57.68,0:49:59.18,Default,,0,0,0,,Jadi.
Dialog: 0,0:50:10.06,0:50:11.53,Default,,0,0,0,,Baiklah...
Dialog: 0,0:50:12.23,0:50:13.90,Default,,0,0,0,,Semuanya mulai berputar dan berputar,
Dialog: 0,0:50:13.90,0:50:16.23,Default,,0,0,0,,secara umum, saya menghabiskan beberapa malam bersama raja.
Dialog: 0,0:50:16.40,0:50:18.74,Default,,0,0,0,,Tapi kami tidak tidur dengannya.
Dialogue: 0,0:50:21.24,0:50:23.01,Default,,0,0,0,,Kami hanya berpura-pura.
Dialog: 0,0:50:23.21,0:50:25.71,Default,,0,0,0,,Kau tahu, dia biasanya pergi ke kamarnya.
Dialog: 0,0:50:26.78,0:50:28.61,Default,,0,0,0,,Tapi kemarin sepertinya sudah diganti:
Dialog: 0,0:50:28.61,0:50:30.58,Default,,0,0,0,,dia menolak pergi ke tempatnya.
Dialog: 0,0:50:30.65,0:50:32.48,Default,,0,0,0,,Tapi jangan khawatir.
Dialog: 0,0:50:32.48,0:50:34.99,Default,,0,0,0,,Tidak ada apa pun di malam hari, dan tidak akan ada apa pun di masa depan.
Dialogue: 0,0:50:34.99,0:50:39.72,Default,,0,0,0,,Kamu minta bertemu untuk memberitahuku ini?
Dialog: 0,0:50:39.79,0:50:41.29,Default,,0,0,0,,Tidak, tidak juga.
Dialogue: 0,0:50:41.29,0:50:44.00,Default,,0,0,0,,Benarkah dia mendorongku ke danau?
Dialogue: 0,0:50:44.00,0:50:45.60,Default,,0,0,0,,Lalu juga?
Dialog: 0,0:50:46.16,0:50:49.70,Default,,0,0,0,,Maka ada baiknya memperlambatnya selama beberapa hari.
Dialogue: 0,0:50:50.47,0:50:53.87,Default,,0,0,0,,Sulit sekali kalau gadis cantik membencimu.
Dialog: 0,0:50:54.31,0:50:56.41,Default,,0,0,0,,Kalau saja kamu tidak membenciku.
Dialog: 0,0:50:58.48,0:51:01.95,Default,,0,0,0,,Sepertinya angin tidak berpihak padamu kali ini.
Dialogue: 0,0:51:02.41,0:51:05.48,Default,,0,0,0,,Jika kamu mempercayaiku dan menunggu beberapa hari...
Dialog: 0,0:51:06.42,0:51:10.39,Default,,0,0,0,,Tahukah kamu siapa yang tidak boleh kupercayai di istana?
Dialog: 0,0:51:11.79,0:51:14.59,Default,,0,0,0,,Untuk Anda, Yang Mulia. Oleh karena itu
Dialog: 0,0:51:14.76,0:51:17.90,Default,,0,0,0,,Saya tidak percaya apa pun yang Anda katakan.
Dialog: 0,0:51:19.03,0:51:23.23,Default,,0,0,0,,Dan jangan coba-coba menghalangi Yang Mulia dan aku dulu,
Dialog: 0,0:51:23.23,0:51:24.87,Default,,0,0,0,,lebih baik menyerah.
Dialog: 0,0:51:24.87,0:51:27.64,Default,,0,0,0,,Saya mulai hidup dari awal.
Dialogue: 0,0:51:27.71,0:51:29.71,Default,,0,0,0,,Tidak bisakah kamu melihat perubahanku?
Dialog: 0,0:51:30.21,0:51:32.01,Default,,0,0,0,,Kamu telah berubah menjadi lebih buruk.
Dialog: 0,0:51:32.01,0:51:34.35,Default,,0,0,0,,Kamu tersenyum di wajahku,
Dialog: 0,0:51:34.55,0:51:37.35,Default,,0,0,0,,tapi di belakangku salahkan aku atas apa yang terjadi di danau.
Dialogue: 0,0:51:37.68,0:51:40.55,Default,,0,0,0,,Aku tidak pernah menyalahkanmu untuk ini.
Dialog: 0,0:51:40.55,0:51:41.82,Default,,0,0,0,,Kami tidak tahu siapa orang itu,
Dialog: 0,0:51:41.82,0:51:44.12,Default,,0,0,0,,kamu dicurigai karena kamu ada di sana.
Dialog: 0,0:51:44.12,0:51:47.66,Default,,0,0,0,,Kamu tahu siapa orang itu.
Dialog: 0,0:51:52.93,0:51:54.53,Default,,0,0,0,,Orang yang melakukan ini adalah
Dialog: 0,0:51:55.57,0:51:57.80,Default,,0,0,0,,ini Anda, Yang Mulia.
Dialog: 0,0:52:04.11,0:52:06.64,Default,,0,0,0,,Kamu sengaja jatuh ke air,
Dialogue: 0,0:52:06.98,0:52:09.35,Default,,0,0,0,,untuk menjebakku.
Dialog: 0,0:52:17.79,0:52:20.82,Default,,0,0,0,,Dilihat dari betapa marahnya dia, dia tidak berbohong.
Dialog: 0,0:52:21.63,0:52:24.43,Default,,0,0,0,,Sekarang aku tahu kenapa dia menatapku begitu dingin.
Dialog: 0,0:52:25.16,0:52:29.17,Default,,0,0,0,,Insiden di danau itu dibuat-buat. Yang tersisa hanyalah pembunuhnya.
Dialogue: 0,0:52:30.10,0:52:34.10,Default,,0,0,0,,Fakta bahwa seseorang mengikutiku tidak berubah.
Dialog: 0,0:52:35.37,0:52:39.21,Default,,0,0,0,,Yang Mulia, Anda harus kembali ke Aula Daejojeon.
Dialog: 0,0:52:39.74,0:52:42.08,Default,,0,0,0,,Nyonya Choi, \Npergi dulu ke Daejojong.
Dialog: 0,0:52:45.02,0:52:47.22,Default,,0,0,0,,Jika terjadi sesuatu, pikirkan sesuatu
Dialog: 0,0:52:47.22,0:52:48.92,Default,,0,0,0,,dan kirim Hongyeon mengejarku.
Dialog: 0,0:52:48.92,0:52:49.99,Default,,0,0,0,,Saya tidak berani...
Dialog: 0,0:52:49.99,0:52:51.89,Default,,0,0,0,,Inilah satu-satunya cara kamu bisa membantuku.
Dialog: 0,0:52:52.29,0:52:53.72,Default,,0,0,0,,Tolong.
Dialog: 0,0:52:56.09,0:52:58.06,Default,,0,0,0,,Hei, ini.
Dialog: 0,0:53:00.10,0:53:01.27,Default,,0,0,0,,Koki Kerajaan.
Dialogue: 0,0:53:01.27,0:53:03.77,Default,,0,0,0,,Seberapa sering kamu melayani Janda Ratu?
Dialog: 0,0:53:03.77,0:53:05.84,Default,,0,0,0,,Saya tidak bisa memastikannya,
Dialog: 0,0:53:05.84,0:53:07.84,Default,,0,0,0,,tapi pasti beberapa kali sehari.
Dialog: 0,0:53:15.58,0:53:18.15,Default,,0,0,0,,Saya tidak bermaksud mengatakan itu,
Dialogue: 0,0:53:18.15,0:53:21.49,Default,,0,0,0,,tapi di Joseon banyak yang bisa \Nmenjadi koki kerajaan.
Dialog: 0,0:53:26.62,0:53:28.13,Default,,0,0,0,,Saya sudah sarapan, makan siang, camilan sore,
Dialog: 0,0:53:28.13,0:53:29.33,Default,,0,0,0,,makanan ringan, makan malam
Dialog: 0,0:53:29.33,0:53:32.20,Default,,0,0,0,,dan camilan malam.
Dialog: 0,0:53:32.26,0:53:33.46,Default,,0,0,0,,Dan dia memakan semuanya?
Dialog: 0,0:53:33.46,0:53:35.47,Default,,0,0,0,,Setiap 3-4 hari sekali
Dialogue: 0,0:53:35.60,0:53:38.04,Default,,0,0,0,,dia menolak makan siang.
Dialogue: 0,0:53:38.04,0:53:42.51,Default,,0,0,0,,Pada hari seperti itu dia meminta madu dan bubuk jahe.
Dialog: 0,0:53:49.15,0:53:50.71,Default,,0,0,0,,Dia tidak makan
Dialog: 0,0:53:50.71,0:53:53.62,Default,,0,0,0,,dingin dan sesuatu untuk dikunyah.
Dialog: 0,0:53:53.62,0:53:55.59,Default,,0,0,0,,Dia tidak meminta untuk mengubah menu,
Dialog: 0,0:53:55.59,0:53:57.52,Default,,0,0,0,,yang berarti dia ingin menyembunyikannya.
Dialog: 0,0:53:59.46,0:54:03.09,Default,,0,0,0,,Saya lebih melihat wajah mereka daripada keterampilan mereka.
Dialogue: 0,0:54:03.66,0:54:05.96,Default,,0,0,0,,Bukankah semuanya tampan?
Dialog: 0,0:54:06.76,0:54:08.20,Default,,0,0,0,,-Bam.\N-Bam.
Dialog: 0,0:54:08.33,0:54:09.80,Default,,0,0,0,,Halo!
Dialog: 0,0:54:09.93,0:54:12.10,Default,,0,0,0,,Apakah menurut Anda suara tembakan begitu pelan?
Dialog: 0,0:54:12.10,0:54:15.27,Default,,0,0,0,,Harus lebih keras. "Bam"!
Dialog: 0,0:54:15.27,0:54:17.37,Default,,0,0,0,,-Bam.\N-Bam.
Dialog: 0,0:54:17.37,0:54:19.91,Default,,0,0,0,,Menteri Perang kami yang terkasih, hiasan kepalamu miring.
Dialog: 0,0:54:19.91,0:54:23.01,Default,,0,0,0,,Apa yang kamu izinkan?
Dialog: 0,0:54:23.58,0:54:27.15,Default,,0,0,0,,Ngomong-ngomong, kudengar kamu meminta raja untuk memindahkanmu
Dialog: 0,0:54:27.15,0:54:28.75,Default,,0,0,0,,ke Kantor Pengawal Kerajaan.
Dialog: 0,0:54:28.75,0:54:31.92,Default,,0,0,0,,Pengelolaan pengawal kerajaan bukanlah pasukan,
Dialog: 0,0:54:31.92,0:54:33.66,Default,,0,0,0,,kamu bisa main-main di sana.
Dialog: 0,0:54:33.66,0:54:35.16,Default,,0,0,0,,Rumor seperti itu beredar,
Dialog: 0,0:54:35.16,0:54:37.36,Default,,0,0,0,,dan saya berpikir: inilah yang saya butuhkan.
Dialogue: 0,0:54:37.36,0:54:40.46,Default,,0,0,0,,Aku tidak suka memaksakan diri.
Dialog: 0,0:54:53.64,0:54:55.91,Default,,0,0,0,,-Kapan?\N-Malam ini.
Dialog: 0,0:54:55.91,0:54:57.35,Default,,0,0,0,,Oke.
Dialog: 0,0:55:05.09,0:55:07.66,Default,,0,0,0,,Ini bubuk agaric terbang.
Dialog: 0,0:55:07.66,0:55:09.59,Default,,0,0,0,,Tidak berbau dan tidak berasa.
Dialog: 0,0:55:09.59,0:55:12.96,Default,,0,0,0,,Campur dengan alkohol dan ungkapkan semua rahasianya.
Dialog: 0,0:55:13.50,0:55:16.70,Default,,0,0,0,,Tetapi jika ratu mengetahui sesuatu,
Dialog: 0,0:55:16.70,0:55:18.57,Default,,0,0,0,,dia tidak mau duduk diam.
Dialogue: 0,0:55:18.60,0:55:20.84,Default,,0,0,0,,Dia sedang merencanakan sesuatu,
Dialog: 0,0:55:20.94,0:55:23.11,Default,,0,0,0,,atau menunggu saat yang tepat.
Dialogue: 0,0:55:23.47,0:55:25.31,Default,,0,0,0,,Perlu dipastikan.
Dialog: 0,0:55:34.42,0:55:37.22,Default,,0,0,0,,Pangeran Yeonpyeong tidak mempunyai ambisi yang cukup.
Dialogue: 0,0:55:37.22,0:55:39.92,Default,,0,0,0,,Dia menempel pada Yang Mulia
Dialog: 0,0:55:39.92,0:55:42.86,Default,,0,0,0,,dan bergaul dengan Hong Byulgam
Dialog: 0,0:55:44.13,0:55:46.00,Default,,0,0,0,,di malam hari.
Dialog: 0,0:55:49.30,0:55:51.67,Default,,0,0,0,,Hon Byulgam
Dialog: 0,0:55:52.00,0:55:55.14,Default,,0,0,0,,masih pemalas yang sama,\N melalaikan tanggung jawabnya.
Dialog: 0,0:55:55.81,0:55:58.08,Default,,0,0,0,,Kantor Pengawal Kerajaan hanyalah sebuah nama.
Dialog: 0,0:55:58.08,0:55:59.98,Default,,0,0,0,,Lebih baik biarkan dia duduk di sana.
Dialog: 0,0:56:00.78,0:56:02.55,Default,,0,0,0,,Dia tidak hanya kehilangan ayah dan saudara laki-lakinya,
Dialog: 0,0:56:02.55,0:56:05.45,Default,,0,0,0,,tetapi juga ibu dan kakek neneknya tepat di depan matanya.
Dialog: 0,0:56:05.78,0:56:07.99,Default,,0,0,0,,Ini menjadi pelajaran baginya.
Dialog: 0,0:56:08.15,0:56:13.16,Default,,0,0,0,,Ngomong-ngomong, kapan kamu akan diangkat menjadi kepala pengawal kerajaan?
Dialog: 0,0:56:13.89,0:56:15.29,Default,,0,0,0,,Apakah ada masalah?
Dialog: 0,0:56:15.29,0:56:18.93,Default,,0,0,0,,Saya hanya ingin menyelesaikan semuanya sebelum ditugaskan.
Dialog: 0,0:56:22.57,0:56:25.70,Default,,0,0,0,,Apakah Anda mendapat keuntungan dari pertukaran informasi militer lagi?
Dialog: 0,0:56:27.00,0:56:28.91,Default,,0,0,0,,Jangan melewati batas.
Dialogue: 0,0:56:29.11,0:56:31.14,Default,,0,0,0,,Sudah kubilang berapa kali,
Dialog: 0,0:56:31.14,0:56:33.14,Default,,0,0,0,,bahwa pasukan yang tidak stabil itu sangat berbahaya?
Dialog: 0,0:56:33.74,0:56:35.21,Default,,0,0,0,,Saya tahu.
Dialog: 0,0:56:35.88,0:56:37.68,Default,,0,0,0,,Aku akan mengurus semuanya.
Dialog: 0,0:56:40.15,0:56:41.79,Default,,0,0,0,,Tidak peduli seberapa banyak aku berpikir,
Dialog: 0,0:56:42.35,0:56:45.56,Default,,0,0,0,,tapi aku merasakan sesuatu yang berbahaya sedang terjadi di luar istana.
Dialog: 0,0:56:45.56,0:56:46.92,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:56:46.92,0:56:50.33,Default,,0,0,0,,Dalam perjalanan ke Oktajeong beberapa hari yang lalu...
Dialogue: 0,0:56:50.46,0:56:52.73,Default,,0,0,0,,Apakah kamu bilang Okthajeong?
Dialog: 0,0:56:52.73,0:56:56.00,Default,,0,0,0,,Ya. Saya berteman dengan satu pria
Dialog: 0,0:56:56.00,0:56:59.80,Default,,0,0,0,,dengan nama indah Lee Sanman.
Dialog: 0,0:57:00.30,0:57:01.97,Default,,0,0,0,,Lee Senman.
Dialog: 0,0:57:02.17,0:57:03.97,Default,,0,0,0,,Apakah kamu kenal dia?
Dialog: 0,0:57:04.51,0:57:07.81,Default,,0,0,0,,Tidak. Tapi sepertinya nama itu familiar.
Dialog: 0,0:57:07.81,0:57:10.21,Default,,0,0,0,,Dia mungkin berasal dari keluarga bangsawan terkenal.
Dialog: 0,0:57:10.21,0:57:12.05,Default,,0,0,0,,Tapi saya belum pernah mendengar namanya.
Dialog: 0,0:57:12.92,0:57:16.55,Default,,0,0,0,,Jadi, saat kita pergi ke Okthajeong bersamanya,
Dialog: 0,0:57:16.55,0:57:19.52,Default,,0,0,0,,tak disangka ada yang memukulku,
Dialogue: 0,0:57:19.52,0:57:21.43,Default,,0,0,0,,dan aku kehilangan kesadaran.
Dialog: 0,0:57:22.33,0:57:23.93,Default,,0,0,0,,Saat aku bangun,
Dialog: 0,0:57:23.93,0:57:29.43,Default,,0,0,0,,menyadari bahwa Lee Senman telah menghilang seperti hantu.
Dialog: 0,0:57:29.47,0:57:31.94,Default,,0,0,0,,Ingat bagaimana dia berpakaian?
Dialog: 0,0:57:31.94,0:57:34.17,Default,,0,0,0,,-Tentu saja.\N-Di atasnya
Dialogue: 0,0:57:36.04,0:57:38.88,Default,,0,0,0,,apakah ada pakaian yang terbuat dari kain seperti itu?
Dialog: 0,0:57:45.02,0:57:46.45,Default,,0,0,0,,Tidak.
Dialog: 0,0:57:50.09,0:57:51.52,Default,,0,0,0,,Mengerti.
Dialog: 0,0:57:51.59,0:57:54.46,Default,,0,0,0,,Jika kamu bertemu temanmu lagi,
Dialog: 0,0:57:54.46,0:57:56.96,Default,,0,0,0,,cari tahu apa yang terjadi kemudian.
Dialog: 0,0:57:57.23,0:57:58.90,Default,,0,0,0,,Apakah ini berarti,
Dialog: 0,0:57:59.90,0:58:03.23,Default,,0,0,0,,apa yang kamu beri aku tugas khusus?
Dialog: 0,0:58:03.23,0:58:05.50,Default,,0,0,0,,Saya tidak akan menyebut ini tugas khusus.
Dialog: 0,0:58:07.94,0:58:09.41,Default,,0,0,0,,Omong-omong.
Dialog: 0,0:58:09.74,0:58:13.18,Default,,0,0,0,,Kamu datang ke istana setiap hari, tapi tidak melakukan apa pun.
Dialog: 0,0:58:13.18,0:58:15.28,Default,,0,0,0,,Apa maksudmu aku tidak melakukan apa-apa?
Dialog: 0,0:58:15.28,0:58:17.21,Default,,0,0,0,,Dan seharian saja tidaklah cukup,
Dialog: 0,0:58:17.21,0:58:19.12,Default,,0,0,0,,hanya untuk menyapa semua orang.
Dialog: 0,0:58:22.55,0:58:25.16,Default,,0,0,0,,Tugas ini ideal untuk Anda.
Dialog: 0,0:58:25.52,0:58:27.42,Default,,0,0,0,,Tugas khusus ini.
Dialog: 0,0:58:27.86,0:58:29.63,Default,,0,0,0,,Akhirnya.
Dialog: 0,0:58:47.51,0:58:51.31,Default,,0,0,0,,(Jarak sosial)
Dialog: 0,0:58:54.89,0:58:57.32,Default,,0,0,0,,(Jarak sosial)
Dialog: 0,0:59:00.66,0:59:02.09,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:59:02.09,0:59:04.29,Default,,0,0,0,,Pangeran Yeonpyeong telah tiba.
Dialog: 0,0:59:04.29,0:59:05.70,Default,,0,0,0,,Ya.
Dialog: 0,0:59:10.23,0:59:13.64,Default,,0,0,0,,Tahukah kamu apa artinya ini?
Dialog: 0,0:59:13.94,0:59:15.37,Default,,0,0,0,,Permisi?
Dialog: 0,0:59:15.94,0:59:17.81,Default,,0,0,0,,Datang dan lihatlah.
Dialogue: 0,0:59:22.21,0:59:23.55,Default,,0,0,0,,Jarak sosial?
Dialogue: 0,0:59:23.55,0:59:27.28,Default,,0,0,0,,Menurut ratu, ini berarti “Kita akan hidup bahagia.”
Dialog: 0,0:59:27.28,0:59:29.95,Default,,0,0,0,,Tapi dari mana kata-kata itu berasal?
Dialog: 0,0:59:32.69,0:59:34.89,Default,,0,0,0,,Tidak pernah terdengar.
Dialogue: 0,0:59:36.93,0:59:39.83,Default,,0,0,0,,Atau mungkin dari kitab Buddha?
Dialogue: 0,0:59:49.34,0:59:52.28,Default,,0,0,0,,Aku ingin minum teh bersama kakakku.
Dialog: 0,0:59:52.61,0:59:54.95,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,1:00:04.42,1:00:06.66,Default,,0,0,0,,Aku terus memikirkan apa yang ratu katakan,
Dialog: 0,1:00:06.66,1:00:10.26,Default,,0,0,0,,karena beberapa kata-katanya yang indah\N mungkin memiliki arti.
Dialog: 0,1:00:10.36,1:00:11.86,Default,,0,0,0,,Ya.
Dialog: 0,1:00:14.70,1:00:16.40,Default,,0,0,0,,Ini yang Anda minta.
Dialog: 0,1:00:17.94,1:00:19.64,Default,,0,0,0,,Kerja bagus.
Dialog: 0,1:00:21.57,1:00:23.17,Default,,0,0,0,,Apakah ini akan terjadi hari ini?
Dialogue: 0,1:00:23.27,1:00:25.31,Default,,0,0,0,,Semakin cepat semakin baik.
Dialog: 0,1:00:27.51,1:00:28.98,Default,,0,0,0,,Benar.
Dialog: 0,1:00:30.08,1:00:32.05,Default,,0,0,0,,Beri aku lebih banyak tanah liat.
Dialog: 0,1:00:32.85,1:00:34.25,Default,,0,0,0,,Ya.
Dialog: 0,1:00:37.32,1:00:39.56,Default,,0,0,0,,Ini pesanan Anda,
Dialog: 0,1:00:39.56,1:00:41.39,Default,,0,0,0,,tetapi jika Anda merusak oven...
Dialogue: 0,1:00:41.39,1:00:44.16,Default,,0,0,0,,Jangan sampai aku merusaknya. Ini adalah peningkatan.
Dialogue: 0,1:00:44.83,1:00:46.90,Default,,0,0,0,,Wanita gila sekali.
Dialog: 0,1:00:54.37,1:00:58.31,Default,,0,0,0,,Hei, kamu orang gila, batu kecil apa ini!
Dialog: 0,1:00:59.01,1:01:00.61,Default,,0,0,0,,Apa? Keras?
Dialog: 0,1:01:00.91,1:01:03.28,Default,,0,0,0,,Biar saya bantu. Yang ini sempurna.
Dialog: 0,1:01:03.28,1:01:04.38,Default,,0,0,0,,Terlalu besar.
Dialog: 0,1:01:04.38,1:01:06.02,Default,,0,0,0,,Mengapa kamu menaruh ini?
Dialog: 0,1:01:06.02,1:01:08.45,Default,,0,0,0,,-Yang Mulia!\N-Minyak, atau apa?
Dialog: 0,1:01:08.45,1:01:11.52,Default,,0,0,0,,Ya. Saat Anda memesan, saya membawa semua jenisnya - lobak, wijen, bahaya
Dialog: 0,1:01:11.52,1:01:13.49,Default,,0,0,0,,dan secara umum semua yang saya temukan.
Dialog: 0,1:01:13.49,1:01:15.46,Default,,0,0,0,,Bagus sekali.
Dialog: 0,1:01:20.43,1:01:22.23,Default,,0,0,0,,Permata yang luar biasa!
Dialog: 0,1:01:22.23,1:01:25.27,Default,,0,0,0,,Yang Mulia. Ini adalah pasokan minyak tahunan kami.
Dialog: 0,1:01:25.57,1:01:27.64,Default,,0,0,0,,Memasak adalah 80% bahan.
Dialog: 0,1:01:27.64,1:01:29.54,Default,,0,0,0,,Nasibku bergantung pada makanan ini.
Dialog: 0,1:01:30.64,1:01:31.71,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:01:31.71,1:01:34.81,Default,,0,0,0,,Yang Mulia sudah lama beristirahat.
Dialog: 0,1:01:34.81,1:01:36.78,Default,,0,0,0,,Katakan padaku, aku punya hutang anak di sini.
Dialog: 0,1:01:36.78,1:01:39.52,Default,,0,0,0,,Tidak, tidak. Aku mencurahkan semuanya, semuanya.
Dialogue: 0,1:01:58.20,1:02:01.17,Default,,0,0,0,,Bagaimana kamu bisa memberikan semua hadiah berharga kami padanya?
Dialog: 0,1:02:01.17,1:02:04.11,Default,,0,0,0,,Ya, saya pasti sudah tergeletak di tanah jika saya tidak membawanya.
Dialog: 0,1:02:04.44,1:02:06.71,Default,,0,0,0,,Kami mengancam, mereka akan menyeret kami lebih jauh lagi.
Dialog: 0,1:02:06.71,1:02:08.48,Default,,0,0,0,,Kenapa kamu gemetar?
Dialog: 0,1:02:13.95,1:02:16.82,Default,,0,0,0,,Bahkan tidak berbobot. Apa yang akan dia lakukan?
Dialog: 0,1:02:21.26,1:02:24.86,Default,,0,0,0,,Bahan-bahan yang sangat berharga.
Dialog: 0,1:02:30.47,1:02:33.67,Default,,0,0,0,,Oke, selesai. Besar.
Dialog: 0,1:02:36.84,1:02:39.21,Default,,0,0,0,,Bagus sekali.
Dialog: 0,1:02:39.21,1:02:41.01,Default,,0,0,0,,-Ambil ini. \N-Ya.
Dialog: 0,1:02:41.01,1:02:43.18,Default,,0,0,0,,-Taruh di sana.\N-Apa?
Dialog: 0,1:02:43.18,1:02:45.55,Default,,0,0,0,,-Saya katakan, tempelkan di sana.\N -Ya, Yang Mulia.
Dialog: 0,1:02:55.49,1:02:57.13,Default,,0,0,0,,Selesai.
Dialogue: 0,1:02:57.96,1:03:01.33,Default,,0,0,0,,Croaker kualitas tertinggi - \Nand melemparkannya ke dalam api.
Dialog: 0,1:03:01.33,1:03:04.50,Default,,0,0,0,,Keanehan macam apa.
Dialog: 0,1:03:22.35,1:03:25.29,Default,,0,0,0,,Yang Mulia, saya minta maaf jika saya melampaui batas,
Dialog: 0,1:03:25.29,1:03:27.96,Default,,0,0,0,,tapi Yang Mulia ada di dapur kerajaan
Dialog: 0,1:03:27.96,1:03:31.36,Default,,0,0,0,,memantau penyiapan makanan untuk ratu janda.
Dialog: 0,1:03:31.83,1:03:35.10,Default,,0,0,0,,Saya mengerti. saya akan menunggu.
Dialog: 0,1:03:35.40,1:03:37.57,Default,,0,0,0,,Maaf.
Dialogue: 0,1:03:49.65,1:03:52.25,Default,,0,0,0,,Dia menghindariku.
Dialog: 0,1:04:30.02,1:04:31.22,Default,,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,1:04:31.22,1:04:33.49,Default,,0,0,0,,Sial, aku pingsan karena suatu alasan.
Dialog: 0,1:04:39.70,1:04:42.20,Default,,0,0,0,,Nasibku bergantung padamu.
Dialogue: 0,1:04:57.78,1:04:59.85,Default,,0,0,0,,Ini akan terbakar.
Dialog: 0,1:05:13.23,1:05:14.70,Default,,0,0,0,,Katakan padanya.
Dialog: 0,1:05:17.50,1:05:21.47,Default,,0,0,0,,Sudah kubilang aku tidak butuh sarapan.
Dialogue: 0,1:05:22.64,1:05:26.61,Default,,0,0,0,,Sang Ratu mempersiapkannya sendiri.
Dialog: 0,1:05:30.48,1:05:33.92,Default,,0,0,0,,-Apakah Ratu sudah bersiap?\N-Ya, Yang Mulia.
Dialog: 0,1:05:34.32,1:05:38.32,Default,,0,0,0,,Saya menghabiskan sepanjang malam untuk ini.
Dialog: 0,1:05:38.32,1:05:40.59,Default,,0,0,0,,Saya menghargai usahanya,
Dialogue: 0,1:05:43.56,1:05:46.43,Default,,0,0,0,,tapi terbuat dari apa?
Dialog: 0,1:05:46.43,1:05:48.50,Default,,0,0,0,,Terlihat berbeda.
Dialog: 0,1:05:48.80,1:05:50.90,Default,,0,0,0,,Dia memasak dari daging sapi, babi
Dialog: 0,1:05:50.90,1:05:55.37,Default,,0,0,0,,dan croaker - semuanya bersamaan.
Dialog: 0,1:05:55.74,1:05:59.51,Default,,0,0,0,,Lebih mirip sulaman daripada makanan.
Dialog: 0,1:06:01.21,1:06:03.48,Default,,0,0,0,,Aku benar-benar tidak nafsu makan,
Dialog: 0,1:06:03.48,1:06:06.85,Default,,0,0,0,,tapi kamu bilang dia menghabiskan sepanjang malam.
Dialog: 0,1:06:06.85,1:06:09.12,Default,,0,0,0,,Saya bersyukur, jadi saya akan mencobanya.
Dialog: 0,1:06:36.18,1:06:38.05,Default,,0,0,0,,Masih belum ada kabar?
Dialog: 0,1:06:38.75,1:06:40.25,Default,,0,0,0,,Ya.
Dialog: 0,1:06:45.12,1:06:47.19,Default,,0,0,0,,Ini tidak akan berhasil. Aku akan pergi sendiri.
Dialog: 0,1:06:47.19,1:06:50.36,Default,,0,0,0,,Janda Ratu telah tiba.
Dialog: 0,1:07:05.24,1:07:08.81,Default,,0,0,0,,-Kemenangan?\N-Bagaimana bisa?
Dialog: 0,1:07:11.48,1:07:12.95,Default,,0,0,0,,Fiasco?
Dialog: 0,1:07:15.52,1:07:18.72,Default,,0,0,0,,Mengapa kamu menyembunyikan bakat seperti itu?
Dialog: 0,1:07:18.89,1:07:20.29,Default,,0,0,0,,Apa?
Dialogue: 0,1:07:21.49,1:07:25.16,Default,,0,0,0,,Aku bahkan tidak tahu sudah berapa lama sejak aku menikmati makanan sebanyak ini.
Dialog: 0,1:07:25.16,1:07:27.40,Default,,0,0,0,,Aku sangat bersemangat dengan makanannya,
Dialog: 0,1:07:27.40,1:07:29.63,Default,,0,0,0,,bahwa aku benar-benar marah!
Dialog: 0,1:07:30.67,1:07:32.50,Default,,0,0,0,,Kemenangan.
Dialog: 0,1:07:34.17,1:07:37.31,Default,,0,0,0,,Saya senang Anda menyukainya.
Dialog: 0,1:07:37.44,1:07:39.81,Default,,0,0,0,,Tentu saja saya menyukainya.
Dialog: 0,1:07:39.81,1:07:42.88,Default,,0,0,0,,Sepertinya saya bisa makan ini setiap hari.
Dialog: 0,1:07:43.05,1:07:44.98,Default,,0,0,0,,Bagaimana kamu mempersiapkannya?
Dialog: 0,1:07:44.98,1:07:47.95,Default,,0,0,0,,Saya belum pernah mencoba tekstur sehalus ini sebelumnya,
Dialog: 0,1:07:47.95,1:07:50.52,Default,,0,0,0,,rasanya kaya sekali.
Dialog: 0,1:07:51.82,1:07:57.70,Default,,0,0,0,,Saya memasak dalam minyak dengan api kecil sepanjang malam.
Dialog: 0,1:07:59.43,1:08:01.73,Default,,0,0,0,,Saya menaruh ikan dalam minyak di atas bara api di oven,
Dialog: 0,1:08:01.73,1:08:03.30,Default,,0,0,0,,untuk memasak perlahan sepanjang malam.
Dialog: 0,1:08:03.30,1:08:07.27,Default,,0,0,0,,Saya ingin kulitnya renyah dan dagingnya empuk.
Dialog: 0,1:08:07.37,1:08:10.61,Default,,0,0,0,,Agar dagingnya lebih enak dikunyah,\N Aku masukkan ke dalam kuali berisi minyak
Dialog: 0,1:08:10.61,1:08:13.81,Default,,0,0,0,,dan dimasak dengan api kecil semalaman.
Dialog: 0,1:08:14.88,1:08:18.38,Default,,0,0,0,,Metode ini menjaga nutrisi makanan dan baunya.
Dialogue: 0,1:08:18.45,1:08:21.85,Default,,0,0,0,,Ini juga baik untuk kesehatan dan\Nmembantu melawan penuaan.
Dialog: 0,1:08:21.85,1:08:23.29,Default,,0,0,0,,Makanan yang sangat sehat.
Dialog: 0,1:08:23.29,1:08:27.99,Default,,0,0,0,,Ini disebut confit -\N teknik memasak Perancis.
Dialog: 0,1:08:27.99,1:08:30.96,Default,,0,0,0,,Tidak hanya enak, tapi juga menyehatkan?
Dialog: 0,1:08:32.56,1:08:35.73,Default,,0,0,0,,Dimana kamu mempelajari metode ini?
Dialog: 0,1:08:36.70,1:08:38.67,Default,,0,0,0,,Mungkin ini sebuah wawasan?
Dialog: 0,1:08:38.67,1:08:41.94,Default,,0,0,0,,Lagi pula, saya sedang memikirkan cara menyenangkan Yang Mulia,
Dialog: 0,1:08:41.94,1:08:44.74,Default,,0,0,0,,sudah berhari-hari.
Dialogue: 0,1:08:47.38,1:08:50.38,Default,,0,0,0,,Sungguh pukulan yang fatal.
Dialog: 0,1:08:50.38,1:08:52.55,Default,,0,0,0,,Saya akan membantu Anda setiap hari.
Dialog: 0,1:08:52.95,1:08:54.52,Default,,0,0,0,,Sampai akhir hari
Dialog: 0,1:08:54.75,1:08:56.15,Default,,0,0,0,,kamu akan muda
Dialog: 0,1:08:56.69,1:08:58.59,Default,,0,0,0,,dan sehat.
Dialog: 0,1:09:07.03,1:09:11.30,Default,,0,0,0,,Saya mengizinkan danau diisi air.
Dialog: 0,1:09:31.59,1:09:33.26,Default,nanas,0,0,0,,Anda akan mengisinya seperti ini sampai runtuhnya Joseon.
Dialog: 0,1:09:33.26,1:09:36.09,Default,nanas,0,0,0,,Kita perlu sepuluh hari, tidak kurang.
Dialog: 0,1:09:36.53,1:09:38.73,Default,nanas,0,0,0,,Apa? Sehingga sebentar lagi akan ada air
Dialog: 0,1:09:38.73,1:09:41.00,Default,nanas,0,0,0,,atau aku akan meledakkan kepalamu!
Dialog: 0,1:09:41.03,1:09:44.10,Default,nanas,0,0,0,,Lebih cepat, lebih cepat!
Dialog: 0,1:09:48.24,1:09:52.44,Default,nanas,0,0,0,,Sekarang kita perlu dua hari lagi.
Dialog: 0,1:09:53.18,1:09:54.81,Default,nanas,0,0,0,,Berhenti, jangan bergerak!
Dialog: 0,1:09:57.75,1:10:00.35,Default,nanas,0,0,0,,Saya menemukan sesuatu.
Dialog: 0,1:10:00.45,1:10:03.59,Default,nanas,0,0,0,,Air pemberi kehidupan mengalir!
Dialog: 0,1:10:04.29,1:10:06.19,Default,nanas,0,0,0,,-Tunggu.\N-Terima kasih.
Dialog: 0,1:10:06.19,1:10:08.69,Default,nanas,0,0,0,,Air pemberi kehidupan mengalir!
Dialogue: 0,1:10:09.39,1:10:12.43,Default,pineapple,0,0,0,,Siapa sangka segalanya akan berjalan lebih cepat dengan cara ini?
Dialog: 0,1:10:12.43,1:10:14.80,Default,nanas,0,0,0,,Bagus sekali! Sama seperti itu!
Dialog: 0,1:10:15.33,1:10:17.87,Default,nanas,0,0,0,,-Ambil dengan cepat.\N-Tahan.
Dialog: 0,1:10:27.21,1:10:30.08,Default,nanas,0,0,0,,Ya, saya bukan seorang ratu, tapi seorang jenius dalam pemikiran lokal.
Dialog: 0,1:10:30.08,1:10:31.75,Default,nanas,0,0,0,,Bagus sekali. Teman-teman yang hebat.
Dialog: 0,1:10:31.75,1:10:35.05,Default,nanas,0,0,0,,Sampai kamu memenuhi danau, lupakan tidur.
Dialog: 0,1:10:35.05,1:10:36.52,Default,nanas,0,0,0,,-Patuh!\N-Patuh!
Dialog: 0,1:10:55.17,1:10:56.91,Default,nanas,0,0,0,,Madu, lalu?
Dialog: 0,1:10:57.51,1:11:00.58,Default,nanas,0,0,0,,Jika dia berpura-pura,
Dialog: 0,1:11:00.68,1:11:05.68,Default,nanas,0,0,0,,maka itu pasti tidak akan bisa membodohi saya.
Dialog: 0,1:11:19.73,1:11:22.10,Default,nanas,0,0,0,,Kainnya sangat langka,
Dialog: 0,1:11:22.10,1:11:26.00,Default,nanas,0,0,0,,Saya tidak bisa memberi tahu Anda di mana ia ditenun.
Dialogue: 0,1:11:31.41,1:11:33.51,Default,nanas,0,0,0,,Tapi aku bisa
Dialog: 0,1:11:34.18,1:11:36.88,Default,nanas,0,0,0,,coba cari tahu.
Dialogue: 0,1:11:37.58,1:11:41.75,Default,nanas,0,0,0,,Kamu tidak boleh menyerah tanpa mencoba, setuju kan?
Dialog: 0,1:11:41.75,1:11:43.89,Default,nanas,0,0,0,,Saya suka pendekatan Anda.
Dialog: 0,1:11:47.66,1:11:51.56,Default,nanas,0,0,0,,Aku khawatir raja tidak peduli pada ratu,
Dialog: 0,1:11:51.56,1:11:54.40,Default,nanas,0,0,0,,tapi sepertinya semua kekhawatiranku telah berakhir.
Dialogue: 0,1:11:56.30,1:11:58.10,Default,nanas,0,0,0,,Apa lagi yang bisa kamu ceritakan padaku?
Dialog: 0,1:11:58.70,1:12:01.87,Default,nanas,0,0,0,,Tadi malam, saat ratu
Dialog: 0,1:12:01.87,1:12:04.24,Default,nanas,0,0,0,,berada di dapur istana,
Dialog: 0,1:12:04.24,1:12:06.61,Default,nanas,0,0,0,,raja sedang menunggunya sendirian
Dialog: 0,1:12:06.61,1:12:09.88,Default,nanas,0,0,0,,di Aula Daejojeon.
Dialog: 0,1:12:10.05,1:12:14.32,Default,nanas,0,0,0,,Saya menyarankan raja untuk pergi ke Balai Hwijojong,\Ntetapi dia mengatakan bahwa dia tidak akan pergi ke mana pun.
Dialog: 0,1:12:15.45,1:12:20.46,Default,nanas,0,0,0,,Aku tidak percaya, raja kita sangat mengkhawatirkan istrinya!
Dialogue: 0,1:12:20.56,1:12:23.66,Default,nanas,0,0,0,,Oke, kamu boleh berangkat.
Dialog: 0,1:12:24.76,1:12:26.23,Default,nanas,0,0,0,,Oke.
Dialog: 0,1:12:30.50,1:12:32.10,Default,nanas,0,0,0,,Biarkan mereka lebih sering menghabiskan malam bersama,
Dialog: 0,1:12:32.10,1:12:34.17,Default,nanas,0,0,0,,jadi perasaan akan berkobar di antara mereka lebih cepat.
Dialog: 0,1:12:34.87,1:12:37.91,Default,nanas,0,0,0,,Sang Ratu memberiku kata-kata kerajaannya.
Dialog: 0,1:12:38.21,1:12:39.51,Default,nanas,0,0,0,,Sudahkah kamu memberi kesempatan?
Dialog: 0,1:12:39.51,1:12:42.38,Default,nanas,0,0,0,,Dia berjanji akan mengandung seorang pangeran.
Dialog: 0,1:12:42.38,1:12:43.78,Default,nanas,0,0,0,,Apa yang kamu bicarakan!
Dialog: 0,1:12:43.78,1:12:45.58,Default,nanas,0,0,0,,Lalu di keluarga kami
Dialog: 0,1:12:45.58,1:12:48.22,Default,nanas,0,0,0,,akankah pewaris takhta berdarah lahir?
Dialog: 0,1:12:50.92,1:12:52.62,Default,nanas,0,0,0,,Apa ini?
Dialog: 0,1:12:53.26,1:12:54.69,Default,nanas,0,0,0,,Tepat,
Dialog: 0,1:12:55.76,1:12:57.26,Default,nanas,0,0,0,,lihat.
Dialogue: 0,1:12:57.33,1:13:01.03,Default,nanas,0,0,0,,Makanlah, dan kulitmu akan menjadi seperti bayi.
Dialogue: 0,1:13:01.33,1:13:03.57,Default,nanas,0,0,0,,Hadiah yang sangat mahal.
Dialog: 0,1:13:04.60,1:13:06.07,Default,nanas,0,0,0,,Jika Anda menyukai aksinya,
Dialog: 0,1:13:06.07,1:13:09.57,Default,nanas,0,0,0,,Saya tidak akan menyesali apa pun, tetapi saya akan menemukan Anda lebih banyak lagi.
Dialog: 0,1:13:10.31,1:13:11.84,Default,nanas,0,0,0,,Terima kasih.
Dialog: 0,1:13:14.11,1:13:17.68,Default,nanas,0,0,0,,Saya masih tidak percaya\Nsemuanya menjadi luar biasa.
Dialog: 0,1:13:17.68,1:13:21.02,Default,nanas,0,0,0,,Saat ratu jatuh ke danau,
Dialog: 0,1:13:21.02,1:13:23.49,Default,nanas,0,0,0,,Aku hampir jadi gila karena kegembiraan!
Dialog: 0,1:13:24.09,1:13:25.62,Default,nanas,0,0,0,,Kasihan, anak lugu.
Dialog: 0,1:13:25.62,1:13:29.09,Default,nanas,0,0,0,,Saya sangat bangga dia mampu\Nmempertahankan posisi tingginya.
Dialog: 0,1:13:29.83,1:13:32.46,Default,nanas,0,0,0,,Air mata mengalir karena bahagia.
Dialogue: 0,1:13:33.10,1:13:35.00,Default,nanas,0,0,0,,Katakan apa adanya.
Dialog: 0,1:13:35.00,1:13:37.30,Default,nanas,0,0,0,,Jujur saja, ratu sama sekali bukan anak yang lugu.
Dialogue: 0,1:13:37.30,1:13:40.47,Default,nanas,0,0,0,,Ratu kita...\NBagaimana cara mengatakannya dengan lebih tepat?
Dialog: 0,1:13:42.34,1:13:43.84,Default,nanas,0,0,0,,Pintar?
Dialog: 0,1:13:44.81,1:13:46.41,Default,nanas,0,0,0,,Sedikit kata yang salah.
Dialog: 0,1:13:47.11,1:13:50.08,Default,nanas,0,0,0,,-Teliti?\N-Bukan itu.
Dialog: 0,1:13:50.15,1:13:52.98,Default,nanas,0,0,0,,Ada kata yang sempurna.
Dialog: 0,1:13:53.45,1:13:55.95,Default,nanas,0,0,0,,-Lalu...\N-Canggih?
Dialog: 0,1:13:56.12,1:13:57.62,Default,nanas,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,1:14:00.76,1:14:02.29,Default,nanas,0,0,0,,Unik?
Dialog: 0,1:14:02.46,1:14:05.63,Default,nanas,0,0,0,,Tepat! Gadis unik.
Dialog: 0,1:14:05.63,1:14:08.03,Default,nanas,0,0,0,,Kita tidak dapat menemukan ratu yang lebih baik!
Dialog: 0,1:14:08.03,1:14:09.70,Default,nanas,0,0,0,,Tepat sekali!
Dialog: 0,1:14:09.77,1:14:14.04,Default,nanas,0,0,0,,Aku melihatnya dan sampai jumpa di masa mudamu!
Dialog: 0,1:14:14.24,1:14:15.87,Default,nanas,0,0,0,,Omong kosong!
Dialog: 0,1:14:23.45,1:14:24.78,Default,nanas,0,0,0,,Apakah kamu sudah gila?
Dialogue: 0,1:14:24.78,1:14:27.72,Default,nanas,0,0,0,,Apakah kamu melihatnya dengan matamu sendiri?\NDengan ini?
Dialog: 0,1:14:27.72,1:14:30.32,Default,nanas,0,0,0,,Setidaknya seseorang di istana melihatnya secara pribadi,
Dialog: 0,1:14:30.32,1:14:32.22,Default,nanas,0,0,0,,untuk selir mendorong ratu?
Dialog: 0,1:14:33.09,1:14:35.49,Default,nanas,0,0,0,,Apakah itu sepadan?\NSemua orang sudah tahu itu dia!
Dialog: 0,1:14:35.49,1:14:37.16,Default,nanas,0,0,0,,-Tepat!\N-Dia benar.
Dialog: 0,1:14:37.16,1:14:38.26,Default,nanas,0,0,0,,Ya, semua orang mengetahuinya.
Dialog: 0,1:14:38.26,1:14:42.13,Default,nanas,0,0,0,,Seperti kata pepatah, topi pencuri terbakar.
Dialogue: 0,1:14:42.63,1:14:44.40,Default,pineapple,0,0,0,,Rumor ini tidak muncul begitu saja.
Dialog: 0,1:14:49.94,1:14:51.41,Default,nanas,0,0,0,,Beraninya kamu!
Dialog: 0,1:14:51.41,1:14:54.48,Default,nanas,0,0,0,,Bersiaplah! Besok pagi akan ada rumor bahwa kamu botak!
Dialogue: 0,1:14:54.48,1:14:55.78,Default,nanas,0,0,0,,Dasar bajingan!
Dialogue: 0,1:14:55.78,1:14:57.65,Default,nanas,0,0,0,,Lepaskan aku! Sekarang!
Dialogue: 0,1:14:57.65,1:14:59.28,Default,nanas,0,0,0,,Lepaskan aku!
Dialog: 0,1:14:59.75,1:15:01.95,Default,nanas,0,0,0,,Sang Ratu menjebaknya!
Dialog: 0,1:15:01.95,1:15:03.62,Default,nanas,0,0,0,,Saat nyonyaku lewat,
Dialog: 0,1:15:03.62,1:15:05.89,Default,nanas,0,0,0,,ratu sengaja melompat ke air!
Dialog: 0,1:15:05.89,1:15:08.06,Default,nanas,0,0,0,,Sebelum ngobrol, cari tahu kebenarannya!
Dialogue: 0,1:15:24.51,1:15:26.61,Default,nanas,0,0,0,,Hari ini saya pasti...
Dialog: 0,1:15:52.17,1:15:55.97,Default,nanas,0,0,0,,Yang Mulia, saya pikir\NAnda akan berlatih menulis Anda.
Dialog: 0,1:15:56.14,1:15:57.91,Default,nanas,0,0,0,,Saat aku pergi ke Yejan,
Dialog: 0,1:15:57.91,1:16:00.51,Default,nanas,0,0,0,,untuk bermain tudjon dengan Tuan Hong,
Dialog: 0,1:16:00.51,1:16:02.98,Default,nanas,0,0,0,,Aku melihat sesuatu yang membuatku takjub.
Dialog: 0,1:16:05.78,1:16:10.12,Default,nanas,0,0,0,,Seseorang dari jarak jauh\Nmelemparkan belati ke sasaran.
Dialog: 0,1:16:12.69,1:16:15.29,Default,nanas,0,0,0,,Saya pikir kenapa tidak mencobanya.
Dialog: 0,1:16:16.56,1:16:18.26,Default,nanas,0,0,0,,Ini sangat berbahaya,
Dialog: 0,1:16:18.26,1:16:20.43,Default,nanas,0,0,0,,bagaimana jika kamu terluka?
Dialogue: 0,1:16:28.47,1:16:31.24,Default,nanas,0,0,0,,Sudah berapa lama kita saling kenal?
Dialog: 0,1:16:33.51,1:16:36.41,Default,nanas,0,0,0,,Dua tahun pak.
Dialog: 0,1:16:39.95,1:16:41.35,Default,nanas,0,0,0,,Begitulah adanya.
Dialog: 0,1:16:45.09,1:16:48.86,Default,nanas,0,0,0,,Selama ini kamu mempelajari segalanya di dunia tentang aku,
Dialog: 0,1:16:48.86,1:16:50.63,Default,nanas,0,0,0,,menjadi lengan dan kakiku.
Dialog: 0,1:16:50.63,1:16:53.63,Default,nanas,0,0,0,,Seolah-olah kita sudah saling kenal selama bertahun-tahun.
Dialog: 0,1:16:54.63,1:16:57.90,Default,nanas,0,0,0,,Saya hanya melakukan tugas saya.
Dialog: 0,1:16:58.07,1:16:59.57,Default,nanas,0,0,0,,Pekerjaanmu?
Dialog: 0,1:17:01.97,1:17:03.71,Default,nanas,0,0,0,,Mungkin ini pekerjaanmu,
Dialog: 0,1:17:03.71,1:17:05.24,Default,nanas,0,0,0,,tapi aku tidak bisa berhenti memikirkannya
Dialog: 0,1:17:05.24,1:17:08.11,Default,nanas,0,0,0,,apakah kamu mengabdi padaku, karena kamu harus
Dialog: 0,1:17:08.61,1:17:10.08,Default,nanas,0,0,0,,atau
Dialog: 0,1:17:11.08,1:17:14.15,Default,nanas,0,0,0,,karena Anda sendiri yang menginginkannya.
Dialog: 0,1:17:15.75,1:17:17.99,Default,nanas,0,0,0,,Saya yakin perasaan Anda tulus.
Dialog: 0,1:17:19.99,1:17:22.96,Default,nanas,0,0,0,,Terima kasih sudah memperhatikan, Pak!
Dialog: 0,1:17:22.96,1:17:24.86,Default,nanas,0,0,0,,Apakah kamu percaya padaku?
Dialog: 0,1:17:25.36,1:17:28.63,Default,nanas,0,0,0,,Jika bukan untukmu, lalu untuk siapa?
Dialog: 0,1:17:36.04,1:17:37.71,Default,nanas,0,0,0,,Saya pikir akan lebih mudah.
Dialog: 0,1:17:38.11,1:17:42.01,Default,nanas,0,0,0,,Tapi apakah kamu meragukanku?
Dialog: 0,1:17:44.68,1:17:47.22,Default,nanas,0,0,0,,Maafkan saya.
Dialogue: 0,1:17:47.22,1:17:49.92,Default,nanas,0,0,0,,Seiring bertambahnya usia aku menjadi semakin pengecut.
Dialog: 0,1:17:51.62,1:17:54.39,Default,nanas,0,0,0,,Malam ini\NI akan berangkat ke Aula Daejojeon lebih awal.
Dialog: 0,1:17:54.49,1:17:56.36,Default,nanas,0,0,0,,Saya akan menyiapkan semuanya.
Dialogue: 0,1:18:32.96,1:18:35.83,Default,nanas,0,0,0,,Untuk bertemu denganmu,\Nkami harus datang lebih awal.
Dialogue: 0,1:18:37.20,1:18:39.27,Default,nanas,0,0,0,,Betapa rajinnya kamu.
Dialogue: 0,1:18:39.27,1:18:41.17,Default,nanas,0,0,0,,Berusaha keras supaya kita bisa tidur.
Dialog: 0,1:18:41.17,1:18:43.81,Default,nanas,0,0,0,,Kami sudah menyiapkan minuman dan makanan ringan.
Dialogue: 0,1:18:44.94,1:18:46.11,Default,pineapple,0,0,0,,Mengapa ini perlu?
Dialog: 0,1:18:46.11,1:18:48.11,Default,nanas,0,0,0,,Aku tahu kamu suka minum,
Dialog: 0,1:18:48.11,1:18:50.28,Default,nanas,0,0,0,,jadi saya perintahkan untuk disiapkan untuk Anda.
Dialog: 0,1:18:50.35,1:18:51.98,Default,nanas,0,0,0,,Saya sudah selesai dengan ini.
Dialog: 0,1:18:53.95,1:18:56.05,Default,nanas,0,0,0,,Saya juga memikirkan hal ini.
Dialog: 0,1:18:57.42,1:18:59.69,Default,nanas,0,0,0,,Kami membawa suguhan untuk teh.
Dialog: 0,1:19:12.37,1:19:14.27,Default,nanas,0,0,0,,Ini teh melati arab.
Dialog: 0,1:19:15.27,1:19:17.74,Default,nanas,0,0,0,,Jika Anda menderita insomnia atau kecemasan,
Dialog: 0,1:19:17.74,1:19:19.61,Default,nanas,0,0,0,,itu akan menenangkanmu.
Dialog: 0,1:19:26.75,1:19:28.65,Default,nanas,0,0,0,,Jasmine Gull?
Dialogue: 0,1:19:28.82,1:19:31.09,Default,nanas,0,0,0,,Baunya kuat sekali.
Dialogue: 0,1:19:40.63,1:19:44.10,Default,nanas,0,0,0,,Malam itu seluruh ruangan berbau melati.
Dialogue: 0,1:19:48.97,1:19:52.91,Default,nanas,0,0,0,,Baunya bahkan meresap ke lengan bajunya.
Dialog: 0,1:20:25.24,1:20:26.74,Default,nanas,0,0,0,,Itu kamu.
Dialog: 0,1:20:29.68,1:20:31.28,Default,nanas,0,0,0,,Itu kamu...
Dialog: 0,1:20:31.85,1:20:34.45,Default,nanas,0,0,0,,Kamu tidak boleh mengungkapkan semua kartumu begitu saja.
Dialog: 0,1:20:37.79,1:20:43.29,Default,nanas,0,0,0,,Terutama di istana, di mana setiap orang mempunyai rahasianya masing-masing.
Dialogue: 0,1:20:55.24,1:20:56.64,Default,nanas,0,0,0,,Bagaimana aku menjadi seorang ratu
Dialog: 0,1:20:56.64,1:20:57.64,Default,nanas,0,0,0,,
Dialog: 0,1:20:57.64,1:20:59.21,Default,nanas,0,0,0,,
Dialog: 0,1:21:16.49,1:21:18.96,Default,nanas,0,0,0,,Apakah aku benar-benar telah jatuh ke dalam perangkap mata dan kata-katanya yang menipu?
Dialog: 0,1:21:18.96,1:21:20.73,Default,nanas,0,0,0,,Buat dia menceritakan semuanya padamu.
Dialog: 0,1:21:20.73,1:21:22.90,Default,nanas,0,0,0,,-Siapa yang mengirim surat itu?\N-Janda Ratu.
Dialog: 0,1:21:22.90,1:21:24.47,Default,nanas,0,0,0,,Hanya sampai danau terisi air.
Dialog: 0,1:21:24.47,1:21:26.87,Default,nanas,0,0,0,,Aku akan menanggung semua ini, dan kemudian aku akan kembali ke rumah.
Dialog: 0,1:21:26.87,1:21:28.64,Default,nanas,0,0,0,,Orang yang kita cari adalah dayang istana.
Dialog: 0,1:21:28.64,1:21:31.54,Default,nanas,0,0,0,,Lakukan segalanya agar tidak ketahuan.
Dialog: 0,1:21:31.54,1:21:34.01,Default,nanas,0,0,0,,Saya menemukan dari mana kain ini berasal.
Dialog: 0,1:21:34.01,1:21:35.28,Default,nanas,0,0,0,,Dari istana.
Dialog: 0,1:21:35.28,1:21:37.25,Default,nanas,0,0,0,,Kebutuhanmu adalah pasangan kerajaan, bukan aku.
Dialogue: 0,1:21:37.25,1:21:39.85,Default,nanas,0,0,0,,Apakah kamu ingin mengembalikan semuanya?\NIni balas dendam.
Dialog: 0,1:21:39.85,1:21:42.62,Default,nanas,0,0,0,,-Itulah yang kulakukan padamu.\N-Apa menurutmu aku tidak bisa?
Dialog: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


