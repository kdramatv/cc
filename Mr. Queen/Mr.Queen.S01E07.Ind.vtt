Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Nanas, Host, Februari
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.98,0:01:06.45,Default,lily,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.45,0:01:09.06,Default,lily,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:14.50,0:01:16.53,Default,lily,0,0,0,,Wow.
Dialogue: 0,0:01:17.03,0:01:19.43,Default,lily,0,0,0,,Aku tidak percaya Jang Bong-hwan yang hebat
Dialog: 0,0:01:19.53,0:01:23.20,Default,lily,0,0,0,,kamu membutuhkan hal seperti itu untuk mempertahankan hidup.
Dialogue: 0,0:01:24.87,0:01:27.54,Default,lily,0,0,0,,Hidup ini sangat tidak berharga, bukan?
Dialog: 0,0:01:28.84,0:01:31.71,Default,lily,0,0,0,,Saya sangat termotivasi.
Dialogue: 0,0:01:32.05,0:01:34.92,Default,lily,0,0,0,,Bisakah saya menjadi \NSteve Jobs atau Thomas Edison lokal?
Dialogue: 0,0:01:35.75,0:01:37.28,Default,lily,0,0,0,,Tidak, aku menganggapnya rendah. Kami membutuhkan seseorang yang hebat.
Dialog: 0,0:01:37.28,0:01:40.15,Default,lily,0,0,0,,Penyelamat umat manusia.
Dialog: 0,0:01:49.13,0:01:51.50,Default,lily,0,0,0,,Di dalam tubuh ratu duduk,
Dialog: 0,0:01:53.03,0:01:56.30,Default,lily,0,0,0,,yang seharusnya tidak ada di sana.
Dialog: 0,0:01:56.50,0:01:58.11,Default,lily,0,0,0,,Roh jahat.
Dialogue: 0,0:02:00.01,0:02:03.98,Default,lily,0,0,0,,Sang Ratu kerasukan roh jahat!
Dialog: 0,0:02:05.28,0:02:07.31,Default,lily,0,0,0,,Aku tidak bisa meninggalkanmu seperti ini.
Dialog: 0,0:02:07.38,0:02:09.78,Default,lily,0,0,0,,Pergi selamanya.
Dialog: 0,0:02:16.02,0:02:19.76,Default,lily,0,0,0,,Tepat, Operator! Penemu AC!
Dialog: 0,0:02:25.07,0:02:26.27,Default,lily,0,0,0,,Yang Mulia!
Dialogue: 0,0:02:26.27,0:02:29.37,Default,lily,0,0,0,,Sadarlah, Yang Mulia! Ayo.
Dialog: 0,0:02:29.37,0:02:30.84,Default,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:36.24,0:02:39.68,Default,lily,0,0,0,,7 episode: Topeng
Dialog: 0,0:02:39.68,0:02:41.58,Default,lily,0,0,0,,-Mengisi daya sebesar 100 joule.\N-Minggir.
Dialog: 0,0:02:42.85,0:02:45.15,Default,lily,0,0,0,,Tambahkan epinefrin. Biaya untuk 150 joule.
Dialog: 0,0:02:45.45,0:02:47.65,Default,lily,0,0,0,,-Mengisi daya sebesar 150 joule.\N-Minggir.
Dialogue: 0,0:02:55.33,0:02:58.00,Default,lily,0,0,0,,-Live.\N-Aku datang.
Dialogue: 0,0:02:59.43,0:03:02.24,Default,lily,0,0,0,,Bukankah ini pelayan ratu?
Dialog: 0,0:03:02.97,0:03:06.11,Default,lily,0,0,0,,Dan dokter kerajaan mengejarnya.
Dialog: 0,0:03:10.58,0:03:13.51,Default,lily,0,0,0,,-Apa yang terjadi?\N-Yang Mulia...
Dialog: 0,0:03:24.86,0:03:27.36,Default,lily,0,0,0,,Yang Mulia. Itu berbahaya!
Dialog: 0,0:03:27.36,0:03:28.80,Default,lily,0,0,0,,Tuhan.
Dialog: 0,0:03:32.13,0:03:33.60,Default,lily,0,0,0,,Yang Mulia.
Dialogue: 0,0:03:33.90,0:03:37.97,Default,lily,0,0,0,,Aku sudah memikirkannya, aku mengomelimu demi kebaikanmu sendiri...
Dialog: 0,0:03:37.97,0:03:39.64,Default,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:41.68,0:03:43.11,Default,lily,0,0,0,,Yang Mulia!
Dialogue: 0,0:03:44.38,0:03:45.65,Default,lily,0,0,0,,Apa yang terjadi disini?
Dialog: 0,0:03:45.65,0:03:48.65,Default,lily,0,0,0,,Mereka sudah berangkat menuju tabib kerajaan.
Dialog: 0,0:03:49.05,0:03:50.45,Default,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:50.52,0:03:53.22,Default,lily,0,0,0,,Kamu tidak bisa mati!
Dialogue: 0,0:03:53.22,0:03:56.19,Default,lily,0,0,0,,Jangan tinggalkan aku!
Dialog: 0,0:03:56.19,0:03:58.76,Default,lily,0,0,0,,Aku tidak akan mengomel padamu lagi.
Dialogue: 0,0:03:58.76,0:04:02.33,Default,lily,0,0,0,,Sadarlah, Yang Mulia.
Dialog: 0,0:04:03.70,0:04:06.87,Default,lily,0,0,0,,Lakukan sesuatu!
Dialog: 0,0:04:07.23,0:04:09.57,Default,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:04:09.57,0:04:10.57,Default,lily,0,0,0,,Rumah Sakit Universitas Hanguk, Jang Bong Hwan
Dialog: 0,0:04:10.57,0:04:12.17,Default,lily,0,0,0,,-Mengisi daya sebesar 100 joule.\N-Selesai.
Dialog: 0,0:04:12.17,0:04:13.61,Default,lily,0,0,0,,Minggir.
Dialog: 0,0:04:16.44,0:04:18.18,Default,lily,0,0,0,,150 joule, selesai.
Dialog: 0,0:04:19.95,0:04:22.88,Default,lily,0,0,0,,-Dia kembali.\N-Apa ini?
Dialogue: 0,0:04:23.38,0:04:25.62,Default,lily,0,0,0,,Betapa cerahnya. Apa yang dia lakukan?
Dialog: 0,0:04:25.65,0:04:27.85,Default,lily,0,0,0,,Denyut normal. Tekanan?
Dialogue: 0,0:04:27.89,0:04:29.32,Default,lily,0,0,0,,Tekanannya juga normal.
Dialog: 0,0:04:29.32,0:04:32.66,Default,lily,0,0,0,,Rumah Sakit? Apakah saya kembali?
Dialog: 0,0:04:32.79,0:04:34.56,Default,lily,0,0,0,,Kembali. Kebenarannya telah kembali.
Dialogue: 0,0:04:34.56,0:04:37.56,Default,lily,0,0,0,,Jang Bong-hwan, kamu sedang sekarat.
Dialog: 0,0:04:37.56,0:04:38.77,Default,lily,0,0,0,,Saya tahu.
Dialog: 0,0:04:38.77,0:04:41.60,Default,lily,0,0,0,,Kupikir aku akan dikurung di tubuh wanita seumur hidupku.
Dialog: 0,0:04:41.60,0:04:43.14,Default,lily,0,0,0,,Berapa hari telah berlalu?
Dialog: 0,0:04:43.14,0:04:45.01,Default,lily,0,0,0,,Tepat. Berapa hari saya berbohong?
Dialog: 0,0:04:45.01,0:04:46.61,Default,lily,0,0,0,,Badannya berat sekali.
Dialog: 0,0:04:46.61,0:04:48.14,Default,lily,0,0,0,,Seminggu telah berlalu.
Dialog: 0,0:04:48.14,0:04:50.41,Default,lily,0,0,0,,Waktu berlalu dengan cara yang sama seperti di Joseon.
Dialogue: 0,0:04:50.41,0:04:51.81,Default,lily,0,0,0,,Pertama, bantu aku bangun.
Dialog: 0,0:04:51.81,0:04:54.25,Default,lily,0,0,0,,Dia tidak sadarkan diri selama seminggu,
Dialog: 0,0:04:54.65,0:04:56.18,Default,lily,0,0,0,,sekarang dalam keadaan vegetatif.
Dialogue: 0,0:04:56.18,0:04:59.19,Default,lily,0,0,0,,Apa artinya dalam keadaan vegetatif?
Dialogue: 0,0:04:59.22,0:05:02.52,Default,lily,0,0,0,,Hai Dr. Lee, apa kamu membicarakan aku?
Dialogue: 0,0:05:02.52,0:05:04.63,Default,lily,0,0,0,,Apa keadaan vegetatifnya, apakah saya normal?
Dialog: 0,0:05:04.63,0:05:05.76,Default,lily,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:05:05.76,0:05:07.83,Default,lily,0,0,0,,-Awasi dia.\N-Ya.
Dialog: 0,0:05:10.20,0:05:11.43,Default,lily,0,0,0,,Mau kemana?
Dialog: 0,0:05:11.43,0:05:13.57,Default,lily,0,0,0,,Kembalilah! Saya baik-baik saja!
Dialog: 0,0:05:13.57,0:05:15.14,Default,lily,0,0,0,,Ya, aku seperti mentimun!
Dialog: 0,0:05:15.94,0:05:18.54,Default,lily,0,0,0,,Apa? Tidak adakah yang bisa mendengarku?
Dialogue: 0,0:05:18.54,0:05:21.21,Default,lily,0,0,0,,Aku di sini. saya kembali.
Dialog: 0,0:05:21.34,0:05:23.91,Default,lily,0,0,0,,Jang Bong Hwan kembali!
Dialogue: 0,0:05:24.18,0:05:26.65,Default,lily,0,0,0,,Kapan penyembuhnya datang?
Dialog: 0,0:05:27.28,0:05:28.32,Default,lily,0,0,0,,Ratu!
Dialog: 0,0:05:28.32,0:05:30.35,Default,lily,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialogue: 0,0:05:30.75,0:05:33.62,Default,lily,0,0,0,,Ratuku, bangun!
Dialogue: 0,0:05:34.45,0:05:36.32,Default,lily,0,0,0,,Apa yang terjadi disini?
Dialog: 0,0:05:36.62,0:05:40.26,Default,lily,0,0,0,,Dia tiba-tiba melompat,
Dialog: 0,0:05:40.29,0:05:43.13,Default,lily,0,0,0,,lalu dia menjadi pucat dan terjatuh.
Dialogue: 0,0:05:43.13,0:05:45.97,Default,lily,0,0,0,,Bagaimana dia bisa tiba-tiba jatuh?
Dialogue: 0,0:05:45.97,0:05:47.40,Default,lily,0,0,0,,Mungkin keracunan.
Dialog: 0,0:05:48.40,0:05:50.40,Default,lily,0,0,0,,Dia bisa saja diracuni!
Dialogue: 0,0:05:50.40,0:05:51.87,Default,lily,0,0,0,,Apa?
Dialog: 0,0:05:52.84,0:05:55.71,Default,lily,0,0,0,,Ini tidak mungkin.
Dialog: 0,0:05:55.71,0:05:57.31,Default,lily,0,0,0,,Kami memantau produk dengan cermat,
Dialog: 0,0:05:57.31,0:05:59.05,Default,lily,0,0,0,,orang luar tidak diperbolehkan di sini,
Dialog: 0,0:05:59.05,0:06:02.38,Default,lily,0,0,0,,dan ratu tidak makan apa pun di sini.
Dialog: 0,0:06:02.78,0:06:05.02,Default,lily,0,0,0,,Lalu apa yang dia lakukan di sini?
Dialog: 0,0:06:05.02,0:06:06.75,Default,lily,0,0,0,,Apakah kamu memasak?
Dialog: 0,0:06:07.12,0:06:08.79,Default,lily,0,0,0,,Ya.
Dialog: 0,0:06:09.69,0:06:12.89,Default,lily,0,0,0,,Dia bisa saja terkena racun
Dialog: 0,0:06:12.89,0:06:15.46,Default,lily,0,0,0,,mencicipi masakannya, Yang Mulia.
Dialog: 0,0:06:15.90,0:06:19.07,Default,lily,0,0,0,,Anda tidak dapat memastikannya.
Dialog: 0,0:06:19.07,0:06:20.43,Default,lily,0,0,0,,Otolopy.
Dialogue: 0,0:06:20.43,0:06:22.60,Default,lily,0,0,0,,Aku selalu takut,
Dialog: 0,0:06:22.60,0:06:25.61,Default,lily,0,0,0,,hal seperti ini akan terjadi.
Dialog: 0,0:06:25.74,0:06:29.28,Default,lily,0,0,0,,Dan akhirnya terjadi!
Dialog: 0,0:06:29.38,0:06:32.45,Default,lily,0,0,0,,Apakah dia benar-benar diracuni?
Dialogue: 0,0:06:33.98,0:06:35.38,Default,lily,0,0,0,,I...
Dialogue: 0,0:06:35.58,0:06:37.42,Default,lily,0,0,0,,Aku akan memeriksanya.
Dialog: 0,0:06:37.42,0:06:38.92,Default,lily,0,0,0,,Jangan ragu.
Dialog: 0,0:06:50.50,0:06:51.97,Default,lily,0,0,0,,Pulse
Dialog: 0,0:06:52.50,0:06:55.10,Default,lily,0,0,0,,tidak seperti yang hidup.
Dialogue: 0,0:06:55.47,0:06:57.27,Default,lily,0,0,0,,Apa maksudnya ini?
Dialog: 0,0:07:08.72,0:07:09.92,Default,lily,0,0,0,,Keadaan vegetatif.
Dialogue: 0,0:07:12.12,0:07:13.45,Default,lily,0,0,0,,Keadaan vegetatif?
Dialog: 0,0:07:13.45,0:07:17.69,Default,lily,0,0,0,,Seseorang tidak bisa bergerak dan seperti sayur.
Dialogue: 0,0:07:19.19,0:07:21.73,Default,lily,0,0,0,,Darah dan qi\Nenerginya berkumpul di bagian atas tubuhnya,
Dialog: 0,0:07:21.73,0:07:25.37,Default,lily,0,0,0,,roh telah meninggalkan tubuh, dan dia hampir tidak bernapas.
Dialog: 0,0:07:25.37,0:07:29.14,Default,lily,0,0,0,,Jika energi chi kembali, dia akan bertahan. Jika tidak -
Dialogue: 0,0:07:31.34,0:07:33.21,Default,lily,0,0,0,,dia akan mati.
Dialogue: 0,0:07:36.81,0:07:38.38,Default,lily,0,0,0,,Apa artinya mati?
Dialog: 0,0:07:39.48,0:07:40.85,Default,lily,0,0,0,,Apa yang bisa kulakukan
Dialog: 0,0:07:40.85,0:07:43.35,Default,lily,0,0,0,,apa yang harus dilakukan untuk menyelamatkannya?
Dialog: 0,0:07:43.95,0:07:48.09,Default,lily,0,0,0,,Kamu perlu menuangkan rebusan kembang sepatu dan jus calamus ke dalam mulutnya.
Dialog: 0,0:07:48.09,0:07:49.46,Default,lily,0,0,0,,Kepala Kasim.
Dialog: 0,0:07:49.46,0:07:51.09,Default,lily,0,0,0,,Bawa semuanya segera!
Dialog: 0,0:07:51.09,0:07:52.49,Default,lily,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:07:52.49,0:07:54.86,Default,lily,0,0,0,,Akankah Ratu bertahan sampai saat itu?
Dialog: 0,0:07:55.80,0:07:57.73,Default,lily,0,0,0,,Itulah masalahnya.
Dialog: 0,0:07:57.73,0:08:00.83,Default,lily,0,0,0,,Jangan hanya berdiri disana, lakukan sesuatu!
Dialogue: 0,0:08:00.83,0:08:03.44,Default,lily,0,0,0,,Selamatkan ratu kita.
Dialog: 0,0:08:03.44,0:08:07.27,Default,lily,0,0,0,,Untuk melakukan sesuatu, Anda perlu memindahkannya.
Dialog: 0,0:08:11.45,0:08:13.08,Default,lily,0,0,0,,Kita pergi ke aula Daejojon.
Dialog: 0,0:08:14.41,0:08:15.92,Default,lily,0,0,0,,Yang Mulia.
Dialogue: 0,0:08:16.48,0:08:18.08,Default,lily,0,0,0,,Ibu Suri.
Dialogue: 0,0:08:18.45,0:08:22.02,Default,lily,0,0,0,,Kita perlu mengusir roh jahat dari tubuh ratu.
Dialog: 0,0:08:22.32,0:08:24.16,Default,lily,0,0,0,,Kamu tidak perlu ragu.
Dialog: 0,0:08:24.62,0:08:27.23,Default,lily,0,0,0,,Dan bagaimana cara melakukan ini?
Dialog: 0,0:08:27.23,0:08:29.90,Default,lily,0,0,0,,Ayo letakkan benda menakutkan di sekitar aula Daejojon\N
Dialog: 0,0:08:29.90,0:08:31.90,Default,lily,0,0,0,,dan blokir energinya.
Dialogue: 0,0:08:32.40,0:08:34.84,Default,lily,0,0,0,,Dan kemudian kita akan melakukan ritual pengusiran roh.
Dialogue: 0,0:08:35.44,0:08:38.54,Default,lily,0,0,0,,Ini berbahaya. Ritual seperti itu tidak bisa dilakukan di istana.
Dialog: 0,0:08:38.84,0:08:40.01,Default,lily,0,0,0,,Jika kita ketahuan...
Dialog: 0,0:08:40.01,0:08:43.01,Default,lily,0,0,0,,Tidak ada gunanya melakukan ritual di luar istana.
Dialog: 0,0:08:43.34,0:08:47.41,Default,lily,0,0,0,,Agar ritual berhasil, lakukanlah
Dialog: 0,0:08:47.45,0:08:49.38,Default,lily,0,0,0,,dibutuhkan di dekat ratu.
Dialog: 0,0:09:01.43,0:09:02.90,Default,lily,0,0,0,,Langsung.
Dialog: 0,0:09:03.06,0:09:04.40,Default,lily,0,0,0,,Ya.
Dialog: 0,0:09:04.40,0:09:07.13,Default,lily,0,0,0,,-Selesai?\N-Ya, semuanya sudah siap.
Dialogue: 0,0:09:20.18,0:09:22.42,Default,lily,0,0,0,,Apa yang terjadi?
Dialog: 0,0:09:22.62,0:09:25.12,Default,lily,0,0,0,,Pasien mengalami serangan jantung.
Dialog: 0,0:09:25.12,0:09:27.45,Default,lily,0,0,0,,Dengar. Di Sini. Lihat disini.
Dialog: 0,0:09:27.45,0:09:29.02,Default,lily,0,0,0,,Bisakah kamu mendengarku?
Dialog: 0,0:09:32.16,0:09:33.46,Default,lily,0,0,0,,Apakah dia mengatakan sesuatu?
Dialog: 0,0:09:33.46,0:09:36.23,Default,lily,0,0,0,,Ya. Bisakah kamu mendengar? Saya mengetahuinya.
Dialog: 0,0:09:36.23,0:09:39.37,Default,lily,0,0,0,,Aku mendengar dan melihat semuanya, aku bukan sayur.
Dialogue: 0,0:09:41.00,0:09:42.10,Default,lily,0,0,0,,Benarkah?
Dialog: 0,0:09:42.10,0:09:43.40,Default,lily,0,0,0,,Apakah dia benar-benar berbicara?
Dialogue: 0,0:09:43.40,0:09:44.60,Default,lily,0,0,0,,Dia dituduh secara salah.
Dialogue: 0,0:09:44.60,0:09:46.81,Default,lily,0,0,0,,Hei tolol, idiot.
Dialog: 0,0:09:46.81,0:09:49.84,Default,lily,0,0,0,,-Aku mendengarmu, tolol.\N-Aku yakin dia merasakan hal yang sama.
Dialog: 0,0:09:49.98,0:09:52.31,Default,lily,0,0,0,,Dia berada di tengah-tengah skandal antara Khan\N dan Perdana Menteri
Dialog: 0,0:09:52.31,0:09:53.75,Default,lily,0,0,0,,dan akan menyalahkan dirinya sendiri.
Dialog: 0,0:09:53.75,0:09:55.22,Default,lily,0,0,0,,Apa ini?
Dialog: 0,0:09:55.22,0:09:57.92,Default,lily,0,0,0,,Trik Sutradara Khan?
Dialog: 0,0:10:06.96,0:10:08.70,Default,lily,0,0,0,,Mulai pengobatan.
Dialog: 0,0:10:12.47,0:10:14.47,Default,lily,0,0,0,,Dia kelihatannya gila,
Dialog: 0,0:10:14.47,0:10:16.74,Default,lily,0,0,0,,tapi sepertinya tidak akan bisa menyematkan semuanya padanya.
Dialog: 0,0:10:16.74,0:10:20.37,Default,lily,0,0,0,,Apa yang bisa dia lakukan? Lagipula dia pecundang.
Dialog: 0,0:10:20.37,0:10:22.74,Default,lily,0,0,0,,Jalan keluar terbaik baginya adalah berbaring di sini.
Dialog: 0,0:10:22.74,0:10:24.41,Default,lily,0,0,0,,Apakah kamu serius saat ini?
Dialogue: 0,0:10:24.41,0:10:27.55,Default,lily,0,0,0,,Di tempatku apakah mereka akan berbohong dan menderita?
Dialogue: 0,0:10:27.55,0:10:30.08,Default,lily,0,0,0,,Bisakah detektif mengatakan itu?
Dialog: 0,0:10:32.55,0:10:34.02,Default,lily,0,0,0,,Sekarang
Dialogue: 0,0:10:34.15,0:10:37.79,Default,lily,0,0,0,,Aku akan mempertaruhkan nyawaku dan menjalani akupunktur.
Dialogue: 0,0:10:53.34,0:10:54.94,Default,lily,0,0,0,,Aku tidak akan membiarkan dia lolos begitu saja.
Dialogue: 0,0:10:55.01,0:10:58.78,Default,lily,0,0,0,,Penjahat Sutradara Khan.
Dialog: 0,0:11:03.05,0:11:04.15,Default,nanas,0,0,0,,Roh Kudus!
Dialog: 0,0:11:04.15,0:11:07.12,Default,nanas,0,0,0,,Ya, aku akan gigit tulang punggungnya!
Dialogue: 0,0:11:11.26,0:11:13.73,Default,nanas,0,0,0,,Apa yang kamu lupakan di sini?
Dialog: 0,0:11:17.93,0:11:18.93,Default,nanas,0,0,0,,Ratu!
Dialog: 0,0:11:18.93,0:11:20.50,Default,nanas,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:11:20.50,0:11:21.90,Default,nanas,0,0,0,,Yang Mulia!
Dialogue: 0,0:11:21.94,0:11:25.47,Default,nanas,0,0,0,,Kamu sudah makan banyak, \Nlupa hati-hati!
Dialogue: 0,0:11:25.47,0:11:28.07,Default,nanas,0,0,0,,Mau ngemil apa di sana?
Dialogue: 0,0:11:36.98,0:11:39.75,Default,nanas,0,0,0,,Yang terburuk sudah berakhir.
Dialog: 0,0:11:40.99,0:11:43.46,Default,nanas,0,0,0,,Tapi kenapa dia tidak bangun?
Dialog: 0,0:11:43.62,0:11:45.49,Default,nanas,0,0,0,,Sang Ratu bernapas lagi,
Dialog: 0,0:11:45.49,0:11:48.90,Default,nanas,0,0,0,,tapi dia belum sepenuhnya sadar.
Dialogue: 0,0:11:49.36,0:11:51.70,Default,nanas,0,0,0,,Kita harus mengawasinya,
Dialog: 0,0:11:51.80,0:11:54.13,Default,nanas,0,0,0,,ratu mungkin bertambah parah.
Dialog: 0,0:11:55.24,0:11:57.40,Default,nanas,0,0,0,,Dengan kata lain, ini belum berakhir?
Dialog: 0,0:11:57.40,0:11:58.94,Default,nanas,0,0,0,,Malam ini
Dialog: 0,0:11:59.31,0:12:00.97,Default,nanas,0,0,0,,semuanya akan terselesaikan.
Dialog: 0,0:12:11.42,0:12:14.49,Default,nanas,0,0,0,,Raja pergi ke Balai Daejojong.
Dialog: 0,0:12:16.22,0:12:17.42,Default,nanas,0,0,0,,Mengapa?
Dialog: 0,0:12:17.42,0:12:19.79,Default,nanas,0,0,0,,Sang Ratu kehilangan kesadaran,
Dialog: 0,0:12:20.06,0:12:22.90,Default,nanas,0,0,0,,dia ingin berada di samping tempat tidurnya dan menjaganya.
Dialog: 0,0:12:27.00,0:12:28.50,Default,nanas,0,0,0,,Oke.
Dialog: 0,0:12:28.67,0:12:30.60,Default,nanas,0,0,0,,Layak diubah...
Dialog: 0,0:12:30.60,0:12:32.51,Default,nanas,0,0,0,,Saya bilang semuanya baik-baik saja.
Dialogue: 0,0:13:05.31,0:13:06.87,Default,nanas,0,0,0,,Tutup mulutmu.
Dialog: 0,0:13:07.37,0:13:10.24,Default,nanas,0,0,0,,Cari tahu siapa, hidupmu akan dalam bahaya.
Dialog: 0,0:13:10.24,0:13:13.11,Default,nanas,0,0,0,,Tentu saja, saya mengerti segalanya.
Dialog: 0,0:13:18.02,0:13:23.02,Default,nanas,0,0,0,,Aku tak percaya gadis ini\Ni adalah bawahan nyonya istana Choi.
Dialogue: 0,0:13:23.16,0:13:26.89,Default,nanas,0,0,0,,Semuanya berjalan dengan baik.
Dialog: 0,0:13:27.63,0:13:31.43,Default,nanas,0,0,0,,Aku tahu, roh ada di pihak kita.
Dialog: 0,0:13:31.43,0:13:33.40,Default,nanas,0,0,0,,Ibu Suri, apakah kamu di sana?
Dialog: 0,0:13:45.51,0:13:47.75,Default,nanas,0,0,0,,Saya ingin melakukan ritual,
Dialogue: 0,0:13:47.75,0:13:49.92,Default,nanas,0,0,0,,ini, aku sedang bersiap-siap.
Dialog: 0,0:13:49.92,0:13:52.75,Default,nanas,0,0,0,,Tidak ada yang serius, jadi silakan duduk.
Dialog: 0,0:13:53.69,0:13:55.59,Default,nanas,0,0,0,,Saya ingin berbicara dengan Anda.
Dialog: 0,0:13:57.79,0:13:59.53,Default,nanas,0,0,0,,Saya tahu segalanya.
Dialog: 0,0:14:00.33,0:14:03.96,Default,nanas,0,0,0,,Kamu meminta ayahmu untuk mengampuni ratu.
Dialogue: 0,0:14:04.16,0:14:06.30,Default,nanas,0,0,0,,Waktu itu kamu bilang,
Dialog: 0,0:14:07.03,0:14:10.07,Default,nanas,0,0,0,,bahwa saya tidak harus bertindak sendiri.
Dialog: 0,0:14:10.07,0:14:12.51,Default,nanas,0,0,0,,-Benar.\N-Tapi apa
Dialog: 0,0:14:13.54,0:14:15.64,Default,nanas,0,0,0,,jika saya ingin melakukan sesuatu?
Dialog: 0,0:14:17.38,0:14:18.81,Default,nanas,0,0,0,,Lalu
Dialogue: 0,0:14:19.95,0:14:22.92,Default,nanas,0,0,0,,bisakah aku melampaui ratu?
Dialog: 0,0:14:46.91,0:14:50.78,Default,nanas,0,0,0,,Aku akan menginap semalaman, kamu boleh pergi.
Dialogue: 0,0:14:51.81,0:14:54.71,Default,nanas,0,0,0,,Sudah larut, aku takut bagaimana kabarmu
Dialogue: 0,0:14:54.71,0:14:56.55,Default,nanas,0,0,0,,mereka juga tidak sakit.
Dialog: 0,0:14:56.78,0:14:58.25,Default,nanas,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:14:58.69,0:15:01.05,Default,nanas,0,0,0,,Kamu boleh pergi.
Dialog: 0,0:15:01.39,0:15:02.82,Default,nanas,0,0,0,,Ya.
Dialogue: 0,0:15:15.27,0:15:18.74,Default,nanas,0,0,0,,Aku belum pernah mengalami satu hari pun yang tenang di sini.
Dialog: 0,0:15:19.01,0:15:22.24,Default,nanas,0,0,0,,Suami yang berbagi selimut denganku mencoba membunuhku.
Dialog: 0,0:15:23.68,0:15:25.45,Default,nanas,0,0,0,,Kamu akan merasa mati rasa,
Dialog: 0,0:15:25.45,0:15:26.98,Default,nanas,0,0,0,,jangan ragu dan pukul.
Dialog: 0,0:15:26.98,0:15:28.48,Default,nanas,0,0,0,,Keluar?
Dialog: 0,0:15:28.58,0:15:30.52,Default,nanas,0,0,0,,Aku memberanikan diri untuk meminta maaf,
Dialogue: 0,0:15:30.52,0:15:32.85,Default,pineapple,0,0,0,,dan ini balasan yang saya dapat?
Dialog: 0,0:15:33.02,0:15:35.62,Default,nanas,0,0,0,,Dengar, andai saja yang butuh permintaan maaf itu
Dialog: 0,0:15:35.62,0:15:37.29,Default,nanas,0,0,0,,yang meminta maaf, bukan yang menerimanya,
Dialog: 0,0:15:37.29,0:15:38.76,Default,nanas,0,0,0,,apakah ini permintaan maaf?
Dialog: 0,0:15:39.49,0:15:42.70,Default,nanas,0,0,0,,Momennya hilang. Tidak ada gunanya mengatakan apa pun.
Dialog: 0,0:15:45.53,0:15:47.90,Default,nanas,0,0,0,,Saya berharap
Dialog: 0,0:15:48.27,0:15:50.80,Default,nanas,0,0,0,,bahwa saya akan memiliki kesempatan untuk memahami Anda.
Dialogue: 0,0:15:57.41,0:16:01.58,Default,nanas,0,0,0,,Ini kain yang sangat mahal.
Dialog: 0,0:16:01.88,0:16:04.25,Default,nanas,0,0,0,,Jika saya menggunakannya,
Dialog: 0,0:16:04.48,0:16:06.89,Default,nanas,0,0,0,,Aku akan mengingatnya seumur hidupku.
Dialog: 0,0:16:06.89,0:16:08.39,Default,nanas,0,0,0,,Apakah kamu yakin?
Dialogue: 0,0:16:09.72,0:16:12.63,Default,nanas,0,0,0,,Mereka membawakanmu sutra untuk dibuat
Dialogue: 0,0:16:12.63,0:16:14.69,Default,nanas,0,0,0,,bunga sutra untuk jamuan makan.
Dialog: 0,0:16:14.69,0:16:15.93,Default,nanas,0,0,0,,Benar.
Dialogue: 0,0:16:15.93,0:16:19.40,Default,nanas,0,0,0,,Dan kainmu tidak tersisa?
Dialog: 0,0:16:20.60,0:16:23.00,Default,nanas,0,0,0,,Masalahnya adalah,
Dialog: 0,0:16:24.20,0:16:25.61,Default,nanas,0,0,0,,kepala di dapur,
Dialog: 0,0:16:25.61,0:16:28.44,Default,nanas,0,0,0,,Tn. Kim Moon-geun, mengambil kainnya.
Dialogue: 0,0:16:33.81,0:16:37.88,Default,nanas,0,0,0,,Apakah ada yang serupa di antara kain itu?
Dialog: 0,0:16:38.48,0:16:40.65,Default,nanas,0,0,0,,Ini...
Dialog: 0,0:17:00.34,0:17:02.18,Default,nanas,0,0,0,,Saya melihatnya membakar sesuatu yang berharga,
Dialog: 0,0:17:02.18,0:17:05.35,Default,nanas,0,0,0,,mendapatkannya mencurigakan dan mengeluarkannya dari api.
Dialog: 0,0:17:05.38,0:17:06.95,Default,nanas,0,0,0,,Saya yakin itu dia.
Dialog: 0,0:17:08.78,0:17:10.52,Default,nanas,0,0,0,,Pangeran Yeonpyeong?
Dialog: 0,0:17:18.29,0:17:20.69,Default,nanas,0,0,0,,Apakah raja benar-benar ada hubungannya dengan ini?
Dialog: 0,0:17:21.13,0:17:22.66,Default,nanas,0,0,0,,Apa katamu?
Dialog: 0,0:17:22.66,0:17:24.06,Default,nanas,0,0,0,,Ibu Suri dan Selir Cho
Dialog: 0,0:17:24.06,0:17:26.90,Default,nanas,0,0,0,,apakah mereka melakukan ritual bersama di dalam tembok istana?
Dialog: 0,0:17:26.97,0:17:28.37,Default,nanas,0,0,0,,Benar.
Dialog: 0,0:17:29.27,0:17:31.84,Default,nanas,0,0,0,,Saya pikir selir kerajaan punya cukup otak untuk tidak terlibat dalam hal ini,
Dialog: 0,0:17:31.84,0:17:34.67,Default,nanas,0,0,0,,tapi sepertinya dia sama dengan Ibu Suri.
Dialog: 0,0:17:35.88,0:17:37.28,Default,nanas,0,0,0,,Itu lebih baik lagi.
Dialogue: 0,0:17:37.28,0:17:40.41,Default,nanas,0,0,0,,Aku bisa memberi pelajaran bagus pada orang-orang gila ini.
Dialog: 0,0:17:40.41,0:17:42.12,Default,nanas,0,0,0,,Jika kamu menegur mereka karena ritualnya
Dialog: 0,0:17:42.12,0:17:44.62,Default,nanas,0,0,0,,dan jimat, rumor akan dimulai.
Dialog: 0,0:17:45.28,0:17:47.49,Default,nanas,0,0,0,,Tapi mereka tidak mau berhenti.
Dialog: 0,0:17:48.12,0:17:49.82,Default,nanas,0,0,0,,Kamu benar.
Dialogue: 0,0:17:50.06,0:17:53.53,Default,pineapple,0,0,0,,Saya harap saya bisa melakukan \Nsesuatu yang lebih substansial.
Dialog: 0,0:17:55.93,0:17:58.93,Default,nanas,0,0,0,,Ini adalah kepala kasim! Saya punya berita penting!
Dialog: 0,0:17:58.93,0:18:00.33,Default,nanas,0,0,0,,Masuk.
Dialog: 0,0:18:06.01,0:18:07.57,Default,nanas,0,0,0,,Apa yang terjadi?
Dialog: 0,0:18:07.77,0:18:12.18,Default,nanas,0,0,0,,Ratu kehabisan napas, dia tak sadarkan diri.
Dialogue: 0,0:18:13.35,0:18:15.01,Default,nanas,0,0,0,,Kehilangan nafas?
Dialog: 0,0:18:15.01,0:18:18.32,Default,nanas,0,0,0,,Penyembuh mengembalikan napasnya,
Dialog: 0,0:18:18.32,0:18:20.72,Default,nanas,0,0,0,,tapi dia perlu diawasi sepanjang malam.
Dialog: 0,0:18:20.72,0:18:23.02,Default,nanas,0,0,0,,Apa yang terjadi?
Dialog: 0,0:18:23.02,0:18:28.90,Default,nanas,0,0,0,,Ada kecurigaan ratu diracun saat memasak di dapur.
Dialog: 0,0:18:35.90,0:18:38.87,Default,nanas,0,0,0,,Kim Soyeon
Dialog: 0,0:18:42.91,0:18:45.51,Default,nanas,0,0,0,,
Dialog: 0,0:19:14.57,0:19:16.94,Default,nanas,0,0,0,,Jika kamu ingin bertarung dengan sepenuh hati,
Dialog: 0,0:19:19.61,0:19:22.08,Default,nanas,0,0,0,,jika kamu ingin mengalahkannya dengan sepenuh hati,
Dialog: 0,0:19:22.22,0:19:27.22,Default,nanas,0,0,0,,maka mulai sekarang\Nkamu tidak boleh menyimpan rahasia dariku.
Dialogue: 0,0:19:30.79,0:19:32.63,Default,nanas,0,0,0,,Apakah kamu setuju?
Dialog: 0,0:19:34.36,0:19:37.70,Default,nanas,0,0,0,,Ya, saya setuju.
Dialog: 0,0:19:40.70,0:19:43.14,Default,nanas,0,0,0,,Kalau begitu beri tahu aku apakah itu sepadan
Dialog: 0,0:19:43.14,0:19:45.97,Default,nanas,0,0,0,,apakah raja tahu apa yang terjadi di sini?
Dialog: 0,0:19:55.82,0:19:57.92,Default,nanas,0,0,0,,Keinginan Raja
Dialog: 0,0:19:58.89,0:20:01.05,Default,nanas,0,0,0,,sama seperti kita.
Dialog: 0,0:20:15.70,0:20:18.04,Default,nanas,0,0,0,,Apakah dia bernapas?
Dialog: 0,0:20:24.08,0:20:25.71,Default,nanas,0,0,0,,Bernafas.
Dialog: 0,0:20:26.28,0:20:27.61,Default,nanas,0,0,0,,Tetapi jika dia sedang tidur,
Dialog: 0,0:20:27.61,0:20:30.52,Default,nanas,0,0,0,,kenapa dia begitu pendiam?
Dialog: 0,0:20:33.12,0:20:36.26,Default,nanas,0,0,0,,Apa itu? Apakah kamu terluka?
Dialog: 0,0:20:36.32,0:20:38.16,Default,nanas,0,0,0,,Mengapa?
Dialogue: 0,0:20:39.29,0:20:42.23,Default,nanas,0,0,0,,Kamu selalu menginginkan anak perempuan,
Dialog: 0,0:20:42.83,0:20:45.50,Default,nanas,0,0,0,,apakah kamu bahagia sekarang?
Dialogue: 0,0:20:47.67,0:20:50.14,Default,nanas,0,0,0,,Kamu kesakitan, kamu menderita.
Dialogue: 0,0:20:51.00,0:20:53.44,Default,nanas,0,0,0,,Kamu pasti semakin merindukan ibumu sekarang.
Dialog: 0,0:21:15.13,0:21:17.26,Default,nanas,0,0,0,,Kamu bisa menangani semuanya.
Dialog: 0,0:21:18.00,0:21:21.27,Default,nanas,0,0,0,,Segera sembuh,\Nagar penuh kekuatan dan energi lagi.
Dialog: 0,0:21:21.50,0:21:25.91,Default,nanas,0,0,0,,Kamu berjanji padaku untuk hidup\Nmengikuti aturan pembatasan sosial.
Dialog: 0,0:21:26.61,0:21:30.58,Default,nanas,0,0,0,,Aku akan memaafkanmu dan ucapan anehmu,
Dialog: 0,0:21:31.31,0:21:33.05,Default,nanas,0,0,0,,dan perilaku kurang ajar.
Dialog: 0,0:21:37.42,0:21:39.59,Default,nanas,0,0,0,,Bangun saja.
Dialogue: 0,0:21:59.47,0:22:01.17,Default,nanas,0,0,0,,Aku senang kamu belum pergi.
Dialog: 0,0:22:01.17,0:22:02.98,Default,nanas,0,0,0,,Apa itu?
Dialog: 0,0:22:02.98,0:22:05.75,Default,nanas,0,0,0,,Ratu dalam keadaan vegetatif.
Dialog: 0,0:22:06.15,0:22:08.58,Default,nanas,0,0,0,,Apakah dia sudah berhenti bernapas?
Dialog: 0,0:22:08.58,0:22:11.42,Default,nanas,0,0,0,,Untungnya, dokter mengembalikannya padanya.
Dialog: 0,0:22:12.29,0:22:15.79,Default,nanas,0,0,0,,Saya ingin kamu pergi ke Aula Seongwonjong.
Dialogue: 0,0:22:16.89,0:22:19.16,Default,nanas,0,0,0,,Seseorang ingin menyakiti ratu?
Dialog: 0,0:22:19.16,0:22:23.43,Default,nanas,0,0,0,,Kami akan menyerang \NIbu Suri dan Selir Cho.
Dialog: 0,0:22:30.34,0:22:34.01,Default,nanas,0,0,0,,Pergi, roh jahat!
Dialog: 0,0:22:34.01,0:22:37.68,Default,nanas,0,0,0,,Tuhan, dengarkan doaku!
Dialogue: 0,0:22:37.68,0:22:42.78,Default,nanas,0,0,0,,Usir roh jahat!
Dialog: 0,0:22:50.52,0:22:52.56,Default,nanas,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:22:53.46,0:22:56.73,Default,nanas,0,0,0,,Beraninya kamu menerobos masuk ke sini?\NDApakah kamu tidak tahu tempat apa ini?
Dialogue: 0,0:22:56.73,0:22:59.10,Default,nanas,0,0,0,,Kamu pikir bisa lolos begitu saja?
Dialog: 0,0:23:06.57,0:23:09.41,Default,nanas,0,0,0,,Saya akan menanyakan hal yang sama.\NDApakah menurut Anda ini merupakan ancaman bagi kehidupan?
Dialogue: 0,0:23:09.41,0:23:11.61,Default,nanas,0,0,0,,ratu yang bisa kamu ajak pergi?
Dialog: 0,0:23:13.88,0:23:15.45,Default,nanas,0,0,0,,-Apa itu?\N-Minggir!
Dialog: 0,0:23:15.45,0:23:18.15,Default,nanas,0,0,0,,-Apa yang kamu lakukan?\N-Cari semuanya!
Dialog: 0,0:23:19.85,0:23:21.49,Default,nanas,0,0,0,,Mengerikan sekali! Apa yang sedang kamu lakukan?
Dialog: 0,0:23:21.49,0:23:23.86,Default,nanas,0,0,0,,-Oh tidak!\N-Mengerikan sekali!
Dialog: 0,0:23:25.09,0:23:29.73,Default,nanas,0,0,0,,Aku berdoa untuk kehidupan yang damai di istana!
Dialog: 0,0:23:36.54,0:23:39.97,Default,nanas,0,0,0,,Tikus ini ditemukan di dekat Aula Daejojeon.
Dialog: 0,0:23:40.11,0:23:43.11,Default,nanas,0,0,0,,Saya tidak ada hubungannya dengan itu.
Dialogue: 0,0:23:43.98,0:23:46.85,Default,nanas,0,0,0,,Mau bilang dukun itu bertindak sendirian?
Dialogue: 0,0:23:47.98,0:23:52.89,Default,nanas,0,0,0,,Sepertinya dewamu belum memberitahumu kapan kamu akan mati.
Dialog: 0,0:23:55.39,0:23:57.52,Default,nanas,0,0,0,,Ini akan terjadi hari ini.
Dialog: 0,0:24:00.69,0:24:03.63,Default,nanas,0,0,0,,Tolong, lepaskan aku.
Dialog: 0,0:24:03.83,0:24:08.00,Default,nanas,0,0,0,,Saya hanya mengikuti perintah Ibu Suri.
Dialog: 0,0:24:08.03,0:24:09.57,Default,nanas,0,0,0,,Tutup mulutmu!
Dialog: 0,0:24:11.07,0:24:15.57,Default,nanas,0,0,0,,Aku akan melakukan ritual yang akan mematahkan kutukan.
Dialogue: 0,0:24:16.21,0:24:18.68,Default,nanas,0,0,0,,Ritual yang akan mematahkan kutukan?
Dialogue: 0,0:24:20.95,0:24:23.08,Default,nanas,0,0,0,,Kamu mengabdi pada Tuhan, bukan rajamu!
Dialogue: 0,0:24:23.08,0:24:25.35,Default,nanas,0,0,0,,Rupanya kamu memutuskan bahwa istana itu adalah sirkus!
Dialog: 0,0:24:25.35,0:24:26.89,Default,nanas,0,0,0,,Semuanya salah!
Dialog: 0,0:24:27.09,0:24:28.25,Default,nanas,0,0,0,,Terlambat.
Dialog: 0,0:24:28.25,0:24:30.76,Default,nanas,0,0,0,,Hidup ratu dalam bahaya.
Dialog: 0,0:24:32.56,0:24:33.86,Default,nanas,0,0,0,,Ini tidak mungkin.
Dialog: 0,0:24:33.86,0:24:35.73,Default,nanas,0,0,0,,Anda melakukan ritualnya.
Dialogue: 0,0:24:35.73,0:24:38.56,Default,nanas,0,0,0,,Dan sekarang kamu tidak percaya dengan konsekuensinya?
Dialog: 0,0:24:39.70,0:24:41.23,Default,nanas,0,0,0,,Anda telah ditipu oleh penipu!
Dialogue: 0,0:24:41.23,0:24:43.17,Default,pineapple,0,0,0,,Lihat ke mana arahnya!
Dialog: 0,0:24:43.77,0:24:46.47,Default,nanas,0,0,0,,Karenamu, reputasi seluruh dinasti telah berakhir,
Dialog: 0,0:24:46.47,0:24:48.34,Default,nanas,0,0,0,,kamu mencoba membunuh ratu,
Dialog: 0,0:24:48.34,0:24:49.61,Default,nanas,0,0,0,,dan juga melakukan kejahatan serius,
Dialog: 0,0:24:49.61,0:24:51.04,Default,nanas,0,0,0,,membingungkan kita semua!
Dialogue: 0,0:24:51.04,0:24:54.78,Default,nanas,0,0,0,,Bagaimana kamu akan membayar dosa-dosamu?
Dialog: 0,0:24:56.02,0:25:00.19,Default,nanas,0,0,0,,Bolehkah saya mengetahui kondisi ratu?
Dialogue: 0,0:25:02.12,0:25:04.92,Default,nanas,0,0,0,,Berpura-pura tidak tahu jawabannya?
Dialog: 0,0:25:04.92,0:25:07.43,Default,nanas,0,0,0,,Baiklah, akan kuceritakan apa yang terjadi pada ratu.
Dialog: 0,0:25:07.86,0:25:09.40,Default,nanas,0,0,0,,Dia diracuni.
Dialog: 0,0:25:10.00,0:25:13.90,Default,nanas,0,0,0,,Arsenik ditemukan di antara produk-produk di dapur.
Dialog: 0,0:25:16.34,0:25:17.80,Default,nanas,0,0,0,,Arsenik.
Dialog: 0,0:25:18.54,0:25:22.04,Default,nanas,0,0,0,,Saya yakin Anda tahu jenis racun apa ini.
Dialog: 0,0:25:31.78,0:25:33.39,Default,nanas,0,0,0,,Saya yakin,
Dialogue: 0,0:25:34.19,0:25:37.99,Default,nanas,0,0,0,,kamu tahu lebih banyak tentang dia daripada aku.
Dialogue: 0,0:25:40.03,0:25:42.19,Default,nanas,0,0,0,,Dan lagi-lagi kamu kembali ke masa lalu.
Dialog: 0,0:25:42.60,0:25:46.70,Default,nanas,0,0,0,,Sekali lagi kau menuduhku membunuh raja.
Dialogue: 0,0:25:49.74,0:25:53.91,Default,nanas,0,0,0,,Orang bodoh yang cepat melupakan masa lalu.
Dialog: 0,0:25:54.61,0:25:58.68,Default,nanas,0,0,0,,Tidak mengetahui betapa berharganya nyawa yang diselamatkan dengan mengorbankan nyawa anak Anda sendiri.
Dialogue: 0,0:26:03.78,0:26:05.75,Default,nanas,0,0,0,,Waktu itu kamu
Dialog: 0,0:26:05.75,0:26:08.12,Default,nanas,0,0,0,,mohon padaku.
Dialog: 0,0:26:08.49,0:26:10.92,Default,nanas,0,0,0,,Daripada menyelidiki kematian raja,
Dialog: 0,0:26:10.92,0:26:12.39,Default,nanas,0,0,0,,diracuni arsenik,
Dialog: 0,0:26:12.39,0:26:15.26,Default,nanas,0,0,0,,kamu memintaku untuk hidupmu.
Dialog: 0,0:26:17.66,0:26:19.40,Default,nanas,0,0,0,,Dan apa yang saya lihat?
Dialog: 0,0:26:19.40,0:26:23.27,Default,nanas,0,0,0,,Kau memancing selir tak bersalah Cho ke dalam ritual kotormu dan mencoba meracuni ratu!
Dialogue: 0,0:26:23.37,0:26:26.77,Default,nanas,0,0,0,,Apakah kamu tidak malu dengan mendiang raja?
Dialog: 0,0:26:27.74,0:26:29.84,Default,nanas,0,0,0,,Meskipun mengapa terkejut, jika Anda memiliki hati nurani,
Dialog: 0,0:26:29.84,0:26:32.48,Default,nanas,0,0,0,,kamu akan mati setelah dia.
Dialog: 0,0:26:33.71,0:26:37.02,Default,nanas,0,0,0,,Meminta maaf tidak ada gunanya.
Dialog: 0,0:26:38.78,0:26:41.32,Default,nanas,0,0,0,,Kamu tahu lebih dari siapa pun,
Dialog: 0,0:26:41.39,0:26:43.92,Default,nanas,0,0,0,,berapa banyak kesalahanku.
Dialogue: 0,0:26:43.92,0:26:46.56,Default,nanas,0,0,0,,Karena menurutmu begitu, aku tak punya pilihan.
Dialog: 0,0:26:46.56,0:26:47.96,Default,nanas,0,0,0,,Saya pesan
Dialog: 0,0:26:48.19,0:26:51.96,Default,nanas,0,0,0,,seperempat dukun dan nyonya istana Khan!
Dialog: 0,0:26:51.96,0:26:53.37,Default,nanas,0,0,0,,-Ya!\N-Ya!
Dialog: 0,0:26:55.10,0:27:00.57,Default,nanas,0,0,0,,Tolong, lepaskan aku!
Dialogue: 0,0:27:00.57,0:27:03.61,Default,nanas,0,0,0,,Lepaskan aku!
Dialog: 0,0:27:04.71,0:27:06.65,Default,nanas,0,0,0,,Adapun Ibu Suri...
Dialog: 0,0:27:08.21,0:27:09.65,Default,nanas,0,0,0,,Tolong!
Dialog: 0,0:27:11.72,0:27:13.32,Default,nanas,0,0,0,,Kasihanilah!
Dialog: 0,0:27:15.05,0:27:17.76,Default,nanas,0,0,0,,Tolong lepaskan aku!
Dialogue: 0,0:27:17.76,0:27:20.36,Default,nanas,0,0,0,,Doa tidak akan membantumu kali ini!
Dialogue: 0,0:27:20.36,0:27:24.30,Default,nanas,0,0,0,,Berapa lama aku harus menutup mata terhadap kelakuan burukmu?
Dialog: 0,0:27:24.30,0:27:27.23,Default,nanas,0,0,0,,Kali ini kamu tidak akan semudah itu!
Dialog: 0,0:27:27.53,0:27:29.07,Default,nanas,0,0,0,,Saya salah!
Dialog: 0,0:27:29.23,0:27:32.47,Default,nanas,0,0,0,,Tolong beri saya kesempatan
Dialog: 0,0:27:32.47,0:27:34.34,Default,nanas,0,0,0,,tebus!
Dialogue: 0,0:27:34.34,0:27:38.28,Default,nanas,0,0,0,,Bagaimana caramu menebus dosa besar seperti itu?
Dialog: 0,0:27:41.81,0:27:44.45,Default,nanas,0,0,0,,Anda harus yakin
Dialog: 0,0:27:45.72,0:27:47.19,Default,nanas,0,0,0,,bahwa raja
Dialog: 0,0:27:47.62,0:27:51.52,Default,nanas,0,0,0,,dikirim padamu dengan sepenuh hatiku.
Dialog: 0,0:27:52.06,0:27:54.96,Default,nanas,0,0,0,,Kamu yakin mendiang raja ada dalam kekuasaanmu,
Dialog: 0,0:27:54.96,0:27:58.46,Default,nanas,0,0,0,,oleh karena itu, mereka mengundurkan diri sebagai bupati.
Dialogue: 0,0:27:58.56,0:28:00.53,Default,nanas,0,0,0,,Atau kamu lupa?
Dialog: 0,0:28:10.38,0:28:12.98,Default,fe,0,0,0,,Apakah perkataan Ibu Suri mengganggumu?
Dialog: 0,0:28:18.95,0:28:21.15,Default,fe,0,0,0,,Untuk ketenangan pikiran Anda, saya akan memeriksanya,
Dialog: 0,0:28:22.09,0:28:24.32,Default,fe,0,0,0,,orang seperti apa Yang Mulia.
Dialog: 0,0:28:33.63,0:28:35.77,Default,fe,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:28:38.34,0:28:39.81,Default,fe,0,0,0,,Yang Mulia!
Dialogue: 0,0:28:47.91,0:28:49.28,Default,fe,0,0,0,,Ada apa ini?
Dialog: 0,0:28:49.28,0:28:51.45,Default,fe,0,0,0,,Saya menerjemahkan ratu.
Dialog: 0,0:28:52.92,0:28:54.42,Default,fe,0,0,0,,Mengangkut?
Dialog: 0,0:28:55.22,0:28:56.59,Default,fe,0,0,0,,Dimana?
Dialog: 0,0:28:57.12,0:28:59.02,Default,fe,0,0,0,,Saya tidak bisa memberi tahu Anda.
Dialogue: 0,0:29:11.20,0:29:14.51,Default,fe,0,0,0,,Tidak tahu kemana kamu akan membawa ratu?
Dialogue: 0,0:29:18.31,0:29:20.31,Default,fe,0,0,0,,Ada yang terjadi?
Dialog: 0,0:29:20.81,0:29:22.41,Default,fe,0,0,0,,Topeng kebohongan.
Dialog: 0,0:29:22.41,0:29:26.62,Default,fe,0,0,0,,Ratu dikutuk di Seongwonjong.
Dialog: 0,0:29:26.99,0:29:28.45,Default,fe,0,0,0,,Itu adalah Ibu Suri
Dialog: 0,0:29:28.99,0:29:31.09,Default,fe,0,0,0,,dan selir kerajaan Cho.
Dialog: 0,0:29:33.06,0:29:36.13,Default,fe,0,0,0,,Selir Cho tidak akan pernah melakukan itu.
Dialog: 0,0:29:36.70,0:29:40.10,Default,fe,0,0,0,,Apakah Anda ingin mengatakan bahwa penyebab penyakit ratu adalah kutukan?
Dialog: 0,0:29:40.97,0:29:43.77,Default,fe,0,0,0,,Arsenik ditemukan di dapur kerajaan.
Dialog: 0,0:29:48.64,0:29:51.84,Default,fe,0,0,0,,Sekarang penyelidikan akan dilakukan oleh Departemen Detektif.
Dialog: 0,0:29:52.08,0:29:54.91,Default,fe,0,0,0,,Dalam hal ini, saya punya pertanyaan untuk Anda.
Dialog: 0,0:29:56.18,0:29:58.48,Default,fe,0,0,0,,Apa dan di mana yang kamu lakukan dengan Pangeran Yeonpyeong
Dialog: 0,0:29:58.98,0:30:02.52,Default,fe,0,0,0,,malam setelah pernikahan kerajaan?
Dialog: 0,0:30:04.42,0:30:07.09,Default,fe,0,0,0,,Apa yang kamu izinkan?
Dialog: 0,0:30:07.23,0:30:09.73,Default,fe,0,0,0,,Tunjukkan wajah aslimu.
Dialogue: 0,0:30:09.73,0:30:12.16,Default,fe,0,0,0,,Rupanya ingatanmu melemah.
Dialog: 0,0:30:12.97,0:30:16.47,Default,fe,0,0,0,,Jika ini masalahnya, saya harus menginterogasi sang pangeran secara resmi.
Dialog: 0,0:30:21.11,0:30:23.01,Default,fe,0,0,0,,Tidak selangkah lebih maju!
Dialog: 0,0:30:26.88,0:30:28.31,Default,fe,0,0,0,,Yang Mulia.
Dialog: 0,0:30:39.22,0:30:41.66,Default,fe,0,0,0,,Tolong jangan bergerak.
Dialogue: 0,0:30:42.13,0:30:46.33,Default,fe,0,0,0,,Jika tidak, penjagamu harus\Ntidak menghormati dan menyakitimu.
Dialog: 0,0:31:03.68,0:31:05.25,Default,fe,0,0,0,,Stop.
Dialog: 0,0:31:06.35,0:31:07.92,Default,fe,0,0,0,,Ini perintah raja.
Dialog: 0,0:31:12.52,0:31:14.23,Default,fe,0,0,0,,Ini wanitaku.
Dialog: 0,0:31:16.40,0:31:19.60,Default,fe,0,0,0,,Sentuh dia bahkan dengan satu jari,
Dialogue: 0,0:31:20.10,0:31:22.77,Default,fe,0,0,0,,dan pedang ini akan menggorok lehermu.
Dialog: 0,0:31:30.21,0:31:34.11,Default,fe,0,0,0,,Aku tidak tahu kalau ratu begitu sayang padamu.
Dialogue: 0,0:31:34.45,0:31:36.85,Default,fe,0,0,0,,Kamu tidak tahu banyak hal.
Dialog: 0,0:31:38.02,0:31:40.29,Default,fe,0,0,0,,Izinkan saya memberi Anda pelajaran.
Dialog: 0,0:31:54.93,0:31:56.67,Default,fe,0,0,0,,Bisakah kamu melihatku?
Dialog: 0,0:32:01.37,0:32:04.51,Default,fe,0,0,0,,Saya adalah raja negeri ini!
Dialog: 0,0:32:07.31,0:32:09.85,Default,fe,0,0,0,,Prajurit siapakah kamu?
Dialogue: 0,0:32:11.42,0:32:13.22,Default,fe,0,0,0,,Penjagaku.
Dialog: 0,0:32:14.45,0:32:16.69,Default,fe,0,0,0,,Minggir.
Dialog: 0,0:32:29.64,0:32:31.14,Default,fe,0,0,0,,Yang Mulia.
Dialogue: 0,0:32:35.14,0:32:37.24,Default,fe,0,0,0,,Bukankah ini pengkhianatan?
Dialog: 0,0:32:38.08,0:32:39.98,Default,fe,0,0,0,,Hapus orang-orangmu,
Dialog: 0,0:32:40.21,0:32:43.42,Default,fe,0,0,0,,jika tidak ingin terjadi pertumpahan darah di Daejojon.
Dialogue: 0,0:32:43.48,0:32:46.62,Default,fe,0,0,0,,Jika kamu perintahkan, Pangeran Yeonpyeong
Dialogue: 0,0:32:46.62,0:32:49.99,Default,fe,0,0,0,,akan dengan senang hati mengotori tangannya.
Dialog: 0,0:32:51.09,0:32:53.56,Default,fe,0,0,0,,Saya hanya punya pertanyaan untuk Anda.
Dialogue: 0,0:32:53.76,0:32:55.93,Default,fe,0,0,0,,Kamu datang tepat waktu.
Dialog: 0,0:32:59.03,0:33:01.93,Default,fe,0,0,0,,Saya tidak memerintahkan penyelidikan dimulai.
Dialog: 0,0:33:03.84,0:33:08.17,Default,fe,0,0,0,,Kepada siapa Departemen Detektif sekarang melapor?
Dialog: 0,0:33:13.51,0:33:16.21,Default,fe,0,0,0,,Pertama saya akan mempelajari masalahnya sendiri.
Dialog: 0,0:33:18.05,0:33:21.05,Default,fe,0,0,0,,Dan kamu tidak bisa menuduh orang yang tidak bersalah lagi.
Dialog: 0,0:33:21.05,0:33:24.32,Default,fe,0,0,0,,Hanya ratu yang tidak bersalah di sini!
Dialog: 0,0:33:25.19,0:33:27.13,Default,fe,0,0,0,,Sudah kubilang.
Dialogue: 0,0:33:27.13,0:33:31.00,Default,fe,0,0,0,,Buat dia menderita,\Ndan hidupmu juga akan menjadi siksaan.
Dialogue: 0,0:33:32.53,0:33:37.10,Default,fe,0,0,0,,Saya bilang ini bukan ancaman.\NTetapi saya harus menarik kembali kata-kata saya.
Dialog: 0,0:33:37.10,0:33:38.74,Default,fe,0,0,0,,Beraninya kamu!
Dialogue: 0,0:33:49.28,0:33:53.02,Default,fe,0,0,0,,Wanita ini bukan lagi sepupumu.
Dialog: 0,0:33:54.19,0:33:56.22,Default,fe,0,0,0,,Kebahagiaannya,
Dialogue: 0,0:33:56.59,0:33:59.86,Default,fe,0,0,0,,kesedihan dan keselamatan kini menjadi perhatian
Dialog: 0,0:34:00.33,0:34:03.03,Default,fe,0,0,0,,bukan kepala Departemen Detektif - Anda,
Dialog: 0,0:34:03.56,0:34:05.23,Default,fe,0,0,0,,dan milikku.
Dialogue: 0,0:34:10.27,0:34:12.67,Default,fe,0,0,0,,Sang Ratu akan diangkut ke rumah keluarganya.
Dialog: 0,0:34:15.87,0:34:17.94,Default,fe,0,0,0,,Siapkan tandu.
Dialog: 0,0:34:18.44,0:34:19.85,Default,fe,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:34:31.39,0:34:32.86,Default,fe,0,0,0,,Meninggalkan.
Dialog: 0,0:34:43.77,0:34:45.30,Default,fe,0,0,0,,Saya terlambat.
Dialog: 0,0:34:45.30,0:34:46.74,Default,fe,0,0,0,,Kamu sangat
Dialogue: 0,0:34:47.74,0:34:49.84,Default,fe,0,0,0,,mencoba menyembunyikan sisi diri mereka yang ini.
Dialog: 0,0:35:12.03,0:35:13.80,Default,fe,0,0,0,,Awasi dia baik-baik.
Dialog: 0,0:35:14.03,0:35:15.43,Default,fe,0,0,0,,Ya.
Dialog: 0,0:35:15.60,0:35:17.77,Default,fe,0,0,0,,Maaf meninggalkanmu sendirian.
Dialog: 0,0:35:31.28,0:35:34.12,Default,fe,0,0,0,,Berjaga-jaga sampai kamu tiba.
Dialog: 0,0:35:34.25,0:35:36.79,Default,fe,0,0,0,,Dan berjaga sepanjang malam saat tiba.
Dialog: 0,0:35:36.79,0:35:38.29,Default,fe,0,0,0,,Ya!
Dialog: 0,0:35:53.61,0:35:57.78,Default,fe,0,0,0,,Aku yakin semua orang kecuali aku akan bisa menghembuskan napas di istana.
Dialogue: 0,0:35:58.18,0:36:01.55,Default,fe,0,0,0,,Dan mengapa ini membuatmu merasa lebih baik?
Dialogue: 0,0:36:04.22,0:36:07.85,Default,fe,0,0,0,,Tunggu, Kim Hwan seharusnya sudah ada di sini sekarang.
Dialog: 0,0:36:10.06,0:36:11.69,Default,fe,0,0,0,,Dan inilah iblis itu sendiri.
Dialog: 0,0:36:15.13,0:36:16.63,Default,fe,0,0,0,,Aku sudah khawatir kita tidak akan bertemu satu sama lain
Dialog: 0,0:36:16.63,0:36:18.50,Default,fe,0,0,0,,sebelum saya pergi...
Dialog: 0,0:36:20.00,0:36:21.50,Default,fe,0,0,0,,Dan siapa ini?
Dialog: 0,0:36:22.73,0:36:25.94,Default,fe,0,0,0,,Hari ini saya menemukan teman baik.
Dialog: 0,0:36:25.94,0:36:29.31,Default,fe,0,0,0,,Ini Lee Senban.
Dialog: 0,0:36:29.31,0:36:32.48,Default,fe,0,0,0,,Kita bertemu saat aku sedang mencari temanku Lee Senman.
Dialog: 0,0:36:33.11,0:36:37.05,Default,fe,0,0,0,,Kita ditakdirkan untuk menjadi teman.
Dialog: 0,0:36:37.62,0:36:39.75,Default,fe,0,0,0,,Aku ingin minum bersamamu
Dialog: 0,0:36:40.02,0:36:42.05,Default,fe,0,0,0,,dan bermain kartu.
Dialogue: 0,0:36:42.59,0:36:44.99,Default,fe,0,0,0,,Mau kedai disini atau gimana?
Dialogue: 0,0:36:45.22,0:36:48.46,Default,fe,0,0,0,,Minum dan main kartu? Orang seperti apa kamu?
Dialog: 0,0:36:48.46,0:36:51.50,Default,fe,0,0,0,,Apa? Itulah yang kami lakukan di sini.
Dialog: 0,0:36:51.50,0:36:53.83,Default,fe,0,0,0,,Hanya Anda yang bisa melakukan ini.
Dialog: 0,0:36:53.83,0:36:56.57,Default,fe,0,0,0,,Hanya untukmu, Kim Hwan.
Dialog: 0,0:36:57.97,0:37:00.51,Default,fe,0,0,0,,-Hanya untuk Anda.\N-Apa?
Dialog: 0,0:37:01.11,0:37:04.28,Default,fe,0,0,0,,Saya tidak menyangka ternyata begitu mudah untuk membuat Anda tertarik.
Dialogue: 0,0:37:04.41,0:37:07.75,Default,fe,0,0,0,,Apakah begitu mudah bagimu untuk berteman?\NDApakah kamu memiliki lebih banyak teman daripada yang kamu harapkan?
Dialog: 0,0:37:07.75,0:37:10.25,Default,fe,0,0,0,,Rupanya, aku adalah salah satu temanmu malam itu,
Dialog: 0,0:37:10.25,0:37:13.49,Default,fe,0,0,0,,salah satu dari banyak temanmu.
Dialogue: 0,0:37:46.35,0:37:49.59,Default,fe,0,0,0,,Nah, apakah kamu mengirim temanmu Lee Senban pulang?
Dialog: 0,0:37:49.59,0:37:51.32,Default,fe,0,0,0,,Anda dipanggil ke istana.
Dialogue: 0,0:37:52.19,0:37:53.63,Default,fe,0,0,0,,Apa?
Dialog: 0,0:37:59.30,0:38:01.33,Default,fe,0,0,0,,Mengapa tidak ada orang di sini hari ini?
Dialogue: 0,0:38:01.93,0:38:06.61,Default,fe,0,0,0,,Apakah semuanya sudah pergi melihat\N sesuatu yang menarik tanpa aku?
Dialog: 0,0:38:09.17,0:38:12.14,Default,fe,0,0,0,,Rasanya seperti semua orang meninggalkanku.
Dialog: 0,0:38:22.12,0:38:24.52,Default,fe,0,0,0,,Lee Senman, kamu masih hidup!
Dialog: 0,0:38:24.52,0:38:26.86,Default,fe,0,0,0,,Akhirnya bertemu!
Dialog: 0,0:38:31.30,0:38:34.93,Default,fe,0,0,0,,Saya salah, saya bingung membedakan Anda dengan seorang teman.
Dialog: 0,0:38:35.47,0:38:36.97,Default,fe,0,0,0,,Maaf.
Dialogue: 0,0:38:39.90,0:38:42.17,Default,fe,0,0,0,,Aku bukan temanmu.
Dialogue: 0,0:38:42.54,0:38:45.21,Default,fe,0,0,0,,Tapi aku punya sesuatu yang menarik.
Dialogue: 0,0:38:53.25,0:38:56.89,Default,fe,0,0,0,,Apa sajakah ini? Mereka terlihat aneh.
Dialog: 0,0:38:56.89,0:38:58.42,Default,fe,0,0,0,,Ini...
Dialog: 0,0:39:01.56,0:39:03.16,Default,fe,0,0,0,,Jam malam belum dicabut.
Dialog: 0,0:39:03.16,0:39:05.86,Default,fe,0,0,0,,-Kenapa kamu di jalan?\N-Sembunyikan.
Dialog: 0,0:39:08.00,0:39:09.50,Default,fe,0,0,0,,Anda...
Dialogue: 0,0:39:10.34,0:39:13.64,Default,fe,0,0,0,,Satu pukulan saja tidak cukup?
Dialogue: 0,0:39:13.64,0:39:15.71,Default,fe,0,0,0,,Apakah kamu menjual buku yang mengandung kata-kata kotor lagi?
Dialogue: 0,0:39:15.71,0:39:17.11,Default,fe,0,0,0,,Ketidaksenonohan?
Dialog: 0,0:39:19.58,0:39:22.91,Default,fe,0,0,0,,Dialah yang ingin menjualnya padaku.
Dialog: 0,0:39:23.65,0:39:25.28,Default,fe,0,0,0,,Anda dituduh melanggar moralitas.
Dialogue: 0,0:39:25.28,0:39:26.85,Default,fe,0,0,0,,Singkirkan mereka.
Dialog: 0,0:39:26.85,0:39:28.15,Default,fe,0,0,0,,Ya.
Dialogue: 0,0:39:28.15,0:39:30.92,Default,fe,0,0,0,,-Tunggu, aku...\N-Biarkan aku pergi.
Dialog: 0,0:39:30.92,0:39:32.66,Default,fe,0,0,0,,-Tunggu.\N-Berhenti.
Dialog: 0,0:39:32.66,0:39:34.53,Default,fe,0,0,0,,-Kamu bisa lebih lembut.\N-Inilah Herodes.
Dialog: 0,0:39:34.53,0:39:36.53,Default,fe,0,0,0,,Bisakah kamu lebih lembut, aku takut.
Dialog: 0,0:39:36.53,0:39:40.10,Default,fe,0,0,0,,Dia bertanya secara spesifik tentang malam setelah pernikahan.
Dialog: 0,0:39:40.40,0:39:42.67,Default,fe,0,0,0,,Jadi ratu menceritakan semuanya padanya.
Dialog: 0,0:39:42.67,0:39:46.00,Default,fe,0,0,0,,Rasanya aneh bagiku dia diam begitu lama.
Dialog: 0,0:39:46.00,0:39:48.64,Default,fe,0,0,0,,Jika dia tahu aku mencoba membunuhnya,
Dialog: 0,0:39:48.91,0:39:51.04,Default,fe,0,0,0,,satu interogasi tidak akan mengakhiri masalah ini.
Dialog: 0,0:39:51.18,0:39:54.65,Default,fe,0,0,0,,Pada hari pengangkatannya, dia membaca pepatah:
Dialog: 0,0:39:54.65,0:39:56.95,Default,fe,0,0,0,,"Menyelamatkan kekaisaran dari perselisihan,
Dialog: 0,0:39:57.12,0:39:59.28,Default,fe,0,0,0,,kekuatan menimbulkan ketakutan pada raja."
Dialog: 0,0:39:59.28,0:40:00.82,Default,fe,0,0,0,,Kalkun percaya diri.
Dialog: 0,0:40:00.82,0:40:03.42,Default,fe,0,0,0,,Dia mengancam akan mengambil tahtamu.
Dialogue: 0,0:40:03.42,0:40:07.16,Default,fe,0,0,0,,Kalau dia mau sejauh itu,\Nkamu seharusnya gigit lidahmu.
Dialog: 0,0:40:07.16,0:40:08.66,Default,fe,0,0,0,,Dan kemudian
Dialog: 0,0:40:08.66,0:40:10.93,Default,fe,0,0,0,,dia akan terus menekan Yang Mulia.
Dialog: 0,0:40:11.13,0:40:13.40,Default,fe,0,0,0,,Yang Mulia akan mengungkapkan dirinya dalam hal apa pun.
Dialog: 0,0:40:13.40,0:40:14.97,Default,fe,0,0,0,,Orang pintar.
Dialog: 0,0:40:15.90,0:40:18.40,Default,fe,0,0,0,,Dia pasti menemukan sesuatu.
Dialog: 0,0:40:18.60,0:40:21.21,Default,fe,0,0,0,,Saya akan mencari tahu seberapa banyak yang dia ketahui.
Dialog: 0,0:40:21.97,0:40:26.18,Default,fe,0,0,0,,Untuk saat ini kita hanya bisa berharap ratu akan bangun.
Dialog: 0,0:40:26.41,0:40:30.01,Default,fe,0,0,0,,Ini adalah hal terpenting bagi semua orang.
Dialog: 0,0:40:30.01,0:40:31.35,Default,fe,0,0,0,,Bagaimana dengan pelatihan?
Dialogue: 0,0:40:31.35,0:40:33.32,Default,fe,0,0,0,,Kim Byonin memburu kepala kita.
Dialog: 0,0:40:33.32,0:40:35.89,Default,fe,0,0,0,,Dibutuhkan lebih banyak usaha.
Dialog: 0,0:40:35.92,0:40:38.92,Default,fe,0,0,0,,Waktu tersisa sangat sedikit.
Dialog: 0,0:40:39.92,0:40:41.36,Default,fe,0,0,0,,Tuhan.
Dialog: 0,0:40:41.59,0:40:43.43,Default,fe,0,0,0,,Angkat lentera.
Dialog: 0,0:40:53.81,0:40:55.71,Default,fe,0,0,0,,Berapa jauh Yang Mulia?
Dialog: 0,0:40:55.77,0:40:56.81,Default,fe,0,0,0,,Dia dalam perjalanan ke sini.
Dialogue: 0,0:40:56.81,0:40:59.31,Default,fe,0,0,0,,Apakah kamu yakin dia tidak di ambang kematian?
Dialog: 0,0:40:59.88,0:41:01.68,Default,fe,0,0,0,,Ya, untungnya, semuanya berhasil.
Dialog: 0,0:41:01.68,0:41:03.18,Default,fe,0,0,0,,Ya Tuhan.
Dialog: 0,0:41:03.75,0:41:05.72,Default,fe,0,0,0,,Bagaimana ini bisa terjadi?
Dialog: 0,0:41:06.15,0:41:08.99,Default,fe,0,0,0,,Keracunan? Bagaimana dia bisa diracuni?
Dialog: 0,0:41:09.12,0:41:12.92,Default,fe,0,0,0,,Saya sudah memanggil dokter terbaik Joseon.
Dialog: 0,0:41:13.59,0:41:15.06,Default,fe,0,0,0,,Tuhan.
Dialogue: 0,0:41:15.39,0:41:18.20,Default,fe,0,0,0,,Bagaimanapun,\N kamu harus tetap tenang.
Dialog: 0,0:41:19.76,0:41:23.40,Default,fe,0,0,0,,Kamu harus tenang dan berpikir rasional.
Dialog: 0,0:41:24.67,0:41:26.07,Default,fe,0,0,0,,Apa ini.
Dialog: 0,0:41:26.54,0:41:28.71,Default,fe,0,0,0,,Tuhan.
Dialog: 0,0:41:29.37,0:41:32.88,Default,fe,0,0,0,,Ya Tuhan.
Dialogue: 0,0:41:33.28,0:41:35.05,Default,fe,0,0,0,,Betapa kejamnya.
Dialog: 0,0:41:35.08,0:41:37.12,Default,fe,0,0,0,,Suami Ibu Suri diracun.
Dialogue: 0,0:41:37.12,0:41:38.88,Default,fe,0,0,0,,Bagaimana kamu bisa menyalahkannya?
Dialog: 0,0:41:38.88,0:41:40.22,Default,fe,0,0,0,,Situasinya sulit,
Dialog: 0,0:41:40.22,0:41:43.56,Default,fe,0,0,0,,Hwajin, menjauhlah dari Ibu Suri.
Dialog: 0,0:41:43.69,0:41:45.46,Default,fe,0,0,0,,Ini terjadi pada hari kunjunganku.
Dialog: 0,0:41:45.46,0:41:47.33,Default,fe,0,0,0,,Saya memberi mereka kesempatan.
Dialogue: 0,0:41:47.33,0:41:49.13,Default,fe,0,0,0,,Jangan menyalahkan diri sendiri mengenai hal ini.
Dialogue: 0,0:41:49.33,0:41:51.56,Default,fe,0,0,0,,Mereka tetap akan bergerak.
Dialog: 0,0:41:52.10,0:41:53.53,Default,fe,0,0,0,,Tapi
Dialogue: 0,0:41:54.37,0:41:57.50,Default,fe,0,0,0,,kenapa kamu memindahkan ratu kembali ke rumah ayahnya?
Dialogue: 0,0:41:57.50,0:41:59.84,Default,fe,0,0,0,,Dia pasti kesepian di istana.
Dialog: 0,0:41:59.87,0:42:02.24,Default,fe,0,0,0,,Dalam mimpi dia menelepon ibunya.
Dialog: 0,0:42:03.34,0:42:06.78,Default,fe,0,0,0,,Tetapi Yang Mulia memimpikan hal ini.
Dialogue: 0,0:42:07.71,0:42:09.11,Default,fe,0,0,0,,Tentang apa?
Dialog: 0,0:42:09.31,0:42:11.12,Default,fe,0,0,0,,Ada yang salah?
Dialog: 0,0:42:13.55,0:42:16.72,Default,fe,0,0,0,,-Tidak.\N-Jangan khawatir.
Dialog: 0,0:42:16.75,0:42:19.99,Default,fe,0,0,0,,Saya akan mengirimkan saudara saya segera setelah semuanya diputuskan.
Dialog: 0,0:42:26.16,0:42:27.60,Default,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:42:34.84,0:42:36.31,Default,Spillik,0,0,0,,Saya mohon.
Dialog: 0,0:42:36.54,0:42:38.91,Default,Spillik,0,0,0,,Maukah kamu melawan kehendak raja?
Dialog: 0,0:42:44.78,0:42:46.48,Default,Spillik,0,0,0,,Tolong jangan sampai terluka.
Dialog: 0,0:42:48.89,0:42:50.29,Default,Spillik,0,0,0,,Oke.
Dialog: 0,0:43:05.44,0:43:07.34,Default,Spillik,0,0,0,,Sekarang kamu sudah di sini,
Dialog: 0,0:43:08.24,0:43:10.81,Default,Spillik,0,0,0,,seperti kita kembali ke masa lalu.
Dialog: 0,0:43:13.28,0:43:14.71,Default,Spillik,0,0,0,,Benin.
Dialog: 0,0:43:18.55,0:43:22.15,Default,Spillik,0,0,0,,Hanya kamu yang mencariku saat aku melarikan diri.
Dialog: 0,0:43:22.65,0:43:24.89,Default,Spillik,0,0,0,,Aku tidak akan membiarkanmu kehilangan dirimu sendiri.
Dialog: 0,0:43:26.96,0:43:28.99,Default,Spillik,0,0,0,,Dan aku tidak akan pernah lupa.
Dialog: 0,0:43:32.66,0:43:34.90,Default,Spillik,0,0,0,,Kalau saja aku bisa kembali ke hari itu.
Dialog: 0,0:43:41.24,0:43:43.07,Default,Spillik,0,0,0,,Ini wanitaku.
Dialog: 0,0:43:49.18,0:43:51.45,Default,Spillie,0,0,0,,Kamu seharusnya menjadi milikku.
Dialog: 0,0:43:54.05,0:43:56.32,Default,Spillik,0,0,0,,Dan aku milikmu.
Dialogue: 0,0:44:44.34,0:44:46.17,Default,Spillik,0,0,0,,Apakah kamu tahu siapa aku?
Dialog: 0,0:44:46.17,0:44:49.44,Default,Spillik,0,0,0,,Kim Hwan yang sama yang akan menjadi pejabat
Dialog: 0,0:44:49.61,0:44:50.88,Default,Spilyk,0,0,0,,Departemen Detektif.
Dialog: 0,0:44:50.88,0:44:52.71,Default,Spillik,0,0,0,,Tidak cukup apa yang dia lakukan,
Dialog: 0,0:44:52.71,0:44:54.25,Default,Spikyulka,0,0,0,,memutuskan untuk menawar janji temu selanjutnya?
Dialog: 0,0:44:54.25,0:44:55.31,Default,Spillik,0,0,0,,Tawar-menawar?
Dialog: 0,0:44:55.31,0:44:57.42,Default,Spillik,0,0,0,,Saya orang yang saleh.
Dialog: 0,0:44:58.28,0:45:00.79,Default,Spillik,0,0,0,,Benar-benar berdasarkan wajah dan bakat
Dialogue: 0,0:45:00.79,0:45:04.09,Default,Spikyulka,0,0,0,,tidakkah kamu lihat kalau aku murid Sungkyunkwan?
Dialog: 0,0:45:04.12,0:45:07.49,Default,Spillit,0,0,0,,Saya tidak akan menderita ketidakadilan...
Dialog: 0,0:45:07.49,0:45:09.06,Default,Spillik,0,0,0,,Diam di sini.
Dialogue: 0,0:45:09.69,0:45:11.50,Default,Spillik,0,0,0,,Lihat, kamu pria yang banyak bicara.
Dialog: 0,0:45:11.50,0:45:14.43,Default,Spillik,0,0,0,,Beraninya kamu? Jika kamu segera melepaskanku,
Dialogue: 0,0:45:14.43,0:45:17.04,Default,Spiky,0,0,0,,Aku akan memberimu lima nyan perak.
Dialogue: 0,0:45:17.10,0:45:18.57,Default,Spillik,0,0,0,,Atau bisa juga
Dialog: 0,0:45:20.91,0:45:22.57,Default,Spillik,0,0,0,,berikan padaku?
Dialog: 0,0:45:23.91,0:45:27.15,Default,Spillik,0,0,0,,Sebagai imbalannya, kami akan memberimu pelajaran yang sangat berharga.
Dialog: 0,0:45:36.19,0:45:38.19,Default,Spillik,0,0,0,,Segera setelah Anda mendengar apa yang saya katakan,
Dialog: 0,0:45:40.83,0:45:44.00,Default,Spillik,0,0,0,,kamu tidak akan lagi menjadi dirimu yang dulu.
Dialog: 0,0:45:45.56,0:45:48.97,Default,Spillik,0,0,0,,Kamu akan menjadi benar-benar dewasa.
Dialog: 0,0:46:04.35,0:46:07.89,Default,Spillik,0,0,0,,-Apakah kamu akan pergi ke istana? \N-Ya. Apakah kamu baru saja pulang ke rumah?
Dialog: 0,0:46:07.92,0:46:10.19,Default,Spillik,0,0,0,,Aku mendengar apa yang terjadi antara kamu dan raja kemarin.
Dialog: 0,0:46:10.19,0:46:12.52,Default,Spillik,0,0,0,,Ya, saya mengerti.
Dialog: 0,0:46:12.52,0:46:14.69,Default,Spillik,0,0,0,,Meskipun dia tidak tampak hebat,
Dialogue: 0,0:46:14.69,0:46:18.03,Default,Spillik,0,0,0,,kalau kamu terlalu menekannya, dia akan menjadi satu.
Dialogue: 0,0:46:18.03,0:46:20.36,Default,Spillik,0,0,0,,Mengapa kamu bertindak tanpa perintahku?
Dialog: 0,0:46:20.36,0:46:21.80,Default,Spillik,0,0,0,,Ini karena...
Dialogue: 0,0:46:22.40,0:46:24.07,Default,Spillit,0,0,0,,Matanya.
Dialog: 0,0:46:24.37,0:46:28.14,Default,Spillik,0,0,0,,Dia memiliki mata seorang pria yang menyembunyikan aspirasinya.
Dialog: 0,0:46:31.21,0:46:34.78,Default,Spillit,0,0,0,,Aku tidak ingin ratu janda khawatir,
Dialog: 0,0:46:35.15,0:46:37.01,Default,Spillik,0,0,0,,jadi dia bertindak gegabah.
Dialog: 0,0:46:38.72,0:46:40.38,Default,Spillit,0,0,0,,Hati-hati.
Dialog: 0,0:46:41.99,0:46:43.39,Default,Spillit,0,0,0,,Ayah.
Dialogue: 0,0:46:45.96,0:46:50.03,Default,Spillik,0,0,0,,Apakah kamu mengetahui kabar ratu?
Dialog: 0,0:46:50.63,0:46:53.06,Default,Spilyk,0,0,0,,Saya dengar krisis sudah berakhir.
Dialog: 0,0:46:53.06,0:46:55.87,Default,Spillie,0,0,0,,Dia belum sadar.
Dialog: 0,0:46:56.07,0:46:58.90,Default,Spillie,0,0,0,,Tetapi akan segera membaik.
Dialog: 0,0:47:00.34,0:47:02.14,Default,Spillik,0,0,0,,Apakah Anda ingin mengatakan hal lain?
Dialog: 0,0:47:02.37,0:47:04.64,Default,Spillit,0,0,0,,Aku mendengar ratu janda
Dialog: 0,0:47:04.64,0:47:06.34,Default,Spillik,0,0,0,,menyebutkan deposisi ratu.
Dialog: 0,0:47:06.34,0:47:08.61,Default,Spillik,0,0,0,,Dia mengatakan ini dengan marah.
Dialog: 0,0:47:08.61,0:47:10.18,Default,Spillik,0,0,0,,Sebenarnya, dia tidak menginginkan ini.
Dialog: 0,0:47:10.18,0:47:12.48,Default,Spillik,0,0,0,,Anda tidak perlu khawatir.
Dialog: 0,0:47:13.05,0:47:16.89,Default,Spillik,0,0,0,,Saya tahu betul betapa Anda peduli pada ratu.
Dialog: 0,0:47:16.89,0:47:18.52,Default,Spillik,0,0,0,,Mungkin tidak sebanyak kamu,
Dialog: 0,0:47:18.52,0:47:21.93,Default,Spillik,0,0,0,,tapi aku juga menjaganya dengan baik, jadi jangan khawatir.
Dialog: 0,0:47:22.93,0:47:24.33,Default,Spillik,0,0,0,,Ya.
Dialog: 0,0:47:24.60,0:47:26.23,Default,Spillik,0,0,0,,Sampai jumpa di istana.
Dialog: 0,0:47:46.22,0:47:50.09,Default,Spillik,0,0,0,,Ayah ratu mengirim hadiah lagi.
Dialog: 0,0:47:50.89,0:47:53.22,Default,Spillik,0,0,0,,Bagaimana kabar ratu?
Dialog: 0,0:47:53.66,0:47:55.49,Default,Spillit,0,0,0,,Krisis sudah berakhir,
Dialog: 0,0:47:55.49,0:47:58.23,Default,Spillik,0,0,0,,tapi dia perlu istirahat untuk saat ini,\Njadi dia kembali ke rumah.
Dialog: 0,0:47:58.23,0:48:00.60,Default,Spillie,0,0,0,,Dia sakit terus-menerus.
Dialog: 0,0:48:00.90,0:48:02.97,Default,Spillik,0,0,0,,Dia belum pernah pulih dari kejadian itu.
Dialogue: 0,0:48:02.97,0:48:04.67,Default,Spillik,0,0,0,,Saya harus menyebutnya apa?
Dialog: 0,0:48:04.97,0:48:06.90,Default,Spillie,0,0,0,,Dia rusak.
Dialog: 0,0:48:07.21,0:48:09.81,Default,Spillie,0,0,0,,Aku mencoba membuatnya menjadi lebih kuat,
Dialog: 0,0:48:09.81,0:48:13.51,Default,Spillie,0,0,0,,tapi dia tiba-tiba menjadi sayuran. \NSDia terlalu lemah.
Dialogue: 0,0:48:13.85,0:48:16.78,Default,Spillit,0,0,0,,Bagaimana jika Selir Cho melahirkan seorang pangeran terlebih dahulu?
Dialog: 0,0:48:16.78,0:48:18.82,Default,Spillik,0,0,0,,Maka Ibu Suri akan memberontak lagi.
Dialog: 0,0:48:18.82,0:48:20.45,Default,Spillik,0,0,0,,Jangan khawatir.
Dialog: 0,0:48:20.45,0:48:23.22,Default,Spilyk,0,0,0,,Saya sudah menyiapkan rencana cadangan.
Dialog: 0,0:48:23.45,0:48:24.72,Default,Spillit,0,0,0,,Rencana cadangan?
Dialog: 0,0:48:24.72,0:48:27.36,Default,Spillik,0,0,0,,Saya memastikan bahwa dua lainnya,\Nyang kami pertimbangkan untuk peran ratu,
Dialog: 0,0:48:27.36,0:48:29.79,Default,Spilyk,0,0,0,,mereka tidak menikahi siapa pun.
Dialog: 0,0:48:29.79,0:48:33.03,Default,Spillik,0,0,0,,Kamu adalah saudara yang dapat diandalkan.
Dialog: 0,0:48:34.40,0:48:39.10,Default,Spillik,0,0,0,,Saya dengar kemarin Benin menuduh raja.
Dialog: 0,0:48:40.54,0:48:44.11,Default,Spillik,0,0,0,,Kemarin semua orang bertingkah aneh terhadap raja.
Dialog: 0,0:48:44.41,0:48:48.11,Default,Spillik,0,0,0,,Seolah-olah raja menyembunyikan sesuatu.
Dialogue: 0,0:48:50.65,0:48:52.92,Default,Spillik,0,0,0,,Raja ini berbeda dengan almarhum.
Dialog: 0,0:48:52.92,0:48:55.35,Default,Spillik,0,0,0,,Begitulah seharusnya. Anda memilihnya sendiri.
Dialog: 0,0:48:55.35,0:48:58.99,Default,Spillik,0,0,0,,Saya mengangkat raja ke tempatnya hanya karena satu alasan.
Dialog: 0,0:48:58.99,0:49:02.56,Default,Spillik,0,0,0,,Agar Anda tidak perlu membuat keputusan yang menyakitkan,
Dialog: 0,0:49:02.56,0:49:04.90,Default,Spillik,0,0,0,,seperti pada masa mendiang raja.
Dialogue: 0,0:49:04.93,0:49:06.36,Default,Spillik,0,0,0,,Itu benar.
Dialog: 0,0:49:07.23,0:49:09.73,Default,Spillik,0,0,0,,Cukup menyakitkan.
Dialog: 0,0:49:09.90,0:49:12.24,Default,Spillik,0,0,0,,Aku membela negara dengan mengorbankan darah cucuku
Dialog: 0,0:49:12.24,0:49:14.07,Default,Spillie,0,0,0,,dalam pelukanku.
Dialog: 0,0:49:14.47,0:49:16.07,Default,Spillik,0,0,0,,Dan jika ada yang berani menghancurkannya,
Dialog: 0,0:49:16.07,0:49:19.44,Default,Spillik,0,0,0,,dia tidak akan dimaafkan.
Dialog: 0,0:49:21.45,0:49:25.82,Default,Spilyk,0,0,0,,Departemen detektif.
Dialog: 0,0:50:13.30,0:50:15.70,Default,Spillik,0,0,0,,-Pertama, Anda harus.\N-Tidak, Anda terlebih dahulu.
Dialog: 0,0:50:15.70,0:50:18.44,Default,Spillik,0,0,0,,Tidak, kamu yang pertama.
Dialog: 0,0:50:47.47,0:50:49.17,Default,Spillik,0,0,0,,Di mana saya?
Dialog: 0,0:50:49.70,0:50:52.60,Default,Spillik,0,0,0,,Di Joseon atau di Korea?
Dialog: 0,0:50:58.94,0:51:00.58,Default,Spillik,0,0,0,,Di Joseon.
Dialog: 0,0:51:02.88,0:51:05.12,Default,Spillik,0,0,0,,Saya tidak bisa mengatakan bahwa saya senang, karena saya kehilangan mereka,
Dialog: 0,0:51:05.12,0:51:08.42,Default,Spillik,0,0,0,,tapi saya tidak bisa mengatakan bahwa saya sedih, karena saya senang bisa memeriksanya.
Dialogue: 0,0:51:09.55,0:51:13.02,Default,Spillik,0,0,0,,Kenapa semuanya berkilau sekali di sini?
Dialog: 0,0:51:32.64,0:51:34.55,Default,Spillit,0,0,0,,Emas Kekaisaran.
Dialog: 0,0:51:34.68,0:51:36.45,Default,Spillie,0,0,0,,Bertinta?
Dialog: 0,0:51:39.75,0:51:41.22,Default,Spillik,0,0,0,,Yang Mulia!
Dialogue: 0,0:51:43.82,0:51:46.79,Default,Spillik,0,0,0,,Sepertinya aku berada di tempat lain.
Dialog: 0,0:51:47.76,0:51:50.53,Default,Spillik,0,0,0,,Akhirnya, kamu bangun!
Dialog: 0,0:51:51.00,0:51:52.63,Default,Spillik,0,0,0,,Ini seperti deja vu.
Dialogue: 0,0:51:52.63,0:51:54.87,Default,Spillik,0,0,0,,Ayo jalan tanpa repot.
Dialog: 0,0:51:56.53,0:51:59.24,Default,Spillik,0,0,0,,Tapi kamu hampir mati.
Dialog: 0,0:51:59.24,0:52:01.51,Default,Spillik,0,0,0,,Mereka bahkan berhenti bernapas sepenuhnya.
Dialogue: 0,0:52:02.97,0:52:04.71,Default,Spillie,0,0,0,,Jangan menangis.
Dialog: 0,0:52:05.64,0:52:07.14,Default,Spillie,0,0,0,,Berhenti bernapas?
Dialog: 0,0:52:07.38,0:52:09.68,Default,Spillit,0,0,0,,Menurut tabib kerajaan,\Nkamu tanpa sayur.
Dialog: 0,0:52:09.68,0:52:11.98,Default,Spillit,0,0,0,,Seolah-olah kamu telah mati.
Dialog: 0,0:52:12.92,0:52:15.09,Default,Spillik,0,0,0,,Jadi di sini juga.
Dialogue: 0,0:52:15.49,0:52:17.42,Default,Spillik,0,0,0,,Tapi dimana aku?
Dialog: 0,0:52:18.52,0:52:20.69,Default,Spillik,0,0,0,,Kamu sampai di rumah.
Dialog: 0,0:52:21.53,0:52:22.76,Default,Spillik,0,0,0,,Jadi,
Dialogue: 0,0:52:22.76,0:52:24.66,Default,Spillik,0,0,0,,Aku tidak bisa menghindari pertemuan
Dialog: 0,0:52:24.66,0:52:27.06,Default,Spillik,0,0,0,,dengan seseorang yang tidak boleh kamu temui.
Dialog: 0,0:52:27.06,0:52:29.93,Default,Spillik,0,0,0,,-Apa? \N-Jadi, tidak ada kesulitan,
Dialog: 0,0:52:29.93,0:52:32.34,Default,Spikyulka,0,0,0,,tapi ada seseorang yang membuatku merasa tidak nyaman.
Dialog: 0,0:52:32.84,0:52:35.51,Default,Spillik,0,0,0,,Orang yang pada dasarnya adalah musuhku yang sebenarnya -
Dialog: 0,0:52:36.61,0:52:38.51,Default,Spillik,0,0,0,,ayah dari seorang wanita.
Dialog: 0,0:52:38.71,0:52:40.18,Default,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:52:40.71,0:52:43.58,Default,Spillik,0,0,0,,-Sungguh bahagia, ratu. \N-Tuhan.
Dialog: 0,0:52:43.58,0:52:47.69,Default,Spillik,0,0,0,,Yang Mulia, apakah Anda baik-baik saja? Bisakah kamu bernapas?
Dialog: 0,0:52:47.69,0:52:50.29,Default,Spillik,0,0,0,,Pesan apa? Haruskah aku memanggil tabib kerajaan?
Dialog: 0,0:52:50.29,0:52:53.06,Default,Spillik,0,0,0,,Sepertinya kamu akan kehilangan kesadaran.
Dialog: 0,0:52:53.19,0:52:55.69,Default,Spillie,0,0,0,,Ini, minum.
Dialog: 0,0:52:55.69,0:52:57.23,Default,Spillik,0,0,0,,Oke.
Dialogue: 0,0:52:58.06,0:53:00.53,Default,Spillik,0,0,0,,Ini ramuan untuk memulihkan energi yin.
Dialog: 0,0:53:00.53,0:53:02.10,Default,Spillik,0,0,0,,Luar Biasa.
Dialogue: 0,0:53:02.30,0:53:05.20,Default,Spilyk,0,0,0,,Kenapa kamu berkeringat sekali?
Dialog: 0,0:53:07.84,0:53:09.34,Default,Spillik,0,0,0,,Astaga.
Dialogue: 0,0:53:09.34,0:53:12.28,Default,Spillik,0,0,0,,Aku sangat khawatir.
Dialog: 0,0:53:12.28,0:53:15.08,Default,Spillik,0,0,0,,Saya tidak tidur tadi malam.
Dialog: 0,0:53:15.08,0:53:16.35,Default,Spillit,0,0,0,,Kehilangan nafsu makanku sepenuhnya
Dialog: 0,0:53:16.35,0:53:18.52,Default,Spilyk,0,0,0,,dan saya belum makan apa pun selama dua hari.
Dialogue: 0,0:53:18.52,0:53:22.12,Default,Spillik,0,0,0,,Setiap aku bangun, kepalaku pusing.
Dialog: 0,0:53:22.39,0:53:24.29,Default,Spillik,0,0,0,,-Anda pasti sangat terkejut. \N-Ya.
Dialogue: 0,0:53:24.72,0:53:27.19,Default,Spillit,0,0,0,,Akar penyakit adalah kekhawatiran dan masalah,
Dialog: 0,0:53:27.19,0:53:28.99,Default,Spillik,0,0,0,,kamu perlu istirahat dan menenangkan diri.
Dialog: 0,0:53:28.99,0:53:31.96,Default,Spillik,0,0,0,,Ya, tentu saja, saya akan melakukannya.
Dialog: 0,0:53:31.96,0:53:34.33,Default,Spillik,0,0,0,,Saya harap Anda segera merasa lebih baik. Sudah waktunya bagi saya untuk pergi.
Dialog: 0,0:53:34.33,0:53:36.23,Default,Spillit,0,0,0,,Yang Mulia.
Dialog: 0,0:53:36.23,0:53:37.84,Default,Spillik,0,0,0,,Mau kemana?
Dialog: 0,0:53:38.57,0:53:39.74,Default,Spilyk,0,0,0,,Orang Suci.
Dialog: 0,0:53:39.74,0:53:42.71,Default,Spillik,0,0,0,,Saya tidak bisa melakukan itu. Saya harus menunjukkan rasa hormat.
Dialog: 0,0:53:42.94,0:53:44.41,Default,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:53:44.41,0:53:46.84,Default,Spillik,0,0,0,,Wow. Apa yang sedang kamu lakukan? Kamu membuatku malu.
Dialog: 0,0:53:46.84,0:53:48.51,Default,Spillik,0,0,0,,Tidak, tidak, saya tidak berani.
Dialog: 0,0:53:48.51,0:53:50.92,Default,Spillik,0,0,0,,Terimalah busurku, Yang Mulia.
Dialog: 0,0:53:52.92,0:53:54.39,Default,Spillit,0,0,0,,Tidak!
Dialog: 0,0:53:56.65,0:53:57.96,Default,Spillik,0,0,0,,Lihat.
Dialog: 0,0:53:57.96,0:53:59.52,Default,Spillik,0,0,0,,Bagaimana bisa?
Dialog: 0,0:54:00.19,0:54:03.03,Default,Spillik,0,0,0,,Biarkan aku bersujud padamu sekali lagi.
Dialog: 0,0:54:03.06,0:54:04.60,Default,Spillit,0,0,0,,Ayah.
Dialogue: 0,0:54:04.63,0:54:07.43,Default,Spillik,0,0,0,,Menjadi ratu di Joseon sangat tidak nyaman.
Dialog: 0,0:54:07.43,0:54:09.33,Default,Spillik,0,0,0,,Biarkan aku, selagi aku di sini,
Dialog: 0,0:54:09.33,0:54:13.24,Default,Spillik,0,0,0,,untuk menjadi putrimu Soyeon.
Dialog: 0,0:54:16.21,0:54:19.84,Default,akhir jarak tembak,0,0,0,,Semakin tinggi posisinya, semakin kuat kesepiannya.
Dialog: 0,0:54:20.71,0:54:22.21,Default,,0,0,0,,Oke, saya mengerti.
Dialog: 0,0:54:22.61,0:54:24.55,Default,,0,0,0,,Saat kamu di sini,
Dialog: 0,0:54:24.55,0:54:26.62,Default,,0,0,0,,Saya akan melakukan ini,
Dialog: 0,0:54:26.62,0:54:29.82,Default,,0,0,0,,sesuai keinginan.
Dialog: 0,0:54:30.52,0:54:32.29,Default,,0,0,0,,Oke, sekarang duduk.
Dialog: 0,0:54:32.56,0:54:35.36,Default,,0,0,0,,Oke. Terima kasih.
Dialog: 0,0:54:36.29,0:54:38.13,Default,,0,0,0,,Hati-hati.
Dialogue: 0,0:54:44.87,0:54:48.74,Default,,0,0,0,,Tidak peduli seberapa banyak kamu mendekorasi ruangan,\N ruangan tetap tampak kosong.
Dialog: 0,0:54:49.11,0:54:53.51,Default,,0,0,0,,Tapi begitu kamu kembali, ruangan mulai bersinar.
Dialog: 0,0:54:55.15,0:54:56.58,Default,,0,0,0,,Ya.
Dialog: 0,0:54:56.68,0:55:00.99,Default,,0,0,0,,Ruangannya sangat terang hingga membutakan matamu.
Dialog: 0,0:55:01.89,0:55:03.69,Default,,0,0,0,,Saya menyukainya.
Dialogue: 0,0:55:06.52,0:55:10.03,Default,,0,0,0,,Jangan khawatir, tidak ada yang akan merusak reputasimu.
Dialog: 0,0:55:10.09,0:55:12.70,Default,,0,0,0,,Saya mengurus semuanya.
Dialog: 0,0:55:12.80,0:55:15.93,Default,,0,0,0,,Saya sudah mempersiapkan semua yang terbaik.
Dialog: 0,0:55:54.84,0:55:56.47,Default,,0,0,0,,Selanjutnya, lanjutkan.
Dialog: 0,0:55:57.17,0:55:59.64,Default,,0,0,0,,Saya tidak menemui satu dokter pun di sana,
Dialogue: 0,0:55:59.64,0:56:01.55,Default,,0,0,0,,dan ada banyak orang di sini?
Dialog: 0,0:56:09.25,0:56:11.29,Default,,0,0,0,,Apakah ada orang lain yang harus datang?
Dialog: 0,0:56:11.29,0:56:14.33,Default,,0,0,0,,-Semacam liburan?\N-Ini sarapan.
Dialog: 0,0:56:18.10,0:56:19.56,Default,,0,0,0,,Untuk memulihkan kekuatan
Dialog: 0,0:56:19.56,0:56:22.20,Default,,0,0,0,,ayahmu menyiapkan sup kura-kura untukmu.
Dialog: 0,0:56:22.20,0:56:23.60,Default,,0,0,0,,Di Sini.
Dialog: 0,0:56:26.17,0:56:28.27,Default,,0,0,0,,Kura-kura sejak pagi?
Dialog: 0,0:56:30.84,0:56:32.61,Default,,0,0,0,,Hati-hati.
Dialog: 0,0:56:35.08,0:56:37.78,Default,,0,0,0,,Mengapa? Apa yang ada disana?
Dialog: 0,0:56:38.35,0:56:40.15,Default,,0,0,0,,
Dialogue: 0,0:56:47.93,0:56:51.16,Default,,0,0,0,,Suatu kehormatan bisa melayani Anda, Yang Mulia.
Dialogue: 0,0:56:56.60,0:56:59.80,Default,,0,0,0,,Dia ahli kecantikan terbaik di Joseon.
Dialog: 0,0:57:00.07,0:57:02.94,Default,,0,0,0,,Saya cantik alami. Saya tidak membutuhkan bantuannya.
Dialog: 0,0:57:05.11,0:57:06.71,Default,,0,0,0,,Silakan.
Dialog: 0,0:57:16.75,0:57:19.32,Default,,0,0,0,,Seruan untuk menggulingkan dan meracuni.
Dialog: 0,0:57:19.92,0:57:23.06,Default,,0,0,0,,Mereka melakukan segalanya untuk menyingkirkan Yang Mulia.
Dialog: 0,0:57:23.06,0:57:24.66,Default,,0,0,0,,Jangan khawatir.
Dialog: 0,0:57:25.23,0:57:28.23,Default,,0,0,0,,Tidak peduli seberapa kerasnya mereka mencoba menyakiti Yang Mulia,
Dialog: 0,0:57:28.80,0:57:31.00,Default,,0,0,0,,Aku akan meningkatkan kekuatanku.
Dialog: 0,0:57:32.57,0:57:37.04,Default,,0,0,0,,Dengan saudara sepertimu, dia tidak perlu khawatir.
Dialog: 0,0:57:44.98,0:57:47.25,Default,,0,0,0,,Apakah Anda familiar dengan materi ini?
Dialog: 0,0:57:47.25,0:57:49.45,Default,,0,0,0,,Ini sutra biasa.
Dialog: 0,0:57:50.42,0:57:53.29,Default,,0,0,0,,Apakah ada yang salah dengan dia?
Dialogue: 0,0:57:53.32,0:57:56.96,Default,,0,0,0,,Sudahkah kamu memberi seseorang pakaian yang terbuat dari bahan ini?
Dialog: 0,0:57:58.36,0:58:01.37,Default,,0,0,0,,Setelah Yang Mulia menjadi Ratu,
Dialog: 0,0:58:01.37,0:58:04.60,Default,,0,0,0,,Saya hanya menerima hadiah, saya tidak memberikannya sendiri.
Dialog: 0,0:58:05.07,0:58:08.94,Default,,0,0,0,,Satu-satunya orang yang aku tawarkan hadiahnya adalah Janda Ratu.
Dialog: 0,0:58:09.34,0:58:10.84,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:58:12.21,0:58:14.11,Default,,0,0,0,,Tapi tahukah Anda...
Dialog: 0,0:58:14.78,0:58:17.98,Default,,0,0,0,,Gudang saya telah dirampok dua kali baru-baru ini.
Dialogue: 0,0:58:18.85,0:58:22.12,Default,,0,0,0,,Sutra itu mungkin ada di sana.
Dialogue: 0,0:58:22.12,0:58:24.66,Default,,0,0,0,,Apakah rumahmu diserang?
Dialog: 0,0:58:24.66,0:58:26.49,Default,,0,0,0,,Tidak, tidak.
Dialogue: 0,0:58:27.09,0:58:29.89,Default,,0,0,0,,Berbahaya jika menyimpan semua barang berhargamu di satu tempat.
Dialog: 0,0:58:29.89,0:58:32.56,Default,,0,0,0,,Lebih baik menempatkannya di tempat yang berbeda.
Dialog: 0,0:58:32.56,0:58:34.63,Default,,0,0,0,,Saya punya beberapa gudang.
Dialog: 0,0:58:35.40,0:58:40.90,Default,,0,0,0,,Tetapi para perampok hanya memilih mereka yang memiliki barang paling berharga.
Dialogue: 0,0:58:44.44,0:58:47.61,Default,,0,0,0,,Memikirkannya saja, leherku langsung mati rasa.
Dialog: 0,0:58:49.31,0:58:51.52,Default,,0,0,0,,Harta kesayanganku.
Dialog: 0,0:58:52.35,0:58:54.85,Default,,0,0,0,,Apakah mungkin untuk mengetahui di antara yang dicuri
Dialogue: 0,0:58:54.85,0:58:56.85,Default,,0,0,0,,apakah ini sutra atau bukan?
Dialogue: 0,0:58:58.12,0:58:59.79,Default,,0,0,0,,Terlalu banyak yang dicuri.
Dialogue: 0,0:58:59.79,0:59:03.26,Default,,0,0,0,,Dan menyimpan catatan properti berharga itu berbahaya.
Dialog: 0,0:59:04.19,0:59:06.36,Default,,0,0,0,,Omong-omong...
Dialog: 0,0:59:08.90,0:59:11.20,Default,,0,0,0,,Jangan beri tahu siapa pun tentang gudang.
Dialogue: 0,0:59:11.20,0:59:14.10,Default,,0,0,0,,Nggak enak kalau orang tahu soal ini.
Dialog: 0,0:59:14.57,0:59:15.97,Default,,0,0,0,,Saya mengerti.
Dialog: 0,0:59:16.67,0:59:22.18,Default,,0,0,0,,Tapi kamu belum pernah mendengar sesuatu yang aneh dari ayahmu?
Dialogue: 0,0:59:23.38,0:59:25.28,Default,,0,0,0,,Apa terjadi sesuatu?
Dialog: 0,0:59:27.15,0:59:31.69,Default,,0,0,0,,Seluruh situasi dengan Yang Mulia: menyelamatkan raja dengan selirnya
Dialog: 0,0:59:31.69,0:59:35.59,Default,,0,0,0,,dan merusak hubungan dengan ratu janda - membuatku khawatir.
Dialog: 0,0:59:36.26,0:59:39.83,Default,,0,0,0,,Saya mengalami mimpi buruk di mana dia digulingkan.
Dialog: 0,0:59:39.96,0:59:43.30,Default,,0,0,0,,Digulingkan? Mengapa Anda memikirkan hal ini?
Dialog: 0,0:59:44.50,0:59:47.27,Default,,0,0,0,,Ada rumor bahwa salah satu pesaing ratu
Dialog: 0,0:59:47.30,0:59:50.14,Default,,0,0,0,,menyampaikan pesan rahasia.
Dialog: 0,0:59:50.34,0:59:54.01,Default,,0,0,0,,Mungkinkah mereka ingin memilih ratu baru?
Dialogue: 0,0:59:54.88,0:59:58.95,Default,,0,0,0,,Aku sangat khawatir kalau aku makan berlebihan akhir-akhir ini.
Dialog: 0,1:00:00.48,1:00:03.72,Default,,0,0,0,,Mereka tidak akan meninggalkan Yang Mulia.
Dialog: 0,1:00:04.32,1:00:06.49,Default,,0,0,0,,Benarkah?
Dialog: 0,1:00:06.99,1:00:12.66,Default,,0,0,0,,Saya harus mencoba mengirim\N lebih banyak hadiah kepada Janda Ratu.
Dialog: 0,1:00:14.23,1:00:16.03,Default,,0,0,0,,Bagaimana perasaanmu?
Dialog: 0,1:00:16.03,1:00:17.50,Default,,0,0,0,,Apa?
Dialog: 0,1:00:17.80,1:00:20.57,Default,,0,0,0,,Ini bukan apa-apa. aku akan segera ke sana...
Dialog: 0,1:00:21.37,1:00:23.54,Default,,0,0,0,,Tidak, mungkin tidak secepat itu.
Dialog: 0,1:00:24.91,1:00:26.91,Default,,0,0,0,,Bagaimana ini bisa terjadi?
Dialog: 0,1:00:28.18,1:00:32.05,Default,,0,0,0,,Saya benar-benar lupa bahwa saya tidak lagi muda, dan ceroboh.
Dialog: 0,1:00:36.52,1:00:39.92,Default,,0,0,0,,Saya tidak punya waktu untuk bersenang-senang.
Dialog: 0,1:00:52.37,1:00:53.60,Default,,0,0,0,,Bagaimana perasaanmu?
Dialog: 0,1:00:53.60,1:00:55.64,Default,,0,0,0,,Aku terlihat seperti boneka.
Dialog: 0,1:00:55.64,1:00:57.14,Default,,0,0,0,,Bagus!
Dialog: 0,1:00:57.74,1:01:01.01,Default,,0,0,0,,Kamu menyukainya, bukan?
Dialog: 0,1:01:27.80,1:01:30.67,Default,,0,0,0,,Buku ini sudah ditumbuhi jamur.
Dialogue: 0,1:01:31.61,1:01:33.91,Default,,0,0,0,,Bau busuk sekali.
Dialog: 0,1:01:34.31,1:01:35.98,Default,,0,0,0,,Jika kamu laki-laki,
Dialog: 0,1:01:35.98,1:01:38.45,Default,,0,0,0,,akan masuk istana setelah lulus ujian negara.
Dialog: 0,1:01:38.45,1:01:40.85,Default,,0,0,0,,Kamu sangat menikmati belajar.
Dialogue: 0,1:01:42.42,1:01:44.32,Default,,0,0,0,,Siapa yang suka mempelajari ini?
Dialog: 0,1:01:44.32,1:01:46.79,Default,,0,0,0,,Saya mencoba hanya untuk ayah saya.
Dialog: 0,1:01:47.69,1:01:50.09,Default,,0,0,0,,Ibu meninggal, memberiku kehidupan.
Dialog: 0,1:01:50.39,1:01:53.33,Default,,0,0,0,,Dan saya memutuskan bahwa saya harus membayar kembali untuk ini.
Dialogue: 0,1:01:53.66,1:01:55.73,Default,,0,0,0,,Rupanya itu sebabnya kamu bahkan di malam hari
Dialog: 0,1:01:55.73,1:01:59.00,Default,,0,0,0,,kami belajar keras di hari ulang tahun kami.
Dialog: 0,1:02:09.88,1:02:11.38,Default,,0,0,0,,Soyeon.
Dialog: 0,1:02:16.55,1:02:18.36,Default,,0,0,0,,Selamat ulang tahun.
Dialog: 0,1:02:23.86,1:02:27.93,Default,,0,0,0,,Karena di hari ulang tahunku kami teringat ibuku,
Dialog: 0,1:02:29.83,1:02:31.94,Default,,0,0,0,,Saya tidak pernah tersenyum.
Dialogue: 0,1:02:34.27,1:02:36.27,Default,,0,0,0,,Apa tadi tadi?
Dialog: 0,1:02:36.54,1:02:37.97,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:02:38.48,1:02:42.15,Default,,0,0,0,,Kenanganmu kembali!
Dialog: 0,1:02:43.81,1:02:47.15,Default,,0,0,0,,Apa? Kenangan apa yang sepertinya milikku, tapi sebenarnya bukan?
Dialog: 0,1:02:57.96,1:02:59.73,Default,,0,0,0,,Kim Chanhyuk
Dialog: 0,1:02:59.93,1:03:03.10,Default,,0,0,0,,Minggir! Pergilah!
Dialog: 0,1:03:03.30,1:03:04.33,Default,,0,0,0,,
Dialog: 0,1:03:04.33,1:03:07.50,Default,,0,0,0,,Kim Chanhyuk, Menteri Perang saat ini.
Dialog: 0,1:03:07.77,1:03:10.14,Default,,0,0,0,,Dikumpulkan dengan sekelompok militer
Dialog: 0,1:03:10.34,1:03:12.24,Default,,0,0,0,,pajak perang yang terlalu tinggi.
Dialog: 0,1:03:14.34,1:03:17.28,Default,,0,0,0,,Kim Seok-kyn, penasihat kiri saat ini.
Dialog: 0,1:03:17.31,1:03:18.68,Default,,0,0,0,,Bertanggung jawab atas keuangan,
Dialog: 0,1:03:18.68,1:03:20.25,Default,,0,0,0,,melalui pertukaran gandum
Dialog: 0,1:03:20.25,1:03:22.19,Default,,0,0,0,,sesuai dengan hadiah kerajaan.
Dialog: 0,1:03:23.02,1:03:25.49,Default,,0,0,0,,Kim Byung-hak, anggota dewan negara bagian saat ini.
Dialog: 0,1:03:25.69,1:03:27.29,Default,,0,0,0,,Penjahat pajak:
Dialog: 0,1:03:27.29,1:03:29.66,Default,,0,0,0,,berkonspirasi dengan gubernur setempat
Dialog: 0,1:03:29.76,1:03:31.66,Default,,0,0,0,,dan mengenakan pajak pada tanah kosong.
Dialog: 0,1:03:35.40,1:03:37.00,Default,,0,0,0,,Kim Mungeun.
Dialog: 0,1:03:37.60,1:03:39.37,Default,,0,0,0,,Ayah Ratu.
Dialog: 0,1:03:39.57,1:03:41.10,Default,,0,0,0,,Inilah yang saya bicarakan.
Dialog: 0,1:03:46.24,1:03:48.11,Default,,0,0,0,,Ayah Ratu,
Dialog: 0,1:03:48.11,1:03:49.68,Default,,0,0,0,,kepala pengawal kerajaan.
Dialog: 0,1:03:49.68,1:03:51.38,Default,,0,0,0,,Produsen terkenal,
Dialog: 0,1:03:51.38,1:03:54.48,Default,,0,0,0,,menangani segalanya mulai dari pinjaman beras hingga sistem pajak perang.
Dialog: 0,1:03:58.89,1:04:00.39,Default,,0,0,0,,Kim Jwageun.
Dialog: 0,1:04:01.49,1:04:03.19,Default,,0,0,0,,Komandan pasukan saat ini.
Dialog: 0,1:04:17.74,1:04:19.04,Default,,0,0,0,,Di puncak kekuatannya,
Dialog: 0,1:04:19.04,1:04:22.35,Default,,0,0,0,,orang yang mendirikan seluruh sistem yang korup ini.
Dialog: 0,1:04:25.85,1:04:27.28,Default,,0,0,0,,Rahasia
Dialog: 0,1:04:30.52,1:04:32.99,Default,,0,0,0,,
Dialog: 0,1:04:47.17,1:04:49.84,Default,,0,0,0,,Semua orang di istana punya rahasia.
Dialog: 0,1:04:52.11,1:04:54.31,Default,,0,0,0,,Rahasia yang disembunyikan oleh kebohongan.
Dialog: 0,1:04:55.38,1:04:59.05,Default,,0,0,0,,Rahasia yang tidak bisa dilihat atau didengar.
Dialog: 0,1:04:59.95,1:05:01.99,Default,,0,0,0,,Sebuah rahasia menunggu saat yang tepat.
Dialog: 0,1:05:08.12,1:05:10.76,Default,,0,0,0,,Untuk menyimpan rahasia jauh di lubuk hati,
Dialog: 0,1:05:10.76,1:05:12.93,Default,,0,0,0,,
Dialog: 0,1:05:12.93,1:05:15.03,Default,,0,0,0,,Instruksi awal untuk anak-anak
Dialogue: 0,1:05:16.50,1:05:19.37,Default,,0,0,0,,kita semua memakai masker.
Dialog: 0,1:05:21.81,1:05:24.47,Default,,0,0,0,,Cho Hwajin
Dialog: 0,1:06:09.22,1:06:11.35,Default,,0,0,0,,Tapi sebuah rahasia
Dialog: 0,1:06:13.99,1:06:16.06,Default,,0,0,0,,pasti akan terbuka.
Dialog: 0,1:06:20.06,1:06:23.30,Default,,0,0,0,,
Dialog: 0,1:06:23.30,1:06:24.83,Default,,0,0,0,,
Dialog: 0,1:06:40.18,1:06:43.62,Default,,0,0,0,,{\i1}Yang Mulia, ingatan Anda telah kembali!{\i}
Dialog: 0,1:06:46.99,1:06:49.39,Default,,0,0,0,,{\i1}Semuanya kacau. Pergilah, nona, pergilah!{\i}
Dialogue: 0,1:06:49.39,1:06:52.43,Default,,0,0,0,,{\i1}Kenapa kamu semakin aneh saja?{\i}
Dialogue: 0,1:06:52.43,1:06:55.03,Default,,0,0,0,,{\i1}Ada sesuatu yang belum kuceritakan kepada siapa pun.{\i}
Dialog: 0,1:06:55.03,1:06:56.93,Default,,0,0,0,,{\i1}-Bantuan.\N-Bau lembap itu.{\i}
Dialog: 0,1:06:56.93,1:06:59.87,Default,,0,0,0,,{\i1}Banyak gudang di ibu kota baru-baru ini dirampok.{\i}
Dialog: 0,1:06:59.87,1:07:01.57,Default,,0,0,0,,{\i1}-Jadi apa?\N-Saya tertarik,{\i}
Dialogue: 0,1:07:01.57,1:07:03.84,Default,,0,0,0,,{\i1}mungkin beginilah caramu menghasilkan uang.{\i}
Dialog: 0,1:07:03.94,1:07:06.71,Default,,0,0,0,,{\i1}Hari ini kami akan mengklarifikasi semuanya.{\i}
Dialog: 0,1:07:06.71,1:07:08.58,Default,,0,0,0,,{\i1}Inilah yang saya tunggu-tunggu.{\i}
Dialog: 0,0:10:58.78,0:11:00.78,Default,,0,0,0,,

Komentar: 0,0:06:11.92,0:06:14.02,Default,lily,0,0,0,,Suatu kondisi ketika ada denyut nadi, namun orang tersebut hampir tidak bernapas.
