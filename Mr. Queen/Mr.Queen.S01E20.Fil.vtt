Dialogue: 0,0:00:58.10,0:01:04.08,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy207}\fscy207} 92 38 l 0 38
Dialogue: 0,0:00:58.10,0:01:04.08,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Pineapple
Dialogue: 0,0:00:58.10,0:01:04.08,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.10,0:01:04.08,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.16,2:01:37.16,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.19,0:01:06.63,Default,Spillik,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.63,0:01:08.90,Default,Spillik,0,0,0,,at ang mga kaganapang ipinakita ay fiction.
Dialogue: 0,0:01:10.46,0:01:13.30,Default,Spillik,0,0,0,,Huling episode
Dialogue: 0,0:01:13.82,0:01:14.96,Default,Spillik,0,0,0,,Stop.
Dialogue: 0,0:01:20.03,0:01:21.44,Default,Spillik,0,0,0,,-Search.\N-Oo!
Dialogue: 0,0:01:38.15,0:01:39.58,Default,Spillik,0,0,0,,Walang kahina-hinala.
Dialogue: 0,0:02:19.80,0:02:20.93,Default,Spillik,0,0,0,,Profit.
Dialogue: 0,0:02:29.68,0:02:32.41,Default,Spillik,0,0,0,,Maingat na hanapin ang lahat ng cart na may mga royal na regalo.
Dialogue: 0,0:02:32.85,0:02:33.91,Default,Spillik,0,0,0,,Oo.
Dialogue: 0,0:02:42.58,0:02:44.82,Default,Spillik,0,0,0,,-Kamahalan!\N-Kumusta.
Dialogue: 0,0:02:45.66,0:02:46.69,Default,Spillik,0,0,0,,Paano...
Dialogue: 0,0:02:47.78,0:02:49.83,Default,Spillit,0,0,0,,Hari!
Dialogue: 0,0:02:53.63,0:02:56.24,Default,Spillie,0,0,0,,Sa wakas, nahuli ko itong maliit na daga.
Dialogue: 0,0:02:57.16,0:02:58.61,Default,Spillik,0,0,0,,Kailan magsisimula ang seremonya?
Dialogue: 0,0:02:59.30,0:03:01.80,Default,Spillik,0,0,0,,-Hapon.\N-So may oras tayo?
Dialogue: 0,0:03:02.21,0:03:04.53,Default,Spillik,0,0,0,,Hindi ka makakapag-relax. Bilisan natin.
Dialogue: 0,0:03:05.27,0:03:06.34,Default,Spillit,0,0,0,,Maghintay.
Dialogue: 0,0:03:12.34,0:03:14.79,Default,Spillik,0,0,0,,-Ano iyon?\N-Hindi ko alam.
Dialogue: 0,0:03:21.99,0:03:23.99,Default,Spillik,0,0,0,,May oras tayo para dito.
Dialogue: 0,0:03:24.52,0:03:26.89,Default,Spillik,0,0,0,,-Tara na.\N-Okay.
Dialogue: 0,0:03:35.77,0:03:38.68,Default,Spillik,0,0,0,,Ang buhay ko na wala ako
Dialogue: 0,0:04:01.23,0:04:02.30,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:04:10.48,0:04:13.51,Default,Spillit,0,0,0,,Teka, hindi pa ako tapos sa paglilinis.
Dialogue: 0,0:04:17.58,0:04:18.58,Default,Spillie,0,0,0,,Naku, mga mommies!
Dialogue: 0,0:04:24.21,0:04:25.26,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:04:28.23,0:04:29.73,Default,Spillik,0,0,0,,Labis kang nasaktan,
Dialogue: 0,0:04:30.15,0:04:32.73,Default,Spillik,0,0,0,,ano ang kaluluwa mo na gumagala sa palasyo?
Dialogue: 0,0:04:35.20,0:04:36.46,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:04:40.01,0:04:41.04,Default,Spillit,0,0,0,,Chief Eunuch.
Dialogue: 0,0:04:42.21,0:04:43.71,Default,Spillik,0,0,0,,Sumama ka sa akin.
Dialogue: 0,0:04:44.71,0:04:46.87,Default,Spillik,0,0,0,,Sa iyo?
Dialogue: 0,0:04:47.51,0:04:49.24,Default,Spillie,0,0,0,,Maligaw!
Dialogue: 0,0:04:52.89,0:04:55.71,Default,Spillik,0,0,0,,Kamahalan, pumunta ka sa langit.
Dialogue: 0,0:04:56.31,0:04:58.15,Default,Spillik,0,0,0,,Dapat kang sumama sa akin.
Dialogue: 0,0:04:59.79,0:05:00.86,Default,Spillit,0,0,0,,Queen.
Dialogue: 0,0:05:02.86,0:05:03.89,Default,Spillit,0,0,0,,King.
Dialogue: 0,0:05:05.33,0:05:07.12,Default,Spillik,0,0,0,,Kamahalan! Ikaw ay buhay!
Dialogue: 0,0:05:09.46,0:05:12.80,Default,Spillik,0,0,0,,Kamahalan, anong nangyari sa iyo?
Dialogue: 0,0:05:33.66,0:05:35.69,Default,Spillit,0,0,0,,Nakasama ito sa royal attire.
Dialogue: 0,0:05:35.99,0:05:37.86,Default,Spillik,0,0,0,,Mayroon akong kamangha-manghang lasa.
Dialogue: 0,0:05:41.60,0:05:42.60,Default,Spillik,0,0,0,,Ayan!
Dialogue: 0,0:05:49.68,0:05:50.74,Default,Spillik,0,0,0,,Ayan!
Dialogue: 0,0:06:03.38,0:06:04.68, Default, Spillit,0,0,0,, Gumagapang na reptilya.
Dialogue: 0,0:06:11.93,0:06:13.17,Default,Spillik,0,0,0,,Oo!
Dialogue: 0,0:06:14.19,0:06:15.74,Default,Spillik,0,0,0,,Bakit ang galing mo?
Dialogue: 0,0:06:15.93,0:06:19.47,Default,Spillik,0,0,0,,Marahil ito ay isang vibe na ipinanganak ng karanasan?
Dialogue: 0,0:06:19.97,0:06:21.93,Default,Spillik,0,0,0,,Ipinanganak mula sa karanasan ano?
Dialogue: 0,0:06:21.93,0:06:23.78,Default,Spillik,0,0,0,,Nakakamangha ako gamit ang mga kutsilyo.
Dialogue: 0,0:06:31.28,0:06:32.92,Default,Spillik,0,0,0,,Huwag gumawa ng walang kwentang paggalaw.
Dialogue: 0,0:06:33.42,0:06:35.59,Default,Spillik,0,0,0,,Ilang mandirigma ang nagbabantay sa palasyo?
Dialogue: 0,0:06:40.53,0:06:41.55,Default,Spillik,0,0,0,,Huli ka.
Dialogue: 0,0:06:41.82,0:06:43.75,Default,Spillik,0,0,0,,Ang tunog na ito ay nangangahulugan ng simula ng koronasyon.
Dialogue: 0,0:06:45.60,0:06:47.49,Default,Spillik,0,0,0,,How dare you dare me?
Dialogue: 0,0:06:58.28,0:07:00.07,Default,Spillik,0,0,0,,Nagsimula na ba ang coronation ceremony?
Dialogue: 0,0:07:04.28,0:07:06.22,Default,Spillit,0,0,0,,Yumukod nang may paggalang
Dialogue: 0,0:07:09.25,0:07:11.01,Default,Spilyk,0,0,0,,apat na beses
Dialogue: 0,0:07:26.67,0:07:28.56,Default,Spillit,0,0,0,,at umupo ng tuwid.
Dialogue: 0,0:07:35.44,0:07:36.98,Default,Spillik,0,0,0,,Hindi ako makapaniwalang nagsimula sila ng mas maaga.
Dialogue: 0,0:07:40.68,0:07:42.25,Default,Spillik,0,0,0,,Uy, may sasabihin ako sa iyo.
Dialogue: 0,0:07:43.01,0:07:46.55,Default,Spillik,0,0,0,,Mayroon akong backup plan.
Dialogue: 0,0:08:18.95,0:08:21.82,Default,Spillik,0,0,0,,Ano ang ginagawa mo? Bilisan mo at magpatuloy.
Dialogue: 0,0:08:22.73,0:08:23.82,Default,Spillik,0,0,0,,Ang bagay ay,
Dialogue: 0,0:08:25.99,0:08:28.49,Default,Spillik,0,0,0,,na nawawala ang royal seal!
Dialogue: 0,0:08:35.68,0:08:37.57,Default,Spillit,0,0,0,,Walang Royal Seal!
Dialogue: 0,0:09:00.12,0:09:01.60,Default,Spillik,0,0,0,,Baliw na yata ako.
Dialogue: 0,0:09:02.36,0:09:05.93,Default,Spillik,0,0,0,,O nawala ang kanyang ulo dahil ito ay isang espesyal na gawain.
Dialogue: 0,0:09:09.24,0:09:10.63,Default,Spillie,0,0,0,,Itaas ang iyong ulo.
Dialogue: 0,0:09:11.34,0:09:14.68,Default,Spillik,0,0,0,,Pagbati, ang iyong...
Dialogue: 0,0:09:17.51,0:09:18.51,Default,Spillit,0,0,0,,Kamahalan?
Dialogue: 0,0:09:21.24,0:09:22.49,Default,Spillik,0,0,0,,Lee Senman.
Dialogue: 0,0:09:22.79,0:09:25.93,Default,Spillik,0,0,0,,Ikaw si Lee Senman.\NAbaliw ka na ba?
Dialogue: 0,0:09:26.43,0:09:27.68,Default,Spillik,0,0,0,,O baliw ba ako?
Dialogue: 0,0:09:32.56,0:09:34.17,Default,Spillit,0,0,0,,Ninakaw mo ba ang royal seal?
Dialogue: 0,0:09:34.96,0:09:36.46,Default,Spillik,0,0,0,,Medyo baliw ako.
Dialogue: 0,0:09:37.27,0:09:39.27,Default,Spillik,0,0,0,,Kaya may chance pa tayo.
Dialogue: 0,0:09:51.57,0:09:53.44,Default,Spillit,0,0,0,,-Let's go.\N-Forward.
Dialogue: 0,0:10:00.22,0:10:02.05,Default,Spillik,0,0,0,,Huling beses itong gumana para sa akin.
Dialogue: 0,0:10:02.05,0:10:04.00,Default,Spilyk,0,0,0,,-Subukan.\N-Hush.
Dialogue: 0,0:10:04.03,0:10:05.46,Default,Spillik,0,0,0,,Bakit ka...
Dialogue: 0,0:10:10.59,0:10:11.73,Default,Spillik,0,0,0,,Hon.
Dialogue: 0,0:10:15.73,0:10:16.97,Default,Spillik,0,0,0,,Ikaw na naman?
Dialogue: 0,0:10:16.97,0:10:18.41,Default,Spillik,0,0,0,,Sabi ko sayong huwag kang sumama!
Dialogue: 0,0:10:18.54,0:10:19.75,Default,Spillik,0,0,0,,Para sa akin lang
Dialogue: 0,0:10:20.25,0:10:22.71,Default,Spillik,0,0,0,,walang ibang magtatanong.
Dialogue: 0,0:10:25.68,0:10:30.89,Default,Spillie,0,0,0,,Hiniling sa akin ng Reyna na magnakaw ng isang bagay para sa kanya.
Dialogue: 0,0:10:40.87,0:10:42.83,Default,Spillie,0,0,0,,Itong maliwanag at mamahaling item
Dialogue: 0,0:10:42.83,0:10:44.83,Default,Spillik,0,0,0,,mukhang nagbabala.
Dialogue: 0,0:10:45.00,0:10:46.17,Default,Spillik,0,0,0,,Ano ito?
Dialogue: 0,0:10:47.83,0:10:49.60,Default,Spillit,0,0,0,,Royal Seal.
Dialogue: 0,0:10:50.54,0:10:51.54,Default,Spillik,0,0,0,,Iniisip mo ba,
Dialogue: 0,0:10:52.91,0:10:55.28,Default,Spilyk,0,0,0,,saan ka nagpakita na may ninakaw na selyo?
Dialogue: 0,0:10:55.38,0:10:56.68,Default,Spillik,0,0,0,,Ito ang Detective Department.
Dialogue: 0,0:11:01.02,0:11:04.29,Default,Spillik,0,0,0,,Kusang-loob ba akong pumunta sa kulungan?
Dialogue: 0,0:11:08.90,0:11:10.09,Default,Spillie,0,0,0,,Bakit mo binibigay sa akin?
Dialogue: 0,0:11:14.09,0:11:15.50,Default,Spillik,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:11:15.80,0:11:18.04,Default,Spillik,0,0,0,,Pumunta para makita ang isang kaibigan.
Dialogue: 0,0:11:18.23,0:11:20.70,Default,Spillik,0,0,0,,Hindi ka maaaring nandito. Umalis agad.
Dialogue: 0,0:11:21.17,0:11:22.18,Default,Spillit,0,0,0,,Teka!
Dialogue: 0,0:11:23.78,0:11:26.28,Default,Spillik,0,0,0,,How dare you grab my best friend?
Dialogue: 0,0:11:31.38,0:11:32.55,Default,Spillik,0,0,0,,Nababaliw ka na ba?
Dialogue: 0,0:11:32.68,0:11:34.15,Default,Spillik,0,0,0,,Bakit mo ipinakita ang royal seal?
Dialogue: 0,0:11:35.55,0:11:36.79,Default,Spillit,0,0,0,,Royal Seal?
Dialogue: 0,0:11:37.39,0:11:38.81,Default,Spillie,0,0,0,,Gusto mo bang tingnan ito?
Dialogue: 0,0:11:45.32,0:11:47.56,Default,Spillik,0,0,0,,-Ito ay bomba!\N-Tumakbo!
Dialogue: 0,0:13:02.43,0:13:05.30,Default,Biryulka,0,0,0,,Dumaan sila sa lahat ng gate ng capital?
Dialogue: 0,0:13:05.30,0:13:07.51,Default,Spillik,0,0,0,,Oo. Kung inuutusan mo kaming gumamit ng baril...
Dialogue: 0,0:13:07.51,0:13:10.78,Default,Spillik,0,0,0,,Ngayon ay mas mahalagang kumpletuhin ang seremonya ng koronasyon,
Dialogue: 0,0:13:10.78,0:13:12.07,Default,Spillik,0,0,0,,kailangan nating maghintay ng ilang sandali dala ang mga baril.
Dialogue: 0,0:13:12.68,0:13:15.52,Default,Spillik,0,0,0,,At magpadala ng mga bantay sa lahat ng gate.
Dialogue: 0,0:13:15.52,0:13:16.68,Default,Spillit,0,0,0,,Bilisan mo!
Dialogue: 0,0:13:20.48,0:13:22.82,Default,Spillit,0,0,0,,Pagkatapos ng seremonya,
Dialogue: 0,0:13:24.32,0:13:26.37,Default,Spillik,0,0,0,,Aalisin ko sila.
Dialogue: 0,0:13:28.46,0:13:31.93,Default,Spillik,0,0,0,,Paano natin maipagpapatuloy ang seremonya kung wala ang royal seal?
Dialogue: 0,0:13:32.23,0:13:34.73,Default,Spillik,0,0,0,,Diyos, paano ito mangyayari?
Dialogue: 0,0:13:35.93,0:13:38.28,Default,Spillik,0,0,0,,Ano ang ginagawa mo?
Dialogue: 0,0:13:38.64,0:13:41.75,Default,Spillik,0,0,0,,Bakit wala kang silbi?
Dialogue: 0,0:13:49.66,0:13:50.76,Default,Spillik,0,0,0,,Ano ang problema?
Dialogue: 0,0:13:54.35,0:13:55.39,Default,Spillik,0,0,0,,Ano kaya?
Dialogue: 0,0:13:55.39,0:13:58.35,Default,Spilyk,0,0,0,,Hindi tayo makakaatake ngayon
Dialogue: 0,0:13:58.35,0:14:00.06,Default,Spillik,0,0,0,,dahil sa hindi kilalang matulis na usok.
Dialogue: 0,0:14:01.63,0:14:03.50,Default,Spillik,0,0,0,,At dahil ang seremonya ay dapat na matagumpay na natapos,
Dialogue: 0,0:14:03.50,0:14:06.73,Default,Spillik,0,0,0,,Nagpadala ako ng mga bantay sa gate para pigilan sila.
Dialogue: 0,0:14:08.80,0:14:10.64,Default,Spillik,0,0,0,,Mga mapanlinlang na taktika.
Dialogue: 0,0:14:10.73,0:14:11.73,Default,Spillik,0,0,0,,Ano ito?
Dialogue: 0,0:14:13.94,0:14:15.01,Default,Spillik,0,0,0,,Wala.
Dialogue: 0,0:14:15.10,0:14:17.12,Default,Spillik,0,0,0,,Ako mismo ang magdadala ng royal seal.
Dialogue: 0,0:14:19.52,0:14:21.48,Default,Spillik,0,0,0,,Agad na tawagan ang lahat ng mga bantay pabalik sa palasyo.
Dialogue: 0,0:14:22.15,0:14:23.81,Default,Spillik,0,0,0,,-Ano?\N-Hindi mo ba naririnig?
Dialogue: 0,0:14:24.68,0:14:25.72,Default,Spillik,0,0,0,,Oo.
Dialogue: 0,0:14:38.54,0:14:39.93,Default,Spillik,0,0,0,,Napakatahimik dito.
Dialogue: 0,0:14:41.37,0:14:43.23,Default,Spillik,0,0,0,,Mukhang lahat ay nangyayari ayon sa plano.
Dialogue: 0,0:14:46.84,0:14:48.44,Default,Spillik,0,0,0,,Nakarating kami dito.
Dialogue: 0,0:14:57.05,0:14:58.12,Default,Spillik,0,0,0,,Natatakot ka ba?
Dialogue: 0,0:14:58.95,0:15:00.93,Default,Spillik,0,0,0,,Oo, ako rin
Dialogue: 0,0:15:01.85,0:15:03.00,Default,Spillik,0,0,0,,pinigilan.
Dialogue: 0,0:15:03.13,0:15:05.53,Default,Spillik,0,0,0,,Eksakto. Ganito ang pakiramdam mo
Dialogue: 0,0:15:05.53,0:15:07.59,Default,Spillik,0,0,0,,bago lumaban ang amo sa laro.
Dialogue: 0,0:15:08.63,0:15:10.83,Default,Spillik,0,0,0,,Tama. Boss.
Dialogue: 0,0:15:10.83,0:15:13.37,Default,Spillik,0,0,0,,Kung mamatay ka bago mo siya talunin, isumpa mo ang lahat sa mundo,
Dialogue: 0,0:15:13.37,0:15:15.10,Default,Spillik,0,0,0,,dahil kailangan mong magsimulang muli.
Dialogue: 0,0:15:15.10,0:15:17.47,Default,Spillik,0,0,0,,Isa lang ang pagkakataon natin.
Dialogue: 0,0:15:18.20,0:15:20.05,Default,Spillit,0,0,0,,God. Natatakot na ako.
Dialogue: 0,0:15:26.18,0:15:27.48,Default,Spillik,0,0,0,,Pupunta ba tayo?
Dialogue: 0,0:15:58.12,0:15:59.58,Default,Spillik,0,0,0,,Nakuha niya.
Dialogue: 0,0:16:08.13,0:16:09.26,Default,Spillit,0,0,0,,My queen!
Dialogue: 0,0:16:10.82,0:16:13.72,Default,Spillik,0,0,0,,Okay lang ako. Nakakatakot ang tunog.
Dialogue: 0,0:16:13.72,0:16:15.19,Default,Spillik,0,0,0,,Hindi man lang masakit.
Dialogue: 0,0:16:21.14,0:16:22.23,Default,Spillit,0,0,0,,Reyna!
Dialogue: 0,0:16:23.47,0:16:24.64,Default,Spillit,0,0,0,,My queen!
Dialogue: 0,0:16:29.18,0:16:31.62,Default,Spillie,0,0,0,,Queen, huwag kang gumalaw.
Dialogue: 0,0:16:31.88,0:16:33.81,Default,Spillik,0,0,0,,Dapat nating ihinto ang seremonya.
Dialogue: 0,0:16:34.81,0:16:36.35,Default,Spillik,0,0,0,,Mas mahalaga ka.
Dialogue: 0,0:16:42.39,0:16:44.13,Default,Spillik,0,0,0,,Kailangan kong tingnan ang sugat.
Dialogue: 0,0:17:33.38,0:17:34.44,Default,Spillit,0,0,0,,Aking hari.
Dialogue: 0,0:18:00.33,0:18:01.56,Default,Spillik,0,0,0,,Babalik ba ako?
Dialogue: 0,0:18:01.91,0:18:02.97,Default,Spillik,0,0,0,,No.
Dialogue: 0,0:18:04.03,0:18:05.34,Default,Spillik,0,0,0,,Bakit ngayon?
Dialogue: 0,0:18:06.11,0:18:07.11,Default,Spilyk,0,0,0,,Pakiusap,
Dialogue: 0,0:18:10.54,0:18:12.32,Default,Spillik,0,0,0,,pagkatapos kong makita na buhay siya.
Dialogue: 0,0:18:15.12,0:18:17.09,Default,Spillik,0,0,0,,Let me make sure na okay siya.
Dialogue: 0,0:18:35.67,0:18:38.08,Default,Spillit,0,0,0,,Kritikal na estado
Dialogue: 0,0:18:52.42,0:18:54.75,Default,Spillik,0,0,0,,Katawan ko ba ito? nakabalik na ako?
Dialogue: 0,0:18:55.48,0:18:56.66,Default,Spillik,0,0,0,,Kumusta naman ang Cheoljong?
Dialogue: 0,0:19:05.90,0:19:07.91,Default,Spillik,0,0,0,,Hindi, kailangan ko siyang iligtas.
Dialogue: 0,0:19:09.07,0:19:10.34,Default,Spillik,0,0,0,,Pero paano?
Dialogue: 0,0:19:11.27,0:19:12.58,Default,Spillik,0,0,0,,Ito ay 200 taon na ang nakakaraan.
Dialogue: 0,0:19:38.29,0:19:40.50,Default,Spillik,0,0,0,,VIP Department
Dialogue: 0,0:19:42.64,0:19:44.14,Default,Spillik,0,0,0,,Ano? Jang Bong Hwan?
Dialogue: 0,0:19:46.38,0:19:47.44,Default,Spillie,0,0,0,,Jang Bong-hwan!
Dialogue: 0,0:19:47.74,0:19:49.38,Default,Spillit,0,0,0,,Jang Bong-hwan? pasyente?
Dialogue: 0,0:19:53.54,0:19:54.54,Default,Spillit,0,0,0,,Stop!
Dialogue: 0,0:19:54.54,0:19:56.36,Default,Spilyk,0,0,0,,Hindi ka makakatakbo ng ganyan! kakagising mo lang!
Dialogue: 0,0:19:56.36,0:19:57.71,Default,Spillie,0,0,0,,Jang Bong-hwan!
Dialogue: 0,0:19:58.51,0:20:00.72,Default,Spillit,0,0,0,,-Chan Bong-hwan!\N-Sundan mo siya!
Dialogue: 0,0:20:01.22,0:20:02.43,Default,shooting gallery2,0,0,0,,Jang Bong-hwan!
Dialogue: 0,0:20:06.17,0:20:07.63,Default,shooting gallery2,0,0,0,,Stop!
Dialogue: 0,0:20:07.63,0:20:08.76,Default,shooting gallery2,0,0,0,,Tigilan mo siya!
Dialogue: 0,0:20:10.40,0:20:12.67,Default,shooting gallery2,0,0,0,,-Stop.\N-Bakit ka tumatakas?
Dialogue: 0,0:20:12.67,0:20:13.70,Default,tier2,0,0,0,,
Dialogue: 0,0:20:14.70,0:20:16.00,Default,shooting gallery2,0,0,0,,Itigil mo na!
Dialogue: 0,0:20:18.00,0:20:19.23,Default,shooting gallery2,0,0,0,,-Ano?\N-Hindi!
Dialogue: 0,0:20:29.68,0:20:30.92,Default,shooting gallery2,0,0,0,,Damn youth.
Dialogue: 0,0:20:32.01,0:20:34.43,Default,tyra2,0,0,0,,Para bang gulay talaga siya sa loob ng ilang buwan?
Dialogue: 0,0:20:50.43,0:20:52.11,Default,shooting gallery2,0,0,0,,Daehan Bookstore
Dialogue: 0,0:20:52.94,0:20:54.20,Default,tira2,0,0,0,,"Ang Tunay na Kasaysayan ni Joseon."
Dialogue: 0,0:21:03.92,0:21:05.06,Default,tira2,0,0,0,,"Ang Tunay na Kasaysayan ni Joseon"
Dialogue: 0,0:21:09.18,0:21:11.95,Default,shooting gallery2,0,0,0,,Huwag lang mamatay. Hindi ka pwedeng mamatay ng ganyan.
Dialogue: 0,0:21:12.49,0:21:14.83,Default,tira2,0,0,0,,22nd King ng Joseon State
Dialogue: 0,0:21:18.03,0:21:19.64,Default,shooting gallery2,0,0,0,,King Cheol...
Dialogue: 0,0:21:20.91,0:21:24.31,Default,shooting2,0,0,0,,Ang panahon ng paghahari ni Haring Cheoljong
Dialogue: 0,0:21:37.59,0:21:38.59,Default,shooting gallery2,0,0,0,,Wala iyon.
Dialogue: 0,0:21:43.06,0:21:44.66,Default,shooting gallery2,0,0,0,,Umalis siya.
Dialogue: 0,0:21:52.87,0:21:53.93,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:21:58.91,0:21:59.91,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:22:09.04,0:22:10.92,Default,shooting gallery2,0,0,0,,Hindi ka makakaalis ng ganyan.
Dialogue: 0,0:22:11.42,0:22:13.18,Default,shooting gallery2,0,0,0,,Mangyaring gumising, Kamahalan.
Dialogue: 0,0:22:17.45,0:22:18.52,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:22:22.02,0:22:24.03,Default,shooting2,0,0,0,,-Your Majesty.\N-Queen.
Dialogue: 0,0:22:24.90,0:22:26.20,Default,shooting gallery2,0,0,0,,Okay ka lang?
Dialogue: 0,0:22:26.70,0:22:28.26,Default,shooting 2,0,0,0,,Okay lang ako.
Dialogue: 0,0:22:29.50,0:22:31.77,Default,shooting gallery2,0,0,0,,Pero ikaw ay dumudugo.
Dialogue: 0,0:22:32.27,0:22:34.04,Default,shooting2,0,0,0,,Feeling all this pain,
Dialogue: 0,0:22:35.00,0:22:37.08,Default,shooting2,0,0,0,,I guess hindi ako mamamatay dito.
Dialogue: 0,0:22:38.18,0:22:41.98,Default,shooting gallery2,0,0,0,,Iniligtas ng body armor na ito ang aming buhay.
Dialogue: 0,0:22:43.95,0:22:45.32,Default,shooting gallery2,0,0,0,,Nakakaginhawa!
Dialogue: 0,0:23:27.29,0:23:29.73,Default,shooting2,0,0,0,,Ano ang ginagawa mo?
Dialogue: 0,0:23:29.73,0:23:31.73,Default,tyra2,0,0,0,,Kinampihan ng hari ang mga tagasunod ng donghak?
Dialogue: 0,0:23:35.73,0:23:36.84,Default,tier2,0,0,0,,I guess
Dialogue: 0,0:23:38.23,0:23:40.04,Default,shooting gallery2,0,0,0,,Ako pa rin ang hari.
Dialogue: 0,0:23:40.04,0:23:42.27,Default,shooting2,0,0,0,,Wala ka dapat ginawa.
Dialogue: 0,0:23:43.12,0:23:46.35,Default,shooting gallery2,0,0,0,,Tanggapin ang iyong posisyon at wala kang gagawin,
Dialogue: 0,0:23:46.35,0:23:48.15,Default,shooting gallery2,0,0,0,, lahat ay magiging masaya.
Dialogue: 0,0:23:50.56,0:23:51.59,Default,tier2,0,0,0,,I
Dialogue: 0,0:23:52.93,0:23:55.28,Default,tyra2,0,0,0,,kamag-anak ng mga pinatay mo.
Dialogue: 0,0:23:56.86,0:24:02.29,Default,shooting gallery2,0,0,0,,Ako ang hari ng mga taong iyon na iyong pinabayaan!
Dialogue: 0,0:24:07.87,0:24:10.08,Default,shooting gallery2,0,0,0,,Imposibleng kumilos.
Dialogue: 0,0:24:13.50,0:24:16.11,Default,shooting gallery2,0,0,0,,Pagod ka na.
Dialogue: 0,0:24:16.92,0:24:19.62,Default,shooting gallery2,0,0,0,,I doubt you can dodge my sword!
Dialogue: 0,0:24:26.89,0:24:27.89,Default,tier2,0,0,0,,Iyong...
Dialogue: 0,0:24:38.26,0:24:42.03,Default,tier2,0,0,0,,No. Baby ko. pakiusap ko.
Dialogue: 0,0:24:56.43,0:24:57.10,Default,shooting gallery2,0,0,0,,Pakiusap.
Dialogue: 0,0:26:10.10,0:26:11.19,Default,shooting gallery2,0,0,0,,Patayin mo ako.
Dialogue: 0,0:26:14.07,0:26:15.13,Default,shooting gallery2,0,0,0,,Live.
Dialogue: 0,0:26:16.84,0:26:19.60,Default,shooting gallery2,0,0,0,,Buhay sa kahihiyan -
Dialogue: 0,0:26:21.53,0:26:22.91,Default,shooting 2,0,0,0,,iyong parusa.
Dialogue: 0,0:26:31.62,0:26:33.24,Default,shooting gallery2,0,0,0,,Subukan mong patayin ang iyong sarili,
Dialogue: 0,0:26:34.28,0:26:36.92,Default,shooting 2,0,0,0,,Gagawin ko ang lahat para iligtas ka.
Dialogue: 0,0:26:37.48,0:26:40.09,Default,shooting gallery2,0,0,0,,At gaano man kasakit ang iyong tiisin,
Dialogue: 0,0:26:40.09,0:26:41.95,Default,shooting gallery2,0,0,0,,pero talagang bubuhayin kita.
Dialogue: 0,0:26:43.56,0:26:45.49,Default,shooting2,0,0,0,,Mabuhay na parang walang laman na shell.
Dialogue: 0,0:26:46.79,0:26:48.29,Default,shooting2,0,0,0,,Ganyan ang buhay
Dialogue: 0,0:26:50.26,0:26:53.20,Default,shooting 2,0,0,0,,puputol nang malalim sa iyong mga buto.
Dialogue: 0,0:27:27.52,0:27:31.05,Default,shooting gallery2,0,0,0,,At ano ang susunod? Ang pagtatago sa karamihan ng tao ay ang iyong espesyalidad
Dialogue: 0,0:27:31.55,0:27:34.52,Default,shooting gallery2,0,0,0,,pero curfew ito, at walang kahit isang kaluluwa sa lugar.
Dialogue: 0,0:27:35.26,0:27:37.96,Default,shooting gallery2,0,0,0,,Wala kang ibang mapagtataguan.
Dialogue: 0,0:28:03.39,0:28:04.55,Default,shooting gallery2,0,0,0,,My queen.
Dialogue: 0,0:28:09.72,0:28:12.23,Default,shooting gallery2,0,0,0,,Tapusin muna ang iyong laban.
Dialogue: 0,0:28:13.73,0:28:14.90,Default,tier2,0,0,0,,No.
Dialogue: 0,0:28:15.33,0:28:17.63,Default,shooting gallery2,0,0,0,,Walang mas mahalaga kaysa sa iyo.
Dialogue: 0,0:28:18.27,0:28:19.60,Default,shooting gallery2,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:28:20.27,0:28:22.17,Default,shooting gallery2,0,0,0,,kaya ko ito.
Dialogue: 0,0:28:26.61,0:28:28.04,Default,shooting gallery2,0,0,0,,Kamahalan!
Dialogue: 0,0:28:30.35,0:28:31.81,Default,tier2,0,0,0,,Ako na ang bahala sa reyna.
Dialogue: 0,0:28:32.65,0:28:33.75,Default,shooting 2,0,0,0,,Dapat kang pumunta.
Dialogue: 0,0:28:33.85,0:28:35.92,Default,shooting2,0,0,0,,Hindi namin alam kung ano pa ang maaaring mangyari.
Dialogue: 0,0:28:52.23,0:28:53.60,Default,shooting gallery2,0,0,0,,Please go.
Dialogue: 0,0:29:16.42,0:29:18.19,Default,shooting gallery2,0,0,0,,Babalik ako sa lalong madaling panahon.
Dialogue: 0,0:29:19.59,0:29:20.63,Default,tier2,0,0,0,,Oo.
Dialogue: 0,0:29:32.07,0:29:33.07,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:29:33.51,0:29:34.54,Default,shooting gallery2,0,0,0,,Kamahalan,
Dialogue: 0,0:29:34.74,0:29:35.94,Default,shooting gallery2,0,0,0,,ayos ka lang?
Dialogue: 0,0:29:59.80,0:30:03.00,Default,shooting gallery2,0,0,0,,Gumawa ng isang bagay!
Dialogue: 0,0:30:03.67,0:30:07.94,Default,shooting gallery2,0,0,0,,Bakit napakawalang kwenta mo?
Dialogue: 0,0:30:27.03,0:30:29.63,Default,shooting gallery2,0,0,0,,Kumilos nang may dignidad!
Dialogue: 0,0:30:29.93,0:30:33.13,Default,shooting2,0,0,0,,Natatakot ako, Queen Dowager.
Dialogue: 0,0:30:35.64,0:30:38.01,Default,shooting gallery2,0,0,0,,Dapat mong ipagtanggol ang iyong lugar!
Dialogue: 0,0:31:36.67,0:31:38.10,Default,shooting gallery2,0,0,0,,Lumayo sa trono.
Dialogue: 0,0:31:56.79,0:31:58.59,Default,shooting2,0,0,0,,The Dowager Queen.
Dialogue: 0,0:32:01.79,0:32:03.83,Default,shooting gallery2,0,0,0,,Binabati kita.
Dialogue: 0,0:32:53.44,0:32:55.54,Default,shooting gallery2,0,0,0,,Batiin ang Kanyang Kamahalan na Hari!
Dialogue: 0,0:32:56.38,0:32:57.48,Default,shooting gallery2,0,0,0,,My queen!
Dialogue: 0,0:32:59.51,0:33:01.22,Default,shooting2,0,0,0,,Wala nang malay ang kanyang Kamahalan.
Dialogue: 0,0:33:05.05,0:33:06.35,Default,shooting gallery2,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:33:06.92,0:33:09.36,Default,tira2,0,0,0,,Maaaring nalaglag ang kanyang Kamahalan.
Dialogue: 0,0:33:10.39,0:33:12.36,Default,tier2,0,0,0,,Ito ay medyo dumudugo ngayon.
Dialogue: 0,0:33:12.66,0:33:16.03,Default,tyra2,0,0,0,,Ngunit kung magpapatuloy ito, pareho ang reyna at ang kanyang anak
Dialogue: 0,0:33:17.90,0:33:19.33,Default,shooting gallery2,0,0,0,,hindi mabubuhay.
Dialogue: 0,0:33:23.37,0:33:25.81,Default,shooting2,0,0,0,,Kung gayon bakit mo tinatanggal ang mga karayom?
Dialogue: 0,0:33:26.24,0:33:31.68,Default,tira2,0,0,0,,Ngayon ang acupuncture ay makakasama lamang sa kanya.
Dialogue: 0,0:33:32.31,0:33:35.32,Default,tyra2,0,0,0,,Ang magagawa lang natin ay maghintay at magdasal para sa kanya.
Dialogue: 0,0:33:36.25,0:33:39.72,Default,shooting 2,0,0,0,,Maaaring hindi siya magtatagal.
Dialogue: 0,0:33:45.56,0:33:47.73,Default,shooting gallery2,0,0,0,,-Kamahalan! Hindi!\N-Kamahalan.
Dialogue: 0,0:33:53.64,0:33:55.84,Default,shooting gallery2,0,0,0,,Kamahalan, patawarin mo kami,
Dialogue: 0,0:33:56.81,0:33:59.54,Default,tier2,0,0,0,,pero umalis ka sa kwarto para maalagaan natin siya.
Dialogue: 0,0:34:00.11,0:34:02.88,Default,shooting gallery2,0,0,0,,Kamahalan, kailangan na natin silang iwan.
Dialogue: 0,0:34:08.28,0:34:09.45,Default,shooting gallery2,0,0,0,,Kamahalan!
Dialogue: 0,0:34:12.09,0:34:13.35,Default,shooting gallery2,0,0,0,,Kamahalan!
Dialogue: 0,0:34:14.92,0:34:19.13,Default,shooting gallery2,0,0,0,,Wala akong magagawa!
Dialogue: 0,0:35:09.44,0:35:10.55,Default,shooting gallery2,0,0,0,,My queen.
Dialogue: 0,0:35:24.93,0:35:27.96,Default,tyra2,0,0,0,,Okay na ang Reyna at ang bata ngayon.
Dialogue: 0,0:35:36.77,0:35:37.81,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:35:41.64,0:35:43.75,Default,shooting gallery2,0,0,0,,Sobrang saya ko. Ikaw at ang baby natin...
Dialogue: 0,0:35:46.88,0:35:48.92,Default,shooting2,0,0,0,,Okay lang sa iyo ang lahat.
Dialogue: 0,0:35:58.53,0:35:59.53,Default,shooting gallery2,0,0,0,,Kamahalan.
Dialogue: 0,0:36:18.08,0:36:19.85,Default,shooting gallery2,0,0,0,,Ito na ang wakas.
Dialogue: 0,0:36:22.08,0:36:25.55,Default,shooting gallery2,0,0,0,,Sino ang nakakaalam na ang hari ay napakapambihira?
Dialogue: 0,0:36:27.29,0:36:29.09,Default,shooting gallery2,0,0,0,,Kamahalan!
Dialogue: 0,0:36:32.39,0:36:35.70,Default,shooting gallery2,0,0,0,,Ang lakas ng loob mong sumigaw? Nasaan ang ugali mo?
Dialogue: 0,0:36:36.03,0:36:37.07,Default,shooting gallery2,0,0,0,,Ito ang kaso dito,
Dialogue: 0,0:36:37.90,0:36:41.44,Default,shooting gallery2,0,0,0,,nag-utos ang hari para sa iyong paglipat sa Western Palace.
Dialogue: 0,0:36:41.64,0:36:42.70,Default,shooting gallery2,0,0,0,,Ano?
Dialogue: 0,0:36:42.84,0:36:46.31,Default,shooting gallery2,0,0,0,,How dare he send me to the Western Palace?
Dialogue: 0,0:36:48.01,0:36:50.14,Default,shooting gallery2,0,0,0,,Kanino niya ako kinukuha?
Dialogue: 0,0:36:57.25,0:36:59.32,Default,shooting gallery2,0,0,0,,Anong ginagawa mo? Buksan ang pinto ngayon.
Dialogue: 0,0:36:59.82,0:37:02.62,Default,shooting gallery2,0,0,0,,Hindi ko mabuksan ang pinto, Kamahalan.
Dialogue: 0,0:37:12.60,0:37:15.67,Default,shooting gallery2,0,0,0,,Buksan kaagad ang pintong ito!
Dialogue: 0,0:37:16.60,0:37:19.04,Default,shooting gallery2,0,0,0,,Dumating na ang Reyna.
Dialogue: 0,0:37:43.03,0:37:44.07,Default,shooting gallery2,0,0,0,,Buksan.
Dialogue: 0,0:37:55.94,0:37:57.58,Default,shooting2,0,0,0,,Nabalitaan ko na kahapon nasa gilid ka na,
Dialogue: 0,0:37:57.58,0:37:58.95,Default,tier2,0,0,0,,pero mukhang maayos ang lahat sa iyo.
Dialogue: 0,0:37:59.21,0:38:01.28,Default,shooting gallery2,0,0,0,,Salamat sa iyo.
Dialogue: 0,0:38:02.65,0:38:04.25,Default,shooting gallery2,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:38:04.25,0:38:07.59,Default,shooting2,0,0,0,,Simula kailan ko kailangang sabihin sa iyo ang aking lokasyon?
Dialogue: 0,0:38:07.59,0:38:10.49,Default,shooting gallery2,0,0,0,,Napagpasyahan na ipadala ka sa Western Palace.
Dialogue: 0,0:38:10.96,0:38:13.26,Default,shooting gallery2,0,0,0,,Hanggang doon, manatili sa Dongmyeongjong.
Dialogue: 0,0:38:13.63,0:38:15.46,Default,shooting gallery2,0,0,0,,Hindi ka pinapayagang umalis.
Dialogue: 0,0:38:16.10,0:38:19.73,Default,shooting gallery2,0,0,0,,Sinasabi mo bang ikinukulong mo ako dito?
Dialogue: 0,0:38:20.77,0:38:22.40,Default,shooting gallery2,0,0,0,,Huwag mo akong pagtawanan.
Dialogue: 0,0:38:24.51,0:38:25.57,Default,shooting gallery2,0,0,0,,Out of the way!
Dialogue: 0,0:38:26.97,0:38:28.51,Default,shooting gallery2,0,0,0,,Hindi ka maaaring lumabas.
Dialogue: 0,0:38:29.24,0:38:31.21,Default,shooting gallery2,0,0,0,,Sabi ko sayong umiwas ka!
Dialogue: 0,0:38:33.92,0:38:35.15,Default,shooting gallery2,0,0,0,,The Dowager Queen.
Dialogue: 0,0:38:39.12,0:38:42.09,Default,shooting gallery2,0,0,0,,Ang huling araw mo ay gugugulin sa palasyo.
Dialogue: 0,0:38:44.49,0:38:46.59,Default,shooting gallery2,0,0,0,,Court lady Chon, bakit ka nakatayo?
Dialogue: 0,0:38:46.59,0:38:47.70,Default,shooting gallery2,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:38:52.47,0:38:54.44,Default,shooting gallery2,0,0,0,,How dare you?
Dialogue: 0,0:38:54.44,0:38:56.44,Default,tier2,0,0,0,,Hindi ka na nila sinusunod.
Dialogue: 0,0:38:58.57,0:39:00.27,Default,shooting gallery2,0,0,0,,Responsable para sa courtyard
Dialogue: 0,0:39:01.18,0:39:02.21,Default,shooting gallery2,0,0,0,,ngayon ako.
Dialogue: 0,0:39:02.78,0:39:04.38,Default,shooting gallery2,0,0,0,,Ako ang namamahala sa bakuran.
Dialogue: 0,0:39:04.55,0:39:06.61,Default,shooting gallery2,0,0,0,,Nandito pa rin ako!
Dialogue: 0,0:39:06.61,0:39:08.55,Default,shooting gallery2,0,0,0,,Ito ang lugar ko!
Dialogue: 0,0:39:08.55,0:39:10.59,Default,shooting gallery2,0,0,0,,Mula sa araw na ito, magbabago ang lahat,
Dialogue: 0,0:39:11.25,0:39:13.19,Default,tyra2,0,0,0,,lalo na ang mga tuntunin ng kagandahang-asal,
Dialogue: 0,0:39:13.19,0:39:15.12,Default,tier2,0,0,0,,itinakda mo.
Dialogue: 0,0:39:15.32,0:39:18.93,Default,shooting gallery2,0,0,0,,Umiral sila sa loob ng libu-libong taon!
Dialogue: 0,0:39:19.29,0:39:22.56,Default,shooting gallery2,0,0,0,,Sa tingin mo kaya mo silang isuko sa isang gabi?
Dialogue: 0,0:39:23.66,0:39:25.43,Default,tier2,0,0,0,,Nanghihina na sila.
Dialogue: 0,0:39:26.30,0:39:28.04,Default,shooting2,0,0,0,,Ang mga pagbabagong kinatatakutan mo,
Dialogue: 0,0:39:29.14,0:39:30.71,Default,shooting gallery2,0,0,0,,nagsimula na.
Dialogue: 0,0:39:46.85,0:39:49.66,Default,shooting gallery2,0,0,0,,Damn, nakakapreskong!
Dialogue: 0,0:39:51.03,0:39:52.06,Default,tier2,0,0,0,,
Dialogue: 0,0:39:52.79,0:39:55.93,Default,shooting gallery2,0,0,0,,Court Lady Choi, ano ang sinabi ko?
Dialogue: 0,0:39:56.60,0:39:59.57,Default,shooting2,0,0,0,,"Damn, how refreshing!" -
Dialogue: 0,0:40:00.27,0:40:01.80,Default,shooting2,0,0,0,,yan ang sinabi mo.
Dialogue: 0,0:40:05.17,0:40:08.08,Default,shooting gallery2,0,0,0,,Kumbaga, nagising na ang hidden instincts ko.
Dialogue: 0,0:40:08.88,0:40:10.58,Default,shooting gallery2,0,0,0,,Nakaka-refresh talaga ito.
Dialogue: 0,0:40:11.78,0:40:13.68,Default,shooting gallery2,0,0,0,,I can't stop, damn it.
Dialogue: 0,0:40:16.02,0:40:17.05,Default,shooting gallery2,0,0,0,,Damn.
Dialogue: 0,0:40:18.69,0:40:19.89,Default,shooting gallery2,0,0,0,,Gusto ko ito.
Dialogue: 0,0:40:21.72,0:40:24.76,Default,shooting gallery2,0,0,0,,Sa iyo! Mga bastos!
Dialogue: 0,0:40:26.63,0:40:27.66,Default,shooting gallery2,0,0,0,,Damn it.
Dialogue: 0,0:40:32.50,0:40:33.80,Default,shooting gallery2,0,0,0,,Ano ang nangyayari dito?
Dialogue: 0,0:40:47.95,0:40:49.52,Default,tira2,0,0,0,,"Queen Mother of the Cho Family,
Dialogue: 0,0:40:49.52,0:40:51.52,Default,tyra2,0,0,0,,guilty sa pagkalat ng tsismis,
Dialogue: 0,0:40:51.72,0:40:53.42,Default,tyra2,0,0,0,,na sumisira sa pangalan ng reyna
Dialogue: 0,0:40:53.62,0:40:55.36,Default,tyra2,0,0,0,,at pinahiya ang maharlikang pamilya,
Dialogue: 0,0:40:56.26,0:40:58.36,Default,shooting2,0,0,0,,bilang parusa sa paghahasik ng kaguluhan sa bansa
Dialogue: 0,0:40:59.36,0:41:01.16,Default,shooting gallery2,0,0,0,,ay ipapatapon sa Western Palace."
Dialogue: 0,0:41:03.30,0:41:05.30,Default,shooting gallery2,0,0,0,,Isa na naman itong pagsasabwatan.
Dialogue: 0,0:41:06.27,0:41:09.47,Default,shooting gallery2,0,0,0,,Wala akong ginawang ganyan.
Dialogue: 0,0:41:09.47,0:41:12.47,Default,shooting gallery2,0,0,0,,Nagsasabi ka ba ng totoo?
Dialogue: 0,0:41:14.91,0:41:17.21,Default,shooting2,0,0,0,,Isinusumpa ko ang karangalan ng yumaong hari.
Dialogue: 0,0:41:17.58,0:41:20.75,Default,shooting2,0,0,0,,Wala akong ginawang ganyan.
Dialogue: 0,0:41:24.72,0:41:25.82,Default,shooting gallery2,0,0,0,,Enter.
Dialogue: 0,0:41:46.14,0:41:48.71,Default,shooting gallery2,0,0,0,,"Ang ari-arian ng mga sumusunod na kriminal ay kukumpiskahin,
Dialogue: 0,0:41:49.01,0:41:50.38,Default,shooting gallery2,0,0,0,,at sila mismo ay hahagupitin ng 100 beses
Dialogue: 0,0:41:50.38,0:41:52.11,Default,tyra2,0,0,0,,at ipapadala bilang mga alipin sa Isla ng Jeju.
Dialogue: 0,0:41:52.31,0:41:54.85,Default,tyra2,0,0,0,,Hindi paparusahan ang kanilang mga anak at asawa.
Dialogue: 0,0:41:56.25,0:41:58.02,Default,tira2,0,0,0,,Dating Konsehal ng Estado Kim Byung-hak,
Dialogue: 0,0:41:58.49,0:42:00.02,Default,tyra2,0,0,0,,dating kanang tagapayo na si Cho Man-heon,
Dialogue: 0,0:42:00.45,0:42:02.19,Default,tyra2,0,0,0,,dating kaliwang adviser na si Kim Seok-keun,
Dialogue: 0,0:42:02.19,0:42:03.96,Default,tira2,0,0,0,,dating Ministro ng Digmaan Kim Chang-hyuk,
Dialogue: 0,0:42:04.43,0:42:06.13,Default,tira2,0,0,0,,dating punong kalihim Kim Soheun,
Dialogue: 0,0:42:06.49,0:42:08.20,Default,tyra2,0,0,0,,dating Ministro ng mga Opisyal Jo Dong-mun
Dialogue: 0,0:42:08.80,0:42:10.13,Default,shooting gallery2,0,0,0,,at iba pa mula sa listahang ito
Dialogue: 0,0:42:10.13,0:42:11.87,Default,shooting gallery2,0,0,0,,hindi isasagawa.
Dialogue: 0,0:42:11.87,0:42:13.53,Default,shooting gallery2,0,0,0,,Ang kanilang ari-arian ay kukumpiskahin.
Dialogue: 0,0:42:13.53,0:42:15.87,Default,tyra2,0,0,0,,Ang kanilang termino ng pagkakakulong ay 3 taon."
Dialogue: 0,0:42:16.74,0:42:20.11,Default,shooting2,0,0,0,,-Maawa ka, Kamahalan.\N-Maawa ka, Kamahalan.
Dialogue: 0,0:42:21.28,0:42:23.28,Default,pineapple 3,0,0,0,,Wala kaming choice!
Dialogue: 0,0:42:23.74,0:42:26.41,Default,pineapple 3,0,0,0,,Binanta kami ni Kim Byungin!
Dialogue: 0,0:42:26.41,0:42:29.62,Default,pinya 3,0,0,0,,Sa ating isipan
Dialogue: 0,0:42:30.15,0:42:33.82,Default,pinya 3,0,0,0,,hindi sumagi sa isip ko na magplano ng pagtataksil!
Dialogue: 0,0:42:34.19,0:42:36.96,Default,pinya 3,0,0,0,,Iligtas mo kami, Kamahalan!
Dialogue: 0,0:42:37.12,0:42:38.89,Default,pinya 3,0,0,0,,Lahat po sir!
Dialogue: 0,0:42:38.89,0:42:41.16,Default,pinya 3,0,0,0,,Ang kasalanan lang natin ay,
Dialogue: 0,0:42:41.16,0:42:44.07,Default,pineapple 3,0,0,0,,na naniwala kami sa balita ng iyong kamatayan.
Dialogue: 0,0:42:44.37,0:42:47.54,Default,pinya 3,0,0,0,,Ang ating pagiging mapaniwalaan ay ating kasalanan!
Dialogue: 0,0:42:48.60,0:42:49.70,Default,pinya 3,0,0,0,,Ganun ba?
Dialogue: 0,0:42:50.61,0:42:53.57,Default,pineapple 3,0,0,0,,Pagkatapos ay sasabihin ko sa iyo kung ano pa ang nagawa mong mali.
Dialogue: 0,0:42:58.41,0:42:59.68,Default,pinya 3,0,0,0,,Sa Joseon
Dialogue: 0,0:43:01.18,0:43:03.32,Default,pineapple 3,0,0,0,,may kasalanan ang mga wallet na puno ng barya.
Dialogue: 0,0:43:04.05,0:43:07.36,Default,pinya 3,0,0,0,,May mahirap ba sa inyo?
Dialogue: 0,0:43:09.09,0:43:12.56,Default,pineapple 3,0,0,0,,Pwersa sa mga karaniwang tao na magtrabaho\Hanggang sa pagod, binusog mo ang iyong tiyan.
Dialogue: 0,0:43:12.96,0:43:15.06,Default,pinya 3,0,0,0,,Nakalimutan mo na ang iyong pangunahing gawain ay
Dialogue: 0,0:43:15.06,0:43:16.80,Default,pineapple 3,0,0,0,,gawin ang lahat para sa kapakanan ng mga tao.
Dialogue: 0,0:43:17.03,0:43:19.80,Default,pineapple 3,0,0,0,,Akala mo ang iyong sarili ay nasa itaas nito,\Wala kang pakialam sa iyong utang.
Dialogue: 0,0:43:20.33,0:43:22.10,Default,pinya 3,0,0,0,,Pinilit ang mga ordinaryong tao
Dialogue: 0,0:43:22.10,0:43:24.14,Default,pineapple 3,0,0,0,,araro ang bulubunduking lupain.
Dialogue: 0,0:43:24.51,0:43:26.84,Default,pineapple 3,0,0,0,,At patuloy kang nagtataas at nagtaas ng buwis.
Dialogue: 0,0:43:27.68,0:43:30.85,Default,pinya 3,0,0,0,,Habang nabubuhay ka sa karangyaan at walang alam sa mga problema,
Dialogue: 0,0:43:30.85,0:43:33.55,Default,pinya 3,0,0,0,,namatay ang mga tao ng Joseon araw at gabi
Dialogue: 0,0:43:33.55,0:43:34.98,Default,pinya 3,0,0,0,,mula sa kahirapan at gutom.
Dialogue: 0,0:43:35.32,0:43:36.88,Default,pineapple 3,0,0,0,,Paano kumita ng mas malaki?
Dialogue: 0,0:43:36.88,0:43:38.35,Default,pineapple 3,0,0,0,,Paano tumaas?
Dialogue: 0,0:43:38.35,0:43:39.89,Default,pineapple 3,0,0,0,,Paano maging mas maimpluwensya?
Dialogue: 0,0:43:39.89,0:43:41.29,Default,pinya 3,0,0,0,,Naisip mo na ba ito,
Dialogue: 0,0:43:41.29,0:43:43.76,Default,pinya 3,0,0,0,,hindi ang paghihirap ng aking mga tao!
Dialogue: 0,0:43:44.33,0:43:45.93,Default,pineapple 3,0,0,0,,Wala kang pakialam sa kanya!
Dialogue: 0,0:43:47.23,0:43:49.36,Default,pinya 3,0,0,0,,Ang buhay ng mga tao ay puno ng pagdurusa.
Dialogue: 0,0:43:53.03,0:43:54.70,Default,pinya 3,0,0,0,,Ang iyong unang kasalanan ay,
Dialogue: 0,0:43:54.70,0:43:57.57,Default,pineapple 3,0,0,0,,na akala mo mas mahalaga ang buhay mo kaysa sa kanila.
Dialogue: 0,0:43:58.14,0:43:59.54,Default,pinya 3,0,0,0,,Ang iyong pangalawang kasalanan ay ikaw
Dialogue: 0,0:43:59.54,0:44:01.91,Default,pineapple 3,0,0,0,, tinutuya nila ang mga tao,\Ninaalis ang anumang pag-asa para sa hinaharap.
Dialogue: 0,0:44:02.41,0:44:04.55,Default,pinya 3,0,0,0,,Ang kawalan ng pag-asa ng mga ama, dahil sila ay walang kapangyarihan,\Nang desperasyon ng hari,
Dialogue: 0,0:44:04.55,0:44:06.51,Default,pinya 3,0,0,0,,dahil walang silbi para sa bansa,
Dialogue: 0,0:44:06.51,0:44:08.58,Default,pinya 3,0,0,0,,narito ang iyong pangatlong kasalanan!
Dialogue: 0,0:44:10.38,0:44:12.39,Default,pinya 3,0,0,0,,Kung sinisiraan ka nila,
Dialogue: 0,0:44:13.89,0:44:15.16,Default,pineapple 3,0,0,0,,lumapit.
Dialogue: 0,0:44:21.16,0:44:23.66,Default,pinya 3,0,0,0,,Alalahanin ang iyong mga kasalanan.
Dialogue: 0,0:44:25.57,0:44:26.73,Default,pinya 3,0,0,0,,Magsisi.
Dialogue: 0,0:44:27.87,0:44:29.20,Default,pinya 3,0,0,0,,Ikaw lang
Dialogue: 0,0:44:30.74,0:44:32.91,Default,pineapple 3,0,0,0,,mga walang prinsipyong magnanakaw.
Dialogue: 0,0:44:33.34,0:44:35.28,Default,pinya 3,0,0,0,,Pero syempre!
Dialogue: 0,0:44:41.32,0:44:43.22,Default,pinya 3,0,0,0,,-Nilalang!\N-Mamatay!
Dialogue: 0,0:44:43.22,0:44:46.42,Default,pineapple 3,0,0,0,,-Hayup!\N-Punit-pirasuhin ito!
Dialogue: 0,0:44:46.42,0:44:48.19,Default,pinya 3,0,0,0,,-Mamatay!\N-Nilalang!
Dialogue: 0,0:44:48.19,0:44:49.59,Default,pineapple 3,0,0,0,,-Bastard!\N-Parusahan siya!
Dialogue: 0,0:44:49.59,0:44:52.19,Default,pinya 3,0,0,0,,-Mamatay!\N-Nilalang!
Dialogue: 0,0:44:52.19,0:44:53.53,Default,pinya 3,0,0,0,,-Kaya ikaw!\N-Bayaran mo ang iyong mga kasalanan!
Dialogue: 0,0:44:53.53,0:44:56.36,Default,pinya 3,0,0,0,,-Nararapat kang mamatay!\N-Nakakaloka!
Dialogue: 0,0:44:56.36,0:44:58.50,Default,pineapple 3,0,0,0,,-Serves you right!\N-Mamatay!
Dialogue: 0,0:45:21.96,0:45:23.62,Default,pineapple 3,0,0,0,,Iwan mo na lang dito.
Dialogue: 0,0:45:24.53,0:45:26.46,Default,pineapple 3,0,0,0,,Pero palagi kang nagme-makeup.
Dialogue: 0,0:45:27.46,0:45:29.53,Default,pinya 3,0,0,0,,Alam kong bawal kang umalis sa Western Palace
Dialogue: 0,0:45:29.53,0:45:31.50,Default,pineapple 3,0,0,0,,o may makilala.
Dialogue: 0,0:45:31.77,0:45:32.97,Default,pinya 3,0,0,0,,Ngunit pa rin...
Dialogue: 0,0:45:36.50,0:45:38.84,Default,pinya 3,0,0,0,,Pinananatili kitang kasama,
Dialogue: 0,0:45:39.61,0:45:42.21,Default,pineapple 3,0,0,0,,dahil isa kang walang utak na chatterbox.
Dialogue: 0,0:45:42.74,0:45:45.38,Default,pineapple 3,0,0,0,,Hindi ka isa sa mga lihim na makapagplano ng isang bagay.
Dialogue: 0,0:45:47.08,0:45:48.22,Default,pineapple 3,0,0,0,,Tama.
Dialogue: 0,0:45:49.38,0:45:52.65,Default,pineapple 3,0,0,0,,Nabubuhay tayong lahat sa iba't ibang paraan.
Dialogue: 0,0:45:52.82,0:45:53.89,Default,pinya 3,0,0,0,,Kamahalan,
Dialogue: 0,0:45:55.19,0:45:57.89,Default,pineapple 3,0,0,0,,bakit hindi mo ako sinisigawan?
Dialogue: 0,0:45:59.63,0:46:02.73,Default,pineapple 3,0,0,0,,Hindi ko natutunang itikom ang aking bibig.
Dialogue: 0,0:46:03.40,0:46:08.07,Default,pineapple 3,0,0,0,,Kahit hindi ako umiiyak,\Nbakit ka umiiyak?
Dialogue: 0,0:46:08.50,0:46:10.07,Default,pinya 3,0,0,0,,Kamahalan!
Dialogue: 0,0:46:20.68,0:46:22.68,Default,pineapple 3,0,0,0,,I will survive everything.
Dialogue: 0,0:46:28.79,0:46:30.42,Default,pinya 3,0,0,0,,Mabuhay para sa akin -
Dialogue: 0,0:46:31.69,0:46:33.99,Default,pineapple 3,0,0,0,,nangangahulugang panalo.
Dialogue: 0,0:47:27.88,0:47:30.58,Default,pineapple 3,0,0,0,,Hawakan mo ang kamay ko hanggang makaalis tayo dito.
Dialogue: 0,0:47:31.19,0:47:32.22,Default,pineapple 3,0,0,0,,Ano ang balak mo?
Dialogue: 0,0:47:32.29,0:47:33.55,Default,pinya 3,0,0,0,,Kung may mga alaala niya,
Dialogue: 0,0:47:36.02,0:47:38.29,Default,pineapple 3,0,0,0,,kaya nasa loob mo pa rin si Soyeon.
Dialogue: 0,0:47:41.66,0:47:44.13,Default,pineapple 3,0,0,0,,Nahanap mo ulit ako, Benin.
Dialogue: 0,0:47:46.67,0:47:48.77,Default,pineapple 3,0,0,0,,At nagtago ako ng maayos.
Dialogue: 0,0:48:34.08,0:48:35.52,Default,pineapple 3,0,0,0,,-Paumanhin, reyna.\N-Paumanhin, reyna.
Dialogue: 0,0:48:36.48,0:48:38.89,Default,pineapple 3,0,0,0,,Natutuwa akong marinig na nagsasaya ka.
Dialogue: 0,0:48:41.56,0:48:43.02,Default,pineapple 3,0,0,0,,-Paumanhin, reyna.\N-Paumanhin, reyna.
Dialogue: 0,0:48:48.56,0:48:50.63,Default,pineapple 3,0,0,0,,Napakalaki ng pinagbago mo, Kamahalan.
Dialogue: 0,0:48:52.17,0:48:54.64,Default,pineapple 3,0,0,0,,After the wedding, I wasn’t myself, right?
Dialogue: 0,0:48:56.50,0:48:57.61,Default,pinya 3,0,0,0,,Lahat dahil,
Dialogue: 0,0:48:59.74,0:49:02.81,Default,pineapple 3,0,0,0,,na ang pamagat na ito\Nay naging isang mahusay na pagsubok para sa akin.
Dialogue: 0,0:49:02.81,0:49:07.25,Default,pineapple 3,0,0,0,,Nagbago ka na bago ang iyong kasal, Kamahalan.
Dialogue: 0,0:49:15.69,0:49:18.13,Default,pinya 3,0,0,0,,Pagkatapos naisip ko na ang tanging paraan ay
Dialogue: 0,0:49:19.86,0:49:22.00,Default,pineapple 3,0,0,0,,ito ang kamatayan.
Dialogue: 0,0:49:40.51,0:49:44.89,Default,pinya 3,0,0,0,,Hindi dapat ako pumunta dito\NJang Bong-hwan
Dialogue: 0,0:49:46.89,0:49:49.09,Default,pineapple 3,0,0,0,,Nakauwi ka ba nang walang problema?
Dialogue: 0,0:49:58.73,0:50:00.53,Default,pinya 3,0,0,0,,Kamahalan!
Dialogue: 0,0:50:03.40,0:50:05.04,Default,pinya 3,0,0,0,,-Tatay!\N-Hindi pwede!
Dialogue: 0,0:50:05.47,0:50:07.34,Default,pineapple 3,0,0,0,,Ang hirap mong maglakad, manahimik ka!
Dialogue: 0,0:50:07.61,0:50:09.78,Default,pinya 3,0,0,0,,Ako na mismo ang lalabas!
Dialogue: 0,0:50:14.82,0:50:16.58,Default,pineapple 3,0,0,0,,-Kamusta ang pakiramdam mo?\N-Kamusta ang pakiramdam mo?
Dialogue: 0,0:50:17.95,0:50:19.65,Default,pineapple 3,0,0,0,,Magsalita ka muna, ama.
Dialogue: 0,0:50:19.65,0:50:21.79,Default,pineapple 3,0,0,0,,Ayos ang lahat! Halika na!
Dialogue: 0,0:50:22.56,0:50:23.82,Default,pineapple 3,0,0,0,,-Okay lang ako.\N-Okay lang ako.
Dialogue: 0,0:50:30.36,0:50:31.67,Default,pinya 3,0,0,0,,Kumusta ka?
Dialogue: 0,0:50:31.67,0:50:33.17,Default,pineapple 3,0,0,0,,Mabagal.
Dialogue: 0,0:50:33.17,0:50:34.80,Default,pineapple 3,0,0,0,,Nabubuhay ako sa iyong mga panalangin.
Dialogue: 0,0:50:35.20,0:50:36.84,Default,pinya 3,0,0,0,,Kapag sa panahon ng seremonya
Dialogue: 0,0:50:36.84,0:50:38.44,Default,pinya 3,0,0,0,,pumasok sa gate ang mga rebelde,
Dialogue: 0,0:50:38.44,0:50:40.97,Default,pineapple 3,0,0,0,,nasindak ang lahat ng maharlika.
Dialogue: 0,0:50:41.24,0:50:44.88,Default,pinya 3,0,0,0,,Ngunit ang mga taganayon ay pumunta sa aking bahay upang protektahan kami.
Dialogue: 0,0:50:45.31,0:50:47.25,Default,pineapple 3,0,0,0,,Mabait daw akong tao
Dialogue: 0,0:50:47.25,0:50:49.15,Default,pineapple 3,0,0,0,,at nakatulong ng malaki sa kanila!
Dialogue: 0,0:50:51.05,0:50:54.29,Default,pineapple 3,0,0,0,,Sinusunod ko lang ang iyong mga tagubilin,
Dialogue: 0,0:50:54.52,0:50:57.16,Default,pineapple 3,0,0,0,,kaya sobrang nahihiya ako.
Dialogue: 0,0:50:58.83,0:51:00.83,Default,pineapple 3,0,0,0,,Mula ngayon, ikaw na mismo ang mabait.
Dialogue: 0,0:51:00.99,0:51:02.90,Default,pineapple 3,0,0,0,,Siyempre.
Dialogue: 0,0:51:03.86,0:51:06.07,Default,pinya 3,0,0,0,,Ako ay magiging isang iginagalang na lolo
Dialogue: 0,0:51:06.07,0:51:08.34,Default,pineapple 3,0,0,0,,para sa iyong anak.
Dialogue: 0,0:51:11.11,0:51:13.34,Default,pineapple 3,0,0,0,,Oh, nagtutulak si baby.
Dialogue: 0,0:51:14.31,0:51:15.84,Default,pinya 3,0,0,0,,Itinulak na?
Dialogue: 0,0:51:21.52,0:51:24.19,Default,pinya 3,0,0,0,,Magiging henyo ang apo ko!
Dialogue: 0,0:51:34.10,0:51:36.24,Default,pinya 3,0,0,0,,Siguro masyadong malakas ang amoy ng sibuyas?
Dialogue: 0,0:51:36.58,0:51:39.12,Default,pineapple 3,0,0,0,,Ano ang masigasig mong niluluto?
Dialogue: 0,0:51:40.72,0:51:44.45,Default,pinya 3,0,0,0,,Gusto kong subukan ulitin ang ramen,
Dialogue: 0,0:51:44.45,0:51:45.78,Default,pinya 3,0,0,0,,na inihahanda ng reyna.
Dialogue: 0,0:51:47.66,0:51:51.35,Default,pinya 3,0,0,0,,Pwede ba akong kumuha ng ramen?
Dialogue: 0,0:52:04.41,0:52:05.87,Default,pineapple 3,0,0,0,,Be patient.
Dialogue: 0,0:52:09.08,0:52:11.37,Default,pineapple 3,0,0,0,,Akala ko mananalo tayo at magsisimula ang buhay,
Dialogue: 0,0:52:12.05,0:52:13.22,Default,pineapple 3,0,0,0,,at higit pang trabaho.
Dialogue: 0,0:52:14.72,0:52:16.01,Default,pineapple 3,0,0,0,,Walang tao.
Dialogue: 0,0:52:16.64,0:52:18.89,Default,pinya 3,0,0,0,,Hon Duil!
Dialogue: 0,0:52:18.89,0:52:20.58,Default,pinya 3,0,0,0,,Busy ako! Tapos maglalaro tayo!
Dialogue: 0,0:52:21.76,0:52:23.45,Default,pineapple 3,0,0,0,,Pagod na ako sa pagsusugal.
Dialogue: 0,0:52:24.95,0:52:26.03,Default,pineapple 3,0,0,0,,Talaga?
Dialogue: 0,0:52:29.62,0:52:32.87,Default,pinya 3,0,0,0,,Para sa aking kontribusyon sa tagumpay
Dialogue: 0,0:52:32.87,0:52:36.43,Default,pineapple 3,0,0,0,,binigyan ako ng hari ng posisyon sa korte.
Dialogue: 0,0:52:37.93,0:52:39.01,Default,pinya 3,0,0,0,,At narito ako
Dialogue: 0,0:52:39.74,0:52:41.64,Default,pineapple 3,0,0,0,,nananatili sa parehong post.
Dialogue: 0,0:52:42.85,0:52:44.74,Default,pinya 3,0,0,0,,Hingin ang posisyon ng ministro?
Dialogue: 0,0:52:54.49,0:52:56.16,Default,pineapple 3,0,0,0,,Ano ba yang halimaw na yan sa mukha mo?
Dialogue: 0,0:52:57.28,0:52:59.49,Default,pineapple 3,0,0,0,,Gaano ka kaluma.
Dialogue: 0,0:53:02.53,0:53:06.39,Default,pineapple 3,0,0,0,,Naglilingkod ako ngayon sa departamento ng mga relasyong panlabas.
Dialogue: 0,0:53:06.80,0:53:11.07,Default,pineapple 3,0,0,0,,Para sa isang taong may talento\NJoseon lang ay hindi magiging sapat.
Dialogue: 0,0:53:18.58,0:53:20.97,Default,pineapple 3,0,0,0,,Binabati kita sa pagtigil sa paglalaro.
Dialogue: 0,0:53:21.51,0:53:22.64,Default,pinya 3,0,0,0,,Kumusta naman ang layunin?
Dialogue: 0,0:53:22.64,0:53:24.35,Default,pinya 3,0,0,0,,Batiin ka sa kung ano ang gusto mo
Dialogue: 0,0:53:24.35,0:53:26.05,Default,pineapple 3,0,0,0,,lakad hanggang mapagod ang iyong mga binti?
Dialogue: 0,0:53:28.18,0:53:32.93,Default,pineapple 3,0,0,0,,Nabigla pa rin ako na si Lee Senman ang ating reyna.
Dialogue: 0,0:53:32.93,0:53:35.87,Default,pineapple 3,0,0,0,,At nabigla pa rin ako na hindi mo ito nakuha kaagad.
Dialogue: 0,0:53:36.10,0:53:38.43,Default,pineapple 3,0,0,0,,Duil, tapos ka na...
Dialogue: 0,0:53:39.87,0:53:41.87,Default,pinya 3,0,0,0,,Oh! At nandito ka.
Dialogue: 0,0:53:43.01,0:53:45.03,Default,pinya 3,0,0,0,,Long time no see, Jeong Chul!
Dialogue: 0,0:53:47.85,0:53:50.87,Default,pineapple 3,0,0,0,,Kung si Lee Senman ang reyna, ikaw...
Dialogue: 0,0:53:57.41,0:53:59.32,Default,pineapple 3,0,0,0,,Babae ka rin.
Dialogue: 0,0:54:01.33,0:54:03.05,Default,pineapple 3,0,0,0,,Kim Hwan, I adore you.
Dialogue: 0,0:54:03.45,0:54:04.85,Default,pinya 3,0,0,0,,Napakatalino mo!
Dialogue: 0,0:54:07.39,0:54:10.07,Default,pineapple 3,0,0,0,,Nabalitaan ko na binigyan ka ng post sa court.
Dialogue: 0,0:54:10.62,0:54:12.37,Default,pineapple 3,0,0,0,,Ang hari mismo ang nagbigay nito sa akin.
Dialogue: 0,0:54:14.53,0:54:15.91,Default,pinya 3,0,0,0,,Para saan ang aking mga kasalanan?
Dialogue: 0,0:54:23.41,0:54:26.32,Default,li,0,0,0,,-Samvol, pasok ka sa bahay.\N-Okay.
Dialogue: 0,0:54:30.82,0:54:31.91,Default,li,0,0,0,,Bakit ka nandito?
Dialogue: 0,0:54:32.16,0:54:34.78,Default,li,0,0,0,,Malamig sa labas. Gaano ka katagal naghintay?
Dialogue: 0,0:54:34.78,0:54:37.39,Default,o,0,0,0,,Hindi. ako lang...
Dialogue: 0,0:54:39.89,0:54:41.12,Default,li,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:54:49.03,0:54:51.47,Default,o,0,0,0,,Isang cramp lang.
Dialogue: 0,0:54:55.95,0:54:57.58,Default,li,0,0,0,,Kumusta ka?
Dialogue: 0,0:54:59.01,0:55:00.01,Default,li,0,0,0,,Okay.
Dialogue: 0,0:55:00.62,0:55:02.55,Default,li,0,0,0,,Ayos lang ang Kamahalan.
Dialogue: 0,0:55:02.55,0:55:03.55,Default,o,0,0,0,,Hindi.
Dialogue: 0,0:55:04.68,0:55:05.99,Default,li,0,0,0,,Nagtatanong ako tungkol sa iyo.
Dialogue: 0,0:55:09.28,0:55:10.43,Default,li,0,0,0,,I...
Dialogue: 0,0:55:22.74,0:55:26.24,Default,li,0,0,0,,Ang sitwasyon sa Ijeongcheon Department ay naging matatag.
Dialogue: 0,0:55:26.43,0:55:28.64,Default,li,0,0,0,,Salamat sa kanya, napuno ako ng trabaho.
Dialogue: 0,0:55:31.14,0:55:33.97,Default,li,0,0,0,,So, ano ang susunod?
Dialogue: 0,0:55:34.32,0:55:35.39,Default,li,0,0,0,,Gusto ko
Dialogue: 0,0:55:36.45,0:55:39.16,Default,kung,0,0,0,,magbigay ng kapangyarihan sa bawat tao,
Dialogue: 0,0:55:39.82,0:55:42.12,Default,o,0,0,0,,para kapag nagtitipon ang mga tao, mas may kapangyarihan sila kaysa sa akin.
Dialogue: 0,0:55:42.85,0:55:46.70,Default,o,0,0,0,,Sa ganitong paraan hindi na sila mapagsamantalahan ng mga tiwaling opisyal.
Dialogue: 0,0:55:47.39,0:55:49.89,Default,li,0,0,0,,Naniniwala ako na ganito dapat magtapos
Dialogue: 0,0:55:51.80,0:55:53.49,Default,li,0,0,0,,ito ay isang mahirap na labanan
Dialogue: 0,0:55:54.64,0:55:56.07,Default,li,0,0,0,,at isang magandang paglalakbay.
Dialogue: 0,0:55:56.74,0:55:58.87,Default,li,0,0,0,,Gusto mong sabihin na mas marami akong alalahanin.
Dialogue: 0,0:55:58.87,0:56:00.74,Default,li,0,0,0,,Tapusin na natin ito.
Dialogue: 0,0:56:00.74,0:56:02.30,Default,li,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:56:05.08,0:56:07.01,Default,li,0,0,0,,Uwi na tayo.
Dialogue: 0,0:56:07.01,0:56:08.74,Default,o,0,0,0,,Maaari kang magpatuloy bukas ng umaga.
Dialogue: 0,0:56:09.45,0:56:10.99,Default,li,0,0,0,,Hindi tayo magkakasundo.
Dialogue: 0,0:56:13.16,0:56:14.55,Default,li,0,0,0,,Una, ayusin ang mga bagay...
Dialogue: 0,0:56:14.72,0:56:16.22,Default,li,0,0,0,,-Magandang gabi.\N-Okay.
Dialogue: 0,0:56:17.39,0:56:20.10,Default,li,0,0,0,,Duil, kailangan mong gumawa...
Dialogue: 0,0:56:20.35,0:56:21.39,Default,li,0,0,0,,Duil!
Dialogue: 0,0:56:21.72,0:56:23.66,Default,li,0,0,0,,Ang tanga.
Dialogue: 0,0:56:47.51,0:56:50.26,Default,li,0,0,0,,Queen's Dictionary
Dialogue: 0,0:56:59.33,0:57:01.53,Default,o,0,0,0,,May kulang ba ako?
Dialogue: 0,0:57:04.97,0:57:06.91,Default,li,0,0,0,,Minsan parang...
Dialogue: 0,0:57:10.37,0:57:11.51,Default,li,0,0,0,,Ginawa niya.
Dialogue: 0,0:57:12.22,0:57:13.41,Default,li,0,0,0,,Nagtagumpay siya.
Dialogue: 0,0:57:13.41,0:57:14.45,Default,li,0,0,0,,Ang panahon ng paghahari ni Haring Cheoljo
Dialogue: 0,0:57:27.26,0:57:30.99,Default,li,0,0,0,,Mga Chronicles of King Cheoljo
Dialogue: 0,0:57:35.20,0:57:36.20,Default,li,0,0,0,,My queen.
Dialogue: 0,0:57:41.14,0:57:42.45,Default,o,0,0,0,,Hindi nakakatawa?
Dialogue: 0,0:58:04.12,0:58:05.20,Default,lee,0,0,0,,Jang Bong-hwan!
Dialogue: 0,0:58:09.64,0:58:10.70,Default,li,0,0,0,,Huwag kang lalapit.
Dialogue: 0,0:58:12.93,0:58:14.68,Default,li,0,0,0,,Kailangan mo munang hanapin si Khan.
Dialogue: 0,0:58:15.08,0:58:17.74,Default,0,0,0,,Hindi, mas mabilis bang makipag-ugnayan kaagad sa media?
Dialogue: 0,0:58:18.64,0:58:21.64,Default,li,0,0,0,,Bakit ka tumatakas? Napakaganda ng ginawa niya!
Dialogue: 0,0:58:22.89,0:58:23.95,Default,o,0,0,0,,Magandang gawa?
Dialogue: 0,0:58:25.41,0:58:27.45,Default,li,0,0,0,,Kung gayon bakit mo ako sinusundan?
Dialogue: 0,0:58:28.08,0:58:29.45,Default,o,0,0,0,,Pinoprotektahan ka namin dahil
Dialogue: 0,0:58:29.45,0:58:31.22,Default,o,0,0,0,,nagbigay ka ng tip para sa kapakanan ng publiko.
Dialogue: 0,0:58:31.55,0:58:32.55,Default,0,0,0,,Maganda ba?
Dialogue: 0,0:58:32.55,0:58:35.87,Default,li,0,0,0,,Naaalala mo ba ang camera sa bodega?
Dialogue: 0,0:58:35.87,0:58:37.62,Default,li,0,0,0,,Inayos mo ito nang palihim.
Dialogue: 0,0:58:38.10,0:58:39.16,Default,li,0,0,0,,Ako?
Dialogue: 0,0:58:45.93,0:58:46.93,Default,li,0,0,0,,Maghintay.
Dialogue: 0,0:58:55.18,0:58:56.99,Default,o,0,0,0,,Nakokontrol mo ba ang camera?
Dialogue: 0,0:58:57.91,0:58:59.95,Default,li,0,0,0,,Kakaiba na sira pa.
Dialogue: 0,0:59:00.35,0:59:01.55,Default,li,0,0,0,,Kailangan nating mahuli ang magnanakaw.
Dialogue: 0,0:59:03.18,0:59:05.16,Default,li,0,0,0,,Bakit ka gumagawa ng kalokohan?
Dialogue: 0,0:59:05.45,0:59:06.85,Default,li,0,0,0,,Mukhang hindi ikaw iyon.
Dialogue: 0,0:59:06.85,0:59:09.66,Default,o,0,0,0,,Eksakto. Bakit hindi nila sinabi sa akin ng mas maaga?
Dialogue: 0,0:59:10.26,0:59:11.80,Default,li,0,0,0,,Nagawa ko na ang mga bagay.
Dialogue: 0,0:59:12.57,0:59:14.14,Default,li,0,0,0,,-Ano?\N-Ipinadala ko ang footage ng camera
Dialogue: 0,0:59:14.14,0:59:17.24,Default,o,0,0,0,,libre sa media, na hindi karaniwan para sa akin.
Dialogue: 0,0:59:19.43,0:59:21.47,Default,li,0,0,0,,Nagsisinungaling siya.
Dialogue: 0,0:59:21.85,0:59:22.95,Default,li,0,0,0,,Oo, eksakto.
Dialogue: 0,0:59:23.45,0:59:26.78,Default,lee,0,0,0,,Ang Bonghwan na kilala ko ay walang pakialam sa hustisya.
Dialogue: 0,0:59:26.78,0:59:28.62,Default,li,0,0,0,,Una na sana siya sa akin
Dialogue: 0,0:59:28.62,0:59:32.05,Default,o,0,0,0,,at sumang-ayon bago magpadala ng mga tala. Mali ba ako?
Dialogue: 0,0:59:34.22,0:59:35.22,Default,o,0,0,0,,Tama.
Dialogue: 0,0:59:36.18,0:59:37.43,Default,li,0,0,0,,I'm such a scoundrel.
Dialogue: 0,0:59:38.20,0:59:39.22,Default,li,0,0,0,,Pero alam mo kung ano?
Dialogue: 0,0:59:40.49,0:59:42.33,Default,li,0,0,0,,-Nagbago na ako.\N-Talaga?
Dialogue: 0,0:59:43.16,0:59:44.62,Default,kung,0,0,0,,-Bakit?\N-Hindi ko alam.
Dialogue: 0,0:59:45.33,0:59:46.57,Default,li,0,0,0,,Gusto ko lang.
Dialogue: 0,0:59:50.87,0:59:52.08,Default,li,0,0,0,,Bastos ka!
Dialogue: 0,0:59:58.45,0:59:59.47,Default,lee,0,0,0,,Chief Poo!
Dialogue: 0,1:00:01.12,1:00:02.18,Default,li,0,0,0,,Chief Poo!
Dialogue: 0,1:00:04.32,1:00:06.68,Default,li,0,0,0,,-Damn.\N-Moron.
Dialogue: 0,1:00:17.26,1:00:19.97,Default,li,0,0,0,,Nagawa ni Cheoljong na baguhin ang kanyang kapalaran,
Dialogue: 0,1:00:20.26,1:00:21.47,Default,li,0,0,0,,at nagbago na rin ako.
Dialogue: 0,1:00:23.30,1:00:25.10,Default,li,0,0,0,,Pero bakit ganun pa rin si Direk Han?
Dialogue: 0,1:00:29.35,1:00:30.78,Default,o,0,0,0,,
Dialogue: 0,1:00:32.91,1:00:34.82,Default,li,0,0,0,,Choljo
Dialogue: 0,1:00:35.91,1:00:38.85,Default,li,0,0,0,,Hindi ba talaga nagbago ang mundo?
Dialogue: 0,1:00:39.49,1:00:41.66,Default,0,0,0,,Ako at si Cheoljong lang ang nagbago?
Dialogue: 0,1:00:42.76,1:00:44.72,Default,lee,0,0,0,,Mga nagawa ni Choljo
Dialogue: 0,1:00:44.72,1:00:46.70,Default,lee,0,0,0,,Nayanig si Joseon sa karisma ni Cholzhdo
Dialogue: 0,1:00:46.70,1:00:48.72,Default,li,0,0,0,,Isinagawa ni Choljo ang reporma ng bayan
Dialogue: 0,1:00:48.72,1:00:51.10,Default,li,0,0,0,,Mga Nagawa ni Haring Cheoljo at Reyna Chhorin
Dialogue: 0,1:00:51.10,1:00:52.66,Default,li,0,0,0,,Nagsilbing modelo para sa mga repormang hari
Dialogue: 0,1:00:52.66,1:00:55.03,Default,li,0,0,0,,Inilatag ni Choljo ang pundasyon para sa demokrasya
Dialogue: 0,1:00:57.26,1:00:59.30,Default,li,0,0,0,,-Magkomento.\N-Magsabi ng ilang salita!
Dialogue: 0,1:00:59.30,1:01:01.47,Default,li,0,0,0,,-Ilang salita lang!\N-Aminin mo ba ang mga singil?
Dialogue: 0,1:01:01.47,1:01:03.45,Default,li,0,0,0,,-Narito!\N-Magkomento!
Dialogue: 0,1:01:03.45,1:01:05.87,Default,totoo ba ito?\N-Aminin mo ba ang mga singil?
Dialogue: 0,1:01:05.87,1:01:08.12,Default,ay,0,0,0,,-Totoo ba ang lahat ng pahayag?\N-Totoo ba ito?
Dialogue: 0,1:01:08.12,1:01:14.16,Default,kung,0,0,0,,Nangungurakot ng pondo si Director Han sa loob ng maraming taon
Dialogue: 0,1:01:18.05,1:01:19.53,Default,o,0,0,0,,Nagbabago ang mga oras.
Dialogue: 0,1:01:19.53,1:01:23.20,Default,li,0,0,0,,Ngunit laging nabubuhay ang mga mapanlinlang na tiwaling opisyal.
Dialogue: 0,1:01:25.26,1:01:27.87,Default,li,0,0,0,,Kahit may mga bulok na bahagi sa mundo,
Dialogue: 0,1:01:27.87,1:01:30.60,Default,o,0,0,0,,ngunit pinapayagan ka nitong putulin ang mga bulok na segment na ito.
Dialogue: 0,1:01:32.10,1:01:34.64,Default,o,0,0,0,,Kung susubukan mong baguhin ang iyong buhay para sa mas mahusay,
Dialogue: 0,1:01:34.64,1:01:36.51,Default,li,0,0,0,,magtatagumpay ka,
Dialogue: 0,1:01:37.55,1:01:39.68,Default,li,0,0,0,,tulad ko at Cheoljong.
Dialogue: 0,1:01:58.99,1:02:01.03,Default,li,0,0,0,,-Kamahalan.\N-Ano?
Dialogue: 0,1:02:01.03,1:02:02.33,Default,o,0,0,0,,Turn over.
Dialogue: 0,1:02:03.10,1:02:04.14,Default,o,0,0,0,,Eksakto.
Dialogue: 0,1:02:09.20,1:02:12.22,Default,o,0,0,0,,Kamahalan, nahihirapan ka bang mag-concentrate?
Dialogue: 0,1:02:12.74,1:02:14.85,Default,li,0,0,0,,Gusto ko kasing makita ang reyna,
Dialogue: 0,1:02:15.49,1:02:17.01,Default,o,0,0,0,,na wala akong maisip.
Dialogue: 0,1:02:20.51,1:02:21.66,Default,o,0,0,0,,Hindi ito gagana.
Dialogue: 0,1:02:22.33,1:02:24.68,Default,li,0,0,0,,Makikita ko ang reyna at pagkatapos ay aasikasuhin ang negosyo.
Dialogue: 0,1:02:26.39,1:02:27.39,Default,o,0,0,0,,Susunod.
Dialogue: 0,1:02:28.33,1:02:30.70,Default,li,0,0,0,,Lahat ng kababaihan ng hukuman na higit sa 18
Dialogue: 0,1:02:31.74,1:02:33.26,Default,kung,0,0,0,,pinahihintulutan ang kasal.
Dialogue: 0,1:02:39.30,1:02:40.30,Default,o,0,0,0,,Oo.
Dialogue: 0,1:02:40.30,1:02:43.28,Default,o,0,0,0,,Bukod dito, mga batang wala pang 10 taong gulang
Dialogue: 0,1:02:43.28,1:02:45.47,Default,o,0,0,0,,ay hindi dapat mga courtyard servant.
Dialogue: 0,1:02:47.87,1:02:48.99,Default,li,0,0,0,,At higit pa...
Dialogue: 0,1:02:52.89,1:02:55.26,Default,li,0,0,0,,Ano ang susunod, Kamahalan?
Dialogue: 0,1:02:59.35,1:03:00.39,Default,0,0,0,,Kamahalan?
Dialogue: 0,1:03:03.26,1:03:04.53,Default,lee,0,0,0,,Paumanhin, Lady Choi.
Dialogue: 0,1:03:04.53,1:03:07.37,Default,li,0,0,0,,Nahihirapan kang mag-concentrate.
Dialogue: 0,1:03:07.66,1:03:10.03,Default,li,0,0,0,,Nakilala mo kamakailan ang Kanyang Kamahalan.
Dialogue: 0,1:03:10.64,1:03:12.53,Default,li,0,0,0,,Hindi ako. Ang bata ang nami-miss niya.
Dialogue: 0,1:03:13.24,1:03:14.58,Default,o,0,0,0,,Para sa kapakanan ng bata,
Dialogue: 0,1:03:14.87,1:03:18.20,Default,puwede ka bang,0,0,0,,pumunta sandali sa hari?
Dialogue: 0,1:03:18.55,1:03:19.68,Default,o,0,0,0,,Sumasang-ayon ako.
Dialogue: 0,1:03:24.55,1:03:25.62,Default,li,0,0,0,,-Kamahalan.\N-Ano?
Dialogue: 0,1:03:25.62,1:03:28.93,Default,li,0,0,0,,Nagtungo ang kanyang Kamahalan sa Songjeongjong Hall.
Dialogue: 0,1:03:29.85,1:03:32.35,Default,o,0,0,0,,Wow. Namiss namin ang isa't isa.
Dialogue: 0,1:03:35.30,1:03:36.93,Default,ay,0,0,0,,Ang Kanyang Kamahalan sa Daejojon?
Dialogue: 0,1:03:37.22,1:03:38.26,Default,li,0,0,0,,Oo.
Dialogue: 0,1:03:45.87,1:03:47.87,Default,li,0,0,0,,Maghintay, Kamahalan!
Dialogue: 0,1:03:48.60,1:03:50.85,Default,li,0,0,0,,Nasasabik siya. Halika na.
Dialogue: 0,1:03:58.68,1:04:01.32,Default,li,0,0,0,,Ano ito. Namiss na naman ba natin ang isa't isa?
Dialogue: 0,1:04:02.39,1:04:05.45,Default,o,0,0,0,,Lord, naglalaro ba kami ng taguan?
Dialogue: 0,1:04:13.49,1:04:14.60,Default,o,0,0,0,,Hindi ito gagana.
Dialogue: 0,1:04:15.64,1:04:16.74,Default,li,0,0,0,,Pagkatapos...
Dialogue: 0,1:04:30.39,1:04:31.89,Default,li,0,0,0,,Nagkita na kami sa wakas.
Dialogue: 0,1:04:32.41,1:04:33.45,Default,o,0,0,0,,Pagkatapos,
Dialogue: 0,1:04:35.43,1:04:37.39,Default,o,0,0,0,,ilang beses namin na-miss ang isa't isa.
Dialogue: 0,1:04:37.89,1:04:42.39,Default,li,0,0,0,,Ang mga panandaliang sandaling ito ay tila walang hanggan.
Dialogue: 0,1:05:14.35,1:05:18.39,Default,li,0,0,0,,Nga pala, bakit mo ako kinakausap ng pormal?
Dialogue: 0,1:05:19.03,1:05:21.20,Default,ikaw ba,0,0,0,,Naghahanda ka na naman ba ng isang uri ng sorpresa?
Dialogue: 0,1:06:15.33,1:06:18.04,Default,li,0,0,0,,Salamat sa panonood kasama si Azaleas
Dialogue: 0,1:06:18.77,1:06:20.60,Default,lee,0,0,0,,Espesyal na pasasalamat kay Choi Jinhyuk
Dialogue: 0,0:20:00.72,0:20:02.72,Default,,0,0,0,,

Komento: 0,0:13:13.63,0:13:15.18,Default,Biryulka,0,0,0,,Mga mapanlinlang na taktika: makaabala mula sa silangan at pag-atake mula sa kanluran.
Puna: 0,0:59:43.56,0:59:44.66,Default,li,0,0,0,,Authentic Records ng Joseon Dynasty
Komento: 0,1:04:51.30,1:04:55.57,Default,li,0,0,0,,Queen Chorin
