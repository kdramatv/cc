Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:04.02,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Zinger, Nanas, Host, Marcus
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.92,0:01:06.29,Default,nanas,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.29,0:01:09.09,Default,nanas,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:09.86,0:01:12.23,Default,nanas,0,0,0,,6 episode
Dialog: 0,0:01:12.23,0:01:13.86,Default,nanas,0,0,0,,Tepat.
Dialog: 0,0:01:14.09,0:01:18.63,Default,nanas,0,0,0,,Di bagian taktik "Catatan tentang senjata dan peralatan"
Dialog: 0,0:01:18.63,0:01:21.20,Default,nanas,0,0,0,,mengatakan jika sekutu lebih sedikit daripada musuh,
Dialog: 0,0:01:21.20,0:01:23.27,Default,nanas,0,0,0,,kita harus mundur.
Dialog: 0,0:01:23.27,0:01:27.77,Default,nanas,0,0,0,,Jika kamu tidak mampu bertahan, mundur dan...
Dialogue: 0,0:01:28.78,0:01:31.01,Default,nanas,0,0,0,,Wanita yang aneh.
Dialog: 0,0:01:32.05,0:01:34.11,Default,nanas,0,0,0,,Yang Mulia, Anda tidak akan mempercayainya.
Dialog: 0,0:01:34.11,0:01:36.62,Default,nanas,0,0,0,,Berperilaku sangat luar biasa.
Dialogue: 0,0:01:38.75,0:01:41.99,Default,nanas,0,0,0,,Berapa lama kamu bisa menari mengikuti musik kuno nenek moyangmu?
Dialog: 0,0:01:41.99,0:01:43.62,Default,nanas,0,0,0,,I
Dialog: 0,0:01:44.56,0:01:47.26,Default,nanas,0,0,0,,bertugas di pasukan khusus.
Dialog: 0,0:01:47.86,0:01:50.30,Default,nanas,0,0,0,,-Dia berbicara dengan arogan.\N-Serang.
Dialogue: 0,0:01:50.30,0:01:51.97,Default,nanas,0,0,0,,Dan kamu mungkin membayangkan dirimu menjadi seorang raja.
Dialogue: 0,0:01:51.97,0:01:53.87,Default,nanas,0,0,0,,Akulah rajanya.
Dialog: 0,0:01:56.24,0:01:57.91,Default,nanas,0,0,0,,Terima kasih.
Dialog: 0,0:01:57.91,0:02:00.87,Default,nanas,0,0,0,,Apakah kamu gila?
Dialog: 0,0:02:04.75,0:02:07.01,Default,nanas,0,0,0,,Lupakan saja, aku tidak peduli.
Dialog: 0,0:02:07.08,0:02:09.08,Default,nanas,0,0,0,,Keluar.
Dialog: 0,0:02:09.08,0:02:11.85,Default,nanas,0,0,0,,Dan bertingkah seperti orang gila.
Dialogue: 0,0:02:19.96,0:02:22.90,Default,nanas,0,0,0,,Dan terkadang seolah-olah dia adalah Buddha.
Dialog: 0,0:02:22.90,0:02:28.84,Default,nanas,0,0,0,,Tolong, jangan sentuh mereka yang tidak bersalah atas apa pun.
Dialog: 0,0:02:28.84,0:02:30.97,Default,nanas,0,0,0,,Tetapi dia marah seolah-olah roh jahat telah merasukinya.
Dialogue: 0,0:02:30.97,0:02:33.87,Default,nanas,0,0,0,,Siapa pun di tempatku pasti marah saat ini,
Dialog: 0,0:02:33.87,0:02:35.21,Default,nanas,0,0,0,,jika dia bukan Buddha.
Dialogue: 0,0:02:35.21,0:02:37.71,Default,nanas,0,0,0,,Terkadang dia adalah perwujudan kemanusiaan,
Dialog: 0,0:02:37.74,0:02:40.75,Default,nanas,0,0,0,,dan aku tidak mengerti apa yang ada\N dalam pikiran wanita misterius ini.
Dialog: 0,0:02:41.65,0:02:44.95,Default,nanas,0,0,0,,Momennya hilang. Tidak ada gunanya mengatakan apa pun.
Dialog: 0,0:02:45.19,0:02:47.39,Default,nanas,0,0,0,,Apakah benar-benar tidak ada gunanya?
Dialogue: 0,0:02:49.36,0:02:51.52,Default,nanas,0,0,0,,Sulitkah aku menjelaskannya?
Dialog: 0,0:02:53.69,0:02:56.83,Default,nanas,0,0,0,,-Apa katamu?\N-Kamu tidak mendengarkanku.
Dialog: 0,0:02:56.83,0:02:58.80,Default,nanas,0,0,0,,Apa yang kamu pikirkan,
Dialog: 0,0:02:58.80,0:03:01.50,Default,nanas,0,0,0,,apakah kamu lupa tentang buku favoritmu?
Dialogue: 0,0:03:02.70,0:03:05.41,Default,nanas,0,0,0,,Pasti tentang Ny. Hwajin.
Dialog: 0,0:03:06.31,0:03:08.01,Default,nanas,0,0,0,,Tidak sama sekali.
Dialog: 0,0:03:08.68,0:03:09.91,Default,nanas,0,0,0,,Tidak perlu berpura-pura.
Dialogue: 0,0:03:09.91,0:03:14.82,Default,nanas,0,0,0,,Terlihat jelas dari matamu bahwa kamu sedang memikirkan wanita itu.
Dialogue: 0,0:03:14.82,0:03:16.72,Default,nanas,0,0,0,,Aku sedang memikirkan ratu.
Dialog: 0,0:03:16.72,0:03:17.72,Default,nanas,0,0,0,,Apa?
Dialogue: 0,0:03:17.72,0:03:20.39,Default,nanas,0,0,0,,Jadi berhentilah mempermalukan\Naku dengan kata-katamu.
Dialog: 0,0:03:20.82,0:03:22.96,Default,nanas,0,0,0,,Ratu juga seorang wanita,
Dialogue: 0,0:03:22.96,0:03:25.73,Default,pineapple,0,0,0,,tapi aku tidak pernah menganggapnya seperti itu.
Dialog: 0,0:03:26.49,0:03:28.33,Default,nanas,0,0,0,,Kamu tidak akan pernah menebak apa yang ada dalam pikirannya,
Dialog: 0,0:03:28.33,0:03:31.13,Default,nanas,0,0,0,,pantas saja Anda tertarik.
Dialog: 0,0:03:33.10,0:03:35.60,Default,nanas,0,0,0,,Ratu adalah orang yang paling luar biasa dan aneh
Dialog: 0,0:03:35.60,0:03:38.87,Default,nanas,0,0,0,,dari semua orang yang saya kenal.
Dialog: 0,0:03:39.54,0:03:43.44,Default,nanas,0,0,0,,Seolah-olah dia bukan dari dunia kita.
Dialog: 0,0:03:45.18,0:03:49.35,Default,nanas,0,0,0,,Dan paling menggambarkan ratu kita...
Dialog: 0,0:03:50.28,0:03:52.32,Default,nanas,0,0,0,,Biarkan aku berpikir.
Dialog: 0,0:03:53.32,0:03:57.12,Default,nanas,0,0,0,,Sebuah kata yang secara langsung mengatakan\Nbahwa seseorang bukan dari dunia ini.
Dialog: 0,0:03:57.12,0:03:58.86,Default,nanas,0,0,0,,Alien.
Dialog: 0,0:03:59.06,0:04:01.33,Default,nanas,0,0,0,,-Alien?\N-Ya.
Dialog: 0,0:04:04.63,0:04:06.73,Default,nanas,0,0,0,,Sempurna untuknya.
Dialog: 0,0:04:08.14,0:04:09.84,Default,nanas,0,0,0,,Alien.
Dialogue: 0,0:04:14.41,0:04:16.81,Default,nanas,0,0,0,,Apakah hujan akhirnya berhenti?
Dialogue: 0,0:04:16.81,0:04:19.15,Default,nanas,0,0,0,,Hujan sepanjang malam.
Dialog: 0,0:04:19.15,0:04:21.55,Default,nanas,0,0,0,,Saya harap tidak ada yang terluka.
Dialog: 0,0:04:21.55,0:04:23.45,Default,nanas,0,0,0,,Aku juga.
Dialogue: 0,0:04:23.82,0:04:25.85,Default,nanas,0,0,0,,Aku gelisah.
Dialogue: 0,0:04:28.36,0:04:31.39,Default,nanas,0,0,0,,Berapa lama kamu akan berbicara begitu aneh?
Dialog: 0,0:04:31.39,0:04:34.33,Default,nanas,0,0,0,,Hanya hari ini. Ini adalah hari terakhir.
Dialog: 0,0:04:34.33,0:04:39.53,Default,nanas,0,0,0,,Dan besok semuanya akan beres! Oh ya!
Dialog: 0,0:04:44.91,0:04:46.54,Default,nanas,0,0,0,,Tidak mungkin!
Dialog: 0,0:04:55.28,0:04:56.88,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,0:05:04.93,0:05:08.03,Default,nanas,0,0,0,,Buka gerbangnya! Perintah Raja!
Dialog: 0,0:05:08.06,0:05:10.26,Default,nanas,0,0,0,,-Buka gerbangnya!\N-Buka gerbangnya!
Dialog: 0,0:05:32.29,0:05:34.89,Default,nanas,0,0,0,,Saya seharusnya tidak sampai di sini\NJang Bong-hwan
Dialog: 0,0:07:10.68,0:07:11.75,Default,nanas,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,0:07:11.75,0:07:13.42,Default,nanas,0,0,0,,Aduh!
Dialog: 0,0:07:13.55,0:07:14.62,Default,nanas,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:07:14.62,0:07:16.32,Default,nanas,0,0,0,,Dia baru-baru ini mencoba membunuhku!
Dialog: 0,0:07:16.32,0:07:18.13,Default,nanas,0,0,0,,Saya harus menanyakan hal yang sama!
Dialog: 0,0:07:18.13,0:07:20.26,Default,nanas,0,0,0,,Saya tidak percaya\Nkamu mencoba bunuh diri lagi!
Dialog: 0,0:07:20.26,0:07:22.00,Default,nanas,0,0,0,,Apakah kamu gila?
Dialogue: 0,0:07:22.00,0:07:24.73,Default,nanas,0,0,0,,Apa pedulimu aku masih hidup atau tidak?
Dialogue: 0,0:07:24.73,0:07:27.13,Default,nanas,0,0,0,,Apakah kamu tidak ingin aku mati?
Dialog: 0,0:07:30.14,0:07:33.24,Default,nanas,0,0,0,,Jangan ganggu aku! Keluar!
Dialog: 0,0:07:33.91,0:07:37.34,Default,nanas,0,0,0,,Belum terlambat untuk menyelesaikan semua kesalahpahaman.
Dialogue: 0,0:07:38.01,0:07:40.38,Default,nanas,0,0,0,,Mari kita hidup sesuai keinginanmu.
Dialog: 0,0:07:41.48,0:07:43.12,Default,nanas,0,0,0,,Jarak sosial.
Dialog: 0,0:07:47.85,0:07:50.89,Default,nanas,0,0,0,,Benar! Jarak sosial.
Dialog: 0,0:07:51.66,0:07:53.93,Default,nanas,0,0,0,,-Tidak mungkin!\N-Keluar!
Dialog: 0,0:07:53.93,0:07:55.83,Default,nanas,0,0,0,,Apa yang kamu lakukan! Biarkan aku pergi!
Dialog: 0,0:07:55.83,0:07:57.50,Default,nanas,0,0,0,,Bajingan!
Dialogue: 0,0:07:58.50,0:08:01.77,Default,nanas,0,0,0,,Dia bilang kamu ingin menjaga jarak,\Ndan apakah kamu mencoba mati?
Dialogue: 0,0:08:02.87,0:08:04.54,Default,nanas,0,0,0,,Apakah kamu tidak mencoba membunuhku?
Dialogue: 0,0:08:04.54,0:08:05.91,Default,nanas,0,0,0,,Jadi kenapa kamu menyentuhku?
Dialog: 0,0:08:05.91,0:08:07.74,Default,nanas,0,0,0,,Saya mengerti kenapa kamu marah.
Dialog: 0,0:08:07.74,0:08:11.64,Default,nanas,0,0,0,,Aku melakukan dosa besar dan sekarang\Nutang belum terbayar padamu.
Dialog: 0,0:08:11.75,0:08:15.85,Default,nanas,0,0,0,,Saya mengerti, kedengarannya seperti alasan,\Ntapi kami hanya salah paham satu sama lain.
Dialog: 0,0:08:15.85,0:08:19.32,Default,nanas,0,0,0,,Saya tidak peduli bagaimana kita memahami satu sama lain di sana.
Dialog: 0,0:08:19.32,0:08:21.05,Default,nanas,0,0,0,,Tolong dengarkan aku.
Dialog: 0,0:08:21.05,0:08:23.56,Default,nanas,0,0,0,,Aku tidak ingin mendengarkanmu menuangkan air ke telingaku!
Dialog: 0,0:08:23.69,0:08:25.79,Default,nanas,0,0,0,,-Minggir!\N-Tidak mungkin!
Dialog: 0,0:08:25.93,0:08:27.49,Default,nanas,0,0,0,,Saya setuju untuk menjaga jarak,
Dialog: 0,0:08:27.49,0:08:29.96,Default,nanas,0,0,0,,Aku tidak akan pernah meninggalkanmu!
Dialogue: 0,0:08:30.86,0:08:34.60,Default,pineapple,0,0,0,,Apakah kamu mengerti apa artinya menjaga jarak?
Dialog: 0,0:08:34.60,0:08:36.20,Default,nanas,0,0,0,,Tentu saja.
Dialog: 0,0:08:37.04,0:08:40.17,Default,nanas,0,0,0,,Saya ingat semua yang Anda katakan.
Dialog: 0,0:08:40.71,0:08:42.34,Default,nanas,0,0,0,,Jarak sosial.
Dialog: 0,0:08:43.04,0:08:45.51,Default,nanas,0,0,0,,Hidup dalam damai dan harmoni.
Dialogue: 0,0:08:46.51,0:08:48.95,Default,nanas,0,0,0,,Live, ratuku.
Dialog: 0,0:08:49.32,0:08:51.52,Default,nanas,0,0,0,,Tapi kamu lupa hal terpenting!
Dialog: 0,0:08:51.52,0:08:52.69,Default,nanas,0,0,0,,Semua orang untuk dirinya sendiri!
Dialogue: 0,0:08:52.69,0:08:54.86,Default,nanas,0,0,0,,Hiduplah sesukamu,\Ndan aku akan hidup dengan caraku sendiri!
Dialogue: 0,0:08:54.86,0:08:56.72,Default,nanas,0,0,0,,Hal utama dalam semua ini bukanlah hidup,
Dialog: 0,0:08:56.72,0:08:59.53,Default,nanas,0,0,0,,dan fakta bahwa setiap orang adalah untuk dirinya sendiri!
Dialog: 0,0:08:59.53,0:09:02.13,Default,nanas,0,0,0,,Saya akan melakukan segalanya untuk mengikuti aturan ini!
Dialog: 0,0:09:02.13,0:09:04.93,Default,nanas,0,0,0,,Aku akan berusaha semaksimal mungkin untuk memastikan kita berdua bahagia!
Dialog: 0,0:09:04.93,0:09:07.97,Default,nanas,0,0,0,,Lupakan!\NLupakan menjaga jarak!
Dialog: 0,0:09:07.97,0:09:09.14,Default,nanas,0,0,0,,Mengapa?
Dialogue: 0,0:09:09.14,0:09:12.51,Default,nanas,0,0,0,,Kamu dan aku mempunyai arti yang berbeda dalam frasa ini!
Dialogue: 0,0:09:12.51,0:09:15.51,Default,nanas,0,0,0,,Hal yang kecil, tapi sudah memiliki dua arti yang berbeda!
Dialog: 0,0:09:15.51,0:09:17.01,Default,nanas,0,0,0,,Kami berpikiran sama.
Dialogue: 0,0:09:17.01,0:09:19.25,Default,nanas,0,0,0,,Akan kubuktikan padamu.
Dialog: 0,0:09:19.38,0:09:22.15,Default,nanas,0,0,0,,Saya sarankan untuk tetap menjaga jarak sosial.
Dialog: 0,0:09:22.15,0:09:24.65,Default,nanas,0,0,0,,Saya tidak akan mematuhinya!
Dialogue: 0,0:09:24.65,0:09:27.32,Default,nanas,0,0,0,,Mari kita coba hidup dengan aturan ini!
Dialogue: 0,0:09:27.32,0:09:29.66,Default,nanas,0,0,0,,Menyebalkan!
Dialog: 0,0:09:40.33,0:09:43.87,Default,nanas,0,0,0,,6 episode: Antara pengertian dan salah paham
Dialog: 0,0:09:45.51,0:09:47.61,Default,nanas,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:09:49.11,0:09:51.81,Default,nanas,0,0,0,,Yang Mulia, apa yang terjadi?
Dialog: 0,0:09:51.81,0:09:53.51,Default,nanas,0,0,0,,Hubungi kepala kasim sekarang.
Dialog: 0,0:09:53.51,0:09:57.72,Default,nanas,0,0,0,,Aku baik-baik saja, jaga ratu.
Dialog: 0,0:09:58.18,0:10:00.32,Default,nanas,0,0,0,,-Ya, Yang Mulia.\N-Ya, Yang Mulia.
Dialog: 0,0:10:01.52,0:10:03.19,Default,nanas,0,0,0,,Oh, malangnya kamu!
Dialog: 0,0:10:04.12,0:10:05.76,Default,nanas,0,0,0,,Lebih cepat!
Dialog: 0,0:10:13.70,0:10:17.34,Default,nanas,0,0,0,,Saya seharusnya tidak sampai di sini\NJang Bong-hwan
Dialog: 0,0:11:17.13,0:11:19.10,Default,nanas,0,0,0,,Aku merindukanmu.
Dialog: 0,0:11:19.37,0:11:21.73,Default,nanas,0,0,0,,Aku juga merindukanmu.
Dialog: 0,0:11:23.90,0:11:25.94,Default,nanas,0,0,0,,Apakah kamu di dalam kamar?
Dialog: 0,0:11:26.61,0:11:28.31,Default,nanas,0,0,0,,Ya, ayah.
Dialog: 0,0:11:33.68,0:11:36.25,Default,nanas,0,0,0,,Saya lihat Anda sudah siap.
Dialogue: 0,0:11:36.62,0:11:38.72,Default,nanas,0,0,0,,Bagaimana tidurmu?
Dialogue: 0,0:11:38.72,0:11:40.32,Default,nanas,0,0,0,,Nah,
Dialogue: 0,0:11:40.35,0:11:44.09,Default,nanas,0,0,0,,hari ini adalah hari pertamamu di istana,\Njadi aku bangun pagi-pagi.
Dialog: 0,0:11:44.09,0:11:47.89,Default,nanas,0,0,0,,Saya akan mencoba yang terbaik
Dialog: 0,0:11:47.89,0:11:49.66,Default,nanas,0,0,0,,dan aku tidak akan mempermalukan nama keluarga.
Dialogue: 0,0:11:49.66,0:11:52.73,Default,nanas,0,0,0,,Untung hujannya sudah reda,\Njalan menuju istana akan jauh lebih mudah.
Dialog: 0,0:11:52.73,0:11:54.40,Default,nanas,0,0,0,,Selesai bersiap-siap.
Dialog: 0,0:11:54.40,0:11:56.07,Default,nanas,0,0,0,,Ya.
Dialogue: 0,0:12:17.69,0:12:20.03,Default,nanas,0,0,0,,Aku hampir tersedak,
Dialogue: 0,0:12:20.03,0:12:23.03,Default,pineapple,0,0,0,,jujur saja, kalau bukan karena Cheoljong,\NI pasti sudah mati.
Dialogue: 0,0:12:23.03,0:12:25.50,Default,nanas,0,0,0,,Mengapa iblis ini tidak kembali?
Dialog: 0,0:12:31.44,0:12:34.27,Default,nanas,0,0,0,,Apa yang terjadi antara kamu dan raja?
Dialogue: 0,0:12:34.27,0:12:36.68,Default,nanas,0,0,0,,Kenapa kamu ada di danau pada jam segini?
Dialog: 0,0:12:39.81,0:12:42.08,Default,nanas,0,0,0,,Apakah kamu masih belum selesai?
Dialog: 0,0:12:42.08,0:12:45.42,Default,nanas,0,0,0,,Saya menghapus semuanya.
Dialog: 0,0:12:50.36,0:12:54.39,Default,nanas,0,0,0,,Kapan kamu berhasil melarikan diri?\NI memperhatikanmu.
Dialogue: 0,0:12:55.03,0:12:58.80,Default,nanas,0,0,0,,Apakah kamu terjun ke air lagi?
Dialog: 0,0:12:59.20,0:13:01.77,Default,nanas,0,0,0,,Sama sekali tidak seperti itu.
Dialog: 0,0:13:03.67,0:13:07.54,Default,nanas,0,0,0,,Yang Mulia, saya membawa baju ganti.
Dialogue: 0,0:13:07.54,0:13:09.44,Default,nanas,0,0,0,,Kenapa kamu basah sekali?
Dialog: 0,0:13:09.44,0:13:13.21,Default,nanas,0,0,0,,Ya. Saya senang danau itu terisi kembali,
Dialog: 0,0:13:13.21,0:13:16.18,Default,nanas,0,0,0,,jadi aku memutuskan untuk berenang.
Dialog: 0,0:13:16.68,0:13:18.22,Default,nanas,0,0,0,,Apa?
Dialogue: 0,0:13:18.22,0:13:20.45,Default,nanas,0,0,0,,Apakah kalian berdua sedang berenang?
Dialog: 0,0:13:20.55,0:13:22.52,Default,nanas,0,0,0,,Jangan lakukan itu!
Dialogue: 0,0:13:22.52,0:13:25.56,Default,nanas,0,0,0,,Bagaimana jika kamu sakit?
Dialog: 0,0:13:26.96,0:13:31.00,Default,nanas,0,0,0,,Sepertinya danau tidak akan membantuku kembali.
Dialog: 0,0:13:32.03,0:13:33.73,Default,nanas,0,0,0,,Omong kosong.
Dialog: 0,0:13:44.04,0:13:45.71,Default,nanas,0,0,0,,Yang Mulia!
Dialog: 0,0:13:46.11,0:13:47.38,Default,nanas,0,0,0,,Ini dia!
Dialog: 0,0:13:47.38,0:13:49.62,Default,nanas,0,0,0,,Aku mencarimu kemana-mana,
Dialog: 0,0:13:49.62,0:13:51.92,Default,nanas,0,0,0,,kemana kamu terburu-buru...
Dialogue: 0,0:13:52.49,0:13:54.72,Default,nanas,0,0,0,,Kenapa kamu basah kuyup?
Dialog: 0,0:13:54.72,0:13:57.29,Default,nanas,0,0,0,,-Tidak apa-apa.\N-Bagaimana bisa?
Dialog: 0,0:14:46.01,0:14:47.61,Default,nanas,0,0,0,,Aku berhutang banyak padamu,
Dialog: 0,0:14:47.61,0:14:50.78,Default,nanas,0,0,0,,jadi saya akan hidup untuk membantu Anda, Nyonya.
Dialog: 0,0:14:59.19,0:15:02.16,Default,nanas,0,0,0,,Maaf, saya tidak memperhatikanmu.
Dialogue: 0,0:15:02.16,0:15:04.69,Default,nanas,0,0,0,,Apakah kamu yakin tidak melihat apa pun?
Dialog: 0,0:15:19.31,0:15:21.11,Default,nanas,0,0,0,,Saat anak kecil tahu terlalu banyak,
Dialog: 0,0:15:21.11,0:15:22.98,Default,nanas,0,0,0,,hanya kematian yang menantinya.
Dialog: 0,0:15:24.48,0:15:27.85,Default,nanas,0,0,0,,Ini adalah aturan istana.
Dialog: 0,0:15:28.55,0:15:31.05,Default,nanas,0,0,0,,Saya harus bertahan.
Dialog: 0,0:15:31.12,0:15:34.82,Default,nanas,0,0,0,,Nyonya Hwajin menyuruhku untuk hidup.
Dialog: 0,0:15:59.71,0:16:04.88,Default,nanas,0,0,0,,Hari ini subuh ratu jatuh ke danau lagi.
Dialog: 0,0:16:05.15,0:16:09.32,Default,nanas,0,0,0,,Tapi kali ini raja bersamanya...
Dialog: 0,0:16:09.72,0:16:14.56,Default,nanas,0,0,0,,Sepertinya tidak ada yang tahu kenapa mereka berdua berakhir di air.
Dialog: 0,0:16:15.76,0:16:17.63,Default,nanas,0,0,0,,Cukup,
Dialog: 0,0:16:17.63,0:16:22.30,Default,nanas,0,0,0,,untuk membuktikan bahwa saya akan berguna?
Dialog: 0,0:16:23.20,0:16:25.91,Default,nanas,0,0,0,,Katakan ini pada Ibu Suri.
Dialogue: 0,0:16:26.24,0:16:30.14,Default,nanas,0,0,0,,Haruskah aku menjelaskan semuanya persis seperti apa adanya?
Dialogue: 0,0:16:30.14,0:16:32.38,Default,nanas,0,0,0,,Setelah bicara,
Dialog: 0,0:16:32.68,0:16:34.95,Default,nanas,0,0,0,,ceritakan semua yang kamu katakan atau lakukan
Dialog: 0,0:16:34.95,0:16:37.18,Default,nanas,0,0,0,,ibu suri, hal kecil apa pun.
Dialog: 0,0:16:38.72,0:16:42.25,Default,nanas,0,0,0,,Anda tidak berhak memutuskan apa yang mungkin berguna.
Dialog: 0,0:16:42.46,0:16:44.29,Default,nanas,0,0,0,,Saya akan melakukan persis seperti yang Anda pesan.
Dialog: 0,0:16:45.26,0:16:48.03,Default,nanas,0,0,0,,Mulai hari ini, kamu patuh pada nyonya istana
Dialog: 0,0:16:48.03,0:16:51.00,Default,nanas,0,0,0,,kamar ratu.
Dialog: 0,0:16:53.80,0:16:55.50,Default,nanas,0,0,0,,Kamar Ratu?
Dialog: 0,0:16:56.07,0:16:58.30,Default,nanas,0,0,0,,Ini posisi yang sangat tinggi!
Dialog: 0,0:16:58.34,0:16:59.91,Default,nanas,0,0,0,,Terima kasih pak!
Dialog: 0,0:16:59.91,0:17:03.54,Default,nanas,0,0,0,,Ibu Suri akan memutuskan bahwa kamu akan jauh lebih berguna baginya.
Dialog: 0,0:17:04.34,0:17:07.75,Default,nanas,0,0,0,,Pantau lingkungan sekitar ratu dengan cermat.
Dialogue: 0,0:17:08.11,0:17:10.75,Default,nanas,0,0,0,,Ya pak.
Dialogue: 0,0:17:21.66,0:17:23.40,Default,Lily,0,0,0,,Menggambar bunga
Dialogue: 0,0:17:23.40,0:17:25.46,Default,Lily,0,0,0,,atau bud?
Dialog: 0,0:17:26.47,0:17:28.77,Default,Lily,0,0,0,,Bagaimana menurutmu, Ovol?
Dialog: 0,0:17:33.84,0:17:36.04,Default,Lily,0,0,0,,Kecuali Yang Mulia,
Dialog: 0,0:17:36.48,0:17:38.54,Default,Lily,0,0,0,,Saya tidak punya siapa-siapa sekarang.
Dialog: 0,0:17:41.48,0:17:45.28,Default,Lily,0,0,0,,Yang Mulia, Ibu Suri ada di sini.
Dialog: 0,0:17:49.52,0:17:51.72,Default,Lily,0,0,0,,Salam, Yang Mulia.
Dialogue: 0,0:17:51.72,0:17:54.23,Default,Lily,0,0,0,,Kamu menggambar anggrek.
Dialog: 0,0:18:00.57,0:18:02.30,Default,Lily,0,0,0,,Apakah sudah selesai?
Dialog: 0,0:18:02.30,0:18:03.84,Default,Lily,0,0,0,,Belum.
Dialog: 0,0:18:03.84,0:18:07.27,Default,Lily,0,0,0,,Saya belum memutuskan apakah akan menggambar bunga atau kuncup yang belum terbuka.
Dialogue: 0,0:18:07.27,0:18:09.78,Default,Lily,0,0,0,,Coba kulihat.
Dialog: 0,0:18:09.91,0:18:13.58,Default,Lily,0,0,0,,Menurutku kuncupnya cukup.
Dialog: 0,0:18:14.28,0:18:16.98,Default,Lily,0,0,0,,Semua orang akan tertarik,
Dialog: 0,0:18:17.65,0:18:21.52,Default,Lily,0,0,0,,bunga apa itu.
Dialog: 0,0:18:39.07,0:18:42.01,Default,Lily,0,0,0,,Ya Tuhan, sungguh indah.
Dialog: 0,0:18:42.04,0:18:44.91,Default,Lily,0,0,0,,Kuharap kuncupnya tidak beterbangan,
Dialogue: 0,0:18:44.91,0:18:48.15,Default,Lily,0,0,0,,sebelum mekar.
Dialogue: 0,0:18:49.88,0:18:51.12,Default,Lily,0,0,0,,Omong-omong.
Dialog: 0,0:18:51.12,0:18:54.65,Default,Lily,0,0,0,,Aku datang untuk memberimu hadiah kecil.
Dialog: 0,0:19:07.40,0:19:08.70,Default,Lily,0,0,0,,Terima kasih.
Dialog: 0,0:19:08.70,0:19:10.24,Default,Lily,0,0,0,,Saya tidak tahu apa yang Anda suka,
Dialog: 0,0:19:10.24,0:19:12.84,Default,Lily,0,0,0,,Aku harus berpikir lama.
Dialog: 0,0:19:22.28,0:19:25.65,Default,Lily,0,0,0,,Saya dengar kamu adalah pemanah yang hebat.
Dialog: 0,0:19:26.72,0:19:28.99,Default,Lily,0,0,0,,Saya juga ingin belajar cara menembakkan busur.
Dialog: 0,0:19:28.99,0:19:31.82,Default,Lily,0,0,0,,Aku menyiapkannya untuk diriku sendiri dan untukmu.
Dialog: 0,0:19:35.23,0:19:37.73,Default,Lily,0,0,0,,Panah yang indah dan tahan lama.
Dialog: 0,0:19:39.17,0:19:40.40,Default,Lily,0,0,0,,Terima kasih.
Dialog: 0,0:19:40.40,0:19:43.60,Default,Lily,0,0,0,,Hadiah sebenarnya bukanlah panah.
Dialog: 0,0:19:44.27,0:19:47.37,Default,Lily,0,0,0,,Hadiah akan dikirimkan hari ini
Dialog: 0,0:19:47.37,0:19:50.18,Default,Lily,0,0,0,,Untuk Yang Mulia di sidang pengadilan.
Dialog: 0,0:19:58.42,0:19:59.99,Default,Lily,0,0,0,,Di mana kalau bukan di danau?
Dialog: 0,0:19:59.99,0:20:02.35,Default,Lily,0,0,0,,Hanya air yang menyatukan kita.
Dialog: 0,0:20:08.06,0:20:09.90,Default,Lily,0,0,0,,Dan satu hal lagi.
Dialog: 0,0:20:10.46,0:20:12.73,Default,Lily,0,0,0,,Kami berdua di ambang kematian.
Dialogue: 0,0:20:13.00,0:20:15.07,Default,Lily,0,0,0,,Sial, bagaimana jika aku mencoba dan benar-benar mati?
Dialogue: 0,0:20:15.07,0:20:17.44,Default,Lily,0,0,0,,Mati sangat menyakitkan.
Dialog: 0,0:20:18.74,0:20:22.57,Default,Lily,0,0,0,,Saya yakin ada cara aman untuk kembali.
Dialogue: 0,0:20:23.14,0:20:25.84,Default,Lily,0,0,0,,Pertama-tama, aku akan mengerti wanita macam apa ini.
Dialog: 0,0:20:29.35,0:20:32.38,Default,Lily,0,0,0,,Saya Kim So-yeon.
Dialog: 0,0:20:33.29,0:20:35.39,Default,Lily,0,0,0,,Bunuh diri.
Dialogue: 0,0:20:35.96,0:20:40.89,Default,Lily,0,0,0,,Tinggalkan dirimu yang palsu?
Dialog: 0,0:20:41.89,0:20:45.03,Default,Lily,0,0,0,,Kenapa kamu mencoba mati? Saya tidak ingin hidup.
Dialog: 0,0:20:47.23,0:20:50.14,Default,Lily,0,0,0,,Tentu saja, itu sebabnya dia tidak mau kembali.
Dialogue: 0,0:20:50.34,0:20:53.91,Default,Lily,0,0,0,,Wanita ini... Dia kabur?
Dialog: 0,0:20:57.94,0:21:00.21,Default,Lily,0,0,0,,Saya mengerti mengapa Anda melakukan ini.
Dialog: 0,0:21:00.21,0:21:02.32,Default,Lily,0,0,0,,Kamu terobsesi dengan danau
Dialog: 0,0:21:02.32,0:21:04.68,Default,Lily,0,0,0,,dan bergumam pada diri sendiri.
Dialogue: 0,0:21:04.75,0:21:06.85,Default,Lily,0,0,0,,Itu karena kamu...
Dialog: 0,0:21:10.19,0:21:12.76,Default,Lily,0,0,0,,mencoba mengingat kembali?
Dialog: 0,0:21:14.76,0:21:16.76,Default,Lily,0,0,0,,Ya. Anda benar.
Dialog: 0,0:21:16.76,0:21:18.16,Default,Lily,0,0,0,,Oke.
Dialog: 0,0:21:18.16,0:21:20.70,Default,Lily,0,0,0,,Sebuah pertanyaan telah muncul. Saat aku jatuh ke danau
Dialog: 0,0:21:20.70,0:21:23.47,Default,Lily,0,0,0,,Saya langsung ditarik keluar, tapi saya tidak sadarkan diri?
Dialog: 0,0:21:24.04,0:21:25.57,Default,Lily,0,0,0,,Ya.
Dialog: 0,0:21:25.57,0:21:27.61,Default,Lily,0,0,0,,Sial. Saya mengetahuinya. Dia lari.
Dialog: 0,0:21:28.04,0:21:30.08,Default,Lily,0,0,0,,Ini tidak adil.
Dialog: 0,0:21:30.08,0:21:32.41,Default,Lily,0,0,0,,Saya ingin kembali.
Dialog: 0,0:21:33.58,0:21:35.78,Default,Lily,0,0,0,,Ini penculikan!
Dialogue: 0,0:21:36.65,0:21:39.35,Default,Lily,0,0,0,,Dorosoma panggang membawa kembali istri yang melarikan diri.
Dialog: 0,0:21:39.82,0:21:42.79,Default,Lily,0,0,0,,Atau memanggil roh yang telah meninggalkan tubuh?
Dialog: 0,0:21:43.29,0:21:44.89,Default,Lily,0,0,0,,Ritus?
Dialog: 0,0:21:45.26,0:21:48.43,Default,Lily,0,0,0,,Ya. Saya harus melakukan upacaranya.
Dialog: 0,0:21:48.43,0:21:50.86,Default,Lily,0,0,0,,Saya akan menutupi semuanya di sini dengan jimat mahal.
Dialogue: 0,0:21:51.60,0:21:54.03,Default,Lily,0,0,0,,Nyonya Choi, kamu di sana?
Dialog: 0,0:21:58.27,0:22:02.34,Default,Lily,0,0,0,,Apakah ada spesialis ritual atau jimat di sini?
Dialog: 0,0:22:02.91,0:22:04.51,Default,Lily,0,0,0,,Apa?
Dialog: 0,0:22:04.51,0:22:07.48,Default,Lily,0,0,0,,Anda seharusnya tidak tertarik pada perdukunan,
Dialogue: 0,0:22:08.11,0:22:10.48,Default,Lily,0,0,0,,tapi kamu tetap akan melakukannya?
Dialog: 0,0:22:12.12,0:22:16.49,Default,Lily,0,0,0,,Satu orang terlintas dalam pikiran.
Dialogue: 0,0:22:17.19,0:22:18.82,Default,Lily,0,0,0,,Dan siapa?
Dialog: 0,0:22:27.63,0:22:31.20,Default,Lily,0,0,0,,Mengapa dia datang ke sini? Apa yang ingin dia ketahui?
Dialogue: 0,0:22:31.20,0:22:34.54,Default,Lily,0,0,0,,Untuk apa aku berhutang kesenangan ini?
Dialog: 0,0:22:35.24,0:22:37.41,Default,Lily,0,0,0,,Saya mengetahui bahwa Anda adalah seorang ahli.
Dialog: 0,0:22:37.54,0:22:40.65,Default,Lily,0,0,0,,Saya? Apa?
Dialog: 0,0:22:41.11,0:22:44.35,Default,Lily,0,0,0,,Saya butuh pembimbing spiritual.
Dialog: 0,0:22:44.65,0:22:48.22,Default,Lily,0,0,0,,Dalam hal-hal seperti ritual dan jimat.
Dialog: 0,0:22:48.22,0:22:51.59,Default,Lily,0,0,0,,Apakah kamu benar-benar menebak kalau aku punya jimat baru,
Dialog: 0,0:22:51.59,0:22:53.66,Default,Lily,0,0,0,,mengutuknya?
Dialogue: 0,0:22:54.03,0:22:57.13,Default,Lily,0,0,0,,Ayolah, ini rasanya tidak enak.
Dialog: 0,0:22:57.13,0:23:00.33,Default,Lily,0,0,0,,Mengapa Anda membutuhkan ini?
Dialog: 0,0:23:00.33,0:23:02.10,Default,Lily,0,0,0,,Ya, itu tidak masuk akal.
Dialog: 0,0:23:02.10,0:23:06.24,Default,Lily,0,0,0,,Kamu perlu memanggil roh yang telah meninggalkan tubuh.
Dialog: 0,0:23:07.44,0:23:09.44,Default,Lily,0,0,0,,Apakah ini sering terjadi?
Dialog: 0,0:23:09.44,0:23:12.98,Default,Lily,0,0,0,,Dia dengan cerdik berusaha mendekatkan diri padaku.
Dialog: 0,0:23:12.98,0:23:15.98,Default,Lily,0,0,0,,Ingin menghukumku karena jimatku.
Dialog: 0,0:23:15.98,0:23:18.02,Default,Lily,0,0,0,,Rubah licik.
Dialog: 0,0:23:18.55,0:23:21.62,Default,Lily,0,0,0,,Saya tidak percaya hal-hal seperti itu.
Dialog: 0,0:23:21.62,0:23:24.76,Default,Lily,0,0,0,,Bukan hantu maupun roh.
Dialog: 0,0:23:26.19,0:23:30.46,Default,Lily,0,0,0,,Lalu untuk apa ini di sini?
Dialog: 0,0:23:37.50,0:23:39.17,Default,Lily,0,0,0,,Kamu salah.
Dialog: 0,0:23:39.17,0:23:41.47,Default,Lily,0,0,0,,Ini bukan tempat perdukunan.
Dialog: 0,0:23:41.47,0:23:44.21,Default,Lily,0,0,0,,Di sini aku membersihkan jiwaku.
Dialog: 0,0:23:44.21,0:23:46.14,Default,Lily,0,0,0,,Saya mengerti.
Dialogue: 0,0:23:48.38,0:23:50.02,Default,Lily,0,0,0,,Apa?
Dialog: 0,0:23:50.25,0:23:51.95,Default,Lily,0,0,0,,Benarkah?
Dialog: 0,0:23:52.72,0:23:57.56,Default,Lily,0,0,0,,Roh siapa yang ingin kamu panggil?
Dialog: 0,0:23:58.86,0:24:03.16,Default,Lily,0,0,0,,Saya dapat mengatakan bahwa kita dekat dan terhubung erat.
Dialog: 0,0:24:04.63,0:24:06.20,Default,Lily,0,0,0,,Ini seorang wanita, jangan salah paham.
Dialog: 0,0:24:06.20,0:24:07.93,Default,Lily,0,0,0,,Saya mengerti.
Dialog: 0,0:24:08.37,0:24:12.84,Default,Lily,0,0,0,,Mungkin ini ibumu,\Nyang belum pernah kamu lihat.
Dialog: 0,0:24:14.24,0:24:18.51,Default,Lily,0,0,0,,Tuhan. Hatiku hancur untukmu.
Dialog: 0,0:24:18.61,0:24:20.61,Default,Lily,0,0,0,,Kamu pasti kesepian di istana.
Dialog: 0,0:24:20.61,0:24:23.32,Default,Lily,0,0,0,,Kamu rindu mendiang ibumu.
Dialog: 0,0:24:23.32,0:24:25.02,Default,Lily,0,0,0,,Karena ini
Dialog: 0,0:24:25.35,0:24:28.02,Default,Lily,0,0,0,,mencoba bunuh diri?
Dialog: 0,0:24:30.16,0:24:31.86,Default,Lily,0,0,0,,Menurutmu?
Dialog: 0,0:24:31.86,0:24:34.96,Default,Lily,0,0,0,,Kamu bisa menceritakan semuanya padaku.
Dialog: 0,0:24:34.96,0:24:37.33,Default,Lily,0,0,0,,Meskipun aku tidak melahirkan seorang raja,
Dialog: 0,0:24:37.33,0:24:41.00,Default,Lily,0,0,0,,tetapi menurut silsilahnya, saya adalah ibunya.
Dialog: 0,0:24:41.00,0:24:46.37,Default,Lily,0,0,0,,Mulai hari ini, aku akan menyayangimu sebagai putriku dan menjaga...
Dialog: 0,0:24:46.97,0:24:49.37,Default,Lily,0,0,0,,Saya sudah mempunyai dua ibu.
Dialogue: 0,0:24:50.31,0:24:53.71,Default,Lily,0,0,0,,Sejujurnya, aku tidak berusaha bunuh diri.
Dialog: 0,0:24:53.71,0:24:57.32,Default,Lily,0,0,0,,Lalu kenapa kamu berkata begitu?
Dialogue: 0,0:24:57.38,0:24:59.05,Default,Lily,0,0,0,,Dan aku membicarakan hal yang sama.
Dialogue: 0,0:24:59.05,0:25:01.19,Default,Lily,0,0,0,,Kenapa aku melakukan ini?
Dialogue: 0,0:25:01.32,0:25:03.86,Default,Lily,0,0,0,,Kamu mau aku tebak?
Dialog: 0,0:25:04.39,0:25:07.59,Default,Lily,0,0,0,,Jadi dia punya motif tersembunyi.
Dialog: 0,0:25:09.33,0:25:13.67,Default,Lily,0,0,0,,Jadi dia mengancamku dan ingin aku waspada.
Dialog: 0,0:25:18.94,0:25:22.34,Default,Lily,0,0,0,,Sial. Membuang-buang waktuku.
Dialog: 0,0:25:24.31,0:25:26.71,Default,Lily,0,0,0,,Rapat pengadilan belum berlangsung.
Dialogue: 0,0:25:26.71,0:25:30.05,Default,Lily,0,0,0,,Dan dia sudah mencoba mengancamku?
Dialogue: 0,0:25:30.92,0:25:34.19,Default,Lily,0,0,0,,Nyonya Han, mereka juga punya
Dialog: 0,0:25:34.19,0:25:36.96,Default,Lily,0,0,0,,burung yang membawa rumor.
Dialog: 0,0:25:36.96,0:25:40.53,Default,Lily,0,0,0,,Apa? Siapa yang bisa melakukan ini?
Dialog: 0,0:25:40.59,0:25:45.93,Default,Lily,0,0,0,,Dia dengan berani menyerbu dan memberikan petunjuk,
Dialog: 0,0:25:46.47,0:25:50.67,Default,Lily,0,0,0,,jadi tidak mudah untuk mengetahui burungnya.
Dialog: 0,0:25:51.67,0:25:54.04,Default,Lily,0,0,0,,Hubungi peramal, dayang istana Han.
Dialog: 0,0:25:54.34,0:25:59.08,Default,Lily,0,0,0,,Saya butuh prediksi.
Dialog: 0,0:26:02.65,0:26:05.25,Default,Lily,0,0,0,,Dia tersiksa oleh sesuatu dan mencoba bunuh diri.
Dialog: 0,0:26:05.25,0:26:06.95,Default,Lily,0,0,0,,Tapi dia tidak bisa mati.
Dialog: 0,0:26:06.95,0:26:09.05,Default,Lilia,0,0,0,,Dan jiwanya seperti: "Tidak peduli. Aku akan keluar."
Dialog: 0,0:26:09.22,0:26:12.66,Default,Lily,0,0,0,,Dan tidak kembali.
Dialog: 0,0:26:12.99,0:26:14.69,Default,Lily,0,0,0,,Apa yang menyiksanya?
Dialog: 0,0:26:14.69,0:26:17.10,Default,Lily,0,0,0,,Dia tidak ingin menjadi ratu.
Dialog: 0,0:26:17.10,0:26:18.76,Default,Lily,0,0,0,,Mengapa?
Dialog: 0,0:26:19.23,0:26:22.00,Default,Lily,0,0,0,,Karena Cheoljong tidak mencintainya
Dialog: 0,0:26:22.00,0:26:24.57,Default,Lily,0,0,0,,dan jatuh cinta dengan orang lain?
Dialog: 0,0:26:24.57,0:26:26.14,Default,Lily,0,0,0,,Ayo.
Dialog: 0,0:26:26.14,0:26:28.84,Default,Lily,0,0,0,,Mencoba mati karena orang bodoh?
Dialog: 0,0:26:30.21,0:26:33.35,Default,Lily,0,0,0,,Yang Mulia berbicara pada dirinya sendiri lebih dari biasanya.
Dialog: 0,0:26:33.35,0:26:34.91,Default,Lily,0,0,0,,Banyak orang mendengarnya.
Dialogue: 0,0:26:34.91,0:26:36.82,Default,Lily,0,0,0,,Itulah masalahku yang paling kecil.
Dialog: 0,0:26:36.82,0:26:40.42,Default,Lily,0,0,0,,Aku mengomelinya tentang hal ini, tapi sudah waktunya melepaskannya.
Dialog: 0,0:26:41.19,0:26:43.56,Default,Lily,0,0,0,,Kalau terus begini, dia akan segera membunuh seseorang.
Dialog: 0,0:26:45.06,0:26:47.59,Default,Lily,0,0,0,,Tapi sekali lagi, aku memahaminya.
Dialog: 0,0:26:47.59,0:26:50.66,Default,Lily,0,0,0,,Menjadi ratu itu seperti duduk di penjara tanpa jeruji.
Dialog: 0,0:26:50.66,0:26:53.80,Default,Lily,0,0,0,,Dari keluarga bangsawan, dipilih menjadi ratu,
Dialog: 0,0:26:53.80,0:26:56.24,Default,Lilia,0,0,0,,yang berarti dia belum bertemu siapa pun.
Dialogue: 0,0:26:56.24,0:26:59.24,Default,Lily,0,0,0,,Mungkin aku belum pernah melihat pria itu sebelum Cheoljong.
Dialog: 0,0:26:59.24,0:27:01.77,Default,Lily,0,0,0,,Mengingat dia adalah raja dan segalanya,
Dialog: 0,0:27:01.77,0:27:04.24,Default,Lily,0,0,0,,jelas kenapa dia jatuh cinta.
Dialog: 0,0:27:05.81,0:27:10.15,Default,Lily,0,0,0,,Tunggu sebentar. Dia pasti sedang bersenang-senang saat ini.
Dialog: 0,0:27:10.15,0:27:12.52,Default,Lily,0,0,0,,Sepanjang hidupku menjalani gaya hidup pertapa,
Dialog: 0,0:27:12.52,0:27:15.29,Default,Lily,0,0,0,,menemukan dunia baru.
Dialog: 0,0:27:17.92,0:27:19.82,Default,Lily,0,0,0,,Dan jika wanita ini...
Dialogue: 0,0:27:20.69,0:27:23.56,Default,Lily,0,0,0,,Jangan biarkan dia mempermainkan tubuhku!
Dialog: 0,0:27:37.44,0:27:39.18,Default,Lily,0,0,0,,Apa?
Dialog: 0,0:27:55.86,0:27:57.76,Default,Lily,0,0,0,,Berhenti!
Dialog: 0,0:27:57.76,0:28:00.80,Default,Lily,0,0,0,,Cepat kembali, kami akan memberimu pelajaran!
Dialog: 0,0:28:00.80,0:28:02.37,Default,Lily,0,0,0,,Apakah kamu tidak menginginkannya?
Dialog: 0,0:28:02.37,0:28:05.84,Default,Lily,0,0,0,,Apa hal menarik yang sedang kamu lihat?
Dialog: 0,0:28:06.34,0:28:08.81,Default,Lily,0,0,0,,Kalau begitu aku akan melakukannya
Dialog: 0,0:28:09.14,0:28:11.84,Default,Lily,0,0,0,,potong tubuhmu. Sampai aku berdarah!
Dialog: 0,0:28:11.84,0:28:13.75,Default,Lily,0,0,0,,Ini akan sangat menyakitkan.
Dialog: 0,0:28:14.31,0:28:18.82,Default,Lily,0,0,0,,Menurutmu aku tidak bisa? Saya bisa melakukannya. Seperti ini!
Dialog: 0,0:28:25.22,0:28:26.96,Default,Lily,0,0,0,,Sial, sakit.
Dialog: 0,0:28:29.70,0:28:32.66,Default,Lily,0,0,0,,Pasti akan ada darah kali ini.
Dialog: 0,0:28:37.10,0:28:38.94,Default,Lily,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:28:39.27,0:28:41.04,Default,Lily,0,0,0,,Sungguh menyakitkan!
Dialog: 0,0:28:41.51,0:28:43.44,Default,Lily,0,0,0,,-Sakit sekali.\N-Bangun.
Dialogue: 0,0:28:44.58,0:28:46.55,Default,Lily,0,0,0,,Sakit.
Dialogue: 0,0:28:46.55,0:28:49.45,Default,Lily,0,0,0,,-God.\N-Cangkir kesabaran sudah penuh.
Dialog: 0,0:28:50.28,0:28:54.15,Default,Lily,0,0,0,,Akan kembali, tidak akan kembali.
Dialogue: 0,0:28:54.39,0:28:55.99,Default,Lily,0,0,0,,Akan kembali.
Dialog: 0,0:28:57.69,0:28:59.39,Default,Lily,0,0,0,,Tidak akan kembali.
Dialog: 0,0:29:03.73,0:29:05.43,Default,Lily,0,0,0,,Lainnya?
Dialog: 0,0:29:05.93,0:29:07.77,Default,Lily,0,0,0,,Yang Mulia, jangan khawatir.
Dialog: 0,0:29:07.77,0:29:10.34,Default,Lily,0,0,0,,Akan kembali ketika waktunya tiba.
Dialog: 0,0:29:10.34,0:29:14.41,Default,Lily,0,0,0,,Pada saat itu saya sudah...
Dialogue: 0,0:29:20.35,0:29:23.52,Default,Lily,0,0,0,,Aku memanggil semangat. Semangat datang.
Dialog: 0,0:29:23.58,0:29:25.92,Default,Lily,0,0,0,,Apakah kamu di sini?
Dialog: 0,0:29:26.92,0:29:30.76,Default,Lily,0,0,0,,Memanggil roh. Semangat datang.
Dialog: 0,0:29:30.82,0:29:32.99,Default,Lily,0,0,0,,Apakah kamu disana?
Dialogue: 0,0:29:34.79,0:29:37.13,Default,Lily,0,0,0,,Karena kita punya tubuh masing-masing,
Dialog: 0,0:29:37.23,0:29:40.23,Default,Lily,0,0,0,,mari kita bicara terus terang.
Dialogue: 0,0:29:43.57,0:29:45.84,Default,Lily,0,0,0,,Bicara sendiri lagi?
Dialog: 0,0:29:46.67,0:29:49.07,Default,Lily,0,0,0,,Anggap ini pengusiran setan sendiri
Dialog: 0,0:29:49.78,0:29:51.61,Default,Lily,0,0,0,,atau berbicara pada diri sendiri.
Dialogue: 0,0:29:51.61,0:29:53.48,Default,Lily,0,0,0,,Bagaimana jika rumor mulai menyebar?
Dialog: 0,0:29:53.48,0:29:56.28,Default,Lily,0,0,0,,Di istana mereka dengan cepat berpencar.
Dialog: 0,0:29:56.28,0:29:58.78,Default,Lily,0,0,0,,Apa ini? Terlihat cantik.
Dialogue: 0,0:29:58.78,0:30:01.49,Default,Lily,0,0,0,,Yang Mulia memberikannya padamu.
Dialogue: 0,0:30:01.49,0:30:03.29,Default,Lily,0,0,0,,Dan aku membawanya.
Dialog: 0,0:30:12.93,0:30:14.57,Default,Lily,0,0,0,,Buku Perubahan
Dialogue: 0,0:30:15.63,0:30:17.37,Default,Lily,0,0,0,,Ada sesuatu di dalamnya.
Dialog: 0,0:30:18.00,0:30:19.07,Default,Lily,0,0,0,,Jarak sosial
Dialog: 0,0:30:19.07,0:30:22.57,Default,Lily,0,0,0,,Tuhan! Imut-imut sekali.
Dialogue: 0,0:30:23.18,0:30:25.21,Default,Lily,0,0,0,,Aku sudah selesai dengan jarak ini.
Dialog: 0,0:30:25.21,0:30:28.65,Default,Lily,0,0,0,,Saya menawarinya, dia menolak. Sekarang apa?
Dialogue: 0,0:30:34.12,0:30:36.05,Default,tiramisu,0,0,0,,Apakah kamu sudah masuk angin?
Dialog: 0,0:30:36.05,0:30:37.66,Default,tiramisu,0,0,0,,Saya tahu akan seperti ini.
Dialog: 0,0:30:37.66,0:30:40.39,Default,tiramisu,0,0,0,,Kamu basah kuyup karena hujan dan masih bermain air.
Dialog: 0,0:30:40.39,0:30:43.19,Default,tiramisu,0,0,0,,Apa yang kamu ingin aku lakukan denganmu?
Dialog: 0,0:30:45.30,0:30:46.97,Default,tiramisu,0,0,0,,Madu.
Dialogue: 0,0:30:48.20,0:30:50.10,Default,tiramisu,0,0,0,,Ini bukan flu.
Dialogue: 0,0:30:50.10,0:30:51.40,Default,tiramisu,0,0,0,,Lalu bagaimana?
Dialog: 0,0:30:51.40,0:30:53.27,Default,tiramisu,0,0,0,,Ini
Dialog: 0,0:30:54.87,0:30:57.11,Default,tiramisu,0,0,0,,keputusasaan itu sendiri.
Dialog: 0,0:30:57.94,0:31:00.98,Default,tiramisu,0,0,0,,Saya pikir segalanya akan menjadi lebih baik ketika danau itu terisi.
Dialogue: 0,0:31:01.35,0:31:05.72,Default,tiramisu,0,0,0,,Tapi tahukah Anda, harapan adalah hal yang kejam.
Dialog: 0,0:31:06.99,0:31:10.26,Default,tiramisu,0,0,0,,Untuk mendapatkan kembali ingatanmu, kamu bahkan siap pergi ke dukun.
Dialog: 0,0:31:10.82,0:31:13.96,Default,tiramisu,0,0,0,,Saya harap Anda berhenti mencoba.
Dialog: 0,0:31:14.09,0:31:16.46,Default,tiramisu,0,0,0,,Jika semuanya baik-baik saja denganmu,
Dialogue: 0,0:31:16.46,0:31:19.20,Default,tiramisu,0,0,0,,kamu tidak akan mencoba bunuh diri.
Dialog: 0,0:31:19.60,0:31:21.20,Default,tiramisu,0,0,0,,Demi kebahagiaanmu,
Dialog: 0,0:31:21.20,0:31:22.77,Default,tiramisu,0,0,0,,mungkin lebih baik tidak mencoba kembali...
Dialog: 0,0:31:22.77,0:31:25.87,Default,tiramisu,0,0,0,,Tidak! Saya harus melakukannya!
Dialog: 0,0:31:27.21,0:31:29.87,Default,tiramisu,0,0,0,,Aku tidak bisa hidup seperti ini lagi.
Dialogue: 0,0:31:32.01,0:31:35.01,Default,tiramisu,0,0,0,,Aku akan beritahu koki kerajaan menyiapkan sesuatu untuk cuaca dingin.
Dialog: 0,0:31:35.01,0:31:37.25,Default,tiramisu,0,0,0,,Kamu perlu makan dan istirahat.
Dialog: 0,0:31:37.68,0:31:40.52,Default,tiramisu,0,0,0,,Tidak, wanita ini
Dialog: 0,0:31:40.52,0:31:44.36,Default,tiramisu,0,0,0,,dia ingin kembali. Aku memberimu gigiku.
Dialogue: 0,0:31:48.19,0:31:50.40,Default,tiramisu,0,0,0,,Ini, buang ingus.
Dialog: 0,0:31:50.40,0:31:53.43,Default,tiramisu,0,0,0,,Saya bukan anak kecil, saya bisa melakukannya sendiri.
Dialog: 0,0:31:56.37,0:31:59.27,Default,tiramisu,0,0,0,,Sekali lagi.
Dialog: 0,0:32:04.51,0:32:06.38,Default,tiramisu,0,0,0,,-Kasim Chha.\N-Ya.
Dialog: 0,0:32:07.91,0:32:12.62,Default,tiramisu,0,0,0,,Yang Mulia, Anda sedang flu. Silakan kembali ke kamar Anda.
Dialogue: 0,0:32:12.62,0:32:14.82,Default,tiramisu,0,0,0,,Tidak, ini bukan flu.
Dialog: 0,0:32:14.82,0:32:16.79,Default,tiramisu,0,0,0,,Ini...
Dialogue: 0,0:32:19.79,0:32:22.96,Default,tiramisu,0,0,0,,Menurutku ini masuk angin. Anda benar.
Dialog: 0,0:32:23.53,0:32:25.83,Default,tiramisu,0,0,0,,Apakah ada kabar dari Balai Daejojeon?
Dialog: 0,0:32:25.83,0:32:28.93,Default,tiramisu,0,0,0,,-Tidak.\N-Apakah dia mendapatkan bukunya?
Dialog: 0,0:32:28.93,0:32:30.97,Default,tiramisu,0,0,0,,Ya, saya mengerti.
Dialogue: 0,0:32:31.60,0:32:35.07,Default,tiramisu,0,0,0,,Membuka hati yang tertutup tentu saja tidak mudah.
Dialogue: 0,0:32:35.07,0:32:37.61,Default,tiramisu,0,0,0,,Ada yang ingin kuminta padamu.
Dialog: 0,0:32:37.61,0:32:40.28,Default,tiramisu,0,0,0,,Berikan aku sesuatu yang berharga.
Dialogue: 0,0:32:42.48,0:32:45.02,Default,tiramisu,0,0,0,,Yang Anda maksud dengan “sesuatu yang berharga”...
Dialog: 0,0:32:46.55,0:32:49.32,Default,tiramisu,0,0,0,,Apa yang kamu pikirkan?
Dialog: 0,0:32:54.59,0:32:56.70,Default,tiramisu,0,0,0,,Kami menunjuk Kim Byungin
Dialog: 0,0:32:56.70,0:32:59.36,Default,tiramisu,0,0,0,,kepala Departemen Detektif.
Dialog: 0,0:32:59.46,0:33:01.33,Default,tiramisu,0,0,0,,Kerja sukses.
Dialog: 0,0:33:02.43,0:33:05.00,Default,tiramisu,0,0,0,,Terima kasih, Yang Mulia.
Dialog: 0,0:33:12.58,0:33:15.55,Default,tiramisu,0,0,0,,Kudengar kamu yang termuda yang lulus ujian negara,
Dialog: 0,0:33:15.55,0:33:17.75,Default,tiramisu,0,0,0,,juga kuat dalam seni bela diri.
Dialog: 0,0:33:18.38,0:33:20.49,Default,tiramisu,0,0,0,,Tetapi meskipun demikian,
Dialog: 0,0:33:20.49,0:33:22.35,Default,tiramisu,0,0,0,,Anda menolak jabatan di pemerintahan,
Dialog: 0,0:33:22.35,0:33:24.96,Default,tiramisu,0,0,0,,yang menyebabkan kebingungan umum.
Dialogue: 0,0:33:24.96,0:33:28.76,Default,tiramisu,0,0,0,,Apa yang membuatmu berubah pikiran?
Dialog: 0,0:33:29.73,0:33:31.80,Default,tiramisu,0,0,0,,"Selamatkan negara di masa-masa sulit."
Dialog: 0,0:33:31.80,0:33:34.63,Default,tiramisu,0,0,0,,Di masa sulit ini saya ingin membantu
Dialog: 0,0:33:34.63,0:33:37.37,Default,tiramisu,0,0,0,,dengan pemulihan ketertiban di negara.
Dialogue: 0,0:33:41.47,0:33:43.31,Default,tiramisu,0,0,0,,Masa sulit?
Dialogue: 0,0:33:43.58,0:33:46.61,Default,tiramisu,0,0,0,,Kok rupanya para menteri menyembunyikan ini dariku,
Dialog: 0,0:33:46.61,0:33:48.15,Default,tiramisu,0,0,0,,jadi saya tidak khawatir.
Dialog: 0,0:33:48.15,0:33:51.08,Default,tiramisu,0,0,0,,Siapa ini? Qing atau Jepang?
Dialog: 0,0:33:51.08,0:33:54.22,Default,tiramisu,0,0,0,,Kesulitan dalam negeri
Dialog: 0,0:33:54.25,0:33:56.89,Default,tiramisu,0,0,0,,jauh lebih berbahaya daripada ancaman eksternal.
Dialog: 0,0:33:59.29,0:34:02.33,Default,tiramisu,0,0,0,,Tiba-tiba kita mengalami kesulitan di dalam negeri?
Dialog: 0,0:34:02.33,0:34:04.56,Default,tiramisu,0,0,0,,Ini berarti...
Dialogue: 0,0:34:14.01,0:34:17.88,Default,tiramisu,0,0,0,,Aku masuk angin.
Dialogue: 0,0:34:17.88,0:34:22.65,Default,tiramisu,0,0,0,,Seorang raja yang bijaksana harus tahu cara menjaga kesehatannya.
Dialog: 0,0:34:27.09,0:34:29.79,Default,tiramisu,0,0,0,,
Dialog: 0,0:34:34.89,0:34:36.33,Default,tiramisu,0,0,0,,Kamu perlu makan,
Dialog: 0,0:34:36.33,0:34:38.20,Default,tiramisu,0,0,0,,lalu santai.
Dialog: 0,0:34:38.20,0:34:41.20,Default,tiramisu,0,0,0,,Aku tidak mau, aku akan duduk di sini sampai aku benar-benar sakit.
Dialog: 0,0:34:41.20,0:34:42.80,Default,tiramisu,0,0,0,,Biarkan tubuh menderita.
Dialog: 0,0:34:43.10,0:34:44.50,Default,tiramisu,0,0,0,,Masih bukan kesukaanku.
Dialog: 0,0:34:44.50,0:34:47.54,Default,tiramisu,0,0,0,,Biarkan dia kedinginan dan lapar.
Dialog: 0,0:34:48.54,0:34:50.64,Default,tiramisu,0,0,0,,Saya masih menginginkannya.
Dialog: 0,0:34:55.48,0:34:56.92,Default,tiramisu,0,0,0,,Yang Mulia,
Dialogue: 0,0:34:56.92,0:34:59.68,Default,tiramisu,0,0,0,,menyiksa tubuhmu tidak akan mengembalikan ingatanmu.
Dialogue: 0,0:34:59.68,0:35:01.79,Default,tiramisu,0,0,0,,Kau hanya akan melukai dirimu sendiri.
Dialog: 0,0:35:01.79,0:35:04.36,Default,tiramisu,0,0,0,,Kamu bilang ini bukan tubuhmu,
Dialog: 0,0:35:04.36,0:35:07.19,Default,tiramisu,0,0,0,,tapi itu milikmu, meskipun kamu tidak ingat apa pun.
Dialog: 0,0:35:07.19,0:35:10.53,Default,tiramisu,0,0,0,,Siapa yang akan menderita? Anda, tentu saja.
Dialog: 0,0:35:11.30,0:35:13.13,Default,tiramisu,0,0,0,,Bahkan tanpa kenangan
Dialog: 0,0:35:13.13,0:35:15.70,Default,tiramisu,0,0,0,,kamu pasti akan senang.
Dialog: 0,0:35:15.70,0:35:19.40,Default,tiramisu,0,0,0,,Lihat ke langit. Cuaca yang bagus hari ini!
Dialog: 0,0:35:23.38,0:35:26.91,Default,tiramisu,0,0,0,,Ya. Tidak ada debu di udara.
Dialog: 0,0:35:30.12,0:35:33.69,Default,tiramisu,0,0,0,,Angin sepoi-sepoi membawa aroma kotoran segar.
Dialog: 0,0:35:34.52,0:35:36.92,Default,tiramisu,0,0,0,,Makanan Korea tiga kali sehari.
Dialog: 0,0:35:37.92,0:35:39.46,Default,tiramisu,0,0,0,,Bagaimana bisa kamu tidak bahagia.
Dialog: 0,0:35:39.46,0:35:41.73,Default,tiramisu,0,0,0,,Ya, saya pasti senang.
Dialog: 0,0:35:42.73,0:35:44.73,Default,tiramisu,0,0,0,,Saya setuju dengan Anda.
Dialog: 0,0:35:47.57,0:35:50.50,Default,tiramisu,0,0,0,,Yang Mulia, apakah Anda menangis?
Dialogue: 0,0:35:50.50,0:35:53.57,Default,tiramisu,0,0,0,,Tidak, aku tidak menangis. Saya sangat senang.
Dialog: 0,0:35:53.71,0:35:54.97,Default,tiramisu,0,0,0,,Seperti yang Anda katakan,
Dialog: 0,0:35:54.97,0:35:57.68,Default,tiramisu,0,0,0,,Saya akan mencoba menjalani hidup bahagia.
Dialogue: 0,0:35:58.34,0:36:02.41,Default,tiramisu,0,0,0,,Apakah kamu sedih karena kurangnya kenangan?
Dialog: 0,0:36:08.09,0:36:11.12,Default,tiramisu,0,0,0,,Kami prihatin dengan kondisi ratu.
Dialog: 0,0:36:11.12,0:36:13.93,Default,tiramisu,0,0,0,,Oleh karena itu, kami meminta Anda untuk mempertimbangkan
Dialog: 0,0:36:13.93,0:36:16.23,Default,tiramisu,0,0,0,,pesan kami.
Dialogue: 0,0:36:16.23,0:36:17.80,Default,tiramisu,0,0,0,,Apa ini?
Dialog: 0,0:36:17.80,0:36:20.73,Default,tiramisu,0,0,0,,Sudahkah Anda membahas penggulingan ratu?
Dialog: 0,0:36:21.30,0:36:22.73,Default,tiramisu,0,0,0,,-Apa?\N-Apa?
Dialog: 0,0:36:22.73,0:36:26.64,Default,tiramisu,0,0,0,,Sang Ratu tidak menyerah untuk mencoba bunuh diri,
Dialog: 0,0:36:26.64,0:36:30.01,Default,tiramisu,0,0,0,,dan kita perlu memperkuat posisi halaman.
Dialog: 0,0:36:31.21,0:36:34.35,Default,tiramisu,0,0,0,,Pertimbangkan untuk menggulingkan ratu.
Dialog: 0,0:36:34.88,0:36:39.25,Default,tiramisu,0,0,0,,Ratu berbohong untuk melindungi
Dialog: 0,0:36:39.25,0:36:41.72,Default,tiramisu,0,0,0,,selir Cho.
Dialog: 0,0:36:41.72,0:36:44.29,Default,tiramisu,0,0,0,,Setelah jatuh ke danau, dia kehilangan akal sehatnya.
Dialog: 0,0:36:44.29,0:36:46.29,Default,tiramisu,0,0,0,,Dia menganggap dirinya orang lain.
Dialog: 0,0:36:46.29,0:36:48.63,Default,tiramisu,0,0,0,,Dan saat melihat air dia mencoba bunuh diri.
Dialog: 0,0:36:48.63,0:36:50.63,Default,tiramisu,0,0,0,,Rumor sudah menyebar!
Dialog: 0,0:36:50.63,0:36:52.80,Default,tiramisu,0,0,0,,Menurut rumor,
Dialog: 0,0:36:52.80,0:36:54.77,Default,tiramisu,0,0,0,,lalu kata-kata itu Selir Cho
Dialog: 0,0:36:54.77,0:36:57.80,Default,tiramisu,0,0,0,,mendorong ratu, juga harus benar.
Dialog: 0,0:36:57.80,0:36:59.07,Default,tiramisu,0,0,0,,Apa?
Dialog: 0,0:36:59.07,0:37:01.21,Default,tiramisu,0,0,0,,-Beraninya?-Kamu.
Dialog: 0,0:37:01.41,0:37:03.47,Default,tiramisu,0,0,0,,Tenang!
Dialog: 0,0:37:04.58,0:37:08.98,Default,tiramisu,0,0,0,,Saya akan menolak permintaan karena melanggar perintah penyajian.
Dialog: 0,0:37:08.98,0:37:11.35,Default,tiramisu,0,0,0,,Kamu harus pergi bersamanya ke Seungjeongwon dulu.
Dialog: 0,0:37:11.35,0:37:14.42,Default,tiramisu,0,0,0,,Namun, aku seperti suami seorang ratu
Dialog: 0,0:37:14.42,0:37:16.69,Default,tiramisu,0,0,0,,dan orang terdekatnya,
Dialog: 0,0:37:17.69,0:37:20.66,Default,tiramisu,0,0,0,,Saya bilang pikirannya baik-baik saja.
Dialog: 0,0:37:22.33,0:37:24.96,Default,tiramisu,0,0,0,,-Namun...\N-Kita harus tenang.
Dialog: 0,0:37:24.96,0:37:28.73,Default,tiramisu,0,0,0,,Mari kita akhiri pertemuan hari ini.
Dialog: 0,0:37:30.34,0:37:32.07,Default,tiramisu,0,0,0,,Saya mengizinkannya.
Dialog: 0,0:37:33.10,0:37:34.71,Default,tiramisu,0,0,0,,Yang Mulia.
Dialogue: 0,0:37:38.51,0:37:40.31,Default,tiramisu,0,0,0,,Apa yang membawamu kesini?
Dialog: 0,0:37:40.31,0:37:42.61,Default,tiramisu,0,0,0,,Kudengar kamu ada di sini.
Dialogue: 0,0:37:43.98,0:37:47.02,Default,tiramisu,0,0,0,,Sudah dengar beritanya?
Dialog: 0,0:37:48.17,0:37:50.47,Default,tiramisu,0,0,0,,Raja Akan Datang!
Dialog: 0,0:37:51.29,0:37:52.92,Default,tiramisu,0,0,0,,Ratuku.
Dialog: 0,0:37:56.06,0:37:57.33,Default,tiramisu,0,0,0,,Anda sudah berada di sini.
Dialog: 0,0:37:57.33,0:37:59.46,Default,tiramisu,0,0,0,,Hanya kamu yang terlambat ke sini.
Dialogue: 0,0:37:59.46,0:38:01.67,Default,tiramisu,0,0,0,,Menurutku sepertinya,
Dialog: 0,0:38:01.67,0:38:03.07,Default,tiramisu,0,0,0,,tapi kepala Departemen Detektif
Dialog: 0,0:38:03.07,0:38:05.10,Default,tiramisu,0,0,0,,sangat tidak senang denganku.
Dialog: 0,0:38:05.97,0:38:07.01,Default,tiramisu,0,0,0,,Kepala Departemen Detektif?
Dialogue: 0,0:38:07.01,0:38:10.41,Default,tiramisu,0,0,0,,Kau mengabaikan ratu dan mempermalukannya,
Dialog: 0,0:38:10.41,0:38:13.41,Default,tiramisu,0,0,0,,siapa yang menyelamatkan kekasihmu.
Dialog: 0,0:38:13.51,0:38:17.21,Default,tiramisu,0,0,0,,Saya bisa membayangkan bagaimana Anda memperlakukan ratu selama ini.
Dialogue: 0,0:38:17.58,0:38:20.22,Default,tiramisu,0,0,0,,Mungkin itu sebabnya dia mencoba bunuh diri.
Dialog: 0,0:38:22.65,0:38:24.39,Default,tiramisu,0,0,0,,Jangan lihat aku.
Dialogue: 0,0:38:24.82,0:38:26.99,Default,tiramisu,0,0,0,,Sang Ratu kebingungan,
Dialog: 0,0:38:26.99,0:38:29.43,Default,tiramisu,0,0,0,,karena aku mencoba menyelamatkan selirmu.
Dialog: 0,0:38:29.43,0:38:31.76,Default,tiramisu,0,0,0,,-Apa yang akan kamu lakukan?\N-Apa?
Dialog: 0,0:38:31.76,0:38:34.30,Default,tiramisu,0,0,0,,Saya akan membantunya mengatasi ini.
Dialog: 0,0:38:34.30,0:38:38.30,Default,tiramisu,0,0,0,,Bagaimana? Apa yang bisa kamu lakukan?
Dialogue: 0,0:38:41.51,0:38:43.21,Default,tiramisu,0,0,0,,Kamu bertanya sekarang
Dialog: 0,0:38:43.21,0:38:45.68,Default,tiramisu,0,0,0,,seperti saudara ratu
Dialog: 0,0:38:45.68,0:38:48.28,Default,tiramisu,0,0,0,,atau sebagai anak angkat Kim Jwageun?
Dialog: 0,0:38:48.28,0:38:51.05,Default,tiramisu,0,0,0,,Kamu tidak punya kekuatan untuk melindunginya.
Dialog: 0,0:38:51.05,0:38:53.72,Default,tiramisu,0,0,0,,Saya mengatakan apa yang saya lihat.
Dialog: 0,0:38:54.52,0:38:56.39,Default,tiramisu,0,0,0,,Tidak ada daya?
Dialog: 0,0:38:58.86,0:39:00.62,Default,tiramisu,0,0,0,,Benar.
Dialog: 0,0:39:01.23,0:39:05.30,Default,tiramisu,0,0,0,,Namun, saya tidak membutuhkan kekuatan melawan yang kuat.
Dialog: 0,0:39:05.30,0:39:08.40,Default,tiramisu,0,0,0,,Ada cara yang lebih damai.
Dialog: 0,0:39:08.50,0:39:11.40,Default,tiramisu,0,0,0,,Aku hanya perlu patuh.
Dialog: 0,0:39:11.40,0:39:13.70,Default,tiramisu,0,0,0,,Untuk melindungi ratu,
Dialogue: 0,0:39:14.44,0:39:16.67,Default,tiramisu,0,0,0,,Aku akan patuh.
Dialog: 0,0:39:16.91,0:39:18.88,Default,tiramisu,0,0,0,,Tidak perlu melakukan ini.
Dialog: 0,0:39:18.88,0:39:21.61,Default,tiramisu,0,0,0,,Aku sendiri yang akan melindungi ratu.
Dialog: 0,0:39:23.98,0:39:27.02,Default,tiramisu,0,0,0,,Aku akan menghentikan yang kuat dengan lebih banyak kekuatan.
Dialog: 0,0:39:35.83,0:39:37.30,Default,tiramisu,0,0,0,,Di Sini.
Dialogue: 0,0:39:37.30,0:39:39.00,Default,tiramisu,0,0,0,,Apa yang terjadi disini?
Dialog: 0,0:39:39.00,0:39:40.40,Default,tiramisu,0,0,0,,Saya lihat ini masalah saya.
Dialog: 0,0:39:40.40,0:39:41.83,Default,tiramisu,0,0,0,,Kenapa harus bertengkar?
Dialogue: 0,0:39:41.83,0:39:44.87,Default,tiramisu,0,0,0,,Apa yang terjadi? Apa yang ada disana?
Dialog: 0,0:39:44.87,0:39:48.17,Default,tiramisu,0,0,0,,Saya telah menerima pesan tentang penggulingan Anda.
Dialog: 0,0:39:49.47,0:39:52.54,Default,tiramisu,0,0,0,,Bagaimana bisa? Saya baru saja memutuskan untuk menyukai tempat ini.
Dialogue: 0,0:39:52.54,0:39:53.75,Default,tiramisu,0,0,0,,Mereka ingin membunuh,
Dialog: 0,0:39:53.75,0:39:55.95,Default,tiramisu,0,0,0,,dan sekarang semua orang ingin menggulingkannya.
Dialogue: 0,0:39:56.05,0:39:58.42,Default,tiramisu,0,0,0,,Seseorang ingin menggulingkanmu?
Dialog: 0,0:39:58.88,0:40:01.35,Default,tiramisu,0,0,0,,Janda Ratu marah padaku.
Dialog: 0,0:40:02.02,0:40:04.49,Default,tiramisu,0,0,0,,Aku akan bicara dengannya.
Dialogue: 0,0:40:04.82,0:40:07.06,Default,tiramisu,0,0,0,,Sebenarnya, saya tahu cara mengatasinya.
Dialogue: 0,0:40:08.16,0:40:11.83,Default,tiramisu,0,0,0,,Kok, ternyata kamu juga masuk angin.
Dialog: 0,0:40:16.17,0:40:17.90,Default,tiramisu,0,0,0,,Kamu juga?
Dialog: 0,0:40:19.00,0:40:20.84,Default,tiramisu,0,0,0,,Meskipun mendesak,
Dialog: 0,0:40:20.84,0:40:23.97,Default,tiramisu,0,0,0,,kamu harus kembali dan istirahat.
Dialogue: 0,0:40:25.08,0:40:28.48,Default,tiramisu,0,0,0,,Jika kamu mengatakan semua yang kamu inginkan, kamu boleh pergi.
Dialog: 0,0:40:28.55,0:40:30.85,Default,tiramisu,0,0,0,,Kita perlu mendiskusikan masalah pribadi.
Dialog: 0,0:40:31.08,0:40:34.49,Default,tiramisu,0,0,0,,Ada yang ingin kukatakan padamu, jadi aku akan menunggu.
Dialogue: 0,0:40:36.22,0:40:39.12,Default,tiramisu,0,0,0,,-Aku akan kembali.\N-Ya.
Dialog: 0,0:40:47.53,0:40:49.93,Default,tiramisu,0,0,0,,Saya ingin menunggu jawaban Anda,
Dialog: 0,0:40:49.93,0:40:51.90,Default,tiramisu,0,0,0,,tapi tidak ada waktu.
Dialog: 0,0:40:51.94,0:40:55.61,Default,tiramisu,0,0,0,,Mulai sekarang saya akan mengikuti aturan menjaga jarak.
Dialogue: 0,0:40:55.61,0:40:57.78,Default,tiramisu,0,0,0,,Kenapa kamu tiba-tiba membicarakan hal ini?
Dialog: 0,0:40:57.78,0:41:00.61,Default,tiramisu,0,0,0,,Kalau tidak mau, aku yang mengikutinya.
Dialog: 0,0:41:00.75,0:41:02.35,Default,tiramisu,0,0,0,,Jarak.
Dialogue: 0,0:41:02.75,0:41:04.62,Default,tiramisu,0,0,0,,Kamu salah paham.
Dialogue: 0,0:41:04.62,0:41:07.38,Default,tiramisu,0,0,0,,-Ulurkan tanganmu.\N-Kenapa?
Dialog: 0,0:41:07.92,0:41:09.69,Default,tiramisu,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:41:24.10,0:41:25.90,Default,tiramisu,0,0,0,,Hidupku
Dialog: 0,0:41:26.20,0:41:29.74,Default,tiramisu,0,0,0,,selalu ada di tangan keluargamu.
Dialogue: 0,0:41:30.68,0:41:32.98,Default,tiramisu,0,0,0,,Rupanya ini membutakanku.
Dialog: 0,0:41:34.21,0:41:38.38,Default,tiramisu,0,0,0,,Dan aku tidak bisa melihat bahwa kamu\N adalah wanita lugu yang
Dialog: 0,0:41:38.45,0:41:40.85,Default,tiramisu,0,0,0,,mencoba yang terbaik.
Dialogue: 0,0:41:42.09,0:41:44.15,Default,tiramisu,0,0,0,,Maaf terlambat.
Dialog: 0,0:41:45.19,0:41:47.76,Default,tiramisu,0,0,0,,Beri aku satu kesempatan lagi.
Dialog: 0,0:41:48.89,0:41:51.03,Default,tiramisu,0,0,0,,Kesempatan untuk memahamimu
Dialog: 0,0:41:51.23,0:41:55.63,Default,tiramisu,0,0,0,,sebagai individu tanpa prasangka apa pun.
Dialog: 0,0:41:59.34,0:42:01.04,Default,tiramisu,0,0,0,,Tidak perlu melakukan ini.
Dialog: 0,0:42:01.04,0:42:03.14,Default,tiramisu,0,0,0,,Aku tahu kamu tidak suka pamer.
Dialog: 0,0:42:03.21,0:42:06.78,Default,tiramisu,0,0,0,,Tetapi saya harus dengan tulus meminta maaf setidaknya sekali.
Dialog: 0,0:42:06.78,0:42:07.98,Default,tiramisu,0,0,0,,Lakukan sesukamu.
Dialog: 0,0:42:07.98,0:42:09.98,Default,tiramisu,0,0,0,,Oke. Itulah yang akan kami lakukan. Menjauhkan.
Dialog: 0,0:42:09.98,0:42:12.15,Default,tiramisu,0,0,0,,Saya tidak akan rugi apa pun.
Dialog: 0,0:42:15.59,0:42:19.06,Default,tiramisu,0,0,0,,Maka hari ini adalah hari pertama kita.
Dialog: 0,0:42:19.36,0:42:20.39,Default,tiramisu,0,0,0,,Apa?
Dialog: 0,0:42:20.39,0:42:22.69,Default,tiramisu,0,0,0,,Hari pertama pembatasan jarak.
Dialog: 0,0:42:23.13,0:42:25.43,Default,tiramisu,0,0,0,,Jangan katakan itu.
Dialog: 0,0:42:25.43,0:42:28.27,Default,tiramisu,0,0,0,,-Mengapa?\N-Jangan katakan itu. Jangan berani-berani.
Dialogue: 0,0:42:28.47,0:42:30.57,Default,tiramisu,0,0,0,,Apa salahku bilang?
Dialog: 0,0:42:30.57,0:42:31.84,Default,tiramisu,0,0,0,,Hari ini adalah hari pertama kita.
Dialogue: 0,0:42:31.84,0:42:34.74,Default,tiramisu,0,0,0,,F. Dia menyuruhku untuk tidak bicara!
Dialogue: 0,0:42:35.81,0:42:38.21,Default,tiramisu,0,0,0,,Tapi aku cuma bilang, hari ini adalah...
Dialog: 0,0:42:38.21,0:42:40.44,Default,tiramisu,0,0,0,,Hentikan!
Dialog: 0,0:42:40.98,0:42:43.28,Default,tiramisu,0,0,0,,Saya yakin Anda tahu artinya, bukan?
Dialog: 0,0:42:43.28,0:42:45.32,Default,tiramisu,0,0,0,,Tapi hari ini adalah...
Dialog: 0,0:42:45.32,0:42:47.52,Default,tiramisu,0,0,0,,Hentikan. Menjijikkan sekali!
Dialog: 0,0:42:47.52,0:42:48.85,Default,tiramisu,0,0,0,,-Tapi ini hari pertama kami.\N-Sudah Berhenti.
Dialog: 0,0:42:48.85,0:42:50.92,Default,tiramisu,0,0,0,,-Kami...\N-Hentikan.
Dialog: 0,0:42:52.29,0:42:54.96,Default,tiramisu,0,0,0,,Lalu, karena kita sudah menyelesaikan masalah ini,
Dialog: 0,0:42:55.23,0:42:58.00,Default,tiramisu,0,0,0,,Aku akan melakukan segalanya untuk melindungimu.
Dialogue: 0,0:42:58.00,0:43:00.67,Default,tiramisu,0,0,0,,Oh, tepat sekali. Tidak ada waktu untuk bermalas-malasan.
Dialog: 0,0:43:00.67,0:43:02.40,Default,tiramisu,0,0,0,,Sampai jumpa.
Dialog: 0,0:43:03.03,0:43:05.84,Default,tiramisu,0,0,0,,Berhenti. Jangan lari seperti itu. Jangan lari.
Dialog: 0,0:43:07.07,0:43:08.77,Default,tiramisu,0,0,0,,Kamu bisa terluka.
Dialog: 0,0:43:22.55,0:43:24.36,Default,zinger,0,0,0,,Bicara.
Dialogue: 0,0:43:24.36,0:43:28.73,Default,zinger,0,0,0,,Jika ratu tidak bahagia, maka kamu juga akan sedih.
Dialogue: 0,0:43:28.96,0:43:31.93,Default,zinger,0,0,0,,-Apakah ini ancaman?\N-Hanya kekhawatiran saya.
Dialogue: 0,0:43:33.20,0:43:37.80,Default,zinger,0,0,0,,Kamu hanya kakaknya, tapi kamu terlalu protektif.
Dialogue: 0,0:43:37.80,0:43:40.80,Default,zinger,0,0,0,,Anda terlalu cuek, Yang Mulia.
Dialog: 0,0:43:41.31,0:43:44.24,Default,zinger,0,0,0,,Saya tahu saya tidak punya banyak kekuatan,
Dialog: 0,0:43:44.31,0:43:46.51,Default,zinger,0,0,0,,tetapi kesopanan perlu diperhatikan.
Dialog: 0,0:43:46.51,0:43:49.15,Default,zinger,0,0,0,,Jika kamu melewati batas lagi,
Dialog: 0,0:43:49.15,0:43:52.15,Default,penyanyi,0,0,0,,Saya akan mengangkat masalah perilaku Anda.
Dialog: 0,0:43:53.32,0:43:55.45,Default,zinger,0,0,0,,Ayo.
Dialogue: 0,0:43:57.36,0:43:59.52,Default,zinger,0,0,0,,Aku akan membuatmu menulis
Dialog: 0,0:44:00.86,0:44:03.43,Default,zinger,0,0,0,,surat permintaan maaf yang sangat panjang.
Dialog: 0,0:44:05.56,0:44:08.33,Default,zinger,0,0,0,,Panjang saja.
Dialog: 0,0:44:08.83,0:44:11.30,Default,zinger,0,0,0,,Kamu mungkin harus begadang semalaman.
Dialog: 0,0:44:12.10,0:44:14.47,Default,zinger,0,0,0,,Dan jarimu akan sakit.
Dialogue: 0,0:44:28.59,0:44:31.52,Default,zinger,0,0,0,,Apakah mereka yakin dia bisa digulingkan?
Dialog: 0,0:44:31.52,0:44:33.09,Default,zinger,0,0,0,,Karena permintaan sederhana?
Dialogue: 0,0:44:33.09,0:44:36.63,Default,zinger,0,0,0,,Mereka mencoba mengumpulkan kekuatan dengan ini.
Dialog: 0,0:44:37.26,0:44:39.73,Default,zinger,0,0,0,,Mereka akan mengumpulkan orang-orang yang tidak menyukai jenis kita,
Dialog: 0,0:44:39.73,0:44:42.53,Default,zinger,0,0,0,,dan akan menambah jumlah permintaan. Semuanya jelas.
Dialogue: 0,0:44:42.53,0:44:46.40,Default,zinger,0,0,0,,Beraninya mereka bergerak begitu ceroboh?
Dialogue: 0,0:44:46.40,0:44:48.74,Default,zinger,0,0,0,,Kita seharusnya melalui ini setidaknya sekali.
Dialog: 0,0:44:48.74,0:44:50.84,Default,zinger,0,0,0,,Yang Mulia,
Dialog: 0,0:44:50.84,0:44:53.54,Default,zinger,0,0,0,,ratu telah tiba.
Dialogue: 0,0:44:54.98,0:44:56.71,Default,zinger,0,0,0,,Biarkan aku masuk.
Dialog: 0,0:45:16.17,0:45:20.60,Default,zinger,0,0,0,,Maafkan saya yang terdalam karena mengganggu Anda.
Dialog: 0,0:45:22.71,0:45:26.58,Default,zinger,0,0,0,,Saya layak dicopot dari gelar saya.
Dialog: 0,0:45:27.48,0:45:29.78,Default,zinger,0,0,0,,Tetapi meskipun demikian,
Dialogue: 0,0:45:29.91,0:45:32.65,Default,zinger,0,0,0,,ratu janda harus melakukan ini.
Dialogue: 0,0:45:32.65,0:45:37.29,Default,zinger,0,0,0,,Salah jika seseorang dari keluarga Cho melakukan ini.
Dialogue: 0,0:45:38.99,0:45:41.29,Default,zinger,0,0,0,,Tidak peduli orang bodoh macam apa kamu, tak seorang pun akan mentolerirnya,
Dialog: 0,0:45:41.29,0:45:43.89,Default,zinger,0,0,0,,sehingga bawahannya \Ndikelola oleh orang lain.
Dialogue: 0,0:45:43.90,0:45:45.66,Default,zinger,0,0,0,,Ini masalah harga diri.
Dialog: 0,0:45:45.66,0:45:48.53,Default,zinger,0,0,0,,Jika seseorang dari keluarga Cho merampas gelarku,
Dialog: 0,0:45:48.53,0:45:50.84,Default,zinger,0,0,0,,itu bukan kekalahanku,
Dialog: 0,0:45:50.84,0:45:53.54,Default,zinger,0,0,0,,ini akan menjadi kekalahan bagi keluarga Kim.
Dialog: 0,0:45:54.41,0:45:56.41,Default,penyanyi,0,0,0,,Jika Anda memahami ini,
Dialogue: 0,0:45:56.41,0:45:58.38,Default,penyanyi,0,0,0,,bagaimana dia bisa melakukan apa yang menjadi tanggung jawabnya?
Dialogue: 0,0:45:58.38,0:46:00.61,Default,zinger,0,0,0,,Mereka mengandalkan rumor.
Dialog: 0,0:46:00.61,0:46:02.08,Default,zinger,0,0,0,,Aku akan mengurusnya.
Dialog: 0,0:46:02.08,0:46:03.11,Default,zinger,0,0,0,,Dan bagaimana caranya?
Dialogue: 0,0:46:03.11,0:46:04.65,Default,penyanyi,0,0,0,,Krisis adalah kesempatan kita.
Dialog: 0,0:46:04.65,0:46:07.25,Default,zinger,0,0,0,,Jika Anda memberi saya waktu,\NI akan menggunakannya,
Dialogue: 0,0:46:07.25,0:46:10.32,Default,zinger,0,0,0,,untuk mengubah reputasimu.
Dialog: 0,0:46:20.23,0:46:22.83,Default,zinger,0,0,0,,Hari ini raja memihakmu,
Dialog: 0,0:46:22.83,0:46:25.70,Default,zinger,0,0,0,,ketika saya menerima keluhan.
Dialogue: 0,0:46:26.64,0:46:28.67,Default,zinger,0,0,0,,Idiot Cheoljong?
Dialog: 0,0:46:29.57,0:46:31.64,Default,zinger,0,0,0,,Apa yang ratu lakukan,
Dialog: 0,0:46:31.64,0:46:34.65,Default,zinger,0,0,0,,tidak sia-sia.
Dialogue: 0,0:46:37.55,0:46:41.42,Default,zinger,0,0,0,,Aku harus memberi pelajaran pada Ibu Suri.
Dialog: 0,0:46:41.95,0:46:44.96,Default,zinger,0,0,0,,Akan kutunjukkan padanya siapa bos di istana ini.
Dialogue: 0,0:46:50.96,0:46:53.00,Default,zinger,0,0,0,,Apakah ini semua pembawa tandu?
Dialog: 0,0:46:53.83,0:46:54.83,Default,zinger,0,0,0,,Hanya...
Dialog: 0,0:46:54.83,0:46:56.63,Default,zinger,0,0,0,,Pilih lagi. Pastikan mereka lucu.
Dialog: 0,0:46:56.63,0:46:58.90,Default,zinger,0,0,0,,Ya, Yang Mulia. Lucu.
Dialog: 0,0:46:59.57,0:47:01.21,Default,zinger,0,0,0,,Apa?
Dialogue: 0,0:47:03.81,0:47:06.21,Default,zinger,0,0,0,,Biarkan mereka tinggi dan bertubuh bagus.
Dialog: 0,0:47:06.21,0:47:08.18,Default,zinger,0,0,0,,Tunggulnya bening, dan masih muda.
Dialogue: 0,0:47:11.25,0:47:14.59,Default,zinger,0,0,0,,Apakah kamu benar-benar memilih porter?
Dialogue: 0,0:47:14.79,0:47:17.79,Default,zinger,0,0,0,,Saya memilih bukan hanya pembawa tandu.
Dialog: 0,0:47:18.06,0:47:20.06,Default,zinger,0,0,0,,Kamu akan takjub saat memahaminya.
Dialog: 0,0:47:21.73,0:47:24.19,Default,zinger,0,0,0,,Saya pilih...
Dialog: 0,0:47:32.64,0:47:35.74,Default,zinger,0,0,0,, -Omong-omong. Pernahkah kamu mendengar gosip?\N-Apa?
Dialog: 0,0:47:35.74,0:47:38.34,Default,zinger,0,0,0,,Sang Ratu tidak mencoba bunuh diri.
Dialog: 0,0:47:38.34,0:47:40.94,Default,zinger,0,0,0,,Dia ingin menyelamatkan raja dan selirnya.
Dialogue: 0,0:47:43.21,0:47:45.38,Default,zinger,0,0,0,,Aku ingin menyelamatkan raja dan selirnya,
Dialogue: 0,0:47:45.38,0:47:47.72,Default,zinger,0,0,0,,makanya dia berbohong dan bilang itu bunuh diri.
Dialog: 0,0:47:47.72,0:47:49.15,Default,zinger,0,0,0,,Panas!
Dialog: 0,0:47:49.15,0:47:50.89,Default,zinger,0,0,0,,-Keluarga...\N-Atau suami.
Dialog: 0,0:47:50.89,0:47:52.62,Default,zinger,0,0,0,,-Itulah...\N-Pertanyaan.
Dialog: 0,0:47:52.62,0:47:56.16,Default,zinger,0,0,0,,Dan pada akhirnya dia kehilangan kepercayaan dari ratu janda.
Dialog: 0,0:47:56.16,0:47:59.26,Default,zinger,0,0,0,,Dan dia meletakkan pisau perak di lehernya dan berkata:
Dialog: 0,0:47:59.26,0:48:02.03,Default,zinger,0,0,0,,"Aku akan lepas dari nasib malang ini,
Dialog: 0,0:48:02.03,0:48:04.17,Default,zinger,0,0,0,,di mana saya tidak dapat memilih salah satu pihak.”
Dialog: 0,0:48:05.47,0:48:07.51,Default,penyanyi,0,0,0,,Itulah yang dia katakan.
Dialogue: 0,0:48:07.51,0:48:09.54,Default,zinger,0,0,0,,Dia adalah seorang penyihir.
Dialogue: 0,0:48:09.54,0:48:12.91,Default,zinger,0,0,0,,Rumornya dia masuk surga.
Dialogue: 0,0:48:13.64,0:48:15.71,Default,zinger,0,0,0,,Karena kamu terjatuh ke dalam danau?
Dialog: 0,0:48:15.85,0:48:19.92,Default,zinger,0,0,0,,Dan saat aku bertemu Kaisar Langit, aku berubah menjadi peri.
Dialog: 0,0:48:27.02,0:48:29.09,Default,zinger,0,0,0,,Luar Biasa.
Dialog: 0,0:48:29.09,0:48:31.63,Default,zinger,0,0,0,,Saya tidak hanya memilih porter,
Dialog: 0,0:48:31.63,0:48:33.10,Default,zinger,0,0,0,,Saya memilih pendongeng.
Dialogue: 0,0:48:33.10,0:48:37.30,Default,penyanyi,0,0,0,,Tabloid live yang akan menyebarkan rumor seperti infeksi.
Dialog: 0,0:48:37.74,0:48:39.04,Default,zinger,0,0,0,,Apa?
Dialogue: 0,0:48:39.04,0:48:42.34,Default,zinger,0,0,0,,Saat rumor mulai menyebar,\N berubah menjadi infeksi.
Dialogue: 0,0:48:42.34,0:48:45.51,Default,zinger,0,0,0,,Mereka tersebar begitu banyak sehingga bahkan orang yang memulai semuanya tidak mampu menghentikannya.
Dialog: 0,0:48:45.51,0:48:48.55,Default,zinger,0,0,0,,Dan mereka menyebar dengan cara yang tidak terduga.
Dialogue: 0,0:48:48.55,0:48:50.48,Default,zinger,0,0,0,,Jika dia tidak mencoba bunuh diri,
Dialog: 0,0:48:50.48,0:48:54.08,Default,zinger,0,0,0,,jadi orang yang mendorongnya ke danau...
Dialogue: 0,0:48:55.15,0:48:58.16,Default,zinger,0,0,0,,Artinya, sang ratu mempertaruhkan nyawanya untuk
Dialog: 0,0:48:58.16,0:49:00.52,Default,zinger,0,0,0,,menyelamatkan selir yang mencoba membunuhnya?
Dialog: 0,0:49:01.73,0:49:03.59,Default,zinger,0,0,0,,Ibu.
Dialogue: 0,0:49:07.97,0:49:10.10,Default,zinger,0,0,0,,Entah kenapa aku tiba-tiba merasa merinding.
Dialog: 0,0:49:11.34,0:49:13.97,Default,zinger,0,0,0,,Sudah waktunya kamu istirahat.
Dialog: 0,0:49:14.21,0:49:16.21,Default,zinger,0,0,0,,Ini tidak akan berhasil. Aku akan menggendongmu jika perlu.
Dialog: 0,0:49:16.21,0:49:18.88,Default,zinger,0,0,0,,Ayo. Oke oke.
Dialogue: 0,0:49:18.88,0:49:22.01,Default,zinger,0,0,0,,Nyonya Choi tidak mengomel padaku, jadi sekarang kamu.
Dialog: 0,0:49:22.01,0:49:24.58,Default,penyanyi,0,0,0,,Semacam hukum konservasi untuk menggerutu, atau apa?
Dialog: 0,0:49:25.78,0:49:29.32,Default,zinger,0,0,0,,Ngomong-ngomong, aku sudah lama tidak melihatnya.
Dialogue: 0,0:49:29.39,0:49:31.52,Default,zinger,0,0,0,,Bodoh sekali.
Dialogue: 0,0:49:33.02,0:49:35.86,Default,zinger,0,0,0,,Bisakah kamu memelukku erat-erat? Dingin.
Dialog: 0,0:50:12.00,0:50:15.73,Default,zinger,0,0,0,,Yang Mulia!
Dialogue: 0,0:50:15.73,0:50:18.34,Default,zinger,0,0,0,,Bagaimana kamu bisa menyakiti dirimu sendiri?
Dialogue: 0,0:50:18.34,0:50:21.77,Default,zinger,0,0,0,,Apakah kamu mau aku jadi gila?
Dialogue: 0,0:50:21.77,0:50:25.28,Default,zinger,0,0,0,,Bagaimana kamu bisa mengatur acara berenang bersama raja?
Dialog: 0,0:50:25.28,0:50:28.41,Default,zinger,0,0,0,,Apakah Anda ingin menempatkan negara dalam situasi berbahaya?
Dialog: 0,0:50:28.41,0:50:30.48,Default,zinger,0,0,0,,Jimat? Upacara?
Dialogue: 0,0:50:30.48,0:50:33.92,Default,zinger,0,0,0,,Anda tidak boleh terlibat dalam prasangka seperti itu.
Dialog: 0,0:50:33.92,0:50:37.82,Default,zinger,0,0,0,,Dan kamu juga tidak bisa mengatakan itu.
Dialog: 0,0:50:37.82,0:50:40.76,Default,zinger,0,0,0,,Dari pertama hingga terakhir,
Dialog: 0,0:50:40.76,0:50:45.73,Default,zinger,0,0,0,,semua ini tidak diperbolehkan!
Dialogue: 0,0:50:56.11,0:51:00.81,Default,zinger,0,0,0,,Entah kenapa aku tidak merasa lebih baik setelah itu.
Dialogue: 0,0:51:00.81,0:51:04.78,Default,zinger,0,0,0,,Jika aku menggerutu padanya, Yang Mulia akan gelisah.
Dialogue: 0,0:51:05.45,0:51:09.75,Default,zinger,0,0,0,,Jika tidak, maka aku gelisah.
Dialogue: 0,0:51:10.32,0:51:15.29,Default,zinger,0,0,0,,Jadi apa yang harus kulakukan?
Dialog: 0,0:51:21.60,0:51:27.00,Default,zinger,0,0,0,,Yang Mulia!
Dialogue: 0,0:51:27.14,0:51:30.04,Default,zinger,0,0,0,,- Pernahkah kamu mendengar rumornya? \N-Apa?
Dialogue: 0,0:51:30.04,0:51:32.44,Default,zinger,0,0,0,,Hanya ini yang mereka bisikkan di istana.
Dialog: 0,0:51:32.44,0:51:35.25,Default,zinger,0,0,0,,Mereka bilang ratu mempertaruhkan nyawanya,
Dialog: 0,0:51:35.25,0:51:37.58,Default,zinger,0,0,0,,untuk menyelamatkanmu, yang mencoba membunuhnya.
Dialogue: 0,0:51:37.72,0:51:39.62,Default,zinger,0,0,0,,Siapa yang bisa bilang begitu?
Dialogue: 0,0:51:40.18,0:51:42.22,Default,zinger,0,0,0,,Dan bukan ratunya?
Dialog: 0,0:51:42.35,0:51:44.89,Default,zinger,0,0,0,,Diubah oleh rumor bahwa dia adalah penyihir lokal,
Dialog: 0,0:51:44.89,0:51:47.22,Default,zinger,0,0,0,,bahwa dia adalah seorang Buddha, peri, wanita berbudi luhur.
Dialog: 0,0:51:47.22,0:51:50.36,Default,zinger,0,0,0,,Dia berhasil mengubah suasana hati semua orang.
Dialogue: 0,0:51:51.80,0:51:56.17,Default,zinger,0,0,0,,Sekarang mereka akan mengutukmu dan mengatakan bahwa kamu tidak bermoral.
Dialogue: 0,0:51:57.57,0:52:00.70,Default,zinger,0,0,0,,Dia punya rencana ini sejak awal.
Dialog: 0,0:52:00.70,0:52:04.18,Default,zinger,0,0,0,,Dia mendatangiku di aula Sononjong dan mengancamku.
Dialog: 0,0:52:04.18,0:52:06.01,Default,zinger,0,0,0,,Jadi itulah alasannya.
Dialog: 0,0:52:07.38,0:52:09.98,Default,zinger,0,0,0,,Aku akan menemui raja dan memberitahunya,
Dialog: 0,0:52:09.98,0:52:13.42,Default,zinger,0,0,0,,sehingga ratu tidak bisa lagi menipunya.
Dialog: 0,0:52:13.82,0:52:15.55,Default,zinger,0,0,0,,Tidak yakin.
Dialogue: 0,0:52:16.15,0:52:20.12,Default,zinger,0,0,0,,Akankah dia percaya kata-katamu?
Dialog: 0,0:52:20.36,0:52:23.46,Default,zinger,0,0,0,,Raja akan percaya apa yang kukatakan padanya.
Dialog: 0,0:52:23.46,0:52:27.70,Default,zinger,0,0,0,,Dia menolak permintaan untuk menggulingkan ratu.
Dialog: 0,0:52:33.07,0:52:35.81,Default,zinger,0,0,0,,Selir kerajaan telah tiba.
Dialog: 0,0:52:40.34,0:52:42.01,Default,zinger,0,0,0,,Hwajin.
Dialog: 0,0:52:43.45,0:52:47.35,Default,zinger,0,0,0,,Aku baru saja mau menemuimu,\Nkita perlu membicarakan sesuatu.
Dialogue: 0,0:52:47.95,0:52:50.45,Default,zinger,0,0,0,,Tentang apa?
Dialog: 0,0:52:50.45,0:52:52.62,Default,zinger,0,0,0,,Hari ini di dewan
Dialog: 0,0:52:52.62,0:52:55.89,Default,zinger,0,0,0,,Saya telah menerima petisi untuk menggulingkan ratu.
Dialog: 0,0:52:57.06,0:52:58.46,Default,zinger,0,0,0,,Benarkah?
Dialog: 0,0:52:58.46,0:53:01.63,Default,zinger,0,0,0,,Sang Ratu menempatkan dirinya dalam bahaya untuk menyelamatkan kita,
Dialogue: 0,0:53:01.63,0:53:04.37,Default,zinger,0,0,0,,Saya pikir menjauh itu salah.
Dialog: 0,0:53:04.60,0:53:09.24,Default,zinger,0,0,0,,Jadi saya ingin meminta sekretariat kerajaan untuk mengingatnya kembali.
Dialog: 0,0:53:09.27,0:53:11.04,Default,zinger,0,0,0,,Apakah kamu keberatan?
Dialogue: 0,0:53:11.48,0:53:14.11,Default,zinger,0,0,0,,Mau aku tanya ayahku?
Dialog: 0,0:53:14.11,0:53:18.35,Default,zinger,0,0,0,,Dia sangat dihormati, banyak yang mengikutinya.
Dialog: 0,0:53:21.39,0:53:23.49,Default,Tol,0,0,0,,Atau permintaan saya terlalu rumit?
Dialog: 0,0:53:26.72,0:53:28.06,Default,Hanya,0,0,0,,Tidak sama sekali.
Dialogue: 0,0:53:28.06,0:53:31.70,Default,Tol,0,0,0,,Aku sendiri yang akan memberitahu ayahku.
Dialog: 0,0:53:32.26,0:53:33.46,Default,Tol,0,0,0,,Terima kasih.
Dialog: 0,0:53:33.46,0:53:35.13,Default,Tol,0,0,0,,Yang Mulia.
Dialogue: 0,0:53:35.13,0:53:39.04,Default,Tol,0,0,0,,Saat aku datang ke sini, aku selalu menginginkan satu hal saja.
Dialog: 0,0:53:39.27,0:53:42.21,Default,Toly,0,0,0,,Untuk menjadi dukungan Anda, seperti pada pertemuan pertama kita.
Dialog: 0,0:53:42.21,0:53:44.67,Default,Tol,0,0,0,,Sehingga di sebelah saya kamu bisa
Dialog: 0,0:53:44.98,0:53:48.01,Default,Tol,0,0,0,,lupakan semua ketakutanmu.
Dialog: 0,0:53:49.61,0:53:52.72,Default,Toly,0,0,0,,Kamu sudah sangat menghiburku.
Dialog: 0,0:53:52.98,0:53:56.12,Default,Tol,0,0,0,,Namun, kami masih
Dialog: 0,0:53:56.82,0:53:59.49,Default,Toly,0,0,0,,kita belum menghabiskan satu malam pun bersama.
Dialogue: 0,0:54:04.26,0:54:06.63,Default,Toly,0,0,0,,Ini salahku kalau kamu merasa kesepian.
Dialog: 0,0:54:06.96,0:54:09.13,Default,Tol,0,0,0,,Saya mengerti semuanya, Anda sibuk.
Dialog: 0,0:54:09.13,0:54:11.27,Default,Tolya,0,0,0,,Iblis menyesatkanku.
Dialog: 0,0:54:11.80,0:54:13.94,Default,Toly,0,0,0,,Tunggu aku di kamarmu malam ini.
Dialog: 0,0:54:14.57,0:54:17.34,Default,Tol,0,0,0,,Tapi besok malam kamu seharusnya melakukannya
Dialog: 0,0:54:17.34,0:54:19.31,Default,Tol,0,0,0,,habiskan bersama Yang Mulia.
Dialog: 0,0:54:19.68,0:54:21.85,Default,Tol,0,0,0,,Ini bukan urusanmu.
Dialog: 0,0:54:22.55,0:54:24.98,Default,Tol,0,0,0,,Kalau begitu aku akan mengunjungi ratu dan sedikit menghiburnya.
Dialog: 0,0:54:24.98,0:54:27.12,Default,Tol,0,0,0,,Dan kemudian aku akan segera duduk untuk menulis surat kepada ayahku.
Dialog: 0,0:54:27.12,0:54:29.05,Default,Tol,0,0,0,,Itu bagus.
Dialog: 0,0:54:37.23,0:54:39.53,Default,Tol,0,0,0,,Selir Cho datang mengunjungi Yang Mulia.
Dialog: 0,0:54:39.53,0:54:41.70,Default,Tol,0,0,0,,Maafkan saya, Yang Mulia sedang tidak sehat,
Dialog: 0,0:54:41.70,0:54:43.80,Default,Tol,0,0,0,,jadi dia meminum ramuan obat
Dialog: 0,0:54:43.80,0:54:46.07,Default,Tol,0,0,0,,dan tertidur.
Dialog: 0,0:54:46.70,0:54:48.37,Default,Tol,0,0,0,,Menjengkelkan.
Dialog: 0,0:54:48.41,0:54:50.14,Default,Tol,0,0,0,,Baiklah, saya akan datang lain kali.
Dialog: 0,0:55:02.89,0:55:04.55,Default,Tolya,0,0,0,,Apakah kamu sudah datang?
Dialog: 0,0:55:05.92,0:55:08.69,Default,Tol,0,0,0,,Kamu baru saja tidur seperti bayi...
Dialog: 0,0:55:14.10,0:55:16.87,Default,Tol,0,0,0,,Dan mereka memberitahuku bahwa kamu sedang tidak enak badan.
Dialogue: 0,0:55:19.17,0:55:21.81,Default,Tol,0,0,0,,Aku belum bisa menyombongkan perasaanku yang baik-baik saja,
Dialog: 0,0:55:22.81,0:55:25.94,Default,Tol,0,0,0,,namun, saya tidak menyesali apa pun. Joseon membutuhkan seorang pahlawan.
Dialog: 0,0:55:26.61,0:55:29.48,Default,Tol,0,0,0,,-Pahlawan? \N-Mengapa kita berdiri di depan pintu?
Dialogue: 0,0:55:29.48,0:55:31.35,Default,Tol,0,0,0,,Ayo masuk.
Dialogue: 0,0:55:40.76,0:55:42.29,Default,Tol,0,0,0,,Tinggalkan kami sendiri supaya kami...
Dialog: 0,0:55:42.29,0:55:45.70,Default,Hanya,0,0,0,,Agar kita bisa ngobrol dalam suasana tenang.
Dialog: 0,0:56:00.74,0:56:02.65,Default,Tol,0,0,0,,Buatlah dirimu nyaman.
Dialogue: 0,0:56:13.32,0:56:15.59,Default,Tolya,0,0,0,,Kenapa kamu duduk begitu jauh?
Dialog: 0,0:56:16.16,0:56:18.66,Default,Tolya,0,0,0,,Seolah bukan asli.
Dialog: 0,0:56:19.06,0:56:20.90,Default,Tolya,0,0,0,,Kamu harus mendekat.
Dialog: 0,0:56:20.90,0:56:22.63,Default,Tol,0,0,0,,Saya juga merasa nyaman di sini.
Dialog: 0,0:56:24.03,0:56:27.87,Default,Tol,0,0,0,,Kalau begitu aku akan duduk lebih dekat.
Dialog: 0,0:56:27.87,0:56:30.14,Default,Tol,0,0,0,,Saya muncul sebagai pangeran di atas kuda putih dan menyelamatkannya.
Dialog: 0,0:56:30.14,0:56:33.28,Default,Tolya,0,0,0,,Akhirnya, tatapan tidak ramahnya\N akan dipenuhi dengan cinta dan pemujaan.
Dialog: 0,0:56:36.41,0:56:38.21,Default,Tol,0,0,0,,Apa? Tapi kenapa?
Dialogue: 0,0:56:38.88,0:56:40.15,Default,Toly,0,0,0,,Pandanganmu telah berubah.
Dialogue: 0,0:56:40.15,0:56:43.42,Default,Tol,0,0,0,,Tapi kenapa dia malah lebih dingin dari sebelumnya?
Dialog: 0,0:56:43.89,0:56:46.69,Default,Tol,0,0,0,,Saya akan meminta ayah saya untuk mengambil petisi.
Dialogue: 0,0:56:47.42,0:56:50.93,Default,Tol,0,0,0,,Jadi kita imbang.
Dialog: 0,0:56:52.33,0:56:54.06,Default,Tol,0,0,0,,Terima kasih.
Dialog: 0,0:56:54.06,0:56:58.47,Default,Tol,0,0,0,,Anda mungkin berpikir semuanya berjalan sesuai keinginan Anda.
Dialog: 0,0:56:59.04,0:57:00.64,Default,Tol,0,0,0,,Apa yang kamu, tidak sama sekali.
Dialog: 0,0:57:00.64,0:57:02.71,Default,Tol,0,0,0,,Saya rasa tidak ada yang berfungsi sama sekali di sini.
Dialog: 0,0:57:02.71,0:57:04.88,Default,Tol,0,0,0,,Kami memutuskan untuk mengembalikan lokasi dengan cara ini
Dialog: 0,0:57:04.88,0:57:06.84,Default,Tol,0,0,0,,Yang Mulia setelah semua kebohongan Anda?
Dialog: 0,0:57:06.84,0:57:08.58,Default,Tol,0,0,0,,Apa yang kamu bicarakan?
Dialogue: 0,0:57:08.58,0:57:12.05,Default,Tol,0,0,0,,Tentu saja, saya bukanlah orang yang paling jujur,\N namun saya tidak mudah berbohong.
Dialogue: 0,0:57:12.38,0:57:14.62,Default,Toly,0,0,0,,Aku tahu kamu akan membuat dirimu terlihat seperti orang bodoh.
Dialog: 0,0:57:14.62,0:57:17.19,Default,Tol,0,0,0,,Apa? Saya tidak sedang membangun apa pun.
Dialog: 0,0:57:19.76,0:57:21.79,Default,Tol,0,0,0,,Saya sudah mengulanginya berkali-kali.
Dialog: 0,0:57:21.79,0:57:25.50,Default,Tol,0,0,0,,Raja sama sekali tidak menarik minatku.
Dialog: 0,0:57:26.56,0:57:28.23,Default,Tol,0,0,0,,Oke.
Dialog: 0,0:57:28.47,0:57:31.27,Default,Tol,0,0,0,,Kali ini aku akan percaya.
Dialogue: 0,0:57:32.84,0:57:35.71,Default,Toly,0,0,0,,Mungkin kamu bisa menginap\Nuntuk lebih dekat lagi?
Dialogue: 0,0:57:35.71,0:57:37.14,Default,Toly,0,0,0,,Kita akan mengadakan pesta piyama.
Dialog: 0,0:57:37.14,0:57:40.18,Default,Toly,0,0,0,,Artinya, pesta dengan pakaian dalam.
Dialog: 0,0:57:40.18,0:57:44.31,Default,Tol,0,0,0,,Saya akan menghabiskan malam ini bersama Yang Mulia.
Dialog: 0,0:57:45.42,0:57:47.05,Default,Tol,0,0,0,,Bagaimana bisa?!
Dialog: 0,0:57:47.55,0:57:49.35,Default,Tol,0,0,0,,Dan kamu patah hati,
Dialogue: 0,0:57:49.62,0:57:52.49,Default,Tolya,0,0,0,,jadi kamu juga datang untuk memberitahuku hal ini secara pribadi?
Dialog: 0,0:57:52.49,0:57:55.96,Default,Tolya,0,0,0,,Seperti itu saja? Kejam?
Dialog: 0,0:57:56.69,0:57:59.86,Default,Tol,0,0,0,,Entah kenapa kamu sangat kesal pada seseorang yang tidak tertarik pada raja.
Dialog: 0,0:57:59.86,0:58:01.43,Default,Tol,0,0,0,,Saya tidak tertarik padanya.
Dialog: 0,0:58:01.43,0:58:04.17,Default,Toly,0,0,0,,Tapi aku tidak mengatakan apa pun tentangmu.
Dialogue: 0,0:58:04.30,0:58:07.40,Default,Tol,0,0,0,,Jadi buktikan kalau rasa sayangmu padaku itu tulus.
Dialog: 0,0:58:07.40,0:58:11.34,Default,Tol,0,0,0,,Jika tindakanmu lagi-lagi menyimpang dari kata-katamu,
Dialog: 0,0:58:12.51,0:58:15.48,Default,Toly,0,0,0,,salahkan dirimu sendiri. Anda tidak akan menemukannya cukup.
Dialog: 0,0:58:17.92,0:58:21.32,Default,Tol,0,0,0,,Karena kamu begitu bertekad, aku mencuci tanganku.
Dialogue: 0,0:58:22.49,0:58:24.15,Default,Tol,0,0,0,,Baiklah.
Dialogue: 0,0:58:24.25,0:58:28.36,Default,Toly,0,0,0,,Aku berserah diri, restuku padamu.
Dialog: 0,0:58:28.53,0:58:30.36,Default,Toly,0,0,0,,Tapi kamu tidak tahu apa yang hilang darimu.
Dialog: 0,0:58:30.36,0:58:32.80,Default,Tolya,0,0,0,,Aku tidak merasakan kebahagiaan di bawah hidungku.
Dialogue: 0,0:58:33.63,0:58:35.27,Default,Tol,0,0,0,,Aku pergi.
Dialogue: 0,0:58:46.18,0:58:48.51,Default,Tolya,0,0,0,,Ini sulit dipecahkan.
Dialogue: 0,0:58:50.68,0:58:53.15,Default,Tol,0,0,0,,Wanita yang kejam.
Dialog: 0,0:59:08.27,0:59:13.07,Default,Tol,0,0,0,,15, 20...
Dialogue: 0,0:59:18.04,0:59:20.01,Default,Tol,0,0,0,,Milik apa?
Dialogue: 0,0:59:21.55,0:59:25.01,Default,Toly,0,0,0,,Hatiku berat, aku sedih.
Dialog: 0,0:59:25.55,0:59:28.09,Default,Tolya,0,0,0,,Aku datang ke sini untuk menyembuhkan hatiku yang terluka.
Dialog: 0,0:59:28.09,0:59:31.09,Default,Tol,0,0,0,,Anda datang ke alamat yang salah.
Dialog: 0,0:59:31.09,0:59:34.12,Default,Tol,0,0,0,,Kami memperdagangkan banyak hal,
Dialog: 0,0:59:34.12,0:59:36.33,Default,Toly,0,0,0,,tapi kami tidak punya obat apa pun.
Dialog: 0,0:59:36.33,0:59:38.26,Default,Tol,0,0,0,,Saya tanya, kami tutup.
Dialog: 0,0:59:38.26,0:59:40.30,Default,Tol,0,0,0,,Ayo, pintu keluarnya ada di sana.
Dialog: 0,0:59:41.03,0:59:43.37,Default,Tol,0,0,0,,-Tapi saya...\T-Tolong.
Dialog: 0,0:59:45.37,0:59:47.37,Default,Toly,0,0,0,,Saya ingin hal yang ajaib itu.
Dialog: 0,0:59:47.67,0:59:49.31,Default,Tol,0,0,0,,Apa?
Dialog: 0,0:59:51.84,0:59:54.71,Default,Tol,0,0,0,,Sama yang dibawa dari Qing.
Dialog: 0,1:00:34.99,1:00:38.39,Default,Tol,0,0,0,,Saya menelepon Anda untuk mendiskusikan topik tersebut,
Dialogue: 0,1:00:38.39,1:00:40.82,Default,Only,0,0,0,,yang diangkat pada pertemuan hari ini.
Dialog: 0,1:00:41.12,1:00:43.43,Default,Toly,0,0,0,,Berani mendiskusikan deposisi ratu secara diam-diam?
Dialog: 0,1:00:43.43,1:00:46.36,Default,Tol,0,0,0,,Dengan ini kamu menghina seluruh keluarga Kim dari Andon!
Dialog: 0,1:00:46.36,1:00:48.53,Default,Tolya,0,0,0,,Di halaman tempat ratu berada
Dialog: 0,1:00:48.53,1:00:51.10,Default,Tol,0,0,0,,dapat memutuskan untuk menenggelamkan dirinya kapan saja,
Dialog: 0,1:00:51.10,1:00:53.74,Default,Hanya,0,0,0,,tidak akan ada stabilitas!
Dialogue: 0,1:00:54.57,1:00:56.84,Default,Tol,0,0,0,,Beraninya kau menjelek-jelekkan Yang Mulia?
Dialog: 0,1:00:56.97,1:00:59.44,Default,Hanya,0,0,0,,Kamu hanya tahu cara meludahkan racun!
Dialog: 0,1:00:59.44,1:01:01.41,Default,Toly,0,0,0,,Meludah racun?
Dialog: 0,1:01:01.88,1:01:06.45,Default,Tol,0,0,0,,Saya tidak akan mentolerir penghinaan seperti itu.
Dialogue: 0,1:01:17.36,1:01:19.40,Default,Tol,0,0,0,,Apa-apaan ini?
Dialog: 0,1:01:19.40,1:01:21.60,Default,Toly,0,0,0,,Apakah kamu merencanakan sesuatu yang salah?
Dialog: 0,1:01:28.81,1:01:32.04,Default,Tol,0,0,0,,Apa yang kamu, saya hanya meminta kamu untuk mendengarkan sampai akhir.
Dialog: 0,1:01:32.04,1:01:33.71,Default,Tolya,0,0,0,,Shelmet.
Dialog: 0,1:01:46.02,1:01:49.63,Default,Tol,0,0,0,,Seperti yang sudah saya katakan, tidak ada di antara kalian\N yang kehilangan apa pun.
Dialog: 0,1:01:49.66,1:01:53.30,Default,Tol,0,0,0,,Mengapa tidak bertahan\N dan mendengarkan sampai akhir?
Dialog: 0,1:01:56.70,1:01:58.43,Default,Tolya,0,0,0,,Silahkan duduk.
Dialog: 0,1:02:14.18,1:02:17.15,Default,Tol,0,0,0,,Saya tidak tahu apakah Anda ingat.
Dialog: 0,1:02:17.15,1:02:21.56,Default,Tol,0,0,0,,Surat yang ditulis Ibu Suri.
Dialog: 0,1:02:21.56,1:02:25.00,Default,Tol,0,0,0,,Tempat, tanggal dan waktu yang ditentukan di dalamnya,
Dialog: 0,1:02:25.00,1:02:28.43,Default,Tol,0,0,0,,bertepatan dengan kapan dan di mana\Nkecelakaan dengan ratu terjadi.
Dialogue: 0,1:02:28.93,1:02:31.07,Default,Tol,0,0,0,,Surat itu dipalsukan.
Dialog: 0,1:02:31.07,1:02:34.00,Default,Tol,0,0,0,,Tapi bisakah kamu membuktikannya?
Dialog: 0,1:02:38.48,1:02:41.18,Default,Tol,0,0,0,,Saya sarankan Anda sadar dan tidak menggulingkan ratu,
Dialog: 0,1:02:42.35,1:02:45.45,Default,Tol,0,0,0,,sebagai imbalannya Anda akan menerima pesan ini.
Dialogue: 0,1:02:45.72,1:02:48.15,Default,Tol,0,0,0,,Demikian kepada keluargamu
Dialog: 0,1:02:48.15,1:02:50.92,Default,Tol,0,0,0,,tidak perlu lagi takut akan akibatnya.
Dialog: 0,1:02:50.92,1:02:53.72,Default,Tol,0,0,0,,Ini usulan saya.
Dialogue: 0,1:02:55.93,1:02:57.76,Default,Tol,0,0,0,,Bagaimana kamu menyukainya?
Dialog: 0,1:03:16.61,1:03:18.31,Default,Tol,0,0,0,,Apakah Anda menelepon?
Dialog: 0,1:03:19.08,1:03:22.42,Default,Tol,0,0,0,,Saya memenuhi permintaan Yang Mulia\N dan menulis surat kepada ayah saya.
Dialog: 0,1:03:22.85,1:03:25.79,Default,Tol,0,0,0,,Maukah kamu menyampaikan pesanku padanya?
Dialogue: 0,1:03:28.36,1:03:29.96,Default,Tol,0,0,0,,saya coba
Dialog: 0,1:03:30.46,1:03:32.30,Default,Tol,0,0,0,,meyakinkan Yang Mulia.
Dialog: 0,1:03:32.30,1:03:36.80,Default,Tol,0,0,0,,Yang Mulia hanya ingin\N membalas kebaikan dengan kebaikan.
Dialog: 0,1:03:37.20,1:03:39.80,Default,Tol,0,0,0,,Meskipun Yang Mulia mempunyai pendapat berbeda mengenai masalah ini.
Dialog: 0,1:03:40.47,1:03:44.51,Default,Tol,0,0,0,,Tetapi saya hanya peduli pada perasaan Yang Mulia.
Dialog: 0,1:03:46.94,1:03:48.88,Default,Tol,0,0,0,,Oleh karena itu semuanya beres.
Dialog: 0,1:03:49.81,1:03:53.72,Default,Tol,0,0,0,,Yang Mulia, semuanya siap untuk berenang.
Dialog: 0,1:04:17.97,1:04:21.94,Default,Tol,0,0,0,,Semuanya baik-baik saja untuk saat ini.
Dialog: 0,1:04:30.12,1:04:31.92,Default,Tol,0,0,0,,Yang Mulia.
Dialog: 0,1:04:31.99,1:04:34.32,Default,Tol,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,1:04:34.32,1:04:38.76,Default,Toly,0,0,0,,Bolehkah aku menghubungimu jika aku baik-baik saja?
Dialog: 0,1:04:40.63,1:04:45.27,Default,Tol,0,0,0,,Hatiku cemas dan gelisah.
Dialog: 0,1:04:46.47,1:04:48.50,Default,Tol,0,0,0,,Tenang.
Dialog: 0,1:04:49.01,1:04:52.21,Default,Tol,0,0,0,,Saya akan membantu Anda menemukan jawaban atas pertanyaan Anda.
Dialog: 0,1:05:16.70,1:05:19.77,Default,Tol,0,0,0,,Yang Mulia baru saja akan menemui Selir Cho.
Dialog: 0,1:05:19.77,1:05:21.87,Default,Tol,0,0,0,,Saya ngobrol dengannya.
Dialog: 0,1:05:22.31,1:05:24.51,Default,Tol,0,0,0,,Tinggalkan kami.
Dialog: 0,1:05:25.61,1:05:27.28,Default,Tol,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,1:05:35.05,1:05:37.25,Default,Tol,0,0,0,,Deposisi ratu akan membantu mewujudkan rencana tersebut.
Dialogue: 0,1:05:37.25,1:05:40.06,Default,Tol,0,0,0,,Jadi kenapa kamu begitu menentang hal ini?
Dialog: 0,1:05:40.06,1:05:41.59,Default,Tol,0,0,0,,Mereka akan menggulingkan satu ratu,
Dialog: 0,1:05:41.59,1:05:44.13,Default,Tol,0,0,0,,yang lain akan segera menggantikannya.
Dialog: 0,1:05:44.36,1:05:47.30,Default,Toly,0,0,0,,Selama tindakan ratu tidak mengganggu kita, tapi sebaliknya.
Dialog: 0,1:05:47.30,1:05:49.17,Default,Tol,0,0,0,,Dia adalah pilihan terbaik
Dialog: 0,1:05:49.17,1:05:51.60,Default,Hanya,0,0,0,,dari semua kemungkinan.
Dialogue: 0,1:05:52.57,1:05:54.57,Default,Tolya,0,0,0,,Apakah dia menyentuh hatimu?
Dialog: 0,1:05:59.21,1:06:01.98,Default,Tol,0,0,0,,Jawab. Itukah sebabnya kamu ragu?
Dialog: 0,1:06:02.25,1:06:03.91,Default,Tol,0,0,0,,Ya.
Dialog: 0,1:06:04.35,1:06:06.22,Default,Tol,0,0,0,,Tersentuh.
Dialogue: 0,1:06:06.72,1:06:09.99,Default,Tol,0,0,0,,Aku mencoba nyawanya,\Ndia ingin mengorbankan nyawanya,
Dialog: 0,1:06:09.99,1:06:12.46,Default,Hanya,0,0,0,,untuk menyelamatkan aku dan orang yang kucintai.
Dialog: 0,1:06:12.46,1:06:13.72,Default,Toly,0,0,0,,Bukan karena belas kasihan
Dialogue: 0,1:06:13.72,1:06:14.99,Default,Toly,0,0,0,,dan bukan karena aku memaafkan,
Dialog: 0,1:06:14.99,1:06:17.89,Default,Toly,0,0,0,,tetapi karena dia tidak bisa mentolerir ketidakadilan.
Dialog: 0,1:06:17.89,1:06:21.00,Default,Tol,0,0,0,,Dia tidak mengharapkan permintaan maaf atau rasa terima kasih dari saya.
Dialogue: 0,1:06:21.00,1:06:23.67,Default,Toly,0,0,0,,Cukup bertindak sesuai hati nuraninya.
Dialog: 0,1:06:23.67,1:06:26.04,Default,Tolya,0,0,0,,Sekarang semua orang berpaling darinya.
Dialog: 0,1:06:26.67,1:06:29.57,Default,Tol,0,0,0,,Bisakah saya melakukan hal yang sama?
Dialog: 0,1:06:29.97,1:06:32.51,Default,Tol,0,0,0,,Ternyata kamu akan meninggalkan kami
Dialog: 0,1:06:34.58,1:06:37.15,Default,Toly,0,0,0,,dan dari selirmu?
Dialog: 0,1:06:39.18,1:06:41.92,Default,Tol,0,0,0,,Saya tidak merasakan apa pun pada Yang Mulia.
Dialog: 0,1:06:42.12,1:06:44.42,Default,Tolya,0,0,0,,Tapi dia bukan musuh kita.
Dialog: 0,1:06:44.42,1:06:47.56,Default,Toly,0,0,0,,Aku tidak meninggalkanmu dan tidak mengkhianatimu.
Dialog: 0,1:06:47.56,1:06:50.33,Default,Tol,0,0,0,,Akan buruk jika kamu mempunyai perasaan padanya.
Dialogue: 0,1:06:50.33,1:06:52.26,Default,Toly,0,0,0,,Melekat padanya,
Dialog: 0,1:06:52.26,1:06:54.76,Default,Tol,0,0,0,,Anda akan membahayakan kami semua.
Dialog: 0,1:06:54.76,1:06:57.13,Default,Tol,0,0,0,,Saya akan mencoba mencegah hal ini terjadi.
Dialog: 0,1:06:57.40,1:06:59.20,Default,Tol,0,0,0,,Oke.
Dialog: 0,1:06:59.70,1:07:02.07,Default,Tol,0,0,0,,Kalau begitu berjanjilah ini padaku.
Dialog: 0,1:07:02.24,1:07:05.14,Default,Tol,0,0,0,,Berjanjilah jika ratu
Dialog: 0,1:07:05.14,1:07:09.11,Default,Tol,0,0,0,,akan mengganggu rencana kita
Dialog: 0,1:07:09.85,1:07:12.01,Default,Toly,0,0,0,,atau berperilaku aneh,
Dialog: 0,1:07:13.25,1:07:15.15,Default,Tol,0,0,0,,Anda tanpa ragu-ragu
Dialog: 0,1:07:17.42,1:07:19.66,Default,Toly,0,0,0,,perintahkan dia untuk dibunuh.
Dialog: 0,1:07:44.51,1:07:46.58,Default,Tol,0,0,0,,Kenapa kamu tidak menjawab?
Dialog: 0,1:07:46.58,1:07:48.62,Default,Hanya,0,0,0,,Jika ratu
Dialog: 0,1:07:49.89,1:07:52.96,Default,Tol,0,0,0,,tiba-tiba mulai mengganggu rencana kita,
Dialog: 0,1:07:56.96,1:08:00.93,Default,Tol,0,0,0,,Saya pribadi akan memenggal kepalanya.
Dialog: 0,1:08:14.31,1:08:17.55,Default,Tol,0,0,0,,Wow, aku semakin baik setiap saat.
Dialog: 0,1:08:20.68,1:08:22.32,Default,Tolya,0,0,0,,Apakah kamu benar-benar menyulamnya sendiri?
Dialog: 0,1:08:22.32,1:08:24.49,Default,Tolya,0,0,0,,Benar, bunga kecil. Apakah ada di Joseon?
Dialog: 0,1:08:24.49,1:08:26.46,Default,Toly,0,0,0,,seseorang yang tidak tahu cara menyulam?
Dialog: 0,1:08:26.46,1:08:28.22,Default,Tolya,0,0,0,,Keturunan negeri kesegaran pagi
Dialog: 0,1:08:28.22,1:08:29.86,Default,Tol,0,0,0,,Saya lihat ada.
Dialog: 0,1:08:30.89,1:08:34.40,Default,Toly,0,0,0,,Dan tidak semua orang bisa menyulam.
Dialog: 0,1:08:34.83,1:08:37.50,Default,Tolya,0,0,0,,Hardy, dan Anda dapat melakukan segalanya di dunia.
Dialogue: 0,1:08:37.50,1:08:41.17,Default,Toly,0,0,0,,Apa katamu, aku dayang terburuk.
Dialogue: 0,1:08:41.37,1:08:45.01,Default,Toly,0,0,0,,Semua orang bilang aku seperti bunga violet.
Dialog: 0,1:08:45.84,1:08:49.88,Default,Tol,0,0,0,,Ya, semua orang di sini sangat berguna.
Dialog: 0,1:08:49.95,1:08:51.75,Default,Tol,0,0,0,,Baiklah, mari kita lihat kreativitas kita.
Dialog: 0,1:08:52.78,1:08:54.42,Default,Tol,0,0,0,,Luruskan.
Dialog: 0,1:08:58.19,1:09:01.46,Default,Tolya,0,0,0,,Keturunan negeri kesegaran pagi\NOpembukaan pengiriman
Dialogue: 0,1:09:01.62,1:09:04.39,Default,Toly,0,0,0,,Ayo gantung ini di depan istal.
Dialog: 0,1:09:04.39,1:09:07.03,Default,Tol,0,0,0,,Saya merasa segalanya berjalan baik bagi kita.
Dialog: 0,1:09:07.76,1:09:08.87,Default,Hanya,0,0,0,,Berapa banyak yang harus saya ambil?
Dialog: 0,1:09:08.87,1:09:11.17,Default,Tol,0,0,0,,Untuk sampai ke Oktaejeon, Anda memerlukan uang.
Dialog: 0,1:09:11.17,1:09:12.80,Default,Tol,0,0,0,,Yang Mulia.
Dialog: 0,1:09:14.20,1:09:17.04,Default,Toly,0,0,0,,Aku membawakanmu bunga. Anggrek angin yang langka.
Dialog: 0,1:09:17.04,1:09:18.74,Default,Tolya,0,0,0,,Anggrek angin?
Dialog: 0,1:09:19.71,1:09:21.95,Default,Tolya,0,0,0,,Apakah sudah ada kabar dari mulut ke mulut tentang pengiriman kami?
Dialogue: 0,1:09:21.95,1:09:24.41,Default,Tolya,0,0,0,,Dari siapa bunganya?
Dialog: 0,1:09:26.15,1:09:28.35,Default,Tol,0,0,0,,Jarak sosial, tapi selamat
Dialog: 0,1:09:28.55,1:09:31.92,Default,Tol,0,0,0,,Dari Yang Mulia.
Dialog: 0,1:09:35.69,1:09:37.93,Default,Toly,0,0,0,,Kenapa kamu?
Dialog: 0,1:09:38.09,1:09:39.76,Default,Tol,0,0,0,,Dasar bajingan.
Dialog: 0,1:09:39.76,1:09:42.37,Default,Tol,0,0,0,,Aku mencoba melupakan diriku sendiri, aku tenggelam dalam pekerjaan.
Dialog: 0,1:09:42.37,1:09:44.53,Default,Tol,0,0,0,,Apa yang orang ini lakukan? Pertunjukan macam apa ini?
Dialog: 0,1:09:45.87,1:09:47.87,Default,Toly,0,0,0,,Ya, saya seribu kali lebih keren.
Dialog: 0,1:09:47.87,1:09:50.07,Default,Tol,0,0,0,,Nilai sendiri. Itulah yang saya pikirkan!
Dialog: 0,1:09:50.07,1:09:52.18,Default,Tolya,0,0,0,,Saya menciptakan lapangan kerja. Siapa dia?
Dialog: 0,1:09:52.18,1:09:55.14,Default,Tol,0,0,0,,Dan ini semua terjadi pada saat tidak ada layanan 24 jam.
Dialog: 0,1:09:55.21,1:09:57.81,Default,Tol,0,0,0,,Ya, saya jenius, jenius.
Dialog: 0,1:10:00.08,1:10:02.69,Default,Toly,0,0,0,,Apakah aku membuatnya takut dengan kesejukanku?
Dialog: 0,1:10:02.85,1:10:05.29,Default,Tol,0,0,0,,Ya, saya mengerti.
Dialog: 0,1:10:05.36,1:10:07.16,Default,Tol,0,0,0,,Baiklah.
Dialog: 0,1:10:08.02,1:10:11.06,Default,Tol,0,0,0,,Ini karena ucapannya yang keterlaluan
Dialog: 0,1:10:11.06,1:10:15.97,Default,Toly,0,0,0,,ternyata itu satu hal yang buruk? \NMengapa tidak ada hasil yang baik?
Dialog: 0,1:10:16.33,1:10:18.23,Default,Tol,0,0,0,,Stand.
Dialog: 0,1:10:19.60,1:10:22.40,Default,Tol,0,0,0,,Karena orang di sini gelap dan tidak ada fasilitas,
Dialog: 0,1:10:22.61,1:10:25.28,Default,Tol,0,0,0,,dengan ideku aku bisa tercatat dalam sejarah Joseon!
Dialog: 0,1:10:25.28,1:10:28.68,Default,Tol,0,0,0,,Tidak, global!
Dialog: 0,1:11:03.68,1:11:06.68,Default,Tol,0,0,0,,Saya sangat termotivasi.
Dialogue: 0,1:11:06.82,1:11:09.52,Default,Tol,0,0,0,,Bisakah saya menjadi \NSteve Jobs atau Thomas Edison lokal?
Dialog: 0,1:11:09.52,1:11:13.32,Default,Tol,0,0,0,,Tidak, saya menganggapnya rendah. Kami membutuhkan seseorang yang hebat.
Dialog: 0,1:11:13.32,1:11:16.86,Default,Toly,0,0,0,,Penyelamat umat manusia.
Dialog: 0,1:11:28.97,1:11:31.57,Default,Tol,0,0,0,,Di dalam tubuh ratu duduk,
Dialog: 0,1:11:32.68,1:11:36.38,Default,Hanya,0,0,0,,yang seharusnya tidak ada.
Dialog: 0,1:11:36.98,1:11:38.98,Default,Toly,0,0,0,,Roh jahat.
Dialogue: 0,1:11:40.55,1:11:45.02,Default,Toly,0,0,0,,Sang Ratu kerasukan roh jahat!
Dialogue: 0,1:11:47.56,1:11:50.43,Default,Tol,0,0,0,,Kita harus mengusir semangat ini!
Dialog: 0,1:11:51.49,1:11:53.56,Default,Toly,0,0,0,,Atau seluruh dunia...
Dialogue: 0,1:11:54.83,1:12:00.57,Default,Toly,0,0,0,,Seluruh dunia akan jungkir balik!
Dialog: 0,1:12:03.94,1:12:05.57,Default,Toly,0,0,0,,Tepat, Operator!
Dialog: 0,1:12:05.64,1:12:07.81,Default,Tolya,0,0,0,,Penemu AC!
Dialog: 0,1:12:14.22,1:12:15.25,Default,Tol,0,0,0,,Yang Mulia!
Dialog: 0,1:12:15.25,1:12:17.69,Default,Tol,0,0,0,,Sadarlah, Yang Mulia! Ayo.
Dialog: 0,1:12:17.69,1:12:19.29,Default,Tol,0,0,0,,Yang Mulia!
Dialogue: 0,1:12:19.36,1:12:21.56,Default,Toly,0,0,0,,Menjauh!
Dialog: 0,1:12:26.86,1:12:29.47,Default,Tol,0,0,0,,Dia... Dia tidak bernapas.
Dialog: 0,1:12:36.81,1:12:38.74,Default,Hanya,0,0,0,,Dan aku tidak merasakan denyutnya.
Dialogue: 0,1:13:13.44,1:13:15.68,Default,Tol,0,0,0,,Sang Ratu kini tak sadarkan diri.
Dialog: 0,1:13:15.68,1:13:17.65,Default,Toly,0,0,0,,Kamu bilang ratu terbaring tak bernyawa?
Dialog: 0,1:13:17.65,1:13:20.48,Default,Tol,0,0,0,,Untuk menyelamatkannya, Anda perlu memulai\N aliran energi chi pria. Jika tidak...
Dialog: 0,1:13:20.48,1:13:22.62,Default,Tol,0,0,0,,Rumah Sakit? Apakah saya kembali?
Dialog: 0,1:13:22.62,1:13:24.52,Default,Tol,0,0,0,,Saya akan menunjukkan bahwa raja
Dialogue: 0,1:13:24.52,1:13:26.42,Default,Tol,0,0,0,,apa adanya.
Dialog: 0,1:13:26.42,1:13:30.76,Default,Tol,0,0,0,,Pria ini bermuka dua pada intinya.
Dialog: 0,1:13:30.76,1:13:32.86,Default,Tol,0,0,0,,Minggir. Memulangkan!
Dialog: 0,1:13:35.03,1:13:38.20,Default,Tol,0,0,0,,-Ratu. \N-Aku memerintahkanmu untuk mencari tahu kebenarannya.
Dialog: 0,1:13:38.20,1:13:39.84,Default,Tol,0,0,0,,Tidak selangkah lebih maju.
Dialog: 0,1:13:39.84,1:13:41.97,Default,Tol,0,0,0,,Ini wanitaku.
Dialog: 0,0:17:10.95,0:17:12.95,Default,,0,0,0,,


