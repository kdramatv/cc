Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Host, Nanas
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.16,0:01:06.43,Default,Spillik1,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.43,0:01:08.53,Default,Spilyk1,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:02:10.66,0:02:11.76,Default,Spillik1,0,0,0,,Jadi itu kamu.
Dialog: 0,0:02:12.66,0:02:14.33,Default,Spillik1,0,0,0,,Kamu adalah orang itu.
Dialog: 0,0:02:22.94,0:02:24.51,Default,Spillik1,0,0,0,,Aku tidak akan memaafkanmu.
Dialog: 0,0:02:44.66,0:02:47.40,Default,Spillik1,0,0,0,,Aku akan membunuhmu.
Dialog: 0,0:03:42.72,0:03:45.69,Default,Spillik1,0,0,0,,12 episode: Menari di ujung pedang
Dialog: 0,0:03:49.90,0:03:52.84,Default,Spillik1,0,0,0,,
Dialog: 0,0:03:53.31,0:03:56.71,Default,Spillik1,0,0,0,,Sekarang aku paham siapa bos di istana?
Dialog: 0,0:04:04.55,0:04:07.02,Default,Spillik1,0,0,0,,Aku hampir menembakmu. \NDisalahartikan sebagai mangsa.
Dialog: 0,0:04:07.19,0:04:09.29,Default,Spikyulka1,0,0,0,,Atau mungkin dia tidak sengaja meleset?
Dialog: 0,0:04:10.29,0:04:11.46,Default,Spillik1,0,0,0,,Itu hanya kesalahpahaman.
Dialog: 0,0:04:19.64,0:04:21.47,Default,Spillik1,0,0,0,,Ingat tempatmu.
Dialog: 0,0:04:28.58,0:04:30.68,Default,Spillik1,0,0,0,,Saya harus ganti baju.
Dialog: 0,0:04:30.68,0:04:31.75,Default,Spillik1,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:04:54.37,0:04:56.37,Default,Spilyk1,0,0,0,,Ada kasus untuk Departemen Detektif.
Dialog: 0,0:05:07.32,0:05:09.29,Default,Spikyulka1,0,0,0,,Apakah perlu melakukan ini dengan Ovol?
Dialog: 0,0:05:13.46,0:05:14.82,Default,Spillik1,0,0,0,,Apa yang kulakukan?
Dialog: 0,0:05:15.22,0:05:17.36,Default,Spillie1,0,0,0,,Apakah perlu membunuhnya?
Dialog: 0,0:05:17.66,0:05:20.26,Default,Spiky1,0,0,0,,Lalu membuang yang mati ke dalam sumur?
Dialog: 0,0:05:20.63,0:05:25.43,Default,Spikyulka1,0,0,0,,Apakah kamu harus melakukan ini pada gadis lugu hanya untuk mengintimidasiku?
Dialog: 0,0:05:25.64,0:05:26.77,Default,Spillie1,0,0,0,,Apakah aku membunuhnya?
Dialog: 0,0:05:26.97,0:05:28.91,Default,Spilyk1,0,0,0,,Dari mana kesalahpahaman ini berasal?
Dialog: 0,0:05:29.04,0:05:30.51,Default,Spillik1,0,0,0,,Saya secara umum menentang pembunuhan semua makhluk hidup,
Dialog: 0,0:05:30.51,0:05:32.48,Default,Spillik1,0,0,0,,kecuali untuk memasak.
Dialog: 0,0:05:35.21,0:05:37.91,Default,Spiky1,0,0,0,,Fakta bahwa tubuhnya ditemukan di dalam sumur adalah suatu kebetulan yang buruk,
Dialog: 0,0:05:38.38,0:05:40.52,Default,Spikyulka1,0,0,0,,atau seseorang ingin mendorong kita.
Dialog: 0,0:05:41.75,0:05:45.62,Default,Spillik1,0,0,0,,Tolak lebih jauh hingga amarahku mencapai batasnya.
Dialogue: 0,0:05:45.92,0:05:49.13,Default,Spillik1,0,0,0,,Kau membuatku gila. \NI jelas tidak melakukan ini.
Dialogue: 0,0:05:49.13,0:05:51.46,Default,Spillik1,0,0,0,,Dari mana opini buruk tentang saya ini berasal?
Dialog: 0,0:05:51.66,0:05:52.93,Default,Spillik1,0,0,0,,Karena itulah dirimu.
Dialog: 0,0:05:53.23,0:05:56.83,Default,Spillik1,0,0,0,,Kim Soyeon, yang saya kenal, mampu melakukan ini.
Dialog: 0,0:05:57.37,0:05:59.20,Default,Spikyulka1,0,0,0,,Bagaimana kamu mengenalku jika aku belum mengenal diriku sendiri?
Dialog: 0,0:05:59.34,0:06:03.44,Default,Spillik1,0,0,0,,Pembohong terbaik berbohong pada dirinya sendiri.
Dialog: 0,0:06:03.77,0:06:06.51,Default,Silk1,0,0,0,,Anda menipu diri sendiri dengan mengatakan bahwa Anda tidak tahu siapa diri Anda.
Dialog: 0,0:06:12.01,0:06:15.42,Default,Spikyulka1,0,0,0,,Saya pikir kita sekarang telah melewati point of no return.
Dialog: 0,0:06:16.42,0:06:19.16,Default,Silk1,0,0,0,,Saya tidak akan memperhatikan\N kesalahpahaman Anda tentang saya.
Dialog: 0,0:06:20.12,0:06:21.46,Default,Spillik1,0,0,0,,Lakukan sesukamu.
Dialog: 0,0:06:29.73,0:06:30.77,Default,Spillit1,0,0,0,,Kelinci
Dialog: 0,0:06:43.95,0:06:45.15,Default,Spillik1,0,0,0,,Siapa yang menembaknya?
Dialog: 0,0:06:45.15,0:06:47.38,Default,Spikyulka1,0,0,0,,Kami sering mengejarnya, jadi siapa yang berani...
Dialog: 0,0:06:55.42,0:06:58.39,Default,Spillik1,0,0,0,,Sepertinya kita punya pemenang. Saatnya untuk kembali.
Dialog: 0,0:06:58.83,0:07:00.13,Default,Spillik1,0,0,0,,-Ya, ratu.\N-Ya, ratu.
Dialogue: 0,0:07:15.41,0:07:16.68,Default,Spillie1,0,0,0,,Ini darah.
Dialogue: 0,0:07:19.15,0:07:20.52,Default,Spillik1,0,0,0,,Itu sampah.
Dialog: 0,0:07:21.68,0:07:23.75,Default,Spillie1,0,0,0,,Apakah kamu benar-benar gila? Ini sangat menyakitkan.
Dialogue: 0,0:07:24.32,0:07:27.12,Default,Spikyulka1,0,0,0,,Maaf, tanganku terpeleset.
Dialog: 0,0:07:27.66,0:07:29.96,Default,Spillik1,0,0,0,,-Si kecil itu...\N-Apakah Anda baik-baik saja, Yang Mulia?
Dialog: 0,0:07:29.96,0:07:32.33,Default,Spillik1,0,0,0,,Bahkan dengan ujung yang lembut, tetap saja sakit.
Dialog: 0,0:07:32.70,0:07:34.83,Default,Spillik1,0,0,0,,Yang Mulia, apa yang Anda...
Dialog: 0,0:07:41.44,0:07:43.14,Default,Spilyk1,0,0,0,,Saya akan membalas budi Anda.
Dialog: 0,0:07:44.27,0:07:46.01,Default,Spillik1,0,0,0,,Mati kau.
Dialog: 0,0:07:51.71,0:07:52.75,Default,Spillik1,0,0,0,,Serius?
Dialog: 0,0:07:54.08,0:07:57.62,Default,Spiky1,0,0,0,,Demi suamiku tersayang, aku akan melepaskannya hari ini.
Dialog: 0,0:07:58.59,0:08:00.56,Default,Spillik1,0,0,0,,-Karena saya yang bertanggung jawab di sini.\N-Tentu saja, Yang Mulia.
Dialog: 0,0:08:08.40,0:08:09.97,Default,Spillik1,0,0,0,,Pergi ke aula Hidzhonjon.
Dialog: 0,0:08:10.43,0:08:12.07,Default,Spilyk1,0,0,0,,Saya akan bantu ganti baju...
Dialog: 0,0:08:12.07,0:08:14.17,Default,Spillik1,0,0,0,,Seseorang mencoba mengganggu pesta,
Dialog: 0,0:08:15.14,0:08:16.81,Default,Spillik1,0,0,0,,jadi aku pergi sendiri.
Dialog: 0,0:08:51.57,0:08:54.11,Default,Spikyulka1,0,0,0,,Setiap orang yang diundang ke sini hari ini,
Dialog: 0,0:08:54.11,0:08:56.58,Default,Spikyulka1,0,0,0,,akan melihat raja \Nas diberi kekuasaan.
Dialog: 0,0:08:57.01,0:08:58.91,Default,Spikyulka1,0,0,0,,Dan semua yang dikatakan tentang dia,
Dialog: 0,0:08:58.91,0:09:00.68,Default,Spillik1,0,0,0,,bahkan julukan pangeran penebang kayu dari Ganghwado,
Dialog: 0,0:09:00.78,0:09:03.09,Default,Spikyulka1,0,0,0,,akan berubah menjadi rumor palsu.
Dialog: 0,0:09:04.45,0:09:07.09,Default,Spillik1,0,0,0,,Raja bersikeras mengadakan pesta.
Dialog: 0,0:09:07.09,0:09:08.46,Default,Spikyulka1,0,0,0,,Pasti memilih hari ini,
Dialog: 0,0:09:08.46,0:09:10.79,Default,Spikyulka1,0,0,0,,untuk hadir di hadapan pengadilan dalam kedok baru.
Dialog: 0,0:09:12.16,0:09:13.83,Default,Spillik1,0,0,0,,Bagaimana kamu bisa berkedip
Dialog: 0,0:09:15.40,0:09:17.93,Default,Spilyk1,0,0,0,,persiapannya?
Dialog: 0,0:09:20.20,0:09:21.54,Default,Spillik1,0,0,0,,Maaf.
Dialog: 0,0:09:22.27,0:09:23.27,Default,Spilyk1,0,0,0,,Namun
Dialog: 0,0:09:23.91,0:09:27.21,Default,Spillik1,0,0,0,,Saya juga menyiapkan sesuatu untuk raja,
Dialog: 0,0:09:28.64,0:09:30.08,Default,Spillik1,0,0,0,,jadi perhatikan baik-baik.
Dialog: 0,0:09:32.55,0:09:35.28,Default,Spikyulka1,0,0,0,,Saya harap Anda bersiap sebagaimana mestinya.
Dialog: 0,0:09:43.69,0:09:45.33,Default,Spilyk1,0,0,0,,Selir Hon.
Dialog: 0,0:09:46.06,0:09:47.20,Default,Spillik1,0,0,0,,Satu poin.
Dialog: 0,0:09:48.76,0:09:51.53,Default,Spillik1,0,0,0,,Selir Kerajaan Cho. 2 poin.
Dialog: 0,0:09:53.17,0:09:54.77,Default,Spillie1,0,0,0,,Selir Min.
Dialog: 0,0:09:56.37,0:09:57.67,Default,Spilyk1,0,0,0,,4 poin.
Dialog: 0,0:09:58.57,0:10:02.11,Default,Spilyk1,0,0,0,,Selir Yun. Dia juga memiliki 4 poin.
Dialog: 0,0:10:04.61,0:10:06.18,Default,Spillit1,0,0,0,,Queen.
Dialog: 0,0:10:09.25,0:10:10.32,Default,Spilyk1,0,0,0,,10 poin.
Dialog: 0,0:10:11.19,0:10:12.22,Default,Spillik1,0,0,0,,Wow!
Dialog: 0,0:10:16.03,0:10:19.20,Default,Spillik1,0,0,0,,Pada akhirnya, ratu menang.
Dialog: 0,0:10:19.46,0:10:22.26,Default,Spillik1,0,0,0,,Ibu Suri akan memberikan penghargaan.
Dialog: 0,0:10:33.98,0:10:36.71,Default,Spillik1,0,0,0,,Dia bilang kamu akan menikmati liburan saja.
Dialog: 0,0:10:36.85,0:10:38.75,Default,Silk1,0,0,0,,Dipraktikkan secara diam-diam?
Dialog: 0,0:10:38.91,0:10:41.22,Default,Spilyk1,0,0,0,,Seperti aktor yang terlahir,
Dialog: 0,0:10:42.75,0:10:44.99,Default,Spilyk1,0,0,0,,Saya lebih baik dalam permainan sebenarnya.
Dialog: 0,0:10:48.49,0:10:51.03,Default,Spillik1,0,0,0,,Selamat, Yang Mulia.
Dialog: 0,0:10:51.03,0:10:53.66,Default,Silk1,0,0,0,,-Selamat, Yang Mulia.\N-Selamat, Yang Mulia.
Dialog: 0,0:10:58.90,0:11:00.20,Default,Spillik1,0,0,0,,Pengkhianatan apa.
Dialog: 0,0:11:01.10,0:11:04.07,Default,Silk1,0,0,0,,Kita harus melanjutkan ke istana untuk pesta.
Dialog: 0,0:11:04.41,0:11:06.58,Default,Spikyulka1,0,0,0,,Tapi kita punya sedikit waktu sebelum memulai,
Dialog: 0,0:11:06.58,0:11:09.08,Default,Spikyulka1,0,0,0,,jadi kamu bisa istirahat dulu.
Dialog: 0,0:11:09.08,0:11:11.11,Default,Spillik1,0,0,0,,Saya yakin Anda lelah setelah berburu.
Dialog: 0,0:11:11.48,0:11:13.72,Default,Silk1,0,0,0,,-Ya, ibu suri.\N-Ya, ibu suri.
Dialog: 0,0:11:21.46,0:11:22.76,Default,Spillik1,0,0,0,,Sangat menyakitkan?
Dialog: 0,0:11:23.06,0:11:25.13,Default,Spillik1,0,0,0,,Apa ini?
Dialogue: 0,0:11:26.13,0:11:28.60,Default,Silk1,0,0,0,,Sekarang aku mengerti kenapa kasim Kim begitu takut.
Dialog: 0,0:11:29.16,0:11:31.17,Default,Spillik1,0,0,0,,Yang Mulia, Anda harus kembali ke Aula Daejojeon
Dialog: 0,0:11:31.17,0:11:33.17,Default,Silk1,0,0,0,,dan berpakaian pantas untuk pesta.
Dialog: 0,0:11:33.17,0:11:35.24,Default,Spilyk1,0,0,0,,Tepat. Dan saya akan istirahat selagi saya di sana.
Dialog: 0,0:11:35.24,0:11:38.27,Default,Spikyulka1,0,0,0,,-Tentu saja.\N-Bagian belakang kepalaku masih sakit.
Dialogue: 0,0:11:38.27,0:11:39.38,Default,Spillik1,0,0,0,,Itu sial.
Dialog: 0,0:11:46.98,0:11:49.22,Default,Spilyk1,0,0,0,,Ayo cepat. Hanya ada sedikit waktu sebelum pesta.
Dialog: 0,0:11:58.89,0:12:00.76,Default,Spillik1,0,0,0,,Mengapa dia melakukan itu?
Dialogue: 0,0:12:01.90,0:12:04.60,Default,Spikyulka1,0,0,0,,Aku yakin ada yang mencoba mendorong kita.
Dialog: 0,0:12:05.33,0:12:06.40,Default,Spillik1,0,0,0,,Siapa?
Dialog: 0,0:12:07.55,0:12:09.84,Default,Spikyulka1,0,0,0,,Siapa sangka situasi sumur akan merusak hubungan.
Dialog: 0,0:12:10.77,0:12:14.68,Default,Spillik1,0,0,0,,Selalu ada tiga masalah di istana.
Dialog: 0,0:12:15.41,0:12:16.91,Default,Spillik1,0,0,0,,Permusuhan tersembunyi wanita,
Dialog: 0,0:12:17.41,0:12:20.22,Default,Spilyk1,0,0,0,,perebutan kekuasaan antara pengadilan dan
Dialog: 0,0:12:21.95,0:12:22.99,Default,Spillik1,0,0,0,,kematian karena racun.
Dialogue: 0,0:12:26.29,0:12:28.79,Default,Spikyulka1,0,0,0,,Jadi itu sebabnya kamu terus menyebut racun?
Dialog: 0,0:12:28.89,0:12:30.96,Default,Spillik1,0,0,0,,Saya tinggal di istana selama beberapa dekade
Dialog: 0,0:12:31.26,0:12:34.23,Default,Spikyulka1,0,0,0,,dan melihat banyak yang mati karena berbagai racun.
Dialog: 0,0:12:35.86,0:12:38.40,Default,Tumpahan1,0,0,0,,Racun mematikan membunuh dengan satu tetes.
Dialog: 0,0:12:38.83,0:12:40.10,Default,Spilyk1,0,0,0,,Racun tersembunyi
Dialog: 0,0:12:40.10,0:12:42.14,Default,Spillik1,0,0,0,,bunuh perlahan dengan kedok penyakit.
Dialog: 0,0:12:42.67,0:12:44.57,Default,Spikyulka1,0,0,0,,Dan meskipun tidak ditemukan,
Dialog: 0,0:12:45.04,0:12:47.74,Default,Spikyulka1,0,0,0,,tapi aku yakin banyak kematian
Dialog: 0,0:12:47.74,0:12:49.48,Default,Spilyk1,0,0,0,, disebabkan oleh racun.
Dialog: 0,0:12:50.21,0:12:53.55,Default,Biryulka1,0,0,0,,Ya, istana adalah tempat yang sangat berbahaya.
Dialog: 0,0:12:56.15,0:12:58.82,Default,Silk1,0,0,0,,Kalau dipikir-pikir, orang yang mirip Khan itu...
Dialog: 0,0:13:03.06,0:13:04.26,Default,Spillik1,0,0,0,,Ini dia. Orang itu.
Dialog: 0,0:13:04.39,0:13:05.43,Default,Spilyk1,0,0,0,,Sembunyikan.
Dialog: 0,0:13:07.00,0:13:09.90,Default,Spillik1,0,0,0,,Dan kemudian dia berbalik...
Dialog: 0,0:13:10.07,0:13:12.90,Default,Spillik1,0,0,0,,Apakah dia melihat wajahku? Jangan berpikir.
Dialog: 0,0:13:12.90,0:13:14.34,Default,Spillik1,0,0,0,,Makanya aku kabur.
Dialog: 0,0:13:14.67,0:13:16.27,Default,Spikyulka1,0,0,0,,-Apakah Anda yakin?\N-Ya.
Dialog: 0,0:13:16.27,0:13:18.67,Default,Spilyk1,0,0,0,,Gotcha.
Dialog: 0,0:13:24.81,0:13:25.81,Default,Spillit1,0,0,0,,Nyonya Choi.
Dialog: 0,0:13:26.02,0:13:27.95,Default,Spikyulka1,0,0,0,,Pergi dan cari tahu siapa orang yang
Dialog: 0,0:13:27.95,0:13:28.98,Default,Spikyulka1,0,0,0,,baru saja berbicara di sini.
Dialog: 0,0:13:30.29,0:13:32.25,Default,Spillik1,0,0,0,,Aku bertaruh bola nagaku yang hilang,
Dialog: 0,0:13:32.25,0:13:34.56,Default,Spikyulka1,0,0,0,,bahwa nama belakangnya adalah Khan.
Dialog: 0,0:13:35.32,0:13:37.79,Default,Spillik1,0,0,0,,Pesta akan segera dimulai.
Dialog: 0,0:13:37.83,0:13:39.13,Default,Spikyulka1,0,0,0,,Tidak akan dimulai,
Dialogue: 0,0:13:39.13,0:13:40.80,Default,Spilyk1,0,0,0,,sementara orang ini mengintai di sekitar sini.
Dialog: 0,0:13:41.16,0:13:42.23,Default,Spillik1,0,0,0,,Apa?
Dialogue: 0,0:13:43.53,0:13:45.03,Default,Silk1,0,0,0,,Lalu bagaimana dengan juru masak kerajaan?
Dialogue: 0,0:13:45.73,0:13:46.77,Default,Spillik1,0,0,0,,Dasar bajingan.
Dialogue: 0,0:13:49.94,0:13:53.41,Default,Spillik1,0,0,0,,Mengapa semuanya terlihat seperti yang saya alami?
Dialog: 0,0:13:54.88,0:13:57.28,Default,Spillik1,0,0,0,,Dan Cheoljong tidak tahu apa yang terjadi di sini.
Dialog: 0,0:14:00.65,0:14:03.29,Default,Spillik1,0,0,0,,Agar tidak menyesali apapun, orang harus hidup sesuai dengan statusnya.
Dialog: 0,0:14:03.59,0:14:05.85,Default,Spillik1,0,0,0,,Tapi aku akan menjadi diriku sendiri dan tidak akan mengganggu.
Dialogue: 0,0:14:09.16,0:14:11.73,Default,Spilligu1,0,0,0,,Aku yakin dia mencampurkan sesuatu ke dalam air.
Dialog: 0,0:14:13.60,0:14:14.90,Default,Spillie1,0,0,0,,Racun?
Dialog: 0,0:14:17.20,0:14:18.97,Default,Spillik1,0,0,0,,Ayo!
Dialog: 0,0:14:19.20,0:14:20.97,Default,Spikyulka1,0,0,0,,Bahkan jika istana adalah tempat yang kejam,
Dialog: 0,0:14:20.97,0:14:23.61,Default,Spikyulka1,0,0,0,,mengapa dia merusak pesta dengan keracunan massal?
Dialog: 0,0:14:24.21,0:14:25.27,Default,Spillik1,0,0,0,,Jelas tidak.
Dialogue: 0,0:14:28.11,0:14:30.78,Default,Spillik1,0,0,0,,Kecemasan dan ketakutan itu menular.
Dialogue: 0,0:14:30.78,0:14:32.28,Default,Spillik1,0,0,0,,Astaga.
Dialog: 0,0:14:32.55,0:14:33.68,Default,Spillik1,0,0,0,,Mau kemana?
Dialog: 0,0:14:34.15,0:14:36.49,Default,Spilyk1,0,0,0,,Ke TKP sebagai bukti.
Dialog: 0,0:14:36.59,0:14:38.12,Default,Spillik1,0,0,0,,Nah, kamu akan datang ke Daejojon.
Dialog: 0,0:14:38.15,0:14:40.92,Default,Spikyulka1,0,0,0,,Pikiranku berpacu bolak-balik, dan indra pengarahanku hilang.
Dialog: 0,0:14:42.02,0:14:43.59,Default,Spillik1,0,0,0,,Tunggu saya, Yang Mulia!
Dialog: 0,0:15:07.55,0:15:09.55,Default,kalian 2,0,0,0,,Sepertinya baunya seperti sejenis rumput.
Dialog: 0,0:15:10.65,0:15:12.25,Default,ini 2,0,0,0,,Apa yang dia tambahkan?
Dialogue: 0,0:15:12.96,0:15:14.12,Default,kalian berjumlah 2,0,0,0,,Dan lupa berpikir!
Dialog: 0,0:15:14.79,0:15:15.89,Default,kalian berjumlah 2,0,0,0,,Menurutmu?
Dialogue: 0,0:15:17.29,0:15:18.73,Default,kalian 2,0,0,0,,Kita semua kacau.
Dialog: 0,0:15:19.80,0:15:20.93,Default,ini 2,0,0,0,,Baginda!
Dialog: 0,0:15:23.33,0:15:26.07,Default,kamu 2,0,0,0,,Saya melakukan semua yang saya bisa,
Dialog: 0,0:15:26.07,0:15:28.40,Default,kalian ada 2,0,0,0,,tapi pesta akan segera dimulai,\Ndan masih belum ada makanan.
Dialog: 0,0:15:29.04,0:15:30.97,Default,itu kamu 2,0,0,0,,Cepat atau lambat, mereka akan dibawa.
Dialog: 0,0:15:34.08,0:15:35.78,Default,kalian ada 2,0,0,0,,Percayalah padaku dan jangan menyerah.
Dialog: 0,0:15:37.51,0:15:40.15,Default,kalian 2,0,0,0,,Saya akan mencoba memikirkan sesuatu.
Dialogue: 0,0:15:54.16,0:15:55.50,Default,kalian ada 2,0,0,0,,Menyerahlah.
Dialogue: 0,0:15:57.17,0:15:58.87,Default,anda berjumlah 2,0,0,0,,Menyerahlah dan anda akan merasa lebih baik.
Dialog: 0,0:15:59.60,0:16:00.60,Default,kamu adalah 2,0,0,0,,Ratu.
Dialog: 0,0:16:01.07,0:16:03.71,Default,Anda 2,0,0,0,,Anda memahami bahwa semuanya akan hancur.
Dialogue: 0,0:16:03.71,0:16:05.81,Default,kalian berjumlah 2,0,0,0,,Tidak peduli seberapa kerasnya kamu mencoba,
Dialogue: 0,0:16:05.81,0:16:08.14,Default,kalian berjumlah 2,0,0,0,,semuanya akan berakhir dengan kesakitan.\NMilikmu dan orang yang kamu kasihi.
Dialog: 0,0:16:10.51,0:16:13.52,Default,kalian berjumlah 2,0,0,0,,Jadi apa? Haruskah aku tidak mempedulikan segalanya\Ndan menjadi boneka yang patuh?
Dialog: 0,0:16:16.99,0:16:18.55,Default,kalian ada 2,0,0,0,,Aku tidak bisa hidup seperti ini.
Dialog: 0,0:16:19.79,0:16:22.93,Default,kamu 2,0,0,0,,Saya akan berusaha sebaik mungkin hingga saat terakhir.
Dialogue: 0,0:16:23.86,0:16:26.06,Default,anda berjumlah 2,0,0,0,,Jika anda menentangnya,
Dialogue: 0,0:16:27.66,0:16:28.96,Default,kalian ada 2,0,0,0,,lupakan aku.
Dialogue: 0,0:16:31.43,0:16:34.24,Default,kalian berjumlah 2,0,0,0,,Tepat! Kami menjaga jarak.
Dialog: 0,0:16:34.70,0:16:36.00,Default,kalian 2,0,0,0,,Oke, semuanya jelas.
Dialog: 0,0:16:43.28,0:16:46.45,Default,Anda 2,0,0,0,,Yang Mulia,\Nmengapa kata-kata dan tindakan Anda berbeda?
Dialog: 0,0:16:47.12,0:16:48.28,Default,ini 2,0,0,0,,Apa yang kamu bicarakan?
Dialogue: 0,0:16:48.65,0:16:51.65,Default,kalian berjumlah 2,0,0,0,,Bahkan jika aku berbicara omong kosong,\Nit itu dari lubuk hatiku.
Dialog: 0,0:16:51.75,0:16:53.62,Default, kalian 2,0,0,0,,Aku tidak pernah berbohong kepada siapa pun seumur hidupku.
Dialogue: 0,0:16:53.99,0:16:55.82,Default,kalian ada 2,0,0,0,,Kamu mengkhawatirkan raja.
Dialog: 0,0:16:55.89,0:16:58.26,Default,kamu 2,0,0,0,,Takut dia terluka jika tidak berhenti.
Dialog: 0,0:16:59.16,0:17:00.40,Default,ini 2,0,0,0,,Mengapa?
Dialog: 0,0:17:00.80,0:17:03.60,Default, 2,0,0,0 dari kalian,,Khawatir tentang raja dan selebriti -
Dialogue: 0,0:17:03.60,0:17:04.77,Default,anda berjumlah 2,0,0,0,,anda tidak dapat membayangkan hal yang lebih buruk lagi!
Dialog: 0,0:17:06.87,0:17:09.44,Default,anda berjumlah 2,0,0,0,,Sebelumnya, setiap kali\NAnda mengatakan sesuatu yang tidak masuk akal,
Dialog: 0,0:17:09.44,0:17:11.27,Default,ini 2,0,0,0,,itu tidak seperti yang kamu pikirkan.
Dialog: 0,0:17:37.60,0:17:39.33,Default,kalian 2,0,0,0,,Sudah kuduga, ada racun di dalam air.
Dialog: 0,0:17:41.17,0:17:43.17,Default,ini 2,0,0,0,,Kamu! Dimana koki kerajaan?
Dialog: 0,0:17:44.37,0:17:47.08,Default,ini 2,0,0,0,,Saya baru saja di sini.
Dialogue: 0,0:17:48.18,0:17:49.24,Default,kalian berjumlah 2,0,0,0,,Tidak!
Dialogue: 0,0:17:52.68,0:17:54.08,Default, itu kamu 2,0,0,0,,Lolos, kamu bajingan?
Dialogue: 0,0:17:54.38,0:17:56.08,Default, 2,0,0,0 dari kalian,, Berperilaku seperti seorang profesional sejati,
Dialogue: 0,0:17:56.08,0:17:57.35,Default,kalian 2,0,0,0,,dan sekarang kabur?
Dialogue: 0,0:17:57.49,0:17:59.22,Default,kalian ada 2,0,0,0,,Tapi apa yang akan terjadi pada pestanya?
Dialog: 0,0:17:59.99,0:18:02.06,Default,ini 2,0,0,0,,Raja berusaha keras untuk itu.
Dialogue: 0,0:18:02.12,0:18:04.43,Default,kalian ada 2,0,0,0,,Tak ada makanan, tak ada juru masak juga.
Dialog: 0,0:18:05.69,0:18:06.90,Default,ini 2,0,0,0,,Sudah berakhir.
Dialog: 0,0:18:08.70,0:18:11.77,Default,kalian berjumlah 2,0,0,0,,Jadi apa? Haruskah aku tidak mempedulikan segalanya\Ndan menjadi boneka yang patuh?
Dialog: 0,0:18:12.13,0:18:13.60,Default,kalian ada 2,0,0,0,,Aku tidak bisa hidup seperti ini.
Dialog: 0,0:18:14.90,0:18:18.14,Default,kamu 2,0,0,0,,Saya akan berusaha sebaik mungkin hingga saat terakhir.
Dialogue: 0,0:18:19.71,0:18:21.41,Default,kalian ada 2,0,0,0,,Wow!
Dialogue: 0,0:18:23.05,0:18:25.38,Default,kalian ada 2,0,0,0,,Hong Young, lakukan sesuatu untukku.
Dialog: 0,0:18:28.62,0:18:30.09,Default,ini 2,0,0,0,,Terima kasih atas layanan Anda.
Dialog: 0,0:18:31.49,0:18:32.92,Default,kamu 2,0,0,0,,Khan Simon
Dialog: 0,0:18:35.69,0:18:37.33,Default,ini 2,0,0,0,,Sekali lagi terima kasih.
Dialog: 0,0:18:42.73,0:18:44.80,Default,itu kamu 2,0,0,0,,Siapa nama pria yang baru saja keluar?
Dialogue: 0,0:18:45.13,0:18:46.44,Default,kalian ada 2,0,0,0,,Mengapa kamu membutuhkan ini?
Dialog: 0,0:18:47.14,0:18:48.64,Default,kalian ada 2,0,0,0,,Aku punya alasan tersendiri.
Dialogue: 0,0:18:48.74,0:18:50.21,Default,kalian ada 2,0,0,0,,aku tidak bisa memberitahumu.
Dialog: 0,0:18:54.24,0:18:55.54,Default,ini 2,0,0,0,,Horor.
Dialog: 0,0:18:55.78,0:18:59.08,Default,kalian ada 2,0,0,0,,Jika kamu meninggalkan ratu sendirian di pesta,
Dialogue: 0,0:18:59.65,0:19:01.92,Default, kalian 2,0,0,0,,siapa yang tahu apa yang akan dia lakukan?
Dialog: 0,0:19:03.55,0:19:05.85,Default,ini 2,0,0,0,,Halo!\NLama tidak bertemu!
Dialog: 0,0:19:05.85,0:19:07.62,Default,kalian ada 2,0,0,0,,Aku masuk angin di sini,
Dialog: 0,0:19:08.49,0:19:10.76,Default,ini 2,0,0,0,,pinjami kamu! Terima kasih.
Dialog: 0,0:19:31.35,0:19:33.82,Default,ini 2,0,0,0,,Fig! Beras! Ini nasi!
Dialogue: 0,0:19:33.82,0:19:37.42,Default, ini kamu 2,0,0,0,,-Nasi!\N-Nasi! Lihat, nasi!
Dialog: 0,0:19:37.42,0:19:38.62,Default, 2,0,0,0,,-Lebih Cepat!\N-Nasi!
Dialogue: 0,0:19:39.35,0:19:40.62,Default, ini kamu 2,0,0,0,,-Nasi!\N-Pegang kamu!
Dialog: 0,0:19:41.96,0:19:44.09,Default,ini kamu 2,0,0,0,,-Kumpulkan!\N-Lebih Cepat!
Dialog: 0,0:19:44.29,0:19:45.93,Default,ini 2,0,0,0,,-Cepat!\N-Kumpulkan!
Dialog: 0,0:19:47.06,0:19:48.26,Default,ini 2,0,0,0,,-Apa itu?\N-Apa?
Dialog: 0,0:19:50.00,0:19:51.27,Default,ini 2,0,0,0,,Fig!
Dialogue: 0,0:20:13.96,0:20:17.16,Default, ini kamu 2,0,0,0,,Ini pelangganku dari istana!
Dialog: 0,0:20:19.36,0:20:22.90,Default,ini 2,0,0,0,,Kebetulan banyak hal menarik yang datang hari ini.
Dialog: 0,0:20:30.21,0:20:31.64,Default,kalian ada 2,0,0,0,,Saya tidak punya waktu.
Dialog: 0,0:20:32.31,0:20:33.78,Default,ini 2,0,0,0,,Anda melakukan kesalahan.
Dialogue: 0,0:20:34.98,0:20:36.01,Default,kalian ada 2,0,0,0,,Apa?
Dialog: 0,0:20:36.91,0:20:37.98,Default,kalian ada 2,0,0,0,,Saya tidak melakukan kesalahan.
Dialog: 0,0:20:58.30,0:21:00.67,Default,kalian 2,0,0,0,,Kenapa banyak sekali godaan hari ini?
Dialog: 0,0:21:02.50,0:21:05.24,Default,kamu 2,0,0,0,,Lupakan saja,\Nkamu adalah dayang istana, kendalikan dirimu.
Dialogue: 0,0:21:21.72,0:21:25.29,Default,kalian ada 2,0,0,0,,Nyonya,\NApakah kamu ingin memberitahuku sesuatu?
Dialog: 0,0:21:54.32,0:21:55.92,Default, itu kamu 2,0,0,0,,Kamu bersembunyi selama ini
Dialog: 0,0:21:55.92,0:21:58.13,Default,itu memberi Anda 2,0,0,0,,kemampuannya sendiri dan tidak melakukan apa pun yang berguna.
Dialog: 0,0:21:58.53,0:22:01.16,Default,ini 2,0,0,0,,Pasti sulit untuk duduk diam.
Dialog: 0,0:22:01.70,0:22:03.97,Default,ini 2,0,0,0,,Saya sudah terbiasa. Itu tidak sulit bagi saya.
Dialog: 0,0:22:05.80,0:22:06.87,Default,ini 2,0,0,0,,Begitulah adanya.
Dialog: 0,0:22:40.30,0:22:42.10,Default,ini 2,0,0,0,,Pegang kamu. Sekarang semuanya sebagaimana mestinya.
Dialog: 0,0:22:44.34,0:22:48.68,Default,kalian berjumlah 2,0,0,0,,Apakah kamu yakin yang ada di gambar bukan kamu?
Dialog: 0,0:22:48.68,0:22:51.25,Default,kalian ada 2,0,0,0,,Sudah kubilang! Itu bukan aku!
Dialog: 0,0:22:51.51,0:22:54.18,Default,kalian 2,0,0,0,,saya tidak bohong, sekilas sudah jelas,
Dialog: 0,0:22:54.18,0:22:58.45,Default,ini 2,0,0,0,,tubuh orang ini persis milikku.
Dialog: 0,0:22:58.89,0:23:00.66,Default,kalian 2,0,0,0,,Tapi, maaf, itu bukan aku.
Dialog: 0,0:23:01.79,0:23:04.33,Default,kalian 2,0,0,0,,Suatu kehormatan bagiku kalau nama orang mirip,
Dialog: 0,0:23:04.33,0:23:05.53,Default,itu adalah 2,0,0,0,,terukir pada kaleidoskop.
Dialog: 0,0:23:05.69,0:23:08.33,Default,kalian berjumlah 2,0,0,0,,Katakan hal yang sama! Ngomong-ngomong,
Dialog: 0,0:23:09.16,0:23:13.40,Default,apakah kamu 2,0,0,0,, saat ini hal-hal seperti itu\Nare diminati di kalangan pelayan?
Dialog: 0,0:23:14.40,0:23:17.01,Default,itu menyakitimu 2,0,0,0,,Kata-kata tidak dapat menggambarkan seberapa besar
Dialog: 0,0:23:17.01,0:23:19.84,Default,itu kamu 2,0,0,0,,para dayang istana menyukai hal semacam ini.
Dialog: 0,0:23:20.34,0:23:23.91,Default,itu kamu 2,0,0,0,,Membingungkanku. Saya tidak berpikir saya begitu tampan.
Dialogue: 0,0:23:25.41,0:23:26.55,Default,kalian ada 2,0,0,0,,Wow.
Dialogue: 0,0:23:27.22,0:23:29.05,Default,kalian ada 2,0,0,0,,Jadi kamu Pak Simon
Dialog: 0,0:23:29.99,0:23:33.89,Default,itu adalah kamu 2,0,0,0,,dari klan Khan, dan nama lengkapmu
Dialog: 0,0:23:33.89,0:23:36.86,Default, 2,0,0,0,,terdengar seperti Khan Simon.
Dialog: 0,0:23:41.08,0:23:42.16,Default,ini 2,0,0,0,,
Dialog: 0,0:23:42.92,0:23:44.12,Default,kalian 2,0,0,0,,Jangan lupa,
Dialog: 0,0:23:44.96,0:23:47.29,Default,kalian berjumlah 2,0,0,0,,di tengah pesta,
Dialog: 0,0:23:47.62,0:23:50.39,Default,akan ada 2,0,0,0 dari kalian,,saat raja terkuat,
Dialog: 0,0:23:51.17,0:23:53.86,Default,ini 2,0,0,0,,saatnya mengumumkannya kepada publik.
Dialog: 0,0:23:54.13,0:23:57.53,Default,ini 2,0,0,0,,
Dialog: 0,0:24:16.08,0:24:17.38,Default,ini 2,0,0,0,,Nak, dengarkan.
Dialogue: 0,0:24:21.00,0:24:22.66,Default,kalian berjumlah 2,0,0,0,,Tolong aku.
Dialog: 0,0:24:23.56,0:24:26.20,Default,ini 2,0,0,0,,Bisakah kamu memberikan catatan pada seseorang?
Dialogue: 0,0:24:28.67,0:24:29.67,Default,ini 2,0,0,0,,Kepada siapa?
Dialogue: 0,0:24:35.01,0:24:36.13,Default,itu kamu 2,0,0,0,,Orang itu.
Dialog: 0,0:24:39.87,0:24:41.25,Default,ini 2,0,0,0,,Oke! Dipahami.
Dialogue: 0,0:24:47.58,0:24:48.66,Default,anda berjumlah 2,0,0,0,,Tn.
Dialog: 0,0:24:49.76,0:24:53.76,Default,ini 2,0,0,0,,pria muda ini meminta\Nuntuk memberikan ini padamu.
Dialog: 0,0:25:02.67,0:25:05.06,Default,kamu 2,0,0,0,,Aku harus mengatakan sesuatu,\N mempertaruhkan kehormatan klan.
Dialog: 0,0:25:05.36,0:25:06.78,Default, 2,0,0,0 untukmu,,Aku akan menunggu di paviliun.
Dialogue: 0,0:25:12.91,0:25:14.04,Default,anda berjumlah 2,0,0,0,,Saya tidak percaya.
Dialog: 0,0:25:15.48,0:25:17.02,Default, itu kamu 2,0,0,0,,Apakah dia menyadari sesuatu?
Dialog: 0,0:25:32.23,0:25:33.32,Default,ini 2,0,0,0,,Kamu telah datang.
Dialogue: 0,0:25:35.29,0:25:36.63,Default,kamu berjumlah 2,0,0,0,,Aku harus mengaku padamu.
Dialog: 0,0:25:37.30,0:25:39.27,Default,ini 2,0,0,0,,Aku tahu tidak sopan memanggilmu seperti itu,
Dialogue: 0,0:25:42.33,0:25:46.14,Default,kalian ada 2,0,0,0,,tapi keluargaku sangat berharga bagiku seperti kehidupan.
Dialogue: 0,0:25:46.98,0:25:47.98,Default,kalian ada 2,0,0,0,,Namun,
Dialog: 0,0:25:50.38,0:25:54.19,Default, kalian 2,0,0,0, setelah menghabiskan banyak malam merenung,\NI mengambil keputusan.
Dialog: 0,0:25:55.58,0:25:57.96,Default,kalian ada 2,0,0,0,,Aku putuskan untuk memilih yang lebih penting dari keluargaku.
Dialog: 0,0:25:59.28,0:26:00.82,Default,kamu 2,0,0,0,,Jika keluarga menentangnya,
Dialog: 0,0:26:02.29,0:26:03.47,Default,kalian ada 2,0,0,0,,lalu aku
Dialog: 0,0:26:05.09,0:26:06.36,Default,kamu 2,0,0,0,,Saya akan menolaknya.
Dialog: 0,0:26:07.24,0:26:10.33,Default,kalian ada 2,0,0,0,,Aku hanya ingin aku yang ada di matamu mulai sekarang.
Dialog: 0,0:26:17.21,0:26:21.78,Default,kalian ada 2,0,0,0,,Apakah kamu bercanda atau apa?\NI sudah cukup banyak hal yang bisa dilakukan tanpamu!
Dialog: 0,0:26:27.49,0:26:28.72,Default,ini 2,0,0,0,,Gadis itu membuatmu bingung!
Dialogue: 0,0:26:40.86,0:26:42.39,Default,kalian berjumlah 2,0,0,0,,Apa yang sudah kulakukan?
Dialog: 0,0:26:48.18,0:26:50.91,Default,kalian 2,0,0,0,,-Perutku, perutku.\N-Sakit sekali!
Dialog: 0,0:26:54.18,0:26:57.34,Default,itu kamu 2,0,0,0,,-Julurkan lidahmu.\N-Aku akan mati sekarang.
Dialogue: 0,0:26:58.38,0:27:00.11,Default, 2,0,0,0 dari kalian,,Lebih Kuat.
Dialogue: 0,0:27:01.85,0:27:02.92,Default,kalian berjumlah 2,0,0,0,,Perutku, perutku.
Dialog: 0,0:27:02.92,0:27:05.35,Default,kamu 2,0,0,0,,Kalian semua telah diracuni dengan beberapa tumbuhan.
Dialog: 0,0:27:10.09,0:27:11.36,Default,kalian 2,0,0,0,,-Sakit sekali!\N-Bagaimana bisa?
Dialogue: 0,0:27:13.36,0:27:17.44,Default, 2,0,0,0,,Saya rasa ada yang menambahkan\Nground birdweed.
Dialog: 0,0:27:17.44,0:27:18.51,Default,ini 2,0,0,0,,Teman-teman!
Dialog: 0,0:27:19.24,0:27:21.21,Default,kalian berjumlah 2,0,0,0,,-Apa?\N-Aku sekarat!
Dialog: 0,0:27:21.21,0:27:22.21,Default,ini 2,0,0,0,,Apa itu?
Dialogue: 0,0:27:24.34,0:27:25.75,Default,kalian ada 2,0,0,0,,Kenapa kamu disini?
Dialog: 0,0:27:25.75,0:27:28.04,Default,itu kamu 2,0,0,0,,Ratu memanggilku.
Dialog: 0,0:27:28.64,0:27:31.19,Default,ini 2,0,0,0,,Dia menyuruhku menguji airnya.
Dialog: 0,0:27:31.34,0:27:34.05,Default,itu kamu 2,0,0,0,,Seseorang menambahkan herba ke dalam air,\Nmenyebabkan sakit perut.
Dialog: 0,0:27:35.92,0:27:38.78,Default,ini 2,0,0,0,,Sialan! Dan ada masalah dengan air.
Dialogue: 0,0:27:40.35,0:27:42.43,Default,kalian berjumlah 2,0,0,0,,Mengapa kamu tidak berkendara dengan perutmu?
Dialogue: 0,0:27:42.43,0:27:44.59,Default,kalian ada 2,0,0,0,,Seperti yang bisa kalian lihat,\NI aku orang yang sangat gugup.
Dialog: 0,0:27:44.59,0:27:46.67,Default,kalian 2,0,0,0,,Dan saat aku khawatir, aku tidak meminum setetes pun di mulutku.
Dialog: 0,0:27:46.67,0:27:48.86,Default,kalian 2,0,0,0,,Sudah jelas dari kalian bahwa kalian termasuk orang yang, bahkan di lapangan,
Dialog: 0,0:27:48.86,0:27:51.27,Default,ada 2,0,0,0 dari kalian,,di mana pertempuran sedang berlangsung, tidurlah seperti orang mati.
Dialog: 0,0:27:51.27,0:27:53.80,Default,kalian ada 2,0,0,0,,Lihat dia, dia menyebut dirinya dokter,\Ndan dia sendiri bukan boom-boom di kalangan orang.
Dialogue: 0,0:27:53.80,0:27:55.80,Default,anda berjumlah 2,0,0,0,,Saya seorang penyembuh, bukan ahli fisiognomi.
Dialog: 0,0:27:56.87,0:28:00.14,Default,kalian ada 2,0,0,0,,Saya tentu saja seorang penyembuh yang berpengalaman,
Dialog: 0,0:28:00.61,0:28:04.22,Default,kalian ada 2,0,0,0,,tapi bahkan aku tidak akan membuat mereka bangkit kembali sampai besok.
Dialog: 0,0:28:04.34,0:28:08.35,Default,kalian ada 2,0,0,0,,Biarpun mereka membawa makanan,\Nlalu dengan persaudaraan anak yatim dan dhuafa ini...
Dialog: 0,0:28:09.22,0:28:10.88,Default,ini 2,0,0,0,,Siapa yang melakukan ini?
Dialog: 0,0:28:17.89,0:28:19.29,Default,Kus3,0,0,0,,Belum pernah melihatnya.
Dialog: 0,0:28:22.83,0:28:24.51,Default,Kus3,0,0,0,,Apakah kamu menambahkan racunnya?
Dialog: 0,0:28:34.28,0:28:37.28,Default,Kus3,0,0,0,,Yang Mulia mengutus saya, seorang koki tamu,
Dialog: 0,0:28:37.28,0:28:38.61,Default,Kus3,0,0,0,,untuk mempersiapkan pesta.
Dialog: 0,0:28:40.81,0:28:42.35,Default,Kus3,0,0,0,,Nama saya Lee Senman.
Dialog: 0,0:28:43.05,0:28:45.46,Default,Kus3,0,0,0,,Saya datang untuk membantu anda.
Dialog: 0,0:28:45.78,0:28:46.82,Default,Kus3,0,0,0,,Tangkap.
Dialog: 0,0:28:50.53,0:28:52.23,Default,Kus3,0,0,0,,Tidak perlu khawatir, ini ratunya.
Dialog: 0,0:28:52.97,0:28:54.06,Default,Kus3,0,0,0,,Setuju?
Dialog: 0,0:28:54.36,0:28:56.50,Default,Kus3,0,0,0,,Omong kosong! Mengapa kamu memanggilnya ratu?
Dialog: 0,0:28:56.56,0:28:59.41,Default,Kus3,0,0,0,,Sial, ada apa dengan matamu?
Dialog: 0,0:28:59.41,0:29:03.03,Default,Kus3,0,0,0,,Ratu sedang sibuk menari. Kenapa dia ada di sini?
Dialog: 0,0:29:03.18,0:29:04.87,Default,Kus3,0,0,0,,Formal,
Dialogue: 0,0:29:04.87,0:29:07.52,Default,Kus3,0,0,0,,dia ada di pesta sekarang lho?
Dialog: 0,0:29:07.84,0:29:10.34,Default,Kus3,0,0,0,,Sekarang sudah jelas.
Dialog: 0,0:29:11.75,0:29:12.78,Default,Kus3,0,0,0,,Tomat?
Dialog: 0,0:29:13.04,0:29:15.26,Default,Kus3,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:29:15.38,0:29:18.88,Default,Kus3,0,0,0,,Ini adalah kesemek yang umurnya hanya setahun.
Dialogue: 0,0:29:18.88,0:29:20.66,Default,Kus3,0,0,0,,Kamu dari pedalaman mana, bocah?
Dialog: 0,0:29:20.66,0:29:22.62,Default,Kus3,0,0,0,,Bagaimana mungkin seorang juru masak tidak mengetahui hal ini?
Dialog: 0,0:29:23.00,0:29:25.73,Default,Kus3,0,0,0,,Beraninya kau memanggilku anak nakal?
Dialog: 0,0:29:25.73,0:29:28.03,Default,Kus3,0,0,0,,Kami sama-sama juru masak. Saya menyebutnya apa pun yang saya inginkan.
Dialog: 0,0:29:28.20,0:29:30.03,Default,Kus3,0,0,0,,-Benarkah?\N-Tentu saja, bocah!
Dialog: 0,0:29:30.03,0:29:32.13,Default,Kus3,0,0,0,,Hei, ini tidak pada tempatnya.
Dialog: 0,0:29:32.13,0:29:34.03,Default,Kus3,0,0,0,,Kamu meninggalkan dapur dan melarikan diri.
Dialogue: 0,0:29:34.03,0:29:35.10,Default,Kus3,0,0,0,,Kamu juru masak yang seperti apa?
Dialog: 0,0:29:35.10,0:29:36.28,Default,Kus3,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:29:36.28,0:29:38.30,Default,Kus3,0,0,0,,Saya pergi ke Nanonpo untuk mencari makanan
Dialog: 0,0:29:38.30,0:29:39.71,Default,Kus3,0,0,0,,untuk meredakan sakit perut.
Dialog: 0,0:29:40.61,0:29:41.64,Default,Kus3,0,0,0,,Nenonpho?
Dialog: 0,0:29:41.64,0:29:43.78,Default,Kus3,0,0,0,,Ya, ke peternakan kerajaan.
Dialog: 0,0:29:43.78,0:29:44.95,Default,Kus3,0,0,0,,Kamu tidak tahu apa-apa.
Dialog: 0,0:29:48.46,0:29:49.92,Default,Kus3,0,0,0,,Tunjukkan apa yang kamu bawa.
Dialog: 0,0:29:55.09,0:29:58.70,Default,Kus3,0,0,0,,Menyiapkan hidangan dimulai dengan pemilihan\N produk berkualitas tinggi.
Dialog: 0,0:30:00.59,0:30:02.74,Default,Kus3,0,0,0,,Dan di peternakan kerajaan
Dialogue: 0,0:30:02.74,0:30:04.74,Default,Kus3,0,0,0,,apakah mereka beternak ayam juga?
Dialogue: 0,0:30:05.91,0:30:08.48,Default,Kus3,0,0,0,,Kalau kamu bawa telur, aku bisa masak sesuatu.
Dialog: 0,0:30:23.02,0:30:25.05,Default,Kus3,0,0,0,,Perutmu sudah keroncongan.
Dialog: 0,0:30:25.05,0:30:27.32,Default,Kus3,0,0,0,,Kamu belum makan sejak kemarin untuk melepaskan diri hari ini.
Dialogue: 0,0:30:27.32,0:30:29.39,Default,Kus3,0,0,0,,Karena anda memahami hal ini,
Dialog: 0,0:30:29.39,0:30:31.36,Default,Kus3,0,0,0,,berarti aku belum makan apa pun sejak kemarin.
Dialog: 0,0:30:38.21,0:30:40.78,Default,Kus3,0,0,0,,Pesta yang kau minta diadakan,
Dialog: 0,0:30:40.78,0:30:42.71,Default,Kus3,0,0,0,,akan segera dimulai.
Dialog: 0,0:30:44.64,0:30:46.18,Default,Kus3,0,0,0,,Saya menantikannya.
Dialogue: 0,0:31:11.41,0:31:13.67,Default,Kus3,0,0,0,,Setiap jamuan makan di Blue House bertema,
Dialog: 0,0:31:14.48,0:31:17.21,Default,Kus3,0,0,0,,karena ini politik, bukan sekedar makanan.
Dialog: 0,0:31:19.30,0:31:20.87,Default,Kus3,0,0,0,,Masak apa?
Dialog: 0,0:31:22.11,0:31:23.92,Default,Kus3,0,0,0,,Apa tujuan perjamuan ini?
Dialog: 0,0:31:27.96,0:31:28.99,Default,Kus3,0,0,0,,Apa ini?
Dialog: 0,0:31:29.35,0:31:31.35,Default,Kus3,0,0,0,,Menunya dibuat oleh raja sendiri.
Dialog: 0,0:31:31.35,0:31:33.96,Default,Kus3,0,0,0,,Dan inilah daftar lengkap tamunya.
Dialogue: 0,0:31:36.39,0:31:38.79,Default,Kus3,0,0,0,,Jadi semua orang membicarakan menu “riser” ini?
Dialog: 0,0:31:42.20,0:31:44.36,Default,Kus3,0,0,0,,Saya akan membuat menu baru dari produk ini.
Dialog: 0,0:32:00.42,0:32:01.61,Default,Kus3,0,0,0,,Bagaimana hasilnya?
Dialog: 0,0:32:02.52,0:32:03.69,Default,Kus3,0,0,0,,Maaf.
Dialog: 0,0:32:04.69,0:32:07.70,Default,Kus3,0,0,0,,Saya berbicara dengan para perampok, tapi bukan mereka yang berburu makanan.
Dialog: 0,0:32:47.39,0:32:48.94,Default,Kus3,0,0,0,,Akhirnya pesta dimulai.
Dialogue: 0,0:33:01.92,0:33:03.48,Default,Kus3,0,0,0,,Ini pesta kerajaan.
Dialog: 0,0:33:03.92,0:33:06.69,Default,Kus3,0,0,0,,Hanya satu hidangan yang akan disajikan?
Dialog: 0,0:33:07.11,0:33:09.28,Default,Kus3,0,0,0,,Ini tidak bisa disebut makanan kerajaan.
Dialog: 0,0:33:09.55,0:33:11.16,Default,Kus3,0,0,0,,Tidak bisa. Ini semua?
Dialog: 0,0:33:11.28,0:33:13.46,Default,Kus3,0,0,0,,Saya yakin akan ada lebih banyak hidangan.
Dialog: 0,0:33:13.46,0:33:16.82,Default,Kus3,0,0,0,,Yang Mulia, bisa jelaskan?
Dialog: 0,0:33:17.09,0:33:19.47,Default,Kus3,0,0,0,,Masyarakat menderita kelaparan setiap tahunnya.
Dialog: 0,0:33:19.77,0:33:22.06,Default,Kus3,0,0,0,,Bahkan ada yang mati.
Dialog: 0,0:33:23.03,0:33:25.27,Default,Kus3,0,0,0,,Untuk mengingatkan penderitaan mereka,
Dialog: 0,0:33:25.80,0:33:28.60,Default,Kus3,0,0,0,,mereka telah menyiapkan makanan sederhana untukmu untuk rakyat jelata.
Dialog: 0,0:33:29.63,0:33:31.14,Default,Kus3,0,0,0,,Dengan segala hormat,
Dialog: 0,0:33:31.14,0:33:33.84,Default,Kus3,0,0,0,,kata “sederhana” tidak cocok di sini.
Dialog: 0,0:33:34.11,0:33:36.84,Default,Kus3,0,0,0,,Anda ingin memberi tahu petugas,
Dialog: 0,0:33:36.95,0:33:39.34,Default,Kus3,0,0,0,,tapi ini tidak bisa disajikan kepada para bangsawan,
Dialog: 0,0:33:39.34,0:33:41.35,Default,Kus3,0,0,0,,yang datang ke pesta dari jauh.
Dialog: 0,0:33:41.35,0:33:42.49,Default,Kus3,0,0,0,,Saya setuju.
Dialog: 0,0:33:42.72,0:33:45.08,Default,Kus3,0,0,0,,Sajikan hidangan ini kepada tamu undangan
Dialog: 0,0:33:45.62,0:33:47.19,Default,Kus3,0,0,0,,mirip dengan hukuman.
Dialogue: 0,0:33:48.03,0:33:51.47,Default,Kus3,0,0,0,,Mungkin kamu mengharapkan makanan yang berbeda, tapi kuharap
Dialog: 0,0:33:52.73,0:33:54.33,Default,Kus3,0,0,0,,Anda akan mengerti apa yang ingin saya tunjukkan.
Dialog: 0,0:34:07.37,0:34:08.95,Default,Kus3,0,0,0,,30 menit sebelumnya
Dialog: 0,0:34:11.24,0:34:12.68,Default,Kus3,0,0,0,,Ayo kita tusuk dengan jarum seperti ini.
Dialogue: 0,0:34:13.72,0:34:15.08,Default,Kus3,0,0,0,,Coretan macam apa ini?
Dialogue: 0,0:34:15.62,0:34:17.79,Default,Kus3,0,0,0,,Lempar kentangnya. Saya akan menunjukkan cara melakukannya.
Dialog: 0,0:34:49.01,0:34:51.35,Default,Kus3,0,0,0,,Akhirnya, jarumnya berguna.
Dialog: 0,0:34:54.39,0:34:56.10,Default,Kus3,0,0,0,,Panaskan minyak.
Dialog: 0,0:34:58.66,0:34:59.70,Default,Kus3,0,0,0,,Minyak?
Dialogue: 0,0:35:05.26,0:35:07.87,Default,Kus3,0,0,0,,Beraninya kau menggoreng jarumku?
Dialog: 0,0:35:07.97,0:35:10.01,Default,Kus3,0,0,0,,Tenang. Aku akan mensterilkannya.
Dialogue: 0,0:35:10.41,0:35:11.74,Default,Kus3,0,0,0,,Tahukah kamu apa maksudnya?
Dialog: 0,0:35:12.04,0:35:14.87,Default,Kus3,0,0,0,,50 tahun yang lalu mentor saya memberikannya kepada saya.
Dialog: 0,0:35:15.12,0:35:16.35,Default,Kus3,0,0,0,,Tenang.
Dialog: 0,0:35:16.35,0:35:18.99,Default,Kus3,0,0,0,,50 tahun? Baiklah, tenggat waktunya sudah habis.
Dialog: 0,0:35:19.31,0:35:20.81,Default,Kus3,0,0,0,,Tidak! Aku membutuhkannya!
Dialog: 0,0:35:20.81,0:35:22.49,Default,Kus3,0,0,0,,Aku akan meneruskannya ke muridku!
Dialog: 0,0:35:22.76,0:35:23.91,Default,Kus3,0,0,0,,Jangan berani-berani menjatuhkannya!
Dialogue: 0,0:35:31.89,0:35:32.93,Default,Kus3,0,0,0,,Itu saja.
Dialog: 0,0:35:40.06,0:35:42.68,Default,Kus3,0,0,0,,Terlihat cantik dan serasi dengan jarum di tengahnya.
Dialog: 0,0:35:42.68,0:35:46.14,Default,Kus3,0,0,0,,Dengan cara ini, inti pun akan cepat matang.
Dialogue: 0,0:35:47.85,0:35:51.79,Default,Kus3,0,0,0,,Bagaimana kamu mendapatkan ide yang begitu bagus?
Dialog: 0,0:35:51.79,0:35:53.89,Default,Kus3,0,0,0,,Kecepatan penting dalam memasak jajanan kaki lima.
Dialog: 0,0:35:54.06,0:35:56.12,Default,Kus3,0,0,0,,Ideal untuk situasi mendesak seperti ini.
Dialog: 0,0:35:57.01,0:35:58.03,Default,Kus3,0,0,0,,Jalan?
Dialog: 0,0:35:58.45,0:36:00.85,Default,Kus3,0,0,0,,Sepertinya zona perang.
Dialog: 0,0:36:01.49,0:36:03.62,Default,Kus3,0,0,0,,Dia selamat dari pertempuran sengit.
Dialog: 0,0:36:08.33,0:36:09.37,Default,Kus3,0,0,0,,Tahan.
Dialog: 0,0:36:11.43,0:36:12.64,Default,Kus3,0,0,0,,Kupas kentang.
Dialog: 0,0:36:12.76,0:36:13.93,Default,Kus3,0,0,0,,Saya?
Dialog: 0,0:36:14.58,0:36:15.91,Default,Kus3,0,0,0,,Siapa lagi?
Dialogue: 0,0:36:19.64,0:36:20.97,Default,Kus3,0,0,0,,Butuh permen beras?
Dialog: 0,0:36:22.97,0:36:25.14,Default,Kus3,0,0,0,,Saya dikirim untuk memeriksa keadaan.
Dialog: 0,0:36:44.06,0:36:45.47,Default,Kus3,0,0,0,,Hati-hati.
Dialogue: 0,0:36:47.41,0:36:49.83,Default,Kus3,0,0,0,,Iris setipis mungkin. Bahkan lebih tipis.
Dialog: 0,0:36:49.83,0:36:50.97,Default,Kus3,0,0,0,,Itu saja.
Dialog: 0,0:36:51.04,0:36:53.10,Default,Kus3,0,0,0,,Ujungnya lebih tajam. Bahkan lebih tajam.
Dialogue: 0,0:36:53.14,0:36:54.72,Default,Kus3,0,0,0,,Kami akan menusuk kentang dengan itu.
Dialog: 0,0:36:54.97,0:36:56.68,Default,Kus3,0,0,0,,Bagus sekali.
Dialog: 0,0:36:57.72,0:36:59.41,Default,Kus3,0,0,0,,-Apinya terlalu besar.\N-Oke.
Dialogue: 0,0:37:00.81,0:37:02.99,Default,Kus3,0,0,0,,-Dan di sini kamu harus lebih kuat.\N-Oke.
Dialog: 0,0:37:04.01,0:37:06.72,Default,Kus3,0,0,0,,Luar Biasa. Ingat semuanya.
Dialogue: 0,0:37:07.60,0:37:10.45,Default,Kus3,0,0,0,,Hari ini kita tidak sekedar menyiapkan makanan saja.
Dialog: 0,0:37:11.43,0:37:13.79,Default,Kus3,0,0,0,,Inilah wajah presiden.
Dialog: 0,0:37:20.41,0:37:24.54,Default,Kus3,0,0,0,,Yaitu, wajah Yang Mulia.
Dialog: 0,0:37:33.08,0:37:35.76,Default,Kus3,0,0,0,,Bolehkah Yang Mulia?
Dialog: 0,0:37:36.26,0:37:37.93,Default,Kus3,0,0,0,,Artinya, si juru masak.
Dialog: 0,0:37:39.16,0:37:40.33,Default,Kus3,0,0,0,,Mari kita lihat.
Dialog: 0,0:37:42.43,0:37:44.56,Default,Kus3,0,0,0,,Bagus sekali.
Dialog: 0,0:37:49.70,0:37:52.91,Default,Kus3,0,0,0,,Saya harap Cheoljong akan memahami ide yang mendasarinya.
Dialog: 0,0:38:08.01,0:38:11.35,Default,Kus3,0,0,0,,Inikah makanan sederhana orang biasa?
Dialog: 0,0:38:11.35,0:38:14.76,Default,Kus3,0,0,0,,Hanya saja saya tidak tahu apa yang dimakan orang biasa?
Dialogue: 0,0:38:17.66,0:38:19.76,Default,Kus3,0,0,0,,Spiral Kentang
Dialogue: 0,0:38:28.08,0:38:29.74,Default,Kus3,0,0,0,,Niatku mulia,
Dialog: 0,0:38:30.37,0:38:34.04,Default,Kus3,0,0,0,,namun, aku harus menghormati tamuku.
Dialog: 0,0:38:34.45,0:38:36.95,Default,Kus3,0,0,0,,Oleh karena itu produk yang digunakan sederhana,
Dialog: 0,0:38:37.24,0:38:39.35,Default,Kus3,0,0,0,,tetapi mereka dipersiapkan dengan cara yang baru.
Dialog: 0,0:38:40.64,0:38:44.95,Default,Kus3,0,0,0,,Hidangan pertama di pesta itu adalah kentang.
Dialogue: 0,0:38:45.83,0:38:47.06,Default,Kus3,0,0,0,,Apakah ini kentang?
Dialog: 0,0:38:49.79,0:38:51.12,Default,Kus3,0,0,0,,Ini bukan kentang biasa.
Dialog: 0,0:38:51.83,0:38:52.97,Default,Kus3,0,0,0,,Hidangannya disebut...
Dialog: 0,0:38:55.99,0:38:57.29,Default,Kus3,0,0,0,,Writhes
Dialog: 0,0:38:58.70,0:38:59.76,Default,Kus3,0,0,0,,seperti pegas?
Dialogue: 0,0:39:02.87,0:39:04.04,Default,Kus3,0,0,0,,Spiral Kentang!
Dialog: 0,0:39:04.54,0:39:05.58,Default,Kus3,0,0,0,,Oke.
Dialog: 0,0:39:05.58,0:39:07.81,Default,Kus3,0,0,0,,Menyerupai kumis naga.
Dialog: 0,0:39:07.81,0:39:09.24,Default,Kus3,0,0,0,,Namanya “Spiral”.
Dialog: 0,0:39:10.74,0:39:12.64,Default,Kus3,0,0,0,,Hidangan bahagia untuk hari bahagia.
Dialog: 0,0:39:12.64,0:39:14.35,Default,Kus3,0,0,0,,Itu hanya kentang.
Dialog: 0,0:39:14.35,0:39:17.16,Default,Kus3,0,0,0,,Naga? Anda melebih-lebihkan, Yang Mulia.
Dialog: 0,0:39:17.56,0:39:19.22,Default,Kus3,0,0,0,,Jika tidak ada kentang,
Dialog: 0,0:39:19.22,0:39:21.45,Default,Kus3,0,0,0,,kita akan kehilangan lebih banyak nyawa.
Dialog: 0,0:39:22.26,0:39:23.76,Default,Kus3,0,0,0,,Kentang desa
Dialog: 0,0:39:23.76,0:39:26.39,Default,Kus3,0,0,0,,tumbuh bahkan di tanah tandus dan mudah disimpan.
Dialog: 0,0:39:26.60,0:39:29.20,Default,Kus3,0,0,0,,Ini adalah produk makanan utama selama pertumbuhan jelai.
Dialog: 0,0:39:29.76,0:39:33.43,Default,Kus3,0,0,0,,Produk suci yang menyelamatkan nyawa.
Dialogue: 0,0:39:33.81,0:39:36.01,Default,Kus3,0,0,0,,Ini bukan "hanya kentang".
Dialog: 0,0:39:37.64,0:39:38.74,Default,Kus3,0,0,0,,Cicipi hidangannya.
Dialog: 0,0:39:57.35,0:40:00.03,Default,Kus3,0,0,0,,Gila. Sangat lezat.
Dialog: 0,0:40:00.60,0:40:02.26,Default,Kus3,0,0,0,,Saya belum pernah makan yang seperti ini.
Dialog: 0,0:40:03.70,0:40:07.54,Default,Kus3,0,0,0,,Penasihat yang tepat sepertinya benar-benar lapar.
Dialog: 0,0:40:16.47,0:40:17.74,Default,Kus3,0,0,0,,Apakah ini kentang?
Dialog: 0,0:40:30.33,0:40:33.22,Default,Kus4,0,0,0,,Ada tiga bumbu di depanmu.
Dialog: 0,0:40:33.22,0:40:35.64,Default,Kus4,0,0,0,,Hijau adalah garam pinus dari keluarga Namyang Khon.
Dialog: 0,0:40:36.06,0:40:38.81,Default,Kus4,0,0,0,,Dibuat dari garam laut dan jarum pinus
Dialog: 0,0:40:38.81,0:40:40.20,Default,Kus4,0,0,0,,di Istana Hwaseong.
Dialog: 0,0:40:41.74,0:40:44.87,Default,Kus4,0,0,0,,Bubuk merah muda - gula anggur.
Dialog: 0,0:40:45.54,0:40:47.54,Default,Kus4,0,0,0,,Gula? Akan lebih baik jika mereka menanam jelai.
Dialog: 0,0:40:48.24,0:40:50.37,Default,Kus4,0,0,0,,Dengan makanan lezat seperti itu tidak ada yang perlu dikhawatirkan,
Dialog: 0,0:40:50.37,0:40:52.41,Default,Kus4,0,0,0,,semua kesulitan akan teratasi.
Dialog: 0,0:40:54.12,0:40:57.16,Default,Kus4,0,0,0,,Iris hancur bercampur anggur liar.
Dialog: 0,0:40:57.99,0:40:59.66,Default,Kus4,0,0,0,,Anggur dikumpulkan di Gunung Kamaksan
Dialog: 0,0:40:59.66,0:41:01.66,Default,Kus4,0,0,0,,di wilayah keluarga Yun Phapyeong.
Dialog: 0,0:41:01.66,0:41:03.72,Default,Kus4,0,0,0,,Memberi gula warna dan aroma yang indah.
Dialog: 0,0:41:04.79,0:41:07.10,Default,Kus4,0,0,0,,Saus kuning terbuat dari buah persik.
Dialog: 0,0:41:07.62,0:41:09.70,Default,Kus4,0,0,0,,Buah persik terbaik yang dipilih
Dialog: 0,0:41:09.70,0:41:12.16,Default,Kus4,0,0,0,,dari Yoju, tempat tinggal klan Yohyn Min.
Dialogue: 0,0:41:13.04,0:41:16.83,Default,Kus4,0,0,0,,Tema pesta hari ini adalah harmoni.
Dialogue: 0,0:41:18.91,0:41:21.04,Default,Kus4,0,0,0,,Politik memecah belah umat,
Dialog: 0,0:41:21.04,0:41:24.18,Default,Kus4,0,0,0,,tapi makanan lezat menyatukan mereka.
Dialog: 0,0:41:24.62,0:41:28.08,Default,Kus4,0,0,0,,semoga kalian bisa merasakan keharmonisan ketiga marga,
Dialog: 0,0:41:28.49,0:41:30.29,Default,Kus4,0,0,0,,bergabung dengan kami hari ini.
Dialog: 0,0:41:40.47,0:41:43.47,Default,Kus4,0,0,0,,Potong dan goreng ubi, zucchini dan terong.
Dialog: 0,0:41:43.47,0:41:45.37,Default,Kus4,0,0,0,,Aku akan membuat sup sayur dengan tomat utuh
Dialog: 0,0:41:45.37,0:41:46.87,Default,Kus4,0,0,0,,dengan kaldu dan telur.
Dialog: 0,0:41:48.51,0:41:49.64,Default,Kus4,0,0,0,,Ide yang tidak biasa,
Dialog: 0,0:41:49.64,0:41:52.20,Default,Kus4,0,0,0,,cara memakan bejana itu sendiri akan membuat mereka gila.
Dialog: 0,0:41:55.18,0:41:56.31,Default,Kus4,0,0,0,,Belum selesai?
Dialog: 0,0:41:57.01,0:41:58.12,Default,Kus4,0,0,0,,Dimana disana.
Dialogue: 0,0:41:58.12,0:42:00.68,Default,Kus4,0,0,0,,Saya menumbuk jelai dan buncis menjadi bubuk.
Dialog: 0,0:42:00.68,0:42:03.56,Default,Kus4,0,0,0,,Saya memiliki semua jenis bubuk yang mungkin, dan saya mencampurnya dan mencampurnya.
Dialog: 0,0:42:04.35,0:42:08.26,Default,Kus4,0,0,0,,Hidangan yang sedang Anda siapkan sekarang akan menjadi puncak pesta.
Dialog: 0,0:42:08.26,0:42:09.26,Default,Kus4,0,0,0,,Oke.
Dialog: 0,0:42:11.99,0:42:14.47,Default,Kus4,0,0,0,,Apa yang kamu lakukan? Uleni lebih kuat, seperti saya.
Dialog: 0,0:42:15.43,0:42:18.76,Default,Kus4,0,0,0,,Berbahaya pada sendi bahu dan pergelangan tangan.
Dialog: 0,0:42:18.76,0:42:21.33,Default,Kus4,0,0,0,,Ayo. Gunakan lebih banyak kekuatan. Lakukan itu.
Dialog: 0,0:42:21.33,0:42:24.04,Default,Kus4,0,0,0,,Gunakan bahu dan pergelangan tangan jika perlu.
Dialog: 0,0:42:24.04,0:42:25.87,Default,Kus4,0,0,0,,Tekan adonan.
Dialog: 0,0:42:29.18,0:42:31.51,Default,Kus4,0,0,0,,Guru, semuanya sudah siap.
Dialogue: 0,0:42:31.51,0:42:32.51,Default,Kus4,0,0,0,,Benarkah?
Dialog: 0,0:42:33.58,0:42:35.89,Default,Kus4,0,0,0,,Oke.
Dialogue: 0,0:42:36.35,0:42:38.72,Default,Kus4,0,0,0,,Apapun katamu, ini pesta. Tidak mungkin tanpa daging.
Dialog: 0,0:42:39.22,0:42:41.08,Default,Kus4,0,0,0,,Menyelesaikan hidangan utama kita -
Dialog: 0,0:42:41.08,0:42:42.83,Default,Kus4,0,0,0,,burger dengan steak vegan.
Dialog: 0,0:43:01.37,0:43:05.12,Default,Kus4,0,0,0,,McDonald's
Dialogue: 0,0:43:05.12,0:43:06.72,Default,Kus4,0,0,0,,Bejana tomat yang bisa dimakan.
Dialog: 0,0:43:07.18,0:43:08.49,Default,Kus4,0,0,0,,Tomat merah
Dialog: 0,0:43:08.49,0:43:10.95,Default,Kus4,0,0,0,,pada Hari Kereta mengusir kesialan
Dialog: 0,0:43:10.95,0:43:12.89,Default,Kus4,0,0,0,,dan roh jahat.
Dialog: 0,0:43:20.97,0:43:22.64,Default,Kus4,0,0,0,,Rasanya lembut sekali!
Dialog: 0,0:43:30.20,0:43:31.35,Default,Kus4,0,0,0,,Apakah ini potongan daging?
Dialogue: 0,0:43:31.68,0:43:34.45,Default,Kus4,0,0,0,,Mustahil. Dagingnya tidak bisa dikirim...
Dialog: 0,0:43:37.14,0:43:40.64,Default,Kus4,0,0,0,,Saya ingin mengatakan bahwa sekarang sulit mendapatkan daging.
Dialog: 0,0:43:42.85,0:43:44.49,Default,Kus4,0,0,0,,Ada satu pepatah Cina:
Dialog: 0,0:43:44.49,0:43:46.22,Default,Kus4,0,0,0,,"Ada daging naga di langit,
Dialog: 0,0:43:46.22,0:43:47.89,Default,Kus4,0,0,0,,dan di bumi - dari monyet."
Dialog: 0,0:43:48.16,0:43:51.93,Default,Kus4,0,0,0,,Dan kami akan menambahkan: “Daging dari kacang-kacangan di masa sulit.”
Dialog: 0,0:43:52.56,0:43:56.64,Default,Kus4,0,0,0,,Dengan jelai dan kacang-kacangan kita akan menumbuhkan perut.
Dialog: 0,0:43:56.99,0:43:59.81,Default,Kus4,0,0,0,,Inilah inti dari McDonald's.
Dialog: 0,0:44:00.26,0:44:01.93,Default,Kus4,0,0,0,,McDonald's.
Dialog: 0,0:44:02.74,0:44:04.14,Default,Kus4,0,0,0,,
Dialog: 0,0:44:04.14,0:44:08.14,Default,Kus4,0,0,0,,Bergizi dan enak, seperti daging asli.
Dialogue: 0,0:44:08.87,0:44:10.14,Default,Kus4,0,0,0,,Ada sesuatu di dalamnya.
Dialog: 0,0:44:43.78,0:44:44.85,Default,Kus4,0,0,0,,Cantik sekali.
Dialog: 0,0:44:45.24,0:44:48.49,Default,Kus4,0,0,0,,Hiasi dengan bunga, dan jeli manis yang didinginkan akan siap.
Dialogue: 0,0:44:48.49,0:44:49.79,Default,Kus4,0,0,0,,Menyenangkan mata.
Dialog: 0,0:44:50.31,0:44:53.03,Default,Kus4,0,0,0,,Makanan penutup harus enak dan cantik.
Dialog: 0,0:44:55.43,0:44:56.95,Default,Kus4,0,0,0,,-Luar biasa.\N-Lihat saja warna-warna ini.
Dialogue: 0,0:44:56.95,0:44:59.43,Default,Kus4,0,0,0,,Dan yang terakhir, mari kita buat semua orang berkata “wow.”
Dialog: 0,0:44:59.72,0:45:01.70,Default,Kus4,0,0,0,,Akhir pesta yang sempurna.
Dialog: 0,0:45:12.47,0:45:13.81,Default,Kus4,0,0,0,,Jeli keberuntungan
Dialog: 0,0:45:13.81,0:45:15.24,Default,Kus4,0,0,0,,Cantik tentu saja,
Dialog: 0,0:45:15.24,0:45:17.85,Default,Kus4,0,0,0,,tapi itu hanya jeli biasa.
Dialog: 0,0:45:18.04,0:45:22.22,Default,Kus4,0,0,0,,Saya kira Anda tidak punya cukup uang untuk lebih banyak lagi.
Dialog: 0,0:45:24.39,0:45:26.93,Default,Kus4,0,0,0,,Berkat tongkatnya, makan jeli jauh lebih nyaman.
Dialog: 0,0:45:27.39,0:45:29.12,Default,Kus4,0,0,0,,Dan dia juga akan memprediksi keberuntunganmu.
Dialog: 0,0:45:29.62,0:45:30.62,Default,Kus4,0,0,0,,Semoga berhasil?
Dialog: 0,0:45:30.85,0:45:32.62,Default,Kus4,0,0,0,,Hidangan ini seperti awal yang baru,
Dialog: 0,0:45:32.62,0:45:35.83,Default,Kus4,0,0,0,,makanya disebut jeli keberuntungan.
Dialog: 0,0:45:36.47,0:45:40.01,Default,Kus4,0,0,0,,Semoga masa depanmu sukses, seperti awal yang baru.
Dialogue: 0,0:45:46.01,0:45:49.72,Default,Kus4,0,0,0,,Mungkin kita akan menyelesaikan pesta kita dengan mencari tahu keberuntungan kita?
Dialog: 0,0:45:50.31,0:45:54.14,Default,Kus4,0,0,0,,Bagaimana kita bisa melakukan hal seperti ini di istana suci?
Dialog: 0,0:45:58.58,0:45:59.79,Default,Kus4,0,0,0,,Satu lagi
Dialog: 0,0:46:01.18,0:46:02.29,Default,Kus4,0,0,0,,Satu lagi.
Dialog: 0,0:46:02.29,0:46:03.35,Default,Kus4,0,0,0,,Satu lagi?
Dialog: 0,0:46:05.26,0:46:07.12,Default,Kus4,0,0,0,,"Coba lain kali."
Dialog: 0,0:46:11.14,0:46:13.93,Default,Kus4,0,0,0,,Pecundang
Dialogue: 0,0:46:18.92,0:46:21.22,Default,Kus4,0,0,0,,Betapa sakitnya punggungku.
Dialog: 0,0:46:24.52,0:46:26.03,Default,Kus4,0,0,0,,Aku akan berbaring sekarang.
Dialog: 0,0:46:29.90,0:46:32.97,Default,Kus4,0,0,0,,Aku menaruh jiwaku ke dalam masakan ini, bukan bahannya.
Dialog: 0,0:46:33.20,0:46:35.24,Default,Kus4,0,0,0,,Aku akan mati.
Dialogue: 0,0:46:37.77,0:46:39.07,Default,Kus4,0,0,0,,Kita berhasil.
Dialog: 0,0:46:39.67,0:46:40.91,Default,Kus4,0,0,0,,Kami mampu.
Dialog: 0,0:46:43.91,0:46:45.78,Default,Kus4,0,0,0,,Tahukah kamu apa yang sedang kupikirkan sekarang?
Dialog: 0,0:46:47.65,0:46:50.25,Default,Kus4,0,0,0,,Saya tahu. Saya merasakan hal yang sama.
Dialogue: 0,0:46:52.55,0:46:54.12,Default,Kus4,0,0,0,,-Potongan ikan.\N-Apa?
Dialogue: 0,0:46:54.69,0:46:56.32,Default,Kus4,0,0,0,,Aku sedang memikirkan kue ikan.
Dialog: 0,0:46:58.69,0:47:01.09,Default,Kus4,0,0,0,,Si juru masak yang hampir mati di tangan Kaisar Qin Shihuang,
Dialog: 0,0:47:01.09,0:47:03.26,Default,Kus4,0,0,0,,memasak kue ikan malam sebelumnya.
Dialog: 0,0:47:03.26,0:47:05.53,Default,Kus4,0,0,0,,Saya pikir dia hanya beruntung.
Dialog: 0,0:47:06.23,0:47:07.37,Default,Kus4,0,0,0,,Tapi tidak.
Dialog: 0,0:47:07.57,0:47:08.60,Default,Kus4,0,0,0,,Dia menyiapkannya,
Dialog: 0,0:47:08.60,0:47:10.64,Default,Kus4,0,0,0,,berusaha sekuat tenaga untuk bertahan.
Dialog: 0,0:47:10.87,0:47:12.34,Default,Kus4,0,0,0,,Inspirasi -
Dialog: 0,0:47:12.34,0:47:14.34,Default,Kus4,0,0,0,,ini bukan hal biasa yang datang,
Dialog: 0,0:47:14.44,0:47:15.88,Default,Kus4,0,0,0,,ketika kamu menyerah.
Dialog: 0,0:47:17.18,0:47:18.31,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:47:19.35,0:47:20.41,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:47:22.28,0:47:24.79,Default,Kus4,0,0,0,,Nah, kenapa kamu terburu-buru sekali!
Dialog: 0,0:47:24.79,0:47:28.46,Default,Kus4,0,0,0,,Di Sini. Ada air di sini. Minum.
Dialog: 0,0:47:33.96,0:47:35.80,Default,Kus4,0,0,0,,Ratu, nama belakangnya adalah Khan.
Dialogue: 0,0:47:36.36,0:47:38.50,Default,Kus4,0,0,0,,Benarkah? Apakah nama belakangnya benar-benar Khan?
Dialog: 0,0:47:38.50,0:47:39.53,Default,Kus4,0,0,0,,Ya.
Dialog: 0,0:47:40.30,0:47:41.64,Default,Kus4,0,0,0,,Namanya Simon.
Dialog: 0,0:47:41.77,0:47:43.27,Default,Kus4,0,0,0,,Namanya Khan Simon.
Dialog: 0,0:47:43.30,0:47:45.81,Default,Kus4,0,0,0,,Simon? Siapa namanya sebagai orang asing?
Dialog: 0,0:47:48.68,0:47:50.88,Default,Kus4,0,0,0,,Khan Simon.
Dialog: 0,0:47:51.38,0:47:52.38,Default,Kus4,0,0,0,,Ya.
Dialog: 0,0:47:53.81,0:47:55.42,Default,Kus4,0,0,0,,Apa ini?
Dialog: 0,0:47:55.42,0:47:57.68,Default,Kus4,0,0,0,,Oh tidak. Tidak ada yang seperti itu.
Dialog: 0,0:47:59.32,0:48:01.02,Default,Kus4,0,0,0,,Saat aku berada di luar istana,
Dialog: 0,0:48:01.02,0:48:02.89,Default,Kus4,0,0,0,,Saya sampai di Hanseongbu
Dialog: 0,0:48:02.89,0:48:05.16,Default,Kus4,0,0,0,,dan memeriksa daftar keluarga mereka.
Dialog: 0,0:48:07.39,0:48:10.23,Default,Kus4,0,0,0,,Saya yakin daftar keluarga ini palsu.
Dialog: 0,0:48:11.67,0:48:15.07,Default,Kus4,0,0,0,,Saya tidak mengharapkan apa pun lagi dari nenek moyang Direktur Khan.
Dialog: 0,0:48:15.30,0:48:17.10,Default,Kus4,0,0,0,,Kami mengusirnya karena memalsukan identitasnya,
Dialog: 0,0:48:17.10,0:48:19.71,Default,Kus4,0,0,0,,jadi dia memutuskan untuk memenangkan hatinya dengan cara yang kotor?
Dialog: 0,0:48:19.71,0:48:22.08,Default,Kus4,0,0,0,,Ratu, sebaiknya kamu tidak tinggal di sini.
Dialog: 0,0:48:22.18,0:48:24.04,Default,Kus4,0,0,0,,Kamu sudah lama absen.
Dialog: 0,0:48:24.04,0:48:25.18,Default,Kus4,0,0,0,,Tepat.
Dialog: 0,0:48:25.41,0:48:26.78,Default,Kus4,0,0,0,,Anda melakukannya dengan baik, Nyonya Choi.
Dialog: 0,0:48:26.78,0:48:28.82,Default,Kus4,0,0,0,,-Ayo cepat.\N-Yang Mulia.
Dialog: 0,0:48:28.82,0:48:30.48,Default,Kus4,0,0,0,,-Tunggu.\N-Hati-hati.
Dialog: 0,0:48:30.48,0:48:31.52,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:48:33.69,0:48:35.52,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:48:35.92,0:48:37.02,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:48:37.92,0:48:40.46,Default,Kus4,0,0,0,,Apa? Apa yang terjadi?
Dialogue: 0,0:48:43.63,0:48:45.23,Default,Kus4,0,0,0,,Perutku...
Dialogue: 0,0:48:46.87,0:48:49.54,Default,Kus4,0,0,0,,Seperti seluruh band sedang bermain drum di perutku.
Dialog: 0,0:48:50.30,0:48:51.51,Default,Kus4,0,0,0,,Apa yang terjadi?
Dialog: 0,0:48:53.01,0:48:54.07,Default,Kus4,0,0,0,,Air...
Dialog: 0,0:48:54.91,0:48:57.48,Default,Kus4,0,0,0,,Tidak ada yang ganti airnya?
Dialog: 0,0:48:57.48,0:48:59.85,Default,Kus4,0,0,0,,Ada apa dengan ini
Dialog: 0,0:49:00.91,0:49:02.05,Default,Kus4,0,0,0,,air?
Dialog: 0,0:49:02.32,0:49:04.42,Default,Kus4,0,0,0,,Air ini telah diracuni.
Dialog: 0,0:49:04.95,0:49:06.92,Default,Kus4,0,0,0,,Racun?
Dialog: 0,0:49:08.26,0:49:09.49,Default,Kus4,0,0,0,,Racun?
Dialog: 0,0:49:10.32,0:49:11.32,Default,Kus4,0,0,0,,Nyonya!
Dialog: 0,0:49:13.43,0:49:14.93,Default,Kus4,0,0,0,,Sepertinya kamu sudah sampai.
Dialog: 0,0:49:16.03,0:49:17.40,Default,Kus4,0,0,0,,Tentu saja dia datang.
Dialog: 0,0:49:18.63,0:49:22.10,Default,Kus4,0,0,0,,Ini adalah pesta untuk menghormati kesembuhan ratu.
Dialog: 0,0:49:22.40,0:49:24.24,Default,Kus4,0,0,0,,Mulai sekarang, buka matamu.
Dialog: 0,0:49:24.87,0:49:27.81,Default,Kus4,0,0,0,,Perhatikan hasil tindakanmu.
Dialog: 0,0:49:40.82,0:49:42.02,Default,Kus4,0,0,0,,Tuhan.
Dialogue: 0,0:49:43.09,0:49:46.13,Default,Kus4,0,0,0,,Memasak ternyata lebih sulit dari perkiraanku.
Dialog: 0,0:49:47.53,0:49:50.33,Default,Kus4,0,0,0,,Setiap sentimeter tubuhku sakit.
Dialog: 0,0:49:51.10,0:49:55.67,Default,Kus4,0,0,0,,Juga, juru masak kerajaan terus meneriakiku.
Dialogue: 0,0:49:56.57,0:49:59.47,Default,Kus4,0,0,0,,-Bajingan ini.\N-Cepat kemari!
Dialog: 0,0:50:02.71,0:50:04.44,Default,Kus4,0,0,0,,Apakah kentang masih perlu dikupas?
Dialog: 0,0:50:04.44,0:50:07.01,Default,Kus4,0,0,0,,Bantu nyonya istana Choi.
Dialog: 0,0:50:07.05,0:50:08.18,Default,Kus4,0,0,0,,Tolong.
Dialog: 0,0:50:20.59,0:50:21.83,Default,Kus5,0,0,0,,Teruskan kerja bagusnya.
Dialog: 0,0:50:27.27,0:50:28.40,Default,Kus5,0,0,0,,Maaf.
Dialog: 0,0:50:38.41,0:50:39.98,Default,Kus5,0,0,0,,Pakai topeng tokkebi
Dialog: 0,0:50:40.81,0:50:42.88,Default,Kus5,0,0,0,,dan dia mempunyai bekas luka lama di wajahnya.
Dialog: 0,0:50:49.96,0:50:51.02,Default,Kus5,0,0,0,,Maaf.
Dialog: 0,0:50:59.17,0:51:00.23,Default,Kus5,0,0,0,,Tuhan.
Dialog: 0,0:51:01.43,0:51:02.50,Default,Kus5,0,0,0,,Maaf.
Dialog: 0,0:51:24.46,0:51:27.73,Default,Kus5,0,0,0,,Lihat, dia menderita kesakitan.
Dialog: 0,0:51:28.13,0:51:30.70,Default,Kus5,0,0,0,,Lakukan akupunktur, bakar dengan rumput, lakukan sesuatu.
Dialog: 0,0:51:30.70,0:51:32.73,Default,Kus5,0,0,0,,Dan berikan penawarnya.
Dialog: 0,0:51:32.73,0:51:35.30,Default,Kus5,0,0,0,,Hei, urus urusanmu sendiri.
Dialog: 0,0:51:35.44,0:51:37.27,Default,Kus5,0,0,0,,Saya penanggung jawab di area ini.
Dialogue: 0,0:51:45.75,0:51:47.31,Default,Kus5,0,0,0,,aku turuti.
Dialog: 0,0:51:47.55,0:51:49.48,Default,Kus5,0,0,0,,Kamu buruk sekali di dapur kerajaan,
Dialogue: 0,0:51:49.48,0:51:51.42,Default,Kus5,0,0,0,,tapi di rumah sakit kerajaan kamu ideal.
Dialog: 0,0:51:52.45,0:51:54.72,Default,Kus5,0,0,0,,Baik itu orang atau benda,
Dialog: 0,0:51:54.72,0:51:56.99,Default,Kus5,0,0,0,,semua orang harus berada di tempatnya masing-masing.
Dialog: 0,0:51:58.86,0:52:01.33,Default,Kus5,0,0,0,,Jarummu berfungsi lebih baik di dapur.
Dialog: 0,0:52:01.33,0:52:02.33,Default,Kus5,0,0,0,,Itu tidak benar!
Dialog: 0,0:52:02.33,0:52:04.53,Default,Kus5,0,0,0,,Jarum ini ideal untuk menusuk kentang.
Dialogue: 0,0:52:04.53,0:52:05.63,Default,Kus5,0,0,0,,Biarkan aku yang menggunakannya.
Dialogue: 0,0:52:05.77,0:52:07.20,Default,Kus5,0,0,0,,Berani sekali kau merencanakannya! Tidak pernah.
Dialog: 0,0:52:07.20,0:52:08.97,Default,Kus5,0,0,0,,Dan ini ideal untuk mengupas kentang.
Dialog: 0,0:52:08.97,0:52:11.54,Default,Kus5,0,0,0,,-Berikan padaku.\N-Tidak.
Dialog: 0,0:52:11.54,0:52:13.27,Default,Kus5,0,0,0,,Anda tidak diperbolehkan, Yang Mulia!
Dialogue: 0,0:52:20.85,0:52:25.75,Default,Kus5,0,0,0,,Tarian di perutku sudah berhenti.
Dialog: 0,0:52:27.52,0:52:29.16,Default,Kus5,0,0,0,,Saya seharusnya tidak berada di sini.
Dialogue: 0,0:52:30.56,0:52:32.26,Default,Kus5,0,0,0,,-Yang Mulia.\N-Nyonya Choi!
Dialogue: 0,0:52:32.53,0:52:35.70,Default,Kus5,0,0,0,,Tidak mungkin dia bisa pulih secepat itu.
Dialog: 0,0:52:39.63,0:52:41.60,Default,Kus5,0,0,0,,Dia wanita yang kuat.
Dialogue: 0,0:52:53.11,0:52:54.31,Default,Kus5,0,0,0,,Baunya seperti minyak.
Dialogue: 0,0:52:54.31,0:52:56.48,Default,Kus5,0,0,0,,Kenapa lama sekali kamu pergi?
Dialog: 0,0:52:57.25,0:52:59.12,Default,Kus5,0,0,0,,Nah, soalnya...
Dialog: 0,0:52:59.15,0:53:00.29,Default,Kus5,0,0,0,,Maafkan saya.
Dialog: 0,0:53:01.12,0:53:03.06,Default,Kus5,0,0,0,,Tanganku terpeleset,
Dialog: 0,0:53:03.32,0:53:05.49,Default,Kus5,0,0,0,,dan panahku mengenai ratu.
Dialog: 0,0:53:06.93,0:53:10.50,Default,Kus5,0,0,0,,Apakah kamu terluka?
Dialogue: 0,0:53:10.76,0:53:12.67,Default,Kus5,0,0,0,,Tidak, aku baik-baik saja.
Dialog: 0,0:53:13.10,0:53:15.00,Default,Kus5,0,0,0,,Perburuan melelahkan sekali,
Dialog: 0,0:53:15.00,0:53:17.67,Default,Kus5,0,0,0,,bahwa saya tertidur saat persiapan sedang berlangsung.
Dialog: 0,0:53:17.84,0:53:18.91,Default,Kus5,0,0,0,,Lihat apa.
Dialogue: 0,0:53:34.19,0:53:35.36,Default,Kus5,0,0,0,,Apron?
Dialogue: 0,0:53:44.16,0:53:46.93,Default,Kus5,0,0,0,,Kapan persiapanmu akan berhasil?
Dialog: 0,0:53:47.03,0:53:48.50,Default,Kus5,0,0,0,,Tunggu.
Dialogue: 0,0:53:48.77,0:53:51.37,Default,Kus5,0,0,0,,Raja berusaha keras dalam pesta ini.
Dialog: 0,0:53:51.84,0:53:54.84,Default,Kus5,0,0,0,,Sekarang dia harusnya menjadi pusat perhatian.
Dialog: 0,0:54:18.53,0:54:21.00,Default,Kus5,0,0,0,,Semua yang datang kesini sebagai ilmuwan harus memberi contoh
Dialogue: 0,0:54:21.40,0:54:23.14,Default,Kus5,0,0,0,,moderasi dalam makanan,
Dialog: 0,0:54:23.14,0:54:25.64,Default,Kus5,0,0,0,,untuk menunjukkan bahwa Anda memahami bahwa orang-orang kelaparan.
Dialog: 0,0:54:26.04,0:54:28.84,Default,Kus5,0,0,0,,Saya akan menggunakan kesempatan ini untuk mengumumkan.
Dialog: 0,0:54:31.54,0:54:33.15,Default,Kus5,0,0,0,,Dimulai dengan pesta ini,
Dialogue: 0,0:54:33.71,0:54:35.22,Default,Kus5,0,0,0,,kita akan mengurangi jumlah lauk di makanan kita.
Dialog: 0,0:54:36.78,0:54:38.05,Default,Kus5,0,0,0,,Makanan lebih sedikit?
Dialogue: 0,0:54:38.95,0:54:41.02,Default,Kus5,0,0,0,,Omong kosong apa yang dia bicarakan?
Dialog: 0,0:54:41.12,0:54:44.19,Default,Kus5,0,0,0,,Saat keadaan sulit di dalam negeri,
Dialog: 0,0:54:44.19,0:54:46.83,Default,Kus5,0,0,0,,raja harus menjadi bagian dari hidangan,
Dialog: 0,0:54:46.99,0:54:48.80,Default,Kus5,0,0,0,,untuk berbagi penderitaan rakyatnya.
Dialog: 0,0:54:49.16,0:54:53.43,Default,Kus5,0,0,0,,Dengan mengurangi jumlah hidangan, kami merasakan penderitaan rakyat kami,
Dialog: 0,0:54:53.73,0:54:55.57,Default,Kus5,0,0,0,,dan kita bisa mengatasi semuanya bersama-sama.
Dialog: 0,0:54:56.37,0:55:00.07,Default,Kus5,0,0,0,,Di saat seperti ini, pilih gandum untuk menyenangkan belasan orang
Dialog: 0,0:55:00.07,0:55:02.88,Default,Kus5,0,0,0,,dan nikmati isi perutmu dengan sepotong daging -
Dialog: 0,0:55:03.38,0:55:04.51,Default,Kus5,0,0,0,,sin.
Dialog: 0,0:55:05.58,0:55:08.15,Default,Kus5,0,0,0,,Pada akhirnya, mereka yang berada di istana
Dialog: 0,0:55:08.38,0:55:11.58,Default,Kus5,0,0,0,,mereka akan menyajikan daging di atas meja, mereka akan dihukum.
Dialog: 0,0:55:14.22,0:55:17.76,Default,Kus5,0,0,0,,Saya melarang tidak hanya daging, tetapi juga makanan mahal apa pun.
Dialog: 0,0:55:18.22,0:55:21.53,Default,Kus5,0,0,0,,Menteri tidak boleh menikmati minuman keras, menyanyi dan menari,
Dialog: 0,0:55:21.96,0:55:23.83,Default,Kus5,0,0,0,,dan harus menghentikan perebutan kekuasaan klan.
Dialog: 0,0:55:24.73,0:55:26.27,Default,Kus5,0,0,0,,Mereka yang tidak menerima ketentuan ini,
Dialog: 0,0:55:27.17,0:55:30.14,Default,Kus5,0,0,0,,Saya akan menganggap mereka haus akan hukuman.
Dialog: 0,0:55:32.47,0:55:33.61,Default,Kus5,0,0,0,,Yang Mulia.
Dialog: 0,0:55:47.09,0:55:49.29,Default,Kus5,0,0,0,,Saya, Kim Jwageun, mohon maafkan saya
Dialog: 0,0:55:49.46,0:55:52.03,Default,Kus5,0,0,0,,untuk kabar buruk.
Dialog: 0,0:56:24.72,0:56:26.49,Default,Kus5,0,0,0,,Penjahat ini berbohong tentang statusnya
Dialog: 0,0:56:26.49,0:56:28.26,Default,Kus5,0,0,0,,dan bersembunyi di pengawal kerajaan.
Dialog: 0,0:56:29.40,0:56:31.33,Default,Kus5,0,0,0,,Untuk melaksanakan pesanan Anda dan melayani Anda,
Dialog: 0,0:56:31.33,0:56:33.13,Default,Kus5,0,0,0,,mereka menggunakan identitas palsu.
Dialog: 0,0:56:35.17,0:56:38.34,Default,Kus5,0,0,0,,Waktunya telah tiba untuk menangani orang-orang yang dia sembunyikan.
Dialog: 0,0:56:38.50,0:56:40.47,Default,Kus5,0,0,0,,Saya yakin dia percaya bahwa dasar kekuatannya adalah mereka
Dialog: 0,0:56:40.47,0:56:42.34,Default,Kus5,0,0,0,,yang dia jaga dan lindungi dengan baik.
Dialogue: 0,0:56:42.78,0:56:45.35,Default,Kus5,0,0,0,,Kita harus memusnahkan ini sejak awal.
Dialogue: 0,0:56:47.28,0:56:49.25,Default,Kus5,0,0,0,,Supaya dia tidak pernah bangkit lagi.
Dialogue: 0,0:57:12.31,0:57:15.28,Default,Kus5,0,0,0,,Apakah kamu harus merusak hari penting ini?
Dialog: 0,0:57:15.28,0:57:18.01,Default,Kus5,0,0,0,,Tahukah kamu siapa mereka sebenarnya?
Dialog: 0,0:57:19.41,0:57:21.58,Default,Kus5,0,0,0,,Beberapa keluarga bersalah karena makar tingkat tinggi.
Dialog: 0,0:57:21.58,0:57:24.18,Default,Kus5,0,0,0,,Lainnya adalah bandit yang menyerang pejabat ilmuwan,
Dialog: 0,0:57:24.18,0:57:26.69,Default,Kus5,0,0,0,,dan ada pula yang dicari karena panggilan terbuka melawan pihak berwenang.
Dialog: 0,0:57:27.02,0:57:29.92,Default,Kus5,0,0,0,,Mereka semua adalah penentang istana,
Dialogue: 0,0:57:29.92,0:57:31.46,Default,Kus5,0,0,0,,tapi mereka, menyamar,
Dialog: 0,0:57:31.46,0:57:33.93,Default,Kus5,0,0,0,,dijaga Yang Mulia.
Dialogue: 0,0:57:34.06,0:57:36.16,Default,Kus5,0,0,0,,Tujuan utama mereka adalah melakukan kudeta.
Dialog: 0,0:57:36.46,0:57:38.46,Default,Kus5,0,0,0,,Karena urgensi masalah ini, saya tidak punya pilihan,
Dialog: 0,0:57:38.46,0:57:40.40,Default,Kus5,0,0,0,,kecuali untuk segera memberitahu Yang Mulia.
Dialog: 0,0:57:45.24,0:57:46.31,Default,Kus5,0,0,0,,Ini tidak mungkin.
Dialogue: 0,0:57:46.31,0:57:49.51,Default,Kus5,0,0,0,,Seseorang salah menuduh pengawalku,
Dialog: 0,0:57:49.84,0:57:53.15,Default,Kus5,0,0,0,,untuk melemahkan pertahanan dan merugikan saya.
Dialog: 0,0:57:53.65,0:57:54.88,Default,Kus5,0,0,0,,Siapa kamu
Dialog: 0,0:57:56.32,0:57:58.65,Default,Kus5,0,0,0,,maksudnya seseorang?
Dialog: 0,0:57:58.82,0:58:02.56,Default,Kus5,0,0,0,,Anda, komandan pasukan Kim Jwageun.
Dialog: 0,0:58:09.00,0:58:10.36,Default,Kus5,0,0,0,,Kamu berperilaku seperti ini,
Dialog: 0,0:58:10.36,0:58:13.70,Default,Kus5,0,0,0,,menurutmu ketiga klan ini akan mendukungmu?
Dialog: 0,0:58:14.63,0:58:16.94,Default,Kus5,0,0,0,,Apakah menurut Anda pidato manisnya cukup,
Dialog: 0,0:58:16.94,0:58:19.17,Default,Kus5,0,0,0,,untuk meyakinkan mereka agar memihakmu?
Dialog: 0,0:58:20.84,0:58:22.34,Default,Kus5,0,0,0,,Kamu bodoh.
Dialog: 0,0:58:22.91,0:58:25.08,Default,Kus5,0,0,0,,Saatnya bangun dan menyadari kenyataan.
Dialogue: 0,0:58:40.69,0:58:42.23,Default,Kus5,0,0,0,,Sungguh kurang ajar!
Dialog: 0,0:58:45.20,0:58:47.37,Default,Kus5,0,0,0,,Beraninya kau menghina raja seperti itu?
Dialog: 0,0:58:48.03,0:58:51.34,Default,Kus5,0,0,0,,Ini pengkhianatan dan makar!
Dialog: 0,0:58:51.34,0:58:53.74,Default,Kus5,0,0,0,,Betapa berbedanya dengan Anda, Yang Mulia. Tenang!
Dialogue: 0,0:58:53.74,0:58:56.11,Default,Kus5,0,0,0,,Beraninya kau memerintahkan raja?
Dialog: 0,0:59:06.69,0:59:10.62,Default,Kus5,0,0,0,,Yang Mulia, sepertinya ada sesuatu yang Anda andalkan.
Dialogue: 0,0:59:10.79,0:59:13.19,Default,Kus5,0,0,0,,Apapun itu,\Nkamu tidak akan bisa menggunakannya,
Dialog: 0,0:59:13.96,0:59:16.16,Default,Kus5,0,0,0,,kalau kehilangan anggota tubuhmu.
Dialogue: 0,0:59:18.00,0:59:21.03,Default,Kus5,0,0,0,,Kau harus membayar atas kecerobohanmu.
Dialog: 0,0:59:26.87,0:59:29.58,Default,Kus5,0,0,0,,Atas kejahatanmu kamu akan dipenggal.
Dialog: 0,0:59:34.31,0:59:37.45,Default,Kus5,0,0,0,,Yang Mulia, kita harus mengikuti hukum militer.
Dialog: 0,0:59:38.12,0:59:39.49,Default,Kus5,0,0,0,,Mereka bersalah makar yang artinya
Dialog: 0,0:59:39.49,0:59:41.39,Default,Kus5,0,0,0,,kasus ini di luar yurisdiksi pengawal kerajaan.
Dialog: 0,0:59:41.39,0:59:43.32,Default,Kus5,0,0,0,,Departemen Detektif akan menangani masalah ini!
Dialog: 0,0:59:48.86,0:59:49.86,Default,Kus5,0,0,0,,Yang Mulia!
Dialog: 0,0:59:51.23,0:59:52.83,Default,Kus5,0,0,0,,Pengawal Kerajaan akan mengurus ini!
Dialog: 0,0:59:52.83,0:59:55.20,Default,Kus5,0,0,0,,-Kami protes, Yang Mulia!\N-Kami protes, Yang Mulia!
Dialog: 0,0:59:55.64,0:59:59.34,Default,Kus5,0,0,0,,Kepala pengawal kerajaan tahu siapa mereka sebenarnya!
Dialog: 0,0:59:59.47,1:00:02.51,Default,Kus5,0,0,0,,Mungkin semua yang berjaga adalah pengkhianat.
Dialog: 0,1:00:02.51,1:00:04.81,Default,Kus5,0,0,0,,Para pengawal kerajaan tidak boleh dibiarkan menyelidiki apa
Dialog: 0,1:00:04.81,1:00:05.91,Default,Kus5,0,0,0,,apa yang terjadi di dalam dirinya!
Dialog: 0,1:00:05.91,1:00:08.75,Default,Kus5,0,0,0,,-Ubah keputusan Anda, Yang Mulia!\N-Ubah keputusan Anda, Yang Mulia!
Dialog: 0,1:00:08.75,1:00:11.18,Default,Kus5,0,0,0,,Ubah keputusan Anda, Yang Mulia!
Dialog: 0,1:00:23.00,1:00:24.56,Default,Kus5,0,0,0,,Kita bisa membubarkan pengawal kerajaan
Dialog: 0,1:00:24.56,1:00:27.33,Default,Kus5,0,0,0,,dan menilai komandannya.
Dialog: 0,1:00:27.33,1:00:28.37,Default,Kus5,0,0,0,,Namun,
Dialog: 0,1:00:30.04,1:00:32.87,Default,Kus5,0,0,0,,jika anda memerintahkan saya untuk menghukum para penjahat,
Dialog: 0,1:00:33.37,1:00:37.44,Default,Kus5,0,0,0,,Saya akan menganggap ini sebagai janji untuk tidak melakukan apa pun lagi
Dialog: 0,1:00:38.61,1:00:40.65,Default,Kus5,0,0,0,,dan saya akan berhenti di situ.
Dialog: 0,1:01:04.47,1:01:05.67,Default,Kus5,0,0,0,,Apapun yang kulakukan,
Dialog: 0,1:01:07.91,1:01:09.11,Default,Kus5,0,0,0,,tidak akan ada perubahan.
Dialog: 0,1:01:12.35,1:01:14.08,Default,Kus5,0,0,0,,Apa keinginan Anda, Yang Mulia?
Dialog: 0,1:01:26.66,1:01:27.73,Default,Kus5,0,0,0,,Oke.
Dialog: 0,1:01:32.67,1:01:34.13,Default,Kus5,0,0,0,,Saya berikan kasus ini
Dialog: 0,1:01:38.30,1:01:39.44,Default,Kus5,0,0,0,,di tangan anda.
Dialog: 0,1:04:01.68,1:04:04.28,Default,Kus5,0,0,0,,Penguasa Bumi
Dialog: 0,1:04:05.42,1:04:08.65,Default,Kus5,0,0,0,,dan tuan panen, aku berdoa padamu.
Dialog: 0,1:04:10.22,1:04:12.26,Default,Kus5,0,0,0,,Berkati kami,
Dialog: 0,1:04:13.03,1:04:16.73,Default,Kus5,0,0,0,,semoga hasil panen melimpah.
Dialog: 0,1:04:17.60,1:04:21.10,Default,Kus5,0,0,0,,Semoga rahmat-Mu
Dialog: 0,1:04:25.34,1:04:27.64,Default,Kus5,0,0,0,,untuk membantu masyarakat negeri ini\N dan semoga mereka tidak pernah mengenal kelaparan selamanya.
Dialog: 0,1:04:36.82,1:04:37.85,Default,Kus5,0,0,0,,Tolong.
Dialog: 0,1:05:29.14,1:05:31.07,Default,Kus5,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialogue: 0,1:05:47.05,1:05:51.12,Default,Kus5,0,0,0,,Bagaimana aku menjadi ratu
Dialog: 0,1:06:06.91,1:06:09.48,Default,Kus5,0,0,0,,Ledakan itu merusak pendengarannya.
Dialog: 0,1:06:09.48,1:06:10.54,Default,Kus5,0,0,0,,Oh, tidak.
Dialog: 0,1:06:10.94,1:06:13.15,Default,Kus5,0,0,0,,-Tidak akan ada masalah?\N-Tentu saja.
Dialogue: 0,1:06:13.15,1:06:14.58,Default,Kus5,0,0,0,,Tidak ada dalang di balik ini?
Dialog: 0,1:06:14.58,1:06:16.62,Default,Kus5,0,0,0,,Saya memutuskan untuk bertahan,
Dialog: 0,1:06:16.62,1:06:17.82,Default,Kus5,0,0,0,,jadi jangan mati.
Dialog: 0,1:06:17.82,1:06:19.32,Default,Kus5,0,0,0,,Pulihkan seolah tidak terjadi apa-apa,
Dialog: 0,1:06:19.32,1:06:20.59,Default,Kus5,0,0,0,,dan aku bisa menusukmu dari belakang.
Dialog: 0,1:06:20.59,1:06:23.22,Default,Kus5,0,0,0,,Musuh internal selalu mengerikan.
Dialog: 0,1:06:23.22,1:06:25.26,Default,Kus5,0,0,0,,Yang Mulia! Yang Mulia...{\i}
Dialog: 0,1:06:25.93,1:06:27.39,Default,Kus5,0,0,0,,Yang Mulia...
Dialog: 0,1:06:27.69,1:06:30.70,Default,Kus5,0,0,0,,Saya sarankan Anda menghentikan perwalian.
Dialog: 0,1:06:30.70,1:06:31.76,Default,Kus5,0,0,0,,Yang Mulia!
Dialog: 0,1:06:31.76,1:06:34.87,Default,Kus5,0,0,0,,Semua orang di istana ini membunuh Kim So-yeon.
Dialog: 0,0:50:08.18,0:50:10.18,Default,,0,0,0,,

Komentar: 0,0:53:37.22,0:53:38.78,Default,Kus5,0,0,0,,Mari kita memberi contoh kepada masyarakat dengan mengurangi jumlah hidangan.
