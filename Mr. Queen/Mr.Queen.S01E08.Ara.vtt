Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.03,0:01:06.53,Default,,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.53,0:01:08.70,Default,,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:52.18,0:01:54.38,Default,,0,0,0,,هل اكتشف "هونغ" أي شيء؟
Dialogue: 0,0:01:55.01,0:01:56.98,Default,,0,0,0,,على ما يبدو، كيم بيونغين خمن
Dialogue: 0,0:01:56.98,0:01:58.80,Default,,0,0,0,,أن قطعة القماش التي وجدها كانت من القصر.
Dialogue: 0,0:01:59.02,0:02:00.62,Default,,0,0,0,,إنه يقترب.
Dialogue: 0,0:02:01.05,0:02:02.35,Default,,0,0,0,,دعونا نسرع ​​أيضاً.
Dialogue: 0,0:02:29.85,0:02:32.35,Default,,0,0,0,,-نحن نتعلم عدم الهجوم.\N-حقاً؟
Dialogue: 0,0:02:39.49,0:02:40.62,Default,,0,0,0,,ما خطبك؟
Dialogue: 0,0:02:41.19,0:02:43.09,Default,,0,0,0,,فقدان عقلك ليس من ضمن قواعدك.
Dialogue: 0,0:02:43.46,0:02:46.66,Default,,0,0,0,,لقد كنت أتراجع لفترة طويلة، ولقد سئمت من الانتظار.
Dialogue: 0,0:03:03.21,0:03:06.55,Default,,0,0,0,,علاقات خطيرة
Dialogue: 0,0:03:09.95,0:03:12.82,Default,,0,0,0,,8 حلقة
Dialogue: 0,0:03:33.38,0:03:34.38,Default,,0,0,0,,انتظر.
Dialogue: 0,0:03:38.35,0:03:39.38,Default,,0,0,0,,حسناً، لنذهب.
Dialogue: 0,0:03:49.83,0:03:51.49,Default,,0,0,0,,هل ذهبت للصيد؟
Dialogue: 0,0:03:52.43,0:03:55.70,Default,,0,0,0,,كما يقولون: "استرح..."
Dialogue: 0,0:03:58.40,0:04:00.57,Default,,0,0,0,,"استرح وانتظر حتى يتعبوا."
Dialogue: 0,0:04:00.84,0:04:03.64,Default,,0,0,0,,أثناء استراحتي يتعب أعدائي.
Dialogue: 0,0:04:04.61,0:04:06.28,Default,,0,0,0,,أنت على حق.
Dialogue: 0,0:04:07.11,0:04:10.08,Default,,0,0,0,,ولكن كيف أمسكت بالأرنب بدون قوس؟
Dialogue: 0,0:04:12.28,0:04:16.02,Default,,0,0,0,,القوس جعل يدي وأصابعي تؤلمني.
Dialogue: 0,0:04:17.12,0:04:19.62,Default,,0,0,0,,أنا متأكد من أنه لم يتم اختراعه للصيد،
Dialogue: 0,0:04:19.62,0:04:22.29,Default,,0,0,0,,ولكن لتعذيب الناس.
Dialogue: 0,0:04:23.46,0:04:27.10,Default,,0,0,0,,رغم أنه إذا تألمت يديك وأصابعك بعد ذلك،
Dialogue: 0,0:04:27.20,0:04:28.93,Default,,0,0,0,,إذن فهو مناسب لصيد الناس.
Dialogue: 0,0:04:32.34,0:04:35.97,Default,,0,0,0,,الحيوانات أسهل في الاصطياد في أي حال.
Dialogue: 0,0:04:37.57,0:04:39.48,Default,,0,0,0,,من الخطر عليك أن تقوم بالصيد معكما فقط.
Dialogue: 0,0:04:39.74,0:04:44.08,Default,,0,0,0,,يجب على الحراس أن يحرسوك أينما ذهبت.
Dialogue: 0,0:04:44.65,0:04:46.46,Default,,0,0,0,,في المرة القادمة سآخذها معي.
Dialogue: 0,0:04:48.15,0:04:52.52,Default,,0,0,0,,بالمناسبة، هل مازلت تشغل منصب رئيس حرس الملك؟
Dialogue: 0,0:04:52.76,0:04:54.42,Default,,0,0,0,,عندما يتحسن والد الملكة،
Dialogue: 0,0:04:54.42,0:04:56.39,Default,,0,0,0,,سوف أتخلى عن هذه المسؤولية.
Dialogue: 0,0:04:57.13,0:04:58.16,افتراضي,,0,0,0,,بالضبط.
Dialogue: 0,0:04:58.46,0:05:01.00,Default,,0,0,0,,من أجل صحتك -
Dialogue: 0,0:05:01.20,0:05:02.37,الافتراضي,,0,0,0,,قبول.
Dialogue: 0,0:05:03.37,0:05:05.40,Default,,0,0,0,,كل شيء على ما يرام. لا حاجة.
Dialogue: 0,0:05:05.40,0:05:07.00,Default,,0,0,0,,لا ترفضني.
Dialogue: 0,0:05:07.30,0:05:09.11,Default,,0,0,0,,هذه هدية من الملك.
Dialogue: 0,0:05:10.01,0:05:11.37,Default,,0,0,0,,فهمت.
Dialogue: 0,0:05:18.15,0:05:21.82,Default,,0,0,0,,هل سمعت - الملكة استيقظت؟
Dialogue: 0,0:05:22.42,0:05:23.42,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:05:23.85,0:05:25.39,Default,,0,0,0,,كيف تشعر؟
Dialogue: 0,0:05:25.56,0:05:28.19,Default,,0,0,0,,لحسن الحظ، صاحبة الجلالة تتمتع بصحة جيدة.
Dialogue: 0,0:05:28.76,0:05:31.86,Default,,0,0,0,,لقد تأقلمت مع المرض.\Nيا لها من راحة.
Dialogue: 0,0:05:32.83,0:05:35.10,Default,,0,0,0,,يجب أن أرى صاحبة الجلالة.
Dialogue: 0,0:05:45.37,0:05:46.44,Default,,0,0,0,,يا إلهي.
Dialogue: 0,0:05:49.61,0:05:51.21,Default,,0,0,0,,الآن ليس وقت الزيارات.
Dialogue: 0,0:05:51.48,0:05:53.15,Default,,0,0,0,,بما أن الملكة في حال أفضل،
Dialogue: 0,0:05:53.15,0:05:54.78,Default,,0,0,0,,لقد تجنبنا أسوأ النتائج.
Dialogue: 0,0:05:54.92,0:05:56.92,Default,,0,0,0,,سأبحث عن دفتر المحاسبة بنفسي.
Dialogue: 0,0:05:56.92,0:05:58.19,Default,,0,0,0,,سأذهب معك.
Dialogue: 0,0:05:59.66,0:06:01.99,Default,,0,0,0,,هذا سوف ينبههم فقط.
Dialogue: 0,0:06:02.33,0:06:04.56,Default,,0,0,0,,راقب كل ما يحدث في القصر.
Dialogue: 0,0:06:18.34,0:06:20.51,Default,,0,0,0,,الطقس لطيف اليوم.
Dialogue: 0,0:06:21.31,0:06:22.81,Default,,0,0,0,,لن تتمكن من اللحاق به!
Dialogue: 0,0:06:30.82,0:06:32.26,Default,,0,0,0,,رائحة الربيع.
Dialogue: 0,0:06:36.56,0:06:39.56,Default,,0,0,0,,هل تتزوجيني؟
Dialogue: 0,0:06:39.86,0:06:42.33,Default,,0,0,0,,ربما لم أخرج وجهاً لوجه أولاً،\Nولكن لدي عنزة.
Dialogue: 0,0:06:44.30,0:06:47.00,Default,,0,0,0,,حسناً، لا أعرف.
Dialogue: 0,0:06:50.27,0:06:51.41,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:07:03.59,0:07:06.72,Default,,0,0,0,,أردتها حقاً أن تعود.
Dialogue: 0,0:07:07.19,0:07:09.83,Default,,0,0,0,,وعادت ذكرياتها فقط.
Dialogue: 0,0:07:10.39,0:07:13.00,Default,,0,0,0,,كانت تظهر كالومضات هنا وهناك.
Dialogue: 0,0:07:13.66,0:07:16.40,Default,,0,0,0,,في كل مرة كنت أشعر بصداع وطنين في أذني.
Dialogue: 0,0:07:16.93,0:07:19.90,Default,,0,0,0,,لكن هذه المرة ظهرت الذكريات بدون مؤثرات خاصة.
Dialogue: 0,0:07:23.94,0:07:25.91,Default,,0,0,0,,هونيونغ، سيكون عمرك 19 هذا العام.
Dialogue: 0,0:07:27.04,0:07:28.48,Default,,0,0,0,,ولكن اسمك ليس هونغيون.
Dialogue: 0,0:07:28.48,0:07:30.51,Default,,0,0,0,,هو لقب، واسمك يون.
Dialogue: 0,0:07:32.32,0:07:33.38,Default,,0,0,0,,حاسة الشم لدي.
Dialogue: 0,0:07:33.38,0:07:35.32,Default,,0,0,0,,الروائح تساعدك على التذكر.
Dialogue: 0,0:07:37.49,0:07:38.62,Default,,0,0,0,,ولكن لماذا
Dialogue: 0,0:07:39.82,0:07:40.92,Default,,0,0,0,,هل ألعب بهذه الجودة؟
Dialogue: 0,0:07:41.76,0:07:44.09,Default,,0,0,0,,لقد لعبت الكاياغم منذ الطفولة.
Dialogue: 0,0:07:49.80,0:07:51.40,Default,,0,0,0,,لقد عادت ذاكرتك،
Dialogue: 0,0:07:51.40,0:07:53.00,Default,,0,0,0,,هنا استيقظت المواهب.
Dialogue: 0,0:07:55.81,0:07:57.01,Default,,0,0,0,,يا لها من حماقة.
Dialogue: 0,0:07:57.47,0:08:00.48,Default,,0,0,0,,عندما كنت نباتياً، سارت الأمور على نحو خاطئ.
Dialogue: 0,0:08:01.28,0:08:02.35,Default,,0,0,0,,توقف.
Dialogue: 0,0:08:02.85,0:08:05.18,Default,,0,0,0,,لماذا أصبح الصوت في رأسك أنثى؟
Dialogue: 0,0:08:10.02,0:08:11.05,Default,,0,0,0,,ما أنا,
Dialogue: 0,0:08:11.92,0:08:13.19,Default,,0,0,0,,هل فقدت صوتك؟
Dialogue: 0,0:08:13.76,0:08:15.36,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:08:15.52,0:08:17.43,Default,,0,0,0,,أستطيع سماعك تماماً.
Dialogue: 0,0:08:18.83,0:08:21.46,Default,,0,0,0,,عادت القوة إلى أصابعي،\Nلكن صوتي اختفى. تماما مثل
Dialogue: 0,0:08:22.57,0:08:23.80,Default,,0,0,0,,في "الحورية الصغيرة"؟
Dialogue: 0,0:08:25.13,0:08:28.94,Default,,0,0,0,,اكتشفها حتى لا يكون هناك شك في كلام الشاهد،
Dialogue: 0,0:08:28.94,0:08:30.84,Default,,0,0,0,,من باع الزرنيخ لسيدة البلاط خان
Dialogue: 0,0:08:31.14,0:08:35.04,Default,,0,0,0,,مثل سم الفئران، وكيف دخل السم إلى مطبخ الملك.
Dialogue: 0,0:08:41.55,0:08:43.82,Default,,0,0,0,,لدي عمل مع رئيس قسم المباحث.
Dialogue: 0,0:08:46.06,0:08:47.16,Default,,0,0,0,,كم هو غريب.
Dialogue: 0,0:08:48.26,0:08:50.33,Default,,0,0,0,,لطالما كان القصر كبيراً،
Dialogue: 0,0:08:51.16,0:08:53.83,Default,,0,0,0,,ولكنه اليوم ضخم وفارغ بشكل خاص.
Dialogue: 0,0:08:55.93,0:08:58.80,Default,,0,0,0,,صاحبة الجلالة قادمة.
Dialogue: 0,0:09:25.59,0:09:28.13,Default,,0,0,0,,هل أنا...
Dialogue: 0,0:09:28.93,0:09:31.50,Default,,0,0,0,,لقد وافقت على منح الملكة الأم بعض الوقت.
Dialogue: 0,0:09:32.74,0:09:34.30,Default,,0,0,0,,-ماذا؟\N-هذا هو الترتيب
Dialogue: 0,0:09:34.30,0:09:35.64,Default,,0,0,0,,الفناء.
Dialogue: 0,0:09:35.81,0:09:37.41,Default,,0,0,0,,سننتظر الآن.
Dialogue: 0,0:09:37.81,0:09:40.41,Default,,0,0,0,,لكن جهز كل الأدلة،
Dialogue: 0,0:09:40.41,0:09:42.22,Default,,0,0,0,,لاستخدامها في أي وقت.
Dialogue: 0,0:09:43.35,0:09:45.61,Default,,0,0,0,,احتفظ بها سراً.
Dialogue: 0,0:09:45.61,0:09:48.35,Default,,0,0,0,,ربما تمكنا من تجميع الصورة بأكملها،
Dialogue: 0,0:09:48.58,0:09:50.42,Default,,0,0,0,,ولكن قد تكون الملكة الأم متصلة
Dialogue: 0,0:09:50.42,0:09:52.22,Default,,0,0,0,,مع أولئك الذين يريدون إيذاء الملكة.
Dialogue: 0,0:09:52.69,0:09:56.06,Default,,0,0,0,,إذا تركناها بمفردها، فقد تكون\NHer صاحبة الجلالة في خطر مرة أخرى.
Dialogue: 0,0:09:56.26,0:09:58.23,Default,,0,0,0,,الناس الذين يريدون إيذاء الملكة؟
Dialogue: 0,0:09:59.29,0:10:02.16,Default,,0,0,0,,اعترفت الملكة بأنها أرادت الانتحار بإلقاء نفسها في البركة.
Dialogue: 0,0:10:02.16,0:10:04.37,Default,,0,0,0,,هذه المرة خذلتها صحتها.
Dialogue: 0,0:10:05.47,0:10:06.87,Default,,0,0,0,,ما الذي نتحدث عنه؟
Dialogue: 0,0:10:13.71,0:10:16.25,Default,,0,0,0,,أصبحت هدفاً بمجرد عبورها عتبة القصر.
Dialogue: 0,0:10:16.25,0:10:17.68,Default,,0,0,0,,هذا ما يقلقني.
Dialogue: 0,0:10:18.58,0:10:19.75,Default,,0,0,0,,أنا أفهم.
Dialogue: 0,0:10:21.08,0:10:22.99,Default,,0,0,0,,تنظيم اجتماع بدون ملك -
Dialogue: 0,0:10:22.99,0:10:24.82,Default,,0,0,0,,يا له من صداع.
Dialogue: 0,0:10:24.92,0:10:25.96,Default,,0,0,0,,سأذهب.
Dialogue: 0,0:10:26.09,0:10:27.96,Default,,0,0,0,,هل حدث شيء لجلالته؟
Dialogue: 0,0:10:28.12,0:10:30.13,Default,,0,0,0,,ذهب إلى الملكة.
Dialogue: 0,0:10:31.36,0:10:32.56,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:10:34.30,0:10:35.97,Default,,0,0,0,,بنين!
Dialogue: 0,0:10:37.93,0:10:39.90,Default,,0,0,0,,لم أكن أعلم أنك هنا.
Dialogue: 0,0:10:40.30,0:10:41.64,Default,,0,0,0,,يمكنك المتابعة.
Dialogue: 0,0:10:41.94,0:10:43.97,Default,,0,0,0,,أسعدك أن تعود إلى المنزل.
Dialogue: 0,0:10:46.21,0:10:48.58,Default,,0,0,0,,إنه منتصف النهار،\Nلماذا ترسله إلى المنزل؟
Dialogue: 0,0:10:48.58,0:10:50.48,Default,,0,0,0,,لم أنم طوال الليل، لذا فهمت الأمر بشكل خاطئ.
Dialogue: 0,0:10:54.18,0:10:56.39,Default,,0,0,0,,ما الذي كنت تعمل عليه، بما أنك تخلط بين النهار والليل؟
Dialogue: 0,0:10:56.39,0:10:59.16,Default,,0,0,0,,كنت في مهمة سرية طوال الليل.
Dialogue: 0,0:10:59.16,0:11:02.22,Default,,0,0,0,,لقد عانيت من هذا الخوف.
Dialogue: 0,0:11:04.23,0:11:07.03,Default,,0,0,0,,هل تعلمت شيئاً؟
Dialogue: 0,0:11:07.03,0:11:09.20,Default,,0,0,0,,بنين، أنا ضائعة.
Dialogue: 0,0:11:09.77,0:11:13.74,Default,,0,0,0,,وقعت في حب امرأة لا ينبغي لي أن أحبها.
Dialogue: 0,0:11:14.70,0:11:16.04,Default,,0,0,0,,ومن هي؟
Dialogue: 0,0:11:16.04,0:11:18.74,Default,,0,0,0,,لسبب ما، القصر فارغ بشكل خاص اليوم،
Dialogue: 0,0:11:18.74,0:11:20.18,Default,,0,0,0,,فارغ وفي قلبي.
Dialogue: 0,0:11:20.51,0:11:23.45,Default,,0,0,0,,ظللت أتساءل ما خطبي.
Dialogue: 0,0:11:23.95,0:11:26.85,Default,,0,0,0,,والآن في القصر لا يوجد سوى
Dialogue: 0,0:11:27.22,0:11:28.42,Default,,0,0,0,,امرأة واحدة.
Dialogue: 0,0:11:29.82,0:11:31.05,Default,,0,0,0,,صاحبة الجلالة.
Dialogue: 0,0:11:31.65,0:11:33.82,Default,,0,0,0,,أعتقد أنني وقعت في حب الملكة.
Dialogue: 0,0:11:34.56,0:11:36.83,Default,,0,0,0,,-ماذا؟\N-كيف يمكن أن أقع في حب أختي؟
Dialogue: 0,0:11:36.83,0:11:39.43,Default,,0,0,0,,هذا مخالف لقانون زنا المحارم.
Dialogue: 0,0:11:39.43,0:11:40.63,Default,,0,0,0,,نحن من نفس العائلة.
Dialogue: 0,0:11:40.63,0:11:43.53,Default,,0,0,0,,إنه نفس سفاح القربى.
Dialogue: 0,0:11:43.53,0:11:47.44,Default,,0,0,0,,وكأن هذا لم يكن كافياً - فهي غريبة ومتزوجة من الملك.
Dialogue: 0,0:11:47.94,0:11:48.94,Default,,0,0,0,,أنا مجنون.
Dialogue: 0,0:11:48.94,0:11:51.94,Default,,0,0,0,,لا، هذا أقل ما يقال،\NI فقدت كل عقلي على الطريق.
Dialogue: 0,0:11:52.21,0:11:54.24,Default,,0,0,0,,حتى لو نسيت كل هذا،
Dialogue: 0,0:11:54.24,0:11:55.48,Default,,0,0,0,,الأهم من ذلك -
Dialogue: 0,0:11:55.64,0:11:58.51,Default,,0,0,0,,إنها أكبر مني بكثير.
Dialogue: 0,0:11:58.58,0:12:00.08,Default,,0,0,0,,هل هذا طبيعي؟
Dialogue: 0,0:12:00.28,0:12:02.12,Default,,0,0,0,,هل مازلت قلقاً بشأن عمرها؟!
Dialogue: 0,0:12:02.35,0:12:04.39,Default,,0,0,0,,لماذا تصرخ في وجهي؟
Dialogue: 0,0:12:04.39,0:12:06.76,Default,,0,0,0,,أنت تتحدث محض هراء.
Dialogue: 0,0:12:06.79,0:12:07.96,Default,,0,0,0,,عذراً.
Dialogue: 0,0:12:08.56,0:12:10.36,Default,,0,0,0,,لن أقول المزيد.
Dialogue: 0,0:12:12.43,0:12:14.70,Default,,0,0,0,,لا، كل شيء على ما يرام.\NSعذراً على الصراخ.
Dialogue: 0,0:12:14.72,0:12:16.34,Default,,0,0,0,,لم ترفعي صوتك عليّ قط،
Dialogue: 0,0:12:16.50,0:12:18.47,Default,,0,0,0,,ولم أغضب قط.
Dialogue: 0,0:12:18.70,0:12:20.67,Default,,0,0,0,,بعد موعدك تغيرت كثيراً.
Dialogue: 0,0:12:20.90,0:12:22.30,Default,,0,0,0,,لدينا ما يكفي لنقوم به.
Dialogue: 0,0:12:22.67,0:12:24.71,Default,,0,0,0,,لم أغضب منك.
Dialogue: 0,0:12:26.81,0:12:29.01,Default,,0,0,0,,كيف توصلت إلى هذا الاستنتاج؟
Dialogue: 0,0:12:30.08,0:12:32.55,Default,,0,0,0,,كل شيء حولنا يذكرها.
Dialogue: 0,0:12:33.02,0:12:35.45,Default,,0,0,0,,كيف حملت مظلة الملكة،
Dialogue: 0,0:12:35.55,0:12:37.72,Default,,0,0,0,,بينما ظلت بجانبها،
Dialogue: 0,0:12:37.72,0:12:41.39,Default,,0,0,0,,بينما كانت تجري مع المغلي لجلالتها.
Dialogue: 0,0:12:41.52,0:12:44.79,Default,,0,0,0,,كل ما يمكنني التفكير فيه هو هونغ يونغ، وصيفة الملكة.
Dialogue: 0,0:12:46.70,0:12:48.63,Default,,0,0,0,,إذا فكرت في هونغ يونغ،
Dialogue: 0,0:12:48.63,0:12:50.53,Default,,0,0,0,,لماذا قررت أنك وقعت في حب الملكة؟
Dialogue: 0,0:12:50.57,0:12:51.83,Default,,0,0,0,,هل نسيت من أنا؟
Dialogue: 0,0:12:51.83,0:12:53.34,Default,,0,0,0,,أنا الحفيد السادس عشر والابن الأول
Dialogue: 0,0:12:53.34,0:12:54.84,Default,,0,0,0,,لثلاثة أجيال في عائلة القضاة.
Dialogue: 0,0:12:54.84,0:12:56.24,Default,,0,0,0,,أنا كيم هوان.
Dialogue: 0,0:12:56.24,0:12:59.38,Default,,0,0,0,,هل يمكنني أن أقع في حب إحدى سيدة البلاط؟
Dialogue: 0,0:12:59.48,0:13:01.51,Default,,0,0,0,,لذلك أنا على يقين أن في قلبي...
Dialogue: 0,0:13:05.85,0:13:07.52,Default,,0,0,0,,هل وقعت في حب سيدة البلاط؟!
Dialogue: 0,0:13:11.82,0:13:14.16,Default,,0,0,0,,حظاً موفقاً لك على طريق الحب الشائك.
Dialogue: 0,0:13:20.80,0:13:23.70,Default,Spilik,0,0,0,,التعليمات الأولية للأطفال
Dialogue: 0,0:13:30.84,0:13:33.71,Default,Spillit,0,0,0,,تشو هواجين
Dialogue: 0,0:13:53.76,0:13:54.83,Default,Spilik,0,0,0,,صاحب السمو.
Dialogue: 0,0:13:59.13,0:14:00.37,Default,Spilik,0,0,0,,أين الملك؟
Dialogue: 0,0:14:00.67,0:14:02.47,Default,Spilik,0,0,0,,ذهب إلى بيت الملكة.
Dialogue: 0,0:14:03.14,0:14:05.41,Default,Spilik,0,0,0,,لماذا فجأة؟
Dialogue: 0,0:14:05.41,0:14:07.11,Default,Spillie,0,0,0,,استعادت الملكة وعيها.
Dialogue: 0,0:14:07.21,0:14:09.95,Default,Spilik,0,0,0,,يريد أن يغتنم الفرصة لتفتيش منزلها.
Dialogue: 0,0:14:13.95,0:14:15.22,Default,Spilik,0,0,0,,هل تأذيت؟
Dialogue: 0,0:14:16.22,0:14:17.49,Default,Spilik,0,0,0,,لا مشكلة.
Dialogue: 0,0:14:22.83,0:14:24.63,Default,Spilik,0,0,0,,ثم سأزور الملكة أيضاً.
Dialogue: 0,0:14:37.97,0:14:39.58,Default,Spilik,0,0,0,,إلى ماذا أدين بهذه المتعة؟
Dialogue: 0,0:14:56.46,0:14:57.99,Default,Spillie,0,0,0,,نحيف,
Dialogue: 0,0:14:58.73,0:15:00.43,Default,Spillit,0,0,0,,سميك,
Dialogue: 0,0:15:01.73,0:15:03.13,افتراضي,Spilik,0,0,0,,عالي
Dialogue: 0,0:15:03.60,0:15:04.90,Default,Spilik,0,0,0,,ومنخفضة.
Dialogue: 0,0:15:05.67,0:15:07.67,Default,Spillit,0,0,0,,كل شخص بأحجام وأطوال مختلفة.
Dialogue: 0,0:15:07.67,0:15:10.87,Default,Spilik,0,0,0,,ولكن لديهم جميعًا شيء واحد مشترك.
Dialogue: 0,0:15:11.27,0:15:12.31,Default,Spilik,0,0,0,,هذا
Dialogue: 0,0:15:14.01,0:15:15.08,Default,Spilik,0,0,0,,عيناك.
Dialogue: 0,0:15:17.25,0:15:19.85,Default,Spilik,0,0,0,,لديك أفضل رؤية وهدف.
Dialogue: 0,0:15:20.18,0:15:23.19,Default,Spilyk,0,0,0,,أنتم الرماة الذين اخترتهم شخصياً.
Dialogue: 0,0:15:23.59,0:15:26.29,Default,Spilik,0,0,0,,وطولي ووزني متوسطان.
Dialogue: 0,0:15:26.29,0:15:27.96,Default,Spilik,0,0,0,,أي نوع أنا؟
Dialogue: 0,0:15:27.96,0:15:29.59,Default,Spilyk,0,0,0,,سوف تكون بطيئاً.
Dialogue: 0,0:15:33.43,0:15:36.13,Default,Spilik,0,0,0,,وهذا ما أسميه فريقك.
Dialogue: 0,0:15:36.87,0:15:38.10,Default,Spillit,0,0,0,,البؤساء.
Dialogue: 0,0:15:38.87,0:15:40.67,Default,Spilyk,0,0,0,,لقد تم إرسالك إلى الخط الأمامي،
Dialogue: 0,0:15:40.67,0:15:43.14,Default,Spilik,0,0,0,,لأنهم كانوا يعتبرون غير موجودين.
Dialogue: 0,0:15:43.51,0:15:45.07,Default,Spilyk,0,0,0,,لكن بهذه الأسلحة
Dialogue: 0,0:15:46.51,0:15:48.18,Default,Spilik,0,0,0,,سوف تصبح أفضل محاربي جوسون.
Dialogue: 0,0:15:49.08,0:15:50.75,Default,Spilik,0,0,0,,مثلي.
Dialogue: 0,0:15:54.12,0:15:57.12,Default,Spilik,0,0,0,,البندقية يمكن أن تودي بحياتك.
Dialogue: 0,0:16:03.19,0:16:04.36,Default,Spilik,0,0,0,,ولكن أيضاً
Dialogue: 0,0:16:07.33,0:16:08.76,Default,Spilik,0,0,0,,قد ينقذها.
Dialogue: 0,0:16:09.47,0:16:11.30,Default,Spilik,0,0,0,,صفّوا خمسة على التوالي للتصويب.
Dialogue: 0,0:16:17.91,0:16:21.04,Default,Spilik,0,0,0,,الأمر مزعج، لكن يجب أن أنقذ هذا البلد.
Dialogue: 0,0:16:24.68,0:16:25.71,Default,Spillit,0,0,0,,نار!
Dialogue: 0,0:16:33.16,0:16:35.49,Default,Spilik,0,0,0,,جئت لأخذ ما أحتاج إليه.
Dialogue: 0,0:16:36.89,0:16:39.60,Default,Spilik,0,0,0,,الأول هو دبوس شعر مع طائر الفينيق.
Dialogue: 0,0:16:40.00,0:16:41.80,Default,Spillikin,0,0,0,,دبوس شعر العنقاء؟
Dialogue: 0,0:16:42.66,0:16:44.90,Default,Spillit,0,0,0,,هدية للملكة؟
Dialogue: 0,0:16:44.90,0:16:48.37,Default,Spilik,0,0,0,,إذا كانت الملكة،\NI سيطلب سانيفون.
Dialogue: 0,0:16:50.07,0:16:53.88,Default,Spilik,0,0,0,,لست بحاجة إلى دبوس شعر ملكي ذهبي مع طائر الفينيق.
Dialogue: 0,0:16:54.41,0:16:56.04,Default,Spillie,0,0,0,,أحتاج إلى القطعة المصنوعة من اليشم.
Dialogue: 0,0:16:56.85,0:17:00.92,Default,Spillit,0,0,0,,ولكن وفقاً للآداب الملكية، الملكة فقط
Dialogue: 0,0:17:01.72,0:17:04.02,Default,Spilik,0,0,0,,يمكنه ارتداء دبابيس شعر العنقاء.
Dialogue: 0,0:17:04.02,0:17:05.29,Default,Spilik,0,0,0,,بالضبط.
Dialogue: 0,0:17:09.09,0:17:13.46,Default,Spilik,0,0,0,,والشيء الثاني الذي أحتاجه هو...
Dialogue: 0,0:17:17.93,0:17:21.50,Default,Spilik,0,0,0,,كنت أعرف ذلك. إنها تريد إغواء الملك هناك.
Dialogue: 0,0:17:24.14,0:17:26.64,Default,Split,0,0,0,,بلى. يجب أن ننتهي برصاصة.
Dialogue: 0,0:17:26.98,0:17:29.21,Default,Spilik,0,0,0,,نعم. أسرع.
Dialogue: 0,0:17:34.28,0:17:36.29,Default,Spillit,0,0,0,,قبل أن تكشف له الملكة السر.
Dialogue: 0,0:17:41.99,0:17:43.73,Default,Spilik,0,0,0,,هناك فرق واحد بيني وبين حورية البحر الصغيرة.
Dialogue: 0,0:17:44.59,0:17:47.80,Default,Spilik,0,0,0,,لديها أرجل من أجل صوتها، ولدي ذراعان.
Dialogue: 0,0:17:48.26,0:17:50.13,Default,Spillit,0,0,0,,مفاجأة تلو الأخرى.
Dialogue: 0,0:17:50.13,0:17:52.27,Default,Spilik,0,0,0,,فهل سأفقد نفسي قطرة قطرة؟
Dialogue: 0,0:17:52.87,0:17:54.24,Default,Spilik,0,0,0,,إذا بقيت هنا،
Dialogue: 0,0:17:54.24,0:17:57.77,Default,Spilik,0,0,0,,ذلك الوغد، المدير خان،\N سيحصل على كل ما يريد.
Dialogue: 0,0:17:58.37,0:17:59.98,Default,Spilik,0,0,0,,يمكنني اتهام أسلافه بالخيانة،
Dialogue: 0,0:17:59.98,0:18:02.68,Default,Spilik,0,0,0,,طارد الخانات ودمر العشيرة بأكملها.
Dialogue: 0,0:18:02.68,0:18:05.58,Default,Spilik,0,0,0,,سأدمر ثلاثة أجيال من الخانات،
Dialogue: 0,0:18:05.58,0:18:07.18,Default,Spilik,0,0,0,,حتى أنهم لم يتمكنوا من الحمل به.
Dialogue: 0,0:18:09.18,0:18:11.39,Default,Spilik,0,0,0,,ولكن إلى أي عشيرة ينتمون؟
Dialogue: 0,0:18:11.99,0:18:14.46,Default,Spilik,0,0,0,,لماذا يتغير مزاجها باستمرار؟
Dialogue: 0,0:18:20.30,0:18:22.70,Default,Biryulka,0,0,0,,هل أنتم جميعاً من فرقة "نامسادان" هنا؟
Dialogue: 0,0:18:22.70,0:18:24.07,Default,Spilik,0,0,0,,من أين تأتي مثل هذه المهارات؟
Dialogue: 0,0:18:24.53,0:18:27.67,Default,Spillit,0,0,0,,بالنسبة لنساء جوسون، هذا لا شيء.
Dialogue: 0,0:18:27.94,0:18:30.37,Default,Spilik,0,0,0,,هذه هي الطريقة الوحيدة للنظر خلف الجدران.
Dialogue: 0,0:18:32.77,0:18:34.61,Default,Spilik,0,0,0,,لم أكن أعرف المعنى العميق لهذا.
Dialogue: 0,0:18:35.44,0:18:37.55,Default,Spilik,0,0,0,,هذا صحيح. بعد أن عشت هنا لمدة أسبوع، أدركت
Dialogue: 0,0:18:37.55,0:18:40.08,Default,Spilik,0,0,0,,أن حياة امرأة جوسون أصعب بكثير مما توقعت.
Dialogue: 0,0:18:40.95,0:18:42.78,Default,Spilik,0,0,0,,وبالمناسبة، أنا أيضًا الملكة هنا.
Dialogue: 0,0:18:45.45,0:18:47.92,Default,Spilik,0,0,0,,ولكن إذا كان بإمكاني الانتقام الدموي...
Dialogue: 0,0:18:48.46,0:18:49.49,Default,Spilik,0,0,0,,لنذهب.
Dialogue: 0,0:18:52.49,0:18:54.40,Default,Spillit,0,0,0,,كل شيء سيكون على ما يرام إذا لم تشم.
Dialogue: 0,0:18:54.40,0:18:55.93,Default,Spilik,0,0,0,,الذكريات لن تعود.
Dialogue: 0,0:18:55.93,0:18:57.47,Default,Spilik,0,0,0,,وسيعود صوتي.
Dialogue: 0,0:18:57.63,0:19:00.60,Default,Spilik,0,0,0,,من هذا اليوم فصاعدا سأعيش من أجل الانتقام.
Dialogue: 0,0:19:00.94,0:19:03.41,Default,Spilik,0,0,0,,ولهذا أحتاج إلى الطاقة.
Dialogue: 0,0:19:03.87,0:19:04.94,Default,Spilik,0,0,0,,سيدة يونغ.
Dialogue: 0,0:19:04.94,0:19:08.34,Default,Spilik,0,0,0,,ماذا علي أن أفعل كملكة للحصول على قوة غير مسبوقة؟
Dialogue: 0,0:19:09.51,0:19:11.28,Default,Spilik,0,0,0,,أعرف أفضل طريقة للحصول على الطاقة.
Dialogue: 0,0:19:13.08,0:19:14.12,Default,Spilik,0,0,0,,أي واحد؟
Dialogue: 0,0:19:14.12,0:19:17.75,Default,Spillit,0,0,0,,إن إنتاج وريث سوف يمنحك أكبر قدر من القوة.
Dialogue: 0,0:19:19.86,0:19:20.92,Default,Spilik,0,0,0,,الإنتاج؟
Dialogue: 0,0:19:20.92,0:19:22.72,Default,Spilik,0,0,0,,أي نوع من الكلمات اللاإنسانية هذه؟
Dialogue: 0,0:19:24.29,0:19:25.39,Default,Spilik,0,0,0,,بالضبط.
Dialogue: 0,0:19:25.86,0:19:28.46,Default,Spilik,0,0,0,,بالنسبة لي، صن وون صاحب القوة الفائقة.
Dialogue: 0,0:19:28.66,0:19:30.10,Default,Spilik,0,0,0,,من هو صن وون؟
Dialogue: 0,0:19:30.37,0:19:32.23,Default,Spilik,0,0,0,,هذا اسم القرية.
Dialogue: 0,0:19:32.23,0:19:35.07,Default,Spillit,0,0,0,,الملكة صن وون. إنها الملكة الأرملة.
Dialogue: 0,0:19:36.41,0:19:39.31,Default,Spillie,0,0,0,,هونغ يونغ، إذا كنت أرغب في إثارة إعجابها،
Dialogue: 0,0:19:39.31,0:19:42.14,Default,Spilik,0,0,0,,-ماذا أحتاج...\N-أنجب وريثاً. بالضبط.
Dialogue: 0,0:19:42.14,0:19:44.61,Default,Spilik,0,0,0,,سأحضر لها هدية. ما الذي يمكنك التوصل إليه؟
Dialogue: 0,0:19:44.61,0:19:47.62,Default,Spillikins,0,0,0,,شيء صغير، لامع،\N باهظ الثمن وجميل.
Dialogue: 0,0:19:49.45,0:19:50.59,Default,Spilik,0,0,0,,انتظر لحظة.
Dialogue: 0,0:19:53.12,0:19:54.29,Default,Spillit,0,0,0,,تلك الرائحة...
Dialogue: 0,0:19:56.83,0:19:59.60,Default,Spilik,0,0,0,,تعود الذكريات، تعود...
Dialogue: 0,0:20:20.22,0:20:22.68,Default,Spillit,0,0,0,,هذا التخزين يسمى Sky. ما يوجد في الفناء الخلفي هو الأرض.
Dialogue: 0,0:20:22.68,0:20:24.25,Default,Spilik,0,0,0,,وماذا بجوار غرفة الضيوف أسود؟
Dialogue: 0,0:20:24.25,0:20:26.22,Default,Spilik,0,0,0,,نعم. لقد جمع والدك الثروة أثناء غيابك.
Dialogue: 0,0:20:26.22,0:20:28.42,Default,Spilyk,0,0,0,,جميع المخازن ممتلئة.
Dialogue: 0,0:20:28.42,0:20:31.29,Default,Spillit,0,0,0,,السماء، الأرض، أسود...
Dialogue: 0,0:20:32.59,0:20:35.16,Default,Spilik,0,0,0,,إذا فكرت في كل المستودعات في جوسون، وليس هذه فقط...
Dialogue: 0,0:20:35.16,0:20:37.47,Default,Spilik,0,0,0,,كان على عائلتك استخدام جميع الأحرف الصينية.
Dialogue: 0,0:20:39.20,0:20:41.00,Default,Spilik,0,0,0,,أوه يا عيني الصغيرة!
Dialogue: 0,0:20:41.54,0:20:44.04,Default,Spilik,0,0,0,,انظر، لقد ولدت وفي فمي ملعقة ذهبية.
Dialogue: 0,0:20:46.51,0:20:47.54,Default,Spilik,0,0,0,,هذا.
Dialogue: 0,0:20:50.41,0:20:51.41,Default,Spilik,0,0,0,,وهذا.
Dialogue: 0,0:20:52.78,0:20:54.22,Default,Spilik,0,0,0,,وإلى جانبهم،
Dialogue: 0,0:20:55.85,0:20:57.32,Default,Spillit,0,0,0,,حزم كل شيء آخر.
Dialogue: 0,0:20:58.59,0:20:59.65,Default,Spillit,0,0,0,,كل شيء آخر؟
Dialogue: 0,0:20:59.65,0:21:02.06,Default,Spilik,0,0,0,,لنأخذ كل شيء ونعود إلى القصر.
Dialogue: 0,0:21:02.99,0:21:05.66,Default,Spilik,0,0,0,,سيتعرض والدك لضربة.
Dialogue: 0,0:21:05.66,0:21:08.53,Default,Spilik,0,0,0,,من هذا اليوم فصاعداً، سأصبح ملكة ممارسة الضغط.
Dialogue: 0,0:21:10.67,0:21:11.67,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:21:12.20,0:21:15.37,Default,Spillit,0,0,0,,لقد وصل الملك.
Dialogue: 0,0:21:16.91,0:21:18.34,Default,Spilik,0,0,0,,لماذا هذا ضروري أصلاً؟
Dialogue: 0,0:21:19.04,0:21:20.34,Default,Spilik,0,0,0,,سأعود قريباً.
Dialogue: 0,0:21:20.34,0:21:22.04,Default,Spilik,0,0,0,,قل له أن ينتظرني في القصر.
Dialogue: 0,0:21:24.18,0:21:25.98,Default,Spilik,0,0,0,,ماذا تقول؟
Dialogue: 0,0:21:26.55,0:21:28.22,Default,Spilik,0,0,0,,أحتاج إلى إظهار إخلاصي لجدتي.
Dialogue: 0,0:21:28.22,0:21:29.95,Default,Spilik,0,0,0,,وابتعد عن الملك.
Dialogue: 0,0:21:32.75,0:21:34.16,Default,Spilik,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:21:46.57,0:21:49.57,Default,Spilik,0,0,0,,أحتاج إلى إظهار الجانب الذي أقف فيه بوضوح.
Dialogue: 0,0:21:49.57,0:21:50.74,Default,Spillie,0,0,0,,ها هو ذا.
Dialogue: 0,0:21:53.04,0:21:54.81,Default,Spilik,0,0,0,,لماذا يرتدي ملابسه الكاملة؟
Dialogue: 0,0:21:56.38,0:21:58.08,Default,Spilik,0,0,0,,كل هذه العائلات المالكة هي مثل هذه التباهي.
Dialogue: 0,0:21:58.48,0:22:00.38,Default,Spilik,0,0,0,,أظهر للملك احترامك.
Dialogue: 0,0:22:01.78,0:22:02.85,Default,Spilik,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:22:18.03,0:22:21.60,Default,Spilik,0,0,0,,لذا، أوافق على تولي سويون من عائلة كيم منصب الملكة.
Dialogue: 0,0:22:28.18,0:22:29.88,Default,Spilik,0,0,0,,تهانينا على انتخابك.
Dialogue: 0,0:22:57.74,0:22:59.04,Default,Spilyk,0,0,0,,التقطته في الطريق إلى هنا.
Dialogue: 0,0:23:04.11,0:23:05.15,Default,Spillie,0,0,0,,ملكتي.
Dialogue: 0,0:23:07.78,0:23:09.78,Default,Spillie,0,0,0,,لقد احمرت خجلاً. وتتنفس بشكل أسرع.
Dialogue: 0,0:23:10.59,0:23:12.25,Default,Spilik,0,0,0,,هل تواجه صعوبة في التنفس مرة أخرى؟
Dialogue: 0,0:23:14.06,0:23:15.86,Default,Spilik,0,0,0,,وجهي بخير، وأتنفس بشكل طبيعي.
Dialogue: 0,0:23:16.73,0:23:18.59,Default,Spillie,0,0,0,,تناول وجبة دسمة في الصباح.
Dialogue: 0,0:23:19.69,0:23:20.90,Default,Spillie,0,0,0,,اذهبي بعيدًا يا سويون.
Dialogue: 0,0:23:20.90,0:23:23.17,Default,Spilik,0,0,0,,اخرج مني... أي اخرج من هذا الجسد فوراً.
Dialogue: 0,0:23:23.17,0:23:24.70,Default,Spilik,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:23:24.93,0:23:27.10,Default,Spilik,0,0,0,,ليس لدي مكان آخر أذهب إليه.
Dialogue: 0,0:23:27.10,0:23:29.74,Default,Spilik,0,0,0,,هل هذه هي الطريقة التي تدمر بها الزهور أو جسدك؟
Dialogue: 0,0:23:30.17,0:23:32.51,Default,Spilik,0,0,0,,مرحبًا، لماذا تستمر...
Dialogue: 0,0:23:33.28,0:23:34.91,Default,Spilik,0,0,0,,-يكفي بالفعل.\N-اخرج.
Dialogue: 0,0:23:34.91,0:23:37.98,Default,Spilik,0,0,0,,لن أتخلى عنه، إنه لي!
Dialogue: 0,0:23:38.98,0:23:41.35,Default,Spilik,0,0,0,,لم أكن أعلم أنك ستحبها إلى هذه الدرجة.
Dialogue: 0,0:23:42.02,0:23:43.25,Default,Spilik,0,0,0,,لم أقل إنني أحببته.
Dialogue: 0,0:23:43.25,0:23:45.32,Default,Spilik,0,0,0,,أعتقد أنه من الأفضل البقاء هنا بدلاً من العيش في جثة.
Dialogue: 0,0:23:45.32,0:23:48.62,Default,Spilik,0,0,0,,كيف تتمكن من الاستيقاظ بشكل غريب أكثر فأكثر؟
Dialogue: 0,0:23:49.59,0:23:52.13,Default,Spilik,0,0,0,,لست الوحيد الغريب هنا. لديك الكثير من الأشياء الغريبة بنفسك.
Dialogue: 0,0:23:52.13,0:23:54.16,Default,Spilik,0,0,0,"لقد التقطتهم في الطريق إلى هنا"؟ بجد؟
Dialogue: 0,0:23:54.53,0:23:56.87,Default,Spilik,0,0,0,,هل كانوا يطاردون مثل هذه العاصفة الثلجية منذ بضعة قرون بالفعل؟
Dialogue: 0,0:23:57.20,0:23:58.53,Default,Spilik,0,0,0,,لكنني حقاً التقطتهم على الطريق.
Dialogue: 0,0:23:58.53,0:24:01.17,Default,Spikyulka,0,0,0,,حسناً، نعم، بالطبع، عظيم، برافو.
Dialogue: 0,0:24:01.17,0:24:03.31,Default,Spilik,0,0,0,,هذا صحيح.
Dialogue: 0,0:24:03.31,0:24:04.74,Default,Spilik,0,0,0,,أنا أصدق ذلك حقًا.
Dialogue: 0,0:24:05.41,0:24:07.44,Default,Spillit,0,0,0,,الملك لا يكذب أبداً.
Dialogue: 0,0:24:07.44,0:24:10.01,Default,Spilik,0,0,0,,-حسناً، نعم، حسناً، نعم، نعم، نعم.\N-ما خطبك؟
Dialogue: 0,0:24:10.01,0:24:13.18,Default,Spilik,0,0,0,,-كيف ذلك؟ ما هذا؟\N-صاحب الجلالة.
Dialogue: 0,0:24:14.58,0:24:16.59,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:24:18.19,0:24:21.69,Default,Spilik,0,0,0,,لقد باركت منزلنا المتواضع بزيارتك.
Dialogue: 0,0:24:22.16,0:24:24.39,Default,Spilik,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:24:25.09,0:24:26.96,Default,Spilik,0,0,0,,من فضلك قف.
Dialogue: 0,0:24:29.90,0:24:32.23,Default,Spilik,0,0,0,,كان عليّ أن أطمئن على ملكتي وأتأكد من أن كل شيء على ما يرام.
Dialogue: 0,0:24:32.77,0:24:35.40,Default,Spilik,0,0,0,,كيف حالك؟ هل أنت بخير؟
Dialogue: 0,0:24:35.40,0:24:37.31,Default,Spilik,0,0,0,,نعم بالطبع.
Dialogue: 0,0:24:38.07,0:24:40.44,Default,Spilik,0,0,0,,دعنا ندخل.
Dialogue: 0,0:24:41.21,0:24:42.64,Default,Spilik,0,0,0,,-بالطبع.\N-ممتاز.
Dialogue: 0,0:24:45.78,0:24:48.08,Default,Spilik,0,0,0,,ملكي، استمتع بكرم الضيافة.
Dialogue: 0,0:24:48.08,0:24:50.29,Default,Spilik,0,0,0,,وأنا بحاجة للاستعداد للعودة إلى القصر.
Dialogue: 0,0:24:50.49,0:24:52.65,Default,Spilik,0,0,0,,-لنذهب.\N-ماذا؟ هل ستغادر بالفعل؟
Dialogue: 0,0:24:53.76,0:24:55.52,Default,Spilik,0,0,0,,هل تريد العودة إلى القصر اليوم؟
Dialogue: 0,0:24:56.63,0:24:58.33,Default,Spilyk,0,0,0,,أنا أتعافى بسرعة.
Dialogue: 0,0:24:58.73,0:25:00.43,Default,Spilik,0,0,0,,حتى لو كان الأمر كذلك،
Dialogue: 0,0:25:01.06,0:25:04.03,Default,Spilyk,0,0,0,,لقد تعافيت للتو.
Dialogue: 0,0:25:04.03,0:25:05.67,Default,Spillit,0,0,0,,الأب على حق.
Dialogue: 0,0:25:06.20,0:25:09.17,Default,Spilik,0,0,0,,ليست هناك حاجة للاستعجال، أنت بحاجة إلى التعافي تمامًا.
Dialogue: 0,0:25:13.28,0:25:16.34,Default,ليلي,0,0,0,,أخشى أن يقاتل الفناء بدوني.
Dialogue: 0,0:25:17.15,0:25:18.88,Default,ليلي,0,0,0,,كل شيء هادئ في الفناء.
Dialogue: 0,0:25:18.88,0:25:20.92,Default,ليلي,0,0,0,,أكثر هدوءاً مما كنت عليه عندما كنت في القصر.
Dialogue: 0,0:25:22.95,0:25:24.32,Default,ليلي,0,0,0,,أكثر هدوءاً.
Dialogue: 0,0:25:25.49,0:25:26.62,Default,ليلي,0,0,0,,عذراً.
Dialogue: 0,0:25:28.12,0:25:29.72,Default,ليلي,0,0,0,,لقد بذلت قصارى جهدي،
Dialogue: 0,0:25:30.79,0:25:33.56,Default,Lily,0,0,0,,لكن يبدو أنك غير سعيدة معي.
Dialogue: 0,0:25:33.70,0:25:36.13,Default,Lily,0,0,0,,-نعم، أنا...\N-أنت معتاد على القصر بالفعل
Dialogue: 0,0:25:36.77,0:25:39.00,Default,ليلي,0,0,0,,وقضاء بعض الوقت مع والدي
Dialogue: 0,0:25:39.00,0:25:41.24,Default,ليلي,0,0,0,,أنت لا تحب ذلك على الإطلاق.
Dialogue: 0,0:25:41.57,0:25:43.00,Default,ليلي,0,0,0,,الله.
Dialogue: 0,0:25:44.77,0:25:48.78,Default,ليلي,0,0,0,,ركزت على الوفاء بواجب الملكة
Dialogue: 0,0:25:49.24,0:25:51.45,Default,Lily,0,0,0,,ولم أفكر في مشاعرك على الإطلاق يا أبي.
Dialogue: 0,0:25:52.08,0:25:55.35,Default,ليلي,0,0,0,,سأعود إلى القصر غداً.
Dialogue: 0,0:25:57.05,0:26:01.06,Default,Lily,0,0,0,,إذا كان الأمر كذلك، فأنا أدعوكما إلى بيت الضيافة.
Dialogue: 0,0:26:04.83,0:26:05.93,Default,ليلي,0,0,0,,وقعت في خدعة.
Dialogue: 0,0:26:07.26,0:26:08.36,Default,ليلي,0,0,0,,لنذهب.
Dialogue: 0,0:26:12.97,0:26:15.07,Default,ليلي,0,0,0,,ما الذي عضها الذبابة؟
Dialogue: 0,0:26:32.68,0:26:34.95,Default,Lily,0,0,0,,هناك مهمة لك.
Dialogue: 0,0:26:35.35,0:26:38.92,Default,ليلي,0,0,0,,أحضر لي شيئاً لا ينبغي أن يكون.
Dialogue: 0,0:26:44.06,0:26:47.26,Default,Lily,0,0,0,,من مخبأ في حجرة والد الملكة.
Dialogue: 0,0:26:48.50,0:26:49.50,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:26:56.34,0:26:59.61,Default,ليلي,0,0,0,,أنا سعيد لرؤيتكما هنا معًا.
Dialogue: 0,0:26:59.77,0:27:02.08,Default,Lily,0,0,0,,سعيد جدًا لدرجة أنني لا أمانع الموت.
Dialogue: 0,0:27:02.54,0:27:05.88,Default,ليلي,0,0,0,,كان ينبغي أن أزورك مبكراً. \NI'm آسف.
Dialogue: 0,0:27:06.75,0:27:08.62,Default,ليلي,0,0,0,,ليس هناك ما يستحق الاعتذار عنه.
Dialogue: 0,0:27:09.42,0:27:12.45,Default,ليلي,0,0,0,,يكفي أن أسمع،
Dialogue: 0,0:27:15.92,0:27:18.99,Default,ليلي,0,0,0,,كيف تحبون بعضكم البعض.
Dialogue: 0,0:27:22.96,0:27:25.80,Default,Lily,0,0,0,,ملكتي مختلفة جداً عن النساء الأخريات،
Dialogue: 0,0:27:25.80,0:27:28.67,Default,Lilia,0,0,0,,كنت دائمًا مهتمًا بمعرفة أين نشأت.
Dialogue: 0,0:27:30.67,0:27:32.41,Default,ليلي,0,0,0,,هذا هو المكان.
Dialogue: 0,0:27:32.71,0:27:34.98,Default,ليلي,0,0,0,,لقد ربيتها وحدي، بلا أم،
Dialogue: 0,0:27:35.24,0:27:37.08,Default,ليلي,0,0,0,,لذلك حاولت جاهداً
Dialogue: 0,0:27:37.08,0:27:39.05,Default,ليلي,0,0,0,,امنحها كل الرعاية التي تحتاجها.
Dialogue: 0,0:27:39.68,0:27:41.82,Default,ليلي,0,0,0,,لابد أن الأمر كان صعباً.
Dialogue: 0,0:27:42.32,0:27:44.49,Default,ليلي,0,0,0,,حسناً، لا على الإطلاق.
Dialogue: 0,0:27:45.12,0:27:47.29,Default,ليلي,0,0,0,,لقد قامت الملكة بعمل جيد بنفسها
Dialogue: 0,0:27:47.32,0:27:49.52,Default,ليلي,0,0,0,,منذ الصغر.
Dialogue: 0,0:27:51.33,0:27:54.86,Default,ليلي,0,0,0,,نعم، سمعت ذلك.
Dialogue: 0,0:27:55.03,0:27:57.20,Default,ليلي,0,0,0,,إلا أنها قوية ومستقلة جداً،
Dialogue: 0,0:27:57.37,0:27:59.63,Default,ليلي,0,0,0,,لأنها لم تشاركني مشاعرها.
Dialogue: 0,0:28:00.03,0:28:01.84,Default,ليلي,0,0,0,, هل أنا غبي إلى هذا الحد؟
Dialogue: 0,0:28:02.10,0:28:04.41,Default,Lily,0,0,0,,أم أنه من المستحيل فهم ما يدور في ذهن المرأة؟
Dialogue: 0,0:28:04.91,0:28:08.14,Default,ليلي,0,0,0,,من الصعب للغاية بالنسبة لي أن أفهمها.
Dialogue: 0,0:28:08.14,0:28:11.61,Default,Lily,0,0,0,,يا إلهي، هذا بالتأكيد ليس بسبب نقص الذكاء.
Dialogue: 0,0:28:11.75,0:28:13.88,Default,Lily,0,0,0,,يجد جميع الرجال صعوبة في فهم النساء.
Dialogue: 0,0:28:14.08,0:28:17.45,Default,Lily,0,0,0,,إنها معقدة مثل تعاليم بوذا.
Dialogue: 0,0:28:18.52,0:28:19.95,Default,ليلي,0,0,0,,لا تحاول أن تفهم.
Dialogue: 0,0:28:20.32,0:28:23.46,Default,Lily,0,0,0,,العلاقات الزوجية تتكون من سوء الفهم.
Dialogue: 0,0:28:25.09,0:28:26.43,Default,ليلي,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:28:27.20,0:28:28.70,Default,ليلي,0,0,0,,لا يوجد سوء تفاهم
Dialogue: 0,0:28:28.70,0:28:31.40,Default,ليلي,0,0,0,,الناس لن يتزوجوا على الإطلاق.
Dialogue: 0,0:28:36.00,0:28:39.14,Default,ليلي,0,0,0,,أريد أن أعرف كل شيء عنك.
Dialogue: 0,0:28:43.48,0:28:45.05,Default,ليلي,0,0,0,,توقف عن هذا.
Dialogue: 0,0:28:45.05,0:28:46.61,Default,ليلي,0,0,0,,أريد رؤية المنزل،
Dialogue: 0,0:28:46.61,0:28:48.22,Default,ليليا,0,0,0,,التي نشأت فيها.
Dialogue: 0,0:28:48.22,0:28:49.52,Default,ليلي,0,0,0,,هل يمكنني أن أفعل هذا؟
Dialogue: 0,0:28:49.95,0:28:52.69,Default,Lily,0,0,0,,سأكون سعيداً بالتنزه مع الملكة واللحاق بها.
Dialogue: 0,0:28:52.95,0:28:55.49,Default,Lily,0,0,0,,هذا منزل عادي لتاجر.
Dialogue: 0,0:28:55.49,0:28:56.93,Default,ليلي,0,0,0,,لا شيء مميز،
Dialogue: 0,0:28:56.93,0:28:59.86,Default,Lily,0,0,0,,لكنني سأكون سعيداً بأن أعرض عليك كل شيء هنا.
Dialogue: 0,0:29:00.73,0:29:02.20,Default,ليلي,0,0,0,,ثم نذهب معًا.
Dialogue: 0,0:29:02.20,0:29:04.40,Default,ليلي,0,0,0,,يجب أن تأتي الملكة معي.
Dialogue: 0,0:29:06.10,0:29:08.64,Default,ليلي,0,0,0,,لم نرى بعضنا البعض لليلة واحدة،
Dialogue: 0,0:29:09.37,0:29:11.67,Default,Lily,0,0,0,,لكنني أفتقدك حتى عندما أنظر إليك.
Dialogue: 0,0:29:14.04,0:29:15.64,Default,ليلي,0,0,0,,لديك شيء عالق.
Dialogue: 0,0:29:15.98,0:29:17.71,Default,ليلي,0,0,0,,هذا شامة.
Dialogue: 0,0:29:20.85,0:29:23.79,Default,ليلي,0,0,0,,بدا لي أنك مختلفة اليوم.
Dialogue: 0,0:29:26.42,0:29:29.22,Default,ليلي,0,0,0,,يجب أن تأتي معنا.
Dialogue: 0,0:29:29.99,0:29:31.09,Default,ليلي,0,0,0,,دعنا نذهب؟
Dialogue: 0,0:29:31.59,0:29:35.30,Default,ليلي,0,0,0,,انتظر. أنتما الإثنان خذا وقتكما.
Dialogue: 0,0:29:37.80,0:29:41.54,Default,Lily,0,0,0,,سوف أتحقق من تنظيف جميع الغرف.
Dialogue: 0,0:29:47.08,0:29:48.21,Default,ليلي,0,0,0,,عذراً.
Dialogue: 0,0:29:52.01,0:29:53.18,Default,ليلي,0,0,0,,ماذا تفعلين؟
Dialogue: 0,0:29:53.25,0:29:54.88,Default,ليلي,0,0,0,,المسافة، ألا تتذكرين؟
Dialogue: 0,0:29:54.88,0:29:58.89,Default,Lily,0,0,0,,كلما فكرت لفترة أطول، أصبحت العبارة ذات معنى أكبر.
Dialogue: 0,0:29:59.42,0:30:01.32,Default,Lily,0,0,0,,حتى لو لم نتفق على كل شيء،
Dialogue: 0,0:30:01.76,0:30:03.86,Default,ليلي,0,0,0,,يمكننا أن نتعايش بسعادة.
Dialogue: 0,0:30:04.43,0:30:06.36,Default,ليلي,0,0,0,,هذا رائع، أليس كذلك؟
Dialogue: 0,0:30:07.53,0:30:09.23,Default,ليلي,0,0,0,,قبول اختلافاتنا
Dialogue: 0,0:30:09.23,0:30:12.20,Default,ليلي,0,0,0,,والتغلب عليهم.
Dialogue: 0,0:30:12.20,0:30:13.97,Default,ليلي,0,0,0,,هل أصبحت فيلسوفاً؟
Dialogue: 0,0:30:13.97,0:30:16.24,Default,ليلي,0,0,0,,إلى أين أخذك "التباعد"؟
Dialogue: 0,0:30:17.21,0:30:21.14,Default,ليلي,0,0,0,,أوه، بالضبط. بعد كل شيء، أنت سياسي.
Dialogue: 0,0:30:22.74,0:30:25.15,Default,Lily,0,0,0,,لقد رأيت مدى سعادة والدي عندما رآنا معًا.
Dialogue: 0,0:30:25.15,0:30:28.65,Default,Lily,0,0,0,,أحاول أن أكون صهراً جيداً، ساعدوني.
Dialogue: 0,0:30:31.95,0:30:33.25,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:30:49.30,0:30:52.44,Default,Lily,0,0,0,,يبدو جميع الخدم أقوياء بشكل غير عادي
Dialogue: 0,0:30:52.44,0:30:53.94,Default,ليلى,0,0,0,,ومهارة.
Dialogue: 0,0:30:54.28,0:30:57.08,Default,Lily,0,0,0,,إنهم يعرفون تخطيط المنزل مثل ظهر أيديهم.
Dialogue: 0,0:30:57.08,0:30:59.98,Default,ليلي,0,0,0,,-دعنا نذهب.\N-بالطبع.
Dialogue: 0,0:31:10.73,0:31:13.83,Default,Lily,0,0,0,,أنا سعيد لأنني طلبت منك إظهار كل شيء هنا.
Dialogue: 0,0:31:15.90,0:31:18.50,Default,Lily,0,0,0,,بالطبع، هناك أشياء ثمينة جداً هنا.
Dialogue: 0,0:31:18.87,0:31:20.64,Default,ليلي,0,0,0,,لذا. هنا، على سبيل المثال.
Dialogue: 0,0:31:21.40,0:31:24.24,Default,Lily,0,0,0,,خزف أبيض وشاشة قابلة للطي.
Dialogue: 0,0:31:24.54,0:31:27.28,Default,ليلي,0,0,0,,لم أفهمهم بسهولة.
Dialogue: 0,0:31:29.71,0:31:31.95,Default,ليلي,0,0,0,,هل يمكنني إلقاء نظرة فاحصة؟
Dialogue: 0,0:31:31.95,0:31:33.58,Default,ليلي,0,0,0,,نعم بالطبع.
Dialogue: 0,0:31:33.58,0:31:35.45,Default,ليلي,0,0,0,,انظر هنا...
Dialogue: 0,0:31:40.46,0:31:43.93,Default,Lily,0,0,0,,لا يوجد شيء مثير للاهتمام على الجانب الآخر.
Dialogue: 0,0:31:44.19,0:31:47.63,Default,Lily,0,0,0,,حتى الجانب الخلفي من العمل الفني يبدو رائعاً.
Dialogue: 0,0:31:51.43,0:31:52.83,Default,ليلي,0,0,0,,كوني حذرة أيتها الملكة.
Dialogue: 0,0:31:53.60,0:31:56.87,Default,ليلي,0,0,0,,-ما الأمر؟\N-إلى جمالك المبهر
Dialogue: 0,0:31:56.87,0:31:58.81,Default,Lily,0,0,0,,حتى النحل يتدفق.
Dialogue: 0,0:31:59.17,0:32:01.81,Default,ليلي,0,0,0,,-النحل؟\N-أين؟
Dialogue: 0,0:32:01.81,0:32:03.54,Default,ليلي,0,0,0,,-أين؟\N-هناك.
Dialogue: 0,0:32:03.85,0:32:05.35,Default,ليلي,0,0,0,,-كن حذراً.\N-لا يوجد نحل هنا.
Dialogue: 0,0:32:07.02,0:32:08.35,Default,ليلي,0,0,0,,-أين؟ أين هم؟\N-God.
Dialogue: 0,0:32:09.62,0:32:11.35,Default,Lily,0,0,0,,-أين هم؟\N-يبدو أنهم طاروا بعيداً.
Dialogue: 0,0:32:14.36,0:32:16.56,Default,Lily,0,0,0,,يا ملكتي، ماذا يمكنك أن تقولي عن الشاشة؟
Dialogue: 0,0:32:20.83,0:32:25.50,Default,Lily,0,0,0,,ضربات قوية، ورسم مناظر طبيعية رائعة.
Dialogue: 0,0:32:25.77,0:32:27.20,Default,ليلي,0,0,0,,عزيزتي، على ما أعتقد.
Dialogue: 0,0:32:28.97,0:32:32.94,Default,Lily,0,0,0,,ربما تخشى أن تُسرق مقتنياتك الثمينة.
Dialogue: 0,0:32:34.54,0:32:37.98,Default,Lily,0,0,0,,أنا متأكد من أن لديك الكثير من الحراس لحراستهم ليلاً.
Dialogue: 0,0:32:39.88,0:32:42.75,Default,ليلي,0,0,0,,لا، ليس لدي حارس.
Dialogue: 0,0:32:43.65,0:32:46.55,Default,Lily,0,0,0,,أشبه بالحراس المستأجرين هذه الأيام
Dialogue: 0,0:32:46.59,0:32:49.46,Default,ليلي,0,0,0,,سوف تسرق ما من المفترض أن تحميه.
Dialogue: 0,0:32:50.09,0:32:51.26,Default,ليلي,0,0,0,,ثم كيف؟
Dialogue: 0,0:32:51.43,0:32:54.30,Default,Lily,0,0,0,,لقد قمت بتدريب العديد من الخدم الذين يعملون عندي،
Dialogue: 0,0:32:54.30,0:32:56.46,Default,ليلي,0,0,0,,التي أثق بها،
Dialogue: 0,0:32:56.46,0:32:58.37,Default,ليلي,0,0,0,,يؤدون واجبات الحراسة.
Dialogue: 0,0:32:58.37,0:33:01.00,Default,Lily,0,0,0,,إنها أرخص من استئجار حراس مدربين.
Dialogue: 0,0:33:03.34,0:33:04.91,Default,ليلي,0,0,0,,أنت حكيمة جداً.
Dialogue: 0,0:33:05.07,0:33:07.28,Default,Lily,0,0,0,,كم عدد هؤلاء الخدم لديك؟
Dialogue: 0,0:33:10.68,0:33:14.55,Default,ليلي,0,0,0,,هذه معلومات سرية.
Dialogue: 0,0:33:16.25,0:33:19.59,Default,ليلي,0,0,0,, إذًا ليس عليك أن تخبرني.
Dialogue: 0,0:33:21.06,0:33:22.82,Default,ليلي,0,0,0,,ومع ذلك، ملكتي تبقى هنا،
Dialogue: 0,0:33:23.42,0:33:24.73,Default,ليلي,0,0,0,,أنا قلقة.
Dialogue: 0,0:33:25.06,0:33:26.49,Default,ليلي,0,0,0,,ملكتي؟
Dialogue: 0,0:33:29.83,0:33:31.97,Default,ليلي,0,0,0,,26-27 في مكان ما.
Dialogue: 0,0:33:33.47,0:33:37.51,Default,Lily,0,0,0,,لا يمكن أن تكون هناك أسرار بيننا.
Dialogue: 0,0:33:40.98,0:33:44.51,Default,Lily,0,0,0,,لديك عدد كافٍ من الأشخاص للدفاع عن عقار من 9 غرف.
Dialogue: 0,0:33:45.11,0:33:47.01,Default,ليلي,0,0,0,,كلماتك هدأتني.
Dialogue: 0,0:33:47.62,0:33:49.75,Default,ليلي,0,0,0,,كنت أشك فيما إذا كان لديك كتب قديمة،
Dialogue: 0,0:33:49.75,0:33:51.85,Default,ليلي,0,0,0,,مؤرخة قبل قرنين من الزمن.
Dialogue: 0,0:33:52.42,0:33:56.82,Default,Lily,0,0,0,,المال وحده لا يكفي لامتلاك مثل هذه الكتب.
Dialogue: 0,0:33:57.19,0:33:59.33,Default,ليلي,0,0,0,,سوف تتفاجأ جدًا.
Dialogue: 0,0:33:59.69,0:34:02.10,Default,ليلي,0,0,0,,حقاً؟ متفاجئ؟
Dialogue: 0,0:34:08.20,0:34:09.94,Default,Lily,0,0,0,,في الطريق إلى المكتبة ستشاهدين
Dialogue: 0,0:34:09.94,0:34:11.67,Default,ليلي,0,0,0,,شجرة الصنوبر المظلة التي رعيتها.
Dialogue: 0,0:34:12.27,0:34:16.34,Default,Lily,0,0,0,,شكل تاجها يشبه طائر الفينيق.
Dialogue: 0,0:34:18.05,0:34:21.32,Default,Lily,0,0,0,,سمعت أنك إذا زرعت شجرة،
Dialogue: 0,0:34:21.32,0:34:23.48,Default,Lily,0,0,0,,ستظهر ملكة في العائلة.
Dialogue: 0,0:34:26.12,0:34:27.92,Default,Lily,0,0,0,,لقد نجحت الإشارة.
Dialogue: 0,0:34:27.92,0:34:30.16,Default,ليلي,0,0,0,,لقد أوشكت على الوصول. اتبعني.
Dialogue: 0,0:34:31.16,0:34:32.73,Default,ليلي,0,0,0,,صنوبر الشيطان.
Dialogue: 0,0:34:32.73,0:34:34.76,Default,Lily,0,0,0,,سأستخدمه هذا الشتاء كحطب.
Dialogue: 0,0:34:35.73,0:34:39.13,Default,Lily,0,0,0,,يسعدني سماع تعليقاتك الوقحة والمتغطرسة مرة أخرى.
Dialogue: 0,0:34:40.74,0:34:42.80,Default,Lily,0,0,0,,في البداية، عندما تغيرت،
Dialogue: 0,0:34:43.37,0:34:45.07,Default,Lily,0,0,0,,اعتقدت أنك تسيء استخدام السلطة.
Dialogue: 0,0:34:45.81,0:34:47.31,Default,ليلي,0,0,0,,ظننتك مع أقاربك
Dialogue: 0,0:34:47.81,0:34:49.64,Default,ليلي,0,0,0,,تحاول أن تدوسني.
Dialogue: 0,0:34:50.41,0:34:51.51,Default,ليلي,0,0,0,,سوء فهم.
Dialogue: 0,0:34:51.85,0:34:53.05,Default,ليلي,0,0,0,,وأنت فقط...
Dialogue: 0,0:34:54.15,0:34:55.18,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:34:55.62,0:34:57.52,Default,ليلي,0,0,0,,مجرد متعجرفة.
Dialogue: 0,0:34:58.95,0:35:02.09,Default,ليلي,0,0,0,,أنا من عائلة ثرية. أستطيع تحمله.
Dialogue: 0,0:35:02.79,0:35:05.99,Default,Lily,0,0,0,,لم أكن أمزح عندما قلت إنني أريد أن أفهمك.
Dialogue: 0,0:35:07.50,0:35:09.10,Default,ليلي,0,0,0,,أريد أن أعرف،
Dialogue: 0,0:35:09.10,0:35:13.60,Default,ليلي,0,0,0,,كيف أصبحت امرأة من عائلة نبيلة مثلك في جوسون.
Dialogue: 0,0:35:14.84,0:35:16.30,Default,ليلي,0,0,0,,لا تحاول حتى.
Dialogue: 0,0:35:16.77,0:35:19.61,Default,Lily,0,0,0,,لا يمكن لامرأة مثلي أن توجد في جوسون.
Dialogue: 0,0:35:20.44,0:35:22.74,Default,Lily,0,0,0,"أنا الأقوى في هذا العالم."
Dialogue: 0,0:35:23.21,0:35:24.78,Default,ليلي,0,0,0,,أنت متغطرسة بالتأكيد.
Dialogue: 0,0:35:38.09,0:35:39.23,Default,ليلي,0,0,0,,هذا مؤلم.
Dialogue: 0,0:35:51.61,0:35:52.91,Default,ليلي,0,0,0,,عودة الملك إلى العرش بعد الإطاحة
Dialogue: 0,0:35:52.91,0:35:54.18,Default,ليلي,0,0,0,,عودة الملك إلى العرش بعد الإطاحة
Dialogue: 0,0:36:20.27,0:36:21.60,Default,ليلي,0,0,0,,ماذا حدث لك؟
Dialogue: 0,0:36:24.87,0:36:25.94,Default,ليلي,0,0,0,,لا شيء.
Dialogue: 0,0:36:27.38,0:36:28.41,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:36:28.41,0:36:32.48,Default,ليلي,0,0,0,,لقد تدهورت صحته بسبب قلقه عليك.
Dialogue: 0,0:36:32.68,0:36:35.65,Default,Lily,0,0,0,,سأطلب المساعدة لأخذك إلى الداخل.
Dialogue: 0,0:36:35.65,0:36:37.35,Default,ليلي,0,0,0,,اعتني به حتى أعود.
Dialogue: 0,0:36:49.10,0:36:50.23,Default,ليلي,0,0,0,,ماذا تفعلين؟
Dialogue: 0,0:36:51.00,0:36:52.87,Default,ليلي,0,0,0,,هل رأيت شبحاً؟
Dialogue: 0,0:36:58.27,0:36:59.61,Default,ليلي,0,0,0,,رائحة الرطوبة...
Dialogue: 0,0:37:03.34,0:37:04.48,Default,ليلي,0,0,0,,أنقذيني.
Dialogue: 0,0:37:04.48,0:37:07.85,Default,ليلي,0,0,0,,إنه خطأي. أنا المسؤول عن الموت.
Dialogue: 0,0:37:11.12,0:37:12.32,Default,ليلي,0,0,0,,في هذه البئر...
Dialogue: 0,0:37:25.60,0:37:26.63,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:37:57.57,0:37:59.60,Default,ليلي,0,0,0,,ساعد الملك. اسرع.
Dialogue: 0,0:38:00.40,0:38:01.97,Default,ليلي,0,0,0,,رئيسة المحظيات؟
Dialogue: 0,0:38:03.10,0:38:04.57,Default,ليلي,0,0,0,,ماذا حدث؟
Dialogue: 0,0:38:04.91,0:38:06.31,Default,ليلي,0,0,0,,لقد أصبحت شاحباً.
Dialogue: 0,0:38:07.24,0:38:08.31,Default,ليلي,0,0,0,,حقاً...
Dialogue: 0,0:38:10.95,0:38:13.95,Default,ليلي,0,0,0,,أبي، رافق الملك إلى الداخل.
Dialogue: 0,0:38:16.35,0:38:20.82,Default,Lily,0,0,0,,يبدو أن المحظية أتت للتحدث معي.
Dialogue: 0,0:38:21.46,0:38:23.69,Default,ليلي,0,0,0,,لقد جئت إلى هنا قلقاً بشأن صحتك.
Dialogue: 0,0:38:23.82,0:38:25.83,Default,Lily,0,0,0,,ولكن يبدو أن الملك يشعر بالسوء.
Dialogue: 0,0:38:25.99,0:38:27.50,Default,ليلي,0,0,0,,ماذا حدث؟
Dialogue: 0,0:38:27.50,0:38:30.13,Default,ليلي,0,0,0,,لم أنم الليلة الماضية.
Dialogue: 0,0:38:30.87,0:38:33.30,Default,ليلي,0,0,0,,شعرت بالدوار للحظة.
Dialogue: 0,0:38:33.30,0:38:35.57,Default,ليلي,0,0,0,,سأرافقك إلى بيت الضيافة.
Dialogue: 0,0:38:35.57,0:38:36.87,Default,Lily,0,0,0,,لقد تم استدعاء الطبيب بالفعل.
Dialogue: 0,0:38:37.37,0:38:39.24,Default,ليلي,0,0,0,,لست بحاجة إلى معالج.
Dialogue: 0,0:38:39.74,0:38:42.31,Default,ليلي,0,0,0,,سأرتاح وسيكون كل شيء على ما يرام.
Dialogue: 0,0:38:43.31,0:38:45.55,Default,ليلي,0,0,0,,-أسرع. مساعدة صاحب الجلالة.\N-Okay.
Dialogue: 0,0:38:49.18,0:38:50.38,Default,,0,0,0,,الحذر.
Dialogue: 0,0:39:02.13,0:39:03.53,Default,,0,0,0,,كن حذراً.
Dialogue: 0,0:39:11.31,0:39:12.81,Default,,0,0,0,,يمكنك الذهاب.
Dialogue: 0,0:39:18.31,0:39:19.78,Default,,0,0,0,,هل ترغب في الاستلقاء؟
Dialogue: 0,0:39:20.35,0:39:21.38,Default,,0,0,0,,لا.
Dialogue: 0,0:39:22.78,0:39:24.85,Default,,0,0,0,,سأجلس لبعض الوقت وأرتاح.
Dialogue: 0,0:39:27.05,0:39:32.23,Default,,0,0,0,,سمعت أنك لا تتذكر الكثير عن الوقت الذي أمضيته في هانيانغ،
Dialogue: 0,0:39:32.23,0:39:34.43,Default,,0,0,0,,كنت صغيراً جداً في ذلك الوقت.
Dialogue: 0,0:39:37.77,0:39:39.87,Default,,0,0,0,,كنت لا أزال طفلاً في ذلك الوقت.
Dialogue: 0,0:39:41.34,0:39:43.77,Default,,0,0,0,,بسبب حدث غير سار، غادرت هانيانغ.
Dialogue: 0,0:39:44.64,0:39:46.57,Default,,0,0,0,,لا أتذكر الكثير.
Dialogue: 0,0:39:46.94,0:39:48.04,Default,,0,0,0,,يا لها من راحة.
Dialogue: 0,0:39:50.21,0:39:54.05,Default,,0,0,0,,أي أنني أردت أن أقول إنه من الأفضل أن نترك الأمر.
Dialogue: 0,0:39:54.05,0:39:55.78,Default,,0,0,0,,ذكريات سيئة.
Dialogue: 0,0:39:58.52,0:40:00.29,Default,,0,0,0,,أعتقد ذلك أيضاً.
Dialogue: 0,0:40:05.86,0:40:08.46,Default,,0,0,0,,فتح هذا الأحمق صندوق باندورا.
Dialogue: 0,0:40:10.40,0:40:12.47,Default,,0,0,0,,أنت لست كما يقولون.
Dialogue: 0,0:40:13.73,0:40:15.30,Default,,0,0,0,,لكنني مازلت أشك في ذلك.
Dialogue: 0,0:40:17.30,0:40:20.47,Default,,0,0,0,,لا تقلق. لم أخبره بأي شيء.
Dialogue: 0,0:40:23.51,0:40:25.21,Default,,0,0,0,,أليس هذا سبب وجودك هنا؟
Dialogue: 0,0:40:25.21,0:40:26.78,Default,,0,0,0,,وماذا تريد؟
Dialogue: 0,0:40:27.15,0:40:29.58,Default,,0,0,0,,لقد استدرجته إلى هنا لسبب ما.
Dialogue: 0,0:40:32.05,0:40:34.32,Default,,0,0,0,,أردت حقاً أن أكون معك.
Dialogue: 0,0:40:35.09,0:40:37.36,Default,,0,0,0,,لقد كنت أملي الأخير.
Dialogue: 0,0:40:37.66,0:40:39.29,Default,,0,0,0,,بينما أردتك،
Dialogue: 0,0:40:39.29,0:40:41.10,Default,,0,0,0,,يمكنني أن أكون على طبيعتي.
Dialogue: 0,0:40:43.30,0:40:47.30,Default,,0,0,0,,لكنني اكتشفت حقيقتك.
Dialogue: 0,0:40:48.44,0:40:49.57,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:40:53.47,0:40:55.64,Default,,0,0,0,,عن كونك كيم سو يون المزيفة.
Dialogue: 0,0:40:58.68,0:41:00.15,Default,,0,0,0,,لقد اتصلت بي
Dialogue: 0,0:41:01.22,0:41:02.82,Default,,0,0,0,,مزيف؟
Dialogue: 0,0:41:04.49,0:41:05.65,Default,,0,0,0,,تذكرت كل شيء.
Dialogue: 0,0:41:05.95,0:41:08.56,Default,,0,0,0,,يبدو أنك أظهرت ألوانك الحقيقية.
Dialogue: 0,0:41:11.36,0:41:14.36,Default,,0,0,0,,سوف أساعدك، لأن هرموناتي كانت تشتعل معك.
Dialogue: 0,0:41:14.80,0:41:16.56,Default,,0,0,0,,اعترف للملك بكل شيء.
Dialogue: 0,0:41:16.86,0:41:19.00,Default,,0,0,0,,سيكون مؤلماً له أن يعلم بهذا الأمر من شخص آخر.
Dialogue: 0,0:41:19.00,0:41:20.17,Default,,0,0,0,,هل تهددني؟
Dialogue: 0,0:41:21.54,0:41:24.94,Default,,0,0,0,,لقد سمعتك بوضوح.
Dialogue: 0,0:41:28.98,0:41:31.58,Default,,0,0,0,,جلالتك، أحضرت لك بعض الوجبات الخفيفة.
Dialogue: 0,0:41:37.69,0:41:39.82,Default,,0,0,0,,ما مدى صعوبة الوصول إليها.
Dialogue: 0,0:41:40.62,0:41:42.49,Default,,0,0,0,,تتمسك بعلاقة معقدة،
Dialogue: 0,0:41:42.49,0:41:45.03,Default,,0,0,0,,فاحترت في نفسي. فتاة مدللة.
Dialogue: 0,0:41:46.43,0:41:47.49,Default,,0,0,0,,تفضل بالدخول.
Dialogue: 0,0:42:00.61,0:42:01.64,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:42:03.81,0:42:05.78,Default,,0,0,0,,هل تحدثت معها بعد؟
Dialogue: 0,0:42:07.38,0:42:08.95,Default,,0,0,0,,اتركنا للحظة.
Dialogue: 0,0:42:11.92,0:42:13.15,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:42:13.15,0:42:15.96,Default,,0,0,0,,آسف لجعلك تقلق بشأن تفاهات.
Dialogue: 0,0:42:18.59,0:42:22.36,Default,,0,0,0,,لا داعي للإجراءات الشكلية، نحن وحدنا هنا.
Dialogue: 0,0:42:25.00,0:42:28.50,Default,,0,0,0,,يا صاحب الجلالة،\Nلقد تعافت الملكة بالكامل.
Dialogue: 0,0:42:28.77,0:42:30.37,Default,,0,0,0,,دعونا نعود إلى القصر.
Dialogue: 0,0:42:30.37,0:42:31.41,Default,,0,0,0,,لا أستطيع.
Dialogue: 0,0:42:33.61,0:42:35.24,Default,,0,0,0,,أحتاج إلى دراسة شيء ما.
Dialogue: 0,0:42:38.85,0:42:40.51,Default,,0,0,0,,هل هناك شيء للدراسة؟
Dialogue: 0,0:42:41.85,0:42:42.95,Default,,0,0,0,,ماذا بالضبط؟
Dialogue: 0,0:42:47.45,0:42:48.76,Default,,0,0,0,,عذراً.
Dialogue: 0,0:42:49.22,0:42:51.13,Default,,0,0,0,,سامحني على سوء أخلاقي.
Dialogue: 0,0:42:52.29,0:42:55.80,Default,,0,0,0,,لقد جهزت لك غرفة. دعني آخذك.
Dialogue: 0,0:42:56.83,0:42:58.97,Default,,0,0,0,,يجب أن أعود إلى القصر.
Dialogue: 0,0:43:02.50,0:43:05.34,Default,,0,0,0,,حسناً، سأكون في انتظارك في القصر.
Dialogue: 0,0:43:05.67,0:43:06.87,Default,,0,0,0,,اعتني بنفسك.
Dialogue: 0,0:44:09.88,0:44:11.35,Default,,0,0,0,,كان جده الأمير إيونونغ.
Dialogue: 0,0:44:11.68,0:44:15.09,Default,,0,0,0,,اتُهم بالخيانة ونفي وأُعدم.
Dialogue: 0,0:44:15.92,0:44:17.35,Default,,0,0,0,,كان والده الأمير جيونغي.
Dialogue: 0,0:44:17.35,0:44:19.02,Default,,0,0,0,,عاش في المنفى مع والده،
Dialogue: 0,0:44:19.02,0:44:20.79,Default,,0,0,0,,مرضت وماتت.
Dialogue: 0,0:44:20.89,0:44:23.69,Default,,0,0,0,,قُتلت جدته وعمته بسبب تعميدهما،
Dialogue: 0,0:44:24.39,0:44:26.00,Default,,0,0,0,,الأخ غير الشقيق لـ Lee Won-kyung
Dialogue: 0,0:44:26.00,0:44:27.50,Default,,0,0,0,,قُتل بتهمة الخيانة.
Dialogue: 0,0:44:28.40,0:44:30.20,Default,,0,0,0,,هذا ليس برنامجًا تلفزيونيًا.
Dialogue: 0,0:44:33.24,0:44:35.57,Default,,0,0,0,,لماذا مات كل فرد في عائلته؟
Dialogue: 0,0:44:41.68,0:44:43.75,Default,,0,0,0,,لماذا تنظر إليّ هكذا؟
Dialogue: 0,0:44:44.41,0:44:46.75,Default,,0,0,0,,كيف أبدو؟
Dialogue: 0,0:44:47.62,0:44:49.82,Default,,0,0,0,,كما لو أنني كلب صغير مثير للشفقة.
Dialogue: 0,0:44:51.05,0:44:53.96,Default,,0,0,0,,لا داعي للابتسام. أنا قلقة عليك.
Dialogue: 0,0:44:54.56,0:44:58.10,Default,,0,0,0,,على ما يبدو، هذا هو السبب وراء ضرر التعليم المبكر فقط.
Dialogue: 0,0:44:58.36,0:44:59.93,Default,,0,0,0,,يا لها من معرفة عديمة الفائدة!
Dialogue: 0,0:45:01.90,0:45:04.00,Default,,0,0,0,,أنت. ماذا تريد مني
Dialogue: 0,0:45:04.00,0:45:05.17,Default,,0,0,0,,لماذا التزمت بي؟
Dialogue: 0,0:45:06.17,0:45:08.14,Default,,0,0,0,,ماذا أريد منك؟
Dialogue: 0,0:45:08.81,0:45:13.24,Default,,0,0,0,,إذا تدخلت الملكة فجأة في خططنا،
Dialogue: 0,0:45:16.08,0:45:19.62,Default,,0,0,0,,سأقطع رأسها بنفسي.
Dialogue: 0,0:45:21.69,0:45:24.59,Default,,0,0,0,,أريدك ألا تتدخل معي.
Dialogue: 0,0:45:25.96,0:45:28.79,Default,,0,0,0,,ليس عليك مساعدتي. فقط
Dialogue: 0,0:45:29.53,0:45:31.23,Default,,0,0,0,,لا تصبح عدوي.
Dialogue: 0,0:45:34.73,0:45:36.40,Default,,0,0,0,,ولديك عين مدربة.
Dialogue: 0,0:45:36.40,0:45:38.64,Default,,0,0,0,,قد لا أتمكن من المساعدة كثيرًا في أي شيء،
Dialogue: 0,0:45:38.64,0:45:40.07,Default,,0,0,0,,لكنني كعدو فظيع.
Dialogue: 0,0:45:40.07,0:45:41.51,Default,,0,0,0,,سأمسك بك ولن أتركك.
Dialogue: 0,0:45:43.61,0:45:44.68,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:45:50.31,0:45:52.62,Default,,0,0,0,,لقد أتت كيم بيونين إليك.
Dialogue: 0,0:46:09.83,0:46:12.24,Default,,0,0,0,,كم عدد ضيوفي اليوم.
Dialogue: 0,0:46:12.94,0:46:14.77,Default,,0,0,0,,يأتي الناس إلي وكأنني ذاهب إلى مطعم.
Dialogue: 0,0:46:25.15,0:46:26.58,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:46:26.65,0:46:28.62,Default,,0,0,0,,جيد جدًا، على ما أعتقد.
Dialogue: 0,0:46:30.15,0:46:31.39,Default,,0,0,0,,هل هناك مشاكل؟
Dialogue: 0,0:46:31.66,0:46:33.29,Default,,0,0,0,,لماذا رئيس قسم المباحث هنا؟
Dialogue: 0,0:46:33.96,0:46:36.69,Default,,0,0,0,,بينما الملك والملكة هنا،
Dialogue: 0,0:46:36.93,0:46:39.03,Default,,0,0,0,,ينبغي أن يكون هنا مثل القصر.
Dialogue: 0,0:46:39.33,0:46:40.50,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:46:41.33,0:46:44.07,Default,,0,0,0,,من الآن فصاعداً، أنت تحت حماية قسم المباحث.
Dialogue: 0,0:46:45.30,0:46:49.11,Default,,0,0,0,,أحضرت معي الحرس الملكي، ليس لديك ما يدعو للقلق.
Dialogue: 0,0:46:51.21,0:46:53.81,Default,,0,0,0,,إذن ستكون تحت حماية الحرس الملكي،
Dialogue: 0,0:46:53.81,0:46:56.55,Default,,0,0,0,,وسوف نحمي الملكة.
Dialogue: 0,0:46:56.98,0:46:58.98,Default,,0,0,0,,هل هناك الكثير من الأشخاص؟
Dialogue: 0,0:46:58.98,0:47:01.45,Default,,0,0,0,,ثم يمكنك استدعاء الحرس الملكي.
Dialogue: 0,0:47:14.20,0:47:16.83,Default,,0,0,0,,أنت تقف في المكان الخطأ.
Dialogue: 0,0:47:17.07,0:47:19.00,Default,,0,0,0,,لحمايتنا،
Dialogue: 0,0:47:20.10,0:47:21.94,Default,,0,0,0,,انظر حولك، وليس إلينا.
Dialogue: 0,0:47:29.11,0:47:33.08,Default,,0,0,0,,على ما يبدو أن قدري هو أن أكون محاطاً بمن ينظرون إلي.
Dialogue: 0,0:47:44.46,0:47:45.63,Default,,0,0,0,,من هذا؟
Dialogue: 0,0:48:02.38,0:48:03.51,Default,,0,0,0,,كل شيء على ما يرام؟
Dialogue: 0,0:48:06.45,0:48:08.82,Default,,0,0,0,,انتظر، هذا...
Dialogue: 0,0:48:10.45,0:48:11.69,Default,,0,0,0,,لماذا هو هنا؟
Dialogue: 0,0:48:13.36,0:48:14.56,Default,,0,0,0,,هل تعرفينه؟
Dialogue: 0,0:48:15.99,0:48:18.20,Default,,0,0,0,,عد إلى رشدك، واستيقظ.
Dialogue: 0,0:48:21.13,0:48:22.37,Default,,0,0,0,,أنقذيني يا بنين.
Dialogue: 0,0:48:22.83,0:48:23.97,Default,,0,0,0,,بنين؟
Dialogue: 0,0:48:24.84,0:48:27.37,Default,,0,0,0,,لماذا حاول مهاجمة الملكة؟
Dialogue: 0,0:48:27.67,0:48:29.74,Default,,0,0,0,,كان من الممكن أن تتأذى.
Dialogue: 0,0:48:29.74,0:48:32.74,Default,,0,0,0,,اذهبي بعيداً يا امرأة! اخرج من هذا الجسد!
Dialogue: 0,0:48:32.74,0:48:34.51,Default,,0,0,0,,-اذهب بعيداً.\N-الملكة.
Dialogue: 0,0:48:41.95,0:48:45.36,Default,,0,0,0,,ماذا نسي هذا الثرثرة هنا؟
Dialogue: 0,0:48:48.33,0:48:50.33,Default,,0,0,0,,فيم كنت تفكر؟
Dialogue: 0,0:48:50.56,0:48:53.33,Default,,0,0,0,,أردت حقاً رؤية وجهها.
Dialogue: 0,0:48:55.87,0:48:57.80,الافتراضي,,0,0,0,,صحيح. أنا...
Dialogue: 0,0:49:00.14,0:49:01.47,Default,,0,0,0,,في جوسون...
Dialogue: 0,0:49:01.47,0:49:03.54,Default,,0,0,0,,سيدتي. هونغ يونغ.
Dialogue: 0,0:49:06.51,0:49:08.01,Default,,0,0,0,,الملكة.
Dialogue: 0,0:49:12.12,0:49:14.22,Default,,0,0,0,,أراد رؤية خادمتك.
Dialogue: 0,0:49:16.35,0:49:18.69,Default,,0,0,0,,هل هو حقاً لا يتعرف عليّ بهذه الطريقة؟
Dialogue: 0,0:49:22.23,0:49:24.69,Default,,0,0,0,,قلت أنك ستحمي الملكة،
Dialogue: 0,0:49:25.50,0:49:27.20,Default,,0,0,0,,لكنهم أظهروا ضعفهم فقط.
Dialogue: 0,0:49:28.53,0:49:30.13,Default,,0,0,0,,لماذا أنت تعيس إلى هذه الدرجة؟
Dialogue: 0,0:49:30.13,0:49:31.70,Default,,0,0,0,,قسم المباحث؟
Dialogue: 0,0:49:31.87,0:49:34.17,Default,,0,0,0,,هل أنت مستعد لشيء ما؟
Dialogue: 0,0:49:34.64,0:49:36.67,Default,,0,0,0,,ماذا يمكنني أن أفعل؟
Dialogue: 0,0:49:39.78,0:49:43.15,Default,,0,0,0,,تمت سرقة العديد من المستودعات في العاصمة مؤخرًا.
Dialogue: 0,0:49:43.25,0:49:46.52,Default,,0,0,0,,-وماذا في ذلك؟\N-نحن بحاجة إلى تعزيز الإجراءات الأمنية.
Dialogue: 0,0:49:47.58,0:49:49.29,Default,,0,0,0,,لكن إذا منعت هذا،
Dialogue: 0,0:49:51.25,0:49:54.76,Default,,0,0,0,,هل من الممكن أن تجني المال من هذا؟
Dialogue: 0,0:49:55.13,0:49:59.03,Default,,0,0,0,,سهل، رغم ماضيه،\N فهو لا يزال ملكاً.
Dialogue: 0,0:50:03.33,0:50:07.60,Default,,0,0,0,,اليوم سنكتشف ذلك.
Dialogue: 0,0:50:08.37,0:50:09.84,Default,تيرا,0,0,0,,سعيد جداً.
Dialogue: 0,0:50:22.85,0:50:25.42,Default,,0,0,0,,أنا نفسي محارب ماهر، ولدي الغرائز الصحيحة،
Dialogue: 0,0:50:25.72,0:50:29.23,Default,,0,0,0,,لن يكون من الصعب جداً\N بالنسبة لي أن أتفادى الضربات.
Dialogue: 0,0:50:29.46,0:50:32.33,Default,,0,0,0,,أردت مناقشة أمر ما معك،
Dialogue: 0,0:50:32.60,0:50:34.30,Default,,0,0,0,,لهذا السبب طلبت منك الحضور.
Dialogue: 0,0:50:35.13,0:50:37.53,Default,,0,0,0,,نعم؟ هذا كل شيء.
Dialogue: 0,0:50:38.57,0:50:41.47,Default,,0,0,0,,ولدي أيضاً طلب واحد لك.
Dialogue: 0,0:50:42.17,0:50:44.41,Default,,0,0,0,,لا أعرف إذا كان بإمكاني طلب هذا.
Dialogue: 0,0:50:47.24,0:50:48.65,Default,,0,0,0,,أي نوع من الطلب؟
Dialogue: 0,0:50:50.18,0:50:53.48,Default,,0,0,0,,هل ستنفخين على كدماتي؟
Dialogue: 0,0:51:03.19,0:51:05.70,Default,,0,0,0,,حتى أنفاسك عطرة.
Dialogue: 0,0:51:07.83,0:51:12.30,Default,,0,0,0,,الآن أنا في حيرة من أمري، فماذا الآن؟
Dialogue: 0,0:51:12.30,0:51:13.54,Default,,0,0,0,,أجرب.
Dialogue: 0,0:51:14.94,0:51:17.94,Default,,0,0,0,,هناك طريقة واحدة فقط لمعرفة ذلك على وجه اليقين.
Dialogue: 0,0:51:19.78,0:51:20.81,Default,,0,0,0,,عذراً مقدماً.
Dialogue: 0,0:51:22.31,0:51:23.38,Default,,0,0,0,,ولكن يجب أن أعرف ذلك.
Dialogue: 0,0:51:34.66,0:51:35.86,Default,,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:51:35.93,0:51:38.30,Default,,0,0,0,,آسف لعدم التعرف على مثل هذا الزوج المهم.
Dialogue: 0,0:51:40.76,0:51:42.87,Default,,0,0,0,,أي نوع من الابتسامة هذه؟
Dialogue: 0,0:51:42.97,0:51:44.90,Default,,0,0,0,,ابتسامة أطلب بها المغفرة.
Dialogue: 0,0:51:45.27,0:51:48.57,Default,,0,0,0,,أنفاسي عطرة، وابتسامتي أجمل.
Dialogue: 0,0:52:10.93,0:52:12.13,Default,,0,0,0,,وأنت تعرف الكثير عن الشرب.
Dialogue: 0,0:52:24.04,0:52:25.94,Default,,0,0,0,,أنت نفسك تتحمل الكحول جيداً.
Dialogue: 0,0:52:27.44,0:52:28.71,Default,,0,0,0,,بالطبع، لهذا السبب أنا الملك.
Dialogue: 0,0:53:00.24,0:53:01.71,Default,,0,0,0,,هل شربوا هذا القدر بالفعل؟
Dialogue: 0,0:53:04.48,0:53:06.02,Default,,0,0,0,,حسناً، ها هو الوقت المناسب.
Dialogue: 0,0:53:06.38,0:53:08.79,Default,,0,0,0,,-ERV.\N-ERV؟
Dialogue: 0,0:53:09.09,0:53:10.62,Default,,0,0,0,,زمن الكلب والذئب.
Dialogue: 0,0:53:12.62,0:53:14.52,Default,,0,0,0,,الساعة التي تنكشف فيها كل الحجب،
Dialogue: 0,0:53:14.80,0:53:17.30,Default,,0,0,0,,أولئك الذين تعايشوا بسلام خلال النهار\N يتشاجرون مثل الكلاب والذئاب.
Dialogue: 0,0:53:41.45,0:53:44.12,Default,,0,0,0,,اجبني كزوج لزوج.
Dialogue: 0,0:53:45.76,0:53:47.06,Default,,0,0,0,,أنت لا شيء
Dialogue: 0,0:53:49.33,0:53:52.80,Default,,0,0,0,,أليس لديك مشاعر تجاه ملكتي؟
Dialogue: 0,0:53:53.76,0:53:56.03,Default,,0,0,0,,فقط المشاعر تجاهها
Dialogue: 0,0:53:56.03,0:53:58.27,Default,,0,0,0,,قد يفسر عدائك تجاهي.
Dialogue: 0,0:53:59.27,0:54:02.87,Default,,0,0,0,,هناك جميع أنواع الحمير في العالم.
Dialogue: 0,0:54:04.67,0:54:07.11,Default,,0,0,0,,هناك من هم أنفسهم\N لا يشعرون بأي شيء تجاه العذراء،
Dialogue: 0,0:54:08.65,0:54:12.38,Default,,0,0,0,,لكنهم لا يستطيعون السماح لها بأن تكون مع شخص آخر.
Dialogue: 0,0:54:17.42,0:54:22.66,Default,,0,0,0,,هل أنا المتسلط؟
Dialogue: 0,0:54:31.50,0:54:33.17,Default,,0,0,0,,جنبك خير النساء،
Dialogue: 0,0:54:33.17,0:54:34.87,Default,,0,0,0,,ولم تلاحظ ذلك.
Dialogue: 0,0:54:37.74,0:54:39.61,Default,,0,0,0,,مثل أكل الحمار، أحمق تماماً.
Dialogue: 0,0:54:42.31,0:54:44.11,Default,,0,0,0,,سهلاً يا شباب.
Dialogue: 0,0:54:44.11,0:54:46.28,Default,,0,0,0,,لست مهتماً بأي منكم.
Dialogue: 0,0:54:48.85,0:54:49.89,Default,,0,0,0,,أنت تكذب.
Dialogue: 0,0:54:51.22,0:54:52.62,Default,,0,0,0,,أعلم أنك معجب بي.
Dialogue: 0,0:54:55.69,0:54:57.09,Default,,0,0,0,,انظر في عيني.
Dialogue: 0,0:55:02.37,0:55:03.43,Default,,0,0,0,,أو أنت...
Dialogue: 0,0:55:13.94,0:55:17.05,Default,,0,0,0,,يجب أن يكون الملك الحكيم راضيًا،
Dialogue: 0,0:55:18.58,0:55:19.72,Default,,0,0,0,,ولكن النصر لي.
Dialogue: 0,0:55:22.69,0:55:23.72,Default,,0,0,0,,مضحك.
Dialogue: 0,0:55:27.02,0:55:28.53,Default,,0,0,0,,حان الوقت لكي ترد لطفي.
Dialogue: 0,0:56:06.20,0:56:08.50,Default,,0,0,0,,ها نحن نلتقي من جديد.
Dialogue: 0,0:56:09.27,0:56:11.17,Default,,0,0,0,,رغم أنني حاولت الابتعاد،
Dialogue: 0,0:56:11.17,0:56:13.04,Default,,0,0,0,,حتى لا أزعجك مرة أخرى.
Dialogue: 0,0:56:13.04,0:56:15.34,Default,,0,0,0,,لماذا أيتها الملكة الأم، أنت لا تزعجينني على الإطلاق.
Dialogue: 0,0:56:15.77,0:56:17.21,Default,,0,0,0,,لدي هدية لك.
Dialogue: 0,0:56:32.59,0:56:33.59,Default,,0,0,0,,هذا...
Dialogue: 0,0:56:33.59,0:56:36.93,Default,,0,0,0,,إذا كان هناك من يستحق أن يكون بالقرب من الملك، فهو أنت.
Dialogue: 0,0:56:37.59,0:56:41.06,Default,,0,0,0,,لقب صاحبة الجلالة يناسبك أكثر بكثير.
Dialogue: 0,0:56:50.94,0:56:52.88,Default,,0,0,0,,إلى ماذا كنت تنظر أيها الطفل؟
Dialogue: 0,0:56:56.11,0:57:00.05,Default,,0,0,0,,أعجبت بانعكاس القمر في المياه.
Dialogue: 0,0:57:00.38,0:57:03.62,Default,,0,0,0,,يمكن سماع العديد من القصص المخيفة داخل جدران القصر.
Dialogue: 0,0:57:04.05,0:57:06.39,Default,,0,0,0,,عن الأشباح مثلاً.
Dialogue: 0,0:57:07.62,0:57:12.16,Default,,0,0,0,,إحدى هذه القصص تقول أنه لا ينبغي عليك
Dialogue: 0,0:57:12.53,0:57:15.73,Default,,0,0,0,,انظر إلى مياه الخزان عندما يكون القمر بدراً.
Dialogue: 0,0:57:17.63,0:57:19.44,Default,,0,0,0,,لأنه بمجرد أن تبتعد،
Dialogue: 0,0:57:19.44,0:57:23.54,Default,,0,0,0,,وسوف يتخذ تفكيرك حياة خاصة به.
Dialogue: 0,0:57:29.81,0:57:31.01,Default,,0,0,0,,أعتقد
Dialogue: 0,0:57:32.45,0:57:34.75,Default,,0,0,0,,كما لو كنت حتى الآن في مكان ما في قاع خزان.
Dialogue: 0,0:57:41.62,0:57:42.73,افتراضي,,0,0,0,,الآن
Dialogue: 0,0:57:44.23,0:57:46.10,Default,,0,0,0,,حان وقت الظهور.
Dialogue: 0,0:58:37.55,0:58:39.05,Default,,0,0,0,,كان بإمكاني انتظار الشيخ.
Dialogue: 0,0:58:39.05,0:58:40.28,Default,,0,0,0,,يبدو أنه تم الضغط عليه بشدة.
Dialogue: 0,0:58:43.42,0:58:45.76,Default,,0,0,0,,توقف. المحتاجون في هذا الجانب.
Dialogue: 0,0:59:24.93,0:59:26.73,Default,,0,0,0,,هناك شيء أخفيته عنك.
Dialogue: 0,0:59:27.93,0:59:29.87,Default,,0,0,0,,ما أخفيته عن الجميع.
Dialogue: 0,0:59:29.87,0:59:31.80,Default,,0,0,0,,ما أعرفه أنا وصاحبة الجلالة فقط.
Dialogue: 0,0:59:39.78,0:59:42.08,Default,,0,0,0,,أثناء اكتمال القمر، يستدير المستذئبون
Dialogue: 0,0:59:42.68,0:59:44.88,Default,,0,0,0,,في الذئاب.
Dialogue: 0,0:59:47.32,0:59:48.85,Default,,0,0,0,,لكننا جميعاً
Dialogue: 0,0:59:50.45,0:59:54.06,Default,,0,0,0,,نحن نعلم جيداً أن اكتمال القمر هو مجرد عذر،
Dialogue: 0,0:59:54.06,0:59:58.03,Default,,0,0,0,,لإطلاق سراح الذئب الذي كان يختبئ بالداخل دائمًا.
Dialogue: 0,1:00:33.96,1:00:35.40,Default,,0,0,0,,ما هذا، وعاء الغرفة؟
Dialogue: 0,1:00:36.13,1:00:39.74,Default,,0,0,0,,ليس من الجيد فعل الأشياء بمثل هذا الجمال.
Dialogue: 0,1:01:43.47,1:01:44.53,Default,,0,0,0,,تانجو؟
Dialogue: 0,1:02:19.77,1:02:20.90,Default,,0,0,0,,هل عدت إلى رشدك؟
Dialogue: 0,1:02:24.01,1:02:25.88,Default,,0,0,0,,خذني إلى غرفة صاحبة الجلالة.
Dialogue: 0,1:02:26.14,1:02:27.51,Default,,0,0,0,,سأحرسها شخصياً.
Dialogue: 0,1:03:26.04,1:03:27.14,Default,,0,0,0,,الملكة؟
Dialogue: 0,1:03:28.47,1:03:31.31,Default,,0,0,0,,يا له من وغد، لماذا تسيء إلى ملكي المسكين؟
Dialogue: 0,1:03:34.28,1:03:36.41,Default,,0,0,0,,أتحمل القصاص
Dialogue: 0,1:03:36.88,1:03:40.28,Default,,0,0,0,,باسم القمر!
Dialogue: 0,1:03:49.00,1:03:51.30,Default,,0,0,0,,شربت قليلاً فقط، وأصبحت نعمتي كالبطاطس.
Dialogue: 0,1:03:52.36,1:03:55.40,Default,,0,0,0,,هيا، انهض. لا تزال جيدة؟
Dialogue: 0,1:04:02.24,1:04:04.61,Default,,0,0,0,,لماذا عرضت نفسك للهجوم؟
Dialogue: 0,1:04:07.01,1:04:08.14,Default,,0,0,0,,ها هو ذا!
Dialogue: 0,1:04:16.15,1:04:18.32,Default,,0,0,0,,دعونا ننسى التباعد اليوم.
Dialogue: 0,1:04:24.43,1:04:25.56,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:04:26.50,1:04:27.86,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:05:11.14,1:05:12.91,Default,,0,0,0,,لا يسعك إلا أن تقع في المشاكل.
Dialogue: 0,1:05:12.91,1:05:16.31,Default,,0,0,0,,سيكون من المؤسف جدًا إذا نسيت الليلة الماضية.
Dialogue: 0,1:05:16.41,1:05:18.28,Default,,0,0,0,,يمكنك دائمًا شراء لوحة الاسم.
Dialogue: 0,1:05:18.28,1:05:20.25,Default,,0,0,0,,من يدري؟ فجأة أصبح تحت ستار شخص آخر
Dialogue: 0,1:05:20.25,1:05:22.02,Default,,0,0,0,,تسلل إلى هنا لبدء التمرد.
Dialogue: 0,1:05:22.02,1:05:23.82,Default,,0,0,0,,هذا كله خطأي.
Dialogue: 0,1:05:23.82,1:05:25.96,Default,,0,0,0,,كان علي أن أبقي فمي مغلقاً.
Dialogue: 0,1:05:25.96,1:05:27.26,Default,,0,0,0,,دعونا نقوم بغزوة صغيرة.
Dialogue: 0,1:05:27.26,1:05:28.96,Default,,0,0,0,,يتبرأ من آل كيم،
Dialogue: 0,1:05:28.96,1:05:30.66,Default,,0,0,0,,أن عائلته بأكملها تقريباً قد ذُبحت.
Dialogue: 0,1:05:30.66,1:05:32.39,Default,,0,0,0,,تكلم ولكن لا تتحدث.
Dialogue: 0,1:05:33.96,1:05:35.50,Default,,0,0,0,,-من أنت أيضاً؟ \N-أنا
Dialogue: 0,1:05:35.50,1:05:37.07,Default,,0,0,0,,أنا عضو في نادي معجبي الملك.
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


