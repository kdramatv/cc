Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 ل 92 38 ل 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,عملت,,0,0,0,,{\pos(801,256)}عملت على مسلسل:\N ليلي، تيراميسو، بيريولكا، هوست، بندق، فبراير
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.06,0:01:06.33,Default,Lily,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.33,0:01:08.61,Default,ليلي,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:10.57,0:01:11.94,Default,ليلي,0,0,0,,إذا كنت لا تريد التحدث،
Dialogue: 0,0:01:11.94,0:01:13.81,Default,ليلي,0,0,0,,تستخدم إشارات اليد؟
Dialogue: 0,0:01:13.81,0:01:14.81,Default,Lily,0,0,0,,على سبيل المثال، هذه.
Dialogue: 0,0:01:15.78,0:01:16.98,Default,ليلي,0,0,0,,ما هذا؟
Dialogue: 0,0:01:16.98,0:01:20.25,Default,ليلي,0,0,0,,هذا يعني أنني أكذب.
Dialogue: 0,0:01:20.68,0:01:22.68,Default,ليلي,0,0,0,,ماذا تقول؟ انها ليست صعبة، أليس كذلك؟
Dialogue: 0,0:01:28.19,0:01:31.02,Default,ليلي,0,0,0,,الملك لا يكذب أبداً.
Dialogue: 0,0:01:34.00,0:01:36.93,Default,ليلي,0,0,0,,15 حلقة
Dialogue: 0,0:01:55.35,0:01:58.12,Default,Lily,0,0,0,,ما الخطيئة التي يمكن أن يرتكبها طفل صغير كهذا؟
Dialogue: 0,0:02:00.05,0:02:02.46,Default,ليلي,0,0,0,,رائحة الكحول وشيء آخر.
Dialogue: 0,0:02:03.36,0:02:04.69,Default,ليلي,0,0,0,,لم تشرب السم.
Dialogue: 0,0:02:05.93,0:02:11.63,Default,Lilia,0,0,0,,لا أستطيع أن أصدق أنها أُجبرت على شرب السم بواسطة تلك الأيدي الصغيرة.
Dialogue: 0,0:02:13.47,0:02:15.97,Default,ليلي,0,0,0,,الأيدي الدافئة. انها لا تزال على قيد الحياة.
Dialogue: 0,0:02:23.14,0:02:24.38,Default,ليلي,0,0,0,,انهض.
Dialogue: 0,0:02:25.21,0:02:27.45,Default,ليلي,0,0,0,,دامهيانغ!
Dialogue: 0,0:02:31.49,0:02:32.52,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:02:47.00,0:02:48.80,Default,ليلي,0,0,0,,-سيد\N-أنت هنا.
Dialogue: 0,0:02:48.80,0:02:49.90,Default,ليلي,0,0,0,,السيد.
Dialogue: 0,0:02:51.00,0:02:52.07,Default,ليلي,0,0,0,,انتظر.
Dialogue: 0,0:02:56.51,0:02:59.15,Default,ليلي,0,0,0,,لا يمكنك ترك طفل في الجبال.
Dialogue: 0,0:03:00.45,0:03:02.65,Default,ليلي,0,0,0,,يجب أن أقيم لها جنازة.
Dialogue: 0,0:03:12.66,0:03:14.86,Default,ليلي,0,0,0,,-وداعاً.\N-وداعاً.
Dialogue: 0,0:03:35.12,0:03:37.18,Default,ليلي,0,0,0,,كيف حال دامهيان؟ هل هي بخير؟
Dialogue: 0,0:03:37.48,0:03:39.89,Default,ليلي,0,0,0,,لقد غادرت القصر بسلام بالفعل.
Dialogue: 0,0:03:40.62,0:03:42.82,Default,ليلي,0,0,0,,رحمت أمها الخادمة
Dialogue: 0,0:03:42.82,0:03:45.73,Default,Lilia,0,0,0,,وأعدت لهم كل شيء لمغادرة هانيانغ معًا.
Dialogue: 0,0:03:45.73,0:03:47.13,Default,ليلي,0,0,0,,لذلك ستقابل والدتها.
Dialogue: 0,0:03:47.93,0:03:50.06,Default,ليليا,0,0,0,,كان دامهيان قلقاً جداً عليها.
Dialogue: 0,0:03:50.53,0:03:52.93,Default,ليلي,0,0,0,,يا لها من فرحة. هذا رائع.
Dialogue: 0,0:03:56.17,0:03:58.74,Default,ليلي,0,0,0,,كيف فعلت هذا؟ هل أعطيتها الحبوب المنومة؟
Dialogue: 0,0:03:58.77,0:04:00.34,Default,ليلي,0,0,0,,أعطوها المافيسان لتشرب.
Dialogue: 0,0:04:01.48,0:04:05.08,Default,Lily,0,0,0,,مافيزان، ما الذي استخدمه هوا تو أثناء العمليات؟
Dialogue: 0,0:04:05.08,0:04:06.35,Default,ليلي,0,0,0,,أنت تعرفه.
Dialogue: 0,0:04:06.35,0:04:09.02,Default,ليلي,0,0,0,,بالطبع. لقد قرأت الممالك الثلاث للأطفال عدة مرات.
Dialogue: 0,0:04:09.62,0:04:11.32,Default,ليلي,0,0,0,,الممالك الثلاث للأطفال؟
Dialogue: 0,0:04:13.09,0:04:16.42,Default,ليلي,0,0,0,,استمع. كان يجب أن تحذرني.
Dialogue: 0,0:04:16.42,0:04:18.23,Default,ليلي,0,0,0,,كان الأمر عاجلاً،
Dialogue: 0,0:04:18.23,0:04:20.23,Default,Lilia,0,0,0,,كان من الخطير إشراك الكثير من الناس.
Dialogue: 0,0:04:25.20,0:04:27.27,Default,ليلي,0,0,0,,هل هناك أي كلمة من السيد هونغ؟
Dialogue: 0,0:04:27.47,0:04:31.04,Default,ليلي,0,0,0,,نعم. وتأكد من هروب الطفل بسلام.
Dialogue: 0,0:04:32.94,0:04:34.34,Default,ليلي,0,0,0,,أحسنت.
Dialogue: 0,0:04:35.38,0:04:38.58,Default,ليلي,0,0,0,,تعريض نفسك للخطر بتهور
Dialogue: 0,0:04:38.98,0:04:40.38,Default,ليلي,0,0,0,,بسبب الخادمة.
Dialogue: 0,0:04:40.55,0:04:42.32,Default,ليلي,0,0,0,,إنها ليست مجرد خادمة.
Dialogue: 0,0:04:43.38,0:04:44.92,Default,ليلي,0,0,0,,إذا تخليت عن الطفل،
Dialogue: 0,0:04:46.02,0:04:48.39,Default,ليلي,0,0,0,,سيكون من الأسهل التخلي عن 10، 100،
Dialogue: 0,0:04:50.12,0:04:52.49,Default,ليلي,0,0,0,,ثم كل شعبي.
Dialogue: 0,0:04:53.66,0:04:57.10,Default,ليلي,0,0,0,,اعتقدت أن تشيولجونغ كان أحمق عادي،
Dialogue: 0,0:04:58.00,0:05:00.47,Default,Lilia,0,0,0,,وهو مجرد أحمق لا يصدق.
Dialogue: 0,0:05:00.53,0:05:02.97,Default,Lily,0,0,0,,لا تقضي الكثير من الوقت في التفكير في الأشياء العظيمة.
Dialogue: 0,0:05:02.97,0:05:04.17,Default,ليلي,0,0,0,,وإلا فلن تعيش طويلاً.
Dialogue: 0,0:05:04.77,0:05:07.37,Default,Lily,0,0,0,,لا أنوي أن أعيش حياة بائسة.
Dialogue: 0,0:05:07.37,0:05:09.41,Default,ليلي,0,0,0,,عذر ممتاز للموت المبكر.
Dialogue: 0,0:05:09.88,0:05:11.51,Default,ليلي,0,0,0,,من هو...
Dialogue: 0,0:05:11.51,0:05:12.98,Default,ليلي,0,0,0,,إنها من تشكرني كثيراً.
Dialogue: 0,0:05:14.01,0:05:16.92,Default,Lily,0,0,0,,الملكة تتحدث بشكل مختلف عن الآخرين.
Dialogue: 0,0:05:19.52,0:05:21.42,Default,Lily,0,0,0,"قاموس الملكة" كان مفيدًا.
Dialogue: 0,0:05:21.42,0:05:23.52,Default,Lily,0,0,0,,إنه مليء بالترجمات المجانية وغير الصحيحة.
Dialogue: 0,0:05:23.52,0:05:25.66,Default,Lily,0,0,0,,-هل رأيته؟\N-لقد تركته مفتوحاً.
Dialogue: 0,0:05:26.69,0:05:30.26,Default,Lily,0,0,0,,بالمناسبة، هل منصب الملكة دائمًا خطير جدًا؟
Dialogue: 0,0:05:30.26,0:05:32.13,Default,ليلي,0,0,0,,لماذا يريد الجميع قتلي؟
Dialogue: 0,0:05:32.47,0:05:35.60,Default,ليلي,0,0,0,,لن أسمح بحدوث هذا مرة أخرى.
Dialogue: 0,0:05:36.67,0:05:38.87,Default,ليلي,0,0,0,,لا. سأعتني بكل شيء بنفسي.
Dialogue: 0,0:05:39.74,0:05:41.74,Default,ليلي,0,0,0,,أفضل دفاع هو الهجوم.
Dialogue: 0,0:05:43.71,0:05:47.05,Default,Lily,0,0,0,,من هذا اليوم فصاعداً، سأصبح الأكثر تهوراً في القصر.
Dialogue: 0,0:06:02.76,0:06:05.77,Default,ليلي,0,0,0,,مجنون X هنا
Dialogue: 0,0:06:12.47,0:06:14.77,Default,ليلي,0,0,0,,هل حاولت التخلص من الملكة؟
Dialogue: 0,0:06:15.34,0:06:17.44,Default,ليلي,0,0,0,,الملكة تقف إلى جانب الملك.
Dialogue: 0,0:06:17.44,0:06:20.35,Default,ليلي,0,0,0,,أخبرته عن كل نقاط الضعف في عائلتنا.
Dialogue: 0,0:06:20.88,0:06:23.38,Default,ليلي,0,0,0,,وقعت في حب الملك وابتعدت عنا.
Dialogue: 0,0:06:24.08,0:06:25.52,Default,ليلي,0,0,0,,هذا ليس صحيحاً.
Dialogue: 0,0:06:26.35,0:06:28.09,Default,ليلي,0,0,0,,أنت لا تريد أن تصدق،
Dialogue: 0,0:06:28.62,0:06:31.26,Default,ليلي,0,0,0,,تلك الملكة التي تعشقها
Dialogue: 0,0:06:31.26,0:06:33.06,Default,ليلي,0,0,0,,مجرد امرأة غبية،
Dialogue: 0,0:06:33.06,0:06:34.83,Default,ليلي,0,0,0,,تقع في حب رجل بتهور.
Dialogue: 0,0:06:35.83,0:06:37.80,Default,ليلي,0,0,0,,الانضمام إلى عائلتك،
Dialogue: 0,0:06:37.80,0:06:40.67,Default,Lily,0,0,0,,لقد فعلت كل ما أردت أن يتم قبولك.
Dialogue: 0,0:06:42.34,0:06:44.91,Default,ليلي,0,0,0,,ليس فقط للبقاء في هذا المنزل.
Dialogue: 0,0:06:45.57,0:06:47.11,Default,ليلي,0,0,0,,أردت أن أكون مثلك،
Dialogue: 0,0:06:48.14,0:06:49.88,Default,ليليا,0,0,0,,كنت أحترمك.
Dialogue: 0,0:06:51.78,0:06:54.48,Default,ليلي,0,0,0,,ولكن محاولة إيذاء الملكة،
Dialogue: 0,0:06:56.02,0:06:58.29,Default,ليليا,0,0,0,,أنت لم تعد والدي.
Dialogue: 0,0:07:01.02,0:07:04.22,Default,ليلي,0,0,0,,إذا قرر أي شخص تهديد الملكة،
Dialogue: 0,0:07:06.89,0:07:09.20,Default,ليلي,0,0,0,,سأقطع حنجرته بالتأكيد.
Dialogue: 0,0:07:14.94,0:07:17.00,Default,ليلي,0,0,0,,يمكنك العودة إلى المنزل وقتما تشاء.
Dialogue: 0,0:07:19.01,0:07:21.44,Default,Lily,0,0,0,,حتى لو كنت لا تعتبرني أباً،
Dialogue: 0,0:07:22.64,0:07:24.98,Default,ليلي,0,0,0,,سوف تكون ابني دائماً.
Dialogue: 0,0:07:36.86,0:07:40.16,Default,Lily,0,0,0,,من كان بإمكانه إخفاء دفتر الأستاذ في دايجوجون؟
Dialogue: 0,0:07:40.69,0:07:42.73,Default,ليلي,0,0,0,,المشتبه بهم الرئيسيون هم
Dialogue: 0,0:07:42.73,0:07:44.76,Default,Lily,0,0,0,,هذان الشخصان اللذان يحملان ضغينة ضدي.
Dialogue: 0,0:07:45.47,0:07:47.27,Default,ليلي,0,0,0,,الملكة الأم وتشو هواجين.
Dialogue: 0,0:07:47.67,0:07:50.17,Default,Lily,0,0,0,,الدافع يشير إلى تشو هواجين.
Dialogue: 0,0:07:58.04,0:08:00.95,Default,Lily,0,0,0,,أنا متأكد تقريبًا، بالنظر إلى كيفية تصرفها أثناء الصيد.
Dialogue: 0,0:08:02.65,0:08:05.85,Default,Lily,0,0,0,,ومع ذلك، لم يأت هواجين إلى دايجوجون منذ فترة طويلة.
Dialogue: 0,0:08:06.19,0:08:08.79,Default,Lily,0,0,0,,الطرق تشير إلى الملكة الأم.
Dialogue: 0,0:08:10.36,0:08:11.52,Default,ليلي,0,0,0,,هنا.
Dialogue: 0,0:08:13.66,0:08:16.36,Default,ليلي,0,0,0,,إنها تأتي هنا بشكل مثير للريبة في كثير من الأحيان في الآونة الأخيرة.
Dialogue: 0,0:08:17.50,0:08:19.40,Default,ليلي,0,0,0,,بالطبع، لديها أيضًا دافع.
Dialogue: 0,0:08:20.50,0:08:21.80,Default,ليلي,0,0,0,,هل هذه هي الملكة الأم؟
Dialogue: 0,0:08:22.24,0:08:23.80,Default,ليلي,0,0,0,,هذا الجرذ الصغير.
Dialogue: 0,0:08:24.54,0:08:29.64,Default,Lily,0,0,0,,كيف وضعت الملكة الأم يديها على دفتر الأستاذ؟
Dialogue: 0,0:08:32.18,0:08:35.68,Default,ليلي,0,0,0,,هذا هو اللغز.
Dialogue: 0,0:08:36.15,0:08:40.59,Default,Lily,0,0,0,,الأهم من ذلك، أي نوع من دفتر الأستاذ هذا؟
Dialogue: 0,0:09:02.84,0:09:04.91,Default,Lily,0,0,0,,اليوم لم أقم بالطقوس.
Dialogue: 0,0:09:04.91,0:09:07.35,Default,Lily,0,0,0,,أعتذر عن سلوكي الفظ.
Dialogue: 0,0:09:09.02,0:09:11.38,Default,ليلي,0,0,0,,أنت تعتذر لسبب ما.
Dialogue: 0,0:09:12.35,0:09:13.89,Default,ليلي,0,0,0,,ما هو السبب؟
Dialogue: 0,0:09:14.82,0:09:16.66,Default,ليلي,0,0,0,,كما توقعت،
Dialogue: 0,0:09:17.92,0:09:19.96,Default,ليلي,0,0,0,,أنت تفهم كل شيء بسرعة.
Dialogue: 0,0:09:27.53,0:09:31.37,Default,Lily,0,0,0,,شكرًا لمشاركتك في هذا الاجتماع غير السار.
Dialogue: 0,0:09:35.11,0:09:37.74,Default,Lily,0,0,0,,أنا متأكد من أنك تفهم في ضوء الأحداث الأخيرة،
Dialogue: 0,0:09:37.74,0:09:39.51,Default,ليلي,0,0,0,,لقد حان وقت النبلاء
Dialogue: 0,0:09:39.51,0:09:41.31,Default,ليلي,0,0,0,,توحد العائلات.
Dialogue: 0,0:09:42.25,0:09:43.52,Default,Lily,0,0,0,,نحن على اتصال وثيق.
Dialogue: 0,0:09:44.75,0:09:46.89,Default,ليلي,0,0,0,,إذا سقطت إحدى العائلتين،
Dialogue: 0,0:09:47.22,0:09:49.32,Default,ليلي,0,0,0,,الآخر لن يبقى واقفا على قدميه.
Dialogue: 0,0:09:52.66,0:09:57.10,Default,ليلي,0,0,0,,لذلك أقترح إصدار مرسوم بالعفو،
Dialogue: 0,0:09:57.96,0:09:59.50,Default,Lily,0,0,0,,كضمان للانسجام في العلاقات.
Dialogue: 0,0:10:00.87,0:10:02.07,Default,ليلي,0,0,0,,المرسوم؟
Dialogue: 0,0:10:02.07,0:10:04.30,Default,ليلي,0,0,0,,مواهب كثيرة من العائلتين
Dialogue: 0,0:10:04.30,0:10:07.34,Default,Lily,0,0,0,,فقدوا مشاركاتهم بسبب خطأ مؤقت.
Dialogue: 0,0:10:07.84,0:10:11.44,Default,Lily,0,0,0,,سنصدر مرسوم عفو بالعفو عن هؤلاء الأشخاص.
Dialogue: 0,0:10:12.55,0:10:15.52,Default,Lily,0,0,0,,بمعنى آخر، إنها رمز الوعد
Dialogue: 0,0:10:15.52,0:10:17.05,Default,ليلي,0,0,0,,وهدية تهنئة.
Dialogue: 0,0:10:17.55,0:10:18.69,Default,ليلي,0,0,0,,ما رأيك؟
Dialogue: 0,0:10:20.39,0:10:22.16,Default,ليلي,0,0,0,,هل تدعمني في هذا؟
Dialogue: 0,0:10:50.32,0:10:54.22,Default,Lily,0,0,0,,استخدمت وزارة الحرب حيلًا قذرة لإرضاء جشعها،
Dialogue: 0,0:10:54.22,0:10:58.26,Default,Lily,0,0,0,,وأنا مذنب لعدم قدرتي على إخضاعه.
Dialogue: 0,0:10:58.89,0:11:01.59,Default,Lily,0,0,0,,وبهذا الصدد، أنا، كيم جواجيون،
Dialogue: 0,0:11:02.40,0:11:05.53,Default,ليلي,0,0,0,,أطلب الاستقالة من منصبي.
Dialogue: 0,0:11:11.94,0:11:14.44,Default,ليلي,0,0,0,,لم ينته الأمر بالنسبة لي بعد.
Dialogue: 0,0:11:14.87,0:11:16.84,Default,ليلي,0,0,0,,لن ينتهي وأنا أتنفس.
Dialogue: 0,0:11:37.66,0:11:39.13,Default,ليلي,0,0,0,,تناول الطعام ببطء.
Dialogue: 0,0:11:41.47,0:11:43.04,Default,ليلي,0,0,0,,هل هناك وجبات خفيفة كافية؟
Dialogue: 0,0:11:52.35,0:11:56.25,Default,Lily,0,0,0,,لا ينبغي أن آكل إذا بقي في داخلي قطرة من الخجل.
Dialogue: 0,0:12:00.52,0:12:02.29,Default,ليلي,0,0,0,,إذن لماذا هربت؟
Dialogue: 0,0:12:02.76,0:12:06.23,Default,ليلي,0,0,0,,لقد عاملتك معاملة حسنة.
Dialogue: 0,0:12:09.10,0:12:10.30,Default,ليلي,0,0,0,,الأمر هو...
Dialogue: 0,0:12:18.54,0:12:20.37,Default,ليلي,0,0,0,,أمي.
Dialogue: 0,0:12:21.91,0:12:23.18,Default,ليلي,0,0,0,,أمي.
Dialogue: 0,0:12:23.58,0:12:24.71,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:12:27.38,0:12:29.15,Default,ليلي,0,0,0,,لقد عانيت بما فيه الكفاية يا دامهيان.
Dialogue: 0,0:12:29.82,0:12:31.75,Default,ليلي,0,0,0,,كان الأمر صعباً عليك.
Dialogue: 0,0:12:43.13,0:12:44.50,Default,ليلي,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:12:47.17,0:12:48.30,Default,ليلي,0,0,0,,كل شيء سيكون على ما يرام.
Dialogue: 0,0:12:56.64,0:12:59.08,Default,ليلي,0,0,0,,نحاول أن نبتسم أمامها.
Dialogue: 0,0:12:59.61,0:13:01.58,Default,ليلي,0,0,0,,لا ينبغي لصاحبة الجلالة
Dialogue: 0,0:13:01.58,0:13:03.32,Default,ليلي,0,0,0,,أن تحزن طويلاً.
Dialogue: 0,0:13:03.98,0:13:05.02,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:13:20.80,0:13:24.64,Default,ليلي,0,0,0,,جلالتك. حان الوقت للاستيقاظ.
Dialogue: 0,0:13:33.55,0:13:34.75,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:13:36.25,0:13:39.19,Default,ليلي,0,0,0,,لم تتمكن من النوم الليلة الماضية؟
Dialogue: 0,0:13:40.19,0:13:43.16,Default,Lily,0,0,0,,أخشى أن توقعي نفسك في المشاكل.
Dialogue: 0,0:13:44.72,0:13:48.59,Default,ليلي,0,0,0,,أفكار كثيرة جداً، لم أستطع النوم.
Dialogue: 0,0:13:50.86,0:13:53.27,Default,Lily,0,0,0,,بالمناسبة، هل ناموا جيداً على أية حال؟
Dialogue: 0,0:13:54.03,0:13:55.54,Default,ليلي,0,0,0,,من؟
Dialogue: 0,0:13:55.54,0:13:57.74,Default,Lily,0,0,0,,هؤلاء الأشخاص الذين حاولوا تدمير حياتي.
Dialogue: 0,0:13:58.20,0:14:00.64,Default,ليلي,0,0,0,,كان نومهم الهادئ الأخير.
Dialogue: 0,0:14:01.04,0:14:02.61,Default,ليلي,0,0,0,,آمل أن يحصلوا على قسط كافٍ من النوم.
Dialogue: 0,0:14:05.75,0:14:07.41,Default,ليلي,0,0,0,,-السيدة تشوي.\N-نعم.
Dialogue: 0,0:14:07.58,0:14:09.08,Default,ليلي,0,0,0,,أرسل أحداً
Dialogue: 0,0:14:09.08,0:14:10.98,Default,ليلي,0,0,0,,لأبي، فليأتِ إلى القصر.
Dialogue: 0,0:14:11.12,0:14:12.35,Default,ليلي,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:14:23.70,0:14:24.83,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:14:25.37,0:14:28.00,Default,ليلي,0,0,0,,لقد جاء والدك.
Dialogue: 0,0:14:28.97,0:14:29.97,Default,ليلي,0,0,0,,بالفعل؟
Dialogue: 0,0:14:34.91,0:14:38.11,Default,ليلي,0,0,0,,كنت سأطلب منك أن تأتي إلى القصر.
Dialogue: 0,0:14:39.15,0:14:41.98,Default,ليلي,0,0,0,,لكنك وصلت بالفعل.
Dialogue: 0,0:14:41.98,0:14:43.08,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:14:45.32,0:14:47.72,Default,Lily,0,0,0,,يبدو أنني أتيت لسبب ما.
Dialogue: 0,0:14:51.79,0:14:53.19,Default,ليلي,0,0,0,,-آخر مرة...\N-آخر مرة...
Dialogue: 0,0:14:54.13,0:14:55.43,Default,ليلي,0,0,0,,أنت تتكلم أولاً.
Dialogue: 0,0:14:55.43,0:14:57.33,Default,ليلي,0,0,0,,لا. أنت تتكلم.
Dialogue: 0,0:14:57.33,0:14:59.77,Default,ليلي,0,0,0,,لا. أنت تتكلم أولا.
Dialogue: 0,0:15:05.14,0:15:06.71,Default,Lily,0,0,0,,-آسف بشأن ذلك الوقت.\N-آسف بشأن ذلك الوقت.
Dialogue: 0,0:15:06.71,0:15:08.64,Default,ليلي,0,0,0,,-لا. أولاً، سوف اعتذر.\N-No. أنا أولا.
Dialogue: 0,0:15:08.64,0:15:10.01,Default,ليلي,0,0,0,,-أنا أولاً.\N-لا، أنا.
Dialogue: 0,0:15:10.01,0:15:11.28,Default,ليلي,0,0,0,,-الله.\N-Me أولاً.
Dialogue: 0,0:15:21.19,0:15:23.26,Default,Lily,0,0,0,,نعم، الدم ليس ماء.
Dialogue: 0,0:15:24.66,0:15:25.96,Default,ليلي,0,0,0,,بالضبط.
Dialogue: 0,0:15:28.06,0:15:31.60,Default,بندق,0,0,0,,اتصلت بك اليوم
Dialogue: 0,0:15:32.87,0:15:34.23,Default,بندق,0,0,0,,بسبب دفتر الأستاذ.
Dialogue: 0,0:15:37.44,0:15:40.24,Default,بندق,0,0,0,,-هل تعلم؟\N-الجميع أصيب بالجنون بسببها.
Dialogue: 0,0:15:40.87,0:15:42.44,Default,بندق,0,0,0,,ما نوع هذا الكتاب؟
Dialogue: 0,0:15:46.51,0:15:50.65,Default,بندق,0,0,0,,هذا حساب للأنشطة غير القانونية لعشيرتنا.
Dialogue: 0,0:15:51.32,0:15:53.22,Default,بندق,0,0,0,,نقطة الضعف في عشيرة أندونغ كيم.
Dialogue: 0,0:15:53.42,0:15:56.16,Default,بندق,0,0,0,,لهذا السبب أراد تشيولجونغ الحصول عليها.
Dialogue: 0,0:15:56.16,0:16:00.26,Default,بندق,0,0,0,,لقد جئت اليوم للحديث عنها للتو.
Dialogue: 0,0:16:01.19,0:16:04.23,Default,بندق,0,0,0,,بعد زيارتك للملك اختفت.
Dialogue: 0,0:16:04.70,0:16:07.23,Default,بندق,0,0,0,,لذا طوال هذا الوقت كنت أشك في الملك.
Dialogue: 0,0:16:08.30,0:16:09.47,Default,بندق,0,0,0,,ولكن في الآونة الأخيرة
Dialogue: 0,0:16:09.77,0:16:12.51,Default,بندق,0,0,0,,لقد هرب خادمي الأمين الذي شغوفت به.
Dialogue: 0,0:16:13.47,0:16:16.08,Default,بندق,0,0,0,,لحسن الحظ اكتشفت الأمر واكتشفت السبب.
Dialogue: 0,0:16:17.24,0:16:18.91,Default,بندق,0,0,0,,اليوم السابق للاختفاء
Dialogue: 0,0:16:19.71,0:16:21.78,Default,بندق,0,0,0,,لقد سمح لمحظية "تشو" بالدخول.
Dialogue: 0,0:16:23.42,0:16:25.59,Default,بندق,0,0,0,,عندما كانت هناك ضجة في المنزل،
Dialogue: 0,0:16:25.89,0:16:28.79,Default,بندق,0,0,0,,ظن أن كل شيء كان بسببه وهرب. لذلك...
Dialogue: 0,0:16:30.16,0:16:32.39,Default,بندق,0,0,0,,عذراً.
Dialogue: 0,0:16:35.46,0:16:37.80,Default,بندق,0,0,0,,هذا ليس خطأك.
Dialogue: 0,0:16:39.80,0:16:40.87,Default,بندق,0,0,0,,هنا
Dialogue: 0,0:16:42.17,0:16:44.27,Default,بندق,0,0,0,,وتم حل لغزنا.
Dialogue: 0,0:16:46.07,0:16:47.14,Default,بندق,0,0,0,,ماذا؟
Dialogue: 0,0:16:47.31,0:16:49.98,Default,بندق,0,0,0,,كان "سونغوون" هو البادئ بقتلي.
Dialogue: 0,0:16:50.94,0:16:53.48,Default,بندق,0,0,0,,لقد أعددت الثلج خصيصاً،
Dialogue: 0,0:16:53.48,0:16:55.98,Default,البندق,0,0,0,,وهو أغلى من الذهب اليوم.
Dialogue: 0,0:16:58.62,0:17:00.95,Default,بندق,0,0,0,,الملكة الأم سخرت مني.
Dialogue: 0,0:17:01.39,0:17:03.02,Default,بندق,0,0,0,,سأقدم لك طعامي يوماً ما.
Dialogue: 0,0:17:03.02,0:17:04.52,Default,بندق,0,0,0,,يجب أن أحاول ذلك الآن.
Dialogue: 0,0:17:09.46,0:17:12.17,Default,بندق,0,0,0,,وقدم "تشو هواجين" السلاح.
Dialogue: 0,0:17:12.30,0:17:14.17,Default,بندق,0,0,0,,اعترف للملك بكل شيء.
Dialogue: 0,0:17:14.17,0:17:15.40,Default,بندق,0,0,0,,هل تهددني؟
Dialogue: 0,0:17:16.80,0:17:18.20,Default,بندق,0,0,0,,أنا أنت
Dialogue: 0,0:17:19.44,0:17:20.67,Default,بندق,0,0,0,,سمعت بوضوح.
Dialogue: 0,0:17:30.95,0:17:34.62,Default,بندق,0,0,0,,أبي، يجب أن أذهب إلى مكان ما الآن.
Dialogue: 0,0:17:35.49,0:17:36.56,Default,بندق,0,0,0,,أين؟
Dialogue: 0,0:17:37.62,0:17:40.09,Default,بندق,0,0,0,,افتح باب الحفرة النارية.
Dialogue: 0,0:17:40.86,0:17:45.70,Default,بندق,0,0,0,,سوف تندم على الاتصال بي.
Dialogue: 0,0:17:51.54,0:17:53.17,Default,بندق,0,0,0,,كانت مطيعة كالخروف.
Dialogue: 0,0:17:53.61,0:17:56.34,Default,بندق,0,0,0,,وفي وقت قصير أصبح الأمر قاسياً هنا.
Dialogue: 0,0:17:57.54,0:18:00.08,Default,بندق,0,0,0,,أعلم أن الآباء لا يمكنهم أن يكونوا موضوعيين تجاه أطفالهم.
Dialogue: 0,0:18:00.31,0:18:01.65,Default,بندق,0,0,0,,لكن خروفاً؟
Dialogue: 0,0:18:02.58,0:18:04.42,Default,بندق,0,0,0,,إذا قارنتها بحيوان،
Dialogue: 0,0:18:04.42,0:18:06.25,Default,بندق,0,0,0,,ثم فقط بالقماش المشمع.
Dialogue: 0,0:18:07.55,0:18:10.12,Default,بندق,0,0,0,,ابنتي من التاربان؟
Dialogue: 0,0:18:30.78,0:18:32.25,Default,بندق,0,0,0,,وشم الماوري.
Dialogue: 0,0:18:33.55,0:18:35.18,Default,بندق,0,0,0,,ريشة الطاووس.
Dialogue: 0,0:18:35.78,0:18:37.85,Default,بندق,0,0,0,,والشيطان يرتدي برادا.
Dialogue: 0,0:18:38.75,0:18:40.65,Default,بندق,0,0,0,,القوة في الجمال.
Dialogue: 0,0:18:41.42,0:18:46.09,Default,بندق,0,0,0,,اليوم لدي أجمل درع.
Dialogue: 0,0:18:47.36,0:18:48.43,Default,بندق,0,0,0,,كيف يعجبك ذلك؟
Dialogue: 0,0:18:50.40,0:18:51.43,Default,بندق,0,0,0,,أعجبني.
Dialogue: 0,0:18:52.87,0:18:54.93,Default,بندق,0,0,0,,الانتقام حلو عندما يُقدم مع الألعاب النارية.
Dialogue: 0,0:19:19.43,0:19:21.53,Default,بندق,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:19:22.06,0:19:24.13,Default,بندق,0,0,0,,ما تراه ليس كل شيء.
Dialogue: 0,0:19:37.28,0:19:38.88,Default,بندق,0,0,0,,لمعرفة ما بداخله،
Dialogue: 0,0:19:38.88,0:19:41.18,Default,البندق,0,0,0,,يجب قطعه.
Dialogue: 0,0:19:41.35,0:19:43.52,Default,بندق,0,0,0,,اعتقدت أنها مجرد بطاطس.
Dialogue: 0,0:19:44.32,0:19:47.22,Default,بندق,0,0,0,,لكنك خدعتني.
Dialogue: 0,0:19:47.22,0:19:50.02,Default,بندق,0,0,0,,يجب ألا تفقد الثقة دون سبب وجيه.
Dialogue: 0,0:19:50.32,0:19:53.33,Default,بندق,0,0,0,,قبل أن تقطع، عليك التأكد من أنها كذلك.
Dialogue: 0,0:19:54.79,0:19:58.56,Default,بندق,0,0,0,,لأنك بعد ذلك لا يمكنك إرجاع أي شيء.
Dialogue: 0,0:20:00.00,0:20:02.17,Default,بندق,0,0,0,,مشروباتك.
Dialogue: 0,0:20:20.42,0:20:23.12,Default,بندق,0,0,0,,لقد قمت اليوم بتحضير وجبة الفطور،
Dialogue: 0,0:20:23.32,0:20:26.43,Default,بندق,0,0,0,,أشكرك على ما حدث مؤخرًا
Dialogue: 0,0:20:26.69,0:20:28.53,Default,بندق,0,0,0,,إفطار رائع.
Dialogue: 0,0:20:29.96,0:20:33.07,Default,بندق,0,0,0,,المشروب البارد في وجبة الفطور الأخير كان رائعًا جدًا،
Dialogue: 0,0:20:34.27,0:20:36.87,Default,بندق,0,0,0,,حتى أنني لن ألاحظ وفاة شخص ما.
Dialogue: 0,0:20:44.88,0:20:46.05,Default,بندق,0,0,0,,جربها.
Dialogue: 0,0:20:51.28,0:20:53.22,Default,بندق,0,0,0,,لست عطشانًا.
Dialogue: 0,0:20:53.22,0:20:55.82,Default,بندق,0,0,0,,لقد بذلت الكثير من الجهد في ذلك. خذ رشفة على الأقل.
Dialogue: 0,0:20:55.82,0:20:57.46,Default,بندق,0,0,0,,لقد أخبرتك أنني لا أريد ذلك.
Dialogue: 0,0:20:59.36,0:21:00.99,Default,بندق,0,0,0,,لقد حاولت جاهداً.
Dialogue: 0,0:21:03.40,0:21:04.83,Default,بندق,0,0,0,,إذا كنت لا تريد أن تشرب...
Dialogue: 0,0:21:23.82,0:21:26.15,Default,البندق,0,0,0,,طعمه أفضل مع الثلج.
Dialogue: 0,0:21:30.12,0:21:31.86,Default,بندق,0,0,0,,قلت سابقًا أنني سأساعدك
Dialogue: 0,0:21:32.36,0:21:35.33,Default,بندق,0,0,0,,حافظ على صحتك وشبابك لبقية حياتك.
Dialogue: 0,0:21:35.96,0:21:38.50,Default,بندق,0,0,0,,وسأستمر في القيام بذلك.
Dialogue: 0,0:21:39.17,0:21:42.10,Default,بندق,0,0,0,,إذا كنت تشك في الطعام والمشروبات وكل ما حولك،
Dialogue: 0,0:21:42.94,0:21:44.87,Default,بندق,0,0,0,,حينها لن تتحول الحياة إلا إلى معاناة.
Dialogue: 0,0:21:45.00,0:21:46.84,Default,بندق,0,0,0,,منذ أن انتهت وصايتي،
Dialogue: 0,0:21:46.84,0:21:48.81,Default,بندق,0,0,0,,هل تعتقد أنك تستطيع أن تفعل ما تريد؟
Dialogue: 0,0:21:49.28,0:21:50.51,Default,بندق,0,0,0,,تظن أنك ستبقى
Dialogue: 0,0:21:50.51,0:21:52.68,Default,بندق,0,0,0,,ملكة بدون عشيرتها؟
Dialogue: 0,0:21:52.68,0:21:54.21,Default,بندق,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:21:55.11,0:21:57.25,Default,بندق,0,0,0,,أنا لا أعتمد على عشيرتي أو زوجي.
Dialogue: 0,0:21:58.32,0:22:00.55,Default,بندق,0,0,0,,أفعل ما أريد لأنني أستطيع ذلك.
Dialogue: 0,0:22:09.56,0:22:11.86,Default,بندق,0,0,0,,بالضبط. رئيس الخصي.
Dialogue: 0,0:22:13.13,0:22:14.30,Default,بندق,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:22:14.30,0:22:16.74,Default,بندق,0,0,0,,لقد أهملت واجبي
Dialogue: 0,0:22:16.74,0:22:18.70,Default,بندق,0,0,0,,أنجب وريثاً.
Dialogue: 0,0:22:19.84,0:22:22.68,Default,بندق,0,0,0,,أعتقد أن هذا غير مقبول.
Dialogue: 0,0:22:23.24,0:22:25.58,Default,بندق,0,0,0,,اذهب وأبلغها.
Dialogue: 0,0:22:27.88,0:22:31.35,Default,بندق,0,0,0,,التقرير؟
Dialogue: 0,0:22:32.18,0:22:35.02,Default,بندق,0,0,0,,لا أعرف ما الذي تتحدث عنه يا صاحب الجلالة.
Dialogue: 0,0:22:36.92,0:22:39.26,Default,بندق,0,0,0,,أنت تعلم أنك تفعل هذا دائمًا.
Dialogue: 0,0:22:43.30,0:22:44.56,Default,بندق,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:22:45.53,0:22:47.17,Default,بندق,0,0,0,,يجب أن أعاقبك!
Dialogue: 0,0:22:49.60,0:22:51.80,Default,بندق,0,0,0,,سامحني يا صاحب الجلالة.
Dialogue: 0,0:22:52.17,0:22:54.64,Default,بندق,0,0,0,,-اقتلني.\N-ما خطبك؟
Dialogue: 0,0:22:55.47,0:22:57.28,Default,بندق,0,0,0,,لم أخبرك.
Dialogue: 0,0:23:04.98,0:23:07.65,Default,بندق,0,0,0,,الآن حياتي بين يديك.
Dialogue: 0,0:23:08.32,0:23:10.09,Default,بندق,0,0,0,,لست بحاجة إليه.
Dialogue: 0,0:23:10.66,0:23:12.49,Default,بندق,0,0,0,,ماذا يجب أن أفعل معها؟
Dialogue: 0,0:23:13.29,0:23:16.23,Default,بندق,0,0,0,,أرجوك اقتلني يا صاحب الجلالة.
Dialogue: 0,0:23:16.23,0:23:18.03,Default,بندق,0,0,0,,يا إلهي. قلت أنه ليس من الضروري.
Dialogue: 0,0:23:22.70,0:23:24.30,Default,بندق,0,0,0,,أعلم أنه لم يكن لديك خيار آخر.
Dialogue: 0,0:23:24.70,0:23:26.34,Default,بندق,0,0,0,,يجب عليك اتباع الأوامر.
Dialogue: 0,0:23:31.81,0:23:35.81,Default,بندق,0,0,0,,سيكون من الأفضل لو كنت غاضباً مني.
Dialogue: 0,0:23:36.95,0:23:39.62,Default,بندق,0,0,0,,هذا أسوأ.
Dialogue: 0,0:23:42.29,0:23:46.33,Default,بندق,0,0,0,,كيف يمكنك أن تكون جاسوساً إذا كنت خائفاً بهذه السهولة؟
Dialogue: 0,0:23:48.86,0:23:51.43,Default,بندق,0,0,0,,أحتاج إلى الذهاب إلى مكان ما قبل الاجتماع.
Dialogue: 0,0:23:52.20,0:23:54.10,Default,بندق,0,0,0,,اذهب إلى إنجونغجيونغ.
Dialogue: 0,0:23:56.87,0:23:59.64,Default,بندق,0,0,0,,يا إلهي، هل يمكنك قراءة هذا في مكان آخر؟
Dialogue: 0,0:23:59.64,0:24:01.57,Default,بندق,0,0,0,,كان رئيس الخصيان خائفاً جداً.
Dialogue: 0,0:24:23.16,0:24:24.96,Default,,0,0,0,,أتمنى أن تنام جيداً.
Dialogue: 0,0:24:26.67,0:24:29.13,Default,,0,0,0,,إذن أنت تلقي التحية على كبارك؟
Dialogue: 0,0:24:29.94,0:24:32.00,Default,,0,0,0,,الأزرار ثقيلة جداً.
Dialogue: 0,0:24:32.14,0:24:34.01,Default,,0,0,0,,لا أستطيع أن أحني رأسي.
Dialogue: 0,0:24:35.54,0:24:38.84,Default,,0,0,0,,تقام الطقوس في هذا المكان المقدس ويتم تذكر الأجداد.
Dialogue: 0,0:24:39.11,0:24:42.58,Default,,0,0,0,,ليس من المناسب أن تأتي إلى هنا مُعلقاً بالزينة.
Dialogue: 0,0:24:43.65,0:24:47.25,Default,,0,0,0,,قبل إصدار الإرجاع، عليك تنظيف الريش.
Dialogue: 0,0:24:49.22,0:24:50.59,Default,,0,0,0,,واو، لقد نسيت تماماً.
Dialogue: 0,0:24:50.86,0:24:53.29,Default,,0,0,0,,نحن بحاجة إلى إشعال البخور للملك المتوفى.
Dialogue: 0,0:24:54.73,0:24:58.00,Default,,0,0,0,,وكيف يمكنني أن أسيء إلى تعاليم تشونغهاك في آداب السلوك.
Dialogue: 0,0:25:03.37,0:25:04.60,Default,,0,0,0,,توقف.
Dialogue: 0,0:25:04.94,0:25:07.07,Default,,0,0,0,,أنا من أتباع الكونفوشيوسية المتحمسين.
Dialogue: 0,0:25:07.74,0:25:10.01,Default,,0,0,0,,لا أستطيع تحمل طقوس لم تتحقق.
Dialogue: 0,0:25:10.84,0:25:12.18,Default,,0,0,0,,قلت لك ألا تلمسه.
Dialogue: 0,0:25:13.68,0:25:15.95,Default,,0,0,0,,لقد تركت شيئاً في غرفتي.
Dialogue: 0,0:25:17.98,0:25:20.92,Default,,0,0,0,,لقد ظهروا دون سابق إنذار ودسوا أنوفهم في شؤوني.
Dialogue: 0,0:25:23.56,0:25:25.69,Default,,0,0,0,,تقريباً كما هو الحال الآن.
Dialogue: 0,0:25:26.56,0:25:28.33,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:25:28.96,0:25:31.33,Default,,0,0,0,,قلت لك نفس الشيء. يعود.
Dialogue: 0,0:25:32.16,0:25:34.20,Default,,0,0,0,,لقد عانيت كثيراً هنا - أحتاج إلى إعادة كل شيء.
Dialogue: 0,0:25:34.80,0:25:37.80,Default,,0,0,0,,ما نوع الكلمات الوقحة التي تتحدث بها؟
Dialogue: 0,0:25:38.27,0:25:40.34,Default,,0,0,0,,افتراء على شيوخك
Dialogue: 0,0:25:40.34,0:25:42.47,Default,,0,0,0,,وتشكو من الحياة.
Dialogue: 0,0:25:43.44,0:25:44.74,Default,,0,0,0,,لقد كنت دائماً هكذا،
Dialogue: 0,0:25:44.74,0:25:47.58,Default,,0,0,0,,ولكن اليوم أعصابك تجاوزت كل الحدود.
Dialogue: 0,0:25:48.38,0:25:52.75,Default,,0,0,0,,أليس لأنك كبرت بلا يد أم؟
Dialogue: 0,0:25:53.49,0:25:55.29,Default,,0,0,0,,يا حماتي.
Dialogue: 0,0:25:57.02,0:25:58.82,Default,,0,0,0,,إذا كنت وقحة، فقد كبرت بدون أم،
Dialogue: 0,0:25:59.83,0:26:02.53,Default,,0,0,0,,إذن أنت وقح لأنك لم تربي طفلك؟
Dialogue: 0,0:26:04.66,0:26:06.00,Default,,0,0,0,,مثير!
Dialogue: 0,0:26:09.90,0:26:12.47,Default,,0,0,0,,كل شيء مزعج للغاية لدرجة أنني لا أستطيع تحمل الحرارة.
Dialogue: 0,0:26:13.77,0:26:15.84,Default,,0,0,0,,صورة لابنك العزيز
Dialogue: 0,0:26:15.84,0:26:17.78,Default,,0,0,0,,كاد أن يحترق.
Dialogue: 0,0:26:18.54,0:26:20.41,Default,,0,0,0,,هل فقدت عقلك؟
Dialogue: 0,0:26:21.18,0:26:23.85,Default,,0,0,0,,نعم بالتأكيد ولا رجعة فيه.
Dialogue: 0,0:26:24.75,0:26:27.55,Default,,0,0,0,,من بين كل المجانين، أنا الأكثر جنوناً.
Dialogue: 0,0:26:29.19,0:26:31.06,Default,,0,0,0,,اذهب وانظر حولك.
Dialogue: 0,0:26:38.76,0:26:41.03,Default,,0,0,0,,حتى لو سقطت شعرة من رأسي،
Dialogue: 0,0:26:44.47,0:26:46.84,Default,,0,0,0,,ولن ترى ابنك بعد الآن.
Dialogue: 0,0:27:17.49,0:27:20.11,Default,,0,0,0,,لم تكن الملكة هي من يدعو للقلق،
Dialogue: 0,0:27:21.54,0:27:23.31,Default,,0,0,0,,وعن الآخرين.
Dialogue: 0,0:27:30.05,0:27:32.85,Default,,0,0,0,,أفضل دفاع هو الهجوم.
Dialogue: 0,0:27:49.74,0:27:53.71,Default,,0,0,0,,واو، لم ألاحظ أنك كنت هنا أيضاً.
Dialogue: 0,0:27:54.57,0:27:57.48,Default,,0,0,0,,هناك أناس أشباح.\Nإنهم يتجولون ولا يلمعون.
Dialogue: 0,0:27:58.94,0:28:01.45,Default,,0,0,0,,أنا أرمي الفطائر في البركة هنا.\Nهل تريد أن تأتي معي؟
Dialogue: 0,0:28:01.45,0:28:02.75,Default,,0,0,0,,ارميها بنفسك.
Dialogue: 0,0:28:05.18,0:28:06.39,Default,,0,0,0,,دفتر الحسابات.
Dialogue: 0,0:28:07.85,0:28:09.29,Default,,0,0,0,,لقد أخذتها.
Dialogue: 0,0:28:11.22,0:28:13.73,Default,,0,0,0,,بسببها كدت أن أموت.
Dialogue: 0,0:28:17.50,0:28:18.53,Default,,0,0,0,,أخبرني.
Dialogue: 0,0:28:20.57,0:28:21.87,Default,,0,0,0,,هل حققت هذا؟
Dialogue: 0,0:28:23.40,0:28:25.67,Default,,0,0,0,,أنت حقاً لم تقتل "أوفول"؟
Dialogue: 0,0:28:27.37,0:28:30.21,Default,,0,0,0,,بغض النظر عما أقوله، فأنت تصدق فقط ما تريد.
Dialogue: 0,0:28:30.21,0:28:32.04,Default,,0,0,0,,يجب أن آخذ الملك منك،
Dialogue: 0,0:28:32.04,0:28:34.21,Default,,0,0,0,,اقتل "أوفول" وألقي جثتها في البئر.
Dialogue: 0,0:28:34.21,0:28:36.32,Default,,0,0,0,,عندها سأصبح شريراً يستحق الموت،
Dialogue: 0,0:28:37.28,0:28:39.38,Default,,0,0,0,,وأنت ضحية بريئة أيها القديس.
Dialogue: 0,0:28:42.82,0:28:45.39,Default,,0,0,0,,ولهذا السبب فإن لعب دور الضحية أمر خطير.
Dialogue: 0,0:28:45.49,0:28:47.13,Default,,0,0,0,,يتحول ببطء إلى وحش -
Dialogue: 0,0:28:49.83,0:28:52.06,Default,,0,0,0,,وأنت نفسك لا تلاحظ.
Dialogue: 0,0:29:08.65,0:29:09.88,Default,,0,0,0,,انظر في المرآة.
Dialogue: 0,0:29:10.65,0:29:12.28,Default,,0,0,0,,انظر إلى قبحك.
Dialogue: 0,0:29:32.64,0:29:34.48,Default,,0,0,0,,تمهل إذا أردت الخروج.
Dialogue: 0,0:29:35.21,0:29:37.61,Default,,0,0,0,,لا مزاج للعمل الصالح.
Dialogue: 0,0:29:56.50,0:29:58.63,Default,,0,0,0,,عندما سقطت في الماء أمام عينيك،
Dialogue: 0,0:30:00.90,0:30:02.13,Default,,0,0,0,,على الأرجح,
Dialogue: 0,0:30:04.37,0:30:06.44,Default,,0,0,0,,كان بإمكانك مد يدك لي.
Dialogue: 0,0:30:11.94,0:30:13.05,Default,,0,0,0,,هذا يثبت
Dialogue: 0,0:30:14.25,0:30:16.88,Default,,0,0,0,,أني كشخص أفضل منك.
Dialogue: 0,0:30:31.53,0:30:33.60,Default,,0,0,0,,كيم جواجيون، قائد القوات،
Dialogue: 0,0:30:35.10,0:30:37.10,Default,,0,0,0,,ترك منصبه.
Dialogue: 0,0:30:38.10,0:30:39.37,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:30:40.01,0:30:41.84,Default,,0,0,0,,تم تأجيل الاستقالة،
Dialogue: 0,0:30:41.84,0:30:44.24,Default,,0,0,0,,يمكنكم جميعاً التوبة عن هذا.
Dialogue: 0,0:30:45.11,0:30:46.18,Default,,0,0,0,,يا له من عار.
Dialogue: 0,0:30:49.15,0:30:51.12,Default,,0,0,0,,انتظر، لقد أخطأت في التعبير.
Dialogue: 0,0:30:51.78,0:30:53.32,Default,,0,0,0,,يا لها من راحة.
Dialogue: 0,0:30:57.72,0:30:59.16,Default,,0,0,0,,السؤال التالي.
Dialogue: 0,0:30:59.16,0:31:02.56,Default,,0,0,0,,ولكن أولاً أريد الإعلان عن شيء ما.
Dialogue: 0,0:31:04.70,0:31:07.67,Default,,0,0,0,,سأنشئ وكالة ستتعامل مع نظام الضرائب الثلاث.
Dialogue: 0,0:31:07.80,0:31:11.10,Default,,0,0,0,,سيُطلق عليه اسم Samjeong Lijeongjeon.
Dialogue: 0,0:31:11.77,0:31:14.61,Default,,0,0,0,,سامجونغ ليجونغجيونغ؟
Dialogue: 0,0:31:16.21,0:31:18.34,Default,,0,0,0,,سيضع القوانين
Dialogue: 0,0:31:18.34,0:31:20.38,Default,,0,0,0,,وسيضع الخطط لحلها
Dialogue: 0,0:31:20.51,0:31:22.78,Default,,0,0,0,,أهم عيوب نظام الضرائب الثلاث.
Dialogue: 0,0:31:25.55,0:31:27.85,Default,,0,0,0,,تعيش البلاد على الزراعة.
Dialogue: 0,0:31:28.69,0:31:30.62,Default,,0,0,0,,يزدهر الفلاحون، وكذلك هي.
Dialogue: 0,0:31:30.76,0:31:33.83,Default,,0,0,0,,المسؤولون يذبحون المزارعين العاديين،
Dialogue: 0,0:31:33.83,0:31:35.76,Default,,0,0,0,,- تهديد للدولة.
Dialogue: 0,0:31:36.36,0:31:39.70,Default,,0,0,0,,أعمالهم الوحشية ستعتبر خيانة.
Dialogue: 0,0:31:40.07,0:31:43.50,Default,,0,0,0,,قبل إنشاء قسم جديد، عليك دراسة كل شيء بعناية.
Dialogue: 0,0:31:44.10,0:31:46.51,Default,,0,0,0,,على الأقل استمع لرأينا قبل...
Dialogue: 0,0:31:46.51,0:31:50.08,Default,,0,0,0,,لن أقدم تنازلات،\Nأفعل ما يجب علي فعله.
Dialogue: 0,0:31:51.41,0:31:52.48,Default,,0,0,0,,هذا يعني،
Dialogue: 0,0:31:53.31,0:31:55.95,Default,,0,0,0,,أن رأيك لم يعد يهم.
Dialogue: 0,0:32:03.22,0:32:05.99,Default,,0,0,0,,سأهديها أيضاً للملك الراحل سيونغجونغ
Dialogue: 0,0:32:06.86,0:32:10.60,Default,,0,0,0,,اسم "سونجو" بعد وفاته، كما يقتضي التقليد.
Dialogue: 0,0:32:17.17,0:32:20.37,Default,,0,0,0,,جلالته أكثر حزماً من المعتاد اليوم.
Dialogue: 0,0:32:27.05,0:32:28.25,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:32:28.85,0:32:31.02,Default,,0,0,0,,هناك موعد جديد اليوم.
Dialogue: 0,0:32:31.92,0:32:33.95,Default,,0,0,0,,أخطأ كبير السكرتيرين في الكلام.
Dialogue: 0,0:32:34.62,0:32:36.42,Default,,0,0,0,,نحن نتحدث عن اقتراح الترشيح.
Dialogue: 0,0:32:37.72,0:32:40.29,Default,,0,0,0,,منصب وزير الحربية مجاني.
Dialogue: 0,0:32:41.06,0:32:44.50,Default,,0,0,0,,الجيش الضعيف سيؤدي إلى أزمة في جميع أنحاء البلاد.
Dialogue: 0,0:32:44.50,0:32:46.80,Default,,0,0,0,,لذلك أصر على موافقتك
Dialogue: 0,0:32:46.80,0:32:49.47,Default,,0,0,0,,المرشح الذي اختاره المجلس العسكري.
Dialogue: 0,0:32:50.97,0:32:52.57,Default,,0,0,0,,وزير الحرب قادم.
Dialogue: 0,0:33:15.86,0:33:17.60,Default,,0,0,0,,كيم بيونين، وزير الحرب،
Dialogue: 0,0:33:20.47,0:33:21.94,Default,,0,0,0,,تحياتي لجلالتك.
Dialogue: 0,0:33:35.75,0:33:39.12,Default,,0,0,0,,يمكن أن يكون "كيم بيونين" خطيرًا - فهو مدعوم من عائلة "تشو".
Dialogue: 0,0:33:40.39,0:33:41.59,Default,,0,0,0,,وتشو وكيم
Dialogue: 0,0:33:41.59,0:33:43.82,Default,,0,0,0,,سأل عنه.
Dialogue: 0,0:33:43.96,0:33:45.62,Default,,0,0,0,,يجب أن يكون هذا من فعله أيضاً.
Dialogue: 0,0:33:48.39,0:33:50.83,Default,,0,0,0,,لا أعتقد أنه يمكننا أن نغض الطرف عن طلباتهم.
Dialogue: 0,0:33:50.83,0:33:54.57,Default,,0,0,0,,قد يمنح هذا الأرستقراطيين سبباً للثورة.
Dialogue: 0,0:33:57.04,0:33:58.54,Default,,0,0,0,,الآن أنت حر في القيام بذلك،
Dialogue: 0,0:33:58.54,0:34:00.31,Default,,0,0,0,,كل ما تريد.
Dialogue: 0,0:34:00.31,0:34:02.21,Default,,0,0,0,,لكن لا يزال من الصعب إيقاف هجماتهم.
Dialogue: 0,0:34:02.21,0:34:05.11,Default,,0,0,0,,أفضل دفاع هو الهجوم.
Dialogue: 0,0:34:05.61,0:34:07.01,Default,,0,0,0,,أحتاج إلى الضرب
Dialogue: 0,0:34:07.01,0:34:09.88,Default,,0,0,0,,أسرع من الخصم.
Dialogue: 0,0:34:11.45,0:34:13.19,Default,,0,0,0,,ليس هناك وقت لتجنيد المزيد من الجنود.
Dialogue: 0,0:34:13.82,0:34:16.25,Default,,0,0,0,,أريدك أن تعتني بليجونشون.
Dialogue: 0,0:34:16.42,0:34:18.62,Default,,0,0,0,,عزيزتي، سأرسل لك
Dialogue: 0,0:34:18.62,0:34:20.09,Default,,0,0,0,,إلى 3 مدن في الجنوب.
Dialogue: 0,0:34:20.09,0:34:22.56,Default,,0,0,0,,الناس هناك ساخطون - ابدأ التحقيق.
Dialogue: 0,0:34:24.30,0:34:25.60,Default,,0,0,0,,رحلة عمل أخرى؟
Dialogue: 0,0:34:29.60,0:34:30.80,Default,,0,0,0,,حسناً، من أجلي.
Dialogue: 0,0:34:32.17,0:34:36.01,Default,,0,0,0,,كلما توغلت في الغابة، كلما جلستما هنا وأعطتا الأوامر.
Dialogue: 0,0:34:36.01,0:34:38.84,Default,,0,0,0,,يبدو أن كل الركض يقع على عاتقي. أم أنني مخطئ؟
Dialogue: 0,0:34:38.84,0:34:41.35,Default,,0,0,0,,ليس عليك فقط. أنا دائما...
Dialogue: 0,0:34:43.68,0:34:45.28,Default,,0,0,0,,عندما تنتهي من التحقيق،
Dialogue: 0,0:34:46.52,0:34:48.79,Default,,0,0,0,,-يمكنني أن أعطيك إجازة.\N-سأغادر.
Dialogue: 0,0:34:49.15,0:34:51.32,Default,,0,0,0,,يمكنني ذلك.
Dialogue: 0,0:34:51.56,0:34:53.26,Default,,0,0,0,,قلت إنني أستطيع ذلك.
Dialogue: 0,0:34:53.26,0:34:55.56,Default,,0,0,0,,أشك في أنه سمع ذلك.
Dialogue: 0,0:34:55.89,0:34:57.40,Default,,0,0,0,,يا له من أحمق.
Dialogue: 0,0:35:02.50,0:35:03.77,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:35:04.20,0:35:07.01,Default,,0,0,0,,لديك خطاب.
Dialogue: 0,0:35:09.34,0:35:11.18,Default,,0,0,0,,لن أقتلك، اقترب.
Dialogue: 0,0:35:18.55,0:35:22.62,Default,,0,0,0,,لقد أرسلت لك الملكة رسالة.
Dialogue: 0,0:35:25.79,0:35:27.63,Default,,0,0,0,,هل أنت مريض؟
Dialogue: 0,0:35:31.36,0:35:32.70,Default,,0,0,0,,تهتز مثل ورقة الخريف.
Dialogue: 0,0:35:36.54,0:35:41.21,Default,,0,0,0,,لم يكن الانتقام كما ظننت.\NIt كان ينبغي أن يكون أكثر متعة.
Dialogue: 0,0:35:47.11,0:35:48.55,Default,,0,0,0,,كم هو مثير.
Dialogue: 0,0:35:49.41,0:35:50.45,Default,,0,0,0,,أنا أرتجف في كل مكان.
Dialogue: 0,0:35:57.86,0:35:59.02,Default,,0,0,0,,جلالة الملك...
Dialogue: 0,0:36:06.80,0:36:07.80,Default,,0,0,0,,لقد وصلت.
Dialogue: 0,0:36:13.54,0:36:16.64,Default,,0,0,0,,أنت اليوم جميلة بشكل خاص.
Dialogue: 0,0:36:17.28,0:36:18.78,Default,,0,0,0,,إنه يناسبك جداً.
Dialogue: 0,0:36:18.94,0:36:20.81,Default,,0,0,0,,كل شيء يناسب الوجه الجميل.
Dialogue: 0,0:36:20.81,0:36:22.58,Default,,0,0,0,,سأكون جميلة حتى في المنبوذين.
Dialogue: 0,0:36:23.98,0:36:26.32,Default,,0,0,0,,من كان يعلم أنني سأصبح ملكة عظيمة.
Dialogue: 0,0:36:29.79,0:36:31.96,Default,,0,0,0,,لن أعتاد على هذا أبداً.
Dialogue: 0,0:36:33.19,0:36:34.99,Default,,0,0,0,,لقد طلبت لقاءً،
Dialogue: 0,0:36:37.00,0:36:38.23,Default,,0,0,0,,لاقتراح التحالف.
Dialogue: 0,0:36:39.60,0:36:42.49,Default,,0,0,0,,ربما تركني رود،\Nمعتقداً أنني الآن معك في نفس الوقت.
Dialogue: 0,0:36:42.87,0:36:44.20,Default,,0,0,0,,ليس لدي ما أخسره.
Dialogue: 0,0:36:44.50,0:36:46.40,Default,,0,0,0,,إذا اخترت جانبي،
Dialogue: 0,0:36:46.77,0:36:48.84,Default,,0,0,0,,عائلة "كيم" ستصبح عدوك.
Dialogue: 0,0:36:48.84,0:36:50.58,Default,,0,0,0,,لقد خدعوني أولاً.
Dialogue: 0,0:36:50.98,0:36:52.74,Default,,0,0,0,,الآن سأرميهم.
Dialogue: 0,0:36:53.41,0:36:55.04,Default,,0,0,0,,العدو المشترك ليس سبباً للتوحد؟
Dialogue: 0,0:37:05.82,0:37:06.86,Default,,0,0,0,,نعم.
Dialogue: 0,0:37:09.19,0:37:12.46,Default,,0,0,0,,لا يوجد تباعد اجتماعي من الآن فصاعداً.
Dialogue: 0,0:37:12.73,0:37:15.07,Default,,0,0,0,,بالطبع. يمكنك لمس كل شيء.
Dialogue: 0,0:37:19.30,0:37:20.54,Default,,0,0,0,,في أفلام عن قطاع الطرق
Dialogue: 0,0:37:20.54,0:37:22.84,Default,,0,0,0,,رأيت أصدقائي يخلطون الدم في كوب ويشربون.
Dialogue: 0,0:37:23.14,0:37:25.88,Default,,0,0,0,,لكن الدم غير صحي إلى حدٍ ما.
Dialogue: 0,0:37:26.51,0:37:28.81,Default,,0,0,0,,دعونا نحتفل بالاتحاد مع الشاي.
Dialogue: 0,0:37:28.81,0:37:29.95,Default,,0,0,0,,بسيطة ولذيذة.
Dialogue: 0,0:37:37.99,0:37:39.02,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:37:41.66,0:37:44.13,Default,,0,0,0,,أهكذا يشرب الحلفاء؟
Dialogue: 0,0:37:44.13,0:37:46.03,Default,,0,0,0,,نعم للأخوة.
Dialogue: 0,0:37:46.03,0:37:48.40,Default,,0,0,0,,-إلى الأسفل.\N-ماذا...
Dialogue: 0,0:37:54.94,0:37:58.38,Default,,0,0,0,,بما أننا إخوة، فلنجعل كل شيء واضحاً.
Dialogue: 0,0:37:59.21,0:38:00.58,Default,,0,0,0,,لماذا أردت قتلي؟
Dialogue: 0,0:38:03.35,0:38:04.38,الافتراضي,,0,0,0,,صحيح.
Dialogue: 0,0:38:05.75,0:38:07.95,Default,,0,0,0,,هذا يستحق المناقشة.
Dialogue: 0,0:38:09.89,0:38:11.76,Default,,0,0,0,,كنا نظن أنك سمعت محادثتنا
Dialogue: 0,0:38:11.76,0:38:13.49,Default,,0,0,0,,عن محاولة اغتيال والدك.
Dialogue: 0,0:38:14.86,0:38:16.66,Default,,0,0,0,,لا يزال والد زوجك.
Dialogue: 0,0:38:16.83,0:38:19.66,Default,,0,0,0,,بالنسبة لي كان أحد المسؤولين الفاسدين.
Dialogue: 0,0:38:19.93,0:38:21.30,Default,,0,0,0,,قاسٍ.
Dialogue: 0,0:38:21.87,0:38:24.00,Default,,0,0,0,,كل شيء واضح معك.\Nولم يشفق على زوجته.
Dialogue: 0,0:38:24.30,0:38:25.74,Default,,0,0,0,,القاتل المتسلسل كيموف.
Dialogue: 0,0:38:26.74,0:38:27.87,Default,,0,0,0,,عذراً.
Dialogue: 0,0:38:28.81,0:38:30.81,Default,,0,0,0,,أعلم أن اعتذاري لن يغير الكثير،
Dialogue: 0,0:38:31.91,0:38:34.05,Default,,0,0,0,,ولكن كان هناك الكثير من سوء التفاهم بيننا.
Dialogue: 0,0:38:35.15,0:38:36.15,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:38:37.02,0:38:38.58,Default,,0,0,0,,سوف تدين لي.
Dialogue: 0,0:38:38.58,0:38:40.29,Default,,0,0,0,,لن أسامحك حتى ترد الجميل.
Dialogue: 0,0:38:42.29,0:38:43.89,Default,إطلاق النار,0,0,0,,فماذا تريد إذن؟
Dialogue: 0,0:38:44.26,0:38:45.36,Default,تصويب,0,0,0,,تقوي قوتك؟
Dialogue: 0,0:38:45.36,0:38:49.63,Default,shooting,0,0,0,,هذه مجرد طريقة لاستعادة بلدنا المدمر.
Dialogue: 0,0:38:50.73,0:38:53.40,Default,shooting,0,0,0,,لا أعتقد أنه يمكن تغيير أسس المجتمع بسهولة.
Dialogue: 0,0:38:53.97,0:38:56.53,Default,التصويب,0,0,0,,بصراحة، أحب الطريقة أكثر من الهدف.
Dialogue: 0,0:38:56.84,0:38:58.77,Default,التصويب,0,0,0,,إذا عززت قوتك،
Dialogue: 0,0:38:59.34,0:39:01.14,Default,معرض التصوير,0,0,0,,إذن لن يتمكن أحد من الوصول إلي.
Dialogue: 0,0:39:02.71,0:39:05.24,Default,إطلاق النار,0,0,0,,أدرك جيداً الخوف من الموت.
Dialogue: 0,0:39:06.21,0:39:10.01,Default,shooting,0,0,0,,أعلم أنك وقحة،\Nلكن لا بد أنك خائفة.
Dialogue: 0,0:39:10.68,0:39:11.68,Default,إطلاق النار,0,0,0,,لا أعرف.
Dialogue: 0,0:39:12.15,0:39:14.05,Default,معرض الرماية,0,0,0,,ربما لأنها كانت تحتضر بالفعل؟
Dialogue: 0,0:39:14.05,0:39:15.85,Default,shooting,0,0,0,,بالنسبة لي الإهمال أسوأ من الموت.
Dialogue: 0,0:39:16.79,0:39:20.19,Default,shooting,0,0,0,,إذا كان بإمكاني أن أضرب كل من يحتقرني،
Dialogue: 0,0:39:21.69,0:39:23.50,Default,إطلاق النار,0,0,0,,ثم سأموت مبتسماً.
Dialogue: 0,0:39:26.10,0:39:27.17,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:39:27.57,0:39:30.10,Default,إطلاق النار,0,0,0,,حان وقت طهي العشاء.
Dialogue: 0,0:39:30.10,0:39:32.34,Default,التصويب,0,0,0,,نعم. حسنًا إذن
Dialogue: 0,0:39:33.94,0:39:35.34,Default,إطلاق النار,0,0,0,,أتركك.
Dialogue: 0,0:39:52.46,0:39:54.39,Default,إطلاق النار,0,0,0,,سأموت مبتسماً.
Dialogue: 0,0:39:55.36,0:39:56.86,Default,إطلاق النار,0,0,0,,"سأموت مبتسماً."
Dialogue: 0,0:40:13.58,0:40:16.41,Default,التصويب,0,0,0,,-السيد. كيم.\N-بيونين.
Dialogue: 0,0:40:17.18,0:40:19.82,Default,إطلاق النار,0,0,0,,أي وزير الحرب.
Dialogue: 0,0:40:20.49,0:40:23.35,Default,معرض الرماية,0,0,0,,-هل تمزح معي؟\N-ما أنت، بالطبع لا.
Dialogue: 0,0:40:23.76,0:40:25.52,Default,إطلاق النار,0,0,0,,من فضلك نادني بالاسم.
Dialogue: 0,0:40:25.76,0:40:28.09,Default,معرض التصوير,0,0,0,,في الواقع، كنت أنتظرك،
Dialogue: 0,0:40:29.19,0:40:32.40,Default,تصويب,0,0,0,,لأنني أردت أن أتحدث معك عن الملكة.
Dialogue: 0,0:40:33.63,0:40:37.87,Default,shooting,0,0,0,,وبالمناسبة، لدي أيضًا ما أخبرك به بشأن هذا الموضوع.
Dialogue: 0,0:40:49.28,0:40:51.82,Default,نطاق الرماية,0,0,0,,أين وضعت هذا؟
Dialogue: 0,0:40:52.42,0:40:54.85,Default,معرض التصوير,0,0,0,,إلى أين؟
Dialogue: 0,0:40:57.19,0:41:00.19,Default,معرض التصوير,0,0,0,,-انتظر.\N-لقد رأيته.
Dialogue: 0,0:41:05.66,0:41:06.66,Default,التصويب,0,0,0,,أنت!
Dialogue: 0,0:41:07.20,0:41:10.74,Default,إطلاق النار,0,0,0,,كيف تجرؤ على استخدام السكين؟ \NYou've كان هنا لمدة أسبوع تقريبا.
Dialogue: 0,0:41:13.20,0:41:15.07,Default,التصويب,0,0,0,,الآن تغير كل شيء.
Dialogue: 0,0:41:15.07,0:41:19.64,Default,tira,0,0,0,,في الآونة الأخيرة، يرفض الطهاة شرب الماكغولي بعد العمل.
Dialogue: 0,0:41:19.64,0:41:22.01,Default,تصويب,0,0,0,,يقولون "لا" و"لا" باستمرار.
Dialogue: 0,0:41:22.01,0:41:24.82,Default,shooting,0,0,0,,قلت إنني سأعالجهم، لكنهم ما زالوا يرفضون.
Dialogue: 0,0:41:24.82,0:41:25.82,Default,تصويب,0,0,0,,اذهب وافهمهم.
Dialogue: 0,0:41:26.35,0:41:30.86,Default,إطلاق النار,0,0,0,,أنا لا أفهم سيدات البلاط هؤلاء أيضاً.
Dialogue: 0,0:41:31.76,0:41:35.89,Default,dash,0,0,0,,أخبرتهم أن يأتوا لاحقاً، وقد جاءوا لاحقاً حقاً.
Dialogue: 0,0:41:35.89,0:41:38.73,Default,إطلاق النار,0,0,0,,كان ينبغي عليهم أن يصلوا مسبقاً.
Dialogue: 0,0:41:39.50,0:41:41.17,Default,shooting,0,0,0,,-حسناً، أي نوع من الأطفال رحلوا.\N-حسناً، أي نوع من الأطفال رحلوا.
Dialogue: 0,0:41:44.84,0:41:45.97,Default,معرض الرماية,0,0,0,,إلى قاعة Dongmyeongjong.
Dialogue: 0,0:41:53.61,0:41:54.61,Default,معرض الرماية,0,0,0,,يا إلهي.
Dialogue: 0,0:41:55.65,0:41:57.68,Default,معرض الرماية,0,0,0,,يتبقى شيء آخر للانتقام منه.
Dialogue: 0,0:41:58.38,0:41:59.58,Default,إطلاق النار,0,0,0,,وصفة للانتقام؟
Dialogue: 0,0:42:03.92,0:42:06.06,Default,تصويب,0,0,0,,يمكنني أن أجيبه بالمثل، أليس كذلك؟
Dialogue: 0,0:42:06.62,0:42:08.46,Default,التصويب,0,0,0,,العين بالعين. سن للسن.
Dialogue: 0,0:42:08.86,0:42:10.40,Default,تصويب,0,0,0,,الرجولة من أجل كرامة الرجل.
Dialogue: 0,0:42:11.80,0:42:14.20,Default,tyra,0,0,0,,ثم السرخس؟
Dialogue: 0,0:42:15.70,0:42:17.57,Default,tyra,0,0,0,,-نبات مطرز؟\N-نبات السرخس والنبات مطرز.
Dialogue: 0,0:42:17.57,0:42:19.87,Default,tyra,0,0,0,,تحتوي هذه الوصفة على الكثير من المكونات المفيدة.
Dialogue: 0,0:42:20.31,0:42:22.27,Default,shooting,0,0,0,,لذلك سأذهب إلى الأبد نحو هدفي.
Dialogue: 0,0:42:22.61,0:42:24.18,Default,التصويب,0,0,0,,هذا طويل جدًا.
Dialogue: 0,0:42:26.44,0:42:27.71,Default,معرض التصوير,0,0,0,,دعونا نتدخل.
Dialogue: 0,0:42:30.01,0:42:31.98,Default,إطلاق النار,0,0,0,,-الإخصاء.\N-الإخصاء؟
Dialogue: 0,0:42:33.45,0:42:34.62,Default,إطلاق النار,0,0,0,,لم أسمع...
Dialogue: 0,0:42:37.86,0:42:39.49,Default,التصويب,0,0,0,,فهمت.
Dialogue: 0,0:42:40.19,0:42:41.43,Default,tyra,0,0,0,,هذا العنصر القيم.
Dialogue: 0,0:42:46.06,0:42:47.83,Default,إطلاق النار,0,0,0,,لا أريد أن أثقل كاهلك.
Dialogue: 0,0:42:48.43,0:42:51.24,Default,التصويب,0,0,0,,أعرف متى أستسلم.
Dialogue: 0,0:42:51.84,0:42:53.14,Default,التصويب,0,0,0,,عذراً.
Dialogue: 0,0:42:53.20,0:42:54.34,Default,إطلاق النار,0,0,0,,لا تعتذر.
Dialogue: 0,0:42:56.37,0:43:00.11,Default,إطلاق النار,0,0,0,,هل يمكنني أن أطرح عليك سؤالاً واحداً فقط؟
Dialogue: 0,0:43:00.75,0:43:02.75,Default,إطلاق النار,0,0,0,,-نعم.\N-لماذا تفعل ذلك؟
Dialogue: 0,0:43:03.65,0:43:05.85,Default,تصويب,0,0,0,,ألا تحبين الرجال الهادفين؟
Dialogue: 0,0:43:08.42,0:43:12.52,Default,معرض الرماية,0,0,0,,رأيت في القصر الكثير من الأشخاص الهادفين
Dialogue: 0,0:43:13.59,0:43:15.89,Default,التصويب,0,0,0,,وكم كان الأمر صعباً عليهم.
Dialogue: 0,0:43:16.43,0:43:17.96,Default,إطلاق النار,0,0,0,,أخشى
Dialogue: 0,0:43:18.63,0:43:20.33,Default,إطلاق النار,0,0,0,,ولا أريد هذا لنفسي.
Dialogue: 0,0:43:23.13,0:43:24.74,Default,داش,0,0,0,,شكرًا على ردك.
Dialogue: 0,0:43:35.05,0:43:38.22,Default,shooting,0,0,0,,كل ما أجرؤ على أن أريده منك،
Dialogue: 0,0:43:39.68,0:43:41.62,Default,التصويب,0,0,0,,حتى تكون دائمًا
Dialogue: 0,0:43:42.92,0:43:44.12,Default,التصويب,0,0,0,,ابتسم.
Dialogue: 0,0:43:44.52,0:43:45.92,Default,إطلاق النار,0,0,0,,أوه، هذا أنت.
Dialogue: 0,0:43:50.60,0:43:51.60,Default,إطلاق النار,0,0,0,,على ما يبدو، هذه هي النهاية.
Dialogue: 0,0:43:51.60,0:43:53.87,Default,تصويب,0,0,0,,لديك عين ثاقبة حقًا.
Dialogue: 0,0:43:54.23,0:43:55.47,Default,معرض التصوير,0,0,0,,لقد فهمت كل شيء على الفور.
Dialogue: 0,0:43:55.63,0:43:58.67,Default,shooting,0,0,0,,كيف لا أفهم عندما تبكي بهذه الطريقة؟
Dialogue: 0,0:44:00.27,0:44:01.47,Default,إطلاق النار,0,0,0,,لا تنظر.
Dialogue: 0,0:44:04.08,0:44:07.41,Default,إطلاق النار,0,0,0,,لا أريد أن يراني هكذا.
Dialogue: 0,0:44:08.65,0:44:10.98,Default,معرض التصوير,0,0,0,,ثم اذهب إلى الزاوية وابكي هناك.
Dialogue: 0,0:44:10.98,0:44:13.42,Default,تصويب,0,0,0,,سيظل الناس يقررون أن هذا بسببي.
Dialogue: 0,0:44:14.32,0:44:15.55,Default,إطلاق النار,0,0,0,,ليس بسببي.
Dialogue: 0,0:44:18.76,0:44:20.36,Default,إطلاق النار,0,0,0,,لن أبكي بعد الآن.
Dialogue: 0,0:44:21.36,0:44:24.76,Default,shooting,0,0,0,,القدرة على التخلص تماماً من المشاعر هي جزء من الحب.
Dialogue: 0,0:44:25.23,0:44:29.17,Default,dash,0,0,0,,قد يكون هذا أصعب من الاستمرار في حبها.
Dialogue: 0,0:44:30.00,0:44:31.57,Default,تصويب,0,0,0,,أنت شاعر تمامًا.
Dialogue: 0,0:44:32.64,0:44:34.94,Default,نطاق الرماية,0,0,0,,لنذهب. لا تبكي.
Dialogue: 0,0:44:40.31,0:44:44.02,Default,tyra,0,0,0,,هل أرسلت لي الطعام عمداً؟
Dialogue: 0,0:44:52.16,0:44:53.89,Default,تصويب,0,0,0,,ما هذا الرسم المشؤوم؟
Dialogue: 0,0:44:53.89,0:44:57.50,Default,معرض التصوير,0,0,0,,كم هو جميل.
Dialogue: 0,0:44:58.13,0:45:00.73,Default,معرض الرماية,0,0,0,,سيدة البلاط تشون، حتى السم لن يأخذك،
Dialogue: 0,0:45:00.83,0:45:02.50,Default,تصويب,0,0,0,,أنت بطيء جدًا في التفكير.
Dialogue: 0,0:45:03.94,0:45:06.27,Default,تصويب,0,0,0,,لماذا تمدحني فجأة؟
Dialogue: 0,0:45:25.59,0:45:26.89,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:45:27.59,0:45:32.90,Default,tyra,0,0,0,,أنا سيمون من عائلة خان، جئت لأحييك.
Dialogue: 0,0:45:37.90,0:45:39.77,Default,إطلاق النار,0,0,0,,ألم نلتقي من قبل؟
Dialogue: 0,0:45:44.61,0:45:45.88,Default,التصويب,0,0,0,,أنا ممتن جدًا.
Dialogue: 0,0:45:46.81,0:45:49.51,Default,shooting,0,0,0,,هذا هو، أنا... أرجوك سامحني.
Dialogue: 0,0:45:50.75,0:45:53.15,Default,تصويب,0,0,0,,أعتقد أنك يجب أن تخبرني بشيء آخر.
Dialogue: 0,0:45:53.48,0:45:54.69,Default,شرطة,0,0,0,,على سبيل المثال،
Dialogue: 0,0:45:55.89,0:45:57.92,Default,dash,0,0,0,"أنا أستحق أن أموت."
Dialogue: 0,0:45:59.19,0:46:02.56,Default,dash,0,0,0,,بسببك سكبت كل الفشار الذي عملت عليه بجد.
Dialogue: 0,0:46:02.86,0:46:05.00,Default,إطلاق النار,0,0,0,,تناثر عندما أرسلته يطير.
Dialogue: 0,0:46:05.70,0:46:09.60,Default,تصويب,0,0,0,,لم يكن لدي أي فكرة عن وجود ملكة أمامي،
Dialogue: 0,0:46:10.64,0:46:14.57,Default,إطلاق النار,0,0,0,,لقد ارتكبت جريمة خطيرة.
Dialogue: 0,0:46:16.71,0:46:18.24,Default,إطلاق النار,0,0,0,,لم يكن لدي أي فكرة أنه أنا؟
Dialogue: 0,0:46:20.48,0:46:21.48,Default,معرض الرماية,0,0,0,,إذن لماذا هربت؟
Dialogue: 0,0:46:21.48,0:46:23.58,Default,إطلاق النار,0,0,0,,حسناً، هذا بسبب...
Dialogue: 0,0:46:23.58,0:46:26.32,Default,إطلاق النار,0,0,0,,هذا الرجل النبيل ركض ورائي،
Dialogue: 0,0:46:26.32,0:46:28.05,Default,معرض التصوير,0,0,0,,ففوجئت.
Dialogue: 0,0:46:28.49,0:46:31.72,Default,إطلاق النار,0,0,0,,لم يكن لدي أي أسباب أخرى.
Dialogue: 0,0:46:31.82,0:46:32.92,Default,إطلاق النار,0,0,0,,حقاً؟
Dialogue: 0,0:46:37.53,0:46:39.53,Default,إطلاق النار,0,0,0,,في الحقيقة، لقد اتصلت بك،
Dialogue: 0,0:46:42.83,0:46:44.70,Default,إطلاق النار,0,0,0,,لإعطائك مكاناً في المحكمة.
Dialogue: 0,0:46:46.67,0:46:49.71,Default,معرض الرماية,0,0,0,,مكان جيد حيث لن يتم طردك بالتأكيد
Dialogue: 0,0:46:49.71,0:46:50.78,Default,التصويب,0,0,0,,وسيدفعون جيداً.
Dialogue: 0,0:46:52.41,0:46:53.98,Default,معرض التصوير,0,0,0,,ولكن عليك أن تخسر شيئاً ما.
Dialogue: 0,0:46:55.01,0:46:56.08,Default,إطلاق النار,0,0,0,,ماذا؟
Dialogue: 0,0:46:57.92,0:46:59.28,Default,معرض التصوير,0,0,0,,هل تقول أنني سأفقد شيئًا ما؟
Dialogue: 0,0:47:00.95,0:47:03.86,Default,tira,0,0,0,,عندما التقيتك، حتى لو كان ذلك لفترة قصيرة،
Dialogue: 0,0:47:04.09,0:47:05.89,Default,tira,0,0,0,,فهمت أن هذا المنصب مناسب لك.
Dialogue: 0,0:47:05.89,0:47:07.43,Default,تصويب,0,0,0,,أنا ممتنة جداً لك أيتها الملكة.
Dialogue: 0,0:47:11.13,0:47:12.20,افتراضي,إطلاق النار,0,0,0,,أنت
Dialogue: 0,0:47:13.30,0:47:14.77,Default,tyra,0,0,0,,سوف تصبح خصياً.
Dialogue: 0,0:47:14.97,0:47:16.07,Default,إطلاق النار,0,0,0,,ماذا؟
Dialogue: 0,0:47:17.50,0:47:19.54,Default,التصويب,0,0,0,,انتظر. مجرد ثانية.
Dialogue: 0,0:47:19.54,0:47:21.81,Default,إطلاق النار,0,0,0,,دعني أذهب. ارفعوا أيديكم.
Dialogue: 0,0:47:23.64,0:47:24.71,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:47:25.08,0:47:26.74,Default,إطلاق النار,0,0,0,,من فضلك ارحمني.
Dialogue: 0,0:47:26.74,0:47:28.48,Default,dash,0,0,0,,شكرًا لك على كرمك اللامحدود.
Dialogue: 0,0:47:28.48,0:47:30.65,Default,إطلاق النار,0,0,0,,ولكن لماذا تفعل هذا؟
Dialogue: 0,0:47:32.08,0:47:33.08,Default,التصويب,0,0,0,,بادئ ذي بدء،
Dialogue: 0,0:47:33.08,0:47:35.65,Default,tyra,0,0,0,,لقد زيّفت هويتك كرجل نبيل.
Dialogue: 0,0:47:36.45,0:47:38.26,Default,شرطة,0,0,0,,لا. هذا ليس خطأك.
Dialogue: 0,0:47:38.29,0:47:40.86,Default,shooting,0,0,0,,البنية الاجتماعية هي المسؤولة عن هذا.
Dialogue: 0,0:47:41.03,0:47:42.46,افتراضي,تصويب,0,0,0,,صحيح.
Dialogue: 0,0:47:43.83,0:47:44.90,Default,شرطة,0,0,0,,أولاً. أولاً،
Dialogue: 0,0:47:45.20,0:47:46.96,Default,تايرا,0,0,0,,سمم الماء في المطبخ الملكي
Dialogue: 0,0:47:46.96,0:47:49.07,Default,معرض التصوير,0,0,0,,وعطل الوليمة الملكية.
Dialogue: 0,0:47:50.53,0:47:51.67,Default,التصويب,0,0,0,,ثانياً،
Dialogue: 0,0:47:52.07,0:47:53.74,Default,tyra,0,0,0,,سليلك شخص فظيع.
Dialogue: 0,0:47:55.07,0:47:56.07,Default,تصويب,0,0,0,,السليل؟
Dialogue: 0,0:47:56.27,0:47:59.61,Default,dash,0,0,0,,هل أنت متأكد من أنك لم تخلط الأمر مع سلفي؟
Dialogue: 0,0:48:00.48,0:48:01.55,افتراضي,إطلاق النار,0,0,0,,لا.
Dialogue: 0,0:48:02.65,0:48:03.75,Default,إطلاق النار,0,0,0,,هذا صحيح.
Dialogue: 0,0:48:06.85,0:48:09.29,Default,tyra,0,0,0,,سليلك شخص فظيع.
Dialogue: 0,0:48:09.69,0:48:11.02,Default,تصويب,0,0,0,,السليل؟
Dialogue: 0,0:48:12.26,0:48:13.49,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:48:13.49,0:48:15.46,Default,tyra,0,0,0,,سأصبح خصيًا - ولن يكون هناك أحفاد.
Dialogue: 0,0:48:15.46,0:48:17.93,Default,tyra,0,0,0,,سأصبح خصيًا - ولن يكون هناك أحفاد. جلالتك!
Dialogue: 0,0:48:18.90,0:48:21.23,Default,shooting,0,0,0,,لن يكون لدي أحفاد.
Dialogue: 0,0:48:21.33,0:48:23.33,Default,tyra,0,0,0,,هل لديك أحفاد؟ لا؟
Dialogue: 0,0:48:23.43,0:48:26.04,Default,shooting,0,0,0,,لن يكون لدي أي أحفاد!
Dialogue: 0,0:48:26.04,0:48:29.37,Default,معرض التصوير,0,0,0,,كيف ذلك. ملكة!
Dialogue: 0,0:48:34.91,0:48:38.52,Default,نطاق الرماية,0,0,0,,جلالة الملك، وزير الحربية قد وصل.
Dialogue: 0,0:48:48.73,0:48:49.96,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:48:50.63,0:48:52.06,Default,tyra,0,0,0,,عشيرة أندون كيم.
Dialogue: 0,0:48:52.36,0:48:54.27,Default,إطلاق النار,0,0,0,,أنا متأكد من أنهم جميعاً متعاونون.
Dialogue: 0,0:48:54.97,0:48:57.10,Default,tyra,0,0,0,,ولكن والدي أيضاً من عائلة "أندون" لكيم.
Dialogue: 0,0:48:57.27,0:49:00.47,Default,إطلاق النار,0,0,0,,ماذا؟ لقد دعوته للتو بـ "والدي".
Dialogue: 0,0:49:03.71,0:49:05.81,Default,إطلاق النار,0,0,0,,نقل المشاعر أمر خطير.
Dialogue: 0,0:49:08.11,0:49:11.12,Default,إطلاق النار,0,0,0,,اكتشفت ما حدث لك بعد لقائنا.
Dialogue: 0,0:49:12.72,0:49:14.12,Default,إطلاق النار,0,0,0,,لم أعرف ماذا حدث.
Dialogue: 0,0:49:14.65,0:49:16.15,Default,إطلاق النار,0,0,0,,أنت لا تعلم،
Dialogue: 0,0:49:16.79,0:49:18.09,Default,إطلاق النار,0,0,0,,أنهم حاولوا قتلي؟
Dialogue: 0,0:49:18.09,0:49:21.19,Default,tyra,0,0,0,,أنا لست من جهة والدي، ولا أنتمي إلى عائلة كيم.
Dialogue: 0,0:49:22.09,0:49:24.63,Default,shooting,0,0,0,,لكنك لست خالياً من والدك وعائلتك.
Dialogue: 0,0:49:26.63,0:49:28.33,Default,التصويب,0,0,0,,في النهاية سوف تفهم.
Dialogue: 0,0:49:40.68,0:49:42.55,Default,معرض الرماية,0,0,0,,عدو أم حليف؟
Dialogue: 0,0:49:53.99,0:49:55.69,Default,تصويب,0,0,0,,كيف يجرؤ على فعل هذا بسويون؟
Dialogue: 0,0:50:01.30,0:50:04.14,Default,shooting,0,0,0,,علاوة على ذلك، كيف يمكنه أن يفعل هذا بالملكة؟
Dialogue: 0,0:50:07.41,0:50:09.01,Default,إطلاق النار,0,0,0,,كيم جواجيون، أيها الوغد.
Dialogue: 0,0:50:09.91,0:50:11.31,Default,التصويب,0,0,0,,لا بد لي من...
Dialogue: 0,0:50:20.75,0:50:23.22,Default,تصويب,0,0,0,,إلى جانب ذلك، سامجيونغ ليجيونغجيونغ هذا.
Dialogue: 0,0:50:23.22,0:50:26.99,Default,إطلاق النار,0,0,0,,يستخدمون الفساد الرسمي كذريعة،
Dialogue: 0,0:50:26.99,0:50:29.69,Default,إطلاق النار,0,0,0,,لمحاولة تدمير عائلتنا.
Dialogue: 0,0:50:29.69,0:50:31.03,Default,التصويب,0,0,0,,لا تقلق.
Dialogue: 0,0:50:31.66,0:50:34.23,Default,shooting,0,0,0,,إذا رأوا في هذا استيلاءً على شخص آخر،
Dialogue: 0,0:50:34.23,0:50:36.07,Default,إطلاق النار,0,0,0,,فلا أحد بريء.
Dialogue: 0,0:50:37.07,0:50:39.44,Default,إطلاق النار,0,0,0,,لحماية نفسك،
Dialogue: 0,0:50:39.70,0:50:41.94,Default,إطلاق النار,0,0,0,,سيحاولون حماية المسؤولين.
Dialogue: 0,0:50:42.17,0:50:45.81,Default,shooting,0,0,0,,كل ما سيبقى من Samjeong Lijeongjeong هو قشرتها الخارجية.
Dialogue: 0,0:50:49.15,0:50:51.15,Default,معرض التصوير,0,0,0,,حتى لو انضممت إليهم لفترة من الوقت،
Dialogue: 0,0:50:51.15,0:50:53.98,Default,تصويب,0,0,0,,أبقِ عينيك على الملكة الأم.
Dialogue: 0,0:50:54.45,0:50:56.85,Default,إطلاق النار,0,0,0,,يمكنها أن تبتسم في وجهك،
Dialogue: 0,0:50:56.85,0:50:58.96,Default,إطلاق النار,0,0,0,,لكنها مستعدة دائماً لغرس سكين في ظهرها.
Dialogue: 0,0:50:59.89,0:51:01.36,Default,التصويب,0,0,0,,سوف أتذكر هذا.
Dialogue: 0,0:51:02.26,0:51:03.49,Default,إطلاق النار,0,0,0,,سيدة البلاط تشون.
Dialogue: 0,0:51:04.23,0:51:06.10,Default,إطلاق النار,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:51:06.83,0:51:09.33,Default,معرض الرماية,0,0,0,,أزل الطاولة واتصل بالمعالج.
Dialogue: 0,0:51:09.57,0:51:11.20,Default,إطلاق النار,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:51:15.04,0:51:16.51,Default,إطلاق النار,0,0,0,,هل أكلت بعد؟
Dialogue: 0,0:51:17.44,0:51:19.24,Default,إطلاق النار,0,0,0,,ليس لدي شهية.
Dialogue: 0,0:51:20.14,0:51:22.08,Default,إطلاق النار,0,0,0,,سمعت أنك أحببت الطعام،
Dialogue: 0,0:51:22.08,0:51:23.85,Default,تايرا,0,0,0,,طبختها الملكة.
Dialogue: 0,0:51:25.12,0:51:26.88,Default,تصويب,0,0,0,,لم تكن بهذه الجودة.
Dialogue: 0,0:51:26.98,0:51:29.12,Default,tyra,0,0,0,,كانت صالحة للأكل.
Dialogue: 0,0:51:29.55,0:51:31.96,Default,إطلاق النار,0,0,0,,الملكة حزينة الآن.
Dialogue: 0,0:51:34.49,0:51:36.29,Default,tyra,0,0,0,,قال أن المحظية الرئيسية
Dialogue: 0,0:51:36.29,0:51:39.30,Default,tyra,0,0,0,,جاءت بينكما وجعلتها تعتقد أن العائلة انقلبت عليها.
Dialogue: 0,0:51:39.63,0:51:41.47,Default,تصويب,0,0,0,,إنها تلوم نفسها على كل شيء.
Dialogue: 0,0:51:43.83,0:51:45.04,Default,tyra,0,0,0,,رئيسة المحظيات؟
Dialogue: 0,0:51:45.04,0:51:47.10,Default,إطلاق النار,0,0,0,,أخبرني والد الملكة اليوم.
Dialogue: 0,0:51:47.47,0:51:49.81,Default,تصويب,0,0,0,,لم تكن الملكة هي التي خدعتك،
Dialogue: 0,0:51:51.04,0:51:52.28,Default,تايرا,0,0,0,,والخليلة الرئيسية.
Dialogue: 0,0:52:01.79,0:52:04.05,Default,,0,0,0,,لقد جاء الملك.
Dialogue: 0,0:52:05.76,0:52:07.02,Default,,0,0,0,,اطلب منه الدخول.
Dialogue: 0,0:52:14.40,0:52:15.47,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:52:15.70,0:52:18.40,Default,,0,0,0,,آسف على التأخر في الزيارة دون سابق إنذار.
Dialogue: 0,0:52:19.30,0:52:20.50,Default,,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:52:20.74,0:52:23.41,Default,,0,0,0,,إنه لشرف عظيم في أي وقت.
Dialogue: 0,0:52:23.94,0:52:25.94,Default,,0,0,0,,جئت لأقول شيئاً.
Dialogue: 0,0:52:28.78,0:52:30.38,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:52:31.12,0:52:34.49,Default,,0,0,0,,عن جثة خادمة البلاط التي عُثر عليها مؤخراً في بئر.
Dialogue: 0,0:52:35.95,0:52:38.76,Default,,0,0,0,,تم ذلك بأمر من الملكة الأم.
Dialogue: 0,0:52:40.09,0:52:41.43,Default,,0,0,0,,الملكة الأم؟
Dialogue: 0,0:52:42.89,0:52:44.16,Default,,0,0,0,,لكن لماذا...
Dialogue: 0,0:52:44.46,0:52:46.20,Default,,0,0,0,,أنت أيضاً لا تستطيع فهم السبب؟
Dialogue: 0,0:52:48.90,0:52:51.30,Default,,0,0,0,,إذا كان الأمر كذلك، فهذا أمر مؤكد...
Dialogue: 0,0:52:51.54,0:52:52.84,Default,,0,0,0,,لا يمكن أن يكون أوفول.
Dialogue: 0,0:52:52.97,0:52:56.14,Default,,0,0,0,,ولكن هذا مستحيل. هذا بالتأكيد أوفول.
Dialogue: 0,0:52:56.71,0:52:58.98,Default,,0,0,0,,سمعت أنه في مثل هذه الحالة التي يصعب التعرف عليها.
Dialogue: 0,0:52:58.98,0:53:01.01,Default,,0,0,0,,لماذا قررت أنه أوفول؟
Dialogue: 0,0:53:01.55,0:53:03.71,Default,,0,0,0,,كانت ترتدي زي سيدة البلاط،
Dialogue: 0,0:53:03.71,0:53:07.48,Default,,0,0,0,,ومن سيدات البلاط، فقط أوفول اختفى.
Dialogue: 0,0:53:10.75,0:53:13.36,Default,,0,0,0,,كانت تعلم أنك ستظن أنه أوفول.
Dialogue: 0,0:53:14.43,0:53:16.13,Default,,0,0,0,,الملكة الأم تريد،
Dialogue: 0,0:53:17.09,0:53:19.26,Default,,0,0,0,,حتى تعتمد عليه.
Dialogue: 0,0:53:20.20,0:53:22.37,Default,,0,0,0,,ولكن لماذا تم استخدام البئر؟
Dialogue: 0,0:53:24.30,0:53:26.74,Default,,0,0,0,,أخبرتها بما مررت به في البئر.
Dialogue: 0,0:53:27.97,0:53:31.51,Default,,0,0,0,,لقد التقيتك فيه.
Dialogue: 0,0:53:31.71,0:53:33.31,Default,,0,0,0,,وأن هذا المكان يؤلمني.
Dialogue: 0,0:53:34.91,0:53:36.68,Default,,0,0,0,,لقد ذكرني بك،
Dialogue: 0,0:53:36.68,0:53:38.98,Default,,0,0,0,,فكنت على يقين أنني فقدت شخصاً عزيزاً عليّ.
Dialogue: 0,0:53:41.42,0:53:43.95,Default,,0,0,0,,الآن أفهم أنه لا يمكنك الكشف عن ألمك بلا مبالاة
Dialogue: 0,0:53:45.16,0:53:46.42,Default,,0,0,0,,لأي شخص في القصر.
Dialogue: 0,0:54:04.84,0:54:08.98,Default,,0,0,0,,اغمر الملكة في الكابوس الذي أعيش فيه.
Dialogue: 0,0:54:15.62,0:54:18.16,Default,,0,0,0,,لا تثق بالملكة الأم بعد الآن.
Dialogue: 0,0:54:18.82,0:54:20.16,Default,,0,0,0,,علينا إخفاء ما نعرفه جميعاً،
Dialogue: 0,0:54:21.13,0:54:23.73,Default,,0,0,0,,لذا لا تدعها تعرف أنك تعرف ما فعلته.
Dialogue: 0,0:54:25.63,0:54:29.17,Default,,0,0,0,,لقد خانتني وأنا أشعر بخيبة أمل شديدة.
Dialogue: 0,0:54:30.80,0:54:32.07,Default,,0,0,0,,حسناً بالنسبة لي
Dialogue: 0,0:54:33.30,0:54:35.47,Default,,0,0,0,,مصدر الخوف.
Dialogue: 0,0:54:37.04,0:54:38.64,Default,,0,0,0,,لا أصدق أنها استخدمت ذلك.
Dialogue: 0,0:54:52.29,0:54:55.49,Default,,0,0,0,,إنه مثل البوكر والهاتو.
Dialogue: 0,0:54:55.73,0:54:57.93,Default,,0,0,0,,الدردشة والألعاب -
Dialogue: 0,0:54:57.93,0:55:00.86,Default,,0,0,0,,أفضل طريقة لتمضية الوقت والحياة.
Dialogue: 0,0:55:01.73,0:55:03.27,Default,,0,0,0,,سعيد لسماع ذلك.
Dialogue: 0,0:55:03.63,0:55:06.37,Default,,0,0,0,,كنا نخشى أن يجعلك دامهيانغ تشعر بالسوء.
Dialogue: 0,0:55:08.57,0:55:09.81,Default,,0,0,0,,أوه، آسف.
Dialogue: 0,0:55:11.01,0:55:13.48,Default,,0,0,0,,لا تقلق. إنها في مكان جيد الآن.
Dialogue: 0,0:55:13.71,0:55:16.71,Default,,0,0,0,,حقاً؟ كان عليها أن تذهب إلى مكان جيد، أليس كذلك؟
Dialogue: 0,0:55:17.88,0:55:18.92,Default,,0,0,0,,دامهيانغ.
Dialogue: 0,0:55:21.02,0:55:25.56,Default,,0,0,0,,لا، ليس هذا ما أتحدث عنه. إنها حقا في مكان جيد.
Dialogue: 0,0:55:25.56,0:55:26.62,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:55:28.56,0:55:29.63,Default,,0,0,0,,دمهيان.
Dialogue: 0,0:55:32.00,0:55:34.06,Default,,0,0,0,,قالت إنها انتقلت فعلاً إلى مكان جيد.
Dialogue: 0,0:55:35.40,0:55:37.74,Default,,0,0,0,,لماذا تبكين؟
Dialogue: 0,0:55:39.27,0:55:40.90,Default,,0,0,0,,عذراً.
Dialogue: 0,0:55:41.67,0:55:43.14,Default,,0,0,0,,إذا فكرت في الأمر،
Dialogue: 0,0:55:44.14,0:55:47.21,Default,,0,0,0,,لم أودعها حتى.
Dialogue: 0,0:55:48.41,0:55:50.85,Default,,0,0,0,,دامهيانغ.
Dialogue: 0,0:55:55.12,0:55:57.25,Default,,0,0,0,,-دامهيان.\N-الملكة.
Dialogue: 0,0:55:58.72,0:55:59.99,Default,,0,0,0,,دمهيان.
Dialogue: 0,0:56:00.49,0:56:01.56,Default,,0,0,0,,سبعة.
Dialogue: 0,0:56:03.73,0:56:04.73,Default,,0,0,0,,ثمانية.
Dialogue: 0,0:56:05.50,0:56:06.66,Default,,0,0,0,,هذا...
Dialogue: 0,0:56:07.90,0:56:09.80,Default,,0,0,0,,تسعة.
Dialogue: 0,0:56:14.10,0:56:16.07,Default,,0,0,0,,سامحني.
Dialogue: 0,0:56:16.31,0:56:18.01,Default,,0,0,0,,كيف ذلك؟
Dialogue: 0,0:56:19.71,0:56:23.11,Default,,0,0,0,,-دامهيان.\N-دمهيان.
Dialogue: 0,0:56:24.65,0:56:25.65,Default,,0,0,0,,الكل في.
Dialogue: 0,0:56:29.85,0:56:32.79,Default,,0,0,0,,كيف وضعت الملكة الأم يديها على دفتر الأستاذ؟
Dialogue: 0,0:56:32.89,0:56:35.59,Default,,0,0,0,,الكتاب الذي كنا نبحث عنه بشدة، لكننا فاتنا.
Dialogue: 0,0:56:36.92,0:56:40.69,Default,,0,0,0,,ربما أتمكن من ضمها إلى جانبك؟
Dialogue: 0,0:56:42.26,0:56:43.53,Default,,0,0,0,,نكتة.
Dialogue: 0,0:56:44.23,0:56:47.40,Default,,0,0,0,,سمعت أنها تجاوزتنا، وغادرت القصر بحرية،
Dialogue: 0,0:56:47.40,0:56:48.67,Default,,0,0,0,,أشعر بخيبة أمل في نفسي.
Dialogue: 0,0:56:49.80,0:56:52.17,Default,,0,0,0,,الملكة الأم موجودة في قاعة سيونغ وونجونغ تقريباً\N طوال الوقت.
Dialogue: 0,0:56:52.17,0:56:54.47,Default,,0,0,0,,لا أفهم كيف حصلت على دفتر الأستاذ.
Dialogue: 0,0:56:54.81,0:56:56.54,Default,,0,0,0,,هذا ما فعلته بالجسد،
Dialogue: 0,0:56:57.01,0:56:59.75,Default,,0,0,0,,يعني أن لديها شركاء.
Dialogue: 0,0:56:59.75,0:57:02.18,Default,,0,0,0,,ربما ينبغي لنا أن نجعلهم شركاء لنا؟
Dialogue: 0,0:57:02.85,0:57:05.49,Default,,0,0,0,,صورة الشخص الذي يرتدي قناع التوكيبي ليست جاهزة بعد؟
Dialogue: 0,0:57:06.02,0:57:08.86,Default,,0,0,0,,لقد كنت مشغولاً جداً هذه الأيام،
Dialogue: 0,0:57:08.86,0:57:11.22,Default,,0,0,0,,تحرير والدة دامهيانغ من العبودية
Dialogue: 0,0:57:11.22,0:57:13.16,Default,,0,0,0,,وتبحث عن والدها.
Dialogue: 0,0:57:13.33,0:57:14.93,Default,,0,0,0,,لكنك لم تجده قط؟
Dialogue: 0,0:57:14.93,0:57:17.30,Default,,0,0,0,,كيف تجد شخصًا مختبئًا في الجبال؟
Dialogue: 0,0:57:17.60,0:57:19.30,Default,,0,0,0,,ربما أصبح قاطع طريق.
Dialogue: 0,0:57:23.00,0:57:28.58,Default,,0,0,0,,أفكر في الإجازة بعد رحلتي كمحقق ملكي،
Dialogue: 0,0:57:29.01,0:57:33.31,Default,,0,0,0,,أنا بالكاد أستطيع الوقوف هذه الأيام.
Dialogue: 0,0:57:34.51,0:57:36.92,Default,,0,0,0,,في الواقع، قصدت...
Dialogue: 0,0:57:40.49,0:57:44.09,Default,,0,0,0,,هل يمكنك أن تجعلني مفتشاً سرياً بدلاً من محقق ملكي؟
Dialogue: 0,0:57:44.09,0:57:45.66,Default,,0,0,0,,هذا رائع.
Dialogue: 0,0:57:45.66,0:57:48.56,Default,,0,0,0,,متخفيًا، سأخرج فجأة رمزًا مميزًا، هكذا!
Dialogue: 0,0:57:50.23,0:57:53.10,Default,,0,0,0,,نعم، أنت مفتش سري بالفطرة. افعل كما يحلو لك.
Dialogue: 0,0:57:54.23,0:57:55.30,Default,,0,0,0,,مرة أخرى.
Dialogue: 0,0:58:21.43,0:58:25.70,Default,,0,0,0,,لا أعتقد أن يونغجين هو هذا النوع من الأشخاص.
Dialogue: 0,0:58:26.10,0:58:28.20,Default,,0,0,0,,فقط "كيم جواجيون" يستحق الموت.
Dialogue: 0,0:58:28.20,0:58:29.30,Default,,0,0,0,,يونغجين -
Dialogue: 0,0:58:31.87,0:58:33.81,Default,,0,0,0,,عائلتي بأكملها.
Dialogue: 0,0:58:45.99,0:58:48.92,Default,,0,0,0,,مرحبًا، ستنام هنا بعد ذلك،
Dialogue: 0,0:58:48.92,0:58:50.16,Default,,0,0,0,,كيف كدت تقتل والد زوجك وزوجتك؟
Dialogue: 0,0:58:52.36,0:58:53.49,Default,,0,0,0,,على ما يبدو لا.
Dialogue: 0,0:59:10.24,0:59:12.35,Default,,0,0,0,,القلب، توقف.
Dialogue: 0,0:59:12.98,0:59:14.82,Default,,0,0,0,,هذا يؤذي كبريائي.
Dialogue: 0,1:00:18.55,1:00:20.88,Default,,0,0,0,,يبدو أنها كانت تحت الماء لفترة طويلة.
Dialogue: 0,1:00:22.25,1:00:25.25,Default,,0,0,0,,أنا أفهم كم يجب أن يكون هذا مؤلمًا.
Dialogue: 0,1:00:27.95,1:00:30.69,Default,,0,0,0,,العثور على جثتها في البئر إما أن يكون صدفة فظيعة،
Dialogue: 0,1:00:31.06,1:00:33.29,Default,,0,0,0,,أو يريد أحد أن يدفعنا إلى الأمام.
Dialogue: 0,1:00:50.28,1:00:51.85,Default,,0,0,0,,أنا مستغرق في التفكير.
Dialogue: 0,1:00:52.21,1:00:53.68,Default,,0,0,0,,لا بد أنك مصدوم جدًا.
Dialogue: 0,1:00:53.98,1:00:55.88,Default,,0,0,0,,مساحة كبيرة بالنسبة لي هنا.
Dialogue: 0,1:00:57.02,1:01:00.65,Default,,0,0,0,,هنا تشعر بالوحدة والضياع.
Dialogue: 0,1:01:00.99,1:01:03.92,Default,,0,0,0,,لقد وجدت الخادمة التي باعت النوريغا التي أعطيتها لأوفول.
Dialogue: 0,1:01:04.49,1:01:06.89,Default,,0,0,0,,قالت إنها وجدته في القصر.
Dialogue: 0,1:01:08.70,1:01:09.96,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,1:01:09.96,1:01:11.60,Default,,0,0,0,,هذه هي نفس الخادمة التي ألقت الجثة في البئر
Dialogue: 0,1:01:11.60,1:01:13.93,Default,,0,0,0,,بأمر من الملكة الأم.
Dialogue: 0,1:01:14.67,1:01:16.10,Default,,0,0,0,,أوفول على قيد الحياة.
Dialogue: 0,1:01:16.60,1:01:18.47,Default,,0,0,0,,لقد هوجمت في القصر.
Dialogue: 0,1:01:19.34,1:01:21.68,Default,,0,0,0,,لم يكن لديها حتى الوقت لتأخذ خطوة خارج القصر.
Dialogue: 0,1:01:23.91,1:01:25.41,Default,,0,0,0,,ألم ترجو الجسد،
Dialogue: 0,1:01:25.95,1:01:28.08,Default,,0,0,0,,وجدت في البئر، ألا تنتمي إلى "أوفول"؟
Dialogue: 0,1:01:29.35,1:01:31.42,Default,,0,0,0,,ألا تكون سعيداً،
Dialogue: 0,1:01:31.42,1:01:33.09,Default,,0,0,0,,ألم يكن أوفول؟
Dialogue: 0,1:01:33.95,1:01:36.42,Default,,0,0,0,,لماذا تعتقد أن هذا هو أوفول؟
Dialogue: 0,1:01:36.66,1:01:37.79,Default,,0,0,0,,في سبيل الله...
Dialogue: 0,1:01:40.69,1:01:42.73,Default,,0,0,0,,بالله عليك ماذا تخفي؟
Dialogue: 0,1:01:47.23,1:01:48.27,Default,,0,0,0,,آخر مرة
Dialogue: 0,1:01:50.67,1:01:53.31,Default,,0,0,0,,ما تجاوزته
Dialogue: 0,1:01:55.08,1:01:56.41,Default,,0,0,0,,الملكة الأم؟
Dialogue: 0,1:02:07.19,1:02:08.56,Default,,0,0,0,,هل رأيت كل شيء؟
Dialogue: 0,1:02:09.29,1:02:10.36,Default,,0,0,0,,أنا
Dialogue: 0,1:02:11.32,1:02:15.80,Default,,0,0,0,,لا أرى شيئاً دون إذنك.
Dialogue: 0,1:02:20.57,1:02:22.50,Default,,0,0,0,,الجميع يضل من وقت لآخر.
Dialogue: 0,1:02:22.94,1:02:24.94,Default,,0,0,0,,لا تزال أمامك فرصة للعودة إلى المسار الصحيح.
Dialogue: 0,1:02:28.14,1:02:30.41,Default,,0,0,0,,ماذا لو ضللت طريقي منذ زمن طويل؟
Dialogue: 0,1:02:31.78,1:02:32.91,Default,,0,0,0,,لا يزال بإمكانه
Dialogue: 0,1:02:34.21,1:02:36.32,Default,,0,0,0,,هل تعود إلى المسار الصحيح؟
Dialogue: 0,1:02:39.75,1:02:41.32,Default,,0,0,0,,ليس هناك عودة إلى الوراء.
Dialogue: 0,1:02:41.69,1:02:42.92,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,1:02:42.92,1:02:45.66,Default,,0,0,0,,يجب أن يكون هذا الجسم أوفول.
Dialogue: 0,1:02:55.80,1:02:58.14,Default,,0,0,0,,لماذا تطبخ سامهيانج رامين
Dialogue: 0,1:02:58.84,1:03:00.34,Default,,0,0,0,,في منتصف الليل؟
Dialogue: 0,1:03:04.01,1:03:06.58,Default,,0,0,0,,لماذا تريدها أكثر في الليل؟
Dialogue: 0,1:03:06.58,1:03:09.12,Default,,0,0,0,,أنت تعلم أنه في الصباح سوف ينتفخ وجهك.
Dialogue: 0,1:03:09.68,1:03:12.92,Default,,0,0,0,,لكن من الصعب جدًا محاربة الإغراء.
Dialogue: 0,1:03:15.49,1:03:18.09,Default,,0,0,0,,لقد حاولت جاهداً، ومن المؤسف أن ذلك كان بلا جدوى.
Dialogue: 0,1:03:18.09,1:03:20.16,Default,,0,0,0,,الملكة الأرملة في الليل
Dialogue: 0,1:03:20.29,1:03:21.90,Default,,0,0,0,,لا يأكل.
Dialogue: 0,1:03:21.90,1:03:23.60,Default,,0,0,0,,بدلاً من ذلك دعني...
Dialogue: 0,1:03:25.87,1:03:27.03,Default,,0,0,0,,لا.
Dialogue: 0,1:03:55.86,1:03:58.23,Default,,0,0,0,,يجب أن تحذرني بشأن وصولك.
Dialogue: 0,1:03:58.23,1:04:00.67,Default,,0,0,0,,لماذا لم تطرق الباب أصلاً؟
Dialogue: 0,1:04:07.94,1:04:10.71,Default,,0,0,0,,هل تريد أن تأكل بعض الرامن قبل أن نغادر؟
Dialogue: 0,1:04:14.41,1:04:17.75,Default,,0,0,0,,ما هو الرامن؟ وأين تريدني أن أذهب؟
Dialogue: 0,1:04:18.82,1:04:21.79,Default,,0,0,0,,لا يوجد ضغط. هذا مجرد بحث.
Dialogue: 0,1:04:21.96,1:04:23.19,Default,,0,0,0,,أو اختبار.
Dialogue: 0,1:04:24.12,1:04:26.09,Default,,0,0,0,,لا، لا ينبغي لي أن أفعل ذلك.
Dialogue: 0,1:04:28.23,1:04:29.80,Default,,0,0,0,,لكن لو قليلاً...
Dialogue: 0,1:04:29.80,1:04:30.80,Default,,0,0,0,,لا، لا.
Dialogue: 0,1:04:31.00,1:04:33.13,Default,,0,0,0,,الرامن له طعم إدماني.
Dialogue: 0,1:04:33.13,1:04:35.30,Default,,0,0,0,,بمجرد أن تبدأ، من المستحيل أن تتوقف.
Dialogue: 0,1:04:36.84,1:04:38.10,Default,,0,0,0,,ماذا تفعل؟
Dialogue: 0,1:04:42.71,1:04:44.18,Default,,0,0,0,,صراع داخلي.
Dialogue: 0,1:04:51.55,1:04:53.15,Default,,0,0,0,,ماذا ستفعل لو كنت مكاني؟
Dialogue: 0,1:04:53.52,1:04:56.26,Default,,0,0,0,,هل تأكل الرامن أم لا؟
Dialogue: 0,1:04:56.69,1:04:59.23,Default,,0,0,0,,أعتقد أنني سأشرح أولاً ما هو الرامن.
Dialogue: 0,1:05:01.76,1:05:03.73,Default,,0,0,0,,-بالنسبة للمبتدئين...\N-ماذا؟
Dialogue: 0,1:05:04.46,1:05:05.67,Default,,0,0,0,,سأحاول ذلك.
Dialogue: 0,1:05:06.20,1:05:07.23,Default,,0,0,0,,حقاً؟
Dialogue: 0,1:05:07.73,1:05:09.87,Default,,0,0,0,,لن تفهم ماهيته إلا عندما تجربه.
Dialogue: 0,1:05:09.87,1:05:11.81,Default,,0,0,0,,إنه مثل الهواء عندما تسكر،
Dialogue: 0,1:05:11.81,1:05:13.34,Default,,0,0,0,,أو عندما تكون غاضباً،
Dialogue: 0,1:05:13.34,1:05:15.04,Default,,0,0,0,,أو أدرك أنه كذلك
Dialogue: 0,1:05:16.58,1:05:18.04,Default,,0,0,0,,الواقع.
Dialogue: 0,1:05:19.55,1:05:22.12,Default,,0,0,0,,هل نتحدث نفس اللغة الآن؟
Dialogue: 0,1:05:22.98,1:05:24.02,Default,,0,0,0,,بالطبع.
Dialogue: 0,1:05:24.55,1:05:26.49,Default,,0,0,0,,نحن نتحدث عن الرامن.
Dialogue: 0,1:05:28.35,1:05:31.29,Default,,0,0,0,,اقترب. رامين جيد عندما يكون الجو حارا.
Dialogue: 0,1:05:31.29,1:05:32.46,Default,,0,0,0,,التعليمات الأولية للأطفال
Dialogue: 0,1:05:33.63,1:05:34.73,Default,,0,0,0,,كيف تتعامل معها؟
Dialogue: 0,1:05:34.93,1:05:36.53,Default,,0,0,0,,أوه يا أمهات!
Dialogue: 0,1:05:36.53,1:05:38.40,Default,,0,0,0,,ماذا أفعل؟ هذا كتاب لا يقدر بثمن
Dialogue: 0,1:05:54.55,1:05:57.02,Default,,0,0,0,,لماذا قلت أن هذا الكتاب لا يقدر بثمن؟
Dialogue: 0,1:05:59.22,1:06:02.96,Default,,0,0,0,,ما مدى أهمية التعليم الابتدائي للأطفال بالنسبة لك؟
Dialogue: 0,1:06:05.13,1:06:06.19,Default,,0,0,0,,هذا...
Dialogue: 0,1:06:08.03,1:06:09.26,Default,,0,0,0,,هل هذا أنت؟
Dialogue: 0,1:06:12.37,1:06:15.10,Default,,0,0,0,,أنت من أنقذني؟
Dialogue: 0,1:06:15.27,1:06:17.77,Default,,0,0,0,,أنقذتني من البئر؟
Dialogue: 0,1:06:31.08,1:06:32.09,Default,,0,0,0,,نعم.
Dialogue: 0,1:06:32.89,1:06:33.99,Default,,0,0,0,,لقد كنت أنا.
Dialogue: 0,1:06:47.10,1:06:51.50,Default,,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:07:11.79,1:07:14.96,Default,,0,0,0,,سيكون ابني تشيولجونغ في انتظاري بفارغ الصبر.
Dialogue: 0,1:07:15.30,1:07:17.23,Default,,0,0,0,,إذن هذا فخ؟
Dialogue: 0,1:07:17.23,1:07:20.30,Default,,0,0,0,,لا أستطيع أن أصدق أن الملكة تحدتني في قتال حقيقي.
Dialogue: 0,1:07:20.30,1:07:21.84,Default,,0,0,0,,{\i1}-الآن حان دوري؟\N-أخرج سيفك.{\i}
Dialogue: 0,1:07:21.84,1:07:25.00,Default,,0,0,0,,الذي لا ينظف خلفه ويترك آثاراً،
Dialogue: 0,1:07:25.00,1:07:26.94,Default,,0,0,0,,يجب الإجابة على كل شيء.
Dialogue: 0,1:07:26.94,1:07:28.01,Default,,0,0,0,,على الرغم من أنني أطاحت بعشيرة كيم،
Dialogue: 0,1:07:28.01,1:07:29.91,Default,,0,0,0,,لقد تعززت قوة كيم بيونين.
Dialogue: 0,1:07:29.91,1:07:31.78,Default,,0,0,0,,يبدو أنه لا يوجد تقدم.
Dialogue: 0,1:07:31.78,1:07:34.95,Default,,0,0,0,,إذا فعل تشيولجونغ هذا، فسيتغير العالم أيضاً بعد 200 عام.
Dialogue: 0,1:07:34.95,1:07:36.98,Default,,0,0,0,,طالما أنا في صفك، ستنتصر.
Dialogue: 0,1:07:36.98,1:07:38.75,Default,,0,0,0,,لدي سلاح سري.
Dialogue: 0,1:07:38.75,1:07:40.09,Default,,0,0,0,,أنا أعرفك.
Dialogue: 0,0:15:25.96,0:15:27.96,Default,,0,0,0,,

تعليق: 0,0:08:45.52,0:08:46.75,Default,Лилия,0,0,0,,تقول حرفيًا "بدون شفاه، أسنان\نا باردة" وتعني أنها قريبة.
التعليق: 0,0:09:01.50,0:09:02.87,Default,Лилия,0,0,0,,منح العفو لبعض المجرمين\NC عن جرائمهم
