Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.12,0:01:06.52,Default,Lily,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.52,0:01:08.52,Default,ليلي,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:02:19.19,0:02:21.63,Default,ليلي,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:02:24.23,0:02:26.10,Default,ليلي,0,0,0,,معجزة حقيقية لنا،
Dialogue: 0,0:02:26.67,0:02:28.90,Default,ليلي,0,0,0,,أن بعد كل يوم يأتي الغد.
Dialogue: 0,0:02:30.00,0:02:32.84,Default,ليلي,0,0,0,,هذا أمر خطير. قد يكون هناك انفجار آخر.
Dialogue: 0,0:02:35.04,0:02:36.18,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:02:36.91,0:02:38.81,Default,ليلي,0,0,0,,لا. لا يمكنك الذهاب إلى هناك.
Dialogue: 0,0:02:38.81,0:02:41.55,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:02:41.55,0:02:43.88,Default,ليلي,0,0,0,,-جلالتك!\N-احمي الملك.
Dialogue: 0,0:02:43.98,0:02:46.35,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:02:47.39,0:02:50.32,Default,ليلي,0,0,0,,جلالتك، علينا الرحيل.
Dialogue: 0,0:02:50.92,0:02:52.49,Default,ليلي,0,0,0,,-جلالتك!\N-أسرع.
Dialogue: 0,0:03:00.90,0:03:02.90,Default,ليلي,0,0,0,,لا. نحن بحاجة لإنقاذه!
Dialogue: 0,0:03:02.90,0:03:05.04,Default,ليلي,0,0,0,,-جلالتك.\N-لا تذهب إلى هناك.
Dialogue: 0,0:03:05.04,0:03:06.44,Default,ليلي,0,0,0,,لا تتدخل.
Dialogue: 0,0:03:06.61,0:03:08.78,Default,ليلي,0,0,0,,ماذا تقول؟ ملك...
Dialogue: 0,0:03:08.91,0:03:10.21,Default,ليلي,0,0,0,,استمع إلي!
Dialogue: 0,0:03:12.48,0:03:14.31,Default,ليلي,0,0,0,,سأشرح لك كل شيء لاحقاً.
Dialogue: 0,0:03:14.31,0:03:16.48,Default,ليلي,0,0,0,,الآن أنقذ نفسك.
Dialogue: 0,0:03:16.52,0:03:18.48,Default,ليلي,0,0,0,,-يا صاحب الجلالة!\N-الأمر خطير هنا،
Dialogue: 0,0:03:18.48,0:03:20.02,Default,ليلي,0,0,0,,خذ الملكة إلى دايجوجون.
Dialogue: 0,0:03:21.86,0:03:24.39,Default,ليلي,0,0,0,,-جلالتك، لا تذهب إلى هناك.\N-جلالتك.
Dialogue: 0,0:03:24.39,0:03:25.99,Default,ليلي,0,0,0,,-دعني أدخل!\N-جلالتك.
Dialogue: 0,0:03:25.99,0:03:27.69,Default,ليلي,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:03:27.69,0:03:29.46,Default,ليلي,0,0,0,,دعني أدخل، من فضلك.
Dialogue: 0,0:03:29.60,0:03:31.80,Default,ليلي,0,0,0,,دعني أذهب!
Dialogue: 0,0:03:31.80,0:03:32.97,Default,ليلي,0,0,0,,دعني أدخل!
Dialogue: 0,0:03:32.97,0:03:34.00,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:03:34.73,0:03:36.04,Default,ليلي,0,0,0,,ومع ذلك
Dialogue: 0,0:03:37.24,0:03:39.74,Default,ليلي,0,0,0,,لا نفهم كم هو رائع،
Dialogue: 0,0:03:40.91,0:03:43.34,Default,ليلي,0,0,0,,حتى يأتي اليوم الذي ليس له غد.
Dialogue: 0,0:03:45.14,0:03:48.05,Default,Lily,0,0,0,,نحن أغبياء جدًا لدرجة أننا لا نقدر شيئًا ما،
Dialogue: 0,0:03:48.98,0:03:50.68,Default,ليلي,0,0,0,,حتى نخسر.
Dialogue: 0,0:03:52.05,0:03:57.42,Default,ليلي,0,0,0,,غداً لا يأتي أبداً
Dialogue: 0,0:03:59.63,0:04:02.33,Default,ليلي,0,0,0,,13 حلقة
Dialogue: 0,0:04:15.17,0:04:18.75,Default,Lily,0,0,0,,تجرأ أحدهم على اغتيال الملك في القصر.
Dialogue: 0,0:04:19.18,0:04:22.12,Default,ليلي,0,0,0,,قبض على جميع الأشخاص المشبوهين واستجوبهم.
Dialogue: 0,0:04:22.68,0:04:24.15,Default,ليلي,0,0,0,,علينا أن نكتشف ذلك
Dialogue: 0,0:04:24.88,0:04:27.19,Default,ليلي,0,0,0,,من وراء هذا.
Dialogue: 0,0:04:29.02,0:04:31.32,Default,ليلي,0,0,0,,هل أعددت هذا؟
Dialogue: 0,0:04:31.72,0:04:35.33,Default,Lily,0,0,0,,كيف ستتعامل مع العواقب بعد التخطيط لهذا؟
Dialogue: 0,0:04:35.56,0:04:36.80,Default,ليلي,0,0,0,,اهدأ.
Dialogue: 0,0:04:36.80,0:04:39.13,Default,ليلي,0,0,0,,كما لو كان بإمكاني أن أهدأ!
Dialogue: 0,0:04:39.13,0:04:41.90,Default,ليلي,0,0,0,,حياة الملك كانت مهددة أمام الجميع،
Dialogue: 0,0:04:41.90,0:04:43.90,Default,ليلي,0,0,0,,للعرض أيضاً.
Dialogue: 0,0:04:44.90,0:04:48.81,Default,Lilia,0,0,0,,إذن، قرر الجميع أنني أنا من حاولت الانتحار؟
Dialogue: 0,0:04:51.61,0:04:53.58,Default,ليلي,0,0,0,,سأعتني بالأمر.
Dialogue: 0,0:05:00.39,0:05:03.02,Default,ليلي,0,0,0,,أتوسل إليك. أنا أصلِّي.
Dialogue: 0,0:05:03.69,0:05:07.49,Default,Lily,0,0,0,,إنني أدعو بشدة إلى آلهة السماء والأرض.
Dialogue: 0,0:05:08.13,0:05:12.73,Default,ليلي,0,0,0,,أنقذوا ملكنا.
Dialogue: 0,0:05:13.93,0:05:17.00,Default,ليلي,0,0,0,,أتوسل إليك. أنا أصلِّي.
Dialogue: 0,0:05:17.57,0:05:19.57,Default,ليلي,0,0,0,,أتوسل إليك.
Dialogue: 0,0:05:21.81,0:05:24.41,افتراضي,ليلي,0,0,0,,حفظ
Dialogue: 0,0:05:26.25,0:05:28.72,Default,ليلي,0,0,0,,ملكنا.
Dialogue: 0,0:05:34.42,0:05:36.59,Default,ليلي,0,0,0,,لم أكن أعلم أنهم سيذهبون إلى هذا الحد.
Dialogue: 0,0:05:37.16,0:05:39.76,Default,ليلي,0,0,0,,لقد وضعوه بأنفسهم على العرش،
Dialogue: 0,0:05:39.76,0:05:42.43,Default,Lilia,0,0,0,,والآن يريدون التخلص منه.
Dialogue: 0,0:05:44.06,0:05:48.10,Default,ليلي,0,0,0,,ماذا يحدث إذا لم يستيقظ الملك؟
Dialogue: 0,0:05:49.07,0:05:55.02,Default,Lily,0,0,0,,ثم سنكون أنا والمحظية الملكية عاجزين.
Dialogue: 0,0:05:58.24,0:06:00.88,Default,ليلي,0,0,0,,لا أستطيع أن أصدق أننا فعلنا الأمر بشكل صحيح
Dialogue: 0,0:06:01.25,0:06:03.42,Default,ليلي,0,0,0,,في الفخ المُعد للملكة.
Dialogue: 0,0:06:04.05,0:06:06.82,Default,ليلي,0,0,0,,أتوسل إليك. أنا أصلِّي.
Dialogue: 0,0:06:08.79,0:06:10.12,Default,ليلي,0,0,0,,أتوسل إليك.
Dialogue: 0,0:06:13.89,0:06:16.20,Default,ليلي,0,0,0,,استرح قليلاً.
Dialogue: 0,0:06:16.50,0:06:18.87,Default,ليلي,0,0,0,,سوف تسقط قريباً جداً.
Dialogue: 0,0:06:21.80,0:06:25.61,Default,ليلي,0,0,0,,إذا لم ينجو الملك،
Dialogue: 0,0:06:26.61,0:06:28.94,Default,ليلي,0,0,0,,لن أتمكن من العيش أيضاً.
Dialogue: 0,0:06:31.14,0:06:34.01,Default,ليلي,0,0,0,,إذا كان عليك أن تموت،
Dialogue: 0,0:06:34.85,0:06:38.95,Default,Lily,0,0,0,,قبل أن أموت سأنتقم من مذنب الملك.
Dialogue: 0,0:06:40.69,0:06:41.72,Default,ليلى,0,0,0,,القصر
Dialogue: 0,0:06:43.66,0:06:45.39,Default,ليلي,0,0,0,,وهؤلاء الناس
Dialogue: 0,0:06:47.79,0:06:50.66,Default,ليلي,0,0,0,,أغضبتنا.
Dialogue: 0,0:07:23.70,0:07:27.97,Default,ليلي,0,0,0,,جلالتك. جاء رئيس قسم المباحث.
Dialogue: 0,0:07:30.57,0:07:31.64,Default,ليلي,0,0,0,,وتشيولجونغ...
Dialogue: 0,0:07:32.97,0:07:35.74,Default,ليلي,0,0,0,,هل الملك بخير؟
Dialogue: 0,0:07:37.44,0:07:39.51,Default,ليلي,0,0,0,,ممنوع الأمير يونبيونغ
Dialogue: 0,0:07:39.51,0:07:41.55,Default,ليلي,0,0,0,,ادخل هيجونجون بينما يُعالج الملك.
Dialogue: 0,0:07:42.48,0:07:45.28,Default,ليلي,0,0,0,,ولا يقولون شيئاً عن حالة الملك.
Dialogue: 0,0:07:46.12,0:07:47.25,Default,ليلي,0,0,0,,يجب أن أذهب إليه.
Dialogue: 0,0:07:47.25,0:07:48.49,Default,ليلي,0,0,0,,لا تذهب.
Dialogue: 0,0:07:51.86,0:07:53.79,Default,ليلي,0,0,0,,سوف يسمحون لي بالدخول.
Dialogue: 0,0:07:53.79,0:07:55.26,Default,Lilia,0,0,0,,مازلت زوجته.
Dialogue: 0,0:08:22.66,0:08:24.12,Default,ليلي,0,0,0,,لا تذهب.
Dialogue: 0,0:08:24.79,0:08:26.96,Default,ليلي,0,0,0,,لقد حاول اغتيالك.
Dialogue: 0,0:08:27.46,0:08:30.26,Default,ليلي,0,0,0,,لديك كل الحق في قتله.
Dialogue: 0,0:08:38.27,0:08:39.34,Default,ليلي,0,0,0,,سويون.
Dialogue: 0,0:08:49.05,0:08:52.75,Default,ليلي,0,0,0,,أحتاج إلى الراحة.
Dialogue: 0,0:09:48.94,0:09:51.04,Default,Lily,0,0,0,,هل أنت متأكد من أنه لن تكون هناك أية مشاكل؟
Dialogue: 0,0:09:51.04,0:09:52.04,Default,ليلي,0,0,0,,بالطبع.
Dialogue: 0,0:10:19.84,0:10:21.44,Default,ليلي,0,0,0,,من كان وراء هذا؟
Dialogue: 0,0:10:22.48,0:10:24.04,Default,ليلي,0,0,0,,نحن أبرياء.
Dialogue: 0,0:10:24.71,0:10:27.55,Default,Lily,0,0,0,,نحن مستعدون للتضحية بأرواحنا لحماية الملك.
Dialogue: 0,0:10:28.65,0:10:29.92,Default,ليلي,0,0,0,,نحن الحرس الملكي.
Dialogue: 0,0:10:35.49,0:10:38.29,Default,Lily,0,0,0,,لماذا تحتاج إلى وثائق مزورة؟
Dialogue: 0,0:10:38.56,0:10:41.39,Default,ليلي,0,0,0,,لقد استخدمت هذا العذر لاحتجازنا،
Dialogue: 0,0:10:42.60,0:10:44.60,Default,ليلي,0,0,0,,وفي هذا الوقت عانى الملك.
Dialogue: 0,0:10:45.23,0:10:46.50,Default,ليلي,0,0,0,,الشخص الذي يقف وراء هذا هو،
Dialogue: 0,0:10:46.97,0:10:49.74,Default,ليلي,0,0,0,,الذي وجد أخطاء في مستنداتنا. والدك
Dialogue: 0,0:10:50.40,0:10:51.54,Default,ليلي,0,0,0,,كيم جواجيون!
Dialogue: 0,0:10:53.44,0:10:55.31,Default,Lily,0,0,0,,هذه كيم جواجيون.
Dialogue: 0,0:10:57.21,0:10:58.71,Default,ليلي,0,0,0,,أنت ذكية جدًا.
Dialogue: 0,0:11:05.32,0:11:06.45,Default,ليلي,0,0,0,,لقد اكتشفت ذلك.
Dialogue: 0,0:11:13.16,0:11:15.70,Default,Lily,0,0,0,,كما ظننت، المبخرة لم تمتلئ بالرمل،
Dialogue: 0,0:11:15.70,0:11:17.60,Default,ليلى,0,0,0,,والبارود المستخدم كمتفجرات.
Dialogue: 0,0:11:18.06,0:11:19.37,Default,ليلي,0,0,0,,كيف حزرت؟
Dialogue: 0,0:11:27.94,0:11:29.11,Default,ليلي,0,0,0,,كيف سار الأمر؟
Dialogue: 0,0:11:29.44,0:11:31.24,Default,ليلي,0,0,0,,ليس من السهل إجبارهم على الاعتراف.
Dialogue: 0,0:11:31.24,0:11:32.51,Default,ليلي,0,0,0,,بلا شك.
Dialogue: 0,0:11:33.18,0:11:34.58,Default,ليلي,0,0,0,,هل تعلمت أي شيء آخر؟
Dialogue: 0,0:11:35.21,0:11:36.52,Default,ليلي,0,0,0,,ليس بعد.
Dialogue: 0,0:11:36.55,0:11:39.35,Default,Lily,0,0,0,,علينا العثور على المجرمين لوضع حد لهذا.
Dialogue: 0,0:11:39.75,0:11:41.65,Default,ليلي,0,0,0,,اعثر على المحرض في أسرع وقت ممكن.
Dialogue: 0,0:11:41.65,0:11:42.72,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:11:48.19,0:11:50.30,Default,Lily,0,0,0,,اكتشف من أين يأتي البارود.
Dialogue: 0,0:11:51.56,0:11:53.30,Default,ليلي,0,0,0,,تحرك بهدوء وحيداً.
Dialogue: 0,0:11:53.60,0:11:54.67,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:12:04.71,0:12:05.75,Default,ليلي,0,0,0,,السيد.
Dialogue: 0,0:12:06.31,0:12:08.91,Default,ليلي,0,0,0,,أرجوك سامحني.
Dialogue: 0,0:12:09.95,0:12:12.75,Default,ليلي,0,0,0,,ماذا تفعلين؟ عيون كثيرة جدا.
Dialogue: 0,0:12:13.32,0:12:14.52,Default,ليلي,0,0,0,,أتوسل إليك.
Dialogue: 0,0:12:14.69,0:12:16.36,Default,ليلي,0,0,0,,استمع إلي.
Dialogue: 0,0:12:16.76,0:12:20.19,Default,ليلي,0,0,0,,لن يستغرق الأمر الكثير من الوقت. فقط قليلا.
Dialogue: 0,0:12:20.46,0:12:22.83,Default,ليلي,0,0,0,,من فضلك. ليس لفترة طويلة.
Dialogue: 0,0:12:25.33,0:12:26.40,Default,ليلي,0,0,0,,أنا في حالة احتياط
Dialogue: 0,0:12:27.83,0:12:30.47,Default,ليلي,0,0,0,,احتفظت بدفتر المحاسبة.
Dialogue: 0,0:12:32.24,0:12:35.17,Default,Lily,0,0,0,,لم أفكر قط في استخدامه.
Dialogue: 0,0:12:35.41,0:12:39.11,Default,ليلي,0,0,0,,إلى جانب ذلك، لم تكن الملكة تعرف شيئًا عن ذلك.
Dialogue: 0,0:12:39.38,0:12:40.98,Default,ليلي,0,0,0,,أين دفتر المحاسبة الآن؟
Dialogue: 0,0:12:46.92,0:12:49.29,Default,ليلي,0,0,0,,أليست في حوزتك؟
Dialogue: 0,0:12:50.62,0:12:52.22,Default,ليلي,0,0,0,,إذن لا يمكنها إلا أن تكون
Dialogue: 0,0:12:53.33,0:12:54.49,Default,ليلي,0,0,0,,عند الملك.
Dialogue: 0,0:12:56.13,0:12:57.16,Default,ليلي,0,0,0,,كيف ذلك.
Dialogue: 0,0:13:00.73,0:13:03.34,Default,Lily,0,0,0,,الآثار التي تركتها تعرض عشيرتنا للخطر.
Dialogue: 0,0:13:03.57,0:13:05.74,Default,ليلي,0,0,0,,هذا يكفي لمعاقبتك.
Dialogue: 0,0:13:06.27,0:13:07.44,Default,ليلي,0,0,0,,سأفعل كل ما تقوله.
Dialogue: 0,0:13:08.07,0:13:09.94,Default,Lily,0,0,0,,إذا قلت لي أن أموت، سأموت.
Dialogue: 0,0:13:14.98,0:13:16.08,Default,ليلي,0,0,0,,هنا.
Dialogue: 0,0:13:19.49,0:13:21.42,Default,ليلي,0,0,0,,سأشنق نفسي هنا.
Dialogue: 0,0:13:25.39,0:13:26.86,Default,ليلي,0,0,0,,أنا أشنق نفسي.
Dialogue: 0,0:13:33.43,0:13:35.73,Default,ليلي,0,0,0,,أعذرني يا سيدي.
Dialogue: 0,0:13:36.90,0:13:40.11,Default,ليلي,0,0,0,,اعفيني.
Dialogue: 0,0:13:50.45,0:13:52.18,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:13:52.18,0:13:55.59,Default,ليلي,0,0,0,,جلالتك، هل عدت إلى رشدك؟
Dialogue: 0,0:13:57.36,0:13:58.89,Default,ليلي,0,0,0,,أخي.
Dialogue: 0,0:13:58.89,0:14:01.39,Default,ليلي,0,0,0,,نعم. يكمل.
Dialogue: 0,0:14:02.66,0:14:04.50,Default,ليلي,0,0,0,,لماذا الجو صاخب جداً هنا؟
Dialogue: 0,0:14:05.70,0:14:08.50,Default,Lily,0,0,0,,صاخب جدًا ويسبب لي الصداع.
Dialogue: 0,0:14:10.80,0:14:12.81,Default,ليلي,0,0,0,,لا أستطيع سماع أي شيء.
Dialogue: 0,0:14:14.97,0:14:16.94,Default,ليلي,0,0,0,,كتم الضجيج.
Dialogue: 0,0:14:33.76,0:14:35.49,Default,ليلي,0,0,0,,كان يجب أن أشرح.
Dialogue: 0,0:14:37.30,0:14:40.17,Default,Lily,0,0,0,,كان يجب أن أخبره أن الملك لم يحاول قتلي.
Dialogue: 0,0:14:43.34,0:14:45.17,Default,ليلي,0,0,0,,لقد حاول اغتيالك.
Dialogue: 0,0:14:45.37,0:14:47.87,Default,ليلي,0,0,0,,لديك كل الحق في قتله.
Dialogue: 0,0:14:51.64,0:14:54.85,Default,Lily,0,0,0,,سيتعين عليك أن تدفع ثمن تهورك.
Dialogue: 0,0:14:55.85,0:14:57.88,Default,ليلي,0,0,0,,هل عشيرة كيم وراء هذا؟
Dialogue: 0,0:14:59.82,0:15:01.05,Default,ليلي,0,0,0,,أو عشيرة أخرى؟
Dialogue: 0,0:15:03.36,0:15:04.46,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:15:06.29,0:15:09.06,Default,ليلي,0,0,0,,جلالتك. عاد الملك إلى رشده.
Dialogue: 0,0:15:32.69,0:15:34.02,Default,ليلي,0,0,0,,يبدو أنه قد استيقظ.
Dialogue: 0,0:15:35.29,0:15:37.42,Default,ليلي,0,0,0,,لقد نام للتو.
Dialogue: 0,0:15:47.13,0:15:49.03,Default,ليلي,0,0,0,,لماذا لفّته بهذه الطريقة؟
Dialogue: 0,0:15:52.00,0:15:53.44,Default,ليلي,0,0,0,,تبدو مريضة جداً.
Dialogue: 0,0:15:54.41,0:15:55.81,Default,بير,0,0,0,,للأسف,
Dialogue: 0,0:15:56.61,0:15:59.55,Default,bir,0,0,0,,فقد سمعه بسبب الانفجار.
Dialogue: 0,0:16:03.08,0:16:04.18,Default,bir,0,0,0,,لا تقل ذلك،
Dialogue: 0,0:16:07.55,0:16:09.25,Default,bir,0,0,0,,أنه سيكون أصم لبقية حياته.
Dialogue: 0,0:16:09.52,0:16:12.46,Default,بير,0,0,0,,فقط الوقت كفيل بإثبات ذلك.
Dialogue: 0,0:16:27.84,0:16:29.21,Default,bir,0,0,0,,اتركونا وشأننا.
Dialogue: 0,0:16:30.71,0:16:31.78,Default,بير,0,0,0,,نعم.
Dialogue: 0,0:16:50.80,0:16:53.77,Default,bir,0,0,0,,هل ستقول مرة أخرى أن هذا ليس عملاً من نوعك؟
Dialogue: 0,0:16:55.67,0:16:56.97,Default,بير,0,0,0,,لقد أخبرتني،
Dialogue: 0,0:16:58.24,0:17:00.21,Default,bir,0,0,0,,أنني سأفقد شخصاً عزيزاً على قلبي.
Dialogue: 0,0:17:03.14,0:17:04.64,Default,bir,0,0,0,,الآن في قلبي
Dialogue: 0,0:17:05.84,0:17:08.28,Default,bir,0,0,0,,لم يبق أحد.
Dialogue: 0,0:17:12.62,0:17:13.85,Default,bir,0,0,0,,لذا أسأل،
Dialogue: 0,0:17:15.59,0:17:16.76,Default,bir,0,0,0,,أوقف هذا.
Dialogue: 0,0:17:36.78,0:17:39.65,Default,bir,0,0,0,,يا صاحب الجلالة، توقف عن القلق.
Dialogue: 0,0:18:03.77,0:18:04.87,Default,بير,0,0,0,,من...
Dialogue: 0,0:18:06.64,0:18:09.64,Default,bir,0,0,0,,ملكي، هل استيقظت؟
Dialogue: 0,0:18:10.91,0:18:12.61,Default,bir,0,0,0,,دعني أبلل شفتيك.
Dialogue: 0,0:18:23.89,0:18:25.86,Default,bir,0,0,0,,قاموس الملكة
Dialogue: 0,0:18:54.25,0:18:56.02,Default,bir,0,0,0,,فذهبت لزيارة الملك.
Dialogue: 0,0:19:02.59,0:19:05.40,Default,bir,0,0,0,,جئت لتعزيكم بعد ما حدث
Dialogue: 0,0:19:05.83,0:19:08.10,Default,bir,0,0,0,,واطرح بعض الأسئلة.
Dialogue: 0,0:19:10.04,0:19:12.94,Default,bir,0,0,0,,لقد فقد والدك شيئاً مهماً.
Dialogue: 0,0:19:13.71,0:19:16.28,Default,bir,0,0,0,,أنا متأكد من أن الملك أخذها سراً.
Dialogue: 0,0:19:17.11,0:19:18.88,Default,bir,0,0,0,,هل تعرف شيئاً عن هذا؟
Dialogue: 0,0:19:20.05,0:19:22.48,Default,bir,0,0,0,,-فهمت، أنا أطلب المساعدة.\N-لا.
Dialogue: 0,0:19:23.12,0:19:25.78,Default,bir,0,0,0,,لا ينبغي لأحد أن يعرف أنني...
Dialogue: 0,0:19:26.99,0:19:29.02,Default,بير,0,0,0,,ما أنا...
Dialogue: 0,0:19:33.53,0:19:34.86,Default,bir,0,0,0,,إذن أنت تعرف شيئًا ما.
Dialogue: 0,0:19:36.06,0:19:37.90,Default,bir,0,0,0,,تذكر ما قلته،
Dialogue: 0,0:19:37.90,0:19:39.73,Default,bir,0,0,0,,أن نوعنا ليس لديه نقاط ضعف؟
Dialogue: 0,0:19:40.93,0:19:42.97,Default,bir,0,0,0,,لأننا تخلصنا منهم على الفور.
Dialogue: 0,0:19:52.18,0:19:55.08,Default,bir,0,0,0,,دعني أسألك مرة أخيرة.
Dialogue: 0,0:19:56.38,0:19:58.72,Default,bir,0,0,0,,هل هناك أي شيء تريد إخباري به؟
Dialogue: 0,0:20:01.39,0:20:02.89,Default,bir,0,0,0,,عندما كنا في منزلي،
Dialogue: 0,0:20:04.02,0:20:07.13,Default,bir,0,0,0,,لقد أنقذت الملك عندما سقط في البئر.
Dialogue: 0,0:20:08.29,0:20:09.66,Default,bir,0,0,0,,ربما كان ذلك حينها...
Dialogue: 0,0:20:15.37,0:20:18.77,Default,bir,0,0,0,,منذ بعض الوقت قدمت لك عرضاً.
Dialogue: 0,0:20:19.30,0:20:21.44,Default,بير,0,0,0,,اليوم الذي سقطت فيه في البحيرة.
Dialogue: 0,0:20:24.61,0:20:26.68,Default,bir,0,0,0,,دعني أذكرك.
Dialogue: 0,0:20:27.85,0:20:30.58,Default,bir,0,0,0,,طلبت منك ألا ترفعي عينيك عن زوجك.
Dialogue: 0,0:20:31.85,0:20:33.09,Default,بير,0,0,0,,سوف تقبل
Dialogue: 0,0:20:34.45,0:20:36.76,Default,بير,0,0,0,,اقتراحي؟
Dialogue: 0,0:20:47.10,0:20:50.74,Default,bir,0,0,0,,وماذا سأحصل في المقابل؟
Dialogue: 0,0:20:51.34,0:20:52.84,Default,bir,0,0,0,,ماذا تريد؟
Dialogue: 0,0:20:54.64,0:20:56.48,Default,bir,0,0,0,,ضمانات سلامتي.
Dialogue: 0,0:21:16.13,0:21:18.40,Default,bir,0,0,0,,صاحب السمو، حان وقت عودتك.
Dialogue: 0,0:21:30.51,0:21:32.21,Default,bir,0,0,0,,قاموس الملكة
Dialogue: 0,0:21:58.27,0:21:59.94,Default,bir,0,0,0,,ما كان يجب أن أصل إلى هنا\NJang Bong-hwan
Dialogue: 0,0:22:13.12,0:22:14.19,Default,bir,0,0,0,,تشولجونغ.
Dialogue: 0,0:22:15.15,0:22:16.25,Default,بير,0,0,0,,عذراً.
Dialogue: 0,0:22:17.66,0:22:19.32,Default,bir,0,0,0,,سوف تظل خاسراً.
Dialogue: 0,0:22:21.56,0:22:23.43,Default,bir,0,0,0,,أنا مع الفائز.
Dialogue: 0,0:22:30.94,0:22:34.41,Default,bir,0,0,0,,كيم سويون، مازلت تقولين وداعًا للحياة.
Dialogue: 0,0:22:36.17,0:22:38.01,Default,bir,0,0,0,,بما أنني قد أخذت مكانك بالفعل،
Dialogue: 0,0:22:38.78,0:22:40.98,Default,بير,0,0,0,,دعني أعيش هذه الحياة جيدًا.
Dialogue: 0,0:22:43.28,0:22:45.18,Default,bir,0,0,0,,لكي ينجح هذا، أحتاج إلى معرفة ذلك
Dialogue: 0,0:22:45.88,0:22:47.22,Default,bir,0,0,0,,ماذا حدث في ذلك اليوم.
Dialogue: 0,0:23:48.48,0:23:50.15,Default,بير,0,0,0,,يوماً ما ستخسر
Dialogue: 0,0:23:50.25,0:23:52.78,Default,بير,0,0,0,,شخص عزيز عليك.
Dialogue: 0,0:23:54.02,0:23:56.12,Default,بير,0,0,0,,يجب أن تحبني.
Dialogue: 0,0:23:56.12,0:23:58.16,Default,bir,0,0,0,,هل هذا أمر؟
Dialogue: 0,0:24:03.10,0:24:05.90,Default,bir,0,0,0,,ليس هناك شيء حقيقي عني، كل شيء كذب.
Dialogue: 0,0:24:07.40,0:24:09.33,Default,bir,0,0,0,,أنت سويون.
Dialogue: 0,0:24:16.21,0:24:18.78,Default,bir,0,0,0,,هل اتخذت هذا الموقف بنفسك؟
Dialogue: 0,0:24:19.48,0:24:21.85,Default,bir,0,0,0,,إذا أردت أن تموت، مت في القصر.
Dialogue: 0,0:24:23.18,0:24:25.92,Default,bir,0,0,0,,غداً ستصبحين ملكة.
Dialogue: 0,0:24:35.66,0:24:38.40,Default,bir,0,0,0,,غداً ستصبحين ملكة.
Dialogue: 0,0:24:38.53,0:24:39.60,Default,بير,0,0,0,,من الآن فصاعدا
Dialogue: 0,0:24:40.43,0:24:43.84,Default,بير,0,0,0,,أخبرني كل شيء عنه.
Dialogue: 0,0:24:43.97,0:24:46.34,Default,بير,0,0,0,,اسألني
Dialogue: 0,0:24:47.87,0:24:49.24,Default,بير,0,0,0,,تراقب الملك؟
Dialogue: 0,0:24:49.54,0:24:52.51,Default,bir,0,0,0,,لا تتبعي الملك\N ولا ترفعي عينيك عن زوجك.
Dialogue: 0,0:24:57.18,0:24:58.32,Default,بير,0,0,0,,لا أريد.
Dialogue: 0,0:25:00.85,0:25:03.89,Default,bir,0,0,0,,ألست بحاجة إلى حالة الملكة
Dialogue: 0,0:25:03.89,0:25:05.76,Default,بير,0,0,0,,والملك؟
Dialogue: 0,0:25:06.59,0:25:09.93,Default,bir,0,0,0,,يجب أن تفعل ما ولدت من أجله.
Dialogue: 0,0:25:12.36,0:25:14.80,Default,bir,0,0,0,,كما فعلوا في الماضي.
Dialogue: 0,0:25:20.11,0:25:23.11,Default,bir,0,0,0,,عندما أخبروني أن الملك في البئر.
Dialogue: 0,0:25:28.65,0:25:31.58,Default,bir,0,0,0,,إذا لم تكن تؤدي دورك،
Dialogue: 0,0:25:31.82,0:25:35.22,Default,بير,0,0,0,,الملك عديم الفائدة. من عديمة الفائدة
Dialogue: 0,0:25:36.15,0:25:37.92,Default,bir,0,0,0,,علينا أن نتخلص منه.
Dialogue: 0,0:25:39.19,0:25:40.96,Default,bir,0,0,0,,إذا آذيت الملك،
Dialogue: 0,0:25:41.76,0:25:43.40,Default,bir,0,0,0,,لن أقف مكتوف الأيدي.
Dialogue: 0,0:25:43.40,0:25:45.66,Default,bir,0,0,0,,فماذا ستفعل إذن؟
Dialogue: 0,0:25:46.30,0:25:48.40,Default,bir,0,0,0,,أنت مخطئ جدًا.
Dialogue: 0,0:25:48.70,0:25:52.37,Default,bir,0,0,0,,هل تعتقد أن الملكة لديها السلطة؟
Dialogue: 0,0:25:52.90,0:25:58.41,Default,bir,0,0,0,,الملكة مطلوبة فقط\N لإنتاج ورثة.
Dialogue: 0,0:26:00.11,0:26:02.41,Default,bir,0,0,0,,إذا أصبحت ملكة،
Dialogue: 0,0:26:02.41,0:26:04.25,Default,bir,0,0,0,,ما هو نوع القوة التي تعتقد أنك ستتمتع بها؟
Dialogue: 0,0:26:05.35,0:26:08.12,Default,bir,0,0,0,,مثل امرأة بسيطة؟
Dialogue: 0,0:26:53.50,0:26:55.53,Default,bir,0,0,0,,هذا ليس فقط بسبب كلمات كيم جواجيون.
Dialogue: 0,0:26:57.47,0:26:59.77,Default,bir,0,0,0,,حتى بعد المكوث في القصر لفترة قصيرة،
Dialogue: 0,0:27:00.97,0:27:03.68,Default,bir,0,0,0,,لقد اكتسبت ما يكفي من الخبرة لأدرك الواقع.
Dialogue: 0,0:27:10.08,0:27:11.88,Default,بير,0,0,0,,القصر كله
Dialogue: 0,0:27:13.82,0:27:15.75,Default,بير,0,0,0,,قتلت كيم سو يون.
Dialogue: 0,0:27:22.92,0:27:24.02,Default,bir,0,0,0,,جلالتك.
Dialogue: 0,0:27:25.99,0:27:27.06,Default,bir,0,0,0,,جلالتك.
Dialogue: 0,0:27:28.59,0:27:29.59,Default,bir,0,0,0,,جلالتك.
Dialogue: 0,0:27:33.53,0:27:35.63,Default,bir,0,0,0,,صاحب الجلالة، صاحب الجلالة!
Dialogue: 0,0:27:37.17,0:27:39.57,Default,bir,0,0,0,,كوين، ماذا تفعلين هنا في هذا الوقت المتأخر؟
Dialogue: 0,0:27:41.67,0:27:44.91,Default,bir,0,0,0,,لماذا أنت غارق في الماء؟
Dialogue: 0,0:27:45.98,0:27:49.41,Default,bir,0,0,0,,هل سقطوا فعلاً في البحيرة مرة أخرى؟
Dialogue: 0,0:27:52.08,0:27:53.65,Default,bir,0,0,0,,لماذا تستمر في القيام بذلك؟
Dialogue: 0,0:27:54.32,0:27:56.89,Default,bir,0,0,0,,الآن عليك أن تستجمع قواك.
Dialogue: 0,0:27:56.89,0:28:00.59,Default,bir,0,0,0,,وإلا لماذا حاولت جاهداً حتى الآن؟
Dialogue: 0,0:28:01.43,0:28:05.36,Default,bir,0,0,0,,لماذا كان عليّ أن أعاني من هذا الإذلال؟
Dialogue: 0,0:28:05.36,0:28:07.23,Default,bir,0,0,0,,لماذا تحتاج هذا؟
Dialogue: 0,0:28:08.23,0:28:10.60,Default,bir,0,0,0,,من أجل مكاسبهم الخاصة،\N لملء مخازنهم.
Dialogue: 0,0:28:11.64,0:28:14.51,Default,bir,0,0,0,,لقد بعت ابنتك بدافع الجشع.
Dialogue: 0,0:28:15.17,0:28:17.41,Default,bir,0,0,0,,-سويون.\N-لماذا كانوا يسألونني دائماً
Dialogue: 0,0:28:17.41,0:28:19.71,Default,bir,0,0,0,,أن تصبحي ملكة، فخر العائلة؟
Dialogue: 0,0:28:20.18,0:28:23.11,Default,bir,0,0,0,,لماذا قالوا أنه عندما أصبح ملكة، أستطيع أن أفعل ما أريد؟
Dialogue: 0,0:28:23.85,0:28:26.99,Default,bir,0,0,0,,لماذا أعاني من الذنب لموت والدتي،
Dialogue: 0,0:28:26.99,0:28:29.99,Default,بير,0,0,0,,هل ألهمت أحلامك؟
Dialogue: 0,0:28:31.72,0:28:35.09,Default,bir,0,0,0,,هل تعرف حتى ما الذي كنت أفكر فيه عندما قفزت إلى البحيرة؟
Dialogue: 0,0:28:35.89,0:28:38.73,Default,bir,0,0,0,,الحياة التي ظننتها ملكي كانت كذبة.
Dialogue: 0,0:28:40.10,0:28:42.57,Default,bir,0,0,0,,حتى الأحلام لم تكن لي.
Dialogue: 0,0:28:43.74,0:28:45.80,Default,bir,0,0,0,,أنا خاسر تمامًا.
Dialogue: 0,0:28:48.51,0:28:50.68,Default,bir,0,0,0,,لهذا السبب هربت.
Dialogue: 0,0:28:52.91,0:28:53.95,Default,بير,0,0,0,,ماذا؟
Dialogue: 0,0:28:56.35,0:28:58.15,Default,bir,0,0,0,,اليوم الذي تحقق فيه حلمك،
Dialogue: 0,0:28:59.35,0:29:01.95,Default,bir,0,0,0,,لقد فقدت أعز شخص.
Dialogue: 0,0:29:03.19,0:29:04.96,Default,bir,0,0,0,,لنفسي.
Dialogue: 0,0:29:05.76,0:29:08.59,Default,bir,0,0,0,,أنت من دفعني إلى هذه البحيرة.
Dialogue: 0,0:29:33.69,0:29:36.19,Default,bir,0,0,0,,من السهل على الأطفال أن يلوموا والديهم على كل شيء.
Dialogue: 0,0:29:37.32,0:29:39.22,Default,bir,0,0,0,,لم يكن عليك إلقاء اللوم على والدك.
Dialogue: 0,0:29:53.64,0:29:54.71,Default,بير,0,0,0,,جلالتك.
Dialogue: 0,0:30:04.38,0:30:06.12,Default,bir,0,0,0,,يجب أن أقول شيئاً.
Dialogue: 0,0:30:08.12,0:30:10.46,Default,bir,0,0,0,,أعلم أنك ستفعل كل شيء من أجلي.
Dialogue: 0,0:30:11.26,0:30:14.03,Default,bir,0,0,0,,أي أنني اكتشفت ذلك.
Dialogue: 0,0:30:14.03,0:30:15.53,Default,bir,0,0,0,,لقد عادت ذكرياتي.
Dialogue: 0,0:30:23.10,0:30:24.67,Default,bir,0,0,0,,لا تفعل شيئًا آخر.
Dialogue: 0,0:30:25.24,0:30:28.74,Default,bir,0,0,0,,إذا كنت قلقاً عليّ، فلا تفعل أي شيء.
Dialogue: 0,0:30:29.81,0:30:31.34,Default,bir,0,0,0,,هذا فقط سيساعدني.
Dialogue: 0,0:30:33.21,0:30:34.28,Default,bir,0,0,0,,سويون.
Dialogue: 0,0:30:36.21,0:30:37.72,Default,bir,0,0,0,,لا تناديني بالاسم.
Dialogue: 0,0:30:38.85,0:30:40.19,Default,بير,0,0,0,,أنا فقط
Dialogue: 0,0:30:41.22,0:30:43.62,Default,bir,0,0,0,,الملكة التي يخدمها قسم المباحث.
Dialogue: 0,0:30:58.30,0:31:00.74,Default,bir,0,0,0,,قاموس الملكة
Dialogue: 0,0:31:12.72,0:31:14.65,Default,bir,0,0,0,,السهم، لوتو، القوات الخاصة، شرطة المطبخ، الرامن
Dialogue: 0,0:31:14.65,0:31:16.12,Default,بير,0,0,0,,التباعد الاجتماعي
Dialogue: 0,0:31:25.13,0:31:27.27,Default,bir,0,0,0,,يعني كل رجل لنفسه.
Dialogue: 0,0:31:27.27,0:31:29.37,Default,بيرة,0,0,0,,المواجهة، شاي الياسمين، الأخلاق السيئة.
Dialogue: 0,0:31:49.69,0:31:52.09,Default,bir,0,0,0,,سأقول الحقيقة، لأنك لا تستطيع سماعي.
Dialogue: 0,0:31:54.69,0:31:56.66,Default,bir,0,0,0,,قررت أن أعيش حياة طويلة.
Dialogue: 0,0:32:00.90,0:32:02.37,Default,بير,0,0,0,,سوف أخونك.
Dialogue: 0,0:32:04.17,0:32:06.37,Default,bir,0,0,0,,اخترت الطريق الذي سينقذ حياتي.
Dialogue: 0,0:32:08.81,0:32:10.14,Default,بير,0,0,0,,ولا تموت.
Dialogue: 0,0:32:11.14,0:32:12.91,Default,bir,0,0,0,,تعافِ وكأن شيئاً لم يكن.
Dialogue: 0,0:32:15.91,0:32:17.38,Default,bir,0,0,0,,وبعد ذلك يمكنني طعنك في الظهر.
Dialogue: 0,0:32:56.52,0:32:57.89,Default,bir,0,0,0,,لقد كنت على حق.
Dialogue: 0,0:32:58.76,0:33:01.09,Default,bir,0,0,0,,كان الملك أقوى مما أظهر.
Dialogue: 0,0:33:02.09,0:33:03.39,Default,bir,0,0,0,,آسف لذلك.
Dialogue: 0,0:33:03.39,0:33:05.93,Default,bir,0,0,0,,ما رأيك في قضية اليوم؟
Dialogue: 0,0:33:06.73,0:33:08.90,Default,bir,0,0,0,,وجدنا البارود في موقع الانفجار.
Dialogue: 0,0:33:09.07,0:33:10.70,Default,bir,0,0,0,,-البارود؟\N-نعم.
Dialogue: 0,0:33:11.24,0:33:13.34,Default,bir,0,0,0,,هناك نوعان من البارود في جوسون.
Dialogue: 0,0:33:13.54,0:33:15.57,Default,bir,0,0,0,,الذي تم تسليمه من إمبراطورية تشينغ.
Dialogue: 0,0:33:16.01,0:33:18.21,Default,bir,0,0,0,,ومحلي من مستودع البارود.
Dialogue: 0,0:33:18.58,0:33:20.51,Default,bir,0,0,0,,هناك اختلاف طفيف في البنية.
Dialogue: 0,0:33:20.75,0:33:24.12,Default,bir,0,0,0,,الذي وجدناه محلي.
Dialogue: 0,0:33:24.32,0:33:27.35,Default,zina,0,0,0,,مخزن البارود هو جزء من غرفة الأسلحة.
Dialogue: 0,0:33:28.69,0:33:31.46,Default,zina,0,0,0,,ووزير الحرب هو المسؤول عن غرفة الأسلحة.
Dialogue: 0,0:33:32.36,0:33:34.16,Default,zina,0,0,0,,إنه اليد اليمنى لأبي.
Dialogue: 0,0:33:36.19,0:33:37.46,Default,الزنا,0,0,0,,هذا يعني...
Dialogue: 0,0:33:42.47,0:33:45.54,Default,zina,0,0,0,,كان والدي هو من أوصل الملك إلى العرش.
Dialogue: 0,0:33:46.37,0:33:47.97,Default,zina,0,0,0,,أظهر الملك وجهه الحقيقي،
Dialogue: 0,0:33:47.97,0:33:49.94,Default,الزنا,0,0,0,,يريد الأب القضاء عليه قبل أن يصبح خطأه،
Dialogue: 0,0:33:49.94,0:33:52.74,Default,zina,0,0,0,,وجعل الحراس ذوي الهويات المزيفة مذنبين بالانفجار.
Dialogue: 0,0:33:53.04,0:33:54.81,Default,zina,0,0,0,,يجب أن تكون هذه خطته.
Dialogue: 0,0:33:54.81,0:33:58.22,Default,zina,0,0,0,,عندما أتيت إليّ في المرة الأخيرة،\N كنت تريد شيئاً.
Dialogue: 0,0:34:00.05,0:34:01.72,Default,Zina,0,0,0,,فماذا تريد؟
Dialogue: 0,0:34:02.22,0:34:04.09,Default,زينة,0,0,0,,أريد
Dialogue: 0,0:34:07.46,0:34:08.76,Default,zina,0,0,0,,ملك.
Dialogue: 0,0:34:17.84,0:34:19.64,Default,زينة,0,0,0,,لا أستطيع التوقف الآن.
Dialogue: 0,0:34:20.87,0:34:22.81,Default,zina,0,0,0,,وإذا كان هذا ما تشعرين به، سويون،
Dialogue: 0,0:34:24.18,0:34:25.28,Default,الزنا,0,0,0,,هذا سبب آخر.
Dialogue: 0,0:34:47.07,0:34:50.23,Default,zina,0,0,0,,لقد جئت إلى هنا لأخبرك\N عما فعلته الملكة بالأمس.
Dialogue: 0,0:34:51.50,0:34:55.11,Default,zina,0,0,0,,لقد أنقذت وليمة كانت على وشك الفشل.
Dialogue: 0,0:34:55.81,0:34:58.41,Default,zina,0,0,0,,هل تعتقد أنني سأصدقك؟
Dialogue: 0,0:34:58.91,0:35:01.05,Default,zina,0,0,0,,ربما تعتقد،
Dialogue: 0,0:35:01.05,0:35:03.18,Default,zina,0,0,0,,أنا من تسبب في الحادثة مع الملك.
Dialogue: 0,0:35:03.18,0:35:05.25,Default,zina,0,0,0,,إذا تحققت، ستجد الإجابة بسهولة.
Dialogue: 0,0:35:05.88,0:35:09.12,Default,zina,0,0,0,,كما أفهم، أردت إفساد العيد.
Dialogue: 0,0:35:09.45,0:35:11.52,Default,zina,0,0,0,,حتى لو جُردت الملكة من لقبها...
Dialogue: 0,0:35:11.52,0:35:13.46,Default,zina,0,0,0,,لست بحاجة إلى أي ألقاب.
Dialogue: 0,0:35:14.03,0:35:18.00,Default,zina,0,0,0,,أريد فقط أن تختفي الملكة عن أنظار الملك.
Dialogue: 0,0:35:19.33,0:35:20.60,Default,الزنا,0,0,0,,هذا يعني،
Dialogue: 0,0:35:21.90,0:35:24.27,Default,Zina,0,0,0,,أن الملك يحب الملكة.
Dialogue: 0,0:36:36.94,0:36:39.48,Default,zina,0,0,0,,بالنظر إلى الأمر، لقد واجهت وقتًا عصيبًا.
Dialogue: 0,0:36:40.51,0:36:42.81,Default,zina,0,0,0,,هل أنت قلقة جداً على الملك؟
Dialogue: 0,0:36:44.32,0:36:45.35,Default,زينة,0,0,0,,يا إلهي.
Dialogue: 0,0:36:46.38,0:36:48.22,Default,zina,0,0,0,,لقد أصبح صهرك مؤخراً فقط.
Dialogue: 0,0:36:48.62,0:36:50.46,Default,zina,0,0,0,,يبدو أنك قد تعلقت به.
Dialogue: 0,0:36:50.66,0:36:51.72,Default,زينة,0,0,0,,حسناً،
Dialogue: 0,0:36:54.13,0:36:55.23,Default,زينة,0,0,0,,بصراحة،
Dialogue: 0,0:36:55.96,0:36:59.26,Default,zina,0,0,0,,لقد فعلت شيئاً من شأنه أن يشين عائلتنا.
Dialogue: 0,0:37:00.63,0:37:03.47,Default,zina,0,0,0,,احتفظت بسجلات للممتلكات المكتسبة بشكل غير قانوني لعائلتنا.
Dialogue: 0,0:37:05.10,0:37:06.64,Default,Zina,0,0,0,,ولقد فقدتهم.
Dialogue: 0,0:37:07.27,0:37:08.34,Default,الزنا,0,0,0,,ماذا؟
Dialogue: 0,0:37:08.34,0:37:10.14,Default,zina,0,0,0,,لقد اكتشفت مكان الكتاب الآن.
Dialogue: 0,0:37:10.51,0:37:12.71,Default,zina,0,0,0,,أنا فقط بحاجة للعثور عليها والتخلص منها.
Dialogue: 0,0:37:13.61,0:37:16.61,Default,zina,0,0,0,,لكنني أطلب منك الحفاظ على الملكة.
Dialogue: 0,0:37:17.92,0:37:20.28,Default,zina,0,0,0,,لماذا ذكرت ذلك فجأة؟
Dialogue: 0,0:37:20.28,0:37:21.62,Default,zina,0,0,0,,الشخص الذي لديه الآن كتاب،
Dialogue: 0,0:37:23.22,0:37:24.49,Default,الزنا,0,0,0,,هذا هو الملك.
Dialogue: 0,0:37:26.42,0:37:29.33,Default,zina,0,0,0,,ليس للملكة علاقة\N بهذا الموقف.
Dialogue: 0,0:37:29.69,0:37:33.06,Default,zina,0,0,0,,لقد ضللني الملك وأنا.
Dialogue: 0,0:37:35.97,0:37:38.54,Default,zina,0,0,0,,نعم لقد ضلل الجميع.
Dialogue: 0,0:37:38.77,0:37:42.01,Default,zina,0,0,0,,سوف أقبل أياً من عقوبتك.
Dialogue: 0,0:37:43.11,0:37:44.18,Default,زينة,0,0,0,,لكن
Dialogue: 0,0:37:46.31,0:37:47.65,Default,Zina,0,0,0,,ارحم سويون.
Dialogue: 0,0:37:49.11,0:37:51.02,Default,Zina,0,0,0,,احتفظ بالملكة.
Dialogue: 0,0:37:52.12,0:37:54.99,Default,zina,0,0,0,,أتوسل إليك، احتفظ بالملكة.
Dialogue: 0,0:37:59.06,0:38:00.12,Default,Zina,0,0,0,,أبتاه.
Dialogue: 0,0:38:05.33,0:38:07.53,Default,zina,0,0,0,,هل نمت في قسم المباحث؟
Dialogue: 0,0:38:07.53,0:38:11.14,Default,Zina,0,0,0,,نعم. هذه صفقة كبيرة، ولدي الكثير من العمل للقيام به.
Dialogue: 0,0:38:11.74,0:38:15.44,Default,zina,0,0,0,,كل شيء في القضية يشير إلي كمجرم.
Dialogue: 0,0:38:16.11,0:38:18.24,Default,Zina,0,0,0,,لكنك لم تتحدث عن ذلك.
Dialogue: 0,0:38:19.04,0:38:20.31,Default,الزنا,0,0,0,,لا تقلق.
Dialogue: 0,0:38:21.15,0:38:23.55,Default,zina,0,0,0,,تولى قسم المباحث التحقيق.
Dialogue: 0,0:38:23.55,0:38:25.22,Default,الزنا,0,0,0,,إذا تم الافتراء عليك،
Dialogue: 0,0:38:25.58,0:38:27.99,Default,zina,0,0,0,,سأكشف عن الجاني الحقيقي لهذه الحادثة.
Dialogue: 0,0:38:28.62,0:38:30.02,Default,الزنا,0,0,0,,هذا مهدئ.
Dialogue: 0,0:38:31.72,0:38:33.16,Default,الزنا,0,0,0,,مؤخراً
Dialogue: 0,0:38:33.46,0:38:37.20,Default,zina,0,0,0,,لقد قلت أنك قد قررت\N حجم حلمك.
Dialogue: 0,0:38:38.46,0:38:41.00,Default,zina,0,0,0,,ما هو حجم حلمك إذن؟
Dialogue: 0,0:38:43.27,0:38:44.87,Default,زينة,0,0,0,,حلمي -
Dialogue: 0,0:38:46.34,0:38:48.94,Default,zina,0,0,0,,أصبح على الأقل نصف نجاحك.
Dialogue: 0,0:38:55.38,0:38:57.58,Default,Zina,0,0,0,,لقد فات الأوان. استراحة.
Dialogue: 0,0:39:20.91,0:39:21.97,Default,الزنا,0,0,0,,لا تقترب.
Dialogue: 0,0:39:22.51,0:39:24.04,Default,zina,0,0,0,,إذا اتبعتني سأقتل نفسي.
Dialogue: 0,0:39:28.65,0:39:29.68,Default,zina,0,0,0,,سويون.
Dialogue: 0,0:39:41.59,0:39:46.46,Default,zina,0,0,0,,أعرف ما الذي يحفزك.
Dialogue: 0,0:40:14.83,0:40:18.06,Default,zina,0,0,0,,أين الملكة في الصباح الباكر؟
Dialogue: 0,0:40:18.30,0:40:19.83,Default,Zina,0,0,0,,إنها في المطبخ الملكي.
Dialogue: 0,0:40:20.33,0:40:21.43,Default,زينة,0,0,0,,الآن.
Dialogue: 0,0:40:22.60,0:40:23.60,Default,الزنا,0,0,0,,لا شيء.
Dialogue: 0,0:40:24.34,0:40:27.20,Default,zina,0,0,0,,أردت منها أن تحضر لي الإفطار عندما تستيقظ.
Dialogue: 0,0:40:27.47,0:40:30.21,Default,zina,0,0,0,,وهي تطبخ لجدتها بالفعل، هذا هو الحال.
Dialogue: 0,0:40:51.50,0:40:52.70,Default,zina,0,0,0,,هذا أخافني.
Dialogue: 0,0:40:52.93,0:40:55.67,Default,الزنا,0,0,0,,الوقت مبكر جداً. ماذا تطبخ؟
Dialogue: 0,0:40:55.90,0:40:58.50,Default,zina,0,0,0,,لقد كنت مكتئباً جداً مؤخراً.\N ولا أستطيع النوم.
Dialogue: 0,0:40:58.67,0:41:00.64,Default,الزنا,0,0,0,,كما لو كنت أصلي صلاة الصبح،
Dialogue: 0,0:41:00.64,0:41:02.27,Default,zina,0,0,0,,أنا أعد طبقاً مزعجاً جداً،
Dialogue: 0,0:41:02.27,0:41:04.61,Default,zin,0,0,0,,الذي يحتاج إلى سحقه وخلطه مليون مرة.
Dialogue: 0,0:41:05.68,0:41:08.11,Default,zina,0,0,0,,لكن عصيدة الأرز تبدو غريبة إلى حدٍ ما.
Dialogue: 0,0:41:08.11,0:41:10.92,Default,Zina,0,0,0,,هذه ليست عصيدة الأرز. هذا هو الحساء.
Dialogue: 0,0:41:11.28,0:41:12.85,Default,الزنا,0,0,0,,اللسان مدغمج؟ ما زال الوقت مبكرًا.
Dialogue: 0,0:41:12.85,0:41:15.15,Default,zina,0,0,0,,وهذا يعني "عصيدة الجزر".
Dialogue: 0,0:41:15.42,0:41:18.22,Default,zina,0,0,0,,انتظر، أريد أن أكتبها.
Dialogue: 0,0:41:19.79,0:41:20.93,Default,الزنا,0,0,0,,وكيف نفعل ذلك؟
Dialogue: 0,0:41:21.03,0:41:25.26,Default,zina,0,0,0,,تحتاج إلى تقطيع البصل والجزر وطهيهما في الماء لمدة ساعة.
Dialogue: 0,0:41:25.26,0:41:26.93,Default,الزنا,0,0,0,,ثم اطحن في الهاون.
Dialogue: 0,0:41:26.93,0:41:29.23,Default,zina,0,0,0,,كما لو كنت تسحق كل التجارب والأوهام.
Dialogue: 0,0:41:29.77,0:41:33.47,Default,zina,0,0,0,,ثم يقلب على نار خفيفة حتى لا يحترق ولا يكون هناك جلطات.
Dialogue: 0,0:41:33.47,0:41:35.14,Default,الزنا,0,0,0,,مع شعور بتحسين الذات.
Dialogue: 0,0:41:35.91,0:41:38.11,Default,الزنا,0,0,0,,تبل بالملح
Dialogue: 0,0:41:40.14,0:41:41.98,Default,الزنا,0,0,0,,وأضف القليل من الحليب.
Dialogue: 0,0:41:41.98,0:41:43.41,Default,الزنا,0,0,0,,حتى الحليب؟
Dialogue: 0,0:41:43.51,0:41:45.02,Default,zina,0,0,0,,هذا كل شيء؟
Dialogue: 0,0:41:45.22,0:41:46.32,Default,زينة,0,0,0,,لا.
Dialogue: 0,0:41:46.78,0:41:50.82,Default,zina,0,0,0,,عليك تحضير حساء الخضار مسبقاً.
Dialogue: 0,0:41:51.19,0:41:52.59,Default,الزنا,0,0,0,,خذ المرق
Dialogue: 0,0:41:53.56,0:41:56.53,Default,zina,0,0,0,,وأضف القليل إلى العصيدة للحصول على مذاق غني.
Dialogue: 0,0:41:56.66,0:41:59.16,Default,zina,0,0,0,,هل أنت في حيرة من أمرك لتضيف القليل فحسب؟
Dialogue: 0,0:41:59.16,0:42:02.10,Default,زينة,0,0,0,,أخبرتك بذلك. إنها مثل صلاة الصبح.
Dialogue: 0,0:42:04.90,0:42:07.14,Default,zina,0,0,0,,لقد وضعت قلبك وروحك في هذا.
Dialogue: 0,0:42:07.14,0:42:10.74,Default,zina,0,0,0,,أنا متأكد من أن الملك سيعود إلى رشده على الفور بمجرد أن يحاول.
Dialogue: 0,0:42:11.84,0:42:12.88,Default,zina,0,0,0,,هذا ليس له.
Dialogue: 0,0:42:16.01,0:42:18.88,Default,zina,0,0,0,,ماذا أعاني مرتين، سأكتشف ذلك بضربة واحدة.
Dialogue: 0,0:42:19.25,0:42:21.69,Default,Zina,0,0,0,,لأنني أخبرتها بشيء آخر مرة،
Dialogue: 0,0:42:21.72,0:42:25.36,Default,الزنا,0,0,0,,تجبرني على تناول الطعام مع حماتي؟
Dialogue: 0,0:42:26.19,0:42:30.09,Default,zina,0,0,0,,تجرأت على القول بفمها الضال إنني عجوز،
Dialogue: 0,0:42:30.36,0:42:32.26,Default,Zina,0,0,0,,هل يجب أن أنظر إليها في الصباح؟
Dialogue: 0,0:42:38.64,0:42:40.27,Default,Zina,0,0,0,,ما هذا؟
Dialogue: 0,0:42:40.27,0:42:41.84,Default,zina,0,0,0,,هذا هو الفطور.
Dialogue: 0,0:42:42.41,0:42:43.81,Default,زينة,0,0,0,,فطور متأخر؟
Dialogue: 0,0:42:43.97,0:42:46.14,Default,zina,0,0,0,,تعني "النساء يجتمعن معاً".
Dialogue: 0,0:42:46.38,0:42:48.55,Default,الزنا,0,0,0,,هذا هو الوقت الذي تجتمع فيه النساء لتناول الإفطار
Dialogue: 0,0:42:48.55,0:42:50.65,Default,الزنا,0,0,0,,وتقربوا من بعضكم البعض.
Dialogue: 0,0:42:50.95,0:42:53.75,Default,zina,0,0,0,,الجميع يعرف ما هو.
Dialogue: 0,0:42:53.75,0:42:55.52,Default,zina,0,0,0,,يبدو أنك لست من غوجوسون.
Dialogue: 0,0:42:55.59,0:42:56.69,Default,Zina,0,0,0,,الأحمق.
Dialogue: 0,0:42:57.86,0:43:00.79,Default,zina,0,0,0,,كنت أفعل ذلك كثيراً في المنزل.
Dialogue: 0,0:43:01.19,0:43:02.46,Default,Zina,0,0,0,,لقد مضى وقت طويل.
Dialogue: 0,0:43:03.36,0:43:04.63,Default,Zina,0,0,0,,الأحمق.
Dialogue: 0,0:43:07.47,0:43:09.57,Default,Zina,0,0,0,,هذه عصيدة الجزر.
Dialogue: 0,0:43:09.83,0:43:12.37,Default,zina,0,0,0,,يحتوي على العديد من المنتجات التي\N ستساعد في تحسين الرؤية.
Dialogue: 0,0:43:12.37,0:43:13.44,Default,الزنا,0,0,0,,نعم؟
Dialogue: 0,0:43:14.14,0:43:15.81,Default,Zina,0,0,0,,الملكة الأم، تناولي المزيد.
Dialogue: 0,0:43:15.81,0:43:18.18,Default,zina,0,0,0,,يبدو أنك أصبحت أعمى مؤخراً.
Dialogue: 0,0:43:18.18,0:43:22.21,Default,zina,0,0,0,,إذا كان الأمر كذلك، فأعتقد أن الملكة بحاجة إلى أكل كل شيء.
Dialogue: 0,0:43:23.45,0:43:25.08,Default,الزنا,0,0,0,,ما هذا؟ لماذا هم مغرور جدا؟
Dialogue: 0,0:43:33.46,0:43:34.89,Default,زينة,0,0,0,,لذيذ جداً.
Dialogue: 0,0:43:41.23,0:43:42.73,Default,الزنا,0,0,0,,صالح للأكل.
Dialogue: 0,0:43:44.17,0:43:45.70,Default,الزنا,0,0,0,,من الآن فصاعدا
Dialogue: 0,0:43:45.70,0:43:48.24,Default,zina,0,0,0,,سوف أتأكد من أن\Nنجتمع معًا في كثير من الأحيان.
Dialogue: 0,0:43:48.24,0:43:50.41,Default,zina,0,0,0,,-لقيط.\N-يا له من لقيط.
Dialogue: 0,0:43:50.47,0:43:52.48,Default,zina,0,0,0,,ثم أعتذر.
Dialogue: 0,0:43:54.61,0:43:56.28,Default,Zina,0,0,0,,سأحضر لك المشروبات.
Dialogue: 0,0:44:05.16,0:44:09.53,Default,zina,0,0,0,,الشائعات حول مهارات الملكة في الطهي مبالغ فيها بعض الشيء.
Dialogue: 0,0:44:09.83,0:44:12.93,Default,zina,0,0,0,,القدرة على التعرف على الطعام الجيد هي عنصر من عناصر النبل.
Dialogue: 0,0:44:13.53,0:44:18.10,Default,zina,0,0,0,,هل ستترك الملكة تفلت من كل شيء\N فقط من أجل هذه الموهبة؟
Dialogue: 0,0:44:18.10,0:44:21.01,Default,zina,0,0,0,,بما أنك أنت من نقلت لي كلام الملكة،
Dialogue: 0,0:44:21.57,0:44:23.27,Default,Zina,0,0,0,,لا أصدق ذلك.
Dialogue: 0,0:44:24.68,0:44:28.75,Default,zina,0,0,0,,بالطبع لن تصدقي ما أقول.
Dialogue: 0,0:44:29.05,0:44:31.72,Default,Zina,0,0,0,,سمعت الملك والملكة
Dialogue: 0,0:44:32.42,0:44:35.22,Default,Zina,0,0,0,,تبادلنا الرسائل سراً طوال الليل.
Dialogue: 0,0:44:35.62,0:44:39.09,Default,zina,0,0,0,,أتساءل ماذا كتبوا لبعضهم البعض؟
Dialogue: 0,0:44:40.89,0:44:43.86,Default,Zina,0,0,0,,سأحضر مشروباتك.
Dialogue: 0,0:44:52.77,0:44:54.51,Default,zina,0,0,0,,هذا مشروب مصنوع من النبيذ والفواكه المختلفة،
Dialogue: 0,0:44:54.51,0:44:57.68,Default,الزنا,0,0,0,,مسلوق مع اليانسون والقرفة.
Dialogue: 0,0:44:58.58,0:45:00.38,Default,زينة,0,0,0,,النبيذ في الصباح؟
Dialogue: 0,0:45:00.41,0:45:02.01,Default,الزنا,0,0,0,,لقد تبخر كل الكحول،
Dialogue: 0,0:45:02.01,0:45:04.85,Default,zina,0,0,0,,لم يتبق سوى المنتجات التي تساعد في الحفاظ على الشباب.
Dialogue: 0,0:45:05.45,0:45:09.02,Default,الزنا,0,0,0,,هذا دواء أكثر منه شراب.
Dialogue: 0,0:45:16.99,0:45:19.13,Default,zina,0,0,0,,لا أستطيع أن أصدق أنك فكرت في صنع النبيذ.
Dialogue: 0,0:45:19.60,0:45:22.50,Default,zina,0,0,0,,كيف خطرت لك هذه الفكرة؟
Dialogue: 0,0:45:22.83,0:45:27.07,Default,zina,0,0,0,,من أين تستلهم أطباقك؟
Dialogue: 0,0:45:27.07,0:45:31.38,Default,الزنا,0,0,0,,لا أعرف هل أسميه إلهاماً أم خلقاً.
Dialogue: 0,0:45:31.38,0:45:34.45,Default,zina,0,0,0,,عندما أرى المكونات، أفكر على الفور
Dialogue: 0,0:45:34.45,0:45:36.01,Default,zina,0,0,0,,كيفية الحفاظ على طعمها الأصلي.
Dialogue: 0,0:45:36.45,0:45:38.88,Default,zina,0,0,0,,في هذه الأوقات كانوا حذرين من الغرب،
Dialogue: 0,0:45:38.88,0:45:40.65,Default,zina,0,0,0,,لذلك لن أقول أن هذا مطبخ فرنسي.
Dialogue: 0,0:45:46.92,0:45:47.93,Default,إطلاق النار,0,0,0,,سيدة.
Dialogue: 0,0:45:53.90,0:45:55.43,Default,إطلاق النار,0,0,0,,مرحباً يا سيدي.
Dialogue: 0,0:45:56.90,0:45:59.74,Default,إطلاق النار,0,0,0,,كنت أنتظر أن تتحدث.
Dialogue: 0,0:45:59.74,0:46:02.74,Default,إطلاق النار,0,0,0,,ماذا؟ ما الذي تريد التحدث عنه؟
Dialogue: 0,0:46:02.74,0:46:05.01,Default,إطلاق النار,0,0,0,,بعد الحادثة مع الملك
Dialogue: 0,0:46:05.74,0:46:07.54,Default,تصويب,0,0,0,,لقد تغلبت علي أفكار مختلفة.
Dialogue: 0,0:46:09.15,0:46:11.32,Default,إطلاق النار,0,0,0,,لا أحد يعرف ماذا سيحدث بعد ذلك،
Dialogue: 0,0:46:11.88,0:46:14.75,Default,التصويب,0,0,0,,وقد يكون الغد هو الأخير.
Dialogue: 0,0:46:14.95,0:46:18.12,Default,إطلاق النار,0,0,0,,إذا انتهت حياتي غداً،
Dialogue: 0,0:46:19.36,0:46:21.63,Default,تصويب,0,0,0,,ما هو أكثر شيء سأندم عليه؟
Dialogue: 0,0:46:21.89,0:46:25.13,Default,tira,0,0,0,,عن مشاعر لم أتمكن من التعبير عنها،
Dialogue: 0,0:46:25.70,0:46:27.16,Default,إطلاق النار,0,0,0,,لأنني شككت في ذلك.
Dialogue: 0,0:46:27.53,0:46:28.87,Default,tira,0,0,0,,كلمة صادقة واحدة
Dialogue: 0,0:46:29.37,0:46:31.50,Default,إطلاق النار,0,0,0,,أفضل من أي اعتراف معقد.
Dialogue: 0,0:46:33.70,0:46:34.87,Default,شرطة,0,0,0,,لذلك
Dialogue: 0,0:46:37.81,0:46:39.31,Default,إطلاق النار,0,0,0,,أريد أن أخبرك،
Dialogue: 0,0:46:40.61,0:46:41.75,Default,تصويب,0,0,0,,إنني أحبك.
Dialogue: 0,0:46:51.49,0:46:53.06,Default,التصويب,0,0,0,,أنا لا أحبك.
Dialogue: 0,0:46:53.49,0:46:54.53,Default,إطلاق النار,0,0,0,,ماذا؟
Dialogue: 0,0:46:55.59,0:46:56.79,Default,نطاق الرماية,0,0,0,,حول البارود.
Dialogue: 0,0:46:57.39,0:46:59.50,Default,نطاق الرماية,0,0,0,,كمية البارود المنتجة في الجنوب
Dialogue: 0,0:46:59.50,0:47:00.76,Default,معرض الرماية,0,0,0,,مقاطعة جيونج سانج,
Dialogue: 0,0:47:01.10,0:47:03.73,Default,dash,0,0,0,,والكمية التي تصل إلى المستودع مختلفة.
Dialogue: 0,0:47:05.17,0:47:06.47,Default,إطلاق النار,0,0,0,,كنت أعرف ذلك.
Dialogue: 0,0:47:12.11,0:47:13.94,Default,إطلاق النار,0,0,0,,هل لا يزال الملك فاقداً للوعي؟
Dialogue: 0,0:47:14.48,0:47:15.55,Default,التصويب,0,0,0,,نعم.
Dialogue: 0,0:47:16.21,0:47:19.32,Default,إطلاق النار,0,0,0,,سمعت أنه فقد سمعه. وستكون هذه مشكلة في المستقبل.
Dialogue: 0,0:47:22.95,0:47:25.12,Default,إطلاق النار,0,0,0,,حول هذه الحادثة مع الملك.
Dialogue: 0,0:47:25.72,0:47:27.83,Default,نطاق الرماية,0,0,0,,لانفجار بهذا الحجم
Dialogue: 0,0:47:29.16,0:47:30.83,Default,نطاق الرماية,0,0,0,,هل تستخدم البارود؟
Dialogue: 0,0:47:31.76,0:47:32.83,Default,التصويب,0,0,0,,لست متأكداً.
Dialogue: 0,0:47:33.26,0:47:36.93,Default,إطلاق النار,0,0,0,,يمكن أن يكون كبريتًا أو غازًا متفجرًا.
Dialogue: 0,0:47:37.63,0:47:39.57,Default,shooting,0,0,0,,لو كان كبريتاً لكانت هناك رائحة،
Dialogue: 0,0:47:39.57,0:47:41.51,Default,إطلاق النار,0,0,0,,فيلاحظه الملك.
Dialogue: 0,0:47:41.61,0:47:43.61,Default,إطلاق النار,0,0,0,,لو كان غازاً لكان الأمر صعباً
Dialogue: 0,0:47:43.61,0:47:46.18,Default,معرض التصوير,0,0,0,,امنعها من التسرب وفجرها كلها مرة واحدة.
Dialogue: 0,0:47:46.28,0:47:48.95,Default,معرض الرماية,0,0,0,,يتم استجواب الجناة لكنهم لا يعترفون.
Dialogue: 0,0:47:48.95,0:47:50.48,Default,إطلاق النار,0,0,0,,من الصعب معرفة من يقف وراء هذا.
Dialogue: 0,0:48:21.75,0:48:24.72,Default,tyra,0,0,0,,عندما أرى المكونات، أفكر على الفور
Dialogue: 0,0:48:24.72,0:48:26.55,Default,tyra,0,0,0,,كيفية الحفاظ على طعمها الأصلي.
Dialogue: 0,0:48:29.79,0:48:31.22,Default,التصويب,0,0,0,,لا يمكن أن يكون.
Dialogue: 0,0:48:31.72,0:48:33.82,Default,إطلاق النار,0,0,0,,مذنب بالخيانة
Dialogue: 0,0:48:33.82,0:48:35.89,Default,معرض الرماية,0,0,0,,كشف القائد؟
Dialogue: 0,0:48:36.69,0:48:39.96,Default,نطاق الرماية,0,0,0,,يبدو أن الحراس ذوي الرتب المنخفضة\N يعارضون الديوان الملكي،
Dialogue: 0,0:48:39.96,0:48:41.93,Default,معرض الرماية,0,0,0,,اجتمعوا وتسببوا في انفجار.
Dialogue: 0,0:48:41.97,0:48:43.07,Default,إطلاق النار,0,0,0,,حقاً؟
Dialogue: 0,0:48:43.63,0:48:46.97,Default,معرض الرماية,0,0,0,,هل تقول أنه لا يوجد أحد خلفهم؟
Dialogue: 0,0:48:47.70,0:48:50.41,Default,إطلاق النار,0,0,0,,في قضية كبيرة مثل مقتل ملك؟
Dialogue: 0,0:48:50.41,0:48:51.78,Default,التصويب,0,0,0,,هذا مستحيل.
Dialogue: 0,0:48:52.38,0:48:55.48,Default,shooting,0,0,0,,يجب أن نخشى معظم أولئك الذين ليس لديهم ما يخسرونه.
Dialogue: 0,0:48:55.48,0:48:57.71,Default,نطاق الرماية,0,0,0,,ربما كانوا يعتقدون\Nأنهم لا يستطيعون الارتفاع إلى أعلى،
Dialogue: 0,0:48:57.71,0:48:59.98,Default,shooting,0,0,0,,لذلك قررنا تغيير الوضع جذريًا.
Dialogue: 0,0:48:59.98,0:49:01.69,Default,تصويب,0,0,0,,ربما هذا هو السبب.
Dialogue: 0,0:49:02.82,0:49:05.79,Default,إطلاق النار,0,0,0,,هذا منطقي. فعل الخيانة بغرض التتويج
Dialogue: 0,0:49:05.79,0:49:08.89,Default,إطلاق النار,0,0,0,,الأخ غير الشقيق للملك، لي وونغ جيونغ،
Dialogue: 0,0:49:08.89,0:49:11.36,Default,إطلاق النار,0,0,0,,يرتكبه أيضاً حراس ذوو رتب منخفضة.
Dialogue: 0,0:49:12.36,0:49:14.20,Default,إطلاق النار,0,0,0,,بالنظر إلى أن الملك فاقد للوعي،
Dialogue: 0,0:49:14.20,0:49:16.73,Default,shooting,0,0,0,,كلما تأخرنا في هذا الأمر، زاد الارتباك.
Dialogue: 0,0:49:16.83,0:49:17.97,Default,شرطة,0,0,0,,لذلك
Dialogue: 0,0:49:18.34,0:49:21.24,Default,إطلاق النار,0,0,0,,سبعة مذنبين سيتحملون المسؤولية الكاملة
Dialogue: 0,0:49:23.41,0:49:26.11,Default,إطلاق النار,0,0,0,,وسيحكم عليه بالإعدام.
Dialogue: 0,0:49:34.45,0:49:37.72,Default,إطلاق النار,0,0,0,,لمحاولة اغتيال الملك والتخطيط للخيانة
Dialogue: 0,0:49:39.19,0:49:40.96,Default,إطلاق النار,0,0,0,,حُكم عليك بالإعدام.
Dialogue: 0,0:49:42.56,0:49:44.53,Default,إطلاق النار,0,0,0,,هل لديك الكلمة الأخيرة؟
Dialogue: 0,0:49:49.70,0:49:51.97,Default,إطلاق النار,0,0,0,,إذا حكمت عليهم بالإعدام،
Dialogue: 0,0:49:52.34,0:49:55.37,Default,إطلاق النار,0,0,0,,لن تعرف أبدًا من كان وراء كل هذا.
Dialogue: 0,0:49:55.87,0:49:58.08,Default,إطلاق النار,0,0,0,,قالوا لم يكن أحد وراء هذا.
Dialogue: 0,0:49:58.91,0:50:00.24,Default,إطلاق النار,0,0,0,,هذا قرار متهور...
Dialogue: 0,0:50:00.24,0:50:03.65,Default,إطلاق النار,0,0,0,,تم اتخاذ هذا القرار بعد ليلة من التحقيق.
Dialogue: 0,0:50:06.08,0:50:07.25,Default,شرطة,0,0,0,,
Dialogue: 0,0:51:02.84,0:51:03.91,Default,معرض التصوير,0,0,0,,قطع الرأس.
Dialogue: 0,0:51:05.84,0:51:06.84,افتراضي,نطاق الرماية,0,0,0,,توقف.
Dialogue: 0,0:51:14.22,0:51:16.65,Default,إطلاق النار,0,0,0,,تم التحقيق\N بأمر ملكي.
Dialogue: 0,0:51:17.22,0:51:18.92,Default,معرض التصوير,0,0,0,,هل ستقاطعوننا؟
Dialogue: 0,0:51:19.12,0:51:21.39,Default,معرض الرماية,0,0,0,,أطلقوا سراح الأبرياء فوراً.
Dialogue: 0,0:51:23.43,0:51:25.03,Default,إطلاق النار,0,0,0,,هذا أمر حقيقي.
Dialogue: 0,0:51:35.84,0:51:36.97,Default,التصويب,0,0,0,,آسفة لقد تأخرت.
Dialogue: 0,0:51:37.67,0:51:38.71,افتراضي,إطلاق النار,0,0,0,,أنت...
Dialogue: 0,0:51:41.78,0:51:45.98,Default,إطلاق النار,0,0,0,,سمعت أنك فقدت الوعي.
Dialogue: 0,0:51:46.32,0:51:48.99,Default,التصويب,0,0,0,,أنا شاب ومليء بالقوة،
Dialogue: 0,0:51:49.35,0:51:50.99,Default,التصويب,0,0,0,,فسرعان ما تعافى.
Dialogue: 0,0:51:55.23,0:51:57.49,Default,إطلاق النار,0,0,0,,لم أرغب في الاستلقاء هناك عبثاً
Dialogue: 0,0:51:57.49,0:51:59.53,Default,التصويب,0,0,0,,والاستشفاء في السرير.
Dialogue: 0,0:51:59.76,0:52:01.13,Default,تصويب,0,0,0,,لذلك كنت أبحث عن هؤلاء
Dialogue: 0,0:52:01.13,0:52:03.83,Default,إطلاق النار,0,0,0,,الذي تآمر لقتلي.
Dialogue: 0,0:52:04.30,0:52:08.07,Default,إطلاق النار,0,0,0,,أولاً اكتشفت أمرك.
Dialogue: 0,0:52:08.64,0:52:12.64,Default,نطاق الرماية,0,0,0,,هل تريد أن تقول أنك قمت بفحصنا؟
Dialogue: 0,0:52:13.21,0:52:15.28,Default,إطلاق النار,0,0,0,,هناك من يخطط للخيانة.
Dialogue: 0,0:52:16.25,0:52:18.32,Default,تصويب,0,0,0,,قل أن حياتك الشخصية هي الأهم،
Dialogue: 0,0:52:19.38,0:52:23.45,Default,إطلاق النار,0,0,0,,ما هي حياة الملك؟
Dialogue: 0,0:52:24.39,0:52:26.49,Default,إطلاق النار,0,0,0,,لا، هذا ليس صحيحاً.
Dialogue: 0,0:52:28.33,0:52:31.16,Default,shooting,0,0,0,,إذا لم يكن لديك ما تخفيه، فليس هناك ما تخاف منه.
Dialogue: 0,0:52:35.00,0:52:36.33,Default,نطاق الرماية,0,0,0,,لا تقلق.
Dialogue: 0,0:52:37.50,0:52:39.70,Default,معرض الرماية,0,0,0,,لقد وجدت القائد.
Dialogue: 0,0:52:40.94,0:52:42.57,Default,إطلاق النار,0,0,0,,-ما الذي يتحدث عنه؟\N-ما الذي يحدث؟
Dialogue: 0,0:52:48.01,0:52:50.51,Default,tyra,0,0,0,,في الباخورنيتسا المستخدم في الحفل،
Dialogue: 0,0:52:51.11,0:52:53.55,Default,نطاق الرماية,0,0,0,,تم العثور على البارود بكميات كبيرة.
Dialogue: 0,0:52:53.82,0:52:56.39,Default,نطاق الرماية,0,0,0,,-البارود؟\N-البارود؟
Dialogue: 0,0:52:59.26,0:53:00.32,Default,نطاق الرماية,0,0,0,,كمية كبيرة؟
Dialogue: 0,0:53:06.16,0:53:08.63,Default,معرض الرماية,0,0,0,,سوف يصبح يانع قنبلة ضخمة.
Dialogue: 0,0:53:09.03,0:53:11.67,Default,معرض الرماية,0,0,0,,-هذا خطير جداً.\N-كل شيء قد تقرر بالفعل.
Dialogue: 0,0:53:12.10,0:53:14.04,Default,إطلاق النار,0,0,0,,تتبع أصول البارود،
Dialogue: 0,0:53:14.67,0:53:16.31,Default,إطلاق النار,0,0,0,,لقد تلقيت معلومات،
Dialogue: 0,0:53:16.31,0:53:19.88,Default,shooting,0,0,0,,أن هذا البارود\N يتم تداوله بشكل غير رسمي في ميناء تون.
Dialogue: 0,0:53:26.05,0:53:29.25,Default,نطاق الرماية,0,0,0,,بالمناسبة، لماذا تحتاج إلى الكثير من البارود؟
Dialogue: 0,0:53:29.45,0:53:33.22,Default,تصويب,0,0,0,,لمهاجمة جوسون مرة أخرى بعد قليل.
Dialogue: 0,0:53:36.86,0:53:38.13,Default,التصويب,0,0,0,,شكرًا لك.
Dialogue: 0,0:53:38.93,0:53:40.73,Default,إطلاق النار,0,0,0,,-شكرًا لك؟\N-شكرًا لك.
Dialogue: 0,0:53:42.53,0:53:44.73,Default,إطلاق النار,0,0,0,,-شكرًا لك.\N-شكرًا لك.
Dialogue: 0,0:53:45.57,0:53:47.87,Default,التصويب,0,0,0,,شكرًا لك.
Dialogue: 0,0:53:48.54,0:53:51.21,Default,نطاق الرماية,0,0,0,,من أين جاء هذا البارود؟
Dialogue: 0,0:53:51.54,0:53:53.41,Default,إطلاق النار,0,0,0,,يتم إنتاجه للأغراض العسكرية فقط.
Dialogue: 0,0:53:53.41,0:53:56.18,Default,shooting,0,0,0,,لا يمكن بأي حال من الأحوال إنتاجها للاستخدام الشخصي،
Dialogue: 0,0:53:56.55,0:53:58.68,Default,shooting,0,0,0,,بعد كل شيء، هذا منتج خطير وقيم.
Dialogue: 0,0:54:00.22,0:54:04.29,Default,نطاق الرماية,0,0,0,,لذا، نظرت إلى جميع الأماكن التي يُصنع فيها البارود في جوسون.
Dialogue: 0,0:54:04.96,0:54:06.72,Default,shooting,0,0,0,,واكتشفت شيئاً غريباً.
Dialogue: 0,0:54:08.33,0:54:10.86,Default,إطلاق النار,0,0,0,,في مناطق معينة في مناطق الإنتاج
Dialogue: 0,0:54:10.86,0:54:15.23,Default,معرض الرماية,0,0,0,,كانوا يضعون في جيوبهم باستمرار كمية من البارود.
Dialogue: 0,0:54:17.57,0:54:19.64,Default,نطاق الرماية,0,0,0,,كمية البارود المخبأة
Dialogue: 0,0:54:19.64,0:54:23.41,Default,dash,0,0,0,,كان صغيراً في البداية، لكنه نما مع مرور الوقت.
Dialogue: 0,0:54:23.77,0:54:24.84,افتراضي,شرطة,0,0,0,,مباشر
Dialogue: 0,0:54:26.08,0:54:28.04,Default,إطلاق النار,0,0,0,,كيف ينمو الجشع.
Dialogue: 0,0:54:29.35,0:54:31.28,Default,إطلاق النار,0,0,0,,-ماذا؟\N-هل هذا صحيح؟
Dialogue: 0,0:54:31.58,0:54:35.25,Default,نطاق الرماية,0,0,0,,عندما بدأت سرقة البارود،
Dialogue: 0,0:54:36.02,0:54:37.55,Default,نطاق الرماية,0,0,0,,قائد القوات كيم جواجيون؟
Dialogue: 0,0:54:42.56,0:54:46.23,Default,dash,0,0,0,,نفس العام الذي اعتليت فيه العرش.
Dialogue: 0,0:54:47.93,0:54:52.10,Default,shooting,0,0,0,,وفي نفس العام، أصبح السيد كيم جواجيون قائداً للقوات.
Dialogue: 0,0:54:53.70,0:54:56.04,Default,shooting,0,0,0,,يا صاحب الجلالة، هذا اتهام كاذب.
Dialogue: 0,0:54:56.04,0:54:57.44,Default,معرض التصوير,0,0,0,,الصمت!
Dialogue: 0,0:54:58.24,0:55:01.01,Default,نطاق الرماية,0,0,0,,وزير الحرب المسؤول عن إنتاج البارود،
Dialogue: 0,0:55:01.01,0:55:04.45,Default,إطلاق النار,0,0,0,,وهو أيضًا خائن يخطط للخيانة مع كيم جواجيون!
Dialogue: 0,0:55:05.58,0:55:08.05,Default,shooting,0,0,0,,أنا أستخدم هويات الحرس الملكي المزيفة كطعم.
Dialogue: 0,0:55:08.32,0:55:12.09,Default,shooting,0,0,0,,كان من المفترض أن يكون "كيم جواجيون" قد اكتشف هذا الأمر بالفعل.
Dialogue: 0,0:55:17.56,0:55:19.93,Default,إطلاق النار,0,0,0,,سوف تتعرض لتعذيب لا يطاق،
Dialogue: 0,0:55:20.33,0:55:21.63,Default,إطلاق النار,0,0,0,,لكن تحملهم.
Dialogue: 0,0:55:23.67,0:55:25.14,Default,أطلاق النار,0,0,0,,سأنقذك بالتأكيد.
Dialogue: 0,0:55:30.64,0:55:35.25,Default,shooting,0,0,0,,هذه تهمة باطلة،\Nفهم هذا يا صاحب الجلالة!
Dialogue: 0,0:55:38.95,0:55:41.58,Default,dash,0,0,0,,إذا قلت مرة أخرى أنك متهم زوراً،
Dialogue: 0,0:55:43.02,0:55:45.42,Default,إطلاق النار,0,0,0,,سأعطيك السم لتشربه على الفور.
Dialogue: 0,0:55:49.96,0:55:51.96,Default,نطاق الرماية,0,0,0,,باعه تجار البارود
Dialogue: 0,0:55:51.96,0:55:54.03,Default,dash,0,0,0,,أي شخص دفع.
Dialogue: 0,0:55:54.23,0:55:56.97,Default,معرض الرماية,0,0,0,,قطاع الطرق، حتى اليابانيين!
Dialogue: 0,0:55:57.17,0:56:00.24,Default,shooting,0,0,0,,إذا لم يكن هذا من أجل تدمير جوسون، فلماذا؟
Dialogue: 0,0:56:01.20,0:56:04.11,Default,معرض الرماية,0,0,0,,من كان هنا معهم أيضاً؟
Dialogue: 0,0:56:15.39,0:56:17.25,Default,إطلاق النار,0,0,0,,قائد القوات كيم جواجيون.
Dialogue: 0,0:56:17.79,0:56:20.09,Default,إطلاق النار,0,0,0,,وزير الحرب كيم تشانغ هيوك.
Dialogue: 0,0:56:21.42,0:56:22.69,Default,إطلاق النار,0,0,0,,هذان الاثنان
Dialogue: 0,0:56:23.99,0:56:27.06,Default,إطلاق نار,0,0,0,,سرقة الأسلحة الوطنية لإضعاف الجيش،
Dialogue: 0,0:56:27.63,0:56:31.77,Default,إطلاق النار,0,0,0,,وخططوا لمحاولة اغتيالي أنا الملك،
Dialogue: 0,0:56:34.50,0:56:35.91,Default,tyra,0,0,0,,مما يعني أنهم مذنبون بالخيانة.
Dialogue: 0,0:56:36.67,0:56:39.88,Default,dash,0,0,0,,ماذا يجب أن نسمي هذه العملية؟
Dialogue: 0,0:56:41.98,0:56:42.98,Default,التصويب,0,0,0,,فينيكس.
Dialogue: 0,0:56:45.72,0:56:47.28,Default,التصويب,0,0,0,,اسم العملية -
Dialogue: 0,0:56:48.42,0:56:50.42,Default,معرض الرماية,0,0,0,,فينيكس المحترق.
Dialogue: 0,0:56:55.43,0:56:57.33,Default,إطلاق النار,0,0,0,,لجميع الجرائم
Dialogue: 0,0:56:58.93,0:57:01.00,Default,إطلاق النار,0,0,0,,سيتم طرد الجناة من مناصبهم
Dialogue: 0,0:57:02.53,0:57:04.00,افتراضي,إطلاق النار,0,0,0,,والمنفى.
Dialogue: 0,0:57:05.97,0:57:07.04,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:57:11.27,0:57:14.11,Default,tyra,0,0,0,,-الملكة الأرملة.\N-الملكة الأرملة.
Dialogue: 0,0:57:14.54,0:57:16.51,Default,إطلاق النار,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:57:16.98,0:57:18.72,Default,تصويب,0,0,0,,لماذا تحكمون بلا سبب؟
Dialogue: 0,0:57:19.15,0:57:21.82,Default,معرض الرماية,0,0,0,,لا بد أنك فقدت عقلك بعد الانفجار.
Dialogue: 0,0:57:22.42,0:57:25.05,Default,نطاق الرماية,0,0,0,,تذكر حدود المسموح!
Dialogue: 0,0:57:25.72,0:57:26.92,Default,إطلاق النار,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:57:28.63,0:57:30.36,Default,شرطة,0,0,0,,إذا كنت تقول ذلك،
Dialogue: 0,0:57:37.60,0:57:42.31,Default,dash,0,0,0,,لا بد أنك فقدت عقلك بسبب كبر السن.
Dialogue: 0,0:57:43.67,0:57:48.55,Default,dash,0,0,0,,لا أستطيع مواصلة مناقشة القضايا السياسية أثناء وجودك في هذه الحالة.
Dialogue: 0,0:57:49.61,0:57:52.92,Default,tyra,0,0,0,,من فضلك اترك وصيتك.
Dialogue: 0,0:57:55.05,0:57:56.39,Default,إطلاق النار,0,0,0,,-ما الذي يتحدث عنه؟\N-ما الذي يتحدث عنه؟
Dialogue: 0,0:57:58.86,0:58:02.86,Default,معرض التصوير,0,0,0,,حان الوقت بالنسبة لي لاتخاذ قراراتي بنفسي.
Dialogue: 0,0:58:03.43,0:58:04.59,Default,معرض الرماية,0,0,0,,جلالتك!
Dialogue: 0,0:58:04.59,0:58:07.70,Default,shooting,0,0,0,,كان يجب أن أعطي كيم جواجيون السم ليشربه على الفور
Dialogue: 0,0:58:07.70,0:58:09.50,Default,إطلاق النار,0,0,0,,وإعدام عائلته بأكملها.
Dialogue: 0,0:58:09.73,0:58:12.27,Default,إطلاق النار,0,0,0,,ولكن بسببك أنت والملكة
Dialogue: 0,0:58:13.04,0:58:15.31,Default,shooting,0,0,0,,قررت حرمانه من اللقب فحسب.
Dialogue: 0,0:58:16.67,0:58:17.84,Default,تصويب,0,0,0,,ألا يعجبك ذلك؟
Dialogue: 0,0:58:18.31,0:58:22.75,Default,shooting,0,0,0,,هل تحاول عقد صفقة معي مقابل حياة أخي؟
Dialogue: 0,0:58:23.25,0:58:26.62,Default,dash,0,0,0,,لا يمكنك تسميتها صفقة إلا إذا كان لديك خيار.
Dialogue: 0,0:58:30.32,0:58:31.39,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,0:58:33.96,0:58:37.09,Default,shooting,0,0,0,,أنا، كيم جواجيون، تم اتهامي زوراً،
Dialogue: 0,0:58:37.33,0:58:38.73,Default,إطلاق النار,0,0,0,,لكنني سأثبت ولائي،
Dialogue: 0,0:58:38.73,0:58:41.13,Default,tyra,0,0,0,,طاعة الأمر الملكي.
Dialogue: 0,0:58:41.60,0:58:42.93,Default,التصويب,0,0,0,,يا لها من راحة.
Dialogue: 0,0:58:43.57,0:58:46.77,Default,dash,0,0,0,,كنت أخشى أنه بسبب كبر سنك، قد يلتهمك الجشع.
Dialogue: 0,0:58:46.97,0:58:48.84,Default,shooting,0,0,0,,لست ضد العزل من المنصب.
Dialogue: 0,0:58:49.07,0:58:51.34,Default,إطلاق النار,0,0,0,,لكنني أطلب منك أن تمنحني الفرصة
Dialogue: 0,0:58:51.34,0:58:53.81,Default,شرطة,0,0,0,,امسح اسمك.
Dialogue: 0,0:58:54.11,0:58:56.61,Default,shooting,0,0,0,,أطلب عزل ساخونبو من منصبه.
Dialogue: 0,0:58:58.01,0:58:59.08,Default,dash,0,0,0,,أقبل طلبك.
Dialogue: 0,0:58:59.38,0:59:04.02,Default,shooting,0,0,0,,ولكن إذا لم يقيله ساخونبو من منصبه بحلول الغد،
Dialogue: 0,0:59:04.35,0:59:07.99,Default,shooting,0,0,0,,سأقوم على الفور بإقالة قائد القوات كيم جواجيون من منصبه
Dialogue: 0,0:59:08.56,0:59:11.33,Default,shooting,0,0,0,,وسأحل ليس فقط ساخونبو نفسه،
Dialogue: 0,0:59:11.33,0:59:14.73,Default,إطلاق النار,0,0,0,,ولكن أيضاً جميع المسؤولين الحاضرين!
Dialogue: 0,0:59:15.40,0:59:19.90,Default,shooting,0,0,0,,-نطلب رحمتك!\N-نطلب رحمتك!
Dialogue: 0,0:59:36.72,0:59:38.32,Default,نطاق الرماية,0,0,0,,لقد خسرت.
Dialogue: 0,0:59:38.72,0:59:41.69,Default,shooting,0,0,0,,لقد طردك الملك الذي أعطيته العرش بنفسك!
Dialogue: 0,0:59:42.09,0:59:45.19,Default,shooting,0,0,0,,لم أكن أعلم أن الملك سيخطط لمحاولة اغتياله.
Dialogue: 0,0:59:45.80,0:59:48.73,Default,معرض الرماية,0,0,0,,من برأيك نصب الفخ؟
Dialogue: 0,0:59:50.27,0:59:52.74,Default,معرض الرماية,0,0,0,,لقد عهدت إليك باختيار النبلاء.
Dialogue: 0,0:59:53.10,0:59:55.57,Default,تصويب,0,0,0,,لكنك لا تفهم الناس جيداً.
Dialogue: 0,0:59:57.87,1:00:01.71,Default,tyra,0,0,0,,قال كونفوشيوس أن القلب أكثر تعقيداً من الطبيعة،
Dialogue: 0,1:00:01.81,1:00:04.65,Default,dash,0,0,0,,ورؤية قلب شخص آخر أصعب من رؤية ما وراء السحاب.
Dialogue: 0,1:00:05.21,1:00:06.58,Default,معرض الرماية,0,0,0,,لقد أخطأت في اختيار النبلاء
Dialogue: 0,1:00:06.58,1:00:08.72,Default,معرض الرماية,0,0,0,,سواء في القصر أو خارجه.
Dialogue: 0,1:00:09.89,1:00:12.76,Default,tyra,0,0,0,,لقد وثقت بالملكة أيضًا
Dialogue: 0,1:00:12.76,1:00:15.16,Default,tyra,0,0,0,,اهتم باختيار المحظيات الملكية.
Dialogue: 0,1:00:15.76,1:00:18.43,Default,تصويب,0,0,0,,لكنها اختارت لصالح الملك.
Dialogue: 0,1:00:18.66,1:00:20.93,Default,إطلاق النار,0,0,0,,وكانت الملكة هي التي أنقذت الوليمة،
Dialogue: 0,1:00:20.93,1:00:22.40,Default,إطلاق النار,0,0,0,,الذي أفسدته.
Dialogue: 0,1:00:23.93,1:00:27.34,Default,نطاق الرماية,0,0,0,,العدو فظيع عندما يكون بين جنوده.
Dialogue: 0,1:00:40.05,1:00:41.12,افتراضي,إطلاق النار,0,0,0,,صاحب السمو.
Dialogue: 0,1:00:48.36,1:00:51.09,Default,إطلاق النار,0,0,0,,لا بد أن جلالته قد استعاد وعيه.
Dialogue: 0,1:00:53.46,1:00:57.10,Default,إطلاق النار,0,0,0,,يمكنني مراقبة زوجي\N عندما يستعيد وعيه.
Dialogue: 0,1:00:57.77,1:01:00.94,Default,shooting,0,0,0,,إذا لم يستيقظ، سأصبح عديم الفائدة.
Dialogue: 0,1:01:01.50,1:01:04.27,Default,shooting,0,0,0,,إذا أصبحت عديم الفائدة، سيتم الإطاحة بي.
Dialogue: 0,1:01:04.27,1:01:06.78,Default,shooting,0,0,0,,إذا تمت الإطاحة بي فسوف أتخلى عن أفكار الانتقام
Dialogue: 0,1:01:06.78,1:01:09.25,Default,إطلاق النار,0,0,0,,وسأفتح مطعماً لكسب لقمة العيش.
Dialogue: 0,1:01:10.78,1:01:12.58,Default,التصويب,0,0,0,,ليس سيئاً للغاية.
Dialogue: 0,1:01:13.02,1:01:14.05,Default,معرض التصوير,0,0,0,,الملكة!
Dialogue: 0,1:01:15.25,1:01:18.32,Default,إطلاق النار,0,0,0,,جلالة الملك...
Dialogue: 0,1:01:21.52,1:01:23.26,Default,إطلاق النار,0,0,0,,استعاد وعيه.
Dialogue: 0,1:01:23.86,1:01:25.03,Default,إطلاق النار,0,0,0,,حقاً؟
Dialogue: 0,1:01:25.03,1:01:27.33,Default,شرطة,0,0,0,,نعم. وقد عاد سمعه
Dialogue: 0,1:01:27.33,1:01:29.47,Default,إطلاق النار,0,0,0,,وذهب إلى المجلس الملكي.
Dialogue: 0,1:01:29.47,1:01:31.67,Default,نطاق الرماية,0,0,0,,لقد كنت خائفًا حقًا.
Dialogue: 0,1:01:32.37,1:01:33.60,Default,إطلاق النار,0,0,0,,يجب أن أذهب.
Dialogue: 0,1:01:35.54,1:01:36.84,Default,إطلاق النار,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,1:01:38.94,1:01:40.21,Default,إطلاق النار,0,0,0,,ليس لدي وقت.
Dialogue: 0,1:01:45.21,1:01:46.78,Default,معرض الرماية,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,1:01:48.25,1:01:49.65,Default,التصويب,0,0,0,,أنا سعيد للغاية.
Dialogue: 0,1:01:51.69,1:01:53.46,Default,التصويب,0,0,0,,حقاً، أنا سعيد للغاية.
Dialogue: 0,1:01:59.36,1:02:01.80,Default,إطلاق النار,0,0,0,,لا تبكي. لماذا تبكي؟
Dialogue: 0,1:02:02.27,1:02:03.80,Default,تصويب,0,0,0,,هذا يبعث على الارتياح.
Dialogue: 0,1:02:03.80,1:02:05.60,Default,إطلاق النار,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,1:02:09.17,1:02:11.94,Default,shooting,0,0,0,,-سأفعل ذلك.\N-نعم يا صاحب الجلالة.
Dialogue: 0,1:02:17.98,1:02:19.15,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,1:02:24.35,1:02:25.82,Default,إطلاق النار,0,0,0,,كل شيء على ما يرام الآن.
Dialogue: 0,1:02:26.76,1:02:29.79,Default,dash,0,0,0,,كل شيء على ما يرام، لأنك مستيقظ وبصحة جيدة.
Dialogue: 0,1:02:31.49,1:02:35.57,Default,إطلاق النار,0,0,0,,لن أخسرك مرة أخرى.
Dialogue: 0,1:02:37.53,1:02:38.57,Default,إطلاق النار,0,0,0,,هواجين.
Dialogue: 0,1:02:41.47,1:02:43.01,Default,إطلاق النار,0,0,0,,قاموس الملكة
Dialogue: 0,1:02:50.25,1:02:51.35,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,1:02:51.35,1:02:54.42,Default,إطلاق النار,0,0,0,,قالوا إنك ستزور الملك. لماذا تجلس هنا؟
Dialogue: 0,1:02:54.98,1:02:56.22,Default,معرض الرماية,0,0,0,,زجاجة أخرى.
Dialogue: 0,1:02:56.69,1:02:59.92,Default,إطلاق النار,0,0,0,,من المحرج إلى حد ما رؤيته رصيناً.
Dialogue: 0,1:03:01.02,1:03:05.03,Default,شرطة,0,0,0,,توقف عن الشرب. ليس عليك أن تفعل هذا يا صاحب الجلالة.
Dialogue: 0,1:03:05.03,1:03:07.66,Default,إطلاق النار,0,0,0,,يكفي لك العمل. العودة إلى المنزل!
Dialogue: 0,1:03:11.07,1:03:13.37,Default,إطلاق النار,0,0,0,,سأشرب هذا لك.
Dialogue: 0,1:03:15.44,1:03:16.94,Default,إطلاق النار,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,1:03:17.84,1:03:19.28,Default,إطلاق النار,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,1:03:23.65,1:03:26.15,Default,نطاق الرماية,0,0,0,,في المطبخ الملكي، كمية الكحول غير محدودة.
Dialogue: 0,1:03:29.12,1:03:31.15,Default,إطلاق النار,0,0,0,,لماذا أنت محرج؟
Dialogue: 0,1:03:33.46,1:03:35.59,Default,تصويب,0,0,0,,محرج لأن...
Dialogue: 0,1:03:38.29,1:03:40.93,Default,إطلاق النار,0,0,0,,أنت على حق. لماذا هذا محرج؟
Dialogue: 0,1:03:42.13,1:03:44.40,Default,التصويب,0,0,0,,أنا واثق! دعنا نذهب إلى الملك.
Dialogue: 0,1:03:44.67,1:03:46.84,Default,معرض التصوير,0,0,0,,لا يمكنك الذهاب الآن،
Dialogue: 0,1:03:46.84,1:03:48.50,Default,إطلاق النار,0,0,0,,اذهب عندما تستيقظ.
Dialogue: 0,1:03:49.57,1:03:50.87,Default,التصويب,0,0,0,,حسنًا. دعونا نذهب غدا.
Dialogue: 0,1:03:51.21,1:03:52.44,Default,إطلاق النار,0,0,0,,دعونا نؤجل هذا إلى الغد.
Dialogue: 0,1:03:52.44,1:03:53.64,Default,dash,0,0,0,,تمامًا مثل اتباع نظام غذائي.
Dialogue: 0,1:03:53.88,1:03:55.81,Default,إطلاق النار,0,0,0,,لدينا غدًا!
Dialogue: 0,1:03:56.35,1:03:58.65,Default,معرض الرماية,0,0,0,,الشيف الملكي. زجاجة أخرى.
Dialogue: 0,1:03:59.55,1:04:01.92,Default,إطلاق النار,0,0,0,,هل تعتقد أنها جاءت إلى الحانة أم ماذا؟
Dialogue: 0,1:04:03.75,1:04:04.79,افتراضي,التصويب,0,0,0,,أسرع.
Dialogue: 0,1:04:41.96,1:04:43.09,Default,إطلاق النار,0,0,0,,سيدة المحكمة كان.
Dialogue: 0,1:04:46.73,1:04:48.90,افتراضي,نطاق الرماية,0,0,0,,سري
Dialogue: 0,1:04:48.90,1:04:50.00,Default,معرض التصوير,0,0,0,,جلالتك!
Dialogue: 0,1:04:54.50,1:04:55.54,Default,إطلاق النار,0,0,0,,جلالتك.
Dialogue: 0,1:05:15.76,1:05:18.23,Default,معرض الرماية,0,0,0,,تم العثور على هذا في قاعة دايجوجون.
Dialogue: 0,1:05:18.23,1:05:21.36,Default,shooting,0,0,0,,كما هو متوقع، يعمل الملك والملكة معًا.
Dialogue: 0,1:05:21.36,1:05:24.37,Default,إطلاق النار,0,0,0,,الملكة مكسورة تماماً.
Dialogue: 0,1:05:25.33,1:05:28.87,Default,نطاق الرماية,0,0,0,,يجب استبدال الأشياء المكسورة بأخرى جديدة.
Dialogue: 0,1:05:29.81,1:05:34.21,Default,تصويب,0,0,0,,ولكن يمكنك جعل الشيء المكسور يدوم حتى النهاية
Dialogue: 0,1:05:35.78,1:05:37.91,Default,معرض التصوير,0,0,0,,وأرسله إلى النار.
Dialogue: 0,1:05:39.58,1:05:42.35,Default,dash,0,0,0,,ربما نستخدم الزرنيخ الحقيقي؟
Dialogue: 0,1:05:49.76,1:05:52.36,Default,إطلاق النار,0,0,0,,الملكة تحب الأكل كثيراً.
Dialogue: 0,1:05:52.96,1:05:55.46,Default,تصويب,0,0,0,,لذلك دعونا نجهز لها الطاولة.
Dialogue: 0,1:05:56.73,1:05:59.34,Default,معرض الرماية,0,0,0,,هل ستترك الملك؟
Dialogue: 0,1:05:59.70,1:06:03.51,Default,shooting,0,0,0,,علينا أن نكسره\N لكي نستمر في استخدامه.
Dialogue: 0,1:06:03.97,1:06:08.54,Default,dash,0,0,0,,إذا حدث هذا، فبمجرد أن يعطي\N قلبه للملكة، فسوف يفهم،
Dialogue: 0,1:06:09.11,1:06:11.68,Default,shooting,0,0,0,,أن كل من إلى جانبه سيصبح غير سعيد.
Dialogue: 0,1:06:58.06,1:07:00.56,Default,إطلاق النار,0,0,0,,أليست هذه معجزة،
Dialogue: 0,1:07:02.23,1:07:04.50,Default,إطلاق النار,0,0,0,,ما الغد الذي يأتي كل يوم؟
Dialogue: 0,1:07:11.91,1:07:14.14,Default,معرض الرماية,0,0,0,,دعونا نذهب إلى الجولة الثانية في قاعة سونغجونغ.
Dialogue: 0,1:07:14.51,1:07:17.98,Default,إطلاق النار,0,0,0,,نحن بحاجة للاحتفال بتعافي الملك.
Dialogue: 0,1:07:17.98,1:07:20.78,Default,معرض التصوير,0,0,0,,من فضلك لا تصرخ يا صاحب الجلالة.
Dialogue: 0,1:07:20.78,1:07:22.42,Default,معرض الرماية,0,0,0,,جلالتك!
Dialogue: 0,1:07:22.92,1:07:24.65,Default,إطلاق النار,0,0,0,,جلالتك!
Dialogue: 0,1:07:24.65,1:07:27.72,Default,إطلاق النار,0,0,0,,لا يمكنك تسميته بهذا الاسم.
Dialogue: 0,1:07:29.46,1:07:30.66,افتراضي,إطلاق النار,0,0,0,,فتح.
Dialogue: 0,1:07:34.36,1:07:35.56,افتراضي,إطلاق النار,0,0,0,,فتح.
Dialogue: 0,1:07:42.34,1:07:45.27,Default,التصويب,0,0,0,,البطاطا الحلزونية
Dialogue: 0,1:07:49.48,1:07:53.28,Default,إطلاق النار,0,0,0,,هل أنت نائم؟
Dialogue: 0,1:08:13.84,1:08:15.81,Default,إطلاق النار,0,0,0,,أعتقد أنني سقطت في النوم.
Dialogue: 0,1:08:22.04,1:08:24.45,Default,إطلاق النار,0,0,0,,هل كنت تعتني بي؟
Dialogue: 0,1:08:26.52,1:08:28.92,Default,إطلاق النار,0,0,0,,لماذا تستمر في فعل هذا؟
Dialogue: 0,1:08:30.12,1:08:34.12,Default,تصويب,0,0,0,,تقلق عليّ، وتحاول أن تفهمني.
Dialogue: 0,1:08:36.03,1:08:39.86,Default,dash,0,0,0,,بالتفكير في الأمر، أنت أول شخص رأيته عندما أتيت إلى هنا.
Dialogue: 0,1:08:44.13,1:08:46.77,Default,إطلاق النار,0,0,0,,أنا مدين لك بالكثير.
Dialogue: 0,1:08:48.20,1:08:50.94,Default,إطلاق النار,0,0,0,,فكرت فيك عندما حاولت مغادرة القصر.
Dialogue: 0,1:08:52.54,1:08:54.68,Default,إطلاق النار,0,0,0,,ظننت أنني لن أراك مرة أخرى أبداً.
Dialogue: 0,1:09:34.35,1:09:36.22,Default,tyra,0,0,0,,حضرة يونغ.
Dialogue: 0,1:09:58.21,1:09:59.64,Default,إطلاق النار,0,0,0,,هل أنت مستيقظ؟
Dialogue: 0,1:10:08.82,1:10:13.66,Default,شرطة,0,0,0,,
Dialogue: 0,1:10:28.97,1:10:31.14,Default,tyra,0,0,0,,أنا متأكد من أن روح هذه المرأة قد استحوذت على جسدي.
Dialogue: 0,1:10:31.14,1:10:33.14,Default,تصويب,0,0,0,,لماذا تتجنبني باستمرار؟
Dialogue: 0,1:10:33.14,1:10:35.21,Default,shooting,0,0,0,,-انتظر.\N-ماذا يريد أن يسألني؟
Dialogue: 0,1:10:35.21,1:10:36.25,Default,إطلاق النار,0,0,0,,هل أعجبك ذلك؟
Dialogue: 0,1:10:36.25,1:10:38.15,Default,نطاق الرماية,0,0,0,,ألم تقل أن هذا حرام؟
Dialogue: 0,1:10:38.15,1:10:40.22,Default,tyra,0,0,0,,قالت إنك تعانق وتبتسم وتستلقي بجوارك -
Dialogue: 0,1:10:40.22,1:10:41.88,Default,نطاق الرماية,0,0,0,,كل هذا ممنوع.
Dialogue: 0,1:10:42.25,1:10:44.02,Default,shooting,0,0,0,,أمنعك أن تقول إن هذا حرام.
Dialogue: 0,1:10:44.39,1:10:45.75,Default,نطاق الرماية,0,0,0,,لقد أعددت كل شيء.
Dialogue: 0,1:10:45.75,1:10:46.86,Default,إطلاق النار,0,0,0,,ماذا ترى؟
Dialogue: 0,1:10:46.86,1:10:49.26,Default,معرض الرماية,0,0,0,,سيموت شخص ما في القصر اليوم.
Dialogue: 0,1:10:49.26,1:10:50.73,Default,إطلاق النار,0,0,0,,لا أستطيع أن أصدق أنهم حاولوا التخلص من الملكة.
Dialogue: 0,1:10:50.73,1:10:55.26,Default,dash,0,0,0,,لقد أعددت ثلجاً خصيصاً، وهو أغلى من الذهب اليوم.
Dialogue: 0,1:10:55.26,1:10:56.87,Default,تصويب,0,0,0,,-جلالتك.\N-ملكتي.
Dialogue: 0,0:15:53.44,0:15:55.44,Default,,0,0,0,,

التعليق: 0,0:12:33.43,0:12:34.53,Default,ليلي,0,0,0,,يا رب.
