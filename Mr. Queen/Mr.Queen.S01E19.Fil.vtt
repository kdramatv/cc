Dialogue: 0,0:00:58.00,0:01:03.98,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Бирамису, Биря Бирю Зингер, Фундук
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.05,0:01:06.69,Default,Lily,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.69,0:01:08.83,Default,Lily,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip.
Dialogue: 0,0:01:09.86,0:01:12.73,Default,Lily,0,0,0,,19 episode
Dialogue: 0,0:01:57.70,0:01:58.91,Default,Lily,0,0,0,,Sino ka?
Dialogue: 0,0:02:00.91,0:02:03.71,Default,Lily,0,0,0,,Ano ang ginawa mo kay Soyeon?
Dialogue: 0,0:02:14.12,0:02:15.39,Default,Lily,0,0,0,,Hayaan mo!
Dialogue: 0,0:02:17.36,0:02:19.86,Default,Lily,0,0,0,,Sagutin kung gusto mong mabuhay.
Dialogue: 0,0:02:19.86,0:02:21.36,Default,Lily,0,0,0,,Wala akong ginawa.
Dialogue: 0,0:02:21.36,0:02:23.93,Default,Lily,0,0,0,,Iminulat ko lang ang mga mata ko at nakita ko ang sarili ko sa katawan ng babaeng ito.
Dialogue: 0,0:02:27.73,0:02:29.60,Default,Lily,0,0,0,,Nasaan ang totoong Soyeon?
Dialogue: 0,0:02:29.60,0:02:30.84,Default,Lily,0,0,0,,Hindi ko alam.
Dialogue: 0,0:02:30.84,0:02:33.61,Default,Lily,0,0,0,,Hindi ko alam kung buhay siya o patay na.
Dialogue: 0,0:02:39.05,0:02:40.65,Default,Lily,0,0,0,,Papatayin kita.
Dialogue: 0,0:02:52.26,0:02:53.33,Default,Lily,0,0,0,,Benin.
Dialogue: 0,0:03:27.49,0:03:29.33,Default,Lily,0,0,0,,Gaano ka na katagal sa katawan ni Soyeon?
Dialogue: 0,0:03:30.86,0:03:33.93,Default,Lily,0,0,0,,Mula noong araw na nagising ako pagkatapos mahulog sa lawa.
Dialogue: 0,0:03:36.44,0:03:38.81,Default,Lily,0,0,0,,Sabi mo alam mo ang lahat tungkol sa akin at kay Soyeon.
Dialogue: 0,0:03:39.61,0:03:42.74,Default,Lily,0,0,0,,Biglang bumalik sa akin ang lahat ng alaala niya.
Dialogue: 0,0:03:49.92,0:03:51.08,Default,Lily,0,0,0,,Ayan ka na.
Dialogue: 0,0:04:09.44,0:04:10.57,Default,Lily,0,0,0,,Bumangon ka,
Dialogue: 0,0:04:12.34,0:04:14.04,Default,Lily,0,0,0,,maliban kung gusto mong mamatay dito.
Dialogue: 0,0:04:20.05,0:04:22.62,Default,Lily,0,0,0,,Hawakan mo ang kamay ko hanggang makaalis tayo dito.
Dialogue: 0,0:04:23.38,0:04:25.59,Default,Lily,0,0,0,,-Anong balak mo?\N-Kung may mga alaala niya,
Dialogue: 0,0:04:28.12,0:04:30.09,Default,Lily,0,0,0,,kaya nasa loob mo pa rin si Soyeon.
Dialogue: 0,0:04:33.49,0:04:34.76,Default,Lily,0,0,0,,Subukang mabuhay.
Dialogue: 0,0:04:37.16,0:04:38.33,Default,Lily,0,0,0,,Dapat kang mabuhay.
Dialogue: 0,0:04:48.48,0:04:49.64,Default,Lily,0,0,0,,Alam ko.
Dialogue: 0,0:04:51.75,0:04:53.38,Default,Lily,0,0,0,,Ang babaeng iniibig mo...
Dialogue: 0,0:04:57.42,0:04:58.59,Default,Lily,0,0,0,,Itigil mo na.
Dialogue: 0,0:04:59.29,0:05:01.59,Default,Lily,0,0,0,,Ayokong mapahamak ka, lumayas ka sa amin.
Dialogue: 0,0:05:06.06,0:05:07.49,Default,Lily,0,0,0,,Gaano ang tiwala sa sarili!
Dialogue: 0,0:05:17.60,0:05:18.67,Default,Lily,0,0,0,,Kunin mo sila!
Dialogue: 0,0:05:18.67,0:05:20.54,Default,Lily,0,0,0,,Sumuway ang Ministro ng Digmaan sa utos!
Dialogue: 0,0:05:21.27,0:05:22.98,Default,Lily,0,0,0,,Mula ngayon, ibibigay ko na ang mga order!
Dialogue: 0,0:05:22.98,0:05:23.98,Default,Lily,0,0,0,,-Oo!\N-Oo!
Dialogue: 0,0:07:12.00,0:07:13.70,Default,,0,0,0,,Bumangon ka, bumangon ka.
Dialogue: 0,0:07:42.72,0:07:44.05,Default,Lily,0,0,0,,Nagdurugo ka nang husto.
Dialogue: 0,0:07:44.05,0:07:45.12,Default,Lily,0,0,0,,Kailangan natin siyang pigilan.
Dialogue: 0,0:08:01.70,0:08:02.80,Default,Lily,0,0,0,,Ano ito?
Dialogue: 0,0:08:03.14,0:08:06.04,Default,Lily,0,0,0,,Ito ay isang listahan ng mga nagsasabwatan.
Dialogue: 0,0:08:06.97,0:08:08.78,Default,Lily,0,0,0,,Protektahan ang iyong sarili dito.
Dialogue: 0,0:08:17.35,0:08:20.49,Default,Lily,0,0,0,,Naaalala mo ba kung paano tayo naglaro ng taguan noong mga bata pa tayo?
Dialogue: 0,0:08:21.15,0:08:23.19,Default,Lily,0,0,0,,Bibilang ako hanggang 10,
Dialogue: 0,0:08:23.19,0:08:24.69,Default,Lily,0,0,0,,at magtatago ka.
Dialogue: 0,0:08:25.89,0:08:27.16,Default,Lily,0,0,0,,Sabay na tayo.
Dialogue: 0,0:08:28.26,0:08:29.80,Default,Lily,0,0,0,,Hinahabol niya tayo.
Dialogue: 0,0:08:37.97,0:08:39.04,Default,Lily,0,0,0,,Ito ay walang kabuluhan.
Dialogue: 0,0:08:43.01,0:08:44.18,Default,Lily,0,0,0,,Go.
Dialogue: 0,0:08:44.78,0:08:46.45,Default,Lily,0,0,0,,At huwag lumingon.
Dialogue: 0,0:08:47.08,0:08:48.18,Default,Lily,0,0,0,,Hindi.
Dialogue: 0,0:08:52.35,0:08:53.82,Default,Lily,0,0,0,,I-save si Soyeon.
Dialogue: 0,0:08:54.85,0:08:56.06,Default,Lily,0,0,0,,Live.
Dialogue: 0,0:09:08.07,0:09:09.64,Default,Lily,0,0,0,,Nagbibilang ako hanggang 10.
Dialogue: 0,0:09:29.39,0:09:32.46,Default,Lily,0,0,0,,1, 2, 3...
Dialogue: 0,0:09:46.17,0:09:48.34,Default,Lily,0,0,0,,5, 6...
Dialogue: 0,0:10:00.72,0:10:02.59,Default,Lily,0,0,0,,Sino ang nagpadala sa iyo?
Dialogue: 0,0:10:03.56,0:10:04.72,Default,Lily,0,0,0,,At sino pa?
Dialogue: 0,0:10:05.46,0:10:06.63,Default,Lily,0,0,0,,Ang iyong ama.
Dialogue: 0,0:10:23.01,0:10:25.48,Default,Lily,0,0,0,,9, 10.
Dialogue: 0,0:10:55.61,0:10:58.28,Default,Lily,0,0,0,,Hiniling ko sa iyo na huwag lumingon.
Dialogue: 0,0:11:09.36,0:11:10.66,Default,Lily,0,0,0,,Sundan ang reyna!
Dialogue: 0,0:11:34.41,0:11:35.68,Default,Lily,0,0,0,,Benin.
Dialogue: 0,0:11:40.29,0:11:42.69,Default,Lily,0,0,0,,Halika rito. Sabay tayong mamasyal.
Dialogue: 0,0:11:44.72,0:11:46.86,Default,Lily,0,0,0,,Sa unang pagkikita ko sa hari, iipit ko ang aking buhok.
Dialogue: 0,0:11:46.86,0:11:48.63,Default,Lily,0,0,0,,Maaari mo ba akong tulungang pumili ng hairpin?
Dialogue: 0,0:11:49.43,0:11:51.40,Default,Lily,0,0,0,,Hindi siya dapat magarbong,
Dialogue: 0,0:11:51.46,0:11:53.60,Default,Lily,0,0,0,,at ayaw ko rin ng regular.
Dialogue: 0,0:11:53.90,0:11:55.37,Default,Lily,0,0,0,,Tumingin sa unahan.
Dialogue: 0,0:12:17.62,0:12:18.83,Default,Lily,0,0,0,,I
Dialogue: 0,0:12:23.36,0:12:26.23,Default,Lily,0,0,0,,laging nakatingin sa iyo.
Dialogue: 0,0:12:28.40,0:12:30.87,Default,Lily,0,0,0,,Nakita kitang ganito,
Dialogue: 0,0:12:34.74,0:12:36.91,Default,Lily,0,0,0,,hindi mo kilala ang iyong sarili.
Dialogue: 0,0:12:38.28,0:12:39.88,Default,Lily,0,0,0,,Bakit...
Dialogue: 0,0:12:44.85,0:12:46.49,Default,Lily,0,0,0,,Bakit ako
Dialogue: 0,0:12:48.19,0:12:51.22,Default,Lily,0,0,0,,hindi maintindihan?
Dialogue: 0,0:13:44.14,0:13:46.08,Default,Lily,0,0,0,,Hindi siya nakalayo. Hanapin mo siya!
Dialogue: 0,0:14:06.80,0:14:08.17,Default,Lily,0,0,0,,Saan siya nagpunta?
Dialogue: 0,0:14:10.14,0:14:11.47,Default,Lily,0,0,0,,Hanapin kahit saan!
Dialogue: 0,0:14:11.47,0:14:12.64,Default,Lily,0,0,0,,-Oo!\N-Oo!
Dialogue: 0,0:15:00.99,0:15:02.22,Default,Lily,0,0,0,,Nandiyan!
Dialogue: 0,0:16:00.35,0:16:02.55,Default,Lily,0,0,0,,Ano ang dapat kong gawin mag-isa sa bagay na ito?
Dialogue: 0,0:16:04.78,0:16:07.22,Default,Lily,0,0,0,,Hindi ko alam kung nasaan ako.
Dialogue: 0,0:16:10.56,0:16:12.59,Default,Lily,0,0,0,,Ano ang magagawa ko?
Dialogue: 0,0:16:13.59,0:16:16.90,Default,Lily,0,0,0,,Wala akong magawa kapag ang mga tao ay namamatay sa harapan ko!
Dialogue: 0,0:16:16.90,0:16:18.46,Default,Lily,0,0,0,,Wala!
Dialogue: 0,0:16:25.77,0:16:27.07,Default,Lily,0,0,0,,Ito na ang wakas.
Dialogue: 0,0:16:28.14,0:16:29.48,Default,Lily,0,0,0,,Kahit anong pilit ko,
Dialogue: 0,0:16:32.51,0:16:34.81,Default,Lily,0,0,0,,may mga bagay na hindi sinasadyang mangyari.
Dialogue: 0,0:16:51.06,0:16:52.53,Default,Lily,0,0,0,,Okay. Alisin mo ako.
Dialogue: 0,0:16:55.74,0:16:57.67,Default,Lily,0,0,0,,Tapos na rin.
Dialogue: 0,0:17:29.67,0:17:32.87,Default,Lily,0,0,0,,Ang taong bumangon mula sa mga patay
Dialogue: 0,0:17:36.44,0:17:37.48,Default,Lily,0,0,0,,Reyna.
Dialogue: 0,0:17:39.78,0:17:41.15,Default,Lily,0,0,0,,Buhay ka.
Dialogue: 0,0:17:41.68,0:17:42.78,Default,Lily,0,0,0,,Natutuwa ako.
Dialogue: 0,0:17:43.68,0:17:45.35,Default,Lily,0,0,0,,Masayang-masaya ako.
Dialogue: 0,0:18:02.60,0:18:04.17,Default,Lily,0,0,0,,Magiging maayos ang lahat.
Dialogue: 0,0:18:05.24,0:18:07.47,Default,Lily,0,0,0,,Buhay ka, magiging maayos ang lahat.
Dialogue: 0,0:18:08.24,0:18:09.74,Default,Lily,0,0,0,,Iyon lang ang kailangan ko.
Dialogue: 0,0:18:11.31,0:18:13.08,Default,Lily,0,0,0,,Namatay ang lahat.
Dialogue: 0,0:18:13.78,0:18:15.15,Default,Lily,0,0,0,,Lady Choi,
Dialogue: 0,0:18:15.75,0:18:18.95,Default,Lily,0,0,0,,Hong Young at Kim Byungin.
Dialogue: 0,0:18:20.35,0:18:22.12,Default,Lily,0,0,0,,Namatay ang lahat.
Dialogue: 0,0:18:24.52,0:18:25.79,Default,Lily,0,0,0,,Patay na ba si Kim Byungin?
Dialogue: 0,0:18:26.39,0:18:28.63,Default,Lily,0,0,0,,Namatay siya dahil sa akin.
Dialogue: 0,0:18:29.16,0:18:31.80,Default,Lily,0,0,0,,Lahat ay namatay dahil sa akin.
Dialogue: 0,0:18:34.70,0:18:35.80,Default,Lily,0,0,0,,Kalmado.
Dialogue: 0,0:18:36.10,0:18:38.20,Default,Lily,0,0,0,,My queen, huminahon ka.
Dialogue: 0,0:18:41.24,0:18:42.61,Default,Lily,0,0,0,,Hong Young at Lady Choi
Dialogue: 0,0:18:43.71,0:18:45.14,Default,Lily,0,0,0,,buhay.
Dialogue: 0,0:18:50.18,0:18:51.22,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:18:52.02,0:18:53.02,Default,Lily,0,0,0,,Hong Young!
Dialogue: 0,0:18:59.59,0:19:00.66,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:19:01.26,0:19:02.36,Default,Lily,0,0,0,,Okay ka lang?
Dialogue: 0,0:19:02.36,0:19:04.53,Default,Lily,0,0,0,,Okay lang ako. Nasaan si Lady Choi?
Dialogue: 0,0:19:04.83,0:19:07.13,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:19:07.37,0:19:08.47,Default,Lily,0,0,0,,Court lady Choi.
Dialogue: 0,0:19:11.44,0:19:14.24,Default,Lily,0,0,0,,-Naku. Ginang Choi.\N-Kamahalan.
Dialogue: 0,0:19:14.87,0:19:18.11,Default,Lily,0,0,0,,Gaya ng inaasahan, delikado sa labas ng palasyo.
Dialogue: 0,0:19:19.15,0:19:20.58,Default,Lily,0,0,0,,Malamang masakit.
Dialogue: 0,0:19:20.95,0:19:22.58,Default,Lily,0,0,0,,Nakakabaliw na masakit.
Dialogue: 0,0:19:22.92,0:19:25.15,Default,Lily,0,0,0,,Paano kaya.
Dialogue: 0,0:19:25.15,0:19:26.19,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:19:26.79,0:19:28.95,Default,Lily,0,0,0,,Huwag mag-alala,
Dialogue: 0,0:19:28.95,0:19:30.59,Default,Lily,0,0,0,,ibig sabihin hindi ako mamamatay.
Dialogue: 0,0:19:30.89,0:19:33.26,Default,Lily,0,0,0,,Sa isang mortal na sugat, hindi ako makakaramdam ng sakit.
Dialogue: 0,0:19:35.13,0:19:37.06,Default,Lily,0,0,0,,Ngunit inihagis niya ang kanyang espada.
Dialogue: 0,0:19:37.06,0:19:39.33,Default,Lily,0,0,0,,Sabihin na nating swerte ako.
Dialogue: 0,0:19:39.67,0:19:41.13,Default,Lily,0,0,0,,Bumalik!
Dialogue: 0,0:19:45.57,0:19:48.17,Default,Lily,0,0,0,,Hindi niya ginamit ng maayos ang espada, iyon din ang nagligtas sa kanya.
Dialogue: 0,0:19:53.98,0:19:57.62,Default,Lily,0,0,0,,Akala ko talaga may nangyari na sayo!
Dialogue: 0,0:19:58.95,0:20:00.75,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:20:01.42,0:20:04.22,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:20:04.62,0:20:06.53,Default,Lily,0,0,0,,Paumanhin. hindi ko ginusto.
Dialogue: 0,0:20:06.53,0:20:07.63,Default,Lily,0,0,0,,-Okay na ba ang lahat?\N-Oo.
Dialogue: 0,0:20:07.63,0:20:08.89,Default,Lily,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:20:11.36,0:20:13.67,Default,Lily,0,0,0,,Saan ka nanggaling, Kamahalan?
Dialogue: 0,0:20:13.67,0:20:16.20,Default,Lily,0,0,0,,Hinanap ko ang buong kagubatan.
Dialogue: 0,0:20:16.54,0:20:18.64,Default,Lily,0,0,0,,Ngunit hindi ko ito mahanap.
Dialogue: 0,0:20:19.57,0:20:21.34,Default,Lily,0,0,0,,Maraming tao ang naghahanap sa iyo.
Dialogue: 0,0:20:21.84,0:20:25.31,Default,Lily,0,0,0,,Ngunit natagpuan ka ng hari.
Dialogue: 0,0:20:40.13,0:20:43.46,Default,Lily,0,0,0,,-Kamahalan.\N-Na-miss ka namin.
Dialogue: 0,0:20:44.43,0:20:47.90,Default,Lily,0,0,0,,Natutuwa akong ligtas ka.
Dialogue: 0,0:20:47.90,0:20:50.14,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:20:50.87,0:20:51.97,Default,Lily,0,0,0,,God.
Dialogue: 0,0:21:05.62,0:21:07.02,Default,Lily,0,0,0,,Nangangailangan ng banlawan.
Dialogue: 0,0:21:15.43,0:21:16.90,Default,Lily,0,0,0,,Buntis ka.
Dialogue: 0,0:21:18.03,0:21:20.03,Default,Lily,0,0,0,,Bakit ka pumunta sa gubat?
Dialogue: 0,0:21:20.53,0:21:22.00,Default,Lily,0,0,0,,Matagal ka nang hindi nakabalik.
Dialogue: 0,0:21:23.07,0:21:24.30,Default,Lily,0,0,0,,Sinundan kita.
Dialogue: 0,0:21:24.44,0:21:27.01,Default,Lily,0,0,0,,Lagi mo akong ginugulat.
Dialogue: 0,0:21:27.41,0:21:28.94,Default,Lily,0,0,0,,Walang pagpipilian.
Dialogue: 0,0:21:30.08,0:21:31.68,Default,Lily,0,0,0,,Kung wala ka sa palasyo
Dialogue: 0,0:21:36.12,0:21:37.62,Default,Lily,0,0,0,,parang eclipse.
Dialogue: 0,0:21:38.95,0:21:40.89,Default,Lily,0,0,0,,Saan man ako pumunta, may kadiliman.
Dialogue: 0,0:21:43.82,0:21:44.86,Default,Lily,0,0,0,,Halika
Dialogue: 0,0:21:45.62,0:21:46.86,Default,Lily,0,0,0,,Ipapaliwanag ko kung ano ang eclipse.
Dialogue: 0,0:21:46.86,0:21:49.53,Default,Lily,0,0,0,,Hindi na kailangang ipaliwanag. Alam ko lahat.
Dialogue: 0,0:21:51.73,0:21:53.33,Default,Lily,0,0,0,,Gayundin ang naramdaman ko.
Dialogue: 0,0:21:56.90,0:21:58.07,Default,Lily,0,0,0,,Na-miss kita.
Dialogue: 0,0:22:00.11,0:22:01.84,Default,Lily,0,0,0,,Lalong lumakas ang sakit sa aking kaluluwa
Dialogue: 0,0:22:01.84,0:22:03.54,Default,Lily,0,0,0,,sakit ng katawan mula sa mga sugat.
Dialogue: 0,0:22:10.38,0:22:13.42,Default,Lily,0,0,0,,Hindi na kita pababayaan.
Dialogue: 0,0:22:17.06,0:22:18.16,Default,Lily,0,0,0,,Paumanhin.
Dialogue: 0,0:23:13.68,0:23:16.05,Default,Lily,0,0,0,,-Malubhang nasugatan ka ba?\N-Okay lang ako.
Dialogue: 0,0:23:17.89,0:23:19.99,Default,Lily,0,0,0,,Sa gamot magiging mabuti ako bilang bago.
Dialogue: 0,0:23:40.04,0:23:42.24,Default,Lily,0,0,0,,Nalaman mo ba kung sino ang umatake sa iyo?
Dialogue: 0,0:23:42.91,0:23:44.98,Default,Lily,0,0,0,,May nakita akong pamilyar na mukha.
Dialogue: 0,0:24:00.10,0:24:01.26,Default,Lily,0,0,0,,Tonghak followers!
Dialogue: 0,0:24:19.31,0:24:20.78,Default,Lily,0,0,0,,Nakita ko ang hari.
Dialogue: 0,0:24:29.39,0:24:36.53,Default,Lily,0,0,0,,Buhay ang hari.
Dialogue: 0,0:24:37.50,0:24:40.04,Default,Lily,0,0,0,,Buhay ang hari.
Dialogue: 0,0:24:42.67,0:24:43.77,Default,Lily,0,0,0,,Stop.
Dialogue: 0,0:24:44.31,0:24:46.18,Default,Lily,0,0,0,,Idineklara ang state of emergency.
Dialogue: 0,0:24:46.18,0:24:48.11,Default,Lily,0,0,0,,How dare a woman walk around alone?
Dialogue: 0,0:24:54.32,0:24:55.82,Default,Lily,0,0,0,,Rejected concubine ni Cho.
Dialogue: 0,0:24:56.22,0:24:58.42,Default,Lily,0,0,0,,Nahihiya akong magpakita sa publiko,
Dialogue: 0,0:24:58.42,0:25:01.66,Default,Lily,0,0,0,,gustong makalanghap ng sariwang hangin habang walang tao.
Dialogue: 0,0:25:01.76,0:25:04.23,Default,Lily,0,0,0,,Delikado sa mga lansangan ngayon. Bumalik ka.
Dialogue: 0,0:25:04.56,0:25:06.93,Default,Lily,0,0,0,,Naiintindihan ko. salamat po.
Dialogue: 0,0:25:18.11,0:25:20.38,Default,Lily,0,0,0,,Sinubukan ng sakim na angkan ng Kim na patayin ang hari
Dialogue: 0,0:25:20.38,0:25:22.38,Default,Lily,0,0,0,,at i-frame ang inosente.
Dialogue: 0,0:25:23.18,0:25:25.18,Default,Lily,0,0,0,,Nagdesisyon si Fate na iwan nang buhay ang hari.
Dialogue: 0,0:25:25.48,0:25:28.95,Default,Lily,0,0,0,,Posible bang sakupin ang isang trono na inookupahan na?
Dialogue: 0,0:25:28.95,0:25:31.22,Default,Lily,0,0,0,,Buhay ang hari.
Dialogue: 0,0:25:41.03,0:25:43.27,Default,Lily,0,0,0,,Mr!
Dialogue: 0,0:25:44.60,0:25:47.24,Default,Lily,0,0,0,,Nasa lansangan, sir.
Dialogue: 0,0:25:47.40,0:25:50.07,Default,Lily,0,0,0,,Ano ang mayroon para gumawa ng napakaraming ingay?
Dialogue: 0,0:25:55.64,0:25:56.71,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:26:00.58,0:26:02.52,Default,Lily,0,0,0,,Buhay ang hari.
Dialogue: 0,0:26:06.19,0:26:07.79,Default,Lily,0,0,0,,Kung gayon, ang reyna
Dialogue: 0,0:26:09.29,0:26:11.16,Default,Lily,0,0,0,,naiwan na hindi natauhan.
Dialogue: 0,0:26:15.33,0:26:16.87,Default,Lily,0,0,0,,So,
Dialogue: 0,0:26:17.30,0:26:20.44,Default,Lily,0,0,0,,Nakita mismo ni Kim Jwageun si Kim Byungin.
Dialogue: 0,0:26:20.44,0:26:23.01,Default,Lily,0,0,0,,Hindi ako makapaniwala na nakita niya ang pagtataksil ni Benin.
Dialogue: 0,0:26:24.34,0:26:28.04,Default,Lily,0,0,0,,Gusto ng ginoo na manahimik tayo tungkol sa pagkamatay ni Benin.
Dialogue: 0,0:26:28.84,0:26:30.68,Default,Lily,0,0,0,,-Oo, ama.\N-Gayunpaman,
Dialogue: 0,0:26:31.11,0:26:34.45,Default,Lily,0,0,0,,nakapagtatag na kami ng relasyon ni Jvagyn.
Dialogue: 0,0:26:36.72,0:26:38.49,Default,Lily,0,0,0,,Pero na-miss nila ang reyna.
Dialogue: 0,0:26:39.79,0:26:41.79,Default,Lily,0,0,0,,Dapat nating subukan
Dialogue: 0,0:26:42.93,0:26:44.53,Default,Lily,0,0,0,,magbayad ka, tama?
Dialogue: 0,0:26:54.37,0:26:57.47,Default,Spillik2,0,0,0,,Wow! Kung pakuluan mo ito nang labis, ito ay ganap na lumambot.
Dialogue: 0,0:26:57.74,0:26:58.97,Default,Spillik2,0,0,0,,Pabayaan mo siya.
Dialogue: 0,0:26:59.68,0:27:01.88,Default,Spillik2,0,0,0,,Pagkatapos umalis ng reyna para makabawi,
Dialogue: 0,0:27:01.88,0:27:03.41,Default,Spikyulka2,0,0,0,,nawalan siya ng malay.
Dialogue: 0,0:27:04.15,0:27:06.11,Default,Spikyulka2,0,0,0,,Sinasabi nila na ang poot ay higit na nakakabit sa iyo kaysa sa pag-ibig.
Dialogue: 0,0:27:07.02,0:27:10.09,Default,Spikyulka2,0,0,0,,I think he became very attached to her while she was here.
Dialogue: 0,0:27:21.40,0:27:24.27,Default,Spillik2,0,0,0,,Hindi ako makapaniwala na namatay ang hari nang walang kabuluhan.
Dialogue: 0,0:27:26.07,0:27:29.30,Default,Spikyulka2,0,0,0,,Taos-puso siyang nagmamalasakit sa kanyang mga tao.
Dialogue: 0,0:27:35.08,0:27:38.88,Default,Spikyulka2,0,0,0,,Gaya ng inaasahan, nag-iisa ka dito.
Dialogue: 0,0:27:42.55,0:27:47.56,Default,Spikyulka2,0,0,0,,Oo, walang naghihintay sa akin sa bahay.
Dialogue: 0,0:27:49.29,0:27:53.26,Default,Spillik2,0,0,0,,Napaka-depress din ang Kamahalan?
Dialogue: 0,0:27:54.03,0:27:57.13,Default,Spiky2,0,0,0,,Hindi ko rin alam kung ano ang sasabihin ko sa iyo, court lady Choi.
Dialogue: 0,0:27:57.33,0:27:59.00,Default,Spikyulka2,0,0,0,,Ang iyong pag-iral
Dialogue: 0,0:28:00.14,0:28:02.77,Default,Spikyulka2,0,0,0,,na-aliw at tiniyak ako.
Dialogue: 0,0:28:03.77,0:28:06.98,Default,Spikyulka2,0,0,0,,Nakalimutan ko pa ang tungkol sa mga reklamo saglit.
Dialogue: 0,0:28:07.08,0:28:10.45,Default,Spikyulka2,0,0,0,,Gayundin ang nararamdaman ko salamat sa iyo.
Dialogue: 0,0:28:14.88,0:28:16.49,Default,Spillik2,0,0,0,,Gusto mo bang kumain?
Dialogue: 0,0:28:16.49,0:28:17.79,Default,Spillik2,0,0,0,,Hindi, salamat.
Dialogue: 0,0:28:18.35,0:28:20.09,Default,Spillik2,0,0,0,,Medyo busy ako.
Dialogue: 0,0:28:20.52,0:28:24.29,Default,Spillik2,0,0,0,,Sandali lang. May ibibigay ako sayo.
Dialogue: 0,0:28:29.43,0:28:30.80,Default,Spillik2,0,0,0,,Gusto kita.
Dialogue: 0,0:28:35.57,0:28:36.94,Default,Spillik2,0,0,0,,Mahal kita.
Dialogue: 0,0:28:37.94,0:28:39.54,Default,Spikyulka2,0,0,0,,Wala ako sa posisyon na magpahayag
Dialogue: 0,0:28:40.28,0:28:43.28,Default,Spilyk2,0,0,0,,mga damdaming ito, kaya
Dialogue: 0,0:28:43.51,0:28:45.65,Default,Spilyk2,0,0,0,,dapat mong
Dialogue: 0,0:28:46.82,0:28:49.25,Default,Spilyk2,0,0,0,,makilala ang isang mabuting babae,
Dialogue: 0,0:28:50.09,0:28:52.12,Default,Spillik2,0,0,0,,upang lumiwanag ang iyong kalungkutan.
Dialogue: 0,0:28:56.16,0:28:57.56,Default,Spillit2,0,0,0,,Court lady Choi.
Dialogue: 0,0:29:08.87,0:29:10.97,Default,Spikyulka2,0,0,0,,Naramdaman kong may mali.
Dialogue: 0,0:29:11.97,0:29:13.64,Default,Spillik2,0,0,0,,Kumusta ang pagluluto?
Dialogue: 0,0:29:14.21,0:29:16.18,Default,Spillik2,0,0,0,,Naku!
Dialogue: 0,0:29:16.78,0:29:18.35,Default,Spilyk2,0,0,0,,Royal Chef!
Dialogue: 0,0:29:18.71,0:29:20.72,Default,Spikyulka2,0,0,0,,Ah, sinira ko lahat.
Dialogue: 0,0:29:20.75,0:29:23.75,Default,Spikyulka2,0,0,0,,Isang bihirang tanawin na makita kung paano sinisira ng royal cook ang pagkain.
Dialogue: 0,0:29:24.12,0:29:25.25,Default,Spikyulka2,0,0,0,,Ano ang nangyari sa iyo?
Dialogue: 0,0:29:25.25,0:29:27.69,Default,Spillik2,0,0,0,,Walang mali sa akin. May nangyari sa bansa.
Dialogue: 0,0:29:27.79,0:29:29.93,Default,Spikyulka2,0,0,0,,Sindak ang bumalot sa timog ng bansa.
Dialogue: 0,0:29:30.19,0:29:32.66,Default,Spikyulka2,0,0,0,,Kaya sa mga huling araw ay walang natanggap na mga regalo.
Dialogue: 0,0:29:32.89,0:29:34.26,Default,Spilyk2,0,0,0,,Royal cook.
Dialogue: 0,0:29:35.76,0:29:38.10,Default,Spilyk2,0,0,0,,Narinig ko na ang mga kakaibang apela ay naka-post sa mga lansangan ng lungsod.
Dialogue: 0,0:29:39.40,0:29:40.94,Default,Spillik2,0,0,0,,Yung mga sumalakay sa hari...
Dialogue: 0,0:29:40.94,0:29:44.34,Default,Spikyulka2,0,0,0,,Kung hindi ang followers ni tonhak, sino pa ang gagawa nito?
Dialogue: 0,0:29:44.34,0:29:47.81,Default,Spikyulka2,0,0,0,,Kailangan nating i-execute silang lahat. Hulihin at patayin!
Dialogue: 0,0:29:47.88,0:29:52.68,Default,Spillik2,0,0,0,,Pumatay? Alam mo ba kung paano gawin ito?
Dialogue: 0,0:29:53.58,0:29:54.75,Default,Spillik2,0,0,0,,Kaya itikom mo ang iyong bibig.
Dialogue: 0,0:29:55.68,0:29:56.82,Default,Spikyulka2,0,0,0,,Sabihin mo sa akin ang tungkol dito.
Dialogue: 0,0:30:07.53,0:30:11.70,Default,Spikyulka2,0,0,0,,Isuot ko ito ng masyadong mahaba. Nagsimula na akong mapagod.
Dialogue: 0,0:30:12.63,0:30:14.77,Default,Spikyulka2,0,0,0,,Sa tingin ko oras na para alisin ito.
Dialogue: 0,0:30:16.84,0:30:19.37,Default,Spikyulka2,0,0,0,,Kaya mo naman diba? Nagtrabaho ka sa akin ng 10 taon.
Dialogue: 0,0:30:20.41,0:30:21.44,Default,Spilyk2,0,0,0,,Ano?
Dialogue: 0,0:30:25.71,0:30:26.88,Default,Spilyk2,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:30:26.95,0:30:29.58,Default,Spilyk2,0,0,0,,At sino ang magluluto?
Dialogue: 0,0:30:30.09,0:30:32.89,Default,Spillik2,0,0,0,,Marami sa Joseon ang maaaring maging royal chef.
Dialogue: 0,0:30:34.99,0:30:36.19,Default,Spillik2,0,0,0,,Ano ang nangyayari?
Dialogue: 0,0:30:41.43,0:30:44.63,Default,Spikyulka2,0,0,0,,Nitong mga nakaraang araw, lumitaw ang mga kakaibang apela sa mga lansangan ng lungsod.
Dialogue: 0,0:30:45.57,0:30:48.04,Default,Spikyulka2,0,0,0,,Sabi nila tungkol sa hari ang pinag-uusapan natin.
Dialogue: 0,0:30:48.74,0:30:50.11,Default,Spilyk2,0,0,0,,Ganyan yan.
Dialogue: 0,0:30:50.31,0:30:52.54,Default,Spilyk2,0,0,0,,Mahalaga ba ang mga tsismis ngayon?
Dialogue: 0,0:30:52.87,0:30:55.91,Default,Silk2,0,0,0,,Matatapos na ang lahat pagkatapos ng koronasyon.
Dialogue: 0,0:30:56.95,0:30:59.08,Default,Spikyulka2,0,0,0,,Ano ang dapat nating alalahanin ngayon,
Dialogue: 0,0:30:59.08,0:31:01.55,Default,Spikyulka2,0,0,0,,kaya ito ang liham kung saan nakasalalay ang ating buhay.
Dialogue: 0,0:31:01.85,0:31:05.82,Default,Spikyulka2,0,0,0,,Ito ay kahina-hinala na si Kim Byonin ay hindi nakikita sa mga araw na ito.
Dialogue: 0,0:31:07.02,0:31:09.96,Default,Spillik2,0,0,0,,Umalis na ang Reyna para maghanda para sa panganganak.
Dialogue: 0,0:31:10.23,0:31:11.79,Default,Spikyulka2,0,0,0,,At nawala din si Kim Byungin?
Dialogue: 0,0:31:12.16,0:31:16.57,Default,Spillik2,0,0,0,,Ang pagkamatay ng hari at ang pag-alis ng reyna.
Dialogue: 0,0:31:16.60,0:31:18.37,Default,Spillik2,0,0,0,, Kahit papaano lahat ay kahina-hinala.
Dialogue: 0,0:31:20.34,0:31:23.74,Default,Spikyulka2,0,0,0,,At kung pareho ay kasinungalingan?
Dialogue: 0,0:31:24.07,0:31:26.24,Default,Spiky2,0,0,0,,Itinago niya ang reyna,
Dialogue: 0,0:31:26.58,0:31:28.34,Default,Spillie2,0,0,0,,na itinuturing na haka-haka ang pagkamatay ng hari,
Dialogue: 0,0:31:28.34,0:31:31.08,Default,Spilyk2,0,0,0,,at pumanig sa kanya?
Dialogue: 0,0:31:31.08,0:31:33.35,Default,Spikyulka2,0,0,0,,Pagkatapos ay pinirmahan ni Kim Byonin ang sulat,
Dialogue: 0,0:31:34.22,0:31:38.72,Default,Spilyk2,0,0,0,,upang sirain ang Kim clan.
Dialogue: 0,0:31:44.39,0:31:45.93,Default,Spilyk2,0,0,0,,Malamig.
Dialogue: 0,0:31:47.06,0:31:48.16,Default,Spilyk2,0,0,0,,Malamig?
Dialogue: 0,0:31:54.40,0:31:57.01,Default,Spillik2,0,0,0,,Ang awkward.
Dialogue: 0,0:31:59.81,0:32:00.91,Default,Spillik2,0,0,0,,Maghintay ng isang minuto.
Dialogue: 0,0:32:10.19,0:32:13.36,Default,Spikyulka2,0,0,0,,Pagkaalis mo, biglang nanlamig.
Dialogue: 0,0:32:15.62,0:32:18.69,Default,Silk2,0,0,0,,Nilalamig ka ba dahil wala ako?
Dialogue: 0,0:32:23.80,0:32:26.74,Default,Spikyulka2,0,0,0,,Salamat sa iyong walang hanggang pagmamahal.
Dialogue: 0,0:32:27.34,0:32:30.27,Default,Spikyulka2,0,0,0,,2, 3, 1, 1, 2, 3,
Dialogue: 0,0:32:30.27,0:32:31.81,Default,Spikyulka2,0,0,0,,2, 1, 2, 3,
Dialogue: 0,0:32:31.81,0:32:34.71,Default,Spillik2,0,0,0,,- 4, 1, 2, 3, 4.\N-Magpatuloy.
Dialogue: 0,0:32:35.41,0:32:36.51,Default,Spillik2,0,0,0,,Ito ay...
Dialogue: 0,0:32:37.68,0:32:39.68,Default,Spilyk2,0,0,0,,Yung training na sinabi mo.
Dialogue: 0,0:32:40.38,0:32:42.32,Default,Spilyk2,0,0,0,,Kaya iyan ang dahilan kung bakit nagsulat ka ng textbook tungkol sa mga taktika ng militar.
Dialogue: 0,0:32:42.58,0:32:45.39,Default,Spillik2,0,0,0,,Hindi ako makapaniwala na ang hari ay tagasunod ng donghak.
Dialogue: 0,0:32:48.12,0:32:49.93,Default,Spikyulka2,0,0,0,,Itinago ko pa ito sa kanila.
Dialogue: 0,0:32:50.86,0:32:54.03,Default,Spikyulka2,0,0,0,,Tulad ng isang mangangalakal na hindi nasisiyahan sa bansang tumutulong sa kanya.
Dialogue: 0,0:32:55.03,0:32:56.90,Default,Spilyk2,0,0,0,,Bakit ka gumagawa ng mga ganitong mapanganib na bagay?
Dialogue: 0,0:32:57.20,0:32:59.33,Default,Silk2,0,0,0,,Sabi nila ang kaaway ng iyong kaaway ay kaibigan mo.
Dialogue: 0,0:33:00.04,0:33:03.34,Default,Spikyulka2,0,0,0,,Ang mga tiwaling opisyal ang ating karaniwang kaaway.
Dialogue: 0,0:33:05.04,0:33:07.34,Default,Spikyulka2,0,0,0,,Hindi ba masyadong maliit ang saklaw?
Dialogue: 0,0:33:07.78,0:33:08.88,Default,Spilyk2,0,0,0,,Nasaan ang lahat?
Dialogue: 0,0:33:08.88,0:33:10.58,Default,Silk2,0,0,0,,Gusto mo bang magsama-sama tayo at patayin tayo nang sabay-sabay?
Dialogue: 0,0:33:10.91,0:33:13.78,Default,Spillik2,0,0,0,,Lahat ay magtitipon sa tamang oras.
Dialogue: 0,0:33:13.98,0:33:16.55,Default,Spikyulka2,0,0,0,,Samantala, mas ligtas na magkahiwalay!
Dialogue: 0,0:33:17.79,0:33:19.39,Default,Spilyk2,0,0,0,,Ikaw ba ang namamahala dito?
Dialogue: 0,0:33:19.39,0:33:20.49,Default,Spillik2,0,0,0,,Oo, ako nga.
Dialogue: 0,0:33:20.52,0:33:22.59,Default,Spiky2,0,0,0,,1, 2, 3. Apat.
Dialogue: 0,0:33:22.59,0:33:24.76,Default,Spillik2,0,0,0,,1, 2, 3. Lima.
Dialogue: 0,0:33:24.76,0:33:26.66,Default,Spillik2,0,0,0,,1, 2, 3. Anim.
Dialogue: 0,0:33:26.66,0:33:28.70,Default,Spillik2,0,0,0,,1, 2, 3. Pito.
Dialogue: 0,0:33:29.30,0:33:30.33,Default,Silk2,0,0,0,,-1, ​​​​2, 3. Walo.\N-Natutuwa akong makilala ka.
Dialogue: 0,0:33:30.80,0:33:33.00,Default,Spikyulka2,0,0,0,,Iyong mukha ay nagpapakita na ikaw ang namumuno.
Dialogue: 0,0:33:33.13,0:33:35.67,Default,Spillik2,0,0,0,,Lalong kahanga-hanga ang peklat sa mata.
Dialogue: 0,0:33:36.30,0:33:37.41,Default,Spilyk2,0,0,0,,Ikinagagalak na makilala ka.
Dialogue: 0,0:33:38.47,0:33:41.38,Default,Spikyulka2,0,0,0,,Ang pangunahing dito ay ang mas mahaba ang buhay.
Dialogue: 0,0:33:41.38,0:33:43.98,Default,Spikyulka2,0,0,0,,Sa sandaling mamatay ang isa, ang susunod ang magiging pangunahing.
Dialogue: 0,0:33:44.35,0:33:47.55,Default,Spikyulka2,0,0,0,,Ang ibig sabihin ng pagiging namumuno ay makaligtas sa pinakamatagal.
Dialogue: 0,0:33:48.25,0:33:51.95,Default,Spikyulka2,0,0,0,,Kung mamatay ako, siya ang magiging boss dito.
Dialogue: 0,0:33:51.95,0:33:54.36,Default,Spikyulka2,0,0,0,,Nine. 1, 2, 3. Sampu.
Dialogue: 0,0:33:54.49,0:33:55.82,Default,Spillik2,0,0,0,,Itong sanggol?
Dialogue: 0,0:33:56.42,0:33:58.43,Default,Spikyulka2,0,0,0,,Balita ko close kayo ng Damhyang ko.
Dialogue: 0,0:33:59.29,0:34:00.46,Default,Spillie2,0,0,0,,My Damhyang?
Dialogue: 0,0:34:01.50,0:34:02.86,Default,Spillik2,0,0,0,,Kaya ikaw...
Dialogue: 0,0:34:02.86,0:34:05.90,Default,Silk2,0,0,0,,Siya ang ama ni Damhyang, na hinahanap namin.
Dialogue: 0,0:34:06.97,0:34:09.30,Default,Spikyulka2,0,0,0,,Yung nasira ang mata gamit ang pitchfork?
Dialogue: 0,0:34:10.24,0:34:11.61,Default,Spilyk2,0,0,0,,Ito ay isang maliit na mundo!
Dialogue: 0,0:34:12.41,0:34:15.71,Default,Spikyulka2,0,0,0,,Kung hindi dahil kay Damhyang, napatay ko na ang lalaking ito.
Dialogue: 0,0:34:15.71,0:34:17.58,Default,Spikyulka2,0,0,0,,Kilalanin ang sumpain na hari,\N na nagdala sa bansa dito,
Dialogue: 0,0:34:17.58,0:34:20.35,Default,Spikyulka2,0,0,0,,Puputulin ko agad ang lalamunan niya. Yun ang naisip ko.
Dialogue: 0,0:34:21.12,0:34:22.85,Default,Spikyulka2,0,0,0,,Salamat sa iyong anak.
Dialogue: 0,0:34:22.85,0:34:26.32,Default,Spikyulka2,0,0,0,,Maaaring namatay ka sa pagsisikap na patayin ako.
Dialogue: 0,0:34:27.06,0:34:28.12,Default,Spillik2,0,0,0,,Ano?
Dialogue: 0,0:34:30.33,0:34:31.63,Default,Spillik2,0,0,0,,Hindi kita dapat niligtas.
Dialogue: 0,0:34:31.63,0:34:34.46,Default,Spikyulka2,0,0,0,,Kailangan mo lang tapusin ito gamit ang isang straw knife.
Dialogue: 0,0:34:34.46,0:34:35.66,Default,Spillik2,0,0,0,,3. Sampu.
Dialogue: 0,0:34:36.33,0:34:38.17,Default,Spikyulka2,0,0,0,,Ilang beses natin ito kailangang ulitin?
Dialogue: 0,0:34:38.63,0:34:40.90,Default,Spillik2,0,0,0,,Dapat ikaw mismo ang makaramdam nito!
Dialogue: 0,0:34:41.27,0:34:43.20,Default,Spikyulka2,0,0,0,,Dapat ko bang sabihin ito sa bawat oras?
Dialogue: 0,0:34:45.77,0:34:49.21,Default,Spillik2,0,0,0,,Damhyan ang nagligtas sa iyo. At siya rin ang nagligtas sa akin.
Dialogue: 0,0:34:49.54,0:34:51.75,Default,Spillik2,0,0,0,,Hindi pinababayaan ng hari ang kanyang mga tao.
Dialogue: 0,0:34:52.58,0:34:54.25,Default,Spillik2,0,0,0,,Kaya iniligtas ng mga tao ang hari.
Dialogue: 0,0:34:55.58,0:34:58.35,Default,Silk2,0,0,0,,Nga pala, anong nangyari sa mga warriors na humahabol sa akin?
Dialogue: 0,0:34:59.42,0:35:01.79,Default,Spikyulka2,0,0,0,,Marami ang ipinanganak at lumaki dito.
Dialogue: 0,0:35:01.79,0:35:03.66,Default,Spillik2,0,0,0,,Sila ay mga mangangaso at nangangalap ng mga halamang gamot.
Dialogue: 0,0:35:03.66,0:35:05.46,Default,Spikyulka2,0,0,0,,Kilalanin ang mga bundok tulad ng likod ng kanilang kamay.
Dialogue: 0,0:35:05.46,0:35:08.33,Default,Spikyulka2,0,0,0,,Hindi sila makukuha ng mga guard dito.
Dialogue: 0,0:35:08.63,0:35:10.70,Default,Spillik2,0,0,0,,Kumusta naman ang kakaibang lalaki sa tokkebi mask?
Dialogue: 0,0:35:10.90,0:35:11.93,Default,Spillik2,0,0,0,,Nakuha mo ba siya?
Dialogue: 0,0:35:12.03,0:35:13.10,Default,Spillik2,0,0,0,,-Nakasuot ng tokkebi mask?\N- 1, 2,
Dialogue: 0,0:35:13.10,0:35:15.77,Default,Spillik2,0,0,0,,3. 1, 2...
Dialogue: 0,0:35:15.77,0:35:17.17,Default,Spikyulka2,0,0,0,,Hinahabol ka rin ba niya?
Dialogue: 0,0:35:17.17,0:35:18.67,Default,Spillik2,0,0,0,,Sinubukan niya akong patayin.
Dialogue: 0,0:35:20.68,0:35:21.84,Default,Spikyulka2,0,0,0,,Namatay si Kim Byungin,
Dialogue: 0,0:35:23.91,0:35:25.28,Default,Spillik2,0,0,0,, sinusubukang pigilan siya.
Dialogue: 0,0:35:26.48,0:35:27.98,Default,Spilyk2,0,0,0,,Lalaking may maskara
Dialogue: 0,0:35:28.95,0:35:30.59,Default,Spillik2,0,0,0,,serves Kim Jwageun.
Dialogue: 0,0:35:33.12,0:35:34.99,Default,Spikyulka2,0,0,0,,Bumalik na si Kim Jwageun.
Dialogue: 0,0:35:36.32,0:35:37.39,Default,Spiky2,0,0,0,,1, 2, 3. Pito.
Dialogue: 0,0:35:37.39,0:35:40.06,Default,Spillik2,0,0,0,,1, 2, 3. Walo.
Dialogue: 0,0:35:40.06,0:35:41.90,Default,Spillik2,0,0,0,,1, 2, 3. Nine.
Dialogue: 0,0:35:41.90,0:35:43.77,Default,Spillik2,0,0,0,,1, 2, 3. Sampu.
Dialogue: 0,0:35:45.27,0:35:46.50,Default,shooting 3,0,0,0,,Direktang "Death Note".
Dialogue: 0,0:35:46.70,0:35:48.17,Default,shooting 3,0,0,0,,Narito ang mga pangalan ng lahat ng opisyal,
Dialogue: 0,0:35:48.17,0:35:49.54,Default,shooting gallery3,0,0,0,,na kailangang alisin.
Dialogue: 0,0:35:51.81,0:35:54.38,Default,shooting 3,0,0,0,,Nananatili itong maghanap ng paraan upang makabalik sa palasyo.
Dialogue: 0,0:35:55.04,0:35:56.18,Default,shooting 3,0,0,0,,Kung kinokolekta mo ang lahat,
Dialogue: 0,0:35:56.18,0:35:58.31,Default,shooting gallery3,0,0,0,,sino ang kakampi natin, ilan ang pwede nating i-recruit?
Dialogue: 0,0:35:58.78,0:36:00.98,Default,tier3,0,0,0,,Kung kinokolekta mula sa buong bansa,
Dialogue: 0,0:36:00.98,0:36:02.88,Default,shooting gallery3,0,0,0,,pagkatapos ay mga 1000 tao.
Dialogue: 0,0:36:03.18,0:36:05.45,Default,shooting gallery3,0,0,0,,-At iyon lang?\N-Marami iyon.
Dialogue: 0,0:36:06.02,0:36:07.79,Default,shooting 3,0,0,0,,Isapanganib ang iyong buhay ay hindi madali.
Dialogue: 0,0:36:08.49,0:36:10.19,Default,shooting 3,0,0,0,,Kung gayon bakit hindi nila pinatay ang mga gobernador?
Dialogue: 0,0:36:10.36,0:36:12.06,Default,shooting gallery3,0,0,0,,Alisin sila at manalo sa digmaan.
Dialogue: 0,0:36:12.06,0:36:14.63,Default,shooting gallery3,0,0,0,,Sa tingin mo ba kami ay isang uri ng uhaw sa dugo na mga hyena?
Dialogue: 0,0:36:15.16,0:36:17.57,Default,tyra3,0,0,0,,Kahit ang mga low-born na katulad namin,
Dialogue: 0,0:36:17.57,0:36:20.30,Default,tyra3,0,0,0,,nagkaisa, maaari silang magtanim ng takot sa mga namumuno.
Dialogue: 0,0:36:20.97,0:36:22.30,Default,shooting 3,0,0,0,,Iyon ang plano namin.
Dialogue: 0,0:36:23.41,0:36:25.81,Default,shooting3,0,0,0,,Nakikita ko. Kaya gusto mong makaakit ng pansin?
Dialogue: 0,0:36:26.37,0:36:27.88,Default,tier3,0,0,0,,Ito ay isang magandang diskarte.
Dialogue: 0,0:36:27.88,0:36:30.45,Default,tier3,0,0,0,,Hindi mo sila binigyan ng dahilan para simulan ang pakikipaglaban sa iyo.
Dialogue: 0,0:36:30.88,0:36:32.55,Default,shooting3,0,0,0,,Marahil kami ay tanga,
Dialogue: 0,0:36:32.55,0:36:35.68,Default,tier3,0,0,0,,pero alam namin na kung magkaharap kami, matatalo kami.
Dialogue: 0,0:36:36.62,0:36:39.39,Default,tier3,0,0,0,,Nagtipon sila ng 1000 mandirigma.
Dialogue: 0,0:36:42.82,0:36:45.06,Default,shooting3,0,0,0,,Itinaya ko ang aking buhay para sa kapakanan ng bansa!
Dialogue: 0,0:36:45.06,0:36:47.20,Default,shooting gallery3,0,0,0,,Sa tingin mo ba may gusto ako?
Dialogue: 0,0:36:47.50,0:36:49.63,Default,shooting3,0,0,0,,-Royal chef?\N-Hindi kapani-paniwala.
Dialogue: 0,0:36:50.23,0:36:51.37,Default,shooting 3,0,0,0,,Royal chef?
Dialogue: 0,0:36:51.93,0:36:53.94,Default,shooting3,0,0,0,,Paano natin mapagkakatiwalaan ang lalaking mula sa palasyo?
Dialogue: 0,0:36:55.14,0:36:56.70,Default,shooting 3,0,0,0,,Well, siyempre.
Dialogue: 0,0:36:56.97,0:36:59.61,Default,tier3,0,0,0,,Okay. babalik ako. Tanggalin mo ako.
Dialogue: 0,0:37:02.31,0:37:04.78,Default,shooting 3,0,0,0,,Okay. Ako na mismo ang magbubuklod nito.
Dialogue: 0,0:37:04.78,0:37:06.55,Default,shooting gallery3,0,0,0,,Bakit mukhang galit na galit ka?
Dialogue: 0,0:37:06.92,0:37:10.12,Default,shooting3,0,0,0,,Siguradong mas bata ka sa akin. Nasaan ang ugali mo?
Dialogue: 0,0:37:10.35,0:37:11.82,Default,shooting gallery3,0,0,0,,Kung nagmamakaawa ka sa akin, hindi ako mananatili!
Dialogue: 0,0:37:12.75,0:37:13.76,Default,shooting 3,0,0,0,,Out of the way!
Dialogue: 0,0:37:15.66,0:37:17.49,Default,shooting 3,0,0,0,,Dumating ka sa sarili mong kagustuhan,
Dialogue: 0,0:37:17.49,0:37:19.19,Default,shooting 3,0,0,0,,pero hindi ka makakaalis ng ganyan.
Dialogue: 0,0:37:20.56,0:37:23.00,Default,shooting gallery3,0,0,0,,Ilang uri ng pamilyar na sitwasyon.
Dialogue: 0,0:37:23.00,0:37:24.67,Default,shooting 3,0,0,0,,Nakita mo lahat ng mukha namin.
Dialogue: 0,0:37:24.67,0:37:26.33,Default,shooting gallery3,0,0,0,,At nalaman pa nila ang tungkol sa lugar na ito.
Dialogue: 0,0:37:26.94,0:37:28.37,Default,shooting 3,0,0,0,,Sa tingin mo makakaalis ka ng buhay?
Dialogue: 0,0:37:29.07,0:37:30.07,Default,shooting3,0,0,0,,Ano?
Dialogue: 0,0:37:30.74,0:37:31.81,Default,shooting 3,0,0,0,,Dito.
Dialogue: 0,0:37:32.34,0:37:34.34,Default,shooting 3,0,0,0,,Damn it. Hindi na kailangan.
Dialogue: 0,0:37:34.61,0:37:35.84,Default,shooting 3,0,0,0,,Royal Chef.
Dialogue: 0,0:37:37.15,0:37:40.72,Default,shooting 3,0,0,0,,Mukhang dumating na ang oras ko. Makakarinig ka ng ganito.
Dialogue: 0,0:37:41.38,0:37:42.78,Default,shooting 3,0,0,0,,Manbok.
Dialogue: 0,0:37:48.26,0:37:50.56,Default,shooting 3,0,0,0,,Kamahalan! bakit ka...
Dialogue: 0,0:37:52.16,0:37:53.70,Default,shooting 3,0,0,0,,Kamahalan!
Dialogue: 0,0:37:57.97,0:37:59.07,Default,shooting 3,0,0,0,,Royal Chef!
Dialogue: 0,0:37:59.87,0:38:01.80,Default,shooting3,0,0,0,,Court lady Choi!
Dialogue: 0,0:38:10.98,0:38:12.75,Default,tyra3,0,0,0,,Court lady Choi.
Dialogue: 0,0:38:12.75,0:38:15.15,Default,tira3,0,0,0,,-Royal cook.\N-Court lady Choi.
Dialogue: 0,0:38:15.85,0:38:17.32,Default,shooting 3,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:38:18.12,0:38:20.12,Default,shooting3,0,0,0,,Sino ang gumawa nito?
Dialogue: 0,0:38:20.12,0:38:21.76,Default,shooting 3,0,0,0,,Ano ito?
Dialogue: 0,0:38:22.92,0:38:25.69,Default,shooting3,0,0,0,,-Royal Chef.\N-Alam kong ililigtas mo ako.
Dialogue: 0,0:38:31.90,0:38:33.94,Default,shooting 3,0,0,0,,Ano ang nagdadala sa iyo dito?
Dialogue: 0,0:38:34.20,0:38:35.54,Default,shooting 3,0,0,0,,Kamahalan.
Dialogue: 0,0:38:36.34,0:38:39.21,Default,tyra3,0,0,0,,Nabalitaan kong nagpunta rito ang lahat ng hindi masaya sa bansang ito.
Dialogue: 0,0:38:39.21,0:38:40.78,Default,shooting gallery3,0,0,0,,Kaya pumunta ako.
Dialogue: 0,0:38:40.78,0:38:44.11,Default,shooting 3,0,0,0,,At andito rin ang mga taong nawala sa palasyo.
Dialogue: 0,0:38:45.35,0:38:48.75,Default,tyra3,0,0,0,,Royal cook, hindi ka ba masaya sa bansang ito?
Dialogue: 0,0:38:49.05,0:38:50.92,Default,shooting gallery3,0,0,0,,Pagmamasid sa nangyayari sa palasyo,
Dialogue: 0,0:38:50.92,0:38:53.45,Default,tier3,0,0,0,,kahit ako, ang pinakamasaya sa lahat, ay naging malungkot.
Dialogue: 0,0:38:53.66,0:38:55.39,Default,shooting 3,0,0,0,,Ano ang nangyayari sa palasyo?
Dialogue: 0,0:38:55.39,0:38:57.26,Default,shooting3,0,0,0,,Tungkol dito, Kamahalan.
Dialogue: 0,0:39:00.96,0:39:02.16,Default,shooting 3,0,0,0,,Magpalit ka muna ng damit.
Dialogue: 0,0:39:02.16,0:39:04.93,Default,tira3,0,0,0,,At takpan ang iyong sarili kapag bumahing ka.
Dialogue: 0,0:39:16.68,0:39:18.81,Default,shooting3,0,0,0,,Bukas ang coronation ceremony.
Dialogue: 0,0:39:18.81,0:39:20.88, Default, shooting 3,0,0,0,, Bawat segundo ay binibilang.
Dialogue: 0,0:39:21.22,0:39:22.68,Default,tier3,0,0,0,,Maganda ang ginawa mo.
Dialogue: 0,0:39:22.68,0:39:24.89,Default,tyra3,0,0,0,,Nga pala, bakit ang followers ng donghak
Dialogue: 0,0:39:24.89,0:39:27.62,Default,shooting 3,0,0,0,,lalo silang lumalaban, dahil pinigilan natin sila?
Dialogue: 0,0:39:28.42,0:39:31.33,Default,shooting3,0,0,0,,Nakakarating sa akin ang masamang balita.
Dialogue: 0,0:39:31.33,0:39:34.13,Default,tier3,0,0,0,,Ang katotohanan ay mas umuurong ang iyong kalaban,
Dialogue: 0,0:39:34.13,0:39:37.30,Default,tier3,0,0,0,, lalo mong binibigyang-katwiran ang iyong sarili at kumilos nang mas marahas.
Dialogue: 0,0:39:37.30,0:39:41.74,Default,tier3,0,0,0,,Kaya ang tanging solusyon ay turuan sila ng mas mahirap na leksyon.
Dialogue: 0,0:39:42.17,0:39:43.30,Default,shooting3,0,0,0,,Pagkatapos ng seremonya
Dialogue: 0,0:39:43.30,0:39:45.31,Default,shooting gallery 3,0,0,0,,Gagamitin ko ang mga baril para mabawi ang kontrol.
Dialogue: 0,0:39:47.61,0:39:49.48,Default,shooting 3,0,0,0,,Matagal na kitang hindi nakikitang may espada.
Dialogue: 0,0:39:50.04,0:39:52.15,Default,shooting gallery3,0,0,0,,Hindi na ba ligtas ang palasyo?
Dialogue: 0,0:39:52.28,0:39:54.68,Default,tier3,0,0,0,,Ito ay regalo mula sa reyna.
Dialogue: 0,0:39:55.48,0:39:57.89,Default,shooting3,0,0,0,,-Mga Reyna?\N-Sa totoo lang,
Dialogue: 0,0:39:59.15,0:40:01.96,Default,shooting3,0,0,0,,Natatakot ako na mayroon akong masamang balita para sa iyo.
Dialogue: 0,0:40:02.82,0:40:04.46,Default,tira3,0,0,0,,Isinakripisyo ni Benin ang kanyang sarili,
Dialogue: 0,0:40:04.46,0:40:06.23,Default,shooting 3,0,0,0,,upang iligtas ang reyna.
Dialogue: 0,0:40:06.66,0:40:08.00,Default,shooting gallery3,0,0,0,,Ganyan yan.
Dialogue: 0,0:40:10.77,0:40:14.17,Default,tier3,0,0,0,,Ang tanging disbentaha ng kabataan ay katangahan:
Dialogue: 0,0:40:14.17,0:40:16.40,Default,shooting3,0,0,0,,isakripisyo ang lahat para sa panandaliang damdamin.
Dialogue: 0,0:40:18.21,0:40:21.78,Default,shooting 3,0,0,0,,So nakaligtas ang reyna?
Dialogue: 0,0:40:23.01,0:40:24.05,Default,tier3,0,0,0,,Oo.
Dialogue: 0,0:40:26.11,0:40:28.38,Default,shooting 3,0,0,0,,Iniligtas ng hari ang reyna.
Dialogue: 0,0:40:29.52,0:40:32.62,Default,tyra3,0,0,0,,So, ibig sabihin ay buhay silang dalawa?
Dialogue: 0,0:40:34.59,0:40:35.92,Default,tier3,0,0,0,,Napaisip ako nito:
Dialogue: 0,0:40:35.92,0:40:38.29,Default,tier3,0,0,0,,walang maasahan dito, o ganoon ba sila katalino?
Dialogue: 0,0:40:38.66,0:40:41.50,Default,shooting 3,0,0,0,,Paumanhin. Samakatuwid...
Dialogue: 0,0:40:46.70,0:40:49.47,Default,shooting3,0,0,0,,Ang oras na sinubukan namin
Dialogue: 0,0:40:49.47,0:40:51.67,Default,tyra3,0,0,0,,bigyan ang reyna ng arsenic,
Dialogue: 0,0:40:53.04,0:40:55.31,Default,tyra3,0,0,0,,nalaman ito ng hari at tumakbo.
Dialogue: 0,0:41:04.22,0:41:05.35,Default,shooting3,0,0,0,,Sa tingin ko,
Dialogue: 0,0:41:08.09,0:41:12.09,Default,shooting 3,0,0,0,,may isang daga na nakikinig sa lahat ng oras na ito.
Dialogue: 0,0:41:20.87,0:41:23.67,Default,tier3,0,0,0,,Ibinigay mo ito sa akin bilang regalo.
Dialogue: 0,0:41:23.94,0:41:26.34,Default,shooting 3,0,0,0,,Personal mo siyang binulag at natigilan.
Dialogue: 0,0:41:26.34,0:41:27.94,Default,tyra3,0,0,0,,Sobrang sensitibo ako,
Dialogue: 0,0:41:27.94,0:41:29.58,Default,shooting3,0,0,0,,malamang, dahil sa nalalapit na seremonya.
Dialogue: 0,0:41:34.62,0:41:36.58,Default,shooting 3,0,0,0,,Naiintindihan ko ang lahat.
Dialogue: 0,0:41:36.85,0:41:38.95,Default,shooting 3,0,0,0,,Idaraos namin ang seremonya sa lalong madaling panahon.
Dialogue: 0,0:41:40.72,0:41:45.33,Default,tier3,0,0,0,,Huwag kalimutan na natalo ka na ng dalawang iyon minsan.
Dialogue: 0,0:41:46.36,0:41:47.93,Default,shooting 3,0,0,0,,Itataya ko ang buhay ko
Dialogue: 0,0:41:49.06,0:41:50.77,Default,tier 3,0,0,0,,para sa labanang ito.
Dialogue: 0,0:41:57.77,0:41:59.07,Default,shooting3,0,0,0,,Mayroon akong ideya.
Dialogue: 0,0:41:59.61,0:42:02.48,Default,shooting gallery3,0,0,0,,Madadaanan natin ang mga gate sa Hanyang at sa palasyo.
Dialogue: 0,0:42:04.45,0:42:06.78,Default,shooting 3,0,0,0,,At ano ang naisip mo?
Dialogue: 0,0:42:06.78,0:42:09.78,Default,tira3,0,0,0,,Ang mga taong ito ay sanay kumain ng sariwang pagkain.
Dialogue: 0,0:42:09.78,0:42:12.05,Default,tyra3,0,0,0,,Gaano katagal sila tatagal nang walang sariwang pagkain?
Dialogue: 0,0:42:12.82,0:42:15.29,Default,tier3,0,0,0,,Ang Dowager Queen ay sobrang mapili.
Dialogue: 0,0:42:15.96,0:42:17.19,Default,shooting 3,0,0,0,,Hindi siya magtatagal.
Dialogue: 0,0:42:25.40,0:42:26.60,Default,shooting3,0,0,0,,Hindi ito.
Dialogue: 0,0:42:28.20,0:42:29.20,Default,tier3,0,0,0,,To.
Dialogue: 0,0:42:30.07,0:42:31.11,Default,tier3,0,0,0,,To.
Dialogue: 0,0:42:35.51,0:42:36.61,Default,tier3,0,0,0,,Samakatuwid
Dialogue: 0,0:42:37.61,0:42:40.82,Default,shooting 3,0,0,0,,hindi isasara ang pinto sa anumang pagkakataon.
Dialogue: 0,0:42:42.32,0:42:44.02,Default,tier3,0,0,0,,Ang mga groceries ay inihahatid sa pamamagitan nito.
Dialogue: 0,0:42:50.19,0:42:53.39,Default,tier3,0,0,0,,Kailangan nating alamin ang tungkol sa bagon para sa mga maharlikang handog.
Dialogue: 0,0:42:53.83,0:42:56.70,Default,tyra3,0,0,0,,Ang palasyo ay may buong sistema para sa mga maharlikang handog.
Dialogue: 0,0:42:56.70,0:43:01.37,Default,tyra3,0,0,0,,Higit sa 50 tulad ng mga cart ang pumupunta sa royal kitchen araw-araw.
Dialogue: 0,0:43:01.37,0:43:04.41,Default,tier3,0,0,0,,Bukod dito, may mga espesyal na buwanang alay.
Dialogue: 0,0:43:04.41,0:43:07.28,Default,tier3,0,0,0,,At mayroon ding mga handog na dumarating kada 4 na buwan.
Dialogue: 0,0:43:08.71,0:43:11.48,Default,shooting3,0,0,0,,-Mas simple. Diretso na tayo sa punto.\N-Okay.
Dialogue: 0,0:43:11.88,0:43:13.98,Default,shooting gallery3,0,0,0,,62 cart ang darating sa palasyo
Dialogue: 0,0:43:13.98,0:43:16.05,Default,shooting3,0,0,0,,sa umaga ng seremonya.
Dialogue: 0,0:43:16.05,0:43:18.32,Default,shooting3,0,0,0,,Ngunit idineklara ang state of emergency.
Dialogue: 0,0:43:18.69,0:43:22.56,Default,tier3,0,0,0,,Sigurado akong susuriin nang may espesyal na atensyon ang mga maharlikang handog.
Dialogue: 0,0:43:22.56,0:43:26.33,Default,shooting3,0,0,0,,Pero paano kung may cart na walang nakakaalam?
Dialogue: 0,0:43:28.33,0:43:29.63,Default,shooting 3,0,0,0,,Inspector's cart.
Dialogue: 0,0:43:32.37,0:43:34.27,Default,shooting gallery3,0,0,0,,Well, sa wakas nandito ka na.
Dialogue: 0,0:43:34.27,0:43:37.77,Default,shooting 3,0,0,0,,Atin ang cart na ito. Laktawan sila.
Dialogue: 0,0:43:38.57,0:43:39.74,Default,shooting3,0,0,0,,-Okay. Pumasok ka.\N-Oo.
Dialogue: 0,0:43:39.74,0:43:40.98,Default,shooting 3,0,0,0,,Chief Inspector
Dialogue: 0,0:43:40.98,0:43:42.68,Default,tier3,0,0,0,,karaniwang nagpapalit ng mga cart.
Dialogue: 0,0:43:43.08,0:43:44.25,Default,tier3,0,0,0,,Swaps?
Dialogue: 0,0:43:44.25,0:43:46.51,Default,shooting3,0,0,0,,Well, hindi lahat ng opisyal ay mapili.
Dialogue: 0,0:43:46.51,0:43:48.45,Default,tier3,0,0,0,,Binago niya ang ilan sa mga alay
Dialogue: 0,0:43:48.45,0:43:50.42,Default,tier3,0,0,0,,para sa bahagyang mas mababang kalidad ng mga produkto.
Dialogue: 0,0:43:50.42,0:43:52.42,Default,shooting gallery3,0,0,0,,At may mga inspektor sa cart
Dialogue: 0,0:43:52.42,0:43:54.92,Default,tyra3,0,0,0,,mga produkto kung saan ipinagpapalit niya ang mga alay.
Dialogue: 0,0:43:55.29,0:43:57.96,Default,shooting3,0,0,0,,At kakaunti lang ang nakakaalam nito.
Dialogue: 0,0:43:57.96,0:43:59.86,Default,tier3,0,0,0,,Alam ko.
Dialogue: 0,0:43:59.86,0:44:02.46,Default,HAZELT,0,0,0,,Hindi ito palasyo, kundi yungib ng mga magnanakaw.
Dialogue: 0,0:44:03.46,0:44:04.83,Default,HAZELT,0,0,0,,Paumanhin.
Dialogue: 0,0:44:04.83,0:44:06.43,Default,HAZELT,0,0,0,,Akala ko kailangan.
Dialogue: 0,0:44:08.10,0:44:11.14,Default,HAZELT,0,0,0,,May mga butas ang bulok na kahoy.
Dialogue: 0,0:44:13.07,0:44:14.84,Default,HAZELT,0,0,0,,At magagamit natin ang mga ito.
Dialogue: 0,0:44:16.44,0:44:18.11,Default,HAZELT,0,0,0,,Okay, iunat nating lahat ang ating mga kamay.
Dialogue: 0,0:44:18.48,0:44:19.78,Default,HAZELT,0,0,0,,-Tayo.\N-Lahat?
Dialogue: 0,0:44:19.78,0:44:20.98,Default,HAZELT,0,0,0,,Mga kamay dito. Pasulong.
Dialogue: 0,0:44:20.98,0:44:22.65,Default,HAZELT,0,0,0,,-Narito.\N-Diyos.
Dialogue: 0,0:44:22.65,0:44:23.72,Default,HAZELT,0,0,0,,1, 2, 3.
Dialogue: 0,0:44:23.72,0:44:24.92,Default,HAZELT,0,0,0,,Ipasa!
Dialogue: 0,0:44:25.09,0:44:26.35,Default,HALTENUT,0,0,0,,-Ipasa!\N-Ipasa!
Dialogue: 0,0:44:26.85,0:44:27.92,Default,HAZELT,0,0,0,,Forward.
Dialogue: 0,0:44:39.73,0:44:42.44,Default,HAZELT,0,0,0,,-Ready?\N-Oo, tara na.
Dialogue: 0,0:44:46.34,0:44:48.41,Default,HAZELT,0,0,0,,-Manbok.\N-Oo, Kamahalan.
Dialogue: 0,0:44:48.81,0:44:49.88,Default,HAZELT,0,0,0,,Mas mabilis.
Dialogue: 0,0:44:53.31,0:44:55.02,Default,HAZELT,0,0,0,,-At nagbago na siya.\N-Let's go.
Dialogue: 0,0:45:44.10,0:45:45.27,Default,HAZELT,0,0,0,,Salamat
Dialogue: 0,0:45:47.90,0:45:49.27,Default,HAZELT,0,0,0,,at pasensya na.
Dialogue: 0,0:45:52.47,0:45:55.21,Default,HAZELT,0,0,0,,Naging espesyal ka rin kay Kim So-yeon.
Dialogue: 0,0:46:10.96,0:46:12.53,Default,HAZELT,0,0,0,,Gusto ko siya mismo ang maglibing.
Dialogue: 0,0:46:15.16,0:46:16.30,Default,HAZELT,0,0,0,,Okay.
Dialogue: 0,0:46:33.38,0:46:34.95,Default,HAZELT,0,0,0,,Pahinga sa kapayapaan.
Dialogue: 0,0:46:40.82,0:46:41.92,Default,HAZELT,0,0,0,,Pupunta ba tayo?
Dialogue: 0,0:47:01.54,0:47:02.88,Default,HAZELT,0,0,0,,Magsalita.
Dialogue: 0,0:47:05.78,0:47:08.18,Default,HAZELT,0,0,0,,Dapat maghanda ang Reyna sa pagsilang ng kanyang anak
Dialogue: 0,0:47:08.18,0:47:10.62,Default,HAZELT,0,0,0,,kasama ang ina,
Dialogue: 0,0:47:11.79,0:47:16.39,Default,HAZELT,0,0,0,,pero dahil imposible ito, gusto kong ako mismo ang tumulong sa kanya.
Dialogue: 0,0:47:17.66,0:47:20.80,Default,HAZELT,0,0,0,,Halika para itanong kung nasaan siya.
Dialogue: 0,0:47:20.80,0:47:22.96,Default,HAZELT,0,0,0,,Ang Reyna ay may tagapagmana, kaya
Dialogue: 0,0:47:22.96,0:47:25.33,Default,HAZELT,0,0,0,,Hindi ko masabi sa iyo ang lokasyon nito.
Dialogue: 0,0:47:25.33,0:47:26.93,Default,HAZELT,0,0,0,,Ibinigay ko sa kanya ang lahat ng kailangan niya,
Dialogue: 0,0:47:26.93,0:47:28.54,Default,HAZELT,0,0,0,,kaya huwag mag-alala.
Dialogue: 0,0:47:33.94,0:47:35.11,Default,HAZELT,0,0,0,,Narito.
Dialogue: 0,0:47:51.16,0:47:52.93,Default,HAZELT,0,0,0,,Hindi patay ang Hari
Dialogue: 0,0:47:52.93,0:47:56.56,Default,HALTENUT,0,0,0,,Naghahanda na ba talaga siya para manganak?
Dialogue: 0,0:47:56.80,0:48:00.37,Default,HALTENUT,0,0,0,,Hindi mo siya sinaktan, di ba?
Dialogue: 0,0:48:01.87,0:48:04.11,Default,HAZELT,0,0,0,,Ang Reyna ay nakatakas.
Dialogue: 0,0:48:04.54,0:48:07.37,Default,HALTENUT,0,0,0,,Ipinagtatanggol namin ang kanyang karangalan.
Dialogue: 0,0:48:09.61,0:48:11.31,Default,HAZELT,0,0,0,,-Tumakas?\N-Naniniwala siya,
Dialogue: 0,0:48:11.31,0:48:14.01,Default,HAZELT,0,0,0,,na buhay ang hari, umalis pa siya sa palasyo.
Dialogue: 0,0:48:15.88,0:48:17.25,Default,HAZELT,0,0,0,,Excuse me,
Dialogue: 0,0:48:18.02,0:48:21.26,Default,HAZELT,0,0,0,,ngunit hayagang sasabihin ko sa iyo, Kamahalan.
Dialogue: 0,0:48:22.19,0:48:26.46,Default,HAZELT,0,0,0,,Hindi nakakatulong sa pamilya namin ang ugali mo,
Dialogue: 0,0:48:26.46,0:48:29.43,Default,HAZELT,0,0,0,,sa kabaligtaran, sinisira nito ang kanyang pangalan.
Dialogue: 0,0:48:29.93,0:48:31.20,Default,HAZELT,0,0,0,,Hindi mo ba naiintindihan,
Dialogue: 0,0:48:31.20,0:48:33.47,Default,HAZELT,0,0,0,,ano ang sasabihin ng ating susunod na henerasyon tungkol sa atin?
Dialogue: 0,0:48:33.97,0:48:37.57,Default,HAZELT,0,0,0,,Nasa posisyon ka bang magsalita ng ganyan?
Dialogue: 0,0:48:39.54,0:48:42.91,Default,HALTENUT,0,0,0,,At least may nararamdaman akong hiya.
Dialogue: 0,0:48:42.91,0:48:45.75,Default,HALTENUT,0,0,0,,Ang kahihiyan mo ay isang krimen.
Dialogue: 0,0:48:45.75,0:48:47.98,Default,HAZELT,0,0,0,,Kung walang kahihiyan, walang krimen.
Dialogue: 0,0:48:47.98,0:48:49.78,Default,HAZELT,0,0,0,,Kung hindi para sa karangalan ng pamilya,
Dialogue: 0,0:48:50.58,0:48:53.49,Default,HAZELT,0,0,0,,kung gayon bakit ang layo mo?
Dialogue: 0,0:48:53.49,0:48:54.89,Default,HALTENUT,0,0,0,,Maging ang hari ay nasaktan.
Dialogue: 0,0:48:57.79,0:48:59.86,Default,HAZELT,0,0,0,,Hindi matatapos ang oras ko,
Dialogue: 0,0:49:00.53,0:49:03.83,Default,HAZELT,0,0,0,,hanggang sa gusto ko mismo.
Dialogue: 0,0:49:43.80,0:49:45.07,Default,HAZELT,0,0,0,,Naririnig mo ang lahat.
Dialogue: 0,0:49:56.02,0:49:59.05,Default,HAZELT,0,0,0,,-Ayan.\N-Teho.
Dialogue: 0,0:50:01.06,0:50:02.12,Default,HAZELT,0,0,0,,Kamahalan.
Dialogue: 0,0:50:02.72,0:50:03.96,Default,HAZELT,0,0,0,,Nauna kami sa amin.
Dialogue: 0,0:50:04.19,0:50:05.49,Default,HAZELT,0,0,0,,-Oo.\N-Oo.
Dialogue: 0,0:50:05.49,0:50:07.39,Default,HAZELT,0,0,0,,God, sobrang sakit ng tuhod ko.
Dialogue: 0,0:50:07.60,0:50:08.63,Default,HAZELT,0,0,0,,Kamahalan.
Dialogue: 0,0:50:09.93,0:50:10.97,Default,HAZELT,0,0,0,,Kumusta.
Dialogue: 0,0:50:13.50,0:50:16.14,Default,HAZELT,0,0,0,,Masaya kang buhay.\NMarami kang pinagdaanan.
Dialogue: 0,0:50:16.44,0:50:18.27,Default,HAZELT,0,0,0,,Natutuwa kaming ligtas ka.
Dialogue: 0,0:50:19.67,0:50:21.24,Default,HAZELT,0,0,0,,Sino ang may sigarilyo?
Dialogue: 0,0:50:21.28,0:50:23.38,Default,HAZELT,0,0,0,,Kamahalan, malamig dito.
Dialogue: 0,0:50:29.22,0:50:32.55,Default,HAZELT,0,0,0,,I wouldn't mind a cold can of beer right now.
Dialogue: 0,0:50:35.39,0:50:37.19,Default,HAZELT,0,0,0,,Hindi ganoon kagaling dito,
Dialogue: 0,0:50:37.19,0:50:38.53,Default,HAZELT,0,0,0,,so bakit tayo dumating?
Dialogue: 0,0:50:38.53,0:50:41.93,Default,HAZELT,0,0,0,,Ito ay pinakaligtas dito, \N walang nakakaalam tungkol sa lugar na ito.
Dialogue: 0,0:50:42.56,0:50:45.70,Default,HAZELT,0,0,0,,Ganun ba? Kahit gusto mo, hindi mo mahahanap.
Dialogue: 0,0:50:46.33,0:50:47.70,Default,HAZELT,0,0,0,,Diyos, aking mga binti.
Dialogue: 0,0:50:55.68,0:50:56.78,Default,HAZELT,0,0,0,,Damn.
Dialogue: 0,0:50:58.55,0:50:59.65,Default,HAZELT,0,0,0,,Hindi pa oras.
Dialogue: 0,0:50:59.65,0:51:01.08,Default,HAZELT,0,0,0,,Gaano ka katagal?
Dialogue: 0,0:51:01.08,0:51:03.88,Default,HAZELT,0,0,0,,Ito na ang huling pagkakataon. Kailangan mong mag-ingat.
Dialogue: 0,0:51:12.69,0:51:13.96,Default,HAZELT,0,0,0,,Panahon na.
Dialogue: 0,0:51:25.87,0:51:27.11,Default,HAZELT,0,0,0,,Napakasarap?
Dialogue: 0,0:51:38.12,0:51:40.29,Default,HAZELT,0,0,0,,-Narito.\N-Narito.
Dialogue: 0,0:51:59.97,0:52:01.31,Default,HALTENUT,0,0,0,,God.
Dialogue: 0,0:52:22.15,0:52:23.42,Default,HAZELT,0,0,0,,Napakasarap.
Dialogue: 0,0:52:39.54,0:52:41.54,Default,HALTENUT,0,0,0,,Naghahanap ng gulo?
Dialogue: 0,0:52:42.74,0:52:45.68,Default,HAZELT,0,0,0,,Mamamatay pa rin ang mga taong katulad ko,
Dialogue: 0,0:52:45.68,0:52:47.18,Default,HAZELT,0,0,0,,wala tayong pagpipilian.
Dialogue: 0,0:52:47.34,0:52:50.31,Default,HAZELT,0,0,0,,At ikaw ang may pinakamataas na posisyon sa buong Joseon.
Dialogue: 0,0:52:50.31,0:52:53.88,Default,HAZELT,0,0,0,,Kung ipipikit natin ang ating mga mata sa lahat, hindi ba tayo mabubuhay nang sagana?
Dialogue: 0,0:52:54.72,0:52:56.89,Default,HAZELT,0,0,0,,May oras na ako
Dialogue: 0,0:52:57.59,0:52:59.96,Default,HAZELT,0,0,0,,nabuhay sa isang bangungot na kailangan kong tiisin.
Dialogue: 0,0:53:01.29,0:53:03.53,Default,HAZELT,0,0,0,,Tiis ko ang lahat sa pag-iisip na maghiganti sa mga
Dialogue: 0,0:53:04.80,0:53:07.83,Default,HAZELT,0,0,0,,na pumatay sa aking mga magulang, mga kapatid.
Dialogue: 0,0:53:08.90,0:53:12.10,Default,HAZELT,0,0,0,,Pagkatapos ay sinimulan kong makita ang pagkabulok ni Joseon
Dialogue: 0,0:53:12.77,0:53:15.44,Default,HAZELT,0,0,0,,at ang mga taong nagdusa.
Dialogue: 0,0:53:18.24,0:53:20.34,Default,HAZELT,0,0,0,,At may matalas kang mata.
Dialogue: 0,0:53:20.58,0:53:22.95,Default,HAZELT,0,0,0,,Akala ko lahat ng tao sa palasyo ay bulag.
Dialogue: 0,0:53:25.42,0:53:27.15,Default,HAZELT,0,0,0,,Kung maayos ang lahat,
Dialogue: 0,0:53:27.99,0:53:31.29,Default,HAZELT,0,0,0,,hindi ka magiging katulad nila, di ba?
Dialogue: 0,0:53:35.13,0:53:36.43,Default,HAZELT,0,0,0,,I
Dialogue: 0,0:53:38.00,0:53:40.63,Default,HAZELT,0,0,0,,Nangarap ako ng bagong Joseon.
Dialogue: 0,0:53:43.67,0:53:46.07,Default,HAZELT,0,0,0,,Tinawag mo ba itong "election"?
Dialogue: 0,0:53:47.07,0:53:48.07,Default,HAZELT,0,0,0,,Ano?
Dialogue: 0,0:53:48.07,0:53:50.47,Default,HAZELT,0,0,0,,Kapag pinili ng mga tao ang kanilang hari.
Dialogue: 0,0:53:50.71,0:53:52.08,Default,HAZELT,0,0,0,,Oo. Halalan.
Dialogue: 0,0:53:52.58,0:53:54.95,Default,HAZELT,0,0,0,,Ngunit hindi ito nangangahulugan na ang mundo ay magiging perpekto.
Dialogue: 0,0:54:02.45,0:54:05.22,Default,HAZELT,0,0,0,,Well, maganda na yan.
Dialogue: 0,0:54:05.76,0:54:08.23,Default,HAZELT,0,0,0,,Maaari mo itong baguhin kung may mali.
Dialogue: 0,0:54:09.53,0:54:12.93,Default,HAZELT,0,0,0,,Ang hari at ang reyna ay parehong baliw.
Dialogue: 0,0:54:13.56,0:54:16.93,Default,HAZELT,0,0,0,,Matulog ka ng maaga, marami tayong aabutan.
Dialogue: 0,0:54:20.87,0:54:21.97,Default,HAZELT,0,0,0,,Magandang gabi.
Dialogue: 0,0:54:26.88,0:54:29.11,Default,HAZELT,0,0,0,,Kung talagang galing ka sa hinaharap,
Dialogue: 0,0:54:29.85,0:54:32.02,Default,HAZELT,0,0,0,,para malaman mo kung paano magtatapos ang lahat.
Dialogue: 0,0:54:33.95,0:54:35.19,Default,HAZELT,0,0,0,,Ano ang mangyayari?
Dialogue: 0,0:54:40.39,0:54:41.59,Default,HAZELT,0,0,0,,Matatalo ka.
Dialogue: 0,0:54:45.70,0:54:47.73,Default,HAZELT,0,0,0,,Pero itataya ko ang lahat sa iyo.
Dialogue: 0,0:54:49.23,0:54:52.40,Default,HAZELT,0,0,0,,Hindi ba palagi kang nasa winning side?
Dialogue: 0,0:54:53.07,0:54:54.30,Default,HAZELT,0,0,0,,Wala.
Dialogue: 0,0:54:54.30,0:54:56.17,Default,HALTENUT,0,0,0,,Nagkagulo na ako sa buhay na ito.
Dialogue: 0,0:54:56.81,0:54:58.94,Default,HAZELT,0,0,0,,Kahit ilagay ko lahat sa linya, okay lang.
Dialogue: 0,0:55:00.88,0:55:03.41,Default,HAZELT,0,0,0,,So nilagay mo lahat ng itlog mo sa basket ko?
Dialogue: 0,0:55:04.31,0:55:07.18,Default,HAZELT,0,0,0,,Oo. Lahat. pinasok ko lahat.
Dialogue: 0,0:55:10.99,0:55:13.96,Default,HAZELT,0,0,0,,Kahit mabigo ako, gagawin ko ang aking makakaya.
Dialogue: 0,0:55:15.26,0:55:17.73,Default,HAZELT,0,0,0,,Hanggang sa magsawa sa akin ang tadhana,
Dialogue: 0,0:55:18.40,0:55:20.73,Default,HAZELT,0,0,0,,Hindi ko hahayaang kainin niya ako ng ganoon kadali.
Dialogue: 0,0:55:41.05,0:55:42.69,Default,HAZELT,0,0,0,,Hindi ako makapaniwala,
Dialogue: 0,0:55:43.29,0:55:45.52,Default,HALTENUT,0,0,0,,na ako ay natigil dito at hindi makakatulong sa hari.
Dialogue: 0,0:55:46.32,0:55:48.19,Default,HAZELT,0,0,0,,Sa tingin mo ba nakilala na siya ng reyna?
Dialogue: 0,0:55:48.19,0:55:52.10,Default,HAZELT,0,0,0,,Kahit na nagkita sila, ano ang kaya nilang gawin sa kanilang sarili?
Dialogue: 0,0:55:53.90,0:55:55.90,Default,HAZELT,0,0,0,,Sa tingin ko wala
Dialogue: 0,0:55:55.90,0:55:57.90,Default,HALTENUT,0,0,0,,paraan para ihinto ang koronasyon.
Dialogue: 0,0:56:02.84,0:56:04.21,Default,HAZELT,0,0,0,,At kung gagamitin mo si Kim Hwan...
Dialogue: 0,0:56:09.11,0:56:10.25,Default,HAZELT,0,0,0,,Hon.
Dialogue: 0,0:56:16.79,0:56:17.99,Default,HAZELT,0,0,0,,Dumating na ba siya?
Dialogue: 0,0:56:18.42,0:56:19.92,Default,HAZELT,0,0,0,,Nagdala ng isang bagay.
Dialogue: 0,0:56:23.06,0:56:24.19,Default,HAZELT,0,0,0,,Ano ito?
Dialogue: 0,0:56:28.00,0:56:29.67,Default,HAZELT,0,0,0,,Pagkolekta ng mga kahilingan,
Dialogue: 0,0:56:29.67,0:56:31.23,Default,HALTENUT,0,0,0,,upang iligtas ka.
Dialogue: 0,0:56:32.60,0:56:36.04,Default,HAZELT,0,0,0,,Ngunit mayroon pa ba akong magagawa para tumulong?
Dialogue: 0,0:56:38.14,0:56:39.31,Default,HAZELT,0,0,0,,Tulong?
Dialogue: 0,0:56:39.31,0:56:41.65,Default,HAZELT,0,0,0,,Oo. Humingi ng kahit ano.
Dialogue: 0,0:56:42.41,0:56:44.25,Default,HAZELT,0,0,0,,-Lahat?\N-Oo.
Dialogue: 0,0:56:44.85,0:56:47.92,Default,HAZELT,0,0,0,,Gagawin ko ang lahat para sa iyo.
Dialogue: 0,0:56:53.59,0:56:54.73,Default,HAZELT,0,0,0,,Bakit
Dialogue: 0,0:56:56.39,0:56:58.56,Default,HALTENUT,0,0,0,,ganyan ka ba nagtitiwala sa mga tao?
Dialogue: 0,0:57:00.60,0:57:02.70,Default,HAZELT,0,0,0,,Ang trabaho mo ay pakainin ang mga scammer?
Dialogue: 0,0:57:02.87,0:57:05.04,Default,HAZELT,0,0,0,,Paano ka mabubuhay sa malupit na mundong ito?
Dialogue: 0,0:57:06.07,0:57:08.04,Default,HAZELT,0,0,0,,Paumanhin, nagkamali ako.
Dialogue: 0,0:57:09.41,0:57:12.24,Default,HAZELT,0,0,0,,-Ano ang mali?\N-Hindi ko alam kung ano talaga,
Dialogue: 0,0:57:13.21,0:57:15.55,Default,HAZELT,0,0,0,,pero dahil sinabi mo, hindi ko na uulitin.
Dialogue: 0,0:57:15.55,0:57:16.91,Default,HAZELT,0,0,0,,Mali ka tungkol diyan
Dialogue: 0,0:57:18.88,0:57:20.58,Default,HAZELT,0,0,0,,na nagtitiwala ka sa mga taong katulad ko.
Dialogue: 0,0:57:24.55,0:57:27.16,Default,ZINA,0,0,0,,Sinubukan kong maging kaibigan ka para malaman ang impormasyon.
Dialogue: 0,0:57:28.19,0:57:29.43,Default,ZINA,0,0,0,,At wala kang ideya.
Dialogue: 0,0:57:33.20,0:57:34.66,Default,ZINA,0,0,0,,Para saan ang lahat ng ito?
Dialogue: 0,0:57:40.50,0:57:41.54,Default,ZINA,0,0,0,,Iyon ay
Dialogue: 0,0:57:44.31,0:57:46.88,Default,ZINA,0,0,0,, all this time hindi mo ako tinuring na kaibigan?
Dialogue: 0,0:57:47.34,0:57:48.38,Default,ZINA,0,0,0,,No.
Dialogue: 0,0:57:49.41,0:57:50.81,Default,ZINA,0,0,0,,Hindi kita binilang
Dialogue: 0,0:57:52.18,0:57:53.68,Default,ZINA,0,0,0,,walang isang segundo kasama ang iyong kaibigan.
Dialogue: 0,0:57:56.82,0:57:58.42,Default,ZINA,0,0,0,,Kaya huwag mo nang isipin ang pagbabalik.
Dialogue: 0,0:58:34.59,0:58:36.59,Default,ZINA,0,0,0,,Bakit ganyan ka makatingin sa akin?
Dialogue: 0,0:58:37.09,0:58:39.16,Default,ZINA,0,0,0,,Sisihin mo ito sa
Dialogue: 0,0:58:39.53,0:58:41.36,Default,ZINA,0,0,0,,hindi na natin magagamit?
Dialogue: 0,0:58:43.10,0:58:44.60,Default,ZINA,0,0,0,,Hindi kita tiningnan.
Dialogue: 0,0:58:46.10,0:58:49.17,Default,ZINA,0,0,0,,Ngayon sa harap ng aking mga mata ay nangyari ang gayong kahihiyan.
Dialogue: 0,0:58:59.12,0:59:00.88,Default,ZINA,0,0,0,,Pagod na pagod ka na.
Dialogue: 0,0:59:08.36,0:59:09.96,Default,ZINA,0,0,0,,Hindi ako dilute ng tubig.
Dialogue: 0,0:59:10.86,0:59:12.20,Default,ZINA,0,0,0,,Hinahalo ko ito sa soju.
Dialogue: 0,0:59:14.00,0:59:15.93,Default,ZINA,0,0,0,,Golden ratio, somek.
Dialogue: 0,0:59:22.37,0:59:24.47,Default,ZINA,0,0,0,,Mukhang may magandang pinapangarap ka.
Dialogue: 0,0:59:27.54,0:59:28.75,Default,ZINA,0,0,0,,Nakakaluwag.
Dialogue: 0,0:59:51.43,0:59:53.17,Default,ZINA,0,0,0,,Ano ang napanaginipan mo?
Dialogue: 0,0:59:53.37,0:59:55.91,Default,ZINA,0,0,0,,Nasusunog ang larawan ng hari.
Dialogue: 0,0:59:56.54,1:00:00.71,Default,ZINA,0,0,0,,Natupok ng apoy ang buong Seongwonjong.
Dialogue: 0,1:00:01.24,1:00:05.18,Default,ZINA,0,0,0,,At ako ay napadpad dito mag-isa nang ang apoy...
Dialogue: 0,1:00:22.23,1:00:23.97,Default,ZINA,0,0,0,, Ngayon ay isang makabuluhang araw.
Dialogue: 0,1:00:23.97,1:00:25.54,Default,ZINA,0,0,0,,Walang isang patak ang mabigkas.
Dialogue: 0,1:00:53.63,1:00:55.83,Default,ZINA,0,0,0,,Powder mo ako para walang kapintasan.
Dialogue: 0,1:01:05.41,1:01:09.61,Default,ZINA,0,0,0,,Araw ng seremonya ng pag-akyat
Dialogue: 0,1:01:21.83,1:01:23.36,Default,ZINA,0,0,0,,Para sa kaligtasan ng Iyong Kamahalan
Dialogue: 0,1:01:23.36,1:01:26.30,Default,ZINA,0,0,0,,Nag-utos ako ng curfew na ipapasok sa palasyo.
Dialogue: 0,1:01:26.73,1:01:30.10,Default,ZINA,0,0,0,,Lahat, maliban sa mga mandirigma,\Ndapat manatili sa loob ng palasyo.
Dialogue: 0,1:01:31.20,1:01:32.24,Default,ZINA,0,0,0,,Oo.
Dialogue: 0,1:01:32.24,1:01:35.01,Default,ZINA,0,0,0,,Hindi ko inimbitahan ang royal family, o ang mga musikero.
Dialogue: 0,1:01:35.84,1:01:37.77,Default,ZINA,0,0,0,,Hayaan ang seremonya nang mapayapa.
Dialogue: 0,1:01:37.77,1:01:39.18,Default,ZINA,0,0,0,,Kahit ang royal family?
Dialogue: 0,1:01:39.18,1:01:40.88,Default,ZINA,0,0,0,,Magiging mas ligtas sa ganitong paraan.
Dialogue: 0,1:01:40.88,1:01:41.91,Default,ZINA,0,0,0,,Pero...
Dialogue: 0,1:01:51.29,1:01:53.36,Default,ZINA,0,0,0,,Tama lahat ng sinasabi ko.
Dialogue: 0,1:01:56.66,1:01:57.89,Default,ZINA,0,0,0,,Naiintindihan ko.
Dialogue: 0,1:02:06.07,1:02:08.57,Default,ZINA,0,0,0,,Kamahalan, hindi ka ba natatakot?
Dialogue: 0,1:02:09.07,1:02:10.21,Default,ZINA,0,0,0,,Huwag mag-alala.
Dialogue: 0,1:02:10.21,1:02:12.78,Default,ZINA,0,0,0,,Mga mananampalataya na minsan kong nakilala sa kalye,
Dialogue: 0,1:02:12.78,1:02:15.01,Default,ZINA,0,0,0,,bibiyayaan daw ako ng mga ninuno ko.
Dialogue: 0,1:02:15.58,1:02:17.11,Default,ZINA,0,0,0,,Kaya gagamitin ko ito ngayon.
Dialogue: 0,1:02:18.52,1:02:19.58,Default,ZINA,0,0,0,,Kamahalan,
Dialogue: 0,1:02:20.25,1:02:24.39,Default,ZINA,0,0,0,,ngayon higit pa sa ibang araw,\Kamukha mo ang reyna na kilala ko.
Dialogue: 0,1:02:28.49,1:02:30.13,Default,ZINA,0,0,0,,Hindi na kailangan ng ganoong mood.
Dialogue: 0,1:02:30.13,1:02:32.80,Default,ZINA,0,0,0,,Parang huling araw na lang.\NA at simula pa lang ito.
Dialogue: 0,1:02:33.53,1:02:35.03,Default,ZINA,0,0,0,,Tama ka, Kamahalan.
Dialogue: 0,1:02:45.01,1:02:46.81,Default,ZINA,0,0,0,,Magkita tayo sa gabi sa palasyo.
Dialogue: 0,1:02:47.84,1:02:50.41,Default,ZINA,0,0,0,,Siyempre. Oras na para pumunta.
Dialogue: 0,1:02:54.32,1:02:55.52,Default,ZINA,0,0,0,,Huwag mamatay.
Dialogue: 0,1:02:55.52,1:02:57.49,Default,ZINA,0,0,0,,Ano ang napakaganda sa buhay?
Dialogue: 0,1:02:57.49,1:03:01.16,Default,ZINA,0,0,0,,Kahit malungkot at nakakaawa ang buhay natin, mabuhay pa tayo.
Dialogue: 0,1:03:03.49,1:03:04.96,Default,ZINA,0,0,0,,Kung maayos na ang lahat,
Dialogue: 0,1:03:04.96,1:03:08.50,Default,ZINA,0,0,0,,Ako ay "boboto" para sa iyo, o anuman, \Nin lugar ng hari.
Dialogue: 0,1:03:10.80,1:03:11.90,Default,ZINA,0,0,0,,Salamat.
Dialogue: 0,1:03:16.11,1:03:17.24,Default,ZINA,0,0,0,,Well, pupunta tayo?
Dialogue: 0,1:03:17.97,1:03:19.58,Default,ZINA,0,0,0,,Oras na para umuwi.
Dialogue: 0,1:03:21.48,1:03:22.98,Default,ZINA,0,0,0,,Kriminal na si Lee Kyung-eun
Dialogue: 0,1:03:22.98,1:03:25.55,Default,ZINA,0,0,0,,itinago ang pagkakakilanlan ng mga traydor, ang mga tagasunod ng donghak.
Dialogue: 0,1:03:25.82,1:03:26.92,Default,ZINA,0,0,0,,Aalisan siya ng posisyon
Dialogue: 0,1:03:26.92,1:03:28.62,Default,ZINA,0,0,0,,at ipinadala sa link.
Dialogue: 0,1:03:29.25,1:03:30.89,Default,ZINA,0,0,0,,Kriminal Hong Duil
Dialogue: 0,1:03:30.89,1:03:32.72,Default,ZINA,0,0,0,,nawalan ng baril.
Dialogue: 0,1:03:32.72,1:03:34.22,Default,ZINA,0,0,0,,Magtatrabaho siya sa opisina
Dialogue: 0,1:03:34.22,1:03:36.63,Default,ZINA,0,0,0,,Ganghwado sa loob ng 600 araw bilang alipin ng estado.
Dialogue: 0,1:03:39.30,1:03:40.86,Default,ZINA,0,0,0,,Pagkatapos ng seremonya ng pag-akyat
Dialogue: 0,1:03:40.86,1:03:42.60,Default,ZINA,0,0,0,,Agad kong isasagawa ang pangungusap.
Dialogue: 0,1:03:50.17,1:03:53.18,Default,ZINA,0,0,0,,Walang mga tagumpay na \Nattribute kahit ano sa kasalukuyang hari.
Dialogue: 0,1:03:53.18,1:03:55.28,Default,ZINA,0,0,0,,Nahirapan kami.
Dialogue: 0,1:03:59.35,1:04:01.02,Default,ZINA,0,0,0,,Hindi pa tapos ang libing ng hari.
Dialogue: 0,1:04:01.02,1:04:03.45,Default,ZINA,0,0,0,,Angkop bang ngumiti hanggang ngipin?
Dialogue: 0,1:04:05.69,1:04:06.99,Default,ZINA,0,0,0,,Paumanhin.
Dialogue: 0,1:04:09.23,1:04:12.10,Default,ZINA,0,0,0,,Paano pupunta ang seremonya, magkakaroon ba ng anumang mga problema -
Dialogue: 0,1:04:12.53,1:04:14.16,Default,ZINA,0,0,0,,depende sa iyo ang lahat.
Dialogue: 0,1:04:14.63,1:04:17.63,Default,ZINA,0,0,0,,Oo! Gagawin ko talaga ang tungkulin ko
Dialogue: 0,1:04:17.63,1:04:20.07,Default,ZINA,0,0,0,,upang ang kawalan ng Ministro ng Digmaan ay hindi makakaapekto sa anuman.
Dialogue: 0,1:04:20.34,1:04:22.71,Default,ZINA,0,0,0,,Nga pala,
Dialogue: 0,1:04:23.37,1:04:28.04,Default,ZINA,0,0,0,,kailan babalik si Kim Byungin sa palasyo?
Dialogue: 0,1:04:29.58,1:04:32.32,Default,ZINA,0,0,0,,Palagay ko gusto mong malaman ang kapalaran ng sulat.
Dialogue: 0,1:04:33.35,1:04:35.32,Default,ZINA,0,0,0,,Nag-aalala ang lahat tungkol dito.
Dialogue: 0,1:04:35.32,1:04:38.02,Default,ZINA,0,0,0,,Huwag mag-alala. Ako na ang bahala sa lahat.
Dialogue: 0,1:04:38.29,1:04:40.66,Default,ZINA,0,0,0,,Oo, oo.
Dialogue: 0,1:04:42.19,1:04:44.59,Default,ZINA,0,0,0,,Ngayon ang hari at ang Phunyang clan ng Cho
Dialogue: 0,1:04:46.20,1:04:48.13,Default,ZINA,0,0,0,,ay magiging mga puppet ko.
Dialogue: 0,1:05:05.45,1:05:07.48,Default,ZINA,0,0,0,,Sir, doble ang iyak ko sa palasyo.
Dialogue: 0,1:05:09.25,1:05:10.35,Default,ZINA,0,0,0,,Doble.
Dialogue: 0,1:05:24.93,1:05:27.60,Default,ZINA,0,0,0,,Hoy, mabubuting tao kami.
Dialogue: 0,1:05:28.97,1:05:32.01,Default,ZINA,0,0,0,,Ngunit kung ang Chief Inspector o sinuman ay makakita ng anumang kahina-hinala,
Dialogue: 0,1:05:33.24,1:05:35.75,Default,ZINA,0,0,0,,maari talaga tayong maging masama.
Dialogue: 0,1:05:37.08,1:05:39.22,Default,ZINA,0,0,0,,Wala akong pakialam kung mabuti ang kalikasan ng tao o hindi.
Dialogue: 0,1:05:39.22,1:05:41.62,Default,ZINA,0,0,0,,Depende lahat sa ginagawa nila.
Dialogue: 0,1:05:43.39,1:05:45.39,Default,ZINA,0,0,0,,Maging mas natural, mas natural.
Dialogue: 0,1:05:45.49,1:05:46.59,Default,ZINA,0,0,0,,Halika.
Dialogue: 0,1:06:02.97,1:06:04.17,Default,ZINA,0,0,0,,Tara na.
Dialogue: 0,1:06:17.72,1:06:20.49,Default,ZINA,0,0,0,,Hindi komportable, gumalaw ng kaunti.
Dialogue: 0,1:06:22.66,1:06:23.73,Default,ZINA,0,0,0,,Ganito?
Dialogue: 0,1:06:24.06,1:06:25.46,Default,ZINA,0,0,0,,Siko ba ito?
Dialogue: 0,1:06:25.73,1:06:27.03,Default,ZINA,0,0,0,,Hare sundutin ako.
Dialogue: 0,1:06:27.56,1:06:30.00,Default,ZINA,0,0,0,,Kung idiin mo ang tiyan ko ng ganyan...
Dialogue: 0,1:06:30.70,1:06:32.37,Default,ZINA,0,0,0,,Wow.
Dialogue: 0,1:06:37.71,1:06:38.74,Default,ZINA,0,0,0,,Move over.
Dialogue: 0,1:06:41.81,1:06:43.01,Default,ZINA,0,0,0,,Oh.
Dialogue: 0,1:06:45.05,1:06:46.48,Default,ZINA,0,0,0,,Sa wakas may nakita ako.
Dialogue: 0,1:06:54.52,1:06:55.76,Default,ZINA,0,0,0,,Dito...
Dialogue: 0,1:07:00.40,1:07:01.50,Default,ZINA,0,0,0,,Walang oras para dito.
Dialogue: 0,1:07:02.17,1:07:04.30,Default,ZINA,0,0,0,,Tama ka, kailangan mong pagsamahin ang iyong sarili.
Dialogue: 0,1:07:05.17,1:07:07.44,Default,ZINA,0,0,0,,Buti hindi ako nagtago dito kasama ang ilang bantay.
Dialogue: 0,1:07:08.24,1:07:09.61,Default,ZINA,0,0,0,,Bakit mo ito pinag-uusapan?
Dialogue: 0,1:07:09.71,1:07:13.81,Default,ZINA,0,0,0,,Ilipat ng kaunti, babaguhin ko ang posisyon ko.
Dialogue: 0,1:07:18.45,1:07:19.58,Default,ZINA,0,0,0,,Mommies.
Dialogue: 0,1:07:27.72,1:07:30.66,Default,ZINA,0,0,0,,Ngayon kumportable na ako.
Dialogue: 0,1:07:32.26,1:07:34.96,Default,ZINA,0,0,0,,Sumasang-ayon ako, ang pose na ito ay ang pinakamahusay.
Dialogue: 0,1:07:45.17,1:07:47.14,Default,ZINA,0,0,0,,Mahuhuli tayo dahil sa dagundong ng iyong puso.
Dialogue: 0,1:07:47.44,1:07:48.95,Default,ZINA,0,0,0,,Bakit ka natatakot?
Dialogue: 0,1:07:50.18,1:07:52.01,Default,ZINA,0,0,0,,Hindi lang ito ang puso ko.
Dialogue: 0,1:08:02.43,1:08:05.03,Default,ZINA,0,0,0,,At hindi lang dahil sa takot.
Dialogue: 0,1:08:07.03,1:08:08.87,Default,ZINA,0,0,0,,Dahil din ito sa iyo, aking reyna.
Dialogue: 0,1:08:14.07,1:08:17.51,Default,ZINA,0,0,0,,Hindi rin sa takot para sa akin.
Dialogue: 0,1:08:43.53,1:08:45.37,Default,ZINA,0,0,0,,Ito ay mula sa England.
Dialogue: 0,1:08:45.37,1:08:47.10,Default,ZINA,0,0,0,,Higit na mas malakas at mas mabilis.
Dialogue: 0,1:08:51.44,1:08:54.34,Default,ZINA,0,0,0,,Kung lumitaw ang hari sa palasyo,
Dialogue: 0,1:08:55.41,1:08:57.51,Default,ZINA,0,0,0,,layunin ang kanyang puso.
Dialogue: 0,1:09:19.47,1:09:20.84,Default,ZINA,0,0,0,,Bago, o ano?
Dialogue: 0,1:09:22.00,1:09:23.54,Default,ZINA,0,0,0,,Oo.
Dialogue: 0,1:09:25.14,1:09:26.51,Default,ZINA,0,0,0,,Pumasok ka na.
Dialogue: 0,1:09:46.20,1:09:47.53,Default,ZINA,0,0,0,,Stop.
Dialogue: 0,1:09:58.61,1:09:59.88,Default,ZINA,0,0,0,,-Search.\N-Oo!
Dialogue: 0,1:10:16.69,1:10:18.13,Default,ZINA,0,0,0,,Walang kahina-hinala.
Dialogue: 0,1:10:49.03,1:10:53.30,Default,ZINA,0,0,0,,Paano ako naging reyna
Dialogue: 0,1:11:13.32,1:11:17.19,Default,ZINA,0,0,0,,Pagkatapos ng seremonya,\NI ay tatapusin silang lahat.
Dialogue: 0,1:11:17.19,1:11:20.26,Default,ZINA,0,0,0,,Ang parehong pakiramdam tulad ng bago ang hitsura ng pangunahing boss sa mga laro.
Dialogue: 0,1:11:20.26,1:11:21.89,Default,ZINA,0,0,0,,Magaling ako sa kutsilyo.
Dialogue: 0,1:11:22.73,1:11:25.43,Default,ZINA,0,0,0,,Baliw ako. \Nmula sa mga salita tungkol sa isang espesyal na gawain
Dialogue: 0,1:11:25.49,1:11:26.80,Default,ZINA,0,0,0,,kumulo ang puso ko.
Dialogue: 0,1:11:26.80,1:11:29.90,Default,ZINA,0,0,0,,Nagsimula na ang mga pagbabagong kinatatakutan mo.
Dialogue: 0,1:11:29.90,1:11:32.17,Default,ZINA,0,0,0,,Anong kalokohan ang ginagawa mo?
Dialogue: 0,1:11:32.20,1:11:34.04,Default,ZINA,0,0,0,,Kakampi ba ng hari ang mga tagasunod ng donghak?
Dialogue: 0,1:11:34.04,1:11:36.81,Default,ZINA,0,0,0,,Kamag-anak ako ng mga pinatay mo.
Dialogue: 0,1:11:36.81,1:11:41.51,Default,ZINA,0,0,0,,Ako ang hari ng mga taong pinabayaan mo!
Dialogue: 0,0:26:44.53,0:26:46.53,Default,,0,0,0,,


