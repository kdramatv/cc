Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Hos, Nanas, Kepada
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.22,0:01:06.28,Lalai,Lily1,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.28,0:01:08.51, Lalai, Lilia1,0,0,0,,dan peristiwa yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:14.05,0:01:16.85, Lalai, Lily1,0,0,0,,Saya banyak berhutang dengan awak.
Dialog: 0,0:01:19.92,0:01:21.93,Lalai,Lily1,0,0,0,,Saya sedang memikirkan tentang awak,
Dialog: 0,0:01:23.73,0:01:25.60, Lalai, Lilia1,0,0,0,,apabila dia cuba meninggalkan istana.
Dialog: 0,0:01:28.97,0:01:31.00, Lalai, Lilia1,0,0,0,,Saya fikir saya tidak akan berjumpa dengan awak lagi.
Dialog: 0,0:01:58.33,0:02:00.60, Lalai, Lily1,0,0,0,,Sejam lebih awal
Dialog: 0,0:02:06.34,0:02:08.64,Lalai,Lily1,0,0,0,,Kentang Lingkaran
Dialog: 0,0:02:10.57,0:02:15.41,Lalai,Lily1,0,0,0,,Adakah anda sedang tidur?
Dialog: 0,0:02:25.09,0:02:28.36,Lalai,Lily1,0,0,0,,Ya. Saya menulis ini.
Dialog: 0,0:02:30.13,0:02:32.40, Lalai, Lilia1,0,0,0,,Adakah anda sebenarnya menulis ini?
Dialog: 0,0:02:32.73,0:02:34.00, Lalai, Lily1,0,0,0,,Bukan permaisuri?
Dialog: 0,0:02:34.16,0:02:37.63,Lalai,Lily1,0,0,0,,Permaisuri berada di pesta itu.
Dialog: 0,0:02:38.07,0:02:40.10,Lalai,Lily1,0,0,0,,Lalu mengapa anda memfailkan
Dialog: 0,0:02:40.10,0:02:42.91, Lalai, Lily1,0,0,0,,anggur liar, jarum pain dan pic?
Dialog: 0,0:02:43.34,0:02:47.14, Lalai, Lily1,0,0,0,,Ini hanya musim pic,
Dialog: 0,0:02:47.14,0:02:49.25,Lalai,Lily1,0,0,0,,musim anggur liar bermula,
Dialog: 0,0:02:49.25,0:02:51.35, Lalai, Lily1,0,0,0,, dan terdapat jarum pain sepanjang tahun.
Dialog: 0,0:02:51.75,0:02:52.82, Lalai, Lily1,0,0,0,,Manbok.
Dialog: 0,0:02:53.98,0:02:55.69, Lalai, Lily1,0,0,0,, Pandang mata saya dan beritahu saya.
Dialog: 0,0:03:10.00,0:03:14.34,Lalai,Lily1,0,0,0,,Permaisuri tidak mahu anda tahu bahawa dia membantu anda.
Dialog: 0,0:03:20.24,0:03:22.91, Lalai, Lily1,0,0,0,,Sudah terlambat. Esok balik sini.
Dialog: 0,0:03:25.78,0:03:27.25,Lalai,Lily1,0,0,0,,Kembali kepada diri sendiri.
Dialog: 0,0:03:27.95,0:03:30.85,Lalai,Lily1,0,0,0,,Saya akan mengetahui sebab dia membantu saya
Dialog: 0,0:03:31.79,0:03:33.59,Lalai,Lilia1,0,0,0,,dan apakah maksud kata-katanya bahawa dia akan mengkhianati saya.
Dialog: 0,0:03:42.40,0:03:44.67,Lalai,Lily1,0,0,0,,Ratu
Dialog: 0,0:04:06.86,0:04:09.09, Lalai, Lily1,0,0,0,, Permaisuri berada dalam bahaya.
Dialog: 0,0:04:17.57,0:04:20.20,Lalai,Lily1,0,0,0,,Apabila subuh, saya akan memberitahu raja.
Dialog: 0,0:04:20.50,0:04:21.67,Lalai,Lily1,0,0,0,,Adakah dia akan baik-baik saja?
Dialog: 0,0:04:21.81,0:04:24.41, Lalai, Lily1,0,0,0,, Luangkan masa anda. Ini boleh menjadi perangkap.
Dialog: 0,0:04:41.16,0:04:44.29,Lalai,Lily1,0,0,0,,Kadangkala anda tidur seperti bayi.
Dialog: 0,0:04:46.93,0:04:49.13, Lalai, Lily1,0,0,0,,Saya rasa saya tertidur.
Dialog: 0,0:04:53.64,0:04:56.27,Lalai,Lily1,0,0,0,,Adakah anda menjaga saya?
Dialog: 0,0:04:59.01,0:05:01.24, Lalai, Lily1,0,0,0,,Mengapa anda selalu melakukan ini?
Dialog: 0,0:05:02.78,0:05:06.42,Lalai,Lily1,0,0,0,,Membimbangkan saya, cuba memahami saya.
Dialog: 0,0:05:07.85,0:05:12.69,Lalai,Lily1,0,0,0,,Kalau difikirkan semula, awaklah orang pertama yang saya nampak semasa saya datang ke sini.
Dialog: 0,0:05:18.40,0:05:21.06,Lalai,Lily1,0,0,0,,Saya berhutang banyak dengan awak.
Dialog: 0,0:05:24.33,0:05:26.24,Lalai,Lily1,0,0,0,,Saya sedang memikirkan tentang awak,
Dialog: 0,0:05:28.04,0:05:29.87, Lalai, Lily1,0,0,0,, apabila dia cuba meninggalkan istana.
Dialog: 0,0:05:30.94,0:05:32.94,Lalai,Lily1,0,0,0,,Saya fikir saya tidak akan berjumpa dengan awak lagi.
Dialog: 0,0:06:42.05,0:06:44.21, Lalai, Lily1,0,0,0,,Hon Young.
Dialog: 0,0:06:47.68,0:06:50.12,Lalai,Lily1,0,0,0,,Nampaknya anda banyak berlatih.
Dialog: 0,0:06:50.55,0:06:52.09, Lalai, Lily1,0,0,0,,Sangat bersemangat.
Dialog: 0,0:07:06.97,0:07:08.14, Lalai, Lily1,0,0,0,,Ini adalah mimpi.
Dialog: 0,0:07:08.31,0:07:09.71,Lalai,Lily1,0,0,0,,Hong Young bertukar menjadi dia
Dialog: 0,0:07:09.71,0:07:11.31, Lalai, Lily1,0,0,0,,kali terakhir dalam mimpi saya.
Dialog: 0,0:07:13.41,0:07:14.78,Lalai,Lily1,0,0,0,,Adakah anda terjaga?
Dialog: 0,0:07:27.46,0:07:29.39,Lalai,Lily1,0,0,0,,Apa itu? awak buat apa?
Dialog: 0,0:07:29.39,0:07:33.73,Lalai,Lily1,0,0,0,,Apa yang berlaku? Siapa yang menyinggung perasaan permaisuri saya?
Dialog: 0,0:07:34.56,0:07:36.73,Lalai,Lily1,0,0,0,,Anda. awak menyinggung perasaan saya.
Dialog: 0,0:07:39.37,0:07:41.30,Lalai,Lily1,0,0,0,,Mengapa wajahnya digantikan dengan wajah anda?
Dialog: 0,0:07:41.84,0:07:42.84,Lalai,Lily1,0,0,0,,Apa?
Dialog: 0,0:07:44.01,0:07:45.11,Lalai,Lily1,0,0,0,,Jujurlah dengan saya.
Dialog: 0,0:07:45.38,0:07:47.48,Lalai,Lily1,0,0,0,,Apa yang berlaku antara kami pada waktu malam?
Dialog: 0,0:07:47.84,0:07:49.71,Lalai,Lily1,0,0,0,,Sejauh manakah saya harus bersikap jujur?
Dialog: 0,0:07:49.71,0:07:52.12,Lalai,Lily1,0,0,0,,Ceritakan segala-galanya, jangan tinggalkan apa-apa.
Dialog: 0,0:07:55.45,0:07:58.15,Lalai,Lily1,0,0,0,,Tuhan. Ini adalah permintaan yang pelik.
Dialog: 0,0:08:00.06,0:08:01.42,Lalai,Lily1,0,0,0,,Jika itu yang anda mahu...
Dialog: 0,0:08:04.53,0:08:07.66,Lalai,Lily1,0,0,0,,Apabila bulan menerangi langit yang gelap malam tadi,
Dialog: 0,0:08:07.66,0:08:10.83,Lalai,Lily1,0,0,0,,tangan kami bersentuhan sedikit, kemudian bunga api...
Dialog: 0,0:08:10.83,0:08:13.60, Lalai, Lily1,0,0,0,, Diam. Jika anda berkata apa-apa, saya akan membunuh anda.
Dialog: 0,0:08:13.60,0:08:14.67,Lalai,Lily1,0,0,0,,Tetapi...
Dialog: 0,0:08:15.67,0:08:17.67, Lalai, Lily1,0,0,0,,Ini baru permulaan, permaisuriku.
Dialog: 0,0:08:19.34,0:08:20.48, Lalai, Lily1,0,0,0,, Permaisuriku.
Dialog: 0,0:08:21.28,0:08:22.48,Lalai,Lily1,0,0,0,,Tuhan.
Dialog: 0,0:08:26.88,0:08:27.98,Lalai,Lily1,0,0,0,,Perasaan,
Dialog: 0,0:08:28.95,0:08:31.92,Lalai,Lily1,0,0,0,,seolah-olah saya ditinggalkan.
Dialog: 0,0:08:32.39,0:08:33.86,Lalai,Lily1,0,0,0,,Ya Tuhanku.
Dialog: 0,0:08:35.26,0:08:36.29,Lalai,Lily1,0,0,0,,Ketua Kasim.
Dialog: 0,0:08:36.29,0:08:38.70, Lalai, Lily1,0,0,0,,Hon Young. Hong Young.
Dialog: 0,0:08:39.60,0:08:40.86,Lalai,Lily1,0,0,0,,Di manakah anda tidur hari ini?
Dialog: 0,0:08:41.36,0:08:42.83,Lalai,Lily1,0,0,0,,Di rumah, Tuanku.
Dialog: 0,0:08:44.90,0:08:47.07,Lalai,Lily1,0,0,0,,Cheoljong dan saya benar-benar...
Dialog: 0,0:09:12.33,0:09:15.37, Lalai, Lily1,0,0,0,,14 episod. Wanita yang mesti mati untuk hidup
Dialog: 0,0:09:24.21,0:09:26.04, Lalai, Lily1,0,0,0,,Itu semua mimpi.
Dialog: 0,0:09:27.38,0:09:29.58,Lalai,Lily1,0,0,0,,Potret mendiang raja terbakar,
Dialog: 0,0:09:29.81,0:09:31.88, Lalai, Lily1,0,0,0,, dan semuanya kelihatan begitu nyata.
Dialog: 0,0:09:33.05,0:09:34.98,Lalai,Lily1,0,0,0,,Selepas apa yang berlaku dengan tukang tilik,
Dialog: 0,0:09:34.98,0:09:36.92,Lalai,Lily1,0,0,0,,Saya tidak dapat meramalkan nasib saya.
Dialog: 0,0:09:40.86,0:09:42.03, Lalai, Lily1,0,0,0,,Firasat yang tidak menyenangkan.
Dialog: 0,0:09:42.63,0:09:45.56,Lalai,Lily1,0,0,0,,Court lady Khan. Saya perlu meramalkan nasib.
Dialog: 0,0:09:46.46,0:09:49.07,Lalai,Lily1,0,0,0,,Yang Mulia. Ini akan menyusahkan anda lagi.
Dialog: 0,0:09:49.43,0:09:51.20,Lalai,Lily1,0,0,0,,Saya kenal seorang sami.
Dialog: 0,0:09:52.60,0:09:55.34, Lalai, Lily1,0,0,0,,Ia tidak akan kelihatan mencurigakan.
Dialog: 0,0:10:00.18,0:10:04.95, Lalai, Lily1,0,0,0,,Apabila Avalokitesvara mengamalkan Prajnaparamita yang mendalam,
Dialog: 0,0:10:04.95,0:10:08.05, Lalai, Lily1,0,0,0,,dia menerangi lima skandha dan melihat semuanya kosong...
Dialog: 0,0:10:12.22,0:10:13.32,Lalai,Lily1,0,0,0,,Apa yang anda nampak?
Dialog: 0,0:10:13.32,0:10:16.79,Lalai,Lily1,0,0,0,,Saya melihat bahawa istana dipenuhi dengan darah merah.
Dialog: 0,0:10:17.49,0:10:18.83, Lalai, Lily1,0,0,0,, Darah merah?
Dialog: 0,0:10:20.23,0:10:21.73,Lalai,Lily1,0,0,0,,Hari ini seseorang
Dialog: 0,0:10:22.53,0:10:24.17,Lalai,Lily1,0,0,0,,akan mati di istana.
Dialog: 0,0:10:26.50,0:10:27.97,Lalai,Lily1,0,0,0,,Dan siapa?
Dialog: 0,0:10:28.44,0:10:30.61, Lalai, Lily1,0,0,0,,Saya tidak tahu siapa itu,
Dialog: 0,0:10:38.48,0:10:39.75,Lalai,Lily1,0,0,0,,tetapi ia adalah seorang wanita.
Dialog: 0,0:10:40.25,0:10:41.35,Lalai,Lily1,0,0,0,,Wanita?
Dialog: 0,0:10:43.55,0:10:45.16,Lalai,Lily1,0,0,0,,Sungguh
Dialog: 0,0:10:46.26,0:10:47.76, Lalai, Lily1,0,0,0,, adakah saya?
Dialog: 0,0:10:47.92,0:10:51.09,Lalai,Lily1,0,0,0,,Lukiskan saya azimat untuk perlindungan.
Dialog: 0,0:10:51.09,0:10:53.80,Lalai,Lily1,0,0,0,,Saya bukan bomoh.
Dialog: 0,0:10:54.13,0:10:56.20,Lalai,Lily1,0,0,0,,Mesti ada jalannya.
Dialog: 0,0:10:56.87,0:10:58.23,Lalai,Lily1,0,0,0,,Jika anda berkeras,
Dialog: 0,0:10:59.00,0:11:01.30, Lalai, Lily1,0,0,0,,membuat persembahan kepada Buddha.
Dialog: 0,0:11:02.44,0:11:05.14,Lalai,Lily1,0,0,0,,Tepat sekali. Saya akan memberi anda seberapa banyak yang anda mahu.
Dialog: 0,0:11:07.08,0:11:09.78,Lalai,Lily1,0,0,0,,Orang yang mati di istana,
Dialog: 0,0:11:10.11,0:11:12.45, Lalai, Lily1,0,0,0,,bukan saya.
Dialog: 0,0:11:15.72,0:11:16.79,Lalai,Lily1,0,0,0,,Sial!
Dialog: 0,0:11:18.45,0:11:21.06,Lalai,Lily1,0,0,0,,Saya tidak bertanya kepada ratu soalan yang saya mahukan.
Dialog: 0,0:11:22.09,0:11:23.09,Lalai,Lily1,0,0,0,,Tuhan.
Dialog: 0,0:11:23.39,0:11:25.03,Lalai,Lily1,0,0,0,,Saya akan kembali ke Daejeon.
Dialog: 0,0:11:25.53,0:11:26.56,Lalai,Lily1,0,0,0,,Yang Mulia.
Dialog: 0,0:11:30.13,0:11:31.67, Lalai, Lily1,0,0,0,, Mencurigakan.
Dialog: 0,0:11:32.94,0:11:35.14,Lalai,Lily1,0,0,0,,Memandangkan betapa tiba-tiba dia menghilang.
Dialog: 0,0:11:41.04,0:11:42.18,Lalai,Lily1,0,0,0,,Betul.
Dialog: 0,0:11:42.51,0:11:44.75,Lalai,Lily1,0,0,0,,Saya boleh melukisnya sendiri.
Dialog: 0,0:11:53.39,0:11:54.62,Lalai,Lily1,0,0,0,,Yang ini akan berjaya.
Dialog: 0,0:12:00.50,0:12:02.27,Lalai,Lily1,0,0,0,,Betul. Macam ni.
Dialog: 0,0:12:03.13,0:12:05.67,Lalai,Lily1,0,0,0,,Saya nampak dengan jelas. Macam ni.
Dialog: 0,0:12:07.84,0:12:09.64,Lalai,Lily1,0,0,0,,Tidak! salah!
Dialog: 0,0:12:12.01,0:12:13.34,Lalai,Lily1,0,0,0,,Wajahnya...
Dialog: 0,0:12:17.38,0:12:18.88,Lalai,Lily1,0,0,0,,Ini muka dia.
Dialog: 0,0:12:21.75,0:12:23.42,Lalai,Lily1,0,0,0,,Hon!
Dialog: 0,0:12:29.73,0:12:31.79,Lalai,Lily1,0,0,0,,Adakah anda menangis sepanjang jalan?
Dialog: 0,0:12:34.33,0:12:37.07,Lalai,Lily1,0,0,0,,Nah. Nah.
Dialog: 0,0:12:37.07,0:12:38.90,Lalai,Lily1,0,0,0,,Nah. Nah.
Dialog: 0,0:12:40.57,0:12:43.17,Lalai,Lily1,0,0,0,,Mengapa saya tidak terfikir bahawa dia mungkin tidak menyukai saya?
Dialog: 0,0:12:43.77,0:12:47.91,Lalai,Lily1,0,0,0,,Mengapa saya berfikir selama beberapa hari,
Dialog: 0,0:12:48.08,0:12:50.55,Lalai,Lily1,0,0,0,,pilih cinta atau keluarga?
Dialog: 0,0:12:51.21,0:12:53.82,Lalai,Lily1,0,0,0,,Halangan terbesar dalam cinta ialah
Dialog: 0,0:12:53.82,0:12:56.02,Lalai,Lily1,0,0,0,,ini tidak lebih daripada
Dialog: 0,0:12:56.02,0:12:58.29,Lalai,Lily1,0,0,0,,memenangi hati orang yang anda sayang.
Dialog: 0,0:12:59.46,0:13:01.06,Lalai,Lily1,0,0,0,,Apakah sebabnya?
Dialog: 0,0:13:01.56,0:13:02.73,Lalai,Lily1,0,0,0,,Dia berkata:
Dialog: 0,0:13:03.56,0:13:04.99,Lalai,Lily1,0,0,0,,Saya tidak suka awak.
Dialog: 0,0:13:05.83,0:13:06.90,Lalai,Lily1,0,0,0,,Apa?
Dialog: 0,0:13:07.80,0:13:08.80,Lalai,Lily1,0,0,0,,Selamat tinggal.
Dialog: 0,0:13:10.57,0:13:11.70,Lalai,Lily1,0,0,0,,Tunggu.
Dialog: 0,0:13:12.77,0:13:15.34,Lalai,Lily1,0,0,0,,Beritahu sebabnya.
Dialog: 0,0:13:15.87,0:13:17.31,Lalai,Lily1,0,0,0,,Kenapa awak tidak suka saya?
Dialog: 0,0:13:21.81,0:13:22.98,Lalai,Lily1,0,0,0,,I
Dialog: 0,0:13:24.31,0:13:26.28,Lalai,Lily1,0,0,0,,Saya tidak suka lelaki yang bercita-cita tinggi.
Dialog: 0,0:13:28.28,0:13:30.65, Lalai,Spillik2,0,0,0,,Diam, diam.
Dialog: 0,0:13:32.92,0:13:35.19,Lalai,Spikyulka2,0,0,0,,Inilah kelembapannya.
Dialog: 0,0:13:35.89,0:13:39.46,Lalai,Spikyulka2,0,0,0,,Cinta bermula dengan kelembapan
Dialog: 0,0:13:39.46,0:13:42.03, Lalai, Spikyulka2,0,0,0, dan ia berakhir dengan kelembapan sedemikian.
Dialog: 0,0:13:44.93,0:13:46.64,Lalai,Spikyulka2,0,0,0,,-Tetapi...\N-Sial, saya takutkan awak.
Dialog: 0,0:13:46.67,0:13:48.20,Lalai,Spikyulka2,0,0,0,,Ada berita baik.
Dialog: 0,0:13:48.20,0:13:50.11,Lalai,Spillik2,0,0,0,,Raja berasa lebih baik,
Dialog: 0,0:13:51.21,0:13:52.71,Lalai,Spikyulka2,0,0,0,,doa saya dimakbulkan.
Dialog: 0,0:13:54.08,0:13:56.08,Lalai,Spikyulka2,0,0,0,,Saya pasti anda pernah mendengar sesuatu yang lain.
Dialog: 0,0:13:58.25,0:14:01.72,Lalai,Spikyulka2,0,0,0,,Kim Jwageun akan diturunkan pangkat kerana insiden ini.
Dialog: 0,0:14:02.49,0:14:05.76,Lalai,Spillik2,0,0,0,,Saya suka raja, dan saya menghormati Kim Jwageun.
Dialog: 0,0:14:06.22,0:14:08.56,Lalai,Spillik2,0,0,0,,Hati saya hancur berkeping-keping.
Dialog: 0,0:14:08.69,0:14:11.89,Lalai,Spikyulka2,0,0,0,,Bagaimana anda boleh mencintai raja, kerana anda tidak mengenalinya secara peribadi.
Dialog: 0,0:14:13.40,0:14:15.67,Lalai,Spillik2,0,0,0,,Lagipun, dia kawan baik anda.
Dialog: 0,0:14:15.80,0:14:17.60,Lalai,Spillik2,0,0,0,,Anda seorang yang baik,
Dialog: 0,0:14:17.60,0:14:19.60,Lalai,Spikyulka2,0,0,0,,jadi rakan anda sepatutnya begitu.
Dialog: 0,0:14:21.40,0:14:22.67,Lalai,Spikyulka2,0,0,0,,Nah, anda telah menyelesaikannya.
Dialog: 0,0:14:29.21,0:14:30.75,Lalai,Spillik2,0,0,0,,Adakah anda melukis sotong?
Dialog: 0,0:14:30.88,0:14:33.55,Lalai,Spikyulka2,0,0,0,,Apakah maksud “sotong”? Ini adalah seorang lelaki.
Dialog: 0,0:14:35.05,0:14:36.15, Lalai,Spillik2,0,0,0,,Ini?
Dialog: 0,0:14:36.72,0:14:39.02,Lalai,Spikyulka2,0,0,0,,Saya melukisnya dengan baik, jika anda melihat dengan teliti butirannya.
Dialog: 0,0:14:40.89,0:14:43.16,Lalai,Spillik2,0,0,0,,-Ini mesti mata.\N-Ini mulut.
Dialog: 0,0:14:45.46,0:14:48.00,Lalai,Sutera2,0,0,0,,-Adakah itu mulutnya?\N-Nampak tak bibirnya?
Dialog: 0,0:14:53.87,0:14:56.94,Lalai,Spikyulka2,0,0,0,,Ramalan sebaiknya dibaca pada waktu pagi.
Dialog: 0,0:14:59.41,0:15:01.81,Lalai,Spillik2,0,0,0,,Ibu Permaisuri, Yang Amat Mulia ada di sini.
Dialog: 0,0:15:06.18,0:15:07.25,Lalai,Spillik2,0,0,0,,Tuhan.
Dialog: 0,0:15:07.85,0:15:11.99,Lalai,Spilyk2,0,0,0,,Anda tiada muka.
Dialog: 0,0:15:12.79,0:15:16.93,Lalai,Spillik2,0,0,0,,Seolah-olah raja tidak bangun.
Dialog: 0,0:15:17.46,0:15:20.06,Lalai,Spikyulka2,0,0,0,,Bagaimana keadaan permaisuri?
Dialog: 0,0:15:21.06,0:15:23.23,Lalai,Spikyulka2,0,0,0,,Saya tidak nampak apa-apa faedah daripadanya lagi
Dialog: 0,0:15:23.80,0:15:25.70, Lalai, Spikyulka2,0,0,0,, dan melakukan apa yang anda minta.
Dialog: 0,0:15:26.54,0:15:29.21,Lalai,Spillit2,0,0,0,,Saya pasti item itu
Dialog: 0,0:15:29.21,0:15:31.34,Lalai,Spillie2,0,0,0,,terdapat di dalam biliknya.
Dialog: 0,0:15:31.71,0:15:35.71,Lalai,Spillik2,0,0,0,,Raja bermalam semalam di dalam kamar permaisuri.
Dialog: 0,0:15:35.95,0:15:37.98,Lalai,Spilyk2,0,0,0,,Segera, bagaimana anda pulih?
Dialog: 0,0:15:38.15,0:15:40.38,Lalai,Spikyulka2,0,0,0,,Disebabkan insiden letupan itu, saya sedar
Dialog: 0,0:15:41.52,0:15:44.65,Lalai,Spikyulka2,0,0,0,,jika saya kehilangannya, saya akan mati.
Dialog: 0,0:15:45.35,0:15:47.49,Lalai,Spillie2,0,0,0,,Wanita yang akan mati hari ini...
Dialog: 0,0:15:48.12,0:15:49.63,Lalai,Spillik2,0,0,0,,Betulkah?..
Dialog: 0,0:16:20.02,0:16:21.46,Lalai,Spillik2,0,0,0,,Saya mahu mati.
Dialog: 0,0:16:21.89,0:16:23.43, Lalai, Spillik2,0,0,0,, Patutkah saya bunuh diri?
Dialog: 0,0:16:23.63,0:16:25.50,Lalai,Spillik2,0,0,0,,Mungkin jika saya mati, saya akan berasa lebih baik?
Dialog: 0,0:16:33.17,0:16:35.81,Lalai,Spillik2,0,0,0,,Maaf, permaisuri, kasihanilah.
Dialog: 0,0:16:36.11,0:16:38.74,Lalai,Spilyk2,0,0,0,,Saya menafikan segala-galanya,
Dialog: 0,0:16:38.74,0:16:41.04,Lalai,Spikyulka2,0,0,0,,tetapi raja begitu yakin.
Dialog: 0,0:16:42.28,0:16:43.61,Lalai,Spillik2,0,0,0,,Apa? apa yang awak cakap ni?
Dialog: 0,0:16:45.05,0:16:46.18,Lalai,Spillik2,0,0,0,,Apa yang anda cakapkan?
Dialog: 0,0:16:47.18,0:16:49.39,Lalai,Spillik2,0,0,0,,Bolehkah anda menghidu bau terbakar?
Dialog: 0,0:16:49.55,0:16:52.52,Lalai,Spilyk2,0,0,0,,Tangan siapa yang mereka lakukan? Mana-mana antara kamu?
Dialog: 0,0:16:52.52,0:16:53.72,Lalai,Spikyulka2,0,0,0,,-Nak ke mana?\N-Biarkan saya pergi.
Dialog: 0,0:16:55.96,0:16:57.36,Lalai,Spillit2,0,0,0,,Puan Mahkamah Choi.
Dialog: 0,0:17:02.50,0:17:03.73,Lalai,Spilyk2,0,0,0,,Akhirnya
Dialog: 0,0:17:04.53,0:17:06.70,Lalai,Spilyk2,0,0,0,,Saya memberitahu dia segala-galanya.
Dialog: 0,0:17:10.01,0:17:11.07,Lalai,Spillik2,0,0,0,,Begitukah?
Dialog: 0,0:17:11.37,0:17:13.61,Lalai,Spikyulka2,0,0,0,,Biar saya jelaskan perkara ini.
Dialog: 0,0:17:13.61,0:17:16.01,Lalai,Sutera2,0,0,0,,Raja datang kepada saya semalam, bercakap dengan awak,
Dialog: 0,0:17:16.01,0:17:18.21, Lalai, Spikyulka2,0,0,0, dan oleh itu semua huru-hara ini. Jadi?
Dialog: 0,0:17:18.21,0:17:19.75, Lalai, Spikyulka2,0,0,0,,Saya tidak berkata apa-apa seperti itu.
Dialog: 0,0:17:21.38,0:17:23.79,Lalai,Spikyulka2,0,0,0,,Jadi saya jadi keliru
Dialog: 0,0:17:25.25,0:17:27.56,Lalai,Spillik2,0,0,0,,salah anda.
Dialog: 0,0:17:27.76,0:17:30.26,Lalai,Spillik2,0,0,0,,Apa? Mengapa anda keliru?
Dialog: 0,0:17:30.26,0:17:31.86,Lalai,Spillik2,0,0,0,,Anda!
Dialog: 0,0:17:34.20,0:17:35.67,Lalai,Spikyulka2,0,0,0,,Itu bagus.
Dialog: 0,0:17:36.80,0:17:38.20,Lalai,Spikyulka2,0,0,0,,Mungkin lebih baik daripada kali terakhir.
Dialog: 0,0:17:39.20,0:17:41.00,Lalai,Spillik2,0,0,0,,Inilah sebabnya saya menjadi gila!
Dialog: 0,0:17:41.87,0:17:44.31,Lalai,Spillik2,0,0,0,,Mengapa saya menyukainya? Ini tidak sepatutnya berlaku.
Dialog: 0,0:17:45.21,0:17:46.81,Lalai,Spilyk2,0,0,0,,Jadi jiwa tidak mengawal badan?
Dialog: 0,0:17:47.14,0:17:49.01,Lalai,Spikyulka2,0,0,0,,Jadi minda dan badan berada di luar kawalan kita?
Dialog: 0,0:17:49.01,0:17:51.08, Lalai, Spillik2,0,0,0,, Hormon menguasai segala-galanya?
Dialog: 0,0:17:52.55,0:17:54.32,Lalai,Spillik2,0,0,0,,-Mimpi ngeri.\N-Yang Mulia.
Dialog: 0,0:17:56.85,0:17:58.85,Lalai,Spikyulka2,0,0,0,,-Ada apa dengan dia?\N-Yang Mulia.
Dialog: 0,0:17:59.69,0:18:00.99,Lalai,Spikyulka2,0,0,0,,Apa yang anda cakapkan?
Dialog: 0,0:18:02.29,0:18:05.90,Lalai,Spillik2,0,0,0,,Dia berada dalam semangatnya sendiri.
Dialog: 0,0:18:08.90,0:18:10.80,Lalai,Spillik2,0,0,0,,Mengapa anda tidak berasa jijik?
Dialog: 0,0:18:11.33,0:18:13.00,Lalai,Spillik2,0,0,0,,Kenapa?
Dialog: 0,0:18:13.80,0:18:18.21,Lalai,Spillik2,0,0,0,,Rasa! Rasa meluat. Anda mesti membencinya!
Dialog: 0,0:18:18.21,0:18:20.34,Lalai,Sutera2,0,0,0,,Bersedia untuk menyambut Kebawah Duli Yang Maha Mulia.
Dialog: 0,0:18:26.72,0:18:28.08,Lalai,Spillik2,0,0,0,,Di mana permaisuri saya?
Dialog: 0,0:18:28.48,0:18:30.15,Lalai,Spillik2,0,0,0,,Yang Mulia, dia...
Dialog: 0,0:18:34.06,0:18:37.56,Lalai,Spillik2,0,0,0,,Maaf. Dia hanya di sini.
Dialog: 0,0:18:39.20,0:18:41.56,Lalai,Spillik2,0,0,0,,Adakah dia pergi sejauh ini untuk bersembunyi daripada saya?
Dialog: 0,0:18:41.83,0:18:43.93,Lalai,Spillik2,0,0,0,,Malam tadi macam harimau betina...
Dialog: 0,0:18:43.93,0:18:45.60,Lalai,Spillik2,0,0,0,,Rrrrr!
Dialog: 0,0:18:51.04,0:18:53.21,Lalai,Spillik2,0,0,0,,Bolehkah anda membantu saya mencari permaisuri?
Dialog: 0,0:18:53.64,0:18:54.74,Lalai,Spikyulka2,0,0,0,,Ya, Tuanku.
Dialog: 0,0:18:54.91,0:18:57.01,Lalai,Spikyulka2,0,0,0,,Seperti yang anda lihat, saya mempunyai banyak perkara untuk diberitahu kepadanya.
Dialog: 0,0:19:00.68,0:19:02.15,Lalai,Spilyk2,0,0,0,,Saya tertanya-tanya apa sebenarnya.
Dialog: 0,0:19:09.03,0:19:11.63, Lalai,Spillik2,0,0,0,,No. Jika saya berjumpa dengannya sekarang, saya akan menghadapi masalah yang mendalam.
Dialog: 0,0:19:12.06,0:19:13.96,Lalai,Spillik2,0,0,0,,Bagaimana jika badan saya mengkhianati saya lagi?
Dialog: 0,0:19:14.30,0:19:15.36,Lalai,Spillik2,0,0,0,,Tepat sekali.
Dialog: 0,0:19:15.36,0:19:18.47,Lalai,Spillik2,0,0,0,,Saya pasti roh Kim So-yeon menguasainya malam tadi.
Dialog: 0,0:19:20.10,0:19:23.04,Lalai,Spikyulka2,0,0,0,,Dan saya hanya menyukainya kerana saya fikir ia adalah Hong Young.
Dialog: 0,0:19:23.04,0:19:24.77,Lalai,Spikyulka2,0,0,0,,Kalaulah saya tahu itu dia...
Dialog: 0,0:19:28.18,0:19:29.31,Lalai,Spikyulka2,0,0,0,,Tetapi saya tetap menyukainya.
Dialog: 0,0:19:30.38,0:19:32.21,Lalai,Spillik2,0,0,0,,Saya pasti gila.
Dialog: 0,0:19:40.59,0:19:43.09,Lalai,Spillik2,0,0,0,,Bagaimana jika Jang Bong-hwan hilang selama-lamanya?
Dialog: 0,0:19:44.69,0:19:45.83,Lalai,Spillik2,0,0,0,,Bagaimana jika?
Dialog: 0,0:19:45.83,0:19:47.03,Lalai,Spillik2,0,0,0,,Saya tidak sepatutnya sampai ke sini.\NJang Bong-hwan
Dialog: 0,0:19:47.03,0:19:48.97,Lalai,Sutera2,0,0,0,,-Permaisuriku.\N-Yang Mulia!
Dialog: 0,0:19:49.43,0:19:50.67,Lalai,Spillik2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:19:50.67,0:19:51.70,Lalai,Spillik2,0,0,0,,Sial.
Dialog: 0,0:19:53.10,0:19:54.17,Lalai,Spilyk2,0,0,0,,Yang Mulia.
Dialog: 0,0:19:55.87,0:19:56.94,Lalai,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:19:58.14,0:20:00.18,Lalai,Spillik2,0,0,0,,-Yang Mulia.\N-Permaisuriku.
Dialog: 0,0:20:01.41,0:20:02.48, Lalai,Spillik2,0,0,0,,Permaisuriku.
Dialog: 0,0:20:04.41,0:20:06.72,Lalai,Spillik2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:20:13.62,0:20:14.62,Lalai,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:15.79,0:20:16.89,Lalai,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:17.93,0:20:20.00,Lalai,Sutera2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:20:22.06,0:20:23.07,Lalai,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:25.97,0:20:28.54,Lalai,Spikyulka2,0,0,0,,Kim Jwageun hampir kehilangan jawatannya,
Dialog: 0,0:20:28.54,0:20:30.97,Lalai,Sutera2,0,0,0,,lagipun, dia menyatakan dengan jelas bahawa dia cuba untuk menyingkirkan raja.
Dialog: 0,0:20:31.27,0:20:32.31,Lalai,Spillik2,0,0,0,,Luar biasa.
Dialog: 0,0:20:34.24,0:20:36.28,Lalai,Spilyk2,0,0,0,,Semakin lama saya memikirkannya,
Dialog: 0,0:20:36.28,0:20:38.28,Lalai,Spikyulka2,0,0,0,,semakin saya yakin bahawa ini bukan gayanya.
Dialog: 0,0:20:39.05,0:20:40.65,Lalai,Spikyulka2,0,0,0,,Pasti dia berasa terdorong ke satu sudut.
Dialog: 0,0:20:40.98,0:20:42.89,Lalai,Spikyulka2,0,0,0,,Kerana letupan itu
Dialog: 0,0:20:42.89,0:20:45.12,Lalai,Spikyulka2,0,0,0,,Kim Jwageun kehilangan segala-galanya.
Dialog: 0,0:20:45.65,0:20:47.99,Lalai,Spikyulka2,0,0,0,,Sebaliknya, raja hanya menang.
Dialog: 0,0:20:47.99,0:20:49.23,Lalai,Spilyk2,0,0,0,,Walaupun begitu,
Dialog: 0,0:20:49.23,0:20:52.29,Lalai,Spikyulka2,0,0,0,,Saya ragu bahawa raja sendiri yang menyebabkan letupan itu, mempertaruhkan nyawanya.
Dialog: 0,0:20:53.80,0:20:54.90,Lalai,Spillik2,0,0,0,,Dan memang benar.
Dialog: 0,0:20:57.57,0:20:59.97,Lalai,Spillik2,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:21:00.10,0:21:02.44, Lalai, Spikyulka2,0,0,0,,-Adakah anda pergi ke majlis?\N-Ya.
Dialog: 0,0:21:02.87,0:21:06.24,Default,Spilyk2,0,0,0,,Boleh saya tanya, kenapa awak keseorangan?
Dialog: 0,0:21:07.28,0:21:08.28,Lalai,Spillik2,0,0,0,,Permaisuriku...
Dialog: 0,0:21:08.38,0:21:09.45,Lalai,Spillik2,0,0,0,,-Ratu?\N-Ratu?
Dialog: 0,0:21:14.95,0:21:17.45,Lalai,Spikyulka2,0,0,0,,Tuanku, adakah anda bermain sorok-sorok?
Dialog: 0,0:21:17.82,0:21:20.16,Lalai,Spikyulka2,0,0,0,,-Saya memainkannya dengan hebat!\N-Diam.
Dialog: 0,0:21:28.20,0:21:29.27,Lalai,Spilyk2,0,0,0,,Ditemui.
Dialog: 0,0:21:29.27,0:21:31.57,Lalai,Spillie2,0,0,0,,Memarahkan. Berhenti mengintai saya!
Dialog: 0,0:21:31.57,0:21:33.44,Lalai,Spilyk2,0,0,0,,Adakah anda seorang paparazi? Atau penguntit?
Dialog: 0,0:21:33.44,0:21:34.97,Lalai,Spikyulka2,0,0,0,,-Faham.\N-Apa?
Dialog: 0,0:21:34.97,0:21:37.17,Lalai,Spillik2,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:21:37.17,0:21:39.24,Lalai,Spikyulka2,0,0,0,,-Jumpa anda di majlis diraja.\N-Baiklah.
Dialog: 0,0:21:39.44,0:21:41.74,Lalai,Spikyulka2,0,0,0,,Mari kita bincangkan semuanya dengan tenang.
Dialog: 0,0:21:41.74,0:21:42.78,Lalai,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:21:42.78,0:21:44.88,Lalai,Spillik2,0,0,0,,Mereka benar-benar gila dengan cinta.
Dialog: 0,0:21:44.88,0:21:46.88,Lalai,Spikyulka2,0,0,0,,-Permaisuriku!\N-Main sorok-sorok?
Dialog: 0,0:21:47.42,0:21:48.95,Lalai,Spillik2,0,0,0,,Seperti kanak-kanak kecil.
Dialog: 0,0:21:48.95,0:21:52.76,Lalai,Spillik2,0,0,0,,Apa? Main sorok-sorok bila
Dialog: 0,0:21:53.39,0:21:54.86,Lalai,Spikyulka2,0,0,0,,hampir mati baru-baru ini?
Dialog: 0,0:21:58.13,0:22:00.33,Lalai,Spillik2,0,0,0,,Tepat sekali. Ada gundik diraja.
Dialog: 0,0:22:00.46,0:22:02.20,Lalai,Spikyulka2,0,0,0,,Kami mengadakan surat-menyurat cinta sepanjang malam.
Dialog: 0,0:22:02.20,0:22:04.83,Lalai,Spillik2,0,0,0,,Mereka adalah malaikat penjaga orientasi seksual saya!
Dialog: 0,0:22:04.83,0:22:07.14,Lalai,Tolenka3,0,0,0,,Yang Mulia, kami mengalu-alukan kedatangan anda.
Dialog: 0,0:22:07.14,0:22:08.84,Lalai,Tolenka3,0,0,0,,Adakah anda sihat?
Dialog: 0,0:22:11.17,0:22:12.41,Lalai,Tolenka3,0,0,0,,Selamat hari.
Dialog: 0,0:22:15.51,0:22:16.51,Lalai,Tolenka3,0,0,0,,Permaisuriku.
Dialog: 0,0:22:17.35,0:22:19.11, Lalai, Tolenka3,0,0,0,, Anda tidak sepatutnya berlari di sekitar halaman.
Dialog: 0,0:22:19.78,0:22:22.59,Lalai,Tolenka3,0,0,0,,Nampaknya kedua-dua ini, kecuali satu sama lain, tidak memerlukan orang lain.
Dialog: 0,0:22:23.79,0:22:24.82,Lalai,Tolenka3,0,0,0,,Nampaknya begitu.
Dialog: 0,0:22:24.82,0:22:28.86,Lalai,Tolenka3,0,0,0,,Omong-omong, betapa cantiknya mereka.
Dialog: 0,0:22:35.06,0:22:37.77, Lalai, Tolenka3,0,0,0,, Cemerlang. Mari kita tulis kepada wanita,\Nand penyelewengan dalam orientasi tidak akan berlaku lagi.
Dialog: 0,0:22:39.27,0:22:41.24,Lalai,Tolenka3,0,0,0,,-Permaisuriku. \N-Yang Mulia.
Dialog: 0,0:22:42.97,0:22:43.97,Lalai,Tolenka3,0,0,0,,Permaisuriku.
Dialog: 0,0:23:05.86,0:23:07.13, Lalai, Tolenka3,0,0,0,,Dan dia tiada di sini.
Dialog: 0,0:23:08.50,0:23:12.33, Lalai, Tolenka3,0,0,0,,Saya bukan sekadar mengejarnya. Saya nak tanya awak sesuatu.
Dialog: 0,0:23:12.87,0:23:14.10,Lalai,Tolenka3,0,0,0,,Tanya?
Dialog: 0,0:23:14.10,0:23:16.44,Lalai,Tolenka3,0,0,0,,Tetapi dia kelihatan tidak selesa di sekeliling saya.
Dialog: 0,0:23:18.04,0:23:19.21,Lalai,Tolenka3,0,0,0,,Sudah tiba masanya untuk berhenti.
Dialog: 0,0:23:20.94,0:23:22.71,Lalai,Tolenka3,0,0,0,,Saya harap bila dia ada perasaan
Dialog: 0,0:23:24.45,0:23:26.42,Lalai,Tolenka3,0,0,0,, memutuskan, dia akan datang kepada saya sendiri.
Dialog: 0,0:23:34.26,0:23:36.53,Lalai,Tolenka3,0,0,0,, -Sudah tiba masanya untuk pergi ke bilik mesyuarat. \N-Ya.
Dialog: 0,0:23:40.63,0:23:41.76,Lalai,Tolenka3,0,0,0,,Di sini anda.
Dialog: 0,0:23:42.97,0:23:44.77,Lalai,Tolenka3,0,0,0,,Nampaknya anda berjalan mengelilingi seluruh istana hari ini.
Dialog: 0,0:23:44.77,0:23:46.27,Lalai,Tolenka3,0,0,0,,Saya telah mengejar awak sejak pagi.
Dialog: 0,0:23:46.90,0:23:48.10,Lalai,Tolenka3,0,0,0,,Apa yang berlaku?
Dialog: 0,0:23:51.51,0:23:54.11,Lalai,Tolenka3,0,0,0,,Di sini anda. malam tadi...
Dialog: 0,0:23:55.78,0:23:57.18,Lalai,Tolenka3,0,0,0,,Mari kita bincangkan segala-galanya di sepanjang jalan.
Dialog: 0,0:23:57.81,0:23:58.85,Lalai,Tolenka3,0,0,0,,Jom.
Dialog: 0,0:23:59.55,0:24:00.68,Lalai,Tolenka3,0,0,0,,Kita hendak ke mana?
Dialog: 0,0:24:01.68,0:24:02.82,Lalai,Tolenka3,0,0,0,,Bolehkah kita pergi ke suatu tempat lagi?
Dialog: 0,0:24:06.36,0:24:07.79,Lalai,Tolenka3,0,0,0,,Istana itu terlalu besar.
Dialog: 0,0:24:33.35,0:24:34.38, Lalai, Tolenka3,0,0,0,, Hilang?
Dialog: 0,0:24:37.42,0:24:39.39,Lalai,Tolenka3,0,0,0,,Apa yang dia nak tanya?
Dialog: 0,0:24:41.69,0:24:44.46,Lalai,Tolenka3,0,0,0,,Apa yang lelaki tanya dalam situasi sedemikian?
Dialog: 0,0:24:46.13,0:24:47.16,Lalai,Tolenka3,0,0,0,,Nah, adakah ia bagus?
Dialog: 0,0:24:57.41,0:24:58.71,Lalai,Tolenka3,0,0,0,,Hantar seperti biasa.
Dialog: 0,0:25:00.74,0:25:01.98,Lalai,Tolenka3,0,0,0,,Ya, Tuanku.
Dialog: 0,0:25:04.58,0:25:05.88,Lalai,Tolenka3,0,0,0,,Sesuatu yang tidak kena di sini.
Dialog: 0,0:25:07.28,0:25:08.32,Lalai,Tolenka3,0,0,0,,Puan mahkamah Choi.
Dialog: 0,0:25:09.49,0:25:10.59,Lalai,Tolenka3,0,0,0,,Ya, Tuanku.
Dialog: 0,0:25:10.85,0:25:12.96, Lalai, Tolenka3,0,0,0,,Mengapa anda tidak memberitahu saya lagi?
Dialog: 0,0:25:13.12,0:25:15.96,Lalai,Tolenka3,0,0,0,,Adalah tidak wajar untuk meninggalkan bilik tuan seperti ini, Yang Mulia.
Dialog: 0,0:25:16.66,0:25:17.83,Lalai,Tolenka3,0,0,0,,Saya perlu mengingatkan semua orang.
Dialog: 0,0:25:18.13,0:25:20.43,Lalai,Tolenka3,0,0,0,,Saya memutuskan untuk tidak menegur awak lagi.
Dialog: 0,0:25:20.93,0:25:22.20,Lalai,Tolenka3,0,0,0,,Apa?
Dialog: 0,0:25:23.40,0:25:24.53,Lalai,Tolenka3,0,0,0,,Kenapa tiba-tiba?
Dialog: 0,0:25:25.53,0:25:27.77,Lalai,Tolenka3,0,0,0,,-Baiklah, pergi. \N-Baiklah.
Dialog: 0,0:25:31.54,0:25:32.71,Lalai,Tolenka3,0,0,0,,Sungguh mengejutkan.
Dialog: 0,0:25:56.02,0:25:57.12,Lalai,Tolenka3,0,0,0,,Mulai hari ini
Dialog: 0,0:25:58.66,0:26:01.49,Lalai,Tolenka3,0,0,0,,Saya letak jawatan sebagai pemangku raja.
Dialog: 0,0:26:44.80,0:26:45.90,Lalai,Tolenka3,0,0,0,,Dan oleh itu
Dialog: 0,0:26:47.01,0:26:49.21,Lalai,Tolenka3,0,0,0,,mulai sekarang saya akan memerintah seorang diri.
Dialog: 0,0:26:49.54,0:26:54.45, Lalai, Tolenka3,0,0,0,, Panjang umur bagi raja!
Dialog: 0,0:27:11.70,0:27:14.00,Lalai,Tolenka3,0,0,0,,Pada kadar ini saya akan mati tidak lama lagi.
Dialog: 0,0:27:15.03,0:27:18.40,Lalai,Tolenka3,0,0,0,,Semua pengalaman ini akan menamatkan saya.
Dialog: 0,0:27:19.10,0:27:21.47, Lalai, Tolenka3,0,0,0,, Beritahu saya bahawa anda tidak lapar hari ini?
Dialog: 0,0:27:21.91,0:27:25.28,Lalai,Tolenka3,0,0,0,,Adakah anda mahu mempercepatkan kematian saya?
Dialog: 0,0:27:25.54,0:27:26.91,Lalai,Tolenka3,0,0,0,,Saya mohon maaf.
Dialog: 0,0:27:27.68,0:27:28.88,Lalai,Tolenka3,0,0,0,,Walau bagaimanapun
Dialog: 0,0:27:29.18,0:27:32.92, Lalai, Tolenka3,0,0,0,,Saya masih tidak dapat memutuskan sama ada hendak memesan makanan untuk dibawa atau tidak.
Dialog: 0,0:27:32.92,0:27:36.02,Lalai,Tolenka3,0,0,0,,Jika saya perintahkan kamu untuk membawanya, kamu akan marah,\Nbahawa kami mengingati kamu sehingga kematian kamu.
Dialog: 0,0:27:36.76,0:27:39.73,Lalai,Tolenka3,0,0,0,,Apa, walaupun perkara yang begitu mudah
Dialog: 0,0:27:39.73,0:27:41.93,Lalai,Tolenka3,0,0,0,,takkan awak boleh buat keputusan tanpa saya?!
Dialog: 0,0:27:43.03,0:27:44.13, Lalai, Tolenka3,0,0,0,, Permaisuri Janda!
Dialog: 0,0:27:46.43,0:27:47.83,Lalai,Tolenka3,0,0,0,,Sila, sederhanakan kemarahan anda.
Dialog: 0,0:27:51.80,0:27:53.91,Lalai,Tolenka3,0,0,0,,Bolehkah anda tidak marah dalam keadaan sedemikian?
Dialog: 0,0:27:54.14,0:27:57.64,Lalai,Tolenka3,0,0,0,,Saya hampir kehilangan pengaruh saya di istana.
Dialog: 0,0:27:58.61,0:28:00.75,Lalai,Tolenka3,0,0,0,,Saya akan membantu mengembalikan kuasa dahulu.
Dialog: 0,0:28:02.65,0:28:04.98,Lalai,Tolenka3,0,0,0,,Anda akan menjadi bupati semula.
Dialog: 0,0:28:06.12,0:28:07.55,Lalai,Tolenka3,0,0,0,,Dan anda sangat yakin pada diri sendiri.
Dialog: 0,0:28:08.55,0:28:10.62,Lalai,Tolenka3,0,0,0,,Ayah kamu adalah sama pada masa mudanya.
Dialog: 0,0:28:11.96,0:28:14.66, Lalai, Tolenka3,0,0,0,,Ini adalah peluang terakhir.
Dialog: 0,0:28:15.19,0:28:17.06, Lalai, Tolenka3,0,0,0,,Dan apakah yang perlu dilakukan?
Dialog: 0,0:28:17.43,0:28:20.37, Lalai, Tolenka3,0,0,0,,Cari cara untuk melemahkan semangat raja.
Dialog: 0,0:28:22.53,0:28:24.67,Lalai,Tolenka3,0,0,0,,Jika semuanya berjalan lancar untuknya,
Dialog: 0,0:28:24.67,0:28:27.17,Lalai,Tolenka3,0,0,0,,fikirkan hanya tentang diri anda dan cuba untuk tidak melepaskan diri anda.
Dialog: 0,0:28:28.14,0:28:29.24,Lalai,Tolenka3,0,0,0,,Faham.
Dialog: 0,0:28:29.24,0:28:32.84,Lalai,Tolenka3,0,0,0,,Walau bagaimanapun, tidak mungkin kaedah lama akan berkesan.
Dialog: 0,0:28:35.01,0:28:37.15, Lalai, Tolenka3,0,0,0,,Jangan memandang rendah raja.
Dialog: 0,0:28:37.42,0:28:41.52,Lalai,Tolenka3,0,0,0,,Adakah anda benar-benar berfikir bahawa letupan itu adalah perbuatannya?
Dialog: 0,0:28:42.22,0:28:45.39,Lalai,Tolenka3,0,0,0,,Sebagai peraturan, orang yang paling mendapat manfaat harus dipersalahkan.
Dialog: 0,0:28:45.89,0:28:48.66, Lalai, Tolenka3,0,0,0,,Saya tidak percaya bahawa saya telah memberikan takhta kepada orang jahat yang berbahaya itu.
Dialog: 0,0:28:54.83,0:28:58.27,Default,Tolenka3,0,0,0,,Yang Mulia, tahniah atas penghujung pemerintahan.
Dialog: 0,0:28:59.74,0:29:00.94,Lalai,Tolenka3,0,0,0,,Terima kasih.
Dialog: 0,0:29:03.11,0:29:05.41,Lalai,Tolenka3,0,0,0,,Semasa anda tiada, mesej telah dihantar
Dialog: 0,0:29:05.41,0:29:07.18, Lalai, Tolenka3,0,0,0,,dari pavilion Daejojon.
Dialog: 0,0:29:08.11,0:29:09.92,Lalai,Tolenka3,0,0,0,,-Daripada permaisuri? \N-Ya, Tuanku.
Dialog: 0,0:29:16.69,0:29:19.59,Default,Tolenka3,0,0,0,,Saya cuba sampaikan dengan kata-kata bagaimana saya merana rindu pada awak,
Dialog: 0,0:29:19.89,0:29:21.06,Lalai,Tolenka3,0,0,0,,dan saya lebih merindui awak.
Dialog: 0,0:29:24.43,0:29:26.20,Lalai,Tolenka3,0,0,0,,Sesuatu perlu dilakukan tentang perkara ini.
Dialog: 0,0:29:33.04,0:29:34.97,Lalai,Tolenka3,0,0,0,,Rayuan terdesak saya telah didengari.
Dialog: 0,0:29:35.61,0:29:36.71,Lalai,Tolenka3,0,0,0,,Sesuatu yang gigih.
Dialog: 0,0:29:37.71,0:29:38.91,Lalai,Tolenka3,0,0,0,,Kita perlu berjumpa.
Dialog: 0,0:29:43.12,0:29:44.48,Lalai,Tolenka3,0,0,0,,Adakah anda di sini lagi?
Dialog: 0,0:29:44.92,0:29:47.05,Lalai,Tolenka3,0,0,0,,Untuk menyelamatkan saya daripada siksaan ini...
Dialog: 0,0:29:48.29,0:29:49.39,Lalai,Tolenka3,0,0,0,,Choljong?
Dialog: 0,0:29:49.82,0:29:51.12,Lalai,Tolenka3,0,0,0,,Bagaimana anda tahu di mana saya berada?
Dialog: 0,0:29:51.29,0:29:53.29,Lalai,Tolenka3,0,0,0,,Bagaimana ini? Anda sendiri yang membuat temu janji.
Dialog: 0,0:29:53.29,0:29:55.96,Lalai,Tolenka3,0,0,0,,-Dan seorang gundik memanggil saya ke sini!\N-Gunting yang mana?
Dialog: 0,0:29:55.96,0:29:57.63, Lalai, Tolenka3,0,0,0,,Apabila anda tidak tahu, ia lebih menarik,
Dialog: 0,0:29:57.63,0:29:59.36, Lalai, Tolenka3,0,0,0,,jadi saya tidak bertanya.
Dialog: 0,0:29:59.77,0:30:01.30, Lalai, Tolenka3,0,0,0,, Dalam apa jua keadaan, saya tidak menulis kepada anda.
Dialog: 0,0:30:01.70,0:30:04.00,Lalai,Tolenka3,0,0,0,,Kadang-kadang fikiran yang berbeza datang kepada saya.
Dialog: 0,0:30:05.54,0:30:08.24,Lalai,Tolenka3,0,0,0,,Saya harap saya boleh tenggelam dalam aliran pemikiran tentang awak.
Dialog: 0,0:30:08.74,0:30:11.84, Lalai, Tolenka3,0,0,0,, Berpaut pada saya.
Dialog: 0,0:30:12.71,0:30:17.52,Lalai,Tolenka3,0,0,0,,Oh! Saya tidak akan membiarkan anda pergi untuk apa-apa!
Dialog: 0,0:30:17.68,0:30:19.58,Lalai,Tolenka3,0,0,0,,-Cukup. \N-Adakah anda mendapatnya sekarang?
Dialog: 0,0:30:20.15,0:30:21.19,Lalai,Tolenka3,0,0,0,,No.
Dialog: 0,0:30:21.29,0:30:23.26,Lalai,Tolenka3,0,0,0,,Bukan lirik, tetapi agak malu. Pertama kali saya mendengarnya.
Dialog: 0,0:30:23.26,0:30:25.42,Lalai,Tolenka3,0,0,0,,Nama awak akan berada di bibir saya sehingga saya berehat.
Dialog: 0,0:30:25.62,0:30:27.89,Lalai,Tolenka3,0,0,0,,Akan mengisi semua fikiran saya, saya tidak akan melupakannya.
Dialog: 0,0:30:27.99,0:30:29.66,Lalai,Tolenka3,0,0,0,,Cukup. Ada orang di sini.
Dialog: 0,0:30:31.06,0:30:33.50,Lalai,Tolenka3,0,0,0,,Jadi apa? Bukan awak yang menulisnya.
Dialog: 0,0:30:40.37,0:30:42.74,Lalai,Tolenka3,0,0,0,,Kita perlu membincangkan sesuatu. tinggalkan kami.
Dialog: 0,0:30:42.74,0:30:43.88,Lalai,Tolenka3,0,0,0,,Okey?
Dialog: 0,0:30:43.88,0:30:45.91,Lalai,Tolenka3,0,0,0,,Ya, Tuanku.
Dialog: 0,0:30:53.92,0:30:55.19,Lalai,Tolenka3,0,0,0,,Adakah anda diam-diam mengikuti saya?
Dialog: 0,0:30:55.32,0:30:56.96,Lalai,Tolenka3,0,0,0,,Adakah anda membaca surat-menyurat?
Dialog: 0,0:30:57.62,0:30:58.82,Lalai,Tolenka3,0,0,0,,Apa yang anda cakapkan?
Dialog: 0,0:30:59.42,0:31:01.83,Lalai,Tolenka3,0,0,0,,Anda mengaku cinta anda dalam mesej.
Dialog: 0,0:31:01.83,0:31:03.46,Lalai,Tolenka3,0,0,0,,Dan apabila kita berjumpa antara satu sama lain, anda berpura-pura tidak peduli.
Dialog: 0,0:31:04.40,0:31:05.83,Lalai,Tolenka3,0,0,0,,Bagaimana anda boleh menjadi begitu kejam.
Dialog: 0,0:31:10.67,0:31:12.07,Lalai,Tolenka3,0,0,0,,Atau surat itu dihantar ke tempat yang salah?!
Dialog: 0,0:31:12.80,0:31:14.57,Lalai,Tolenka3,0,0,0,,Ternyata mesej itu tidak ditujukan untuk saya?
Dialog: 0,0:31:14.57,0:31:16.68,Lalai,Tolenka3,0,0,0,,Nampaknya kerana awak jantung saya berdegup kencang?
Dialog: 0,0:31:17.48,0:31:19.85,Lalai,Tolenka3,0,0,0,,Adakah anda peluang terakhir saya untuk mengembalikan kekuatan lelaki?
Dialog: 0,0:31:20.05,0:31:23.01,Lalai,Tolenka3,0,0,0,, Kerana awaklah hati saya hancur setiap malam
Dialog: 0,0:31:24.05,0:31:25.52, Lalai, Tolenka3,0,0,0,, menggeletar?
Dialog: 0,0:31:25.95,0:31:27.85,Lalai,Tolenka3,0,0,0,,Jadi inilah sebab perpecahan anda.
Dialog: 0,0:31:29.22,0:31:30.32,Lalai,Tolenka3,0,0,0,,Kenapa awak?
Dialog: 0,0:31:30.56,0:31:32.22,Lalai,Tolenka3,0,0,0,,Kenapa selalu awak?
Dialog: 0,0:31:32.22,0:31:34.43,Lalai,Tolenka3,0,0,0,,Walaupun dalam mimpi saya, awak muncul kepada saya!
Dialog: 0,0:31:35.16,0:31:36.53,Lalai,Tolenka3,0,0,0,,Adakah saya muncul kepada anda dalam mimpi anda?
Dialog: 0,0:31:37.03,0:31:40.60, Lalai, Tolenka3,0,0,0,, Tonton bahasa anda. Satu lagi kebodohan dan ini boleh dianggap sebagai pengakuan.
Dialog: 0,0:31:40.90,0:31:42.73,Lalai,Tolenka3,0,0,0,,Terdapat mimpi yang berbeza, anda tahu.
Dialog: 0,0:31:43.00,0:31:44.74,Lalai,Tolenka3,0,0,0,,Mimpi ngeri, contohnya.
Dialog: 0,0:31:45.87,0:31:47.34,Lalai,Tolenka3,0,0,0,,Kenapa awak tolong saya di majlis kenduri itu?
Dialog: 0,0:31:49.54,0:31:51.71,Lalai,Tolenka3,0,0,0,,Ikut saya untuk bertanya ini?!
Dialog: 0,0:31:52.41,0:31:54.78,Lalai,Tolenka3,0,0,0,,Saya boleh terima kasih. Sia-sia ia hanya membantu.
Dialog: 0,0:31:54.98,0:31:56.78,Lalai,Tolenka3,0,0,0,,Dia berkata sendiri, bersumpah - jika anda gembira melihatnya,
Dialog: 0,0:31:56.78,0:31:59.15,Lalai,Tolenka3,0,0,0,,dan cari pergaduhan, jika bersyukur.
Dialog: 0,0:31:59.28,0:32:01.52,Lalai,Tolenka3,0,0,0,,Mengapa anda tiba-tiba memutuskan untuk mendengar saya?
Dialog: 0,0:32:01.52,0:32:03.42,Lalai,Tolenka3,0,0,0,,Saya melakukannya dengan cara anda, tetapi anda masih tidak berpuas hati?
Dialog: 0,0:32:03.92,0:32:06.06,Lalai,Tolenka3,0,0,0,,Apa yang anda mahu saya lakukan kemudian?
Dialog: 0,0:32:06.49,0:32:08.73,Lalai,Tolenka3,0,0,0,,Kami menjauhkan diri, kemudian tiba-tiba anda membantu.
Dialog: 0,0:32:08.73,0:32:11.20,Lalai,Tolenka3,0,0,0,,Kemudian tiba-tiba anda mengisytiharkan bahawa anda akan dengan mudah mengkhianati saya.
Dialog: 0,0:32:11.86,0:32:13.23,Lalai,Tolenka3,0,0,0,,Ya, maka saya hanya...
Dialog: 0,0:32:15.23,0:32:16.27,Lalai,Tolenka3,0,0,0,,Tunggu sebentar.
Dialog: 0,0:32:18.34,0:32:20.34,Lalai,Tolenka3,0,0,0,,Jadi adakah anda mendengar segala-galanya?
Dialog: 0,0:32:22.47,0:32:24.58,Lalai,Tolenka3,0,0,0,,Ternyata dia berbohong tentang kehilangan pendengarannya?
Dialog: 0,0:32:25.68,0:32:26.81,Lalai,Tolenka3,0,0,0,,Sungguh...
Dialog: 0,0:32:28.01,0:32:29.68,Lalai,Tolenka3,0,0,0,,Nampaknya letupan itu adalah anda lakukan?
Dialog: 0,0:32:30.62,0:32:32.62,Lalai,Tolenka3,0,0,0,,Saya benar-benar hilang pendengaran untuk seketika.
Dialog: 0,0:32:33.22,0:32:35.95,Lalai,Tolenka3,0,0,0,,Tetapi dia kembali seperti yang anda katakan perkataan ini.
Dialog: 0,0:32:36.86,0:32:39.39,Lalai,Tolenka3,0,0,0,,Adakah anda hilang akal? Anda boleh mati!
Dialog: 0,0:32:39.55,0:32:40.40,Lalai,Tolenka3,0,0,0,,Permaisuriku!
Dialog: 0,0:32:40.50,0:32:42.55,Lalai,Tolenka3,0,0,0,,Mengapa mempertaruhkan diri anda?!
Dialog: 0,0:33:02.21,0:33:04.58,Lalai,Tolenka3,0,0,0,,Apa? Ini adalah teknik yang dilarang!
Dialog: 0,0:33:04.88,0:33:07.52,Lalai,Tolenka3,0,0,0,,Awak sentiasa peluk, senyum, tidur di sebelah saya...
Dialog: 0,0:33:07.59,0:33:09.25,Lalai,Tolenka3,0,0,0,,Semua ini adalah dilarang.
Dialog: 0,0:33:12.92,0:33:14.73,Lalai,Tolenka3,0,0,0,,Saya melarang anda melarang saya.
Dialog: 0,0:33:25.34,0:33:27.24,Lalai,Tolenka3,0,0,0,,Saya sayang awak.
Dialog: 0,0:33:32.31,0:33:33.48,Lalai,Tolenka3,0,0,0,,Sangat asmara?
Dialog: 0,0:33:33.78,0:33:36.21,Lalai,Tolenka3,0,0,0,,Semuanya kerana satu malam yang dihabiskan bersama? \NAnda tidak sepatutnya berbuat demikian.
Dialog: 0,0:33:36.21,0:33:37.62, Lalai, Tolenka3,0,0,0,,Tidak, bukan itu sebabnya.
Dialog: 0,0:33:37.62,0:33:39.25,Lalai,Tolenka3,0,0,0,,Lalu kenapa?
Dialog: 0,0:33:40.22,0:33:43.72,Lalai,Tolenka3,0,0,0,,Anda sombong, narsis, kurang ajar
Dialog: 0,0:33:43.89,0:33:45.16, Lalai, Tolenka3,0,0,0,,dan berubah-ubah.
Dialog: 0,0:33:45.59,0:33:47.09,Lalai,Tolenka3,0,0,0,,Anda mempunyai banyak kekurangan.
Dialog: 0,0:33:47.73,0:33:50.60,Lalai,Tolenka3,0,0,0,,Itulah maksudnya. Jadi jangan sayang saya.
Dialog: 0,0:33:50.60,0:33:52.53,Lalai,Tolenka3,0,0,0,,Tetapi saya masih sayangkan awak.
Dialog: 0,0:33:53.67,0:33:56.57,Lalai,Tolenka3,0,0,0,,Dan saya akan suka, biarkan anda mempunyai
Dialog: 0,0:33:57.44,0:33:58.97,Lalai,Tolenka3,0,0,0,,semua kekurangan dunia.
Dialog: 0,0:34:09.85,0:34:10.95,Lalai,Tolenka3,0,0,0,,Ingat apa yang saya katakan
Dialog: 0,0:34:13.29,0:34:14.82,Lalai,Tolenka3,0,0,0,,malam sebelumnya,
Dialog: 0,0:34:16.02,0:34:17.39,Lalai,Tolenka3,0,0,0,,bagaimana untuk melompat ke dalam kolam?
Dialog: 0,0:34:19.29,0:34:21.43,Lalai,Tolenka3,0,0,0,,Awak mesti sayang saya.
Dialog: 0,0:34:24.20,0:34:26.46,Lalai,Tolenka3,0,0,0,,Saya berkata ini kerana ia kelihatan pada saya ketika itu
Dialog: 0,0:34:26.46,0:34:27.90,Lalai,Tolenka3,0,0,0,,hanya saya boleh melindungi kamu.
Dialog: 0,0:34:29.03,0:34:31.84,Lalai,Tolenka3,0,0,0,,Kerana saya fikir tiada cara lain untuk membantu anda.
Dialog: 0,0:34:32.20,0:34:34.71,Lalai,Tolenka3,0,0,0,,Bahawa ini adalah satu-satunya cara untuk menyelamatkan anda dan saya.
Dialog: 0,0:34:35.97,0:34:37.44,Lalai,Tolenka3,0,0,0,,Jadi ini sebabnya?
Dialog: 0,0:34:37.44,0:34:38.54,Lalai,Tolenka3,0,0,0,,Tetapi anda tahu apa?
Dialog: 0,0:34:39.88,0:34:42.68,Lalai,Tolenka3,0,0,0,,Kim So-yeon itu tiada lagi.
Dialog: 0,0:34:44.05,0:34:45.98,Lalai,Tolenka3,0,0,0,,Ta Kim So-yeon meninggal dunia malam itu.
Dialog: 0,0:34:49.49,0:34:52.02, Lalai, Tolenka3,0,0,0,,Saya tidak akan menyakiti awak lagi.
Dialog: 0,0:34:54.53,0:34:56.33,Lalai,Tolenka3,0,0,0,,Kami tiada masa depan.
Dialog: 0,0:34:59.06,0:35:00.57,Lalai,Tolenka3,0,0,0,,Kerana saya tidak akan memaafkan awak.
Dialog: 0,0:35:03.94,0:35:05.90,Lalai,Tolenka3,0,0,0,,Saya bukan Kim So-yeon.
Dialog: 0,0:35:06.30,0:35:08.61,Lalai,Tolenka3,0,0,0,,Oleh itu, saya tiada hak.
Dialog: 0,0:35:26.26,0:35:29.46,Lalai,Tolenka3,0,0,0,,Apa orang. Adakah Baginda memerlukan sesuatu?
Dialog: 0,0:35:30.50,0:35:33.30,Lalai,Tolenka3,0,0,0,,-Terima kasih atas bantuan anda. \N-Bantuan?
Dialog: 0,0:35:34.53,0:35:35.97, Lalai, Tolenka3,0,0,0,,Di rumah sakit istana.
Dialog: 0,0:35:36.03,0:35:38.64,Lalai,Tolenka3,0,0,0,,Ah, itu sahaja, saya cuma...
Dialog: 0,0:35:38.64,0:35:41.24,Lalai,Tolenka3,0,0,0,,Saya memberi awak air beracun.
Dialog: 0,0:35:42.47,0:35:45.51,Lalai,Tolenka3,0,0,0,,Jadi begitu, tetapi mereka juga mengarahkan akupunktur dengan moksibusi.
Dialog: 0,0:35:46.24,0:35:48.85, Lalai, Tolenka3,0,0,0,,Oleh itu saya patut berterima kasih kepada anda.
Dialog: 0,0:35:51.92,0:35:53.05, Lalai, Tolenka3,0,0,0,,Terjumpa dalam perjalanan.
Dialog: 0,0:35:55.09,0:35:56.25,Lalai,Tolenka3,0,0,0,,Tetapi...
Dialog: 0,0:36:02.83,0:36:06.23,Lalai,Tolenka3,0,0,0,,Di mana dia dapati barang semahal itu?
Dialog: 0,0:36:11.24,0:36:12.94,Lalai,Kus4,0,0,0,,Percubaan ke atas raja?
Dialog: 0,0:36:13.34,0:36:16.04,Lalai,Kus4,0,0,0,,Mengapa anda tidak berunding dengan kami sebelum memulakan ini?
Dialog: 0,0:36:16.04,0:36:17.88,Lalai,Kus4,0,0,0,,Lihat apa yang membawa kepada ini.
Dialog: 0,0:36:17.88,0:36:21.61,Lalai,Kus4,0,0,0,,Kim Jwageun mesti telah mencapai hadnya.
Dialog: 0,0:36:31.76,0:36:33.39,Lalai,Kus4,0,0,0,,Saya faham, awak mahukan wang,
Dialog: 0,0:36:33.39,0:36:34.79,Lalai,Kus4,0,0,0,,tapi jual senjata kita?
Dialog: 0,0:36:35.09,0:36:36.80,Lalai,Kus4,0,0,0,,Adakah anda cuba memusnahkan negara ini?
Dialog: 0,0:36:36.80,0:36:38.73,Lalai,Kus4,0,0,0,,Anda menjelaskan bahawa tiada masalah.
Dialog: 0,0:36:39.03,0:36:41.97,Lalai,Kus4,0,0,0,,Anda memerlukan orang untuk mencapai matlamat anda.
Dialog: 0,0:36:41.97,0:36:43.97,Lalai,Kus4,0,0,0,,Dan untuk ini kita memerlukan wang.
Dialog: 0,0:36:45.17,0:36:47.54,Lalai,Kus4,0,0,0,,Adakah anda mengatakan anda melakukan ini untuk saya?
Dialog: 0,0:36:47.54,0:36:50.81,Lalai,Kus4,0,0,0,,Saya mahu menunjukkan keputusan tanpa mengganggu anda dalam proses itu sendiri.
Dialog: 0,0:36:50.81,0:36:52.24,Lalai,Kus4,0,0,0,,Saya melakukan segala-galanya untuk ini!
Dialog: 0,0:36:52.68,0:36:54.21,Lalai,Kus4,0,0,0,,Saya cuba untuk anda
Dialog: 0,0:36:54.48,0:36:58.18,Lalai,Kus4,0,0,0,,dan demi kebaikan kita.
Dialog: 0,0:37:00.85,0:37:01.92,Lalai,Kus4,0,0,0,,Bersedia
Dialog: 0,0:37:01.92,0:37:04.96,Lalai,Kus4,0,0,0,,ambil tanggungjawab jika tiada jalan lain.
Dialog: 0,0:37:10.80,0:37:12.76,Lalai,Kus4,0,0,0,,Saya akan memberi anda peluang untuk menebus.
Dialog: 0,0:37:21.54,0:37:24.14,Lalai,Kus4,0,0,0,,-Semua dah sampai?\N-En.
Dialog: 0,0:37:25.31,0:37:28.25,Lalai,Kus4,0,0,0,,Ayah permaisuri belum ada.
Dialog: 0,0:37:29.58,0:37:31.12,Lalai,Kus4,0,0,0,,Dia tidak dijemput.
Dialog: 0,0:37:31.52,0:37:34.99,Lalai,Kus4,0,0,0,,Kami berkumpul di sini kerana kesilapannya.
Dialog: 0,0:37:35.39,0:37:37.52,Lalai,Kus4,0,0,0,,Dia menyimpan rekod harta,
Dialog: 0,0:37:38.59,0:37:40.43,Lalai,Kus4,0,0,0,,milik keluarga kami.
Dialog: 0,0:37:44.80,0:37:49.00,Default,Kus4,0,0,0,,Nasib baik saya ada buku perakaunan ni.
Dialog: 0,0:37:50.54,0:37:54.31,Lalai,Kus4,0,0,0,,Selagi pengaruh saya kekal, dia tidak berguna,
Dialog: 0,0:37:54.31,0:37:55.64, Lalai, Kus4,0,0,0,, dan anda tidak perlu risau.
Dialog: 0,0:37:57.68,0:37:58.71,Lalai,Kus4,0,0,0,,Tetapi
Dialog: 0,0:37:59.28,0:38:02.48,Lalai,Kus4,0,0,0,,sebaik sahaja saya kehilangan pengaruh,
Dialog: 0,0:38:05.02,0:38:07.09,Lalai,Kus4,0,0,0,,Saya tidak dapat melindungi buku itu.
Dialog: 0,0:38:10.36,0:38:12.62,Lalai,Kus4,0,0,0,,Jika anda melindungi saya,
Dialog: 0,0:38:13.12,0:38:15.23,Lalai,Kus4,0,0,0,,Saya akan melindungi kamu sebagai balasan.
Dialog: 0,0:38:15.93,0:38:18.23,Lalai,Kus4,0,0,0,,Jika kami memutuskan untuk melindungi anda,
Dialog: 0,0:38:18.66,0:38:19.80,Lalai,Kus4,0,0,0,,apa
Dialog: 0,0:38:21.03,0:38:23.00,Lalai,Kus4,0,0,0,,awak buat dengan raja?
Dialog: 0,0:38:23.97,0:38:25.27,Lalai,Kus4,0,0,0,,Jika kita tidak melakukan apa-apa,
Dialog: 0,0:38:25.27,0:38:28.81,Lalai,Kus4,0,0,0,,dia akan menghalau kami kerana kami tidak menyingkirkan anda daripada kedudukan anda.
Dialog: 0,0:38:29.87,0:38:32.91,Lalai,Kus4,0,0,0,,Satu majlis telah dibentuk untuk menyelesaikan masalah kerajaan.
Dialog: 0,0:38:35.25,0:38:36.45,Lalai,Kus4,0,0,0,,Majlis Keselamatan Sempadan?
Dialog: 0,0:38:37.08,0:38:39.45,Lalai,Kus4,0,0,0,,Raja yang tidak cekap mengambil kuasa ke tangannya sendiri -
Dialog: 0,0:38:39.45,0:38:41.45,Lalai,Kus4,0,0,0,,masalah keadaan yang serius.
Dialog: 0,0:38:42.52,0:38:44.72,Lalai,Kus4,0,0,0,,Semua keputusan dasar
Dialog: 0,0:38:45.99,0:38:48.43,Lalai,Kus4,0,0,0,,akan dipertimbangkan oleh Majlis Perlindungan Sempadan.
Dialog: 0,0:38:50.76,0:38:52.26,Lalai,Kus4,0,0,0,,Saya sudah sediakan semuanya.
Dialog: 0,0:38:52.60,0:38:55.60,Lalai,Kus4,0,0,0,,Seperti yang anda katakan, kami membekukan air dengan arsenik di dalamnya.
Dialog: 0,0:38:55.60,0:38:58.17,Lalai,Kus4,0,0,0,,Apabila ais cair, arsenik keluar.
Dialog: 0,0:38:58.17,0:39:00.67,Lalai,Kus4,0,0,0,,Berapa lama masa yang diperlukan untuk arsenik larut?
Dialog: 0,0:39:01.27,0:39:02.91,Lalai,Kus4,0,0,0,,Ia bergantung pada cuaca,
Dialog: 0,0:39:03.24,0:39:05.38, Lalai, Kus4,0,0,0,,tetapi dalam teh ia tidak akan mengambil banyak masa.
Dialog: 0,0:39:06.78,0:39:07.85,Lalai,Kus4,0,0,0,,Saya nampak.
Dialog: 0,0:39:08.45,0:39:12.08,Lalai,Kus4,0,0,0,,By the way, boleh saya tahu siapa sasaran anda?
Dialog: 0,0:39:12.98,0:39:15.62,Lalai,Kus4,0,0,0,,Jika saya menyingkirkan seorang wanita di istana,
Dialog: 0,0:39:15.85,0:39:18.92,Lalai,Kus4,0,0,0,,dua lelaki yang mengancam kedudukan saya akan dipatahkan.
Dialog: 0,0:39:34.47,0:39:36.17,Lalai,Kus4,0,0,0,,Terima kasih kerana berdiri.
Dialog: 0,0:39:37.51,0:39:40.55,Lalai,Kus4,0,0,0,,Anda telah mengalami penyeksaan yang begitu pedih.
Dialog: 0,0:39:41.91,0:39:43.08,Lalai,Kus4,0,0,0,,Saya tidak akan lupa ini.
Dialog: 0,0:39:45.12,0:39:48.89,Lalai,Kus4,0,0,0,,Sekarang anda telah terdedah, adalah berbahaya untuk kekal di istana.
Dialog: 0,0:39:49.82,0:39:51.29,Lalai,Kus4,0,0,0,,Tinggalkan istana.
Dialog: 0,0:39:52.49,0:39:54.79,Lalai,Kus4,0,0,0,,Sudah tiba masanya untuk anda menjalani kehidupan anda.
Dialog: 0,0:40:44.98,0:40:46.44,Lalai,Kus4,0,0,0,,Saya akan lakukan segalanya
Dialog: 0,0:40:51.08,0:40:52.58,Lalai,Kus4,0,0,0,,untuk merealisasikan impian anda.
Dialog: 0,0:41:14.91,0:41:16.24,Lalai,Kus4,0,0,0,,Entah bagaimana ia menjadi kosong.
Dialog: 0,0:41:18.01,0:41:20.55,Lalai,Kus4,0,0,0,,Siapa antara kamu yang masih mahu...
Dialog: 0,0:41:22.68,0:41:23.75,Lalai,Kus4,0,0,0,,Anda di sini.
Dialog: 0,0:41:47.11,0:41:48.54,Lalai,Kus4,0,0,0,,Saya perlu meletakkan
Dialog: 0,0:41:49.67,0:41:53.24,Lalai,Kus4,0,0,0,,kiub ais heksagon dalam mangkuk ratu?
Dialog: 0,0:41:54.65,0:41:55.68,Lalai,Kus4,0,0,0,,Ya.
Dialog: 0,0:42:00.08,0:42:02.35,Lalai,Kus4,0,0,0,,Tambahkan kiub ais sahaja. Ini sahaja.
Dialog: 0,0:42:15.50,0:42:16.53,Lalai,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:42:17.44,0:42:21.31,Lalai,Kus4,0,0,0,,Saya mempunyai maklumat yang sangat penting.
Dialog: 0,0:42:21.94,0:42:24.44,Lalai,Kus4,0,0,0,,Tolong bantu saya.
Dialog: 0,0:42:25.31,0:42:27.35,Lalai,Kus4,0,0,0,,Apa yang anda dapat di sana?
Dialog: 0,0:42:27.71,0:42:30.62,Lalai,Kus4,0,0,0,,Jika anda berjanji untuk menyelamatkan saya...
Dialog: 0,0:42:31.18,0:42:32.85,Lalai,Kus4,0,0,0,,Beraninya awak?
Dialog: 0,0:42:33.25,0:42:34.32,Lalai,Kus4,0,0,0,,Puan mahkamah Khan.
Dialog: 0,0:42:37.46,0:42:41.53,Lalai,Kus4,0,0,0,,Saya tahu awak seorang gadis yang berani, tetapi sekarang awak menggeletar ketakutan.
Dialog: 0,0:42:42.63,0:42:44.53,Lalai,Kus4,0,0,0,,Saya tidak tahu apa yang anda ada di sana,
Dialog: 0,0:42:45.23,0:42:47.60,Lalai,Kus4,0,0,0,,tetapi saya akan membantu anda dengan semua yang saya boleh.
Dialog: 0,0:42:50.00,0:42:52.84,Lalai,Kus4,0,0,0,,Kim Jwageun bertanya kepada saya...
Dialog: 0,0:42:56.71,0:42:58.91,Lalai,Kus4,0,0,0,,Mengapa dia tidak menyukainya sejak awal lagi?
Dialog: 0,0:42:59.44,0:43:01.31,Lalai,Kus4,0,0,0,,Maka Kim So-yeon tidak akan cuba mati.
Dialog: 0,0:43:01.31,0:43:02.88, Lalai, Kus4,0,0,0,, Dan saya tidak akan berada di sini.
Dialog: 0,0:43:04.88,0:43:06.25,Lalai,Kus4,0,0,0,,Tetapi yang lebih penting,
Dialog: 0,0:43:11.59,0:43:14.16,Lalai,Kus4,0,0,0,,Saya fikir saya telah mengalami segala yang mungkin.
Dialog: 0,0:43:16.09,0:43:18.60,Lalai,Kus4,0,0,0,,Tetapi, nampaknya, ada sesuatu yang saya tidak temui.
Dialog: 0,0:43:19.46,0:43:21.47,Lalai,Kus4,0,0,0,,Bagaimana untuk menerangkan perasaan itu malam tadi?
Dialog: 0,0:43:23.77,0:43:26.94,Lalai,Kus4,0,0,0,,Jika semuanya sebelum ini seperti sekeping roti yang lembut,
Dialog: 0,0:43:26.94,0:43:28.17,Lalai,Kus4,0,0,0,,maka ia adalah...
Dialog: 0,0:43:31.21,0:43:35.05,Lalai,Kus4,0,0,0,,Tidak, itu baru. \NI berminat dengan sesuatu yang baharu.
Dialog: 0,0:43:35.58,0:43:37.08,Lalai,Kus4,0,0,0,,Datang kepada diri anda sendiri, Chan So-yeon.
Dialog: 0,0:43:38.02,0:43:41.02,Lalai,Kus4,0,0,0,,Sial. Saya juga mengelirukan nama.
Dialog: 0,0:43:42.29,0:43:43.39,Lalai,Kus4,0,0,0,,Ratu.
Dialog: 0,0:43:44.52,0:43:45.99,Lalai,Kus4,0,0,0,,Ya. Masuklah.
Dialog: 0,0:43:51.40,0:43:55.13,Lalai,Kus4,0,0,0,,Permaisuri Janda meminta kamu bersarapan bersama.
Dialog: 0,0:43:56.23,0:43:58.67,Lalai,Kus4,0,0,0,,Sarapan pada masa ini?
Dialog: 0,0:44:00.61,0:44:04.14,Lalai,Kus4,0,0,0,,Saya tiada mood untuk memasak sekarang.
Dialog: 0,0:44:07.38,0:44:11.82,Lalai,Kus4,0,0,0,,Permaisuri Janda sudah menyediakan segalanya.
Dialog: 0,0:44:13.42,0:44:14.82,Lalai,Kus4,0,0,0,,Adakah saya akan ke Dewan Dongmyeongjong?
Dialog: 0,0:44:15.19,0:44:17.09,Lalai,Kus4,0,0,0,,Saya telah berlari sepanjang hari hari ini - jadi saya lapar.
Dialog: 0,0:44:18.86,0:44:20.66,Lalai,Kus4,0,0,0,,Mereka mahu menyingkirkan permaisuri?
Dialog: 0,0:44:21.49,0:44:23.76,Lalai,Kus4,0,0,0,,Buku perakaunan kini bersama Kim Jwagyn.
Dialog: 0,0:44:24.40,0:44:25.90,Lalai,Kus4,0,0,0,,Siapa tahu dia berada di Dewan Daejojong?
Dialog: 0,0:44:26.36,0:44:27.53,Lalai,Kus4,0,0,0,,Bagaimana...
Dialog: 0,0:44:28.63,0:44:30.07,Default,Kus4,0,0,0,,Saya akan kembali ke istana.
Dialog: 0,0:44:36.01,0:44:37.07,Lalai,Kus4,0,0,0,,Di sini.
Dialog: 0,0:44:52.19,0:44:53.96,Lalai,Kus4,0,0,0,,Kenapa awak buntu? Cepatlah!
Dialog: 0,0:44:53.96,0:44:55.13,Lalai,Kus4,0,0,0,,Saya datang.
Dialog: 0,0:45:06.77,0:45:08.97,Lalai,Kus4,0,0,0,,Awak tinggalkan saya lagi.
Dialog: 0,0:45:10.44,0:45:14.25,Lalai,Kus4,0,0,0,,Anda tahu, Imp, saya mula marah dengan awak.
Dialog: 0,0:45:29.23,0:45:31.13,Lalai,Kus4,0,0,0,,Terima kasih, Tuanku.
Dialog: 0,0:45:32.00,0:45:34.73,Lalai,Kus4,0,0,0,,Sarapan, dan dengan pemandangan yang begitu indah.
Dialog: 0,0:45:35.00,0:45:38.20,Default,Kus4,0,0,0,,Saya bukan lagi bupati, jadi saya ada banyak masa lapang.
Dialog: 0,0:45:38.54,0:45:40.84,Lalai,Kus4,0,0,0,,Kita sepatutnya bersarapan bersama lebih kerap.
Dialog: 0,0:45:41.47,0:45:43.54,Lalai,Kus4,0,0,0,,Ya, Tuanku.
Dialog: 0,0:45:51.82,0:45:54.49,Lalai,Kus4,0,0,0,,Sarapan tidak boleh tanpa minuman.
Dialog: 0,0:45:59.16,0:46:03.06,Default,Kus4,0,0,0,,Yang akan mati di istana hari ini ialah permaisuri.
Dialog: 0,0:46:06.30,0:46:07.77,Lalai,Kus4,0,0,0,,Anakku,
Dialog: 0,0:46:08.73,0:46:11.14,Lalai,Kus4,0,0,0,,Saya akhirnya boleh membalas dendam.
Dialog: 0,0:47:16.53,0:47:18.54,Lalai,Kus4,0,0,0,,Saya menyediakan ais khas,
Dialog: 0,0:47:18.54,0:47:21.61,Lalai,Kus4,0,0,0,,yang lebih mahal daripada emas hari ini.
Dialog: 0,0:47:26.48,0:47:28.08,Lalai,Kus4,0,0,0,,Saya akan melihat ais di sini buat kali pertama.
Dialog: 0,0:47:28.68,0:47:31.15,Lalai,Kus4,0,0,0,,Hari ini panas,
Dialog: 0,0:47:31.18,0:47:34.32,Lalai,Kus4,0,0,0,,masa yang sesuai untuk minuman sejuk.
Dialog: 0,0:47:44.86,0:47:47.63,Lalai,Kus4,0,0,0,,Permaisuriku. Tolonglah.
Dialog: 0,0:47:47.77,0:47:49.10,Lalai,Kus4,0,0,0,,Saya mohon. permaisuri saya.
Dialog: 0,0:48:11.30,0:48:12.43,Lalai,Kus4,0,0,0,,Beraninya awak...
Dialog: 0,0:48:12.53,0:48:17.44,Lalai,Kus4,0,0,0,,Saya perlu memberitahu permaisuri sesuatu.
Dialog: 0,0:48:17.54,0:48:19.10,Lalai,Kus4,0,0,0,,Beraninya awak datang ke sini? cuti.
Dialog: 0,0:48:19.10,0:48:21.01,Lalai,Kus4,0,0,0,,Ini sangat penting.
Dialog: 0,0:48:22.67,0:48:23.77,Lalai,Kus4,0,0,0,,Damhyan?
Dialog: 0,0:48:24.04,0:48:25.84,Lalai,Kus4,0,0,0,,Kenapa awak buat begini?
Dialog: 0,0:48:25.84,0:48:27.98,Lalai,Kus4,0,0,0,,Saya akan menghadapi masalah kerana awak.
Dialog: 0,0:48:28.91,0:48:31.05,Lalai,Kus4,0,0,0,,Apa yang penting?
Dialog: 0,0:48:36.82,0:48:38.62,Lalai,Kus4,0,0,0,,Adakah anda kenal wanita mahkamah ini?
Dialog: 0,0:48:40.29,0:48:43.09,Lalai,Kus4,0,0,0,,Ya. Saya sering melihatnya di dapur diraja.
Dialog: 0,0:48:44.86,0:48:47.06,Lalai,Kus4,0,0,0,,Damhyan, apa yang berlaku?
Dialog: 0,0:48:47.67,0:48:49.10,Lalai,Kus4,0,0,0,,Perkaranya...
Dialog: 0,0:48:53.27,0:48:54.94,Lalai,Kus4,0,0,0,,Anda lihat...
Dialog: 0,0:49:01.75,0:49:02.81,Lalai,Kus4,0,0,0,,Maaf.
Dialog: 0,0:49:19.60,0:49:22.77,Lalai,Kus4,0,0,0,,Saya datang untuk menghadiri jamuan permaisuri janda.
Dialog: 0,0:49:23.73,0:49:26.34,Lalai,Kus4,0,0,0,,Ini adalah perhimpunan wanita. Anda tidak perlu datang.
Dialog: 0,0:49:27.40,0:49:30.51,Lalai,Kus4,0,0,0,,Ini adalah kali pertama saya melihat permaisuri pada mesyuarat sedemikian.
Dialog: 0,0:49:31.08,0:49:32.34,Lalai,Kus4,0,0,0,,Saya minta maaf.
Dialog: 0,0:49:33.78,0:49:35.98,Lalai,Kus4,0,0,0,,Ia satu penghormatan untuk saya.
Dialog: 0,0:49:36.31,0:49:39.42,Lalai,Kus4,0,0,0,,Bagaimana keadaan dengan mengawasi suami anda?
Dialog: 0,0:49:46.02,0:49:48.23,Lalai,Kus4,0,0,0,,Sekarang raja telah bangun,
Dialog: 0,0:49:48.33,0:49:50.43,Lalai,Kus4,0,0,0,,Saya akan melakukan yang terbaik.
Dialog: 0,0:49:52.93,0:49:55.57,Lalai,Kus4,0,0,0,,Kita perlu minum sebelum ais berharga cair.
Dialog: 0,0:50:06.88,0:50:08.15,Lalai,Kus4,0,0,0,,Bagaimanakah anda menyukainya?
Dialog: 0,0:50:09.35,0:50:10.92,Lalai,Kus4,0,0,0,,Rasanya sungguh menyegarkan.
Dialog: 0,0:50:14.85,0:50:16.42,Lalai,Kus4,0,0,0,,Saya sangat menyukainya sehingga saya tidak dapat menahannya.
Dialog: 0,0:50:58.23,0:50:59.33,Lalai,Kus4,0,0,0,,Permaisuriku!
Dialog: 0,0:51:10.47,0:51:11.54,Lalai,Kus4,0,0,0,,Yang Mulia!
Dialog: 0,0:51:16.91,0:51:18.12,Lalai,Kus4,0,0,0,,Beraninya awak?
Dialog: 0,0:51:18.38,0:51:20.45,Lalai,Kus4,0,0,0,,Apa yang telah anda lakukan di sini?
Dialog: 0,0:51:23.35,0:51:25.99,Lalai,Kus4,0,0,0,,-Awak okay?\N-Apa? ya.
Dialog: 0,0:51:26.12,0:51:28.63,Lalai,Kus4,0,0,0,,Beraninya awak baling batu ke arah permaisuri?
Dialog: 0,0:51:30.33,0:51:32.06,Lalai,Kus4,0,0,0,,Saya tidak apa-apa, Tuanku.
Dialog: 0,0:51:38.14,0:51:40.17,Lalai,Kus4,0,0,0,,Bawa gadis ini ke dalam jagaan.
Dialog: 0,0:51:40.84,0:51:42.87,Lalai,Kus4,0,0,0,,Dia akan dihukum atas apa yang dia lakukan.
Dialog: 0,0:51:45.24,0:51:46.28,Lalai,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:51:48.78,0:51:49.88,Lalai,Kus4,0,0,0,,Ikut saya.
Dialog: 0,0:51:51.32,0:51:52.42,Lalai,Kus4,0,0,0,,Damhyan.
Dialog: 0,0:52:01.93,0:52:03.49,Lalai,Kus4,0,0,0,,Dia sangat penting bagi saya.
Dialog: 0,0:52:03.53,0:52:06.76,Lalai,Kus4,0,0,0,,Saya tidak apa-apa, jadi jangan marah.
Dialog: 0,0:52:06.76,0:52:08.73,Lalai,Kus4,0,0,0,,Ini tiada kaitan dengan anda.
Dialog: 0,0:52:09.20,0:52:11.54,Lalai,Kus4,0,0,0,,Dia membuat kacau di dalam istana
Dialog: 0,0:52:11.54,0:52:13.67,Lalai,Kus4,0,0,0,,dan melanggar perintah yang ditetapkan.
Dialog: 0,0:52:14.74,0:52:16.37,Lalai,Kus4,0,0,0,,Dia hanya seorang kanak-kanak.
Dialog: 0,0:52:16.81,0:52:18.41,Lalai,Kus4,0,0,0,,Saya pasti dia ada sebab.
Dialog: 0,0:52:18.41,0:52:20.04,Lalai,Kus4,0,0,0,,Dia tidak akan melakukannya tanpa sebab.
Dialog: 0,0:52:20.04,0:52:21.65,Lalai,Kus4,0,0,0,,Jika anda terus begini,
Dialog: 0,0:52:21.65,0:52:23.71,Lalai,Kus4,0,0,0,,Saya akan menuduhnya berkelakuan tidak wajar
Dialog: 0,0:52:23.71,0:52:25.62,Lalai,Kus4,0,0,0,,dan saya akan menghukum kamu dengan lebih teruk lagi.
Dialog: 0,0:52:30.35,0:52:32.42,Lalai,Kus4,0,0,0,,Kenapa awak datang tergesa-gesa?
Dialog: 0,0:52:33.19,0:52:37.19,Lalai,Kus4,0,0,0,,Adakah anda benar-benar tahu bahawa kanak-kanak itu akan cuba membahayakan permaisuri?
Dialog: 0,0:52:39.10,0:52:40.96,Lalai,Kus4,0,0,0,,Adakah anda cuba menyeret saya ke dalam perkara ini?
Dialog: 0,0:52:41.07,0:52:44.74,Lalai,Kus4,0,0,0,,Cuma masa ketibaan anda bertepatan dengan sempurna.
Dialog: 0,0:52:44.77,0:52:46.40,Lalai,Kus4,0,0,0,,Saya bimbang,
Dialog: 0,0:52:46.40,0:52:48.91,Lalai,Kus4,0,0,0,,bahawa orang yang merancang pengkhianatan,
Dialog: 0,0:52:48.91,0:52:50.54,Lalai,Kus4,0,0,0,,terletak di sebelah permaisuri.
Dialog: 0,0:52:51.08,0:52:52.74,Lalai,Kus4,0,0,0,,Mesyuarat ini rosak.
Dialog: 0,0:52:53.24,0:52:54.71,Lalai,Kus4,0,0,0,,Saya akan kembali ke Dongmyeongjong.
Dialog: 0,0:53:06.96,0:53:09.86,Lalai,Kus4,0,0,0,,Saya pasti akan menghukum anak itu kerana melanggar rancangan kita.
Dialog: 0,0:53:10.46,0:53:12.50,Lalai,Kus4,0,0,0,,Anda juga akan bertanggungjawab,
Dialog: 0,0:53:12.93,0:53:14.80,Lalai,Kus4,0,0,0,,supaya tidak membahayakan keluarga kita.
Dialog: 0,0:53:22.27,0:53:23.44,Lalai,Nanas5,0,0,0,,Apa yang akan berlaku padanya sekarang?
Dialog: 0,0:53:23.54,0:53:26.21, Lalai, Nanas5,0,0,0,, Mereka tidak akan memukul gadis itu, bukan?
Dialog: 0,0:53:26.41,0:53:28.08, Lalai, Nanas5,0,0,0,,Adakah anda pasti anda baik-baik saja?
Dialog: 0,0:53:28.08,0:53:30.88, Lalai, Nanas5,0,0,0,,Mungkin lidah anda kelu atau jantung anda berdegup gila?
Dialog: 0,0:53:32.05,0:53:33.68,Lalai,Nanas5,0,0,0,,Apa yang kamu cakapkan?\Betul...
Dialog: 0,0:53:33.68,0:53:35.09,Lalai,Nanas5,0,0,0,,Bukan di sini.
Dialog: 0,0:53:36.19,0:53:38.06, Lalai, Nanas5,0,0,0,, Permaisuri dan saya akan ke Daejojon.
Dialog: 0,0:53:38.66,0:53:39.96, Lalai, Nanas5,0,0,0,,Ya, tuan.
Dialog: 0,0:53:55.34,0:53:57.34,Lalai,Nanas5,0,0,0,,Sila, mulai sekarang
Dialog: 0,0:53:57.91,0:54:00.51, Lalai, Nanas5,0,0,0,, tonton semua yang anda makan atau minum.
Dialog: 0,0:54:01.35,0:54:03.25, Lalai, Nanas5,0,0,0,,Adakah saya mengganggu seseorang?
Dialog: 0,0:54:06.18,0:54:09.99,Lalai,Nanas5,0,0,0,,Saya pasti Kim Jwageun dan Ratu Janda cuba meracuni awak.
Dialog: 0,0:54:11.32,0:54:14.36,Lalai,Nanas5,0,0,0,,Sesetengah jenis karut. Saya tidak melakukan apa-apa!
Dialog: 0,0:54:16.86,0:54:20.40,Lalai,Nanas5,0,0,0,,Atau adakah semuanya kerana saya membantu majlis kenduri itu?
Dialog: 0,0:54:21.27,0:54:22.67, Lalai, Nanas5,0,0,0,,Ditemui di dalam bilik anda
Dialog: 0,0:54:24.23,0:54:25.94, Lalai, Nanas5,0,0,0,,buku akaun.
Dialog: 0,0:54:26.97,0:54:28.01, Lalai, Nanas5,0,0,0,,Buku akaun?
Dialog: 0,0:54:30.61,0:54:33.34,Lalai,Nanas5,0,0,0,,Jadi Kim Jwageun dan ayah saya bertanya kepada saya tentang dia.
Dialog: 0,0:54:34.24,0:54:36.25, Lalai, Nanas5,0,0,0,,Apa yang salah dengan buku ini?
Dialog: 0,0:54:37.28,0:54:39.42, Lalai, Nanas5,0,0,0,,Anda tidak membawanya bersama anda dari rumah?
Dialog: 0,0:54:40.02,0:54:41.62, Lalai, Nanas5,0,0,0,,Ya, saya tidak tahu bahawa dia wujud.
Dialog: 0,0:54:41.62,0:54:44.02, Lalai, Nanas5,0,0,0,,Saya tidak pernah melihatnya di rumah, dan lebih-lebih lagi di sini.
Dialog: 0,0:54:45.82,0:54:47.02,Lalai,Nanas5,0,0,0,,Begitulah keadaannya.
Dialog: 0,0:54:47.83,0:54:49.79,Lalai,Nanas5,0,0,0,,Mereka mahu meracuni, bukan menggulingkan.
Dialog: 0,0:54:51.73,0:54:53.66,Lalai,Nanas5,0,0,0,,Jadi Damhyang selamatkan saya?
Dialog: 0,0:54:54.13,0:54:55.20, Lalai, Nanas5,0,0,0,, Ternyata begini.
Dialog: 0,0:54:55.43,0:54:56.90, Lalai, Nanas5,0,0,0,,Racun dalam minuman.
Dialog: 0,0:54:58.07,0:55:00.10, Lalai, Nanas5,0,0,0,,Saya meneguk beberapa kali.
Dialog: 0,0:55:00.44,0:55:03.24, Lalai, Nanas5,0,0,0,,Saya akan mengetahui segala-galanya daripada Damhyang.
Dialog: 0,0:55:03.57,0:55:05.01, Lalai, Nanas5,0,0,0,,Saya akan tanya dia sendiri.
Dialog: 0,0:55:05.34,0:55:07.85, Lalai, Nanas5,0,0,0,,Adakah dia akan baik-baik saja?\NSdia tidak sepatutnya cedera.
Dialog: 0,0:55:08.21,0:55:10.35,Lalai,Nanas5,0,0,0,,Orang yang merancang untuk meracuni kamu,
Dialog: 0,0:55:10.35,0:55:11.88,Lalai,Nanas5,0,0,0,,tidak akan membiarkan dia pergi begitu sahaja.
Dialog: 0,0:55:14.45,0:55:16.49, Lalai, Nanas5,0,0,0,, Selamatkan dia, saya mohon.
Dialog: 0,0:55:22.16,0:55:23.79, Lalai, Nanas5,0,0,0,,Saya akan melakukan yang terbaik.
Dialog: 0,0:56:17.18,0:56:20.15, Lalai, Nanas5,0,0,0,,Saya tidak melakukan sebarang jenayah.
Dialog: 0,0:56:20.78,0:56:22.22, Lalai, Nanas5,0,0,0,,Saya tidak mencuri wang ini.
Dialog: 0,0:56:23.05,0:56:25.49, Lalai, Nanas5,0,0,0,,Saya telah menyimpannya selama bertahun-tahun,
Dialog: 0,0:56:25.49,0:56:27.32, Lalai, Nanas5,0,0,0,,untuk menebus anak bongsu daripada perhambaan.
Dialog: 0,0:56:32.20,0:56:33.30,Lalai,Nanas5,0,0,0,,Tolong belas kasihan.
Dialog: 0,0:56:34.46,0:56:36.93,Lalai,Nanas5,0,0,0,,Jika saya mati, bongsu saya...
Dialog: 0,0:56:42.64,0:56:44.11, Lalai, Nanas5,0,0,0,,Sebut semua yang anda tahu
Dialog: 0,0:56:45.91,0:56:47.11, Lalai, Nanas5,0,0,0,,tentang norig ini.
Dialog: 0,0:57:02.73,0:57:04.90,Lalai,Nanas5,0,0,0,,-Damhyang!\N-Yang Mulia!
Dialog: 0,0:57:06.03,0:57:08.10,Lalai,Nanas5,0,0,0,,Adakah awak okey, ratu?
Dialog: 0,0:57:08.10,0:57:09.90,Lalai,Nanas5,0,0,0,,Saya perlu bertanya perkara ini kepada anda.
Dialog: 0,0:57:10.30,0:57:12.04,Lalai,Nanas5,0,0,0,,Alangkah untungnya anda mencuba
Dialog: 0,0:57:12.47,0:57:16.24, Lalai, Nanas5,0,0,0,,minum sebelum ais cair.
Dialog: 0,0:57:17.98,0:57:18.98, Lalai, Nanas5,0,0,0,, Ais?
Dialog: 0,0:57:20.41,0:57:21.71, Lalai, Nanas5,0,0,0,,Terjemah dia sekarang!
Dialog: 0,0:57:21.71,0:57:22.71, Lalai, Nanas5,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:57:25.52,0:57:27.99,Lalai,Nanas5,0,0,0,,Ke mana anda hendak memindahkannya? di mana?
Dialog: 0,0:57:32.26,0:57:34.56,Lalai,Nanas5,0,0,0,,Tuanku, anda tidak sepatutnya berada di sini.
Dialog: 0,0:57:34.99,0:57:37.19, Lalai, Nanas5,0,0,0,,Anda tahu bahawa dia tidak boleh dipersalahkan untuk apa-apa.
Dialog: 0,0:57:37.19,0:57:38.60, Lalai, Nanas5,0,0,0,,Saya tidak faham awak.
Dialog: 0,0:57:40.93,0:57:43.50,Lalai,Nanas5,0,0,0,,Dia hanya bersalah kerana menyelamatkan saya.
Dialog: 0,0:57:44.33,0:57:46.60,Lalai,Nanas5,0,0,0,,Saya tidak tahu siapa yang memberitahu anda perkara ini,\Ntapi tolong,
Dialog: 0,0:57:46.94,0:57:48.21, Lalai, Nanas5,0,0,0,,kembali kepada diri sendiri.
Dialog: 0,0:57:51.01,0:57:52.11, Lalai, Nanas5,0,0,0,,Bagaimana jika saya menolak?
Dialog: 0,0:57:53.14,0:57:55.98,Lalai,Nanas5,0,0,0,,Gadis itu akan dibicarakan mengikut undang-undang.
Dialog: 0,0:57:56.98,0:57:59.22,Lalai,Nanas5,0,0,0,,Jika anda kekal, anda akan menderita.
Dialog: 0,0:58:00.45,0:58:02.29, Lalai, Nanas5,0,0,0,,Iringi permaisuri ke biliknya.
Dialog: 0,0:58:02.29,0:58:03.32, Lalai, Nanas5,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:58:07.56,0:58:09.79,Lalai,Nanas5,0,0,0,,-Lepaskan saya!\N-Saya akan menemani permaisuri.
Dialog: 0,0:58:18.17,0:58:20.00,Lalai,Nanas5,0,0,0,,Kembali kepada diri sendiri, ratu.
Dialog: 0,0:58:20.64,0:58:24.64, Lalai, Nanas5,0,0,0,,Skandal kuat\Nyou tidak akan membantu gadis ini dalam apa cara sekalipun.
Dialog: 0,0:58:26.41,0:58:27.44,Lalai,Nanas5,0,0,0,,Yang Mulia!
Dialog: 0,0:58:45.26,0:58:48.43,Lalai,Nenas5,0,0,0,,Damhyang, saya akan membebaskan awak tidak lama lagi.\NASetuju?
Dialog: 0,0:58:49.93,0:58:51.77, Lalai, Nanas5,0,0,0,, Jangan takut.
Dialog: 0,0:58:52.40,0:58:53.87,Lalai,Nanas5,0,0,0,,Baiklah.
Dialog: 0,0:58:55.94,0:58:58.48, Lalai, Nanas5,0,0,0,, Ratu, kita perlu pergi.
Dialog: 0,0:59:00.78,0:59:01.91, Lalai, Nanas5,0,0,0,,Saya akan membebaskan kamu.
Dialog: 0,0:59:27.50,0:59:31.37,Lalai,Nanas5,0,0,0,,Beraninya wanita mahkamah\Nmelempar batu ke arah permaisuri?
Dialog: 0,0:59:31.37,0:59:32.98, Lalai, Nanas5,0,0,0,,Ini adalah penghinaan kepada orang diraja!
Dialog: 0,0:59:32.98,0:59:36.35, Lalai, Nanas5,0,0,0,,Semuanya lebih teruk!\NIni sudah menjadi pengkhianatan!
Dialog: 0,0:59:37.18,0:59:39.15,Lalai,Nanas5,0,0,0,,Saya dengar bapanya dituduh menyimpang
Dialog: 0,0:59:39.15,0:59:41.15, Lalai, Nanas5,0,0,0,,daripada perkhidmatan tentera dan pengkhianatan.
Dialog: 0,0:59:41.15,0:59:42.85, Lalai, Nanas5,0,0,0,,Seperti yang mereka katakan, darah bukan air.
Dialog: 0,0:59:44.25,0:59:46.62,Lalai,Nanas5,0,0,0,,Menteri yang dihormati, anda bertindak keterlaluan.
Dialog: 0,0:59:46.62,0:59:49.86, Lalai, Nanas5,0,0,0,,Kami belum tahu apa yang mendorongnya untuk melakukan ini.
Dialog: 0,0:59:50.16,0:59:53.00, Lalai, Nanas5,0,0,0,,Pemberontakan petani\Nis mendapat momentum dan
Dialog: 0,0:59:53.00,0:59:55.27, Lalai, Nanas5,0,0,0,,mengancam kuasa diraja.
Dialog: 0,0:59:55.43,0:59:57.13,Lalai,Nanas5,0,0,0,,Menggunakan gadis ini sebagai contoh, kita mesti
Dialog: 0,0:59:57.13,0:59:58.97, Lalai, Nanas5,0,0,0,, kuatkan kuasa anda di kalangan rakyat.
Dialog: 0,0:59:58.97,1:00:00.97,Lalai,Nanas5,0,0,0,,Sekarang anda mengheret petani pemberontak?
Dialog: 0,1:00:00.97,1:00:04.44,Lalai,Nanas5,0,0,0,,Berani dia baling batu ke arah permaisuri?
Dialog: 0,1:00:04.44,1:00:07.34,Lalai,Nanas5,0,0,0,,Saya pasti penyamun itu telah mencuci otaknya!
Dialog: 0,1:00:07.58,1:00:11.25,Lalai,Nanas5,0,0,0,,Dicuci otak oleh penyamun?\NGadis itu baru berumur lima tahun.
Dialog: 0,1:00:11.25,1:00:13.02,Lalai,Nanas5,0,0,0,,Jangan menganggapnya sebagai angkuh,
Dialog: 0,1:00:13.25,1:00:15.82,Lalai,Nanas5,0,0,0,,tetapi ada yang percaya\Nbahawa anda, tuan,
Dialog: 0,1:00:16.15,1:00:19.32,Lalai,Nanas5,0,0,0,,tinggal di Ganghwado,\Nkami bercakap dengan penyamun pemberontak.
Dialog: 0,1:00:20.02,1:00:23.03,Lalai,Nanas5,0,0,0,,Sekarang anda memutuskan untuk mengancam saya dengan ini?
Dialog: 0,1:00:23.86,1:00:26.70,Lalai,Nanas5,0,0,0,,Jika anda enggan menghukum gadis itu\Nand cuba selamatkan dia,
Dialog: 0,1:00:27.03,1:00:31.54,Lalai,Nanas5,0,0,0,,anda hanya akan mengesahkan syak wasangka kami bahawa
Dialog: 0,1:00:32.24,1:00:34.17,Lalai,Nanas5,0,0,0,,bahawa anda bersetuju dengan penyamun.
Dialog: 0,1:00:35.41,1:00:38.34,Lalai,Nanas5,0,0,0,,Anda hanya perlu menghukum pembantu rumah kerana tidak taat.
Dialog: 0,1:00:38.98,1:00:40.68,Lalai,Nanas5,0,0,0,,Dan semuanya akan berakhir.
Dialog: 0,1:00:46.98,1:00:48.65,Lalai,Nanas5,0,0,0,,Dia akan dengar cakap kita, kan?
Dialog: 0,1:00:49.25,1:00:52.46,Lalai,Nanas5,0,0,0,,Janda Permaisuri\Meminta kami untuk menuntut hukuman.
Dialog: 0,1:00:53.09,1:00:55.43,Lalai,Nanas5,0,0,0,,Melepaskan kemarahannya kepadanya kerana
Dialog: 0,1:00:55.43,1:00:57.06,Lalai,Nanas5,0,0,0,,bahawa dia telah disingkirkan daripada takhta?
Dialog: 0,1:00:57.49,1:00:59.80,Lalai,Nanas5,0,0,0,,Seperti gadis tidak berharga ini
Dialog: 0,1:00:59.80,1:01:04.17,Default,Nenas5,0,0,0,,berani menghalang kami daripada menyingkirkan ratu?
Dialog: 0,1:01:25.59,1:01:27.46,Lalai,Nanas5,0,0,0,,Apa yang mengambil masa yang lama?
Dialog: 0,1:01:28.59,1:01:29.99,Lalai,Nanas5,0,0,0,,Semuanya akan baik-baik saja, bukan?
Dialog: 0,1:01:30.69,1:01:33.50,Lalai,Nanas5,0,0,0,,Mesyuarat lewat sedemikian\Ntidak membawa kepada perkara yang baik.
Dialog: 0,1:01:36.17,1:01:37.80,Lalai,Nanas5,0,0,0,,-Yang Mulia.\N-Ya?
Dialog: 0,1:02:00.66,1:02:02.56,Lalai,Nanas5,0,0,0,,Di sini, Tuanku!
Dialog: 0,1:02:02.56,1:02:03.66,Lalai,Nanas5,0,0,0,,Baiklah.
Dialog: 0,1:02:09.40,1:02:12.84,Lalai,Nanas5,0,0,0,,Ingat detik ini sepanjang hayat anda.
Dialog: 0,1:02:13.17,1:02:18.01,Lalai,Nanas5,0,0,0,,Para pembesar istana\Nsepatutnya buta dan pekak terhadap apa yang berlaku,
Dialog: 0,1:02:18.98,1:02:22.85,Lalai,Nanas5,0,0,0,,tidak sepatutnya ada satu pun pemikiran memberontak dalam fikiran mereka.
Dialog: 0,1:02:23.48,1:02:26.15,Lalai,Nanas5,0,0,0,,Jika sekurang-kurangnya salah seorang daripada anda menyokong
Dialog: 0,1:02:26.15,1:02:29.75,Lalai,Nanas5,0,0,0,,pemberontakan petani, inilah yang menanti anda.
Dialog: 0,1:02:31.29,1:02:33.26,Lalai,Nanas5,0,0,0,,Pembantu rumah itu adalah kanak-kanak yang bodoh.
Dialog: 0,1:02:35.06,1:02:36.13,Lalai,Nanas5,0,0,0,,Senyap!
Dialog: 0,1:02:39.33,1:02:41.30,Lalai,Nanas5,0,0,0,,Saya fikir kita menangkap seseorang yang penting,
Dialog: 0,1:02:42.80,1:02:45.77,Lalai,Nanas5,0,0,0,,tetapi ini hanya kanak-kanak?\NIItu tidak dapat difahami!
Dialog: 0,1:02:54.74,1:02:55.78,Lalai,Nanas5,0,0,0,,Adakah kita lewat?
Dialog: 0,1:03:04.55,1:03:06.39,Lalai,Nanas5,0,0,0,,Sekarang anda tahu perasaan saya.
Dialog: 0,1:03:14.56,1:03:16.77,Lalai,Nanas5,0,0,0,,Dia mahu menyelamatkan anda.
Dialog: 0,1:03:17.97,1:03:19.20,Lalai,Nanas5,0,0,0,,Itulah sebabnya mereka membunuhnya.
Dialog: 0,1:03:21.07,1:03:22.87,Lalai,Nanas5,0,0,0,,Mereka mahu meracuni saya, tetapi Damhyan menghalangnya.
Dialog: 0,1:04:06.48,1:04:07.88,Lalai,Nanas5,0,0,0,,Dia tidak boleh dipersalahkan untuk apa-apa.
Dialog: 0,1:04:08.89,1:04:10.15,Lalai,Nanas5,0,0,0,,Anda sendiri yang mengatakannya,
Dialog: 0,1:04:11.49,1:04:15.59,Lalai,Nanas5,0,0,0,,mereka meletakkan dosa mereka pada seorang anak kecil!
Dialog: 0,1:04:21.56,1:04:22.80,Lalai,Nanas5,0,0,0,,Mengapa kamu tidak menyelamatkannya?
Dialog: 0,1:04:24.03,1:04:26.00,Lalai,Nanas5,0,0,0,,Dia menjadi mangsa atas nama sesuatu yang lebih hebat.
Dialog: 0,1:04:27.80,1:04:28.84,Lalai,Nanas5,0,0,0,,Lagi?
Dialog: 0,1:04:30.71,1:04:31.98,Lalai,Nanas5,0,0,0,,Adakah anda bercakap tentang kulit anda sendiri?
Dialog: 0,1:04:34.78,1:04:38.01,Lalai,Nanas5,0,0,0,,Bukankah anda memberitahu saya bahawa dunia ini tidak adil?
Dialog: 0,1:04:38.85,1:04:42.65,Lalai,Nanas5,0,0,0,,Pengorbanan yang tidak penting akan menghentikan\Nsesuatu yang lebih berbahaya!
Dialog: 0,1:04:44.09,1:04:45.26,Lalai,Nanas5,0,0,0,,Mangsa yang tidak penting?
Dialog: 0,1:04:48.32,1:04:49.43,Lalai,Nanas5,0,0,0,,Kerana
Dialog: 0,1:04:50.49,1:04:52.30,Lalai,Nanas5,0,0,0,,adakah dia hanya seorang gadis yang tidak berdaya?
Dialog: 0,1:04:56.00,1:04:57.43,Lalai,Nanas5,0,0,0,,Amaturisme adalah dosa.
Dialog: 0,1:04:58.97,1:05:01.20,Lalai,Nanas5,0,0,0,,Anda tidak dapat menyelamatkan gadis ini!
Dialog: 0,1:05:03.97,1:05:05.11,Lalai,Nanas5,0,0,0,,Anda seorang yang berdosa.
Dialog: 0,1:05:30.60,1:05:32.40, Lalai, Nanas5,0,0,0,,Jika anda tidak mahu bercakap,\Nperlukah kita menggunakan isyarat tangan?
Dialog: 0,1:05:32.40,1:05:33.50,Lalai,Nanas5,0,0,0,,Sebagai contoh, yang ini.
Dialog: 0,1:05:33.50,1:05:35.71,Lalai,Nanas5,0,0,0,,Ini bermakna saya berbohong.
Dialog: 0,1:05:36.04,1:05:37.17,Lalai,Nanas5,0,0,0,,Apa kata anda?
Dialog: 0,1:05:46.24,1:05:50.68,Lalai,Nanas5,0,0,0,,
Dialog: 0,1:06:06.37,1:06:08.81,Lalai,Nanas5,0,0,0,,Mulai hari ini, saya akan menjadi\Nyang paling gila di istana.
Dialog: 0,1:06:08.81,1:06:12.68,Lalai,Nanas5,0,0,0,,Saya akan tunjukkan kepada anda apa yang berlaku apabila anda marahkan saya.
Dialog: 0,1:06:12.68,1:06:14.74,Lalai,Nanas5,0,0,0,,Adakah anda cuba menyingkirkan ratu?
Dialog: 0,1:06:14.91,1:06:16.65,Lalai,Nanas5,0,0,0,,-Damhyan!\N-Damhyan!
Dialog: 0,1:06:18.01,1:06:19.25,Lalai,Nanas5,0,0,0,,Saya bertaruh semuanya!
Dialog: 0,1:06:19.25,1:06:20.65,Lalai,Nanas5,0,0,0,,Jangan pandang rendah Kim Byungin.
Dialog: 0,1:06:20.65,1:06:22.45,Lalai,Nanas5,0,0,0,,Puak Cho pun patuh kepadanya.
Dialog: 0,1:06:22.45,1:06:23.62,Lalai,Nanas5,0,0,0,,Mari kita menjadi sekutu.
Dialog: 0,1:06:23.62,1:06:26.49,Lalai,Nanas5,0,0,0,,Mulai sekarang, lupakan jarak.
Dialog: 0,1:06:26.49,1:06:28.02,Lalai,Nanas5,0,0,0,,Tenang, hati liar.
Dialog: 0,1:06:28.02,1:06:30.19,Lalai,Nanas5,0,0,0,,Semua ini hanyalah ujian.
Dialog: 0,1:06:30.19,1:06:32.43,Lalai,Nanas5,0,0,0,,Adakah anda mahu makan ramen?
Dialog: 0,0:13:26.28,0:13:28.28,Lalai,,0,0,0,,


