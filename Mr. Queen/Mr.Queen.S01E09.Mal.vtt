Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,bekerja,,0,0,0,,{\pos(801,256)}Bekerja pada siri:\N Lily, Tiramisu, Biryulka, Hos, Februari, Penyanyi
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:10.02,0:01:12.53,Lalai,FEBRUARI,0,0,0,,Mengapa anda mendedahkan diri anda kepada serangan?
Dialog: 0,0:01:14.69,0:01:15.76,Lalai,FEBRUARI,0,0,0,,Itu dia!
Dialog: 0,0:01:23.97,0:01:25.84,Lalai,FEBRUARI,0,0,0,,Ayo lupakan jarakkan hari ini.
Dialog: 0,0:01:32.05,0:01:33.08,Lalai,FEBRUARI,0,0,0,,Yang Mulia.
Dialog: 0,0:01:34.08,0:01:35.32,Lalai,FEBRUARI,0,0,0,,Adakah anda okey?
Dialog: 0,0:01:50.73,0:01:51.90,Lalai,FEBRUARI,0,0,0,,Siapa di sana?
Dialog: 0,0:02:08.05,0:02:11.62, Lalai, FEBRUARI,0,0,0,, Meninggalkan, dalam perjalanan keluar.
Dialog: 0,0:02:13.09,0:02:15.86,Lalai,FEBRUARI,0,0,0,,9 episod
Dialog: 0,0:02:41.85,0:02:45.19,Lalai,FEBRUARI,0,0,0,,Saya biarkan mereka tidur berasingan\Nuntuk berehat dengan tenang,
Dialog: 0,0:02:47.89,0:02:49.52,Lalai,FEBRUARI,0,0,0,,tetapi nampaknya saya tersilap sedikit.
Dialog: 0,0:02:49.96,0:02:52.59,Lalai,FEBRUARI,0,0,0,,Saya mendengar sesuatu terhempas.
Dialog: 0,0:02:52.59,0:02:54.39,Lalai,FEBRUARI,0,0,0,,Saya juga bangun kerana bunyi bising.
Dialog: 0,0:02:54.83,0:02:56.60,Lalai,FEBRUARI,0,0,0,,Dan pintu dipecahkan.
Dialog: 0,0:02:58.26,0:03:00.20,Lalai,FEBRUARI,0,0,0,,Perkara itu jelas najis, semuanya perlu diperiksa.
Dialog: 0,0:03:00.47,0:03:03.24,Lalai,FEBRUARI,0,0,0,,Tetapi kemudian kita akan mengganggu pasangan diraja.
Dialog: 0,0:03:11.11,0:03:13.62,Lalai,FEBRUARI,0,0,0,,Saya tidak akan terkejut jika kerana mereka\NRumah akan bergegar.
Dialog: 0,0:03:14.28,0:03:15.82, Lalai, FEBRUARI,0,0,0,, Pengantin baru, apa yang perlu diambil daripada mereka.
Dialog: 0,0:03:16.58,0:03:20.02,Lalai,FEBRUARI,0,0,0,,Kita mesti melindungi privasi mereka.
Dialog: 0,0:03:23.12,0:03:25.19,Lalai,FEBRUARI,0,0,0,,Jangan terlalu dekat dengan rumah.
Dialog: 0,0:03:25.69,0:03:26.69,Lalai,FEBRUARI,0,0,0,,Ya.
Dialog: 0,0:03:30.46,0:03:32.20,Lalai,FEBRUARI,0,0,0,,Saya akan pergi ke lampiran.
Dialog: 0,0:03:32.60,0:03:33.93,Lalai,FEBRUARI,0,0,0,,Adakah anda akan melindungi keamanan mereka?
Dialog: 0,0:03:35.37,0:03:37.37,Lalai,FEBRUARI,0,0,0,,-Ya.\N-Jaga mereka.
Dialog: 0,0:04:19.31,0:04:21.75,Lalai,FEBRUARI,0,0,0,,Kawal diri anda, wanita!
Dialog: 0,0:04:27.45,0:04:30.02,Lalai,FEBRUARI,0,0,0,,Dan anda terpaksa menciumnya?!
Dialog: 0,0:04:33.09,0:04:35.16,Lalai,FEBRUARI,0,0,0,,Adakah anda sedang mencari pergaduhan?
Dialog: 0,0:04:35.80,0:04:39.17,Lalai,FEBRUARI,0,0,0,,Kamu berdebat dengan siapa?
Dialog: 0,0:04:40.00,0:04:41.17, Lalai, FEBRUARI,0,0,0,,Jangan campur.
Dialog: 0,0:04:41.17,0:04:44.20,Lalai,FEBRUARI,0,0,0,,Ini hanya antara saya dan Kim So-yeon.
Dialog: 0,0:04:46.11,0:04:47.74,Lalai,FEBRUARI,0,0,0,,Sementara saya di sini,
Dialog: 0,0:04:47.74,0:04:49.61,Lalai,FEBRUARI,0,0,0,,Saya akan lakukan apa yang saya mahu dengan badan ini.
Dialog: 0,0:04:49.61,0:04:52.08,Lalai,FEBRUARI,0,0,0,,Jiwa yang ada di dalam badan adalah pemiliknya!
Dialog: 0,0:04:55.52,0:04:57.65,Lalai,FEBRUARI,0,0,0,,Nampaknya, awak masih mabuk.
Dialog: 0,0:04:58.45,0:05:01.02, Lalai, FEBRUARI,0,0,0,,Anda tidak nampak perbezaan antara mimpi dan realiti.
Dialog: 0,0:05:02.39,0:05:04.66,Lalai,FEBRUARI,0,0,0,,-Saya ada batu dalam jiwa saya.\N-Apa yang awak cakapkan?
Dialog: 0,0:05:05.12,0:05:07.74,Lalai,FEBRUARI,0,0,0,,Ya, saya boleh berjalan pulang ke rumah saya sendiri dalam apa jua keadaan.
Dialog: 0,0:05:26.85,0:05:28.28, Lalai, FEBRUARI,0,0,0,,No. Ini bukan mimpi.
Dialog: 0,0:05:29.62,0:05:31.99,Lalai,FEBRUARI,0,0,0,,Kenapa awak muncul dalam mimpi saya.
Dialog: 0,0:05:34.25,0:05:36.66,Lalai,FEBRUARI,0,0,0,,Maaf kerana muncul
Dialog: 0,0:05:39.03,0:05:40.33,Lalai,FEBRUARI,0,0,0,,dalam mimpi anda.
Dialog: 0,0:06:03.65,0:06:05.42,Lalai,FEBRUARI,0,0,0,,Lupakan mimpi ngeri ini.
Dialog: 0,0:06:36.45,0:06:39.52,Lalai,FEBRUARI,0,0,0,,9 episod: Terang dan Kegelapan
Dialog: 0,0:08:38.17,0:08:40.34,Lalai,FEBRUARI,0,0,0,,Hong Young, geli.
Dialog: 0,0:09:11.87,0:09:15.04,Lalai,FEBRUARI,0,0,0,,Dia tiada di sini. Jika dia tiada di rumah, di mana?
Dialog: 0,0:09:18.61,0:09:20.21,Lalai,FEBRUARI,0,0,0,,Sesuatu yang salah?
Dialog: 0,0:09:23.02,0:09:24.85,Lalai,FEBRUARI,0,0,0,,Dia tidak risau kerana masa lalu.
Dialog: 0,0:10:19.84,0:10:22.44,Lalai,FEBRUARI,0,0,0,,-Hei, hei.\N-Apa?
Dialog: 0,0:10:22.44,0:10:23.98,Lalai,FEBRUARI,0,0,0,,Mereka memberitahu saya untuk tidak menghampiri rumah.
Dialog: 0,0:10:23.98,0:10:25.81, Lalai, FEBRUARI,0,0,0,,-Kenapa?\N-Saya tidak tahu.
Dialog: 0,0:10:26.48,0:10:28.31,Lalai,FEBRUARI,0,0,0,,-Duduk.\N-Baiklah.
Dialog: 0,0:10:30.05,0:10:32.95, Lalai, FEBRUARI,0,0,0,, Sejujurnya, saya bimbang tentang Baginda.
Dialog: 0,0:10:32.95,0:10:34.09,Lalai,FEBRUARI,0,0,0,,Pernahkah anda mendengar apa-apa tentang dia?
Dialog: 0,0:10:34.69,0:10:36.19,Lalai,FEBRUARI,0,0,0,,Tentang ratu?
Dialog: 0,0:10:36.19,0:10:37.22,Lalai,FEBRUARI,0,0,0,,Dia berlari mengelilingi istana
Dialog: 0,0:10:37.22,0:10:38.29,Lalai,FEBRUARI,0,0,0,,setiap pagi.
Dialog: 0,0:10:38.29,0:10:40.53, Lalai, FEBRUARI,0,0,0,,Jangan cakap kosong.
Dialog: 0,0:10:40.53,0:10:43.90,Lalai,FEBRUARI,0,0,0,,Saya mengenalinya sejak dia masih bayi.\Ndia tidak pernah berlari semasa dia dilahirkan.
Dialog: 0,0:10:43.90,0:10:46.73,Lalai,FEBRUARI,0,0,0,,-Anda berbohong.\N-Memang benar.
Dialog: 0,0:10:48.37,0:10:51.04, Lalai, FEBRUARI,0,0,0,,-Dan ia pelik.\N-Tetapi itulah yang mereka katakan.
Dialog: 0,0:10:51.30,0:10:52.77, Lalai, FEBRUARI,0,0,0,,-Tidak.\N-Saya tidak percaya!
Dialog: 0,0:10:52.87,0:10:53.87,Lalai,FEBRUARI,0,0,0,,Saya bercakap benar.
Dialog: 0,0:10:56.11,0:10:58.98, Lalai, FEBRUARI,0,0,0,,-Ayam!\N-Tangkap mereka.
Dialog: 0,0:11:01.45,0:11:02.82,Lalai,FEBRUARI,0,0,0,,Berhenti, berbulu!
Dialog: 0,0:11:18.83,0:11:20.83,Lalai,FEBRUARI,0,0,0,,Dia memakai pakaian Jabatan Detektif.
Dialog: 0,0:11:21.83,0:11:22.97,Lalai,FEBRUARI,0,0,0,,Jadi...
Dialog: 0,0:11:36.12,0:11:38.72,Lalai,FEBRUARI,0,0,0,,Anda akan mabuk sampai mati. Berhenti.
Dialog: 0,0:11:41.02,0:11:42.79,Lalai,FEBRUARI,0,0,0,,Seksa dahaga.
Dialog: 0,0:11:42.82,0:11:45.62,Lalai,FEBRUARI,0,0,0,,Semakin saya fikir betapa besarnya dosa ini,\Nsemakin saya dahaga.
Dialog: 0,0:11:48.33,0:11:50.76,Lalai,FEBRUARI,0,0,0,,Seperti saya mati kehausan.
Dialog: 0,0:11:51.66,0:11:54.37,Lalai,FEBRUARI,0,0,0,,Jika anda dahaga, minum air, bukan wain.
Dialog: 0,0:11:58.90,0:12:01.14,Lalai,FEBRUARI,0,0,0,,Hei, bawa kami air.
Dialog: 0,0:12:01.71,0:12:02.74,Lalai,FEBRUARI,0,0,0,,Ya.
Dialog: 0,0:12:05.64,0:12:10.02,Lalai,FEBRUARI,0,0,0,,Lebih banyak wain anda minum, lebih banyak anda mahu minum.
Dialog: 0,0:12:27.57,0:12:30.44,Lalai,FEBRUARI,0,0,0,,Tidur lena, seolah-olah seseorang telah mengetuk saya.
Dialog: 0,0:12:33.67,0:12:35.01,Lalai,FEBRUARI,0,0,0,,Saya faham awak.
Dialog: 0,0:12:35.61,0:12:37.58,Lalai,FEBRUARI,0,0,0,,Badan itu dipenuhi dengan ringan.
Dialog: 0,0:12:38.04,0:12:40.58,Lalai,FEBRUARI,0,0,0,,Anda. awak.
Dialog: 0,0:12:44.92,0:12:49.36,Lalai,FEBRUARI,0,0,0,,Rumah ini mesti dibina di atas tanah yang baik. Saya mempunyai tidur malam yang lena.
Dialog: 0,0:12:50.42,0:12:52.86,Lalai,FEBRUARI,0,0,0,,Adakah perkara biasa anda bangun bersama saya?
Dialog: 0,0:12:56.93,0:12:58.76,Lalai,FEBRUARI,0,0,0,,Adakah ini tidak normal?
Dialog: 0,0:12:59.33,0:13:01.47,Lalai,FEBRUARI,0,0,0,,Ini bukan istana - tarikh malam bersama tidak dipilih.
Dialog: 0,0:13:01.47,0:13:03.87, Lalai, FEBRUARI,0,0,0,,Semestinya di rumah ayah kita berkongsi satu katil.
Dialog: 0,0:13:04.54,0:13:06.44,Lalai,FEBRUARI,0,0,0,,Logik.
Dialog: 0,0:13:06.44,0:13:08.74,Lalai,FEBRUARI,0,0,0,,Dalam kem musuh, anda harus\Nbersama saya - penutup terbaik.
Dialog: 0,0:13:09.31,0:13:11.48,Lalai,FEBRUARI,0,0,0,,Permainan anda hari ini adalah kelas atas.
Dialog: 0,0:13:13.01,0:13:15.82,Lalai,FEBRUARI,0,0,0,,Baiklah, mari kita berpura-pura kita menghabiskan malam yang panas bersama.
Dialog: 0,0:13:16.15,0:13:18.72,Lalai,FEBRUARI,0,0,0,,Ia sangat panas sehingga kami membalikkannya...
Dialog: 0,0:13:25.09,0:13:26.09,Lalai,FEBRUARI,0,0,0,,Apa?
Dialog: 0,0:13:26.39,0:13:27.99,Lalai,FEBRUARI,0,0,0,,Nampaknya anda masih ingat malam ini.
Dialog: 0,0:13:28.23,0:13:29.86,Lalai,FEBRUARI,0,0,0,,Sayang jika anda melupakannya,
Dialog: 0,0:13:29.86,0:13:31.46, Lalai, FEBRUARI,0,0,0,, seperti yang pertama kami.
Dialog: 0,0:13:32.30,0:13:34.23,Lalai,FEBRUARI,0,0,0,,Adakah kerana ingatan telah kembali?
Dialog: 0,0:13:35.87,0:13:39.04,Lalai,FEBRUARI,0,0,0,,Saya tidur seperti bayi.
Dialog: 0,0:13:52.15,0:13:54.55,Lalai,FEBRUARI,0,0,0,,Saya tiada masa untuk bermain helah.
Dialog: 0,0:13:55.12,0:13:57.89,Lalai,FEBRUARI,0,0,0,,Anda mesti menjadi ace ratu janda.
Dialog: 0,0:13:58.36,0:14:00.59,Lalai,FEBRUARI,0,0,0,,Walaupun sesuatu berlaku kepada keluarga Han,
Dialog: 0,0:14:00.69,0:14:02.13, Lalai, FEBRUARI,0,0,0,, mereka tidak dapat menghubungi saya.
Dialog: 0,0:14:03.36,0:14:07.03,Lalai,FEBRUARI,0,0,0,,Lelaki bertopeng itu dan saya sedang mencari perkara yang sama.
Dialog: 0,0:14:07.80,0:14:10.00,Lalai,FEBRUARI,0,0,0,,Berapa banyak yang Kim Byungin sudah tahu?
Dialog: 0,0:14:10.74,0:14:13.54,Lalai,FEBRUARI,0,0,0,,Buku perakaunan tidak sepatutnya jatuh ke tangan mereka.
Dialog: 0,0:14:16.78,0:14:19.81,Lalai,FEBRUARI,0,0,0,,Hari ini saya akan kembali ke istana walau apa cara sekalipun.
Dialog: 0,0:14:20.75,0:14:24.25,Lalai,FEBRUARI,0,0,0,,Hari ini saya akan mencari buku itu tidak kira dalam apa jua keadaan.
Dialog: 0,0:14:34.03,0:14:36.16,Lalai,FEBRUARI,0,0,0,,Anda masih boleh jatuh sakit.
Dialog: 0,0:14:37.13,0:14:39.33,Lalai,FEBRUARI,0,0,0,,Bila permaisuri pulang ke istana?
Dialog: 0,0:14:39.87,0:14:43.54,Lalai,FEBRUARI,0,0,0,,Saya akan menghantar berita untuknya dan Baginda\Nuntuk kembali secepat mungkin.
Dialog: 0,0:14:43.87,0:14:47.01,Lalai,FEBRUARI,0,0,0,,Saya tidak pernah mendapati kehidupan di istana membosankan.
Dialog: 0,0:14:47.01,0:14:50.18,Lalai,FEBRUARI,0,0,0,,Tetapi permaisuri baru sahaja pergi beberapa hari,\Nand di sini ia sudah sunyi.
Dialog: 0,0:14:50.88,0:14:54.38,Lalai,FEBRUARI,0,0,0,,Masakan Baginda sangat indah?
Dialog: 0,0:14:54.68,0:14:57.82,Lalai,FEBRUARI,0,0,0,,Ini bukan tentang masakannya.\NSDia comel bagi saya.
Dialog: 0,0:15:00.72,0:15:02.45,Lalai,FEBRUARI,0,0,0,,Lampiran berbahaya.
Dialog: 0,0:15:02.92,0:15:05.19,Lalai,FEBRUARI,0,0,0,,Pagi tadi saya lapar...
Dialog: 0,0:15:05.59,0:15:06.63,Lalai,FEBRUARI,0,0,0,,Iaitu
Dialog: 0,0:15:08.23,0:15:10.66,Default,FEBRUARI,0,0,0,,Saya bangun awal, merindui permaisuri tersayang.
Dialog: 0,0:15:10.80,0:15:12.36,Lalai,FEBRUARI,0,0,0,,Saya faham awak.
Dialog: 0,0:15:12.36,0:15:15.07,Lalai,FEBRUARI,0,0,0,,Memang menakutkan untuk menyedari bahawa anda telah dijinakkan.
Dialog: 0,0:15:19.24,0:15:21.47,Lalai,FEBRUARI,0,0,0,,Nampaknya anda yang menggunakan orang lain,
Dialog: 0,0:15:22.14,0:15:25.04,Lalai,FEBRUARI,0,0,0,,tetapi pada satu ketika ternyata mereka telah menjinakkan anda.
Dialog: 0,0:15:26.05,0:15:29.18,Lalai,FEBRUARI,0,0,0,,Jadi anda harus mencari lebih ramai orang yang berguna kepada anda.
Dialog: 0,0:15:29.45,0:15:33.79,Lalai,FEBRUARI,0,0,0,,Saya akan mengarahkan chef diraja untuk mempelajari resipi Baginda.
Dialog: 0,0:15:34.85,0:15:38.29,Lalai,FEBRUARI,0,0,0,,Awak jadikan hidup saya di istana syurga.
Dialog: 0,0:15:38.69,0:15:40.89,Lalai,FEBRUARI,0,0,0,,Saya tiada sebab untuk meninggalkan dia.
Dialog: 0,0:15:41.39,0:15:43.83,Lalai,FEBRUARI,0,0,0,,Itulah sebabnya saya berada di tempat saya -
Dialog: 0,0:15:43.83,0:15:46.70,Lalai,FEBRUARI,0,0,0,,untuk menjaga syurga ini, Tuanku.
Dialog: 0,0:15:50.50,0:15:51.64,Lalai,FEBRUARI,0,0,0,,By the way.
Dialog: 0,0:15:51.64,0:15:54.71,Lalai,FEBRUARI,0,0,0,,Suruh Benin datang berjumpa saya kadang-kadang.
Dialog: 0,0:15:56.84,0:15:58.01,Lalai,FEBRUARI,0,0,0,,Anda mahu
Dialog: 0,0:15:59.41,0:16:00.98,Lalai,FEBRUARI,0,0,0,,cakap dengan dia?
Dialog: 0,0:16:01.21,0:16:04.18,Lalai,FEBRUARI,0,0,0,,Namun, dia anak angkat awak.\NI sudah cukup mengabaikannya.
Dialog: 0,0:16:04.95,0:16:07.49,Lalai,FEBRUARI,0,0,0,,Sudah tiba masanya untuk memberinya arahan dari semasa ke semasa.
Dialog: 0,0:16:08.29,0:16:10.66, Lalai, FEBRUARI,0,0,0,,Anda masih belum menjadi lebih muda.
Dialog: 0,0:16:11.06,0:16:12.73,Lalai,FEBRUARI,0,0,0,,Lakukan perkara penting sahaja.
Dialog: 0,0:16:12.99,0:16:15.96,Lalai,FEBRUARI,0,0,0,,Segala perkara yang berkaitan dengan anda adalah penting bagi saya.
Dialog: 0,0:16:54.57,0:16:55.80,Lalai,FEBRUARI,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:17:01.01,0:17:02.81, Lalai, FEBRUARI,0,0,0,, Jabatan Detektif
Dialog: 0,0:17:02.81,0:17:05.28,Lalai,FEBRUARI,0,0,0,,akan memeriksa setiap pengawal raja.
Dialog: 0,0:17:06.31,0:17:09.01,Lalai,FEBRUARI,0,0,0,,Anda melindungi nyawa raja dan sentiasa di sisinya -
Dialog: 0,0:17:09.55,0:17:12.79,Lalai,FEBRUARI,0,0,0,,kita perlu memastikan segala-galanya.
Dialog: 0,0:17:15.22,0:17:16.86, Lalai, FEBRUARI,0,0,0,,Jangan biarkan mereka mengambil langkah!
Dialog: 0,0:17:27.30,0:17:29.10,Lalai,FEBRUARI,0,0,0,,Setiap orang di sini telah lulus
Dialog: 0,0:17:30.34,0:17:31.87,Lalai,FEBRUARI,0,0,0,,cek penuh.
Dialog: 0,0:17:36.61,0:17:38.58,Lalai,FEBRUARI,0,0,0,,Anda boleh membeli silsilah.
Dialog: 0,0:17:39.04,0:17:40.25,Lalai,FEBRUARI,0,0,0,,Anda tidak pernah tahu.
Dialog: 0,0:17:41.25,0:17:42.48,Lalai,FEBRUARI,0,0,0,,Seseorang daripada pengawal
Dialog: 0,0:17:42.48,0:17:44.52,Lalai,FEBRUARI,0,0,0,,boleh menyediakan pengkhianatan atas nama orang lain.
Dialog: 0,0:17:45.82,0:17:48.19,Lalai,FEBRUARI,0,0,0,,Berikan bantuan - kami menjalankan tugas kami.
Dialog: 0,0:17:52.12,0:17:54.96,Lalai,FEBRUARI,0,0,0,,Jika anda tidak menjumpai bukti tuduhan anda,
Dialog: 0,0:17:56.43,0:17:57.56,Lalai,FEBRUARI,0,0,0,,i
Dialog: 0,0:17:59.03,0:18:01.00, Lalai, FEBRUARI,0,0,0,,Saya akan menggunakan kuasa saya.
Dialog: 0,0:18:01.30,0:18:03.77,Lalai,FEBRUARI,0,0,0,,Ini adalah jika anda menyimpan siaran anda.
Dialog: 0,0:18:04.54,0:18:07.97,Lalai,FEBRUARI,0,0,0,,Jika anda tidak terlibat dalam pengkhianatan, tinggalkan.
Dialog: 0,0:18:18.12,0:18:19.72,Lalai,FEBRUARI,0,0,0,,-Cari di mana-mana.\N-Ya.
Dialog: 0,0:18:32.53,0:18:33.83, Lalai, FEBRUARI,0,0,0,, Cari setiap sudut.
Dialog: 0,0:18:34.70,0:18:36.87, Lalai, FEBRUARI,0,0,0,, Tarik balik semua dokumen.
Dialog: 0,0:18:36.87,0:18:38.60,Lalai,FEBRUARI,0,0,0,,Dan bawa ke Jabatan Detektif.
Dialog: 0,0:18:38.80,0:18:39.94,Lalai,FEBRUARI,0,0,0,,-Ya!\N-Ya!
Dialog: 0,0:18:55.29,0:18:57.32,Lalai,FEBRUARI,0,0,0,,Saya harap anda tidur lena.
Dialog: 0,0:18:58.56,0:19:01.06,Lalai,FEBRUARI,0,0,0,,Saya bawa seekor burung yang cantik.
Dialog: 0,0:19:01.06,0:19:02.16, Lalai, FEBRUARI,0,0,0,, Bagaimanakah anda menyukainya?
Dialog: 0,0:19:03.00,0:19:04.93,Lalai,FEBRUARI,0,0,0,,Dia mempunyai bulu yang cantik.
Dialog: 0,0:19:05.50,0:19:08.83,Lalai,FEBRUARI,0,0,0,,Burung berharga ini menggembirakan saya dengan berita baik.
Dialog: 0,0:19:12.47,0:19:15.34,Lalai,FEBRUARI,0,0,0,,Adakah terdapat sebarang berita baik?
Dialog: 0,0:19:15.34,0:19:17.81,Lalai,FEBRUARI,0,0,0,,Pertelingkahan antara permaisuri dan
Dialog: 0,0:19:17.81,0:19:20.45,Lalai,FEBRUARI,0,0,0,,gundik diraja Cho lebih kuat daripada yang saya sangka.
Dialog: 0,0:19:22.01,0:19:23.78,Lalai,FEBRUARI,0,0,0,,Ada sesuatu yang saya tidak beritahu anda.
Dialog: 0,0:19:24.85,0:19:26.75,Lalai,FEBRUARI,0,0,0,,Tiada siapa yang tahu tentang perkara ini.
Dialog: 0,0:19:26.75,0:19:28.65,Lalai,FEBRUARI,0,0,0,,Hanya saya dan permaisuri.
Dialog: 0,0:19:31.96,0:19:36.16,Lalai,FEBRUARI,0,0,0,,Disebabkan apa yang berlaku 8 tahun lalu, Baginda yakin
Dialog: 0,0:19:38.10,0:19:39.36,Lalai,FEBRUARI,0,0,0,,bahawa saya telah mencuri raja daripadanya.
Dialog: 0,0:19:40.70,0:19:44.24,Lalai,FEBRUARI,0,0,0,,Racun pada anak panah kita semakin kuat.
Dialog: 0,0:19:44.97,0:19:47.97,Lalai,FEBRUARI,0,0,0,,Sudah tiba masanya untuk menggunakan perkara kedua.
Dialog: 0,0:19:47.97,0:19:49.04,Lalai,FEBRUARI,0,0,0,,Ya.
Dialog: 0,0:19:50.11,0:19:52.85,Lalai,FEBRUARI,0,0,0,,Sukar untuk mencari sesuatu yang serupa,
Dialog: 0,0:19:53.28,0:19:55.61,Lalai,FEBRUARI,0,0,0,,ini akan mengambil sedikit masa.
Dialog: 0,0:19:56.48,0:20:00.12,Lalai,FEBRUARI,0,0,0,,Tetapi saya akan bawakannya kepada anda,\Walaupun saya perlu membuatnya sendiri.
Dialog: 0,0:20:13.53,0:20:14.77, Lalai,Spillik2,0,0,0,,Gunakan yang ini.
Dialog: 0,0:20:31.02,0:20:34.19,Lalai,Spillik2,0,0,0,,Dalam sekelip mata mereka mengetahui tentang pengawal diraja.
Dialog: 0,0:20:34.72,0:20:36.15,Lalai,Spikyulka2,0,0,0,,Mari kita cari jalan.
Dialog: 0,0:20:36.29,0:20:38.52,Lalai,Spikyulka2,0,0,0,,Semalam anda berjumpa dengan seorang lelaki dari Jabatan Detektif.
Dialog: 0,0:20:38.66,0:20:40.66,Lalai,Spillik2,0,0,0,,Dia nampak muka awak. Adakah ini akan menjadi masalah?
Dialog: 0,0:20:41.43,0:20:43.33, Lalai, Spikyulka2,0,0,0,,Saya rasa dia tidak mengenali saya.
Dialog: 0,0:20:44.03,0:20:46.47,Lalai,Spilyk2,0,0,0,,Jika kita bertembung lagi,
Dialog: 0,0:20:47.53,0:20:49.84,Lalai,Spikyulka2,0,0,0,,dia akan faham bahawa saya sedang mencari buku perakaunan.
Dialog: 0,0:20:53.04,0:20:57.91,Lalai,Spillik2,0,0,0,,Dia memakai topeng yang jarang ditemui dalam bentuk tokkebi.
Dialog: 0,0:20:58.94,0:21:02.51,Lalai,Spillik2,0,0,0,,Adakah dia mempunyai parut?
Dialog: 0,0:21:03.48,0:21:05.65,Lalai,Spillik2,0,0,0,,Ya. Ia kelihatan seperti parut lama.
Dialog: 0,0:21:06.12,0:21:07.92,Lalai,Spikyulka2,0,0,0,,Dia adalah salah seorang yang menyeksa Ovol.
Dialog: 0,0:21:09.79,0:21:11.82,Lalai,Spikyulka2,0,0,0,,Jadi, Kim Jwageun
Dialog: 0,0:21:11.82,0:21:13.93,Lalai,Spikyulka2,0,0,0,,berlakon melalui Kim Byonin.
Dialog: 0,0:21:15.16,0:21:16.30,Lalai,Spilyk2,0,0,0,,Mujurlah,
Dialog: 0,0:21:16.93,0:21:19.83,Lalai,Spikyulka2,0,0,0,,dia tidak tahu bahawa lokasi penyimpanan lejar perakaunan telah berubah.
Dialog: 0,0:21:21.93,0:21:23.64, Lalai, Spikyulka2,0,0,0,,Malam ini adalah peluang terakhir kita.
Dialog: 0,0:21:26.27,0:21:28.94,Lalai,Spikyulka2,0,0,0,,Yang Mulia, ada surat dari istana untuk tuanku.
Dialog: 0,0:21:31.88,0:21:34.65,Lalai,Spikyulka2,0,0,0,,Surat ini daripada Kim Jwagyn.
Dialog: 0,0:21:35.18,0:21:38.22,Lalai,Spikyulka2,0,0,0,,Dia dihantar oleh ketua Jabatan Detektif.
Dialog: 0,0:21:40.09,0:21:41.55,Lalai,Spikyulka2,0,0,0,,Mana-mana daripada jabatan ini
Dialog: 0,0:21:41.55,0:21:42.92,Lalai,Spikyulka2,0,0,0,,boleh menghantarnya dengan mudah.
Dialog: 0,0:21:42.92,0:21:44.32,Lalai,Spikyulka2,0,0,0,,Tetapi anda sendiri datang?
Dialog: 0,0:21:45.46,0:21:46.79,Lalai,Spilyk2,0,0,0,,Adakah anda mempunyai banyak masa lapang?
Dialog: 0,0:21:47.79,0:21:50.63,Lalai,Spikyulka2,0,0,0,,Saya membawanya secara peribadi kerana ia penting.
Dialog: 0,0:21:51.46,0:21:54.43,Lalai,Spillik2,0,0,0,,Yang Mulia dan Permaisuri diminta segera pulang ke istana.
Dialog: 0,0:21:55.90,0:21:57.90,Lalai,Spilyk2,0,0,0,,Komander tentera
Dialog: 0,0:21:57.90,0:22:00.04,Default,Spillik2,0,0,0,,menuntut saya kembali ke istana?
Dialog: 0,0:22:00.04,0:22:03.48,Lalai,Spillik2,0,0,0,,Dia menyampaikan mesej daripada Permaisuri Janda.
Dialog: 0,0:22:04.84,0:22:07.38,Lalai,Sutera2,0,0,0,,Saya akan tinggal di sini satu malam lagi demi kesihatan permaisuri.
Dialog: 0,0:22:07.38,0:22:08.68,Lalai,Spikyulka2,0,0,0,,-Beritahu mereka. \N-Tetapi...
Dialog: 0,0:22:08.68,0:22:09.92,Lalai,Spilyk2,0,0,0,,Itu sahaja.
Dialog: 0,0:22:11.35,0:22:13.59,Lalai,Spillik2,0,0,0,,Jangan ganggu ketenteraman ratu dan kembalilah.
Dialog: 0,0:22:18.02,0:22:19.12,Lalai,Spilyk2,0,0,0,,Begitulah.
Dialog: 0,0:22:21.63,0:22:26.63,Default,Spillik2,0,0,0,,Nampaknya Baginda amat mengambil berat tentang kesihatan permaisuri.
Dialog: 0,0:22:29.84,0:22:31.57,Lalai,Spilyk2,0,0,0,,Saya akan meneruskannya.
Dialog: 0,0:22:36.84,0:22:39.48,Lalai,Spilyk2,0,0,0,,Saya akan bersarapan di bilik permaisuri.
Dialog: 0,0:22:39.71,0:22:42.15, Lalai, Spilyk2,0,0,0,, Bawa sarapan biasa anda. Biar mudah sahaja.
Dialog: 0,0:22:42.15,0:22:43.32,Lalai,Spillik2,0,0,0,,Ya, Tuanku.
Dialog: 0,0:22:43.32,0:22:46.05,Lalai,Spilyk2,0,0,0,,Kami akan menyediakan sarapan biasa kami.
Dialog: 0,0:22:50.06,0:22:51.89,Lalai,Spillik2,0,0,0,,Rumah Gundik Cho berdekatan,
Dialog: 0,0:22:52.16,0:22:53.86,Lalai,Spikyulka2,0,0,0,,Saya akan mengetahui tentang Ovol dan kembali.
Dialog: 0,0:22:53.86,0:22:55.16,Lalai,Spillik2,0,0,0,,Idea yang bagus.
Dialog: 0,0:22:56.13,0:22:58.26,Lalai,Spiky2,0,0,0,,Saya berasa teruk selepas menghantarnya pergi.
Dialog: 0,0:22:58.73,0:23:00.67,Lalai,Spikyulka2,0,0,0,,Dan saya tidak akan berada di istana untuk satu malam lagi.
Dialog: 0,0:23:00.67,0:23:02.60,Lalai,Spillie2,0,0,0,,Sila jaga dia.
Dialog: 0,0:23:03.20,0:23:04.24,Lalai,Spilyk2,0,0,0,,Ya.
Dialog: 0,0:23:11.38,0:23:15.95,Lalai,Spikyulka2,0,0,0,,Permaisuri berkeliaran di sini sepanjang hari. Tetapi apabila dia sudah tiada,
Dialog: 0,0:23:16.85,0:23:19.82,Lalai,Spilyk2,0,0,0,,dapur diraja kelihatan begitu kosong.
Dialog: 0,0:23:25.16,0:23:27.16,Lalai,Spillik2,0,0,0,,Sekarang saya boleh bernafas semula.
Dialog: 0,0:23:31.10,0:23:34.23,Lalai,Spillik2,0,0,0,,Kau bajingan. Lebih banyak minyak rapeseed.
Dialog: 0,0:23:34.40,0:23:35.50,Lalai,Spilyk2,0,0,0,,Inilah yang tanpa senjata.
Dialog: 0,0:23:35.83,0:23:37.37, Lalai, Spillit2,0,0,0,,Potong lebih kecil.
Dialog: 0,0:23:38.34,0:23:40.44,Lalai,Spillik2,0,0,0,,Masak lebih cepat sebelum kehilangan bentuknya.
Dialog: 0,0:23:48.41,0:23:52.82,Lalai,Spillik2,0,0,0,,Betapa indah dan damai di sini.
Dialog: 0,0:23:53.15,0:23:55.49,Lalai,Spillik2,0,0,0,,Saya suka bertanggungjawab.
Dialog: 0,0:24:01.66,0:24:09.30, Lalai, Spilyk2,0,0,0,,-Chef Diraja! \N-Chef diraja!
Dialog: 0,0:24:09.30,0:24:13.04,Lalai,Spilyk2,0,0,0,,-Chef Diraja! \N-Chef diraja!
Dialog: 0,0:24:13.04,0:24:14.34,Lalai,Spilyk2,0,0,0,,-Cukup. \N-Chef diraja.
Dialog: 0,0:24:14.34,0:24:15.41,Lalai,Spilyk2,0,0,0,,-Masak diraja.
Dialog: 0,0:24:18.01,0:24:19.74,Lalai,Spillik2,0,0,0,,-Kembalilah. \N-Kami patuh.
Dialog: 0,0:24:20.11,0:24:21.35,Lalai,Spillit2,0,0,0,,Puan Mahkamah Choi.
Dialog: 0,0:24:24.28,0:24:25.52,Lalai,Spillit2,0,0,0,,Puan mahkamah Choi.
Dialog: 0,0:24:27.22,0:24:29.25,Lalai,Spillik2,0,0,0,,Melihat wajah anda,
Dialog: 0,0:24:30.26,0:24:33.56,Lalai,Spillik2,0,0,0,,Saya menyedari bahawa ratu masih belum pulih.
Dialog: 0,0:24:34.09,0:24:37.70,Lalai,Spilyk2,0,0,0,,Tidak, dia telah pulih sepenuhnya.
Dialog: 0,0:24:39.53,0:24:41.93,Lalai,Spikyulka2,0,0,0,,Lalu mengapa ia diturunkan ke dalam air?
Dialog: 0,0:24:43.97,0:24:48.77,Lalai,Spikyulka2,0,0,0,,Baru-baru ini, terima kasih kepada Yang Mulia, saya telah melalui begitu banyak perkara.
Dialog: 0,0:24:50.31,0:24:52.18,Lalai,Spikyulka2,0,0,0,,Saya fikir apabila dia tiada,
Dialog: 0,0:24:52.81,0:24:54.65,Lalai,Spilyk2,0,0,0,,Saya tidak perlu mencari kesalahan
Dialog: 0,0:24:55.25,0:24:57.08, Lalai, Spikyulka2,0,0,0, dan saya akan berasa lebih tenang.
Dialog: 0,0:24:57.82,0:24:58.95,Lalai,Spikyulka2,0,0,0,,Tetapi sebenarnya, bagaimana?
Dialog: 0,0:25:00.32,0:25:01.99,Lalai,Spillik2,0,0,0,,Saya semakin gila.
Dialog: 0,0:25:02.82,0:25:07.39,Lalai,Spikyulka2,0,0,0,,Saya takut mati tanpa saya dia akan menjauhkan diri sepenuhnya daripada saya.
Dialog: 0,0:25:07.69,0:25:11.20,Lalai,Spilyk2,0,0,0,,Inilah tawarannya. Mereka mengatakan bahawa terdapat lebih banyak kebimbangan mengenai khabar angin yang tidak didengari,
Dialog: 0,0:25:11.20,0:25:13.30,Lalai,Spikyulka2,0,0,0,,daripada kanak-kanak yang baik hati.
Dialog: 0,0:25:14.10,0:25:15.63,Lalai,Spillik2,0,0,0,,Berhenti mengemop.
Dialog: 0,0:25:15.77,0:25:16.97,Lalai,Spilyk2,0,0,0,,Di sini.
Dialog: 0,0:25:25.84,0:25:27.85,Lalai,Spillik2,0,0,0,,Buka.
Dialog: 0,0:25:34.79,0:25:36.02,Lalai,Spikyulka2,0,0,0,,Dijemput di jalan.
Dialog: 0,0:25:38.22,0:25:41.69,Lalai,Spilyk2,0,0,0,,Pada hari seperti ini
Dialog: 0,0:25:41.69,0:25:45.16, Lalai, Spillik2,0,0,0,, anda seperti saya, tetapi tidak.
Dialog: 0,0:25:45.16,0:25:48.33,Lalai,Spilyk2,0,0,0,,Pada hari seperti ini
Dialog: 0,0:25:48.33,0:25:51.54, Lalai, Spillik2,0,0,0,, anda seperti saya, tetapi tidak.
Dialog: 0,0:25:51.67,0:25:53.74,Lalai,Spikyulka2,0,0,0,,Dan hari-hari seperti ini anda seperti saya, tetapi tidak.
Dialog: 0,0:25:53.74,0:25:56.07,Lalai,Spikyulka2,0,0,0,,Dan kenapa dia memberi saya sampah yang dikumpul?
Dialog: 0,0:25:57.08,0:25:58.84,Lalai,Spillik2,0,0,0,,Sungguh mimpi ngeri.
Dialog: 0,0:25:59.81,0:26:01.78,Lalai,Spikyulka2,0,0,0,,Semakin saya mengenalinya, nampaknya semakin asing.
Dialog: 0,0:26:02.71,0:26:04.65,Lalai,Spikyulka2,0,0,0,,Saya boleh saja membuangnya, kenapa awak berikan kepada saya?
Dialog: 0,0:26:04.98,0:26:06.59,Lalai,Spillik2,0,0,0,,Itu sampah.
Dialog: 0,0:26:07.18,0:26:10.98,Lalai,Spikyulka2,0,0,0,,Adakah anda menerima berita daripada Ovol?
Dialog: 0,0:26:11.65,0:26:12.65, Lalai,Spillik2,0,0,0,,No.
Dialog: 0,0:26:13.25,0:26:14.92,Lalai,Spillik2,0,0,0,,Adakah sesuatu berlaku padanya?
Dialog: 0,0:26:16.69,0:26:18.72,Lalai,Spillik2,0,0,0,,Dia tidak pulang ke rumah.
Dialog: 0,0:26:20.62,0:26:23.59,Lalai,Spikyulka2,0,0,0,,Saya rasa dia pergi ke tempat lain kerana dia rasa bersalah di hadapan awak.
Dialog: 0,0:26:23.99,0:26:26.66,Lalai,Spikyulka2,0,0,0,,Saya bertanya tentang dia. Jangan risau sangat.
Dialog: 0,0:26:27.70,0:26:29.56,Lalai,Spikyulka2,0,0,0,,Saya memberitahunya berkali-kali, tetapi dia sekali lagi...
Dialog: 0,0:26:29.73,0:26:32.07,Lalai,Spillik2,0,0,0,,Saya sedang mencari hadiah awak untuknya.
Dialog: 0,0:26:33.54,0:26:36.67,Lalai,Spikyulka2,0,0,0,,Jika dia pergi ke tempat lain, dia sepatutnya menjualnya.
Dialog: 0,0:26:37.87,0:26:39.24,Lalai,Spillik2,0,0,0,,Saya takut,
Dialog: 0,0:26:40.08,0:26:41.78,Lalai,Spilyk2,0,0,0,,bahawa saya akan kehilangan semua orang saya.
Dialog: 0,0:26:44.58,0:26:47.02,Default,Spillik2,0,0,0,,Bila raja akan kembali ke istana?
Dialog: 0,0:26:47.48,0:26:48.55,Lalai,Spikyulka2,0,0,0,,Dia akan kekal
Dialog: 0,0:26:49.55,0:26:50.72,Lalai,Spikyulka2,0,0,0,,satu malam lagi.
Dialog: 0,0:26:53.76,0:26:55.36,Lalai,Spikyulka2,0,0,0,,Ini bukan seperti yang anda fikirkan.
Dialog: 0,0:26:55.96,0:26:57.89,Lalai,Spikyulka2,0,0,0,,Saya tidak dapat memberitahu anda butirannya,
Dialog: 0,0:26:57.89,0:27:01.00,Lalai,Spikyulka2,0,0,0,,tetapi malam ini semuanya akan diselesaikan.
Dialog: 0,0:27:02.20,0:27:03.83,Lalai,Spikyulka2,0,0,0,,Bukan kerana raja mempunyai
Dialog: 0,0:27:04.80,0:27:07.47,Lalai,Spikyulka2,0,0,0,,banyak kebimbangan lain,
Dialog: 0,0:27:08.30,0:27:10.61,Default,Spikyulka2,0,0,0,,perasaan dia terhadap saya telah berubah.
Dialog: 0,0:27:12.24,0:27:16.54,Lalai,Spikyulka2,0,0,0,,Nampaknya, saya seorang sahaja yang berpaut pada kenangan zaman kanak-kanak.
Dialog: 0,0:27:17.21,0:27:19.05,Lalai,Biryulka2,0,0,0,,Saya masih ingat bagaimana saya kembali ke ibu negara
Dialog: 0,0:27:19.91,0:27:22.88,Lalai,Spikyulka2,0,0,0,,dan bertemu dengan anda dan raja dua tahun lalu.
Dialog: 0,0:27:23.35,0:27:26.02,Lalai,Spikyulka2,0,0,0,,Walaupun hari itu dia melihat anda buat kali pertama,
Dialog: 0,0:27:28.16,0:27:29.19,Lalai,Spilyk2,0,0,0,,pasti
Dialog: 0,0:27:30.19,0:27:31.89, Lalai,Spillik2,0,0,0,,suka sekali.
Dialog: 0,0:27:35.86,0:27:39.17,Lalai,Spillik2,0,0,0,,Kata-kata anda menggalakkan saya.
Dialog: 0,0:27:47.98,0:27:49.98,Lalai,Spilyk2,0,0,0,,Adakah ini sarapan biasa anda?
Dialog: 0,0:27:50.95,0:27:53.65,Lalai,Spikyulka2,0,0,0,,Saya perlu menjadi lebih baik. \NMengapa anda perlu berkeliaran di sini satu malam lagi?
Dialog: 0,0:27:53.95,0:27:56.85,Lalai,Spillik2,0,0,0,,Untuk menjaga kamu, permaisuriku.
Dialog: 0,0:27:57.89,0:27:59.95,Lalai,Spikyulka2,0,0,0,,Doktor merawat, ahli farmasi memberi ubat.
Dialog: 0,0:28:00.12,0:28:02.49,Lalai,Spikyulka2,0,0,0,,Dan raja mengambil berat tentang politik,\Ndan bukan tentang kesihatan saya.
Dialog: 0,0:28:02.92,0:28:04.79,Lalai,Spikyulka2,0,0,0,,Adakah anda tahu berapa banyak penderitaan orang?
Dialog: 0,0:28:04.79,0:28:08.53,Lalai,Spillik2,0,0,0,,Anda bercakap benar, ratu.
Dialog: 0,0:28:08.53,0:28:10.53,Lalai,Spikyulka2,0,0,0,,Ayuh, makan sup penyu
Dialog: 0,0:28:10.53,0:28:11.90, Lalai, Spikyulka2,0,0,0, dan pergi bekerja sebagai raja.
Dialog: 0,0:28:12.70,0:28:14.57,Lalai,Spillik2,0,0,0,,Jangan abaikan pengorbanan penyu.
Dialog: 0,0:28:16.17,0:28:18.01,Lalai,Spikyulka2,0,0,0,,Saya lebih suka pergi daripada menerima pengorbanannya
Dialog: 0,0:28:18.37,0:28:21.48,Lalai,Spikyulka2,0,0,0,,mari kita lihat bagaimana rakyat biasa hidup.
Dialog: 0,0:28:22.88,0:28:24.55,Lalai,Spikyulka2,0,0,0,,Saya akan balik lewat,
Dialog: 0,0:28:25.68,0:28:27.08,Lalai,Spikyulka2,0,0,0,,yang bermaksud anda perlu bermalam lagi.
Dialog: 0,0:28:30.29,0:28:32.09,Lalai,Spikyulka2,0,0,0,,Awak tak nak lepak-lepak dalam istana juga?
Dialog: 0,0:28:32.75,0:28:35.16,Lalai,Spikyulka2,0,0,0,,Sangat mengerikan bahawa anda lebih teruk di sana daripada di rumah saudara anda.
Dialog: 0,0:28:37.73,0:28:40.90,Lalai,Spikyulka2,0,0,0,,Ya, ia bagus dan selesa di sini.
Dialog: 0,0:28:43.33,0:28:45.33,Lalai,Spillik2,0,0,0,,Permaisuri Janda jenis apakah itu?
Dialog: 0,0:28:45.53,0:28:47.80,Lalai,Spikyulka2,0,0,0,,Dia ialah kakak kepada Encik Kim Jwageun
Dialog: 0,0:28:47.84,0:28:51.37,Lalai,Spikyulka2,0,0,0,,dan tidak meninggalkan istana sejak dia tiba.
Dialog: 0,0:28:51.37,0:28:53.24,Lalai,Spikyulka2,0,0,0,,Bagaimana jika saya menyampaikan kepada seseorang yang tidak pernah
Dialog: 0,0:28:53.24,0:28:55.94,Lalai,Sutera2,0,0,0,,tidak keluar istana, hidangan dari luar...
Dialog: 0,0:28:55.94,0:28:57.01,Lalai,Spillik2,0,0,0,,Anda tahu...
Dialog: 0,0:28:57.61,0:29:00.32,Default,Spillik2,0,0,0,,Dalam drama sejarah, mereka selalu makan gukbap.
Dialog: 0,0:29:00.32,0:29:01.45,Lalai,Spillik2,0,0,0,,Apakah rasanya?
Dialog: 0,0:29:02.28,0:29:04.85,Lalai,Spilyk2,0,0,0,,Bagaimanakah saya boleh tahu rasa makanan ringkas itu?
Dialog: 0,0:29:18.30,0:29:19.87,Lalai,Spillik2,0,0,0,,Tidak begitu menakjubkan.
Dialog: 0,0:29:22.70,0:29:25.44,Lalai,Spikyulka2,0,0,0,,Apa yang anda terlepas boleh menjadi senjata yang dahsyat.
Dialog: 0,0:29:32.15,0:29:34.08,Lalai,Spikyulka2,0,0,0,,Mereka membuat kuah daripada brisket daging lembu dan lobak putih,
Dialog: 0,0:29:34.08,0:29:36.08,Lalai,Biryulka2,0,0,0,,diperasakan dengan pes kacang soya dan panaskan nasi dengannya.
Dialog: 0,0:29:37.32,0:29:39.59,Lalai,Spilyk2,0,0,0,,Terdapat banyak daging di dalamnya. Sederhana, tetapi ia mempunyai daya tarikan yang tersendiri.
Dialog: 0,0:29:40.22,0:29:42.42,Lalai,Biryulka2,0,0,0,,Kimchi lobak dibuat tanpa makanan laut masin,
Dialog: 0,0:29:42.42,0:29:44.26,Lalai,Spillik2,0,0,0,,kerana semuanya berjalan lancar tanpa membebankan rasa.
Dialog: 0,0:29:44.56,0:29:46.69,Default,Silk2,0,0,0,,Mereka mengatakan Hongjong selalu makan gukbap di luar istana.
Dialog: 0,0:29:50.60,0:29:51.93, Lalai, Lily,0,0,0,, Sial.
Dialog: 0,0:29:52.57,0:29:55.44,Lalai,Lily,0,0,0,,Jiran itu melarikan diri tanpa membayar cukai,\NI perlu membayarnya.
Dialog: 0,0:29:55.60,0:29:57.31,Lalai,Lily,0,0,0,,Ini adalah rompakan sebenar.
Dialog: 0,0:29:57.41,0:29:58.77, Lalai, Lily,0,0,0,, Gigit lidah anda.
Dialog: 0,0:29:59.14,0:30:00.81,Lalai,Lily,0,0,0,,Adakah anda mahu dipukul dengan kayu?
Dialog: 0,0:30:00.81,0:30:03.08,Lalai,Lily,0,0,0,,Saya akan mati menggigit lidah saya,
Dialog: 0,0:30:03.08,0:30:05.85, Lalai, Lily,0,0,0,, atau saya akan melarikan diri dan menjadi penyamun - terdapat dua pilihan.
Dialog: 0,0:30:05.85,0:30:09.12,Lalai,Lily,0,0,0,,Gigit lidah? Ya, saya tidak rugi!
Dialog: 0,0:30:09.22,0:30:12.89,Lalai,Lily,0,0,0,,Ia mengelupas seperti melekit. Mana raja cari?!
Dialog: 0,0:30:13.62,0:30:15.06,Lalai,Lily,0,0,0,,Apa yang anda mahukan?
Dialog: 0,0:30:15.06,0:30:17.13,Lalai,Lily,0,0,0,,Sudah tentu, dia merobek.
Dialog: 0,0:30:17.13,0:30:19.39,Lalai,Lily,0,0,0,,Boneka yang diberi takhta untuk ditutup
Dialog: 0,0:30:19.39,0:30:22.00,Lalai,Lily,0,0,0,,semua mata, dan mereka melakukan apa yang mereka mahu.
Dialog: 0,0:30:22.00,0:30:23.43,Lalai,Lily,0,0,0,,Sial.
Dialog: 0,0:30:27.50,0:30:29.24,Lalai,Lily,0,0,0,,Berhenti.
Dialog: 0,0:30:32.11,0:30:33.64,Lalai,Lily,0,0,0,,Saya terdengar awak.
Dialog: 0,0:30:33.94,0:30:36.44,Lalai,Lily,0,0,0,,Anda telah melalui banyak perkara.
Dialog: 0,0:30:38.18,0:30:41.85,Lalai,Lily,0,0,0,,Kerana raja yang bodoh, orang mati.
Dialog: 0,0:30:42.78,0:30:45.39,Lalai,Lily,0,0,0,,Minum dan lupakan kesedihan anda.
Dialog: 0,0:30:46.39,0:30:48.69,Lalai,Lily,0,0,0,,Anda kelihatan sama
Dialog: 0,0:30:48.69,0:30:51.06,Lalai,Lily,0,0,0,,untuk seseorang yang mempunyai kedudukan tinggi.
Dialog: 0,0:30:54.00,0:30:55.30,Lalai,Lily,0,0,0,,Berpura-pura menjadi bangsawan.
Dialog: 0,0:30:56.23,0:30:58.13,Lalai,Lily,0,0,0,,Perkara yang paling mahal ialah silsilah.
Dialog: 0,0:30:58.13,0:31:01.37,Lalai,Lily,0,0,0,,Tanpa pakaian dan keturunan - Saya pengemis biasa.
Dialog: 0,0:31:04.04,0:31:05.91,Lalai,Lily,0,0,0,,Belia hari ini kelihatan mulia,
Dialog: 0,0:31:05.91,0:31:08.24,Lalai,Lily,0,0,0,,tetapi sebenarnya mereka adalah tiruan seperti anda.
Dialog: 0,0:31:08.31,0:31:09.34,Lalai,Lily,0,0,0,,Beraninya awak?
Dialog: 0,0:31:10.08,0:31:11.88,Lalai,Lily,0,0,0,,Ya, negara kita adalah tiruan.
Dialog: 0,0:31:11.88,0:31:14.82,Lalai,Lily,0,0,0,,Jika orang mempunyai sesuatu di dalam,\Nit akan diambil daripada mereka juga.
Dialog: 0,0:31:16.28,0:31:17.79,Lalai,Lily,0,0,0,,Lucu.
Dialog: 0,0:31:18.29,0:31:20.56,Lalai,Lily,0,0,0,,Lelaki ini
Dialog: 0,0:31:20.56,0:31:23.56,Lalai,Lily,0,0,0,,-cara yang menarik untuk melihat sesuatu.\N-Lucu.
Dialog: 0,0:31:23.56,0:31:26.63,Lalai,Lily,0,0,0,,Seorang lelaki daripada keluarga pengkhianat menjadi raja.
Dialog: 0,0:31:26.63,0:31:28.86,Lalai,Lily,0,0,0,,Semuanya busuk sepenuhnya.
Dialog: 0,0:31:28.86,0:31:30.87,Lalai,Lily,0,0,0,,Di manakah seseorang daripada keluarga,
Dialog: 0,0:31:30.87,0:31:34.00,Lalai,Lily,0,0,0,,yang melakukan pengkhianatan selama beberapa generasi,
Dialog: 0,0:31:34.00,0:31:36.10,Lalai,Lily,0,0,0,,menjadi raja?
Dialog: 0,0:31:36.10,0:31:39.41,Lalai,Lily,0,0,0,,Apakah yang raja fikirkan semasa menerima takhta?
Dialog: 0,0:31:39.97,0:31:41.88,Lalai,Lily,0,0,0,,Dia hidup dalam kuasa Kims,
Dialog: 0,0:31:41.88,0:31:44.81,Lalai,Lily,0,0,0,,dengan pengecut membunuh seluruh keluarganya.
Dialog: 0,0:31:44.81,0:31:45.95,Lalai,Lily,0,0,0,,Tepat sekali.
Dialog: 0,0:31:46.08,0:31:48.58,Lalai,Lily,0,0,0,,-Sial.\N-Dan itu benar.
Dialog: 0,0:31:48.58,0:31:50.62,Lalai,Lily,0,0,0,,Anda telah melepasi garisan.
Dialog: 0,0:31:52.52,0:31:55.06,Lalai,Lily,0,0,0,,Anda bebas mengutuk raja,
Dialog: 0,0:31:57.86,0:32:00.66,Lalai,Lilia,0,0,0,,tetapi jangan berani membincangkan keluarganya!
Dialog: 0,0:32:00.70,0:32:03.06,Lalai,Lily,0,0,0,,Ada garisan yang tidak boleh dilalui!
Dialog: 0,0:32:03.87,0:32:05.00,Lalai,Lily,0,0,0,,Adakah anda fikir,
Dialog: 0,0:32:05.10,0:32:07.07,Lalai,Lily,0,0,0,,adakah menjadi seorang raja bermakna menjalani kehidupan yang mewah?
Dialog: 0,0:32:07.07,0:32:09.04,Lalai,Lily,0,0,0,,Dia sentiasa takut diracun
Dialog: 0,0:32:09.04,0:32:10.44, Lalai, Lily,0,0,0,, atau tanpa kepala. Ini kejam!
Dialog: 0,0:32:10.64,0:32:12.81,Lalai,Lily,0,0,0,,Adakah anda dari istana?
Dialog: 0,0:32:12.94,0:32:15.51,Lalai,Lily,0,0,0,,Adakah kamu wakil raja?
Dialog: 0,0:32:15.71,0:32:17.01,Lalai,Lily,0,0,0,,Siapa awak?
Dialog: 0,0:32:17.31,0:32:19.48,Lalai,Lily,0,0,0,,Saya? Ya saya
Dialog: 0,0:32:23.38,0:32:24.89,Lalai,Lily,0,0,0,,dari kelab peminat raja.
Dialog: 0,0:32:25.59,0:32:26.96,Lalai,Lily,0,0,0,,-Apa?\N-Apa ini?
Dialog: 0,0:32:28.86,0:32:30.02,Lalai,Lily,0,0,0,,Kelab peminat?
Dialog: 0,0:32:30.16,0:32:31.99, Lalai, Lily,0,0,0,, Anti-peminat juga peminat.
Dialog: 0,0:32:32.29,0:32:35.93,Lalai,Lily,0,0,0,,Baiklah, bincangkan keluarganya sekurang-kurangnya sekali lagi,
Dialog: 0,0:32:36.06,0:32:38.73,Lalai,Lily,0,0,0,,Saya akan membelokkan meja untuk anda!
Dialog: 0,0:32:39.13,0:32:42.40,Lalai,Lily,0,0,0,,-Terlepas?\N-Baiklah, okey.
Dialog: 0,0:32:42.40,0:32:44.04,Lalai,Lily,0,0,0,,Jangan mendekat!
Dialog: 0,0:32:44.04,0:32:45.17,Lalai,Lily,0,0,0,,Maaf.
Dialog: 0,0:32:45.27,0:32:46.84,Lalai,Lily,0,0,0,,Hitung kami!
Dialog: 0,0:32:46.84,0:32:48.24,Lalai,Lily,0,0,0,,Kemari.
Dialog: 0,0:32:48.24,0:32:50.88,Lalai,Lily,0,0,0,,Wah.
Dialog: 0,0:32:51.18,0:32:53.08,Lalai,Lily,0,0,0,,Perwatakan sungguh.
Dialog: 0,0:32:53.08,0:32:54.65,Lalai,Lily,0,0,0,,Lepaskan saya. lepaskan.
Dialog: 0,0:32:55.08,0:32:56.82,Lalai,Lily,0,0,0,,Saya tidak kecewa.
Dialog: 0,0:32:58.32,0:32:59.69,Lalai,Lily,0,0,0,,Kamu kata kamu berpura-pura.
Dialog: 0,0:33:00.19,0:33:01.99,Lalai,Lily,0,0,0,,Adalah mustahil untuk mendedahkan diri anda.
Dialog: 0,0:33:01.99,0:33:03.26,Lalai,Lily,0,0,0,,Saya yang marah bukannya awak.
Dialog: 0,0:33:09.63,0:33:10.93,Lalai,Lily,0,0,0,,Apa? Nah?
Dialog: 0,0:33:12.10,0:33:13.87,Lalai,Lily,0,0,0,,Anda seorang pelakon yang hebat.
Dialog: 0,0:33:14.84,0:33:17.01,Lalai,Lily,0,0,0,,Adakah anda tahu apa maksudnya?
Dialog: 0,0:33:17.71,0:33:19.17,Lalai,Lily,0,0,0,,Bukankah ia sesuatu yang bagus?
Dialog: 0,0:33:20.21,0:33:22.54,Lalai,Lily,0,0,0,,By the way, apa itu kelab peminat?
Dialog: 0,0:33:24.21,0:33:26.31,Lalai,Lily,0,0,0,,Ini adalah orang yang mulia,
Dialog: 0,0:33:26.31,0:33:28.62,Lalai,Lily,0,0,0,,yang mendoakan kebahagiaan seseorang
Dialog: 0,0:33:28.62,0:33:29.95,Lalai,Lily,0,0,0,,dan kejayaan dari lubuk hati saya.
Dialog: 0,0:33:30.89,0:33:32.79,Lalai,Lily,0,0,0,,Ia seperti panduan rohani.
Dialog: 0,0:33:34.79,0:33:36.09,Lalai,Lily,0,0,0,,Dan anti-peminat?
Dialog: 0,0:33:37.73,0:33:38.79,Lalai,Lily,0,0,0,,Biar saya fikir.
Dialog: 0,0:33:39.66,0:33:43.16,Lalai,Lily,0,0,0,,Seseorang yang lebih meminati orang ini daripada peminat?
Dialog: 0,0:33:45.20,0:33:47.04,Lalai,Lily,0,0,0,,Mentor yang lebih berpengaruh.
Dialog: 0,0:33:48.64,0:33:51.81,Lalai,Lily,0,0,0,,Saya tidak layak untuk perasaan awak terhadap saya.
Dialog: 0,0:33:54.28,0:33:56.28,Lalai,Lily,0,0,0,,Lepaskan. Jika saya dilucutkan jawatan
Dialog: 0,0:33:56.28,0:33:57.85,Default,Lily,0,0,0,,Saya akan jual kukpap.
Dialog: 0,0:33:58.61,0:33:59.78,Lalai,Lily,0,0,0,,Jangan cakap begitu.
Dialog: 0,0:34:00.65,0:34:02.48,Lalai,Lily,0,0,0,,Saya tidak akan biarkan ini berlaku.
Dialog: 0,0:34:03.45,0:34:05.39,Lalai,Lily,0,0,0,,Saya juga anti peminat awak.
Dialog: 0,0:34:05.69,0:34:08.32,Lalai,Lily,0,0,0,,Sudah tentu. Menenangkan saya.
Dialog: 0,0:34:09.66,0:34:11.56,Lalai,Lily,0,0,0,,Sekarang kita pergi ke arah yang berbeza.
Dialog: 0,0:34:11.56,0:34:13.06,Lalai,Lily,0,0,0,,Kami mempunyai matlamat yang berbeza.
Dialog: 0,0:34:14.43,0:34:17.77,Lalai,Lily,0,0,0,,Di manakah restoran yang bagus,\Ndi mana orang berbaris?
Dialog: 0,0:34:20.84,0:34:23.17,Lalai,Lily,0,0,0,,"An" bermaksud mudah, "ti"...
Dialog: 0,0:34:24.34,0:34:25.37,Lalai,Lily,0,0,0,,kipas?
Dialog: 0,0:34:26.61,0:34:29.24,Lalai,Lily,0,0,0,,Fikir saya telah berjaya dalam pelajaran saya.
Dialog: 0,0:34:29.94,0:34:31.41,Lalai,Lily,0,0,0,,Ada sesuatu untuk diusahakan.
Dialog: 0,0:34:35.45,0:34:37.45,Lalai,Lily,0,0,0,,-Cuba.\N-Tuhan.
Dialog: 0,0:34:37.45,0:34:38.99,Lalai,Lily,0,0,0,,-Banyak.\N-Tuhan.
Dialog: 0,0:34:38.99,0:34:41.02,Lalai,Lily,0,0,0,,-Beli, puan.\N-Cuba.
Dialog: 0,0:34:41.02,0:34:43.69,Lalai,Lily,0,0,0,,-Beli.\N-Apa yang awak buat?
Dialog: 0,0:34:43.69,0:34:45.49,Lalai,Lily,0,0,0,,Sedap, saya rasa.
Dialog: 0,0:35:03.91,0:35:05.78,Lalai,Lily,0,0,0,,Takut, apa yang awak buat?
Dialog: 0,0:35:05.78,0:35:08.12,Lalai,Lily,0,0,0,,Anda akan pergi ke lorong belakang dengan pakaian mahal,
Dialog: 0,0:35:08.12,0:35:09.55,Lalai,Lily,0,0,0,,anda akan menjadi sasaran.
Dialog: 0,0:35:10.65,0:35:12.42,Lalai,Lily,0,0,0,,-Sasaran apa?\N-Siapa yang kita ada di sini?
Dialog: 0,0:35:12.42,0:35:14.36,Lalai,Lily,0,0,0,,Apa yang orang kaya lupa di sini?
Dialog: 0,0:35:15.46,0:35:17.13,Lalai,Lily,0,0,0,,Inilah yang saya bincangkan.
Dialog: 0,0:35:17.43,0:35:19.96,Lalai,Lily,0,0,0,,Alih pergi. Saya tak nak sakitkan hati awak.
Dialog: 0,0:35:21.40,0:35:22.63,Lalai,Lily,0,0,0,,Adakah anda suka gadis itu?
Dialog: 0,0:35:22.63,0:35:24.37,Lalai,Lily,0,0,0,,Sia-sia.
Dialog: 0,0:35:24.87,0:35:27.30,Lalai,Lily,0,0,0,,Jangan bermimpi tentangnya,
Dialog: 0,0:35:27.30,0:35:29.60, Lalai, Lily,0,0,0,, bahawa saya bersendirian di sini.
Dialog: 0,0:35:30.47,0:35:32.17,Lalai,Lily,0,0,0,,Saya perasan perkara ini sebelum ini.
Dialog: 0,0:35:32.17,0:35:35.71,Lalai,Lily,0,0,0,,Anda mengekspresikan diri anda dengan baik,\Nseperti seorang perompak yang berpendidikan.
Dialog: 0,0:35:36.31,0:35:38.11,Lalai,Lily,0,0,0,,-Bersopanlah.\N-Ya.
Dialog: 0,0:35:38.11,0:35:40.98,Lalai,Lily,0,0,0,,Jangan risau, saya tidak akan menyinggung perasaan.
Dialog: 0,0:35:41.98,0:35:44.42,Lalai,Lily,0,0,0,,Saya anti-peminat awak.
Dialog: 0,0:35:47.36,0:35:48.56,Lalai,Lily,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:35:56.90,0:35:58.23,Lalai,Lily,0,0,0,,Takut.
Dialog: 0,0:35:59.27,0:36:00.97,Lalai,Lily,0,0,0,,Di mana sahaja saya berada,
Dialog: 0,0:36:00.97,0:36:02.60,Lalai,Lily,0,0,0,,jangan berjalan di tempat terpencil.
Dialog: 0,0:36:04.41,0:36:05.87,Lalai,Lily,0,0,0,,Jaga mereka, Cheoljong.
Dialog: 0,0:36:11.28,0:36:13.25,Lalai,Lily,0,0,0,,Dan jika sesuatu berlaku kepadanya,
Dialog: 0,0:36:14.65,0:36:16.42,Lalai,Lily,0,0,0,,adakah sejarah akan berubah?
Dialog: 0,0:36:17.62,0:36:21.86,Lalai,Lily,0,0,0,,Hei! Saya dari pasukan khas!
Dialog: 0,0:36:24.46,0:36:25.59,Lalai,Lily,0,0,0,,Sudah hilang?
Dialog: 0,0:36:28.56,0:36:29.60,Lalai,Lily,0,0,0,,Cheoljong.
Dialog: 0,0:36:30.57,0:36:31.70,Lalai,Lily,0,0,0,,Adakah anda sudah mati?
Dialog: 0,0:36:34.07,0:36:35.84,Lalai,Lily,0,0,0,,Bagaimana saya boleh pulang?
Dialog: 0,0:36:35.84,0:36:38.37,Lalai,Lily,0,0,0,,Wah, kenapa seorang wanita kaya...
Dialog: 0,0:36:39.17,0:36:41.78,Lalai,Lilia,0,0,0,,Saya fikir dia kembali kerana dia risaukan saya.
Dialog: 0,0:36:42.44,0:36:44.58, Lalai, Lily,0,0,0,, Dan anda tidak tahu jalan pulang.
Dialog: 0,0:36:45.05,0:36:46.58,Lalai,Lily,0,0,0,,Bagaimana dengan samseng itu?
Dialog: 0,0:36:47.18,0:36:50.08,Lalai,Lily,0,0,0,,Berlari mengejar lelaki itu dengan pakaian yang lebih mahal.
Dialog: 0,0:36:51.45,0:36:54.49,Lalai,Lily,0,0,0,,Jangan risau, saya tidak akan menyinggung perasaan.
Dialog: 0,0:36:55.62,0:36:58.06,Lalai,Lily,0,0,0,,Saya anti-peminat awak.
Dialog: 0,0:37:01.30,0:37:02.53,Lalai,Lily,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:37:03.56,0:37:06.27,Lalai,Lily,0,0,0,,Masa kita tidak begitu tenang,
Dialog: 0,0:37:06.27,0:37:08.87, Lalai, Lily,0,0,0,,untuk berpaling ke belakang.
Dialog: 0,0:37:08.87,0:37:11.01,Lalai,Lily,0,0,0,,Saya rasa anda faham perkara yang anda hadapi.
Dialog: 0,0:37:11.44,0:37:13.24,Lalai,Lily,0,0,0,,Wah. Hanya sebuah puisi.
Dialog: 0,0:37:14.18,0:37:16.14,Lalai,Lily,0,0,0,,Dari Empayar Qing?
Dialog: 0,0:37:16.14,0:37:18.48,Lalai,Lily,0,0,0,,Cantik, kalau kita jual,\N kita boleh makan selama lima hari.
Dialog: 0,0:37:18.48,0:37:19.55,Lalai,Lily,0,0,0,,Mari kita tanggalkannya.
Dialog: 0,0:37:26.69,0:37:28.96,Lalai,Lily,0,0,0,,Jangan berpaling ke belakang.
Dialog: 0,0:37:33.90,0:37:35.26,Lalai,Lily,0,0,0,,Saya tidak membunuhnya.
Dialog: 0,0:37:37.06,0:37:39.33, Lalai, Lily,0,0,0,,Tetapi saya pasti akan membunuh orang seterusnya yang tergesa-gesa.
Dialog: 0,0:37:49.38,0:37:52.15,Lalai,Lily,0,0,0,,Mengapa dia berada di atas tanah?
Dialog: 0,0:37:52.75,0:37:54.08,Lalai,Lily,0,0,0,,Baru minum terlalu banyak.
Dialog: 0,0:37:59.79,0:38:01.92,Lalai,Lily,0,0,0,,Anda sangat bertuah.
Dialog: 0,0:38:04.96,0:38:06.23,Lalai,Lily,0,0,0,,Bagaimana dengan pakaian anda?
Dialog: 0,0:38:06.99,0:38:10.06,Lalai,Lily,0,0,0,,Saya tidak boleh pergi tanpa disedari
Dialog: 0,0:38:10.06,0:38:11.90,Lalai,Lily,0,0,0,,dalam pakaian mahal.
Dialog: 0,0:38:16.87,0:38:17.97,Lalai,Lily,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:38:17.97,0:38:19.97,Lalai,Lily,0,0,0,,Perlu membeli sesuatu.
Dialog: 0,0:38:19.97,0:38:21.98,Lalai,Lily,0,0,0,,Ditinggal tergesa-gesa, tidak mengambil wang.
Dialog: 0,0:38:22.78,0:38:25.31,Lalai,Lily,0,0,0,,-Cemerlang.\N-Anda sedang merompak seorang perompak.
Dialog: 0,0:38:25.58,0:38:27.62,Lalai,Lily,0,0,0,,Hei, tidak.
Dialog: 0,0:38:27.98,0:38:31.49,Lalai,Lily,0,0,0,,Tunjukkan. Tidak adil untuk mengambil segala-galanya untuk diri sendiri.
Dialog: 0,0:38:35.56,0:38:37.36,Lalai,Lily,0,0,0,,Makan kukpapa.
Dialog: 0,0:38:41.00,0:38:42.03,Lalai,Lily,0,0,0,,Tahan.
Dialog: 0,0:38:43.20,0:38:45.73,Lalai,Lily,0,0,0,,-Jom.\N-Awak nak beli apa?
Dialog: 0,0:38:51.87,0:38:52.87,Lalai,Lily,0,0,0,,Teruskan.
Dialog: 0,0:38:55.11,0:38:57.21,Lalai,Lily,0,0,0,,Dia bertarung dengan mahir.
Dialog: 0,0:38:57.95,0:38:59.61,Lalai,Lily,0,0,0,,Melihat dari cara dia menjaga bilik,
Dialog: 0,0:39:00.38,0:39:02.12,Lalai,Lily,0,0,0,,Saya rasa item itu wujud.
Dialog: 0,0:39:02.12,0:39:04.75,Lalai,Lily,0,0,0,,Bolehkah anda mengenalinya jika anda bertemu dengannya lagi?
Dialog: 0,0:39:05.92,0:39:07.72,Lalai,Lily,0,0,0,,Sudah tentu. Tuan,
Dialog: 0,0:39:09.62,0:39:11.03,Lalai,Lily,0,0,0,,Saya perlukan ubat.
Dialog: 0,0:39:16.76,0:39:18.57,Lalai,Lily,0,0,0,,Saya membuat diri saya jelas.
Dialog: 0,0:39:19.10,0:39:21.37,Lalai,Lily,0,0,0,,Tiada penawar jika anda gagal.
Dialog: 0,0:39:21.80,0:39:23.30,Lalai,Lily,0,0,0,,Bagaimanakah anda akan membalas saya?
Dialog: 0,0:39:23.84,0:39:26.01,Lalai,Lily,0,0,0,,Adakah anda akan memberikan saya tangan anda untuk memotong?
Dialog: 0,0:39:26.44,0:39:28.01,Lalai,Lily,0,0,0,,Saya akan membayar balik kepada awak.
Dialog: 0,0:39:29.64,0:39:30.98,Lalai,Lily,0,0,0,,Saya bersumpah dengan hidup saya.
Dialog: 0,0:39:43.56,0:39:45.43, Lalai,,0,0,0,, Sini! Cuba teka apa itu.
Dialog: 0,0:39:45.66,0:39:48.43, Lalai,,0,0,0,, Kapal bulan dari Dinasti Goryeo.
Dialog: 0,0:39:48.86,0:39:51.33,Lalai,,0,0,0,,Serius? Ia adalah satu nilai.
Dialog: 0,0:39:51.73,0:39:53.63, Lalai,,0,0,0,,-Berapa harganya?\N -Itu palsu.
Dialog: 0,0:39:54.77,0:39:57.10,Lalai,,0,0,0,,Beli jika anda bercadang untuk menggunakannya untuk mempertahankan diri anda semula.
Dialog: 0,0:39:58.64,0:40:00.17, Lalai,,0,0,0,,Penjahat.
Dialog: 0,0:40:07.92,0:40:09.05,Lalai,,0,0,0,,Pilih satu.
Dialog: 0,0:40:13.42,0:40:14.49,Lalai,,0,0,0,,Saya bertaruh semuanya.
Dialog: 0,0:40:15.09,0:40:18.73, Lalai,,0,0,0,,Wah, anda tidak boleh bertaruh wang sebanyak itu.
Dialog: 0,0:40:18.73,0:40:20.76,Lalai,,0,0,0,,Ini adalah masyarakat kapitalis,\Ndi mana wang menang.
Dialog: 0,0:40:21.00,0:40:22.50,Lalai,,0,0,0,,-Saya bertaruh semuanya.\N-Maaf.
Dialog: 0,0:40:22.50,0:40:23.96,Lalai,,0,0,0,,-Apa yang awak buat?\N-Puan saya.
Dialog: 0,0:40:23.96,0:40:25.07,Lalai,,0,0,0,,Pn.
Dialog: 0,0:40:25.07,0:40:26.70, Lalai,,0,0,0,,-Buka.\N -Buka.
Dialog: 0,0:40:28.94,0:40:31.91,Lalai,,0,0,0,,Penipu sebegitu sepatutnya\N gengnya dekat meja.
Dialog: 0,0:40:32.37,0:40:36.01, Lalai,,0,0,0,,Saya pasti semua penonton ada untuk menjemput anda menyertai permainan.
Dialog: 0,0:40:37.04,0:40:39.68,Lalai,,0,0,0,,Anda dilahirkan sebagai raja.
Dialog: 0,0:40:39.68,0:40:42.45, Lalai,,0,0,0,,Namun, anda nampaknya tahu jalan di dalam dan luar.
Dialog: 0,0:40:42.92,0:40:45.62,Lalai,,0,0,0,,Dan dia menafikan dengan sekuat tenaga.
Dialog: 0,0:40:51.03,0:40:52.76, Lalai,,0,0,0,,Ini adalah titik lemah saya.
Dialog: 0,0:40:56.50,0:40:58.57,Lalai,,0,0,0,,Keluarga saya musnah atas alasan pengkhianatan.
Dialog: 0,0:40:59.87,0:41:01.00, Lalai,,0,0,0,,Putera Ganghwado.
Dialog: 0,0:41:02.34,0:41:05.21,Lalai,,0,0,0,,Sejarah keluarga saya adalah kelemahan saya,\Nyang memusnahkan saya.
Dialog: 0,0:41:08.21,0:41:09.74, Lalai,,0,0,0,,Anda mengalami mimpi buruk tentang
Dialog: 0,0:41:09.74,0:41:11.41,Lalai,,0,0,0,,bagaimana mereka memarahi anda di mahkamah, atau apa?
Dialog: 0,0:41:14.25,0:41:17.95,Lalai,,0,0,0,,Mimpi ngeri sebenar bukanlah yang saya impikan.
Dialog: 0,0:41:19.59,0:41:21.26,Lalai,,0,0,0,,Mimpi ngeri sebenar...
Dialog: 0,0:41:28.33,0:41:29.80, Lalai,,0,0,0,,Mengapa anda berhenti pertengahan ayat?
Dialog: 0,0:41:30.80,0:41:32.70, Lalai,,0,0,0,,Lupa apa yang saya nak cakap.
Dialog: 0,0:41:32.70,0:41:33.73,Lalai,,0,0,0,,Sebenarnya
Dialog: 0,0:41:35.37,0:41:37.54, Lalai,,0,0,0,,Saya ingin bertanya kepada anda satu soalan.
Dialog: 0,0:41:39.91,0:41:41.91, Lalai,,0,0,0,,Mengapa anda tidak memberitahu sesiapa tentang malam itu?
Dialog: 0,0:41:43.54,0:41:45.85,Lalai,,0,0,0,,-Tentang apa?\N-Saya cuba mencederakan awak.
Dialog: 0,0:41:47.08,0:41:50.42,Lalai,,0,0,0,,Ah, adakah anda bercakap tentang ini? Saya tidak mahu masuk ke dalam kekacauan ini.
Dialog: 0,0:41:50.79,0:41:54.09,Lalai,,0,0,0,,Saya hanya mahu melepasi semua kesukaran.
Dialog: 0,0:42:06.17,0:42:09.64, Lalai,,0,0,0,,Kami lebih suka berdamai di negara kami,\Jangan terbiar.
Dialog: 0,0:42:10.77,0:42:13.64, Lalai,,0,0,0,,Menyelamatkan negara bukanlah perkara saya sama sekali.
Dialog: 0,0:42:16.61,0:42:17.65, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:42:17.65,0:42:20.58,Lalai,,0,0,0,,Saya ingin berdiri dan menyambut anda.
Dialog: 0,0:42:20.58,0:42:22.98,Lalai,,0,0,0,,Ya, saya tidur di pergunungan yang sejuk,
Dialog: 0,0:42:22.98,0:42:24.79,Lalai,,0,0,0,,seluruh badan saya sakit.
Dialog: 0,0:42:25.45,0:42:27.25,Lalai,,0,0,0,,Jika saya tinggal di sana satu malam lagi,
Dialog: 0,0:42:27.25,0:42:29.02, Lalai,,0,0,0,,bibir saya yang cantik akan kebas.
Dialog: 0,0:42:29.96,0:42:31.93, Lalai,,0,0,0,,-Selesai?\N -Apa yang kamu cakapkan?
Dialog: 0,0:42:32.29,0:42:33.76,Lalai,,0,0,0,,Rengekan awak.
Dialog: 0,0:42:33.76,0:42:35.53, Lalai,,0,0,0,,Dan sedikit bercakap besar.
Dialog: 0,0:42:35.86,0:42:37.36, Lalai,,0,0,0,,Saya ada banyak lagi,
Dialog: 0,0:42:37.36,0:42:39.90,Lalai,,0,0,0,,tetapi saya akan berhenti di sini - \Nampaknya anda ada urusan penting.
Dialog: 0,0:42:41.50,0:42:44.27,Lalai,,0,0,0,,Okey. apa yang ada?
Dialog: 0,0:43:08.96,0:43:12.90,Lalai,,0,0,0,,Saya dengar awak buat topeng terbaik.
Dialog: 0,0:43:15.60,0:43:16.84, Lalai,,0,0,0,,Pilih sesuatu di sana.
Dialog: 0,0:43:22.11,0:43:23.54, Lalai,,0,0,0,,Wah, gigih...
Dialog: 0,0:43:27.01,0:43:28.72, Lalai,,0,0,0,,Saya tidak mahu topeng biasa.
Dialog: 0,0:43:29.08,0:43:32.29, Lalai,,0,0,0,,Saya bercadang untuk menjual\N topeng unik kepada pegawai.
Dialog: 0,0:43:32.62,0:43:33.72, Lalai,,0,0,0,,Unik?
Dialog: 0,0:43:37.56,0:43:42.13,Lalai,,0,0,0,,Kebelakangan ini anda kelihatan seperti milik saya
Dialog: 0,0:43:42.13,0:43:44.06, Lalai,,0,0,0,,dan pada masa yang sama tidak.
Dialog: 0,0:43:47.13,0:43:48.30, Lalai,,0,0,0,,Tuang air.
Dialog: 0,0:43:49.60,0:43:51.11, Lalai,,0,0,0,,Tuang air.
Dialog: 0,0:43:51.54,0:43:52.54,Lalai,,0,0,0,,Ya!
Dialog: 0,0:43:53.94,0:43:55.14, Lalai,,0,0,0,,-Chef Diraja.\N-Ya?
Dialog: 0,0:43:56.38,0:43:59.81, Lalai,,0,0,0,, Janda Ratu mahukan snek lewat.
Dialog: 0,0:44:01.75,0:44:04.25, Lalai,,0,0,0,,Tetapi saya tidak pasti anda boleh melakukannya.
Dialog: 0,0:44:05.09,0:44:06.29,Lalai,,0,0,0,,Apa khabar...
Dialog: 0,0:44:07.62,0:44:09.82,Lalai,,0,0,0,,Saya telah bekerja di dapur diraja selama 30 tahun,
Dialog: 0,0:44:09.82,0:44:12.03, Lalai,,0,0,0,,dan 12 daripadanya oleh chef diraja.
Dialog: 0,0:44:12.73,0:44:15.66, Lalai,,0,0,0,,Bagaimana saya boleh menjadi lebih teruk daripada permaisuri? \NRather lebih baik.
Dialog: 0,0:44:23.84,0:44:25.47,Lalai,,0,0,0,,Saya mempercayai anda sepenuhnya.
Dialog: 0,0:44:42.66,0:44:44.43, Lalai,,0,0,0,, Sial. sekali lagi.
Dialog: 0,0:44:55.17,0:44:56.20, Lalai,,0,0,0,, Sekali lagi.
Dialog: 0,0:45:18.09,0:45:19.59, Lalai,,0,0,0,,Lebih pantas.
Dialog: 0,0:45:25.43,0:45:26.53,Lalai,,0,0,0,,Itu sahaja?
Dialog: 0,0:45:27.87,0:45:31.77,Lalai,,0,0,0,,Saya memerah susu semua lembu di kandang.
Dialog: 0,0:45:31.94,0:45:35.21, Lalai,,0,0,0,,Tiada setitik susu lagi.
Dialog: 0,0:45:36.01,0:45:37.18,Lalai,,0,0,0,,Karut!
Dialog: 0,0:45:39.75,0:45:40.75,Lalai,,0,0,0,,Apa?
Dialog: 0,0:45:44.75,0:45:46.55,Lalai,,0,0,0,,Awak bajingan tanpa senjata.
Dialog: 0,0:46:02.34,0:46:03.57,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:46:09.38,0:46:11.65,Lalai,,0,0,0,,Saya tiba-tiba menjadi sangat marah, semuanya membuat saya marah.
Dialog: 0,0:46:11.81,0:46:13.18,Lalai,,0,0,0,,Bukan badan yang keliru ini,
Dialog: 0,0:46:13.18,0:46:14.58,Lalai,,0,0,0,,tidak berbaring seperti orang mati,
Dialog: 0,0:46:14.58,0:46:15.98, Lalai,,0,0,0,,jangan berasa seperti saya.
Dialog: 0,0:46:16.05,0:46:19.35,Lalai,,0,0,0,,Saya pun tidak tahu sama ada nama saya Chan So-yeon\N atau Kim Bong-hwan.
Dialog: 0,0:46:19.65,0:46:21.82,Lalai,,0,0,0,,Nah, ingatan anda kembali,
Dialog: 0,0:46:21.82,0:46:23.22,Lalai,,0,0,0,,jadi anda keliru.
Dialog: 0,0:46:24.99,0:46:26.76,Lalai,,0,0,0,,Adakah anda tahu apa yang paling saya benci?
Dialog: 0,0:46:27.53,0:46:29.36, Lalai,,0,0,0,,Saya sudah biasa dengan badan ini.
Dialog: 0,0:46:30.43,0:46:31.97,Lalai,,0,0,0,,Apa yang membuatkan saya selesa memakai skirt sekarang.
Dialog: 0,0:46:42.84,0:46:45.51,Lalai,,0,0,0,,Anda mungkin dalam tempoh anda. \NI akan membawakan anda beberapa pad.
Dialog: 0,0:46:50.58,0:46:51.62,Lalai,,0,0,0,,Saya ada
Dialog: 0,0:46:52.75,0:46:54.19, Lalai,,0,0,0,, bulanan?
Dialog: 0,0:47:09.90,0:47:11.07, Lalai,,0,0,0,,Court Lady Jeon!
Dialog: 0,0:47:11.57,0:47:13.37,Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,0:47:14.14,0:47:16.71, Lalai,,0,0,0,,Mengapa permaisuri masih belum pulang ke istana?
Dialog: 0,0:47:16.98,0:47:19.41, Lalai,,0,0,0,,Saya akan hantar surat lagi sekarang.
Dialog: 0,0:47:19.41,0:47:21.18,Lalai,,0,0,0,,Kami tidak berperang.
Dialog: 0,0:47:21.45,0:47:23.32,Lalai,,0,0,0,,Hantar sejurus subuh.
Dialog: 0,0:47:23.32,0:47:24.95,Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,0:47:28.22,0:47:31.66, Lalai,,0,0,0,,Kata abang saya tidak lagi mempunyai kuasa sedemikian?
Dialog: 0,0:47:33.73,0:47:36.76,Lalai,,0,0,0,,Usia tua adalah maksiat.
Dialog: 0,0:47:41.64,0:47:42.94, Lalai,,0,0,0,, Betapa saya lapar.
Dialog: 0,0:48:00.95,0:48:02.29, Lalai,,0,0,0,, Satu lagi.
Dialog: 0,0:48:09.30,0:48:10.60, Lalai,,0,0,0,,Tiada sesiapa.
Dialog: 0,0:48:11.33,0:48:13.03, Lalai,,0,0,0,, En.
Dialog: 0,0:48:23.84,0:48:25.51,Lalai,,0,0,0,,Itu awak. Masuklah.
Dialog: 0,0:48:27.11,0:48:29.22, Lalai,,0,0,0,,Menunggu kepulangan saya?
Dialog: 0,0:48:29.78,0:48:31.92,Lalai,,0,0,0,,Bagaimana anda tahu saya baru pulang?
Dialog: 0,0:48:33.89,0:48:34.89, Lalai,,0,0,0,,Hei.
Dialog: 0,0:48:35.52,0:48:36.59, Lalai,,0,0,0,,Tunggu sebentar.
Dialog: 0,0:48:38.63,0:48:41.53,Lalai,,0,0,0,,Bagaimanakah anda menjadi layu dalam masa 2 hari?
Dialog: 0,0:48:41.60,0:48:43.26,Lalai,,0,0,0,,En.
Dialog: 0,0:48:44.80,0:48:46.87, Lalai,,0,0,0,,Adakah anda telah membazirkan semua wang anda daripada penyangak?
Dialog: 0,0:48:47.13,0:48:48.77, Lalai,,0,0,0,,Atau adakah anda kehilangan dokumen untuk rumah anda?
Dialog: 0,0:48:48.90,0:48:51.77,Lalai,,0,0,0,,Saya berumur 14 tahun, saya naif.
Dialog: 0,0:48:52.57,0:48:54.51,Lalai,,0,0,0,,Masalah ini lebih serius.
Dialog: 0,0:48:55.08,0:48:56.44, Lalai,,0,0,0,,Kehilangan dokumen anda untuk tapak?
Dialog: 0,0:48:56.44,0:48:58.48,Lalai,,0,0,0,,Ini sudah berlaku semasa saya pergi...
Dialog: 0,0:49:01.21,0:49:03.18, Lalai,,0,0,0,,Keluarga anda juga mengalami musibah.
Dialog: 0,0:49:05.22,0:49:08.22,Lalai,,0,0,0,,Keluarga atau cinta?
Dialog: 0,0:49:09.59,0:49:11.56,Lalai,,0,0,0,,Itulah persoalannya.
Dialog: 0,0:49:17.20,0:49:19.80, Lalai,,0,0,0,,Lelaki malang.
Dialog: 0,0:49:19.87,0:49:22.94,Lalai,,0,0,0,,Kamu yang malang.
Dialog: 0,0:49:23.67,0:49:25.51, Lalai,,0,0,0,,Ini benar-benar masalah yang serius.
Dialog: 0,0:49:36.07,0:49:38.54,Lalai,,0,0,0,,Yang Mulia. Ratu Janda
Dialog: 0,0:49:38.54,0:49:40.52,Lalai,,0,0,0,,memanggil anda dengan pantas ke dewan Dongmyeongjong.
Dialog: 0,0:49:54.73,0:49:56.07,Lalai,,0,0,0,,Adakah anda menghubungi saya?
Dialog: 0,0:49:56.79,0:49:59.50,Lalai,,0,0,0,,Anda tidak percaya bahawa anda bersalah
Dialog: 0,0:49:59.50,0:50:02.13,Lalai,,0,0,0,,dalam kematian mendiang raja kan?
Dialog: 0,0:50:03.48,0:50:07.40,Lalai,,0,0,0,,Jadi anda melakukan segala yang mungkin\N untuk menyalahkan keluarga saya.
Dialog: 0,0:50:08.21,0:50:09.21,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:50:09.82,0:50:13.25,Lalai,,0,0,0,,Anda boleh menghina saya apa sahaja yang anda mahu,
Dialog: 0,0:50:13.65,0:50:16.11, Lalai,,0,0,0,,tetapi selamatkan mendiang raja kita.
Dialog: 0,0:50:16.21,0:50:18.86, Lalai,,0,0,0,,Sekali lagi awak bersembunyi di belakang anak saya.
Dialog: 0,0:50:19.56,0:50:23.56,Lalai,,0,0,0,,Sukar dipercayai, anda tidak tahu malu\N untuk menyalahkan seseorang untuk menyembunyikan rasa bersalah anda.
Dialog: 0,0:50:26.27,0:50:29.00,Lalai,,0,0,0,,Manusia mesti kenal dirinya,
Dialog: 0,0:50:29.29,0:50:32.77, Lalai,,0,0,0,,supaya tidak melakukan kesilapan yang sama dua kali.
Dialog: 0,0:50:35.23,0:50:39.31, Lalai,,0,0,0,,Terima kasih atas pelajaran.
Dialog: 0,0:50:46.79,0:50:51.11, Lalai,,0,0,0,,Saya sangat letih sehingga saya tidak boleh menanggalkan stokin saya.
Dialog: 0,0:50:56.50,0:50:59.67, Lalai,,0,0,0,,Saya berbesar hati untuk mengeluarkannya untuk anda.
Dialog: 0,0:51:18.19,0:51:20.32, Lalai,,0,0,0,,Hari Troli akan tiba.
Dialog: 0,0:51:21.59,0:51:24.71,Lalai,,0,0,0,,Pada masa ini kesabaran saya akan berakhir.
Dialog: 0,0:51:48.48,0:51:49.61, Lalai,,0,0,0,,Saya kembali.
Dialog: 0,0:51:50.42,0:51:51.42, Lalai,,0,0,0,,Ya.
Dialog: 0,0:51:53.48,0:51:56.19,Lalai,,0,0,0,,Saya dengar Jabatan Detektif ada banyak yang perlu dilakukan hari ini.
Dialog: 0,0:51:56.56,0:51:58.62, Lalai,,0,0,0,,Mereka kata kamu menentang pengawal diraja.
Dialog: 0,0:51:58.79,0:52:02.00, Lalai,,0,0,0,,Terdapat syak wasangka. Saya ingin mencari \Nevidence sebelum saya memberitahu anda.
Dialog: 0,0:52:02.00,0:52:04.69,Lalai,menembak,0,0,0,,Terdapat orang yang mencurigakan di kalangan pengawal diraja.
Dialog: 0,0:52:04.69,0:52:06.82, Lalai,,0,0,0,,Saya rasa terdapat tujuh daripadanya.
Dialog: 0,0:52:07.79,0:52:09.27, Lalai,,0,0,0,,Adakah anda tahu tentang mereka?
Dialog: 0,0:52:12.77,0:52:15.63,Lalai,,0,0,0,,Adakah anda fikir saya tidak menyentuhnya kerana saya tidak tahu tentang mereka?
Dialog: 0,0:52:19.84,0:52:23.11, Lalai,,0,0,0,,Jika anda berminat dengan mereka secara langsung, bagaimanakah mereka akan bertindak balas?
Dialog: 0,0:52:23.27,0:52:25.69, Lalai,,0,0,0,,Mereka akan menggali lubang yang lebih dalam dan berbaring ke dasar.
Dialog: 0,0:52:25.92,0:52:29.11, Lalai,,0,0,0,,Mereka akan menjadi lebih bijak dan bertindak secara rahsia.
Dialog: 0,0:52:29.15,0:52:32.63, Lalai,,0,0,0,,Apa yang boleh dilihat bukanlah ancaman.
Dialog: 0,0:52:32.88,0:52:37.00, Lalai,,0,0,0,, Buat mereka percaya bahawa anda tidak dapat melihatnya.
Dialog: 0,0:52:37.06,0:52:39.40,Lalai,,0,0,0,,Dan kemudian anda boleh membunuh mereka serta-merta,
Dialog: 0,0:52:39.40,0:52:41.67, Lalai,,0,0,0,,sebaik sahaja ia menjadi masalah.
Dialog: 0,0:52:42.84,0:52:44.29,Lalai,,0,0,0,,Saya tidak terfikir tentang itu.
Dialog: 0,0:52:45.86,0:52:47.44, Lalai,,0,0,0,,Adakah anda fikir,
Dialog: 0,0:52:48.04,0:52:50.38,Lalai,,0,0,0,,raja berada dalam kedudukan ini hanya kerana
Dialog: 0,0:52:50.38,0:52:52.07, Lalai,,0,0,0,, bahawa dia tidak mempunyai kebolehan?
Dialog: 0,0:52:53.77,0:52:57.94,Default,,0,0,0,,Sebabnya saya sendiri menanam rasa takut dalam fikirannya.
Dialog: 0,0:52:58.54,0:53:01.48,Lalai,,0,0,0,,Mudah untuk mengawal mereka yang takut.
Dialog: 0,0:53:01.71,0:53:04.48,Lalai,,0,0,0,,Jika orang yang berdiri di atas takut kepada saya,
Dialog: 0,0:53:04.48,0:53:07.09,Lalai,,0,0,0,,kuasa saya melebihi kuasanya.
Dialog: 0,0:53:09.50,0:53:14.13,Lalai,,0,0,0,,Saya akan menghubungi anda untuk soalan mengenai raja.
Dialog: 0,0:53:17.59,0:53:18.94, Lalai,,0,0,0,,Pergi berehat.
Dialog: 0,0:54:15.73,0:54:17.46, Lalai,,0,0,0,,Mereka tidak akan dapat mencari anda di sana.
Dialog: 0,0:54:17.69,0:54:19.29,Lalai,,0,0,0,,Saya pasti akan kembali untuk anda.
Dialog: 0,0:54:19.50,0:54:22.63, Lalai,,0,0,0,,Tetapi sehingga itu, jangan keluar untuk apa-apa.
Dialog: 0,0:54:22.63,0:54:25.17, Lalai,,0,0,0,,Bagaimana dengan saudara-saudara saya? Dan awak, ibu?
Dialog: 0,0:54:25.17,0:54:26.81,Lalai,,0,0,0,,Saya tidak apa-apa selagi awak masih hidup.
Dialog: 0,0:54:27.50,0:54:30.50,Lalai,,0,0,0,,Awak anak lelaki saya yang tunggal.
Dialog: 0,0:54:31.71,0:54:32.90,Lalai,,0,0,0,,Jika anda mati,
Dialog: 0,0:54:34.00,0:54:35.34, Lalai,,0,0,0,,Saya juga tidak boleh hidup.
Dialog: 0,0:54:36.98,0:54:38.07, Lalai,,0,0,0,,Lebih pantas!
Dialog: 0,0:54:56.13,0:54:57.13, Lalai,,0,0,0,,Lebih pantas!
Dialog: 0,0:56:30.23,0:56:31.59, Lalai,,0,0,0,,Sepertinya saya.
Dialog: 0,0:56:32.46,0:56:33.67, Lalai,,0,0,0,,Ini tidak benar.
Dialog: 0,0:56:35.86,0:56:37.04, Lalai,,0,0,0,,Kita perlu mencari buku perakaunan.
Dialog: 0,0:56:45.11,0:56:46.27,Lalai,,0,0,0,,Adakah saya salah?
Dialog: 0,0:56:47.31,0:56:48.38, Lalai,,0,0,0,,Mustahil.
Dialog: 0,0:56:55.69,0:56:57.46, Lalai,,0,0,0,,Saya tidak bersalah, Wonbeom!
Dialog: 0,0:56:58.11,0:57:02.23, Lalai,,0,0,0,,Saya dituduh palsu. Anak, saya tidak boleh berehat.
Dialog: 0,0:57:02.23,0:57:05.02, Lalai,,0,0,0,,Wonbom! Wonbom!
Dialog: 0,0:57:05.02,0:57:06.29, Lalai,,0,0,0,,-Itu bukan saya.\N-Wonbom.
Dialog: 0,0:57:06.29,0:57:08.90, Lalai,,0,0,0,,-Wonbom.\N-Wonbom.
Dialog: 0,0:57:08.90,0:57:11.67, Lalai,,0,0,0,,-Hanya anda yang terselamat.\N-Tidak adil.
Dialog: 0,0:57:12.34,0:57:14.94, Lalai,,0,0,0,,Ini semua pembohongan.
Dialog: 0,0:57:15.23,0:57:17.44, Lalai,,0,0,0,,Ia hanya dalam kepala saya.
Dialog: 0,0:57:17.63,0:57:20.15,Lalai,,0,0,0,,-Tidak, tidak.\N-Saya mengutuk awak.
Dialog: 0,0:57:20.15,0:57:22.44,Lalai,,0,0,0,,-Tidak.\N-Saya mengutuk awak.
Dialog: 0,0:57:46.96,0:57:48.07, Lalai,,0,0,0,, Kim Soyeon.
Dialog: 0,0:57:53.67,0:57:55.52,Lalai,,0,0,0,,Apa? Begitu serupa.
Dialog: 0,0:57:56.44,0:58:00.32,Lalai,,0,0,0,,Adakah anda rasa anda akan menjadi seperti Kim So-yeon yang sebenar?
Dialog: 0,0:58:00.65,0:58:03.36, Lalai,,0,0,0,,Mereka mempunyai persamaan: tiada ibu.
Dialog: 0,0:58:09.50,0:58:13.36, Lalai,,0,0,0,,Buku ini ditulis oleh seorang saintis dari Joseon.
Dialog: 0,0:58:13.36,0:58:14.36,Lalai,,0,0,0,,Arahan Awal untuk Kanak-kanak\NKim Soyeon
Dialog: 0,0:58:14.36,0:58:16.13, Lalai,,0,0,0,,Lima jenis perhubungan:
Dialog: 0,0:58:16.69,0:58:19.61,Lalai,,0,0,0,,bapa - anak lelaki, pembaris - subjek, suami - isteri,
Dialog: 0,0:58:20.00,0:58:21.46, Lalai,,0,0,0,,abang lelaki-adik lelaki,
Dialog: 0,0:58:21.46,0:58:23.17, Lalai,,0,0,0,, antara satu sama lain.
Dialog: 0,0:58:23.17,0:58:26.00, Lalai,,0,0,0,,Belajar bersungguh-sungguh sehingga buku itu lusuh.
Dialog: 0,0:58:26.84,0:58:28.31, Lalai,,0,0,0,,Mengapa anda mengulanginya lagi?
Dialog: 0,0:58:29.84,0:58:33.11, Lalai,,0,0,0,,Hari ini ialah pengebumian ibu saya.
Dialog: 0,0:58:33.92,0:58:35.71, Lalai,,0,0,0,,Ini buku dia.
Dialog: 0,0:58:36.86,0:58:39.86,Lalai,,0,0,0,,Jadi itulah yang anda lakukan apabila anda merindui ibu anda.
Dialog: 0,0:58:39.86,0:58:41.48,Lalai,,0,0,0,,
Dialog: 0,0:58:42.02,0:58:43.25, Lalai,,0,0,0,,Saya menangis,
Dialog: 0,0:58:43.82,0:58:47.13, Lalai,,0,0,0,,belum menemui cara untuk berjumpa dengan ibu saya lagi.
Dialog: 0,0:58:47.90,0:58:49.00, Lalai,,0,0,0,, Yang mana satu?
Dialog: 0,0:58:49.90,0:58:53.21,Lalai,,0,0,0,,Jika saya mati, saya akan jumpa dia.
Dialog: 0,0:59:27.04,0:59:28.13, Lalai,,0,0,0,, Hidup?
Dialog: 0,0:59:30.81,0:59:32.27,Lalai,,0,0,0,,Adakah anda datang untuk mati juga?
Dialog: 0,0:59:33.81,0:59:35.00, Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:59:35.82,0:59:37.34, Lalai,,0,0,0,,Saya datang ke sini untuk mati.
Dialog: 0,0:59:43.09,0:59:46.63, Lalai,,0,0,0,,Adakah anda mahu hidup? Kerana anda takut mati?
Dialog: 0,0:59:51.25,0:59:52.27, Lalai,,0,0,0,,No.
Dialog: 0,0:59:53.46,0:59:57.09, Lalai,,0,0,0,,Semua orang mati kecuali saya. Itu yang menakutkan.
Dialog: 0,0:59:58.50,0:59:59.61,Lalai,,0,0,0,,Kemudian
Dialog: 0,1:00:01.11,1:00:02.40,Lalai,,0,0,0,,mari kita mati bersama.
Dialog: 0,1:00:16.56,1:00:18.15,Lalai,,0,0,0,,Mari kita lakukan pada kiraan tiga.
Dialog: 0,1:00:19.06,1:00:20.09,Lalai,,0,0,0,,Ya.
Dialog: 0,1:00:31.09,1:00:32.81,Lalai,,0,0,0,,Bunyi datang dari sini!
Dialog: 0,1:00:37.11,1:00:38.23,Lalai,,0,0,0,,Abang?
Dialog: 0,1:00:38.54,1:00:40.15,Lalai,,0,0,0,,Tahukah anda betapa risaunya saya?
Dialog: 0,1:00:40.65,1:00:42.94,Lalai,,0,0,0,,Seluruh keluarga sedang mencari anda.
Dialog: 0,1:00:42.94,1:00:45.17,Lalai,,0,0,0,,Abang.
Dialog: 0,1:00:51.61,1:00:52.88,Lalai,,0,0,0,,Saya akan turun kepada anda.
Dialog: 0,1:00:55.29,1:00:56.92,Lalai,,0,0,0,,Turunkan sahaja tangga.
Dialog: 0,1:00:57.52,1:00:58.59,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:01:05.46,1:01:08.50,Lalai,,0,0,0,,Maaf. Tetapi saya masih mahu hidup.
Dialog: 0,1:01:10.81,1:01:12.75,Lalai,,0,0,0,,Anda mahu hidup juga, bukan?
Dialog: 0,1:01:18.71,1:01:20.21,Lalai,,0,0,0,,Saya akan kembali.
Dialog: 0,1:01:27.48,1:01:28.75,Lalai,,0,0,0,,Jika anda mahu hidup,
Dialog: 0,1:01:29.63,1:01:33.46,Lalai,,0,0,0,,jika anda mahu hidup semula, kemudian kembalikan kepada saya.
Dialog: 0,1:01:47.15,1:01:49.17,Lalai,,0,0,0,,-Bolehkah anda sampai?\N-Ya.
Dialog: 0,1:02:02.59,1:02:03.69,Lalai,,0,0,0,,Ayah.
Dialog: 0,1:02:06.13,1:02:07.42,Lalai,,0,0,0,,Sila.
Dialog: 0,1:02:07.42,1:02:10.29,Lalai,,0,0,0,,Cik Soyeon.
Dialog: 0,1:02:17.23,1:02:21.31,Lalai,,0,0,0,,Ayah, tolong. Ayah.
Dialog: 0,1:02:21.31,1:02:25.02,Lalai,,0,0,0,,Ayah! Tolonglah!
Dialog: 0,1:02:25.02,1:02:28.25,Lalai,,0,0,0,,Ayah, ayah!
Dialog: 0,1:02:28.25,1:02:29.59,Lalai,,0,0,0,,-Sila.\N-Letakkan perigi.
Dialog: 0,1:02:29.92,1:02:34.63,Lalai,,0,0,0,,Ayah, tidak! Tidak perlu, ayah!
Dialog: 0,1:02:34.63,1:02:37.36,Lalai,,0,0,0,,Ayah! Jangan buat begini!
Dialog: 0,1:02:40.46,1:02:42.00,Lalai,,0,0,0,,Tidak! Ayah!
Dialog: 0,1:02:42.54,1:02:46.63,Lalai,,0,0,0,,Tidak perlu, ayah! Tidak perlu!
Dialog: 0,1:02:47.13,1:02:50.07,Lalai,,0,0,0,,Tolong ayah! Jangan buat begini!
Dialog: 0,1:02:50.63,1:02:53.40,Lalai,,0,0,0,,Ayah, tidak! Ayah!
Dialog: 0,1:02:53.57,1:02:56.15,Lalai,,0,0,0,,Ayah!
Dialog: 0,1:03:03.56,1:03:05.09,Lalai,,0,0,0,,Kedua-dua ibu dan gadis ini.
Dialog: 0,1:03:05.82,1:03:08.06,Lalai,,0,0,0,,Saya masih tidak percaya janji mereka.
Dialog: 0,1:03:09.50,1:03:11.06,Lalai,,0,0,0,,Semuanya akan berakhir apabila saya mati.
Dialog: 0,1:03:11.73,1:03:14.59,Lalai,,0,0,0,,Ini tidak akan berakhir sehingga perigi diisi dengan air.
Dialog: 0,1:03:16.44,1:03:17.54,Lalai,,0,0,0,,Tidak pernah.
Dialog: 0,1:03:47.59,1:03:49.44,Lalai,,0,0,0,,Selamatkan saya!
Dialog: 0,1:03:50.00,1:03:53.36,Lalai,,0,0,0,,Selamatkan saya, selamatkan saya!
Dialog: 0,1:03:53.57,1:03:55.84,Lalai,,0,0,0,,Simpan! Tolonglah!
Dialog: 0,1:03:55.98,1:03:59.17,Lalai,,0,0,0,,Maaf! Tolong selamatkan saya!
Dialog: 0,1:03:59.17,1:04:00.44,Lalai,,0,0,0,,Ini salah saya.
Dialog: 0,1:04:00.84,1:04:02.67,Lalai,,0,0,0,,Dia akan mati kerana saya.
Dialog: 0,1:04:02.67,1:04:05.04,Lalai,,0,0,0,,Sebab saya dedahkan rahsianya.
Dialog: 0,1:04:05.04,1:04:07.71,Default,,0,0,0,,Saya beritahu pembantu rumah tentang dia.
Dialog: 0,1:04:07.92,1:04:09.69,Lalai,,0,0,0,,Adakah anda mendengar apa yang orang dewasa katakan?
Dialog: 0,1:04:10.32,1:04:11.61,Lalai,,0,0,0,,Keluarganya adalah pengkhianat.
Dialog: 0,1:04:11.96,1:04:14.32,Lalai,,0,0,0,,Tetapi dia tidak melakukan apa-apa.
Dialog: 0,1:04:14.75,1:04:17.59,Default,,0,0,0,,Abang, awak seorang yang baik, kan?
Dialog: 0,1:04:18.15,1:04:21.32,Lalai,,0,0,0,,Tolong, abang.
Dialog: 0,1:04:29.11,1:04:31.04,Lalai,,0,0,0,,Datang ke sini cepat.
Dialog: 0,1:04:39.98,1:04:42.46,Lalai,,0,0,0,,Abang saya memang seorang yang baik.
Dialog: 0,1:04:54.52,1:04:56.94,Lalai,,0,0,0,,Simpan. Selamatkan saya.
Dialog: 0,1:04:57.00,1:05:00.04,Lalai,,0,0,0,,Sila. Jimat.
Dialog: 0,1:05:09.82,1:05:10.98,Lalai,,0,0,0,,Kita perlu cepat.
Dialog: 0,1:05:20.48,1:05:21.88,Lalai,,0,0,0,,Anda benar-benar kembali.
Dialog: 0,1:05:23.25,1:05:24.92,Lalai,,0,0,0,,Seperti yang dijanjikan.
Dialog: 0,1:06:07.04,1:06:08.84,Lalai,,0,0,0,,
Dialog: 0,1:06:17.27,1:06:18.54,Lalai,,0,0,0,,Saya mahu hidup.
Dialog: 0,1:06:19.61,1:06:20.65,Lalai,,0,0,0,,Seperti anda.
Dialog: 0,1:06:27.73,1:06:29.52,Lalai,,0,0,0,,Kim Soyeon
Dialog: 0,1:06:48.31,1:06:50.07,Lalai,,0,0,0,,Orang takut gelap,
Dialog: 0,1:06:50.61,1:06:53.19, Lalai,,0,0,0,,supaya mereka menghidupkan lampu.
Dialog: 0,1:07:08.09,1:07:09.79,Lalai,,0,0,0,,Rahsia
Dialog: 0,1:07:16.20,1:07:17.98,Lalai,,0,0,0,,Tetapi semakin terang cahayanya,
Dialog: 0,1:07:18.81,1:07:20.61,Lalai,,0,0,0,,semakin hitam bayang-bayang.
Dialog: 0,1:07:37.62,1:07:40.53,Lalai,,0,0,0,,Hwajin.
Dialog: 0,1:08:00.74,1:08:05.06,Lalai,,0,0,0,,
Dialog: 0,1:08:20.61,1:08:22.11,Lalai,,0,0,0,,Apa yang berlaku?
Dialog: 0,1:08:22.11,1:08:24.33,Lalai,,0,0,0,,Tepat sekali, saya hampir menyentuhnya.
Dialog: 0,1:08:26.04,1:08:27.15,Lalai,,0,0,0,,Itu berbahaya.
Dialog: 0,1:08:27.15,1:08:29.04,Lalai,,0,0,0,,Anda boleh datang bila-bila masa anda mahu.
Dialog: 0,1:08:29.04,1:08:31.37,Lalai,,0,0,0,,Tetapi anda tidak boleh bertindak seperti yang anda mahu.
Dialog: 0,1:08:31.37,1:08:32.52,Lalai,,0,0,0,,Saya pasti ini palsu.
Dialog: 0,1:08:32.52,1:08:34.21,Lalai,,0,0,0,,Adakah anda mengatakan seseorang memalsukan identiti mereka?
Dialog: 0,1:08:34.21,1:08:36.95,Lalai,,0,0,0,,Saya akan mengalahkan satu musuh dengan bantuan yang lain.
Dialog: 0,1:08:36.95,1:08:39.19,Lalai,,0,0,0,,Jadi saya akan menjadi amat diperlukan:
Dialog: 0,1:08:39.19,1:08:41.49, Lalai,,0,0,0,,Makanan Korea dan penjagaan diri Korea.
Dialog: 0,1:08:41.49,1:08:44.12,Lalai,,0,0,0,,Ketakutan dan kebimbangan membuatkan anda hilang akal.
Dialog: 0,1:08:44.12,1:08:46.23,Lalai,,0,0,0,,Anda benar-benar anti-peminat saya.
Dialog: 0,1:08:46.23,1:08:48.90,Lalai,,0,0,0,,Saya bimbang tentang banyak perkara, tetapi saya menemui jalan keluar.
Dialog: 0,0:00:58.00,0:01:03.00,Lalai,,0,0,0,,


