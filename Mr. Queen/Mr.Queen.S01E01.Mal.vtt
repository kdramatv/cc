Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:04.02, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Алинасу, Алинасу
Dialog: 0,0:00:58.00,0:01:04.02,tajuk,,0,0,0,,{\pos(110,602)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:10.52,0:01:13.41,Lalai,LILY,0,0,0,,1 episod
Dialog: 0,0:01:24.70,0:01:26.90,Lalai,LILY,0,0,0,,Malah anjing yang paling jahat
Dialog: 0,0:01:26.90,0:01:28.79,Lalai,LILY,0,0,0,,tidak akan menggigit tangan yang memberinya makan.
Dialog: 0,0:01:28.90,0:01:30.16, Lalai, LILY,0,0,0,,Dia akan mengibaskan ekornya.
Dialog: 0,0:01:30.47,0:01:33.37,Lalai,LILY,0,0,0,,Apabila saya mula memasak pada 13,
Dialog: 0,0:01:33.37,0:01:36.27,Lalai,LILY,0,0,0,,Saya bermimpi untuk bekerja di Rumah Biru.
Dialog: 0,0:01:36.34,0:01:39.57,Lalai,LILY,0,0,0,,Saya mahu menjadi orang yang memberi makan kepada orang yang paling berpengaruh.
Dialog: 0,0:01:40.11,0:01:42.07,Lalai,LILY,0,0,0,,Jadi saya jadi chef.
Dialog: 0,0:01:42.55,0:01:45.18,Lalai,LILY,0,0,0,,Anda menyebut tadi bahawa anda menjadi
Dialog: 0,0:01:45.18,0:01:47.35,Lalai,LILY,0,0,0,,tukang masak termuda di Rumah Biru.
Dialog: 0,0:01:47.35,0:01:49.08,Lalai,LILY,0,0,0,,-Saya menjadi yang pertama.\N-Apa?
Dialog: 0,0:01:55.53,0:01:56.65,Lalai,LILY,0,0,0,,Tahan.
Dialog: 0,0:01:57.96,0:01:59.06,Lalai,LILY,0,0,0,,Cod.
Dialog: 0,0:02:02.84,0:02:03.96, Lalai, LILY,0,0,0,, Akan dilakukan.
Dialog: 0,0:02:09.71,0:02:11.94, Lalai, LILY,0,0,0,, Duta tidak bertolak ansur dengan tulang dalam ikan.
Dialog: 0,0:02:11.94,0:02:13.34,Lalai,LILY,0,0,0,,Berhati-hati.
Dialog: 0,0:02:14.08,0:02:15.27,Lalai,LILY,0,0,0,,Ayuh.
Dialog: 0,0:02:17.78,0:02:19.82,Lalai,LILY,0,0,0,,Jika anda mengulangi ini lagi,
Dialog: 0,0:02:19.82,0:02:21.81,Lalai,LILY,0,0,0,,Saya hanya akan memberinya kepala ikan.
Dialog: 0,0:02:24.22,0:02:27.62,Lalai,LILY,0,0,0,,Chef masak sendiri ikan,
Dialog: 0,0:02:27.83,0:02:29.10, Lalai, LILY,0,0,0,,jangan risau.
Dialog: 0,0:02:29.10,0:02:31.12,Lalai,LILY,0,0,0,,Beliau ialah Maharaja Qin Shi Huang, atau apa?
Dialog: 0,0:02:31.30,0:02:32.59,Lalai,LILY,0,0,0,,Qin Shihuang?
Dialog: 0,0:02:33.30,0:02:36.49, Lalai, LILY,0,0,0,,Pai ikan telah dicipta untuk Qin Shihuang.
Dialog: 0,0:02:36.60,0:02:38.94, Lalai, LILY,0,0,0,, Maharaja Qin Shihuang sangat berkuasa,
Dialog: 0,0:02:38.94,0:02:41.01,Lalai,LILY,0,0,0,,iaitu apabila dia makan ikan kegemarannya setiap hari
Dialog: 0,0:02:41.01,0:02:42.64, Lalai, LILY,0,0,0,,dan dia terjumpa tulang,
Dialog: 0,0:02:42.64,0:02:45.17,Lalai,LILY,0,0,0,,dia memenggal kepala orang yang menyediakannya.
Dialog: 0,0:02:46.21,0:02:48.75,Lalai,LILY,0,0,0,,Setiap hari tukang masak mati,
Dialog: 0,0:02:48.75,0:02:50.51,Lalai,LILY,0,0,0,,dan pada suatu hari bos baharu itu terfikir,
Dialog: 0,0:02:51.22,0:02:53.12, Lalai, LILY,0,0,0,, kematian juga menantinya.
Dialog: 0,0:02:53.12,0:02:55.59,Lalai,LILY,0,0,0,,Dalam keputusasaan, dia secara mekanikal
Dialog: 0,0:02:55.59,0:02:58.95, Lalai, LILY,0,0,0,,memotong ikan pada papan pemotong.
Dialog: 0,0:02:59.83,0:03:00.98,Lalai,LILY,0,0,0,,Eureka.
Dialog: 0,0:03:01.96,0:03:04.22,Lalai,LILY,0,0,0,,Dia sangat bertuah.
Dialog: 0,0:03:06.53,0:03:09.56,Lalai,LILY,0,0,0,,Mungkin mengejutkan anda bahawa seseorang membunuh yang lain untuk makanan,
Dialog: 0,0:03:09.80,0:03:11.53, Lalai, LILY,0,0,0,,tetapi ini bukan sekadar makanan.
Dialog: 0,0:03:11.80,0:03:15.70,Lalai,LILY,0,0,0,,Hidangan yang disediakan dengan betul akan mencairkan hati yang paling keras.
Dialog: 0,0:03:16.21,0:03:20.40,Lalai,LILY,0,0,0,,Ini adalah senjata paling menawan di dunia.
Dialog: 0,0:03:22.52,0:03:26.18,Lalai,LILY,0,0,0,,Inilah yang saya fikirkan apabila saya memasak di Rumah Biru.
Dialog: 0,0:03:26.92,0:03:29.55,Lalai,LILY,0,0,0,,"Memasak adalah politik."
Dialog: 0,0:03:30.19,0:03:32.96,Lalai,LILY,0,0,0,,Memandangkan kami menyentuh topik ini, jawab soalan,
Dialog: 0,0:03:32.96,0:03:35.39,Lalai,LILY,0,0,0,,yang semua orang minati.
Dialog: 0,0:03:35.39,0:03:38.85,Lalai,LILY,0,0,0,,Sebagai contoh, apakah rahsia di Rumah Biru?
Dialog: 0,0:03:39.70,0:03:42.06,Lalai,LILY,0,0,0,,Pertama, saya ingin menjelaskan sesuatu.
Dialog: 0,0:03:42.40,0:03:44.23,Lalai,LILY,0,0,0,,Nama saya tidak akan didedahkan
Dialog: 0,0:03:44.47,0:03:47.16,Lalai,LILY,0,0,0,,dan akan membayar secara tunai. baik?
Dialog: 0,0:03:53.61,0:03:56.35,Lalai,LILY,0,0,0,,Kamera? Terdapat litar pintas kerana kebocoran,
Dialog: 0,0:03:56.35,0:03:57.67,Lalai,LILY,0,0,0,,tidak berfungsi sepanjang minggu.
Dialog: 0,0:03:59.82,0:04:02.55,Lalai,LILY,0,0,0,,Adakah ia pecah sendiri, atau seseorang melanggarnya?
Dialog: 0,0:04:03.56,0:04:06.72,Lalai,LILY,0,0,0,,Ada kalanya anda perlu menutup mata terhadap perkara ini.
Dialog: 0,0:04:07.83,0:04:10.65,Lalai,LILY,0,0,0,,Terima kasih kepada ini, saya bertuah.
Dialog: 0,0:04:12.10,0:04:14.47,Lalai,LILY,0,0,0,,Adakah perkara biasa kita berada di sini?
Dialog: 0,0:04:14.47,0:04:17.07,Lalai,LILY,0,0,0,,Selepas menghidangkan hidangan utama, permainan tamat.
Dialog: 0,0:04:17.07,0:04:20.10,Lalai,LILY,0,0,0,,Sekarang duta China sedang mengecap syurga.
Dialog: 0,0:04:30.72,0:04:32.61,Lalai,LILY,0,0,0,,
Dialog: 0,0:04:46.67,0:04:48.86, Lalai,LILY,0,0,0,,Ketua Chan! Cari dia!
Dialog: 0,0:04:50.64,0:04:51.79, Lalai,LILY,0,0,0,,Ketua Chan!
Dialog: 0,0:04:52.57,0:04:54.80,Lalai,LILY,0,0,0,,-Di manakah anda?\N-Bummers.
Dialog: 0,0:04:55.34,0:04:57.43,Lalai,LILY,0,0,0,,Memenatkan untuk menjadi sangat keren.
Dialog: 0,0:04:58.41,0:05:00.48,Lalai,LILY,0,0,0,,Duta Besar sangat menyukai makanan saya,
Dialog: 0,0:05:00.48,0:05:02.61,Lalai,LILY,0,0,0,,apa yang dia mahu ucapkan terima kasih secara peribadi?
Dialog: 0,0:05:03.52,0:05:04.85,Lalai,LILY,0,0,0,,Kembali segera, Seongyeon.
Dialog: 0,0:05:04.85,0:05:06.31,Lalai,LILY,0,0,0,,Nama saya Hyejeong.
Dialog: 0,0:05:07.52,0:05:09.08,Lalai,LILY,0,0,0,,Seongyeon lebih sesuai dengan anda.
Dialog: 0,0:05:20.67,0:05:24.16, Lalai,LILY,0,0,0,,1 episod: Jang Bong-hwan di Wonderland
Dialog: 0,0:05:29.04,0:05:30.33, Lalai,LILY,0,0,0,,Anjing marah. Ia mungkin menggigit.
Dialog: 0,0:05:40.52,0:05:41.61,Lalai,LILY,0,0,0,,Tuhan.
Dialog: 0,0:05:41.75,0:05:43.71,Lalai,LILY,0,0,0,,Tek, ayuh.
Dialog: 0,0:05:45.96,0:05:47.03,Lalai,LILY,0,0,0,,Jang Bong-hwan.
Dialog: 0,0:05:47.03,0:05:48.82,Lalai,LILY,0,0,0,,Polis Jongno.
Dialog: 0,0:05:51.90,0:05:56.10,Lalai,LILY,0,0,0,,Ketua Chan, nama terakhirnya ialah Chan,
Dialog: 0,0:05:56.10,0:05:58.07,Lalai,LILY,0,0,0,,dia menggelar dirinya sebagai tukang masak terbaik di kawasan itu,
Dialog: 0,0:05:58.07,0:06:00.20,Lalai,LILY,0,0,0,,Saya rasa saya kalah kerana nama saya.
Dialog: 0,0:06:00.37,0:06:02.98, Lalai,LILY,0,0,0,,Apabila kami mula mempromosikan masakan Korea,
Dialog: 0,0:06:02.98,0:06:06.67,Lalai,LILY,0,0,0,,di seluruh dunia nama Pu Seungmin akan dikenali.
Dialog: 0,0:06:06.98,0:06:08.31,Lalai,LILY,0,0,0,,Bukan Chan Bong-hwan.
Dialog: 0,0:06:08.31,0:06:10.48, Lalai, LILY,0,0,0,,Cuba lebih baik dan jangan bercakap.
Dialog: 0,0:06:10.48,0:06:11.61, Lalai,LILY,0,0,0,,Okey.
Dialog: 0,0:06:12.08,0:06:14.28, Lalai, LILY,0,0,0,, Mereka tidak akan menyalahkan kami untuk perkara ini.
Dialog: 0,0:06:14.92,0:06:16.15,Lalai,LILY,0,0,0,,Kami bersih.
Dialog: 0,0:06:17.36,0:06:18.81, Lalai,LILY,0,0,0,,Anjing marah. Ia mungkin menggigit.
Dialog: 0,0:06:25.87,0:06:28.17,Lalai,LILY,0,0,0,,Baiklah. Mereka menakutkan kami.
Dialog: 0,0:06:28.17,0:06:30.00,Lalai,LILY,0,0,0,,Ikut bersama kami ke stesen.
Dialog: 0,0:06:30.00,0:06:31.37,Lalai,LILY,0,0,0,,Ia telah diputuskan,
Dialog: 0,0:06:31.37,0:06:33.37, Lalai, LILY,0,0,0,,mata kail tersangkut di situ semasa memancing,
Dialog: 0,0:06:33.37,0:06:35.01, Lalai, LILY,0,0,0,, dan saya telah dipecat.
Dialog: 0,0:06:35.01,0:06:36.04,Lalai,LILY,0,0,0,,Apa lagi?
Dialog: 0,0:06:36.04,0:06:38.13,Lalai,LILY,0,0,0,,Terdapat bukti rasuah semasa penghantaran produk.
Dialog: 0,0:06:39.35,0:06:40.54,Lalai,LILY,0,0,0,,Suapan apa?
Dialog: 0,0:06:40.78,0:06:43.52,Lalai,LILY,0,0,0,,Agak ketara dalam masa dua tahun.
Dialog: 0,0:06:43.52,0:06:45.31, Lalai, LILY,0,0,0,,Adakah bukti menunjuk kepada saya?
Dialog: 0,0:06:46.65,0:06:47.72,Lalai,LILY,0,0,0,,Di manakah anda mendapat idea itu?
Dialog: 0,0:06:47.72,0:06:49.56,Lalai,LILY,0,0,0,,Kami memerlukan keterangan anda.
Dialog: 0,0:06:49.56,0:06:51.55,Lalai,LILY,0,0,0,,Anda tidak tahu berpura-pura sama sekali.
Dialog: 0,0:06:54.13,0:06:55.38,Lalai,LILY,0,0,0,,Buka pintu.
Dialog: 0,0:06:55.43,0:06:57.70,Lalai,LILY,0,0,0,,Saya pasti anda, suka detektif yang baik,
Dialog: 0,0:06:57.70,0:06:58.90,Lalai,LILY,0,0,0,,jelas apa perjanjian itu
Dialog: 0,0:06:58.90,0:07:00.89, Lalai, LILY,0,0,0,,tidak boleh ditarik balik oleh bos yang mudah.
Dialog: 0,0:07:01.23,0:07:03.54,Lalai,LILY,0,0,0,,Poo Seungmin, cef sous abadi,
Dialog: 0,0:07:03.54,0:07:05.71,Lalai,LILY,0,0,0,,bekerja di sana lebih lama daripada saya.
Dialog: 0,0:07:05.71,0:07:07.07,Lalai,LILY,0,0,0,,Dia penjenayah.
Dialog: 0,0:07:07.07,0:07:08.61,Lalai,LILY,0,0,0,,Dia bersekongkol dengan beberapa orang besar
Dialog: 0,0:07:08.61,0:07:10.51, Lalai, LILY,0,0,0,, dan cuba meletakkan semua kesalahan kepada saya.
Dialog: 0,0:07:10.51,0:07:12.85,Lalai,LILY,0,0,0,,Tepat sekali. Itulah sebabnya anda perlu pergi ke balai polis
Dialog: 0,0:07:12.85,0:07:16.01,Lalai,LILY,0,0,0,,dan nyatakan pendapat anda tentangnya.
Dialog: 0,0:07:17.22,0:07:19.22,Lalai,LILY,0,0,0,,Saya menggaru-garu kepala, kenapa perlu bersusah payah dengan taman seperti itu,
Dialog: 0,0:07:19.22,0:07:20.69,Lalai,LILY,0,0,0,,untuk saya pergi,
Dialog: 0,0:07:20.69,0:07:21.81, Lalai, LILY,0,0,0,, tetapi inilah perkaranya.
Dialog: 0,0:07:22.32,0:07:24.78,Lalai,LILY,0,0,0,,Ini mungkin dilakukan oleh pengurus atau orang yang lebih tinggi.
Dialog: 0,0:07:25.46,0:07:26.92,Lalai,LILY,0,0,0,,Betulkah Pengarah Khan?
Dialog: 0,0:07:27.13,0:07:28.65,Lalai,LILY,0,0,0,,Kenapa monolog pelik ini?
Dialog: 0,0:07:28.89,0:07:30.16,Lalai,LILY,0,0,0,,Masa semakin suntuk.
Dialog: 0,0:07:30.16,0:07:32.15,Lalai,LILY,0,0,0,,Apa pendapat anda? Saya melengahkan masa.
Dialog: 0,0:07:32.73,0:07:34.22,Lalai,LILY,0,0,0,,Kami tergesa-gesa.
Dialog: 0,0:07:35.90,0:07:37.09,Lalai,LILY,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:07:39.11,0:07:41.66,Lalai,LILY,0,0,0,,Jang Bong-hwan, berhenti!
Dialog: 0,0:07:45.64,0:07:47.81,Lalai,LILY,0,0,0,,Kamu sangat tidak sabar.
Dialog: 0,0:07:47.81,0:07:49.45,Lalai,LILY,0,0,0,,Saya akan mengupah peguam,
Dialog: 0,0:07:49.45,0:07:51.75,Lalai,LILY,0,0,0,,Saya akan cari sesuatu untuk Poo Seungmin
Dialog: 0,0:07:51.75,0:07:53.28, Lalai, LILY,0,0,0,, dan saya sendiri akan datang kepada anda.
Dialog: 0,0:07:53.52,0:07:55.19,Lalai,LILY,0,0,0,,Anda akan menyelesaikan kes itu,
Dialog: 0,0:07:55.19,0:07:56.78,Lalai,LILY,0,0,0,,dan anda akan dinaikkan pangkat, bukankah anda bersetuju?
Dialog: 0,0:07:58.89,0:08:00.48,Lalai,LILY,0,0,0,,Berhenti. baik?
Dialog: 0,0:08:00.96,0:08:02.55,Lalai,LILY,0,0,0,,Awak dengar? baiklah.
Dialog: 0,0:08:03.16,0:08:04.42,Lalai,LILY,0,0,0,,Tinggalkan sudah.
Dialog: 0,0:08:07.20,0:08:08.32,Lalai,LILY,0,0,0,,Sial.
Dialog: 0,0:08:17.54,0:08:18.67,Lalai,LILY,0,0,0,,Hei!
Dialog: 0,0:08:20.05,0:08:21.95,Lalai,LILY,0,0,0,,Adakah anda benar-benar gila?
Dialog: 0,0:08:21.95,0:08:23.68, Lalai, LILY,0,0,0,,Ada tertulis - anjing yang marah.
Dialog: 0,0:08:23.68,0:08:24.85, Lalai, LILY,0,0,0,,Jangan mendekati.
Dialog: 0,0:08:24.85,0:08:28.41,Lalai,LILY,0,0,0,,Jang Bong-hwan! Anda dalam masalah!
Dialog: 0,0:08:34.96,0:08:36.05,Lalai,LILY,0,0,0,,Sial.
Dialog: 0,0:08:37.46,0:08:38.55,Lalai,LILY,0,0,0,,By the way.
Dialog: 0,0:08:39.06,0:08:41.10,Lalai,LILY,0,0,0,,Saya ada soalan penting. Adakah anda akan menjawab?
Dialog: 0,0:08:41.10,0:08:42.26,Lalai,LILY,0,0,0,,Yang mana?
Dialog: 0,0:08:42.37,0:08:44.36, Lalai,LILY,0,0,0,,Mengapa mereka memberikan sundae gukbap dalam bullpen?
Dialog: 0,0:08:45.04,0:08:46.97,Lalai,LILY,0,0,0,,Karut sungguh.
Dialog: 0,0:08:46.97,0:08:48.60, Lalai,LILY,0,0,0,,Saya benci sundae gukbap.
Dialog: 0,0:08:48.87,0:08:50.51,Lalai,LILY,0,0,0,,Adakah ini kafe tepi jalan untuk anda?
Dialog: 0,0:08:50.51,0:08:52.50,Lalai,LILY,0,0,0,,Adakah anda memutuskan untuk berehat di tepi lebuh raya?
Dialog: 0,0:08:52.81,0:08:54.81,Lalai,LILY,0,0,0,,Adakah anda mengeluh tentang menu?
Dialog: 0,0:08:54.81,0:08:56.01,Lalai,LILY,0,0,0,,Saya seorang chef!
Dialog: 0,0:08:56.52,0:08:59.02,Lalai,LILY,0,0,0,,Walaupun dalam masa yang sukar saya fikir tentang makanan.
Dialog: 0,0:08:59.02,0:09:01.14,Lalai,LILY,0,0,0,,-Saya bos yang terbaik!\N-Nah, anda tidak terfikir.
Dialog: 0,0:09:08.66,0:09:10.22,Lalai,LILY,0,0,0,,Tahan saya!
Dialog: 0,0:09:10.90,0:09:13.36,Lalai,LILY,0,0,0,,Sial. Saya hampir mati.
Dialog: 0,0:09:17.80,0:09:19.30,Lalai,LILY,0,0,0,,Cantik, ya?
Dialog: 0,0:09:46.67,0:09:47.79,Lalai,LILY,0,0,0,,No.
Dialog: 0,0:09:48.00,0:09:51.53,Lalai,LILY,0,0,0,,Terlalu ramai wanita yang saya belum pernah bersama.
Dialog: 0,0:10:12.66,0:10:15.68,Lalai,LILY,0,0,0,,Bantuan. Saya mahu hidup.
Dialog: 0,0:10:16.16,0:10:18.32,Lalai,LILY,0,0,0,,Saya benar-benar mahu hidup.
Dialog: 0,0:11:08.41,0:11:10.57,Lalai,LILY,0,0,0,,Adakah saya di syurga?
Dialog: 0,0:11:11.55,0:11:13.54,Lalai,LILY,0,0,0,,No. saya akan hidup.
Dialog: 0,0:11:16.09,0:11:17.35,Lalai,LILY,0,0,0,,Kain buruk apa?
Dialog: 0,0:11:18.39,0:11:20.35,Lalai,LILY,0,0,0,,Adakah saya masih hidup di bilik mayat?
Dialog: 0,0:11:26.63,0:11:27.86,Lalai,LILY,0,0,0,,Tidak, bukan di bilik mayat.
Dialog: 0,0:11:30.10,0:11:32.76, Lalai, LILY,0,0,0,, Sewajarnya, saya tidak akan pergi ke syurga.
Dialog: 0,0:11:32.94,0:11:34.51, Lalai, LILY,0,0,0,,Saya tidak melakukan apa-apa kesalahan,
Dialog: 0,0:11:34.51,0:11:35.83, Lalai, LILY,0,0,0,, tetapi juga bagus.
Dialog: 0,0:11:38.48,0:11:41.50,Lalai,LILY,0,0,0,,Apakah tempat purba ini?
Dialog: 0,0:11:53.96,0:11:55.22,Lalai,LILY,0,0,0,,Kampung Hanok?
Dialog: 0,0:11:56.60,0:12:00.32,Lalai,LILY,0,0,0,,Saya jatuh dari ketinggian sedemikian, kenapa tiada apa-apa yang menyakitkan?
Dialog: 0,0:12:05.67,0:12:08.63,Lalai,LILY,0,0,0,,Tepat sekali. Squats boleh menyelamatkan nyawa.
Dialog: 0,0:12:09.21,0:12:11.90,Lalai,LILY,0,0,0,,Adakah saya masih hidup, okay? berharga saya...
Dialog: 0,0:12:12.51,0:12:14.90,Lalai,LILY,0,0,0,,Apa? Ke mana perginya otot?
Dialog: 0,0:12:15.65,0:12:18.41, Lalai, LILY,0,0,0,,Ke mana perginya orang-orang berharga saya, bersemangat dengan kesukaran sedemikian?
Dialog: 0,0:12:19.39,0:12:23.05,Lalai,LILY,0,0,0,,Sial. Apabila anda kehilangan otot, ia bertukar menjadi lemak.
Dialog: 0,0:12:23.69,0:12:25.88,Lalai,LILY,0,0,0,,Berapa lama saya keluar?
Dialog: 0,0:12:27.63,0:12:28.82,Lalai,LILY,0,0,0,,Apa?
Dialog: 0,0:12:29.76,0:12:30.92,Lalai,LILY,0,0,0,,Apakah ini?
Dialog: 0,0:13:13.74,0:13:15.53,Lalai,LILY,0,0,0,,Ini adalah mimpi.
Dialog: 0,0:13:16.08,0:13:18.67,Lalai,LILY,0,0,0,,Hampir mati, dan masih wanita dalam fikiran saya.
Dialog: 0,0:13:18.78,0:13:19.97,Lalai,LILY,0,0,0,,Saya tidak apa-apa.
Dialog: 0,0:13:20.45,0:13:24.38,Lalai,LILY,0,0,0,,Tetapi saya harus bermimpi bahawa saya bersama seorang wanita, dan bukan sebaliknya.
Dialog: 0,0:13:24.38,0:13:27.98,Lalai,LILY,0,0,0,,Terdapat garis halus antara mimpi yang baik dan mimpi ngeri.
Dialog: 0,0:13:29.19,0:13:31.95,Lalai,LILY,0,0,0,,Tetapi saya nampak wanita ini di suatu tempat.
Dialog: 0,0:13:32.29,0:13:33.68,Lalai,LILY,0,0,0,,Di Instagram?
Dialog: 0,0:13:34.36,0:13:37.55,Lalai,LILY,0,0,0,,No. Kami melihat satu sama lain secara peribadi di suatu tempat.
Dialog: 0,0:13:38.03,0:13:40.39,Lalai,LILY,0,0,0,,Sooyeon? Chaeyoung?
Dialog: 0,0:13:46.31,0:13:47.50, Lalai, LILY,0,0,0,, Hantu Tasik!
Dialog: 0,0:13:48.17,0:13:49.68,Lalai,LILY,0,0,0,,Adakah suara anda juga berubah?
Dialog: 0,0:13:49.68,0:13:50.87,Lalai,LILY,0,0,0,,Yang Mulia!
Dialog: 0,0:13:52.61,0:13:54.35,Lalai,LILY,0,0,0,,Anda akhirnya bangun!
Dialog: 0,0:13:54.35,0:13:56.24,Lalai,LILY,0,0,0,,Saya tahu awak akan bangun.
Dialog: 0,0:13:57.22,0:13:58.47,Lalai,LILY,0,0,0,,Terima kasih.
Dialog: 0,0:13:59.02,0:14:01.01,Lalai,LILY,0,0,0,,Saya sangat gembira.
Dialog: 0,0:14:03.32,0:14:05.52,Lalai,LILY,0,0,0,,-Jangan bergerak.\N-Apa? kenapa?
Dialog: 0,0:14:05.52,0:14:08.85,Lalai,LILY,0,0,0,,Anda masih tidak sihat, saya...
Dialog: 0,0:14:23.41,0:14:26.64,Lalai,LILY,0,0,0,,Itu sahaja. Beginilah impian sepatutnya. bagusnya...
Dialog: 0,0:14:30.48,0:14:32.41,Lalai,LILY,0,0,0,,Apakah ini? Dahsyat rasa.
Dialog: 0,0:14:32.75,0:14:35.01,Lalai,LILY,0,0,0,,Sangat tidak menyenangkan untuk diminum?
Dialog: 0,0:14:36.42,0:14:38.88,Lalai,LILY,0,0,0,,Mengapa saya rasa dalam mimpi saya?
Dialog: 0,0:14:40.46,0:14:42.32, Lalai, LILY,0,0,0,,Saya akan minta anda buat semula dan tambah likuoris.
Dialog: 0,0:14:43.33,0:14:46.59,Lalai,LILY,0,0,0,,Adakah ini bukan mimpi?
Dialog: 0,0:14:48.97,0:14:52.26,Lalai,LILY,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:14:55.55,0:14:57.03,Lalai,LILY,0,0,0,,Ini salah saya.
Dialog: 0,0:14:57.18,0:15:00.20,Lalai,LILY,0,0,0,,Saya tidak sepatutnya meninggalkan awak.
Dialog: 0,0:15:00.31,0:15:02.35,Lalai,LILY,0,0,0,,Saya sangat bertaubat,
Dialog: 0,0:15:02.35,0:15:05.97,Lalai,LILY,0,0,0,,bahawa saya tidak akan meninggalkan anda seminit lagi.
Dialog: 0,0:15:12.16,0:15:13.35, Lalai, TIRAMISU,0,0,0,,Yang Mulia?
Dialog: 0,0:15:34.65,0:15:35.87, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:15:47.09,0:15:48.25, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:15:48.66,0:15:49.75,Lalai,TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:15:50.40,0:15:51.62, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:15:52.36,0:15:53.89, Lalai, TIRAMISU,0,0,0,,Oh-oh-oh, ya ampun!
Dialog: 0,0:15:54.53,0:15:56.33, Lalai, TIRAMISU,0,0,0,,Tunggu, Yang Amat Mulia!
Dialog: 0,0:15:56.87,0:15:58.03, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:15:58.44,0:16:00.13,Lalai,TIRAMISU,0,0,0,,-Yang Mulia!\N-Tuhan kasihanilah!
Dialog: 0,0:16:00.31,0:16:02.51, Lalai, TIRAMISU,0,0,0,,-Bangun.\N-Di mana...
Dialog: 0,0:16:02.51,0:16:03.60, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:07.38,0:16:08.97, Lalai, TIRAMISU,0,0,0,,Mengapa mereka dianiaya? Ia menakutkan.
Dialog: 0,0:16:12.12,0:16:15.09, Lalai, TIRAMISU,0,0,0,,Yang Mulia! Awak tak patut lari macam tu.
Dialog: 0,0:16:15.09,0:16:17.38,Lalai,TIRAMISU,0,0,0,,Ke mana Tuanku?
Dialog: 0,0:16:18.49,0:16:20.79, Lalai, TIRAMISU,0,0,0,,Yang Mulia, ke mana awak hendak lari?
Dialog: 0,0:16:20.79,0:16:23.23, Lalai, TIRAMISU,0,0,0,,Merbahaya untuk berlari seperti itu! Sangat bahaya!
Dialog: 0,0:16:23.23,0:16:24.92, Lalai, TIRAMISU,0,0,0,,Sila tunggu, Yang Amat Mulia!
Dialog: 0,0:16:25.13,0:16:26.25,Lalai,TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:27.00,0:16:28.22, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:28.83,0:16:31.59,Lalai,TIRAMISU,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:16:31.87,0:16:33.03, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:35.21,0:16:36.53, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:37.11,0:16:38.33, Lalai, TIRAMISU,0,0,0,, Sial!
Dialog: 0,0:16:38.44,0:16:39.71,Lalai,TIRAMISU,0,0,0,,Tunggu, Yang Amat Mulia!
Dialog: 0,0:16:39.71,0:16:41.41, Lalai, TIRAMISU,0,0,0,, Dia bukan Hong Gildon, dari mana datangnya kebolehan sedemikian?
Dialog: 0,0:16:41.41,0:16:42.45, Lalai, TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:16:42.45,0:16:43.72, Lalai, TIRAMISU,0,0,0,,-Yang Mulia!\N-Saya mohon, jangan lari!
Dialog: 0,0:16:43.72,0:16:45.11,Lalai,TIRAMISU,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:16:45.35,0:16:46.61,Lalai,TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:16:48.22,0:16:49.68,Lalai,TIRAMISU,0,0,0,,Adakah ini sebuah istana?
Dialog: 0,0:16:50.56,0:16:53.46, Lalai, TIRAMISU,0,0,0,,-Pelik, sangat pelik.\N-Yang Mulia.
Dialog: 0,0:16:53.46,0:16:55.02,Lalai,TIRAMISU,0,0,0,,Jika ini bukan mimpi, lalu bagaimana?
Dialog: 0,0:16:55.23,0:16:56.43, Lalai, TIRAMISU,0,0,0,,Apakah maksud semua ini?
Dialog: 0,0:16:56.43,0:16:58.16, Lalai, TIRAMISU,0,0,0,,-Berhenti.\N-Yang Mulia.
Dialog: 0,0:16:58.16,0:17:00.10,Lalai,TIRAMISU,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:17:00.10,0:17:01.69, Lalai, TIRAMISU,0,0,0,,Yang Mulia!
Dialog: 0,0:17:05.77,0:17:07.70, Lalai, TIRAMISU,0,0,0,,Tetapi apa yang pelik ialah,
Dialog: 0,0:17:08.34,0:17:11.10, Lalai, TIRAMISU,0,0,0,,semasa saya berlari, tiada apa yang menghalang saya.
Dialog: 0,0:17:13.78,0:17:14.97, Lalai, TIRAMISU,0,0,0,,Tidak?
Dialog: 0,0:17:16.65,0:17:18.07,Lalai,TIRAMISU,0,0,0,,Di mana saudara mara saya?
Dialog: 0,0:17:19.62,0:17:21.51, Lalai, TIRAMISU,0,0,0,,-Anda tidak sepatutnya berbuat demikian.\N-Yang dihormati!
Dialog: 0,0:17:21.62,0:17:23.21, Lalai, TIRAMISU,0,0,0,,Di manakah mereka?
Dialog: 0,0:17:23.52,0:17:25.25,Lalai,TIRAMISU,0,0,0,,Apa yang anda cari?
Dialog: 0,0:17:25.46,0:17:27.92,Lalai,TIRAMISU,0,0,0,,Saya sendiri akan mencari segala-galanya di sini.
Dialog: 0,0:17:27.93,0:17:29.32,Lalai,TIRAMISU,0,0,0,,Jangan dekat saya!
Dialog: 0,0:17:32.20,0:17:33.36, Lalai, TIRAMISU,0,0,0,,Ternyata,
Dialog: 0,0:17:34.83,0:17:36.12,Lalai,TIRAMISU,0,0,0,,Saya mati pucuk.
Dialog: 0,0:17:36.64,0:17:37.67,Lalai,TIRAMISU,0,0,0,,Yang Mulia.
Dialog: 0,0:17:37.67,0:17:40.83, Lalai, TIRAMISU,0,0,0,,Anda tidak boleh berlari seperti itu, anda boleh cedera!
Dialog: 0,0:17:41.51,0:17:45.30, Lalai, TIRAMISU,0,0,0,,Apa yang awak dah buat pada saya?
Dialog: 0,0:17:46.68,0:17:48.91, Lalai, TIRAMISU,0,0,0,,Jika anda mengambil berat tentang kesihatan anda,
Dialog: 0,0:17:48.91,0:17:51.01, Lalai, TIRAMISU,0,0,0,,hubungi doktor diraja.
Dialog: 0,0:17:52.35,0:17:54.29,Lalai,TIRAMISU,0,0,0,,Saya tidak kisah siapa dia, biarkan sahaja dia mencucuk hidungnya,
Dialog: 0,0:17:54.29,0:17:56.68, Lalai, TIRAMISU,0,0,0,,Saya akan buat dia mati pucuk juga!
Dialog: 0,0:18:00.16,0:18:01.58,Lalai,TIRAMISU,0,0,0,,Apa kejadahnya.
Dialog: 0,0:18:01.63,0:18:04.16, Lalai, TIRAMISU,0,0,0,,Adakah pemerdagang manusia melakukan perkara seperti ini?
Dialog: 0,0:18:04.16,0:18:06.69, Lalai, TIRAMISU,0,0,0,,Mengapa mereka menculik seorang lelaki dan mencacatkan dia seperti itu? Untuk apa?
Dialog: 0,0:18:08.57,0:18:10.67, Lalai, TIRAMISU,0,0,0,,Siapa yang mengupah anda?
Dialog: 0,0:18:10.67,0:18:13.26,Lalai,TIRAMISU,0,0,0,,Adakah si bodoh itu Poo Seungmin\N meluapkan kemarahannya kepada saya?
Dialog: 0,0:18:13.77,0:18:14.86, Lalai, TIRAMISU,0,0,0,,Apa?
Dialog: 0,0:18:16.14,0:18:17.57, Lalai, TIRAMISU,0,0,0,,Atau mungkin Pengarah Khan?
Dialog: 0,0:18:18.04,0:18:20.05, Lalai, TIRAMISU,0,0,0,,Adakah itu sebabnya awak bedah saya?
Dialog: 0,0:18:20.05,0:18:21.55, Lalai, TIRAMISU,0,0,0,,Apa, patut saya pesan kepada awak,
Dialog: 0,0:18:21.55,0:18:25.37,Lalai,TIRAMISU,0,0,0,,bolehkah anda menukar jantina seseorang dengan mudah?
Dialog: 0,0:18:34.96,0:18:38.49,Lalai,TIRAMISU,0,0,0,,Tetapi kenapa kamu semua berpakaian begitu?
Dialog: 0,0:18:40.57,0:18:43.29, Lalai, TIRAMISU,0,0,0,,Seolah-olah saya telah membuat lompat masa.
Dialog: 0,0:18:52.18,0:18:54.40, Lalai, TIRAMISU,0,0,0,,Apa?
Dialog: 0,0:19:04.09,0:19:06.55, Lalai, TIRAMISU,0,0,0,, Tahun berapa anda dilahirkan?
Dialog: 0,0:19:07.09,0:19:09.85,Lalai,TIRAMISU,0,0,0,,Saya dilahirkan pada 31 Mei 1988 di bawah tanda Gemini.
Dialog: 0,0:19:11.93,0:19:13.86,Lalai,TIRAMISU,0,0,0,,Di manakah anda tinggal?
Dialog: 0,0:19:13.97,0:19:15.90,Lalai,TIRAMISU,0,0,0,,Seoul, Jongno-gu, Sambonro 31
Dialog: 0,0:19:15.90,0:19:17.56, Lalai, TIRAMISU,0,0,0,,Sojeong Parkville, pangsapuri 302.
Dialog: 0,0:19:18.67,0:19:21.06, Lalai, TIRAMISU,0,0,0,,Siapa nama ibu bapa anda?
Dialog: 0,0:19:21.44,0:19:23.51,Lalai,TIRAMISU,0,0,0,,Nama ayah Chang Giryong, nama ibu Lee Sujin.
Dialog: 0,0:19:23.51,0:19:25.21,Lalai,TIRAMISU,0,0,0,,Seorang mengajar bahasa Cina, dan satu lagi mengajar sejarah Korea.
Dialog: 0,0:19:25.21,0:19:26.24,Lalai,TIRAMISU,0,0,0,,Mereka adalah guru yang yakin,
Dialog: 0,0:19:26.24,0:19:28.17, Lalai, TIRAMISU,0,0,0,,dan saya anak lelaki mereka yang gila, bodoh dan tunggal.
Dialog: 0,0:19:28.55,0:19:30.87, Lalai, TIRAMISU,0,0,0,,Apa? Ada lagi yang anda ingin tahu?
Dialog: 0,0:19:53.51,0:19:54.90,Lalai,TIRAMISU,0,0,0,,Bolehkah awak menggelitik saya?
Dialog: 0,0:19:57.68,0:19:58.80, Lalai, TIRAMISU,0,0,0,,Macam ini?
Dialog: 0,0:20:03.01,0:20:04.87, Lalai, TIRAMISU,0,0,0,,Jadi ini bukan mimpi.
Dialog: 0,0:20:05.12,0:20:06.64, Lalai, TIRAMISU,0,0,0,,Semuanya terlalu nyata.
Dialog: 0,0:20:07.45,0:20:09.45,Lalai,TIRAMISU,0,0,0,,Maka satu-satunya penjelasan ialah jiwa saya
Dialog: 0,0:20:09.45,0:20:11.81, Lalai, TIRAMISU,0,0,0,,kembali ke masa lalu dan mendiami badan ini.
Dialog: 0,0:20:13.46,0:20:14.78,Lalai,TIRAMISU,0,0,0,,Saya boleh bangun.
Dialog: 0,0:20:15.66,0:20:17.22,Lalai,TIRAMISU,0,0,0,,Dan jiwa saya akan meninggalkan jasad ini.
Dialog: 0,0:20:18.96,0:20:20.06, Lalai, TIRAMISU,0,0,0,,Dengar.
Dialog: 0,0:20:20.27,0:20:22.89, Lalai, TIRAMISU,0,0,0,, Beritahu saya semua yang anda tahu tentang wanita ini.
Dialog: 0,0:20:23.57,0:20:24.76,Lalai,TIRAMISU,0,0,0,,Wanita ini?
Dialog: 0,0:20:24.90,0:20:27.76,Lalai,TIRAMISU,0,0,0,,Saya bercakap sendiri. Beritahu saya apa yang berlaku kepada saya.
Dialog: 0,0:20:28.71,0:20:30.24, Lalai, TIRAMISU,0,0,0,,Ini semua salah saya.
Dialog: 0,0:20:30.24,0:20:31.97, Lalai, TIRAMISU,0,0,0,,Saya tidak tahu yang awak pergi tanpa saya.
Dialog: 0,0:20:33.25,0:20:34.74,Lalai,TIRAMISU,0,0,0,,Saya layak mati, Yang Amat Mulia.
Dialog: 0,0:20:36.35,0:20:37.92,Lalai,TIRAMISU,0,0,0,,Saya akan bunuh awak jika ini
Dialog: 0,0:20:37.92,0:20:39.51, Lalai, TIRAMISU,0,0,0,, akan menyelesaikan masalah saya.
Dialog: 0,0:20:40.45,0:20:41.71, Lalai, TIRAMISU,0,0,0,,Tetapi ia tidak akan berfungsi seperti itu.
Dialog: 0,0:20:42.69,0:20:44.18, Lalai, TIRAMISU,0,0,0,, Tenang.
Dialog: 0,0:20:44.76,0:20:46.65, Lalai, TIRAMISU,0,0,0,,Jangan menangis. macam ni.
Dialog: 0,0:20:47.36,0:20:50.49,Lalai,TIRAMISU,0,0,0,,Bila dan ke mana saya pergi bersendirian?
Dialog: 0,0:20:52.30,0:20:53.46, Lalai, TIRAMISU,0,0,0,,Nah,
Dialog: 0,0:20:54.77,0:20:56.70,Lalai,TIRAMISU,0,0,0,,2 malam lepas awak kata awak penat,
Dialog: 0,0:20:56.70,0:20:58.99, Lalai, TIRAMISU,0,0,0,, dan oleh itu meminta saya menyediakan bilik untuk tidur awal.
Dialog: 0,0:21:00.21,0:21:02.63, Lalai, TIRAMISU,0,0,0,,Dan saya pasti memeriksa bahawa anda sedang tidur,
Dialog: 0,0:21:02.84,0:21:04.67, Lalai, TIRAMISU,0,0,0,,sebelum kembali bekerja.
Dialog: 0,0:21:15.69,0:21:17.09, Lalai, TIRAMISU,0,0,0,,Kenapa kita perlu meronda?
Dialog: 0,0:21:17.09,0:21:19.68, Lalai, TIRAMISU,0,0,0,,Status kami terlalu tinggi untuk ini.
Dialog: 0,0:21:20.09,0:21:21.96,Lalai,TIRAMISU,0,0,0,,Kamu baru dua tahun bekerja di istana.
Dialog: 0,0:21:21.96,0:21:23.52, Lalai, TIRAMISU,0,0,0,,Adakah anda mempunyai status yang tinggi?
Dialog: 0,0:21:23.66,0:21:25.36,Lalai,TIRAMISU,0,0,0,,Kamu adalah abang Baginda.
Dialog: 0,0:21:25.36,0:21:27.09, Lalai, TIRAMISU,0,0,0,, Dan saya adalah sahabat Baginda.
Dialog: 0,0:21:27.10,0:21:28.59, Lalai, TIRAMISU,0,0,0,,Ini adalah status kami.
Dialog: 0,0:21:28.63,0:21:30.46, Lalai, TIRAMISU,0,0,0,,Cakap seperti salah seorang menteri.
Dialog: 0,0:21:31.20,0:21:33.80, Lalai, PENYANYI, 0,0,0,,Oh, betul-betul. pernah dengar?
Dialog: 0,0:21:33.91,0:21:35.73,Lalai,PENYANYI,0,0,0,,Mengenai gadis atau hantu?
Dialog: 0,0:21:35.87,0:21:38.63,Lalai,PENYANYI,0,0,0,,Setiap kali anda berbisik dan menjadi sangat risau,
Dialog: 0,0:21:38.84,0:21:40.27,Lalai,PENYANYI,0,0,0,,cakap tentang salah seorang daripada mereka.
Dialog: 0,0:21:40.31,0:21:42.24,Lalai,PENYANYI,0,0,0,,Saya bercakap tentang hantu anak dara.
Dialog: 0,0:21:42.55,0:21:43.74,Lalai,PENYANYI,0,0,0,,Tentang kedua-duanya, iaitu.
Dialog: 0,0:21:44.05,0:21:46.68,Lalai,PENYANYI,0,0,0,,Tentang semangat air dari tasik itu.
Dialog: 0,0:22:02.07,0:22:04.54,Lalai,PENYANYI,0,0,0,,Mereka melompat ke dalam air dan menyelamatkan anda.
Dialog: 0,0:22:04.54,0:22:06.87,Lalai,PENYANYI,0,0,0,,Doktor memeriksa nadi dan berkata semuanya baik-baik saja.
Dialog: 0,0:22:06.87,0:22:08.04,Lalai,PENYANYI,0,0,0,,Tetapi, apa yang peliknya,
Dialog: 0,0:22:08.04,0:22:12.33, Lalai, PENYANYI, 0,0,0,, anda belum bangun sepanjang hari.
Dialog: 0,0:22:13.41,0:22:15.00,Lalai,PENYANYI,0,0,0,,Dan kemudian anda baru bangun?
Dialog: 0,0:22:17.32,0:22:18.74,Lalai,PENYANYI,0,0,0,,Tochnyak, air.
Dialog: 0,0:22:18.98,0:22:20.99,Lalai,PENYANYI,0,0,0,,Dia dan saya berdua jatuh ke dalam air.
Dialog: 0,0:22:20.99,0:22:22.74,Lalai,PENYANYI,0,0,0,,Dan di sana jiwa kami bercampur aduk.
Dialog: 0,0:22:24.32,0:22:26.25,Lalai,PENYANYI,0,0,0,,Bawa saya ke tasik.
Dialog: 0,0:22:34.23,0:22:35.86,Lalai,PENYANYI,0,0,0,,Saya dah cakap jangan ikut saya.
Dialog: 0,0:22:36.43,0:22:38.50,Lalai,PENYANYI,0,0,0,,Saya tidak ingat,
Dialog: 0,0:22:38.50,0:22:40.14, Lalai, PENYANYI, 0,0,0,, semasa dia jatuh ke dalam air.
Dialog: 0,0:22:40.14,0:22:41.30, Lalai, PENYANYI, 0,0,0,, Frets?
Dialog: 0,0:22:42.87,0:22:44.97,Lalai,PENYANYI,0,0,0,,Kamu kaki tangan sialan.
Dialog: 0,0:22:45.38,0:22:47.64, Lalai, PENYANYI, 0,0,0,, Mereka tidak akan membenarkan anda melompat ke dalam air.
Dialog: 0,0:22:49.28,0:22:51.25,Lalai,PENYANYI,0,0,0,,Adakah kita akan betul?
Dialog: 0,0:22:51.25,0:22:53.38,Lalai,PENYANYI,0,0,0,,Ini adalah satu istana. Kenapa jauh sangat?
Dialog: 0,0:22:54.12,0:22:55.81,Lalai,PENYANYI,0,0,0,,Kami hampir sampai, Yang Amat Mulia.
Dialog: 0,0:22:56.55,0:22:59.81,Lalai,PENYANYI,0,0,0,,Tasik yang anda terjatuh adalah di sebalik batu itu.
Dialog: 0,0:23:01.23,0:23:02.38, Lalai, PENYANYI, 0,0,0,, Serang hendap!
Dialog: 0,0:23:03.63,0:23:04.85,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:23:06.63,0:23:08.79,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:23:09.17,0:23:10.33, Lalai, PENYANYI, 0,0,0,,Yang Mulia!
Dialog: 0,0:23:10.94,0:23:13.03,Lalai,PENYANYI,0,0,0,,Yang Mulia, jangan buat begitu!
Dialog: 0,0:23:13.97,0:23:15.24,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:23:15.24,0:23:17.23,Lalai,PENYANYI,0,0,0,,Berhenti!
Dialog: 0,0:23:17.64,0:23:19.47,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:23:19.88,0:23:21.77,Lalai,PENYANYI,0,0,0,,Ini berbahaya, Yang Amat Mulia!
Dialog: 0,0:23:25.48,0:23:29.44,Lalai,PENYANYI,0,0,0,,Jom balik. Kembali ke hidup saya dan badan saya yang berharga.
Dialog: 0,0:23:30.59,0:23:32.18,Lalai,PENYANYI,0,0,0,,Saya kadang-kadang akan beramal.
Dialog: 0,0:23:32.49,0:23:34.98,Lalai,PENYANYI,0,0,0,,Tolong, Yang Maha Kuasa, Buddha, Perawan Maria.
Dialog: 0,0:23:43.67,0:23:45.39,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:23:56.75,0:23:58.51,Lalai,PENYANYI,0,0,0,,Adakah anda benar-benar okay?
Dialog: 0,0:23:59.08,0:24:01.14, Lalai, PENYANYI, 0,0,0,,Mengapa tidak ada air di sana?
Dialog: 0,0:24:02.55,0:24:04.65,Lalai,PENYANYI,0,0,0,,Kemarau, dibom atau apa?
Dialog: 0,0:24:05.16,0:24:06.83, Lalai, PENYANYI, 0,0,0,, Supaya perkara ini tidak berulang,
Dialog: 0,0:24:06.83,0:24:08.78,Lalai,PENYANYI,0,0,0,,air telah disalirkan, Yang Amat Mulia!
Dialog: 0,0:24:09.06,0:24:11.19, Lalai, PENYANYI, 0,0,0,, Dan anda tidak tergesa-gesa untuk memberitahu saya.
Dialog: 0,0:24:11.53,0:24:13.37,Lalai,PENYANYI,0,0,0,,Saya mohon maaf, Yang Amat Mulia.
Dialog: 0,0:24:13.37,0:24:14.83,Lalai,PENYANYI,0,0,0,,Yang Mulia!
Dialog: 0,0:24:14.83,0:24:16.90,Lalai,PENYANYI,0,0,0,,Sial. Ia adalah "Yang Mulia."
Dialog: 0,0:24:16.90,0:24:18.73, Lalai, PENYANYI, 0,0,0,,Saya hanya akan sakit sekarang.
Dialog: 0,0:24:19.47,0:24:20.96,Lalai,PENYANYI,0,0,0,,Kenapa awak panggil saya begitu?
Dialog: 0,0:24:22.11,0:24:24.94,Lalai,PENYANYI,0,0,0,,Yang Mulia tidak sihat.
Dialog: 0,0:24:24.94,0:24:27.00,Lalai,PENYANYI,0,0,0,,Alamatkan dia sebagai Puan.
Dialog: 0,0:24:27.15,0:24:28.34,Lalai,PENYANYI,0,0,0,,Ya.
Dialog: 0,0:24:29.98,0:24:32.04, Lalai, PENYANYI, 0,0,0,,"Yang Mulia"? apa yang awak cakap ni?
Dialog: 0,0:24:33.45,0:24:36.08,Lalai,PENYANYI,0,0,0,,Anda dipilih sebelum perkahwinan.
Dialog: 0,0:24:36.22,0:24:38.35,Lalai,PENYANYI,0,0,0,,Oleh itu anda dipanggil Yang Teramat Mulia.
Dialog: 0,0:24:39.89,0:24:41.12, Lalai, PENYANYI, 0,0,0,,"Dipilih"?
Dialog: 0,0:24:43.19,0:24:44.30,Lalai,PENYANYI,0,0,0,,Maksudnya...
Dialog: 0,0:24:44.30,0:24:47.09,Lalai,PENYANYI,0,0,0,,Anda akan menjadi ratu.
Dialog: 0,0:24:49.53,0:24:53.70,Lalai,PENYANYI,0,0,0,,Jadi sekarang awak cakap saya akan jadi isteri raja?
Dialog: 0,0:24:54.61,0:24:55.76,Lalai,PENYANYI,0,0,0,,Ya.
Dialog: 0,0:24:57.84,0:25:01.54,Lalai,PENYANYI,0,0,0,,Saya menjadi gila sekarang, serius!
Dialog: 0,0:25:01.75,0:25:03.68,Lalai,PENYANYI,0,0,0,,Maafkan kami,
Dialog: 0,0:25:03.68,0:25:05.27,Lalai,PENYANYI,0,0,0,,Pn.
Dialog: 0,0:25:39.08,0:25:41.19,Lalai,PENYANYI,0,0,0,,Bagaimana anda boleh menjadi begitu cantik?
Dialog: 0,0:25:41.19,0:25:42.52,Lalai,PENYANYI,0,0,0,,Sangat kacak.
Dialog: 0,0:25:42.52,0:25:44.46,Lalai,PENYANYI,0,0,0,,Dan jemari yang anggun.
Dialog: 0,0:25:44.46,0:25:46.41,Lalai,PENYANYI,0,0,0,,Oh, mommies.
Dialog: 0,0:26:13.99,0:26:15.18,Lalai,PENYANYI,0,0,0,,Yang Mulia.
Dialog: 0,0:26:15.42,0:26:17.96,Lalai,PENYANYI,0,0,0,,2 jam sudah berlalu.
Dialog: 0,0:26:17.96,0:26:19.68,Lalai,PENYANYI,0,0,0,,Saya bimbang tentang kesihatan anda.
Dialog: 0,0:26:20.76,0:26:23.18,Lalai,PENYANYI,0,0,0,,Saya akan menasihatkan anda untuk menyelesaikannya untuk hari ini.
Dialog: 0,0:26:23.50,0:26:24.62,Lalai,PENYANYI,0,0,0,,Ketua Kasim.
Dialog: 0,0:26:25.50,0:26:27.89,Lalai,PENYANYI,0,0,0,,Untuk raja yang menjaga negara,
Dialog: 0,0:26:28.03,0:26:31.53,Lalai,PENYANYI,0,0,0,,keinginan untuk melahirkan waris harus diutamakan.
Dialog: 0,0:26:32.10,0:26:34.94,Lalai,PENYANYI,0,0,0,,Saya sangat penat, tugas ini sangat memenatkan saya.
Dialog: 0,0:26:34.94,0:26:37.37, Lalai, PENYANYI, 0,0,0,,Saya tidak boleh berhenti belajar.
Dialog: 0,0:26:45.55,0:26:47.98,Lalai,PENYANYI,0,0,0,,Baiklah, pilihan yang saya tempuh dalam masa tidak seperti itu.
Dialog: 0,0:26:48.25,0:26:49.51,Lalai,PENYANYI,0,0,0,,Tetapi kenapa perempuan?
Dialog: 0,0:26:49.75,0:26:52.35,Lalai,PENYANYI,0,0,0,,Dan bukan sebarang jenis, tetapi hanya tentang permaisuri?
Dialog: 0,0:26:53.29,0:26:54.96,Lalai,PENYANYI,0,0,0,,Saya tidak percaya pada perkahwinan.
Dialog: 0,0:26:54.96,0:26:56.48,Lalai,PENYANYI,0,0,0,,Mengapa saya harus menjadi isteri raja?
Dialog: 0,0:26:57.03,0:26:58.15,Lalai,PENYANYI,0,0,0,,Ayuh.
Dialog: 0,0:26:59.03,0:27:02.02,Lalai,PENYANYI,0,0,0,,Jika saya menjadi permaisuri, adakah itu bermakna saya berasal dari keluarga bangsawan?
Dialog: 0,0:27:03.43,0:27:06.16,Lalai,PENYANYI,0,0,0,,Adakah anda mahu mandi, puan?
Dialog: 0,0:27:10.21,0:27:12.77,Lalai,PENYANYI,0,0,0,,Panggil saya Yang Mulia. Call sepanjang hari.
Dialog: 0,0:27:14.01,0:27:15.70,Lalai,PENYANYI,0,0,0,,Yang Mulia.
Dialog: 0,0:27:16.41,0:27:18.51,Lalai,PENYANYI,0,0,0,,Saya permaisuri. Juga?
Dialog: 0,0:27:18.92,0:27:20.92,Lalai,PENYANYI,0,0,0,,Ya, Yang Amat Mulia.
Dialog: 0,0:27:20.92,0:27:22.58,Lalai,PENYANYI,0,0,0,,Jadi saya perintahkan kamu.
Dialog: 0,0:27:23.12,0:27:25.45, Lalai, PENYANYI, 0,0,0,,Ia sangat menjengkelkan, tetapi kini ia hanya muzik di telinga saya.
Dialog: 0,0:27:26.76,0:27:27.98,Lalai,PENYANYI,0,0,0,,Dengar.
Dialog: 0,0:27:28.53,0:27:31.03,Lalai,PENYANYI,0,0,0,,Isi tasik dengan air sekarang.
Dialog: 0,0:27:31.03,0:27:32.22,Lalai,PENYANYI,0,0,0,,Ini adalah pesanan.
Dialog: 0,0:27:34.33,0:27:36.32, Lalai, PENYANYI, 0,0,0,, Mudah, apa yang anda tidak fikirkan dengan segera?
Dialog: 0,0:27:38.30,0:27:40.29,Lalai,PENYANYI,0,0,0,,Kami tidak boleh, Yang Amat Mulia.
Dialog: 0,0:27:41.77,0:27:42.93,Lalai,PENYANYI,0,0,0,,Apa?
Dialog: 0,0:27:44.48,0:27:48.30,Lalai,PENYANYI,0,0,0,,Anda akan sedar apabila saya tunjukkan kuasa saya.
Dialog: 0,0:27:57.22,0:27:58.81,Lalai,PENYANYI,0,0,0,,Ampuni, Yang Amat Mulia.
Dialog: 0,0:27:59.67,0:28:01.08,Lalai,PENYANYI,0,0,0,,Saya layak mati.
Dialog: 0,0:28:01.08,0:28:03.50,Lalai,PENYANYI,0,0,0,,Tetapi masih. Mohon belas kasihan!
Dialog: 0,0:28:06.41,0:28:08.91, Lalai, PENYANYI, 0,0,0,, Hah? Apakah jenis reaksi?
Dialog: 0,0:28:10.54,0:28:12.56,Lalai,PENYANYI,0,0,0,,Akhirnya saya sedar.
Dialog: 0,0:28:14.31,0:28:17.08,Lalai,PENYANYI,0,0,0,,Memandangkan dia menyeksa wanita mahkamah seperti ini,
Dialog: 0,0:28:17.08,0:28:19.37, Lalai, PENYANYI, 0,0,0,, jelas sekali, dia sihat sepenuhnya.
Dialog: 0,0:28:21.14,0:28:22.44,Lalai,PENYANYI,0,0,0,,Bawa dia.
Dialog: 0,0:28:23.14,0:28:24.44,Lalai,PENYANYI,0,0,0,,Ya, Tuanku.
Dialog: 0,0:28:32.65,0:28:36.35,Lalai,PENYANYI,0,0,0,,Baginda ingin melihat anda di gazebonya.
Dialog: 0,0:28:38.33,0:28:40.69,Lalai,PENYANYI,0,0,0,,Yang Mulia.
Dialog: 0,0:28:43.04,0:28:44.16, Lalai, PENYANYI, 0,0,0,, Yang Mulia?
Dialog: 0,0:28:47.90,0:28:50.90,Lalai,PENYANYI,0,0,0,,Ya, bos tempatan.
Dialog: 0,0:29:18.24,0:29:22.53,Lalai,PENYANYI,0,0,0,,Nah, seperti yang anda jangkakan, tenaga ke neraka.
Dialog: 0,0:29:24.78,0:29:26.44,Lalai,PINEAPPELLER,0,0,0,,Tuanku, anda tidak akan percaya.
Dialog: 0,0:29:30.61,0:29:32.54,Lalai,PINEAPPELLER,0,0,0,,Apa atas nama keamanan yang berlaku kepada anda?
Dialog: 0,0:29:33.41,0:29:36.35,Lalai,PINEAPPELLER,0,0,0,,-Ya, ini perkara remeh semata-mata.\N-Sesuatu yang remeh?
Dialog: 0,0:29:36.36,0:29:40.38,Lalai,PINEAPPELLER,0,0,0,,Anda mesti kelihatan kemas\Nand berkelakuan mengikut status anda.
Dialog: 0,0:29:40.38,0:29:42.72,Lalai,PINEAPPELLER,0,0,0,,Ya, saya faham,\Ndengar sahaja, ini penting.
Dialog: 0,0:29:42.72,0:29:44.06,Lalai,PINEAPPELLER,0,0,0,,Saintis
Dialog: 0,0:29:44.36,0:29:47.50,Lalai,PINEAPPELLER,0,0,0,,sepatutnya bangun dengan ayam jantan pertama pada waktu pagi,
Dialog: 0,0:29:47.50,0:29:50.53,Lalai,NENAS,0,0,0,,nampak kemas dan tidak suka...
Dialog: 0,0:29:53.13,0:29:54.67,Lalai,PINEAPPELLER,0,0,0,,Jangan lupa tentang...
Dialog: 0,0:29:55.04,0:29:57.97,Lalai,PINEAPPELLER,0,0,0,,Jangan lupa tentang hati nurani anda, sentiasa bersikap baik!
Dialog: 0,0:29:58.87,0:30:01.97,Lalai,PINEAPPELLER,0,0,0,,Kemudian kita akan bercakap tentang falsafah.\NSesuatu yang penting berlaku.
Dialog: 0,0:30:02.44,0:30:05.21,Lalai,PINEAPPELLER,0,0,0,,Saya perlukan air dengan segera.
Dialog: 0,0:30:05.21,0:30:08.65,Lalai,PINEANANCE,0,0,0,,Kasim, bawa air kepada bakal ratu sekarang.
Dialog: 0,0:30:08.65,0:30:11.18, Lalai,PINEAPPELLER,0,0,0,,Bukan itu yang saya maksudkan!
Dialog: 0,0:30:11.18,0:30:12.85,Lalai,PINEAPPELLER,0,0,0,,Saya perlukan tasik!
Dialog: 0,0:30:13.80,0:30:15.42,Lalai,PINEAPPELLER,0,0,0,,Tiada air yang tinggal di tasik.
Dialog: 0,0:30:15.80,0:30:17.62,Lalai,PINEAPPELLER,0,0,0,,Adakah anda mahu,
Dialog: 0,0:30:17.62,0:30:20.22,Lalai,PINEAPPELLER,0,0,0,,supaya saya mengisi tasik dengan air?
Dialog: 0,0:30:21.57,0:30:23.16,Lalai,PINEAPPELLER,0,0,0,,Betul!
Dialog: 0,0:30:23.19,0:30:24.36, Lalai,PINEAPPELLER,0,0,0,,Saya tidak boleh.
Dialog: 0,0:30:25.27,0:30:29.10,Lalai,PINEAPPELLER,0,0,0,,-Kenapa?\N-Ini adalah perintah ratu janda.
Dialog: 0,0:30:29.13,0:30:32.87,Lalai,PINEANANCE,0,0,0,,Saya akan mengisi tasik dengan air -\NI akan melanggar perintahnya.
Dialog: 0,0:30:33.64,0:30:35.01,Lalai,PINEAPPELLER,0,0,0,,Nah, yang manakah antara kamu adalah raja?
Dialog: 0,0:30:36.52,0:30:39.14,Lalai,PINEAPPELLER,0,0,0,,Raja jenis apakah anda,\Ntidak dapat mengisi tasik?
Dialog: 0,0:30:43.38,0:30:45.48,Lalai,PINEAPPELLER,0,0,0,,Saya mesti mendengar ratu janda,
Dialog: 0,0:30:45.49,0:30:49.02,Lalai,PINEAPPELLER,0,0,0,,dia sangat mengambil berat tentang apa yang berlaku.
Dialog: 0,0:30:49.33,0:30:52.52,Lalai,PINEAPPELLER,0,0,0,,Selain itu, saya bersetuju dengan keputusan untuk mengeringkan tasik.
Dialog: 0,0:30:55.36,0:30:56.66, Lalai,PINEAPPELLER,0,0,0,,Dan apakah kebaikannya?
Dialog: 0,0:30:57.27,0:30:58.80,Lalai,PINEAPPELLER,0,0,0,,Jelaskan kepada saya seperti biasa.
Dialog: 0,0:31:02.47,0:31:03.54,Lalai,PINEAPPELLER,0,0,0,,Mudah.
Dialog: 0,0:31:03.54,0:31:05.17,Lalai,PINEAPPELLER,0,0,0,,Adakah awak bergurau?
Dialog: 0,0:31:12.25,0:31:14.15,Lalai,PINEAPPELLER,0,0,0,,Beraninya awak mengangkat tangan terhadap saya?
Dialog: 0,0:31:14.15,0:31:16.82,Lalai,PINEAPPELLER,0,0,0,,Anda nampaknya telah memutuskan bahawa anda adalah seorang saintis yang dihormati.
Dialog: 0,0:31:16.82,0:31:19.33,Lalai,PINEAPPELLER,0,0,0,,Tetapi adakah mungkin untuk menahan hidung apabila duduk di hadapan seseorang,
Dialog: 0,0:31:19.33,0:31:20.82,Lalai,PINEAPPELLER,0,0,0,,bukankah ini ketinggian ketidaksenonohan?
Dialog: 0,0:31:26.89,0:31:29.13,Lalai,PINEAPPELLER,0,0,0,,Saya gembira anda telah pulih.
Dialog: 0,0:31:29.43,0:31:31.13,Lalai,PINEAPPELLER,0,0,0,,Saya sangat risau.
Dialog: 0,0:31:31.43,0:31:34.57,Lalai,PINEAPPELLER,0,0,0,,Ya, ia membawa keikhlasan sejauh satu kilometer.
Dialog: 0,0:31:35.20,0:31:37.70,Lalai,PINEAPPELLER,0,0,0,,Adakah anda selalu bercakap seperti ini?
Dialog: 0,0:31:38.75,0:31:41.11,Lalai,PINEAPPELLER,0,0,0,,Saya hampir mati,\NI hanya dipenuhi dengan kemarahan.
Dialog: 0,0:31:41.55,0:31:43.87,Lalai,PINEAPPELLER,0,0,0,,Bagaimanakah anda terjatuh ke dalam tasik?
Dialog: 0,0:31:44.35,0:31:49.18,Lalai,PINEAPPELLER,0,0,0,,Ratu masa depan tidak ingat perkara ini.
Dialog: 0,0:31:50.62,0:31:52.08, Lalai,PINEAPPELLER,0,0,0,,Tidak ingat?
Dialog: 0,0:31:52.45,0:31:53.78,Lalai,PINEAPPELLER,0,0,0,,Pelik bagaimana.
Dialog: 0,0:31:54.62,0:31:56.95,Lalai,PINEANANCE,0,0,0,,Jadi anda membaca “Septateuch”!
Dialog: 0,0:31:56.95,0:31:59.22,Lalai,PINEAPPELLER,0,0,0,,Saya suka koleksi ini!
Dialog: 0,0:32:01.74,0:32:05.33,Lalai,PINEAPPELLER,0,0,0,,Saya benci apabila orang menyentuh buku saya.
Dialog: 0,0:32:07.37,0:32:09.70,Lalai,PINEAPPELLER,0,0,0,,Bagaimana ini boleh berlaku?\NI menyentuh buku anda.
Dialog: 0,0:32:11.17,0:32:13.35,Lalai,PINEAPPELLER,0,0,0,,Dia sudah pun kotor.\NBiar saya lihat.
Dialog: 0,0:32:13.35,0:32:17.44,Lalai,PINEAPPELLER,0,0,0,,Sudahlah!\NA isteri mesti patuh pada lelaki.
Dialog: 0,0:32:18.52,0:32:20.11,Lalai,PENAPPELLER,0,0,0,,Dia mesti mematuhi suaminya.
Dialog: 0,0:32:20.65,0:32:21.91,Lalai,PINEAPPELLER,0,0,0,,Itulah yang saya katakan.
Dialog: 0,0:32:21.91,0:32:23.95,Lalai,PINEAPPELLER,0,0,0,,-Anda berkata "lelaki."\N-Berhenti!
Dialog: 0,0:32:23.95,0:32:25.92,Lalai,PINEAPPELLER,0,0,0,,Yin tidak menentang yang,
Dialog: 0,0:32:25.92,0:32:29.22,Lalai,PINEAPPELLER,0,0,0,,dan isteri tunduk kepada suaminya!
Dialog: 0,0:32:30.00,0:32:31.79,Lalai,PINEAPPELLER,0,0,0,,Adakah kita tinggal di Joseon?
Dialog: 0,0:32:31.86,0:32:33.19, Lalai,PINEAPPELLER,0,0,0,,Di Joseon.
Dialog: 0,0:32:33.53,0:32:35.39,Lalai,PINEAPPELLER,0,0,0,,Dan anda mungkin membayangkan diri anda seorang raja.
Dialog: 0,0:32:36.04,0:32:37.96,Lalai,PENAPPELLER,0,0,0,,Saya adalah raja.
Dialog: 0,0:32:40.63,0:32:41.77,Lalai,PINEAPPELLER,0,0,0,,Nenek moyang, tolong dia.
Dialog: 0,0:32:45.44,0:32:47.20,Lalai,PINEAPPELLER,0,0,0,,Wanita yang menjijikkan.
Dialog: 0,0:32:50.88,0:32:52.08,Lalai,PINEAPPELLER,0,0,0,,Lepaskan saya.
Dialog: 0,0:32:55.09,0:32:56.28,Lalai,PINEAPPELLER,0,0,0,,Lepaskan.
Dialog: 0,0:32:57.49,0:33:00.42,Lalai,PINEAPPELLER,0,0,0,,Lepaskan buku, apa yang kamu lakukan?
Dialog: 0,0:33:00.59,0:33:02.72,Lalai,PINEAPPELLER,0,0,0,,Sesuatu yang tidak bersih di sini.
Dialog: 0,0:33:04.83,0:33:06.16,Lalai,NENAS,0,0,0,,Yang Mulia!
Dialog: 0,0:33:08.60,0:33:11.46, Lalai,PINEAPPELLER,0,0,0,,Sudah tiba masanya untuk menerima pegawai.
Dialog: 0,0:33:11.81,0:33:14.20,Lalai,PINEAPPELLER,0,0,0,,Adakah tiba masanya?
Dialog: 0,0:33:14.67,0:33:17.47,Lalai,PINEAPPELLER,0,0,0,,Hari raja memerintah negara,
Dialog: 0,0:33:17.47,0:33:19.64,Lalai,PINEAPPELLER,0,0,0,,regangan seperti jalur yang tidak berkesudahan...
Dialog: 0,0:33:19.64,0:33:22.84,Lalai,PINEAPPELLER,0,0,0,,Baiklah, awak sibuk! saya akan pergi.
Dialog: 0,0:33:49.67,0:33:52.04,Lalai,PINEANANCE,0,0,0,,Eunuch!
Dialog: 0,0:33:52.05,0:33:53.94,Lalai,PINEAPPELLER,0,0,0,,Ya!
Dialog: 0,0:34:18.03,0:34:19.36,Lalai,PINEANANCE,0,0,0,,Kasim,
Dialog: 0,0:34:19.70,0:34:22.67,Lalai,PINEANANCE,0,0,0,,anda tahu betapa saya menghargai koleksi ini.
Dialog: 0,0:34:25.01,0:34:26.78,Lalai,PINEAPPELLER,0,0,0,,Seiring bertambahnya usia saya menjadi lebih perlahan.
Dialog: 0,0:34:26.78,0:34:29.17,Lalai,PENAPPELLER,0,0,0,,Tangan tergelincir, tuan.
Dialog: 0,0:34:29.24,0:34:32.74, Lalai,PINEAPPELLER,0,0,0,,Buku ini berharga \Nas sebanyak tiga daripada gaji bulanan anda.
Dialog: 0,0:34:33.22,0:34:35.18,Lalai,PENAPPELLER,0,0,0,,Saya layak mati!
Dialog: 0,0:34:39.55,0:34:41.62,Lalai,PINEAPPELLER,0,0,0,,Tidak, anda tidak akan mati.
Dialog: 0,0:34:41.95,0:34:44.20,Lalai,PINEAPPELLER,0,0,0,,Tidak kira betapa mahalnya buku ini,
Dialog: 0,0:34:44.20,0:34:46.86,Lalai,PINEAPPELLER,0,0,0,, nyawa manusia jauh lebih berharga.
Dialog: 0,0:34:47.07,0:34:50.66,Lalai,NENAS,0,0,0,,Rahmat Tuanku tidak terbatas, Tuanku.
Dialog: 0,0:34:53.03,0:34:56.60,Lalai,PINEAPPELLER,0,0,0,,Anda berusaha untuk ilmu\Ndengan semangat yang sama seperti saya.
Dialog: 0,0:34:56.91,0:35:00.40,Lalai,PINEAPPELLER,0,0,0,,Saya akan menyediakan buku baharu untuk anda.
Dialog: 0,0:35:01.01,0:35:03.21,Lalai,PINEAPPELLER,0,0,0,,Tetapi sekarang saya ada mesyuarat dengan pegawai.
Dialog: 0,0:35:07.76,0:35:09.01,Lalai,PINEAPPELLER,0,0,0,,Hamba,
Dialog: 0,0:35:10.09,0:35:11.75,Lalai,PINEAPPELLER,0,0,0,,sediakan tandu saya.
Dialog: 0,0:35:15.22,0:35:17.89,Lalai,PINEAPPELLER,0,0,0,,Beri saya tumpangan.\NTempat di sini penuh.
Dialog: 0,0:35:20.20,0:35:22.99,Lalai,PINEAPPELLER,0,0,0,,Saya tidak mahu, ia akan menjadi sempit bersama.
Dialog: 0,0:35:23.74,0:35:26.56,Lalai,PINEAPPELLER,0,0,0,,Dan akhirnya basuh diri anda.
Dialog: 0,0:35:29.41,0:35:30.77, Lalai,PINEAPPELLER,0,0,0,,Maju.
Dialog: 0,0:35:38.34,0:35:41.25,Lalai,PINEAPPELLER,0,0,0,,Apa?\NCacing yang bijak.
Dialog: 0,0:35:54.34,0:35:57.13,Lalai,PINEAPPELLER,0,0,0,,Yang Mulia, jangan duduk di atas tanah!
Dialog: 0,0:35:57.16,0:35:59.26,Lalai,PINEAPPELLER,0,0,0,,Sakit pinggang saya.
Dialog: 0,0:36:10.47,0:36:12.31,Lalai,PINEAPPELLER,0,0,0,,Hilang ingatan?
Dialog: 0,0:36:18.28,0:36:21.25,Lalai,PINEAPPELLER,0,0,0,,Saya pasti semuanya tidak begitu mudah.
Dialog: 0,0:36:21.99,0:36:25.03,Lalai,PINEAPPELLER,0,0,0,,Sebelum peristiwa penting, penyakit itu bertambah teruk.
Dialog: 0,0:36:25.03,0:36:26.66,Lalai,PINEAPPELLER,0,0,0,,Dia meyakinkan dirinya bahawa dia adalah orang yang berbeza,
Dialog: 0,0:36:26.66,0:36:29.03,Lalai,PINEAPPELLER,0,0,0,,untuk melarikan diri daripada kebenaran.
Dialog: 0,0:36:53.86,0:36:58.46,Lalai,PINEAPPELLER,0,0,0,,Hanya saya dan Ratu Janda yang mendengar ini.
Dialog: 0,0:36:58.93,0:37:02.76,Lalai,PINEAPPELLER,0,0,0,,Jika sesiapa menyebut apa yang mereka dengar...
Dialog: 0,0:37:05.61,0:37:08.77, Lalai,PINEAPPELLER,0,0,0,,Ini tidak akan berlaku.
Dialog: 0,0:37:10.68,0:37:14.17,Lalai,PINEAPPELLER,0,0,0,,Cari cara untuk menyembuhkan Yang Amat Mulia.
Dialog: 0,0:37:14.84,0:37:16.04,Lalai,PINEAPPELLER,0,0,0,,Diperlukan.
Dialog: 0,0:37:41.53,0:37:46.94,Lalai,PINEAPPELLER,0,0,0,,Bagaimanakah kita boleh menjadikan seorang ratu perempuan yang tidak tahu namanya sendiri?
Dialog: 0,0:37:47.47,0:37:51.34,Lalai,PINEAPPELLER,0,0,0,,Kita boleh beritahu dia siapa namanya,\Nuntuk membantu mengembalikan ingatannya.
Dialog: 0,0:37:51.34,0:37:53.04, Lalai,PINEAPPELLER,0,0,0,,Jangan risau.
Dialog: 0,0:37:53.99,0:37:55.75,Lalai,PINEAPPELLER,0,0,0,,Adakah anda mahu berjumpa dengannya?
Dialog: 0,0:37:56.22,0:37:57.59,Lalai,PINEANANCE,0,0,0,,Banyak mata tertumpu kepada kita.
Dialog: 0,0:37:57.59,0:37:59.66,Lalai,PINEAPPELLER,0,0,0,,Tidak perlu memberi alasan kepada orang
Dialog: 0,0:37:59.66,0:38:01.53,Lalai,PINEANANCE,0,0,0,,bincangkan orang yang tidak mengenali keluarganya sendiri.
Dialog: 0,0:38:01.53,0:38:04.69,Lalai,PINEAPPELLER,0,0,0,,Sangat sedikit orang yang akan mengetahui tentang perkara ini.
Dialog: 0,0:38:05.97,0:38:08.99,Lalai,PINEAPPELLER,0,0,0,,Inilah yang merisaukan saya,
Dialog: 0,0:38:08.99,0:38:11.56,Lalai,PINEAPPELLER,0,0,0,,mengapa dia merayau seorang diri pada waktu malam?
Dialog: 0,0:38:11.66,0:38:12.96,Lalai,PINEAPPELLER,0,0,0,,Seseorang
Dialog: 0,0:38:14.07,0:38:17.50,Lalai,PINEAPPELLER,0,0,0,,menipunya dengan menyampaikan pesanan palsu daripada raja.
Dialog: 0,0:38:18.41,0:38:21.04,Lalai,PINEAPPELLER,0,0,0,,Jadi sukar untuk mengetahui apa-apa.
Dialog: 0,0:38:21.95,0:38:23.61,Lalai,PINEAPPELLER,0,0,0,,Tetapi siapa yang berani?
Dialog: 0,0:38:31.89,0:38:32.98,Lalai,PINEAPPELLER,0,0,0,,Dia bangun?
Dialog: 0,0:38:37.97,0:38:39.06,Lalai,PINEAPPELLER,0,0,0,,Betulkah?
Dialog: 0,0:38:43.09,0:38:45.13,Lalai,NENAS,0,0,0,,Saya pasti jimat itu berkesan.
Dialog: 0,0:38:46.26,0:38:48.07,Lalai,PINEAPPELLER,0,0,0,,Dan bomoh ini baik.
Dialog: 0,0:38:52.41,0:38:55.41,Lalai,PINEAPPELLER,0,0,0,,Jika sesuatu berlaku,\Nlaporkan kepada saya.
Dialog: 0,0:38:57.22,0:38:59.98,Lalai,PINEAPPELLER,0,0,0,,Khabar angin sedang beredar di sekitar istana,
Dialog: 0,0:39:00.24,0:39:01.99,Lalai,PINEAPPELLER,0,0,0,,seperti seorang gadis yang dipilih
Dialog: 0,0:39:01.99,0:39:04.31,Lalai,PINEANANCE,0,0,0,,untuk peranan seorang gundik,\N menolak pengantin perempuan raja ke dalam tasik.
Dialog: 0,0:39:04.49,0:39:06.88,Lalai,PINEANANCE,0,0,0,,Dia tidak akan menjadi gundik diraja.
Dialog: 0,0:39:08.16,0:39:09.93,Lalai,PINEAPPELLER,0,0,0,,Siapa namanya? Bagaimana dengan Hwajin?
Dialog: 0,0:39:09.93,0:39:11.05,Lalai,PINEAPPELLER,0,0,0,,Betul.
Dialog: 0,0:39:12.93,0:39:15.03,Lalai,PINEAPPELLER,0,0,0,,Saya perlukan alasan, ini dia.
Dialog: 0,0:39:15.34,0:39:17.64,Lalai,PENAPPELLER,0,0,0,,Selain itu, keluarganya semakin merosot.
Dialog: 0,0:39:17.64,0:39:19.40,Lalai,PINEAPPELLER,0,0,0,,Walaupun dengan bara
Dialog: 0,0:39:20.30,0:39:22.93,Lalai,PINEAPPELLER,0,0,0,,anda harus sangat berhati-hati.
Dialog: 0,0:39:24.20,0:39:25.94,Lalai,PINEANANCE,0,0,0,,Mengenai perubahan dalam undang-undang perkhidmatan awam,
Dialog: 0,0:39:26.11,0:39:29.32,Lalai,PINEAPPEN,0,0,0,,pihak konservatif dan progresif\Tidak dapat mencapai kata sepakat.
Dialog: 0,0:39:29.32,0:39:31.78,Lalai,PINEAPPELLER,0,0,0,,Selesaikan pertikaian kami, tuan.
Dialog: 0,0:39:32.41,0:39:33.71,Lalai,PINEAPPELLER,0,0,0,,Saya percaya
Dialog: 0,0:39:35.36,0:39:37.38,Lalai,PINEAPPELLER,0,0,0,,bahawa parti progresif,
Dialog: 0,0:39:38.53,0:39:40.65,Lalai,PINEAPPELLER,0,0,0,,tidak, konservatif...
Dialog: 0,0:39:41.76,0:39:45.52,Lalai,PINEAPPELLER,0,0,0,,Apakah yang perlu saya lakukan?
Dialog: 0,0:39:52.11,0:39:53.53,Lalai,PINEAPPELLER,0,0,0,,Parti Progresif
Dialog: 0,0:39:53.53,0:39:55.64,Lalai,PINEANANCE,0,0,0,,menuntut pemansuhan undang-undang ini,
Dialog: 0,0:39:55.64,0:39:58.01, Lalai, PINEANANCE,0,0,0,, tetapi kemudian kita akan menghadapi kerosakan ekonomi yang serius.
Dialog: 0,0:39:58.01,0:39:59.20,Lalai,PINEAPPELLER,0,0,0,,Nasihat saya -
Dialog: 0,0:39:59.20,0:40:01.77,Lalai,PINEAPPELLER,0,0,0,,ini adalah pemansuhan undang-undang secara beransur-ansur.
Dialog: 0,0:40:02.47,0:40:05.34,Lalai,PINEAPPELLER,0,0,0,,Terus dari lidah!
Dialog: 0,0:40:08.62,0:40:10.78,Lalai,PINEAPPELLER,0,0,0,,Seterusnya dalam agenda
Dialog: 0,0:40:10.78,0:40:12.48,Lalai,PINEAPPELLER,0,0,0,,tema perkahwinan diraja.
Dialog: 0,0:40:13.26,0:40:15.02,Lalai,PINEAPPELLER,0,0,0,,Saya tidak tahu sama ada anda mendengar,
Dialog: 0,0:40:15.36,0:40:17.79,Lalai,PINEAPPELLER,0,0,0,,tetapi pengantin perempuan saya akhirnya bangun.
Dialog: 0,0:40:18.26,0:40:19.37,Lalai,NENAS,0,0,0,,Yang Mulia,
Dialog: 0,0:40:19.37,0:40:21.74,Lalai,PINEAPPELLER,0,0,0,,khabar angin yang mengerikan sedang beredar di sekitar istana,
Dialog: 0,0:40:21.74,0:40:25.50,Lalai,PINEAPPELLER,0,0,0,,seolah-olah tunang anda hilang akal.
Dialog: 0,0:40:27.16,0:40:28.33,Lalai,PINEAPPELLER,0,0,0,,Serius?
Dialog: 0,0:40:28.97,0:40:31.13,Lalai,PINEAPPELLER,0,0,0,,Ini adalah kali pertama saya mendengar perkara seperti ini.
Dialog: 0,0:40:31.97,0:40:33.91,Lalai,PINEAPPELLER,0,0,0,,Dan fakta bahawa dia bangun,
Dialog: 0,0:40:33.91,0:40:35.77,Lalai,PINEAPPELLER,0,0,0,,Saya dapat tahu kerana kami bertemu.
Dialog: 0,0:40:36.28,0:40:39.71,Lalai,PINEAPPELLER,0,0,0,,Adakah saya orang terakhir yang mengetahui semua berita?
Dialog: 0,0:40:40.12,0:40:42.65,Lalai,PINEAPPELLER,0,0,0,,Ini hanyalah khabar angin.
Dialog: 0,0:40:43.05,0:40:46.18,Lalai,PINEAPPELLER,0,0,0,,Kami tidak mahu membimbangkan anda,
Dialog: 0,0:40:46.18,0:40:49.19,Lalai,PINEAPPELLER,0,0,0,,jadi mereka mendiamkan diri mengenainya.
Dialog: 0,0:40:49.43,0:40:50.86,Lalai,PINEAPPELLER,0,0,0,,Sungguh penyayang anda.
Dialog: 0,0:40:50.86,0:40:52.12,Lalai,PINEAPPELLER,0,0,0,,Saya pasti khabar angin ini
Dialog: 0,0:40:52.93,0:40:55.46,Lalai,PINEAPPELLER,0,0,0,,ada sebutir kebenaran.
Dialog: 0,0:40:58.11,0:40:59.41,Lalai,PINEAPPELLER,0,0,0,,Apabila kita bertemu,
Dialog: 0,0:40:59.41,0:41:01.60,Lalai,PINEAPPELLER,0,0,0,,dia sebenarnya berkelakuan agak berbeza.
Dialog: 0,0:41:03.28,0:41:05.87, Lalai,PINEAPPELLER,0,0,0,,Dia berkata bahawa dia tidak ingat bagaimana dia jatuh ke dalam tasik.
Dialog: 0,0:41:06.30,0:41:09.21,Lalai,PINEAPPELLER,0,0,0,,Perawan hilang ingatan kerana terkejut!
Dialog: 0,0:41:09.64,0:41:11.45,Lalai,PINEAPPELLER,0,0,0,,Jadi sesuatu yang dahsyat berlaku.
Dialog: 0,0:41:11.45,0:41:12.51,Lalai,PINEAPPELLER,0,0,0,,Seram?
Dialog: 0,0:41:12.51,0:41:14.95,Lalai,PINEAPPELLER,0,0,0,,Saya tidak percaya bahawa dia jatuh
Dialog: 0,0:41:14.95,0:41:17.05,Lalai,PINEAPPELLER,0,0,0,,adalah kemalangan.
Dialog: 0,0:41:18.05,0:41:19.16,Lalai,PINEAPPELLER,0,0,0,,Apa?
Dialog: 0,0:41:19.16,0:41:20.32,Lalai,PINEAPPELLER,0,0,0,,Tidak lama sebelum
Dialog: 0,0:41:20.32,0:41:22.39,Lalai,PINEANANCER,0,0,0,,sida, lalu berhampiran tasik,
Dialog: 0,0:41:22.39,0:41:24.89,Lalai,PINEANANCE,0,0,0,,ternampak seorang wanita pelik.
Dialog: 0,0:41:24.89,0:41:26.36,Lalai,PINEAPPELLER,0,0,0,,-Wanita pelik?\N-Siapa?
Dialog: 0,0:41:37.64,0:41:39.30,Lalai,PINEAPPELLER,0,0,0,,Dan siapakah itu?
Dialog: 0,0:41:40.01,0:41:42.07,Lalai,PINEAPPELLER,0,0,0,,Menurut rekod istana,
Dialog: 0,0:41:42.07,0:41:45.41,Lalai,PINEANANCE,0,0,0,,hanya seorang wanita sahaja yang memasuki istana pada masa itu.
Dialog: 0,0:41:46.32,0:41:48.35,Lalai,PINEAPPELLER,0,0,0,,Anak perempuan Cho Daesu,
Dialog: 0,0:41:48.59,0:41:50.15,Lalai,PINEAPPELLER,0,0,0,,Cho Hwajin.
Dialog: 0,0:41:53.55,0:41:55.79,Lalai,PINEAPPELLER,0,0,0,,Beraninya anda mengesyaki dia?
Dialog: 0,0:41:56.16,0:42:00.16,Lalai,PINEAPPELLER,0,0,0,,Hwajin tidak mempunyai sebab untuk membahayakan pengantin perempuan raja.
Dialog: 0,0:42:00.47,0:42:03.46,Lalai,PINEANANCE,0,0,0,,Dia akan menjadi gundik diraja.
Dialog: 0,0:42:04.03,0:42:05.76,Lalai,PINEAPPELLER,0,0,0,,Gadis itu mahu menjadi seorang ratu,
Dialog: 0,0:42:06.30,0:42:08.87,Lalai,PINEAPPELLER,0,0,0,,jadi dia mencederakan pesaingnya.
Dialog: 0,0:42:10.28,0:42:12.50,Lalai,PINEAPPELLER,0,0,0,,Cho Hwajin tidak bersalah, tuan.
Dialog: 0,0:42:13.14,0:42:17.05,Lalai,PINEAPPELLER,0,0,0,,Semua orang tahu betapa setianya Cho Daesu kepada mahkamah dan negara.
Dialog: 0,0:42:17.05,0:42:18.88,Lalai,PINEAPPELLER,0,0,0,,Dan anak perempuannya
Dialog: 0,0:42:19.34,0:42:22.26,Lalai,PINEANANCE,0,0,0,,terkenal kerana bangsawannya.
Dialog: 0,0:42:22.26,0:42:23.81,Lalai,PINEAPPELLER,0,0,0,,Ini adalah pengkhianatan!
Dialog: 0,0:42:25.16,0:42:26.59,Lalai,PINEAPPELLER,0,0,0,,Beraninya anda?
Dialog: 0,0:42:26.59,0:42:29.05,Lalai,PINEANANCE,0,0,0,,Kenapa dia diam-diam datang ke istana?
Dialog: 0,0:42:29.05,0:42:31.09,Lalai,PINEAPPELLER,0,0,0,,Adakah untuk bertemu dengan Ratu Janda?
Dialog: 0,0:42:31.09,0:42:33.02,Lalai,PINEAPPELLER,0,0,0,,Jelas, apa yang anda tuduh dia?
Dialog: 0,0:42:33.97,0:42:35.64,Lalai,PINEAPPELLER,0,0,0,,Anda tidak akan terlepas dengan ini dengan mudah!
Dialog: 0,0:42:35.64,0:42:36.76,Lalai,PINEAPPELLER,0,0,0,,Berdaulat,
Dialog: 0,0:42:37.30,0:42:40.23,Lalai,PINEAPPELLER,0,0,0,,Saya minta anda, jalankan siasatan,\Ncari kebenaran.
Dialog: 0,0:42:40.61,0:42:42.17,Lalai,PINEAPPELLER,0,0,0,,Dan hukuman seberat-beratnya kepada pelakunya!
Dialog: 0,0:43:03.30,0:43:04.52,Lalai,PINEAPPELLER,0,0,0,,Maaf.
Dialog: 0,0:43:08.43,0:43:11.86,Lalai,PINEAPPELLER,0,0,0,,Malah agak janggal untuk mengakui,
Dialog: 0,0:43:13.30,0:43:14.77,Lalai,PINEAPPELLER,0,0,0,,Cho Hwajin
Dialog: 0,0:43:15.64,0:43:18.64,Lalai,PINEAPPELLER,0,0,0,, menghabiskan malam itu dengan saya. Dari awal hingga akhir.
Dialog: 0,0:43:20.84,0:43:22.64,Lalai,PINEAPPELLER,0,0,0,,-Apa?\N-Apa?
Dialog: 0,0:43:22.84,0:43:23.95,Lalai,PINEAPPELLER,0,0,0,,Maafkan saya?
Dialog: 0,0:43:23.95,0:43:26.22,Lalai,TOLYANYCH,0,0,0,,Sudah tentu, belum ada majlis lagi
Dialog: 0,0:43:26.22,0:43:28.01,Lalai,TOLYANYCH,0,0,0,,dan dia belum lagi diisytiharkan sebagai gundik.
Dialog: 0,0:43:28.49,0:43:30.55,Lalai,TOLYANYCH,0,0,0,,Tetapi saya seorang lelaki muda, dalam kemuncak kehidupan saya.
Dialog: 0,0:43:31.86,0:43:34.89,Lalai,TOLYANYCH,0,0,0,,Walaupun anda sendiri tahu segala-galanya.
Dialog: 0,0:43:34.89,0:43:37.95,Lalai,TOLYANYCH,0,0,0,,Anda akan mengetahui segala-galanya jauh sebelum saya.
Dialog: 0,0:43:39.07,0:43:40.76,Lalai,TOLYANYCH,0,0,0,,Memandangkan kita telah membincangkan segala-galanya,
Dialog: 0,0:43:40.76,0:43:42.49,Lalai,TOLYANYCH,0,0,0,,Saya cadangkan jangan menangguhkan majlis.
Dialog: 0,0:43:42.49,0:43:44.70,Lalai,TOLYANYCH,0,0,0,,Supaya saya boleh mendapatkan gundik dengan cepat. Bagaimana anda menyukainya?
Dialog: 0,0:43:45.01,0:43:46.07, Lalai,TOLYANYCH,0,0,0,,Tetapi ini...
Dialog: 0,0:43:46.07,0:43:47.76,Lalai,TOLYANYCH,0,0,0,,Bagi kejadian baru-baru ini,
Dialog: 0,0:43:47.76,0:43:50.61,Lalai,TOLYANYCH,0,0,0,,semuanya akan diselesaikan apabila bakal ratu mengingati segala-galanya.
Dialog: 0,0:43:50.61,0:43:52.94,Lalai,TOLYANYCH,0,0,0,,Jangan membuat kesimpulan terlebih dahulu.
Dialog: 0,0:43:53.24,0:43:55.45,Lalai,TOLYANYCH,0,0,0,,Saya tidak dapat melihat anda bertengkar di sini.
Dialog: 0,0:43:55.45,0:43:57.47,Lalai,TOLYANYCH,0,0,0,,Semasa anda bersumpah, perkara lain terbiar.
Dialog: 0,0:44:04.59,0:44:05.78,Lalai,TOLYANYCH,0,0,0,,Bukan?
Dialog: 0,0:44:09.49,0:44:11.32,Lalai,TOLYANYCH,0,0,0,,Jika majlis berlangsung,
Dialog: 0,0:44:11.32,0:44:12.79, Lalai, TOLYANYCH,0,0,0,, Kims akan menjalankan segala-galanya.
Dialog: 0,0:44:13.03,0:44:15.76,Lalai,TOLYANYCH,0,0,0,,Baginda jelas memihak kepada Cho Hwajin.
Dialog: 0,0:44:15.76,0:44:17.83,Lalai,TOLYANYCH,0,0,0,,Yang bermaksud bahawa semuanya belum hilang.
Dialog: 0,0:44:18.91,0:44:22.47,Lalai,TOLYANYCH,0,0,0,,Masa depan keluarga Punyan Cho
Dialog: 0,0:44:22.91,0:44:24.80,Lalai,TOLYANYCH,0,0,0,,bergantung pada Cho Hwajin.
Dialog: 0,0:44:25.91,0:44:29.57,Lalai,TOLYANYCH,0,0,0,,Mari kita mulakan dengan menjadikan\N gundik dirajanya,
Dialog: 0,0:44:30.47,0:44:32.48, Lalai, TOLYANYCH,0,0,0,, dan kemudian kami akan membuat sesuatu.
Dialog: 0,0:44:32.62,0:44:35.51,Lalai,TOLYANYCH,0,0,0,,Majlis akan tetap berlangsung.
Dialog: 0,0:44:35.78,0:44:38.62,Lalai,TOLYANYCH,0,0,0,,Jadi mengapa anda tidak mempunyai wajah?
Dialog: 0,0:44:40.39,0:44:43.25,Lalai,TOLYANYCH,0,0,0,,Pertempuran di hadapan kita bukanlah mudah.
Dialog: 0,0:44:59.30,0:45:00.94,Lalai,TOLYANYCH,0,0,0,,Saya kurang pengetahuan,
Dialog: 0,0:45:01.28,0:45:03.91,Lalai,TOLYANYCH,0,0,0,,kami perlu bergantung pada anda untuk segala-galanya.
Dialog: 0,0:45:03.91,0:45:06.38,Lalai,TOLYANYCH,0,0,0,,-Maafkan saya. \N-Nah, apa yang awak cakapkan?
Dialog: 0,0:45:07.68,0:45:11.95,Lalai,TOLYANYCH,0,0,0,,Setiap hari anda menjadi lebih baik dan lebih baik.
Dialog: 0,0:45:13.62,0:45:15.22,Lalai,TOLYANYCH,0,0,0,,Anda terlalu baik.
Dialog: 0,0:45:15.49,0:45:17.36,Lalai,TOLYANYCH,0,0,0,,Walaupun dengan bantuan anda
Dialog: 0,0:45:17.36,0:45:19.46,Lalai,TOLYANYCH,0,0,0,,Saya hampir tidak dapat mengatasinya.
Dialog: 0,0:45:19.82,0:45:24.03, Lalai,TOLYANYCH,0,0,0,,Dan saya tidak mengambil kira bahawa anda perlu\N meletakkan tenaga lelaki anda di suatu tempat.
Dialog: 0,0:45:25.70,0:45:26.90,Lalai,TOLYANYCH,0,0,0,,Maaf.
Dialog: 0,0:45:27.11,0:45:30.83,Lalai,TOLYANYCH,0,0,0,,Mengapa, saya harus memohon maaf kerana tidak mengambil kira butiran penting sedemikian.
Dialog: 0,0:45:31.37,0:45:34.05,Lalai,TOLYANYCH,0,0,0,,Namun, dalam hubungan dengan wanita
Dialog: 0,0:45:34.05,0:45:36.07,Lalai,TOLYANYCH,0,0,0,,anda masih perlu dibimbing oleh kepala anda.
Dialog: 0,0:45:36.18,0:45:38.98,Lalai,TOLYANYCH,0,0,0,,Istana dalam kekal sebagai sebahagian daripada istana.
Dialog: 0,0:45:39.55,0:45:40.91,Lalai,TOLYANYCH,0,0,0,,Dan kita tidak boleh lupa,
Dialog: 0,0:45:41.51,0:45:44.28,Lalai,TOLYANYCH,0,0,0,,bahawa isteri anda lebih tinggi daripada gundik anda.
Dialog: 0,0:45:45.22,0:45:46.95,Lalai,TOLYANYCH,0,0,0,,Saya akan cuba untuk tidak lupa.
Dialog: 0,0:45:47.22,0:45:50.76,Lalai,TOLYANYCH,0,0,0,,Selain itu, kita perlu memastikan identiti wanita misteri itu,
Dialog: 0,0:45:50.76,0:45:53.06,Lalai,TOLYANYCH,0,0,0,,yang dilihat oleh sida-sida pada waktu malam.
Dialog: 0,0:45:53.30,0:45:56.93,Lalai,TOLYANYCH,0,0,0,,Kita perlu memastikan bahawa dia tidak akan mengalami situasi yang begitu rumit lagi.
Dialog: 0,0:45:58.64,0:45:59.80,Lalai,TOLYANYCH,0,0,0,,Sudah tentu.
Dialog: 0,0:46:00.57,0:46:02.03, Lalai,TOLYANYCH,0,0,0,,Anda betul, seperti selalu.
Dialog: 0,0:46:32.11,0:46:33.60,Lalai,TOLYANYCH,0,0,0,,Maafkan saya, puan.
Dialog: 0,0:46:33.84,0:46:37.03,Lalai,TOLYANYCH,0,0,0,,Kenapa anda mengambil masa yang lama untuk menulis ini.
Dialog: 0,0:46:54.18,0:46:57.69,Lalai,TOLYANYCH,0,0,0,,Jika bukan kerana anda, saya tidak akan pernah habis menulis puisi itu.
Dialog: 0,0:46:58.16,0:46:59.89, Lalai, TOLYANYCH,0,0,0,, Dan dia tidak akan begitu cantik.
Dialog: 0,0:47:01.47,0:47:03.03, Lalai, TOLYANYCH,0,0,0,, Puji saya, puan.
Dialog: 0,0:47:04.39,0:47:05.64,Lalai,TOLYANYCH,0,0,0,,Pn.
Dialog: 0,0:47:05.64,0:47:08.60,Lalai,TOLYANYCH,0,0,0,,Mereka membawa dekri dari istana.
Dialog: 0,0:47:14.14,0:47:16.11,Lalai,TOLYANYCH,0,0,0,,Dengar titah Baginda.
Dialog: 0,0:47:20.72,0:47:23.05,Lalai,TOLYANYCH,0,0,0,,Cho Hwajin, anak perempuan ketua setiausaha mahkamah Cho Daesu,
Dialog: 0,0:47:23.05,0:47:24.89,Lalai,TOLYANYCH,0,0,0,,dimaklumkan bahawa esok selepas majlis akad nikah akan diadakan
Dialog: 0,0:47:24.89,0:47:27.55,Lalai,TOLYANYCH,0,0,0,,pandangan pilihan gundik diraja\N. Sebagai salah seorang calon
Dialog: 0,0:47:27.55,0:47:29.02,Lalai,TOLYANYCH,0,0,0,,dia harus datang ke istana dengan segera.
Dialog: 0,0:47:35.39,0:47:38.23, Lalai,TOLYANYCH,0,0,0,,Sungguh menyegarkan.
Dialog: 0,0:47:40.93,0:47:42.33, Lalai,TOLYANYCH,0,0,0,,Anda perlu menambah lebih banyak air.
Dialog: 0,0:47:45.37,0:47:47.10,Lalai,TOLYANYCH,0,0,0,,Sekarang kami akan menambah air lagi.
Dialog: 0,0:47:47.87,0:47:50.67,Lalai,TOLYANYCH,0,0,0,,Tuang sedikit air, tuangkan sedikit air.
Dialog: 0,0:47:51.12,0:47:52.44, Lalai,TOLYANYCH,0,0,0,,Tepat sekali, air.
Dialog: 0,0:47:52.84,0:47:54.48,Lalai,TOLYANYCH,0,0,0,,Air adalah masalahnya.
Dialog: 0,0:47:56.41,0:47:59.35,Lalai,TOLYANYCH,0,0,0,,Adakah saya akan dapat kembali jika saya terjatuh ke dalam air?
Dialog: 0,0:47:59.66,0:48:01.92,Lalai,TOLYANYCH,0,0,0,,Begitulah sebenarnya saya sampai ke sini melalui kolam.
Dialog: 0,0:48:02.89,0:48:04.39,Lalai,TOLYANYCH,0,0,0,,Adakah terdapat tasik lain di sini?
Dialog: 0,0:48:04.39,0:48:07.19,Lalai,TOLYANYCH,0,0,0,,Terdapat dua lagi di wilayah istana.
Dialog: 0,0:48:08.09,0:48:10.23, Lalai,TOLYANYCH,0,0,0,,-Betulkah? \N-Ya.
Dialog: 0,0:48:10.57,0:48:13.03,Lalai,TOLYANYCH,0,0,0,,Tetapi ia tidak berbeza dengan apa yang anda lihat sebelum ini.
Dialog: 0,0:48:13.64,0:48:14.97,Lalai,TOLYANYCH,0,0,0,,Bagaimana ini?
Dialog: 0,0:48:15.70,0:48:18.27,Lalai,TOLYANYCH,0,0,0,,Menurut titah Ratu Janda
Dialog: 0,0:48:18.37,0:48:21.40,Lalai,TOLYANYCH,0,0,0,,semua tasik di istana telah dikeringkan.
Dialog: 0,0:48:21.78,0:48:23.74,Lalai,TOLYANYCH,0,0,0,,Setiap satu?
Dialog: 0,0:48:24.05,0:48:25.41,Lalai,TOLYANYCH,0,0,0,,Ya, Yang Amat Mulia.
Dialog: 0,0:48:25.95,0:48:27.14,Lalai,TOLYANYCH,0,0,0,,Dan adakah ini akan bertahan lama?
Dialog: 0,0:48:27.45,0:48:29.88,Lalai,TOLYANYCH,0,0,0,,Selama-lamanya, Yang Amat Mulia.
Dialog: 0,0:48:31.12,0:48:33.05, Lalai,TOLYANYCH,0,0,0,,Apa yang berlaku ini?
Dialog: 0,0:48:33.95,0:48:37.12,Lalai,TOLYANYCH,0,0,0,,Adakah saya terperangkap di sini selama-lamanya?
Dialog: 0,0:48:38.66,0:48:39.82, Lalai,TOLYANYCH,0,0,0,, Selamanya?!
Dialog: 0,0:48:43.59,0:48:44.76,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:48:50.07,0:48:53.14, Lalai,TOLYANYCH,0,0,0,,Air! Kita perlu menguji semua perairan di istana.
Dialog: 0,0:48:53.78,0:48:56.81,Lalai,TOLYANYCH,0,0,0,,Saya perlu kembali!
Dialog: 0,0:48:58.84,0:48:59.89,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:48:59.89,0:49:01.04,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:49:02.18,0:49:03.86,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:49:03.86,0:49:06.42,Lalai,TOLYANYCH,0,0,0,,-Yang Mulia!\N-Ini air buangan, Yang Amat Mulia!
Dialog: 0,0:49:06.53,0:49:08.82,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:49:09.70,0:49:11.82, Lalai,TOLYANYCH,0,0,0,,Jangan lakukan ini!
Dialog: 0,0:49:16.74,0:49:17.89,Lalai,TOLYANYCH,0,0,0,,Yang Mulia!
Dialog: 0,0:49:19.53,0:49:21.10,Lalai,TOLYANYCH,0,0,0,,Punggung saya dicubit.
Dialog: 0,0:49:21.26,0:49:24.17,Lalai,TOLYANYCH,0,0,0,,-Bengkok dan seret! \N-Baiklah.
Dialog: 0,0:49:25.14,0:49:28.24,Lalai,TOLYANYCH,0,0,0,,-Yang Mulia! Mengapa anda melekatkan kepala kecil anda di sana!\N-Yang Mulia!
Dialog: 0,0:49:28.24,0:49:30.47,Lalai,TOLYANYCH,0,0,0,,Anda mahu tinggalkan kami dengan siapa?!
Dialog: 0,0:49:34.05,0:49:36.38,Lalai,TOLYANYCH,0,0,0,,Jadi saya tahu. Anda perlu melompat ke dalam kolam.
Dialog: 0,0:49:44.80,0:49:47.09,Lalai,TOLYANYCH,0,0,0,,Alangkah terkejutnya anda,
Dialog: 0,0:49:47.37,0:49:49.69,Lalai,TOLYANYCH,0,0,0,,bahawa anda melakukan perkara sedemikian apabila anda melihat air.
Dialog: 0,0:50:01.47,0:50:03.81, Lalai, TOLYANYCH,0,0,0,,Dan anda seorang yang comel. Siapa nama awak di sana?
Dialog: 0,0:50:06.09,0:50:08.51, Lalai,TOLYANYCH,0,0,0,,Honyong. Nama saya Hongyong.
Dialog: 0,0:50:09.45,0:50:12.85,Lalai,TOLYANYCH,0,0,0,,Alangkah teruknya kamu apabila kamu melupakan orang yang menjaga kamu
Dialog: 0,0:50:13.05,0:50:16.15,Lalai,TOLYANYCH,0,0,0,,sejak lahir anda.
Dialog: 0,0:50:22.37,0:50:24.73,Lalai,TOLYANYCH,0,0,0,,Nah, kenapa awak menangis? Ia menyakitkan untuk menonton.
Dialog: 0,0:50:26.41,0:50:28.67,Lalai,TOLYANYCH,0,0,0,,Yang Mulia, saya bawa ubat.
Dialog: 0,0:50:35.22,0:50:37.07,Lalai,TOLYANYCH,0,0,0,,Tidakkah kamu malu untuk menitiskan air mata di hadapan Yang Amat Mulia?
Dialog: 0,0:50:37.22,0:50:39.14,Lalai,TOLYANYCH,0,0,0,,Jika sukar untuk sesiapa di sini, itu dia.
Dialog: 0,0:50:39.39,0:50:40.58,Lalai,TOLYANYCH,0,0,0,,Maafkan saya.
Dialog: 0,0:50:40.78,0:50:43.95, Lalai, TOLYANYCH,0,0,0,,Dan itu benar. Susah bagi saya, susah.
Dialog: 0,0:50:44.66,0:50:46.28,Lalai,TOLYANYCH,0,0,0,,Kamu berdua tidak akan faham
Dialog: 0,0:50:46.93,0:50:48.75,Lalai,TOLYANYCH,0,0,0,,kepahitan daripada kehilangan perkara yang paling penting.
Dialog: 0,0:50:54.80,0:50:56.13, Lalai,TOLYANYCH,0,0,0,,Kemas barang anda dan pulang ke rumah.
Dialog: 0,0:51:01.84,0:51:04.13, Lalai, TOLYANYCH,0,0,0,, Memandangkan saya tidak akan dapat kembali tidak lama lagi,
Dialog: 0,0:51:04.47,0:51:07.24,Lalai,TOLYANYCH,0,0,0,,perlu melaraskan. \NKita perlu mengetahui apa dan bagaimana.
Dialog: 0,0:51:09.74,0:51:10.97,Lalai,TOLYANYCH,0,0,0,,Saya ada soalan.
Dialog: 0,0:51:11.18,0:51:13.74,Lalai,TOLYANYCH,0,0,0,,Apakah nama kambing itu?
Dialog: 0,0:51:14.59,0:51:16.01,Lalai,TOLYANYCH,0,0,0,,Siapakah nama raja kamu?
Dialog: 0,0:51:17.59,0:51:20.45,Lalai,TOLYANYCH,0,0,0,,Nama raja adalah suci, bagaimana saya boleh memberitahunya.
Dialog: 0,0:51:20.68,0:51:21.85, Lalai, TOLYANYCH,0,0,0,, Sial, betul-betul.
Dialog: 0,0:51:21.95,0:51:24.25,Lalai,TOLYANYCH,0,0,0,,Anda tidak boleh memanggilnya dengan nama, atau hanya memanggilnya dengan namanya.
Dialog: 0,0:51:24.82,0:51:27.82,Lalai,TOLYANYCH,0,0,0,,Kami berada di negeri Joseon? Tahun berapa sekarang?
Dialog: 0,0:51:27.82,0:51:29.26, Lalai,TOLYANYCH,0,0,0,,1851.
Dialog: 0,0:51:29.49,0:51:33.03, Lalai,TOLYANYCH,0,0,0,,Tahun kedua pemerintahan Putera Togwan.
Dialog: 0,0:51:33.41,0:51:36.11, Lalai,TOLYANYCH,0,0,0,,Putera Togwan?
Dialog: 0,0:51:36.11,0:51:37.90,Lalai,TOLYANYCH,0,0,0,,Saya mendengar nama ini di suatu tempat.
Dialog: 0,0:51:38.47,0:51:39.84, Lalai,TOLYANYCH,0,0,0,,Bolehkah saya memberi anda petunjuk lain?
Dialog: 0,0:51:41.14,0:51:43.37, Lalai,TOLYANYCH,0,0,0,,Petunjuk?
Dialog: 0,0:51:44.64,0:51:47.91,Lalai,TOLYANYCH,0,0,0,,Baiklah, mari kita lakukan dengan cara ini. Saya akan menyanyikan lagu.
Dialog: 0,0:51:47.91,0:51:49.85,Lalai,TOLYANYCH,0,0,0,,Jika anda mendengar nama anumerta pendahulu raja, berikan tanda.
Dialog: 0,0:51:50.09,0:51:51.25, Lalai,TOLYANYCH,0,0,0,,Dengar dengan teliti.
Dialog: 0,0:51:53.49,0:51:55.86,Lalai,TOLYANYCH,0,0,0,,Tae, John, Tae, Se, Moon, Dan, Se,
Dialog: 0,0:51:55.86,0:51:58.22,Lalai,TOLYANYCH,0,0,0,,Ye, Song, Young, Jun, In, Myung, Song.
Dialog: 0,0:52:01.30,0:52:03.76,Lalai,TOLYANYCH,0,0,0,,Masih tiada? Ini bermakna \N raja ini adalah salah seorang yang terkemudian.
Dialog: 0,0:52:04.37,0:52:06.53,Lalai,TOLYANYCH,0,0,0,,Kwan, In, Hyo, Hyun, Suk, Kyung, Young,
Dialog: 0,0:52:06.53,0:52:08.43, Lalai,TOLYANYCH,0,0,0,,Chon, Sun, Hong, Chol, Ko.
Dialog: 0,0:52:09.14,0:52:10.23, Lalai,TOLYANYCH,0,0,0,,Siapa?
Dialog: 0,0:52:13.74,0:52:16.01,Lalai,TOLYANYCH,0,0,0,,Ko, Chol, Hong, Sun...
Dialog: 0,0:52:18.12,0:52:20.74, Lalai,TOLYANYCH,0,0,0,,Sun, Hon.
Dialog: 0,0:52:22.95,0:52:24.65,Lalai,TOLYANYCH,0,0,0,,Dari manakah lalat itu berasal?
Dialog: 0,0:52:27.03,0:52:28.85,Lalai,TOLYANYCH,0,0,0,,Jika dia datang selepas Raja Hongjong, maka dia...
Dialog: 0,0:52:32.20,0:52:33.56, Lalai,TOLYANYCH,0,0,0,,Choljong?
Dialog: 0,0:52:36.16,0:52:38.63, Lalai,TOLYANYCH,0,0,0,,Choljong. Dilahirkan sebagai Lee Wonbum.
Dialog: 0,0:52:38.64,0:52:40.87,Lalai,TOLYANYCH,0,0,0,,Menjadi raja, menukar namanya kepada Lee Byung.
Dialog: 0,0:52:40.87,0:52:42.57,Lalai,TOLYANYCH,0,0,0,,Saudara maranya dituduh khianat
Dialog: 0,0:52:42.57,0:52:44.03, Lalai, TOLYANYCH,0,0,0,, dan dibuang ke Pulau Ganghwado.
Dialog: 0,0:52:44.03,0:52:48.10,Lalai,TOLYANYCH,0,0,0,,Joseon Cinderella, orang yang, kerana kebodohan\N, dijadikan raja dalam sekelip mata.
Dialog: 0,0:52:48.28,0:52:51.18,Lalai,TOLYANYCH,0,0,0,,Raja boneka paling bodoh dan tidak berguna\N dalam sejarah.
Dialog: 0,0:52:51.18,0:52:53.04,Lalai,TOLYANYCH,0,0,0,,Dibenci rakyat.
Dialog: 0,0:52:53.22,0:52:55.41,Lalai,TOLYANYCH,0,0,0,,Dia jatuh sakit dan meninggal dunia pada tahun ke-13 pemerintahannya.
Dialog: 0,0:52:56.62,0:53:00.05,Lalai,TOLYANYCH,0,0,0,,Guru dan ibu bapa betul, pengajaran masih ringan!
Dialog: 0,0:53:00.05,0:53:01.28,Lalai,TOLYANYCH,0,0,0,,Maman, dari lubuk hati saya!
Dialog: 0,0:53:03.89,0:53:05.72,Lalai,TOLYANYCH,0,0,0,,Apabila orang dipukul terlalu cepat, mereka menjadi anjing greyhound.
Dialog: 0,0:53:05.93,0:53:08.76,Lalai,TOLYANYCH,0,0,0,,Yang ini adalah salah satu daripadanya, tetapi setakat ini ia berkelakuan sopan.
Dialog: 0,0:53:11.07,0:53:14.76,Lalai,TOLYANYCH,0,0,0,,Saya tidak tahu tentang keadaan anda, dan oleh itu kelakuan saya tidak sesuai.
Dialog: 0,0:53:16.03,0:53:17.37,Lalai,TOLYANYCH,0,0,0,,Biar saya rasa dahi awak.
Dialog: 0,0:53:19.20,0:53:20.40,Lalai,TOLYANYCH,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,0:53:23.37,0:53:25.14,Lalai,TOLYANYCH,0,0,0,,Kenapa perlu malu?
Dialog: 0,0:53:25.24,0:53:28.14,Lalai,TOLYANYCH,0,0,0,,Esok awak akan menjadi isteri saya.
Dialog: 0,0:53:30.22,0:53:31.38, Lalai,TOLYANYCH,0,0,0,,Esok?
Dialog: 0,0:53:32.99,0:53:35.62,Lalai,TOLYANYCH,0,0,0,,Saya minta menteri-menteri menyegerakan.
Dialog: 0,0:53:35.62,0:53:37.72,Lalai,TOLYANYCH,0,0,0,,Dan masih mengadakan majlis itu.
Dialog: 0,0:53:38.72,0:53:41.79,Lalai,TOLYANYCH,0,0,0,,Esok perkahwinan kami.
Dialog: 0,0:53:42.43,0:53:45.73,Lalai,TOLYANYCH,0,0,0,,Nah, kami sudah tiba, saya terlupa tentang perkara yang paling penting.
Dialog: 0,0:53:45.97,0:53:47.03,Lalai,TOLYANYCH,0,0,0,,Choljon meletakkannya pada semua
Dialog: 0,0:53:47.03,0:53:48.77,Lalai,TOLYANYCH,0,0,0,,kerana minuman keras dan perempuan.
Dialog: 0,0:53:48.97,0:53:50.83, Lalai,TOLYANYCH,0,0,0,,Lelaki Joseon utama.
Dialog: 0,0:53:55.18,0:53:56.27,Lalai,TOLYANYCH,0,0,0,,Tunggu.
Dialog: 0,0:53:58.02,0:54:00.29,Lalai,TOLYANYCH,0,0,0,,Mula-mula saya perlu memberitahu anda sesuatu.
Dialog: 0,0:54:09.57,0:54:13.31,Lalai,TOLYANYCH,0,0,0,,Saya melakukan seperti yang anda minta dan menghantar semua orang pergi.
Dialog: 0,0:54:13.38,0:54:14.81,Lalai,TOLYANYCH,0,0,0,,Puas hati?
Dialog: 0,0:54:17.18,0:54:19.78,Lalai,TOLYANYCH,0,0,0,,Secara umum, ini amat sukar untuk dipercayai.
Dialog: 0,0:54:20.05,0:54:22.35,Lalai,TOLYANYCH,0,0,0,,Saya pun tidak tahu bagaimana hendak menerangkan.
Dialog: 0,0:54:22.72,0:54:24.15,Lalai,TOLYANYCH,0,0,0,,Mengapa semuanya begitu rumit.
Dialog: 0,0:54:24.72,0:54:27.62,Lalai,TOLYANYCH,0,0,0,,-Anda mempunyai sesuatu di rambut anda.\N-Apa? apa yang ada?
Dialog: 0,0:54:31.16,0:54:32.53, Lalai,TOLYANYCH,0,0,0,,Petal.
Dialog: 0,0:54:35.73,0:54:37.60,Lalai,TOLYANYCH,0,0,0,,Secara umum, anda akan terkejut,
Dialog: 0,0:54:37.67,0:54:39.40,Lalai,TOLYANYCH,0,0,0,,tetapi cuba terimanya juga.
Dialog: 0,0:54:43.27,0:54:45.24,Lalai,TOLYANYCH,0,0,0,,-Sebenarnya saya...\N-Betul ke awak?
Dialog: 0,0:54:48.58,0:54:49.75, Lalai,TOLYANYCH,0,0,0,,Man.
Dialog: 0,0:54:57.45,0:54:59.02,Lalai,TOLYANYCH,0,0,0,,Lelaki yang sihat,
Dialog: 0,0:54:59.02,0:55:00.96,Lalai,TOLYANYCH,0,0,0,,berasal dari masa depan Joseon, iaitu 200 tahun kemudian.
Dialog: 0,0:55:01.26,0:55:03.13, Lalai, TOLYANYCH,0,0,0,,Saya tidak tahu bagaimana ini berlaku.
Dialog: 0,0:55:03.13,0:55:04.99,Lalai,TOLYANYCH,0,0,0,,Saya fikir saya lemas.
Dialog: 0,0:55:04.99,0:55:06.23,Lalai,TOLYANYCH,0,0,0,,Saya sudah sedar dan saya seorang perempuan.
Dialog: 0,0:55:06.46,0:55:09.77,Lalai,TOLYANYCH,0,0,0,,Secara umum, saya bukan seperti yang anda fikirkan.
Dialog: 0,0:55:09.77,0:55:11.43,Lalai,TOLYANYCH,0,0,0,,Penampilan boleh menipu, anda tahu.
Dialog: 0,0:55:14.84,0:55:16.41,Lalai,TOLYANYCH,0,0,0,,Saya yakin anda fikir apa yang saya maksudkan, bukan?
Dialog: 0,0:55:16.51,0:55:19.11,Lalai,TOLYANYCH,0,0,0,,Dalam apa jua keadaan, anda harus mempertimbangkan semula segala-galanya dengan serius!
Dialog: 0,0:55:19.11,0:55:21.81,Lalai,TOLYANYCH,0,0,0,,Katakanlah majlis itu diadakan,\Nmasa untuk malam perkahwinan akan tiba dan...
Dialog: 0,0:55:22.25,0:55:23.98, Lalai,TOLYANYCH,0,0,0,,Semua ini salah.
Dialog: 0,0:55:24.15,0:55:27.05,Lalai,TOLYANYCH,0,0,0,,Dan saya tidak suka lelaki.
Dialog: 0,0:55:28.32,0:55:30.65, Lalai,TOLYANYCH,0,0,0,,Dan anda tidak akan dicemburui sama sekali.
Dialog: 0,0:55:30.65,0:55:32.29,Lalai,TOLYANYCH,0,0,0,,Saya hanya mengalami gangguan personaliti.
Dialog: 0,0:55:32.29,0:55:35.63, Lalai,TOLYANYCH,0,0,0,,Dan anda mempunyai perkahwinan sejenis! perempuan haram!
Dialog: 0,0:55:39.30,0:55:42.47,Lalai,TOLYANYCH,0,0,0,,Saya faham apa yang anda cuba katakan.
Dialog: 0,0:55:44.50,0:55:46.77, Lalai,TOLYANYCH,0,0,0,,Serius, atau apa? wah,
Dialog: 0,0:55:46.94,0:55:49.77,Lalai,TOLYANYCH,0,0,0,,anda lelaki biasa, nampaknya buku teks berbohong.
Dialog: 0,0:55:50.44,0:55:51.61, Lalai,TOLYANYCH,0,0,0,,Dengar sini!
Dialog: 0,0:55:53.01,0:55:54.38,Lalai,TOLYANYCH,0,0,0,,Ya, Tuanku.
Dialog: 0,0:55:54.38,0:55:56.28,Lalai,TOLYANYCH,0,0,0,,Beritahu doktor mahkamah,
Dialog: 0,0:55:56.28,0:55:58.88, Lalai, TOLYANYCH,0,0,0,,untuk mengetahui masalah dengan tunang saya dan maklumkan kepada saya.
Dialog: 0,0:55:59.72,0:56:00.82,Lalai,TOLYANYCH,0,0,0,,Apa?
Dialog: 0,0:56:01.15,0:56:02.29, Lalai,TOLYANYCH,0,0,0,,Okey.
Dialog: 0,0:56:04.99,0:56:06.22,Lalai,TOLYANYCH,0,0,0,,Jangan risau.
Dialog: 0,0:56:06.22,0:56:09.73,Lalai,TOLYANYCH,0,0,0,,Saya pasti akan menyembuhkan anda.
Dialog: 0,0:56:10.23,0:56:13.33,Lalai,TOLYANYCH,0,0,0,,Ingat bahawa anda tidak bersendirian.
Dialog: 0,0:56:13.80,0:56:17.20,Lalai,TOLYANYCH,0,0,0,,Saya bakal suami awak dan saya tidak akan meninggalkan awak, walau seteruk mana pun awak
Dialog: 0,0:56:18.87,0:56:21.27, Lalai, TOLYANYCH,0,0,0,, dan tidak kira betapa rosaknya fikiran anda.
Dialog: 0,0:56:25.74,0:56:28.81, Lalai,TOLYANYCH,0,0,0,,Oh, maaf. Awak belum sihat.
Dialog: 0,0:56:28.88,0:56:29.98,Lalai,TOLYANYCH,0,0,0,,Dengar di sini.
Dialog: 0,0:56:30.61,0:56:33.08,Lalai,TOLYANYCH,0,0,0,,Bawa pengantin perempuan saya kembali ke biliknya dengan segera.
Dialog: 0,0:56:33.08,0:56:34.62,Lalai,TOLYANYCH,0,0,0,,Ya, Tuanku.
Dialog: 0,0:56:34.68,0:56:36.12, Lalai,FE,0,0,0,,Jangan risau.
Dialog: 0,0:56:36.12,0:56:39.06,Lalai,FE,0,0,0,,Tidur dan berehat.\NAnda akan berasa lebih baik.
Dialog: 0,0:56:40.89,0:56:43.33, Lalai,FE,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:56:43.89,0:56:45.23,Lalai,FE,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:56:46.20,0:56:47.76,Lalai,FE,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:56:48.73,0:56:50.60, Lalai,FE,0,0,0,,Buku itu tidak berbohong.
Dialog: 0,0:56:50.93,0:56:53.64,Lalai,FE,0,0,0,,Nampaknya, dia lebih bodoh daripada yang mereka tulis dalam buku teks.
Dialog: 0,0:56:53.64,0:56:55.04,Lalai,FE,0,0,0,,Dapatkan kekuatan.
Dialog: 0,0:56:56.34,0:56:58.71,Lalai,FE,0,0,0,,Okey, okey.
Dialog: 0,0:57:00.21,0:57:03.61,Lalai,FE,0,0,0,,Yang Mulia, anda tidak boleh berjalan dengan skirt anda dinaikkan.
Dialog: 0,0:57:04.18,0:57:06.68,Lalai,FE,0,0,0,,Tidak boleh menunjukkan seluar dalam semasa melangkah.
Dialog: 0,0:57:07.05,0:57:10.45,Lalai,FE,0,0,0,,Yang Mulia, pergi lebih perlahan. Jangan lari macam tu.
Dialog: 0,0:57:12.32,0:57:14.89,Lalai,FE,0,0,0,,Apa yang dia buat?
Dialog: 0,0:57:17.36,0:57:19.30,Lalai,FE,0,0,0,,Jika saya tidak mahu, saya tidak akan.
Dialog: 0,0:57:19.30,0:57:21.80,Lalai,FE,0,0,0,,Perubatan Barat lebih berkesan untuk saya.
Dialog: 0,0:57:22.87,0:57:25.80,Lalai,FE,0,0,0,,Buka mulut anda.
Dialog: 0,0:57:26.87,0:57:27.97,Lalai,FU,0,0,0,,No.
Dialog: 0,0:57:28.27,0:57:29.67,Lalai,FU,0,0,0,,
Dialog: 0,0:57:30.61,0:57:31.71,Lalai,FE,0,0,0,,Tuhan.
Dialog: 0,0:57:37.65,0:57:39.48,Lalai,FE,0,0,0,,Saya beritahu awak...
Dialog: 0,0:57:56.20,0:57:58.87,Lalai,FE,0,0,0,,Tenaga air memenuhi kepala Yang Teramat Mulia.
Dialog: 0,0:57:58.87,0:58:02.04,Lalai,FE,0,0,0,,Anda perlu menggantikannya dengan tenaga api menggunakan kayu cendana.
Dialog: 0,0:58:02.91,0:58:05.41,Lalai,FE,0,0,0,,Yang Mulia, anda mesti ingat segala-galanya.
Dialog: 0,0:58:05.54,0:58:08.48,Lalai,FE,0,0,0,,Oh, penipu! Adakah anda mempunyai lesen doktor?!
Dialog: 0,0:58:08.48,0:58:11.81, Lalai,FE,0,0,0,,Mengapa awak membuat ayam tembakau daripada saya?
Dialog: 0,0:58:20.39,0:58:22.99,Lalai,FE,0,0,0,,Saya akan membuka kepada anda chakra ketiga belas, iaitu jawapannya
Dialog: 0,0:58:22.99,0:58:24.09,Lalai,FE,0,0,0,,untuk penyakit minda.
Dialog: 0,0:58:24.19,0:58:26.63, Lalai,FE,0,0,0,,Tidak kisah, lakukan apa yang anda mahu.
Dialog: 0,0:58:26.63,0:58:28.30,Lalai,FE,0,0,0,,Badan itu bukan milik saya.
Dialog: 0,0:58:42.55,0:58:43.81,Lalai,FE,0,0,0,,Saya ingat!
Dialog: 0,0:58:46.02,0:58:47.90,Lalai,FE,0,0,0,,Memori dikembalikan seolah-olah dengan sihir.
Dialog: 0,0:58:48.68,0:58:49.72,Lalai,FE,0,0,0,,Anda Hongyeon.
Dialog: 0,0:58:49.72,0:58:52.72,Lalai,FE,0,0,0,,Pembantu rumah saya yang dikasihi,\Ndengan siapa saya dibesarkan di rumah ayah saya.
Dialog: 0,0:58:57.53,0:59:01.20,Lalai,FE,0,0,0,,Siapakah nama wanita mahkamah ini?
Dialog: 0,0:59:01.56,0:59:02.80,Lalai,FE,0,0,0,,Anda...
Dialog: 0,0:59:04.90,0:59:06.10,Lalai,FE,0,0,0,,Apa...
Dialog: 0,0:59:08.14,0:59:10.27,Lalai,FE,0,0,0,,Choi! Wanita mahkamah Choi.
Dialog: 0,0:59:12.98,0:59:16.65,Lalai,FE,0,0,0,,Siapa nama saya?
Dialog: 0,0:59:22.62,0:59:24.45,Lalai,FE,0,0,0,,Bagaimanakah saya tahu apa yang perlu saya hubungi doktor di mahkamah?
Dialog: 0,0:59:24.45,0:59:25.82,Lalai,FE,0,0,0,,Kenapa awak duduk?
Dialog: 0,0:59:25.82,0:59:27.12,Lalai,FE,0,0,0,,Pegang Yang Mulia.
Dialog: 0,0:59:27.12,0:59:29.09,Lalai,FE,0,0,0,,Jika dia bergerak,\Nit hanya akan menjadi lebih teruk.
Dialog: 0,0:59:29.53,0:59:33.00,Lalai,FE,0,0,0,,Bagaimana anda boleh menggunakan\Nalat tukang daging ini pada saya?
Dialog: 0,0:59:33.00,0:59:34.26, Lalai,FE,0,0,0,, Jatuh dari pokok oak?
Dialog: 0,0:59:34.26,0:59:36.57,Lalai,FE,0,0,0,,Saya mahir dalam akupunktur.
Dialog: 0,0:59:36.63,0:59:37.90,Lalai,FE,0,0,0,,Ini adalah cara terbaik untuk
Dialog: 0,0:59:37.90,0:59:39.24,Lalai,FE,0,0,0,,aliran darah yang jelas.
Dialog: 0,0:59:39.24,0:59:41.67,Lalai,FE,0,0,0,,-Saya akan melekatkannya tepat di bawah bahagian belakang kepala...\N-Berhenti! Hentikan!
Dialog: 0,0:59:42.04,0:59:43.27,Lalai,FE,0,0,0,,Hentikan, sila.
Dialog: 0,0:59:43.77,0:59:45.27,Lalai,FE,0,0,0,,Jika saya sedar,
Dialog: 0,0:59:46.71,0:59:48.48,Lalai,FE,0,0,0,,maka esok saya akan menjadi seorang ratu.
Dialog: 0,0:59:51.11,0:59:52.92,Lalai,FE,0,0,0,,Apakah pada pendapat anda bayaran balik
Dialog: 0,0:59:53.45,0:59:55.02,Lalai,FE,0,0,0,,untuk serangan sengit anda?
Dialog: 0,0:59:59.02,1:00:01.69,Lalai,FE,0,0,0,,Berlebihan adalah lebih teruk daripada terkurang.
Dialog: 0,1:00:01.69,1:00:04.86,Lalai,FE,0,0,0,,Dengan ini saya akan melengkapkan rawatan inventif saya.
Dialog: 0,1:00:07.83,1:00:10.77,Lalai,FE,0,0,0,,Betul, anda seorang penyembuh yang sangat baik.\NI telah pulih sepenuhnya.
Dialog: 0,1:00:11.00,1:00:12.80,Lalai,FE,0,0,0,,Saya tidak apa-apa. mengikut tertib.
Dialog: 0,1:00:15.44,1:00:18.37,Lalai,FE,0,0,0,,Okey. Saya akan menjadi seorang ratu,\Nmemandangkan awak sangat menginginkannya.
Dialog: 0,1:00:18.77,1:00:20.78,Lalai,FE,0,0,0,,Ratu seluruh negara.
Dialog: 0,1:00:20.81,1:00:23.31,Lalai,FE,0,0,0,,Mengisi tasik atau kolam akan menjadi sekeping kek?
Dialog: 0,1:00:45.80,1:00:48.64,Lalai,FE,0,0,0,,Yang Mulia, adakah anda sudah bangun?
Dialog: 0,1:01:22.71,1:01:23.87,Lalai,FU,0,0,0,,Enter.
Dialog: 0,1:01:40.26,1:01:41.72,Lalai,FE,0,0,0,,Adakah saya perlu memakai semua ini?
Dialog: 0,1:01:43.23,1:01:45.66,Lalai,FE,0,0,0,,Jubah rasmi Ratu
Dialog: 0,1:01:45.66,1:01:47.26,Lalai,FE,0,0,0,,Seluar dalam, long johns,
Dialog: 0,1:01:47.26,1:01:49.17,Lalai,FE,0,0,0,,seluar longgar, baju dalam,
Dialog: 0,1:01:49.17,1:01:51.03,Lalai,FE,0,0,0,,seluar dalam, baju dalam,
Dialog: 0,1:01:51.03,1:01:53.00,Lalai,FE,0,0,0,,skirt pertama, skirt kedua,
Dialog: 0,1:01:53.00,1:01:55.14,Lalai,FE,0,0,0,,skirt ketiga, jaket dengan paip berwarna
Dialog: 0,1:01:55.14,1:01:57.64,Lalai,FE,0,0,0,,dan jaket atas.
Dialog: 0,1:01:58.51,1:02:01.04,Lalai,FE,0,0,0,,Pakaian di bahagian atas adalah potongan sempit dan dekat dengan badan,
Dialog: 0,1:02:01.04,1:02:03.11,Lalai,FU,0,0,0,,bawah, sebaliknya, lebar.
Dialog: 0,1:02:03.11,1:02:05.95,Lalai,FE,0,0,0,,Ini mewujudkan ilusi bentuk badan melengkung ideal seorang wanita.
Dialog: 0,1:02:05.95,1:02:08.75,Lalai,FU,0,0,0,,Kecil ke atas, besar ke bawah
Dialog: 0,1:02:11.59,1:02:13.06,Lalai,FE,0,0,0,,Tidak boleh bernafas.
Dialog: 0,1:02:43.05,1:02:44.85,Lalai,FE,0,0,0,,Manik jed menutup mata,
Dialog: 0,1:02:45.09,1:02:48.09,Lalai,FE,0,0,0,,dan telinga nilam.
Dialog: 0,1:02:48.19,1:02:50.33,Lalai,FE,0,0,0,,Petanda bahawa raja harus
Dialog: 0,1:02:50.33,1:02:52.59,Lalai,FE,0,0,0,,tutup mata dan telinga anda dan dengar halaman rumah anda.
Dialog: 0,1:02:58.00,1:02:59.37,Lalai,FE,0,0,0,,Luruskan leher anda.
Dialog: 0,1:02:59.60,1:03:00.90,Lalai,FE,0,0,0,,Memang berat.
Dialog: 0,1:03:00.90,1:03:03.54,Lalai,FE,0,0,0,,Anda mesti menanggung beban yang berat ini.
Dialog: 0,1:03:54.49,1:03:57.39,Lalai,FE,0,0,0,,Saya adalah wanita Joseon pertama tanpa coli.
Dialog: 0,1:04:01.16,1:04:03.67,Lalai,FE,0,0,0,,Saling tunduk.
Dialog: 0,1:04:08.40,1:04:10.61,Lalai,FE,0,0,0,,-Yang Mulia.\N-Apa yang anda mahu?
Dialog: 0,1:04:47.81,1:04:50.11,Lalai,FE,0,0,0,,Kami tidak memperingati nenek moyang kami di sini.
Dialog: 0,1:04:50.11,1:04:52.55,Lalai,FE,0,0,0,,Perkahwinan - pengebumian yang sama.
Dialog: 0,1:04:57.12,1:04:58.65,Lalai,FE,0,0,0,,Berapa kali anda perlu tunduk?
Dialog: 0,1:04:58.65,1:05:00.12,Lalai,FU,0,0,0,,2 lagi.
Dialog: 0,1:05:10.10,1:05:12.97,Lalai,FE,0,0,0,,Betapa cantiknya pasangan mereka.
Dialog: 0,1:05:14.00,1:05:17.57,Lalai,FE,0,0,0,,Semua dengan usaha dan doa Tuanku.
Dialog: 0,1:05:17.57,1:05:20.14,Lalai,FE,0,0,0,,Saya gembira kerana anda perasan perkara ini, Yang Mulia.
Dialog: 0,1:05:25.15,1:05:27.92,Lalai,PU,0,0,0,,Naikkan mangkuk.
Dialog: 0,1:05:59.68,1:06:01.68,Lalai,FE,0,0,0,,Abang saya,
Dialog: 0,1:06:02.15,1:06:04.12,Lalai,FE,0,0,0,,kenapa awak menangis?
Dialog: 0,1:06:07.32,1:06:10.19,Lalai,FE,0,0,0,,Saya gembira anak perempuan saya menjadi ratu negara ini,
Dialog: 0,1:06:11.43,1:06:12.69,Lalai,FU,0,0,0,,tetapi masih -
Dialog: 0,1:06:13.16,1:06:16.30,Lalai,FE,0,0,0,,Saya rasa seperti kehilangan anak tunggal saya.
Dialog: 0,1:06:17.43,1:06:18.93,Lalai,FE,0,0,0,,Okey.
Dialog: 0,1:06:19.64,1:06:22.40,Lalai,FE,0,0,0,,Sekarang anda adalah bapa permaisuri.
Dialog: 0,1:06:22.94,1:06:25.57,Lalai,FE,0,0,0,,Yang Mulia Yonggeun.
Dialog: 0,1:06:25.67,1:06:26.88,Lalai,FE,0,0,0,,Betulkah?
Dialog: 0,1:06:27.84,1:06:29.14,Lalai,FU,0,0,0,,Betul.
Dialog: 0,1:06:35.68,1:06:38.79,Lalai,FE,0,0,0,,Soyeon daripada keluarga Andong Kim
Dialog: 0,1:06:38.95,1:06:41.86,Lalai,FE,0,0,0,,menjadi ratu Joseon.
Dialog: 0,1:06:42.36,1:06:44.53,Lalai,FE,0,0,0,,Ini adalah kali pertama saya mendengar nama wanita ini.
Dialog: 0,1:06:44.53,1:06:46.60,Lalai,FE,0,0,0,,Awak mesti sayang saya.
Dialog: 0,1:07:05.31,1:07:07.82,Lalai,FE,0,0,0,,Saya tidak boleh, saya tidak boleh bernafas.
Dialog: 0,1:07:08.45,1:07:09.79,Lalai,FE,0,0,0,,Serangan jantung?
Dialog: 0,1:07:33.18,1:07:35.14,Lalai,FE,0,0,0,,Tunjukkan rasa hormat!
Dialog: 0,1:07:35.51,1:07:40.18,Lalai,FE,0,0,0,,Panjang umur bagi raja dan permaisuri!
Dialog: 0,1:07:44.85,1:07:49.36,Lalai,FE,0,0,0,,Tiada musuh atau sekutu di istana.
Dialog: 0,1:07:49.53,1:07:53.60,Lalai,FE,0,0,0,,Jangan hilangkan imbangan anda dan jangan biarkan hati anda mengeruhkan fikiran anda.
Dialog: 0,1:07:53.86,1:07:55.66,Lalai,FE,0,0,0,,Jangan risau.
Dialog: 0,1:07:55.66,1:07:57.10,Lalai,FE,0,0,0,,Saya menuju ke istana,
Dialog: 0,1:07:57.10,1:07:59.64,Lalai,FE,0,0,0,,kerana saya ingin berguna kepada Baginda.
Dialog: 0,1:07:59.70,1:08:01.00,Lalai,FE,0,0,0,,Tuhan.
Dialog: 0,1:08:05.24,1:08:08.44,Lalai,FE,0,0,0,,Jururawat, saya tidak akan mati.
Dialog: 0,1:08:08.44,1:08:10.11,Lalai,FE,0,0,0,,Jangan menangis untuk saya.
Dialog: 0,1:08:11.61,1:08:13.95,Lalai,FE,0,0,0,,Puan muda, awak terlalu baik.
Dialog: 0,1:08:14.35,1:08:18.02,Lalai,FE,0,0,0,,Saya tidak tahu sama ada anda boleh bertahan di istana.
Dialog: 0,1:08:18.69,1:08:22.06,Lalai,FE,0,0,0,,Jangan risau. Saya akan melayani wanita saya dengan setia.
Dialog: 0,1:09:31.06,1:09:33.36,Lalai,FE,0,0,0,,Saya menyerah! Saya menyerah!
Dialog: 0,1:09:38.27,1:09:40.50,Lalai,FE,0,0,0,,Saya fikir kita akan membaca puisi di gazebo.
Dialog: 0,1:09:40.57,1:09:43.64,Lalai,FE,0,0,0,,Tidakkah anda boleh memberi amaran\Nbahawa ini adalah latihan dan bukan rehat?
Dialog: 0,1:09:43.81,1:09:45.07,Lalai,FE,0,0,0,,Awak tidak berehat?
Dialog: 0,1:09:45.07,1:09:47.01,Lalai,FE,0,0,0,,Berpeluh di tempat dengan pemandangan ini.
Dialog: 0,1:09:47.01,1:09:48.28,Lalai,FE,0,0,0,,Rehat?
Dialog: 0,1:09:48.28,1:09:50.65,Lalai,FE,0,0,0,,Oleh kerana bapa kepada Menteri Peperangan, ia sudah perlu
Dialog: 0,1:09:50.65,1:09:53.32,Lalai,FE,0,0,0,,latih setiap hari - malah saya tidak suka hal ketenteraan.
Dialog: 0,1:09:53.32,1:09:55.12,Lalai,FE,0,0,0,,Apa yang kita lakukan di sini?
Dialog: 0,1:09:55.22,1:09:57.65,Lalai,FE,0,0,0,,Jika saya tahu, saya tidak akan pergi bersama anda.
Dialog: 0,1:10:00.39,1:10:02.99,Lalai,FE,0,0,0,,Anda mungkin fikir anda sedang bersedia untuk berperang dengan musuh.
Dialog: 0,1:10:03.03,1:10:05.16,Lalai,FE,0,0,0,,Mengapa anda kecewa dengan berita baik itu?
Dialog: 0,1:10:05.16,1:10:06.53,Lalai,FE,0,0,0,,Sepupu awak telah menjadi ratu.
Dialog: 0,1:10:09.63,1:10:12.13,Lalai,FE,0,0,0,,Saya mempunyai hanbok penuh kegembiraan - Saya tidak tahu apa yang perlu dilakukan dengannya.
Dialog: 0,1:10:13.47,1:10:16.51,Lalai,FE,0,0,0,,Jika anda tidak suka berlawan pedang, mungkin kita boleh berlawan tangan?
Dialog: 0,1:10:17.64,1:10:20.11,Lalai,FE,0,0,0,,Saya menukar fikiran. Saya akan pulang.
Dialog: 0,1:10:24.05,1:10:25.61,Lalai,FE,0,0,0,,Anda akan pergi apabila anda mengalahkan saya.
Dialog: 0,1:10:29.92,1:10:32.65,Lalai,FE,0,0,0,,Lebih cepat, lebih pantas. Dia menggali leher saya.
Dialog: 0,1:10:34.36,1:10:36.36,Lalai,FE,0,0,0,,Hampir mati di sana.
Dialog: 0,1:10:36.89,1:10:39.59,Lalai,FE,0,0,0,,Sesi foto dengan stylist adalah \Ngarbage berbanding ini.
Dialog: 0,1:10:53.21,1:10:55.98,Lalai,FE,0,0,0,,Kami mendapat peningkatan nombor.
Dialog: 0,1:10:56.14,1:10:57.68,Lalai,FE,0,0,0,,Ini ialah Dewan Daejojon.
Dialog: 0,1:10:58.65,1:11:01.22,Lalai,FU,0,0,0,,Nama sepadan dengan tempat itu.
Dialog: 0,1:11:01.38,1:11:04.49,Lalai,FU,0,0,0,,Ini bermakna anda perlu membuat sumbangan yang besar.
Dialog: 0,1:11:04.85,1:11:07.19,Lalai,FE,0,0,0,,Adakah anda mahu saya selamatkan negara atau apa?
Dialog: 0,1:11:07.56,1:11:08.76,Lalai,FE,0,0,0,,Anda sepatutnya bersalin
Dialog: 0,1:11:09.62,1:11:11.76,Lalai,FE,0,0,0,,kepada raja pewaris.
Dialog: 0,1:11:17.60,1:11:19.80,Lalai,FU,0,0,0,,Tepat sekali. Ia juga malam perkahwinan.
Dialog: 0,1:11:21.70,1:11:24.94,Lalai,FE,0,0,0,,Kekacauan terbesar dalam semua 33 tahun kehidupan Jang Bong-hwan.
Dialog: 0,1:11:39.89,1:11:42.69,Lalai,FE,0,0,0,,Mesti ada jalan keluar dari sebarang situasi.
Dialog: 0,1:11:45.79,1:11:47.90,Lalai,FU,0,0,0,,Mestilah.
Dialog: 0,1:11:48.20,1:11:50.23,Lalai,FE,0,0,0,,Minuman telah tiba.
Dialog: 0,1:12:02.41,1:12:04.65,Lalai,FE,0,0,0,,Tepat sekali, alkohol.
Dialog: 0,1:12:06.52,1:12:08.88,Lalai,FE,0,0,0,,Dan nenek moyang tahu apa yang mereka lakukan.
Dialog: 0,1:12:35.11,1:12:36.75,Lalai,FE,0,0,0,,Biar saya tuangkan untuk anda.
Dialog: 0,1:12:37.41,1:12:40.98,Lalai,FE,0,0,0,,Apa yang Baginda ingin minum?
Dialog: 0,1:12:41.32,1:12:43.62,Lalai,FE,0,0,0,,Saya lebih suka makanan ringan daripada alkohol itu sendiri.
Dialog: 0,1:12:44.02,1:12:45.22,Lalai,FE,0,0,0,,Apa awak...
Dialog: 0,1:12:45.59,1:12:49.69,Lalai,FE,0,0,0,,Hari ini adalah hari istimewa.\NDJangan makan terlalu banyak dan minum dengan lebih baik.
Dialog: 0,1:12:50.33,1:12:52.79,Lalai,FE,0,0,0,,Pengambilan wain yang berlebihan membahayakan tubuh.
Dialog: 0,1:12:53.30,1:12:54.60,Lalai,FE,0,0,0,,Oh, awak kecil...
Dialog: 0,1:12:55.80,1:12:57.73,Lalai,FE,0,0,0,,Tenang, hanya tenang.
Dialog: 0,1:12:57.97,1:13:01.27,Lalai,FE,0,0,0,,Tiada orang Korea yang tidak akan berbangga dengan jumlah yang boleh dia makan.
Dialog: 0,1:13:01.94,1:13:04.94,Lalai,FE,0,0,0,,Saya faham. Jadi anda tidak tahu bagaimana untuk minum.
Dialog: 0,1:13:04.94,1:13:07.34,Lalai,FE,0,0,0,,Ia serta-merta jelas bahawa anda tidak akan minum saya lagi.
Dialog: 0,1:13:07.58,1:13:08.78,Lalai,FE,0,0,0,,Dan bagus.
Dialog: 0,1:13:08.78,1:13:11.21,Lalai,FE,0,0,0,,Semua alkohol memihak kepada anda.
Dialog: 0,1:13:11.95,1:13:14.65,Lalai,FE,0,0,0,,Ia kalis peluru, atau apa?
Dialog: 0,1:13:15.02,1:13:17.15,Lalai,FE,0,0,0,,Tiada kesan.
Dialog: 0,1:13:17.15,1:13:19.32,Lalai,FU,0,0,0,,Okey. Adakah anda mahu bermain permainan?
Dialog: 0,1:13:19.89,1:13:22.52,Lalai,FE,0,0,0,,Saya tahu beberapa permainan yang anda perlu minum.
Dialog: 0,1:13:23.36,1:13:24.53,Lalai,FE,0,0,0,,Betulkah?
Dialog: 0,1:13:24.93,1:13:26.93,Lalai,FU,0,0,0,,3, 6, 9, 3, 6, 9,
Dialog: 0,1:13:26.93,1:13:28.76,Lalai,FU,0,0,0,,3, 6, 9, 3, 6, 9.
Dialog: 0,1:13:31.73,1:13:33.74,Lalai,FE,0,0,0,,Bilakah jadual pendaraban muncul di Korea?
Dialog: 0,1:13:33.74,1:13:36.04,Lalai,FE,0,0,0,,Tidak tahu? Kemudian -
Dialog: 0,1:13:36.04,1:13:39.31,Lalai,FU,0,0,0,,gagak murai, gagak murai, gagak murai,
Dialog: 0,1:13:39.31,1:13:41.88,Lalai,PU,0,0,0,,gagak murai, gagak murai.
Dialog: 0,1:13:41.88,1:13:44.88,Lalai,FE,0,0,0,,Nampaknya perkataan "malu" dicipta untuk kes ini.
Dialog: 0,1:13:44.88,1:13:46.18,Lalai,FE,0,0,0,,Hei, apa yang awak tak buat?
Dialog: 0,1:13:46.38,1:13:47.68,Lalai,FE,0,0,0,,Apakah yang perlu saya lakukan?
Dialog: 0,1:13:48.05,1:13:50.15,Lalai,FE,0,0,0,,Saya suka idea bermain,
Dialog: 0,1:13:50.55,1:13:53.66,Lalai,FE,0,0,0,,tetapi anda hanya menjerit "burung gagak". membosankan.
Dialog: 0,1:13:54.36,1:13:55.92,Lalai,FE,0,0,0,,Itu satu nitpick.
Dialog: 0,1:13:57.23,1:14:00.16,Lalai,FE,0,0,0,,Alkohol memerlukan tarian dan muzik.
Dialog: 0,1:14:04.07,1:14:07.50,Lalai,FE,0,0,0,,Berapa lama anda boleh menari mengikut muzik purba nenek moyang anda?
Dialog: 0,1:14:07.50,1:14:08.67,Lalai,FE,0,0,0,,Jaga bahu anda.
Dialog: 0,1:14:08.67,1:14:10.34,Lalai,FU,0,0,0,,Ia naik dan turun.
Dialog: 0,1:14:10.34,1:14:11.67,Lalai,FE,0,0,0,,Dan gelas itu turun,
Dialog: 0,1:14:11.67,1:14:13.98,Lalai,FU,0,0,0,,bawah, bawah, bawah.
Dialog: 0,1:14:13.98,1:14:15.18,Lalai,FE,0,0,0,,Gelas akan turun,
Dialog: 0,1:14:15.18,1:14:16.18,Lalai,FU,0,0,0,,bawah, bawah, bawah.
Dialog: 0,1:14:16.18,1:14:17.65,Lalai,FE,0,0,0,,Adakah anda begitu teruja?
Dialog: 0,1:14:22.18,1:14:25.12,Lalai,FE,0,0,0,,Adakah muzik nenek moyang berfungsi?
Dialog: 0,1:14:29.56,1:14:30.99,Lalai,FE,0,0,0,,Kalau begitu mari kita mulakan?
Dialog: 0,1:14:40.07,1:14:42.40,Lalai,FE,0,0,0,,Tidak, bukan itu yang saya maksudkan!
Dialog: 0,1:14:54.58,1:14:56.95,Lalai,FE,0,0,0,,Kita perlu mengambil langkah yang melampau.
Dialog: 0,1:15:39.39,1:15:42.20,Lalai,FE,0,0,0,,Bagaimana rasanya menyambut hari baharu sebagai seorang ratu?
Dialog: 0,1:15:42.20,1:15:43.37,Lalai,FE,0,0,0,,-Crap.\N-Betul.
Dialog: 0,1:15:43.37,1:15:46.37,Lalai,FE,0,0,0,,Kami sedang bersedia untuk pertempuran untuk kuasa dan pembalasan.
Dialog: 0,1:15:46.37,1:15:49.44,Lalai,FE,0,0,0,,Satu-satunya cara untuk menghukum mereka yang berkuasa ialah
Dialog: 0,1:15:49.44,1:15:52.17,Lalai,FE,0,0,0,,cari bukti rasuah dan hati nurani mereka yang buruk.
Dialog: 0,1:15:52.17,1:15:53.54,Lalai,FE,0,0,0,,Melihatnya secara peribadi,
Dialog: 0,1:15:53.54,1:15:56.24,Lalai,FE,0,0,0,,Saya melihat bahawa permaisuri masih bukan dirinya.
Dialog: 0,1:15:56.24,1:15:58.51,Lalai,FE,0,0,0,,Lebih penting bagi kita siapa dia sepatutnya,
Dialog: 0,1:15:58.51,1:16:01.35,Lalai,FE,0,0,0,,daripada siapa dia.
Dialog: 0,1:16:01.52,1:16:02.52,Lalai,FE,0,0,0,,Ini adalah hadiah.
Dialog: 0,1:16:02.52,1:16:04.25,Lalai,FE,0,0,0,,Jika ada cara yang baik, gunakannya.
Dialog: 0,1:16:04.25,1:16:06.02,Lalai,FE,0,0,0,,Apakah pilihan terakhir yang anda bincangkan?
Dialog: 0,1:16:06.09,1:16:07.26,Lalai,FE,0,0,0,,Pembunuhan.
Dialog: 0,2:01:37.06,2:01:39.06,PRESENT,,0,0,0,,

Ulasan: 0,1:14:21.04,1:14:25.45,Lalai,FE,0,0,0,,Queen Chkhorin
