Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:03.96,0:01:06.46,Default,Lily,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.46,0:01:08.66,Default,ليلي,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:01:15.70,0:01:18.84,Default,Lily,0,0,0,,يقولون أن السهم لا يطير بشكل مستقيم عندما تكون قلقاً.
Dialogue: 0,0:01:20.07,0:01:22.94,Default,ليلي,0,0,0,,11 حلقة
Dialogue: 0,0:01:34.39,0:01:37.26,Default,Lily,0,0,0,,أعتذر عن طلب مثل هذا الاجتماع المتأخر.
Dialogue: 0,0:01:37.42,0:01:39.33,Default,ليلي,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:01:39.66,0:01:41.09,Default,ليلي,0,0,0,,أنت بحاجة لي،
Dialogue: 0,0:01:41.09,0:01:42.56,Default,ليلي,0,0,0,,وأنا ممتن لذلك.
Dialogue: 0,0:01:43.70,0:01:46.73,Default,ليلي,0,0,0,,ليت هذا حلماً.
Dialogue: 0,0:01:47.73,0:01:51.57,Default,Lily,0,0,0,,ليت كل شيء يختفي عندما أستيقظ.
Dialogue: 0,0:01:56.68,0:01:58.25,Default,ليلي,0,0,0,,لدي شيء لك.
Dialogue: 0,0:02:14.03,0:02:15.76,افتراضي,ليلي,0,0,0,,سر
Dialogue: 0,0:02:33.08,0:02:37.15,Default,ليلي,0,0,0,,اغمر الملكة في الكابوس الذي أعيش فيه.
Dialogue: 0,0:02:48.46,0:02:49.70,Default,ليلي,0,0,0,,ملكي.
Dialogue: 0,0:02:52.00,0:02:56.27,Default,ليلي,0,0,0,,لقد أتيت إليّ الليلة الماضية في المنام
Dialogue: 0,0:02:56.97,0:03:00.51,Default,ليلي,0,0,0,,وسقطت قوة هائلة في يدي.
Dialogue: 0,0:03:15.16,0:03:18.53,Default,ليلي,0,0,0,,قاموس الملكة
Dialogue: 0,0:03:24.50,0:03:26.40,Default,ليلي,0,0,0,,التباعد الاجتماعي
Dialogue: 0,0:03:30.17,0:03:32.84,Default,ليلي,0,0,0,,رائع، وقت السحر، متعطش للاهتمام،
Dialogue: 0,0:03:32.84,0:03:36.34,Default,ليلي,0,0,0,,المواجهة، شاي الياسمين، وقحة
Dialogue: 0,0:03:51.36,0:03:53.03,Default,ليلي,0,0,0,,لطيفات.
Dialogue: 0,0:03:56.43,0:03:57.46,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:03:59.60,0:04:03.14,Default,ليلي,0,0,0,,هل فقدت صوتك، ناديتني بالأجش؟
Dialogue: 0,0:04:08.71,0:04:09.78,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:04:13.81,0:04:14.85,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:04:17.52,0:04:19.05,Default,ليلي,0,0,0,,هل الماء دافئ بما فيه الكفاية؟
Dialogue: 0,0:04:20.22,0:04:21.96,Default,ليلي,0,0,0,,هل الماء دافئ بما فيه الكفاية؟
Dialogue: 0,0:04:24.46,0:04:26.19,Default,ليلي,0,0,0,,يعجبني ذلك.
Dialogue: 0,0:04:26.19,0:04:28.70,Default,ليلي,0,0,0,,لماذا نسيت هنا بحق الجحيم؟
Dialogue: 0,0:04:33.47,0:04:34.60,Default,ليلي,0,0,0,,ملكتي.
Dialogue: 0,0:04:37.74,0:04:38.97,Default,ليلي,0,0,0,,اليوم
Dialogue: 0,0:04:40.34,0:04:42.18,Default,ليلي,0,0,0,,لا يوجد تباعد اجتماعي.
Dialogue: 0,0:04:52.72,0:04:55.42,Default,ليلي,0,0,0,,جلالتك، هل أنت مستيقظ؟
Dialogue: 0,0:04:59.66,0:05:00.69,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:05:01.19,0:05:03.70,Default,ليلي,0,0,0,,لماذا تبدو مخيفاً جداً؟
Dialogue: 0,0:05:04.00,0:05:06.73,Default,Lily,0,0,0,,كيف تجرؤ على إفساد حلمي المثير؟
Dialogue: 0,0:05:07.93,0:05:09.37,Default,ليلي,0,0,0,,اتصل به فوراً!
Dialogue: 0,0:05:09.74,0:05:10.90,Default,ليلي,0,0,0,,حسنًا.
Dialogue: 0,0:05:11.81,0:05:12.97,Default,ليلي,0,0,0,,اتصل...
Dialogue: 0,0:05:15.58,0:05:16.71,Default,ليلي,0,0,0,,بمن يجب أن نتصل؟
Dialogue: 0,0:05:27.05,0:05:28.49,Default,ليلي,0,0,0,,قاموس الملكة
Dialogue: 0,0:05:29.19,0:05:31.42,Default,ليلي,0,0,0,,أنت في مزاج جيد يا صاحب الجلالة.
Dialogue: 0,0:05:32.86,0:05:35.13,Default,ليلي,0,0,0,,نمت طوال الليل دون أن تستيقظ.
Dialogue: 0,0:05:36.33,0:05:38.63,Default,ليلي,0,0,0,,ابدأ بالتحضير للوليمة.
Dialogue: 0,0:05:39.87,0:05:40.93,Default,ليلي,0,0,0,,حسنًا.
Dialogue: 0,0:05:47.07,0:05:50.44,Default,ليلي,0,0,0,,11 حلقة. الشخص الذي لا يمكن أن يغفر له
Dialogue: 0,0:05:51.55,0:05:52.61,Default,ليلي,0,0,0,,دكتور.
Dialogue: 0,0:05:53.85,0:05:55.42,Default,ليلي,0,0,0,,كان لدي كابوس.
Dialogue: 0,0:05:55.85,0:05:57.95,Default,ليلي,0,0,0,,ولكن الأسوأ من هذا الكابوس،
Dialogue: 0,0:05:57.95,0:05:59.49,Default,ليلي,0,0,0,,أنني لم أحبه
Dialogue: 0,0:06:00.89,0:06:03.02,Default,ليلي,0,0,0,,وأعجبني في نفس الوقت.
Dialogue: 0,0:06:03.39,0:06:06.29,Default,Lily,0,0,0,,لا أعرف إذا كنت أشعر بذلك أم بجسدي.
Dialogue: 0,0:06:07.16,0:06:10.53,Default,Lily,0,0,0,,أشعر وكأنني قد تم تجميعي معًا.
Dialogue: 0,0:06:11.43,0:06:12.50,Default,ليلي,0,0,0,,بالضبط.
Dialogue: 0,0:06:13.63,0:06:16.90,Default,Lily,0,0,0,,يبدو الأمر كما لو أنني تحولت إلى مُنشئ Lego.
Dialogue: 0,0:06:17.30,0:06:20.57,Default,ليلي,0,0,0,,من أنا بحق الجحيم؟
Dialogue: 0,0:06:22.71,0:06:24.61,Default,ليلي,0,0,0,,ولكن لماذا
Dialogue: 0,0:06:25.45,0:06:28.42,Default,ليلي,0,0,0,,هل تناديني "دكتور"؟
Dialogue: 0,0:06:29.25,0:06:31.08,Default,ليلي,0,0,0,,لقد قاطعتني.
Dialogue: 0,0:06:31.08,0:06:33.49,Default,ليلي,0,0,0,,فقط استمع. وهذا بالمناسبة ضروري.
Dialogue: 0,0:06:37.19,0:06:40.16,Default,ليلي,0,0,0,,فما رأي الخبير؟
Dialogue: 0,0:06:40.53,0:06:45.07,Default,Lily,0,0,0,,التغيرات في الجسم هي آثار جانبية للحالة الخضرية.
Dialogue: 0,0:06:46.33,0:06:47.40,Default,ليلي,0,0,0,,فهل هذا طبيعي؟
Dialogue: 0,0:06:50.70,0:06:52.71,Default,ليلي,0,0,0,,لا يوجد شيء غير عادي.
Dialogue: 0,0:06:54.21,0:06:57.48,Default,ليلي,0,0,0,,مريح للغاية، في الواقع.
Dialogue: 0,0:06:57.91,0:07:01.75,Default,ليلي,0,0,0,,بكلماتك بدأ القلق يختفي.
Dialogue: 0,0:07:03.58,0:07:06.22,Default,ليلي,0,0,0,,من يشفى بدون وخز بالإبر -
Dialogue: 0,0:07:06.52,0:07:08.25,Default,ليلي,0,0,0,,معالج عظيم.
Dialogue: 0,0:07:09.16,0:07:10.19,Default,ليلي,0,0,0,,اتضح أن
Dialogue: 0,0:07:10.92,0:07:14.13,Default,ليلي,0,0,0,,الطبيب الملكي والخبير في علم النفس.
Dialogue: 0,0:07:15.56,0:07:19.17,Default,Lily,0,0,0,,متى تكون حالتي المختلطة ذات الوجهين؟
Dialogue: 0,0:07:19.17,0:07:20.53,Default,ليلي,0,0,0,,هل ستسمح لي بالذهاب؟
Dialogue: 0,0:07:20.77,0:07:23.27,Default,Lily,0,0,0,,كل المشاكل مرتبطة بقلبك.
Dialogue: 0,0:07:23.40,0:07:26.67,Default,Lily,0,0,0,,بمجرد قبولك لهذا، ستزول المخاوف.
Dialogue: 0,0:07:26.67,0:07:29.81,Default,Lily,0,0,0,,يمكنك البدء بالعيش من جديد دون قلق.
Dialogue: 0,0:07:29.81,0:07:33.58,Default,ليلي,0,0,0,,هل يجب أن أقبل نفسي كما أنا؟
Dialogue: 0,0:07:36.22,0:07:40.09,Default,ليلي,0,0,0,,معقول. الشيء الوحيد الثابت فيّ هو تناقضي.
Dialogue: 0,0:07:41.22,0:07:42.26,Default,ليلي,0,0,0,,بالمناسبة.
Dialogue: 0,0:07:42.99,0:07:45.56,Default,Lily,0,0,0,,كانت أعشاب غطاء الجمال رائعة.
Dialogue: 0,0:07:47.29,0:07:48.53,Default,ليلي,0,0,0,,استخدمهم,
Dialogue: 0,0:07:48.53,0:07:50.73,Default,Lily,0,0,0,,لإنشاء منتج للوجه.
Dialogue: 0,0:07:51.50,0:07:53.20,Default,ليلي,0,0,0,,المرونة والإشراق والسطوع.
Dialogue: 0,0:07:53.20,0:07:55.57,Default,Lily,0,0,0,,يجب أن يلفت الغرض الانتباه.
Dialogue: 0,0:07:55.57,0:07:57.60,Default,Lily,0,0,0,,مطلوب كل 28 يومًا، ابذل المزيد.
Dialogue: 0,0:07:58.74,0:08:01.17,Default,ليلي,0,0,0,,لماذا 28 يوماً؟
Dialogue: 0,0:08:01.17,0:08:02.48,Default,Lily,0,0,0,,هذه هي كمية تجدد الجلد.
Dialogue: 0,0:08:02.98,0:08:04.61,Default,ليلي,0,0,0,,عندما يصبح جلدها متقرنًا،
Dialogue: 0,0:08:04.61,0:08:05.98,Default,ليلي,0,0,0,,سوف تحتاجني.
Dialogue: 0,0:08:06.81,0:08:08.21,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:08:08.45,0:08:11.45,Default,ليلي,0,0,0,,السيد. لقد جاء يونغجين إليك.
Dialogue: 0,0:08:17.56,0:08:19.59,Default,ليلي,0,0,0,,هل هذه الخادمة هواجين حقاً؟
Dialogue: 0,0:08:19.89,0:08:21.80,Default,ليلي,0,0,0,,إنها متأكدة من ذلك.
Dialogue: 0,0:08:23.06,0:08:26.97,Default,Lilia,0,0,0,,لكنني آمل أن تكون "أوفول" بنفسها قد باعت النوريغا.
Dialogue: 0,0:08:27.20,0:08:28.94,Default,ليليا,0,0,0,,ربما كان هواجين منزعجاً.
Dialogue: 0,0:08:30.37,0:08:32.07,Default,ليلي,0,0,0,,علينا أن نزورها.
Dialogue: 0,0:08:34.37,0:08:37.34,Default,ليلي,0,0,0,,جلالتك. المحظية الرئيسية تطلب الجمهور.
Dialogue: 0,0:08:37.38,0:08:38.51,Default,ليلي,0,0,0,,دعه يدخل.
Dialogue: 0,0:08:42.48,0:08:43.48,Default,ليلي,0,0,0,,محظية.
Dialogue: 0,0:08:51.49,0:08:52.59,Default,ليلي,0,0,0,,عذراً.
Dialogue: 0,0:08:55.50,0:08:57.70,Default,ليلي,0,0,0,,لقد رسمت أوفول.
Dialogue: 0,0:08:58.43,0:09:01.60,Default,ليلي,0,0,0,,هكذا بالضبط تذكرتها.
Dialogue: 0,0:09:01.97,0:09:03.07,Default,ليلي,0,0,0,,أنا متأكد،
Dialogue: 0,0:09:03.94,0:09:05.77,Default,Lilia,0,0,0,,التي باعتها "أوفول" بنفسها لنوريجا.
Dialogue: 0,0:09:06.17,0:09:08.01,Default,ليلي,0,0,0,,لن ينتهي بها الأمر هكذا في القصر.
Dialogue: 0,0:09:09.61,0:09:11.28,Default,Lily,0,0,0,,يمكنك التأكد من الصورة.
Dialogue: 0,0:09:16.05,0:09:17.32,Default,ليلي,0,0,0,,عفوا.
Dialogue: 0,0:09:18.08,0:09:19.15,Default,ليلي,0,0,0,,بالطبع.
Dialogue: 0,0:09:26.66,0:09:28.16,Default,ليلي,0,0,0,,لقد اكتشفت ذلك للتو.
Dialogue: 0,0:09:29.03,0:09:31.46,Default,ليلي,0,0,0,,لقد واجهت وقتًا عصيبًا الليلة الماضية.
Dialogue: 0,0:09:33.13,0:09:36.34,Default,ليلي,0,0,0,,قضيت الليل كله أجمع أفكاري، لا تقلق.
Dialogue: 0,0:09:39.77,0:09:41.88,Default,ليلي,0,0,0,,أريد أن أخبرك بشيء.
Dialogue: 0,0:09:45.04,0:09:47.68,Default,Lily,0,0,0,,هذا يتعلق بمشاعرك تجاه الملكة.
Dialogue: 0,0:09:48.31,0:09:49.68,Default,ليلي,0,0,0,,من الصعب التغلب على نفسك،
Dialogue: 0,0:09:50.45,0:09:53.72,Default,Lily,0,0,0,,من التغلب على شخص آخر. لذلك
Dialogue: 0,0:09:55.02,0:09:56.56,Default,ليلي,0,0,0,,استسلم لمشاعرك.
Dialogue: 0,0:09:58.06,0:10:01.69,Default,ليلي,0,0,0,,لست بحاجة إلى اعتذارك.
Dialogue: 0,0:10:18.34,0:10:20.21,Default,ليلي,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:10:21.65,0:10:23.25,Default,ليلي,0,0,0,,لقد مر يوم واحد فقط منذ أن عدت إلى القصر،
Dialogue: 0,0:10:23.25,0:10:24.85,Default,ليلي,0,0,0,,حسنًا.
Dialogue: 0,0:10:24.85,0:10:27.72,Default,Lily,0,0,0,,ومع ذلك، سأكون مشغولاً باختيار المحظيات.
Dialogue: 0,0:10:27.72,0:10:29.56,Default,ليلي,0,0,0,,اختيار المحظيات.
Dialogue: 0,0:10:33.43,0:10:36.90,Default,ليلي,0,0,0,,الوصول إلى غرفتي،
Dialogue: 0,0:10:37.50,0:10:40.13,Default,ليلي,0,0,0,,هل لاحظت أي شيء غريب؟
Dialogue: 0,0:10:41.67,0:10:43.67,Default,ليلي,0,0,0,,هل هناك شيء غريب؟
Dialogue: 0,0:10:44.54,0:10:47.31,Default,ليلي,0,0,0,,لقد قمت بسحب الملك من البئر، ولكن...
Dialogue: 0,0:10:47.71,0:10:49.51,Default,ليلي,0,0,0,,لا. هل حدث شيء ما؟
Dialogue: 0,0:10:50.68,0:10:51.85,Default,ليلي,0,0,0,,حسناً...
Dialogue: 0,0:10:53.88,0:10:57.02,Default,ليلي,0,0,0,,لقد قمتما بزيارتي،
Dialogue: 0,0:10:57.02,0:10:58.92,Default,ليلي,0,0,0,,بدونك يبدو المنزل فارغاً.
Dialogue: 0,0:10:58.92,0:11:00.95,Default,Lily,0,0,0,,يبدو أن هذا هو بيت القصيد.
Dialogue: 0,0:11:02.19,0:11:04.02,Default,ليلي,0,0,0,,هل ترى جلالته؟
Dialogue: 0,0:11:04.22,0:11:06.36,Default,ليلي,0,0,0,,تسووا الأمر فيما بينكم.
Dialogue: 0,0:11:06.36,0:11:07.46,Default,ليلي,0,0,0,,لا يستحق كل هذا العناء.
Dialogue: 0,0:11:08.33,0:11:10.16,Default,ليلي,0,0,0,,أعتقد أنه مشغول بتحضير الوليمة.
Dialogue: 0,0:11:10.16,0:11:13.37,Default,Lily,0,0,0,,جلالتك، لقد أحضرت\N رسالة إلى بيت العروس.
Dialogue: 0,0:11:13.60,0:11:16.24,Default,ليلي,0,0,0,,عليك الاهتمام بالأعمال. سأذهب.
Dialogue: 0,0:11:25.61,0:11:26.68,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:11:27.95,0:11:30.15,Default,ليلي,0,0,0,,حتى لو كان هناك 100 محظية،
Dialogue: 0,0:11:31.48,0:11:33.09,Default,ليلي,0,0,0,,لن يجرؤوا
Dialogue: 0,0:11:34.65,0:11:37.06,Default,ليلي,0,0,0,,خذي مكان الملكة.
Dialogue: 0,0:11:37.66,0:11:39.59,Default,ليلي,0,0,0,,نعم. بالتأكيد.
Dialogue: 0,0:11:40.73,0:11:42.70,Default,ليلي,0,0,0,,من فضلك اعتني بنفسك.
Dialogue: 0,0:11:45.27,0:11:46.90,Default,ليلي,0,0,0,,وداعا.
Dialogue: 0,0:11:54.71,0:11:56.74,Default,ليلي,0,0,0,,هان سيوك
Dialogue: 0,0:11:59.35,0:12:00.51,Default,ليلي,0,0,0,,تخلص من عائلة خان.
Dialogue: 0,0:12:00.81,0:12:02.52,Default,ليلي,0,0,0,,يمكننا الاستغناء عن روميو وجولييت.
Dialogue: 0,0:12:02.95,0:12:05.39,Default,Lily,0,0,0,,هل أحضرت أنساب عائلات الهان؟
Dialogue: 0,0:12:07.99,0:12:09.36,Default,ليلي,0,0,0,,هان من بيونغسان.
Dialogue: 0,0:12:11.56,0:12:12.99,Default,ليلي,0,0,0,,خان من هانيانغ.
Dialogue: 0,0:12:13.46,0:12:14.76,Default,ليلي,0,0,0,,هان من أنبيون.
Dialogue: 0,0:12:15.16,0:12:17.56,Default,ليلي,0,0,0,,-خان من يانغجو.\N-انتظر.
Dialogue: 0,0:12:18.70,0:12:21.43,Default,Lily,0,0,0,,هل هذه جميع سلالات عائلات الهان؟
Dialogue: 0,0:12:22.70,0:12:24.00,Default,ليلي,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:12:24.10,0:12:26.61,Default,Lily,0,0,0,,اللعنة، هناك الكثير منهم.
Dialogue: 0,0:12:28.61,0:12:32.58,Default,ليلي,0,0,0,,هذا لن ينجح. أنا بحاجة لكسب صالحها.
Dialogue: 0,0:12:34.41,0:12:37.12,Default,ليلي,0,0,0,,بائع متجول. انا بحاجة الى نفس الشيء.
Dialogue: 0,0:12:37.82,0:12:40.45,Default,ليلي,0,0,0,,-البائع.\N-مبيعات المنازل.
Dialogue: 0,0:12:44.19,0:12:46.09,Default,ليلي,0,0,0,,هل حان وقت الغداء بالفعل؟
Dialogue: 0,0:12:47.59,0:12:51.90,Default,Lily,0,0,0,,حان وقت تدليل بشرتك.
Dialogue: 0,0:13:03.14,0:13:04.51,Default,ليلي,0,0,0,,أنت مبهر.
Dialogue: 0,0:13:05.71,0:13:09.32,Default,ليلي,0,0,0,,مجرد توهج غريب.
Dialogue: 0,0:13:09.48,0:13:13.12,Default,Lily,0,0,0,,بفضلك، أصبح يومي مليئاً بالعناية بالذات.
Dialogue: 0,0:13:13.39,0:13:15.86,Default,Lily,0,0,0,,لقد نسيت أمر اختيار المحظيات.
Dialogue: 0,0:13:16.92,0:13:18.49,Default,ليلي,0,0,0,,كيف حالك؟
Dialogue: 0,0:13:19.06,0:13:21.43,Default,ليلي,0,0,0,,أنا أبذل قصارى جهدي.
Dialogue: 0,0:13:21.43,0:13:24.40,Default,ليلي,0,0,0,,بالطبع. موهوب في شيء واحد، موهوب في كل شيء.
Dialogue: 0,0:13:24.40,0:13:27.20,Default,ليلي,0,0,0,,أنت تبلي بلاءً حسناً،
Dialogue: 0,0:13:27.20,0:13:28.97,Default,ليلي,0,0,0,,إنني أثق بك.
Dialogue: 0,0:13:30.97,0:13:32.57,Default,ليلي,0,0,0,,هناك شيء أريده
Dialogue: 0,0:13:32.57,0:13:35.48,Default,ليلي,0,0,0,,أعددتها خصيصاً لك.
Dialogue: 0,0:13:37.71,0:13:39.51,Default,Lily,0,0,0,,إذا غطّيت شعرك بهذا،
Dialogue: 0,0:13:39.51,0:13:41.28,Default,ليلي,0,0,0,,سوف تبدو أصغر بعشر سنوات.
Dialogue: 0,0:13:41.65,0:13:43.05,Default,ليلي,0,0,0,,مسحوق الشعر.
Dialogue: 0,0:13:45.28,0:13:49.22,Default,ليلي,0,0,0,,لا داعي لتطبيق عصير التوت
Dialogue: 0,0:13:49.22,0:13:51.26,Default,ليلي,0,0,0,,على رأسي كل صباح.
Dialogue: 0,0:13:52.16,0:13:53.83,Default,ليلي,0,0,0,,واو.
Dialogue: 0,0:13:55.60,0:13:58.23,Default,ليلي,0,0,0,,مسحوق بلطف.
Dialogue: 0,0:13:58.33,0:13:59.93,Default,ليلي,0,0,0,,مسحوق.
Dialogue: 0,0:14:04.27,0:14:05.91,Default,Second,0,0,0,,هذا شخص مختلف تمامًا.
Dialogue: 0,0:14:06.61,0:14:10.31,Default,Second,0,0,0,,كانت عيونها مائلة أكثر.
Dialogue: 0,0:14:10.61,0:14:12.98,Default,Second,0,0,0,,أو ربما كانت العين اليسرى فقط تحدق؟
Dialogue: 0,0:14:12.98,0:14:15.38,Default,Second,0,0,0,,كم أنا جائع.
Dialogue: 0,0:14:21.65,0:14:23.12,Default,الثانية,0,0,0,,ممتاز.
Dialogue: 0,0:14:24.32,0:14:27.43,Default,Second,0,0,0,,الوجه رقيق وخدود ممتلئة.
Dialogue: 0,0:14:27.83,0:14:29.50,Default,الثانية,0,0,0,,بجبهة عريضة
Dialogue: 0,0:14:29.60,0:14:31.26,Default,Second,0,0,0,,وعيون لامعة.
Dialogue: 0,0:14:31.36,0:14:32.97,Default,Second,0,0,0,,شيء من هذا القبيل.
Dialogue: 0,0:14:33.10,0:14:35.47,Default,Second,0,0,0,,صنبور مستقيم بطرف مستدير.
Dialogue: 0,0:15:12.97,0:15:15.91,Default,Second,0,0,0,,يا صاحب الجلالة، لقد وصل الطباخ الملكي.
Dialogue: 0,0:15:17.68,0:15:20.28,Default,Second,0,0,0,,أعتقد أن مشروب الكالاموس سيفي بالغرض. ماذا تعتقد؟
Dialogue: 0,0:15:20.75,0:15:21.81,Default,الثانية,0,0,0,,ماذا؟
Dialogue: 0,0:15:22.18,0:15:25.49,Default,Second,0,0,0,,لقد انجرفت في أفكاري.
Dialogue: 0,0:15:25.79,0:15:27.95,Default,Second,0,0,0,,أفكر في أي مشروب كحولي سأختاره للعيد.
Dialogue: 0,0:15:29.69,0:15:33.99,Default,Second,0,0,0,,جلالتك، لقد أعددت شيئاً هنا.
Dialogue: 0,0:15:43.04,0:15:45.00,Default,Second,0,0,0,,أنا أستحق أن أموت.
Dialogue: 0,0:16:01.65,0:16:02.86,Default,الثانية,0,0,0,,استرخِ.
Dialogue: 0,0:16:03.59,0:16:05.29,Default,Second,0,0,0,,ثم كل شيء سوف يسير بسلاسة.
Dialogue: 0,0:16:06.56,0:16:07.99,Default,Second,0,0,0,,كما تقول.
Dialogue: 0,0:16:13.93,0:16:16.07,Default,Second,0,0,0,,هل أنت مرتاح؟ ثم شاهد.
Dialogue: 0,0:16:17.40,0:16:18.64,Default,الثانية,0,0,0,,ماذا؟
Dialogue: 0,0:16:21.01,0:16:23.21,Default,Second,0,0,0,,هذه خطة وليمة تقليدية.
Dialogue: 0,0:16:23.68,0:16:25.91,Default,Second,0,0,0,,أريد تغييره قليلاً.
Dialogue: 0,0:16:26.28,0:16:30.05,Default,Second,0,0,0,,أريد تقليل عدد الأطباق وإزالتها
Dialogue: 0,0:16:30.05,0:16:32.59,Default,Second,0,0,0,,طاولة كبيرة غير ضرورية وفي وسطها طعام.
Dialogue: 0,0:16:32.99,0:16:34.89,Default,Second,0,0,0,,-عفوا أيها الملك.\N-نعم؟
Dialogue: 0,0:16:35.39,0:16:37.86,Default,الثانية,0,0,0,,العيد الملكي
Dialogue: 0,0:16:37.86,0:16:40.66,Default,Second,0,0,0,,يجب أن تكون فخمة وفاخرة.
Dialogue: 0,0:16:40.66,0:16:42.43,Default,Second,0,0,0,,مهما كان ذلك غير ضروري...
Dialogue: 0,0:16:43.80,0:16:45.06,Default,Second,0,0,0,,هل فقدت عقلك؟
Dialogue: 0,0:16:49.47,0:16:51.90,Default,Second,0,0,0,,شعبي يعاني من الجوع.
Dialogue: 0,0:16:52.21,0:16:54.07,Default,Second,0,0,0,,هل سأترجم الطعام من أجل المتعة؟
Dialogue: 0,0:16:54.27,0:16:56.58,Default,Second,0,0,0,,ثم الطعام الذي سنعده،
Dialogue: 0,0:16:57.68,0:17:00.48,Default,الثانية,0,0,0,,سنعطيها للجياع خارج القصر.
Dialogue: 0,0:17:04.28,0:17:06.29,Default,Second,0,0,0,,متواضع، لكن ليس بخيلاً.
Dialogue: 0,0:17:06.85,0:17:09.62,Default,Second,0,0,0,,رائعة ولكنها ليست مدّعية.
Dialogue: 0,0:17:09.99,0:17:11.52,Default,Second,0,0,0,,أريد مثل هذه الوليمة.
Dialogue: 0,0:17:16.63,0:17:20.83,Default,Second,0,0,0,,سأبذل قصارى جهدي في الأسبوعين المقبلين.
Dialogue: 0,0:17:24.60,0:17:25.67,Default,Second,0,0,0,,آمل أن نتمكن من العمل معًا.
Dialogue: 0,0:17:32.14,0:17:33.18,Default,Second,0,0,0,,جلالتك.
Dialogue: 0,0:17:38.12,0:17:40.39,Default,Second,0,0,0,,هل من السهل جعل الرجل يبكي؟
Dialogue: 0,0:17:48.43,0:17:50.76,Default,Second,0,0,0,,لا أستطيع حتى أن أصدق ذلك،
Dialogue: 0,0:17:50.76,0:17:53.07,Default,Second,0,0,0,,مثل هذه المحاسبة التفصيلية لمصادر الرشاوى.
Dialogue: 0,0:17:54.63,0:17:57.94,Default,Second,0,0,0,,والد الملكة أكثر دقة مما كنت أعتقد.
Dialogue: 0,0:17:58.37,0:18:02.34,Default,Second,0,0,0,,عدو المحظية الملكية Cho\N ليس عشيرة كيم، بل الملكة.
Dialogue: 0,0:18:04.08,0:18:06.48,Default,Second,0,0,0,,لذا لم تتمكن من رؤية الصورة الكبيرة.
Dialogue: 0,0:18:15.39,0:18:19.19,Default,Second,0,0,0,,يجب علينا إدارة دفتر الأستاذ بشكل صحيح.
Dialogue: 0,0:18:19.19,0:18:21.66,Default,Second,0,0,0,,وبعد ذلك سندمر عائلة كيم
Dialogue: 0,0:18:22.09,0:18:25.06,Default,Second,0,0,0,,وسوف نطيح بالملكة من العرش.
Dialogue: 0,0:18:31.27,0:18:32.41,Default,Second,0,0,0,,دفتر الحساب؟
Dialogue: 0,0:18:33.91,0:18:36.51,Default,Second,0,0,0,,ماذا كان يفكر؟ كيف يمكنه تخزين شيء بهذه الخطورة؟
Dialogue: 0,0:18:36.51,0:18:37.68,Default,Second,0,0,0,,يجب أن...
Dialogue: 0,0:18:40.78,0:18:42.38,Default,Second,0,0,0,,احتفظ بهذا سراً في الوقت الحالي.
Dialogue: 0,0:18:42.38,0:18:44.38,Default,Second,0,0,0,,إذا اكتشف الآخرون في العائلة الأمر، فسيثيرون ضجة.
Dialogue: 0,0:18:44.38,0:18:47.15,Default,الثانية,0,0,0,,كيف ذلك. يا له من احمق.
Dialogue: 0,0:18:48.79,0:18:49.89,Default,Second,0,0,0,,وبعد،
Dialogue: 0,0:18:50.99,0:18:52.83,Default,Second,0,0,0,,من يملك الكتاب في رأيك؟
Dialogue: 0,0:18:52.83,0:18:55.49,Default,Second,0,0,0,,قضى الملك يومين في منزله،
Dialogue: 0,0:18:55.49,0:18:57.66,Default,Second,0,0,0,,تجاهل طلب العودة إلى القصر.
Dialogue: 0,0:18:57.66,0:18:58.70,Default,الثانية,0,0,0,,لذا,
Dialogue: 0,0:19:00.30,0:19:01.33,Default,الثانية,0,0,0,,ملك؟
Dialogue: 0,0:19:03.20,0:19:06.61,Default,Second,0,0,0,,يريد أن يكشف لنا خلال العيد في يوم العربة.
Dialogue: 0,0:19:07.01,0:19:08.91,Default,Second,0,0,0,,ربما السلاح بين يديه،
Dialogue: 0,0:19:09.81,0:19:12.88,Default,Second,0,0,0,,لكن يجب علينا إضعافه حتى لا يستغله.
Dialogue: 0,0:19:14.45,0:19:15.75,Default,Second,0,0,0,,يفكر كيم مون جيون،
Dialogue: 0,0:19:16.75,0:19:19.55,Default,Second,0,0,0,,أنني كنت المشتبه به الوحيد المتبقي.
Dialogue: 0,0:19:19.55,0:19:22.15,Default,Second,0,0,0,,لكنه لا يستطيع أن يسأل الملك إذا كان قد سرق الكتاب.
Dialogue: 0,0:19:22.52,0:19:23.76,Default,Second,0,0,0,,لابد أن الأمر صعب عليه.
Dialogue: 0,0:19:24.59,0:19:27.36,Default,Second,0,0,0,,هل اكتشفنا بالفعل من كان يختبئ خلف القناع؟
Dialogue: 0,0:19:27.36,0:19:28.83,Default,Second,0,0,0,,في قسم المباحث
Dialogue: 0,0:19:28.83,0:19:30.70,Default,Second,0,0,0,,لا أحد لديه ندبة على خده.
Dialogue: 0,0:19:31.50,0:19:33.87,Default,Second,0,0,0,,حتى لو لم نستلم الدفتر،
Dialogue: 0,0:19:34.37,0:19:37.37,Default,Second,0,0,0,,يجب أن نجهز مؤامرة لتحقيق هدفنا.
Dialogue: 0,0:19:38.30,0:19:40.84,Default,Second,0,0,0,,هل درست موقف الأجناس الأخرى؟
Dialogue: 0,0:19:51.88,0:19:53.32,Default,الثانية,0,0,0,,قانون الخمس ثواني.
Dialogue: 0,0:19:53.82,0:19:56.59,Default,Second,0,0,0,,خمس ثوانٍ كافية للوقوع في الحب.
Dialogue: 0,0:19:59.13,0:20:01.59,Default,Second,0,0,0,,جلالة الملك، الجميع هنا.
Dialogue: 0,0:20:01.59,0:20:03.13,Default,Second,0,0,0,,-هل هذا كل شيء؟\N-نعم.
Dialogue: 0,0:20:08.40,0:20:09.50,Default,Second,0,0,0,,تشرفت بلقائك.
Dialogue: 0,0:20:11.00,0:20:12.04,Default,Second,0,0,0,,تشرفت بلقائك.
Dialogue: 0,0:20:12.71,0:20:17.08,Default,Second,0,0,0,,تشرفت بلقائك.
Dialogue: 0,0:20:17.81,0:20:19.11,Default,Second,0,0,0,,دعونا نرى.
Dialogue: 0,0:20:19.11,0:20:21.48,Default,Second,0,0,0,,لقد قفزت شرارة بيني وبين...
Dialogue: 0,0:20:29.66,0:20:30.86,Default,Second,0,0,0,,أعجبني هذا أيضًا.
Dialogue: 0,0:20:36.66,0:20:41.60,Default,Second,0,0,0,,آنسة يون، أنت جميلة جدًا، ربما أخبرينا المزيد عن نفسك؟
Dialogue: 0,0:20:43.50,0:20:47.71,Default,Second,0,0,0,,هناك جبل جميل في مسقط رأسي.
Dialogue: 0,0:20:48.17,0:20:50.01,Default,Second,0,0,0,,يُسمى جبل كاماكسان.
Dialogue: 0,0:20:50.21,0:20:52.38,Default,Second,0,0,0,,-كاماكسان؟\N-نعم يا ملكة.
Dialogue: 0,0:20:54.51,0:20:56.12,Default,Second,0,0,0,,ببساطة مذهل.
Dialogue: 0,0:20:56.12,0:20:57.22,Default,الثانية,0,0,0,,-مذهلة؟\N-مذهلة؟
Dialogue: 0,0:20:59.59,0:21:00.65,Default,Second,0,0,0,,-جلالتك.\N-نعم؟
Dialogue: 0,0:21:00.65,0:21:03.59,Default,Second,0,0,0,,هناك قصر كبير في مدينتي.
Dialogue: 0,0:21:03.59,0:21:05.76,Default,Second,0,0,0,,لقد بناه الملك جيونغجو.
Dialogue: 0,0:21:05.76,0:21:08.29,Default,Second,0,0,0,,هل يمكنك فقط التفاخر بقصر هواسونغ؟
Dialogue: 0,0:21:09.83,0:21:12.13,Default,Second,0,0,0,,تحدث عنه فقط.
Dialogue: 0,0:21:12.63,0:21:15.07,Default,Second,0,0,0,,يمكنك التفاخر بشيء آخر،
Dialogue: 0,0:21:15.07,0:21:17.90,Default,Second,0,0,0,,إذا أصبحت محظية يا سيدة هونغ.
Dialogue: 0,0:21:19.17,0:21:21.07,Default,Second,0,0,0,,الملكة، شكراً لك!
Dialogue: 0,0:21:23.98,0:21:27.18,Default,Second,0,0,0,,في مسقط رأسي هناك حقول كاملة من أشجار الخوخ.
Dialogue: 0,0:21:27.18,0:21:29.38,Default,الثانية,0,0,0,,خلال فترة التزهير
Dialogue: 0,0:21:30.12,0:21:31.75,Default,Second,0,0,0,,ليس هناك مكان أكثر روعة.
Dialogue: 0,0:21:33.89,0:21:36.62,Default,Second,0,0,0,,كانت أمي تحلم بالخوخ عندما ولدت.
Dialogue: 0,0:21:37.12,0:21:39.06,Default,Second,0,0,0,,ليس مفاجئاً.
Dialogue: 0,0:21:39.06,0:21:41.23,Default,Second,0,0,0,,إذا كان بإمكانك مقارنة شخص ما بالخوخ،
Dialogue: 0,0:21:41.59,0:21:44.60,Default,Second,0,0,0,,إذًا أنت فقط، سيدة "مين".
Dialogue: 0,0:21:46.73,0:21:48.63,Default,Second,0,0,0,,خوختي.
Dialogue: 0,0:21:49.24,0:21:52.40,Default,Second,0,0,0,,إذا فزت بهذه الأنواع الثلاثة إلى جانبك،
Dialogue: 0,0:21:53.81,0:21:57.78,Default,Second,0,0,0,,ثم سيكون هناك تنين وطائرين عنقاء إلى جانبك.
Dialogue: 0,0:21:59.18,0:22:01.21,Default,Second,0,0,0,,وبعد ذلك يمكنك التغلب على النمر الأبيض.
Dialogue: 0,0:22:08.29,0:22:10.49,Default,Second,0,0,0,,بينما قصر هواسونغ يحرس البوابات،
Dialogue: 0,0:22:11.62,0:22:13.86,Default,Second,0,0,0,,المناظر الطبيعية لجبل كاماكسان تبهج عيني،
Dialogue: 0,0:22:14.56,0:22:19.23,Default,Second,0,0,0,,ورائحة الخوخ الحلوة تملأ غرفتي.
Dialogue: 0,0:22:37.12,0:22:39.99,Default,Second,0,0,0,,عشيرة فابيونغ يون. عشيرة ناميان هون.
Dialogue: 0,0:22:40.55,0:22:41.79,Default,Second,0,0,0,,Johyn clan Min.
Dialogue: 0,0:22:42.19,0:22:44.06,Default,Second,0,0,0,,توازن ممتاز للقوى.
Dialogue: 0,0:22:46.83,0:22:50.06,Default,Second,0,0,0,,بريء ومثير ولطيف.
Dialogue: 0,0:22:50.50,0:22:51.93,Default,الثانية,0,0,0,,الانسجام الحقيقي.
Dialogue: 0,0:22:58.84,0:23:00.67,Default,Second,0,0,0,,يون جيونوك من عائلة يون فابيونغ.
Dialogue: 0,0:23:01.44,0:23:03.21,Default,Second,0,0,0,,مين جايون من عشيرة يوهين في مين.
Dialogue: 0,0:23:03.94,0:23:06.01,Default,Second,0,0,0,,خون سيمخيان من عائلة ناميانغ في خون.
Dialogue: 0,0:23:06.75,0:23:10.18,Default,Second,0,0,0,,أعينك محظيات من الدرجة الثانية.
Dialogue: 0,0:23:13.82,0:23:18.09,Default,Second,0,0,0,,تنضم هذه المحظيات الثلاث وعائلاتهن إلى العائلة المالكة.
Dialogue: 0,0:23:18.66,0:23:21.33,Default,الثانية,0,0,0,,أخبروا عائلاتكم
Dialogue: 0,0:23:21.33,0:23:23.93,Default,Second,0,0,0,,دعوة إلى وليمة في يوم العربة.
Dialogue: 0,0:23:24.40,0:23:27.50,Default,Second,0,0,0,,-شكرًا لك يا صاحب الجلالة.\N-شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:23:32.74,0:23:34.27,Default,Second,0,0,0,,حسناً، أخيراً.
Dialogue: 0,0:23:35.07,0:23:37.74,Default,Second,0,0,0,,بدأ الملك بجمع الحلفاء حول نفسه.
Dialogue: 0,0:23:38.28,0:23:40.45,Default,Second,0,0,0,,لكنهم سيقطعون كل العلاقات معه،
Dialogue: 0,0:23:40.45,0:23:42.62,Default,Second,0,0,0,,بمجرد أن اكتشفوا مدى ضعفه.
Dialogue: 0,0:23:44.68,0:23:48.62,Default,Second,0,0,0,,أصر الملك على إقامة وليمة.
Dialogue: 0,0:23:48.89,0:23:50.16,Default,Second,0,0,0,,هل هذا ما أراده؟
Dialogue: 0,0:23:51.42,0:23:54.33,Default,Second,0,0,0,,-أرجو أن تكون مستعداً.\N-لا تقلق.
Dialogue: 0,0:24:04.20,0:24:05.24,Default,الثانية,0,0,0,,المزيد!
Dialogue: 0,0:24:08.74,0:24:11.28,Default,Second,0,0,0,,ربما يرغب الجميع بشدة في معرفة ما وراء الجدار.
Dialogue: 0,0:24:12.88,0:24:15.38,Default,Second,0,0,0,,إنهم يفعلون ذلك بشكل جيد.
Dialogue: 0,0:24:16.58,0:24:17.88,Default,Second,0,0,0,,الملكة الأم قادمة.
Dialogue: 0,0:24:22.05,0:24:24.79,Default,Second,0,0,0,,أتمنى أن تكوني بخير أيتها الملكة الأم.
Dialogue: 0,0:24:27.29,0:24:29.63,Default,Second,0,0,0,,لم أراك منذ وقت طويل، المحظية الملكية "تشو".
Dialogue: 0,0:24:30.96,0:24:33.43,Default,Third,0,0,0,,مرحباً يا صاحب الجلالة.
Dialogue: 0,0:24:36.14,0:24:39.10,Default,Third,0,0,0,,إذا سمحت لي سأتركك، أريد أن أتدرب على الرماية.
Dialogue: 0,0:24:48.45,0:24:49.52,Default,Third,0,0,0,,أنت هنا منذ وقت طويل
Dialogue: 0,0:24:49.52,0:24:51.22,Default,ثالثاً,0,0,0,,عادت إلى رشدها بعد مرض.
Dialogue: 0,0:24:51.22,0:24:53.19,Default,Third,0,0,0,,لكنها لم تزورني قط.
Dialogue: 0,0:24:54.89,0:24:56.36,Default,Third,0,0,0,,كنت مشغولاً باختيار الأزواج
Dialogue: 0,0:24:56.36,0:24:57.79,Default,الثالث,0,0,0,,لجلالة الملك.
Dialogue: 0,0:24:58.79,0:25:00.46,Default,الثالث,0,0,0,,سامحني.
Dialogue: 0,0:25:01.06,0:25:04.70,Default,Third,0,0,0,,بالنسبة لشخص واجه الموت، أنت منتعش جدًا.
Dialogue: 0,0:25:06.20,0:25:08.30,Default,Third,0,0,0,,لم أشتكي قط من صحتي.
Dialogue: 0,0:25:09.97,0:25:12.62,Default,Third,0,0,0,,إذا استسلمت، فلن تصطاد في "يوم العربة"؟
Dialogue: 0,0:25:13.04,0:25:15.31,Default,Third,0,0,0,,بدلاً من التدريب بالقوس
Dialogue: 0,0:25:15.47,0:25:17.28,Default,Third,0,0,0,,أنت تستمتع هنا.
Dialogue: 0,0:25:17.28,0:25:19.28,Default,Third,0,0,0,,سوف تفوز القرينة الملكية "تشو" على أية حال.
Dialogue: 0,0:25:19.28,0:25:21.41,Default,Third,0,0,0,,قررت الاستمتاع بالعطلة.
Dialogue: 0,0:25:22.25,0:25:24.35,Default,Third,0,0,0,,ربما أجيد ملاحقة "الفريسة"
Dialogue: 0,0:25:24.35,0:25:26.39,Default,Third,0,0,0,,لكن الصيد ليس من اهتماماتي.
Dialogue: 0,0:25:27.32,0:25:28.49,Default,الثالث,0,0,0,,الاضطهاد؟
Dialogue: 0,0:25:28.49,0:25:29.96,Default,الثالث,0,0,0,,كما تعلم،
Dialogue: 0,0:25:29.96,0:25:33.03,Default,Third,0,0,0,,لماذا تشارك فتيات الفناء الصغيرات في المطاردة
Dialogue: 0,0:25:33.03,0:25:34.63,Default,الثالث,0,0,0,,في يوم سلة التسوق؟
Dialogue: 0,0:25:35.63,0:25:37.96,Default,Third,0,0,0,,لا، ليس حقًا.
Dialogue: 0,0:25:42.00,0:25:45.64,Default,Third,0,0,0,,في هذا اليوم نطرد الأرواح الشريرة.
Dialogue: 0,0:25:46.17,0:25:47.91,Default,Third,0,0,0,,قبل ذلك، تم طرد الروح الشريرة
Dialogue: 0,0:25:47.91,0:25:49.61,Default,الثالث,0,0,0,,دماء القتلى.
Dialogue: 0,0:25:50.11,0:25:53.48,Default,Third,0,0,0,,لكننا بدلاً من ذلك نصطاد الحيوانات.
Dialogue: 0,0:26:02.52,0:26:06.13,Default,Third,0,0,0,,في الواقع تم العثور على جثة في بئر القصر.
Dialogue: 0,0:26:06.73,0:26:08.84,Default,Third,0,0,0,,يقال أن سيدة البلاط هذه\Nخدمت المحظية "تشو".
Dialogue: 0,0:26:09.53,0:26:10.63,Default,الثالث,0,0,0,,في البئر؟
Dialogue: 0,0:26:12.36,0:26:13.90,Default,الثالث,0,0,0,,كيف؟
Dialogue: 0,0:26:15.33,0:26:16.37,Default,Third,0,0,0,,جلالتك.
Dialogue: 0,0:26:16.37,0:26:18.20,Default,Third,0,0,0,,-تعالوا إلينا.\N-تعالوا إلينا.
Dialogue: 0,0:26:18.67,0:26:19.91,Default,الثالث,0,0,0,,حسنًا.
Dialogue: 0,0:26:26.75,0:26:29.11,Default,Third,0,0,0,,-واو.\N-لا يصدق.
Dialogue: 0,0:26:29.58,0:26:31.95,Default,Third,0,0,0,,صاحبة الجلالة سيدة.
Dialogue: 0,0:26:35.02,0:26:36.32,Default,الثالث,0,0,0,,ثلاثي أكسل.
Dialogue: 0,0:26:49.51,0:26:52.41,Default,Third,0,0,0,,لا أستطيع النوم والتقلب.
Dialogue: 0,0:26:55.88,0:26:58.09,Default,Third,0,0,0,,ربما يجب أن أكتب رسالة إلى محظياتي العزيزات؟
Dialogue: 0,0:27:01.39,0:27:03.13,Default,Third,0,0,0,,ماذا يجب أن أكتب؟
Dialogue: 0,0:27:04.06,0:27:08.13,Default,Third,0,0,0,,البداية البسيطة لا تلزمك بشيء، بل تثير المشاعر.
Dialogue: 0,0:27:09.40,0:27:10.47,Default,الثالث,0,0,0,,بالضبط.
Dialogue: 0,0:27:32.19,0:27:34.12,Default,Third,0,0,0,,أوصلها لهم.
Dialogue: 0,0:27:34.72,0:27:35.76,Default,الثالث,0,0,0,,نعم.
Dialogue: 0,0:27:36.39,0:27:37.39,Default,الثالثة,0,0,0,,انتظر لحظة.
Dialogue: 0,0:27:38.06,0:27:40.76,Default,Third,0,0,0,,أجل أن تبقي عينيك مفتوحتين لترى إن كان الملك سيظهر.
Dialogue: 0,0:27:41.50,0:27:42.53,Default,الثالث,0,0,0,,نعم.
Dialogue: 0,0:27:47.14,0:27:49.14,Default,الثالثة,0,0,0,,رسالة واحدة لكل زوج.
Dialogue: 0,0:27:49.14,0:27:50.97,Default,Third,0,0,0,,-وتحقق من مكان الملك.\N-وتحقق من مكان الملك.
Dialogue: 0,0:27:50.97,0:27:52.71,Default,Third,0,0,0,,رسالة واحدة للزوج.
Dialogue: 0,0:27:52.71,0:27:54.14,Default,Third,0,0,0,,وتحقق من مكان الملك.
Dialogue: 0,0:27:59.25,0:28:00.38,Default,الثالث,0,0,0,,لك.
Dialogue: 0,0:28:03.05,0:28:04.59,Default,الثالث,0,0,0,, تفضل بالدخول.
Dialogue: 0,0:28:05.42,0:28:07.22,Default,Third,0,0,0,,رسالة واحدة للملك.
Dialogue: 0,0:28:07.22,0:28:08.99,Default,Third,0,0,0,,وتحقق من مكان الزوجين.
Dialogue: 0,0:28:08.99,0:28:10.06,Default,الثالث,0,0,0,,ماذا؟
Dialogue: 0,0:28:10.06,0:28:12.06,Default,Third,0,0,0,,-رسالة واحدة للملك.\N-لقد تغير شيء ما.
Dialogue: 0,0:28:12.06,0:28:13.86,Default,Third,0,0,0,,وتحقق من مكان الزوجين.
Dialogue: 0,0:28:19.13,0:28:20.44,Default,Third,0,0,0,"هل أنت نائم؟"
Dialogue: 0,0:28:21.17,0:28:22.30,Default,Third,0,0,0,,هل أنت نائم؟
Dialogue: 0,0:28:24.14,0:28:25.21,Default,الثالث,0,0,0,,حسناً...
Dialogue: 0,0:28:29.01,0:28:30.05,Default,Third,0,0,0,"هل أنت نائم؟"
Dialogue: 0,0:28:36.22,0:28:37.32,Default,Third,0,0,0,"هل أنت نائم؟"
Dialogue: 0,0:28:40.89,0:28:44.43,Default,Third,0,0,0,,لماذا هي مهتمة للغاية بمعرفة ما إذا كنت نائماً أم لا؟
Dialogue: 0,0:28:45.33,0:28:46.93,Default,Third,0,0,0,,سألت ثلاث مرات.
Dialogue: 0,0:28:53.34,0:28:54.80,Default,Third,0,0,0,,لقد وصل الجواب.
Dialogue: 0,0:28:55.64,0:28:58.64,Default,Third,0,0,0,,أرسلت 3، لماذا هناك إجابة واحدة فقط؟
Dialogue: 0,0:29:00.41,0:29:02.64,Default,Third,0,0,0,,هل يكتبون لي روايات هناك؟
Dialogue: 0,0:29:06.95,0:29:09.38,Default,Third,0,0,0,,حسناً، دعونا نرى.
Dialogue: 0,0:29:11.29,0:29:14.39,Default,Third,0,0,0,,يا لها من خط جميل.\Nهذا ما يعنيه أن تكون من عائلة جيدة.
Dialogue: 0,0:29:17.03,0:29:19.66,Default,Third,0,0,0,,في ليلة بلا نوم أمشي.
Dialogue: 0,0:29:20.93,0:29:24.07,Default,Third,0,0,0,,ينكسر الضوء عبر سماء الليل المظلمة.
Dialogue: 0,0:29:25.03,0:29:28.74,Default,Third,0,0,0,,أرفع رأسي - ربما هو القمر؟\NNo، هذا صديقي العزيز.
Dialogue: 0,0:29:30.74,0:29:32.91,Default,Third,0,0,0,,عار إسباني.\Nلكنه يمس الروح.
Dialogue: 0,0:29:33.64,0:29:35.64,Default,Third,0,0,0,,ويجب علينا أيضاً...
Dialogue: 0,0:30:00.54,0:30:02.30,Default,Third,0,0,0,,-حضرة يونغ.\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:30:03.54,0:30:05.87,Default,Third,0,0,0,,هذا هو الجواب. تسليمها إلى مرسل تلك الرسالة.
Dialogue: 0,0:30:06.48,0:30:09.11,Default,Third,0,0,0,,أفكر في أشياء كثيرة.
Dialogue: 0,0:30:09.11,0:30:11.21,Default,Third,0,0,0,,بقلب سعيد أغرق في أفكارك.
Dialogue: 0,0:30:11.21,0:30:13.92,Default,Third,0,0,0,,من فضلك صف لي.
Dialogue: 0,0:30:14.52,0:30:18.99,Default,Third,0,0,0,,لم أترك أفكاري عنك.
Dialogue: 0,0:30:21.86,0:30:22.96,Default,الثالثة,0,0,0,,ملكتي.
Dialogue: 0,0:30:28.23,0:30:30.47,Default,Third,0,0,0,,لذا أصبحت المعرفة من الدورة التمهيدية مفيدة.
Dialogue: 0,0:30:30.93,0:30:34.00,Default,Third,0,0,0,,رائع، هكذا سأستعيد رجولتي.
Dialogue: 0,0:30:36.14,0:30:37.21,Default,الثالث,0,0,0,,حسناً.
Dialogue: 0,0:31:25.95,0:31:27.39,Default,Third,0,0,0,,اتبع نفس الوصفة،
Dialogue: 0,0:31:27.89,0:31:29.73,Default,Third,0,0,0,,ولكن من الأفضل استبدال المتذمر
Dialogue: 0,0:31:31.16,0:31:32.23,Default,الثالث,0,0,0,,للسمك.
Dialogue: 0,0:31:32.23,0:31:33.23,Default,الثالث,0,0,0,,
Dialogue: 0,0:31:35.26,0:31:38.23,Default,Third,0,0,0,,هل حصلت على بعض الإلهام لقصائدك ورسائلك؟
Dialogue: 0,0:31:38.90,0:31:40.04,Default,الثالثة,0,0,0,,ملكتي.
Dialogue: 0,0:31:40.60,0:31:41.70,Default,Third,0,0,0,,يا إلهي.
Dialogue: 0,0:31:42.07,0:31:43.14,Default,الثالثة,0,0,0,,الملكة.
Dialogue: 0,0:31:43.81,0:31:45.64,Default,الثالث,0,0,0,,أنت! قلت لك لا يمكنك المجيء إلى هنا.
Dialogue: 0,0:31:46.14,0:31:47.24,Default,الثالث,0,0,0,,لكن...
Dialogue: 0,0:31:47.38,0:31:48.74,Default,Third,0,0,0,,تصرفت وكأننا زوجين،
Dialogue: 0,0:31:48.74,0:31:50.65,Default,Third,0,0,0,,لأنه كان حدثاً رسمياً.
Dialogue: 0,0:31:50.65,0:31:53.02,Default,Third,0,0,0,,بالنسبة لي الآن من المهم جدًا أن أجد نفسي مرة أخرى.
Dialogue: 0,0:31:53.02,0:31:54.12,Default,Third,0,0,0,,أرجو عدم التدخل.
Dialogue: 0,0:31:54.62,0:31:55.62,Default,الثالث,0,0,0,,وقح.
Dialogue: 0,0:31:55.62,0:31:56.65,Default,Third,0,0,0,,ما هذا.
Dialogue: 0,0:31:58.49,0:32:00.22,Default,Third,0,0,0,,كيف يمكنها أن تتحول هكذا؟
Dialogue: 0,0:32:02.62,0:32:04.73,Default,Third,0,0,0,,الملكة أكثر خجلاً مما تبدو.
Dialogue: 0,0:32:09.90,0:32:11.80,Default,Third,0,0,0,,قائمة أطباق الحفل جاهزة.
Dialogue: 0,0:32:12.67,0:32:13.77,Default,الثالث,0,0,0,,عمل جميل.
Dialogue: 0,0:32:15.77,0:32:18.57,Default,Third,0,0,0,,هل راجعت قائمة القرابين الخاصة بالحفل؟
Dialogue: 0,0:32:18.94,0:32:20.48,Default,Third,0,0,0,,هذه هي القائمة.
Dialogue: 0,0:32:20.48,0:32:22.41,Default,Third,0,0,0,,لماذا يقولون جميعاً "عظماً"؟
Dialogue: 0,0:32:23.71,0:32:26.95,Default,Third,0,0,0,,قائمة الأطباق هي القائمة.
Dialogue: 0,0:32:27.18,0:32:30.29,Default,Third,0,0,0,,قائمة القرابين هي قائمة الأشياء الخاصة بالطقوس.
Dialogue: 0,0:32:30.85,0:32:32.15,Default,Third,0,0,0,,ما خطبك يا صاحب الجلالة؟
Dialogue: 0,0:32:32.25,0:32:34.39,Default,الثالث,0,0,0,,حقاً؟ فهل أنا منحرف أصم؟
Dialogue: 0,0:32:37.56,0:32:39.29,Default,Third,0,0,0,,جلالتك!
Dialogue: 0,0:32:43.30,0:32:45.27,Default,Third,0,0,0,,أنت تعمل كثيراً.
Dialogue: 0,0:32:45.27,0:32:47.87,Default,Third,0,0,0,,اذهب وارتاح يا صاحب الجلالة.
Dialogue: 0,0:32:48.64,0:32:49.77,Default,الثالث,0,0,0,,لا.
Dialogue: 0,0:32:50.71,0:32:52.27,Default,Third,0,0,0,,ليس هناك وقت. دعونا نستمر.
Dialogue: 0,0:32:54.48,0:32:55.74,Default,Third,0,0,0,,كدت أشعر بالأسف عليه.
Dialogue: 0,0:32:56.81,0:32:58.91,Default,Third,0,0,0,,ليس الهدف. اليوم سأكتب رسالة بغضب أكبر.
Dialogue: 0,0:32:59.55,0:33:01.02,Default,Third,0,0,0,,بونر كلمة خطيرة بحسب فرويد.
Dialogue: 0,0:33:01.02,0:33:03.15,Default,Third,0,0,0,,من الواضح أن نزيف أنفه ليس بسبب العمل.
Dialogue: 0,0:33:07.32,0:33:09.96,Default,Third,0,0,0,,واسمك على شفتي سأموت!
Dialogue: 0,0:33:10.29,0:33:13.33,Default,Third,0,0,0,,سيبقى في ذاكرتي - لا تنساه.
Dialogue: 0,0:33:15.00,0:33:17.07,Default,Third,0,0,0,,كيف يمكنها أن تكون ليلة وأخرى في النهار؟
Dialogue: 0,0:33:17.73,0:33:20.34,Default,Third,0,0,0,,لا أستطيع أن أقرر ما إذا كنت سأسامحني أم لا
Dialogue: 0,0:33:20.34,0:33:21.90,Default,الثالث,0,0,0,,أم لا؟
Dialogue: 0,0:33:30.65,0:33:33.15,Default,Third,0,0,0,,لست آسفاً على قلبي المكسور.
Dialogue: 0,0:33:33.85,0:33:36.32,Default,Third,0,0,0,,هل هناك طريق يمكننا أن نسير فيه معاً؟
Dialogue: 0,0:33:44.63,0:33:48.20,Default,Third,0,0,0,,آمل أن نتبعه في المرة القادمة من البداية.
Dialogue: 0,0:33:48.63,0:33:51.20,Default,Third,0,0,0,,حتى في الأحلام.
Dialogue: 0,0:34:06.48,0:34:08.22,Default,الثالث,0,0,0,,التدرب على السيف ليلاً؟
Dialogue: 0,0:34:08.45,0:34:10.32,Default,Third,0,0,0,,شخص واحد غير طبيعي يكفينا.
Dialogue: 0,0:34:10.32,0:34:12.65,Default,Third,0,0,0,,علينا أن نستعد للمعركة في العطلة.
Dialogue: 0,0:34:13.12,0:34:14.96,Default,Third,0,0,0,,حسناً، تدرب إذن مع شخص من "سيسكني".
Dialogue: 0,0:34:17.49,0:34:20.60,Default,Third,0,0,0,,كيف تقيم مهاراتك في السيف؟
Dialogue: 0,0:34:20.80,0:34:21.96,Default,Third,0,0,0,,لا أعرف.
Dialogue: 0,0:34:22.10,0:34:24.27,Default,Third,0,0,0,,لم أبذل قصارى جهدي قط.
Dialogue: 0,0:34:25.80,0:34:27.50,Default,Third,0,0,0,,لهذا السبب أحتاجك.
Dialogue: 0,0:34:28.34,0:34:30.17,Default,Third,0,0,0,,عدو لا أعرف قوته.
Dialogue: 0,0:35:04.34,0:35:07.34,Default,الثالث,0,0,0,,يوم العربة
Dialogue: 0,0:35:07.44,0:35:08.94,Default,الثالث,0,0,0,,عمر طويل ونتمنى لك التوفيق
Dialogue: 0,0:35:14.68,0:35:17.72,Default,الثالث,0,0,0,,
Dialogue: 0,0:35:29.83,0:35:31.53,Default,Third,0,0,0,,الطقس جيد يا صاحب الجلالة.
Dialogue: 0,0:35:31.53,0:35:32.97,Default,الثالث,0,0,0,,حقاً؟ هذا جيد.
Dialogue: 0,0:35:32.97,0:35:35.43,Default,Third,0,0,0,,أكره هطول المطر في أيام المباريات الرياضية.
Dialogue: 0,0:35:38.24,0:35:41.11,Default,الرابع,0,0,0,,سيأتي والدي. لذلك، عليك أن تكون أكثر أناقة.
Dialogue: 0,0:35:41.28,0:35:44.05,Default,4,0,0,0,,هذا هو اليوم الأول الذي سأظهر فيه أمام الجميع.
Dialogue: 0,0:35:44.05,0:35:45.48,Default,الرابع,0,0,0,,انتبه أكثر.
Dialogue: 0,0:35:49.22,0:35:50.92,Default,الرابع,0,0,0,,نعم. أنا جميلة.
Dialogue: 0,0:35:52.02,0:35:53.42,Default,4,0,0,0,,الجميع سوف يحدقون بي، أليس كذلك؟
Dialogue: 0,0:36:06.27,0:36:09.24,Default,4,0,0,0,,هل ستستخدم نصائح\Nmetal؟
Dialogue: 0,0:36:10.41,0:36:11.54,Default,الرابع,0,0,0,,اليوم أحتاج
Dialogue: 0,0:36:15.48,0:36:16.88,Default,الرابع,0,0,0,,امسك بحيوان كبير.
Dialogue: 0,0:36:20.25,0:36:22.25,Default,4,0,0,0,,حسنًا، علينا تسليم هذا بسرعة.
Dialogue: 0,0:36:22.25,0:36:23.65,Default,الرابع,0,0,0,,تحرك.
Dialogue: 0,0:36:26.02,0:36:27.42,Default,الرابع,0,0,0,,مرحباً يا سيدي.
Dialogue: 0,0:36:27.62,0:36:31.09,Default,4,0,0,0,,لدينا طعام طازج للوليمة على شرف يوم العربة
Dialogue: 0,0:36:31.09,0:36:32.96,Default,الرابع,0,0,0,,والعروض الملكية.
Dialogue: 0,0:36:33.13,0:36:36.03,Default,4,0,0,0,,علينا أن نسرع ​​إلى القصر. آسف.
Dialogue: 0,0:36:36.53,0:36:38.90,Default,4,0,0,0,,-هل لديك مستندات لهم؟\N-بالطبع.
Dialogue: 0,0:36:39.73,0:36:40.84,Default,الرابع,0,0,0,,هنا.
Dialogue: 0,0:37:17.01,0:37:18.81,Default,4,0,0,0,,حان وقت تغيير الملابس يا صاحب الجلالة.
Dialogue: 0,0:37:19.71,0:37:20.71,Default,الرابع,0,0,0,,انتظر قليلاً.
Dialogue: 0,0:37:22.14,0:37:24.05,Default,4,0,0,0,,اليوم يوم مهم جداً.
Dialogue: 0,0:37:24.78,0:37:28.42,Default,4,0,0,0,,علينا على الأقل أن نحاول التنبؤ بمصير هؤلاء الأشخاص.
Dialogue: 0,0:37:30.89,0:37:35.09,Default,الرابع,0,0,0,,حسناً، دعونا نرى. خريطة لعشيرة تشو.
Dialogue: 0,0:37:44.97,0:37:46.20,Default,Fourth,0,0,0,,Thojang هي البطاقة الأدنى في لعبة Thujong.
Dialogue: 0,0:37:46.20,0:37:47.60,Default,الرابع,0,0,0,,بطاقة الأرنب.
Dialogue: 0,0:37:53.34,0:37:57.01,Default,4,0,0,0,,حسناً، الحظ شيء نسبي.
Dialogue: 0,0:37:58.31,0:38:02.58,Default,الرابع,0,0,0,,هيا. بطاقة لملكنا.
Dialogue: 0,0:38:09.36,0:38:10.43,Default,الرابع,0,0,0,,ماذا؟
Dialogue: 0,0:38:17.37,0:38:19.93,Default,الرابع,0,0,0,"إنجيونغ." البطاقة التاسعة.
Dialogue: 0,0:38:20.44,0:38:21.74,Default,4,0,0,0,,هل سينقلب كل شيء في الاتجاه المعاكس؟
Dialogue: 0,0:38:26.07,0:38:27.71,Default,الرابع,0,0,0,,والآن بطاقة الملكة.
Dialogue: 0,0:38:36.58,0:38:37.75,Default,الرابع,0,0,0,,التنين؟
Dialogue: 0,0:38:39.49,0:38:41.49,Default,الرابعة,0,0,0,,أوجان، البطاقة الثامنة.
Dialogue: 0,0:38:44.76,0:38:47.43,Default,رابع,0,0,0,,أنا أكره قراءة ثروتي اليوم.
Dialogue: 0,0:38:54.20,0:38:55.94,Default,الرابع,0,0,0,,الملكة
Dialogue: 0,0:38:56.87,0:39:01.14,Default,الرابع,0,0,0,,هل تريد شيئًا آخر؟
Dialogue: 0,0:39:02.98,0:39:04.65,Default,الرابع,0,0,0,,لقد وصلت الملكة الأم.
Dialogue: 0,0:39:05.15,0:39:08.32,Default,4,0,0,0,,يمكنك أن تبلغنا مسبقاً أنك ستزورنا.
Dialogue: 0,0:39:08.32,0:39:11.05,Default,4,0,0,0,,أنت حتى لا تخفي كراهيتك لي.
Dialogue: 0,0:39:11.52,0:39:14.09,Default,4,0,0,0,,عندما كنت ملكة، لم يُسمع عن مثل هذا السلوك\N.
Dialogue: 0,0:39:14.52,0:39:15.66,Default,الرابع,0,0,0,,بغض النظر عن العصر
Dialogue: 0,0:39:15.66,0:39:18.63,Default,4,0,0,0,,لا تريد زوجة ابن أن تتفاجأ بحماتها.
Dialogue: 0,0:39:18.63,0:39:20.93,Default,4,0,0,0,,حسناً، أنظر إليها، لقد انفجرت في وجهي.
Dialogue: 0,0:39:23.06,0:39:27.14,Default,4,0,0,0,,سمعت أنك تطبخ للملكة الأرملة.
Dialogue: 0,0:39:27.74,0:39:31.54,Default,4,0,0,0,,ولم تقدم لي وجبة خفيفة حتى.
Dialogue: 0,0:39:32.24,0:39:33.51,Default,الرابع,0,0,0,,لا بد أنك خائف
Dialogue: 0,0:39:33.51,0:39:36.41,Default,الرابع,0,0,0,,جدة زوجي أكبر مني.
Dialogue: 0,0:39:37.11,0:39:39.18,Default,4,0,0,0,,ماذا تقول، الأمر ليس كذلك.
Dialogue: 0,0:39:39.18,0:39:42.42,Default,4,0,0,0,,الملكة الأرملة تعتني بنفسها جيداً،
Dialogue: 0,0:39:42.42,0:39:43.72,Default,4,0,0,0,,يبدو شاباً.
Dialogue: 0,0:39:44.19,0:39:46.39,Default,الرابع,0,0,0,,لا يمكنك خداع الوقت.
Dialogue: 0,0:39:47.79,0:39:49.46,Default,4,0,0,0,,عليك أن تفكر ملياً.
Dialogue: 0,0:39:49.89,0:39:52.99,Default,4,0,0,0,,سأعيش أطول من الملكة الأرملة.
Dialogue: 0,0:39:56.66,0:39:58.47,Default,4,0,0,0,,سأقدم لك طعامي يوماً ما.
Dialogue: 0,0:39:58.47,0:40:00.07,Default,4,0,0,0,,يجب أن أحاول ذلك الآن.
Dialogue: 0,0:40:00.90,0:40:04.87,Default,4,0,0,0,,أنا فضولي جداً بشأن طبخك،\N الذي سمعت عنه فقط.
Dialogue: 0,0:40:04.87,0:40:07.04,Default,الرابع,0,0,0,,لا قوة للانتظار.
Dialogue: 0,0:40:08.24,0:40:10.81,Default,الرابع,0,0,0,,الآن؟
Dialogue: 0,0:40:11.71,0:40:14.65,Default,4,0,0,0,,فهل بدأ اضطهادي من قبل حماتي؟
Dialogue: 0,0:40:29.50,0:40:31.37,Default,4,0,0,0,,اللعنة، هذا مثير للغضب.
Dialogue: 0,0:40:35.87,0:40:39.41,Default,4,0,0,0,,أين تختبئ؟
Dialogue: 0,0:40:42.51,0:40:44.11,Default,الرابع,0,0,0,,الشيف الملكي. أحتاج إلى شراب الذرة.
Dialogue: 0,0:40:44.11,0:40:47.28,Default,4,0,0,0,,وماذا أفعل في مأدبة بدون طعام طازج؟
Dialogue: 0,0:40:47.68,0:40:50.62,Default,4,0,0,0,,جميع الحراس القريبين من العربة ماتوا.
Dialogue: 0,0:40:50.62,0:40:51.75,Default,الرابع,0,0,0,,ماذا يمكنني أن أفعل؟
Dialogue: 0,0:40:51.75,0:40:54.19,Default,الرابع,0,0,0,,يا إلهي. تعال.
Dialogue: 0,0:40:55.62,0:40:57.83,Default,الرابع,0,0,0,,-سمك مجفف.\N-ماذا؟
Dialogue: 0,0:40:58.23,0:41:01.16,Default,الرابع,0,0,0,,سمك مجفف. السمك المجفف!
Dialogue: 0,0:41:03.80,0:41:06.07,Default,4,0,0,0,,الشيف الملكي مشغول جداً.
Dialogue: 0,0:41:06.47,0:41:08.10,Default,رابع,0,0,0,,لا أستطيع أن آمره.
Dialogue: 0,0:41:10.54,0:41:12.57,Default,4,0,0,0,,أين شراب الحبوب؟
Dialogue: 0,0:41:29.79,0:41:32.23,Default,4,0,0,0,,في ليلة بلا نوم أمشي.
Dialogue: 0,0:41:32.83,0:41:34.50,Default,4,0,0,0,"في ليلة بلا نوم أمشي"
Dialogue: 0,0:41:34.90,0:41:37.53,Default,الرابع,0,0,0,,الشيف الملكي! الشيف الملكي!
Dialogue: 0,0:41:37.53,0:41:39.80,Default,4,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:41:39.80,0:41:41.00,Default,الرابع,0,0,0,,ماذا حدث؟
Dialogue: 0,0:41:42.94,0:41:44.01,Default,الرابع,0,0,0,,جلالتك.
Dialogue: 0,0:41:57.52,0:42:02.42,Default,الرابع,0,0,0,,هذه منتجات قيمة. الجميع فاسد!
Dialogue: 0,0:42:02.66,0:42:04.63,Default,4,0,0,0,,ربما تم تخزينها بشكل غير صحيح.
Dialogue: 0,0:42:05.03,0:42:08.30,Default,رابع,0,0,0,,أنا أستحق أن أموت يا صاحب الجلالة.
Dialogue: 0,0:42:09.20,0:42:10.50,Default,الرابع,0,0,0,,هذا لا يمكن أن يكون.
Dialogue: 0,0:42:11.23,0:42:14.64,Default,4,0,0,0,,لم يكن أحد ليدمرهم،\N لو تم ضمان سلامتهم.
Dialogue: 0,0:42:17.51,0:42:18.54,Default,الرابع,0,0,0,,الشيف الملكي!
Dialogue: 0,0:42:19.51,0:42:20.51,Default,الرابع,0,0,0,,جلالتك.
Dialogue: 0,0:42:21.14,0:42:22.18,Default,الرابع,0,0,0,,لدينا مشاكل.
Dialogue: 0,0:42:22.18,0:42:24.28,Default,4,0,0,0,,أضاف أحدهم الحجارة إلى الأرز.
Dialogue: 0,0:42:24.51,0:42:27.32,Default,4,0,0,0,,-ماذا؟\N- لن نتمكن من إرسال أي شيء.
Dialogue: 0,0:42:29.38,0:42:32.09,Default,الرابع,0,0,0,,لا تقلق. افعل كل ما بوسعك من جانبك.
Dialogue: 0,0:42:32.85,0:42:36.52,Default,4,0,0,0,,سأبذل قصارى جهدي للحصول على تلك المنتجات.
Dialogue: 0,0:42:38.99,0:42:40.03,Default,الرابع,0,0,0,,نعم.
Dialogue: 0,0:42:49.24,0:42:51.47,Default,4,0,0,0,,يا إلهي، ماذا تفعل؟
Dialogue: 0,0:42:52.51,0:42:55.21,Default,الرابع,0,0,0,,الشيف الملكي! يا!
Dialogue: 0,0:42:55.48,0:42:58.98,Default,4,0,0,0,,أريد أن أريها كيف أحمل الطعام بنفسي.
Dialogue: 0,0:42:59.41,0:43:01.55,Default,4,0,0,0,,هذا سيجعلها تشعر بتحسن، أليس كذلك؟
Dialogue: 0,0:43:10.22,0:43:12.46,Default,4,0,0,0,,مزيج الشراب الحلو والملح يجعلها لذيذة
Dialogue: 0,0:43:12.46,0:43:13.83,Default,الرابع,0,0,0,,طبق حلو ومالح مثالي.
Dialogue: 0,0:43:24.64,0:43:32.51,Default,4,0,0,0,,هناك أرى جبلاً جميلاً...
Dialogue: 0,0:43:44.53,0:43:45.73,Default,الرابع,0,0,0,,المدير هان؟
Dialogue: 0,0:43:47.50,0:43:48.50,Default,الرابع,0,0,0,,أيها الوغد!
Dialogue: 0,0:43:49.50,0:43:50.50,Default,الرابع,0,0,0,,كيف يمكنك ذلك؟
Dialogue: 0,0:44:06.38,0:44:09.88,Default,الرابع,0,0,0,,الفشار الخاص بي!
Dialogue: 0,0:44:13.05,0:44:14.12,Default,الرابع,0,0,0,,اللعنة!
Dialogue: 0,0:44:17.49,0:44:19.13,Default,4,0,0,0,,يا له من لقيط!
Dialogue: 0,0:44:38.18,0:44:40.11,Default,الرابع,0,0,0,,أين المكافأة؟
Dialogue: 0,0:44:40.48,0:44:41.68,Default,الرابع,0,0,0,,حسناً...
Dialogue: 0,0:44:51.69,0:44:52.76,Default,الرابع,0,0,0,,هنا.
Dialogue: 0,0:44:56.13,0:44:58.67,Default,4,0,0,0,,تطلع إلى حياتك في القصر.
Dialogue: 0,0:45:08.34,0:45:09.61,Default,الرابع,0,0,0,,بالنظر إلى ما يحدث،
Dialogue: 0,0:45:09.61,0:45:11.28,Default,الرابع,0,0,0,,يجب أن تحصل على الطعام،
Dialogue: 0,0:45:11.28,0:45:13.41,Default,الرابع,0,0,0,,بمجرد الانتهاء من الفنون القتالية.
Dialogue: 0,0:45:13.95,0:45:14.95,Default,الرابع,0,0,0,,نعم.
Dialogue: 0,0:45:23.09,0:45:26.69,Default,4,0,0,0,,شكرًا لدعوتنا إلى المأدبة.
Dialogue: 0,0:45:27.90,0:45:29.90,Default,الرابع,0,0,0,,أنت تستحق أن تكون هنا.
Dialogue: 0,0:45:30.97,0:45:32.83,Default,4,0,0,0,,المحظيات في حالة جيدة.
Dialogue: 0,0:45:33.50,0:45:35.20,Default,4,0,0,0,,آمل أن تكون أنت أيضاً على ما يرام.
Dialogue: 0,0:45:35.34,0:45:36.60,Default,الرابع,0,0,0,,-نعم.\N-نعم.
Dialogue: 0,0:45:37.07,0:45:40.07,Default,4,0,0,0,,على أية حال، أتمنى لك يوماً سعيداً اليوم.
Dialogue: 0,0:46:54.85,0:46:56.58,Default,4,0,0,0,,هل وصلت الملكة الأم بعد؟
Dialogue: 0,0:46:57.12,0:46:58.62,Default,الرابع,0,0,0,,سأكتشف ذلك.
Dialogue: 0,0:47:09.33,0:47:11.90,Default,4,0,0,0,,ظننت أنك هربت.
Dialogue: 0,0:47:12.00,0:47:13.20,Default,الرابع,0,0,0,,بالطبع لا.
Dialogue: 0,0:47:13.70,0:47:17.41,Default,4,0,0,0,,إذا ارتكب شخص ما جريمة، فيجب معاقبته وفقاً لذلك.
Dialogue: 0,0:47:17.57,0:47:19.74,Default,الرابع,0,0,0,,سعيد أنك تعلم.
Dialogue: 0,0:47:21.18,0:47:23.71,Default,4,0,0,0,,أرسلت لي الملكة وجبات خفيفة هذا الصباح،
Dialogue: 0,0:47:23.71,0:47:26.58,Default,4,0,0,0,,وبدأت أستعد متأخراً لأنني جربتهم.
Dialogue: 0,0:47:27.72,0:47:28.98,Default,الرابع,0,0,0,,الملكة؟
Dialogue: 0,0:47:36.92,0:47:39.03,Default,رابع,0,0,0,,أشعر وكأنني سأموت، عالقاً بين نارين.
Dialogue: 0,0:47:44.33,0:47:46.60,Default,4,0,0,0,,هل هناك نوع من سوء الفهم مرة أخرى؟
Dialogue: 0,0:47:49.97,0:47:51.81,Default,الرابع,0,0,0,,هيا.
Dialogue: 0,0:48:26.17,0:48:29.91,Default,4,0,0,0,,أعدّ الحرس الملكي\N عرضًا للفنون القتالية.
Dialogue: 0,0:48:48.23,0:48:49.60,Default,الرابع,0,0,0,,انتباه!
Dialogue: 0,0:48:50.46,0:48:51.70,Default,الرابع,0,0,0,,الجولة الأولى.
Dialogue: 0,0:48:55.84,0:48:59.87,Default,4,0,0,0,,كيف يجرؤ على محاولة إيذاء الملكة بهذا السيف؟
Dialogue: 0,0:49:04.95,0:49:06.08,Default,الرابع,0,0,0,,المعركة.
Dialogue: 0,0:50:34.44,0:50:38.17,Default,الرابع,0,0,0,,واو. كان الملك مستعدًا جيدًا.
Dialogue: 0,0:50:54.05,0:50:58.23,Default,الرابع,0,0,0,,الملكة الأرملة. حان الوقت للصيد.
Dialogue: 0,0:51:00.49,0:51:03.30,Default,الرابع,0,0,0,,جلالتك. \NIt's حان الوقت للتغيير إلى ملابس الصيد الخاصة بك.
Dialogue: 0,0:51:08.57,0:51:10.77,Default,4,0,0,0,,سأعود أيتها الملكة الأرملة.
Dialogue: 0,0:51:12.77,0:51:14.88,Default,الرابع,0,0,0,,سأعود.
Dialogue: 0,0:52:05.59,0:52:08.53,Default,الرابع,0,0,0,,السطر الأول، جاهز للإطلاق.
Dialogue: 0,0:52:11.93,0:52:13.10,Default,الرابع,0,0,0,,نار!
Dialogue: 0,0:52:22.34,0:52:23.44,Default,الرابع,0,0,0,,نار!
Dialogue: 0,0:52:28.38,0:52:29.48,Default,الرابع,0,0,0,,نار!
Dialogue: 0,0:52:44.00,0:52:45.67,Default,4,0,0,0,,اعتقدت أنه للعرض فقط.
Dialogue: 0,0:53:09.82,0:53:12.06,Default,4,0,0,0,,الأمور هي الشيء الرئيسي.
Dialogue: 0,0:53:15.33,0:53:16.80,Default,4,0,0,0,,أعتقد أنني أبدو رائعة.
Dialogue: 0,0:53:17.03,0:53:19.53,Default,الرابع,0,0,0,,أعجبني ذلك. أنا أبدو رائعة.
Dialogue: 0,0:53:27.31,0:53:29.21,Default,Fith,0,0,0,,لماذا هي قتالية إلى هذه الدرجة؟
Dialogue: 0,0:53:29.44,0:53:32.15,Default,5,0,0,0,,هناك دائماً من يأخذ المسابقات على محمل الجد.
Dialogue: 0,0:53:33.51,0:53:34.82,Default,Fith,0,0,0,,أي نوع من المظهر هذا؟
Dialogue: 0,0:53:36.42,0:53:39.49,Default,الخامس,0,0,0,,نقطة واحدة للطائر، ونقطتان للأرنب،
Dialogue: 0,0:53:39.79,0:53:42.92,Default,الخامس,0,0,0,,للغرير - 3 نقاط، للخنزير - 4،
Dialogue: 0,0:53:43.19,0:53:46.09,Default,الخامس,0,0,0,,غزال - 5 نقاط، ذئب - 7،
Dialogue: 0,0:53:46.16,0:53:50.20,Default,الخامس,0,0,0,,الدب - 9 والنمر - 10 نقاط.
Dialogue: 0,0:53:50.20,0:53:51.23,Default,Fith,0,0,0,,الذئب، النمر، الأرنب، الغزال.
Dialogue: 0,0:53:51.23,0:53:52.97,Default,Fith,0,0,0,,سيتم منح كل واحد 10 أسهم.
Dialogue: 0,0:53:53.43,0:53:56.37,Default,Fith,0,0,0,,من أجل معركة عادلة، سيدات البلاط والخادمات
Dialogue: 0,0:53:56.37,0:53:57.67,Default,الخامس,0,0,0,,لن يشارك.
Dialogue: 0,0:53:58.61,0:54:00.21,Default,5,0,0,0,,هذا صعب.
Dialogue: 0,0:54:00.64,0:54:02.04,Default,5,0,0,0,,في الوقت الحاضر هذا من شأنه أن يجعل الناس
Dialogue: 0,0:54:02.04,0:54:03.48,Default,خامس,0,0,0,,وقع على العريضة الوطنية.
Dialogue: 0,0:54:03.91,0:54:06.65,Default,5,0,0,0,,إذن حان وقت البدء.
Dialogue: 0,0:54:17.06,0:54:19.46,Default,Fithth,0,0,0,,يمكنك المغادرة بالفعل.
Dialogue: 0,0:54:26.17,0:54:28.90,Default,Fith,0,0,0,,علينا فقط قضاء الوقت هنا والعودة.
Dialogue: 0,0:54:46.09,0:54:49.29,Default,Fith,0,0,0,,مباراة التصويب اليوم متوقعة للغاية.
Dialogue: 0,0:54:50.26,0:54:52.59,Default,Fith,0,0,0,,هذه معركة من أجل شرف العائلة،
Dialogue: 0,0:54:53.06,0:54:55.80,Default,Fith,0,0,0,,لكن الملكة لا تبدو مهتمة.
Dialogue: 0,0:54:56.03,0:54:59.63,Default,Fith,0,0,0,,لم أكن أعلم أن لديك الوقت للقلق بشأن قتال مزحة.
Dialogue: 0,0:55:00.07,0:55:03.14,Default,Fithth,0,0,0,,قد ترى ابنك اليوم.
Dialogue: 0,0:55:08.58,0:55:10.94,Default,Fithth,0,0,0,,لقد حان الوقت لتقديم هديتي.
Dialogue: 0,0:55:12.35,0:55:14.58,Default,5,0,0,0,,في تلك الليلة عندما سقطت الملكة في حالة غيبوبة،
Dialogue: 0,0:55:14.58,0:55:17.55,Default,Fith,0,0,0,,كانت المحظية الملكية والملك على وشك تقاسم السرير.
Dialogue: 0,0:55:17.95,0:55:19.95,Default,Fith,0,0,0,,لقد استيقظت الملكة
Dialogue: 0,0:55:19.95,0:55:22.66,Default,الخامس,0,0,0,,بعد يوم واحد فقط من ذلك.
Dialogue: 0,0:55:25.29,0:55:26.66,Default,5,0,0,0,,تقصد أنها تظاهرت،
Dialogue: 0,0:55:26.66,0:55:29.66,Default,خامس,0,0,0,,لإيقافهم؟
Dialogue: 0,0:55:31.23,0:55:33.97,Default,Fithth,0,0,0,,وضعت الملكة كل شيء على المحك،
Dialogue: 0,0:55:33.97,0:55:35.67,Default,خامس,0,0,0,,لكسب قلب الملك.
Dialogue: 0,0:55:36.24,0:55:37.87,Default,خامس,0,0,0,,ألقت بنفسها في البحيرة،
Dialogue: 0,0:55:37.87,0:55:40.24,Default,Fith,0,0,0,,حماية المحظية الملكية من السيف.
Dialogue: 0,0:55:40.97,0:55:43.81,Default,Fithth,0,0,0,,ضحت بآخر ما تبقى لها.
Dialogue: 0,0:55:47.05,0:55:49.88,Default,Fith,0,0,0,,رفضت الملكة عائلتها.
Dialogue: 0,0:55:59.16,0:56:02.63,Default,Fith,0,0,0,,لقد مللت وأسليتني.
Dialogue: 0,0:56:03.43,0:56:07.43,Default,Fith,0,0,0,,أقام الملك وليمة بلا سبب.
Dialogue: 0,0:56:07.87,0:56:10.04,Default,Fithth,0,0,0,,وأسرعت الملكة لأخذ المحظيات
Dialogue: 0,0:56:10.04,0:56:12.54,Default,الخامس,0,0,0,,من العائلات الأكثر نفوذاً.
Dialogue: 0,0:56:12.71,0:56:15.84,Default,Fith,0,0,0,,اخترت من يستطيع دعم الملك.
Dialogue: 0,0:56:16.64,0:56:19.78,Default,Fithth,0,0,0,,اليوم سيكشف الملك عن وجهه الحقيقي،
Dialogue: 0,0:56:19.78,0:56:22.28,Default,Fith,0,0,0,,الذي لا يزال مخفياً عن المسؤولين.
Dialogue: 0,0:56:22.62,0:56:25.09,Default,Fith,0,0,0,,وجه حاكم قوي.
Dialogue: 0,0:56:28.56,0:56:30.49,Default,Fith,0,0,0,,هل فهمت الآن؟
Dialogue: 0,0:56:31.16,0:56:33.86,Default,Fith,0,0,0,,الملكة تجتمع مع الملك.
Dialogue: 0,0:56:33.86,0:56:37.50,Default,Fith,0,0,0,,ألا تخاف على حياتك بقول هذا؟
Dialogue: 0,0:56:37.86,0:56:41.03,Default,Fithth,0,0,0,,وربما كنت تعتقد أن الملكة لن تخونك أبداً.
Dialogue: 0,0:56:42.30,0:56:44.50,Default,Fith,0,0,0,,أشعر بخيبة أمل كبيرة.
Dialogue: 0,0:56:44.91,0:56:47.21,Default,Fith,0,0,0,,سقطت بسبب حيلها الرخيصة
Dialogue: 0,0:56:47.21,0:56:48.84,Default,Fithth,0,0,0,,ويدعون أنفسهم ينخدعون.
Dialogue: 0,0:56:49.48,0:56:52.21,Default,Fithth,0,0,0,,على ما يبدو أنهم قد تقدموا في السن.
Dialogue: 0,0:56:53.98,0:56:56.38,Default,Fith,0,0,0,,سوف أقتلع هذه الشفاه الدنيئة.
Dialogue: 0,0:56:56.38,0:56:59.65,Default,Fith,0,0,0,,تظاهرت الملكة بالإغماء، فلا ذنب عليّ.
Dialogue: 0,0:56:59.65,0:57:03.46,Default,Fithth,0,0,0,,ولم يعد لدي ما أخاف منه بعد الآن!
Dialogue: 0,0:57:08.46,0:57:10.46,Default,Fith,0,0,0,,لماذا توقفت عن اللعب؟
Dialogue: 0,0:57:10.76,0:57:13.83,Default,Fithth,0,0,0,,لقد أزعجت الملكة الأرملة.
Dialogue: 0,0:57:27.75,0:57:29.15,Default,الخامس,0,0,0,,والآن
Dialogue: 0,0:57:29.15,0:57:33.45,Default,Fith,0,0,0,,سوف يمنحك الملك المعجبين.
Dialogue: 0,0:57:55.38,0:57:58.61,Default,Fithth,0,0,0,,لقد قمت بعمل رائع. أنا أتطلع إلى العيد.
Dialogue: 0,0:57:59.68,0:58:02.35,Default,Fithth,0,0,0,,لقد قمت بعمل رائع أيضاً.
Dialogue: 0,0:58:08.62,0:58:11.26,Default,Fithth,0,0,0,,لقد وصلت الملكة الأرملة.
Dialogue: 0,0:58:16.10,0:58:17.20,Default,الخامس,0,0,0,,أنت هنا.
Dialogue: 0,0:58:21.20,0:58:23.47,Default,Fith,0,0,0,,كان الأمر مملاً للغاية هناك.
Dialogue: 0,0:58:23.47,0:58:24.87,Default,خامس,0,0,0,,لم أستطع التحمل.
Dialogue: 0,0:58:26.87,0:58:29.51,Default,Fithth,0,0,0,,أتساءل عما إذا كان الوضع سيكون أفضل هنا.
Dialogue: 0,0:58:30.21,0:58:32.51,Default,خامس,0,0,0,,آسفة لأنني لم أتمكن من إرضائك.
Dialogue: 0,0:58:34.55,0:58:37.25,Default,Fithth,0,0,0,,أردت أن ألقي نظرة على الفنون القتالية، لكنني تأخرت.
Dialogue: 0,0:58:39.75,0:58:43.59,Default,Fith,0,0,0,,رغم أن مشاهدة العروض مملة أيضاً.
Dialogue: 0,0:58:45.93,0:58:49.10,Default,Fith,0,0,0,,أفضل المعارك الحقيقية.
Dialogue: 0,0:58:50.53,0:58:52.63,Default,Fithth,0,0,0,,سآمر الحرس الملكي بالتنافس مع بعضهم البعض.
Dialogue: 0,0:58:53.53,0:58:55.24,Default,Fith,0,0,0,,ماذا عن التحدث بنفسك؟
Dialogue: 0,0:58:59.44,0:59:01.58,Default,خامس,0,0,0,,سمعتك تقطع الخشب في كانغهوادو
Dialogue: 0,0:59:01.58,0:59:04.31,Default,خامس,0,0,0,,وحمل الماء بنفسه.
Dialogue: 0,0:59:05.18,0:59:08.05,Default,5,0,0,0,,مع قوة كذا وكذا لن يكون الأمر صعباً.
Dialogue: 0,0:59:11.12,0:59:13.79,Default,Fith,0,0,0,,العمل اليدوي والفنون القتالية مختلفان تمامًا.
Dialogue: 0,0:59:14.39,0:59:17.49,Default,Fith,0,0,0,,وفي السنوات الأخيرة أصبحت أجلس أكثر فأكثر على العرش.
Dialogue: 0,0:59:17.49,0:59:18.89,Default,Fith,0,0,0,,أصبح الجسد خشبياً بالكامل.
Dialogue: 0,0:59:18.89,0:59:21.26,Default,5,0,0,0,,حسناً، استخدم المروحة بدلاً من السلاح.
Dialogue: 0,0:59:24.80,0:59:27.70,Default,Fith,0,0,0,,ماذا عن المنافسة مع رئيس قسم المباحث؟
Dialogue: 0,0:59:27.70,0:59:29.20,Default,Fith,0,0,0,,أنتما في نفس العمر تقريباً.
Dialogue: 0,0:59:32.41,0:59:33.64,Default,خامس,0,0,0,,رئيس قسم المباحث -
Dialogue: 0,0:59:33.64,0:59:35.91,Default,Fith,0,0,0,,محارب محترف تدرب لسنوات.
Dialogue: 0,0:59:36.88,0:59:38.95,Default,Fith,0,0,0,,أخشى أن يتأذى الملك.
Dialogue: 0,0:59:38.95,0:59:40.35,Default,5,0,0,0,,إذا كنت تريد رؤية القتال، سأدعو...
Dialogue: 0,0:59:40.35,0:59:43.22,Default,Fithth,0,0,0,,أريد رؤية الملك يقاتل.
Dialogue: 0,0:59:48.92,0:59:50.26,Default,الخامس,0,0,0,,ماذا تقول؟
Dialogue: 0,0:59:53.39,0:59:55.40,Default,Fith,0,0,0,,كان أبي مخطئاً.
Dialogue: 0,0:59:57.03,1:00:00.93,Default,Fithth,0,0,0,,يرجى رؤية وجهه الحقيقي في Cart Day.
Dialogue: 0,1:00:11.81,1:00:13.21,Default,الخامس,0,0,0,,غزال.
Dialogue: 0,1:00:21.42,1:00:22.46,Default,الخامس,0,0,0,,كيف ذلك؟
Dialogue: 0,1:00:23.62,1:00:24.66,Default,الخامس,0,0,0,,الدب.
Dialogue: 0,1:00:54.02,1:00:55.16,Default,الخامس,0,0,0,,انطلق.
Dialogue: 0,1:00:55.16,1:00:57.32,Default,Fithth,0,0,0,,أنت لست الفريسة التي أبحث عنها.
Dialogue: 0,1:01:10.97,1:01:12.11,Default,5,0,0,0,,هل ذهبت إلى المكان الخطأ؟
Dialogue: 0,1:01:16.08,1:01:17.64,Default,Fithth,0,0,0,,يبدو أنني رأيت هذه الشجرة بالفعل.
Dialogue: 0,1:01:19.75,1:01:21.68,Default,Fith,0,0,0,,وأين يجب أن أذهب؟
Dialogue: 0,1:01:25.82,1:01:27.52,Default,Fithth,0,0,0,,سيكون لدينا معجبين بين أيدينا.
Dialogue: 0,1:01:27.89,1:01:30.72,Default,Fith,0,0,0,,الشخص الذي يأخذ المروحة من الخصم هو الفائز.
Dialogue: 0,1:01:34.19,1:01:35.53,Default,الخامس,0,0,0,,سهل.
Dialogue: 0,1:02:04.19,1:02:06.36,Default,5,0,0,0,,ماذا يحدث؟
Dialogue: 0,1:02:08.19,1:02:10.06,Default,خامس,0,0,0,,قلت، خذ الأمر ببساطة.
Dialogue: 0,1:02:11.16,1:02:13.73,Default,Fithth,0,0,0,,كيف سيكون رد فعلك إذا جرحت الملك؟
Dialogue: 0,1:02:15.70,1:02:18.31,Default,Fithth,0,0,0,,هذا هو أمر الملكة الأرملة.
Dialogue: 0,1:02:18.31,1:02:20.07,Default,Fith,0,0,0,,لم يبق شيء لفعله سوى إكماله.
Dialogue: 0,1:02:25.11,1:02:28.11,Default,Fithth,0,0,0,,لذا فإن الملكة الأرملة خلفك.
Dialogue: 0,1:02:32.69,1:02:35.22,Default,5,0,0,0,,لذا يجب أن ألقنك درساً.
Dialogue: 0,1:02:35.22,1:02:37.32,Default,خامس,0,0,0,,سأريك من هو الرئيس في القصر.
Dialogue: 0,1:03:00.78,1:03:02.42,Default,Fith,0,0,0,,قلت أنه مختلف عن الملك الراحل.
Dialogue: 0,1:03:02.98,1:03:04.58,Default,5,0,0,0,,والحقيقة مختلفة.
Dialogue: 0,1:03:08.79,1:03:10.42,Default,5,0,0,0,,حسناً، حسناً.
Dialogue: 0,1:03:10.42,1:03:13.13,Default,Fithth,0,0,0,,أحتاج إلى أخذ قيلولة. سوف يجدونني عندما ينتهي كل شيء.
Dialogue: 0,1:03:16.26,1:03:17.36,Default,5,0,0,0,,اللعنة، لقد أخافتك!
Dialogue: 0,1:03:19.07,1:03:20.23,Default,Fith,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,1:03:22.04,1:03:25.14,Default,5,0,0,0,,ما رأيك؟ أنا أختبئ من أجل البقاء.
Dialogue: 0,1:03:25.71,1:03:28.17,Default,Fith,0,0,0,,حسناً، لن تموت حقاً. لماذا أنت خائف جدا؟
Dialogue: 0,1:03:28.41,1:03:32.31,Default,5,0,0,0,,أعلم، لكن الأسهم ما زالت تؤلمني.
Dialogue: 0,1:03:32.91,1:03:34.95,Default,Fith,0,0,0,,مازلت أعاني من كدمات من العام الماضي.
Dialogue: 0,1:03:34.95,1:03:36.12,Default,5,0,0,0,,يا له من متذمر.
Dialogue: 0,1:03:37.78,1:03:39.85,Default,Fith,0,0,0,,لا تخف، فالصيد لا يغريني.
Dialogue: 0,1:03:40.45,1:03:43.86,Default,Fithth,0,0,0,,حسناً، سيضربني الآخرون.
Dialogue: 0,1:03:55.50,1:03:56.87,Default,الخامس,0,0,0,,هنا.
Dialogue: 0,1:03:57.20,1:03:59.31,Default,5,0,0,0,,كيف تمكنت من العودة بهذه الطريقة؟
Dialogue: 0,1:04:00.44,1:04:01.47,Default,الخامس,0,0,0,,النمر.
Dialogue: 0,1:04:06.88,1:04:07.95,Default,الخامس,0,0,0,,إذن؟
Dialogue: 0,1:04:08.88,1:04:11.62,Default,5,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,1:04:11.62,1:04:12.89,Default,خامس,0,0,0,,احتفظ بالتذكار.
Dialogue: 0,1:04:14.12,1:04:15.22,Default,الخامس,0,0,0,,انطلق.
Dialogue: 0,1:04:17.19,1:04:18.96,Default,الخامس,0,0,0,,بالفعل؟
Dialogue: 0,1:04:20.83,1:04:22.60,Default,5,0,0,0,,لم أكن أعلم أن الملكة جيدة جدًا في التصويب،
Dialogue: 0,1:04:22.60,1:04:25.30,Default,خامس,0,0,0,,لضرب النمر بهذه السرعة.
Dialogue: 0,1:04:25.30,1:04:27.57,Default,5,0,0,0,,نعم، هي رامية سهام بالفطرة.
Dialogue: 0,1:04:27.57,1:04:30.87,Default,Fith,0,0,0,,لم أرها حتى، فقط الريح صفرت في أذني.
Dialogue: 0,1:04:30.87,1:04:33.47,Default,Fith,0,0,0,,فأطلقوا النار عليّ.
Dialogue: 0,1:04:33.47,1:04:34.57,Default,الخامس,0,0,0,,حقاً؟
Dialogue: 0,1:06:13.11,1:06:14.21,Default,5,0,0,0,,إذاً لقد كنت أنت.
Dialogue: 0,1:06:14.97,1:06:16.91,Default,5,0,0,0,,لقد كنت ذلك الشخص.
Dialogue: 0,1:06:20.21,1:06:22.05,Default,Fith,0,0,0,,لن أسامحك.
Dialogue: 0,1:06:42.00,1:06:44.97,Default,Fith,0,0,0,,سوف أقتلك.
Dialogue: 0,1:07:05.53,1:07:10.00,Default,5,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:07:25.41,1:07:27.68,Default,خامس,0,0,0,,لدي أخبار حزينة.
Dialogue: 0,1:07:27.68,1:07:29.05,Default,خامس,0,0,0,,ارتجفت يدي
Dialogue: 0,1:07:29.05,1:07:30.98,Default,الخامس,0,0,0,,ولعبت دور الملكة.
Dialogue: 0,1:07:30.98,1:07:33.25,Default,5,0,0,0,,الوليمة على وشك البدء، لكن المكونات لم تصل.
Dialogue: 0,1:07:33.25,1:07:34.32,Default,Fith,0,0,0,,أهذا كل شيء؟
Dialogue: 0,1:07:34.32,1:07:35.89,Default,5,0,0,0,,هل أضفت السم؟
Dialogue: 0,1:07:36.06,1:07:37.56,Default,الخامس,0,0,0,,الاسم - لي سينمان.
Dialogue: 0,1:07:37.89,1:07:39.76,Default,Fithth,0,0,0,,سأقوم بإنشاء قائمة جديدة من المكونات المتوفرة.
Dialogue: 0,1:07:39.76,1:07:41.93,Default,Fith,0,0,0,,كيف تجرؤ على قلي إبرتي الثمينة.
Dialogue: 0,1:07:41.93,1:07:44.40,Default,Fith,0,0,0,,ما سنطبخه اليوم ليس طعامًا بسيطًا.
Dialogue: 0,1:07:44.40,1:07:45.67,Default,Fith,0,0,0,,إنها تستحق رئيساً.
Dialogue: 0,1:07:45.93,1:07:47.97,Default,Fith,0,0,0,,كيف تجرؤ على عصيان أوامر سيدك؟
Dialogue: 0,1:07:47.97,1:07:50.40,Default,Fifth,0,0,0,,{\i1}-قبض عليهم!\N-هذه ليست خيانة، بل تمرد!{\i}
Dialogue: 0,1:07:50.40,1:07:53.67,Default,Fifth,0,0,0,,سيتعين عليك الدفع مقابل القدرة على التحكم في شخصيتك.
Dialogue: 0,0:13:59.93,0:14:01.93,Default,,0,0,0,,


