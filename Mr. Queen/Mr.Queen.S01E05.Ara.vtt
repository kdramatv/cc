Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:03.88,0:01:06.42,Default,,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.42,0:01:08.99,Default,,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:09.16,0:01:10.99,Default,,0,0,0,,5 حلقة
Dialogue: 0,0:01:10.99,0:01:13.73,Default,,0,0,0,,لكل إنسان نقطة ضعفه.
Dialogue: 0,0:01:18.80,0:01:21.74,Default,,0,0,0,,حتى سوبرمان عندما يلتقي بالكريبتونيت
Dialogue: 0,0:01:21.74,0:01:25.91,Default,,0,0,0,,يصبح مجرد غريب الأطوار يرتدي سروالاً داخلياً فوق بنطاله.
Dialogue: 0,0:01:29.41,0:01:31.38,Default,,0,0,0,,إذا كان سوبرمان ضعيفاً جداً،
Dialogue: 0,0:01:31.71,0:01:34.25,Default,,0,0,0,,تخيل ما يحدث للناس العاديين.
Dialogue: 0,0:01:46.09,0:01:48.13,Default,,0,0,0,,سأكشف الحقيقة!
Dialogue: 0,0:01:48.70,0:01:52.03,Default,,0,0,0,,سأقبل إرادتك يا صاحب الجلالة!
Dialogue: 0,0:01:52.23,0:01:54.90,Default,,0,0,0,,ليست هي من يجب إعدامها!
Dialogue: 0,0:01:59.21,0:02:00.64,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:02:02.91,0:02:04.34,Default,,0,0,0,,أتوسل إليك.
Dialogue: 0,0:02:07.82,0:02:10.15,Default,,0,0,0,,هل ستخالف إرادة الملك؟
Dialogue: 0,0:02:20.79,0:02:25.10,Default,,0,0,0,,بالنسبة لشخص عادي، هذا العالم هو حقل ألغام من نقاط الضعف.
Dialogue: 0,0:02:25.10,0:02:27.53,Default,,0,0,0,,لقد أصبحنا نقطة ضعف بعضنا البعض
Dialogue: 0,0:02:27.53,0:02:29.94,Default,,0,0,0,,وسنسحب الجميع إلى العالم السفلي.
Dialogue: 0,0:02:31.41,0:02:35.18,Default,,0,0,0,,حتى أنا، "جانغ بونغ هوان" المثالي، لديّ نقطة ضعف.
Dialogue: 0,0:02:35.68,0:02:37.38,Default,,0,0,0,,وهذا ليس أكثر من...
Dialogue: 0,0:02:40.18,0:02:44.12,Default,,0,0,0,,لا أستطيع التحمل عندما يبدو شخص آخر أفضل مني.
Dialogue: 0,0:02:45.92,0:02:47.72,Default,,0,0,0,,أذيت الملكة...
Dialogue: 0,0:02:47.72,0:02:49.16,Default,,0,0,0,,توقف!
Dialogue: 0,0:02:49.86,0:02:52.46,Default,,0,0,0,,خاصة في حضور من يعجبني.
Dialogue: 0,0:02:52.46,0:02:56.00,Default,,0,0,0,,يجب أن أكون الأروع في عينيها.
Dialogue: 0,0:02:57.40,0:03:00.37,Default,,0,0,0,,يمكنك القول أن هذا هو كعب أخيل
Dialogue: 0,0:03:00.37,0:03:02.54,Default,,0,0,0,,من هو الكمال.
Dialogue: 0,0:03:18.22,0:03:20.19,Default,,0,0,0,,اسمح لي كضحية لهذا الحادث،
Dialogue: 0,0:03:20.19,0:03:22.56,Default,,0,0,0,,تسليط الضوء على الأحداث.
Dialogue: 0,0:03:24.99,0:03:26.43,Default,,0,0,0,,أنا
Dialogue: 0,0:03:28.53,0:03:30.46,Default,,0,0,0,,حاول الانتحار.
Dialogue: 0,0:03:34.10,0:03:36.60,Default,,0,0,0,,هل تعتقد أن هناك رجلاً رائعًا واحدًا فقط هنا؟
Dialogue: 0,0:03:36.60,0:03:38.81,Default,,0,0,0,,لا ترتعش يا تشيولجونغ.
Dialogue: 0,0:03:38.81,0:03:40.91,Default,,0,0,0,,أنا البطل هنا.
Dialogue: 0,0:03:42.04,0:03:47.68,Default,,0,0,0,,من فضلك، لا تلمس الأبرياء من أي شيء.
Dialogue: 0,0:03:49.62,0:03:51.12,Default,,0,0,0,,ممتاز.
Dialogue: 0,0:03:51.25,0:03:54.72,Default,,0,0,0,,يا لها من عبارة سخيفة؟
Dialogue: 0,0:03:54.72,0:03:56.12,Default,,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:03:56.12,0:04:00.23,Default,,0,0,0,,آسفة، لكني حاولت قتل نفسي.
Dialogue: 0,0:04:01.23,0:04:02.23,Default,,0,0,0,,اترك نفسك الزائفة
Dialogue: 0,0:04:02.23,0:04:05.77,Default,,0,0,0,,حملت معي رسالة الانتحار هذه.
Dialogue: 0,0:04:11.21,0:04:13.57,Default,,0,0,0,,سأعود اليوم على أية حال.
Dialogue: 0,0:04:13.97,0:04:15.98,Default,,0,0,0,,لا يهمني إذا سادت الفوضى هنا.
Dialogue: 0,0:04:16.68,0:04:18.95,Default,,0,0,0,,لماذا تفعل هذا؟
Dialogue: 0,0:04:18.95,0:04:21.65,Default,,0,0,0,,ولماذا تقتل نفسك
Dialogue: 0,0:04:21.65,0:04:24.05,Default,,0,0,0,,في الليلة التي سبقت أن أصبحت ملكة؟
Dialogue: 0,0:04:26.09,0:04:27.79,Default,,0,0,0,,الأمر هو...
Dialogue: 0,0:04:27.79,0:04:30.89,Default,,0,0,0,,ما هو السبب؟
Dialogue: 0,0:04:31.43,0:04:34.83,Default,,0,0,0,,حسناً، لقد كنت مكتئباً وأردت أن أموت لأن...
Dialogue: 0,0:04:35.36,0:04:37.80,Default,,0,0,0,,أنا متأكد من أن هناك سببًا.
Dialogue: 0,0:04:40.63,0:04:42.10,Default,,0,0,0,,صاحب السمو!
Dialogue: 0,0:04:44.94,0:04:46.41,Default,,0,0,0,,اللعنة!
Dialogue: 0,0:04:48.61,0:04:49.71,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:04:49.71,0:04:51.14,Default,,0,0,0,,سويون.
Dialogue: 0,0:05:03.59,0:05:05.39,Default,,0,0,0,,هل سيأخذني بعيداً الآن؟
Dialogue: 0,0:05:05.39,0:05:06.43,Default,,0,0,0,,لا تجرؤ.
Dialogue: 0,0:05:06.43,0:05:08.73,Default,,0,0,0,,لا تقترب. بعيد!
Dialogue: 0,0:05:31.35,0:05:33.05,Default,,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:05:33.05,0:05:36.56,Default,,0,0,0,,الملكة تكذب،
Dialogue: 0,0:05:36.56,0:05:39.49,Default,,0,0,0,,لإنقاذ حياة\N شخص أقل أهمية منها.
Dialogue: 0,0:05:39.49,0:05:41.63,Default,,0,0,0,,ثق بالقلب الفاضل،
Dialogue: 0,0:05:41.63,0:05:43.90,Default,,0,0,0,,مسامحة\N التي أخطأت في حقها،
Dialogue: 0,0:05:43.90,0:05:45.53,Default,,0,0,0,,وارحم.
Dialogue: 0,0:05:45.53,0:05:48.67,Default,,0,0,0,,إذًا هكذا أخذ كل شيء؟
Dialogue: 0,0:06:10.39,0:06:15.03,Default,,0,0,0,,ما هو المثير للاهتمام هنا؟\N لقد تجمع الكثير من الناس.
Dialogue: 0,0:06:18.33,0:06:19.80,Default,,0,0,0,,...
Dialogue: 0,0:06:20.10,0:06:23.30,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:06:23.64,0:06:28.88,Default,,0,0,0,,ماذا حدث هنا؟
Dialogue: 0,0:06:30.34,0:06:31.78,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:06:32.28,0:06:34.08,Default,,0,0,0,,بذلت الملكة الكثير من الجهد،
Dialogue: 0,0:06:34.08,0:06:37.05,Default,,0,0,0,,فليكن، سأرحم.
Dialogue: 0,0:07:09.85,0:07:13.15,Default,,0,0,0,,5 الحلقة: كعب أخيل
Dialogue: 0,0:07:13.25,0:07:16.96,Default,,0,0,0,,لم أر مثل هذا المنظر منذ وقت طويل.
Dialogue: 0,0:07:16.96,0:07:20.59,Default,,0,0,0,,أتساءل بماذا كانت تفكر الملكة عندما فعلت ذلك.
Dialogue: 0,0:07:20.79,0:07:22.83,Default,,0,0,0,,هذا هو قلب المرأة.
Dialogue: 0,0:07:23.13,0:07:26.90,Default,,0,0,0,,لكنني متأكد من أن آل كيم لا علاقة لهم بالأمر.
Dialogue: 0,0:07:26.90,0:07:28.33,Default,,0,0,0,,نعم.
Dialogue: 0,0:07:28.74,0:07:31.10,Default,,0,0,0,,هل تتجه إلى قاعة سيونجونج؟
Dialogue: 0,0:07:31.20,0:07:35.28,Default,,0,0,0,,اليوم أحتاج إلى شيء آخر غير الصلاة.
Dialogue: 0,0:07:36.04,0:07:38.68,Default,,0,0,0,,إنها مجرد رفيقة ملكية ضعيفة،
Dialogue: 0,0:07:38.68,0:07:41.05,Default,,0,0,0,,لكنها سهمنا الوحيد.
Dialogue: 0,0:07:41.31,0:07:44.42,Default,,0,0,0,,عليك أن تضع السم على طرفه.
Dialogue: 0,0:08:05.37,0:08:06.77,Default,,0,0,0,,الآلهة.
Dialogue: 0,0:08:11.51,0:08:13.18,Default,,0,0,0,,هل حاولت الانتحار؟
Dialogue: 0,0:08:14.08,0:08:15.55,Default,,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:08:15.55,0:08:17.62,Default,,0,0,0,,سأنتظر الوقت المناسب وأستيقظ في اللحظة المناسبة.
Dialogue: 0,0:08:17.62,0:08:20.15,Default,,0,0,0,,أي نوع من الأب أنا الذي لم أخمنه؟
Dialogue: 0,0:08:20.65,0:08:22.36,Default,,0,0,0,,لقد ارتكبت ذنباً عظيماً.
Dialogue: 0,0:08:22.59,0:08:26.16,Default,,0,0,0,,لقد أخطأت.
Dialogue: 0,0:08:26.56,0:08:28.46,Default,,0,0,0,,هذا كله خطأي.
Dialogue: 0,0:08:28.60,0:08:31.10,Default,,0,0,0,,كان ينبغي عليه أن يعتني بها بشكل أفضل.
Dialogue: 0,0:08:31.10,0:08:33.20,Default,,0,0,0,,لقد فاتني ذلك.
Dialogue: 0,0:08:33.93,0:08:35.94,Default,,0,0,0,,لماذا فعلت هذا؟
Dialogue: 0,0:08:36.27,0:08:39.14,Default,,0,0,0,,يجب أن تعلم أنك معها طوال الوقت.
Dialogue: 0,0:08:39.54,0:08:42.94,Default,,0,0,0,,حاولت القفز في الماء عدة مرات،
Dialogue: 0,0:08:42.98,0:08:46.55,Default,,0,0,0,,اعتقدت أن ذلك بسبب الصدمة أثناء السقوط.
Dialogue: 0,0:08:46.55,0:08:48.15,Default,,0,0,0,,عدة مرات؟
Dialogue: 0,0:08:51.28,0:08:56.12,Default,,0,0,0,,كيف عانت؟
Dialogue: 0,0:08:56.76,0:08:58.32,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:08:58.39,0:09:01.69,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:09:03.36,0:09:06.30,Default,,0,0,0,,حسناً، هذا يكفي بالفعل.
Dialogue: 0,0:09:06.30,0:09:08.70,Default,,0,0,0,,سوف تبكي ولن أستيقظ.
Dialogue: 0,0:09:12.01,0:09:15.58,Default,,0,0,0,,الآن ليس وقت البكاء.
Dialogue: 0,0:09:16.14,0:09:18.31,Default,,0,0,0,,سوف يرانا بالدموع،
Dialogue: 0,0:09:18.98,0:09:22.15,Default,,0,0,0,,سوف يكون مستاءً جداً.
Dialogue: 0,0:09:22.15,0:09:23.65,Default,,0,0,0,,بالطبع.
Dialogue: 0,0:09:23.92,0:09:25.22,Default,,0,0,0,,أنت على حق.
Dialogue: 0,0:09:25.22,0:09:28.49,Default,,0,0,0,,في مثل هذه اللحظات عليك أن تكون شجاعاً وأن تكون قريباً منها.
Dialogue: 0,0:09:28.79,0:09:31.29,Default,,0,0,0,,أستيقظت الآن؟
Dialogue: 0,0:09:31.29,0:09:34.06,Default,,0,0,0,,-سويون.\N-يا إلهي.
Dialogue: 0,0:09:35.13,0:09:37.66,Default,,0,0,0,,عندما أعطتك أمك الحياة،
Dialogue: 0,0:09:38.53,0:09:42.34,Default,,0,0,0,,لقد فقدت حقيبتها.
Dialogue: 0,0:09:42.84,0:09:44.47,Default,,0,0,0,,هل بدأ من جديد؟
Dialogue: 0,0:09:48.71,0:09:50.21,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:09:51.44,0:09:53.28,Default,,0,0,0,,لقد كبرت جلالتها،
Dialogue: 0,0:09:53.31,0:09:56.35,Default,,0,0,0,,عدم وجود فرصة لرؤية وجه أمي.
Dialogue: 0,0:09:56.35,0:09:58.82,Default,,0,0,0,,أشعر بالأسف الشديد عليها.
Dialogue: 0,0:09:59.79,0:10:02.62,Default,,0,0,0,,لا أعرف لماذا عانت كثيراً،
Dialogue: 0,0:10:02.62,0:10:05.29,Default,,0,0,0,,وأنا فقط منعتها من هذا وذاك.
Dialogue: 0,0:10:05.29,0:10:08.83,Default,,0,0,0,,كنت أطاردها
Dialogue: 0,0:10:09.43,0:10:12.43,Default,,0,0,0,,وتذمرت طوال الوقت.
Dialogue: 0,0:10:12.87,0:10:15.77,Default,,0,0,0,,بفضلي تمكنت من ذلك
Dialogue: 0,0:10:16.30,0:10:20.44,Default,,0,0,0,,اقفز إلى البحيرة.
Dialogue: 0,0:10:20.67,0:10:24.28,Default,,0,0,0,,كيف ذلك يا صاحب الجلالة.
Dialogue: 0,0:10:25.11,0:10:27.75,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:10:29.25,0:10:30.28,Default,,0,0,0,,أنا أستسلم.
Dialogue: 0,0:10:30.28,0:10:33.02,Default,,0,0,0,,لا أستطيع التأقلم مع هذا الوضع.
Dialogue: 0,0:10:33.39,0:10:37.22,Default,,0,0,0,,غوانغهوامون
Dialogue: 0,0:10:56.34,0:10:57.94,Default,,0,0,0,,ملكتي.
Dialogue: 0,0:10:59.51,0:11:00.85,Default,,0,0,0,,من فضلك،
Dialogue: 0,0:11:00.85,0:11:03.55,Default,,0,0,0,,اعتني بنفسك.
Dialogue: 0,0:11:04.65,0:11:06.72,Default,,0,0,0,,أبوك المثير للشفقة
Dialogue: 0,0:11:08.36,0:11:10.49,Default,,0,0,0,,يطلب المغفرة.
Dialogue: 0,0:11:24.77,0:11:26.34,Default,,0,0,0,,بنين.
Dialogue: 0,0:11:29.44,0:11:31.31,Default,,0,0,0,,اليوم سأدخل القصر.
Dialogue: 0,0:11:31.31,0:11:34.21,Default,,0,0,0,,سأقابل الملك للمرة الأولى.
Dialogue: 0,0:11:35.75,0:11:37.28,Default,,0,0,0,,هل أنت سعيد جدًا؟
Dialogue: 0,0:11:38.22,0:11:40.09,Default,,0,0,0,,أنا فقط فضولي.
Dialogue: 0,0:11:40.22,0:11:42.62,Default,,0,0,0,,في بعض الأحيان يبدو وكأنه أحمق قبيح،
Dialogue: 0,0:11:42.62,0:11:45.39,Default,,0,0,0,,وأحياناً كما لو كانت مصنوعة من اليشم.
Dialogue: 0,0:11:48.09,0:11:49.56,Default,,0,0,0,,في أحلامي.
Dialogue: 0,0:11:50.23,0:11:53.63,Default,,0,0,0,,الليلة الماضية كان يشبهك تماماً.
Dialogue: 0,0:11:57.80,0:12:02.41,Default,,0,0,0,,اعتقدت أنه يجب عليّ أن أتخلى عنك لكي أجعلك سعيداً.
Dialogue: 0,0:12:03.54,0:12:07.15,Default,,0,0,0,,قبل زيارة القصر كنت سعيداً جداً.
Dialogue: 0,0:12:07.45,0:12:10.72,Default,,0,0,0,,لكنها بعد زيارتها للقصر حاولت الانتحار.
Dialogue: 0,0:12:18.59,0:12:20.66,Default,,0,0,0,,هل هذا حقاً بسبب هذا؟
Dialogue: 0,0:12:38.38,0:12:41.98,Default,,0,0,0,,لقد جن جنونها! لقد فقدت بقية عقلي!
Dialogue: 0,0:12:41.98,0:12:43.85,Default,,0,0,0,,اترك نفسك الزائفة
Dialogue: 0,0:12:43.85,0:12:46.72,Default,,0,0,0,,أمضت عدة ليالٍ مع الملك. \NAre أنت متأكد
Dialogue: 0,0:12:46.72,0:12:49.46,Default,,0,0,0,,ألم يغشّي دماغها؟
Dialogue: 0,0:12:49.46,0:12:51.49,Default,,0,0,0,,اهدأ يا صاحب الجلالة.
Dialogue: 0,0:12:51.49,0:12:53.66,Default,,0,0,0,,غضبك قليل الفائدة.
Dialogue: 0,0:12:53.66,0:12:55.76,Default,,0,0,0,,كيف لا أغضب؟
Dialogue: 0,0:12:55.76,0:12:58.60,Default,,0,0,0,,لقد أضعنا فرصة عظيمة.
Dialogue: 0,0:12:58.60,0:13:01.07,Default,,0,0,0,,أطلقوا النار على أقدامهم!
Dialogue: 0,0:13:02.14,0:13:04.77,Default,,0,0,0,,هل رأيت كيف تصرف الملك؟
Dialogue: 0,0:13:05.11,0:13:07.04,Default,,0,0,0,,تلك النظرة المتغطرسة.
Dialogue: 0,0:13:07.04,0:13:10.54,Default,,0,0,0,,أنقذته من حياة فلاح بسيط وجعلته ملكاً،
Dialogue: 0,0:13:10.54,0:13:12.85,Default,,0,0,0,,هل يجرؤ على أن يبدو هكذا؟
Dialogue: 0,0:13:12.85,0:13:14.98,Default,,0,0,0,,علينا تهدئته لأنه متمرد.
Dialogue: 0,0:13:14.98,0:13:18.15,Default,,0,0,0,,سأشدد القواعد حتى تعرف مكانك.
Dialogue: 0,0:13:23.22,0:13:25.93,Default,,0,0,0,,لماذا تضيع الوقت في الاعتناء بنفسك؟
Dialogue: 0,0:13:26.16,0:13:29.73,Default,,0,0,0,,لا يوجد أي أثر للجهد، الأمر يستحق القلق.
Dialogue: 0,0:13:31.87,0:13:33.90,Default,,0,0,0,,ادع المعالج باك.
Dialogue: 0,0:13:33.97,0:13:35.40,Default,,0,0,0,,نعم.
Dialogue: 0,0:13:41.07,0:13:45.34,Default,,0,0,0,,بصراحة، الملكة أتت إليّ.
Dialogue: 0,0:13:46.78,0:13:49.62,Default,,0,0,0,,في تلك الليلة عندما ألقيت بنفسي في البحيرة.
Dialogue: 0,0:13:54.69,0:13:57.92,Default,,0,0,0,,الملكة الأرملة، أنا
Dialogue: 0,0:14:01.16,0:14:02.96,Default,,0,0,0,,سأغادر القصر.
Dialogue: 0,0:14:04.16,0:14:05.97,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:14:05.97,0:14:08.67,Default,,0,0,0,,لا أستطيع أن أصبح ملكة.
Dialogue: 0,0:14:08.67,0:14:11.10,Default,,0,0,0,,لا أريد مثل هذا المصير المرير لنفسي.
Dialogue: 0,0:14:12.81,0:14:16.54,Default,,0,0,0,,لقد سمعت شائعات بأنك تتصرف بشكل فظيع،
Dialogue: 0,0:14:16.54,0:14:18.61,Default,,0,0,0,,لكن كل هذا كان عن عمد،
Dialogue: 0,0:14:18.71,0:14:21.45,Default,,0,0,0,,حتى لا تصبح ملكة.
Dialogue: 0,0:14:23.32,0:14:24.75,Default,,0,0,0,,كم هو لطيف.
Dialogue: 0,0:14:24.75,0:14:27.55,Default,,0,0,0,,كنت تعتقد أنك تستطيع تحقيق شيء ما بهذا.
Dialogue: 0,0:14:27.95,0:14:29.82,Default,,0,0,0,,لقد أخذت دروسًا لتصبح ملكة.
Dialogue: 0,0:14:29.82,0:14:31.69,Default,,0,0,0,,لا أعرف لماذا غيرت رأيي فجأة
Dialogue: 0,0:14:31.69,0:14:33.76,Default,,0,0,0,,وأنا لا أريد أن أعرف.
Dialogue: 0,0:14:34.56,0:14:37.56,Default,,0,0,0,,مصيرك محدد سلفًا منذ ولادتك.
Dialogue: 0,0:14:37.56,0:14:40.43,Default,,0,0,0,,يجب أن تصبحي ملكة وتخدمي عائلتك.
Dialogue: 0,0:14:40.53,0:14:43.84,Default,,0,0,0,,هذا هو قدرك، وهذا ما ولدت من أجله.
Dialogue: 0,0:14:45.10,0:14:47.94,Default,,0,0,0,,هل اتخذت هذا المنصب بنفسك؟
Dialogue: 0,0:14:47.94,0:14:49.41,Default,,0,0,0,,لا، ليست نفسها.
Dialogue: 0,0:14:49.64,0:14:52.65,Default,,0,0,0,,لذا لا يمكنك التراجع،\N حتى لو أردت ذلك.
Dialogue: 0,0:14:53.11,0:14:55.68,Default,,0,0,0,,إذا أردت أن تموت، مت في القصر.
Dialogue: 0,0:14:56.78,0:14:58.65,Default,,0,0,0,,اعتقدت أنها قالت ذلك لأن
Dialogue: 0,0:14:58.65,0:15:01.96,Default,,0,0,0,,أن الشباب يميلون الآن إلى إنشاء جبال من التلال.
Dialogue: 0,0:15:01.96,0:15:04.39,Default,,0,0,0,,لذا لم أعلق أهمية كبيرة على هذا.
Dialogue: 0,0:15:04.99,0:15:08.83,Default,,0,0,0,,لم أستطع حتى أن أعتقد أنها قفزت إلى البحيرة لتنتحر.
Dialogue: 0,0:15:10.23,0:15:13.77,Default,,0,0,0,,إذا كانت مستعدة للموت،\N فقط حتى لا تصبح ملكة،
Dialogue: 0,0:15:15.67,0:15:17.80,Default,,0,0,0,,لذا فإن سلوكها المجنون اليوم أيضاً...
Dialogue: 0,0:15:18.64,0:15:22.14,Default,,0,0,0,,طريقة لترك منصب الملكة.
Dialogue: 0,0:15:22.38,0:15:24.44,Default,,0,0,0,,إذا كان هذا هو الحال،
Dialogue: 0,0:15:24.54,0:15:28.15,Default,,0,0,0,,لن تفلت الملكة من العقاب.
Dialogue: 0,0:15:28.38,0:15:31.78,Default,,0,0,0,,انتظرني! ماذا لو سقطت؟
Dialogue: 0,0:15:31.78,0:15:34.92,Default,,0,0,0,,أخبرتك، خذ وقتك.
Dialogue: 0,0:15:35.86,0:15:39.33,Default,,0,0,0,,من يجرؤ على عرقلة طريقي؟
Dialogue: 0,0:15:44.76,0:15:46.67,Default,,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:15:46.67,0:15:49.70,Default,,0,0,0,,لن تتمكن من العودة إلى المنزل.
Dialogue: 0,0:15:50.10,0:15:52.41,Default,,0,0,0,,-ماذا؟\N-إلى الملكة، "جانغ بونغ هوان"،
Dialogue: 0,0:15:52.41,0:15:57.01,Default,,0,0,0,,أمرت بالبقاء هنا إلى الأبد حتى نهاية أيامي
Dialogue: 0,0:15:57.01,0:16:00.95,Default,,0,0,0,,وتعيش في العذاب، وتظل عاجزاً.
Dialogue: 0,0:16:09.42,0:16:10.82,Default,,0,0,0,,لا.
Dialogue: 0,0:16:12.29,0:16:13.69,Default,,0,0,0,,لا أريد ذلك.
Dialogue: 0,0:16:13.73,0:16:19.10,Default,,0,0,0,,لا أريد أن أكون عاجزاً!
Dialogue: 0,0:16:21.10,0:16:22.50,Default,Spilik,0,0,0,,جلالتك!
Dialogue: 0,0:16:25.00,0:16:26.87,Default,Spilik,0,0,0,,يا له من كابوس فظيع.
Dialogue: 0,0:16:27.81,0:16:30.24,Default,Spilik,0,0,0,,لقد حاولت إغراق نفسك في البحيرة،
Dialogue: 0,0:16:30.24,0:16:32.91,Default,Spilik,0,0,0,,واليوم أغمي عليهم، كنت خائفاً جداً...
Dialogue: 0,0:16:32.91,0:16:35.58,Default,Spillit,0,0,0,,اهدأ. أنا أفهم كيف تشعر.
Dialogue: 0,0:16:35.58,0:16:38.22,Default,Spilik,0,0,0,,سأموت معك!
Dialogue: 0,0:16:45.93,0:16:47.53,Default,Spilik,0,0,0,,يكفي بالفعل.
Dialogue: 0,0:16:47.53,0:16:50.43,Default,Spilik,0,0,0,,لقد اكتفيت من الدموع لهذا اليوم، ولم أعد أستطيع التحمل.
Dialogue: 0,0:16:50.43,0:16:53.83,Default,Spillit,0,0,0,,إنه ليس معدياً، فلماذا بكيت ثلاث مرات؟
Dialogue: 0,0:16:54.00,0:16:56.40,Default,Spilik,0,0,0,,لقد نمت بينما كنت أنتظر أن تتوقف.
Dialogue: 0,0:16:56.40,0:17:00.07,Default,Spilik,0,0,0,,بالطبع أنت لا تريد أن ترى دموعي.
Dialogue: 0,0:17:02.38,0:17:04.04,Default,Spilik,0,0,0,,أنت لطيف عندما تبتسم.
Dialogue: 0,0:17:09.05,0:17:10.52,Default,Spilik,0,0,0,,أين سيدة المحكمة تشوي؟
Dialogue: 0,0:17:11.48,0:17:14.59,Default,Spilik,0,0,0,,أصرت على أنها ستجلب لك الدواء بنفسها.
Dialogue: 0,0:17:14.92,0:17:18.93,Default,Spilik,0,0,0,,بقي والدك معك
Dialogue: 0,0:17:18.93,0:17:21.46,Default,Spikyulka,0,0,0,,ولم تذهب إلى المنزل إلا بعد غروب الشمس.
Dialogue: 0,0:17:21.86,0:17:24.83,Default,Spilik,0,0,0,,لو أننا استيقظنا مبكراً قليلاً لرأينا ذلك.
Dialogue: 0,0:17:25.06,0:17:27.43,Default,Spilik,0,0,0,,الحمد لله أنني لم أره.
Dialogue: 0,0:17:27.70,0:17:28.87,Default,Spilik,0,0,0,,ماذا؟
Dialogue: 0,0:17:28.87,0:17:30.74,Default,Spilik,0,0,0,,إذا اكتشف جمال الجسم
Dialogue: 0,0:17:30.74,0:17:32.87,Default,Spillie,0,0,0,,اختطفت روح رجل ابنته التي لا تقدر بثمن،
Dialogue: 0,0:17:32.87,0:17:34.87,Default,Spilik,0,0,0,,يجب أن أكون منزعجاً.
Dialogue: 0,0:17:36.14,0:17:37.74,Default,Spillit,0,0,0,,يجب أن نسرع ​​قبل عودة السيدة تشوي.
Dialogue: 0,0:17:37.74,0:17:40.15,Default,Spilik,0,0,0,,هل امتلأت البحيرة بالفعل؟
Dialogue: 0,0:17:40.48,0:17:42.78,Default,Biryulka,0,0,0,,هل تريد الذهاب إلى البحيرة في هذا الوقت؟
Dialogue: 0,0:17:43.45,0:17:46.19,Default,Spilik,0,0,0,,اليوم هو اليوم الأخير.
Dialogue: 0,0:17:49.86,0:17:53.03,Default,Spilik,0,0,0,,- هل أنت في مزاج جيد؟ \N-بالطبع.
Dialogue: 0,0:17:53.03,0:17:54.93,Default,Spilik,0,0,0,,كل ما تبقى هو العودة إلى المنزل،
Dialogue: 0,0:17:54.93,0:17:57.23,Default,Spilik,0,0,0,,ما زلت أروع رجل هنا.
Dialogue: 0,0:17:57.63,0:17:59.06,Default,Spilik,0,0,0,,أوه، بالضبط.
Dialogue: 0,0:17:59.57,0:18:02.17,Default,Spilyk,0,0,0,,-هونيون. \N-نعم، الملكة.
Dialogue: 0,0:18:03.37,0:18:05.20,Default,Spilik,0,0,0,,لقد تمكنت من تحمل كل هذا بفضلك.
Dialogue: 0,0:18:05.27,0:18:08.71,Default,Spikyulka,0,0,0,,لا أعرف شيئًا عن الآخرين، لكني سأفتقدك.
Dialogue: 0,0:18:09.38,0:18:12.01,Default,Spilik,0,0,0,,نعم، وسأفتقد أيضًا سيدة البلاط تشوي.
Dialogue: 0,0:18:13.11,0:18:17.18,Default,Spilik,0,0,0,,هونيون، اترك مثل هذه الوصية لأحفادك.
Dialogue: 0,0:18:17.18,0:18:18.58,Default,Spillie,0,0,0,,ويل؟
Dialogue: 0,0:18:19.19,0:18:21.85,Default,Spilik,0,0,0,,اشترِ أرضًا في "غانغنام".
Dialogue: 0,0:18:21.85,0:18:23.39,Default,Spilik,0,0,0,,عليك أن تخبرهم بهذا.
Dialogue: 0,0:18:23.39,0:18:25.22,Default,Spilyk,0,0,0,,ثم بعد 200 عام
Dialogue: 0,0:18:25.22,0:18:27.39,Default,Spilik,0,0,0,,ورثتك سيعيشون مثل الأغنياء.
Dialogue: 0,0:18:28.26,0:18:30.80,Default,Spilik,0,0,0,,هذا كل ما يمكنني تقديمه لك.
Dialogue: 0,0:18:34.93,0:18:37.47,Default,Spilik,0,0,0,,حسناً، تفضل.
Dialogue: 0,0:18:38.20,0:18:40.61,Default,Spilik,0,0,0,,يا صاحب الجلالة، كن حذراً.
Dialogue: 0,0:18:40.84,0:18:42.68,Default,Spilik,0,0,0,,أكثر نشاطاً.
Dialogue: 0,0:18:46.05,0:18:48.75,Default,Spilik,0,0,0,,أسرع، عليك أن تسرع.
Dialogue: 0,0:18:53.95,0:18:55.25,Default,Spilik,0,0,0,,ما هذا؟
Dialogue: 0,0:18:55.25,0:18:57.76,Default,Spilik,0,0,0,,لماذا عدنا إلى الطريق القديم،
Dialogue: 0,0:18:57.76,0:18:59.23,Default,Spilyk,0,0,0,,متى توصلت إلى النظام الجديد؟
Dialogue: 0,0:18:59.23,0:19:00.73,Default,Spilik,0,0,0,,الأمر هو...
Dialogue: 0,0:19:01.09,0:19:04.16,Default,Spillit,0,0,0,,البئر فارغ.
Dialogue: 0,0:19:05.70,0:19:08.87,Default,Spillit,0,0,0,,لهذا السبب نأخذ الماء من مكان آخر
Dialogue: 0,0:19:08.87,0:19:11.80,Default,Spilik,0,0,0,,ونحضرها هنا، لكن...
Dialogue: 0,0:19:12.37,0:19:15.67,Default,Spilik,0,0,0,,هل ستعيدها مرة أخرى؟ سمعت شيئا خاطئا.
Dialogue: 0,0:19:16.01,0:19:20.25,Default,Spilik,0,0,0,,يبدو أنك لن تنتهي اليوم.
Dialogue: 0,0:19:20.28,0:19:22.48,Default,Spilik,0,0,0,,سامحينا أيتها الملكة.
Dialogue: 0,0:19:22.48,0:19:25.32,Default,Spilik,0,0,0,, - سامحينا أيتها الملكة. \N-سامحنا أيتها الملكة.
Dialogue: 0,0:19:29.49,0:19:32.66,Default,Spilik,0,0,0,,يجب على المسؤول رفيع المستوى أن يفي بكلمته.
Dialogue: 0,0:19:32.66,0:19:35.66,Default,Spillit,0,0,0,,لقد وعدت بملء البحيرة اليوم.
Dialogue: 0,0:19:35.66,0:19:38.26,Default,Split,0,0,0,,أقرب بئر
Dialogue: 0,0:19:38.26,0:19:40.57,Default,Spilik,0,0,0,,بعيد جداً جداً عن هنا.
Dialogue: 0,0:19:40.57,0:19:43.37,Default,Spilyk,0,0,0,,سيستغرق الأمر 15 يومًا على الأقل...
Dialogue: 0,0:19:46.97,0:19:48.67,Default,Spilik,0,0,0,,أرجو إعدامي!
Dialogue: 0,0:19:48.67,0:19:54.15,Default,Spilik,0,0,0,,-أرجو إعدامي! \N-الرجاء إعدامي.
Dialogue: 0,0:19:54.15,0:19:56.48,Default,Spilik,0,0,0,,لماذا تطلب التنفيذ دائماً؟
Dialogue: 0,0:19:57.65,0:20:00.89,Default,Spilik,0,0,0,,ربما لا تصدق أنني سأعدمك حقاً؟
Dialogue: 0,0:20:00.95,0:20:02.59,Default,Spilik,0,0,0,,هل يجب أن أثبت ذلك لك؟
Dialogue: 0,0:20:02.59,0:20:05.56,Default,Spilik,0,0,0,,هل تريد أن تختبر بنفسك أي نوع من الاحتيال يحدث؟
Dialogue: 0,0:20:09.96,0:20:13.33,Default,Spilyk,0,0,0,,لقد تجاوزنا. أنا متأكد من أن البحيرة غير المكتملة ستنجح.
Dialogue: 0,0:20:13.90,0:20:15.37,Default,Spilik,0,0,0,,لا يا صاحب الجلالة.
Dialogue: 0,0:20:15.70,0:20:17.80,Default,Spilik,0,0,0,,لماذا تفعل هذا؟
Dialogue: 0,0:20:17.80,0:20:20.67,Default,Spilik,0,0,0,,لن أسمح لك بالانتحار مرة أخرى.
Dialogue: 0,0:20:21.37,0:20:22.94,Default,Spilik,0,0,0,,الأمر ليس كذلك.
Dialogue: 0,0:20:23.64,0:20:25.55,Default,Spilik,0,0,0,,أنا لا أحاول أن أموت.
Dialogue: 0,0:20:25.55,0:20:27.11,Default,Spilik,0,0,0,,ماذا تحاول أن تفعل إذًا؟
Dialogue: 0,0:20:27.11,0:20:28.65,Default,Spilik,0,0,0,,باختصار...
Dialogue: 0,0:20:29.02,0:20:32.32,Default,Spilik,0,0,0,,أحاول البقاء على قيد الحياة. هذه هي الطريقة الوحيدة التي يمكنني القيام بها!
Dialogue: 0,0:20:38.89,0:20:40.79,Default,Spilik,0,0,0,,سوف تمر عبر جثتي فقط!
Dialogue: 0,0:20:41.29,0:20:42.93,Default,Spilik,0,0,0,,اللعنة، من أين لك كل هذا القدر من القوة؟
Dialogue: 0,0:20:42.93,0:20:44.40,Default,Spilik,0,0,0,,ابتعد عني.
Dialogue: 0,0:20:44.53,0:20:45.97,Default,Spillit,0,0,0,,إذا غيرت هذه الجدة رأيها
Dialogue: 0,0:20:45.97,0:20:50.04,Default,Spikilka,0,0,0,,ومرة أخرى تخلص من الماء في البحيرة، لقد فشلت!
Dialogue: 0,0:20:50.07,0:20:51.87,Default,Spillie,0,0,0,,ساعد في إيقاف الملكة!
Dialogue: 0,0:20:51.87,0:20:53.47,Default,Spillie,0,0,0,,كيف تجرؤ على لمسها؟
Dialogue: 0,0:20:53.47,0:20:55.71,Default,Spilik,0,0,0,,جلالتك!
Dialogue: 0,0:20:55.71,0:20:58.14,Default,Spilik,0,0,0,,أتوسل إليك، لا!
Dialogue: 0,0:20:58.14,0:21:00.71,Default,Spilik,0,0,0,,من الآن فصاعدا، لا مراوغات!
Dialogue: 0,0:21:00.71,0:21:03.02,Default,Spilik,0,0,0,,لن أقول لك "لا" أبداً!
Dialogue: 0,0:21:03.02,0:21:05.08,Default,Spilik,0,0,0,,لا يمكنك فعل ذلك!
Dialogue: 0,0:21:05.08,0:21:06.29,Default,Spilik,0,0,0,,قلت إنك لن تفعل ذلك.
Dialogue: 0,0:21:06.29,0:21:09.22,Default,Spilik,0,0,0,,أنك لا تستطيع أن تقول "لا" أبداً!
Dialogue: 0,0:21:09.22,0:21:10.66,Default,Split,0,0,0,,اللعنة.
Dialogue: 0,0:21:14.03,0:21:15.96,Default,Spilik,0,0,0,,لن يعمل.
Dialogue: 0,0:21:17.83,0:21:19.60,Default,Spilik,0,0,0,,على الأقل دغدعني.
Dialogue: 0,0:21:30.41,0:21:33.48,Default,Spilik,0,0,0,,لقد نسيت كيف أضحك منذ زمن طويل.
Dialogue: 0,0:21:34.88,0:21:36.32,Default,Split,0,0,0,,اللعنة.
Dialogue: 0,0:21:36.55,0:21:39.09,Default,Spillit,0,0,0,,لن أفعل. دعنا نذهب.
Dialogue: 0,0:21:39.09,0:21:40.55,Default,Spilik,0,0,0,,واو.
Dialogue: 0,0:21:41.25,0:21:42.99,Default,Spillie,0,0,0,,اللعنة، أنا عالق.
Dialogue: 0,0:21:44.72,0:21:46.66,Default,Spilik,0,0,0,,إذن أنت لا تريدني أن أذهب إلى هناك؟
Dialogue: 0,0:21:49.40,0:21:50.80,Default,Spilik,0,0,0,,ممتاز.
Dialogue: 0,0:22:02.94,0:22:04.44,Default,Spilik,0,0,0,,ارفع رأسك.
Dialogue: 0,0:22:04.58,0:22:06.15,Default,Spilyk,0,0,0,,افرد ظهرك.
Dialogue: 0,0:22:11.12,0:22:12.72,Default,Spilyk,0,0,0,,هل يمكنك السباحة؟
Dialogue: 0,0:22:18.99,0:22:20.53,Default,Spilik,0,0,0,,أهذا كل شيء؟
Dialogue: 0,0:22:20.63,0:22:24.76,Default,Spilik,0,0,0,,سأذهب أبعد من ذلك، سيكون الأمر أعمق هناك.
Dialogue: 0,0:22:24.76,0:22:26.87,Default,Spilik,0,0,0,,حسناً، حركه.
Dialogue: 0,0:22:32.31,0:22:34.07,Default,Spillie,0,0,0,,-الآباء. \N-نعم، ومن هنا!
Dialogue: 0,0:22:35.11,0:22:37.81,Default,Spilik,0,0,0,,لقد تعثرت!
Dialogue: 0,0:22:38.61,0:22:41.15,Default,Spillit,0,0,0,,-المشكله. \N-صاحب الجلالة.
Dialogue: 0,0:22:42.15,0:22:46.02,Default,Spilik,0,0,0,,الملكة الأرملة تدعوك للظهور فوراً.
Dialogue: 0,0:22:46.02,0:22:47.99,Default,Spilik,0,0,0,,لك!
Dialogue: 0,0:22:48.42,0:22:51.86,Default,Spilik,0,0,0,,لي سينمان. هذا الاسم جاء بنتائج عكسية علي.
Dialogue: 0,0:22:51.96,0:22:53.43,Default,Split,0,0,0,,اللعنة.
Dialogue: 0,0:22:53.43,0:22:56.06,Default,Spilik,0,0,0,,-معجزة. \N-ما النعيم.
Dialogue: 0,0:22:56.30,0:22:57.80,Default,Spilik,0,0,0,,هذا كل شيء.
Dialogue: 0,0:23:00.13,0:23:01.63,Default,Spilik,0,0,0,,ما هذا؟
Dialogue: 0,0:23:01.77,0:23:05.17,Default,Spilik,0,0,0,,هل ينتابك هذا الشعور أحيانًا أيضًا؟
Dialogue: 0,0:23:05.94,0:23:09.24,Default,Spilik,0,0,0,,عندما ينشغل الجميع، ولا أحد يهتم بك.
Dialogue: 0,0:23:10.08,0:23:13.08,Default,Spilik,0,0,0,,سيدي، أنت مركز الكون بالنسبة لي.
Dialogue: 0,0:23:15.45,0:23:17.52,Default,Spilik,0,0,0,,حسناً، الأشخاص الحساسون مثلي،
Dialogue: 0,0:23:17.52,0:23:20.15,Default,Spilik,0,0,0,,أحيانًا يرتكبون أخطاء في هواجسهم، كما هو الحال اليوم.
Dialogue: 0,0:23:23.89,0:23:25.76,Default,Spilik,0,0,0,,لم أطلب ناينغ ميون.
Dialogue: 0,0:23:25.99,0:23:28.79,Default,Spilik,0,0,0,,أنت تجعلني سعيداً كل ليلة، وتسمح لي بخدمتك.
Dialogue: 0,0:23:28.79,0:23:30.43,Default,Spilik,0,0,0,,هذا من أعماق قلبي.
Dialogue: 0,0:23:30.56,0:23:32.33,Default,Spilik,0,0,0,,دعني أقول شيئاً.
Dialogue: 0,0:23:32.33,0:23:35.30,Default,Spilik,0,0,0,,يبدو أنني أتسكع هنا من أجل المتعة، لكن هذا ليس هو الحال.
Dialogue: 0,0:23:37.77,0:23:42.01,Default,Spilik,0,0,0,,أنا هنا فقط لأكتشف شيئًا ما على الأقل
Dialogue: 0,0:23:42.01,0:23:44.18,Default,Spilik,0,0,0,,عن "لي سينمان" الذي اختفى فجأة.
Dialogue: 0,0:23:44.64,0:23:49.01,Default,Spilik,0,0,0,,لكن لماذا تبحثين عنه بشدة؟
Dialogue: 0,0:23:49.22,0:23:52.55,Default,Spilik,0,0,0,,يبدو وكأنه وراء اختفائه
Dialogue: 0,0:23:52.55,0:23:55.72,Default,Spilik,0,0,0,,هناك سر مهم.
Dialogue: 0,0:23:56.19,0:23:58.62,Default,Spilik,0,0,0,,الحاسة السادسة تخبرني،
Dialogue: 0,0:23:59.19,0:24:01.63,Default,Spilik,0,0,0,,ما هذا لي سينمان
Dialogue: 0,0:24:02.23,0:24:04.50,Default,Spilik,0,0,0,,في قلب المشكلة.
Dialogue: 0,0:24:05.13,0:24:07.93,Default,Spilik,0,0,0,,-ما المشكلة؟ \N-ليس لدي أي فكرة.
Dialogue: 0,0:24:08.47,0:24:09.87,Default,Spilik,0,0,0,,ماذا؟
Dialogue: 0,0:24:19.18,0:24:22.18,Default,Spilik,0,0,0,,إنهم يتحققون مني الآن.
Dialogue: 0,0:24:23.05,0:24:26.15,Default,Spilik,0,0,0,,-حول اليوم...\N-إنه خطأي.
Dialogue: 0,0:24:31.62,0:24:34.89,Default,Spilik,0,0,0,,لقد أجبرتك على الزواج منه رغماً عنك.
Dialogue: 0,0:24:35.26,0:24:38.00,Default,Spilik,0,0,0,,ألا تريدين حقاً أن تكوني ملكة؟
Dialogue: 0,0:24:38.00,0:24:40.17,Default,Spilik,0,0,0,,إلى درجة أنك مستعد لتوديع الحياة؟
Dialogue: 0,0:24:40.57,0:24:42.60,Default,Spillit,0,0,0,,وتُخلع كملكة؟
Dialogue: 0,0:24:42.60,0:24:45.37,Default,Spilik,0,0,0,,حاولت الانتحار حتى لا تصبح ملكة؟
Dialogue: 0,0:24:45.37,0:24:46.81,Default,Spilik,0,0,0,,ممتاز.
Dialogue: 0,0:24:46.84,0:24:49.61,Default,Spilik,0,0,0,,إذا كنت تريد ذلك بشدة، فسوف يسمح لك\NI بمغادرة القصر.
Dialogue: 0,0:24:49.98,0:24:52.11,Default,Spilik,0,0,0,,سأعزلك.
Dialogue: 0,0:24:52.61,0:24:55.31,Default,Spillie,0,0,0,,سوف تكون مسجوناً في منزلك
Dialogue: 0,0:24:55.31,0:24:57.35,Default,Spilik,0,0,0,,ولن تخرج من العتبة لبقية حياتك.
Dialogue: 0,0:24:57.35,0:24:58.38,Default,Spilik,0,0,0,,لا.
Dialogue: 0,0:24:58.38,0:25:00.62,Default,Spilik,0,0,0,,لا يمكنني العودة إلا عبر البحيرة هنا.
Dialogue: 0,0:25:00.62,0:25:03.79,Default,Spilik,0,0,0,,لا أتذكر هذا.
Dialogue: 0,0:25:03.79,0:25:06.96,Default,Spilik,0,0,0,,بعد سقوطي في البحيرة، نسيت كل شيء.
Dialogue: 0,0:25:07.09,0:25:08.69,Default,Spilik,0,0,0,,الذكريات لم تعود،
Dialogue: 0,0:25:08.69,0:25:11.56,Default,Spilik,0,0,0,,لكن هل تذكرت أنك أردت الانتحار؟
Dialogue: 0,0:25:12.83,0:25:15.10,Default,Spilik,0,0,0,,مازلت أشعر بالألم.
Dialogue: 0,0:25:15.13,0:25:17.87,Default,Spilik,0,0,0,,وأنا متأكد من أنني طرزت هذه الملاحظة.
Dialogue: 0,0:25:18.04,0:25:21.61,Default,Spilik,0,0,0,,ولكن لماذا أردت الانتحار، لا أعرف.
Dialogue: 0,0:25:21.67,0:25:23.31,Default,Spilik,0,0,0,,إذا كنت لا تتذكر أي شيء،
Dialogue: 0,0:25:23.31,0:25:25.68,Default,Spilik,0,0,0,,لماذا تدخلت؟
Dialogue: 0,0:25:28.38,0:25:30.08,Default,Spilyk,0,0,0,,إذا لم تذكر سبباً،
Dialogue: 0,0:25:30.12,0:25:32.59,Default,Spilik,0,0,0,,سأفترض أنك عارضتني.
Dialogue: 0,0:25:32.59,0:25:33.59,Default,Spilik,0,0,0,,لا.
Dialogue: 0,0:25:33.59,0:25:36.29,Default,Spilik,0,0,0,,ولم أفكر قط في مقاومتك.
Dialogue: 0,0:25:36.29,0:25:40.03,Default,Spilik,0,0,0,,لقد قوضت اليوم سلطتي.
Dialogue: 0,0:25:40.39,0:25:41.89,Default,Spilik,0,0,0,,أنا بحاجة لإصلاح هذا.
Dialogue: 0,0:25:41.89,0:25:44.73,Default,Spilik,0,0,0,,ولكن ليس لدي حل. اللعنة، لا شيء يتبادر إلى الذهن.
Dialogue: 0,0:25:44.73,0:25:48.33,Default,Spilik,0,0,0,,ولا أستطيع أن أسامحك على ذلك.
Dialogue: 0,0:25:50.30,0:25:53.44,Default,Spilik,0,0,0,,أنا أستحق أن أموت يا صاحب الجلالة.
Dialogue: 0,0:25:53.74,0:25:56.24,Default,Spillie,0,0,0,,خذ حياتي.
Dialogue: 0,0:25:56.58,0:25:59.11,Default,Spilik,0,0,0,,أنا في حيرة من أمري بسبب قلة الذكريات،
Dialogue: 0,0:25:59.11,0:26:00.88,Default,Spilik,0,0,0,,لكنني لا أستطيع الابتعاد عن نوعي
Dialogue: 0,0:26:00.88,0:26:03.25,Default,Spilik,0,0,0,,ومن زوجي.
Dialogue: 0,0:26:03.85,0:26:05.75,Default,Spillie,0,0,0,,أرجوك عاقبني،
Dialogue: 0,0:26:05.75,0:26:09.92,Default,Spillie,0,0,0,,أعط السم للتخلص من هذا الألم.
Dialogue: 0,0:26:13.03,0:26:15.86,Default,Spilik,0,0,0,,إنهم بالتأكيد لا يريدون الإطاحة بالملكة.
Dialogue: 0,0:26:15.86,0:26:18.13,Default,Spilik,0,0,0,,هل من السهل عليك أن تتخلى عن حياتك؟
Dialogue: 0,0:26:18.36,0:26:20.10,Default,Spillit,0,0,0,,ألقت بنفسها في البحيرة.
Dialogue: 0,0:26:20.10,0:26:21.83,Default,Spilik,0,0,0,,الآن هل تريد شرب السم؟
Dialogue: 0,0:26:21.83,0:26:24.34,Default,Spilik,0,0,0,,لماذا أنت ضعيف جداً؟
Dialogue: 0,0:26:24.34,0:26:27.21,Default,Spilik,0,0,0,,إنهم يريدون التأكد من أن لديهم السلطة على الملكة.
Dialogue: 0,0:26:27.21,0:26:29.17,Default,Spillit,0,0,0,,قراري الغبي بتوديع الحياة
Dialogue: 0,0:26:29.17,0:26:31.64,Default,Spilik,0,0,0,,خلق كل هذا سوء الفهم.
Dialogue: 0,0:26:31.98,0:26:33.71,Default,Spilik,0,0,0,,فعلي يستحق الموت.
Dialogue: 0,0:26:33.71,0:26:38.45,Default,Spilik,0,0,0,,أتوسل إليك أن تعدمني يا صاحب الجلالة.
Dialogue: 0,0:26:38.45,0:26:41.35,Default,Spilik,0,0,0,,موتك لن يصلح أي شيء.
Dialogue: 0,0:26:41.35,0:26:42.42,Default,Spilik,0,0,0,,بسبب هذه الخدعة
Dialogue: 0,0:26:42.42,0:26:44.69,Default,Spillit,0,0,0,,ستحصل الملكة الأم على ميزة.
Dialogue: 0,0:26:44.69,0:26:46.89,Default,Spilik,0,0,0,,ولكن هذا لن يؤثر عليك فقط.
Dialogue: 0,0:26:46.89,0:26:51.06,Default,Spilik,0,0,0,,سيؤثر هذا على عائلة كيم بأكملها.
Dialogue: 0,0:26:51.56,0:26:54.87,Default,Spilik,0,0,0,,-سأحاول...\N-اهدأ من فضلك.
Dialogue: 0,0:26:59.20,0:27:04.58,Default,Spilik,0,0,0,,سأطلب منك للمرة الأخيرة.
Dialogue: 0,0:27:07.05,0:27:09.78,Default,Spilik,0,0,0,,هل تريد حقاً مغادرة القصر؟
Dialogue: 0,0:27:10.72,0:27:12.35,Default,Spilyk,0,0,0,,أريد
Dialogue: 0,0:27:14.35,0:27:15.99,Default,Spilik,0,0,0,,أعيش في قصر.
Dialogue: 0,0:27:17.69,0:27:20.13,Default,Spilik,0,0,0,,ما رأيك يا صاحب الجلالة؟
Dialogue: 0,0:27:29.34,0:27:32.57,Default,Spilik,0,0,0,,بما أنه لم يعد لدي أي ذكريات، سأصبح شخصاً جديداً.
Dialogue: 0,0:27:35.64,0:27:38.71,Default,Spillit,0,0,0,,سوف أصبح ملكة مثالية.
Dialogue: 0,0:27:41.21,0:27:44.48,Default,Spilik,0,0,0,,لا أصدق الوعود الفارغة.
Dialogue: 0,0:27:44.48,0:27:46.35,Default,Spilik,0,0,0,,سأثبت ذلك عملياً.
Dialogue: 0,0:27:48.25,0:27:50.96,Default,Spilik,0,0,0,,من فضلك أعطها فرصة يا صاحب الجلالة.
Dialogue: 0,0:27:53.83,0:27:55.06,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:27:55.06,0:27:58.80,Default,,0,0,0,,شكرًا لك على لطفك.
Dialogue: 0,0:28:00.23,0:28:02.50,Default,,0,0,0,,لن أزعجك بعد الآن.
Dialogue: 0,0:28:02.50,0:28:04.87,Default,,0,0,0,,ليس هناك ما يدعو للقلق.
Dialogue: 0,0:28:08.27,0:28:09.41,Default,,0,0,0,"اترك نفسك الزائفة"
Dialogue: 0,0:28:09.41,0:28:12.24,Default,,0,0,0,,لأنه لم يعد لدينا نقاط ضعف.
Dialogue: 0,0:28:13.05,0:28:14.75,Default,,0,0,0,,سنقضي على
Dialogue: 0,0:28:17.38,0:28:19.22,Default,,0,0,0,,أي مشكلة.
Dialogue: 0,0:28:31.03,0:28:32.90,Default,,0,0,0,,سوف يفعل ذلك.
Dialogue: 0,0:28:33.10,0:28:34.70,Default,,0,0,0,,هذا تحذير.
Dialogue: 0,0:28:49.95,0:28:51.88,Default,,0,0,0,,كل شيء غير واضح.
Dialogue: 0,0:28:53.55,0:28:55.85,Default,,0,0,0,,أشعل المزيد من الفوانيس يا صاحب الجلالة؟
Dialogue: 0,0:28:55.99,0:28:58.72,Default,,0,0,0,,لا. هذا أنا أتحدث عن مستقبلي.
Dialogue: 0,0:29:05.43,0:29:09.03,Default,,0,0,0,,فتش الأمير يونبيونغ ورجاله القصر.
Dialogue: 0,0:29:09.07,0:29:10.90,Default,,0,0,0,,شعبه؟
Dialogue: 0,0:29:11.07,0:29:13.11,Default,,0,0,0,,هل هؤلاء هم الحرس الملكي؟
Dialogue: 0,0:29:13.31,0:29:15.44,Default,,0,0,0,,إنهم مدربون جيداً.
Dialogue: 0,0:29:15.44,0:29:16.91,Default,,0,0,0,,كم المبلغ؟
Dialogue: 0,0:29:17.28,0:29:18.88,Default,,0,0,0,,قليلاً.
Dialogue: 0,0:29:19.58,0:29:21.85,Default,,0,0,0,,-سبعة.\N-طوال هذا الوقت
Dialogue: 0,0:29:21.85,0:29:25.05,Default,,0,0,0,,لقد دربوا سراً سبعة فقط؟
Dialogue: 0,0:29:28.55,0:29:30.46,Default,,0,0,0,,لقد نفد الدواء.
Dialogue: 0,0:29:30.49,0:29:34.03,Default,,0,0,0,,لولا المرض لكنت محارباً ممتازاً.
Dialogue: 0,0:29:34.03,0:29:35.59,Default,,0,0,0,,مازلت على قيد الحياة
Dialogue: 0,0:29:35.89,0:29:38.36,Default,,0,0,0,,فقط بفضل مساعدتكم.
Dialogue: 0,0:29:38.96,0:29:40.43,Default,,0,0,0,,شكرًا لك.
Dialogue: 0,0:29:45.90,0:29:49.01,Default,,0,0,0,,إذا ارتكبت خطأً مرة أخرى،
Dialogue: 0,0:29:49.04,0:29:51.48,Default,,0,0,0,,لن تتلقى المزيد من الدواء.
Dialogue: 0,0:29:52.11,0:29:53.71,Default,,0,0,0,,سوف أتذكر.
Dialogue: 0,0:30:08.69,0:30:10.53,Default,,0,0,0,,حتى الآن
Dialogue: 0,0:30:11.30,0:30:15.67,Default,,0,0,0,,كنا نظن أن الملكة سقطت في البحيرة لتلفيق التهمة للمحظية "تشو".
Dialogue: 0,0:30:16.14,0:30:20.51,Default,,0,0,0,,كنا نعتقد أنها كانت تكذب عمداً بشأن فقدان ذكرياتها.
Dialogue: 0,0:30:20.54,0:30:23.01,Default,,0,0,0,,لا أستطيع أن أصدق أنها حاولت الانتحار.
Dialogue: 0,0:30:23.01,0:30:26.21,Default,,0,0,0,,ربما كانت هذه هي الطريقة التي أرادت بها كسب ثقتك.
Dialogue: 0,0:30:26.41,0:30:29.55,Default,,0,0,0,,هل تعتقد أنها عرفت أنني سأحمي المحظية "تشو"؟
Dialogue: 0,0:30:29.55,0:30:31.88,Default,,0,0,0,,لا تدافع عنها،
Dialogue: 0,0:30:32.12,0:30:34.62,Default,,0,0,0,,ستلومها الملكة.
Dialogue: 0,0:30:34.62,0:30:36.39,Default,,0,0,0,,لقد فهمت،
Dialogue: 0,0:30:36.79,0:30:39.29,Default,,0,0,0,,مما يمكن أن يؤثر عليك بهذه الطريقة.
Dialogue: 0,0:30:41.79,0:30:45.30,Default,,0,0,0,,الأمير يونبيونغ، كما ترى
Dialogue: 0,0:30:45.30,0:30:47.63,Default,,0,0,0,,هناك نية شريرة في كل تصرفات الملكة.
Dialogue: 0,0:30:47.63,0:30:49.20,Default,,0,0,0,,الملكة -
Dialogue: 0,0:30:49.70,0:30:51.67,Default,,0,0,0,,دعم عائلة كيم.
Dialogue: 0,0:30:52.37,0:30:54.34,Default,,0,0,0,,أي نوع من الناس هم؟
Dialogue: 0,0:30:54.47,0:30:57.84,Default,,0,0,0,,إنهم الذين ذبحوا عائلتنا بأكملها.
Dialogue: 0,0:30:57.84,0:30:59.41,Default,,0,0,0,,أنا أبداً
Dialogue: 0,0:31:00.68,0:31:03.22,Default,,0,0,0,,لا أستطيع أن أنسى هذا.
Dialogue: 0,0:31:05.35,0:31:07.35,Default,,0,0,0,,لن أنسى هذا أيضًا.
Dialogue: 0,0:31:07.59,0:31:10.02,Default,,0,0,0,,ولكن انظر ماذا فعلت الملكة.
Dialogue: 0,0:31:10.12,0:31:13.83,Default,,0,0,0,,رغم محاولتي لقتلها وعدائي مع المحظية "تشو"،
Dialogue: 0,0:31:13.83,0:31:16.36,Default,,0,0,0,,لقد كشفت الحقيقة من أجلنا.
Dialogue: 0,0:31:17.06,0:31:20.80,Default,,0,0,0,,ما زلت أعتقد أن عدائك لها
Dialogue: 0,0:31:22.33,0:31:24.17,Default,,0,0,0,,تستحق؟
Dialogue: 0,0:31:25.54,0:31:29.01,Default,,0,0,0,,-جلالتك.\N-إذا كانت هذه محاولة انتحار،
Dialogue: 0,0:31:29.01,0:31:31.88,Default,,0,0,0,,ثم قتلت الملكة مرتين.
Dialogue: 0,0:31:58.10,0:31:59.97,Default,,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:31:59.97,0:32:02.57,Default,,0,0,0,,أريد التحدث معك.
Dialogue: 0,0:32:02.57,0:32:05.04,Default,,0,0,0,,أنت فقط تعقد كل شيء.
Dialogue: 0,0:32:05.24,0:32:08.38,Default,,0,0,0,,مصيري بين يدي عائلتك بالفعل.
Dialogue: 0,0:32:09.75,0:32:12.82,Default,,0,0,0,,في المرة القادمة سأقوم بتمرير الرسالة.
Dialogue: 0,0:32:13.69,0:32:15.42,Default,,0,0,0,,أنت لا تحبني،
Dialogue: 0,0:32:16.42,0:32:18.52,Default,,0,0,0,,لأنني من عائلة "أندونغ" لكيم؟
Dialogue: 0,0:32:18.52,0:32:20.66,Default,,0,0,0,,لم أقل أنني لا أحبك.
Dialogue: 0,0:32:20.83,0:32:22.89,Default,,0,0,0,,إذن أنت معجب بي؟
Dialogue: 0,0:32:30.40,0:32:33.14,Default,,0,0,0,,لو لم أكن من عشيرة أندون لكيم،
Dialogue: 0,0:32:34.51,0:32:36.84,Default,,0,0,0,,هل تريدني؟
Dialogue: 0,0:32:37.34,0:32:39.11,Default,,0,0,0,,لا، لا أعتقد ذلك.
Dialogue: 0,0:32:39.14,0:32:42.15,Default,,0,0,0,,لقد أصبحت ملكة بفضل عائلتك.
Dialogue: 0,0:32:43.68,0:32:46.32,Default,,0,0,0,,لقد بذلت الكثير من الجهد.
Dialogue: 0,0:32:46.62,0:32:49.42,Default,,0,0,0,,لم أرغب في أن أصبح ملكة بسبب عائلتي.
Dialogue: 0,0:32:49.72,0:32:52.72,Default,,0,0,0,,لقد كرست حياتي كلها لهذا، مهما قالوا.
Dialogue: 0,0:32:53.83,0:32:57.26,Default,,0,0,0,,غداً ستحصل على ما أردته بشدة.
Dialogue: 0,0:32:58.80,0:33:01.77,Default,,0,0,0,,لقد تأخر الوقت، وغدًا سيكون يومًا صعبًا.
Dialogue: 0,0:33:02.30,0:33:04.34,Default,,0,0,0,,عودوا إلى غرفكم.
Dialogue: 0,0:33:08.31,0:33:10.61,Default,,0,0,0,,يجب أن تحبني.
Dialogue: 0,0:33:15.45,0:33:17.78,Default,,0,0,0,,هل هذا أمر؟
Dialogue: 0,0:33:24.22,0:33:28.99,Default,,0,0,0,,لامبالاتي جعلتها تقفز إلى البحيرة.
Dialogue: 0,0:33:29.59,0:33:34.47,Default,,0,0,0,,إذا حاولت الانتحار بسبب لامبالاتك،
Dialogue: 0,0:33:34.93,0:33:36.97,Default,,0,0,0,,كانت ستقفز للتو في البحيرة.
Dialogue: 0,0:33:36.97,0:33:39.74,Default,,0,0,0,,لكنها زوّرت الرسالة وسقطت أمام المحظية "تشو".
Dialogue: 0,0:33:39.74,0:33:42.24,Default,,0,0,0,,أرى دافعاً خفياً هنا.
Dialogue: 0,0:33:42.91,0:33:44.41,Default,,0,0,0,,الدافع، تكلم.
Dialogue: 0,0:33:46.21,0:33:48.51,Default,,0,0,0,,أحتاج لرؤية الملكة.
Dialogue: 0,0:33:49.28,0:33:52.32,Default,,0,0,0,,المجرمون لا يخفون ابتسامتهم.
Dialogue: 0,0:33:52.38,0:33:55.19,Default,,0,0,0,,إذا كان هناك دافع خفي في أفعالها،
Dialogue: 0,0:33:56.42,0:33:59.26,Default,,0,0,0,,أستطيع أن أعرف من خلال سلوكها.
Dialogue: 0,0:33:59.69,0:34:03.09,Default,,0,0,0,,اعتني بالمحظية "تشو" الآن.
Dialogue: 0,0:34:23.62,0:34:26.65,Default,,0,0,0,,تظاهري بأنك الملكة المثالية لمدة 15 يومًا.
Dialogue: 0,0:34:26.79,0:34:28.65,Default,,0,0,0,,هل يمكنني التعامل مع الأمر؟
Dialogue: 0,0:34:28.72,0:34:32.49,Default,,0,0,0,,إذا لم أستطع فسأبقى في هذا الجسد المختنق،
Dialogue: 0,0:34:32.62,0:34:36.63,Default,,0,0,0,,إلى جانب ذلك، خلف القضبان كملكة معزولة في عصر جوسون.
Dialogue: 0,0:34:41.07,0:34:44.34,Default,,0,0,0,,لقد حفرت قبري بنفسي. من هو المسؤول؟
Dialogue: 0,0:34:44.60,0:34:48.97,Default,,0,0,0,,جلالة الملك، لقد أتى الملك.
Dialogue: 0,0:34:48.97,0:34:53.01,Default,,0,0,0,,بالطبع تشيولجونغ.\N إنه خطأه.
Dialogue: 0,0:34:53.25,0:34:56.42,Default,,0,0,0,,لم أكن لأدافع عنها لو لم يكن بهذه الروعة.
Dialogue: 0,0:34:56.42,0:34:57.85,Default,,0,0,0,,مفتوح.
Dialogue: 0,0:34:57.95,0:35:01.62,Default,,0,0,0,,وحتى قبل ذلك ارتكب خطأً فادحاً.
Dialogue: 0,0:35:04.09,0:35:05.59,Default,,0,0,0,,هذه المرأة لن تحاول
Dialogue: 0,0:35:05.59,0:35:07.23,Default,,0,0,0,,يغرق لو كان ألطف معها.
Dialogue: 0,0:35:07.23,0:35:09.93,Default,,0,0,0,,-لا، لو كان قد فعل هذا من قبل...\N-ملكتي.
Dialogue: 0,0:35:10.80,0:35:12.80,Default,,0,0,0,,كيف تشعر؟
Dialogue: 0,0:35:14.13,0:35:17.64,Default,,0,0,0,,لقد وضعت سيفاً على رقبتي،\N من أين يأتي هذا القلق؟
Dialogue: 0,0:35:20.27,0:35:23.44,Default,,0,0,0,,لم أحظى بيوم واحد هادئ هنا.
Dialogue: 0,0:35:23.44,0:35:25.58,Default,,0,0,0,,لقد فتحت عيني للتو، وغدًا حفل الزفاف.
Dialogue: 0,0:35:25.58,0:35:28.61,Default,,0,0,0,,الزوج الذي أتقاسم معه نفس البطانية يحاول قتلي.
Dialogue: 0,0:35:28.61,0:35:32.12,Default,,0,0,0,,وحتى عائلتي\N تهدد بالإطاحة بي.
Dialogue: 0,0:35:33.75,0:35:34.82,Default,,0,0,0,,الإطاحة؟
Dialogue: 0,0:35:34.82,0:35:36.66,Default,,0,0,0,,ماذا؟ مغريا؟
Dialogue: 0,0:35:36.66,0:35:40.56,Default,,0,0,0,,يا لها من فرصة جيدة لاستبدالي بـ "تشو هواجين"، هاه؟
Dialogue: 0,0:35:40.56,0:35:43.06,Default,,0,0,0,,لماذا أنت متحمس جداً؟
Dialogue: 0,0:35:43.10,0:35:45.43,Default,,0,0,0,,لم آت للقتال معك.
Dialogue: 0,0:35:45.43,0:35:48.23,Default,,0,0,0,,مجرد النظر إليك يغضبني.
Dialogue: 0,0:35:48.23,0:35:49.40,Default,,0,0,0,,هل فكرت في ذلك؟
Dialogue: 0,0:35:49.40,0:35:51.07,Default,,0,0,0,,أنت الذي حاولت قتلي،
Dialogue: 0,0:35:51.07,0:35:53.64,Default,,0,0,0,,والشخص الذي أنت مستعد للموت من أجله.
Dialogue: 0,0:35:54.14,0:35:56.31,Default,,0,0,0,,أنا على وشك الموت وأنا أحاول إنقاذكما.
Dialogue: 0,0:35:56.31,0:35:59.41,Default,,0,0,0,,نعم سيقتلونني قبل أن أنتحر.
Dialogue: 0,0:35:59.74,0:36:04.35,Default,,0,0,0,,سيشعر أي شخص في مكاني بالغضب الآن لو لم يكن بوذا.
Dialogue: 0,0:36:06.15,0:36:08.39,Default,,0,0,0,,أفهم أنك غاضب جدًا مني.
Dialogue: 0,0:36:08.39,0:36:09.79,Default,,0,0,0,,توقف.
Dialogue: 0,0:36:10.02,0:36:11.32,Default,,0,0,0,,لا حاجة.
Dialogue: 0,0:36:11.32,0:36:13.16,Default,,0,0,0,,لا تجرؤ على التحدث،
Dialogue: 0,0:36:13.16,0:36:15.29,Default,,0,0,0,,إنك تفهمني.
Dialogue: 0,0:36:17.46,0:36:19.06,Default,,0,0,0,,كان عليك أن تفهمني
Dialogue: 0,0:36:19.06,0:36:22.33,Default,,0,0,0,,قبل أن أضع السيف على رقبتي.
Dialogue: 0,0:36:22.37,0:36:26.20,Default,,0,0,0,,لا. كان عليك أن تفهم هذه المرأة من قبل
Dialogue: 0,0:36:26.54,0:36:30.21,Default,,0,0,0,,كيف حاولت الانتحار.
Dialogue: 0,0:36:31.44,0:36:34.68,Default,,0,0,0,,لقد مرت اللحظة. ليس هناك فائدة من قول أي شيء.
Dialogue: 0,0:36:35.61,0:36:39.48,Default,,0,0,0,,اذهب بعيداً بالفعل. لقد كنت متعبا بينما كنت غاضبا.
Dialogue: 0,0:36:41.95,0:36:44.86,Default,,0,0,0,,سأعود عندما تشعر بالتحسن.
Dialogue: 0,0:36:46.89,0:36:50.33,Default,,0,0,0,,لا تأتي إلا إذا كنت مستعداً للتسول على ركبتيك.
Dialogue: 0,0:36:52.60,0:36:54.27,Default,,0,0,0,,سأعود.
Dialogue: 0,0:36:56.17,0:36:59.97,Default,,0,0,0,,قلت لك ألا تأتي!
Dialogue: 0,0:37:30.60,0:37:33.37,Default,,0,0,0,,هل يملأون البحيرة مرة أخرى؟
Dialogue: 0,0:37:34.24,0:37:38.28,Default,,0,0,0,,سألت صاحبة الجلالة الملكة الأرملة عن هذا الأمر.
Dialogue: 0,0:37:38.28,0:37:39.71,Default,,0,0,0,,لماذا؟
Dialogue: 0,0:37:40.01,0:37:42.01,Default,,0,0,0,,لا أعرف بالضبط،
Dialogue: 0,0:37:42.55,0:37:45.72,Default,,0,0,0,,لكنني سمعت أن صاحبة الجلالة ذهبت إلى البحيرة
Dialogue: 0,0:37:45.72,0:37:49.22,Default,,0,0,0,,وراقبت كل شيء شخصياً.
Dialogue: 0,0:38:04.20,0:38:05.67,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:38:06.47,0:38:08.84,Default,,0,0,0,,آسف على إزعاجك.
Dialogue: 0,0:38:13.08,0:38:15.35,Default,,0,0,0,,كنت أخشى أن أخسرك.
Dialogue: 0,0:38:19.42,0:38:21.49,Default,,0,0,0,,ألم تتأذى؟
Dialogue: 0,0:38:22.39,0:38:24.36,Default,,0,0,0,,جرحك يؤلمك أكثر،
Dialogue: 0,0:38:25.49,0:38:28.19,Default,,0,0,0,,أكثر مني.
Dialogue: 0,0:38:30.50,0:38:32.06,Default,,0,0,0,,اليوم
Dialogue: 0,0:38:33.10,0:38:35.83,Default,,0,0,0,,كان الأمر صعباً جداً عليك.
Dialogue: 0,0:38:36.57,0:38:40.67,Default,,0,0,0,,آسف على جرك إلى هذا.
Dialogue: 0,0:38:41.57,0:38:44.04,Default,,0,0,0,,لابد أن ذلك كان صعباً جداً عليك
Dialogue: 0,0:38:44.04,0:38:46.58,Default,,0,0,0,,بسبب كل هذه المشاكل في القصر.
Dialogue: 0,0:38:46.58,0:38:49.08,Default,,0,0,0,,لا أريدك أن تعاني.
Dialogue: 0,0:38:49.55,0:38:52.08,Default,,0,0,0,,لذا لا تفعل ذلك مرة أخرى.
Dialogue: 0,0:38:52.52,0:38:55.29,Default,,0,0,0,,إذا ضحيت بنفسك من أجلي،
Dialogue: 0,0:38:55.55,0:38:57.86,Default,,0,0,0,,كيف أتعامل مع هذا؟
Dialogue: 0,0:38:58.06,0:39:02.56,Default,,0,0,0,,لن أفعل ما تخاف منه.
Dialogue: 0,0:39:03.73,0:39:05.90,Default,,0,0,0,,حتى يستقر كل شيء،
Dialogue: 0,0:39:06.23,0:39:09.30,Default,,0,0,0,,الأمير يونبيونغ سوف يحرسك شخصياً.
Dialogue: 0,0:39:11.84,0:39:14.91,Default,,0,0,0,,ما مشكلة "أوفول"؟
Dialogue: 0,0:39:15.21,0:39:17.61,Default,,0,0,0,,-حسناً...\N-سيد. لقد وصل هونغ.
Dialogue: 0,0:39:18.44,0:39:19.88,Default,,0,0,0,,أدخل.
Dialogue: 0,0:39:23.11,0:39:24.48,Default,,0,0,0,,كخادمة للمحظية "تشو"؟
Dialogue: 0,0:39:24.48,0:39:26.78,Default,,0,0,0,,إنها في المستشفى الآن.
Dialogue: 0,0:39:28.62,0:39:30.69,Default,,0,0,0,,سيعتني أخي بكل شيء.
Dialogue: 0,0:39:31.42,0:39:32.92,Default,,0,0,0,,شكرًا لك.
Dialogue: 0,0:39:36.93,0:39:39.00,Default,,0,0,0,,هل قابلت الملكة؟
Dialogue: 0,0:39:40.20,0:39:41.23,Default,,0,0,0,,نعم.
Dialogue: 0,0:39:41.23,0:39:43.90,Default,,0,0,0,,-كيف حالها؟\N-كانت غاضبة.
Dialogue: 0,0:39:44.74,0:39:46.20,Default,,0,0,0,,-ماذا؟\N-ألومني
Dialogue: 0,0:39:46.20,0:39:48.27,Default,,0,0,0,,أنه دفعها إلى الانتحار.
Dialogue: 0,0:39:48.27,0:39:51.18,Default,,0,0,0,,تكرهني لمحاولتي قتلها.
Dialogue: 0,0:39:51.18,0:39:53.38,Default,,0,0,0,,تطغى عليها العواطف.
Dialogue: 0,0:39:53.51,0:39:55.58,Default,,0,0,0,,إذا أرادت أن تفوز بي،
Dialogue: 0,0:39:55.58,0:39:57.25,Default,,0,0,0,,إذن لن أتصرف بهذه الطريقة.
Dialogue: 0,0:39:57.25,0:39:58.75,Default,,0,0,0,,والمزيد
Dialogue: 0,0:39:59.05,0:40:02.02,Default,,0,0,0,,آل كيم يهددون بالإطاحة بها.
Dialogue: 0,0:40:02.82,0:40:05.29,Default,,0,0,0,,كيم بيونغين لا يعرف بعد،
Dialogue: 0,0:40:05.29,0:40:08.03,Default,,0,0,0,,تلك القصاصة من ملابسك.
Dialogue: 0,0:40:08.13,0:40:09.56,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:40:10.13,0:40:12.36,Default,,0,0,0,,الملكة لم تقل شيئاً.
Dialogue: 0,0:40:12.36,0:40:14.20,Default,,0,0,0,,لا أعرف نواياها،
Dialogue: 0,0:40:14.43,0:40:17.10,Default,,0,0,0,,ولكن يبدو أنه يتصرف من تلقاء نفسه.
Dialogue: 0,0:40:18.00,0:40:19.47,Default,,0,0,0,,ظننت أنني سأفهم،
Dialogue: 0,0:40:19.47,0:40:22.54,Default,,0,0,0,,أي نوع من الأشخاص هي، بناءً على تصرفاتها.
Dialogue: 0,0:40:23.71,0:40:25.48,Default,,0,0,0,,لكنها حيرتني أكثر.
Dialogue: 0,0:40:32.65,0:40:34.82,Default,,0,0,0,,أبي، هذه بنين.
Dialogue: 0,0:40:34.82,0:40:36.45,Default,,0,0,0,,نعم. ادخل.
Dialogue: 0,0:40:46.56,0:40:49.13,Default,,0,0,0,,ظننت أنك أقلعت عن التدخين.
Dialogue: 0,0:40:49.87,0:40:51.34,Default,,0,0,0,,مهجور.
Dialogue: 0,0:40:58.48,0:41:00.51,Default,,0,0,0,,آسف بشأن اليوم.
Dialogue: 0,0:41:01.48,0:41:03.51,Default,,0,0,0,,لماذا تعتذر؟
Dialogue: 0,0:41:04.08,0:41:06.32,Default,,0,0,0,,ماذا ستفعل بعد ذلك؟
Dialogue: 0,0:41:07.15,0:41:09.09,Default,,0,0,0,,سأحاول أن أتفاهم معها.
Dialogue: 0,0:41:09.09,0:41:12.09,Default,,0,0,0,,وإذا لم تفهم، فلن تكون موجودة.
Dialogue: 0,0:41:13.46,0:41:16.26,Default,,0,0,0,,عمن تتحدث؟
Dialogue: 0,0:41:17.03,0:41:18.73,Default,,0,0,0,,عن أي شخص.
Dialogue: 0,0:41:18.73,0:41:21.37,Default,,0,0,0,,لا يوجد حليف لعدة قرون.
Dialogue: 0,0:41:24.77,0:41:28.14,Default,,0,0,0,,أخشى أن الآن ليس الوقت المناسب لذلك،
Dialogue: 0,0:41:28.37,0:41:30.27,Default,,0,0,0,,ولكن يجب أن أخبرك.
Dialogue: 0,0:41:30.78,0:41:32.34,Default,,0,0,0,,حسنًا. ماذا هناك؟
Dialogue: 0,0:41:32.81,0:41:36.95,Default,,0,0,0,,قررت إلى أي مدى سأذهب في تحقيق حلمي.
Dialogue: 0,0:41:37.18,0:41:39.65,Default,,0,0,0,,سعيد جدًا لسماع ذلك.
Dialogue: 0,0:41:39.98,0:41:41.39,Default,,0,0,0,,أي موقف؟
Dialogue: 0,0:41:41.39,0:41:43.49,Default,,0,0,0,,سأكون رئيس قسم المباحث.
Dialogue: 0,0:41:43.66,0:41:45.42,Default,,0,0,0,,قسم المباحث؟
Dialogue: 0,0:41:45.99,0:41:49.26,Default,,0,0,0,,هل حلمت بأن تكون محارباً؟
Dialogue: 0,0:41:49.26,0:41:52.60,Default,,0,0,0,,سأبدأ بمنصب يمكنني التعامل معه،
Dialogue: 0,0:41:52.60,0:41:54.63,Default,,0,0,0,,وسأختار طريقي.
Dialogue: 0,0:41:54.90,0:41:56.30,Default,,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:41:58.04,0:42:01.34,Default,,0,0,0,,هل تقول أنك تريد اختيار المسار الخاص بك؟
Dialogue: 0,0:42:10.58,0:42:12.95,Default,,0,0,0,,لقد وصلت المحظية الملكية.
Dialogue: 0,0:42:15.22,0:42:17.02,Default,,0,0,0,,لا تتحرك.
Dialogue: 0,0:42:23.50,0:42:24.93,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,0:42:30.47,0:42:31.90,Default,,0,0,0,,عذراً.
Dialogue: 0,0:42:32.50,0:42:35.37,Default,,0,0,0,,كان عليّ أن أقف حتى النهاية.
Dialogue: 0,0:42:36.17,0:42:38.84,Default,,0,0,0,,ركبتيك المكسورة دليل على ذلك.
Dialogue: 0,0:42:39.64,0:42:41.11,Default,,0,0,0,,أعلم.
Dialogue: 0,0:42:42.65,0:42:44.58,Default,,0,0,0,,هذا لا شيء.
Dialogue: 0,0:42:45.18,0:42:47.39,Default,,0,0,0,,يومان مع الأعشاب الطبية،
Dialogue: 0,0:42:47.39,0:42:50.05,Default,,0,0,0,,وسأستيقظ في أسرع وقت.
Dialogue: 0,0:42:50.79,0:42:54.26,Default,,0,0,0,,نعم. ليس لدي أدنى شك أنك سوف تتحسن.
Dialogue: 0,0:42:55.89,0:42:58.20,Default,,0,0,0,,من يستطيع أن يعاملك بهذه القسوة؟
Dialogue: 0,0:42:58.86,0:43:02.17,Default,,0,0,0,,لم أر وجهه، كان يرتدي قناعاً.
Dialogue: 0,0:43:03.33,0:43:05.74,Default,,0,0,0,,لكنني أتذكر الصوت.
Dialogue: 0,0:43:06.70,0:43:08.14,Default,,0,0,0,,صاحب السمو.
Dialogue: 0,0:43:08.94,0:43:10.54,Default,,0,0,0,,آسف لقول هذا.
Dialogue: 0,0:43:10.98,0:43:13.18,Default,,0,0,0,,إذا أصيب شخص ليس من العائلة المالكة،
Dialogue: 0,0:43:13.21,0:43:15.41,Default,,0,0,0,,لا يستطيع البقاء في القصر.
Dialogue: 0,0:43:15.85,0:43:18.72,Default,,0,0,0,,لكن كيف يمكنها المغادرة وهي في مثل هذه الحالة؟
Dialogue: 0,0:43:18.72,0:43:20.95,Default,,0,0,0,,هذه عادة القصر.
Dialogue: 0,0:43:21.65,0:43:24.49,Default,,0,0,0,,ليس هناك شفقة في هذا المكان.
Dialogue: 0,0:43:31.20,0:43:33.16,Default,,0,0,0,,إن كان هناك أحد في الطريق
Dialogue: 0,0:43:33.36,0:43:35.97,Default,,0,0,0,,سيحاول إيذائك، ويستخدمه كرشوة.
Dialogue: 0,0:43:36.20,0:43:38.04,Default,,0,0,0,,غادرت القصر بنجاح،
Dialogue: 0,0:43:38.04,0:43:39.80,Default,,0,0,0,,استفد من هذا لتعيش براحة.
Dialogue: 0,0:43:39.80,0:43:41.87,Default,,0,0,0,,لا، كثيرًا.
Dialogue: 0,0:43:42.64,0:43:44.81,Default,,0,0,0,,سأرسل رسالة إلى عائلتي.
Dialogue: 0,0:43:44.88,0:43:46.61,Default,,0,0,0,,لا تقلق.
Dialogue: 0,0:43:49.55,0:43:52.68,Default,,0,0,0,,شكرًا على خدمتك.
Dialogue: 0,0:43:53.15,0:43:56.25,Default,,0,0,0,,أشعر بالخجل الشديد من النظر إلى وجه السيد "تشو".
Dialogue: 0,0:43:56.96,0:43:58.56,Default,,0,0,0,,لا أستطيع الذهاب.
Dialogue: 0,0:43:59.62,0:44:03.26,Default,,0,0,0,,أوفول، لقد نشأنا أنا وأنت معًا.
Dialogue: 0,0:44:03.66,0:44:06.00,Default,,0,0,0,,أنتم عائلتي.
Dialogue: 0,0:44:06.80,0:44:08.50,Default,,0,0,0,,عليك أن تصمد هناك،
Dialogue: 0,0:44:09.07,0:44:10.67,Default,,0,0,0,,حتى أستطيع ذلك أيضاً.
Dialogue: 0,0:44:11.90,0:44:14.31,Default,,0,0,0,,كن شجاعاً من أجلي.
Dialogue: 0,0:44:14.91,0:44:16.51,Default,,0,0,0,,يجب أن تعيش.
Dialogue: 0,0:44:18.28,0:44:19.94,Default,,0,0,0,,افعلها من أجلي.
Dialogue: 0,0:44:49.71,0:44:52.18,Default,,0,0,0,,-ماذا حدث؟\N -أمس كان منزلاً للمجانين.
Dialogue: 0,0:44:52.18,0:44:53.78,Default,,0,0,0,,الملكة...
Dialogue: 0,0:44:56.45,0:44:57.92,Default,,0,0,0,,يا سيدي.
Dialogue: 0,0:44:58.62,0:45:00.18,Default,,0,0,0,,هل سمعت؟
Dialogue: 0,0:45:00.18,0:45:03.49,Default,,0,0,0,,ألقى جلالته الرعد والبرق على الملكة الأرملة بعينيه.
Dialogue: 0,0:45:03.49,0:45:05.29,Default,,0,0,0,,كانت العيون مثل التفاح.
Dialogue: 0,0:45:06.76,0:45:08.66,Default,,0,0,0,,مرحبًا.
Dialogue: 0,0:45:08.93,0:45:12.76,Default,,0,0,0,,التقطها جلالته مباشرة أمام الملكة و...
Dialogue: 0,0:45:15.57,0:45:17.77,Default,,0,0,0,,الشيف الملكي، هل سمعت؟
Dialogue: 0,0:45:17.77,0:45:21.71,Default,,0,0,0,,أمسك جلالته بالسيف، والملكة الأرملة...
Dialogue: 0,0:45:24.34,0:45:25.88,Default,,0,0,0,,هل سمعت أنه كان هناك شيء ما في قاعة تونجونجونج؟
Dialogue: 0,0:45:25.88,0:45:27.71,Default,,0,0,0,,سمعت أنهم يفعلون هذا طوال الوقت.
Dialogue: 0,0:45:42.73,0:45:46.60,Default,,0,0,0,,سيتم تعيين رئيس قسم المباحث اليوم.
Dialogue: 0,0:45:46.80,0:45:48.30,Default,,0,0,0,,هل سيكون كذلك؟
Dialogue: 0,0:45:49.63,0:45:51.74,Default,,0,0,0,,لدينا طلب مهمة.
Dialogue: 0,0:45:52.10,0:45:53.47,Default,,0,0,0,,ومن الموصى به
Dialogue: 0,0:45:53.47,0:45:56.37,Default,,0,0,0,,لمنصب رئيس قسم المباحث؟
Dialogue: 0,0:45:56.37,0:45:59.51,Default,,0,0,0,,بيونين من عشيرة أندونغ كيم.
Dialogue: 0,0:46:05.52,0:46:07.89,Default,,0,0,0,,غير متوقع على الإطلاق.
Dialogue: 0,0:46:07.92,0:46:10.32,Default,,0,0,0,,أنا متأكد من أن هناك العديد من المرشحين لهذا المنصب.
Dialogue: 0,0:46:10.32,0:46:13.59,Default,,0,0,0,,إذا قمت بتعيين شخص اجتاز امتحان الخدمة المدنية كرئيس،
Dialogue: 0,0:46:13.59,0:46:15.36,Default,,0,0,0,,ستكون هناك شكاوى، ألا تعتقد ذلك؟
Dialogue: 0,0:46:15.36,0:46:18.73,Default,,0,0,0,,لقد اتفقنا بالإجماع\N على هذه التوصية.
Dialogue: 0,0:46:20.43,0:46:22.10,Default,,0,0,0,,بالإجماع؟
Dialogue: 0,0:46:22.70,0:46:27.17,Default,,0,0,0,,لم أتوقع مثل هذه العلاقات المتناغمة بين رعاياي.
Dialogue: 0,0:46:28.17,0:46:32.21,Default,,0,0,0,,سمعت أنه شخص رائع.
Dialogue: 0,0:46:36.58,0:46:39.68,Default,,0,0,0,,هل تم إعداد الإشعار الملكي بالتعيين بعد؟
Dialogue: 0,0:46:40.02,0:46:44.56,Default,,0,0,0,,لمواكبة قراراتك السريعة،
Dialogue: 0,0:46:44.56,0:46:47.32,Default,,0,0,0,,ربما ينبغي علي تقليل وقت نومي.
Dialogue: 0,0:46:47.46,0:46:49.43,Default,,0,0,0,,لا تقل ذلك.
Dialogue: 0,0:46:49.43,0:46:52.56,Default,,0,0,0,,عليك أن تعتني بصحتك وتنتج وريثاً.
Dialogue: 0,0:46:53.76,0:46:57.60,Default,,0,0,0,,ليس ملكاً، بل حصاناً للتربية.
Dialogue: 0,0:47:12.02,0:47:18.02,Default,,0,0,0,,لقد كنت دائماً متواضعاً. \NDon't تفقده--التواضع.
Dialogue: 0,0:47:18.09,0:47:20.96,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:47:30.27,0:47:32.04,Default,,0,0,0,,بونغيانغ تشو كلان
Dialogue: 0,0:47:32.04,0:47:34.37,Default,,0,0,0,,جلبت المتاعب لنفسي.
Dialogue: 0,0:47:34.37,0:47:36.84,Default,,0,0,0,,بسبب اعتراف المحظية الكاذب
Dialogue: 0,0:47:37.61,0:47:40.04,Default,,0,0,0,,لقد شهدنا مثل هذا الإذلال.
Dialogue: 0,0:47:47.22,0:47:51.26,Default,,0,0,0,,الفشل سبب وليس نتيجة.
Dialogue: 0,0:47:51.39,0:47:52.82,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:47:53.09,0:47:55.96,Default,,0,0,0,,هكذا قالت الملكة الأم.
Dialogue: 0,0:47:56.29,0:47:58.50,Default,,0,0,0,,اتفقنا على تعيين كيم بيونغين
Dialogue: 0,0:47:58.50,0:48:01.90,Default,,0,0,0,,وساعدهم على تعزيز مواقفهم،
Dialogue: 0,0:48:02.20,0:48:04.13,Default,,0,0,0,,لأننا خسرنا.
Dialogue: 0,0:48:04.14,0:48:07.30,Default,,0,0,0,,كلما زادت الهزائم، قلّت فرصنا في الفوز.
Dialogue: 0,0:48:07.47,0:48:08.94,Default,,0,0,0,,قالت،
Dialogue: 0,0:48:09.67,0:48:12.48,Default,,0,0,0,,علينا أن نأخذ الخطوة الأولى.
Dialogue: 0,0:48:40.20,0:48:42.41,Default,,0,0,0,,هل تعتقد أن أوفول سيتمكن من التعافي؟
Dialogue: 0,0:48:42.41,0:48:44.38,Default,,0,0,0,,سأتحقق من شعورها.
Dialogue: 0,0:48:44.38,0:48:47.44,Default,,0,0,0,,إنها نشطة، لذا فهي تندفع باستمرار.
Dialogue: 0,0:48:48.55,0:48:51.25,Default,,0,0,0,,الآن لن يتمكن من فعل ذلك.
Dialogue: 0,0:48:52.05,0:48:54.85,Default,,0,0,0,,لو أنها لم تأتي معي إلى القصر،..
Dialogue: 0,0:48:56.92,0:48:58.89,Default,,0,0,0,,لا تفكر في الأمر كثيرًا.
Dialogue: 0,0:48:59.12,0:49:01.29,Default,,0,0,0,,أحيانًا يمكن للأفكار أن تقودك إلى المستنقع.
Dialogue: 0,0:49:01.89,0:49:04.80,Default,,0,0,0,,وكلما قاتلت بقوة، كلما تعمقت المعركة. \NIt سوف يضر أكثر من ذلك.
Dialogue: 0,0:49:06.66,0:49:08.43,Default,,0,0,0,,ماذا تفعل،
Dialogue: 0,0:49:08.47,0:49:11.30,Default,,0,0,0,,لتصفية ذهنك من كثرة الأفكار؟
Dialogue: 0,0:49:11.70,0:49:13.17,Default,,0,0,0,,أنا
Dialogue: 0,0:49:14.51,0:49:16.41,Default,,0,0,0,,الذهاب إلى السيد هونغ.
Dialogue: 0,0:49:16.74,0:49:18.94,Default,,0,0,0,,يمكنه أن يريحك.
Dialogue: 0,0:49:18.94,0:49:21.71,Default,,0,0,0,,إنه أحمق.
Dialogue: 0,0:49:22.41,0:49:24.52,Default,,0,0,0,,يغضبني.
Dialogue: 0,0:49:24.72,0:49:26.42,Default,,0,0,0,,وعندما أفرغ غضبي عليه،
Dialogue: 0,0:49:27.92,0:49:30.55,Default,,0,0,0,,ثم أخرج من المستنقع دون أن ألاحظ ذلك.
Dialogue: 0,0:49:33.82,0:49:38.03,Default,,0,0,0,,إذن هل يمكنك أن تغضبني؟
Dialogue: 0,0:49:40.26,0:49:42.70,Default,,0,0,0,,-هذا...\N-أو...
Dialogue: 0,0:50:33.88,0:50:35.89,Default,,0,0,0,,لا تتحرك.
Dialogue: 0,0:50:54.17,0:50:55.74,Default,,0,0,0,,لقد انتهيت.
Dialogue: 0,0:51:00.24,0:51:01.65,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:51:01.65,0:51:04.85,Default,,0,0,0,,لا مشكلة.
Dialogue: 0,0:51:08.05,0:51:09.65,Default,,0,0,0,,هل يؤلمك شيء؟
Dialogue: 0,0:51:10.92,0:51:13.99,Default,,0,0,0,,لا يمكنك لمسي.
Dialogue: 0,0:51:17.86,0:51:20.96,Default,,0,0,0,,أصبت بتشنج عضلي.
Dialogue: 0,0:51:22.47,0:51:25.30,Default,,0,0,0,,لقد كان وقتاً طويلاً، أليس كذلك؟
Dialogue: 0,0:51:25.30,0:51:26.84,Default,,0,0,0,,شكراً لله.
Dialogue: 0,0:51:28.11,0:51:30.64,Default,,0,0,0,,كنت شديد التركيز لدرجة أنك نسيت الوقت.
Dialogue: 0,0:51:44.86,0:51:48.06,Default,,0,0,0,,إذا كنت تريد التطريز،\Nفكان عليك الذهاب إلى قاعة دايجوجون.
Dialogue: 0,0:51:48.06,0:51:50.63,Default,,0,0,0,,ماذا نسيت في المطبخ؟
Dialogue: 0,0:51:56.40,0:51:59.10,Default,,0,0,0,,هل أنت حقاً تطرز شيئاً ما؟
Dialogue: 0,0:52:01.94,0:52:04.78,Default,,0,0,0,,لقد وعدت بأن أحوّل نفسي إلى ملكة مثالية.
Dialogue: 0,0:52:06.24,0:52:08.11,Default,,0,0,0,,مثالي، أليس كذلك؟
Dialogue: 0,0:52:09.85,0:52:12.98,Default,,0,0,0,,لا يوجد شيء لتفعله؟ أعطني بعض العمل؟
Dialogue: 0,0:52:12.98,0:52:14.72,Default,,0,0,0,,ظهري.
Dialogue: 0,0:52:15.05,0:52:17.42,Default,,0,0,0,,ومتى سأكتشف كل هذا؟
Dialogue: 0,0:52:19.16,0:52:20.72,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:52:23.06,0:52:25.70,Default,,0,0,0,,-أدخل.\N-انتظر.
Dialogue: 0,0:52:34.84,0:52:36.97,Default,,0,0,0,,هل هذه من قاعة Dongmyeongjong؟
Dialogue: 0,0:52:36.97,0:52:38.71,Default,,0,0,0,,-نعم يا صاحب الجلالة. \N-هيا.
Dialogue: 0,0:52:44.48,0:52:46.62,Default,,0,0,0,,لقد جربت أطباقي،
Dialogue: 0,0:52:46.62,0:52:49.09,Default,,0,0,0,,تبدو الأشياء القديمة مملة لها الآن.
Dialogue: 0,0:53:00.03,0:53:02.13,Default,,0,0,0,,حسنًا. خذ هذا إلى الاسطبلات.
Dialogue: 0,0:53:02.13,0:53:05.90,Default,,0,0,0,,إذا قاموا بتغطية محفة الطعام ببطانية بهذا الحجم،
Dialogue: 0,0:53:05.90,0:53:07.54,Default,,0,0,0,,الطعام لن يبرد.
Dialogue: 0,0:53:07.54,0:53:09.37,Default,,0,0,0,,قل لهم أن يحاولوا.
Dialogue: 0,0:53:09.37,0:53:10.84,Default,,0,0,0,,حسنًا.
Dialogue: 0,0:53:14.14,0:53:16.48,Default,,0,0,0,,هل ستسرع إلى البحيرة حالما تتخلص مني؟
Dialogue: 0,0:53:16.65,0:53:19.48,Default,,0,0,0,,هل رأيت أحداً يعمل بجد وهو على وشك الموت؟
Dialogue: 0,0:53:19.65,0:53:22.05,Default,,0,0,0,,ويبدو أنك نسيت، لقد أصبح ال\Nهذا هو القاعدة،
Dialogue: 0,0:53:22.05,0:53:24.29,Default,,0,0,0,,لكنني تحت كاميرات المراقبة.
Dialogue: 0,0:53:32.83,0:53:34.83,Default,,0,0,0,,ما الذي يقلقك؟
Dialogue: 0,0:53:40.27,0:53:44.07,Default,,0,0,0,,حسناً، دعنا نذهب لنصنع المعجزات؟
Dialogue: 0,0:53:53.02,0:53:54.52,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:53:55.39,0:53:56.82,Default,,0,0,0,,نعم!
Dialogue: 0,0:54:06.90,0:54:08.37,Default,,0,0,0,,جلالتك!
Dialogue: 0,0:54:08.67,0:54:10.90,Default,,0,0,0,,مرحبًا. هل قطعت اللحم؟
Dialogue: 0,0:54:10.90,0:54:12.40,Default,,0,0,0,,نعم.
Dialogue: 0,0:54:12.77,0:54:14.34,Default,,0,0,0,,احضر هنا بسرعة.
Dialogue: 0,0:54:15.61,0:54:17.54,Default,,0,0,0,,أحضر لي بعض الملح.
Dialogue: 0,0:54:17.54,0:54:20.01,Default,,0,0,0,,الملكة تريدني أن أخدمها أولاً.
Dialogue: 0,0:54:27.12,0:54:28.59,Default,,0,0,0,,واو.
Dialogue: 0,0:54:29.75,0:54:32.12,Default,,0,0,0,,حسناً، حسناً، افعل ما تريد.
Dialogue: 0,0:54:32.92,0:54:34.93,Default,,0,0,0,,دعونا نرى ما سيحدث.
Dialogue: 0,0:54:45.00,0:54:48.04,Default,,0,0,0,,هل يجب أن أطلب من الملكة الطبخ؟
Dialogue: 0,0:54:50.04,0:54:53.61,Default,,0,0,0,,جلالتك، هذا هو رئيس المفتشين.
Dialogue: 0,0:54:53.61,0:54:57.78,Default,,0,0,0,,لقد أعدت الملكة الغداء لك.
Dialogue: 0,0:55:01.25,0:55:03.79,Default,,0,0,0,,قل له أن يأخذها بعيداً؟
Dialogue: 0,0:55:06.56,0:55:07.99,Default,,0,0,0,,أيها الأمهات.
Dialogue: 0,0:55:07.99,0:55:09.53,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:55:11.16,0:55:14.16,Default,,0,0,0,,حسناً، ليس هناك طعام شهي على الإطلاق.
Dialogue: 0,0:55:16.60,0:55:18.07,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:55:18.17,0:55:21.77,Default,,0,0,0,,لقد وصل غداءك، ولكن...
Dialogue: 0,0:55:35.65,0:55:37.39,Default,,0,0,0,,كن حذراً.
Dialogue: 0,0:55:40.72,0:55:43.26,Default,,0,0,0,,وهذا...
Dialogue: 0,0:56:08.69,0:56:11.05,Default,,0,0,0,,قالت الملكة ذلك
Dialogue: 0,0:56:11.05,0:56:16.93,Default,,0,0,0,,موضوع غداء اليوم هو HSNV.
Dialogue: 0,0:56:17.63,0:56:20.06,Default,,0,0,0,,HSNV؟
Dialogue: 0,0:56:21.13,0:56:23.50,Default,,0,0,0,,لم أسمع بهذا من قبل.
Dialogue: 0,0:56:23.50,0:56:25.07,Default,,0,0,0,,هل هذا منسيوس؟
Dialogue: 0,0:56:25.17,0:56:28.51,Default,,0,0,0,,لا، ليس كذلك. \NMaybe من مختارات كونفوشيوس؟
Dialogue: 0,0:56:29.21,0:56:30.57,Default,,0,0,0,,هذا يعني أن
Dialogue: 0,0:56:30.57,0:56:34.24,Default,,0,0,0,,الطعام مقرمش من الخارج
Dialogue: 0,0:56:34.24,0:56:36.45,Default,,0,0,0,,والعطاء في الداخل.
Dialogue: 0,0:56:37.41,0:56:39.92,Default,,0,0,0,,حقاً؟
Dialogue: 0,0:56:49.76,0:56:51.19,Default,,0,0,0,,لقد وصلت المِحفّة التي تحمل الطعام!
Dialogue: 0,0:57:03.77,0:57:06.04,Default,,0,0,0,,هنا. خذ اللوحات.
Dialogue: 0,0:57:09.88,0:57:11.48,Default,,0,0,0,,حذر.
Dialogue: 0,0:57:14.45,0:57:15.85,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:57:16.09,0:57:19.26,Default,,0,0,0,,كانت سعيدة جداً وأثنت عليك.
Dialogue: 0,0:57:21.26,0:57:24.03,Default,,0,0,0,,رأيت محفة للطعام
Dialogue: 0,0:57:24.03,0:57:26.46,Default,,0,0,0,,وسألتك كيف توصلت إلى هذه الفكرة الرائعة.
Dialogue: 0,0:57:26.46,0:57:28.30,Default,,0,0,0,,الجذع واضح، والنتيجة كانت واضحة.
Dialogue: 0,0:57:28.30,0:57:31.53,Default,,0,0,0,,كان هذا الشيء شائعاً في المنافسة الكورية.
Dialogue: 0,0:57:33.54,0:57:35.71,Default,,0,0,0,,رجل التوصيل في جوسون.
Dialogue: 0,0:57:36.91,0:57:40.68,Default,,0,0,0,,أوه، كم أنا فخور بنفسي.
Dialogue: 0,0:57:42.05,0:57:43.95,Default,,0,0,0,,بشكل عام، نساء من العائلة المالكة
Dialogue: 0,0:57:43.95,0:57:45.05,Default,,0,0,0,,يجب أن يكون متواضعاً دائماً.
Dialogue: 0,0:57:45.05,0:57:46.48,Default,,0,0,0,,أنت عليّ
Dialogue: 0,0:57:46.65,0:57:48.59,Default,,0,0,0,,هل أنت متذمر الآن أم ماذا؟
Dialogue: 0,0:57:49.49,0:57:53.92,Default,,0,0,0,,هل يجب أن نكون متواضعين؟ \NThat هو السؤال.
Dialogue: 0,0:57:54.32,0:57:57.86,Default,,0,0,0,,كلا. الحياة صعبة، حتى لو كنت تعيش على الكبرياء.
Dialogue: 0,0:58:00.23,0:58:03.37,Default,,0,0,0,,ليس لدي أي فكرة عما يتحدث عنه،\Nلكن الأمر لا يزال يثير حفيظتي.
Dialogue: 0,0:58:04.33,0:58:08.21,Default,pineapple,0,0,0,,يجب أن نكون سعداء لأن أوفول تمكن من البقاء على قيد الحياة.
Dialogue: 0,0:58:08.21,0:58:10.27,Default,pineapple,0,0,0,,هذا بصيص أمل في ظلمة الفشل.
Dialogue: 0,0:58:11.41,0:58:14.71,Default,pineapple,0,0,0,,أنا متأكد بعد ما حدث
Dialogue: 0,0:58:14.71,0:58:17.98,Default,pineapple,0,0,0,,أنت الآن تفهم بشكل أفضل أي نوع من الأشخاص تنتمي عشيرة "كيم".
Dialogue: 0,0:58:18.28,0:58:21.49,Default,pineapple,0,0,0,,لم أكن أعتقد أنهم مستعدون للذهاب إلى هذا الحد.
Dialogue: 0,0:58:21.49,0:58:23.65,Default,الأناناس,0,0,0,,لا بد أنك خائف.
Dialogue: 0,0:58:23.65,0:58:26.86,Default,pineapple,0,0,0,,ومع ذلك، هذه مجرد البداية.
Dialogue: 0,0:58:27.36,0:58:33.10,Default,pineapple,0,0,0,,لن ينسوا هذه الهزيمة.
Dialogue: 0,0:58:34.63,0:58:39.00,Default,pineapple,0,0,0,,هناك شائعات بأن الملك المتوفى لم يمت بسبب المرض.
Dialogue: 0,0:58:40.74,0:58:42.17,Default,الأناناس,0,0,0,,اتضح...
Dialogue: 0,0:58:44.27,0:58:48.68,Default,pineapple,0,0,0,,كان يعتقد أن عشيرة كيم كانت قرحة في جسد جوسون.
Dialogue: 0,0:58:49.51,0:58:51.28,Default,pineapple,0,0,0,,هل تعرف الخطأ الذي ارتكبته؟
Dialogue: 0,0:58:51.28,0:58:52.95,Default,الأناناس,0,0,0,,لقد حرم "كيم هونغ جيون" من السلطة
Dialogue: 0,0:58:52.95,0:58:54.52,Default,Pineapple,0,0,0,,وحكم عليه بالنفي.
Dialogue: 0,0:58:54.52,0:58:57.95,Default,pineapple,0,0,0,,الملك يراجع قانون الرشوة،
Dialogue: 0,0:58:58.69,0:58:59.86,Default,الأناناس,0,0,0,,هكذا هو
Dialogue: 0,0:58:59.86,0:59:02.99,Default,الأناناس,0,0,0,,عبرت طريق عشيرة كيم.
Dialogue: 0,0:59:03.66,0:59:06.86,Default,pineapple,0,0,0,,إنهم ليسوا من ذلك النوع من الأشخاص\Nالذين يجلسون مكتوفي الأيدي.
Dialogue: 0,0:59:12.50,0:59:13.54,Default,الأناناس,0,0,0,,لحسن الحظ,
Dialogue: 0,0:59:13.54,0:59:16.17,Default,الأناناس,0,0,0,,كان الحظ إلى جانب الملك،
Dialogue: 0,0:59:16.17,0:59:19.88,Default,pineapple,0,0,0,,ووجد أدلة ضد كل من كان وراء هذه الفظائع.
Dialogue: 0,0:59:27.08,0:59:30.55,Default,الأناناس,0,0,0,,بعد وفاة الملك
Dialogue: 0,0:59:31.15,0:59:33.46,Default,الأناناس,0,0,0,,وقد اختفى متذوق طعامه.
Dialogue: 0,0:59:33.52,0:59:35.59,Default,الأناناس,0,0,0,,أنا متأكد من أنه مات مسموماً.
Dialogue: 0,0:59:36.66,0:59:38.40,Default,pineapple,0,0,0,,ليتنا أسرع،
Dialogue: 0,0:59:38.40,0:59:41.00,Default,الأناناس,0,0,0,,سيظل الملك على قيد الحياة.
Dialogue: 0,0:59:42.43,0:59:46.14,Default,pineapple,0,0,0,,اسمعني،\NIلم ينته الأمر بعد،
Dialogue: 0,0:59:46.14,0:59:49.37,Default,pineapple,0,0,0,,ولكن إذا فاتتك اللحظة، فلن تستعيد أي شيء.
Dialogue: 0,0:59:50.04,0:59:52.84,Default,pineapple,0,0,0,,هذه المرة عانت خادمتك أوفول،
Dialogue: 0,0:59:52.98,0:59:56.08,Default,الأناناس,0,0,0,,لكن في المرة القادمة ستكون في مكانها.
Dialogue: 0,0:59:57.18,0:59:59.35,Default,الأناناس,0,0,0,,سأقدم التماساً
Dialogue: 0,1:00:00.15,1:00:02.49,Default,الأناناس,0,0,0,,حول حرمان الملكة من لقبها.
Dialogue: 0,1:00:03.52,1:00:05.82,Default,pineapple,0,0,0,,ليس عليك حتى أن تفعل أي شيء،
Dialogue: 0,1:00:05.89,1:00:08.79,Default,الأناناس,0,0,0,,سوف يقابلنا الملك.
Dialogue: 0,1:00:08.79,1:00:12.20,Default,pineapple,0,0,0,,سيكون عليك فقط الموافقة على هذه الفكرة.
Dialogue: 0,1:00:17.53,1:00:21.20,Default,الأناناس,0,0,0,,الملكة الأم، أرجوك سامحني،
Dialogue: 0,1:00:24.21,1:00:27.38,Default,الأناناس,0,0,0,,لكنني بحاجة لمساعدتك.
Dialogue: 0,1:00:30.21,1:00:34.68,Default,pineapple,0,0,0,,عليك فقط أن تعتني بملكنا.
Dialogue: 0,1:00:35.49,1:00:39.82,Default,pineapple,0,0,0,,بعد هذا سيغير الملك موقفه تجاه الملكة،
Dialogue: 0,1:00:39.82,1:00:42.59,Default,الأناناس,0,0,0,,لن تفهم لماذا تفعل كل هذا.
Dialogue: 0,1:00:47.06,1:00:51.03,Default,pineapple,0,0,0,,الجو غائم في الخارج.\NIيبدو أنها ستمطر.
Dialogue: 0,1:00:51.03,1:00:52.54,Default,الأناناس,0,0,0,,سيدة البلاط هان،
Dialogue: 0,1:00:52.97,1:00:55.71,Default,أناناس,0,0,0,,الغرفة مظلمة، أشعل الشموع.
Dialogue: 0,1:00:55.81,1:00:57.24,Default,الأناناس,0,0,0,,أنا أطيع.
Dialogue: 0,1:01:24.17,1:01:26.90,Default,pineapple,0,0,0,,إذا انتظرت الملك، فلن يأتي.
Dialogue: 0,1:01:27.40,1:01:29.34,Default,الأناناس,0,0,0,,كيف تعرف ذلك...
Dialogue: 0,1:01:29.54,1:01:32.71,Default,أناناس,0,0,0,,هل ستهدأ فقط\Nعندما تأخذ كل شيء مني؟
Dialogue: 0,1:01:32.94,1:01:35.41,Default,pineapple,0,0,0,,هل غيرت الحرف؟
Dialogue: 0,1:01:37.41,1:01:39.52,Default,الأناناس,0,0,0,,لقد غيرت شيئاً أكثر جدية.
Dialogue: 0,1:01:39.78,1:01:41.95,Default,pineapple,0,0,0,,لماذا لا أستطيع استبدال شيء صغير كهذا؟
Dialogue: 0,1:01:45.19,1:01:47.16,Default,الأناناس,0,0,0,,لا أفهم ماذا تقصد.
Dialogue: 0,1:01:48.59,1:01:52.26,Default,الأناناس,0,0,0,,أعلم أنك كذبت.
Dialogue: 0,1:01:56.33,1:01:59.07,Default,الأناناس,0,0,0,,إذا اكتشف الملك الحقيقة،
Dialogue: 0,1:02:00.30,1:02:02.91,Default,الأناناس,0,0,0,,إذن ستفهم مشاعري.
Dialogue: 0,1:02:03.77,1:02:06.94,Default,pineapple,0,0,0,,الشعور الذي ينتابك عندما تفقد شخصًا تحبه.
Dialogue: 0,1:02:07.01,1:02:08.48,Default,الأناناس,0,0,0,,ما مدى صعوبة الأمر بالنسبة لك
Dialogue: 0,1:02:09.61,1:02:12.42,Default,الأناناس,0,0,0,,سوف تنظر في عينيه
Dialogue: 0,1:02:13.55,1:02:15.75,Default,الأناناس,0,0,0,,لبقية حياتي.
Dialogue: 0,1:02:23.06,1:02:26.93,Default,pineapple,0,0,0,,إذا كنت تريد إبقاء كل شيء سراً، فاترك القصر.
Dialogue: 0,1:02:28.80,1:02:31.13,Default,الأناناس,0,0,0,,لقد وجدت نقطة ضعفي.
Dialogue: 0,1:02:31.50,1:02:34.74,Default,الأناناس,0,0,0,,حسنًا، أخبر الملك بهذا،
Dialogue: 0,1:02:34.94,1:02:38.47,Default,pineapple,0,0,0,,ولكن بعد ذلك سيتعين عليك التحدث عن شيء آخر.
Dialogue: 0,1:02:40.21,1:02:41.74,Default,الأناناس,0,0,0,,لقد حاولت
Dialogue: 0,1:02:42.61,1:02:44.58,Default,الأناناس,0,0,0,,اقتل الملك.
Dialogue: 0,1:02:53.46,1:02:55.73,Default,الأناناس,0,0,0,,هل تعلم.
Dialogue: 0,1:02:56.99,1:02:58.53,Default,الأناناس,0,0,0,,لديك
Dialogue: 0,1:02:59.63,1:03:01.63,Default,الأناناس,0,0,0,,لن ينجح شيء.
Dialogue: 0,1:03:07.04,1:03:08.77,Default,الأناناس,0,0,0,,يوماً ما ستخسر
Dialogue: 0,1:03:09.77,1:03:12.61,Default,الأناناس,0,0,0,,شخص عزيز عليك.
Dialogue: 0,1:03:52.92,1:03:54.45,Default,الأناناس,0,0,0,,ماذا حدث؟
Dialogue: 0,1:03:56.99,1:03:59.09,Default,الأناناس,0,0,0,,أنت تعلم بالفعل.
Dialogue: 0,1:03:59.72,1:04:01.22,Default,الأناناس,0,0,0,,جلالة الملك
Dialogue: 0,1:04:02.06,1:04:04.39,Default,الأناناس,0,0,0,,ضعيف عندما يشعر بالذنب.
Dialogue: 0,1:04:06.06,1:04:08.00,Default,الأناناس,0,0,0,,هذا هو ثمن البقاء.
Dialogue: 0,1:04:08.63,1:04:10.30,Default,الأناناس,0,0,0,,الذنب.
Dialogue: 0,1:04:16.51,1:04:20.74,Default,pineapple,0,0,0,,جلالة الملك، هل هذا ما ترغب في فعله لكسب رضا الملك؟
Dialogue: 0,1:04:36.89,1:04:39.30,Default,pineapple,0,0,0,,أسرع، ضعه جانباً قبل أن يبتل كل شيء!
Dialogue: 0,1:04:39.30,1:04:40.96,Default,الأناناس,0,0,0,,أسرع!
Dialogue: 0,1:04:44.97,1:04:48.14,Default,أناناس,0,0,0,,لقد كانت السماء تمطر لعدة أيام.
Dialogue: 0,1:04:48.27,1:04:50.27,Default,pineapple,0,0,0,,وأخيراً ذهب.
Dialogue: 0,1:04:51.47,1:04:54.44,Default,pineapple,0,0,0,,في هذه الحياة مكانتي أعلى مما هي عليه في الحاضر،
Dialogue: 0,1:04:54.95,1:04:57.68,Default,الأناناس,0,0,0,,لكن لماذا أشعر بالسوء أكثر؟
Dialogue: 0,1:04:57.68,1:04:58.68,Default,الأناناس,0,0,0,,جلالتك,
Dialogue: 0,1:04:58.68,1:05:03.02,Default,الأناناس,0,0,0,,هل تعتقد أنه يمكنني الحصول على حياة أخرى؟
Dialogue: 0,1:05:03.92,1:05:07.39,Default,pineapple,0,0,0,,وفقاً لنظرية العوالم الموازية، كل شيء ممكن.
Dialogue: 0,1:05:11.90,1:05:12.90,Default,الأناناس,0,0,0,,انظر.
Dialogue: 0,1:05:12.90,1:05:15.63,Default,pineapple,0,0,0,,هذه هي الحياة التي تعيشها الآن.
Dialogue: 0,1:05:16.63,1:05:19.20,Default,pineapple,0,0,0,,ولكن هذه هي حياتك الأخرى.\Nهل تفهمين؟
Dialogue: 0,1:05:19.54,1:05:21.47,Default,الأناناس,0,0,0,,نوع من الأشياء اللعينة.
Dialogue: 0,1:05:23.34,1:05:25.34,Default,pineapple,0,0,0,,بعد أن بدأت التواصل
Dialogue: 0,1:05:25.34,1:05:28.11,Default,الأناناس,0,0,0,,تحدثت ببعض الثرثرة للملكة.
Dialogue: 0,1:05:28.71,1:05:33.58,Default,pineapple,0,0,0,,إذًا هل يمكن لهذا الجرو\N أن يكون إنسانًا في حياة سابقة؟
Dialogue: 0,1:05:34.18,1:05:35.79,Default,الأناناس,0,0,0,,كل شيء ممكن.
Dialogue: 0,1:05:35.99,1:05:37.92,Default,الأناناس,0,0,0,,والطباخ أحمق؟
Dialogue: 0,1:05:41.42,1:05:44.69,Default,الأناناس,0,0,0,,وإلا. ربما كان مرؤوسي.
Dialogue: 0,1:05:45.50,1:05:47.36,Default,الأناناس,0,0,0,,وماذا عني؟
Dialogue: 0,1:05:48.77,1:05:53.04,Default,pineapple,0,0,0,,سوف تكونين دائماً سيدة بلاط تشوي.
Dialogue: 0,1:05:53.90,1:05:56.01,Default,الأناناس,0,0,0,,وأنت يا هونغيونغ...
Dialogue: 0,1:05:56.01,1:05:58.74,Default,الأناناس,0,0,0,,ثم أمي وأبي
Dialogue: 0,1:05:58.74,1:06:01.08,Default,الأناناس,0,0,0,,هل سيكونون سعداء في الحياة القادمة؟
Dialogue: 0,1:06:01.08,1:06:02.08,Default,الأناناس,0,0,0,,ماذا؟
Dialogue: 0,1:06:02.08,1:06:05.62,Default,أناناس,0,0,0,,لم يتبق لدى والدتي سوى أربعة مسامير.
Dialogue: 0,1:06:05.62,1:06:09.09,Default,pineapple,0,0,0,,فقدت أظافرها عندما كانت تفرز الحجارة في الشتاء البارد.
Dialogue: 0,1:06:09.09,1:06:14.02,Default,pineapple,0,0,0,,في حياة أخرى، هل ستضع أمي جميع أظافرها في مكانها الصحيح؟
Dialogue: 0,1:06:14.89,1:06:17.43,Default,الأناناس,0,0,0,,بالطبع.
Dialogue: 0,1:06:17.43,1:06:19.76,Default,pineapple,0,0,0,,والكاهن سيكون له عينان!
Dialogue: 0,1:06:19.76,1:06:21.36,Default,الأناناس,0,0,0,,ماذا عن والدك؟
Dialogue: 0,1:06:21.36,1:06:24.03,Default,pineapple,0,0,0,,-لقد اقتلعت عينه بالمذراة.\N-ماذا؟
Dialogue: 0,1:06:24.03,1:06:25.84,Default,الأناناس,0,0,0,,لا بد وأنك اقترضت الأرز
Dialogue: 0,1:06:25.84,1:06:28.00,Default,الأناناس,0,0,0,,ولم يدفع فائدة.
Dialogue: 0,1:06:28.07,1:06:31.01,Default,pineapple,0,0,0,,وبعد ذلك يجمع المرابون الديون.
Dialogue: 0,1:06:31.84,1:06:35.01,Default,pineapple,0,0,0,,في كل ساحة هناك شخص يعاني من المرابين.
Dialogue: 0,1:06:36.58,1:06:37.81,Default,الأناناس,0,0,0,,لا تقلق.
Dialogue: 0,1:06:37.81,1:06:40.72,Default,pineapple,0,0,0,,في الحياة القادمة، ستتمتع والدتك بأظافر صحية وجميلة،
Dialogue: 0,1:06:40.72,1:06:42.25,Default,الأناناس,0,0,0,,لن تحتاج حتى إلى عمل مانيكير.
Dialogue: 0,1:06:42.25,1:06:43.75,Default,الأناناس,0,0,0,,وسيكون لدى والدي
Dialogue: 0,1:06:43.75,1:06:47.12,Default,أناناس,0,0,0,,عينان لامعتان، كما لو كان يرتدي عدسات لاصقة.
Dialogue: 0,1:06:47.89,1:06:52.60,Default,الأناناس,0,0,0,,أود أن أرى أمي بأظافر صحية.
Dialogue: 0,1:06:52.93,1:06:54.43,Default,الأناناس,0,0,0,,إيه!
Dialogue: 0,1:06:56.10,1:06:57.53,Default,الأناناس,0,0,0,,وأنا.
Dialogue: 0,1:06:58.30,1:07:00.40,Default,الأناناس,0,0,0,,أريد حقًا رؤية أمي.
Dialogue: 0,1:07:02.14,1:07:06.21,Default,الأناناس,0,0,0,,لم تتمكن من رؤية وجه والدتك!
Dialogue: 0,1:07:06.31,1:07:07.74,Default,الأناناس,0,0,0,,كيف ذلك.
Dialogue: 0,1:07:08.48,1:07:11.08,Default,pineapple,0,0,0,,حسناً، لماذا تذكرتها؟
Dialogue: 0,1:07:11.98,1:07:14.32,Default,أناناس,0,0,0,,أنا لا أتحدث عن هذه أمي!
Dialogue: 0,1:07:14.32,1:07:17.42,Default,pineapple,0,0,0,,أنا أتحدث عن السيدة Li Sunxin، إنها على قيد الحياة وبصحة جيدة!
Dialogue: 0,1:07:18.62,1:07:20.56,Default,الأناناس,0,0,0,,حتى الزومبا يفعل ذلك!
Dialogue: 0,1:07:20.56,1:07:22.39,Default,pineapple,0,0,0,,لماذا تجعلني أشعر وكأنني يتيم؟
Dialogue: 0,1:07:27.93,1:07:29.77,Default,الأناناس,0,0,0,,مجتمعون في المطبخ الملكي،
Dialogue: 0,1:07:29.77,1:07:32.10,Default,pineapple,0,0,0,,حيث الطريق مغلق أمام النساء، ويتذمرن.
Dialogue: 0,1:07:32.10,1:07:34.80,Default,الأناناس,0,0,0,,أنا لا أفهم النساء.
Dialogue: 0,1:07:38.78,1:07:40.24,Default,الأناناس,0,0,0,,أمي؟
Dialogue: 0,1:07:42.45,1:07:43.88,Default,الأناناس,0,0,0,,أمي!
Dialogue: 0,1:07:57.89,1:08:00.33,Default,Pineapple,0,0,0,,إنها تمطر، لذا يشعر الجميع بالحزن.
Dialogue: 0,1:08:01.20,1:08:04.00,Default,pineapple,0,0,0,,استمع، أحضر لي بعض الباجيون مع الماكغولي.
Dialogue: 0,1:08:05.27,1:08:06.67,Default,الأناناس,0,0,0,,العودة إلى قاعة دايجوجون.
Dialogue: 0,1:08:06.67,1:08:08.87,Default,pineapple,0,0,0,,سيستمر هطول المطر لفترة طويلة.
Dialogue: 0,1:08:10.27,1:08:11.51,Default,الأناناس,0,0,0,,كيف تعرف؟
Dialogue: 0,1:08:11.51,1:08:13.91,Default,pineapple,0,0,0,,هل أصبحت حاسوبًا للأرصاد الجوية؟
Dialogue: 0,1:08:13.91,1:08:16.48,Default,pineapple,0,0,0,,ليس لدي أي فكرة عما تتحدث عنه،
Dialogue: 0,1:08:16.61,1:08:19.05,Default,الأناناس,0,0,0,,لكن معصمي يؤلمني كثيراً،
Dialogue: 0,1:08:19.05,1:08:21.62,Default,الأناناس,0,0,0,,مما يعني أنها ستمطر طوال الليل.
Dialogue: 0,1:08:23.82,1:08:25.45,Default,الأناناس,0,0,0,,ما مدى قوتها؟
Dialogue: 0,1:08:25.86,1:08:27.96,Default,الأناناس,0,0,0,,لا أعرف،
Dialogue: 0,1:08:29.73,1:08:32.90,Default,الأناناس,0,0,0,,عندما يكون الأمر مؤلمًا جدًا، فهذا يعني
Dialogue: 0,1:08:32.90,1:08:36.47,Default,الأناناس,0,0,0,,سوف تملأ جميع البراميل في بضع ساعات فقط.
Dialogue: 0,1:08:37.27,1:08:39.54,Default,الأناناس,0,0,0,,هل ستملأ البراميل في بضع ساعات؟
Dialogue: 0,1:08:39.80,1:08:43.54,Default,pineapple,0,0,0,,إذن سيكون هناك ماء في البحيرات والآبار؟
Dialogue: 0,1:08:56.55,1:08:58.02,Default,الأناناس,0,0,0,,رئيس الخصي.
Dialogue: 0,1:08:58.82,1:09:00.36,Default,الأناناس,0,0,0,,أنا أستمع يا سيدي.
Dialogue: 0,1:09:03.33,1:09:04.43,Default,الأناناس,0,0,0,,كتاب التغييرات
Dialogue: 0,1:09:04.43,1:09:06.80,Default,pineapple,0,0,0,,لجعل ليالينا مع الملكة أكثر إنتاجية،
Dialogue: 0,1:09:06.80,1:09:09.97,Default,pineapple,0,0,0,,سأذهب إلى السرير بعد أن أقرأ أكثر قليلاً.
Dialogue: 0,1:09:10.10,1:09:12.54,Default,الأناناس,0,0,0,,لقد تأخر الوقت، يمكنك الذهاب.
Dialogue: 0,1:09:12.80,1:09:14.24,Default,الأناناس,0,0,0,,أنا أطيع.
Dialogue: 0,1:09:22.38,1:09:25.25,Default,الأناناس,0,0,0,,ملاحظات حول الأسلحة والمعدات
Dialogue: 0,1:09:53.04,1:09:55.71,Default,فلاش 5,0,0,0,,سأعود عندما تشعر بالتحسن.
Dialogue: 0,1:09:55.71,1:09:59.05,Default,فلاش 5,0,0,0,,لا تأتي إلا إذا كنت مستعداً للتسول على ركبتيك.
Dialogue: 0,1:09:59.08,1:10:01.55,Default,فلاش 5,0,0,0,,قلت لك ألا تأتي!
Dialogue: 0,1:10:11.43,1:10:14.23,Default,الأناناس,0,0,0,,كل يوم أركع،
Dialogue: 0,1:10:15.83,1:10:19.84,Default,pineapple,0,0,0,,ولكن ليس لمن يجب أن ينحني.
Dialogue: 0,1:10:28.95,1:10:30.41,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,1:10:31.11,1:10:32.98,Default,الأناناس,0,0,0,,سوف تمرض!
Dialogue: 0,1:10:32.98,1:10:34.92,Default,الأناناس,0,0,0,,أنا لا أهتم بالمرض!
Dialogue: 0,1:10:34.92,1:10:37.02,Default,الأناناس,0,0,0,,انظر، الجنة بجانبي!
Dialogue: 0,1:10:37.02,1:10:39.62,Default,الأناناس,0,0,0,,يا إلهي، سيدتي، توقفي!
Dialogue: 0,1:10:40.09,1:10:42.73,Default,الأناناس,0,0,0,,من فضلك، اهدأ!
Dialogue: 0,1:11:13.89,1:11:15.63,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,1:11:15.63,1:11:16.86,Default,الأناناس,0,0,0,,جلالتك؟
Dialogue: 0,1:11:16.86,1:11:19.26,Default,الأناناس,0,0,0,,ومرة أخرى!
Dialogue: 0,1:11:19.26,1:11:20.83,Default,الأناناس,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,1:11:20.83,1:11:22.83,Default,الأناناس,0,0,0,,هذا كل شيء! مرحا! أخيراً!
Dialogue: 0,1:11:22.83,1:11:24.33,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,1:11:24.33,1:11:26.70,Default,الأناناس,0,0,0,,ما خطبك؟
Dialogue: 0,1:11:33.04,1:11:35.14,Default,الأناناس,0,0,0,,أي نوع من النساء هي؟
Dialogue: 0,1:11:35.71,1:11:37.91,Default,pineapple,0,0,0,,أنت لا تعرف أبدًا ما الذي يدور في ذهنها.
Dialogue: 0,1:11:37.91,1:11:40.45,Default,الأناناس,0,0,0,,هذا كل شيء! رائع!
Dialogue: 0,1:11:40.52,1:11:43.22,Default,الأناناس,0,0,0,,ماذا حدث لك؟
Dialogue: 0,1:11:45.25,1:11:48.16,Default,pineapple,0,0,0,,لماذا أنت بدون مجموعة دعم؟
Dialogue: 0,1:11:57.07,1:11:59.30,Default,pineapple,0,0,0,,هل قررت أيضًا المشي تحت المطر؟
Dialogue: 0,1:12:00.47,1:12:03.04,Default,Pineapple,0,0,0,,جئت للاعتذار.
Dialogue: 0,1:12:04.44,1:12:06.31,Default,pineapple,0,0,0,,انس الأمر، لا أهتم.
Dialogue: 0,1:12:06.31,1:12:07.74,Default,الأناناس,0,0,0,,لا,
Dialogue: 0,1:12:07.74,1:12:09.91,Default,الأناناس,0,0,0,,لا أستطيع نسيان ذلك.
Dialogue: 0,1:12:09.91,1:12:12.52,Default,pineapple,0,0,0,,أنا أقول لك، لا أهتم، لماذا أنت متعلق؟
Dialogue: 0,1:12:13.08,1:12:14.48,Default,الأناناس,0,0,0,,مرفق؟
Dialogue: 0,1:12:16.82,1:12:19.02,Default,الأناناس,0,0,0,,أنا شخص بسيط.
Dialogue: 0,1:12:19.02,1:12:20.56,Default,الأناناس,0,0,0,,سعيد لرؤيتك - أقسم،
Dialogue: 0,1:12:20.56,1:12:22.89,Default,الأناناس,0,0,0,,ممتن - أنا أخوض معركة.
Dialogue: 0,1:12:22.89,1:12:24.89,Default,الأناناس,0,0,0,,لا أستطيع تحمل المتملقين،
Dialogue: 0,1:12:25.06,1:12:26.50,Default,الأناناس,0,0,0,,انزل.
Dialogue: 0,1:12:30.70,1:12:32.20,Default,الأناناس,0,0,0,,أخرج؟
Dialogue: 0,1:12:32.30,1:12:34.27,Default,pineapple,0,0,0,,استجمعت شجاعتي للاعتذار،
Dialogue: 0,1:12:34.27,1:12:36.64,Default,pineapple,0,0,0,,وهذا ما أحصل عليه في الرد؟
Dialogue: 0,1:12:36.67,1:12:39.38,Default,pineapple,0,0,0,,اسمع، لو أن من يحتاج إلى اعتذار فقط هو
Dialogue: 0,1:12:39.38,1:12:42.51,Default,pineapple,0,0,0,,من يعتذر، وليس لمن يستقبله، هل هذا اعتذار حقاً؟
Dialogue: 0,1:12:45.98,1:12:48.99,Default,الأناناس,0,0,0,,للعائلة المالكة قواعدها الخاصة.
Dialogue: 0,1:12:48.99,1:12:52.05,Default,pineapple,0,0,0,,إلى متى ستتحدث بهذه الغرابة؟
Dialogue: 0,1:12:53.16,1:12:55.72,Default,الأناناس,0,0,0,,اليوم فقط. هذا هو اليوم الأخير.
Dialogue: 0,1:12:55.73,1:13:00.06,Default,pineapple,0,0,0,,وغداً كل شيء سيكون في مكانه الصحيح!
Dialogue: 0,1:13:00.06,1:13:02.83,Default,الأناناس,0,0,0,,هذا كل شيء! أوه نعم!
Dialogue: 0,1:13:02.83,1:13:04.67,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,1:13:04.67,1:13:06.87,Default,الأناناس,0,0,0,,-هذا كل شيء!\N-Queen!
Dialogue: 0,1:13:06.87,1:13:08.94,Default,الأناناس,0,0,0,,أوه نعم!
Dialogue: 0,1:13:10.41,1:13:13.64,Default,pineapple,0,0,0,,جلالتك، عد إلى رشدك!
Dialogue: 0,1:13:13.64,1:13:15.28,Default,الأناناس,0,0,0,,أوه نعم!
Dialogue: 0,1:13:18.08,1:13:21.38,Default,pineapple,0,0,0,,لقد أهنتني، لذلك ننام اليوم منفصلين.
Dialogue: 0,1:13:24.12,1:13:25.65,Default,الأناناس,0,0,0,,اقضي الليل وحدك.
Dialogue: 0,1:13:27.76,1:13:31.36,Default,الأناناس,0,0,0,,الحمد لله! أنا سعيد جدًا لسماع هذا!
Dialogue: 0,1:13:33.43,1:13:35.33,Default,الأناناس,0,0,0,,يا له من شخص عظيم.
Dialogue: 0,1:13:41.17,1:13:42.94,Default,الأناناس,0,0,0,,هل خرجت بدون مظلة؟
Dialogue: 0,1:13:42.94,1:13:45.77,Default,pineapple,0,0,0,,أحب أحيانًا المشي بدون مظلة.
Dialogue: 0,1:13:45.84,1:13:49.51,Default,pineapple,0,0,0,,أشعر وكأن المطر يغسل كل همومي.
Dialogue: 0,1:13:52.15,1:13:54.25,Default,الأناناس,0,0,0,,لا تحزن!
Dialogue: 0,1:13:54.25,1:13:56.12,Default,pineapple,0,0,0,,جلالتك، عد إلى الداخل!
Dialogue: 0,1:13:56.35,1:13:58.99,Default,الأناناس,0,0,0,,يا له من كابوس! الإمبراطورة!
Dialogue: 0,1:13:58.99,1:14:00.62,Default,الأناناس,0,0,0,,توقف!
Dialogue: 0,1:14:01.46,1:14:04.36,Default,الأناناس,0,0,0,,ما هذا؟ لماذا سيكون هناك رعد؟
Dialogue: 0,1:14:04.36,1:14:06.43,Default,الأناناس,0,0,0,,الجنة غاضبة!
Dialogue: 0,1:14:07.13,1:14:08.63,Default,الأناناس,0,0,0,,اغضب!
Dialogue: 0,1:14:08.63,1:14:12.74,Default,pineapple,0,0,0,,أحرك حوضي إذا كان ذلك يعني\Nأن المطر سيستمر بالهطول لفترة طويلة!
Dialogue: 0,1:14:13.34,1:14:16.27,Default,الأناناس,0,0,0,,جلالتك! توقف!
Dialogue: 0,1:14:16.27,1:14:18.17,Default,الأناناس,0,0,0,,أوه نعم!
Dialogue: 0,1:14:18.17,1:14:19.68,Default,الأناناس,0,0,0,,من فضلك!
Dialogue: 0,1:14:20.08,1:14:21.54,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,1:14:21.54,1:14:23.95,Default,pineapple,0,0,0,,مرض الملكة يزداد سوءاً يوماً بعد يوم،
Dialogue: 0,1:14:23.95,1:14:26.28,Default,pineapple,0,0,0,,إنها لا تفوت فرصة الانتحار.
Dialogue: 0,1:14:26.32,1:14:29.39,Default,pineapple,0,0,0,,الساحة بأكملها تهتز من تصرفاتها الغريبة.
Dialogue: 0,1:14:30.25,1:14:33.69,Default,pineapple,0,0,0,,أليس من الأفضل تقديم التماس؟
Dialogue: 0,1:14:33.69,1:14:35.66,Default,pineapple,0,0,0,,عن تجريدها من لقبها؟
Dialogue: 0,1:14:35.89,1:14:38.73,Default,الأناناس,0,0,0,,-أنت على حق.\N-صحيح.
Dialogue: 0,1:14:38.73,1:14:41.70,Default,الأناناس,0,0,0,,حان وقت عشيرتنا
Dialogue: 0,1:14:41.70,1:14:44.07,Default,الأناناس,0,0,0,,اجمع قوتك.
Dialogue: 0,1:14:58.98,1:15:01.48,Default,الأناناس,0,0,0,,عندما يفتح العدو رقبته الأعزل،
Dialogue: 0,1:15:01.95,1:15:04.45,Default,الأناناس,0,0,0,,يجب عليك الاستيلاء عليها على الفور.
Dialogue: 0,1:15:09.49,1:15:12.19,Default,الأناناس,0,0,0,,قلب بلادنا في خطر.
Dialogue: 0,1:15:12.19,1:15:15.86,Default,pineapple,0,0,0,,حرمان الملكة من لقبها هو القرار الصحيح.
Dialogue: 0,1:15:24.57,1:15:27.41,Default,pineapple,0,0,0,,في يوم من الأيام كان هناك خالد اسمه أخيل.
Dialogue: 0,1:15:27.41,1:15:29.51,Default,pineapple,0,0,0,,وكانت لديه نقطة ضعف واحدة فقط.
Dialogue: 0,1:15:29.51,1:15:32.38,Default,pineapple,0,0,0,,تقول الأساطير إنه مات بسبب سهم أصاب كعبه.
Dialogue: 0,1:15:32.55,1:15:35.48,Default,pineapple,0,0,0,,هكذا ظهر تعبير "كعب أخيل".
Dialogue: 0,1:15:36.42,1:15:37.89,Default,pineapple,0,0,0,,لكن السبب الحقيقي لوفاته هو،
Dialogue: 0,1:15:37.89,1:15:41.02,Default,pineapple,0,0,0,,أن أخيل لم يكن لديه من يصنع له حذاءً مصفحاً.
Dialogue: 0,1:15:41.02,1:15:42.46,Default,الأناناس,0,0,0,,يقولون...
Dialogue: 0,1:15:42.46,1:15:45.90,Default,pineapple,0,0,0,,إذا أراد الناس التخلص من نقاط ضعفهم، فسوف يتخلصون من بعضهم البعض.
Dialogue: 0,1:15:45.90,1:15:48.30,Default,الأناناس,0,0,0,,تجنب التهديد...
Dialogue: 0,1:15:48.30,1:15:51.87,Default,pineapple,0,0,0,,نحن نقاط ضعف بعضنا البعض،\Nالأسباب التي تجعلنا نعاني.
Dialogue: 0,1:15:53.94,1:15:57.97,Default,pineapple,0,0,0,,لكننا أيضًا نحمي وننقذ بعضنا البعض.
Dialogue: 0,1:16:20.23,1:16:21.73,Default,الأناناس,0,0,0,,هونيونغ,
Dialogue: 0,1:16:22.03,1:16:24.80,Default,pineapple,0,0,0,,تأكد من شراء أرض في "غانغنام".
Dialogue: 0,1:16:24.80,1:16:27.37,Default,الأناناس,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,1:16:29.14,1:16:30.67,Default,الأناناس,0,0,0,,السيدة تشوي,
Dialogue: 0,1:16:31.27,1:16:33.38,Default,الأناناس,0,0,0,,لقد مررت بالكثير بسببي.
Dialogue: 0,1:17:02.54,1:17:04.07,Default,الأناناس,0,0,0,,أخيرًا.
Dialogue: 0,1:17:09.01,1:17:12.11,Default,الأناناس,0,0,0,,بحيرة تشونداجي
Dialogue: 0,1:17:26.23,1:17:29.47,Default,pineapple,0,0,0,,ما كان يجب أن أصل إلى هنا\NJang Bong-hwan
Dialogue: 0,1:17:30.07,1:17:31.77,Default,pineapple,0,0,0,,نحن بحاجة للاحتفال بطريقة ما.
Dialogue: 0,1:17:55.36,1:17:58.13,Default,pineapple,0,0,0,,الآن سوف يصبح كل شيء في مكانه أخيراً.
Dialogue: 0,1:20:11.73,1:20:14.00,Default,pineapple,0,0,0,,{\i1}الملكة هي الشخص الأكثر غرابة وغرابة{\i}
Dialogue: 0,1:20:14.00,1:20:16.20,Default,pineapple,0,0,0,,{\i1}من كل من أعرفهم.{\i}
Dialogue: 0,1:20:16.20,1:20:18.47,Default,pineapple,0,0,0,,{\i1}كما لو أنها ليست من عالمنا.{\i}
Dialogue: 0,1:20:18.47,1:20:20.87,Default,pineapple,0,0,0,,{\i1}من تريد استدعاء روحه؟{\i}
Dialogue: 0,1:20:20.87,1:20:24.41,Default,pineapple,0,0,0,,{\i1}هذه المرأة مجنونة بالتأكيد.{\i}
Dialogue: 0,1:20:24.41,1:20:26.88,Default,pineapple,0,0,0,,{\i1}الأزمة الداخلية أسوأ بكثير،{\i}
Dialogue: 0,1:20:26.88,1:20:28.78,Default,pineapple,0,0,0,,{\i1}مشكلة خارجية. لا أوافق؟{\i}
Dialogue: 0,1:20:28.78,1:20:30.01,Default,pineapple,0,0,0,,{\i1}هل تريد أن تقول ذلك في البلد{\i}
Dialogue: 0,1:20:30.01,1:20:31.25,Default,pineapple,0,0,0,,{\i1}هل كانت هناك مشكلة لم تكن موجودة من قبل؟{\i}
Dialogue: 0,1:20:31.25,1:20:32.31,Default,pineapple,0,0,0,,{\i1}اتضح...{\i}
Dialogue: 0,1:20:32.31,1:20:33.82,Default,pineapple,0,0,0,,{\i1}اهتمام صاحب الجلالة بالملكة{\i}
Dialogue: 0,1:20:33.82,1:20:35.95,Default,pineapple,0,0,0,,{\i1}سوف يصبح نقطة ضعفنا.{\i}
Dialogue: 0,1:20:35.95,1:20:39.05,Default,pineapple,0,0,0,,{\i1}فاليوم هو يومنا الأول.{\i}
Dialogue: 0,1:20:39.05,1:20:40.46,Default,pineapple,0,0,0,,{\i1}ماذا؟{\i}
Dialogue: 0,0:16:19.20,0:16:21.20,Default,,0,0,0,,


