Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Hazelnut, February
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.06,0:01:06.33,Default,Lily,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.33,0:01:08.61,Default,Lily,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip.
Dialogue: 0,0:01:10.57,0:01:11.94,Default,Lily,0,0,0,,Kung ayaw mong magsalita,
Dialogue: 0,0:01:11.94,0:01:13.81,Default,Lily,0,0,0,,gumamit ng mga hand signal?
Dialogue: 0,0:01:13.81,0:01:14.81,Default,Lily,0,0,0,,Halimbawa, ito.
Dialogue: 0,0:01:15.78,0:01:16.98,Default,Lily,0,0,0,,Ano ito?
Dialogue: 0,0:01:16.98,0:01:20.25,Default,Lily,0,0,0,,Ibig sabihin nagsisinungaling ako.
Dialogue: 0,0:01:20.68,0:01:22.68,Default,Lily,0,0,0,,Ano ang sasabihin mo? Hindi naman mahirap diba?
Dialogue: 0,0:01:28.19,0:01:31.02,Default,Lily,0,0,0,,Hindi nagsisinungaling ang hari.
Dialogue: 0,0:01:34.00,0:01:36.93,Default,Lily,0,0,0,,15 episode
Dialogue: 0,0:01:55.35,0:01:58.12,Default,Lily,0,0,0,,Anong kasalanan ang maaaring gawin ng gayong batang bata?
Dialogue: 0,0:02:00.05,0:02:02.46,Default,Lily,0,0,0,,Ang amoy ng alak at iba pa.
Dialogue: 0,0:02:03.36,0:02:04.69,Default,Lily,0,0,0,,Hindi siya uminom ng lason.
Dialogue: 0,0:02:05.93,0:02:11.63,Default,Lilia,0,0,0,,Hindi ako makapaniwala na pinilit siyang uminom ng lason ng maliliit na kamay na iyon.
Dialogue: 0,0:02:13.47,0:02:15.97,Default,Lily,0,0,0,,Mainit na mga kamay. Buhay pa siya.
Dialogue: 0,0:02:23.14,0:02:24.38,Default,Lily,0,0,0,,Bumangon.
Dialogue: 0,0:02:25.21,0:02:27.45,Default,Lily,0,0,0,,Damhyang!
Dialogue: 0,0:02:31.49,0:02:32.52,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:02:47.00,0:02:48.80,Default,Lily,0,0,0,,-Mr.\N-Nandito ka na.
Dialogue: 0,0:02:48.80,0:02:49.90,Default,Lily,0,0,0,,Mr.
Dialogue: 0,0:02:51.00,0:02:52.07,Default,Lily,0,0,0,,Hold on.
Dialogue: 0,0:02:56.51,0:02:59.15,Default,Lily,0,0,0,,Hindi mo maaaring iwanan ang isang bata sa mga bundok.
Dialogue: 0,0:03:00.45,0:03:02.65,Default,Lily,0,0,0,,Kailangan ko siyang bigyan ng libing.
Dialogue: 0,0:03:12.66,0:03:14.86,Default,Lily,0,0,0,,-Paalam.\N-Paalam.
Dialogue: 0,0:03:35.12,0:03:37.18,Default,Lily,0,0,0,,Kumusta si Damhyan? Okay lang ba siya?
Dialogue: 0,0:03:37.48,0:03:39.89,Default,Lily,0,0,0,,Nakalabas na siya ng palasyo nang ligtas.
Dialogue: 0,0:03:40.62,0:03:42.82,Default,Lily,0,0,0,,Naawa ako sa kanyang katulong na ina
Dialogue: 0,0:03:42.82,0:03:45.73,Default,Lilia,0,0,0,,at inihanda ang lahat para sabay silang umalis sa Hanyang.
Dialogue: 0,0:03:45.73,0:03:47.13,Default,Lily,0,0,0,,Kaya makikilala niya ang kanyang ina.
Dialogue: 0,0:03:47.93,0:03:50.06,Default,Si Lilia,0,0,0,,Nag-alala si Damhyan sa kanya.
Dialogue: 0,0:03:50.53,0:03:52.93,Default,Lily,0,0,0,,Nakakatuwa. Ito ay astig.
Dialogue: 0,0:03:56.17,0:03:58.74,Default,Lily,0,0,0,,Paano mo ito nakuha? Binigyan mo ba siya ng pampatulog?
Dialogue: 0,0:03:58.77,0:04:00.34,Default,Lily,0,0,0,,Pinainom nila siya ng mafeisan.
Dialogue: 0,0:04:01.48,0:04:05.08,Default,Lily,0,0,0,,Mafeisan, ano ang ginamit ni Hua Tuo sa mga operasyon?
Dialogue: 0,0:04:05.08,0:04:06.35,Default,Lily,0,0,0,,Kilala mo siya.
Dialogue: 0,0:04:06.35,0:04:09.02,Default,Lily,0,0,0,,Siyempre. Maraming beses ko nang nabasa ang The Three Kingdoms for Children.
Dialogue: 0,0:04:09.62,0:04:11.32,Default,Lily,0,0,0,,Ang Tatlong Kaharian para sa mga bata?
Dialogue: 0,0:04:13.09,0:04:16.42,Default,Lily,0,0,0,,Makinig. Dapat binalaan mo ako.
Dialogue: 0,0:04:16.42,0:04:18.23,Default,Lily,0,0,0,,Apurahan ang usapin,
Dialogue: 0,0:04:18.23,0:04:20.23,Default,Lilia,0,0,0,,delikado ang pagsali ng maraming tao.
Dialogue: 0,0:04:25.20,0:04:27.27,Default,Lily,0,0,0,,Any word from Mr. Hong?
Dialogue: 0,0:04:27.47,0:04:31.04,Default,Lily,0,0,0,,Oo. Sinigurado niyang ligtas na nakatakas ang bata.
Dialogue: 0,0:04:32.94,0:04:34.34,Default,Lily,0,0,0,,Magaling.
Dialogue: 0,0:04:35.38,0:04:38.58,Default,Lily,0,0,0,,Walang ingat na ilantad ang iyong sarili sa panganib
Dialogue: 0,0:04:38.98,0:04:40.38,Default,Lily,0,0,0,,dahil sa maid.
Dialogue: 0,0:04:40.55,0:04:42.32,Default,Lily,0,0,0,,Hindi lang siya isang utusan.
Dialogue: 0,0:04:43.38,0:04:44.92,Default,Lily,0,0,0,,Kung isusuko ko ang bata,
Dialogue: 0,0:04:46.02,0:04:48.39,Default,Lily,0,0,0,,mas madaling isuko ang 10, 100,
Dialogue: 0,0:04:50.12,0:04:52.49,Default,Lily,0,0,0,,at pagkatapos ay lahat ng aking mga tao.
Dialogue: 0,0:04:53.66,0:04:57.10,Default,Lily,0,0,0,,Akala ko isang ordinaryong tanga si Cheoljong,
Dialogue: 0,0:04:58.00,0:05:00.47,Default,Lilia,0,0,0,,at isa lang siyang hindi kapani-paniwalang tanga.
Dialogue: 0,0:05:00.53,0:05:02.97,Default,Lily,0,0,0,,Huwag gumugol ng maraming oras sa pag-iisip tungkol sa magagandang bagay.
Dialogue: 0,0:05:02.97,0:05:04.17,Default,Lily,0,0,0,,Kung hindi, hindi ka mabubuhay nang matagal.
Dialogue: 0,0:05:04.77,0:05:07.37,Default,Lily,0,0,0,,Hindi ko intensyon na mamuhay ng miserable.
Dialogue: 0,0:05:07.37,0:05:09.41,Default,Lily,0,0,0,,Isang magandang dahilan para sa maagang pagkamatay.
Dialogue: 0,0:05:09.88,0:05:11.51,Default,Lily,0,0,0,,Sino siya...
Dialogue: 0,0:05:11.51,0:05:12.98,Default,Lily,0,0,0,,Siya ang labis na nagpapasalamat sa akin.
Dialogue: 0,0:05:14.01,0:05:16.92,Default,Lily,0,0,0,,Iba ang pagsasalita ng Reyna kaysa sa iba.
Dialogue: 0,0:05:19.52,0:05:21.42,Default,Lily,0,0,0,,"The Queen's Dictionary" ay madaling gamitin.
Dialogue: 0,0:05:21.42,0:05:23.52,Default,Lily,0,0,0,,Puno ito ng libre at maling pagsasalin.
Dialogue: 0,0:05:23.52,0:05:25.66,Default,Lily,0,0,0,,-Nakita mo ba?\N-Iniwan mong bukas.
Dialogue: 0,0:05:26.69,0:05:30.26,Default,Lily,0,0,0,,Nga pala, laging delikado ang posisyon ng reyna?
Dialogue: 0,0:05:30.26,0:05:32.13,Default,Lily,0,0,0,,Bakit lahat ng tao gustong pumatay sa akin?
Dialogue: 0,0:05:32.47,0:05:35.60,Default,Lily,0,0,0,,Hindi ko na hahayaang mangyari ulit ito.
Dialogue: 0,0:05:36.67,0:05:38.87,Default,Lily,0,0,0,,Hindi. Ako na ang bahala sa lahat.
Dialogue: 0,0:05:39.74,0:05:41.74,Default,Lily,0,0,0,,Ang pinakamahusay na depensa ay isang pag-atake.
Dialogue: 0,0:05:43.71,0:05:47.05,Default,Lily,0,0,0,,Mula sa araw na ito, ako na ang magiging pinaka-walang ingat sa palasyo.
Dialogue: 0,0:06:02.76,0:06:05.77,Default,Lily,0,0,0,,Nandito na si Crazy X
Dialogue: 0,0:06:12.47,0:06:14.77,Default,Lily,0,0,0,,Nasubukan mo na bang tanggalin ang reyna?
Dialogue: 0,0:06:15.34,0:06:17.44,Default,Lily,0,0,0,,Ang reyna ay nasa panig ng hari.
Dialogue: 0,0:06:17.44,0:06:20.35,Default,Lily,0,0,0,,Sinabi niya sa kanya ang lahat ng kahinaan ng aming pamilya.
Dialogue: 0,0:06:20.88,0:06:23.38,Default,Lily,0,0,0,,Nahulog ang loob sa hari at tumalikod sa amin.
Dialogue: 0,0:06:24.08,0:06:25.52,Default,Lily,0,0,0,,Hindi ito totoo.
Dialogue: 0,0:06:26.35,0:06:28.09,Default,Lily,0,0,0,,Ayaw mong maniwala,
Dialogue: 0,0:06:28.62,0:06:31.26,Default,Lily,0,0,0,,na ang reyna na iyong hinahangaan
Dialogue: 0,0:06:31.26,0:06:33.06,Default,Lily,0,0,0,,tanga lang na babae,
Dialogue: 0,0:06:33.06,0:06:34.83,Default,Lily,0,0,0,,walang ingat sa pag-ibig sa isang lalaki.
Dialogue: 0,0:06:35.83,0:06:37.80,Default,Lily,0,0,0,,Pagsali sa iyong pamilya,
Dialogue: 0,0:06:37.80,0:06:40.67,Default,Lily,0,0,0,,Ginawa ko lahat ng gusto mong matanggap.
Dialogue: 0,0:06:42.34,0:06:44.91,Default,Lily,0,0,0,,Hindi lang para manatili sa bahay na ito.
Dialogue: 0,0:06:45.57,0:06:47.11,Default,Lily,0,0,0,,Gusto kong maging katulad mo,
Dialogue: 0,0:06:48.14,0:06:49.88,Default,Lilia,0,0,0,,may paggalang sa iyo.
Dialogue: 0,0:06:51.78,0:06:54.48,Default,Lily,0,0,0,,Ngunit sinusubukang saktan ang reyna,
Dialogue: 0,0:06:56.02,0:06:58.29,Default,Lilia,0,0,0,,hindi na kita ama.
Dialogue: 0,0:07:01.02,0:07:04.22,Default,Lily,0,0,0,,Kung may magpasya na banta ang reyna,
Dialogue: 0,0:07:06.89,0:07:09.20,Default,Lily,0,0,0,,Tiyak na puputulin ko ang kanyang lalamunan.
Dialogue: 0,0:07:14.94,0:07:17.00,Default,Lily,0,0,0,,Maaari kang umuwi kahit kailan mo gusto.
Dialogue: 0,0:07:19.01,0:07:21.44,Default,Lily,0,0,0,,Kahit na hindi mo ako tinuturing na ama,
Dialogue: 0,0:07:22.64,0:07:24.98,Default,Lily,0,0,0,, palagi kang magiging anak ko.
Dialogue: 0,0:07:36.86,0:07:40.16,Default,Lily,0,0,0,,Sino kaya ang nagtago ng ledger sa Daejojeon?
Dialogue: 0,0:07:40.69,0:07:42.73,Default,Lily,0,0,0,,Ang mga pangunahing suspek ay
Dialogue: 0,0:07:42.73,0:07:44.76,Default,Lily,0,0,0,,yung dalawang may sama ng loob sa akin.
Dialogue: 0,0:07:45.47,0:07:47.27,Default,Lily,0,0,0,,Ang Inang Reyna at Cho Hwajin.
Dialogue: 0,0:07:47.67,0:07:50.17,Default,Lily,0,0,0,,Ang motibo ay tumuturo kay Cho Hwajin.
Dialogue: 0,0:07:58.04,0:08:00.95,Default,Lily,0,0,0,,I'm almost sure, considering how she behave during the hunt.
Dialogue: 0,0:08:02.65,0:08:05.85,Default,Lily,0,0,0,,Gayunpaman, matagal nang hindi nakarating si Hwajin sa Daejojon.
Dialogue: 0,0:08:06.19,0:08:08.79,Default,Lily,0,0,0,,Ang mga pamamaraan ay tumuturo sa Inang Reyna.
Dialogue: 0,0:08:10.36,0:08:11.52,Default,Lily,0,0,0,,Narito.
Dialogue: 0,0:08:13.66,0:08:16.36,Default,Lily,0,0,0,,Madalas siyang pumupunta rito kamakailan lamang.
Dialogue: 0,0:08:17.50,0:08:19.40,Default,Lily,0,0,0,,Siyempre, may motibo din siya.
Dialogue: 0,0:08:20.50,0:08:21.80,Default,Lily,0,0,0,,Ito ba ang Inang Reyna?
Dialogue: 0,0:08:22.24,0:08:23.80,Default,Lily,0,0,0,,Itong maliit na daga.
Dialogue: 0,0:08:24.54,0:08:29.64,Default,Lily,0,0,0,,Paano nakuha ng Inang Reyna ang kanyang mga kamay sa ledger?
Dialogue: 0,0:08:32.18,0:08:35.68,Default,Lily,0,0,0,,Iyan ang misteryo.
Dialogue: 0,0:08:36.15,0:08:40.59,Default,Lily,0,0,0,,Higit sa lahat, anong uri ng ledger ito?
Dialogue: 0,0:09:02.84,0:09:04.91,Default,Lily,0,0,0,,Ngayon ay hindi ako nagsagawa ng ritwal.
Dialogue: 0,0:09:04.91,0:09:07.35,Default,Lily,0,0,0,,Humihingi ako ng paumanhin sa aking bastos na pag-uugali.
Dialogue: 0,0:09:09.02,0:09:11.38,Default,Lily,0,0,0,,Humihingi ka ng paumanhin para sa isang dahilan.
Dialogue: 0,0:09:12.35,0:09:13.89,Default,Lily,0,0,0,,Ano ang dahilan?
Dialogue: 0,0:09:14.82,0:09:16.66,Default,Lily,0,0,0,,Gaya ng inaasahan ko,
Dialogue: 0,0:09:17.92,0:09:19.96,Default,Lily,0,0,0,,naiintindihan mo ang lahat sa mabilisang paraan.
Dialogue: 0,0:09:27.53,0:09:31.37,Default,Lily,0,0,0,,Salamat sa pakikilahok sa hindi kasiya-siyang pulong na ito.
Dialogue: 0,0:09:35.11,0:09:37.74,Default,Lily,0,0,0,,Sigurado akong naiintindihan mo sa liwanag ng mga kamakailang kaganapan,
Dialogue: 0,0:09:37.74,0:09:39.51,Default,Lily,0,0,0,,na dumating na ang oras para sa maharlika
Dialogue: 0,0:09:39.51,0:09:41.31,Default,Lily,0,0,0,,magkaisa ang mga pamilya.
Dialogue: 0,0:09:42.25,0:09:43.52,Default,Lily,0,0,0,,Malapit kaming konektado.
Dialogue: 0,0:09:44.75,0:09:46.89,Default,Lily,0,0,0,,Kung bumagsak ang isa sa dalawang pamilya,
Dialogue: 0,0:09:47.22,0:09:49.32,Default,Lily,0,0,0,,hindi mananatiling nakalutang ang iba.
Dialogue: 0,0:09:52.66,0:09:57.10,Default,Lily,0,0,0,,Samakatuwid, iminumungkahi kong maglabas ng dekreto sa amnestiya,
Dialogue: 0,0:09:57.96,0:09:59.50,Default,Lily,0,0,0,,bilang garantiya ng pagkakaisa sa mga relasyon.
Dialogue: 0,0:10:00.87,0:10:02.07,Default,Lily,0,0,0,,Decree?
Dialogue: 0,0:10:02.07,0:10:04.30,Default,Lily,0,0,0,,Maraming talento mula sa magkabilang pamilya
Dialogue: 0,0:10:04.30,0:10:07.34,Default,Lily,0,0,0,,nawala ang kanilang mga post dahil sa isang panandaliang error.
Dialogue: 0,0:10:07.84,0:10:11.44,Default,Lily,0,0,0,,Maglalabas kami ng amnesty decree para patawarin ang mga taong ito.
Dialogue: 0,0:10:12.55,0:10:15.52,Default,Lily,0,0,0,,Sa madaling salita, ito ay simbolo ng pangako
Dialogue: 0,0:10:15.52,0:10:17.05,Default,Lily,0,0,0,,at isang regalong pagbati.
Dialogue: 0,0:10:17.55,0:10:18.69,Default,Lily,0,0,0,,Ano sa tingin mo?
Dialogue: 0,0:10:20.39,0:10:22.16,Default,Lily,0,0,0,,Suportahan mo ako dito?
Dialogue: 0,0:10:50.32,0:10:54.22,Default,Lily,0,0,0,,Gumamit ang War Department ng maruruming trick para masiyahan ang kasakiman nito,
Dialogue: 0,0:10:54.22,0:10:58.26,Default,Lily,0,0,0,,at guilty ako na hindi ko siya mapasuko.
Dialogue: 0,0:10:58.89,0:11:01.59,Default,Lily,0,0,0,,Sa bagay na ito, ako, si Kim Jwageun,
Dialogue: 0,0:11:02.40,0:11:05.53,Default,Lily,0,0,0,,Humihingi ako ng pagbibitiw sa aking post.
Dialogue: 0,0:11:11.94,0:11:14.44,Default,Lily,0,0,0,,Hindi pa tapos para sa akin.
Dialogue: 0,0:11:14.87,0:11:16.84,Default,Lily,0,0,0,,Hindi ito matatapos habang humihinga ako.
Dialogue: 0,0:11:37.66,0:11:39.13,Default,Lily,0,0,0,,Kumain nang dahan-dahan.
Dialogue: 0,0:11:41.47,0:11:43.04,Default,Lily,0,0,0,,May sapat bang meryenda?
Dialogue: 0,0:11:52.35,0:11:56.25,Default,Lily,0,0,0,,Hindi ako dapat kumain kung mayroon akong kahit katiting na kahihiyan na natitira sa akin.
Dialogue: 0,0:12:00.52,0:12:02.29,Default,Lily,0,0,0,,So bakit ka tumakas?
Dialogue: 0,0:12:02.76,0:12:06.23,Default,Lily,0,0,0,,I treated you well.
Dialogue: 0,0:12:09.10,0:12:10.30,Default,Lily,0,0,0,,Ang bagay ay...
Dialogue: 0,0:12:18.54,0:12:20.37,Default,Lily,0,0,0,,Nanay.
Dialogue: 0,0:12:21.91,0:12:23.18,Default,Lily,0,0,0,,Nanay.
Dialogue: 0,0:12:23.58,0:12:24.71,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:12:27.38,0:12:29.15,Default,Lily,0,0,0,,Sapat na ang paghihirap mo, Damhyan.
Dialogue: 0,0:12:29.82,0:12:31.75,Default,Lily,0,0,0,,Naging mahirap para sa iyo.
Dialogue: 0,0:12:43.13,0:12:44.50,Default,Lily,0,0,0,,Lahat ay maayos.
Dialogue: 0,0:12:47.17,0:12:48.30,Default,Lily,0,0,0,,Magiging maayos ang lahat.
Dialogue: 0,0:12:56.64,0:12:59.08,Default,Lily,0,0,0,,Sinubukan naming ngumiti sa harap niya.
Dialogue: 0,0:12:59.61,0:13:01.58,Default,Lily,0,0,0,,Hindi dapat ang kanyang kamahalan
Dialogue: 0,0:13:01.58,0:13:03.32,Default,Lily,0,0,0,,para maging malungkot sa mahabang panahon.
Dialogue: 0,0:13:03.98,0:13:05.02,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:13:20.80,0:13:24.64,Default,Lily,0,0,0,,Kamahalan. Oras na para gumising.
Dialogue: 0,0:13:33.55,0:13:34.75,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:13:36.25,0:13:39.19,Default,Lily,0,0,0,,Hindi ka makatulog kagabi?
Dialogue: 0,0:13:40.19,0:13:43.16,Default,Lily,0,0,0,,Nag-aalala ako na malagay ka sa gulo.
Dialogue: 0,0:13:44.72,0:13:48.59,Default,Lily,0,0,0,,Masyadong maraming iniisip, hindi ako makatulog.
Dialogue: 0,0:13:50.86,0:13:53.27,Default,Lily,0,0,0,,Nga pala, nakatulog ba sila ng maayos?
Dialogue: 0,0:13:54.03,0:13:55.54,Default,Lily,0,0,0,,Sino?
Dialogue: 0,0:13:55.54,0:13:57.74,Default,Lily,0,0,0,,Yung mga taong nagtangkang sirain ang buhay ko.
Dialogue: 0,0:13:58.20,0:14:00.64,Default,Lily,0,0,0,,Iyon ang huli nilang mapayapang pagtulog.
Dialogue: 0,0:14:01.04,0:14:02.61,Default,Lily,0,0,0,,Sana nakakuha sila ng sapat na tulog.
Dialogue: 0,0:14:05.75,0:14:07.41,Default,Lily,0,0,0,,-Lady Choi.\N-Oo.
Dialogue: 0,0:14:07.58,0:14:09.08,Default,Lily,0,0,0,,Magpadala ng isang tao
Dialogue: 0,0:14:09.08,0:14:10.98,Default,Lily,0,0,0,,para sa tatay ko, pumunta siya sa palasyo.
Dialogue: 0,0:14:11.12,0:14:12.35,Default,Lily,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:14:23.70,0:14:24.83,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:14:25.37,0:14:28.00,Default,Lily,0,0,0,,Dumating na ang iyong ama.
Dialogue: 0,0:14:28.97,0:14:29.97,Default,Lily,0,0,0,,Na?
Dialogue: 0,0:14:34.91,0:14:38.11,Default,Lily,0,0,0,,Hihilingin sana kitang pumunta sa palasyo.
Dialogue: 0,0:14:39.15,0:14:41.98,Default,Lily,0,0,0,,Pero dumating ka na.
Dialogue: 0,0:14:41.98,0:14:43.08,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:14:45.32,0:14:47.72,Default,Lily,0,0,0,,Mukhang may dahilan ako.
Dialogue: 0,0:14:51.79,0:14:53.19,Default,Lily,0,0,0,,-Huling pagkakataon...\N-Huling pagkakataon...
Dialogue: 0,0:14:54.13,0:14:55.43,Default,Lily,0,0,0,,Magsalita ka muna.
Dialogue: 0,0:14:55.43,0:14:57.33,Default,Lily,0,0,0,,Hindi. magsalita ka.
Dialogue: 0,0:14:57.33,0:14:59.77,Default,Lily,0,0,0,,Hindi. Magsalita ka muna.
Dialogue: 0,0:15:05.14,0:15:06.71,Default,Lily,0,0,0,,-Paumanhin sa oras na iyon.\N-Paumanhin sa oras na iyon.
Dialogue: 0,0:15:06.71,0:15:08.64,Default,Lily,0,0,0,,-Hindi. Una, hihingi ako ng tawad.\N-Hindi. Ako muna.
Dialogue: 0,0:15:08.64,0:15:10.01,Default,Lily,0,0,0,,-Ako muna.\N-Hindi, ako.
Dialogue: 0,0:15:10.01,0:15:11.28,Default,Lily,0,0,0,,-God.\N-Ako muna.
Dialogue: 0,0:15:21.19,0:15:23.26,Default,Lily,0,0,0,,Oo, ang dugo ay hindi tubig.
Dialogue: 0,0:15:24.66,0:15:25.96,Default,Lily,0,0,0,,Eksakto.
Dialogue: 0,0:15:28.06,0:15:31.60,Default,hazelnut,0,0,0,,Tinawagan kita ngayon
Dialogue: 0,0:15:32.87,0:15:34.23,Default,hazelnut,0,0,0,,dahil sa ledger.
Dialogue: 0,0:15:37.44,0:15:40.24,Default,hazelnut,0,0,0,,-Alam mo ba?\N-Nabaliw ang lahat dahil sa kanya.
Dialogue: 0,0:15:40.87,0:15:42.44,Default,hazelnut,0,0,0,,Anong klaseng libro ito?
Dialogue: 0,0:15:46.51,0:15:50.65,Default,hazelnut,0,0,0,,Ito ay isang account ng mga ilegal na aktibidad ng aming clan.
Dialogue: 0,0:15:51.32,0:15:53.22,Default,hazelnut,0,0,0,,Ang mahinang punto ng Andong Kim clan.
Dialogue: 0,0:15:53.42,0:15:56.16,Default,hazelnut,0,0,0,,Kaya gusto siya ni Cheoljong.
Dialogue: 0,0:15:56.16,0:16:00.26,Default,hazelnut,0,0,0,,Ngayon lang ako pumunta para pag-usapan siya.
Dialogue: 0,0:16:01.19,0:16:04.23,Default,hazelnut,0,0,0,,Pagkatapos ng iyong pagbisita sa hari, nawala siya.
Dialogue: 0,0:16:04.70,0:16:07.23,Default,hazelnut,0,0,0,,Kaya sa lahat ng oras na ito pinaghihinalaan ko ang hari.
Dialogue: 0,0:16:08.30,0:16:09.47,Default,hazelnut,0,0,0,,Ngunit kamakailan lamang
Dialogue: 0,0:16:09.77,0:16:12.51,Default,hazelnut,0,0,0,,nakatakas ang aking tapat na lingkod, na kinaiinisan ko.
Dialogue: 0,0:16:13.47,0:16:16.08,Default,hazelnut,0,0,0,,Sa kabutihang palad, nahuli ko ito at nalaman ang dahilan.
Dialogue: 0,0:16:17.24,0:16:18.91,Default,hazelnut,0,0,0,,Ang araw bago ang pagkawala
Dialogue: 0,0:16:19.71,0:16:21.78,Default,hazelnut,0,0,0,,pinapasok niya ang concubine na si Cho.
Dialogue: 0,0:16:23.42,0:16:25.59,Default,hazelnut,0,0,0,,Kapag nagkaroon ng kaguluhan sa bahay,
Dialogue: 0,0:16:25.89,0:16:28.79,Default,hazelnut,0,0,0,,akala niya dahil sa kanya ang lahat at tumakas. Samakatuwid...
Dialogue: 0,0:16:30.16,0:16:32.39,Default,hazelnut,0,0,0,,Paumanhin.
Dialogue: 0,0:16:35.46,0:16:37.80,Default,hazelnut,0,0,0,,Hindi mo kasalanan.
Dialogue: 0,0:16:39.80,0:16:40.87,Default,hazelnut,0,0,0,,Narito
Dialogue: 0,0:16:42.17,0:16:44.27,Default,hazelnut,0,0,0,,at nalutas ang aming bugtong.
Dialogue: 0,0:16:46.07,0:16:47.14,Default,hazelnut,0,0,0,,Ano?
Dialogue: 0,0:16:47.31,0:16:49.98,Default,hazelnut,0,0,0,,Si Sungwon ang nagpasimuno ng pagpatay sa akin.
Dialogue: 0,0:16:50.94,0:16:53.48,Default,hazelnut,0,0,0,, Espesyal akong naghanda ng yelo,
Dialogue: 0,0:16:53.48,0:16:55.98,Default,hazelnuts,0,0,0,,na mas mahal kaysa sa ginto ngayon.
Dialogue: 0,0:16:58.62,0:17:00.95,Default,hazelnut,0,0,0,,Nilibak ako ng Inang Reyna.
Dialogue: 0,0:17:01.39,0:17:03.02,Default,hazelnut,0,0,0,,Ihahain ko sa iyo ang aking pagkain balang araw.
Dialogue: 0,0:17:03.02,0:17:04.52,Default,hazelnut,0,0,0,,Dapat ko itong subukan ngayon.
Dialogue: 0,0:17:09.46,0:17:12.17,Default,hazelnut,0,0,0,,At ibinigay ni Cho Hwajin ang armas.
Dialogue: 0,0:17:12.30,0:17:14.17,Default,hazelnut,0,0,0,,Ipagtapat ang lahat sa hari.
Dialogue: 0,0:17:14.17,0:17:15.40,Default,hazelnut,0,0,0,,Tinatakot mo ba ako?
Dialogue: 0,0:17:16.80,0:17:18.20,Default,hazelnut,0,0,0,,ako ikaw
Dialogue: 0,0:17:19.44,0:17:20.67,Default,hazelnut,0,0,0,,malinaw na narinig.
Dialogue: 0,0:17:30.95,0:17:34.62,Default,hazelnut,0,0,0,,Pare, kailangan kong pumunta sa isang lugar ngayon.
Dialogue: 0,0:17:35.49,0:17:36.56,Default,hazelnut,0,0,0,,Saan?
Dialogue: 0,0:17:37.62,0:17:40.09,Default,hazelnut,0,0,0,,Buksan ang pinto sa maapoy na hukay.
Dialogue: 0,0:17:40.86,0:17:45.70,Default,hazelnut,0,0,0,,Pagsisisihan mong makipag-ugnayan sa akin.
Dialogue: 0,0:17:51.54,0:17:53.17,Default,hazelnut,0,0,0,,Siya ay dating masunurin tulad ng isang tupa.
Dialogue: 0,0:17:53.61,0:17:56.34,Default,hazelnut,0,0,0,,At sa maikling panahon ay naging malupit ito.
Dialogue: 0,0:17:57.54,0:18:00.08,Default,hazelnut,0,0,0,,Alam kong hindi maaaring maging objective ang mga magulang sa kanilang mga anak.
Dialogue: 0,0:18:00.31,0:18:01.65,Default,hazelnut,0,0,0,,Pero isang tupa?
Dialogue: 0,0:18:02.58,0:18:04.42,Default,hazelnut,0,0,0,,Kung ikukumpara ko siya sa isang hayop,
Dialogue: 0,0:18:04.42,0:18:06.25,Default,hazelnut,0,0,0,,tapos may tarpan lang.
Dialogue: 0,0:18:07.55,0:18:10.12,Default,hazelnut,0,0,0,,Ang aking anak na babae ay isang Tarpan?
Dialogue: 0,0:18:30.78,0:18:32.25,Default,hazelnut,0,0,0,,Maori tattoo.
Dialogue: 0,0:18:33.55,0:18:35.18,Default,hazelnut,0,0,0,,Peacock feather.
Dialogue: 0,0:18:35.78,0:18:37.85,Default,hazelnut,0,0,0,,At ang diyablo ay nagsusuot ng Prada.
Dialogue: 0,0:18:38.75,0:18:40.65,Default,hazelnut,0,0,0,,Lakas sa kagandahan.
Dialogue: 0,0:18:41.42,0:18:46.09,Default,hazelnut,0,0,0,,Ngayon ay mayroon akong pinakamagandang baluti.
Dialogue: 0,0:18:47.36,0:18:48.43,Default,hazelnut,0,0,0,,Paano mo ito gusto?
Dialogue: 0,0:18:50.40,0:18:51.43,Default,hazelnut,0,0,0,,Like.
Dialogue: 0,0:18:52.87,0:18:54.93,Default,hazelnut,0,0,0,,Matamis ang paghihiganti kapag may kasamang paputok.
Dialogue: 0,0:19:19.43,0:19:21.53,Default,hazelnut,0,0,0,,Ano ang ibig sabihin nito?
Dialogue: 0,0:19:22.06,0:19:24.13,Default,hazelnut,0,0,0,,Ang nakikita mo ay hindi lahat.
Dialogue: 0,0:19:37.28,0:19:38.88,Default,hazelnut,0,0,0,,Para malaman kung ano ang nasa loob,
Dialogue: 0,0:19:38.88,0:19:41.18,Default,hazelnut,0,0,0,,kailangang putulin.
Dialogue: 0,0:19:41.35,0:19:43.52,Default,hazelnut,0,0,0,,Akala ko patatas lang.
Dialogue: 0,0:19:44.32,0:19:47.22,Default,hazelnut,0,0,0,,Pero niloko mo ako.
Dialogue: 0,0:19:47.22,0:19:50.02,Default,hazelnut,0,0,0,,Hindi ka dapat mawalan ng tiwala nang walang magandang dahilan.
Dialogue: 0,0:19:50.32,0:19:53.33,Default,hazelnut,0,0,0,,Bago ka mag-cut, kailangan mong tiyakin na ito ay.
Dialogue: 0,0:19:54.79,0:19:58.56,Default,hazelnut,0,0,0,,Dahil pagkatapos noon ay wala ka nang maibabalik.
Dialogue: 0,0:20:00.00,0:20:02.17,Default,hazelnut,0,0,0,,Iyong mga inumin.
Dialogue: 0,0:20:20.42,0:20:23.12,Default,hazelnut,0,0,0,,Ngayon naghanda ako ng brunch,
Dialogue: 0,0:20:23.32,0:20:26.43,Default,hazelnut,0,0,0,,para pasalamatan ka sa kamakailang
Dialogue: 0,0:20:26.69,0:20:28.53,Default,hazelnut,0,0,0,,masamang almusal.
Dialogue: 0,0:20:29.96,0:20:33.07,Default,hazelnut,0,0,0,,Ang cool na inumin sa huling brunch ay napakaganda,
Dialogue: 0,0:20:34.27,0:20:36.87,Default,hazelnut,0,0,0,,na hindi ko mapapansin ang pagkamatay ng isang tao.
Dialogue: 0,0:20:44.88,0:20:46.05,Default,hazelnut,0,0,0,,Subukan ito.
Dialogue: 0,0:20:51.28,0:20:53.22,Default,hazelnut,0,0,0,,Hindi ako nauuhaw.
Dialogue: 0,0:20:53.22,0:20:55.82,Default,hazelnut,0,0,0,,I put so much effort into it. Kumuha ng kahit isang higop.
Dialogue: 0,0:20:55.82,0:20:57.46,Default,hazelnut,0,0,0,,Sabi ko sayo ayoko.
Dialogue: 0,0:20:59.36,0:21:00.99,Default,hazelnut,0,0,0,,Sinubukan ko nang husto.
Dialogue: 0,0:21:03.40,0:21:04.83,Default,hazelnut,0,0,0,,Kung ayaw mong uminom...
Dialogue: 0,0:21:23.82,0:21:26.15,Default,hazelnuts,0,0,0,,Mas masarap talaga kapag may yelo.
Dialogue: 0,0:21:30.12,0:21:31.86,Default,hazelnut,0,0,0,,Sinabi ko kanina na tutulungan kita
Dialogue: 0,0:21:32.36,0:21:35.33,Default,hazelnut,0,0,0,,manatiling malusog at bata sa natitirang bahagi ng iyong buhay.
Dialogue: 0,0:21:35.96,0:21:38.50,Default,hazelnut,0,0,0,,At ipagpapatuloy ko ito.
Dialogue: 0,0:21:39.17,0:21:42.10,Default,hazelnut,0,0,0,,Kung nagdududa ka sa pagkain, inumin at lahat ng bagay sa paligid,
Dialogue: 0,0:21:42.94,0:21:44.87,Default,hazelnut,0,0,0,,kung gayon ang buhay ay magiging walang anuman kundi pagdurusa.
Dialogue: 0,0:21:45.00,0:21:46.84,Default,hazelnut,0,0,0,,Dahil tapos na ang aking regency,
Dialogue: 0,0:21:46.84,0:21:48.81,Default,hazelnut,0,0,0,,sa tingin mo magagawa mo kung ano ang gusto mo?
Dialogue: 0,0:21:49.28,0:21:50.51,Default,hazelnut,0,0,0,,Sa tingin mo mananatili ka
Dialogue: 0,0:21:50.51,0:21:52.68,Default,hazelnut,0,0,0,,isang reyna na wala ang kanyang clan?
Dialogue: 0,0:21:52.68,0:21:54.21,Default,hazelnut,0,0,0,,The Dowager Queen.
Dialogue: 0,0:21:55.11,0:21:57.25,Default,hazelnut,0,0,0,,Hindi ako umaasa sa aking clan o sa aking asawa.
Dialogue: 0,0:21:58.32,0:22:00.55,Default,hazelnut,0,0,0,,Ginagawa ko ang lahat ng gusto ko dahil kaya ko.
Dialogue: 0,0:22:09.56,0:22:11.86,Default,hazelnut,0,0,0,,Eksakto. Punong Eunuch.
Dialogue: 0,0:22:13.13,0:22:14.30,Default,hazelnut,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:22:14.30,0:22:16.74,Default,hazelnut,0,0,0,,Napabayaan ko ang aking tungkulin
Dialogue: 0,0:22:16.74,0:22:18.70,Default,hazelnut,0,0,0,,gumawa ng tagapagmana.
Dialogue: 0,0:22:19.84,0:22:22.68,Default,hazelnut,0,0,0,,Sa tingin ko ito ay hindi katanggap-tanggap.
Dialogue: 0,0:22:23.24,0:22:25.58,Default,hazelnut,0,0,0,,Kaya pumunta ka at magsumbong sa kanya.
Dialogue: 0,0:22:27.88,0:22:31.35,Default,hazelnut,0,0,0,,Ulat?
Dialogue: 0,0:22:32.18,0:22:35.02,Default,hazelnut,0,0,0,,Hindi ko alam kung ano ang sinasabi mo, Kamahalan.
Dialogue: 0,0:22:36.92,0:22:39.26,Default,hazelnut,0,0,0,,Alam mo, palagi mong ginagawa ito.
Dialogue: 0,0:22:43.30,0:22:44.56,Default,hazelnut,0,0,0,,How dare you?
Dialogue: 0,0:22:45.53,0:22:47.17,Default,hazelnut,0,0,0,,Dapat kitang parusahan!
Dialogue: 0,0:22:49.60,0:22:51.80,Default,hazelnut,0,0,0,,Patawarin mo ako, Kamahalan.
Dialogue: 0,0:22:52.17,0:22:54.64,Default,hazelnut,0,0,0,,-Patayin mo ako.\N-Ano bang problema mo?
Dialogue: 0,0:22:55.47,0:22:57.28,Default,hazelnut,0,0,0,,Hindi ko sinabi sa iyo.
Dialogue: 0,0:23:04.98,0:23:07.65,Default,hazelnut,0,0,0,,Ngayon ang buhay ko ay nasa iyong mga kamay.
Dialogue: 0,0:23:08.32,0:23:10.09,Default,hazelnut,0,0,0,,Hindi ko ito kailangan.
Dialogue: 0,0:23:10.66,0:23:12.49,Default,hazelnut,0,0,0,,Ano ang dapat kong gawin sa kanya?
Dialogue: 0,0:23:13.29,0:23:16.23,Default,hazelnut,0,0,0,,Pakipatay mo ako, Kamahalan.
Dialogue: 0,0:23:16.23,0:23:18.03,Default,hazelnut,0,0,0,,God. Sabi ko hindi na kailangan.
Dialogue: 0,0:23:22.70,0:23:24.30,Default,hazelnut,0,0,0,,Alam kong wala kang pagpipilian.
Dialogue: 0,0:23:24.70,0:23:26.34,Default,hazelnut,0,0,0,,Dapat mong sundin ang mga utos.
Dialogue: 0,0:23:31.81,0:23:35.81,Default,hazelnut,0,0,0,,Mas maganda kung galit ka sa akin.
Dialogue: 0,0:23:36.95,0:23:39.62,Default,hazelnut,0,0,0,,Mas malala ito.
Dialogue: 0,0:23:42.29,0:23:46.33,Default,hazelnut,0,0,0,,Paano ka magiging espiya kung napakadali mong matakot?
Dialogue: 0,0:23:48.86,0:23:51.43,Default,hazelnut,0,0,0,,Kailangan kong pumunta sa isang lugar bago ang meeting.
Dialogue: 0,0:23:52.20,0:23:54.10,Default,hazelnut,0,0,0,,Pumunta sa Injeongjeong.
Dialogue: 0,0:23:56.87,0:23:59.64,Default,hazelnut,0,0,0,,God, mababasa mo ba ito sa ibang lugar?
Dialogue: 0,0:23:59.64,0:24:01.57,Default,hazelnut,0,0,0,,Natakot ang punong eunuch.
Dialogue: 0,0:24:23.16,0:24:24.96,Default,,0,0,0,,Sana nakatulog ka ng maayos.
Dialogue: 0,0:24:26.67,0:24:29.13,Default,,0,0,0,,Kaya kamustahin mo ang iyong mga nakatatanda?
Dialogue: 0,0:24:29.94,0:24:32.00,Default,,0,0,0,,Napakabigat ng mga stud.
Dialogue: 0,0:24:32.14,0:24:34.01,Default,,0,0,0,,Hindi ko maiyuko ang aking ulo.
Dialogue: 0,0:24:35.54,0:24:38.84,Default,,0,0,0,,Isinasagawa ang mga ritwal sa sagradong lugar na ito at inaalala ang mga ninuno.
Dialogue: 0,0:24:39.11,0:24:42.58,Default,,0,0,0,,Hindi angkop na pumunta dito na may kasamang mga dekorasyon.
Dialogue: 0,0:24:43.65,0:24:47.25,Default,,0,0,0,,Bago mag-isyu ng return, kailangan mong linisin ang mga balahibo.
Dialogue: 0,0:24:49.22,0:24:50.59,Default,,0,0,0,,Wow, nakalimutan ko na.
Dialogue: 0,0:24:50.86,0:24:53.29,Default,,0,0,0,,Kailangan nating magsindi ng insenso para sa namatay na hari.
Dialogue: 0,0:24:54.73,0:24:58.00,Default,,0,0,0,,At paano ko mapapahiya ang Chonghak na pagtuturo sa etiquette.
Dialogue: 0,0:25:03.37,0:25:04.60,Default,,0,0,0,,Stop.
Dialogue: 0,0:25:04.94,0:25:07.07,Default,,0,0,0,,Ako ay isang masigasig na tagasunod ng Confucianism.
Dialogue: 0,0:25:07.74,0:25:10.01,Default,,0,0,0,,Hindi ko kayang panindigan ang hindi natutupad na mga ritwal.
Dialogue: 0,0:25:10.84,0:25:12.18,Default,,0,0,0,,Sinabi ko sayong huwag mong hawakan ito.
Dialogue: 0,0:25:13.68,0:25:15.95,Default,,0,0,0,,May iniwan ka sa kwarto ko.
Dialogue: 0,0:25:17.98,0:25:20.92,Default,,0,0,0,,Sila ay nagpakita nang walang babala at itinutok ang kanilang ilong sa aking mga gawain.
Dialogue: 0,0:25:23.56,0:25:25.69,Default,,0,0,0,,Halos kapareho ng ngayon.
Dialogue: 0,0:25:26.56,0:25:28.33,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:25:28.96,0:25:31.33,Default,,0,0,0,,Sinabi sa iyo ang parehong bagay. Bumalik.
Dialogue: 0,0:25:32.16,0:25:34.20,Default,,0,0,0,,Nagdusa ako ng husto dito - kailangan kong ibalik ang lahat.
Dialogue: 0,0:25:34.80,0:25:37.80,Default,,0,0,0,,Anong klaseng bastos na salita ang sinasabi mo?
Dialogue: 0,0:25:38.27,0:25:40.34,Default,,0,0,0,,Slandi your elders
Dialogue: 0,0:25:40.34,0:25:42.47,Default,,0,0,0,,at magreklamo tungkol sa buhay.
Dialogue: 0,0:25:43.44,0:25:44.74,Default,,0,0,0,,Palagi kang ganito,
Dialogue: 0,0:25:44.74,0:25:47.58,Default,,0,0,0,,ngunit ngayon ang iyong init ng ulo ay lumampas sa lahat ng hangganan.
Dialogue: 0,0:25:48.38,0:25:52.75,Default,,0,0,0,,Hindi ba dahil lumaki kang walang kamay ng ina?
Dialogue: 0,0:25:53.49,0:25:55.29,Default,,0,0,0,,Hoy, biyenan.
Dialogue: 0,0:25:57.02,0:25:58.82,Default,,0,0,0,,Kung bastos ako, dahil lumaki akong walang ina,
Dialogue: 0,0:25:59.83,0:26:02.53,Default,,0,0,0,,tapos bastos ka dahil hindi mo pinalaki ang anak mo?
Dialogue: 0,0:26:04.66,0:26:06.00,Default,,0,0,0,,Mainit!
Dialogue: 0,0:26:09.90,0:26:12.47,Default,,0,0,0,,Nakakainis ang lahat kaya hindi ko kinaya ang init.
Dialogue: 0,0:26:13.77,0:26:15.84,Default,,0,0,0,,Larawan ng iyong pinakamamahal na anak
Dialogue: 0,0:26:15.84,0:26:17.78,Default,,0,0,0,,halos masunog.
Dialogue: 0,0:26:18.54,0:26:20.41,Default,,0,0,0,,Nasisiraan ka na ba ng bait?
Dialogue: 0,0:26:21.18,0:26:23.85,Default,,0,0,0,,Oo, sigurado at hindi na mababawi.
Dialogue: 0,0:26:24.75,0:26:27.55,Default,,0,0,0,,Sa lahat ng mga baliw, ako ang pinaka masugid.
Dialogue: 0,0:26:29.19,0:26:31.06,Default,,0,0,0,,Kaya pumunta at tumingin sa paligid.
Dialogue: 0,0:26:38.76,0:26:41.03,Default,,0,0,0,,Kahit na may malaglag na buhok sa ulo ko,
Dialogue: 0,0:26:44.47,0:26:46.84,Default,,0,0,0,,at hindi mo na makikita ang iyong anak.
Dialogue: 0,0:27:17.49,0:27:20.11,Default,,0,0,0,,Hindi ang reyna ang dapat alalahanin,
Dialogue: 0,0:27:21.54,0:27:23.31,Default,,0,0,0,,at tungkol sa lahat ng iba pa.
Dialogue: 0,0:27:30.05,0:27:32.85,Default,,0,0,0,,Ang pinakamahusay na depensa ay isang pag-atake.
Dialogue: 0,0:27:49.74,0:27:53.71,Default,,0,0,0,,Wow, hindi ko napansin na nandito ka rin pala.
Dialogue: 0,0:27:54.57,0:27:57.48,Default,,0,0,0,,May mga taong multo.\NNaglalakad sila at hindi kumikinang.
Dialogue: 0,0:27:58.94,0:28:01.45,Default,,0,0,0,,Nagtatapon ako ng pancake dito sa pond.\NDGusto mo bang sumama sa akin?
Dialogue: 0,0:28:01.45,0:28:02.75,Default,,0,0,0,,Ihagis mo ito sa iyong sarili.
Dialogue: 0,0:28:05.18,0:28:06.39,Default,,0,0,0,,Account book.
Dialogue: 0,0:28:07.85,0:28:09.29,Default,,0,0,0,,Nakuha mo.
Dialogue: 0,0:28:11.22,0:28:13.73,Default,,0,0,0,,Dahil sa kanya, muntik na akong mamatay.
Dialogue: 0,0:28:17.50,0:28:18.53,Default,,0,0,0,,Sabihin mo sa akin.
Dialogue: 0,0:28:20.57,0:28:21.87,Default,,0,0,0,,Nakamit mo ba ito?
Dialogue: 0,0:28:23.40,0:28:25.67,Default,,0,0,0,,Hindi mo talaga pinatay si Ovol?
Dialogue: 0,0:28:27.37,0:28:30.21,Default,,0,0,0,,Kahit anong sabihin ko, kung ano ang gusto mo, pinaniniwalaan mo lang.
Dialogue: 0,0:28:30.21,0:28:32.04,Default,,0,0,0,,Dapat kong kunin ang hari mula sa iyo,
Dialogue: 0,0:28:32.04,0:28:34.21,Default,,0,0,0,,patayin si Ovol at itapon ang kanyang katawan sa balon.
Dialogue: 0,0:28:34.21,0:28:36.32,Default,,0,0,0,,Kung gayon ako ay magiging isang kontrabida na karapat-dapat na mamatay,
Dialogue: 0,0:28:37.28,0:28:39.38,Default,,0,0,0,,at isa kang inosenteng biktima, santo.
Dialogue: 0,0:28:42.82,0:28:45.39,Default,,0,0,0,,Ito ang dahilan kung bakit mapanganib ang paglalaro ng biktima.
Dialogue: 0,0:28:45.49,0:28:47.13,Default,,0,0,0,,Dahan-dahang nagiging halimaw -
Dialogue: 0,0:28:49.83,0:28:52.06,Default,,0,0,0,,at ikaw mismo ay hindi napapansin.
Dialogue: 0,0:29:08.65,0:29:09.88,Default,,0,0,0,,Tumingin ka sa salamin.
Dialogue: 0,0:29:10.65,0:29:12.28,Default,,0,0,0,,Tingnan mo ang iyong kapangitan.
Dialogue: 0,0:29:32.64,0:29:34.48,Default,,0,0,0,,Maghintay ka kung gusto mong lumabas.
Dialogue: 0,0:29:35.21,0:29:37.61,Default,,0,0,0,,Walang mood para sa mabubuting gawa.
Dialogue: 0,0:29:56.50,0:29:58.63,Default,,0,0,0,,Nang nahulog ako sa tubig sa harap ng iyong mga mata,
Dialogue: 0,0:30:00.90,0:30:02.13,Default,,0,0,0,,malamang,
Dialogue: 0,0:30:04.37,0:30:06.44,Default,,0,0,0,,iabot mo sana ang kamay mo sa akin.
Dialogue: 0,0:30:11.94,0:30:13.05,Default,,0,0,0,,Ito ay nagpapatunay
Dialogue: 0,0:30:14.25,0:30:16.88,Default,,0,0,0,,na bilang tao mas magaling ako sa iyo.
Dialogue: 0,0:30:31.53,0:30:33.60,Default,,0,0,0,,Kim Jwageun, kumander ng tropa,
Dialogue: 0,0:30:35.10,0:30:37.10,Default,,0,0,0,,umalis sa kanyang post.
Dialogue: 0,0:30:38.10,0:30:39.37,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:30:40.01,0:30:41.84,Default,,0,0,0,,Naantala ang pagbibitiw,
Dialogue: 0,0:30:41.84,0:30:44.24,Default,,0,0,0,,kayong lahat ay magsisi para dito.
Dialogue: 0,0:30:45.11,0:30:46.18,Default,,0,0,0,,Nakakahiya.
Dialogue: 0,0:30:49.15,0:30:51.12,Default,,0,0,0,,Teka, nagkamali ako.
Dialogue: 0,0:30:51.78,0:30:53.32,Default,,0,0,0,,Nakakaluwag.
Dialogue: 0,0:30:57.72,0:30:59.16,Default,,0,0,0,,Susunod na tanong.
Dialogue: 0,0:30:59.16,0:31:02.56,Default,,0,0,0,,Pero may gusto muna akong i-announce.
Dialogue: 0,0:31:04.70,0:31:07.67,Default,,0,0,0,,Lilikha ako ng ahensya na haharap sa sistema ng tatlong buwis.
Dialogue: 0,0:31:07.80,0:31:11.10,Default,,0,0,0,,Tatawagin itong Samjeong Lijeongjeon.
Dialogue: 0,0:31:11.77,0:31:14.61,Default,,0,0,0,,Samjeong lijongjeong?
Dialogue: 0,0:31:16.21,0:31:18.34,Default,,0,0,0,,Lilikha ito ng mga batas
Dialogue: 0,0:31:18.34,0:31:20.38,Default,,0,0,0,,at bubuo ng mga plano upang malutas
Dialogue: 0,0:31:20.51,0:31:22.78,Default,,0,0,0,,ang mga pangunahing pagkukulang ng tatlong-tax system.
Dialogue: 0,0:31:25.55,0:31:27.85,Default,,0,0,0,,Nabubuhay ang bansa sa agrikultura.
Dialogue: 0,0:31:28.69,0:31:30.62,Default,,0,0,0,,Ang mga magsasaka ay umunlad, gayon din siya.
Dialogue: 0,0:31:30.76,0:31:33.83,Default,,0,0,0,,Mga opisyal na tumatakas sa mga ordinaryong magsasaka,
Dialogue: 0,0:31:33.83,0:31:35.76,Default,,0,0,0,,- isang banta sa estado.
Dialogue: 0,0:31:36.36,0:31:39.70,Default,,0,0,0,,Ang kanilang mga kalupitan ay ituturing na pagtataksil.
Dialogue: 0,0:31:40.07,0:31:43.50,Default,,0,0,0,,Bago lumikha ng bagong departamento\Kailangan mong pag-aralan nang mabuti ang lahat.
Dialogue: 0,0:31:44.10,0:31:46.51,Default,,0,0,0,,Pakinggan man lang ang aming opinyon bago...
Dialogue: 0,0:31:46.51,0:31:50.08,Default,,0,0,0,,Hindi ako gagawa ng konsesyon,\Ginagawa ang dapat kong gawin.
Dialogue: 0,0:31:51.41,0:31:52.48,Default,,0,0,0,,Ibig sabihin,
Dialogue: 0,0:31:53.31,0:31:55.95,Default,,0,0,0,,na hindi na mahalaga ang iyong opinyon.
Dialogue: 0,0:32:03.22,0:32:05.99,Default,,0,0,0,,Ibibigay ko rin sa yumaong Haring Seongjong
Dialogue: 0,0:32:06.86,0:32:10.60,Default,,0,0,0,,posthumous na pangalan ni Sunjo, ayon sa hinihingi ng tradisyon.
Dialogue: 0,0:32:17.17,0:32:20.37,Default,,0,0,0,,Higit na mapilit ang Kanyang Kamahalan kaysa karaniwan ngayon.
Dialogue: 0,0:32:27.05,0:32:28.25,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:32:28.85,0:32:31.02,Default,,0,0,0,,May bagong appointment ngayon.
Dialogue: 0,0:32:31.92,0:32:33.95,Default,,0,0,0,,Nagkamali ang chief secretary.
Dialogue: 0,0:32:34.62,0:32:36.42,Default,,0,0,0,,Pinag-uusapan natin ang tungkol sa pagmumungkahi ng kandidatura.
Dialogue: 0,0:32:37.72,0:32:40.29,Default,,0,0,0,,Ang lugar ng Ministro ng Digmaan ay libre.
Dialogue: 0,0:32:41.06,0:32:44.50,Default,,0,0,0,,Ang mahinang hukbo ay hahantong sa isang krisis sa buong bansa.
Dialogue: 0,0:32:44.50,0:32:46.80,Default,,0,0,0,,Kaya iginigiit kong aprubahan mo
Dialogue: 0,0:32:46.80,0:32:49.47,Default,,0,0,0,,kandidato na pinili ng konseho ng militar.
Dialogue: 0,0:32:50.97,0:32:52.57,Default,,0,0,0,,Darating na ang Ministro ng Digmaan.
Dialogue: 0,0:33:15.86,0:33:17.60,Default,,0,0,0,,Kim Byonin, Ministro ng Digmaan,
Dialogue: 0,0:33:20.47,0:33:21.94,Default,,0,0,0,,bati sa Kamahalan.
Dialogue: 0,0:33:35.75,0:33:39.12,Default,,0,0,0,,Maaaring mapanganib si Kim Byunin - suportado siya ng pamilyang Cho.
Dialogue: 0,0:33:40.39,0:33:41.59,Default,,0,0,0,,At Cho, at Kim
Dialogue: 0,0:33:41.59,0:33:43.82,Default,,0,0,0,,tinanong siya.
Dialogue: 0,0:33:43.96,0:33:45.62,Default,,0,0,0,,Ito ay dapat din ang kanyang ginagawa.
Dialogue: 0,0:33:48.39,0:33:50.83,Default,,0,0,0,,Sa palagay ko hindi natin maaaring pumikit sa kanilang mga kahilingan.
Dialogue: 0,0:33:50.83,0:33:54.57,Default,,0,0,0,,Maaaring bigyan nito ang mga aristokrata ng dahilan para mag-alsa.
Dialogue: 0,0:33:57.04,0:33:58.54,Default,,0,0,0,,Malaya ka nang gawin,
Dialogue: 0,0:33:58.54,0:34:00.31,Default,,0,0,0,,anuman ang gusto mo.
Dialogue: 0,0:34:00.31,0:34:02.21,Default,,0,0,0,,Ngunit mahirap pa ring pigilan ang kanilang mga pag-atake.
Dialogue: 0,0:34:02.21,0:34:05.11,Default,,0,0,0,,Ang pinakamahusay na depensa ay isang pag-atake.
Dialogue: 0,0:34:05.61,0:34:07.01,Default,,0,0,0,,Kailangang hampasin
Dialogue: 0,0:34:07.01,0:34:09.88,Default,,0,0,0,,mas mabilis kaysa sa kalaban.
Dialogue: 0,0:34:11.45,0:34:13.19,Default,,0,0,0,,Wala nang oras para mag-recruit pa ng mga sundalo.
Dialogue: 0,0:34:13.82,0:34:16.25,Default,,0,0,0,,Gusto kong alagaan mo si Lijonchon.
Dialogue: 0,0:34:16.42,0:34:18.62,Default,,0,0,0,,Hon, ipapadala kita
Dialogue: 0,0:34:18.62,0:34:20.09,Default,,0,0,0,,sa 3 lungsod sa timog.
Dialogue: 0,0:34:20.09,0:34:22.56,Default,,0,0,0,,Galit ang mga tao doon - magsimula ng imbestigasyon.
Dialogue: 0,0:34:24.30,0:34:25.60,Default,,0,0,0,,Isa pang business trip?
Dialogue: 0,0:34:29.60,0:34:30.80,Default,,0,0,0,,Buweno, para sa aking kapakanan.
Dialogue: 0,0:34:32.17,0:34:36.01,Default,,0,0,0,,Habang papasok sa kagubatan, mas uupo kayong dalawa dito at mag-uutos.
Dialogue: 0,0:34:36.01,0:34:38.84,Default,,0,0,0,,Parang lahat ng tumatakbo ay nasa akin. O mali ako?
Dialogue: 0,0:34:38.84,0:34:41.35,Default,,0,0,0,,Hindi lang sa iyo. lagi akong...
Dialogue: 0,0:34:43.68,0:34:45.28,Default,,0,0,0,,Kapag tapos ka na sa imbestigasyon,
Dialogue: 0,0:34:46.52,0:34:48.79,Default,,0,0,0,,-Maaari kitang bigyan ng bakasyon.\N-Aalis na ako.
Dialogue: 0,0:34:49.15,0:34:51.32,Default,,0,0,0,,Kaya ko.
Dialogue: 0,0:34:51.56,0:34:53.26,Default,,0,0,0,,Sabi ko kaya ko.
Dialogue: 0,0:34:53.26,0:34:55.56,Default,,0,0,0,,I doubt na narinig niya.
Dialogue: 0,0:34:55.89,0:34:57.40,Default,,0,0,0,,Ang tanga.
Dialogue: 0,0:35:02.50,0:35:03.77,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:35:04.20,0:35:07.01,Default,,0,0,0,,May sulat ka.
Dialogue: 0,0:35:09.34,0:35:11.18,Default,,0,0,0,,Hindi kita papatayin, lumapit ka.
Dialogue: 0,0:35:18.55,0:35:22.62,Default,,0,0,0,,Nagpadala sa iyo ng sulat ang Reyna.
Dialogue: 0,0:35:25.79,0:35:27.63,Default,,0,0,0,,May sakit ka ba?
Dialogue: 0,0:35:31.36,0:35:32.70,Default,,0,0,0,, Nanginginig na parang dahon ng taglagas.
Dialogue: 0,0:35:36.54,0:35:41.21,Default,,0,0,0,,Hindi ang paghihiganti ang naisip ko.\NIDapat mas masaya.
Dialogue: 0,0:35:47.11,0:35:48.55,Default,,0,0,0,,Gaano kapana-panabik.
Dialogue: 0,0:35:49.41,0:35:50.45,Default,,0,0,0,,Nanginginig ako.
Dialogue: 0,0:35:57.86,0:35:59.02,Default,,0,0,0,,Kamahalan...
Dialogue: 0,0:36:06.80,0:36:07.80,Default,,0,0,0,,Dumating ka na.
Dialogue: 0,0:36:13.54,0:36:16.64,Default,,0,0,0,,Ang ganda mo ngayon.
Dialogue: 0,0:36:17.28,0:36:18.78,Default,,0,0,0,,Nababagay ito sa iyo.
Dialogue: 0,0:36:18.94,0:36:20.81,Default,,0,0,0,,Bagay ang lahat sa magandang mukha.
Dialogue: 0,0:36:20.81,0:36:22.58,Default,,0,0,0,,Magiging maganda ako kahit sa mga cast-off.
Dialogue: 0,0:36:23.98,0:36:26.32,Default,,0,0,0,,Sino ang nakakaalam na ako ay magiging isang mahusay na reyna.
Dialogue: 0,0:36:29.79,0:36:31.96,Default,,0,0,0,,Hinding-hindi ako masasanay dito.
Dialogue: 0,0:36:33.19,0:36:34.99,Default,,0,0,0,,Humiling ako ng meeting,
Dialogue: 0,0:36:37.00,0:36:38.23,Default,,0,0,0,,upang magmungkahi ng isang alyansa.
Dialogue: 0,0:36:39.60,0:36:42.49,Default,,0,0,0,,Malamang iniwan ako ni Rod,\Niisip ko na ngayon ay kasabay kita.
Dialogue: 0,0:36:42.87,0:36:44.20,Default,,0,0,0,,Wala akong mawawala.
Dialogue: 0,0:36:44.50,0:36:46.40,Default,,0,0,0,,Kung pipiliin mo ako,
Dialogue: 0,0:36:46.77,0:36:48.84,Default,,0,0,0,,magiging kaaway mo ang pamilya Kim.
Dialogue: 0,0:36:48.84,0:36:50.58,Default,,0,0,0,,Niloko muna nila ako.
Dialogue: 0,0:36:50.98,0:36:52.74,Default,,0,0,0,,Ngayon itatapon ko na sila.
Dialogue: 0,0:36:53.41,0:36:55.04,Default,,0,0,0,,Ang isang karaniwang kaaway ay hindi dahilan para magkaisa?
Dialogue: 0,0:37:05.82,0:37:06.86,Default,,0,0,0,,Oo.
Dialogue: 0,0:37:09.19,0:37:12.46,Default,,0,0,0,,Walang social distancing mula ngayon.
Dialogue: 0,0:37:12.73,0:37:15.07,Default,,0,0,0,,Siyempre. Maaari mong hawakan ang lahat.
Dialogue: 0,0:37:19.30,0:37:20.54,Default,,0,0,0,,Sa mga pelikula tungkol sa mga bandido
Dialogue: 0,0:37:20.54,0:37:22.84,Default,,0,0,0,,Nakita ko ang aking mga kaibigan na naghahalo ng dugo sa isang tasa at umiinom.
Dialogue: 0,0:37:23.14,0:37:25.88,Default,,0,0,0,,Ngunit ang dugo ay kahit papaano ay hindi malinis.
Dialogue: 0,0:37:26.51,0:37:28.81,Default,,0,0,0,,Ipagdiwang natin ang ating pagsasama sa tsaa.
Dialogue: 0,0:37:28.81,0:37:29.95,Default,,0,0,0,,Simple at masarap.
Dialogue: 0,0:37:37.99,0:37:39.02,Default,,0,0,0,,Ano?
Dialogue: 0,0:37:41.66,0:37:44.13,Default,,0,0,0,,Ganito ba umiinom ang mga kaalyado?
Dialogue: 0,0:37:44.13,0:37:46.03,Default,,0,0,0,,Oo, para sa kapatiran.
Dialogue: 0,0:37:46.03,0:37:48.40,Default,,0,0,0,,-Sa ibaba.\N-Ano...
Dialogue: 0,0:37:54.94,0:37:58.38,Default,,0,0,0,,Dahil magkapatid tayo, linawin natin ang lahat.
Dialogue: 0,0:37:59.21,0:38:00.58,Default,,0,0,0,,Bakit mo ako gustong patayin?
Dialogue: 0,0:38:03.35,0:38:04.38,Default,,0,0,0,,Tama.
Dialogue: 0,0:38:05.75,0:38:07.95,Default,,0,0,0,,Ito ay sulit na pag-usapan.
Dialogue: 0,0:38:09.89,0:38:11.76,Default,,0,0,0,,Akala namin narinig mo ang usapan namin
Dialogue: 0,0:38:11.76,0:38:13.49,Default,,0,0,0,,tungkol sa pagtatangkang pagpatay sa iyong ama.
Dialogue: 0,0:38:14.86,0:38:16.66,Default,,0,0,0,,Siya pa rin ang biyenan mo.
Dialogue: 0,0:38:16.83,0:38:19.66,Default,,0,0,0,,Para sa akin, isa siya sa mga corrupt na opisyal.
Dialogue: 0,0:38:19.93,0:38:21.30,Default,,0,0,0,,Walang Puso.
Dialogue: 0,0:38:21.87,0:38:24.00,Default,,0,0,0,,Malinaw na sa iyo ang lahat.\NA at hindi niya pinabayaan ang sarili niyang asawa.
Dialogue: 0,0:38:24.30,0:38:25.74,Default,,0,0,0,,Serial killer Kimov.
Dialogue: 0,0:38:26.74,0:38:27.87,Default,,0,0,0,,Paumanhin.
Dialogue: 0,0:38:28.81,0:38:30.81,Default,,0,0,0,,Alam kong hindi masyadong magbabago ang paghingi ko ng tawad,
Dialogue: 0,0:38:31.91,0:38:34.05,Default,,0,0,0,,pero napakaraming hindi pagkakaunawaan sa pagitan namin.
Dialogue: 0,0:38:35.15,0:38:36.15,Default,,0,0,0,,Okay.
Dialogue: 0,0:38:37.02,0:38:38.58,Default,,0,0,0,,May utang ka sa akin.
Dialogue: 0,0:38:38.58,0:38:40.29,Default,,0,0,0,,Hindi kita mapapatawad hangga't hindi mo binabalikan ang pabor.
Dialogue: 0,0:38:42.29,0:38:43.89,Default,shooting,0,0,0,,So ano ang gusto mo?
Dialogue: 0,0:38:44.26,0:38:45.36,Default,shooting,0,0,0,,Palakasin ang iyong kapangyarihan?
Dialogue: 0,0:38:45.36,0:38:49.63,Default,shooting,0,0,0,,Ito ay isang paraan lamang upang maibalik ang ating nawasak na bansa.
Dialogue: 0,0:38:50.73,0:38:53.40,Default,shooting,0,0,0,,Hindi ko akalain na ang pundasyon ng lipunan ay madaling mabago.
Dialogue: 0,0:38:53.97,0:38:56.53,Default,shooting,0,0,0,,Sa totoo lang, mas gusto ko ang pamamaraan kaysa sa layunin.
Dialogue: 0,0:38:56.84,0:38:58.77,Default,shooting,0,0,0,,Kung palalakasin mo ang iyong kapangyarihan,
Dialogue: 0,0:38:59.34,0:39:01.14,Default,shooting gallery,0,0,0,,at walang makakalapit sa akin.
Dialogue: 0,0:39:02.71,0:39:05.24,Default,shooting,0,0,0,,Alam ko ang takot sa kamatayan.
Dialogue: 0,0:39:06.21,0:39:10.01,Default,shooting,0,0,0,,Alam kong masungit ka,\Npero natatakot ka.
Dialogue: 0,0:39:10.68,0:39:11.68,Default,shooting,0,0,0,,Hindi ko alam.
Dialogue: 0,0:39:12.15,0:39:14.05,Default,shooting gallery,0,0,0,,Siguro dahil namamatay na siya?
Dialogue: 0,0:39:14.05,0:39:15.85,Default,shooting,0,0,0,,Para sa akin, ang pagpapabaya ay mas masahol pa sa kamatayan.
Dialogue: 0,0:39:16.79,0:39:20.19,Default,shooting,0,0,0,,Kung kaya kong bigyan ng pambubugbog ang lahat ng humahamak sa akin,
Dialogue: 0,0:39:21.69,0:39:23.50,Default,shooting,0,0,0,,tapos mamamatay akong nakangiti.
Dialogue: 0,0:39:26.10,0:39:27.17,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:39:27.57,0:39:30.10,Default,shooting,0,0,0,,Oras na para magluto ng hapunan.
Dialogue: 0,0:39:30.10,0:39:32.34,Default,shooting,0,0,0,,Oo. Kung gayon
Dialogue: 0,0:39:33.94,0:39:35.34,Default,shooting,0,0,0,,Iiwan kita.
Dialogue: 0,0:39:52.46,0:39:54.39,Default,shooting,0,0,0,,Mamamatay akong nakangiti.
Dialogue: 0,0:39:55.36,0:39:56.86,Default,shooting,0,0,0,,"Mamamatay akong nakangiti."
Dialogue: 0,0:40:13.58,0:40:16.41,Default,shooting,0,0,0,,-Mr. Kim.\N-Byonin.
Dialogue: 0,0:40:17.18,0:40:19.82,Default,shooting,0,0,0,,Iyon ay, ang Ministro ng Digmaan.
Dialogue: 0,0:40:20.49,0:40:23.35,Default,shooting gallery,0,0,0,,-Niloloko mo ba ako?\N-Ano ka, siyempre hindi.
Dialogue: 0,0:40:23.76,0:40:25.52,Default,shooting,0,0,0,,Pakitawagan ako sa pangalan.
Dialogue: 0,0:40:25.76,0:40:28.09,Default,shooting gallery,0,0,0,,Sa totoo lang, hinihintay kita,
Dialogue: 0,0:40:29.19,0:40:32.40,Default,shooting,0,0,0,,dahil gusto kitang kausapin tungkol sa reyna.
Dialogue: 0,0:40:33.63,0:40:37.87,Default,shooting,0,0,0,,Nga pala, may sasabihin din ako sa iyo tungkol dito.
Dialogue: 0,0:40:49.28,0:40:51.82,Default,shooting range,0,0,0,,Saan ko ito inilagay?
Dialogue: 0,0:40:52.42,0:40:54.85,Default,shooting gallery,0,0,0,,Saan pupunta?
Dialogue: 0,0:40:57.19,0:41:00.19,Default,shooting gallery,0,0,0,,-Teka.\N-Nakita ko.
Dialogue: 0,0:41:05.66,0:41:06.66,Default,shooting,0,0,0,,Ikaw!
Dialogue: 0,0:41:07.20,0:41:10.74,Default,shooting,0,0,0,,How dare you use a knife? \NHalos isang linggo ka na rito.
Dialogue: 0,0:41:13.20,0:41:15.07,Default,shooting,0,0,0,,Ngayon nagbago na ang lahat.
Dialogue: 0,0:41:15.07,0:41:19.64,Default,tira,0,0,0,,Kamakailan, ang mga kusinero ay tumatangging uminom ng makgeolli pagkatapos ng trabaho.
Dialogue: 0,0:41:19.64,0:41:22.01,Default,shooting,0,0,0,,Palagi silang nagsasabi ng "hindi" at "hindi".
Dialogue: 0,0:41:22.01,0:41:24.82,Default,shooting,0,0,0,,Sabi ko gagamutin ko sila, pero tumanggi pa rin sila.
Dialogue: 0,0:41:24.82,0:41:25.82,Default,shooting,0,0,0,,Pumunta at unawain sila.
Dialogue: 0,0:41:26.35,0:41:30.86,Default,shooting,0,0,0,,Hindi ko rin maintindihan itong mga court ladies.
Dialogue: 0,0:41:31.76,0:41:35.89,Default,dash,0,0,0,,Sinabi sa kanila na pumunta mamaya, at dumating talaga sila mamaya.
Dialogue: 0,0:41:35.89,0:41:38.73,Default,shooting,0,0,0,,Dapat ay dumating na sila nang maaga.
Dialogue: 0,0:41:39.50,0:41:41.17,Default,shooting,0,0,0,,-Well, anong klaseng mga bata ang napuntahan nila.\N-Well, anong klaseng mga bata ang napunta.
Dialogue: 0,0:41:44.84,0:41:45.97,Default,shooting gallery,0,0,0,,Sa Dongmyeongjong hall.
Dialogue: 0,0:41:53.61,0:41:54.61,Default,shooting gallery,0,0,0,,Holy shit.
Dialogue: 0,0:41:55.65,0:41:57.68,Default,shooting gallery,0,0,0,,Isa pang bagay na dapat ipaghiganti.
Dialogue: 0,0:41:58.38,0:41:59.58,Default,shooting,0,0,0,,Recipe para sa paghihiganti?
Dialogue: 0,0:42:03.92,0:42:06.06,Default,shooting,0,0,0,,Isasagot ko naman siya diba?
Dialogue: 0,0:42:06.62,0:42:08.46,Default,shooting,0,0,0,,Isang mata sa mata. Isang ngipin para sa isang ngipin.
Dialogue: 0,0:42:08.86,0:42:10.40,Default,shooting,0,0,0,,Pagkakalalaki para sa dignidad ng lalaki.
Dialogue: 0,0:42:11.80,0:42:14.20,Default,tyra,0,0,0,,Then fern?
Dialogue: 0,0:42:15.70,0:42:17.57,Default,tyra,0,0,0,,-Beaded na halaman?\N-Fern at beaded plant.
Dialogue: 0,0:42:17.57,0:42:19.87,Default,tyra,0,0,0,,Maraming kapaki-pakinabang na sangkap ang recipe na ito.
Dialogue: 0,0:42:20.31,0:42:22.27,Default,shooting,0,0,0,,Kaya tutungo ako magpakailanman patungo sa aking layunin.
Dialogue: 0,0:42:22.61,0:42:24.18,Default,shooting,0,0,0,,Ito ay masyadong mahaba.
Dialogue: 0,0:42:26.44,0:42:27.71,Default,shooting gallery,0,0,0,,Let's go all in.
Dialogue: 0,0:42:30.01,0:42:31.98,Default,shooting,0,0,0,,-Castration.\N-Castration?
Dialogue: 0,0:42:33.45,0:42:34.62,Default,shooting,0,0,0,,Hindi ko narinig...
Dialogue: 0,0:42:37.86,0:42:39.49,Default,shooting,0,0,0,,Nakikita ko.
Dialogue: 0,0:42:40.19,0:42:41.43,Default,tyra,0,0,0,,Ang isang mahalagang sangkap.
Dialogue: 0,0:42:46.06,0:42:47.83,Default,shooting,0,0,0,,Ayokong mabigatan ka.
Dialogue: 0,0:42:48.43,0:42:51.24,Default,shooting,0,0,0,,Alam ko kung kailan susuko.
Dialogue: 0,0:42:51.84,0:42:53.14,Default,shooting,0,0,0,,Paumanhin.
Dialogue: 0,0:42:53.20,0:42:54.34,Default,shooting,0,0,0,,Huwag humingi ng tawad.
Dialogue: 0,0:42:56.37,0:43:00.11,Default,shooting,0,0,0,,Pwede bang magtanong ng isang tanong lang?
Dialogue: 0,0:43:00.75,0:43:02.75,Default,shooting,0,0,0,,-Oo.\N-Bakit ka
Dialogue: 0,0:43:03.65,0:43:05.85,Default,shooting,0,0,0,,ayaw sa mga lalaking may layunin?
Dialogue: 0,0:43:08.42,0:43:12.52,Default,shooting gallery,0,0,0,,Sa palasyo nakita ko ang maraming may layuning tao
Dialogue: 0,0:43:13.59,0:43:15.89,Default,shooting,0,0,0,,at kung gaano kahirap para sa kanila.
Dialogue: 0,0:43:16.43,0:43:17.96,Default,shooting,0,0,0,,Natatakot ako
Dialogue: 0,0:43:18.63,0:43:20.33,Default,shooting,0,0,0,,at hindi ko ito gusto para sa sarili ko.
Dialogue: 0,0:43:23.13,0:43:24.74,Default,dash,0,0,0,,Salamat sa iyong tugon.
Dialogue: 0,0:43:35.05,0:43:38.22,Default,shooting,0,0,0,,Lahat ng gusto kong hilingin sa iyo,
Dialogue: 0,0:43:39.68,0:43:41.62,Default,shooting,0,0,0,,para palagi kang
Dialogue: 0,0:43:42.92,0:43:44.12,Default,shooting,0,0,0,,ngumiti.
Dialogue: 0,0:43:44.52,0:43:45.92,Default,shooting,0,0,0,,Oh, ikaw pala.
Dialogue: 0,0:43:50.60,0:43:51.60,Default,shooting,0,0,0,,Malamang, ito na ang katapusan.
Dialogue: 0,0:43:51.60,0:43:53.87,Default,shooting,0,0,0,,Talagang matalas ang mata mo.
Dialogue: 0,0:43:54.23,0:43:55.47,Default,shooting gallery,0,0,0,,Naunawaan mo kaagad ang lahat.
Dialogue: 0,0:43:55.63,0:43:58.67,Default,shooting,0,0,0,,Paano ko hindi maintindihan kapag umiiyak ka ng ganyan?
Dialogue: 0,0:44:00.27,0:44:01.47,Default,shooting,0,0,0,,Huwag tumingin.
Dialogue: 0,0:44:04.08,0:44:07.41,Default,shooting,0,0,0,,Ayokong makitang ganito.
Dialogue: 0,0:44:08.65,0:44:10.98,Default,shooting gallery,0,0,0,,Pagkatapos ay pumunta sa kanto at umiyak doon.
Dialogue: 0,0:44:10.98,0:44:13.42,Default,shooting,0,0,0,,Magpapasya pa rin ang mga tao na dahil ito sa akin.
Dialogue: 0,0:44:14.32,0:44:15.55,Default,shooting,0,0,0,,Hindi dahil sa akin.
Dialogue: 0,0:44:18.76,0:44:20.36,Default,shooting,0,0,0,,Hindi na ako iiyak.
Dialogue: 0,0:44:21.36,0:44:24.76,Default,shooting,0,0,0,,Ang pagiging ganap na maalis ang damdamin ay bahagi ng pag-ibig.
Dialogue: 0,0:44:25.23,0:44:29.17,Default,dash,0,0,0,,Maaaring mas mahirap ito kaysa sa patuloy na pagmamahal sa kanya.
Dialogue: 0,0:44:30.00,0:44:31.57,Default,shooting,0,0,0,,Ikaw ay isang makata.
Dialogue: 0,0:44:32.64,0:44:34.94,Default,shooting range,0,0,0,,Tara na. Huwag kang umiyak.
Dialogue: 0,0:44:40.31,0:44:44.02,Default,tyra,0,0,0,,Sinasadya niya ba akong padalhan ng pagkain?
Dialogue: 0,0:44:52.16,0:44:53.89,Default,shooting,0,0,0,,Ano itong nakakatakot na drawing?
Dialogue: 0,0:44:53.89,0:44:57.50,Default,shooting gallery,0,0,0,,Ang ganda nito.
Dialogue: 0,0:44:58.13,0:45:00.73,Default,shooting gallery,0,0,0,,Court lady Chon, kahit lason ay hindi ka kukuha,
Dialogue: 0,0:45:00.83,0:45:02.50,Default,shooting,0,0,0,,napakabagal mong mag-isip.
Dialogue: 0,0:45:03.94,0:45:06.27,Default,shooting,0,0,0,,Bakit bigla mo akong pinupuri?
Dialogue: 0,0:45:25.59,0:45:26.89,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:45:27.59,0:45:32.90,Default,tyra,0,0,0,,Ako, si Simon ng pamilya Khan, ay dumating upang batiin ka.
Dialogue: 0,0:45:37.90,0:45:39.77,Default,shooting,0,0,0,,Hindi pa ba tayo nagkita?
Dialogue: 0,0:45:44.61,0:45:45.88,Default,shooting,0,0,0,,Lubos akong nagpapasalamat.
Dialogue: 0,0:45:46.81,0:45:49.51,Default,shooting,0,0,0,,Ibig sabihin, ako... Patawarin mo ako.
Dialogue: 0,0:45:50.75,0:45:53.15,Default,shooting,0,0,0,,Sa tingin ko dapat mo akong sabihin sa iba.
Dialogue: 0,0:45:53.48,0:45:54.69,Default,dash,0,0,0,,Halimbawa,
Dialogue: 0,0:45:55.89,0:45:57.92,Default,dash,0,0,0,,"Karapat-dapat akong mamatay."
Dialogue: 0,0:45:59.19,0:46:02.56,Default,dash,0,0,0,,Dahil sa iyo, nabuhos ko lahat ng popcorn na pinaghirapan ko.
Dialogue: 0,0:46:02.86,0:46:05.00,Default,shooting,0,0,0,,Scattered noong pinalipad mo siya.
Dialogue: 0,0:46:05.70,0:46:09.60,Default,shooting,0,0,0,,Wala akong ideya na may isang reyna sa harap ko,
Dialogue: 0,0:46:10.64,0:46:14.57,Default,shooting,0,0,0,,Nakagawa ako ng malubhang krimen.
Dialogue: 0,0:46:16.71,0:46:18.24,Default,shooting,0,0,0,,Wala akong ideya na ako iyon?
Dialogue: 0,0:46:20.48,0:46:21.48,Default,shooting gallery,0,0,0,,Kung gayon bakit ka tumakas?
Dialogue: 0,0:46:21.48,0:46:23.58,Default,shooting,0,0,0,,Well, iyan ay dahil...
Dialogue: 0,0:46:23.58,0:46:26.32,Default,shooting,0,0,0,,Sumugod sa akin ang gayong marangal na tao,
Dialogue: 0,0:46:26.32,0:46:28.05,Default,shooting gallery,0,0,0,,kaya nagulat ako.
Dialogue: 0,0:46:28.49,0:46:31.72,Default,shooting,0,0,0,,Wala akong ibang dahilan.
Dialogue: 0,0:46:31.82,0:46:32.92,Default,shooting,0,0,0,,Talaga?
Dialogue: 0,0:46:37.53,0:46:39.53,Default,shooting,0,0,0,,Sa totoo lang, tinawag kita,
Dialogue: 0,0:46:42.83,0:46:44.70,Default,shooting,0,0,0,,upang bigyan ka ng lugar sa court.
Dialogue: 0,0:46:46.67,0:46:49.71,Default,shooting gallery,0,0,0,,Isang magandang lugar kung saan siguradong hindi ka masisipa
Dialogue: 0,0:46:49.71,0:46:50.78,Default,shooting,0,0,0,,at magbabayad sila ng maayos.
Dialogue: 0,0:46:52.41,0:46:53.98,Default,shooting gallery,0,0,0,,Ngunit kailangan mong mawala ang isang bagay.
Dialogue: 0,0:46:55.01,0:46:56.08,Default,shooting,0,0,0,,Ano?
Dialogue: 0,0:46:57.92,0:46:59.28,Default,shooting gallery,0,0,0,,Sinasabi mo bang may mawawala sa akin?
Dialogue: 0,0:47:00.95,0:47:03.86,Default,tira,0,0,0,,Nung nakilala kita, kahit panandalian lang,
Dialogue: 0,0:47:04.09,0:47:05.89,Default,tira,0,0,0,,naunawaan na ang posisyong ito ay para sa iyo.
Dialogue: 0,0:47:05.89,0:47:07.43,Default,shooting,0,0,0,,Lubos akong nagpapasalamat sa iyo, reyna.
Dialogue: 0,0:47:11.13,0:47:12.20,Default,shooting,0,0,0,,Ikaw
Dialogue: 0,0:47:13.30,0:47:14.77,Default,tyra,0,0,0,,magiging eunuch ka.
Dialogue: 0,0:47:14.97,0:47:16.07,Default,shooting,0,0,0,,Ano?
Dialogue: 0,0:47:17.50,0:47:19.54,Default,shooting,0,0,0,,Maghintay. Sandali lang.
Dialogue: 0,0:47:19.54,0:47:21.81,Default,shooting,0,0,0,,Bitawan mo ako. Hands off.
Dialogue: 0,0:47:23.64,0:47:24.71,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:47:25.08,0:47:26.74,Default,shooting,0,0,0,,Maawa ka.
Dialogue: 0,0:47:26.74,0:47:28.48,Default,dash,0,0,0,,Salamat sa iyong walang hanggang pagkabukas-palad.
Dialogue: 0,0:47:28.48,0:47:30.65,Default,shooting,0,0,0,,Ngunit bakit mo ito ginagawa?
Dialogue: 0,0:47:32.08,0:47:33.08,Default,shooting,0,0,0,,Una sa lahat,
Dialogue: 0,0:47:33.08,0:47:35.65,Default,tyra,0,0,0,,na-peke mo ang iyong pagkakakilanlan bilang isang maharlika.
Dialogue: 0,0:47:36.45,0:47:38.26,Default,dash,0,0,0,,No. Hindi mo kasalanan.
Dialogue: 0,0:47:38.29,0:47:40.86,Default,shooting,0,0,0,,Ang istrukturang panlipunan ang dapat sisihin dito.
Dialogue: 0,0:47:41.03,0:47:42.46,Default,shooting,0,0,0,,Tama.
Dialogue: 0,0:47:43.83,0:47:44.90,Default,dash,0,0,0,,Una. Una,
Dialogue: 0,0:47:45.20,0:47:46.96,Default,tyra,0,0,0,,nilason ang tubig sa royal kitchen
Dialogue: 0,0:47:46.96,0:47:49.07,Default,shooting gallery,0,0,0,,at ginulo ang royal feast.
Dialogue: 0,0:47:50.53,0:47:51.67,Default,shooting,0,0,0,,Pangalawa,
Dialogue: 0,0:47:52.07,0:47:53.74,Default,tyra,0,0,0,,nakakatakot na tao ang iyong inapo.
Dialogue: 0,0:47:55.07,0:47:56.07,Default,shooting,0,0,0,,Decendant?
Dialogue: 0,0:47:56.27,0:47:59.61,Default,dash,0,0,0,,Sigurado ka bang hindi mo ito pinaghalo sa aking ninuno?
Dialogue: 0,0:48:00.48,0:48:01.55,Default,shooting,0,0,0,,No.
Dialogue: 0,0:48:02.65,0:48:03.75,Default,shooting,0,0,0,,Tama.
Dialogue: 0,0:48:06.85,0:48:09.29,Default,tyra,0,0,0,,Nakakatakot na tao ang iyong inapo.
Dialogue: 0,0:48:09.69,0:48:11.02,Default,shooting,0,0,0,,Decendant?
Dialogue: 0,0:48:12.26,0:48:13.49,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:48:13.49,0:48:15.46,Default,tyra,0,0,0,,Magiging eunuch ako - walang magiging supling.
Dialogue: 0,0:48:15.46,0:48:17.93,Default,tyra,0,0,0,,Magiging eunuch ako - walang magiging supling. Kamahalan!
Dialogue: 0,0:48:18.90,0:48:21.23,Default,shooting,0,0,0,,Hindi ako magkakaroon ng mga inapo.
Dialogue: 0,0:48:21.33,0:48:23.33,Default,tyra,0,0,0,,Mayroon ka bang mga inapo? Hindi?
Dialogue: 0,0:48:23.43,0:48:26.04,Default,shooting,0,0,0,,Hindi ako magkakaroon ng mga inapo!
Dialogue: 0,0:48:26.04,0:48:29.37,Default,shooting gallery,0,0,0,,Paano kaya. Reyna!
Dialogue: 0,0:48:34.91,0:48:38.52,Default,shooting range,0,0,0,,Iyong Kamahalan, dumating na ang Ministro ng Digmaan.
Dialogue: 0,0:48:48.73,0:48:49.96,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:48:50.63,0:48:52.06,Default,tyra,0,0,0,,Andon clan Kim.
Dialogue: 0,0:48:52.36,0:48:54.27,Default,shooting,0,0,0,,Sigurado akong kasabwat silang lahat.
Dialogue: 0,0:48:54.97,0:48:57.10,Default,tyra,0,0,0,,Pero ang tatay ko ay mula rin sa Andon family ni Kim.
Dialogue: 0,0:48:57.27,0:49:00.47,Default,shooting,0,0,0,,Ano? Tinawag ko lang siyang "tatay ko."
Dialogue: 0,0:49:03.71,0:49:05.81,Default,shooting,0,0,0,,Delikado ang paglilipat ng emosyon.
Dialogue: 0,0:49:08.11,0:49:11.12,Default,shooting,0,0,0,,Nalaman ko ang nangyari sa iyo pagkatapos ng ating pagkikita.
Dialogue: 0,0:49:12.72,0:49:14.12,Default,shooting,0,0,0,,Hindi ko alam kung ano ang nangyari.
Dialogue: 0,0:49:14.65,0:49:16.15,Default,shooting,0,0,0,,Hindi mo alam,
Dialogue: 0,0:49:16.79,0:49:18.09,Default,shooting,0,0,0,,na sinubukan nila akong patayin?
Dialogue: 0,0:49:18.09,0:49:21.19,Default,tyra,0,0,0,,Wala ako sa panig ng aking ama, at hindi ako kabilang sa pamilya Kim.
Dialogue: 0,0:49:22.09,0:49:24.63,Default,shooting,0,0,0,,Gayunpaman, hindi ka malaya sa iyong ama at pamilya.
Dialogue: 0,0:49:26.63,0:49:28.33,Default,shooting,0,0,0,,Sa huli ay mauunawaan mo.
Dialogue: 0,0:49:40.68,0:49:42.55,Default,shooting gallery,0,0,0,,Kaaway o kaalyado?
Dialogue: 0,0:49:53.99,0:49:55.69,Default,shooting,0,0,0,,How dare he do this to Soyeon?
Dialogue: 0,0:50:01.30,0:50:04.14,Default,shooting,0,0,0,,At saka, paano niya magagawa ito sa reyna?
Dialogue: 0,0:50:07.41,0:50:09.01,Default,shooting,0,0,0,,Kim Jwageun, bastard.
Dialogue: 0,0:50:09.91,0:50:11.31,Default,shooting,0,0,0,,Kailangan kong...
Dialogue: 0,0:50:20.75,0:50:23.22,Default,shooting,0,0,0,,Bukod dito, itong Samjeong Lijeongjeon.
Dialogue: 0,0:50:23.22,0:50:26.99,Default,shooting,0,0,0,,Ginagamit nila ang opisyal na katiwalian bilang dahilan,
Dialogue: 0,0:50:26.99,0:50:29.69,Default,shooting,0,0,0,,para subukang sirain ang aming pamilya.
Dialogue: 0,0:50:29.69,0:50:31.03,Default,shooting,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:50:31.66,0:50:34.23,Default,shooting,0,0,0,,Kung nakikita nila ito bilang paglalaan ng ibang tao,
Dialogue: 0,0:50:34.23,0:50:36.07,Default,shooting,0,0,0,,kung gayon walang inosente.
Dialogue: 0,0:50:37.07,0:50:39.44,Default,shooting,0,0,0,,Upang protektahan ang iyong sarili,
Dialogue: 0,0:50:39.70,0:50:41.94,Default,shooting,0,0,0,,susubukan nilang protektahan ang mga opisyal.
Dialogue: 0,0:50:42.17,0:50:45.81,Default,shooting,0,0,0,,Ang natitira lang sa Samjeong Lijeongjeong ay ang panlabas na shell nito.
Dialogue: 0,0:50:49.15,0:50:51.15,Default,shooting gallery,0,0,0,,Kahit na sumali ka sa kanila saglit,
Dialogue: 0,0:50:51.15,0:50:53.98,Default,shooting,0,0,0,,tumingin ang iyong mga mata sa Inang Reyna.
Dialogue: 0,0:50:54.45,0:50:56.85,Default,shooting,0,0,0,,Nakakangiti siya sa mukha mo,
Dialogue: 0,0:50:56.85,0:50:58.96,Default,shooting,0,0,0,,pero lagi siyang handang magdikit ng kutsilyo sa likod.
Dialogue: 0,0:50:59.89,0:51:01.36,Default,shooting,0,0,0,,Tatandaan ko ito.
Dialogue: 0,0:51:02.26,0:51:03.49,Default,shooting,0,0,0,,Court lady Chon.
Dialogue: 0,0:51:04.23,0:51:06.10,Default,shooting,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:51:06.83,0:51:09.33, Default,shooting gallery,0,0,0,,Alisin ang mesa at tawagan ang healer.
Dialogue: 0,0:51:09.57,0:51:11.20,Default,shooting,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:51:15.04,0:51:16.51,Default,shooting,0,0,0,,Kumain ka na ba?
Dialogue: 0,0:51:17.44,0:51:19.24,Default,shooting,0,0,0,,Wala akong gana.
Dialogue: 0,0:51:20.14,0:51:22.08,Default,shooting,0,0,0,,Nabalitaan kong nagustuhan mo ang pagkain,
Dialogue: 0,0:51:22.08,0:51:23.85,Default,tyra,0,0,0,,luto ng reyna.
Dialogue: 0,0:51:25.12,0:51:26.88,Default,shooting,0,0,0,,Hindi siya ganoon kagaling.
Dialogue: 0,0:51:26.98,0:51:29.12,Default,tyra,0,0,0,,Nakakain siya.
Dialogue: 0,0:51:29.55,0:51:31.96,Default,shooting,0,0,0,,Ang Reyna ay nagdadalamhati ngayon.
Dialogue: 0,0:51:34.49,0:51:36.29,Default,tyra,0,0,0,,Sinabi na ang pangunahing babae
Dialogue: 0,0:51:36.29,0:51:39.30,Default,tyra,0,0,0,,pumagitna sa iyo at pinaniwalaan siya na ang pamilya ay tumalikod sa kanya.
Dialogue: 0,0:51:39.63,0:51:41.47,Default,shooting,0,0,0,,Sinisisi niya ang sarili niya sa lahat.
Dialogue: 0,0:51:43.83,0:51:45.04,Default,tyra,0,0,0,,Chief concubine?
Dialogue: 0,0:51:45.04,0:51:47.10,Default,shooting,0,0,0,,Sinabi sa akin ng ama ng reyna ngayon.
Dialogue: 0,0:51:47.47,0:51:49.81,Default,shooting,0,0,0,,Hindi ang reyna ang nanloko sa iyo,
Dialogue: 0,0:51:51.04,0:51:52.28,Default,tyra,0,0,0,,at ang pangunahing concubine.
Dialogue: 0,0:52:01.79,0:52:04.05,Default,,0,0,0,,Dumating na ang Hari.
Dialogue: 0,0:52:05.76,0:52:07.02,Default,,0,0,0,,Hilingan siyang pumasok.
Dialogue: 0,0:52:14.40,0:52:15.47,Default,,0,0,0,,Kamahalan.
Dialogue: 0,0:52:15.70,0:52:18.40,Default,,0,0,0,,Paumanhin sa late na pagbisita nang walang babala.
Dialogue: 0,0:52:19.30,0:52:20.50,Default,,0,0,0,, Maayos ang lahat.
Dialogue: 0,0:52:20.74,0:52:23.41,Default,,0,0,0,,Sa anumang oras ito ay isang malaking karangalan.
Dialogue: 0,0:52:23.94,0:52:25.94,Default,,0,0,0,,Naparito ako para may sabihin.
Dialogue: 0,0:52:28.78,0:52:30.38,Default,,0,0,0,,Ano?
Dialogue: 0,0:52:31.12,0:52:34.49,Default,,0,0,0,,Tungkol sa bangkay ng isang court maid kamakailan na natagpuan sa isang balon.
Dialogue: 0,0:52:35.95,0:52:38.76,Default,,0,0,0,,Ginawa ito sa utos ng Inang Reyna.
Dialogue: 0,0:52:40.09,0:52:41.43,Default,,0,0,0,,Inang Reyna?
Dialogue: 0,0:52:42.89,0:52:44.16,Default,,0,0,0,,Pero bakit siya...
Dialogue: 0,0:52:44.46,0:52:46.20,Default,,0,0,0,,Hindi mo rin maintindihan ang dahilan?
Dialogue: 0,0:52:48.90,0:52:51.30,Default,,0,0,0,,Kung gayon, sigurado iyon...
Dialogue: 0,0:52:51.54,0:52:52.84,Default,,0,0,0,,Hindi maaaring Ovol.
Dialogue: 0,0:52:52.97,0:52:56.14,Default,,0,0,0,,Ngunit imposible ito. Ito ay tiyak na Ovol.
Dialogue: 0,0:52:56.71,0:52:58.98,Default,,0,0,0,,Narinig kong nasa ganoong estado ito na mahirap tukuyin.
Dialogue: 0,0:52:58.98,0:53:01.01,Default,,0,0,0,,Bakit mo napagdesisyunan na Ovol iyon?
Dialogue: 0,0:53:01.55,0:53:03.71,Default,,0,0,0,,Nakadamit siya bilang court lady,
Dialogue: 0,0:53:03.71,0:53:07.48,Default,,0,0,0,,at ng mga court ladies, si Ovol lang ang nawala.
Dialogue: 0,0:53:10.75,0:53:13.36,Default,,0,0,0,,Alam niya na iisipin mong Ovol iyon.
Dialogue: 0,0:53:14.43,0:53:16.13,Default,,0,0,0,,Gusto ng Inang Reyna,
Dialogue: 0,0:53:17.09,0:53:19.26,Default,,0,0,0,,para umasa ka dito.
Dialogue: 0,0:53:20.20,0:53:22.37,Default,,0,0,0,,Ngunit bakit ginamit ang balon?
Dialogue: 0,0:53:24.30,0:53:26.74,Default,,0,0,0,,Sinabi ko sa kanya ang pinagdaanan ko sa balon.
Dialogue: 0,0:53:27.97,0:53:31.51,Default,,0,0,0,,Na nakilala kita dito.
Dialogue: 0,0:53:31.71,0:53:33.31,Default,,0,0,0,,At nasasaktan ako sa lugar na ito.
Dialogue: 0,0:53:34.91,0:53:36.68,Default,,0,0,0,,Pinaalala ka niya sa akin,
Dialogue: 0,0:53:36.68,0:53:38.98,Default,,0,0,0,,kaya sigurado akong nawalan ako ng taong mahal ko.
Dialogue: 0,0:53:41.42,0:53:43.95,Default,,0,0,0,,Ngayon naiintindihan ko na na hindi mo basta-basta maipapakita ang iyong sakit
Dialogue: 0,0:53:45.16,0:53:46.42,Default,,0,0,0,,sa sinuman sa palasyo.
Dialogue: 0,0:54:04.84,0:54:08.98,Default,,0,0,0,,Ilubog ang reyna sa bangungot kung saan ako nakatira.
Dialogue: 0,0:54:15.62,0:54:18.16,Default,,0,0,0,,Wag ka nang magtiwala sa Inang Reyna.
Dialogue: 0,0:54:18.82,0:54:20.16,Default,,0,0,0,,Dapat nating itago ang alam nating lahat,
Dialogue: 0,0:54:21.13,0:54:23.73,Default,,0,0,0,,kaya huwag ipaalam sa kanya na alam mo kung ano ang kanyang ginawa.
Dialogue: 0,0:54:25.63,0:54:29.17,Default,,0,0,0,,Siya ay nagtaksil sa akin at ako ay labis na nabigo.
Dialogue: 0,0:54:30.80,0:54:32.07,Default,,0,0,0,,Well para sa akin
Dialogue: 0,0:54:33.30,0:54:35.47,Default,,0,0,0,,pinagmulan ng takot.
Dialogue: 0,0:54:37.04,0:54:38.64,Default,,0,0,0,,Hindi ako makapaniwala na ginamit niya iyon.
Dialogue: 0,0:54:52.29,0:54:55.49,Default,,0,0,0,,Parang poker at hato.
Dialogue: 0,0:54:55.73,0:54:57.93,Default,,0,0,0,,Chat at mga laro -
Dialogue: 0,0:54:57.93,0:55:00.86,Default,,0,0,0,,ang pinakamahusay na paraan upang magpalipas ng oras at buhay.
Dialogue: 0,0:55:01.73,0:55:03.27,Default,,0,0,0,,Natutuwa akong marinig iyon.
Dialogue: 0,0:55:03.63,0:55:06.37,Default,,0,0,0,,Natatakot kami na baka masamain ka ni Damhyang.
Dialogue: 0,0:55:08.57,0:55:09.81,Default,,0,0,0,,Ay, sorry.
Dialogue: 0,0:55:11.01,0:55:13.48,Default,,0,0,0,,Huwag mag-alala. Nasa magandang lugar siya ngayon.
Dialogue: 0,0:55:13.71,0:55:16.71,Default,,0,0,0,,Talaga? Kailangan niyang pumunta sa isang magandang lugar, tama ba?
Dialogue: 0,0:55:17.88,0:55:18.92,Default,,0,0,0,,Damhyang.
Dialogue: 0,0:55:21.02,0:55:25.56,Default,,0,0,0,,Hindi, hindi iyon ang tinutukoy ko. Nasa magandang lugar talaga siya.
Dialogue: 0,0:55:25.56,0:55:26.62,Default,,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:55:28.56,0:55:29.63,Default,,0,0,0,,Damhyan.
Dialogue: 0,0:55:32.00,0:55:34.06,Default,,0,0,0,,Lipat talaga siya sa magandang lugar.
Dialogue: 0,0:55:35.40,0:55:37.74,Default,,0,0,0,,Bakit ka umiiyak?
Dialogue: 0,0:55:39.27,0:55:40.90,Default,,0,0,0,,Paumanhin.
Dialogue: 0,0:55:41.67,0:55:43.14,Default,,0,0,0,,Kung iisipin mo,
Dialogue: 0,0:55:44.14,0:55:47.21,Default,,0,0,0,,Hindi man lang ako nagpaalam sa kanya.
Dialogue: 0,0:55:48.41,0:55:50.85,Default,,0,0,0,,Damhyang.
Dialogue: 0,0:55:55.12,0:55:57.25,Default,,0,0,0,,-Damhyan.\N-Queen.
Dialogue: 0,0:55:58.72,0:55:59.99,Default,,0,0,0,,Damhyan.
Dialogue: 0,0:56:00.49,0:56:01.56,Default,,0,0,0,,Pito.
Dialogue: 0,0:56:03.73,0:56:04.73,Default,,0,0,0,, Walo.
Dialogue: 0,0:56:05.50,0:56:06.66,Default,,0,0,0,,Ito...
Dialogue: 0,0:56:07.90,0:56:09.80,Default,,0,0,0,,siyam.
Dialogue: 0,0:56:14.10,0:56:16.07,Default,,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:56:16.31,0:56:18.01,Default,,0,0,0,,Paano kaya?
Dialogue: 0,0:56:19.71,0:56:23.11,Default,,0,0,0,,-Damhyan.\N-Damhyan.
Dialogue: 0,0:56:24.65,0:56:25.65,Default,,0,0,0,,All-in.
Dialogue: 0,0:56:29.85,0:56:32.79,Default,,0,0,0,,Paano nakuha ng Inang Reyna ang kanyang mga kamay sa ledger?
Dialogue: 0,0:56:32.89,0:56:35.59,Default,,0,0,0,,Ang librong hinahanap namin nang husto, ngunit hindi nakuha.
Dialogue: 0,0:56:36.92,0:56:40.69,Default,,0,0,0,,Baka kaya ko siyang makuha sa tabi mo?
Dialogue: 0,0:56:42.26,0:56:43.53,Default,,0,0,0,,Joke.
Dialogue: 0,0:56:44.23,0:56:47.40,Default,,0,0,0,,Narinig na naabutan niya kami, malayang lumabas ng palasyo,
Dialogue: 0,0:56:47.40,0:56:48.67,Default,,0,0,0,,Nadidismaya ako sa sarili ko.
Dialogue: 0,0:56:49.80,0:56:52.17,Default,,0,0,0,,Ang Inang Reyna ay nasa Seongwonjong Hall halos\N sa lahat ng oras.
Dialogue: 0,0:56:52.17,0:56:54.47,Default,,0,0,0,,Hindi ko maintindihan kung paano niya nakuha ang ledger.
Dialogue: 0,0:56:54.81,0:56:56.54,Default,,0,0,0,,Iyon, na ginawa niya sa katawan,
Dialogue: 0,0:56:57.01,0:56:59.75,Default,,0,0,0,,ibig sabihin may mga kasabwat siya.
Dialogue: 0,0:56:59.75,0:57:02.18,Default,,0,0,0,,Siguro dapat natin silang gawing kasabwat?
Dialogue: 0,0:57:02.85,0:57:05.49,Default,,0,0,0,,Hindi pa handa ang portrait ng nasa tokkebi mask?
Dialogue: 0,0:57:06.02,0:57:08.86,Default,,0,0,0,,Naging abala ako sa mga araw na ito,
Dialogue: 0,0:57:08.86,0:57:11.22,Default,,0,0,0,,pagpalaya sa ina ni Damhyang mula sa pagkaalipin
Dialogue: 0,0:57:11.22,0:57:13.16,Default,,0,0,0,,at hinahanap ang kanyang ama.
Dialogue: 0,0:57:13.33,0:57:14.93,Default,,0,0,0,,Pero hindi mo siya nakita?
Dialogue: 0,0:57:14.93,0:57:17.30,Default,,0,0,0,,Paano makahanap ng nagtatago sa mga bundok?
Dialogue: 0,0:57:17.60,0:57:19.30,Default,,0,0,0,,Naging bandido siya.
Dialogue: 0,0:57:23.00,0:57:28.58,Default,,0,0,0,,Nag-iisip tungkol sa bakasyon pagkatapos ng aking paglalakbay bilang isang royal investigator,
Dialogue: 0,0:57:29.01,0:57:33.31,Default,,0,0,0,,Halos hindi ako makatayo sa mga araw na ito.
Dialogue: 0,0:57:34.51,0:57:36.92,Default,,0,0,0,,Actually, I mean...
Dialogue: 0,0:57:40.49,0:57:44.09,Default,,0,0,0,,Pwede mo ba akong gawing secret inspector sa halip na royal investigator?
Dialogue: 0,0:57:44.09,0:57:45.66,Default,,0,0,0,,Mas cool ito.
Dialogue: 0,0:57:45.66,0:57:48.56,Default,,0,0,0,,In disguise, bigla akong maglalabas ng token, ganyan!
Dialogue: 0,0:57:50.23,0:57:53.10,Default,,0,0,0,,Oo, isa kang ipinanganak na lihim na inspektor. Gawin ang gusto mo.
Dialogue: 0,0:57:54.23,0:57:55.30,Default,,0,0,0,,Isang beses pa.
Dialogue: 0,0:58:21.43,0:58:25.70,Default,,0,0,0,,Hindi ko akalain na si Youngjin ay ganoong klaseng tao.
Dialogue: 0,0:58:26.10,0:58:28.20,Default,,0,0,0,,Si Kim Jwageun lang ang nararapat mamatay.
Dialogue: 0,0:58:28.20,0:58:29.30,Default,,0,0,0,,Isang Youngjin -
Dialogue: 0,0:58:31.87,0:58:33.81,Default,,0,0,0,,buong pamilya ko.
Dialogue: 0,0:58:45.99,0:58:48.92,Default,,0,0,0,,Hoy, dito ka matutulog pagkatapos nito,
Dialogue: 0,0:58:48.92,0:58:50.16,Default,,0,0,0,,paano mo halos patayin ang iyong biyenan at asawa?
Dialogue: 0,0:58:52.36,0:58:53.49,Default,,0,0,0,,Mukhang hindi.
Dialogue: 0,0:59:10.24,0:59:12.35,Default,,0,0,0,,Puso, huminto.
Dialogue: 0,0:59:12.98,0:59:14.82,Default,,0,0,0,,Masakit ang pride ko.
Dialogue: 0,1:00:18.55,1:00:20.88,Default,,0,0,0,,Mukhang matagal siyang nasa ilalim ng tubig.
Dialogue: 0,1:00:22.25,1:00:25.25,Default,,0,0,0,,Naiintindihan ko kung gaano ito kasakit.
Dialogue: 0,1:00:27.95,1:00:30.69,Default,,0,0,0,,Ang katotohanan na ang kanyang katawan ay natagpuan sa isang balon ay alinman sa isang kakila-kilabot na pagkakataon,
Dialogue: 0,1:00:31.06,1:00:33.29,Default,,0,0,0,,o may gustong itulak kami.
Dialogue: 0,1:00:50.28,1:00:51.85,Default,,0,0,0,,Ang lalim ng iniisip ko.
Dialogue: 0,1:00:52.21,1:00:53.68,Default,,0,0,0,,Siguradong nabigla ka.
Dialogue: 0,1:00:53.98,1:00:55.88,Default,,0,0,0,,Masyadong maraming espasyo para sa akin dito.
Dialogue: 0,1:00:57.02,1:01:00.65,Default,,0,0,0,,Dito pakiramdam mo nag-iisa at nawawala.
Dialogue: 0,1:01:00.99,1:01:03.92,Default,,0,0,0,,Nahanap ko yung maid na nagbebenta ng noriga na binigay mo kay Ovol.
Dialogue: 0,1:01:04.49,1:01:06.89,Default,,0,0,0,,Nahanap daw niya siya sa palasyo.
Dialogue: 0,1:01:08.70,1:01:09.96,Default,,0,0,0,,Ganun ba?
Dialogue: 0,1:01:09.96,1:01:11.60,Default,,0,0,0,,Ito rin ang kasambahay na nagtapon ng katawan sa balon
Dialogue: 0,1:01:11.60,1:01:13.93,Default,,0,0,0,,sa utos ng Inang Reyna.
Dialogue: 0,1:01:14.67,1:01:16.10,Default,,0,0,0,,Buhay si Ovol.
Dialogue: 0,1:01:16.60,1:01:18.47,Default,,0,0,0,,Siya ay inatake sa palasyo.
Dialogue: 0,1:01:19.34,1:01:21.68,Default,,0,0,0,,Wala man lang siyang oras na humakbang palabas ng palasyo.
Dialogue: 0,1:01:23.91,1:01:25.41,Default,,0,0,0,,Hindi mo ba inaasahan na ang katawan,
Dialogue: 0,1:01:25.95,1:01:28.08,Default,,0,0,0,,nahanap sa balon, hindi kay Ovol?
Dialogue: 0,1:01:29.35,1:01:31.42,Default,,0,0,0,,Hindi ba dapat masaya ka,
Dialogue: 0,1:01:31.42,1:01:33.09,Default,,0,0,0,,na hindi ito Ovol?
Dialogue: 0,1:01:33.95,1:01:36.42,Default,,0,0,0,,Bakit ka naniniwala na ito ay Ovol?
Dialogue: 0,1:01:36.66,1:01:37.79,Default,,0,0,0,,Para sa kapakanan ng Diyos...
Dialogue: 0,1:01:40.69,1:01:42.73,Default,,0,0,0,,For God's sake, ano ang tinatago mo?
Dialogue: 0,1:01:47.23,1:01:48.27,Default,,0,0,0,,Huling beses
Dialogue: 0,1:01:50.67,1:01:53.31,Default,,0,0,0,,kung ano ang naipasa mo
Dialogue: 0,1:01:55.08,1:01:56.41,Default,,0,0,0,,Inang Reyna?
Dialogue: 0,1:02:07.19,1:02:08.56,Default,,0,0,0,,Nakita mo ba lahat?
Dialogue: 0,1:02:09.29,1:02:10.36,Default,,0,0,0,,I
Dialogue: 0,1:02:11.32,1:02:15.80,Default,,0,0,0,,Wala akong nakikita kung wala ang pahintulot mo.
Dialogue: 0,1:02:20.57,1:02:22.50,Default,,0,0,0,,Lahat ay naliligaw paminsan-minsan.
Dialogue: 0,1:02:22.94,1:02:24.94,Default,,0,0,0,,May pagkakataon ka pa ring makabalik sa tamang landas.
Dialogue: 0,1:02:28.14,1:02:30.41,Default,,0,0,0,,Paano kung matagal na akong nawala sa landas?
Dialogue: 0,1:02:31.78,1:02:32.91,Default,,0,0,0,,Maaari Pa
Dialogue: 0,1:02:34.21,1:02:36.32,Default,,0,0,0,,bumalik sa tamang landas?
Dialogue: 0,1:02:39.75,1:02:41.32,Default,,0,0,0,,Wala nang babalikan.
Dialogue: 0,1:02:41.69,1:02:42.92,Default,,0,0,0,,Your Highness.
Dialogue: 0,1:02:42.92,1:02:45.66,Default,,0,0,0,,Ang katawan na iyon ay dapat na Ovol.
Dialogue: 0,1:02:55.80,1:02:58.14,Default,,0,0,0,,Bakit ka nagluluto ng samhyang ramen
Dialogue: 0,1:02:58.84,1:03:00.34,Default,,0,0,0,,sa kalagitnaan ng gabi?
Dialogue: 0,1:03:04.01,1:03:06.58,Default,,0,0,0,,Bakit mas gusto mo ito sa gabi?
Dialogue: 0,1:03:06.58,1:03:09.12,Default,,0,0,0,,Alam mo sa umaga mamumugto ang mukha mo.
Dialogue: 0,1:03:09.68,1:03:12.92,Default,,0,0,0,,Ngunit napakahirap labanan ang tukso.
Dialogue: 0,1:03:15.49,1:03:18.09,Default,,0,0,0,,Subukan mo nang husto, sayang naman at walang kabuluhan.
Dialogue: 0,1:03:18.09,1:03:20.16,Default,,0,0,0,,Ang Dowager Queen sa Gabi
Dialogue: 0,1:03:20.29,1:03:21.90,Default,,0,0,0,,hindi kumakain.
Dialogue: 0,1:03:21.90,1:03:23.60,Default,,0,0,0,,Kaya hayaan mo akong...
Dialogue: 0,1:03:25.87,1:03:27.03,Default,,0,0,0,,Hindi.
Dialogue: 0,1:03:55.86,1:03:58.23,Default,,0,0,0,,Dapat mo akong bigyan ng babala tungkol sa iyong pagdating.
Dialogue: 0,1:03:58.23,1:04:00.67,Default,,0,0,0,,Bakit hindi ka man lang kumatok?
Dialogue: 0,1:04:07.94,1:04:10.71,Default,,0,0,0,,Gusto mo bang kumain ng ramen bago tayo umalis?
Dialogue: 0,1:04:14.41,1:04:17.75,Default,,0,0,0,,Ano ang ramen? At saan mo ako gustong pumunta?
Dialogue: 0,1:04:18.82,1:04:21.79,Default,,0,0,0,,Walang pressure. Research lang po ito.
Dialogue: 0,1:04:21.96,1:04:23.19,Default,,0,0,0,,O pagsubok.
Dialogue: 0,1:04:24.12,1:04:26.09,Default,,0,0,0,,Hindi, hindi ko dapat gawin iyon.
Dialogue: 0,1:04:28.23,1:04:29.80,Default,,0,0,0,,Pero kung kaunti lang...
Dialogue: 0,1:04:29.80,1:04:30.80,Default,,0,0,0,,Hindi, hindi.
Dialogue: 0,1:04:31.00,1:04:33.13,Default,,0,0,0,,Nakakaadik ang lasa ng Ramen.
Dialogue: 0,1:04:33.13,1:04:35.30,Default,,0,0,0,,Kapag nagsimula ka, imposibleng huminto.
Dialogue: 0,1:04:36.84,1:04:38.10,Default,,0,0,0,,Anong ginagawa mo?
Dialogue: 0,1:04:42.71,1:04:44.18,Default,,0,0,0,,Internal na salungatan.
Dialogue: 0,1:04:51.55,1:04:53.15,Default,,0,0,0,,Ano ang gagawin mo kung ikaw ako?
Dialogue: 0,1:04:53.52,1:04:56.26,Default,,0,0,0,,Kakain ka ba ng ramen o hindi?
Dialogue: 0,1:04:56.69,1:04:59.23,Default,,0,0,0,,Palagay ko ipapaliwanag ko muna kung ano ang ramen.
Dialogue: 0,1:05:01.76,1:05:03.73,Default,,0,0,0,,-Para sa panimula...\N-Ano?
Dialogue: 0,1:05:04.46,1:05:05.67,Default,,0,0,0,,Susubukan ko.
Dialogue: 0,1:05:06.20,1:05:07.23,Default,,0,0,0,,Talaga?
Dialogue: 0,1:05:07.73,1:05:09.87,Default,,0,0,0,,Maiintindihan mo lang kung ano ito kapag sinubukan mo ito.
Dialogue: 0,1:05:09.87,1:05:11.81,Default,,0,0,0,,Parang hangin kapag nalasing,
Dialogue: 0,1:05:11.81,1:05:13.34,Default,,0,0,0,,o kapag galit ka,
Dialogue: 0,1:05:13.34,1:05:15.04,Default,,0,0,0,,o mapagtanto na ito ay
Dialogue: 0,1:05:16.58,1:05:18.04,Default,,0,0,0,,reality.
Dialogue: 0,1:05:19.55,1:05:22.12,Default,,0,0,0,,Iisa ba ang wika natin ngayon?
Dialogue: 0,1:05:22.98,1:05:24.02,Default,,0,0,0,,Siyempre.
Dialogue: 0,1:05:24.55,1:05:26.49,Default,,0,0,0,,Ramen ang pinag-uusapan.
Dialogue: 0,1:05:28.35,1:05:31.29,Default,,0,0,0,,Lumapit. Masarap ang ramen kapag mainit.
Dialogue: 0,1:05:31.29,1:05:32.46,Default,,0,0,0,,Paunang pagtuturo para sa mga bata
Dialogue: 0,1:05:33.63,1:05:34.73,Default,,0,0,0,,Paano mo siya tratuhin?
Dialogue: 0,1:05:34.93,1:05:36.53,Default,,0,0,0,,Naku, mga mommies!
Dialogue: 0,1:05:36.53,1:05:38.40,Default,,0,0,0,,Ano ang gagawin? Ito ay isang hindi mabibiling libro.
Dialogue: 0,1:05:54.55,1:05:57.02,Default,,0,0,0,,Bakit mo nasabi na ang librong ito ay hindi mabibili ng salapi?
Dialogue: 0,1:05:59.22,1:06:02.96,Default,,0,0,0,,Paano mahalaga sa iyo ang Pangunahing Pagtuturo para sa mga Bata?
Dialogue: 0,1:06:05.13,1:06:06.19,Default,,0,0,0,,Ito...
Dialogue: 0,1:06:08.03,1:06:09.26,Default,,0,0,0,,Ikaw ba yan?
Dialogue: 0,1:06:12.37,1:06:15.10,Default,,0,0,0,,Ikaw ang nagligtas sa akin?
Dialogue: 0,1:06:15.27,1:06:17.77,Default,,0,0,0,,Iniligtas mo ako mula sa balon?
Dialogue: 0,1:06:31.08,1:06:32.09,Default,,0,0,0,,Oo.
Dialogue: 0,1:06:32.89,1:06:33.99,Default,,0,0,0,,Ako iyon.
Dialogue: 0,1:06:47.10,1:06:51.50,Default,,0,0,0,,Paano ako naging reyna
Dialogue: 0,1:07:11.79,1:07:14.96,Default,,0,0,0,,Ang Cheoljong ko ay desperadong maghihintay sa akin.
Dialogue: 0,1:07:15.30,1:07:17.23,Default,,0,0,0,,So isa itong bitag?
Dialogue: 0,1:07:17.23,1:07:20.30,Default,,0,0,0,,Hindi ako makapaniwala na hinamon ako ng reyna ng totoong laban.
Dialogue: 0,1:07:20.30,1:07:21.84,Default,,0,0,0,,{\i1}-Ngayon na ba ang turn ko?\N-Ilabas mo ang iyong espada.{\i}
Dialogue: 0,1:07:21.84,1:07:25.00,Default,,0,0,0,,Ang hindi naglilinis ng sarili at nag-iiwan ng mga bakas,
Dialogue: 0,1:07:25.00,1:07:26.94,Default,,0,0,0,,dapat sagutin ang lahat.
Dialogue: 0,1:07:26.94,1:07:28.01,Default,,0,0,0,,Kahit na napabagsak ko ang angkan ni Kim,
Dialogue: 0,1:07:28.01,1:07:29.91,Default,,0,0,0,,Lalong lumakas ang kapangyarihan ni Kim Byonin.
Dialogue: 0,1:07:29.91,1:07:31.78,Default,,0,0,0,,Parang walang progress.
Dialogue: 0,1:07:31.78,1:07:34.95,Default,,0,0,0,,Kung gagawin ito ni Cheoljong, magbabago rin ang mundo pagkatapos ng 200 taon.
Dialogue: 0,1:07:34.95,1:07:36.98,Default,,0,0,0,,Basta kakampi mo ako, mananalo ka.
Dialogue: 0,1:07:36.98,1:07:38.75,Default,,0,0,0,,Mayroon akong secret weapon.
Dialogue: 0,1:07:38.75,1:07:40.09,Default,,0,0,0,,Я знаю будущее.
Dialogue: 0,0:15:25.96,0:15:27.96,Default,,0,0,0,,

