Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 ل 92 38 ل 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,worked,,0,0,0,,{\pos(801,256)}عملت على المسلسل:\N Lily, Tiramisu, Zinger, Pineapple, Host, Marcus
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:04.02,الاسم,,0,0,0,,{\pos(112,666)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:03.92,0:01:06.29,Default,pineapple,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.29,0:01:09.09,Default,الأناناس,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:09.86,0:01:12.23,Default,الأناناس,0,0,0,,6 حلقة
Dialogue: 0,0:01:12.23,0:01:13.86,Default,الأناناس,0,0,0,,بالضبط.
Dialogue: 0,0:01:14.09,0:01:18.63,Default,pineapple,0,0,0,,في قسم التكتيكات "ملاحظات حول الأسلحة والمعدات"
Dialogue: 0,0:01:18.63,0:01:21.20,Default,pineapple,0,0,0,,يقول إذا كان عدد الحلفاء أقل من عدد الأعداء،
Dialogue: 0,0:01:21.20,0:01:23.27,Default,الأناناس,0,0,0,,نحن بحاجة إلى اللجوء إلى التراجع.
Dialogue: 0,0:01:23.27,0:01:27.77,Default,pineapple,0,0,0,,إذا كنت غير قادر على الدفاع، تراجع و...
Dialogue: 0,0:01:28.78,0:01:31.01,Default,الأناناس,0,0,0,,يا لها من امرأة غريبة.
Dialogue: 0,0:01:32.05,0:01:34.11,Default,الأناناس,0,0,0,,يا صاحب الجلالة، لن تصدق ذلك.
Dialogue: 0,0:01:34.11,0:01:36.62,Default,الأناناس,0,0,0,,يتصرف بشكل غير عادي للغاية.
Dialogue: 0,0:01:38.75,0:01:41.99,Default,pineapple,0,0,0,,إلى متى يمكنك الرقص على موسيقى أسلافك القديمة؟
Dialogue: 0,0:01:41.99,0:01:43.62,Default,الأناناس,0,0,0,,أنا
Dialogue: 0,0:01:44.56,0:01:47.26,Default,الأناناس,0,0,0,,خدم في القوات الخاصة.
Dialogue: 0,0:01:47.86,0:01:50.30,Default,pineapple,0,0,0,,-إنه يتحدث بغطرسة شديدة.\N-هجوم.
Dialogue: 0,0:01:50.30,0:01:51.97,Default,pineapple,0,0,0,,وربما تتخيل نفسك ملكاً.
Dialogue: 0,0:01:51.97,0:01:53.87,Default,الأناناس,0,0,0,,أنا الملك.
Dialogue: 0,0:01:56.24,0:01:57.91,Default,الأناناس,0,0,0,,شكرًا لك.
Dialogue: 0,0:01:57.91,0:02:00.87,Default,الأناناس,0,0,0,,هل أنت مجنون؟
Dialogue: 0,0:02:04.75,0:02:07.01,Default,الأناناس,0,0,0,,انس الأمر، لا أهتم.
Dialogue: 0,0:02:07.08,0:02:09.08,Default,الأناناس,0,0,0,,انزل.
Dialogue: 0,0:02:09.08,0:02:11.85,Default,الأناناس,0,0,0,,ويتصرف كالمجنون.
Dialogue: 0,0:02:19.96,0:02:22.90,Default,الأناناس,0,0,0,,وأحياناً كما لو كانت بوذا.
Dialogue: 0,0:02:22.90,0:02:28.84,Default,pineapple,0,0,0,,من فضلك، لا تلمس الأبرياء من أي شيء.
Dialogue: 0,0:02:28.84,0:02:30.97,Default,pineapple,0,0,0,,لكنها غاضبة وكأن الأرواح الشريرة استحوذت عليها.
Dialogue: 0,0:02:30.97,0:02:33.87,Default,أناناس,0,0,0,,أي شخص في مكاني سيكون غاضباً الآن،
Dialogue: 0,0:02:33.87,0:02:35.21,Default,الأناناس,0,0,0,,لو لم يكن بوذا.
Dialogue: 0,0:02:35.21,0:02:37.71,Default,الأناناس,0,0,0,,أحيانًا تكون هي التجسيد الحقيقي للإنسانية،
Dialogue: 0,0:02:37.74,0:02:40.75,Default,pineapple,0,0,0,,وأنا لا أفهم ما يدور في ذهن هذه المرأة الغامضة.
Dialogue: 0,0:02:41.65,0:02:44.95,Default,الأناناس,0,0,0,,لقد ضاعت اللحظة. ليس هناك فائدة من قول أي شيء.
Dialogue: 0,0:02:45.19,0:02:47.39,Default,الأناناس,0,0,0,,أليس هناك أي فائدة حقاً؟
Dialogue: 0,0:02:49.36,0:02:51.52,Default,الأناناس,0,0,0,,هل من الصعب جدًا شرحي؟
Dialogue: 0,0:02:53.69,0:02:56.83,Default,الأناناس,0,0,0,,-ماذا قلت؟\N-لم تستمع إلي.
Dialogue: 0,0:02:56.83,0:02:58.80,Default,الأناناس,0,0,0,,ما الذي كنت تفكر فيه،
Dialogue: 0,0:02:58.80,0:03:01.50,Default,الأناناس,0,0,0,,هل نسيت كتابك المفضل؟
Dialogue: 0,0:03:02.70,0:03:05.41,Default,الأناناس,0,0,0,,يجب أن يكون عن السيدة هواجين.
Dialogue: 0,0:03:06.31,0:03:08.01,Default,الأناناس,0,0,0,,إطلاقاً.
Dialogue: 0,0:03:08.68,0:03:09.91,Default,الأناناس,0,0,0,,لا داعي للتظاهر.
Dialogue: 0,0:03:09.91,0:03:14.82,Default,pineapple,0,0,0,,واضح من عينيك أنك كنت تفكر في المرأة.
Dialogue: 0,0:03:14.82,0:03:16.72,Default,الأناناس,0,0,0,,كنت أفكر في الملكة.
Dialogue: 0,0:03:16.72,0:03:17.72,Default,الأناناس,0,0,0,,ماذا؟
Dialogue: 0,0:03:17.72,0:03:20.39,Default,pineapple,0,0,0,,لذا توقف عن إحراجي\Nme بكلماتك.
Dialogue: 0,0:03:20.82,0:03:22.96,Default,الأناناس,0,0,0,,الملكة امرأة أيضاً،
Dialogue: 0,0:03:22.96,0:03:25.73,Default,الأناناس,0,0,0,,لكنني لم أفكر بها بهذه الطريقة أبداً.
Dialogue: 0,0:03:26.49,0:03:28.33,Default,الأناناس,0,0,0,,لن تخمن أبدًا ما الذي يدور في ذهنها،
Dialogue: 0,0:03:28.33,0:03:31.13,Default,الأناناس,0,0,0,,لا عجب أنك مهتم.
Dialogue: 0,0:03:33.10,0:03:35.60,Default,الأناناس,0,0,0,,الملكة هي الشخص الأكثر غرابة وغير عادي
Dialogue: 0,0:03:35.60,0:03:38.87,Default,الأناناس,0,0,0,,من بين كل من أعرفهم.
Dialogue: 0,0:03:39.54,0:03:43.44,Default,الأناناس,0,0,0,,وكأنها ليست من عالمنا.
Dialogue: 0,0:03:45.18,0:03:49.35,Default,الأناناس,0,0,0,,وأفضل وصف لملكتنا...
Dialogue: 0,0:03:50.28,0:03:52.32,Default,الأناناس,0,0,0,,دعني أفكر.
Dialogue: 0,0:03:53.32,0:03:57.12,Default,pineapple,0,0,0,,كلمة تقول مباشرة\Nأن الشخص ليس من هذا العالم.
Dialogue: 0,0:03:57.12,0:03:58.86,Default,الأناناس,0,0,0,,كائن فضائي.
Dialogue: 0,0:03:59.06,0:04:01.33,Default,أناناس,0,0,0,,-كائن فضائي؟\N-نعم.
Dialogue: 0,0:04:04.63,0:04:06.73,Default,الأناناس,0,0,0,,مثالي لها.
Dialogue: 0,0:04:08.14,0:04:09.84,Default,الأناناس,0,0,0,,كائن فضائي.
Dialogue: 0,0:04:14.41,0:04:16.81,Default,الأناناس,0,0,0,,هل توقف المطر أخيراً؟
Dialogue: 0,0:04:16.81,0:04:19.15,Default,الأناناس,0,0,0,,كانت السماء تمطر طوال الليل.
Dialogue: 0,0:04:19.15,0:04:21.55,Default,الأناناس,0,0,0,,آمل ألا يتأذى أحد.
Dialogue: 0,0:04:21.55,0:04:23.45,Default,الأناناس,0,0,0,,وأنا أيضًا.
Dialogue: 0,0:04:23.82,0:04:25.85,Default,الأناناس,0,0,0,,أنا غير مرتاح.
Dialogue: 0,0:04:28.36,0:04:31.39,Default,pineapple,0,0,0,,إلى متى ستتحدث بهذه الغرابة؟
Dialogue: 0,0:04:31.39,0:04:34.33,Default,الأناناس,0,0,0,,اليوم فقط. هذا هو اليوم الأخير.
Dialogue: 0,0:04:34.33,0:04:39.53,Default,الأناناس,0,0,0,,وغداً سيكون كل شيء في مكانه! أوه نعم!
Dialogue: 0,0:04:44.91,0:04:46.54,Default,الأناناس,0,0,0,,لا يمكن أن يكون!
Dialogue: 0,0:04:55.28,0:04:56.88,Default,الأناناس,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:05:04.93,0:05:08.03,Default,الأناناس,0,0,0,,افتح البوابة! أمر الملك!
Dialogue: 0,0:05:08.06,0:05:10.26,Default,أناناس,0,0,0,,-افتح البوابة!\N-افتح البوابة!
Dialogue: 0,0:05:32.29,0:05:34.89,Default,pineapple,0,0,0,,ما كان يجب أن أصل إلى هنا\NJang Bong-hwan
Dialogue: 0,0:07:10.68,0:07:11.75,Default,الأناناس,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:07:11.75,0:07:13.42,Default,الأناناس,0,0,0,,يا للهول!
Dialogue: 0,0:07:13.55,0:07:14.62,Default,الأناناس,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:07:14.62,0:07:16.32,Default,pineapple,0,0,0,,لقد حاول مؤخراً قتلي!
Dialogue: 0,0:07:16.32,0:07:18.13,Default,الأناناس,0,0,0,,يجب أن أسألك نفس الشيء!
Dialogue: 0,0:07:18.13,0:07:20.26,Default,pineapple,0,0,0,,لا أصدق\Nأنك حاولت الانتحار مرة أخرى!
Dialogue: 0,0:07:20.26,0:07:22.00,Default,الأناناس,0,0,0,,هل أنت مجنون؟
Dialogue: 0,0:07:22.00,0:07:24.73,Default,pineapple,0,0,0,,ماذا يهمك إذا كنت على قيد الحياة أم لا؟
Dialogue: 0,0:07:24.73,0:07:27.13,Default,الأناناس,0,0,0,,ألم تريدني أن أموت؟
Dialogue: 0,0:07:30.14,0:07:33.24,Default,الأناناس,0,0,0,,لا تزعجني! اخرج!
Dialogue: 0,0:07:33.91,0:07:37.34,Default,pineapple,0,0,0,,لم يفت الأوان بعد لحل كل حالات سوء الفهم.
Dialogue: 0,0:07:38.01,0:07:40.38,Default,الأناناس,0,0,0,,دعونا نعيش بالطريقة التي أردتها.
Dialogue: 0,0:07:41.48,0:07:43.12,Default,الأناناس,0,0,0,,التباعد الاجتماعي.
Dialogue: 0,0:07:47.85,0:07:50.89,Default,الأناناس,0,0,0,,صحيح! الإبعاد الاجتماعي.
Dialogue: 0,0:07:51.66,0:07:53.93,Default,الأناناس,0,0,0,,-مستحيل!\N-اخرج!
Dialogue: 0,0:07:53.93,0:07:55.83,Default,الأناناس,0,0,0,,ماذا تفعل! دعني أذهب!
Dialogue: 0,0:07:55.83,0:07:57.50,Default,الأناناس,0,0,0,,أيها اللقيط!
Dialogue: 0,0:07:58.50,0:08:01.77,Default,pineapple,0,0,0,,قالت أنك تريد الحفاظ على مسافة بينكما، وهل تحاول الموت؟
Dialogue: 0,0:08:02.87,0:08:04.54,Default,الأناناس,0,0,0,,ألم تكن تحاول قتلي؟
Dialogue: 0,0:08:04.54,0:08:05.91,Default,الأناناس,0,0,0,,إذن لماذا تلمسني بحق الجحيم؟
Dialogue: 0,0:08:05.91,0:08:07.74,Default,pineapple,0,0,0,,أفهم سبب غضبك.
Dialogue: 0,0:08:07.74,0:08:11.64,Default,pineapple,0,0,0,,لقد ارتكبت خطيئة عظيمة والآن ديناً غير مدفوع لك.
Dialogue: 0,0:08:11.75,0:08:15.85,Default,pineapple,0,0,0,,أفهم أن هذا يبدو كعذر،\Nلكننا أسأنا فهم بعضنا البعض.
Dialogue: 0,0:08:15.85,0:08:19.32,Default,pineapple,0,0,0,,لا يهمني كيف فهمنا بعضنا البعض هناك.
Dialogue: 0,0:08:19.32,0:08:21.05,Default,الأناناس,0,0,0,,من فضلك استمع لي.
Dialogue: 0,0:08:21.05,0:08:23.56,Default,pineapple,0,0,0,,لا أريد أن أستمع إليك وأنت تسكب الماء في أذني!
Dialogue: 0,0:08:23.69,0:08:25.79,Default,أناناس,0,0,0,,-بعيداً عن الطريق!\N-لا مفر!
Dialogue: 0,0:08:25.93,0:08:27.49,Default,الأناناس,0,0,0,,أوافق على الابتعاد،
Dialogue: 0,0:08:27.49,0:08:29.96,Default,الأناناس,0,0,0,,لن أتركك أبداً!
Dialogue: 0,0:08:30.86,0:08:34.60,Default,pineapple,0,0,0,,هل تفهم حتى معنى التباعد؟
Dialogue: 0,0:08:34.60,0:08:36.20,Default,الأناناس,0,0,0,,بالطبع.
Dialogue: 0,0:08:37.04,0:08:40.17,Default,الأناناس,0,0,0,,أتذكر كل ما قلته.
Dialogue: 0,0:08:40.71,0:08:42.34,Default,الأناناس,0,0,0,,التباعد الاجتماعي.
Dialogue: 0,0:08:43.04,0:08:45.51,Default,الأناناس,0,0,0,,عش في سلام ووئام.
Dialogue: 0,0:08:46.51,0:08:48.95,Default,الأناناس,0,0,0,,عيشي يا ملكتي.
Dialogue: 0,0:08:49.32,0:08:51.52,Default,الأناناس,0,0,0,,لكنك نسيت أهم شيء!
Dialogue: 0,0:08:51.52,0:08:52.69,Default,الأناناس,0,0,0,,كل واحد لنفسه!
Dialogue: 0,0:08:52.69,0:08:54.86,Default,أناناس,0,0,0,,عش كما تريد، وسأعيش بطريقتي الخاصة!
Dialogue: 0,0:08:54.86,0:08:56.72,Default,pineapple,0,0,0,,الشيء الأساسي في كل هذا هو ألا تعيش،
Dialogue: 0,0:08:56.72,0:08:59.53,Default,الأناناس,0,0,0,,وحقيقة أن كل شخص لنفسه!
Dialogue: 0,0:08:59.53,0:09:02.13,Default,pineapple,0,0,0,,سأبذل قصارى جهدي لاتباع هذه القاعدة!
Dialogue: 0,0:09:02.13,0:09:04.93,Default,pineapple,0,0,0,,سأبذل قصارى جهدي للتأكد من أننا سعداء!
Dialogue: 0,0:09:04.93,0:09:07.97,Default,pineapple,0,0,0,,انس الأمر!\Nانسى الابتعاد اللعين!
Dialogue: 0,0:09:07.97,0:09:09.14,Default,الأناناس,0,0,0,,لماذا؟
Dialogue: 0,0:09:09.14,0:09:12.51,Default,pineapple,0,0,0,,أنت وأنا نضع معاني مختلفة في هذه العبارة!
Dialogue: 0,0:09:12.51,0:09:15.51,Default,pineapple,0,0,0,,هذا شيء صغير، لكن له بالفعل معنيان مختلفان!
Dialogue: 0,0:09:15.51,0:09:17.01,Default,الأناناس,0,0,0,,نحن نفكر على حد سواء.
Dialogue: 0,0:09:17.01,0:09:19.25,Default,الأناناس,0,0,0,,سأثبت لك ذلك.
Dialogue: 0,0:09:19.38,0:09:22.15,Default,pineapple,0,0,0,,أقترح الالتزام بالتباعد الاجتماعي.
Dialogue: 0,0:09:22.15,0:09:24.65,Default,الأناناس,0,0,0,,لن ألتزم به!
Dialogue: 0,0:09:24.65,0:09:27.32,Default,pineapple,0,0,0,,دعونا نحاول أن نعيش وفق هذه القاعدة!
Dialogue: 0,0:09:27.32,0:09:29.66,Default,الأناناس,0,0,0,,مثير للغضب!
Dialogue: 0,0:09:40.33,0:09:43.87,Default,الأناناس,0,0,0,,6 الحلقة: بين الفهم وسوء الفهم
Dialogue: 0,0:09:45.51,0:09:47.61,Default,أناناس,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:09:49.11,0:09:51.81,Default,pineapple,0,0,0,,يا صاحب الجلالة، ماذا حدث؟
Dialogue: 0,0:09:51.81,0:09:53.51,Default,pineapple,0,0,0,,اتصل برئيس الخصي الآن.
Dialogue: 0,0:09:53.51,0:09:57.72,Default,الأناناس,0,0,0,,أنا بخير، اعتني بالملكة.
Dialogue: 0,0:09:58.18,0:10:00.32,Default,pineapple,0,0,0,,-نعم يا صاحب الجلالة.\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:10:01.52,0:10:03.19,Default,الأناناس,0,0,0,,يا مسكيننا أنت!
Dialogue: 0,0:10:04.12,0:10:05.76,Default,الأناناس,0,0,0,,أسرع!
Dialogue: 0,0:10:13.70,0:10:17.34,Default,pineapple,0,0,0,,ما كان يجب أن أصل إلى هنا\NJang Bong-hwan
Dialogue: 0,0:11:17.13,0:11:19.10,Default,الأناناس,0,0,0,,لقد اشتقت إليك.
Dialogue: 0,0:11:19.37,0:11:21.73,Default,الأناناس,0,0,0,,لقد اشتقت إليك أيضاً.
Dialogue: 0,0:11:23.90,0:11:25.94,Default,الأناناس,0,0,0,,هل أنت في الغرفة؟
Dialogue: 0,0:11:26.61,0:11:28.31,Default,الأناناس,0,0,0,,نعم يا أبي.
Dialogue: 0,0:11:33.68,0:11:36.25,Default,الأناناس,0,0,0,,أرى أنك جاهز.
Dialogue: 0,0:11:36.62,0:11:38.72,Default,الأناناس,0,0,0,,كيف نمت؟
Dialogue: 0,0:11:38.72,0:11:40.32,Default,الأناناس,0,0,0,,حسناً،
Dialogue: 0,0:11:40.35,0:11:44.09,Default,pineapple,0,0,0,,اليوم هو أول يوم لك في القصر،\Nلذا استيقظت مبكراً.
Dialogue: 0,0:11:44.09,0:11:47.89,Default,الأناناس,0,0,0,,سأبذل قصارى جهدي
Dialogue: 0,0:11:47.89,0:11:49.66,Default,الأناناس,0,0,0,,ولن أسيء إلى اسم العائلة.
Dialogue: 0,0:11:49.66,0:11:52.73,Default,pineapple,0,0,0,,من الجيد أن المطر توقف،\Nسيكون الطريق إلى القصر أسهل بكثير.
Dialogue: 0,0:11:52.73,0:11:54.40,Default,الأناناس,0,0,0,,أكمل الاستعداد.
Dialogue: 0,0:11:54.40,0:11:56.07,Default,الأناناس,0,0,0,,نعم.
Dialogue: 0,0:12:17.69,0:12:20.03,Default,الأناناس,0,0,0,,كدت أختنق،
Dialogue: 0,0:12:20.03,0:12:23.03,Default,pineapple,0,0,0,,بصراحة، لولا تشيولجونغ، لكان\NI قد مات بالفعل.
Dialogue: 0,0:12:23.03,0:12:25.50,Default,pineapple,0,0,0,,لماذا لم يعد هذا الشيطان؟
Dialogue: 0,0:12:31.44,0:12:34.27,Default,pineapple,0,0,0,,ماذا حدث بينك وبين الملك؟
Dialogue: 0,0:12:34.27,0:12:36.68,Default,pineapple,0,0,0,,لماذا كنت في البحيرة في مثل هذه الساعة؟
Dialogue: 0,0:12:39.81,0:12:42.08,Default,الأناناس,0,0,0,,أما زلت لم تنته بعد؟
Dialogue: 0,0:12:42.08,0:12:45.42,Default,الأناناس,0,0,0,,لقد مسحت كل شيء.
Dialogue: 0,0:12:50.36,0:12:54.39,Default,pineapple,0,0,0,,متى تمكنت من الهرب؟\NI كان يراقبك.
Dialogue: 0,0:12:55.03,0:12:58.80,Default,الأناناس,0,0,0,,هل قفزت في الماء مرة أخرى؟
Dialogue: 0,0:12:59.20,0:13:01.77,Default,الأناناس,0,0,0,,الأمر ليس كذلك على الإطلاق.
Dialogue: 0,0:13:03.67,0:13:07.54,Default,pineapple,0,0,0,,جلالتك، لقد أحضرت ملابس بديلة.
Dialogue: 0,0:13:07.54,0:13:09.44,Default,الأناناس,0,0,0,,لماذا أنت مبتل جدًا إذن؟
Dialogue: 0,0:13:09.44,0:13:13.21,Default,الأناناس,0,0,0,,نعم. كنت سعيدًا لأن البحيرة امتلأت مرة أخرى،
Dialogue: 0,0:13:13.21,0:13:16.18,Default,الأناناس,0,0,0,,لذلك قررت السباحة.
Dialogue: 0,0:13:16.68,0:13:18.22,Default,الأناناس,0,0,0,,ماذا؟
Dialogue: 0,0:13:18.22,0:13:20.45,Default,الأناناس,0,0,0,,هل كنتما تسبحان؟
Dialogue: 0,0:13:20.55,0:13:22.52,Default,الأناناس,0,0,0,,يجب ألا تفعل ذلك!
Dialogue: 0,0:13:22.52,0:13:25.56,Default,الأناناس,0,0,0,,ماذا لو مرضت؟
Dialogue: 0,0:13:26.96,0:13:31.00,Default,الأناناس,0,0,0,,يبدو أن البحيرة لن تساعدني على العودة.
Dialogue: 0,0:13:32.03,0:13:33.73,Default,الأناناس,0,0,0,,نوع من الهراء.
Dialogue: 0,0:13:44.04,0:13:45.71,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,0:13:46.11,0:13:47.38,Default,الأناناس,0,0,0,,ها أنت ذا!
Dialogue: 0,0:13:47.38,0:13:49.62,Default,الأناناس,0,0,0,,لقد كنت أبحث عنك في كل مكان،
Dialogue: 0,0:13:49.62,0:13:51.92,Default,الأناناس,0,0,0,,أين كنت في عجلة من هذا القبيل...
Dialogue: 0,0:13:52.49,0:13:54.72,Default,الأناناس,0,0,0,,لماذا تبتل؟
Dialogue: 0,0:13:54.72,0:13:57.29,Default,pineapple,0,0,0,,-لا بأس.\N-كيف يمكن أن يكون ذلك؟
Dialogue: 0,0:14:46.01,0:14:47.61,Default,الأناناس,0,0,0,,أنا مدين لك بدين كبير،
Dialogue: 0,0:14:47.61,0:14:50.78,Default,الأناناس,0,0,0,,لذلك سأعيش لمساعدتك يا سيدتي.
Dialogue: 0,0:14:59.19,0:15:02.16,Default,pineapple,0,0,0,,عذراً، لم ألاحظك.
Dialogue: 0,0:15:02.16,0:15:04.69,Default,pineapple,0,0,0,,هل أنت متأكد أنك لم ترى أي شيء؟
Dialogue: 0,0:15:19.31,0:15:21.11,Default,الأناناس,0,0,0,,عندما تعرف الزريعة الصغيرة الكثير،
Dialogue: 0,0:15:21.11,0:15:22.98,Default,الأناناس,0,0,0,,فقط الموت ينتظرها.
Dialogue: 0,0:15:24.48,0:15:27.85,Default,pineapple,0,0,0,,هذه هي قاعدة القصر.
Dialogue: 0,0:15:28.55,0:15:31.05,Default,الأناناس,0,0,0,,يجب أن أنجو.
Dialogue: 0,0:15:31.12,0:15:34.82,Default,الأناناس,0,0,0,,أخبرتني السيدة هواجين أن أعيش.
Dialogue: 0,0:15:59.71,0:16:04.88,Default,Pineapple,0,0,0,,اليوم فجر اليوم سقطت الملكة في البحيرة مرة أخرى.
Dialogue: 0,0:16:05.15,0:16:09.32,Default,pineapple,0,0,0,,ولكن هذه المرة كان الملك معها...
Dialogue: 0,0:16:09.72,0:16:14.56,Default,pineapple,0,0,0,,يبدو أن لا أحد يعرف لماذا انتهى بهما الأمر في الماء.
Dialogue: 0,0:16:15.76,0:16:17.63,Default,الأناناس,0,0,0,,هذا يكفي،
Dialogue: 0,0:16:17.63,0:16:22.30,Default,pineapple,0,0,0,,لإثبات أنني سأكون مفيدًا؟
Dialogue: 0,0:16:23.20,0:16:25.91,Default,الأناناس,0,0,0,,أخبر الملكة الأم بهذا.
Dialogue: 0,0:16:26.24,0:16:30.14,Default,pineapple,0,0,0,,هل يجب أن أصف كل شيء كما كان بالضبط؟
Dialogue: 0,0:16:30.14,0:16:32.38,Default,الأناناس,0,0,0,,بعد أن تتحدث،
Dialogue: 0,0:16:32.68,0:16:34.95,Default,الأناناس,0,0,0,,أخبرني بكل ما تقوله أو تفعله
Dialogue: 0,0:16:34.95,0:16:37.18,Default,الأناناس,0,0,0,,الملكة الأم، أي شيء صغير.
Dialogue: 0,0:16:38.72,0:16:42.25,Default,pineapple,0,0,0,,ليس من حقك أن تقرر ما قد يكون مفيدًا.
Dialogue: 0,0:16:42.46,0:16:44.29,Default,الأناناس,0,0,0,,سأفعل بالضبط كما طلبت.
Dialogue: 0,0:16:45.26,0:16:48.03,Default,pineapple,0,0,0,,من هذا اليوم فصاعدا، عليك أن تطيع سيدة البلاط
Dialogue: 0,0:16:48.03,0:16:51.00,Default,الأناناس,0,0,0,,غرف الملكة.
Dialogue: 0,0:16:53.80,0:16:55.50,Default,الأناناس,0,0,0,,غرف الملكة؟
Dialogue: 0,0:16:56.07,0:16:58.30,Default,الأناناس,0,0,0,,هذا مكانة عالية جداً!
Dialogue: 0,0:16:58.34,0:16:59.91,Default,الأناناس,0,0,0,,شكرًا لك يا سيدي!
Dialogue: 0,0:16:59.91,0:17:03.54,Default,pineapple,0,0,0,,ستقرر الملكة الأم أنك ستكون أكثر فائدة لها.
Dialogue: 0,0:17:04.34,0:17:07.75,Default,الأناناس,0,0,0,,راقب محيط الملكة بعناية.
Dialogue: 0,0:17:08.11,0:17:10.75,Default,الأناناس,0,0,0,,نعم يا سيدي.
Dialogue: 0,0:17:21.66,0:17:23.40,Default,ليلى,0,0,0,,ارسم زهرة
Dialogue: 0,0:17:23.40,0:17:25.46,Default,ليلى,0,0,0,,أم برعم؟
Dialogue: 0,0:17:26.47,0:17:28.77,Default,ليلي,0,0,0,,ما رأيك يا أوفول؟
Dialogue: 0,0:17:33.84,0:17:36.04,Default,ليلي,0,0,0,,إلا صاحب الجلالة،
Dialogue: 0,0:17:36.48,0:17:38.54,Default,ليلي,0,0,0,,ليس لدي أحد الآن.
Dialogue: 0,0:17:41.48,0:17:45.28,Default,ليلي,0,0,0,,صاحب السمو، الملكة الأم هنا.
Dialogue: 0,0:17:49.52,0:17:51.72,Default,ليلي,0,0,0,,تحياتي يا صاحب الجلالة.
Dialogue: 0,0:17:51.72,0:17:54.23,Default,ليلي,0,0,0,,لقد رسمت زهور الأوركيد.
Dialogue: 0,0:18:00.57,0:18:02.30,Default,ليلي,0,0,0,,هل انتهوا؟
Dialogue: 0,0:18:02.30,0:18:03.84,Default,ليلي,0,0,0,,ليس بعد.
Dialogue: 0,0:18:03.84,0:18:07.27,Default,Lily,0,0,0,,لم أقرر ما إذا كنت سأرسم زهرة أم برعمًا غير مفتوح.
Dialogue: 0,0:18:07.27,0:18:09.78,Default,ليلي,0,0,0,,دعني أرى.
Dialogue: 0,0:18:09.91,0:18:13.58,Default,Lily,0,0,0,,أعتقد أن البرعم سيفي بالغرض.
Dialogue: 0,0:18:14.28,0:18:16.98,Default,ليلي,0,0,0,,سيكون الجميع مهتمين،
Dialogue: 0,0:18:17.65,0:18:21.52,Default,ليلي,0,0,0,,أي زهرة ستكون؟
Dialogue: 0,0:18:39.07,0:18:42.01,Default,ليلي,0,0,0,,يا إلهي، ما هذا الجمال.
Dialogue: 0,0:18:42.04,0:18:44.91,Default,ليلي,0,0,0,,آمل ألا تتطاير البراعم،
Dialogue: 0,0:18:44.91,0:18:48.15,Default,ليلى,0,0,0,,قبل أن تزهر.
Dialogue: 0,0:18:49.88,0:18:51.12,Default,ليلي,0,0,0,,بالمناسبة.
Dialogue: 0,0:18:51.12,0:18:54.65,Default,ليلي,0,0,0,,جئت لأقدم لك هدية صغيرة.
Dialogue: 0,0:19:07.40,0:19:08.70,Default,ليلي,0,0,0,,شكراً لك.
Dialogue: 0,0:19:08.70,0:19:10.24,Default,ليلي,0,0,0,,لم أعرف ما الذي أعجبك،
Dialogue: 0,0:19:10.24,0:19:12.84,Default,ليلي,0,0,0,,كان علي أن أفكر لفترة طويلة.
Dialogue: 0,0:19:22.28,0:19:25.65,Default,ليلي,0,0,0,,سمعت أنك رامي سهام ممتاز.
Dialogue: 0,0:19:26.72,0:19:28.99,Default,Lily,0,0,0,,أريد أيضًا أن أتعلم كيفية رمي القوس.
Dialogue: 0,0:19:28.99,0:19:31.82,Default,ليلي,0,0,0,,لقد أعددته لنفسي ولكم.
Dialogue: 0,0:19:35.23,0:19:37.73,Default,ليلي,0,0,0,,سهام جميلة ومتينة.
Dialogue: 0,0:19:39.17,0:19:40.40,Default,ليلي,0,0,0,,شكرًا لك.
Dialogue: 0,0:19:40.40,0:19:43.60,Default,Lily,0,0,0,,الهدية الحقيقية ليست السهام.
Dialogue: 0,0:19:44.27,0:19:47.37,Default,ليلي,0,0,0,,سيتم تسليم الهدية اليوم
Dialogue: 0,0:19:47.37,0:19:50.18,Default,ليلي,0,0,0,,إلى جلالته في جلسة المحكمة.
Dialogue: 0,0:19:58.42,0:19:59.99,Default,ليلي,0,0,0,,أين إن لم يكن في البحيرة؟
Dialogue: 0,0:19:59.99,0:20:02.35,Default,ليلي,0,0,0,,فقط الماء يوحدنا.
Dialogue: 0,0:20:08.06,0:20:09.90,Default,ليلي,0,0,0,,وهناك شيء آخر.
Dialogue: 0,0:20:10.46,0:20:12.73,Default,Lily,0,0,0,,كنا على وشك الموت.
Dialogue: 0,0:20:13.00,0:20:15.07,Default,Lily,0,0,0,,اللعنة، ماذا لو حاولت ومت حقاً؟
Dialogue: 0,0:20:15.07,0:20:17.44,Default,ليلي,0,0,0,,الموت مؤلم جداً.
Dialogue: 0,0:20:18.74,0:20:22.57,Default,Lily,0,0,0,,أنا متأكد من أن هناك طريقة آمنة للعودة.
Dialogue: 0,0:20:23.14,0:20:25.84,Default,Lily,0,0,0,,بادئ ذي بدء، سأفهم أي نوع من النساء هذه.
Dialogue: 0,0:20:29.35,0:20:32.38,Default,ليلي,0,0,0,,أنا كيم سو يون.
Dialogue: 0,0:20:33.29,0:20:35.39,Default,ليلي,0,0,0,,انتحرت.
Dialogue: 0,0:20:35.96,0:20:40.89,Default,ليلي,0,0,0,,اترك نفسك الزائفة؟
Dialogue: 0,0:20:41.89,0:20:45.03,Default,ليلي,0,0,0,,لماذا حاولت الموت؟ لم أكن أريد أن أعيش.
Dialogue: 0,0:20:47.23,0:20:50.14,Default,ليلي,0,0,0,,بالطبع، لهذا السبب لا تريد العودة.
Dialogue: 0,0:20:50.34,0:20:53.91,Default,ليلي,0,0,0,,هذه المرأة... هربت؟
Dialogue: 0,0:20:57.94,0:21:00.21,Default,ليلي,0,0,0,,أنا أفهم لماذا تفعل هذا.
Dialogue: 0,0:21:00.21,0:21:02.32,Default,ليلي,0,0,0,,أنت مهووس بالبحيرة
Dialogue: 0,0:21:02.32,0:21:04.68,Default,ليلي,0,0,0,,وتتمتم مع نفسك.
Dialogue: 0,0:21:04.75,0:21:06.85,Default,ليلي,0,0,0,,هذا لأنك...
Dialogue: 0,0:21:10.19,0:21:12.76,Default,ليلي,0,0,0,,هل تحاول استعادة الذكريات؟
Dialogue: 0,0:21:14.76,0:21:16.76,Default,ليلي,0,0,0,,نعم. أنت على حق.
Dialogue: 0,0:21:16.76,0:21:18.16,Default,ليلي,0,0,0,,حسنًا.
Dialogue: 0,0:21:18.16,0:21:20.70,Default,Lily,0,0,0,,لقد نشأ سؤال. عندما سقطت في البحيرة
Dialogue: 0,0:21:20.70,0:21:23.47,Default,Lily,0,0,0,,لقد تم إخراجي على الفور، لكنني كنت فاقداً للوعي؟
Dialogue: 0,0:21:24.04,0:21:25.57,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:21:25.57,0:21:27.61,Default,ليلي,0,0,0,,اللعنة. كنت أعرف. لقد هربت.
Dialogue: 0,0:21:28.04,0:21:30.08,Default,ليلي,0,0,0,,هذا غير عادل.
Dialogue: 0,0:21:30.08,0:21:32.41,Default,ليلي,0,0,0,,أريد العودة.
Dialogue: 0,0:21:33.58,0:21:35.78,Default,ليلي,0,0,0,,هذه عملية اختطاف!
Dialogue: 0,0:21:36.65,0:21:39.35,Default,ليلي,0,0,0,,دوروسوما مشوية تعيد الزوجات الهاربات.
Dialogue: 0,0:21:39.82,0:21:42.79,Default,Lily,0,0,0,,أو تستدعي الأرواح التي غادرت الجسد؟
Dialogue: 0,0:21:43.29,0:21:44.89,Default,ليلي,0,0,0,,طقوس؟
Dialogue: 0,0:21:45.26,0:21:48.43,Default,ليلي,0,0,0,,نعم. لا بد لي من أداء الحفل.
Dialogue: 0,0:21:48.43,0:21:50.86,Default,Lily,0,0,0,,سأغطي كل شيء هنا بالتعويذات باهظة الثمن.
Dialogue: 0,0:21:51.60,0:21:54.03,Default,ليلي,0,0,0,,سيدة البلاط تشوي، هل أنت هناك؟
Dialogue: 0,0:21:58.27,0:22:02.34,Default,ليلي,0,0,0,,هل هناك متخصص في الطقوس أو الطلسمات هنا؟
Dialogue: 0,0:22:02.91,0:22:04.51,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:22:04.51,0:22:07.48,Default,ليلي,0,0,0,,يجب ألا تكون مهتماً بالشامانية،
Dialogue: 0,0:22:08.11,0:22:10.48,Default,ليلي,0,0,0,,لكنك ستفعل ذلك على أية حال؟
Dialogue: 0,0:22:12.12,0:22:16.49,Default,ليلي,0,0,0,,يتبادر إلى ذهني شخص واحد.
Dialogue: 0,0:22:17.19,0:22:18.82,Default,ليلي,0,0,0,,ومن؟
Dialogue: 0,0:22:27.63,0:22:31.20,Default,ليلي,0,0,0,,لماذا أتت إلى هنا؟ ماذا يريد أن يعرف؟
Dialogue: 0,0:22:31.20,0:22:34.54,Default,Lily,0,0,0,,إلى ماذا أدين بهذه المتعة؟
Dialogue: 0,0:22:35.24,0:22:37.41,Default,ليلي,0,0,0,,علمت أنك خبير.
Dialogue: 0,0:22:37.54,0:22:40.65,Default,ليلي,0,0,0,,أنا؟ ماذا؟
Dialogue: 0,0:22:41.11,0:22:44.35,Default,ليلي,0,0,0,,أحتاج إلى مرشد روحي.
Dialogue: 0,0:22:44.65,0:22:48.22,Default,ليلي,0,0,0,,في أمور مثل الطقوس والطلسمات.
Dialogue: 0,0:22:48.22,0:22:51.59,Default,ليلي,0,0,0,,هل خمنت حقاً أن لدي تعويذة جديدة،
Dialogue: 0,0:22:51.59,0:22:53.66,Default,ليلي,0,0,0,,ألعنها؟
Dialogue: 0,0:22:54.03,0:22:57.13,Default,ليلي,0,0,0,,هيا، هذا ذوق سيء.
Dialogue: 0,0:22:57.13,0:23:00.33,Default,ليلي,0,0,0,,لماذا تحتاج هذا؟
Dialogue: 0,0:23:00.33,0:23:02.10,Default,ليلي,0,0,0,,نعم، هذا هراء.
Dialogue: 0,0:23:02.10,0:23:06.24,Default,Lily,0,0,0,,أنت بحاجة إلى استدعاء الروح التي غادرت الجسد.
Dialogue: 0,0:23:07.44,0:23:09.44,Default,Lily,0,0,0,,هل يحدث هذا كثيرًا؟
Dialogue: 0,0:23:09.44,0:23:12.98,Default,ليلي,0,0,0,,إنها تحاول بذكاء التقرب مني.
Dialogue: 0,0:23:12.98,0:23:15.98,Default,ليلي,0,0,0,,يريد أن يعاقبني على تعويذاتي.
Dialogue: 0,0:23:15.98,0:23:18.02,Default,ليلي,0,0,0,,ثعلب ماكر.
Dialogue: 0,0:23:18.55,0:23:21.62,Default,ليلي,0,0,0,,أنا لا أؤمن بمثل هذه الأشياء.
Dialogue: 0,0:23:21.62,0:23:24.76,Default,Lily,0,0,0,,لا أشباح ولا أرواح.
Dialogue: 0,0:23:26.19,0:23:30.46,Default,ليلي,0,0,0,,إذن لماذا هذا هنا؟
Dialogue: 0,0:23:37.50,0:23:39.17,Default,ليلي,0,0,0,,أنت مخطئ.
Dialogue: 0,0:23:39.17,0:23:41.47,Default,Lily,0,0,0,,هذا ليس مكانًا شامانيًا.
Dialogue: 0,0:23:41.47,0:23:44.21,Default,ليلي,0,0,0,,هنا أطهر روحي.
Dialogue: 0,0:23:44.21,0:23:46.14,Default,ليلي,0,0,0,,فهمت.
Dialogue: 0,0:23:48.38,0:23:50.02,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:23:50.25,0:23:51.95,Default,ليلي,0,0,0,,حقاً؟
Dialogue: 0,0:23:52.72,0:23:57.56,Default,ليلي,0,0,0,,من هي الروح التي تريد استدعائها؟
Dialogue: 0,0:23:58.86,0:24:03.16,Default,Lily,0,0,0,,أستطيع أن أقول إننا قريبون ومترابطون بشكل وثيق.
Dialogue: 0,0:24:04.63,0:24:06.20,Default,ليلي,0,0,0,,هذه امرأة، لا تفهموني خطأ.
Dialogue: 0,0:24:06.20,0:24:07.93,Default,ليلي,0,0,0,,فهمت.
Dialogue: 0,0:24:08.37,0:24:12.84,Default,Lily,0,0,0,,من المحتمل أن تكون هذه والدتك،\Nالتي لم ترها من قبل.
Dialogue: 0,0:24:14.24,0:24:18.51,Default,ليلي,0,0,0,,يا إلهي. قلبي ينكسر بسببك.
Dialogue: 0,0:24:18.61,0:24:20.61,Default,ليلي,0,0,0,,لا بد أنك وحيد في القصر.
Dialogue: 0,0:24:20.61,0:24:23.32,Default,ليلي,0,0,0,,أنت تفتقد والدتك الراحلة.
Dialogue: 0,0:24:23.32,0:24:25.02,Default,ليلي,0,0,0,,لهذا السبب
Dialogue: 0,0:24:25.35,0:24:28.02,Default,ليلي,0,0,0,,حاولت الانتحار؟
Dialogue: 0,0:24:30.16,0:24:31.86,Default,ليلي,0,0,0,,هل تعتقد ذلك؟
Dialogue: 0,0:24:31.86,0:24:34.96,Default,ليلي,0,0,0,,يمكنك أن تخبرني بكل شيء.
Dialogue: 0,0:24:34.96,0:24:37.33,Default,ليلي,0,0,0,,رغم أنني لم أنجب ملكاً،
Dialogue: 0,0:24:37.33,0:24:41.00,Default,Lily,0,0,0,,ولكن حسب النسب، أنا والدته.
Dialogue: 0,0:24:41.00,0:24:46.37,Default,Lily,0,0,0,,من هذا اليوم فصاعداً، سأعتز بك كابنتي وسأعتني بك...
Dialogue: 0,0:24:46.97,0:24:49.37,Default,ليلي,0,0,0,,لدي والدتان بالفعل.
Dialogue: 0,0:24:50.31,0:24:53.71,Default,Lily,0,0,0,,لأكون صادقًا، لم أكن أحاول قتل نفسي.
Dialogue: 0,0:24:53.71,0:24:57.32,Default,ليلي,0,0,0,,إذاً لماذا قلت ذلك؟
Dialogue: 0,0:24:57.38,0:24:59.05,Default,Lily,0,0,0,,وأنا أتحدث عن نفس الشيء.
Dialogue: 0,0:24:59.05,0:25:01.19,Default,ليلي,0,0,0,,لماذا فعلت هذا بحق السماء؟
Dialogue: 0,0:25:01.32,0:25:03.86,Default,ليلي,0,0,0,,هل تريدني أن أخمن؟
Dialogue: 0,0:25:04.39,0:25:07.59,Default,ليلي,0,0,0,,إذن لديها دافع خفي.
Dialogue: 0,0:25:09.33,0:25:13.67,Default,ليلي,0,0,0,,لذا فهي تهددني وتريدني أن أكون على أهبة الاستعداد.
Dialogue: 0,0:25:18.94,0:25:22.34,Default,ليلي,0,0,0,,اللعنة. ضيعت وقتي.
Dialogue: 0,0:25:24.31,0:25:26.71,Default,Lily,0,0,0,,جلسة المحكمة لم تنعقد بعد.
Dialogue: 0,0:25:26.71,0:25:30.05,Default,ليلي,0,0,0,,وهي تحاول تهديدي بالفعل؟
Dialogue: 0,0:25:30.92,0:25:34.19,Default,ليلي,0,0,0,,سيدة البلاط هان، لديهم أيضاً
Dialogue: 0,0:25:34.19,0:25:36.96,Default,ليلي,0,0,0,,طائر يجلب الشائعات.
Dialogue: 0,0:25:36.96,0:25:40.53,Default,ليلي,0,0,0,,ماذا؟ من يستطيع أن يفعل هذا؟
Dialogue: 0,0:25:40.59,0:25:45.93,Default,ليلي,0,0,0,,اندفعت بجرأة وألقت تلميحات،
Dialogue: 0,0:25:46.47,0:25:50.67,Default,Lily,0,0,0,,لذا ليس من السهل اكتشاف الطائر.
Dialogue: 0,0:25:51.67,0:25:54.04,Default,ليلي,0,0,0,,اتصل بالعرافة، سيدة البلاط هان.
Dialogue: 0,0:25:54.34,0:25:59.08,Default,ليلي,0,0,0,,أحتاج إلى تنبؤات.
Dialogue: 0,0:26:02.65,0:26:05.25,Default,ليلي,0,0,0,,لقد عذبها شيء وحاولت قتل نفسها.
Dialogue: 0,0:26:05.25,0:26:06.95,Default,ليلي,0,0,0,,لكنها لا تستطيع أن تموت.
Dialogue: 0,0:26:06.95,0:26:09.05,Default,Lilia,0,0,0,,وروحها تقول: "لا يهمني. سأخرج".
Dialogue: 0,0:26:09.22,0:26:12.66,Default,ليلي,0,0,0,,ولم يعد.
Dialogue: 0,0:26:12.99,0:26:14.69,Default,ليلي,0,0,0,,ما الذي كان يعذبها؟
Dialogue: 0,0:26:14.69,0:26:17.10,Default,ليلي,0,0,0,,لم تكن تريد أن تصبح ملكة.
Dialogue: 0,0:26:17.10,0:26:18.76,Default,ليلي,0,0,0,,لماذا؟
Dialogue: 0,0:26:19.23,0:26:22.00,Default,ليلي,0,0,0,,لأن تشيولجونغ لم يحبها
Dialogue: 0,0:26:22.00,0:26:24.57,Default,ليلي,0,0,0,,ووقعت في حب شخص آخر؟
Dialogue: 0,0:26:24.57,0:26:26.14,Default,ليلي,0,0,0,,هيا.
Dialogue: 0,0:26:26.14,0:26:28.84,Default,ليلي,0,0,0,,حاولت أن تموت بسبب معتوه؟
Dialogue: 0,0:26:30.21,0:26:33.35,Default,ليلي,0,0,0,,تتحدث صاحبة الجلالة مع نفسها أكثر من المعتاد.
Dialogue: 0,0:26:33.35,0:26:34.91,Default,ليلي,0,0,0,,يسمع الكثير من الناس.
Dialogue: 0,0:26:34.91,0:26:36.82,Default,ليلي,0,0,0,,هذا أقل مشاكلي.
Dialogue: 0,0:26:36.82,0:26:40.42,Default,ليلي,0,0,0,,أنا أزعجها بشأن هذا، لكن حان الوقت للسماح لها بالرحيل.
Dialogue: 0,0:26:41.19,0:26:43.56,Default,ليلي,0,0,0,,وبهذا المعدل، ستقتل شخصاً ما قريباً.
Dialogue: 0,0:26:45.06,0:26:47.59,Default,ليلي,0,0,0,,ولكن مرة أخرى، أنا أفهمها.
Dialogue: 0,0:26:47.59,0:26:50.66,Default,Lily,0,0,0,,كونك ملكة يشبه الجلوس في سجن بلا قضبان.
Dialogue: 0,0:26:50.66,0:26:53.80,Default,ليلي,0,0,0,,من عائلة نبيلة، اختيرت لتصبح ملكة،
Dialogue: 0,0:26:53.80,0:26:56.24,Default,Lilia,0,0,0,,مما يعني أنها لم تقابل أحداً.
Dialogue: 0,0:26:56.24,0:26:59.24,Default,Lily,0,0,0,,ربما لم يسبق لي أن رأيت الرجل قبل تشيولجونغ.
Dialogue: 0,0:26:59.24,0:27:01.77,Default,ليلي,0,0,0,,بالنظر إلى أنه ملك وكل شيء،
Dialogue: 0,0:27:01.77,0:27:04.24,Default,ليلي,0,0,0,,من الواضح سبب وقوعها في الحب.
Dialogue: 0,0:27:05.81,0:27:10.15,Default,ليلي,0,0,0,,انتظر لحظة. لا بد أنها تحظى بالكثير من المرح الآن.
Dialogue: 0,0:27:10.15,0:27:12.52,Default,ليلي,0,0,0,,طوال حياتي أعيش أسلوب حياة الزاهد،
Dialogue: 0,0:27:12.52,0:27:15.29,Default,ليلي,0,0,0,,اكتشفت عالماً جديداً.
Dialogue: 0,0:27:17.92,0:27:19.82,Default,ليلي,0,0,0,,وإذا كانت هذه المرأة...
Dialogue: 0,0:27:20.69,0:27:23.56,Default,ليلي,0,0,0,,دعه لا يلعب بجسدي!
Dialogue: 0,0:27:37.44,0:27:39.18,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:27:55.86,0:27:57.76,Default,ليلي,0,0,0,,توقف!
Dialogue: 0,0:27:57.76,0:28:00.80,Default,ليلي,0,0,0,,عد بسرعة، سنلقنك درساً!
Dialogue: 0,0:28:00.80,0:28:02.37,Default,ليلي,0,0,0,,ألا تريدين ذلك؟
Dialogue: 0,0:28:02.37,0:28:05.84,Default,ليلي,0,0,0,,ما هو الشيء المثير للاهتمام الذي تنظر إليه؟
Dialogue: 0,0:28:06.34,0:28:08.81,Default,ليلي,0,0,0,,إذن سأفعل
Dialogue: 0,0:28:09.14,0:28:11.84,Default,ليلي,0,0,0,,اقطع جسدك. حتى أنزف!
Dialogue: 0,0:28:11.84,0:28:13.75,Default,ليلي,0,0,0,,سيكون هذا مؤلماً جداً.
Dialogue: 0,0:28:14.31,0:28:18.82,Default,ليلي,0,0,0,,هل تعتقد أنني لا أستطيع؟ أستطيع أن أفعل ذلك. مثله!
Dialogue: 0,0:28:25.22,0:28:26.96,Default,ليلي,0,0,0,,اللعنة، هذا مؤلم.
Dialogue: 0,0:28:29.70,0:28:32.66,Default,ليلي,0,0,0,,سيكون هناك دماء هذه المرة بالتأكيد.
Dialogue: 0,0:28:37.10,0:28:38.94,Default,ليلي,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:28:39.27,0:28:41.04,Default,ليلي,0,0,0,,إنه أمر مؤلم حقًا!
Dialogue: 0,0:28:41.51,0:28:43.44,Default,ليلي,0,0,0,,-إنه يؤلمني كثيراً.\N-انهض.
Dialogue: 0,0:28:44.58,0:28:46.55,Default,ليلي,0,0,0,,هذا مؤلم.
Dialogue: 0,0:28:46.55,0:28:49.45,Default,ليلي,0,0,0,,-يا إلهي.\N-لقد امتلأ كأس الصبر.
Dialogue: 0,0:28:50.28,0:28:54.15,Default,ليلي,0,0,0,,سوف يعود، لن يعود.
Dialogue: 0,0:28:54.39,0:28:55.99,Default,ليلي,0,0,0,,سوف يعود.
Dialogue: 0,0:28:57.69,0:28:59.39,Default,ليلي,0,0,0,,لن يعود.
Dialogue: 0,0:29:03.73,0:29:05.43,Default,ليلي,0,0,0,,المزيد؟
Dialogue: 0,0:29:05.93,0:29:07.77,Default,ليلي,0,0,0,,يا صاحب الجلالة، لا تقلق.
Dialogue: 0,0:29:07.77,0:29:10.34,Default,Lily,0,0,0,,سيعود عندما يحين الوقت.
Dialogue: 0,0:29:10.34,0:29:14.41,Default,ليلي,0,0,0,,بحلول ذلك الوقت سأفعل بالفعل...
Dialogue: 0,0:29:20.35,0:29:23.52,Default,ليلي,0,0,0,,أنا أدعو الروح. تأتي الروح.
Dialogue: 0,0:29:23.58,0:29:25.92,Default,ليلي,0,0,0,,هل أنت هنا؟
Dialogue: 0,0:29:26.92,0:29:30.76,Default,ليلي,0,0,0,,استدعاء الروح. تأتي الروح.
Dialogue: 0,0:29:30.82,0:29:32.99,Default,ليلي,0,0,0,,هل أنت هناك؟
Dialogue: 0,0:29:34.79,0:29:37.13,Default,Lily,0,0,0,,بما أن لدينا أجساد بعضنا البعض،
Dialogue: 0,0:29:37.23,0:29:40.23,Default,ليلي,0,0,0,,دعونا نتحدث بصراحة.
Dialogue: 0,0:29:43.57,0:29:45.84,Default,ليلي,0,0,0,,تتحدثين مع نفسك مرة أخرى؟
Dialogue: 0,0:29:46.67,0:29:49.07,Default,Lily,0,0,0,,اعتبر هذا طردًا للذات
Dialogue: 0,0:29:49.78,0:29:51.61,Default,ليلي,0,0,0,,أو تتحدث إلى نفسك.
Dialogue: 0,0:29:51.61,0:29:53.48,Default,Lily,0,0,0,,ماذا لو بدأت الشائعات بالانتشار؟
Dialogue: 0,0:29:53.48,0:29:56.28,Default,ليلي,0,0,0,,في القصر يتفرقون بسرعة.
Dialogue: 0,0:29:56.28,0:29:58.78,Default,ليلي,0,0,0,,ما هذا؟ تبدو جميلة.
Dialogue: 0,0:29:58.78,0:30:01.49,Default,Lily,0,0,0,,أعطاك إياها جلالته.
Dialogue: 0,0:30:01.49,0:30:03.29,Default,ليلي,0,0,0,,ولقد أحضرته.
Dialogue: 0,0:30:12.93,0:30:14.57,Default,ليلي,0,0,0,,كتاب التغييرات
Dialogue: 0,0:30:15.63,0:30:17.37,Default,ليلي,0,0,0,,هناك شيء ما بالداخل.
Dialogue: 0,0:30:18.00,0:30:19.07,Default,ليلي,0,0,0,,التباعد الاجتماعي
Dialogue: 0,0:30:19.07,0:30:22.57,Default,ليلي,0,0,0,,يا إلهي! ظريف جدًا.
Dialogue: 0,0:30:23.18,0:30:25.21,Default,Lily,0,0,0,,لقد انتهيت من هذه المسافة.
Dialogue: 0,0:30:25.21,0:30:28.65,Default,ليلي,0,0,0,,عرضت عليه فرفض. الآن ماذا؟
Dialogue: 0,0:30:34.12,0:30:36.05,Default,تيراميسو,0,0,0,,هل أصبت بالبرد بعد؟
Dialogue: 0,0:30:36.05,0:30:37.66,Default,تيراميسو,0,0,0,,كنت أعلم أن الأمر سيكون هكذا.
Dialogue: 0,0:30:37.66,0:30:40.39,Default,tiramisu,0,0,0,,لقد تبللتَ بالمطر ومازلت تلعب في الماء.
Dialogue: 0,0:30:40.39,0:30:43.19,Default,تيراميسو,0,0,0,,ماذا تريد مني أن أفعل بك؟
Dialogue: 0,0:30:45.30,0:30:46.97,Default,تيراميسو,0,0,0,,هونيون.
Dialogue: 0,0:30:48.20,0:30:50.10,Default,تيراميسو,0,0,0,,ليست نزلة برد.
Dialogue: 0,0:30:50.10,0:30:51.40,Default,تيراميسو,0,0,0,,وماذا بعد ذلك؟
Dialogue: 0,0:30:51.40,0:30:53.27,Default,تيراميسو,0,0,0,,هذا
Dialogue: 0,0:30:54.87,0:30:57.11,Default,تيراميسو,0,0,0,,اليأس نفسه.
Dialogue: 0,0:30:57.94,0:31:00.98,Default,تيراميسو,0,0,0,,اعتقدت أن كل شيء سيتحسن عندما تمتلئ البحيرة.
Dialogue: 0,0:31:01.35,0:31:05.72,Default,تيراميسو,0,0,0,,لكن كما ترى، الأمل شيء قاسٍ.
Dialogue: 0,0:31:06.99,0:31:10.26,Default,tiramisu,0,0,0,,لاستعادة ذاكرتك، أنت مستعد للذهاب إلى الشامان.
Dialogue: 0,0:31:10.82,0:31:13.96,Default,تيراميسو,0,0,0,,أتمنى أن تتوقف عن المحاولة.
Dialogue: 0,0:31:14.09,0:31:16.46,Default,تيراميسو,0,0,0,,إذا كان كل شيء على ما يرام معك،
Dialogue: 0,0:31:16.46,0:31:19.20,Default,تيراميسو,0,0,0,,لن تحاول الانتحار.
Dialogue: 0,0:31:19.60,0:31:21.20,Default,تيراميسو,0,0,0,,من أجل سعادتك،
Dialogue: 0,0:31:21.20,0:31:22.77,Default,تيراميسو,0,0,0,,ربما من الأفضل عدم محاولة العودة...
Dialogue: 0,0:31:22.77,0:31:25.87,Default,تيراميسو,0,0,0,,لا! على أن!
Dialogue: 0,0:31:27.21,0:31:29.87,Default,تيراميسو,0,0,0,,لا أستطيع العيش هكذا بعد الآن.
Dialogue: 0,0:31:32.01,0:31:35.01,Default,تيراميسو,0,0,0,,سأخبر الشيف الملكي أن يعد شيئاً للبرد.
Dialogue: 0,0:31:35.01,0:31:37.25,Default,تيراميسو,0,0,0,,أنت بحاجة إلى الأكل والراحة.
Dialogue: 0,0:31:37.68,0:31:40.52,Default,تيراميسو,0,0,0,,لا، هذه المرأة
Dialogue: 0,0:31:40.52,0:31:44.36,Default,تيراميسو,0,0,0,,ستريد العودة. أعطيك أسناني.
Dialogue: 0,0:31:48.19,0:31:50.40,Default,تيراميسو,0,0,0,,هنا، انفخ أنفك.
Dialogue: 0,0:31:50.40,0:31:53.43,Default,تيراميسو,0,0,0,,أنا لست طفلاً، أستطيع أن أفعل ذلك بنفسي.
Dialogue: 0,0:31:56.37,0:31:59.27,Default,تيراميسو,0,0,0,,مرة أخرى.
Dialogue: 0,0:32:04.51,0:32:06.38,Default,تيراميسو,0,0,0,,-الخصي تشا.\N-نعم.
Dialogue: 0,0:32:07.91,0:32:12.62,Default,تيراميسو,0,0,0,,يا صاحب الجلالة، أنت مصاب بالبرد. يرجى العودة إلى الغرف الخاصة بك.
Dialogue: 0,0:32:12.62,0:32:14.82,Default,تيراميسو,0,0,0,,لا، ليس برداً.
Dialogue: 0,0:32:14.82,0:32:16.79,Default,تيراميسو,0,0,0,,هذا...
Dialogue: 0,0:32:19.79,0:32:22.96,Default,تيراميسو,0,0,0,,أعتقد أن الجو بارد. لقد كنت على حق.
Dialogue: 0,0:32:23.53,0:32:25.83,Default,tiramisu,0,0,0,,هل هناك أي أخبار من قاعة دايجوجون؟
Dialogue: 0,0:32:25.83,0:32:28.93,Default,تيراميسو,0,0,0,,-لا.\N-هل حصلت على الكتاب؟
Dialogue: 0,0:32:28.93,0:32:30.97,Default,تيراميسو,0,0,0,,نعم، فهمت.
Dialogue: 0,0:32:31.60,0:32:35.07,Default,tiramisu,0,0,0,,فتح القلب المغلق ليس بالأمر السهل بالطبع.
Dialogue: 0,0:32:35.07,0:32:37.61,Default,تيراميسو,0,0,0,,لدي معروف أطلبه منك.
Dialogue: 0,0:32:37.61,0:32:40.28,Default,تيراميسو,0,0,0,,أحضر لي شيئاً ثميناً.
Dialogue: 0,0:32:42.48,0:32:45.02,Default,تيراميسو,0,0,0,,تقصد بـ "شيء ثمين"...
Dialogue: 0,0:32:46.55,0:32:49.32,Default,تيراميسو,0,0,0,,ما الذي تفكر فيه؟
Dialogue: 0,0:32:54.59,0:32:56.70,Default,تيراميسو,0,0,0,,نعين كيم بيونغين
Dialogue: 0,0:32:56.70,0:32:59.36,Default,تيراميسو,0,0,0,,رئيس قسم المباحث.
Dialogue: 0,0:32:59.46,0:33:01.33,Default,تيراميسو,0,0,0,,عمل ناجح.
Dialogue: 0,0:33:02.43,0:33:05.00,Default,تيراميسو,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:33:12.58,0:33:15.55,Default,tiramisu,0,0,0,,سمعت أنك أصغر من نجح في امتحان الدولة،
Dialogue: 0,0:33:15.55,0:33:17.75,Default,تيراميسو,0,0,0,,قوي أيضًا في الفنون القتالية.
Dialogue: 0,0:33:18.38,0:33:20.49,Default,تيراميسو,0,0,0,,لكن رغم هذا،
Dialogue: 0,0:33:20.49,0:33:22.35,Default,تيراميسو,0,0,0,,لقد رفضت منصبًا في الحكومة،
Dialogue: 0,0:33:22.35,0:33:24.96,Default,تيراميسو,0,0,0,,مما سبب ارتباكاً عاماً.
Dialogue: 0,0:33:24.96,0:33:28.76,Default,تيراميسو,0,0,0,,ما الذي دفعك إلى تغيير رأيك؟
Dialogue: 0,0:33:29.73,0:33:31.80,Default,tiramisu,0,0,0,"أنقذ البلاد في الأوقات الصعبة."
Dialogue: 0,0:33:31.80,0:33:34.63,Default,تيراميسو,0,0,0,,في هذا الوقت العصيب أريد المساعدة
Dialogue: 0,0:33:34.63,0:33:37.37,Default,تيراميسو,0,0,0,,مع استعادة النظام في البلاد.
Dialogue: 0,0:33:41.47,0:33:43.31,Default,تيراميسو,0,0,0,,وقت عصيب؟
Dialogue: 0,0:33:43.58,0:33:46.61,Default,tiramisu,0,0,0,,كيف يبدو أن الوزراء أخفوا هذا عني،
Dialogue: 0,0:33:46.61,0:33:48.15,Default,تيراميسو,0,0,0,,لذا لا أقلق.
Dialogue: 0,0:33:48.15,0:33:51.08,Default,تيراميسو,0,0,0,,من هذا؟ تشينغ أو اليابانية؟
Dialogue: 0,0:33:51.08,0:33:54.22,Default,تيراميسو,0,0,0,,الصعوبات داخل البلد
Dialogue: 0,0:33:54.25,0:33:56.89,Default,تيراميسو,0,0,0,,أخطر بكثير من التهديدات الخارجية.
Dialogue: 0,0:33:59.29,0:34:02.33,Default,تيراميسو,0,0,0,,فجأة نواجه صعوبات داخل البلد؟
Dialogue: 0,0:34:02.33,0:34:04.56,Default,تيراميسو,0,0,0,,هذا يعني...
Dialogue: 0,0:34:14.01,0:34:17.88,Default,تيراميسو,0,0,0,,أصبت بالبرد.
Dialogue: 0,0:34:17.88,0:34:22.65,Default,tiramisu,0,0,0,,يجب أن يعرف الملك الحكيم كيف يعتني بصحته.
Dialogue: 0,0:34:27.09,0:34:29.79,Default,تيراميسو,0,0,0,,
Dialogue: 0,0:34:34.89,0:34:36.33,Default,تيراميسو,0,0,0,,أنت بحاجة لتناول الطعام،
Dialogue: 0,0:34:36.33,0:34:38.20,Default,تيراميسو,0,0,0,,ثم استرخ.
Dialogue: 0,0:34:38.20,0:34:41.20,Default,تيراميسو,0,0,0,,لا أريد ذلك، سأجلس هنا حتى أمرض تماماً.
Dialogue: 0,0:34:41.20,0:34:42.80,Default,تيراميسو,0,0,0,,دع الجسد يعاني.
Dialogue: 0,0:34:43.10,0:34:44.50,Default,تيراميسو,0,0,0,,ما زال ليس من اهتماماتي.
Dialogue: 0,0:34:44.50,0:34:47.54,Default,تيراميسو,0,0,0,,دعه يشعر بالبرد والجوع.
Dialogue: 0,0:34:48.54,0:34:50.64,Default,تيراميسو,0,0,0,,مازلت أريده.
Dialogue: 0,0:34:55.48,0:34:56.92,Default,تيراميسو,0,0,0,,جلالتك,
Dialogue: 0,0:34:56.92,0:34:59.68,Default,تيراميسو,0,0,0,,تعذيب جسدك لن يعيد ذاكرتك.
Dialogue: 0,0:34:59.68,0:35:01.79,Default,تيراميسو,0,0,0,,لن تؤذي إلا نفسك.
Dialogue: 0,0:35:01.79,0:35:04.36,Default,تيراميسو,0,0,0,,أنت تقول أن هذا ليس جسدك،
Dialogue: 0,0:35:04.36,0:35:07.19,Default,تيراميسو,0,0,0,,لكنها لك، رغم أنك لا تتذكر أي شيء.
Dialogue: 0,0:35:07.19,0:35:10.53,Default,تيراميسو,0,0,0,,من سيعاني؟ أنت بالطبع.
Dialogue: 0,0:35:11.30,0:35:13.13,Default,تيراميسو,0,0,0,,حتى بدون ذكريات
Dialogue: 0,0:35:13.13,0:35:15.70,Default,تيراميسو,0,0,0,,ستكون سعيداً بالتأكيد.
Dialogue: 0,0:35:15.70,0:35:19.40,Default,تيراميسو,0,0,0,,انظر إلى السماء. ما الطقس الجيد اليوم!
Dialogue: 0,0:35:23.38,0:35:26.91,Default,تيراميسو,0,0,0,,نعم. لا يوجد غبار في الهواء.
Dialogue: 0,0:35:30.12,0:35:33.69,Default,تيراميسو,0,0,0,,النسيم يحمل رائحة الروث الطازج.
Dialogue: 0,0:35:34.52,0:35:36.92,Default,تيراميسو,0,0,0,,الطعام الكوري ثلاث مرات في اليوم.
Dialogue: 0,0:35:37.92,0:35:39.46,Default,تيراميسو,0,0,0,,كيف لا تكون سعيداً.
Dialogue: 0,0:35:39.46,0:35:41.73,Default,تيراميسو,0,0,0,,نعم، أنا سعيد بالتأكيد.
Dialogue: 0,0:35:42.73,0:35:44.73,Default,تيراميسو,0,0,0,,أنا أتفق معك.
Dialogue: 0,0:35:47.57,0:35:50.50,Default,تيراميسو,0,0,0,,جلالة الملك، هل تبكي؟
Dialogue: 0,0:35:50.50,0:35:53.57,Default,تيراميسو,0,0,0,,لا، أنا لا أبكي. انا سعيد للغاية.
Dialogue: 0,0:35:53.71,0:35:54.97,Default,تيراميسو,0,0,0,,كما قلت،
Dialogue: 0,0:35:54.97,0:35:57.68,Default,تيراميسو,0,0,0,,سأحاول أن أعيش حياة سعيدة.
Dialogue: 0,0:35:58.34,0:36:02.41,Default,tiramisu,0,0,0,,هل أنت حزين جدًا بسبب قلة الذكريات؟
Dialogue: 0,0:36:08.09,0:36:11.12,Default,تيراميسو,0,0,0,,نحن قلقون بشأن حالة الملكة.
Dialogue: 0,0:36:11.12,0:36:13.93,Default,تيراميسو,0,0,0,,لذلك نطلب منك أن تأخذ بعين الاعتبار
Dialogue: 0,0:36:13.93,0:36:16.23,Default,تيراميسو,0,0,0,,رسالتنا.
Dialogue: 0,0:36:16.23,0:36:17.80,Default,تيراميسو,0,0,0,,ما هذا؟
Dialogue: 0,0:36:17.80,0:36:20.73,Default,تيراميسو,0,0,0,,هل ناقشت الإطاحة بالملكة؟
Dialogue: 0,0:36:21.30,0:36:22.73,Default,تيراميسو,0,0,0,,-ماذا؟\N-ماذا؟
Dialogue: 0,0:36:22.73,0:36:26.64,Default,tiramisu,0,0,0,,الملكة لا تتوقف عن محاولة الانتحار،
Dialogue: 0,0:36:26.64,0:36:30.01,Default,تيراميسو,0,0,0,,ونحن بحاجة إلى تعزيز موقف الفناء.
Dialogue: 0,0:36:31.21,0:36:34.35,Default,تيراميسو,0,0,0,,فكر في خلع الملكة.
Dialogue: 0,0:36:34.88,0:36:39.25,Default,تيراميسو,0,0,0,,الملكة كذبت من أجل الحماية
Dialogue: 0,0:36:39.25,0:36:41.72,Default,تيراميسو,0,0,0,,محظية تشو.
Dialogue: 0,0:36:41.72,0:36:44.29,Default,تيراميسو,0,0,0,,بعد سقوطها في البحيرة فقدت عقلها.
Dialogue: 0,0:36:44.29,0:36:46.29,Default,تيراميسو,0,0,0,,تعتبر نفسها شخصًا آخر.
Dialogue: 0,0:36:46.29,0:36:48.63,Default,tiramisu,0,0,0,,وعند رؤية الماء يحاول الانتحار.
Dialogue: 0,0:36:48.63,0:36:50.63,Default,تيراميسو,0,0,0,,لقد انتشرت الشائعات بالفعل!
Dialogue: 0,0:36:50.63,0:36:52.80,Default,تيراميسو,0,0,0,,حسب الشائعات,
Dialogue: 0,0:36:52.80,0:36:54.77,Default,tiramisu,0,0,0,,ثم الكلمات التي قالتها المحظية تشو
Dialogue: 0,0:36:54.77,0:36:57.80,Default,تيراميسو,0,0,0,,دفعت الملكة، يجب أن يكون صحيحاً أيضاً.
Dialogue: 0,0:36:57.80,0:36:59.07,Default,تيراميسو,0,0,0,,ماذا؟
Dialogue: 0,0:36:59.07,0:37:01.21,Default,تيراميسو,0,0,0,,-كيف تجرؤ؟-أنت.
Dialogue: 0,0:37:01.41,0:37:03.47,Default,تيراميسو,0,0,0,,هادئ!
Dialogue: 0,0:37:04.58,0:37:08.98,Default,tiramisu,0,0,0,,سأرفض طلب مخالفة أمر التقديم.
Dialogue: 0,0:37:08.98,0:37:11.35,Default,تيراميسو,0,0,0,,يجب أن تذهب معه إلى سيونغجيونغ وون أولاً.
Dialogue: 0,0:37:11.35,0:37:14.42,Default,تيراميسو,0,0,0,,ومع ذلك، أنا مثل زوج الملكة
Dialogue: 0,0:37:14.42,0:37:16.69,Default,تيراميسو,0,0,0,,والشخص الأقرب إليها،
Dialogue: 0,0:37:17.69,0:37:20.66,Default,تيراميسو,0,0,0,,أقول أن عقلها بخير.
Dialogue: 0,0:37:22.33,0:37:24.96,Default,تيراميسو,0,0,0,,-ومع ذلك...\N-علينا أن نهدأ.
Dialogue: 0,0:37:24.96,0:37:28.73,Default,تيراميسو,0,0,0,,دعونا ننهي اجتماع اليوم.
Dialogue: 0,0:37:30.34,0:37:32.07,Default,تيراميسو,0,0,0,,أسمح بذلك.
Dialogue: 0,0:37:33.10,0:37:34.71,Default,تيراميسو,0,0,0,,جلالتك.
Dialogue: 0,0:37:38.51,0:37:40.31,Default,تيراميسو,0,0,0,,ما الذي جاء بك إلى هنا؟
Dialogue: 0,0:37:40.31,0:37:42.61,Default,تيراميسو,0,0,0,,سمعت أنك هنا.
Dialogue: 0,0:37:43.98,0:37:47.02,Default,تيراميسو,0,0,0,,هل سمعت الأخبار؟
Dialogue: 0,0:37:48.17,0:37:50.47,Default,تيراميسو,0,0,0,,الملك قادم!
Dialogue: 0,0:37:51.29,0:37:52.92,Default,تيراميسو,0,0,0,,ملكتي.
Dialogue: 0,0:37:56.06,0:37:57.33,Default,تيراميسو,0,0,0,,أنت هنا بالفعل.
Dialogue: 0,0:37:57.33,0:37:59.46,Default,تيراميسو,0,0,0,,فقط أنت متأخر هنا.
Dialogue: 0,0:37:59.46,0:38:01.67,Default,تيراميسو,0,0,0,,ظننت أن الأمر يبدو لي،
Dialogue: 0,0:38:01.67,0:38:03.07,Default,تيراميسو,0,0,0,,لكن رئيس قسم المباحث
Dialogue: 0,0:38:03.07,0:38:05.10,Default,تيراميسو,0,0,0,,حقاً لست سعيداً معي.
Dialogue: 0,0:38:05.97,0:38:07.01,Default,تيراميسو,0,0,0,,رئيس قسم المباحث؟
Dialogue: 0,0:38:07.01,0:38:10.41,Default,تيراميسو,0,0,0,,لقد أدرت ظهرك للملكة وأذلتها،
Dialogue: 0,0:38:10.41,0:38:13.41,Default,تيراميسو,0,0,0,,من أنقذ حبيبك.
Dialogue: 0,0:38:13.51,0:38:17.21,Default,تيراميسو,0,0,0,,أستطيع أن أتخيل كيف عاملت الملكة طوال هذا الوقت.
Dialogue: 0,0:38:17.58,0:38:20.22,Default,tiramisu,0,0,0,,ربما لهذا السبب حاولت الانتحار.
Dialogue: 0,0:38:22.65,0:38:24.39,Default,تيراميسو,0,0,0,,لا تنظر إلي.
Dialogue: 0,0:38:24.82,0:38:26.99,Default,تيراميسو,0,0,0,,الملكة في مأزق،
Dialogue: 0,0:38:26.99,0:38:29.43,Default,تيراميسو,0,0,0,,لأنني حاولت إنقاذ خليلتك.
Dialogue: 0,0:38:29.43,0:38:31.76,Default,تيراميسو,0,0,0,,-ماذا ستفعل؟\N-ماذا؟
Dialogue: 0,0:38:31.76,0:38:34.30,Default,تيراميسو,0,0,0,,سأساعدها في التعامل مع هذا.
Dialogue: 0,0:38:34.30,0:38:38.30,Default,تيراميسو,0,0,0,,كيف؟ ماذا يمكنك أن تفعل؟
Dialogue: 0,0:38:41.51,0:38:43.21,Default,تيراميسو,0,0,0,,أنت تسأل الآن
Dialogue: 0,0:38:43.21,0:38:45.68,Default,تيراميسو,0,0,0,,مثل شقيق الملكة
Dialogue: 0,0:38:45.68,0:38:48.28,Default,تيراميسو,0,0,0,,أو كالابن المتبنى لكيم جواجيون؟
Dialogue: 0,0:38:48.28,0:38:51.05,Default,تيراميسو,0,0,0,,ليس لديك القوة لحمايتها.
Dialogue: 0,0:38:51.05,0:38:53.72,Default,تيراميسو,0,0,0,,أنا أقول ما أرى.
Dialogue: 0,0:38:54.52,0:38:56.39,Default,تيراميسو,0,0,0,,لا توجد طاقة؟
Dialogue: 0,0:38:58.86,0:39:00.62,Default,تيراميسو,0,0,0,,هذا صحيح.
Dialogue: 0,0:39:01.23,0:39:05.30,Default,tiramisu,0,0,0,,ومع ذلك، لا أحتاج إلى القوة ضد الأقوياء.
Dialogue: 0,0:39:05.30,0:39:08.40,Default,تيراميسو,0,0,0,,هناك طريقة أكثر سلمية.
Dialogue: 0,0:39:08.50,0:39:11.40,Default,تيراميسو,0,0,0,,أنا فقط بحاجة إلى أن أكون مطيعة.
Dialogue: 0,0:39:11.40,0:39:13.70,Default,تيراميسو,0,0,0,,لحماية الملكة،
Dialogue: 0,0:39:14.44,0:39:16.67,Default,تيراميسو,0,0,0,,سأكون مطيعاً.
Dialogue: 0,0:39:16.91,0:39:18.88,Default,تيراميسو,0,0,0,,ليست هناك حاجة لهذا.
Dialogue: 0,0:39:18.88,0:39:21.61,Default,تيراميسو,0,0,0,,سأحمي الملكة بنفسي.
Dialogue: 0,0:39:23.98,0:39:27.02,Default,تيراميسو,0,0,0,,سأوقف الأقوياء بمزيد من القوة.
Dialogue: 0,0:39:35.83,0:39:37.30,Default,تيراميسو,0,0,0,,هنا.
Dialogue: 0,0:39:37.30,0:39:39.00,Default,تيراميسو,0,0,0,,ماذا يحدث هنا؟
Dialogue: 0,0:39:39.00,0:39:40.40,Default,تيراميسو,0,0,0,,أرى أن هذه هي مشكلتي.
Dialogue: 0,0:39:40.40,0:39:41.83,Default,تيراميسو,0,0,0,,لماذا عليك أن تتشاجر؟
Dialogue: 0,0:39:41.83,0:39:44.87,Default,تيراميسو,0,0,0,,ماذا حدث؟ ماذا هناك؟
Dialogue: 0,0:39:44.87,0:39:48.17,Default,tiramisu,0,0,0,,لقد تلقيت رسالة بشأن الإطاحة بك.
Dialogue: 0,0:39:49.47,0:39:52.54,Default,تيراميسو,0,0,0,,كيف ذلك؟ لقد قررت فقط أن أحب هذا المكان.
Dialogue: 0,0:39:52.54,0:39:53.75,Default,تيراميسو,0,0,0,,أرادوا القتل،
Dialogue: 0,0:39:53.75,0:39:55.95,Default,تيراميسو,0,0,0,,والآن الجميع متشوق للإطاحة.
Dialogue: 0,0:39:56.05,0:39:58.42,Default,تيراميسو,0,0,0,,أراد أحد ما الإطاحة بك؟
Dialogue: 0,0:39:58.88,0:40:01.35,Default,تيراميسو,0,0,0,,كانت الملكة الأرملة غاضبة مني.
Dialogue: 0,0:40:02.02,0:40:04.49,Default,تيراميسو,0,0,0,,سأتحدث معها.
Dialogue: 0,0:40:04.82,0:40:07.06,Default,tiramisu,0,0,0,,في الواقع، أعرف كيف أتعامل مع هذا.
Dialogue: 0,0:40:08.16,0:40:11.83,Default,tiramisu,0,0,0,,كيف يبدو أنك أصبت بنزلة برد أيضًا.
Dialogue: 0,0:40:16.17,0:40:17.90,Default,تيراميسو,0,0,0,,وأنت أيضاً؟
Dialogue: 0,0:40:19.00,0:40:20.84,Default,تيراميسو,0,0,0,,رغم أن الأمر عاجل،
Dialogue: 0,0:40:20.84,0:40:23.97,Default,تيراميسو,0,0,0,,عليك العودة والراحة.
Dialogue: 0,0:40:25.08,0:40:28.48,Default,تيراميسو,0,0,0,,إذا قلت كل ما تريده، يمكنك الذهاب.
Dialogue: 0,0:40:28.55,0:40:30.85,Default,تيراميسو,0,0,0,,نحن بحاجة لمناقشة الأمور الشخصية.
Dialogue: 0,0:40:31.08,0:40:34.49,Default,تيراميسو,0,0,0,,لدي شيء لأخبرك به، لذا سأنتظر.
Dialogue: 0,0:40:36.22,0:40:39.12,Default,تيراميسو,0,0,0,,-سأعود.\N-نعم.
Dialogue: 0,0:40:47.53,0:40:49.93,Default,تيراميسو,0,0,0,,أردت أن أنتظر إجابتك،
Dialogue: 0,0:40:49.93,0:40:51.90,Default,تيراميسو,0,0,0,,لكن ليس هناك وقت.
Dialogue: 0,0:40:51.94,0:40:55.61,Default,تيراميسو,0,0,0,,من الآن فصاعدا سأتبع قاعدة التباعد.
Dialogue: 0,0:40:55.61,0:40:57.78,Default,تيراميسو,0,0,0,,لماذا تتحدث عن هذا فجأة؟
Dialogue: 0,0:40:57.78,0:41:00.61,Default,tiramisu,0,0,0,,إذا كنت لا تريد ذلك، سأكون الشخص الذي سيتبعه.
Dialogue: 0,0:41:00.75,0:41:02.35,Default,تيراميسو,0,0,0,,المسافة.
Dialogue: 0,0:41:02.75,0:41:04.62,Default,تيراميسو,0,0,0,,لقد فهمت الأمر بشكل خاطئ.
Dialogue: 0,0:41:04.62,0:41:07.38,Default,تيراميسو,0,0,0,,-أعطني يدك.\N-لماذا؟
Dialogue: 0,0:41:07.92,0:41:09.69,Default,تيراميسو,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:41:24.10,0:41:25.90,Default,تيراميسو,0,0,0,,حياتي
Dialogue: 0,0:41:26.20,0:41:29.74,Default,تيراميسو,0,0,0,,كان دائماً في أيدي عائلتك.
Dialogue: 0,0:41:30.68,0:41:32.98,Default,تيراميسو,0,0,0,,يبدو أن هذا أعماني.
Dialogue: 0,0:41:34.21,0:41:38.38,Default,tiramisu,0,0,0,,ولم أستطع أن أرى أنك\N امرأة بريئة
Dialogue: 0,0:41:38.45,0:41:40.85,Default,تيراميسو,0,0,0,,يبذل قصارى جهده.
Dialogue: 0,0:41:42.09,0:41:44.15,Default,تيراميسو,0,0,0,,آسف لقد تأخرت جداً.
Dialogue: 0,0:41:45.19,0:41:47.76,Default,تيراميسو,0,0,0,,أعطني فرصة أخرى.
Dialogue: 0,0:41:48.89,0:41:51.03,Default,تيراميسو,0,0,0,,فرصة لفهمك
Dialogue: 0,0:41:51.23,0:41:55.63,Default,تيراميسو,0,0,0,,كفرد دون أي تحيزات.
Dialogue: 0,0:41:59.34,0:42:01.04,Default,تيراميسو,0,0,0,,لست بحاجة لفعل هذا.
Dialogue: 0,0:42:01.04,0:42:03.14,Default,تيراميسو,0,0,0,,أعلم أنك لا تحب التباهي.
Dialogue: 0,0:42:03.21,0:42:06.78,Default,تيراميسو,0,0,0,,ولكن يجب أن أعتذر بصدق مرة واحدة على الأقل.
Dialogue: 0,0:42:06.78,0:42:07.98,Default,تيراميسو,0,0,0,,افعل ما يحلو لك.
Dialogue: 0,0:42:07.98,0:42:09.98,Default,تيراميسو,0,0,0,,حسنًا. هذا ما سنفعله. التباعد.
Dialogue: 0,0:42:09.98,0:42:12.15,Default,تيراميسو,0,0,0,,ليس لدي ما أخسره.
Dialogue: 0,0:42:15.59,0:42:19.06,Default,تيراميسو,0,0,0,,اليوم هو يومنا الأول.
Dialogue: 0,0:42:19.36,0:42:20.39,Default,تيراميسو,0,0,0,,ماذا؟
Dialogue: 0,0:42:20.39,0:42:22.69,Default,تيراميسو,0,0,0,,أول يوم في التباعد.
Dialogue: 0,0:42:23.13,0:42:25.43,Default,تيراميسو,0,0,0,,لا تقل ذلك.
Dialogue: 0,0:42:25.43,0:42:28.27,Default,تيراميسو,0,0,0,,-لماذا؟\N-فقط لا تقل ذلك. لا تجرؤ.
Dialogue: 0,0:42:28.47,0:42:30.57,Default,تيراميسو,0,0,0,,ما الخطأ الذي قلته؟
Dialogue: 0,0:42:30.57,0:42:31.84,Default,تيراميسو,0,0,0,,اليوم هو يومنا الأول.
Dialogue: 0,0:42:31.84,0:42:34.74,Default,تيراميسو,0,0,0,,الخاص بك. قالت لي ألا أتحدث!
Dialogue: 0,0:42:35.81,0:42:38.21,Default,تيراميسو,0,0,0,,لكنني قلت للتو، اليوم...
Dialogue: 0,0:42:38.21,0:42:40.44,Default,تيراميسو,0,0,0,,توقف!
Dialogue: 0,0:42:40.98,0:42:43.28,Default,تيراميسو,0,0,0,,أراهن أنك تعرف ماذا يعني ذلك، أليس كذلك؟
Dialogue: 0,0:42:43.28,0:42:45.32,Default,تيراميسو,0,0,0,,ولكن اليوم هو الأول...
Dialogue: 0,0:42:45.32,0:42:47.52,Default,تيراميسو,0,0,0,,أوقفه. كيف مثير للاشمئزاز!
Dialogue: 0,0:42:47.52,0:42:48.85,Default,تيراميسو,0,0,0,,-ولكن هذا هو يومنا الأول.\N-توقف بالفعل.
Dialogue: 0,0:42:48.85,0:42:50.92,Default,تيراميسو,0,0,0,,-لدينا...\N-أوقفه.
Dialogue: 0,0:42:52.29,0:42:54.96,Default,tiramisu,0,0,0,,إذًا، بما أننا حللنا هذا الأمر،
Dialogue: 0,0:42:55.23,0:42:58.00,Default,تيراميسو,0,0,0,,سأفعل كل شيء لحمايتك.
Dialogue: 0,0:42:58.00,0:43:00.67,Default,تيراميسو,0,0,0,,أوه، بالضبط. ليس هناك وقت للخمول.
Dialogue: 0,0:43:00.67,0:43:02.40,Default,تيراميسو,0,0,0,,إلى اللقاء.
Dialogue: 0,0:43:03.03,0:43:05.84,Default,تيراميسو,0,0,0,,توقف. لا تركض هكذا. لا تركض.
Dialogue: 0,0:43:07.07,0:43:08.77,Default,تيراميسو,0,0,0,,يمكن أن تتأذى.
Dialogue: 0,0:43:22.55,0:43:24.36,Default,zinger,0,0,0,,تكلم.
Dialogue: 0,0:43:24.36,0:43:28.73,Default,zinger,0,0,0,,إذا كانت الملكة غير سعيدة، فستكونين كذلك.
Dialogue: 0,0:43:28.96,0:43:31.93,Default,zinger,0,0,0,,-هل هذا تهديد؟\N-فقط ما يقلقني.
Dialogue: 0,0:43:33.20,0:43:37.80,Default,zinger,0,0,0,,أنت مجرد شقيقها، لكنك شديد الحماية.
Dialogue: 0,0:43:37.80,0:43:40.80,Default,zinger,0,0,0,,أنت غير مبالٍ للغاية يا صاحب الجلالة.
Dialogue: 0,0:43:41.31,0:43:44.24,Default,zinger,0,0,0,,أعلم أنني لا أملك الكثير من القوة،
Dialogue: 0,0:43:44.31,0:43:46.51,Default,zinger,0,0,0,,ولكن يجب مراعاة بعض اللياقة.
Dialogue: 0,0:43:46.51,0:43:49.15,Default,zinger,0,0,0,,إذا تجاوزت الخط مرة أخرى،
Dialogue: 0,0:43:49.15,0:43:52.15,Default,singer,0,0,0,,سأثير مسألة سلوكك.
Dialogue: 0,0:43:53.32,0:43:55.45,Default,زنجر,0,0,0,,هيا.
Dialogue: 0,0:43:57.36,0:43:59.52,Default,zinger,0,0,0,,سأجعلك تكتب
Dialogue: 0,0:44:00.86,0:44:03.43,Default,زنجر,0,0,0,,رسالة اعتذار طويلة جداً.
Dialogue: 0,0:44:05.56,0:44:08.33,Default,zinger,0,0,0,,فقط طويل.
Dialogue: 0,0:44:08.83,0:44:11.30,Default,zinger,0,0,0,,قد تضطر إلى البقاء مستيقظًا طوال الليل.
Dialogue: 0,0:44:12.10,0:44:14.47,Default,zinger,0,0,0,,وسوف تؤلمك أصابعك.
Dialogue: 0,0:44:28.59,0:44:31.52,Default,zinger,0,0,0,,هل يعتقدون حقاً أنه يمكن خلعها؟
Dialogue: 0,0:44:31.52,0:44:33.09,Default,zinger,0,0,0,,بسبب طلب بسيط؟
Dialogue: 0,0:44:33.09,0:44:36.63,Default,zinger,0,0,0,,إنهم يحاولون تجميع القوة بهذا.
Dialogue: 0,0:44:37.26,0:44:39.73,Default,zinger,0,0,0,,سوف يجمعون أولئك الذين لا يحبون نوعنا،
Dialogue: 0,0:44:39.73,0:44:42.53,Default,zinger,0,0,0,,وسوف يزيد عدد الطلبات. كل شيء واضح.
Dialogue: 0,0:44:42.53,0:44:46.40,Default,zinger,0,0,0,,كيف يجرؤون على القيام بهذه الخطوة المتهورّة إلى هذا الحد؟
Dialogue: 0,0:44:46.40,0:44:48.74,Default,zinger,0,0,0,,كان يجب أن نمر بهذا مرة واحدة على الأقل.
Dialogue: 0,0:44:48.74,0:44:50.84,Default,zinger,0,0,0,,جلالتك,
Dialogue: 0,0:44:50.84,0:44:53.54,Default,zinger,0,0,0,,لقد وصلت الملكة.
Dialogue: 0,0:44:54.98,0:44:56.71,Default,zinger,0,0,0,,دعني أدخل.
Dialogue: 0,0:45:16.17,0:45:20.60,Default,zinger,0,0,0,,أعتذر بشدة عن إزعاجك.
Dialogue: 0,0:45:22.71,0:45:26.58,Default,zinger,0,0,0,,أنا أستحق أن أُجرد من لقبي.
Dialogue: 0,0:45:27.48,0:45:29.78,Default,zinger,0,0,0,,ولكن حتى لو كان الأمر كذلك،
Dialogue: 0,0:45:29.91,0:45:32.65,Default,zinger,0,0,0,,يجب على الملكة الأرملة أن تفعل هذا.
Dialogue: 0,0:45:32.65,0:45:37.29,Default,zinger,0,0,0,,من الخطأ أن يفعل هذا أحد أفراد عائلة تشو.
Dialogue: 0,0:45:38.99,0:45:41.29,Default,zinger,0,0,0,,بغض النظر عن نوع الأحمق الذي أنت عليه، فلن يتسامح معك أحد،
Dialogue: 0,0:45:41.29,0:45:43.89,Default,zinger,0,0,0,,حتى يتمكن مرؤوسوه\Nمن إدارة شخص آخر.
Dialogue: 0,0:45:43.90,0:45:45.66,Default,zinger,0,0,0,,إنها مسألة فخر.
Dialogue: 0,0:45:45.66,0:45:48.53,Default,zinger,0,0,0,,إذا حرمني أحد من عائلة "تشو" من لقبي،
Dialogue: 0,0:45:48.53,0:45:50.84,Default,زنجر,0,0,0,,لن تكون هزيمتي،
Dialogue: 0,0:45:50.84,0:45:53.54,Default,zinger,0,0,0,,ستكون هذه هزيمة لعائلة كيم.
Dialogue: 0,0:45:54.41,0:45:56.41,Default,مغني,0,0,0,,إذا فهمت هذا،
Dialogue: 0,0:45:56.41,0:45:58.38,Default,مغنية,0,0,0,,كيف يمكنها أن تفعل ما يجب أن تكون مسؤولة عنه؟
Dialogue: 0,0:45:58.38,0:46:00.61,Default,zinger,0,0,0,,إنهم يعتمدون على الشائعات.
Dialogue: 0,0:46:00.61,0:46:02.08,Default,zinger,0,0,0,,سأعتني بالأمر.
Dialogue: 0,0:46:02.08,0:46:03.11,Default,zinger,0,0,0,,وكيف؟
Dialogue: 0,0:46:03.11,0:46:04.65,Default,مغني,0,0,0,,الأزمة هي فرصتنا.
Dialogue: 0,0:46:04.65,0:46:07.25,Default,zinger,0,0,0,,إذا أعطيتني بعض الوقت،\NIسوف أستخدمه،
Dialogue: 0,0:46:07.25,0:46:10.32,Default,zinger,0,0,0,,لتغيير سمعتك.
Dialogue: 0,0:46:20.23,0:46:22.83,Default,zinger,0,0,0,,اليوم وقف الملك إلى جانبك،
Dialogue: 0,0:46:22.83,0:46:25.70,Default,zinger,0,0,0,,عندما تلقيت الشكوى.
Dialogue: 0,0:46:26.64,0:46:28.67,Default,zinger,0,0,0,,الأحمق تشيولجونغ؟
Dialogue: 0,0:46:29.57,0:46:31.64,Default,zinger,0,0,0,,ما فعلته الملكة،
Dialogue: 0,0:46:31.64,0:46:34.65,Default,zinger,0,0,0,,ليس عبثاً.
Dialogue: 0,0:46:37.55,0:46:41.42,Default,zinger,0,0,0,,يجب أن ألقن الملكة الأم درساً.
Dialogue: 0,0:46:41.95,0:46:44.96,Default,zinger,0,0,0,,سأظهر لها من هو الرئيس في هذا القصر.
Dialogue: 0,0:46:50.96,0:46:53.00,Default,zinger,0,0,0,,هل هؤلاء كل حاملي المِحفّة؟
Dialogue: 0,0:46:53.83,0:46:54.83,Default,زنجر,0,0,0,,فقط...
Dialogue: 0,0:46:54.83,0:46:56.63,Default,zinger,0,0,0,,اختر مرة أخرى. تأكد من أنها مضحكة.
Dialogue: 0,0:46:56.63,0:46:58.90,Default,zinger,0,0,0,,نعم يا صاحب الجلالة. مضحك.
Dialogue: 0,0:46:59.57,0:47:01.21,Default,zinger,0,0,0,,ماذا؟
Dialogue: 0,0:47:03.81,0:47:06.21,Default,zinger,0,0,0,,ليكونوا طوال القامة وذوي شخصية جيدة.
Dialogue: 0,0:47:06.21,0:47:08.18,Default,zinger,0,0,0,,الجذع واضح، والشباب.
Dialogue: 0,0:47:11.25,0:47:14.59,Default,zinger,0,0,0,,هل تختار الحمالين حقاً؟
Dialogue: 0,0:47:14.79,0:47:17.79,Default,zinger,0,0,0,,أنا لا أختار فقط حاملي المحفّة.
Dialogue: 0,0:47:18.06,0:47:20.06,Default,zinger,0,0,0,,سوف تندهش عندما تفهم.
Dialogue: 0,0:47:21.73,0:47:24.19,Default,زنجر,0,0,0,,اخترت...
Dialogue: 0,0:47:32.64,0:47:35.74,Default,zinger,0,0,0,, - بالمناسبة. هل سمعت القيل والقال؟\N-What؟
Dialogue: 0,0:47:35.74,0:47:38.34,Default,zinger,0,0,0,,لم تحاول الملكة قتل نفسها.
Dialogue: 0,0:47:38.34,0:47:40.94,Default,zinger,0,0,0,,أرادت إنقاذ الملك وخليلته.
Dialogue: 0,0:47:43.21,0:47:45.38,Default,zinger,0,0,0,,أردت إنقاذ الملك وسريته،
Dialogue: 0,0:47:45.38,0:47:47.72,Default,zinger,0,0,0,,لهذا كذبت وقالت إنه انتحار.
Dialogue: 0,0:47:47.72,0:47:49.15,Default,zinger,0,0,0,,حار!
Dialogue: 0,0:47:49.15,0:47:50.89,Default,zinger,0,0,0,,-العائلة...\N-أو الزوج.
Dialogue: 0,0:47:50.89,0:47:52.62,Default,zinger,0,0,0,,-هذا هو...\N-السؤال.
Dialogue: 0,0:47:52.62,0:47:56.16,Default,zinger,0,0,0,,وفي النهاية فقدت ثقة الملكة الأرملة.
Dialogue: 0,0:47:56.16,0:47:59.26,Default,zinger,0,0,0,,وتضع سكيناً فضياً على رقبتها وتقول:
Dialogue: 0,0:47:59.26,0:48:02.03,Default,zinger,0,0,0,,"سوف أهرب من هذا المصير المؤسف،"
Dialogue: 0,0:48:02.03,0:48:04.17,Default,zinger,0,0,0,,حيث لا أستطيع اختيار جانب."
Dialogue: 0,0:48:05.47,0:48:07.51,Default,مغنية,0,0,0,,هذا ما قالته.
Dialogue: 0,0:48:07.51,0:48:09.54,Default,zinger,0,0,0,,كانت ساحرة.
Dialogue: 0,0:48:09.54,0:48:12.91,Default,zinger,0,0,0,,هناك شائعات بأنها ذهبت إلى الجنة.
Dialogue: 0,0:48:13.64,0:48:15.71,Default,zinger,0,0,0,,لأنك سقطت في البحيرة؟
Dialogue: 0,0:48:15.85,0:48:19.92,Default,zinger,0,0,0,,وعندما التقيت بالإمبراطور اليشم، تحولت إلى جنية.
Dialogue: 0,0:48:27.02,0:48:29.09,Default,zinger,0,0,0,,ممتاز.
Dialogue: 0,0:48:29.09,0:48:31.63,Default,zinger,0,0,0,,أنا لا أختار الحمالين فقط،
Dialogue: 0,0:48:31.63,0:48:33.10,Default,zinger,0,0,0,,اخترت رواة القصص.
Dialogue: 0,0:48:33.10,0:48:37.30,Default,singer,0,0,0,,صحف شعبية مباشرة ستنشر الشائعات كالعدوى.
Dialogue: 0,0:48:37.74,0:48:39.04,Default,زنجر,0,0,0,,ماذا؟
Dialogue: 0,0:48:39.04,0:48:42.34,Default,zinger,0,0,0,,عندما تبدأ الشائعات بالانتشار،\N تتحول إلى عدوى.
Dialogue: 0,0:48:42.34,0:48:45.51,Default,zinger,0,0,0,,إنهم يتناثرون كثيراً حتى أن الشخص الذي بدأ كل شيء غير قادر على إيقافه.
Dialogue: 0,0:48:45.51,0:48:48.55,Default,zinger,0,0,0,,وانتشروا بطريقة غير متوقعة.
Dialogue: 0,0:48:48.55,0:48:50.48,Default,zinger,0,0,0,,إذا لم تحاول الانتحار،
Dialogue: 0,0:48:50.48,0:48:54.08,Default,zinger,0,0,0,,فالذي دفعها إلى البحيرة...
Dialogue: 0,0:48:55.15,0:48:58.16,Default,zinger,0,0,0,,أي أن الملكة خاطرت بحياتها من أجل
Dialogue: 0,0:48:58.16,0:49:00.52,Default,zinger,0,0,0,,أنقذ المحظية التي حاولت قتلها؟
Dialogue: 0,0:49:01.73,0:49:03.59,Default,zinger,0,0,0,,أيها الأمهات.
Dialogue: 0,0:49:07.97,0:49:10.10,Default,zinger,0,0,0,,بطريقة ما شعرت بقشعريرة.
Dialogue: 0,0:49:11.34,0:49:13.97,Default,zinger,0,0,0,,حان وقت الراحة.
Dialogue: 0,0:49:14.21,0:49:16.21,Default,zinger,0,0,0,,هذا لن ينجح. سأحملك إذا اضطررت لذلك.
Dialogue: 0,0:49:16.21,0:49:18.88,Default,زنجر,0,0,0,,هيا. حسنا، حسنا.
Dialogue: 0,0:49:18.88,0:49:22.01,Default,zinger,0,0,0,,سيدة البلاط تشوي لا تتذمر مني، والآن أنت.
Dialogue: 0,0:49:22.01,0:49:24.58,Default,singer,0,0,0,,نوع من قانون الحفاظ على التذمر، أم ماذا؟
Dialogue: 0,0:49:25.78,0:49:29.32,Default,zinger,0,0,0,,بالمناسبة، لم أرها منذ وقت طويل.
Dialogue: 0,0:49:29.39,0:49:31.52,Default,zinger,0,0,0,,يا له من غبي.
Dialogue: 0,0:49:33.02,0:49:35.86,Default,zinger,0,0,0,,هل يمكنك أن تعطيني عناقاً كبيراً؟ بارد.
Dialogue: 0,0:50:12.00,0:50:15.73,Default,zinger,0,0,0,,جلالتك!
Dialogue: 0,0:50:15.73,0:50:18.34,Default,zinger,0,0,0,,كيف يمكن أن تؤذي نفسك؟
Dialogue: 0,0:50:18.34,0:50:21.77,Default,zinger,0,0,0,,هل تريدني أن أصاب بالجنون؟
Dialogue: 0,0:50:21.77,0:50:25.28,Default,zinger,0,0,0,,كيف يمكنك ترتيب السباحة مع الملك؟
Dialogue: 0,0:50:25.28,0:50:28.41,Default,zinger,0,0,0,,هل تريد أن تضع البلاد في موقف خطير؟
Dialogue: 0,0:50:28.41,0:50:30.48,Default,زنجر,0,0,0,,طلسمان؟ شعيرة؟
Dialogue: 0,0:50:30.48,0:50:33.92,Default,zinger,0,0,0,,يجب ألا تتورط في مثل هذه الأحكام المسبقة.
Dialogue: 0,0:50:33.92,0:50:37.82,Default,zinger,0,0,0,,ولا يمكنك قول ذلك أيضًا.
Dialogue: 0,0:50:37.82,0:50:40.76,Default,zinger,0,0,0,,من الأول إلى الأخير،
Dialogue: 0,0:50:40.76,0:50:45.73,Default,zinger,0,0,0,,لا شيء من هذا مسموح به!
Dialogue: 0,0:50:56.11,0:51:00.81,Default,zinger,0,0,0,,بطريقة ما لم أشعر بأي تحسن بعد ذلك.
Dialogue: 0,0:51:00.81,0:51:04.78,Default,zinger,0,0,0,,إذا تذمرت منها، ستكون صاحبة الجلالة مضطربة.
Dialogue: 0,0:51:05.45,0:51:09.75,Default,zinger,0,0,0,,إذا لم أفعل ذلك، فأنا قلق.
Dialogue: 0,0:51:10.32,0:51:15.29,Default,zinger,0,0,0,,فماذا علي أن أفعل؟
Dialogue: 0,0:51:21.60,0:51:27.00,Default,zinger,0,0,0,,جلالتك!
Dialogue: 0,0:51:27.14,0:51:30.04,Default,zinger,0,0,0,,- هل سمعت الشائعات؟ \N-ماذا؟
Dialogue: 0,0:51:30.04,0:51:32.44,Default,zinger,0,0,0,,هذا كل ما يتهامسون عنه في القصر.
Dialogue: 0,0:51:32.44,0:51:35.25,Default,zinger,0,0,0,,يقولون أن الملكة خاطرت بحياتها،
Dialogue: 0,0:51:35.25,0:51:37.58,Default,zinger,0,0,0,,لإنقاذك الذي حاول قتلها.
Dialogue: 0,0:51:37.72,0:51:39.62,Default,zinger,0,0,0,,من يستطيع أن يقول ذلك؟
Dialogue: 0,0:51:40.18,0:51:42.22,Default,zinger,0,0,0,,وليست الملكة؟
Dialogue: 0,0:51:42.35,0:51:44.89,Default,zinger,0,0,0,,تغيرت بسبب شائعات بأنها ساحرة محلية،
Dialogue: 0,0:51:44.89,0:51:47.22,Default,zinger,0,0,0,,إنها بوذا، جنية، امرأة فاضلة.
Dialogue: 0,0:51:47.22,0:51:50.36,Default,zinger,0,0,0,,لقد تمكنت من تغيير مزاج الجميع.
Dialogue: 0,0:51:51.80,0:51:56.17,Default,zinger,0,0,0,,الآن سوف يشتمونك ويقولون إنك غير أخلاقي.
Dialogue: 0,0:51:57.57,0:52:00.70,Default,zinger,0,0,0,,كانت لديها هذه الخطة منذ البداية.
Dialogue: 0,0:52:00.70,0:52:04.18,Default,zinger,0,0,0,,جاءت إلي في قاعة سونونجونج وهددتني.
Dialogue: 0,0:52:04.18,0:52:06.01,Default,zinger,0,0,0,,لهذا السبب.
Dialogue: 0,0:52:07.38,0:52:09.98,Default,zinger,0,0,0,,سأذهب إلى الملك وأخبره،
Dialogue: 0,0:52:09.98,0:52:13.42,Default,zinger,0,0,0,,حتى لا تتمكن الملكة من خداعه بعد الآن.
Dialogue: 0,0:52:13.82,0:52:15.55,Default,zinger,0,0,0,,لست متأكداً.
Dialogue: 0,0:52:16.15,0:52:20.12,Default,zinger,0,0,0,,هل سيصدق كلامك؟
Dialogue: 0,0:52:20.36,0:52:23.46,Default,zinger,0,0,0,,سوف يصدق الملك ما سأقوله له.
Dialogue: 0,0:52:23.46,0:52:27.70,Default,zinger,0,0,0,,رفض طلب عزل الملكة.
Dialogue: 0,0:52:33.07,0:52:35.81,Default,zinger,0,0,0,,لقد وصلت المحظية الملكية.
Dialogue: 0,0:52:40.34,0:52:42.01,Default,zinger,0,0,0,,هواجين.
Dialogue: 0,0:52:43.45,0:52:47.35,Default,zinger,0,0,0,,كنت على وشك رؤيتك،\Nنحن بحاجة إلى التحدث عن شيء ما.
Dialogue: 0,0:52:47.95,0:52:50.45,Default,zinger,0,0,0,,عن ماذا؟
Dialogue: 0,0:52:50.45,0:52:52.62,Default,زنجر,0,0,0,,اليوم في المجلس
Dialogue: 0,0:52:52.62,0:52:55.89,Default,zinger,0,0,0,,لقد تلقيت التماساً لخلع الملكة.
Dialogue: 0,0:52:57.06,0:52:58.46,Default,zinger,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:52:58.46,0:53:01.63,Default,zinger,0,0,0,,الملكة تعرض نفسها للخطر لإنقاذنا،
Dialogue: 0,0:53:01.63,0:53:04.37,Default,zinger,0,0,0,,اعتقدت أنه من الخطأ البقاء بعيداً.
Dialogue: 0,0:53:04.60,0:53:09.24,Default,zinger,0,0,0,,لذا أريد أن أطلب من الأمانة الملكية أن تتذكره.
Dialogue: 0,0:53:09.27,0:53:11.04,Default,zinger,0,0,0,,هل تمانع؟
Dialogue: 0,0:53:11.48,0:53:14.11,Default,zinger,0,0,0,,هل تريدني أن أسأل والدي؟
Dialogue: 0,0:53:14.11,0:53:18.35,Default,zinger,0,0,0,,إنه محترم جداً، ويتبعه الكثيرون.
Dialogue: 0,0:53:21.39,0:53:23.49,Default,Tol,0,0,0,,أم أن طلبي معقد للغاية؟
Dialogue: 0,0:53:26.72,0:53:28.06,Default,فقط,0,0,0,,إطلاقاً.
Dialogue: 0,0:53:28.06,0:53:31.70,Default,Tol,0,0,0,,سأبلغ والدي بنفسي.
Dialogue: 0,0:53:32.26,0:53:33.46,Default,Tol,0,0,0,,شكرًا لك.
Dialogue: 0,0:53:33.46,0:53:35.13,Default,Tol,0,0,0,,جلالتك.
Dialogue: 0,0:53:35.13,0:53:39.04,Default,Tol,0,0,0,,عندما جئت إلى هنا، أردت دائمًا شيئًا واحدًا فقط.
Dialogue: 0,0:53:39.27,0:53:42.21,Default,Toly,0,0,0,,لأكون سندك كما في لقائنا الأول.
Dialogue: 0,0:53:42.21,0:53:44.67,Default,Tol,0,0,0,,حتى تتمكن من ذلك بجواري
Dialogue: 0,0:53:44.98,0:53:48.01,Default,Tol,0,0,0,,انس كل مخاوفك.
Dialogue: 0,0:53:49.61,0:53:52.72,Default,Toly,0,0,0,,أنت بالفعل مصدر عزاء كبير لي.
Dialogue: 0,0:53:52.98,0:53:56.12,Default,Tol,0,0,0,,ومع ذلك، مازلنا
Dialogue: 0,0:53:56.82,0:53:59.49,Default,Toly,0,0,0,,لم نقضي ليلة واحدة معًا.
Dialogue: 0,0:54:04.26,0:54:06.63,Default,Toly,0,0,0,,كان خطأي أنك شعرت بالوحدة.
Dialogue: 0,0:54:06.96,0:54:09.13,Default,Tol,0,0,0,,أنا أفهم كل شيء، لقد كنت مشغولاً.
Dialogue: 0,0:54:09.13,0:54:11.27,Default,Tolya,0,0,0,,لقد ضللني الشيطان.
Dialogue: 0,0:54:11.80,0:54:13.94,Default,Toly,0,0,0,,انتظرني في غرفتك هذه الليلة.
Dialogue: 0,0:54:14.57,0:54:17.34,Default,Tol,0,0,0,,لكن ليلة الغد كان من المفترض أن تفعل ذلك
Dialogue: 0,0:54:17.34,0:54:19.31,Default,Tol,0,0,0,,اقضي مع صاحبة الجلالة.
Dialogue: 0,0:54:19.68,0:54:21.85,Default,Tol,0,0,0,,هذا ليس من شأنك.
Dialogue: 0,0:54:22.55,0:54:24.98,Default,Tol,0,0,0,,ثم سأزور الملكة وأفرحها قليلاً.
Dialogue: 0,0:54:24.98,0:54:27.12,Default,Tol,0,0,0,,وبعد ذلك سأجلس على الفور لأكتب إلى والدي.
Dialogue: 0,0:54:27.12,0:54:29.05,Default,Tol,0,0,0,,سيكون ذلك جميلاً.
Dialogue: 0,0:54:37.23,0:54:39.53,Default,Tol,0,0,0,,جاءت المحظية "تشو" لزيارة صاحبة الجلالة.
Dialogue: 0,0:54:39.53,0:54:41.70,Default,Tol,0,0,0,,أعتذر، صاحبة الجلالة لم تكن على ما يرام،
Dialogue: 0,0:54:41.70,0:54:43.80,Default,Tol,0,0,0,,فشربت مغلياً طبياً
Dialogue: 0,0:54:43.80,0:54:46.07,Default,Tol,0,0,0,,ونمت.
Dialogue: 0,0:54:46.70,0:54:48.37,Default,Tol,0,0,0,,مزعج.
Dialogue: 0,0:54:48.41,0:54:50.14,Default,Tol,0,0,0,,حسناً، سأأتي مرة أخرى.
Dialogue: 0,0:55:02.89,0:55:04.55,Default,Tolya,0,0,0,,هل أتيت؟
Dialogue: 0,0:55:05.92,0:55:08.69,Default,Tol,0,0,0,,كنت نائماً كالطفل...
Dialogue: 0,0:55:14.10,0:55:16.87,Default,Tol,0,0,0,,وقالوا لي أنك لست على ما يرام.
Dialogue: 0,0:55:19.17,0:55:21.81,Default,Tol,0,0,0,,لا أستطيع التباهي بأنني بخير بعد،
Dialogue: 0,0:55:22.81,0:55:25.94,Default,Tol,0,0,0,,ومع ذلك، فأنا لست نادماً على أي شيء. كانت جوسون بحاجة إلى بطل.
Dialogue: 0,0:55:26.61,0:55:29.48,Default,Tol,0,0,0,, -البطل؟ \N-لماذا نحن نقف عند الباب؟
Dialogue: 0,0:55:29.48,0:55:31.35,Default,Tol,0,0,0,, تفضل بالدخول.
Dialogue: 0,0:55:40.76,0:55:42.29,Default,Tol,0,0,0,,اتركونا وشأننا حتى...
Dialogue: 0,0:55:42.29,0:55:45.70,Default,Only,0,0,0,,حتى نتمكن من التحدث في جو هادئ.
Dialogue: 0,0:56:00.74,0:56:02.65,Default,Tol,0,0,0,,اشعر بالراحة.
Dialogue: 0,0:56:13.32,0:56:15.59,Default,Tolya,0,0,0,,لماذا تجلس بعيدًا؟
Dialogue: 0,0:56:16.16,0:56:18.66,Default,Tolya,0,0,0,,كما لو لم يكن أصليًا.
Dialogue: 0,0:56:19.06,0:56:20.90,Default,Tolya,0,0,0,,يجب أن تقترب أكثر.
Dialogue: 0,0:56:20.90,0:56:22.63,Default,Tol,0,0,0,,أشعر أنني بحالة جيدة هنا أيضًا.
Dialogue: 0,0:56:24.03,0:56:27.87,Default,Tol,0,0,0,,ثم سأجلس أقرب.
Dialogue: 0,0:56:27.87,0:56:30.14,Default,Tol,0,0,0,,ظهرت كأمير على حصان أبيض وأنقذتها.
Dialogue: 0,0:56:30.14,0:56:33.28,Default,Tolya,0,0,0,,أخيرًا، نظرتها القاسية\N ستمتلئ بالحب والعشق.
Dialogue: 0,0:56:36.41,0:56:38.21,Default,Tol,0,0,0,,ماذا؟ لكن لماذا؟
Dialogue: 0,0:56:38.88,0:56:40.15,Default,Toly,0,0,0,,لقد تغيرت وجهة نظرك.
Dialogue: 0,0:56:40.15,0:56:43.42,Default,Tol,0,0,0,,ولكن لماذا أصبح أكثر برودة من ذي قبل؟
Dialogue: 0,0:56:43.89,0:56:46.69,Default,Tol,0,0,0,,سأطلب من والدي أن يستلم العريضة.
Dialogue: 0,0:56:47.42,0:56:50.93,Default,Tol,0,0,0,,لذلك سنكون متساويين.
Dialogue: 0,0:56:52.33,0:56:54.06,Default,Tol,0,0,0,,شكرًا لك.
Dialogue: 0,0:56:54.06,0:56:58.47,Default,Tol,0,0,0,,ربما تعتقد أن كل شيء يسير في طريقك.
Dialogue: 0,0:56:59.04,0:57:00.64,Default,Tol,0,0,0,,ما أنت، لا على الإطلاق.
Dialogue: 0,0:57:00.64,0:57:02.71,Default,Tol,0,0,0,,لا أعتقد أن أي شيء يعمل هنا على الإطلاق.
Dialogue: 0,0:57:02.71,0:57:04.88,Default,Tol,0,0,0,,قررنا إعادة الموقع بهذه الطريقة
Dialogue: 0,0:57:04.88,0:57:06.84,Default,Tol,0,0,0,,جلالة الملك بعد كل أكاذيبك؟
Dialogue: 0,0:57:06.84,0:57:08.58,Default,Tol,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:57:08.58,0:57:12.05,Default,Tol,0,0,0,,بالطبع أنا لست من الأكثر صدقاً،\N ولكني لا أنحدر إلى الكذب.
Dialogue: 0,0:57:12.38,0:57:14.62,Default,Toly,0,0,0,,كنت أعلم أنك ستجعل نفسك تبدو كالحمقى.
Dialogue: 0,0:57:14.62,0:57:17.19,Default,Tol,0,0,0,,ماذا؟ أنا لا أبني أي شيء.
Dialogue: 0,0:57:19.76,0:57:21.79,Default,Tol,0,0,0,,لقد كررتها بالفعل عدة مرات.
Dialogue: 0,0:57:21.79,0:57:25.50,Default,Tol,0,0,0,,الملك لا يثير اهتمامي على الإطلاق.
Dialogue: 0,0:57:26.56,0:57:28.23,Default,Tol,0,0,0,,حسنًا.
Dialogue: 0,0:57:28.47,0:57:31.27,Default,Tol,0,0,0,,هذه المرة سأصدق.
Dialogue: 0,0:57:32.84,0:57:35.71,Default,Toly,0,0,0,,ربما يمكنك البقاء في الليل\Nلتقترب أكثر؟
Dialogue: 0,0:57:35.71,0:57:37.14,Default,Toly,0,0,0,,سنقيم حفلة بيجامة.
Dialogue: 0,0:57:37.14,0:57:40.18,Default,Toly,0,0,0,,أي حفلة بالملابس الداخلية.
Dialogue: 0,0:57:40.18,0:57:44.31,Default,Tol,0,0,0,,سأقضي هذه الليلة مع جلالته.
Dialogue: 0,0:57:45.42,0:57:47.05,Default,Tol,0,0,0,,كيف ذلك؟!
Dialogue: 0,0:57:47.55,0:57:49.35,Default,Tol,0,0,0,,وهكذا تحطم قلبك،
Dialogue: 0,0:57:49.62,0:57:52.49,Default,Tolya,0,0,0,,إذن أتيت أيضًا لتخبرني بهذا شخصيًا؟
Dialogue: 0,0:57:52.49,0:57:55.96,Default,Tolya,0,0,0,,هل هكذا على الفور؟ بلا قلب؟
Dialogue: 0,0:57:56.69,0:57:59.86,Default,Tol,0,0,0,,بطريقة ما أنت منزعج بشكل مؤلم لشخص ليس مهتماً بالملك.
Dialogue: 0,0:57:59.86,0:58:01.43,Default,Tol,0,0,0,,لست مهتماً به.
Dialogue: 0,0:58:01.43,0:58:04.17,Default,Toly,0,0,0,,لكنني لم أقل شيئاً عنك.
Dialogue: 0,0:58:04.30,0:58:07.40,Default,Tol,0,0,0,,فأثبت أن محبتك لي صادقة.
Dialogue: 0,0:58:07.40,0:58:11.34,Default,Tol,0,0,0,,إذا تباينت أفعالك مرة أخرى مع أقوالك،
Dialogue: 0,0:58:12.51,0:58:15.48,Default,تولي,0,0,0,,لوم نفسك. لن تجد ما يكفي.
Dialogue: 0,0:58:17.92,0:58:21.32,Default,Tol,0,0,0,,بما أنك مصمم على ذلك، فأنا أغسل يدي.
Dialogue: 0,0:58:22.49,0:58:24.15,Default,Tol,0,0,0,,فليكن.
Dialogue: 0,0:58:24.25,0:58:28.36,Default,Toly,0,0,0,,أستسلم، مباركتي لك.
Dialogue: 0,0:58:28.53,0:58:30.36,Default,Toly,0,0,0,,لكن ليس لديك أي فكرة عما فقدته.
Dialogue: 0,0:58:30.36,0:58:32.80,Default,Tolya,0,0,0,,لم ألاحظ السعادة تحت أنفي.
Dialogue: 0,0:58:33.63,0:58:35.27,Default,Tol,0,0,0,,سأذهب.
Dialogue: 0,0:58:46.18,0:58:48.51,Default,Tolya,0,0,0,,هذا أمر يصعب كسره.
Dialogue: 0,0:58:50.68,0:58:53.15,Default,Tol,0,0,0,,يا لها من امرأة قاسية.
Dialogue: 0,0:59:08.27,0:59:13.07,Default,الرقم,0,0,0,,15, 20...
Dialogue: 0,0:59:18.04,0:59:20.01,Default,Tol,0,0,0,,ماذا تملك؟
Dialogue: 0,0:59:21.55,0:59:25.01,Default,Toly,0,0,0,,قلبي مثقل، أنا حزين.
Dialogue: 0,0:59:25.55,0:59:28.09,Default,Tolya,0,0,0,,لقد جئت إلى هنا لأشفي قلبي الجريح.
Dialogue: 0,0:59:28.09,0:59:31.09,Default,Tol,0,0,0,,لقد وصلت إلى العنوان الخطأ.
Dialogue: 0,0:59:31.09,0:59:34.12,Default,Tol,0,0,0,,نحن نتاجر بالكثير من الأشياء،
Dialogue: 0,0:59:34.12,0:59:36.33,Default,Toly,0,0,0,,لكن ليس لدينا أي مخدرات.
Dialogue: 0,0:59:36.33,0:59:38.26,Default,Tol,0,0,0,,أسألك، نحن نغلق.
Dialogue: 0,0:59:38.26,0:59:40.30,Default,Tol,0,0,0,,هيا، المخرج هناك.
Dialogue: 0,0:59:41.03,0:59:43.37,Default,Tol,0,0,0,,-لكنني...\N-من فضلك.
Dialogue: 0,0:59:45.37,0:59:47.37,Default,Toly,0,0,0,,أود هذا الشيء المعجزة.
Dialogue: 0,0:59:47.67,0:59:49.31,Default,Tol,0,0,0,,ماذا؟
Dialogue: 0,0:59:51.84,0:59:54.71,Default,Tol,0,0,0,,نفس الشيء الذي تم إحضاره من تشينغ.
Dialogue: 0,1:00:34.99,1:00:38.39,Default,Tol,0,0,0,,اتصلت بك لمناقشة الموضوع،
Dialogue: 0,1:00:38.39,1:00:40.82,Default,فقط,0,0,0,,التي أثيرت في اجتماع اليوم.
Dialogue: 0,1:00:41.12,1:00:43.43,Default,Toly,0,0,0,,هل تجرؤ على مناقشة عزل الملكة سراً؟
Dialogue: 0,1:00:43.43,1:00:46.36,Default,Tol,0,0,0,,بهذا تهين عائلة كيمز بأكملها من أندون!
Dialogue: 0,1:00:46.36,1:00:48.53,Default,توليا,0,0,0,,في الفناء حيث الملكة
Dialogue: 0,1:00:48.53,1:00:51.10,Default,Tol,0,0,0,,قد يقرر إغراق نفسه في أي لحظة،
Dialogue: 0,1:00:51.10,1:00:53.74,Default,فقط,0,0,0,,لن يكون هناك استقرار!
Dialogue: 0,1:00:54.57,1:00:56.84,Default,Tol,0,0,0,,كيف تجرؤ على التحدث بالسوء عن صاحبة الجلالة؟
Dialogue: 0,1:00:56.97,1:00:59.44,Default,Only,0,0,0,,أنت تعرف فقط كيف تبصق السم!
Dialogue: 0,1:00:59.44,1:01:01.41,Default,تولي,0,0,0,,بصق السم؟
Dialogue: 0,1:01:01.88,1:01:06.45,Default,Tol,0,0,0,,لن أتسامح مع مثل هذه الإهانة.
Dialogue: 0,1:01:17.36,1:01:19.40,Default,Tol,0,0,0,,ما هذا بحق الجحيم؟
Dialogue: 0,1:01:19.40,1:01:21.60,Default,Toly,0,0,0,,هل تخطط لشيء خاطئ؟
Dialogue: 0,1:01:28.81,1:01:32.04,Default,Tol,0,0,0,,ما أنت، أنا فقط أطلب منك الاستماع إلى النهاية.
Dialogue: 0,1:01:32.04,1:01:33.71,Default,Tolya,0,0,0,,الخوذات.
Dialogue: 0,1:01:46.02,1:01:49.63,Default,Tol,0,0,0,,كما قلت من قبل، لن يخسر أحد منكم\N أي شيء.
Dialogue: 0,1:01:49.66,1:01:53.30,Default,Tol,0,0,0,,لماذا لا تلتزم\N وتستمع إلى النهاية؟
Dialogue: 0,1:01:56.70,1:01:58.43,Default,Tolya,0,0,0,,اجلس.
Dialogue: 0,1:02:14.18,1:02:17.15,Default,Tol,0,0,0,,لا أعرف إذا كنت تتذكر.
Dialogue: 0,1:02:17.15,1:02:21.56,Default,Tol,0,0,0,,الرسالة التي كتبتها الملكة الأم.
Dialogue: 0,1:02:21.56,1:02:25.00,Default,Tol,0,0,0,,المكان والتاريخ والوقت المحدد فيه،
Dialogue: 0,1:02:25.00,1:02:28.43,Default,Tol,0,0,0,,يتزامن مع متى وأين\Nوقع الحادث مع الملكة.
Dialogue: 0,1:02:28.93,1:02:31.07,Default,Tol,0,0,0,,لقد تم تزوير تلك الرسالة.
Dialogue: 0,1:02:31.07,1:02:34.00,Default,Tol,0,0,0,,ولكن هل يمكنك إثبات ذلك؟
Dialogue: 0,1:02:38.48,1:02:41.18,Default,Tol,0,0,0,,أقترح عليك أن تعود إلى رشدك ولا تطيح بالملكة،
Dialogue: 0,1:02:42.35,1:02:45.45,Default,Tol,0,0,0,,في المقابل ستتلقى هذه الرسالة.
Dialogue: 0,1:02:45.72,1:02:48.15,Default,Tol,0,0,0,,هكذا لعائلاتكم
Dialogue: 0,1:02:48.15,1:02:50.92,Default,Tol,0,0,0,,لم يعد عليك الخوف من العواقب.
Dialogue: 0,1:02:50.92,1:02:53.72,Default,Tol,0,0,0,,هذا هو اقتراحي.
Dialogue: 0,1:02:55.93,1:02:57.76,Default,Tol,0,0,0,,كيف يعجبك ذلك؟
Dialogue: 0,1:03:16.61,1:03:18.31,Default,Tol,0,0,0,,هل اتصلت؟
Dialogue: 0,1:03:19.08,1:03:22.42,Default,Tol,0,0,0,,لبّيت طلب جلالته\N وكتبت إلى والدي.
Dialogue: 0,1:03:22.85,1:03:25.79,Default,Tol,0,0,0,,هل ستوصل له رسالتي؟
Dialogue: 0,1:03:28.36,1:03:29.96,Default,Tol,0,0,0,,سأحاول
Dialogue: 0,1:03:30.46,1:03:32.30,Default,Tol,0,0,0,,أقنع جلالته.
Dialogue: 0,1:03:32.30,1:03:36.80,Default,Tol,0,0,0,,يريد جلالته فقط\N أن يرد الجميل مقابل اللطف.
Dialogue: 0,1:03:37.20,1:03:39.80,Default,Tol,0,0,0,,رغم أن لصاحبة الجلالة رأياً مختلفاً في هذا الشأن.
Dialogue: 0,1:03:40.47,1:03:44.51,Default,Tol,0,0,0,,لكنني أهتم فقط بمشاعر جلالته.
Dialogue: 0,1:03:46.94,1:03:48.88,Default,Tol,0,0,0,,وبالتالي كل شيء على ما يرام.
Dialogue: 0,1:03:49.81,1:03:53.72,Default,Tol,0,0,0,,صاحب السمو، كل شيء جاهز للسباحة.
Dialogue: 0,1:04:17.97,1:04:21.94,Default,Tol,0,0,0,,كل شيء على ما يرام في الوقت الحالي.
Dialogue: 0,1:04:30.12,1:04:31.92,Default,Tol,0,0,0,,جلالتك.
Dialogue: 0,1:04:31.99,1:04:34.32,Default,Tol,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:04:34.32,1:04:38.76,Default,Toly,0,0,0,,هل سأتصل بك إذا كان كل شيء على ما يرام معي؟
Dialogue: 0,1:04:40.63,1:04:45.27,Default,Tol,0,0,0,,قلبي قلق وقلق.
Dialogue: 0,1:04:46.47,1:04:48.50,Default,Tol,0,0,0,,اهدأ.
Dialogue: 0,1:04:49.01,1:04:52.21,Default,Tol,0,0,0,,سأساعدك في العثور على إجابة لسؤالك.
Dialogue: 0,1:05:16.70,1:05:19.77,Default,Tol,0,0,0,,كان جلالته ذاهباً لرؤية المحظية "تشو".
Dialogue: 0,1:05:19.77,1:05:21.87,Default,Tol,0,0,0,,أجري محادثة معه.
Dialogue: 0,1:05:22.31,1:05:24.51,Default,Tol,0,0,0,,اتركنا.
Dialogue: 0,1:05:25.61,1:05:27.28,Default,Tol,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,1:05:35.05,1:05:37.25,Default,Tol,0,0,0,,إن إيداع الملكة سيساعد في إنجاز الخطة.
Dialogue: 0,1:05:37.25,1:05:40.06,Default,Tol,0,0,0,,إذن لماذا تعارض هذا إلى هذا الحد؟
Dialogue: 0,1:05:40.06,1:05:41.59,Default,Tol,0,0,0,,سوف يخلعون ملكة واحدة،
Dialogue: 0,1:05:41.59,1:05:44.13,Default,Tol,0,0,0,,سوف تحل محلها أخرى على الفور.
Dialogue: 0,1:05:44.36,1:05:47.30,Default,Toly,0,0,0,,طالما أن تصرفات الملكة لا تتدخل فينا، بل العكس.
Dialogue: 0,1:05:47.30,1:05:49.17,Default,Tol,0,0,0,,إنها الخيار الأفضل
Dialogue: 0,1:05:49.17,1:05:51.60,Default,فقط,0,0,0,,من كل الإمكانيات.
Dialogue: 0,1:05:52.57,1:05:54.57,Default,Tolya,0,0,0,,هل لمست قلبك؟
Dialogue: 0,1:05:59.21,1:06:01.98,Default,Tol,0,0,0,,الإجابة. هل هذا سبب ترددك؟
Dialogue: 0,1:06:02.25,1:06:03.91,Default,Tol,0,0,0,,نعم.
Dialogue: 0,1:06:04.35,1:06:06.22,Default,Tol,0,0,0,,لمست.
Dialogue: 0,1:06:06.72,1:06:09.99,Default,Tol,0,0,0,,لقد حاولت الانتحار،\Nأرادت التضحية بحياتها،
Dialogue: 0,1:06:09.99,1:06:12.46,Default,فقط,0,0,0,,لإنقاذي ومن أحب.
Dialogue: 0,1:06:12.46,1:06:13.72,Default,Toly,0,0,0,,ليس من باب الشفقة
Dialogue: 0,1:06:13.72,1:06:14.99,Default,Toly,0,0,0,,وليس لأنني سامحت،
Dialogue: 0,1:06:14.99,1:06:17.89,Default,Toly,0,0,0,,ولكن لأنه لا يستطيع تحمل الظلم.
Dialogue: 0,1:06:17.89,1:06:21.00,Default,Tol,0,0,0,,إنها لا تتوقع مني اعتذاراً أو امتناناً.
Dialogue: 0,1:06:21.00,1:06:23.67,Default,Toly,0,0,0,,يتصرف حسب ضميره فحسب.
Dialogue: 0,1:06:23.67,1:06:26.04,Default,Tolya,0,0,0,,الآن أدار الجميع ظهورهم لها.
Dialogue: 0,1:06:26.67,1:06:29.57,Default,Tol,0,0,0,,هل يمكنني أن أفعل نفس الشيء؟
Dialogue: 0,1:06:29.97,1:06:32.51,Default,Tol,0,0,0,,اتضح أنك ستنبذنا
Dialogue: 0,1:06:34.58,1:06:37.15,Default,Toly,0,0,0,,ومن خليلتك؟
Dialogue: 0,1:06:39.18,1:06:41.92,Default,Tol,0,0,0,,لا أشعر بأي شيء تجاه صاحبة الجلالة.
Dialogue: 0,1:06:42.12,1:06:44.42,Default,توليا,0,0,0,,لكنها ليست عدوتنا.
Dialogue: 0,1:06:44.42,1:06:47.56,Default,Toly,0,0,0,,لا أنكرك ولا أخونك.
Dialogue: 0,1:06:47.56,1:06:50.33,Default,Tol,0,0,0,,سيكون الأمر سيئاً إذا كانت لديك مشاعر تجاهها.
Dialogue: 0,1:06:50.33,1:06:52.26,Default,Toly,0,0,0,,تعلق بها،
Dialogue: 0,1:06:52.26,1:06:54.76,Default,Tol,0,0,0,,سوف تعرضنا جميعاً للخطر.
Dialogue: 0,1:06:54.76,1:06:57.13,Default,Tol,0,0,0,,سأحاول منع حدوث ذلك.
Dialogue: 0,1:06:57.40,1:06:59.20,Default,Tol,0,0,0,,حسنًا.
Dialogue: 0,1:06:59.70,1:07:02.07,Default,Tol,0,0,0,,عدني بهذا.
Dialogue: 0,1:07:02.24,1:07:05.14,Default,Tol,0,0,0,,وعدك إذا الملكة
Dialogue: 0,1:07:05.14,1:07:09.11,Default,Tol,0,0,0,,سوف يتعارض مع خططنا
Dialogue: 0,1:07:09.85,1:07:12.01,Default,Toly,0,0,0,,أو تتصرف بغرابة،
Dialogue: 0,1:07:13.25,1:07:15.15,Default,Tol,0,0,0,,أنت بلا تردد
Dialogue: 0,1:07:17.42,1:07:19.66,Default,Toly,0,0,0,,أمر بقتلها.
Dialogue: 0,1:07:44.51,1:07:46.58,Default,Tol,0,0,0,,لماذا لا تجيب؟
Dialogue: 0,1:07:46.58,1:07:48.62,Default,فقط,0,0,0,,إذا كانت الملكة
Dialogue: 0,1:07:49.89,1:07:52.96,Default,Tol,0,0,0,,فجأة يبدأ بالتدخل في خططنا،
Dialogue: 0,1:07:56.96,1:08:00.93,Default,Tol,0,0,0,,سأقطع رأسها بنفسي.
Dialogue: 0,1:08:14.31,1:08:17.55,Default,Tol,0,0,0,,واو، أنا أتحسن في كل مرة.
Dialogue: 0,1:08:20.68,1:08:22.32,Default,Tolya,0,0,0,,هل طرزت هذا بنفسك حقاً؟
Dialogue: 0,1:08:22.32,1:08:24.49,Default,Tolya,0,0,0,,هذا صحيح أيتها الزهور الصغيرة. هل هناك أي شيء في جوسون؟
Dialogue: 0,1:08:24.49,1:08:26.46,Default,Toly,0,0,0,,شخص لا يعرف كيفية التطريز؟
Dialogue: 0,1:08:26.46,1:08:28.22,Default,توليا,0,0,0,,أحفاد أرض نضارة الصباح
Dialogue: 0,1:08:28.22,1:08:29.86,Default,Tol,0,0,0,,أرى أن هناك.
Dialogue: 0,1:08:30.89,1:08:34.40,Default,Toly,0,0,0,,ولا ينبغي أن يكون الجميع قادرين على التطريز.
Dialogue: 0,1:08:34.83,1:08:37.50,Default,Tolya,0,0,0,,هاردي، ويمكنك أن تفعل كل شيء في العالم.
Dialogue: 0,1:08:37.50,1:08:41.17,Default,Toly,0,0,0,,ماذا تقول، أنا أسوأ سيدات البلاط.
Dialogue: 0,1:08:41.37,1:08:45.01,Default,Toly,0,0,0,,الجميع يقول أنني مثل زهرة البنفسج.
Dialogue: 0,1:08:45.84,1:08:49.88,Default,Tol,0,0,0,,نعم، الجميع هنا في متناول اليد.
Dialogue: 0,1:08:49.95,1:08:51.75,Default,Tol,0,0,0,,حسناً، دعونا ننظر إلى إبداعنا.
Dialogue: 0,1:08:52.78,1:08:54.42,Default,Tol,0,0,0,,تصويب.
Dialogue: 0,1:08:58.19,1:09:01.46,Default,توليا,0,0,0,,أحفاد أرض نضارة الصباح\NOافتتاح التسليم
Dialogue: 0,1:09:01.62,1:09:04.39,Default,Toly,0,0,0,,دعونا نعلق هذا أمام الإسطبل.
Dialogue: 0,1:09:04.39,1:09:07.03,Default,Tol,0,0,0,,أشعر أن الأمور تسير على ما يرام بالنسبة لنا.
Dialogue: 0,1:09:07.76,1:09:08.87,Default,Only,0,0,0,,كم يجب أن آخذ؟
Dialogue: 0,1:09:08.87,1:09:11.17,Default,Tol,0,0,0,,للوصول إلى أوكتايجيون، تحتاج إلى المال.
Dialogue: 0,1:09:11.17,1:09:12.80,Default,Tol,0,0,0,,جلالتك.
Dialogue: 0,1:09:14.20,1:09:17.04,Default,Toly,0,0,0,,لقد أحضرت لك زهرة. سحلية الرياح النادرة.
Dialogue: 0,1:09:17.04,1:09:18.74,Default,Tolya,0,0,0,,أوركيدة الرياح؟
Dialogue: 0,1:09:19.71,1:09:21.95,Default,Tolya,0,0,0,,هل كان هناك بالفعل كلام شفهي عن تسليمنا؟
Dialogue: 0,1:09:21.95,1:09:24.41,Default,توليا,0,0,0,,من الزهور؟
Dialogue: 0,1:09:26.15,1:09:28.35,Default,Tol,0,0,0,,تباعد اجتماعي لكن مبروك
Dialogue: 0,1:09:28.55,1:09:31.92,Default,Tol,0,0,0,,من صاحب الجلالة.
Dialogue: 0,1:09:35.69,1:09:37.93,Default,Toly,0,0,0,,لماذا أنت؟
Dialogue: 0,1:09:38.09,1:09:39.76,Default,Tol,0,0,0,,يا له من لقيط.
Dialogue: 0,1:09:39.76,1:09:42.37,Default,Tol,0,0,0,,أحاول أن أنسى نفسي، أنا منهمك في العمل.
Dialogue: 0,1:09:42.37,1:09:44.53,Default,Tol,0,0,0,,ماذا يفعل هذا الرجل؟ أي نوع من العرض هذا؟
Dialogue: 0,1:09:45.87,1:09:47.87,Default,Toly,0,0,0,,نعم، أنا أفضل ألف مرة.
Dialogue: 0,1:09:47.87,1:09:50.07,Default,Tol,0,0,0,,احكم بنفسك. هذا ما توصلت إليه!
Dialogue: 0,1:09:50.07,1:09:52.18,Default,Tolya,0,0,0,,أنا أخلق فرص العمل. ما هو؟
Dialogue: 0,1:09:52.18,1:09:55.14,Default,Tol,0,0,0,,وهذا كله في وقت لا توجد فيه خدمات على مدار الساعة.
Dialogue: 0,1:09:55.21,1:09:57.81,Default,Tol,0,0,0,,نعم، أنا عبقري، عبقري.
Dialogue: 0,1:10:00.08,1:10:02.69,Default,Toly,0,0,0,,هل أخيفها برباطة جأشي؟
Dialogue: 0,1:10:02.85,1:10:05.29,Default,Tol,0,0,0,,حسناً، نعم، أفهم.
Dialogue: 0,1:10:05.36,1:10:07.16,Default,Tol,0,0,0,,حسناً، حسناً.
Dialogue: 0,1:10:08.02,1:10:11.06,Default,Tol,0,0,0,,وهذا بسبب الخطب الفاحشة
Dialogue: 0,1:10:11.06,1:10:15.97,Default,Toly,0,0,0,,اتضح أنه شيء واحد سيئ؟ \Nلماذا لا يأتي أي شيء جيد منه؟
Dialogue: 0,1:10:16.33,1:10:18.23,Default,Tol,0,0,0,,قف.
Dialogue: 0,1:10:19.60,1:10:22.40,Default,Tol,0,0,0,,بما أن الناس هنا مظلمون ولا توجد وسائل راحة،
Dialogue: 0,1:10:22.61,1:10:25.28,Default,Tol,0,0,0,,بأفكاري يمكنني أن أدخل في تاريخ جوسون!
Dialogue: 0,1:10:25.28,1:10:28.68,Default,Tol,0,0,0,,لا، عالمي!
Dialogue: 0,1:11:03.68,1:11:06.68,Default,Tol,0,0,0,,لقد كنت متحمسًا حقًا.
Dialogue: 0,1:11:06.82,1:11:09.52,Default,Tol,0,0,0,,هل يمكنني أن أصبح\NSteve Jobs المحلي أو Thomas Edison؟
Dialogue: 0,1:11:09.52,1:11:13.32,Default,Tol,0,0,0,,لا، أنا أبالغ في الأمر. نحن بحاجة إلى شخص عظيم.
Dialogue: 0,1:11:13.32,1:11:16.86,Default,تولي,0,0,0,,منقذ الجنس البشري.
Dialogue: 0,1:11:28.97,1:11:31.57,Default,Tol,0,0,0,,تجلس في جسد الملكة،
Dialogue: 0,1:11:32.68,1:11:36.38,Default,Only,0,0,0,,الذي لا ينبغي أن يكون هناك.
Dialogue: 0,1:11:36.98,1:11:38.98,Default,Toly,0,0,0,,الروح الشريرة.
Dialogue: 0,1:11:40.55,1:11:45.02,Default,Toly,0,0,0,,الملكة ممسوسة بروح شريرة!
Dialogue: 0,1:11:47.56,1:11:50.43,Default,Tol,0,0,0,,نحن بحاجة إلى طرد هذه الروح!
Dialogue: 0,1:11:51.49,1:11:53.56,Default,Toly,0,0,0,,وإلا فإن العالم كله...
Dialogue: 0,1:11:54.83,1:12:00.57,Default,Toly,0,0,0,,سينقلب العالم كله رأساً على عقب!
Dialogue: 0,1:12:03.94,1:12:05.57,Default,Toly,0,0,0,,بالضبط يا كاريير!
Dialogue: 0,1:12:05.64,1:12:07.81,Default,توليا,0,0,0,,مخترع مكيفات الهواء!
Dialogue: 0,1:12:14.22,1:12:15.25,Default,Tol,0,0,0,,جلالتك!
Dialogue: 0,1:12:15.25,1:12:17.69,Default,Tol,0,0,0,,عد إلى رشدك يا ​​صاحب الجلالة! تعال.
Dialogue: 0,1:12:17.69,1:12:19.29,Default,Tol,0,0,0,,جلالتك!
Dialogue: 0,1:12:19.36,1:12:21.56,Default,Toly,0,0,0,,ابتعد!
Dialogue: 0,1:12:26.86,1:12:29.47,Default,Tol,0,0,0,,إنها... إنها لا تتنفس.
Dialogue: 0,1:12:36.81,1:12:38.74,Default,فقط,0,0,0,,ولا أشعر بالنبضات.
Dialogue: 0,1:13:13.44,1:13:15.68,Default,Tol,0,0,0,,الملكة الآن فاقدة للوعي.
Dialogue: 0,1:13:15.68,1:13:17.65,Default,Toly,0,0,0,,هل تقول أن الملكة ترقد بلا حياة؟
Dialogue: 0,1:13:17.65,1:13:20.48,Default,Tol,0,0,0,,لإنقاذها، عليك أن تبدأ\N تدفق طاقة تشي الذكور. وإلا...
