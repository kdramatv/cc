Dialog: 0,0:00:58.10,0:01:04.08,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.10,0:01:04.08, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.10,0:01:04.08,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Hos, Nanas
Dialog: 0,0:00:58.10,0:01:04.08,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.10,0:01:04.08,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.16,2:01:37.16,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.19,0:01:06.63,Lalai,Spillik,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.63,0:01:08.90,Lalai,Spillik,0,0,0,,dan peristiwa yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:10.46,0:01:13.30,Lalai,Spillik,0,0,0,,Episod akhir
Dialog: 0,0:01:13.82,0:01:14.96,Lalai,Spillik,0,0,0,,Berhenti.
Dialog: 0,0:01:20.03,0:01:21.44,Lalai,Spillik,0,0,0,,-Cari.\N-Ya!
Dialog: 0,0:01:38.15,0:01:39.58,Lalai,Spillik,0,0,0,,Tiada apa-apa yang mencurigakan.
Dialog: 0,0:02:19.80,0:02:20.93,Lalai,Spillik,0,0,0,,Keuntungan.
Dialog: 0,0:02:29.68,0:02:32.41, Lalai, Spillik,0,0,0,, Cari dengan teliti semua troli dengan hadiah diraja.
Dialog: 0,0:02:32.85,0:02:33.91,Lalai,Spillik,0,0,0,,Ya.
Dialog: 0,0:02:42.58,0:02:44.82,Lalai,Spillik,0,0,0,,-Yang Mulia!\N-Salam.
Dialog: 0,0:02:45.66,0:02:46.69,Lalai,Spillik,0,0,0,,Bagaimana...
Dialog: 0,0:02:47.78,0:02:49.83,Lalai,Spillit,0,0,0,,Raja!
Dialog: 0,0:02:53.63,0:02:56.24,Lalai,Spillie,0,0,0,,Akhirnya, saya menangkap tikus kecil ini.
Dialog: 0,0:02:57.16,0:02:58.61,Lalai,Spillik,0,0,0,,Bila majlis bermula?
Dialog: 0,0:02:59.30,0:03:01.80,Lalai,Spillik,0,0,0,,-Petang.\N-Jadi kita ada masa?
Dialog: 0,0:03:02.21,0:03:04.53,Lalai,Spillik,0,0,0,,Anda tidak boleh berehat. Jom cepat.
Dialog: 0,0:03:05.27,0:03:06.34,Lalai,Spillit,0,0,0,,Tunggu.
Dialog: 0,0:03:12.34,0:03:14.79,Lalai,Spillik,0,0,0,,-Apa itu?\N-Saya tidak tahu.
Dialog: 0,0:03:21.99,0:03:23.99,Lalai,Spillik,0,0,0,,Kami mempunyai masa untuk ini.
Dialog: 0,0:03:24.52,0:03:26.89,Lalai,Spillik,0,0,0,,-Sekarang mari kita pergi.\N-Baiklah.
Dialog: 0,0:03:35.77,0:03:38.68,Lalai,Spillik,0,0,0,,Hidup saya tanpa saya
Dialog: 0,0:04:01.23,0:04:02.30,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:04:10.48,0:04:13.51,Lalai,Spillit,0,0,0,,Tunggu, saya belum selesai membersihkan.
Dialog: 0,0:04:17.58,0:04:18.58,Lalai,Spillie,0,0,0,,Oh, mommies!
Dialog: 0,0:04:24.21,0:04:25.26,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:04:28.23,0:04:29.73,Lalai,Spillik,0,0,0,,Anda sangat tersinggung,
Dialog: 0,0:04:30.15,0:04:32.73,Lalai,Spillik,0,0,0,,apakah jiwamu yang berkeliaran di sekitar istana?
Dialog: 0,0:04:35.20,0:04:36.46,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:04:40.01,0:04:41.04,Lalai,Spillit,0,0,0,,Ketua Kasim.
Dialog: 0,0:04:42.21,0:04:43.71,Lalai,Spillik,0,0,0,,Ikut saya.
Dialog: 0,0:04:44.71,0:04:46.87,Lalai,Spillik,0,0,0,,Dengan anda?
Dialog: 0,0:04:47.51,0:04:49.24,Lalai,Spillie,0,0,0,,Sesat!
Dialog: 0,0:04:52.89,0:04:55.71,Lalai,Spillik,0,0,0,,Yang Mulia, pergi ke syurga.
Dialog: 0,0:04:56.31,0:04:58.15,Lalai,Spillik,0,0,0,,Anda mesti ikut saya.
Dialog: 0,0:04:59.79,0:05:00.86,Lalai,Spillit,0,0,0,,Ratu.
Dialog: 0,0:05:02.86,0:05:03.89,Lalai,Spillit,0,0,0,,Raja.
Dialog: 0,0:05:05.33,0:05:07.12,Lalai,Spillik,0,0,0,,Yang Mulia! Anda masih hidup!
Dialog: 0,0:05:09.46,0:05:12.80,Lalai,Spillik,0,0,0,,Yang Mulia, apa yang berlaku kepada tuanku?
Dialog: 0,0:05:33.66,0:05:35.69,Lalai,Spillit,0,0,0,,Ia sesuai dengan pakaian diraja.
Dialog: 0,0:05:35.99,0:05:37.86,Lalai,Spillik,0,0,0,,Saya mempunyai rasa yang menakjubkan.
Dialog: 0,0:05:41.60,0:05:42.60,Lalai,Spillik,0,0,0,,Sana!
Dialog: 0,0:05:49.68,0:05:50.74,Lalai,Spillik,0,0,0,,Sana!
Dialog: 0,0:06:03.38,0:06:04.68,Lalai,Spillit,0,0,0,,Reptilia merayap.
Dialog: 0,0:06:11.93,0:06:13.17,Lalai,Spillik,0,0,0,,Ya!
Dialog: 0,0:06:14.19,0:06:15.74,Lalai,Spillik,0,0,0,,Kenapa awak baik sangat?
Dialog: 0,0:06:15.93,0:06:19.47,Lalai,Spillik,0,0,0,,Mungkin ini adalah suasana yang lahir daripada pengalaman?
Dialog: 0,0:06:19.97,0:06:21.93,Lalai,Spillik,0,0,0,,Lahir dari pengalaman apa?
Dialog: 0,0:06:21.93,0:06:23.78,Lalai,Spillik,0,0,0,,Saya hebat dengan pisau.
Dialog: 0,0:06:31.28,0:06:32.92,Lalai,Spillik,0,0,0,,Jangan membuat pergerakan yang sia-sia.
Dialog: 0,0:06:33.42,0:06:35.59,Lalai,Spillik,0,0,0,,Berapa ramai pahlawan yang menjaga istana?
Dialog: 0,0:06:40.53,0:06:41.55,Lalai,Spillik,0,0,0,,Anda lewat.
Dialog: 0,0:06:41.82,0:06:43.75,Lalai,Spillik,0,0,0,,Bunyi ini bermaksud permulaan pertabalan.
Dialog: 0,0:06:45.60,0:06:47.49,Lalai,Spillik,0,0,0,,Beraninya awak beranikan saya?
Dialog: 0,0:06:58.28,0:07:00.07,Lalai,Spillik,0,0,0,,Adakah upacara pertabalan sudah bermula?
Dialog: 0,0:07:04.28,0:07:06.22,Lalai,Spillit,0,0,0,,Tunduk hormat
Dialog: 0,0:07:09.25,0:07:11.01, Lalai, Spilyk, 0,0,0,, empat kali
Dialog: 0,0:07:26.67,0:07:28.56, Lalai, Spillit,0,0,0,,dan duduk tegak.
Dialog: 0,0:07:35.44,0:07:36.98,Lalai,Spillik,0,0,0,,Saya tidak percaya mereka bermula lebih awal.
Dialog: 0,0:07:40.68,0:07:42.25,Lalai,Spillik,0,0,0,,Hei, saya perlu memberitahu anda sesuatu.
Dialog: 0,0:07:43.01,0:07:46.55,Lalai,Spillik,0,0,0,,Saya mempunyai pelan sandaran.
Dialog: 0,0:08:18.95,0:08:21.82,Lalai,Spillik,0,0,0,,Apa yang kamu lakukan? Cepat dan teruskan.
Dialog: 0,0:08:22.73,0:08:23.82,Lalai,Spillik,0,0,0,,Perkaranya,
Dialog: 0,0:08:25.99,0:08:28.49,Lalai,Spillik,0,0,0,,bahawa mohor diraja tiada!
Dialog: 0,0:08:35.68,0:08:37.57,Lalai,Spillit,0,0,0,,Tiada Meterai Diraja!
Dialog: 0,0:09:00.12,0:09:01.60,Lalai,Spillik,0,0,0,,Saya mesti gila.
Dialog: 0,0:09:02.36,0:09:05.93,Lalai,Spillik,0,0,0,,Atau kehilangan kepalanya kerana ini adalah tugas khas.
Dialog: 0,0:09:09.24,0:09:10.63,Lalai,Spillie,0,0,0,,Angkat kepala anda.
Dialog: 0,0:09:11.34,0:09:14.68,Lalai,Spillik,0,0,0,,Salam, anda...
Dialog: 0,0:09:17.51,0:09:18.51,Lalai,Spillit,0,0,0,,Majesty?
Dialog: 0,0:09:21.24,0:09:22.49,Lalai,Spillik,0,0,0,,Lee Senman.
Dialog: 0,0:09:22.79,0:09:25.93,Lalai,Spillik,0,0,0,,Anda Lee Senman.\NAAdakah anda benar-benar gila?
Dialog: 0,0:09:26.43,0:09:27.68,Lalai,Spillik,0,0,0,,Atau adakah saya gila?
Dialog: 0,0:09:32.56,0:09:34.17,Lalai,Spillit,0,0,0,,Adakah anda telah mencuri mohor diraja?
Dialog: 0,0:09:34.96,0:09:36.46,Lalai,Spillik,0,0,0,,Saya agak gila.
Dialog: 0,0:09:37.27,0:09:39.27,Lalai,Spillik,0,0,0,,Jadi kita masih ada peluang.
Dialog: 0,0:09:51.57,0:09:53.44,Lalai,Spillit,0,0,0,,-Jom.\N-Maju.
Dialog: 0,0:10:00.22,0:10:02.05,Lalai,Spillik,0,0,0,,Kali terakhir ia berkesan untuk saya.
Dialog: 0,0:10:02.05,0:10:04.00, Lalai, Spilyk,0,0,0,,-Cuba.\N-Diam.
Dialog: 0,0:10:04.03,0:10:05.46,Lalai,Spillik,0,0,0,,Kenapa awak...
Dialog: 0,0:10:10.59,0:10:11.73, Lalai,Spillik,0,0,0,,Hon.
Dialog: 0,0:10:15.73,0:10:16.97,Lalai,Spillik,0,0,0,,Anda lagi?
Dialog: 0,0:10:16.97,0:10:18.41,Lalai,Spillik,0,0,0,,Saya dah cakap jangan datang!
Dialog: 0,0:10:18.54,0:10:19.75,Lalai,Spillik,0,0,0,,Hanya untuk saya
Dialog: 0,0:10:20.25,0:10:22.71,Lalai,Spillik,0,0,0,,tiada orang lain untuk bertanya.
Dialog: 0,0:10:25.68,0:10:30.89,Lalai,Spillie,0,0,0,,Permaisuri meminta saya mencuri sesuatu untuknya.
Dialog: 0,0:10:40.87,0:10:42.83,Lalai,Spillie,0,0,0,,Barang terang dan mahal ini
Dialog: 0,0:10:42.83,0:10:44.83,Lalai,Spillik,0,0,0,,kelihatan tidak menyenangkan.
Dialog: 0,0:10:45.00,0:10:46.17,Lalai,Spillik,0,0,0,,Apakah ini?
Dialog: 0,0:10:47.83,0:10:49.60,Lalai,Spillit,0,0,0,,Mohor Diraja.
Dialog: 0,0:10:50.54,0:10:51.54,Lalai,Spillik,0,0,0,,Adakah anda berfikir,
Dialog: 0,0:10:52.91,0:10:55.28,Lalai,Spilyk,0,0,0,,di manakah anda muncul dengan meterai yang dicuri?
Dialog: 0,0:10:55.38,0:10:56.68,Lalai,Spillik,0,0,0,,Ini ialah Jabatan Detektif.
Dialog: 0,0:11:01.02,0:11:04.29,Lalai,Spillik,0,0,0,,Adakah saya datang ke penjara secara sukarela?
Dialog: 0,0:11:08.90,0:11:10.09,Lalai,Spillie,0,0,0,,Mengapa anda memberikannya kepada saya?
Dialog: 0,0:11:14.09,0:11:15.50,Lalai,Spillik,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:11:15.80,0:11:18.04,Lalai,Spillik,0,0,0,,Datang berjumpa rakan.
Dialog: 0,0:11:18.23,0:11:20.70, Lalai, Spillik,0,0,0,, Anda tidak boleh berada di sini. Tinggalkan segera.
Dialog: 0,0:11:21.17,0:11:22.18,Lalai,Spillit,0,0,0,,Tunggu!
Dialog: 0,0:11:23.78,0:11:26.28,Lalai,Spillik,0,0,0,,Beraninya awak ambil kawan baik saya?
Dialog: 0,0:11:31.38,0:11:32.55,Lalai,Spillik,0,0,0,,Adakah anda hilang akal?
Dialog: 0,0:11:32.68,0:11:34.15,Lalai,Spillik,0,0,0,,Mengapa anda menunjukkan meterai diraja?
Dialog: 0,0:11:35.55,0:11:36.79,Lalai,Spillit,0,0,0,,Mohor Diraja?
Dialog: 0,0:11:37.39,0:11:38.81,Lalai,Spillie,0,0,0,,Adakah anda mahu melihatnya?
Dialog: 0,0:11:45.32,0:11:47.56,Lalai,Spillik,0,0,0,,-Itu bom!\N-Lari!
Dialog: 0,0:13:02.43,0:13:05.30,Lalai,Biryulka,0,0,0,,Mereka melalui semua pintu ibu kota?
Dialog: 0,0:13:05.30,0:13:07.51,Lalai,Spillik,0,0,0,,Ya. Jika anda memerintahkan kami untuk menggunakan senjata...
Dialog: 0,0:13:07.51,0:13:10.78,Lalai,Spillik,0,0,0,,Sekarang adalah lebih penting untuk menyempurnakan upacara pertabalan,
Dialog: 0,0:13:10.78,0:13:12.07,Lalai,Spillik,0,0,0,,kita perlu menunggu sebentar dengan senjata.
Dialog: 0,0:13:12.68,0:13:15.52,Lalai,Spillik,0,0,0,,Dan hantar pengawal ke semua pintu pagar.
Dialog: 0,0:13:15.52,0:13:16.68,Lalai,Spillit,0,0,0,,Cepat!
Dialog: 0,0:13:20.48,0:13:22.82,Lalai,Spillit,0,0,0,,Sebaik sahaja majlis selesai,
Dialog: 0,0:13:24.32,0:13:26.37,Lalai,Spillik,0,0,0,,Saya akan singkirkannya.
Dialog: 0,0:13:28.46,0:13:31.93,Lalai,Spillik,0,0,0,,Bagaimana kita boleh meneruskan upacara tanpa mohor diraja?
Dialog: 0,0:13:32.23,0:13:34.73,Lalai,Spillik,0,0,0,,Tuhan, bagaimana ini boleh berlaku?
Dialog: 0,0:13:35.93,0:13:38.28,Lalai,Spillik,0,0,0,,Apa yang awak buat?
Dialog: 0,0:13:38.64,0:13:41.75,Lalai,Spillik,0,0,0,,Mengapa anda tidak berguna?
Dialog: 0,0:13:49.66,0:13:50.76,Lalai,Spillik,0,0,0,,Ada apa?
Dialog: 0,0:13:54.35,0:13:55.39,Lalai,Spillik,0,0,0,,Jadi apa?
Dialog: 0,0:13:55.39,0:13:58.35,Lalai,Spilyk,0,0,0,,Kami tidak boleh menyerang sekarang
Dialog: 0,0:13:58.35,0:14:00.06,Lalai,Spillik,0,0,0,,disebabkan asap pedas yang tidak diketahui.
Dialog: 0,0:14:01.63,0:14:03.50,Lalai,Spillik,0,0,0,,Dan memandangkan majlis mesti berakhir dengan jayanya,
Dialog: 0,0:14:03.50,0:14:06.73,Lalai,Spillik,0,0,0,,Saya menghantar pengawal ke pintu pagar untuk menghalang mereka.
Dialog: 0,0:14:08.80,0:14:10.64,Lalai,Spillik,0,0,0,,Taktik menipu.
Dialog: 0,0:14:10.73,0:14:11.73,Lalai,Spillik,0,0,0,,Apakah ini?
Dialog: 0,0:14:13.94,0:14:15.01,Lalai,Spillik,0,0,0,,Tiada apa-apa.
Dialog: 0,0:14:15.10,0:14:17.12,Lalai,Spillik,0,0,0,,Saya sendiri akan membawa meterai diraja.
Dialog: 0,0:14:19.52,0:14:21.48,Default,Spillik,0,0,0,,Segera panggil semua pengawal kembali ke istana.
Dialog: 0,0:14:22.15,0:14:23.81,Lalai,Spillik,0,0,0,,-Apa?\N-Anda tidak dengar?
Dialog: 0,0:14:24.68,0:14:25.72,Lalai,Spillik,0,0,0,,Ya.
Dialog: 0,0:14:38.54,0:14:39.93,Lalai,Spillik,0,0,0,,Senyap di sini.
Dialog: 0,0:14:41.37,0:14:43.23,Lalai,Spillik,0,0,0,,Nampaknya semuanya berjalan mengikut perancangan.
Dialog: 0,0:14:46.84,0:14:48.44,Lalai,Spillik,0,0,0,,Kami telah sampai ke sini.
Dialog: 0,0:14:57.05,0:14:58.12,Lalai,Spillik,0,0,0,,Adakah anda takut?
Dialog: 0,0:14:58.95,0:15:00.93,Lalai,Spillik,0,0,0,,Ya, saya juga
Dialog: 0,0:15:01.85,0:15:03.00,Lalai,Spillik,0,0,0,,ditindas.
Dialog: 0,0:15:03.13,0:15:05.53,Lalai,Spillik,0,0,0,,Tepat sekali. Ini adalah perasaan anda
Dialog: 0,0:15:05.53,0:15:07.59,Lalai,Spillik,0,0,0,,sebelum bos bertarung dalam permainan.
Dialog: 0,0:15:08.63,0:15:10.83,Lalai,Spillik,0,0,0,,Betul. Bos.
Dialog: 0,0:15:10.83,0:15:13.37,Lalai,Spillik,0,0,0,,Jika kamu mati sebelum mengalahkannya, kamu akan mengutuk segala yang ada di dunia ini,
Dialog: 0,0:15:13.37,0:15:15.10,Lalai,Spillik,0,0,0,,kerana anda perlu bermula sekali lagi.
Dialog: 0,0:15:15.10,0:15:17.47,Lalai,Spillik,0,0,0,,Kami hanya mempunyai satu peluang.
Dialog: 0,0:15:18.20,0:15:20.05,Lalai,Spillit,0,0,0,,Tuhan. Saya semakin takut.
Dialog: 0,0:15:26.18,0:15:27.48,Lalai,Spillik,0,0,0,,Bolehkah kita pergi?
Dialog: 0,0:15:58.12,0:15:59.58,Lalai,Spillik,0,0,0,,Dia faham.
Dialog: 0,0:16:08.13,0:16:09.26,Lalai,Spillit,0,0,0,,Permaisuriku!
Dialog: 0,0:16:10.82,0:16:13.72,Lalai,Spillik,0,0,0,,Saya tidak apa-apa. Bunyi itu ketakutan.
Dialog: 0,0:16:13.72,0:16:15.19,Lalai,Spillik,0,0,0,,Ia tidak menyakitkan.
Dialog: 0,0:16:21.14,0:16:22.23,Lalai,Spillit,0,0,0,,Ratu!
Dialog: 0,0:16:23.47,0:16:24.64,Lalai,Spillit,0,0,0,,Permaisuriku!
Dialog: 0,0:16:29.18,0:16:31.62, Lalai, Spillie,0,0,0,, Ratu, jangan bergerak.
Dialog: 0,0:16:31.88,0:16:33.81,Lalai,Spillik,0,0,0,,Kita mesti hentikan majlis itu.
Dialog: 0,0:16:34.81,0:16:36.35,Lalai,Spillik,0,0,0,,Anda lebih penting.
Dialog: 0,0:16:42.39,0:16:44.13,Lalai,Spillik,0,0,0,,Saya kena tengok luka.
Dialog: 0,0:17:33.38,0:17:34.44,Lalai,Spillit,0,0,0,,Rajaku.
Dialog: 0,0:18:00.33,0:18:01.56,Lalai,Spillik,0,0,0,,Adakah saya akan kembali?
Dialog: 0,0:18:01.91,0:18:02.97,Lalai,Spillik,0,0,0,,No.
Dialog: 0,0:18:04.03,0:18:05.34,Lalai,Spillik,0,0,0,,Kenapa sekarang?
Dialog: 0,0:18:06.11,0:18:07.11,Lalai,Spilyk,0,0,0,,Sila,
Dialog: 0,0:18:10.54,0:18:12.32,Lalai,Spillik,0,0,0,,selepas saya nampak dia masih hidup.
Dialog: 0,0:18:15.12,0:18:17.09,Lalai,Spillik,0,0,0,,Biar saya pastikan dia baik-baik saja.
Dialog: 0,0:18:35.67,0:18:38.08,Lalai,Spillit,0,0,0,,Keadaan kritikal
Dialog: 0,0:18:52.42,0:18:54.75,Lalai,Spillik,0,0,0,,Adakah ini badan saya? saya dah balik?
Dialog: 0,0:18:55.48,0:18:56.66,Lalai,Spillik,0,0,0,,Bagaimana pula dengan Cheoljong?
Dialog: 0,0:19:05.90,0:19:07.91,Lalai,Spillik,0,0,0,,Tidak, saya perlu menyelamatkannya.
Dialog: 0,0:19:09.07,0:19:10.34,Lalai,Spillik,0,0,0,,Tetapi bagaimana?
Dialog: 0,0:19:11.27,0:19:12.58,Lalai,Spillik,0,0,0,,Ini 200 tahun yang lalu.
Dialog: 0,0:19:38.29,0:19:40.50,Lalai,Spillik,0,0,0,,Jabatan VIP
Dialog: 0,0:19:42.64,0:19:44.14,Lalai,Spillik,0,0,0,,Apa? Jang Bong Hwan?
Dialog: 0,0:19:46.38,0:19:47.44,Lalai,Spillie,0,0,0,,Jang Bong-hwan!
Dialog: 0,0:19:47.74,0:19:49.38,Lalai,Spillit,0,0,0,,Jang Bong-hwan? Pesakit?
Dialog: 0,0:19:53.54,0:19:54.54,Lalai,Spillit,0,0,0,,Berhenti!
Dialog: 0,0:19:54.54,0:19:56.36,Lalai,Spilyk,0,0,0,,Anda tidak boleh berlari seperti itu! Awak baru bangun!
Dialog: 0,0:19:56.36,0:19:57.71,Lalai,Spillie,0,0,0,,Jang Bong-hwan!
Dialog: 0,0:19:58.51,0:20:00.72,Lalai,Spillit,0,0,0,,-Chan Bong-hwan!\N-Ikuti dia!
Dialog: 0,0:20:01.22,0:20:02.43, Lalai, galeri penggambaran2,0,0,0,, Jang Bong-hwan!
Dialog: 0,0:20:06.17,0:20:07.63, Lalai, galeri penangkapan2,0,0,0,, Berhenti!
Dialog: 0,0:20:07.63,0:20:08.76, Lalai, galeri menembak2,0,0,0,, Hentikan dia!
Dialog: 0,0:20:10.40,0:20:12.67, Lalai, galeri penangkapan2,0,0,0,,-Berhenti.\N-Kenapa awak lari?
Dialog: 0,0:20:12.67,0:20:13.70,Lalai,tier2,0,0,0,,
Dialog: 0,0:20:14.70,0:20:16.00, Lalai, galeri penangkapan2,0,0,0,, Hentikan sudah!
Dialog: 0,0:20:18.00,0:20:19.23, Lalai, galeri penangkapan2,0,0,0,,-Apa?\N-Tidak!
Dialog: 0,0:20:29.68,0:20:30.92, Lalai, galeri menembak2,0,0,0,, Pemuda sialan.
Dialog: 0,0:20:32.01,0:20:34.43,Lalai,tyra2,0,0,0,,Adakah dia benar-benar seperti sayur selama beberapa bulan?
Dialog: 0,0:20:50.43,0:20:52.11, Lalai, galeri menembak2,0,0,0,, Kedai Buku Daehan
Dialog: 0,0:20:52.94,0:20:54.20, Lalai,tira2,0,0,0,,"Sejarah Sebenar Joseon."
Dialog: 0,0:21:03.92,0:21:05.06, Lalai,tira2,0,0,0,,"Sejarah Sebenar Joseon"
Dialog: 0,0:21:09.18,0:21:11.95, Lalai, galeri penangkapan2,0,0,0,, Jangan mati sahaja. Awak tak boleh mati macam ni.
Dialog: 0,0:21:12.49,0:21:14.83, Lalai,tira2,0,0,0,,Raja ke-22 Negeri Joseon
Dialog: 0,0:21:18.03,0:21:19.64, Lalai, galeri menembak2,0,0,0,, Raja Cheol...
Dialog: 0,0:21:20.91,0:21:24.31,Lalai,menembak2,0,0,0,,Era pemerintahan Raja Cheoljong
Dialog: 0,0:21:37.59,0:21:38.59, Lalai, galeri penangkapan2,0,0,0,,Ia tiada di sana.
Dialog: 0,0:21:43.06,0:21:44.66, Lalai, galeri menembak2,0,0,0,,Dia pergi.
Dialog: 0,0:21:52.87,0:21:53.93, Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:21:58.91,0:21:59.91,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:22:09.04,0:22:10.92, Lalai, galeri penangkapan2,0,0,0,, Anda tidak boleh keluar seperti itu.
Dialog: 0,0:22:11.42,0:22:13.18, Lalai, galeri penangkapan2,0,0,0,,Sila bangun, Tuanku.
Dialog: 0,0:22:17.45,0:22:18.52,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:22:22.02,0:22:24.03,Lalai,menembak2,0,0,0,,-Yang Mulia.\N-Permaisuri.
Dialog: 0,0:22:24.90,0:22:26.20,Lalai,galeri penangkapan2,0,0,0,,Adakah anda okey?
Dialog: 0,0:22:26.70,0:22:28.26, Lalai, penangkapan 2,0,0,0,,Saya tidak apa-apa.
Dialog: 0,0:22:29.50,0:22:31.77, Lalai, galeri menembak2,0,0,0,,Tetapi anda berdarah.
Dialog: 0,0:22:32.27,0:22:34.04,Lalai,menembak2,0,0,0,,Rasa semua kesakitan ini,
Dialog: 0,0:22:35.00,0:22:37.08,Lalai,menembak2,0,0,0,,Saya rasa saya tidak akan mati kerana ini.
Dialog: 0,0:22:38.18,0:22:41.98, Lalai, galeri menembak2,0,0,0,,Perisai badan ini menyelamatkan nyawa kami.
Dialog: 0,0:22:43.95,0:22:45.32, Lalai, galeri penangkapan2,0,0,0,, Alangkah leganya!
Dialog: 0,0:23:27.29,0:23:29.73,Lalai,menembak2,0,0,0,,Apa yang awak buat?
Dialog: 0,0:23:29.73,0:23:31.73,Default,tyra2,0,0,0,,Raja berpihak kepada pengikut donghak?
Dialog: 0,0:23:35.73,0:23:36.84,Lalai,tier2,0,0,0,,Saya rasa
Dialog: 0,0:23:38.23,0:23:40.04,Lalai,galeri menembak2,0,0,0,,Saya masih raja.
Dialog: 0,0:23:40.04,0:23:42.27,Lalai,menembak2,0,0,0,,Anda tidak sepatutnya melakukan apa-apa.
Dialog: 0,0:23:43.12,0:23:46.35, Lalai, galeri menembak2,0,0,0,,Terima kedudukan anda dan tidak berbuat apa-apa,
Dialog: 0,0:23:46.35,0:23:48.15, Lalai, galeri penangkapan2,0,0,0,,semua orang akan gembira.
Dialog: 0,0:23:50.56,0:23:51.59,Lalai,tier2,0,0,0,,I
Dialog: 0,0:23:52.93,0:23:55.28,Lalai,tyra2,0,0,0,,saudara mereka yang anda bunuh.
Dialog: 0,0:23:56.86,0:24:02.29, Lalai, galeri menembak2,0,0,0,,Saya adalah raja orang-orang yang telah anda abaikan!
Dialog: 0,0:24:07.87,0:24:10.08, Lalai,galeri penangkapan2,0,0,0,,Mustahil untuk bertindak.
Dialog: 0,0:24:13.50,0:24:16.11, Lalai, galeri penangkapan2,0,0,0,,Anda keletihan.
Dialog: 0,0:24:16.92,0:24:19.62, Lalai, galeri menembak2,0,0,0,,Saya ragu anda boleh mengelak pedang saya!
Dialog: 0,0:24:26.89,0:24:27.89,Lalai,tier2,0,0,0,,Anda...
Dialog: 0,0:24:38.26,0:24:42.03,Lalai,tier2,0,0,0,,No. sayang saya. saya mohon awak.
Dialog: 0,0:24:56.43,0:24:57.10,Lalai,galeri penangkapan2,0,0,0,,Sila.
Dialog: 0,0:26:10.10,0:26:11.19, Lalai, galeri menembak2,0,0,0,, Bunuh saya.
Dialog: 0,0:26:14.07,0:26:15.13, Lalai, galeri penangkapan2,0,0,0,, Langsung.
Dialog: 0,0:26:16.84,0:26:19.60,Lalai,galeri menembak2,0,0,0,,Hidup dalam penghinaan -
Dialog: 0,0:26:21.53,0:26:22.91,Lalai,menembak 2,0,0,0,,hukuman anda.
Dialog: 0,0:26:31.62,0:26:33.24, Lalai, galeri menembak2,0,0,0,,Cuba bunuh diri,
Dialog: 0,0:26:34.28,0:26:36.92,Lalai,menembak 2,0,0,0,,Saya akan lakukan segalanya untuk menyelamatkan kamu.
Dialog: 0,0:26:37.48,0:26:40.09, Lalai, galeri menembak2,0,0,0,, Dan tidak kira berapa banyak kesakitan yang anda tanggung,
Dialog: 0,0:26:40.09,0:26:41.95, Lalai, galeri penangkapan2,0,0,0,,tetapi saya pasti akan membuat anda hidup.
Dialog: 0,0:26:43.56,0:26:45.49,Lalai,menembak2,0,0,0,,Hidup seperti cangkang kosong.
Dialog: 0,0:26:46.79,0:26:48.29,Lalai,menembak2,0,0,0,,Begitulah kehidupan
Dialog: 0,0:26:50.26,0:26:53.20,Lalai,menembak 2,0,0,0,,akan memotong jauh ke dalam tulang anda.
Dialog: 0,0:27:27.52,0:27:31.05, Lalai, galeri penangkapan2,0,0,0,, Dan apa seterusnya? Bersembunyi di khalayak ramai adalah kepakaran anda
Dialog: 0,0:27:31.55,0:27:34.52, Lalai, galeri penangkapan2,0,0,0,,tetapi ini perintah berkurung dan tidak ada seorang pun di kawasan itu.
Dialog: 0,0:27:35.26,0:27:37.96,Lalai,galeri penangkapan2,0,0,0,,Anda tiada tempat lain untuk disembunyikan.
Dialog: 0,0:28:03.39,0:28:04.55, Lalai, galeri menembak2,0,0,0,, Permaisuriku.
Dialog: 0,0:28:09.72,0:28:12.23, Lalai, galeri menembak2,0,0,0,, Selesaikan pertempuran anda dahulu.
Dialog: 0,0:28:13.73,0:28:14.90,Lalai,tier2,0,0,0,,No.
Dialog: 0,0:28:15.33,0:28:17.63, Lalai, galeri penangkapan2,0,0,0,,Tiada yang lebih penting daripada anda.
Dialog: 0,0:28:18.27,0:28:19.60, Lalai, galeri penangkapan2,0,0,0,,Jangan risau.
Dialog: 0,0:28:20.27,0:28:22.17, Lalai, galeri penangkapan2,0,0,0,,Saya boleh menangani perkara ini.
Dialog: 0,0:28:26.61,0:28:28.04, Lalai,galeri penangkapan2,0,0,0,,Yang Mulia!
Dialog: 0,0:28:30.35,0:28:31.81,Lalai,tier2,0,0,0,,Saya akan menjaga permaisuri.
Dialog: 0,0:28:32.65,0:28:33.75,Lalai,menembak 2,0,0,0,,Anda mesti pergi.
Dialog: 0,0:28:33.85,0:28:35.92,Lalai,menembak2,0,0,0,,Kami tidak tahu apa lagi yang boleh berlaku.
Dialog: 0,0:28:52.23,0:28:53.60,Lalai,galeri penangkapan2,0,0,0,,Sila pergi.
Dialog: 0,0:29:16.42,0:29:18.19,Lalai,galeri penangkapan2,0,0,0,,Saya akan kembali tidak lama lagi.
Dialog: 0,0:29:19.59,0:29:20.63,Lalai,tier2,0,0,0,,Ya.
Dialog: 0,0:29:32.07,0:29:33.07,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:29:33.51,0:29:34.54,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia,
Dialog: 0,0:29:34.74,0:29:35.94,Lalai,galeri penangkapan2,0,0,0,,adakah anda okey?
Dialog: 0,0:29:59.80,0:30:03.00, Lalai, galeri penangkapan2,0,0,0,,Lakukan sesuatu!
Dialog: 0,0:30:03.67,0:30:07.94,Lalai,galeri penangkapan2,0,0,0,,Kenapa awak sangat tidak berguna?
Dialog: 0,0:30:27.03,0:30:29.63, Lalai, galeri menembak2,0,0,0,, Berkelakuan dengan bermaruah!
Dialog: 0,0:30:29.93,0:30:33.13,Lalai,menembak2,0,0,0,,Saya sangat takut, Ratu Janda.
Dialog: 0,0:30:35.64,0:30:38.01, Lalai, galeri menembak2,0,0,0,,Anda mesti mempertahankan tempat anda!
Dialog: 0,0:31:36.67,0:31:38.10, Lalai, galeri menembak2,0,0,0,,Elak dari takhta.
Dialog: 0,0:31:56.79,0:31:58.59,Lalai,menembak2,0,0,0,,Permaisuri Janda.
Dialog: 0,0:32:01.79,0:32:03.83,Lalai,galeri penangkapan2,0,0,0,,Saya ucapkan salam.
Dialog: 0,0:32:53.44,0:32:55.54,Lalai,galeri tembak2,0,0,0,,Salam Kebawah Duli Yang Maha Mulia Raja!
Dialog: 0,0:32:56.38,0:32:57.48, Lalai, galeri menembak2,0,0,0,, Permaisuriku!
Dialog: 0,0:32:59.51,0:33:01.22,Lalai,menembak2,0,0,0,,Baginda kini tidak sedarkan diri.
Dialog: 0,0:33:05.05,0:33:06.35, Lalai,galeri penangkapan2,0,0,0,,Apa yang berlaku?
Dialog: 0,0:33:06.92,0:33:09.36,Lalai,tira2,0,0,0,,Baginda mungkin mengalami keguguran.
Dialog: 0,0:33:10.39,0:33:12.36,Lalai,tier2,0,0,0,,Ini adalah sedikit pendarahan sekarang.
Dialog: 0,0:33:12.66,0:33:16.03,Lalai,tyra2,0,0,0,,Tetapi jika ia berterusan, kedua-dua permaisuri dan anaknya
Dialog: 0,0:33:17.90,0:33:19.33, Lalai, galeri penangkapan2,0,0,0,,tidak akan bertahan.
Dialog: 0,0:33:23.37,0:33:25.81,Lalai,menembak2,0,0,0,,Kalau begitu kenapa awak cabut jarum?
Dialog: 0,0:33:26.24,0:33:31.68,Lalai,tira2,0,0,0,,Sekarang akupunktur hanya akan membahayakannya.
Dialog: 0,0:33:32.31,0:33:35.32,Lalai,tyra2,0,0,0,,Apa yang boleh kita lakukan hanyalah menunggu dan berdoa untuknya.
Dialog: 0,0:33:36.25,0:33:39.72,Lalai,menembak 2,0,0,0,,Dia mungkin tidak bertahan lama.
Dialog: 0,0:33:45.56,0:33:47.73,Lalai,galeri penangkapan2,0,0,0,,-Yang Mulia! Tidak!\N-Yang Mulia.
Dialog: 0,0:33:53.64,0:33:55.84,Lalai,galeri menembak2,0,0,0,,Yang Mulia, maafkan kami,
Dialog: 0,0:33:56.81,0:33:59.54,Lalai,tier2,0,0,0,,tetapi tinggalkan bilik supaya kami boleh menjaganya.
Dialog: 0,0:34:00.11,0:34:02.88, Lalai, galeri penangkapan2,0,0,0,, Tuanku, kita mesti meninggalkan mereka.
Dialog: 0,0:34:08.28,0:34:09.45,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia!
Dialog: 0,0:34:12.09,0:34:13.35,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia!
Dialog: 0,0:34:14.92,0:34:19.13,Lalai,galeri penangkapan2,0,0,0,,Tiada apa yang boleh saya lakukan!
Dialog: 0,0:35:09.44,0:35:10.55, Lalai, galeri menembak2,0,0,0,, Permaisuriku.
Dialog: 0,0:35:24.93,0:35:27.96,Lalai,tyra2,0,0,0,,Permaisuri dan kanak-kanak itu baik-baik saja sekarang.
Dialog: 0,0:35:36.77,0:35:37.81, Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:35:41.64,0:35:43.75,Lalai,galeri penangkapan2,0,0,0,,Saya sangat gembira. awak dan bayi kita...
Dialog: 0,0:35:46.88,0:35:48.92,Lalai,menembak2,0,0,0,,Semuanya baik dengan anda.
Dialog: 0,0:35:58.53,0:35:59.53,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia.
Dialog: 0,0:36:18.08,0:36:19.85,Lalai,galeri penangkapan2,0,0,0,,Inilah penghujungnya.
Dialog: 0,0:36:22.08,0:36:25.55, Lalai, galeri menembak2,0,0,0,,Siapa tahu bahawa raja itu sangat luar biasa?
Dialog: 0,0:36:27.29,0:36:29.09,Lalai,galeri penangkapan2,0,0,0,,Yang Mulia!
Dialog: 0,0:36:32.39,0:36:35.70,Lalai,galeri penangkapan2,0,0,0,,Beraninya anda menjerit dengan kuat? Mana adab kamu?
Dialog: 0,0:36:36.03,0:36:37.07, Lalai,galeri penangkapan2,0,0,0,,Ini adalah kes di sini,
Dialog: 0,0:36:37.90,0:36:41.44,Lalai,galeri tembak2,0,0,0,,raja memberi arahan untuk pergerakan kamu ke Istana Barat.
Dialog: 0,0:36:41.64,0:36:42.70,Lalai,galeri penangkapan2,0,0,0,,Apa?
Dialog: 0,0:36:42.84,0:36:46.31, Lalai, galeri menembak2,0,0,0,,Beraninya dia menghantar saya ke Istana Barat?
Dialog: 0,0:36:48.01,0:36:50.14,Lalai,galeri tembak2,0,0,0,,Dia bawa saya untuk siapa?
Dialog: 0,0:36:57.25,0:36:59.32,Lalai,galeri penangkapan2,0,0,0,,Apa yang kamu lakukan? Buka pintu sekarang.
Dialog: 0,0:36:59.82,0:37:02.62, Lalai, galeri menembak2,0,0,0,,Saya tidak boleh membuka pintu, Yang Mulia.
Dialog: 0,0:37:12.60,0:37:15.67,Lalai,galeri penangkapan2,0,0,0,,Buka pintu ini dengan segera!
Dialog: 0,0:37:16.60,0:37:19.04, Lalai, galeri menembak2,0,0,0,, Ratu telah datang.
Dialog: 0,0:37:43.03,0:37:44.07,Lalai,galeri penangkapan2,0,0,0,,Buka.
Dialog: 0,0:37:55.94,0:37:57.58,Lalai,menembak2,0,0,0,,Saya mendengar bahawa semalam anda berada di ambang,
Dialog: 0,0:37:57.58,0:37:58.95,Lalai,tier2,0,0,0,,tetapi semuanya nampak baik dengan anda.
Dialog: 0,0:37:59.21,0:38:01.28, Lalai, galeri penangkapan2,0,0,0,, Terima kasih kepada anda.
Dialog: 0,0:38:02.65,0:38:04.25,Lalai,galeri penangkapan2,0,0,0,,Nak ke mana?
Dialog: 0,0:38:04.25,0:38:07.59,Lalai,menembak2,0,0,0,,Sejak bila saya perlu memberitahu anda lokasi saya?
Dialog: 0,0:38:07.59,0:38:10.49,Lalai,galeri penangkapan2,0,0,0,,Telah diputuskan untuk menghantar anda ke Istana Barat.
Dialog: 0,0:38:10.96,0:38:13.26, Lalai, galeri penggambaran2,0,0,0,,Sehingga itu, kekal di Dongmyeongjong.
Dialog: 0,0:38:13.63,0:38:15.46,Lalai,galeri penangkapan2,0,0,0,,Anda tidak dibenarkan keluar.
Dialog: 0,0:38:16.10,0:38:19.73,Lalai,galeri penangkapan2,0,0,0,,Adakah anda mengatakan anda mengunci saya di sini?
Dialog: 0,0:38:20.77,0:38:22.40, Lalai, galeri penangkapan2,0,0,0,,Jangan buat saya ketawa.
Dialog: 0,0:38:24.51,0:38:25.57, Lalai, galeri penangkapan2,0,0,0,,Keluar dari jalan!
Dialog: 0,0:38:26.97,0:38:28.51, Lalai, galeri penangkapan2,0,0,0,, Anda tidak boleh keluar.
Dialog: 0,0:38:29.24,0:38:31.21,Lalai,galeri penangkapan2,0,0,0,,Saya suruh awak keluar dari jalan!
Dialog: 0,0:38:33.92,0:38:35.15, Lalai, galeri menembak2,0,0,0,, Permaisuri Janda.
Dialog: 0,0:38:39.12,0:38:42.09, Lalai, galeri menembak2,0,0,0,,Hari terakhir anda akan dihabiskan di istana.
Dialog: 0,0:38:44.49,0:38:46.59,Lalai,galeri tembak2,0,0,0,,Puan Mahkamah Chon, kenapa awak berdiri?
Dialog: 0,0:38:46.59,0:38:47.70,Lalai,galeri penangkapan2,0,0,0,,Ya, Tuanku.
Dialog: 0,0:38:52.47,0:38:54.44, Lalai, galeri menembak2,0,0,0,,Beraninya anda?
Dialog: 0,0:38:54.44,0:38:56.44,Lalai,tier2,0,0,0,,Mereka tidak lagi mematuhi anda.
Dialog: 0,0:38:58.57,0:39:00.27,Lalai,galeri menembak2,0,0,0,,Bertanggungjawab untuk halaman
Dialog: 0,0:39:01.18,0:39:02.21, Lalai, galeri penangkapan2,0,0,0,,sekarang saya.
Dialog: 0,0:39:02.78,0:39:04.38,Lalai,galeri menembak2,0,0,0,,Saya bertanggungjawab ke atas halaman.
Dialog: 0,0:39:04.55,0:39:06.61,Lalai,galeri penangkapan2,0,0,0,,Saya masih di sini!
Dialog: 0,0:39:06.61,0:39:08.55, Lalai, galeri menembak2,0,0,0,,Ini tempat saya!
Dialog: 0,0:39:08.55,0:39:10.59,Lalai,galeri penggambaran2,0,0,0,,Mulai hari ini, semuanya akan berubah,
Dialog: 0,0:39:11.25,0:39:13.19,Lalai,tyra2,0,0,0,,terutama peraturan etika,
Dialog: 0,0:39:13.19,0:39:15.12, Lalai, peringkat2,0,0,0,, ditetapkan oleh anda.
Dialog: 0,0:39:15.32,0:39:18.93, Lalai, galeri penggambaran2,0,0,0,,Ia telah wujud selama beribu-ribu tahun!
Dialog: 0,0:39:19.29,0:39:22.56, Lalai, galeri penangkapan2,0,0,0,,Adakah anda fikir anda boleh menyerahkannya semalaman?
Dialog: 0,0:39:23.66,0:39:25.43,Lalai,tier2,0,0,0,,Mereka sudah semakin lemah.
Dialog: 0,0:39:26.30,0:39:28.04,Lalai,menembak2,0,0,0,,Perubahan yang anda sangat takuti,
Dialog: 0,0:39:29.14,0:39:30.71, Lalai, galeri penangkapan2,0,0,0,,sudah bermula.
Dialog: 0,0:39:46.85,0:39:49.66, Lalai, galeri penangkapan2,0,0,0,, Sial, sungguh menyegarkan!
Dialog: 0,0:39:51.03,0:39:52.06,Lalai,tier2,0,0,0,,
Dialog: 0,0:39:52.79,0:39:55.93,Lalai,galeri menembak2,0,0,0,,Court Lady Choi, apa yang saya katakan tadi?
Dialog: 0,0:39:56.60,0:39:59.57,Lalai,menembak2,0,0,0,,"Sial, sungguh menyegarkan!" -
Dialog: 0,0:40:00.27,0:40:01.80,Lalai,menembak2,0,0,0,,itulah yang anda katakan.
Dialog: 0,0:40:05.17,0:40:08.08,Lalai,galeri menembak2,0,0,0,,Nampaknya, naluri saya yang tersembunyi telah terjaga.
Dialog: 0,0:40:08.88,0:40:10.58, Lalai,galeri penangkapan2,0,0,0,,Ini benar-benar menyegarkan.
Dialog: 0,0:40:11.78,0:40:13.68, Lalai, galeri penangkapan2,0,0,0,,Saya tidak boleh berhenti, sialan.
Dialog: 0,0:40:16.02,0:40:17.05, Lalai, galeri penangkapan2,0,0,0,, Sial.
Dialog: 0,0:40:18.69,0:40:19.89, Lalai, galeri penangkapan2,0,0,0,,Saya sukakannya.
Dialog: 0,0:40:21.72,0:40:24.76, Lalai, galeri penangkapan2,0,0,0,, Kepada anda! Orang jahat!
Dialog: 0,0:40:26.63,0:40:27.66, Lalai, galeri penangkapan2,0,0,0,, Sial.
Dialog: 0,0:40:32.50,0:40:33.80, Lalai, galeri penangkapan2,0,0,0,,Apa yang berlaku di sini?
Dialog: 0,0:40:47.95,0:40:49.52,Lalai,tira2,0,0,0,,"Ibu Ratu Keluarga Cho,
Dialog: 0,0:40:49.52,0:40:51.52,Lalai,tyra2,0,0,0,,bersalah menyebarkan khabar angin,
Dialog: 0,0:40:51.72,0:40:53.42,Lalai,tyra2,0,0,0,,yang mencemarkan nama permaisuri
Dialog: 0,0:40:53.62,0:40:55.36,Lalai,tyra2,0,0,0,,dan memalukan keluarga diraja,
Dialog: 0,0:40:56.26,0:40:58.36,Lalai,menembak2,0,0,0,,sebagai hukuman kerana menyemai kekacauan di negara ini
Dialog: 0,0:40:59.36,0:41:01.16, Lalai, galeri menembak2,0,0,0,,akan dibuang ke Istana Barat."
Dialog: 0,0:41:03.30,0:41:05.30,Lalai,galeri menembak2,0,0,0,,Ini satu lagi konspirasi.
Dialog: 0,0:41:06.27,0:41:09.47, Lalai, galeri penangkapan2,0,0,0,,Saya tidak melakukan apa-apa seperti itu.
Dialog: 0,0:41:09.47,0:41:12.47,Lalai,galeri penangkapan2,0,0,0,,Adakah anda bercakap benar?
Dialog: 0,0:41:14.91,0:41:17.21,Lalai,menembak2,0,0,0,,Saya bersumpah demi kehormatan mendiang raja.
Dialog: 0,0:41:17.58,0:41:20.75,Lalai,menembak2,0,0,0,,Saya tidak melakukan apa-apa seperti itu.
Dialog: 0,0:41:24.72,0:41:25.82,Lalai,galeri penangkapan2,0,0,0,,Enter.
Dialog: 0,0:41:46.14,0:41:48.71, Lalai, galeri menembak2,0,0,0,,"Harta penjenayah berikut akan dirampas,
Dialog: 0,0:41:49.01,0:41:50.38, Lalai, galeri menembak2,0,0,0,, dan mereka sendiri akan disebat 100 kali
Dialog: 0,0:41:50.38,0:41:52.11, Lalai, tyra2,0,0,0,,dan akan dihantar sebagai hamba ke Pulau Jeju.
Dialog: 0,0:41:52.31,0:41:54.85,Lalai,tyra2,0,0,0,,Anak-anak dan isteri mereka tidak akan dihukum.
Dialog: 0,0:41:56.25,0:41:58.02,Lalai,tira2,0,0,0,,Bekas Ahli Dewan Undangan Negeri Kim Byung-hak,
Dialog: 0,0:41:58.49,0:42:00.02,Lalai,tyra2,0,0,0,,bekas penasihat kanan Cho Man-heon,
Dialog: 0,0:42:00.45,0:42:02.19,Lalai,tyra2,0,0,0,,bekas penasihat kiri Kim Seok-keun,
Dialog: 0,0:42:02.19,0:42:03.96,Lalai,tira2,0,0,0,,bekas Menteri Perang Kim Chang-hyuk,
Dialog: 0,0:42:04.43,0:42:06.13, Lalai,tira2,0,0,0,,bekas ketua setiausaha Kim Soheun,
Dialog: 0,0:42:06.49,0:42:08.20,Lalai,tyra2,0,0,0,,bekas Menteri Pegawai Jo Dong-mun
Dialog: 0,0:42:08.80,0:42:10.13, Lalai, galeri penangkapan2,0,0,0,,dan lain-lain daripada senarai ini
Dialog: 0,0:42:10.13,0:42:11.87, Lalai,galeri penangkapan2,0,0,0,,tidak akan dilaksanakan.
Dialog: 0,0:42:11.87,0:42:13.53, Lalai, galeri menembak2,0,0,0,,Harta mereka akan dirampas.
Dialog: 0,0:42:13.53,0:42:15.87,Lalai,tyra2,0,0,0,,Tempoh pemenjaraan mereka ialah 3 tahun."
Dialog: 0,0:42:16.74,0:42:20.11,Lalai,menembak2,0,0,0,,-Ampuni Tuanku.\N-Ampuni Tuanku.
Dialog: 0,0:42:21.28,0:42:23.28,Lalai,nanas 3,0,0,0,,Kami tiada pilihan!
Dialog: 0,0:42:23.74,0:42:26.41,Lalai,nanas 3,0,0,0,,Kim Byungin mengancam kami!
Dialog: 0,0:42:26.41,0:42:29.62,Lalai,nanas 3,0,0,0,,Di fikiran kita
Dialog: 0,0:42:30.15,0:42:33.82, Lalai, nanas 3,0,0,0,, saya tidak pernah terfikir untuk merancang pengkhianatan!
Dialog: 0,0:42:34.19,0:42:36.96,Lalai,nanas 3,0,0,0,,Silakan kami, Yang Mulia!
Dialog: 0,0:42:37.12,0:42:38.89,Lalai,nanas 3,0,0,0,,Semuanya begitu, tuan!
Dialog: 0,0:42:38.89,0:42:41.16,Lalai,nanas 3,0,0,0,,Satu-satunya kesalahan kami ialah,
Dialog: 0,0:42:41.16,0:42:44.07, Lalai, nanas 3,0,0,0,, bahawa kami mempercayai berita kematian anda.
Dialog: 0,0:42:44.37,0:42:47.54,Lalai,nanas 3,0,0,0,,Sikap mudah tertipu adalah dosa kita!
Dialog: 0,0:42:48.60,0:42:49.70,Lalai,nanas 3,0,0,0,,Begitukah?
Dialog: 0,0:42:50.61,0:42:53.57,Lalai,nanas 3,0,0,0,,Kemudian saya akan beritahu anda apa lagi kesalahan anda.
Dialog: 0,0:42:58.41,0:42:59.68,Lalai,nanas 3,0,0,0,,Di Joseon
Dialog: 0,0:43:01.18,0:43:03.32, Lalai, nanas 3,0,0,0,,mereka yang dompetnya penuh dengan syiling dipersalahkan.
Dialog: 0,0:43:04.05,0:43:07.36,Lalai,nanas 3,0,0,0,,Adakah di antara kamu yang miskin?
Dialog: 0,0:43:09.09,0:43:12.56,Lalai,nanas 3,0,0,0,,Memaksa orang biasa bekerja\Sehingga keletihan, anda mengisi perut anda.
Dialog: 0,0:43:12.96,0:43:15.06,Lalai,nanas 3,0,0,0,,Anda terlupa bahawa tugas utama anda ialah
Dialog: 0,0:43:15.06,0:43:16.80,Lalai,nanas 3,0,0,0,,lakukan segala-galanya demi kepentingan rakyat.
Dialog: 0,0:43:17.03,0:43:19.80, Lalai, nanas 3,0,0,0,, Anda bayangkan diri anda di atas ini,\Anda tidak mengambil berat tentang hutang anda.
Dialog: 0,0:43:20.33,0:43:22.10,Lalai,nanas 3,0,0,0,,Orang biasa dipaksa
Dialog: 0,0:43:22.10,0:43:24.14, Lalai, nanas 3,0,0,0,,membajak rupa bumi pergunungan.
Dialog: 0,0:43:24.51,0:43:26.84, Lalai, nanas 3,0,0,0,,Dan anda terus menaikkan dan menaikkan cukai.
Dialog: 0,0:43:27.68,0:43:30.85, Lalai, nanas 3,0,0,0,, Semasa anda hidup dalam kemewahan dan tidak mengetahui masalah,
Dialog: 0,0:43:30.85,0:43:33.55,Lalai,nanas 3,0,0,0,,penduduk Joseon binasa siang dan malam
Dialog: 0,0:43:33.55,0:43:34.98, Lalai, nanas 3,0,0,0,,dari kemiskinan dan kelaparan.
Dialog: 0,0:43:35.32,0:43:36.88, Lalai, nanas 3,0,0,0,,Bagaimana untuk mendapatkan lebih banyak?
Dialog: 0,0:43:36.88,0:43:38.35, Lalai, nanas 3,0,0,0,,Bagaimana untuk menjadi lebih tinggi?
Dialog: 0,0:43:38.35,0:43:39.89, Lalai, nanas 3,0,0,0,,Bagaimana untuk menjadi lebih berpengaruh?
Dialog: 0,0:43:39.89,0:43:41.29,Lalai,nanas 3,0,0,0,,Pernahkah anda memikirkan perkara ini,
Dialog: 0,0:43:41.29,0:43:43.76,Lalai,nanas 3,0,0,0,,bukan penderitaan rakyat saya!
Dialog: 0,0:43:44.33,0:43:45.93, Lalai, nanas 3,0,0,0,, Anda tidak peduli tentang dia!
Dialog: 0,0:43:47.23,0:43:49.36,Lalai,nanas 3,0,0,0,,Hidup manusia penuh dengan siksaan.
Dialog: 0,0:43:53.03,0:43:54.70,Lalai,nanas 3,0,0,0,,Dosa pertama anda ialah,
Dialog: 0,0:43:54.70,0:43:57.57,Lalai,nanas 3,0,0,0,,yang anda bayangkan bahawa hidup anda lebih berharga daripada mereka.
Dialog: 0,0:43:58.14,0:43:59.54,Lalai,nanas 3,0,0,0,,Dosa kedua anda ialah anda
Dialog: 0,0:43:59.54,0:44:01.91, Lalai, nanas 3,0,0,0,,mereka mengejek orang,\Nmenghapuskan sebarang harapan untuk masa depan.
Dialog: 0,0:44:02.41,0:44:04.55,Lalai,nanas 3,0,0,0,,Keputusasaan bapa, kerana mereka tidak berdaya,\Nkeputusasaan raja,
Dialog: 0,0:44:04.55,0:44:06.51,Lalai,nanas 3,0,0,0,,kerana ia tidak berguna untuk negara,
Dialog: 0,0:44:06.51,0:44:08.58, Lalai, nanas 3,0,0,0,, inilah dosa ketiga anda!
Dialog: 0,0:44:10.38,0:44:12.39,Lalai,nanas 3,0,0,0,,Jika mereka memfitnah anda,
Dialog: 0,0:44:13.89,0:44:15.16,Lalai,nanas 3,0,0,0,,ke hadapan.
Dialog: 0,0:44:21.16,0:44:23.66,Lalai,nanas 3,0,0,0,,Ingat dosa anda.
Dialog: 0,0:44:25.57,0:44:26.73,Lalai,nanas 3,0,0,0,,Bertaubat.
Dialog: 0,0:44:27.87,0:44:29.20,Lalai,nanas 3,0,0,0,,Anda hanya
Dialog: 0,0:44:30.74,0:44:32.91, Lalai, nanas 3,0,0,0,,pencuri yang tidak bertanggungjawab.
Dialog: 0,0:44:33.34,0:44:35.28,Lalai,nanas 3,0,0,0,,Tetapi sudah tentu!
Dialog: 0,0:44:41.32,0:44:43.22, Lalai, nanas 3,0,0,0,,-Makhluk!\N-Matilah!
Dialog: 0,0:44:43.22,0:44:46.42, Lalai, nanas 3,0,0,0,,-Binatang!\N-Koyakkannya!
Dialog: 0,0:44:46.42,0:44:48.19, Lalai, nanas 3,0,0,0,,-Matilah!\N-Makhluk!
Dialog: 0,0:44:48.19,0:44:49.59,Lalai,nanas 3,0,0,0,,-Bajingan!\N-Hukum dia!
Dialog: 0,0:44:49.59,0:44:52.19, Lalai, nanas 3,0,0,0,,-Matilah!\N-Makhluk!
Dialog: 0,0:44:52.19,0:44:53.53, Lalai, nanas 3,0,0,0,,-Jadi awak!\N-Bayarlah dosa awak!
Dialog: 0,0:44:53.53,0:44:56.36,Lalai,nanas 3,0,0,0,,-Kau patut mati!\N-Bajingan!
Dialog: 0,0:44:56.36,0:44:58.50,Lalai,nanas 3,0,0,0,,-Melayani anda dengan betul!\N-Mati!
Dialog: 0,0:45:21.96,0:45:23.62, Lalai, nanas 3,0,0,0,, Tinggalkan sahaja di sini.
Dialog: 0,0:45:24.53,0:45:26.46,Lalai,nanas 3,0,0,0,,Tetapi anda sentiasa memakai alat solek.
Dialog: 0,0:45:27.46,0:45:29.53,Lalai,nanas 3,0,0,0,,Saya tahu kamu dilarang meninggalkan Istana Barat
Dialog: 0,0:45:29.53,0:45:31.50, Lalai, nanas 3,0,0,0,, atau berjumpa seseorang.
Dialog: 0,0:45:31.77,0:45:32.97,Lalai,nanas 3,0,0,0,,Tetapi masih...
Dialog: 0,0:45:36.50,0:45:38.84,Lalai,nanas 3,0,0,0,,Saya simpan awak bersama saya,
Dialog: 0,0:45:39.61,0:45:42.21, Lalai, nanas 3,0,0,0,,kerana anda adalah orang yang tidak berotak.
Dialog: 0,0:45:42.74,0:45:45.38,Lalai,nanas 3,0,0,0,,Anda bukanlah salah seorang yang boleh merancang sesuatu secara rahsia.
Dialog: 0,0:45:47.08,0:45:48.22,Lalai,nanas 3,0,0,0,,Betul.
Dialog: 0,0:45:49.38,0:45:52.65,Lalai,nanas 3,0,0,0,,Kita semua menjalani kehidupan secara berbeza.
Dialog: 0,0:45:52.82,0:45:53.89,Lalai,nanas 3,0,0,0,,Yang Mulia,
Dialog: 0,0:45:55.19,0:45:57.89, Lalai, nanas 3,0,0,0,,kenapa awak tidak menjerit kepada saya?
Dialog: 0,0:45:59.63,0:46:02.73, Lalai, nanas 3,0,0,0,,Saya tidak pernah belajar untuk menutup mulut.
Dialog: 0,0:46:03.40,0:46:08.07, Lalai, nanas 3,0,0,0,, Walaupun saya tidak menangis,\Nkenapa awak menangis?
Dialog: 0,0:46:08.50,0:46:10.07,Lalai,nanas 3,0,0,0,,Yang Mulia!
Dialog: 0,0:46:20.68,0:46:22.68, Lalai, nanas 3,0,0,0,,Saya akan bertahan dalam segala-galanya.
Dialog: 0,0:46:28.79,0:46:30.42,Lalai,nanas 3,0,0,0,,Bertahan untuk saya -
Dialog: 0,0:46:31.69,0:46:33.99, Lalai, nanas 3,0,0,0,,bermaksud menang.
Dialog: 0,0:47:27.88,0:47:30.58,Lalai,nanas 3,0,0,0,,Pegang tangan saya sehingga kita keluar dari sini.
Dialog: 0,0:47:31.19,0:47:32.22, Lalai, nanas 3,0,0,0,,Apa yang anda sedang lakukan?
Dialog: 0,0:47:32.29,0:47:33.55,Lalai,nanas 3,0,0,0,,Jika ada kenangan dia,
Dialog: 0,0:47:36.02,0:47:38.29,Lalai,nanas 3,0,0,0,,jadi Soyeon masih dalam diri anda.
Dialog: 0,0:47:41.66,0:47:44.13, Lalai, nanas 3,0,0,0,, Awak jumpa saya lagi, Benin.
Dialog: 0,0:47:46.67,0:47:48.77,Lalai,nanas 3,0,0,0,,Dan saya bersembunyi dengan baik.
Dialog: 0,0:48:34.08,0:48:35.52, Lalai, nanas 3,0,0,0,,-Maaf, ratu.\N-Maaf, ratu.
Dialog: 0,0:48:36.48,0:48:38.89, Lalai, nanas 3,0,0,0,, Gembira mendengar anda sedang berseronok.
Dialog: 0,0:48:41.56,0:48:43.02, Lalai, nanas 3,0,0,0,,-Maaf, ratu.\N-Maaf, ratu.
Dialog: 0,0:48:48.56,0:48:50.63,Lalai,nanas 3,0,0,0,,Engkau telah banyak berubah, Yang Mulia.
Dialog: 0,0:48:52.17,0:48:54.64, Lalai, nanas 3,0,0,0,,Selepas perkahwinan, saya bukan diri saya sendiri, bukan?
Dialog: 0,0:48:56.50,0:48:57.61, Lalai, nanas 3,0,0,0,,Semua kerana,
Dialog: 0,0:48:59.74,0:49:02.81, Lalai, nanas 3,0,0,0,,bahawa tajuk ini\Nmenjadi ujian yang hebat untuk saya.
Dialog: 0,0:49:02.81,0:49:07.25, Lalai, nanas 3,0,0,0,, Tuanku telah berubah sebelum perkahwinan tuanku.
Dialog: 0,0:49:15.69,0:49:18.13,Lalai,nanas 3,0,0,0,,Kemudian saya fikir satu-satunya jalan keluar ialah
Dialog: 0,0:49:19.86,0:49:22.00, Lalai, nanas 3,0,0,0,,ini adalah kematian.
Dialog: 0,0:49:40.51,0:49:44.89,Lalai,nanas 3,0,0,0,,Saya tidak sepatutnya sampai ke sini\NJang Bong-hwan
Dialog: 0,0:49:46.89,0:49:49.09,Lalai,nanas 3,0,0,0,,Adakah anda pulang ke rumah tanpa sebarang masalah?
Dialog: 0,0:49:58.73,0:50:00.53,Lalai,nanas 3,0,0,0,,Yang Mulia!
Dialog: 0,0:50:03.40,0:50:05.04, Lalai, nanas 3,0,0,0,,-Ayah!\N-Tidak boleh!
Dialog: 0,0:50:05.47,0:50:07.34, Lalai, nanas 3,0,0,0,,Sukar untuk anda berjalan, diam!
Dialog: 0,0:50:07.61,0:50:09.78, Lalai, nanas 3,0,0,0,,Saya sendiri yang datang!
Dialog: 0,0:50:14.82,0:50:16.58,Lalai,nanas 3,0,0,0,,-Apakah perasaan anda?\N-Apakah perasaan anda?
Dialog: 0,0:50:17.95,0:50:19.65,Lalai,nanas 3,0,0,0,,Cakap dulu, ayah.
Dialog: 0,0:50:19.65,0:50:21.79, Lalai, nanas 3,0,0,0,,Semuanya baik! Ayuh!
Dialog: 0,0:50:22.56,0:50:23.82, Lalai, nanas 3,0,0,0,,-Saya tidak apa-apa.\N-Saya tidak apa-apa.
Dialog: 0,0:50:30.36,0:50:31.67, Lalai, nanas 3,0,0,0,,Apa khabar?
Dialog: 0,0:50:31.67,0:50:33.17, Lalai, nanas 3,0,0,0,, Perlahan-lahan.
Dialog: 0,0:50:33.17,0:50:34.80,Lalai,nanas 3,0,0,0,,Saya hayati doa anda.
Dialog: 0,0:50:35.20,0:50:36.84,Lalai,nanas 3,0,0,0,,Apabila semasa majlis
Dialog: 0,0:50:36.84,0:50:38.44, Lalai, nanas 3,0,0,0,,pemberontak melanggar pintu pagar,
Dialog: 0,0:50:38.44,0:50:40.97, Lalai, nanas 3,0,0,0,,semua bangsawan terkejut.
Dialog: 0,0:50:41.24,0:50:44.88,Lalai,nanas 3,0,0,0,,Tetapi orang kampung datang ke rumah saya untuk melindungi kami.
Dialog: 0,0:50:45.31,0:50:47.25,Lalai,nanas 3,0,0,0,,Mereka kata saya seorang yang baik hati
Dialog: 0,0:50:47.25,0:50:49.15, Lalai, nanas 3,0,0,0,, dan banyak membantu mereka!
Dialog: 0,0:50:51.05,0:50:54.29, Lalai, nanas 3,0,0,0,,Saya hanya mengikut arahan anda,
Dialog: 0,0:50:54.52,0:50:57.16,Lalai,nanas 3,0,0,0,,jadi saya sangat malu.
Dialog: 0,0:50:58.83,0:51:00.83, Lalai, nanas 3,0,0,0,,Mulai sekarang, anda sendiri boleh bersikap baik.
Dialog: 0,0:51:00.99,0:51:02.90,Lalai,nanas 3,0,0,0,,Sudah tentu.
Dialog: 0,0:51:03.86,0:51:06.07,Lalai,nanas 3,0,0,0,,Saya akan menjadi datuk yang dihormati
Dialog: 0,0:51:06.07,0:51:08.34, Lalai, nanas 3,0,0,0,,untuk anak anda.
Dialog: 0,0:51:11.11,0:51:13.34, Lalai, nanas 3,0,0,0,,Oh, bayi sedang menolak.
Dialog: 0,0:51:14.31,0:51:15.84, Lalai, nanas 3,0,0,0,, Sudah menolak?
Dialog: 0,0:51:21.52,0:51:24.19, Lalai, nanas 3,0,0,0,,Cucu perempuan saya akan menjadi seorang yang genius!
Dialog: 0,0:51:34.10,0:51:36.24, Lalai, nanas 3,0,0,0,,Mungkin bau bawang terlalu kuat?
Dialog: 0,0:51:36.58,0:51:39.12, Lalai, nanas 3,0,0,0,,Apa yang anda masak dengan begitu bersemangat?
Dialog: 0,0:51:40.72,0:51:44.45, Lalai, nanas 3,0,0,0,,Saya ingin mencuba mengulangi ramen,
Dialog: 0,0:51:44.45,0:51:45.78, Lalai, nanas 3,0,0,0,,yang sedang disediakan oleh ratu.
Dialog: 0,0:51:47.66,0:51:51.35, Lalai, nanas 3,0,0,0,,Bolehkah saya makan ramen?
Dialog: 0,0:52:04.41,0:52:05.87, Lalai, nanas 3,0,0,0,, Sabar.
Dialog: 0,0:52:09.08,0:52:11.37, Lalai, nanas 3,0,0,0,,Saya fikir kita akan menang dan kehidupan akan bermula,
Dialog: 0,0:52:12.05,0:52:13.22, Lalai, nanas 3,0,0,0,, dan lebih banyak lagi kerja.
Dialog: 0,0:52:14.72,0:52:16.01, Lalai, nanas 3,0,0,0,,Tiada sesiapa.
Dialog: 0,0:52:16.64,0:52:18.89, Lalai, nanas 3,0,0,0,,Hon Duil!
Dialog: 0,0:52:18.89,0:52:20.58,Lalai,nanas 3,0,0,0,,Saya sibuk! Kemudian kita akan bermain!
Dialog: 0,0:52:21.76,0:52:23.45,Lalai,nanas 3,0,0,0,,Saya bosan berjudi.
Dialog: 0,0:52:24.95,0:52:26.03, Lalai, nanas 3,0,0,0,, Betulkah?
Dialog: 0,0:52:29.62,0:52:32.87,Lalai,nanas 3,0,0,0,,Untuk sumbangan saya kepada kemenangan
Dialog: 0,0:52:32.87,0:52:36.43, Lalai, nanas 3,0,0,0,,raja memberi saya jawatan di mahkamah.
Dialog: 0,0:52:37.93,0:52:39.01, Lalai, nanas 3,0,0,0,, Dan inilah saya
Dialog: 0,0:52:39.74,0:52:41.64, Lalai, nanas 3,0,0,0,, kekal dalam siaran yang sama.
Dialog: 0,0:52:42.85,0:52:44.74,Default,nanas 3,0,0,0,,Minta jawatan menteri?
Dialog: 0,0:52:54.49,0:52:56.16, Lalai, nanas 3,0,0,0,,Apakah raksasa di muka awak itu?
Dialog: 0,0:52:57.28,0:52:59.49, Lalai, nanas 3,0,0,0,, Betapa kuno anda.
Dialog: 0,0:53:02.53,0:53:06.39,Lalai,nanas 3,0,0,0,,Saya kini berkhidmat di jabatan perhubungan luar.
Dialog: 0,0:53:06.80,0:53:11.07, Lalai, nanas 3,0,0,0,,Untuk orang yang berbakat seperti itu\NJoseon sahaja tidak akan mencukupi.
Dialog: 0,0:53:18.58,0:53:20.97, Lalai, nanas 3,0,0,0,,Tahniah kerana berhenti bermain.
Dialog: 0,0:53:21.51,0:53:22.64, Lalai, nanas 3,0,0,0,,Bagaimana dengan tujuannya?
Dialog: 0,0:53:22.64,0:53:24.35, Lalai, nanas 3,0,0,0,, Tahniah atas apa yang anda akan
Dialog: 0,0:53:24.35,0:53:26.05, Lalai, nanas 3,0,0,0,,berjalan sehingga kaki anda letih?
Dialog: 0,0:53:28.18,0:53:32.93, Lalai, nanas 3,0,0,0,,Saya masih terkejut bahawa Lee Senman adalah permaisuri kita.
Dialog: 0,0:53:32.93,0:53:35.87, Lalai, nanas 3,0,0,0,,Dan saya masih terkejut kerana anda tidak mendapatnya dengan segera.
Dialog: 0,0:53:36.10,0:53:38.43, Lalai, nanas 3,0,0,0,, Duil, anda sudah selesai...
Dialog: 0,0:53:39.87,0:53:41.87, Lalai, nanas 3,0,0,0,,Oh! Dan anda di sini.
Dialog: 0,0:53:43.01,0:53:45.03,Lalai,nanas 3,0,0,0,,Lama tidak berjumpa, Jeong Chul!
Dialog: 0,0:53:47.85,0:53:50.87,Lalai,nanas 3,0,0,0,,Jika Lee Senman adalah permaisuri, maka anda...
Dialog: 0,0:53:57.41,0:53:59.32,Lalai,nanas 3,0,0,0,,Anda juga seorang wanita.
Dialog: 0,0:54:01.33,0:54:03.05,Lalai,nanas 3,0,0,0,,Kim Hwan, saya memuja awak.
Dialog: 0,0:54:03.45,0:54:04.85, Lalai, nanas 3,0,0,0,,Anda sangat bijak!
Dialog: 0,0:54:07.39,0:54:10.07, Lalai, nanas 3,0,0,0,,Saya dengar awak diberi jawatan di mahkamah.
Dialog: 0,0:54:10.62,0:54:12.37, Lalai, nanas 3,0,0,0,,Raja sendiri memberikannya kepada saya.
Dialog: 0,0:54:14.53,0:54:15.91, Lalai, nanas 3,0,0,0,,Untuk apakah dosa saya?
Dialog: 0,0:54:23.41,0:54:26.32,Lalai,li,0,0,0,,-Samvol, masuk ke dalam rumah.\N-Baiklah.
Dialog: 0,0:54:30.82,0:54:31.91, Lalai,li,0,0,0,,Kenapa awak ada di sini?
Dialog: 0,0:54:32.16,0:54:34.78, Lalai,li,0,0,0,,Sejuk di luar. Berapa lama anda menunggu?
Dialog: 0,0:54:34.78,0:54:37.39,Lalai,atau,0,0,0,,No. saya cuma...
Dialog: 0,0:54:39.89,0:54:41.12,Lalai,li,0,0,0,,Apa yang berlaku?
Dialog: 0,0:54:49.03,0:54:51.47, Lalai, atau,0,0,0,, Hanya kekejangan.
Dialog: 0,0:54:55.95,0:54:57.58,Lalai,li,0,0,0,,Apa khabar?
Dialog: 0,0:54:59.01,0:55:00.01, Lalai,li,0,0,0,,Okey.
Dialog: 0,0:55:00.62,0:55:02.55,Lalai,li,0,0,0,,Baginda baik-baik saja.
Dialog: 0,0:55:02.55,0:55:03.55, Lalai, atau,0,0,0,,No.
Dialog: 0,0:55:04.68,0:55:05.99,Lalai,li,0,0,0,,Saya bertanya tentang awak.
Dialog: 0,0:55:09.28,0:55:10.43,Lalai,li,0,0,0,,Saya...
Dialog: 0,0:55:22.74,0:55:26.24,Lalai,li,0,0,0,,Keadaan dengan Jabatan Ijeongcheon telah stabil.
Dialog: 0,0:55:26.43,0:55:28.64,Lalai,li,0,0,0,,Terima kasih kepada dia, saya dibanjiri dengan kerja.
Dialog: 0,0:55:31.14,0:55:33.97, Lalai,li,0,0,0,,Jadi, apa yang seterusnya?
Dialog: 0,0:55:34.32,0:55:35.39,Lalai,li,0,0,0,,Saya mahu
Dialog: 0,0:55:36.45,0:55:39.16,Lalai,sama ada,0,0,0,,memberi kuasa kepada setiap orang,
Dialog: 0,0:55:39.82,0:55:42.12,Lalai,atau,0,0,0,,supaya apabila orang berkumpul, mereka mempunyai lebih kuasa daripada saya.
Dialog: 0,0:55:42.85,0:55:46.70,Lalai,atau,0,0,0,,Dengan cara ini pegawai rasuah tidak lagi dapat mengeksploitasi mereka.
Dialog: 0,0:55:47.39,0:55:49.89,Lalai,li,0,0,0,,Saya percaya ini adalah bagaimana ia sepatutnya berakhir
Dialog: 0,0:55:51.80,0:55:53.49,Lalai,li,0,0,0,,ini adalah pertempuran yang sukar
Dialog: 0,0:55:54.64,0:55:56.07,Lalai,li,0,0,0,,dan perjalanan yang indah.
Dialog: 0,0:55:56.74,0:55:58.87,Lalai,li,0,0,0,,Anda ingin mengatakan bahawa saya mempunyai lebih banyak kebimbangan.
Dialog: 0,0:55:58.87,0:56:00.74,Lalai,li,0,0,0,,Mari tamatkan ini.
Dialog: 0,0:56:00.74,0:56:02.30, Lalai,li,0,0,0,,Ya Tuhanku.
Dialog: 0,0:56:05.08,0:56:07.01,Lalai,li,0,0,0,,Jom pulang.
Dialog: 0,0:56:07.01,0:56:08.74, Lalai, atau,0,0,0,,Anda boleh meneruskan pagi esok.
Dialog: 0,0:56:09.45,0:56:10.99,Lalai,li,0,0,0,,Kami tidak akan serasi.
Dialog: 0,0:56:13.16,0:56:14.55,Lalai,li,0,0,0,,Pertama, susun perkara...
Dialog: 0,0:56:14.72,0:56:16.22,Lalai,li,0,0,0,,-Selamat malam.\N-Baiklah.
Dialog: 0,0:56:17.39,0:56:20.10,Lalai,li,0,0,0,,Duil, anda perlu mencipta...
Dialog: 0,0:56:20.35,0:56:21.39,Lalai,li,0,0,0,,Duil!
Dialog: 0,0:56:21.72,0:56:23.66,Lalai,li,0,0,0,,Bodoh sekali.
Dialog: 0,0:56:47.51,0:56:50.26,Lalai,li,0,0,0,,Kamus Ratu
Dialog: 0,0:56:59.33,0:57:01.53,Lalai,atau,0,0,0,,Adakah saya kehilangan sesuatu?
Dialog: 0,0:57:04.97,0:57:06.91,Lalai,li,0,0,0,,Kadang-kadang saya rasa seperti...
Dialog: 0,0:57:10.37,0:57:11.51, Lalai,li,0,0,0,,Dia melakukannya.
Dialog: 0,0:57:12.22,0:57:13.41,Lalai,li,0,0,0,,Dia berjaya.
Dialog: 0,0:57:13.41,0:57:14.45,Lalai,li,0,0,0,,Era pemerintahan Raja Cheoljo
Dialog: 0,0:57:27.26,0:57:30.99,Lalai,li,0,0,0,,Chronicles of King Cheoljo
Dialog: 0,0:57:35.20,0:57:36.20,Lalai,li,0,0,0,,Permaisuriku.
Dialog: 0,0:57:41.14,0:57:42.45, Lalai, atau,0,0,0,,Tidak kelakar?
Dialog: 0,0:58:04.12,0:58:05.20,Lalai,lee,0,0,0,,Jang Bong-hwan!
Dialog: 0,0:58:09.64,0:58:10.70, Lalai,li,0,0,0,,Jangan mendekat.
Dialog: 0,0:58:12.93,0:58:14.68,Lalai,li,0,0,0,,Anda perlu mencari Khan dahulu.
Dialog: 0,0:58:15.08,0:58:17.74,Lalai,adakah,0,0,0,,Tidak, adakah lebih pantas untuk menghubungi media dengan segera?
Dialog: 0,0:58:18.64,0:58:21.64, Lalai,li,0,0,0,,Kenapa awak lari? Dia melakukan perbuatan yang begitu baik!
Dialog: 0,0:58:22.89,0:58:23.95,Lalai,atau,0,0,0,,Perbuatan baik?
Dialog: 0,0:58:25.41,0:58:27.45,Lalai,li,0,0,0,,Kalau begitu kenapa awak ikut saya?
Dialog: 0,0:58:28.08,0:58:29.45,Lalai,atau,0,0,0,,Kami melindungi anda kerana
Dialog: 0,0:58:29.45,0:58:31.22,Lalai,atau,0,0,0,,anda memberikan petua untuk kebaikan awam.
Dialog: 0,0:58:31.55,0:58:32.55,Lalai,adakah,0,0,0,,Baik?
Dialog: 0,0:58:32.55,0:58:35.87, Lalai,li,0,0,0,,Ingat kamera di gudang?
Dialog: 0,0:58:35.87,0:58:37.62,Lalai,li,0,0,0,,Anda membaikinya secara rahsia.
Dialog: 0,0:58:38.10,0:58:39.16, Lalai,li,0,0,0,,Saya?
Dialog: 0,0:58:45.93,0:58:46.93, Lalai,li,0,0,0,,Tunggu.
Dialog: 0,0:58:55.18,0:58:56.99, Lalai, atau,0,0,0,,Adakah anda mengawal kamera?
Dialog: 0,0:58:57.91,0:58:59.95,Lalai,li,0,0,0,,Peliknya ia masih rosak.
Dialog: 0,0:59:00.35,0:59:01.55, Lalai,li,0,0,0,,Kita perlu menangkap pencuri itu.
Dialog: 0,0:59:03.18,0:59:05.16,Lalai,li,0,0,0,,Kenapa awak buat bukan-bukan?
Dialog: 0,0:59:05.45,0:59:06.85, Lalai,li,0,0,0,,Itu tidak seperti anda.
Dialog: 0,0:59:06.85,0:59:09.66, Lalai, atau,0,0,0,, Tepat. Mengapa mereka tidak memberitahu saya lebih awal?
Dialog: 0,0:59:10.26,0:59:11.80,Lalai,li,0,0,0,,Saya sudah melakukan sesuatu.
Dialog: 0,0:59:12.57,0:59:14.14,Lalai,li,0,0,0,,-Apa?\N-Saya menghantar rakaman kamera
Dialog: 0,0:59:14.14,0:59:17.24,Lalai,atau,0,0,0,,percuma dalam media, yang luar biasa bagi saya.
Dialog: 0,0:59:19.43,0:59:21.47,Lalai,li,0,0,0,,Dia berbohong.
Dialog: 0,0:59:21.85,0:59:22.95,Lalai,li,0,0,0,,Ya, betul-betul.
Dialog: 0,0:59:23.45,0:59:26.78,Lalai,lee,0,0,0,,Bonghwan yang saya kenali tidak mempedulikan keadilan.
Dialog: 0,0:59:26.78,0:59:28.62,Lalai,li,0,0,0,,Dia akan datang kepada saya dahulu
Dialog: 0,0:59:28.62,0:59:32.05, Lalai, atau,0,0,0,,dan bersetuju sebelum menghantar rekod. Adakah saya salah?
Dialog: 0,0:59:34.22,0:59:35.22,Lalai,atau,0,0,0,,Betul.
Dialog: 0,0:59:36.18,0:59:37.43,Lalai,li,0,0,0,,Saya memang bajingan.
Dialog: 0,0:59:38.20,0:59:39.22,Lalai,li,0,0,0,,Tetapi anda tahu apa?
Dialog: 0,0:59:40.49,0:59:42.33, Lalai,li,0,0,0,,-Saya telah berubah.\N-Betul ke?
Dialog: 0,0:59:43.16,0:59:44.62, Lalai, sama ada,0,0,0,,-Kenapa?\N-Saya tidak tahu.
Dialog: 0,0:59:45.33,0:59:46.57,Lalai,li,0,0,0,,Saya hanya mahu.
Dialog: 0,0:59:50.87,0:59:52.08,Lalai,li,0,0,0,,Bajingan!
Dialog: 0,0:59:58.45,0:59:59.47,Lalai,lee,0,0,0,,Chief Poo!
Dialog: 0,1:00:01.12,1:00:02.18,Lalai,li,0,0,0,,Chief Poo!
Dialog: 0,1:00:04.32,1:00:06.68,Lalai,li,0,0,0,,-Sial.\N-Moron.
Dialog: 0,1:00:17.26,1:00:19.97,Lalai,li,0,0,0,,Cheoljong berjaya mengubah nasibnya,
Dialog: 0,1:00:20.26,1:00:21.47,Lalai,li,0,0,0,,dan saya juga telah berubah.
Dialog: 0,1:00:23.30,1:00:25.10,Lalai,li,0,0,0,,Tetapi kenapa Pengarah Han masih sama?
Dialog: 0,1:00:29.35,1:00:30.78,Lalai,atau,0,0,0,,
Dialog: 0,1:00:32.91,1:00:34.82,Lalai,li,0,0,0,,Choljo
Dialog: 0,1:00:35.91,1:00:38.85,Lalai,li,0,0,0,,Adakah dunia benar-benar tidak berubah sama sekali?
Dialog: 0,1:00:39.49,1:00:41.66,Lalai,adakah,0,0,0,,Hanya saya dan Cheoljong sahaja yang berubah?
Dialog: 0,1:00:42.76,1:00:44.72,Lalai,lee,0,0,0,,Pencapaian Choljo
Dialog: 0,1:00:44.72,1:00:46.70,Lalai,lee,0,0,0,,Karisma Cholzhdo menggegarkan Joseon hingga ke inti
Dialog: 0,1:00:46.70,1:00:48.72,Lalai,li,0,0,0,,Choljo melaksanakan reformasi rakyat
Dialog: 0,1:00:48.72,1:00:51.10,Lalai,li,0,0,0,,Pencapaian Raja Cheoljo dan Ratu Chhorin
Dialog: 0,1:00:51.10,1:00:52.66,Lalai,li,0,0,0,,Berfungsi sebagai model untuk reformasi raja
Dialog: 0,1:00:52.66,1:00:55.03,Lalai,li,0,0,0,,Choljo meletakkan asas demokrasi
Dialog: 0,1:00:57.26,1:00:59.30,Lalai,li,0,0,0,,-Ulas.\N-Sebutkan beberapa perkataan!
Dialog: 0,1:00:59.30,1:01:01.47,Lalai,li,0,0,0,,-Hanya beberapa perkataan!\N-Adakah anda mengakui pertuduhan?
Dialog: 0,1:01:01.47,1:01:03.45,Lalai,li,0,0,0,,-Di sini!\N-Ulas!
Dialog: 0,1:01:03.45,1:01:05.87, Lalai, adakah ia benar?\N-Adakah anda mengakui pertuduhan itu?
Dialog: 0,1:01:05.87,1:01:08.12,Lalai,ialah,0,0,0,,-Adakah semua kenyataan benar?\N-Adakah ini benar?
Dialog: 0,1:01:08.12,1:01:14.16,Lalai,sama ada,0,0,0,,Pengarah Han telah menggelapkan dana selama bertahun-tahun
Dialog: 0,1:01:18.05,1:01:19.53,Lalai,atau,0,0,0,,Masa sedang berubah.
Dialog: 0,1:01:19.53,1:01:23.20,Lalai,li,0,0,0,,Tetapi pegawai rasuah yang licik sentiasa bertahan.
Dialog: 0,1:01:25.26,1:01:27.87,Lalai,li,0,0,0,,Walaupun terdapat bahagian yang busuk di dunia,
Dialog: 0,1:01:27.87,1:01:30.60,Lalai,atau,0,0,0,,tetapi ia membolehkan anda memotong segmen busuk ini.
Dialog: 0,1:01:32.10,1:01:34.64,Lalai,atau,0,0,0,,Jika anda cuba mengubah hidup anda menjadi lebih baik,
Dialog: 0,1:01:34.64,1:01:36.51,Lalai,li,0,0,0,,anda akan berjaya,
Dialog: 0,1:01:37.55,1:01:39.68,Lalai,li,0,0,0,,seperti saya dan Cheoljong.
Dialog: 0,1:01:58.99,1:02:01.03,Lalai,li,0,0,0,,-Yang Mulia.\N-Apa?
Dialog: 0,1:02:01.03,1:02:02.33,Lalai,atau,0,0,0,,Terbalik.
Dialog: 0,1:02:03.10,1:02:04.14,Lalai,atau,0,0,0,,Tepat sekali.
Dialog: 0,1:02:09.20,1:02:12.22,Lalai,atau,0,0,0,,Yang Mulia, adakah sukar bagi Tuanku untuk menumpukan perhatian?
Dialog: 0,1:02:12.74,1:02:14.85,Lalai,li,0,0,0,,Saya mahu melihat ratu begitu teruk,
Dialog: 0,1:02:15.49,1:02:17.01,Lalai,atau,0,0,0,,bahawa saya tidak dapat memikirkan apa-apa.
Dialog: 0,1:02:20.51,1:02:21.66, Lalai, atau,0,0,0,,Ini tidak akan berfungsi.
Dialog: 0,1:02:22.33,1:02:24.68,Lalai,li,0,0,0,,Saya akan berjumpa dengan permaisuri dan kemudian menguruskan perniagaan.
Dialog: 0,1:02:26.39,1:02:27.39,Lalai,atau,0,0,0,,Seterusnya.
Dialog: 0,1:02:28.33,1:02:30.70,Lalai,li,0,0,0,,Semua wanita mahkamah lebih 18 tahun
Dialog: 0,1:02:31.74,1:02:33.26,Lalai,sama ada,0,0,0,,perkahwinan dibenarkan.
Dialog: 0,1:02:39.30,1:02:40.30,Lalai,atau,0,0,0,,Ya.
Dialog: 0,1:02:40.30,1:02:43.28,Lalai,atau,0,0,0,,Selain itu, kanak-kanak di bawah umur 10 tahun
Dialog: 0,1:02:43.28,1:02:45.47,Lalai,atau,0,0,0,,tidak sepatutnya menjadi pelayan halaman.
Dialog: 0,1:02:47.87,1:02:48.99,Lalai,li,0,0,0,,Dan banyak lagi...
Dialog: 0,1:02:52.89,1:02:55.26,Lalai,li,0,0,0,,Apa seterusnya, Yang Mulia?
Dialog: 0,1:02:59.35,1:03:00.39,Lalai,adakah,0,0,0,,Yang Mulia?
Dialog: 0,1:03:03.26,1:03:04.53,Lalai,lee,0,0,0,,Maaf, Lady Choi.
Dialog: 0,1:03:04.53,1:03:07.37,Lalai,li,0,0,0,,Anda mendapati sukar untuk menumpukan perhatian.
Dialog: 0,1:03:07.66,1:03:10.03,Lalai,li,0,0,0,,Anda baru-baru ini bertemu Baginda.
Dialog: 0,1:03:10.64,1:03:12.53,Lalai,li,0,0,0,,Ini bukan saya. Anak yang merinduinya.
Dialog: 0,1:03:13.24,1:03:14.58,Lalai,atau,0,0,0,,Untuk kesejahteraan kanak-kanak,
Dialog: 0,1:03:14.87,1:03:18.20,Lalai,bolehkah anda,0,0,0,,pergi berjumpa raja sebentar?
Dialog: 0,1:03:18.55,1:03:19.68,Lalai,atau,0,0,0,,Saya setuju.
Dialog: 0,1:03:24.55,1:03:25.62,Lalai,li,0,0,0,,-Yang Mulia.\N-Apa?
Dialog: 0,1:03:25.62,1:03:28.93,Lalai,li,0,0,0,,Baginda menuju ke Dewan Songjeongjong.
Dialog: 0,1:03:29.85,1:03:32.35,Lalai,atau,0,0,0,,Wah. Kami merindui satu sama lain.
Dialog: 0,1:03:35.30,1:03:36.93,Lalai,adalah,0,0,0,,Baginda di Daejojon?
Dialog: 0,1:03:37.22,1:03:38.26,Lalai,li,0,0,0,,Ya.
Dialog: 0,1:03:45.87,1:03:47.87,Lalai,li,0,0,0,,Tunggu, Tuanku!
Dialog: 0,1:03:48.60,1:03:50.85,Lalai,li,0,0,0,,Betapa terujanya dia. Ayuh.
Dialog: 0,1:03:58.68,1:04:01.32,Lalai,li,0,0,0,,Apa itu. Adakah kita merindui satu sama lain lagi?
Dialog: 0,1:04:02.39,1:04:05.45,Lalai,atau,0,0,0,,Tuhan, adakah kami bermain sorok-sorok?
Dialog: 0,1:04:13.49,1:04:14.60,Lalai,atau,0,0,0,,Ini tidak akan berfungsi.
Dialog: 0,1:04:15.64,1:04:16.74,Lalai,li,0,0,0,,Kemudian...
Dialog: 0,1:04:30.39,1:04:31.89,Lalai,li,0,0,0,,Kami akhirnya bertemu.
Dialog: 0,1:04:32.41,1:04:33.45,Lalai,atau,0,0,0,,Selepas,
Dialog: 0,1:04:35.43,1:04:37.39,Lalai,atau,0,0,0,,berapa kali kami merindui satu sama lain.
Dialog: 0,1:04:37.89,1:04:42.39,Lalai,li,0,0,0,,Detik-detik sekejap ini kelihatan seperti selama-lamanya.
Dialog: 0,1:05:14.35,1:05:18.39,Lalai,li,0,0,0,,By the way, kenapa awak bercakap dengan saya secara formal?
Dialog: 0,1:05:19.03,1:05:21.20,Lalai,adakah anda,0,0,0,,Adakah anda menyediakan semacam kejutan lagi?
Dialog: 0,1:06:15.33,1:06:18.04,Lalai,li,0,0,0,,Terima kasih kerana menonton dengan Azaleas
Dialog: 0,1:06:18.77,1:06:20.60,Lalai,lee,0,0,0,,Terima kasih khas kepada Choi Jinhyuk
Dialog: 0,0:20:00.72,0:20:02.72,Lalai,,0,0,0,,

Ulasan: 0,0:13:13.63,0:13:15.18,Lalai,Biryulka,0,0,0,,Taktik menipu: mengalihkan perhatian dari timur dan menyerang dari barat.
Ulasan: 0,0:59:43.56,0:59:44.66,Lalai,li,0,0,0,,Rekod Tulen Dinasti Joseon
Ulasan: 0,1:04:51.30,1:04:55.57,Lalai,li,0,0,0,,Queen Chorin
