Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Бирюлька, Хозяин, Зингер, Фундук
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.05,0:01:06.69,Default,Lily,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.69,0:01:08.83,Default,Lily,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:09.86,0:01:12.73,Default,Lily,0,0,0,,19 episode
Dialog: 0,0:01:57.70,0:01:58.91,Default,Lily,0,0,0,,Siapa kamu?
Dialog: 0,0:02:00.91,0:02:03.71,Default,Lily,0,0,0,,Apa yang kamu lakukan dengan Soyeon?
Dialog: 0,0:02:14.12,0:02:15.39,Default,Lily,0,0,0,,Lepaskan!
Dialog: 0,0:02:17.36,0:02:19.86,Default,Lily,0,0,0,,Jawab jika kamu ingin hidup.
Dialog: 0,0:02:19.86,0:02:21.36,Default,Lily,0,0,0,,Saya tidak melakukan apa pun.
Dialog: 0,0:02:21.36,0:02:23.93,Default,Lily,0,0,0,,Aku baru saja membuka mataku dan mendapati diriku berada di dalam tubuh wanita ini.
Dialog: 0,0:02:27.73,0:02:29.60,Default,Lily,0,0,0,,Di mana Soyeon yang asli?
Dialog: 0,0:02:29.60,0:02:30.84,Default,Lily,0,0,0,,Saya tidak tahu.
Dialog: 0,0:02:30.84,0:02:33.61,Default,Lily,0,0,0,,Saya tidak tahu apakah dia masih hidup atau sudah mati.
Dialog: 0,0:02:39.05,0:02:40.65,Default,Lily,0,0,0,,Aku akan membunuhmu.
Dialog: 0,0:02:52.26,0:02:53.33,Default,Lily,0,0,0,,Benin.
Dialogue: 0,0:03:27.49,0:03:29.33,Default,Lily,0,0,0,,Sudah berapa lama kamu berada di tubuh Soyeon?
Dialog: 0,0:03:30.86,0:03:33.93,Default,Lily,0,0,0,,Sejak hari aku terbangun setelah jatuh ke danau.
Dialogue: 0,0:03:36.44,0:03:38.81,Default,Lily,0,0,0,,Kamu bilang kamu tahu segalanya tentang aku dan Soyeon.
Dialog: 0,0:03:39.61,0:03:42.74,Default,Lily,0,0,0,,Semua ingatannya tiba-tiba teringat kembali padaku.
Dialog: 0,0:03:49.92,0:03:51.08,Default,Lily,0,0,0,,Itu dia.
Dialog: 0,0:04:09.44,0:04:10.57,Default,Lily,0,0,0,,Bangun,
Dialog: 0,0:04:12.34,0:04:14.04,Default,Lily,0,0,0,,kecuali jika kamu ingin mati di sini.
Dialog: 0,0:04:20.05,0:04:22.62,Default,Lily,0,0,0,,Pegang tanganku sampai kita keluar dari sini.
Dialog: 0,0:04:23.38,0:04:25.59,Default,Lily,0,0,0,,-Apa rencanamu?\N-Jika ada kenangannya,
Dialog: 0,0:04:28.12,0:04:30.09,Default,Lily,0,0,0,,jadi Soyeon masih di dalam dirimu.
Dialogue: 0,0:04:33.49,0:04:34.76,Default,Lily,0,0,0,,Coba bertahan.
Dialog: 0,0:04:37.16,0:04:38.33,Default,Lily,0,0,0,,Kamu harus bertahan.
Dialogue: 0,0:04:48.48,0:04:49.64,Default,Lily,0,0,0,,Aku mengetahuinya.
Dialog: 0,0:04:51.75,0:04:53.38,Default,Lily,0,0,0,,Wanita yang kamu cintai...
Dialog: 0,0:04:57.42,0:04:58.59,Default,Lily,0,0,0,,Hentikan.
Dialog: 0,0:04:59.29,0:05:01.59,Default,Lily,0,0,0,,Aku tidak ingin menyakitimu, minggirlah.
Dialogue: 0,0:05:06.06,0:05:07.49,Default,Lily,0,0,0,,Betapa percaya diri!
Dialog: 0,0:05:17.60,0:05:18.67,Default,Lily,0,0,0,,Ambil mereka!
Dialog: 0,0:05:18.67,0:05:20.54,Default,Lily,0,0,0,,Menteri Perang tidak mematuhi perintah!
Dialog: 0,0:05:21.27,0:05:22.98,Default,Lily,0,0,0,,Mulai sekarang, aku yang memberi perintah!
Dialog: 0,0:05:22.98,0:05:23.98,Default,Lily,0,0,0,,-Ya!\N-Ya!
Dialog: 0,0:07:12.00,0:07:13.70,Default,,0,0,0,,Bangun, bangun.
Dialogue: 0,0:07:42.72,0:07:44.05,Default,Lily,0,0,0,,Kamu mengalami pendarahan hebat.
Dialog: 0,0:07:44.05,0:07:45.12,Default,Lily,0,0,0,,Kita harus menghentikannya.
Dialog: 0,0:08:01.70,0:08:02.80,Default,Lily,0,0,0,,Apa ini?
Dialog: 0,0:08:03.14,0:08:06.04,Default,Lily,0,0,0,,Ini adalah daftar konspirator.
Dialog: 0,0:08:06.97,0:08:08.78,Default,Lily,0,0,0,,Lindungi dirimu dengan itu.
Dialogue: 0,0:08:17.35,0:08:20.49,Default,Lily,0,0,0,,Apakah kamu ingat bagaimana kita bermain petak umpet saat masih kecil?
Dialog: 0,0:08:21.15,0:08:23.19,Default,Lily,0,0,0,,Saya akan menghitung sampai 10,
Dialog: 0,0:08:23.19,0:08:24.69,Default,Lily,0,0,0,,dan kamu akan bersembunyi.
Dialog: 0,0:08:25.89,0:08:27.16,Default,Lily,0,0,0,,Ayo pergi bersama.
Dialogue: 0,0:08:28.26,0:08:29.80,Default,Lily,0,0,0,,Dia mengejar kita.
Dialog: 0,0:08:37.97,0:08:39.04,Default,Lily,0,0,0,,Ini tak ada gunanya.
Dialog: 0,0:08:43.01,0:08:44.18,Default,Lily,0,0,0,,Mulai.
Dialog: 0,0:08:44.78,0:08:46.45,Default,Lily,0,0,0,,Dan jangan melihat ke belakang.
Dialog: 0,0:08:47.08,0:08:48.18,Default,Lily,0,0,0,,Tidak.
Dialog: 0,0:08:52.35,0:08:53.82,Default,Lily,0,0,0,,Simpan Soyeon.
Dialog: 0,0:08:54.85,0:08:56.06,Default,Lily,0,0,0,,Langsung.
Dialog: 0,0:09:08.07,0:09:09.64,Default,Lily,0,0,0,,Saya menghitung sampai 10.
Dialog: 0,0:09:29.39,0:09:32.46,Default,Lily,0,0,0,,1, 2, 3...
Dialog: 0,0:09:46.17,0:09:48.34,Default,Lily,0,0,0,,5, 6...
Dialog: 0,0:10:00.72,0:10:02.59,Default,Lily,0,0,0,,Siapa yang mengirimmu?
Dialog: 0,0:10:03.56,0:10:04.72,Default,Lily,0,0,0,,Dan siapa lagi?
Dialogue: 0,0:10:05.46,0:10:06.63,Default,Lily,0,0,0,,Ayahmu.
Dialog: 0,0:10:23.01,0:10:25.48,Default,Lily,0,0,0,,9, 10.
Dialog: 0,0:10:55.61,0:10:58.28,Default,Lily,0,0,0,,Saya meminta Anda untuk tidak melihat ke belakang.
Dialog: 0,0:11:09.36,0:11:10.66,Default,Lily,0,0,0,,Ikuti ratu!
Dialog: 0,0:11:34.41,0:11:35.68,Default,Lily,0,0,0,,Benin.
Dialog: 0,0:11:40.29,0:11:42.69,Default,Lily,0,0,0,,Kemarilah. Ayo jalan-jalan bersama.
Dialog: 0,0:11:44.72,0:11:46.86,Default,Lily,0,0,0,,Saat pertama kali bertemu raja, aku akan menjepit rambutku.
Dialogue: 0,0:11:46.86,0:11:48.63,Default,Lily,0,0,0,,Bisakah kamu membantuku memilih jepit rambut?
Dialog: 0,0:11:49.43,0:11:51.40,Default,Lily,0,0,0,,Dia seharusnya tidak mewah,
Dialog: 0,0:11:51.46,0:11:53.60,Default,Lily,0,0,0,,dan saya juga tidak mau yang biasa.
Dialog: 0,0:11:53.90,0:11:55.37,Default,Lily,0,0,0,,Lihat ke depan.
Dialog: 0,0:12:17.62,0:12:18.83,Default,Lily,0,0,0,,I
Dialog: 0,0:12:23.36,0:12:26.23,Default,Lily,0,0,0,,selalu menatapmu.
Dialogue: 0,0:12:28.40,0:12:30.87,Default,Lily,0,0,0,,Aku melihatmu seperti ini,
Dialogue: 0,0:12:34.74,0:12:36.91,Default,Lily,0,0,0,,kamu sendiri tidak mengetahuinya.
Dialog: 0,0:12:38.28,0:12:39.88,Default,Lily,0,0,0,,Mengapa...
Dialogue: 0,0:12:44.85,0:12:46.49,Default,Lily,0,0,0,,Kenapa aku
Dialog: 0,0:12:48.19,0:12:51.22,Default,Lily,0,0,0,,tidak mengerti?
Dialog: 0,0:13:44.14,0:13:46.08,Default,Lily,0,0,0,,Dia tidak pergi jauh. Temukan dia!
Dialogue: 0,0:14:06.80,0:14:08.17,Default,Lily,0,0,0,,Kemana dia pergi?
Dialog: 0,0:14:10.14,0:14:11.47,Default,Lily,0,0,0,,Cari dimana-mana!
Dialog: 0,0:14:11.47,0:14:12.64,Default,Lily,0,0,0,,-Ya!\N-Ya!
Dialog: 0,0:15:00.99,0:15:02.22,Default,Lily,0,0,0,,Di sana!
Dialogue: 0,0:16:00.35,0:16:02.55,Default,Lily,0,0,0,,Apa yang harus aku lakukan sendiri dengan benda ini?
Dialog: 0,0:16:04.78,0:16:07.22,Default,Lily,0,0,0,,Aku bahkan tidak tahu di mana aku berada.
Dialogue: 0,0:16:10.56,0:16:12.59,Default,Lily,0,0,0,,Apa yang bisa kulakukan?
Dialog: 0,0:16:13.59,0:16:16.90,Default,Lily,0,0,0,,Aku tidak bisa berbuat apa-apa saat orang-orang sekarat di depan mataku!
Dialog: 0,0:16:16.90,0:16:18.46,Default,Lily,0,0,0,,Tidak ada!
Dialog: 0,0:16:25.77,0:16:27.07,Default,Lily,0,0,0,,Inilah akhirnya.
Dialog: 0,0:16:28.14,0:16:29.48,Default,Lily,0,0,0,,Tidak peduli seberapa keras aku mencoba,
Dialog: 0,0:16:32.51,0:16:34.81,Default,Lily,0,0,0,,beberapa hal tidak dimaksudkan untuk terjadi.
Dialog: 0,0:16:51.06,0:16:52.53,Default,Lily,0,0,0,,Oke. Bawa aku pergi.
Dialogue: 0,0:16:55.74,0:16:57.67,Default,Lily,0,0,0,,Lagipula sudah berakhir.
Dialog: 0,0:17:29.67,0:17:32.87,Default,Lily,0,0,0,,Orang yang bangkit dari kematian
Dialog: 0,0:17:36.44,0:17:37.48,Default,Lily,0,0,0,,Ratu.
Dialog: 0,0:17:39.78,0:17:41.15,Default,Lily,0,0,0,,Kamu masih hidup.
Dialog: 0,0:17:41.68,0:17:42.78,Default,Lily,0,0,0,,Saya senang.
Dialog: 0,0:17:43.68,0:17:45.35,Default,Lily,0,0,0,,Saya sangat senang.
Dialog: 0,0:18:02.60,0:18:04.17,Default,Lily,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:18:05.24,0:18:07.47,Default,Lily,0,0,0,,Kamu masih hidup, semuanya akan baik-baik saja.
Dialogue: 0,0:18:08.24,0:18:09.74,Default,Lily,0,0,0,,Hanya itu yang kubutuhkan.
Dialog: 0,0:18:11.31,0:18:13.08,Default,Lily,0,0,0,,Semua orang mati.
Dialog: 0,0:18:13.78,0:18:15.15,Default,Lily,0,0,0,,Nyonya Choi,
Dialog: 0,0:18:15.75,0:18:18.95,Default,Lily,0,0,0,,Hong Young dan Kim Byungin.
Dialog: 0,0:18:20.35,0:18:22.12,Default,Lily,0,0,0,,Semua orang mati.
Dialog: 0,0:18:24.52,0:18:25.79,Default,Lily,0,0,0,,Apakah Kim Byungin sudah mati?
Dialog: 0,0:18:26.39,0:18:28.63,Default,Lily,0,0,0,,Dia mati karena aku.
Dialog: 0,0:18:29.16,0:18:31.80,Default,Lily,0,0,0,,Semua orang mati karena aku.
Dialog: 0,0:18:34.70,0:18:35.80,Default,Lily,0,0,0,,Tenang.
Dialog: 0,0:18:36.10,0:18:38.20,Default,Lily,0,0,0,,Ratuku, tenanglah.
Dialog: 0,0:18:41.24,0:18:42.61,Default,Lily,0,0,0,,Hong Young dan Nyonya Choi
Dialog: 0,0:18:43.71,0:18:45.14,Default,Lily,0,0,0,,hidup.
Dialog: 0,0:18:50.18,0:18:51.22,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:18:52.02,0:18:53.02,Default,Lily,0,0,0,,Hong Young!
Dialog: 0,0:18:59.59,0:19:00.66,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:19:01.26,0:19:02.36,Default,Lily,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:19:02.36,0:19:04.53,Default,Lily,0,0,0,,Saya baik-baik saja. Dimana Nona Choi?
Dialog: 0,0:19:04.83,0:19:07.13,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:19:07.37,0:19:08.47,Default,Lily,0,0,0,,Nyonya Choi.
Dialog: 0,0:19:11.44,0:19:14.24,Default,Lily,0,0,0,,-Oh tidak. Nona Choi.\N-Yang Mulia.
Dialog: 0,0:19:14.87,0:19:18.11,Default,Lily,0,0,0,,Seperti yang diharapkan, berbahaya di luar istana.
Dialogue: 0,0:19:19.15,0:19:20.58,Default,Lily,0,0,0,,Mungkin sakit.
Dialogue: 0,0:19:20.95,0:19:22.58,Default,Lily,0,0,0,,Sangat menyakitkan.
Dialog: 0,0:19:22.92,0:19:25.15,Default,Lily,0,0,0,,Bagaimana bisa.
Dialog: 0,0:19:25.15,0:19:26.19,Default,Lily,0,0,0,,Tuhan.
Dialog: 0,0:19:26.79,0:19:28.95,Default,Lily,0,0,0,,Jangan khawatir,
Dialog: 0,0:19:28.95,0:19:30.59,Default,Lily,0,0,0,,ini artinya aku tidak akan mati.
Dialog: 0,0:19:30.89,0:19:33.26,Default,Lily,0,0,0,,Dengan luka mematikan, aku tidak akan merasakan sakit.
Dialogue: 0,0:19:35.13,0:19:37.06,Default,Lily,0,0,0,,Tapi dia mengayunkan pedangnya.
Dialog: 0,0:19:37.06,0:19:39.33,Default,Lily,0,0,0,,Katakanlah saya beruntung.
Dialog: 0,0:19:39.67,0:19:41.13,Default,Lily,0,0,0,,Kembali!
Dialog: 0,0:19:45.57,0:19:48.17,Default,Lily,0,0,0,,Dia tidak menggunakan pedang dengan baik, itu juga menyelamatkannya.
Dialogue: 0,0:19:53.98,0:19:57.62,Default,Lily,0,0,0,,Aku kira sesuatu terjadi padamu!
Dialog: 0,0:19:58.95,0:20:00.75,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:20:01.42,0:20:04.22,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:20:04.62,0:20:06.53,Default,Lily,0,0,0,,Maaf. Saya tidak mau.
Dialog: 0,0:20:06.53,0:20:07.63,Default,Lily,0,0,0,,-Apakah semuanya baik-baik saja?\N-Ya.
Dialog: 0,0:20:07.63,0:20:08.89,Default,Lily,0,0,0,,Maafkan saya.
Dialog: 0,0:20:11.36,0:20:13.67,Default,Lily,0,0,0,,Dari mana saja Anda, Yang Mulia?
Dialog: 0,0:20:13.67,0:20:16.20,Default,Lily,0,0,0,,Saya mencari di seluruh hutan.
Dialog: 0,0:20:16.54,0:20:18.64,Default,Lily,0,0,0,,Tetapi saya tidak dapat menemukannya.
Dialogue: 0,0:20:19.57,0:20:21.34,Default,Lily,0,0,0,,Banyak orang mencarimu.
Dialogue: 0,0:20:21.84,0:20:25.31,Default,Lily,0,0,0,,Tapi raja menemukanmu.
Dialog: 0,0:20:40.13,0:20:43.46,Default,Lily,0,0,0,,-Yang Mulia.\N-Kami merindukanmu.
Dialogue: 0,0:20:44.43,0:20:47.90,Default,Lily,0,0,0,,Aku senang kamu selamat.
Dialog: 0,0:20:47.90,0:20:50.14,Default,Lily,0,0,0,,Tuhan.
Dialog: 0,0:20:50.87,0:20:51.97,Default,Lily,0,0,0,,Tuhan.
Dialog: 0,0:21:05.62,0:21:07.02,Default,Lily,0,0,0,,Perlu dibilas.
Dialog: 0,0:21:15.43,0:21:16.90,Default,Lily,0,0,0,,Kamu hamil.
Dialog: 0,0:21:18.03,0:21:20.03,Default,Lily,0,0,0,,Kenapa kamu pergi ke hutan?
Dialog: 0,0:21:20.53,0:21:22.00,Default,Lily,0,0,0,,Kamu sudah lama tidak kembali.
Dialogue: 0,0:21:23.07,0:21:24.30,Default,Lily,0,0,0,,Aku mengikutimu.
Dialog: 0,0:21:24.44,0:21:27.01,Default,Lily,0,0,0,,Kamu selalu mengejutkanku.
Dialog: 0,0:21:27.41,0:21:28.94,Default,Lily,0,0,0,,Tidak ada pilihan.
Dialogue: 0,0:21:30.08,0:21:31.68,Default,Lily,0,0,0,,Tanpa kamu di istana
Dialog: 0,0:21:36.12,0:21:37.62,Default,Lily,0,0,0,,seperti gerhana.
Dialog: 0,0:21:38.95,0:21:40.89,Default,Lily,0,0,0,,Ke mana pun aku pergi, selalu ada kegelapan.
Dialog: 0,0:21:43.82,0:21:44.86,Default,Lily,0,0,0,,Ayo
Dialogue: 0,0:21:45.62,0:21:46.86,Default,Lily,0,0,0,,Saya akan menjelaskan apa itu gerhana.
Dialog: 0,0:21:46.86,0:21:49.53,Default,Lily,0,0,0,,Tidak perlu dijelaskan. Saya tahu segalanya.
Dialog: 0,0:21:51.73,0:21:53.33,Default,Lily,0,0,0,,Saya merasakan hal yang sama.
Dialog: 0,0:21:56.90,0:21:58.07,Default,Lily,0,0,0,,Aku merindukanmu.
Dialog: 0,0:22:00.11,0:22:01.84,Default,Lily,0,0,0,,Rasa sakit di jiwaku semakin kuat
Dialogue: 0,0:22:01.84,0:22:03.54,Default,Lily,0,0,0,,tubuh sakit karena luka.
Dialog: 0,0:22:10.38,0:22:13.42,Default,Lily,0,0,0,,Aku tidak akan meninggalkanmu sendirian lagi.
Dialog: 0,0:22:17.06,0:22:18.16,Default,Lily,0,0,0,,Maaf.
Dialog: 0,0:23:13.68,0:23:16.05,Default,Lily,0,0,0,,-Apakah kamu terluka parah?\N-Aku baik-baik saja.
Dialogue: 0,0:23:17.89,0:23:19.99,Default,Lily,0,0,0,,Dengan obat aku akan menjadi seperti baru.
Dialog: 0,0:23:40.04,0:23:42.24,Default,Lily,0,0,0,,Apakah kamu sudah mengetahui siapa yang menyerangmu?
Dialog: 0,0:23:42.91,0:23:44.98,Default,Lily,0,0,0,,Saya melihat wajah yang familier.
Dialog: 0,0:24:00.10,0:24:01.26,Default,Lily,0,0,0,,Pengikut Tonghak!
Dialog: 0,0:24:19.31,0:24:20.78,Default,Lily,0,0,0,,Saya melihat raja.
Dialog: 0,0:24:29.39,0:24:36.53,Default,Lily,0,0,0,,Raja hidup.
Dialog: 0,0:24:37.50,0:24:40.04,Default,Lily,0,0,0,,Raja hidup.
Dialog: 0,0:24:42.67,0:24:43.77,Default,Lily,0,0,0,,Berhenti.
Dialog: 0,0:24:44.31,0:24:46.18,Default,Lily,0,0,0,,Keadaan darurat telah diumumkan.
Dialogue: 0,0:24:46.18,0:24:48.11,Default,Lily,0,0,0,,Beraninya seorang wanita berjalan sendirian?
Dialog: 0,0:24:54.32,0:24:55.82,Default,Lily,0,0,0,,selir Cho yang ditolak.
Dialog: 0,0:24:56.22,0:24:58.42,Default,Lily,0,0,0,,Aku malu tampil di depan umum,
Dialog: 0,0:24:58.42,0:25:01.66,Default,Lily,0,0,0,,ingin mencari udara segar selagi tidak ada orang di sana.
Dialogue: 0,0:25:01.76,0:25:04.23,Default,Lily,0,0,0,,Berbahaya di jalanan sekarang. Kembali.
Dialog: 0,0:25:04.56,0:25:06.93,Default,Lily,0,0,0,,Saya mengerti. Terima kasih.
Dialog: 0,0:25:18.11,0:25:20.38,Default,Lily,0,0,0,,Klan Kim yang rakus mencoba membunuh raja
Dialog: 0,0:25:20.38,0:25:22.38,Default,Lily,0,0,0,,dan menjebak orang yang tidak bersalah.
Dialog: 0,0:25:23.18,0:25:25.18,Default,Lily,0,0,0,,Takdir memutuskan untuk membiarkan raja tetap hidup.
Dialog: 0,0:25:25.48,0:25:28.95,Default,Lily,0,0,0,,Apakah mungkin menduduki singgasana yang sudah diduduki?
Dialog: 0,0:25:28.95,0:25:31.22,Default,Lily,0,0,0,,Raja hidup.
Dialog: 0,0:25:41.03,0:25:43.27,Default,Lily,0,0,0,,Tuan!
Dialog: 0,0:25:44.60,0:25:47.24,Default,Lily,0,0,0,,Tadi di jalanan pak.
Dialogue: 0,0:25:47.40,0:25:50.07,Default,Lily,0,0,0,,Apa yang membuat begitu banyak kebisingan?
Dialog: 0,0:25:55.64,0:25:56.71,Default,Lily,0,0,0,,Tuhan.
Dialog: 0,0:26:00.58,0:26:02.52,Default,Lily,0,0,0,,Raja hidup.
Dialog: 0,0:26:06.19,0:26:07.79,Default,Lily,0,0,0,,Jika demikian, maka ratu
Dialogue: 0,0:26:09.29,0:26:11.16,Default,Lily,0,0,0,,dibiarkan tak sadarkan diri.
Dialog: 0,0:26:15.33,0:26:16.87,Default,Lily,0,0,0,,Jadi,
Dialog: 0,0:26:17.30,0:26:20.44,Default,Lily,0,0,0,,Kim Jwageun melihat menembus Kim Byungin.
Dialog: 0,0:26:20.44,0:26:23.01,Default,Lily,0,0,0,,Aku tidak percaya dia meramalkan pengkhianatan Benin.
Dialog: 0,0:26:24.34,0:26:28.04,Default,Lily,0,0,0,,Pria itu ingin kita bungkam tentang kematian Benin.
Dialog: 0,0:26:28.84,0:26:30.68,Default,Lily,0,0,0,,-Ya, ayah.\N-Namun,
Dialog: 0,0:26:31.11,0:26:34.45,Default,Lily,0,0,0,,kami kini telah menjalin hubungan dengan Jvagyn.
Dialog: 0,0:26:36.72,0:26:38.49,Default,Lily,0,0,0,,Tapi mereka merindukan ratu.
Dialog: 0,0:26:39.79,0:26:41.79,Default,Lily,0,0,0,,Kita harus mencoba
Dialog: 0,0:26:42.93,0:26:44.53,Default,Lily,0,0,0,,menebus kesalahan kan?
Dialog: 0,0:26:54.37,0:26:57.47,Default,Spillik2,0,0,0,,Wow! Jika Anda merebusnya terlalu lama, ia akan melunak sepenuhnya.
Dialog: 0,0:26:57.74,0:26:58.97,Default,Spillik2,0,0,0,,Biarkan dia sendiri.
Dialog: 0,0:26:59.68,0:27:01.88,Default,Spillik2,0,0,0,,Setelah ratu pergi untuk pulih,
Dialog: 0,0:27:01.88,0:27:03.41,Default,Spikyulka2,0,0,0,,dia kehilangan akal sehatnya.
Dialogue: 0,0:27:04.15,0:27:06.11,Default,Spikyulka2,0,0,0,,Mereka bilang kebencian membuatmu lebih terikat daripada cinta.
Dialog: 0,0:27:07.02,0:27:10.09,Default,Spikyulka2,0,0,0,,Saya pikir dia menjadi sangat dekat dengannya saat dia ada di sini.
Dialog: 0,0:27:21.40,0:27:24.27,Default,Spillik2,0,0,0,,Aku tidak percaya raja mati sia-sia.
Dialog: 0,0:27:26.07,0:27:29.30,Default,Spikyulka2,0,0,0,,Dia dengan tulus peduli pada rakyatnya.
Dialog: 0,0:27:35.08,0:27:38.88,Default,Spikyulka2,0,0,0,,Seperti yang diharapkan, kamu sendirian di sini.
Dialog: 0,0:27:42.55,0:27:47.56,Default,Spikyulka2,0,0,0,,Ya, tidak ada yang menungguku di rumah.
Dialog: 0,0:27:49.29,0:27:53.26,Default,Spillik2,0,0,0,,Yang Mulia juga sangat tertekan?
Dialog: 0,0:27:54.03,0:27:57.13,Default,Spiky2,0,0,0,,Aku bahkan tidak tahu harus berkata apa padamu, Nyonya Istana Choi.
Dialogue: 0,0:27:57.33,0:27:59.00,Default,Spikyulka2,0,0,0,,Keberadaanmu
Dialog: 0,0:28:00.14,0:28:02.77,Default,Spikyulka2,0,0,0,,sudah menghibur dan meyakinkanku.
Dialog: 0,0:28:03.77,0:28:06.98,Default,Spikyulka2,0,0,0,,Saya bahkan sempat melupakan keluhannya untuk beberapa saat.
Dialog: 0,0:28:07.08,0:28:10.45,Default,Spikyulka2,0,0,0,,Aku merasakan hal yang sama, terima kasih padamu.
Dialogue: 0,0:28:14.88,0:28:16.49,Default,Spillik2,0,0,0,,Mau makan?
Dialog: 0,0:28:16.49,0:28:17.79,Default,Spillik2,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:28:18.35,0:28:20.09,Default,Spillik2,0,0,0,,Saya sedikit sibuk.
Dialog: 0,0:28:20.52,0:28:24.29,Default,Spillik2,0,0,0,,Tunggu sebentar. Aku punya sesuatu untuk diberikan padamu.
Dialog: 0,0:28:29.43,0:28:30.80,Default,Spillik2,0,0,0,,Aku menyukaimu.
Dialog: 0,0:28:35.57,0:28:36.94,Default,Spillik2,0,0,0,,Aku cinta kamu.
Dialog: 0,0:28:37.94,0:28:39.54,Default,Spikyulka2,0,0,0,,Saya tidak dalam posisi untuk berekspresi
Dialog: 0,0:28:40.28,0:28:43.28,Default,Spilyk2,0,0,0,,perasaan ini, jadi
Dialog: 0,0:28:43.51,0:28:45.65,Default,Spilyk2,0,0,0,,Anda harus
Dialog: 0,0:28:46.82,0:28:49.25,Default,Spilyk2,0,0,0,,temui wanita baik,
Dialog: 0,0:28:50.09,0:28:52.12,Default,Spillik2,0,0,0,,untuk mencerahkan kesepianmu.
Dialog: 0,0:28:56.16,0:28:57.56,Default,Spillit2,0,0,0,,Nyonya Choi.
Dialog: 0,0:29:08.87,0:29:10.97,Default,Spikyulka2,0,0,0,,Saya merasa ada yang tidak beres.
Dialog: 0,0:29:11.97,0:29:13.64,Default,Spillik2,0,0,0,,Bagaimana proses memasaknya?
Dialog: 0,0:29:14.21,0:29:16.18,Default,Spillik2,0,0,0,,Oh tidak!
Dialog: 0,0:29:16.78,0:29:18.35,Default,Spilyk2,0,0,0,,Koki Kerajaan!
Dialog: 0,0:29:18.71,0:29:20.72,Default,Spikyulka2,0,0,0,,Ah, aku merusak segalanya.
Dialog: 0,0:29:20.75,0:29:23.75,Default,Spikyulka2,0,0,0,,Jarang sekali melihat bagaimana juru masak kerajaan merusak makanan.
Dialog: 0,0:29:24.12,0:29:25.25,Default,Spikyulka2,0,0,0,,Apa yang terjadi padamu?
Dialog: 0,0:29:25.25,0:29:27.69,Default,Spillik2,0,0,0,,Tidak ada yang salah denganku. Sesuatu terjadi pada negara ini.
Dialog: 0,0:29:27.79,0:29:29.93,Default,Spikyulka2,0,0,0,,Kepanikan mencengkeram bagian selatan negara itu.
Dialog: 0,0:29:30.19,0:29:32.66,Default,Spikyulka2,0,0,0,,Jadi dalam beberapa hari terakhir belum ada hadiah yang diterima.
Dialog: 0,0:29:32.89,0:29:34.26,Default,Spilyk2,0,0,0,,Koki kerajaan.
Dialog: 0,0:29:35.76,0:29:38.10,Default,Spilyk2,0,0,0,,Saya mendengar permohonan aneh dipasang di jalan-jalan kota.
Dialog: 0,0:29:39.40,0:29:40.94,Default,Spillik2,0,0,0,,Mereka yang menyerang raja...
Dialog: 0,0:29:40.94,0:29:44.34,Default,Spikyulka2,0,0,0,,Jika bukan pengikut tonhak, siapa lagi yang akan melakukan ini?
Dialog: 0,0:29:44.34,0:29:47.81,Default,Spikyulka2,0,0,0,,Kita harus mengeksekusi semuanya. Tangkap dan bunuh!
Dialog: 0,0:29:47.88,0:29:52.68,Default,Spillik2,0,0,0,,Bunuh? Apakah Anda tahu cara melakukan ini?
Dialog: 0,0:29:53.58,0:29:54.75,Default,Spillik2,0,0,0,,Jadi tutup mulutmu.
Dialogue: 0,0:29:55.68,0:29:56.82,Default,Spikyulka2,0,0,0,,Ceritakan padaku.
Dialog: 0,0:30:07.53,0:30:11.70,Default,Spikyulka2,0,0,0,,Saya memakainya terlalu lama. Saya mulai lelah.
Dialog: 0,0:30:12.63,0:30:14.77,Default,Spikyulka2,0,0,0,,Saya pikir sudah waktunya melepasnya.
Dialog: 0,0:30:16.84,0:30:19.37,Default,Spikyulka2,0,0,0,,Kamu bisa mengatasinya kan? Anda bekerja dengan saya selama 10 tahun.
Dialog: 0,0:30:20.41,0:30:21.44,Default,Spilyk2,0,0,0,,Apa?
Dialog: 0,0:30:25.71,0:30:26.88,Default,Spilyk2,0,0,0,,Mau kemana?
Dialog: 0,0:30:26.95,0:30:29.58,Default,Spilyk2,0,0,0,,Dan siapa yang akan memasak?
Dialog: 0,0:30:30.09,0:30:32.89,Default,Spillik2,0,0,0,,Ada banyak di Joseon yang bisa menjadi koki kerajaan.
Dialog: 0,0:30:34.99,0:30:36.19,Default,Spillik2,0,0,0,,Apa yang terjadi?
Dialog: 0,0:30:41.43,0:30:44.63,Default,Spikyulka2,0,0,0,,Dalam beberapa hari terakhir, seruan aneh muncul di jalanan kota.
Dialog: 0,0:30:45.57,0:30:48.04,Default,Spikyulka2,0,0,0,,Mereka bilang kita sedang membicarakan rumor tentang raja.
Dialog: 0,0:30:48.74,0:30:50.11,Default,Spilyk2,0,0,0,,Begitulah adanya.
Dialog: 0,0:30:50.31,0:30:52.54,Default,Spilyk2,0,0,0,,Apakah rumor penting saat ini?
Dialog: 0,0:30:52.87,0:30:55.91,Default,Silk2,0,0,0,,Semuanya akan berakhir setelah penobatan.
Dialog: 0,0:30:56.95,0:30:59.08,Default,Spikyulka2,0,0,0,,Apa yang harus kita khawatirkan sekarang,
Dialog: 0,0:30:59.08,0:31:01.55,Default,Spikyulka2,0,0,0,,jadi inilah surat yang menjadi sandaran hidup kita.
Dialog: 0,0:31:01.85,0:31:05.82,Default,Spikyulka2,0,0,0,,Mencurigakan Kim Byonin tidak terlihat akhir-akhir ini.
Dialog: 0,0:31:07.02,0:31:09.96,Default,Spillik2,0,0,0,,Sang Ratu telah pergi untuk mempersiapkan persalinan.
Dialog: 0,0:31:10.23,0:31:11.79,Default,Spikyulka2,0,0,0,,Dan Kim Byungin juga menghilang?
Dialog: 0,0:31:12.16,0:31:16.57,Default,Spillik2,0,0,0,,Kematian raja dan kepergian ratu.
Dialog: 0,0:31:16.60,0:31:18.37,Default,Spillik2,0,0,0,,Entah kenapa semuanya mencurigakan.
Dialogue: 0,0:31:20.34,0:31:23.74,Default,Spikyulka2,0,0,0,,Dan apakah keduanya bohong?
Dialog: 0,0:31:24.07,0:31:26.24,Default,Spiky2,0,0,0,,Dia menyembunyikan ratu,
Dialog: 0,0:31:26.58,0:31:28.34,Default,Spillie2,0,0,0,,yang menganggap kematian raja hanyalah khayalan,
Dialog: 0,0:31:28.34,0:31:31.08,Default,Spilyk2,0,0,0,,dan memihaknya?
Dialog: 0,0:31:31.08,0:31:33.35,Default,Spikyulka2,0,0,0,,Kemudian Kim Byonin menandatangani surat itu,
Dialog: 0,0:31:34.22,0:31:38.72,Default,Spilyk2,0,0,0,,untuk menghancurkan klan Kim.
Dialog: 0,0:31:44.39,0:31:45.93,Default,Spilyk2,0,0,0,,Dingin.
Dialog: 0,0:31:47.06,0:31:48.16,Default,Spilyk2,0,0,0,,Dingin?
Dialogue: 0,0:31:54.40,0:31:57.01,Default,Spillik2,0,0,0,,Canggung sekali.
Dialog: 0,0:31:59.81,0:32:00.91,Default,Spillik2,0,0,0,,Tunggu sebentar.
Dialog: 0,0:32:10.19,0:32:13.36,Default,Spikyulka2,0,0,0,,Segera setelah kamu pergi, tiba-tiba cuaca menjadi lebih dingin.
Dialogue: 0,0:32:15.62,0:32:18.69,Default,Silk2,0,0,0,,Apakah kamu kedinginan karena aku tidak ada?
Dialog: 0,0:32:23.80,0:32:26.74,Default,Spikyulka2,0,0,0,,Terima kasih atas cintamu yang tak terbatas.
Dialog: 0,0:32:27.34,0:32:30.27,Default,Spikyulka2,0,0,0,,2, 3, 1, 1, 2, 3,
Dialog: 0,0:32:30.27,0:32:31.81,Default,Spikyulka2,0,0,0,,2, 1, 2, 3,
Dialog: 0,0:32:31.81,0:32:34.71,Default,Spillik2,0,0,0,,- 4, 1, 2, 3, 4.\N-Lanjutkan.
Dialog: 0,0:32:35.41,0:32:36.51,Default,Spillik2,0,0,0,,Ini...
Dialog: 0,0:32:37.68,0:32:39.68,Default,Spilyk2,0,0,0,,Pelatihan yang Anda ceritakan.
Dialog: 0,0:32:40.38,0:32:42.32,Default,Spilyk2,0,0,0,,Jadi itu sebabnya Anda menulis buku teks tentang taktik militer.
Dialog: 0,0:32:42.58,0:32:45.39,Default,Spillik2,0,0,0,,Aku tidak percaya raja adalah pengikut donghak.
Dialogue: 0,0:32:48.12,0:32:49.93,Default,Spikyulka2,0,0,0,,Aku bahkan menyembunyikannya dari mereka.
Dialog: 0,0:32:50.86,0:32:54.03,Default,Spikyulka2,0,0,0,,Seperti pedagang yang tidak puas dengan negara yang membantunya.
Dialog: 0,0:32:55.03,0:32:56.90,Default,Spilyk2,0,0,0,,Kenapa kamu melakukan hal berbahaya seperti itu?
Dialogue: 0,0:32:57.20,0:32:59.33,Default,Silk2,0,0,0,,Mereka bilang musuh dari musuhmu adalah temanmu.
Dialog: 0,0:33:00.04,0:33:03.34,Default,Spikyulka2,0,0,0,,Pejabat yang korup adalah musuh kita bersama.
Dialog: 0,0:33:05.04,0:33:07.34,Default,Spikyulka2,0,0,0,,Bukankah cakupannya terlalu kecil?
Dialog: 0,0:33:07.78,0:33:08.88,Default,Spilyk2,0,0,0,,Di mana semua orang?
Dialog: 0,0:33:08.88,0:33:10.58,Default,Silk2,0,0,0,,Apakah kamu ingin kami berkumpul dan membunuh kami sekaligus?
Dialog: 0,0:33:10.91,0:33:13.78,Default,Spillik2,0,0,0,,Semua orang akan berkumpul di waktu yang tepat.
Dialogue: 0,0:33:13.98,0:33:16.55,Default,Spikyulka2,0,0,0,,Sementara itu, lebih aman jika berpisah!
Dialogue: 0,0:33:17.79,0:33:19.39,Default,Spilyk2,0,0,0,,Apakah kamu yang bertanggung jawab di sini?
Dialog: 0,0:33:19.39,0:33:20.49,Default,Spillik2,0,0,0,,Ya, benar.
Dialog: 0,0:33:20.52,0:33:22.59,Default,Spiky2,0,0,0,,1, 2, 3. Empat.
Dialog: 0,0:33:22.59,0:33:24.76,Default,Spillik2,0,0,0,,1, 2, 3. Lima.
Dialog: 0,0:33:24.76,0:33:26.66,Default,Spillik2,0,0,0,,1, 2, 3. Enam.
Dialog: 0,0:33:26.66,0:33:28.70,Default,Spillik2,0,0,0,,1, 2, 3. Tujuh.
Dialog: 0,0:33:29.30,0:33:30.33,Default,Silk2,0,0,0,,-1, ​​​​2, 3. Delapan.\N-Senang bertemu dengan Anda.
Dialog: 0,0:33:30.80,0:33:33.00,Default,Spikyulka2,0,0,0,,Wajahmu menunjukkan bahwa kamulah yang memegang kendali.
Dialog: 0,0:33:33.13,0:33:35.67,Default,Spillik2,0,0,0,,Bekas luka di mata sangat mengesankan.
Dialogue: 0,0:33:36.30,0:33:37.41,Default,Spilyk2,0,0,0,,Senang bertemu anda.
Dialog: 0,0:33:38.47,0:33:41.38,Default,Spikyulka2,0,0,0,,Yang utama di sini adalah yang hidup lebih lama.
Dialog: 0,0:33:41.38,0:33:43.98,Default,Spikyulka2,0,0,0,,Begitu satu mati, yang berikutnya menjadi yang utama.
Dialog: 0,0:33:44.35,0:33:47.55,Default,Spikyulka2,0,0,0,,Menjadi penanggung jawab berarti bertahan paling lama.
Dialog: 0,0:33:48.25,0:33:51.95,Default,Spikyulka2,0,0,0,,Jika aku mati, dia akan menjadi bos di sini.
Dialog: 0,0:33:51.95,0:33:54.36,Default,Spikyulka2,0,0,0,,Sembilan. 1, 2, 3. Sepuluh.
Dialog: 0,0:33:54.49,0:33:55.82,Default,Spillik2,0,0,0,,Bayi ini?
Dialogue: 0,0:33:56.42,0:33:58.43,Default,Spikyulka2,0,0,0,,Kudengar kau dekat dengan Damhyang-ku.
Dialogue: 0,0:33:59.29,0:34:00.46,Default,Spillie2,0,0,0,,Damhyangku?
Dialogue: 0,0:34:01.50,0:34:02.86,Default,Spillik2,0,0,0,,Jadi kamu...
Dialog: 0,0:34:02.86,0:34:05.90,Default,Silk2,0,0,0,,Dia adalah ayah Damhyang yang kami cari.
Dialog: 0,0:34:06.97,0:34:09.30,Default,Spikyulka2,0,0,0,,Orang yang matanya dirusak oleh garpu rumput?
Dialog: 0,0:34:10.24,0:34:11.61,Default,Spilyk2,0,0,0,,Ini dunia kecil!
Dialog: 0,0:34:12.41,0:34:15.71,Default,Spikyulka2,0,0,0,,Jika bukan karena Damhyang, aku pasti sudah membunuh orang ini.
Dialog: 0,0:34:15.71,0:34:17.58,Default,Spikyulka2,0,0,0,,Temui raja sialan itu,\N yang membawa negara ini ke sini,
Dialog: 0,0:34:17.58,0:34:20.35,Default,Spikyulka2,0,0,0,,Aku akan segera menggorok lehernya. Itulah yang saya pikirkan.
Dialog: 0,0:34:21.12,0:34:22.85,Default,Spikyulka2,0,0,0,,Terima kasih kepada putrimu.
Dialog: 0,0:34:22.85,0:34:26.32,Default,Spikyulka2,0,0,0,,Kamu bisa mati saat mencoba membunuhku.
Dialog: 0,0:34:27.06,0:34:28.12,Default,Spillik2,0,0,0,,Apa?
Dialog: 0,0:34:30.33,0:34:31.63,Default,Spillik2,0,0,0,,Seharusnya aku tidak menyelamatkanmu.
Dialogue: 0,0:34:31.63,0:34:34.46,Default,Spikyulka2,0,0,0,,Kau tinggal menghabisinya dengan pisau jerami.
Dialog: 0,0:34:34.46,0:34:35.66,Default,Spillik2,0,0,0,,3. Sepuluh.
Dialogue: 0,0:34:36.33,0:34:38.17,Default,Spikyulka2,0,0,0,,Berapa kali kita harus mengulanginya?
Dialog: 0,0:34:38.63,0:34:40.90,Default,Spillik2,0,0,0,,Kamu harus merasakannya sendiri!
Dialogue: 0,0:34:41.27,0:34:43.20,Default,Spikyulka2,0,0,0,,Haruskah aku mengatakan ini setiap saat?
Dialog: 0,0:34:45.77,0:34:49.21,Default,Spillik2,0,0,0,,Damhyan menyelamatkanmu. Dan dia juga menyelamatkanku.
Dialog: 0,0:34:49.54,0:34:51.75,Default,Spillik2,0,0,0,,Raja tidak meninggalkan rakyatnya.
Dialog: 0,0:34:52.58,0:34:54.25,Default,Spillik2,0,0,0,,Jadi rakyat menyelamatkan raja.
Dialogue: 0,0:34:55.58,0:34:58.35,Default,Silk2,0,0,0,,Ngomong-ngomong, apa yang terjadi dengan prajurit yang mengejarku?
Dialog: 0,0:34:59.42,0:35:01.79,Default,Spikyulka2,0,0,0,,Banyak yang lahir dan besar di sini.
Dialog: 0,0:35:01.79,0:35:03.66,Default,Spillik2,0,0,0,,Mereka adalah pemburu dan pengumpul tumbuhan.
Dialogue: 0,0:35:03.66,0:35:05.46,Default,Spikyulka2,0,0,0,,Kenali gunung seperti punggung tangan.
Dialog: 0,0:35:05.46,0:35:08.33,Default,Spikyulka2,0,0,0,,Para penjaga tidak bisa membawanya ke sini.
Dialog: 0,0:35:08.63,0:35:10.70,Default,Spillik2,0,0,0,,Bagaimana dengan pria aneh bertopeng tokkebi?
Dialog: 0,0:35:10.90,0:35:11.93,Default,Spillik2,0,0,0,,Apakah kamu menangkapnya?
Dialog: 0,0:35:12.03,0:35:13.10,Default,Spillik2,0,0,0,,-Memakai topeng tokkebi?\N- 1, 2,
Dialog: 0,0:35:13.10,0:35:15.77,Default,Spillik2,0,0,0,,3. 1, 2...
Dialogue: 0,0:35:15.77,0:35:17.17,Default,Spikyulka2,0,0,0,,Apakah dia juga mengejarmu?
Dialog: 0,0:35:17.17,0:35:18.67,Default,Spillik2,0,0,0,,Dia mencoba membunuhku.
Dialog: 0,0:35:20.68,0:35:21.84,Default,Spikyulka2,0,0,0,,Kim Byungin meninggal,
Dialog: 0,0:35:23.91,0:35:25.28,Default,Spillik2,0,0,0,,mencoba menghentikannya.
Dialog: 0,0:35:26.48,0:35:27.98,Default,Spilyk2,0,0,0,,Pria bertopeng
Dialog: 0,0:35:28.95,0:35:30.59,Default,Spillik2,0,0,0,,melayani Kim Jwageun.
Dialog: 0,0:35:33.12,0:35:34.99,Default,Spikyulka2,0,0,0,,Kim Jwageun kembali.
Dialog: 0,0:35:36.32,0:35:37.39,Default,Spiky2,0,0,0,,1, 2, 3. Tujuh.
Dialog: 0,0:35:37.39,0:35:40.06,Default,Spillik2,0,0,0,,1, 2, 3. Delapan.
Dialog: 0,0:35:40.06,0:35:41.90,Default,Spillik2,0,0,0,,1, 2, 3. Sembilan.
Dialog: 0,0:35:41.90,0:35:43.77,Default,Spillik2,0,0,0,,1, 2, 3. Sepuluh.
Dialog: 0,0:35:45.27,0:35:46.50,Default,menembak 3,0,0,0,,Langsung "Death Note".
Dialog: 0,0:35:46.70,0:35:48.17,Default,menembak 3,0,0,0,,Berikut nama seluruh ofisial,
Dialog: 0,0:35:48.17,0:35:49.54,Default, galeri menembak3,0,0,0,,yang perlu dihapus.
Dialog: 0,0:35:51.81,0:35:54.38,Default,menembak 3,0,0,0,,Masih mencari cara untuk kembali ke istana.
Dialog: 0,0:35:55.04,0:35:56.18,Default,menembak 3,0,0,0,,Jika Anda mengumpulkan semua orang,
Dialogue: 0,0:35:56.18,0:35:58.31,Default,shooting gallery3,0,0,0,,siapa yang ada di pihak kita, berapa banyak yang bisa kita rekrut?
Dialog: 0,0:35:58.78,0:36:00.98,Default,tier3,0,0,0,,Jika dikumpulkan dari seluruh negeri,
Dialog: 0,0:36:00.98,0:36:02.88,Default, galeri menembak3,0,0,0,,lalu sekitar 1000 orang.
Dialogue: 0,0:36:03.18,0:36:05.45,Default,shooting gallery3,0,0,0,,-Dan itu saja?\N-Itu banyak.
Dialog: 0,0:36:06.02,0:36:07.79,Default,menembak 3,0,0,0,,Mempertaruhkan nyawamu tidaklah mudah.
Dialogue: 0,0:36:08.49,0:36:10.19,Default,menembak 3,0,0,0,,Lalu kenapa mereka tidak membunuh gubernurnya?
Dialog: 0,0:36:10.36,0:36:12.06,Default,galeri tembak3,0,0,0,,Singkirkan mereka dan menangkan perang.
Dialogue: 0,0:36:12.06,0:36:14.63,Default,shooting gallery3,0,0,0,,Apakah menurutmu kami ini sejenis hyena yang haus darah?
Dialogue: 0,0:36:15.16,0:36:17.57,Default,tyra3,0,0,0,,Bahkan orang rendahan seperti kita,
Dialog: 0,0:36:17.57,0:36:20.30,Default,tyra3,0,0,0,,bersatu, mereka bisa menimbulkan ketakutan pada penguasa.
Dialog: 0,0:36:20.97,0:36:22.30,Default,menembak 3,0,0,0,,Itu adalah rencana kami.
Dialog: 0,0:36:23.41,0:36:25.81,Default,menembak3,0,0,0,,Begitu. Jadi Anda ingin menarik perhatian?
Dialog: 0,0:36:26.37,0:36:27.88,Default,tier3,0,0,0,,Ini adalah strategi yang bagus.
Dialog: 0,0:36:27.88,0:36:30.45,Default,tier3,0,0,0,,Anda tidak memberi mereka alasan untuk mulai berperang melawan Anda.
Dialog: 0,0:36:30.88,0:36:32.55,Default,menembak3,0,0,0,,Mungkin kita bodoh,
Dialog: 0,0:36:32.55,0:36:35.68,Default,tier3,0,0,0,,tapi kami tahu kalau kami berhadapan langsung, kami akan kalah.
Dialogue: 0,0:36:36.62,0:36:39.39,Default,tier3,0,0,0,,Mereka mengumpulkan 1000 prajurit.
Dialog: 0,0:36:42.82,0:36:45.06,Default,menembak3,0,0,0,,Aku mempertaruhkan nyawaku demi negara!
Dialogue: 0,0:36:45.06,0:36:47.20,Default,shooting gallery3,0,0,0,,Apa menurutmu aku merencanakan sesuatu?
Dialog: 0,0:36:47.50,0:36:49.63,Default,menembak3,0,0,0,,-Koki kerajaan?\N-Luar biasa.
Dialog: 0,0:36:50.23,0:36:51.37,Default,menembak 3,0,0,0,,Koki kerajaan?
Dialog: 0,0:36:51.93,0:36:53.94,Default,menembak3,0,0,0,,Bagaimana kita bisa mempercayai pria dari istana?
Dialog: 0,0:36:55.14,0:36:56.70,Default,menembak 3,0,0,0,,Yah, tentu saja.
Dialog: 0,0:36:56.97,0:36:59.61,Default,tier3,0,0,0,,Oke. Saya akan kembali. Lepaskan ikatanku.
Dialog: 0,0:37:02.31,0:37:04.78,Default,menembak 3,0,0,0,,Oke. Aku akan melepaskannya sendiri.
Dialogue: 0,0:37:04.78,0:37:06.55,Default,shooting gallery3,0,0,0,,Kenapa kamu kelihatan marah sekali?
Dialog: 0,0:37:06.92,0:37:10.12,Default,menembak3,0,0,0,,Kamu pasti lebih muda dariku. Dimana sopan santunmu?
Dialog: 0,0:37:10.35,0:37:11.82,Default,galeri tembak3,0,0,0,,Jika kamu memohon padaku, aku tidak akan tinggal!
Dialog: 0,0:37:12.75,0:37:13.76,Default,menembak 3,0,0,0,,Minggir!
Dialog: 0,0:37:15.66,0:37:17.49,Default,menembak 3,0,0,0,,Kamu datang atas kemauanmu sendiri,
Dialog: 0,0:37:17.49,0:37:19.19,Default,menembak 3,0,0,0,,tapi kamu tidak akan bisa keluar seperti itu.
Dialogue: 0,0:37:20.56,0:37:23.00,Default,shooting gallery3,0,0,0,,Semacam situasi familiar.
Dialog: 0,0:37:23.00,0:37:24.67,Default,menembak 3,0,0,0,,Anda melihat semua wajah kami.
Dialogue: 0,0:37:24.67,0:37:26.33,Default,shooting gallery3,0,0,0,,Dan mereka bahkan mengetahui tentang tempat ini.
Dialog: 0,0:37:26.94,0:37:28.37,Default,menembak 3,0,0,0,,Apakah kamu pikir kamu bisa tetap hidup?
Dialog: 0,0:37:29.07,0:37:30.07,Default,menembak3,0,0,0,,Apa?
Dialog: 0,0:37:30.74,0:37:31.81,Default,menembak 3,0,0,0,,Di Sini.
Dialog: 0,0:37:32.34,0:37:34.34,Default,menembak 3,0,0,0,,Sialan. Tidak perlu.
Dialog: 0,0:37:34.61,0:37:35.84,Default,menembak 3,0,0,0,,Royal Chef.
Dialog: 0,0:37:37.15,0:37:40.72,Default,menembak 3,0,0,0,,Sepertinya waktuku telah tiba. Anda akan mendengar sesuatu seperti ini.
Dialog: 0,0:37:41.38,0:37:42.78,Default,menembak 3,0,0,0,,Manbok.
Dialog: 0,0:37:48.26,0:37:50.56,Default,menembak 3,0,0,0,,Yang Mulia! Kenapa kamu...
Dialog: 0,0:37:52.16,0:37:53.70,Default,menembak 3,0,0,0,,Yang Mulia!
Dialog: 0,0:37:57.97,0:37:59.07,Default,menembak 3,0,0,0,,Koki Kerajaan!
Dialog: 0,0:37:59.87,0:38:01.80,Default,menembak3,0,0,0,,Nyonya Choi!
Dialog: 0,0:38:10.98,0:38:12.75,Default,tyra3,0,0,0,,Nyonya Choi.
Dialog: 0,0:38:12.75,0:38:15.15,Default,tira3,0,0,0,,-Koki kerajaan.\N-Nyonya Istana Choi.
Dialog: 0,0:38:15.85,0:38:17.32,Default,menembak 3,0,0,0,,Apa yang terjadi?
Dialog: 0,0:38:18.12,0:38:20.12,Default,menembak3,0,0,0,,Siapa yang melakukan ini?
Dialog: 0,0:38:20.12,0:38:21.76,Default,menembak 3,0,0,0,,Apa ini?
Dialog: 0,0:38:22.92,0:38:25.69,Default,menembak3,0,0,0,,-Royal Chef.\N-Saya tahu Anda akan menyelamatkan saya.
Dialog: 0,0:38:31.90,0:38:33.94,Default,menembak 3,0,0,0,,Apa yang membawamu ke sini?
Dialog: 0,0:38:34.20,0:38:35.54,Default,menembak 3,0,0,0,,Yang Mulia.
Dialog: 0,0:38:36.34,0:38:39.21,Default,tyra3,0,0,0,,Kudengar semua orang yang tidak bahagia di negeri ini datang ke sini.
Dialog: 0,0:38:39.21,0:38:40.78,Default,galeri tembak3,0,0,0,,Jadi aku pergi.
Dialog: 0,0:38:40.78,0:38:44.11,Default,menembak 3,0,0,0,,Dan orang-orang yang menghilang dari istana juga ada di sini.
Dialog: 0,0:38:45.35,0:38:48.75,Default,tyra3,0,0,0,,Koki kerajaan, apakah kamu tidak bahagia di negara ini?
Dialog: 0,0:38:49.05,0:38:50.92,Default,galeri tembak3,0,0,0,,Menonton apa yang terjadi di istana,
Dialog: 0,0:38:50.92,0:38:53.45,Default,tier3,0,0,0,,bahkan aku, yang paling bahagia, menjadi tidak bahagia.
Dialog: 0,0:38:53.66,0:38:55.39,Default,menembak 3,0,0,0,,Apa yang terjadi di istana?
Dialog: 0,0:38:55.39,0:38:57.26,Default,menembak3,0,0,0,,Tentang ini, Yang Mulia.
Dialog: 0,0:39:00.96,0:39:02.16,Default,menembak 3,0,0,0,,Ganti baju dulu.
Dialog: 0,0:39:02.16,0:39:04.93,Default,tira3,0,0,0,,Dan lindungi diri Anda saat bersin.
Dialogue: 0,0:39:16.68,0:39:18.81,Default,shooting3,0,0,0,,Besok adalah upacara penobatan.
Dialog: 0,0:39:18.81,0:39:20.88,Default,menembak 3,0,0,0,,Setiap detik berarti.
Dialog: 0,0:39:21.22,0:39:22.68,Default,tier3,0,0,0,,Anda melakukan pekerjaan dengan baik.
Dialogue: 0,0:39:22.68,0:39:24.89,Default,tyra3,0,0,0,,Ngomong-ngomong, kenapa pengikut donghak
Dialogue: 0,0:39:24.89,0:39:27.62,Default,menembak 3,0,0,0,,mereka semakin menolak, karena kita sudah mengekang mereka?
Dialog: 0,0:39:28.42,0:39:31.33,Default,menembak3,0,0,0,,Kabar buruk sampai padaku.
Dialogue: 0,0:39:31.33,0:39:34.13,Default,tier3,0,0,0,,Faktanya semakin lawan mundur,
Dialog: 0,0:39:34.13,0:39:37.30,Default,tier3,0,0,0,,semakin Anda membenarkan diri sendiri dan bertindak semakin kasar.
Dialogue: 0,0:39:37.30,0:39:41.74,Default,tier3,0,0,0,,Jadi satu-satunya solusi adalah memberi mereka pelajaran yang lebih keras.
Dialog: 0,0:39:42.17,0:39:43.30,Default,menembak3,0,0,0,,Setelah upacara
Dialog: 0,0:39:43.30,0:39:45.31,Default, lapangan tembak 3,0,0,0,,Saya akan menggunakan senjata untuk mendapatkan kembali kendali.
Dialog: 0,0:39:47.61,0:39:49.48,Default,menembak 3,0,0,0,,Aku sudah lama tidak melihatmu memegang pedang.
Dialogue: 0,0:39:50.04,0:39:52.15,Default,shooting gallery3,0,0,0,,Apakah istana sudah tidak aman lagi?
Dialog: 0,0:39:52.28,0:39:54.68,Default,tier3,0,0,0,,Ini adalah hadiah dari ratu.
Dialog: 0,0:39:55.48,0:39:57.89,Default,menembak3,0,0,0,,-Ratu?\N-Sebenarnya,
Dialogue: 0,0:39:59.15,0:40:01.96,Default,shooting3,0,0,0,,Sepertinya aku punya kabar buruk untukmu.
Dialog: 0,0:40:02.82,0:40:04.46,Default,tira3,0,0,0,,Benin mengorbankan dirinya,
Dialog: 0,0:40:04.46,0:40:06.23,Default,menembak 3,0,0,0,,untuk menyelamatkan ratu.
Dialogue: 0,0:40:06.66,0:40:08.00,Default,shooting gallery3,0,0,0,,Begitulah adanya.
Dialogue: 0,0:40:10.77,0:40:14.17,Default,tier3,0,0,0,,Satu-satunya kelemahan masa muda adalah kebodohan:
Dialog: 0,0:40:14.17,0:40:16.40,Default,menembak3,0,0,0,,mengorbankan segalanya demi perasaan sekilas.
Dialog: 0,0:40:18.21,0:40:21.78,Default,menembak 3,0,0,0,,Jadi ratu selamat?
Dialog: 0,0:40:23.01,0:40:24.05,Default,tier3,0,0,0,,Ya.
Dialog: 0,0:40:26.11,0:40:28.38,Default,menembak 3,0,0,0,,Raja menyelamatkan ratu.
Dialog: 0,0:40:29.52,0:40:32.62,Default,tyra3,0,0,0,,Jadi, itu berarti mereka berdua masih hidup?
Dialog: 0,0:40:34.59,0:40:35.92,Default,tier3,0,0,0,,Ini membuat saya berpikir:
Dialog: 0,0:40:35.92,0:40:38.29,Default,tier3,0,0,0,,tidak ada yang bisa diandalkan di sini, atau apakah mereka secerdas itu?
Dialog: 0,0:40:38.66,0:40:41.50,Default,menembak 3,0,0,0,,Maaf. Oleh karena itu...
Dialogue: 0,0:40:46.70,0:40:49.47,Default,shooting3,0,0,0,,Waktu kita mencoba
Dialog: 0,0:40:49.47,0:40:51.67,Default,tyra3,0,0,0,,berikan ratu arsenik,
Dialog: 0,0:40:53.04,0:40:55.31,Default,tyra3,0,0,0,,raja mengetahui hal ini dan berlari.
Dialog: 0,0:41:04.22,0:41:05.35,Default,menembak3,0,0,0,,Menurutku,
Dialog: 0,0:41:08.09,0:41:12.09,Default,menembak 3,0,0,0,,ada tikus yang mendengarkan selama ini.
Dialog: 0,0:41:20.87,0:41:23.67,Default,tier3,0,0,0,,Anda memberikannya kepada saya sebagai hadiah.
Dialog: 0,0:41:23.94,0:41:26.34,Default,menembak 3,0,0,0,,Anda secara pribadi membutakan dan membuatnya pingsan.
Dialog: 0,0:41:26.34,0:41:27.94,Default,tyra3,0,0,0,,Saya terlalu sensitif,
Dialog: 0,0:41:27.94,0:41:29.58,Default,menembak3,0,0,0,,tampaknya, karena upacara yang akan datang.
Dialog: 0,0:41:34.62,0:41:36.58,Default,menembak 3,0,0,0,,Saya mengerti semuanya.
Dialog: 0,0:41:36.85,0:41:38.95,Default,pemotretan 3,0,0,0,,Kami akan mengadakan upacaranya sesegera mungkin.
Dialog: 0,0:41:40.72,0:41:45.33,Default,tier3,0,0,0,,Jangan lupa mereka berdua sudah mengalahkanmu satu kali.
Dialogue: 0,0:41:46.36,0:41:47.93,Default,menembak 3,0,0,0,,Aku pertaruhkan nyawaku
Dialog: 0,0:41:49.06,0:41:50.77,Default,tingkat 3,0,0,0,,untuk pertempuran ini.
Dialog: 0,0:41:57.77,0:41:59.07,Default,menembak3,0,0,0,,Saya punya ide.
Dialogue: 0,0:41:59.61,0:42:02.48,Default,shooting gallery3,0,0,0,,Kita akan bisa melewati gerbang di Hanyang dan istana.
Dialog: 0,0:42:04.45,0:42:06.78,Default,menembak 3,0,0,0,,Dan apa yang kamu temukan?
Dialog: 0,0:42:06.78,0:42:09.78,Default,tira3,0,0,0,,Orang-orang ini terbiasa makan makanan segar.
Dialogue: 0,0:42:09.78,0:42:12.05,Default,tyra3,0,0,0,,Berapa lama mereka bisa bertahan tanpa makanan segar?
Dialogue: 0,0:42:12.82,0:42:15.29,Default,tier3,0,0,0,,Janda Ratu sangat pemilih.
Dialog: 0,0:42:15.96,0:42:17.19,Default,menembak 3,0,0,0,,Dia tidak akan bertahan lama.
Dialog: 0,0:42:25.40,0:42:26.60,Default,menembak3,0,0,0,,Bukan ini.
Dialog: 0,0:42:28.20,0:42:29.20,Default,tier3,0,0,0,,Ke.
Dialog: 0,0:42:30.07,0:42:31.11,Default,tier3,0,0,0,,Ke.
Dialog: 0,0:42:35.51,0:42:36.61,Default,tier3,0,0,0,,Oleh karena itu
Dialog: 0,0:42:37.61,0:42:40.82,Default,menembak 3,0,0,0,,pintu ini tidak akan ditutup dalam keadaan apa pun.
Dialog: 0,0:42:42.32,0:42:44.02,Default,tier3,0,0,0,,Bahan makanan dikirimkan melaluinya.
Dialog: 0,0:42:50.19,0:42:53.39,Default,tier3,0,0,0,,Kita perlu mencari tahu tentang kereta untuk persembahan kerajaan.
Dialog: 0,0:42:53.83,0:42:56.70,Default,tyra3,0,0,0,,Istana mempunyai sistem menyeluruh untuk persembahan kerajaan.
Dialog: 0,0:42:56.70,0:43:01.37,Default,tyra3,0,0,0,,Lebih dari 50 gerobak seperti itu datang ke dapur kerajaan setiap hari.
Dialog: 0,0:43:01.37,0:43:04.41,Default,tier3,0,0,0,,Selain itu, ada penawaran bulanan khusus.
Dialog: 0,0:43:04.41,0:43:07.28,Default,tier3,0,0,0,,Dan ada juga persembahan yang datang setiap 4 bulan sekali.
Dialog: 0,0:43:08.71,0:43:11.48,Default,pemotretan3,0,0,0,,-Lebih sederhana. Langsung saja ke intinya.\N-Oke.
Dialog: 0,0:43:11.88,0:43:13.98,Default,galeri tembak3,0,0,0,,62 kereta akan tiba di istana
Dialog: 0,0:43:13.98,0:43:16.05,Default,menembak3,0,0,0,,pada pagi hari upacara.
Dialog: 0,0:43:16.05,0:43:18.32,Default,menembak3,0,0,0,,Tetapi keadaan darurat telah diumumkan.
Dialog: 0,0:43:18.69,0:43:22.56,Default,tier3,0,0,0,,Saya yakin persembahan kerajaan akan diperiksa dengan perhatian khusus.
Dialogue: 0,0:43:22.56,0:43:26.33,Default,shooting3,0,0,0,,Tetapi bagaimana jika ada kereta yang tidak diketahui siapa pun?
Dialog: 0,0:43:28.33,0:43:29.63,Default,menembak 3,0,0,0,,Keranjang Inspektur.
Dialogue: 0,0:43:32.37,0:43:34.27,Default,shooting gallery3,0,0,0,,Nah, akhirnya kamu tiba di sini.
Dialog: 0,0:43:34.27,0:43:37.77,Default,menembak 3,0,0,0,,Keranjang ini milik kita. Lewati mereka.
Dialog: 0,0:43:38.57,0:43:39.74,Default,menembak3,0,0,0,,-Oke. Masuklah.\N-Ya.
Dialog: 0,0:43:39.74,0:43:40.98,Default,menembak 3,0,0,0,,Kepala Inspektur
Dialog: 0,0:43:40.98,0:43:42.68,Default,tier3,0,0,0,,biasanya menukar kereta.
Dialog: 0,0:43:43.08,0:43:44.25,Default,tier3,0,0,0,,Swap?
Dialog: 0,0:43:44.25,0:43:46.51,Default,menembak3,0,0,0,,Yah, tidak semua pejabat pilih-pilih.
Dialog: 0,0:43:46.51,0:43:48.45,Default,tier3,0,0,0,,Dia mengubah beberapa penawaran
Dialog: 0,0:43:48.45,0:43:50.42,Default,tier3,0,0,0,,untuk produk dengan kualitas sedikit lebih rendah.
Dialog: 0,0:43:50.42,0:43:52.42,Default,galeri tembak3,0,0,0,,Dan ada inspektur di dalam kereta
Dialog: 0,0:43:52.42,0:43:54.92,Default,tyra3,0,0,0,,produk yang dia tukarkan persembahannya.
Dialogue: 0,0:43:55.29,0:43:57.96,Default,shooting3,0,0,0,,Dan hanya segelintir orang yang mengetahuinya.
Dialogue: 0,0:43:57.96,0:43:59.86,Default,tier3,0,0,0,,Saya mengetahuinya.
Dialogue: 0,0:43:59.86,0:44:02.46,Default,HAZELT,0,0,0,,Ini bukan istana, tapi sarang pencuri.
Dialog: 0,0:44:03.46,0:44:04.83,Default,HAZELT,0,0,0,,Maaf.
Dialog: 0,0:44:04.83,0:44:06.43,Default,HAZELT,0,0,0,,Saya pikir itu perlu.
Dialog: 0,0:44:08.10,0:44:11.14,Default,HAZELT,0,0,0,,Kayu busuk berlubang.
Dialogue: 0,0:44:13.07,0:44:14.84,Default,HAZELT,0,0,0,,Dan kita bisa menggunakannya.
Dialogue: 0,0:44:16.44,0:44:18.11,Default,HAZELT,0,0,0,,Oke, ayo kita ulurkan tangan.
Dialog: 0,0:44:18.48,0:44:19.78,Default,HAZELT,0,0,0,,-Ayo.\N-Semuanya?
Dialog: 0,0:44:19.78,0:44:20.98,Default,HAZELT,0,0,0,,Tangan di sini. Maju.
Dialog: 0,0:44:20.98,0:44:22.65,Default,HAZELT,0,0,0,,-Di Sini.\N-Tuhan.
Dialog: 0,0:44:22.65,0:44:23.72,Default,HAZELT,0,0,0,,1, 2, 3.
Dialog: 0,0:44:23.72,0:44:24.92,Default,HAZELT,0,0,0,,Maju!
Dialog: 0,0:44:25.09,0:44:26.35,Default,HALTENUT,0,0,0,,-Maju!\N-Maju!
Dialog: 0,0:44:26.85,0:44:27.92,Default,HAZELT,0,0,0,,Maju.
Dialog: 0,0:44:39.73,0:44:42.44,Default,HAZELT,0,0,0,,-Siap?\N-Ya, ayo berangkat.
Dialog: 0,0:44:46.34,0:44:48.41,Default,HAZELT,0,0,0,,-Manbok.\N-Ya, Yang Mulia.
Dialog: 0,0:44:48.81,0:44:49.88,Default,HAZELT,0,0,0,,Lebih cepat.
Dialog: 0,0:44:53.31,0:44:55.02,Default,HAZELT,0,0,0,,-Dan dia telah berubah.\N-Ayo pergi.
Dialog: 0,0:45:44.10,0:45:45.27,Default,HAZELT,0,0,0,,Terima kasih
Dialog: 0,0:45:47.90,0:45:49.27,Default,HAZELT,0,0,0,,dan aku minta maaf.
Dialogue: 0,0:45:52.47,0:45:55.21,Default,HAZELT,0,0,0,,Kamu juga spesial bagi Kim So-yeon.
Dialogue: 0,0:46:10.96,0:46:12.53,Default,HAZELT,0,0,0,,Aku ingin menguburnya sendiri.
Dialog: 0,0:46:15.16,0:46:16.30,Default,HAZELT,0,0,0,,Oke.
Dialogue: 0,0:46:33.38,0:46:34.95,Default,HAZELT,0,0,0,,Istirahatlah dengan tenang.
Dialogue: 0,0:46:40.82,0:46:41.92,Default,HAZELT,0,0,0,,Bagaimana kalau kita berangkat?
Dialog: 0,0:47:01.54,0:47:02.88,Default,HAZELT,0,0,0,,Bicara.
Dialog: 0,0:47:05.78,0:47:08.18,Default,HAZELT,0,0,0,,Ratu harus mempersiapkan kelahiran anaknya
Dialog: 0,0:47:08.18,0:47:10.62,Default,HAZELT,0,0,0,,dengan ibu,
Dialog: 0,0:47:11.79,0:47:16.39,Default,HAZELT,0,0,0,,tetapi karena ini tidak mungkin, saya ingin membantunya sendiri.
Dialog: 0,0:47:17.66,0:47:20.80,Default,HAZELT,0,0,0,,Datang untuk menanyakan keberadaannya.
Dialog: 0,0:47:20.80,0:47:22.96,Default,HAZELT,0,0,0,,Ratu mempunyai ahli waris, jadi
Dialog: 0,0:47:22.96,0:47:25.33,Default,HAZELT,0,0,0,,Saya tidak bisa memberi tahu Anda lokasinya.
Dialog: 0,0:47:25.33,0:47:26.93,Default,HAZELT,0,0,0,,Saya menyediakan semua yang dia butuhkan,
Dialog: 0,0:47:26.93,0:47:28.54,Default,HAZELT,0,0,0,,jadi jangan khawatir.
Dialog: 0,0:47:33.94,0:47:35.11,Default,HAZELT,0,0,0,,Di Sini.
Dialog: 0,0:47:51.16,0:47:52.93,Default,HAZELT,0,0,0,,Raja belum mati
Dialogue: 0,0:47:52.93,0:47:56.56,Default,HALTENUT,0,0,0,,Apakah dia benar-benar bersiap untuk melahirkan?
Dialogue: 0,0:47:56.80,0:48:00.37,Default,HALTENUT,0,0,0,,Kamu tidak menyakitinya, kan?
Dialog: 0,0:48:01.87,0:48:04.11,Default,HAZELT,0,0,0,,Sang Ratu telah melarikan diri.
Dialog: 0,0:48:04.54,0:48:07.37,Default,HALTENUT,0,0,0,,Kami membela kehormatannya.
Dialogue: 0,0:48:09.61,0:48:11.31,Default,HAZELT,0,0,0,,-Lari?\N-Dia percaya,
Dialog: 0,0:48:11.31,0:48:14.01,Default,HAZELT,0,0,0,,bahwa raja masih hidup, dia bahkan meninggalkan istana.
Dialog: 0,0:48:15.88,0:48:17.25,Default,HAZELT,0,0,0,,Permisi,
Dialog: 0,0:48:18.02,0:48:21.26,Default,HAZELT,0,0,0,,tapi saya akan memberitahu Anda secara terbuka, Yang Mulia.
Dialog: 0,0:48:22.19,0:48:26.46,Default,HAZELT,0,0,0,,Perilakumu tidak membantu keluarga kami,
Dialogue: 0,0:48:26.46,0:48:29.43,Default,HAZELT,0,0,0,,sebaliknya malah mencoreng namanya.
Dialog: 0,0:48:29.93,0:48:31.20,Default,HAZELT,0,0,0,,Tidakkah kamu mengerti,
Dialogue: 0,0:48:31.20,0:48:33.47,Default,HAZELT,0,0,0,,apa yang akan dikatakan generasi masa depan tentang kita?
Dialogue: 0,0:48:33.97,0:48:37.57,Default,HAZELT,0,0,0,,Apakah kamu mampu berbicara seperti itu?
Dialogue: 0,0:48:39.54,0:48:42.91,Default,HALTENUT,0,0,0,,Setidaknya aku punya rasa malu.
Dialogue: 0,0:48:42.91,0:48:45.75,Default,HALTENUT,0,0,0,,Rasa malumu adalah kejahatan.
Dialog: 0,0:48:45.75,0:48:47.98,Default,HAZELT,0,0,0,,Jika tidak ada rasa malu, tidak ada kejahatan.
Dialog: 0,0:48:47.98,0:48:49.78,Default,HAZELT,0,0,0,,Jika bukan demi kehormatan keluarga,
Dialog: 0,0:48:50.58,0:48:53.49,Default,HAZELT,0,0,0,,lalu kenapa kamu sampai sejauh ini?
Dialog: 0,0:48:53.49,0:48:54.89,Default,HALTENUT,0,0,0,,Bahkan raja pun dirugikan.
Dialog: 0,0:48:57.79,0:48:59.86,Default,HAZELT,0,0,0,,Waktuku tidak akan berakhir,
Dialog: 0,0:49:00.53,0:49:03.83,Default,HAZELT,0,0,0,,sampai saya sendiri yang menginginkannya.
Dialog: 0,0:49:43.80,0:49:45.07,Default,HAZELT,0,0,0,,Anda mendengar semuanya.
Dialog: 0,0:49:56.02,0:49:59.05,Default,HAZELT,0,0,0,,-Di sana.\N-Teho.
Dialog: 0,0:50:01.06,0:50:02.12,Default,HAZELT,0,0,0,,Yang Mulia.
Dialog: 0,0:50:02.72,0:50:03.96,Default,HAZELT,0,0,0,,Kita sampai di sana sebelum kita.
Dialog: 0,0:50:04.19,0:50:05.49,Default,HAZELT,0,0,0,,-Ya.\N-Ya.
Dialogue: 0,0:50:05.49,0:50:07.39,Default,HAZELT,0,0,0,,Ya Tuhan, lututku sakit sekali.
Dialog: 0,0:50:07.60,0:50:08.63,Default,HAZELT,0,0,0,,Yang Mulia.
Dialog: 0,0:50:09.93,0:50:10.97,Default,HAZELT,0,0,0,,Halo.
Dialogue: 0,0:50:13.50,0:50:16.14,Default,HAZELT,0,0,0,,Senang kamu masih hidup.\NKamu telah melalui banyak hal.
Dialog: 0,0:50:16.44,0:50:18.27,Default,HAZELT,0,0,0,,Kami senang Anda aman.
Dialogue: 0,0:50:19.67,0:50:21.24,Default,HAZELT,0,0,0,,Siapa yang punya rokok?
Dialog: 0,0:50:21.28,0:50:23.38,Default,HAZELT,0,0,0,,Yang Mulia, di sini dingin.
Dialogue: 0,0:50:29.22,0:50:32.55,Default,HAZELT,0,0,0,,Aku tak keberatan sekaleng bir dingin saat ini.
Dialog: 0,0:50:35.39,0:50:37.19,Default,HAZELT,0,0,0,,Tidak terlalu bagus di sini,
Dialog: 0,0:50:37.19,0:50:38.53,Default,HAZELT,0,0,0,,jadi kenapa kami datang?
Dialogue: 0,0:50:38.53,0:50:41.93,Default,HAZELT,0,0,0,,Di sini paling aman, \Ntidak ada yang tahu tentang tempat ini.
Dialog: 0,0:50:42.56,0:50:45.70,Default,HAZELT,0,0,0,,Benarkah? Sekalipun Anda menginginkannya, Anda tidak akan menemukannya.
Dialogue: 0,0:50:46.33,0:50:47.70,Default,HAZELT,0,0,0,,Ya Tuhan, kakiku.
Dialog: 0,0:50:55.68,0:50:56.78,Default,HAZELT,0,0,0,,Sial.
Dialog: 0,0:50:58.55,0:50:59.65,Default,HAZELT,0,0,0,,Ini belum waktunya.
Dialog: 0,0:50:59.65,0:51:01.08,Default,HAZELT,0,0,0,,Berapa lama kamu bisa bertahan?
Dialog: 0,0:51:01.08,0:51:03.88,Default,HAZELT,0,0,0,,Ini kesempatan terakhir. Anda harus berhati-hati.
Dialog: 0,0:51:12.69,0:51:13.96,Default,HAZELT,0,0,0,,Sudah waktunya.
Dialogue: 0,0:51:25.87,0:51:27.11,Default,HAZELT,0,0,0,,Enak sekali?
Dialog: 0,0:51:38.12,0:51:40.29,Default,HAZELT,0,0,0,,-Di Sini.\N-Di Sini.
Dialog: 0,0:51:59.97,0:52:01.31,Default,HALTENUT,0,0,0,,Tuhan.
Dialogue: 0,0:52:22.15,0:52:23.42,Default,HAZELT,0,0,0,,Enak sekali.
Dialog: 0,0:52:39.54,0:52:41.54,Default,HALTENUT,0,0,0,,Mencari masalah?
Dialog: 0,0:52:42.74,0:52:45.68,Default,HAZELT,0,0,0,,Orang sepertiku akan tetap mati,
Dialog: 0,0:52:45.68,0:52:47.18,Default,HAZELT,0,0,0,,kita tidak punya pilihan.
Dialog: 0,0:52:47.34,0:52:50.31,Default,HAZELT,0,0,0,,Dan Anda memiliki posisi tertinggi di seluruh Joseon.
Dialogue: 0,0:52:50.31,0:52:53.88,Default,HAZELT,0,0,0,,Jika kita menutup mata terhadap semua orang, bukankah kita akan hidup berkelimpahan?
Dialogue: 0,0:52:54.72,0:52:56.89,Default,HAZELT,0,0,0,,Ada saatnya aku
Dialogue: 0,0:52:57.59,0:52:59.96,Default,HAZELT,0,0,0,,hidup dalam mimpi buruk yang harus kutanggung.
Dialog: 0,0:53:01.29,0:53:03.53,Default,HAZELT,0,0,0,,Aku menanggung semuanya hanya dengan pikiran membalas dendam pada mereka
Dialog: 0,0:53:04.80,0:53:07.83,Default,HAZELT,0,0,0,,yang membunuh orang tua, saudara laki-laki dan perempuanku.
Dialog: 0,0:53:08.90,0:53:12.10,Default,HAZELT,0,0,0,,Lalu aku mulai melihat pembusukan Joseon
Dialog: 0,0:53:12.77,0:53:15.44,Default,HAZELT,0,0,0,,dan orang-orang yang menderita.
Dialog: 0,0:53:18.24,0:53:20.34,Default,HAZELT,0,0,0,,Dan matamu tajam.
Dialog: 0,0:53:20.58,0:53:22.95,Default,HAZELT,0,0,0,,Saya pikir semua orang di istana itu buta.
Dialog: 0,0:53:25.42,0:53:27.15,Default,HAZELT,0,0,0,,Jika semuanya berhasil,
Dialog: 0,0:53:27.99,0:53:31.29,Default,HAZELT,0,0,0,,kamu tidak akan menjadi seperti mereka, bukan?
Dialog: 0,0:53:35.13,0:53:36.43,Default,HAZELT,0,0,0,,I
Dialogue: 0,0:53:38.00,0:53:40.63,Default,HAZELT,0,0,0,,Aku memimpikan Joseon yang baru.
Dialogue: 0,0:53:43.67,0:53:46.07,Default,HAZELT,0,0,0,,Apakah Anda menyebut ini sebagai “pemilihan”?
Dialogue: 0,0:53:47.07,0:53:48.07,Default,HAZELT,0,0,0,,Apa?
Dialog: 0,0:53:48.07,0:53:50.47,Default,HAZELT,0,0,0,,Saat orang memilih rajanya.
Dialog: 0,0:53:50.71,0:53:52.08,Default,HAZELT,0,0,0,,Ya. Pemilu.
Dialog: 0,0:53:52.58,0:53:54.95,Default,HAZELT,0,0,0,,Tetapi ini tidak berarti bahwa dunia akan menjadi ideal.
Dialog: 0,0:54:02.45,0:54:05.22,Default,HAZELT,0,0,0,,Yah, itu sudah bagus.
Dialog: 0,0:54:05.76,0:54:08.23,Default,HAZELT,0,0,0,,Anda dapat mengubahnya jika terjadi kesalahan.
Dialogue: 0,0:54:09.53,0:54:12.93,Default,HAZELT,0,0,0,,Raja dan ratu sama-sama gila.
Dialog: 0,0:54:13.56,0:54:16.93,Default,HAZELT,0,0,0,,Baiklah, tidurlah lebih awal, ada masalah besar di depan kita.
Dialog: 0,0:54:20.87,0:54:21.97,Default,HAZELT,0,0,0,,Selamat malam.
Dialog: 0,0:54:26.88,0:54:29.11,Default,HAZELT,0,0,0,,Jika kamu memang dari masa depan,
Dialog: 0,0:54:29.85,0:54:32.02,Default,HAZELT,0,0,0,,jadi kamu tahu bagaimana semuanya berakhir.
Dialog: 0,0:54:33.95,0:54:35.19,Default,HAZELT,0,0,0,,Apa yang akan terjadi?
Dialog: 0,0:54:40.39,0:54:41.59,Default,HAZELT,0,0,0,,Kamu akan kalah.
Dialog: 0,0:54:45.70,0:54:47.73,Default,HAZELT,0,0,0,,Tapi aku berani mempertaruhkan segalanya padamu.
Dialogue: 0,0:54:49.23,0:54:52.40,Default,HAZELT,0,0,0,,Bukankah kamu selalu berada di pihak yang menang?
Dialog: 0,0:54:53.07,0:54:54.30,Default,HAZELT,0,0,0,,Tidak ada.
Dialogue: 0,0:54:54.30,0:54:56.17,Default,HALTENUT,0,0,0,,Aku sudah mengacau dalam hidup ini.
Dialogue: 0,0:54:56.81,0:54:58.94,Default,HAZELT,0,0,0,,Bahkan jika aku mempertaruhkan semuanya, tidak apa-apa.
Dialogue: 0,0:55:00.88,0:55:03.41,Default,HAZELT,0,0,0,,Jadi kamu menaruh semua telurmu di keranjangku?
Dialog: 0,0:55:04.31,0:55:07.18,Default,HAZELT,0,0,0,,Ya. Semua. Saya melakukan semuanya.
Dialog: 0,0:55:10.99,0:55:13.96,Default,HAZELT,0,0,0,,Bahkan jika aku gagal, aku akan melakukan yang terbaik.
Dialog: 0,0:55:15.26,0:55:17.73,Default,HAZELT,0,0,0,,Sampai takdir bosan denganku,
Dialogue: 0,0:55:18.40,0:55:20.73,Default,HAZELT,0,0,0,,Aku tidak akan membiarkan dia memakanku semudah itu.
Dialogue: 0,0:55:41.05,0:55:42.69,Default,HAZELT,0,0,0,,Aku tak percaya,
Dialog: 0,0:55:43.29,0:55:45.52,Default,HALTENUT,0,0,0,,bahwa saya terjebak di sini dan tidak dapat membantu raja.
Dialog: 0,0:55:46.32,0:55:48.19,Default,HAZELT,0,0,0,,Apakah menurutmu ratu telah bertemu dengannya?
Dialogue: 0,0:55:48.19,0:55:52.10,Default,HAZELT,0,0,0,,Bahkan jika mereka bertemu, apa yang bisa mereka lakukan sendiri?
Dialog: 0,0:55:53.90,0:55:55.90,Default,HAZELT,0,0,0,,Saya kira tidak ada
Dialogue: 0,0:55:55.90,0:55:57.90,Default,HALTENUT,0,0,0,,cara menghentikan penobatan.
Dialog: 0,0:56:02.84,0:56:04.21,Default,HAZELT,0,0,0,,Dan jika Anda menggunakan Kim Hwan...
Dialog: 0,0:56:09.11,0:56:10.25,Default,HAZELT,0,0,0,,Hon.
Dialog: 0,0:56:16.79,0:56:17.99,Default,HAZELT,0,0,0,,Apakah dia datang lagi?
Dialog: 0,0:56:18.42,0:56:19.92,Default,HAZELT,0,0,0,,Membawa sesuatu.
Dialog: 0,0:56:23.06,0:56:24.19,Default,HAZELT,0,0,0,,Apa ini?
Dialog: 0,0:56:28.00,0:56:29.67,Default,HAZELT,0,0,0,,Mengumpulkan permintaan,
Dialog: 0,0:56:29.67,0:56:31.23,Default,HALTENUT,0,0,0,,untuk menyelamatkan Anda.
Dialog: 0,0:56:32.60,0:56:36.04,Default,HAZELT,0,0,0,,Tetapi apakah ada hal lain yang bisa saya lakukan untuk membantu?
Dialog: 0,0:56:38.14,0:56:39.31,Default,HAZELT,0,0,0,,Bantuan?
Dialog: 0,0:56:39.31,0:56:41.65,Default,HAZELT,0,0,0,,Ya. Minta apa saja.
Dialog: 0,0:56:42.41,0:56:44.25,Default,HAZELT,0,0,0,,-Semuanya?\N-Ya.
Dialog: 0,0:56:44.85,0:56:47.92,Default,HAZELT,0,0,0,,Aku akan melakukan segalanya untukmu.
Dialogue: 0,0:56:53.59,0:56:54.73,Default,HAZELT,0,0,0,,Mengapa
Dialogue: 0,0:56:56.39,0:56:58.56,Default,HALTENUT,0,0,0,,apakah kamu begitu mempercayai orang lain?
Dialogue: 0,0:57:00.60,0:57:02.70,Default,HAZELT,0,0,0,,Tugasmu adalah memberi makan para penipu?
Dialogue: 0,0:57:02.87,0:57:05.04,Default,HAZELT,0,0,0,,Bagaimana caramu bertahan di dunia yang kejam ini?
Dialog: 0,0:57:06.07,0:57:08.04,Default,HAZELT,0,0,0,,Maaf, saya salah.
Dialog: 0,0:57:09.41,0:57:12.24,Default,HAZELT,0,0,0,,-Ada apa?\N-Saya tidak tahu persisnya apa,
Dialog: 0,0:57:13.21,0:57:15.55,Default,HAZELT,0,0,0,,tapi karena kamu bilang begitu, aku tidak akan melakukannya lagi.
Dialogue: 0,0:57:15.55,0:57:16.91,Default,HAZELT,0,0,0,,Kamu salah soal itu
Dialog: 0,0:57:18.88,0:57:20.58,Default,HAZELT,0,0,0,,bahwa kamu memercayai orang sepertiku.
Dialog: 0,0:57:24.55,0:57:27.16,Default,ZINA,0,0,0,,Saya mencoba berteman dengan Anda untuk mencari informasi.
Dialog: 0,0:57:28.19,0:57:29.43,Default,ZINA,0,0,0,,Dan kamu tidak tahu.
Dialog: 0,0:57:33.20,0:57:34.66,Default,ZINA,0,0,0,,Untuk apa semua ini?
Dialog: 0,0:57:40.50,0:57:41.54,Default,ZINA,0,0,0,,Itulah
Dialogue: 0,0:57:44.31,0:57:46.88,Default,ZINA,0,0,0,,selama ini kamu tidak menganggapku sebagai teman?
Dialog: 0,0:57:47.34,0:57:48.38,Default,ZINA,0,0,0,,Tidak.
Dialog: 0,0:57:49.41,0:57:50.81,Default,ZINA,0,0,0,,Saya tidak menghitungmu
Dialog: 0,0:57:52.18,0:57:53.68,Default,ZINA,0,0,0,,tidak sedetik pun dengan temanmu.
Dialogue: 0,0:57:56.82,0:57:58.42,Default,ZINA,0,0,0,,Jadi jangan berpikir untuk kembali lagi.
Dialog: 0,0:58:34.59,0:58:36.59,Default,ZINA,0,0,0,,Kenapa kamu menatapku seperti itu?
Dialogue: 0,0:58:37.09,0:58:39.16,Default,ZINA,0,0,0,,Kau menyalahkannya
Dialog: 0,0:58:39.53,0:58:41.36,Default,ZINA,0,0,0,,kita tidak dapat menggunakannya lagi?
Dialogue: 0,0:58:43.10,0:58:44.60,Default,ZINA,0,0,0,,Aku tidak melihatmu.
Dialog: 0,0:58:46.10,0:58:49.17,Default,ZINA,0,0,0,,Sekarang di depan mataku telah terjadi aib seperti itu.
Dialog: 0,0:58:59.12,0:59:00.88,Default,ZINA,0,0,0,,Kamu pasti sangat lelah.
Dialog: 0,0:59:08.36,0:59:09.96,Default,ZINA,0,0,0,,Saya tidak encerkan dengan air.
Dialog: 0,0:59:10.86,0:59:12.20,Default,ZINA,0,0,0,,Saya campur dengan soju.
Dialog: 0,0:59:14.00,0:59:15.93,Default,ZINA,0,0,0,,Rasio emas, entahlah.
Dialog: 0,0:59:22.37,0:59:24.47,Default,ZINA,0,0,0,,Sepertinya kamu memimpikan sesuatu yang baik.
Dialog: 0,0:59:27.54,0:59:28.75,Default,ZINA,0,0,0,,Lega sekali.
Dialog: 0,0:59:51.43,0:59:53.17,Default,ZINA,0,0,0,,Apa yang kamu impikan?
Dialog: 0,0:59:53.37,0:59:55.91,Default,ZINA,0,0,0,,Potret raja terbakar.
Dialog: 0,0:59:56.54,1:00:00.71,Default,ZINA,0,0,0,,Api menghanguskan seluruh Seongwonjong.
Dialogue: 0,1:00:01.24,1:00:05.18,Default,ZINA,0,0,0,,Dan aku terjebak di sini sendirian saat kebakaran...
Dialog: 0,1:00:22.23,1:00:23.97,Default,ZINA,0,0,0,,Hari ini adalah hari yang penting.
Dialog: 0,1:00:23.97,1:00:25.54,Default,ZINA,0,0,0,,Tidak setetes pun yang bisa diucapkan.
Dialog: 0,1:00:53.63,1:00:55.83,Default,ZINA,0,0,0,,Bubuk aku agar tanpa satupun cacat.
Dialog: 0,1:01:05.41,1:01:09.61,Default,ZINA,0,0,0,,Hari upacara aksesi
Dialog: 0,1:01:21.83,1:01:23.36,Default,ZINA,0,0,0,,Demi keselamatan Yang Mulia
Dialog: 0,1:01:23.36,1:01:26.30,Default,ZINA,0,0,0,,Saya memerintahkan jam malam untuk diberlakukan di istana.
Dialog: 0,1:01:26.73,1:01:30.10,Default,ZINA,0,0,0,,Semua orang, kecuali prajurit,\Nharus tetap berada di dalam istana.
Dialog: 0,1:01:31.20,1:01:32.24,Default,ZINA,0,0,0,,Ya.
Dialog: 0,1:01:32.24,1:01:35.01,Default,ZINA,0,0,0,,Saya tidak mengundang keluarga kerajaan, maupun para musisi.
Dialog: 0,1:01:35.84,1:01:37.77,Default,ZINA,0,0,0,,Biarkan upacara berlalu dengan damai.
Dialog: 0,1:01:37.77,1:01:39.18,Default,ZINA,0,0,0,,Bahkan keluarga kerajaan?
Dialog: 0,1:01:39.18,1:01:40.88,Default,ZINA,0,0,0,,Ini akan lebih aman dengan cara ini.
Dialog: 0,1:01:40.88,1:01:41.91,Default,ZINA,0,0,0,,Tapi...
Dialog: 0,1:01:51.29,1:01:53.36,Default,ZINA,0,0,0,,Semua yang saya katakan benar.
Dialog: 0,1:01:56.66,1:01:57.89,Default,ZINA,0,0,0,,Saya mengerti.
Dialog: 0,1:02:06.07,1:02:08.57,Default,ZINA,0,0,0,,Yang Mulia, apakah Anda tidak takut?
Dialog: 0,1:02:09.07,1:02:10.21,Default,ZINA,0,0,0,,Jangan khawatir.
Dialog: 0,1:02:10.21,1:02:12.78,Default,ZINA,0,0,0,,Orang-orang beriman yang terkadang saya temui di jalan,
Dialog: 0,1:02:12.78,1:02:15.01,Default,ZINA,0,0,0,,mereka bilang nenek moyangku akan memberiku berkah.
Dialog: 0,1:02:15.58,1:02:17.11,Default,ZINA,0,0,0,,Jadi saya akan menggunakannya sekarang.
Dialog: 0,1:02:18.52,1:02:19.58,Default,ZINA,0,0,0,,Yang Mulia,
Dialogue: 0,1:02:20.25,1:02:24.39,Default,ZINA,0,0,0,,hari ini lebih dari hari-hari lainnya,\Nkamu terlihat seperti ratu yang kukenal.
Dialog: 0,1:02:28.49,1:02:30.13,Default,ZINA,0,0,0,,Tidak perlu suasana seperti itu.
Dialog: 0,1:02:30.13,1:02:32.80,Default,ZINA,0,0,0,,Ini seperti hari terakhir.\NDan ini baru permulaan.
Dialog: 0,1:02:33.53,1:02:35.03,Default,ZINA,0,0,0,,Anda benar, Yang Mulia.
Dialog: 0,1:02:45.01,1:02:46.81,Default,ZINA,0,0,0,,Temui kami di malam hari di istana.
Dialog: 0,1:02:47.84,1:02:50.41,Default,ZINA,0,0,0,,Tentu saja. Saatnya untuk pergi.
Dialog: 0,1:02:54.32,1:02:55.52,Default,ZINA,0,0,0,,Jangan mati.
Dialog: 0,1:02:55.52,1:02:57.49,Default,ZINA,0,0,0,,Apa yang baik dalam hidup?
Dialog: 0,1:02:57.49,1:03:01.16,Default,ZINA,0,0,0,,Bahkan jika hidup kita tidak bahagia dan menyedihkan, mari kita hidup lebih lama.
Dialog: 0,1:03:03.49,1:03:04.96,Default,ZINA,0,0,0,,Jika semuanya berjalan baik sekarang,
Dialog: 0,1:03:04.96,1:03:08.50,Default,ZINA,0,0,0,,Saya akan "memilih" Anda, atau apa pun, \Ndi tempat raja.
Dialog: 0,1:03:10.80,1:03:11.90,Default,ZINA,0,0,0,,Terima kasih.
Dialog: 0,1:03:16.11,1:03:17.24,Default,ZINA,0,0,0,,Baiklah, ayo berangkat?
Dialog: 0,1:03:17.97,1:03:19.58,Default,ZINA,0,0,0,,Saatnya pulang.
Dialog: 0,1:03:21.48,1:03:22.98,Default,ZINA,0,0,0,,Penjahat Lee Kyung-eun
Dialog: 0,1:03:22.98,1:03:25.55,Default,ZINA,0,0,0,,menyembunyikan identitas para pengkhianat, pengikut donghak.
Dialog: 0,1:03:25.82,1:03:26.92,Default,ZINA,0,0,0,,Dia akan dicabut posisinya
Dialog: 0,1:03:26.92,1:03:28.62,Default,ZINA,0,0,0,,dan dikirim ke tautan.
Dialog: 0,1:03:29.25,1:03:30.89,Default,ZINA,0,0,0,,Pidana Hong Duil
Dialog: 0,1:03:30.89,1:03:32.72,Default,ZINA,0,0,0,,kehilangan senjata api.
Dialog: 0,1:03:32.72,1:03:34.22,Default,ZINA,0,0,0,,Dia akan bekerja di kantor
Dialog: 0,1:03:34.22,1:03:36.63,Default,ZINA,0,0,0,,Ganghwado selama 600 hari sebagai budak negara.
Dialog: 0,1:03:39.30,1:03:40.86,Default,ZINA,0,0,0,,Setelah upacara pendakian
Dialog: 0,1:03:40.86,1:03:42.60,Default,ZINA,0,0,0,,Saya akan segera melaksanakan kalimat tersebut.
Dialog: 0,1:03:50.17,1:03:53.18,Default,ZINA,0,0,0,,Tidak ada pencapaian untuk \Nattribute apa pun kepada raja saat ini.
Dialog: 0,1:03:53.18,1:03:55.28,Default,ZINA,0,0,0,,Kami mengalami kesulitan.
Dialog: 0,1:03:59.35,1:04:01.02,Default,ZINA,0,0,0,,Pemakaman raja belum berakhir.
Dialogue: 0,1:04:01.02,1:04:03.45,Default,ZINA,0,0,0,,Bolehkah tersenyum sampai gigi?
Dialog: 0,1:04:05.69,1:04:06.99,Default,ZINA,0,0,0,,Maaf.
Dialog: 0,1:04:09.23,1:04:12.10,Default,ZINA,0,0,0,,Bagaimana upacaranya, apakah akan ada masalah -
Dialog: 0,1:04:12.53,1:04:14.16,Default,ZINA,0,0,0,,semua tergantung anda.
Dialog: 0,1:04:14.63,1:04:17.63,Default,ZINA,0,0,0,,Ya! Saya pasti akan melakukan tugas saya
Dialog: 0,1:04:17.63,1:04:20.07,Default,ZINA,0,0,0,,sehingga ketidakhadiran Menteri Perang tidak mempengaruhi apapun.
Dialog: 0,1:04:20.34,1:04:22.71,Default,ZINA,0,0,0,,Omong-omong,
Dialog: 0,1:04:23.37,1:04:28.04,Default,ZINA,0,0,0,,kapan Kim Byungin kembali ke istana?
Dialog: 0,1:04:29.58,1:04:32.32,Default,ZINA,0,0,0,,Saya kira Anda ingin mengetahui nasib surat itu.
Dialogue: 0,1:04:33.35,1:04:35.32,Default,ZINA,0,0,0,,Semua orang mengkhawatirkan hal ini.
Dialog: 0,1:04:35.32,1:04:38.02,Default,ZINA,0,0,0,,Jangan khawatir. Aku akan mengurus semuanya.
Dialog: 0,1:04:38.29,1:04:40.66,Default,ZINA,0,0,0,,Ya, ya.
Dialog: 0,1:04:42.19,1:04:44.59,Default,ZINA,0,0,0,,Sekarang raja dan klan Phunyang dari Cho
Dialog: 0,1:04:46.20,1:04:48.13,Default,ZINA,0,0,0,,akan menjadi bonekaku.
Dialog: 0,1:05:05.45,1:05:07.48,Default,ZINA,0,0,0,,Pak, saya menangis dua kali ke istana.
Dialog: 0,1:05:09.25,1:05:10.35,Default,ZINA,0,0,0,,Double.
Dialog: 0,1:05:24.93,1:05:27.60,Default,ZINA,0,0,0,,Hei, kami orang baik.
Dialog: 0,1:05:28.97,1:05:32.01,Default,ZINA,0,0,0,,Tetapi jika Kepala Inspektur atau siapa pun melihat sesuatu yang mencurigakan,
Dialog: 0,1:05:33.24,1:05:35.75,Default,ZINA,0,0,0,,kita benar-benar bisa menjadi jahat.
Dialog: 0,1:05:37.08,1:05:39.22,Default,ZINA,0,0,0,,Saya tidak peduli apakah sifat manusia itu baik atau tidak.
Dialog: 0,1:05:39.22,1:05:41.62,Default,ZINA,0,0,0,,Itu semua tergantung pada apa yang mereka lakukan.
Dialog: 0,1:05:43.39,1:05:45.39,Default,ZINA,0,0,0,,Lebih alami, lebih alami.
Dialog: 0,1:05:45.49,1:05:46.59,Default,ZINA,0,0,0,,Ayo.
Dialog: 0,1:06:02.97,1:06:04.17,Default,ZINA,0,0,0,,Ayo berangkat.
Dialog: 0,1:06:17.72,1:06:20.49,Default,ZINA,0,0,0,,Tidak nyaman, bergerak sedikit.
Dialog: 0,1:06:22.66,1:06:23.73,Default,ZINA,0,0,0,,Seperti ini?
Dialog: 0,1:06:24.06,1:06:25.46,Default,ZINA,0,0,0,,Apakah ini siku?
Dialog: 0,1:06:25.73,1:06:27.03,Default,ZINA,0,0,0,,Kelinci menyodokku.
Dialog: 0,1:06:27.56,1:06:30.00,Default,ZINA,0,0,0,,Jika kamu menekan perutku seperti itu...
Dialog: 0,1:06:30.70,1:06:32.37,Default,ZINA,0,0,0,,Wow.
Dialog: 0,1:06:37.71,1:06:38.74,Default,ZINA,0,0,0,,Pindah.
Dialog: 0,1:06:41.81,1:06:43.01,Default,ZINA,0,0,0,,Oh.
Dialog: 0,1:06:45.05,1:06:46.48,Default,ZINA,0,0,0,,Akhirnya saya melihat sesuatu.
Dialog: 0,1:06:54.52,1:06:55.76,Default,ZINA,0,0,0,,Di sini...
Dialog: 0,1:07:00.40,1:07:01.50,Default,ZINA,0,0,0,,Tidak ada waktu untuk ini.
Dialog: 0,1:07:02.17,1:07:04.30,Default,ZINA,0,0,0,,Kamu benar, kamu harus menenangkan diri.
Dialog: 0,1:07:05.17,1:07:07.44,Default,ZINA,0,0,0,,Untungnya aku tidak bersembunyi di sini bersama penjaga.
Dialog: 0,1:07:08.24,1:07:09.61,Default,ZINA,0,0,0,,Mengapa kamu membicarakan hal ini?
Dialog: 0,1:07:09.71,1:07:13.81,Default,ZINA,0,0,0,,Bergerak sedikit, aku akan mengubah posisiku.
Dialog: 0,1:07:18.45,1:07:19.58,Default,ZINA,0,0,0,,Bu.
Dialog: 0,1:07:27.72,1:07:30.66,Default,ZINA,0,0,0,,Sekarang saya merasa nyaman.
Dialog: 0,1:07:32.26,1:07:34.96,Default,ZINA,0,0,0,,Saya setuju, pose ini yang terbaik.
Dialog: 0,1:07:45.17,1:07:47.14,Default,ZINA,0,0,0,,Kami akan ketahuan karena deru hatimu.
Dialog: 0,1:07:47.44,1:07:48.95,Default,ZINA,0,0,0,,Kenapa kamu begitu takut?
Dialog: 0,1:07:50.18,1:07:52.01,Default,ZINA,0,0,0,,Ini bukan hanya hatiku.
Dialog: 0,1:08:02.43,1:08:05.03,Default,ZINA,0,0,0,,Dan bukan hanya karena rasa takut.
Dialog: 0,1:08:07.03,1:08:08.87,Default,ZINA,0,0,0,,Ini juga karena kamu, ratuku.
Dialog: 0,1:08:14.07,1:08:17.51,Default,ZINA,0,0,0,,Bukan karena takut juga padaku.
Dialog: 0,1:08:43.53,1:08:45.37,Default,ZINA,0,0,0,,Ini dari Inggris.
Dialog: 0,1:08:45.37,1:08:47.10,Default,ZINA,0,0,0,,Jauh lebih bertenaga dan lebih cepat.
Dialog: 0,1:08:51.44,1:08:54.34,Default,ZINA,0,0,0,,Jika raja muncul di istana,
Dialogue: 0,1:08:55.41,1:08:57.51,Default,ZINA,0,0,0,,incar hatinya.
Dialog: 0,1:09:19.47,1:09:20.84,Default,ZINA,0,0,0,,Baru, atau apa?
Dialog: 0,1:09:22.00,1:09:23.54,Default,ZINA,0,0,0,,Ya.
Dialog: 0,1:09:25.14,1:09:26.51,Default,ZINA,0,0,0,,Ayo masuk.
Dialog: 0,1:09:46.20,1:09:47.53,Default,ZINA,0,0,0,,Berhenti.
Dialog: 0,1:09:58.61,1:09:59.88,Default,ZINA,0,0,0,,-Search.\N-Ya!
Dialog: 0,1:10:16.69,1:10:18.13,Default,ZINA,0,0,0,,Tidak ada yang mencurigakan.
Dialogue: 0,1:10:49.03,1:10:53.30,Default,ZINA,0,0,0,,Bagaimana aku menjadi seorang ratu
Dialog: 0,1:11:13.32,1:11:17.19,Default,ZINA,0,0,0,,Segera setelah upacara selesai,\NI akan menghabisi semuanya.
Dialog: 0,1:11:17.19,1:11:20.26,Default,ZINA,0,0,0,,Perasaan yang sama seperti sebelum kemunculan bos utama dalam game.
Dialog: 0,1:11:20.26,1:11:21.89,Default,ZINA,0,0,0,,Saya mahir menggunakan pisau.
Dialogue: 0,1:11:22.73,1:11:25.43,Default,ZINA,0,0,0,,Aku gila. \NDari kata-kata tentang tugas khusus
Dialogue: 0,1:11:25.49,1:11:26.80,Default,ZINA,0,0,0,,hatiku mendidih.
Dialogue: 0,1:11:26.80,1:11:29.90,Default,ZINA,0,0,0,,Perubahan yang sangat kamu takuti telah dimulai.
Dialog: 0,1:11:29.90,1:11:32.17,Default,ZINA,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:11:32.20,1:11:34.04,Default,ZINA,0,0,0,,Apakah raja berada di pihak yang sama dengan pengikut donghak?
Dialog: 0,1:11:34.04,1:11:36.81,Default,ZINA,0,0,0,,Saya adalah kerabat dari orang-orang yang Anda bunuh.
Dialog: 0,1:11:36.81,1:11:41.51,Default,ZINA,0,0,0,,Aku adalah raja dari orang-orang yang kamu abaikan!
Dialog: 0,0:26:44.53,0:26:46.53,Default,,0,0,0,,


