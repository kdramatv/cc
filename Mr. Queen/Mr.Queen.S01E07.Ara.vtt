Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:03.98,0:01:06.45,Default,lily,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.45,0:01:09.06,Default,ليلي,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:01:14.50,0:01:16.53,Default,ليلي,0,0,0,,واو.
Dialogue: 0,0:01:17.03,0:01:19.43,Default,lily,0,0,0,,لا أستطيع أن أصدق أن العظيم "جانغ بونغ هوان"
Dialogue: 0,0:01:19.53,0:01:23.20,Default,ليلي,0,0,0,,أنت بحاجة إلى شيء من هذا القبيل للحفاظ على الحياة.
Dialogue: 0,0:01:24.87,0:01:27.54,Default,ليلي,0,0,0,,الحياة لا قيمة لها، أليس كذلك؟
Dialogue: 0,0:01:28.84,0:01:31.71,Default,ليلي,0,0,0,,لقد كنت متحمساً حقاً.
Dialogue: 0,0:01:32.05,0:01:34.92,Default,lily,0,0,0,,هل يمكنني أن أصبح\NSteve Jobs المحلي أو Thomas Edison؟
Dialogue: 0,0:01:35.75,0:01:37.28,Default,lily,0,0,0,,لا، أنا أتجاهل الأمر. نحن بحاجة إلى شخص عظيم.
Dialogue: 0,0:01:37.28,0:01:40.15,Default,ليلي,0,0,0,,منقذ الجنس البشري.
Dialogue: 0,0:01:49.13,0:01:51.50,Default,زنبق,0,0,0,,تجلس في جسد الملكة،
Dialogue: 0,0:01:53.03,0:01:56.30,Default,ليلى,0,0,0,,والتي لا ينبغي أن تكون هناك.
Dialogue: 0,0:01:56.50,0:01:58.11,Default,ليلي,0,0,0,,روح شريرة.
Dialogue: 0,0:02:00.01,0:02:03.98,Default,lily,0,0,0,,الملكة ممسوسة بروح شريرة!
Dialogue: 0,0:02:05.28,0:02:07.31,Default,ليلي,0,0,0,,لا أستطيع أن أتركك هكذا.
Dialogue: 0,0:02:07.38,0:02:09.78,Default,ليلي,0,0,0,,ارحل إلى الأبد.
Dialogue: 0,0:02:16.02,0:02:19.76,Default,ليلي,0,0,0,,بالضبط يا كاريير! مخترع مكيفات الهواء!
Dialogue: 0,0:02:25.07,0:02:26.27,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:02:26.27,0:02:29.37,Default,ليلي,0,0,0,,عد إلى رشدك يا ​​صاحب الجلالة! تعال.
Dialogue: 0,0:02:29.37,0:02:30.84,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:02:36.24,0:02:39.68,Default,ليلي,0,0,0,,7 حلقة: قناع
Dialogue: 0,0:02:39.68,0:02:41.58,Default,lily,0,0,0,,-اشحن 100 جول.\N-ابتعد.
Dialogue: 0,0:02:42.85,0:02:45.15,Default,ليلي,0,0,0,,أضف الإبينفرين. تهمة لمدة 150 جول.
Dialogue: 0,0:02:45.45,0:02:47.65,Default,lily,0,0,0,,-اشحن 150 جول.\N-ابتعد.
Dialogue: 0,0:02:55.33,0:02:58.00,Default,ليلي,0,0,0,,-مباشر.\N-أنا قادم.
Dialogue: 0,0:02:59.43,0:03:02.24,Default,lily,0,0,0,,أليس هذا خادم الملكة؟
Dialogue: 0,0:03:02.97,0:03:06.11,Default,ليلي,0,0,0,,والطبيب الملكي يركض خلفها.
Dialogue: 0,0:03:10.58,0:03:13.51,Default,ليلي,0,0,0,,-ماذا حدث؟\N-صاحبة الجلالة...
Dialogue: 0,0:03:24.86,0:03:27.36,Default,ليلي,0,0,0,,جلالتك. إنه أمر خطير!
Dialogue: 0,0:03:27.36,0:03:28.80,Default,ليلي,0,0,0,,يا رب.
Dialogue: 0,0:03:32.13,0:03:33.60,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:03:33.90,0:03:37.97,Default,lily,0,0,0,,لقد كنت أفكر في الأمر، أنا أزعجك من أجل مصلحتك...
Dialogue: 0,0:03:37.97,0:03:39.64,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:03:41.68,0:03:43.11,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:03:44.38,0:03:45.65,Default,ليلي,0,0,0,,ماذا حدث هنا؟
Dialogue: 0,0:03:45.65,0:03:48.65,Default,lily,0,0,0,,لقد غادروا بالفعل إلى الطبيب الملكي.
Dialogue: 0,0:03:49.05,0:03:50.45,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:03:50.52,0:03:53.22,Default,ليلي,0,0,0,,لا يمكنك أن تموت!
Dialogue: 0,0:03:53.22,0:03:56.19,Default,ليلي,0,0,0,,لا تتركني!
Dialogue: 0,0:03:56.19,0:03:58.76,Default,ليلي,0,0,0,,لن أتذمر منك بعد الآن.
Dialogue: 0,0:03:58.76,0:04:02.33,Default,ليلي,0,0,0,,عد إلى رشدك يا ​​صاحب الجلالة.
Dialogue: 0,0:04:03.70,0:04:06.87,Default,ليلي,0,0,0,,افعل شيئاً!
Dialogue: 0,0:04:07.23,0:04:09.57,Default,ليلي,0,0,0,,جلالتك!
Dialogue: 0,0:04:09.57,0:04:10.57,Default,ليلي,0,0,0,,مستشفى جامعة هانجوك، جانج بونج هوان
Dialogue: 0,0:04:10.57,0:04:12.17,Default,lily,0,0,0,,-شحن 100 جول.\N-Done.
Dialogue: 0,0:04:12.17,0:04:13.61,Default,ليلي,0,0,0,,ابتعد.
Dialogue: 0,0:04:16.44,0:04:18.18,Default,ليلي,0,0,0,,150 جول، انتهيت.
Dialogue: 0,0:04:19.95,0:04:22.88,Default,ليلي,0,0,0,,-لقد عاد.\N-ما هذا؟
Dialogue: 0,0:04:23.38,0:04:25.62,Default,ليلي,0,0,0,,كم هو ساطع. ماذا يفعل؟
Dialogue: 0,0:04:25.65,0:04:27.85,Default,ليلي,0,0,0,,النبض طبيعي. ضغط؟
Dialogue: 0,0:04:27.89,0:04:29.32,Default,ليلي,0,0,0,,الضغط طبيعي أيضاً.
Dialogue: 0,0:04:29.32,0:04:32.66,Default,ليلي,0,0,0,,المستشفى؟ هل عدت؟
Dialogue: 0,0:04:32.79,0:04:34.56,Default,ليلي,0,0,0,,العودة. الحقيقة عادت.
Dialogue: 0,0:04:34.56,0:04:37.56,Default,ليلي,0,0,0,,جانغ بونغ هوان، كنت تحتضر.
Dialogue: 0,0:04:37.56,0:04:38.77,Default,ليلي,0,0,0,,أعلم.
Dialogue: 0,0:04:38.77,0:04:41.60,Default,lily,0,0,0,,ظننت أنني سأحبس في جسد أنثوي لبقية حياتي.
Dialogue: 0,0:04:41.60,0:04:43.14,Default,ليلي,0,0,0,,كم عدد الأيام التي مرت؟
Dialogue: 0,0:04:43.14,0:04:45.01,Default,ليلي,0,0,0,,بالضبط. كم يوما كذبت؟
Dialogue: 0,0:04:45.01,0:04:46.61,Default,ليلي,0,0,0,,الجسد ثقيل جداً.
Dialogue: 0,0:04:46.61,0:04:48.14,Default,ليلي,0,0,0,,لقد مر أسبوع.
Dialogue: 0,0:04:48.14,0:04:50.41,Default,lily,0,0,0,,مر الوقت بنفس الطريقة كما في جوسون.
Dialogue: 0,0:04:50.41,0:04:51.81,Default,ليلي,0,0,0,,أولاً، ساعدني على النهوض.
Dialogue: 0,0:04:51.81,0:04:54.25,Default,ليلي,0,0,0,,لقد كان فاقداً للوعي لمدة أسبوع،
Dialogue: 0,0:04:54.65,0:04:56.18,Default,ليلي,0,0,0,,الآن في حالة غيبوبة.
Dialogue: 0,0:04:56.18,0:04:59.19,Default,lily,0,0,0,,ماذا يعني في الحالة الخضرية؟
Dialogue: 0,0:04:59.22,0:05:02.52,Default,ليلي,0,0,0,,يا دكتور لي، هل تتحدث عني؟
Dialogue: 0,0:05:02.52,0:05:04.63,Default,lily,0,0,0,,يا لها من حالة غيبوبة، هل أنا طبيعي؟
Dialogue: 0,0:05:04.63,0:05:05.76,Default,ليلي,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:05:05.76,0:05:07.83,Default,ليلي,0,0,0,,-راقبه.\N-نعم.
Dialogue: 0,0:05:10.20,0:05:11.43,Default,ليلي,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:05:11.43,0:05:13.57,Default,ليلي,0,0,0,,عودي! أنا بخير!
Dialogue: 0,0:05:13.57,0:05:15.14,Default,lily,0,0,0,,نعم، أنا مثل الخيار!
Dialogue: 0,0:05:15.94,0:05:18.54,Default,ليلي,0,0,0,,ماذا؟ ألا يستطيع أحد أن يسمعني؟
Dialogue: 0,0:05:18.54,0:05:21.21,Default,ليلي,0,0,0,,أنا هنا. لقد عدت.
Dialogue: 0,0:05:21.34,0:05:23.91,Default,ليلي,0,0,0,,لقد عاد "جانغ بونغ هوان"!
Dialogue: 0,0:05:24.18,0:05:26.65,Default,ليلي,0,0,0,,متى سيأتي المعالج؟
Dialogue: 0,0:05:27.28,0:05:28.32,Default,ليلي,0,0,0,,الملكة!
Dialogue: 0,0:05:28.32,0:05:30.35,Default,ليلي,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:05:30.75,0:05:33.62,Default,ليلي,0,0,0,,ملكتي، استيقظي!
Dialogue: 0,0:05:34.45,0:05:36.32,Default,ليلي,0,0,0,,ماذا يحدث هنا بحق الجحيم؟
Dialogue: 0,0:05:36.62,0:05:40.26,Default,ليلي,0,0,0,,لقد قفزت فجأة،
Dialogue: 0,0:05:40.29,0:05:43.13,Default,ليلي,0,0,0,,ثم شحب لونها وسقطت.
Dialogue: 0,0:05:43.13,0:05:45.97,Default,ليلي,0,0,0,,كيف يمكن أن تسقط فجأة؟
Dialogue: 0,0:05:45.97,0:05:47.40,Default,ليلي,0,0,0,,ربما مسموماً.
Dialogue: 0,0:05:48.40,0:05:50.40,Default,ليلي,0,0,0,,كان من الممكن أن تكون مسمومة!
Dialogue: 0,0:05:50.40,0:05:51.87,Default,ليلي,0,0,0,,ماذا؟
Dialogue: 0,0:05:52.84,0:05:55.71,Default,ليلي,0,0,0,,هذا لا يمكن أن يكون.
Dialogue: 0,0:05:55.71,0:05:57.31,Default,ليلي,0,0,0,,نحن نراقب المنتجات بعناية،
Dialogue: 0,0:05:57.31,0:05:59.05,Default,ليلي,0,0,0,,غير مسموح للغرباء هنا،
Dialogue: 0,0:05:59.05,0:06:02.38,Default,ليلي,0,0,0,,والملكة لم تأكل شيئاً هنا.
Dialogue: 0,0:06:02.78,0:06:05.02,Default,ليلي,0,0,0,,إذن ماذا كانت تفعل هنا؟
Dialogue: 0,0:06:05.02,0:06:06.75,Default,ليلي,0,0,0,,هل طبخت؟
Dialogue: 0,0:06:07.12,0:06:08.79,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:06:09.69,0:06:12.89,Default,ليلي,0,0,0,,كان من الممكن أن تصاب بالسم
Dialogue: 0,0:06:12.89,0:06:15.46,Default,ليلي,0,0,0,,تذوق الأطباق يا صاحب الجلالة.
Dialogue: 0,0:06:15.90,0:06:19.07,Default,lily,0,0,0,,لا يمكنك التأكد من ذلك.
Dialogue: 0,0:06:19.07,0:06:20.43,Default,ليلي,0,0,0,,أذن الأذن.
Dialogue: 0,0:06:20.43,0:06:22.60,Default,ليلي,0,0,0,,كنت خائفاً دائماً،
Dialogue: 0,0:06:22.60,0:06:25.61,Default,ليلي,0,0,0,,أن شيئاً كهذا سيحدث.
Dialogue: 0,0:06:25.74,0:06:29.28,Default,ليلي,0,0,0,,وأخيراً حدث ذلك!
Dialogue: 0,0:06:29.38,0:06:32.45,Default,ليلي,0,0,0,,هل تم تسميمها حقاً؟
Dialogue: 0,0:06:33.98,0:06:35.38,Default,ليلي,0,0,0,,أنا...
Dialogue: 0,0:06:35.58,0:06:37.42,Default,ليلي,0,0,0,,سألقي نظرة عليها.
Dialogue: 0,0:06:37.42,0:06:38.92,Default,ليلي,0,0,0,,لا تتردد.
Dialogue: 0,0:06:50.50,0:06:51.97,Default,ليلى,0,0,0,,نبض
Dialogue: 0,0:06:52.50,0:06:55.10,Default,ليلي,0,0,0,,ليس كالكائن الحي.
Dialogue: 0,0:06:55.47,0:06:57.27,Default,ليلي,0,0,0,,ماذا يعني هذا؟
Dialogue: 0,0:07:08.72,0:07:09.92,Default,زنبق,0,0,0,,الحالة الخضرية.
Dialogue: 0,0:07:12.12,0:07:13.45,Default,ليلي,0,0,0,,الحالة الخضرية؟
Dialogue: 0,0:07:13.45,0:07:17.69,Default,lily,0,0,0,,الإنسان لا يستطيع الحركة وهو مثل الخضار.
Dialogue: 0,0:07:19.19,0:07:21.73,Default,lily,0,0,0,,تجمع دمها وطاقة qi\Nergy في الجزء العلوي من جسدها،
Dialogue: 0,0:07:21.73,0:07:25.37,Default,lily,0,0,0,,لقد غادرت الروح الجسد، وهي بالكاد تتنفس.
Dialogue: 0,0:07:25.37,0:07:29.14,Default,lily,0,0,0,,إذا عادت طاقة تشي، فسوف تنجو. إذا لم يكن كذلك -
Dialogue: 0,0:07:31.34,0:07:33.21,Default,ليلي,0,0,0,,سوف تموت.
Dialogue: 0,0:07:36.81,0:07:38.38,Default,ليلي,0,0,0,,ماذا يعني أن تموت؟
Dialogue: 0,0:07:39.48,0:07:40.85,Default,ليلي,0,0,0,,ماذا يمكنني أن أفعل
Dialogue: 0,0:07:40.85,0:07:43.35,Default,ليلي,0,0,0,,ماذا تفعل لإنقاذها؟
Dialogue: 0,0:07:43.95,0:07:48.09,Default,lily,0,0,0,,عليك أن تسكب مغلي الكركديه وعصير الكالاموس في فمها.
Dialogue: 0,0:07:48.09,0:07:49.46,Default,ليلي,0,0,0,,رئيس الخصي.
Dialogue: 0,0:07:49.46,0:07:51.09,Default,lily,0,0,0,,أحضر كل شيء فوراً!
Dialogue: 0,0:07:51.09,0:07:52.49,Default,ليلي,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:07:52.49,0:07:54.86,Default,lily,0,0,0,,هل ستصمد الملكة حتى ذلك الحين؟
Dialogue: 0,0:07:55.80,0:07:57.73,Default,ليلي,0,0,0,,هذه هي المشكلة.
Dialogue: 0,0:07:57.73,0:08:00.83,Default,lily,0,0,0,,لا تقف هناك فحسب، افعل شيئًا!
Dialogue: 0,0:08:00.83,0:08:03.44,Default,ليلي,0,0,0,,أنقذ ملكتنا.
Dialogue: 0,0:08:03.44,0:08:07.27,Default,lily,0,0,0,,لفعل شيء ما، عليك تحريكه.
Dialogue: 0,0:08:11.45,0:08:13.08,Default,lily,0,0,0,,نذهب إلى قاعة دايجوجون.
Dialogue: 0,0:08:14.41,0:08:15.92,Default,ليلي,0,0,0,,جلالتك.
Dialogue: 0,0:08:16.48,0:08:18.08,Default,ليلي,0,0,0,,الملكة الأم.
Dialogue: 0,0:08:18.45,0:08:22.02,Default,lily,0,0,0,,نحن بحاجة إلى طرد الروح الشريرة من جسد الملكة.
Dialogue: 0,0:08:22.32,0:08:24.16,Default,ليلي,0,0,0,,لا يمكنك التردد.
Dialogue: 0,0:08:24.62,0:08:27.23,Default,ليلي,0,0,0,,وكيف نفعل هذا؟
Dialogue: 0,0:08:27.23,0:08:29.90,Default,lily,0,0,0,,دعونا نضع أشياء مخيفة حول قاعة "دايجوجون"\N
Dialogue: 0,0:08:29.90,0:08:31.90,Default,ليلى,0,0,0,,وحجب الطاقة.
Dialogue: 0,0:08:32.40,0:08:34.84,Default,lily,0,0,0,,وبعد ذلك سنقوم بطقوس طرد الروح.
Dialogue: 0,0:08:35.44,0:08:38.54,Default,ليلي,0,0,0,,هذا أمر خطير. لا يمكن أداء مثل هذه الطقوس في القصر.
Dialogue: 0,0:08:38.84,0:08:40.01,Default,ليلي,0,0,0,,إذا تم القبض علينا...
Dialogue: 0,0:08:40.01,0:08:43.01,Default,lily,0,0,0,,من غير المجدي تنفيذ الطقوس خارج القصر.
Dialogue: 0,0:08:43.34,0:08:47.41,Default,lily,0,0,0,,لكي تنجح الطقوس، قم بتنفيذها
Dialogue: 0,0:08:47.45,0:08:49.38,Default,زنبق,0,0,0,,مطلوب بالقرب من الملكة.
Dialogue: 0,0:09:01.43,0:09:02.90,Default,ليلي,0,0,0,,مباشر.
Dialogue: 0,0:09:03.06,0:09:04.40,Default,ليلي,0,0,0,,نعم.
Dialogue: 0,0:09:04.40,0:09:07.13,Default,ليلي,0,0,0,,-انتهى؟\N-نعم، كل شيء جاهز.
Dialogue: 0,0:09:20.18,0:09:22.42,Default,ليلي,0,0,0,,ماذا حدث؟
Dialogue: 0,0:09:22.62,0:09:25.12,Default,lily,0,0,0,,أصيب المريض بسكتة قلبية.
Dialogue: 0,0:09:25.12,0:09:27.45,Default,ليلي,0,0,0,,استمع. هنا. انظر هنا.
Dialogue: 0,0:09:27.45,0:09:29.02,Default,ليلي,0,0,0,,هل يمكنك سماعي؟
Dialogue: 0,0:09:32.16,0:09:33.46,Default,ليلي,0,0,0,,هل قال شيئاً؟
Dialogue: 0,0:09:33.46,0:09:36.23,Default,ليلي,0,0,0,,نعم. هل تستطيع السماع؟ كنت أعرف.
Dialogue: 0,0:09:36.23,0:09:39.37,Default,lily,0,0,0,,أسمع وأرى كل شيء، أنا لست نباتياً.
Dialogue: 0,0:09:41.00,0:09:42.10,Default,ليلي,0,0,0,,حقاً؟
Dialogue: 0,0:09:42.10,0:09:43.40,Default,ليلي,0,0,0,,هل يتكلم حقاً؟
Dialogue: 0,0:09:43.40,0:09:44.60,Default,ليلي,0,0,0,,إنه متهم زوراً.
Dialogue: 0,0:09:44.60,0:09:46.81,Default,ليلي,0,0,0,,أيها الغبي، أيها الغبي.
Dialogue: 0,0:09:46.81,0:09:49.84,Default,lily,0,0,0,,-أسمعك أيها المعتوه.\N-أنا متأكد من أنه يشعر بهذه الطريقة.
Dialogue: 0,0:09:49.98,0:09:52.31,Default,lily,0,0,0,,إنه في خضم فضيحة بين "خان\ن" ورئيس الوزراء
Dialogue: 0,0:09:52.31,0:09:53.75,Default,ليلي,0,0,0,,وسيتحمل كل اللوم على نفسه.
Dialogue: 0,0:09:53.75,0:09:55.22,Default,ليلي,0,0,0,,ما هذا؟
Dialogue: 0,0:09:55.22,0:09:57.92,Default,ليلي,0,0,0,,حيل المخرج خان؟
Dialogue: 0,0:10:06.96,0:10:08.70,Default,ليلي,0,0,0,,ابدأ العلاج.
Dialogue: 0,0:10:12.47,0:10:14.47,Default,ليلي,0,0,0,,يبدو مجنوناً،
Dialogue: 0,0:10:14.47,0:10:16.74,Default,lily,0,0,0,,ولكن من غير المرجح أن يكون قادراً على إلصاق كل شيء عليه.
Dialogue: 0,0:10:16.74,0:10:20.37,Default,ليلي,0,0,0,,ماذا يمكنه أن يفعل؟ فهو خاسر على أية حال.
Dialogue: 0,0:10:20.37,0:10:22.74,Default,lily,0,0,0,,أفضل مخرج له هو أن يكذب هنا.
Dialogue: 0,0:10:22.74,0:10:24.41,Default,ليلي,0,0,0,,هل أنت جاد الآن؟
Dialogue: 0,0:10:24.41,0:10:27.55,Default,lily,0,0,0,,في مكاني هل سيكذبون ويعانون؟
Dialogue: 0,0:10:27.55,0:10:30.08,Default,ليلي,0,0,0,,هل يستطيع المحققون قول ذلك؟
Dialogue: 0,0:10:32.55,0:10:34.02,Default,ليلى,0,0,0,,الآن
Dialogue: 0,0:10:34.15,0:10:37.79,Default,lily,0,0,0,,سأضع حياتي على المحك وأحصل على الوخز بالإبر.
Dialogue: 0,0:10:53.34,0:10:54.94,Default,ليلي,0,0,0,,لن أسمح له بأن يفلت من هذا.
Dialogue: 0,0:10:55.01,0:10:58.78,Default,ليلي,0,0,0,,المدير الشرير خان.
Dialogue: 0,0:11:03.05,0:11:04.15,Default,الأناناس,0,0,0,,الأرواح المقدسة!
Dialogue: 0,0:11:04.15,0:11:07.12,Default,الأناناس,0,0,0,,نعم، سأعض عموده الفقري!
Dialogue: 0,0:11:11.26,0:11:13.73,Default,pineapple,0,0,0,,ما الذي تنساه هنا؟
Dialogue: 0,0:11:17.93,0:11:18.93,Default,الأناناس,0,0,0,,الملكة!
Dialogue: 0,0:11:18.93,0:11:20.50,Default,أناناس,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:11:20.50,0:11:21.90,Default,الأناناس,0,0,0,,جلالتك!
Dialogue: 0,0:11:21.94,0:11:25.47,Default,pineapple,0,0,0,,لقد أكلت الكثير بالفعل،\Nنسيت أن نكون حذرين!
Dialogue: 0,0:11:25.47,0:11:28.07,Default,الأناناس,0,0,0,,ما الذي ستتناوله هناك؟
Dialogue: 0,0:11:36.98,0:11:39.75,Default,الأناناس,0,0,0,,لقد انتهى الأسوأ.
Dialogue: 0,0:11:40.99,0:11:43.46,Default,الأناناس,0,0,0,,لكن لماذا لم تستيقظ؟
Dialogue: 0,0:11:43.62,0:11:45.49,Default,الأناناس,0,0,0,,الملكة تتنفس من جديد،
Dialogue: 0,0:11:45.49,0:11:48.90,Default,pineapple,0,0,0,,لكنها لم تسترد رشدها بالكامل بعد.
Dialogue: 0,0:11:49.36,0:11:51.70,Default,pineapple,0,0,0,,علينا أن نراقبها،
Dialogue: 0,0:11:51.80,0:11:54.13,Default,الأناناس,0,0,0,,قد تسوء حالة الملكة.
Dialogue: 0,0:11:55.24,0:11:57.40,Default,pineapple,0,0,0,,بعبارة أخرى، لم ينته الأمر بعد؟
Dialogue: 0,0:11:57.40,0:11:58.94,Default,الأناناس,0,0,0,,الليلة
Dialogue: 0,0:11:59.31,0:12:00.97,Default,الأناناس,0,0,0,,سيتم حل كل شيء.
Dialogue: 0,0:12:11.42,0:12:14.49,Default,pineapple,0,0,0,,ذهب الملك إلى قاعة دايجوجونغ.
Dialogue: 0,0:12:16.22,0:12:17.42,Default,الأناناس,0,0,0,,لماذا؟
Dialogue: 0,0:12:17.42,0:12:19.79,Default,الأناناس,0,0,0,,الملكة فقدت الوعي،
Dialogue: 0,0:12:20.06,0:12:22.90,Default,pineapple,0,0,0,,يريد البقاء بجانب سريرها والاعتناء بها.
Dialogue: 0,0:12:27.00,0:12:28.50,Default,الأناناس,0,0,0,,حسنًا.
Dialogue: 0,0:12:28.67,0:12:30.60,Default,الأناناس,0,0,0,,يستحق التغيير...
Dialogue: 0,0:12:30.60,0:12:32.51,Default,الأناناس,0,0,0,,قلت أن كل شيء على ما يرام.
Dialogue: 0,0:13:05.31,0:13:06.87,Default,الأناناس,0,0,0,,أبق فمك مغلقاً.
Dialogue: 0,0:13:07.37,0:13:10.24,Default,pineapple,0,0,0,,اكتشف من ستكون حياتك في خطر.
Dialogue: 0,0:13:10.24,0:13:13.11,Default,pineapple,0,0,0,,بالطبع أفهم كل شيء.
Dialogue: 0,0:13:18.02,0:13:23.02,Default,pineapple,0,0,0,,لا أستطيع أن أصدق أن هذه الفتاة تابعة لسيدة البلاط تشوي.
Dialogue: 0,0:13:23.16,0:13:26.89,Default,الأناناس,0,0,0,,كل شيء يأتي معًا بشكل صحيح.
Dialogue: 0,0:13:27.63,0:13:31.43,Default,الأناناس,0,0,0,,عرفت ذلك، الأرواح إلى جانبنا.
Dialogue: 0,0:13:31.43,0:13:33.40,Default,الأناناس,0,0,0,,الملكة الأم، هل أنت هناك؟
Dialogue: 0,0:13:45.51,0:13:47.75,Default,الأناناس,0,0,0,,أريد أداء طقوس،
Dialogue: 0,0:13:47.75,0:13:49.92,Default,الأناناس,0,0,0,,ها أنا أستعد لذلك.
Dialogue: 0,0:13:49.92,0:13:52.75,Default,أناناس,0,0,0,,لا يوجد شيء جدي، لذا اجلس.
Dialogue: 0,0:13:53.69,0:13:55.59,Default,الأناناس,0,0,0,,أريد التحدث معك.
Dialogue: 0,0:13:57.79,0:13:59.53,Default,الأناناس,0,0,0,,أعرف كل شيء.
Dialogue: 0,0:14:00.33,0:14:03.96,Default,أناناس,0,0,0,,لقد طلبت من والدك أن يحافظ على الملكة.
Dialogue: 0,0:14:04.16,0:14:06.30,Default,الأناناس,0,0,0,,قلت تلك المرة،
Dialogue: 0,0:14:07.03,0:14:10.07,Default,pineapple,0,0,0,,أنني لست مضطرًا إلى التصرف بمفردي.
Dialogue: 0,0:14:10.07,0:14:12.51,Default,الأناناس,0,0,0,,-صحيح.\N-ولكن ماذا
Dialogue: 0,0:14:13.54,0:14:15.64,Default,الأناناس,0,0,0,,إذا أردت أن أفعل شيئاً ما؟
Dialogue: 0,0:14:17.38,0:14:18.81,Default,الأناناس,0,0,0,,ثم
Dialogue: 0,0:14:19.95,0:14:22.92,Default,الأناناس,0,0,0,,هل يمكنني التفوق على الملكة؟
Dialogue: 0,0:14:46.91,0:14:50.78,Default,الأناناس,0,0,0,,سأبقى طوال الليل، يمكنك الذهاب.
Dialogue: 0,0:14:51.81,0:14:54.71,Default,pineapple,0,0,0,,لقد تأخر الوقت، أخشى كيف حالك؟
Dialogue: 0,0:14:54.71,0:14:56.55,Default,الأناناس,0,0,0,,لم يمرضوا أيضاً.
Dialogue: 0,0:14:56.78,0:14:58.25,Default,الأناناس,0,0,0,,كل شيء سيكون على ما يرام.
Dialogue: 0,0:14:58.69,0:15:01.05,Default,الأناناس,0,0,0,,يمكنك الذهاب.
Dialogue: 0,0:15:01.39,0:15:02.82,Default,الأناناس,0,0,0,,نعم.
Dialogue: 0,0:15:15.27,0:15:18.74,Default,pineapple,0,0,0,,لم أحظى بيوم واحد هادئ هنا.
Dialogue: 0,0:15:19.01,0:15:22.24,Default,pineapple,0,0,0,,الزوج الذي أتقاسم معه نفس البطانية يحاول قتلي.
Dialogue: 0,0:15:23.68,0:15:25.45,Default,الأناناس,0,0,0,,سوف تشعر بالخدر،
Dialogue: 0,0:15:25.45,0:15:26.98,Default,الأناناس,0,0,0,,لا تتردد واضغط.
Dialogue: 0,0:15:26.98,0:15:28.48,Default,الأناناس,0,0,0,,أخرج؟
Dialogue: 0,0:15:28.58,0:15:30.52,Default,pineapple,0,0,0,,استجمعت شجاعتي للاعتذار،
Dialogue: 0,0:15:30.52,0:15:32.85,Default,pineapple,0,0,0,,وهذا ما أحصل عليه في الرد؟
Dialogue: 0,0:15:33.02,0:15:35.62,Default,pineapple,0,0,0,,اسمع، لو أن من يحتاج إلى اعتذار فقط هو
Dialogue: 0,0:15:35.62,0:15:37.29,Default,pineapple,0,0,0,,من يعتذر، وليس من يستقبلهم،
Dialogue: 0,0:15:37.29,0:15:38.76,Default,الأناناس,0,0,0,,هل هذا اعتذار؟
Dialogue: 0,0:15:39.49,0:15:42.70,Default,الأناناس,0,0,0,,لقد ضاعت اللحظة. ليس هناك فائدة من قول أي شيء.
Dialogue: 0,0:15:45.53,0:15:47.90,Default,الأناناس,0,0,0,,كنت أتمنى
Dialogue: 0,0:15:48.27,0:15:50.80,Default,pineapple,0,0,0,,سأحصل على فرصة لفهمك.
Dialogue: 0,0:15:57.41,0:16:01.58,Default,أناناس,0,0,0,,هذا قماش باهظ الثمن.
Dialogue: 0,0:16:01.88,0:16:04.25,Default,الأناناس,0,0,0,,إذا استخدمته،
Dialogue: 0,0:16:04.48,0:16:06.89,Default,الأناناس,0,0,0,,سأتذكره لبقية حياتي.
Dialogue: 0,0:16:06.89,0:16:08.39,Default,الأناناس,0,0,0,,هل أنت متأكد؟
Dialogue: 0,0:16:09.72,0:16:12.63,Default,الأناناس,0,0,0,,لقد أحضروا لك الحرير لتصنعيه
Dialogue: 0,0:16:12.63,0:16:14.69,Default,أناناس,0,0,0,,زهور حريرية للولائم.
Dialogue: 0,0:16:14.69,0:16:15.93,Default,الأناناس,0,0,0,,صحيح.
Dialogue: 0,0:16:15.93,0:16:19.40,Default,pineapple,0,0,0,,ولم يتبقى لديك أي قماش زائد؟
Dialogue: 0,0:16:20.60,0:16:23.00,Default,الأناناس,0,0,0,,الأمر هو،
Dialogue: 0,0:16:24.20,0:16:25.61,Default,الأناناس,0,0,0,,رئيس المطبخ,
Dialogue: 0,0:16:25.61,0:16:28.44,Default,الأناناس,0,0,0,,سيد. أخذ كيم مون جيون القماش.
Dialogue: 0,0:16:33.81,0:16:37.88,Default,pineapple,0,0,0,,هل كان هناك قطعة مماثلة بين هذا القماش؟
Dialogue: 0,0:16:38.48,0:16:40.65,Default,الأناناس,0,0,0,,هذا...
Dialogue: 0,0:17:00.34,0:17:02.18,Default,الأناناس,0,0,0,,لقد رأيته يحرق شيئاً ثميناً،
Dialogue: 0,0:17:02.18,0:17:05.35,Default,الأناناس,0,0,0,,وجدتها مشبوهة فأخرجتها من النار.
Dialogue: 0,0:17:05.38,0:17:06.95,Default,الأناناس,0,0,0,,أنا متأكد من أنها هي.
Dialogue: 0,0:17:08.78,0:17:10.52,Default,الأناناس,0,0,0,,الأمير يونبيونغ؟
Dialogue: 0,0:17:18.29,0:17:20.69,Default,pineapple,0,0,0,,هل للملك فعلاً علاقة بهذا؟
Dialogue: 0,0:17:21.13,0:17:22.66,Default,الأناناس,0,0,0,,ماذا قلت؟
Dialogue: 0,0:17:22.66,0:17:24.06,Default,الأناناس,0,0,0,,الملكة الأم والمحظية تشو
Dialogue: 0,0:17:24.06,0:17:26.90,Default,pineapple,0,0,0,,هل يؤدون طقوساً معاً داخل جدران القصر؟
Dialogue: 0,0:17:26.97,0:17:28.37,Default,الأناناس,0,0,0,,صحيح.
Dialogue: 0,0:17:29.27,0:17:31.84,Default,pineapple,0,0,0,,اعتقدت أن المحظية الملكية لديها ما يكفي من العقل حتى لا تتورط في هذا،
Dialogue: 0,0:17:31.84,0:17:34.67,Default,pineapple,0,0,0,,لكن يبدو أنها مثل الملكة الأم.
Dialogue: 0,0:17:35.88,0:17:37.28,Default,الأناناس,0,0,0,,هذا أفضل.
Dialogue: 0,0:17:37.28,0:17:40.41,Default,pineapple,0,0,0,,يمكنني أن ألقن هؤلاء المجانين درساً جيداً.
Dialogue: 0,0:17:40.41,0:17:42.12,Default,pineapple,0,0,0,,إذا توبيخهم على الطقوس
Dialogue: 0,0:17:42.12,0:17:44.62,Default,الأناناس,0,0,0,,والتعويذات، ستبدأ الشائعات.
Dialogue: 0,0:17:45.28,0:17:47.49,Default,الأناناس,0,0,0,,لكنهم لن يتوقفوا.
Dialogue: 0,0:17:48.12,0:17:49.82,Default,الأناناس,0,0,0,,أنت على حق.
Dialogue: 0,0:17:50.06,0:17:53.53,Default,pineapple,0,0,0,,أتمنى أن أفعل\Nsomething أكثر جوهرية.
Dialogue: 0,0:17:55.93,0:17:58.93,Default,pineapple,0,0,0,,هذا هو رئيس الخصي! لدي أخبار عاجلة!
Dialogue: 0,0:17:58.93,0:18:00.33,Default,الأناناس,0,0,0,,تفضل بالدخول.
Dialogue: 0,0:18:06.01,0:18:07.57,Default,الأناناس,0,0,0,,ماذا حدث؟
Dialogue: 0,0:18:07.77,0:18:12.18,Default,pineapple,0,0,0,,فقدت الملكة أنفاسها، وهي فاقدة للوعي.
Dialogue: 0,0:18:13.35,0:18:15.01,Default,الأناناس,0,0,0,,هل فقدت أنفاسك؟
Dialogue: 0,0:18:15.01,0:18:18.32,Default,pineapple,0,0,0,,أعاد لها المعالج أنفاسها،
Dialogue: 0,0:18:18.32,0:18:20.72,Default,الأناناس,0,0,0,,لكنها تحتاج إلى مراقبتها طوال الليل.
Dialogue: 0,0:18:20.72,0:18:23.02,Default,الأناناس,0,0,0,,ماذا حدث؟
Dialogue: 0,0:18:23.02,0:18:28.90,Default,pineapple,0,0,0,,هناك اشتباه في أن الملكة ماتت مسمومة أثناء الطبخ في المطبخ.
Dialogue: 0,0:18:35.90,0:18:38.87,Default,الأناناس,0,0,0,,كيم سويون
Dialogue: 0,0:18:42.91,0:18:45.51,Default,الأناناس,0,0,0,,
Dialogue: 0,0:19:14.57,0:19:16.94,Default,pineapple,0,0,0,,إذا كنت تريد القتال من كل قلبك،
Dialogue: 0,0:19:19.61,0:19:22.08,Default,pineapple,0,0,0,,إذا كنت تريد أن تهزمها من كل قلبك،
Dialogue: 0,0:19:22.22,0:19:27.22,Default,pineapple,0,0,0,,من الآن\Nيجب ألا تكون لديك أسرار مني.
Dialogue: 0,0:19:30.79,0:19:32.63,Default,الأناناس,0,0,0,,هل توافقين على ذلك؟
Dialogue: 0,0:19:34.36,0:19:37.70,Default,الأناناس,0,0,0,,نعم، أوافق.
Dialogue: 0,0:19:40.70,0:19:43.14,Default,pineapple,0,0,0,,إذن أخبرني إذا كان الأمر يستحق العناء
Dialogue: 0,0:19:43.14,0:19:45.97,Default,أناناس,0,0,0,,هل يعرف الملك ما الذي يحدث هنا؟
Dialogue: 0,0:19:55.82,0:19:57.92,Default,الأناناس,0,0,0,,الملك يرغب
Dialogue: 0,0:19:58.89,0:20:01.05,Default,الأناناس,0,0,0,,مثلنا.
Dialogue: 0,0:20:15.70,0:20:18.04,Default,الأناناس,0,0,0,,هل تتنفس؟
Dialogue: 0,0:20:24.08,0:20:25.71,Default,الأناناس,0,0,0,,يتنفس.
Dialogue: 0,0:20:26.28,0:20:27.61,Default,الأناناس,0,0,0,,لكن إذا كانت نائمة،
Dialogue: 0,0:20:27.61,0:20:30.52,Default,الأناناس,0,0,0,,لماذا هي هادئة جداً؟
Dialogue: 0,0:20:33.12,0:20:36.26,Default,الأناناس,0,0,0,,ما هذا؟ هل تأذيت؟
Dialogue: 0,0:20:36.32,0:20:38.16,Default,الأناناس,0,0,0,,لماذا؟
Dialogue: 0,0:20:39.29,0:20:42.23,Default,الأناناس,0,0,0,,لطالما أردت ابنة،
Dialogue: 0,0:20:42.83,0:20:45.50,Default,الأناناس,0,0,0,,هل أنت سعيد الآن؟
Dialogue: 0,0:20:47.67,0:20:50.14,Default,pineapple,0,0,0,,أنت تتألم، أنت تعاني.
Dialogue: 0,0:20:51.00,0:20:53.44,Default,pineapple,0,0,0,,لا بد أنك تفتقد والدتك أكثر الآن.
Dialogue: 0,0:21:15.13,0:21:17.26,Default,الأناناس,0,0,0,,يمكنك التعامل مع كل شيء.
Dialogue: 0,0:21:18.00,0:21:21.27,Default,pineapple,0,0,0,,أتمنى لك الشفاء العاجل،\Nلتمتلئ بالقوة والطاقة مرة أخرى.
Dialogue: 0,0:21:21.50,0:21:25.91,Default,pineapple,0,0,0,,لقد وعدتني بالعيش\Nمع اتباع قاعدة التباعد الاجتماعي.
Dialogue: 0,0:21:26.61,0:21:30.58,Default,pineapple,0,0,0,,سوف أسامحك وعلى كلامك الغريب،
Dialogue: 0,0:21:31.31,0:21:33.05,Default,الأناناس,0,0,0,,والسلوك الوقح.
Dialogue: 0,0:21:37.42,0:21:39.59,Default,الأناناس,0,0,0,,فقط استيقظ.
Dialogue: 0,0:21:59.47,0:22:01.17,Default,pineapple,0,0,0,,أنا سعيد للغاية لأنك لم تغادر بعد.
Dialogue: 0,0:22:01.17,0:22:02.98,Default,الأناناس,0,0,0,,ما هذا؟
Dialogue: 0,0:22:02.98,0:22:05.75,Default,الأناناس,0,0,0,,الملكة في حالة غيبوبة.
Dialogue: 0,0:22:06.15,0:22:08.58,Default,الأناناس,0,0,0,,هل توقفت عن التنفس؟
Dialogue: 0,0:22:08.58,0:22:11.42,Default,pineapple,0,0,0,,لحسن الحظ أعاده لها الطبيب.
Dialogue: 0,0:22:12.29,0:22:15.79,Default,أناناس,0,0,0,,أريدك أن تذهب إلى قاعة سيونغ وونجونغ.
Dialogue: 0,0:22:16.89,0:22:19.16,Default,الأناناس,0,0,0,,هناك من يريد إيذاء الملكة؟
Dialogue: 0,0:22:19.16,0:22:23.43,Default,pineapple,0,0,0,,سوف نضرب الملكة الأم والمحظية تشو.
Dialogue: 0,0:22:30.34,0:22:34.01,Default,الأناناس,0,0,0,,اذهب بعيداً أيها الروح الشرير!
Dialogue: 0,0:22:34.01,0:22:37.68,Default,الأناناس,0,0,0,,يا إلهي، استمع إلى صلواتي!
Dialogue: 0,0:22:37.68,0:22:42.78,Default,الأناناس,0,0,0,,اطرد الروح الشريرة!
Dialogue: 0,0:22:50.52,0:22:52.56,Default,الأناناس,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:22:53.46,0:22:56.73,Default,pineapple,0,0,0,,كيف تجرؤ على اقتحام هنا؟\Nألا تعرف ما هو هذا المكان؟
Dialogue: 0,0:22:56.73,0:22:59.10,Default,pineapple,0,0,0,,هل تعتقد أنك تستطيع الإفلات من هذا؟
Dialogue: 0,0:23:06.57,0:23:09.41,Default,pineapple,0,0,0,,سأطلب منك نفس الشيء.\Nهل تعتقد أنه يشكل تهديداً للحياة؟
Dialogue: 0,0:23:09.41,0:23:11.61,Default,الأناناس,0,0,0,,ملكة يمكنك الهروب منها؟
Dialogue: 0,0:23:13.88,0:23:15.45,Default,أناناس,0,0,0,,-ما الأمر؟\N-ابتعد عن الطريق!
Dialogue: 0,0:23:15.45,0:23:18.15,Default,pineapple,0,0,0,,-ماذا تفعل؟\N-ابحث في كل شيء!
Dialogue: 0,0:23:19.85,0:23:21.49,Default,الأناناس,0,0,0,,يا له من رعب! ماذا تفعل؟
Dialogue: 0,0:23:21.49,0:23:23.86,Default,أناناس,0,0,0,,-أوه لا!\N-يا له من رعب!
Dialogue: 0,0:23:25.09,0:23:29.73,Default,pineapple,0,0,0,,صليت من أجل حياة هادئة في القصر!
Dialogue: 0,0:23:36.54,0:23:39.97,Default,pineapple,0,0,0,,تم العثور على هذا الجرذ بالقرب من قاعة دايجوجون.
Dialogue: 0,0:23:40.11,0:23:43.11,Default,الأناناس,0,0,0,,ليس لي علاقة بالأمر.
Dialogue: 0,0:23:43.98,0:23:46.85,Default,pineapple,0,0,0,,هل تريد أن تقول إن الشامان تصرف بمفرده؟
Dialogue: 0,0:23:47.98,0:23:52.89,Default,pineapple,0,0,0,,يبدو أن آلهتك لم تخبرك متى ستموت.
Dialogue: 0,0:23:55.39,0:23:57.52,Default,الأناناس,0,0,0,,سيحدث اليوم.
Dialogue: 0,0:24:00.69,0:24:03.63,Default,الأناناس,0,0,0,,من فضلك، أنقذني.
Dialogue: 0,0:24:03.83,0:24:08.00,Default,pineapple,0,0,0,,كنت أتبع أوامر الملكة الأم للتو.
Dialogue: 0,0:24:08.03,0:24:09.57,Default,الأناناس,0,0,0,,أغلق فمك!
Dialogue: 0,0:24:11.07,0:24:15.57,Default,pineapple,0,0,0,,سأؤدي طقوساً ستكسر اللعنة.
Dialogue: 0,0:24:16.21,0:24:18.68,Default,pineapple,0,0,0,,طقوس ستكسر اللعنة؟
Dialogue: 0,0:24:20.95,0:24:23.08,Default,الأناناس,0,0,0,,أنت تخدم الله، وليس ملكك!
Dialogue: 0,0:24:23.08,0:24:25.35,Default,pineapple,0,0,0,,يبدو أنك قررت أن القصر عبارة عن سيرك!
Dialogue: 0,0:24:25.35,0:24:26.89,Default,الأناناس,0,0,0,,كل شيء خاطئ!
Dialogue: 0,0:24:27.09,0:24:28.25,Default,الأناناس,0,0,0,,متأخراً.
Dialogue: 0,0:24:28.25,0:24:30.76,Default,الأناناس,0,0,0,,حياة الملكة في خطر.
Dialogue: 0,0:24:32.56,0:24:33.86,Default,الأناناس,0,0,0,,هذا لا يمكن أن يكون.
Dialogue: 0,0:24:33.86,0:24:35.73,Default,الأناناس,0,0,0,,لقد أديت الطقوس.
Dialogue: 0,0:24:35.73,0:24:38.56,Default,pineapple,0,0,0,,والآن أنت لا تؤمن بعواقبه؟
Dialogue: 0,0:24:39.70,0:24:41.23,Default,pineapple,0,0,0,,لقد خدعك محتال!
Dialogue: 0,0:24:41.23,0:24:43.17,Default,الأناناس,0,0,0,,انظر إلى أين أدى هذا!
Dialogue: 0,0:24:43.77,0:24:46.47,Default,pineapple,0,0,0,,بسببك، انتهت سمعة الأسرة بأكملها،
Dialogue: 0,0:24:46.47,0:24:48.34,Default,الأناناس,0,0,0,,لقد حاولت قتل الملكة،
Dialogue: 0,0:24:48.34,0:24:49.61,Default,الأناناس,0,0,0,,وارتكبت أيضًا جريمة خطيرة،
Dialogue: 0,0:24:49.61,0:24:51.04,Default,الأناناس,0,0,0,,يحيرنا جميعاً!
Dialogue: 0,0:24:51.04,0:24:54.78,Default,pineapple,0,0,0,,كيف ستدفع ثمن خطاياك؟
Dialogue: 0,0:24:56.02,0:25:00.19,Default,الأناناس,0,0,0,,هل لي أن أعرف حالة الملكة؟
Dialogue: 0,0:25:02.12,0:25:04.92,Default,pineapple,0,0,0,,تتظاهر أنك لا تعرف الإجابة؟
Dialogue: 0,0:25:04.92,0:25:07.43,Default,pineapple,0,0,0,,حسناً، سأخبرك بما حدث للملكة.
Dialogue: 0,0:25:07.86,0:25:09.40,Default,الأناناس,0,0,0,,لقد تسممت.
Dialogue: 0,0:25:10.00,0:25:13.90,Default,الأناناس,0,0,0,,تم العثور على الزرنيخ بين المنتجات في المطبخ.
Dialogue: 0,0:25:16.34,0:25:17.80,Default,الأناناس,0,0,0,,الزرنيخ.
Dialogue: 0,0:25:18.54,0:25:22.04,Default,pineapple,0,0,0,,أنا متأكد من أنك تعرف أي نوع من السم هذا.
Dialogue: 0,0:25:31.78,0:25:33.39,Default,الأناناس,0,0,0,,أنا متأكدة،
Dialogue: 0,0:25:34.19,0:25:37.99,Default,Pineapple,0,0,0,,أنت تعرف عنها أكثر مني.
Dialogue: 0,0:25:40.03,0:25:42.19,Default,pineapple,0,0,0,,ومرة أخرى عدت إلى الأيام الخوالي.
Dialogue: 0,0:25:42.60,0:25:46.70,Default,pineapple,0,0,0,,مرة أخرى تتهمني بقتل الملك.
Dialogue: 0,0:25:49.74,0:25:53.91,Default,pineapple,0,0,0,,الناس حمقى ينسون الماضي بسرعة.
Dialogue: 0,0:25:54.61,0:25:58.68,Default,pineapple,0,0,0,,لا تعرف مدى قيمة الحياة التي يتم إنقاذها على حساب حياة طفلك.
Dialogue: 0,0:26:03.78,0:26:05.75,Default,الأناناس,0,0,0,,في ذلك الوقت كنت أنت
Dialogue: 0,0:26:05.75,0:26:08.12,Default,الأناناس,0,0,0,,توسلت إليّ.
Dialogue: 0,0:26:08.49,0:26:10.92,Default,pineapple,0,0,0,,بدلاً من التحقيق في وفاة الملك،
Dialogue: 0,0:26:10.92,0:26:12.39,Default,الأناناس,0,0,0,,مسموم بالزرنيخ،
Dialogue: 0,0:26:12.39,0:26:15.26,Default,الأناناس,0,0,0,,لقد طلبت مني حياتك.
Dialogue: 0,0:26:17.66,0:26:19.40,Default,الأناناس,0,0,0,,وماذا أرى؟
Dialogue: 0,0:26:19.40,0:26:23.27,Default,pineapple,0,0,0,,لقد استدرجت المحظية البريئة "تشو" إلى طقوسك القذرة وحاولت تسميم الملكة!
Dialogue: 0,0:26:23.37,0:26:26.77,Default,pineapple,0,0,0,,ألا تخجل من الملك المتوفى؟
Dialogue: 0,0:26:27.74,0:26:29.84,Default,pineapple,0,0,0,,رغم أنك تتفاجأ، إذا كان لديك ضمير،
Dialogue: 0,0:26:29.84,0:26:32.48,Default,الأناناس,0,0,0,,كنت ستموت بعده.
Dialogue: 0,0:26:33.71,0:26:37.02,Default,الأناناس,0,0,0,,الاعتذار عديم الفائدة.
Dialogue: 0,0:26:38.78,0:26:41.32,Default,الأناناس,0,0,0,,أنت تعرف أكثر من أي شخص آخر،
Dialogue: 0,0:26:41.39,0:26:43.92,Default,الأناناس,0,0,0,,كم كنت مخطئاً.
Dialogue: 0,0:26:43.92,0:26:46.56,Default,pineapple,0,0,0,,بما أنك تعتقد ذلك، فليس لدي أي خيار.
Dialogue: 0,0:26:46.56,0:26:47.96,Default,الأناناس,0,0,0,,أنا أطلب
Dialogue: 0,0:26:48.19,0:26:51.96,Default,الأناناس,0,0,0,,ربع الشامان وسيدة البلاط خان!
Dialogue: 0,0:26:51.96,0:26:53.37,Default,الأناناس,0,0,0,,-نعم!\N-نعم!
Dialogue: 0,0:26:55.10,0:27:00.57,Default,الأناناس,0,0,0,,من فضلك، أنقذني!
Dialogue: 0,0:27:00.57,0:27:03.61,Default,الأناناس,0,0,0,,دعني أذهب!
Dialogue: 0,0:27:04.71,0:27:06.65,Default,الأناناس,0,0,0,,أما الملكة الأم...
Dialogue: 0,0:27:08.21,0:27:09.65,Default,الأناناس,0,0,0,,من فضلك!
Dialogue: 0,0:27:11.72,0:27:13.32,Default,الأناناس,0,0,0,,ارحمني!
Dialogue: 0,0:27:15.05,0:27:17.76,Default,الأناناس,0,0,0,,من فضلك أنقذني!
Dialogue: 0,0:27:17.76,0:27:20.36,Default,pineapple,0,0,0,,لن يساعدك الدعاء هذه المرة!
Dialogue: 0,0:27:20.36,0:27:24.30,Default,pineapple,0,0,0,,إلى متى يجب أن أغض الطرف عن آثامك؟
Dialogue: 0,0:27:24.30,0:27:27.23,Default,pineapple,0,0,0,,لن تفلت بهذه السهولة هذه المرة!
Dialogue: 0,0:27:27.53,0:27:29.07,Default,الأناناس,0,0,0,,لقد كنت مخطئاً!
Dialogue: 0,0:27:29.23,0:27:32.47,Default,الأناناس,0,0,0,,من فضلك أعطني فرصة
Dialogue: 0,0:27:32.47,0:27:34.34,Default,الأناناس,0,0,0,,يكفر!
Dialogue: 0,0:27:34.34,0:27:38.28,Default,pineapple,0,0,0,,كيف ستكفر عن مثل هذه الخطيئة الجسيمة؟
Dialogue: 0,0:27:41.81,0:27:44.45,Default,الأناناس,0,0,0,,يجب أن تكون متأكداً
Dialogue: 0,0:27:45.72,0:27:47.19,Default,الأناناس,0,0,0,,ذلك الملك
Dialogue: 0,0:27:47.62,0:27:51.52,Default,pineapple,0,0,0,,أخضع لك من كل قلبي.
Dialogue: 0,0:27:52.06,0:27:54.96,Default,pineapple,0,0,0,,كنت على يقين من أن الملك المتوفى كان في قوتك،
Dialogue: 0,0:27:54.96,0:27:58.46,Default,pineapple,0,0,0,,لذلك استقالوا من منصب الوصي.
Dialogue: 0,0:27:58.56,0:28:00.53,Default,الأناناس,0,0,0,,أم نسيت؟
Dialogue: 0,0:28:10.38,0:28:12.98,Default,fe,0,0,0,,هل يزعجك كلام الملكة الأم؟
Dialogue: 0,0:28:18.95,0:28:21.15,Default,fe,0,0,0,,لراحة بالك، سأتحقق،
Dialogue: 0,0:28:22.09,0:28:24.32,Default,fe,0,0,0,,أي نوع من الأشخاص هو جلالته؟
Dialogue: 0,0:28:33.63,0:28:35.77,Default,fe,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:28:38.34,0:28:39.81,Default,fe,0,0,0,,جلالتك!
Dialogue: 0,0:28:47.91,0:28:49.28,Default,fe,0,0,0,,ما كل هذه الضجة؟
Dialogue: 0,0:28:49.28,0:28:51.45,Default,fe,0,0,0,,أنا أترجم الملكة.
Dialogue: 0,0:28:52.92,0:28:54.42,Default,fe,0,0,0,,النقل؟
Dialogue: 0,0:28:55.22,0:28:56.59,Default,fe,0,0,0,,أين؟
Dialogue: 0,0:28:57.12,0:28:59.02,Default,fe,0,0,0,,لا أستطيع أن أخبرك.
Dialogue: 0,0:29:11.20,0:29:14.51,Default,fe,0,0,0,,ألا تستطيع أن تخبرني إلى أين تأخذ الملكة؟
Dialogue: 0,0:29:18.31,0:29:20.31,Default,fe,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:29:20.81,0:29:22.41,Default,fe,0,0,0,,قناع الأكاذيب.
Dialogue: 0,0:29:22.41,0:29:26.62,Default,fe,0,0,0,,لقد لعنت الملكة في سيونغ وونجونغ.
Dialogue: 0,0:29:26.99,0:29:28.45,Default,fe,0,0,0,,كانت الملكة الأم
Dialogue: 0,0:29:28.99,0:29:31.09,Default,fe,0,0,0,,والمحظية الملكية "تشو".
Dialogue: 0,0:29:33.06,0:29:36.13,Default,fe,0,0,0,,المحظية تشو لن تفعل ذلك أبداً.
Dialogue: 0,0:29:36.70,0:29:40.10,Default,fe,0,0,0,,هل تريد أن تقول أن سبب مرض الملكة هو لعنة؟
Dialogue: 0,0:29:40.97,0:29:43.77,Default,fe,0,0,0,,تم العثور على الزرنيخ في المطبخ الملكي.
Dialogue: 0,0:29:48.64,0:29:51.84,Default,fe,0,0,0,,الآن سيتم إجراء التحقيق من قبل قسم المباحث.
Dialogue: 0,0:29:52.08,0:29:54.91,Default,fe,0,0,0,,وبهذا الصدد، لدي أسئلة لك.
Dialogue: 0,0:29:56.18,0:29:58.48,Default,fe,0,0,0,,ماذا وأين فعلت مع الأمير يونبيونغ
Dialogue: 0,0:29:58.98,0:30:02.52,Default,fe,0,0,0,,الليلة التي تلت الزفاف الملكي؟
Dialogue: 0,0:30:04.42,0:30:07.09,Default,fe,0,0,0,,ماذا تسمح لنفسك؟
Dialogue: 0,0:30:07.23,0:30:09.73,Default,fe,0,0,0,,أظهر وجهك الحقيقي.
Dialogue: 0,0:30:09.73,0:30:12.16,Default,fe,0,0,0,,من الواضح أن ذاكرتك تخونك.
Dialogue: 0,0:30:12.97,0:30:16.47,Default,fe,0,0,0,,إذا كان الأمر كذلك، فسأضطر إلى استجواب الأمير رسميًا.
Dialogue: 0,0:30:21.11,0:30:23.01,Default,fe,0,0,0,,ليست خطوة أبعد!
Dialogue: 0,0:30:26.88,0:30:28.31,Default,fe,0,0,0,,جلالتك.
Dialogue: 0,0:30:39.22,0:30:41.66,Default,fe,0,0,0,,من فضلك لا تتحرك.
Dialogue: 0,0:30:42.13,0:30:46.33,Default,fe,0,0,0,,وإلا فسيضطر حراسك\Nإلى عدم احترامك وإيذاءك.
Dialogue: 0,0:31:03.68,0:31:05.25,Default,fe,0,0,0,,توقف.
Dialogue: 0,0:31:06.35,0:31:07.92,Default,fe,0,0,0,,هذا أمر الملك.
Dialogue: 0,0:31:12.52,0:31:14.23,Default,fe,0,0,0,,هذه امرأتي.
Dialogue: 0,0:31:16.40,0:31:19.60,Default,fe,0,0,0,,المسها ولو بإصبعك،
Dialogue: 0,0:31:20.10,0:31:22.77,Default,fe,0,0,0,,وهذا السيف سيقطع حلقك.
Dialogue: 0,0:31:30.21,0:31:34.11,Default,fe,0,0,0,,لم أكن أعلم أن الملكة عزيزة عليك إلى هذه الدرجة.
Dialogue: 0,0:31:34.45,0:31:36.85,Default,fe,0,0,0,,أنت لا تعرف الكثير من الأشياء.
Dialogue: 0,0:31:38.02,0:31:40.29,Default,fe,0,0,0,,دعني ألقنك درساً.
Dialogue: 0,0:31:54.93,0:31:56.67,Default,fe,0,0,0,,هل يمكنك رؤيتي؟
Dialogue: 0,0:32:01.37,0:32:04.51,Default,fe,0,0,0,,أنا ملك هذا البلد!
Dialogue: 0,0:32:07.31,0:32:09.85,Default,fe,0,0,0,,من أنت أيها المحارب؟
Dialogue: 0,0:32:11.42,0:32:13.22,Default,fe,0,0,0,,حارسي.
Dialogue: 0,0:32:14.45,0:32:16.69,Default,fe,0,0,0,,ابتعد.
Dialogue: 0,0:32:29.64,0:32:31.14,Default,fe,0,0,0,,جلالتك.
Dialogue: 0,0:32:35.14,0:32:37.24,Default,fe,0,0,0,,أليست هذه خيانة؟
Dialogue: 0,0:32:38.08,0:32:39.98,Default,fe,0,0,0,,أزل شعبك،
Dialogue: 0,0:32:40.21,0:32:43.42,Default,fe,0,0,0,,إذا كنت لا تريد إراقة الدماء في دايجوجون.
Dialogue: 0,0:32:43.48,0:32:46.62,Default,fe,0,0,0,,إذا أمرت أيها الأمير يونبيونغ
Dialogue: 0,0:32:46.62,0:32:49.99,Default,fe,0,0,0,,سيسعده أن يتسخ يديه.
Dialogue: 0,0:32:51.09,0:32:53.56,Default,fe,0,0,0,,لدي فقط أسئلة لك.
Dialogue: 0,0:32:53.76,0:32:55.93,Default,fe,0,0,0,,لقد أتيت في الوقت المحدد.
Dialogue: 0,0:32:59.03,0:33:01.93,Default,fe,0,0,0,,لم آمر ببدء التحقيق.
Dialogue: 0,0:33:03.84,0:33:08.17,Default,fe,0,0,0,,إلى من يقدم قسم المباحث تقاريره الآن؟
Dialogue: 0,0:33:13.51,0:33:16.21,Default,fe,0,0,0,,أولاً سأدرس الأمر بنفسي.
Dialogue: 0,0:33:18.05,0:33:21.05,Default,fe,0,0,0,,ولا يمكنك اتهام الأبرياء مرة أخرى.
Dialogue: 0,0:33:21.05,0:33:24.32,Default,fe,0,0,0,,فقط الملكة بريئة هنا!
Dialogue: 0,0:33:25.19,0:33:27.13,Default,fe,0,0,0,,لقد أخبرتك بالفعل.
Dialogue: 0,0:33:27.13,0:33:31.00,Default,fe,0,0,0,,اجعلها تعاني، وستصبح حياتك أيضاً عذاباً.
Dialogue: 0,0:33:32.53,0:33:37.10,Default,fe,0,0,0,,قلت إن هذا لم يكن تهديدًا.\Nولكن يجب أن أتراجع عن كلامي.
Dialogue: 0,0:33:37.10,0:33:38.74,Default,fe,0,0,0,,كيف تجرؤ!
Dialogue: 0,0:33:49.28,0:33:53.02,Default,fe,0,0,0,,هذه المرأة لم تعد ابنة عمك.
Dialogue: 0,0:33:54.19,0:33:56.22,Default,fe,0,0,0,,سعادتها،
Dialogue: 0,0:33:56.59,0:33:59.86,Default,fe,0,0,0,,الأحزان والسلامة أصبحت الآن مصدر قلق
Dialogue: 0,0:34:00.33,0:34:03.03,Default,fe,0,0,0,,ليس رئيس قسم المباحث - أنت،
Dialogue: 0,0:34:03.56,0:34:05.23,Default,fe,0,0,0,,وأنا.
Dialogue: 0,0:34:10.27,0:34:12.67,Default,fe,0,0,0,,سيتم نقل الملكة إلى منزل عائلتها.
Dialogue: 0,0:34:15.87,0:34:17.94,Default,fe,0,0,0,,جهز المحفّة.
Dialogue: 0,0:34:18.44,0:34:19.85,Default,fe,0,0,0,,-نعم.\N-نعم.
Dialogue: 0,0:34:31.39,0:34:32.86,Default,fe,0,0,0,,المغادرة.
Dialogue: 0,0:34:43.77,0:34:45.30,Default,fe,0,0,0,,لقد تأخرت.
Dialogue: 0,0:34:45.30,0:34:46.74,Default,fe,0,0,0,,أنت كذلك
Dialogue: 0,0:34:47.74,0:34:49.84,Default,fe,0,0,0,,حاولوا إخفاء هذا الجانب من أنفسهم.
Dialogue: 0,0:35:12.03,0:35:13.80,Default,fe,0,0,0,,راقبها بعناية.
Dialogue: 0,0:35:14.03,0:35:15.43,Default,fe,0,0,0,,نعم.
Dialogue: 0,0:35:15.60,0:35:17.77,Default,fe,0,0,0,,آسف على تركك بمفردك.
Dialogue: 0,0:35:31.28,0:35:34.12,Default,fe,0,0,0,,كن على أهبة الاستعداد حتى وصولك.
Dialogue: 0,0:35:34.25,0:35:36.79,Default,fe,0,0,0,,واقف للحراسة طوال الليل عند الوصول.
Dialogue: 0,0:35:36.79,0:35:38.29,Default,fe,0,0,0,,نعم!
Dialogue: 0,0:35:53.61,0:35:57.78,Default,fe,0,0,0,,أراهن أن الجميع ما عداي سيتمكنون من الزفير في القصر.
Dialogue: 0,0:35:58.18,0:36:01.55,Default,fe,0,0,0,,ولماذا يجعلك هذا تشعر بتحسن؟
Dialogue: 0,0:36:04.22,0:36:07.85,Default,fe,0,0,0,,انتظر، كان ينبغي أن يكون كيم هوان هنا الآن.
Dialogue: 0,0:36:10.06,0:36:11.69,Default,fe,0,0,0,,وهنا يأتي الشيطان نفسه.
Dialogue: 0,0:36:15.13,0:36:16.63,Default,fe,0,0,0,,كنت قلقة بالفعل من أننا لن نرى بعضنا البعض
Dialogue: 0,0:36:16.63,0:36:18.50,Default,fe,0,0,0,,قبل أن أغادر...
Dialogue: 0,0:36:20.00,0:36:21.50,Default,fe,0,0,0,,ومن هذا؟
Dialogue: 0,0:36:22.73,0:36:25.94,Default,fe,0,0,0,,لقد وجدت اليوم صديقًا جيدًا.
Dialogue: 0,0:36:25.94,0:36:29.31,Default,fe,0,0,0,,هذا لي سينبان.
Dialogue: 0,0:36:29.31,0:36:32.48,Default,fe,0,0,0,,التقينا عندما كنت أبحث عن صديقي لي سينمان.
Dialogue: 0,0:36:33.11,0:36:37.05,Default,fe,0,0,0,,مقدر لنا أن نكون أصدقاء.
Dialogue: 0,0:36:37.62,0:36:39.75,Default,fe,0,0,0,,أردت أن أتناول مشروباً معك
Dialogue: 0,0:36:40.02,0:36:42.05,Default,fe,0,0,0,,وأوراق اللعب.
Dialogue: 0,0:36:42.59,0:36:44.99,Default,fe,0,0,0,,هل تريد حانة هنا أم ماذا؟
Dialogue: 0,0:36:45.22,0:36:48.46,Default,fe,0,0,0,,الشرب ولعب الورق؟ أي نوع من الأشخاص أنت؟
Dialogue: 0,0:36:48.46,0:36:51.50,Default,fe,0,0,0,,ماذا؟ هذا ما نفعله هنا.
Dialogue: 0,0:36:51.50,0:36:53.83,Default,fe,0,0,0,,أنت فقط من يستطيع فعل هذا.
Dialogue: 0,0:36:53.83,0:36:56.57,Default,fe,0,0,0,,من أجلك فقط، كيم هوان.
Dialogue: 0,0:36:57.97,0:37:00.51,Default,fe,0,0,0,,-من أجلك فقط.\N-ماذا؟
Dialogue: 0,0:37:01.11,0:37:04.28,Default,fe,0,0,0,,لم أكن أعلم أن إثارة اهتمامك بهذه السهولة.
Dialogue: 0,0:37:04.41,0:37:07.75,Default,fe,0,0,0,,هل من السهل عليك تكوين صداقات؟\Nهل لديك منهم أكثر مما تتمناه؟
Dialogue: 0,0:37:07.75,0:37:10.25,Default,fe,0,0,0,,على ما يبدو، كنت أحد أصدقائك في المساء،
Dialogue: 0,0:37:10.25,0:37:13.49,Default,fe,0,0,0,,أحد أصدقائك الكثيرين.
Dialogue: 0,0:37:46.35,0:37:49.59,Default,fe,0,0,0,,حسناً، هل أرسلت صديقك "لي سينبان" إلى المنزل؟
Dialogue: 0,0:37:49.59,0:37:51.32,Default,fe,0,0,0,,لقد تم استدعاؤك إلى القصر.
Dialogue: 0,0:37:52.19,0:37:53.63,Default,fe,0,0,0,,ماذا؟
Dialogue: 0,0:37:59.30,0:38:01.33,Default,fe,0,0,0,,لماذا لا يوجد أحد هنا اليوم؟
Dialogue: 0,0:38:01.93,0:38:06.61,Default,fe,0,0,0,,هل ذهب الجميع للبحث\N عن شيء مثير للاهتمام بدوني؟
Dialogue: 0,0:38:09.17,0:38:12.14,Default,fe,0,0,0,,أشعر وكأن الجميع تخلى عني.
Dialogue: 0,0:38:22.12,0:38:24.52,Default,fe,0,0,0,,لي سينمان، أنت على قيد الحياة!
Dialogue: 0,0:38:24.52,0:38:26.86,Default,fe,0,0,0,,أخيرًا التقيت!
Dialogue: 0,0:38:31.30,0:38:34.93,Default,fe,0,0,0,,لقد كنت مخطئاً، لقد خلطت بينك وبين صديق.
Dialogue: 0,0:38:35.47,0:38:36.97,Default,fe,0,0,0,,عذراً.
Dialogue: 0,0:38:39.90,0:38:42.17,Default,fe,0,0,0,,أنا لست صديقتك.
Dialogue: 0,0:38:42.54,0:38:45.21,Default,fe,0,0,0,,ولكن لديّ شيء مثير للاهتمام.
Dialogue: 0,0:38:53.25,0:38:56.89,Default,fe,0,0,0,,ما هذه الأشياء؟ تبدو غريبة.
Dialogue: 0,0:38:56.89,0:38:58.42,Default,fe,0,0,0,,هذا...
Dialogue: 0,0:39:01.56,0:39:03.16,Default,fe,0,0,0,,لم يتم رفع حظر التجول بعد.
Dialogue: 0,0:39:03.16,0:39:05.86,Default,fe,0,0,0,,-لماذا أنت في الشارع؟\N-Hide.
Dialogue: 0,0:39:08.00,0:39:09.50,Default,fe,0,0,0,,أنت...
Dialogue: 0,0:39:10.34,0:39:13.64,Default,fe,0,0,0,,ضربة واحدة ألم تكن كافية؟
Dialogue: 0,0:39:13.64,0:39:15.71,Default,fe,0,0,0,,هل تبيع الكتب البذيئة مرة أخرى؟
Dialogue: 0,0:39:15.71,0:39:17.11,Default,fe,0,0,0,,فاحشة؟
Dialogue: 0,0:39:19.58,0:39:22.91,Default,fe,0,0,0,,كان هو من أراد بيعها لي.
Dialogue: 0,0:39:23.65,0:39:25.28,Default,fe,0,0,0,,أنت متهم بمخالفة الأخلاق.
Dialogue: 0,0:39:25.28,0:39:26.85,Default,fe,0,0,0,,خذهم بعيداً.
Dialogue: 0,0:39:26.85,0:39:28.15,Default,fe,0,0,0,,نعم.
Dialogue: 0,0:39:28.15,0:39:30.92,Default,fe,0,0,0,,-انتظر، أنا...\N-دعني أذهب.
Dialogue: 0,0:39:30.92,0:39:32.66,Default,fe,0,0,0,,-انتظر.\N-توقف.
Dialogue: 0,0:39:32.66,0:39:34.53,Default,fe,0,0,0,,-يمكنك أن تكون أكثر لطفاً.\N-ها هو هيرودس.
Dialogue: 0,0:39:34.53,0:39:36.53,Default,fe,0,0,0,,هل يمكنك أن تكون ألطف، أنا خائف.
Dialogue: 0,0:39:36.53,0:39:40.10,Default,fe,0,0,0,,سأل تحديداً عن الليلة التي تلت الزفاف.
Dialogue: 0,0:39:40.40,0:39:42.67,Default,fe,0,0,0,,فأخبرته الملكة بكل شيء.
Dialogue: 0,0:39:42.67,0:39:46.00,Default,fe,0,0,0,,بدا غريباً بالنسبة لي أنها ظلت صامتة لفترة طويلة.
Dialogue: 0,0:39:46.00,0:39:48.64,Default,fe,0,0,0,,لو علم أنني حاولت قتلها،
Dialogue: 0,0:39:48.91,0:39:51.04,Default,fe,0,0,0,,استجواب واحد ما كان لينهي الأمر.
Dialogue: 0,0:39:51.18,0:39:54.65,Default,fe,0,0,0,,وفي يوم تعيينه قرأ القول المأثور:
Dialogue: 0,0:39:54.65,0:39:56.95,Default,fe,0,0,0,"إنقاذ الإمبراطورية من الفتنة،"
Dialogue: 0,0:39:57.12,0:39:59.28,Default,fe,0,0,0,,القوة تبث الرعب في نفوس الملك."
Dialogue: 0,0:39:59.28,0:40:00.82,Default,fe,0,0,0,,تركيا الواثقة من نفسها.
Dialogue: 0,0:40:00.82,0:40:03.42,Default,fe,0,0,0,,لقد هدد بأخذ عرشك.
Dialogue: 0,0:40:03.42,0:40:07.16,Default,fe,0,0,0,,إذا كان على استعداد للذهاب إلى هذا الحد، فيجب أن تعض لسانك.
Dialogue: 0,0:40:07.16,0:40:08.66,Default,fe,0,0,0,,وبعد ذلك
Dialogue: 0,0:40:08.66,0:40:10.93,Default,fe,0,0,0,,كان سيواصل الضغط على جلالته.
Dialogue: 0,0:40:11.13,0:40:13.40,Default,fe,0,0,0,,كان جلالته سيكشف عن نفسه على أية حال.
Dialogue: 0,0:40:13.40,0:40:14.97,Default,fe,0,0,0,,رجل ذكي.
Dialogue: 0,0:40:15.90,0:40:18.40,Default,fe,0,0,0,,لابد أنه وجد شيئاً ما.
Dialogue: 0,0:40:18.60,0:40:21.21,Default,fe,0,0,0,,سأكتشف مدى معرفته.
Dialogue: 0,0:40:21.97,0:40:26.18,Default,fe,0,0,0,,في الوقت الحالي لا يسعنا إلا أن نأمل أن تستيقظ الملكة.
Dialogue: 0,0:40:26.41,0:40:30.01,Default,fe,0,0,0,,هذا هو الشيء الأكثر أهمية للجميع.
Dialogue: 0,0:40:30.01,0:40:31.35,Default,fe,0,0,0,,ماذا عن التدريب؟
Dialogue: 0,0:40:31.35,0:40:33.32,Default,fe,0,0,0,,كيم بيونين يبحث عن رؤوسنا.
Dialogue: 0,0:40:33.32,0:40:35.89,Default,fe,0,0,0,,هناك حاجة إلى المزيد من الجهد.
Dialogue: 0,0:40:35.92,0:40:38.92,Default,fe,0,0,0,,لم يتبق سوى القليل من الوقت.
Dialogue: 0,0:40:39.92,0:40:41.36,Default,fe,0,0,0,,الله.
Dialogue: 0,0:40:41.59,0:40:43.43,Default,fe,0,0,0,,ارفع الفانوس.
Dialogue: 0,0:40:53.81,0:40:55.71,Default,fe,0,0,0,,كم تبعد صاحبة الجلالة؟
Dialogue: 0,0:40:55.77,0:40:56.81,Default,fe,0,0,0,,إنها في طريقها إلى هنا.
Dialogue: 0,0:40:56.81,0:40:59.31,Default,fe,0,0,0,,هل أنت متأكد أنها ليست على وشك الموت؟
Dialogue: 0,0:40:59.88,0:41:01.68,Default,fe,0,0,0,,نعم، لحسن الحظ، نجح كل شيء.
Dialogue: 0,0:41:01.68,0:41:03.18,Default,fe,0,0,0,,يا إلهي.
Dialogue: 0,0:41:03.75,0:41:05.72,Default,fe,0,0,0,,كيف يمكن أن يحدث هذا؟
Dialogue: 0,0:41:06.15,0:41:08.99,Default,fe,0,0,0,,مسمومة؟ كيف يمكن أن تكون مسمومة؟
Dialogue: 0,0:41:09.12,0:41:12.92,Default,fe,0,0,0,,لقد اتصلت بالفعل بأفضل الأطباء في جوسون.
Dialogue: 0,0:41:13.59,0:41:15.06,Default,fe,0,0,0,,الله.
Dialogue: 0,0:41:15.39,0:41:18.20,Default,fe,0,0,0,,مهما كان الأمر،\N عليك أن تبقى هادئاً.
Dialogue: 0,0:41:19.76,0:41:23.40,Default,fe,0,0,0,,أنت بحاجة إلى الهدوء والتفكير بعقلانية.
Dialogue: 0,0:41:24.67,0:41:26.07,Default,fe,0,0,0,,ما هذا.
Dialogue: 0,0:41:26.54,0:41:28.71,Default,fe,0,0,0,,يا إلهي.
Dialogue: 0,0:41:29.37,0:41:32.88,Default,fe,0,0,0,,يا إلهي.
Dialogue: 0,0:41:33.28,0:41:35.05,Default,fe,0,0,0,,كم هي قاسية.
Dialogue: 0,0:41:35.08,0:41:37.12,Default,fe,0,0,0,,زوج الملكة الأم مات مسموماً.
Dialogue: 0,0:41:37.12,0:41:38.88,Default,fe,0,0,0,,كيف يمكنك أن تلومها؟
Dialogue: 0,0:41:38.88,0:41:40.22,Default,fe,0,0,0,,الوضع صعب،
Dialogue: 0,0:41:40.22,0:41:43.56,Default,fe,0,0,0,,هواجين، ابتعد عن الملكة الأم.
Dialogue: 0,0:41:43.69,0:41:45.46,Default,fe,0,0,0,,حدث هذا في يوم زيارتي.
Dialogue: 0,0:41:45.46,0:41:47.33,Default,fe,0,0,0,,لقد منحتهم فرصة.
Dialogue: 0,0:41:47.33,0:41:49.13,Default,fe,0,0,0,,لا تلوم نفسك بشأن هذا.
Dialogue: 0,0:41:49.33,0:41:51.56,Default,fe,0,0,0,,كانوا سيتحركون على أية حال.
Dialogue: 0,0:41:52.10,0:41:53.53,Default,fe,0,0,0,,ولكن
Dialogue: 0,0:41:54.37,0:41:57.50,Default,fe,0,0,0,,لماذا أعادت الملكة إلى منزل والدها؟
Dialogue: 0,0:41:57.50,0:41:59.84,Default,fe,0,0,0,,لا بد أنها كانت وحيدة في القصر.
Dialogue: 0,0:41:59.87,0:42:02.24,Default,fe,0,0,0,,في المنام اتصلت بأمها.
Dialogue: 0,0:42:03.34,0:42:06.78,Default,fe,0,0,0,,لكن صاحبة الجلالة حلمت بهذا.
Dialogue: 0,0:42:07.71,0:42:09.11,Default,fe,0,0,0,,عن ماذا؟
Dialogue: 0,0:42:09.31,0:42:11.12,Default,fe,0,0,0,,هل هناك خطأ؟
Dialogue: 0,0:42:13.55,0:42:16.72,Default,fe,0,0,0,,-لا.\N-لا تقلق.
Dialogue: 0,0:42:16.75,0:42:19.99,Default,fe,0,0,0,,سأرسل أخي حالما يتقرر كل شيء.
Dialogue: 0,0:42:26.16,0:42:27.60,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:42:34.84,0:42:36.31,Default,Spilik,0,0,0,,أتوسل إليك.
Dialogue: 0,0:42:36.54,0:42:38.91,Default,Spilik,0,0,0,,هل ستخالف إرادة الملك؟
Dialogue: 0,0:42:44.78,0:42:46.48,Default,Spilik,0,0,0,,من فضلك لا تتأذى.
Dialogue: 0,0:42:48.89,0:42:50.29,Default,Spilik,0,0,0,,حسنًا.
Dialogue: 0,0:43:05.44,0:43:07.34,Default,Spilik,0,0,0,,الآن بعد أن أصبحت هنا،
Dialogue: 0,0:43:08.24,0:43:10.81,Default,Spilik,0,0,0,,يبدو الأمر وكأننا عدنا بالزمن إلى الوراء.
Dialogue: 0,0:43:13.28,0:43:14.71,Default,Spilik,0,0,0,,بنين.
Dialogue: 0,0:43:18.55,0:43:22.15,Default,Spilik,0,0,0,,أنت فقط من تبحث عني عندما أهرب.
Dialogue: 0,0:43:22.65,0:43:24.89,Default,Spilik,0,0,0,,لن أدعك تفقد نفسك.
Dialogue: 0,0:43:26.96,0:43:28.99,Default,Spilik,0,0,0,,ولن أنسى أبدًا.
Dialogue: 0,0:43:32.66,0:43:34.90,Default,Spilik,0,0,0,,ليتني أستطيع العودة إلى ذلك اليوم.
Dialogue: 0,0:43:41.24,0:43:43.07,Default,Spilik,0,0,0,,هذه امرأتي.
Dialogue: 0,0:43:49.18,0:43:51.45,Default,Spillie,0,0,0,,كان ينبغي أن تكون لي.
Dialogue: 0,0:43:54.05,0:43:56.32,Default,Spilik,0,0,0,,وأنا لك.
Dialogue: 0,0:44:44.34,0:44:46.17,Default,Spilik,0,0,0,,هل تعرف حتى من أنا؟
Dialogue: 0,0:44:46.17,0:44:49.44,Default,Spilik,0,0,0,,نفس كيم هوان الذي على وشك أن يصبح مسؤولاً
Dialogue: 0,0:44:49.61,0:44:50.88,Default,Spilyk,0,0,0,,قسم المباحث.
Dialogue: 0,0:44:50.88,0:44:52.71,Default,Spilik,0,0,0,,لم يكن ما فعله كافياً،
Dialogue: 0,0:44:52.71,0:44:54.25,Default,Spikyulka,0,0,0,,هل قررت المساومة على موعدك المستقبلي؟
Dialogue: 0,0:44:54.25,0:44:55.31,Default,Spilik,0,0,0,,الصفقة؟
Dialogue: 0,0:44:55.31,0:44:57.42,Default,Spilik,0,0,0,,أنا رجل صالح.
Dialogue: 0,0:44:58.28,0:45:00.79,Default,Spilik,0,0,0,,حقاً بالوجه والمواهب
Dialogue: 0,0:45:00.79,0:45:04.09,Default,Spikyulka,0,0,0,,ألا ترى أنني تلميذ سونغكيونكوان؟
Dialogue: 0,0:45:04.12,0:45:07.49,Default,Spillit,0,0,0,,لن أتعرض للظلم...
Dialogue: 0,0:45:07.49,0:45:09.06,Default,Spilik,0,0,0,,كن هادئاً هنا.
Dialogue: 0,0:45:09.69,0:45:11.50,Default,Spilik,0,0,0,,انظر، يا لك من رجل ثرثار.
Dialogue: 0,0:45:11.50,0:45:14.43,Default,Spilik,0,0,0,,كيف تجرؤ؟ إذا تركتني أذهب فوراً
Dialogue: 0,0:45:14.43,0:45:17.04,Default,Spiky,0,0,0,,سأعطيك خمسة نيانات من الفضة.
Dialogue: 0,0:45:17.10,0:45:18.57,Default,Spilik,0,0,0,,أو يمكنك ذلك
Dialogue: 0,0:45:20.91,0:45:22.57,Default,Spilik,0,0,0,,اتعطيهم لي؟
Dialogue: 0,0:45:23.91,0:45:27.15,Default,Spilik,0,0,0,,وفي المقابل، سنعلمك درساً لا يقدر بثمن.
Dialogue: 0,0:45:36.19,0:45:38.19,Default,Spilik,0,0,0,,بمجرد أن تسمع ما أقول،
Dialogue: 0,0:45:40.83,0:45:44.00,Default,Spilik,0,0,0,,لن تعود كما كنت بعد الآن.
Dialogue: 0,0:45:45.56,0:45:48.97,Default,Spilik,0,0,0,,سوف تصبح ناضجًا حقًا.
Dialogue: 0,0:46:04.35,0:46:07.89,Default,Spilik,0,0,0,, - هل أنت ذاهب إلى القصر؟ \N-نعم. هل عدت للتو إلى المنزل؟
Dialogue: 0,0:46:07.92,0:46:10.19,Default,Spilik,0,0,0,,سمعت ما حدث بينك وبين الملك بالأمس.
Dialogue: 0,0:46:10.19,0:46:12.52,Default,Spilik,0,0,0,,نعم، أفهم.
Dialogue: 0,0:46:12.52,0:46:14.69,Default,Spilik,0,0,0,,حتى لو لم يكن يبدو رائعًا،
Dialogue: 0,0:46:14.69,0:46:18.03,Default,Spilik,0,0,0,,إذا مارست عليه الكثير من الضغط، فسيصبح كذلك.
Dialogue: 0,0:46:18.03,0:46:20.36,Default,Spilik,0,0,0,,لماذا تصرفت دون طلبي؟
Dialogue: 0,0:46:20.36,0:46:21.80,Default,Spilik,0,0,0,,هذا لأن...
Dialogue: 0,0:46:22.40,0:46:24.07,Default,Split,0,0,0,,عينيه.
Dialogue: 0,0:46:24.37,0:46:28.14,Default,Spilik,0,0,0,,لديه عيون رجل يخفي تطلعاته.
Dialogue: 0,0:46:31.21,0:46:34.78,Default,Spillit,0,0,0,,لم أرغب في أن تقلق الملكة الأرملة،
Dialogue: 0,0:46:35.15,0:46:37.01,Default,Spilik,0,0,0,,فتصرف بتهور.
Dialogue: 0,0:46:38.72,0:46:40.38,Default,Spillit,0,0,0,,كن حذراً.
Dialogue: 0,0:46:41.99,0:46:43.39,Default,Spillit,0,0,0,,أبتاه.
Dialogue: 0,0:46:45.96,0:46:50.03,Default,Spilik,0,0,0,,هل عرفت كيف حال الملكة؟
Dialogue: 0,0:46:50.63,0:46:53.06,Default,Spilyk,0,0,0,,سمعت أن الأزمة انتهت.
Dialogue: 0,0:46:53.06,0:46:55.87,Default,Spillie,0,0,0,,لم تسترد رشدها بعد.
Dialogue: 0,0:46:56.07,0:46:58.90,Default,Spillie,0,0,0,,ولكن الأمور ستتحسن قريباً.
Dialogue: 0,0:47:00.34,0:47:02.14,Default,Spilik,0,0,0,,هل تريد أن تقول أي شيء آخر؟
Dialogue: 0,0:47:02.37,0:47:04.64,Default,Spillit,0,0,0,,سمعت الملكة الأرملة
Dialogue: 0,0:47:04.64,0:47:06.34,Default,Spilik,0,0,0,,ذكر إيداع الملكة.
Dialogue: 0,0:47:06.34,0:47:08.61,Default,Spilik,0,0,0,,قالت هذا في نوبة غضب.
Dialogue: 0,0:47:08.61,0:47:10.18,Default,Spilik,0,0,0,,في الواقع، هي لا تريد هذا.
Dialogue: 0,0:47:10.18,0:47:12.48,Default,Spilik,0,0,0,,ليس لديك ما يدعو للقلق.
Dialogue: 0,0:47:13.05,0:47:16.89,Default,Spilik,0,0,0,,أعلم جيداً مدى اهتمامك بالملكة.
Dialogue: 0,0:47:16.89,0:47:18.52,Default,Spilik,0,0,0,,ربما ليس مثلك،
Dialogue: 0,0:47:18.52,0:47:21.93,Default,Spilik,0,0,0,,لكنني أيضًا أعتني بها جيدًا، لذا لا تقلق.
Dialogue: 0,0:47:22.93,0:47:24.33,Default,Spilik,0,0,0,,نعم.
Dialogue: 0,0:47:24.60,0:47:26.23,Default,Spilik,0,0,0,,أراك في القصر.
Dialogue: 0,0:47:46.22,0:47:50.09,Default,Spilik,0,0,0,,أرسل والد الملكة الهدايا مرة أخرى.
Dialogue: 0,0:47:50.89,0:47:53.22,Default,Spilik,0,0,0,,كيف حال الملكة؟
Dialogue: 0,0:47:53.66,0:47:55.49,Default,Spillit,0,0,0,,لقد انتهت الأزمة،
Dialogue: 0,0:47:55.49,0:47:58.23,Default,Spilik,0,0,0,,لكنها بحاجة إلى الراحة الآن،\Nلذلك عادت إلى المنزل.
Dialogue: 0,0:47:58.23,0:48:00.60,Default,Spillie,0,0,0,,إنها مريضة باستمرار.
Dialogue: 0,0:48:00.90,0:48:02.97,Default,Spilik,0,0,0,,لم تتعافَ أبدًا من تلك الحادثة.
Dialogue: 0,0:48:02.97,0:48:04.67,Default,Spilik,0,0,0,,ماذا يجب أن أسميها؟
Dialogue: 0,0:48:04.97,0:48:06.90,Default,Spillie,0,0,0,,إنها مكسورة.
Dialogue: 0,0:48:07.21,0:48:09.81,Default,Spillie,0,0,0,,أحاول أن أجعلها تصبح أقوى،
Dialogue: 0,0:48:09.81,0:48:13.51,Default,Spillie,0,0,0,,لكنها فجأة أصبحت نباتية. \NShe's ضعيفة للغاية.
Dialogue: 0,0:48:13.85,0:48:16.78,Default,Spillit,0,0,0,,ماذا لو أنجبت المحظية "تشو" أميرًا أولاً؟
Dialogue: 0,0:48:16.78,0:48:18.82,Default,Spilik,0,0,0,,ثم ستتمرد الملكة الأم مرة أخرى.
Dialogue: 0,0:48:18.82,0:48:20.45,Default,Spilik,0,0,0,,لا تقلق.
Dialogue: 0,0:48:20.45,0:48:23.22,Default,Spilyk,0,0,0,,لقد أعددت خطة احتياطية.
Dialogue: 0,0:48:23.45,0:48:24.72,Default,Spillit,0,0,0,,خطة احتياطية؟
Dialogue: 0,0:48:24.72,0:48:27.36,Default,Spilik,0,0,0,,لقد تأكدت من أن الاثنين الآخرين،\Nالذين كنا نفكر فيهما لدور الملكة،
Dialogue: 0,0:48:27.36,0:48:29.79,Default,Spilyk,0,0,0,,لم يتزوجوا أحداً.
Dialogue: 0,0:48:29.79,0:48:33.03,Default,Spilik,0,0,0,,أنت أخ يمكن الاعتماد عليه.
Dialogue: 0,0:48:34.40,0:48:39.10,Default,Spilik,0,0,0,,سمعت أن بنين اتهمت الملك بالأمس.
Dialogue: 0,0:48:40.54,0:48:44.11,Default,Spilik,0,0,0,,أمس تصرف الجميع بشكل غريب تجاه الملك.
Dialogue: 0,0:48:44.41,0:48:48.11,Default,Spilik,0,0,0,,كما لو كان الملك يخفي شيئاً ما.
Dialogue: 0,0:48:50.65,0:48:52.92,Default,Spilik,0,0,0,,هذا الملك مختلف عن المتوفى.
Dialogue: 0,0:48:52.92,0:48:55.35,Default,Spilik,0,0,0,,هكذا ينبغي أن يكون الأمر. اخترت ذلك بنفسك.
Dialogue: 0,0:48:55.35,0:48:58.99,Default,Spilik,0,0,0,,لقد رفعت الملك إلى مكانه لسبب واحد فقط.
Dialogue: 0,0:48:58.99,0:49:02.56,Default,Spilik,0,0,0,,حتى لا تضطر إلى اتخاذ قرارات مؤلمة،
Dialogue: 0,0:49:02.56,0:49:04.90,Default,Spilik,0,0,0,,كما كان الحال في عهد الملك الراحل.
Dialogue: 0,0:49:04.93,0:49:06.36,Default,Spilik,0,0,0,,هذا صحيح.
Dialogue: 0,0:49:07.23,0:49:09.73,Default,Spilik,0,0,0,,كان الأمر مؤلماً للغاية.
Dialogue: 0,0:49:09.90,0:49:12.24,Default,Spilik,0,0,0,,دافعت عن البلاد على حساب دماء حفيدي
Dialogue: 0,0:49:12.24,0:49:14.07,Default,Spillie,0,0,0,,بين ذراعي.
Dialogue: 0,0:49:14.47,0:49:16.07,Default,Spilik,0,0,0,,وإذا تجرأ أحد على تدميرها،
Dialogue: 0,0:49:16.07,0:49:19.44,Default,Spilik,0,0,0,,لن يُغفر له.
Dialogue: 0,0:49:21.45,0:49:25.82,Default,Spilyk,0,0,0,,قسم المباحث.
Dialogue: 0,0:50:13.30,0:50:15.70,Default,Spilik,0,0,0,,-يجب عليك أولاً.\N-لا، أنت أولاً.
Dialogue: 0,0:50:15.70,0:50:18.44,Default,Spilik,0,0,0,,لا، أنت الأول.
Dialogue: 0,0:50:47.47,0:50:49.17,Default,Spilik,0,0,0,,أين أنا؟
Dialogue: 0,0:50:49.70,0:50:52.60,Default,Spilik,0,0,0,,في جوسون أم في كوريا؟
Dialogue: 0,0:50:58.94,0:51:00.58,Default,Spilik,0,0,0,,في جوسون.
Dialogue: 0,0:51:02.88,0:51:05.12,Default,Spilik,0,0,0,,لا أستطيع أن أقول إنني سعيد لأنني فقدتهم،
Dialogue: 0,0:51:05.12,0:51:08.42,Default,Spilik,0,0,0,,لكنني لا أستطيع أن أقول إنني حزين، لأنني سعيد لأنني أستطيع التحقق من ذلك.
Dialogue: 0,0:51:09.55,0:51:13.02,Default,Spilik,0,0,0,,لماذا يتألق كل شيء هنا كثيرًا؟
Dialogue: 0,0:51:32.64,0:51:34.55,Default,Spillit,0,0,0,,ذهب الإمبراطورية.
Dialogue: 0,0:51:34.68,0:51:36.45,Default,Spillie,0,0,0,,إنكي؟
Dialogue: 0,0:51:39.75,0:51:41.22,Default,Spilik,0,0,0,,جلالتك!
Dialogue: 0,0:51:43.82,0:51:46.79,Default,Spilik,0,0,0,,بدا لي أنني كنت في مكان آخر.
Dialogue: 0,0:51:47.76,0:51:50.53,Default,Spilik,0,0,0,,أخيرًا، استيقظت!
Dialogue: 0,0:51:51.00,0:51:52.63,Default,Spilik,0,0,0,,إنه مثل ديجا فو.
Dialogue: 0,0:51:52.63,0:51:54.87,Default,Spilik,0,0,0,,فقط دعنا نذهب دون ضجة.
Dialogue: 0,0:51:56.53,0:51:59.24,Default,Spilik,0,0,0,,لكنك كدت تموت.
Dialogue: 0,0:51:59.24,0:52:01.51,Default,Spilik,0,0,0,,حتى أنهم توقفوا عن التنفس تماماً.
Dialogue: 0,0:52:02.97,0:52:04.71,Default,Spillie,0,0,0,,لا تبكي.
Dialogue: 0,0:52:05.64,0:52:07.14,Default,Spillie,0,0,0,,هل توقفت عن التنفس؟
Dialogue: 0,0:52:07.38,0:52:09.68,Default,Spillit,0,0,0,,وفقاً للطبيب الملكي، كنتم بلا خضار.
Dialogue: 0,0:52:09.68,0:52:11.98,Default,Spillit,0,0,0,,كما لو أنك مت.
Dialogue: 0,0:52:12.92,0:52:15.09,Default,Spilik,0,0,0,,وهنا أيضًا.
Dialogue: 0,0:52:15.49,0:52:17.42,Default,Spilik,0,0,0,,ولكن أين أنا؟
Dialogue: 0,0:52:18.52,0:52:20.69,Default,Spilik,0,0,0,,أنت في المنزل.
Dialogue: 0,0:52:21.53,0:52:22.76,Default,Spilik,0,0,0,,لذا،
Dialogue: 0,0:52:22.76,0:52:24.66,Default,Spilik,0,0,0,,لا أستطيع تجنب اللقاء
Dialogue: 0,0:52:24.66,0:52:27.06,Default,Spilik,0,0,0,,مع شخص لا ينبغي أن تقابله.
Dialogue: 0,0:52:27.06,0:52:29.93,Default,Spilik,0,0,0,,-ماذا؟ \N-So، لا توجد صعوبات،
Dialogue: 0,0:52:29.93,0:52:32.34,Default,Spikyulka,0,0,0,,ولكن هناك شخص لا أشعر بالراحة معه.
Dialogue: 0,0:52:32.84,0:52:35.51,Default,Spilik,0,0,0,,الشخص الذي، في جوهره، هو عدوي الحقيقي -
Dialogue: 0,0:52:36.61,0:52:38.51,Default,Spilik,0,0,0,,والد المرأة.
Dialogue: 0,0:52:38.71,0:52:40.18,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:52:40.71,0:52:43.58,Default,Spilik,0,0,0,,- يا لها من سعادة أيتها الملكة. \N-الرب.
Dialogue: 0,0:52:43.58,0:52:47.69,Default,Spilik,0,0,0,,جلالتك، هل أنت بخير؟ هل يمكنك التنفس؟
Dialogue: 0,0:52:47.69,0:52:50.29,Default,Spilik,0,0,0,,ماذا تطلب؟ هل يجب أن أتصل بالطبيب الملكي؟
Dialogue: 0,0:52:50.29,0:52:53.06,Default,Spilik,0,0,0,,يبدو أنك على وشك أن تفقد وعيك.
Dialogue: 0,0:52:53.19,0:52:55.69,Default,Spillie,0,0,0,,هنا اشرب.
Dialogue: 0,0:52:55.69,0:52:57.23,Default,Spilik,0,0,0,,حسنًا.
Dialogue: 0,0:52:58.06,0:53:00.53,Default,Spilik,0,0,0,,هذه أعشاب لاستعادة طاقة الين.
Dialogue: 0,0:53:00.53,0:53:02.10,Default,Spilik,0,0,0,,ممتاز.
Dialogue: 0,0:53:02.30,0:53:05.20,Default,Spilyk,0,0,0,,لماذا أنت متعرق جداً؟
Dialogue: 0,0:53:07.84,0:53:09.34,Default,Spilik,0,0,0,,يا إلهي.
Dialogue: 0,0:53:09.34,0:53:12.28,Default,Spilik,0,0,0,,كنت قلقة للغاية.
Dialogue: 0,0:53:12.28,0:53:15.08,Default,Spilik,0,0,0,,لم أنم الليلة الماضية.
Dialogue: 0,0:53:15.08,0:53:16.35,Default,Spillit,0,0,0,,أفقد شهيتي تماماً
Dialogue: 0,0:53:16.35,0:53:18.52,Default,Spilyk,0,0,0,,ولم أتناول شيئاً منذ يومين.
Dialogue: 0,0:53:18.52,0:53:22.12,Default,Spilik,0,0,0,,في كل مرة أستيقظ فيها، يدور رأسي.
Dialogue: 0,0:53:22.39,0:53:24.29,Default,Spilik,0,0,0,,-لا بد أنك مصدوم بشدة. \N-نعم.
Dialogue: 0,0:53:24.72,0:53:27.19,Default,Spillit,0,0,0,,أصل الأمراض الهموم والمتاعب،
Dialogue: 0,0:53:27.19,0:53:28.99,Default,Spilik,0,0,0,,أنت بحاجة إلى الراحة والهدوء.
Dialogue: 0,0:53:28.99,0:53:31.96,Default,Spilik,0,0,0,,نعم بالطبع سأفعل ذلك.
Dialogue: 0,0:53:31.96,0:53:34.33,Default,Spilik,0,0,0,,أتمنى أن تشعر بتحسن قريبًا. لقد حان الوقت بالنسبة لي للذهاب.
Dialogue: 0,0:53:34.33,0:53:36.23,Default,Spillit,0,0,0,,جلالتك.
Dialogue: 0,0:53:36.23,0:53:37.84,Default,Spilik,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:53:38.57,0:53:39.74,Default,Spilyk,0,0,0,,القديسين القديسين.
Dialogue: 0,0:53:39.74,0:53:42.71,Default,Spilik,0,0,0,,لا أستطيع فعل ذلك. لا بد لي من إظهار الاحترام.
Dialogue: 0,0:53:42.94,0:53:44.41,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:53:44.41,0:53:46.84,Default,Spilik,0,0,0,,واو. ماذا تفعل؟ أنت تحرجني.
Dialogue: 0,0:53:46.84,0:53:48.51,Default,Spilik,0,0,0,,لا، لا، لا أجرؤ.
Dialogue: 0,0:53:48.51,0:53:50.92,Default,Spilik,0,0,0,,أرجو قبول قوسي يا صاحب الجلالة.
Dialogue: 0,0:53:52.92,0:53:54.39,Default,Spillit,0,0,0,,لا!
Dialogue: 0,0:53:56.65,0:53:57.96,Default,Spilik,0,0,0,,انظر.
Dialogue: 0,0:53:57.96,0:53:59.52,Default,Spilik,0,0,0,,كيف ذلك؟
Dialogue: 0,0:54:00.19,0:54:03.03,Default,Spilik,0,0,0,,دعني أنحني لك مرة أخرى.
Dialogue: 0,0:54:03.06,0:54:04.60,Default,Spillit,0,0,0,,أبتاه.
Dialogue: 0,0:54:04.63,0:54:07.43,Default,Spilik,0,0,0,,كونك ملكة في جوسون أمر غير مريح على الإطلاق.
Dialogue: 0,0:54:07.43,0:54:09.33,Default,Spilik,0,0,0,,دعني بينما أنا هنا،
Dialogue: 0,0:54:09.33,0:54:13.24,Default,Spilik,0,0,0,,لتكون مجرد ابنتك سويون.
Dialogue: 0,0:54:16.21,0:54:19.84,Default,نهاية نطاق الرماية,0,0,0,,كلما ارتفع المركز، كانت الوحدة أقوى.
Dialogue: 0,0:54:20.71,0:54:22.21,Default,,0,0,0,,حسنًا، لقد فهمت.
Dialogue: 0,0:54:22.61,0:54:24.55,Default,,0,0,0,,بينما أنت هنا،
Dialogue: 0,0:54:24.55,0:54:26.62,Default,,0,0,0,,سأفعل هذا،
Dialogue: 0,0:54:26.62,0:54:29.82,Default,,0,0,0,,كما تريد.
Dialogue: 0,0:54:30.52,0:54:32.29,Default,,0,0,0,,حسناً، اجلس الآن.
Dialogue: 0,0:54:32.56,0:54:35.36,Default,,0,0,0,,حسنًا. شكرًا لك.
Dialogue: 0,0:54:36.29,0:54:38.13,Default,,0,0,0,,كن حذراً.
Dialogue: 0,0:54:44.87,0:54:48.74,Default,,0,0,0,,بغض النظر عن مدى تزيين الغرفة،\N فإنها لا تزال تبدو فارغة.
Dialogue: 0,0:54:49.11,0:54:53.51,Default,,0,0,0,,ولكن بمجرد عودتك، بدأت الغرفة تتألق.
Dialogue: 0,0:54:55.15,0:54:56.58,Default,,0,0,0,,نعم.
Dialogue: 0,0:54:56.68,0:55:00.99,Default,,0,0,0,,الغرفة مشرقة جدًا لدرجة أنها تعمي عينيك.
Dialogue: 0,0:55:01.89,0:55:03.69,Default,,0,0,0,,أعجبني ذلك.
Dialogue: 0,0:55:06.52,0:55:10.03,Default,,0,0,0,,لا تقلق، لن يشوّه أي شيء سمعتك.
Dialogue: 0,0:55:10.09,0:55:12.70,Default,,0,0,0,,لقد اهتمت بكل شيء.
Dialogue: 0,0:55:12.80,0:55:15.93,Default,,0,0,0,,لقد أعددت كل خير.
Dialogue: 0,0:55:54.84,0:55:56.47,Default,,0,0,0,,التالي، تفضل.
Dialogue: 0,0:55:57.17,0:55:59.64,Default,,0,0,0,,لم أرى طبيباً واحداً هناك،
Dialogue: 0,0:55:59.64,0:56:01.55,Default,,0,0,0,,وهناك حشد كامل هنا؟
Dialogue: 0,0:56:09.25,0:56:11.29,Default,,0,0,0,,هل من المفترض أن يأتي أي شخص آخر؟
Dialogue: 0,0:56:11.29,0:56:14.33,Default,,0,0,0,,-نوع من العطلة؟\N-هذا هو الإفطار.
Dialogue: 0,0:56:18.10,0:56:19.56,Default,,0,0,0,,لاستعادة القوة
Dialogue: 0,0:56:19.56,0:56:22.20,Default,,0,0,0,,أعد لك والدك حساء السلحفاة.
Dialogue: 0,0:56:22.20,0:56:23.60,Default,,0,0,0,,هنا.
Dialogue: 0,0:56:26.17,0:56:28.27,Default,,0,0,0,,السلاحف منذ الصباح؟
Dialogue: 0,0:56:30.84,0:56:32.61,Default,,0,0,0,,كن حذراً.
Dialogue: 0,0:56:35.08,0:56:37.78,Default,,0,0,0,,لماذا؟ ماذا هناك؟
Dialogue: 0,0:56:38.35,0:56:40.15,Default,,0,0,0,,
Dialogue: 0,0:56:47.93,0:56:51.16,Default,,0,0,0,,إنه لشرف كبير أن أخدمك يا صاحب الجلالة.
Dialogue: 0,0:56:56.60,0:56:59.80,Default,,0,0,0,,إنها أفضل خبيرة تجميل في جوسون.
Dialogue: 0,0:57:00.07,0:57:02.94,Default,,0,0,0,,أنا جميلة بطبيعتي. أنا لست بحاجة إلى مساعدتها.
Dialogue: 0,0:57:05.11,0:57:06.71,Default,,0,0,0,, تفضل.
Dialogue: 0,0:57:16.75,0:57:19.32,Default,,0,0,0,,دعوة للإطاحة والتسميم.
Dialogue: 0,0:57:19.92,0:57:23.06,Default,,0,0,0,,إنهم يفعلون كل شيء للتخلص من صاحبة الجلالة.
Dialogue: 0,0:57:23.06,0:57:24.66,Default,,0,0,0,,لا تقلق.
Dialogue: 0,0:57:25.23,0:57:28.23,Default,,0,0,0,,بغض النظر عن مدى محاولتهم إيذاء صاحبة الجلالة،
Dialogue: 0,0:57:28.80,0:57:31.00,Default,,0,0,0,,سأزيد قوتي.
Dialogue: 0,0:57:32.57,0:57:37.04,Default,,0,0,0,,مع أخ مثلك، ليس لديها ما يدعو للقلق.
Dialogue: 0,0:57:44.98,0:57:47.25,Default,,0,0,0,,هل أنت على دراية بهذه المادة؟
Dialogue: 0,0:57:47.25,0:57:49.45,Default,,0,0,0,,هذا حرير عادي.
Dialogue: 0,0:57:50.42,0:57:53.29,Default,,0,0,0,,هل هناك خطب معه؟
Dialogue: 0,0:57:53.32,0:57:56.96,Default,,0,0,0,,هل أعطيت أحداً ملابس مصنوعة من هذه المادة؟
Dialogue: 0,0:57:58.36,0:58:01.37,Default,,0,0,0,,بعد أن أصبحت صاحبة الجلالة ملكة،
Dialogue: 0,0:58:01.37,0:58:04.60,Default,,0,0,0,,تلقيت الهدايا فقط، ولم أعطها بنفسي.
Dialogue: 0,0:58:05.07,0:58:08.94,Default,,0,0,0,,الشخص الوحيد الذي أقدم له الهدايا هي الملكة الأرملة.
Dialogue: 0,0:58:09.34,0:58:10.84,Default,,0,0,0,,فهمت.
Dialogue: 0,0:58:12.21,0:58:14.11,Default,,0,0,0,,لكنك تعلم...
Dialogue: 0,0:58:14.78,0:58:17.98,Default,,0,0,0,,لقد تعرض المستودع الخاص بي للسرقة مرتين مؤخرًا.
Dialogue: 0,0:58:18.85,0:58:22.12,Default,,0,0,0,,قد يكون ذلك الحرير موجوداً.
Dialogue: 0,0:58:22.12,0:58:24.66,Default,,0,0,0,,هل تعرض منزلك للهجوم؟
Dialogue: 0,0:58:24.66,0:58:26.49,Default,,0,0,0,,لا، لا.
Dialogue: 0,0:58:27.09,0:58:29.89,Default,,0,0,0,,من الخطر الاحتفاظ بجميع مقتنياتك الثمينة في مكان واحد.
Dialogue: 0,0:58:29.89,0:58:32.56,Default,,0,0,0,,من الأفضل وضعها في أماكن مختلفة.
Dialogue: 0,0:58:32.56,0:58:34.63,Default,,0,0,0,,لدي عدة مستودعات.
Dialogue: 0,0:58:35.40,0:58:40.90,Default,,0,0,0,,لكن اللصوص اختاروا فقط أولئك الذين لديهم الأشياء الأكثر قيمة.
Dialogue: 0,0:58:44.44,0:58:47.61,Default,,0,0,0,,مجرد التفكير في الأمر، تخدر رقبتي على الفور.
Dialogue: 0,0:58:49.31,0:58:51.52,Default,,0,0,0,,كنوزي الحبيبة.
Dialogue: 0,0:58:52.35,0:58:54.85,Default,,0,0,0,,هل من الممكن اكتشاف المسروقات
Dialogue: 0,0:58:54.85,0:58:56.85,Default,,0,0,0,,هل كان هذا حريراً أم لا؟
Dialogue: 0,0:58:58.12,0:58:59.79,Default,,0,0,0,,لقد سُرق الكثير.
Dialogue: 0,0:58:59.79,0:59:03.26,Default,,0,0,0,,وكان الاحتفاظ بسجلات للممتلكات الثمينة أمرًا خطيرًا.
Dialogue: 0,0:59:04.19,0:59:06.36,Default,,0,0,0,,بالمناسبة...
Dialogue: 0,0:59:08.90,0:59:11.20,Default,,0,0,0,,لا تخبر أحداً عن المستودعات.
Dialogue: 0,0:59:11.20,0:59:14.10,Default,,0,0,0,,ليس من الجيد أن يعرف الناس هذا الأمر.
Dialogue: 0,0:59:14.57,0:59:15.97,Default,,0,0,0,,أنا أفهم.
Dialogue: 0,0:59:16.67,0:59:22.18,Default,,0,0,0,,لكنك لم تسمع أي شيء غريب من والدك؟
Dialogue: 0,0:59:23.38,0:59:25.28,Default,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:59:27.15,0:59:31.69,Default,,0,0,0,,هذا الموقف برمته مع صاحبة الجلالة: أنقذ الملك مع خليته
Dialogue: 0,0:59:31.69,0:59:35.59,Default,,0,0,0,,وعلاقاتي المدمرة مع الملكة الأرملة - يقلقني.
Dialogue: 0,0:59:36.26,0:59:39.83,Default,,0,0,0,,تراودني كوابيس يتم فيها الإطاحة بها.
Dialogue: 0,0:59:39.96,0:59:43.30,Default,,0,0,0,,هل تمت الإطاحة به؟ لماذا تفكر في هذا؟
Dialogue: 0,0:59:44.50,0:59:47.27,Default,,0,0,0,,هناك شائعات بأن أحد المتنافسين على الملكة
Dialogue: 0,0:59:47.30,0:59:50.14,Default,,0,0,0,,أرسلت رسالة سرية.
Dialogue: 0,0:59:50.34,0:59:54.01,Default,,0,0,0,,هل من الممكن أنهم يريدون اختيار ملكة جديدة؟
Dialogue: 0,0:59:54.88,0:59:58.95,Default,,0,0,0,,أنا قلقة للغاية لأنني أفرطت في تناول الطعام هذه الأيام.
Dialogue: 0,1:00:00.48,1:00:03.72,Default,,0,0,0,,لن يتخلوا عن صاحبة الجلالة.
Dialogue: 0,1:00:04.32,1:00:06.49,Default,,0,0,0,,حقاً؟
Dialogue: 0,1:00:06.99,1:00:12.66,Default,,0,0,0,,يجب أن أحاول إرسال\N المزيد من الهدايا إلى الملكة الأرملة.
Dialogue: 0,1:00:14.23,1:00:16.03,Default,,0,0,0,,كيف تشعر؟
Dialogue: 0,1:00:16.03,1:00:17.50,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:00:17.80,1:00:20.57,Default,,0,0,0,,هذا لا شيء. سأكون هناك قريبا...
Dialogue: 0,1:00:21.37,1:00:23.54,Default,,0,0,0,,لا، ربما ليس بهذه السرعة.
Dialogue: 0,1:00:24.91,1:00:26.91,Default,,0,0,0,,كيف يمكن أن يحدث هذا؟
Dialogue: 0,1:00:28.18,1:00:32.05,Default,,0,0,0,,لقد نسيت تماماً أنني لم أعد صغيراً، وكنت مهملاً.
Dialogue: 0,1:00:36.52,1:00:39.92,Default,,0,0,0,,ليس لدي وقت للمرح.
Dialogue: 0,1:00:52.37,1:00:53.60,Default,,0,0,0,,كيف تشعر؟
Dialogue: 0,1:00:53.60,1:00:55.64,Default,,0,0,0,,أنا أبدو كالدمية.
Dialogue: 0,1:00:55.64,1:00:57.14,Default,,0,0,0,,رائع!
Dialogue: 0,1:00:57.74,1:01:01.01,Default,,0,0,0,,لقد أعجبك ذلك، أليس كذلك؟
Dialogue: 0,1:01:27.80,1:01:30.67,Default,,0,0,0,,هذا الكتاب مليء بالعفن بالفعل.
Dialogue: 0,1:01:31.61,1:01:33.91,Default,,0,0,0,,رائحة كريهة.
Dialogue: 0,1:01:34.31,1:01:35.98,Default,,0,0,0,,لو كنت رجلاً،
Dialogue: 0,1:01:35.98,1:01:38.45,Default,,0,0,0,,سيدخل القصر بعد اجتياز امتحان الدولة.
Dialogue: 0,1:01:38.45,1:01:40.85,Default,,0,0,0,,لقد استمتعت حقاً بالدراسة.
Dialogue: 0,1:01:42.42,1:01:44.32,Default,,0,0,0,,من أحب أن يدرس هذه؟
Dialogue: 0,1:01:44.32,1:01:46.79,Default,,0,0,0,,لقد حاولت فقط من أجل والدي.
Dialogue: 0,1:01:47.69,1:01:50.09,Default,,0,0,0,,ماتت أمي وأعطتني الحياة.
Dialogue: 0,1:01:50.39,1:01:53.33,Default,,0,0,0,,وقررت أنه يجب عليّ سداد ثمن هذا.
Dialogue: 0,1:01:53.66,1:01:55.73,Default,,0,0,0,,من الواضح أن هذا هو سبب تواجدك حتى في الليل
Dialogue: 0,1:01:55.73,1:01:59.00,Default,,0,0,0,,لقد درسنا بجد في عيد ميلادنا.
Dialogue: 0,1:02:09.88,1:02:11.38,Default,,0,0,0,,سويون.
Dialogue: 0,1:02:16.55,1:02:18.36,Default,,0,0,0,,عيد ميلاد سعيد.
Dialogue: 0,1:02:23.86,1:02:27.93,Default,,0,0,0,,لأننا في عيد ميلادي تذكرنا أمي،
Dialogue: 0,1:02:29.83,1:02:31.94,Default,,0,0,0,,لم أبتسم قط.
Dialogue: 0,1:02:34.27,1:02:36.27,Default,,0,0,0,,ماذا كان ذلك الآن؟
Dialogue: 0,1:02:36.54,1:02:37.97,Default,,0,0,0,,جلالتك.
Dialogue: 0,1:02:38.48,1:02:42.15,Default,,0,0,0,,ذكرياتك تعود!
Dialogue: 0,1:02:43.81,1:02:47.15,Default,,0,0,0,,ماذا؟ ما هي تلك الذكريات التي تبدو أنها لي، لكنها ليست في الحقيقة؟
Dialogue: 0,1:02:57.96,1:02:59.73,Default,,0,0,0,,كيم تشانهيوك
Dialogue: 0,1:02:59.93,1:03:03.10,Default,,0,0,0,,ابتعد عن الطريق! يبتعد!
Dialogue: 0,1:03:03.30,1:03:04.33,Default,,0,0,0,,
Dialogue: 0,1:03:04.33,1:03:07.50,Default,,0,0,0,,كيم تشانهيوك، وزير الحرب الحالي.
Dialogue: 0,1:03:07.77,1:03:10.14,Default,,0,0,0,,تم جمعها مع مجموعة من العسكريين
Dialogue: 0,1:03:10.34,1:03:12.24,Default,,0,0,0,,ضريبة الحرب مرتفعة بشكل مفرط.
Dialogue: 0,1:03:14.34,1:03:17.28,Default,,0,0,0,,كيم سيوك كين، المستشار الأيسر الحالي.
Dialogue: 0,1:03:17.31,1:03:18.68,Default,,0,0,0,,المسؤول عن الشؤون المالية،
Dialogue: 0,1:03:18.68,1:03:20.25,Default,,0,0,0,,عبر تبادل الحبوب
Dialogue: 0,1:03:20.25,1:03:22.19,Default,,0,0,0,,يستولي على الهدايا الملكية.
Dialogue: 0,1:03:23.02,1:03:25.49,Default,,0,0,0,,كيم بيونغ هاك، مستشار الدولة الحالي.
Dialogue: 0,1:03:25.69,1:03:27.29,Default,,0,0,0,,مجرم الضرائب:
Dialogue: 0,1:03:27.29,1:03:29.66,Default,,0,0,0,,تآمر مع الحكام المحليين
Dialogue: 0,1:03:29.76,1:03:31.66,Default,,0,0,0,,وفرض الضرائب على الأراضي الفارغة.
Dialogue: 0,1:03:35.40,1:03:37.00,Default,,0,0,0,,كيم مونجون.
Dialogue: 0,1:03:37.60,1:03:39.37,Default,,0,0,0,,والد الملكة.
Dialogue: 0,1:03:39.57,1:03:41.10,Default,,0,0,0,,هذا ما أتحدث عنه.
Dialogue: 0,1:03:46.24,1:03:48.11,Default,,0,0,0,,والد الملكة,
Dialogue: 0,1:03:48.11,1:03:49.68,Default,,0,0,0,,رئيس الحرس الملكي.
Dialogue: 0,1:03:49.68,1:03:51.38,Default,,0,0,0,,الصانع الشهير,
Dialogue: 0,1:03:51.38,1:03:54.48,Default,,0,0,0,,التعامل مع كل شيء من قروض الأرز إلى نظام ضرائب الحرب.
Dialogue: 0,1:03:58.89,1:04:00.39,Default,,0,0,0,,كيم جواجيون.
Dialogue: 0,1:04:01.49,1:04:03.19,Default,,0,0,0,,قائد القوات الحالي.
Dialogue: 0,1:04:17.74,1:04:19.04,Default,,0,0,0,,في ذروة قوته،
Dialogue: 0,1:04:19.04,1:04:22.35,Default,,0,0,0,,هو الذي أسس هذا النظام الفاسد برمته.
Dialogue: 0,1:04:25.85,1:04:27.28,افتراضي,,0,0,0,,سرّي
Dialogue: 0,1:04:30.52,1:04:32.99,Default,,0,0,0,,
Dialogue: 0,1:04:47.17,1:04:49.84,Default,,0,0,0,,كل شخص في القصر لديه سر.
Dialogue: 0,1:04:52.11,1:04:54.31,Default,,0,0,0,,سر تخفيه الأكاذيب.
Dialogue: 0,1:04:55.38,1:04:59.05,Default,,0,0,0,,سر لا يمكن رؤيته أو سماعه.
Dialogue: 0,1:04:59.95,1:05:01.99,Default,,0,0,0,,سر ينتظر اللحظة المناسبة.
Dialogue: 0,1:05:08.12,1:05:10.76,Default,,0,0,0,,للحفاظ على سر في أعماق القلب،
Dialogue: 0,1:05:10.76,1:05:12.93,Default,,0,0,0,,
Dialogue: 0,1:05:12.93,1:05:15.03,Default,,0,0,0,,التعليمات الأولية للأطفال
Dialogue: 0,1:05:16.50,1:05:19.37,Default,,0,0,0,,جميعنا نرتدي أقنعة.
Dialogue: 0,1:05:21.81,1:05:24.47,Default,,0,0,0,,تشو هواجين
Dialogue: 0,1:06:09.22,1:06:11.35,Default,,0,0,0,,لكنه سر
Dialogue: 0,1:06:13.99,1:06:16.06,Default,,0,0,0,,سيفتح بالتأكيد.
Dialogue: 0,1:06:20.06,1:06:23.30,Default,,0,0,0,,
Dialogue: 0,1:06:23.30,1:06:24.83,Default,,0,0,0,,
Dialogue: 0,1:06:40.18,1:06:43.62,Default,,0,0,0,,{\i1}يا صاحب الجلالة، لقد عادت ذكرياتك!{\i}
Dialogue: 0,1:06:46.99,1:06:49.39,Default,,0,0,0,,{\i1}كل شيء مشوش. اذهبي يا امرأة، اذهبي بعيدًا! {\i}
Dialogue: 0,1:06:49.39,1:06:52.43,Default,,0,0,0,,{\i1}لماذا تستمر في أن تصبح أكثر غرابة؟{\i}
Dialogue: 0,1:06:52.43,1:06:55.03,Default,,0,0,0,,{\i1}هناك شيء لم أخبر أحداً عنه.{\i}
Dialogue: 0,1:06:55.03,1:06:56.93,Default,,0,0,0,,{\i1}-مساعدة.\N-تلك الرائحة الرطبة.{\i}
Dialogue: 0,1:06:56.93,1:06:59.87,Default,,0,0,0,,{\i1}تمت سرقة العديد من المستودعات في العاصمة مؤخرًا.{\i}
Dialogue: 0,1:06:59.87,1:07:01.57,Default,,0,0,0,,{\i1}-وماذا في ذلك؟\N-أنا مهتم،{\i}
Dialogue: 0,1:07:01.57,1:07:03.84,Default,,0,0,0,,{\i1}ربما هذه هي الطريقة التي تجني بها المال.{\i}
Dialogue: 0,1:07:03.94,1:07:06.71,Default,,0,0,0,,{\i1}اليوم سنوضح كل شيء.{\i}
Dialogue: 0,1:07:06.71,1:07:08.58,Default,,0,0,0,,{\i1}هذا ما كنت أنتظره.{\i}
Dialogue: 0,0:10:58.78,0:11:00.78,Default,,0,0,0,,

Comment: 0,0:06:11.92,0:06:14.02,Default,lily,0,0,0,,حالة يكون فيها نبض، ولكن الشخص بالكاد يتنفس.
