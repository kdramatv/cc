Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,bekerja,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Pembawa Acara, Februari, Penyanyi
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:10.02,0:01:12.53,Default,FEBRUARY,0,0,0,,Mengapa kamu membiarkan dirimu diserang?
Dialogue: 0,0:01:14.69,0:01:15.76,Default,FEBRUARY,0,0,0,,Itu dia!
Dialogue: 0,0:01:23.97,0:01:25.84,Default,FEBRUARY,0,0,0,,Mari kita lupakan menjaga jarak hari ini.
Dialogue: 0,0:01:32.05,0:01:33.08,Default,FEBRUARY,0,0,0,,Yang Mulia.
Dialogue: 0,0:01:34.08,0:01:35.32,Default,FEBRUARY,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,0:01:50.73,0:01:51.90,Default,FEBRUARY,0,0,0,,Siapa disana?
Dialogue: 0,0:02:08.05,0:02:11.62,Default,FEBRUARY,0,0,0,,Berangkat, dalam perjalanan keluar.
Dialog: 0,0:02:13.09,0:02:15.86,Default,FEBRUARY,0,0,0,,9 episode
Dialogue: 0,0:02:41.85,0:02:45.19,Default,FEBRUARY,0,0,0,,Saya membiarkan mereka tidur terpisah\Nuntuk beristirahat dengan tenang,
Dialog: 0,0:02:47.89,0:02:49.52,Default,FEBRUARY,0,0,0,,tapi sepertinya saya sedikit salah.
Dialogue: 0,0:02:49.96,0:02:52.59,Default,FEBRUARY,0,0,0,,Saya mendengar sesuatu mogok.
Dialogue: 0,0:02:52.59,0:02:54.39,Default,FEBRUARY,0,0,0,,Saya juga terbangun karena kebisingan.
Dialogue: 0,0:02:54.83,0:02:56.60,Default,FEBRUARY,0,0,0,,Dan pintunya rusak.
Dialogue: 0,0:02:58.26,0:03:00.20,Default,FEBRUARY,0,0,0,,Masalahnya jelas najis, semua perlu diperiksa.
Dialogue: 0,0:03:00.47,0:03:03.24,Default,FEBRUARY,0,0,0,,Tapi kemudian kita akan mengganggu pasangan kerajaan.
Dialogue: 0,0:03:11.11,0:03:13.62,Default,FEBRUARY,0,0,0,,Aku takkan kaget jika karena mereka\Nrumah akan berguncang.
Dialogue: 0,0:03:14.28,0:03:15.82,Default,FEBRUARY,0,0,0,,Pengantin baru, apa yang bisa diambil dari mereka.
Dialogue: 0,0:03:16.58,0:03:20.02,Default,FEBRUARY,0,0,0,,Kita harus melindungi privasi mereka.
Dialogue: 0,0:03:23.12,0:03:25.19,Default,FEBRUARY,0,0,0,,Jangan terlalu dekat dengan rumah.
Dialog: 0,0:03:25.69,0:03:26.69,Default,FEBRUARY,0,0,0,,Ya.
Dialogue: 0,0:03:30.46,0:03:32.20,Default,FEBRUARY,0,0,0,,Saya akan pergi ke lampiran.
Dialogue: 0,0:03:32.60,0:03:33.93,Default,FEBRUARY,0,0,0,,Maukah kamu melindungi kedamaian mereka?
Dialogue: 0,0:03:35.37,0:03:37.37,Default,FEBRUARY,0,0,0,,-Ya.\N-Jaga mereka.
Dialogue: 0,0:04:19.31,0:04:21.75,Default,FEBRUARY,0,0,0,,Kendalikan dirimu, nona!
Dialogue: 0,0:04:27.45,0:04:30.02,Default,FEBRUARY,0,0,0,,Dan kamu harus menciumnya?!
Dialogue: 0,0:04:33.09,0:04:35.16,Default,FEBRUARY,0,0,0,,Apakah kamu ingin berkelahi?
Dialogue: 0,0:04:35.80,0:04:39.17,Default,FEBRUARY,0,0,0,,Kamu berdebat dengan siapa?
Dialogue: 0,0:04:40.00,0:04:41.17,Default,FEBRUARY,0,0,0,,Jangan ikut campur.
Dialogue: 0,0:04:41.17,0:04:44.20,Default,FEBRUARY,0,0,0,,Ini hanya antara aku dan Kim So-yeon.
Dialogue: 0,0:04:46.11,0:04:47.74,Default,FEBRUARY,0,0,0,,Sementara aku di sini,
Dialogue: 0,0:04:47.74,0:04:49.61,Default,FEBRUARY,0,0,0,,Aku akan melakukan apa yang kuinginkan dengan tubuh ini.
Dialog: 0,0:04:49.61,0:04:52.08,Default,FEBRUARY,0,0,0,,Jiwa siapa yang ada di dalam tubuh adalah pemiliknya!
Dialogue: 0,0:04:55.52,0:04:57.65,Default,FEBRUARY,0,0,0,,Rupanya kamu masih mabuk.
Dialogue: 0,0:04:58.45,0:05:01.02,Default,FEBRUARY,0,0,0,,Kamu tidak melihat perbedaan antara mimpi dan kenyataan.
Dialogue: 0,0:05:02.39,0:05:04.66,Default,FEBRUARY,0,0,0,,-Aku punya batu di jiwaku.\N-Apa yang kamu bicarakan?
Dialogue: 0,0:05:05.12,0:05:07.74,Default,FEBRUARY,0,0,0,,Ya, aku bisa berjalan pulang dengan kedua kakiku sendiri dalam kondisi apa pun.
Dialog: 0,0:05:26.85,0:05:28.28,Default,FEBRUARY,0,0,0,,Tidak. Ini bukan mimpi.
Dialogue: 0,0:05:29.62,0:05:31.99,Default,FEBRUARY,0,0,0,,Mengapa kamu muncul dalam mimpiku.
Dialogue: 0,0:05:34.25,0:05:36.66,Default,FEBRUARY,0,0,0,,Maaf muncul
Dialogue: 0,0:05:39.03,0:05:40.33,Default,FEBRUARY,0,0,0,,dalam mimpimu.
Dialogue: 0,0:06:03.65,0:06:05.42,Default,FEBRUARY,0,0,0,,Lupakan mimpi buruk ini.
Dialogue: 0,0:06:36.45,0:06:39.52,Default,FEBRUARY,0,0,0,,9 episode: Terang dan Gelap
Dialogue: 0,0:08:38.17,0:08:40.34,Default,FEBRUARY,0,0,0,,Hong Young, geli.
Dialogue: 0,0:09:11.87,0:09:15.04,Default,FEBRUARY,0,0,0,,Dia tak ada di sini. Jika dia tidak ada di rumah, lalu di mana?
Dialogue: 0,0:09:18.61,0:09:20.21,Default,FEBRUARY,0,0,0,,Ada yang salah?
Dialogue: 0,0:09:23.02,0:09:24.85,Default,FEBRUARY,0,0,0,,Dia tidak khawatir karena masa lalu.
Dialogue: 0,0:10:19.84,0:10:22.44,Default,FEBRUARY,0,0,0,,-Hei, hei.\N-Apa?
Dialogue: 0,0:10:22.44,0:10:23.98,Default,FEBRUARY,0,0,0,,Mereka menyuruhku untuk tidak mendekati rumah.
Dialogue: 0,0:10:23.98,0:10:25.81,Default,FEBRUARY,0,0,0,,-Mengapa?\N-Saya tidak tahu.
Dialog: 0,0:10:26.48,0:10:28.31,Default,FEBRUARY,0,0,0,,-Duduk.\N-Oke.
Dialogue: 0,0:10:30.05,0:10:32.95,Default,FEBRUARY,0,0,0,,Sejujurnya, saya mengkhawatirkan Yang Mulia.
Dialogue: 0,0:10:32.95,0:10:34.09,Default,FEBRUARY,0,0,0,,Pernahkah kamu mendengar sesuatu tentang dia?
Dialogue: 0,0:10:34.69,0:10:36.19,Default,FEBRUARY,0,0,0,,Tentang ratu?
Dialogue: 0,0:10:36.19,0:10:37.22,Default,FEBRUARY,0,0,0,,Dia berlari mengelilingi istana
Dialog: 0,0:10:37.22,0:10:38.29,Default,FEBRUARY,0,0,0,,setiap pagi.
Dialogue: 0,0:10:38.29,0:10:40.53,Default,FEBRUARY,0,0,0,,Jangan bicara omong kosong.
Dialogue: 0,0:10:40.53,0:10:43.90,Default,FEBRUARY,0,0,0,,Aku kenal dia sejak dia masih bayi.\NSDia tidak pernah berlari saat dia lahir.
Dialogue: 0,0:10:43.90,0:10:46.73,Default,FEBRUARY,0,0,0,,-Kau berbohong.\N-Itu benar.
Dialogue: 0,0:10:48.37,0:10:51.04,Default,FEBRUARY,0,0,0,,-Dan ini aneh.\N-Tapi itulah yang mereka katakan.
Dialogue: 0,0:10:51.30,0:10:52.77,Default,FEBRUARY,0,0,0,,-Tidak.\N-Saya tidak percaya!
Dialogue: 0,0:10:52.87,0:10:53.87,Default,FEBRUARY,0,0,0,,Saya berkata sejujurnya.
Dialogue: 0,0:10:56.11,0:10:58.98,Default,FEBRUARY,0,0,0,,-Ayam!\N-Ambil mereka.
Dialogue: 0,0:11:01.45,0:11:02.82,Default,FEBRUARY,0,0,0,,Stop, yang berbulu!
Dialogue: 0,0:11:18.83,0:11:20.83,Default,FEBRUARY,0,0,0,,Dia mengenakan pakaian Departemen Detektif.
Dialogue: 0,0:11:21.83,0:11:22.97,Default,FEBRUARY,0,0,0,,Jadi...
Dialogue: 0,0:11:36.12,0:11:38.72,Default,FEBRUARY,0,0,0,,Kamu akan mabuk sampai mati. Berhenti.
Dialog: 0,0:11:41.02,0:11:42.79,Default,FEBRUARY,0,0,0,,Siksaan haus.
Dialogue: 0,0:11:42.82,0:11:45.62,Default,FEBRUARY,0,0,0,,Semakin aku berpikir betapa dosanya ini,\Nsemakin aku haus.
Dialogue: 0,0:11:48.33,0:11:50.76,Default,FEBRUARY,0,0,0,,Seperti aku sekarat kehausan.
Dialogue: 0,0:11:51.66,0:11:54.37,Default,FEBRUARY,0,0,0,,Jika kamu haus, minumlah air, bukan anggur.
Dialogue: 0,0:11:58.90,0:12:01.14,Default,FEBRUARY,0,0,0,,Hai, bawakan kami air.
Dialog: 0,0:12:01.71,0:12:02.74,Default,FEBRUARY,0,0,0,,Ya.
Dialogue: 0,0:12:05.64,0:12:10.02,Default,FEBRUARY,0,0,0,,Semakin banyak wine yang kamu minum, semakin banyak pula yang ingin kamu minum.
Dialogue: 0,0:12:27.57,0:12:30.44,Default,FEBRUARY,0,0,0,,Tidur nyenyak, seperti ada yang membuatku pingsan.
Dialogue: 0,0:12:33.67,0:12:35.01,Default,FEBRUARY,0,0,0,,Saya memahamimu.
Dialogue: 0,0:12:35.61,0:12:37.58,Default,FEBRUARY,0,0,0,,Tubuh dipenuhi dengan rasa ringan.
Dialogue: 0,0:12:38.04,0:12:40.58,Default,FEBRUARY,0,0,0,,You. Anda.
Dialogue: 0,0:12:44.92,0:12:49.36,Default,FEBRUARY,0,0,0,,Rumah ini pasti dibangun di atas tanah yang baik. Saya mendapatkan tidur malam yang nyenyak.
Dialogue: 0,0:12:50.42,0:12:52.86,Default,FEBRUARY,0,0,0,,Apakah normal kalau kamu bangun bersamaku?
Dialogue: 0,0:12:56.93,0:12:58.76,Default,FEBRUARY,0,0,0,,Apakah ini abnormal?
Dialogue: 0,0:12:59.33,0:13:01.47,Default,FEBRUARY,0,0,0,,Ini bukan istana - tanggal malam bersama tidak dipilih.
Dialogue: 0,0:13:01.47,0:13:03.87,Default,FEBRUARY,0,0,0,,Wajar jika di rumah ayah kita berbagi satu tempat tidur.
Dialog: 0,0:13:04.54,0:13:06.44,Default,FEBRUARY,0,0,0,,Logis.
Dialogue: 0,0:13:06.44,0:13:08.74,Default,FEBRUARY,0,0,0,,Di kubu musuh kamu harus\Nbersamaku - perlindungan terbaik.
Dialogue: 0,0:13:09.31,0:13:11.48,Default,FEBRUARY,0,0,0,,Gamemu hari ini kelas atas.
Dialogue: 0,0:13:13.01,0:13:15.82,Default,FEBRUARY,0,0,0,,Oke, anggap saja kita menghabiskan malam yang panas bersama.
Dialogue: 0,0:13:16.15,0:13:18.72,Default,FEBRUARY,0,0,0,,Panas sekali sehingga kami membaliknya...
Dialogue: 0,0:13:25.09,0:13:26.09,Default,FEBRUARY,0,0,0,,Apa?
Dialogue: 0,0:13:26.39,0:13:27.99,Default,FEBRUARY,0,0,0,,Sepertinya kamu ingat malam ini.
Dialogue: 0,0:13:28.23,0:13:29.86,Default,FEBRUARY,0,0,0,,Sayang sekali jika kamu melupakannya,
Dialogue: 0,0:13:29.86,0:13:31.46,Default,FEBRUARY,0,0,0,,seperti yang pertama.
Dialogue: 0,0:13:32.30,0:13:34.23,Default,FEBRUARY,0,0,0,,Apakah karena ingatannya sudah kembali?
Dialogue: 0,0:13:35.87,0:13:39.04,Default,FEBRUARY,0,0,0,,Aku tidur seperti bayi.
Dialogue: 0,0:13:52.15,0:13:54.55,Default,FEBRUARY,0,0,0,,Saya tidak punya waktu untuk bermain trik.
Dialogue: 0,0:13:55.12,0:13:57.89,Default,FEBRUARY,0,0,0,,Kamu harus menjadi kartu as ratu janda.
Dialogue: 0,0:13:58.36,0:14:00.59,Default,FEBRUARY,0,0,0,,Bahkan jika sesuatu terjadi pada keluarga Han,
Dialogue: 0,0:14:00.69,0:14:02.13,Default,FEBRUARY,0,0,0,,mereka tidak dapat menghubungiku.
Dialogue: 0,0:14:03.36,0:14:07.03,Default,FEBRUARY,0,0,0,,Pria bertopeng dan aku mencari hal yang sama.
Dialogue: 0,0:14:07.80,0:14:10.00,Default,FEBRUARY,0,0,0,,Berapa banyak yang sudah diketahui Kim Byungin?
Dialogue: 0,0:14:10.74,0:14:13.54,Default,FEBRUARY,0,0,0,,Buku akuntansi tidak boleh jatuh ke tangan mereka.
Dialogue: 0,0:14:16.78,0:14:19.81,Default,FEBRUARY,0,0,0,,Hari ini aku akan kembali ke istana dengan segala cara.
Dialogue: 0,0:14:20.75,0:14:24.25,Default,FEBRUARY,0,0,0,,Hari ini aku akan menemukan buku itu apa pun yang terjadi.
Dialogue: 0,0:14:34.03,0:14:36.16,Default,FEBRUARY,0,0,0,,Kamu masih bisa sakit.
Dialogue: 0,0:14:37.13,0:14:39.33,Default,FEBRUARY,0,0,0,,Kapan ratu kembali ke istana?
Dialogue: 0,0:14:39.87,0:14:43.54,Default,FEBRUARY,0,0,0,,Saya akan mengirimkan kabar agar dia dan Yang Mulia\Nuntuk kembali sesegera mungkin.
Dialogue: 0,0:14:43.87,0:14:47.01,Default,FEBRUARY,0,0,0,,Aku tidak pernah merasa kehidupan di istana membosankan.
Dialogue: 0,0:14:47.01,0:14:50.18,Default,FEBRUARY,0,0,0,,Tetapi ratu baru pergi beberapa hari,\Ndan di sini sudah sunyi.
Dialogue: 0,0:14:50.88,0:14:54.38,Default,FEBRUARY,0,0,0,,Masakan Yang Mulia begitu lezat?
Dialogue: 0,0:14:54.68,0:14:57.82,Default,FEBRUARY,0,0,0,,Ini bukan tentang masakannya.\NSDia manis bagiku.
Dialogue: 0,0:15:00.72,0:15:02.45,Default,FEBRUARY,0,0,0,,Lampiran berbahaya.
Dialogue: 0,0:15:02.92,0:15:05.19,Default,FEBRUARY,0,0,0,,Pagi ini aku lapar...
Dialogue: 0,0:15:05.59,0:15:06.63,Default,FEBRUARY,0,0,0,,Itulah
Dialogue: 0,0:15:08.23,0:15:10.66,Default,FEBRUARY,0,0,0,,Aku bangun pagi, merindukan ratu tersayang.
Dialogue: 0,0:15:10.80,0:15:12.36,Default,FEBRUARY,0,0,0,,Saya memahamimu.
Dialogue: 0,0:15:12.36,0:15:15.07,Default,FEBRUARY,0,0,0,,Menakutkan menyadari bahwa kamu telah dijinakkan.
Dialogue: 0,0:15:19.24,0:15:21.47,Default,FEBRUARY,0,0,0,,Tampaknya kaulah yang memanfaatkan orang lain,
Dialogue: 0,0:15:22.14,0:15:25.04,Default,FEBRUARY,0,0,0,,tapi suatu saat ternyata mereka telah menjinakkanmu.
Dialogue: 0,0:15:26.05,0:15:29.18,Default,FEBRUARY,0,0,0,,Jadi, kamu harus mencari lebih banyak orang yang berguna bagimu.
Dialog: 0,0:15:29.45,0:15:33.79,Default,FEBRUARY,0,0,0,,Saya akan memerintahkan koki kerajaan untuk mempelajari resep Yang Mulia.
Dialogue: 0,0:15:34.85,0:15:38.29,Default,FEBRUARY,0,0,0,,Kau membuat hidupku di istana seperti surga.
Dialogue: 0,0:15:38.69,0:15:40.89,Default,FEBRUARY,0,0,0,,Aku tidak punya alasan untuk meninggalkannya.
Dialogue: 0,0:15:41.39,0:15:43.83,Default,FEBRUARY,0,0,0,,Itulah kenapa aku berakhir di tempatku -
Dialogue: 0,0:15:43.83,0:15:46.70,Default,FEBRUARY,0,0,0,,untuk menjaga surga ini, Yang Mulia.
Dialogue: 0,0:15:50.50,0:15:51.64,Default,FEBRUARY,0,0,0,,Omong-omong.
Dialogue: 0,0:15:51.64,0:15:54.71,Default,FEBRUARY,0,0,0,,Suruh Benin datang menemuiku sesekali.
Dialogue: 0,0:15:56.84,0:15:58.01,Default,FEBRUARY,0,0,0,,Kamu mau
Dialogue: 0,0:15:59.41,0:16:00.98,Default,FEBRUARY,0,0,0,,bicara dengannya?
Dialogue: 0,0:16:01.21,0:16:04.18,Default,FEBRUARY,0,0,0,,Tetap saja, dia anak angkatmu.\NI sudah cukup mengabaikannya.
Dialogue: 0,0:16:04.95,0:16:07.49,Default,FEBRUARY,0,0,0,,Saatnya memberinya instruksi dari waktu ke waktu.
Dialogue: 0,0:16:08.29,0:16:10.66,Default,FEBRUARY,0,0,0,,Kau masih belum bertambah muda.
Dialog: 0,0:16:11.06,0:16:12.73,Default,FEBRUARY,0,0,0,,Lakukan hanya hal-hal penting.
Dialogue: 0,0:16:12.99,0:16:15.96,Default,FEBRUARY,0,0,0,,Segala sesuatu yang menyangkutmu penting bagiku.
Dialogue: 0,0:16:54.57,0:16:55.80,Default,FEBRUARY,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:17:01.01,0:17:02.81,Default,FEBRUARY,0,0,0,,Detektif Departemen
Dialogue: 0,0:17:02.81,0:17:05.28,Default,FEBRUARY,0,0,0,,akan memeriksa setiap pengawal raja.
Dialogue: 0,0:17:06.31,0:17:09.01,Default,FEBRUARY,0,0,0,,Kamu melindungi nyawa raja dan selalu berada di sisinya -
Dialogue: 0,0:17:09.55,0:17:12.79,Default,FEBRUARY,0,0,0,,kita perlu memastikan semuanya.
Dialogue: 0,0:17:15.22,0:17:16.86,Default,FEBRUARY,0,0,0,,Jangan biarkan mereka mengambil langkah!
Dialogue: 0,0:17:27.30,0:17:29.10,Default,FEBRUARY,0,0,0,,Setiap orang di sini telah lulus
Dialog: 0,0:17:30.34,0:17:31.87,Default,FEBRUARY,0,0,0,,cek penuh.
Dialogue: 0,0:17:36.61,0:17:38.58,Default,FEBRUARY,0,0,0,,Anda dapat membeli silsilah.
Dialogue: 0,0:17:39.04,0:17:40.25,Default,FEBRUARY,0,0,0,,Kamu tidak pernah tahu.
Dialogue: 0,0:17:41.25,0:17:42.48,Default,FEBRUARY,0,0,0,,Seseorang dari penjaga
Dialogue: 0,0:17:42.48,0:17:44.52,Default,FEBRUARY,0,0,0,,bisa mempersiapkan makar atas nama orang lain.
Dialogue: 0,0:17:45.82,0:17:48.19,Default,FEBRUARY,0,0,0,,Berikan bantuan - kami melakukan tugas kami.
Dialog: 0,0:17:52.12,0:17:54.96,Default,FEBRUARY,0,0,0,,Jika Anda tidak menemukan bukti tuduhan Anda,
Dialogue: 0,0:17:56.43,0:17:57.56,Default,FEBRUARY,0,0,0,,i
Dialogue: 0,0:17:59.03,0:18:01.00,Default,FEBRUARY,0,0,0,,Aku akan menggunakan kekuatanku.
Dialogue: 0,0:18:01.30,0:18:03.77,Default,FEBRUARY,0,0,0,,Ini jika Anda menyimpan kiriman Anda.
Dialogue: 0,0:18:04.54,0:18:07.97,Default,FEBRUARY,0,0,0,,Jika kamu tidak terlibat makar, keluarlah.
Dialog: 0,0:18:18.12,0:18:19.72,Default,FEBRUARY,0,0,0,,-Cari di mana saja.\N-Ya.
Dialogue: 0,0:18:32.53,0:18:33.83,Default,FEBRUARY,0,0,0,,Cari di setiap sudut.
Dialog: 0,0:18:34.70,0:18:36.87,Default,FEBRUARY,0,0,0,,Tarik semua dokumen.
Dialogue: 0,0:18:36.87,0:18:38.60,Default,FEBRUARY,0,0,0,,Dan membawanya ke Departemen Detektif.
Dialog: 0,0:18:38.80,0:18:39.94,Default,FEBRUARY,0,0,0,,-Ya!\N-Ya!
Dialogue: 0,0:18:55.29,0:18:57.32,Default,FEBRUARY,0,0,0,,Saya harap tidurmu nyenyak.
Dialogue: 0,0:18:58.56,0:19:01.06,Default,FEBRUARY,0,0,0,,Saya membawa seekor burung yang cantik.
Dialogue: 0,0:19:01.06,0:19:02.16,Default,FEBRUARY,0,0,0,,Bagaimana kamu menyukainya?
Dialogue: 0,0:19:03.00,0:19:04.93,Default,FEBRUARY,0,0,0,,Dia memiliki bulu yang indah.
Dialogue: 0,0:19:05.50,0:19:08.83,Default,FEBRUARY,0,0,0,,Burung berharga ini membuatku senang dengan kabar baik.
Dialogue: 0,0:19:12.47,0:19:15.34,Default,FEBRUARY,0,0,0,,Apakah ada kabar baik?
Dialogue: 0,0:19:15.34,0:19:17.81,Default,FEBRUARY,0,0,0,,Perseteruan antara ratu dan
Dialogue: 0,0:19:17.81,0:19:20.45,Default,FEBRUARY,0,0,0,,selir kerajaan Cho bahkan lebih kuat dari perkiraanku.
Dialogue: 0,0:19:22.01,0:19:23.78,Default,FEBRUARY,0,0,0,,Ada sesuatu yang belum kukatakan padamu.
Dialog: 0,0:19:24.85,0:19:26.75,Default,FEBRUARY,0,0,0,,Tidak ada yang tahu tentang ini.
Dialogue: 0,0:19:26.75,0:19:28.65,Default,FEBRUARY,0,0,0,,Hanya aku dan ratu.
Dialogue: 0,0:19:31.96,0:19:36.16,Default,FEBRUARY,0,0,0,,Karena apa yang terjadi 8 tahun lalu, Yang Mulia yakin
Dialogue: 0,0:19:38.10,0:19:39.36,Default,FEBRUARY,0,0,0,,bahwa aku mencuri raja darinya.
Dialogue: 0,0:19:40.70,0:19:44.24,Default,FEBRUARY,0,0,0,,Racun di panah kita semakin kuat.
Dialogue: 0,0:19:44.97,0:19:47.97,Default,FEBRUARY,0,0,0,,Saatnya menggunakan hal kedua.
Dialog: 0,0:19:47.97,0:19:49.04,Default,FEBRUARY,0,0,0,,Ya.
Dialogue: 0,0:19:50.11,0:19:52.85,Default,FEBRUARY,0,0,0,,Sulit menemukan yang serupa,
Dialogue: 0,0:19:53.28,0:19:55.61,Default,FEBRUARY,0,0,0,,ini akan memakan waktu cukup lama.
Dialogue: 0,0:19:56.48,0:20:00.12,Default,FEBRUARY,0,0,0,,Tapi aku akan membawakannya padamu,\Bahkan jika aku harus membuatnya sendiri.
Dialog: 0,0:20:13.53,0:20:14.77,Default,Spillik2,0,0,0,,Gunakan yang ini.
Dialog: 0,0:20:31.02,0:20:34.19,Default,Spillik2,0,0,0,,Dalam sekejap mata mereka mengetahui tentang pengawal kerajaan.
Dialogue: 0,0:20:34.72,0:20:36.15,Default,Spikyulka2,0,0,0,,Ayo cari jalan.
Dialog: 0,0:20:36.29,0:20:38.52,Default,Spikyulka2,0,0,0,,Kemarin kamu bertemu dengan pria dari Departemen Detektif.
Dialog: 0,0:20:38.66,0:20:40.66,Default,Spillik2,0,0,0,,Dia melihat wajahmu. Apakah ini akan menjadi masalah?
Dialog: 0,0:20:41.43,0:20:43.33,Default,Spikyulka2,0,0,0,,Sepertinya dia tidak mengenaliku.
Dialog: 0,0:20:44.03,0:20:46.47,Default,Spilyk2,0,0,0,,Jika kita bertabrakan lagi,
Dialog: 0,0:20:47.53,0:20:49.84,Default,Spikyulka2,0,0,0,,dia akan mengerti bahwa saya sedang mencari buku akuntansi.
Dialog: 0,0:20:53.04,0:20:57.91,Default,Spillik2,0,0,0,,Dia memakai topeng langka berbentuk tokkebi.
Dialog: 0,0:20:58.94,0:21:02.51,Default,Spillik2,0,0,0,,Apakah dia punya bekas luka?
Dialog: 0,0:21:03.48,0:21:05.65,Default,Spillik2,0,0,0,,Ya. Sepertinya bekas luka lama.
Dialog: 0,0:21:06.12,0:21:07.92,Default,Spikyulka2,0,0,0,,Dia salah satu yang menyiksa Ovol.
Dialog: 0,0:21:09.79,0:21:11.82,Default,Spikyulka2,0,0,0,,Jadi, Kim Jwageun
Dialog: 0,0:21:11.82,0:21:13.93,Default,Spikyulka2,0,0,0,,bertindak melalui Kim Byonin.
Dialog: 0,0:21:15.16,0:21:16.30,Default,Spilyk2,0,0,0,,Untungnya,
Dialog: 0,0:21:16.93,0:21:19.83,Default,Spikyulka2,0,0,0,,dia tidak mengetahui bahwa lokasi penyimpanan buku besar akuntansi telah berubah.
Dialog: 0,0:21:21.93,0:21:23.64,Default,Spikyulka2,0,0,0,,Malam ini adalah kesempatan terakhir kita.
Dialog: 0,0:21:26.27,0:21:28.94,Default,Spikyulka2,0,0,0,,Yang Mulia, ada surat untuk Anda dari istana.
Dialog: 0,0:21:31.88,0:21:34.65,Default,Spikyulka2,0,0,0,,Surat ini dari Kim Jwagyn.
Dialog: 0,0:21:35.18,0:21:38.22,Default,Spikyulka2,0,0,0,,Dia diantar oleh kepala Departemen Detektif.
Dialog: 0,0:21:40.09,0:21:41.55,Default,Spikyulka2,0,0,0,,Semua dari departemen ini
Dialog: 0,0:21:41.55,0:21:42.92,Default,Spikyulka2,0,0,0,,bisa dengan mudah menyampaikannya.
Dialogue: 0,0:21:42.92,0:21:44.32,Default,Spikyulka2,0,0,0,,Tapi kamu datang sendiri?
Dialogue: 0,0:21:45.46,0:21:46.79,Default,Spilyk2,0,0,0,,Apakah kamu punya banyak waktu luang?
Dialogue: 0,0:21:47.79,0:21:50.63,Default,Spikyulka2,0,0,0,,Saya bawa sendiri karena penting.
Dialog: 0,0:21:51.46,0:21:54.43,Default,Spillik2,0,0,0,,Yang Mulia dan Ratu diminta segera kembali ke istana.
Dialog: 0,0:21:55.90,0:21:57.90,Default,Spilyk2,0,0,0,,Komandan pasukan
Dialogue: 0,0:21:57.90,0:22:00.04,Default,Spillik2,0,0,0,,menuntut aku kembali ke istana?
Dialog: 0,0:22:00.04,0:22:03.48,Default,Spillik2,0,0,0,,Dia menyampaikan pesan dari Janda Ratu.
Dialog: 0,0:22:04.84,0:22:07.38,Default,Silk2,0,0,0,,Saya akan menginap di sini satu malam lagi demi kesehatan ratu.
Dialog: 0,0:22:07.38,0:22:08.68,Default,Spikyulka2,0,0,0,,-Beri tahu mereka. \N-Tapi...
Dialog: 0,0:22:08.68,0:22:09.92,Default,Spilyk2,0,0,0,,Itu saja.
Dialog: 0,0:22:11.35,0:22:13.59,Default,Spillik2,0,0,0,,Jangan ganggu kedamaian ratu dan kembalilah.
Dialog: 0,0:22:18.02,0:22:19.12,Default,Spilyk2,0,0,0,,Begitulah adanya.
Dialog: 0,0:22:21.63,0:22:26.63,Default,Spillik2,0,0,0,,Tampaknya Yang Mulia sangat memperhatikan kesehatan ratu.
Dialog: 0,0:22:29.84,0:22:31.57,Default,Spilyk2,0,0,0,,Saya akan menyebarkannya.
Dialog: 0,0:22:36.84,0:22:39.48,Default,Spilyk2,0,0,0,,Saya akan sarapan di kamar ratu.
Dialog: 0,0:22:39.71,0:22:42.15,Default,Spilyk2,0,0,0,,Bawakan sarapanmu yang biasa. Biarkan saja mudah.
Dialog: 0,0:22:42.15,0:22:43.32,Default,Spillik2,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:22:43.32,0:22:46.05,Default,Spilyk2,0,0,0,,Kami akan menyajikan sarapan seperti biasa.
Dialog: 0,0:22:50.06,0:22:51.89,Default,Spillik2,0,0,0,,Rumah Selir Cho didekatnya,
Dialog: 0,0:22:52.16,0:22:53.86,Default,Spikyulka2,0,0,0,,Saya akan mencari tahu tentang Ovol dan kembali.
Dialog: 0,0:22:53.86,0:22:55.16,Default,Spillik2,0,0,0,,Ide bagus.
Dialogue: 0,0:22:56.13,0:22:58.26,Default,Spiky2,0,0,0,,Aku merasa tidak enak setelah mengusirnya.
Dialog: 0,0:22:58.73,0:23:00.67,Default,Spikyulka2,0,0,0,,Dan aku tidak akan berada di istana untuk satu malam lagi.
Dialog: 0,0:23:00.67,0:23:02.60,Default,Spillie2,0,0,0,,Tolong jaga dia.
Dialog: 0,0:23:03.20,0:23:04.24,Default,Spilyk2,0,0,0,,Ya.
Dialog: 0,0:23:11.38,0:23:15.95,Default,Spikyulka2,0,0,0,,Sang Ratu berkeliaran di sini sepanjang hari. Tapi saat dia pergi,
Dialog: 0,0:23:16.85,0:23:19.82,Default,Spilyk2,0,0,0,,dapur kerajaan tampak begitu kosong.
Dialog: 0,0:23:25.16,0:23:27.16,Default,Spillik2,0,0,0,,Sekarang aku bisa bernapas lagi.
Dialogue: 0,0:23:31.10,0:23:34.23,Default,Spillik2,0,0,0,,Dasar bajingan. Lebih banyak minyak lobak.
Dialog: 0,0:23:34.40,0:23:35.50,Default,Spilyk2,0,0,0,,Ini yang tanpa senjata.
Dialog: 0,0:23:35.83,0:23:37.37,Default,Spillit2,0,0,0,,Potong lebih kecil.
Dialog: 0,0:23:38.34,0:23:40.44,Default,Spillik2,0,0,0,,Masak lebih cepat sebelum kehilangan bentuknya.
Dialog: 0,0:23:48.41,0:23:52.82,Default,Spillik2,0,0,0,,Betapa indah dan damainya di sini.
Dialogue: 0,0:23:53.15,0:23:55.49,Default,Spillik2,0,0,0,,Saya suka memegang kendali.
Dialog: 0,0:24:01.66,0:24:09.30,Default,Spilyk2,0,0,0,,-Koki Kerajaan! \N-Koki Kerajaan!
Dialog: 0,0:24:09.30,0:24:13.04,Default,Spilyk2,0,0,0,,-Koki Kerajaan! \N-Koki Kerajaan!
Dialog: 0,0:24:13.04,0:24:14.34,Default,Spilyk2,0,0,0,,-Cukup. \N-Koki Kerajaan.
Dialog: 0,0:24:14.34,0:24:15.41,Default,Spilyk2,0,0,0,,-Koki kerajaan.
Dialog: 0,0:24:18.01,0:24:19.74,Default,Spillik2,0,0,0,,-Kembali. \N-Kami patuh.
Dialog: 0,0:24:20.11,0:24:21.35,Default,Spillit2,0,0,0,,Nyonya Choi.
Dialog: 0,0:24:24.28,0:24:25.52,Default,Spillit2,0,0,0,,Nyonya Choi.
Dialogue: 0,0:24:27.22,0:24:29.25,Default,Spillik2,0,0,0,,Melihat wajahmu,
Dialog: 0,0:24:30.26,0:24:33.56,Default,Spillik2,0,0,0,,Saya menyadari bahwa ratu belum pulih.
Dialog: 0,0:24:34.09,0:24:37.70,Default,Spilyk2,0,0,0,,Tidak, dia telah pulih sepenuhnya.
Dialog: 0,0:24:39.53,0:24:41.93,Default,Spikyulka2,0,0,0,,Lalu kenapa diturunkan ke dalam air?
Dialog: 0,0:24:43.97,0:24:48.77,Default,Spikyulka2,0,0,0,,Baru-baru ini, terima kasih kepada Yang Mulia, saya telah melalui begitu banyak hal.
Dialog: 0,0:24:50.31,0:24:52.18,Default,Spikyulka2,0,0,0,,Kupikir saat dia tidak ada,
Dialog: 0,0:24:52.81,0:24:54.65,Default,Spilyk2,0,0,0,,Saya tidak perlu mencari-cari kesalahan
Dialogue: 0,0:24:55.25,0:24:57.08,Default,Spikyulka2,0,0,0,,dan aku akan merasa lebih tenang.
Dialog: 0,0:24:57.82,0:24:58.95,Default,Spikyulka2,0,0,0,,Tetapi kenyataannya, bagaimana caranya?
Dialogue: 0,0:25:00.32,0:25:01.99,Default,Spillik2,0,0,0,,Aku makin gila.
Dialog: 0,0:25:02.82,0:25:07.39,Default,Spikyulka2,0,0,0,,Aku sangat takut tanpa aku dia akan benar-benar menjauh dariku.
Dialogue: 0,0:25:07.69,0:25:11.20,Default,Spilyk2,0,0,0,,Begini kesepakatannya. Mereka mengatakan bahwa ada lebih banyak kekhawatiran tentang rumor yang belum pernah terdengar,
Dialog: 0,0:25:11.20,0:25:13.30,Default,Spikyulka2,0,0,0,,daripada tentang anak-anak yang baik hati.
Dialog: 0,0:25:14.10,0:25:15.63,Default,Spillik2,0,0,0,,Berhenti murung.
Dialog: 0,0:25:15.77,0:25:16.97,Default,Spilyk2,0,0,0,,Di Sini.
Dialog: 0,0:25:25.84,0:25:27.85,Default,Spillik2,0,0,0,,Terbuka.
Dialog: 0,0:25:34.79,0:25:36.02,Default,Spikyulka2,0,0,0,,Dijemput di jalan.
Dialog: 0,0:25:38.22,0:25:41.69,Default,Spilyk2,0,0,0,,Pada hari-hari seperti ini
Dialog: 0,0:25:41.69,0:25:45.16,Default,Spillik2,0,0,0,,kamu seperti milikku, tapi bukan.
Dialog: 0,0:25:45.16,0:25:48.33,Default,Spilyk2,0,0,0,,Pada hari-hari seperti ini
Dialog: 0,0:25:48.33,0:25:51.54,Default,Spillik2,0,0,0,,kamu seperti milikku, tapi bukan.
Dialogue: 0,0:25:51.67,0:25:53.74,Default,Spikyulka2,0,0,0,,Dan hari-hari seperti ini kamu seperti milikku, tapi tidak.
Dialog: 0,0:25:53.74,0:25:56.07,Default,Spikyulka2,0,0,0,,Dan kenapa dia memberiku sampah yang dikumpulkan?
Dialogue: 0,0:25:57.08,0:25:58.84,Default,Spillik2,0,0,0,,Sungguh mimpi buruk.
Dialogue: 0,0:25:59.81,0:26:01.78,Default,Spikyulka2,0,0,0,,Semakin aku mengenalnya, semakin asing rasanya.
Dialogue: 0,0:26:02.71,0:26:04.65,Default,Spikyulka2,0,0,0,,Bisa saja aku membuangnya, kenapa kamu memberikannya padaku?
Dialogue: 0,0:26:04.98,0:26:06.59,Default,Spillik2,0,0,0,,Itu sampah.
Dialog: 0,0:26:07.18,0:26:10.98,Default,Spikyulka2,0,0,0,,Apakah Anda menerima kabar dari Ovol?
Dialog: 0,0:26:11.65,0:26:12.65,Default,Spillik2,0,0,0,,Tidak.
Dialogue: 0,0:26:13.25,0:26:14.92,Default,Spillik2,0,0,0,,Apa terjadi sesuatu padanya?
Dialog: 0,0:26:16.69,0:26:18.72,Default,Spillik2,0,0,0,,Dia tidak kembali ke rumah.
Dialog: 0,0:26:20.62,0:26:23.59,Default,Spikyulka2,0,0,0,,Saya pikir dia pergi ke tempat lain karena dia merasa bersalah di hadapanmu.
Dialog: 0,0:26:23.99,0:26:26.66,Default,Spikyulka2,0,0,0,,Aku bertanya-tanya tentang dia. Jangan terlalu khawatir.
Dialogue: 0,0:26:27.70,0:26:29.56,Default,Spikyulka2,0,0,0,,Aku sudah memberitahunya berkali-kali, tapi dia lagi...
Dialogue: 0,0:26:29.73,0:26:32.07,Default,Spillik2,0,0,0,,Aku mencari hadiahmu untuknya.
Dialog: 0,0:26:33.54,0:26:36.67,Default,Spikyulka2,0,0,0,,Jika dia pergi ke tempat lain, dia seharusnya menjualnya.
Dialogue: 0,0:26:37.87,0:26:39.24,Default,Spillik2,0,0,0,,aku takut,
Dialog: 0,0:26:40.08,0:26:41.78,Default,Spilyk2,0,0,0,,bahwa aku akan kehilangan seluruh rakyatku.
Dialog: 0,0:26:44.58,0:26:47.02,Default,Spillik2,0,0,0,,Kapan raja akan kembali ke istana?
Dialog: 0,0:26:47.48,0:26:48.55,Default,Spikyulka2,0,0,0,,Dia akan tinggal
Dialog: 0,0:26:49.55,0:26:50.72,Default,Spikyulka2,0,0,0,,satu malam lagi.
Dialog: 0,0:26:53.76,0:26:55.36,Default,Spikyulka2,0,0,0,,Ini bukan seperti yang kamu pikirkan.
Dialog: 0,0:26:55.96,0:26:57.89,Default,Spikyulka2,0,0,0,,Saya tidak bisa memberi tahu Anda detailnya,
Dialog: 0,0:26:57.89,0:27:01.00,Default,Spikyulka2,0,0,0,,tapi malam ini semuanya akan terselesaikan.
Dialog: 0,0:27:02.20,0:27:03.83,Default,Spikyulka2,0,0,0,,Bukan berarti raja punya
Dialog: 0,0:27:04.80,0:27:07.47,Default,Spikyulka2,0,0,0,,banyak kekhawatiran lainnya,
Dialog: 0,0:27:08.30,0:27:10.61,Default,Spikyulka2,0,0,0,,perasaannya padaku telah berubah.
Dialogue: 0,0:27:12.24,0:27:16.54,Default,Spikyulka2,0,0,0,,Rupanya, hanya aku yang melekat pada kenangan masa kecil.
Dialog: 0,0:27:17.21,0:27:19.05,Default,Biryulka2,0,0,0,,Saya ingat bagaimana saya kembali ke ibu kota
Dialog: 0,0:27:19.91,0:27:22.88,Default,Spikyulka2,0,0,0,,dan bertemu denganmu dan raja dua tahun lalu.
Dialog: 0,0:27:23.35,0:27:26.02,Default,Spikyulka2,0,0,0,,Bahkan jika hari itu dia melihatmu untuk pertama kalinya,
Dialog: 0,0:27:28.16,0:27:29.19,Default,Spilyk2,0,0,0,,pasti
Dialog: 0,0:27:30.19,0:27:31.89,Default,Spillik2,0,0,0,,akan menyukainya.
Dialog: 0,0:27:35.86,0:27:39.17,Default,Spillik2,0,0,0,,Kata-katamu menyemangatiku.
Dialogue: 0,0:27:47.98,0:27:49.98,Default,Spilyk2,0,0,0,,Apakah ini sarapanmu yang biasa?
Dialog: 0,0:27:50.95,0:27:53.65,Default,Spikyulka2,0,0,0,,Saya perlu menjadi lebih baik. \NKenapa kamu harus berkeliaran di sini satu malam lagi?
Dialog: 0,0:27:53.95,0:27:56.85,Default,Spillik2,0,0,0,,Untuk menjagamu, ratuku.
Dialog: 0,0:27:57.89,0:27:59.95,Default,Spikyulka2,0,0,0,,Dokter mengobati, apoteker memberi obat.
Dialogue: 0,0:28:00.12,0:28:02.49,Default,Spikyulka2,0,0,0,,Dan raja peduli dengan politik,\Ndan tidak peduli dengan kesehatanku.
Dialog: 0,0:28:02.92,0:28:04.79,Default,Spikyulka2,0,0,0,,Tahukah kamu berapa banyak orang yang menderita?
Dialog: 0,0:28:04.79,0:28:08.53,Default,Spillik2,0,0,0,,Kamu mengatakan kebenaran yang sebenarnya, ratu.
Dialogue: 0,0:28:08.53,0:28:10.53,Default,Spikyulka2,0,0,0,,Ayo, makan sup penyu
Dialog: 0,0:28:10.53,0:28:11.90,Default,Spikyulka2,0,0,0,,dan bekerja sebagai raja.
Dialog: 0,0:28:12.70,0:28:14.57,Default,Spillik2,0,0,0,,Jangan abaikan pengorbanan penyu.
Dialogue: 0,0:28:16.17,0:28:18.01,Default,Spikyulka2,0,0,0,,Aku lebih memilih pergi daripada menerima pengorbanannya
Dialog: 0,0:28:18.37,0:28:21.48,Default,Spikyulka2,0,0,0,,mari kita lihat bagaimana masyarakat awam hidup.
Dialog: 0,0:28:22.88,0:28:24.55,Default,Spikyulka2,0,0,0,,Aku akan kembali terlambat,
Dialog: 0,0:28:25.68,0:28:27.08,Default,Spikyulka2,0,0,0,,yang berarti kamu harus menginap satu malam lagi.
Dialogue: 0,0:28:30.29,0:28:32.09,Default,Spikyulka2,0,0,0,,Apakah kamu juga tidak ingin berkeliaran di istana?
Dialog: 0,0:28:32.75,0:28:35.16,Default,Spikyulka2,0,0,0,,Mengerikan sekali keadaanmu di sana bahkan lebih buruk daripada di rumah sanak saudaramu.
Dialog: 0,0:28:37.73,0:28:40.90,Default,Spikyulka2,0,0,0,,Ya, enak dan nyaman di sini.
Dialog: 0,0:28:43.33,0:28:45.33,Default,Spillik2,0,0,0,,Orang seperti apa Janda Ratu itu?
Dialog: 0,0:28:45.53,0:28:47.80,Default,Spikyulka2,0,0,0,,Dia adalah adik dari Tuan Kim Jwageun
Dialog: 0,0:28:47.84,0:28:51.37,Default,Spikyulka2,0,0,0,,dan belum meninggalkan istana sejak dia tiba.
Dialog: 0,0:28:51.37,0:28:53.24,Default,Spikyulka2,0,0,0,,Bagaimana jika saya persembahkan kepada seseorang yang tidak pernah
Dialogue: 0,0:28:53.24,0:28:55.94,Default,Silk2,0,0,0,,tidak keluar istana, piring dari luar...
Dialogue: 0,0:28:55.94,0:28:57.01,Default,Spillik2,0,0,0,,Kau tahu...
Dialog: 0,0:28:57.61,0:29:00.32,Default,Spillik2,0,0,0,,Dalam drama sejarah, mereka selalu makan gukbap.
Dialog: 0,0:29:00.32,0:29:01.45,Default,Spillik2,0,0,0,,Seperti apa rasanya?
Dialog: 0,0:29:02.28,0:29:04.85,Default,Spilyk2,0,0,0,,Bagaimana saya bisa tahu rasa makanan sederhana seperti itu?
Dialog: 0,0:29:18.30,0:29:19.87,Default,Spillik2,0,0,0,,Tidak terlalu menakjubkan.
Dialog: 0,0:29:22.70,0:29:25.44,Default,Spikyulka2,0,0,0,,Apa yang kamu lewatkan bisa menjadi senjata yang mengerikan.
Dialog: 0,0:29:32.15,0:29:34.08,Default,Spikyulka2,0,0,0,,Mereka membuat kaldu dari daging sandung lamur dan lobak putih,
Dialog: 0,0:29:34.08,0:29:36.08,Default,Biryulka2,0,0,0,,dibumbui dengan pasta kedelai dan menghangatkan nasi dengannya.
Dialog: 0,0:29:37.32,0:29:39.59,Default,Spilyk2,0,0,0,,Ada banyak daging di dalamnya. Sederhana, namun memiliki daya tarik tersendiri.
Dialog: 0,0:29:40.22,0:29:42.42,Default,Biryulka2,0,0,0,,Kimchi lobak dibuat tanpa makanan laut asin,
Dialog: 0,0:29:42.42,0:29:44.26,Default,Spillik2,0,0,0,,karena semuanya berjalan dengan baik tanpa membebani rasanya.
Dialogue: 0,0:29:44.56,0:29:46.69,Default,Silk2,0,0,0,,Mereka bilang Hongjong selalu makan gukbap di luar istana.
Dialog: 0,0:29:50.60,0:29:51.93,Default,Lily,0,0,0,,Sialan.
Dialogue: 0,0:29:52.57,0:29:55.44,Default,Lily,0,0,0,,Tetangga kabur tanpa membayar pajak,\NI harus membayarnya.
Dialog: 0,0:29:55.60,0:29:57.31,Default,Lily,0,0,0,,Ini benar-benar perampokan.
Dialog: 0,0:29:57.41,0:29:58.77,Default,Lily,0,0,0,,Gigit lidahmu.
Dialog: 0,0:29:59.14,0:30:00.81,Default,Lily,0,0,0,,Mau dipukul dengan tongkat?
Dialog: 0,0:30:00.81,0:30:03.08,Default,Lily,0,0,0,,Aku akan mati menggigit lidahku,
Dialog: 0,0:30:03.08,0:30:05.85,Default,Lily,0,0,0,,atau saya akan lari dan menjadi bandit - ada dua pilihan.
Dialogue: 0,0:30:05.85,0:30:09.12,Default,Lily,0,0,0,,Gigit lidahmu? Ya, saya tidak akan rugi apa-apa!
Dialog: 0,0:30:09.22,0:30:12.89,Default,Lily,0,0,0,,Mereka terkelupas seperti lengket. Di mana raja mencari?!
Dialog: 0,0:30:13.62,0:30:15.06,Default,Lily,0,0,0,,Apa yang kamu inginkan?
Dialog: 0,0:30:15.06,0:30:17.13,Default,Lily,0,0,0,,Tentu saja, dia menipu.
Dialog: 0,0:30:17.13,0:30:19.39,Default,Lily,0,0,0,,Boneka yang diberi takhta untuk ditutup
Dialog: 0,0:30:19.39,0:30:22.00,Default,Lily,0,0,0,,semua mata, dan mereka melakukan apa yang mereka inginkan.
Dialog: 0,0:30:22.00,0:30:23.43,Default,Lily,0,0,0,,Sial.
Dialog: 0,0:30:27.50,0:30:29.24,Default,Lily,0,0,0,,Berhenti.
Dialogue: 0,0:30:32.11,0:30:33.64,Default,Lily,0,0,0,,Aku mendengarmu.
Dialogue: 0,0:30:33.94,0:30:36.44,Default,Lily,0,0,0,,Kamu telah melalui banyak hal.
Dialog: 0,0:30:38.18,0:30:41.85,Default,Lily,0,0,0,,Karena raja yang bodoh, orang mati.
Dialog: 0,0:30:42.78,0:30:45.39,Default,Lily,0,0,0,,Minumlah dan lupakan kesedihanmu.
Dialog: 0,0:30:46.39,0:30:48.69,Default,Lily,0,0,0,,Kalian mirip
Dialog: 0,0:30:48.69,0:30:51.06,Default,Lily,0,0,0,,untuk orang dengan posisi tinggi.
Dialog: 0,0:30:54.00,0:30:55.30,Default,Lily,0,0,0,,Berpura-pura menjadi bangsawan.
Dialogue: 0,0:30:56.23,0:30:58.13,Default,Lily,0,0,0,,Yang paling mahal adalah silsilahnya.
Dialog: 0,0:30:58.13,0:31:01.37,Default,Lily,0,0,0,,Tanpa pakaian dan silsilah - Saya seorang pengemis biasa.
Dialogue: 0,0:31:04.04,0:31:05.91,Default,Lily,0,0,0,,Pemuda jaman sekarang terlihat mulia,
Dialog: 0,0:31:05.91,0:31:08.24,Default,Lily,0,0,0,,tapi kenyataannya mereka bodoh sepertimu.
Dialog: 0,0:31:08.31,0:31:09.34,Default,Lily,0,0,0,,Beraninya kamu?
Dialog: 0,0:31:10.08,0:31:11.88,Default,Lily,0,0,0,,Ya, negara kita adalah boneka.
Dialogue: 0,0:31:11.88,0:31:14.82,Default,Lily,0,0,0,,Jika seseorang mempunyai sesuatu di dalam,\Nit akan diambil dari mereka juga.
Dialog: 0,0:31:16.28,0:31:17.79,Default,Lily,0,0,0,,Lucu.
Dialog: 0,0:31:18.29,0:31:20.56,Default,Lily,0,0,0,,Pria ini
Dialog: 0,0:31:20.56,0:31:23.56,Default,Lily,0,0,0,,-cara menarik dalam memandang sesuatu.\N-Lucu.
Dialog: 0,0:31:23.56,0:31:26.63,Default,Lily,0,0,0,,Seorang pria dari keluarga pengkhianat menjadi raja.
Dialog: 0,0:31:26.63,0:31:28.86,Default,Lily,0,0,0,,Semuanya benar-benar busuk.
Dialog: 0,0:31:28.86,0:31:30.87,Default,Lily,0,0,0,,Di mana terlihat seseorang dari keluarga,
Dialog: 0,0:31:30.87,0:31:34.00,Default,Lily,0,0,0,,yang melakukan pengkhianatan selama beberapa generasi,
Dialogue: 0,0:31:34.00,0:31:36.10,Default,Lily,0,0,0,,menjadi raja?
Dialog: 0,0:31:36.10,0:31:39.41,Default,Lily,0,0,0,,Apa yang dipikirkan raja saat menerima takhta?
Dialog: 0,0:31:39.97,0:31:41.88,Default,Lily,0,0,0,,Dia hidup dalam kekuasaan Kim,
Dialog: 0,0:31:41.88,0:31:44.81,Default,Lily,0,0,0,,dengan pengecut membunuh seluruh keluarganya.
Dialog: 0,0:31:44.81,0:31:45.95,Default,Lily,0,0,0,,Tepat.
Dialogue: 0,0:31:46.08,0:31:48.58,Default,Lily,0,0,0,,-Sial.\N-Dan itu benar.
Dialog: 0,0:31:48.58,0:31:50.62,Default,Lily,0,0,0,,Anda telah melewati batas.
Dialog: 0,0:31:52.52,0:31:55.06,Default,Lily,0,0,0,,Kamu bebas mengutuk raja,
Dialog: 0,0:31:57.86,0:32:00.66,Default,Lilia,0,0,0,,tapi jangan berani-berani membicarakan keluarganya!
Dialog: 0,0:32:00.70,0:32:03.06,Default,Lily,0,0,0,,Ada garis yang tidak bisa dilewati!
Dialog: 0,0:32:03.87,0:32:05.00,Default,Lily,0,0,0,,Menurutmu,
Dialogue: 0,0:32:05.10,0:32:07.07,Default,Lily,0,0,0,,apakah menjadi raja berarti hidup mewah?
Dialog: 0,0:32:07.07,0:32:09.04,Default,Lily,0,0,0,,Dia selalu takut diracuni
Dialog: 0,0:32:09.04,0:32:10.44,Default,Lily,0,0,0,,atau tanpa kepala. Ini kejam!
Dialog: 0,0:32:10.64,0:32:12.81,Default,Lily,0,0,0,,Apakah kamu dari istana?
Dialogue: 0,0:32:12.94,0:32:15.51,Default,Lily,0,0,0,,Apakah kalian wakil raja?
Dialog: 0,0:32:15.71,0:32:17.01,Default,Lily,0,0,0,,Siapa kamu?
Dialog: 0,0:32:17.31,0:32:19.48,Default,Lily,0,0,0,,Saya? Ya, benar
Dialog: 0,0:32:23.38,0:32:24.89,Default,Lily,0,0,0,,dari klub penggemar raja.
Dialog: 0,0:32:25.59,0:32:26.96,Default,Lily,0,0,0,,-Apa?\N-Apa ini?
Dialog: 0,0:32:28.86,0:32:30.02,Default,Lily,0,0,0,,Klub penggemar?
Dialog: 0,0:32:30.16,0:32:31.99,Default,Lily,0,0,0,,Anti-penggemar juga merupakan penggemar.
Dialog: 0,0:32:32.29,0:32:35.93,Default,Lily,0,0,0,,Oke, diskusikan keluarganya setidaknya sekali lagi,
Dialogue: 0,0:32:36.06,0:32:38.73,Default,Lily,0,0,0,,Aku akan membalikkan keadaan untukmu!
Dialog: 0,0:32:39.13,0:32:42.40,Default,Lily,0,0,0,,-Melewatkannya?\N-Oke, oke.
Dialogue: 0,0:32:42.40,0:32:44.04,Default,Lily,0,0,0,,Jangan mendekat!
Dialog: 0,0:32:44.04,0:32:45.17,Default,Lily,0,0,0,,Maaf.
Dialogue: 0,0:32:45.27,0:32:46.84,Default,Lily,0,0,0,,Ikut sertakan kami!
Dialog: 0,0:32:46.84,0:32:48.24,Default,Lily,0,0,0,,Kemarilah.
Dialog: 0,0:32:48.24,0:32:50.88,Default,Lily,0,0,0,,Wow.
Dialog: 0,0:32:51.18,0:32:53.08,Default,Lily,0,0,0,,Karakter yang luar biasa.
Dialog: 0,0:32:53.08,0:32:54.65,Default,Lily,0,0,0,,Biarkan aku pergi. Melepaskan.
Dialogue: 0,0:32:55.08,0:32:56.82,Default,Lily,0,0,0,,Aku tidak kesal.
Dialogue: 0,0:32:58.32,0:32:59.69,Default,Lily,0,0,0,,Kamu bilang kamu berpura-pura.
Dialog: 0,0:33:00.19,0:33:01.99,Default,Lily,0,0,0,,Tidak mungkin mengungkapkan dirimu.
Dialog: 0,0:33:01.99,0:33:03.26,Default,Lily,0,0,0,,Aku malah marah padamu.
Dialog: 0,0:33:09.63,0:33:10.93,Default,Lily,0,0,0,,Apa? Dengan baik?
Dialog: 0,0:33:12.10,0:33:13.87,Default,Lily,0,0,0,,Kamu adalah aktris yang luar biasa.
Dialogue: 0,0:33:14.84,0:33:17.01,Default,Lily,0,0,0,,Tahukah kamu apa artinya ini?
Dialogue: 0,0:33:17.71,0:33:19.17,Default,Lily,0,0,0,,Bagus bukan?
Dialog: 0,0:33:20.21,0:33:22.54,Default,Lily,0,0,0,,Ngomong-ngomong, apa itu klub penggemar?
Dialog: 0,0:33:24.21,0:33:26.31,Default,Lily,0,0,0,,Inilah orang-orang yang mulia,
Dialog: 0,0:33:26.31,0:33:28.62,Default,Lily,0,0,0,,yang mendoakan kebahagiaan seseorang
Dialog: 0,0:33:28.62,0:33:29.95,Default,Lily,0,0,0,,dan sukses dari lubuk hatiku.
Dialog: 0,0:33:30.89,0:33:32.79,Default,Lily,0,0,0,,Ini seperti pembimbing spiritual.
Dialogue: 0,0:33:34.79,0:33:36.09,Default,Lily,0,0,0,,Dan anti-penggemar?
Dialog: 0,0:33:37.73,0:33:38.79,Default,Lily,0,0,0,,Biarkan aku berpikir.
Dialogue: 0,0:33:39.66,0:33:43.16,Default,Lily,0,0,0,,Seseorang yang lebih tertarik pada orang ini daripada penggemarnya?
Dialog: 0,0:33:45.20,0:33:47.04,Default,Lily,0,0,0,,Mentor yang lebih berpengaruh.
Dialog: 0,0:33:48.64,0:33:51.81,Default,Lily,0,0,0,,Aku tidak pantas menerima perasaanmu padaku.
Dialog: 0,0:33:54.28,0:33:56.28,Default,Lily,0,0,0,,Jatuhkan. Jika saya digulingkan
Dialog: 0,0:33:56.28,0:33:57.85,Default,Lily,0,0,0,,Saya akan menjual kuppap.
Dialog: 0,0:33:58.61,0:33:59.78,Default,Lily,0,0,0,,Jangan katakan itu.
Dialog: 0,0:34:00.65,0:34:02.48,Default,Lily,0,0,0,,Aku tidak akan membiarkan ini terjadi.
Dialogue: 0,0:34:03.45,0:34:05.39,Default,Lily,0,0,0,,Aku juga anti-penggemarmu.
Dialog: 0,0:34:05.69,0:34:08.32,Default,Lily,0,0,0,,Tentu saja. Tenangkan aku.
Dialog: 0,0:34:09.66,0:34:11.56,Default,Lily,0,0,0,,Sekarang kita pergi ke arah yang berbeda.
Dialogue: 0,0:34:11.56,0:34:13.06,Default,Lily,0,0,0,,Kita punya tujuan berbeda.
Dialogue: 0,0:34:14.43,0:34:17.77,Default,Lily,0,0,0,,Di mana restoran yang bagus,\Ndi mana orang mengantri?
Dialog: 0,0:34:20.84,0:34:23.17,Default,Lily,0,0,0,,"An" berarti nyaman, "ti"...
Dialog: 0,0:34:24.34,0:34:25.37,Default,Lily,0,0,0,,kipas?
Dialog: 0,0:34:26.61,0:34:29.24,Default,Lily,0,0,0,,Kupikir aku telah menyelesaikan studiku dengan cukup baik.
Dialog: 0,0:34:29.94,0:34:31.41,Default,Lily,0,0,0,,Ada sesuatu yang harus dikerjakan.
Dialog: 0,0:34:35.45,0:34:37.45,Default,Lily,0,0,0,,-Coba.\N-Tuhan.
Dialog: 0,0:34:37.45,0:34:38.99,Default,Lily,0,0,0,,-Banyak.\N-Tuhan.
Dialog: 0,0:34:38.99,0:34:41.02,Default,Lily,0,0,0,,-Beli, Nyonya.\N-Coba.
Dialog: 0,0:34:41.02,0:34:43.69,Default,Lily,0,0,0,,-Beli.\N-Apa yang kamu lakukan?
Dialog: 0,0:34:43.69,0:34:45.49,Default,Lily,0,0,0,,Enak, menurutku.
Dialog: 0,0:35:03.91,0:35:05.78,Default,Lily,0,0,0,,Takut, apa yang kamu lakukan?
Dialog: 0,0:35:05.78,0:35:08.12,Default,Lily,0,0,0,,Kamu akan masuk ke gang belakang dengan pakaian mahal,
Dialog: 0,0:35:08.12,0:35:09.55,Default,Lily,0,0,0,,kamu akan menjadi target.
Dialog: 0,0:35:10.65,0:35:12.42,Default,Lily,0,0,0,,-Target apa?\N-Siapa yang kita punya di sini?
Dialogue: 0,0:35:12.42,0:35:14.36,Default,Lily,0,0,0,,Apa yang dilupakan orang kaya di sini?
Dialogue: 0,0:35:15.46,0:35:17.13,Default,Lily,0,0,0,,Ini yang tadi kubicarakan.
Dialog: 0,0:35:17.43,0:35:19.96,Default,Lily,0,0,0,,Minggir. Aku tidak ingin menyakitimu.
Dialog: 0,0:35:21.40,0:35:22.63,Default,Lily,0,0,0,,Apakah kamu menyukai gadis itu?
Dialogue: 0,0:35:22.63,0:35:24.37,Default,Lily,0,0,0,,Sia-sia.
Dialog: 0,0:35:24.87,0:35:27.30,Default,Lily,0,0,0,,Jangan pernah memimpikannya,
Dialog: 0,0:35:27.30,0:35:29.60,Default,Lily,0,0,0,,bahwa aku sendirian di sini.
Dialog: 0,0:35:30.47,0:35:32.17,Default,Lily,0,0,0,,Saya memperhatikan ini sebelumnya.
Dialogue: 0,0:35:32.17,0:35:35.71,Default,Lily,0,0,0,,Kamu mengekspresikan dirimu dengan sangat baik,\Nseperti perampok terpelajar.
Dialog: 0,0:35:36.31,0:35:38.11,Default,Lily,0,0,0,,-Bersikaplah sopan.\N-Ya.
Dialog: 0,0:35:38.11,0:35:40.98,Default,Lily,0,0,0,,Jangan khawatir, saya tidak akan tersinggung.
Dialogue: 0,0:35:41.98,0:35:44.42,Default,Lily,0,0,0,,Aku anti-penggemarmu.
Dialog: 0,0:35:47.36,0:35:48.56,Default,Lily,0,0,0,,Apa katamu?
Dialogue: 0,0:35:56.90,0:35:58.23,Default,Lily,0,0,0,,Takut.
Dialogue: 0,0:35:59.27,0:36:00.97,Default,Lily,0,0,0,,Dimanapun aku berada,
Dialog: 0,0:36:00.97,0:36:02.60,Default,Lily,0,0,0,,jangan berjalan di tempat terpencil.
Dialogue: 0,0:36:04.41,0:36:05.87,Default,Lily,0,0,0,,Jaga mereka, Cheoljong.
Dialog: 0,0:36:11.28,0:36:13.25,Default,Lily,0,0,0,,Dan jika sesuatu terjadi padanya,
Dialog: 0,0:36:14.65,0:36:16.42,Default,Lily,0,0,0,,apakah sejarah akan berubah?
Dialog: 0,0:36:17.62,0:36:21.86,Default,Lily,0,0,0,,Hei! Saya dari pasukan khusus!
Dialogue: 0,0:36:24.46,0:36:25.59,Default,Lily,0,0,0,,Sudah hilang?
Dialog: 0,0:36:28.56,0:36:29.60,Default,Lily,0,0,0,,Cheoljong.
Dialog: 0,0:36:30.57,0:36:31.70,Default,Lily,0,0,0,,Apakah kamu mati?
Dialog: 0,0:36:34.07,0:36:35.84,Default,Lily,0,0,0,,Bagaimana caranya pulang?
Dialogue: 0,0:36:35.84,0:36:38.37,Default,Lily,0,0,0,,Wah, kenapa wanita kaya...
Dialog: 0,0:36:39.17,0:36:41.78,Default,Lilia,0,0,0,,Kupikir dia kembali karena dia mengkhawatirkanku.
Dialog: 0,0:36:42.44,0:36:44.58,Default,Lily,0,0,0,,Dan kamu tidak tahu jalan pulang.
Dialogue: 0,0:36:45.05,0:36:46.58,Default,Lily,0,0,0,,Bagaimana dengan preman itu?
Dialog: 0,0:36:47.18,0:36:50.08,Default,Lily,0,0,0,,Berlari mengejar pria dengan pakaian yang lebih mahal.
Dialog: 0,0:36:51.45,0:36:54.49,Default,Lily,0,0,0,,Jangan khawatir, saya tidak akan tersinggung.
Dialog: 0,0:36:55.62,0:36:58.06,Default,Lily,0,0,0,,Saya anti-penggemarmu.
Dialog: 0,0:37:01.30,0:37:02.53,Default,Lily,0,0,0,,Apa katamu?
Dialog: 0,0:37:03.56,0:37:06.27,Default,Lily,0,0,0,,Waktu kita tidak begitu damai,
Dialog: 0,0:37:06.27,0:37:08.87,Default,Lily,0,0,0,,untuk berbalik.
Dialogue: 0,0:37:08.87,0:37:11.01,Default,Lily,0,0,0,,Saya pikir Anda memahami apa yang Anda hadapi.
Dialog: 0,0:37:11.44,0:37:13.24,Default,Lily,0,0,0,,Wow. Hanya sebuah puisi.
Dialog: 0,0:37:14.18,0:37:16.14,Default,Lily,0,0,0,,Dari Kekaisaran Qing?
Dialogue: 0,0:37:16.14,0:37:18.48,Default,Lily,0,0,0,,Cantik sekali, kalau kita jual,\N kita bisa makan lima hari.
Dialogue: 0,0:37:18.48,0:37:19.55,Default,Lily,0,0,0,,Ayo lepas.
Dialogue: 0,0:37:26.69,0:37:28.96,Default,Lily,0,0,0,,Jangan berpaling.
Dialogue: 0,0:37:33.90,0:37:35.26,Default,Lily,0,0,0,,Aku tidak membunuhnya.
Dialog: 0,0:37:37.06,0:37:39.33,Default,Lily,0,0,0,,Tapi aku pasti akan membunuh orang berikutnya yang bergegas.
Dialog: 0,0:37:49.38,0:37:52.15,Default,Lily,0,0,0,,Kenapa dia tergeletak di tanah?
Dialogue: 0,0:37:52.75,0:37:54.08,Default,Lily,0,0,0,,Hanya minum terlalu banyak.
Dialog: 0,0:37:59.79,0:38:01.92,Default,Lily,0,0,0,,Kamu sangat beruntung.
Dialog: 0,0:38:04.96,0:38:06.23,Default,Lily,0,0,0,,Bagaimana dengan pakaianmu?
Dialog: 0,0:38:06.99,0:38:10.06,Default,Lily,0,0,0,,Aku tidak bisa luput dari perhatian
Dialog: 0,0:38:10.06,0:38:11.90,Default,Lily,0,0,0,,dengan pakaian mahal.
Dialog: 0,0:38:16.87,0:38:17.97,Default,Lily,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:38:17.97,0:38:19.97,Default,Lily,0,0,0,,Perlu membeli sesuatu.
Dialog: 0,0:38:19.97,0:38:21.98,Default,Lily,0,0,0,,Terburu-buru, tidak mengambil uang.
Dialog: 0,0:38:22.78,0:38:25.31,Default,Lily,0,0,0,,-Luar Biasa.\N-Anda merampok seorang perampok.
Dialog: 0,0:38:25.58,0:38:27.62,Default,Lily,0,0,0,,Hei, tidak.
Dialog: 0,0:38:27.98,0:38:31.49,Default,Lily,0,0,0,,Tampilkan. Tidak adil mengambil semuanya untuk dirimu sendiri.
Dialogue: 0,0:38:35.56,0:38:37.36,Default,Lily,0,0,0,,Makan kuppapa.
Dialog: 0,0:38:41.00,0:38:42.03,Default,Lily,0,0,0,,Tahan.
Dialog: 0,0:38:43.20,0:38:45.73,Default,Lily,0,0,0,,-Ayo pergi.\N-Apa yang ingin kamu beli?
Dialog: 0,0:38:51.87,0:38:52.87,Default,Lily,0,0,0,,Lanjutkan.
Dialog: 0,0:38:55.11,0:38:57.21,Default,Lily,0,0,0,,Dia bertarung dengan terampil.
Dialog: 0,0:38:57.95,0:38:59.61,Default,Lily,0,0,0,,Dilihat dari cara dia menjaga ruangan,
Dialog: 0,0:39:00.38,0:39:02.12,Default,Lily,0,0,0,,Saya rasa item tersebut ada.
Dialog: 0,0:39:02.12,0:39:04.75,Default,Lily,0,0,0,,Bisakah kamu mengenalinya jika bertemu dengannya lagi?
Dialog: 0,0:39:05.92,0:39:07.72,Default,Lily,0,0,0,,Tentu saja. Tuan,
Dialog: 0,0:39:09.62,0:39:11.03,Default,Lily,0,0,0,,Saya butuh obat.
Dialog: 0,0:39:16.76,0:39:18.57,Default,Lily,0,0,0,,Saya sudah menjelaskannya.
Dialog: 0,0:39:19.10,0:39:21.37,Default,Lily,0,0,0,,Tidak akan ada obatnya jika kamu gagal.
Dialog: 0,0:39:21.80,0:39:23.30,Default,Lily,0,0,0,,Bagaimana caramu membalas budiku?
Dialog: 0,0:39:23.84,0:39:26.01,Default,Lily,0,0,0,,Maukah kamu memberiku tanganmu untuk dipotong?
Dialogue: 0,0:39:26.44,0:39:28.01,Default,Lily,0,0,0,,Aku akan membalas budimu.
Dialog: 0,0:39:29.64,0:39:30.98,Default,Lily,0,0,0,,Aku bersumpah demi hidupku.
Dialog: 0,0:39:43.56,0:39:45.43,Default,,0,0,0,,Ini! Coba tebak apa itu.
Dialog: 0,0:39:45.66,0:39:48.43,Default,,0,0,0,,Kapal bulan dari Dinasti Goryeo.
Dialogue: 0,0:39:48.86,0:39:51.33,Default,,0,0,0,,Serius? Ini adalah nilai yang luar biasa.
Dialogue: 0,0:39:51.73,0:39:53.63,Default,,0,0,0,,-Berapa harganya?\N -Itu palsu.
Dialog: 0,0:39:54.77,0:39:57.10,Default,,0,0,0,,Beli jika Anda berencana menggunakannya untuk membela diri lagi.
Dialogue: 0,0:39:58.64,0:40:00.17,Default,,0,0,0,,Dasar bajingan.
Dialog: 0,0:40:07.92,0:40:09.05,Default,,0,0,0,,Pilih salah satu.
Dialog: 0,0:40:13.42,0:40:14.49,Default,,0,0,0,,Saya bertaruh segalanya.
Dialog: 0,0:40:15.09,0:40:18.73,Default,,0,0,0,,Wow, kamu tidak bisa mempertaruhkan uang sebanyak itu.
Dialogue: 0,0:40:18.73,0:40:20.76,Default,,0,0,0,,Ini adalah masyarakat kapitalis,\Ndi mana uang menang.
Dialog: 0,0:40:21.00,0:40:22.50,Default,,0,0,0,,-Saya bertaruh semuanya.\N-Maaf.
Dialog: 0,0:40:22.50,0:40:23.96,Default,,0,0,0,,-Apa yang kamu lakukan?\N-Nyonya.
Dialog: 0,0:40:23.96,0:40:25.07,Default,,0,0,0,,Ny.
Dialog: 0,0:40:25.07,0:40:26.70,Default,,0,0,0,,-Buka.\N -Buka.
Dialogue: 0,0:40:28.94,0:40:31.91,Default,,0,0,0,,Penipu seperti itu seharusnya menempatkan\N gengnya di dekat meja.
Dialog: 0,0:40:32.37,0:40:36.01,Default,,0,0,0,,Saya yakin semua penonton ada di sana untuk mengundang Anda ke dalam permainan.
Dialog: 0,0:40:37.04,0:40:39.68,Default,,0,0,0,,Kamu terlahir sebagai raja.
Dialogue: 0,0:40:39.68,0:40:42.45,Default,,0,0,0,,Dan tetap saja, kamu sepertinya tahu jalan luar dan dalam.
Dialog: 0,0:40:42.92,0:40:45.62,Default,,0,0,0,,Dan dia menyangkal dengan sekuat tenaga.
Dialog: 0,0:40:51.03,0:40:52.76,Default,,0,0,0,,Inilah titik lemahku.
Dialogue: 0,0:40:56.50,0:40:58.57,Default,,0,0,0,,Keluargaku dihancurkan dengan dalih makar.
Dialog: 0,0:40:59.87,0:41:01.00,Default,,0,0,0,,Pangeran Ganghwado.
Dialogue: 0,0:41:02.34,0:41:05.21,Default,,0,0,0,,Sejarah keluargaku adalah kelemahanku,\Nyang menghancurkanku.
Dialogue: 0,0:41:08.21,0:41:09.74,Default,,0,0,0,,Kamu bermimpi buruk tentang
Dialogue: 0,0:41:09.74,0:41:11.41,Default,,0,0,0,,bagaimana mereka memarahimu di pengadilan, atau bagaimana?
Dialogue: 0,0:41:14.25,0:41:17.95,Default,,0,0,0,,Mimpi buruk yang sesungguhnya bukanlah yang kuimpikan.
Dialogue: 0,0:41:19.59,0:41:21.26,Default,,0,0,0,,Mimpi buruk yang nyata...
Dialogue: 0,0:41:28.33,0:41:29.80,Default,,0,0,0,,Kenapa kamu berhenti di tengah kalimat?
Dialog: 0,0:41:30.80,0:41:32.70,Default,,0,0,0,,Lupa apa yang ingin saya katakan.
Dialog: 0,0:41:32.70,0:41:33.73,Default,,0,0,0,,Sebenarnya
Dialog: 0,0:41:35.37,0:41:37.54,Default,,0,0,0,,Saya ingin mengajukan pertanyaan.
Dialogue: 0,0:41:39.91,0:41:41.91,Default,,0,0,0,,Kenapa kamu tidak memberitahu siapa pun tentang malam itu?
Dialogue: 0,0:41:43.54,0:41:45.85,Default,,0,0,0,,-Tentang apa?\N-Bahwa aku mencoba menyakitimu.
Dialog: 0,0:41:47.08,0:41:50.42,Default,,0,0,0,,Ah, apa kamu membicarakan hal ini? Aku tidak ingin terlibat dalam kekacauan ini.
Dialogue: 0,0:41:50.79,0:41:54.09,Default,,0,0,0,,Aku hanya ingin melewati semua kesulitan.
Dialogue: 0,0:42:06.17,0:42:09.64,Default,,0,0,0,,Kami lebih memilih perdamaian di negara kami,\Nsudah bermalas-malasan.
Dialogue: 0,0:42:10.77,0:42:13.64,Default,,0,0,0,,Menyelamatkan negara bukanlah urusanku sama sekali.
Dialog: 0,0:42:16.61,0:42:17.65,Default,,0,0,0,,Di Sini.
Dialog: 0,0:42:17.65,0:42:20.58,Default,,0,0,0,,Saya ingin berdiri dan menyapa Anda.
Dialog: 0,0:42:20.58,0:42:22.98,Default,,0,0,0,,Ya, saya tidur di pegunungan yang dingin,
Dialogue: 0,0:42:22.98,0:42:24.79,Default,,0,0,0,,seluruh badanku sakit.
Dialog: 0,0:42:25.45,0:42:27.25,Default,,0,0,0,,Jika saya menginap di sana satu malam lagi,
Dialogue: 0,0:42:27.25,0:42:29.02,Default,,0,0,0,,bibir cantikku akan mati rasa.
Dialog: 0,0:42:29.96,0:42:31.93,Default,,0,0,0,,-Selesai?\N -Apa yang kamu bicarakan?
Dialogue: 0,0:42:32.29,0:42:33.76,Default,,0,0,0,,Rengekanmu.
Dialogue: 0,0:42:33.76,0:42:35.53,Default,,0,0,0,,Dan sedikit menyombongkan diri.
Dialog: 0,0:42:35.86,0:42:37.36,Default,,0,0,0,,Saya punya lebih banyak lagi,
Dialogue: 0,0:42:37.36,0:42:39.90,Default,,0,0,0,,tapi saya akan berhenti di sini - \Nit sepertinya ada urusan penting.
Dialog: 0,0:42:41.50,0:42:44.27,Default,,0,0,0,,Oke. Apa yang ada disana?
Dialogue: 0,0:43:08.96,0:43:12.90,Default,,0,0,0,,Kudengar kamu membuat topeng terbaik.
Dialog: 0,0:43:15.60,0:43:16.84,Default,,0,0,0,,Pilih sesuatu di sana.
Dialog: 0,0:43:22.11,0:43:23.54,Default,,0,0,0,,Wow, tukang gigi...
Dialog: 0,0:43:27.01,0:43:28.72,Default,,0,0,0,,Saya tidak ingin masker biasa.
Dialog: 0,0:43:29.08,0:43:32.29,Default,,0,0,0,,Saya sedang berpikir untuk menjual\N masker unik kepada pejabat.
Dialog: 0,0:43:32.62,0:43:33.72,Default,,0,0,0,,Unik?
Dialogue: 0,0:43:37.56,0:43:42.13,Default,,0,0,0,,Akhir-akhir ini kamu terlihat seperti milikku
Dialog: 0,0:43:42.13,0:43:44.06,Default,,0,0,0,,dan pada saat yang sama no.
Dialog: 0,0:43:47.13,0:43:48.30,Default,,0,0,0,,Tuangkan air.
Dialog: 0,0:43:49.60,0:43:51.11,Default,,0,0,0,,Tuangkan air.
Dialog: 0,0:43:51.54,0:43:52.54,Default,,0,0,0,,Ya!
Dialog: 0,0:43:53.94,0:43:55.14,Default,,0,0,0,,-Royal Chef.\N-Ya?
Dialog: 0,0:43:56.38,0:43:59.81,Default,,0,0,0,,Janda Ratu ingin camilan terlambat.
Dialog: 0,0:44:01.75,0:44:04.25,Default,,0,0,0,,Tapi saya tidak yakin Anda bisa melakukannya.
Dialog: 0,0:44:05.09,0:44:06.29,Default,,0,0,0,,Apa kabar...
Dialog: 0,0:44:07.62,0:44:09.82,Default,,0,0,0,,Saya telah bekerja di dapur kerajaan selama 30 tahun,
Dialog: 0,0:44:09.82,0:44:12.03,Default,,0,0,0,,dan 12 di antaranya oleh koki kerajaan.
Dialogue: 0,0:44:12.73,0:44:15.66,Default,,0,0,0,,Bagaimana aku bisa lebih buruk dari ratu? \NRather lebih baik.
Dialog: 0,0:44:23.84,0:44:25.47,Default,,0,0,0,,Aku percaya padamu sepenuhnya.
Dialog: 0,0:44:42.66,0:44:44.43,Default,,0,0,0,,Sial. Lagi.
Dialog: 0,0:44:55.17,0:44:56.20,Default,,0,0,0,,Lagi.
Dialog: 0,0:45:18.09,0:45:19.59,Default,,0,0,0,,Lebih cepat.
Dialogue: 0,0:45:25.43,0:45:26.53,Default,,0,0,0,,Hanya itu saja?
Dialog: 0,0:45:27.87,0:45:31.77,Default,,0,0,0,,Aku memerah semua sapi di gudang.
Dialog: 0,0:45:31.94,0:45:35.21,Default,,0,0,0,,Tidak ada setetes susu pun yang tersisa.
Dialog: 0,0:45:36.01,0:45:37.18,Default,,0,0,0,,Omong kosong!
Dialog: 0,0:45:39.75,0:45:40.75,Default,,0,0,0,,Apa?
Dialogue: 0,0:45:44.75,0:45:46.55,Default,,0,0,0,,Dasar brengsek tak bersenjata.
Dialog: 0,0:46:02.34,0:46:03.57,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:46:09.38,0:46:11.65,Default,,0,0,0,,Tiba-tiba aku jadi sangat marah, semuanya membuatku marah.
Dialog: 0,0:46:11.81,0:46:13.18,Default,,0,0,0,,Baik tubuh yang bingung ini,
Dialog: 0,0:46:13.18,0:46:14.58,Default,,0,0,0,,tidak tergeletak seperti orang mati,
Dialogue: 0,0:46:14.58,0:46:15.98,Default,,0,0,0,,jangan merasa seperti aku.
Dialogue: 0,0:46:16.05,0:46:19.35,Default,,0,0,0,,Aku bahkan tidak tahu apakah namaku Chan So-yeon\N atau Kim Bong-hwan.
Dialog: 0,0:46:19.65,0:46:21.82,Default,,0,0,0,,Nah, ingatanmu kembali,
Dialog: 0,0:46:21.82,0:46:23.22,Default,,0,0,0,,jadi anda bingung.
Dialogue: 0,0:46:24.99,0:46:26.76,Default,,0,0,0,,Tahukah kamu apa yang paling aku benci?
Dialogue: 0,0:46:27.53,0:46:29.36,Default,,0,0,0,,Aku mulai terbiasa dengan tubuh ini.
Dialogue: 0,0:46:30.43,0:46:31.97,Default,,0,0,0,,Apa yang membuatku nyaman memakai rok sekarang.
Dialog: 0,0:46:42.84,0:46:45.51,Default,,0,0,0,,Anda mungkin sedang menstruasi. \NI akan membawakanmu beberapa pembalut.
Dialog: 0,0:46:50.58,0:46:51.62,Default,,0,0,0,,Saya punya
Dialog: 0,0:46:52.75,0:46:54.19,Default,,0,0,0,,bulanan?
Dialog: 0,0:47:09.90,0:47:11.07,Default,,0,0,0,,Nyonya Jeon!
Dialog: 0,0:47:11.57,0:47:13.37,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:47:14.14,0:47:16.71,Default,,0,0,0,,Mengapa ratu belum kembali ke istana?
Dialog: 0,0:47:16.98,0:47:19.41,Default,,0,0,0,,Saya akan mengirim surat lagi sekarang.
Dialogue: 0,0:47:19.41,0:47:21.18,Default,,0,0,0,,Kita tidak berperang.
Dialog: 0,0:47:21.45,0:47:23.32,Default,,0,0,0,,Kirim segera setelah fajar.
Dialog: 0,0:47:23.32,0:47:24.95,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:47:28.22,0:47:31.66,Default,,0,0,0,,Kata-kata saudaraku tidak lagi memiliki kekuatan seperti itu?
Dialog: 0,0:47:33.73,0:47:36.76,Default,,0,0,0,,Usia tua adalah suatu sifat buruk.
Dialogue: 0,0:47:41.64,0:47:42.94,Default,,0,0,0,,Betapa laparnya aku.
Dialog: 0,0:48:00.95,0:48:02.29,Default,,0,0,0,,Satu lagi.
Dialog: 0,0:48:09.30,0:48:10.60,Default,,0,0,0,,Tidak ada.
Dialog: 0,0:48:11.33,0:48:13.03,Default,,0,0,0,,Tn.
Dialog: 0,0:48:23.84,0:48:25.51,Default,,0,0,0,,Itu kamu. Masuk.
Dialogue: 0,0:48:27.11,0:48:29.22,Default,,0,0,0,,Menunggu kepulanganku?
Dialog: 0,0:48:29.78,0:48:31.92,Default,,0,0,0,,Bagaimana kamu tahu aku baru saja kembali?
Dialog: 0,0:48:33.89,0:48:34.89,Default,,0,0,0,,Hei.
Dialog: 0,0:48:35.52,0:48:36.59,Default,,0,0,0,,Tunggu sebentar.
Dialogue: 0,0:48:38.63,0:48:41.53,Default,,0,0,0,,Bagaimana kamu bisa layu begitu banyak dalam 2 hari?
Dialog: 0,0:48:41.60,0:48:43.26,Default,,0,0,0,,Tn.
Dialogue: 0,0:48:44.80,0:48:46.87,Default,,0,0,0,,Sudahkah kamu menyia-nyiakan semua uangmu dari para penjahat?
Dialogue: 0,0:48:47.13,0:48:48.77,Default,,0,0,0,,Atau kamu kehilangan dokumen rumahmu?
Dialogue: 0,0:48:48.90,0:48:51.77,Default,,0,0,0,,Saat itu aku berumur 14 tahun, aku naif.
Dialogue: 0,0:48:52.57,0:48:54.51,Default,,0,0,0,,Masalah ini lebih serius.
Dialog: 0,0:48:55.08,0:48:56.44,Default,,0,0,0,,Kehilangan dokumen Anda untuk situs ini?
Dialog: 0,0:48:56.44,0:48:58.48,Default,,0,0,0,,Ini sudah terjadi ketika saya pergi...
Dialog: 0,0:49:01.21,0:49:03.18,Default,,0,0,0,,Keluargamu juga menderita kemalangan.
Dialog: 0,0:49:05.22,0:49:08.22,Default,,0,0,0,,Keluarga atau cinta?
Dialog: 0,0:49:09.59,0:49:11.56,Default,,0,0,0,,Itulah pertanyaannya.
Dialog: 0,0:49:17.20,0:49:19.80,Default,,0,0,0,,Kasihan.
Dialogue: 0,0:49:19.87,0:49:22.94,Default,,0,0,0,,Kasihan sekali.
Dialogue: 0,0:49:23.67,0:49:25.51,Default,,0,0,0,,Ini benar-benar masalah serius.
Dialog: 0,0:49:36.07,0:49:38.54,Default,,0,0,0,,Yang Mulia. Ratu Janda
Dialog: 0,0:49:38.54,0:49:40.52,Default,,0,0,0,,memanggilmu segera ke aula Dongmyeongjong.
Dialog: 0,0:49:54.73,0:49:56.07,Default,,0,0,0,,Apakah kamu meneleponku?
Dialog: 0,0:49:56.79,0:49:59.50,Default,,0,0,0,,Kamu tidak percaya bahwa kamu bersalah
Dialog: 0,0:49:59.50,0:50:02.13,Default,,0,0,0,,dalam kematian mendiang raja, kan?
Dialog: 0,0:50:03.48,0:50:07.40,Default,,0,0,0,,Jadi, kamu melakukan segala kemungkinan\N untuk menyalahkan keluargaku.
Dialog: 0,0:50:08.21,0:50:09.21,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:50:09.82,0:50:13.25,Default,,0,0,0,,Kamu boleh menghinaku sesuka kamu,
Dialog: 0,0:50:13.65,0:50:16.11,Default,,0,0,0,,tapi selamatkan mendiang raja kita.
Dialog: 0,0:50:16.21,0:50:18.86,Default,,0,0,0,,Sekali lagi kamu bersembunyi di belakang anakku.
Dialogue: 0,0:50:19.56,0:50:23.56,Default,,0,0,0,,Luar biasa, kamu tidak tahu malu\N menyalahkan seseorang untuk menyembunyikan rasa bersalahmu.
Dialog: 0,0:50:26.27,0:50:29.00,Default,,0,0,0,,Manusia harus mengenal dirinya sendiri,
Dialog: 0,0:50:29.29,0:50:32.77,Default,,0,0,0,,agar tidak melakukan kesalahan yang sama dua kali.
Dialog: 0,0:50:35.23,0:50:39.31,Default,,0,0,0,,Terima kasih atas pelajarannya.
Dialog: 0,0:50:46.79,0:50:51.11,Default,,0,0,0,,Aku sangat lelah hingga tak bisa melepas kaus kakiku.
Dialog: 0,0:50:56.50,0:50:59.67,Default,,0,0,0,,Saya akan dengan senang hati melepasnya untuk Anda.
Dialog: 0,0:51:18.19,0:51:20.32,Default,,0,0,0,,Hari Keranjang akan datang.
Dialog: 0,0:51:21.59,0:51:24.71,Default,,0,0,0,,Saat ini kesabaranku akan berakhir.
Dialog: 0,0:51:48.48,0:51:49.61,Default,,0,0,0,,Saya kembali.
Dialog: 0,0:51:50.42,0:51:51.42,Default,,0,0,0,,Ya.
Dialog: 0,0:51:53.48,0:51:56.19,Default,,0,0,0,,Saya dengar Departemen Detektif punya banyak pekerjaan hari ini.
Dialogue: 0,0:51:56.56,0:51:58.62,Default,,0,0,0,,Mereka bilang kamu menentang pengawal kerajaan.
Dialogue: 0,0:51:58.79,0:52:02.00,Default,,0,0,0,,Ada kecurigaan. Saya ingin menemukan \Nevidence sebelum saya memberi tahu Anda.
Dialog: 0,0:52:02.00,0:52:04.69,Default,menembak,0,0,0,,Ada orang mencurigakan di antara pengawal kerajaan.
Dialog: 0,0:52:04.69,0:52:06.82,Default,,0,0,0,,Saya kira ada tujuh.
Dialogue: 0,0:52:07.79,0:52:09.27,Default,,0,0,0,,Tahukah kamu tentangnya?
Dialogue: 0,0:52:12.77,0:52:15.63,Default,,0,0,0,,Apakah menurutmu aku tidak menyentuhnya karena aku tidak mengetahuinya?
Dialogue: 0,0:52:19.84,0:52:23.11,Default,,0,0,0,,Jika Anda tertarik secara langsung, bagaimana reaksi mereka?
Dialog: 0,0:52:23.27,0:52:25.69,Default,,0,0,0,,Mereka akan menggali lubang yang lebih dalam dan berbaring di dasar.
Dialog: 0,0:52:25.92,0:52:29.11,Default,,0,0,0,,Mereka akan menjadi lebih pintar dan bertindak diam-diam.
Dialog: 0,0:52:29.15,0:52:32.63,Default,,0,0,0,,Apa yang terlihat bukanlah ancaman.
Dialogue: 0,0:52:32.88,0:52:37.00,Default,,0,0,0,,Buat mereka percaya bahwa kamu tidak bisa melihatnya.
Dialog: 0,0:52:37.06,0:52:39.40,Default,,0,0,0,,Dan kemudian kamu dapat langsung membunuh mereka,
Dialog: 0,0:52:39.40,0:52:41.67,Default,,0,0,0,,segera setelah menjadi masalah.
Dialog: 0,0:52:42.84,0:52:44.29,Default,,0,0,0,,Saya tidak memikirkan hal itu.
Dialogue: 0,0:52:45.86,0:52:47.44,Default,,0,0,0,,Menurutmu,
Dialog: 0,0:52:48.04,0:52:50.38,Default,,0,0,0,,raja ada di posisi ini hanya karena
Dialog: 0,0:52:50.38,0:52:52.07,Default,,0,0,0,,bahwa dia tidak punya kemampuan?
Dialog: 0,0:52:53.77,0:52:57.94,Default,,0,0,0,,Alasannya adalah saya pribadi yang menanamkan rasa takut di benaknya.
Dialog: 0,0:52:58.54,0:53:01.48,Default,,0,0,0,,Sangat mudah untuk mengendalikan mereka yang takut.
Dialog: 0,0:53:01.71,0:53:04.48,Default,,0,0,0,,Jika yang berdiri di atas takut padaku,
Dialog: 0,0:53:04.48,0:53:07.09,Default,,0,0,0,,kekuatanku melebihi miliknya.
Dialog: 0,0:53:09.50,0:53:14.13,Default,,0,0,0,,Saya akan menghubungi Anda jika ada pertanyaan tentang raja.
Dialogue: 0,0:53:17.59,0:53:18.94,Default,,0,0,0,,Istirahatlah.
Dialogue: 0,0:54:15.73,0:54:17.46,Default,,0,0,0,,Mereka tidak akan bisa menemukanmu di sana.
Dialog: 0,0:54:17.69,0:54:19.29,Default,,0,0,0,,Aku pasti akan kembali untukmu.
Dialogue: 0,0:54:19.50,0:54:22.63,Default,,0,0,0,,Tapi sampai saat itu tiba, jangan keluar untuk apa pun.
Dialog: 0,0:54:22.63,0:54:25.17,Default,,0,0,0,,Bagaimana dengan saudara-saudaraku? Dan kamu, ibu?
Dialogue: 0,0:54:25.17,0:54:26.81,Default,,0,0,0,,Aku baik-baik saja selama kamu masih hidup.
Dialog: 0,0:54:27.50,0:54:30.50,Default,,0,0,0,,Kamu adalah putraku satu-satunya.
Dialog: 0,0:54:31.71,0:54:32.90,Default,,0,0,0,,Jika kamu mati,
Dialog: 0,0:54:34.00,0:54:35.34,Default,,0,0,0,,Aku juga tidak bisa hidup.
Dialog: 0,0:54:36.98,0:54:38.07,Default,,0,0,0,,Lebih cepat!
Dialog: 0,0:54:56.13,0:54:57.13,Default,,0,0,0,,Lebih cepat!
Dialogue: 0,0:56:30.23,0:56:31.59,Default,,0,0,0,,Menurutku.
Dialog: 0,0:56:32.46,0:56:33.67,Default,,0,0,0,,Ini tidak nyata.
Dialog: 0,0:56:35.86,0:56:37.04,Default,,0,0,0,,Kita perlu menemukan buku akuntansi.
Dialog: 0,0:56:45.11,0:56:46.27,Default,,0,0,0,,Apakah saya salah?
Dialog: 0,0:56:47.31,0:56:48.38,Default,,0,0,0,,Mustahil.
Dialog: 0,0:56:55.69,0:56:57.46,Default,,0,0,0,,Aku tidak bersalah, Wonbeom!
Dialogue: 0,0:56:58.11,0:57:02.23,Default,,0,0,0,,Saya dituduh salah. Nak, aku tidak bisa istirahat.
Dialog: 0,0:57:02.23,0:57:05.02,Default,,0,0,0,,Wonbom! Wonbom!
Dialogue: 0,0:57:05.02,0:57:06.29,Default,,0,0,0,,-Itu bukan aku.\N-Wonbom.
Dialog: 0,0:57:06.29,0:57:08.90,Default,,0,0,0,,-Wonbom.\N-Wonbom.
Dialogue: 0,0:57:08.90,0:57:11.67,Default,,0,0,0,,-Hanya kamu yang selamat.\N-Tidak adil.
Dialogue: 0,0:57:12.34,0:57:14.94,Default,,0,0,0,,Ini semua bohong.
Dialog: 0,0:57:15.23,0:57:17.44,Default,,0,0,0,,Itu hanya ada di kepalaku.
Dialogue: 0,0:57:17.63,0:57:20.15,Default,,0,0,0,,-Tidak, tidak.\N-Aku mengutukmu.
Dialog: 0,0:57:20.15,0:57:22.44,Default,,0,0,0,,-Tidak.\N-Aku mengutukmu.
Dialog: 0,0:57:46.96,0:57:48.07,Default,,0,0,0,,Kim Soyeon.
Dialog: 0,0:57:53.67,0:57:55.52,Default,,0,0,0,,Apa? Sangat mirip.
Dialogue: 0,0:57:56.44,0:58:00.32,Default,,0,0,0,,Apakah menurutmu kamu akan menjadi seperti Kim So-yeon yang asli?
Dialogue: 0,0:58:00.65,0:58:03.36,Default,,0,0,0,,Mereka punya kesamaan: tak punya ibu.
Dialog: 0,0:58:09.50,0:58:13.36,Default,,0,0,0,,Buku ini ditulis oleh seorang ilmuwan dari Joseon.
Dialog: 0,0:58:13.36,0:58:14.36,Default,,0,0,0,,Petunjuk Awal untuk Anak\NKim Soyeon
Dialog: 0,0:58:14.36,0:58:16.13,Default,,0,0,0,,Lima jenis hubungan:
Dialog: 0,0:58:16.69,0:58:19.61,Default,,0,0,0,,ayah - anak, penguasa - subjek, suami - istri,
Dialogue: 0,0:58:20.00,0:58:21.46,Default,,0,0,0,,kakak-adik,
Dialog: 0,0:58:21.46,0:58:23.17,Default,,0,0,0,,satu sama lain.
Dialogue: 0,0:58:23.17,0:58:26.00,Default,,0,0,0,,Belajar dengan giat sampai bukumu habis.
Dialogue: 0,0:58:26.84,0:58:28.31,Default,,0,0,0,,Kenapa diulangi lagi?
Dialogue: 0,0:58:29.84,0:58:33.11,Default,,0,0,0,,Hari ini adalah pemakaman ibuku.
Dialogue: 0,0:58:33.92,0:58:35.71,Default,,0,0,0,,Ini bukunya.
Dialogue: 0,0:58:36.86,0:58:39.86,Default,,0,0,0,,Jadi itulah yang kamu lakukan saat merindukan ibumu.
Dialog: 0,0:58:39.86,0:58:41.48,Default,,0,0,0,,
Dialog: 0,0:58:42.02,0:58:43.25,Default,,0,0,0,,aku menangis,
Dialog: 0,0:58:43.82,0:58:47.13,Default,,0,0,0,,belum menemukan cara untuk menemui ibuku.
Dialogue: 0,0:58:47.90,0:58:49.00,Default,,0,0,0,,Yang mana?
Dialog: 0,0:58:49.90,0:58:53.21,Default,,0,0,0,,Jika aku mati, aku akan menemuinya.
Dialog: 0,0:59:27.04,0:59:28.13,Default,,0,0,0,,Hidup?
Dialog: 0,0:59:30.81,0:59:32.27,Default,,0,0,0,,Apakah kamu datang untuk mati juga?
Dialog: 0,0:59:33.81,0:59:35.00,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:59:35.82,0:59:37.34,Default,,0,0,0,,Saya datang ke sini untuk mati.
Dialog: 0,0:59:43.09,0:59:46.63,Default,,0,0,0,,Apakah kamu ingin hidup? Karena kamu takut mati?
Dialog: 0,0:59:51.25,0:59:52.27,Default,,0,0,0,,Tidak.
Dialog: 0,0:59:53.46,0:59:57.09,Default,,0,0,0,,Semua orang mati kecuali aku. Itulah yang menakutkan.
Dialog: 0,0:59:58.50,0:59:59.61,Default,,0,0,0,,Lalu
Dialog: 0,1:00:01.11,1:00:02.40,Default,,0,0,0,,ayo kita mati bersama.
Dialog: 0,1:00:16.56,1:00:18.15,Default,,0,0,0,,Ayo lakukan dalam hitungan ketiga.
Dialog: 0,1:00:19.06,1:00:20.09,Default,,0,0,0,,Ya.
Dialogue: 0,1:00:31.09,1:00:32.81,Default,,0,0,0,,Suaranya datang dari sini!
Dialog: 0,1:00:37.11,1:00:38.23,Default,,0,0,0,,Saudara?
Dialog: 0,1:00:38.54,1:00:40.15,Default,,0,0,0,,Tahukah kamu betapa khawatirnya aku?
Dialog: 0,1:00:40.65,1:00:42.94,Default,,0,0,0,,Seluruh keluarga mencarimu.
Dialog: 0,1:00:42.94,1:00:45.17,Default,,0,0,0,,Saudara.
Dialog: 0,1:00:51.61,1:00:52.88,Default,,0,0,0,,Aku akan turun kepadamu.
Dialog: 0,1:00:55.29,1:00:56.92,Default,,0,0,0,,Turunkan saja tangganya.
Dialog: 0,1:00:57.52,1:00:58.59,Default,,0,0,0,,Oke.
Dialog: 0,1:01:05.46,1:01:08.50,Default,,0,0,0,,Maaf. Tapi aku masih ingin hidup.
Dialog: 0,1:01:10.81,1:01:12.75,Default,,0,0,0,,Kamu juga ingin hidup, bukan?
Dialogue: 0,1:01:18.71,1:01:20.21,Default,,0,0,0,,Aku akan kembali.
Dialog: 0,1:01:27.48,1:01:28.75,Default,,0,0,0,,Jika kamu ingin hidup,
Dialog: 0,1:01:29.63,1:01:33.46,Default,,0,0,0,,jika kamu ingin hidup lagi, kembalikan padaku.
Dialog: 0,1:01:47.15,1:01:49.17,Default,,0,0,0,,-Bisakah Anda menghubunginya?\N-Ya.
Dialog: 0,1:02:02.59,1:02:03.69,Default,,0,0,0,,Ayah.
Dialog: 0,1:02:06.13,1:02:07.42,Default,,0,0,0,,Tolong.
Dialog: 0,1:02:07.42,1:02:10.29,Default,,0,0,0,,Nona Soyeon.
Dialog: 0,1:02:17.23,1:02:21.31,Default,,0,0,0,,Ayah, tolong. Ayah.
Dialog: 0,1:02:21.31,1:02:25.02,Default,,0,0,0,,Ayah! Silakan!
Dialog: 0,1:02:25.02,1:02:28.25,Default,,0,0,0,,Ayah, ayah!
Dialog: 0,1:02:28.25,1:02:29.59,Default,,0,0,0,,-Tolong.\N-Tempatkan sumur.
Dialog: 0,1:02:29.92,1:02:34.63,Default,,0,0,0,,Ayah, tidak! Tidak perlu, ayah!
Dialog: 0,1:02:34.63,1:02:37.36,Default,,0,0,0,,Ayah! Jangan lakukan ini!
Dialog: 0,1:02:40.46,1:02:42.00,Default,,0,0,0,,Tidak! Ayah!
Dialog: 0,1:02:42.54,1:02:46.63,Default,,0,0,0,,Tidak perlu, ayah! Tidak perlu!
Dialog: 0,1:02:47.13,1:02:50.07,Default,,0,0,0,,Tolong, ayah! Jangan lakukan ini!
Dialog: 0,1:02:50.63,1:02:53.40,Default,,0,0,0,,Ayah, tidak! Ayah!
Dialog: 0,1:02:53.57,1:02:56.15,Default,,0,0,0,,Ayah!
Dialogue: 0,1:03:03.56,1:03:05.09,Default,,0,0,0,,Baik ibu maupun gadis ini.
Dialog: 0,1:03:05.82,1:03:08.06,Default,,0,0,0,,Saya masih tidak percaya janji mereka.
Dialog: 0,1:03:09.50,1:03:11.06,Default,,0,0,0,,Semuanya akan berakhir saat aku mati.
Dialog: 0,1:03:11.73,1:03:14.59,Default,,0,0,0,,Ini tidak akan berakhir sampai sumur terisi air.
Dialog: 0,1:03:16.44,1:03:17.54,Default,,0,0,0,,Tidak Pernah.
Dialog: 0,1:03:47.59,1:03:49.44,Default,,0,0,0,,Selamatkan aku!
Dialog: 0,1:03:50.00,1:03:53.36,Default,,0,0,0,,Selamatkan aku, selamatkan aku!
Dialog: 0,1:03:53.57,1:03:55.84,Default,,0,0,0,,Simpan! Silakan!
Dialog: 0,1:03:55.98,1:03:59.17,Default,,0,0,0,,Maaf! Tolong selamatkan aku!
Dialog: 0,1:03:59.17,1:04:00.44,Default,,0,0,0,,Ini salahku.
Dialog: 0,1:04:00.84,1:04:02.67,Default,,0,0,0,,Dia akan mati karena aku.
Dialog: 0,1:04:02.67,1:04:05.04,Default,,0,0,0,,Karena saya mengungkapkan rahasianya.
Dialog: 0,1:04:05.04,1:04:07.71,Default,,0,0,0,,Aku memberi tahu pelayan tentang dia.
Dialog: 0,1:04:07.92,1:04:09.69,Default,,0,0,0,,Apakah kamu mendengar apa yang dikatakan orang dewasa?
Dialogue: 0,1:04:10.32,1:04:11.61,Default,,0,0,0,,Keluarganya pengkhianat.
Dialog: 0,1:04:11.96,1:04:14.32,Default,,0,0,0,,Tapi dia tidak melakukan apa pun.
Dialog: 0,1:04:14.75,1:04:17.59,Default,,0,0,0,,Kak, kamu orang baik kan?
Dialogue: 0,1:04:18.15,1:04:21.32,Default,,0,0,0,,Tolong abang.
Dialog: 0,1:04:29.11,1:04:31.04,Default,,0,0,0,,Cepat kemari.
Dialog: 0,1:04:39.98,1:04:42.46,Default,,0,0,0,,Adikku memang orang yang baik.
Dialog: 0,1:04:54.52,1:04:56.94,Default,,0,0,0,,Simpan. Selamatkan aku.
Dialog: 0,1:04:57.00,1:05:00.04,Default,,0,0,0,,Tolong. Menyimpan.
Dialog: 0,1:05:09.82,1:05:10.98,Default,,0,0,0,,Kita harus cepat.
Dialog: 0,1:05:20.48,1:05:21.88,Default,,0,0,0,,Kamu benar-benar kembali.
Dialog: 0,1:05:23.25,1:05:24.92,Default,,0,0,0,,Seperti yang dijanjikan.
Dialog: 0,1:06:07.04,1:06:08.84,Default,,0,0,0,,
Dialog: 0,1:06:17.27,1:06:18.54,Default,,0,0,0,,Saya ingin hidup.
Dialog: 0,1:06:19.61,1:06:20.65,Default,,0,0,0,,Seperti kamu.
Dialog: 0,1:06:27.73,1:06:29.52,Default,,0,0,0,,Kim Soyeon
Dialogue: 0,1:06:48.31,1:06:50.07,Default,,0,0,0,,Orang takut gelap,
Dialog: 0,1:06:50.61,1:06:53.19,Default,,0,0,0,,jadi mereka menyalakan lampu.
Dialog: 0,1:07:08.09,1:07:09.79,Default,,0,0,0,,Rahasia
Dialog: 0,1:07:16.20,1:07:17.98,Default,,0,0,0,,Tetapi semakin terang cahayanya,
Dialog: 0,1:07:18.81,1:07:20.61,Default,,0,0,0,,semakin hitam bayangannya.
Dialog: 0,1:07:37.62,1:07:40.53,Default,,0,0,0,,Hwajin.
Dialog: 0,1:08:00.74,1:08:05.06,Default,,0,0,0,,
Dialog: 0,1:08:20.61,1:08:22.11,Default,,0,0,0,,Apa yang terjadi?
Dialog: 0,1:08:22.11,1:08:24.33,Default,,0,0,0,,Tepat sekali, aku hampir menyentuhnya.
Dialogue: 0,1:08:26.04,1:08:27.15,Default,,0,0,0,,Itu berbahaya.
Dialog: 0,1:08:27.15,1:08:29.04,Default,,0,0,0,,Kamu bisa datang kapan pun kamu mau.
Dialog: 0,1:08:29.04,1:08:31.37,Default,,0,0,0,,Tetapi Anda tidak dapat bertindak sesuai keinginan Anda.
Dialog: 0,1:08:31.37,1:08:32.52,Default,,0,0,0,,Saya yakin ini palsu.
Dialogue: 0,1:08:32.52,1:08:34.21,Default,,0,0,0,,Apakah maksudmu seseorang memalsukan identitasnya?
Dialog: 0,1:08:34.21,1:08:36.95,Default,,0,0,0,,Saya akan mengalahkan satu musuh dengan bantuan musuh lainnya.
Dialog: 0,1:08:36.95,1:08:39.19,Default,,0,0,0,,Jadi saya akan menjadi sangat diperlukan:
Dialog: 0,1:08:39.19,1:08:41.49,Default,,0,0,0,,Makanan Korea dan perawatan diri Korea.
Dialogue: 0,1:08:41.49,1:08:44.12,Default,,0,0,0,,Ketakutan dan kekhawatiran membuatmu kehilangan akal.
Dialog: 0,1:08:44.12,1:08:46.23,Default,,0,0,0,,Kamu benar-benar anti-penggemarku.
Dialog: 0,1:08:46.23,1:08:48.90,Default,,0,0,0,,Saya sangat khawatir, tetapi saya menemukan jalan keluar.
Dialog: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


