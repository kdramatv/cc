Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Host, Hazelnut, Februari
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.06,0:01:06.33,Default,Lily,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.33,0:01:08.61,Default,Lily,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:01:10.57,0:01:11.94,Default,Lily,0,0,0,,Jika kamu tidak mau bicara,
Dialog: 0,0:01:11.94,0:01:13.81,Default,Lily,0,0,0,,gunakan isyarat tangan?
Dialogue: 0,0:01:13.81,0:01:14.81,Default,Lily,0,0,0,,Contohnya, yang ini.
Dialogue: 0,0:01:15.78,0:01:16.98,Default,Lily,0,0,0,,Apa ini?
Dialogue: 0,0:01:16.98,0:01:20.25,Default,Lily,0,0,0,,Artinya aku berbohong.
Dialogue: 0,0:01:20.68,0:01:22.68,Default,Lily,0,0,0,,Bagaimana menurutmu? Tidak sulit, bukan?
Dialog: 0,0:01:28.19,0:01:31.02,Default,Lily,0,0,0,,Raja tidak pernah berbohong.
Dialog: 0,0:01:34.00,0:01:36.93,Default,Lily,0,0,0,,15 episode
Dialogue: 0,0:01:55.35,0:01:58.12,Default,Lily,0,0,0,,Dosa apa yang bisa dilakukan anak kecil seperti itu?
Dialog: 0,0:02:00.05,0:02:02.46,Default,Lily,0,0,0,,Bau alkohol dan hal lainnya.
Dialog: 0,0:02:03.36,0:02:04.69,Default,Lily,0,0,0,,Dia tidak meminum racunnya.
Dialog: 0,0:02:05.93,0:02:11.63,Default,Lilia,0,0,0,,Aku tidak percaya dia dipaksa meminum racun oleh tangan mungil itu.
Dialog: 0,0:02:13.47,0:02:15.97,Default,Lily,0,0,0,,Tangan hangat. Dia masih hidup.
Dialog: 0,0:02:23.14,0:02:24.38,Default,Lily,0,0,0,,Bangun.
Dialog: 0,0:02:25.21,0:02:27.45,Default,Lily,0,0,0,,Damhyang!
Dialog: 0,0:02:31.49,0:02:32.52,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:02:47.00,0:02:48.80,Default,Lily,0,0,0,,-Tuan\N-Anda di sini.
Dialog: 0,0:02:48.80,0:02:49.90,Default,Lily,0,0,0,,Tn.
Dialog: 0,0:02:51.00,0:02:52.07,Default,Lily,0,0,0,,Tunggu.
Dialog: 0,0:02:56.51,0:02:59.15,Default,Lily,0,0,0,,Kamu tidak bisa meninggalkan anak di pegunungan.
Dialogue: 0,0:03:00.45,0:03:02.65,Default,Lily,0,0,0,,Aku harus memberinya pemakaman.
Dialog: 0,0:03:12.66,0:03:14.86,Default,Lily,0,0,0,,-Selamat tinggal.\N-Selamat tinggal.
Dialog: 0,0:03:35.12,0:03:37.18,Default,Lily,0,0,0,,Bagaimana Damhyan? Apakah dia baik-baik saja?
Dialog: 0,0:03:37.48,0:03:39.89,Default,Lily,0,0,0,,Dia telah meninggalkan istana dengan selamat.
Dialog: 0,0:03:40.62,0:03:42.82,Default,Lily,0,0,0,,Aku kasihan pada ibu pelayannya
Dialog: 0,0:03:42.82,0:03:45.73,Default,Lilia,0,0,0,,dan menyiapkan segalanya agar mereka bisa meninggalkan Hanyang bersama.
Dialog: 0,0:03:45.73,0:03:47.13,Default,Lily,0,0,0,,Jadi dia akan bertemu ibunya.
Dialog: 0,0:03:47.93,0:03:50.06,Default,Lilia,0,0,0,,Damhyan sangat mengkhawatirkannya.
Dialog: 0,0:03:50.53,0:03:52.93,Default,Lily,0,0,0,,Sungguh menyenangkan. Ini keren.
Dialogue: 0,0:03:56.17,0:03:58.74,Default,Lily,0,0,0,,Bagaimana kamu melakukan ini? Apakah Anda memberinya obat tidur?
Dialogue: 0,0:03:58.77,0:04:00.34,Default,Lily,0,0,0,,Mereka memberinya mafeisan untuk diminum.
Dialog: 0,0:04:01.48,0:04:05.08,Default,Lily,0,0,0,,Mafeisan, apa yang digunakan Hua Tuo selama operasi?
Dialog: 0,0:04:05.08,0:04:06.35,Default,Lily,0,0,0,,Kamu kenal dia.
Dialog: 0,0:04:06.35,0:04:09.02,Default,Lily,0,0,0,,Tentu saja. Saya telah membaca Tiga Kerajaan untuk Anak berkali-kali.
Dialogue: 0,0:04:09.62,0:04:11.32,Default,Lily,0,0,0,,Tiga Kerajaan untuk anak-anak?
Dialog: 0,0:04:13.09,0:04:16.42,Default,Lily,0,0,0,,Dengarkan. Anda seharusnya memperingatkan saya.
Dialog: 0,0:04:16.42,0:04:18.23,Default,Lily,0,0,0,,Masalahnya mendesak,
Dialog: 0,0:04:18.23,0:04:20.23,Default,Lilia,0,0,0,,berbahaya jika melibatkan banyak orang.
Dialog: 0,0:04:25.20,0:04:27.27,Default,Lily,0,0,0,,Ada kabar dari Tuan Hong?
Dialog: 0,0:04:27.47,0:04:31.04,Default,Lily,0,0,0,,Ya. Dia memastikan anak itu lolos dengan selamat.
Dialog: 0,0:04:32.94,0:04:34.34,Default,Lily,0,0,0,,Bagus sekali.
Dialog: 0,0:04:35.38,0:04:38.58,Default,Lily,0,0,0,,Sembrono memaparkan diri pada bahaya
Dialog: 0,0:04:38.98,0:04:40.38,Default,Lily,0,0,0,,karena pelayan.
Dialogue: 0,0:04:40.55,0:04:42.32,Default,Lily,0,0,0,,Dia bukan sekadar pelayan.
Dialog: 0,0:04:43.38,0:04:44.92,Default,Lily,0,0,0,,Jika aku menyerahkan anak itu,
Dialog: 0,0:04:46.02,0:04:48.39,Default,Lily,0,0,0,,akan lebih mudah untuk menyerah 10, 100,
Dialog: 0,0:04:50.12,0:04:52.49,Default,Lily,0,0,0,,dan kemudian semua orangku.
Dialog: 0,0:04:53.66,0:04:57.10,Default,Lily,0,0,0,,Saya pikir Cheoljong adalah orang bodoh biasa,
Dialog: 0,0:04:58.00,0:05:00.47,Default,Lilia,0,0,0,,dan dia benar-benar bodoh.
Dialogue: 0,0:05:00.53,0:05:02.97,Default,Lily,0,0,0,,Jangan menghabiskan banyak waktu memikirkan hal-hal hebat.
Dialog: 0,0:05:02.97,0:05:04.17,Default,Lily,0,0,0,,Jika tidak, kamu tidak akan berumur panjang.
Dialog: 0,0:05:04.77,0:05:07.37,Default,Lily,0,0,0,,Saya tidak bermaksud menjalani kehidupan yang menyedihkan.
Dialog: 0,0:05:07.37,0:05:09.41,Default,Lily,0,0,0,,Alasan bagus untuk kematian dini.
Dialog: 0,0:05:09.88,0:05:11.51,Default,Lily,0,0,0,,Siapa dia...
Dialog: 0,0:05:11.51,0:05:12.98,Default,Lily,0,0,0,,Dialah yang sangat berterima kasih padaku.
Dialog: 0,0:05:14.01,0:05:16.92,Default,Lily,0,0,0,,Ratu berbicara berbeda dari yang lain.
Dialogue: 0,0:05:19.52,0:05:21.42,Default,Lily,0,0,0,,"The Queen's Dictionary" sangat berguna.
Dialog: 0,0:05:21.42,0:05:23.52,Default,Lily,0,0,0,,Ini penuh dengan terjemahan gratis dan salah.
Dialog: 0,0:05:23.52,0:05:25.66,Default,Lily,0,0,0,,-Apakah Anda melihatnya?\N-Anda membiarkannya terbuka.
Dialog: 0,0:05:26.69,0:05:30.26,Default,Lily,0,0,0,,Ngomong-ngomong, apakah posisi ratu selalu berbahaya?
Dialog: 0,0:05:30.26,0:05:32.13,Default,Lily,0,0,0,,Kenapa semua orang ingin membunuhku?
Dialog: 0,0:05:32.47,0:05:35.60,Default,Lily,0,0,0,,Saya tidak akan membiarkan ini terjadi lagi.
Dialog: 0,0:05:36.67,0:05:38.87,Default,Lily,0,0,0,,Tidak. Aku akan mengurus semuanya sendiri.
Dialog: 0,0:05:39.74,0:05:41.74,Default,Lily,0,0,0,,Pertahanan terbaik adalah serangan.
Dialog: 0,0:05:43.71,0:05:47.05,Default,Lily,0,0,0,,Mulai hari ini, aku akan menjadi orang paling ceroboh di istana.
Dialog: 0,0:06:02.76,0:06:05.77,Default,Lily,0,0,0,,Crazy X ada di sini
Dialog: 0,0:06:12.47,0:06:14.77,Default,Lily,0,0,0,,Sudahkah kamu mencoba menyingkirkan ratu?
Dialog: 0,0:06:15.34,0:06:17.44,Default,Lily,0,0,0,,Ratu berada di sisi raja.
Dialog: 0,0:06:17.44,0:06:20.35,Default,Lily,0,0,0,,Dia bercerita tentang semua kelemahan keluarga kami.
Dialog: 0,0:06:20.88,0:06:23.38,Default,Lily,0,0,0,,Jatuh cinta pada raja dan berpaling dari kami.
Dialog: 0,0:06:24.08,0:06:25.52,Default,Lily,0,0,0,,Ini tidak benar.
Dialog: 0,0:06:26.35,0:06:28.09,Default,Lily,0,0,0,,Kamu tidak mau percaya,
Dialog: 0,0:06:28.62,0:06:31.26,Default,Lily,0,0,0,,bahwa ratu yang kamu kagumi
Dialog: 0,0:06:31.26,0:06:33.06,Default,Lily,0,0,0,,hanya wanita bodoh,
Dialog: 0,0:06:33.06,0:06:34.83,Default,Lily,0,0,0,,jatuh cinta sembarangan pada seorang pria.
Dialog: 0,0:06:35.83,0:06:37.80,Default,Lily,0,0,0,,Bergabung dengan keluargamu,
Dialog: 0,0:06:37.80,0:06:40.67,Default,Lily,0,0,0,,Saya melakukan semua yang Anda inginkan agar diterima.
Dialog: 0,0:06:42.34,0:06:44.91,Default,Lily,0,0,0,,Tidak hanya tinggal di rumah ini.
Dialog: 0,0:06:45.57,0:06:47.11,Default,Lily,0,0,0,,Aku ingin menjadi sepertimu,
Dialog: 0,0:06:48.14,0:06:49.88,Default,Lilia,0,0,0,, menghormatimu.
Dialog: 0,0:06:51.78,0:06:54.48,Default,Lily,0,0,0,,Tetapi mencoba menyakiti ratu,
Dialog: 0,0:06:56.02,0:06:58.29,Default,Lilia,0,0,0,,kamu bukan lagi ayahku.
Dialog: 0,0:07:01.02,0:07:04.22,Default,Lily,0,0,0,,Jika ada yang memutuskan untuk mengancam ratu,
Dialogue: 0,0:07:06.89,0:07:09.20,Default,Lily,0,0,0,,Aku pasti akan menggorok lehernya.
Dialog: 0,0:07:14.94,0:07:17.00,Default,Lily,0,0,0,,Kamu bisa pulang kapan pun kamu mau.
Dialog: 0,0:07:19.01,0:07:21.44,Default,Lily,0,0,0,,Bahkan jika kamu tidak menganggapku seorang ayah,
Dialog: 0,0:07:22.64,0:07:24.98,Default,Lily,0,0,0,,kamu akan selalu menjadi anakku.
Dialogue: 0,0:07:36.86,0:07:40.16,Default,Lily,0,0,0,,Siapa yang menyembunyikan buku besar di Daejojeon?
Dialogue: 0,0:07:40.69,0:07:42.73,Default,Lily,0,0,0,,Tersangka utamanya adalah
Dialogue: 0,0:07:42.73,0:07:44.76,Default,Lily,0,0,0,,mereka berdua yang menaruh dendam padaku.
Dialog: 0,0:07:45.47,0:07:47.27,Default,Lily,0,0,0,,Ibu Suri dan Cho Hwajin.
Dialogue: 0,0:07:47.67,0:07:50.17,Default,Lily,0,0,0,,Motifnya menunjuk pada Cho Hwajin.
Dialog: 0,0:07:58.04,0:08:00.95,Default,Lily,0,0,0,,Aku hampir yakin, mengingat bagaimana dia berperilaku selama berburu.
Dialog: 0,0:08:02.65,0:08:05.85,Default,Lily,0,0,0,,Namun, Hwajin sudah lama tidak datang ke Daejojon.
Dialog: 0,0:08:06.19,0:08:08.79,Default,Lily,0,0,0,,Metode menunjuk ke Ibu Suri.
Dialog: 0,0:08:10.36,0:08:11.52,Default,Lily,0,0,0,,Di Sini.
Dialog: 0,0:08:13.66,0:08:16.36,Default,Lily,0,0,0,,Dia sering datang ke sini dengan curiga akhir-akhir ini.
Dialog: 0,0:08:17.50,0:08:19.40,Default,Lily,0,0,0,,Tentu saja, dia juga punya motif.
Dialog: 0,0:08:20.50,0:08:21.80,Default,Lily,0,0,0,,Apakah ini Ibu Suri?
Dialogue: 0,0:08:22.24,0:08:23.80,Default,Lily,0,0,0,,Tikus kecil ini.
Dialogue: 0,0:08:24.54,0:08:29.64,Default,Lily,0,0,0,,Bagaimana Ibu Suri mendapatkan buku besarnya?
Dialog: 0,0:08:32.18,0:08:35.68,Default,Lily,0,0,0,,Itulah misterinya.
Dialog: 0,0:08:36.15,0:08:40.59,Default,Lily,0,0,0,,Lebih penting lagi, buku besar macam apa ini?
Dialog: 0,0:09:02.84,0:09:04.91,Default,Lily,0,0,0,,Hari ini saya tidak melakukan ritual tersebut.
Dialog: 0,0:09:04.91,0:09:07.35,Default,Lily,0,0,0,,Saya minta maaf atas perilaku kasar saya.
Dialog: 0,0:09:09.02,0:09:11.38,Default,Lily,0,0,0,,Anda meminta maaf karena suatu alasan.
Dialogue: 0,0:09:12.35,0:09:13.89,Default,Lily,0,0,0,,Apa alasannya?
Dialog: 0,0:09:14.82,0:09:16.66,Default,Lily,0,0,0,,Seperti yang kuharapkan,
Dialog: 0,0:09:17.92,0:09:19.96,Default,Lily,0,0,0,,Anda memahami semuanya dengan cepat.
Dialog: 0,0:09:27.53,0:09:31.37,Default,Lily,0,0,0,,Terima kasih telah berpartisipasi dalam pertemuan yang tidak menyenangkan ini.
Dialog: 0,0:09:35.11,0:09:37.74,Default,Lily,0,0,0,,Saya yakin Anda mengerti mengingat kejadian baru-baru ini,
Dialog: 0,0:09:37.74,0:09:39.51,Default,Lily,0,0,0,,bahwa waktunya telah tiba untuk kaum bangsawan
Dialog: 0,0:09:39.51,0:09:41.31,Default,Lily,0,0,0,,satukan keluarga.
Dialog: 0,0:09:42.25,0:09:43.52,Default,Lily,0,0,0,,Kita terhubung erat.
Dialog: 0,0:09:44.75,0:09:46.89,Default,Lily,0,0,0,,Jika salah satu dari dua keluarga jatuh,
Dialog: 0,0:09:47.22,0:09:49.32,Default,Lily,0,0,0,,lainnya tidak akan bertahan.
Dialog: 0,0:09:52.66,0:09:57.10,Default,Lily,0,0,0,,Oleh karena itu, saya mengusulkan untuk mengeluarkan keputusan tentang amnesti,
Dialog: 0,0:09:57.96,0:09:59.50,Default,Lily,0,0,0,,sebagai jaminan keharmonisan dalam hubungan.
Dialog: 0,0:10:00.87,0:10:02.07,Default,Lily,0,0,0,,Dekrit?
Dialog: 0,0:10:02.07,0:10:04.30,Default,Lily,0,0,0,,Banyak talenta dari kedua keluarga
Dialog: 0,0:10:04.30,0:10:07.34,Default,Lily,0,0,0,,kehilangan postingan karena kesalahan sesaat.
Dialog: 0,0:10:07.84,0:10:11.44,Default,Lily,0,0,0,,Kami akan mengeluarkan keputusan amnesti untuk mengampuni orang-orang ini.
Dialog: 0,0:10:12.55,0:10:15.52,Default,Lily,0,0,0,,Dengan kata lain, itu adalah simbol janji
Dialog: 0,0:10:15.52,0:10:17.05,Default,Lily,0,0,0,,dan hadiah ucapan selamat.
Dialog: 0,0:10:17.55,0:10:18.69,Default,Lily,0,0,0,,Bagaimana menurut anda?
Dialog: 0,0:10:20.39,0:10:22.16,Default,Lily,0,0,0,,Dukung saya dalam hal ini?
Dialog: 0,0:10:50.32,0:10:54.22,Default,Lily,0,0,0,,Departemen Perang menggunakan trik kotor untuk memuaskan keserakahannya,
Dialog: 0,0:10:54.22,0:10:58.26,Default,Lily,0,0,0,,dan aku bersalah karena tidak mampu menundukkannya.
Dialog: 0,0:10:58.89,0:11:01.59,Default,Lily,0,0,0,,Dalam hal ini, saya, Kim Jwageun,
Dialog: 0,0:11:02.40,0:11:05.53,Default,Lily,0,0,0,,Saya meminta pengunduran diri dari jabatan saya.
Dialog: 0,0:11:11.94,0:11:14.44,Default,Lily,0,0,0,,Ini belum berakhir bagiku.
Dialog: 0,0:11:14.87,0:11:16.84,Default,Lily,0,0,0,,Ini tidak akan berakhir selagi aku bernapas.
Dialog: 0,0:11:37.66,0:11:39.13,Default,Lily,0,0,0,,Makan pelan-pelan.
Dialog: 0,0:11:41.47,0:11:43.04,Default,Lily,0,0,0,,Apakah camilannya cukup?
Dialogue: 0,0:11:52.35,0:11:56.25,Default,Lily,0,0,0,,Aku tidak boleh makan jika masih ada sedikit rasa malu di dalam diriku.
Dialogue: 0,0:12:00.52,0:12:02.29,Default,Lily,0,0,0,,Jadi kenapa kamu kabur?
Dialogue: 0,0:12:02.76,0:12:06.23,Default,Lily,0,0,0,,Aku memperlakukanmu dengan baik.
Dialog: 0,0:12:09.10,0:12:10.30,Default,Lily,0,0,0,,Masalahnya...
Dialog: 0,0:12:18.54,0:12:20.37,Default,Lily,0,0,0,,Bu.
Dialog: 0,0:12:21.91,0:12:23.18,Default,Lily,0,0,0,,Bu.
Dialog: 0,0:12:23.58,0:12:24.71,Default,Lily,0,0,0,,Tuhan.
Dialog: 0,0:12:27.38,0:12:29.15,Default,Lily,0,0,0,,Kamu sudah cukup menderita, Damhyan.
Dialog: 0,0:12:29.82,0:12:31.75,Default,Lily,0,0,0,,Sulit bagimu.
Dialog: 0,0:12:43.13,0:12:44.50,Default,Lily,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:12:47.17,0:12:48.30,Default,Lily,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:12:56.64,0:12:59.08,Default,Lily,0,0,0,,Kami mencoba tersenyum di depannya.
Dialog: 0,0:12:59.61,0:13:01.58,Default,Lily,0,0,0,,Yang Mulia tidak seharusnya
Dialog: 0,0:13:01.58,0:13:03.32,Default,Lily,0,0,0,,menjadi sedih untuk waktu yang lama.
Dialog: 0,0:13:03.98,0:13:05.02,Default,Lily,0,0,0,,Ya.
Dialog: 0,0:13:20.80,0:13:24.64,Default,Lily,0,0,0,,Yang Mulia. Saatnya untuk bangun.
Dialog: 0,0:13:33.55,0:13:34.75,Default,Lily,0,0,0,,Yang Mulia.
Dialogue: 0,0:13:36.25,0:13:39.19,Default,Lily,0,0,0,,Kamu tidak bisa tidur tadi malam?
Dialogue: 0,0:13:40.19,0:13:43.16,Default,Lily,0,0,0,,Aku khawatir kamu akan mendapat masalah.
Dialogue: 0,0:13:44.72,0:13:48.59,Default,Lily,0,0,0,,Terlalu banyak pikiran, aku tidak bisa tidur.
Dialogue: 0,0:13:50.86,0:13:53.27,Default,Lily,0,0,0,,Ngomong-ngomong, apakah mereka tidur nyenyak?
Dialog: 0,0:13:54.03,0:13:55.54,Default,Lily,0,0,0,,Siapa?
Dialog: 0,0:13:55.54,0:13:57.74,Default,Lily,0,0,0,,Orang-orang yang mencoba menghancurkan hidupku.
Dialog: 0,0:13:58.20,0:14:00.64,Default,Lily,0,0,0,,Itu adalah tidur damai terakhir mereka.
Dialogue: 0,0:14:01.04,0:14:02.61,Default,Lily,0,0,0,,Kuharap mereka cukup tidur.
Dialog: 0,0:14:05.75,0:14:07.41,Default,Lily,0,0,0,,-Nyonya Choi.\N-Ya.
Dialog: 0,0:14:07.58,0:14:09.08,Default,Lily,0,0,0,,Kirim seseorang
Dialog: 0,0:14:09.08,0:14:10.98,Default,Lily,0,0,0,,untuk ayahku, biarkan dia datang ke istana.
Dialog: 0,0:14:11.12,0:14:12.35,Default,Lily,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:14:23.70,0:14:24.83,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:14:25.37,0:14:28.00,Default,Lily,0,0,0,,Ayahmu telah datang.
Dialog: 0,0:14:28.97,0:14:29.97,Default,Lily,0,0,0,,Sudah?
Dialog: 0,0:14:34.91,0:14:38.11,Default,Lily,0,0,0,,Tadinya aku akan memintamu datang ke istana.
Dialog: 0,0:14:39.15,0:14:41.98,Default,Lily,0,0,0,,Tapi kamu sudah sampai.
Dialog: 0,0:14:41.98,0:14:43.08,Default,Lily,0,0,0,,Ya.
Dialogue: 0,0:14:45.32,0:14:47.72,Default,Lily,0,0,0,,Sepertinya aku datang karena suatu alasan.
Dialog: 0,0:14:51.79,0:14:53.19,Default,Lily,0,0,0,,-Terakhir kali...\N-Terakhir kali...
Dialog: 0,0:14:54.13,0:14:55.43,Default,Lily,0,0,0,,Kamu bicara dulu.
Dialog: 0,0:14:55.43,0:14:57.33,Default,Lily,0,0,0,,Tidak. Anda berbicara.
Dialog: 0,0:14:57.33,0:14:59.77,Default,Lily,0,0,0,,Tidak. Anda berbicara dulu.
Dialogue: 0,0:15:05.14,0:15:06.71,Default,Lily,0,0,0,,-Maaf soal waktu itu.\N-Maaf soal waktu itu.
Dialog: 0,0:15:06.71,0:15:08.64,Default,Lily,0,0,0,,-Tidak. Pertama, saya akan minta maaf.\N-Tidak. Aku duluan.
Dialog: 0,0:15:08.64,0:15:10.01,Default,Lily,0,0,0,,-Aku duluan.\N-Tidak, aku.
Dialog: 0,0:15:10.01,0:15:11.28,Default,Lily,0,0,0,,-Tuhan.\N-Aku dulu.
Dialog: 0,0:15:21.19,0:15:23.26,Default,Lily,0,0,0,,Ya, darah bukanlah air.
Dialog: 0,0:15:24.66,0:15:25.96,Default,Lily,0,0,0,,Tepat.
Dialog: 0,0:15:28.06,0:15:31.60,Default,hazelnut,0,0,0,,Saya meneleponmu hari ini
Dialog: 0,0:15:32.87,0:15:34.23,Default,hazelnut,0,0,0,,karena buku besar.
Dialogue: 0,0:15:37.44,0:15:40.24,Default,hazelnut,0,0,0,,-Tahukah kamu?\N-Semua orang jadi gila karena dia.
Dialogue: 0,0:15:40.87,0:15:42.44,Default,hazelnut,0,0,0,,Buku macam apa ini?
Dialog: 0,0:15:46.51,0:15:50.65,Default,hazelnut,0,0,0,,Ini adalah akun aktivitas ilegal klan kami.
Dialogue: 0,0:15:51.32,0:15:53.22,Default,hazelnut,0,0,0,,Titik lemah marga Andong Kim.
Dialogue: 0,0:15:53.42,0:15:56.16,Default,hazelnut,0,0,0,,Itulah sebabnya Cheoljong ingin mendapatkannya.
Dialogue: 0,0:15:56.16,0:16:00.26,Default,hazelnut,0,0,0,,Hari ini aku datang untuk membicarakan dia.
Dialogue: 0,0:16:01.19,0:16:04.23,Default,hazelnut,0,0,0,,Setelah kunjunganmu ke raja, dia menghilang.
Dialogue: 0,0:16:04.70,0:16:07.23,Default,hazelnut,0,0,0,,Jadi selama ini aku mencurigai sang raja.
Dialog: 0,0:16:08.30,0:16:09.47,Default,hazelnut,0,0,0,,Tetapi baru-baru ini
Dialog: 0,0:16:09.77,0:16:12.51,Default,hazelnut,0,0,0,,pelayanku yang setia, yang kusayangi, melarikan diri.
Dialogue: 0,0:16:13.47,0:16:16.08,Default,hazelnut,0,0,0,,Untungnya saya menangkapnya dan mengetahui alasannya.
Dialogue: 0,0:16:17.24,0:16:18.91,Default,hazelnut,0,0,0,,Sehari sebelum hilangnya
Dialog: 0,0:16:19.71,0:16:21.78,Default,hazelnut,0,0,0,,dia membiarkan selir Cho masuk.
Dialogue: 0,0:16:23.42,0:16:25.59,Default,hazelnut,0,0,0,,Saat ada keributan di rumah,
Dialog: 0,0:16:25.89,0:16:28.79,Default,hazelnut,0,0,0,,dia mengira semuanya karena dia dan melarikan diri. Oleh karena itu...
Dialog: 0,0:16:30.16,0:16:32.39,Default,hazelnut,0,0,0,,Maaf.
Dialogue: 0,0:16:35.46,0:16:37.80,Default,hazelnut,0,0,0,,Itu bukan salahmu.
Dialog: 0,0:16:39.80,0:16:40.87,Default,hazelnut,0,0,0,,Di Sini
Dialog: 0,0:16:42.17,0:16:44.27,Default,hazelnut,0,0,0,,dan teka-teki kita terpecahkan.
Dialogue: 0,0:16:46.07,0:16:47.14,Default,hazelnut,0,0,0,,Apa?
Dialog: 0,0:16:47.31,0:16:49.98,Default,hazelnut,0,0,0,,Sungwon adalah penggagas pembunuhanku.
Dialogue: 0,0:16:50.94,0:16:53.48,Default,hazelnut,0,0,0,,Saya khusus menyiapkan es,
Dialog: 0,0:16:53.48,0:16:55.98,Default,hazelnut,0,0,0,,yang lebih mahal dari emas saat ini.
Dialog: 0,0:16:58.62,0:17:00.95,Default,hazelnut,0,0,0,,Ibu Suri mengejekku.
Dialogue: 0,0:17:01.39,0:17:03.02,Default,hazelnut,0,0,0,,Aku akan menyajikan makananku padamu suatu hari nanti.
Dialog: 0,0:17:03.02,0:17:04.52,Default,hazelnut,0,0,0,,Saya harus mencobanya sekarang.
Dialog: 0,0:17:09.46,0:17:12.17,Default,hazelnut,0,0,0,,Dan Cho Hwajin menyediakan senjatanya.
Dialog: 0,0:17:12.30,0:17:14.17,Default,hazelnut,0,0,0,,Akui segalanya pada raja.
Dialogue: 0,0:17:14.17,0:17:15.40,Default,hazelnut,0,0,0,,Apakah kamu mengancamku?
Dialog: 0,0:17:16.80,0:17:18.20,Default,hazelnut,0,0,0,,aku kamu
Dialog: 0,0:17:19.44,0:17:20.67,Default,hazelnut,0,0,0,,terdengar jelas.
Dialog: 0,0:17:30.95,0:17:34.62,Default,hazelnut,0,0,0,,Ayah, aku harus pergi ke suatu tempat sekarang.
Dialog: 0,0:17:35.49,0:17:36.56,Default,hazelnut,0,0,0,,Di mana?
Dialogue: 0,0:17:37.62,0:17:40.09,Default,hazelnut,0,0,0,,Buka pintu ke lubang api.
Dialog: 0,0:17:40.86,0:17:45.70,Default,hazelnut,0,0,0,,Anda akan menyesal menghubungi saya.
Dialogue: 0,0:17:51.54,0:17:53.17,Default,hazelnut,0,0,0,,Dia dulu penurut seperti anak domba.
Dialog: 0,0:17:53.61,0:17:56.34,Default,hazelnut,0,0,0,,Dan dalam waktu singkat di sini menjadi kejam.
Dialogue: 0,0:17:57.54,0:18:00.08,Default,hazelnut,0,0,0,,Saya tahu orang tua tidak bisa objektif terhadap anaknya.
Dialogue: 0,0:18:00.31,0:18:01.65,Default,hazelnut,0,0,0,,Tapi seekor domba?
Dialog: 0,0:18:02.58,0:18:04.42,Default,hazelnut,0,0,0,,Jika aku membandingkannya dengan binatang,
Dialog: 0,0:18:04.42,0:18:06.25,Default,hazelnut,0,0,0,,lalu hanya dengan terpal.
Dialogue: 0,0:18:07.55,0:18:10.12,Default,hazelnut,0,0,0,,Putriku Tarpan?
Dialogue: 0,0:18:30.78,0:18:32.25,Default,hazelnut,0,0,0,,Tato Maori.
Dialogue: 0,0:18:33.55,0:18:35.18,Default,hazelnut,0,0,0,,Bulu merak.
Dialogue: 0,0:18:35.78,0:18:37.85,Default,hazelnut,0,0,0,,Dan iblis memakai Prada.
Dialogue: 0,0:18:38.75,0:18:40.65,Default,hazelnut,0,0,0,,Kekuatan dalam keindahan.
Dialogue: 0,0:18:41.42,0:18:46.09,Default,hazelnut,0,0,0,,Hari ini aku punya baju besi terindah.
Dialogue: 0,0:18:47.36,0:18:48.43,Default,hazelnut,0,0,0,,Bagaimana kamu menyukainya?
Dialog: 0,0:18:50.40,0:18:51.43,Default,hazelnut,0,0,0,,Suka.
Dialog: 0,0:18:52.87,0:18:54.93,Default,hazelnut,0,0,0,,Balas dendam rasanya manis jika disajikan dengan kembang api.
Dialogue: 0,0:19:19.43,0:19:21.53,Default,hazelnut,0,0,0,,Apa maksudnya ini?
Dialogue: 0,0:19:22.06,0:19:24.13,Default,hazelnut,0,0,0,,Apa yang kamu lihat bukanlah segalanya.
Dialog: 0,0:19:37.28,0:19:38.88,Default,hazelnut,0,0,0,,Untuk mengetahui isinya,
Dialogue: 0,0:19:38.88,0:19:41.18,Default,hazelnut,0,0,0,,perlu dipotong.
Dialogue: 0,0:19:41.35,0:19:43.52,Default,hazelnut,0,0,0,,Saya pikir itu hanya kentang.
Dialogue: 0,0:19:44.32,0:19:47.22,Default,hazelnut,0,0,0,,Tapi kamu menipuku.
Dialogue: 0,0:19:47.22,0:19:50.02,Default,hazelnut,0,0,0,,Anda tidak boleh kehilangan kepercayaan tanpa alasan yang jelas.
Dialog: 0,0:19:50.32,0:19:53.33,Default,hazelnut,0,0,0,,Sebelum memotong, Anda perlu memastikannya benar.
Dialog: 0,0:19:54.79,0:19:58.56,Default,hazelnut,0,0,0,,Karena setelah itu Anda tidak dapat mengembalikan apa pun.
Dialogue: 0,0:20:00.00,0:20:02.17,Default,hazelnut,0,0,0,,Minumanmu.
Dialog: 0,0:20:20.42,0:20:23.12,Default,hazelnut,0,0,0,,Hari ini saya menyiapkan makan siang,
Dialog: 0,0:20:23.32,0:20:26.43,Default,hazelnut,0,0,0,,terima kasih atas yang baru-baru ini
Dialogue: 0,0:20:26.69,0:20:28.53,Default,hazelnut,0,0,0,,sarapan enak.
Dialogue: 0,0:20:29.96,0:20:33.07,Default,hazelnut,0,0,0,,Minuman dingin di makan siang terakhir sungguh nikmat,
Dialog: 0,0:20:34.27,0:20:36.87,Default,hazelnut,0,0,0,,bahwa aku bahkan tidak menyadari kematian seseorang.
Dialog: 0,0:20:44.88,0:20:46.05,Default,hazelnut,0,0,0,,Cobalah.
Dialogue: 0,0:20:51.28,0:20:53.22,Default,hazelnut,0,0,0,,Aku tidak haus.
Dialogue: 0,0:20:53.22,0:20:55.82,Default,hazelnut,0,0,0,,Aku berusaha keras untuk melakukannya. Minumlah setidaknya sedikit.
Dialog: 0,0:20:55.82,0:20:57.46,Default,hazelnut,0,0,0,,Sudah kubilang aku tidak mau.
Dialog: 0,0:20:59.36,0:21:00.99,Default,hazelnut,0,0,0,,Aku berusaha keras.
Dialog: 0,0:21:03.40,0:21:04.83,Default,hazelnut,0,0,0,,Jika kamu tidak ingin minum...
Dialogue: 0,0:21:23.82,0:21:26.15,Default,hazelnut,0,0,0,,Rasanya lebih enak dengan es.
Dialog: 0,0:21:30.12,0:21:31.86,Default,hazelnut,0,0,0,,Saya katakan sebelumnya bahwa saya akan membantu Anda
Dialog: 0,0:21:32.36,0:21:35.33,Default,hazelnut,0,0,0,,tetap sehat dan awet muda seumur hidupmu.
Dialog: 0,0:21:35.96,0:21:38.50,Default,hazelnut,0,0,0,,Dan saya akan terus melakukannya.
Dialog: 0,0:21:39.17,0:21:42.10,Default,hazelnut,0,0,0,,Jika kamu meragukan makanan, minuman dan segala sesuatu di sekitarnya,
Dialog: 0,0:21:42.94,0:21:44.87,Default,hazelnut,0,0,0,,maka hidup hanya akan menjadi penderitaan.
Dialogue: 0,0:21:45.00,0:21:46.84,Default,hazelnut,0,0,0,,Karena masa pemerintahanku sudah berakhir,
Dialogue: 0,0:21:46.84,0:21:48.81,Default,hazelnut,0,0,0,,kamu pikir kamu bisa melakukan apapun yang kamu mau?
Dialog: 0,0:21:49.28,0:21:50.51,Default,hazelnut,0,0,0,,Kamu pikir kamu akan tinggal
Dialogue: 0,0:21:50.51,0:21:52.68,Default,hazelnut,0,0,0,,seorang ratu tanpa klannya?
Dialogue: 0,0:21:52.68,0:21:54.21,Default,hazelnut,0,0,0,,Janda Ratu.
Dialog: 0,0:21:55.11,0:21:57.25,Default,hazelnut,0,0,0,,Saya tidak bergantung pada klan atau suami saya.
Dialog: 0,0:21:58.32,0:22:00.55,Default,hazelnut,0,0,0,,Saya melakukan apa pun yang saya inginkan karena saya bisa.
Dialog: 0,0:22:09.56,0:22:11.86,Default,hazelnut,0,0,0,,Tepat. Kepala Kasim.
Dialog: 0,0:22:13.13,0:22:14.30,Default,hazelnut,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:22:14.30,0:22:16.74,Default,hazelnut,0,0,0,,Aku mengabaikan tugasku
Dialog: 0,0:22:16.74,0:22:18.70,Default,hazelnut,0,0,0,,menghasilkan ahli waris.
Dialogue: 0,0:22:19.84,0:22:22.68,Default,hazelnut,0,0,0,,Menurutku ini tidak bisa diterima.
Dialog: 0,0:22:23.24,0:22:25.58,Default,hazelnut,0,0,0,,Jadi pergi dan lapor padanya.
Dialog: 0,0:22:27.88,0:22:31.35,Default,hazelnut,0,0,0,,Laporan?
Dialog: 0,0:22:32.18,0:22:35.02,Default,hazelnut,0,0,0,,Saya tidak mengerti apa yang Anda bicarakan, Yang Mulia.
Dialogue: 0,0:22:36.92,0:22:39.26,Default,hazelnut,0,0,0,,Kau tahu, kau selalu melakukan ini.
Dialogue: 0,0:22:43.30,0:22:44.56,Default,hazelnut,0,0,0,,Beraninya kamu?
Dialog: 0,0:22:45.53,0:22:47.17,Default,hazelnut,0,0,0,,Aku harus menghukummu!
Dialog: 0,0:22:49.60,0:22:51.80,Default,hazelnut,0,0,0,,Maafkan saya, Yang Mulia.
Dialogue: 0,0:22:52.17,0:22:54.64,Default,hazelnut,0,0,0,,-Bunuh aku.\N-Ada apa denganmu?
Dialog: 0,0:22:55.47,0:22:57.28,Default,hazelnut,0,0,0,,Aku tidak memberitahumu.
Dialogue: 0,0:23:04.98,0:23:07.65,Default,hazelnut,0,0,0,,Sekarang hidupku ada di tanganmu.
Dialog: 0,0:23:08.32,0:23:10.09,Default,hazelnut,0,0,0,,Saya tidak membutuhkannya.
Dialogue: 0,0:23:10.66,0:23:12.49,Default,hazelnut,0,0,0,,Apa yang harus aku lakukan padanya?
Dialog: 0,0:23:13.29,0:23:16.23,Default,hazelnut,0,0,0,,Tolong bunuh saya, Yang Mulia.
Dialog: 0,0:23:16.23,0:23:18.03,Default,hazelnut,0,0,0,,Tuhan. Saya bilang itu tidak perlu.
Dialog: 0,0:23:22.70,0:23:24.30,Default,hazelnut,0,0,0,,Saya tahu Anda tidak punya pilihan.
Dialog: 0,0:23:24.70,0:23:26.34,Default,hazelnut,0,0,0,,Anda harus mengikuti perintah.
Dialogue: 0,0:23:31.81,0:23:35.81,Default,hazelnut,0,0,0,,Akan lebih baik jika kamu marah padaku.
Dialog: 0,0:23:36.95,0:23:39.62,Default,hazelnut,0,0,0,,Ini lebih buruk.
Dialogue: 0,0:23:42.29,0:23:46.33,Default,hazelnut,0,0,0,,Bagaimana kamu bisa menjadi mata-mata jika kamu begitu mudah takut?
Dialog: 0,0:23:48.86,0:23:51.43,Default,hazelnut,0,0,0,,Saya harus pergi ke suatu tempat sebelum rapat.
Dialog: 0,0:23:52.20,0:23:54.10,Default,hazelnut,0,0,0,,Pergi ke Injeongjeong.
Dialogue: 0,0:23:56.87,0:23:59.64,Default,hazelnut,0,0,0,,Ya Tuhan, bisakah kamu membaca ini di tempat lain?
Dialogue: 0,0:23:59.64,0:24:01.57,Default,hazelnut,0,0,0,,Kepala kasim sangat ketakutan.
Dialogue: 0,0:24:23.16,0:24:24.96,Default,,0,0,0,,Kuharap tidurmu nyenyak.
Dialogue: 0,0:24:26.67,0:24:29.13,Default,,0,0,0,,Jadi kamu menyapa orang yang lebih tua?
Dialogue: 0,0:24:29.94,0:24:32.00,Default,,0,0,0,,Kancingnya sangat berat.
Dialogue: 0,0:24:32.14,0:24:34.01,Default,,0,0,0,,Aku tidak bisa menundukkan kepalaku.
Dialog: 0,0:24:35.54,0:24:38.84,Default,,0,0,0,,Ritual diadakan di tempat suci ini dan leluhur dikenang.
Dialog: 0,0:24:39.11,0:24:42.58,Default,,0,0,0,,Tidak pantas datang ke sini dengan membawa dekorasi.
Dialog: 0,0:24:43.65,0:24:47.25,Default,,0,0,0,,Sebelum mengeluarkan pengembalian, Anda perlu membersihkan bulunya.
Dialogue: 0,0:24:49.22,0:24:50.59,Default,,0,0,0,,Wah, aku benar-benar lupa.
Dialog: 0,0:24:50.86,0:24:53.29,Default,,0,0,0,,Kita perlu menyalakan dupa untuk mendiang raja.
Dialog: 0,0:24:54.73,0:24:58.00,Default,,0,0,0,,Dan bagaimana saya bisa mempermalukan ajaran Chonghak tentang etiket.
Dialog: 0,0:25:03.37,0:25:04.60,Default,,0,0,0,,Berhenti.
Dialog: 0,0:25:04.94,0:25:07.07,Default,,0,0,0,,Saya adalah pengikut setia Konfusianisme.
Dialog: 0,0:25:07.74,0:25:10.01,Default,,0,0,0,,Saya tidak tahan dengan ritual yang tidak terpenuhi.
Dialog: 0,0:25:10.84,0:25:12.18,Default,,0,0,0,,Sudah kubilang jangan menyentuhnya.
Dialogue: 0,0:25:13.68,0:25:15.95,Default,,0,0,0,,Kau meninggalkan sesuatu di kamarku.
Dialogue: 0,0:25:17.98,0:25:20.92,Default,,0,0,0,,Mereka muncul tanpa peringatan dan ikut campur dalam urusanku.
Dialog: 0,0:25:23.56,0:25:25.69,Default,,0,0,0,,Hampir sama seperti sekarang.
Dialog: 0,0:25:26.56,0:25:28.33,Default,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:25:28.96,0:25:31.33,Default,,0,0,0,,Sudah kubilang hal yang sama. Kembali.
Dialog: 0,0:25:32.16,0:25:34.20,Default,,0,0,0,,Saya sangat menderita di sini - saya harus mengembalikan semuanya.
Dialogue: 0,0:25:34.80,0:25:37.80,Default,,0,0,0,,Kata-kata kasar macam apa yang kamu ucapkan?
Dialogue: 0,0:25:38.27,0:25:40.34,Default,,0,0,0,,Fitnah orang yang lebih tua
Dialog: 0,0:25:40.34,0:25:42.47,Default,,0,0,0,,dan mengeluh tentang kehidupan.
Dialog: 0,0:25:43.44,0:25:44.74,Default,,0,0,0,,Kamu selalu seperti ini,
Dialogue: 0,0:25:44.74,0:25:47.58,Default,,0,0,0,,tapi hari ini emosimu sudah melewati batas.
Dialog: 0,0:25:48.38,0:25:52.75,Default,,0,0,0,,Bukankah karena kamu tumbuh tanpa tangan ibu?
Dialog: 0,0:25:53.49,0:25:55.29,Default,,0,0,0,,Hei, ibu mertua.
Dialogue: 0,0:25:57.02,0:25:58.82,Default,,0,0,0,,Kalau aku kasar, karena aku besar tanpa ibu,
Dialog: 0,0:25:59.83,0:26:02.53,Default,,0,0,0,,lalu kamu kurang ajar karena tidak membesarkan anakmu?
Dialog: 0,0:26:04.66,0:26:06.00,Default,,0,0,0,,Panas!
Dialogue: 0,0:26:09.90,0:26:12.47,Default,,0,0,0,,Semuanya sangat mengganggu hingga aku tak tahan panasnya.
Dialog: 0,0:26:13.77,0:26:15.84,Default,,0,0,0,,Potret putra tersayang
Dialog: 0,0:26:15.84,0:26:17.78,Default,,0,0,0,,hampir habis.
Dialog: 0,0:26:18.54,0:26:20.41,Default,,0,0,0,,Apakah kamu sudah gila?
Dialog: 0,0:26:21.18,0:26:23.85,Default,,0,0,0,,Ya, pasti dan tidak dapat dibatalkan.
Dialogue: 0,0:26:24.75,0:26:27.55,Default,,0,0,0,,Dari semua orang gila, akulah yang paling fanatik.
Dialogue: 0,0:26:29.19,0:26:31.06,Default,,0,0,0,,Jadi pergilah dan lihat sekeliling.
Dialogue: 0,0:26:38.76,0:26:41.03,Default,,0,0,0,,Bahkan jika sehelai rambut rontok dari kepalaku,
Dialog: 0,0:26:44.47,0:26:46.84,Default,,0,0,0,,dan kamu tidak akan melihat putramu lagi.
Dialog: 0,0:27:17.49,0:27:20.11,Default,,0,0,0,,Ratu bukanlah orang yang perlu dikhawatirkan,
Dialog: 0,0:27:21.54,0:27:23.31,Default,,0,0,0,,dan tentang yang lainnya.
Dialog: 0,0:27:30.05,0:27:32.85,Default,,0,0,0,,Pertahanan terbaik adalah serangan.
Dialog: 0,0:27:49.74,0:27:53.71,Default,,0,0,0,,Wow, aku tidak menyadari kamu ada di sini juga.
Dialogue: 0,0:27:54.57,0:27:57.48,Default,,0,0,0,,Ada orang hantu.\NMereka berjalan berkeliling dan tidak bersinar.
Dialogue: 0,0:27:58.94,0:28:01.45,Default,,0,0,0,,Aku melempar pancake ke kolam di sini.\NDApakah kamu mau ikut denganku?
Dialogue: 0,0:28:01.45,0:28:02.75,Default,,0,0,0,,Lempar sendiri.
Dialog: 0,0:28:05.18,0:28:06.39,Default,,0,0,0,,Buku akun.
Dialog: 0,0:28:07.85,0:28:09.29,Default,,0,0,0,,Anda mengambilnya.
Dialog: 0,0:28:11.22,0:28:13.73,Default,,0,0,0,,Karena dia, aku hampir mati.
Dialog: 0,0:28:17.50,0:28:18.53,Default,,0,0,0,,Katakan padaku.
Dialog: 0,0:28:20.57,0:28:21.87,Default,,0,0,0,,Apakah kamu mencapai ini?
Dialog: 0,0:28:23.40,0:28:25.67,Default,,0,0,0,,Kamu benar-benar tidak membunuh Ovol?
Dialogue: 0,0:28:27.37,0:28:30.21,Default,,0,0,0,,Tidak peduli apa yang kukatakan, kamu hanya percaya pada apa yang kamu inginkan.
Dialog: 0,0:28:30.21,0:28:32.04,Default,,0,0,0,,Aku harus mengambil raja darimu,
Dialog: 0,0:28:32.04,0:28:34.21,Default,,0,0,0,,bunuh Ovol dan lemparkan tubuhnya ke dalam sumur.
Dialog: 0,0:28:34.21,0:28:36.32,Default,,0,0,0,,Maka aku akan menjadi penjahat yang pantas mati,
Dialog: 0,0:28:37.28,0:28:39.38,Default,,0,0,0,,dan kamu adalah korban yang tidak bersalah, santo.
Dialog: 0,0:28:42.82,0:28:45.39,Default,,0,0,0,,Inilah sebabnya bermain sebagai korban itu berbahaya.
Dialog: 0,0:28:45.49,0:28:47.13,Default,,0,0,0,,Perlahan berubah menjadi monster -
Dialogue: 0,0:28:49.83,0:28:52.06,Default,,0,0,0,,dan kamu sendiri tidak menyadarinya.
Dialog: 0,0:29:08.65,0:29:09.88,Default,,0,0,0,,Lihat ke cermin.
Dialog: 0,0:29:10.65,0:29:12.28,Default,,0,0,0,,Lihat keburukanmu.
Dialog: 0,0:29:32.64,0:29:34.48,Default,,0,0,0,,Tahan dirimu jika ingin keluar.
Dialog: 0,0:29:35.21,0:29:37.61,Default,,0,0,0,,Tidak ada mood untuk berbuat baik.
Dialog: 0,0:29:56.50,0:29:58.63,Default,,0,0,0,,Saat aku jatuh ke air di depan matamu,
Dialog: 0,0:30:00.90,0:30:02.13,Default,,0,0,0,,kemungkinan besar,
Dialog: 0,0:30:04.37,0:30:06.44,Default,,0,0,0,,kamu bisa saja mengulurkan tanganmu kepadaku.
Dialog: 0,0:30:11.94,0:30:13.05,Default,,0,0,0,,Ini membuktikan
Dialog: 0,0:30:14.25,0:30:16.88,Default,,0,0,0,,bahwa sebagai pribadi aku lebih baik darimu.
Dialog: 0,0:30:31.53,0:30:33.60,Default,,0,0,0,,Kim Jwageun, komandan pasukan,
Dialogue: 0,0:30:35.10,0:30:37.10,Default,,0,0,0,,meninggalkan postingannya.
Dialog: 0,0:30:38.10,0:30:39.37,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:30:40.01,0:30:41.84,Default,,0,0,0,,Pengunduran diri ditunda,
Dialog: 0,0:30:41.84,0:30:44.24,Default,,0,0,0,,kalian semua bisa bertobat untuk ini.
Dialogue: 0,0:30:45.11,0:30:46.18,Default,,0,0,0,,Sayang sekali.
Dialog: 0,0:30:49.15,0:30:51.12,Default,,0,0,0,,Tunggu, saya salah bicara.
Dialog: 0,0:30:51.78,0:30:53.32,Default,,0,0,0,,Lega sekali.
Dialog: 0,0:30:57.72,0:30:59.16,Default,,0,0,0,,Pertanyaan berikutnya.
Dialog: 0,0:30:59.16,0:31:02.56,Default,,0,0,0,,Tapi pertama-tama aku ingin mengumumkan sesuatu.
Dialog: 0,0:31:04.70,0:31:07.67,Default,,0,0,0,,Saya akan membuat lembaga yang akan menangani sistem tiga pajak.
Dialog: 0,0:31:07.80,0:31:11.10,Default,,0,0,0,,Ini akan disebut Samjeong Lijeongjeon.
Dialog: 0,0:31:11.77,0:31:14.61,Default,,0,0,0,,Samjeong lijongjeong?
Dialogue: 0,0:31:16.21,0:31:18.34,Default,,0,0,0,,Ini akan menciptakan hukum
Dialog: 0,0:31:18.34,0:31:20.38,Default,,0,0,0,,dan akan mengembangkan rencana untuk menyelesaikannya
Dialog: 0,0:31:20.51,0:31:22.78,Default,,0,0,0,,kekurangan utama sistem tiga pajak.
Dialogue: 0,0:31:25.55,0:31:27.85,Default,,0,0,0,,Negara ini hidup dari pertanian.
Dialogue: 0,0:31:28.69,0:31:30.62,Default,,0,0,0,,Para petani makmur, begitu pula dia.
Dialog: 0,0:31:30.76,0:31:33.83,Default,,0,0,0,,Pejabat menipu petani biasa,
Dialog: 0,0:31:33.83,0:31:35.76,Default,,0,0,0,,- ancaman terhadap negara.
Dialog: 0,0:31:36.36,0:31:39.70,Default,,0,0,0,,Kekejaman mereka akan dianggap sebagai pengkhianatan.
Dialog: 0,0:31:40.07,0:31:43.50,Default,,0,0,0,,Sebelum membuat departemen baru\NAnda perlu mempelajari semuanya dengan cermat.
Dialogue: 0,0:31:44.10,0:31:46.51,Default,,0,0,0,,Setidaknya dengarkan pendapat kami sebelum...
Dialogue: 0,0:31:46.51,0:31:50.08,Default,,0,0,0,,Saya tidak akan memberikan kelonggaran,\Nmelakukan apa yang harus saya lakukan.
Dialog: 0,0:31:51.41,0:31:52.48,Default,,0,0,0,,Artinya,
Dialogue: 0,0:31:53.31,0:31:55.95,Default,,0,0,0,,bahwa pendapatmu tidak penting lagi.
Dialog: 0,0:32:03.22,0:32:05.99,Default,,0,0,0,,Saya juga akan memberikan kepada mendiang Raja Seongjong
Dialog: 0,0:32:06.86,0:32:10.60,Default,,0,0,0,,Nama anumerta Sunjo, sesuai tradisi.
Dialog: 0,0:32:17.17,0:32:20.37,Default,,0,0,0,,Yang Mulia lebih tegas dari biasanya hari ini.
Dialog: 0,0:32:27.05,0:32:28.25,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:32:28.85,0:32:31.02,Default,,0,0,0,,Ada janji baru hari ini.
Dialog: 0,0:32:31.92,0:32:33.95,Default,,0,0,0,,Sekretaris utama salah bicara.
Dialog: 0,0:32:34.62,0:32:36.42,Default,,0,0,0,,Kita berbicara tentang mengusulkan pencalonan.
Dialog: 0,0:32:37.72,0:32:40.29,Default,,0,0,0,,Tempat Menteri Perang gratis.
Dialog: 0,0:32:41.06,0:32:44.50,Default,,0,0,0,,Tentara yang lemah akan menyebabkan krisis di seluruh negeri.
Dialog: 0,0:32:44.50,0:32:46.80,Default,,0,0,0,,Jadi saya bersikeras agar Anda menyetujuinya
Dialog: 0,0:32:46.80,0:32:49.47,Default,,0,0,0,,kandidat dipilih oleh dewan militer.
Dialog: 0,0:32:50.97,0:32:52.57,Default,,0,0,0,,Menteri Perang akan datang.
Dialog: 0,0:33:15.86,0:33:17.60,Default,,0,0,0,,Kim Byonin, Menteri Perang,
Dialog: 0,0:33:20.47,0:33:21.94,Default,,0,0,0,,sapa Yang Mulia.
Dialog: 0,0:33:35.75,0:33:39.12,Default,,0,0,0,,Kim Byunin bisa berbahaya - dia didukung oleh keluarga Cho.
Dialog: 0,0:33:40.39,0:33:41.59,Default,,0,0,0,,Dan Cho, dan Kim
Dialog: 0,0:33:41.59,0:33:43.82,Default,,0,0,0,,memintanya.
Dialogue: 0,0:33:43.96,0:33:45.62,Default,,0,0,0,,Ini pasti ulahnya juga.
Dialog: 0,0:33:48.39,0:33:50.83,Default,,0,0,0,,Saya rasa kita tidak bisa menutup mata terhadap permintaan mereka.
Dialogue: 0,0:33:50.83,0:33:54.57,Default,,0,0,0,,Ini bisa memberikan alasan bagi bangsawan untuk memberontak.
Dialogue: 0,0:33:57.04,0:33:58.54,Default,,0,0,0,,Sekarang kamu bebas melakukannya,
Dialog: 0,0:33:58.54,0:34:00.31,Default,,0,0,0,,apapun yang kamu inginkan.
Dialog: 0,0:34:00.31,0:34:02.21,Default,,0,0,0,,Tetapi masih sulit menghentikan serangan mereka.
Dialog: 0,0:34:02.21,0:34:05.11,Default,,0,0,0,,Pertahanan terbaik adalah serangan.
Dialog: 0,0:34:05.61,0:34:07.01,Default,,0,0,0,,Harus diserang
Dialog: 0,0:34:07.01,0:34:09.88,Default,,0,0,0,,lebih cepat dari lawan.
Dialog: 0,0:34:11.45,0:34:13.19,Default,,0,0,0,,Tidak ada waktu untuk merekrut lebih banyak tentara.
Dialog: 0,0:34:13.82,0:34:16.25,Default,,0,0,0,,Aku ingin kamu menjaga Lijonchon.
Dialogue: 0,0:34:16.42,0:34:18.62,Default,,0,0,0,,Hon, aku akan mengirimkanmu
Dialog: 0,0:34:18.62,0:34:20.09,Default,,0,0,0,,ke 3 kota di selatan.
Dialog: 0,0:34:20.09,0:34:22.56,Default,,0,0,0,,Orang-orang di sana marah - mulai penyelidikan.
Dialogue: 0,0:34:24.30,0:34:25.60,Default,,0,0,0,,Perjalanan bisnis lagi?
Dialog: 0,0:34:29.60,0:34:30.80,Default,,0,0,0,,Yah, demi aku.
Dialogue: 0,0:34:32.17,0:34:36.01,Default,,0,0,0,,Semakin jauh ke dalam hutan, semakin kalian berdua duduk di sini dan memberi perintah.
Dialogue: 0,0:34:36.01,0:34:38.84,Default,,0,0,0,,Sepertinya semua yang berjalan ada pada saya. Atau apakah saya salah?
Dialogue: 0,0:34:38.84,0:34:41.35,Default,,0,0,0,,Tidak hanya padamu. saya selalu...
Dialog: 0,0:34:43.68,0:34:45.28,Default,,0,0,0,,Setelah selesai menyelidiki,
Dialogue: 0,0:34:46.52,0:34:48.79,Default,,0,0,0,,-Aku bisa memberimu liburan.\N-Aku berangkat.
Dialog: 0,0:34:49.15,0:34:51.32,Default,,0,0,0,,Saya bisa.
Dialog: 0,0:34:51.56,0:34:53.26,Default,,0,0,0,,Saya bilang bisa.
Dialog: 0,0:34:53.26,0:34:55.56,Default,,0,0,0,,Aku ragu dia mendengarnya.
Dialogue: 0,0:34:55.89,0:34:57.40,Default,,0,0,0,,Bodoh sekali.
Dialog: 0,0:35:02.50,0:35:03.77,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:35:04.20,0:35:07.01,Default,,0,0,0,,Anda punya surat.
Dialog: 0,0:35:09.34,0:35:11.18,Default,,0,0,0,,Aku tidak akan membunuhmu, mendekatlah.
Dialog: 0,0:35:18.55,0:35:22.62,Default,,0,0,0,,Ratu telah mengirimimu surat.
Dialog: 0,0:35:25.79,0:35:27.63,Default,,0,0,0,,Apakah kamu sakit?
Dialog: 0,0:35:31.36,0:35:32.70,Default,,0,0,0,,Gemetar seperti daun musim gugur.
Dialogue: 0,0:35:36.54,0:35:41.21,Default,,0,0,0,,Balas dendam tidak seperti yang kukira.\NISeharusnya lebih menyenangkan.
Dialog: 0,0:35:47.11,0:35:48.55,Default,,0,0,0,,Seru sekali.
Dialogue: 0,0:35:49.41,0:35:50.45,Default,,0,0,0,, Seluruh tubuhku gemetar.
Dialog: 0,0:35:57.86,0:35:59.02,Default,,0,0,0,,Yang Mulia...
Dialog: 0,0:36:06.80,0:36:07.80,Default,,0,0,0,,Anda telah tiba.
Dialog: 0,0:36:13.54,0:36:16.64,Default,,0,0,0,,Hari ini kamu sangat cantik.
Dialogue: 0,0:36:17.28,0:36:18.78,Default,,0,0,0,,Sangat cocok untukmu.
Dialogue: 0,0:36:18.94,0:36:20.81,Default,,0,0,0,,Semuanya cocok dengan wajah cantik.
Dialogue: 0,0:36:20.81,0:36:22.58,Default,,0,0,0,,Aku akan tetap cantik meski terbuang.
Dialog: 0,0:36:23.98,0:36:26.32,Default,,0,0,0,,Siapa sangka aku akan menjadi ratu yang hebat.
Dialogue: 0,0:36:29.79,0:36:31.96,Default,,0,0,0,,Aku tidak akan pernah terbiasa dengan ini.
Dialog: 0,0:36:33.19,0:36:34.99,Default,,0,0,0,,Saya minta bertemu,
Dialog: 0,0:36:37.00,0:36:38.23,Default,,0,0,0,,untuk mengusulkan aliansi.
Dialog: 0,0:36:39.60,0:36:42.49,Default,,0,0,0,,Rod mungkin meninggalkanku,\Nberpikir bahwa sekarang aku berada di waktu yang sama denganmu.
Dialog: 0,0:36:42.87,0:36:44.20,Default,,0,0,0,,Saya tidak akan rugi apa pun.
Dialog: 0,0:36:44.50,0:36:46.40,Default,,0,0,0,,Jika kamu memilih pihakku,
Dialog: 0,0:36:46.77,0:36:48.84,Default,,0,0,0,,keluarga Kim akan menjadi musuhmu.
Dialogue: 0,0:36:48.84,0:36:50.58,Default,,0,0,0,,Mereka selingkuh duluan.
Dialog: 0,0:36:50.98,0:36:52.74,Default,,0,0,0,,Sekarang saya akan membuangnya.
Dialogue: 0,0:36:53.41,0:36:55.04,Default,,0,0,0,,Musuh bersama bukan alasan untuk bersatu?
Dialog: 0,0:37:05.82,0:37:06.86,Default,,0,0,0,,Ya.
Dialog: 0,0:37:09.19,0:37:12.46,Default,,0,0,0,,Tidak ada jarak sosial mulai sekarang.
Dialog: 0,0:37:12.73,0:37:15.07,Default,,0,0,0,,Tentu saja. Anda bisa menyentuh semuanya.
Dialog: 0,0:37:19.30,0:37:20.54,Default,,0,0,0,,Dalam film tentang bandit
Dialogue: 0,0:37:20.54,0:37:22.84,Default,,0,0,0,,Aku melihat temanku mencampur darah dalam cangkir dan minum.
Dialogue: 0,0:37:23.14,0:37:25.88,Default,,0,0,0,,Tetapi darah entah bagaimana tidak higienis.
Dialogue: 0,0:37:26.51,0:37:28.81,Default,,0,0,0,,Mari kita rayakan persatuan kita dengan teh.
Dialog: 0,0:37:28.81,0:37:29.95,Default,,0,0,0,,Sederhana dan enak.
Dialog: 0,0:37:37.99,0:37:39.02,Default,,0,0,0,,Apa?
Dialog: 0,0:37:41.66,0:37:44.13,Default,,0,0,0,,Inikah cara sekutu minum?
Dialog: 0,0:37:44.13,0:37:46.03,Default,,0,0,0,,Ya, untuk persaudaraan.
Dialog: 0,0:37:46.03,0:37:48.40,Default,,0,0,0,,-Ke bawah.\N-Apa...
Dialog: 0,0:37:54.94,0:37:58.38,Default,,0,0,0,,Karena kita bersaudara, mari kita perjelas semuanya.
Dialog: 0,0:37:59.21,0:38:00.58,Default,,0,0,0,,Kenapa kamu ingin membunuhku?
Dialog: 0,0:38:03.35,0:38:04.38,Default,,0,0,0,,Benar.
Dialog: 0,0:38:05.75,0:38:07.95,Default,,0,0,0,,Ini layak untuk didiskusikan.
Dialog: 0,0:38:09.89,0:38:11.76,Default,,0,0,0,,Kami pikir Anda mendengar percakapan kami
Dialog: 0,0:38:11.76,0:38:13.49,Default,,0,0,0,,tentang percobaan pembunuhan terhadap ayahmu.
Dialog: 0,0:38:14.86,0:38:16.66,Default,,0,0,0,,Dia masih ayah mertuamu.
Dialog: 0,0:38:16.83,0:38:19.66,Default,,0,0,0,,Bagi saya, dia adalah salah satu pejabat yang korup.
Dialog: 0,0:38:19.93,0:38:21.30,Default,,0,0,0,,Tak berperasaan.
Dialog: 0,0:38:21.87,0:38:24.00,Default,,0,0,0,,Semuanya jelas bagimu.\NDan dia tidak menyayangkan istrinya sendiri.
Dialog: 0,0:38:24.30,0:38:25.74,Default,,0,0,0,,Pembunuh berantai Kimov.
Dialog: 0,0:38:26.74,0:38:27.87,Default,,0,0,0,,Maaf.
Dialog: 0,0:38:28.81,0:38:30.81,Default,,0,0,0,,Saya tahu permintaan maaf saya tidak akan banyak berubah,
Dialog: 0,0:38:31.91,0:38:34.05,Default,,0,0,0,,tapi ada begitu banyak kesalahpahaman di antara kami.
Dialog: 0,0:38:35.15,0:38:36.15,Default,,0,0,0,,Oke.
Dialog: 0,0:38:37.02,0:38:38.58,Default,,0,0,0,,Kamu akan berhutang padaku.
Dialog: 0,0:38:38.58,0:38:40.29,Default,,0,0,0,,Aku tidak akan memaafkanmu sampai kamu membalas budi.
Dialog: 0,0:38:42.29,0:38:43.89,Default,menembak,0,0,0,,Jadi apa yang kamu inginkan?
Dialogue: 0,0:38:44.26,0:38:45.36,Default,menembak,0,0,0,,Memperkuat kekuatanmu?
Dialogue: 0,0:38:45.36,0:38:49.63,Default,menembak,0,0,0,,Ini hanya cara untuk memulihkan negara kita yang hancur.
Dialogue: 0,0:38:50.73,0:38:53.40,Default,shooting,0,0,0,,Menurutku fondasi masyarakat tidak bisa diubah dengan mudah.
Dialog: 0,0:38:53.97,0:38:56.53,Default,menembak,0,0,0,,Sejujurnya, saya lebih menyukai metodenya daripada tujuannya.
Dialog: 0,0:38:56.84,0:38:58.77,Default,menembak,0,0,0,,Jika kamu memperkuat kekuatanmu,
Dialogue: 0,0:38:59.34,0:39:01.14,Default,shooting gallery,0,0,0,,maka tidak akan ada seorang pun yang bisa mendekatiku.
Dialog: 0,0:39:02.71,0:39:05.24,Default,menembak,0,0,0,,Saya sangat sadar akan ketakutan akan kematian.
Dialogue: 0,0:39:06.21,0:39:10.01,Default,menembak,0,0,0,,Saya tahu kamu tidak sopan,\Ntapi kamu pasti takut.
Dialog: 0,0:39:10.68,0:39:11.68,Default,menembak,0,0,0,,Saya tidak tahu.
Dialogue: 0,0:39:12.15,0:39:14.05,Default,shooting gallery,0,0,0,,Mungkin karena dia sudah sekarat?
Dialogue: 0,0:39:14.05,0:39:15.85,Default,menembak,0,0,0,,Bagiku, pengabaian lebih buruk daripada kematian.
Dialogue: 0,0:39:16.79,0:39:20.19,Default,menembak,0,0,0,,Jika aku bisa menghajar semua orang yang meremehkanku,
Dialog: 0,0:39:21.69,0:39:23.50,Default,menembak,0,0,0,,maka aku akan mati sambil tersenyum.
Dialog: 0,0:39:26.10,0:39:27.17,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:39:27.57,0:39:30.10,Default,menembak,0,0,0,,Saatnya memasak makan malam.
Dialog: 0,0:39:30.10,0:39:32.34,Default,menembak,0,0,0,,Ya. Kalau begitu
Dialogue: 0,0:39:33.94,0:39:35.34,Default,menembak,0,0,0,,Aku tinggalkan kamu.
Dialogue: 0,0:39:52.46,0:39:54.39,Default,menembak,0,0,0,,Aku akan mati sambil tersenyum.
Dialogue: 0,0:39:55.36,0:39:56.86,Default,menembak,0,0,0,,"Aku akan mati sambil tersenyum."
Dialog: 0,0:40:13.58,0:40:16.41,Default,menembak,0,0,0,,-Mr. Kim.\N-Byonin.
Dialog: 0,0:40:17.18,0:40:19.82,Default,menembak,0,0,0,,Yaitu, Menteri Perang.
Dialog: 0,0:40:20.49,0:40:23.35,Default,galeri tembak,0,0,0,,-Apakah kamu bercanda?\N-Siapa kamu, tentu saja tidak.
Dialog: 0,0:40:23.76,0:40:25.52,Default,menembak,0,0,0,,Tolong hubungi saya dengan nama.
Dialogue: 0,0:40:25.76,0:40:28.09,Default,shooting gallery,0,0,0,,Sebenarnya, aku sedang menunggumu,
Dialog: 0,0:40:29.19,0:40:32.40,Default,menembak,0,0,0,,karena aku ingin berbicara denganmu tentang ratu.
Dialog: 0,0:40:33.63,0:40:37.87,Default,menembak,0,0,0,,Ngomong-ngomong, ada sesuatu yang ingin kuberitahukan padamu tentang hal itu.
Dialog: 0,0:40:49.28,0:40:51.82,Default,jarak tembak,0,0,0,,Di mana aku menaruh ini?
Dialog: 0,0:40:52.42,0:40:54.85,Default,galeri tembak,0,0,0,,Kemana?
Dialog: 0,0:40:57.19,0:41:00.19,Default, galeri menembak,0,0,0,,-Tunggu.\N-Saya melihatnya.
Dialog: 0,0:41:05.66,0:41:06.66,Default,menembak,0,0,0,,Kamu!
Dialog: 0,0:41:07.20,0:41:10.74,Default,menembak,0,0,0,,Beraninya kamu menggunakan pisau? \NAnda sudah berada di sini selama hampir seminggu.
Dialog: 0,0:41:13.20,0:41:15.07,Default,menembak,0,0,0,,Sekarang semuanya telah berubah.
Dialog: 0,0:41:15.07,0:41:19.64,Default,tira,0,0,0,,Akhir-akhir ini, juru masak menolak minum makgeolli sepulang kerja.
Dialog: 0,0:41:19.64,0:41:22.01,Default,menembak,0,0,0,,Mereka terus-menerus mengatakan "tidak" dan "tidak".
Dialog: 0,0:41:22.01,0:41:24.82,Default,menembak,0,0,0,,Saya bilang akan mentraktir mereka, tapi mereka tetap menolak.
Dialog: 0,0:41:24.82,0:41:25.82,Default,menembak,0,0,0,,Pergi dan pahami.
Dialog: 0,0:41:26.35,0:41:30.86,Default,menembak,0,0,0,,Aku juga tidak mengerti dayang-dayang ini.
Dialogue: 0,0:41:31.76,0:41:35.89,Default,dash,0,0,0,,Menyuruh mereka datang belakangan, dan mereka benar-benar datang belakangan.
Dialogue: 0,0:41:35.89,0:41:38.73,Default,menembak,0,0,0,,Mereka seharusnya tiba lebih dulu.
Dialogue: 0,0:41:39.50,0:41:41.17,Default,menembak,0,0,0,,-Nah, anak-anak seperti apa yang telah mereka tinggalkan.\N-Nah, anak-anak seperti apa yang telah pergi.
Dialog: 0,0:41:44.84,0:41:45.97,Default,galeri tembak,0,0,0,,Ke aula Dongmyeongjong.
Dialog: 0,0:41:53.61,0:41:54.61,Default,galeri tembak,0,0,0,,Astaga.
Dialog: 0,0:41:55.65,0:41:57.68,Default,galeri tembak,0,0,0,,Satu lagi yang harus dibalas.
Dialogue: 0,0:41:58.38,0:41:59.58,Default,menembak,0,0,0,,Resep balas dendam?
Dialog: 0,0:42:03.92,0:42:06.06,Default,menembak,0,0,0,,Saya bisa menjawabnya sama, kan?
Dialog: 0,0:42:06.62,0:42:08.46,Default,menembak,0,0,0,,Mata ganti mata. Gigi ganti gigi.
Dialog: 0,0:42:08.86,0:42:10.40,Default,menembak,0,0,0,,Maskulinitas untuk martabat pria.
Dialog: 0,0:42:11.80,0:42:14.20,Default,tyra,0,0,0,,Lalu pakis?
Dialog: 0,0:42:15.70,0:42:17.57,Default,tyra,0,0,0,,-Tanaman manik-manik?\N-Pakis dan tanaman manik-manik.
Dialog: 0,0:42:17.57,0:42:19.87,Default,tyra,0,0,0,,Resep ini memiliki banyak bahan bermanfaat.
Dialog: 0,0:42:20.31,0:42:22.27,Default,menembak,0,0,0,,Jadi aku akan terus maju menuju tujuanku.
Dialog: 0,0:42:22.61,0:42:24.18,Default,menembak,0,0,0,,Ini terlalu panjang.
Dialog: 0,0:42:26.44,0:42:27.71,Default,galeri tembak,0,0,0,,Ayo masuk semuanya.
Dialog: 0,0:42:30.01,0:42:31.98,Default,menembak,0,0,0,,-Kebiri.\N-Kebiri?
Dialog: 0,0:42:33.45,0:42:34.62,Default,menembak,0,0,0,,Saya tidak mendengar...
Dialog: 0,0:42:37.86,0:42:39.49,Default,menembak,0,0,0,,Begitu.
Dialogue: 0,0:42:40.19,0:42:41.43,Default,tyra,0,0,0,,Bahan yang sangat berharga.
Dialog: 0,0:42:46.06,0:42:47.83,Default,menembak,0,0,0,,Aku tidak ingin membebanimu.
Dialogue: 0,0:42:48.43,0:42:51.24,Default,menembak,0,0,0,,Aku tahu kapan harus menyerah.
Dialog: 0,0:42:51.84,0:42:53.14,Default,menembak,0,0,0,,Maaf.
Dialog: 0,0:42:53.20,0:42:54.34,Default,menembak,0,0,0,,Jangan minta maaf.
Dialogue: 0,0:42:56.37,0:43:00.11,Default,menembak,0,0,0,,Bolehkah aku menanyakan satu pertanyaan saja?
Dialog: 0,0:43:00.75,0:43:02.75,Default,menembak,0,0,0,,-Ya.\N-Kenapa kamu
Dialogue: 0,0:43:03.65,0:43:05.85,Default,menembak,0,0,0,,tidak menyukai pria yang memiliki tujuan?
Dialog: 0,0:43:08.42,0:43:12.52,Default,galeri tembak,0,0,0,,Di istana aku melihat banyak orang yang memiliki tujuan
Dialog: 0,0:43:13.59,0:43:15.89,Default,menembak,0,0,0,,dan betapa sulitnya bagi mereka.
Dialog: 0,0:43:16.43,0:43:17.96,Default,menembak,0,0,0,,aku takut
Dialog: 0,0:43:18.63,0:43:20.33,Default,menembak,0,0,0,,dan saya tidak menginginkan ini untuk diri saya sendiri.
Dialogue: 0,0:43:23.13,0:43:24.74,Default,dash,0,0,0,,Terima kasih atas balasan anda.
Dialogue: 0,0:43:35.05,0:43:38.22,Default,menembak,0,0,0,,Semua yang berani kuinginkan darimu,
Dialogue: 0,0:43:39.68,0:43:41.62,Default,shooting,0,0,0,,supaya kamu selalu
Dialog: 0,0:43:42.92,0:43:44.12,Default,menembak,0,0,0,,tersenyum.
Dialog: 0,0:43:44.52,0:43:45.92,Default,menembak,0,0,0,,Oh, itu kamu.
Dialog: 0,0:43:50.60,0:43:51.60,Default,menembak,0,0,0,,Rupanya, inilah akhirnya.
Dialog: 0,0:43:51.60,0:43:53.87,Default,menembak,0,0,0,,Matamu sungguh tajam.
Dialogue: 0,0:43:54.23,0:43:55.47,Default,shooting gallery,0,0,0,,Kamu langsung memahami semuanya.
Dialogue: 0,0:43:55.63,0:43:58.67,Default,menembak,0,0,0,,Bagaimana mungkin aku tidak mengerti kalau kamu menangis seperti itu?
Dialog: 0,0:44:00.27,0:44:01.47,Default,menembak,0,0,0,,Jangan lihat.
Dialog: 0,0:44:04.08,0:44:07.41,Default,menembak,0,0,0,,Saya tidak ingin terlihat seperti ini.
Dialogue: 0,0:44:08.65,0:44:10.98,Default,shooting gallery,0,0,0,,Lalu pergilah ke sudut dan menangis disana.
Dialogue: 0,0:44:10.98,0:44:13.42,Default,shooting,0,0,0,,Orang-orang akan tetap menganggap itu karena aku.
Dialogue: 0,0:44:14.32,0:44:15.55,Default,menembak,0,0,0,,Itu bukan karena aku.
Dialog: 0,0:44:18.76,0:44:20.36,Default,menembak,0,0,0,,Aku tidak akan menangis lagi.
Dialog: 0,0:44:21.36,0:44:24.76,Default,menembak,0,0,0,,Mampu menghilangkan perasaan sepenuhnya adalah bagian dari cinta.
Dialogue: 0,0:44:25.23,0:44:29.17,Default,dash,0,0,0,,Ini mungkin lebih sulit daripada terus mencintainya.
Dialog: 0,0:44:30.00,0:44:31.57,Default,menembak,0,0,0,,Kamu sungguh seorang penyair.
Dialog: 0,0:44:32.64,0:44:34.94,Default,jarak tembak,0,0,0,,Ayo berangkat. Jangan menangis.
Dialogue: 0,0:44:40.31,0:44:44.02,Default,tyra,0,0,0,,Apakah dia sengaja mengirimiku makanan?
Dialogue: 0,0:44:52.16,0:44:53.89,Default,menembak,0,0,0,,Gambar tak menyenangkan apa ini?
Dialog: 0,0:44:53.89,0:44:57.50,Default,galeri tembak,0,0,0,,Betapa indahnya.
Dialog: 0,0:44:58.13,0:45:00.73,Default, lapangan tembak,0,0,0,,Nyonya Chon, bahkan racun pun tidak akan membawamu,
Dialog: 0,0:45:00.83,0:45:02.50,Default,menembak,0,0,0,,kamu sangat lambat berpikir.
Dialog: 0,0:45:03.94,0:45:06.27,Default,menembak,0,0,0,,Kenapa kamu tiba-tiba memujiku?
Dialog: 0,0:45:25.59,0:45:26.89,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:45:27.59,0:45:32.90,Default,tyra,0,0,0,,Saya, Simon dari keluarga Khan, datang untuk menyambut Anda.
Dialog: 0,0:45:37.90,0:45:39.77,Default,menembak,0,0,0,,Apakah kita belum pernah bertemu sebelumnya?
Dialog: 0,0:45:44.61,0:45:45.88,Default,menembak,0,0,0,,Saya sangat bersyukur.
Dialog: 0,0:45:46.81,0:45:49.51,Default,menembak,0,0,0,,Artinya, saya... Mohon maafkan saya.
Dialog: 0,0:45:50.75,0:45:53.15,Default,menembak,0,0,0,,Saya pikir Anda harus memberi tahu saya hal lain.
Dialog: 0,0:45:53.48,0:45:54.69,Default,dash,0,0,0,,Misalnya,
Dialogue: 0,0:45:55.89,0:45:57.92,Default,dash,0,0,0,,"Aku pantas mati."
Dialogue: 0,0:45:59.19,0:46:02.56,Default,dash,0,0,0,,Karena kamu, aku menumpahkan semua popcorn yang sudah aku kerjakan dengan susah payah.
Dialog: 0,0:46:02.86,0:46:05.00,Default,menembak,0,0,0,,Tersebar saat kamu mengirimnya terbang.
Dialog: 0,0:46:05.70,0:46:09.60,Default,menembak,0,0,0,,Aku tidak menyangka ada ratu di hadapanku,
Dialog: 0,0:46:10.64,0:46:14.57,Default,menembak,0,0,0,,Saya melakukan kejahatan serius.
Dialog: 0,0:46:16.71,0:46:18.24,Default,menembak,0,0,0,,Saya tidak tahu itu saya?
Dialogue: 0,0:46:20.48,0:46:21.48,Default,shooting gallery,0,0,0,,Lalu kenapa kamu kabur?
Dialog: 0,0:46:21.48,0:46:23.58,Default,menembak,0,0,0,,Yah, itu karena...
Dialogue: 0,0:46:23.58,0:46:26.32,Default,menembak,0,0,0,,Orang yang begitu mulia berlari mengejarku,
Dialogue: 0,0:46:26.32,0:46:28.05,Default,shooting gallery,0,0,0,,jadi aku terkejut.
Dialog: 0,0:46:28.49,0:46:31.72,Default,menembak,0,0,0,,Saya tidak punya alasan lain.
Dialog: 0,0:46:31.82,0:46:32.92,Default,menembak,0,0,0,,Benarkah?
Dialog: 0,0:46:37.53,0:46:39.53,Default,menembak,0,0,0,,Sebenarnya, aku meneleponmu,
Dialog: 0,0:46:42.83,0:46:44.70,Default,menembak,0,0,0,,untuk memberimu tempat di pengadilan.
Dialog: 0,0:46:46.67,0:46:49.71,Default,galeri menembak,0,0,0,,Tempat yang bagus dimana kamu pasti tidak akan diusir
Dialog: 0,0:46:49.71,0:46:50.78,Default,menembak,0,0,0,,dan mereka akan membayar dengan baik.
Dialogue: 0,0:46:52.41,0:46:53.98,Default,shooting gallery,0,0,0,,Tapi kamu harus kehilangan sesuatu.
Dialog: 0,0:46:55.01,0:46:56.08,Default,menembak,0,0,0,,Apa?
Dialogue: 0,0:46:57.92,0:46:59.28,Default,shooting gallery,0,0,0,,Apa maksudmu aku akan kehilangan sesuatu?
Dialog: 0,0:47:00.95,0:47:03.86,Default,tira,0,0,0,,Saat aku bertemu denganmu, meski hanya berumur pendek,
Dialog: 0,0:47:04.09,0:47:05.89,Default,tira,0,0,0,,memahami bahwa posisi ini cocok untuk Anda.
Dialog: 0,0:47:05.89,0:47:07.43,Default,menembak,0,0,0,,Aku sangat berterima kasih padamu, ratu.
Dialog: 0,0:47:11.13,0:47:12.20,Default,menembak,0,0,0,,Kamu
Dialog: 0,0:47:13.30,0:47:14.77,Default,tyra,0,0,0,,kamu akan menjadi seorang kasim.
Dialog: 0,0:47:14.97,0:47:16.07,Default,menembak,0,0,0,,Apa?
Dialog: 0,0:47:17.50,0:47:19.54,Default,menembak,0,0,0,,Tunggu. Tunggu sebentar.
Dialog: 0,0:47:19.54,0:47:21.81,Default,menembak,0,0,0,,Biarkan aku pergi. Lepaskan tangan.
Dialog: 0,0:47:23.64,0:47:24.71,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:47:25.08,0:47:26.74,Default,menembak,0,0,0,,Mohon ampun.
Dialog: 0,0:47:26.74,0:47:28.48,Default,dash,0,0,0,,Terima kasih atas kemurahan hati Anda yang tak terbatas.
Dialog: 0,0:47:28.48,0:47:30.65,Default,menembak,0,0,0,,Tapi kenapa kamu melakukan ini?
Dialog: 0,0:47:32.08,0:47:33.08,Default,menembak,0,0,0,,Pertama-tama,
Dialog: 0,0:47:33.08,0:47:35.65,Default,tyra,0,0,0,,kamu telah memalsukan identitasmu sebagai bangsawan.
Dialog: 0,0:47:36.45,0:47:38.26,Default,tanda hubung,0,0,0,,Tidak. Itu bukan salahmu.
Dialogue: 0,0:47:38.29,0:47:40.86,Default,menembak,0,0,0,,Struktur sosial yang harus disalahkan dalam hal ini.
Dialog: 0,0:47:41.03,0:47:42.46,Default,menembak,0,0,0,,Benar.
Dialog: 0,0:47:43.83,0:47:44.90,Default,tanda hubung,0,0,0,,Pertama. Pertama,
Dialog: 0,0:47:45.20,0:47:46.96,Default,tyra,0,0,0,,meracuni air di dapur kerajaan
Dialog: 0,0:47:46.96,0:47:49.07,Default, galeri menembak,0,0,0,,dan mengganggu pesta kerajaan.
Dialog: 0,0:47:50.53,0:47:51.67,Default,menembak,0,0,0,,Kedua,
Dialog: 0,0:47:52.07,0:47:53.74,Default,tyra,0,0,0,,keturunanmu adalah orang yang mengerikan.
Dialog: 0,0:47:55.07,0:47:56.07,Default,menembak,0,0,0,,Keturunan?
Dialogue: 0,0:47:56.27,0:47:59.61,Default,dash,0,0,0,,Apakah kamu yakin tidak mencampuradukkannya dengan leluhurku?
Dialog: 0,0:48:00.48,0:48:01.55,Default,menembak,0,0,0,,Tidak.
Dialog: 0,0:48:02.65,0:48:03.75,Default,menembak,0,0,0,,Benar.
Dialog: 0,0:48:06.85,0:48:09.29,Default,tyra,0,0,0,,Keturunanmu adalah orang yang mengerikan.
Dialog: 0,0:48:09.69,0:48:11.02,Default,menembak,0,0,0,,Keturunan?
Dialog: 0,0:48:12.26,0:48:13.49,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:48:13.49,0:48:15.46,Default,tyra,0,0,0,,Saya akan menjadi kasim - tidak akan ada keturunan.
Dialog: 0,0:48:15.46,0:48:17.93,Default,tyra,0,0,0,,Saya akan menjadi kasim - tidak akan ada keturunan. Yang Mulia!
Dialog: 0,0:48:18.90,0:48:21.23,Default,menembak,0,0,0,,Saya tidak akan memiliki keturunan.
Dialog: 0,0:48:21.33,0:48:23.33,Default,tyra,0,0,0,,Apakah kamu punya keturunan? TIDAK?
Dialog: 0,0:48:23.43,0:48:26.04,Default,menembak,0,0,0,,Saya tidak akan mempunyai keturunan!
Dialog: 0,0:48:26.04,0:48:29.37,Default,galeri tembak,0,0,0,,Bagaimana bisa. Ratu!
Dialog: 0,0:48:34.91,0:48:38.52,Default,jarak tembak,0,0,0,,Yang Mulia, Menteri Perang telah tiba.
Dialog: 0,0:48:48.73,0:48:49.96,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:48:50.63,0:48:52.06,Default,tyra,0,0,0,,Klan Andon Kim.
Dialogue: 0,0:48:52.36,0:48:54.27,Default,shooting,0,0,0,,Aku yakin mereka semua bersekongkol.
Dialogue: 0,0:48:54.97,0:48:57.10,Default,tyra,0,0,0,,Tapi ayahku juga berasal dari keluarga Andon Kim.
Dialog: 0,0:48:57.27,0:49:00.47,Default,menembak,0,0,0,,Apa? Saya baru saja memanggilnya "ayah saya".
Dialog: 0,0:49:03.71,0:49:05.81,Default,menembak,0,0,0,,Mentransfer emosi itu berbahaya.
Dialog: 0,0:49:08.11,0:49:11.12,Default,menembak,0,0,0,,Aku mengetahui apa yang terjadi padamu setelah pertemuan kita.
Dialog: 0,0:49:12.72,0:49:14.12,Default,menembak,0,0,0,,Saya tidak tahu apa yang terjadi.
Dialog: 0,0:49:14.65,0:49:16.15,Default,menembak,0,0,0,,Kamu tidak tahu,
Dialogue: 0,0:49:16.79,0:49:18.09,Default,menembak,0,0,0,,bahwa mereka mencoba membunuhku?
Dialogue: 0,0:49:18.09,0:49:21.19,Default,tyra,0,0,0,,Aku bukan dari pihak ayahku, dan aku bukan anggota keluarga Kim.
Dialog: 0,0:49:22.09,0:49:24.63,Default,menembak,0,0,0,,Namun, kamu tidak lepas dari ayah dan keluargamu.
Dialog: 0,0:49:26.63,0:49:28.33,Default,menembak,0,0,0,,Akhirnya kamu akan mengerti.
Dialog: 0,0:49:40.68,0:49:42.55,Default,galeri tembak,0,0,0,,Musuh atau sekutu?
Dialogue: 0,0:49:53.99,0:49:55.69,Default,menembak,0,0,0,,Beraninya dia melakukan ini pada Soyeon?
Dialog: 0,0:50:01.30,0:50:04.14,Default,menembak,0,0,0,,Lagipula, bagaimana dia bisa melakukan ini pada ratu?
Dialog: 0,0:50:07.41,0:50:09.01,Default,menembak,0,0,0,,Kim Jwageun, bajingan.
Dialog: 0,0:50:09.91,0:50:11.31,Default,menembak,0,0,0,,Saya harus...
Dialog: 0,0:50:20.75,0:50:23.22,Default,menembak,0,0,0,,Selain itu, Samjeong Lijeongjeong ini.
Dialogue: 0,0:50:23.22,0:50:26.99,Default,menembak,0,0,0,,Mereka menggunakan korupsi pejabat sebagai alasan,
Dialog: 0,0:50:26.99,0:50:29.69,Default,menembak,0,0,0,,untuk mencoba menghancurkan keluarga kami.
Dialog: 0,0:50:29.69,0:50:31.03,Default,menembak,0,0,0,,Jangan khawatir.
Dialog: 0,0:50:31.66,0:50:34.23,Default,menembak,0,0,0,,Jika mereka melihat ini sebagai perampasan milik orang lain,
Dialog: 0,0:50:34.23,0:50:36.07,Default,menembak,0,0,0,,maka tidak ada seorang pun yang tidak bersalah.
Dialog: 0,0:50:37.07,0:50:39.44,Default,menembak,0,0,0,,Untuk melindungi diri sendiri,
Dialog: 0,0:50:39.70,0:50:41.94,Default,menembak,0,0,0,,mereka akan mencoba melindungi pejabat.
Dialogue: 0,0:50:42.17,0:50:45.81,Default,menembak,0,0,0,,Yang tersisa dari Samjeong Lijeongjeong hanyalah kulit terluarnya.
Dialogue: 0,0:50:49.15,0:50:51.15,Default,shooting gallery,0,0,0,,Bahkan jika kamu bergabung dengan mereka sebentar,
Dialog: 0,0:50:51.15,0:50:53.98,Default,menembak,0,0,0,,awasi Ibu Suri.
Dialogue: 0,0:50:54.45,0:50:56.85,Default,menembak,0,0,0,,Dia bisa tersenyum di depan wajahmu,
Dialog: 0,0:50:56.85,0:50:58.96,Default,menembak,0,0,0,,tapi dia selalu siap menusukkan pisau dari belakang.
Dialog: 0,0:50:59.89,0:51:01.36,Default,menembak,0,0,0,,Saya akan mengingat ini.
Dialogue: 0,0:51:02.26,0:51:03.49,Default,menembak,0,0,0,,Nyonya Chon.
Dialog: 0,0:51:04.23,0:51:06.10,Default,menembak,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:51:06.83,0:51:09.33,Default,shooting gallery,0,0,0,,Singkirkan meja dan panggil tabib.
Dialog: 0,0:51:09.57,0:51:11.20,Default,menembak,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:51:15.04,0:51:16.51,Default,menembak,0,0,0,,Apakah kamu sudah makan?
Dialogue: 0,0:51:17.44,0:51:19.24,Default,menembak,0,0,0,,Aku tak nafsu makan.
Dialog: 0,0:51:20.14,0:51:22.08,Default,menembak,0,0,0,,Kudengar kamu menyukai makanannya,
Dialog: 0,0:51:22.08,0:51:23.85,Default,tyra,0,0,0,,dimasak oleh ratu.
Dialogue: 0,0:51:25.12,0:51:26.88,Default,menembak,0,0,0,,Dia tidak begitu bagus.
Dialog: 0,0:51:26.98,0:51:29.12,Default,tyra,0,0,0,,Dia bisa dimakan.
Dialog: 0,0:51:29.55,0:51:31.96,Default,menembak,0,0,0,,Ratu sedang berduka sekarang.
Dialog: 0,0:51:34.49,0:51:36.29,Default,tyra,0,0,0,,Katanya selir utama
Dialog: 0,0:51:36.29,0:51:39.30,Default,tyra,0,0,0,,datang di antara kamu dan membuatnya percaya bahwa keluarga berbalik melawannya.
Dialogue: 0,0:51:39.63,0:51:41.47,Default,menembak,0,0,0,,Dia menyalahkan dirinya sendiri atas semuanya.
Dialog: 0,0:51:43.83,0:51:45.04,Default,tyra,0,0,0,,Kepala selir?
Dialogue: 0,0:51:45.04,0:51:47.10,Default,menembak,0,0,0,,Ayah ratu memberitahuku hari ini.
Dialog: 0,0:51:47.47,0:51:49.81,Default,menembak,0,0,0,,Bukan ratu yang menipumu,
Dialog: 0,0:51:51.04,0:51:52.28,Default,tyra,0,0,0,,dan selir utama.
Dialog: 0,0:52:01.79,0:52:04.05,Default,,0,0,0,,Raja telah datang.
Dialog: 0,0:52:05.76,0:52:07.02,Default,,0,0,0,,Minta dia masuk.
Dialog: 0,0:52:14.40,0:52:15.47,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:52:15.70,0:52:18.40,Default,,0,0,0,,Maaf atas keterlambatan kunjungan tanpa peringatan.
Dialog: 0,0:52:19.30,0:52:20.50,Default,,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:52:20.74,0:52:23.41,Default,,0,0,0,,Kapan pun itu adalah suatu kehormatan besar.
Dialog: 0,0:52:23.94,0:52:25.94,Default,,0,0,0,,Saya datang untuk mengatakan sesuatu.
Dialog: 0,0:52:28.78,0:52:30.38,Default,,0,0,0,,Apa?
Dialog: 0,0:52:31.12,0:52:34.49,Default,,0,0,0,,Tentang mayat pelayan istana yang baru-baru ini ditemukan di dalam sumur.
Dialog: 0,0:52:35.95,0:52:38.76,Default,,0,0,0,,Ini dilakukan atas perintah Ibu Suri.
Dialogue: 0,0:52:40.09,0:52:41.43,Default,,0,0,0,,Ibu Suri?
Dialogue: 0,0:52:42.89,0:52:44.16,Default,,0,0,0,,Tapi kenapa dia...
Dialog: 0,0:52:44.46,0:52:46.20,Default,,0,0,0,,Kamu juga tidak mengerti alasannya?
Dialog: 0,0:52:48.90,0:52:51.30,Default,,0,0,0,,Jika iya, itu sudah pasti...
Dialogue: 0,0:52:51.54,0:52:52.84,Default,,0,0,0,,Tidak bisa Ovol.
Dialog: 0,0:52:52.97,0:52:56.14,Default,,0,0,0,,Tapi ini tidak mungkin. Ini pastinya Ovol.
Dialog: 0,0:52:56.71,0:52:58.98,Default,,0,0,0,,Saya dengar kondisinya sedemikian rupa sehingga sulit dikenali.
Dialogue: 0,0:52:58.98,0:53:01.01,Default,,0,0,0,,Mengapa Anda memutuskan bahwa itu adalah Ovol?
Dialog: 0,0:53:01.55,0:53:03.71,Default,,0,0,0,,Dia berpakaian seperti dayang istana,
Dialog: 0,0:53:03.71,0:53:07.48,Default,,0,0,0,,dan dari para dayang, hanya Ovol yang menghilang.
Dialogue: 0,0:53:10.75,0:53:13.36,Default,,0,0,0,,Dia tahu kamu akan mengira itu Ovol.
Dialog: 0,0:53:14.43,0:53:16.13,Default,,0,0,0,,Ibu Suri menginginkan,
Dialog: 0,0:53:17.09,0:53:19.26,Default,,0,0,0,,sehingga Anda mengandalkannya.
Dialogue: 0,0:53:20.20,0:53:22.37,Default,,0,0,0,,Tapi kenapa sumurnya digunakan?
Dialog: 0,0:53:24.30,0:53:26.74,Default,,0,0,0,,Aku menceritakan padanya apa yang aku alami di dalam sumur.
Dialog: 0,0:53:27.97,0:53:31.51,Default,,0,0,0,,Bahwa aku bertemu denganmu di dalamnya.
Dialogue: 0,0:53:31.71,0:53:33.31,Default,,0,0,0,,Dan tempat ini menyakitiku.
Dialog: 0,0:53:34.91,0:53:36.68,Default,,0,0,0,,Dia mengingatkanku padamu,
Dialog: 0,0:53:36.68,0:53:38.98,Default,,0,0,0,,jadi aku yakin aku telah kehilangan seseorang yang kusayangi.
Dialog: 0,0:53:41.42,0:53:43.95,Default,,0,0,0,,Sekarang aku mengerti bahwa kamu tidak bisa sembarangan mengungkapkan rasa sakitmu
Dialog: 0,0:53:45.16,0:53:46.42,Default,,0,0,0,,kepada siapa pun di istana.
Dialog: 0,0:54:04.84,0:54:08.98,Default,,0,0,0,,Benamkan ratu dalam mimpi buruk yang aku tinggali.
Dialog: 0,0:54:15.62,0:54:18.16,Default,,0,0,0,,Jangan percaya lagi pada Ibu Suri.
Dialogue: 0,0:54:18.82,0:54:20.16,Default,,0,0,0,,Kita harus menyembunyikan apa yang kita ketahui,
Dialog: 0,0:54:21.13,0:54:23.73,Default,,0,0,0,,jadi jangan biarkan dia tahu bahwa kamu tahu apa yang dia lakukan.
Dialogue: 0,0:54:25.63,0:54:29.17,Default,,0,0,0,,Dia mengkhianatiku dan aku sangat kecewa.
Dialog: 0,0:54:30.80,0:54:32.07,Default,,0,0,0,,Bagi saya
Dialog: 0,0:54:33.30,0:54:35.47,Default,,0,0,0,,sumber ketakutan.
Dialogue: 0,0:54:37.04,0:54:38.64,Default,,0,0,0,,Aku tidak percaya dia menggunakan itu.
Dialogue: 0,0:54:52.29,0:54:55.49,Default,,0,0,0,,Ini seperti poker dan hato.
Dialog: 0,0:54:55.73,0:54:57.93,Default,,0,0,0,,Obrolan dan permainan -
Dialog: 0,0:54:57.93,0:55:00.86,Default,,0,0,0,,cara terbaik untuk menghabiskan waktu dan kehidupan.
Dialogue: 0,0:55:01.73,0:55:03.27,Default,,0,0,0,,Senang mendengarnya.
Dialog: 0,0:55:03.63,0:55:06.37,Default,,0,0,0,,Kami takut Damhyang akan membuatmu merasa tidak enak.
Dialog: 0,0:55:08.57,0:55:09.81,Default,,0,0,0,,Oh, maaf.
Dialog: 0,0:55:11.01,0:55:13.48,Default,,0,0,0,,Jangan khawatir. Dia berada di tempat yang baik sekarang.
Dialog: 0,0:55:13.71,0:55:16.71,Default,,0,0,0,,Benarkah? Dia harus pergi ke tempat yang bagus, bukan?
Dialog: 0,0:55:17.88,0:55:18.92,Default,,0,0,0,,Damhyang.
Dialog: 0,0:55:21.02,0:55:25.56,Default,,0,0,0,,Tidak, bukan itu yang saya bicarakan. Dia benar-benar berada di tempat yang baik.
Dialog: 0,0:55:25.56,0:55:26.62,Default,,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:55:28.56,0:55:29.63,Default,,0,0,0,,Damhyan.
Dialogue: 0,0:55:32.00,0:55:34.06,Default,,0,0,0,,Dia bilang dia benar-benar pindah ke tempat yang bagus.
Dialogue: 0,0:55:35.40,0:55:37.74,Default,,0,0,0,,Kenapa kamu menangis?
Dialog: 0,0:55:39.27,0:55:40.90,Default,,0,0,0,,Maaf.
Dialog: 0,0:55:41.67,0:55:43.14,Default,,0,0,0,,Jika dipikir-pikir,
Dialog: 0,0:55:44.14,0:55:47.21,Default,,0,0,0,,Aku bahkan tidak mengucapkan selamat tinggal padanya.
Dialog: 0,0:55:48.41,0:55:50.85,Default,,0,0,0,,Damhyang.
Dialog: 0,0:55:55.12,0:55:57.25,Default,,0,0,0,,-Damhyan.\N-Ratu.
Dialog: 0,0:55:58.72,0:55:59.99,Default,,0,0,0,,Damhyan.
Dialog: 0,0:56:00.49,0:56:01.56,Default,,0,0,0,,Tujuh.
Dialog: 0,0:56:03.73,0:56:04.73,Default,,0,0,0,,Delapan.
Dialog: 0,0:56:05.50,0:56:06.66,Default,,0,0,0,,Ini...
Dialog: 0,0:56:07.90,0:56:09.80,Default,,0,0,0,,sembilan.
Dialog: 0,0:56:14.10,0:56:16.07,Default,,0,0,0,,Maafkan saya.
Dialog: 0,0:56:16.31,0:56:18.01,Default,,0,0,0,,Bagaimana bisa?
Dialog: 0,0:56:19.71,0:56:23.11,Default,,0,0,0,,-Damhyan.\N-Damhyan.
Dialog: 0,0:56:24.65,0:56:25.65,Default,,0,0,0,,All-in.
Dialogue: 0,0:56:29.85,0:56:32.79,Default,,0,0,0,,Bagaimana Ibu Suri mendapatkan buku besarnya?
Dialogue: 0,0:56:32.89,0:56:35.59,Default,,0,0,0,,Buku yang susah payah dicari, tapi terlewat.
Dialogue: 0,0:56:36.92,0:56:40.69,Default,,0,0,0,,Mungkin aku bisa memenangkan dia ke sisimu?
Dialog: 0,0:56:42.26,0:56:43.53,Default,,0,0,0,,Lelucon.
Dialog: 0,0:56:44.23,0:56:47.40,Default,,0,0,0,,Mendengar dia menyusul kami, dengan bebas meninggalkan istana,
Dialog: 0,0:56:47.40,0:56:48.67,Default,,0,0,0,,Aku kecewa pada diriku sendiri.
Dialog: 0,0:56:49.80,0:56:52.17,Default,,0,0,0,,Ibu Suri berada di Aula Seongwonjong hampir\N sepanjang waktu.
Dialog: 0,0:56:52.17,0:56:54.47,Default,,0,0,0,,Saya tidak mengerti bagaimana dia mendapatkan buku besar.
Dialog: 0,0:56:54.81,0:56:56.54,Default,,0,0,0,,Itu, yang dia lakukan dengan tubuh,
Dialog: 0,0:56:57.01,0:56:59.75,Default,,0,0,0,,berarti dia punya kaki tangan.
Dialogue: 0,0:56:59.75,0:57:02.18,Default,,0,0,0,,Mungkin kita harus menjadikan mereka kaki tangan kita?
Dialog: 0,0:57:02.85,0:57:05.49,Default,,0,0,0,,Potret yang bertopeng tokkebi belum siap?
Dialogue: 0,0:57:06.02,0:57:08.86,Default,,0,0,0,,Aku terlalu sibuk akhir-akhir ini,
Dialog: 0,0:57:08.86,0:57:11.22,Default,,0,0,0,,membebaskan ibu Damhyang dari perbudakan
Dialog: 0,0:57:11.22,0:57:13.16,Default,,0,0,0,,dan mencari ayahnya.
Dialog: 0,0:57:13.33,0:57:14.93,Default,,0,0,0,,Tapi kamu tidak pernah menemukannya?
Dialogue: 0,0:57:14.93,0:57:17.30,Default,,0,0,0,,Bagaimana cara menemukan seseorang yang bersembunyi di pegunungan?
Dialog: 0,0:57:17.60,0:57:19.30,Default,,0,0,0,,Dia mungkin menjadi bandit.
Dialog: 0,0:57:23.00,0:57:28.58,Default,,0,0,0,,Memikirkan liburan setelah perjalananku sebagai penyelidik kerajaan,
Dialogue: 0,0:57:29.01,0:57:33.31,Default,,0,0,0,,Aku hampir tidak bisa berdiri akhir-akhir ini.
Dialogue: 0,0:57:34.51,0:57:36.92,Default,,0,0,0,,Sebenarnya, maksudku...
Dialogue: 0,0:57:40.49,0:57:44.09,Default,,0,0,0,,Bisakah kamu menjadikanku inspektur rahasia dan bukan penyelidik kerajaan?
Dialogue: 0,0:57:44.09,0:57:45.66,Default,,0,0,0,,Ini lebih keren.
Dialog: 0,0:57:45.66,0:57:48.56,Default,,0,0,0,,Dalam penyamaran, saya tiba-tiba mengeluarkan token, seperti itu!
Dialog: 0,0:57:50.23,0:57:53.10,Default,,0,0,0,,Ya, Anda terlahir sebagai inspektur rahasia. Lakukan sesukamu.
Dialogue: 0,0:57:54.23,0:57:55.30,Default,,0,0,0,,Sekali lagi.
Dialog: 0,0:58:21.43,0:58:25.70,Default,,0,0,0,,Menurutku Youngjin bukan orang seperti itu.
Dialog: 0,0:58:26.10,0:58:28.20,Default,,0,0,0,,Hanya Kim Jwageun yang pantas mati.
Dialog: 0,0:58:28.20,0:58:29.30,Default,,0,0,0,,A Youngjin -
Dialogue: 0,0:58:31.87,0:58:33.81,Default,,0,0,0,,seluruh keluargaku.
Dialog: 0,0:58:45.99,0:58:48.92,Default,,0,0,0,,Hei, kamu akan tidur di sini setelah itu,
Dialogue: 0,0:58:48.92,0:58:50.16,Default,,0,0,0,,bagaimana kamu hampir membunuh ayah mertua dan istrimu?
Dialogue: 0,0:58:52.36,0:58:53.49,Default,,0,0,0,,Rupanya tidak.
Dialog: 0,0:59:10.24,0:59:12.35,Default,,0,0,0,,Hati, berhenti.
Dialogue: 0,0:59:12.98,0:59:14.82,Default,,0,0,0,,Ini menyakiti harga diriku.
Dialog: 0,1:00:18.55,1:00:20.88,Default,,0,0,0,,Sepertinya dia berada di bawah air untuk waktu yang lama.
Dialog: 0,1:00:22.25,1:00:25.25,Default,,0,0,0,,Saya mengerti betapa menyakitkannya hal ini.
Dialog: 0,1:00:27.95,1:00:30.69,Default,,0,0,0,,Fakta bahwa tubuhnya ditemukan di dalam sumur adalah suatu kebetulan yang buruk,
Dialog: 0,1:00:31.06,1:00:33.29,Default,,0,0,0,,atau seseorang ingin mendorong kita.
Dialogue: 0,1:00:50.28,1:00:51.85,Default,,0,0,0,,Aku sedang berpikir keras.
Dialog: 0,1:00:52.21,1:00:53.68,Default,,0,0,0,,Kamu pasti kaget sekali.
Dialog: 0,1:00:53.98,1:00:55.88,Default,,0,0,0,,Terlalu banyak ruang untukku di sini.
Dialog: 0,1:00:57.02,1:01:00.65,Default,,0,0,0,,Di sini kamu merasa kesepian dan tersesat.
Dialog: 0,1:01:00.99,1:01:03.92,Default,,0,0,0,,Saya menemukan pelayan yang menjual noriga yang Anda berikan kepada Ovol.
Dialog: 0,1:01:04.49,1:01:06.89,Default,,0,0,0,,Dia bilang dia menemukannya di istana.
Dialog: 0,1:01:08.70,1:01:09.96,Default,,0,0,0,,Benarkah?
Dialog: 0,1:01:09.96,1:01:11.60,Default,,0,0,0,,Ini adalah pelayan yang sama yang melemparkan mayatnya ke dalam sumur
Dialog: 0,1:01:11.60,1:01:13.93,Default,,0,0,0,,atas perintah Ibu Suri.
Dialog: 0,1:01:14.67,1:01:16.10,Default,,0,0,0,,Ovol masih hidup.
Dialog: 0,1:01:16.60,1:01:18.47,Default,,0,0,0,,Dia diserang di istana.
Dialog: 0,1:01:19.34,1:01:21.68,Default,,0,0,0,,Dia bahkan tidak punya waktu untuk melangkah keluar istana.
Dialog: 0,1:01:23.91,1:01:25.41,Default,,0,0,0,,Tidakkah kamu berharap bahwa tubuh,
Dialog: 0,1:01:25.95,1:01:28.08,Default,,0,0,0,,ditemukan di dalam sumur, bukan milik Ovol?
Dialog: 0,1:01:29.35,1:01:31.42,Default,,0,0,0,,Bukankah seharusnya kamu bahagia,
Dialogue: 0,1:01:31.42,1:01:33.09,Default,,0,0,0,,bahwa itu bukan Ovol?
Dialog: 0,1:01:33.95,1:01:36.42,Default,,0,0,0,,Mengapa Anda yakin ini Ovol?
Dialog: 0,1:01:36.66,1:01:37.79,Default,,0,0,0,,Demi Tuhan...
Dialog: 0,1:01:40.69,1:01:42.73,Default,,0,0,0,,Demi Tuhan, apa yang kamu sembunyikan?
Dialog: 0,1:01:47.23,1:01:48.27,Default,,0,0,0,,Terakhir kali
Dialogue: 0,1:01:50.67,1:01:53.31,Default,,0,0,0,,apa yang kamu lewati
Dialog: 0,1:01:55.08,1:01:56.41,Default,,0,0,0,,Ibu Suri?
Dialog: 0,1:02:07.19,1:02:08.56,Default,,0,0,0,,Apakah kamu melihat semuanya?
Dialog: 0,1:02:09.29,1:02:10.36,Default,,0,0,0,,I
Dialog: 0,1:02:11.32,1:02:15.80,Default,,0,0,0,,Saya tidak melihat apa pun tanpa izin Anda.
Dialog: 0,1:02:20.57,1:02:22.50,Default,,0,0,0,,Semua orang tersesat dari waktu ke waktu.
Dialog: 0,1:02:22.94,1:02:24.94,Default,,0,0,0,,Anda masih memiliki kesempatan untuk kembali ke jalur yang benar.
Dialogue: 0,1:02:28.14,1:02:30.41,Default,,0,0,0,,Bagaimana jika aku sudah lama tersesat?
Dialog: 0,1:02:31.78,1:02:32.91,Default,,0,0,0,,Masih Bisa
Dialog: 0,1:02:34.21,1:02:36.32,Default,,0,0,0,,kembali ke jalur yang benar?
Dialog: 0,1:02:39.75,1:02:41.32,Default,,0,0,0,,Tidak ada jalan untuk kembali.
Dialog: 0,1:02:41.69,1:02:42.92,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:02:42.92,1:02:45.66,Default,,0,0,0,,Badan itu pasti Ovol.
Dialogue: 0,1:02:55.80,1:02:58.14,Default,,0,0,0,,Kenapa kamu memasak samhyang ramen
Dialog: 0,1:02:58.84,1:03:00.34,Default,,0,0,0,,di tengah malam?
Dialogue: 0,1:03:04.01,1:03:06.58,Default,,0,0,0,,Mengapa kamu paling menginginkannya di malam hari?
Dialog: 0,1:03:06.58,1:03:09.12,Default,,0,0,0,,Tahukah kamu kalau di pagi hari wajahmu akan membengkak.
Dialog: 0,1:03:09.68,1:03:12.92,Default,,0,0,0,,Tetapi sangat sulit untuk melawan godaan.
Dialog: 0,1:03:15.49,1:03:18.09,Default,,0,0,0,,Kamu berusaha keras, sayang sekali sia-sia.
Dialogue: 0,1:03:18.09,1:03:20.16,Default,,0,0,0,,Janda Ratu di Malam Hari
Dialog: 0,1:03:20.29,1:03:21.90,Default,,0,0,0,,tidak makan.
Dialog: 0,1:03:21.90,1:03:23.60,Default,,0,0,0,,Jadi, izinkan saya...
Dialog: 0,1:03:25.87,1:03:27.03,Default,,0,0,0,,Tidak.
Dialog: 0,1:03:55.86,1:03:58.23,Default,,0,0,0,,Anda harus memperingatkan saya tentang kedatangan Anda.
Dialogue: 0,1:03:58.23,1:04:00.67,Default,,0,0,0,,Kenapa kamu tidak mengetuknya saja?
Dialog: 0,1:04:07.94,1:04:10.71,Default,,0,0,0,,Apakah kamu ingin makan ramen sebelum kita berangkat?
Dialogue: 0,1:04:14.41,1:04:17.75,Default,,0,0,0,,Apa itu ramen? Dan kemana kamu ingin aku pergi?
Dialog: 0,1:04:18.82,1:04:21.79,Default,,0,0,0,,Tanpa tekanan. Ini hanya penelitian.
Dialog: 0,1:04:21.96,1:04:23.19,Default,,0,0,0,,Atau tes.
Dialog: 0,1:04:24.12,1:04:26.09,Default,,0,0,0,,Tidak, saya tidak seharusnya melakukan itu.
Dialog: 0,1:04:28.23,1:04:29.80,Default,,0,0,0,,Tetapi jika hanya sedikit...
Dialog: 0,1:04:29.80,1:04:30.80,Default,,0,0,0,,Tidak, tidak.
Dialogue: 0,1:04:31.00,1:04:33.13,Default,,0,0,0,,Ramen punya rasa yang membuat ketagihan.
Dialog: 0,1:04:33.13,1:04:35.30,Default,,0,0,0,,Setelah Anda memulai, tidak mungkin untuk berhenti.
Dialog: 0,1:04:36.84,1:04:38.10,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,1:04:42.71,1:04:44.18,Default,,0,0,0,,Konflik internal.
Dialogue: 0,1:04:51.55,1:04:53.15,Default,,0,0,0,,Apa yang akan kamu lakukan jika kamu jadi aku?
Dialogue: 0,1:04:53.52,1:04:56.26,Default,,0,0,0,,Mau makan ramen atau tidak?
Dialogue: 0,1:04:56.69,1:04:59.23,Default,,0,0,0,,Saya rasa saya akan menjelaskan dulu apa itu ramen.
Dialog: 0,1:05:01.76,1:05:03.73,Default,,0,0,0,,-Sebagai permulaan...\N-Apa?
Dialog: 0,1:05:04.46,1:05:05.67,Default,,0,0,0,,Saya akan mencobanya.
Dialog: 0,1:05:06.20,1:05:07.23,Default,,0,0,0,,Benarkah?
Dialog: 0,1:05:07.73,1:05:09.87,Default,,0,0,0,,Anda hanya akan mengerti apa itu ketika Anda mencobanya.
Dialog: 0,1:05:09.87,1:05:11.81,Default,,0,0,0,,Seperti udara saat mabuk,
Dialog: 0,1:05:11.81,1:05:13.34,Default,,0,0,0,,atau saat kamu sedang marah,
Dialog: 0,1:05:13.34,1:05:15.04,Default,,0,0,0,,atau menyadari bahwa itu adalah
Dialog: 0,1:05:16.58,1:05:18.04,Default,,0,0,0,,realitas.
Dialog: 0,1:05:19.55,1:05:22.12,Default,,0,0,0,,Apakah kita berbicara dalam bahasa yang sama sekarang?
Dialog: 0,1:05:22.98,1:05:24.02,Default,,0,0,0,,Tentu saja.
Dialog: 0,1:05:24.55,1:05:26.49,Default,,0,0,0,,Kita berbicara tentang ramen.
Dialogue: 0,1:05:28.35,1:05:31.29,Default,,0,0,0,,Mendekat. Ramen enak saat panas.
Dialog: 0,1:05:31.29,1:05:32.46,Default,,0,0,0,,Instruksi awal untuk anak-anak
Dialog: 0,1:05:33.63,1:05:34.73,Default,,0,0,0,,Bagaimana caramu memperlakukannya?
Dialog: 0,1:05:34.93,1:05:36.53,Default,,0,0,0,,Oh, ibu!
Dialog: 0,1:05:36.53,1:05:38.40,Default,,0,0,0,,Apa yang harus dilakukan? Ini adalah buku yang tak ternilai harganya.
Dialogue: 0,1:05:54.55,1:05:57.02,Default,,0,0,0,,Mengapa Anda mengatakan bahwa buku ini tak ternilai harganya?
Dialogue: 0,1:05:59.22,1:06:02.96,Default,,0,0,0,,Seberapa berhargakah Pengajaran Dasar untuk Anak bagi Anda?
Dialog: 0,1:06:05.13,1:06:06.19,Default,,0,0,0,,Ini...
Dialogue: 0,1:06:08.03,1:06:09.26,Default,,0,0,0,,Apakah itu kamu?
Dialog: 0,1:06:12.37,1:06:15.10,Default,,0,0,0,,Kaulah yang menyelamatkanku?
Dialogue: 0,1:06:15.27,1:06:17.77,Default,,0,0,0,,Kau menyelamatkanku dari sumur?
Dialog: 0,1:06:31.08,1:06:32.09,Default,,0,0,0,,Ya.
Dialogue: 0,1:06:32.89,1:06:33.99,Default,,0,0,0,,Itu aku.
Dialogue: 0,1:06:47.10,1:06:51.50,Default,,0,0,0,,Bagaimana aku menjadi seorang ratu
Dialog: 0,1:07:11.79,1:07:14.96,Default,,0,0,0,,Cheoljong-ku akan sangat menungguku.
Dialogue: 0,1:07:15.30,1:07:17.23,Default,,0,0,0,,Jadi ini jebakan?
Dialog: 0,1:07:17.23,1:07:20.30,Default,,0,0,0,,Aku tak percaya ratu menantangku bertarung sungguhan.
Dialog: 0,1:07:20.30,1:07:21.84,Default,,0,0,0,,{\i1}-Sekarang giliranku?\N-Keluarkan pedangmu.{\i}
Dialog: 0,1:07:21.84,1:07:25.00,Default,,0,0,0,,Orang yang tidak membersihkan dirinya sendiri dan meninggalkan jejak,
Dialog: 0,1:07:25.00,1:07:26.94,Default,,0,0,0,,harus menjawab semuanya.
Dialog: 0,1:07:26.94,1:07:28.01,Default,,0,0,0,,Meskipun aku menggulingkan klan Kim,
Dialog: 0,1:07:28.01,1:07:29.91,Default,,0,0,0,,Kekuatan Kim Byonin semakin menguat.
Dialog: 0,1:07:29.91,1:07:31.78,Default,,0,0,0,,Rasanya tidak ada kemajuan.
Dialog: 0,1:07:31.78,1:07:34.95,Default,,0,0,0,,Jika Cheoljong melakukan ini, dunia juga akan berubah setelah 200 tahun.
Dialog: 0,1:07:34.95,1:07:36.98,Default,,0,0,0,,Selama aku di pihakmu, kamu akan menang.
Dialog: 0,1:07:36.98,1:07:38.75,Default,,0,0,0,,Saya punya senjata rahasia.
Dialogue: 0,1:07:38.75,1:07:40.09,Default,,0,0,0,,Я знаю будущее.
Dialog: 0,0:15:25.96,0:15:27.96,Default,,0,0,0,,

Komentar: 0,0:08:45.52,0:08:46.75,Default,Лилия,0,0,0,, SECARA HATI-HATINYA BERBATA "TANPA BIBIR, GIGI\NARE DINGIN" DAN BERARTI DEKAT.
Komentar: 0,0:09:01.50,0:09:02.87,Default,Лилия,0,0,0,,MEMBERI AMNESTI BAGI\NCRIMINAL TERTENTU ATAS KEJAHATAN MEREKA
