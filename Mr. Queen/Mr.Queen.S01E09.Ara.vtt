Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:10.02,0:01:12.53,Default,FEBRUARY,0,0,0,,لماذا عرضت نفسك للهجوم؟
Dialogue: 0,0:01:14.69,0:01:15.76,Default,FEBRUARY,0,0,0,,ها هو ذا!
Dialogue: 0,0:01:23.97,0:01:25.84,Default,FEBRUARY,0,0,0,,دعونا ننسى التباعد اليوم.
Dialogue: 0,0:01:32.05,0:01:33.08,Default,فبراير,0,0,0,,جلالتك.
Dialogue: 0,0:01:34.08,0:01:35.32,Default,FEBRUARY,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:01:50.73,0:01:51.90,Default,FEBRUARY,0,0,0,,من هناك؟
Dialogue: 0,0:02:08.05,0:02:11.62,Default,FEBRUARY,0,0,0,,المغادرة، في طريق الخروج.
Dialogue: 0,0:02:13.09,0:02:15.86,Default,فبراير,0,0,0,,9 حلقة
Dialogue: 0,0:02:41.85,0:02:45.19,Default,FEBRUARY,0,0,0,,أتركهما ينامان منفصلين\Nليرتاحا بسلام،
Dialogue: 0,0:02:47.89,0:02:49.52,Default,FEBRUARY,0,0,0,,ولكن يبدو أنني كنت مخطئاً بعض الشيء.
Dialogue: 0,0:02:49.96,0:02:52.59,Default,فبراير,0,0,0,,سمعت شيئًا ما يتحطم.
Dialogue: 0,0:02:52.59,0:02:54.39,Default,FEBRUARY,0,0,0,,استيقظت أيضًا بسبب الضجيج.
Dialogue: 0,0:02:54.83,0:02:56.60,Default,فبراير,0,0,0,,وكان الباب مكسوراً.
Dialogue: 0,0:02:58.26,0:03:00.20,Default,FEBRUARY,0,0,0,,من الواضح أن الأمر غير نظيف، كل شيء يحتاج إلى فحص.
Dialogue: 0,0:03:00.47,0:03:03.24,Default,FEBRUARY,0,0,0,,ولكن بعد ذلك سنقاطع الزوجين الملكيين.
Dialogue: 0,0:03:11.11,0:03:13.62,Default,FEBRUARY,0,0,0,,لن أتفاجأ إذا اهتز المنزل بسببهم\N.
Dialogue: 0,0:03:14.28,0:03:15.82,Default,FEBRUARY,0,0,0,,المتزوجون حديثاً، ماذا تأخذ منهم.
Dialogue: 0,0:03:16.58,0:03:20.02,Default,FEBRUARY,0,0,0,,يجب أن نحمي خصوصيتهم.
Dialogue: 0,0:03:23.12,0:03:25.19,Default,فبراير,0,0,0,,لا تقترب كثيراً من المنزل.
Dialogue: 0,0:03:25.69,0:03:26.69,Default,فبراير,0,0,0,,نعم.
Dialogue: 0,0:03:30.46,0:03:32.20,Default,FEBRUARY,0,0,0,,سأذهب إلى الملحق.
Dialogue: 0,0:03:32.60,0:03:33.93,Default,FEBRUARY,0,0,0,,هل ستحمي سلامهم؟
Dialogue: 0,0:03:35.37,0:03:37.37,Default,FEBRUARY,0,0,0,,-نعم.\N-اعتني بهم.
Dialogue: 0,0:04:19.31,0:04:21.75,Default,FEBRUARY,0,0,0,,سيطري على نفسك أيتها المرأة!
Dialogue: 0,0:04:27.45,0:04:30.02,Default,FEBRUARY,0,0,0,,وكان عليك تقبيله؟!
Dialogue: 0,0:04:33.09,0:04:35.16,Default,FEBRUARY,0,0,0,,هل تبحث عن قتال؟
Dialogue: 0,0:04:35.80,0:04:39.17,Default,فبراير,0,0,0,,مع من تتجادل؟
Dialogue: 0,0:04:40.00,0:04:41.17,Default,فبراير,0,0,0,,لا تتدخل.
Dialogue: 0,0:04:41.17,0:04:44.20,Default,FEBRUARY,0,0,0,,هذا بيني وبين "كيم سو يون" فقط.
Dialogue: 0,0:04:46.11,0:04:47.74,Default,فبراير,0,0,0,,بينما أنا هنا،
Dialogue: 0,0:04:47.74,0:04:49.61,Default,FEBRUARY,0,0,0,,سأفعل ما أريد بهذه الهيئة.
Dialogue: 0,0:04:49.61,0:04:52.08,Default,FEBRUARY,0,0,0,,من روحه في الجسد هو المالك!
Dialogue: 0,0:04:55.52,0:04:57.65,Default,FEBRUARY,0,0,0,,على ما يبدو أنك لا تزال في حالة سكر.
Dialogue: 0,0:04:58.45,0:05:01.02,Default,FEBRUARY,0,0,0,,أنت لا ترى الفرق بين الحلم والواقع.
Dialogue: 0,0:05:02.39,0:05:04.66,Default,FEBRUARY,0,0,0,,-لدي حجر في روحي.\N-ما الذي تتحدث عنه؟
Dialogue: 0,0:05:05.12,0:05:07.74,Default,FEBRUARY,0,0,0,,نعم، أستطيع المشي إلى المنزل بمفردي في أي حالة.
Dialogue: 0,0:05:26.85,0:05:28.28,Default,فبراير,0,0,0,,لا. هذا ليس حلما.
Dialogue: 0,0:05:29.62,0:05:31.99,Default,FEBRUARY,0,0,0,,لماذا تظهر في حلمي.
Dialogue: 0,0:05:34.25,0:05:36.66,Default,فبراير,0,0,0,,آسف على الحضور
Dialogue: 0,0:05:39.03,0:05:40.33,Default,فبراير,0,0,0,,في أحلامك.
Dialogue: 0,0:06:03.65,0:06:05.42,Default,FEBRUARY,0,0,0,,انس هذا الكابوس.
Dialogue: 0,0:06:36.45,0:06:39.52,Default,فبراير,0,0,0,,الحلقة التاسعة: النور والظلام
Dialogue: 0,0:08:38.17,0:08:40.34,Default,فبراير,0,0,0,,هونغ يونغ، حساس.
Dialogue: 0,0:09:11.87,0:09:15.04,Default,FEBRUARY,0,0,0,,إنها ليست هنا. إذا لم تكن في المنزل فأين؟
Dialogue: 0,0:09:18.61,0:09:20.21,Default,FEBRUARY,0,0,0,,هل هناك خطأ؟
Dialogue: 0,0:09:23.02,0:09:24.85,Default,FEBRUARY,0,0,0,,لم يكن قلقاً بسبب الماضي.
Dialogue: 0,0:10:19.84,0:10:22.44,Default,فبراير,0,0,0,,-مرحبًا، مرحبًا.\N-ماذا؟
Dialogue: 0,0:10:22.44,0:10:23.98,Default,فبراير,0,0,0,,طلبوا مني ألا أقترب من المنزل.
Dialogue: 0,0:10:23.98,0:10:25.81,Default,FEBRUARY,0,0,0,,-لماذا؟\N-لا أعرف.
Dialogue: 0,0:10:26.48,0:10:28.31,Default,FEBRUARY,0,0,0,,-اجلس.\N-حسناً.
Dialogue: 0,0:10:30.05,0:10:32.95,Default,FEBRUARY,0,0,0,,لأكون صادقًا، أنا قلقة على صاحبة الجلالة.
Dialogue: 0,0:10:32.95,0:10:34.09,Default,FEBRUARY,0,0,0,,هل سمعت عنها شيئاً؟
Dialogue: 0,0:10:34.69,0:10:36.19,Default,FEBRUARY,0,0,0,,عن الملكة؟
Dialogue: 0,0:10:36.19,0:10:37.22,Default,فبراير,0,0,0,,إنها تجري حول القصر
Dialogue: 0,0:10:37.22,0:10:38.29,Default,فبراير,0,0,0,,كل صباح.
Dialogue: 0,0:10:38.29,0:10:40.53,Default,FEBRUARY,0,0,0,,لا تتحدث بالهراء.
Dialogue: 0,0:10:40.53,0:10:43.90,Default,FEBRUARY,0,0,0,,لقد عرفتها منذ أن كانت طفلة.\Nلم تجري قط عندما ولدت.
Dialogue: 0,0:10:43.90,0:10:46.73,Default,FEBRUARY,0,0,0,,-أنت تكذب.\N-هذا صحيح.
Dialogue: 0,0:10:48.37,0:10:51.04,Default,FEBRUARY,0,0,0,,-وهذا غريب.\N-لكن هذا ما يقولونه.
Dialogue: 0,0:10:51.30,0:10:52.77,Default,FEBRUARY,0,0,0,,-لا.\N-لا أصدق ذلك!
Dialogue: 0,0:10:52.87,0:10:53.87,Default,فبراير,0,0,0,,أنا أقول الحقيقة.
Dialogue: 0,0:10:56.11,0:10:58.98,Default,فبراير,0,0,0,,-دجاج!\N-امسك بهم.
Dialogue: 0,0:11:01.45,0:11:02.82,Default,FEBRUARY,0,0,0,,توقف أيها الريش!
Dialogue: 0,0:11:18.83,0:11:20.83,Default,FEBRUARY,0,0,0,,كان يرتدي ملابس قسم المباحث.
Dialogue: 0,0:11:21.83,0:11:22.97,Default,فبراير,0,0,0,,لذا...
Dialogue: 0,0:11:36.12,0:11:38.72,Default,FEBRUARY,0,0,0,,سوف تسكر حتى الموت. قف.
Dialogue: 0,0:11:41.02,0:11:42.79,Default,فبراير,0,0,0,,عذاب العطش.
Dialogue: 0,0:11:42.82,0:11:45.62,Default,FEBRUARY,0,0,0,,كلما فكرت أكثر في هذه الخطيئة،\Nزاد عطشي.
Dialogue: 0,0:11:48.33,0:11:50.76,Default,فبراير,0,0,0,,وكأني أموت من العطش.
Dialogue: 0,0:11:51.66,0:11:54.37,Default,FEBRUARY,0,0,0,,إذا كنت عطشاناً، فاشرب الماء، وليس النبيذ.
Dialogue: 0,0:11:58.90,0:12:01.14,Default,FEBRUARY,0,0,0,,مرحبًا، أحضر لنا بعض الماء.
Dialogue: 0,0:12:01.71,0:12:02.74,Default,فبراير,0,0,0,,نعم.
Dialogue: 0,0:12:05.64,0:12:10.02,Default,FEBRUARY,0,0,0,,كلما شربت المزيد من النبيذ، زادت رغبتك في الشرب.
Dialogue: 0,0:12:27.57,0:12:30.44,Default,FEBRUARY,0,0,0,,نمت جيداً، كما لو أن أحدهم قد طردني.
Dialogue: 0,0:12:33.67,0:12:35.01,Default,فبراير,0,0,0,,أنا أفهمك.
Dialogue: 0,0:12:35.61,0:12:37.58,Default,فبراير,0,0,0,,امتلأ الجسد بالخفة.
Dialogue: 0,0:12:38.04,0:12:40.58,Default,فبراير,0,0,0,,أنت. أنت.
Dialogue: 0,0:12:44.92,0:12:49.36,Default,FEBRUARY,0,0,0,,لا بد أن هذا المنزل بني على أرض جيدة. حصلت على نوم ليلة عظيم.
Dialogue: 0,0:12:50.42,0:12:52.86,Default,FEBRUARY,0,0,0,,هل من الطبيعي أن تستيقظ معي؟
Dialogue: 0,0:12:56.93,0:12:58.76,Default,FEBRUARY,0,0,0,,هل هذا غير طبيعي؟
Dialogue: 0,0:12:59.33,0:13:01.47,Default,FEBRUARY,0,0,0,,هذا ليس قصرًا - لم يتم اختيار تاريخ الليلة معًا.
Dialogue: 0,0:13:01.47,0:13:03.87,Default,FEBRUARY,0,0,0,,من الطبيعي أن نتقاسم سريراً واحداً في منزل والدنا.
Dialogue: 0,0:13:04.54,0:13:06.44,Default,فبراير,0,0,0,,منطقي.
Dialogue: 0,0:13:06.44,0:13:08.74,Default,FEBRUARY,0,0,0,,في معسكر العدو عليك أن تكون\Nمعي - أفضل غطاء.
Dialogue: 0,0:13:09.31,0:13:11.48,Default,FEBRUARY,0,0,0,,لعبتك اليوم من الدرجة الأولى.
Dialogue: 0,0:13:13.01,0:13:15.82,Default,FEBRUARY,0,0,0,,حسنًا، دعنا نتظاهر بأننا قضينا ليلة ساخنة معًا.
Dialogue: 0,0:13:16.15,0:13:18.72,Default,FEBRUARY,0,0,0,,كان الجو حاراً جداً لدرجة أننا قلبناه...
Dialogue: 0,0:13:25.09,0:13:26.09,Default,فبراير,0,0,0,,ماذا؟
Dialogue: 0,0:13:26.39,0:13:27.99,Default,FEBRUARY,0,0,0,,يبدو أنك تتذكر هذه الليلة.
Dialogue: 0,0:13:28.23,0:13:29.86,Default,FEBRUARY,0,0,0,,سيكون من المؤسف إذا نسيتها،
Dialogue: 0,0:13:29.86,0:13:31.46,Default,FEBRUARY,0,0,0,,مثل أول واحد لدينا.
Dialogue: 0,0:13:32.30,0:13:34.23,Default,FEBRUARY,0,0,0,,هل بسبب عودة الذاكرة؟
Dialogue: 0,0:13:35.87,0:13:39.04,Default,FEBRUARY,0,0,0,,أنام كالطفل.
Dialogue: 0,0:13:52.15,0:13:54.55,Default,FEBRUARY,0,0,0,,ليس لدي وقت للعب الحيل.
Dialogue: 0,0:13:55.12,0:13:57.89,Default,FEBRUARY,0,0,0,,يجب أن تصبح الملكة الأرملة.
Dialogue: 0,0:13:58.36,0:14:00.59,Default,FEBRUARY,0,0,0,,حتى لو حدث شيء لعائلة الهان،
Dialogue: 0,0:14:00.69,0:14:02.13,Default,فبراير,0,0,0,,لا يمكنهم الوصول إلي.
Dialogue: 0,0:14:03.36,0:14:07.03,Default,FEBRUARY,0,0,0,,كنا أنا والرجل الملثم نبحث عن نفس الشيء.
Dialogue: 0,0:14:07.80,0:14:10.00,Default,FEBRUARY,0,0,0,,كم يعرف كيم بيونغين بالفعل؟
Dialogue: 0,0:14:10.74,0:14:13.54,Default,FEBRUARY,0,0,0,,يجب ألا يقع دفتر المحاسبة في أيديهم.
Dialogue: 0,0:14:16.78,0:14:19.81,Default,FEBRUARY,0,0,0,,اليوم سأعود إلى القصر بأي ثمن.
Dialogue: 0,0:14:20.75,0:14:24.25,Default,FEBRUARY,0,0,0,,اليوم سأجد الكتاب مهما حدث.
Dialogue: 0,0:14:34.03,0:14:36.16,Default,FEBRUARY,0,0,0,,لا يزال من الممكن أن تمرض.
Dialogue: 0,0:14:37.13,0:14:39.33,Default,FEBRUARY,0,0,0,,متى تعود الملكة إلى القصر؟
Dialogue: 0,0:14:39.87,0:14:43.54,Default,FEBRUARY,0,0,0,,سأرسل رسالة له ولجلالته\Nللعودة في أقرب وقت ممكن.
Dialogue: 0,0:14:43.87,0:14:47.01,Default,FEBRUARY,0,0,0,,لم أجد الحياة في القصر مملة أبداً.
Dialogue: 0,0:14:47.01,0:14:50.18,Default,FEBRUARY,0,0,0,,لكن الملكة لم تغادر سوى بضعة أيام، والمكان هنا مقفر بالفعل.
Dialogue: 0,0:14:50.88,0:14:54.38,Default,FEBRUARY,0,0,0,,طبخ صاحبة الجلالة رائع للغاية؟
Dialogue: 0,0:14:54.68,0:14:57.82,Default,FEBRUARY,0,0,0,,الأمر لا يتعلق بطبخها.\Nإنها لطيفة بالنسبة لي.
Dialogue: 0,0:15:00.72,0:15:02.45,Default,FEBRUARY,0,0,0,,المرفق خطير.
Dialogue: 0,0:15:02.92,0:15:05.19,Default,فبراير,0,0,0,,هذا الصباح كنت جائعاً...
Dialogue: 0,0:15:05.59,0:15:06.63,Default,فبراير,0,0,0,,هذا هو
Dialogue: 0,0:15:08.23,0:15:10.66,Default,FEBRUARY,0,0,0,,استيقظت مبكراً، مشتاقاً إلى ملكتي العزيزة.
Dialogue: 0,0:15:10.80,0:15:12.36,Default,فبراير,0,0,0,,أنا أفهمك.
Dialogue: 0,0:15:12.36,0:15:15.07,Default,FEBRUARY,0,0,0,,من المخيف أن تدرك أنه قد تم ترويضك.
Dialogue: 0,0:15:19.24,0:15:21.47,Default,FEBRUARY,0,0,0,,يبدو أنك أنت من يستخدم الآخرين،
Dialogue: 0,0:15:22.14,0:15:25.04,Default,FEBRUARY,0,0,0,,ولكن في مرحلة ما يتبين أنهم قاموا بترويضك.
Dialogue: 0,0:15:26.05,0:15:29.18,Default,FEBRUARY,0,0,0,,لذا يجب أن تجد المزيد من الأشخاص المفيدين لك.
Dialogue: 0,0:15:29.45,0:15:33.79,Default,FEBRUARY,0,0,0,,سأطلب من الطهاة الملكيين أن يتعلموا وصفات صاحبة الجلالة.
Dialogue: 0,0:15:34.85,0:15:38.29,Default,FEBRUARY,0,0,0,,لقد جعلت حياتي في القصر جنة.
Dialogue: 0,0:15:38.69,0:15:40.89,Default,FEBRUARY,0,0,0,,ليس لدي سبب لأتركه.
Dialogue: 0,0:15:41.39,0:15:43.83,Default,FEBRUARY,0,0,0,,لهذا السبب انتهى بي الأمر في مكاني -
Dialogue: 0,0:15:43.83,0:15:46.70,Default,FEBRUARY,0,0,0,,لحراسة هذه الجنة يا صاحب الجلالة.
Dialogue: 0,0:15:50.50,0:15:51.64,Default,فبراير,0,0,0,,بالمناسبة.
Dialogue: 0,0:15:51.64,0:15:54.71,Default,FEBRUARY,0,0,0,,أخبر بنين أن تأتي لرؤيتي أحياناً.
Dialogue: 0,0:15:56.84,0:15:58.01,Default,فبراير,0,0,0,,تريد
Dialogue: 0,0:15:59.41,0:16:00.98,Default,فبراير,0,0,0,,أتحدث معه؟
Dialogue: 0,0:16:01.21,0:16:04.18,Default,FEBRUARY,0,0,0,,ومع ذلك، فهو ابنك المتبنى.\NI لقد أهمله بما فيه الكفاية.
Dialogue: 0,0:16:04.95,0:16:07.49,Default,FEBRUARY,0,0,0,,حان الوقت لإعطائه التعليمات من وقت لآخر.
Dialogue: 0,0:16:08.29,0:16:10.66,Default,FEBRUARY,0,0,0,,أنت لم تصبح أصغر سناً بعد.
Dialogue: 0,0:16:11.06,0:16:12.73,Default,FEBRUARY,0,0,0,,افعل الأشياء المهمة فقط.
Dialogue: 0,0:16:12.99,0:16:15.96,Default,FEBRUARY,0,0,0,,كل ما يهمك يهمني.
Dialogue: 0,0:16:54.57,0:16:55.80,Default,فبراير,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:17:01.01,0:17:02.81,Default,فبراير,0,0,0,,قسم المباحث
Dialogue: 0,0:17:02.81,0:17:05.28,Default,FEBRUARY,0,0,0,,سوف يتحقق من كل حراس الملك.
Dialogue: 0,0:17:06.31,0:17:09.01,Default,FEBRUARY,0,0,0,,أنت تحمي حياة الملك وتكون دائمًا بجانبه -
Dialogue: 0,0:17:09.55,0:17:12.79,Default,FEBRUARY,0,0,0,,علينا أن نتأكد من كل شيء.
Dialogue: 0,0:17:15.22,0:17:16.86,Default,FEBRUARY,0,0,0,,لا تدعهم يتخذون خطوة!
Dialogue: 0,0:17:27.30,0:17:29.10,Default,فبراير,0,0,0,,لقد مر كل شخص هنا
Dialogue: 0,0:17:30.34,0:17:31.87,Default,فبراير,0,0,0,,فحص كامل.
Dialogue: 0,0:17:36.61,0:17:38.58,Default,FEBRUARY,0,0,0,,يمكنك شراء النسب.
Dialogue: 0,0:17:39.04,0:17:40.25,Default,FEBRUARY,0,0,0,,أنت لا تعرف أبدًا.
Dialogue: 0,0:17:41.25,0:17:42.48,Default,فبراير,0,0,0,,شخص من الحارس
Dialogue: 0,0:17:42.48,0:17:44.52,Default,FEBRUARY,0,0,0,,يمكن التحضير للخيانة باسم شخص آخر.
Dialogue: 0,0:17:45.82,0:17:48.19,Default,FEBRUARY,0,0,0,,قدم المساعدة - نحن نقوم بواجبنا.
Dialogue: 0,0:17:52.12,0:17:54.96,Default,FEBRUARY,0,0,0,,إذا لم تجد دليلاً على اتهاماتك،
Dialogue: 0,0:17:56.43,0:17:57.56,Default,فبراير,0,0,0,,i
Dialogue: 0,0:17:59.03,0:18:01.00,Default,فبراير,0,0,0,,سأستخدم صلاحياتي.
Dialogue: 0,0:18:01.30,0:18:03.77,Default,FEBRUARY,0,0,0,,هذا إذا قمت بحفظ مشاركتك.
Dialogue: 0,0:18:04.54,0:18:07.97,Default,FEBRUARY,0,0,0,,إذا لم تكن متورطاً في الخيانة، فارحل.
Dialogue: 0,0:18:18.12,0:18:19.72,Default,FEBRUARY,0,0,0,,-البحث في كل مكان.\N-نعم.
Dialogue: 0,0:18:32.53,0:18:33.83,Default,فبراير,0,0,0,,فتش في كل زاوية.
Dialogue: 0,0:18:34.70,0:18:36.87,Default,FEBRUARY,0,0,0,,اسحب جميع المستندات.
Dialogue: 0,0:18:36.87,0:18:38.60,Default,FEBRUARY,0,0,0,,وأحضره إلى قسم المباحث.
Dialogue: 0,0:18:38.80,0:18:39.94,Default,فبراير,0,0,0,,-نعم!\N-نعم!
Dialogue: 0,0:18:55.29,0:18:57.32,Default,فبراير,0,0,0,,أتمنى أن تنام جيداً.
Dialogue: 0,0:18:58.56,0:19:01.06,Default,FEBRUARY,0,0,0,,لقد أحضرت طائراً جميلاً.
Dialogue: 0,0:19:01.06,0:19:02.16,Default,FEBRUARY,0,0,0,,كيف تحبها؟
Dialogue: 0,0:19:03.00,0:19:04.93,Default,FEBRUARY,0,0,0,,لديها ريش جميل.
Dialogue: 0,0:19:05.50,0:19:08.83,Default,FEBRUARY,0,0,0,,يسعدني هذا الطائر الثمين في ضوء الأخبار السارة.
Dialogue: 0,0:19:12.47,0:19:15.34,Default,FEBRUARY,0,0,0,,هل هناك أي أخبار جيدة؟
Dialogue: 0,0:19:15.34,0:19:17.81,Default,FEBRUARY,0,0,0,,العداء بين الملكة و
Dialogue: 0,0:19:17.81,0:19:20.45,Default,FEBRUARY,0,0,0,,المحظية الملكية "تشو" أقوى مما كنت أعتقد.
Dialogue: 0,0:19:22.01,0:19:23.78,Default,FEBRUARY,0,0,0,,هناك شيء لم أخبرك به.
Dialogue: 0,0:19:24.85,0:19:26.75,Default,FEBRUARY,0,0,0,,لا أحد يعرف عن هذا.
Dialogue: 0,0:19:26.75,0:19:28.65,Default,فبراير,0,0,0,,أنا والملكة فقط.
Dialogue: 0,0:19:31.96,0:19:36.16,Default,FEBRUARY,0,0,0,,بسبب ما حدث منذ 8 سنوات، صاحبة الجلالة واثقة من نفسها
Dialogue: 0,0:19:38.10,0:19:39.36,Default,FEBRUARY,0,0,0,,أني سرقت منها الملك.
Dialogue: 0,0:19:40.70,0:19:44.24,Default,FEBRUARY,0,0,0,,السم الموجود على سهمنا يزداد قوة.
Dialogue: 0,0:19:44.97,0:19:47.97,Default,FEBRUARY,0,0,0,,حان الوقت لاستخدام الشيء الثاني.
Dialogue: 0,0:19:47.97,0:19:49.04,Default,فبراير,0,0,0,,نعم.
Dialogue: 0,0:19:50.11,0:19:52.85,Default,FEBRUARY,0,0,0,,من الصعب العثور على شيء مماثل،
Dialogue: 0,0:19:53.28,0:19:55.61,Default,FEBRUARY,0,0,0,,سيستغرق هذا بعض الوقت.
Dialogue: 0,0:19:56.48,0:20:00.12,Default,FEBRUARY,0,0,0,,لكنني سأحضره لك،\Nحتى لو اضطررت إلى صنعه بنفسي.
Dialogue: 0,0:20:13.53,0:20:14.77,Default,Spilik2,0,0,0,,استخدم هذا.
Dialogue: 0,0:20:31.02,0:20:34.19,Default,Spilik2,0,0,0,,في غمضة عين يتعلمون عن الحرس الملكي.
Dialogue: 0,0:20:34.72,0:20:36.15,Default,Spikyulka2,0,0,0,,دعونا نجد طريقة.
Dialogue: 0,0:20:36.29,0:20:38.52,Default,Spikyulka2,0,0,0,,لقد واجهت بالأمس رجلاً من قسم المباحث.
Dialogue: 0,0:20:38.66,0:20:40.66,Default,Spilik2,0,0,0,,لقد رأى وجهك. هل ستكون هذه مشكلة؟
Dialogue: 0,0:20:41.43,0:20:43.33,Default,Spikyulka2,0,0,0,,لا أعتقد أنه تعرف علي.
Dialogue: 0,0:20:44.03,0:20:46.47,Default,Spilyk2,0,0,0,,إذا اصطدمنا مرة أخرى،
Dialogue: 0,0:20:47.53,0:20:49.84,Default,Spikyulka2,0,0,0,,سوف يفهم أنني كنت أبحث عن دفتر المحاسبة.
Dialogue: 0,0:20:53.04,0:20:57.91,Default,Spilik2,0,0,0,,كان يرتدي قناعاً نادراً على شكل توكيبي.
Dialogue: 0,0:20:58.94,0:21:02.51,Default,Spilik2,0,0,0,,هل كان لديه ندبة؟
Dialogue: 0,0:21:03.48,0:21:05.65,Default,Spilik2,0,0,0,,نعم. يبدو وكأنه ندبة قديمة.
Dialogue: 0,0:21:06.12,0:21:07.92,Default,Spikyulka2,0,0,0,,هو أحد الذين عذبوا أوفول.
Dialogue: 0,0:21:09.79,0:21:11.82,Default,Spikyulka2,0,0,0,,إذاً، كيم جواجيون
Dialogue: 0,0:21:11.82,0:21:13.93,Default,Spikyulka2,0,0,0,,تصرفت من خلال كيم بيونين.
Dialogue: 0,0:21:15.16,0:21:16.30,Default,Spilyk2,0,0,0,,لحسن الحظ,
Dialogue: 0,0:21:16.93,0:21:19.83,Default,Spikyulka2,0,0,0,,لا يعلم أن موقع تخزين دفتر الأستاذ المحاسبي قد تغير.
Dialogue: 0,0:21:21.93,0:21:23.64,Default,Spikyulka2,0,0,0,,الليلة هي فرصتنا الأخيرة.
Dialogue: 0,0:21:26.27,0:21:28.94,Default,Spikyulka2,0,0,0,,يا صاحب الجلالة، هناك رسالة لك من القصر.
Dialogue: 0,0:21:31.88,0:21:34.65,Default,Spikyulka2,0,0,0,,هذه الرسالة من كيم جواجين.
Dialogue: 0,0:21:35.18,0:21:38.22,Default,Spikyulka2,0,0,0,,تم تسليمه من قبل رئيس قسم المباحث.
Dialogue: 0,0:21:40.09,0:21:41.55,Default,Spikyulka2,0,0,0,,أي من هذا القسم
Dialogue: 0,0:21:41.55,0:21:42.92,Default,Spikyulka2,0,0,0,,كان من الممكن تسليمها بسهولة.
Dialogue: 0,0:21:42.92,0:21:44.32,Default,Spikyulka2,0,0,0,,لكنك أتيت شخصياً؟
Dialogue: 0,0:21:45.46,0:21:46.79,Default,Spilyk2,0,0,0,,هل لديك الكثير من وقت الفراغ؟
Dialogue: 0,0:21:47.79,0:21:50.63,Default,Spikyulka2,0,0,0,,أحضرته شخصياً لأنه مهم.
Dialogue: 0,0:21:51.46,0:21:54.43,Default,Spilik2,0,0,0,,يُطلب من جلالتك والملكة العودة فوراً إلى القصر.
Dialogue: 0,0:21:55.90,0:21:57.90,Default,Spilyk2,0,0,0,,قائد القوات
Dialogue: 0,0:21:57.90,0:22:00.04,Default,Spilik2,0,0,0,,يطالبني بالعودة إلى القصر؟
Dialogue: 0,0:22:00.04,0:22:03.48,Default,Spilik2,0,0,0,,ينقل رسالة من الملكة الأرملة.
Dialogue: 0,0:22:04.84,0:22:07.38,Default,Silk2,0,0,0,,سأبقى هنا ليلة أخرى من أجل صحة الملكة.
Dialogue: 0,0:22:07.38,0:22:08.68,Default,Spikyulka2,0,0,0,,- أخبرهم. \N-لكن...
Dialogue: 0,0:22:08.68,0:22:09.92,Default,Spilyk2,0,0,0,,هذا كل شيء.
Dialogue: 0,0:22:11.35,0:22:13.59,Default,Spilik2,0,0,0,,لا تعكر صفو الملكة وعُد.
Dialogue: 0,0:22:18.02,0:22:19.12,Default,Spilyk2,0,0,0,,هكذا هو الحال.
Dialogue: 0,0:22:21.63,0:22:26.63,Default,Spilik2,0,0,0,,يبدو أن جلالته قلق للغاية بشأن صحة الملكة.
Dialogue: 0,0:22:29.84,0:22:31.57,Default,Spilyk2,0,0,0,,سأنقلها.
Dialogue: 0,0:22:36.84,0:22:39.48,Default,Spilyk2,0,0,0,,سأتناول الإفطار في غرفة الملكة.
Dialogue: 0,0:22:39.71,0:22:42.15,Default,Spilyk2,0,0,0,,أحضر فطورك المعتاد. فقط دع الأمر يكون سهلاً.
Dialogue: 0,0:22:42.15,0:22:43.32,Default,Spilik2,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:22:43.32,0:22:46.05,Default,Spilyk2,0,0,0,,سوف نقدم إفطارنا المعتاد.
Dialogue: 0,0:22:50.06,0:22:51.89,Default,Spilik2,0,0,0,,منزل المحظية تشو القريب،
Dialogue: 0,0:22:52.16,0:22:53.86,Default,Spikyulka2,0,0,0,,سأكتشف أمر "أوفول" وأعود.
Dialogue: 0,0:22:53.86,0:22:55.16,Default,Spilik2,0,0,0,,فكرة عظيمة.
Dialogue: 0,0:22:56.13,0:22:58.26,Default,Spiky2,0,0,0,,شعرت بالسوء بعد أن طردتها بعيداً.
Dialogue: 0,0:22:58.73,0:23:00.67,Default,Spikyulka2,0,0,0,,ولن أكون في القصر لليلة أخرى.
Dialogue: 0,0:23:00.67,0:23:02.60,Default,Spillie2,0,0,0,,من فضلك اعتني بها.
Dialogue: 0,0:23:03.20,0:23:04.24,Default,Spilyk2,0,0,0,,نعم.
Dialogue: 0,0:23:11.38,0:23:15.95,Default,Spikyulka2,0,0,0,,الملكة تتسكع هنا طوال اليوم. لكن عندما رحلت،
Dialogue: 0,0:23:16.85,0:23:19.82,Default,Spilyk2,0,0,0,,يبدو المطبخ الملكي فارغاً جداً.
Dialogue: 0,0:23:25.16,0:23:27.16,Default,Spilik2,0,0,0,,الآن أستطيع التنفس من جديد.
Dialogue: 0,0:23:31.10,0:23:34.23,Default,Spilik2,0,0,0,,أيها الوغد. المزيد من زيت بذور اللفت.
Dialogue: 0,0:23:34.40,0:23:35.50,Default,Spilyk2,0,0,0,,ها هو الذي بلا ذراعين.
Dialogue: 0,0:23:35.83,0:23:37.37,Default,Spillit2,0,0,0,,قطع أصغر.
Dialogue: 0,0:23:38.34,0:23:40.44,Default,Spilik2,0,0,0,,اطهيها بشكل أسرع قبل أن تفقد شكلها.
Dialogue: 0,0:23:48.41,0:23:52.82,Default,Spilik2,0,0,0,,كم هو جميل وهادئ هنا.
Dialogue: 0,0:23:53.15,0:23:55.49,Default,Spilik2,0,0,0,,أحب أن أكون المسؤول.
Dialogue: 0,0:24:01.66,0:24:09.30,Default,Spilyk2,0,0,0,,-الشيف الملكي! \N-رويال الشيف!
Dialogue: 0,0:24:09.30,0:24:13.04,Default,Spilyk2,0,0,0,,-الشيف الملكي! \N-رويال الشيف!
Dialogue: 0,0:24:13.04,0:24:14.34,Default,Spilyk2,0,0,0,,-كفى. \N-الشيف الملكي.
Dialogue: 0,0:24:14.34,0:24:15.41,Default,Spilyk2,0,0,0,,-الطباخ الملكي.
Dialogue: 0,0:24:18.01,0:24:19.74,Default,Spilik2,0,0,0,,-أعود. \N-نحن نطيع.
Dialogue: 0,0:24:20.11,0:24:21.35,Default,Spillit2,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,0:24:24.28,0:24:25.52,Default,Spillit2,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,0:24:27.22,0:24:29.25,Default,Spilik2,0,0,0,,أنظر إلى وجهك،
Dialogue: 0,0:24:30.26,0:24:33.56,Default,Spilik2,0,0,0,,أدركت أن الملكة لم تتعاف بعد.
Dialogue: 0,0:24:34.09,0:24:37.70,Default,Spilyk2,0,0,0,,لا، لقد تعافت تماماً.
Dialogue: 0,0:24:39.53,0:24:41.93,Default,Spikyulka2,0,0,0,,إذن لماذا تم إنزالهم في الماء؟
Dialogue: 0,0:24:43.97,0:24:48.77,Default,Spikyulka2,0,0,0,,مؤخراً، بفضل صاحبة الجلالة، مررت بالكثير.
Dialogue: 0,0:24:50.31,0:24:52.18,Default,Spikyulka2,0,0,0,,ظننت أنها عندما لم تكن موجودة،
Dialogue: 0,0:24:52.81,0:24:54.65,Default,Spilyk2,0,0,0,,لن أضطر إلى العثور على خطأ
Dialogue: 0,0:24:55.25,0:24:57.08,Default,Spikyulka2,0,0,0,,وسأشعر بالهدوء.
Dialogue: 0,0:24:57.82,0:24:58.95,Default,Spikyulka2,0,0,0,,ولكن في الواقع، كيف؟
Dialogue: 0,0:25:00.32,0:25:01.99,Default,Spilik2,0,0,0,,سأصبح أكثر جنوناً.
Dialogue: 0,0:25:02.82,0:25:07.39,Default,Spikyulka2,0,0,0,,أخشى حتى الموت أنها بدوني سوف تفلت مني تماماً.
Dialogue: 0,0:25:07.69,0:25:11.20,Default,Spilyk2,0,0,0,,إليك الصفقة. يقولون أن هناك مخاوف أكثر بكثير بشأن الشائعات غير المسموعة،
Dialogue: 0,0:25:11.20,0:25:13.30,Default,Spikyulka2,0,0,0,,أكثر من الأطفال الطيبين.
Dialogue: 0,0:25:14.10,0:25:15.63,Default,Spilik2,0,0,0,,توقف عن الكآبة.
Dialogue: 0,0:25:15.77,0:25:16.97,Default,Spilyk2,0,0,0,,هنا.
Dialogue: 0,0:25:25.84,0:25:27.85,Default,Spilik2,0,0,0,,فتح.
Dialogue: 0,0:25:34.79,0:25:36.02,Default,Spikyulka2,0,0,0,,تم التقاطه من الطريق.
Dialogue: 0,0:25:38.22,0:25:41.69,Default,Spilyk2,0,0,0,,في مثل هذه الأيام
Dialogue: 0,0:25:41.69,0:25:45.16,Default,Spilik2,0,0,0,,أنت مثلي، لكن ليس كذلك.
Dialogue: 0,0:25:45.16,0:25:48.33,Default,Spilyk2,0,0,0,,في مثل هذه الأيام
Dialogue: 0,0:25:48.33,0:25:51.54,Default,Spilik2,0,0,0,,أنت مثلي، لكن ليس كذلك.
Dialogue: 0,0:25:51.67,0:25:53.74,Default,Spikyulka2,0,0,0,,وأيام كهذه أنت مثلي، لكن ليس كذلك.
Dialogue: 0,0:25:53.74,0:25:56.07,Default,Spikyulka2,0,0,0,,ولماذا أعطاني القمامة المجمعة؟
Dialogue: 0,0:25:57.08,0:25:58.84,Default,Spilik2,0,0,0,,يا له من كابوس.
Dialogue: 0,0:25:59.81,0:26:01.78,Default,Spikyulka2,0,0,0,,كلما تعرفت عليه أكثر، بدا غريباً.
Dialogue: 0,0:26:02.71,0:26:04.65,Default,Spikyulka2,0,0,0,,كان بإمكاني رميها بعيداً، لماذا أعطيتني إياها؟
Dialogue: 0,0:26:04.98,0:26:06.59,Default,Spilik2,0,0,0,,هذا هراء.
Dialogue: 0,0:26:07.18,0:26:10.98,Default,Spikyulka2,0,0,0,,هل تلقيت أخبارًا من أوفول؟
Dialogue: 0,0:26:11.65,0:26:12.65,Default,Spilik2,0,0,0,,No.
Dialogue: 0,0:26:13.25,0:26:14.92,Default,Spilik2,0,0,0,,هل حدث لها شيء؟
Dialogue: 0,0:26:16.69,0:26:18.72,Default,Spilik2,0,0,0,,لم تعد إلى المنزل.
Dialogue: 0,0:26:20.62,0:26:23.59,Default,Spikyulka2,0,0,0,,أعتقد أنها ذهبت إلى مكان آخر لأنها شعرت بالذنب أمامك.
Dialogue: 0,0:26:23.99,0:26:26.66,Default,Spikyulka2,0,0,0,,سألت عنها. لا تقلق كثيرا.
Dialogue: 0,0:26:27.70,0:26:29.56,Default,Spikyulka2,0,0,0,,لقد أخبرتها مرات عديدة، لكنها مرة أخرى...
Dialogue: 0,0:26:29.73,0:26:32.07,Default,Spilik2,0,0,0,,أنا أبحث عن هديتك لها.
Dialogue: 0,0:26:33.54,0:26:36.67,Default,Spikyulka2,0,0,0,,إذا ذهبت إلى مكان آخر، كان يجب عليها بيعه.
Dialogue: 0,0:26:37.87,0:26:39.24,Default,Spilik2,0,0,0,,أنا خائفة،
Dialogue: 0,0:26:40.08,0:26:41.78,Default,Spilyk2,0,0,0,,أنني سأفقد كل شعبي.
Dialogue: 0,0:26:44.58,0:26:47.02,Default,Spilik2,0,0,0,,متى سيعود الملك إلى القصر؟
Dialogue: 0,0:26:47.48,0:26:48.55,Default,Spikyulka2,0,0,0,,سيبقى
Dialogue: 0,0:26:49.55,0:26:50.72,Default,Spikyulka2,0,0,0,,ليلة أخرى.
Dialogue: 0,0:26:53.76,0:26:55.36,Default,Spikyulka2,0,0,0,,ليس هذا ما تعتقده.
Dialogue: 0,0:26:55.96,0:26:57.89,Default,Spikyulka2,0,0,0,,لا أستطيع أن أخبرك بالتفاصيل،
Dialogue: 0,0:26:57.89,0:27:01.00,Default,Spikyulka2,0,0,0,,ولكن الليلة سيتم حل كل شيء.
Dialogue: 0,0:27:02.20,0:27:03.83,Default,Spikyulka2,0,0,0,,ليس الأمر أن الملك قد
Dialogue: 0,0:27:04.80,0:27:07.47,Default,Spikyulka2,0,0,0,,العديد من الاهتمامات الأخرى،
Dialogue: 0,0:27:08.30,0:27:10.61,Default,Spikyulka2,0,0,0,,لقد تغيرت مشاعره تجاهي.
Dialogue: 0,0:27:12.24,0:27:16.54,Default,Spikyulka2,0,0,0,,على ما يبدو، أنا الوحيد المتشبث بذكريات الطفولة.
Dialogue: 0,0:27:17.21,0:27:19.05,Default,Biryulka2,0,0,0,,أتذكر كيف عدت إلى العاصمة
Dialogue: 0,0:27:19.91,0:27:22.88,Default,Spikyulka2,0,0,0,,وقد التقيت بك وبالملك منذ عامين.
Dialogue: 0,0:27:23.35,0:27:26.02,Default,Spikyulka2,0,0,0,,حتى لو رآك ذلك اليوم للمرة الأولى،
Dialogue: 0,0:27:28.16,0:27:29.19,Default,Spilyk2,0,0,0,,بالتأكيد
Dialogue: 0,0:27:30.19,0:27:31.89,Default,Spilik2,0,0,0,,سأحب ذلك.
Dialogue: 0,0:27:35.86,0:27:39.17,Default,Spilik2,0,0,0,,كلماتك تشجعني.
Dialogue: 0,0:27:47.98,0:27:49.98,Default,Spilyk2,0,0,0,,هل هذا فطورك المعتاد؟
Dialogue: 0,0:27:50.95,0:27:53.65,Default,Spikyulka2,0,0,0,,أريد أن أتحسن. \Nلماذا تحتاج إلى التسكع هنا ليلة أخرى؟
Dialogue: 0,0:27:53.95,0:27:56.85,Default,Spilik2,0,0,0,,لأعتني بك يا ملكتي.
Dialogue: 0,0:27:57.89,0:27:59.95,Default,Spikyulka2,0,0,0,,الأطباء يعالجون، والصيادلة يعطون الأدوية.
Dialogue: 0,0:28:00.12,0:28:02.49,Default,Spikyulka2,0,0,0,,والملك يهتم بالسياسة، وليس بصحتي.
Dialogue: 0,0:28:02.92,0:28:04.79,Default,Spikyulka2,0,0,0,,هل تعلم كم يعاني الناس؟
Dialogue: 0,0:28:04.79,0:28:08.53,Default,Spilik2,0,0,0,,أنت تقولين الحقيقة يا ملكة.
Dialogue: 0,0:28:08.53,0:28:10.53,Default,Spikyulka2,0,0,0,,هيا تناول حساء السلحفاة
Dialogue: 0,0:28:10.53,0:28:11.90,Default,Spikyulka2,0,0,0,,واذهب للعمل كملك.
Dialogue: 0,0:28:12.70,0:28:14.57,Default,Spilik2,0,0,0,,لا تهمل تضحية السلحفاة.
Dialogue: 0,0:28:16.17,0:28:18.01,Default,Spikyulka2,0,0,0,,أفضل أن أذهب بدلاً من قبول تضحيتها
Dialogue: 0,0:28:18.37,0:28:21.48,Default,Spikyulka2,0,0,0,,دعونا نرى كيف يعيش عامة الناس.
Dialogue: 0,0:28:22.88,0:28:24.55,Default,Spikyulka2,0,0,0,,سأعود متأخراً،
Dialogue: 0,0:28:25.68,0:28:27.08,Default,Spikyulka2,0,0,0,,مما يعني أنه عليك البقاء ليلة أخرى.
Dialogue: 0,0:28:30.29,0:28:32.09,Default,Spikyulka2,0,0,0,,ألا تريد أن تتسكع في القصر أيضاً؟
Dialogue: 0,0:28:32.75,0:28:35.16,Default,Spikyulka2,0,0,0,,إنه لأمر فظيع أن تكون هناك أسوأ مما كنت عليه في منزل أقاربك.
Dialogue: 0,0:28:37.73,0:28:40.90,Default,Spikyulka2,0,0,0,,نعم، المكان لطيف ومريح هنا.
Dialogue: 0,0:28:43.33,0:28:45.33,Default,Spilik2,0,0,0,,أي نوع من الأشخاص هي الملكة الأرملة؟
Dialogue: 0,0:28:45.53,0:28:47.80,Default,Spikyulka2,0,0,0,,إنها أخت السيد كيم جواجيون
Dialogue: 0,0:28:47.84,0:28:51.37,Default,Spikyulka2,0,0,0,,ولم تغادر القصر منذ وصولها.
Dialogue: 0,0:28:51.37,0:28:53.24,Default,Spikyulka2,0,0,0,,ماذا لو قدمت لشخص لم يسبق له مثيل
Dialogue: 0,0:28:53.24,0:28:55.94,Default,Silk2,0,0,0,,لم يغادر القصر، أطباق من الخارج...
Dialogue: 0,0:28:55.94,0:28:57.01,Default,Spilik2,0,0,0,,أنت تعلم...
Dialogue: 0,0:28:57.61,0:29:00.32,Default,Spilik2,0,0,0,,في الأعمال الدرامية التاريخية، يأكلون "غوكباب" دائماً.
Dialogue: 0,0:29:00.32,0:29:01.45,Default,Spilik2,0,0,0,,كيف يبدو مذاقها؟
Dialogue: 0,0:29:02.28,0:29:04.85,Default,Spilyk2,0,0,0,,كيف يمكنني معرفة طعم مثل هذا الطعام البسيط؟
Dialogue: 0,0:29:18.30,0:29:19.87,Default,Spilik2,0,0,0,,ليس مذهلاً.
Dialogue: 0,0:29:22.70,0:29:25.44,Default,Spikyulka2,0,0,0,,ما تفتقده يمكن أن يصبح سلاحًا رهيبًا.
Dialogue: 0,0:29:32.15,0:29:34.08,Default,Spikyulka2,0,0,0,,لقد صنعوا مرقاً من لحم الصدر والفجل الأبيض،
Dialogue: 0,0:29:34.08,0:29:36.08,Default,Biryulka2,0,0,0,,متبل بمعجون فول الصويا وسخن الأرز به.
Dialogue: 0,0:29:37.32,0:29:39.59,Default,Spilyk2,0,0,0,,فيها الكثير من اللحم. متواضعة، ولكن لها سحرها الخاص.
Dialogue: 0,0:29:40.22,0:29:42.42,Default,Biryulka2,0,0,0,,الكيمتشي الفجل المصنوع بدون المأكولات البحرية المملحة،
Dialogue: 0,0:29:42.42,0:29:44.26,Default,Spilik2,0,0,0,,لأن كل شيء يسير على ما يرام دون أن يطغى المذاق.
Dialogue: 0,0:29:44.56,0:29:46.69,Default,Silk2,0,0,0,,يقولون أن "هونغجونغ" كان يأكل دائمًا "كوكباب" خارج القصر.
Dialogue: 0,0:29:50.60,0:29:51.93,Default,ليلي,0,0,0,,اللعنة.
Dialogue: 0,0:29:52.57,0:29:55.44,Default,Lily,0,0,0,,هرب الجار دون أن يدفع الضرائب،\NI يجب أن يدفع ثمنه.
Dialogue: 0,0:29:55.60,0:29:57.31,Default,Lily,0,0,0,,هذه سرقة حقيقية.
Dialogue: 0,0:29:57.41,0:29:58.77,Default,ليلي,0,0,0,,عض لسانك.
Dialogue: 0,0:29:59.14,0:30:00.81,Default,ليلي,0,0,0,,هل تريد أن تُضرب بالعصي؟
Dialogue: 0,0:30:00.81,0:30:03.08,Default,ليلي,0,0,0,,سأموت وأنا أعض لساني،
Dialogue: 0,0:30:03.08,0:30:05.85,Default,Lily,0,0,0,,وإلا سأهرب وأصبح قاطع طريق - هناك خياران.
Dialogue: 0,0:30:05.85,0:30:09.12,Default,ليلي,0,0,0,,هل تعض على لسانك؟ نعم، ليس لدي ما أخسره!
Dialogue: 0,0:30:09.22,0:30:12.89,Default,ليلي,0,0,0,,إنهم يتقشرون مثل اللزج. أين ينظر الملك؟!
Dialogue: 0,0:30:13.62,0:30:15.06,Default,ليلي,0,0,0,,ماذا تريد؟
Dialogue: 0,0:30:15.06,0:30:17.13,Default,ليلي,0,0,0,,بالطبع يمزق.
Dialogue: 0,0:30:17.13,0:30:19.39,Default,ليلي,0,0,0,,الدمية التي أعطيت العرش لتغلق
Dialogue: 0,0:30:19.39,0:30:22.00,Default,ليلي,0,0,0,,كل العيون، وفعلوا ما أرادوا.
Dialogue: 0,0:30:22.00,0:30:23.43,Default,ليلي,0,0,0,,اللعنة.
Dialogue: 0,0:30:27.50,0:30:29.24,Default,ليلي,0,0,0,,توقف.
Dialogue: 0,0:30:32.11,0:30:33.64,Default,ليلي,0,0,0,,لقد سمعتك.
Dialogue: 0,0:30:33.94,0:30:36.44,Default,ليلي,0,0,0,,لقد مررت بالكثير.
Dialogue: 0,0:30:38.18,0:30:41.85,Default,Lily,0,0,0,,بسبب ملك غبي، يموت الناس.
Dialogue: 0,0:30:42.78,0:30:45.39,Default,ليلي,0,0,0,,اشرب وانسى أحزانك.
Dialogue: 0,0:30:46.39,0:30:48.69,Default,ليلي,0,0,0,,أنتما متشابهتان
Dialogue: 0,0:30:48.69,0:30:51.06,Default,ليلي,0,0,0,,لشخص ذو منصب رفيع.
Dialogue: 0,0:30:54.00,0:30:55.30,Default,ليلي,0,0,0,,التظاهر بأنك أرستقراطي.
Dialogue: 0,0:30:56.23,0:30:58.13,Default,Lily,0,0,0,,أغلى شيء كان النسب.
Dialogue: 0,0:30:58.13,0:31:01.37,Default,ليلي,0,0,0,,بدون ملابس ونسب - أنا متسول عادي.
Dialogue: 0,0:31:04.04,0:31:05.91,Default,ليلي,0,0,0,,الشباب اليوم يبدو نبيلاً،
Dialogue: 0,0:31:05.91,0:31:08.24,Default,Lily,0,0,0,,لكنهم في الحقيقة حمقى مثلك.
Dialogue: 0,0:31:08.31,0:31:09.34,Default,ليلي,0,0,0,,كيف تجرؤين؟
Dialogue: 0,0:31:10.08,0:31:11.88,Default,ليلي,0,0,0,,نعم، بلادنا دمية.
Dialogue: 0,0:31:11.88,0:31:14.82,Default,Lily,0,0,0,,إذا كان لدى الناس شيء ما بالداخل، فسيتم أخذ\Nit منهم أيضاً.
Dialogue: 0,0:31:16.28,0:31:17.79,Default,ليلي,0,0,0,,مضحك.
Dialogue: 0,0:31:18.29,0:31:20.56,Default,ليلي,0,0,0,,هذا الرجل النبيل
Dialogue: 0,0:31:20.56,0:31:23.56,Default,Lily,0,0,0,,-طريقة مثيرة للاهتمام للنظر إلى الأشياء.\N-مضحك.
Dialogue: 0,0:31:23.56,0:31:26.63,Default,Lily,0,0,0,,أصبح رجل من عائلة من الخونة ملكاً.
Dialogue: 0,0:31:26.63,0:31:28.86,Default,Lily,0,0,0,,كل شيء فاسد تماماً.
Dialogue: 0,0:31:28.86,0:31:30.87,Default,Lily,0,0,0,,أين شوهد شخص من عائلة،
Dialogue: 0,0:31:30.87,0:31:34.00,Default,ليلي,0,0,0,,الذي ارتكب الخيانة لأجيال،
Dialogue: 0,0:31:34.00,0:31:36.10,Default,ليلي,0,0,0,,أصبح ملكاً؟
Dialogue: 0,0:31:36.10,0:31:39.41,Default,Lily,0,0,0,,ماذا كان يفكر الملك عند قبول العرش؟
Dialogue: 0,0:31:39.97,0:31:41.88,Default,ليلي,0,0,0,,يعيش في سلطة آل كيم،
Dialogue: 0,0:31:41.88,0:31:44.81,Default,ليلي,0,0,0,,قتل جبان عائلته بأكملها.
Dialogue: 0,0:31:44.81,0:31:45.95,Default,ليلي,0,0,0,,بالضبط.
Dialogue: 0,0:31:46.08,0:31:48.58,Default,Lily,0,0,0,,-اللعنة.\N-وهذا صحيح.
Dialogue: 0,0:31:48.58,0:31:50.62,Default,Lily,0,0,0,,لقد تجاوزت الخط.
Dialogue: 0,0:31:52.52,0:31:55.06,Default,ليلي,0,0,0,,أنت حر في لعن الملك،
Dialogue: 0,0:31:57.86,0:32:00.66,Default,Lilia,0,0,0,,لكن لا تجرؤ على مناقشة عائلته!
Dialogue: 0,0:32:00.70,0:32:03.06,Default,Lily,0,0,0,,هناك خط لا يمكن تجاوزه!
Dialogue: 0,0:32:03.87,0:32:05.00,Default,ليلي,0,0,0,,هل تعتقد،
Dialogue: 0,0:32:05.10,0:32:07.07,Default,ليلي,0,0,0,,هل كونك ملكاً يعني أن تعيش حياة مترفة؟
Dialogue: 0,0:32:07.07,0:32:09.04,Default,ليلي,0,0,0,,إنه يخاف باستمرار من التعرض للتسمم
Dialogue: 0,0:32:09.04,0:32:10.44,Default,ليلي,0,0,0,,أو مقطوعة الرأس. هذا قاسي!
Dialogue: 0,0:32:10.64,0:32:12.81,Default,ليلي,0,0,0,,هل أنت من القصر؟
Dialogue: 0,0:32:12.94,0:32:15.51,Default,ليلي,0,0,0,,هل أنتم ممثلون عن الملك؟
Dialogue: 0,0:32:15.71,0:32:17.01,Default,ليلي,0,0,0,,من أنت؟
Dialogue: 0,0:32:17.31,0:32:19.48,Default,ليلي,0,0,0,,أنا؟ نعم أنا كذلك
Dialogue: 0,0:32:23.38,0:32:24.89,Default,ليلي,0,0,0,,من نادي معجبي الملك.
Dialogue: 0,0:32:25.59,0:32:26.96,Default,ليلي,0,0,0,,-ما هذا؟\N-ما هذا؟
Dialogue: 0,0:32:28.86,0:32:30.02,Default,ليلي,0,0,0,,نادي المعجبين؟
Dialogue: 0,0:32:30.16,0:32:31.99,Default,Lily,0,0,0,,أعداء المعجبين هم معجبون أيضًا.
Dialogue: 0,0:32:32.29,0:32:35.93,Default,ليلي,0,0,0,,حسنًا، ناقش عائلته مرة أخرى على الأقل،
Dialogue: 0,0:32:36.06,0:32:38.73,Default,ليلي,0,0,0,,سأقلب الطاولة من أجلك!
Dialogue: 0,0:32:39.13,0:32:42.40,Default,ليلي,0,0,0,,-هل أخطأت ذلك؟\N-حسناً، حسناً.
Dialogue: 0,0:32:42.40,0:32:44.04,Default,ليلي,0,0,0,,لا تقترب!
Dialogue: 0,0:32:44.04,0:32:45.17,Default,ليلي,0,0,0,,عذراً.
Dialogue: 0,0:32:45.27,0:32:46.84,Default,ليلي,0,0,0,,أدخلنا!
Dialogue: 0,0:32:46.84,0:32:48.24,Default,ليلي,0,0,0,,تعال هنا.
Dialogue: 0,0:32:48.24,0:32:50.88,Default,ليلي,0,0,0,,واو.
Dialogue: 0,0:32:51.18,0:32:53.08,Default,ليلي,0,0,0,,يا لها من شخصية.
Dialogue: 0,0:32:53.08,0:32:54.65,Default,ليلي,0,0,0,,دعني أذهب. اتركه.
Dialogue: 0,0:32:55.08,0:32:56.82,Default,ليلي,0,0,0,,لست منزعجاً.
Dialogue: 0,0:32:58.32,0:32:59.69,Default,ليلي,0,0,0,,قلت أنك تتظاهر.
Dialogue: 0,0:33:00.19,0:33:01.99,Default,ليلي,0,0,0,,كان من المستحيل أن تكشف عن نفسك.
Dialogue: 0,0:33:01.99,0:33:03.26,Default,ليلي,0,0,0,,لقد غضبت بدلاً منك.
Dialogue: 0,0:33:09.63,0:33:10.93,Default,ليلي,0,0,0,,ماذا؟ حسنًا؟
Dialogue: 0,0:33:12.10,0:33:13.87,Default,ليلي,0,0,0,,أنت ممثلة رائعة.
Dialogue: 0,0:33:14.84,0:33:17.01,Default,ليلي,0,0,0,,هل تعرف حتى ماذا يعني هذا؟
Dialogue: 0,0:33:17.71,0:33:19.17,Default,ليلي,0,0,0,,أليس هذا شيئاً جيداً؟
Dialogue: 0,0:33:20.21,0:33:22.54,Default,Lily,0,0,0,,بالمناسبة، ما هو نادي المعجبين؟
Dialogue: 0,0:33:24.21,0:33:26.31,Default,ليلي,0,0,0,,هؤلاء أناس نبلاء،
Dialogue: 0,0:33:26.31,0:33:28.62,Default,ليلي,0,0,0,,من يتمنى السعادة لشخص ما
Dialogue: 0,0:33:28.62,0:33:29.95,Default,ليلي,0,0,0,,والنجاح من أعماق قلبي.
Dialogue: 0,0:33:30.89,0:33:32.79,Default,ليلي,0,0,0,,إنه مثل المرشد الروحي.
Dialogue: 0,0:33:34.79,0:33:36.09,Default,ليلي,0,0,0,,والمناهضين للمعجبين؟
Dialogue: 0,0:33:37.73,0:33:38.79,Default,ليلي,0,0,0,,دعني أفكر.
Dialogue: 0,0:33:39.66,0:33:43.16,Default,Lily,0,0,0,,هل هناك من يهتم بهذا الشخص أكثر من المعجبين؟
Dialogue: 0,0:33:45.20,0:33:47.04,Default,ليلي,0,0,0,,مرشد أكثر تأثيراً.
Dialogue: 0,0:33:48.64,0:33:51.81,Default,ليلي,0,0,0,,أنا لا أستحق مشاعرك تجاهي.
Dialogue: 0,0:33:54.28,0:33:56.28,Default,ليلي,0,0,0,,أسقطه. إذا تم عزلي
Dialogue: 0,0:33:56.28,0:33:57.85,Default,Lily,0,0,0,,سأبيع كوكباب.
Dialogue: 0,0:33:58.61,0:33:59.78,Default,ليلي,0,0,0,,لا تقل هذا.
Dialogue: 0,0:34:00.65,0:34:02.48,Default,ليلي,0,0,0,,لن أدع هذا يحدث.
Dialogue: 0,0:34:03.45,0:34:05.39,Default,ليلي,0,0,0,,أنا من معارضتك أيضًا.
Dialogue: 0,0:34:05.69,0:34:08.32,Default,ليلي,0,0,0,,بالطبع. هدأني.
Dialogue: 0,0:34:09.66,0:34:11.56,Default,Lily,0,0,0,,الآن نذهب في اتجاهات مختلفة.
Dialogue: 0,0:34:11.56,0:34:13.06,Default,ليلي,0,0,0,,لدينا أهداف مختلفة.
Dialogue: 0,0:34:14.43,0:34:17.77,Default,Lily,0,0,0,,أين يوجد مطعم جيد،\Nأين يصطف الناس؟
Dialogue: 0,0:34:20.84,0:34:23.17,Default,Lily,0,0,0,,"An" تعني ملائم، "ti"...
Dialogue: 0,0:34:24.34,0:34:25.37,Default,ليلي,0,0,0,,معجبة؟
Dialogue: 0,0:34:26.61,0:34:29.24,Default,Lily,0,0,0,,أعتقد أنني أبليت حسناً بما فيه الكفاية في دراستي.
Dialogue: 0,0:34:29.94,0:34:31.41,Default,Lily,0,0,0,,هناك شيء يجب العمل عليه.
Dialogue: 0,0:34:35.45,0:34:37.45,Default,ليلي,0,0,0,,-جرب.\N-يا رب.
Dialogue: 0,0:34:37.45,0:34:38.99,Default,ليلي,0,0,0,,-الكثير.\N-يا إلهي.
Dialogue: 0,0:34:38.99,0:34:41.02,Default,ليلي,0,0,0,,-اشتري يا سيدتي.\N-حاول.
Dialogue: 0,0:34:41.02,0:34:43.69,Default,ليلي,0,0,0,,-اشتري.\N-ماذا تفعلين؟
Dialogue: 0,0:34:43.69,0:34:45.49,Default,ليلي,0,0,0,,لذيذ على ما أعتقد.
Dialogue: 0,0:35:03.91,0:35:05.78,Default,ليلي,0,0,0,,خائفة، ماذا تفعلين؟
Dialogue: 0,0:35:05.78,0:35:08.12,Default,ليلي,0,0,0,,سوف تذهب إلى زقاق خلفي بملابس باهظة الثمن،
Dialogue: 0,0:35:08.12,0:35:09.55,Default,ليلي,0,0,0,,سوف تصبح هدفاً.
Dialogue: 0,0:35:10.65,0:35:12.42,Default,ليلي,0,0,0,,-ما الهدف؟\N-من لدينا هنا؟
Dialogue: 0,0:35:12.42,0:35:14.36,Default,Lily,0,0,0,,ماذا نسي هؤلاء الأغنياء هنا؟
Dialogue: 0,0:35:15.46,0:35:17.13,Default,Lily,0,0,0,,هذا ما كنت أتحدث عنه.
Dialogue: 0,0:35:17.43,0:35:19.96,Default,ليلي,0,0,0,,ابتعد. أنا لا أريد أن يؤذيك.
Dialogue: 0,0:35:21.40,0:35:22.63,Default,ليلي,0,0,0,,هل تحب الفتاة؟
Dialogue: 0,0:35:22.63,0:35:24.37,Default,ليلي,0,0,0,,عبثاً.
Dialogue: 0,0:35:24.87,0:35:27.30,Default,ليلي,0,0,0,,لا تحلمي بذلك حتى،
Dialogue: 0,0:35:27.30,0:35:29.60,Default,ليلي,0,0,0,,إنني وحدي هنا.
Dialogue: 0,0:35:30.47,0:35:32.17,Default,ليلي,0,0,0,,لقد لاحظت هذا من قبل.
Dialogue: 0,0:35:32.17,0:35:35.71,Default,Lily,0,0,0,,أنت تعبر عن نفسك بشكل جيد،\Nمثل لص متعلم.
Dialogue: 0,0:35:36.31,0:35:38.11,Default,ليلي,0,0,0,,-كن مهذباً.\N-نعم.
Dialogue: 0,0:35:38.11,0:35:40.98,Default,Lily,0,0,0,,لا تقلق، لن أسيء إليك.
Dialogue: 0,0:35:41.98,0:35:44.42,Default,ليلي,0,0,0,,أنا ضد معجبتك.
Dialogue: 0,0:35:47.36,0:35:48.56,Default,ليلي,0,0,0,,ماذا قلت؟
Dialogue: 0,0:35:56.90,0:35:58.23,Default,ليلي,0,0,0,,خائفة.
Dialogue: 0,0:35:59.27,0:36:00.97,Default,ليلي,0,0,0,,أينما كنت،
Dialogue: 0,0:36:00.97,0:36:02.60,Default,ليلي,0,0,0,,لا تمشي في الأماكن النائية.
Dialogue: 0,0:36:04.41,0:36:05.87,Default,ليلي,0,0,0,,اعتني بهم يا تشيولجونغ.
Dialogue: 0,0:36:11.28,0:36:13.25,Default,ليلي,0,0,0,,وإذا حدث له شيء،
Dialogue: 0,0:36:14.65,0:36:16.42,Default,ليلي,0,0,0,,هل سيتغير التاريخ؟
Dialogue: 0,0:36:17.62,0:36:21.86,Default,ليلي,0,0,0,,مرحبًا! أنا من القوات الخاصة!
Dialogue: 0,0:36:24.46,0:36:25.59,Default,ليلي,0,0,0,,هل فقدت بالفعل؟
Dialogue: 0,0:36:28.56,0:36:29.60,Default,ليلي,0,0,0,,تشولجونغ.
Dialogue: 0,0:36:30.57,0:36:31.70,Default,ليلي,0,0,0,,هل أنت ميت؟
Dialogue: 0,0:36:34.07,0:36:35.84,Default,ليلي,0,0,0,,كيف يمكنني العودة إلى المنزل؟
Dialogue: 0,0:36:35.84,0:36:38.37,Default,ليلي,0,0,0,,واو، لماذا سيدة غنية...
Dialogue: 0,0:36:39.17,0:36:41.78,Default,Lilia,0,0,0,,ظننت أنها عادت لأنها كانت قلقة علي.
Dialogue: 0,0:36:42.44,0:36:44.58,Default,Lily,0,0,0,,وأنت لا تعرف الطريق إلى المنزل.
Dialogue: 0,0:36:45.05,0:36:46.58,Default,ليلي,0,0,0,,ماذا عن هؤلاء البلطجية؟
Dialogue: 0,0:36:47.18,0:36:50.08,Default,ليلي,0,0,0,,ركضت خلف الرجل الذي يرتدي ملابس باهظة الثمن.
Dialogue: 0,0:36:51.45,0:36:54.49,Default,Lily,0,0,0,,لا تقلق، لن أسيء إليك.
Dialogue: 0,0:36:55.62,0:36:58.06,Default,ليلي,0,0,0,,أنا ضد معجبتك.
Dialogue: 0,0:37:01.30,0:37:02.53,Default,ليلي,0,0,0,,ماذا قلت؟
Dialogue: 0,0:37:03.56,0:37:06.27,Default,ليلي,0,0,0,,وقتنا ليس هادئاً جداً،
Dialogue: 0,0:37:06.27,0:37:08.87,Default,ليلي,0,0,0,,تدير ظهرك.
Dialogue: 0,0:37:08.87,0:37:11.01,Default,Lily,0,0,0,,أعتقد أنك تفهم ما أوقعت نفسك فيه.
Dialogue: 0,0:37:11.44,0:37:13.24,Default,ليلي,0,0,0,,واو. مجرد قصيدة.
Dialogue: 0,0:37:14.18,0:37:16.14,Default,ليلي,0,0,0,,من إمبراطورية تشينغ؟
Dialogue: 0,0:37:16.14,0:37:18.48,Default,Lily,0,0,0,,إنها جميلة، إذا بعناها،\N يمكننا أن نأكل لمدة خمسة أيام.
Dialogue: 0,0:37:18.48,0:37:19.55,Default,ليلي,0,0,0,,دعونا نخلعها.
Dialogue: 0,0:37:26.69,0:37:28.96,Default,ليلي,0,0,0,,لا تدير ظهرك.
Dialogue: 0,0:37:33.90,0:37:35.26,Default,ليلي,0,0,0,,أنا لم أقتله.
Dialogue: 0,0:37:37.06,0:37:39.33,Default,Lily,0,0,0,,لكنني سأقتل بالتأكيد الشخص التالي الذي يندفع.
Dialogue: 0,0:37:49.38,0:37:52.15,Default,ليلي,0,0,0,,لماذا هو على الأرض؟
Dialogue: 0,0:37:52.75,0:37:54.08,Default,ليلي,0,0,0,,لقد شربت كثيراً.
Dialogue: 0,0:37:59.79,0:38:01.92,Default,ليلي,0,0,0,,أنت محظوظة جداً.
Dialogue: 0,0:38:04.96,0:38:06.23,Default,ليلي,0,0,0,,ماذا عن ملابسك؟
Dialogue: 0,0:38:06.99,0:38:10.06,Default,ليلي,0,0,0,,لا أستطيع المرور دون أن يلاحظني أحد
Dialogue: 0,0:38:10.06,0:38:11.90,Default,ليلي,0,0,0,,في ملابس باهظة الثمن.
Dialogue: 0,0:38:16.87,0:38:17.97,Default,ليلي,0,0,0,,ماذا تفعلين؟
Dialogue: 0,0:38:17.97,0:38:19.97,Default,ليلي,0,0,0,,أحتاج لشراء شيء ما.
Dialogue: 0,0:38:19.97,0:38:21.98,Default,ليلي,0,0,0,,تركت على عجل، ولم تأخذ المال.
Dialogue: 0,0:38:22.78,0:38:25.31,Default,Lily,0,0,0,,-ممتاز.\N-أنت تسرق لصاً.
Dialogue: 0,0:38:25.58,0:38:27.62,Default,ليلي,0,0,0,,لا.
Dialogue: 0,0:38:27.98,0:38:31.49,Default,ليلي,0,0,0,,عرض. ليس من العدل أن تأخذ كل شيء لنفسك.
Dialogue: 0,0:38:35.56,0:38:37.36,Default,ليلي,0,0,0,,أكل كوكبابا.
Dialogue: 0,0:38:41.00,0:38:42.03,Default,ليلي,0,0,0,,انتظر.
Dialogue: 0,0:38:43.20,0:38:45.73,Default,ليلي,0,0,0,,-لنذهب.\N-ماذا تريد أن تشتري؟
Dialogue: 0,0:38:51.87,0:38:52.87,Default,ليلي,0,0,0,,تابع.
Dialogue: 0,0:38:55.11,0:38:57.21,Default,ليلي,0,0,0,,لقد قاتل بمهارة.
Dialogue: 0,0:38:57.95,0:38:59.61,Default,ليلي,0,0,0,,بالحكم على الطريقة التي كان يحرس بها الغرفة،
Dialogue: 0,0:39:00.38,0:39:02.12,Default,Lily,0,0,0,,أعتقد أن العنصر موجود.
Dialogue: 0,0:39:02.12,0:39:04.75,Default,ليلي,0,0,0,,هل يمكنك التعرف عليه إذا التقيت به مرة أخرى؟
Dialogue: 0,0:39:05.92,0:39:07.72,Default,ليلي,0,0,0,,بالطبع. سيد،
Dialogue: 0,0:39:09.62,0:39:11.03,Default,ليلي,0,0,0,,أحتاج إلى دواء.
Dialogue: 0,0:39:16.76,0:39:18.57,Default,ليلي,0,0,0,,لقد أوضحت نفسي.
Dialogue: 0,0:39:19.10,0:39:21.37,Default,Lily,0,0,0,,لن يكون هناك علاج إذا فشلت.
Dialogue: 0,0:39:21.80,0:39:23.30,Default,ليلي,0,0,0,,كيف ستعوضني؟
Dialogue: 0,0:39:23.84,0:39:26.01,Default,ليلي,0,0,0,,هل تعطيني يدك لأقطعها؟
Dialogue: 0,0:39:26.44,0:39:28.01,Default,ليلي,0,0,0,,سوف أعوضك.
Dialogue: 0,0:39:29.64,0:39:30.98,Default,ليلي,0,0,0,,أقسم بحياتي.
Dialogue: 0,0:39:43.56,0:39:45.43,Default,,0,0,0,,هنا! خمن ما هو.
Dialogue: 0,0:39:45.66,0:39:48.43,Default,,0,0,0,,سفينة قمرية من سلالة كوريو.
Dialogue: 0,0:39:48.86,0:39:51.33,Default,,0,0,0,,بجدية؟ إنها قيمة.
Dialogue: 0,0:39:51.73,0:39:53.63,Default,,0,0,0,,-كم تكلفتها؟\N -إنها مزيفة.
Dialogue: 0,0:39:54.77,0:39:57.10,Default,,0,0,0,,اشتره إذا كنت تخطط لاستخدامه للدفاع عن نفسك مرة أخرى.
Dialogue: 0,0:39:58.64,0:40:00.17,Default,,0,0,0,,يا له من محتال.
Dialogue: 0,0:40:07.92,0:40:09.05,Default,,0,0,0,,اختر واحدًا.
Dialogue: 0,0:40:13.42,0:40:14.49,Default,,0,0,0,,أراهن بكل شيء.
Dialogue: 0,0:40:15.09,0:40:18.73,Default,,0,0,0,,واو، لا يمكنك المراهنة بهذا القدر من المال.
Dialogue: 0,0:40:18.73,0:40:20.76,Default,,0,0,0,,هذا مجتمع رأسمالي،\Nحيث يربح المال.
Dialogue: 0,0:40:21.00,0:40:22.50,Default,,0,0,0,,-أراهن بكل شيء.\N-عذراً.
Dialogue: 0,0:40:22.50,0:40:23.96,Default,,0,0,0,,-ماذا تفعلين؟\N-سيدتي.
Dialogue: 0,0:40:23.96,0:40:25.07,Default,,0,0,0,,سيدة.
Dialogue: 0,0:40:25.07,0:40:26.70,Default,,0,0,0,,-فتح.\N -فتح.
Dialogue: 0,0:40:28.94,0:40:31.91,Default,,0,0,0,,مثل هذا المحتال يجب أن يكون لديه\N عصابته بالقرب من الطاولة.
Dialogue: 0,0:40:32.37,0:40:36.01,Default,,0,0,0,,أنا متأكد من أن جميع المتفرجين موجودون هناك لدعوتك إلى اللعبة.
Dialogue: 0,0:40:37.04,0:40:39.68,Default,,0,0,0,,لقد ولدت ملكاً.
Dialogue: 0,0:40:39.68,0:40:42.45,Default,,0,0,0,,وما زال يبدو أنك تعرف الشوارع من الداخل والخارج.
Dialogue: 0,0:40:42.92,0:40:45.62,Default,,0,0,0,,وانكر بكل قوته.
Dialogue: 0,0:40:51.03,0:40:52.76,Default,,0,0,0,,هذه نقطة ضعفي.
Dialogue: 0,0:40:56.50,0:40:58.57,Default,,0,0,0,,لقد دمرت عائلتي بحجة الخيانة.
Dialogue: 0,0:40:59.87,0:41:01.00,Default,,0,0,0,,الأمير كانغهوادو.
Dialogue: 0,0:41:02.34,0:41:05.21,Default,,0,0,0,,تاريخ عائلتي هو نقطة ضعفي\Nالتي تدمرني.
Dialogue: 0,0:41:08.21,0:41:09.74,Default,,0,0,0,,تراودك كوابيس
Dialogue: 0,0:41:09.74,0:41:11.41,Default,,0,0,0,,كيف يوبخونك في المحكمة أم ماذا؟
Dialogue: 0,0:41:14.25,0:41:17.95,Default,,0,0,0,,الكابوس الحقيقي ليس ما أحلم به.
Dialogue: 0,0:41:19.59,0:41:21.26,Default,,0,0,0,,كابوس حقيقي...
Dialogue: 0,0:41:28.33,0:41:29.80,Default,,0,0,0,,لماذا توقفت في منتصف الجملة؟
Dialogue: 0,0:41:30.80,0:41:32.70,Default,,0,0,0,,نسيت ما كنت سأقوله.
Dialogue: 0,0:41:32.70,0:41:33.73,افتراضي,,0,0,0,,في الواقع
Dialogue: 0,0:41:35.37,0:41:37.54,Default,,0,0,0,,أردت أن أطرح عليك سؤالاً.
Dialogue: 0,0:41:39.91,0:41:41.91,Default,,0,0,0,,لماذا لم تخبر أحداً عن تلك الليلة؟
Dialogue: 0,0:41:43.54,0:41:45.85,Default,,0,0,0,,-عن ماذا؟\N-أنني حاولت إيذاءك.
Dialogue: 0,0:41:47.08,0:41:50.42,Default,,0,0,0,,آه، هل تتحدث عن هذا؟ لا أريد الدخول في هذه الفوضى.
Dialogue: 0,0:41:50.79,0:41:54.09,Default,,0,0,0,,أريد فقط تجاوز كل الصعوبات.
Dialogue: 0,0:42:06.17,0:42:09.64,Default,,0,0,0,,نفضل أن يكون السلام في بلادنا،\Nأن ​​نكون خاملين بالفعل.
Dialogue: 0,0:42:10.77,0:42:13.64,Default,,0,0,0,,إنقاذ البلاد ليس من اهتماماتي على الإطلاق.
Dialogue: 0,0:42:16.61,0:42:17.65,Default,,0,0,0,,هنا.
Dialogue: 0,0:42:17.65,0:42:20.58,Default,,0,0,0,,أود أن أقف وألقي التحية.
Dialogue: 0,0:42:20.58,0:42:22.98,Default,,0,0,0,,نعم، نمت في الجبال الباردة،
Dialogue: 0,0:42:22.98,0:42:24.79,Default,,0,0,0,,جسدي كله يؤلمني.
Dialogue: 0,0:42:25.45,0:42:27.25,Default,,0,0,0,,لو بقيت هناك ليلة أخرى،
Dialogue: 0,0:42:27.25,0:42:29.02,Default,,0,0,0,,ستتخدر شفتاي الجميلتان.
Dialogue: 0,0:42:29.96,0:42:31.93,Default,,0,0,0,,-انتهى؟\N -ما الذي تتحدث عنه؟
Dialogue: 0,0:42:32.29,0:42:33.76,Default,,0,0,0,,أنتين.
Dialogue: 0,0:42:33.76,0:42:35.53,Default,,0,0,0,,وقليل من التفاخر.
Dialogue: 0,0:42:35.86,0:42:37.36,Default,,0,0,0,,لدي الكثير،
Dialogue: 0,0:42:37.36,0:42:39.90,Default,,0,0,0,,لكنني سأتوقف هنا -\Nit يبدو أن لديك أمراً مهماً.
Dialogue: 0,0:42:41.50,0:42:44.27,Default,,0,0,0,,حسنًا. ماذا هناك؟
Dialogue: 0,0:43:08.96,0:43:12.90,Default,,0,0,0,,سمعت أنك تصنع أفضل الأقنعة.
Dialogue: 0,0:43:15.60,0:43:16.84,Default,,0,0,0,,اختر شيئًا هناك.
Dialogue: 0,0:43:22.11,0:43:23.54,Default,,0,0,0,,واو يا أسنان...
Dialogue: 0,0:43:27.01,0:43:28.72,Default,,0,0,0,,لا أريد قناعًا عاديًا.
Dialogue: 0,0:43:29.08,0:43:32.29,Default,,0,0,0,,أفكر في بيع\N أقنعة فريدة للمسؤولين.
Dialogue: 0,0:43:32.62,0:43:33.72,Default,,0,0,0,,فريدة من نوعها؟
Dialogue: 0,0:43:37.56,0:43:42.13,Default,,0,0,0,,مؤخراً تبدو مثلي
Dialogue: 0,0:43:42.13,0:43:44.06,Default,,0,0,0,,وفي نفس الوقت لا.
Dialogue: 0,0:43:47.13,0:43:48.30,Default,,0,0,0,,اسكب الماء.
Dialogue: 0,0:43:49.60,0:43:51.11,Default,,0,0,0,,اسكب الماء.
Dialogue: 0,0:43:51.54,0:43:52.54,Default,,0,0,0,,نعم!
Dialogue: 0,0:43:53.94,0:43:55.14,Default,,0,0,0,,-رويال شيف.\N-نعم؟
Dialogue: 0,0:43:56.38,0:43:59.81,Default,,0,0,0,,الملكة الأرملة تريد وجبة خفيفة متأخرة.
Dialogue: 0,0:44:01.75,0:44:04.25,Default,,0,0,0,,لكنني لست متأكداً من قدرتك على فعل ذلك.
Dialogue: 0,0:44:05.09,0:44:06.29,Default,,0,0,0,,كيف حالك...
Dialogue: 0,0:44:07.62,0:44:09.82,Default,,0,0,0,,أعمل في المطبخ الملكي منذ 30 عاماً،
Dialogue: 0,0:44:09.82,0:44:12.03,Default,,0,0,0,,و12 منهم من قبل الشيف الملكي.
Dialogue: 0,0:44:12.73,0:44:15.66,Default,,0,0,0,,كيف يمكنني أن أكون أسوأ من الملكة؟ \NRather أفضل.
Dialogue: 0,0:44:23.84,0:44:25.47,Default,,0,0,0,,أنا أثق بك تماماً.
Dialogue: 0,0:44:42.66,0:44:44.43,Default,,0,0,0,,اللعنة. مرة أخرى.
Dialogue: 0,0:44:55.17,0:44:56.20,Default,,0,0,0,,مرة أخرى.
Dialogue: 0,0:45:18.09,0:45:19.59,Default,,0,0,0,,أسرع.
Dialogue: 0,0:45:25.43,0:45:26.53,Default,,0,0,0,,أهذا كل شيء؟
Dialogue: 0,0:45:27.87,0:45:31.77,Default,,0,0,0,,حلبت كل الأبقار في الحظيرة.
Dialogue: 0,0:45:31.94,0:45:35.21,Default,,0,0,0,,لم تبق قطرة حليب.
Dialogue: 0,0:45:36.01,0:45:37.18,Default,,0,0,0,,هراء!
Dialogue: 0,0:45:39.75,0:45:40.75,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:45:44.75,0:45:46.55,Default,,0,0,0,,أيها الأحمق الأعزل.
Dialogue: 0,0:46:02.34,0:46:03.57,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:46:09.38,0:46:11.65,Default,,0,0,0,,لقد غضبت فجأة، كل شيء يغيظني.
Dialogue: 0,0:46:11.81,0:46:13.18,Default,,0,0,0,,ولا هذا الجسد الحائر،
Dialogue: 0,0:46:13.18,0:46:14.58,Default,,0,0,0,,لست مستلقياً كرجل ميت،
Dialogue: 0,0:46:14.58,0:46:15.98,Default,,0,0,0,,لا تشبهني.
Dialogue: 0,0:46:16.05,0:46:19.35,Default,,0,0,0,,لا أعرف حتى إذا كان اسمي تشان سو يون\N أو كيم بونغ هوان.
Dialogue: 0,0:46:19.65,0:46:21.82,Default,,0,0,0,,حسناً، لقد عادت ذاكرتك،
Dialogue: 0,0:46:21.82,0:46:23.22,Default,,0,0,0,,لذا أنت في حيرة من أمرك.
Dialogue: 0,0:46:24.99,0:46:26.76,Default,,0,0,0,,هل تعرف ما هو أكثر ما أكرهه؟
Dialogue: 0,0:46:27.53,0:46:29.36,Default,,0,0,0,,لقد اعتدت على هذا الجسد.
Dialogue: 0,0:46:30.43,0:46:31.97,Default,,0,0,0,,ما الذي يجعلني مرتاحة في التنورة الآن.
Dialogue: 0,0:46:42.84,0:46:45.51,Default,,0,0,0,,ربما تكونين في دورتك الشهرية. \NI'll تجلب لك بعض الفوط.
Dialogue: 0,0:46:50.58,0:46:51.62,Default,,0,0,0,,لقد
Dialogue: 0,0:46:52.75,0:46:54.19,Default,,0,0,0,,شهرياً؟
Dialogue: 0,0:47:09.90,0:47:11.07,Default,,0,0,0,,سيدة البلاط جيون!
Dialogue: 0,0:47:11.57,0:47:13.37,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:47:14.14,0:47:16.71,Default,,0,0,0,,لماذا لم تعد الملكة إلى القصر بعد؟
Dialogue: 0,0:47:16.98,0:47:19.41,Default,,0,0,0,,سأرسل رسالة أخرى الآن.
Dialogue: 0,0:47:19.41,0:47:21.18,Default,,0,0,0,,نحن لسنا في حالة حرب.
Dialogue: 0,0:47:21.45,0:47:23.32,Default,,0,0,0,,أرسل فور الفجر.
Dialogue: 0,0:47:23.32,0:47:24.95,Default,,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:47:28.22,0:47:31.66,Default,,0,0,0,,لم يعد لكلمة أخي مثل هذه القوة؟
Dialogue: 0,0:47:33.73,0:47:36.76,Default,,0,0,0,,الشيخوخة رذيلة.
Dialogue: 0,0:47:41.64,0:47:42.94,Default,,0,0,0,,كم أنا جائع.
Dialogue: 0,0:48:00.95,0:48:02.29,Default,,0,0,0,,واحد آخر.
Dialogue: 0,0:48:09.30,0:48:10.60,Default,,0,0,0,,لا أحد.
Dialogue: 0,0:48:11.33,0:48:13.03,Default,,0,0,0,,سيد.
Dialogue: 0,0:48:23.84,0:48:25.51,Default,,0,0,0,,إنه أنت. ادخل.
Dialogue: 0,0:48:27.11,0:48:29.22,Default,,0,0,0,,هل تنتظر عودتي؟
Dialogue: 0,0:48:29.78,0:48:31.92,Default,,0,0,0,,كيف عرفت أنني عدت للتو؟
Dialogue: 0,0:48:33.89,0:48:34.89,Default,,0,0,0,,مرحبًا.
Dialogue: 0,0:48:35.52,0:48:36.59,Default,,0,0,0,,انتظر لحظة.
Dialogue: 0,0:48:38.63,0:48:41.53,Default,,0,0,0,,كيف ذبلت كثيراً في يومين؟
Dialogue: 0,0:48:41.60,0:48:43.26,Default,,0,0,0,,سيد.
Dialogue: 0,0:48:44.80,0:48:46.87,Default,,0,0,0,,هل ضيعت كل أموالك من المحتالين؟
Dialogue: 0,0:48:47.13,0:48:48.77,Default,,0,0,0,,أو هل فقدت وثائق منزلك؟
Dialogue: 0,0:48:48.90,0:48:51.77,Default,,0,0,0,,كان عمري حينها 14 عاماً، وكنت ساذجاً.
Dialogue: 0,0:48:52.57,0:48:54.51,Default,,0,0,0,,هذه المشكلة أكثر خطورة.
Dialogue: 0,0:48:55.08,0:48:56.44,Default,,0,0,0,,هل فقدت مستنداتك الخاصة بالموقع؟
Dialogue: 0,0:48:56.44,0:48:58.48,Default,,0,0,0,,حدث هذا بالفعل عندما ذهبت...
Dialogue: 0,0:49:01.21,0:49:03.18,Default,,0,0,0,,عائلتك أيضاً عانت من المصائب.
Dialogue: 0,0:49:05.22,0:49:08.22,Default,,0,0,0,,العائلة أم الحب؟
Dialogue: 0,0:49:09.59,0:49:11.56,Default,,0,0,0,,هذا هو السؤال.
Dialogue: 0,0:49:17.20,0:49:19.80,Default,,0,0,0,,الرجل المسكين.
Dialogue: 0,0:49:19.87,0:49:22.94,Default,,0,0,0,,أيها الفقير.
Dialogue: 0,0:49:23.67,0:49:25.51,Default,,0,0,0,,هذه مشكلة خطيرة حقاً.
Dialogue: 0,0:49:36.07,0:49:38.54,Default,,0,0,0,,جلالتك. الملكة الأرملة
Dialogue: 0,0:49:38.54,0:49:40.52,Default,,0,0,0,,يناديك بسرعة إلى قاعة Dongmyeongjong.
Dialogue: 0,0:49:54.73,0:49:56.07,Default,,0,0,0,,هل اتصلت بي؟
Dialogue: 0,0:49:56.79,0:49:59.50,Default,,0,0,0,,لا تصدق أنك مذنب
Dialogue: 0,0:49:59.50,0:50:02.13,Default,,0,0,0,,في وفاة الملك الراحل، أليس كذلك؟
Dialogue: 0,0:50:03.48,0:50:07.40,Default,,0,0,0,,لذا فأنت تفعل كل ما بوسعك\N لإلقاء اللوم على عائلتي.
Dialogue: 0,0:50:08.21,0:50:09.21,Default,,0,0,0,,جلالتك.
Dialogue: 0,0:50:09.82,0:50:13.25,Default,,0,0,0,,يمكنك إهانتي كما تريد،
Dialogue: 0,0:50:13.65,0:50:16.11,Default,,0,0,0,,لكن أنقذوا ملكنا الراحل.
Dialogue: 0,0:50:16.21,0:50:18.86,Default,,0,0,0,,مرة أخرى أنت تختبئ خلف ابني.
Dialogue: 0,0:50:19.56,0:50:23.56,Default,,0,0,0,,لا يصدق، لديك الجرأة\N لإلقاء اللوم على شخص ما لإخفاء ذنبك.
Dialogue: 0,0:50:26.27,0:50:29.00,Default,,0,0,0,,يجب على الإنسان أن يعرف نفسه،
Dialogue: 0,0:50:29.29,0:50:32.77,Default,,0,0,0,,حتى لا ترتكب نفس الأخطاء مرتين.
Dialogue: 0,0:50:35.23,0:50:39.31,Default,,0,0,0,,شكرًا لك على الدرس.
Dialogue: 0,0:50:46.79,0:50:51.11,Default,,0,0,0,,أنا متعب جدًا لدرجة أنني لا أستطيع خلع جواربي.
Dialogue: 0,0:50:56.50,0:50:59.67,Default,,0,0,0,,سأكون سعيداً بخلعها لك.
Dialogue: 0,0:51:18.19,0:51:20.32,Default,,0,0,0,,يوم عربة التسوق قادم.
Dialogue: 0,0:51:21.59,0:51:24.71,Default,,0,0,0,,في هذا الوقت سينتهي صبري.
Dialogue: 0,0:51:48.48,0:51:49.61,Default,,0,0,0,,لقد عدت.
Dialogue: 0,0:51:50.42,0:51:51.42,Default,,0,0,0,,نعم.
Dialogue: 0,0:51:53.48,0:51:56.19,Default,,0,0,0,,سمعت أن قسم المباحث لديه الكثير ليفعله اليوم.
Dialogue: 0,0:51:56.56,0:51:58.62,Default,,0,0,0,,يقولون أنك عارضت الحرس الملكي.
Dialogue: 0,0:51:58.79,0:52:02.00,Default,,0,0,0,,كانت هناك شبهات. كنت أرغب في العثور على\Nevidence قبل أن أخبرك.
Dialogue: 0,0:52:02.00,0:52:04.69,Default,إطلاق النار,0,0,0,,هناك أشخاص مشبوهون بين الحرس الملكي.
Dialogue: 0,0:52:04.69,0:52:06.82,Default,,0,0,0,,أعتقد أن هناك سبعة منهم.
Dialogue: 0,0:52:07.79,0:52:09.27,Default,,0,0,0,,هل تعلم عنهم؟
Dialogue: 0,0:52:12.77,0:52:15.63,Default,,0,0,0,,هل تعتقد أنني لم أتطرق إليهم لأنني لم أكن أعلم بشأنهم؟
Dialogue: 0,0:52:19.84,0:52:23.11,Default,,0,0,0,,إذا كنت مهتمًا بهم بشكل مباشر، فكيف سيكون رد فعلهم؟
Dialogue: 0,0:52:23.27,0:52:25.69,Default,,0,0,0,,سوف يحفرون حفرة أعمق ويكذبون في القاع.
Dialogue: 0,0:52:25.92,0:52:29.11,Default,,0,0,0,,سوف يصبحون أكثر ذكاءً ويتصرفون سراً.
Dialogue: 0,0:52:29.15,0:52:32.63,Default,,0,0,0,,ما يمكن رؤيته لا يشكل تهديداً.
Dialogue: 0,0:52:32.88,0:52:37.00,Default,,0,0,0,,اجعلهم يعتقدون أنك لا تستطيع رؤيتهم.
Dialogue: 0,0:52:37.06,0:52:39.40,Default,,0,0,0,,وبعد ذلك يمكنك قتلهم على الفور،
Dialogue: 0,0:52:39.40,0:52:41.67,Default,,0,0,0,,بمجرد أن تصبح مشكلة.
Dialogue: 0,0:52:42.84,0:52:44.29,Default,,0,0,0,,لم أفكر في ذلك.
Dialogue: 0,0:52:45.86,0:52:47.44,Default,,0,0,0,,هل تعتقد،
Dialogue: 0,0:52:48.04,0:52:50.38,Default,,0,0,0,,الملك في هذا الوضع ببساطة لأنه
Dialogue: 0,0:52:50.38,0:52:52.07,Default,,0,0,0,,أنه ليس لديه أي قدرات؟
Dialogue: 0,0:52:53.77,0:52:57.94,Default,,0,0,0,,السبب أنني شخصياً زرعت الخوف في ذهنه.
Dialogue: 0,0:52:58.54,0:53:01.48,Default,,0,0,0,,من السهل السيطرة على أولئك الذين يخافون.
Dialogue: 0,0:53:01.71,0:53:04.48,Default,,0,0,0,,إذا كان الذي يقف بالأعلى يخاف مني،
Dialogue: 0,0:53:04.48,0:53:07.09,Default,,0,0,0,,قوتي تتجاوز قوته.
Dialogue: 0,0:53:09.50,0:53:14.13,Default,,0,0,0,,سأتصل بك لطرح أسئلة بخصوص الملك.
Dialogue: 0,0:53:17.59,0:53:18.94,Default,,0,0,0,,اذهب للراحة.
Dialogue: 0,0:54:15.73,0:54:17.46,Default,,0,0,0,,لن يتمكنوا من العثور عليك هناك.
Dialogue: 0,0:54:17.69,0:54:19.29,Default,,0,0,0,,سأعود إليك بالتأكيد.
Dialogue: 0,0:54:19.50,0:54:22.63,Default,,0,0,0,,ولكن حتى ذلك الحين، لا تخرج لأي شيء.
Dialogue: 0,0:54:22.63,0:54:25.17,Default,,0,0,0,,ماذا عن إخوتي؟ وأنت يا أمي؟
Dialogue: 0,0:54:25.17,0:54:26.81,Default,,0,0,0,,أنا بخير طالما أنك على قيد الحياة.
Dialogue: 0,0:54:27.50,0:54:30.50,Default,,0,0,0,,أنت ابني الوحيد.
Dialogue: 0,0:54:31.71,0:54:32.90,Default,,0,0,0,,إذا مت،
Dialogue: 0,0:54:34.00,0:54:35.34,Default,,0,0,0,,لا أستطيع العيش أيضاً.
Dialogue: 0,0:54:36.98,0:54:38.07,Default,,0,0,0,,أسرع!
Dialogue: 0,0:54:56.13,0:54:57.13,Default,,0,0,0,,أسرع!
Dialogue: 0,0:56:30.23,0:56:31.59,Default,,0,0,0,,يبدو لي.
Dialogue: 0,0:56:32.46,0:56:33.67,Default,,0,0,0,,هذا غير واقعي.
Dialogue: 0,0:56:35.86,0:56:37.04,Default,,0,0,0,,نحن بحاجة إلى العثور على دفتر المحاسبة.
Dialogue: 0,0:56:45.11,0:56:46.27,Default,,0,0,0,,هل أنا مخطئ؟
Dialogue: 0,0:56:47.31,0:56:48.38,Default,,0,0,0,,مستحيل.
Dialogue: 0,0:56:55.69,0:56:57.46,Default,,0,0,0,,أنا بريء يا ونبيوم!
Dialogue: 0,0:56:58.11,0:57:02.23,Default,,0,0,0,,لقد اتُهمت زورا. بني، لا أستطيع الراحة.
Dialogue: 0,0:57:02.23,0:57:05.02,Default,,0,0,0,,ونبوم! ونبوم!
Dialogue: 0,0:57:05.02,0:57:06.29,Default,,0,0,0,,-لم أكن أنا.\N-Wonbom.
Dialogue: 0,0:57:06.29,0:57:08.90,Default,,0,0,0,,-ونبوم.\N-ونبوم.
Dialogue: 0,0:57:08.90,0:57:11.67,Default,,0,0,0,,-أنت الوحيد الذي نجوت.\N-غير عادل.
Dialogue: 0,0:57:12.34,0:57:14.94,Default,,0,0,0,,كل هذا كذب.
Dialogue: 0,0:57:15.23,0:57:17.44,Default,,0,0,0,,إنه فقط في رأسي.
Dialogue: 0,0:57:17.63,0:57:20.15,Default,,0,0,0,,-لا، لا.\N-ألعنك.
Dialogue: 0,0:57:20.15,0:57:22.44,Default,,0,0,0,,-لا.\N-ألعنك.
Dialogue: 0,0:57:46.96,0:57:48.07,Default,,0,0,0,,كيم سويون.
Dialogue: 0,0:57:53.67,0:57:55.52,Default,,0,0,0,,ماذا؟ مشابهة جدا.
Dialogue: 0,0:57:56.44,0:58:00.32,Default,,0,0,0,,هل تعتقدين أنك ستصبحين مثل "كيم سو يون" الحقيقية؟
Dialogue: 0,0:58:00.65,0:58:03.36,Default,,0,0,0,,لديهم شيء مشترك: لا توجد أمهات.
Dialogue: 0,0:58:09.50,0:58:13.36,Default,,0,0,0,,هذا الكتاب كتبه عالم من جوسون.
Dialogue: 0,0:58:13.36,0:58:14.36,Default,,0,0,0,,التعليمات الأولية للأطفال\NKim Soyeon
Dialogue: 0,0:58:14.36,0:58:16.13,Default,,0,0,0,,خمسة أنواع من العلاقات:
Dialogue: 0,0:58:16.69,0:58:19.61,Default,,0,0,0,,الأب - الابن، الحاكم - الرعيّة، الزوج - الزوجة،
Dialogue: 0,0:58:20.00,0:58:21.46,Default,,0,0,0,,الأخ الأكبر والأخ الأصغر،
Dialogue: 0,0:58:21.46,0:58:23.17,Default,,0,0,0,,بعضنا البعض.
Dialogue: 0,0:58:23.17,0:58:26.00,Default,,0,0,0,,ادرس بجد لدرجة أنك أفسدت الكتاب إلى حد كبير.
Dialogue: 0,0:58:26.84,0:58:28.31,Default,,0,0,0,,لماذا تكررها مرة أخرى؟
Dialogue: 0,0:58:29.84,0:58:33.11,Default,,0,0,0,,اليوم جنازة أمي.
Dialogue: 0,0:58:33.92,0:58:35.71,Default,,0,0,0,,هذا هو كتابها.
Dialogue: 0,0:58:36.86,0:58:39.86,Default,,0,0,0,,إذاً هذا ما تفعله عندما تفتقد والدتك.
Dialogue: 0,0:58:39.86,0:58:41.48,Default,,0,0,0,,
Dialogue: 0,0:58:42.02,0:58:43.25,Default,,0,0,0,,بكيت،
Dialogue: 0,0:58:43.82,0:58:47.13,Default,,0,0,0,,لم أجد طريقة لرؤية والدتي بعد.
Dialogue: 0,0:58:47.90,0:58:49.00,Default,,0,0,0,,أيهما؟
Dialogue: 0,0:58:49.90,0:58:53.21,Default,,0,0,0,,إذا مت فسوف أراها.
Dialogue: 0,0:59:27.04,0:59:28.13,Default,,0,0,0,,هل أنت على قيد الحياة؟
Dialogue: 0,0:59:30.81,0:59:32.27,Default,,0,0,0,,هل أتيت لتموت أيضاً؟
Dialogue: 0,0:59:33.81,0:59:35.00,Default,,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:59:35.82,0:59:37.34,Default,,0,0,0,,لقد جئت إلى هنا لأموت.
Dialogue: 0,0:59:43.09,0:59:46.63,Default,,0,0,0,,هل تريد أن تعيش؟ لأنك خائف من الموت؟
Dialogue: 0,0:59:51.25,0:59:52.27,Default,,0,0,0,,لا.
Dialogue: 0,0:59:53.46,0:59:57.09,Default,,0,0,0,,الجميع يموتون إلا أنا. هذا ما هو مخيف.
Dialogue: 0,0:59:58.50,0:59:59.61,Default,,0,0,0,,ثم
Dialogue: 0,1:00:01.11,1:00:02.40,Default,,0,0,0,,دعونا نموت معًا.
Dialogue: 0,1:00:16.56,1:00:18.15,Default,,0,0,0,,لنفعل ذلك عند العد لثلاثة.
Dialogue: 0,1:00:19.06,1:00:20.09,Default,,0,0,0,,نعم.
Dialogue: 0,1:00:31.09,1:00:32.81,Default,,0,0,0,,الصوت يأتي من هنا!
Dialogue: 0,1:00:37.11,1:00:38.23,Default,,0,0,0,,أخي؟
Dialogue: 0,1:00:38.54,1:00:40.15,Default,,0,0,0,,هل تعلم كم كنت قلقاً؟
Dialogue: 0,1:00:40.65,1:00:42.94,Default,,0,0,0,,كانت العائلة بأكملها تبحث عنك.
Dialogue: 0,1:00:42.94,1:00:45.17,Default,,0,0,0,,أخي.
Dialogue: 0,1:00:51.61,1:00:52.88,Default,,0,0,0,,سأنزل إليك.
Dialogue: 0,1:00:55.29,1:00:56.92,Default,,0,0,0,,فقط أنزل الدرج.
Dialogue: 0,1:00:57.52,1:00:58.59,Default,,0,0,0,,حسنًا.
Dialogue: 0,1:01:05.46,1:01:08.50,Default,,0,0,0,,عذراً. ولكن ما زلت أريد أن أعيش.
Dialogue: 0,1:01:10.81,1:01:12.75,Default,,0,0,0,,أنت تريد أن تعيش أيضاً، أليس كذلك؟
Dialogue: 0,1:01:18.71,1:01:20.21,Default,,0,0,0,,سأعود.
Dialogue: 0,1:01:27.48,1:01:28.75,Default,,0,0,0,,إذا كنت تريد أن تعيش،
Dialogue: 0,1:01:29.63,1:01:33.46,Default,,0,0,0,,إذا كنت تريد أن تعيش مرة أخرى، فأعدها لي.
Dialogue: 0,1:01:47.15,1:01:49.17,Default,,0,0,0,,-هل يمكنك الوصول؟\N-نعم.
Dialogue: 0,1:02:02.59,1:02:03.69,Default,,0,0,0,,أبي.
Dialogue: 0,1:02:06.13,1:02:07.42,Default,,0,0,0,,من فضلك.
Dialogue: 0,1:02:07.42,1:02:10.29,Default,,0,0,0,,الآنسة سويون.
Dialogue: 0,1:02:17.23,1:02:21.31,Default,,0,0,0,,أبي، من فضلك. بابي.
Dialogue: 0,1:02:21.31,1:02:25.02,Default,,0,0,0,,أبي! لو سمحت!
Dialogue: 0,1:02:25.02,1:02:28.25,Default,,0,0,0,,بابا، بابا!
Dialogue: 0,1:02:28.25,1:02:29.59,Default,,0,0,0,,-من فضلك.\N-ضع البئر.
Dialogue: 0,1:02:29.92,1:02:34.63,Default,,0,0,0,,أبي، لا! لا حاجة يا أبي!
Dialogue: 0,1:02:34.63,1:02:37.36,Default,,0,0,0,,أبي! لا تفعل هذا!
Dialogue: 0,1:02:40.46,1:02:42.00,Default,,0,0,0,,لا! أب!
Dialogue: 0,1:02:42.54,1:02:46.63,Default,,0,0,0,,لا داعي يا أبي! لا حاجة!
Dialogue: 0,1:02:47.13,1:02:50.07,Default,,0,0,0,,من فضلك يا أبي! لا تفعل هذا!
Dialogue: 0,1:02:50.63,1:02:53.40,Default,,0,0,0,,أبي، لا! بابي!
Dialogue: 0,1:02:53.57,1:02:56.15,Default,,0,0,0,,أبي!
Dialogue: 0,1:03:03.56,1:03:05.09,Default,,0,0,0,,الأم وهذه الفتاة.
Dialogue: 0,1:03:05.82,1:03:08.06,Default,,0,0,0,,مازلت لم أصدق وعودهم.
Dialogue: 0,1:03:09.50,1:03:11.06,Default,,0,0,0,,سينتهي كل شيء عندما أموت.
Dialogue: 0,1:03:11.73,1:03:14.59,Default,,0,0,0,,لن ينتهي هذا حتى تمتلئ البئر بالماء.
Dialogue: 0,1:03:16.44,1:03:17.54,Default,,0,0,0,,أبداً.
Dialogue: 0,1:03:47.59,1:03:49.44,Default,,0,0,0,,أنقذني!
Dialogue: 0,1:03:50.00,1:03:53.36,Default,,0,0,0,,أنقذني، أنقذني!
Dialogue: 0,1:03:53.57,1:03:55.84,Default,,0,0,0,,احفظ! لو سمحت!
Dialogue: 0,1:03:55.98,1:03:59.17,Default,,0,0,0,,عذراً! من فضلك أنقذني!
Dialogue: 0,1:03:59.17,1:04:00.44,Default,,0,0,0,,إنه خطأي.
Dialogue: 0,1:04:00.84,1:04:02.67,Default,,0,0,0,,سوف يموت بسببي.
Dialogue: 0,1:04:02.67,1:04:05.04,Default,,0,0,0,,لأنني كشفت السر.
Dialogue: 0,1:04:05.04,1:04:07.71,Default,,0,0,0,,لقد أخبرت الخادمة عنه.
Dialogue: 0,1:04:07.92,1:04:09.69,Default,,0,0,0,,هل سمعت ما قاله الكبار؟
Dialogue: 0,1:04:10.32,1:04:11.61,Default,,0,0,0,,عائلته خونة.
Dialogue: 0,1:04:11.96,1:04:14.32,Default,,0,0,0,,لكنه لم يفعل شيئاً.
Dialogue: 0,1:04:14.75,1:04:17.59,Default,,0,0,0,,أخي، أنت شخص جيد، أليس كذلك؟
Dialogue: 0,1:04:18.15,1:04:21.32,Default,,0,0,0,,من فضلك يا أخي.
Dialogue: 0,1:04:29.11,1:04:31.04,Default,,0,0,0,,تعال هنا بسرعة.
Dialogue: 0,1:04:39.98,1:04:42.46,Default,,0,0,0,,أخي شخص جيد حقًا.
Dialogue: 0,1:04:54.52,1:04:56.94,افتراضي,,0,0,0,,حفظ. أنقذني.
Dialogue: 0,1:04:57.00,1:05:00.04,Default,,0,0,0,,من فضلك. يحفظ.
Dialogue: 0,1:05:09.82,1:05:10.98,Default,,0,0,0,,علينا أن نسرع.
Dialogue: 0,1:05:20.48,1:05:21.88,Default,,0,0,0,,لقد عدت حقاً.
Dialogue: 0,1:05:23.25,1:05:24.92,Default,,0,0,0,,كما وعدتك.
Dialogue: 0,1:06:07.04,1:06:08.84,Default,,0,0,0,,
Dialogue: 0,1:06:17.27,1:06:18.54,Default,,0,0,0,,أريد أن أعيش.
Dialogue: 0,1:06:19.61,1:06:20.65,Default,,0,0,0,,مثلك.
Dialogue: 0,1:06:27.73,1:06:29.52,Default,,0,0,0,,كيم سويون
Dialogue: 0,1:06:48.31,1:06:50.07,Default,,0,0,0,,الناس يخافون من الظلام،
Dialogue: 0,1:06:50.61,1:06:53.19,Default,,0,0,0,,فأشعلوا الأضواء.
Dialogue: 0,1:07:08.09,1:07:09.79,افتراضي,,0,0,0,,سرّي
Dialogue: 0,1:07:16.20,1:07:17.98,Default,,0,0,0,,ولكن كلما زاد سطوع الضوء،
Dialogue: 0,1:07:18.81,1:07:20.61,Default,,0,0,0,,كلما كان الظل أكثر سواداً.
Dialogue: 0,1:07:37.62,1:07:40.53,Default,,0,0,0,,هواجين.
Dialogue: 0,1:08:00.74,1:08:05.06,Default,,0,0,0,,
Dialogue: 0,1:08:20.61,1:08:22.11,Default,,0,0,0,,ماذا حدث؟
Dialogue: 0,1:08:22.11,1:08:24.33,Default,,0,0,0,,بالضبط، كدت ألمسه.
Dialogue: 0,1:08:26.04,1:08:27.15,Default,,0,0,0,,كان ذلك خطيراً.
Dialogue: 0,1:08:27.15,1:08:29.04,Default,,0,0,0,,يمكنك القدوم متى شئت.
Dialogue: 0,1:08:29.04,1:08:31.37,Default,,0,0,0,,لكن لا يمكنك التصرف كما تريد.
Dialogue: 0,1:08:31.37,1:08:32.52,Default,,0,0,0,,أنا متأكد من أن هذا مزيف.
Dialogue: 0,1:08:32.52,1:08:34.21,Default,,0,0,0,,هل تقول أن شخصًا ما قام بتزييف هويته؟
Dialogue: 0,1:08:34.21,1:08:36.95,Default,,0,0,0,,سأهزم عدوًا بمساعدة عدو آخر.
Dialogue: 0,1:08:36.95,1:08:39.19,Default,,0,0,0,,لذا سأصبح لا غنى عني:
Dialogue: 0,1:08:39.19,1:08:41.49,Default,,0,0,0,,الطعام الكوري والرعاية الذاتية الكورية.
Dialogue: 0,1:08:41.49,1:08:44.12,Default,,0,0,0,,الخوف والقلق يفقدانك عقلك.
Dialogue: 0,1:08:44.12,1:08:46.23,Default,,0,0,0,,أنت حقًا من أنصاري.
Dialogue: 0,1:08:46.23,1:08:48.90,Default,,0,0,0,,كنت قلقاً بشأن الكثير، لكنني وجدت طريقة للخروج.
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


