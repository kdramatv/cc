Dialogue: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, А,инасу, А,инасу, А,инасу
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:04.02,pangalan,,0,0,0,,{\pos(112,666)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:12.86,0:01:15.20,Default,BIR,0,0,0,,Hindi, hindi iyon ang ibig kong sabihin!
Dialogue: 0,0:01:24.34,0:01:26.68,Default,BIR,0,0,0,,Kailangan nating gumawa ng matinding hakbang.
Dialogue: 0,0:01:38.19,0:01:39.35,Default,BIR,0,0,0,,At siya ay mabilis.
Dialogue: 0,0:01:40.49,0:01:42.78,Default,BIR,0,0,0,,-Ano ito? \N-Ito ang dapat kong itanong sa iyo.
Dialogue: 0,0:01:42.86,0:01:45.76,Default,BIR,0,0,0,,Habang umiinom ako, naisip kong sapat na ang liwanag ng buwan para sa aking kalooban,
Dialogue: 0,0:01:45.76,0:01:47.16,Default,BIR,0,0,0,,kaya hinipan ko ang kandila.
Dialogue: 0,0:01:49.33,0:01:53.30,Default,BIR,0,0,0,,Gusto kong iunat ang aking lalamunan bago ako magsimulang uminom ng totoo.
Dialogue: 0,0:01:53.50,0:01:55.77,Default,BIR,0,0,0,,Maaari mong ituring itong isang warm-up.
Dialogue: 0,0:01:57.51,0:01:58.66,Default,BIR,0,0,0,,So, ano?
Dialogue: 0,0:02:00.14,0:02:01.88,Default,BIR,0,0,0,,Anong ginagawa mo? Damn it.
Dialogue: 0,0:02:02.04,0:02:04.74,Default,BIR,0,0,0,,Hindi mo ba gustong magpainit ng lalamunan ng isa't isa?
Dialogue: 0,0:02:05.18,0:02:07.87,Default,BIR,0,0,0,,Anong tusong asshole. Sinasadya niya ba?
Dialogue: 0,0:02:09.89,0:02:11.38,Default,BIR,0,0,0,,Hindi, imposible.
Dialogue: 0,0:02:13.36,0:02:14.76,Default,BIR,0,0,0,,Mula nang uminit ang ating lalamunan,
Dialogue: 0,0:02:14.76,0:02:16.59,Default,BIR,0,0,0,,simulan mong uminom ng buong puso, aking reyna.
Dialogue: 0,0:02:18.59,0:02:19.73,Default,BIR,0,0,0,,Saan?
Dialogue: 0,0:02:20.23,0:02:22.02,Default,BIR,0,0,0,,Hindi kawili-wili ang isang tao.
Dialogue: 0,0:02:23.67,0:02:25.74,Default,BIR,0,0,0,, Kahit papaano hindi ko naisip iyon.
Dialogue: 0,0:02:27.04,0:02:28.16,Default,BIR,0,0,0,,Ibuhos.
Dialogue: 0,0:02:35.95,0:02:37.55,Default,BIR,0,0,0,,Salamat sa warm-up welcome,
Dialogue: 0,0:02:37.55,0:02:39.57,Default,BIR,0,0,0,,ngayon ay mahinang lumipad ang alak.
Dialogue: 0,0:02:39.98,0:02:42.65,Default,BIR,0,0,0,,Ano? Anong ginawa ko?
Dialogue: 0,0:02:44.72,0:02:47.38,Default,BIR,0,0,0,,Eto, uminom ka.
Dialogue: 0,0:02:49.33,0:02:52.15,Default,BIR,0,0,0,,Dapat uminom ka rin, aking reyna.
Dialogue: 0,0:02:52.33,0:02:54.20,Default,BIR,0,0,0,,Uminom muna ang hari.
Dialogue: 0,0:02:54.36,0:02:56.40,Default,BIR,0,0,0,,Hindi, umiinom muna ang reyna.
Dialogue: 0,0:02:56.93,0:02:58.90,Default,BIR,0,0,0,,Binago ang diskarte.
Dialogue: 0,0:02:59.27,0:03:02.13,Default,BIR,0,0,0,,Alam ko ang madilim mong iniisip.
Dialogue: 0,0:03:04.14,0:03:06.81,Default,BIR,0,0,0,,Pagkatapos ay uminom tayo ng baso
Dialogue: 0,0:03:06.81,0:03:09.27,Default,BIR,0,0,0,,at sa kama, buti na lang mahaba ang araw.
Dialogue: 0,0:03:09.75,0:03:11.77,Default,BIR,0,0,0,,Ano ang sinasabi mo? Oo, nagsisimula pa lang kami.
Dialogue: 0,0:03:12.82,0:03:13.92,Default,BIR,0,0,0,,Huwag ganyan.
Dialogue: 0,0:03:13.92,0:03:17.59,Default,BIR,0,0,0,,Halika. Isang salvo para sa aking kalusugan.
Dialogue: 0,0:03:17.99,0:03:19.12,Default,BIR,0,0,0,,Gulp.
Dialogue: 0,0:03:21.76,0:03:23.56,Default,BIR,0,0,0,,Mahina akong natutulog,
Dialogue: 0,0:03:23.56,0:03:25.12,Default,BIR,0,0,0,,kaya lumayo ka habang natutulog tayo.
Dialogue: 0,0:03:25.49,0:03:27.90,Default,BIR,0,0,0,,Anong klaseng laro ang pinaglalaruan niya ng ganyan at ganyang kalokohan?
Dialogue: 0,0:03:39.54,0:03:43.08,Default,BIR,0,0,0,,Namumulaklak sa araw, nalalanta sa gabi.
Dialogue: 0,0:03:48.28,0:03:50.78,Default,BIR,0,0,0,,Ang mga kuwentong ito tungkol sa pagmamahal ng hari sa alak at kababaihan...
Dialogue: 0,0:03:53.62,0:03:55.96,Default,BIR,0,0,0,,Ang mga Chronicles tungkol kay Joseon ay kasinungalingan tulad ng yellow press.
Dialogue: 0,0:03:56.43,0:03:57.68,Default,BIR,0,0,0,,Natakot ako nang walang kabuluhan.
Dialogue: 0,0:03:58.19,0:04:00.72,Default,BIR,0,0,0,,Ngunit hindi natin dapat pababayaan ang ating pagbabantay.
Dialogue: 0,0:04:05.07,0:04:06.74,Default,BIR,0,0,0,,Sa wakas ay ginamit ito
Dialogue: 0,0:04:06.74,0:04:08.67,Default,BIR,0,0,0,,woman’s knot, na natutunan ko sa army.
Dialogue: 0,0:04:09.51,0:04:12.40,Default,BIR,0,0,0,,Kung gusto mong kalasin ito, kailangan mong putulin.
Dialogue: 0,0:04:12.54,0:04:13.64,Default,BIR,0,0,0,,Frets.
Dialogue: 0,0:04:18.41,0:04:20.68,Default,BIR,0,0,0,,Damn makasarili.
Dialogue: 0,0:04:20.68,0:04:22.65,Default,BIR,0,0,0,,Inangat ang buong kama.
Dialogue: 0,0:04:33.50,0:04:35.22,Default,BIR,0,0,0,,Patawarin mo ako, aking reyna.
Dialogue: 0,0:04:35.67,0:04:37.99,Default,BIR,0,0,0,,Naiintindihan ko ang iyong nararamdaman,
Dialogue: 0,0:04:38.10,0:04:40.43,Default,BIR,0,0,0,,pero ngayon gusto ko lang matulog.
Dialogue: 0,0:04:40.50,0:04:42.94,Default,BIR,0,0,0,,Mali ang lahat. Pinalaki ako sa ginhawa
Dialogue: 0,0:04:42.94,0:04:44.87,Default,BIR,0,0,0,,Hindi ako makatulog sa hubad na sahig.
Dialogue: 0,0:04:45.17,0:04:46.58,Default,BIR,0,0,0,,Bigyan mo ako ng isa.
Dialogue: 0,0:04:47.34,0:04:48.78,Default,BIR,0,0,0,,Hindi ako makatulog
Dialogue: 0,0:04:48.78,0:04:51.08,Default,BIR,0,0,0,,mas mababa sa tatlong feather bed.
Dialogue: 0,0:04:53.25,0:04:55.47,Default,BIR,0,0,0,,Sigurado akong hindi maikukumpara ang kaginhawaan mo sa isang hari.
Dialogue: 0,0:05:00.22,0:05:01.52,Default,BIR,0,0,0,,Ang magtotroso na prinsipe mula sa Ganghwa
Dialogue: 0,0:05:01.52,0:05:02.86,Default,BIR,0,0,0,,malinaw na hindi ako nag-aral ng history.
Dialogue: 0,0:05:21.54,0:05:22.64,Default,BIR,0,0,0,,Yolki.
Dialogue: 0,0:05:25.72,0:05:27.35,Default,BIR,0,0,0,,Para masira ang kanyang sleep paralysis.
Dialogue: 0,0:05:32.09,0:05:35.25,Default,BIR,0,0,0,,Dahil ang lahat ay naging ganito,\NI ay magbabantay buong gabi.
Dialogue: 0,0:05:37.06,0:05:39.95,Default,BIR,0,0,0,,Sa ilang kadahilanan ngayon naaalala ko pa rin ang hukbo.
Dialogue: 0,0:05:53.91,0:05:57.31,Default,BIR,0,0,0,,2 episode: Walang nakakaalam
Dialogue: 0,0:06:55.34,0:06:57.47,Default,BIR,0,0,0,,Gising ka na ba, Kamahalan?
Dialogue: 0,0:06:57.47,0:06:59.11,Default,BIR,0,0,0,,Narito ang isang ambush.
Dialogue: 0,0:06:59.88,0:07:02.18,Default,BIR,0,0,0,,Sana hindi, pero nandito pa rin ako.
Dialogue: 0,0:07:04.58,0:07:07.98,Default,BIR,0,0,0,,Ano ang pakiramdam ng pagsalubong sa bagong araw bilang isang reyna?
Dialogue: 0,0:07:08.78,0:07:10.01,Default,BIR,0,0,0,,Shit.
Dialogue: 0,0:07:11.99,0:07:13.12,Default,BIR,0,0,0,,Iyon lang.
Dialogue: 0,0:07:15.93,0:07:17.18,Default,BIR,0,0,0,,Buhol ng babae ko.
Dialogue: 0,0:07:21.86,0:07:24.03,Default,BIR,0,0,0,,Nawala na naman?
Dialogue: 0,0:07:24.20,0:07:26.54,Default,BIR,0,0,0,,-Hahanapin ko lahat... \N-Hindi!
Dialogue: 0,0:07:27.94,0:07:31.74,Default,BIR,0,0,0,,Sigurado akong kinalas ko ito sa gabi, nakialam, kumbaga. Kaya?
Dialogue: 0,0:08:13.02,0:08:14.12,Default,BIR,0,0,0,,Kamahalan.
Dialogue: 0,0:08:19.29,0:08:21.72,Default,BIR,0,0,0,,Kailan ka dumating sa Hijeongjon?
Dialogue: 0,0:08:21.99,0:08:24.56,Default,BIR,0,0,0,,Paumanhin sa hindi kita sinamahan.
Dialogue: 0,0:08:25.26,0:08:28.82,Default,BIR,0,0,0,,Ayaw kong gisingin ang reyna at tahimik na umalis.
Dialogue: 0,0:08:29.70,0:08:32.26,Default,BIR,0,0,0,,Binabangungot ka na naman ba?
Dialogue: 0,0:08:34.47,0:08:37.13,Default,BIR,0,0,0,,Hindi siya dapat mawalan ng antok dahil sa akin.
Dialogue: 0,0:08:37.44,0:08:39.31,Default,BIR,0,0,0,,First day niya bilang reyna.
Dialogue: 0,0:08:39.68,0:08:44.00,Default,BIR,0,0,0,,Dadalhan kita ng Arabic jasmine tea at makakatulog ka ng mahimbing ngayong gabi.
Dialogue: 0,0:08:46.92,0:08:51.58,Default,BIR,0,0,0,,Dapat ay binabati na ngayon ng reyna ang mga babae ng korte.
Dialogue: 0,0:08:51.69,0:08:54.36,Default,BIR,0,0,0,,Balita ko umalis na sila.
Dialogue: 0,0:08:54.82,0:08:58.23,Default,BIR,0,0,0,,Nakaka-curious kung ano ang itsura ng reyna ngayon.
Dialogue: 0,0:09:03.93,0:09:06.17,Default,BIR,0,0,0,,Kahapon ang kasal,
Dialogue: 0,0:09:06.34,0:09:08.94,Default,BIR,0,0,0,,bakit hindi ako nagising, kumusta na naman?
Dialogue: 0,0:09:08.94,0:09:11.01,Default,BIR,0,0,0,,Dapat kang pumunta at bumati
Dialogue: 0,0:09:11.01,0:09:13.18,Default,BIR,0,0,0,,ang Dowager Queen at ang Inang Reyna
Dialogue: 0,0:09:13.38,0:09:16.50,Default,BIR,0,0,0,,at magdaos ng isang maligayang seremonya para sa mga opisyal ng hukuman.
Dialogue: 0,0:09:16.65,0:09:18.81,Default,BIR,0,0,0,,Pagkatapos ng opisyal na bahagi ng seremonya ng kasal...
Dialogue: 0,0:09:18.81,0:09:20.68,Default,BIR,0,0,0,,Kailan matatapos ang kasal?
Dialogue: 0,0:09:20.72,0:09:23.99,Default,BIR,0,0,0,,Hindi, dapat basahin ng Kanyang Kamahalan ang mensahe
Dialogue: 0,0:09:23.99,0:09:25.29,Default,BIR,0,0,0,,tungkol sa iyong proklamasyon bilang reyna.
Dialogue: 0,0:09:27.42,0:09:30.03,Default,BIR,0,0,0,,Isang uri ng walang katapusang kasal.
Dialogue: 0,0:09:30.96,0:09:34.16,Default,BIR,0,0,0,,Sandali lang. Kaya ang Queen Dowager ay...
Dialogue: 0,0:09:34.16,0:09:37.33,Default,BIR,0,0,0,,Ito ay isang order mula sa Dowager Queen.
Dialogue: 0,0:09:37.33,0:09:40.83,Default,BIR,0,0,0,,Pupunuin ko ng tubig ang lawa -\NI ay labag sa kanyang utos.
Dialogue: 0,0:09:45.21,0:09:47.33,Default,BIR,0,0,0,,Anong klaseng tao ang Queen Dowager?
Dialogue: 0,0:09:47.71,0:09:49.14,Default,BIR,0,0,0,,Dowager Queen
Dialogue: 0,0:09:49.21,0:09:52.05,Default,BIR,0,0,0,,tulad mo, mula sa Andon clan ni Kim, siya ay isang elder,
Dialogue: 0,0:09:52.28,0:09:55.52,Default,BIR,0,0,0,,at ang inang reyna ay mula sa pamilyang Pungyang Cho.
Dialogue: 0,0:09:57.25,0:10:00.06,Default,BIR,0,0,0,,Kaya magkaaway ang nakuha kong lola at mommy.
Dialogue: 0,0:10:00.06,0:10:02.82,Default,BIR,0,0,0,,At ako, ang reyna, ay katulad ng lola.
Dialogue: 0,0:10:03.09,0:10:05.03,Default,BIR,0,0,0,,Pwede ko ba siyang tanungin kapag nakita ko siya?
Dialogue: 0,0:10:05.03,0:10:07.35,Default,BIR,0,0,0,,Ang mas matanda ay ang dowager queen.
Dialogue: 0,0:10:08.23,0:10:09.46,Default,BIR,0,0,0,,Ano pa?
Dialogue: 0,0:10:11.07,0:10:14.80,Default,BIR,0,0,0,,I really care, sasabihin mo ba sa akin ang lahat ng alam mo?
Dialogue: 0,0:10:15.54,0:10:17.91,Default,BIR,0,0,0,,Siya ay kapatid ni Mr. Kim Jwageun
Dialogue: 0,0:10:17.91,0:10:21.73,Default,BIR,0,0,0,,at hindi pa lumalabas ng palasyo simula noong dumating siya.
Dialogue: 0,0:10:21.74,0:10:23.10,Default,BIR,0,0,0,,-Gayundin... \N-Stop.
Dialogue: 0,0:10:26.25,0:10:28.92,Default,BIR,0,0,0,,Palanquin ang tinutukoy ko. Tumigil ka!
Dialogue: 0,0:10:29.39,0:10:32.21,Default,BIR,0,0,0,,-Tumigil! \N-Tumigil ka.
Dialogue: 0,0:10:36.66,0:10:37.93,Default,BIR,0,0,0,,Bumalik.
Dialogue: 0,0:10:38.46,0:10:40.93,Default,BIR,0,0,0,,Ibalik.
Dialogue: 0,0:10:41.30,0:10:43.06,Default,BIR,0,0,0,,Ibalik.
Dialogue: 0,0:10:48.54,0:10:49.67,Default,BIR,0,0,0,,Iyon lang.
Dialogue: 0,0:10:56.98,0:10:59.44,Default,BIR,0,0,0,,May mas mahalaga na lumitaw dito.
Dialogue: 0,0:11:32.35,0:11:36.52,Default,BIR,0,0,0,,Nawala dahil masyadong malaki ang palasyo?
Dialogue: 0,0:11:40.86,0:11:43.89,Default,BIR,0,0,0,,Ikinagagalak na makilala ka. ano pangalan mo
Dialogue: 0,0:11:48.60,0:11:49.69,Default,BIR,0,0,0,,Wow.
Dialogue: 0,0:11:50.83,0:11:53.06,Default,BIR,0,0,0,,Hinding-hindi ako masasanay sa katawan na ito.
Dialogue: 0,0:11:56.41,0:11:59.04,Default,BIR,0,0,0,,Mayroon kang kaakit-akit na aura.
Dialogue: 0,0:12:00.38,0:12:01.91,Default,BIR,0,0,0,,Galing ka rin ba sa royal family?
Dialogue: 0,0:12:01.91,0:12:05.15,Default,BIR,0,0,0,,May prinsesa ba diyan?
Dialogue: 0,0:12:06.52,0:12:07.75,Default,BIR,0,0,0,,Paumanhin.
Dialogue: 0,0:12:08.05,0:12:11.08,Default,BIR,0,0,0,,Kung ako ay mayabang at nagagalit sa iyo,
Dialogue: 0,0:12:11.15,0:12:12.58,Default,BIR,0,0,0,,patawarin mo ako.
Dialogue: 0,0:12:13.06,0:12:15.79,Default,BIR,0,0,0,,No. Ang sinusubukan kong sabihin...
Dialogue: 0,0:12:15.79,0:12:16.89,Default,BIR,0,0,0,,Kamahalan.
Dialogue: 0,0:12:17.39,0:12:19.85,Default,BIR,0,0,0,,Napakabilis mong maglakad. Paano ka nakarating dito?
Dialogue: 0,0:12:20.90,0:12:22.16,Default,BIR,0,0,0,,Kumusta.
Dialogue: 0,0:12:24.33,0:12:25.80,Default,BIR,0,0,0,,Kilala mo ba siya?
Dialogue: 0,0:12:27.10,0:12:29.54,Default,BIR,0,0,0,,Ito si Mrs. Hwajin mula sa pamilyang Cho,
Dialogue: 0,0:12:29.54,0:12:31.54,Default,BIR,0,0,0,, future royal concubine.
Dialogue: 0,0:12:32.98,0:12:34.58,Default,BIR,0,0,0,,Naiintindihan ko na ang reyna ay nasa,
Dialogue: 0,0:12:34.58,0:12:36.21,Default,BIR,0,0,0,,pero hindi ka niya masyadong insulto?
Dialogue: 0,0:12:36.21,0:12:37.75,Default,BIR,0,0,0,,Patuloy sa paglalaro ng mga salita.
Dialogue: 0,0:12:37.75,0:12:39.95,Default,BIR,0,0,0,,May mga tsismis na siya nga
Dialogue: 0,0:12:39.95,0:12:41.55,Default,BIR,0,0,0,,tulak ka sa lawa.
Dialogue: 0,0:12:41.55,0:12:44.79,Default,BIR,0,0,0,,Sigurado akong kasinungalingan ang tsismis tungkol sa pagkawala ng memorya ng reyna.
Dialogue: 0,0:12:45.29,0:12:46.85,Default,BIR,0,0,0,,-Mag-ingat. \N-Mag-ingat ka.
Dialogue: 0,0:12:55.50,0:12:59.40,Default,BIR,0,0,0,,Marami na akong nakilalang babae,
Dialogue: 0,0:12:59.40,0:13:01.30,Default,BIR,0,0,0,,na madali kong mabasa ang mga mukha nila.
Dialogue: 0,0:13:02.17,0:13:03.83,Default,BIR,0,0,0,,Ikaw... Paano ko ito sasabihin?
Dialogue: 0,0:13:06.24,0:13:07.47,Default,BIR,0,0,0,,Mabuting tao.
Dialogue: 0,0:13:11.05,0:13:13.92,Default,BIR,0,0,0,,Sa tingin ko ay hindi naging maayos ang mga bagay para sa atin sa nakaraan,
Dialogue: 0,0:13:14.08,0:13:15.71,Default,BIR,0,0,0,,so baka magsimula ulit tayo?
Dialogue: 0,0:13:15.95,0:13:17.65,Default,BIR,0,0,0,,Gusto kita.
Dialogue: 0,0:13:19.66,0:13:20.81,Default,BIR,0,0,0,,Magkaibigan tayo.
Dialogue: 0,0:13:25.49,0:13:27.59,Default,PINEAPPLE,0,0,0,,Napagpasyahan mo na bang baguhin ang mga taktika?
Dialogue: 0,0:13:28.73,0:13:29.90,Default,PINEAPPLE,0,0,0,,Tactics?
Dialogue: 0,0:13:30.77,0:13:33.77,Default,PINEAPPLE,0,0,0,,Salamat sa iyo, nalaman ko\Nkung ano ang palasyo,
Dialogue: 0,0:13:34.30,0:13:36.71,Default,PINEAPPLE,0,0,0,,sa wakas ay naunawaan na ako ngayon ay bahagi na rin nito.
Dialogue: 0,0:13:36.71,0:13:40.84,Default,PINEAPPLE,0,0,0,,Hindi, mukhang hindi mo ako naintindihan.
Dialogue: 0,0:13:40.84,0:13:42.94,Default,PINEAPPLE,0,0,0,,-Mali ang lahat.\N-Paumanhin, kailangan kong umalis.
Dialogue: 0,0:13:46.15,0:13:47.31,Default,PINEAPPLE,0,0,0,,Kamahalan!
Dialogue: 0,0:13:48.45,0:13:49.84,Default,PINEAPPLE,0,0,0,,-Kamahalan.\N-Kamahalan.
Dialogue: 0,0:13:50.25,0:13:53.36,Default,PINEAPPLE,0,0,0,,Pumunta ako sa mga silid mo,\Npero wala ka doon.
Dialogue: 0,0:13:53.36,0:13:56.26,Default,PINEAPPLE,0,0,0,,Gusto rin kitang batiin, pero hindi ko mahanap.
Dialogue: 0,0:13:56.26,0:13:58.82,Default,PINEAPPLE,0,0,0,,Ganyan dapat na-miss namin ang isa't isa,
Dialogue: 0,0:13:59.66,0:14:01.19,Default,PINEAPPLE,0,0,0,,dahil nagtatagpo ang ating mga iniisip.
Dialogue: 0,0:14:03.90,0:14:06.90,Default,PINEAPPLE,0,0,0,,Kung concubine siya,\Nit pala siya ay tinuturing na pangalawang asawa?
Dialogue: 0,0:14:07.74,0:14:09.04,Default,PINEAPPLE,0,0,0,,Bakit ganito ang katawan?
Dialogue: 0,0:14:09.04,0:14:10.81,Default,PINEAPPLE,0,0,0,,Bakit ganito?
Dialogue: 0,0:14:12.67,0:14:16.20,Default,PINEAPPLE,0,0,0,,Ang apoy sa mata ng reyna ay maaaring sumunog sa mga bukid.
Dialogue: 0,0:14:21.85,0:14:23.84,Default,PINEAPPLE,0,0,0,,Magrenta ka na ng kwarto!
Dialogue: 0,0:14:24.72,0:14:25.84,Default,PINEAPPLE,0,0,0,,My queen,
Dialogue: 0,0:14:26.32,0:14:29.68,Default,PINEAPPLE,0,0,0,,Hinihiling ko sa iyo na mabilis na sabihin sa royal concubine kung ano at paano.
Dialogue: 0,0:14:33.13,0:14:34.66,Default,PINEAPPLE,0,0,0,,Nakakahiya!
Dialogue: 0,0:14:34.66,0:14:37.60,Default,PINEAPPLE,0,0,0,,Wala akong oras para ipaliwanag sa kanya ang lahat dito.
Dialogue: 0,0:14:37.60,0:14:38.96,Default,PINEAPPLE,0,0,0,,Ito ang utos ng hari.
Dialogue: 0,0:14:40.97,0:14:43.06,Default,PINEAPPLE,0,0,0,,Fuck polygamy.
Dialogue: 0,0:14:45.44,0:14:46.68,Default,PINEAPPLE,0,0,0,,Kamahalan!
Dialogue: 0,0:14:46.84,0:14:50.01,Default,PINEAPPLE,0,0,0,,Matagal ka nang hinihintay ng mga reyna!
Dialogue: 0,0:14:50.71,0:14:52.01,Default,PINEAPPLE,0,0,0,,Kamahalan!
Dialogue: 0,0:14:54.52,0:14:56.61,Default,PINEAPPLE,0,0,0,,Mayroon akong napakahalagang meeting, pupunta ako.
Dialogue: 0,0:15:04.09,0:15:05.22,Default,PINEAPPLE,0,0,0,,What the hell?
Dialogue: 0,0:15:06.83,0:15:07.95,Default,PINEAPPLE,0,0,0,,Kamahalan!
Dialogue: 0,0:15:12.27,0:15:14.00,Default,PINEAPPLE,0,0,0,,Sobrang takot,
Dialogue: 0,0:15:16.44,0:15:17.54,Default,PINEAPPLE,0,0,0,,Hwajin?
Dialogue: 0,0:15:18.51,0:15:20.93,Default,PINEAPPLE,0,0,0,,Sa wakas, matatawag na kitang asawa.
Dialogue: 0,0:15:22.31,0:15:25.41,Default,PINEAPPLE,0,0,0,,Ngayon ay magkakasama tayong titira sa palasyo.
Dialogue: 0,0:15:26.11,0:15:28.15,Default,PINEAPPLE,0,0,0,,You deserve a real wedding ceremony,
Dialogue: 0,0:15:28.25,0:15:31.84,Default,PINEAPPLE,0,0,0,,pero nakita ka ng eunuch sa hindi kalayuan sa lawa.
Dialogue: 0,0:15:33.22,0:15:35.66,Default,PINEAPPLE,0,0,0,,Sinisikap ng mga opisyal\Nna sisihin ka sa nangyari.
Dialogue: 0,0:15:36.12,0:15:37.93,Default,PINEAPPLE,0,0,0,,Kaya kailangan kong bilisan ang pagpili.
Dialogue: 0,0:15:38.96,0:15:41.23,Default,PINEAPPLE,0,0,0,,Nasa lawa ako dahil natakot ako,
Dialogue: 0,0:15:41.23,0:15:42.69,Default,PINEAPPLE,0,0,0,,nakarinig ng malakas na tunog.
Dialogue: 0,0:15:43.13,0:15:44.59,Default,PINEAPPLE,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:15:44.93,0:15:46.57,Default,PINEAPPLE,0,0,0,,Hindi ka niya kayang saktan,
Dialogue: 0,0:15:46.57,0:15:48.36,Default,PINEAPPLE,0,0,0,,sa kabila ng kung anong pamilya siya nagmula.
Dialogue: 0,0:15:55.78,0:15:58.65,Default,PINEAPPLE,0,0,0,,Hindi, hindi ganoon.\NI ay gagawin ang lahat para mapanatiling ligtas ka.
Dialogue: 0,0:15:59.28,0:16:01.71,Default,PINEAPPLE,0,0,0,,Gagawin ko ang lahat para protektahan ka.
Dialogue: 0,0:16:03.72,0:16:04.81,Default,PINEAPPLE,0,0,0,,Kamahalan.
Dialogue: 0,0:16:05.85,0:16:08.42,Default,PINEAPPLE,0,0,0,,Sa kasamaang palad, wala akong maraming paraan para gawin ito.
Dialogue: 0,0:16:09.32,0:16:11.09,Default,PINEAPPLE,0,0,0,,Puppet lang ako sa trono.
Dialogue: 0,0:16:11.09,0:16:13.09,Default,PINEAPPLE,0,0,0,,Pero may kapatid akong nag-aalala sa akin,
Dialogue: 0,0:16:13.30,0:16:15.22,Default,PINEAPPLE,0,0,0,,at isang kaibigan na gagawin ang lahat para masaya.
Dialogue: 0,0:16:15.46,0:16:16.59,Default,PINEAPPLE,0,0,0,,At
Dialogue: 0,0:16:18.20,0:16:19.77,Default,PINEAPPLE,0,0,0,,magandang babae.
Dialogue: 0,0:16:26.11,0:16:27.33,Default,PINEAPPLE,0,0,0,,Mayaman ka.
Dialogue: 0,0:16:29.64,0:16:33.22,Default,PINEAPPLE,0,0,0,,Nagpaliwanag ako sa mga opisyal kung nasaan ka.
Dialogue: 0,0:16:33.22,0:16:34.55,Default,PINEAPPLE,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:16:48.76,0:16:51.03,Default,PINEAPPLE,0,0,0,,Ano? Well, alin ang balo na lola?
Dialogue: 0,0:16:51.03,0:16:53.14,Default,PINEAPPLE,0,0,0,,Bow to the Queen Dowager, Your Majesty.
Dialogue: 0,0:16:53.97,0:16:55.43,Default,PINEAPPLE,0,0,0,,Hindi bale, lumayo ka sa kapintasan.
Dialogue: 0,0:16:56.24,0:17:00.93,Default,PINEAPPLE,0,0,0,,Sana nakatulog ka ng mahimbing, Dowager Queen.
Dialogue: 0,0:17:08.75,0:17:11.99,Default,PINEAPPLE,0,0,0,,Naging mas bata ka ngayong gabi!
Dialogue: 0,0:17:11.99,0:17:13.56,Default,PINEAPPLE,0,0,0,,Hindi mo masasabi kung ilang taon ka na.
Dialogue: 0,0:17:13.56,0:17:16.39,Default,PINEAPPLE,0,0,0,,Muntik mo na akong dayain, Kamahalan.
Dialogue: 0,0:17:16.99,0:17:18.26,Default,PINEAPPLE,0,0,0,,Scoundrel.
Dialogue: 0,0:17:19.16,0:17:20.63,Default,PINEAPPLE,0,0,0,,Talaga?
Dialogue: 0,0:17:21.33,0:17:23.59,Default,PINEAPPLE,0,0,0,,Kaya hindi masayang nagsusumikap ako nang husto.
Dialogue: 0,0:17:24.43,0:17:26.67,Default,PINEAPPLE,0,0,0,,Good girl, Chan Bong-hwan, keep it up.
Dialogue: 0,0:17:26.90,0:17:29.80,Default,PINEAPPLE,0,0,0,,Isang malaking kamalasan ang nangyari sa iyo.
Dialogue: 0,0:17:30.07,0:17:33.93,Default,PINEAPPLE,0,0,0,,Nakakatakot, mukhang\Hindi ka pa ganap na nakaka-recover.
Dialogue: 0,0:17:34.51,0:17:36.20,Default,PINEAPPLE,0,0,0,,Anong kalokohan ang sinasabi mo?
Dialogue: 0,0:17:36.51,0:17:39.15,Default,PINEAPPLE,0,0,0,,Wala kaming mahanap na mas mabuting reyna!
Dialogue: 0,0:17:39.15,0:17:40.92,Default,PINEAPPLE,0,0,0,,Matalim ang dila gaya ng dati.
Dialogue: 0,0:17:42.15,0:17:43.31,Default,PINEAPPLE,0,0,0,,Tama.
Dialogue: 0,0:17:43.75,0:17:46.11,Default,PINEAPPLE,0,0,0,,Tinignan kong mabuti at nakita ko.
Dialogue: 0,0:17:47.76,0:17:50.98,Default,PINEAPPLE,0,0,0,,Napakatamis ng ngiti nila, pero sa totoo lang\Nthey would rip each other throats out.
Dialogue: 0,0:17:51.36,0:17:52.89,Default,PINEAPPLE,0,0,0,,Buong kahandaan sa labanan.
Dialogue: 0,0:17:53.40,0:17:56.67,Default,PINEAPPLE,0,0,0,,Ngayon ay kailangan mong subukan ang iyong makakaya upang makagawa ng tagapagmana.
Dialogue: 0,0:17:57.83,0:18:01.34,Default,PINEAPPLE,0,0,0,,Sa isang pagkakataon natutunan ko\Nan epektibong paraan para gawin ito,
Dialogue: 0,0:18:01.34,0:18:03.77,Default,PINEAPPLE,0,0,0,,para siguradong maipanganak ang munting prinsipe.
Dialogue: 0,0:18:06.07,0:18:07.21,Default,PINEAPPLE,0,0,0,,Huwag mo kaming pahirapan.
Dialogue: 0,0:18:08.24,0:18:11.38,Default,PINEAPPLE,0,0,0,,Imagine, nagpapalipas ka ng gabi kasama ang iyong asawa.
Dialogue: 0,0:18:11.38,0:18:13.68,Default,PINEAPPLE,0,0,0,,Nakahiga siya sa likod,
Dialogue: 0,0:18:13.68,0:18:14.81,Default,PINEAPPLE,0,0,0,,at ikaw ang nasa itaas...
Dialogue: 0,0:18:31.73,0:18:34.36,Default,PINEAPPLE,0,0,0,,Bigyan siya ng award na "Best Mother-in-Law".
Dialogue: 0,0:18:36.20,0:18:39.77,Default,PINEAPPLE,0,0,0,,Ito ay isang napakahalagang punto,\Numakyat sa itaas at...
Dialogue: 0,0:18:39.77,0:18:42.33,Default,PINEAPPLE,0,0,0,,Inay, maiintindihan ko ito sa aking sarili!
Dialogue: 0,0:18:49.55,0:18:51.08,Default,PINEAPPLE,0,0,0,,Tumahimik ka na lang, pakiusap ko.
Dialogue: 0,0:18:51.52,0:18:55.49,Default,PINEAPPLE,0,0,0,,Well, sabihin na nating pinag-aralan kong mabuti ang literature.
Dialogue: 0,0:19:05.30,0:19:06.47,Default,PINEAPPLE,0,0,0,,Good girl!
Dialogue: 0,0:19:06.67,0:19:10.51,Default,PINEAPPLE,0,0,0,,Ang dami mong natutunan para maging isang napakagandang asawa.
Dialogue: 0,0:19:10.91,0:19:13.31,Default,PINEAPPLE,0,0,0,,Sigurado akong alam mo na.
Dialogue: 0,0:19:14.34,0:19:15.63,Default,PINEAPPLE,0,0,0,,Sumasang-ayon ako,
Dialogue: 0,0:19:16.01,0:19:19.81,Default,PINEAPPLE,0,0,0,,paumanhin sa pagtawid sa linya.
Dialogue: 0,0:19:22.45,0:19:25.11,Default,PINEAPPLE,0,0,0,,So, dapat mas mahinhin ang manugang,
Dialogue: 0,0:19:26.32,0:19:29.52,Default,PINEAPPLE,0,0,0,,at may dapat isipin ang asawa ng apo.
Dialogue: 0,0:19:45.94,0:19:47.01,Default,PINEAPPLE,0,0,0,,Nakakatakot na bangungot!
Dialogue: 0,0:19:47.01,0:19:49.57,Default,PINEAPPLE,0,0,0,,Hindi manggas, kundi mga sandata ng pagpatay!
Dialogue: 0,0:19:50.05,0:19:51.34,Default,PINEAPPLE,0,0,0,,Nabibitak ang leeg.
Dialogue: 0,0:19:52.28,0:19:53.95,Default,PINEAPPLE,0,0,0,,Pagod na pagod ka.
Dialogue: 0,0:19:54.48,0:19:55.52,Default,PINEAPPLE,0,0,0,,No wonder,
Dialogue: 0,0:19:55.52,0:19:57.81,Default,PINEAPPLE,0,0,0,,masyado kaming nainom kagabi.
Dialogue: 0,0:19:58.69,0:20:00.58,Default,PINEAPPLE,0,0,0,,Ano ang nainom natin doon?
Dialogue: 0,0:20:01.09,0:20:02.92,Default,PINEAPPLE,0,0,0,,Hinihintay na tayo ng mga courtier.
Dialogue: 0,0:20:02.92,0:20:04.42,Default,PINEAPPLE,0,0,0,,Iminumungkahi kong magmadali ka.
Dialogue: 0,0:20:14.90,0:20:17.24,Default,PINEAPPLE,0,0,0,,Injeongjeong Hall
Dialogue: 0,0:20:48.94,0:20:52.01,Default,PINEAPPLE,0,0,0,,State Councilor Kim Byung-hak.
Dialogue: 0,0:20:55.51,0:20:57.51,Default,PINEAPPLE,0,0,0,,Congratulations.
Dialogue: 0,0:21:03.22,0:21:05.99,Default,PINEAPPLE,0,0,0,,Left Advisor Kim Seok-keun.
Dialogue: 0,0:21:05.99,0:21:07.56,Default,PINEAPPLE,0,0,0,,Congratulations.
Dialogue: 0,0:21:08.92,0:21:12.03,Default,PINEAPPLE,0,0,0,,Minister of War Kim Chang-hyuk.
Dialogue: 0,0:21:12.33,0:21:13.80,Default,PINEAPPLE,0,0,0,,Congratulations.
Dialogue: 0,0:21:13.80,0:21:15.53,Default,PINEAPPLE,0,0,0,,At lahat ng Kim.
Dialogue: 0,0:21:16.40,0:21:19.30,Default,PINEAPPLE,0,0,0,,Kaya ganyan ka,\Nthe famous trinity of Kims from Andong.
Dialogue: 0,0:21:21.60,0:21:23.77,Default,PINEAPPLE,0,0,0,,Sa tulong ng Queen Dowager at ng asawa ng Hari
Dialogue: 0,0:21:23.77,0:21:26.94,Default,PINEAPPLE,0,0,0,,nakagawa sila ng\Niba't ibang dahilan para sa pagkolekta ng buwis.
Dialogue: 0,0:21:26.94,0:21:28.54,Default,PINEAPPLE,0,0,0,,Dahil sa kanila, labis na nagdusa ang mga tao.
Dialogue: 0,0:21:28.78,0:21:30.85,Default,PINEAPPLE,0,0,0,,Noong panahon ko\Nsila ay inakusahan ng katiwalian sa sektor ng depensa
Dialogue: 0,0:21:30.85,0:21:32.75,Default,PINEAPPLE,0,0,0,,at real estate,\Na pati na rin ang pag-iwas sa buwis.
Dialogue: 0,0:21:32.75,0:21:34.58,Default,PINEAPPLE,0,0,0,,Ang aming arrow ay hinog na kahit saan.
Dialogue: 0,0:21:34.58,0:21:36.22,Default,PINEAPPLE,0,0,0,,Sa madaling salita, narito, isang trio ng mga reptilya,
Dialogue: 0,0:21:36.22,0:21:38.75,Default,PINEAPPLE,0,0,0,,simbolo ng katiwalian na sumira sa bansa.
Dialogue: 0,0:21:38.75,0:21:40.26,Default,PINEAPPLE,0,0,0,,Andon clan Kim.
Dialogue: 0,0:21:42.52,0:21:45.69,Default,PINEAPPLE,0,0,0,,Tamang Advisor Cho Man-heon.
Dialogue: 0,0:21:49.76,0:21:51.73,Default,PINEAPPLE,0,0,0,,Congratulations.
Dialogue: 0,0:21:52.87,0:21:56.13,Default,PINEAPPLE,0,0,0,,Minister of Officials Jo Dongmun.
Dialogue: 0,0:21:56.77,0:21:58.44,Default,PINEAPPLE,0,0,0,,Congratulations.
Dialogue: 0,0:21:58.91,0:22:00.83,Default,PINEAPPLE,0,0,0,,Narito ang pamilya Cho mula sa Pungyang.
Dialogue: 0,0:22:01.38,0:22:03.67,Default,PINEAPPLE,0,0,0,,Sikat ang mga ito sa pananatili\Nmalapit sa Inang Reyna.
Dialogue: 0,0:22:04.01,0:22:05.61,Default,PINEAPPLE,0,0,0,,Noong hari ang kanyang anak na si Hongjong,
Dialogue: 0,0:22:05.61,0:22:07.62,Default,PINEAPPLE,0,0,0,,pinagmamalaki sila, at pagkatapos ay namatay siya.
Dialogue: 0,0:22:07.62,0:22:09.65,Default,PINEAPPLE,0,0,0,,Umakyat sa trono si Kim Soyeon mula sa pamilya Andong,
Dialogue: 0,0:22:09.65,0:22:11.05,Default,PINEAPPLE,0,0,0,,at nawalan sila ng impluwensya.
Dialogue: 0,0:22:12.85,0:22:15.72,Default,PINEAPPLE,0,0,0,,Ngayon maliit na isda na lang sila.
Dialogue: 0,0:22:16.02,0:22:17.43,Default,PINEAPPLE,0,0,0,,Ang talagang ibig sabihin ay...
Dialogue: 0,0:22:17.43,0:22:20.85,Default,PINEAPPLE,0,0,0,,Kumander ng tropa Kim Jwageun.
Dialogue: 0,0:22:22.60,0:22:24.77,Default,PINEAPPLE,0,0,0,,Congratulations, Your Majesty,
Dialogue: 0,0:22:25.20,0:22:26.77,Default,PINEAPPLE,0,0,0,,Mga Kamahalan.
Dialogue: 0,0:22:27.40,0:22:29.30,Default,PINEAPPLE,0,0,0,,Narito siya - ang lalaking nasa mga kamay niya ang lahat ng kapangyarihan ng pamilya Kim.
Dialogue: 0,0:22:31.14,0:22:33.94,Default,PINEAPPLE,0,0,0,,Mula nang napag-usapan namin ang tungkol sa kasal mo,
Dialogue: 0,0:22:33.94,0:22:36.07,Default,PINEAPPLE,0,0,0,,May gusto akong iulat.
Dialogue: 0,0:22:38.25,0:22:39.40,Default,PINEAPPLE,0,0,0,,Magsalita.
Dialogue: 0,0:22:39.65,0:22:41.95,Default,PINEAPPLE,0,0,0,,Ang pinuno ng royal guard\Nis responsable para sa iyong kaligtasan.
Dialogue: 0,0:22:42.78,0:22:46.11,Default,PINEAPPLE,0,0,0,,Ipinapayo ko sa iyo na italaga si Kim Moon-geun sa posisyon na ito.
Dialogue: 0,0:22:48.22,0:22:49.85,Default,PINEAPPLE,0,0,0,,Ang aking biyenan?
Dialogue: 0,0:22:50.33,0:22:51.49,Default,PINEAPPLE,0,0,0,,Tama.
Dialogue: 0,0:22:54.26,0:22:56.70,Default,PINEAPPLE,0,0,0,,Ito ay isang napakahalagang post.
Dialogue: 0,0:22:57.17,0:23:00.36,Default,PINEAPPLE,0,0,0,,Nag-aalala ang Reyna sa iyong kaligtasan.
Dialogue: 0,0:23:01.00,0:23:03.33,Default,PINEAPPLE,0,0,0,,Paumanhin sa hindi pagbanggit nito kanina.
Dialogue: 0,0:23:04.71,0:23:06.81,Default,PINEAPPLE,0,0,0,,Gusto mo ba ito?
Dialogue: 0,0:23:07.08,0:23:08.60,Default,PINEAPPLE,0,0,0,,Alam ng Diyos, ngunit
Dialogue: 0,0:23:09.08,0:23:11.60,Default,PINEAPPLE,0,0,0,,I will stick to the winners.
Dialogue: 0,0:23:12.65,0:23:15.72,Default,PINEAPPLE,0,0,0,,Patay o buhay,\NI ay mag-aalala tungkol sa iyong kaligtasan.
Dialogue: 0,0:23:15.95,0:23:18.72,Default,PINEAPPLE,0,0,0,,Upang matiyak na ikaw ay ligtas at malusog,\NI napuyat buong gabi.
Dialogue: 0,0:23:20.96,0:23:23.02,Default,PINEAPPLE,0,0,0,,Isang ahas, hindi babae.
Dialogue: 0,0:23:26.53,0:23:29.32,Default,PINEAPPLE,0,0,0,,Yun lang, then I agree.
Dialogue: 0,0:23:29.36,0:23:30.87,Default,PINEAPPLE,0,0,0,,Dowager Queen
Dialogue: 0,0:23:30.87,0:23:33.86,Default,PINEAPPLE,0,0,0,,natutuwa akong marinig ang tungkol sa kahilingan ng reyna.
Dialogue: 0,0:23:34.47,0:23:36.47,Default,PINEAPPLE,0,0,0,,Kasalukuyang hawak ng kapatid ko ang posisyong ito
Dialogue: 0,0:23:36.47,0:23:37.84,Default,PINEAPPLE,0,0,0,,Prinsipe Yeonpyeong.
Dialogue: 0,0:23:37.84,0:23:39.84,Default,PINEAPPLE,0,0,0,,Kailangan ko ng oras para mag-isip.
Dialogue: 0,0:23:39.84,0:23:42.57,Default,PINEAPPLE,0,0,0,,Una ang iyong kaligtasan.
Dialogue: 0,0:23:44.65,0:23:47.95,Default,PINEAPPLE,0,0,0,,Kamahalan, mangyaring magpasya
Dialogue: 0,0:23:48.95,0:23:50.38,Default,PINEAPPLE,0,0,0,,asap.
Dialogue: 0,0:24:09.20,0:24:13.04,Default,PINEAPPLE,0,0,0,,Ang pagmamahal mo sa akin ay walang hangganan.
Dialogue: 0,0:24:13.81,0:24:17.48,Default,PINEAPPLE,0,0,0,,Then, with your permission, I will continue.
Dialogue: 0,0:24:20.68,0:24:22.12,Default,PINEAPPLE,0,0,0,,Kim Jwageun,
Dialogue: 0,0:24:22.12,0:24:24.31,Default,PINEAPPLE,0,0,0,,isang tao na ang kapangyarihan ay higit sa hari.
Dialogue: 0,0:24:24.85,0:24:28.08,Default,PINEAPPLE,0,0,0,,Ito ang talagang namumuno sa bansa.
Dialogue: 0,0:24:31.19,0:24:33.26,Default,PINEAPPLE,0,0,0,,Pop corn dito.
Dialogue: 0,0:24:35.96,0:24:38.09,Default,PINEAPPLE,0,0,0,,-Kamahalan!\N-Reyna!
Dialogue: 0,0:24:56.89,0:24:59.64,Default,PINEAPPLE,0,0,0,,Paumanhin, ituloy natin ang kaganapan.
Dialogue: 0,0:25:02.29,0:25:06.53,Default,PINEAPPLE,0,0,0,,Mukhang pagod na ang reyna.\NMarahil dito na tayo magtatapos.
Dialogue: 0,0:25:06.86,0:25:10.56,Default,PINEAPPLE,0,0,0,,Ang gabing magkasama ay ang panahon kung kailan ang mga diyos\Ntumulong sa paglilihi ng tagapagmana.
Dialogue: 0,0:25:10.67,0:25:13.12,Default,PINEAPPLE,0,0,0,,Hindi tayo dapat magpadala sa kasiyahan.
Dialogue: 0,0:25:13.33,0:25:16.04,Default,PINEAPPLE,0,0,0,,Kagabi, gayunpaman, naiinip ako.
Dialogue: 0,0:25:17.11,0:25:20.14,Default,PINEAPPLE,0,0,0,,Walang masama sa pagiging happily married.
Dialogue: 0,0:25:20.14,0:25:21.44,Default,PINEAPPLE,0,0,0,,Ganun ba?
Dialogue: 0,0:25:21.51,0:25:23.13,Default,PINEAPPLE,0,0,0,,Anong pinagsasabi niya dito?
Dialogue: 0,0:25:23.68,0:25:26.10,Default,PINEAPPLE,0,0,0,,Pagkatapos ay hayaan na natin ito.
Dialogue: 0,0:25:26.25,0:25:30.99,Default,PINEAPPLE,0,0,0,,-Salamat, Kamahalan.\N-Salamat, Kamahalan.
Dialogue: 0,0:25:35.52,0:25:37.23,Default,PINEAPPLE,0,0,0,,Na-bluff ka diba?
Dialogue: 0,0:25:37.86,0:25:39.38,Default,PINEAPPLE,0,0,0,,Hindi kita maintindihan.
Dialogue: 0,0:25:39.89,0:25:41.83,Default,PINEAPPLE,0,0,0,,Walang nangyari kagabi.
Dialogue: 0,0:25:41.83,0:25:45.30,Default,PINEAPPLE,0,0,0,,Napagalit mo ako, oo, marami kang nainom,
Dialogue: 0,0:25:45.67,0:25:48.27,Default,PINEAPPLE,0,0,0,,pero paano mo makakalimutan\Nano ang nangyari sa gabi ng iyong kasal?
Dialogue: 0,0:25:49.80,0:25:50.91,Default,PINEAPPLE,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:25:50.91,0:25:52.21,Default,PINEAPPLE,0,0,0,,Naiintindihan ko lahat.
Dialogue: 0,0:25:52.34,0:25:55.57,Default,PINEAPPLE,0,0,0,,Nasira mo ang iyong memorya,\Maaaring nakakalimutan mo ang tungkol sa isang bagay.
Dialogue: 0,0:25:56.61,0:25:59.17,Default,PINEAPPLE,0,0,0,,Hindi pwede iyon.\NTWalang namamagitan sa amin.
Dialogue: 0,0:26:02.28,0:26:03.84,Default,PINEAPPLE,0,0,0,,Nalampasan mo ang pagsusulit.
Dialogue: 0,0:26:04.89,0:26:06.92,Default,PINEAPPLE,0,0,0,,Checking? Anong uri ng tseke?
Dialogue: 0,0:26:06.92,0:26:10.19,Default,PINEAPPLE,0,0,0,,Virginity test,\Nmay dugo sa kama.
Dialogue: 0,0:26:11.46,0:26:13.35,Default,PINEAPPLE,0,0,0,,May gagawin ako, pupunta ako.
Dialogue: 0,0:26:17.33,0:26:20.94,Default,PINEAPPLE,0,0,0,,Sandali! Hindi kami pumayag!
Dialogue: 0,0:26:20.94,0:26:24.06,Default,PINEAPPLE,0,0,0,,Kamahalan, pumunta tayo sa mga silid.
Dialogue: 0,0:26:26.51,0:26:29.28,Default,PINEAPPLE,0,0,0,,Huwag kang mag-alala, Jang Bong Hwan, nagsisinungaling siya.
Dialogue: 0,0:26:29.44,0:26:32.67,Default,PINEAPPLE,0,0,0,,Mag-isip ka, malalaman mo kung may nangyari.
Dialogue: 0,0:26:32.98,0:26:34.75,Default,PINEAPPLE,0,0,0,,Walang nangyari! wala!
Dialogue: 0,0:26:37.22,0:26:40.31,Default,PINEAPPLE,0,0,0,,Natural, ayaw niyang malaman ng mga tao na hindi siya hardy.
Dialogue: 0,0:26:40.39,0:26:42.92,Default,PINEAPPLE,0,0,0,,At parang mahilig siyang baluktutin ang katotohanan.
Dialogue: 0,0:26:42.92,0:26:45.19,Default,PINEAPPLE,0,0,0,,At gayon pa man!\NDKailangan mo bang magkalkula?
Dialogue: 0,0:26:45.19,0:26:47.09,Default,PINEAPPLE,0,0,0,,Para saan ba ito ng pagsuri?\NPara saan ito?
Dialogue: 0,0:26:50.30,0:26:51.47,Default,PINEAPPLE,0,0,0,,Sandali!
Dialogue: 0,0:26:53.60,0:26:55.06,Default,PINEAPPLE,0,0,0,,Pwede ba akong magtanong?
Dialogue: 0,0:26:57.71,0:27:01.71,Default,PINEAPPLE,0,0,0,,Malalaman ng babae kung may nangyari?
Dialogue: 0,0:27:01.81,0:27:03.07,Default,PINEAPPLE,0,0,0,,Something?
Dialogue: 0,0:27:03.18,0:27:05.64,Default,PINEAPPLE,0,0,0,,Ano ang sinasabi mo, Kamahalan?
Dialogue: 0,0:27:08.08,0:27:09.61,Default,PINEAPPLE,0,0,0,,Masyado pang bata ang isang ito.
Dialogue: 0,0:27:11.15,0:27:13.52,Default,PINEAPPLE,0,0,0,,At ang celibate na ito ay mas masahol pa sa mga monghe.
Dialogue: 0,0:27:15.72,0:27:18.15,Default,PINEAPPLE,0,0,0,,Mukhang walang makakasagot sa akin.
Dialogue: 0,0:27:21.76,0:27:23.06,Default,PINEAPPLE,0,0,0,,Nakakatakot na bangungot!
Dialogue: 0,0:27:37.95,0:27:40.72,Default,3,0,0,0,,-Iiyak ba ang bata dahil sa akin?\N-Hindi naman, Kamahalan.
Dialogue: 0,0:27:40.72,0:27:42.92,Default,3,0,0,0,,Malamig ang hangin. Isara ko ang bintana.
Dialogue: 0,0:27:42.92,0:27:45.09,Default,3,0,0,0,,-Pinapawisan na ako.\N-Napakalamig.
Dialogue: 0,0:27:45.09,0:27:46.32,Default,3,0,0,0,,-Ang init dito!\N-Lalamig ka.
Dialogue: 0,0:27:46.32,0:27:47.81,Default,3,0,0,0,,Naiinitan ako!
Dialogue: 0,0:27:47.82,0:27:49.02,Default,3,0,0,0,,Tara na.
Dialogue: 0,0:27:52.06,0:27:55.56,Default,3,0,0,0,,Hindi ko mapigilang isipin ang mga salita ni Cheoljong.
Dialogue: 0,0:28:07.89,0:28:09.66,Default,3,0,0,0,,Kumain nang payapa, Kamahalan.
Dialogue: 0,0:28:11.36,0:28:12.93,Default,3,0,0,0,,Nakikita ang reyna,
Dialogue: 0,0:28:12.96,0:28:16.00,Default,3,0,0,0,,Na-realize ko na wala pa rin siya sa sarili niya.
Dialogue: 0,0:28:16.00,0:28:17.27,Default,3,0,0,0,,Paano ko sasabihin?
Dialogue: 0,0:28:19.34,0:28:21.24,Default,3,0,0,0,,Sobrang bastos?
Dialogue: 0,0:28:21.37,0:28:23.21,Default,3,0,0,0,,Lagi siyang matapang,
Dialogue: 0,0:28:23.21,0:28:26.44,Default,3,0,0,0,,ngunit hindi masyadong mayabang at walang takot.
Dialogue: 0,0:28:26.44,0:28:29.78,Default,3,0,0,0,,Nawala ang kanyang kalmado sa panahon ng seremonya.
Dialogue: 0,0:28:29.78,0:28:32.32,Default,3,0,0,0,,Dapat kong ituro sa kanya ang mga tuntunin ng pagiging disente.
Dialogue: 0,0:28:32.45,0:28:35.32,Default,3,0,0,0,,Hindi mo maipapakita ang iyong kahinaan sa iba.
Dialogue: 0,0:28:36.62,0:28:38.09,Default,3,0,0,0,,At para kay Cho Hwajin...
Dialogue: 0,0:28:38.46,0:28:41.69,Default,3,0,0,0,,Sigurado ka bang kasama niya ang Kanyang Kamahalan noong gabing iyon?
Dialogue: 0,0:28:41.79,0:28:44.90,Default,3,0,0,0,,Oo, sinigurado ko iyon.
Dialogue: 0,0:28:45.10,0:28:47.93,Default,3,0,0,0,,Pumasok siya sa palasyo makalipas ang 15 minuto
Dialogue: 0,0:28:47.93,0:28:49.70,Default,3,0,0,0,,pagkatapos ng aksidente.
Dialogue: 0,0:28:49.87,0:28:53.94,Default,3,0,0,0,,Hindi ito patunay na sinubukan niyang saktan ang Kanyang Kamahalan,
Dialogue: 0,0:28:54.34,0:28:56.51,Default,3,0,0,0,,ngunit maaari mong subukang gamitin ito.
Dialogue: 0,0:28:57.24,0:28:59.01,Default,3,0,0,0,,Malaking misteryo.
Dialogue: 0,0:28:59.44,0:29:02.15,Default,3,0,0,0,,Kung hindi niya ginawa, sino?
Dialogue: 0,0:29:04.12,0:29:06.18,Default,3,0,0,0,,Sa tingin mo ba ay may iba pang kasangkot?
Dialogue: 0,0:29:06.55,0:29:07.79,Default,3,0,0,0,,Posible.
Dialogue: 0,0:29:08.25,0:29:11.56,Default,3,0,0,0,,Hindi mahalaga kung sino ang eksaktong gumawa nito.
Dialogue: 0,0:29:13.79,0:29:16.83,Default,3,0,0,0,,Ang mas mahalaga ay kung sino ang dapat nating sisihin para dito.
Dialogue: 0,0:29:18.20,0:29:20.33,Default,3,0,0,0,,Sino ang kailangan natin?
Dialogue: 0,0:29:20.33,0:29:21.67,Default,3,0,0,0,,Kung itinuro natin ang isang usa
Dialogue: 0,0:29:22.20,0:29:25.47,Default,3,0,0,0,,at sabihin natin na ito ay isang kabayo, kung gayon ito ay magiging isang kabayo.
Dialogue: 0,0:29:25.64,0:29:30.81,Default,3,0,0,0,,Sa aming kaso, maaari talagang maging kabayo ang usa.
Dialogue: 0,0:29:31.31,0:29:34.45,Default,3,0,0,0,,Okay. Kalimutan muna ang tungkol sa negosyo
Dialogue: 0,0:29:34.45,0:29:36.38,Default,3,0,0,0,,at kumain, Kamahalan.
Dialogue: 0,0:29:37.82,0:29:41.05,Default,3,0,0,0,,Dahil tinitiyak mong kumakain ako ng maayos,
Dialogue: 0,0:29:41.05,0:29:44.46,Default,3,0,0,0,,Kailangan kong pangalagaan ang aking kalusugan.
Dialogue: 0,0:29:44.46,0:29:47.16,Default,3,0,0,0,,Hindi ko hahayaang saktan ka ng sinuman.
Dialogue: 0,0:29:48.43,0:29:49.56,Default,3,0,0,0,,Bon appetit.
Dialogue: 0,0:30:04.31,0:30:07.51,Default,3,0,0,0,,"Sa pamamagitan nito ay nagtatalaga ako ng senior rank sa loob ng hukuman
Dialogue: 0,0:30:07.51,0:30:09.01,Default,3,0,0,0,,Cho Hwajin, mga anak na babae
Dialogue: 0,0:30:09.01,0:30:11.95,Default,3,0,0,0,,court secretary Cho Daesu mula sa Pungyang Cho family.
Dialogue: 0,0:30:12.25,0:30:15.55,Default,3,0,0,0,,Binigyan din siya ng titulong royal concubine
Dialogue: 0,0:30:15.55,0:30:17.92,Default,3,0,0,0,,para sa kanyang kagandahan at katuwiran."
Dialogue: 0,0:30:17.92,0:30:19.66,Default,3,0,0,0,,Pungyang clan of Cho.
Dialogue: 0,0:30:19.89,0:30:21.96,Default,3,0,0,0,,Nag-aaway ang kanilang mga pamilya, tulad nila.
Dialogue: 0,0:30:21.96,0:30:24.63,Default,3,0,0,0,,Itinulak niya ba talaga si Kim So-yeon sa lawa?
Dialogue: 0,0:30:25.46,0:30:26.96,Default,3,0,0,0,,Delikado siya,
Dialogue: 0,0:30:27.67,0:30:28.93,Default,3,0,0,0,,at ito ay kaakit-akit.
Dialogue: 0,0:30:31.74,0:30:33.77,Default,3,0,0,0,,Nagpapasalamat ako sa iyo, Kamahalan.
Dialogue: 0,0:30:36.21,0:30:37.51,Default,3,0,0,0,,Magkaibigan tayo.
Dialogue: 0,0:30:41.51,0:30:43.15,Default,3,0,0,0,,Ako, siyempre, nasa winning side,
Dialogue: 0,0:30:43.15,0:30:45.65,Default,3,0,0,0,,pero hindi ko mapigilan ang ganoong kagandahan.
Dialogue: 0,0:30:47.85,0:30:49.05,Default,3,0,0,0,,Magkaibigan tayo.
Dialogue: 0,0:30:49.69,0:30:53.32,Default,3,0,0,0,,Malapit mong mauunawaan na ako ay \Nperfection, well, maliban
Dialogue: 0,0:30:53.72,0:30:55.09,Default,3,0,0,0,,isang pares ng mga pagkukulang.
Dialogue: 0,0:30:58.33,0:31:00.40,Default,3,0,0,0,,Dahil malapit na tayo,
Dialogue: 0,0:31:00.40,0:31:02.13,Default,3,0,0,0,,pwede ba akong magtanong?
Dialogue: 0,0:31:02.13,0:31:04.14,Default,3,0,0,0,,Walang ibang magtatanong.
Dialogue: 0,0:31:04.20,0:31:07.81,Default,3,0,0,0,,Hindi ako sigurado kung may karunungan akong sagutin ang tanong.
Dialogue: 0,0:31:07.81,0:31:11.11,Default,3,0,0,0,,Tiyak na alam mo ang lahat tungkol sa kanya. Ang tinutukoy ko ay ang hari.
Dialogue: 0,0:31:25.09,0:31:28.06,Default,3,0,0,0,,Madalas ba siyang magsinungaling?
Dialogue: 0,0:31:29.63,0:31:31.73,Default,3,0,0,0,,Marami na akong narinig tungkol sa kanya.
Dialogue: 0,0:31:32.13,0:31:35.10,Default,3,0,0,0,,At sabi nila ang hari
Dialogue: 0,0:31:35.10,0:31:36.50,Default,3,0,0,0,,nawawala sa gabi.
Dialogue: 0,0:31:37.17,0:31:39.47,Default,3,0,0,0,,Nawawala sa gabi?
Dialogue: 0,0:31:40.24,0:31:42.37,Default,3,0,0,0,,Wala akong narinig na ganyan.
Dialogue: 0,0:31:42.37,0:31:45.54,Default,3,0,0,0,,Isang manlalaban sa araw, at nawala sa gabi.
Dialogue: 0,0:31:47.31,0:31:50.45,Default,3,0,0,0,,Sabi niya, mainit ang gabi naming magkasama.
Dialogue: 0,0:31:50.45,0:31:53.42,Default,3,0,0,0,,-Mahilig siyang magdistort...\N-Kamahalan.
Dialogue: 0,0:31:53.72,0:31:56.55,Default,3,0,0,0,,Sa lahat ng nararapat na paggalang, ito ay lubos na hindi naaangkop.
Dialogue: 0,0:31:56.82,0:32:00.46,Default,3,0,0,0,,Paumanhin kung nasaktan kita. Hindi ko maiwasang isipin ito.
Dialogue: 0,0:32:01.43,0:32:04.36,Default,3,0,0,0,,Kahapon lang ako dumating, marami akong dapat ipag-alala.
Dialogue: 0,0:32:04.56,0:32:07.40,Default,3,0,0,0,,Paumanhin sa pagkuha ng oras. Pumunta ka.
Dialogue: 0,0:32:10.74,0:32:11.90,Default,3,0,0,0,,Magkita tayo mamaya.
Dialogue: 0,0:32:21.25,0:32:25.22,Default,3,0,0,0,,May sasabihin ako para sigurado. Hindi ganoon ang kanyang Kamahalan.
Dialogue: 0,0:32:35.36,0:32:39.43,Default,3,0,0,0,,Hindi ganoon? Sinasabi mo bang hindi siya nagsisinungaling?
Dialogue: 0,0:32:39.93,0:32:43.30,Default,3,0,0,0,,O hindi ba ito nawawala sa gabi? Ano ang pinagsasabi mo?
Dialogue: 0,0:32:47.00,0:32:48.51,Default,3,0,0,0,,Hindi ito mas malinaw!
Dialogue: 0,0:32:50.98,0:32:52.24,Default,3,0,0,0,,Damn.
Dialogue: 0,0:34:41.59,0:34:43.05,Default,3,0,0,0,,Mga Magnanakaw!
Dialogue: 0,0:34:43.69,0:34:45.69,Default,3,0,0,0,,Mga Magnanakaw!
Dialogue: 0,0:34:45.79,0:34:47.86,Default,3,0,0,0,,Mga Magnanakaw! May mga magnanakaw dito!
Dialogue: 0,0:34:48.33,0:34:50.36,Default,3,0,0,0,,Mga Magnanakaw!
Dialogue: 0,0:34:50.96,0:34:52.80,Default,3,0,0,0,,Mga Magnanakaw! Nandiyan sila!
Dialogue: 0,0:34:55.87,0:34:57.37,Default,3,0,0,0,,Mga Magnanakaw!
Dialogue: 0,0:35:16.02,0:35:18.46,Default,3,0,0,0,,Huwag umiyak. Hindi na kailangan.
Dialogue: 0,0:35:18.46,0:35:19.62,Default,3,0,0,0,,Stop it, okay?
Dialogue: 0,0:35:30.80,0:35:33.10,Default,3,0,0,0,,Baby ko, baby!
Dialogue: 0,0:35:46.25,0:35:47.35,Default,3,0,0,0,,Hindi!
Dialogue: 0,0:36:38.30,0:36:39.47,Default,3,0,0,0,,Kamahalan.
Dialogue: 0,0:36:43.81,0:36:46.54,Default,3,0,0,0,,Wala rin ito sa secret storage, na-check ko ito sa gabi.
Dialogue: 0,0:36:47.04,0:36:48.68,Default,3,0,0,0,,Naghanap ako ng maigi
Dialogue: 0,0:36:48.68,0:36:51.15,Default,3,0,0,0,,lahat ng nakatagong sulok sa palasyo,
Dialogue: 0,0:36:51.45,0:36:54.05,Default,3,0,0,0,,posible bang nakatago ito sa yungib ng tigre?
Dialogue: 0,0:36:55.05,0:36:58.12,Default,3,0,0,0,,Kamahalan, narito ang reyna para makita ka.
Dialogue: 0,0:37:07.10,0:37:09.30,Default,3,0,0,0,,I'm too busy with the affairs of the country.
Dialogue: 0,0:37:09.30,0:37:10.67,Default,3,0,0,0,,Kaya nasa punto ako.
Dialogue: 0,0:37:10.67,0:37:12.14,Default,3,0,0,0,,May pag-uusapan.
Dialogue: 0,0:37:17.64,0:37:20.68,Default,3,0,0,0,,Napaka-busy at hawak-hawak mo ito ng nakabaligtad.
Dialogue: 0,0:37:23.31,0:37:26.25,Default,3,0,0,0,,Ito ay hindi walang dahilan, nag-isip ako ng maraming bagay.
Dialogue: 0,0:37:27.65,0:37:29.99,Default,3,0,0,0,,Pag-isipan ang iyong mga iniisip. maghihintay ako.
Dialogue: 0,0:37:43.57,0:37:45.47,Default,3,0,0,0,,Bakit ka nakatitig ng ganyan?
Dialogue: 0,0:37:46.14,0:37:47.24,Default,3,0,0,0,,Nakikita mo,
Dialogue: 0,0:37:47.84,0:37:50.37,Default,3,0,0,0,,kawili-wiling makita kung gaano ka nagsisikap.
Dialogue: 0,0:37:50.37,0:37:54.24,Default,3,0,0,0,,Bilang isang hari, kailangan kong pangasiwaan ang mga gawain ng bansa.
Dialogue: 0,0:37:54.51,0:37:57.58,Default,3,0,0,0,,Sinasadya ba niya ang tungkol sa "negosyo"?
Dialogue: 0,0:37:58.15,0:38:00.48,Default,3,0,0,0,,Nagtalaga ako ng royal concubine ayon sa gusto mo.
Dialogue: 0,0:38:00.68,0:38:02.42,Default,3,0,0,0,,Maaari kang matulog sa iyong mga silid.
Dialogue: 0,0:38:02.42,0:38:03.59,Default,3,0,0,0,,Na may kasiyahan.
Dialogue: 0,0:38:06.36,0:38:08.06,Default,3,0,0,0,,May gusto ka bang sabihin sa akin?
Dialogue: 0,0:38:08.86,0:38:10.83,Default,3,0,0,0,,Ikaw mismo ang lumapit sa akin.
Dialogue: 0,0:38:10.83,0:38:13.06,Default,3,0,0,0,,Marahil may gusto kang sabihin sa iyong sarili.
Dialogue: 0,0:38:14.70,0:38:17.00,Default,3,0,0,0,,Dahil tayong dalawa lang ang nandito, let’s be honest.
Dialogue: 0,0:38:17.00,0:38:18.04,Default,3,0,0,0,,Kagabi namin...
Dialogue: 0,0:38:18.04,0:38:20.14,Default,3,0,0,0,,Napakasaya namin.
Dialogue: 0,0:38:22.61,0:38:25.78,Default,3,0,0,0,,Okay, kung patuloy kang magpapanggap...
Dialogue: 0,0:38:43.73,0:38:44.83,Default,3,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:38:45.23,0:38:47.23,Default,3,0,0,0,,Ginagambala mo ako.
Dialogue: 0,0:38:50.10,0:38:51.47,Default,3,0,0,0,,Kung ayaw mong magsalita,
Dialogue: 0,0:38:51.47,0:38:53.27,Default,3,0,0,0,,gumamit ng mga hand signal?
Dialogue: 0,0:38:53.27,0:38:54.47,Default,3,0,0,0,,Halimbawa, ito.
Dialogue: 0,0:38:55.34,0:38:56.57,Default,3,0,0,0,,Ano ito?
Dialogue: 0,0:38:56.84,0:39:00.18,Default,3,0,0,0,,Ibig sabihin nagsisinungaling ako.
Dialogue: 0,0:39:00.48,0:39:02.58,Default,3,0,0,0,,Ano ang sasabihin mo? Hindi naman mahirap diba?
Dialogue: 0,0:39:09.09,0:39:11.96,Default,3,0,0,0,,Ang hari ay hindi nagsisinungaling.
Dialogue: 0,0:39:13.66,0:39:14.86,Default,3,0,0,0,,Maaari kang pumunta.
Dialogue: 0,0:39:21.40,0:39:23.03,Default,3,0,0,0,,Damn. Kaya nakakainis.
Dialogue: 0,0:39:23.50,0:39:25.54,Default,3,0,0,0,,Na may diretsong mukha, ipinipilit niyang may nangyari.
Dialogue: 0,0:39:25.54,0:39:28.51,Default,3,0,0,0,,Totoo ba ito o hindi?
Dialogue: 0,0:39:29.91,0:39:32.44,Default,3,0,0,0,,Kamahalan, mahirap ba ang araw na ito?
Dialogue: 0,0:39:39.62,0:39:42.42,Default,3,0,0,0,,Oh, nakakakiliti yan.
Dialogue: 0,0:39:42.85,0:39:44.69,Default,3,0,0,0,,Uy, dahan-dahan lang.
Dialogue: 0,0:39:45.06,0:39:47.42,Default,3,0,0,0,,Nakikiliti ako.
Dialogue: 0,0:39:54.43,0:39:55.60,Default,3,0,0,0,,Kamahalan.
Dialogue: 0,0:39:55.77,0:39:59.10,Default,3,0,0,0,,Magsisimula ngayon ang mga klase sa etiquette.
Dialogue: 0,0:39:59.27,0:40:01.61,Default,3,0,0,0,,Ayos na ang ugali ko.
Dialogue: 0,0:40:05.28,0:40:08.85,Default,3,0,0,0,,Ito ay isang crash course sa palace etiquette.
Dialogue: 0,0:40:11.08,0:40:12.58,Default,3,0,0,0,,Ayoko.
Dialogue: 0,0:40:18.12,0:40:20.79,Default,3,0,0,0,,Order mula sa Queen Dowager.
Dialogue: 0,0:40:21.36,0:40:22.43,Default,3,0,0,0,,Gusto kong bumalik,
Dialogue: 0,0:40:22.43,0:40:23.99,Default,3,0,0,0,,sa halip na pumasa sa mga pagsusulit.
Dialogue: 0,0:40:24.16,0:40:26.06,Default,3,0,0,0,,Upang magsimula, matatalo ko ang reyna.
Dialogue: 0,0:40:29.80,0:40:32.00,Default,3,0,0,0,,Maaaring hindi mo alam, pero nag-aral ako ng etiquette
Dialogue: 0,0:40:32.00,0:40:34.34,Default,3,0,0,0,,sa Cheongaktong sa loob ng apat na taon.
Dialogue: 0,0:40:35.14,0:40:38.98,Default,3,0,0,0,,Ipakita kung gaano kahusay ang graduate?
Dialogue: 0,0:40:47.25,0:40:51.39,Default,3,0,0,0,,Ang babae mula sa royal family ay kalmado bilang isang Buddha.
Dialogue: 0,0:40:58.30,0:41:00.43,Default,3,0,0,0,,Hindi siya gumagawa ng hininga habang naglalakad.
Dialogue: 0,0:41:00.53,0:41:02.53,Default,3,0,0,0,,Hindi kumikislap ang mga ilaw ng kandila.
Dialogue: 0,0:41:20.82,0:41:23.95,Default,3,0,0,0,,Hindi niya ibinuka ang kanyang bibig habang kumakain
Dialogue: 0,0:41:24.32,0:41:26.49,Default,3,0,0,0,,at hindi kumagat sa malalaking piraso.
Dialogue: 0,0:41:40.77,0:41:43.11,Default,3,0,0,0,,Ang pagbuburda ay ang pinakamahusay na paraan para sa isang babae
Dialogue: 0,0:41:43.11,0:41:44.68,Default,3,0,0,0,,unawain ang iyong mga iniisip.
Dialogue: 0,0:41:46.74,0:41:49.38,Default,3,0,0,0,,Pagbuburda. Kaya niya.
Dialogue: 0,0:41:59.59,0:42:01.63,Default,3,0,0,0,,Napakalaki ako.
Dialogue: 0,0:42:01.63,0:42:02.96,Default,3,0,0,0,,Hindi ako makahinga ngayon?
Dialogue: 0,0:42:02.96,0:42:04.26,Default,3,0,0,0,,Mas malala dito kaysa sa Cheongaktong.
Dialogue: 0,0:42:04.26,0:42:05.43,Default,3,0,0,0,,Sa impiyerno.
Dialogue: 0,0:42:14.44,0:42:16.47,Default,3,0,0,0,,Paano kumain ng ganitong kagandahan?
Dialogue: 0,0:42:17.24,0:42:19.91,Default,3,0,0,0,,Una, manood at magsaya.
Dialogue: 0,0:42:21.01,0:42:23.58,Default,3,0,0,0,,Manood ba tayo? parang
Dialogue: 0,0:42:23.58,0:42:25.35,Default,3,0,0,0,,isinilid mo ang lahat sa iyong bibig.
Dialogue: 0,0:42:29.32,0:42:31.72,Default,3,0,0,0,,Gusto mo noon.
Dialogue: 0,0:42:33.49,0:42:35.19,Default,3,0,0,0,,Honyoung, subukan ito. Mas malapad ang iyong bibig.
Dialogue: 0,0:42:46.84,0:42:48.47,Default,3,0,0,0,,Ano ang nangyari, Kamahalan?
Dialogue: 0,0:42:55.08,0:42:57.18,Default,3,0,0,0,,Ito ba ang mga alaala ni Kim So-yeon?
Dialogue: 0,0:42:58.42,0:42:59.72,Default,3,0,0,0,,Puso...
Dialogue: 0,0:43:01.75,0:43:02.89,Default,3,0,0,0,,Nalason.
Dialogue: 0,0:43:02.89,0:43:04.59,Default,3,0,0,0,,Mabilis, ang manggagamot dito!
Dialogue: 0,0:43:04.59,0:43:05.86,Default,3,0,0,0,,-Kamahalan.\N-Kamahalan.
Dialogue: 0,0:43:06.22,0:43:08.16,Default,3,0,0,0,,-Iluwa mo.\N-Kamahalan.
Dialogue: 0,0:43:08.49,0:43:11.39,Default,3,0,0,0,,-Kamahalan.\N-Hindi ito sakit.
Dialogue: 0,0:43:13.03,0:43:17.30,Default,3,0,0,0,,Mahal ba ng babaeng ito si Cheoljong?
Dialogue: 0,0:43:30.21,0:43:32.05,Default,3,0,0,0,,Dapat mahalin mo ako.
Dialogue: 0,0:43:37.45,0:43:38.72,Default,3,0,0,0,,Ang kanyang mga mata.
Dialogue: 0,0:43:39.72,0:43:41.86,Default,3,0,0,0,,Ito ay higit pa sa poot. Hinahamak niya siya.
Dialogue: 0,0:43:44.26,0:43:45.60,Default,3,0,0,0,,Pakiusap, Kamahalan.
Dialogue: 0,0:43:51.57,0:43:53.87,Default,3,0,0,0,,Mas gusto ko ang mga meryenda kaysa sa alkohol mismo.
Dialogue: 0,0:43:54.10,0:43:55.44,Default,3,0,0,0,,At mabuti.
Dialogue: 0,0:43:55.47,0:43:58.11,Default,3,0,0,0,,Pabor sa iyo ang lahat ng alak.
Dialogue: 0,0:43:58.11,0:44:01.55,Default,3,0,0,0,,Hindi niya ako sasaluhin ngayong gabi.
Dialogue: 0,0:44:01.55,0:44:03.58,Default,3,0,0,0,,Kaya sinubukan niya akong lasingin.
Dialogue: 0,0:44:03.95,0:44:06.02,Default,3,0,0,0,,Isa lang ang iniisip namin.
Dialogue: 0,0:44:06.98,0:44:10.12,Default,PINEAPPLE,0,0,0,,Ngayon ay kailangan mong subukan ang iyong makakaya upang makagawa ng tagapagmana.
Dialogue: 0,0:44:10.12,0:44:12.76,Default,3,0,0,0,,Mamulat ka, Kamahalan.
Dialogue: 0,0:44:12.76,0:44:14.46,Default,3,0,0,0,,Magdala ng tubig!
Dialogue: 0,0:44:14.49,0:44:15.49,Default,3,0,0,0,,Para lokohin ang pamilya Kim,
Dialogue: 0,0:44:15.49,0:44:17.16,Default,3,0,0,0,,pinipilit silang matulog,
Dialogue: 0,0:44:17.16,0:44:20.06,Default,3,0,0,0,,Nagsinungaling si Choljong.
Dialogue: 0,0:44:26.50,0:44:29.21,Default,3,0,0,0,,Honyoung. Walang anuman!
Dialogue: 0,0:44:31.24,0:44:33.41,Default,3,0,0,0,,Halos mabaliw ako sa pag-iisip tungkol dito.
Dialogue: 0,0:44:33.41,0:44:35.95,Default,3,0,0,0,,Pinagkakatiwalaan ko ang aking sarili, ngunit hindi ang tanga.
Dialogue: 0,0:44:35.95,0:44:37.08,Default,3,0,0,0,,Gayunpaman...
Dialogue: 0,0:44:40.75,0:44:41.99,Default,3,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:44:59.34,0:45:03.14,Default,3,0,0,0,,-Higit pa. Hilahin ito nang mas mataas.\N-Oo.
Dialogue: 0,0:45:05.54,0:45:09.05,Default,3,0,0,0,,Ganyan kapagod i-maintain ang posisyon mo.
Dialogue: 0,0:45:09.05,0:45:12.12,Default,3,0,0,0,,Decrepitude ay nangangahulugan na ikaw ay humina.
Dialogue: 0,0:45:12.25,0:45:14.65,Default,3,0,0,0,,Kung gagawin mo ito dalawang beses sa isang araw,
Dialogue: 0,0:45:14.65,0:45:17.62,Default,3,0,0,0,,hindi lalalim ang mga wrinkles.
Dialogue: 0,0:45:18.05,0:45:21.76,Default,3,0,0,0,,Nakikita ko. Subukan mo nang husto.
Dialogue: 0,0:45:22.09,0:45:23.89,Default,3,0,0,0,,Bakit ka pumunta sa akin?
Dialogue: 0,0:45:24.33,0:45:26.56,Default,3,0,0,0,,Sa iyong pagpupumilit, na nakatanggap ng mga aralin sa etiketa,
Dialogue: 0,0:45:26.56,0:45:29.10,Default,3,0,0,0,,Napagtanto ko kung ano ang dapat kong gawin
Dialogue: 0,0:45:29.10,0:45:30.80,Default,3,0,0,0,,isang tunay na reyna.
Dialogue: 0,0:45:31.33,0:45:32.87,Default,3,0,0,0,,Masayang-masaya ako.
Dialogue: 0,0:45:34.57,0:45:37.31,Default,4,0,0,0,,-Sapat na, huminto. \N-Okay, okay.
Dialogue: 0,0:45:44.45,0:45:46.18,Default,4,0,0,0,,Kaya, kahapon kami ay natulog kasama ng Kanyang Kamahalan,
Dialogue: 0,0:45:46.52,0:45:48.82,Default,4,0,0,0,,pero parang inilabas nila lahat ng lakas ko sa akin,
Dialogue: 0,0:45:48.82,0:45:51.02,Default,4,0,0,0,,naging matamlay ang lahat.
Dialogue: 0,0:45:51.49,0:45:54.06,Default,4,0,0,0,,Patuloy kong iniisip kung ano ang dahilan, at naintindihan ko!
Dialogue: 0,0:45:56.33,0:45:59.03,Default,4,0,0,0,,Lahat dahil naubos ang mga reservoir.
Dialogue: 0,0:45:59.13,0:46:01.50,Default,4,0,0,0,,Kaya humina ang prinsipyo ko sa pagkababae.
Dialogue: 0,0:46:02.00,0:46:03.87,Default,4,0,0,0,,Kung sila ay napuno muli ng tubig,
Dialogue: 0,0:46:03.87,0:46:05.90,Default,4,0,0,0,,Kaagad kong buhatin ang prinsipe.
Dialogue: 0,0:46:05.90,0:46:07.17,Default,4,0,0,0,,Ibinukod.
Dialogue: 0,0:46:08.17,0:46:11.47,Default,4,0,0,0,,-Oh damn.\N-Halos naligtas ka namin.
Dialogue: 0,0:46:11.47,0:46:13.41,Default,4,0,0,0,,Sa mabuting paraan, lahat ng pumayag
Dialogue: 0,0:46:13.41,0:46:16.35,Default,4,0,0,0,,kung may nangyaring ganito, dapat sila ay pinatay.
Dialogue: 0,0:46:16.51,0:46:18.78,Default,4,0,0,0,,Gayunpaman, sa bisperas ng gayong masayang kaganapan,
Dialogue: 0,0:46:18.78,0:46:21.52,Default,4,0,0,0,,nagpakita kami ng awa at hindi nagbuhos ng dugo.
Dialogue: 0,0:46:22.79,0:46:26.82,Default,4,0,0,0,,Ngunit dahil gusto mong punuin ng tubig ang mga lawa, kailangan mong parusahan ang lahat ng responsable.
Dialogue: 0,0:46:27.12,0:46:30.49,Default,4,0,0,0,,Sino ang nandoon? Hongyong, court lady ni Choi. sino pa ba
Dialogue: 0,0:46:31.46,0:46:35.13,Default,4,0,0,0,,Lahat ng kasali ay paparusahan ng buong kalubhaan.
Dialogue: 0,0:46:35.20,0:46:38.27,Default,4,0,0,0,,Napakasama. Hindi ito ang lola ng matamis mong kapitbahay.
Dialogue: 0,0:46:39.24,0:46:40.40,Default,4,0,0,0,,Paano kung i-execute ko
Dialogue: 0,0:46:41.10,0:46:42.74,Default,4,0,0,0,, tungkulin sa pag-aasawa para sa tatlong buong gabi,
Dialogue: 0,0:46:42.74,0:46:44.61,Default,4,0,0,0,,upang magbuntis ng anak para sa hari sa lalong madaling panahon?
Dialogue: 0,0:46:45.51,0:46:47.34,Default,4,0,0,0,,Pupunuin mo ba ng tubig ang mga pond para dito?
Dialogue: 0,0:46:47.54,0:46:48.68,Default,4,0,0,0,,Pitong gabi.
Dialogue: 0,0:46:49.48,0:46:50.65,Default,4,0,0,0,,Lima.
Dialogue: 0,0:46:50.71,0:46:53.75,Default,4,0,0,0,,Makinig dito. Lahat ng nasangkot...
Dialogue: 0,0:46:53.75,0:46:54.88,Default,4,0,0,0,,Pitong gabi.
Dialogue: 0,0:46:55.39,0:46:56.69,Default,4,0,0,0,,Ang pito ay isang magandang numero.
Dialogue: 0,0:46:57.15,0:46:59.72,Default,4,0,0,0,,Kung pangako mong pupunuin ng tubig ang mga lawa,
Dialogue: 0,0:46:59.72,0:47:02.36,Default,4,0,0,0,,Gagawin ko ang lahat para magbuntis ng prinsipe.
Dialogue: 0,0:47:05.10,0:47:08.37,Default,4,0,0,0,,Kahit isang batang lalaki, kahit isang maliit na aso, para lang bumalik.
Dialogue: 0,0:47:28.45,0:47:30.52,Default,4,0,0,0,,Dumating si Concubine Cho para batiin ka.
Dialogue: 0,0:47:35.79,0:47:40.26,Default,4,0,0,0,,Wow, kasing ganda at kaakit-akit ka gaya ng paglalarawan nila sa iyo.
Dialogue: 0,0:47:40.90,0:47:45.24,Default,4,0,0,0,,Ang Kanyang Kamahalan ay may mata sa mga kagandahan.
Dialogue: 0,0:47:45.90,0:47:47.54,Default,4,0,0,0,,Nambobola mo ako.
Dialogue: 0,0:47:56.88,0:47:58.25,Default,4,0,0,0,,Ito ay isang regalo.
Dialogue: 0,0:47:58.52,0:48:00.62,Default,4,0,0,0,,Isang bagay na kakailanganin mo sa palasyo.
Dialogue: 0,0:48:00.62,0:48:02.52,Default,4,0,0,0,,Imposible kung wala ito.
Dialogue: 0,0:48:04.29,0:48:05.86,Default,4,0,0,0,,Tingnan mo.
Dialogue: 0,0:48:20.97,0:48:23.14,Default,4,0,0,0,,Ang buhay sa palasyo ay hindi talaga asukal.
Dialogue: 0,0:48:23.44,0:48:25.38,Default,4,0,0,0,,Walang maasahan dito.
Dialogue: 0,0:48:25.38,0:48:28.91,Default,4,0,0,0,,Dito mo makakalimutan ang mga tahimik na araw.
Dialogue: 0,0:48:29.35,0:48:33.25,Default,4,0,0,0,,Oh yes, tell me anong araw at taon ka ipinanganak?
Dialogue: 0,0:48:33.98,0:48:37.95,Default,4,0,0,0,,Alam mo ba kung ano ang gagawin para magbuntis ng anak para sa Kanyang Kamahalan?
Dialogue: 0,0:48:39.86,0:48:42.03,Default,4,0,0,0,,Ano ang sinasabi ko?
Dialogue: 0,0:48:42.03,0:48:44.89,Default,4,0,0,0,,Una kailangan mong tingnan ang\N compatibility sa His Majesty.
Dialogue: 0,0:48:47.16,0:48:51.90,Default,4,0,0,0,,Makipag-ugnayan sa akin kung kailangan mo ng makapangyarihang anting-anting.
Dialogue: 0,0:48:53.07,0:48:57.24,Default,4,0,0,0,,May kilala akong shaman na maraming alam tungkol sa masasamang mata at sumpa.
Dialogue: 0,0:48:57.34,0:48:59.88,Default,4,0,0,0,,Noong huling beses natuwa ako sa kanya.
Dialogue: 0,0:49:00.04,0:49:02.91,Default,4,0,0,0,,Kamahalan, patawarin mo ako.
Dialogue: 0,0:49:02.91,0:49:05.92,Default,4,0,0,0,,Ngunit narito ako para pangalagaan ang ikabubuti ng Kanyang Kamahalan.
Dialogue: 0,0:49:07.58,0:49:10.65,Default,4,0,0,0,,Mukhang, may mali akong naintindihan.
Dialogue: 0,0:49:12.22,0:49:13.99,Default,4,0,0,0,,Paumanhin, Inang Reyna.
Dialogue: 0,0:49:14.36,0:49:16.53,Default,4,0,0,0,,Marahil masyado akong malupit.
Dialogue: 0,0:49:16.56,0:49:20.16,Default,4,0,0,0,,Lahat ay maayos. Huwag isapuso.
Dialogue: 0,0:49:22.80,0:49:26.04,Default,4,0,0,0,,Sa pamamagitan ng paraan, tungkol sa puso. Ito ang iyong mga unang araw sa palasyo,
Dialogue: 0,0:49:26.34,0:49:28.84,Default,4,0,0,0,,at kakailanganin mong magtanim ng mag-isa.
Dialogue: 0,0:49:29.17,0:49:32.34,Default,4,0,0,0,,Nakakahiya. Anong balak mong gawin?
Dialogue: 0,0:49:33.21,0:49:34.38,Default,4,0,0,0,,Ano?
Dialogue: 0,0:49:34.58,0:49:37.48,Default,4,0,0,0,,Para sa susunod na pitong araw ang Kanyang Kamahalan ay
Dialogue: 0,0:49:37.48,0:49:39.58,Default,4,0,0,0,,sleep in Her Majesty's chambers.
Dialogue: 0,0:49:39.75,0:49:41.95,Default,4,0,0,0,,Ok na ang lahat sa kanila,
Dialogue: 0,0:49:41.95,0:49:44.95,Default,4,0,0,0,,tahimik at tahimik.
Dialogue: 0,0:49:45.39,0:49:47.89,Default,4,0,0,0,,Kaya pitong gabi pa silang magkasama.
Dialogue: 0,0:49:48.76,0:49:50.99,Default,4,0,0,0,,Ngunit wala kang dapat ipag-alala.
Dialogue: 0,0:49:51.16,0:49:53.36,Default,4,0,0,0,,Natitiyak kong sa loob ng pitong araw na ito ang damdamin ng Kanyang Kamahalan
Dialogue: 0,0:49:53.36,0:49:56.13,Default,4,0,0,0,,hindi sila magpapalamig sa iyo.
Dialogue: 0,0:50:24.76,0:50:26.40,Default,4,0,0,0,,Balang araw matatalo ka
Dialogue: 0,0:50:27.56,0:50:30.20,Default,4,0,0,0,,taong mahal mo.
Dialogue: 0,0:50:51.29,0:50:52.42,Default,4,0,0,0,,Ms.
Dialogue: 0,0:51:02.53,0:51:05.50,Default,4,0,0,0,,Mukhang nasira ko ang sheet,\Nwala nang maayos dito.
Dialogue: 0,0:51:06.74,0:51:09.04,Default,4,0,0,0,,Sayang naman, pero kailangan mong isulat muli ang lahat.
Dialogue: 0,0:51:11.37,0:51:15.31,Default,4,0,0,0,,Napakaganda mo kaya madali kang maging reyna.
Dialogue: 0,0:51:16.25,0:51:18.65,Default,4,0,0,0,,Ang tanging bentahe ng reyna ay isang magandang pedigree,
Dialogue: 0,0:51:18.65,0:51:20.55,Default,4,0,0,0,,at pinaikot niya ang Kanyang Kamahalan ayon sa gusto niya.
Dialogue: 0,0:51:20.55,0:51:21.72,Default,4,0,0,0,,Tandaan.
Dialogue: 0,0:51:22.55,0:51:25.26,Default,4,0,0,0,,Ang reyna ay pantay sa katayuan sa hari.
Dialogue: 0,0:51:25.56,0:51:27.72,Default,4,0,0,0,,Tandaan, mas mataas ang status, mas malaki ang responsibilidad,
Dialogue: 0,0:51:27.79,0:51:29.39,Default,4,0,0,0,,panoorin kung ano ang iyong sasabihin.
Dialogue: 0,0:51:29.39,0:51:30.93,Default,4,0,0,0,,Huwag pumunta sa isang manghuhula dito, siya ang gumagawa.
Dialogue: 0,0:51:30.93,0:51:32.96,Default,4,0,0,0,,Siya ang bumulong sa mga babae sa korte tungkol sa pitong gabi.
Dialogue: 0,0:51:32.96,0:51:35.60,Default,4,0,0,0,, Inakusahan ka rin niya ng isang bagay na hindi mo ginawa.
Dialogue: 0,0:51:35.70,0:51:38.53,Default,4,0,0,0,,Nakakahiya na natagpuan mo ang iyong sarili doon sa pinaka hindi angkop na sandali!
Dialogue: 0,0:51:44.74,0:51:47.34,Default,4,0,0,0,,Hindi pa ako nasanay sa buhay sa palasyo.
Dialogue: 0,0:51:47.84,0:51:49.28,Default,4,0,0,0,,Ang aking dila ay aking kaaway.
Dialogue: 0,0:51:50.35,0:51:52.18,Default,4,0,0,0,,Patawarin mo ako, madam.
Dialogue: 0,0:51:55.42,0:51:59.79,Default,4,0,0,0,,Paano ko makukuha ang pabor ng Kanyang Kamahalan?
Dialogue: 0,0:52:12.80,0:52:14.54,Default,4,0,0,0,,Siya mismo ang nagsabi sa akin na magpalipas ng gabi sa aking mga silid.
Dialogue: 0,0:52:14.54,0:52:17.64,Default,4,0,0,0,,At pagkatapos ay bumaling siya sa Dowager Queen\N na may ibang kahilingan.
Dialogue: 0,0:52:17.71,0:52:20.58,Default,4,0,0,0,,Gaano kahirap unawain ang puso ng isang babae.
Dialogue: 0,0:52:21.38,0:52:24.45,Default,4,0,0,0,,Makinig, may gusto akong ibigay sa iyo\N. Wala kang pakialam, di ba?
Dialogue: 0,0:52:24.95,0:52:28.08,Default,4,0,0,0,,Paano kita tatanggihan?
Dialogue: 0,0:52:28.72,0:52:31.42,Default,4,0,0,0,,Iminumungkahi kong panatilihin ang social distancing.
Dialogue: 0,0:52:31.42,0:52:33.56,Default,4,0,0,0,,-Hindi talaga. \N-Sabi mo hindi ka tatanggi.
Dialogue: 0,0:52:33.56,0:52:35.09,Default,4,0,0,0,,Hindi ko maintindihan ang kahulugan ng iyong mga salita.
Dialogue: 0,0:52:35.26,0:52:37.16,Default,4,0,0,0,,Wala akong naintindihan, pero sumuko ka na ba?
Dialogue: 0,0:52:37.16,0:52:39.73,Default,4,0,0,0,,Kaya tumanggi ako dahil wala akong naintindihan.
Dialogue: 0,0:52:42.47,0:52:44.17,Default,4,0,0,0,,Kung gayon, makinig ka, ipapaliwanag ko ngayon.
Dialogue: 0,0:52:44.47,0:52:48.24,Default,4,0,0,0,,Ang social distancing ay kapag ang lahat ay nag-iisa.
Dialogue: 0,0:52:48.24,0:52:49.47,Default,4,0,0,0,,Na napakahusay.
Dialogue: 0,0:52:49.51,0:52:51.91,Default,4,0,0,0,,Sabihin nating dapat tayong matulog nang magkasama.
Dialogue: 0,0:52:51.91,0:52:54.81,Default,4,0,0,0,,Sa katunayan, natutulog ka sa iyong lugar, at ako sa aking lugar.
Dialogue: 0,0:52:55.45,0:52:57.01,Default,4,0,0,0,,Ito ay distancing.
Dialogue: 0,0:52:59.45,0:53:00.72,Default,4,0,0,0,,Tutol pa rin ako.
Dialogue: 0,0:53:01.15,0:53:02.95,Default,4,0,0,0,,Pero bakit?
Dialogue: 0,0:53:04.32,0:53:07.39,Default,4,0,0,0,,Hindi ko alam kung bakit, ngunit hindi ko ito gusto.
Dialogue: 0,0:53:08.02,0:53:09.89,Default,4,0,0,0,,Nakakapahamak na pervert.
Dialogue: 0,0:53:12.50,0:53:15.57,Default,4,0,0,0,,Well, kailangan mong makipag-usap sa mga pervert sa kanilang sariling wika.
Dialogue: 0,0:53:18.23,0:53:20.87,Default,4,0,0,0,,Alam mo, wala akong maalala kagabi.
Dialogue: 0,0:53:21.10,0:53:22.74,Default,4,0,0,0,,Baka maulit natin?
Dialogue: 0,0:53:23.34,0:53:25.41,Default,4,0,0,0,,Sigahan natin ito ng maayos.
Dialogue: 0,0:53:26.61,0:53:27.81,Default,4,0,0,0,,Sindiin ba natin ito?
Dialogue: 0,0:53:27.81,0:53:29.25,Default,4,0,0,0,,Mainit ang gabi natin.
Dialogue: 0,0:53:29.75,0:53:30.88,Default,4,0,0,0,,Ngayong Gabi
Dialogue: 0,0:53:32.02,0:53:34.48,Default,4,0,0,0,, ang unang pagkakataon natin.
Dialogue: 0,0:53:41.62,0:53:42.89,Default,4,0,0,0,,Well, kung oo...
Dialogue: 0,0:53:52.64,0:53:56.04,Default,4,0,0,0,,Ano ang ginagawa mo? Halika na dali. Mapapansin ka nila.
Dialogue: 0,0:53:56.04,0:53:58.94,Default,4,0,0,0,,Hindi nararapat para sa isang hari na magpalusot na parang magnanakaw.
Dialogue: 0,0:53:59.48,0:54:00.64,Default,4,0,0,0,,Ang tanga.
Dialogue: 0,0:54:02.58,0:54:03.98,Default,4,0,0,0,,Ano? Court Lady Choi?
Dialogue: 0,0:54:13.99,0:54:16.19,Default,4,0,0,0,,Maaari tayong magkaroon ng malaking problema, Kamahalan.
Dialogue: 0,0:54:16.29,0:54:18.59,Default,4,0,0,0,,Paano ako magiging mabuting pinuno,
Dialogue: 0,0:54:18.59,0:54:20.96,Default,4,0,0,0,,kung hindi ko alam kung paano nabubuhay ang mga ordinaryong tao?
Dialogue: 0,0:54:20.96,0:54:22.53,Default,4,0,0,0,,Nawa'y maging marangal ang iyong mga iniisip,
Dialogue: 0,0:54:23.00,0:54:24.47,Default,4,0,0,0,,masyadong mapanganib pa rin ang ideya.
Dialogue: 0,0:54:24.47,0:54:27.24,Default,4,0,0,0,,Siyempre, handa akong ibigay ang buhay ko para sa iyo, pero...
Dialogue: 0,0:54:27.24,0:54:28.40,Default,4,0,0,0,,Nasaan ang mapa?
Dialogue: 0,0:54:32.08,0:54:34.01,Default,4,0,0,0,,-Sa pagkakataong ito... \N-Name plate?
Dialogue: 0,0:54:36.58,0:54:38.01,Default,4,0,0,0,,Dapat pigilan kita.
Dialogue: 0,0:54:38.25,0:54:39.52,Default,4,0,0,0,,Ang pangalan ko pala ay
Dialogue: 0,0:54:40.28,0:54:41.78,Default,4,0,0,0,,Lee Senman?
Dialogue: 0,0:54:42.85,0:54:44.72,Default,4,0,0,0,,Anong katakut-takot na pangalan?
Dialogue: 0,0:54:45.25,0:54:47.09,Default,4,0,0,0,,Sen bilang "pag-isipan" at Tao bilang "tulad ng "subukan".
Dialogue: 0,0:54:47.09,0:54:50.53,Default,4,0,0,0,,Isang nagmumuni-muni na nagsisikap para sa kapakanan\N ng mga tao. Wala kang maisip na mas magandang pangalan.
Dialogue: 0,0:54:51.46,0:54:54.80,Default,4,0,0,0,,Well, sabihin na natin. Hindi yan ang pangalan ko at ayos lang.
Dialogue: 0,0:54:55.30,0:54:57.80,Default,4,0,0,0,,-Kailan magsisimula ang curfew doon? \N-Sa oras ng mouse
Dialogue: 0,0:54:57.80,0:54:59.50,Default,4,0,0,0,,tunog ng mga guard ang mga kampana ng 28 beses,
Dialogue: 0,0:54:59.50,0:55:00.90,Default,4,0,0,0,,at pagkatapos ay isara ang gate.
Dialogue: 0,0:55:01.94,0:55:03.91,Default,4,0,0,0,,Ang mga kampana ay tumutunog, kung gayon?
Dialogue: 0,0:55:04.54,0:55:06.54,Default,4,0,0,0,,Sa oras ng mouse?
Dialogue: 0,0:55:08.75,0:55:11.25,Default,4,0,0,0,,Sucks. Ang oras kung kailan magsisimula ang lahat ng saya.
Dialogue: 0,0:55:12.65,0:55:13.75,Default,4,0,0,0,,Wala.
Dialogue: 0,0:55:14.32,0:55:15.95,Default,4,0,0,0,,Nangangako akong babalik ako sa oras na ito.
Dialogue: 0,0:55:17.25,0:55:18.32,Default,4,0,0,0,,Well, hindi.
Dialogue: 0,0:55:18.32,0:55:19.92,Default,4,0,0,0,,Gagawin ko ang lahat,
Dialogue: 0,0:55:19.92,0:55:22.09,Default,4,0,0,0,,pero hindi kita hahayaang umalis.
Dialogue: 0,0:55:33.14,0:55:34.24,Default,4,0,0,0,,Honyeon.
Dialogue: 0,0:55:35.24,0:55:36.94,Default,4,0,0,0,,Anong klaseng tao ako?
Dialogue: 0,0:55:38.37,0:55:40.08,Default,4,0,0,0,,Palagi kang
Dialogue: 0,0:55:41.08,0:55:44.68,Default,4,0,0,0,,mabait at masayahin.
Dialogue: 0,0:55:44.68,0:55:46.92,Default,4,0,0,0,,Lubos na palakaibigan
Dialogue: 0,0:55:46.92,0:55:48.72,Default,4,0,0,0,,at laging nakangiti.
Dialogue: 0,0:55:50.35,0:55:52.42,Default,4,0,0,0,,Naiintindihan mo na mas alam ko
Dialogue: 0,0:55:52.52,0:55:54.36,Default,4,0,0,0,,katotohanan mula sa iyo kaysa sa iba.
Dialogue: 0,0:55:55.02,0:55:56.13,Default,4,0,0,0,,Oo.
Dialogue: 0,0:55:57.66,0:55:58.79,Default,4,0,0,0,,Okay.
Dialogue: 0,0:56:02.00,0:56:04.40,Default,4,0,0,0,,So, minsan nagbabasa ka ng libro.
Dialogue: 0,0:56:10.91,0:56:13.44,Default,4,0,0,0,,Imposibleng basahin dito!
Dialogue: 0,0:56:14.74,0:56:16.95,Default,4,0,0,0,,Napakaingay mo sa paghinga,
Dialogue: 0,0:56:16.95,0:56:19.18,Default,4,0,0,0,,na malapit na akong mabingi!
Dialogue: 0,0:56:20.52,0:56:23.79,Default,4,0,0,0,,Halika rito! Alisin mo siya at bigyan ng magandang palo!
Dialogue: 0,0:56:24.15,0:56:26.22,Default,4,0,0,0,,Mayroon akong matagal nang problema sa aking ilong.
Dialogue: 0,0:56:26.22,0:56:27.49,Default,4,0,0,0,,Maawa ka, Kamahalan!
Dialogue: 0,0:56:27.49,0:56:28.79,Default,4,0,0,0,,Tara na.
Dialogue: 0,0:56:42.47,0:56:45.04,Default,4,0,0,0,,Nagkamali ka ng one fourth note.
Dialogue: 0,0:56:45.88,0:56:48.08,Default,4,0,0,0,,Natapakan ba ng oso ang tenga mo o ano?
Dialogue: 0,0:56:48.41,0:56:49.98,Default,4,0,0,0,,At tinatawag mo pa ring guro ang iyong sarili?
Dialogue: 0,0:56:51.58,0:56:52.68,Default,4,0,0,0,,Halika dito!
Dialogue: 0,0:56:53.55,0:56:55.22,Default,4,0,0,0,,Hagupitin ang tanga!
Dialogue: 0,0:56:56.55,0:56:58.05,Default,4,0,0,0,,Talaga? Hindi pwede!
Dialogue: 0,0:57:01.46,0:57:02.63,Default,4,0,0,0,,Nakakatawa ba ito sa iyo?
Dialogue: 0,0:57:03.39,0:57:05.60,Default,4,0,0,0,,Mukhang walang magawa.
Dialogue: 0,0:57:06.66,0:57:09.70,Default,4,0,0,0,,Halika dito! Alisin ang dalawang ito at bigyan sila ng magandang bugbog!
Dialogue: 0,0:57:10.43,0:57:11.60,Default,4,0,0,0,,Hinga lang
Dialogue: 0,0:57:11.60,0:57:13.07,Default,4,0,0,0,,at nawawalan ka na ng galit.
Dialogue: 0,0:57:13.07,0:57:14.07,Default,4,0,0,0,,Sulit na maglagay ng pabango,
Dialogue: 0,0:57:14.07,0:57:15.34,Default,4,0,0,0,,naakusahan na sinusubukang akitin ang hari.
Dialogue: 0,0:57:15.34,0:57:16.74,Default,4,0,0,0,,Maingay kaming naglalakad - masama,
Dialogue: 0,0:57:16.74,0:57:18.37,Default,4,0,0,0,,mas malala pa ang paglalakad ng tahimik.
Dialogue: 0,0:57:18.37,0:57:19.94,Default,4,0,0,0,,Palagi kang makakahanap ng mairereklamo.
Dialogue: 0,0:57:19.94,0:57:23.18,Default,4,0,0,0,,Bawat maliit na bagay ay nagagalit sa iyo.
Dialogue: 0,0:57:23.61,0:57:26.58,Default,4,0,0,0,,Kaya tinawag ka nilang viper.
Dialogue: 0,0:57:31.65,0:57:32.82,Default,4,0,0,0,,Oh, sorry.
Dialogue: 0,0:57:34.22,0:57:36.06,Default,4,0,0,0,,Gusto ko lang sagutan ka sa mga detalye,
Dialogue: 0,0:57:36.06,0:57:37.59,Default,4,0,0,0,,pero medyo nadala ako.
Dialogue: 0,0:57:37.99,0:57:41.10,Default,4,0,0,0,,Mukhang maraming tao ang gustong lunurin ang babaeng ito.
Dialogue: 0,0:57:41.73,0:57:43.67,Default,4,0,0,0,,Kaya pala ang mga babae ng court...
Dialogue: 0,0:57:44.53,0:57:46.90,Default,4,0,0,0,,Hindi lang nila alam kung ano ka talaga.
Dialogue: 0,0:57:48.07,0:57:49.31,Default,4,0,0,0,,Alam mo ba?
Dialogue: 0,0:57:49.71,0:57:50.91,Default,4,0,0,0,,Siyempre.
Dialogue: 0,0:57:51.14,0:57:54.14,Default,4,0,0,0,,Naglilingkod ako sa iyo mula pagkabata.
Dialogue: 0,0:57:54.48,0:57:56.48,Default,4,0,0,0,,At alam kong may mabuting puso ka.
Dialogue: 0,0:57:56.88,0:57:58.51,Default,4,0,0,0,,At ikaw ay matalino lampas sa iyong mga taon.
Dialogue: 0,0:57:58.51,0:58:00.95,Default,4,0,0,0,,At dahil nasa isip mo na,\Tiyak na makakamit mo ang iyong layunin.
Dialogue: 0,0:58:00.95,0:58:02.32,Default,4,0,0,0,,Ikaw ay isang halimbawa para sa akin.
Dialogue: 0,0:58:04.52,0:58:07.76,Default,4,0,0,0,,Bagaman sa palasyo madalas kang malungkot.
Dialogue: 0,0:58:08.76,0:58:12.83,Default,4,0,0,0,,Kung tutuusin, ang Kanyang Kamahalan ay habol sa bawat palda.
Dialogue: 0,0:58:15.23,0:58:17.47,Default,4,0,0,0,,Hindi gaanong nag-iisa ang babaeng ito.
Dialogue: 0,0:58:18.47,0:58:20.50,Default,4,0,0,0,,Dahil may malapit na tao na nakakaintindi sa kanya.
Dialogue: 0,0:58:21.24,0:58:22.94,Default,4,0,0,0,,Lady?
Dialogue: 0,0:58:23.04,0:58:26.18,Default,4,0,0,0,,Ibig sabihin, pinaliwanag mo ang aking kalungkutan.
Dialogue: 0,0:58:28.34,0:58:29.61,Default,4,0,0,0,,Ano ang sinasabi mo.
Dialogue: 0,0:58:32.55,0:58:35.18,Default,5,0,0,0,,Huwag kang mag-alala, Hongyeon. Matulog ng mahimbing.
Dialogue: 0,0:58:35.75,0:58:38.99,Default,5,0,0,0,,Para sa kapakanan mo, susubukan kong hindi mahuli.
Dialogue: 0,0:58:41.09,0:58:43.06,Default,5,0,0,0,,Papatayin ko kayong lahat!
Dialogue: 0,0:58:43.80,0:58:46.07,Default,5,0,0,0,,Mas mabuti pang tingnan mo, mga bastard!
Dialogue: 0,0:58:46.33,0:58:50.04,Default,5,0,0,0,,Hindi ko hahayaan na kunin mo ang asawa at anak ko na parang mga alipin!
Dialogue: 0,0:58:50.64,0:58:51.84,Default,5,0,0,0,,Kung hindi ka nagbabayad ng buwis,
Dialogue: 0,0:58:51.84,0:58:53.34,Default,5,0,0,0,,pagkatapos ay ibigay ang mga ito sa amin!
Dialogue: 0,0:58:53.34,0:58:54.97,Default,5,0,0,0,,Makasalanan ang hamak na ito!
Dialogue: 0,0:58:54.97,0:58:56.73,Default,5,0,0,0,,Ang tanging kasalanan ko ay
Dialogue: 0,0:58:56.98,0:59:01.31,Default,5,0,0,0,,payagan ang isang bata na mamuhay sa napakasamang mundo!
Dialogue: 0,0:59:05.22,0:59:06.92,Default,5,0,0,0,,Huwag kang lalapit! Huwag kang lalapit sa akin.
Dialogue: 0,0:59:07.49,0:59:10.19,Default,5,0,0,0,,Ang lokong ito ay nagkasala ng pagtataksil!
Dialogue: 0,0:59:10.19,0:59:12.46,Default,5,0,0,0,,Kung ang pagpatay sa mga hamak na tulad mo ay pagtataksil, gagawin ko.
Dialogue: 0,0:59:12.46,0:59:14.63,Default,5,0,0,0,,Oo! Ikalulugod kong gawin ito!
Dialogue: 0,0:59:15.39,0:59:16.73,Default,5,0,0,0,,Mahal!
Dialogue: 0,0:59:19.43,0:59:21.07,Default,5,0,0,0,,Huwag gawin ito.
Dialogue: 0,0:59:22.27,0:59:24.00,Default,5,0,0,0,,Alam kong masama ang loob mo.
Dialogue: 0,0:59:25.67,0:59:28.90,Default,5,0,0,0,,Gusto tayong patayin ng mga bastos na ito.
Dialogue: 0,0:59:29.34,0:59:31.34,Default,5,0,0,0,,Bakit ako titigil?
Dialogue: 0,0:59:33.81,0:59:34.94,Default,5,0,0,0,,Damhyan.
Dialogue: 0,0:59:42.59,0:59:46.42,Default,5,0,0,0,,Gumawa! Out of the way! Gumawa ng paraan!
Dialogue: 0,0:59:49.26,0:59:50.92,Default,5,0,0,0,,Ano ang nangyayari dito.
Dialogue: 0,0:59:51.36,0:59:52.59,Default,5,0,0,0,,Ano ang dapat nating gawin?
Dialogue: 0,1:00:18.36,1:00:20.63,Default,5,0,0,0,,Ama, bumalik ka na.
Dialogue: 0,1:00:20.86,1:00:23.15,Default,5,0,0,0,,Oo, kamusta ang biyahe mo?
Dialogue: 0,1:00:24.13,1:00:26.17,Default,5,0,0,0,,Paumanhin na-miss ko ito
Dialogue: 0,1:00:26.17,1:00:27.36,Default,5,0,0,0,,napakasayang kaganapan.
Dialogue: 0,1:00:28.07,1:00:29.84,Default,5,0,0,0,,Nakapagdesisyon ka na ba?
Dialogue: 0,1:00:29.84,1:00:31.69,Default,5,0,0,0,,Ano ang iyong sinasandal?
Dialogue: 0,1:00:32.81,1:00:34.94,Default,5,0,0,0,,Nagpasya akong sundin ang pangarap ko.
Dialogue: 0,1:00:35.67,1:00:38.44,Default,5,0,0,0,,Ngunit kung hanggang saan ako pupunta, hindi ko pa alam.
Dialogue: 0,1:00:38.68,1:00:40.00,Default,5,0,0,0,,Gaano kalayo?
Dialogue: 0,1:00:43.08,1:00:44.17,Default,5,0,0,0,,Tama.
Dialogue: 0,1:00:44.62,1:00:46.94,Default,5,0,0,0,,Pinagkakatiwalaan kita at hindi kita minamadali.
Dialogue: 0,1:00:47.79,1:00:51.71,Default,5,0,0,0,,Ngunit may nangyari nang wala ka.
Dialogue: 0,1:00:52.32,1:00:54.73,Default,5,0,0,0,,Nahulog ang reyna sa lawa
Dialogue: 0,1:00:54.73,1:00:56.59,Default,5,0,0,0,,sa gabi bago ang kasal.
Dialogue: 0,1:00:57.26,1:01:00.33,Default,5,0,0,0,,Buong araw siyang walang malay,
Dialogue: 0,1:01:00.33,1:01:02.77,Default,5,0,0,0,,kaya kinailangang ipagpaliban ang kasal.
Dialogue: 0,1:01:03.04,1:01:04.86,Default,5,0,0,0,,Kumusta na ang Her Highness ngayon?
Dialogue: 0,1:01:05.00,1:01:06.71,Default,5,0,0,0,,Okay lang ba siya?
Dialogue: 0,1:01:17.88,1:01:19.07,Default,5,0,0,0,,Stop!
Dialogue: 0,1:01:24.96,1:01:26.92,Default,5,0,0,0,,Hindi pa kita nakikita dati.
Dialogue: 0,1:01:27.39,1:01:29.96,Default,5,0,0,0,,Batay sa paraan ng pagtingin mo sa paligid...
Dialogue: 0,1:01:30.70,1:01:33.17,Default,5,0,0,0,,-Well...\N-First time sa palasyo?
Dialogue: 0,1:01:33.17,1:01:34.63,Default,5,0,0,0,,Mukhang nawala.
Dialogue: 0,1:01:35.97,1:01:37.54,Default,5,0,0,0,,Naligaw din ako sa unang pagkakataon.
Dialogue: 0,1:01:37.77,1:01:38.90,Default,5,0,0,0,,Tama.
Dialogue: 0,1:01:45.11,1:01:47.81,Default,5,0,0,0,,Pero parang pamilyar ka.
Dialogue: 0,1:01:51.78,1:01:53.35,Default,5,0,0,0,,Mamahaling damit
Dialogue: 0,1:01:53.35,1:01:56.38,Default,5,0,0,0,,at hindi matitinag na tiwala sa sarili.
Dialogue: 0,1:01:58.22,1:01:59.56,Default,5,0,0,0,,Dapat mula sa isang marangal na pamilya.
Dialogue: 0,1:02:00.16,1:02:02.15,Default,5,0,0,0,,Gayundin ang sasabihin ko.
Dialogue: 0,1:02:02.46,1:02:04.70,Default,5,0,0,0,,Ikaw ang sikat na anak na iyon.
Dialogue: 0,1:02:04.70,1:02:06.50,Default,5,0,0,0,,Kaakit-akit at mula sa isang respetadong pamilya.
Dialogue: 0,1:02:06.50,1:02:08.03,Default,5,0,0,0,,Matalino at mahuhusay.
Dialogue: 0,1:02:08.03,1:02:10.07,Default,5,0,0,0,,Narinig ko ang tungkol sa iyo. pangalan mo...
Dialogue: 0,1:02:10.07,1:02:11.19,Default,5,0,0,0,,Kim Hwan
Dialogue: 0,1:02:11.90,1:02:13.81,Default,5,0,0,0,,mula sa Andon family ni Kim.
Dialogue: 0,1:02:14.14,1:02:15.64,Default,5,0,0,0,,Narito ka, kamag-anak niya.
Dialogue: 0,1:02:15.64,1:02:17.27,Default,5,0,0,0,,Sikat na ba ako?
Dialogue: 0,1:02:18.51,1:02:19.98,Default,5,0,0,0,,Siyempre.
Dialogue: 0,1:02:20.21,1:02:22.71,Default,5,0,0,0,,Tanungin ang sinuman sa kalye: alam ng lahat.
Dialogue: 0,1:02:23.15,1:02:25.25,Default,5,0,0,0,,Isang karangalan na makilala ka.
Dialogue: 0,1:02:25.52,1:02:27.34,Default,5,0,0,0,,Aalis na rin ako.
Dialogue: 0,1:02:27.52,1:02:28.71,Default,5,0,0,0,,Sabay na tayo.
Dialogue: 0,1:02:29.42,1:02:31.48,Default,5,0,0,0,,Galing ako sa kabilang side.
Dialogue: 0,1:02:31.89,1:02:33.46,Default,5,0,0,0,,Dark, kaya pinaghalo ko.
Dialogue: 0,1:02:39.73,1:02:41.36,Default,5,0,0,0,, Pumutok at napatay siya.
Dialogue: 0,1:02:42.50,1:02:44.57,Default,5,0,0,0,,Paano ka makakapag-usap ng marami?
Dialogue: 0,1:02:44.57,1:02:46.01,Default,5,0,0,0,,Hindi siya tumigil kahit isang segundo.
Dialogue: 0,1:02:46.01,1:02:48.96,Default,5,0,0,0,,Kaya naman medyo nakakatakot dito.
Dialogue: 0,1:02:49.48,1:02:54.17,Default,5,0,0,0,,At iyan ang dahilan kung bakit nagkakaroon ng mga bangungot ang Kanyang Kamahalan tuwing gabi.
Dialogue: 0,1:02:55.11,1:02:56.25,Default,5,0,0,0,, Bangungot?
Dialogue: 0,1:02:57.45,1:03:00.65,Default,5,0,0,0,,Mula nang bumalik ang Kanyang Kamahalan mula sa Ganghwa,
Dialogue: 0,1:03:00.65,1:03:03.12,Default,5,0,0,0,,mayroon siyang parehong bangungot tuwing gabi.
Dialogue: 0,1:03:03.12,1:03:04.32,Default,5,0,0,0,,Tungkol sa,
Dialogue: 0,1:03:04.96,1:03:07.63,Default,5,0,0,0,,kung paano siya inakusahan ng pagtataksil
Dialogue: 0,1:03:07.93,1:03:09.15,Default,5,0,0,0,,at pinugutan ng ulo.
Dialogue: 0,1:03:14.80,1:03:16.14,Default,5,0,0,0,,Humihingi kami ng paumanhin sa hindi namin alam.
Dialogue: 0,1:03:16.14,1:03:18.86,Default,5,0,0,0,,Hindi nakakatakot. Napakaraming tao\N ang dumadaan sa mga gate na ito.
Dialogue: 0,1:03:21.37,1:03:22.77,Default,5,0,0,0,,Lee Senman
Dialogue: 0,1:03:30.68,1:03:33.25,Default,5,0,0,0,,Sa okasyon ng ating pagkakakilala, gusto ko
Dialogue: 0,1:03:33.25,1:03:35.45,Default,5,0,0,0,,bisitahin ang Kisen house.
Dialogue: 0,1:03:35.45,1:03:36.82,Default,5,0,0,0,,Alin ang pinakamahusay?
Dialogue: 0,1:03:37.46,1:03:40.42,Default,5,0,0,0,,Oktajeong. Ang isang ito ay ang pinakamahusay.
Dialogue: 0,1:03:41.26,1:03:43.80,Default,5,0,0,0,,Tawa ng ganito ang mga babae,
Dialogue: 0,1:03:43.80,1:03:46.96,Default,5,0,0,0,,kapag binanggit mo ang jade tablet. Samakatuwid, Oktajeong.
Dialogue: 0,1:03:49.10,1:03:50.57,Default,5,0,0,0,,Ipakita ang daan.
Dialogue: 0,1:03:50.77,1:03:52.44,Default,5,0,0,0,,Tingnan kung gaano kaliwanag ang buwan.
Dialogue: 0,1:03:52.44,1:03:55.04,Default,5,0,0,0,,Isang magandang gabi para sa ilang kasiyahan.
Dialogue: 0,1:03:57.58,1:03:58.73,Default,5,0,0,0,,Narito.
Dialogue: 0,1:03:59.01,1:04:00.11,Default,5,0,0,0,,Tara na.
Dialogue: 0,1:04:00.51,1:04:02.48,Default,5,0,0,0,,-Madaling trabaho.\N-Oo.
Dialogue: 0,1:04:04.28,1:04:06.69,Default,5,0,0,0,,Mukhang magkasing edad lang kami,
Dialogue: 0,1:04:06.89,1:04:10.75,Default,5,0,0,0,,at magkapareho ang aming mga libangan. I'm so glad nagkita tayo.
Dialogue: 0,1:04:11.22,1:04:14.79,Default,5,0,0,0,,Oh oo. Hindi mo pa sinasabi sa akin ang pangalan mo.
Dialogue: 0,1:04:14.93,1:04:16.06,Default,5,0,0,0,,Ano ang pangalan mo?
Dialogue: 0,1:04:16.43,1:04:18.06,Default,5,0,0,0,,Ako si Lee Senman.
Dialogue: 0,1:04:22.90,1:04:26.67,Default,5,0,0,0,,Lee Seng-man bilang "Loser sa buhay na ito."
Dialogue: 0,1:04:31.14,1:04:32.27,Default,5,0,0,0,,Huwag mo akong sisihin!
Dialogue: 0,1:04:37.85,1:04:39.48,Default,5,0,0,0,,Ano ang pangalan mo?
Dialogue: 0,1:04:42.09,1:04:43.38,Default,5,0,0,0,,Oo, yun lang.
Dialogue: 0,1:04:49.16,1:04:51.32,Default,5,0,0,0,,Paumanhin.
Dialogue: 0,1:05:00.74,1:05:02.67,Default,5,0,0,0,,Babae ka.
Dialogue: 0,1:05:03.34,1:05:05.58,Default,5,0,0,0,,Ano ang sinasabi mo? Talagang lalaki ako.
Dialogue: 0,1:05:05.58,1:05:09.52,Default,5,0,0,0,,Hindi kami naglilingkod sa mga babae.
Dialogue: 0,1:05:16.09,1:05:20.02,Default,5,0,0,0,,Girls, batiin ang young master!
Dialogue: 0,1:05:40.85,1:05:42.21,Default,5,0,0,0,,Iyon lang!
Dialogue: 0,1:05:48.05,1:05:50.59,Default,5,0,0,0,,Isang malaking karangalan na makilala ka.
Dialogue: 0,1:05:58.63,1:06:00.86,Default,5,0,0,0,,Hayaan mong ibuhos kita...
Dialogue: 0,1:06:06.11,1:06:08.86,Default,5,0,0,0,,Hindi ako umiinom ng higit sa tatlong tasa ng alak sa isang araw.
Dialogue: 0,1:06:09.31,1:06:10.78,Default,5,0,0,0,,Nakainom na ako ng dalawa,
Dialogue: 0,1:06:10.78,1:06:13.67,Default,5,0,0,0,,at gusto kong ibahagi ang huli sa aking kaibigan.
Dialogue: 0,1:06:15.71,1:06:18.17,Default,5,0,0,0,,Hindi niya binabago ang mga desisyon.
Dialogue: 0,1:06:20.35,1:06:24.46,Default,5,0,0,0,,Ang kanyang anak ay nakapasa kamakailan sa opisyal na pagsusulit.
Dialogue: 0,1:06:25.19,1:06:26.42,Default,5,0,0,0,,Binabati kita.
Dialogue: 0,1:06:26.73,1:06:29.39,Default,5,0,0,0,,Bagaman kaya niya,
Dialogue: 0,1:06:29.39,1:06:31.90,Default,5,0,0,0,,hindi siya makakuha ng magandang lugar sa Hanyang.
Dialogue: 0,1:06:32.83,1:06:35.60,Default,5,0,0,0,,Kung matutulungan mo siya, malugod kong babayaran ka,
Dialogue: 0,1:06:35.60,1:06:37.90,Default,5,0,0,0,,basta sabi mo.
Dialogue: 0,1:06:39.84,1:06:41.77,Default,5,0,0,0,,Hinihiling mo sa akin na ibenta
Dialogue: 0,1:06:41.97,1:06:44.94,Default,5,0,0,0,,ang lugar ng isang opisyal ng gobyerno para sa pera?
Dialogue: 0,1:06:45.18,1:06:47.44,Default,5,0,0,0,,Well, ang ibig kong sabihin...
Dialogue: 0,1:06:48.11,1:06:50.75,Default,5,0,0,0,,Gusto ko lang ipahayag ang aking pasasalamat.
Dialogue: 0,1:06:50.75,1:06:54.42,Default,5,0,0,0,,Alam kong nakapasa sa pagsusulit ang anak mo matagal na ang nakalipas.
Dialogue: 0,1:06:55.15,1:06:57.48,Default,5,0,0,0,,-Bakit ka dumating ngayon?\N-Well, I...
Dialogue: 0,1:07:00.73,1:07:03.36,Default,5,0,0,0,,Nakipag-ugnayan ka muna sa pamilyang Pungyang Cho.
Dialogue: 0,1:07:05.63,1:07:10.17,Default,5,0,0,0,,Ang asawa ko ang malayo nilang kamag-anak.
Dialogue: 0,1:07:10.17,1:07:11.90,Default,5,0,0,0,,Patawarin mo ako.
Dialogue: 0,1:07:23.48,1:07:25.85,Default,5,0,0,0,,Naiintindihan ko ang iyong nararamdaman
Dialogue: 0,1:07:25.85,1:07:28.22,Default,5,0,0,0,,tungkol sa iyong matalino at may kakayahang anak na hindi marunong
Dialogue: 0,1:07:28.22,1:07:30.49,Default,5,0,0,0,,makamit ang gusto mo dahil sa mga pagkakamali ng pamilya.
Dialogue: 0,1:07:31.52,1:07:35.45,Default,5,0,0,0,,Tutulungan ko siyang linisin ang kanyang pangalan at maging sekretarya ng hari.
Dialogue: 0,1:07:36.26,1:07:37.49,Default,5,0,0,0,,Royal Secretary?
Dialogue: 0,1:07:38.03,1:07:41.20,Default,5,0,0,0,,Salamat. maraming salamat po!
Dialogue: 0,1:07:41.43,1:07:42.79,Default,5,0,0,0,,At hindi mo ako kailangang bayaran.
Dialogue: 0,1:07:43.54,1:07:46.70,Default,5,0,0,0,,Kailangan ko ng kaibigan bilang kapalit.
Dialogue: 0,1:07:48.24,1:07:50.17,Default,5,0,0,0,,Ang handang ibigay ang buhay niya para sa akin.
Dialogue: 0,1:07:52.18,1:07:55.85,Default,5,0,0,0,,Mula ngayon, ang aking buong pamilya ay magiging
Dialogue: 0,1:07:55.85,1:07:57.78,Default,5,0,0,0,,Ikinagagalak kong paglingkuran ka, ginoo.
Dialogue: 0,1:08:02.96,1:08:04.69,Default,5,0,0,0,,Ibuhos mo ako ng alak.
Dialogue: 0,1:08:05.02,1:08:06.89,Default,5,0,0,0,,Magkaibigan na tayo.
Dialogue: 0,1:08:06.89,1:08:09.95,Default,5,0,0,0,,Oo! salamat po.
Dialogue: 0,1:08:19.50,1:08:22.41,Default,5,0,0,0,,Tara na!
Dialogue: 0,1:08:23.94,1:08:26.54,Default,5,0,0,0,,Iinom tayo hanggang sa matumba.
Dialogue: 0,1:08:26.55,1:08:29.31,Default,5,0,0,0,,Iwanan natin ang ating mga alalahanin at magsaya!
Dialogue: 0,1:08:31.92,1:08:33.21,Default,5,0,0,0,,Ladies' man!
Dialogue: 0,1:08:33.42,1:08:35.45,Default,5,0,0,0,,At huwag mo akong kalimutan!
Dialogue: 0,1:08:35.65,1:08:38.16,Default,5,0,0,0,,-Ang ganda!\N-Tingnan mo dito!
Dialogue: 0,1:08:38.16,1:08:39.95,Default,5,0,0,0,,Eto, uminom ka.
Dialogue: 0,1:08:40.39,1:08:42.19,Default,5,0,0,0,,-Isa pang usapin.\N-Okay.
Dialogue: 0,1:08:42.19,1:08:44.20,Default,6,0,0,0,,Mr!
Dialogue: 0,1:08:45.73,1:08:47.62,Default,6,0,0,0,,Ang gwapo mo!
Dialogue: 0,1:08:48.83,1:08:54.31,Default,6,0,0,0,,At sino sa inyo ang magkakaroon ng karangalan
Dialogue: 0,1:08:54.31,1:08:56.67,Default,6,0,0,0,,hubaran mo ba ako sa gabi?
Dialogue: 0,1:09:04.32,1:09:06.08,Default,6,0,0,0,,I've been a kitty for 20 years,
Dialogue: 0,1:09:06.59,1:09:09.99,Default,6,0,0,0,,at hindi pa ako nakakakilala ng ganyang pervert.
Dialogue: 0,1:09:11.19,1:09:14.92,Default,6,0,0,0,,-Eto, uminom ka.\N-Halika, kahit ano.
Dialogue: 0,1:09:32.14,1:09:34.15,Default,6,0,0,0,,Grabe ito.
Dialogue: 0,1:09:36.38,1:09:40.21,Default,6,0,0,0,,Hindi ako makapaniwala na sa ganoong lugar\N kami ay umiinom ng mag-isa.
Dialogue: 0,1:09:41.25,1:09:43.75,Default,6,0,0,0,,Hindi ito ang oras para magreklamo tungkol dito.
Dialogue: 0,1:09:43.79,1:09:46.75,Default,6,0,0,0,,Akala namin nasa secret vault siya, pero wala itong laman.
Dialogue: 0,1:09:46.99,1:09:49.13,Default,6,0,0,0,,Pagkatapos ay may isang opsyon na lang ang natitira.
Dialogue: 0,1:09:49.13,1:09:50.36,Default,6,0,0,0,,Sa bahay ng ama ng reyna.
Dialogue: 0,1:09:50.36,1:09:54.37,Default,6,0,0,0,,Ngunit gusto nilang italaga siyang kumander ng royal guard,
Dialogue: 0,1:09:54.47,1:09:56.20,Default,6,0,0,0,,na nangangahulugang magiging mas mahirap itong lampasan.
Dialogue: 0,1:09:56.37,1:09:58.09,Default,6,0,0,0,,Gusto nilang kontrolin ang royal guard,
Dialogue: 0,1:09:58.44,1:10:00.94,Default,6,0,0,0,,upang ang buhay ng hari ay nasa kanilang mga kamay.
Dialogue: 0,1:10:00.94,1:10:04.61,Default,6,0,0,0,,Pagkatapos ay malapit nang mabunyag ang mga nagbabalatkayo na guwardiya.
Dialogue: 0,1:10:04.61,1:10:07.87,Default,6,0,0,0,,Oo? Ito ay isang napakadelikadong sitwasyon.
Dialogue: 0,1:10:08.31,1:10:11.18,Default,6,0,0,0,,Kung sila ay nahuli at na-disband, kung gayon
Dialogue: 0,1:10:11.18,1:10:13.55,Default,6,0,0,0,,habol \N mga tiwaling opisyal sa gabi
Dialogue: 0,1:10:13.55,1:10:15.79,Default,6,0,0,0,,at umakyat sa storage\N sa paghahanap ng mga accounting book
Dialogue: 0,1:10:15.79,1:10:17.86,Default,6,0,0,0,,kailangan mo at ako.
Dialogue: 0,1:10:17.86,1:10:19.22,Default,6,0,0,0,,Ibig sabihin, sa araw na ako ay magiging opisyal,
Dialogue: 0,1:10:19.22,1:10:20.29,Default,6,0,0,0,,at sa gabi bilang isang mersenaryo?
Dialogue: 0,1:10:20.29,1:10:23.08,Default,6,0,0,0,,Oo, nababaliw na ako sa sobrang pagod.
Dialogue: 0,1:10:26.37,1:10:29.96,Default,6,0,0,0,,Tinawagan mo ako mula Ganghwado para mag-araro na parang kabayo?
Dialogue: 0,1:10:33.14,1:10:34.84,Default,6,0,0,0,,Papuntang Hanyang
Dialogue: 0,1:10:34.84,1:10:38.48,Default,6,0,0,0,,Puno ako ng mga ambisyon at magagandang pangarap.
Dialogue: 0,1:10:39.61,1:10:42.95,Default,6,0,0,0,,"Gagamit ako ng kaibigan at magtatagumpay."
Dialogue: 0,1:10:45.18,1:10:48.35,Default,6,0,0,0,,Sinabi ko na gusto kong iligtas ang ating nabubulok, tiwaling bansa,
Dialogue: 0,1:10:48.35,1:10:50.56,Default,6,0,0,0,,at nagpasya kang sumunod.
Dialogue: 0,1:10:51.76,1:10:53.96,Default,6,0,0,0,,Hindi mo sinabi.
Dialogue: 0,1:10:53.96,1:10:56.83,Default,6,0,0,0,,Palagi silang nag-uusap tungkol sa Khanyan, kaya nagtanong ako.
Dialogue: 0,1:10:57.06,1:10:59.20,Default,6,0,0,0,,At ito ang iyong sinagot:
Dialogue: 0,1:11:03.44,1:11:05.29,Default,6,0,0,0,,Bakit sa Hanyang?
Dialogue: 0,1:11:09.17,1:11:13.50,Default,6,0,0,0,,Nabubulok na si Joseon. Gusto kong turuan ng leksyon ang mga bastos na ito!
Dialogue: 0,1:11:20.09,1:11:21.32,Default,6,0,0,0,,Tama.
Dialogue: 0,1:11:22.82,1:11:25.09,Default,6,0,0,0,,Maganda ang tunog,
Dialogue: 0,1:11:25.09,1:11:27.06,Default,6,0,0,0,,pero hindi ko alam na kailangan kong yumuko ng ganyan.
Dialogue: 0,1:11:27.06,1:11:30.90,Default,6,0,0,0,,Ako ay isang tulala.
Dialogue: 0,1:11:32.73,1:11:34.79,Default,6,0,0,0,,Sa tingin mo ba malaki na ang pinagbago mo?
Dialogue: 0,1:11:40.57,1:11:43.48,Default,6,0,0,0,,Baka gusto nilang kontrolin ang mga guard,
Dialogue: 0,1:11:43.48,1:11:45.24,Default,6,0,0,0,,dahil naintindihan nila kung ano ang gagawin namin?
Dialogue: 0,1:11:45.34,1:11:46.45,Default,6,0,0,0,,Halika.
Dialogue: 0,1:11:46.45,1:11:48.35,Default,6,0,0,0,,Kung ganoon, may pinadala sila dito
Dialogue: 0,1:11:48.35,1:11:49.95,Default,6,0,0,0,,makinig sa amin.
Dialogue: 0,1:11:50.45,1:11:51.65,Default,6,0,0,0,,Eksakto.
Dialogue: 0,1:11:59.79,1:12:01.53,Default,6,0,0,0,,Sipa-ass inconvenient.
Dialogue: 0,1:12:10.34,1:12:12.70,Default,6,0,0,0,,Nasaan ang palikuran?
Dialogue: 0,1:12:17.18,1:12:18.81,Default,6,0,0,0,,At narito na.
Dialogue: 0,1:12:24.82,1:12:28.15,Default,6,0,0,0,,(Palikuran ng mga babae, banyo ng mga lalaki)
Dialogue: 0,1:12:36.66,1:12:37.79,Default,6,0,0,0,,Huh?
Dialogue: 0,1:12:51.18,1:12:52.63,Default,6,0,0,0,,Hey.
Dialogue: 0,1:12:54.85,1:12:56.00,Default,6,0,0,0,,Nainggit ako sa iyo.
Dialogue: 0,1:12:56.92,1:12:58.98,Default,6,0,0,0,,Meron din ako.
Dialogue: 0,1:12:59.72,1:13:03.21,Default,6,0,0,0,,At ngayon ay wala na.
Dialogue: 0,1:13:05.29,1:13:07.75,Default,6,0,0,0,,Paalam, aking dragon.
Dialogue: 0,1:13:08.23,1:13:10.75,Default,6,0,0,0,,Bye-bye, dragon.
Dialogue: 0,1:13:14.53,1:13:16.63,Default,6,0,0,0,,Ni hindi ko mapakali ang sarili ko habang nakatayo.
Dialogue: 0,1:13:18.37,1:13:21.47,Default,6,0,0,0,,Pig world, ang ganitong kasiyahan ay makukuha lamang sa mga mayroon nito.
Dialogue: 0,1:13:22.54,1:13:25.81,Default,6,0,0,0,,Nakakalungkot, ayoko talagang magsulat.
Dialogue: 0,1:13:26.14,1:13:27.84,Default,6,0,0,0,,Pati ang mga luha ay natuyo na.
Dialogue: 0,1:13:42.93,1:13:45.09,Default,6,0,0,0,,At wala na ang dragon.
Dialogue: 0,1:13:45.70,1:13:47.53,Default,6,0,0,0,,At mga dragon ball din.
Dialogue: 0,1:13:48.93,1:13:51.09,Default,6,0,0,0,,Mas madaling mamatay na.
Dialogue: 0,1:13:52.10,1:13:54.94,Default,6,0,0,0,,Kabangisan. Bakit ito nangyayari sa akin? Para saan?
Dialogue: 0,1:13:57.11,1:13:58.67,Default,6,0,0,0,,-Magbuhos ng baso.\N-Dito.
Dialogue: 0,1:14:02.81,1:14:04.28,Default,6,0,0,0,,Gaano kagaling.
Dialogue: 0,1:14:10.19,1:14:11.36,Default,6,0,0,0,,Huh?
Dialogue: 0,1:14:12.59,1:14:14.26,Default,6,0,0,0,,Sa tingin mo ba napagtanto nila ang dugong iyon
Dialogue: 0,1:14:14.26,1:14:16.90,Default,6,0,0,0,,may baboy ba talaga sa marriage bed?
Dialogue: 0,1:14:17.03,1:14:19.63,Default,6,0,0,0,,Dahil gusto nilang ibigay ang posisyong ito sa ama ng reyna,
Dialogue: 0,1:14:19.63,1:14:22.92,Default,6,0,0,0,,na nangangahulugang wala silang ideya tungkol sa atin.
Dialogue: 0,1:14:23.17,1:14:24.53,Default,6,0,0,0,,Iba pa
Dialogue: 0,1:14:25.57,1:14:28.13,Default,6,0,0,0,, ang iyong mga ulo ay nakahandusay na sa lupa.
Dialogue: 0,1:14:31.14,1:14:32.74,Default,6,0,0,0,,Kung gayon bakit biglang...
Dialogue: 0,1:14:32.74,1:14:34.61,Default,6,0,0,0,,Ang nagbago lang ay ang reyna
Dialogue: 0,1:14:34.61,1:14:36.37,Default,6,0,0,0,,at ang maharlikang babae na magkasama sa palasyo.
Dialogue: 0,1:14:37.62,1:14:40.12,Default,6,0,0,0,,Gusto ng Reyna na panatilihin siyang kontrolado.
Dialogue: 0,1:14:41.95,1:14:45.75,Default,6,0,0,0,,Naglalagay ng espada sa leeg ng asawa kaagad pagkatapos ng kasal?
Dialogue: 0,1:14:46.79,1:14:48.69,Default,6,0,0,0,,Kakatakot na babae.
Dialogue: 0,1:14:49.36,1:14:50.90,Default,6,0,0,0,,Dahil sa nangyari,
Dialogue: 0,1:14:50.90,1:14:52.83,Default,6,0,0,0,,kailangan mong huminto sa paghahanap sandali.
Dialogue: 0,1:14:53.16,1:14:54.57,Default,6,0,0,0,,Naghahanda na kami
Dialogue: 0,1:14:54.57,1:14:56.77,Default,6,0,0,0,,sa isang matuwid na digmaan laban sa mga awtoridad.
Dialogue: 0,1:14:56.87,1:15:00.07,Default,6,0,0,0,,Ang tanging paraan para parusahan sila ay
Dialogue: 0,1:15:00.21,1:15:04.17,Default,6,0,0,0,,hanapin ang mga papeles na nagpapatunay ng katiwalian.
Dialogue: 0,1:15:05.68,1:15:08.41,Default,6,0,0,0,,Gumagamit sila ng double entry system, hindi natin kaya
Dialogue: 0,1:15:09.01,1:15:10.37,Default,6,0,0,0,,ipagpaliban ang paghahanap ng libro.
Dialogue: 0,1:15:10.58,1:15:12.48,Default,6,0,0,0,,Ano ang dapat nating gawin?
Dialogue: 0,1:15:12.72,1:15:15.58,Default,6,0,0,0,,Hayaan siyang kunin ang posisyon ng commander ng royal guard.
Dialogue: 0,1:15:16.62,1:15:18.09,Default,6,0,0,0,,-Pero!\N-Kung ihahagis natin ang pain,
Dialogue: 0,1:15:18.09,1:15:19.42,Default,6,0,0,0,,sasalakayin nila siya
Dialogue: 0,1:15:19.42,1:15:21.56,Default,6,0,0,0,,at hindi nila mapapansin kung ano talaga ang nangyayari.
Dialogue: 0,1:15:21.66,1:15:23.70,Default,6,0,0,0,,Siya ay sisipsipin ng bagong posisyon,
Dialogue: 0,1:15:24.00,1:15:26.87,Default,6,0,0,0,,tutulungan ka nitong mahanap ang mga accounting book.
Dialogue: 0,1:15:27.73,1:15:30.64,Default,6,0,0,0,,Kung tungkol sa posisyon, kaya nating kunin,
Dialogue: 0,1:15:30.64,1:15:32.16,Default,6,0,0,0,,kapag sa tingin niya ay kanya siya.
Dialogue: 0,1:15:32.20,1:15:34.11,Default,6,0,0,0,,Mahirap ipagtanggol ang ating mga posisyon,
Dialogue: 0,1:15:34.37,1:15:35.81,Default,6,0,0,0,,pero mas magiging mahirap ang pagbabalik sa kanila.
Dialogue: 0,1:15:35.91,1:15:38.17,Default,6,0,0,0,,Ang tunay na mandirigma lang ang mamumuno sa bantay.
Dialogue: 0,1:15:38.41,1:15:40.38,Default,6,0,0,0,,Naiintindihan ko na magiging simpleng puppet siya,
Dialogue: 0,1:15:40.38,1:15:41.71,Default,6,0,0,0,,ngunit hindi ito gagana,
Dialogue: 0,1:15:41.71,1:15:43.37,Default,6,0,0,0,,maliban kung pisikal na kayang gawin ang trabaho.
Dialogue: 0,1:15:45.18,1:15:48.92,Default,6,0,0,0,,Ayusin natin ang isang maliit na insidente sa kanyang unang araw.
Dialogue: 0,1:15:48.99,1:15:52.38,Default,6,0,0,0,,At kung mas matalino si Kim Moon-geun kaysa sa inaakala natin,
Dialogue: 0,1:15:53.32,1:15:55.33,Default,6,0,0,0,,at mauunawaan kung sino talaga ang mga bantay?
Dialogue: 0,1:15:56.49,1:15:58.62,Default,6,0,0,0,,Siguraduhin nating protektado ang royal guard,
Dialogue: 0,1:15:59.20,1:16:01.03,Default,6,0,0,0,,at kunin ang mga aklat.
Dialogue: 0,1:16:01.03,1:16:02.99,Default,6,0,0,0,,Pumunta tayo sa matinding hakbang.
Dialogue: 0,1:16:03.33,1:16:05.37,Default,6,0,0,0,,Kung alam mo na kung paano, bakit hindi pa ngayon?
Dialogue: 0,1:16:05.67,1:16:07.44,Default,6,0,0,0,,Anong uri ng "huling paraan"?
Dialogue: 0,1:16:11.04,1:16:12.20,Default,6,0,0,0,,Pagtatangka.
Dialogue: 0,1:16:17.68,1:16:19.71,Default,6,0,0,0,, Mangyayari pa rin ito.
Dialogue: 0,1:16:37.60,1:16:39.70,Default,6,0,0,0,,Anong mapurol na maliit na silid?
Dialogue: 0,1:17:00.02,1:17:01.23,Default,6,0,0,0,,Oh, ikaw!
Dialogue: 0,1:17:01.79,1:17:03.19,Default,6,0,0,0,,Nagri-ring ang bell!
Dialogue: 0,1:17:13.67,1:17:15.11,Default,6,0,0,0,,Iyan ang reyna?
Dialogue: 0,1:17:15.11,1:17:17.28,Default,6,0,0,0,,Pinapanood niya kaming nakasuot ng panlalaki?
Dialogue: 0,1:17:17.28,1:17:18.78,Default,6,0,0,0,,Hindi namin siya hahayaang makatakas.
Dialogue: 0,1:17:18.94,1:17:21.85,Default,6,0,0,0,,Hindi namin alam kung ano ang narinig niya.
Dialogue: 0,1:17:21.85,1:17:23.50,Default,6,0,0,0,,Sigurado akong ibang tao ang kasama niya.
Dialogue: 0,1:17:23.58,1:17:26.37,Default,6,0,0,0,,Kaya, kailangan mong abutin siya at isara ang iyong bibig.
Dialogue: 0,1:17:33.79,1:17:34.92,Default,6,0,0,0,,Kamahalan.
Dialogue: 0,1:17:43.94,1:17:46.44,Default,6,0,0,0,,Huwag hayaang madamay ang iyong emosyon.
Dialogue: 0,1:17:49.51,1:17:51.20,Default,6,0,0,0,,Ako mismo ang mag-iisip nito.
Dialogue: 0,1:18:33.12,1:18:34.24,Default,6,0,0,0,,10.
Dialogue: 0,1:18:37.56,1:18:39.12,Default,6,0,0,0,,11.
Dialogue: 0,1:18:40.76,1:18:43.19,Default,6,0,0,0,,Damn, mahuhuli ako kapag hindi ako nakabalik sa oras.
Dialogue: 0,1:20:20.99,1:20:23.70,Default,6,0,0,0,,Kamahalan, huwag kang magtiwala sa sinuman.
Dialogue: 0,1:20:23.70,1:20:25.62,Default,6,0,0,0,,Mag-ingat lalo na sa mga malalapit.
Dialogue: 0,1:20:27.33,1:20:29.70,Default,6,0,0,0,,Alam mo kung sino ang gumawa nito.
Dialogue: 0,1:20:29.70,1:20:30.84,Default,6,0,0,0,,Ang kriminal ay...
Dialogue: 0,1:20:30.84,1:20:32.70,Default,6,0,0,0,,Kung narinig ng reyna ang lahat,
Dialogue: 0,1:20:32.70,1:20:35.20,Default,6,0,0,0,,hindi maiiwasan ang pagdanak ng dugo.
Dialogue: 0,1:20:35.34,1:20:36.34,Default,6,0,0,0,,Sino ka?
Dialogue: 0,1:20:36.34,1:20:38.81,Default,6,0,0,0,,How dare na pumunta dito ang babae?
Dialogue: 0,1:20:38.81,1:20:40.51,Default,6,0,0,0,,Kapag nandito ako,
Dialogue: 0,1:20:40.51,1:20:41.98,Default,6,0,0,0,,Ako ang boss.
Dialogue: 0,1:20:41.98,1:20:43.84,Default,6,0,0,0,,Ganyan ba ang hawak mo?
Dialogue: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


