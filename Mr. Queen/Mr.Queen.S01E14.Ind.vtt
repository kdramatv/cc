Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berhasil,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Host, Nanas, To
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.22,0:01:06.28,Default,Lily1,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.28,0:01:08.51,Default,Lilia1,0,0,0,,dan kejadian yang ditampilkan adalah fiksi.
Dialog: 0,0:01:14.05,0:01:16.85,Default,Lily1,0,0,0,,Aku berhutang banyak padamu.
Dialog: 0,0:01:19.92,0:01:21.93,Default,Lily1,0,0,0,,Aku sedang memikirkanmu,
Dialog: 0,0:01:23.73,0:01:25.60,Default,Lilia1,0,0,0,,ketika dia mencoba meninggalkan istana.
Dialog: 0,0:01:28.97,0:01:31.00,Default,Lilia1,0,0,0,,Kupikir aku tidak akan pernah melihatmu lagi.
Dialog: 0,0:01:58.33,0:02:00.60,Default,Lily1,0,0,0,,Satu jam sebelumnya
Dialog: 0,0:02:06.34,0:02:08.64,Default,Lily1,0,0,0,,Kentang Spiral
Dialog: 0,0:02:10.57,0:02:15.41,Default,Lily1,0,0,0,,Apakah kamu sedang tidur?
Dialog: 0,0:02:25.09,0:02:28.36,Default,Lily1,0,0,0,,Ya. Saya menulis ini.
Dialogue: 0,0:02:30.13,0:02:32.40,Default,Lilia1,0,0,0,,Apakah kamu benar-benar menulis ini?
Dialogue: 0,0:02:32.73,0:02:34.00,Default,Lily1,0,0,0,,Bukan ratu?
Dialog: 0,0:02:34.16,0:02:37.63,Default,Lily1,0,0,0,,Sang Ratu ada di pesta.
Dialog: 0,0:02:38.07,0:02:40.10,Default,Lily1,0,0,0,,Lalu kenapa kamu mengajukan
Dialog: 0,0:02:40.10,0:02:42.91,Default,Lily1,0,0,0,,anggur liar, jarum pinus, dan buah persik?
Dialog: 0,0:02:43.34,0:02:47.14,Default,Lily1,0,0,0,,Ini hanya musim persik,
Dialog: 0,0:02:47.14,0:02:49.25,Default,Lily1,0,0,0,,musim anggur liar dimulai,
Dialog: 0,0:02:49.25,0:02:51.35,Default,Lily1,0,0,0,,dan ada jarum pinus sepanjang tahun.
Dialog: 0,0:02:51.75,0:02:52.82,Default,Lily1,0,0,0,,Manbok.
Dialogue: 0,0:02:53.98,0:02:55.69,Default,Lily1,0,0,0,,Tatap mataku dan beritahu aku.
Dialogue: 0,0:03:10.00,0:03:14.34,Default,Lily1,0,0,0,,Sang Ratu tidak ingin kamu tahu bahwa dia membantumu.
Dialog: 0,0:03:20.24,0:03:22.91,Default,Lily1,0,0,0,,Sudah terlambat. Kembalilah ke sini besok.
Dialog: 0,0:03:25.78,0:03:27.25,Default,Lily1,0,0,0,,Kembali ke dirimu sendiri.
Dialog: 0,0:03:27.95,0:03:30.85,Default,Lily1,0,0,0,,Aku akan mencari tahu kenapa dia membantuku
Dialog: 0,0:03:31.79,0:03:33.59,Default,Lilia1,0,0,0,,dan apa arti kata-katanya sehingga dia akan mengkhianatiku.
Dialog: 0,0:03:42.40,0:03:44.67,Default,Lily1,0,0,0,,Ratu
Dialog: 0,0:04:06.86,0:04:09.09,Default,Lily1,0,0,0,,Ratu dalam bahaya.
Dialog: 0,0:04:17.57,0:04:20.20,Default,Lily1,0,0,0,,Saat fajar menyingsing, aku akan memberi tahu raja.
Dialog: 0,0:04:20.50,0:04:21.67,Default,Lily1,0,0,0,,Apakah dia akan baik-baik saja?
Dialogue: 0,0:04:21.81,0:04:24.41,Default,Lily1,0,0,0,,Luangkan waktumu. Ini bisa menjadi jebakan.
Dialogue: 0,0:04:41.16,0:04:44.29,Default,Lily1,0,0,0,,Terkadang kamu tidur seperti bayi.
Dialog: 0,0:04:46.93,0:04:49.13,Default,Lily1,0,0,0,,Sepertinya aku tertidur.
Dialogue: 0,0:04:53.64,0:04:56.27,Default,Lily1,0,0,0,,Apakah kamu menjagaku?
Dialog: 0,0:04:59.01,0:05:01.24,Default,Lily1,0,0,0,,Kenapa kamu selalu melakukan ini?
Dialog: 0,0:05:02.78,0:05:06.42,Default,Lily1,0,0,0,,Mengkhawatirkanku, mencoba memahamiku.
Dialogue: 0,0:05:07.85,0:05:12.69,Default,Lily1,0,0,0,,Kalau dipikir-pikir, kamu adalah orang pertama yang kulihat saat aku datang ke sini.
Dialog: 0,0:05:18.40,0:05:21.06,Default,Lily1,0,0,0,,Aku berhutang banyak padamu.
Dialog: 0,0:05:24.33,0:05:26.24,Default,Lily1,0,0,0,,Aku sedang memikirkanmu,
Dialog: 0,0:05:28.04,0:05:29.87,Default,Lily1,0,0,0,,ketika dia mencoba meninggalkan istana.
Dialog: 0,0:05:30.94,0:05:32.94,Default,Lily1,0,0,0,,Kupikir aku tidak akan pernah melihatmu lagi.
Dialog: 0,0:06:42.05,0:06:44.21,Default,Lily1,0,0,0,,Hon Young.
Dialog: 0,0:06:47.68,0:06:50.12,Default,Lily1,0,0,0,,Sepertinya kamu banyak berlatih.
Dialogue: 0,0:06:50.55,0:06:52.09,Default,Lily1,0,0,0,,Sangat bersemangat.
Dialog: 0,0:07:06.97,0:07:08.14,Default,Lily1,0,0,0,,Ini adalah mimpi.
Dialog: 0,0:07:08.31,0:07:09.71,Default,Lily1,0,0,0,,Hong Young berubah menjadi dia
Dialog: 0,0:07:09.71,0:07:11.31,Default,Lily1,0,0,0,,terakhir kali dalam mimpiku.
Dialog: 0,0:07:13.41,0:07:14.78,Default,Lily1,0,0,0,,Apakah kamu sudah bangun?
Dialog: 0,0:07:27.46,0:07:29.39,Default,Lily1,0,0,0,,Apa itu? Apa yang sedang kamu lakukan?
Dialog: 0,0:07:29.39,0:07:33.73,Default,Lily1,0,0,0,,Apa yang terjadi? Siapa yang menyinggung ratuku?
Dialog: 0,0:07:34.56,0:07:36.73,Default,Lily1,0,0,0,,Kamu. Anda menyinggung saya.
Dialogue: 0,0:07:39.37,0:07:41.30,Default,Lily1,0,0,0,,Kenapa wajahnya diganti dengan wajahmu?
Dialog: 0,0:07:41.84,0:07:42.84,Default,Lily1,0,0,0,,Apa?
Dialogue: 0,0:07:44.01,0:07:45.11,Default,Lily1,0,0,0,,Jujur saja padaku.
Dialog: 0,0:07:45.38,0:07:47.48,Default,Lily1,0,0,0,,Apa yang terjadi di antara kita di malam hari?
Dialogue: 0,0:07:47.84,0:07:49.71,Default,Lily1,0,0,0,,Sejujur ​​apa aku harusnya?
Dialogue: 0,0:07:49.71,0:07:52.12,Default,Lily1,0,0,0,,Ceritakan semuanya, jangan sampai ada yang keluar.
Dialog: 0,0:07:55.45,0:07:58.15,Default,Lily1,0,0,0,,Tuhan. Ini permintaan yang aneh.
Dialog: 0,0:08:00.06,0:08:01.42,Default,Lily1,0,0,0,,Jika itu yang kamu inginkan...
Dialog: 0,0:08:04.53,0:08:07.66,Default,Lily1,0,0,0,,Saat bulan menyinari langit gelap tadi malam,
Dialog: 0,0:08:07.66,0:08:10.83,Default,Lily1,0,0,0,,tangan kami sedikit bersentuhan, lalu kembang api...
Dialog: 0,0:08:10.83,0:08:13.60,Default,Lily1,0,0,0,,Diam. Jika kamu mengatakan sesuatu, aku akan membunuhmu.
Dialog: 0,0:08:13.60,0:08:14.67,Default,Lily1,0,0,0,,Tapi...
Dialog: 0,0:08:15.67,0:08:17.67,Default,Lily1,0,0,0,,Ini baru permulaan, ratuku.
Dialogue: 0,0:08:19.34,0:08:20.48,Default,Lily1,0,0,0,,Ratuku.
Dialog: 0,0:08:21.28,0:08:22.48,Default,Lily1,0,0,0,,Tuhan.
Dialog: 0,0:08:26.88,0:08:27.98,Default,Lily1,0,0,0,,Perasaan,
Dialog: 0,0:08:28.95,0:08:31.92,Default,Lily1,0,0,0,,seolah-olah aku ditinggalkan.
Dialog: 0,0:08:32.39,0:08:33.86,Default,Lily1,0,0,0,,Ya Tuhan.
Dialog: 0,0:08:35.26,0:08:36.29,Default,Lily1,0,0,0,,Kepala Kasim.
Dialog: 0,0:08:36.29,0:08:38.70,Default,Lily1,0,0,0,,Hon Young. Hong Muda.
Dialog: 0,0:08:39.60,0:08:40.86,Default,Lily1,0,0,0,,Di mana kamu tidur hari ini?
Dialog: 0,0:08:41.36,0:08:42.83,Default,Lily1,0,0,0,,Di rumah, Yang Mulia.
Dialog: 0,0:08:44.90,0:08:47.07,Default,Lily1,0,0,0,,Cheoljong dan aku benar-benar...
Dialog: 0,0:09:12.33,0:09:15.37,Default,Lily1,0,0,0,,14 episode. Wanita yang harus mati untuk hidup
Dialog: 0,0:09:24.21,0:09:26.04,Default,Lily1,0,0,0,,Itu semua hanya mimpi.
Dialog: 0,0:09:27.38,0:09:29.58,Default,Lily1,0,0,0,,Potret mendiang raja terbakar,
Dialog: 0,0:09:29.81,0:09:31.88,Default,Lily1,0,0,0,,dan semuanya tampak begitu nyata.
Dialog: 0,0:09:33.05,0:09:34.98,Default,Lily1,0,0,0,,Setelah apa yang terjadi dengan peramal,
Dialog: 0,0:09:34.98,0:09:36.92,Default,Lily1,0,0,0,,Saya tidak bisa memprediksi nasib saya.
Dialog: 0,0:09:40.86,0:09:42.03,Default,Lily1,0,0,0,,Firasat buruk.
Dialog: 0,0:09:42.63,0:09:45.56,Default,Lily1,0,0,0,,Nyonya Khan. Saya perlu memprediksi nasib.
Dialog: 0,0:09:46.46,0:09:49.07,Default,Lily1,0,0,0,,Yang Mulia. Ini akan membuatmu kesulitan lagi.
Dialog: 0,0:09:49.43,0:09:51.20,Default,Lily1,0,0,0,,Saya kenal seorang biksu.
Dialog: 0,0:09:52.60,0:09:55.34,Default,Lily1,0,0,0,,Tidak akan terlihat mencurigakan.
Dialog: 0,0:10:00.18,0:10:04.95,Default,Lily1,0,0,0,,Saat Avalokitesvara berlatih Prajnaparamita mendalam,
Dialog: 0,0:10:04.95,0:10:08.05,Default,Lily1,0,0,0,,dia menerangi lima skandha dan melihat semuanya kosong...
Dialog: 0,0:10:12.22,0:10:13.32,Default,Lily1,0,0,0,,Apa yang kamu lihat?
Dialog: 0,0:10:13.32,0:10:16.79,Default,Lily1,0,0,0,,Saya melihat istana dipenuhi darah merah.
Dialog: 0,0:10:17.49,0:10:18.83,Default,Lily1,0,0,0,,Darah merah?
Dialog: 0,0:10:20.23,0:10:21.73,Default,Lily1,0,0,0,,Hari ini seseorang
Dialog: 0,0:10:22.53,0:10:24.17,Default,Lily1,0,0,0,,akan mati di istana.
Dialog: 0,0:10:26.50,0:10:27.97,Default,Lily1,0,0,0,,Dan siapa?
Dialog: 0,0:10:28.44,0:10:30.61,Default,Lily1,0,0,0,,Saya tidak tahu siapa itu,
Dialog: 0,0:10:38.48,0:10:39.75,Default,Lily1,0,0,0,,tapi itu akan menjadi seorang wanita.
Dialog: 0,0:10:40.25,0:10:41.35,Default,Lily1,0,0,0,,Wanita?
Dialog: 0,0:10:43.55,0:10:45.16,Default,Lily1,0,0,0,,Benarkah
Dialog: 0,0:10:46.26,0:10:47.76,Default,Lily1,0,0,0,,apakah itu aku?
Dialog: 0,0:10:47.92,0:10:51.09,Default,Lily1,0,0,0,,Gambarkan aku jimat untuk perlindungan.
Dialog: 0,0:10:51.09,0:10:53.80,Default,Lily1,0,0,0,,Saya bukan dukun.
Dialog: 0,0:10:54.13,0:10:56.20,Default,Lily1,0,0,0,,Pasti ada jalan.
Dialog: 0,0:10:56.87,0:10:58.23,Default,Lily1,0,0,0,,Jika Anda bersikeras,
Dialog: 0,0:10:59.00,0:11:01.30,Default,Lily1,0,0,0,,memberikan persembahan kepada Buddha.
Dialog: 0,0:11:02.44,0:11:05.14,Default,Lily1,0,0,0,,Tepat. Aku akan memberimu sebanyak yang kamu mau.
Dialog: 0,0:11:07.08,0:11:09.78,Default,Lily1,0,0,0,,Orang yang mati di istana,
Dialog: 0,0:11:10.11,0:11:12.45,Default,Lily1,0,0,0,,itu bukan aku.
Dialog: 0,0:11:15.72,0:11:16.79,Default,Lily1,0,0,0,,Sial!
Dialog: 0,0:11:18.45,0:11:21.06,Default,Lily1,0,0,0,,Saya tidak menanyakan pertanyaan yang saya inginkan kepada ratu.
Dialog: 0,0:11:22.09,0:11:23.09,Default,Lily1,0,0,0,,Tuhan.
Dialog: 0,0:11:23.39,0:11:25.03,Default,Lily1,0,0,0,,Saya akan kembali ke Daejeon.
Dialog: 0,0:11:25.53,0:11:26.56,Default,Lily1,0,0,0,,Yang Mulia.
Dialog: 0,0:11:30.13,0:11:31.67,Default,Lily1,0,0,0,,Mencurigakan.
Dialog: 0,0:11:32.94,0:11:35.14,Default,Lily1,0,0,0,,Mengingat betapa tiba-tiba dia menghilang.
Dialog: 0,0:11:41.04,0:11:42.18,Default,Lily1,0,0,0,,Benar.
Dialog: 0,0:11:42.51,0:11:44.75,Default,Lily1,0,0,0,,Saya bisa menggambarnya sendiri.
Dialog: 0,0:11:53.39,0:11:54.62,Default,Lily1,0,0,0,,Yang ini cukup.
Dialog: 0,0:12:00.50,0:12:02.27,Default,Lily1,0,0,0,,Benar. Seperti ini.
Dialog: 0,0:12:03.13,0:12:05.67,Default,Lily1,0,0,0,,Saya melihat dengan jelas. Seperti ini.
Dialog: 0,0:12:07.84,0:12:09.64,Default,Lily1,0,0,0,,Tidak! Salah!
Dialog: 0,0:12:12.01,0:12:13.34,Default,Lily1,0,0,0,,Wajahnya...
Dialog: 0,0:12:17.38,0:12:18.88,Default,Lily1,0,0,0,,Ini wajahnya.
Dialog: 0,0:12:21.75,0:12:23.42,Default,Lily1,0,0,0,,Hon!
Dialogue: 0,0:12:29.73,0:12:31.79,Default,Lily1,0,0,0,,Apakah kamu menangis sepanjang waktu?
Dialog: 0,0:12:34.33,0:12:37.07,Default,Lily1,0,0,0,,Baiklah. Dengan baik.
Dialog: 0,0:12:37.07,0:12:38.90,Default,Lily1,0,0,0,,Baiklah. Dengan baik.
Dialogue: 0,0:12:40.57,0:12:43.17,Default,Lily1,0,0,0,,Kenapa aku tidak mengira dia mungkin tidak menyukaiku?
Dialogue: 0,0:12:43.77,0:12:47.91,Default,Lily1,0,0,0,,Kenapa aku berpikir berhari-hari,
Dialog: 0,0:12:48.08,0:12:50.55,Default,Lily1,0,0,0,,pilih cinta atau keluarga?
Dialog: 0,0:12:51.21,0:12:53.82,Default,Lily1,0,0,0,,Rintangan terbesar dalam cinta adalah
Dialog: 0,0:12:53.82,0:12:56.02,Default,Lily1,0,0,0,,ini tidak lebih dari
Dialog: 0,0:12:56.02,0:12:58.29,Default,Lily1,0,0,0,,memenangkan hati orang yang kamu cintai.
Dialog: 0,0:12:59.46,0:13:01.06,Default,Lily1,0,0,0,,Apa alasannya?
Dialog: 0,0:13:01.56,0:13:02.73,Default,Lily1,0,0,0,,Dia berkata:
Dialog: 0,0:13:03.56,0:13:04.99,Default,Lily1,0,0,0,,Aku tidak menyukaimu.
Dialog: 0,0:13:05.83,0:13:06.90,Default,Lily1,0,0,0,,Apa?
Dialog: 0,0:13:07.80,0:13:08.80,Default,Lily1,0,0,0,,Selamat tinggal.
Dialog: 0,0:13:10.57,0:13:11.70,Default,Lily1,0,0,0,,Tunggu.
Dialog: 0,0:13:12.77,0:13:15.34,Default,Lily1,0,0,0,,Beri tahu alasannya.
Dialog: 0,0:13:15.87,0:13:17.31,Default,Lily1,0,0,0,,Kenapa kamu tidak menyukaiku?
Dialog: 0,0:13:21.81,0:13:22.98,Default,Lily1,0,0,0,,I
Dialog: 0,0:13:24.31,0:13:26.28,Default,Lily1,0,0,0,,Saya tidak suka pria ambisius.
Dialog: 0,0:13:28.28,0:13:30.65,Default,Spillik2,0,0,0,,Diam, diam.
Dialog: 0,0:13:32.92,0:13:35.19,Default,Spikyulka2,0,0,0,,Ini kelembapannya.
Dialog: 0,0:13:35.89,0:13:39.46,Default,Spikyulka2,0,0,0,,Cinta dimulai dengan kelembapan
Dialog: 0,0:13:39.46,0:13:42.03,Default,Spikyulka2,0,0,0,,dan berakhir dengan kelembapan seperti itu.
Dialog: 0,0:13:44.93,0:13:46.64,Default,Spikyulka2,0,0,0,,-Tapi...\N-Sial, aku membuatmu takut.
Dialog: 0,0:13:46.67,0:13:48.20,Default,Spikyulka2,0,0,0,,Ada kabar baik.
Dialog: 0,0:13:48.20,0:13:50.11,Default,Spillik2,0,0,0,,Raja merasa lebih baik,
Dialog: 0,0:13:51.21,0:13:52.71,Default,Spikyulka2,0,0,0,,doaku terkabul.
Dialog: 0,0:13:54.08,0:13:56.08,Default,Spikyulka2,0,0,0,,Saya yakin Anda pernah mendengar hal lain.
Dialog: 0,0:13:58.25,0:14:01.72,Default,Spikyulka2,0,0,0,,Kim Jwageun akan diturunkan karena insiden ini.
Dialog: 0,0:14:02.49,0:14:05.76,Default,Spillik2,0,0,0,,Saya suka raja, dan saya menghormati Kim Jwageun.
Dialog: 0,0:14:06.22,0:14:08.56,Default,Spillik2,0,0,0,,Hatiku hancur berkeping-keping.
Dialog: 0,0:14:08.69,0:14:11.89,Default,Spikyulka2,0,0,0,,Bagaimana kamu bisa mencintai raja, karena kamu tidak mengenalnya secara pribadi.
Dialog: 0,0:14:13.40,0:14:15.67,Default,Spillik2,0,0,0,,Bagaimanapun, dia adalah sahabatmu.
Dialog: 0,0:14:15.80,0:14:17.60,Default,Spillik2,0,0,0,,Kamu orang baik,
Dialog: 0,0:14:17.60,0:14:19.60,Default,Spikyulka2,0,0,0,,jadi temanmu seharusnya seperti itu.
Dialog: 0,0:14:21.40,0:14:22.67,Default,Spikyulka2,0,0,0,,Nah, Anda sudah menyelesaikannya.
Dialogue: 0,0:14:29.21,0:14:30.75,Default,Spillik2,0,0,0,,Apakah kamu menggambar gurita?
Dialogue: 0,0:14:30.88,0:14:33.55,Default,Spikyulka2,0,0,0,,Apa yang dimaksud dengan “gurita”? Ini seorang pria.
Dialog: 0,0:14:35.05,0:14:36.15,Default,Spillik2,0,0,0,,Ini?
Dialog: 0,0:14:36.72,0:14:39.02,Default,Spikyulka2,0,0,0,,Saya menggambarnya dengan baik, jika Anda perhatikan detailnya dengan cermat.
Dialog: 0,0:14:40.89,0:14:43.16,Default,Spillik2,0,0,0,,-Ini pasti matanya.\N-Ini mulutnya.
Dialogue: 0,0:14:45.46,0:14:48.00,Default,Silk2,0,0,0,,-Apakah itu mulutnya?\N-Tidak bisakah kamu melihat bibirnya?
Dialog: 0,0:14:53.87,0:14:56.94,Default,Spikyulka2,0,0,0,,Prediksi paling baik dibaca di pagi hari.
Dialog: 0,0:14:59.41,0:15:01.81,Default,Spillik2,0,0,0,,Ibu Suri, Yang Mulia ada di sini.
Dialog: 0,0:15:06.18,0:15:07.25,Default,Spillik2,0,0,0,,Tuhan.
Dialog: 0,0:15:07.85,0:15:11.99,Default,Spilyk2,0,0,0,,Kamu tidak punya wajah.
Dialog: 0,0:15:12.79,0:15:16.93,Default,Spillik2,0,0,0,,Seolah-olah raja belum bangun.
Dialog: 0,0:15:17.46,0:15:20.06,Default,Spikyulka2,0,0,0,,Bagaimana kabar ratu?
Dialog: 0,0:15:21.06,0:15:23.23,Default,Spikyulka2,0,0,0,,Saya tidak melihat manfaat apa pun darinya lagi
Dialog: 0,0:15:23.80,0:15:25.70,Default,Spikyulka2,0,0,0,,dan melakukan apa yang Anda minta.
Dialogue: 0,0:15:26.54,0:15:29.21,Default,Spillit2,0,0,0,,Saya yakin item itu
Dialog: 0,0:15:29.21,0:15:31.34,Default,Spillie2,0,0,0,,ditemukan di kamarnya.
Dialog: 0,0:15:31.71,0:15:35.71,Default,Spillik2,0,0,0,,Raja bermalam di kamar ratu tadi malam.
Dialogue: 0,0:15:35.95,0:15:37.98,Default,Spilyk2,0,0,0,,Segera, bagaimana cara sembuhnya?
Dialog: 0,0:15:38.15,0:15:40.38,Default,Spikyulka2,0,0,0,,Karena kejadian ledakan itu, aku sadar
Dialog: 0,0:15:41.52,0:15:44.65,Default,Spikyulka2,0,0,0,,bahwa jika aku kehilangannya, aku akan mati.
Dialog: 0,0:15:45.35,0:15:47.49,Default,Spillie2,0,0,0,,Wanita yang akan mati hari ini...
Dialog: 0,0:15:48.12,0:15:49.63,Default,Spillik2,0,0,0,,Benarkah?..
Dialogue: 0,0:16:20.02,0:16:21.46,Default,Spillik2,0,0,0,,Aku ingin mati.
Dialogue: 0,0:16:21.89,0:16:23.43,Default,Spillik2,0,0,0,,Haruskah aku bunuh diri?
Dialog: 0,0:16:23.63,0:16:25.50,Default,Spillik2,0,0,0,,Mungkin jika aku mati, aku akan merasa lebih baik?
Dialog: 0,0:16:33.17,0:16:35.81,Default,Spillik2,0,0,0,,Maaf ratu, kasihanilah.
Dialog: 0,0:16:36.11,0:16:38.74,Default,Spilyk2,0,0,0,,Saya menyangkal semuanya,
Dialog: 0,0:16:38.74,0:16:41.04,Default,Spikyulka2,0,0,0,,tapi raja sangat yakin.
Dialog: 0,0:16:42.28,0:16:43.61,Default,Spillik2,0,0,0,,Apa? Apa yang kamu bicarakan?
Dialog: 0,0:16:45.05,0:16:46.18,Default,Spillik2,0,0,0,,Apa yang kamu bicarakan?
Dialogue: 0,0:16:47.18,0:16:49.39,Default,Spillik2,0,0,0,,Bisakah kamu mencium bau terbakar?
Dialogue: 0,0:16:49.55,0:16:52.52,Default,Spilyk2,0,0,0,,Tangan siapa yang mereka lakukan? Ada di antara kalian?
Dialog: 0,0:16:52.52,0:16:53.72,Default,Spikyulka2,0,0,0,,-Mau kemana?\N-Biarkan aku pergi.
Dialog: 0,0:16:55.96,0:16:57.36,Default,Spillit2,0,0,0,,Nyonya Choi.
Dialog: 0,0:17:02.50,0:17:03.73,Default,Spilyk2,0,0,0,,Pada akhirnya
Dialog: 0,0:17:04.53,0:17:06.70,Default,Spilyk2,0,0,0,,Aku menceritakan semuanya padanya.
Dialog: 0,0:17:10.01,0:17:11.07,Default,Spillik2,0,0,0,,Benarkah?
Dialog: 0,0:17:11.37,0:17:13.61,Default,Spikyulka2,0,0,0,,Biar kujelaskan.
Dialog: 0,0:17:13.61,0:17:16.01,Default,Silk2,0,0,0,,Raja datang kepadaku kemarin, berbicara denganmu,
Dialog: 0,0:17:16.01,0:17:18.21,Default,Spikyulka2,0,0,0,,dan karena itu semua kekacauan ini. Jadi?
Dialog: 0,0:17:18.21,0:17:19.75,Default,Spikyulka2,0,0,0,,Saya tidak mengatakan hal seperti itu.
Dialog: 0,0:17:21.38,0:17:23.79,Default,Spikyulka2,0,0,0,,Jadi aku sangat bingung
Dialog: 0,0:17:25.25,0:17:27.56,Default,Spillik2,0,0,0,,salahmu.
Dialog: 0,0:17:27.76,0:17:30.26,Default,Spillik2,0,0,0,,Apa? Mengapa kamu bingung?
Dialog: 0,0:17:30.26,0:17:31.86,Default,Spillik2,0,0,0,,Kamu!
Dialogue: 0,0:17:34.20,0:17:35.67,Default,Spikyulka2,0,0,0,,Itu bagus.
Dialog: 0,0:17:36.80,0:17:38.20,Default,Spikyulka2,0,0,0,,Mungkin lebih baik dari sebelumnya.
Dialogue: 0,0:17:39.20,0:17:41.00,Default,Spillik2,0,0,0,,Inilah kenapa aku jadi gila!
Dialog: 0,0:17:41.87,0:17:44.31,Default,Spillik2,0,0,0,,Mengapa saya menyukainya? Ini seharusnya tidak terjadi.
Dialog: 0,0:17:45.21,0:17:46.81,Default,Spilyk2,0,0,0,,Jadi jiwa tidak mengendalikan tubuh?
Dialogue: 0,0:17:47.14,0:17:49.01,Default,Spikyulka2,0,0,0,,Jadi pikiran dan tubuh berada di luar kendali kita?
Dialog: 0,0:17:49.01,0:17:51.08,Default,Spillik2,0,0,0,,Hormon mengatur segalanya?
Dialog: 0,0:17:52.55,0:17:54.32,Default,Spillik2,0,0,0,,-Mimpi buruk.\N-Yang Mulia.
Dialog: 0,0:17:56.85,0:17:58.85,Default,Spikyulka2,0,0,0,,-Ada apa dengan dia?\N-Yang Mulia.
Dialog: 0,0:17:59.69,0:18:00.99,Default,Spikyulka2,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:18:02.29,0:18:05.90,Default,Spillik2,0,0,0,,Dia dalam rohnya sendiri.
Dialog: 0,0:18:08.90,0:18:10.80,Default,Spillik2,0,0,0,,Kenapa kamu tidak merasa jijik?
Dialog: 0,0:18:11.33,0:18:13.00,Default,Spillik2,0,0,0,,Mengapa?
Dialog: 0,0:18:13.80,0:18:18.21,Default,Spillik2,0,0,0,,Rasakan! Merasa jijik. Anda pasti membencinya!
Dialog: 0,0:18:18.21,0:18:20.34,Default,Silk2,0,0,0,,Bersiaplah untuk menyambut Yang Mulia.
Dialog: 0,0:18:26.72,0:18:28.08,Default,Spillik2,0,0,0,,Di mana ratuku?
Dialog: 0,0:18:28.48,0:18:30.15,Default,Spillik2,0,0,0,,Yang Mulia, dia...
Dialog: 0,0:18:34.06,0:18:37.56,Default,Spillik2,0,0,0,,Maaf. Dia baru saja di sini.
Dialogue: 0,0:18:39.20,0:18:41.56,Default,Spillik2,0,0,0,,Apakah dia sejauh ini bersembunyi dariku?
Dialog: 0,0:18:41.83,0:18:43.93,Default,Spillik2,0,0,0,,Tadi malam seperti harimau betina...
Dialog: 0,0:18:43.93,0:18:45.60,Default,Spillik2,0,0,0,,Rrrrr!
Dialogue: 0,0:18:51.04,0:18:53.21,Default,Spillik2,0,0,0,,Bisakah kamu membantuku menemukan ratu?
Dialog: 0,0:18:53.64,0:18:54.74,Default,Spikyulka2,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:18:54.91,0:18:57.01,Default,Spikyulka2,0,0,0,,Seperti yang kau lihat, ada banyak hal yang ingin kukatakan padanya.
Dialog: 0,0:19:00.68,0:19:02.15,Default,Spilyk2,0,0,0,,Saya penasaran apa sebenarnya.
Dialog: 0,0:19:09.03,0:19:11.63,Default,Spillik2,0,0,0,,Tidak. Jika aku bertemu dengannya sekarang, aku akan mendapat masalah besar.
Dialog: 0,0:19:12.06,0:19:13.96,Default,Spillik2,0,0,0,,Bagaimana jika tubuhku mengkhianatiku lagi?
Dialog: 0,0:19:14.30,0:19:15.36,Default,Spillik2,0,0,0,,Tepat.
Dialog: 0,0:19:15.36,0:19:18.47,Default,Spillik2,0,0,0,,Saya yakin roh Kim So-yeon merasukinya tadi malam.
Dialog: 0,0:19:20.10,0:19:23.04,Default,Spikyulka2,0,0,0,,Dan aku hanya menyukainya karena kupikir itu Hong Young.
Dialog: 0,0:19:23.04,0:19:24.77,Default,Spikyulka2,0,0,0,,Kalau saja aku tahu itu dia...
Dialogue: 0,0:19:28.18,0:19:29.31,Default,Spikyulka2,0,0,0,,Tapi aku tetap menyukainya.
Dialog: 0,0:19:30.38,0:19:32.21,Default,Spillik2,0,0,0,,Aku pasti jadi gila.
Dialog: 0,0:19:40.59,0:19:43.09,Default,Spillik2,0,0,0,,Bagaimana jika Jang Bong-hwan menghilang selamanya?
Dialog: 0,0:19:44.69,0:19:45.83,Default,Spillik2,0,0,0,,Bagaimana jika?
Dialog: 0,0:19:45.83,0:19:47.03,Default,Spillik2,0,0,0,,Seharusnya aku tidak sampai di sini.\NJang Bong-hwan
Dialog: 0,0:19:47.03,0:19:48.97,Default,Silk2,0,0,0,,-Ratuku.\N-Yang Mulia!
Dialog: 0,0:19:49.43,0:19:50.67,Default,Spillik2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:19:50.67,0:19:51.70,Default,Spillik2,0,0,0,,Astaga.
Dialog: 0,0:19:53.10,0:19:54.17,Default,Spilyk2,0,0,0,,Yang Mulia.
Dialog: 0,0:19:55.87,0:19:56.94,Default,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:19:58.14,0:20:00.18,Default,Spillik2,0,0,0,,-Yang Mulia.\N-Ratuku.
Dialog: 0,0:20:01.41,0:20:02.48,Default,Spillik2,0,0,0,,Ratuku.
Dialog: 0,0:20:04.41,0:20:06.72,Default,Spillik2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:20:13.62,0:20:14.62,Default,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:15.79,0:20:16.89,Default,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:17.93,0:20:20.00,Default,Silk2,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:20:22.06,0:20:23.07,Default,Spillik2,0,0,0,,Yang Mulia!
Dialog: 0,0:20:25.97,0:20:28.54,Default,Spikyulka2,0,0,0,,Kim Jwageun akan kehilangan posisinya,
Dialog: 0,0:20:28.54,0:20:30.97,Default,Silk2,0,0,0,,bagaimanapun juga, dia menjelaskan bahwa dia berusaha menyingkirkan raja.
Dialog: 0,0:20:31.27,0:20:32.31,Default,Spillik2,0,0,0,,Luar Biasa.
Dialog: 0,0:20:34.24,0:20:36.28,Default,Spilyk2,0,0,0,,Semakin aku memikirkannya,
Dialogue: 0,0:20:36.28,0:20:38.28,Default,Spikyulka2,0,0,0,,semakin yakin ini bukan gayanya.
Dialog: 0,0:20:39.05,0:20:40.65,Default,Spikyulka2,0,0,0,,Pastinya dia merasa terpojok.
Dialog: 0,0:20:40.98,0:20:42.89,Default,Spikyulka2,0,0,0,,Karena ledakan itu
Dialog: 0,0:20:42.89,0:20:45.12,Default,Spikyulka2,0,0,0,,Kim Jwageun kehilangan segalanya.
Dialog: 0,0:20:45.65,0:20:47.99,Default,Spikyulka2,0,0,0,,Di sisi lain, raja hanya menang.
Dialog: 0,0:20:47.99,0:20:49.23,Default,Spilyk2,0,0,0,,Bahkan jika demikian,
Dialog: 0,0:20:49.23,0:20:52.29,Default,Spikyulka2,0,0,0,,Saya ragu raja sendiri yang menyebabkan ledakan, mempertaruhkan nyawanya.
Dialog: 0,0:20:53.80,0:20:54.90,Default,Spillik2,0,0,0,,Dan itu benar.
Dialog: 0,0:20:57.57,0:20:59.97,Default,Spillik2,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialogue: 0,0:21:00.10,0:21:02.44,Default,Spikyulka2,0,0,0,,-Apakah kamu akan pergi ke dewan?\N-Ya.
Dialog: 0,0:21:02.87,0:21:06.24,Default,Spilyk2,0,0,0,,Bolehkah aku bertanya, kenapa kamu sendirian?
Dialog: 0,0:21:07.28,0:21:08.28,Default,Spillik2,0,0,0,,Ratuku...
Dialog: 0,0:21:08.38,0:21:09.45,Default,Spillik2,0,0,0,,-Ratu?\N-Ratu?
Dialog: 0,0:21:14.95,0:21:17.45,Default,Spikyulka2,0,0,0,,Yang Mulia, apakah Anda sedang bermain petak umpet?
Dialogue: 0,0:21:17.82,0:21:20.16,Default,Spikyulka2,0,0,0,,-Aku memainkannya dengan hebat!\N-Hush.
Dialog: 0,0:21:28.20,0:21:29.27,Default,Spilyk2,0,0,0,,Ditemukan.
Dialogue: 0,0:21:29.27,0:21:31.57,Default,Spillie2,0,0,0,,Menyebalkan. Berhenti menguntitku!
Dialog: 0,0:21:31.57,0:21:33.44,Default,Spilyk2,0,0,0,,Apakah kamu seorang paparazzi? Atau penguntit?
Dialog: 0,0:21:33.44,0:21:34.97,Default,Spikyulka2,0,0,0,,-Mengerti.\N-Apa?
Dialog: 0,0:21:34.97,0:21:37.17,Default,Spillik2,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:21:37.17,0:21:39.24,Default,Spikyulka2,0,0,0,,-Sampai jumpa di dewan kerajaan.\N-Oke.
Dialog: 0,0:21:39.44,0:21:41.74,Default,Spikyulka2,0,0,0,,Mari kita diskusikan semuanya dengan tenang.
Dialog: 0,0:21:41.74,0:21:42.78,Default,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:21:42.78,0:21:44.88,Default,Spillik2,0,0,0,,Mereka benar-benar gila karena cinta.
Dialog: 0,0:21:44.88,0:21:46.88,Default,Spikyulka2,0,0,0,,-Ratuku!\N-Bermain petak umpet?
Dialog: 0,0:21:47.42,0:21:48.95,Default,Spillik2,0,0,0,,Seperti anak kecil.
Dialog: 0,0:21:48.95,0:21:52.76,Default,Spillik2,0,0,0,,Apa? Memainkan petak umpet kapan
Dialog: 0,0:21:53.39,0:21:54.86,Default,Spikyulka2,0,0,0,,hampir mati baru-baru ini?
Dialog: 0,0:21:58.13,0:22:00.33,Default,Spillik2,0,0,0,,Tepat. Ada selir kerajaan.
Dialog: 0,0:22:00.46,0:22:02.20,Default,Spikyulka2,0,0,0,,Kami melakukan korespondensi cinta sepanjang malam.
Dialogue: 0,0:22:02.20,0:22:04.83,Default,Spillik2,0,0,0,,Mereka adalah malaikat pelindung orientasi seksualku!
Dialog: 0,0:22:04.83,0:22:07.14,Default,Tolenka3,0,0,0,,Yang Mulia, kami menyambut Anda.
Dialog: 0,0:22:07.14,0:22:08.84,Default,Tolenka3,0,0,0,,Apakah kamu baik-baik saja?
Dialogue: 0,0:22:11.17,0:22:12.41,Default,Tolenka3,0,0,0,,Semoga harimu menyenangkan.
Dialog: 0,0:22:15.51,0:22:16.51,Default,Tolenka3,0,0,0,,Ratuku.
Dialog: 0,0:22:17.35,0:22:19.11,Default,Tolenka3,0,0,0,,Kamu tidak boleh berlarian di halaman.
Dialog: 0,0:22:19.78,0:22:22.59,Default,Tolenka3,0,0,0,,Sepertinya keduanya, kecuali satu sama lain, tidak membutuhkan orang lain.
Dialog: 0,0:22:23.79,0:22:24.82,Default,Tolenka3,0,0,0,,Sepertinya begitu.
Dialogue: 0,0:22:24.82,0:22:28.86,Default,Tolenka3,0,0,0,,Ngomong-ngomong, betapa cantiknya tampilannya.
Dialog: 0,0:22:35.06,0:22:37.77,Default,Tolenka3,0,0,0,,Luar Biasa. Mari kita menulis surat kepada para wanita,\Ndan penyimpangan orientasi tidak akan terjadi lagi.
Dialog: 0,0:22:39.27,0:22:41.24,Default,Tolenka3,0,0,0,,-Ratuku. \N-Yang Mulia.
Dialog: 0,0:22:42.97,0:22:43.97,Default,Tolenka3,0,0,0,,Ratuku.
Dialog: 0,0:23:05.86,0:23:07.13,Default,Tolenka3,0,0,0,,Dan dia tidak ada di sini.
Dialog: 0,0:23:08.50,0:23:12.33,Default,Tolenka3,0,0,0,,Aku tidak hanya mengejarnya. Saya ingin menanyakan sesuatu padamu.
Dialog: 0,0:23:12.87,0:23:14.10,Default,Tolenka3,0,0,0,,Tanya?
Dialog: 0,0:23:14.10,0:23:16.44,Default,Tolenka3,0,0,0,,Tapi dia tampak tidak nyaman berada di dekatku.
Dialog: 0,0:23:18.04,0:23:19.21,Default,Tolenka3,0,0,0,,Saatnya berhenti.
Dialog: 0,0:23:20.94,0:23:22.71,Default,Tolenka3,0,0,0,,Saya berharap ketika dia memiliki perasaan
Dialog: 0,0:23:24.45,0:23:26.42,Default,Tolenka3,0,0,0,,memutuskan, dia akan datang kepadaku sendiri.
Dialog: 0,0:23:34.26,0:23:36.53,Default,Tolenka3,0,0,0,, -Saatnya pergi ke ruang pertemuan. \N-Ya.
Dialog: 0,0:23:40.63,0:23:41.76,Default,Tolenka3,0,0,0,,Ini dia.
Dialog: 0,0:23:42.97,0:23:44.77,Default,Tolenka3,0,0,0,,Sepertinya kamu berjalan mengelilingi seluruh istana hari ini.
Dialog: 0,0:23:44.77,0:23:46.27,Default,Tolenka3,0,0,0,,Aku sudah mengejarmu sejak pagi.
Dialog: 0,0:23:46.90,0:23:48.10,Default,Tolenka3,0,0,0,,Apa yang terjadi?
Dialog: 0,0:23:51.51,0:23:54.11,Default,Tolenka3,0,0,0,,Ini dia. Tadi malam...
Dialog: 0,0:23:55.78,0:23:57.18,Default,Tolenka3,0,0,0,,Mari kita diskusikan semuanya sepanjang jalan.
Dialog: 0,0:23:57.81,0:23:58.85,Default,Tolenka3,0,0,0,,Ayo berangkat.
Dialogue: 0,0:23:59.55,0:24:00.68,Default,Tolenka3,0,0,0,,Kita mau kemana?
Dialog: 0,0:24:01.68,0:24:02.82,Default,Tolenka3,0,0,0,,Bagaimana kalau kita pergi ke suatu tempat lagi?
Dialogue: 0,0:24:06.36,0:24:07.79,Default,Tolenka3,0,0,0,,Istananya terlalu besar.
Dialog: 0,0:24:33.35,0:24:34.38,Default,Tolenka3,0,0,0,,Hilang?
Dialog: 0,0:24:37.42,0:24:39.39,Default,Tolenka3,0,0,0,,Apa yang ingin dia tanyakan?
Dialogue: 0,0:24:41.69,0:24:44.46,Default,Tolenka3,0,0,0,,Apa yang ditanyakan pria dalam situasi seperti itu?
Dialog: 0,0:24:46.13,0:24:47.16,Default,Tolenka3,0,0,0,,Nah, enakkah?
Dialog: 0,0:24:57.41,0:24:58.71,Default,Tolenka3,0,0,0,,Kirim seperti biasa.
Dialog: 0,0:25:00.74,0:25:01.98,Default,Tolenka3,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:25:04.58,0:25:05.88,Default,Tolenka3,0,0,0,,Ada yang salah di sini.
Dialog: 0,0:25:07.28,0:25:08.32,Default,Tolenka3,0,0,0,,Nyonya Choi.
Dialog: 0,0:25:09.49,0:25:10.59,Default,Tolenka3,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:25:10.85,0:25:12.96,Default,Tolenka3,0,0,0,,Kenapa kamu tidak memarahiku lagi?
Dialog: 0,0:25:13.12,0:25:15.96,Default,Tolenka3,0,0,0,,Tidak pantas meninggalkan ruangan Anda seperti ini, Yang Mulia.
Dialog: 0,0:25:16.66,0:25:17.83,Default,Tolenka3,0,0,0,,Saya perlu mengingatkan semuanya.
Dialog: 0,0:25:18.13,0:25:20.43,Default,Tolenka3,0,0,0,,Aku memutuskan untuk tidak menegurmu lagi.
Dialog: 0,0:25:20.93,0:25:22.20,Default,Tolenka3,0,0,0,,Apa?
Dialog: 0,0:25:23.40,0:25:24.53,Default,Tolenka3,0,0,0,,Kenapa ini tiba-tiba?
Dialog: 0,0:25:25.53,0:25:27.77,Default,Tolenka3,0,0,0,,-Oke, mulai. \N-Oke.
Dialog: 0,0:25:31.54,0:25:32.71,Default,Tolenka3,0,0,0,,Sungguh mengejutkan.
Dialog: 0,0:25:56.02,0:25:57.12,Default,Tolenka3,0,0,0,,Mulai hari ini
Dialog: 0,0:25:58.66,0:26:01.49,Default,Tolenka3,0,0,0,,Saya mengundurkan diri sebagai bupati.
Dialog: 0,0:26:44.80,0:26:45.90,Default,Tolenka3,0,0,0,,Dan karena itu
Dialog: 0,0:26:47.01,0:26:49.21,Default,Tolenka3,0,0,0,,mulai sekarang aku akan memerintah sendiri.
Dialog: 0,0:26:49.54,0:26:54.45,Default,Tolenka3,0,0,0,,Panjang umur bagi raja!
Dialog: 0,0:27:11.70,0:27:14.00,Default,Tolenka3,0,0,0,,Kalau terus begini aku akan segera mati.
Dialogue: 0,0:27:15.03,0:27:18.40,Default,Tolenka3,0,0,0,,Semua pengalaman ini akan menghabisiku.
Dialog: 0,0:27:19.10,0:27:21.47,Default,Tolenka3,0,0,0,,Beri tahu aku kalau kamu tidak lapar hari ini?
Dialog: 0,0:27:21.91,0:27:25.28,Default,Tolenka3,0,0,0,,Apakah kamu ingin mempercepat kematianku?
Dialog: 0,0:27:25.54,0:27:26.91,Default,Tolenka3,0,0,0,,Maaf.
Dialog: 0,0:27:27.68,0:27:28.88,Default,Tolenka3,0,0,0,,Namun
Dialog: 0,0:27:29.18,0:27:32.92,Default,Tolenka3,0,0,0,,Saya masih belum bisa memutuskan apakah akan memesan makanan untuk dibawa atau tidak.
Dialog: 0,0:27:32.92,0:27:36.02,Default,Tolenka3,0,0,0,,Jika aku memerintahkanmu untuk membawanya, kamu akan marah,\Nkarena kami mengingatmu sampai kematianmu.
Dialog: 0,0:27:36.76,0:27:39.73,Default,Tolenka3,0,0,0,,Apa, bahkan hal sederhana seperti itu
Dialog: 0,0:27:39.73,0:27:41.93,Default,Tolenka3,0,0,0,,tidak bisakah kamu memutuskan tanpa aku?!
Dialogue: 0,0:27:43.03,0:27:44.13,Default,Tolenka3,0,0,0,,Janda Ratu!
Dialog: 0,0:27:46.43,0:27:47.83,Default,Tolenka3,0,0,0,,Tolong, redakan amarahmu.
Dialog: 0,0:27:51.80,0:27:53.91,Default,Tolenka3,0,0,0,,Bisakah kamu tidak marah dalam situasi seperti ini?
Dialog: 0,0:27:54.14,0:27:57.64,Default,Tolenka3,0,0,0,,Saya praktis kehilangan pengaruh saya di istana.
Dialog: 0,0:27:58.61,0:28:00.75,Default,Tolenka3,0,0,0,,Saya akan membantu mengembalikan kekuatan sebelumnya.
Dialog: 0,0:28:02.65,0:28:04.98,Default,Tolenka3,0,0,0,,Anda akan menjadi bupati lagi.
Dialogue: 0,0:28:06.12,0:28:07.55,Default,Tolenka3,0,0,0,,Dan kamu sangat percaya diri.
Dialog: 0,0:28:08.55,0:28:10.62,Default,Tolenka3,0,0,0,,Ayahmu juga sama di masa mudanya.
Dialog: 0,0:28:11.96,0:28:14.66,Default,Tolenka3,0,0,0,,Ini kesempatan terakhir.
Dialog: 0,0:28:15.19,0:28:17.06,Default,Tolenka3,0,0,0,,Dan apa yang perlu dilakukan?
Dialogue: 0,0:28:17.43,0:28:20.37,Default,Tolenka3,0,0,0,,Cari cara untuk melemahkan semangat raja.
Dialog: 0,0:28:22.53,0:28:24.67,Default,Tolenka3,0,0,0,,Jika semuanya berjalan baik untuknya,
Dialog: 0,0:28:24.67,0:28:27.17,Default,Tolenka3,0,0,0,,hanya memikirkan diri sendiri dan berusaha untuk tidak menyerahkan diri.
Dialog: 0,0:28:28.14,0:28:29.24,Default,Tolenka3,0,0,0,,Mengerti.
Dialog: 0,0:28:29.24,0:28:32.84,Default,Tolenka3,0,0,0,,Namun, kecil kemungkinan metode lama akan efektif.
Dialog: 0,0:28:35.01,0:28:37.15,Default,Tolenka3,0,0,0,,Jangan meremehkan raja.
Dialog: 0,0:28:37.42,0:28:41.52,Default,Tolenka3,0,0,0,,Apakah menurutmu ledakan itu adalah ulahnya?
Dialog: 0,0:28:42.22,0:28:45.39,Default,Tolenka3,0,0,0,,Sebagai aturan, pihak yang paling diuntungkan adalah pihak yang disalahkan.
Dialog: 0,0:28:45.89,0:28:48.66,Default,Tolenka3,0,0,0,,Aku tidak percaya aku memberikan takhta kepada bajingan berbahaya seperti itu.
Dialog: 0,0:28:54.83,0:28:58.27,Default,Tolenka3,0,0,0,,Yang Mulia, selamat atas berakhirnya masa pemerintahan.
Dialog: 0,0:28:59.74,0:29:00.94,Default,Tolenka3,0,0,0,,Terima kasih.
Dialog: 0,0:29:03.11,0:29:05.41,Default,Tolenka3,0,0,0,,Saat Anda pergi, sebuah pesan terkirim
Dialog: 0,0:29:05.41,0:29:07.18,Default,Tolenka3,0,0,0,,dari paviliun Daejojon.
Dialog: 0,0:29:08.11,0:29:09.92,Default,Tolenka3,0,0,0,,-Dari ratu? \N-Ya, Yang Mulia.
Dialog: 0,0:29:16.69,0:29:19.59,Default,Tolenka3,0,0,0,,Aku mencoba menyampaikan dengan kata-kata betapa aku merana karena kerinduan padamu,
Dialog: 0,0:29:19.89,0:29:21.06,Default,Tolenka3,0,0,0,,dan aku semakin merindukanmu.
Dialog: 0,0:29:24.43,0:29:26.20,Default,Tolenka3,0,0,0,,Sesuatu perlu dilakukan mengenai hal ini.
Dialogue: 0,0:29:33.04,0:29:34.97,Default,Tolenka3,0,0,0,,Permohonan putus asaku didengar.
Dialogue: 0,0:29:35.61,0:29:36.71,Default,Tolenka3,0,0,0,,Sungguh gigih.
Dialog: 0,0:29:37.71,0:29:38.91,Default,Tolenka3,0,0,0,,Kita harus bertemu.
Dialog: 0,0:29:43.12,0:29:44.48,Default,Tolenka3,0,0,0,,Apakah kamu sudah sampai?
Dialogue: 0,0:29:44.92,0:29:47.05,Default,Tolenka3,0,0,0,,Untuk menyelamatkanku dari siksaan ini...
Dialog: 0,0:29:48.29,0:29:49.39,Default,Tolenka3,0,0,0,,Choljong?
Dialog: 0,0:29:49.82,0:29:51.12,Default,Tolenka3,0,0,0,,Bagaimana kamu tahu keberadaanku?
Dialog: 0,0:29:51.29,0:29:53.29,Default,Tolenka3,0,0,0,,Bagaimana ini? Anda sendiri yang membuat janji temu.
Dialog: 0,0:29:53.29,0:29:55.96,Default,Tolenka3,0,0,0,,-Dan seorang selir memanggilku ke sini!\N-Selir yang mana?
Dialog: 0,0:29:55.96,0:29:57.63,Default,Tolenka3,0,0,0,,Kalau belum tahu, lebih menarik lagi,
Dialog: 0,0:29:57.63,0:29:59.36,Default,Tolenka3,0,0,0,,jadi saya tidak bertanya.
Dialog: 0,0:29:59.77,0:30:01.30,Default,Tolenka3,0,0,0,,Bagaimanapun, saya tidak menulis surat kepada Anda.
Dialogue: 0,0:30:01.70,0:30:04.00,Default,Tolenka3,0,0,0,,Terkadang pikiran yang berbeda datang padaku.
Dialog: 0,0:30:05.54,0:30:08.24,Default,Tolenka3,0,0,0,,Kuharap aku bisa tenggelam dalam arus pemikiran tentangmu.
Dialog: 0,0:30:08.74,0:30:11.84,Default,Tolenka3,0,0,0,,Berpegang teguh padaku.
Dialog: 0,0:30:12.71,0:30:17.52,Default,Tolenka3,0,0,0,,Oh! Aku tidak akan membiarkanmu pergi untuk apa pun!
Dialog: 0,0:30:17.68,0:30:19.58,Default,Tolenka3,0,0,0,,-Cukup. \N-Apakah kamu sudah mendapatkannya sekarang?
Dialog: 0,0:30:20.15,0:30:21.19,Default,Tolenka3,0,0,0,,Tidak.
Dialog: 0,0:30:21.29,0:30:23.26,Default,Tolenka3,0,0,0,,Bukan lirik, tapi semacam rasa malu. Pertama kali saya mendengarnya.
Dialog: 0,0:30:23.26,0:30:25.42,Default,Tolenka3,0,0,0,,Namamu akan ada di bibirku sampai aku beristirahat.
Dialog: 0,0:30:25.62,0:30:27.89,Default,Tolenka3,0,0,0,,Akan memenuhi semua pikiranku, aku tidak akan pernah melupakannya.
Dialog: 0,0:30:27.99,0:30:29.66,Default,Tolenka3,0,0,0,,Cukup. Ada orang disini.
Dialog: 0,0:30:31.06,0:30:33.50,Default,Tolenka3,0,0,0,,Jadi apa? Bukan kamu yang menulisnya.
Dialog: 0,0:30:40.37,0:30:42.74,Default,Tolenka3,0,0,0,,Kita perlu mendiskusikan sesuatu. Tinggalkan kami.
Dialog: 0,0:30:42.74,0:30:43.88,Default,Tolenka3,0,0,0,,Oke?
Dialog: 0,0:30:43.88,0:30:45.91,Default,Tolenka3,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:30:53.92,0:30:55.19,Default,Tolenka3,0,0,0,,Apakah kamu diam-diam mengikutiku?
Dialog: 0,0:30:55.32,0:30:56.96,Default,Tolenka3,0,0,0,,Apakah Anda membaca korespondensi?
Dialog: 0,0:30:57.62,0:30:58.82,Default,Tolenka3,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:30:59.42,0:31:01.83,Default,Tolenka3,0,0,0,,Kamu mengakui cintamu melalui pesan.
Dialog: 0,0:31:01.83,0:31:03.46,Default,Tolenka3,0,0,0,,Dan saat kita bertemu, kamu berpura-pura tidak peduli.
Dialog: 0,0:31:04.40,0:31:05.83,Default,Tolenka3,0,0,0,,Bagaimana kamu bisa begitu kejam.
Dialogue: 0,0:31:10.67,0:31:12.07,Default,Tolenka3,0,0,0,,Atau suratnya dikirim ke tempat yang salah?!
Dialog: 0,0:31:12.80,0:31:14.57,Default,Tolenka3,0,0,0,,Ternyata pesan tersebut tidak ditujukan untuk saya?
Dialogue: 0,0:31:14.57,0:31:16.68,Default,Tolenka3,0,0,0,,Ternyata gara-gara kamu jantungku berdebar kencang?
Dialog: 0,0:31:17.48,0:31:19.85,Default,Tolenka3,0,0,0,,Apakah kamu kesempatan terakhirku untuk mengembalikan kekuatan pria?
Dialogue: 0,0:31:20.05,0:31:23.01,Default,Tolenka3,0,0,0,,Karenamu hatiku hancur setiap malam
Dialog: 0,0:31:24.05,0:31:25.52,Default,Tolenka3,0,0,0,,gemetar?
Dialog: 0,0:31:25.95,0:31:27.85,Default,Tolenka3,0,0,0,,Jadi inilah alasan perpisahan kalian.
Dialog: 0,0:31:29.22,0:31:30.32,Default,Tolenka3,0,0,0,,Kenapa kamu?
Dialogue: 0,0:31:30.56,0:31:32.22,Default,Tolenka3,0,0,0,,Kenapa selalu kamu?
Dialog: 0,0:31:32.22,0:31:34.43,Default,Tolenka3,0,0,0,,Bahkan dalam mimpiku kamu muncul di hadapanku!
Dialogue: 0,0:31:35.16,0:31:36.53,Default,Tolenka3,0,0,0,,Apakah aku muncul di hadapanmu dalam mimpimu?
Dialogue: 0,0:31:37.03,0:31:40.60,Default,Tolenka3,0,0,0,,Perhatikan bahasamu. Satu lagi kebodohan dan ini bisa dianggap sebuah pengakuan.
Dialogue: 0,0:31:40.90,0:31:42.73,Default,Tolenka3,0,0,0,,Mimpinya beda beda lho.
Dialog: 0,0:31:43.00,0:31:44.74,Default,Tolenka3,0,0,0,,Mimpi buruk, misalnya.
Dialog: 0,0:31:45.87,0:31:47.34,Default,Tolenka3,0,0,0,,Mengapa kamu membantuku di pesta itu?
Dialog: 0,0:31:49.54,0:31:51.71,Default,Tolenka3,0,0,0,,Ikuti saya untuk menanyakan hal ini?!
Dialog: 0,0:31:52.41,0:31:54.78,Default,Tolenka3,0,0,0,,Saya dapat berterima kasih. Sia-sia itu hanya membantu.
Dialog: 0,0:31:54.98,0:31:56.78,Default,Tolenka3,0,0,0,,Dia mengatakannya sendiri, bersumpah - jika kamu senang melihatnya,
Dialog: 0,0:31:56.78,0:31:59.15,Default,Tolenka3,0,0,0,,dan cari pertarungan, jika bersyukur.
Dialog: 0,0:31:59.28,0:32:01.52,Default,Tolenka3,0,0,0,,Kenapa kamu tiba-tiba memutuskan untuk mendengarkanku?
Dialog: 0,0:32:01.52,0:32:03.42,Default,Tolenka3,0,0,0,,Saya melakukannya sesuai keinginan Anda, tetapi Anda masih tidak puas?
Dialog: 0,0:32:03.92,0:32:06.06,Default,Tolenka3,0,0,0,,Apa yang kamu ingin aku lakukan?
Dialog: 0,0:32:06.49,0:32:08.73,Default,Tolenka3,0,0,0,,Kami menjauhkan diri, lalu tiba-tiba kamu membantu.
Dialog: 0,0:32:08.73,0:32:11.20,Default,Tolenka3,0,0,0,,Lalu kamu tiba-tiba menyatakan bahwa kamu akan dengan mudah mengkhianatiku.
Dialog: 0,0:32:11.86,0:32:13.23,Default,Tolenka3,0,0,0,,Ya, kalau begitu saya hanya...
Dialog: 0,0:32:15.23,0:32:16.27,Default,Tolenka3,0,0,0,,Tunggu sebentar.
Dialog: 0,0:32:18.34,0:32:20.34,Default,Tolenka3,0,0,0,,Jadi, apakah kamu mendengar semuanya?
Dialog: 0,0:32:22.47,0:32:24.58,Default,Tolenka3,0,0,0,,Ternyata dia berbohong tentang kehilangan pendengarannya?
Dialog: 0,0:32:25.68,0:32:26.81,Default,Tolenka3,0,0,0,,Sungguh...
Dialogue: 0,0:32:28.01,0:32:29.68,Default,Tolenka3,0,0,0,,Ternyata ledakan itu ulahmu?
Dialog: 0,0:32:30.62,0:32:32.62,Default,Tolenka3,0,0,0,,Saya benar-benar kehilangan pendengaran untuk sementara waktu.
Dialog: 0,0:32:33.22,0:32:35.95,Default,Tolenka3,0,0,0,,Tapi dia kembali tepat saat kamu mengucapkan kata-kata ini.
Dialog: 0,0:32:36.86,0:32:39.39,Default,Tolenka3,0,0,0,,Apakah kamu sudah gila? Anda bisa saja mati!
Dialogue: 0,0:32:39.55,0:32:40.40,Default,Tolenka3,0,0,0,,Ratuku!
Dialog: 0,0:32:40.50,0:32:42.55,Default,Tolenka3,0,0,0,,Mengapa mengambil risiko?!
Dialog: 0,0:33:02.21,0:33:04.58,Default,Tolenka3,0,0,0,,Apa? Ini adalah teknik terlarang!
Dialog: 0,0:33:04.88,0:33:07.52,Default,Tolenka3,0,0,0,,Kamu selalu memeluk, tersenyum, tidur di sampingku...
Dialog: 0,0:33:07.59,0:33:09.25,Default,Tolenka3,0,0,0,,Semua ini dilarang.
Dialog: 0,0:33:12.92,0:33:14.73,Default,Tolenka3,0,0,0,,Saya melarang Anda melarang saya.
Dialog: 0,0:33:25.34,0:33:27.24,Default,Tolenka3,0,0,0,,Aku cinta kamu.
Dialog: 0,0:33:32.31,0:33:33.48,Default,Tolenka3,0,0,0,,Sangat asmara?
Dialog: 0,0:33:33.78,0:33:36.21,Default,Tolenka3,0,0,0,,Semua karena satu malam yang dihabiskan bersama? \NAnda seharusnya tidak melakukan itu.
Dialog: 0,0:33:36.21,0:33:37.62,Default,Tolenka3,0,0,0,,Tidak, bukan itu alasannya.
Dialog: 0,0:33:37.62,0:33:39.25,Default,Tolenka3,0,0,0,,Lalu kenapa?
Dialog: 0,0:33:40.22,0:33:43.72,Default,Tolenka3,0,0,0,,Kamu sombong, narsis, kasar
Dialog: 0,0:33:43.89,0:33:45.16,Default,Tolenka3,0,0,0,,dan berubah-ubah.
Dialogue: 0,0:33:45.59,0:33:47.09,Default,Tolenka3,0,0,0,,Kamu punya banyak kekurangan.
Dialog: 0,0:33:47.73,0:33:50.60,Default,Tolenka3,0,0,0,,Itulah intinya. Jadi jangan mencintaiku.
Dialog: 0,0:33:50.60,0:33:52.53,Default,Tolenka3,0,0,0,,Tapi aku tetap mencintaimu.
Dialog: 0,0:33:53.67,0:33:56.57,Default,Tolenka3,0,0,0,,Dan aku akan senang, biarkan kamu memilikinya
Dialog: 0,0:33:57.44,0:33:58.97,Default,Tolenka3,0,0,0,,semua kekurangan dunia.
Dialog: 0,0:34:09.85,0:34:10.95,Default,Tolenka3,0,0,0,,Ingat apa yang saya katakan
Dialog: 0,0:34:13.29,0:34:14.82,Default,Tolenka3,0,0,0,,malam sebelumnya,
Dialog: 0,0:34:16.02,0:34:17.39,Default,Tolenka3,0,0,0,,bagaimana cara melompat ke kolam?
Dialogue: 0,0:34:19.29,0:34:21.43,Default,Tolenka3,0,0,0,,Kamu pasti mencintaiku.
Dialog: 0,0:34:24.20,0:34:26.46,Default,Tolenka3,0,0,0,,Saya mengatakan ini karena menurut saya saat itu
Dialog: 0,0:34:26.46,0:34:27.90,Default,Tolenka3,0,0,0,,hanya aku yang bisa melindungimu.
Dialog: 0,0:34:29.03,0:34:31.84,Default,Tolenka3,0,0,0,,Karena saya pikir tidak ada cara lain untuk membantu Anda.
Dialog: 0,0:34:32.20,0:34:34.71,Default,Tolenka3,0,0,0,,Bahwa inilah satu-satunya cara untuk menyelamatkan kamu dan aku.
Dialog: 0,0:34:35.97,0:34:37.44,Default,Tolenka3,0,0,0,,Jadi ini alasannya?
Dialog: 0,0:34:37.44,0:34:38.54,Default,Tolenka3,0,0,0,,Tapi tahukah Anda?
Dialog: 0,0:34:39.88,0:34:42.68,Default,Tolenka3,0,0,0,,Kim So-yeon itu sudah tiada.
Dialog: 0,0:34:44.05,0:34:45.98,Default,Tolenka3,0,0,0,,Ta Kim So-yeon meninggal malam itu.
Dialog: 0,0:34:49.49,0:34:52.02,Default,Tolenka3,0,0,0,,Aku tidak akan menyakitimu lagi.
Dialog: 0,0:34:54.53,0:34:56.33,Default,Tolenka3,0,0,0,,Kita tidak punya masa depan.
Dialog: 0,0:34:59.06,0:35:00.57,Default,Tolenka3,0,0,0,,Karena aku tidak akan pernah memaafkanmu.
Dialog: 0,0:35:03.94,0:35:05.90,Default,Tolenka3,0,0,0,,Saya bukan Kim So-yeon.
Dialog: 0,0:35:06.30,0:35:08.61,Default,Tolenka3,0,0,0,,Oleh karena itu, saya tidak punya hak.
Dialog: 0,0:35:26.26,0:35:29.46,Default,Tolenka3,0,0,0,,Orang apa. Apakah Yang Mulia memerlukan sesuatu?
Dialog: 0,0:35:30.50,0:35:33.30,Default,Tolenka3,0,0,0,,-Terima kasih atas bantuan Anda. \N-Bantuan?
Dialog: 0,0:35:34.53,0:35:35.97,Default,Tolenka3,0,0,0,,Di rumah sakit istana.
Dialog: 0,0:35:36.03,0:35:38.64,Default,Tolenka3,0,0,0,,Ah, itu saja, aku hanya...
Dialog: 0,0:35:38.64,0:35:41.24,Default,Tolenka3,0,0,0,,Aku memberimu air beracun.
Dialog: 0,0:35:42.47,0:35:45.51,Default,Tolenka3,0,0,0,,Baiklah, tapi mereka juga memesan akupunktur dengan moksibusi.
Dialog: 0,0:35:46.24,0:35:48.85,Default,Tolenka3,0,0,0,,Dan oleh karena itu saya harus berterima kasih.
Dialog: 0,0:35:51.92,0:35:53.05,Default,Tolenka3,0,0,0,,Ditemukan di jalan.
Dialog: 0,0:35:55.09,0:35:56.25,Default,Tolenka3,0,0,0,,Tapi...
Dialog: 0,0:36:02.83,0:36:06.23,Default,Tolenka3,0,0,0,,Di mana dia menemukan barang semahal itu?
Dialog: 0,0:36:11.24,0:36:12.94,Default,Kus4,0,0,0,,Mencoba raja?
Dialogue: 0,0:36:13.34,0:36:16.04,Default,Kus4,0,0,0,,Mengapa Anda tidak berkonsultasi dengan kami sebelum memulai ini?
Dialogue: 0,0:36:16.04,0:36:17.88,Default,Kus4,0,0,0,,Lihat apa akibatnya.
Dialog: 0,0:36:17.88,0:36:21.61,Default,Kus4,0,0,0,,Kim Jwageun pasti sudah mencapai batasnya.
Dialog: 0,0:36:31.76,0:36:33.39,Default,Kus4,0,0,0,,Saya mengerti, Anda menginginkan uang,
Dialogue: 0,0:36:33.39,0:36:34.79,Default,Kus4,0,0,0,,tapi jual senjata kita?
Dialog: 0,0:36:35.09,0:36:36.80,Default,Kus4,0,0,0,,Apakah kamu mencoba menghancurkan negara ini?
Dialog: 0,0:36:36.80,0:36:38.73,Default,Kus4,0,0,0,,Anda sudah menjelaskan bahwa tidak ada masalah.
Dialogue: 0,0:36:39.03,0:36:41.97,Default,Kus4,0,0,0,,Kamu membutuhkan orang untuk mencapai tujuanmu.
Dialog: 0,0:36:41.97,0:36:43.97,Default,Kus4,0,0,0,,Dan untuk ini kita butuh uang.
Dialogue: 0,0:36:45.17,0:36:47.54,Default,Kus4,0,0,0,,Maksudmu kamu melakukan ini untukku?
Dialogue: 0,0:36:47.54,0:36:50.81,Default,Kus4,0,0,0,,Saya ingin menampilkan hasilnya tanpa mengganggu proses itu sendiri.
Dialog: 0,0:36:50.81,0:36:52.24,Default,Kus4,0,0,0,,Saya melakukan segalanya untuk ini!
Dialog: 0,0:36:52.68,0:36:54.21,Default,Kus4,0,0,0,,Aku mencoba untukmu
Dialog: 0,0:36:54.48,0:36:58.18,Default,Kus4,0,0,0,,dan demi jenis kita.
Dialog: 0,0:37:00.85,0:37:01.92,Default,Kus4,0,0,0,,Bersiaplah
Dialog: 0,0:37:01.92,0:37:04.96,Default,Kus4,0,0,0,,bertanggung jawab jika tidak ada jalan lain.
Dialog: 0,0:37:10.80,0:37:12.76,Default,Kus4,0,0,0,,Aku akan memberimu kesempatan untuk menebus dosa.
Dialog: 0,0:37:21.54,0:37:24.14,Default,Kus4,0,0,0,,-Apakah semuanya sudah tiba?\N-Tn.
Dialog: 0,0:37:25.31,0:37:28.25,Default,Kus4,0,0,0,,Ayah ratu belum ada.
Dialog: 0,0:37:29.58,0:37:31.12,Default,Kus4,0,0,0,,Dia tidak diundang.
Dialog: 0,0:37:31.52,0:37:34.99,Default,Kus4,0,0,0,,Kita berkumpul disini karena kesalahannya.
Dialog: 0,0:37:35.39,0:37:37.52,Default,Kus4,0,0,0,,Dia menyimpan catatan properti,
Dialog: 0,0:37:38.59,0:37:40.43,Default,Kus4,0,0,0,,milik keluarga kita.
Dialog: 0,0:37:44.80,0:37:49.00,Default,Kus4,0,0,0,,Untungnya saya punya buku akuntansi ini.
Dialog: 0,0:37:50.54,0:37:54.31,Default,Kus4,0,0,0,,Selama pengaruhku masih ada, dia tidak berguna,
Dialog: 0,0:37:54.31,0:37:55.64,Default,Kus4,0,0,0,,dan Anda tidak perlu khawatir.
Dialog: 0,0:37:57.68,0:37:58.71,Default,Kus4,0,0,0,,Tapi
Dialogue: 0,0:37:59.28,0:38:02.48,Default,Kus4,0,0,0,,segera setelah aku kehilangan pengaruhku,
Dialogue: 0,0:38:05.02,0:38:07.09,Default,Kus4,0,0,0,,Saya tidak bisa melindungi bukunya.
Dialog: 0,0:38:10.36,0:38:12.62,Default,Kus4,0,0,0,,Jika kamu melindungiku,
Dialog: 0,0:38:13.12,0:38:15.23,Default,Kus4,0,0,0,,Aku akan melindungimu sebagai balasannya.
Dialogue: 0,0:38:15.93,0:38:18.23,Default,Kus4,0,0,0,,Jika kami memutuskan untuk melindungimu,
Dialog: 0,0:38:18.66,0:38:19.80,Default,Kus4,0,0,0,,apa
Dialog: 0,0:38:21.03,0:38:23.00,Default,Kus4,0,0,0,,maukah kamu lakukan dengan raja?
Dialog: 0,0:38:23.97,0:38:25.27,Default,Kus4,0,0,0,,Jika kita tidak melakukan apa pun,
Dialog: 0,0:38:25.27,0:38:28.81,Default,Kus4,0,0,0,,dia akan mengusir kami karena kami tidak mencopotmu dari posisimu.
Dialog: 0,0:38:29.87,0:38:32.91,Default,Kus4,0,0,0,,Dewan dibentuk untuk menyelesaikan masalah pemerintahan.
Dialog: 0,0:38:35.25,0:38:36.45,Default,Kus4,0,0,0,,Dewan Keamanan Perbatasan?
Dialog: 0,0:38:37.08,0:38:39.45,Default,Kus4,0,0,0,,Raja yang tidak kompeten mengambil alih kekuasaan ke tangannya sendiri -
Dialog: 0,0:38:39.45,0:38:41.45,Default,Kus4,0,0,0,,masalah keadaan serius.
Dialog: 0,0:38:42.52,0:38:44.72,Default,Kus4,0,0,0,,Semua keputusan kebijakan
Dialog: 0,0:38:45.99,0:38:48.43,Default,Kus4,0,0,0,,akan dipertimbangkan oleh Dewan Perlindungan Perbatasan.
Dialog: 0,0:38:50.76,0:38:52.26,Default,Kus4,0,0,0,,semuanya sudah aku siapkan.
Dialog: 0,0:38:52.60,0:38:55.60,Default,Kus4,0,0,0,,Seperti yang Anda katakan, kami membekukan air dengan arsenik di dalamnya.
Dialog: 0,0:38:55.60,0:38:58.17,Default,Kus4,0,0,0,,Saat es mencair, keluar arsenik.
Dialogue: 0,0:38:58.17,0:39:00.67,Default,Kus4,0,0,0,,Berapa lama arsenik larut?
Dialog: 0,0:39:01.27,0:39:02.91,Default,Kus4,0,0,0,,Tergantung cuaca,
Dialog: 0,0:39:03.24,0:39:05.38,Default,Kus4,0,0,0,,tapi dalam teh tidak akan memakan banyak waktu.
Dialog: 0,0:39:06.78,0:39:07.85,Default,Kus4,0,0,0,,Begitu.
Dialogue: 0,0:39:08.45,0:39:12.08,Default,Kus4,0,0,0,,Ngomong-ngomong, boleh tahu siapa targetmu?
Dialog: 0,0:39:12.98,0:39:15.62,Default,Kus4,0,0,0,,Jika aku menyingkirkan satu wanita di istana,
Dialog: 0,0:39:15.85,0:39:18.92,Default,Kus4,0,0,0,,dua orang yang mengancam posisiku akan dipatahkan.
Dialog: 0,0:39:34.47,0:39:36.17,Default,Kus4,0,0,0,,Terima kasih sudah berdiri.
Dialogue: 0,0:39:37.51,0:39:40.55,Default,Kus4,0,0,0,,Kau menanggung siksaan yang begitu menyakitkan.
Dialog: 0,0:39:41.91,0:39:43.08,Default,Kus4,0,0,0,,Saya tidak akan melupakan ini.
Dialog: 0,0:39:45.12,0:39:48.89,Default,Kus4,0,0,0,,Sekarang kamu sudah ketahuan, berbahaya jika tetap berada di istana.
Dialog: 0,0:39:49.82,0:39:51.29,Default,Kus4,0,0,0,,Tinggalkan istana.
Dialog: 0,0:39:52.49,0:39:54.79,Default,Kus4,0,0,0,,Saatnya kau menjalani hidupmu.
Dialog: 0,0:40:44.98,0:40:46.44,Default,Kus4,0,0,0,,Aku akan melakukan segalanya
Dialog: 0,0:40:51.08,0:40:52.58,Default,Kus4,0,0,0,,untuk mewujudkan impianmu.
Dialog: 0,0:41:14.91,0:41:16.24,Default,Kus4,0,0,0,,Entah kenapa menjadi kosong.
Dialog: 0,0:41:18.01,0:41:20.55,Default,Kus4,0,0,0,,Siapa di antara kalian yang masih ingin...
Dialog: 0,0:41:22.68,0:41:23.75,Default,Kus4,0,0,0,,Kamu di sini.
Dialogue: 0,0:41:47.11,0:41:48.54,Default,Kus4,0,0,0,,Saya harus taruh
Dialog: 0,0:41:49.67,0:41:53.24,Default,Kus4,0,0,0,,es batu heksagonal di mangkuk ratu?
Dialog: 0,0:41:54.65,0:41:55.68,Default,Kus4,0,0,0,,Ya.
Dialog: 0,0:42:00.08,0:42:02.35,Default,Kus4,0,0,0,,Tambahkan saja es batu. Ini semua.
Dialog: 0,0:42:15.50,0:42:16.53,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:42:17.44,0:42:21.31,Default,Kus4,0,0,0,,Saya mempunyai informasi yang sangat penting.
Dialog: 0,0:42:21.94,0:42:24.44,Default,Kus4,0,0,0,,Tolong bantu saya.
Dialog: 0,0:42:25.31,0:42:27.35,Default,Kus4,0,0,0,,Apa yang kamu dapatkan disana?
Dialog: 0,0:42:27.71,0:42:30.62,Default,Kus4,0,0,0,,Jika kamu berjanji untuk mengampuniku...
Dialog: 0,0:42:31.18,0:42:32.85,Default,Kus4,0,0,0,,Beraninya kamu?
Dialog: 0,0:42:33.25,0:42:34.32,Default,Kus4,0,0,0,,Nyonya Khan.
Dialog: 0,0:42:37.46,0:42:41.53,Default,Kus4,0,0,0,,Aku tahu kamu gadis pemberani, tapi sekarang kamu gemetar ketakutan.
Dialog: 0,0:42:42.63,0:42:44.53,Default,Kus4,0,0,0,,Saya tidak tahu apa yang Anda miliki di sana,
Dialogue: 0,0:42:45.23,0:42:47.60,Default,Kus4,0,0,0,,tapi aku akan membantumu semampuku.
Dialog: 0,0:42:50.00,0:42:52.84,Default,Kus4,0,0,0,,Kim Jwageun bertanya padaku...
Dialogue: 0,0:42:56.71,0:42:58.91,Default,Kus4,0,0,0,,Kenapa dia tidak menyukainya sejak awal?
Dialog: 0,0:42:59.44,0:43:01.31,Default,Kus4,0,0,0,,Maka Kim So-yeon tidak akan mencoba mati.
Dialog: 0,0:43:01.31,0:43:02.88,Default,Kus4,0,0,0,,Dan saya tidak akan berada di sini.
Dialog: 0,0:43:04.88,0:43:06.25,Default,Kus4,0,0,0,,Tetapi yang lebih penting,
Dialog: 0,0:43:11.59,0:43:14.16,Default,Kus4,0,0,0,,Saya pikir saya telah mengalami segala kemungkinan.
Dialog: 0,0:43:16.09,0:43:18.60,Default,Kus4,0,0,0,,Tapi ternyata ada yang belum saya temui.
Dialog: 0,0:43:19.46,0:43:21.47,Default,Kus4,0,0,0,,Bagaimana menjelaskan perasaan tadi malam?
Dialog: 0,0:43:23.77,0:43:26.94,Default,Kus4,0,0,0,,Jika sebelumnya seperti sepotong roti yang lembut,
Dialog: 0,0:43:26.94,0:43:28.17,Default,Kus4,0,0,0,,lalu...
Dialog: 0,0:43:31.21,0:43:35.05,Default,Kus4,0,0,0,,Tidak, itu baru. \NI tertarik pada sesuatu yang baru.
Dialog: 0,0:43:35.58,0:43:37.08,Default,Kus4,0,0,0,,Sadarlah, Chan So-yeon.
Dialog: 0,0:43:38.02,0:43:41.02,Default,Kus4,0,0,0,,Sialan. Aku bahkan bingung menyebutkan namanya.
Dialog: 0,0:43:42.29,0:43:43.39,Default,Kus4,0,0,0,,Ratu.
Dialog: 0,0:43:44.52,0:43:45.99,Default,Kus4,0,0,0,,Ya. Masuk.
Dialog: 0,0:43:51.40,0:43:55.13,Default,Kus4,0,0,0,,Janda Ratu memintamu untuk sarapan bersama.
Dialog: 0,0:43:56.23,0:43:58.67,Default,Kus4,0,0,0,,Sarapan jam segini?
Dialog: 0,0:44:00.61,0:44:04.14,Default,Kus4,0,0,0,,Aku sedang tidak mood untuk memasak sekarang.
Dialogue: 0,0:44:07.38,0:44:11.82,Default,Kus4,0,0,0,,Janda Ratu sudah menyiapkan semuanya.
Dialog: 0,0:44:13.42,0:44:14.82,Default,Kus4,0,0,0,,Apakah saya akan pergi ke Aula Dongmyeongjong?
Dialogue: 0,0:44:15.19,0:44:17.09,Default,Kus4,0,0,0,,Aku berlari seharian hari ini - jadi aku lapar.
Dialog: 0,0:44:18.86,0:44:20.66,Default,Kus4,0,0,0,,Mereka ingin menyingkirkan ratu?
Dialogue: 0,0:44:21.49,0:44:23.76,Default,Kus4,0,0,0,,Buku akuntansi kini ada pada Kim Jwagyn.
Dialog: 0,0:44:24.40,0:44:25.90,Default,Kus4,0,0,0,,Siapa yang tahu dia ada di Aula Daejojong?
Dialog: 0,0:44:26.36,0:44:27.53,Default,Kus4,0,0,0,,Bagaimana...
Dialogue: 0,0:44:28.63,0:44:30.07,Default,Kus4,0,0,0,,Aku akan kembali ke istana.
Dialog: 0,0:44:36.01,0:44:37.07,Default,Kus4,0,0,0,,Di Sini.
Dialog: 0,0:44:52.19,0:44:53.96,Default,Kus4,0,0,0,,Kenapa buntu? Ayo cepat!
Dialogue: 0,0:44:53.96,0:44:55.13,Default,Kus4,0,0,0,,Aku datang.
Dialogue: 0,0:45:06.77,0:45:08.97,Default,Kus4,0,0,0,,Kau tinggalkan aku lagi.
Dialog: 0,0:45:10.44,0:45:14.25,Default,Kus4,0,0,0,,Kau tahu, Imp, aku mulai marah padamu.
Dialog: 0,0:45:29.23,0:45:31.13,Default,Kus4,0,0,0,,Terima kasih Yang Mulia.
Dialog: 0,0:45:32.00,0:45:34.73,Default,Kus4,0,0,0,,Sarapan, dan dengan pemandangan yang begitu indah.
Dialog: 0,0:45:35.00,0:45:38.20,Default,Kus4,0,0,0,,Saya sudah bukan bupati lagi, jadi saya punya banyak waktu luang.
Dialogue: 0,0:45:38.54,0:45:40.84,Default,Kus4,0,0,0,,Kita harus lebih sering sarapan bersama.
Dialog: 0,0:45:41.47,0:45:43.54,Default,Kus4,0,0,0,,Ya, Yang Mulia.
Dialog: 0,0:45:51.82,0:45:54.49,Default,Kus4,0,0,0,,Sarapan tidak bisa tanpa minuman.
Dialog: 0,0:45:59.16,0:46:03.06,Default,Kus4,0,0,0,,Yang akan mati di istana hari ini adalah ratu.
Dialog: 0,0:46:06.30,0:46:07.77,Default,Kus4,0,0,0,,Anakku,
Dialog: 0,0:46:08.73,0:46:11.14,Default,Kus4,0,0,0,,Akhirnya aku bisa membalas dendam.
Dialog: 0,0:47:16.53,0:47:18.54,Default,Kus4,0,0,0,,Saya khusus menyiapkan esnya,
Dialog: 0,0:47:18.54,0:47:21.61,Default,Kus4,0,0,0,,yang lebih mahal dari emas saat ini.
Dialog: 0,0:47:26.48,0:47:28.08,Default,Kus4,0,0,0,,Saya akan melihat es di sini untuk pertama kalinya.
Dialogue: 0,0:47:28.68,0:47:31.15,Default,Kus4,0,0,0,,Hari ini panas sekali,
Dialog: 0,0:47:31.18,0:47:34.32,Default,Kus4,0,0,0,,waktu ideal untuk minum dingin.
Dialog: 0,0:47:44.86,0:47:47.63,Default,Kus4,0,0,0,,Ratuku. Silakan.
Dialogue: 0,0:47:47.77,0:47:49.10,Default,Kus4,0,0,0,,aku mohon. Ratuku.
Dialog: 0,0:48:11.30,0:48:12.43,Default,Kus4,0,0,0,,Beraninya kamu...
Dialog: 0,0:48:12.53,0:48:17.44,Default,Kus4,0,0,0,,Aku harus memberitahu ratu sesuatu.
Dialogue: 0,0:48:17.54,0:48:19.10,Default,Kus4,0,0,0,,Beraninya kamu kesini? Meninggalkan.
Dialog: 0,0:48:19.10,0:48:21.01,Default,Kus4,0,0,0,,Ini sangat penting.
Dialog: 0,0:48:22.67,0:48:23.77,Default,Kus4,0,0,0,,Damhyan?
Dialog: 0,0:48:24.04,0:48:25.84,Default,Kus4,0,0,0,,Kenapa kamu melakukan ini?
Dialog: 0,0:48:25.84,0:48:27.98,Default,Kus4,0,0,0,,Aku akan mendapat masalah karenamu.
Dialog: 0,0:48:28.91,0:48:31.05,Default,Kus4,0,0,0,,Apa yang penting?
Dialog: 0,0:48:36.82,0:48:38.62,Default,Kus4,0,0,0,,Apakah kamu kenal nyonya istana ini?
Dialog: 0,0:48:40.29,0:48:43.09,Default,Kus4,0,0,0,,Ya. Saya sering melihatnya di dapur kerajaan.
Dialog: 0,0:48:44.86,0:48:47.06,Default,Kus4,0,0,0,,Damhyan, apa yang terjadi?
Dialog: 0,0:48:47.67,0:48:49.10,Default,Kus4,0,0,0,,Soalnya...
Dialogue: 0,0:48:53.27,0:48:54.94,Default,Kus4,0,0,0,,Kamu lihat...
Dialog: 0,0:49:01.75,0:49:02.81,Default,Kus4,0,0,0,,maafkan aku.
Dialog: 0,0:49:19.60,0:49:22.77,Default,Kus4,0,0,0,,Saya datang untuk menghadiri jamuan makan ratu janda.
Dialog: 0,0:49:23.73,0:49:26.34,Default,Kus4,0,0,0,,Ini adalah pertemuan wanita. Anda tidak perlu datang.
Dialog: 0,0:49:27.40,0:49:30.51,Default,Kus4,0,0,0,,Ini pertama kalinya aku melihat ratu di pertemuan seperti itu.
Dialogue: 0,0:49:31.08,0:49:32.34,Default,Kus4,0,0,0,,Mohon maaf.
Dialogue: 0,0:49:33.78,0:49:35.98,Default,Kus4,0,0,0,,Suatu kehormatan buat saya.
Dialogue: 0,0:49:36.31,0:49:39.42,Default,Kus4,0,0,0,,Bagaimana dengan pengawasan suamimu?
Dialog: 0,0:49:46.02,0:49:48.23,Default,Kus4,0,0,0,,Sekarang raja sudah bangun,
Dialog: 0,0:49:48.33,0:49:50.43,Default,Kus4,0,0,0,,Saya akan melakukan yang terbaik.
Dialog: 0,0:49:52.93,0:49:55.57,Default,Kus4,0,0,0,,Kita perlu minum sebelum es yang berharga mencair.
Dialog: 0,0:50:06.88,0:50:08.15,Default,Kus4,0,0,0,,Bagaimana kamu menyukainya?
Dialog: 0,0:50:09.35,0:50:10.92,Default,Kus4,0,0,0,,Rasanya menyegarkan sekali.
Dialog: 0,0:50:14.85,0:50:16.42,Default,Kus4,0,0,0,,Saya sangat menyukainya sehingga saya tidak dapat menolaknya.
Dialogue: 0,0:50:58.23,0:50:59.33,Default,Kus4,0,0,0,,Ratuku!
Dialog: 0,0:51:10.47,0:51:11.54,Default,Kus4,0,0,0,,Yang Mulia!
Dialog: 0,0:51:16.91,0:51:18.12,Default,Kus4,0,0,0,,Beraninya kamu?
Dialogue: 0,0:51:18.38,0:51:20.45,Default,Kus4,0,0,0,,Apa yang kamu lakukan disini?
Dialog: 0,0:51:23.35,0:51:25.99,Default,Kus4,0,0,0,,-Apakah kamu baik-baik saja?\N-Apa? Ya.
Dialogue: 0,0:51:26.12,0:51:28.63,Default,Kus4,0,0,0,,Beraninya kau melempar batu ke arah ratu?
Dialog: 0,0:51:30.33,0:51:32.06,Default,Kus4,0,0,0,,Saya baik-baik saja, Yang Mulia.
Dialogue: 0,0:51:38.14,0:51:40.17,Default,Kus4,0,0,0,,Bawa gadis ini ke tahanan.
Dialog: 0,0:51:40.84,0:51:42.87,Default,Kus4,0,0,0,,Dia akan dihukum atas perbuatannya.
Dialog: 0,0:51:45.24,0:51:46.28,Default,Kus4,0,0,0,,Yang Mulia.
Dialog: 0,0:51:48.78,0:51:49.88,Default,Kus4,0,0,0,,Ikut aku.
Dialog: 0,0:51:51.32,0:51:52.42,Default,Kus4,0,0,0,,Damhyan.
Dialog: 0,0:52:01.93,0:52:03.49,Default,Kus4,0,0,0,,Dia sangat penting bagiku.
Dialog: 0,0:52:03.53,0:52:06.76,Default,Kus4,0,0,0,,Aku baik-baik saja, jadi jangan marah.
Dialog: 0,0:52:06.76,0:52:08.73,Default,Kus4,0,0,0,,Ini tidak ada hubungannya denganmu.
Dialog: 0,0:52:09.20,0:52:11.54,Default,Kus4,0,0,0,,Dia membuat kekacauan di istana
Dialog: 0,0:52:11.54,0:52:13.67,Default,Kus4,0,0,0,,dan melanggar perintah yang telah ditetapkan.
Dialog: 0,0:52:14.74,0:52:16.37,Default,Kus4,0,0,0,,Dia masih anak-anak.
Dialog: 0,0:52:16.81,0:52:18.41,Default,Kus4,0,0,0,,Aku yakin dia punya alasan.
Dialog: 0,0:52:18.41,0:52:20.04,Default,Kus4,0,0,0,,Dia tidak akan melakukannya tanpa alasan.
Dialog: 0,0:52:20.04,0:52:21.65,Default,Kus4,0,0,0,,Jika terus seperti ini,
Dialog: 0,0:52:21.65,0:52:23.71,Default,Kus4,0,0,0,,Saya akan menuduhnya melakukan perilaku yang tidak pantas
Dialog: 0,0:52:23.71,0:52:25.62,Default,Kus4,0,0,0,,dan aku akan menghukummu lebih berat lagi.
Dialog: 0,0:52:30.35,0:52:32.42,Default,Kus4,0,0,0,,Kenapa kamu datang terburu-buru?
Dialog: 0,0:52:33.19,0:52:37.19,Default,Kus4,0,0,0,,Tahukah kamu kalau anak itu akan mencoba menyakiti ratu?
Dialogue: 0,0:52:39.10,0:52:40.96,Default,Kus4,0,0,0,,Apakah kamu mencoba menyeretku ke dalam hal ini?
Dialog: 0,0:52:41.07,0:52:44.74,Default,Kus4,0,0,0,,Hanya saja waktu kedatanganmu bertepatan dengan sempurna.
Dialog: 0,0:52:44.77,0:52:46.40,Default,Kus4,0,0,0,,Saya khawatir,
Dialogue: 0,0:52:46.40,0:52:48.91,Default,Kus4,0,0,0,,bahwa orang yang merencanakan makar,
Dialog: 0,0:52:48.91,0:52:50.54,Default,Kus4,0,0,0,,letaknya di sebelah ratu.
Dialog: 0,0:52:51.08,0:52:52.74,Default,Kus4,0,0,0,,Rapat ini hancur.
Dialog: 0,0:52:53.24,0:52:54.71,Default,Kus4,0,0,0,,Saya akan kembali ke Dongmyeongjong.
Dialog: 0,0:53:06.96,0:53:09.86,Default,Kus4,0,0,0,,Saya pasti akan menghukum anak itu karena melanggar rencana kita.
Dialog: 0,0:53:10.46,0:53:12.50,Default,Kus4,0,0,0,,Anda juga akan bertanggung jawab,
Dialog: 0,0:53:12.93,0:53:14.80,Default,Kus4,0,0,0,,agar tidak membahayakan keluarga kita.
Dialog: 0,0:53:22.27,0:53:23.44,Default,Nanas5,0,0,0,,Apa yang akan terjadi padanya sekarang?
Dialogue: 0,0:53:23.54,0:53:26.21,Default,Nanas5,0,0,0,,Mereka tidak akan memukul gadis itu, bukan?
Dialog: 0,0:53:26.41,0:53:28.08,Default,Nanas5,0,0,0,,Apakah kamu yakin baik-baik saja?
Dialogue: 0,0:53:28.08,0:53:30.88,Default,Nanas5,0,0,0,,Mungkin lidahmu mati rasa atau jantungmu berdebar kencang?
Dialog: 0,0:53:32.05,0:53:33.68,Default,Nanas5,0,0,0,,Apa yang kamu bicarakan?\NBenarkah...
Dialog: 0,0:53:33.68,0:53:35.09,Default,Nanas5,0,0,0,,Tidak di sini.
Dialog: 0,0:53:36.19,0:53:38.06,Default,Nanas5,0,0,0,,Ratu dan aku akan pergi ke Daejojon.
Dialog: 0,0:53:38.66,0:53:39.96,Default,Nanas5,0,0,0,,Ya pak.
Dialog: 0,0:53:55.34,0:53:57.34,Default,Nanas5,0,0,0,,Tolong, mulai sekarang
Dialog: 0,0:53:57.91,0:54:00.51,Default,Nanas5,0,0,0,,perhatikan semua yang kamu makan atau minum.
Dialog: 0,0:54:01.35,0:54:03.25,Default,Nanas5,0,0,0,,Apakah saya mengganggu seseorang?
Dialog: 0,0:54:06.18,0:54:09.99,Default,Nanas5,0,0,0,,Saya yakin Kim Jwageun dan Janda Ratu mencoba meracuni Anda.
Dialog: 0,0:54:11.32,0:54:14.36,Default,Nanas5,0,0,0,,Omong kosong. Saya tidak melakukan apa pun!
Dialog: 0,0:54:16.86,0:54:20.40,Default,Nanas5,0,0,0,,Atau itu semua karena aku membantu pestanya?
Dialog: 0,0:54:21.27,0:54:22.67,Default,Nanas5,0,0,0,,Ditemukan di kamarmu
Dialog: 0,0:54:24.23,0:54:25.94,Default,Nanas5,0,0,0,,buku akun.
Dialog: 0,0:54:26.97,0:54:28.01,Default,Nanas5,0,0,0,,Buku akun?
Dialog: 0,0:54:30.61,0:54:33.34,Default,Nanas5,0,0,0,,Jadi Kim Jwageun dan ayahku bertanya padaku tentang dia.
Dialog: 0,0:54:34.24,0:54:36.25,Default,Nanas5,0,0,0,,Apa yang salah dengan buku ini?
Dialogue: 0,0:54:37.28,0:54:39.42,Default,Nanas5,0,0,0,,Kamu tidak membawanya dari rumah?
Dialog: 0,0:54:40.02,0:54:41.62,Default,Nanas5,0,0,0,,Ya, saya tidak tahu kalau dia ada.
Dialog: 0,0:54:41.62,0:54:44.02,Default,Nanas5,0,0,0,,Aku belum pernah melihatnya di rumah, dan terlebih lagi di sini.
Dialog: 0,0:54:45.82,0:54:47.02,Default,Nanas5,0,0,0,,Begitulah adanya.
Dialog: 0,0:54:47.83,0:54:49.79,Default,Nanas5,0,0,0,,Mereka ingin meracuni, bukan menggulingkan.
Dialogue: 0,0:54:51.73,0:54:53.66,Default,Nanas5,0,0,0,,Jadi Damhyang menyelamatkanku?
Dialog: 0,0:54:54.13,0:54:55.20,Default,Nanas5,0,0,0,,Ternyata seperti ini.
Dialog: 0,0:54:55.43,0:54:56.90,Default,Nanas5,0,0,0,,Racun dalam minuman.
Dialog: 0,0:54:58.07,0:55:00.10,Default,Nanas5,0,0,0,,Aku meneguknya beberapa kali.
Dialog: 0,0:55:00.44,0:55:03.24,Default,Nanas5,0,0,0,,Aku akan mencari tahu semuanya dari Damhyang.
Dialog: 0,0:55:03.57,0:55:05.01,Default,Nanas5,0,0,0,,Aku akan menanyakannya sendiri.
Dialog: 0,0:55:05.34,0:55:07.85,Default,Nanas5,0,0,0,,Apakah dia akan baik-baik saja?\NSDia seharusnya tidak terluka.
Dialog: 0,0:55:08.21,0:55:10.35,Default,Nanas5,0,0,0,,Orang yang berencana meracunimu,
Dialog: 0,0:55:10.35,0:55:11.88,Default,Nanas5,0,0,0,,tidak akan membiarkannya pergi begitu saja.
Dialog: 0,0:55:14.45,0:55:16.49,Default,Nanas5,0,0,0,,Selamatkan dia, aku mohon.
Dialog: 0,0:55:22.16,0:55:23.79,Default,Nanas5,0,0,0,,Saya akan melakukan yang terbaik.
Dialog: 0,0:56:17.18,0:56:20.15,Default,Nanas5,0,0,0,,Saya tidak melakukan kejahatan apa pun.
Dialog: 0,0:56:20.78,0:56:22.22,Default,Nanas5,0,0,0,,Saya tidak mencuri uang ini.
Dialogue: 0,0:56:23.05,0:56:25.49,Default,Nanas5,0,0,0,,Saya sudah menyimpannya selama bertahun-tahun,
Dialogue: 0,0:56:25.49,0:56:27.32,Default,Nanas5,0,0,0,,untuk menebus si bungsu dari perbudakan.
Dialog: 0,0:56:32.20,0:56:33.30,Default,Nanas5,0,0,0,,Mohon ampun.
Dialog: 0,0:56:34.46,0:56:36.93,Default,Nanas5,0,0,0,,Jika aku mati, anak bungsuku...
Dialog: 0,0:56:42.64,0:56:44.11,Default,Nanas5,0,0,0,,Ucapkan semua yang kamu tahu
Dialog: 0,0:56:45.91,0:56:47.11,Default,Nanas5,0,0,0,,tentang norig ini.
Dialog: 0,0:57:02.73,0:57:04.90,Default,Nanas5,0,0,0,,-Damhyang!\N-Yang Mulia!
Dialog: 0,0:57:06.03,0:57:08.10,Default,Nanas5,0,0,0,,Apakah kamu baik-baik saja, ratu?
Dialog: 0,0:57:08.10,0:57:09.90,Default,Nanas5,0,0,0,,Saya perlu menanyakan ini kepada Anda.
Dialogue: 0,0:57:10.30,0:57:12.04,Default,Nanas5,0,0,0,,Sungguh berkah kamu mencobanya
Dialog: 0,0:57:12.47,0:57:16.24,Default,Nanas5,0,0,0,,minum sebelum es mencair.
Dialog: 0,0:57:17.98,0:57:18.98,Default,Nanas5,0,0,0,,Es?
Dialog: 0,0:57:20.41,0:57:21.71,Default,Nanas5,0,0,0,,Terjemahkan dia sekarang!
Dialog: 0,0:57:21.71,0:57:22.71,Default,Nanas5,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:57:25.52,0:57:27.99,Default,Nanas5,0,0,0,,Kemana kamu memindahkannya? Di mana?
Dialog: 0,0:57:32.26,0:57:34.56,Default,Nanas5,0,0,0,,Yang Mulia, Anda seharusnya tidak berada di sini.
Dialog: 0,0:57:34.99,0:57:37.19,Default,Nanas5,0,0,0,,Kamu tahu bahwa dia tidak bisa disalahkan atas apa pun.
Dialog: 0,0:57:37.19,0:57:38.60,Default,Nanas5,0,0,0,,Saya tidak mengerti Anda.
Dialog: 0,0:57:40.93,0:57:43.50,Default,Nanas5,0,0,0,,Dia hanya bersalah karena menyelamatkanku.
Dialog: 0,0:57:44.33,0:57:46.60,Default,Nanas5,0,0,0,,Saya tidak tahu siapa yang memberi tahu Anda hal ini,\Ntapi tolong,
Dialog: 0,0:57:46.94,0:57:48.21,Default,Nanas5,0,0,0,,kembali ke diri sendiri.
Dialog: 0,0:57:51.01,0:57:52.11,Default,Nanas5,0,0,0,,Bagaimana jika saya menolak?
Dialog: 0,0:57:53.14,0:57:55.98,Default,Nanas5,0,0,0,,Gadis itu akan diadili sesuai dengan hukum.
Dialog: 0,0:57:56.98,0:57:59.22,Default,Nanas5,0,0,0,,Jika kamu tetap di sini, kamu akan menderita.
Dialog: 0,0:58:00.45,0:58:02.29,Default,Nanas5,0,0,0,,Bawa ratu ke kamarnya.
Dialog: 0,0:58:02.29,0:58:03.32,Default,Nanas5,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:58:07.56,0:58:09.79,Default,Nanas5,0,0,0,,-Lepaskan aku!\N-Aku akan menemani ratu.
Dialog: 0,0:58:18.17,0:58:20.00,Default,Nanas5,0,0,0,,Kembali ke dirimu sendiri, ratu.
Dialog: 0,0:58:20.64,0:58:24.64,Default,Nanas5,0,0,0,,Skandal keras\Nkamu tidak akan membantu gadis ini dengan cara apa pun.
Dialog: 0,0:58:26.41,0:58:27.44,Default,Nanas5,0,0,0,,Yang Mulia!
Dialog: 0,0:58:45.26,0:58:48.43,Default,Nanas5,0,0,0,,Damhyang, aku akan segera membebaskanmu.\NASetuju?
Dialog: 0,0:58:49.93,0:58:51.77,Default,Nanas5,0,0,0,,Jangan takut apa pun.
Dialog: 0,0:58:52.40,0:58:53.87,Default,Nanas5,0,0,0,,Oke.
Dialog: 0,0:58:55.94,0:58:58.48,Default,Nanas5,0,0,0,,Ratu, kita harus berangkat.
Dialog: 0,0:59:00.78,0:59:01.91,Default,Nanas5,0,0,0,,Aku akan membebaskanmu.
Dialog: 0,0:59:27.50,0:59:31.37,Default,Nanas5,0,0,0,,Beraninya nyonya istana\Nmelempar batu ke arah ratu?
Dialog: 0,0:59:31.37,0:59:32.98,Default,Nanas5,0,0,0,,Ini penghinaan terhadap orang kerajaan!
Dialog: 0,0:59:32.98,0:59:36.35,Default,Nanas5,0,0,0,,Semuanya jauh lebih buruk!\NIni sudah merupakan pengkhianatan!
Dialog: 0,0:59:37.18,0:59:39.15,Default,Nanas5,0,0,0,,Kudengar ayahnya dituduh melakukan penyimpangan
Dialog: 0,0:59:39.15,0:59:41.15,Default,Nanas5,0,0,0,,dari dinas militer dan pengkhianatan.
Dialog: 0,0:59:41.15,0:59:42.85,Default,Nanas5,0,0,0,,Seperti kata pepatah, darah bukanlah air.
Dialog: 0,0:59:44.25,0:59:46.62,Default,Nanas5,0,0,0,,Para menteri yang terhormat, Anda bereaksi berlebihan.
Dialog: 0,0:59:46.62,0:59:49.86,Default,Nanas5,0,0,0,,Kami belum tahu apa yang mendorongnya melakukan ini.
Dialog: 0,0:59:50.16,0:59:53.00,Default,Nanas5,0,0,0,,Pemberontakan petani\Ni mendapatkan momentum dan
Dialog: 0,0:59:53.00,0:59:55.27,Default,Nanas5,0,0,0,,mengancam kekuasaan kerajaan.
Dialogue: 0,0:59:55.43,0:59:57.13,Default,Nanas5,0,0,0,,Menggunakan gadis ini sebagai contoh, kita harus
Dialog: 0,0:59:57.13,0:59:58.97,Default,Nanas5,0,0,0,,perkuat kekuatanmu di antara rakyat.
Dialog: 0,0:59:58.97,1:00:00.97,Default,Nanas5,0,0,0,,Sekarang kamu menyeret petani pemberontak?
Dialog: 0,1:00:00.97,1:00:04.44,Default,Nanas5,0,0,0,,Beraninya dia melempar batu ke arah ratu?
Dialog: 0,1:00:04.44,1:00:07.34,Default,Nanas5,0,0,0,,Saya yakin para bandit itu mencuci otaknya!
Dialog: 0,1:00:07.58,1:00:11.25,Default,Nanas5,0,0,0,,Dicuci otak oleh bandit?\NGadis itu baru berusia lima tahun.
Dialog: 0,1:00:11.25,1:00:13.02,Default,Nanas5,0,0,0,,Jangan menganggapnya kurang ajar,
Dialog: 0,1:00:13.25,1:00:15.82,Default,Nanas5,0,0,0,,tetapi beberapa orang percaya\Nbahwa Anda, tuan,
Dialog: 0,1:00:16.15,1:00:19.32,Default,Nanas5,0,0,0,,tinggal di Ganghwado,\Nkami berbicara dengan bandit pemberontak.
Dialog: 0,1:00:20.02,1:00:23.03,Default,Nanas5,0,0,0,,Sekarang kamu memutuskan untuk mengancamku dengan ini?
Dialog: 0,1:00:23.86,1:00:26.70,Default,Nanas5,0,0,0,,Jika kamu menolak menghukum gadis itu\Ndan mencoba menyelamatkannya,
Dialog: 0,1:00:27.03,1:00:31.54,Default,Nanas5,0,0,0,,Anda hanya akan mengkonfirmasi kecurigaan kami bahwa
Dialog: 0,1:00:32.24,1:00:34.17,Default,Nanas5,0,0,0,,bahwa Anda setuju dengan para bandit.
Dialog: 0,1:00:35.41,1:00:38.34,Default,Nanas5,0,0,0,,Kamu hanya perlu menghukum pelayan karena ketidaktaatan.
Dialog: 0,1:00:38.98,1:00:40.68,Default,Nanas5,0,0,0,,Dan semuanya akan berakhir.
Dialog: 0,1:00:46.98,1:00:48.65,Default,Nanas5,0,0,0,,Dia akan mendengarkan kita, kan?
Dialog: 0,1:00:49.25,1:00:52.46,Default,Nanas5,0,0,0,,Janda Ratu\Meminta kami untuk memaksakan hukuman.
Dialog: 0,1:00:53.09,1:00:55.43,Default,Nanas5,0,0,0,,Melampiaskan amarahnya padanya karena
Dialog: 0,1:00:55.43,1:00:57.06,Default,Nanas5,0,0,0,,bahwa dia dicopot dari takhta?
Dialog: 0,1:00:57.49,1:00:59.80,Default,Nanas5,0,0,0,,Seperti gadis tak berharga ini
Dialog: 0,1:00:59.80,1:01:04.17,Default,Nanas5,0,0,0,,berani mencegah kita menyingkirkan ratu?
Dialogue: 0,1:01:25.59,1:01:27.46,Default,Nanas5,0,0,0,,Kenapa lama sekali?
Dialog: 0,1:01:28.59,1:01:29.99,Default,Nanas5,0,0,0,,Semuanya akan baik-baik saja kan?
Dialog: 0,1:01:30.69,1:01:33.50,Default,Nanas5,0,0,0,,Pertemuan yang terlambat\Ntidak pernah menghasilkan hal-hal baik.
Dialog: 0,1:01:36.17,1:01:37.80,Default,Nanas5,0,0,0,,-Yang Mulia.\N-Ya?
Dialog: 0,1:02:00.66,1:02:02.56,Default,Nanas5,0,0,0,,Ini, Yang Mulia!
Dialog: 0,1:02:02.56,1:02:03.66,Default,Nanas5,0,0,0,,Oke.
Dialog: 0,1:02:09.40,1:02:12.84,Default,Nanas5,0,0,0,,Ingat momen ini seumur hidupmu.
Dialog: 0,1:02:13.17,1:02:18.01,Default,Nanas5,0,0,0,,Para abdi dalem istana\Nharus buta dan tuli terhadap apa yang terjadi,
Dialog: 0,1:02:18.98,1:02:22.85,Default,Nanas5,0,0,0,,seharusnya tidak ada satu pun pemikiran memberontak di benak mereka.
Dialog: 0,1:02:23.48,1:02:26.15,Default,Nanas5,0,0,0,,Jika setidaknya salah satu dari Anda mendukung
Dialog: 0,1:02:26.15,1:02:29.75,Default,Nanas5,0,0,0,,pemberontakan petani, inilah yang menanti Anda.
Dialog: 0,1:02:31.29,1:02:33.26,Default,Nanas5,0,0,0,,Pembantu itu adalah anak yang bodoh.
Dialog: 0,1:02:35.06,1:02:36.13,Default,Nanas5,0,0,0,,Tenang!
Dialog: 0,1:02:39.33,1:02:41.30,Default,Nanas5,0,0,0,,Kupikir kita menangkap seseorang yang penting,
Dialog: 0,1:02:42.80,1:02:45.77,Default,Nanas5,0,0,0,,tapi ini hanya anak-anak?\NITidak bisa dimengerti!
Dialog: 0,1:02:54.74,1:02:55.78,Default,Nanas5,0,0,0,,Apakah kita terlambat?
Dialog: 0,1:03:04.55,1:03:06.39,Default,Nanas5,0,0,0,,Sekarang kamu tahu perasaanku.
Dialog: 0,1:03:14.56,1:03:16.77,Default,Nanas5,0,0,0,,Dia ingin menyelamatkanmu.
Dialog: 0,1:03:17.97,1:03:19.20,Default,Nanas5,0,0,0,,Itulah sebabnya mereka membunuhnya.
Dialog: 0,1:03:21.07,1:03:22.87,Default,Nanas5,0,0,0,,Mereka ingin meracuniku, tapi Damhyan mencegahnya.
Dialog: 0,1:04:06.48,1:04:07.88,Default,Nanas5,0,0,0,,Dia tidak bisa disalahkan atas apa pun.
Dialog: 0,1:04:08.89,1:04:10.15,Default,Nanas5,0,0,0,,Anda sendiri yang mengatakannya,
Dialog: 0,1:04:11.49,1:04:15.59,Default,Nanas5,0,0,0,,mereka menimpakan dosanya pada anak kecil!
Dialog: 0,1:04:21.56,1:04:22.80,Default,Nanas5,0,0,0,,Kenapa kamu tidak menyelamatkannya?
Dialog: 0,1:04:24.03,1:04:26.00,Default,Nanas5,0,0,0,,Dia menjadi korban atas nama sesuatu yang lebih besar.
Dialog: 0,1:04:27.80,1:04:28.84,Default,Nanas5,0,0,0,,Lebih lanjut?
Dialog: 0,1:04:30.71,1:04:31.98,Default,Nanas5,0,0,0,,Apakah kamu berbicara tentang kulitmu sendiri?
Dialog: 0,1:04:34.78,1:04:38.01,Default,Nanas5,0,0,0,,Tidakkah kamu memberitahuku bahwa dunia ini tidak adil?
Dialog: 0,1:04:38.85,1:04:42.65,Default,Nanas5,0,0,0,,Pengorbanan yang tidak berarti akan menghentikan\Nsesuatu yang jauh lebih berbahaya!
Dialogue: 0,1:04:44.09,1:04:45.26,Default,Nanas5,0,0,0,,Korban kecil?
Dialog: 0,1:04:48.32,1:04:49.43,Default,Nanas5,0,0,0,,Karena
Dialog: 0,1:04:50.49,1:04:52.30,Default,Nanas5,0,0,0,,apakah dia hanyalah gadis tak berdaya?
Dialog: 0,1:04:56.00,1:04:57.43,Default,Nanas5,0,0,0,,Amatirisme adalah dosa.
Dialog: 0,1:04:58.97,1:05:01.20,Default,Nanas5,0,0,0,,Kamu tidak bisa menyelamatkan gadis ini!
Dialog: 0,1:05:03.97,1:05:05.11,Default,Nanas5,0,0,0,,Kamu adalah orang berdosa.
Dialog: 0,1:05:30.60,1:05:32.40,Default,Nanas5,0,0,0,,Jika Anda tidak ingin bicara,\Nharuskah kita menggunakan isyarat tangan?
Dialog: 0,1:05:32.40,1:05:33.50,Default,Nanas5,0,0,0,,Misalnya yang ini.
Dialog: 0,1:05:33.50,1:05:35.71,Default,Nanas5,0,0,0,,Artinya aku berbohong.
Dialog: 0,1:05:36.04,1:05:37.17,Default,Nanas5,0,0,0,,Apa yang kamu katakan?
Dialog: 0,1:05:46.24,1:05:50.68,Default,Nanas5,0,0,0,,
Dialog: 0,1:06:06.37,1:06:08.81,Default,Nanas5,0,0,0,,Mulai hari ini, aku akan menjadi\Norang paling gila di istana.
Dialog: 0,1:06:08.81,1:06:12.68,Default,Nanas5,0,0,0,,Akan kutunjukkan padamu apa yang terjadi jika kau membuatku kesal.
Dialog: 0,1:06:12.68,1:06:14.74,Default,Nanas5,0,0,0,,Sudahkah kamu mencoba menyingkirkan ratu?
Dialog: 0,1:06:14.91,1:06:16.65,Default,Nanas5,0,0,0,,-Damhyan!\N-Damhyan!
Dialog: 0,1:06:18.01,1:06:19.25,Default,Nanas5,0,0,0,,Saya yakin semuanya!
Dialog: 0,1:06:19.25,1:06:20.65,Default,Nanas5,0,0,0,,Jangan remehkan Kim Byungin.
Dialog: 0,1:06:20.65,1:06:22.45,Default,Nanas5,0,0,0,,Bahkan klan Cho pun mematuhinya.
Dialog: 0,1:06:22.45,1:06:23.62,Default,Nanas5,0,0,0,,Ayo menjadi sekutu.
