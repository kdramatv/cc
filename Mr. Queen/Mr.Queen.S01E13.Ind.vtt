Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,bekerja,,0,0,0,,{\pos(801,256)}Mengerjakan serial:\N Lily, Tiramisu, Biryulka, Pembawa Acara, Penyanyi
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.12,0:01:06.52,Default,Lily,0,0,0,,Semua karakter fiktif,
Dialog: 0,0:01:06.52,0:01:08.52,Default,Lily,0,0,0,,dan peristiwa yang ditampilkan adalah fiksi.
Dialog: 0,0:02:19.19,0:02:21.63,Default,Lily,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:02:24.23,0:02:26.10,Default,Lily,0,0,0,,Sebuah keajaiban nyata bagi kami,
Dialog: 0,0:02:26.67,0:02:28.90,Default,Lily,0,0,0,,bahwa setelah setiap hari hari esok akan datang.
Dialog: 0,0:02:30.00,0:02:32.84,Default,Lily,0,0,0,,Ini berbahaya. Kemungkinan akan terjadi ledakan lagi.
Dialog: 0,0:02:35.04,0:02:36.18,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:36.91,0:02:38.81,Default,Lily,0,0,0,,Tidak. Anda tidak bisa pergi ke sana.
Dialog: 0,0:02:38.81,0:02:41.55,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:41.55,0:02:43.88,Default,Lily,0,0,0,,-Yang Mulia!\N-Lindungi raja.
Dialog: 0,0:02:43.98,0:02:46.35,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:47.39,0:02:50.32,Default,Lily,0,0,0,,Yang Mulia, kami harus pergi.
Dialog: 0,0:02:50.92,0:02:52.49,Default,Lily,0,0,0,,-Yang Mulia!\N-Lebih Cepat.
Dialog: 0,0:03:00.90,0:03:02.90,Default,Lily,0,0,0,,Tidak. Kita harus menyelamatkannya!
Dialog: 0,0:03:02.90,0:03:05.04,Default,Lily,0,0,0,,-Yang Mulia.\N-Jangan pergi ke sana.
Dialog: 0,0:03:05.04,0:03:06.44,Default,Lily,0,0,0,,Jangan ikut campur.
Dialog: 0,0:03:06.61,0:03:08.78,Default,Lily,0,0,0,,Apa yang kamu katakan? Raja...
Dialog: 0,0:03:08.91,0:03:10.21,Default,Lily,0,0,0,,Dengarkan aku!
Dialogue: 0,0:03:12.48,0:03:14.31,Default,Lily,0,0,0,,Akan kujelaskan semuanya padamu nanti.
Dialogue: 0,0:03:14.31,0:03:16.48,Default,Lily,0,0,0,,Sekarang selamatkan dirimu.
Dialog: 0,0:03:16.52,0:03:18.48,Default,Lily,0,0,0,,-Yang Mulia!\N-Berbahaya di sini,
Dialog: 0,0:03:18.48,0:03:20.02,Default,Lily,0,0,0,,bawa ratu ke Daejojeon.
Dialog: 0,0:03:21.86,0:03:24.39,Default,Lily,0,0,0,,-Yang Mulia, jangan pergi ke sana.\N-Yang Mulia.
Dialog: 0,0:03:24.39,0:03:25.99,Default,Lily,0,0,0,,-Biarkan saya masuk!\N-Yang Mulia.
Dialog: 0,0:03:25.99,0:03:27.69,Default,Lily,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:03:27.69,0:03:29.46,Default,Lily,0,0,0,,Tolong izinkan saya masuk.
Dialogue: 0,0:03:29.60,0:03:31.80,Default,Lily,0,0,0,,Lepaskan aku!
Dialog: 0,0:03:31.80,0:03:32.97,Default,Lily,0,0,0,,Biarkan aku masuk!
Dialog: 0,0:03:32.97,0:03:34.00,Default,Lily,0,0,0,,Yang Mulia!
Dialog: 0,0:03:34.73,0:03:36.04,Default,Lily,0,0,0,,Namun
Dialog: 0,0:03:37.24,0:03:39.74,Default,Lily,0,0,0,,kami tidak mengerti betapa indahnya itu,
Dialog: 0,0:03:40.91,0:03:43.34,Default,Lily,0,0,0,,sampai hari itu tiba tanpa hari esok.
Dialog: 0,0:03:45.14,0:03:48.05,Default,Lily,0,0,0,,Kami sangat bodoh hingga tidak menghargai sesuatu,
Dialog: 0,0:03:48.98,0:03:50.68,Default,Lily,0,0,0,,sampai kita kalah.
Dialog: 0,0:03:52.05,0:03:57.42,Default,Lily,0,0,0,,Besok tidak pernah datang
Dialog: 0,0:03:59.63,0:04:02.33,Default,Lily,0,0,0,,13 episode
Dialogue: 0,0:04:15.17,0:04:18.75,Default,Lily,0,0,0,,Seseorang berani membunuh raja di istana.
Dialog: 0,0:04:19.18,0:04:22.12,Default,Lily,0,0,0,,Tangkap semua orang yang mencurigakan dan interogasi mereka.
Dialog: 0,0:04:22.68,0:04:24.15,Default,Lily,0,0,0,,Kita harus mencari tahu
Dialogue: 0,0:04:24.88,0:04:27.19,Default,Lily,0,0,0,,siapa dalang di balik ini.
Dialog: 0,0:04:29.02,0:04:31.32,Default,Lily,0,0,0,,Sudahkah kamu menyiapkan ini?
Dialogue: 0,0:04:31.72,0:04:35.33,Default,Lily,0,0,0,,Bagaimana kamu akan menghadapi konsekuensinya setelah merencanakan ini?
Dialog: 0,0:04:35.56,0:04:36.80,Default,Lily,0,0,0,,Tenang.
Dialog: 0,0:04:36.80,0:04:39.13,Default,Lily,0,0,0,,Seolah aku bisa tenang!
Dialog: 0,0:04:39.13,0:04:41.90,Default,Lily,0,0,0,,Nyawa raja terancam di depan semua orang,
Dialog: 0,0:04:41.90,0:04:43.90,Default,Lily,0,0,0,,juga untuk pertunjukan.
Dialog: 0,0:04:44.90,0:04:48.81,Default,Lilia,0,0,0,,Jadi, semua orang memutuskan bahwa akulah yang mencoba membunuhnya?
Dialog: 0,0:04:51.61,0:04:53.58,Default,Lily,0,0,0,,Aku akan mengurusnya.
Dialog: 0,0:05:00.39,0:05:03.02,Default,Lily,0,0,0,,aku mohon. saya berdoa.
Dialog: 0,0:05:03.69,0:05:07.49,Default,Lily,0,0,0,,Aku berdoa mati-matian kepada para dewa langit dan bumi.
Dialog: 0,0:05:08.13,0:05:12.73,Default,Lily,0,0,0,,Selamatkan raja kami.
Dialog: 0,0:05:13.93,0:05:17.00,Default,Lily,0,0,0,,aku mohon. saya berdoa.
Dialogue: 0,0:05:17.57,0:05:19.57,Default,Lily,0,0,0,,aku mohon.
Dialog: 0,0:05:21.81,0:05:24.41,Default,Lily,0,0,0,,Simpan
Dialog: 0,0:05:26.25,0:05:28.72,Default,Lily,0,0,0,,raja kita.
Dialogue: 0,0:05:34.42,0:05:36.59,Default,Lily,0,0,0,,Aku tidak tahu mereka akan berbuat sejauh ini.
Dialog: 0,0:05:37.16,0:05:39.76,Default,Lily,0,0,0,,Mereka sendiri yang menempatkannya di atas takhta,
Dialog: 0,0:05:39.76,0:05:42.43,Default,Lilia,0,0,0,,dan sekarang mereka ingin menyingkirkannya.
Dialog: 0,0:05:44.06,0:05:48.10,Default,Lily,0,0,0,,Apa yang terjadi jika raja tidak bangun?
Dialog: 0,0:05:49.07,0:05:55.02,Default,Lily,0,0,0,,Maka selir kerajaan dan aku tidak akan berdaya.
Dialog: 0,0:05:58.24,0:06:00.88,Default,Lily,0,0,0,,Aku tidak percaya kita melakukannya dengan benar
Dialog: 0,0:06:01.25,0:06:03.42,Default,Lily,0,0,0,,ke dalam jebakan yang dipasang untuk ratu.
Dialogue: 0,0:06:04.05,0:06:06.82,Default,Lily,0,0,0,,aku mohon. saya berdoa.
Dialog: 0,0:06:08.79,0:06:10.12,Default,Lily,0,0,0,,aku mohon.
Dialog: 0,0:06:13.89,0:06:16.20,Default,Lily,0,0,0,,Istirahat sebentar.
Dialog: 0,0:06:16.50,0:06:18.87,Default,Lily,0,0,0,,Kamu akan segera terjatuh.
Dialog: 0,0:06:21.80,0:06:25.61,Default,Lily,0,0,0,,Jika raja tidak bertahan,
Dialog: 0,0:06:26.61,0:06:28.94,Default,Lily,0,0,0,,Aku juga tidak akan bisa hidup.
Dialog: 0,0:06:31.14,0:06:34.01,Default,Lily,0,0,0,,Jika kamu harus mati,
Dialog: 0,0:06:34.85,0:06:38.95,Default,Lily,0,0,0,,sebelum aku mati aku akan membalas dendam pada pelanggar raja.
Dialog: 0,0:06:40.69,0:06:41.72,Default,Lily,0,0,0,,Istana
Dialog: 0,0:06:43.66,0:06:45.39,Default,Lily,0,0,0,,dan orang-orang itu
Dialog: 0,0:06:47.79,0:06:50.66,Default,Lily,0,0,0,,membuat kami marah.
Dialog: 0,0:07:23.70,0:07:27.97,Default,Lily,0,0,0,,Yang Mulia. Kepala Departemen Detektif datang.
Dialog: 0,0:07:30.57,0:07:31.64,Default,Lily,0,0,0,,Dan Cheoljong...
Dialog: 0,0:07:32.97,0:07:35.74,Default,Lily,0,0,0,,Apakah raja baik-baik saja?
Dialogue: 0,0:07:37.44,0:07:39.51,Default,Lily,0,0,0,,Pangeran Yeonpyeong dilarang
Dialog: 0,0:07:39.51,0:07:41.55,Default,Lily,0,0,0,,masuki Hijonjon saat raja sedang dirawat.
Dialog: 0,0:07:42.48,0:07:45.28,Default,Lily,0,0,0,,Dan mereka tidak mengatakan apa pun tentang kondisi raja.
Dialog: 0,0:07:46.12,0:07:47.25,Default,Lily,0,0,0,,Aku harus menemuinya.
Dialog: 0,0:07:47.25,0:07:48.49,Default,Lily,0,0,0,,Jangan pergi.
Dialog: 0,0:07:51.86,0:07:53.79,Default,Lily,0,0,0,,Mereka akan mengizinkanku masuk.
Dialogue: 0,0:07:53.79,0:07:55.26,Default,Lilia,0,0,0,,Aku masih istrinya.
Dialog: 0,0:08:22.66,0:08:24.12,Default,Lily,0,0,0,,Jangan pergi.
Dialog: 0,0:08:24.79,0:08:26.96,Default,Lily,0,0,0,,Dia mencoba membunuhmu.
Dialog: 0,0:08:27.46,0:08:30.26,Default,Lily,0,0,0,,Kamu berhak membunuhnya.
Dialog: 0,0:08:38.27,0:08:39.34,Default,Lily,0,0,0,,Soyeon.
Dialog: 0,0:08:49.05,0:08:52.75,Default,Lily,0,0,0,,Saya perlu istirahat.
Dialog: 0,0:09:48.94,0:09:51.04,Default,Lily,0,0,0,,Apakah kamu yakin tidak akan ada masalah?
Dialog: 0,0:09:51.04,0:09:52.04,Default,Lily,0,0,0,,Tentu saja.
Dialog: 0,0:10:19.84,0:10:21.44,Default,Lily,0,0,0,,Siapa dalang di balik ini?
Dialog: 0,0:10:22.48,0:10:24.04,Default,Lily,0,0,0,,Kami tidak bersalah.
Dialog: 0,0:10:24.71,0:10:27.55,Default,Lily,0,0,0,,Kami siap memberikan nyawa kami untuk melindungi raja.
Dialog: 0,0:10:28.65,0:10:29.92,Default,Lily,0,0,0,,Kami adalah pengawal kerajaan.
Dialog: 0,0:10:35.49,0:10:38.29,Default,Lily,0,0,0,,Mengapa Anda memerlukan dokumen palsu?
Dialog: 0,0:10:38.56,0:10:41.39,Default,Lily,0,0,0,,Anda menggunakan alasan ini untuk menahan kami,
Dialog: 0,0:10:42.60,0:10:44.60,Default,Lily,0,0,0,,dan saat ini raja menderita.
Dialog: 0,0:10:45.23,0:10:46.50,Default,Lily,0,0,0,,Orang di balik ini adalah,
Dialog: 0,0:10:46.97,0:10:49.74,Default,Lily,0,0,0,,yang menemukan kesalahan dalam dokumen kami. Ayahmu
Dialog: 0,0:10:50.40,0:10:51.54,Default,Lily,0,0,0,,Kim Jwageun!
Dialogue: 0,0:10:53.44,0:10:55.31,Default,Lily,0,0,0,,Ini Kim Jwageun.
Dialogue: 0,0:10:57.21,0:10:58.71,Default,Lily,0,0,0,,Kamu cukup pintar.
Dialog: 0,0:11:05.32,0:11:06.45,Default,Lily,0,0,0,,Saya menemukan jawabannya.
Dialog: 0,0:11:13.16,0:11:15.70,Default,Lily,0,0,0,,Seperti yang kamu duga, pembakar dupa tidak diisi pasir,
Dialog: 0,0:11:15.70,0:11:17.60,Default,Lily,0,0,0,,dan bubuk mesiu digunakan sebagai bahan peledak.
Dialogue: 0,0:11:18.06,0:11:19.37,Default,Lily,0,0,0,,Bagaimana tebakannya?
Dialogue: 0,0:11:27.94,0:11:29.11,Default,Lily,0,0,0,,Bagaimana hasilnya?
Dialog: 0,0:11:29.44,0:11:31.24,Default,Lily,0,0,0,,Tidak mudah memaksa mereka untuk mengaku.
Dialog: 0,0:11:31.24,0:11:32.51,Default,Lily,0,0,0,,Tanpa keraguan.
Dialogue: 0,0:11:33.18,0:11:34.58,Default,Lily,0,0,0,,Apakah kamu mempelajari hal lainnya?
Dialog: 0,0:11:35.21,0:11:36.52,Default,Lily,0,0,0,,Belum.
Dialogue: 0,0:11:36.55,0:11:39.35,Default,Lily,0,0,0,,Kita perlu menemukan penjahatnya untuk mengakhiri ini.
Dialog: 0,0:11:39.75,0:11:41.65,Default,Lily,0,0,0,,Temukan pemicunya sesegera mungkin.
Dialog: 0,0:11:41.65,0:11:42.72,Default,Lily,0,0,0,,Ya.
Dialog: 0,0:11:48.19,0:11:50.30,Default,Lily,0,0,0,,Cari tahu dari mana bubuk mesiu itu berasal.
Dialog: 0,0:11:51.56,0:11:53.30,Default,Lily,0,0,0,,Bergerak dengan tenang dan sendirian.
Dialog: 0,0:11:53.60,0:11:54.67,Default,Lily,0,0,0,,Ya.
Dialog: 0,0:12:04.71,0:12:05.75,Default,Lily,0,0,0,,Tn.
Dialog: 0,0:12:06.31,0:12:08.91,Default,Lily,0,0,0,,Maafkan saya.
Dialog: 0,0:12:09.95,0:12:12.75,Default,Lily,0,0,0,,Apa yang kamu lakukan? Terlalu banyak mata.
Dialogue: 0,0:12:13.32,0:12:14.52,Default,Lily,0,0,0,,aku mohon.
Dialog: 0,0:12:14.69,0:12:16.36,Default,Lily,0,0,0,,Dengarkan aku.
Dialog: 0,0:12:16.76,0:12:20.19,Default,Lily,0,0,0,,Tidak akan memakan banyak waktu. Hanya sedikit.
Dialog: 0,0:12:20.46,0:12:22.83,Default,Lily,0,0,0,,Tolong. Tidak lama.
Dialogue: 0,0:12:25.33,0:12:26.40,Default,Lily,0,0,0,,Aku hanya berjaga-jaga
Dialog: 0,0:12:27.83,0:12:30.47,Default,Lily,0,0,0,,menyimpan pembukuan.
Dialog: 0,0:12:32.24,0:12:35.17,Default,Lily,0,0,0,,Saya bahkan tidak pernah berpikir untuk menggunakannya.
Dialog: 0,0:12:35.41,0:12:39.11,Default,Lily,0,0,0,,Lagipula, ratu tidak tahu apa-apa tentang hal itu.
Dialog: 0,0:12:39.38,0:12:40.98,Default,Lily,0,0,0,,Di mana buku akuntansinya sekarang?
Dialogue: 0,0:12:46.92,0:12:49.29,Default,Lily,0,0,0,,Bukankah dia milikmu?
Dialog: 0,0:12:50.62,0:12:52.22,Default,Lily,0,0,0,,Maka dia hanya bisa
Dialog: 0,0:12:53.33,0:12:54.49,Default,Lily,0,0,0,,di raja.
Dialog: 0,0:12:56.13,0:12:57.16,Default,Lily,0,0,0,,Bagaimana bisa.
Dialogue: 0,0:13:00.73,0:13:03.34,Default,Lily,0,0,0,,Jejak yang kau tinggalkan membahayakan klan kita.
Dialog: 0,0:13:03.57,0:13:05.74,Default,Lily,0,0,0,,Ini cukup untuk menghukummu.
Dialog: 0,0:13:06.27,0:13:07.44,Default,Lily,0,0,0,,Aku akan menuruti apa pun yang kamu katakan.
Dialog: 0,0:13:08.07,0:13:09.94,Default,Lily,0,0,0,,Jika kamu menyuruhku mati, aku akan mati.
Dialog: 0,0:13:14.98,0:13:16.08,Default,Lily,0,0,0,,Di sini.
Dialog: 0,0:13:19.49,0:13:21.42,Default,Lily,0,0,0,,Aku akan gantung diri di sini.
Dialogue: 0,0:13:25.39,0:13:26.86,Default,Lily,0,0,0,,Aku gantung diri.
Dialog: 0,0:13:33.43,0:13:35.73,Default,Lily,0,0,0,,Lepaskan saya, Pak.
Dialog: 0,0:13:36.90,0:13:40.11,Default,Lily,0,0,0,,Lepaskan aku.
Dialog: 0,0:13:50.45,0:13:52.18,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:13:52.18,0:13:55.59,Default,Lily,0,0,0,,Yang Mulia, apakah Anda sudah sadar?
Dialogue: 0,0:13:57.36,0:13:58.89,Default,Lily,0,0,0,,Saudaraku.
Dialog: 0,0:13:58.89,0:14:01.39,Default,Lily,0,0,0,,Ya. Melanjutkan.
Dialogue: 0,0:14:02.66,0:14:04.50,Default,Lily,0,0,0,,Kenapa berisik sekali di sini?
Dialog: 0,0:14:05.70,0:14:08.50,Default,Lily,0,0,0,,Berisik sekali hingga membuatku pusing.
Dialog: 0,0:14:10.80,0:14:12.81,Default,Lily,0,0,0,,Saya tidak dapat mendengar apa pun.
Dialog: 0,0:14:14.97,0:14:16.94,Default,Lily,0,0,0,,Bungkam kebisingan.
Dialogue: 0,0:14:33.76,0:14:35.49,Default,Lily,0,0,0,,Seharusnya aku jelaskan.
Dialog: 0,0:14:37.30,0:14:40.17,Default,Lily,0,0,0,,Seharusnya aku memberitahunya bahwa raja tidak mencoba membunuhku.
Dialogue: 0,0:14:43.34,0:14:45.17,Default,Lily,0,0,0,,Dia mencoba membunuhmu.
Dialog: 0,0:14:45.37,0:14:47.87,Default,Lily,0,0,0,,Kamu berhak membunuhnya.
Dialogue: 0,0:14:51.64,0:14:54.85,Default,Lily,0,0,0,,Kau harus membayar atas kecerobohanmu.
Dialogue: 0,0:14:55.85,0:14:57.88,Default,Lily,0,0,0,,Apakah klan Kim berada dibalik semua ini?
Dialog: 0,0:14:59.82,0:15:01.05,Default,Lily,0,0,0,,Atau klan lain?
Dialog: 0,0:15:03.36,0:15:04.46,Default,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:15:06.29,0:15:09.06,Default,Lily,0,0,0,,Yang Mulia. Raja sadar.
Dialog: 0,0:15:32.69,0:15:34.02,Default,Lily,0,0,0,,Dia sepertinya sudah bangun.
Dialog: 0,0:15:35.29,0:15:37.42,Default,Lily,0,0,0,,Dia baru saja tertidur.
Dialogue: 0,0:15:47.13,0:15:49.03,Default,Lily,0,0,0,,Kenapa kamu membungkusnya seperti itu?
Dialog: 0,0:15:52.00,0:15:53.44,Default,Lily,0,0,0,,Terlihat terlalu sakit.
Dialogue: 0,0:15:54.41,0:15:55.81,Default,bir,0,0,0,,Sayangnya,
Dialog: 0,0:15:56.61,0:15:59.55,Default,bir,0,0,0,,akibat ledakan, dia kehilangan pendengarannya.
Dialog: 0,0:16:03.08,0:16:04.18,Default,bir,0,0,0,,Jangan katakan itu,
Dialog: 0,0:16:07.55,0:16:09.25,Default,bir,0,0,0,,bahwa dia akan tuli seumur hidupnya.
Dialog: 0,0:16:09.52,0:16:12.46,Default,bir,0,0,0,,Hanya waktu yang akan menjawabnya.
Dialog: 0,0:16:27.84,0:16:29.21,Default,bir,0,0,0,,Tinggalkan kami sendiri.
Dialog: 0,0:16:30.71,0:16:31.78,Default,bir,0,0,0,,Ya.
Dialogue: 0,0:16:50.80,0:16:53.77,Default,bir,0,0,0,,Maukah Anda mengatakan lagi bahwa ini bukan karya sejenis Anda?
Dialogue: 0,0:16:55.67,0:16:56.97,Default,bir,0,0,0,,Kau bilang padaku,
Dialog: 0,0:16:58.24,0:17:00.21,Default,bir,0,0,0,,bahwa aku akan kehilangan seseorang yang aku sayangi.
Dialog: 0,0:17:03.14,0:17:04.64,Default,bir,0,0,0,,Sekarang di hatiku
Dialog: 0,0:17:05.84,0:17:08.28,Default,bir,0,0,0,,tidak ada yang tersisa.
Dialogue: 0,0:17:12.62,0:17:13.85,Default,bir,0,0,0,,Jadi aku bertanya,
Dialog: 0,0:17:15.59,0:17:16.76,Default,bir,0,0,0,,hentikan ini.
Dialog: 0,0:17:36.78,0:17:39.65,Default,bir,0,0,0,,Yang Mulia, berhentilah khawatir.
Dialog: 0,0:18:03.77,0:18:04.87,Default,bir,0,0,0,,Siapa...
Dialog: 0,0:18:06.64,0:18:09.64,Default,bir,0,0,0,,Rajaku, apakah kamu sudah bangun?
Dialogue: 0,0:18:10.91,0:18:12.61,Default,bir,0,0,0,,Biarkan aku membasahi bibirmu.
Dialogue: 0,0:18:23.89,0:18:25.86,Default,bir,0,0,0,,Queen's Dictionary
Dialogue: 0,0:18:54.25,0:18:56.02,Default,bir,0,0,0,,Jadi kamu pergi mengunjungi raja.
Dialog: 0,0:19:02.59,0:19:05.40,Default,bir,0,0,0,,Saya datang untuk menghibur Anda setelah apa yang terjadi
Dialog: 0,0:19:05.83,0:19:08.10,Default,bir,0,0,0,,dan ajukan beberapa pertanyaan.
Dialogue: 0,0:19:10.04,0:19:12.94,Default,bir,0,0,0,,Ayahmu kehilangan sesuatu yang penting.
Dialogue: 0,0:19:13.71,0:19:16.28,Default,bir,0,0,0,,Aku yakin raja diam-diam membawanya.
Dialog: 0,0:19:17.11,0:19:18.88,Default,bir,0,0,0,,Apakah kamu tahu sesuatu tentang ini?
Dialog: 0,0:19:20.05,0:19:22.48,Default,bir,0,0,0,,-Baiklah, saya sedang mencari bantuan.\N-Tidak.
Dialogue: 0,0:19:23.12,0:19:25.78,Default,bir,0,0,0,,Tak seorang pun boleh tahu kalau aku...
Dialogue: 0,0:19:26.99,0:19:29.02,Default,bir,0,0,0,,Apa aku...
Dialogue: 0,0:19:33.53,0:19:34.86,Default,bir,0,0,0,,Jadi kamu tahu sesuatu.
Dialog: 0,0:19:36.06,0:19:37.90,Default,bir,0,0,0,,Ingat apa yang saya katakan,
Dialogue: 0,0:19:37.90,0:19:39.73,Default,bir,0,0,0,,bahwa jenis kita tidak mempunyai kelemahan?
Dialogue: 0,0:19:40.93,0:19:42.97,Default,bir,0,0,0,,Karena kita langsung menyingkirkannya.
Dialogue: 0,0:19:52.18,0:19:55.08,Default,bir,0,0,0,,Izinkan saya bertanya untuk terakhir kalinya.
Dialog: 0,0:19:56.38,0:19:58.72,Default,bir,0,0,0,,Adakah yang ingin kamu sampaikan padaku?
Dialog: 0,0:20:01.39,0:20:02.89,Default,bir,0,0,0,,Saat kita di rumahku,
Dialog: 0,0:20:04.02,0:20:07.13,Default,bir,0,0,0,,Aku menyelamatkan raja ketika dia jatuh ke dalam sumur.
Dialog: 0,0:20:08.29,0:20:09.66,Default,bir,0,0,0,,Mungkin saat itu...
Dialog: 0,0:20:15.37,0:20:18.77,Default,bir,0,0,0,,Beberapa waktu lalu saya mengajukan penawaran kepada Anda.
Dialog: 0,0:20:19.30,0:20:21.44,Default,bir,0,0,0,,Pada hari kamu jatuh ke danau.
Dialog: 0,0:20:24.61,0:20:26.68,Default,bir,0,0,0,,Izinkan saya mengingatkan Anda.
Dialog: 0,0:20:27.85,0:20:30.58,Default,bir,0,0,0,,Aku memintamu untuk tidak mengalihkan pandanganmu dari suamimu.
Dialog: 0,0:20:31.85,0:20:33.09,Default,bir,0,0,0,,Anda akan menerima
Dialog: 0,0:20:34.45,0:20:36.76,Default,bir,0,0,0,,saran saya?
Dialog: 0,0:20:47.10,0:20:50.74,Default,bir,0,0,0,,Dan apa yang akan saya dapatkan sebagai imbalannya?
Dialog: 0,0:20:51.34,0:20:52.84,Default,bir,0,0,0,,Apa yang kamu inginkan?
Dialogue: 0,0:20:54.64,0:20:56.48,Default,bir,0,0,0,,Jaminan keselamatanku.
Dialog: 0,0:21:16.13,0:21:18.40,Default,bir,0,0,0,,Yang Mulia, sudah waktunya bagi Anda untuk kembali.
Dialogue: 0,0:21:30.51,0:21:32.21,Default,bir,0,0,0,,Queen's Dictionary
Dialog: 0,0:21:58.27,0:21:59.94,Default,bir,0,0,0,,Seharusnya aku tidak sampai di sini\NJang Bong-hwan
Dialog: 0,0:22:13.12,0:22:14.19,Default,bir,0,0,0,,Cheoljong.
Dialog: 0,0:22:15.15,0:22:16.25,Default,bir,0,0,0,,Maaf.
Dialog: 0,0:22:17.66,0:22:19.32,Default,bir,0,0,0,,Kamu tetap kalah.
Dialog: 0,0:22:21.56,0:22:23.43,Default,bir,0,0,0,,Saya berpihak pada pemenang.
Dialog: 0,0:22:30.94,0:22:34.41,Default,bir,0,0,0,,Kim Soyeon, kamu masih mengucapkan selamat tinggal pada kehidupan.
Dialogue: 0,0:22:36.17,0:22:38.01,Default,bir,0,0,0,,Karena kebetulan aku sudah menggantikanmu,
Dialog: 0,0:22:38.78,0:22:40.98,Default,bir,0,0,0,,biarkan aku menjalani hidup ini dengan baik.
Dialogue: 0,0:22:43.28,0:22:45.18,Default,bir,0,0,0,,Agar ini berhasil, saya perlu mencari tahu
Dialog: 0,0:22:45.88,0:22:47.22,Default,bir,0,0,0,,apa yang terjadi hari itu.
Dialog: 0,0:23:48.48,0:23:50.15,Default,bir,0,0,0,,Suatu hari nanti kamu akan kalah
Dialog: 0,0:23:50.25,0:23:52.78,Default,bir,0,0,0,,orang sayang padamu.
Dialogue: 0,0:23:54.02,0:23:56.12,Default,bir,0,0,0,,Kamu harus mencintaiku.
Dialog: 0,0:23:56.12,0:23:58.16,Default,bir,0,0,0,,Apakah ini perintah?
Dialogue: 0,0:24:03.10,0:24:05.90,Default,bir,0,0,0,,Tidak ada yang nyata pada diri saya, semuanya bohong.
Dialog: 0,0:24:07.40,0:24:09.33,Default,bir,0,0,0,,Kamu adalah Soyeon.
Dialog: 0,0:24:16.21,0:24:18.78,Default,bir,0,0,0,,Apakah Anda sendiri yang mengambil posisi ini?
Dialog: 0,0:24:19.48,0:24:21.85,Default,bir,0,0,0,,Jika kamu ingin mati, matilah di istana.
Dialog: 0,0:24:23.18,0:24:25.92,Default,bir,0,0,0,,Besok kamu akan menjadi ratu.
Dialog: 0,0:24:35.66,0:24:38.40,Default,bir,0,0,0,,Besok kamu akan menjadi ratu.
Dialog: 0,0:24:38.53,0:24:39.60,Default,bir,0,0,0,,Mulai sekarang
Dialog: 0,0:24:40.43,0:24:43.84,Default,bir,0,0,0,,ceritakan semua tentang dia.
Dialogue: 0,0:24:43.97,0:24:46.34,Default,bir,0,0,0,,Tanya aku
Dialogue: 0,0:24:47.87,0:24:49.24,Default,bir,0,0,0,,awasi raja?
Dialogue: 0,0:24:49.54,0:24:52.51,Default,bir,0,0,0,,Jangan ikuti raja,\N dan jangan mengalihkan pandanganmu dari suamimu.
Dialog: 0,0:24:57.18,0:24:58.32,Default,bir,0,0,0,,Saya tidak mau.
Dialog: 0,0:25:00.85,0:25:03.89,Default,bir,0,0,0,,Apakah kamu tidak memerlukan status ratu
Dialog: 0,0:25:03.89,0:25:05.76,Default,bir,0,0,0,,dan raja?
Dialogue: 0,0:25:06.59,0:25:09.93,Default,bir,0,0,0,,Kamu harus melakukan apa yang seharusnya kamu lakukan sejak lahir.
Dialog: 0,0:25:12.36,0:25:14.80,Default,bir,0,0,0,,Seperti yang mereka lakukan di masa lalu.
Dialog: 0,0:25:20.11,0:25:23.11,Default,bir,0,0,0,,Saat mereka memberitahuku bahwa raja ada di dalam sumur.
Dialogue: 0,0:25:28.65,0:25:31.58,Default,bir,0,0,0,,Jika kamu tidak memenuhi peranmu,
Dialog: 0,0:25:31.82,0:25:35.22,Default,bir,0,0,0,,raja tidak berguna. Dari tidak berguna
Dialog: 0,0:25:36.15,0:25:37.92,Default,bir,0,0,0,,kita harus membuangnya.
Dialog: 0,0:25:39.19,0:25:40.96,Default,bir,0,0,0,,Jika kamu menyakiti raja,
Dialog: 0,0:25:41.76,0:25:43.40,Default,bir,0,0,0,,Saya tidak akan diam saja.
Dialog: 0,0:25:43.40,0:25:45.66,Default,bir,0,0,0,,Jadi apa yang akan kamu lakukan?
Dialog: 0,0:25:46.30,0:25:48.40,Default,bir,0,0,0,,Anda salah besar.
Dialog: 0,0:25:48.70,0:25:52.37,Default,bir,0,0,0,,Menurutmu apakah ratu punya kekuatan?
Dialogue: 0,0:25:52.90,0:25:58.41,Default,bir,0,0,0,,Ratu diperlukan hanya untuk\N menghasilkan ahli waris.
Dialog: 0,0:26:00.11,0:26:02.41,Default,bir,0,0,0,,Jika kamu menjadi ratu,
Dialog: 0,0:26:02.41,0:26:04.25,Default,bir,0,0,0,,kekuatan seperti apa yang menurutmu akan kamu miliki
Dialogue: 0,0:26:05.35,0:26:08.12,Default,bir,0,0,0,,seperti wanita sederhana?
Dialog: 0,0:26:53.50,0:26:55.53,Default,bir,0,0,0,,Ini bukan hanya karena perkataan Kim Jwageun.
Dialog: 0,0:26:57.47,0:26:59.77,Default,bir,0,0,0,,Bahkan setelah tinggal di istana untuk waktu yang singkat,
Dialog: 0,0:27:00.97,0:27:03.68,Default,bir,0,0,0,,Saya sudah cukup berpengalaman untuk menyadari kenyataan.
Dialog: 0,0:27:10.08,0:27:11.88,Default,bir,0,0,0,,Seluruh istana
Dialog: 0,0:27:13.82,0:27:15.75,Default,bir,0,0,0,,membunuh Kim So-yeon.
Dialog: 0,0:27:22.92,0:27:24.02,Default,bir,0,0,0,,Yang Mulia.
Dialog: 0,0:27:25.99,0:27:27.06,Default,bir,0,0,0,,Yang Mulia.
Dialog: 0,0:27:28.59,0:27:29.59,Default,bir,0,0,0,,Yang Mulia.
Dialog: 0,0:27:33.53,0:27:35.63,Default,bir,0,0,0,,Yang Mulia, Yang Mulia!
Dialogue: 0,0:27:37.17,0:27:39.57,Default,bir,0,0,0,,Ratu, apa yang kamu lakukan di sini selarut ini?
Dialogue: 0,0:27:41.67,0:27:44.91,Default,bir,0,0,0,,Kenapa kamu basah kuyup?
Dialogue: 0,0:27:45.98,0:27:49.41,Default,bir,0,0,0,,Apakah mereka benar-benar jatuh ke danau lagi?
Dialogue: 0,0:27:52.08,0:27:53.65,Default,bir,0,0,0,,Mengapa kamu terus melakukan ini?
Dialog: 0,0:27:54.32,0:27:56.89,Default,bir,0,0,0,,Sekarang kamu perlu mengumpulkan kekuatanmu.
Dialogue: 0,0:27:56.89,0:28:00.59,Default,bir,0,0,0,,Jika tidak, mengapa aku berusaha keras sampai sekarang?
Dialogue: 0,0:28:01.43,0:28:05.36,Default,bir,0,0,0,,Kenapa aku harus mengalami penghinaan seperti itu?
Dialog: 0,0:28:05.36,0:28:07.23,Default,bir,0,0,0,,Mengapa Anda membutuhkan ini?
Dialog: 0,0:28:08.23,0:28:10.60,Default,bir,0,0,0,,Untuk keuntungan mereka sendiri,\N untuk mengisi penyimpanan mereka.
Dialogue: 0,0:28:11.64,0:28:14.51,Default,bir,0,0,0,,Kamu menjual putrimu karena keserakahan.
Dialog: 0,0:28:15.17,0:28:17.41,Default,bir,0,0,0,,-Soyeon.\N-Kenapa mereka selalu bertanya padaku
Dialogue: 0,0:28:17.41,0:28:19.71,Default,bir,0,0,0,,untuk menjadi ratu kebanggaan keluarga?
Dialogue: 0,0:28:20.18,0:28:23.11,Default,bir,0,0,0,,Kenapa mereka bilang saat aku menjadi ratu, aku bisa melakukan apapun yang kuinginkan?
Dialogue: 0,0:28:23.85,0:28:26.99,Default,bir,0,0,0,,Kenapa aku harus menderita rasa bersalah atas kematian ibuku,
Dialogue: 0,0:28:26.99,0:28:29.99,Default,bir,0,0,0,,apakah kamu menginspirasi impianmu?
Dialogue: 0,0:28:31.72,0:28:35.09,Default,bir,0,0,0,,Tahukah kamu apa yang kupikirkan saat aku melompat ke danau?
Dialogue: 0,0:28:35.89,0:28:38.73,Default,bir,0,0,0,,Hidup yang kukira milikku ternyata bohong.
Dialogue: 0,0:28:40.10,0:28:42.57,Default,bir,0,0,0,,Bahkan mimpi itu bukan milikku.
Dialogue: 0,0:28:43.74,0:28:45.80,Default,bir,0,0,0,,Aku benar-benar pecundang.
Dialogue: 0,0:28:48.51,0:28:50.68,Default,bir,0,0,0,,Makanya aku kabur.
Dialog: 0,0:28:52.91,0:28:53.95,Default,bir,0,0,0,,Apa?
Dialog: 0,0:28:56.35,0:28:58.15,Default,bir,0,0,0,,Hari impianmu menjadi kenyataan,
Dialogue: 0,0:28:59.35,0:29:01.95,Default,bir,0,0,0,,Aku kehilangan orang yang paling aku sayangi.
Dialog: 0,0:29:03.19,0:29:04.96,Default,bir,0,0,0,,Untuk diriku sendiri.
Dialogue: 0,0:29:05.76,0:29:08.59,Default,bir,0,0,0,,Kaulah yang mendorongku ke danau ini.
Dialog: 0,0:29:33.69,0:29:36.19,Default,bir,0,0,0,,Lebih mudah bagi anak-anak untuk menyalahkan orang tua mereka atas segalanya.
Dialogue: 0,0:29:37.32,0:29:39.22,Default,bir,0,0,0,,Kamu seharusnya tidak menyalahkan ayahmu.
Dialog: 0,0:29:53.64,0:29:54.71,Default,bir,0,0,0,,Yang Mulia.
Dialog: 0,0:30:04.38,0:30:06.12,Default,bir,0,0,0,,Saya harus mengatakan sesuatu.
Dialog: 0,0:30:08.12,0:30:10.46,Default,bir,0,0,0,,Saya tahu Anda akan melakukan segalanya untuk saya.
Dialogue: 0,0:30:11.26,0:30:14.03,Default,bir,0,0,0,,Artinya, saya mengetahuinya.
Dialogue: 0,0:30:14.03,0:30:15.53,Default,bir,0,0,0,,Kenanganku kembali.
Dialog: 0,0:30:23.10,0:30:24.67,Default,bir,0,0,0,,Jangan lakukan apa pun.
Dialog: 0,0:30:25.24,0:30:28.74,Default,bir,0,0,0,,Jika kamu mengkhawatirkanku, jangan lakukan apa pun.
Dialogue: 0,0:30:29.81,0:30:31.34,Default,bir,0,0,0,,Hanya ini yang akan membantuku.
Dialog: 0,0:30:33.21,0:30:34.28,Default,bir,0,0,0,,Soyeon.
Dialogue: 0,0:30:36.21,0:30:37.72,Default,bir,0,0,0,,Jangan panggil namaku.
Dialogue: 0,0:30:38.85,0:30:40.19,Default,bir,0,0,0,,Aku hanya
Dialogue: 0,0:30:41.22,0:30:43.62,Default,bir,0,0,0,,ratu yang dilayani oleh Departemen Detektif.
Dialogue: 0,0:30:58.30,0:31:00.74,Default,bir,0,0,0,,Queen's Dictionary
Dialog: 0,0:31:12.72,0:31:14.65,Default,bir,0,0,0,,panah, lotre, pasukan khusus, polisi dapur, ramen
Dialogue: 0,0:31:14.65,0:31:16.12,Default,bir,0,0,0,,Jarak sosial
Dialogue: 0,0:31:25.13,0:31:27.27,Default,bir,0,0,0,,berarti setiap orang untuk dirinya sendiri.
Dialog: 0,0:31:27.27,0:31:29.37,Default,bir,0,0,0,,pertarungan, teh melati, perilaku buruk.
Dialogue: 0,0:31:49.69,0:31:52.09,Default,bir,0,0,0,,Aku akan berkata sejujurnya, karena kamu tidak bisa mendengarku.
Dialog: 0,0:31:54.69,0:31:56.66,Default,bir,0,0,0,,Saya memutuskan untuk berumur panjang.
Dialog: 0,0:32:00.90,0:32:02.37,Default,bir,0,0,0,,Aku akan mengkhianatimu.
Dialogue: 0,0:32:04.17,0:32:06.37,Default,bir,0,0,0,,Aku memilih jalan yang akan menyelamatkan hidupku.
Dialog: 0,0:32:08.81,0:32:10.14,Default,bir,0,0,0,,Dan jangan mati.
Dialog: 0,0:32:11.14,0:32:12.91,Default,bir,0,0,0,,Pulihkan seolah tidak terjadi apa-apa.
Dialogue: 0,0:32:15.91,0:32:17.38,Default,bir,0,0,0,,Dan kemudian aku bisa menusukmu dari belakang.
Dialogue: 0,0:32:56.52,0:32:57.89,Default,bir,0,0,0,,Kamu benar.
Dialog: 0,0:32:58.76,0:33:01.09,Default,bir,0,0,0,,Raja lebih kuat dari yang ditunjukkannya.
Dialog: 0,0:33:02.09,0:33:03.39,Default,bir,0,0,0,,Maaf soal itu.
Dialogue: 0,0:33:03.39,0:33:05.93,Default,bir,0,0,0,,Apa pendapatmu tentang kasus hari ini?
Dialog: 0,0:33:06.73,0:33:08.90,Default,bir,0,0,0,,Kami menemukan bubuk mesiu di lokasi ledakan.
Dialog: 0,0:33:09.07,0:33:10.70,Default,bir,0,0,0,,-Bubuk mesiu?\N-Ya.
Dialog: 0,0:33:11.24,0:33:13.34,Default,bir,0,0,0,,Ada dua jenis bubuk mesiu di Joseon.
Dialog: 0,0:33:13.54,0:33:15.57,Default,bir,0,0,0,,Yang dikirim dari Kekaisaran Qing.
Dialog: 0,0:33:16.01,0:33:18.21,Default,bir,0,0,0,,Dan lokal dari gudang mesiu.
Dialogue: 0,0:33:18.58,0:33:20.51,Default,bir,0,0,0,,Mereka mempunyai sedikit perbedaan dalam strukturnya.
Dialogue: 0,0:33:20.75,0:33:24.12,Default,bir,0,0,0,,Yang kami temukan adalah lokal.
Dialog: 0,0:33:24.32,0:33:27.35,Default,zina,0,0,0,,Majalah bubuk adalah bagian dari ruang senjata.
Dialog: 0,0:33:28.69,0:33:31.46,Default,zina,0,0,0,,Dan menteri perang bertanggung jawab atas ruang senjata.
Dialogue: 0,0:33:32.36,0:33:34.16,Default,zina,0,0,0,,Dia tangan kanan ayahku.
Dialog: 0,0:33:36.19,0:33:37.46,Default,zina,0,0,0,,Ini berarti...
Dialog: 0,0:33:42.47,0:33:45.54,Default,zina,0,0,0,,Ayahku lah yang membawa raja naik takhta.
Dialog: 0,0:33:46.37,0:33:47.97,Default,zina,0,0,0,,Raja menunjukkan wajah aslinya,
Dialog: 0,0:33:47.97,0:33:49.94,Default,zina,0,0,0,,ayah ingin melenyapkannya sebelum itu menjadi kesalahannya,
Dialog: 0,0:33:49.94,0:33:52.74,Default,zina,0,0,0,,dan membuat penjaga dengan identitas palsu bersalah atas ledakan tersebut.
Dialogue: 0,0:33:53.04,0:33:54.81,Default,zina,0,0,0,,Ini pasti rencananya.
Dialogue: 0,0:33:54.81,0:33:58.22,Default,zina,0,0,0,,Saat kamu datang kepadaku terakhir kali,\N kamu menginginkan sesuatu.
Dialog: 0,0:34:00.05,0:34:01.72,Default,zina,0,0,0,,Jadi apa yang kamu inginkan?
Dialog: 0,0:34:02.22,0:34:04.09,Default,zina,0,0,0,,Saya ingin
Dialog: 0,0:34:07.46,0:34:08.76,Default,zina,0,0,0,,raja.
Dialogue: 0,0:34:17.84,0:34:19.64,Default,zina,0,0,0,,Aku tidak bisa berhenti sekarang.
Dialogue: 0,0:34:20.87,0:34:22.81,Default,zina,0,0,0,,Dan jika itu yang kamu rasakan, Soyeon,
Dialog: 0,0:34:24.18,0:34:25.28,Default,zina,0,0,0,,ini alasan lainnya.
Dialog: 0,0:34:47.07,0:34:50.23,Default,zina,0,0,0,,Saya datang ke sini untuk memberi tahu Anda tentang\N apa yang dilakukan ratu kemarin.
Dialogue: 0,0:34:51.50,0:34:55.11,Default,zina,0,0,0,,Dia menyelamatkan pesta yang hampir gagal.
Dialogue: 0,0:34:55.81,0:34:58.41,Default,zina,0,0,0,,Apa menurutmu aku akan mempercayaimu?
Dialog: 0,0:34:58.91,0:35:01.05,Default,zina,0,0,0,,Anda mungkin berpikir,
Dialog: 0,0:35:01.05,0:35:03.18,Default,zina,0,0,0,,akulah yang menyebabkan insiden dengan raja.
Dialog: 0,0:35:03.18,0:35:05.25,Default,zina,0,0,0,,Jika dicentang, Anda akan dengan mudah menemukan jawabannya.
Dialogue: 0,0:35:05.88,0:35:09.12,Default,zina,0,0,0,,Seperti yang kuketahui, kamu ingin merusak pestanya.
Dialogue: 0,0:35:09.45,0:35:11.52,Default,zina,0,0,0,,Bahkan jika ratu dicabut gelarnya...
Dialog: 0,0:35:11.52,0:35:13.46,Default,zina,0,0,0,,Saya tidak memerlukan judul apa pun.
Dialog: 0,0:35:14.03,0:35:18.00,Default,zina,0,0,0,,Aku hanya ingin ratu menghilang dari pandangan raja.
Dialog: 0,0:35:19.33,0:35:20.60,Default,zina,0,0,0,,Artinya,
Dialog: 0,0:35:21.90,0:35:24.27,Default,zina,0,0,0,,bahwa raja menyukai ratu.
Dialogue: 0,0:36:36.94,0:36:39.48,Default,zina,0,0,0,,Dari kelihatannya, kamu mengalami kesulitan.
Dialogue: 0,0:36:40.51,0:36:42.81,Default,zina,0,0,0,,Apakah kamu begitu mengkhawatirkan raja?
Dialog: 0,0:36:44.32,0:36:45.35,Default,zina,0,0,0,,Ya Tuhan.
Dialogue: 0,0:36:46.38,0:36:48.22,Default,zina,0,0,0,,Dia baru saja menjadi menantumu.
Dialogue: 0,0:36:48.62,0:36:50.46,Default,zina,0,0,0,,Kamu sepertinya sudah terikat padanya.
Dialogue: 0,0:36:50.66,0:36:51.72,Default,zina,0,0,0,,Nah,
Dialogue: 0,0:36:54.13,0:36:55.23,Default,zina,0,0,0,,jujur saja,
Dialogue: 0,0:36:55.96,0:36:59.26,Default,zina,0,0,0,,Aku melakukan sesuatu yang akan mempermalukan keluarga kita.
Dialog: 0,0:37:00.63,0:37:03.47,Default,zina,0,0,0,,Saya menyimpan catatan harta benda keluarga kami yang diperoleh secara ilegal.
Dialogue: 0,0:37:05.10,0:37:06.64,Default,zina,0,0,0,,Dan aku kehilangannya.
Dialogue: 0,0:37:07.27,0:37:08.34,Default,zina,0,0,0,,Apa?
Dialog: 0,0:37:08.34,0:37:10.14,Default,zina,0,0,0,,Saya menemukan di mana buku itu sekarang.
Dialog: 0,0:37:10.51,0:37:12.71,Default,zina,0,0,0,,Aku hanya perlu menemukannya dan menyingkirkannya.
Dialog: 0,0:37:13.61,0:37:16.61,Default,zina,0,0,0,,Tapi aku memintamu untuk mengampuni ratu.
Dialogue: 0,0:37:17.92,0:37:20.28,Default,zina,0,0,0,,Kenapa kamu tiba-tiba menyebutkannya?
Dialogue: 0,0:37:20.28,0:37:21.62,Default,zina,0,0,0,,Orang yang sekarang punya buku,
Dialog: 0,0:37:23.22,0:37:24.49,Default,zina,0,0,0,,inilah rajanya.
Dialogue: 0,0:37:26.42,0:37:29.33,Default,zina,0,0,0,,Sang Ratu tidak ada\N hubungannya dengan situasi ini.
Dialog: 0,0:37:29.69,0:37:33.06,Default,zina,0,0,0,,Raja menyesatkan dia dan aku.
Dialog: 0,0:37:35.97,0:37:38.54,Default,zina,0,0,0,,Ya, dia menyesatkan semua orang.
Dialog: 0,0:37:38.77,0:37:42.01,Default,zina,0,0,0,,Aku akan menerima hukumanmu apa pun.
Dialog: 0,0:37:43.11,0:37:44.18,Default,zina,0,0,0,,Tapi
Dialogue: 0,0:37:46.31,0:37:47.65,Default,zina,0,0,0,,kasihanilah Soyeon.
Dialog: 0,0:37:49.11,0:37:51.02,Default,zina,0,0,0,,Sisi ratu.
Dialog: 0,0:37:52.12,0:37:54.99,Default,zina,0,0,0,,Saya mohon, ampuni ratu.
Dialog: 0,0:37:59.06,0:38:00.12,Default,zina,0,0,0,,Ayah.
Dialogue: 0,0:38:05.33,0:38:07.53,Default,zina,0,0,0,,Apakah kamu tidur di Departemen Detektif?
Dialog: 0,0:38:07.53,0:38:11.14,Default,zina,0,0,0,,Ya. Ini masalah besar, banyak pekerjaan yang harus saya selesaikan.
Dialog: 0,0:38:11.74,0:38:15.44,Default,zina,0,0,0,,Segala sesuatu dalam kasus ini menunjuk pada saya sebagai penjahat.
Dialogue: 0,0:38:16.11,0:38:18.24,Default,zina,0,0,0,,Tapi kamu tidak membicarakannya.
Dialog: 0,0:38:19.04,0:38:20.31,Default,zina,0,0,0,,Jangan khawatir.
Dialog: 0,0:38:21.15,0:38:23.55,Default,zina,0,0,0,,Departemen detektif telah melakukan penyelidikan.
Dialogue: 0,0:38:23.55,0:38:25.22,Default,zina,0,0,0,,Jika anda difitnah,
Dialog: 0,0:38:25.58,0:38:27.99,Default,zina,0,0,0,,Saya akan mengungkap pelaku sebenarnya dari kejadian ini.
Dialogue: 0,0:38:28.62,0:38:30.02,Default,zina,0,0,0,,Ini menenangkan.
Dialogue: 0,0:38:31.72,0:38:33.16,Default,zina,0,0,0,,Baru-baru ini
Dialog: 0,0:38:33.46,0:38:37.20,Default,zina,0,0,0,,Anda mengatakan bahwa Anda telah memutuskan\N skala impian Anda.
Dialogue: 0,0:38:38.46,0:38:41.00,Default,zina,0,0,0,,Jadi seberapa besar impianmu?
Dialogue: 0,0:38:43.27,0:38:44.87,Default,zina,0,0,0,,Mimpiku -
Dialogue: 0,0:38:46.34,0:38:48.94,Default,zina,0,0,0,,menjadi setidaknya setengah sukses darimu.
Dialogue: 0,0:38:55.38,0:38:57.58,Default,zina,0,0,0,,Sudah terlambat. Istirahat.
Dialogue: 0,0:39:20.91,0:39:21.97,Default,zina,0,0,0,,Jangan mendekat.
Dialog: 0,0:39:22.51,0:39:24.04,Default,zina,0,0,0,,Jika kamu mengikutiku, aku akan bunuh diri.
Dialog: 0,0:39:28.65,0:39:29.68,Default,zina,0,0,0,,Soyeon.
Dialog: 0,0:39:41.59,0:39:46.46,Default,zina,0,0,0,,Saya tahu apa yang memotivasi Anda.
Dialogue: 0,0:40:14.83,0:40:18.06,Default,zina,0,0,0,,Jadi dimana ratu pagi-pagi sekali?
Dialog: 0,0:40:18.30,0:40:19.83,Default,zina,0,0,0,,Dia ada di dapur kerajaan.
Dialog: 0,0:40:20.33,0:40:21.43,Default,zina,0,0,0,,Sekarang.
Dialog: 0,0:40:22.60,0:40:23.60,Default,zina,0,0,0,,Tidak Ada.
Dialogue: 0,0:40:24.34,0:40:27.20,Default,zina,0,0,0,,Aku ingin dia menyiapkan sarapan untukku ketika dia bangun.
Dialogue: 0,0:40:27.47,0:40:30.21,Default,zina,0,0,0,,Dan dia sudah memasak untuk neneknya, begitulah.
Dialogue: 0,0:40:51.50,0:40:52.70,Default,zina,0,0,0,,Itu membuatku takut.
Dialog: 0,0:40:52.93,0:40:55.67,Default,zina,0,0,0,,Masih terlalu dini. Masak apa?
Dialogue: 0,0:40:55.90,0:40:58.50,Default,zina,0,0,0,,Aku sangat depresi akhir-akhir ini.\N Dan aku tidak bisa tidur.
Dialog: 0,0:40:58.67,0:41:00.64,Default,zina,0,0,0,,Seolah-olah aku sedang berdoa subuh,
Dialog: 0,0:41:00.64,0:41:02.27,Default,zina,0,0,0,,Saya membuat hidangan yang sangat mengganggu,
Dialog: 0,0:41:02.27,0:41:04.61,Default,zin,0,0,0,,yang perlu dihancurkan dan dicampur jutaan kali.
Dialogue: 0,0:41:05.68,0:41:08.11,Default,zina,0,0,0,,Tapi bubur nasinya terlihat aneh.
Dialog: 0,0:41:08.11,0:41:10.92,Default,zina,0,0,0,,Ini bukan bubur nasi. Ini adalah ramuan.
Dialogue: 0,0:41:11.28,0:41:12.85,Default,zina,0,0,0,,Lidah tidak jelas? Ini masih pagi.
Dialogue: 0,0:41:12.85,0:41:15.15,Default,zina,0,0,0,,Artinya “bubur wortel”.
Dialog: 0,0:41:15.42,0:41:18.22,Default,zina,0,0,0,,Tunggu, saya perlu menuliskannya.
Dialog: 0,0:41:19.79,0:41:20.93,Default,zina,0,0,0,,Dan bagaimana cara melakukannya?
Dialog: 0,0:41:21.03,0:41:25.26,Default,zina,0,0,0,,Anda perlu memotong bawang bombay dan wortel dan memasaknya selama satu jam dalam air.
Dialog: 0,0:41:25.26,0:41:26.93,Default,zina,0,0,0,,Lalu haluskan dalam lesung.
Dialog: 0,0:41:26.93,0:41:29.23,Default,zina,0,0,0,,Seolah-olah kamu menghancurkan semua\N pengalaman dan ilusi.
Dialog: 0,0:41:29.77,0:41:33.47,Default,zina,0,0,0,,Lalu aduk dengan api kecil agar tidak gosong dan tidak menggumpal.
Dialog: 0,0:41:33.47,0:41:35.14,Default,zina,0,0,0,,Dengan rasa pengembangan diri.
Dialogue: 0,0:41:35.91,0:41:38.11,Default,zina,0,0,0,,Bumbui dengan garam
Dialog: 0,0:41:40.14,0:41:41.98,Default,zina,0,0,0,,dan tambahkan sedikit susu.
Dialogue: 0,0:41:41.98,0:41:43.41,Default,zina,0,0,0,,Bahkan susu?
Dialog: 0,0:41:43.51,0:41:45.02,Default,zina,0,0,0,,Itu saja?
Dialog: 0,0:41:45.22,0:41:46.32,Default,zina,0,0,0,,Tidak.
Dialog: 0,0:41:46.78,0:41:50.82,Default,zina,0,0,0,,Anda perlu menyiapkan sup sayuran terlebih dahulu.
Dialogue: 0,0:41:51.19,0:41:52.59,Default,zina,0,0,0,,Ambil kuahnya
Dialog: 0,0:41:53.56,0:41:56.53,Default,zina,0,0,0,,dan tambahkan sedikit ke dalam bubur untuk rasa yang kaya.
Dialogue: 0,0:41:56.66,0:41:59.16,Default,zina,0,0,0,,Kamu pasti bingung mau nambah sedikit saja?
Dialogue: 0,0:41:59.16,0:42:02.10,Default,zina,0,0,0,,Sudah kubilang. Ini seperti sholat subuh.
Dialogue: 0,0:42:04.90,0:42:07.14,Default,zina,0,0,0,,Kau mencurahkan hati dan jiwamu ke dalam ini.
Dialog: 0,0:42:07.14,0:42:10.74,Default,zina,0,0,0,,Saya yakin raja akan segera sadar begitu dia mencobanya.
Dialog: 0,0:42:11.84,0:42:12.88,Default,zina,0,0,0,,Ini bukan untuk dia.
Dialog: 0,0:42:16.01,0:42:18.88,Default,zina,0,0,0,,Apa yang harus diderita dua kali, saya akan mencari tahu dalam satu gerakan.
Dialogue: 0,0:42:19.25,0:42:21.69,Default,zina,0,0,0,,Karena aku memberitahunya sesuatu terakhir kali,
Dialogue: 0,0:42:21.72,0:42:25.36,Default,zina,0,0,0,,memaksa aku makan bersama ibu mertuaku?
Dialog: 0,0:42:26.19,0:42:30.09,Default,zina,0,0,0,,Dia berani mengatakan dengan mulut bandelnya bahwa aku sudah tua,
Dialogue: 0,0:42:30.36,0:42:32.26,Default,zina,0,0,0,,haruskah aku melihatnya besok pagi?
Dialogue: 0,0:42:38.64,0:42:40.27,Default,zina,0,0,0,,Apa ini?
Dialog: 0,0:42:40.27,0:42:41.84,Default,zina,0,0,0,,Ini makan siang.
Dialogue: 0,0:42:42.41,0:42:43.81,Default,zina,0,0,0,,Brunch?
Dialogue: 0,0:42:43.97,0:42:46.14,Default,zina,0,0,0,,Berarti “perempuan bertemu bersama.”
Dialogue: 0,0:42:46.38,0:42:48.55,Default,zina,0,0,0,,Inilah waktunya para wanita berkumpul untuk sarapan
Dialog: 0,0:42:48.55,0:42:50.65,Default,zina,0,0,0,,dan mendekatkan satu sama lain.
Dialogue: 0,0:42:50.95,0:42:53.75,Default,zina,0,0,0,,Semua orang tahu apa itu.
Dialogue: 0,0:42:53.75,0:42:55.52,Default,zina,0,0,0,,Sepertinya kamu bukan dari Gojoseon.
Dialogue: 0,0:42:55.59,0:42:56.69,Default,zina,0,0,0,,Brengsek.
Dialogue: 0,0:42:57.86,0:43:00.79,Default,zina,0,0,0,,Dulu aku sering melakukan ini di rumah.
Dialogue: 0,0:43:01.19,0:43:02.46,Default,zina,0,0,0,,Itu sudah lama sekali.
Dialogue: 0,0:43:03.36,0:43:04.63,Default,zina,0,0,0,,Brengsek.
Dialogue: 0,0:43:07.47,0:43:09.57,Default,zina,0,0,0,,Ini bubur wortel.
Dialog: 0,0:43:09.83,0:43:12.37,Default,zina,0,0,0,,Berisi banyak produk yang\N akan membantu meningkatkan penglihatan.
Dialog: 0,0:43:12.37,0:43:13.44,Default,zina,0,0,0,,Ya?
Dialog: 0,0:43:14.14,0:43:15.81,Default,zina,0,0,0,,Ibu Suri, makan lebih banyak.
Dialogue: 0,0:43:15.81,0:43:18.18,Default,zina,0,0,0,,Sepertinya akhir-akhir ini kamu menjadi buta.
Dialogue: 0,0:43:18.18,0:43:22.21,Default,zina,0,0,0,,Kalau begitu, menurutku ratu perlu makan semuanya.
Dialogue: 0,0:43:23.45,0:43:25.08,Default,zina,0,0,0,,Apa itu? Mengapa mereka begitu sombong?
Dialogue: 0,0:43:33.46,0:43:34.89,Default,zina,0,0,0,,Enak sekali.
Dialog: 0,0:43:41.23,0:43:42.73,Default,zina,0,0,0,,Dapat dimakan.
Dialog: 0,0:43:44.17,0:43:45.70,Default,zina,0,0,0,,Mulai sekarang
Dialogue: 0,0:43:45.70,0:43:48.24,Default,zina,0,0,0,,Saya akan pastikan\Nkita lebih sering berkumpul.
Dialog: 0,0:43:48.24,0:43:50.41,Default,zina,0,0,0,,-Bajingan.\N-Bajingan sekali.
Dialogue: 0,0:43:50.47,0:43:52.48,Default,zina,0,0,0,,Kalau begitu aku minta maaf.
Dialog: 0,0:43:54.61,0:43:56.28,Default,zina,0,0,0,,Aku akan membawakanmu minuman.
Dialog: 0,0:44:05.16,0:44:09.53,Default,zina,0,0,0,,Rumor tentang keahlian kuliner ratu agak berlebihan.
Dialogue: 0,0:44:09.83,0:44:12.93,Default,zina,0,0,0,,Kemampuan mengenali makanan yang baik merupakan salah satu komponen keluhuran budi.
Dialog: 0,0:44:13.53,0:44:18.10,Default,zina,0,0,0,,Apakah kamu membiarkan ratu melakukan segalanya\N hanya untuk bakat ini?
Dialogue: 0,0:44:18.10,0:44:21.01,Default,zina,0,0,0,,Karena kaulah yang menyampaikan kepadaku kata-kata ratu,
Dialogue: 0,0:44:21.57,0:44:23.27,Default,zina,0,0,0,,Aku tak percaya.
Dialog: 0,0:44:24.68,0:44:28.75,Default,zina,0,0,0,,Tentu saja Anda tidak akan percaya dengan apa yang saya katakan.
Dialog: 0,0:44:29.05,0:44:31.72,Default,zina,0,0,0,,Saya mendengar raja dan ratu
Dialog: 0,0:44:32.42,0:44:35.22,Default,zina,0,0,0,,kami diam-diam bertukar catatan sepanjang malam.
Dialogue: 0,0:44:35.62,0:44:39.09,Default,zina,0,0,0,,Aku ingin tahu apa yang mereka tulis satu sama lain?
Dialog: 0,0:44:40.89,0:44:43.86,Default,zina,0,0,0,,Aku akan membawakan minumanmu.
Dialog: 0,0:44:52.77,0:44:54.51,Default,zina,0,0,0,,Ini adalah minuman yang terbuat dari anggur dan berbagai buah-buahan,
Dialog: 0,0:44:54.51,0:44:57.68,Default,zina,0,0,0,,direbus dengan adas manis dan kayu manis.
Dialog: 0,0:44:58.58,0:45:00.38,Default,zina,0,0,0,,Anggur di pagi hari?
Dialog: 0,0:45:00.41,0:45:02.01,Default,zina,0,0,0,,Semua alkohol telah menguap,
Dialog: 0,0:45:02.01,0:45:04.85,Default,zina,0,0,0,,hanya tersisa produk yang membantu menjaga awet muda.
Dialogue: 0,0:45:05.45,0:45:09.02,Default,zina,0,0,0,,Ini lebih merupakan obat daripada minuman.
Dialogue: 0,0:45:16.99,0:45:19.13,Default,zina,0,0,0,,Saya tidak percaya Anda berpikir untuk membuat anggur.
Dialogue: 0,0:45:19.60,0:45:22.50,Default,zina,0,0,0,,Bagaimana kamu mendapatkan ide ini?
Dialogue: 0,0:45:22.83,0:45:27.07,Default,zina,0,0,0,,Dari mana kamu mendapatkan inspirasi masakanmu?
Dialog: 0,0:45:27.07,0:45:31.38,Default,zina,0,0,0,,Saya tidak tahu harus menyebutnya inspirasi atau kreasi.
Dialog: 0,0:45:31.38,0:45:34.45,Default,zina,0,0,0,,Saat aku melihat ramuannya, aku langsung berpikir tentang
Dialog: 0,0:45:34.45,0:45:36.01,Default,zina,0,0,0,,cara mempertahankan rasa aslinya.
Dialogue: 0,0:45:36.45,0:45:38.88,Default,zina,0,0,0,,Saat ini mereka waspada terhadap Barat,
Dialog: 0,0:45:38.88,0:45:40.65,Default,zina,0,0,0,,jadi saya tidak akan mengatakan bahwa ini adalah masakan Prancis.
Dialog: 0,0:45:46.92,0:45:47.93,Default,menembak,0,0,0,,Ny.
Dialog: 0,0:45:53.90,0:45:55.43,Default,menembak,0,0,0,,Halo pak.
Dialog: 0,0:45:56.90,0:45:59.74,Default,menembak,0,0,0,,Aku menunggumu bicara.
Dialog: 0,0:45:59.74,0:46:02.74,Default,menembak,0,0,0,,Apa? Apa yang ingin kamu bicarakan?
Dialog: 0,0:46:02.74,0:46:05.01,Default,menembak,0,0,0,,Setelah insiden dengan raja
Dialog: 0,0:46:05.74,0:46:07.54,Default,menembak,0,0,0,,Aku diliputi oleh pemikiran yang berbeda.
Dialog: 0,0:46:09.15,0:46:11.32,Default,menembak,0,0,0,,Tidak ada yang tahu apa yang akan terjadi selanjutnya,
Dialogue: 0,0:46:11.88,0:46:14.75,Default,shooting,0,0,0,,dan besok mungkin yang terakhir.
Dialog: 0,0:46:14.95,0:46:18.12,Default,menembak,0,0,0,,Jika hidupku berakhir besok,
Dialogue: 0,0:46:19.36,0:46:21.63,Default,shooting,0,0,0,,apa yang paling aku sesali?
Dialog: 0,0:46:21.89,0:46:25.13,Default,tira,0,0,0,,Tentang perasaan yang tidak bisa kuungkapkan,
Dialogue: 0,0:46:25.70,0:46:27.16,Default,shooting,0,0,0,,karena aku meragukannya.
Dialog: 0,0:46:27.53,0:46:28.87,Default,tira,0,0,0,,Satu kata yang tulus
Dialog: 0,0:46:29.37,0:46:31.50,Default,menembak,0,0,0,,lebih baik daripada pengakuan canggih mana pun.
Dialogue: 0,0:46:33.70,0:46:34.87,Default,dash,0,0,0,,Oleh karena itu
Dialog: 0,0:46:37.81,0:46:39.31,Default,menembak,0,0,0,,Aku ingin memberitahumu,
Dialog: 0,0:46:40.61,0:46:41.75,Default,menembak,0,0,0,,bahwa aku mencintaimu.
Dialog: 0,0:46:51.49,0:46:53.06,Default,menembak,0,0,0,,Aku tidak menyukaimu.
Dialog: 0,0:46:53.49,0:46:54.53,Default,menembak,0,0,0,,Apa?
Dialog: 0,0:46:55.59,0:46:56.79,Default,jarak tembak,0,0,0,,Tentang bubuk mesiu.
Dialog: 0,0:46:57.39,0:46:59.50,Default,jarak tembak,0,0,0,,Jumlah bubuk mesiu yang diproduksi di selatan
Dialog: 0,0:46:59.50,0:47:00.76,Default,galeri tembak,0,0,0,,Provinsi Gyeongsang,
Dialog: 0,0:47:01.10,0:47:03.73,Default,dash,0,0,0,,dan jumlah yang sampai di gudang berbeda.
Dialogue: 0,0:47:05.17,0:47:06.47,Default,menembak,0,0,0,,Aku mengetahuinya.
Dialog: 0,0:47:12.11,0:47:13.94,Default,menembak,0,0,0,,Apakah raja masih pingsan?
Dialog: 0,0:47:14.48,0:47:15.55,Default,menembak,0,0,0,,Ya.
Dialog: 0,0:47:16.21,0:47:19.32,Default,menembak,0,0,0,,Kudengar dia kehilangan pendengarannya. Ini akan menjadi masalah di masa depan.
Dialog: 0,0:47:22.95,0:47:25.12,Default,menembak,0,0,0,,Tentang insiden dengan raja ini.
Dialog: 0,0:47:25.72,0:47:27.83,Default,jarak tembak,0,0,0,,Untuk ledakan sebesar ini
Dialog: 0,0:47:29.16,0:47:30.83,Default,jarak tembak,0,0,0,,menggunakan bubuk mesiu?
Dialog: 0,0:47:31.76,0:47:32.83,Default,menembak,0,0,0,,Saya tidak yakin.
Dialog: 0,0:47:33.26,0:47:36.93,Default,menembak,0,0,0,,Bisa jadi belerang atau gas yang mudah meledak.
Dialog: 0,0:47:37.63,0:47:39.57,Default,menembak,0,0,0,,Kalau belerang pasti ada baunya,
Dialog: 0,0:47:39.57,0:47:41.51,Default,menembak,0,0,0,,agar raja memperhatikannya.
Dialog: 0,0:47:41.61,0:47:43.61,Default,menembak,0,0,0,,Kalau gas, pasti sulit
Dialogue: 0,0:47:43.61,0:47:46.18,Default,shooting gallery,0,0,0,,mencegah bocor dan meledakkan semuanya sekaligus.
Dialog: 0,0:47:46.28,0:47:48.95,Default,tempat menembak,0,0,0,,Pelaku diinterogasi, tapi mereka tidak mengaku.
Dialog: 0,0:47:48.95,0:47:50.48,Default,menembak,0,0,0,,Sulit untuk mengetahui siapa dalang di balik ini.
Dialog: 0,0:48:21.75,0:48:24.72,Default,tyra,0,0,0,,Saat aku melihat bahan-bahannya, aku langsung berpikir tentang
Dialog: 0,0:48:24.72,0:48:26.55,Default,tyra,0,0,0,,cara mempertahankan rasa aslinya.
Dialog: 0,0:48:29.79,0:48:31.22,Default,menembak,0,0,0,,Tidak bisa.
Dialogue: 0,0:48:31.72,0:48:33.82,Default,menembak,0,0,0,,Bersalah atas pengkhianatan
Dialog: 0,0:48:33.82,0:48:35.89,Default,galeri tembak,0,0,0,,mengungkapkan pemimpinnya?
Dialog: 0,0:48:36.69,0:48:39.96,Default,jarak tembak,0,0,0,,Sepertinya penjaga berpangkat rendah\N menentang Istana Kerajaan,
Dialog: 0,0:48:39.96,0:48:41.93,Default, lapangan tembak,0,0,0,,berkumpul dan menyebabkan ledakan.
Dialog: 0,0:48:41.97,0:48:43.07,Default,menembak,0,0,0,,Benarkah?
Dialog: 0,0:48:43.63,0:48:46.97,Default,galeri tembak,0,0,0,,Kamu bilang tidak ada orang di belakang mereka?
Dialogue: 0,0:48:47.70,0:48:50.41,Default,menembak,0,0,0,,Dalam masalah besar seperti pembunuhan seorang raja?
Dialog: 0,0:48:50.41,0:48:51.78,Default,menembak,0,0,0,,Ini tidak mungkin.
Dialogue: 0,0:48:52.38,0:48:55.48,Default,menembak,0,0,0,,Kita harus takut pada kebanyakan orang yang tidak akan rugi apa-apa.
Dialog: 0,0:48:55.48,0:48:57.71,Default,jarak tembak,0,0,0,,Mungkin mereka percaya\Nbahwa mereka tidak bisa naik lebih tinggi,
Dialog: 0,0:48:57.71,0:48:59.98,Default,menembak,0,0,0,,jadi kami memutuskan untuk mengubah situasi secara radikal.
Dialog: 0,0:48:59.98,0:49:01.69,Default,menembak,0,0,0,,Mungkin inilah alasannya.
Dialog: 0,0:49:02.82,0:49:05.79,Default,menembak,0,0,0,,Itu masuk akal. Tindakan pengkhianatan untuk tujuan penobatan
Dialog: 0,0:49:05.79,0:49:08.89,Default,menembak,0,0,0,,saudara tiri raja, Lee Wong-gyong,
Dialog: 0,0:49:08.89,0:49:11.36,Default,menembak,0,0,0,,juga dilakukan oleh penjaga berpangkat rendah.
Dialog: 0,0:49:12.36,0:49:14.20,Default,menembak,0,0,0,,Mengingat raja tidak sadarkan diri,
Dialogue: 0,0:49:14.20,0:49:16.73,Default,shooting,0,0,0,,semakin lama kita menundanya, akan semakin banyak kebingungan yang terjadi.
Dialogue: 0,0:49:16.83,0:49:17.97,Default,dash,0,0,0,,Oleh karena itu
Dialog: 0,0:49:18.34,0:49:21.24,Default,menembak,0,0,0,,tujuh pelaku akan bertanggung jawab penuh
Dialog: 0,0:49:23.41,0:49:26.11,Default,menembak,0,0,0,,dan akan dijatuhi hukuman mati.
Dialog: 0,0:49:34.45,0:49:37.72,Default,menembak,0,0,0,,Untuk mencoba membunuh raja\Ndan merencanakan pengkhianatan
Dialog: 0,0:49:39.19,0:49:40.96,Default,menembak,0,0,0,,kamu dijatuhi hukuman mati.
Dialog: 0,0:49:42.56,0:49:44.53,Default,menembak,0,0,0,,Apakah kamu punya kata terakhir?
Dialogue: 0,0:49:49.70,0:49:51.97,Default,menembak,0,0,0,,Jika kamu menjatuhkan hukuman mati pada mereka,
Dialog: 0,0:49:52.34,0:49:55.37,Default,menembak,0,0,0,,kamu tidak akan pernah tahu siapa dalang di balik semua ini.
Dialogue: 0,0:49:55.87,0:49:58.08,Default,menembak,0,0,0,,Mereka bilang tidak ada orang di balik ini.
Dialog: 0,0:49:58.91,0:50:00.24,Default,menembak,0,0,0,,Ini keputusan yang ceroboh...
Dialogue: 0,0:50:00.24,0:50:03.65,Default,shooting,0,0,0,,Keputusan ini dibuat setelah malam investigasi.
Dialog: 0,0:50:06.08,0:50:07.25,Default,tanda hubung,0,0,0,,
Dialog: 0,0:51:02.84,0:51:03.91,Default,galeri tembak,0,0,0,,Memenggal kepala.
Dialog: 0,0:51:05.84,0:51:06.84,Default,jarak tembak,0,0,0,,Berhenti.
Dialog: 0,0:51:14.22,0:51:16.65,Default,penembakan,0,0,0,,Investigasi dilakukan\N atas perintah kerajaan.
Dialogue: 0,0:51:17.22,0:51:18.92,Default,shooting gallery,0,0,0,,Apakah kamu akan mengganggu kami?
Dialogue: 0,0:51:19.12,0:51:21.39,Default,shooting gallery,0,0,0,,Lepaskan orang tak bersalah segera.
Dialog: 0,0:51:23.43,0:51:25.03,Default,menembak,0,0,0,,Ini perintah sebenarnya.
Dialog: 0,0:51:35.84,0:51:36.97,Default,menembak,0,0,0,,Maaf saya terlambat.
Dialog: 0,0:51:37.67,0:51:38.71,Default,menembak,0,0,0,,Kamu...
Dialog: 0,0:51:41.78,0:51:45.98,Default,menembak,0,0,0,,Kudengar kamu tidak sadarkan diri.
Dialog: 0,0:51:46.32,0:51:48.99,Default,menembak,0,0,0,,Saya muda dan penuh kekuatan,
Dialogue: 0,0:51:49.35,0:51:50.99,Default,shooting,0,0,0,,jadi cepat pulih.
Dialog: 0,0:51:55.23,0:51:57.49,Default,menembak,0,0,0,,Aku tidak ingin berbaring di sana dengan sia-sia
Dialog: 0,0:51:57.49,0:51:59.53,Default,menembak,0,0,0,,dan pulih di tempat tidur.
Dialogue: 0,0:51:59.76,0:52:01.13,Default,shooting,0,0,0,,Jadi aku mencarinya
Dialog: 0,0:52:01.13,0:52:03.83,Default,menembak,0,0,0,,yang berencana membunuhku.
Dialogue: 0,0:52:04.30,0:52:08.07,Default,shooting,0,0,0,,Pertama aku tahu tentangmu.
Dialog: 0,0:52:08.64,0:52:12.64,Default,jarak tembak,0,0,0,,Apakah Anda ingin mengatakan bahwa Anda sudah memeriksa kami?
Dialog: 0,0:52:13.21,0:52:15.28,Default,menembak,0,0,0,,Seseorang merencanakan pengkhianatan.
Dialog: 0,0:52:16.25,0:52:18.32,Default,menembak,0,0,0,,Katakan bahwa kehidupan pribadimu lebih penting,
Dialog: 0,0:52:19.38,0:52:23.45,Default,menembak,0,0,0,,daripada kehidupan seorang raja?
Dialog: 0,0:52:24.39,0:52:26.49,Default,menembak,0,0,0,,Tidak, itu tidak benar.
Dialog: 0,0:52:28.33,0:52:31.16,Default,menembak,0,0,0,,Jika tidak ada yang disembunyikan, maka tidak ada yang perlu ditakutkan.
Dialog: 0,0:52:35.00,0:52:36.33,Default,jarak tembak,0,0,0,,Jangan khawatir.
Dialog: 0,0:52:37.50,0:52:39.70,Default,galeri tembak,0,0,0,,Saya menemukan pemimpinnya.
Dialog: 0,0:52:40.94,0:52:42.57,Default,menembak,0,0,0,,-Apa yang dia bicarakan?\N-Apa yang terjadi?
Dialog: 0,0:52:48.01,0:52:50.51,Default,tyra,0,0,0,,Dalam bakhurnitsa yang digunakan dalam upacara,
Dialog: 0,0:52:51.11,0:52:53.55,Default,jarak tembak,0,0,0,,bubuk mesiu ditemukan, dalam jumlah besar.
Dialog: 0,0:52:53.82,0:52:56.39,Default,jarak tembak,0,0,0,,-Bubuk mesiu?\N-Bubuk mesiu?
Dialog: 0,0:52:59.26,0:53:00.32,Default,jarak tembak,0,0,0,,Jumlah besar?
Dialogue: 0,0:53:06.16,0:53:08.63,Default,shooting gallery,0,0,0,,Mellow akan menjadi bom yang sangat besar.
Dialog: 0,0:53:09.03,0:53:11.67,Default, galeri menembak,0,0,0,,-Ini terlalu berbahaya.\N-Semuanya sudah diputuskan.
Dialog: 0,0:53:12.10,0:53:14.04,Default,menembak,0,0,0,,Melacak asal usul bubuk mesiu,
Dialog: 0,0:53:14.67,0:53:16.31,Default,menembak,0,0,0,,Saya menerima informasi,
Dialog: 0,0:53:16.31,0:53:19.88,Default,menembak,0,0,0,,bahwa bubuk mesiu\N diperdagangkan secara tidak resmi di pelabuhan Tonne.
Dialog: 0,0:53:26.05,0:53:29.25,Default,jarak tembak,0,0,0,,Ngomong-ngomong, kenapa kamu membutuhkan begitu banyak bubuk mesiu?
Dialog: 0,0:53:29.45,0:53:33.22,Default,menembak,0,0,0,,Untuk menyerang Joseon lagi beberapa saat kemudian.
Dialog: 0,0:53:36.86,0:53:38.13,Default,menembak,0,0,0,,Terima kasih.
Dialog: 0,0:53:38.93,0:53:40.73,Default,menembak,0,0,0,,-Terima kasih?\N-Terima kasih.
Dialog: 0,0:53:42.53,0:53:44.73,Default,menembak,0,0,0,,-Terima kasih.\N-Terima kasih.
Dialog: 0,0:53:45.57,0:53:47.87,Default,menembak,0,0,0,,Terima kasih.
Dialog: 0,0:53:48.54,0:53:51.21,Default,jarak tembak,0,0,0,,Dari mana bubuk mesiu ini berasal?
Dialogue: 0,0:53:51.54,0:53:53.41,Default,menembak,0,0,0,,Ini diproduksi hanya untuk keperluan militer.
Dialog: 0,0:53:53.41,0:53:56.18,Default,menembak,0,0,0,,Tidak boleh diproduksi untuk penggunaan pribadi dengan cara apa pun,
Dialog: 0,0:53:56.55,0:53:58.68,Default,menembak,0,0,0,,bagaimanapun juga, ini adalah produk yang berbahaya dan berharga.
Dialog: 0,0:54:00.22,0:54:04.29,Default,jarak tembak,0,0,0,,Jadi, aku melihat semua tempat pembuatan bubuk mesiu di Joseon.
Dialog: 0,0:54:04.96,0:54:06.72,Default,menembak,0,0,0,,Dan saya menemukan sesuatu yang aneh.
Dialog: 0,0:54:08.33,0:54:10.86,Default,menembak,0,0,0,,Di area tertentu di area produksi
Dialog: 0,0:54:10.86,0:54:15.23,Default, lapangan tembak,0,0,0,,terusan mengantongi sejumlah bubuk mesiu.
Dialog: 0,0:54:17.57,0:54:19.64,Default,jarak tembak,0,0,0,,Jumlah bubuk mesiu yang disembunyikan
Dialogue: 0,0:54:19.64,0:54:23.41,Default,dash,0,0,0,,awalnya kecil, namun berkembang seiring berjalannya waktu.
Dialog: 0,0:54:23.77,0:54:24.84,Default,tanda hubung,0,0,0,,Langsung
Dialog: 0,0:54:26.08,0:54:28.04,Default,menembak,0,0,0,,bagaimana keserakahan tumbuh.
Dialog: 0,0:54:29.35,0:54:31.28,Default,menembak,0,0,0,,-Apa?\N-Apakah ini benar?
Dialog: 0,0:54:31.58,0:54:35.25,Default,jarak tembak,0,0,0,,Tahukah Anda, saat pencurian mesiu dimulai,
Dialog: 0,0:54:36.02,0:54:37.55,Default,jarak tembak,0,0,0,,komandan pasukan Kim Jwageun?
Dialogue: 0,0:54:42.56,0:54:46.23,Default,dash,0,0,0,,Pada tahun yang sama ketika aku naik takhta.
Dialog: 0,0:54:47.93,0:54:52.10,Default,menembak,0,0,0,,Pada tahun yang sama, Tuan Kim Jwageun menjadi komandan pasukan.
Dialog: 0,0:54:53.70,0:54:56.04,Default,menembak,0,0,0,,Yang Mulia, ini tuduhan palsu.
Dialog: 0,0:54:56.04,0:54:57.44,Default,galeri tembak,0,0,0,,Diam!
Dialog: 0,0:54:58.24,0:55:01.01,Default,jarak tembak,0,0,0,,Menteri Perang, bertanggung jawab atas produksi bubuk mesiu,
Dialog: 0,0:55:01.01,0:55:04.45,Default,menembak,0,0,0,,juga pengkhianat, merencanakan pengkhianatan dengan Kim Jwageun!
Dialog: 0,0:55:05.58,0:55:08.05,Default,menembak,0,0,0,,Aku menggunakan identitas palsu pengawal kerajaan sebagai umpan.
Dialogue: 0,0:55:08.32,0:55:12.09,Default,shooting,0,0,0,,Kim Jwageun seharusnya sudah mengetahui hal ini.
Dialog: 0,0:55:17.56,0:55:19.93,Default,penembakan,0,0,0,,Kamu akan mengalami penyiksaan yang tak tertahankan,
Dialog: 0,0:55:20.33,0:55:21.63,Default,menembak,0,0,0,,tapi bersabarlah.
Dialogue: 0,0:55:23.67,0:55:25.14,Default,menembak,0,0,0,,Aku pasti akan menyelamatkanmu.
Dialog: 0,0:55:30.64,0:55:35.25,Default,menembak,0,0,0,,Ini tuduhan palsu,\Pahami ini, Yang Mulia!
Dialog: 0,0:55:38.95,0:55:41.58,Default,dash,0,0,0,,Jika Anda mengatakan lagi bahwa Anda dituduh secara salah,
Dialog: 0,0:55:43.02,0:55:45.42,Default,menembak,0,0,0,,Aku akan segera memberimu racun untuk diminum.
Dialogue: 0,0:55:49.96,0:55:51.96,Default,jarak tembak,0,0,0,,Pedagang mesiu menjualnya
Dialog: 0,0:55:51.96,0:55:54.03,Default,dash,0,0,0,,siapa pun yang membayar.
Dialog: 0,0:55:54.23,0:55:56.97,Default, galeri menembak,0,0,0,,Bandit, bahkan orang Jepang!
Dialogue: 0,0:55:57.17,0:56:00.24,Default,menembak,0,0,0,,Jika ini bukan demi kehancuran Joseon, lalu untuk apa?
Dialog: 0,0:56:01.20,0:56:04.11,Default,galeri tembak,0,0,0,,Siapa lagi yang ada di sini bersama mereka?
Dialog: 0,0:56:15.39,0:56:17.25,Default,menembak,0,0,0,,Komandan pasukan Kim Jwageun.
Dialog: 0,0:56:17.79,0:56:20.09,Default,penembakan,0,0,0,,Menteri Perang Kim Chang-hyuk.
Dialog: 0,0:56:21.42,0:56:22.69,Default,menembak,0,0,0,,Keduanya
Dialog: 0,0:56:23.99,0:56:27.06,Default,menembak,0,0,0,,mencuri senjata nasional untuk melemahkan tentara,
Dialog: 0,0:56:27.63,0:56:31.77,Default,menembak,0,0,0,,dan merencanakan percobaan pembunuhan terhadapku, raja,
Dialog: 0,0:56:34.50,0:56:35.91,Default,tyra,0,0,0,,yang berarti mereka bersalah melakukan makar.
Dialog: 0,0:56:36.67,0:56:39.88,Default,dash,0,0,0,,Kita harus menyebut operasi ini apa?
Dialog: 0,0:56:41.98,0:56:42.98,Default,menembak,0,0,0,,Phoenix.
Dialog: 0,0:56:45.72,0:56:47.28,Default,menembak,0,0,0,,Nama operasi -
Dialog: 0,0:56:48.42,0:56:50.42,Default, galeri menembak,0,0,0,, Phoenix terbakar.
Dialog: 0,0:56:55.43,0:56:57.33,Default,menembak,0,0,0,,Untuk semua kejahatan
Dialog: 0,0:56:58.93,0:57:01.00,Default,penembakan,0,0,0,,pelaku akan diberhentikan dari jabatannya
Dialog: 0,0:57:02.53,0:57:04.00,Default,menembak,0,0,0,,dan diasingkan.
Dialog: 0,0:57:05.97,0:57:07.04,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:57:11.27,0:57:14.11,Default,tyra,0,0,0,,-Ratu Janda.\N-Ratu Janda.
Dialog: 0,0:57:14.54,0:57:16.51,Default,menembak,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:57:16.98,0:57:18.72,Default,menembak,0,0,0,,Kenapa kamu menghakimi tanpa alasan?
Dialog: 0,0:57:19.15,0:57:21.82,Default,galeri tembak,0,0,0,,Kamu pasti kehilangan akal setelah ledakan.
Dialogue: 0,0:57:22.42,0:57:25.05,Default,jarak tembak,0,0,0,,Ingat batasan yang diperbolehkan!
Dialog: 0,0:57:25.72,0:57:26.92,Default,menembak,0,0,0,,Benarkah?
Dialogue: 0,0:57:28.63,0:57:30.36,Default,dash,0,0,0,,Jika kamu bilang begitu,
Dialog: 0,0:57:37.60,0:57:42.31,Default,dash,0,0,0,,kamu pasti kehilangan akal karena usia tua.
Dialog: 0,0:57:43.67,0:57:48.55,Default,dash,0,0,0,,Saya tidak dapat terus mendiskusikan masalah politik saat Anda berada dalam kondisi ini.
Dialog: 0,0:57:49.61,0:57:52.92,Default,tyra,0,0,0,,Silakan tinggalkan wilayah Anda.
Dialog: 0,0:57:55.05,0:57:56.39,Default,menembak,0,0,0,,-Apa?\N-Apa yang dia bicarakan?
Dialogue: 0,0:57:58.86,0:58:02.86,Default,shooting gallery,0,0,0,,Ini saatnya aku mengambil keputusan sendiri.
Dialog: 0,0:58:03.43,0:58:04.59,Default,galeri tembak,0,0,0,,Yang Mulia!
Dialog: 0,0:58:04.59,0:58:07.70,Default,menembak,0,0,0,,Seharusnya aku segera memberi Kim Jwageun racun untuk diminum
Dialog: 0,0:58:07.70,0:58:09.50,Default,menembak,0,0,0,,dan mengeksekusi seluruh keluarganya.
Dialog: 0,0:58:09.73,0:58:12.27,Default,menembak,0,0,0,,Tetapi karena kamu dan ratu
Dialog: 0,0:58:13.04,0:58:15.31,Default,menembak,0,0,0,,Saya memutuskan untuk mencabut gelarnya saja.
Dialogue: 0,0:58:16.67,0:58:17.84,Default,menembak,0,0,0,,Kamu tidak menyukainya?
Dialogue: 0,0:58:18.31,0:58:22.75,Default,menembak,0,0,0,,Apakah kamu mencoba membuat kesepakatan denganku sebagai ganti nyawa saudaraku?
Dialog: 0,0:58:23.25,0:58:26.62,Default,dash,0,0,0,,Anda hanya bisa menyebutnya kesepakatan jika Anda punya pilihan.
Dialog: 0,0:58:30.32,0:58:31.39,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,0:58:33.96,0:58:37.09,Default,penembakan,0,0,0,,Saya, Kim Jwageun, telah dituduh secara salah,
Dialog: 0,0:58:37.33,0:58:38.73,Default,menembak,0,0,0,,tapi aku akan membuktikan kesetiaanku,
Dialog: 0,0:58:38.73,0:58:41.13,Default,tyra,0,0,0,,menaati perintah kerajaan.
Dialog: 0,0:58:41.60,0:58:42.93,Default,menembak,0,0,0,,Lega sekali.
Dialogue: 0,0:58:43.57,0:58:46.77,Default,dash,0,0,0,,Aku takut karena usiamu yang sudah tua, kamu mungkin termakan oleh keserakahan.
Dialog: 0,0:58:46.97,0:58:48.84,Default,menembak,0,0,0,,Saya tidak menentang pemecatan dari jabatan.
Dialog: 0,0:58:49.07,0:58:51.34,Default,menembak,0,0,0,,Tapi aku memintamu memberiku kesempatan
Dialogue: 0,0:58:51.34,0:58:53.81,Default,dash,0,0,0,,hapus namamu.
Dialog: 0,0:58:54.11,0:58:56.61,Default,menembak,0,0,0,,Saya minta Sakhonbu dicopot dari jabatannya.
Dialog: 0,0:58:58.01,0:58:59.08,Default,dash,0,0,0,,Saya menerima permintaan Anda.
Dialog: 0,0:58:59.38,0:59:04.02,Default,menembak,0,0,0,,Tetapi jika Sakhonbu tidak memecatnya dari jabatannya besok,
Dialog: 0,0:59:04.35,0:59:07.99,Default,menembak,0,0,0,,Saya akan segera mencopot komandan pasukan, Kim Jwageun, dari posisinya
Dialog: 0,0:59:08.56,0:59:11.33,Default,menembak,0,0,0,,dan aku tidak hanya akan membubarkan Sakhonbu sendiri,
Dialog: 0,0:59:11.33,0:59:14.73,Default,menembak,0,0,0,,tetapi juga semua pejabat yang hadir!
Dialog: 0,0:59:15.40,0:59:19.90,Default,menembak,0,0,0,,-Kami mohon belas kasihan Anda!\N-Kami mohon belas kasihan Anda!
Dialogue: 0,0:59:36.72,0:59:38.32,Default,jarak tembak,0,0,0,,Kamu kalah.
Dialog: 0,0:59:38.72,0:59:41.69,Default,menembak,0,0,0,,Kamu diusir oleh raja yang kepadanya kamu sendiri yang memberikan takhta!
Dialog: 0,0:59:42.09,0:59:45.19,Default,menembak,0,0,0,,Saya tidak tahu bahwa raja akan merencanakan upaya pembunuhannya sendiri.
Dialog: 0,0:59:45.80,0:59:48.73,Default,galeri tembak,0,0,0,,Menurutmu siapa yang memasang jebakan?
Dialog: 0,0:59:50.27,0:59:52.74,Default,galeri tembak,0,0,0,,Saya mempercayakan Anda dengan pemilihan wanita bangsawan.
Dialogue: 0,0:59:53.10,0:59:55.57,Default,menembak,0,0,0,,Tapi kamu tidak memahami orang dengan baik.
Dialog: 0,0:59:57.87,1:00:01.71,Default,tyra,0,0,0,,Konfusius mengatakan bahwa hati lebih kompleks daripada alam,
Dialog: 0,1:00:01.81,1:00:04.65,Default,dash,0,0,0,,dan melihat hati orang lain lebih sulit daripada melihat apa yang ada di balik awan.
Dialogue: 0,1:00:05.21,1:00:06.58,Default,shooting gallery,0,0,0,,Aku melakukan kesalahan dalam memilih wanita bangsawan
Dialog: 0,1:00:06.58,1:00:08.72,Default,galeri tembak,0,0,0,,baik di dalam maupun di luar istana.
Dialog: 0,1:00:09.89,1:00:12.76,Default,tyra,0,0,0,,Kamu juga memercayai ratu
Dialog: 0,1:00:12.76,1:00:15.16,Default,tyra,0,0,0,,berhati-hatilah dalam memilih selir kerajaan.
Dialog: 0,1:00:15.76,1:00:18.43,Default,menembak,0,0,0,,Tapi dia membuat pilihan demi kepentingan raja.
Dialog: 0,1:00:18.66,1:00:20.93,Default,menembak,0,0,0,,Dan ratulah yang menyelamatkan pesta itu,
Dialog: 0,1:00:20.93,1:00:22.40,Default,menembak,0,0,0,,yang saya hancurkan.
Dialog: 0,1:00:23.93,1:00:27.34,Default,jarak tembak,0,0,0,,Musuh sangat mengerikan ketika dia berada di antara musuhnya sendiri.
Dialog: 0,1:00:40.05,1:00:41.12,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,1:00:48.36,1:00:51.09,Default,menembak,0,0,0,,Yang Mulia pasti sudah sadar.
Dialog: 0,1:00:53.46,1:00:57.10,Default,menembak,0,0,0,,Aku bisa mengawasi suamiku\N saat dia sadar kembali.
Dialog: 0,1:00:57.77,1:01:00.94,Default,menembak,0,0,0,,Jika dia tidak bangun, aku akan menjadi tidak berguna.
Dialog: 0,1:01:01.50,1:01:04.27,Default,menembak,0,0,0,,Jika aku menjadi tidak berguna, aku akan digulingkan.
Dialog: 0,1:01:04.27,1:01:06.78,Default,menembak,0,0,0,,Jika aku digulingkan, aku akan berhenti memikirkan balas dendam
Dialog: 0,1:01:06.78,1:01:09.25,Default,menembak,0,0,0,,dan saya akan membuka restoran untuk mencari nafkah.
Dialog: 0,1:01:10.78,1:01:12.58,Default,menembak,0,0,0,,Tidak terlalu buruk.
Dialog: 0,1:01:13.02,1:01:14.05,Default,galeri tembak,0,0,0,,Ratu!
Dialog: 0,1:01:15.25,1:01:18.32,Default,menembak,0,0,0,,Yang Mulia...
Dialog: 0,1:01:21.52,1:01:23.26,Default,menembak,0,0,0,,Dia sadar kembali.
Dialog: 0,1:01:23.86,1:01:25.03,Default,menembak,0,0,0,,Benarkah?
Dialog: 0,1:01:25.03,1:01:27.33,Default,tanda hubung,0,0,0,,Ya. Pendengarannya telah kembali
Dialog: 0,1:01:27.33,1:01:29.47,Default,menembak,0,0,0,,dan dia pergi ke dewan kerajaan.
Dialog: 0,1:01:29.47,1:01:31.67,Default,jarak tembak,0,0,0,,Aku benar-benar takut.
Dialogue: 0,1:01:32.37,1:01:33.60,Default,menembak,0,0,0,,Aku harus pergi.
Dialog: 0,1:01:35.54,1:01:36.84,Default,menembak,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,1:01:38.94,1:01:40.21,Default,menembak,0,0,0,,Saya tidak punya waktu.
Dialog: 0,1:01:45.21,1:01:46.78,Default, lapangan tembak,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,1:01:48.25,1:01:49.65,Default,menembak,0,0,0,,Saya sangat senang.
Dialog: 0,1:01:51.69,1:01:53.46,Default,menembak,0,0,0,,Sungguh, saya sangat senang.
Dialog: 0,1:01:59.36,1:02:01.80,Default,menembak,0,0,0,,Jangan menangis. Mengapa kamu menangis?
Dialog: 0,1:02:02.27,1:02:03.80,Default,menembak,0,0,0,,Lega sekali.
Dialog: 0,1:02:03.80,1:02:05.60,Default,menembak,0,0,0,,Nyonya Choi.
Dialog: 0,1:02:09.17,1:02:11.94,Default,menembak,0,0,0,,-Saya akan melakukannya.\N-Ya, Yang Mulia.
Dialog: 0,1:02:17.98,1:02:19.15,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,1:02:24.35,1:02:25.82,Default,menembak,0,0,0,,Semuanya baik-baik saja sekarang.
Dialogue: 0,1:02:26.76,1:02:29.79,Default,dash,0,0,0,,Semuanya baik-baik saja, karena kamu terjaga dan sehat.
Dialog: 0,1:02:31.49,1:02:35.57,Default,menembak,0,0,0,,Aku tidak akan pernah kehilanganmu lagi.
Dialog: 0,1:02:37.53,1:02:38.57,Default,menembak,0,0,0,,Hwajin.
Dialogue: 0,1:02:41.47,1:02:43.01,Default,menembak,0,0,0,,Queen's Dictionary
Dialog: 0,1:02:50.25,1:02:51.35,Default,menembak,0,0,0,,Yang Mulia.
Dialog: 0,1:02:51.35,1:02:54.42,Default,menembak,0,0,0,,Mereka bilang kamu akan mengunjungi raja. Mengapa kamu duduk di sini?
Dialog: 0,1:02:54.98,1:02:56.22,Default,galeri tembak,0,0,0,,Gelas lagi.
Dialog: 0,1:02:56.69,1:02:59.92,Default,menembak,0,0,0,,Rasanya canggung melihatnya sadar.
Dialog: 0,1:03:01.02,1:03:05.03,Default,dash,0,0,0,,Berhenti minum. Anda tidak perlu melakukan ini, Yang Mulia.
Dialog: 0,1:03:05.03,1:03:07.66,Default,menembak,0,0,0,,Cukup kerja untukmu. Pulang!
Dialog: 0,1:03:11.07,1:03:13.37,Default,menembak,0,0,0,,Aku akan meminum ini untukmu.
Dialog: 0,1:03:15.44,1:03:16.94,Default,menembak,0,0,0,,Nyonya Choi.
Dialog: 0,1:03:17.84,1:03:19.28,Default,menembak,0,0,0,,Nyonya Choi.
Dialog: 0,1:03:23.65,1:03:26.15,Default,jarak tembak,0,0,0,,Di dapur kerajaan, persediaan alkohol tidak terbatas.
Dialog: 0,1:03:29.12,1:03:31.15,Default,menembak,0,0,0,,Kenapa kamu malu?
Dialog: 0,1:03:33.46,1:03:35.59,Default,menembak,0,0,0,,Canggung karena...
Dialog: 0,1:03:38.29,1:03:40.93,Default,menembak,0,0,0,,Kamu benar. Mengapa ini terasa canggung?
Dialog: 0,1:03:42.13,1:03:44.40,Default,menembak,0,0,0,,Saya yakin! Ayo pergi menemui raja.
Dialog: 0,1:03:44.67,1:03:46.84,Default,galeri tembak,0,0,0,,Kamu tidak bisa pergi sekarang,
Dialog: 0,1:03:46.84,1:03:48.50,Default,menembak,0,0,0,,pergi saat kamu sadar.
Dialog: 0,1:03:49.57,1:03:50.87,Default,menembak,0,0,0,,Oke. Ayo berangkat besok.
Dialog: 0,1:03:51.21,1:03:52.44,Default,menembak,0,0,0,,Mari kita tunda sampai besok.
Dialog: 0,1:03:52.44,1:03:53.64,Default,dash,0,0,0,,Sama seperti sedang diet.
Dialog: 0,1:03:53.88,1:03:55.81,Default,menembak,0,0,0,,Kita punya waktu besok!
Dialog: 0,1:03:56.35,1:03:58.65,Default,galeri tembak,0,0,0,,Koki kerajaan. Botol lain.
Dialog: 0,1:03:59.55,1:04:01.92,Default,menembak,0,0,0,,Apakah dia pikir dia datang ke kedai atau apa?
Dialog: 0,1:04:03.75,1:04:04.79,Default,menembak,0,0,0,,Lebih cepat.
Dialog: 0,1:04:41.96,1:04:43.09,Default,menembak,0,0,0,,Nyonya Kan.
Dialog: 0,1:04:46.73,1:04:48.90,Default,jarak tembak,0,0,0,,Rahasia
Dialog: 0,1:04:48.90,1:04:50.00,Default,galeri tembak,0,0,0,,Yang Mulia!
Dialog: 0,1:04:54.50,1:04:55.54,Default,menembak,0,0,0,,Yang Mulia.
Dialogue: 0,1:05:15.76,1:05:18.23,Default,shooting gallery,0,0,0,,Ini ditemukan di aula Daejojon.
Dialog: 0,1:05:18.23,1:05:21.36,Default,menembak,0,0,0,,Seperti yang diharapkan, raja dan ratu bekerja sama.
Dialog: 0,1:05:21.36,1:05:24.37,Default,menembak,0,0,0,,Sang Ratu benar-benar rusak.
Dialog: 0,1:05:25.33,1:05:28.87,Default,jarak tembak,0,0,0,,Barang rusak perlu diganti dengan yang baru.
Dialog: 0,1:05:29.81,1:05:34.21,Default,menembak,0,0,0,,Tapi kamu bisa membuat benda rusak bertahan hingga akhir
Dialog: 0,1:05:35.78,1:05:37.91,Default, galeri menembak,0,0,0,,dan kirimkan ke api.
Dialog: 0,1:05:39.58,1:05:42.35,Default,dash,0,0,0,,Mungkin kita menggunakan arsenik asli?
Dialog: 0,1:05:49.76,1:05:52.36,Default,menembak,0,0,0,,Sang Ratu sangat suka makan.
Dialog: 0,1:05:52.96,1:05:55.46,Default,menembak,0,0,0,,Jadi mari kita siapkan meja untuknya.
Dialog: 0,1:05:56.73,1:05:59.34,Default,galeri tembak,0,0,0,,Apakah kamu akan meninggalkan raja?
Dialogue: 0,1:05:59.70,1:06:03.51,Default,shooting,0,0,0,,Kita harus memecahkannya\N agar dapat terus menggunakannya.
Dialog: 0,1:06:03.97,1:06:08.54,Default,dash,0,0,0,,Jika ini terjadi, begitu dia\N memberikan hatinya kepada ratu, dia akan mengerti,
Dialog: 0,1:06:09.11,1:06:11.68,Default,menembak,0,0,0,,bahwa semua orang di sisinya akan menjadi tidak bahagia.
Dialog: 0,1:06:58.06,1:07:00.56,Default,menembak,0,0,0,,Bukankah ini keajaiban,
Dialog: 0,1:07:02.23,1:07:04.50,Default,menembak,0,0,0,,apa hari esok yang datang setiap hari?
Dialogue: 0,1:07:11.91,1:07:14.14,Default,shooting gallery,0,0,0,,Ayo lanjut ke babak kedua di aula Songjeongjong.
Dialog: 0,1:07:14.51,1:07:17.98,Default,menembak,0,0,0,,Kita perlu merayakan kesembuhan raja.
Dialog: 0,1:07:17.98,1:07:20.78,Default, lapangan tembak,0,0,0,,Tolong jangan berteriak, Yang Mulia.
Dialog: 0,1:07:20.78,1:07:22.42,Default,galeri tembak,0,0,0,,Yang Mulia!
Dialog: 0,1:07:22.92,1:07:24.65,Default,menembak,0,0,0,,Yang Mulia!
Dialog: 0,1:07:24.65,1:07:27.72,Default,menembak,0,0,0,,Kamu tidak bisa memanggilnya seperti itu.
Dialog: 0,1:07:29.46,1:07:30.66,Default,menembak,0,0,0,,Terbuka.
Dialog: 0,1:07:34.36,1:07:35.56,Default,menembak,0,0,0,,Terbuka.
Dialogue: 0,1:07:42.34,1:07:45.27,Default,menembak,0,0,0,,Spiral Potatoes
Dialog: 0,1:07:49.48,1:07:53.28,Default,menembak,0,0,0,,Apakah kamu sedang tidur?
Dialog: 0,1:08:13.84,1:08:15.81,Default,menembak,0,0,0,,Sepertinya aku tertidur.
Dialogue: 0,1:08:22.04,1:08:24.45,Default,menembak,0,0,0,,Apakah kamu menjagaku?
Dialog: 0,1:08:26.52,1:08:28.92,Default,menembak,0,0,0,,Kenapa kamu terus melakukan ini?
Dialog: 0,1:08:30.12,1:08:34.12,Default,menembak,0,0,0,,Mengkhawatirkanku, mencoba memahamiku.
Dialogue: 0,1:08:36.03,1:08:39.86,Default,dash,0,0,0,,Kalau dipikir-pikir, kamu adalah orang pertama yang kulihat saat aku datang ke sini.
Dialog: 0,1:08:44.13,1:08:46.77,Default,menembak,0,0,0,,Aku berhutang banyak padamu.
Dialog: 0,1:08:48.20,1:08:50.94,Default,menembak,0,0,0,,Aku memikirkanmu ketika aku mencoba meninggalkan istana.
Dialog: 0,1:08:52.54,1:08:54.68,Default,menembak,0,0,0,,Kupikir aku tidak akan pernah melihatmu lagi.
Dialog: 0,1:09:34.35,1:09:36.22,Default,tyra,0,0,0,,Hon Young.
Dialog: 0,1:09:58.21,1:09:59.64,Default,menembak,0,0,0,,Apakah kamu sudah bangun?
Dialog: 0,1:10:08.82,1:10:13.66,Default,tanda hubung,0,0,0,,
Dialog: 0,1:10:28.97,1:10:31.14,Default,tyra,0,0,0,,Aku yakin jiwa wanita ini telah merasuki tubuhku.
Dialogue: 0,1:10:31.14,1:10:33.14,Default,menembak,0,0,0,,Kenapa kamu selalu menghindariku?
Dialog: 0,1:10:33.14,1:10:35.21,Default,menembak,0,0,0,,-Tunggu.\N-Apa yang ingin dia tanyakan padaku?
Dialog: 0,1:10:35.21,1:10:36.25,Default,menembak,0,0,0,,Apakah kamu menyukainya?
Dialog: 0,1:10:36.25,1:10:38.15,Default,jarak tembak,0,0,0,,Bukankah kamu bilang ini dilarang?
Dialog: 0,1:10:38.15,1:10:40.22,Default,tyra,0,0,0,,Dia mengatakan itu sambil memeluk, tersenyum dan berbaring di sampingmu -
Dialog: 0,1:10:40.22,1:10:41.88,Default,jarak tembak,0,0,0,,semua ini dilarang.
Dialog: 0,1:10:42.25,1:10:44.02,Default,menembak,0,0,0,,Saya melarang Anda mengatakan bahwa ini dilarang.
Dialog: 0,1:10:44.39,1:10:45.75,Default,jarak tembak,0,0,0,,Saya sudah menyiapkan segalanya.
Dialog: 0,1:10:45.75,1:10:46.86,Default,menembak,0,0,0,,Apa yang kamu lihat?
Dialog: 0,1:10:46.86,1:10:49.26,Default,galeri tembak,0,0,0,,Seseorang akan mati di istana hari ini.
Dialog: 0,1:10:49.26,1:10:50.73,Default,menembak,0,0,0,,Aku tidak percaya mereka mencoba menyingkirkan ratu.
Dialog: 0,1:10:50.73,1:10:55.26,Default,dash,0,0,0,,Saya khusus menyiapkan es, yang saat ini lebih mahal daripada emas.
Dialog: 0,1:10:55.26,1:10:56.87,Default,menembak,0,0,0,,-Yang Mulia.\N-Ratuku.
Dialog: 0,0:15:53.44,0:15:55.44,Default,,0,0,0,,

Komentar: 0,0:12:33.43,0:12:34.53,Default,Lily,0,0,0,,Tuhan.
