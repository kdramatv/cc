Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:04.02, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, А,инасг, А,инасг Бирюлька, Февраль,\NХозяин, Таракан
Dialog: 0,0:00:58.00,0:01:04.02,tajuk,,0,0,0,,{\pos(110,602)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.95,0:01:06.39, Lalai,,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.39,0:01:08.96, Lalai,,0,0,0,, dan peristiwa yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:21.80,0:01:23.60, Lalai,,0,0,0,,Berapa banyak yang dia dengar?
Dialog: 0,0:01:25.41,0:01:27.17, Lalai,,0,0,0,,Perkara pertama yang dia katakan
Dialog: 0,0:01:27.17,0:01:29.38, Lalai,,0,0,0,,di bawah ancaman kematian, akan menentukan nasibnya.
Dialog: 0,0:01:30.68,0:01:32.01, Lalai,,0,0,0,,Dia akan mengatakan bahawa dia tidak mendengar apa-apa
Dialog: 0,0:01:32.01,0:01:34.55, Lalai,,0,0,0,,atau meminta nyawanya, saya akan bunuh dia.
Dialog: 0,0:01:34.55,0:01:36.72, Lalai,,0,0,0,,Ini bermakna dia mendengar segala-galanya.
Dialog: 0,0:01:37.48,0:01:38.89, Lalai,,0,0,0,,Anda!
Dialog: 0,0:01:39.59,0:01:42.12,Lalai,,0,0,0,,Jika anda membunuh saya, anda akan mendapat masalah sepanjang hayat anda.
Dialog: 0,0:01:47.49,0:01:49.50, Lalai,,0,0,0,,Ini masih perkara kecil.
Dialog: 0,0:01:54.37,0:01:56.54, Lalai,,0,0,0,,Alihkan benda itu.
Dialog: 0,0:01:57.97,0:01:59.37, Lalai,,0,0,0,,Tunggu sebentar.
Dialog: 0,0:01:59.37,0:02:02.54,Lalai,,0,0,0,,3 episod
Dialog: 0,0:02:09.95,0:02:12.79, Lalai,,0,0,0,, Untuk pengetahuan anda, hari ini anda mendapat jackpot.
Dialog: 0,0:02:17.69,0:02:20.29, Lalai,,0,0,0,,Lihat, bukankah ia cantik? Semuanya milik awak.
Dialog: 0,0:02:20.76,0:02:22.60, Lalai,,0,0,0,,Adakah dia menunggu masa?
Dialog: 0,0:02:22.66,0:02:25.43, Lalai,,0,0,0,,Apakah ini? Awak bukan pencuri?
Dialog: 0,0:02:26.00,0:02:27.47, Lalai,,0,0,0,, Sial.
Dialog: 0,0:02:27.87,0:02:30.87, Lalai,,0,0,0,,Adakah anda tahu siapa saya?
Dialog: 0,0:02:31.27,0:02:34.34, Lalai,,0,0,0,,-Saya...\N-Sekarang dia akan mengatakan bahawa dia adalah permaisuri.
Dialog: 0,0:02:35.31,0:02:37.88, Lalai,,0,0,0,, berkhidmat dalam pasukan khas.
Dialog: 0,0:02:41.62,0:02:43.02, Lalai,,0,0,0,,Serangan.
Dialog: 0,0:02:44.25,0:02:46.72,Lalai,,0,0,0,,Adakah anda rasa semua tukang masak dalam tentera itu bodoh?
Dialog: 0,0:02:46.99,0:02:48.59,Lalai,,0,0,0,,Chef Tentera
Dialog: 0,0:02:48.59,0:02:51.26, Lalai,,0,0,0,, akan membunuh hantu dengan pisau dapur.
Dialog: 0,0:02:51.39,0:02:53.89, Lalai,,0,0,0,,Maju! Saya tidak takut dengan awak.
Dialog: 0,0:02:54.03,0:02:56.60, Lalai,,0,0,0,,Ayuh serang.
Dialog: 0,0:02:56.60,0:03:00.33, Lalai,,0,0,0,,Bagaimana dia boleh mengatakan perkara pelik dengan begitu yakin?
Dialog: 0,0:03:54.56,0:03:56.02, Lalai,,0,0,0,,Dan anda hebat.
Dialog: 0,0:04:17.91,0:04:19.78, Lalai,,0,0,0,,Wajah adalah kelemahannya.
Dialog: 0,0:04:31.63,0:04:33.16, Lalai,,0,0,0,, Sejuk.
Dialog: 0,0:04:38.47,0:04:40.00, Lalai,,0,0,0,,Tuhan.
Dialog: 0,0:05:55.31,0:05:57.31,Lalai,,0,0,0,,Baginda menyembunyikan wajahnya,
Dialog: 0,0:05:57.31,0:05:59.38, Lalai,,0,0,0,, yang bermaksud dia tidak mahu mendedahkan dirinya.
Dialog: 0,0:06:38.05,0:06:39.62, Lalai,,0,0,0,,Siapa awak?
Dialog: 0,0:06:42.29,0:06:44.59,Lalai,,0,0,0,,Saya Kim Byungin daripada keluarga Kim Jwageun.
Dialog: 0,0:06:46.13,0:06:47.86, Lalai,,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:06:50.30,0:06:51.63, Lalai,,0,0,0,,Adakah anda telah dirompak?
Dialog: 0,0:06:51.63,0:06:53.50, Lalai,,0,0,0,,Dia tidak boleh pergi jauh.
Dialog: 0,0:06:54.50,0:06:56.47, Lalai,,0,0,0,, Cari semua benda di sekeliling.
Dialog: 0,0:06:56.70,0:06:58.11, Lalai,,0,0,0,,Pencuri itu tidak bersendirian.
Dialog: 0,0:06:58.11,0:07:01.04, Lalai,,0,0,0,,Ya, berpisah dan cari semuanya.
Dialog: 0,0:07:13.22,0:07:15.12,Lalai,,0,0,0,,Kak, awak okay?
Dialog: 0,0:07:18.49,0:07:19.96, Lalai,,0,0,0,, Kakak?
Dialog: 0,0:07:22.50,0:07:26.37, Lalai,,0,0,0,,Mengapa dia merenung kakaknya?
Dialog: 0,0:07:28.14,0:07:29.57, Lalai,,0,0,0,,Soyeon!
Dialog: 0,0:07:31.51,0:07:33.84, Lalai,,0,0,0,,Mesti pernah mengalami kejutan yang kuat.
Dialog: 0,0:07:35.88,0:07:38.08, Lalai,,0,0,0,,Si bajingan mana yang berani buat begini padanya?
Dialog: 0,0:07:47.19,0:07:49.22,Lalai,,0,0,0,,Emas... Tuhanku!
Dialog: 0,0:07:50.76,0:07:53.03, Lalai,,0,0,0,,-Nah, apa.\N-Kenapa awak menceroboh?
Dialog: 0,0:07:54.29,0:07:55.73, Lalai,,0,0,0,,Kami sedang mencari pencuri.
Dialog: 0,0:07:55.73,0:07:56.96, Lalai,,0,0,0,, Tuhan.
Dialog: 0,0:07:56.96,0:07:58.70,Lalai,,0,0,0,,Di manakah anda menghulurkan tangan?
Dialog: 0,0:07:58.70,0:08:02.27, Lalai,,0,0,0,,Mereka menakutkan saya, jadi saya berkata langkah saya dengan kuat.
Dialog: 0,0:08:02.27,0:08:03.37, Lalai,,0,0,0,,Permainan ini telah tamat.
Dialog: 0,0:08:03.37,0:08:04.50, Lalai,,0,0,0,,Siapa yang kata?
Dialog: 0,0:08:04.50,0:08:06.31, Lalai,,0,0,0,,Adakah anda akan meneruskan, mengetahui apa yang saya ada di tangan saya?
Dialog: 0,0:08:06.31,0:08:08.98, Lalai,,0,0,0,,Masalah awak, kenapa saya perlu kalah?
Dialog: 0,0:08:08.98,0:08:10.71, Lalai,,0,0,0,,Sungguh bajingan.
Dialog: 0,0:08:12.25,0:08:13.55, Lalai,,0,0,0,,Maaf, saya pergi terlalu jauh.
Dialog: 0,0:08:13.55,0:08:15.98,Lalai,,0,0,0,,Adakah awak baru saja meludah ke muka saya?
Dialog: 0,0:08:15.98,0:08:17.52, Lalai,,0,0,0,,Saya tidak tahu apa-apa!
Dialog: 0,0:08:20.05,0:08:21.96, Lalai,,0,0,0,, Kepada anda!
Dialog: 0,0:08:24.49,0:08:27.13, Lalai,,0,0,0,,-Tangkap dia.\N-Tangkap?
Dialog: 0,0:08:28.20,0:08:30.20, Lalai,,0,0,0,,Apa yang berdiri seperti tiang?
Dialog: 0,0:08:30.20,0:08:32.00, Lalai,,0,0,0,,Jangan biarkan Kaunselor Hong melarikan diri,
Dialog: 0,0:08:32.00,0:08:33.83, Lalai,,0,0,0,,tutup pintu dan keluar sekarang!
Dialog: 0,0:08:33.83,0:08:36.90, Lalai,,0,0,0,,Dia tidak tahu bagaimana untuk melawan, tetapi membuat kekacauan pada dirinya sendiri.
Dialog: 0,0:08:36.90,0:08:39.91, Lalai,,0,0,0,,Hari ini saya akan mengurangkan perangainya!
Dialog: 0,0:08:40.87,0:08:42.84, Lalai,,0,0,0,,-Lindungi saya.\N-Lain kali.
Dialog: 0,0:08:42.84,0:08:45.41, Lalai,,0,0,0,,-Seterusnya?\N-Kenapa awak masih di sini?
Dialog: 0,0:08:45.55,0:08:48.05, Lalai,,0,0,0,,Jika anda pergi begitu sahaja...
Dialog: 0,0:08:48.05,0:08:49.52, Lalai,,0,0,0,, Penasihat Hon.
Dialog: 0,0:08:49.52,0:08:52.69,Lalai,,0,0,0,,Hari ini saya akan mengurangkan perangai awak!
Dialog: 0,0:08:54.86,0:08:56.46, Lalai,,0,0,0,,Ia keluar dengan meyakinkan.
Dialog: 0,0:08:59.59,0:09:02.40, Lalai,,0,0,0,,Tidakkah saya boleh mengejek awak lagi?
Dialog: 0,0:09:02.40,0:09:04.76,Lalai,,0,0,0,,Sungguh, adakah anda akan mengangkat pedang anda terhadap saya?
Dialog: 0,0:09:07.20,0:09:09.90, Lalai,,0,0,0,,Tetapi tidak! Saya tidak pernah berniat untuk berkahwin!
Dialog: 0,0:09:10.20,0:09:11.64, Lalai,,0,0,0,,Jom.
Dialog: 0,0:09:12.81,0:09:15.48, Lalai,,0,0,0,,Terlepas. Pedang pun tiada di sisimu.
Dialog: 0,0:09:35.16,0:09:36.96, Lalai,,0,0,0,,Adakah anda cedera?
Dialog: 0,0:09:36.96,0:09:38.63, Lalai,,0,0,0,,Saya tidak apa-apa.
Dialog: 0,0:09:39.47,0:09:41.67, Lalai,,0,0,0,,Saya tidak sangka Kim Byungin akan bersamanya.
Dialog: 0,0:09:42.60,0:09:44.64, Lalai,,0,0,0,,Adakah anda fikir ia satu perangkap?
Dialog: 0,0:09:45.37,0:09:48.01, Lalai,,0,0,0,,Mereka tidak akan menggunakan ratu sebagai umpan.
Dialog: 0,0:09:48.01,0:09:50.08, Lalai,,0,0,0,,Selain itu, reaksi permaisuri
Dialog: 0,0:09:50.08,0:09:53.05, Lalai,,0,0,0,, luar biasa.\NI menghantui saya.
Dialog: 0,0:09:53.28,0:09:55.18,Lalai,,0,0,0,,Jika kita mula bertindak tanpa memahaminya,
Dialog: 0,0:09:55.18,0:09:57.38,Lalai,,0,0,0,,kita hanya memburukkan keadaan.
Dialog: 0,0:09:57.72,0:09:59.89,Lalai,,0,0,0,,Mari kita fahami dahulu perkara yang sedang berlaku.
Dialog: 0,0:09:59.89,0:10:01.45, Lalai,,0,0,0,,Tetapi apa,
Dialog: 0,0:10:01.82,0:10:04.22, Lalai,,0,0,0,, jika ratu mendengar segala-galanya?
Dialog: 0,0:10:05.63,0:10:08.16, Lalai,,0,0,0,,Saya bercakap dengan permaisuri.
Dialog: 0,0:10:08.86,0:10:11.00, Lalai,,0,0,0,,Percayai penilaian saya.
Dialog: 0,0:10:13.97,0:10:16.34, Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,0:10:17.07,0:10:20.04, Lalai,,0,0,0,,Jika saya salah,
Dialog: 0,0:10:23.11,0:10:26.48, Lalai,,0,0,0,, pertumpahan darah akan bermula.
Dialog: 0,0:10:33.89,0:10:37.19, Lalai,,0,0,0,,3 episod: Di atas katil dengan musuh
Dialog: 0,0:10:48.47,0:10:49.77, Lalai,,0,0,0,,Tetamu mulia.
Dialog: 0,0:10:49.77,0:10:52.07, Lalai,,0,0,0,,Saya nampak dia dalam keranda,\Melainkan dia raja...
Dialog: 0,0:10:52.97,0:10:55.17, Lalai,,0,0,0,,Letakkan senjata anda, letakkannya.
Dialog: 0,0:10:59.55,0:11:01.05, Lalai,,0,0,0,, Langkau.
Dialog: 0,0:11:07.65,0:11:10.32,Lalai,,0,0,0,,Saya ingin lawatan kami kekal rahsia.
Dialog: 0,0:11:10.32,0:11:11.82, Lalai,,0,0,0,,Ya.
Dialog: 0,0:11:20.33,0:11:21.83, Lalai,,0,0,0,,Tuhan.
Dialog: 0,0:11:26.57,0:11:28.94, Lalai,,0,0,0,,Dia pengsan kerana ketakutan.
Dialog: 0,0:11:28.98,0:11:33.41, Lalai,,0,0,0,,Sediakan katilnya dan susukan dia secara rahsia.
Dialog: 0,0:11:33.41,0:11:34.85, Lalai,,0,0,0,,Ya.
Dialog: 0,0:11:58.94,0:12:00.84, Lalai,,0,0,0,,Yang Mulia, apa yang kamu lakukan di sini?
Dialog: 0,0:12:01.34,0:12:03.24, Lalai,,0,0,0,, Anda lagi.
Dialog: 0,0:12:04.94,0:12:08.78,Lalai,,0,0,0,,Hanya anda yang mencari saya apabila saya melarikan diri.
Dialog: 0,0:12:09.65,0:12:14.09,Lalai,,0,0,0,,Esok perkahwinan kamu.\NKenapa kamu di sini?
Dialog: 0,0:12:14.89,0:12:17.92,Lalai,,0,0,0,,Saya fikir sebentar lagi saya akan menjadi gila.\NTSebab itu saya meninggalkan istana.
Dialog: 0,0:12:19.23,0:12:20.93, Lalai,,0,0,0,,Teruskan saya
Dialog: 0,0:12:22.20,0:12:23.76, Lalai,,0,0,0,, tiada di mana-mana.
Dialog: 0,0:12:50.92,0:12:55.96,Lalai,,0,0,0,,Saya akan mengembalikan kamu ke istana - tiada siapa yang akan perasan.
Dialog: 0,0:12:58.67,0:13:01.30,Lalai,,0,0,0,,Esok adalah impian zaman kanak-kanak saya
Dialog: 0,0:13:02.67,0:13:05.07, Lalai,,0,0,0,,akan menjadi kenyataan.
Dialog: 0,0:13:05.97,0:13:08.91,Lalai,,0,0,0,,Saya bermimpi untuk menjadi seorang ratu.
Dialog: 0,0:13:12.61,0:13:15.45,Lalai,,0,0,0,,Esok impian saya akan menjadi kenyataan.
Dialog: 0,0:13:18.59,0:13:20.72,Lalai,,0,0,0,,Esok adalah impian saya
Dialog: 0,0:13:23.06,0:13:24.92, Lalai,,0,0,0,,akan hilang.
Dialog: 0,0:13:28.96,0:13:30.83, Lalai,,0,0,0,,Adakah sesuatu yang salah?
Dialog: 0,0:13:32.70,0:13:34.73, Lalai,,0,0,0,,Saya takut.
Dialog: 0,0:13:35.74,0:13:37.34,Lalai,,0,0,0,,Saya takut.
Dialog: 0,0:13:38.57,0:13:41.07, Lalai,,0,0,0,,Sungguh menakutkan untuk hidup.
Dialog: 0,0:13:41.14,0:13:44.18, Lalai,,0,0,0,,-Yang Mulia.\N-Jangan panggil saya begitu.
Dialog: 0,0:13:45.15,0:13:47.88,Lalai,,0,0,0,,Sekurang-kurangnya hari ini panggil saya dengan nama.
Dialog: 0,0:13:48.58,0:13:50.78, Lalai,,0,0,0,,Supaya saya tidak lupa siapa saya.
Dialog: 0,0:13:52.69,0:13:54.35,Lalai,,0,0,0,,Kepada
Dialog: 0,0:13:56.59,0:13:58.29, Lalai,,0,0,0,,tidak kehilangan diri saya.
Dialog: 0,0:13:59.16,0:14:01.79, Lalai,,0,0,0,,Apa yang awak takut sangat?
Dialog: 0,0:14:02.40,0:14:06.10,Lalai,,0,0,0,,Saya bukan saya sama sekali.
Dialog: 0,0:14:06.93,0:14:09.50,Lalai,,0,0,0,,Selama ini saya hidup memikirkan bahawa ini adalah saya.
Dialog: 0,0:14:10.67,0:14:12.41, Lalai,,0,0,0,,Tetapi bukan begitu.
Dialog: 0,0:14:12.47,0:14:15.74,Lalai,,0,0,0,,Tiada apa-apa yang sebenar tentang saya, semuanya adalah pembohongan.
Dialog: 0,0:14:32.03,0:14:34.19,Lalai,,0,0,0,,Anda adalah Soyeon.
Dialog: 0,0:14:39.37,0:14:41.73,Lalai,,0,0,0,,Seorang wanita yang saya kenali selama bertahun-tahun,
Dialog: 0,0:14:44.57,0:14:47.94, Lalai,,0,0,0,,diam-diam disayangi dan dihargai.
Dialog: 0,0:14:57.12,0:14:59.35, Lalai,,0,0,0,,Saya tidak akan membiarkan anda kehilangan diri anda.
Dialog: 0,0:15:03.92,0:15:05.99, Lalai,,0,0,0,,Dan saya tidak akan lupa.
Dialog: 0,0:15:57.68,0:15:59.18,Lalai,,0,0,0,,Nah
Dialog: 0,0:16:01.28,0:16:03.78, Lalai,,0,0,0,, berlaku malam itu?
Dialog: 0,0:16:08.02,0:16:10.89, Lalai,,0,0,0,,Seseorang bunuh saya.
Dialog: 0,0:16:12.79,0:16:15.76,Lalai,Lily,0,0,0,,Saya memanggil penyembuh. Tunggu, Yang Mulia.
Dialog: 0,0:16:18.06,0:16:19.77, Lalai, Lily,0,0,0,, Penipu ini.
Dialog: 0,0:16:20.27,0:16:21.63,Lalai,Lily,0,0,0,,Saya sudah sakit kepala.
Dialog: 0,0:16:21.63,0:16:23.47,Lalai,Lily,0,0,0,,Jangan biarkan ia ditunjukkan di sini.
Dialog: 0,0:16:23.47,0:16:26.51,Lalai,Lily,0,0,0,,Jika tidak, anda akan dibiarkan tanpa organ pembiakan.
Dialog: 0,0:16:30.18,0:16:33.45,Lalai,Lily,0,0,0,,Kalau begitu mungkin awak patut makan? pegang je.
Dialog: 0,0:16:39.65,0:16:42.32,Lalai,Lily,0,0,0,,Saya berasa sakit. Nampak macam nak muntah.
Dialog: 0,0:16:43.12,0:16:45.09,Lalai,Lily,0,0,0,,Dan berapa banyak yang anda minum semalam?
Dialog: 0,0:16:45.09,0:16:47.76,Lalai,Lily,0,0,0,,Wanita ini tidak bertolak ansur dengan alkohol dengan baik.
Dialog: 0,0:16:48.13,0:16:50.56,Lalai,Lily,0,0,0,,Saya sudah lama tidak memutuskan sambungan seperti ini.
Dialog: 0,0:16:53.20,0:16:55.13,Lalai,Lily,0,0,0,,Bagaimana saya dapat kembali semalam?
Dialog: 0,0:16:56.34,0:16:59.41,Lalai,Lily,0,0,0,,Sepupu awak, Encik Benin, bawa awak.
Dialog: 0,0:16:59.41,0:17:02.14,Lalai,Lily,0,0,0,,Anda boleh mendapat masalah.
Dialog: 0,0:17:02.98,0:17:04.81,Lalai,Lily,0,0,0,,Terima kasih kepadanya, hanya saya
Dialog: 0,0:17:04.81,0:17:06.88,Lalai,Lily,0,0,0,,Saya tahu awak keluar semalam.
Dialog: 0,0:17:07.01,0:17:08.51,Lalai,Lily,0,0,0,,Abang saya?
Dialog: 0,0:17:08.58,0:17:10.55,Lalai,Lily,0,0,0,,Di mana kita berjumpa dengannya?
Dialog: 0,0:17:10.88,0:17:12.75,Lalai,Lily,0,0,0,,Saya tidak tahu dengan tepat.
Dialog: 0,0:17:13.52,0:17:17.19,Default,Lily,0,0,0,,By the way, dia cakap awak pengsan sebab ketakutan.
Dialog: 0,0:17:17.19,0:17:19.66, Lalai, Lilia,0,0,0,,-Apa yang membuatkan awak takut?\N-Saya tidak pengsan.
Dialog: 0,0:17:19.66,0:17:21.66,Lalai,Lily,0,0,0,,Saya minum sehingga pengsan.
Dialog: 0,0:17:21.76,0:17:24.20,Lalai,Lily,0,0,0,,Omong-omong, memang bagus untuk menjadi seorang ratu.
Dialog: 0,0:17:24.20,0:17:25.97,Lalai,Lily,0,0,0,,Pintu dibuka semasa perintah berkurung.
Dialog: 0,0:17:25.97,0:17:28.00,Lalai,Lily,0,0,0,,Dia sepupu awak
Dialog: 0,0:17:28.00,0:17:30.14,Lalai,Lily,0,0,0,,dan anak angkat Kim Jwageun.
Dialog: 0,0:17:30.14,0:17:31.67,Lalai,Lily,0,0,0,,Begitukah?
Dialog: 0,0:17:36.84,0:17:38.28,Lalai,Lily,0,0,0,,Di manakah wanita mahkamah Choi?
Dialog: 0,0:17:38.28,0:17:39.78,Lalai,Lily,0,0,0,,Lewat?
Dialog: 0,0:17:40.91,0:17:42.98,Lalai,Lily,0,0,0,,Abang awak hantar dia pergi dari istana,
Dialog: 0,0:17:42.98,0:17:45.62,Lalai,Lily,0,0,0,,supaya tiada sesiapa tahu yang anda sakit akibat mabuk.
Dialog: 0,0:17:46.02,0:17:47.69,Lalai,Lily,0,0,0,,Dia tidak mahu pergi,
Dialog: 0,0:17:47.69,0:17:50.92,Lalai,Lily,0,0,0,,sukar untuk memaksanya.
Dialog: 0,0:17:50.92,0:17:54.39,Lalai,Lily,0,0,0,,Mengapa semua orang begitu berat hati untuk meninggalkan istana?
Dialog: 0,0:17:54.73,0:17:57.93,Lalai,Lily,0,0,0,,Ia berbahaya di luar istana.
Dialog: 0,0:17:58.16,0:18:01.07,Lalai,Lily,0,0,0,,Semua yang anda perlukan ada di istana.
Dialog: 0,0:18:01.43,0:18:04.07, Lalai, Lily,0,0,0,,Semua orang di sini dipukau, atau apa?
Dialog: 0,0:18:04.07,0:18:06.51,Lalai,Lily,0,0,0,,Ada sesuatu yang tidak boleh ditemui di istana.
Dialog: 0,0:18:06.61,0:18:08.34,Lalai,Lily,0,0,0,,-Apakah ini?\N-Kebebasan.
Dialog: 0,0:18:10.54,0:18:12.98,Lalai,Lily,0,0,0,,Di luar istana semuanya sama.
Dialog: 0,0:18:13.65,0:18:17.35,Lalai,Lily,0,0,0,,Baiklah, saya gembira dia tiada di sana. Dia mengomel saya.
Dialog: 0,0:18:17.42,0:18:19.99,Lalai,Lily,0,0,0,,Kepala kecil saya.
Dialog: 0,0:18:21.52,0:18:24.06,Lalai,Lily,0,0,0,,Saya perlukan ramen pedas untuk mabuk saya
Dialog: 0,0:18:24.06,0:18:26.73, Lalai, Lily,0,0,0,,dan peluh. Ubat yang hebat.
Dialog: 0,0:18:27.86,0:18:29.90,Lalai,Lily,0,0,0,,Tiada ramen di sini.
Dialog: 0,0:18:29.90,0:18:32.33, Lalai, Lily,0,0,0,,Dan minuman mabuk.
Dialog: 0,0:18:35.10,0:18:37.40,Lalai,Lily,0,0,0,,Tetapi di sini saya mempunyai kuasa.
Dialog: 0,0:18:39.91,0:18:41.87,Lalai,Lily,0,0,0,,Tuhan.
Dialog: 0,0:18:42.41,0:18:43.91,Lalai,Lily,0,0,0,,Nyalakan api.
Dialog: 0,0:18:44.44,0:18:45.58,Lalai,Lily,0,0,0,,-Nyalakan api.\N-Nyalakan api.
Dialog: 0,0:18:45.58,0:18:48.98,Lalai,Lily,0,0,0,,Saya tidak tahu apa yang dia mahu.
Dialog: 0,0:18:48.98,0:18:50.05,Lalai,Lily,0,0,0,,Apa?
Dialog: 0,0:18:50.05,0:18:52.32, Lalai, Lily,0,0,0,, Hidangan untuk dewan Daejojon.
Dialog: 0,0:18:52.32,0:18:53.72,Lalai,Lily,0,0,0,,Ya.
Dialog: 0,0:18:57.82,0:18:59.49,Lalai,Lily,0,0,0,,Karut apa ini?
Dialog: 0,0:19:12.11,0:19:14.01,Lalai,Lily,0,0,0,,Adakah daging sudah masak?
Dialog: 0,0:19:33.66,0:19:35.26,Lalai,Lily,0,0,0,,Bukan ini.
Dialog: 0,0:19:36.73,0:19:38.83,Lalai,Lily,0,0,0,,Baiklah, okey. Kali ini...
Dialog: 0,0:19:49.21,0:19:52.28,Lalai,Lily,0,0,0,,Sial. Adakah ini sahaja yang mampu dia lakukan?
Dialog: 0,0:19:55.45,0:19:58.62,Lalai,Lily,0,0,0,,Apa yang salah dengan makanan saya? Apa kejadahnya?
Dialog: 0,0:20:12.06,0:20:14.33, Lalai,Lily,0,0,0,,Ugh, pemakanan yang sihat.
Dialog: 0,0:20:30.32,0:20:31.92,Lalai,Lily,0,0,0,,Tidak pedas langsung.
Dialog: 0,0:20:37.76,0:20:40.53, Lalai, Lily,0,0,0,,Sangat pedas. Adakah anda mahu membunuh saya?
Dialog: 0,0:20:45.97,0:20:47.57,Lalai,Lily,0,0,0,,Saya sudah cukup!
Dialog: 0,0:20:47.57,0:20:49.97,Lalai,Lily,0,0,0,,Jika anda tidak suka, biarkan dia datang ke sini dan masak!
Dialog: 0,0:20:49.97,0:20:53.61,Lalai,Lily,0,0,0,,Satu gangguan. Saya akan masak sendiri.
Dialog: 0,0:20:59.71,0:21:01.41, Lalai, Lily,0,0,0,, Relau mempunyai kuasa api,
Dialog: 0,0:21:01.41,0:21:03.12,Lalai,Lily,0,0,0,,tetapi api sukar dikawal.
Dialog: 0,0:21:03.12,0:21:06.55,Lalai,Lily,0,0,0,,Kekonduksian terma dandang agak tinggi.
Dialog: 0,0:21:09.72,0:21:11.86,Lalai,Lily,0,0,0,,Bagaimana jika tuanku cedera, Yang Mulia?
Dialog: 0,0:21:11.86,0:21:13.16,Lalai,Lily,0,0,0,,Anda tidak pernah ke dapur sejak itu,
Dialog: 0,0:21:13.16,0:21:14.83, Lalai, Lily,0,0,0,,bagaimana kami berhenti bermain rumah.
Dialog: 0,0:21:14.83,0:21:17.43,Lalai,Lily,0,0,0,,Walaupun saya hanya datang ke sini untuk bermain rumah,
Dialog: 0,0:21:17.76,0:21:19.60,Lalai,Lily,0,0,0,,Saya masak lebih baik daripada dia.
Dialog: 0,0:21:23.64,0:21:25.17,Lalai,Lily,0,0,0,,Berhati-hatilah Tuanku.
Dialog: 0,0:21:25.17,0:21:27.27,Lalai,Lily,0,0,0,,Awak pegang dia macam tu?
Dialog: 0,0:21:27.64,0:21:29.54,Lalai,Lily,0,0,0,,Berhati-hati dengan jari anda.
Dialog: 0,0:21:34.48,0:21:35.98,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:21:42.56,0:21:45.16,Lalai,Lily,0,0,0,,Saya memasak buat kali pertama, jadi saya tidak tahu sama ada ia betul.
Dialog: 0,0:21:45.16,0:21:48.79,Lalai,Lily,0,0,0,,Nampaknya anda perlu memotongnya seperti ini.
Dialog: 0,0:22:51.49,0:22:52.99,Lalai,Lily,0,0,0,,Ya.
Dialog: 0,0:23:06.07,0:23:08.64,Lalai,Lily,0,0,0,,Saya pasti ia kelihatan cantik sahaja.
Dialog: 0,0:23:08.64,0:23:10.88,Lalai,Lily,0,0,0,,Saya yakin ia tidak betul-betul berpengalaman.
Dialog: 0,0:23:11.28,0:23:12.95,Lalai,Lily,0,0,0,,Sudah tentu.
Dialog: 0,0:23:12.95,0:23:15.55,Lalai,Lily,0,0,0,,Ya. Anda betul-betul betul.
Dialog: 0,0:23:15.55,0:23:16.98,Lalai,Lily,0,0,0,,Lepaskan saya.
Dialog: 0,0:23:17.45,0:23:21.15,Lalai,Lily,0,0,0,,Saya telah bekerja di dapur diraja selama 30 tahun.
Dialog: 0,0:23:21.15,0:23:23.39,Lalai,Lily,0,0,0,,Memasak ialah ketinggian kemahiran.
Dialog: 0,0:23:24.89,0:23:26.19,Lalai,Lily,0,0,0,,Baik.
Dialog: 0,0:23:26.19,0:23:29.33, Lalai, Lily,0,0,0,,Saya akan cuba sendiri untuk memahami betapa dahsyatnya perkara itu.
Dialog: 0,0:23:29.43,0:23:31.53,Lalai,Lily,0,0,0,,Ini tidak sedap langsung.
Dialog: 0,0:23:43.14,0:23:46.18,Lalai,Lily,0,0,0,,Tuhan.
Dialog: 0,0:23:55.55,0:23:57.16,Lalai,Lily,0,0,0,,Adakah semuanya teruk?
Dialog: 0,0:23:59.43,0:24:01.06,Lalai,Lily,0,0,0,,Bau Shiitake
Dialog: 0,0:24:01.73,0:24:03.36, Lalai,Lily,0,0,0,,dan bawang hijau.
Dialog: 0,0:24:05.66,0:24:07.97, Lalai,Lily,0,0,0,,Aroma daging yang kaya.
Dialog: 0,0:24:09.34,0:24:12.84,Lalai,Lily,0,0,0,,Rasa ketiga-tiga bahan itu dicampur. Dan ini...
Dialog: 0,0:24:25.52,0:24:28.75,Lalai,Lily,0,0,0,,"Sam" ialah tiga, "hyang" ialah aroma,
Dialog: 0,0:24:28.75,0:24:31.12,Lalai,Lily,0,0,0,,dan “ra” ialah periuk.
Dialog: 0,0:24:31.12,0:24:33.73,Lalai,Lily,0,0,0,,Tiga bauan dalam periuk,
Dialog: 0,0:24:33.73,0:24:35.79,Lalai,Lily,0,0,0,,"samhyanra".
Dialog: 0,0:24:38.23,0:24:43.47,Lalai,Lily,0,0,0,,Samhyang ramen!
Dialog: 0,0:25:11.00,0:25:13.27, Lalai, Lily,0,0,0,, Tepat seperti yang diperlukan.
Dialog: 0,0:25:13.27,0:25:16.04, Lalai, Lily,0,0,0,,Mosodium glutamat di sana.
Dialog: 0,0:25:16.04,0:25:17.60,Lalai,Lily,0,0,0,,Tetapi lebih baik daripada tiada.
Dialog: 0,0:25:19.07,0:25:22.88,Lalai,Lily,0,0,0,,Terima kasih kepada anda, saya mencuba banyak makanan istimewa,
Dialog: 0,0:25:22.88,0:25:25.94,Lalai,Lily,0,0,0,,tetapi tiada apa yang menakjubkan.
Dialog: 0,0:25:25.98,0:25:27.55,Lalai,Lily,0,0,0,,Cuba lagi.
Dialog: 0,0:25:28.85,0:25:33.05,Lalai,Lily,0,0,0,,Ketahuilah bahawa jika anda ditawarkan ramen, ini adalah cinta sejati.
Dialog: 0,0:25:34.02,0:25:36.16, Lalai, Lily,0,0,0,, Kemudian jika anda tidak keberatan.
Dialog: 0,0:25:43.60,0:25:45.56,Lalai,Lily,0,0,0,,Memang...
Dialog: 0,0:25:46.40,0:25:48.33,Lalai,Lily,0,0,0,,Anda, yang tidak pernah memegang pisau sebelum ini,
Dialog: 0,0:25:48.33,0:25:50.30, Lalai, Lily,0,0,0,,masak lebih baik daripada chef diraja.
Dialog: 0,0:25:50.47,0:25:53.64, Lalai, Lily,0,0,0,,Adakah ada sesuatu yang anda tidak boleh lakukan?
Dialog: 0,0:25:55.04,0:25:59.24,Lalai,Lily,0,0,0,,Saya seorang yang ideal, mampu melakukan apa sahaja.
Dialog: 0,0:25:59.85,0:26:02.18, Lalai, Lily,0,0,0,,Tetapi sekarang saya tidak boleh melakukan perkara yang paling penting.
Dialog: 0,0:26:02.82,0:26:06.25,Lalai,Lily,0,0,0,,Apa yang saya profesional dan paling saya sukai.
Dialog: 0,0:26:08.19,0:26:11.42,Lalai,Lily,0,0,0,,Saya faham. sulaman?
Dialog: 0,0:26:11.82,0:26:14.59,Lalai,Lily,0,0,0,,Tepat sekali. Anda melakukannya dengan baik.
Dialog: 0,0:26:16.03,0:26:17.50,Lalai,Lily,0,0,0,,Ya.
Dialog: 0,0:26:17.90,0:26:19.77,Lalai,Lily,0,0,0,,Apabila saya menyentuh,
Dialog: 0,0:26:19.77,0:26:23.60,Lalai,Lily,0,0,0,,bunga sedang mekar dan rama-rama berkibar.
Dialog: 0,0:26:23.87,0:26:26.41,Lalai,Lily,0,0,0,,Itu sesuatu.
Dialog: 0,0:26:29.07,0:26:31.98,Lalai,Lily,0,0,0,,Baginda ada di sini.
Dialog: 0,0:26:32.55,0:26:34.51,Lalai,Lily,0,0,0,,Kenapa sekarang?
Dialog: 0,0:26:34.51,0:26:37.28,Lalai,Lily,0,0,0,,Sial. Mee akan lembut.
Dialog: 0,0:26:39.72,0:26:41.12,Lalai,Lily,0,0,0,,Panas.
Dialog: 0,0:26:44.92,0:26:46.46,Lalai,Lily,0,0,0,,Permaisuriku.
Dialog: 0,0:26:57.04,0:26:58.84,Lalai,Lily,0,0,0,,Pada waktu pagi saya melawat orang tua
Dialog: 0,0:26:58.84,0:27:01.97,Lalai,Lily,0,0,0,,dan saya tertanya-tanya bagaimana perasaan anda, jadi saya melawat.
Dialog: 0,0:27:02.84,0:27:05.08,Lalai,Lily,0,0,0,,Adakah dia tahu tentang malam tadi?
Dialog: 0,0:27:05.44,0:27:07.68,Lalai,Lily,0,0,0,,Tiada sebab untuk berasa sedih.
Dialog: 0,0:27:07.88,0:27:10.45,Lalai,Lily,0,0,0,,Bagaimana malam anda?
Dialog: 0,0:27:10.45,0:27:12.05,Lalai,Lily,0,0,0,,Tukar subjek.
Dialog: 0,0:27:12.05,0:27:14.09,Lalai,Lily,0,0,0,,Dia menukar subjek.
Dialog: 0,0:27:14.95,0:27:16.56,Lalai,Lily,0,0,0,,Doamu.
Dialog: 0,0:27:19.49,0:27:22.66,Lalai,Lily,0,0,0,,Ratu, adakah anda telah minum?
Dialog: 0,0:27:23.73,0:27:26.50,Lalai,Lily,0,0,0,,Saya? Sudah tentu tidak.
Dialog: 0,0:27:26.50,0:27:28.20,Lalai,Lily,0,0,0,,Awak belum minum?
Dialog: 0,0:27:33.37,0:27:35.01,Lalai,Lily,0,0,0,,Adakah kita bermain pertandingan merenung?
Dialog: 0,0:27:39.68,0:27:42.55,Lalai,Lily,0,0,0,,Saya tidak tahu anda seorang pembohong yang baik.
Dialog: 0,0:27:50.32,0:27:52.06,Lalai,Lily,0,0,0,,Oh, maaf.
Dialog: 0,0:27:52.32,0:27:54.13,Lalai,Lily,0,0,0,,Saya biasanya tidak melakukan ini,
Dialog: 0,0:27:54.13,0:27:56.46,Lalai,Lily,0,0,0,,tetapi anda terlalu dekat.
Dialog: 0,0:27:59.97,0:28:02.20,Lalai,Lily,0,0,0,,Hidung saya hampir tertanggal.
Dialog: 0,0:28:02.77,0:28:04.44,Lalai,Lily,0,0,0,,Saya ada banyak nak buat. Maaf.
Dialog: 0,0:28:04.44,0:28:06.31,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:28:08.24,0:28:10.08,Lalai,Lily,0,0,0,,Saya akan pergi ke dewan Songjeongjong.
Dialog: 0,0:28:10.08,0:28:11.58,Lalai,Lily,0,0,0,,Ya, Tuanku.
Dialog: 0,0:28:15.88,0:28:19.08,Lalai,Lily,0,0,0,,Nampaknya dia tidak terlalu sibuk. \NBTetapi jika ya, mengapa anda datang ke sini?
Dialog: 0,0:28:20.72,0:28:23.36,Lalai,Lily,0,0,0,,Sial, sekarang dia sudah lembut.
Dialog: 0,0:28:33.27,0:28:35.47,Lalai,Spillik,0,0,0,,Salam, raja.
Dialog: 0,0:28:35.47,0:28:36.94,Lalai,Spillit,0,0,0,,Abang.
Dialog: 0,0:28:37.10,0:28:39.51,Lalai,Spillit,0,0,0,,Mendekat
Dialog: 0,0:28:39.51,0:28:41.84,Lalai,Spillik,0,0,0,,dan beritahu saya, adakah saya berbau busuk?
Dialog: 0,0:28:41.84,0:28:43.38, Lalai, Spillie,0,0,0,, Busuk?
Dialog: 0,0:28:43.81,0:28:45.78,Lalai,Spillik,0,0,0,,Saya belum boleh katakan lagi.
Dialog: 0,0:28:46.21,0:28:48.41,Lalai,Spillit,0,0,0,,Sediakan segalanya.
Dialog: 0,0:28:51.12,0:28:54.02,Lalai,Spillit,0,0,0,,Apa yang ratu saya makan?
Dialog: 0,0:28:54.19,0:28:57.22,Lalai,Spillik,0,0,0,,Sungguh memalukan!
Dialog: 0,0:29:05.23,0:29:08.43,Lalai,Spillik,0,0,0,,Yang Mulia, Kim Byungin telah tiba.
Dialog: 0,0:29:08.97,0:29:11.50,Lalai,Spillik,0,0,0,,Hah, abang?
Dialog: 0,0:29:13.17,0:29:16.24,Lalai,Spillik,0,0,0,,Saya berhutang banyak dengan awak untuk malam tadi.
Dialog: 0,0:29:16.24,0:29:18.78,Lalai,Spillik,0,0,0,,Saya melakukan apa yang saya perlu lakukan.
Dialog: 0,0:29:22.45,0:29:25.28,Lalai,Spillik,0,0,0,,Memandangkan saya ada tetamu, saya patut menawarkan teh.
Dialog: 0,0:29:25.28,0:29:27.05,Lalai,Spillik,0,0,0,,Saya merindui awak.
Dialog: 0,0:29:27.65,0:29:29.62,Lalai,Spillik,0,0,0,,Ini jatuh ke kepala saya.
Dialog: 0,0:29:29.62,0:29:32.16,Lalai,Spillit,0,0,0,,Okey. Kita perlu bermain bersama.
Dialog: 0,0:29:32.22,0:29:34.49,Lalai,Spillik,0,0,0,,Saya juga merindui awak.
Dialog: 0,0:29:35.93,0:29:37.60,Lalai,Spillik,0,0,0,,Gembira mendengarnya.
Dialog: 0,0:29:38.10,0:29:42.20,Lalai,XO,0,0,0,,Kata-kata awak menghilangkan kebimbangan saya.
Dialog: 0,0:29:42.30,0:29:44.74,Lalai,XO,0,0,0,,Apa yang sangat menyentuh perasaannya?
Dialog: 0,0:29:44.74,0:29:46.57,Lalai,XO,0,0,0,,Saya pernah mendengar khabar angin,
Dialog: 0,0:29:47.34,0:29:50.01,Lalai,XO,0,0,0,,yang awak jatuh ke dalam tasik selepas berjumpa saya.
Dialog: 0,0:29:50.01,0:29:52.28,Lalai,XO,0,0,0,,Hari itu mereka kata mereka takut.
Dialog: 0,0:29:52.51,0:29:54.11,Lalai,XO,0,0,0,,Mengenai apa?
Dialog: 0,0:29:55.48,0:29:59.15,Lalai,XO,0,0,0,,Saya cakap hari tu saya takut...
Dialog: 0,0:29:59.15,0:30:02.39,Lalai,XO,0,0,0,,Dan saya takut?..
Dialog: 0,0:30:04.12,0:30:08.09,Lalai,XO,0,0,0,,Tidak ada yang lebih buruk di dunia daripada manusia.
Dialog: 0,0:30:08.46,0:30:10.76,Lalai,XO,0,0,0,,Adakah anda diancam?
Dialog: 0,0:30:11.46,0:30:13.73,Lalai,XO,0,0,0,,Anda tahu siapa yang menolak
Dialog: 0,0:30:13.73,0:30:15.27,Lalai,XO,0,0,0,,anda ke dalam tasik
Dialog: 0,0:30:15.27,0:30:16.90, Lalai, XO,0,0,0,,dan diserang malam tadi?
Dialog: 0,0:30:17.60,0:30:19.10,Lalai,XO,0,0,0,,Berhenti.
Dialog: 0,0:30:19.20,0:30:21.14,Lalai,XO,0,0,0,,Saya tahu tentang tasik itu.
Dialog: 0,0:30:21.17,0:30:23.54,Lalai,XO,0,0,0,,Bagaimana dengan malam tadi?
Dialog: 0,0:30:24.24,0:30:27.01, Lalai,ХО,0,0,0,,-Apa yang awak cakapkan?\N-Anda tidak ingat?
Dialog: 0,0:30:27.38,0:30:29.62,Lalai,XO,0,0,0,,Mereka cuba membunuh awak malam tadi.
Dialog: 0,0:30:29.62,0:30:31.12,Lalai,XO,0,0,0,,Bunuh?
Dialog: 0,0:30:31.42,0:30:33.12,Lalai,XO,0,0,0,,Adakah saya hampir mati?
Dialog: 0,0:30:33.12,0:30:34.95,Lalai,XO,0,0,0,,Siapa itu? kenapa saya?
Dialog: 0,0:30:34.95,0:30:36.96,Lalai,XO,0,0,0,,Saya harap anda tahu,
Dialog: 0,0:30:37.86,0:30:39.49,Lalai,XO,0,0,0,,tetapi saya nampak tidak.
Dialog: 0,0:30:40.06,0:30:43.93,Lalai,XO,0,0,0,,Apa? Adakah dua orang sudah cuba membunuhnya?
Dialog: 0,0:30:44.43,0:30:46.06,Lalai,XO,0,0,0,,Adakah wanita ini dalam bahaya?
Dialog: 0,0:30:46.06,0:30:47.77,Lalai,XO,0,0,0,,Hari anda jatuh ke dalam tasik
Dialog: 0,0:30:47.77,0:30:51.27,Lalai,XO,0,0,0,,anda kata anda takut. Saya rasa ia ada kaitan dengannya.
Dialog: 0,0:30:51.54,0:30:55.01,Lalai,XO,0,0,0,,Nampaknya anda masih belum sedar.\N Saya menghadapi masalah dengan ingatan saya.
Dialog: 0,0:30:55.01,0:30:58.54,Lalai,XO,0,0,0,,Anda lebih tahu apa yang kami bincangkan.
Dialog: 0,0:30:59.75,0:31:01.25,Lalai,XO,0,0,0,,Anda betul
Dialog: 0,0:31:03.92,0:31:06.55,Lalai,XO,0,0,0,,lupa semua tentang hari itu?
Dialog: 0,0:31:06.55,0:31:09.32,Lalai,XO,0,0,0,,Ya, saya tidak ingat apa-apa.
Dialog: 0,0:31:12.22,0:31:13.76,Lalai,XO,0,0,0,,Tidak mengapa.
Dialog: 0,0:31:13.76,0:31:15.96,Lalai,XO,0,0,0,,Beritahu saya, lelaki ini...
Dialog: 0,0:31:16.56,0:31:20.50,Lalai,XO,0,0,0,,Apa yang orang bajingan ini lakukan kepada saya semalam?
Dialog: 0,0:31:21.00,0:31:23.24,Lalai,XO,0,0,0,,Ia semakin menghampiri perintah berkurung.
Dialog: 0,0:31:23.24,0:31:24.97,Lalai,XO,0,0,0,,Menilai dari cara dia menggunakan pedang
Dialog: 0,0:31:24.97,0:31:28.17,Lalai,XO,0,0,0,,dan dia berpakaian, dia bukan orang biasa.
Dialog: 0,0:31:28.44,0:31:30.58,Lalai,XO,0,0,0,,Saya tidak tahu jumlahnya,
Dialog: 0,0:31:30.64,0:31:33.04,Lalai,XO,0,0,0,,tetapi mereka membantunya.
Dialog: 0,0:31:33.05,0:31:35.61,Lalai,XO,0,0,0,,Jika bukan kerana awak, saya akan mati.
Dialog: 0,0:31:35.61,0:31:38.42,Lalai,XO,0,0,0,,Saya sangat gembira kita bertemu semalam.
Dialog: 0,0:31:44.39,0:31:45.86,Lalai,XO,0,0,0,,Hah?
Dialog: 0,0:31:51.56,0:31:53.27,Lalai,XO,0,0,0,,Hei.
Dialog: 0,0:31:58.24,0:32:00.84,Lalai,XO,0,0,0,,Kenapa awak keluar dari istana malam tadi?
Dialog: 0,0:32:00.84,0:32:03.88,Lalai,ХО,0,0,0,,Saya bosan dan memutuskan untuk berjalan-jalan.
Dialog: 0,0:32:05.64,0:32:09.58,Lalai,XO,0,0,0,,Jika Janda Permaisuri mengetahui,
Dialog: 0,0:32:09.58,0:32:12.12,Lalai,XO,0,0,0,,Saya dalam masalah.
Dialog: 0,0:32:12.55,0:32:15.69,Lalai,XO,0,0,0,,Bukan sahaja kebebasan pergerakan saya akan disekat,
Dialog: 0,0:32:15.69,0:32:17.66,Lalai,XO,0,0,0,,tetapi Hongyeon turut dilaksanakan.
Dialog: 0,0:32:18.26,0:32:21.23,Lalai,XO,0,0,0,,Bolehkah anda merahsiakan perkara ini?
Dialog: 0,0:32:21.59,0:32:23.93,Lalai,XO,0,0,0,,Tetapi kita perlu mencari penjenayah.
Dialog: 0,0:32:24.36,0:32:26.26,Lalai,XO,0,0,0,,Lakukan dengan senyap.
Dialog: 0,0:32:26.33,0:32:29.20,Lalai,XO,0,0,0,,Saya akan menghadapi masalah, anda tahu?
Dialog: 0,0:32:30.20,0:32:31.70,Lalai,XO,0,0,0,,Saya faham.
Dialog: 0,0:32:31.70,0:32:34.07,Lalai,XO,0,0,0,,Siapa tahu anda meninggalkan istana?
Dialog: 0,0:32:34.07,0:32:36.27,Lalai,XO,0,0,0,,Honyoung sahaja.
Dialog: 0,0:32:37.34,0:32:40.31,Lalai,XO,0,0,0,,Saya akan minta orang menontonnya.
Dialog: 0,0:32:40.31,0:32:44.55,Lalai,XO,0,0,0,,Tidak, dia setia kepada saya, malah dia bersedia untuk mati untuk saya.
Dialog: 0,0:32:44.55,0:32:45.98,Lalai,XO,0,0,0,,Dia tiada kaitan dengannya.
Dialog: 0,0:32:45.98,0:32:49.96,Lalai,XO,0,0,0,,Yang Mulia, jangan percaya sesiapa.
Dialog: 0,0:32:49.96,0:32:51.89,Lalai,ХО,0,0,0,,Saya juga sudah lama mengenalinya,
Dialog: 0,0:32:51.89,0:32:54.53,Lalai,XO,0,0,0,,tetapi yang paling dekat dengan anda sentiasa lebih berbahaya.
Dialog: 0,0:32:55.26,0:32:58.70,Lalai,XO,0,0,0,,Hanya kerana anda berada di dalam istana tidak bermakna tiada apa-apa yang mengancam anda. Tidak.
Dialog: 0,0:33:00.53,0:33:02.80, Lalai, XO,0,0,0,,Ia lebih berbahaya di sini.
Dialog: 0,0:33:03.20,0:33:07.11,Lalai,XO,0,0,0,,Tepat sekali, saya terlupa di mana saya berada.
Dialog: 0,0:33:07.11,0:33:09.21,Lalai,XO,0,0,0,,Di dalam istana yang penuh tipu daya.
Dialog: 0,0:33:09.21,0:33:12.78,Lalai,XO,0,0,0,,Tempat di mana kehidupan anda sentiasa berada dalam keseimbangan.
Dialog: 0,0:33:14.48,0:33:16.78,Lalai,XO,0,0,0,,Jangan risau.
Dialog: 0,0:33:16.92,0:33:19.38,Lalai,XO,0,0,0,,Saya akan melindungi kamu.
Dialog: 0,0:33:19.95,0:33:21.72,Lalai,XO,0,0,0,,Terima kasih, tetapi
Dialog: 0,0:33:21.95,0:33:23.72,Lalai,XO,0,0,0,,Saya boleh mengendalikannya sendiri.
Dialog: 0,0:33:24.86,0:33:27.29,Lalai,XO,0,0,0,,Sekarang bukan masa untuk berehat.
Dialog: 0,0:33:27.59,0:33:31.06,Lalai,XO,0,0,0,,Jangan cuba untuk kelihatan kuat di hadapan saya.
Dialog: 0,0:33:47.61,0:33:49.75,Lalai,XO,0,0,0,,Mungkin anda terlupa,
Dialog: 0,0:33:50.18,0:33:52.32,Lalai,XO,0,0,0,,tetapi saya akan ingat sampai bila-bila.
Dialog: 0,0:33:52.75,0:33:55.95,Lalai,XO,0,0,0,,Memori malam itu akan kekal di hati saya selamanya.
Dialog: 0,0:34:01.23,0:34:04.33,Lalai,XO,0,0,0,,Saya akan mengetahui siapa dia pada sebarang kos.
Dialog: 0,0:34:06.30,0:34:09.07,Lalai,XO,0,0,0,,
Dialog: 0,0:34:11.20,0:34:14.44,Lalai,XO,0,0,0,,Mereka menjual benang sutera di sini
Dialog: 0,0:34:14.94,0:34:16.41,Lalai,XO,0,0,0,,dari Qing?
Dialog: 0,0:34:36.19,0:34:39.50,Lalai,XO,0,0,0,,Saya dengar awak ada barang berharga dari Qing, jadi saya datang.
Dialog: 0,0:34:46.24,0:34:49.01,Lalai,XO,0,0,0,,Khabar angin terbang dengan pantas.
Dialog: 0,0:34:50.84,0:34:52.28,Lalai,XO,0,0,0,,Sila.
Dialog: 0,0:35:08.56,0:35:13.53,Lalai,XO,0,0,0,,Adakah anda menyimpan barang berharga di tempat yang menyeramkan?
Dialog: 0,0:35:14.47,0:35:16.97,Lalai,XO,0,0,0,,Kerana ia berharga.
Dialog: 0,0:35:30.25,0:35:31.68,Lalai,XO,0,0,0,,Di sini.
Dialog: 0,0:35:31.85,0:35:33.55,Lalai,XO,0,0,0,,Apakah ini?
Dialog: 0,0:35:34.85,0:35:37.82,Lalai,XO,0,0,0,,Tutup sebelah mata.
Dialog: 0,0:35:38.29,0:35:42.23,Lalai,XO,0,0,0,,Dan kemudian pusing. Begitulah caranya.
Dialog: 0,0:35:42.23,0:35:44.56,Lalai,XO,0,0,0,,Tuan! Di sini?
Dialog: 0,0:35:44.56,0:35:46.06,Lalai,XO,0,0,0,,Saya datang!
Dialog: 0,0:35:46.83,0:35:48.90,Lalai,XO,0,0,0,,Nampaknya awak salah faham saya.
Dialog: 0,0:35:48.90,0:35:51.54,Lalai,XO,0,0,0,,Saya sedang mencari benang sutera...
Dialog: 0,0:35:53.57,0:35:55.74,Lalai,XO,0,0,0,,Saya ingin membeli benang.
Dialog: 0,0:35:56.61,0:35:59.38,Lalai,XO,0,0,0,,Apakah yang perlu saya lakukan dengan paip ini?
Dialog: 0,0:36:17.23,0:36:20.00,Lalai,XO,0,0,0,,Kim Byungin berkata untuk tidak mempercayai sesiapa.
Dialog: 0,0:36:20.00,0:36:21.67,Lalai,XO,0,0,0,,Jadi bagaimana anda boleh mempercayai dia?
Dialog: 0,0:36:22.23,0:36:24.37,Lalai,XO,0,0,0,,Honyeon tidak akan membahayakan saya.
Dialog: 0,0:36:24.64,0:36:27.11,Lalai,XO,0,0,0,,Mungkin Cho Hwajin lagi?
Dialog: 0,0:36:28.14,0:36:29.47,Lalai,XO,0,0,0,,Seminggu adalah selamanya.
Dialog: 0,0:36:29.47,0:36:31.58,Lalai,XO,0,0,0,,Ia tidak akan mengambil masa yang lama untuk mati.
Dialog: 0,0:36:32.28,0:36:33.88,Lalai,XO,0,0,0,,Saya akan lakukan apa yang saya mahir.
Dialog: 0,0:36:33.88,0:36:35.58,Lalai,XO,0,0,0,,Saya akan menang dengan makanan.
Dialog: 0,0:36:35.61,0:36:37.52,Lalai,XO,0,0,0,,Dia akan mengalahkan mana-mana perisai.
Dialog: 0,0:36:37.52,0:36:39.62, Lalai,XO,0,0,0,,Dan ia akan berfungsi pada Ratu Janda.
Dialog: 0,0:36:42.65,0:36:44.09,Lalai,XO,0,0,0,,Sebentar.
Dialog: 0,0:36:44.26,0:36:46.69,Lalai,XO,0,0,0,,Adakah ini sisa makanan Janda Ratu?
Dialog: 0,0:36:46.69,0:36:48.19,Lalai,XO,0,0,0,,Ya, Tuanku.
Dialog: 0,0:36:50.30,0:36:52.60,Lalai,XO,0,0,0,,Biar saya lihat.
Dialog: 0,0:36:52.80,0:36:54.57,Lalai,XO,0,0,0,,Leftovers boleh memberi idea
Dialog: 0,0:36:54.57,0:36:56.94,Lalai,XO,0,0,0,,tentang kesihatan dan pilihan.
Dialog: 0,0:36:56.94,0:36:59.60,Lalai,XO,0,0,0,,Anda tidak boleh melihatnya.
Dialog: 0,0:36:59.60,0:37:01.04,Lalai,XO,0,0,0,,Alih keluar.
Dialog: 0,0:37:01.34,0:37:03.98,Lalai,XO,0,0,0,,Apa yang kamu lakukan? Saya permaisuri.
Dialog: 0,0:37:03.98,0:37:05.48,Lalai,XO,0,0,0,,Maaf,
Dialog: 0,0:37:05.48,0:37:07.78,Lalai,XO,0,0,0,,tetapi saya tukang masak diraja.
Dialog: 0,0:37:07.78,0:37:09.68,Lalai,XO,0,0,0,,Ini bermakna di dapur -
Dialog: 0,0:37:09.68,0:37:11.98,Lalai,XO,0,0,0,,Saya adalah raja.
Dialog: 0,0:37:12.88,0:37:15.65,Lalai,XO,0,0,0,,Kemudian biarkan kemahiran kita bercakap untuk diri mereka sendiri.
Dialog: 0,0:37:16.79,0:37:18.46,Lalai,XO,0,0,0,,Mari kita lihat siapa raja di sini.
Dialog: 0,0:37:21.19,0:37:23.03, Lalai, XO,0,0,0,,Jangan cakap begitu.
Dialog: 0,0:37:23.16,0:37:26.46,Lalai,XO,0,0,0,,Sudah tiba masanya untuk saya memasak. perpisahan.
Dialog: 0,0:37:26.83,0:37:29.37,Lalai,XO,0,0,0,,Apa, anda takut kalah?
Dialog: 0,0:37:30.04,0:37:32.97,Lalai,XO,0,0,0,,Seorang yang hanya bermain di dapur semasa kecil?
Dialog: 0,0:37:46.85,0:37:50.05,Lalai,XO,0,0,0,,Nah, bagaimana persiapannya?..
Dialog: 0,0:38:19.38,0:38:20.92,Lalai,XO,0,0,0,,Tuhan!
Dialog: 0,0:38:23.79,0:38:25.52,Lalai,XO,0,0,0,,Ratu!
Dialog: 0,0:38:25.52,0:38:28.39,Lalai,XO,0,0,0,,Ratu!
Dialog: 0,0:38:28.39,0:38:30.63,Lalai,XO,0,0,0,,Chef Diraja!
Dialog: 0,0:38:30.63,0:38:46.81,Lalai,XO,0,0,0,,-Ratu!\N-Chef Diraja!
Dialog: 0,0:38:57.52,0:38:59.22,Lalai,XO,0,0,0,,Berhenti.
Dialog: 0,0:39:04.23,0:39:05.76,Lalai,XO,0,0,0,,Tidak!
Dialog: 0,0:39:07.87,0:39:09.30,Lalai,XO,0,0,0,,Sial.
Dialog: 0,0:39:12.54,0:39:14.04,Lalai,XO,0,0,0,,Memasak
Dialog: 0,0:39:14.64,0:39:16.47,Lalai,XO,0,0,0,,kelajuan adalah penting.
Dialog: 0,0:39:16.47,0:39:19.34,Lalai,XO,0,0,0,,Tetapi rasa adalah lebih penting.
Dialog: 0,0:39:19.34,0:39:20.85,Lalai,XO,0,0,0,,Betul.
Dialog: 0,0:39:26.62,0:39:28.95, Lalai,,0,0,0,,-Awak.\N-Apa yang awak mahukan?
Dialog: 0,0:39:28.95,0:39:31.36, Lalai,,0,0,0,, Berdasarkan pakaian anda, anda tidak bekerja di sini.
Dialog: 0,0:39:31.36,0:39:32.42, Lalai,,0,0,0,, Kedudukan anda?
Dialog: 0,0:39:32.42,0:39:34.83, Lalai,,0,0,0,,Saya sedang menyemak persembahan diraja.
Dialog: 0,0:39:34.83,0:39:37.13, Lalai,,0,0,0,,Ketua Inspektor Dapur Diraja.
Dialog: 0,0:39:37.33,0:39:40.03, Lalai,,0,0,0,,-Kemudian periksa makanan untuk rasa.\N-Saya?
Dialog: 0,0:39:40.47,0:39:41.93, Lalai,,0,0,0,,Semua yang hadir di sini
Dialog: 0,0:39:41.93,0:39:44.20,Lalai,,0,0,0,,tidak akan dapat menilai makanan dengan jujur.
Dialog: 0,0:39:44.20,0:39:45.80,Lalai,,0,0,0,,Berani, cuba.
Dialog: 0,0:39:46.87,0:39:48.37,Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,0:39:51.64,0:39:53.14, Lalai,,0,0,0,,Seperti yang anda katakan.
Dialog: 0,0:40:06.19,0:40:10.06,Lalai,,0,0,0,,Saya tidak mencuba apa-apa seperti ini sehingga sekarang.
Dialog: 0,0:40:10.33,0:40:11.66, Lalai,,0,0,0,,Seperti kebahagiaan,
Dialog: 0,0:40:11.66,0:40:14.43,Lalai,,0,0,0,,hidangan ini menggembirakan mulut saya.
Dialog: 0,0:40:14.67,0:40:19.47,Lalai,,0,0,0,,Sepanjang hidup saya, lidah saya tidak pernah merasai yang lebih indah...
Dialog: 0,0:40:19.50,0:40:20.97,Lalai,,0,0,0,,Nah...
Dialog: 0,0:40:28.21,0:40:29.81, Lalai,,0,0,0,,Siapa awak?
Dialog: 0,0:40:38.59,0:40:41.99, Lalai,,0,0,0,,Beraninya seorang gadis memasuki dapur diraja?
Dialog: 0,0:40:41.99,0:40:44.26,Lalai,,0,0,0,,Kejijikan.
Dialog: 0,0:40:47.60,0:40:49.73, Lalai,,0,0,0,,Adakah ini ditujukan untuk saya?
Dialog: 0,0:40:49.97,0:40:53.24, Lalai,,0,0,0,,Beraninya seorang gadis memasuki dapur diraja?
Dialog: 0,0:40:57.21,0:41:01.08, Lalai,,0,0,0,,No. Sudah tentu tidak.
Dialog: 0,0:41:07.19,0:41:10.02,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:41:12.49,0:41:13.89,Lalai,,0,0,0,,Cukup.
Dialog: 0,0:41:14.59,0:41:16.46,Lalai,,0,0,0,,Saya yang pertama,
Dialog: 0,0:41:16.46,0:41:18.50,Lalai,,0,0,0,,dan makanan saya sedap.
Dialog: 0,0:41:20.70,0:41:23.13, Lalai,,0,0,0,,Semasa saya di dapur,
Dialog: 0,0:41:23.33,0:41:25.30, Lalai,,0,0,0,,perkataan saya adalah undang-undang.
Dialog: 0,0:41:26.84,0:41:28.44, Lalai,,0,0,0,,Adakah anda akan bekerjasama dengan saya.
Dialog: 0,0:41:28.91,0:41:30.44,Lalai,,0,0,0,,-Ya, Tuanku.\N-Ya, Tuanku.
Dialog: 0,0:41:30.44,0:41:31.91, Lalai,,0,0,0,,Tidak cukup untuknya...
Dialog: 0,0:41:35.41,0:41:40.62,Lalai,,0,0,0,,Jika awak mahu, saya boleh mengambil awak sebagai pelajar.
Dialog: 0,0:41:43.62,0:41:47.46,Lalai,,0,0,0,,Yang Mulia, Tuanku kini berada di Dewan Daejojong.
Dialog: 0,0:41:54.57,0:41:56.93, Lalai,,0,0,0,,Kepada apa saya berhutang lawatan awal?
Dialog: 0,0:41:57.04,0:41:59.20,Lalai,,0,0,0,,Saya merindui awak, permaisuri saya.
Dialog: 0,0:41:59.90,0:42:02.34, Lalai,,0,0,0,,Dan awak sungguh comel hari ini.
Dialog: 0,0:42:02.87,0:42:05.48,Lalai,,0,0,0,,Tetapi bukankah sudah tiba masanya untuk anda kembali kepada diri anda sendiri?
Dialog: 0,0:42:05.48,0:42:08.05, Lalai,,0,0,0,,-Pasukan Khas.\N-Apa?
Dialog: 0,0:42:09.48,0:42:12.18,Lalai,,0,0,0,,Adakah anda ingin memberitahu saya tentang perkataan ini?
Dialog: 0,0:42:12.22,0:42:14.59,Lalai,,0,0,0,,-Adakah ini sejenis permainan?\N-Nah...
Dialog: 0,0:42:15.59,0:42:18.16,Lalai,,0,0,0,,Sudah tiba masanya untuk anda pergi.
Dialog: 0,0:42:19.59,0:42:21.13, Lalai,,0,0,0,, Tukang masak tentera.
Dialog: 0,0:42:21.49,0:42:22.96,Lalai,,0,0,0,,Apa?
Dialog: 0,0:42:24.23,0:42:26.36,Lalai,,0,0,0,,Tuhan. Nah, benar-benar, anda adalah raja.
Dialog: 0,0:42:26.36,0:42:28.57, Lalai,,0,0,0,,Sekarang saya akan katakan sesuatu, dan anda akan bunuh saya untuk itu?
Dialog: 0,0:42:28.57,0:42:30.10,Lalai,,0,0,0,,Teruskan.
Dialog: 0,0:42:31.00,0:42:33.27,Lalai,,0,0,0,,Karut apa yang awak cakapkan?
Dialog: 0,0:42:38.08,0:42:40.41,Lalai,,0,0,0,,Anda menggunakan bahasa kasar tanpa sebab.
Dialog: 0,0:42:40.41,0:42:43.21,Lalai,,0,0,0,,Anda pasti tidak berpuas hati dengan kehidupan anda.
Dialog: 0,0:42:43.21,0:42:45.58, Lalai,,0,0,0,, Beritahu saya semua yang mengganggu anda.
Dialog: 0,0:42:45.58,0:42:48.29,Lalai,,0,0,0,,Jika awak mahu, saya boleh kekal.
Dialog: 0,0:42:48.49,0:42:50.32,Lalai,,0,0,0,,Apa yang awak cakap, semuanya baik-baik saja dengan saya.
Dialog: 0,0:42:50.32,0:42:53.99,Lalai,,0,0,0,,Ya, saya benar-benar tidak dapat berpuas hati dengan betapa indahnya hidup saya.
Dialog: 0,0:42:55.29,0:42:57.76,Lalai,,0,0,0,,Pernahkah anda melihat sesiapa hari ini?
Dialog: 0,0:42:59.00,0:43:00.27,Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:43:00.27,0:43:02.10, Lalai,,0,0,0,,Berapa banyak yang dia dengar?
Dialog: 0,0:43:02.23,0:43:05.10,Lalai,,0,0,0,,Hanya ingin tahu bagaimana hari anda.
Dialog: 0,0:43:05.24,0:43:07.87,Lalai,,0,0,0,,Saya akan pergi selepas kita bercakap sedikit.
Dialog: 0,0:43:11.78,0:43:15.25,Lalai,,0,0,0,,Nah, sepupu saya datang berjumpa saya.
Dialog: 0,0:43:16.48,0:43:17.78,Lalai,,0,0,0,,Sepupu?
Dialog: 0,0:43:17.78,0:43:20.28,Lalai,,0,0,0,,Kim Byonin, kalau tak silap?
Dialog: 0,0:43:20.35,0:43:21.62, Lalai,,0,0,0,,Apa yang dia perlukan?
Dialog: 0,0:43:21.62,0:43:25.56, Lalai,,0,0,0,,Mengapa saya rasa seperti disoal siasat?
Dialog: 0,0:43:25.69,0:43:27.39,Lalai,,0,0,0,,Anda terlalu mudah dipengaruhi.
Dialog: 0,0:43:27.53,0:43:30.19,Lalai,,0,0,0,,Saya cuma risaukan saudara mara saya
Dialog: 0,0:43:30.19,0:43:31.83, Lalai,,0,0,0,,sesuatu telah berlaku.
Dialog: 0,0:43:31.83,0:43:33.13, Lalai,,0,0,0,,No.
Dialog: 0,0:43:33.13,0:43:35.17,Lalai,,0,0,0,,Baru datang untuk bertanya khabar dan mengucapkan tahniah.
Dialog: 0,0:43:35.17,0:43:37.60, Lalai,,0,0,0,,Jika ya, maka saya tidak perlu risau tentang mereka.
Dialog: 0,0:43:38.04,0:43:42.14,Lalai,,0,0,0,,Boleh saya tanya, kenapa awak layan saya begini hari ini?
Dialog: 0,0:43:43.14,0:43:46.61,Lalai,,0,0,0,,Dia benci saya kerana dia tahu saya seorang pembunuh?
Dialog: 0,0:43:47.15,0:43:49.05,Lalai,,0,0,0,,Kami kini suami isteri.
Dialog: 0,0:43:49.05,0:43:50.78,Lalai,,0,0,0,,Walaupun anda suka gila,
Dialog: 0,0:43:50.78,0:43:52.85,Lalai,,0,0,0,,selepas perkahwinan, percintaan hilang.
Dialog: 0,0:43:53.32,0:43:56.09, Lalai,,0,0,0,, Puas hati? awak boleh pergi.
Dialog: 0,0:43:56.92,0:44:00.83, Lalai,,0,0,0,,Dengar saya. Bawa linen katil.
Dialog: 0,0:44:00.89,0:44:03.70, Lalai,,0,0,0,,Apa yang kamu lakukan? Kami tidak bersetuju dengan cara itu.
Dialog: 0,0:44:03.70,0:44:06.30, Lalai,,0,0,0,,Perbualan telah meletihkan saya,
Dialog: 0,0:44:06.30,0:44:09.03, Lalai,,0,0,0,,tiada kekuatan untuk kembali ke Hijeongjon.
Dialog: 0,0:44:12.97,0:44:16.31, Lalai,,0,0,0,,Kemenangan pada siang hari, persediaan pada waktu malam.
Dialog: 0,0:44:23.11,0:44:25.48, Lalai,,0,0,0,,Dia agak mencurigakan.
Dialog: 0,0:44:26.82,0:44:28.89, Lalai,,0,0,0,,Entah bagaimana dia curiga.
Dialog: 0,0:44:33.59,0:44:34.99,Lalai,,0,0,0,,Yang Mulia,
Dialog: 0,0:44:35.16,0:44:37.80, Lalai,,0,0,0,,anda tidak sepatutnya mempercayai sesiapa.
Dialog: 0,0:44:37.83,0:44:41.23,Lalai,,0,0,0,,Ya, dia pasti tidak mempunyai kepercayaan.
Dialog: 0,0:44:41.23,0:44:43.00, Lalai,,0,0,0,,Tidak kira di mana atau bila,
Dialog: 0,0:44:43.00,0:44:46.37,Lalai,,0,0,0,,dan suami adalah orang pertama yang disyaki membunuh isterinya.
Dialog: 0,0:44:52.68,0:44:55.71, Lalai,,0,0,0,,Mungkin dia akan memberitahu anda sesuatu dalam tidurnya.
Dialog: 0,0:44:55.88,0:44:58.18, Lalai,,0,0,0,,Bagaimana jika dia ada sesuatu dan sedang menunggu saya tertidur?
Dialog: 0,0:44:58.45,0:45:00.08, Lalai,,0,0,0,,-Saya tidak boleh tidur.\N-Saya tidak boleh tidur.
Dialog: 0,0:46:01.15,0:46:02.55, Lalai,,0,0,0,,No.
Dialog: 0,0:46:03.08,0:46:06.08, Lalai,,0,0,0,,Tidak! Tidak, jangan!
Dialog: 0,0:46:09.32,0:46:12.19, Lalai,,0,0,0,,Tidak, jangan!
Dialog: 0,0:46:12.26,0:46:13.46, Lalai,,0,0,0,,No.
Dialog: 0,0:46:13.46,0:46:16.29, Lalai,,0,0,0,,Hei. Apa masalah awak?
Dialog: 0,0:46:16.29,0:46:18.23,Lalai,,0,0,0,,Tuhan. Dia mungkin mati seperti itu.
Dialog: 0,0:46:18.23,0:46:22.10, Lalai,,0,0,0,,Hei. bangun! Bangun, ayuh!
Dialog: 0,0:46:31.74,0:46:33.34,Lalai,,0,0,0,,Hwajin.
Dialog: 0,0:46:33.88,0:46:36.38,Lalai,,0,0,0,,Anda menyelamatkan nyawa saya lagi.
Dialog: 0,0:46:36.38,0:46:38.02, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:46:38.02,0:46:41.09,Lalai,,0,0,0,,Adakah anda gila?
Dialog: 0,0:46:41.09,0:46:42.49,Lalai,,0,0,0,,Tuhan.
Dialog: 0,0:46:43.69,0:46:45.16,Lalai,,0,0,0,,Hwajin.
Dialog: 0,0:46:48.49,0:46:51.16,Lalai,,0,0,0,,-Permaisuriku.\N-Sial.
Dialog: 0,0:46:51.36,0:46:54.63,Lalai,,0,0,0,,Adakah anda benar-benar fikir saya akan mati jika anda memukul saya seperti itu?
Dialog: 0,0:46:54.93,0:46:56.93,Lalai,,0,0,0,,Anda akan mati jika saya tidak membangunkan awak.
Dialog: 0,0:46:56.93,0:46:59.64, Lalai,,0,0,0,, Bergoyang-goyang seperti cacing.
Dialogue: 0,0:47:00.30,0:47:04.04,Default,,0,0,0,,Awak pukul saya sebab saya sebut nama perempuan lain.
Dialog: 0,0:47:04.04,0:47:06.31, Lalai,,0,0,0,,Tidak perlu risau.
Dialog: 0,0:47:07.61,0:47:09.85, Lalai,,0,0,0,,Saya tidak kisah siapa yang anda hubungi.
Dialog: 0,0:47:09.85,0:47:12.82,Lalai,,0,0,0,,Mari kita jaga jarak.
Dialog: 0,0:47:15.05,0:47:16.79, Lalai,,0,0,0,,Anda mengatakannya sekali lagi.
Dialog: 0,0:47:16.95,0:47:18.22,Lalai,,0,0,0,,Sejak anda bangun,
Dialog: 0,0:47:18.22,0:47:20.46,Lalai,,0,0,0,,lebih baik anda kembali ke tempat anda
Dialog: 0,0:47:20.46,0:47:22.63, Lalai,,0,0,0,,dan tidur sebentar.
Dialog: 0,0:47:24.20,0:47:28.87,Lalai,,0,0,0,,Jika saya pergi sekarang, saya perlu bangunkan hamba-hamba saya. \NIni tidak bagus.
Dialog: 0,0:47:31.77,0:47:34.11,Lalai,,0,0,0,,Betapa murah hati kita.
Dialog: 0,0:47:34.24,0:47:37.41, Lalai,,0,0,0,,Oh, permaisuriku, terima kasih atas pujian itu.
Dialog: 0,0:47:42.55,0:47:44.55,Lalai,,0,0,0,,Tuhan, permaisuriku.
Dialog: 0,0:47:44.55,0:47:47.15,Lalai,,0,0,0,,Anda sangat mementingkan diri sendiri.
Dialog: 0,0:47:53.09,0:47:55.56,Lalai,,0,0,0,,Ya, anda seorang wanita kuat.
Dialog: 0,0:47:55.56,0:47:57.43,Lalai,,0,0,0,,Baru sahaja dan tidur.
Dialog: 0,0:47:58.70,0:48:02.20,Lalai,,0,0,0,,Raja yang penyayang mesti boleh berkongsi.
Dialog: 0,0:48:22.59,0:48:27.49,Lalai,,0,0,0,,Setiap kali saya tidur di Daejeon, seluruh badan saya sakit.
Dialog: 0,0:48:28.73,0:48:31.33,Lalai,,0,0,0,,Jadi kita tidak sepatutnya tidur bersama lagi.
Dialog: 0,0:48:31.33,0:48:33.63,Default,,0,0,0,,Mestilah sebab aku tak biasa dengan tempat ni.
Dialog: 0,0:48:33.63,0:48:37.30,Lalai,,0,0,0,,Saya perlu kekal lebih kerap sehingga saya terbiasa dengannya.
Dialog: 0,0:48:38.57,0:48:41.74,Lalai,,0,0,0,,Saya tidak mahu bangun lagi kerana mimpi buruk awak.
Dialog: 0,0:48:42.31,0:48:44.11, Lalai,,0,0,0,,Saya tidak ingat sebarang mimpi ngeri,
Dialog: 0,0:48:44.11,0:48:46.31,Lalai,,0,0,0,,dan inilah cara mereka memukul saya kerana menyebut nama orang lain,
Dialog: 0,0:48:46.31,0:48:48.28, Lalai,,0,0,0,,Saya tidak boleh lupa.
Dialog: 0,0:48:49.31,0:48:53.08, Lalai,,0,0,0,,Lain kali saya akan sebut nama awak.
Dialog: 0,0:48:53.08,0:48:55.49,Lalai,,0,0,0,,Saya akan mulakan petang ini.
Dialog: 0,0:48:58.39,0:49:00.89,Lalai,,0,0,0,,Tuhan, saya pun hilang selera.
Dialog: 0,0:49:01.03,0:49:04.09,Lalai,,0,0,0,,Jika anda sudah makan, anda boleh pergi. Saya ada perkara yang perlu dilakukan.
Dialog: 0,0:49:04.40,0:49:06.80, Lalai,,0,0,0,,Apa yang awak sibuk sangat?
Dialog: 0,0:49:08.30,0:49:09.73,Lalai,,0,0,0,,Kerja.
Dialog: 0,0:49:09.80,0:49:12.40, Lalai,,0,0,0,, Memandangkan saya tidak boleh menggunakan telefon dan rangkaian sosial saya,
Dialog: 0,0:49:12.40,0:49:14.81,Lalai,,0,0,0,,maka saya tiada pilihan selain bekerja.
Dialog: 0,0:49:16.11,0:49:17.98, Lalai,,0,0,0,,Rangkaian sosial?
Dialog: 0,0:49:17.98,0:49:19.84, Lalai,,0,0,0,,Rangkaian sosial.
Dialog: 0,0:49:21.31,0:49:25.45, Lalai,,0,0,0,,Saya faham. Cinta harus lembut.
Dialog: 0,0:49:26.88,0:49:29.72,Lalai,,0,0,0,,Malam ini saya akan menjadi kelembutan itu sendiri.
Dialog: 0,0:49:42.97,0:49:45.50, Lalai,,0,0,0,, Pukulan terus!
Dialog: 0,0:49:46.64,0:49:49.21,Lalai,,0,0,0,,Hebat!
Dialog: 0,0:49:49.21,0:49:51.54, Lalai,,0,0,0,,Di manakah anda belajar ini?
Dialog: 0,0:49:51.61,0:49:53.34,Lalai,,0,0,0,,Anda mengelirukan saya.
Dialog: 0,0:49:53.95,0:49:57.68, Lalai,,0,0,0,, Patutkah saya tunjukkan apa yang saya mampu?
Dialog: 0,0:49:57.68,0:49:59.18, Lalai,,0,0,0,,Jadi.
Dialog: 0,0:50:10.06,0:50:11.53, Lalai,,0,0,0,,Nah, nah...
Dialog: 0,0:50:12.23,0:50:13.90, Lalai,,0,0,0,,Semuanya mula berputar dan berputar,
Dialog: 0,0:50:13.90,0:50:16.23, Lalai,,0,0,0,,secara umum, saya menghabiskan beberapa malam bersama raja.
Dialog: 0,0:50:16.40,0:50:18.74, Lalai,,0,0,0,,Tetapi kami tidak tidur dengannya.
Dialog: 0,0:50:21.24,0:50:23.01, Lalai,,0,0,0,,Kami hanya berpura-pura.
Dialog: 0,0:50:23.21,0:50:25.71, Lalai,,0,0,0,,Anda tahu, dia biasanya pergi ke biliknya.
Dialog: 0,0:50:26.78,0:50:28.61, Lalai,,0,0,0,,Tetapi semalam ia seolah-olah telah diganti:
Dialog: 0,0:50:28.61,0:50:30.58, Lalai,,0,0,0,,dia enggan pergi ke tempatnya.
Dialog: 0,0:50:30.65,0:50:32.48, Lalai,,0,0,0,,Tetapi jangan risau.
Dialog: 0,0:50:32.48,0:50:34.99,Lalai,,0,0,0,,Tiada apa-apa pada waktu malam dan tiada apa-apa pada masa hadapan.
Dialog: 0,0:50:34.99,0:50:39.72,Lalai,,0,0,0,,Awak minta jumpa untuk beritahu saya perkara ini?
Dialog: 0,0:50:39.79,0:50:41.29, Lalai,,0,0,0,,Tidak, tidak juga.
Dialog: 0,0:50:41.29,0:50:44.00, Lalai,,0,0,0,,Adakah benar dia menolak saya ke dalam tasik?
Dialog: 0,0:50:44.00,0:50:45.60, Lalai,,0,0,0,,Dan kemudian juga?
Dialog: 0,0:50:46.16,0:50:49.70, Lalai,,0,0,0,,Kemudian ia patut diperlahankan selama beberapa hari.
Dialog: 0,0:50:50.47,0:50:53.87,Lalai,,0,0,0,,Sangat sukar apabila seorang gadis cantik membenci anda.
Dialog: 0,0:50:54.31,0:50:56.41, Lalai,,0,0,0,,Kalaulah awak tak benci saya.
Dialog: 0,0:50:58.48,0:51:01.95,Lalai,,0,0,0,,Nampaknya angin tidak memihak kepada anda kali ini.
Dialog: 0,0:51:02.41,0:51:05.48, Lalai,,0,0,0,,Jika anda mempercayai saya dan tunggu beberapa hari...
Dialog: 0,0:51:06.42,0:51:10.39, Lalai,,0,0,0,,Adakah anda tahu siapa yang saya tidak patut percaya di istana?
Dialog: 0,0:51:11.79,0:51:14.59,Lalai,,0,0,0,,Kepada tuanku. Oleh itu
Dialog: 0,0:51:14.76,0:51:17.90,Lalai,,0,0,0,,Saya tidak percaya apa-apa yang anda katakan.
Dialog: 0,0:51:19.03,0:51:23.23,Lalai,,0,0,0,,Dan jangan cuba menyekat antara Baginda dan saya lagi,
Dialog: 0,0:51:23.23,0:51:24.87, Lalai,,0,0,0,,lebih baik menyerah.
Dialog: 0,0:51:24.87,0:51:27.64, Lalai,,0,0,0,,Saya mula hidup dari awal.
Dialog: 0,0:51:27.71,0:51:29.71, Lalai,,0,0,0,,Nampak tak saya dah berubah?
Dialog: 0,0:51:30.21,0:51:32.01, Lalai,,0,0,0,,Anda telah berubah menjadi lebih teruk.
Dialog: 0,0:51:32.01,0:51:34.35, Lalai,,0,0,0,,Awak senyum di muka saya,
Dialog: 0,0:51:34.55,0:51:37.35, Lalai,,0,0,0,,tetapi di belakang saya menyalahkan saya atas apa yang berlaku di tasik.
Dialog: 0,0:51:37.68,0:51:40.55,Lalai,,0,0,0,,Saya tidak pernah menyalahkan awak dalam hal ini.
Dialog: 0,0:51:40.55,0:51:41.82, Lalai,,0,0,0,,Kami tidak tahu siapa itu,
Dialog: 0,0:51:41.82,0:51:44.12,Lalai,,0,0,0,,anda disyaki kerana anda berada di sana.
Dialog: 0,0:51:44.12,0:51:47.66, Lalai,,0,0,0,,Anda tahu siapa itu.
Dialog: 0,0:51:52.93,0:51:54.53,Lalai,,0,0,0,,Orang yang melakukan ini ialah
Dialog: 0,0:51:55.57,0:51:57.80,Lalai,,0,0,0,,ini tuanku.
Dialog: 0,0:52:04.11,0:52:06.64, Lalai,,0,0,0,, Anda sengaja jatuh ke dalam air,
Dialog: 0,0:52:06.98,0:52:09.35, Lalai,,0,0,0,,untuk menyediakan saya.
Dialog: 0,0:52:17.79,0:52:20.82, Lalai,,0,0,0,,Berdasarkan kemarahannya, dia tidak berbohong.
Dialog: 0,0:52:21.63,0:52:24.43, Lalai,,0,0,0,,Sekarang saya tahu kenapa dia memandang saya dengan sangat dingin.
Dialog: 0,0:52:25.16,0:52:29.17,Lalai,,0,0,0,,Insiden di tasik itu adalah rekaan. Yang tinggal ialah pembunuhnya.
Dialog: 0,0:52:30.10,0:52:34.10, Lalai,,0,0,0,,Fakta bahawa seseorang mengikuti saya tidak berubah.
Dialog: 0,0:52:35.37,0:52:39.21,Lalai,,0,0,0,,Yang Mulia, Tuanku perlu kembali ke Dewan Daejojeon.
Dialog: 0,0:52:39.74,0:52:42.08,Lalai,,0,0,0,,Court Lady Choi, \Ngo dahulu ke Daejojong.
Dialog: 0,0:52:45.02,0:52:47.22,Lalai,,0,0,0,,Jika sesuatu berlaku, fikirkan sesuatu
Dialog: 0,0:52:47.22,0:52:48.92, Lalai,,0,0,0,, dan hantar Hongyeon selepas saya.
Dialog: 0,0:52:48.92,0:52:49.99, Lalai,,0,0,0,,Saya tidak berani...
Dialog: 0,0:52:49.99,0:52:51.89, Lalai,,0,0,0,,Ini adalah satu-satunya cara anda boleh membantu saya.
Dialog: 0,0:52:52.29,0:52:53.72, Lalai,,0,0,0,,Sila.
Dialog: 0,0:52:56.09,0:52:58.06, Lalai,,0,0,0,,Hei, di sini.
Dialog: 0,0:53:00.10,0:53:01.27, Lalai,,0,0,0,, Chef Diraja.
Dialog: 0,0:53:01.27,0:53:03.77, Lalai,,0,0,0,,Berapa kerapkah anda berkhidmat kepada Ratu Janda?
Dialog: 0,0:53:03.77,0:53:05.84, Lalai,,0,0,0,,Saya tidak boleh mengatakan dengan pasti,
Dialog: 0,0:53:05.84,0:53:07.84, Lalai,,0,0,0,,tetapi pasti beberapa kali sehari.
Dialog: 0,0:53:15.58,0:53:18.15, Lalai,,0,0,0,,Saya tidak bermaksud untuk mengatakan itu,
Dialog: 0,0:53:18.15,0:53:21.49,Lalai,,0,0,0,,tetapi di Joseon terdapat ramai yang boleh \Nmenjadi chef diraja.
Dialog: 0,0:53:26.62,0:53:28.13, Lalai,,0,0,0,,Saya bersarapan, makan tengah hari, snek petang,
Dialog: 0,0:53:28.13,0:53:29.33, Lalai,,0,0,0,,makanan ringan, makan malam
Dialog: 0,0:53:29.33,0:53:32.20, Lalai,,0,0,0,,dan snek malam.
Dialog: 0,0:53:32.26,0:53:33.46, Lalai,,0,0,0,,Dan dia makan semuanya?
Dialog: 0,0:53:33.46,0:53:35.47,Lalai,,0,0,0,,Sekali setiap 3-4 hari
Dialog: 0,0:53:35.60,0:53:38.04, Lalai,,0,0,0,,dia menolak makan tengah hari.
Dialog: 0,0:53:38.04,0:53:42.51, Lalai,,0,0,0,,Pada hari itu dia meminta madu dan serbuk halia.
Dialog: 0,0:53:49.15,0:53:50.71, Lalai,,0,0,0,,Dia tidak makan
Dialog: 0,0:53:50.71,0:53:53.62, Lalai,,0,0,0,,sejuk dan sesuatu untuk dikunyah.
Dialog: 0,0:53:53.62,0:53:55.59, Lalai,,0,0,0,,Dia tidak meminta untuk menukar menu,
Dialog: 0,0:53:55.59,0:53:57.52,Lalai,,0,0,0,,yang bermaksud dia mahu menyembunyikannya.
Dialog: 0,0:53:59.46,0:54:03.09,Lalai,,0,0,0,,Saya lebih melihat wajah mereka daripada kemahiran mereka.
Dialog: 0,0:54:03.66,0:54:05.96,Lalai,,0,0,0,,Bukankah mereka semua kacak?
Dialog: 0,0:54:06.76,0:54:08.20, Lalai,,0,0,0,,-Bam.\N-Bam.
Dialog: 0,0:54:08.33,0:54:09.80, Lalai,,0,0,0,,Hey!
Dialog: 0,0:54:09.93,0:54:12.10,Lalai,,0,0,0,,Adakah anda rasa bunyi tembakan begitu senyap?
Dialog: 0,0:54:12.10,0:54:15.27, Lalai,,0,0,0,, Perlu lebih kuat. "Bam"!
Dialog: 0,0:54:15.27,0:54:17.37, Lalai,,0,0,0,,-Bam.\N-Bam.
Dialog: 0,0:54:17.37,0:54:19.91,Lalai,,0,0,0,,Menteri Perang yang dikasihi kami, tengkolok anda serong.
Dialog: 0,0:54:19.91,0:54:23.01, Lalai,,0,0,0,,Apa yang anda benarkan?
Dialog: 0,0:54:23.58,0:54:27.15,Lalai,,0,0,0,,By the way, saya dengar awak minta raja tukar awak
Dialog: 0,0:54:27.15,0:54:28.75, Lalai,,0,0,0,,ke Pejabat Pengawal Diraja.
Dialog: 0,0:54:28.75,0:54:31.92,Lalai,,0,0,0,,Pengurusan pengawal diraja bukan tentera,
Dialog: 0,0:54:31.92,0:54:33.66, Lalai,,0,0,0,,anda boleh main-main di sana.
Dialog: 0,0:54:33.66,0:54:35.16,Lalai,,0,0,0,,Khabar angin sebegitu sedang beredar,
Dialog: 0,0:54:35.16,0:54:37.36, Lalai,,0,0,0,, dan saya fikir: inilah yang saya perlukan.
Dialog: 0,0:54:37.36,0:54:40.46, Lalai,,0,0,0,,Saya tidak suka membebankan diri.
Dialog: 0,0:54:53.64,0:54:55.91, Lalai,,0,0,0,,-Bila?\N-Malam ini.
Dialog: 0,0:54:55.91,0:54:57.35, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:55:05.09,0:55:07.66, Lalai,,0,0,0,,Ini serbuk agaric terbang.
Dialog: 0,0:55:07.66,0:55:09.59, Lalai,,0,0,0,,Tidak berbau dan tawar.
Dialog: 0,0:55:09.59,0:55:12.96, Lalai,,0,0,0,,Campur dengan alkohol dan dedahkan semua rahsia.
Dialog: 0,0:55:13.50,0:55:16.70,Lalai,,0,0,0,,Tetapi jika permaisuri tahu sesuatu,
Dialog: 0,0:55:16.70,0:55:18.57, Lalai,,0,0,0,,dia tidak akan duduk diam.
Dialog: 0,0:55:18.60,0:55:20.84, Lalai,,0,0,0,,Dia sama ada mahu sesuatu,
Dialog: 0,0:55:20.94,0:55:23.11, Lalai,,0,0,0,, atau menunggu masa yang sesuai.
Dialog: 0,0:55:23.47,0:55:25.31,Lalai,,0,0,0,,Perlu dipastikan.
Dialog: 0,0:55:34.42,0:55:37.22,Lalai,,0,0,0,,Putera Yeonpyeong tidak mempunyai cita-cita yang mencukupi.
Dialog: 0,0:55:37.22,0:55:39.92,Lalai,,0,0,0,,Dia berpegang teguh pada Baginda
Dialog: 0,0:55:39.92,0:55:42.86, Lalai,,0,0,0,,dan berkeliaran dengan Hong Byulgam
Dialog: 0,0:55:44.13,0:55:46.00, Lalai,,0,0,0,,pada waktu malam.
Dialog: 0,0:55:49.30,0:55:51.67, Lalai,,0,0,0,,Hon Byulgam
Dialog: 0,0:55:52.00,0:55:55.14,Lalai,,0,0,0,,masih pemalas yang sama,\N mengabaikan tanggungjawabnya.
Dialog: 0,0:55:55.81,0:55:58.08, Lalai,,0,0,0,,Pejabat Pengawal Diraja hanyalah nama.
Dialog: 0,0:55:58.08,0:55:59.98, Lalai,,0,0,0,,Lebih baik biarkan dia duduk di sana.
Dialog: 0,0:56:00.78,0:56:02.55, Lalai,,0,0,0,,Dia bukan sahaja kehilangan bapa dan abangnya,
Dialog: 0,0:56:02.55,0:56:05.45, Lalai,,0,0,0,, tetapi juga ibu dan datuk dan neneknya di hadapan matanya.
Dialog: 0,0:56:05.78,0:56:07.99, Lalai,,0,0,0,,Ini memberinya pengajaran.
Dialog: 0,0:56:08.15,0:56:13.16,Default,,0,0,0,,By the way, bila awak akan dilantik sebagai ketua pengawal diraja?
Dialog: 0,0:56:13.89,0:56:15.29,Lalai,,0,0,0,,Ada masalah?
Dialog: 0,0:56:15.29,0:56:18.93, Lalai,,0,0,0,,Saya hanya mahu menyelesaikan semuanya sebelum ia ditetapkan.
Dialog: 0,0:56:22.57,0:56:25.70,Lalai,,0,0,0,,Adakah anda mendapat keuntungan daripada pertukaran maklumat tentera sekali lagi?
Dialog: 0,0:56:27.00,0:56:28.91, Lalai,,0,0,0,,Jangan melepasi garisan.
Dialog: 0,0:56:29.11,0:56:31.14,Lalai,,0,0,0,,Berapa kali saya sudah beritahu anda,
Dialog: 0,0:56:31.14,0:56:33.14, Lalai,,0,0,0,, bahawa tentera yang tidak stabil adalah sangat berbahaya?
Dialog: 0,0:56:33.74,0:56:35.21,Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:56:35.88,0:56:37.68,Lalai,,0,0,0,,Saya akan uruskan semuanya.
Dialog: 0,0:56:40.15,0:56:41.79,Lalai,,0,0,0,,Tidak kira berapa banyak yang saya fikirkan,
Dialog: 0,0:56:42.35,0:56:45.56,Lalai,,0,0,0,,tetapi saya rasa sesuatu yang berbahaya sedang berlaku di luar istana.
Dialog: 0,0:56:45.56,0:56:46.92, Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:56:46.92,0:56:50.33, Lalai,,0,0,0,,Dalam perjalanan ke Oktajeong beberapa hari yang lalu...
Dialog: 0,0:56:50.46,0:56:52.73, Lalai,,0,0,0,,Adakah anda berkata Okthajeong?
Dialog: 0,0:56:52.73,0:56:56.00, Lalai,,0,0,0,,Ya. Saya berkawan dengan seorang lelaki
Dialog: 0,0:56:56.00,0:56:59.80, Lalai,,0,0,0,,dengan nama indah Lee Sanman.
Dialog: 0,0:57:00.30,0:57:01.97, Lalai,,0,0,0,, Lee Senman.
Dialog: 0,0:57:02.17,0:57:03.97,Lalai,,0,0,0,,Awak kenal dia?
Dialog: 0,0:57:04.51,0:57:07.81, Lalai,,0,0,0,,No. Tetapi nama itu seperti biasa.
Dialog: 0,0:57:07.81,0:57:10.21, Lalai,,0,0,0,,Dia mungkin dari keluarga bangsawan yang terkenal.
Dialog: 0,0:57:10.21,0:57:12.05, Lalai,,0,0,0,,Tetapi saya tidak pernah mendengar namanya.
Dialog: 0,0:57:12.92,0:57:16.55,Lalai,,0,0,0,,Jadi, apabila kami pergi ke Okthajeong bersamanya,
Dialog: 0,0:57:16.55,0:57:19.52,Lalai,,0,0,0,,tanpa disangka seseorang memukul saya,
Dialog: 0,0:57:19.52,0:57:21.43, Lalai,,0,0,0,, dan saya tidak sedarkan diri.
Dialog: 0,0:57:22.33,0:57:23.93, Lalai,,0,0,0,,Apabila saya bangun,
Dialog: 0,0:57:23.93,0:57:29.43,Lalai,,0,0,0,,menyedari bahawa Lee Senman telah hilang seperti hantu.
Dialog: 0,0:57:29.47,0:57:31.94, Lalai,,0,0,0,,Ingat bagaimana dia berpakaian?
Dialog: 0,0:57:31.94,0:57:34.17, Lalai,,0,0,0,,-Sudah tentu.\N-Di atasnya
Dialog: 0,0:57:36.04,0:57:38.88, Lalai,,0,0,0,,adakah pakaian diperbuat daripada kain sedemikian?
Dialog: 0,0:57:45.02,0:57:46.45,Lalai,,0,0,0,,No.
Dialog: 0,0:57:50.09,0:57:51.52, Lalai,,0,0,0,, Faham.
Dialog: 0,0:57:51.59,0:57:54.46, Lalai,,0,0,0,,Jika anda melihat rakan anda lagi,
Dialog: 0,0:57:54.46,0:57:56.96, Lalai,,0,0,0,,ketahui apa yang berlaku kemudian.
Dialog: 0,0:57:57.23,0:57:58.90,Lalai,,0,0,0,,Adakah ini bermakna,
Dialog: 0,0:57:59.90,0:58:03.23, Lalai,,0,0,0,,apa yang awak berikan saya tugasan istimewa?
Dialog: 0,0:58:03.23,0:58:05.50, Lalai,,0,0,0,,Saya tidak akan memanggil ini sebagai tugas khas.
Dialog: 0,0:58:07.94,0:58:09.41, Lalai,,0,0,0,,By the way.
Dialog: 0,0:58:09.74,0:58:13.18, Lalai,,0,0,0,,Anda datang ke istana setiap hari, tetapi tidak melakukan apa-apa.
Dialog: 0,0:58:13.18,0:58:15.28, Lalai,,0,0,0,,Apa maksud anda saya tidak melakukan apa-apa?
Dialog: 0,0:58:15.28,0:58:17.21, Lalai,,0,0,0,,Dan sehari suntuk tidak mencukupi,
Dialog: 0,0:58:17.21,0:58:19.12,Lalai,,0,0,0,,hanya untuk menyambut semua orang.
Dialog: 0,0:58:22.55,0:58:25.16, Lalai,,0,0,0,,Tugas ini sesuai untuk anda.
Dialog: 0,0:58:25.52,0:58:27.42, Lalai,,0,0,0,,Tugas khas ini.
Dialog: 0,0:58:27.86,0:58:29.63, Lalai,,0,0,0,,Akhirnya.
Dialog: 0,0:58:47.51,0:58:51.31, Lalai,,0,0,0,,(Jarak sosial)
Dialog: 0,0:58:54.89,0:58:57.32,Lalai,,0,0,0,,(Jarak sosial)
Dialog: 0,0:59:00.66,0:59:02.09, Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:59:02.09,0:59:04.29,Lalai,,0,0,0,,Putera Yeonpyeong telah tiba.
Dialog: 0,0:59:04.29,0:59:05.70, Lalai,,0,0,0,,Ya.
Dialog: 0,0:59:10.23,0:59:13.64, Lalai,,0,0,0,,Adakah anda tahu maksudnya?
Dialog: 0,0:59:13.94,0:59:15.37, Lalai,,0,0,0,,Maafkan saya?
Dialog: 0,0:59:15.94,0:59:17.81, Lalai,,0,0,0,, Datang dan lihat.
Dialog: 0,0:59:22.21,0:59:23.55, Lalai,,0,0,0,,Jarak sosial?
Dialog: 0,0:59:23.55,0:59:27.28, Lalai,,0,0,0,,Menurut permaisuri, ini bermaksud "Kami akan hidup bahagia."
Dialog: 0,0:59:27.28,0:59:29.95, Lalai,,0,0,0,,Tetapi dari manakah perkataan itu datang?
Dialog: 0,0:59:32.69,0:59:34.89, Lalai,,0,0,0,,Tidak pernah dengar.
Dialog: 0,0:59:36.93,0:59:39.83, Lalai,,0,0,0,,Atau mungkin dari kitab suci Buddha?
Dialog: 0,0:59:49.34,0:59:52.28, Lalai,,0,0,0,,Saya akan minum teh dengan abang saya.
Dialog: 0,0:59:52.61,0:59:54.95,Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,1:00:04.42,1:00:06.66,Lalai,,0,0,0,,Saya terus memikirkan apa yang permaisuri katakan,
Dialog: 0,1:00:06.66,1:00:10.26,Lalai,,0,0,0,,kerana beberapa perkataan indahnya\N mungkin mempunyai makna tertentu.
Dialog: 0,1:00:10.36,1:00:11.86,Lalai,,0,0,0,,Ya.
Dialog: 0,1:00:14.70,1:00:16.40,Lalai,,0,0,0,,Ini yang anda minta.
Dialog: 0,1:00:17.94,1:00:19.64,Lalai,,0,0,0,,Bagus.
Dialog: 0,1:00:21.57,1:00:23.17,Lalai,,0,0,0,,Adakah ini berlaku hari ini?
Dialog: 0,1:00:23.27,1:00:25.31,Lalai,,0,0,0,,Lebih pantas lebih baik.
Dialog: 0,1:00:27.51,1:00:28.98,Lalai,,0,0,0,,Betul.
Dialog: 0,1:00:30.08,1:00:32.05,Lalai,,0,0,0,,Beri saya lebih banyak tanah liat.
Dialog: 0,1:00:32.85,1:00:34.25,Lalai,,0,0,0,,Ya.
Dialog: 0,1:00:37.32,1:00:39.56,Lalai,,0,0,0,,Ini pesanan anda,
Dialog: 0,1:00:39.56,1:00:41.39,Lalai,,0,0,0,,tetapi jika anda merosakkan ketuhar...
Dialog: 0,1:00:41.39,1:00:44.16,Lalai,,0,0,0,,Biar saya tidak merosakkannya. Ini adalah peningkatan.
Dialog: 0,1:00:44.83,1:00:46.90,Lalai,,0,0,0,,Wanita gila.
Dialog: 0,1:00:54.37,1:00:58.31,Lalai,,0,0,0,,Hei, orang gila, apakah batu-batu kecil ini!
Dialog: 0,1:00:59.01,1:01:00.61,Lalai,,0,0,0,,Apa? Sukar?
Dialog: 0,1:01:00.91,1:01:03.28,Lalai,,0,0,0,,Biar saya bantu. Yang ini sempurna.
Dialog: 0,1:01:03.28,1:01:04.38,Lalai,,0,0,0,,Terlalu besar.
Dialog: 0,1:01:04.38,1:01:06.02,Lalai,,0,0,0,,Mengapa anda meletakkan ini?
Dialog: 0,1:01:06.02,1:01:08.45,Lalai,,0,0,0,,-Yang Mulia!\N-Minyak, atau apa?
Dialog: 0,1:01:08.45,1:01:11.52,Lalai,,0,0,0,,Ya. Seperti yang anda pesan, saya membawa semua jenis - biji sesawi, bijan, bahaya
Dialog: 0,1:01:11.52,1:01:13.49,Lalai,,0,0,0,,dan secara amnya semua yang saya temui.
Dialog: 0,1:01:13.49,1:01:15.46,Lalai,,0,0,0,,Syabas.
Dialog: 0,1:01:20.43,1:01:22.23,Lalai,,0,0,0,,Permata sungguh!
Dialog: 0,1:01:22.23,1:01:25.27,Lalai,,0,0,0,,Yang Mulia. Ini adalah bekalan minyak tahunan kami.
Dialog: 0,1:01:25.57,1:01:27.64,Lalai,,0,0,0,,Memasak ialah 80% bahan.
Dialog: 0,1:01:27.64,1:01:29.54,Default,,0,0,0,,Nasib saya bergantung pada makanan ini.
Dialog: 0,1:01:30.64,1:01:31.71,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:01:31.71,1:01:34.81,Lalai,,0,0,0,,Baginda telah lama pergi berehat.
Dialog: 0,1:01:34.81,1:01:36.78,Lalai,,0,0,0,,Beritahu saya, saya ada hutang anak di sini.
Dialog: 0,1:01:36.78,1:01:39.52,Lalai,,0,0,0,,Tidak, tidak. Saya mencurahkan segala-galanya, segala-galanya.
Dialog: 0,1:01:58.20,1:02:01.17,Lalai,,0,0,0,,Bagaimana anda boleh membawa semua hadiah berharga kami kepadanya?
Dialog: 0,1:02:01.17,1:02:04.11,Lalai,,0,0,0,,Ya, saya sudah terbaring di bumi jika saya tidak membawanya.
Dialog: 0,1:02:04.44,1:02:06.71,Lalai,,0,0,0,,Kami mengancam, mereka akan mengheret kami lebih lagi.
Dialog: 0,1:02:06.71,1:02:08.48,Lalai,,0,0,0,,Kenapa awak gegar?
Dialog: 0,1:02:13.95,1:02:16.82,Lalai,,0,0,0,,Tidak berat pun. Apa yang dia akan lakukan?
Dialog: 0,1:02:21.26,1:02:24.86, Lalai,,0,0,0,,Ramuan berharga sedemikian.
Dialog: 0,1:02:30.47,1:02:33.67,Lalai,,0,0,0,,Baiklah, selesai. Hebat.
Dialog: 0,1:02:36.84,1:02:39.21,Lalai,,0,0,0,,Syabas.
Dialog: 0,1:02:39.21,1:02:41.01, Lalai,,0,0,0,,-Ambil ini. \N-Ya.
Dialog: 0,1:02:41.01,1:02:43.18,Lalai,,0,0,0,,-Letakkannya di sana.\N-Apa?
Dialog: 0,1:02:43.18,1:02:45.55,Lalai,,0,0,0,,-Saya katakan, letakkan di sana.\N -Ya, Tuanku.
Dialog: 0,1:02:55.49,1:02:57.13,Lalai,,0,0,0,,Selesai.
Dialog: 0,1:02:57.96,1:03:01.33,Lalai,,0,0,0,,Kuak kualiti tertinggi - \Nand baru sahaja melemparkannya ke dalam api.
Dialog: 0,1:03:01.33,1:03:04.50,Lalai,,0,0,0,,Keanehan macam mana.
Dialog: 0,1:03:22.35,1:03:25.29,Lalai,,0,0,0,,Yang Mulia, saya mohon maaf jika saya melampaui batas,
Dialog: 0,1:03:25.29,1:03:27.96,Lalai,,0,0,0,,tetapi Baginda berada di dapur diraja
Dialog: 0,1:03:27.96,1:03:31.36,Lalai,,0,0,0,,memantau penyediaan makanan untuk ratu janda.
Dialog: 0,1:03:31.83,1:03:35.10,Lalai,,0,0,0,,Saya faham. Saya akan tunggu.
Dialog: 0,1:03:35.40,1:03:37.57,Lalai,,0,0,0,,Maaf.
Dialog: 0,1:03:49.65,1:03:52.25,Lalai,,0,0,0,,Dia mengelak saya.
Dialog: 0,1:04:30.02,1:04:31.22,Lalai,,0,0,0,,Awak okay?
Dialog: 0,1:04:31.22,1:04:33.49,Lalai,,0,0,0,,Sial, saya pengsan atas sebab tertentu.
Dialog: 0,1:04:39.70,1:04:42.20,Lalai,,0,0,0,,Nasib saya bergantung pada awak.
Dialog: 0,1:04:57.78,1:04:59.85,Lalai,,0,0,0,,Ia akan terbakar.
Dialog: 0,1:05:13.23,1:05:14.70,Lalai,,0,0,0,, Beritahu dia.
Dialog: 0,1:05:17.50,1:05:21.47,Lalai,,0,0,0,,Saya beritahu awak saya tidak perlukan sarapan.
Dialog: 0,1:05:22.64,1:05:26.61,Lalai,,0,0,0,,Permaisuri menyediakannya sendiri.
Dialog: 0,1:05:30.48,1:05:33.92,Lalai,,0,0,0,,-Adakah Ratu bersedia?\N-Ya, Tuanku.
Dialog: 0,1:05:34.32,1:05:38.32,Lalai,,0,0,0,,Saya menghabiskan sepanjang malam untuk perkara ini.
Dialog: 0,1:05:38.32,1:05:40.59,Lalai,,0,0,0,,Saya menghargai usaha itu,
Dialog: 0,1:05:43.56,1:05:46.43,Lalai,,0,0,0,,tetapi ia diperbuat daripada apa?
Dialog: 0,1:05:46.43,1:05:48.50,Lalai,,0,0,0,,Nampak berbeza.
Dialog: 0,1:05:48.80,1:05:50.90,Lalai,,0,0,0,,Dia memasak daripada daging lembu, daging babi
Dialog: 0,1:05:50.90,1:05:55.37,Lalai,,0,0,0,,dan croaker - semuanya bersama-sama.
Dialog: 0,1:05:55.74,1:05:59.51,Lalai,,0,0,0,,Lebih seperti sulaman daripada makanan.
Dialog: 0,1:06:01.21,1:06:03.48,Lalai,,0,0,0,,Saya benar-benar tiada selera makan,
Dialog: 0,1:06:03.48,1:06:06.85,Lalai,,0,0,0,,tetapi anda katakan dia menghabiskan sepanjang malam.
Dialog: 0,1:06:06.85,1:06:09.12,Lalai,,0,0,0,,Saya bersyukur, jadi saya akan mencuba sekeping.
Dialog: 0,1:06:36.18,1:06:38.05,Lalai,,0,0,0,,Masih tiada berita?
Dialog: 0,1:06:38.75,1:06:40.25,Lalai,,0,0,0,,Ya.
Dialog: 0,1:06:45.12,1:06:47.19,Lalai,,0,0,0,,Ini tidak akan berfungsi. Saya akan pergi sendiri.
Dialog: 0,1:06:47.19,1:06:50.36,Lalai,,0,0,0,,Permaisuri Janda telah tiba.
Dialog: 0,1:07:05.24,1:07:08.81,Lalai,,0,0,0,,-Kemenangan?\N-Bagaimana anda boleh?
Dialog: 0,1:07:11.48,1:07:12.95,Lalai,,0,0,0,, Fiasco?
Dialog: 0,1:07:15.52,1:07:18.72,Lalai,,0,0,0,,Mengapa anda menyembunyikan bakat sedemikian?
Dialog: 0,1:07:18.89,1:07:20.29,Lalai,,0,0,0,,Apa?
Dialog: 0,1:07:21.49,1:07:25.16,Lalai,,0,0,0,,Saya pun tidak tahu sudah berapa lama saya tidak menikmati makanan sebanyak ini.
Dialog: 0,1:07:25.16,1:07:27.40,Lalai,,0,0,0,,Saya sangat teruja dengan makanan itu,
Dialog: 0,1:07:27.40,1:07:29.63,Lalai,,0,0,0,,bahawa saya benar-benar marah!
Dialog: 0,1:07:30.67,1:07:32.50,Lalai,,0,0,0,,Triumph.
Dialog: 0,1:07:34.17,1:07:37.31,Lalai,,0,0,0,,Saya gembira anda menyukainya.
Dialog: 0,1:07:37.44,1:07:39.81,Lalai,,0,0,0,,Sudah tentu saya menyukainya.
Dialog: 0,1:07:39.81,1:07:42.88,Lalai,,0,0,0,,Nampaknya saya boleh makan ini setiap hari.
Dialog: 0,1:07:43.05,1:07:44.98,Lalai,,0,0,0,,Bagaimana anda menyediakan ini?
Dialog: 0,1:07:44.98,1:07:47.95,Lalai,,0,0,0,,Saya tidak pernah mencuba tekstur yang begitu halus sebelum ini,
Dialog: 0,1:07:47.95,1:07:50.52,Lalai,,0,0,0,,rasa yang kaya.
Dialog: 0,1:07:51.82,1:07:57.70,Lalai,,0,0,0,,Saya masak dalam minyak dengan api yang sangat perlahan sepanjang malam.
Dialog: 0,1:07:59.43,1:08:01.73,Lalai,,0,0,0,,Saya meletakkan ikan dalam minyak di atas arang di dalam ketuhar,
Dialog: 0,1:08:01.73,1:08:03.30,Lalai,,0,0,0,,untuk memasak perlahan sepanjang malam.
Dialog: 0,1:08:03.30,1:08:07.27,Lalai,,0,0,0,,Saya mahu kerak menjadi rangup dan dagingnya empuk.
Dialog: 0,1:08:07.37,1:08:10.61,Lalai,,0,0,0,,Untuk membuat daging mengunyah lebih baik,\N Saya memasukkannya ke dalam kawah dengan minyak
Dialog: 0,1:08:10.61,1:08:13.81, Lalai,,0,0,0,,dan dimasak dengan api perlahan semalaman.
Dialog: 0,1:08:14.88,1:08:18.38,Lalai,,0,0,0,,Kaedah ini mengekalkan kedua-dua nutrien makanan dan baunya.
Dialog: 0,1:08:18.45,1:08:21.85,Lalai,,0,0,0,,Ia juga baik untuk kesihatan dan\Nmembantu menentang penuaan.
Dialog: 0,1:08:21.85,1:08:23.29,Lalai,,0,0,0,,Makanan yang sangat sihat.
Dialog: 0,1:08:23.29,1:08:27.99,Lalai,,0,0,0,,Ini dipanggil confit -\N teknik memasak Perancis.
Dialog: 0,1:08:27.99,1:08:30.96,Lalai,,0,0,0,,Bukan sahaja sedap, malah menyihatkan?
Dialog: 0,1:08:32.56,1:08:35.73,Lalai,,0,0,0,,Di manakah anda mempelajari kaedah ini?
Dialog: 0,1:08:36.70,1:08:38.67,Lalai,,0,0,0,,Mungkin ini cerapan?
Dialog: 0,1:08:38.67,1:08:41.94,Lalai,,0,0,0,,Lagipun, saya sedang memikirkan cara untuk menggembirakan Tuanku,
Dialog: 0,1:08:41.94,1:08:44.74,Lalai,,0,0,0,,begitu banyak hari sudah.
Dialog: 0,1:08:47.38,1:08:50.38,Lalai,,0,0,0,,Betapa tamparan maut.
Dialog: 0,1:08:50.38,1:08:52.55,Lalai,,0,0,0,,Saya akan membantu anda setiap hari.
Dialog: 0,1:08:52.95,1:08:54.52,Lalai,,0,0,0,,Sehingga penghujung hari
Dialog: 0,1:08:54.75,1:08:56.15,Lalai,,0,0,0,,anda akan muda
Dialog: 0,1:08:56.69,1:08:58.59,Lalai,,0,0,0,,dan sihat.
Dialog: 0,1:09:07.03,1:09:11.30,Lalai,,0,0,0,,Saya benarkan tasik diisi dengan air.
Dialog: 0,1:09:31.59,1:09:33.26,Lalai,nanas,0,0,0,,Anda akan mengisinya seperti ini sehingga runtuhnya Joseon.
Dialog: 0,1:09:33.26,1:09:36.09,Lalai,nanas,0,0,0,,Kami memerlukan sepuluh hari, tidak kurang.
Dialog: 0,1:09:36.53,1:09:38.73,Lalai,nanas,0,0,0,,Apa? Supaya dalam satu minit akan ada air
Dialog: 0,1:09:38.73,1:09:41.00,Lalai,nanas,0,0,0,,atau saya akan hentikan kepala awak!
Dialog: 0,1:09:41.03,1:09:44.10,Lalai,nanas,0,0,0,,Lebih pantas, lebih pantas!
Dialog: 0,1:09:48.24,1:09:52.44,Lalai,nanas,0,0,0,,Sekarang kita memerlukan dua hari lagi.
Dialog: 0,1:09:53.18,1:09:54.81,Lalai,nanas,0,0,0,,Berhenti, jangan bergerak!
Dialog: 0,1:09:57.75,1:10:00.35,Lalai,nanas,0,0,0,,Saya datang dengan sesuatu.
Dialog: 0,1:10:00.45,1:10:03.59,Lalai,nanas,0,0,0,,Air yang memberi kehidupan mengalir!
Dialog: 0,1:10:04.29,1:10:06.19,Lalai,nanas,0,0,0,,-Tahan.\N-Terima kasih.
Dialog: 0,1:10:06.19,1:10:08.69,Lalai,nanas,0,0,0,,Air yang memberi kehidupan mengalir!
Dialog: 0,1:10:09.39,1:10:12.43,Lalai,nanas,0,0,0,,Siapa tahu keadaan akan berjalan lebih pantas dengan cara ini?
Dialog: 0,1:10:12.43,1:10:14.80,Lalai,nanas,0,0,0,,Syabas! Begitu sahaja!
Dialog: 0,1:10:15.33,1:10:17.87,Lalai,nanas,0,0,0,,-Ambil dengan cepat.\N-Tahan.
Dialog: 0,1:10:27.21,1:10:30.08,Lalai,nanas,0,0,0,,Ya, saya bukan ratu, tetapi genius pemikiran tempatan.
Dialog: 0,1:10:30.08,1:10:31.75,Lalai,nanas,0,0,0,,Syabas. Rakan-rakan yang hebat.
Dialog: 0,1:10:31.75,1:10:35.05,Lalai,nanas,0,0,0,,Sehingga anda memenuhi tasik, lupakan tidur.
Dialog: 0,1:10:35.05,1:10:36.52,Lalai,nanas,0,0,0,,-Patuhi!\N-Patuh!
Dialog: 0,1:10:55.17,1:10:56.91,Lalai,nanas,0,0,0,,Honyeon, kemudian?
Dialog: 0,1:10:57.51,1:11:00.58,Lalai,nanas,0,0,0,,Jika dia berpura-pura,
Dialog: 0,1:11:00.68,1:11:05.68,Lalai,nanas,0,0,0,,maka ia pasti tidak akan dapat menipu saya.
Dialog: 0,1:11:19.73,1:11:22.10,Lalai,nanas,0,0,0,,Kainnya sangat jarang,
Dialog: 0,1:11:22.10,1:11:26.00, Lalai, nanas,0,0,0,,Saya tidak dapat memberitahu anda di mana ia ditenun.
Dialog: 0,1:11:31.41,1:11:33.51,Lalai,nanas,0,0,0,,Tetapi saya boleh
Dialog: 0,1:11:34.18,1:11:36.88,Lalai,nanas,0,0,0,,cuba ketahui.
Dialog: 0,1:11:37.58,1:11:41.75,Lalai,nanas,0,0,0,,Anda tidak boleh berputus asa tanpa mencuba, bukankah anda bersetuju?
Dialog: 0,1:11:41.75,1:11:43.89,Lalai,nanas,0,0,0,,Saya suka pendekatan anda.
Dialog: 0,1:11:47.66,1:11:51.56,Lalai,nanas,0,0,0,,Saya bimbang raja tidak mempedulikan permaisuri,
Dialog: 0,1:11:51.56,1:11:54.40,Lalai,nanas,0,0,0,,tetapi nampaknya semua kebimbangan saya telah berakhir.
Dialog: 0,1:11:56.30,1:11:58.10,Lalai,nanas,0,0,0,,Apa lagi yang boleh anda beritahu saya?
Dialog: 0,1:11:58.70,1:12:01.87,Lalai,nanas,0,0,0,,Malam tadi, manakala permaisuri
Dialog: 0,1:12:01.87,1:12:04.24,Lalai,nanas,0,0,0,,ada di dapur istana,
Dialog: 0,1:12:04.24,1:12:06.61,Lalai,nanas,0,0,0,,raja sedang menunggunya seorang diri
Dialog: 0,1:12:06.61,1:12:09.88,Lalai,nanas,0,0,0,,di Dewan Daejojeon.
Dialog: 0,1:12:10.05,1:12:14.32,Lalai,nanas,0,0,0,,Saya menasihatkan raja untuk pergi ke Dewan Hwijojong,\Ntetapi dia berkata bahawa dia tidak akan pergi ke mana-mana.
Dialog: 0,1:12:15.45,1:12:20.46,Lalai,nanas,0,0,0,,Saya tidak percaya, raja kita sangat risau tentang isterinya!
Dialog: 0,1:12:20.56,1:12:23.66,Lalai,nanas,0,0,0,,Faham, anda boleh pergi.
Dialog: 0,1:12:24.76,1:12:26.23,Lalai,nanas,0,0,0,,Baik.
Dialog: 0,1:12:30.50,1:12:32.10,Lalai,nanas,0,0,0,,Biarkan mereka menghabiskan malam bersama lebih kerap,
Dialog: 0,1:12:32.10,1:12:34.17,Lalai,nanas,0,0,0,,jadi perasaan akan berkobar di antara mereka dengan lebih cepat.
Dialog: 0,1:12:34.87,1:12:37.91,Lalai,nanas,0,0,0,,Permaisuri memberi saya kata-kata dirajanya.
Dialog: 0,1:12:38.21,1:12:39.51,Lalai,nanas,0,0,0,,Sudahkah anda memberi lantai?
Dialog: 0,1:12:39.51,1:12:42.38,Lalai,nanas,0,0,0,,Dia berjanji untuk mengandung seorang putera raja.
Dialog: 0,1:12:42.38,1:12:43.78,Lalai,nanas,0,0,0,,Apa yang kamu cakapkan!
Dialog: 0,1:12:43.78,1:12:45.58,Lalai,nanas,0,0,0,,Kemudian dalam keluarga kami
Dialog: 0,1:12:45.58,1:12:48.22,Lalai,nanas,0,0,0,,adakah pewaris takhta yang berdarah akan dilahirkan?
Dialog: 0,1:12:50.92,1:12:52.62,Lalai,nanas,0,0,0,,Apakah ini?
Dialog: 0,1:12:53.26,1:12:54.69,Lalai,nanas,0,0,0,,Tepat sekali,
Dialog: 0,1:12:55.76,1:12:57.26,Lalai,nanas,0,0,0,,lihat.
Dialog: 0,1:12:57.33,1:13:01.03,Lalai,nanas,0,0,0,,Makanlah, dan kulit anda akan menjadi seperti kulit bayi.
Dialog: 0,1:13:01.33,1:13:03.57,Lalai,nanas,0,0,0,,Hadiah yang mahal.
Dialog: 0,1:13:04.60,1:13:06.07,Lalai,nanas,0,0,0,,Jika anda suka aksinya,
Dialog: 0,1:13:06.07,1:13:09.57,Lalai,nanas,0,0,0,,Saya tidak akan menyesali apa-apa, tetapi saya akan mencari anda lagi.
Dialog: 0,1:13:10.31,1:13:11.84,Lalai,nanas,0,0,0,,Terima kasih.
Dialog: 0,1:13:14.11,1:13:17.68,Lalai,nanas,0,0,0,,Saya masih tidak percaya\Nbahawa semuanya ternyata begitu hebat.
Dialog: 0,1:13:17.68,1:13:21.02,Lalai,nanas,0,0,0,,Apabila permaisuri jatuh ke dalam tasik,
Dialog: 0,1:13:21.02,1:13:23.49,Lalai,nanas,0,0,0,,Saya hampir gila kerana teruja!
Dialog: 0,1:13:24.09,1:13:25.62,Lalai,nanas,0,0,0,,Malang, kanak-kanak yang tidak berdosa.
Dialog: 0,1:13:25.62,1:13:29.09,Lalai,nanas,0,0,0,,Saya sangat berbangga kerana dia dapat\N mengekalkan kedudukannya yang tinggi.
Dialog: 0,1:13:29.83,1:13:32.46,Lalai,nanas,0,0,0,,Air mata berlinang dengan kegembiraan.
Dialog: 0,1:13:33.10,1:13:35.00,Lalai,nanas,0,0,0,,Beritahu ia seperti itu.
Dialog: 0,1:13:35.00,1:13:37.30,Lalai,nanas,0,0,0,,Sejujurnya, permaisuri bukanlah seorang kanak-kanak yang tidak bersalah.
Dialog: 0,1:13:37.30,1:13:40.47,Lalai,nanas,0,0,0,,Ratu kami...\NBagaimana saya boleh menyebutnya dengan lebih betul?
Dialog: 0,1:13:42.34,1:13:43.84,Lalai,nanas,0,0,0,,Pintar?
Dialog: 0,1:13:44.81,1:13:46.41,Lalai,nanas,0,0,0,,Perkataan yang salah sedikit.
Dialog: 0,1:13:47.11,1:13:50.08,Lalai,nanas,0,0,0,,-Scrupulous?\N-Bukan begitu.
Dialog: 0,1:13:50.15,1:13:52.98,Lalai,nanas,0,0,0,,Terdapat perkataan yang sempurna.
Dialog: 0,1:13:53.45,1:13:55.95,Lalai,nanas,0,0,0,,-Kemudian...\N-Canggih?
Dialog: 0,1:13:56.12,1:13:57.62,Lalai,nanas,0,0,0,,Apa yang anda cakapkan?
Dialog: 0,1:14:00.76,1:14:02.29,Lalai,nanas,0,0,0,,Unik?
Dialog: 0,1:14:02.46,1:14:05.63,Lalai,nanas,0,0,0,,Tepat! Gadis yang unik.
Dialog: 0,1:14:05.63,1:14:08.03,Lalai,nanas,0,0,0,,Kami tidak dapat mencari ratu yang lebih baik!
Dialog: 0,1:14:08.03,1:14:09.70,Lalai,nanas,0,0,0,,Tepat sekali!
Dialog: 0,1:14:09.77,1:14:14.04,Lalai,nanas,0,0,0,,Saya melihat dia dan melihat anda semasa muda!
Dialog: 0,1:14:14.24,1:14:15.87,Lalai,nanas,0,0,0,,Karut sungguh!
Dialog: 0,1:14:23.45,1:14:24.78,Lalai,nanas,0,0,0,,Adakah anda sudah gila?
Dialog: 0,1:14:24.78,1:14:27.72,Lalai,nanas,0,0,0,,Adakah anda melihat ini dengan mata kepala anda sendiri?\NDengan ini?
Dialog: 0,1:14:27.72,1:14:30.32,Lalai,nanas,0,0,0,,Sekurang-kurangnya seseorang di istana melihatnya secara peribadi,
Dialog: 0,1:14:30.32,1:14:32.22,Lalai,nanas,0,0,0,,untuk gundik menolak ratu?
Dialog: 0,1:14:33.09,1:14:35.49,Lalai,nanas,0,0,0,,Adakah ia berbaloi?\NSemua orang sudah tahu itu dia!
Dialog: 0,1:14:35.49,1:14:37.16,Lalai,nanas,0,0,0,,-Tepat sekali!\N-Dia betul.
Dialog: 0,1:14:37.16,1:14:38.26,Lalai,nanas,0,0,0,,Ya, semua orang tahu mengenainya.
Dialog: 0,1:14:38.26,1:14:42.13,Lalai,nanas,0,0,0,,Seperti yang mereka katakan, topi pencuri terbakar.
Dialog: 0,1:14:42.63,1:14:44.40,Lalai,nanas,0,0,0,,Khabar angin ini tidak datang begitu sahaja.
Dialog: 0,1:14:49.94,1:14:51.41,Lalai,nanas,0,0,0,,Beraninya awak!
Dialog: 0,1:14:51.41,1:14:54.48,Lalai,nanas,0,0,0,,Bersedia! Esok pagi akan ada khabar angin bahawa anda adalah bodoh botak!
Dialog: 0,1:14:54.48,1:14:55.78,Lalai,nanas,0,0,0,,Bajingan!
Dialog: 0,1:14:55.78,1:14:57.65,Lalai,nanas,0,0,0,,Lepaskan saya! Sekarang!
Dialog: 0,1:14:57.65,1:14:59.28,Lalai,nanas,0,0,0,,Lepaskan saya!
Dialog: 0,1:14:59.75,1:15:01.95,Lalai,nanas,0,0,0,,Permaisuri menetapkan dia!
Dialog: 0,1:15:01.95,1:15:03.62,Lalai,nanas,0,0,0,,Apabila wanita saya lewat,
Dialog: 0,1:15:03.62,1:15:05.89,Lalai,nanas,0,0,0,,permaisuri terjun ke dalam air dengan sengaja!
Dialog: 0,1:15:05.89,1:15:08.06,Lalai,nanas,0,0,0,,Sebelum anda bersembang, ketahui kebenarannya!
Dialog: 0,1:15:24.51,1:15:26.61,Lalai,nanas,0,0,0,,Hari ini saya pasti...
Dialog: 0,1:15:52.17,1:15:55.97,Lalai,nanas,0,0,0,,Yang Mulia, saya fikir\Nyonya akan berlatih menulis.
Dialog: 0,1:15:56.14,1:15:57.91,Lalai,nanas,0,0,0,,Apabila saya pergi ke Yejan,
Dialog: 0,1:15:57.91,1:16:00.51,Lalai,nanas,0,0,0,,untuk bermain tudjon dengan Encik Hong,
Dialog: 0,1:16:00.51,1:16:02.98,Lalai,nanas,0,0,0,,Saya melihat sesuatu yang mengagumkan saya.
Dialog: 0,1:16:05.78,1:16:10.12,Lalai,nanas,0,0,0,,Seseorang dari jarak jauh\Nmelempar keris ke sasaran.
Dialog: 0,1:16:12.69,1:16:15.29,Lalai,nanas,0,0,0,,Saya fikir mengapa tidak mencubanya.
Dialog: 0,1:16:16.56,1:16:18.26,Lalai,nanas,0,0,0,,Ini sangat berbahaya,
Dialog: 0,1:16:18.26,1:16:20.43,Lalai,nanas,0,0,0,,bagaimana jika anda cedera?
Dialog: 0,1:16:28.47,1:16:31.24,Lalai,nanas,0,0,0,,Sudah berapa lama kita mengenali antara satu sama lain?
Dialog: 0,1:16:33.51,1:16:36.41,Lalai,nanas,0,0,0,,Dua tahun, tuan.
Dialog: 0,1:16:39.95,1:16:41.35,Lalai,nanas,0,0,0,,Begitulah.
Dialog: 0,1:16:45.09,1:16:48.86,Lalai,nanas,0,0,0,,Selama ini anda mempelajari segala-galanya di dunia tentang saya,
Dialog: 0,1:16:48.86,1:16:50.63,Lalai,nanas,0,0,0,,menjadi lengan dan kaki saya.
Dialog: 0,1:16:50.63,1:16:53.63,Lalai,nanas,0,0,0,,Seolah-olah kita telah mengenali antara satu sama lain selama bertahun-tahun.
Dialog: 0,1:16:54.63,1:16:57.90,Lalai,nanas,0,0,0,,Saya hanya menjalankan tugas saya.
Dialog: 0,1:16:58.07,1:16:59.57,Lalai,nanas,0,0,0,,Pekerjaan anda?
Dialog: 0,1:17:01.97,1:17:03.71,Lalai,nanas,0,0,0,,Mungkin ini tugas anda,
Dialog: 0,1:17:03.71,1:17:05.24,Lalai,nanas,0,0,0,,tetapi saya tidak boleh berhenti memikirkan
Dialog: 0,1:17:05.24,1:17:08.11,Lalai,nanas,0,0,0,,adakah anda berbakti kepada saya, kerana anda perlu
Dialog: 0,1:17:08.61,1:17:10.08,Lalai,nanas,0,0,0,,atau
Dialog: 0,1:17:11.08,1:17:14.15,Lalai,nanas,0,0,0,,kerana anda sendiri mahukannya.
Dialog: 0,1:17:15.75,1:17:17.99,Lalai,nanas,0,0,0,,Saya pasti perasaan anda ikhlas.
Dialog: 0,1:17:19.99,1:17:22.96,Lalai,nanas,0,0,0,,Terima kasih kerana perasan, tuan!
Dialog: 0,1:17:22.96,1:17:24.86,Lalai,nanas,0,0,0,,Adakah anda percaya saya?
Dialog: 0,1:17:25.36,1:17:28.63,Lalai,nanas,0,0,0,,Jika bukan untuk anda, maka untuk siapa?
Dialog: 0,1:17:36.04,1:17:37.71,Lalai,nanas,0,0,0,,Saya fikir ia lebih mudah.
Dialog: 0,1:17:38.11,1:17:42.01,Lalai,nanas,0,0,0,,Tetapi adakah anda meragui saya?
Dialog: 0,1:17:44.68,1:17:47.22,Lalai,nanas,0,0,0,,Tolong maafkan saya.
Dialog: 0,1:17:47.22,1:17:49.92,Lalai,nanas,0,0,0,,Seiring bertambahnya usia saya menjadi lebih pengecut.
Dialog: 0,1:17:51.62,1:17:54.39,Lalai,nanas,0,0,0,,Malam ini\NI akan pergi ke Dewan Daejojeon lebih awal.
Dialog: 0,1:17:54.49,1:17:56.36,Lalai,nanas,0,0,0,,Saya akan sediakan semuanya.
Dialog: 0,1:18:32.96,1:18:35.83,Lalai,nanas,0,0,0,,Untuk bertemu dengan anda,\Nkami terpaksa datang awal.
Dialog: 0,1:18:37.20,1:18:39.27,Lalai,nanas,0,0,0,,Bagaimanapun, betapa rajinnya anda.
Dialog: 0,1:18:39.27,1:18:41.17,Lalai,nanas,0,0,0,,Begitu banyak usaha supaya kita boleh tidur.
Dialog: 0,1:18:41.17,1:18:43.81,Lalai,nanas,0,0,0,,Kami telah menyediakan minuman dan makanan ringan.
Dialog: 0,1:18:44.94,1:18:46.11,Lalai,nanas,0,0,0,,Kenapa ini perlu?
Dialog: 0,1:18:46.11,1:18:48.11,Lalai,nanas,0,0,0,,Saya tahu awak suka minum,
Dialog: 0,1:18:48.11,1:18:50.28,Lalai,nanas,0,0,0,,jadi saya mengarahkan mereka untuk disediakan untuk anda.
Dialog: 0,1:18:50.35,1:18:51.98,Lalai,nanas,0,0,0,,Saya sudah selesai dengan ini.
Dialog: 0,1:18:53.95,1:18:56.05,Lalai,nanas,0,0,0,,Saya juga memikirkan perkara ini.
Dialog: 0,1:18:57.42,1:18:59.69,Lalai,nanas,0,0,0,,Kami membawa hidangan untuk teh.
Dialog: 0,1:19:12.37,1:19:14.27,Lalai,nanas,0,0,0,,Ini teh melati Arab.
Dialog: 0,1:19:15.27,1:19:17.74,Lalai,nanas,0,0,0,,Jika anda mengalami insomnia atau kebimbangan,
Dialog: 0,1:19:17.74,1:19:19.61,Lalai,nanas,0,0,0,,ia akan menenangkan anda.
Dialog: 0,1:19:26.75,1:19:28.65,Lalai,nanas,0,0,0,, Jasmine Gull?
Dialog: 0,1:19:28.82,1:19:31.09,Lalai,nanas,0,0,0,,Bau yang kuat.
Dialog: 0,1:19:40.63,1:19:44.10,Lalai,nanas,0,0,0,,Malam itu seluruh bilik berbau melati.
Dialog: 0,1:19:48.97,1:19:52.91,Lalai,nanas,0,0,0,,Baunya malah meresap ke dalam lengan bajunya.
Dialog: 0,1:20:25.24,1:20:26.74,Lalai,nanas,0,0,0,,Itu awak.
Dialog: 0,1:20:29.68,1:20:31.28,Lalai,nanas,0,0,0,,Itu awak...
Dialog: 0,1:20:31.85,1:20:34.45,Lalai,nanas,0,0,0,,Anda tidak sepatutnya mendedahkan semua kad anda secara melulu.
Dialog: 0,1:20:37.79,1:20:43.29,Lalai,nanas,0,0,0,,Terutama di istana, di mana setiap orang mempunyai rahsia mereka sendiri.
Dialog: 0,1:20:55.24,1:20:56.64,Lalai,nanas,0,0,0,,Bagaimana saya menjadi seorang ratu
Dialog: 0,1:20:56.64,1:20:57.64,Lalai,nanas,0,0,0,,
Dialog: 0,1:20:57.64,1:20:59.21,Lalai,nanas,0,0,0,,
Dialog: 0,1:21:16.49,1:21:18.96,Lalai,nanas,0,0,0,,Adakah saya benar-benar jatuh ke dalam perangkap mata dan kata-katanya yang menipu?
Dialog: 0,1:21:18.96,1:21:20.73,Lalai,nanas,0,0,0,,Buat dia memberitahu anda segala-galanya.
Dialog: 0,1:21:20.73,1:21:22.90,Lalai,nanas,0,0,0,,-Siapa yang menghantar surat itu?\N-Permaisuri Janda.
Dialog: 0,1:21:22.90,1:21:24.47,Lalai,nanas,0,0,0,,Hanya sehingga tasik dipenuhi air.
Dialog: 0,1:21:24.47,1:21:26.87,Lalai,nanas,0,0,0,,Saya akan menanggung semua ini, dan kemudian saya akan pulang ke rumah.
Dialog: 0,1:21:26.87,1:21:28.64,Lalai,nanas,0,0,0,,Orang yang kami cari ialah seorang wanita mahkamah.
Dialog: 0,1:21:28.64,1:21:31.54,Lalai,nanas,0,0,0,,Lakukan segala-galanya untuk tidak ditangkap.
Dialog: 0,1:21:31.54,1:21:34.01,Lalai,nanas,0,0,0,,Saya dapat tahu dari mana asal kain ini.
Dialog: 0,1:21:34.01,1:21:35.28,Lalai,nanas,0,0,0,,Dari istana.
Dialog: 0,1:21:35.28,1:21:37.25,Lalai,nanas,0,0,0,,Keperluan anda ialah pasangan diraja, bukan saya.
Dialog: 0,1:21:37.25,1:21:39.85,Lalai,nanas,0,0,0,,Adakah anda mahu mengembalikan semuanya?\NIni adalah balas dendam.
Dialog: 0,1:21:39.85,1:21:42.62,Lalai,nanas,0,0,0,,-Itulah yang saya lakukan kepada awak.\N-Adakah anda fikir saya tidak boleh?
Dialog: 0,0:00:58.00,0:01:03.00,Lalai,,0,0,0,,


