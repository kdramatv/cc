Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Hos, Nanas, Hazelnut
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.08,0:01:06.55, Lalai,,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.55,0:01:08.59, Lalai,,0,0,0, dan acara yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:09.16,0:01:11.63, Lalai,,0,0,0,,Oh, mommies! Apa yang perlu dilakukan?\NIni adalah buku yang tidak ternilai.
Dialog: 0,0:01:11.63,0:01:12.63, Lalai,,0,0,0,,16 episod
Dialog: 0,0:01:27.91,0:01:30.21, Lalai,,0,0,0,,Mengapa anda mengatakan bahawa buku ini tidak ternilai?
Dialog: 0,0:01:32.68,0:01:36.25, Lalai,,0,0,0,,Bagaimanakah Arahan Utama untuk Kanak-kanak berharga kepada anda?
Dialog: 0,0:01:37.98,0:01:39.82, Lalai,,0,0,0,,-Itu...\N-Adakah itu anda?
Dialog: 0,0:01:41.72,0:01:44.32, Lalai,,0,0,0,,Orang yang menyelamatkan saya ialah awak?
Dialog: 0,0:01:44.69,0:01:46.79, Lalai,,0,0,0,,Awak selamatkan saya dari perigi?
Dialog: 0,0:01:56.47,0:01:58.84, Lalai,,0,0,0,,Ya. Ia adalah saya.
Dialog: 0,0:02:04.68,0:02:05.98,Lalai,,0,0,0,,Adakah anda sudah lupa tentang segala-galanya?
Dialog: 0,0:02:06.35,0:02:08.25, Lalai,,0,0,0,,Ya, saya mengheret awak di bonggol saya.
Dialog: 0,0:02:09.62,0:02:12.02, Lalai,,0,0,0,,Tangan masih jatuh.
Dialog: 0,0:02:12.52,0:02:15.92,Lalai,,0,0,0,,Saya tidak percaya bahawa anda terlupa tentang segala-galanya.\NAnda tidak ingat apa-apa yang baik sama sekali.
Dialog: 0,0:02:16.26,0:02:18.73, Lalai,,0,0,0,,Tidak, saya bercakap tentang peristiwa lapan tahun lalu.
Dialog: 0,0:02:19.19,0:02:20.89, Lalai,,0,0,0,,Jadi ini bukan kali pertama anda jatuh ke dalam perigi?
Dialog: 0,0:02:21.80,0:02:23.93, Lalai,,0,0,0,,Adakah anda tidak melihat sekeliling langsung?
Dialog: 0,0:02:27.50,0:02:29.64, Lalai,,0,0,0,,Lalu mengapa buku ini sangat berharga?
Dialog: 0,0:02:31.51,0:02:33.87, Lalai,,0,0,0,,Nampak seperti salah satu karya agung yang sebenar.
Dialog: 0,0:02:36.01,0:02:37.98, Lalai,,0,0,0,,Sekali lagi anda bercakap mengarut.
Dialog: 0,0:02:39.68,0:02:41.82,Lalai,,0,0,0,,Bangun dari mimpi ngeri,\Nseperti saya dikurung dalam perigi,
Dialog: 0,0:02:41.82,0:02:43.32,Lalai,,0,0,0,,Saya serta-merta terfikir tentang awak.
Dialog: 0,0:02:44.89,0:02:47.39, Lalai,,0,0,0,,Saya memutuskan ia adalah kerana awak menolong saya keluar,
Dialog: 0,0:02:48.66,0:02:50.79,Lalai,,0,0,0,,tetapi sejak itu saya menjadi
Dialog: 0,0:02:50.79,0:02:52.89,Lalai,,0,0,0,,perasan betapa serupa\Nyou dengan gadis yang menyelamatkan saya.
Dialog: 0,0:02:55.06,0:02:57.96, Lalai,,0,0,0,,Fikir mungkin anda.
Dialog: 0,0:03:01.30,0:03:04.27, Lalai,,0,0,0,,Jika mi mengembang,\Nit tidak akan sedap.
Dialog: 0,0:03:05.57,0:03:06.67, Lalai,,0,0,0,,Sudikah anda?
Dialog: 0,0:03:09.41,0:03:11.18, Lalai,,0,0,0,,Boleh selera.
Dialog: 0,0:03:16.25,0:03:17.35, Lalai,,0,0,0,, Comel.
Dialog: 0,0:03:19.85,0:03:23.32, Lalai,,0,0,0,,Tiup untuk menyejukkannya, dan jangan tergesa-gesa.
Dialog: 0,0:03:32.33,0:03:33.90, Lalai,,0,0,0,,Apa yang menarik tentang anda?
Dialog: 0,0:03:34.37,0:03:36.47, Lalai,,0,0,0,,Manual Taktik Dinasti Ming.
Dialog: 0,0:03:36.67,0:03:37.94, Lalai,,0,0,0,,Manual taktik?
Dialog: 0,0:03:38.77,0:03:39.84, Lalai,,0,0,0,, Taktik ketenteraan?
Dialog: 0,0:03:41.01,0:03:42.48,Lalai,,0,0,0,,Adakah anda merancang untuk memulakan peperangan?
Dialog: 0,0:03:42.84,0:03:44.84, Lalai,,0,0,0,,Jika saya ingin mengukuhkan kuasa,
Dialog: 0,0:03:44.84,0:03:46.85, Lalai,,0,0,0,,Saya perlukan sokongan tentera.
Dialog: 0,0:03:48.55,0:03:50.72,Lalai,,0,0,0,,Saya masih mengalami mimpi buruk tentang
Dialog: 0,0:03:51.45,0:03:53.09, Lalai,,0,0,0,,bagaimana anda akan mati tanpa mencapai apa-apa?
Dialog: 0,0:03:53.45,0:03:54.69, Lalai,,0,0,0,, Kes demi kes.
Dialog: 0,0:04:00.69,0:04:04.93, Lalai,,0,0,0,,Jika ini berlaku,\Bukan kerana anda bodoh.
Dialog: 0,0:04:05.13,0:04:07.17, Lalai,,0,0,0,,Ia pada asalnya dimaksudkan.
Dialog: 0,0:04:07.53,0:04:11.17, Lalai,,0,0,0,,Anda hanya bernasib malang.
Dialog: 0,0:04:11.17,0:04:12.34, Lalai,,0,0,0,,Bukan salah awak.
Dialog: 0,0:04:12.97,0:04:14.41, Lalai,,0,0,0,,Mungkin anda betul.
Dialog: 0,0:04:15.28,0:04:18.88,Lalai,,0,0,0,,Jadi berhentilah menyeksa diri anda seperti itu.
Dialog: 0,0:04:19.38,0:04:20.81, Lalai,,0,0,0,,Anda masih tidak boleh
Dialog: 0,0:04:22.18,0:04:23.38,Lalai,,0,0,0,,mengganggu takdir.
Dialog: 0,0:04:28.42,0:04:30.02,Lalai,,0,0,0,,Kadang-kadang saya tersedar dari mimpi ngeri,
Dialog: 0,0:04:30.66,0:04:33.16, Lalai,,0,0,0,,dan fikiran pelik muncul di fikiran.
Dialog: 0,0:04:35.00,0:04:36.56, Lalai,,0,0,0,, Bahawa mimpi ini adalah nyata,
Dialog: 0,0:04:37.63,0:04:39.17, Lalai,,0,0,0,, dan kita hidup pada masa lalu.
Dialog: 0,0:04:46.44,0:04:49.88, Lalai,,0,0,0,,Seolah-olah semua ini adalah penglihatan saya
Dialog: 0,0:04:50.61,0:04:52.01, Lalai,,0,0,0,,sejurus sebelum kematian.
Dialog: 0,0:04:55.82,0:04:57.45, Lalai,,0,0,0,,Dan pada masa ini
Dialog: 0,0:05:00.29,0:05:03.96,Lalai,,0,0,0,,Saya mempunyai peluang untuk melakukan sesuatu, untuk membetulkan segala-galanya.
Dialog: 0,0:05:08.43,0:05:10.10, Lalai,,0,0,0,,Mungkin sekarang
Dialog: 0,0:05:12.43,0:05:15.64,Lalai,,0,0,0,,Saya melakukan segala-galanya untuk menentang takdir.
Dialog: 0,0:05:24.74,0:05:29.42,Lalai,,0,0,0,,Demi lelaki ini, yang takdirnya kalah,\NI mahu korbankan segala-galanya.
Dialog: 0,0:05:35.96,0:05:38.76,Lalai,,0,0,0,,All-in
Dialog: 0,0:05:44.76,0:05:47.17, Lalai,,0,0,0,,Anda pasti akan mengalahkan mereka semua.
Dialog: 0,0:05:48.87,0:05:50.70,Lalai,,0,0,0,,Saya sentiasa berada di pihak pemenang.
Dialog: 0,0:05:50.70,0:05:53.74, Lalai,,0,0,0,,Dan semasa saya ada,\Nvictory adalah milik anda.
Dialog: 0,0:05:56.21,0:05:59.55, Lalai,,0,0,0,,Sikap anda sangat menggalakkan.
Dialog: 0,0:06:01.08,0:06:03.12, Lalai,,0,0,0,,Saya ada senjata rahsia.
Dialog: 0,0:06:04.32,0:06:05.59, Lalai,,0,0,0,,Saya tahu masa depan.
Dialog: 0,0:06:07.05,0:06:08.66, Lalai,,0,0,0,,Ingat?
Dialog: 0,0:06:08.66,0:06:10.29, Lalai,,0,0,0,,Seperti yang anda katakan,\Nbahawa saya seorang lelaki dari masa depan yang jauh?
Dialog: 0,0:06:10.29,0:06:12.86, Lalai,,0,0,0,,Sudah tentu saya ingat.\NISukar untuk dilupakan.
Dialog: 0,0:06:13.16,0:06:14.79, Lalai,,0,0,0,,Bagaimana jika ini benar,
Dialog: 0,0:06:15.60,0:06:18.10,Lalai,,0,0,0,,dan saya akan berkongsi pengetahuan saya dengan anda?
Dialog: 0,0:06:19.13,0:06:21.37, Lalai,,0,0,0,,Adakah anda fikir saya akan percaya ini?
Dialog: 0,0:06:22.67,0:06:23.84, Lalai,,0,0,0,,Dalam kes ini,
Dialog: 0,0:06:25.00,0:06:28.71, Lalai,,0,0,0,,fikirkan saya bermimpi.\NA mimpi kenabian yang berguna.
Dialog: 0,0:06:31.01,0:06:32.08, Lalai,,0,0,0,,Karut.
Dialog: 0,0:06:35.25,0:06:40.45,Lalai,,0,0,0,,Oleh kerana ini hanyalah mimpi,\NI tidak akan percaya cerita anda,
Dialog: 0,0:06:40.82,0:06:42.49, Lalai,,0,0,0,,tetapi saya akan mendengar dengan senang hati.
Dialog: 0,0:06:43.39,0:06:45.23, Lalai,,0,0,0,,Bagaimana Joseon 200 tahun kemudian?
Dialog: 0,0:06:46.39,0:06:47.39,Lalai,,0,0,0,,Nah.
Dialog: 0,0:06:50.30,0:06:52.63, Lalai,,0,0,0,,Ini hanyalah cerita yang saya reka,
Dialog: 0,0:06:54.07,0:06:56.24, Lalai,,0,0,0,,tetapi kami tidak lagi memanggil negara kami Joseon.
Dialog: 0,0:06:57.37,0:06:59.94,Lalai,,0,0,0,,Republik Korea.\NInilah yang Joseon tunggu.
Dialog: 0,0:07:01.84,0:07:02.94, Lalai,,0,0,0,,Republik Korea?
Dialog: 0,0:07:02.94,0:07:05.88,Lalai,,0,0,0,,Di negara ini, rakyat sendiri yang memilih\Nsiapa yang akan memerintah.
Dialog: 0,0:07:06.15,0:07:07.55, Lalai,,0,0,0,,Karut sungguh.
Dialog: 0,0:07:08.11,0:07:11.89,Lalai,,0,0,0,,Beritahu saya sesuatu yang lebih dipercayai supaya saya percaya.
Dialog: 0,0:07:12.22,0:07:13.75, Lalai,,0,0,0,,Jika anda tidak percaya saya sekarang,\Nkami menghadapi masalah.
Dialog: 0,0:07:13.75,0:07:15.69, Lalai,,0,0,0,,Ini hanyalah ciptaan saya.
Dialog: 0,0:07:16.72,0:07:20.03, Lalai,,0,0,0,,200 tahun kemudian tidak ada bangsawan dan rakyat jelata.
Dialog: 0,0:07:21.36,0:07:23.30,Lalai,,0,0,0,,Orang ramai tidak lagi dibahagikan kepada kelas?
Dialog: 0,0:07:24.33,0:07:26.63, Lalai,,0,0,0,,Orang ramai datang dengan sesuatu yang baharu.
Dialog: 0,0:07:26.97,0:07:28.43, Lalai,,0,0,0,,Adakah anda beg wang atau tidak.
Dialog: 0,0:07:29.74,0:07:32.41, Lalai,,0,0,0,,Status seseorang ditentukan oleh begnya?
Dialog: 0,0:07:33.47,0:07:36.34, Lalai,,0,0,0,,Dan apa, semua orang memilih pembaris menggunakan beg?
Dialog: 0,0:07:36.68,0:07:38.78, Lalai,,0,0,0,,Ini dipanggil mengundi.
Dialog: 0,0:07:38.78,0:07:40.65, Lalai,,0,0,0,,Apabila anda berumur 18 tahun,
Dialog: 0,0:07:40.65,0:07:44.12, Lalai,,0,0,0,,anda boleh memilih pembaris.
Dialog: 0,0:07:44.85,0:07:47.12, Lalai,,0,0,0,,-Pilih pembaris?\N-Ya.
Dialog: 0,0:07:47.12,0:07:48.59, Lalai,,0,0,0,,Kenapa tepat pada 18?
Dialog: 0,0:07:53.73,0:07:57.63, Lalai,,0,0,0,,Beginilah perjalanan hari ratu.
Dialog: 0,0:08:01.03,0:08:02.37, Lalai,,0,0,0,,Anda hebat.
Dialog: 0,0:08:06.97,0:08:10.68, Lalai,,0,0,0,,Sekarang perhatikan setiap aksinya.
Dialog: 0,0:08:22.86,0:08:24.12, Lalai,,0,0,0,,Benin,
Dialog: 0,0:08:24.99,0:08:27.69,Lalai,,0,0,0,,anda kini\Nour Menteri Perang bongsu
Dialog: 0,0:08:28.23,0:08:30.10, Lalai,,0,0,0,,dan menjadi lebih menarik.
Dialog: 0,0:08:30.50,0:08:31.80, Lalai,,0,0,0,,Adakah anda benar-benar fikir begitu?
Dialog: 0,0:08:32.10,0:08:34.17, Lalai,,0,0,0,,-Sudah tentu tidak.\N-Saya tahu.
Dialog: 0,0:08:36.10,0:08:37.44, Lalai,,0,0,0,,Tahniah!
Dialog: 0,0:08:46.01,0:08:47.51, Lalai,,0,0,0,,By the way, Benin,
Dialog: 0,0:08:47.95,0:08:50.48,Lalai,,0,0,0,,tiada apa-apa untuk keluarga kita sama sekali
Dialog: 0,0:08:50.68,0:08:52.85, Lalai,,0,0,0,,tidak boleh bergaul dengan raja?
Dialog: 0,0:08:54.25,0:08:55.96, Lalai,,0,0,0,,Dia sangat penting kepada permaisuri
Dialog: 0,0:08:57.12,0:08:59.06, Lalai,,0,0,0,,dan dia tidak kelihatan seperti orang jahat.
Dialog: 0,0:08:59.06,0:09:01.59,Lalai,,0,0,0,,Semua simpatinya terhadap permaisuri adalah pembohongan.
Dialog: 0,0:09:03.96,0:09:07.03, Lalai,,0,0,0,,Untuk kepentingan dirinya\Ndia akan sentiasa mempertaruhkan nyawanya.
Dialog: 0,0:09:08.00,0:09:09.80, Lalai,,0,0,0,,Saya tidak akan berkata begitu.
Dialog: 0,0:09:09.80,0:09:11.64, Lalai,,0,0,0,,Ini adalah perkara yang paling menjengkelkan tentang dia.
Dialog: 0,0:09:12.74,0:09:15.41, Lalai,,0,0,0,,Bersembunyi di sebalik topeng dan wanita.
Dialog: 0,0:09:16.31,0:09:19.15, Lalai,,0,0,0,, Berkelakuan secara berganda\Nand menipu semua orang di sekeliling dengan khianat.
Dialog: 0,0:09:20.35,0:09:22.48,Lalai,,0,0,0,,Permaisuri juga tunduk kepada daya tarikannya,
Dialog: 0,0:09:22.48,0:09:24.95, Lalai,,0,0,0,,dan sekarang demi raja\NI bersedia untuk menyerahkan keluarga saya.
Dialog: 0,0:09:26.15,0:09:28.45,Lalai,,0,0,0,,Namun, raja hanya menggunakan dia.
Dialog: 0,0:09:29.46,0:09:32.03, Lalai,,0,0,0,,Tetapi saya mendengar bahawa itu adalah ratu
Dialog: 0,0:09:32.03,0:09:33.73, Lalai,,0,0,0,,memusingkan raja mengikut kehendaknya.
Dialog: 0,0:09:34.26,0:09:36.53, Lalai,,0,0,0,,Dan siapa,
Dialog: 0,0:09:36.53,0:09:39.60,Lalai,,0,0,0,,supaya hamba tahu lebih baik daripada sesiapa pun tentang kehidupan peribadi raja.
Dialog: 0,0:09:40.43,0:09:44.77,Lalai,,0,0,0,,Mereka mengatakan mereka berada di sana sehingga subuh malam tadi
Dialog: 0,0:09:45.10,0:09:49.11, Lalai,,0,0,0,,mereka sedang berbual di dalam kamar raja.
Dialog: 0,0:10:15.23,0:10:17.20, Lalai,,0,0,0,,Jika Cheoljong gagal,
Dialog: 0,0:10:17.20,0:10:19.14, Lalai,,0,0,0,, adakah dunia akan berubah selepas 200 tahun juga?
Dialog: 0,0:10:19.51,0:10:22.28, Lalai,,0,0,0,,Dan kemudian tidak akan ada penggabungan Jepun,
Dialog: 0,0:10:22.58,0:10:24.81, Lalai,,0,0,0,,dan Pengarah Khan yang bajingan itu tidak akan dilahirkan.
Dialog: 0,0:10:28.18,0:10:29.95, Lalai,,0,0,0,,Semua ini bukan untuk Cheoljong.
Dialog: 0,0:10:30.28,0:10:32.99, Lalai,,0,0,0,,Saya melakukan ini untuk diri saya sendiri.
Dialog: 0,0:10:34.65,0:10:36.36, Lalai,,0,0,0,,Membantu anda,
Dialog: 0,0:10:38.59,0:10:40.29, Lalai,,0,0,0,,Saya menyelamatkan diri.
Dialog: 0,0:10:51.70,0:10:52.81,Lalai,,0,0,0,,Yang Mulia!
Dialog: 0,0:10:54.47,0:10:58.01,Lalai,,0,0,0,,Yang Mulia!\NYa bapa anda telah jatuh pengsan!
Dialog: 0,0:11:03.25,0:11:04.85, Lalai,,0,0,0,,Sungguh mimpi ngeri.
Dialog: 0,0:11:05.02,0:11:06.79, Lalai,,0,0,0,,Jangan bangun!
Dialog: 0,0:11:13.09,0:11:15.23, Lalai,,0,0,0,,-Apa yang berlaku?\N-Ia berbahaya di sini.
Dialog: 0,0:11:15.23,0:11:17.33, Lalai,,0,0,0,,Kenapa awak datang?
Dialog: 0,0:11:18.87,0:11:21.70, Lalai,,0,0,0,,Tidak! Ia jauh lebih berbahaya di dalam istana.
Dialog: 0,0:11:23.60,0:11:26.34, Lalai,,0,0,0,,Ratu, duduk di rumah.
Dialog: 0,0:11:26.51,0:11:28.94,Lalai,,0,0,0,,Saya akan melakukan segalanya untuk melindungi kamu.
Dialog: 0,0:11:30.91,0:11:33.25,Lalai,,0,0,0,,Anda pasti pengsan\Nkerana risaukan saya.
Dialog: 0,0:11:34.28,0:11:36.88,Lalai,,0,0,0,,Ini salah saya.
Dialog: 0,0:11:37.42,0:11:41.09, Lalai,,0,0,0,,Seolah-olah saya secara peribadi memberi awak racun ini.
Dialog: 0,0:11:42.32,0:11:45.19, Lalai,,0,0,0,,Saya menulis buku bodoh itu\Nand tidak mengikutinya.
Dialog: 0,0:11:45.63,0:11:47.56, Lalai,,0,0,0,,Mereka melakukan perkara yang salah.
Dialog: 0,0:11:48.39,0:11:52.03, Lalai,,0,0,0,,Ini bukan salah awak, jadi berhenti.
Dialog: 0,0:11:52.13,0:11:54.37,Lalai,,0,0,0,,Lebih baik jaga kesihatan anda.
Dialog: 0,0:11:54.37,0:11:55.90,Lalai,,0,0,0,,Saya sihat seperti lembu.
Dialog: 0,0:11:57.20,0:12:00.74,Lalai,,0,0,0,,Selagi anda gembira, saya juga.
Dialog: 0,0:12:02.34,0:12:03.51,Lalai,,0,0,0,,Oleh itu, sayang,
Dialog: 0,0:12:05.45,0:12:07.35,Lalai,,0,0,0,,menolak gelaran ratu.
Dialog: 0,0:12:09.18,0:12:10.92, Lalai,,0,0,0,,-Ayah.\N-Soyeon.
Dialog: 0,0:12:12.72,0:12:14.49,Lalai,,0,0,0,,Semasa ibu anda mengandung,
Dialog: 0,0:12:14.82,0:12:17.06, Lalai,,0,0,0,,dia selalu mengulangi sesuatu.
Dialog: 0,0:12:17.96,0:12:20.73,Lalai,,0,0,0,,Dia mahu anaknya jauh lebih bahagia daripada dia.
Dialog: 0,0:12:21.69,0:12:24.46, Lalai,,0,0,0,,Supaya anda menjalani kehidupan anda seperti yang dia tidak boleh lakukan.
Dialog: 0,0:12:24.93,0:12:27.30,Lalai,,0,0,0,,Supaya hidup anda lebih baik\Ndaripada ibu anda.
Dialog: 0,0:12:28.67,0:12:30.84, Lalai,,0,0,0,,Ini adalah hasrat terakhirnya.
Dialog: 0,0:12:31.87,0:12:33.07,Lalai,,0,0,0,,Sejak selepas kematian
Dialog: 0,0:12:33.34,0:12:36.11,Lalai,,0,0,0,,boleh saya tengok mata ibu awak?
Dialog: 0,0:12:38.71,0:12:39.85, Lalai,,0,0,0,,Ayah.
Dialog: 0,0:12:40.88,0:12:44.58,Lalai,,0,0,0,,Saya pasti akan memenuhi kehendak ibu saya.
Dialog: 0,0:12:44.92,0:12:48.86,Lalai,,0,0,0,,Saya akan membalas dendam kepada mereka atas semua yang mereka lakukan kepada saya.
Dialog: 0,0:12:50.06,0:12:51.09, Lalai,,0,0,0,, Ratu!
Dialog: 0,0:12:51.09,0:12:53.46, Lalai,,0,0,0,,Jadi anda tidak boleh root untuk apa-apa.
Dialog: 0,0:12:57.33,0:12:59.37,Lalai,,0,0,0,,Saya ada permintaan untuk anda.
Dialog: 0,0:13:00.33,0:13:04.14, Lalai,,0,0,0,,Dengar. Anda boleh meminta apa sahaja.
Dialog: 0,0:13:04.30,0:13:06.87, Lalai,,0,0,0,,Saya akan lakukan segalanya.
Dialog: 0,0:13:08.37,0:13:10.11,Lalai,,0,0,0,,Jualan daripada stok
Dialog: 0,0:13:11.14,0:13:13.95, Lalai,,0,0,0,,Pemiliknya sudah gila!
Dialog: 0,0:13:16.38,0:13:17.98,Lalai,,0,0,0,,Dalam hidup saya, saya tidak akan pernah terfikir bahawa dia seperti ini!
Dialog: 0,0:13:18.22,0:13:21.22,Lalai,,0,0,0,,Bagaimana jika mereka memaksa anda membayar dua kali ganda?
Dialog: 0,0:13:21.22,0:13:22.26,Lalai,,0,0,0,,Apa?
Dialog: 0,0:13:23.02,0:13:24.49,Lalai,,0,0,0,,Terima kasih!
Dialog: 0,0:13:24.52,0:13:27.13,Lalai,,0,0,0,,En. Kim! Tuanku!
Dialog: 0,0:13:27.13,0:13:29.70, Lalai,,0,0,0,, Panjang umur untuk anda!
Dialog: 0,0:13:30.70,0:13:32.30, Lalai,,0,0,0,, Jual dia seuncang beras?
Dialog: 0,0:13:32.30,0:13:33.77, Lalai,,0,0,0,,Ia hanya terbang seperti burung kukuk!
Dialog: 0,0:13:35.30,0:13:38.37, Lalai,,0,0,0,, Lelaki itu sudah hilang akal!
Dialog: 0,0:13:42.68,0:13:44.64, Lalai,,0,0,0,,Saya ada permintaan untuk awak.
Dialog: 0,0:13:44.78,0:13:46.51,Lalai,,0,0,0,,Lupakan tentang rasuah,
Dialog: 0,0:13:46.95,0:13:48.98,Lalai,,0,0,0,,jaga reputasi anda.
Dialog: 0,0:13:51.85,0:13:55.19,Lalai,,0,0,0,,Adakah anda pasti mahu menjual semua ini kepada orang ramai?
Dialog: 0,0:13:55.19,0:13:56.19,Lalai,,0,0,0,,Tepat!
Dialog: 0,0:13:56.66,0:13:59.99, Lalai,,0,0,0,,Saya tidak boleh menyeret semua ini ke kubur.
Dialog: 0,0:14:07.73,0:14:11.34, Lalai,,0,0,0,,Maaf, takkan awak lepaskan saya?
Dialog: 0,0:14:14.01,0:14:16.74,Lalai,,0,0,0,,Tamak adalah tabiat buruk.
Dialog: 0,0:14:28.29,0:14:30.72,Lalai,,0,0,0,,Ayah kamu membuat keputusan penting.
Dialog: 0,0:14:30.79,0:14:31.82, Lalai,,0,0,0,,Dan bukan itu sahaja.
Dialog: 0,0:14:35.33,0:14:37.16,Lalai,,0,0,0,,Anda sedang mencari buku perakaunan.
Dialog: 0,0:14:37.16,0:14:39.50,Lalai,,0,0,0,,Papa ingat semua yang tertulis di dalamnya.
Dialog: 0,0:14:43.67,0:14:45.74,Lalai,,0,0,0,,Bukan menteri, tetapi tikus sampah.
Dialog: 0,0:14:45.74,0:14:48.81,Lalai,Spikyulka2,0,0,0,,Penasihat kiri melakukan penipuan dengan bijirin.
Dialog: 0,0:14:48.98,0:14:51.01,Lalai,Spikyulka2,0,0,0,,Dalam pelbagai cara dia memperuntukkan
Dialog: 0,0:14:51.14,0:14:52.81, Lalai, Spilyk2,0,0,0,, sejumlah besar.
Dialog: 0,0:14:55.58,0:14:58.08,Lalai,Spilyk2,0,0,0,,Ketua penasihat menghangatkan tangannya di atas tanah.
Dialog: 0,0:14:58.08,0:15:01.25,Lalai,Spikyulka2,0,0,0,,Sebagai contoh, dia akan menyelitkan kuari seseorang dan memaksa mereka untuk mengusahakannya,
Dialog: 0,0:15:01.25,0:15:02.76, Lalai, Spikyulka2,0,0,0, dan kemudian menghancurkan anda dengan cukai yang terlalu tinggi.
Dialog: 0,0:15:05.22,0:15:06.39,Lalai,Spikyulka2,0,0,0,,Tiada sesiapa yang tidak mencuri,
Dialog: 0,0:15:06.39,0:15:07.56,Lalai,Spikyulka2,0,0,0,,dan tiada apa-apa yang tidak dicuri.
Dialog: 0,0:15:07.96,0:15:10.03,Lalai,Spikyulka2,0,0,0,,Dan juga rasuah tentera dan pembelian jawatan.
Dialog: 0,0:15:10.70,0:15:12.10,Lalai,Spilyk2,0,0,0,,Daripada menghantar bot dengan garam,
Dialog: 0,0:15:12.10,0:15:13.50,Lalai,Spikyulka2,0,0,0,,mereka mengisinya dengan batu dan menenggelamkannya,
Dialog: 0,0:15:13.50,0:15:15.03,Lalai,Spilyk2,0,0,0,,dan mereka mengambil garam untuk diri mereka sendiri.
Dialog: 0,0:15:15.20,0:15:17.87,Lalai,Spikyulka2,0,0,0,,Helah yang serupa dilakukan dengan hadiah untuk raja.
Dialog: 0,0:15:18.30,0:15:20.24,Lalai,Spikyulka2,0,0,0,,Dan di antara semua ini,\N yang paling membuat saya marah,
Dialog: 0,0:15:20.74,0:15:22.14,Lalai,Spikyulka2,0,0,0,,jadi ini adalah peminjam wang.
Dialog: 0,0:15:22.14,0:15:24.08,Lalai,Spikyulka2,0,0,0,,Mereka menaikkan cukai ke atas petani,
Dialog: 0,0:15:24.08,0:15:25.81,Lalai,Spikyulka2,0,0,0,,dan kemudian meminjamkan wang pada 5%.
Dialog: 0,0:15:25.98,0:15:28.18,Lalai,Spikyulka2,0,0,0,,Jadi hutang akan bertambah dengan setiap nafas.
Dialog: 0,0:15:28.98,0:15:31.82,Lalai,Spilyk2,0,0,0,,Tingkah laku seperti samseng.
Dialog: 0,0:15:31.82,0:15:34.59,Lalai,Spikyulka2,0,0,0,,Memori ayah anda mengenai keuntungan
Dialog: 0,0:15:35.52,0:15:37.09,Lalai,Spillik2,0,0,0,,sangat mengagumkan.
Dialog: 0,0:15:37.66,0:15:40.79,Lalai,Spikyulka2,0,0,0,,By the way, beritahu saya,
Dialog: 0,0:15:40.83,0:15:44.10,Lalai,Spikyulka2,0,0,0,,apa yang anda akan lakukan dengan pemberi maklumat?
Dialog: 0,0:15:45.53,0:15:48.93,Lalai,Spikyulka2,0,0,0,,Ayah kamu ialah tokoh penting dalam semua muslihat ini.
Dialog: 0,0:15:49.74,0:15:51.90,Lalai,Spillik2,0,0,0,,Jenayahnya tidak akan hilang begitu sahaja.
Dialog: 0,0:15:53.41,0:15:55.51,Lalai,Spikyulka2,0,0,0,,-Walau bagaimanapun...\N-Apakah itu "bagaimanapun"?
Dialog: 0,0:15:55.51,0:15:58.44,Lalai,Spikyulka2,0,0,0,,Bagi saya, ayah awak seorang lagi penjenayah rasuah.
Dialog: 0,0:16:01.61,0:16:02.68,Lalai,Spilyk2,0,0,0,,Walau bagaimanapun
Dialog: 0,0:16:04.08,0:16:06.25,Lalai,Spikyulka2,0,0,0,,dia satu-satunya saudara kandung anda.
Dialog: 0,0:16:10.29,0:16:11.86, Lalai,Spillik2,0,0,0,,Bagaimana jika ya?
Dialog: 0,0:16:13.93,0:16:15.06,Lalai,Spikyulka2,0,0,0,,Mereka berkata
Dialog: 0,0:16:15.06,0:16:16.20,Lalai,Spikyulka2,0,0,0,,iaitu banyak merit
Dialog: 0,0:16:16.20,0:16:17.73,Lalai,Spikyulka2,0,0,0,,boleh membenarkan kekurangan.
Dialog: 0,0:16:19.53,0:16:20.67,Lalai,Spillik2,0,0,0,,Adakah dia memerlukan lebih merit?
Dialog: 0,0:16:21.00,0:16:22.07,Lalai,Spillik2,0,0,0,,Sebagai contoh?
Dialog: 0,0:16:22.10,0:16:23.47,Lalai,Spilyk2,0,0,0,,Sebagai contoh,
Dialog: 0,0:16:23.90,0:16:26.51,Lalai,Spikyulka2,0,0,0,,dia boleh membantu mendapatkan bukti.
Dialog: 0,0:16:28.07,0:16:31.14,Lalai,Spikyulka2,0,0,0,,Sukar untuk menghukum mereka dengan hanya lejar.
Dialog: 0,0:16:33.21,0:16:35.15,Lalai,Spikyulka2,0,0,0,,Sebagai balasan anda menjamin perlindungan
Dialog: 0,0:16:35.61,0:16:37.12,Lalai,Spilyk2,0,0,0,,pemaklum.
Dialog: 0,0:16:37.58,0:16:38.65,Lalai,Spillik2,0,0,0,,Sudah tentu.
Dialog: 0,0:16:44.99,0:16:48.09,Lalai,Spikyulka2,0,0,0,,Yang Mulia, sudah tiba masanya untuk majlis diraja.
Dialog: 0,0:16:48.43,0:16:49.60,Lalai,Spillik2,0,0,0,,Baik.
Dialog: 0,0:16:56.27,0:16:57.54,Lalai,Spillik2,0,0,0,,Majlis Diraja?
Dialog: 0,0:16:59.57,0:17:02.98,Lalai,Spikyulka2,0,0,0,,Jika anda ingin membakar sampah, pergi ke tapak pelupusan sampah.
Dialog: 0,0:17:03.91,0:17:05.88,Lalai,Spillik2,0,0,0,,Sahaja, kecuali pemangku raja - permaisuri janda,
Dialog: 0,0:17:06.25,0:17:08.45,Lalai,Spikyulka2,0,0,0,,wanita tidak dibenarkan di sana.
Dialog: 0,0:17:09.15,0:17:11.45,Lalai,Spikyulka2,0,0,0,,Saya melantik abang saya, Putera Yeonpyeong,
Dialog: 0,0:17:11.45,0:17:14.09,Lalai,Spilyk2,0,0,0,,oleh ketua Ijeongcheon.
Dialog: 0,0:17:14.25,0:17:16.22, Lalai, Spikyulka2,0,0,0,,-Anda tidak sepatutnya berbuat demikian.\N-Anda tidak sepatutnya berbuat demikian.
Dialog: 0,0:17:18.06,0:17:19.26,Lalai,Spillik2,0,0,0,,Kenapa ini?
Dialog: 0,0:17:19.26,0:17:22.19,Lalai,Spikyulka2,0,0,0,,Kerja dan tanggungjawab sedemikian terlalu besar
Dialog: 0,0:17:22.19,0:17:25.43,Lalai,Spikyulka2,0,0,0,,untuk lelaki muda yang tidak berpengalaman seperti Putera Yeonpyeong, dia tidak akan dapat mengatasinya.
Dialog: 0,0:17:27.27,0:17:29.44,Lalai,Spikyulka2,0,0,0,,Sebaliknya, dia tidak dikaitkan dengan sesiapa yang berkuasa.
Dialog: 0,0:17:30.60,0:17:34.27,Lalai,Spillie2,0,0,0,,Ini adalah nilai tertinggi untuk menguruskan Ijeongcheon.
Dialog: 0,0:17:35.27,0:17:36.48,Lalai,Spilyk2,0,0,0,,Selain itu,
Dialog: 0,0:17:38.21,0:17:41.85, Lalai, Spikyulka2,0,0,0,, adakah ia kelihatan seperti saya bertanya kepada anda sekarang?
Dialog: 0,0:17:47.52,0:17:49.89,Lalai,Spillik2,0,0,0,,Bakar, Cheoljong.
Dialog: 0,0:17:51.46,0:17:55.49,Lalai,Spikyulka2,0,0,0,,Saya menghantar pemeriksa rahsia kepada Yeungnam.
Dialog: 0,0:17:56.46,0:17:58.06,Lalai,Spikyulka2,0,0,0,,Pelaku salah guna kuasa
Dialog: 0,0:17:58.06,0:17:59.70,Lalai,Spikyulka2,0,0,0,,akan dihukum mengikut undang-undang.
Dialog: 0,0:17:59.70,0:18:01.60,Lalai,Spikyulka2,0,0,0,,Semua yang mereka salah guna,
Dialog: 0,0:18:02.37,0:18:04.40,Lalai,Spikyulka2,0,0,0,,akan digunakan untuk membantu orang ramai.
Dialog: 0,0:18:05.17,0:18:08.81, Lalai, Spikyulka2,0,0,0,,Ini akan menjadi contoh untuk lapan gabenor kami
Dialog: 0,0:18:09.81,0:18:11.31, Lalai, Spikyulka2,0,0,0, dan akan memaksa mereka untuk mengaku.
Dialog: 0,0:18:12.21,0:18:14.31,Lalai,Sutera2,0,0,0,,-Kami membantah, Yang Mulia.\N-Kami membantah, Yang Mulia.
Dialog: 0,0:18:14.55,0:18:19.12,Lalai,Spikyulka2,0,0,0,,Menteri Perang telah pun menghantar pemimpin tentera ke sana.
Dialog: 0,0:18:20.59,0:18:22.82,Lalai,Spikyulka2,0,0,0,,Mereka dihantar tanpa kebenaran saya?
Dialog: 0,0:18:23.12,0:18:24.62,Lalai,Spikyulka2,0,0,0,,Baru-baru ini
Dialog: 0,0:18:24.62,0:18:26.93,Lalai,Spillik2,0,0,0,,insiden dahsyat yang disebabkan oleh pengikut Tonhak,
Dialog: 0,0:18:26.93,0:18:28.79,Lalai,Biryulka2,0,0,0,,mengingatkan kebangkitan yang dahulu
Dialog: 0,0:18:28.79,0:18:31.16,Lalai,Spikyulka2,0,0,0,,mengancam kedaulatan Joseon.
Dialog: 0,0:18:31.53,0:18:34.87,Lalai,Spikyulka2,0,0,0,,Terdapat krisis, dan ia memerlukan penyelesaian pantas.
Dialog: 0,0:18:34.87,0:18:36.94,Lalai,Spikyulka2,0,0,0,,Saya pasti jabatan sempadan melakukan apa yang dikehendakinya.
Dialog: 0,0:18:42.51,0:18:44.58,Lalai,Spikyulka2,0,0,0,,Pengikut Tonghak merusuh
Dialog: 0,0:18:44.58,0:18:46.41,Lalai,Spikyulka2,0,0,0,,dan mengancam penjawat awam.
Dialog: 0,0:18:46.41,0:18:48.78,Lalai,Spikyulka2,0,0,0,,Akhirnya, mereka menyebabkan kemudaratan kepada pegawai.
Dialog: 0,0:18:50.52,0:18:53.65,Lalai,Spikyulka2,0,0,0,,Kami terpaksa cepat menangkap dan menghukum ketua kumpulan itu.
Dialog: 0,0:18:54.19,0:18:56.42,Lalai,Spikyulka2,0,0,0,,Untuk mengelakkan pengulangan,
Dialog: 0,0:18:56.96,0:18:58.62,Lalai,Spikyulka2,0,0,0,,ia adalah perlu untuk menghapuskan punca kejahatan.
Dialog: 0,0:18:59.69,0:19:01.13, Lalai, Spillik2,0,0,0,, Hapuskan punca kejahatan?
Dialog: 0,0:19:01.36,0:19:03.00,Lalai,Spikyulka2,0,0,0,,Kami menangkap, memenjarakan dan menghukum
Dialog: 0,0:19:03.00,0:19:06.97,Default,Spilyk2,0,0,0,,pengikut dan penyebar ajaran Tonhak.
Dialog: 0,0:19:07.97,0:19:10.20,Lalai,Spikyulka2,0,0,0,,Mereka menyalahkan semua masalah Joseon
Dialog: 0,0:19:10.20,0:19:12.00,Lalai,Spillik2,0,0,0,,pada sekumpulan penyamun!
Dialog: 0,0:19:12.51,0:19:14.01,Lalai,Spikyulka2,0,0,0,,Untuk menghapuskan punca sebenar kejahatan,
Dialog: 0,0:19:14.01,0:19:16.84,Lalai,Spikyulka2,0,0,0,,Saya akan membenarkan Ijeongcheon menjalankan siasatan demi kepentingan rakyat!
Dialog: 0,0:19:18.21,0:19:20.38,Lalai,Spillik2,0,0,0,,Duduk di atas takhta
Dialog: 0,0:19:20.38,0:19:22.11,Lalai,Spikyulka2,0,0,0,,intipati orang tidak dapat difahami.
Dialog: 0,0:19:22.85,0:19:25.75,Lalai,Spikyulka2,0,0,0,,Sebaik sahaja anda mula memenuhi tuntutan mereka, ia tidak akan berakhir.
Dialog: 0,0:19:26.42,0:19:28.45,Lalai,Spilyk2,0,0,0,,Kita mesti menindas mereka dengan kekerasan,
Dialog: 0,0:19:29.56,0:19:32.22,Lalai,Spikyulka2,0,0,0,,untuk memastikan pemberontakan tidak berulang.
Dialog: 0,0:19:32.42,0:19:35.06,Lalai,Spikyulka2,0,0,0,,-Kami bersetuju, Yang Mulia.\N-Kami bersetuju, Yang Mulia.
Dialog: 0,0:19:44.54,0:19:46.34,Lalai,Spilyk2,0,0,0,,Saya akan menyemak semua banduan untuk memastikan
Dialog: 0,0:19:47.01,0:19:49.14,Lalai,Spikyulka2,0,0,0,,bahawa di antara mereka tidak ada mangsa yang tidak bersalah dalam pelanggaran undang-undang.
Dialog: 0,0:19:49.91,0:19:52.61,Lalai,Spikyulka2,0,0,0,,Selain itu, saya akan menghukum penyamun dengan berat,
Dialog: 0,0:19:52.61,0:19:54.71,Lalai,Spilyk2,0,0,0,,supaya ada contoh untuk semua orang.
Dialog: 0,0:19:55.41,0:19:57.78,Lalai,Spikyulka2,0,0,0,,Dan saya akan mengarahkan gabenor dan ketua tentera dihukum,
Dialog: 0,0:19:58.58,0:20:00.05,Lalai,Spilyk2,0,0,0,,mereka yang bertanggungjawab atas masalah kita.
Dialog: 0,0:20:15.37,0:20:18.60,Lalai,Spikyulka2,0,0,0,,Mahu menyekat pemberontakan hanya dengan bantuan undang-undang.
Dialog: 0,0:20:20.27,0:20:22.37, Lalai, Spillik2,0,0,0,, Betapa naifnya.
Dialog: 0,0:20:23.84,0:20:25.81,Lalai,Sutera2,0,0,0,,Sebelum pemberontakan menjadi tidak terkawal,
Dialog: 0,0:20:26.08,0:20:29.01,Lalai,Spikyulka2,0,0,0,,Saya akan menghantar tentera dan menundukkan pengikut Tonhak.
Dialog: 0,0:20:31.25,0:20:32.55,Lalai,Spillik2,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:20:32.72,0:20:35.45,Lalai,Spillik2,0,0,0,,Sapukan elixir sebelum muka saya kering.
Dialog: 0,0:20:35.79,0:20:39.53,Lalai,Spikyulka2,0,0,0,,Yang Mulia, sudah berakhir.
Dialog: 0,0:20:43.60,0:20:48.23, Lalai, Spikyulka2,0,0,0,, Patutkah saya meminta permaisuri berbuat lebih banyak?
Dialog: 0,0:20:48.50,0:20:49.77,Lalai,Spillik2,0,0,0,,Tidak berbaloi.
Dialog: 0,0:20:49.77,0:20:51.57,Lalai,Spikyulka2,0,0,0,,Sudah tentu tidak. Lupakan apa yang saya katakan.
Dialog: 0,0:20:51.57,0:20:53.44,Lalai,Spilyk2,0,0,0,,-Anda boleh pergi.\N-Ya.
Dialog: 0,0:21:05.05,0:21:08.29,Lalai,Sutera2,0,0,0,,Masih tidak boleh memaafkan permaisuri?
Dialog: 0,0:21:08.49,0:21:10.42,Lalai,Spilyk2,0,0,0,,Saya akan membaca surat-menyuratnya dengan raja,
Dialog: 0,0:21:10.42,0:21:12.36, Lalai, Spilyk2,0,0,0,, tidak akan bertanya.
Dialog: 0,0:21:12.52,0:21:14.73,Lalai,Spillik2,0,0,0,,Pengampunan tidak akan menyelesaikan masalah.
Dialog: 0,0:21:15.03,0:21:17.70,Lalai,Spillik2,0,0,0,,Tiada apa-apa selain karut dalam surat cinta mereka.
Dialog: 0,0:21:18.63,0:21:20.97,Lalai,Spikyulka2,0,0,0,,Malah mereka mahu memberikan nyawa mereka untuk satu sama lain.
Dialog: 0,0:21:40.89,0:21:42.92,Lalai,Spikyulka2,0,0,0,,Dan ini adalah ganjaran untuk pengabdian saya kepada keluarga anda?
Dialog: 0,0:21:43.22,0:21:45.02,Lalai,Spikyulka2,0,0,0,,Anda membingkai keluarga saya dan kami diusir.
Dialog: 0,0:21:45.02,0:21:46.29,Lalai,Spikyulka2,0,0,0,,Menjadikan kami sebagai pemberontak
Dialog: 0,0:21:46.29,0:21:47.53, Lalai, Spikyulka2,0,0,0, dan dilucutkan masa hadapan.
Dialog: 0,0:21:47.53,0:21:49.80,Lalai,Spikyulka2,0,0,0,,Bagaimana anda boleh menyerahkan kami kepada nasib kami?
Dialog: 0,0:21:51.50,0:21:54.90,Lalai,Spikyulka2,0,0,0,,Anggap diri anda bertuah kerana anda tidak dihukum bunuh.
Dialog: 0,0:21:56.47,0:22:00.21,Lalai,Spillik2,0,0,0,,Sekurang-kurangnya keluarga anda masih hidup.
Dialog: 0,0:22:13.15,0:22:14.95,Lalai,Spillik2,0,0,0,,Mari bekerja untuk saya di istana.
Dialog: 0,0:22:16.49,0:22:17.99,Lalai,Spikyulka2,0,0,0,,Saya akan buktikan,
Dialog: 0,0:22:18.99,0:22:20.96,Lalai,Spilyk2,0,0,0,,bahawa saya berbeza daripada bapa saya.
Dialog: 0,0:22:31.30,0:22:32.40,Lalai,Spillik2,0,0,0,,Arak paling sedap pada siang hari.
Dialog: 0,0:22:32.40,0:22:33.51,Lalai,Spillik2,0,0,0,,Sudah tentu.
Dialog: 0,0:22:35.17,0:22:37.54,Lalai,Spillik2,0,0,0,,Minum di tengah hari.
Dialog: 0,0:22:39.11,0:22:42.41,Lalai,Spillit2,0,0,0,,Oh, udang. Produk yang jarang ditemui.
Dialog: 0,0:22:46.59,0:22:48.82,Lalai,Spilyk2,0,0,0,,-Siapa awak?\N-Siapa awak?
Dialog: 0,0:22:49.22,0:22:51.19,Lalai,Spillik2,0,0,0,,Anda telah minum di sini sepanjang hari.
Dialog: 0,0:22:51.42,0:22:54.19,Lalai,Spilyk2,0,0,0,,Apa? Berani awak cakap macam tu dengan saya?
Dialog: 0,0:22:54.66,0:22:56.53,Lalai,Spilyk2,0,0,0,,Siapakah anda?
Dialog: 0,0:22:57.66,0:22:58.80,Lalai,Spillik2,0,0,0,,Izinkan saya memperkenalkan diri saya.
Dialog: 0,0:23:01.60,0:23:02.74,Lalai,Spillik2,0,0,0,,Ya.
Dialog: 0,0:23:03.44,0:23:04.64,Lalai,Spillik2,0,0,0,,Saya seorang pemeriksa rahsia.
Dialog: 0,0:23:09.31,0:23:10.64, Lalai, Spilyk2,0,0,0,,Oh, begitulah sepatutnya.
Dialog: 0,0:23:14.11,0:23:17.52,Lalai,Spikyulka2,0,0,0,,Saya dengar hari ini terdapat pemeriksa rahsia palsu di sini.
Dialog: 0,0:23:17.52,0:23:19.22,Lalai,Spikyulka2,0,0,0,,Saya tidak membeli helah anda.
Dialog: 0,0:23:20.05,0:23:23.02,Lalai,Spillit2,0,0,0,,Token tidak lagi mempunyai kuasa yang sama seperti sebelumnya.
Dialog: 0,0:23:31.96,0:23:34.87,Lalai,Spikyulka2,0,0,0,,Pemeriksa Rahsia telah tiba.
Dialog: 0,0:23:35.50,0:23:37.47,Lalai,Spillik2,0,0,0,,Maaf.
Dialog: 0,0:23:37.47,0:23:42.04,Lalai,Spikyulka2,0,0,0,,Pada masa kini, pistol berfungsi lebih dipercayai daripada token.
Dialog: 0,0:23:51.08,0:23:52.38,Lalai,Spilyk2,0,0,0,,Ini adalah serpihan.
Dialog: 0,0:23:52.38,0:23:54.52,Lalai,Spilyk2,0,0,0,,Kami lelaki. Kami tidak menghidangkan teh dengan gula-gula.
Dialog: 0,0:23:56.29,0:23:58.49,Lalai,Silk2,0,0,0,,Saya tertanya-tanya kenapa dia memanggil kami.
Dialog: 0,0:23:58.49,0:24:01.73,Lalai,Spillik2,0,0,0,,Raja menggunakan cemeti. Dan ratu adalah roti halia.
Dialog: 0,0:24:02.16,0:24:03.70,Lalai,Spikyulka2,0,0,0,,Mungkin ini rancangan mereka.
Dialog: 0,0:24:05.56,0:24:08.50,Lalai,Sutera2,0,0,0,,Mungkin mahu menunjukkan bahawa kami adalah daripada puak yang sama.
Dialog: 0,0:24:09.30,0:24:10.40, Lalai, Spikyulka2,0,0,0,,Tetapi ini tidak akan berfungsi.
Dialog: 0,0:24:11.00,0:24:13.67,Lalai,Spillik2,0,0,0,,Kita boleh bermain bersama.
Dialog: 0,0:24:14.77,0:24:16.71,Lalai,Spilyk2,0,0,0,,-Sudah tentu.\N-Jom.
Dialog: 0,0:24:21.05,0:24:23.45,Lalai,Spikyulka2,0,0,0,, Agak lama telah berlalu sejak aku menaiki takhta.
Dialog: 0,0:24:23.92,0:24:26.82,Lalai,Sutera2,0,0,0,,Tetapi saya tidak pernah menjemput puak saya ke kenduri itu.
Dialog: 0,0:24:27.89,0:24:29.72,Lalai,Spikyulka2,0,0,0,,Saya sangat sibuk kebelakangan ini.
Dialog: 0,0:24:30.69,0:24:31.99,Lalai,Spikyulka2,0,0,0,,Tolong maafkan saya.
Dialog: 0,0:24:37.03,0:24:39.36,Lalai,Sutera2,0,0,0,,Ia tidak banyak di sini, tetapi saya memasak untuk anda sendiri.
Dialog: 0,0:24:40.60,0:24:41.70,Lalai,Spillik2,0,0,0,,Nikmati.
Dialog: 0,0:24:51.84,0:24:54.45,Lalai,Spikyulka2,0,0,0,,Ini wain, bukan teh.
Dialog: 0,0:24:55.85,0:24:57.32, Lalai, Spillik2,0,0,0,, Berpura-pura itu teh.
Dialog: 0,0:24:57.32,0:24:59.52,Lalai,Spillik2,0,0,0,,Raja memerintahkan untuk mengurangkan bilangan hidangan.
Dialog: 0,0:24:59.65,0:25:02.25,Lalai,Spikyulka2,0,0,0,,Bagaimana lagi subjeknya boleh berkumpul dan minum?
Dialog: 0,0:25:02.55,0:25:03.69,Lalai,Spikyulka2,0,0,0,,Tetapi jika dia tahu...
Dialog: 0,0:25:15.03,0:25:18.20,Lalai,Spikyulka2,0,0,0,,Anda menipu kami, Yang Mulia.
Dialog: 0,0:25:18.74,0:25:21.04,Lalai,Spilyk2,0,0,0,,Adakah anda menyediakan kami?
Dialog: 0,0:25:21.14,0:25:23.14,Lalai,Spillik2,0,0,0,,-Luar biasa.\N-Bagaimana dia boleh?
Dialog: 0,0:25:25.38,0:25:28.11,Lalai,Spillik2,0,0,0,,Berhenti membuat saya marah. Merosakkan mood.
Dialog: 0,0:25:28.85,0:25:31.15,Lalai,Spikyulka2,0,0,0,,Tetapi anda membuat kami marah.
Dialog: 0,0:25:31.15,0:25:34.62,Lalai,Spillik2,0,0,0,,Apa? Awak bawa kami untuk siapa?
Dialog: 0,0:25:36.02,0:25:39.79,Lalai,Spilyk2,0,0,0,,Saya tahu siapa anda.
Dialog: 0,0:25:41.56,0:25:43.90,Lalai,Spikyulka2,0,0,0,,Anda adalah kejahatan masyarakat ini.
Dialog: 0,0:25:44.60,0:25:46.83,Lalai,Spillik2,0,0,0,,-Jahat?\N-Jahat?
Dialog: 0,0:25:48.33,0:25:53.01,Lalai,Spikyulka2,0,0,0,,Dalam bahasa anda - anda adalah wabak zaman ini.
Dialog: 0,0:25:53.01,0:25:54.81,Lalai,Spillik2,0,0,0,,-Apa?\N-Apa?
Dialog: 0,0:25:54.81,0:25:57.34,Lalai,Spikyulka2,0,0,0,,Mengapa kita perlu bertolak ansur dengan perlakuan sedemikian?
Dialog: 0,0:25:57.68,0:25:58.84,Lalai,Spillik2,0,0,0,,Meninggalkan.
Dialog: 0,0:25:59.48,0:26:01.31, Lalai, Spilyk2,0,0,0,,Mengapa anda mengatur ini untuk kami?
Dialog: 0,0:26:02.41,0:26:04.52,Lalai,Spilyk2,0,0,0,,Soalan yang bagus. Senang awak bertanya.
Dialog: 0,0:26:05.18,0:26:07.62,Lalai,Spikyulka2,0,0,0,,Tidak hairanlah ketua penasihat, anda sangat bijak.
Dialog: 0,0:26:07.62,0:26:08.75,Lalai,Spilyk2,0,0,0,,Apa...
Dialog: 0,0:26:09.66,0:26:11.66,Lalai,Spikyulka2,0,0,0,,Adakah anda bertanya mengapa saya mengatur ini?
Dialog: 0,0:26:12.82,0:26:17.66,Lalai,Spikyulka2,0,0,0,,Saya cuba memberitahu anda untuk tidak menghalang raja.
Dialog: 0,0:26:19.60,0:26:23.17,Lalai,Spikyulka2,0,0,0,,Anda akan menentang ideanya,
Dialog: 0,0:26:23.87,0:26:27.07,Lalai,Spikyulka2,0,0,0,,maklumlah saya akan datang dari belakang dan sekali gus
Dialog: 0,0:26:27.07,0:26:29.47,Lalai,Spilyk2,0,0,0,,Saya akan bunuh semua orang.
Dialog: 0,0:26:30.71,0:26:31.94,Lalai,Spillik2,0,0,0,,Pertimbangkan anda memberi amaran.
Dialog: 0,0:26:40.25,0:26:42.02,Lalai,Spikyulka2,0,0,0,,Jika matlamat anda adalah untuk mencipta pelanggaran undang-undang,
Dialog: 0,0:26:42.02,0:26:44.19,Lalai,Spilyk2,0,0,0,,bersembunyi di belakang klan,
Dialog: 0,0:26:45.69,0:26:48.29,Lalai,Spilyk2,0,0,0,,berjaga-jaga.
Dialog: 0,0:26:49.06,0:26:51.06,Lalai,Spikyulka2,0,0,0,,Ratu, anda juga salah seorang Kim Andonian.
Dialog: 0,0:26:51.06,0:26:53.80,Lalai,Biryulka2,0,0,0,,Jadi saya memutuskan untuk menukar nama keluarga saya.
Dialog: 0,0:26:53.80,0:26:56.47,Lalai,Spikyulka2,0,0,0,,Sekarang saya bukan Kim So-yeon. Saya Chan Soyeon.
Dialog: 0,0:26:56.47,0:26:59.17,Lalai,Spikyulka2,0,0,0,,-Apa?\N-Apa kejadahnya...
Dialog: 0,0:27:01.14,0:27:04.38,Lalai,Spikyulka2,0,0,0,,Saya rasa mereka sangat padat, kerana puak membantu mereka mendapat jawatan.
Dialog: 0,0:27:04.38,0:27:05.61,Lalai,Spillik2,0,0,0,,Pukul hidung anda.
Dialog: 0,0:27:05.61,0:27:07.45,Lalai,Spikyulka2,0,0,0,,Tiada bantahan lagi.
Dialog: 0,0:27:07.81,0:27:09.72,Lalai,Spikyulka2,0,0,0,,Tiada pertikaian. Tiada pakatan sulit.
Dialog: 0,0:27:09.72,0:27:11.18,Lalai,Spilyk2,0,0,0,,Tiada perjalanan ke Okthajeong.
Dialog: 0,0:27:11.18,0:27:13.25,Lalai,Spikyulka2,0,0,0,,Apakah kaitan Okthajon dengannya?
Dialog: 0,0:27:14.52,0:27:15.82,Lalai,Spilyk2,0,0,0,,Saya tidak boleh pergi.
Dialog: 0,0:27:18.02,0:27:20.87,Lalai,Lily,0,0,0,,Perintah telah dijalankan tanpa sebarang masalah.
Dialog: 0,0:27:22.17,0:27:26.61,Lalai,Lily,0,0,0,,Permaisuri Janda yang menjaganya.
Dialog: 0,0:27:29.00,0:27:31.43,Lalai,Lily,0,0,0,,Saya datang hari ini dengan permintaan.
Dialog: 0,0:27:32.81,0:27:35.31,Lalai,Lily,0,0,0,,Sekarang anda telah bersatu dengan puak saya,
Dialog: 0,0:27:35.31,0:27:38.62,Lalai,Lily,0,0,0,,jangan mengancam atau membahayakan permaisuri lagi,
Dialog: 0,0:27:38.74,0:27:40.24,Lalai,Lily,0,0,0,,dia juga dari puak kami.
Dialog: 0,0:27:43.28,0:27:45.16,Lalai,Lily,0,0,0,,Musuh kita ialah raja.
Dialog: 0,0:27:46.42,0:27:50.63,Lalai,Lily,0,0,0,,Mengancam satu sama lain dengan pedang,\Nkami hanya akan membantu musuh.
Dialog: 0,0:27:51.86,0:27:53.67,Lalai,Lily,0,0,0,,Saya setuju.
Dialog: 0,0:27:53.67,0:27:57.80,Lalai,Lily,0,0,0,,Tiada lagi ritual dukun dan azimat. Saya meninggalkan mereka.
Dialog: 0,0:28:01.93,0:28:05.31,Lalai,Lily,0,0,0,,-Yang Mulia.\N-Saya ada sesuatu nak beritahu awak.
Dialog: 0,0:28:16.62,0:28:18.82,Lalai,Lily,0,0,0,,Ya, saya patut membaca buku kali ini,
Dialog: 0,0:28:18.82,0:28:20.39, Lalai, Lily,0,0,0,,untuk lebih memahami bahasa.
Dialog: 0,0:28:20.83,0:28:23.13,Lalai,Lily,0,0,0,,Sukar untuk bersumpah dengan cara yang mesra.
Dialog: 0,0:28:24.02,0:28:27.46,Lalai,Lily,0,0,0,,Di manakah saya boleh membaca tentang perkataan slanga Joseon?
Dialog: 0,0:28:27.46,0:28:30.43,Lalai,Lily,0,0,0,,Tiada buku sedemikian dalam perpustakaan ini.
Dialog: 0,0:28:30.80,0:28:31.96,Lalai,Lily,0,0,0,,Di mana?
Dialog: 0,0:28:32.14,0:28:34.64,Lalai,Lily,0,0,0,,Berbalik kepada novel,
Dialog: 0,0:28:34.64,0:28:36.77,Lalai,Lily,0,0,0,,dijual di kedai di luar istana.
Dialog: 0,0:28:38.00,0:28:39.20,Lalai,Lily,0,0,0,,Apa yang mereka bincangkan?
Dialog: 0,0:28:39.97,0:28:43.88,Lalai,Lily,0,0,0,,Saya mendengar tentang mereka. Tetapi saya tidak pernah membacanya.
Dialog: 0,0:28:44.82,0:28:46.24,Lalai,Lily,0,0,0,,Saya tahu beberapa.
Dialog: 0,0:28:47.71,0:28:49.18,Lalai,Lily,0,0,0,,Tentang isteri yang setia,
Dialog: 0,0:28:49.18,0:28:51.01, Lalai, Lilia,0,0,0,,mati selepas pengkhianatan suaminya.
Dialog: 0,0:28:51.01,0:28:53.56,Lalai,Lily,0,0,0,,Rohnya kembali dengan tahi lalat berhampiran mulutnya,
Dialog: 0,0:28:53.56,0:28:54.98,Lalai,Lily,0,0,0,,untuk membalas dendam.
Dialog: 0,0:28:56.16,0:28:57.80,Lalai,Lily,0,0,0,,Cerita yang biasa.
Dialog: 0,0:28:57.86,0:28:59.06,Lalai,Lily,0,0,0,,Apakah nama buku itu?
Dialog: 0,0:28:59.13,0:29:00.49,Lalai,Lily,0,0,0,,"Godaan isteri."
Dialog: 0,0:29:01.90,0:29:02.99, Lalai, Lily,0,0,0,, Anda tidak membaca.
Dialog: 0,0:29:03.10,0:29:06.10,Lalai,Lily,0,0,0,,Saya hanya tahu namanya.
Dialog: 0,0:29:07.70,0:29:09.41,Lalai,Lily,0,0,0,,Dan juga? apa lagi?
Dialog: 0,0:29:09.67,0:29:11.00,Lalai,Lily,0,0,0,,Yang ini keluar baru-baru ini.
Dialog: 0,0:29:11.00,0:29:12.64,Lalai,Lily,0,0,0,,Tentang wanita mulia itu.
Dialog: 0,0:29:12.64,0:29:15.67,Lalai,Lilia,0,0,0,,Suaminya memulakan hubungan sulit dengan anak perempuan jiran.
Dialog: 0,0:29:15.67,0:29:17.32,Lalai,Lily,0,0,0,,"Dunia pasangan suami isteri."
Dialog: 0,0:29:19.38,0:29:22.24,Lalai,Lily,0,0,0,,Puan Choi, kenapa awak risau sangat, belum baca?
Dialog: 0,0:29:23.12,0:29:24.56,Lalai,Lily,0,0,0,,Maaf.
Dialog: 0,0:29:26.42,0:29:29.45,Lalai,Lily,0,0,0,,Semua wanita bertindak balas dengan cara yang sama terhadap cerita sedemikian.
Dialog: 0,0:29:35.72,0:29:37.19,Lalai,Lily,0,0,0,,Mengapa anda melakukan ini?
Dialog: 0,0:29:38.46,0:29:39.76,Lalai,Lily,0,0,0,,Tinggalkan kami.
Dialog: 0,0:29:42.07,0:29:43.14,Lalai,Lily,0,0,0,,Ya.
Dialog: 0,0:29:49.44,0:29:52.62,Lalai,Lily,0,0,0,,Anda memerlukan sokongan klan untuk memastikan keselamatan anda.
Dialog: 0,0:29:53.05,0:29:55.12,Lalai,Lily,0,0,0,,Mengapa merosakkan hubungan anda dengan mereka?
Dialog: 0,0:29:55.51,0:29:56.95,Lalai,Lily,0,0,0,,Nampaknya awak terlupa,
Dialog: 0,0:29:56.98,0:29:59.45,Lalai,Lily,0,0,0,,bahawa lelaki tua ini cuba membunuh saya.
Dialog: 0,0:29:59.45,0:30:01.72,Lalai,Lily,0,0,0,,Saya melakukan yang terbaik untuk membina jambatan,
Dialog: 0,0:30:01.72,0:30:03.45, Lalai, Lily,0,0,0,, supaya anda boleh kembali.
Dialog: 0,0:30:03.45,0:30:05.13, Lalai, Lily,0,0,0,,Saya tidak mahu kembali.
Dialog: 0,0:30:06.49,0:30:07.96,Lalai,Lily,0,0,0,,Saya cuba yang terbaik,
Dialog: 0,0:30:07.96,0:30:10.46,Lalai,Lily,0,0,0,,untuk memikat Ratu Janda.
Dialog: 0,0:30:10.46,0:30:12.93, Lalai, Lily,0,0,0,,Saya tidak bekerja keras walaupun di Blue House.
Dialog: 0,0:30:14.73,0:30:16.20,Lalai,Lily,0,0,0,,Dan apakah yang saya dapat sebagai balasan?
Dialog: 0,0:30:16.58,0:30:17.70,Lalai,Lily,0,0,0,,Ais beracun.
Dialog: 0,0:30:17.70,0:30:19.85,Lalai,Lily,0,0,0,,Ini kerana khabar angin yang disebarkan oleh puak Cho.
Dialog: 0,0:30:20.55,0:30:22.74,Lalai,Lily,0,0,0,,Saya akan pastikan awak selamat.
Dialog: 0,0:30:23.27,0:30:24.97,Lalai,Lily,0,0,0,,Mari kita jelaskan.
Dialog: 0,0:30:24.97,0:30:26.94,Lalai,Lily,0,0,0,,Lebih baik lebih awal daripada kemudian.
Dialog: 0,0:30:28.01,0:30:30.39,Lalai,Lily,0,0,0,,Saya tidak akan membalas perasaan awak
Dialog: 0,0:30:30.39,0:30:32.28, Lalai, Lily,0,0,0,, dan saya tidak boleh menggunakannya.
Dialog: 0,0:30:32.78,0:30:33.86,Lalai,Lily,0,0,0,,I
Dialog: 0,0:30:35.56,0:30:37.42,Lalai,Lily,0,0,0,,memilih laluan berbeza,
Dialog: 0,0:30:37.80,0:30:39.90,Lalai,Lily,0,0,0,,lebih baik kita masing-masing ikut cara kita sendiri.
Dialog: 0,0:30:43.84,0:30:45.87,Lalai,Lily,0,0,0,,Saya milik Tuanku.
Dialog: 0,0:30:51.97,0:30:53.85,Lalai,Lily,0,0,0,,Kenapa raja?
Dialog: 0,0:30:54.41,0:30:57.12,Lalai,Lily,0,0,0,,Jika dia hilang, saya akan lakukan segala-galanya,
Dialog: 0,0:30:57.12,0:30:59.58,Lalai,Lily,0,0,0,,apa sahaja yang anda minta. Kenapa dia?
Dialog: 0,0:31:04.82,0:31:06.72,Lalai,Lily,0,0,0,,Ini bukan tentang dia.
Dialog: 0,0:31:07.89,0:31:09.92,Lalai,Lily,0,0,0,,Saya tidak ada perasaan pada awak.
Dialog: 0,0:31:23.03,0:31:25.31,Lalai,Lily,0,0,0,,Jangan lepaskan tangan saya, Soyeon.
Dialog: 0,0:31:28.11,0:31:29.88,Lalai,Lily,0,0,0,,Anda adalah segala-galanya bagi saya.
Dialog: 0,0:32:11.71,0:32:13.45,Lalai,Lily,0,0,0,,Anda mesti menggambarkan
Dialog: 0,0:32:13.45,0:32:15.18,Lalai,Lily,0,0,0,,setiap butiran, setiap helaian rambut.
Dialog: 0,0:32:16.25,0:32:18.13,Lalai,Lily,0,0,0,,Cerminkan bukan sahaja penampilan,
Dialog: 0,0:32:18.13,0:32:19.66,Lalai,Lily,0,0,0,,tetapi juga kekuatan dan maruah dalaman.
Dialog: 0,0:32:19.66,0:32:21.80,Lalai,Lily,0,0,0,,Jangan gunakan gaya anda sendiri.
Dialog: 0,0:32:31.17,0:32:32.27,Lalai,Lily,0,0,0,,Permaisuriku.
Dialog: 0,0:32:33.24,0:32:35.11,Lalai,Lily,0,0,0,,Adakah anda bimbang tentang sesuatu?
Dialog: 0,0:32:36.31,0:32:37.55, Lalai, Lily,0,0,0,,Tidak, saya tidak akan katakan.
Dialog: 0,0:32:39.27,0:32:41.18,Lalai,Lily,0,0,0,,Saya berasa teruk.
Dialog: 0,0:32:44.51,0:32:45.75,Lalai,Lily,0,0,0,,Permaisuriku.
Dialog: 0,0:32:50.10,0:32:51.40,Lalai,Lily,0,0,0,,Apa yang berlaku kepada anda?
Dialog: 0,0:32:52.90,0:32:55.67,Lalai,Lily,0,0,0,,Apabila saya tersenyum seperti itu, suara saya seperti raja.
Dialog: 0,0:32:55.67,0:32:58.99,Lalai,Lily,0,0,0,,Dan apabila mata melintas, suara itu kedengaran seperti sida-sida.
Dialog: 0,0:33:03.88,0:33:05.27,Lalai,Lily,0,0,0,,Tidak kelakar?
Dialog: 0,0:33:05.97,0:33:09.24,Lalai,Lily,0,0,0,,Sangat sukar untuk membuat anda ketawa.
Dialog: 0,0:33:09.58,0:33:10.67,Lalai,Lily,0,0,0,,Kemudian...
Dialog: 0,0:33:11.55,0:33:14.35,Lalai,Lily,0,0,0,,Apabila saya menunduk, saya bercakap seperti seorang hamba.
Dialog: 0,0:33:14.35,0:33:17.92,Lalai,Lily,0,0,0,,Dan apabila saya menegakkan badan, saya bercakap seperti seorang pahlawan.
Dialog: 0,0:33:17.92,0:33:19.39,Lalai,Lily,0,0,0,,Tidak kelakar?
Dialog: 0,0:33:27.83,0:33:29.13,Lalai,Lily,0,0,0,,Awak ketawa.
Dialog: 0,0:33:30.23,0:33:31.37,Lalai,Lily,0,0,0,,Yang Mulia.
Dialog: 0,0:33:31.69,0:33:34.00,Lalai,Lily,0,0,0,,-Ambil pose anda.\N-Baiklah.
Dialog: 0,0:33:35.11,0:33:36.73,Lalai,Lily,0,0,0,,Nanti saya ketawakan awak.
Dialog: 0,0:33:39.31,0:33:42.08,Lalai,Lily,0,0,0,,By the way, kenapa anda perlukan potret ini?
Dialog: 0,0:33:42.08,0:33:44.35,Lalai,Lily,0,0,0,,Menurut peraturan “Cho” dan “Chon”,
Dialog: 0,0:33:44.35,0:33:46.65,Lalai,Lily,0,0,0,,Raja Seongjong akan dipanggil Sunjo dengan penghormatan,
Dialog: 0,0:33:48.65,0:33:51.21,Lalai,Lily,0,0,0,,yang bermaksud mereka akan menghormati saya juga,
Dialog: 0,0:33:51.21,0:33:52.75, Lalai, Lily,0,0,0,, kerana ingin menghormati ingatannya.
Dialog: 0,0:33:52.75,0:33:55.16,Lalai,Lily,0,0,0,,Peraturan "Cho" dan "Chon"...
Dialog: 0,0:33:55.33,0:33:57.66,Lalai,Lily,0,0,0,,Saya mendengar tentang dia.
Dialog: 0,0:33:57.92,0:34:00.26,Lalai,Lily,0,0,0,,Apabila memilih nama anumerta raja
Dialog: 0,0:34:00.26,0:34:02.72,Lalai,Lily,0,0,0,,"Cho" digunakan untuk mereka yang telah membuat sumbangan besar,
Dialog: 0,0:34:02.72,0:34:05.19,Lalai,Lily,0,0,0,,dan “Chon” adalah untuk mereka yang terkenal dengan kebaikan.
Dialog: 0,0:34:06.34,0:34:07.74,Lalai,Lily,0,0,0,,Tepat sekali, sekarang saya ingat.
Dialog: 0,0:34:13.70,0:34:15.78,Lalai,Lily,0,0,0,,Yang Mulia, saya membawa apa yang tuan minta.
Dialog: 0,0:34:16.68,0:34:18.34,Lalai,Lily,0,0,0,,Mari kita lihat.
Dialog: 0,0:34:26.32,0:34:28.13,Lalai,Lily,0,0,0,,Nampak keren.
Dialog: 0,0:34:28.13,0:34:30.09,Lalai,Lily,0,0,0,,Adakah anda mahu belajar lawan pedang?
Dialog: 0,0:34:30.40,0:34:31.72,Lalai,Lily,0,0,0,,Saya sihat.
Dialog: 0,0:34:32.36,0:34:34.47,Lalai,Lily,0,0,0,,Saya tidak perlu belajar pun.
Dialog: 0,0:34:34.67,0:34:36.59,Lalai,Lily,0,0,0,,Saya yang terbaik dengan pisau.
Dialog: 0,0:34:37.20,0:34:41.76,Lalai,Lily,0,0,0,,Ini adalah hadiah untuk orang istimewa.
Dialog: 0,0:34:43.61,0:34:44.88, Lalai, Lily,0,0,0,, Istimewa?
Dialog: 0,0:35:07.26,0:35:08.59, Lalai, Lily,0,0,0,, Giliran saya?
Dialog: 0,0:35:08.97,0:35:10.43,Lalai,Lily,0,0,0,,Jadi anda sedang menunggu untuk ini?
Dialog: 0,0:35:10.67,0:35:12.07,Lalai,Lily,0,0,0,,Nah, maaf.
Dialog: 0,0:35:12.40,0:35:14.51,Lalai,Lily,0,0,0,,Anda telah ditendang keluar,
Dialog: 0,0:35:14.51,0:35:17.03, Lalai, Lily,0,0,0,,Saya tidak pasti ia berbaloi untuk bermain-main dengan anda.
Dialog: 0,0:35:17.97,0:35:19.18,Lalai,Lily,0,0,0,,Lucu.
Dialog: 0,0:35:20.28,0:35:21.95,Lalai,Lily,0,0,0,,Anda mencadangkan satu pakatan,
Dialog: 0,0:35:21.95,0:35:23.61,Lalai,Lily,0,0,0,,tetapi mereka pergi tanpa mengucapkan selamat tinggal.
Dialog: 0,0:35:23.68,0:35:25.92,Lalai,Lily,0,0,0,,Anda tidak dapat mengawal suami anda.
Dialog: 0,0:35:25.92,0:35:28.82, Lalai, Lily,0,0,0,, Jadi anda tidak memastikan keselamatan saya?
Dialog: 0,0:35:32.22,0:35:34.26,Lalai,Lily,0,0,0,,Anda lihat, saya ada rancangan.
Dialog: 0,0:35:34.26,0:35:36.22,Lalai,Lily,0,0,0,,Sehingga awak mencabar saya.
Dialog: 0,0:35:36.59,0:35:38.43,Lalai,Lily,0,0,0,,Apa gunanya?
Dialog: 0,0:35:38.43,0:35:40.97, Lalai, Lily,0,0,0,, Jalani kehidupan yang tenang dan membosankan.
Dialog: 0,0:35:44.63,0:35:45.86,Lalai,Lily,0,0,0,,Luncurkan pedang anda.
Dialog: 0,0:35:47.80,0:35:50.51,Lalai,Lily,0,0,0,,Saya tidak melawan wanita.
Dialog: 0,0:35:52.80,0:35:55.68,Lalai,Lily,0,0,0,,Ini adalah hadiah mengenai penyingkiran daripada jawatan.
Dialog: 0,0:35:57.11,0:36:01.28, Lalai, Lily,0,0,0,,Semua pencapaian anda ditanda pada bilah,
Dialog: 0,0:36:02.22,0:36:03.51,Lalai,Lily,0,0,0,,lihat.
Dialog: 0,0:36:11.82,0:36:15.22,Lalai,Lily,0,0,0,,Inilah kehidupan yang anda jalani.
Dialog: 0,0:36:17.09,0:36:18.57,Lalai,Lily,0,0,0,,Awak cakap saya tak kisah apa-apa
Dialog: 0,0:36:19.09,0:36:22.61,Lalai,Lily,0,0,0,,tidak mampu, kerana saya seorang wanita, bukan seorang ratu.
Dialog: 0,0:36:23.84,0:36:26.47,Lalai,Lily,0,0,0,,Tunggu. Saya akan tunjukkan kebolehan saya.
Dialog: 0,0:36:27.78,0:36:30.32,Lalai,Lily,0,0,0,,Tiada lagi halangan kepada perkataan atau perbuatan saya,
Dialog: 0,0:36:30.65,0:36:32.18,Lalai,Lily,0,0,0,,kerana saya tiada apa-apa kerugian.
Dialog: 0,0:36:49.20,0:36:52.20,Lalai,Lily,0,0,0,,Yang Mulia, gundik utama telah tiba.
Dialog: 0,0:36:53.43,0:36:54.63,Lalai,Lily,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:37:08.84,0:37:10.26,Lalai,Lily,0,0,0,,Apakah perasaan anda?
Dialog: 0,0:37:13.05,0:37:16.05,Lalai,Lily,0,0,0,,Saya menyusun fikiran saya semasa saya merakam dengan busur.
Dialog: 0,0:37:16.05,0:37:17.82,Lalai,Lily,0,0,0,,Mendapat ketenangan.
Dialog: 0,0:37:19.05,0:37:20.13, Lalai, Lily,0,0,0,, Gembira mendengarnya.
Dialog: 0,0:37:21.90,0:37:24.09,Lalai,Lily,0,0,0,,Sudah lewat, dan anda masih mempunyai banyak kerja untuk dilakukan.
Dialog: 0,0:37:24.09,0:37:26.13,Lalai,Lily,0,0,0,,Jangan risau.
Dialog: 0,0:37:32.84,0:37:34.34,Lalai,Lily,0,0,0,,Arahan awal untuk kanak-kanak
Dialog: 0,0:37:47.49,0:37:50.32,Lalai,Lily,0,0,0,,Jika saya tahu betapa anda akan menghargai buku ini,
Dialog: 0,0:37:50.80,0:37:52.49,Lalai,Lily,0,0,0,,Saya akan cuba biarkan ia bersih.
Dialog: 0,0:37:53.49,0:37:54.93,Lalai,Lily,0,0,0,,Lihat coretan ini.
Dialog: 0,0:38:02.80,0:38:05.53,Lalai,Lily,0,0,0,,Nampaknya anda sibuk. Saya telah mengambil terlalu banyak masa.
Dialog: 0,0:38:05.53,0:38:06.63,Lalai,Lily,0,0,0,,Saya akan pergi.
Dialog: 0,0:38:12.22,0:38:13.28,Lalai,Lily,0,0,0,,Selir.
Dialog: 0,0:38:15.49,0:38:17.82,Lalai,Lily,0,0,0,,Saya tidak sempat untuk mengatakan sesuatu.
Dialog: 0,0:38:20.26,0:38:21.72,Lalai,Lily,0,0,0,,Saya sukakan awak
Dialog: 0,0:38:23.38,0:38:25.45,Lalai,Lily,0,0,0,,bukan sahaja kerana mesyuarat di perigi
Dialog: 0,0:38:25.45,0:38:27.43,Lalai,Lily,0,0,0,,lapan tahun lalu.
Dialog: 0,0:38:28.53,0:38:30.63,Lalai,Lily,0,0,0,,Apabila saya kembali ke Hanyang dan bertemu dengan awak,
Dialog: 0,0:38:31.86,0:38:33.26,Lalai,Lily,0,0,0,,Saya sukakan awak.
Dialog: 0,0:38:38.34,0:38:40.80,Lalai,Lily,0,0,0,,Yang Mulia, Putera Yeonpyeong telah tiba.
Dialog: 0,0:38:46.47,0:38:48.74,Lalai,Lily,0,0,0,,Tidak tahu anda berada di sini.
Dialog: 0,0:38:48.92,0:38:50.28,Lalai,Lily,0,0,0,,Saya hendak pergi.
Dialog: 0,0:38:51.68,0:38:53.18,Lalai,Lily,0,0,0,,Saya akan tinggalkan awak.
Dialog: 0,0:39:06.24,0:39:08.40,Lalai,Lily,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:39:11.18,0:39:13.34,Lalai,Lily,0,0,0,,Berpaling daripada kebenaran yang tiada siapa perlukan,
Dialog: 0,0:39:14.97,0:39:16.70,Lalai,Lily,0,0,0,,akan lebih betul.
Dialog: 0,0:39:47.45,0:39:49.40,Lalai,Lily,0,0,0,,Mata penuh ghairah.
Dialog: 0,0:39:51.11,0:39:53.88,Lalai,Lily,0,0,0,,Sangat ghairah tentang sains sosial.
Dialog: 0,0:39:58.76,0:40:00.88,Lalai,Lily,0,0,0,,Anda telah menunggu pelajaran saya sepanjang hari.
Dialog: 0,0:40:01.32,0:40:04.13,Lalai,Lily,0,0,0,,Saya tidak percaya anda, tetapi anda boleh tahu
Dialog: 0,0:40:04.13,0:40:05.90,Lalai,Lily,0,0,0,,cerita tentang masa depan, seperti malam tadi.
Dialog: 0,0:40:06.59,0:40:07.97,Lalai,Lily,0,0,0,,Topik pelajaran untuk hari ini.
Dialog: 0,0:40:26.18,0:40:27.49,Lalai,Lily,0,0,0,,Raja berperlembagaan.
Dialog: 0,0:40:28.92,0:40:30.32,Lalai,Lily,0,0,0,,Raja berperlembagaan?
Dialog: 0,0:40:30.65,0:40:32.68,Lalai,Lily,0,0,0,,Ada raja, tetapi mereka tidak memerintah rakyat.
Dialog: 0,0:40:33.99,0:40:37.09,Lalai,Lily,0,0,0,,Pemerintah wujud, tetapi rakyat juga mempunyai kuasa.
Dialog: 0,0:40:40.03,0:40:41.49,Lalai,Lily,0,0,0,,Terdapat sebuah negara bernama Bhutan.
Dialog: 0,0:40:41.90,0:40:43.63, Lalai,Lily,0,0,0,,Nama pelik untuk sesebuah negara.
Dialog: 0,0:40:43.86,0:40:46.67,Lalai,Lily,0,0,0,,Ada seorang raja dengan nama yang lebih asing lagi, Jigme Khesar.
Dialog: 0,0:40:46.97,0:40:49.43,Lalai,Lily,0,0,0,,Dulu ada monarki mutlak, seperti di Joseon.
Dialog: 0,0:40:49.43,0:40:51.11,Lalai,Lily,0,0,0,,Tetapi dia menukarnya kepada raja berperlembagaan.
Dialog: 0,0:40:51.51,0:40:52.61,Lalai,Lily,0,0,0,,Kenapa?
Dialog: 0,0:40:53.11,0:40:55.84,Lalai,Lily,0,0,0,,Dia takut orang zalim boleh naik takhta,
Dialog: 0,0:40:55.84,0:40:57.28,Lalai,Lily,0,0,0,,yang akan memusnahkan negara.
Dialog: 0,0:40:57.92,0:41:00.18,Default,Lily,0,0,0,,Jadi dia memperkenalkan sistem perlembagaan.
Dialog: 0,0:41:00.45,0:41:02.09,Lalai,Lily,0,0,0,,Dia memerintah negara berdasarkan undang-undang.
Dialog: 0,0:41:02.22,0:41:04.26,Lalai,Lily,0,0,0,,Jadi kerajaan itu hanyalah simbol.
Dialog: 0,0:41:04.68,0:41:07.18,Lalai,Lily,0,0,0,,Jigme Khesar bijak.
Dialog: 0,0:41:08.22,0:41:10.49,Lalai,Lily,0,0,0,,Apakah aksara Cina yang dia gunakan untuk menulis “Ji”?
Dialog: 0,0:41:28.90,0:41:31.45,Lalai,Lily,0,0,0,,Masa untuk pulang.
Dialog: 0,0:41:32.74,0:41:33.78, Lalai, Lily,0,0,0,, Pulang ke rumah?
Dialog: 0,0:41:34.88,0:41:35.92,Lalai,Lily,0,0,0,,Di manakah ini?
Dialog: 0,0:41:35.92,0:41:40.18, Lalai, Lily,0,0,0,, Kawan, kamu sudah terlalu banyak minum.
Dialog: 0,0:41:40.18,0:41:41.63,Lalai,Lily,0,0,0,,Terlupa di mana rumah anda.
Dialog: 0,0:41:42.68,0:41:45.03,Lalai,Lily,0,0,0,,Anda tahu apa? Saya sudah cukup.
Dialog: 0,0:41:45.03,0:41:48.20,Lalai,Lily,0,0,0,,Saya perlu pulang dan berehat.
Dialog: 0,0:41:56.17,0:41:57.74,Lalai,Lily,0,0,0,,Saya tidak mempunyai rumah.
Dialog: 0,0:42:00.70,0:42:02.15,Lalai,Lily,0,0,0,,Saya tidak mempunyai apa-apa.
Dialog: 0,0:42:05.61,0:42:09.34,Lalai,Lily,0,0,0,,Saya tiada tempat untuk pergi, saya tiada apa-apa.
Dialog: 0,0:42:11.68,0:42:13.99,Lalai,Lily,0,0,0,,Saya tidak mempunyai apa-apa.
Dialog: 0,0:42:29.24,0:42:33.57,Lalai,peringkat 4,0,0,0,,Saya suka awak \Nbukan sahaja kerana mesyuarat di perigi
Dialog: 0,0:42:33.57,0:42:35.51,Lalai,peringkat 4,0,0,0,,lapan tahun lalu.
Dialog: 0,0:42:37.28,0:42:38.32,Lalai,peringkat 4,0,0,0,,No.
Dialog: 0,0:42:40.01,0:42:41.78, Lalai, peringkat 4,0,0,0,,Dia tidak dapat mengetahui kebenarannya.
Dialog: 0,0:42:52.86,0:42:55.09,Lalai,peringkat 4,0,0,0,,Anda tidak boleh masuk.
Dialog: 0,0:42:55.09,0:42:56.59,Lalai,peringkat 4,0,0,0,,Saya mesti berjumpa raja.
Dialog: 0,0:42:57.34,0:42:59.20,Lalai,peringkat 4,0,0,0,,Nah...
Dialog: 0,0:43:04.70,0:43:06.93,Lalai,menembak 4,0,0,0,,Yang Mulia, ini Hwajin.
Dialog: 0,0:43:45.57,0:43:47.92,Lalai,peringkat 4,0,0,0,,Jadi anda mahu,
Dialog: 0,0:43:47.92,0:43:50.22,Lalai,peringkat 4,0,0,0,,supaya saya menyelesaikan buku tentang taktik dengan ratu,
Dialog: 0,0:43:50.49,0:43:52.26,Lalai,peringkat 4,0,0,0,,berpakaian seperti lelaki.
Dialog: 0,0:43:53.78,0:43:55.03, Lalai, peringkat 4,0,0,0,, Hebat.
Dialog: 0,0:43:56.88,0:43:58.22,Lalai,peringkat 4,0,0,0,,Buang prasangka anda.
Dialog: 0,0:43:58.40,0:43:59.65,Lalai,peringkat 4,0,0,0,,Dia mencipta senjata,
Dialog: 0,0:43:59.65,0:44:01.49,Lalai,peringkat 4,0,0,0,,yang belum pernah dilihat oleh sesiapa pun sebelum ini.
Dialog: 0,0:44:03.97,0:44:06.57,Lalai,peringkat 4,0,0,0,,Baiklah, mari dengar.
Dialog: 0,0:44:07.61,0:44:10.88,Lalai,peringkat 4,0,0,0,,Sebelum itu, mari kita bercakap tentang kaedah maut melatih askar.
Dialog: 0,0:44:11.18,0:44:12.84, Lalai, peringkat 4,0,0,0,,Mengapa tidak bermula dengan ini?
Dialog: 0,0:44:14.95,0:44:16.05,Lalai,peringkat 4,0,0,0,,Kaedah maut?
Dialog: 0,0:44:18.92,0:44:21.42,Lalai,peringkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:21.68,0:44:22.72, Lalai, peringkat 4,0,0,0,, Tujuh.
Dialog: 0,0:44:22.72,0:44:26.26, Lalai, peringkat 4,0,0,0,, Saya tidak dapat mendengar anda. Adakah itu sahaja yang boleh anda lakukan?
Dialog: 0,0:44:27.09,0:44:30.18,Lalai,peringkat 4,0,0,0,,Baiklah, saya faham semuanya. Mari kita bercakap tentang senjata.
Dialog: 0,0:44:30.55,0:44:32.99,Lalai,peringkat 4,0,0,0,,14 pendekatan secara keseluruhan. Ini adalah yang ke-8.
Dialog: 0,0:44:34.97,0:44:37.09,Lalai,peringkat 4,0,0,0,,Jangan sebut nombor terakhir.
Dialog: 0,0:44:37.30,0:44:39.86,Lalai,peringkat 4,0,0,0,,Jika anda menamakannya, anda mulakan semula.
Dialog: 0,0:44:41.26,0:44:43.57,Lalai,peringkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:43.90,0:44:44.90,Lalai,peringkat 4,0,0,0,,Enam.
Dialog: 0,0:44:45.70,0:44:46.97,Lalai,peringkat 4,0,0,0,,1, 2, 3.
Dialog: 0,0:44:46.97,0:44:48.90,Lalai,peringkat 4,0,0,0,,-Pandang lurus.\N-Tujuh.
Dialog: 0,0:44:49.07,0:44:51.61,Lalai,peringkat 4,0,0,0,,Adalah berbahaya untuk membenarkan dia terlibat dalam strategi ketenteraan.
Dialog: 0,0:44:51.92,0:44:54.82,Lalai,peringkat 4,0,0,0,,Permaisuri mengisytiharkan perang terhadap klannya.
Dialog: 0,0:44:55.78,0:44:58.38,Lalai,peringkat 4,0,0,0,,Dia tidak perlu lagi membuktikan bahawa dia untuk kita.
Dialog: 0,0:45:01.09,0:45:02.18,Lalai,peringkat 4,0,0,0,,Yang Mulia.
Dialog: 0,0:45:02.18,0:45:04.86, Lalai, peringkat 4,0,0,0,,-Angkat kaki anda.\N-2, 3.
Dialog: 0,0:45:05.13,0:45:06.49, Lalai, peringkat 4,0,0,0,,-Lapan.\N-Lepas.
Dialog: 0,0:45:07.26,0:45:08.76, Lalai, peringkat 4,0,0,0,, Lapan ialah nombor terakhir.
Dialog: 0,0:45:09.32,0:45:11.09, Lalai, peringkat 4,0,0,0,, Mulakan semula.
Dialog: 0,0:45:11.09,0:45:12.86,Lalai,peringkat 4,0,0,0,,Tunggu. Kaedah pembunuh ini
Dialog: 0,0:45:12.86,0:45:14.51,Lalai,peringkat 4,0,0,0,,berakhir apabila saya mati?
Dialog: 0,0:45:14.51,0:45:16.20,Lalai,peringkat 4,0,0,0,,Mulakan semula.
Dialog: 0,0:45:16.70,0:45:18.01, Lalai, peringkat 4,0,0,0,,-Ayuh.\N-Satu.
Dialog: 0,0:45:19.03,0:45:20.28,Lalai,peringkat 4,0,0,0,,Yang Mulia.
Dialog: 0,0:45:32.32,0:45:34.13,Lalai,peringkat 4,0,0,0,,Perlahan-lahan bertukar menjadi raksasa -
Dialog: 0,0:45:37.53,0:45:39.59, Lalai, peringkat 4,0,0,0,, dan anda sendiri tidak menyedarinya.
Dialog: 0,0:45:50.13,0:45:51.70,Lalai,peringkat 4,0,0,0,,Entri palsu ini
Dialog: 0,0:45:51.70,0:45:54.01, Lalai, peringkat 4,0,0,0,, cukup untuk mengalih keluar penasihat kiri.
Dialog: 0,0:45:54.84,0:45:57.20,Lalai,peringkat 4,0,0,0,,-Jaga dia.\N-Ya.
Dialog: 0,0:46:00.18,0:46:03.05,Lalai,tier 4,0,0,0,,Tuanku, gundik utama telah tiba.
Dialog: 0,0:46:03.82,0:46:04.99,Lalai,peringkat 4,0,0,0,,Izinkan saya masuk.
Dialog: 0,0:46:16.86,0:46:18.40,Lalai,peringkat 4,0,0,0,,Saya perlu memberitahu anda sesuatu.
Dialog: 0,0:46:20.84,0:46:23.93,Lalai,peringkat 4,0,0,0,,Putera Yeonpyeong, boleh tolong tinggalkan kami?
Dialog: 0,0:46:24.61,0:46:26.63, Lalai, peringkat 4,0,0,0,,-Yang Mulia.\N-Sila.
Dialog: 0,0:46:36.11,0:46:39.88,Lalai,peringkat 4,0,0,0,,Kebelakangan ini anda sering bercakap dengan ratu pada waktu petang.
Dialog: 0,0:46:41.05,0:46:42.99,Lalai,peringkat 4,0,0,0,,Boleh saya tahu apa yang anda bincangkan?
Dialog: 0,0:46:43.36,0:46:45.90,Lalai,peringkat 4,0,0,0,,Kami bercakap tentang cara saya melihat masa depan Joseon.
Dialog: 0,0:46:47.80,0:46:51.09,Lalai,peringkat 4,0,0,0,,Saya fikir saya akan menjadi satu-satunya orang yang anda akan berkongsi impian anda.
Dialog: 0,0:46:52.30,0:46:53.59,Lalai,peringkat 4,0,0,0,,Semasa permaisuri semakin hampir dengan kamu,
Dialog: 0,0:46:53.59,0:46:57.13,Lalai,peringkat 4,0,0,0,,yang saya lakukan hanyalah teragak-agak kerana pembohongan orang lain.
Dialog: 0,0:47:00.90,0:47:03.01, Lalai, peringkat 4,0,0,0,,Tetapi saya tidak akan membenarkan ini lagi.
Dialog: 0,0:47:05.15,0:47:06.78,Lalai,peringkat 4,0,0,0,,Arahan awal untuk kanak-kanak
Dialog: 0,0:47:08.51,0:47:09.88, Lalai, peringkat 4,0,0,0,,bukan milik saya.
Dialog: 0,0:47:15.15,0:47:16.68,Lalai,peringkat 4,0,0,0,,Anda sudah tahu tentang perkara ini.
Dialog: 0,0:47:17.95,0:47:20.20,Lalai,peringkat 4,0,0,0,,Lalu mengapa mereka tidak berkata apa-apa?
Dialog: 0,0:47:20.53,0:47:22.57, Lalai, peringkat 4,0,0,0,, Kerana ia tidak akan mengubah apa-apa.
Dialog: 0,0:47:22.57,0:47:24.74,Lalai,peringkat 4,0,0,0,,Mengapa ini tidak mengubah apa-apa?
Dialog: 0,0:47:26.13,0:47:29.24,Lalai,peringkat 4,0,0,0,,Anda tidak mempercayai saya lagi.
Dialog: 0,0:47:30.90,0:47:34.01,Lalai,peringkat 4,0,0,0,,Anda tidak memandang saya dengan cara yang sama lagi.
Dialog: 0,0:47:34.38,0:47:36.80, Lalai, peringkat 4,0,0,0,, Kerana satu pembohongan,
Dialog: 0,0:47:37.38,0:47:40.11,Lalai,peringkat 4,0,0,0,,masa yang dihabiskan dengan anda tidak akan hilang.
Dialog: 0,0:47:41.68,0:47:44.01,Lalai,peringkat 4,0,0,0,,Hakikat bahawa saya mencintai awak selama dua tahun,
Dialog: 0,0:47:45.15,0:47:46.32,Lalai,peringkat 4,0,0,0,,tidak akan berubah.
Dialog: 0,0:47:46.68,0:47:48.68,Lalai,peringkat 4,0,0,0,,Saya pasti anda melakukan ini demi saya.
Dialog: 0,0:47:50.93,0:47:52.82, Lalai, peringkat 4,0,0,0,, Kerana anda adalah orang yang sedemikian.
Dialog: 0,0:47:54.80,0:47:57.36,Lalai,peringkat 4,0,0,0,,Adakah anda fikir fakta itu akan menggembirakan saya,
Dialog: 0,0:47:57.70,0:47:59.74,Lalai,peringkat 4,0,0,0,,yang anda berpura-pura tidak tahu apa-apa?
Dialog: 0,0:47:59.74,0:48:02.70,Lalai,menembak 4,0,0,0,,-Hwajin.\N-Saya membingkai permaisuri.
Dialog: 0,0:48:04.28,0:48:05.40,Lalai,peringkat 4,0,0,0,,I
Dialog: 0,0:48:06.53,0:48:08.24,Lalai,peringkat 4,0,0,0,,menjumpai buku perakaunan keluarga Kim
Dialog: 0,0:48:08.24,0:48:09.95, Lalai, peringkat 4,0,0,0,, dan memberikannya kepada Ibu Permaisuri.
Dialog: 0,0:48:11.55,0:48:12.61,Lalai,peringkat 4,0,0,0,,Kenapa awak...
Dialog: 0,0:48:14.38,0:48:15.55,Lalai,peringkat 4,0,0,0,,Kerana
Dialog: 0,0:48:17.68,0:48:18.99,Lalai,peringkat 4,0,0,0,,Saya benci permaisuri.
Dialog: 0,0:48:20.11,0:48:22.32,Lalai,peringkat 4,0,0,0,,Tahukah anda bahawa lejar ini
Dialog: 0,0:48:23.15,0:48:25.15, Lalai, peringkat 4,0,0,0,, adakah ia benar-benar diperlukan untuk saya?
Dialog: 0,0:48:25.32,0:48:26.80, Lalai, peringkat 4,0,0,0,, Tahu, tetapi memberikannya.
Dialog: 0,0:48:29.09,0:48:31.47,Lalai,peringkat 4,0,0,0,,Bagaimana anda boleh melakukan ini?
Dialog: 0,0:48:32.17,0:48:34.84, Lalai, peringkat 4,0,0,0,,Anda lebih tahu daripada orang lain apa yang saya impikan.
Dialog: 0,0:48:36.13,0:48:37.63,Lalai,peringkat 4,0,0,0,,Anda menginjak impian saya.
Dialog: 0,0:48:37.63,0:48:38.90,Lalai,peringkat 4,0,0,0,,Impian saya...
Dialog: 0,0:48:39.78,0:48:41.88,Lalai,peringkat 4,0,0,0,,Anda adalah impian saya.
Dialog: 0,0:48:43.40,0:48:46.92,Lalai,peringkat 4,0,0,0,,Tetapi hati awak mula terdetik untuk permaisuri.
Dialog: 0,0:48:48.24,0:48:50.42,Lalai,peringkat 4,0,0,0,,Anda telah berusaha keras untuk saya,
Dialog: 0,0:48:51.18,0:48:53.92,Lalai,peringkat 4,0,0,0,,tetapi saya nampak cara anda mendekatinya.
Dialog: 0,0:48:55.63,0:48:58.36,Lalai,peringkat 4,0,0,0,,Saya berasa sangat menyedihkan.
Dialog: 0,0:49:01.32,0:49:03.47, Lalai, peringkat 4,0,0,0,, Jadi saya kehilangan diri saya.
Dialog: 0,0:49:17.45,0:49:18.72,Lalai,peringkat 4,0,0,0,,Ini salah saya.
Dialog: 0,0:49:20.78,0:49:22.49,Lalai,peringkat 4,0,0,0,,Awak jadi begini kerana saya.
Dialog: 0,0:49:24.05,0:49:25.68,Lalai,peringkat 4,0,0,0,,Ini salah saya.
Dialog: 0,0:49:27.42,0:49:31.05,Lalai,peringkat 4,0,0,0,,Saya tidak sepatutnya mencintai tanpa menjaga diri sendiri.
Dialog: 0,0:49:34.97,0:49:36.32,Lalai,peringkat 4,0,0,0,,Saya akan pergi
Dialog: 0,0:49:37.86,0:49:39.40, Lalai, peringkat 4,0,0,0,, dan saya akan mendapati diri saya sendiri.
Dialog: 0,0:49:53.28,0:49:54.61, Lalai, peringkat 4,0,0,0,,"Dunia Pasangan Yang Berkahwin. Jilid 1"
Dialog: 0,0:49:54.61,0:49:56.49,Lalai,peringkat 4,0,0,0,,Dasar sekali!
Dialog: 0,0:49:57.65,0:49:58.72,Lalai,peringkat 4,0,0,0,,Seterusnya.
Dialog: 0,0:49:59.95,0:50:01.18, Lalai, peringkat 4,0,0,0,,"Dunia Pasangan Berkahwin. Jilid 2"
Dialog: 0,0:50:03.45,0:50:07.93,Lalai,julat menembak 4,0,0,0,,Yang Mulia, tidakkah Tuanku pergi ke Dewan Hijeongjong hari ini?
Dialog: 0,0:50:08.57,0:50:09.99,Lalai,peringkat 4,0,0,0,,Mungkin saya harus melangkaunya hari ini?
Dialog: 0,0:50:13.07,0:50:16.03,Lalai,peringkat 4,0,0,0,,Cheoljong saya akan sangat menanti ketibaan saya.
Dialog: 0,0:50:19.57,0:50:22.65, Lalai, peringkat 4,0,0,0,,Siapa sangka\N saya sangat dahagakan ilmu.
Dialog: 0,0:50:23.78,0:50:25.11, Lalai, menangkap 4,0,0,0,, Satu halaman lagi.
Dialog: 0,0:50:36.36,0:50:39.40,Lalai,peringkat 4,0,0,0,,Kim Soyeon
Dialog: 0,0:50:42.47,0:50:45.99,Lalai,menembak 4,0,0,0,,Choljong, maaf, maaf. Saya hanya mahu membaca satu halaman
Dialog: 0,0:50:45.99,0:50:47.49, Lalai, peringkat 4,0,0,0,, tetapi tidak dapat berhenti.
Dialog: 0,0:50:48.24,0:50:49.70, Lalai, peringkat 4,0,0,0,,Mengapa awak belum menukar pakaian lagi?
Dialog: 0,0:50:58.38,0:51:01.49,Lalai,peringkat 4,0,0,0,,Apa? Mengapa anda memberikannya kepada saya?
Dialog: 0,0:51:02.18,0:51:06.72, Lalai, peringkat 4,0,0,0,,Bukankah awak kata saya patut pulangkan dia kepada awak jika saya mahu hidup?
Dialog: 0,0:51:12.59,0:51:17.32,Lalai,peringkat 4,0,0,0,,Anda boleh menyakiti seseorang tanpa mengetahui perkara sebenar.
Dialog: 0,0:51:18.47,0:51:20.36,Lalai,peringkat 4,0,0,0,,Saya sudah lama menunggu,
Dialog: 0,0:51:20.99,0:51:22.80, Lalai, peringkat 4,0,0,0,,untuk mengembalikan buku kepada pemiliknya.
Dialog: 0,0:51:32.24,0:51:33.68,Lalai,peringkat 4,0,0,0,,Maaf,
Dialog: 0,0:51:34.88,0:51:36.55, Lalai, peringkat 4,0,0,0,, yang saya tidak mengenali anda.
Dialog: 0,0:51:39.36,0:51:40.72, Lalai, peringkat 4,0,0,0,, Dan awak saya.
Dialog: 0,0:51:42.18,0:51:44.65, Lalai, peringkat 4,0,0,0,,Saya tidak jujur ​​dengan awak.
Dialog: 0,0:51:47.05,0:51:49.22,Lalai,peringkat 4,0,0,0,,Dia kembali kepada pemilik selepas 8 tahun.
Dialog: 0,0:51:49.99,0:51:53.13, Lalai, peringkat 4,0,0,0,, Kita tidak boleh mendapatkan kembali masa kita yang hilang.
Dialog: 0,0:51:55.40,0:51:56.97,Lalai,peringkat 4,0,0,0,,Walau bagaimanapun
Dialog: 0,0:51:58.38,0:52:01.20,Lalai,peringkat 4,0,0,0,,Saya tidak akan meninggalkan awak lagi.
Dialog: 0,0:52:07.11,0:52:10.59,Lalai,peringkat 4,0,0,0,,Tetapi bagaimana anda hidup
Dialog: 0,0:52:11.01,0:52:13.65, Lalai, peringkat 4,0,0,0,, sepanjang lapan tahun ini?
Dialog: 0,0:52:14.82,0:52:18.80,Lalai,peringkat 4,0,0,0,,Anda pelik ketika itu, tetapi tidak begitu.
Dialog: 0,0:52:19.36,0:52:21.22,Lalai,peringkat 4,0,0,0,,Adakah saya terlepas sesuatu?
Dialog: 0,0:52:23.30,0:52:24.59,Lalai,peringkat 4,0,0,0,,Soalan yang bagus.
Dialog: 0,0:52:40.89,0:52:42.76, Lalai, peringkat 4,0,0,0,, Nampak bagus, walaupun saya tidak tahu apa itu.
Dialog: 0,0:52:45.03,0:52:46.26, Lalai, peringkat 4,0,0,0,,Ini ubat.
Dialog: 0,0:52:47.50,0:52:49.70,Lalai,peringkat 4,0,0,0,,Semua yang anda makan secara rahsia sepatutnya sedap.
Dialog: 0,0:52:51.70,0:52:52.84, Lalai, peringkat 4,0,0,0,, Yogurt?
Dialog: 0,0:52:54.34,0:52:56.37, Lalai, peringkat 4,0,0,0,,-Bau alkohol.\N-Nah, itu...
Dialog: 0,0:52:57.64,0:52:58.91, Lalai, peringkat 4,0,0,0,,Ini ialah wain pir.
Dialog: 0,0:52:59.14,0:53:01.04,Lalai,peringkat 4,0,0,0,,Diperbuat daripada bunga pir
Dialog: 0,0:53:01.04,0:53:04.82, Lalai, peringkat 4,0,0,0,, dan minum apabila bau bunga berpusar di udara.
Dialog: 0,0:53:05.82,0:53:06.98,Lalai,peringkat 4,0,0,0,,Adakah anda akan menuang segelas?
Dialog: 0,0:53:07.15,0:53:08.65, Lalai, peringkat 4,0,0,0,,Saya hanya ada satu lagi.
Dialog: 0,0:53:08.65,0:53:11.66, Lalai, peringkat 4,0,0,0,,Penciptaannya memerlukan banyak usaha, jadi saya mengekalkannya.
Dialog: 0,0:53:11.66,0:53:13.16,Lalai,peringkat 4,0,0,0,,-Tetapi kerana awak...\N-Sial.
Dialog: 0,0:53:15.43,0:53:16.73, Lalai, peringkat 4,0,0,0,,Bagaimana anda berjaya melakukannya?
Dialog: 0,0:53:17.66,0:53:21.30,Lalai,peringkat 4,0,0,0,,Pertama, sediakan doh dengan mencampurkan air dengan serbuk beras rendah lemak.
Dialog: 0,0:53:21.30,0:53:24.03,Default,tier 4,0,0,0,,Kemudian mari leperkan doh dan buat lubang.
Dialog: 0,0:53:24.03,0:53:25.80,Lalai,peringkat 4,0,0,0,,Membuat persediaan.
Dialog: 0,0:53:27.91,0:53:29.34, Lalai, peringkat 4,0,0,0,,Kelihatan seperti donat.
Dialog: 0,0:53:32.68,0:53:33.68,Lalai,peringkat 4,0,0,0,,Teruskan.
Dialog: 0,0:53:33.68,0:53:36.95,Lalai,tier 4,0,0,0,,Masak dalam air panas, keluarkan,
Dialog: 0,0:53:36.95,0:53:39.08,Lalai,peringkat 4,0,0,0,,uli dan biarkan sejuk.
Dialog: 0,0:53:39.88,0:53:42.82,Lalai,peringkat 4,0,0,0,,Ambil bunga pir dan yis yang telah disediakan
Dialog: 0,0:53:42.82,0:53:44.56, Lalai, peringkat 4,0,0,0,, dan buat doh semula.
Dialog: 0,0:53:44.82,0:53:48.59, Lalai, peringkat 4,0,0,0,, Letakkannya di dalam jag dan tutup penutup.
Dialog: 0,0:53:48.59,0:53:50.96,Lalai,peringkat 4,0,0,0,,Dalam tiga hari...
Dialog: 0,0:53:50.96,0:53:52.10,Lalai,peringkat 4,0,0,0,,Bolehkah saya minum?
Dialog: 0,0:53:54.63,0:53:55.97,Lalai,peringkat 4,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:53:56.43,0:53:59.67, Lalai, peringkat 4,0,0,0,, Anda goncangkannya.
Dialog: 0,0:53:59.67,0:54:01.47,Lalai,peringkat 4,0,0,0,,Dan selepas 20 hari
Dialog: 0,0:54:02.47,0:54:04.11, Lalai, peringkat 4,0,0,0,,anda sudah boleh minum.
Dialog: 0,0:54:06.61,0:54:08.21, Lalai, peringkat 4,0,0,0,, Biarkan masa berlalu.
Dialog: 0,0:54:08.88,0:54:10.61, Lalai, peringkat 4,0,0,0,, Bertegas dengan cepat.
Dialog: 0,0:54:16.32,0:54:17.89,Lalai,peringkat 4,0,0,0,,Penasihat Kiri Kim Seok-keun
Dialog: 0,0:54:17.89,0:54:19.46,Lalai,peringkat 4,0,0,0,,bersama-sama dengan pegawai tempatan
Dialog: 0,0:54:19.46,0:54:23.16, Lalai, peringkat 4,0,0,0,, menyalahgunakan buruh petani dan memalsukan rekod.
Dialog: 0,0:54:23.16,0:54:24.76,Lalai,peringkat 4,0,0,0,,Berkaitan dengan pertuduhan mencuri
Dialog: 0,0:54:24.76,0:54:26.36, Lalai, peringkat 4,0,0,0,, dia akan disingkirkan daripada kedudukannya,
Dialog: 0,0:54:26.36,0:54:28.57, Lalai, peringkat 4,0,0,0,,dan hartanya akan dirampas.
Dialog: 0,0:54:28.80,0:54:30.40,Lalai,peringkat 4,0,0,0,,Beraninya anda!
Dialog: 0,0:54:32.97,0:54:35.44,Lalai,peringkat 4,0,0,0,,Jangan mendekati. lepaskan saya!
Dialog: 0,0:54:35.84,0:54:37.71,Lalai,peringkat 4,0,0,0,,Lepaskan!
Dialog: 0,0:54:39.14,0:54:40.44, Lalai, peringkat 4,0,0,0,, Lepas tangan!
Dialog: 0,0:54:45.62,0:54:49.12,Lalai,peringkat 4,0,0,0,,Saya tidak dapat menyangka bahawa amaran ratu itu bukan sandiwara.
Dialog: 0,0:54:50.32,0:54:52.36,Lalai,peringkat 4,0,0,0,,Menggantikan penasihat kiri
Dialog: 0,0:54:52.66,0:54:54.99,Lalai,peringkat 4,0,0,0,,Saya melantik bapa kepada gundik Min,
Dialog: 0,0:54:54.99,0:54:57.29,Lalai,peringkat 4,0,0,0,,Min Ujina daripada puak Yohyn Min.
Dialog: 0,0:54:57.29,0:54:59.10, Lalai, peringkat 4,0,0,0,, Pertimbangkan semula keputusan anda.
Dialog: 0,0:54:59.10,0:55:01.60, Lalai, peringkat 4,0,0,0,,-Pertimbangkan semula keputusan anda.\N-Pertimbangkan semula keputusan anda.
Dialog: 0,0:55:16.45,0:55:17.88, Lalai, peringkat 4,0,0,0,,Perbualan akan menjadi pendek.
Dialog: 0,0:55:19.12,0:55:21.42, Lalai, peringkat 4,0,0,0,, Bilakah regency saya akan dipulihkan?
Dialog: 0,0:55:21.49,0:55:24.66, Lalai, peringkat 4,0,0,0,,Ini mesti berlaku sebelum raja memusnahkan Joseon.
Dialog: 0,0:55:24.82,0:55:28.03,Lalai,peringkat 4,0,0,0,,Keluarga kami tidak akan kehilangan kedudukannya lagi.
Dialog: 0,0:55:28.59,0:55:30.69,Lalai,peringkat 4,0,0,0,,Selain itu, kami sedang mengumpul tentera,
Dialog: 0,0:55:30.89,0:55:33.16, Lalai, peringkat 4,0,0,0,, jadi raja tidak lama lagi.
Dialog: 0,0:55:33.16,0:55:34.43,Lalai,peringkat 4,0,0,0,,Cepat.
Dialog: 0,0:55:34.43,0:55:36.70,Lalai,peringkat 4,0,0,0,,Saya tidak dikenali kerana kesabaran saya.
Dialog: 0,0:55:36.97,0:55:38.07,Lalai,peringkat 4,0,0,0,,Ya.
Dialog: 0,0:55:38.57,0:55:42.17,Lalai,peringkat 4,0,0,0,,By the way, saya dengar sesuatu yang pelik.
Dialog: 0,0:55:43.71,0:55:47.24,Lalai,peringkat 4,0,0,0,,Bahawa permaisuri memperkenalkan raja kepada cita-cita yang menghujat.
Dialog: 0,0:56:00.79,0:56:01.86, Lalai, peringkat 4,0,0,0,,Pada malam tanpa tidur saya berjalan.
Dialog: 0,0:56:01.86,0:56:02.93, Lalai, peringkat 4,0,0,0,,Cahaya menembusi langit malam yang gelap.
Dialog: 0,0:56:11.00,0:56:12.30,Lalai,peringkat 4,0,0,0,,
Dialog: 0,0:56:17.47,0:56:19.61,Lalai,peringkat 4,0,0,0,,
Dialog: 0,0:56:19.61,0:56:21.21, Lalai, peringkat 4,0,0,0,,Adakah dia masih memilikinya?
Dialog: 0,0:56:43.70,0:56:45.24,Lalai,peringkat 4,0,0,0,,Adakah mereka semua pengikut Tonhak?
Dialog: 0,0:56:45.80,0:56:46.80,Lalai,peringkat 4,0,0,0,,Ya.
Dialog: 0,0:56:46.80,0:56:50.71,Lalai,menembak 4,0,0,0,,-Keluar.\N-Ibu.
Dialog: 0,0:56:50.71,0:56:53.11, Lalai, peringkat 4,0,0,0,,Kenapa awak bawa anak itu?
Dialog: 0,0:56:53.41,0:56:55.58, Lalai, peringkat 4,0,0,0,, Mimpi! Mimpi!
Dialog: 0,0:57:01.49,0:57:02.99, Lalai,,0,0,0,,Adakah anda mengenali tulisan tangan itu?
Dialog: 0,0:57:12.46,0:57:15.07,Lalai,,0,0,0,,Ini adalah sifir pengikut Tonhak.
Dialog: 0,0:57:21.27,0:57:23.64,Lalai,,0,0,0,,Dalam peperangan, semua cara adalah adil.
Dialog: 0,0:57:23.64,0:57:24.94, Lalai,,0,0,0,,"Dana"? Apakah maksudnya?
Dialog: 0,0:57:25.28,0:57:26.54,Lalai,,0,0,0,,Sesetengah peribahasa?
Dialog: 0,0:57:26.88,0:57:29.78, Lalai,,0,0,0,,Bom tangan boleh lebih berkesan daripada 10 askar.
Dialog: 0,0:57:30.15,0:57:32.15, Lalai,,0,0,0,,Kelihatan seperti fiksyen.
Dialog: 0,0:57:32.15,0:57:33.18,Lalai,,0,0,0,,By the way,
Dialog: 0,0:57:33.35,0:57:36.32, Lalai,,0,0,0,,Saya teringat 15 sesi latihan di sini.
Dialog: 0,0:57:36.49,0:57:39.66, Lalai,,0,0,0,,Bunyi munasabah, "bom tangan".
Dialog: 0,0:57:42.26,0:57:44.69,Lalai,,0,0,0,,Jika anda memasukkan serbuk mesiu ke dalam beg tersebut dan membuangnya,
Dialog: 0,0:57:44.69,0:57:47.16,Lalai,,0,0,0,,dia akan meletup macam tu.
Dialog: 0,0:57:48.10,0:57:49.33, Lalai,,0,0,0,,Kami ada ini.
Dialog: 0,0:57:49.93,0:57:51.27, Lalai,,0,0,0,,Bom letupan.
Dialog: 0,0:57:51.87,0:57:54.54,Lalai,,0,0,0,,Betulkah? Adakah anda mempunyai jaket kalis peluru?
Dialog: 0,0:57:55.47,0:57:56.91,Lalai,,0,0,0,,Pakaian kalis peluru?
Dialog: 0,0:57:57.31,0:57:58.71, Lalai,,0,0,0,,Maksud awak perisai?
Dialog: 0,0:57:59.24,0:58:01.38, Lalai,,0,0,0,,Tidak, memakai di bawah perisai.
Dialog: 0,0:58:02.78,0:58:03.85, Lalai,,0,0,0,,Begitulah.
Dialog: 0,0:58:05.45,0:58:06.85, Lalai,,0,0,0,,Hn!
Dialog: 0,0:58:08.55,0:58:11.35, Lalai,,0,0,0,,Saya sedang lalu, dan lampu menyala.
Dialog: 0,0:58:11.96,0:58:13.42, Lalai,,0,0,0,,Senang untuk dilihat.
Dialog: 0,0:58:15.16,0:58:18.30, Lalai,,0,0,0,,Anda berseronok tanpa saya di sini.
Dialog: 0,0:58:18.60,0:58:20.50, Lalai,,0,0,0,,Saya tidak percaya saya tidak dijemput.
Dialog: 0,0:58:25.07,0:58:26.24, Lalai,,0,0,0,,-Apa yang awak cakapkan.\N-Tuhan!
Dialog: 0,0:58:26.80,0:58:27.97, Lalai,,0,0,0,, Lee Senman!
Dialog: 0,0:58:28.57,0:58:30.61, Lalai,,0,0,0,, Langsung!
Dialog: 0,0:58:33.38,0:58:35.11, Lalai,,0,0,0,, Betapa risaunya saya.
Dialog: 0,0:58:36.45,0:58:38.68,Lalai,,0,0,0,,Kami akhirnya bertemu. sungguh!
Dialog: 0,0:58:40.85,0:58:43.19,Lalai,,0,0,0,,Saya gembira dapat bertemu dengan anda juga.
Dialog: 0,0:58:43.19,0:58:45.62,Lalai,,0,0,0,,Tidak pernah kembali ke Okthajeong?
Dialog: 0,0:58:45.62,0:58:47.12,Lalai,,0,0,0,,Saya minum banyak wain
Dialog: 0,0:58:47.12,0:58:50.33, Lalai,,0,0,0,,di sana, berharap dapat bertemu dengan anda.
Dialog: 0,0:58:50.86,0:58:52.13, Lalai,,0,0,0,, Lee Senman!
Dialog: 0,0:58:58.00,0:59:01.10, Lalai,,0,0,0,, Lepas tangan. Mungkin anda boleh memperkenalkan diri anda terlebih dahulu?
Dialog: 0,0:59:01.77,0:59:03.34, Lalai,,0,0,0,,Siapa awak?
Dialog: 0,0:59:03.51,0:59:07.08, Lalai,,0,0,0,,Saya kawan rapat Lee Sanman.
Dialog: 0,0:59:07.94,0:59:10.08, Lalai,,0,0,0,,"Kawan"? saya...
Dialog: 0,0:59:10.71,0:59:12.98, Lalai,,0,0,0,,-Anda...\N-Saya...
Dialog: 0,0:59:14.55,0:59:17.05, Lalai,,0,0,0,,Tunggu sebentar. Wajah itu agak dikenali.
Dialog: 0,0:59:18.39,0:59:20.92, Lalai,,0,0,0,,Rakan saya, Jeong Chul.
Dialog: 0,0:59:21.16,0:59:22.23, Lalai,,0,0,0,,Mengapa...
Dialog: 0,0:59:23.36,0:59:24.93, Lalai,,0,0,0,,Siapakah kamu?
Dialog: 0,0:59:25.46,0:59:26.70,Lalai,,0,0,0,,Saya Jeong Chul.
Dialog: 0,0:59:30.23,0:59:33.47, Lalai,,0,0,0,,Ya! Kemenangan!
Dialog: 0,0:59:35.31,0:59:38.44, Lalai,,0,0,0,,Apa yang anda perlu lakukan untuk bermain seperti ini?
Dialog: 0,0:59:39.88,0:59:41.78,Lalai,,0,0,0,,Katakanlah, masa muda yang sia-sia.
Dialog: 0,0:59:42.35,0:59:43.98, Lalai,,0,0,0,,Tepat kawan saya.
Dialog: 0,0:59:44.28,0:59:46.35, Lalai,,0,0,0,,Kami sangat serupa.
Dialog: 0,0:59:46.35,0:59:49.29,Lalai,,0,0,0,,Tuhan, nampaknya ini tempat yang bagus.
Dialog: 0,0:59:49.72,0:59:51.69, Lalai,,0,0,0,,Mungkin anda menyembunyikan kad di suatu tempat?
Dialog: 0,0:59:52.02,0:59:54.49, Lalai,,0,0,0,,Sukar untuk mendapatkan kad truf.
Dialog: 0,0:59:54.49,0:59:55.93,Lalai,,0,0,0,,Jangan salahkan diri sendiri atas kesilapan anda
Dialog: 0,0:59:55.93,0:59:57.59, Lalai,,0,0,0,, nasib saya.
Dialog: 0,0:59:57.93,0:59:59.56, Lalai,,0,0,0,,Baiklah, mari kita teruskan.
Dialog: 0,0:59:59.93,1:00:02.07,Lalai,,0,0,0,,Yang kalah mendapat hajat mereka.
Dialog: 0,1:00:05.80,1:00:07.54,Lalai,,0,0,0,,Perhatikan topi anda.
Dialog: 0,1:00:08.44,1:00:09.57,Lalai,,0,0,0,,Orang Dalam.
Dialog: 0,1:00:12.71,1:00:13.74,Lalai,,0,0,0,,Orang Luar.
Dialog: 0,1:00:15.61,1:00:18.11,Lalai,,0,0,0,,Dan seorang pengikut kepercayaannya, seperti saya.
Dialog: 0,1:00:18.78,1:00:20.25,Lalai,,0,0,0,,Pakatan sungguh.
Dialog: 0,1:00:37.63,1:00:38.87,Lalai,,0,0,0,,Saya akan bantu.
Dialog: 0,1:00:43.07,1:00:44.61,Lalai,,0,0,0,,Semua terima kasih kepada noltwigs.
Dialog: 0,1:00:47.71,1:00:49.18,Lalai,,0,0,0,,Saya yakin dengan kemenangan saya.
Dialog: 0,1:01:13.34,1:01:15.97,Lalai,,0,0,0,,Saya tidak percaya mereka menggunakannya
Dialog: 0,1:01:15.97,1:01:18.24,Lalai,,0,0,0,,untuk mengalihkan penasihat kiri.
Dialog: 0,1:01:19.81,1:01:24.28,Lalai,,0,0,0,,Jadi... Saya pasti mereka mempunyai lejar.
Dialog: 0,1:01:25.55,1:01:27.68,Lalai,,0,0,0,,Sekarang pertempuran sebenar bermula.
Dialog: 0,1:01:28.25,1:01:29.25,Lalai,,0,0,0,,Apa?
Dialog: 0,1:01:30.65,1:01:33.29,Lalai,,0,0,0,,Mari kita mula membersihkan sebelum pertumpahan darah.
Dialog: 0,1:01:34.59,1:01:36.56,Lalai,,0,0,0,,Jika anda tidak mahu terjebak dalam perkara ini,
Dialog: 0,1:01:37.09,1:01:40.70,Lalai,,0,0,0,, ketepikan ketamakan anda dan bersedia untuk menumpahkan darah.
Dialog: 0,1:01:41.56,1:01:42.87, Lalai,,0,0,0,, Tumpah darah?
Dialog: 0,1:01:44.80,1:01:47.27,Lalai,,0,0,0,,Mereka yang menjual pekerjaan kerajaan,
Dialog: 0,1:01:47.27,1:01:49.47,Lalai,,0,0,0,,akan meletakkan jawatan atas kehendak mereka sendiri.
Dialog: 0,1:01:51.04,1:01:52.31,Lalai,,0,0,0,,Jika anda kaya dari bijirin
Dialog: 0,1:01:52.31,1:01:53.54,Lalai,,0,0,0,,atau pada hadiah,
Dialog: 0,1:01:53.54,1:01:54.84,Lalai,,0,0,0,,kembali semua.
Dialog: 0,1:01:56.31,1:01:58.31,Lalai,,0,0,0,,Dan jaga mereka
Dialog: 0,1:01:59.22,1:02:02.62,Lalai,,0,0,0,,yang menyimpan semua rekod dan mengetahui segala-galanya.
Dialog: 0,1:02:02.62,1:02:03.62,Lalai,,0,0,0,,Surat Bunuh Diri
Dialog: 0,1:02:03.62,1:02:04.69,Lalai,,0,0,0,,Itu,
Dialog: 0,1:02:06.72,1:02:09.73,Lalai,,0,0,0,,yang tidak membersihkan diri dan meninggalkan kesan,
Dialog: 0,1:02:11.46,1:02:13.83,Lalai,,0,0,0,,mesti menjawab semua.
Dialog: 0,1:02:18.57,1:02:20.67,Lalai,,0,0,0,,Walaupun saya menggulingkan puak Kim,
Dialog: 0,1:02:20.67,1:02:22.71,Lalai,,0,0,0,,Kuasa Kim Byonin semakin kuat.
Dialog: 0,1:02:23.34,1:02:25.64,Lalai,,0,0,0,,Rasanya seperti tiada kemajuan.
Dialog: 0,1:02:25.64,1:02:27.71,Lalai,,0,0,0,,Kita perlu mencari sesuatu pada Kim Byonin.
Dialog: 0,1:02:28.55,1:02:31.05,Lalai,,0,0,0,,Nampaknya dia membantu seseorang dalam perkhidmatan awam,
Dialog: 0,1:02:31.05,1:02:34.22,Lalai,,0,0,0,,tetapi anda tidak boleh menangkapnya jika dia tidak mendapat apa-apa sebagai balasan.
Dialog: 0,1:02:34.22,1:02:37.72, Lalai,,0,0,0,,Dan itu tidak kelihatan seperti itu sama sekali.
Dialog: 0,1:02:40.72,1:02:42.86,Lalai,,0,0,0,,Dan mereka yang dia bantu,
Dialog: 0,1:02:42.86,1:02:44.43,Lalai,,0,0,0,,sangat berterima kasih kepadanya,
Dialog: 0,1:02:45.36,1:02:46.93,Lalai,,0,0,0,,kami tidak akan dapat memikat mereka.
Dialog: 0,1:02:46.93,1:02:49.20,Lalai,,0,0,0,,Dia membina kubu yang tidak dapat dikalahkan.
Dialog: 0,1:02:58.41,1:02:59.71,Lalai,,0,0,0,,Anda sudah berada di sini.
Dialog: 0,1:03:01.91,1:03:03.31,Lalai,,0,0,0,,Lee Senman belum ada ke?
Dialog: 0,1:03:04.55,1:03:05.62,Lalai,,0,0,0,,Oh, tunggu.
Dialog: 0,1:03:06.35,1:03:09.02,Lalai,,0,0,0,,Saya mesti katakan, dia sangat rajin.
Dialog: 0,1:03:09.52,1:03:11.59,Lalai,,0,0,0,,Setiap hari dia datang bermain dengan kami di tudzhon.
Dialog: 0,1:03:15.46,1:03:16.99,Lalai,,0,0,0,,Awak tak ada kerja?
Dialog: 0,1:03:17.23,1:03:18.60,Lalai,,0,0,0,,Ini tugas saya.
Dialog: 0,1:03:19.13,1:03:20.96,Lalai,,0,0,0,,Bagaimana ini boleh berfungsi?
Dialog: 0,1:03:21.76,1:03:23.63,Lalai,,0,0,0,,Hei, saya tanya.
Dialog: 0,1:03:40.65,1:03:44.82,Lalai,,0,0,0,,Hari ini ia seperti anda milik saya,
Dialog: 0,1:03:44.82,1:03:49.13,Lalai,,0,0,0,,tetapi anda bukan milik saya.
Dialog: 0,1:04:24.33,1:04:25.90,Lalai,,0,0,0,,Salam.
Dialog: 0,1:04:33.94,1:04:39.61,Lalai,,0,0,0,,Saya datang mengadu tentang permaisuri.
Dialog: 0,1:04:39.61,1:04:41.14,Lalai,,0,0,0,,Ya, saya juga.
Dialog: 0,1:04:42.25,1:04:43.78,Lalai,,0,0,0,,Baiklah, anda mulakan.
Dialog: 0,1:04:45.22,1:04:46.22,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:04:49.95,1:04:52.29,Lalai,,0,0,0,,Yang Mulia!
Dialog: 0,1:04:52.76,1:04:56.76,Lalai,,0,0,0,,Berhenti membuat saya marah!
Dialog: 0,1:05:02.30,1:05:06.10,Lalai,,0,0,0,,Jika anda teruskan, muka anda akan bergegar dalam baja.
Dialog: 0,1:05:08.84,1:05:09.91,Lalai,,0,0,0,,Oh, sayang.
Dialog: 0,1:05:10.77,1:05:13.38,Lalai,,0,0,0,,Jarang jumpa orang yang mengumpat lebih baik daripada saya.
Dialog: 0,1:05:13.78,1:05:16.38,Lalai,,0,0,0,,Tetapi izinkan saya memberi anda nasihat. Jika anda menghembus nafas dari sini...
Dialog: 0,1:05:17.75,1:05:19.15,Lalai,,0,0,0,,Sungguh janggal.
Dialog: 0,1:05:20.92,1:05:23.32,Lalai,,0,0,0,,-Nah, sudah tiba masanya untuk saya memanaskan badan juga.\N-Baiklah.
Dialog: 0,1:05:25.32,1:05:28.22,Lalai,,0,0,0,,Awak sekeping... Awak membingungkan saya.
Dialog: 0,1:05:33.16,1:05:34.33,Lalai,,0,0,0,,Di sini saya akan bertanya kepada anda!
Dialog: 0,1:05:39.40,1:05:40.40,Lalai,,0,0,0,,Tuhan.
Dialog: 0,1:05:43.47,1:05:45.44,Lalai,,0,0,0,,-Mungkin bersama?\N-Sudah tentu.
Dialog: 0,1:05:47.61,1:05:49.58,Lalai,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,1:06:08.40,1:06:11.07,Lalai,,0,0,0,,Saya sayang awak, wain saya!
Dialog: 0,1:06:11.07,1:06:13.60,Lalai,,0,0,0,,Anda hebat, wain saya!
Dialog: 0,1:06:15.37,1:06:17.17,Lalai,,0,0,0,,Itu sahaja.
Dialog: 0,1:06:17.17,1:06:18.61,Lalai,,0,0,0,,Anda cuba juga.
Dialog: 0,1:06:19.18,1:06:21.21,Lalai,,0,0,0,,Di bahagian bawah. Di sini anda pergi.
Dialog: 0,1:06:24.75,1:06:25.82,Lalai,,0,0,0,,Dan kepada anda.
Dialog: 0,1:06:26.98,1:06:28.95,Lalai,,0,0,0,,Cantik warnanya, ratu.
Dialog: 0,1:06:29.32,1:06:31.19,Lalai,,0,0,0,,Dan aroma yang begitu lazat.
Dialog: 0,1:06:32.49,1:06:34.89,Lalai,,0,0,0,,Masih. Pendedahan yang sempurna.
Dialog: 0,1:06:35.79,1:06:39.10,Lalai,,0,0,0,,Apa yang kamu berdua lakukan sehingga kamu kehilangan suara?
Dialog: 0,1:06:45.20,1:06:46.50,Lalai,,0,0,0,,Mari kita lihat.
Dialog: 0,1:06:49.24,1:06:51.14,Lalai,,0,0,0,,-Yang Mulia!\N-Yang Mulia.
Dialog: 0,1:06:51.21,1:06:52.78,Lalai,,0,0,0,,Adakah kerana saya tidak makan apa-apa?
Dialog: 0,1:06:53.98,1:06:59.35,Lalai,,0,0,0,,Maka ini adalah untuk pencuci mulut!
Dialog: 0,1:06:59.88,1:07:02.49,Lalai,,0,0,0,,Saya akan kembali kepada awak, wain saya!
Dialog: 0,1:07:02.49,1:07:05.89,Lalai,,0,0,0,,Wain saya yang hebat!
Dialog: 0,1:07:09.03,1:07:10.29,Lalai,,0,0,0,,Dari kelopak pear yang sedang mekar.
Dialog: 0,1:07:11.29,1:07:14.13,Lalai,,0,0,0,,Saya datang berlari ke sini kerana saya ingin memberikan ini kepada anda secara peribadi.
Dialog: 0,1:07:14.63,1:07:16.37,Lalai,,0,0,0,,Akhirnya, buku itu sudah siap.
Dialog: 0,1:07:23.04,1:07:24.24,Lalai,,0,0,0,,"Direktori Latihan Tentera"?
Dialog: 0,1:07:24.91,1:07:26.14,Lalai,,0,0,0,,Nama baik.
Dialog: 0,1:07:26.31,1:07:27.61,Lalai,,0,0,0,,Semua terima kasih kepada anda.
Dialog: 0,1:07:28.58,1:07:30.75,Lalai,,0,0,0,,Ya, saya baru sahaja memberitahu anda apa yang saya lihat.
Dialog: 0,1:07:32.98,1:07:34.28,Lalai,,0,0,0,,Pada halaman seterusnya.
Dialog: 0,1:07:35.42,1:07:36.62,Lalai,,0,0,0,,Pada hari itu, Ahli Majlis Yang Berhormat...
Dialog: 0,1:07:38.52,1:07:41.92,Lalai,,0,0,0,,Dia menjadi tidak terkawal setiap kali dia melihat lukisan ini.
Dialog: 0,1:07:43.26,1:07:45.26,Lalai,,0,0,0,,Ya, lukisan di sini kelihatan hebat.
Dialog: 0,1:07:49.53,1:07:50.63,Lalai,,0,0,0,,Permaisuriku.
Dialog: 0,1:07:52.57,1:07:54.00,Lalai,,0,0,0,,Adakah anda kesepian?
Dialog: 0,1:07:57.77,1:08:00.44,Lalai,,0,0,0,,Saya tidak hidup lama sebagai orang biasa, tetapi masih
Dialog: 0,1:08:01.34,1:08:03.21,Lalai,,0,0,0,,bergelut dengan kesunyian
Dialog: 0,1:08:03.21,1:08:05.05,Lalai,,0,0,0,, dan sukar untuk saya menyesuaikan diri apabila saya tiba di sini.
Dialog: 0,1:08:06.92,1:08:09.85,Lalai,,0,0,0,,Tetapi anda sangat luar biasa,\Anda sepatutnya lebih kesepian.
Dialog: 0,1:08:10.49,1:08:11.95,Lalai,,0,0,0,,Saya risau.
Dialog: 0,1:08:12.69,1:08:14.46,Lalai,,0,0,0,,Saya tidak mempunyai masa untuk bersendirian.
Dialog: 0,1:08:14.66,1:08:17.23,Lalai,,0,0,0,,Kesukaran setiap hari dan berlari-lari.
Dialog: 0,1:08:28.17,1:08:31.21,Lalai,,0,0,0,,Seseorang pun memulakan kamus untuk memahami saya dengan lebih baik.
Dialog: 0,1:08:31.81,1:08:33.78,Lalai,,0,0,0,,Terima kasih kepadanya, saya tidak berasa sunyi langsung.
Dialog: 0,1:08:47.39,1:08:48.72,Lalai,,0,0,0,,Adakah masanya untuk ramen?
Dialog: 0,1:08:52.13,1:08:54.30,Lalai,,0,0,0,,Saya nak cakap atau tidak?
Dialog: 0,1:08:54.66,1:08:55.80,Lalai,,0,0,0,,Ya Tuhanku!
Dialog: 0,1:09:00.87,1:09:03.27,Lalai,,0,0,0,,Ini bukan sengaja. saya rasa sakit.
Dialog: 0,1:09:06.31,1:09:09.48,Lalai,,0,0,0,,Panggil doktor diraja dengan segera.
Dialog: 0,1:09:42.78,1:09:44.18,Lalai,,0,0,0,,Sesuatu yang serius?
Dialog: 0,1:09:47.45,1:09:49.15,Lalai,,0,0,0,,Permaisuri mengandung.
Dialog: 0,1:09:52.12,1:09:53.52,Lalai,,0,0,0,,Apa? mengandung?
Dialog: 0,1:09:56.36,1:09:57.53,Lalai,,0,0,0,,Adakah saya hamil?
Dialog: 0,1:10:01.26,1:10:03.77,Lalai,,0,0,0,,Tahniah, Tuanku.
Dialog: 0,1:10:10.21,1:10:11.57,Lalai,,0,0,0,,Permaisuriku, terima kasih.
Dialog: 0,1:10:20.48,1:10:23.65,Lalai,,0,0,0,,-Tahniah, Tuanku!\N-Tahniah, Tuanku!
Dialog: 0,1:10:26.46,1:10:28.56,Lalai,,0,0,0,,Saya akan menjadi seorang bapa!
Dialog: 0,1:10:49.48,1:10:50.68,Lalai,,0,0,0,,I
Dialog: 0,1:10:52.98,1:10:54.78,Lalai,,0,0,0,,hamil?
Dialog: 0,1:10:59.49,1:11:03.76,Lalai,,0,0,0,,Bagaimana saya menjadi seorang ratu
Dialog: 0,1:11:23.55,1:11:25.82,Lalai,,0,0,0,,Adakah saya hamil?
Dialog: 0,1:11:25.82,1:11:28.95,Lalai,,0,0,0,,Sekolah sebenar untuk wanita hamil bermula hari ini.
Dialog: 0,1:11:28.95,1:11:31.79,Lalai,,0,0,0,,Anda harus menolak hidangan luar biasa itu.
Dialog: 0,1:11:31.79,1:11:34.69,Lalai,,0,0,0,,Saya andaikan anda menyebarkan khabar angin seperti yang saya arahkan?
Dialog: 0,1:11:34.69,1:11:36.29,Lalai,,0,0,0,,Mereka sebenarnya tidak tidur bersama.
Dialog: 0,1:11:36.29,1:11:38.46,Lalai,,0,0,0,,Apa yang salah dengan pose? Betapa janggalnya.
Dialog: 0,1:11:38.46,1:11:40.33,Lalai,,0,0,0,,Ini tidak mencukupi untuk memadamkan khabar angin.
Dialog: 0,1:11:40.33,1:11:41.76,Lalai,,0,0,0,,Jika anda berkata demikian...
Dialog: 0,1:11:41.83,1:11:44.07,Lalai,,0,0,0,,Apa yang dipercayai semua orang menjadi benar.
Dialog: 0,1:11:44.07,1:11:46.60,Lalai,,0,0,0,,Bawa saya kepala permaisuri.
Dialog: 0,1:11:46.60,1:11:47.97,Lalai,,0,0,0,,Ini adalah pesanan.
Dialog: 0,1:11:47.97,1:11:50.24,Lalai,,0,0,0,,Jika saya mahu hidup, semua orang di sekeliling saya akan mati.
Dialog: 0,1:11:50.24,1:11:51.84,Lalai,,0,0,0,,Jadi saya akan terima semuanya.
Dialog: 0,0:14:45.74,0:14:47.74,Lalai,,0,0,0,,


