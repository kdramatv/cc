Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}كيف أصبحت
Dialogue: 0,0:00:58.00,0:01:03.98,الاسم,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ملكة
Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.22,0:01:06.28,Default,Lily1,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.28,0:01:08.51,Default,Lilia1,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:01:14.05,0:01:16.85,Default,Lily1,0,0,0,,أنا مدين لك بالكثير.
Dialogue: 0,0:01:19.92,0:01:21.93,Default,Lily1,0,0,0,,كنت أفكر فيك،
Dialogue: 0,0:01:23.73,0:01:25.60,Default,Lilia1,0,0,0,,عندما حاولت مغادرة القصر.
Dialogue: 0,0:01:28.97,0:01:31.00,Default,Lilia1,0,0,0,,ظننت أنني لن أراك مرة أخرى.
Dialogue: 0,0:01:58.33,0:02:00.60,Default,Lily1,0,0,0,,قبل ساعة
Dialogue: 0,0:02:06.34,0:02:08.64,Default,Lily1,0,0,0,,البطاطا الحلزونية
Dialogue: 0,0:02:10.57,0:02:15.41,Default,Lily1,0,0,0,,هل أنت نائم؟
Dialogue: 0,0:02:25.09,0:02:28.36,Default,Lily1,0,0,0,,نعم. لقد كتبت هذا.
Dialogue: 0,0:02:30.13,0:02:32.40,Default,Lilia1,0,0,0,,هل كتبت هذا فعلاً؟
Dialogue: 0,0:02:32.73,0:02:34.00,Default,Lily1,0,0,0,,لست ملكة؟
Dialogue: 0,0:02:34.16,0:02:37.63,Default,Lily1,0,0,0,,كانت الملكة في الوليمة.
Dialogue: 0,0:02:38.07,0:02:40.10,Default,Lily1,0,0,0,,إذاً لماذا قدمت الملف؟
Dialogue: 0,0:02:40.10,0:02:42.91,Default,Lily1,0,0,0,,العنب البري وإبر الصنوبر والخوخ؟
Dialogue: 0,0:02:43.34,0:02:47.14,Default,Lily1,0,0,0,,إنه مجرد موسم الخوخ،
Dialogue: 0,0:02:47.14,0:02:49.25,Default,Lily1,0,0,0,,يبدأ موسم العنب البري،
Dialogue: 0,0:02:49.25,0:02:51.35,Default,Lily1,0,0,0,,وهناك إبر الصنوبر على مدار السنة.
Dialogue: 0,0:02:51.75,0:02:52.82,Default,Lily1,0,0,0,,مانبوك.
Dialogue: 0,0:02:53.98,0:02:55.69,Default,Lily1,0,0,0,,انظر في عيني وأخبرني.
Dialogue: 0,0:03:10.00,0:03:14.34,Default,Lily1,0,0,0,,لم تكن الملكة تريدك أن تعرف أنها كانت تساعدك.
Dialogue: 0,0:03:20.24,0:03:22.91,Default,Lily1,0,0,0,,لقد فات الأوان. أعود هنا غدا.
Dialogue: 0,0:03:25.78,0:03:27.25,Default,Lily1,0,0,0,,ارجع إلى نفسك.
Dialogue: 0,0:03:27.95,0:03:30.85,Default,Lily1,0,0,0,,سأكتشف سبب مساعدتها لي
Dialogue: 0,0:03:31.79,0:03:33.59,Default,Lilia1,0,0,0,,وماذا يعني كلامها أنها ستخونني.
Dialogue: 0,0:03:42.40,0:03:44.67,Default,Lily1,0,0,0,,الملكة
Dialogue: 0,0:04:06.86,0:04:09.09,Default,Lily1,0,0,0,,الملكة في خطر.
Dialogue: 0,0:04:17.57,0:04:20.20,Default,Lily1,0,0,0,,عندما يبزغ الفجر، سأبلغ الملك.
Dialogue: 0,0:04:20.50,0:04:21.67,Default,Lily1,0,0,0,,هل سيكون بخير؟
Dialogue: 0,0:04:21.81,0:04:24.41,Default,Lily1,0,0,0,,خذ وقتك. قد يكون هذا فخًا.
Dialogue: 0,0:04:41.16,0:04:44.29,Default,Lily1,0,0,0,,أحيانًا تنام كالطفل.
Dialogue: 0,0:04:46.93,0:04:49.13,Default,Lily1,0,0,0,,أعتقد أنني سقطت في النوم.
Dialogue: 0,0:04:53.64,0:04:56.27,Default,Lily1,0,0,0,,هل كنت تعتني بي؟
Dialogue: 0,0:04:59.01,0:05:01.24,Default,Lily1,0,0,0,,لماذا تفعل هذا دائماً؟
Dialogue: 0,0:05:02.78,0:05:06.42,Default,Lily1,0,0,0,,تقلق بشأني، وتحاول أن تفهمني.
Dialogue: 0,0:05:07.85,0:05:12.69,Default,Lily1,0,0,0,,بالتفكير في الأمر، أنت أول شخص رأيته عندما أتيت إلى هنا.
Dialogue: 0,0:05:18.40,0:05:21.06,Default,Lily1,0,0,0,,أنا مدين لك بالكثير.
Dialogue: 0,0:05:24.33,0:05:26.24,Default,Lily1,0,0,0,,كنت أفكر فيك،
Dialogue: 0,0:05:28.04,0:05:29.87,Default,Lily1,0,0,0,,عندما حاولت مغادرة القصر.
Dialogue: 0,0:05:30.94,0:05:32.94,Default,Lily1,0,0,0,,ظننت أنني لن أراك مرة أخرى أبداً.
Dialogue: 0,0:06:42.05,0:06:44.21,Default,Lily1,0,0,0,,حضرة يونغ.
Dialogue: 0,0:06:47.68,0:06:50.12,Default,Lily1,0,0,0,,يبدو أنك تتدرب كثيرًا.
Dialogue: 0,0:06:50.55,0:06:52.09,Default,Lily1,0,0,0,,مفعم بالحيوية.
Dialogue: 0,0:07:06.97,0:07:08.14,Default,Lily1,0,0,0,,هذا حلم.
Dialogue: 0,0:07:08.31,0:07:09.71,Default,Lily1,0,0,0,,هونغ يونغ تحولت إليه
Dialogue: 0,0:07:09.71,0:07:11.31,Default,Lily1,0,0,0,,آخر مرة في حلمي.
Dialogue: 0,0:07:13.41,0:07:14.78,Default,Lily1,0,0,0,,هل أنت مستيقظ؟
Dialogue: 0,0:07:27.46,0:07:29.39,Default,Lily1,0,0,0,,ما هذا؟ ماذا تفعل؟
Dialogue: 0,0:07:29.39,0:07:33.73,Default,Lily1,0,0,0,,ماذا حدث؟ من أساء إلى ملكتي؟
Dialogue: 0,0:07:34.56,0:07:36.73,Default,Lily1,0,0,0,,أنت. لقد أساءت لي.
Dialogue: 0,0:07:39.37,0:07:41.30,Default,Lily1,0,0,0,,لماذا تم استبدال وجهها بوجهك؟
Dialogue: 0,0:07:41.84,0:07:42.84,Default,Lily1,0,0,0,,ماذا؟
Dialogue: 0,0:07:44.01,0:07:45.11,Default,Lily1,0,0,0,,كن صادقاً معي.
Dialogue: 0,0:07:45.38,0:07:47.48,Default,Lily1,0,0,0,,ماذا حدث بيننا ليلاً؟
Dialogue: 0,0:07:47.84,0:07:49.71,Default,Lily1,0,0,0,,إلى أي مدى يجب أن أكون صادقاً؟
Dialogue: 0,0:07:49.71,0:07:52.12,Default,Lily1,0,0,0,,قل كل شيء، دون ترك أي شيء.
Dialogue: 0,0:07:55.45,0:07:58.15,Default,Lily1,0,0,0,,يا رب. هذا طلب غريب.
Dialogue: 0,0:08:00.06,0:08:01.42,Default,Lily1,0,0,0,,إذا كان هذا ما تريده...
Dialogue: 0,0:08:04.53,0:08:07.66,Default,Lily1,0,0,0,,عندما أضاء القمر السماء المظلمة الليلة الماضية،
Dialogue: 0,0:08:07.66,0:08:10.83,Default,Lily1,0,0,0,,تلامست أيدينا قليلاً، ثم الألعاب النارية...
Dialogue: 0,0:08:10.83,0:08:13.60,Default,Lily1,0,0,0,,كن هادئاً. إذا قلت أي شيء، سأقتلك.
Dialogue: 0,0:08:13.60,0:08:14.67,Default,Lily1,0,0,0,,لكن...
Dialogue: 0,0:08:15.67,0:08:17.67,Default,Lily1,0,0,0,,هذه مجرد البداية يا ملكتي.
Dialogue: 0,0:08:19.34,0:08:20.48,Default,Lily1,0,0,0,,ملكتي.
Dialogue: 0,0:08:21.28,0:08:22.48,Default,Lily1,0,0,0,,يا رب.
Dialogue: 0,0:08:26.88,0:08:27.98,Default,Lily1,0,0,0,,الشعور,
Dialogue: 0,0:08:28.95,0:08:31.92,Default,Lily1,0,0,0,,كما لو كنت مهجوراً.
Dialogue: 0,0:08:32.39,0:08:33.86,Default,Lily1,0,0,0,,يا إلهي.
Dialogue: 0,0:08:35.26,0:08:36.29,Default,Lily1,0,0,0,,رئيس الخصي.
Dialogue: 0,0:08:36.29,0:08:38.70,Default,Lily1,0,0,0,,حضرة يونغ. هونغ يونغ.
Dialogue: 0,0:08:39.60,0:08:40.86,Default,Lily1,0,0,0,,أين نمت اليوم؟
Dialogue: 0,0:08:41.36,0:08:42.83,Default,Lily1,0,0,0,,في المنزل يا صاحب الجلالة.
Dialogue: 0,0:08:44.90,0:08:47.07,Default,Lily1,0,0,0,,أنا وتشيولجونغ حقاً...
Dialogue: 0,0:09:12.33,0:09:15.37,Default,Lily1,0,0,0,,14 حلقة. المرأة التي يجب أن تموت لتعيش
Dialogue: 0,0:09:24.21,0:09:26.04,Default,Lily1,0,0,0,,كان كل ذلك حلماً.
Dialogue: 0,0:09:27.38,0:09:29.58,Default,Lily1,0,0,0,,صورة الملك الراحل كانت تحترق،
Dialogue: 0,0:09:29.81,0:09:31.88,Default,Lily1,0,0,0,,وبدا كل شيء حقيقياً جداً.
Dialogue: 0,0:09:33.05,0:09:34.98,Default,Lily1,0,0,0,,بعد ما حدث مع العراف،
Dialogue: 0,0:09:34.98,0:09:36.92,Default,Lily1,0,0,0,,لا أستطيع التنبؤ بمصيري.
Dialogue: 0,0:09:40.86,0:09:42.03,Default,Lily1,0,0,0,,هاجس مشؤوم.
Dialogue: 0,0:09:42.63,0:09:45.56,Default,Lily1,0,0,0,,سيدة البلاط خان. أحتاج إلى التنبؤ بالمصير.
Dialogue: 0,0:09:46.46,0:09:49.07,Default,Lily1,0,0,0,,جلالتك. وهذا سوف يسبب لك المتاعب مرة أخرى.
Dialogue: 0,0:09:49.43,0:09:51.20,Default,Lily1,0,0,0,,أنا أعرف راهباً.
Dialogue: 0,0:09:52.60,0:09:55.34,Default,Lily1,0,0,0,,لن يبدو الأمر مريبًا.
Dialogue: 0,0:10:00.18,0:10:04.95,Default,Lily1,0,0,0,,عندما كان أفالوكيتسفارا يمارس البراجناباراميتا العميق،
Dialogue: 0,0:10:04.95,0:10:08.05,Default,Lily1,0,0,0,,أضاء خمس اسكندها ورأى أنها كلها فارغة...
Dialogue: 0,0:10:12.22,0:10:13.32,Default,Lily1,0,0,0,,ماذا ترى؟
Dialogue: 0,0:10:13.32,0:10:16.79,Default,Lily1,0,0,0,,أرى أن القصر مملوء بالدم القرمزي.
Dialogue: 0,0:10:17.49,0:10:18.83,Default,Lily1,0,0,0,,دم قرمزي؟
Dialogue: 0,0:10:20.23,0:10:21.73,Default,Lily1,0,0,0,,اليوم شخص ما
Dialogue: 0,0:10:22.53,0:10:24.17,Default,Lily1,0,0,0,,سوف تموت في القصر.
Dialogue: 0,0:10:26.50,0:10:27.97,Default,Lily1,0,0,0,,ومن؟
Dialogue: 0,0:10:28.44,0:10:30.61,Default,Lily1,0,0,0,,لا أعرف من هو،
Dialogue: 0,0:10:38.48,0:10:39.75,Default,Lily1,0,0,0,,لكنها ستكون امرأة.
Dialogue: 0,0:10:40.25,0:10:41.35,Default,Lily1,0,0,0,,امرأة؟
Dialogue: 0,0:10:43.55,0:10:45.16,Default,Lily1,0,0,0,,حقاً
Dialogue: 0,0:10:46.26,0:10:47.76,Default,Lily1,0,0,0,,هل سأكون أنا؟
Dialogue: 0,0:10:47.92,0:10:51.09,Default,Lily1,0,0,0,,ارسم لي تعويذة للحماية.
Dialogue: 0,0:10:51.09,0:10:53.80,Default,Lily1,0,0,0,,أنا لست شاماناً.
Dialogue: 0,0:10:54.13,0:10:56.20,Default,Lily1,0,0,0,,لا بد من وجود طريقة.
Dialogue: 0,0:10:56.87,0:10:58.23,Default,Lily1,0,0,0,,إذا كنت مصراً،
Dialogue: 0,0:10:59.00,0:11:01.30,Default,Lily1,0,0,0,,قدم قربانًا لبوذا.
Dialogue: 0,0:11:02.44,0:11:05.14,Default,Lily1,0,0,0,,بالضبط. سأعطيك بقدر ما تريد.
Dialogue: 0,0:11:07.08,0:11:09.78,Default,Lily1,0,0,0,,الذي يموت في القصر،
Dialogue: 0,0:11:10.11,0:11:12.45,Default,Lily1,0,0,0,,لن أكون أنا.
Dialogue: 0,0:11:15.72,0:11:16.79,Default,Lily1,0,0,0,,اللعنة!
Dialogue: 0,0:11:18.45,0:11:21.06,Default,Lily1,0,0,0,,لم أطرح على الملكة السؤال الذي أردته.
Dialogue: 0,0:11:22.09,0:11:23.09,Default,Lily1,0,0,0,,يا رب.
Dialogue: 0,0:11:23.39,0:11:25.03,Default,Lily1,0,0,0,,سأعود إلى دايجون.
Dialogue: 0,0:11:25.53,0:11:26.56,Default,Lily1,0,0,0,,جلالتك.
Dialogue: 0,0:11:30.13,0:11:31.67,Default,Lily1,0,0,0,,مريب.
Dialogue: 0,0:11:32.94,0:11:35.14,Default,Lily1,0,0,0,,بالنظر إلى مدى اختفائه فجأة.
Dialogue: 0,0:11:41.04,0:11:42.18,Default,Lily1,0,0,0,,صحيح.
Dialogue: 0,0:11:42.51,0:11:44.75,Default,Lily1,0,0,0,,أستطيع أن أرسمها بنفسي.
Dialogue: 0,0:11:53.39,0:11:54.62,Default,Lily1,0,0,0,,هذا سيفي بالغرض.
Dialogue: 0,0:12:00.50,0:12:02.27,Default,Lily1,0,0,0,,صحيح. مثله.
Dialogue: 0,0:12:03.13,0:12:05.67,Default,Lily1,0,0,0,,أرى بوضوح. مثله.
Dialogue: 0,0:12:07.84,0:12:09.64,Default,Lily1,0,0,0,,لا! خطأ!
Dialogue: 0,0:12:12.01,0:12:13.34,Default,Lily1,0,0,0,,وجهه...
Dialogue: 0,0:12:17.38,0:12:18.88,Default,Lily1,0,0,0,,هذا هو وجهه.
Dialogue: 0,0:12:21.75,0:12:23.42,Default,Lily1,0,0,0,,عزيزتي!
Dialogue: 0,0:12:29.73,0:12:31.79,Default,Lily1,0,0,0,,هل بكيت طوال الطريق؟
Dialogue: 0,0:12:34.33,0:12:37.07,Default,Lily1,0,0,0,,حسناً. حسنًا.
Dialogue: 0,0:12:37.07,0:12:38.90,Default,Lily1,0,0,0,,حسناً. حسنًا.
Dialogue: 0,0:12:40.57,0:12:43.17,Default,Lily1,0,0,0,,لماذا لم أعتقد أنها قد لا تحبني؟
Dialogue: 0,0:12:43.77,0:12:47.91,Default,Lily1,0,0,0,,لماذا كنت أفكر منذ أيام عديدة،
Dialogue: 0,0:12:48.08,0:12:50.55,Default,Lily1,0,0,0,,هل تختار الحب أم العائلة؟
Dialogue: 0,0:12:51.21,0:12:53.82,Default,Lily1,0,0,0,,أكبر عائق في الحب هو
Dialogue: 0,0:12:53.82,0:12:56.02,Default,Lily1,0,0,0,,هذا ليس أكثر من
Dialogue: 0,0:12:56.02,0:12:58.29,Default,Lily1,0,0,0,,الفوز بقلب من تحب.
Dialogue: 0,0:12:59.46,0:13:01.06,Default,Lily1,0,0,0,,ما هو السبب؟
Dialogue: 0,0:13:01.56,0:13:02.73,Default,Lily1,0,0,0,,قالت:
Dialogue: 0,0:13:03.56,0:13:04.99,Default,Lily1,0,0,0,,أنا لا أحبك.
Dialogue: 0,0:13:05.83,0:13:06.90,Default,Lily1,0,0,0,,ماذا؟
Dialogue: 0,0:13:07.80,0:13:08.80,Default,Lily1,0,0,0,,وداعا.
Dialogue: 0,0:13:10.57,0:13:11.70,Default,Lily1,0,0,0,,انتظر.
Dialogue: 0,0:13:12.77,0:13:15.34,Default,Lily1,0,0,0,,أخبرني لماذا.
Dialogue: 0,0:13:15.87,0:13:17.31,Default,Lily1,0,0,0,,لماذا لا تحبني؟
Dialogue: 0,0:13:21.81,0:13:22.98,Default,Lily1,0,0,0,,أنا
Dialogue: 0,0:13:24.31,0:13:26.28,Default,Lily1,0,0,0,,أنا لا أحب الرجال الطموحين.
Dialogue: 0,0:13:28.28,0:13:30.65,Default,Spilik2,0,0,0,,الصمت، الصمت.
Dialogue: 0,0:13:32.92,0:13:35.19,Default,Spikyulka2,0,0,0,,هنا الرطوبة.
Dialogue: 0,0:13:35.89,0:13:39.46,Default,Spikyulka2,0,0,0,,الحب يبدأ بالرطوبة
Dialogue: 0,0:13:39.46,0:13:42.03,Default,Spikyulka2,0,0,0,,وينتهي بهذه الرطوبة.
Dialogue: 0,0:13:44.93,0:13:46.64,Default,Spikyulka2,0,0,0,,-ولكن...\N-اللعنة، لقد أخافتك.
Dialogue: 0,0:13:46.67,0:13:48.20,Default,Spikyulka2,0,0,0,,هناك أخبار جيدة.
Dialogue: 0,0:13:48.20,0:13:50.11,Default,Spilik2,0,0,0,,شعر الملك بالتحسن،
Dialogue: 0,0:13:51.21,0:13:52.71,Default,Spikyulka2,0,0,0,,تم الرد على صلواتي.
Dialogue: 0,0:13:54.08,0:13:56.08,Default,Spikyulka2,0,0,0,,أنا متأكد أنك سمعت شيئاً آخر.
Dialogue: 0,0:13:58.25,0:14:01.72,Default,Spikyulka2,0,0,0,,سيتم تخفيض رتبة كيم جواجيون بسبب هذا الحادث.
Dialogue: 0,0:14:02.49,0:14:05.76,Default,Spilik2,0,0,0,,أنا أحب الملك، وأحترم كيم جواجيون.
Dialogue: 0,0:14:06.22,0:14:08.56,Default,Spilik2,0,0,0,,قلبي ينكسر إلى أشلاء.
Dialogue: 0,0:14:08.69,0:14:11.89,Default,Spikyulka2,0,0,0,,كيف يمكنك أن تحب الملك لأنك لا تعرفه شخصياً.
Dialogue: 0,0:14:13.40,0:14:15.67,Default,Spilik2,0,0,0,,في النهاية، هو أفضل صديق لك.
Dialogue: 0,0:14:15.80,0:14:17.60,Default,Spilik2,0,0,0,,أنت شخص جيد،
Dialogue: 0,0:14:17.60,0:14:19.60,Default,Spikyulka2,0,0,0,,لذا يجب أن يكون صديقك هكذا.
Dialogue: 0,0:14:21.40,0:14:22.67,Default,Spikyulka2,0,0,0,,حسناً، لقد أنهيت الأمر.
Dialogue: 0,0:14:29.21,0:14:30.75,Default,Spilik2,0,0,0,,هل ترسم أخطبوطاً؟
Dialogue: 0,0:14:30.88,0:14:33.55,Default,Spikyulka2,0,0,0,,ماذا يعني "الأخطبوط"؟ هذا رجل.
Dialogue: 0,0:14:35.05,0:14:36.15,Default,Spilik2,0,0,0,,هذا؟
Dialogue: 0,0:14:36.72,0:14:39.02,Default,Spikyulka2,0,0,0,,لقد رسمتها جيدًا، إذا نظرت عن كثب إلى التفاصيل.
Dialogue: 0,0:14:40.89,0:14:43.16,Default,Spilik2,0,0,0,,-يجب أن تكون هذه العيون.\N-هذا هو الفم.
Dialogue: 0,0:14:45.46,0:14:48.00,Default,Silk2,0,0,0,,-هل هذا فمه؟\N-ألا يمكنك رؤية شفتيه؟
Dialogue: 0,0:14:53.87,0:14:56.94,Default,Spikyulka2,0,0,0,,من الأفضل قراءة التوقعات في الصباح.
Dialogue: 0,0:14:59.41,0:15:01.81,Default,Spilik2,0,0,0,,الملكة الأم، صاحبة السمو هنا.
Dialogue: 0,0:15:06.18,0:15:07.25,Default,Spilik2,0,0,0,,يا رب.
Dialogue: 0,0:15:07.85,0:15:11.99,Default,Spilyk2,0,0,0,,ليس لديك وجه.
Dialogue: 0,0:15:12.79,0:15:16.93,Default,Spilik2,0,0,0,,وكأن الملك لم يستيقظ.
Dialogue: 0,0:15:17.46,0:15:20.06,Default,Spikyulka2,0,0,0,,كيف تسير الأمور مع الملكة؟
Dialogue: 0,0:15:21.06,0:15:23.23,Default,Spikyulka2,0,0,0,,لم أعد أرى أي فائدة منه بعد الآن
Dialogue: 0,0:15:23.80,0:15:25.70,Default,Spikyulka2,0,0,0,,وفعلت ما طلبته.
Dialogue: 0,0:15:26.54,0:15:29.21,Default,Spillit2,0,0,0,,أنا متأكد من هذا العنصر
Dialogue: 0,0:15:29.21,0:15:31.34,Default,Spillie2,0,0,0,,وجدت في غرفتها.
Dialogue: 0,0:15:31.71,0:15:35.71,Default,Spilik2,0,0,0,,قضى الملك الليلة الماضية في حجرة الملكة.
Dialogue: 0,0:15:35.95,0:15:37.98,Default,Spilyk2,0,0,0,,حالاً، كيف تعافيت؟
Dialogue: 0,0:15:38.15,0:15:40.38,Default,Spikyulka2,0,0,0,,بسبب حادثة الانفجار تلك، أدركت
Dialogue: 0,0:15:41.52,0:15:44.65,Default,Spikyulka2,0,0,0,,أنني إذا فقدتها سأموت.
Dialogue: 0,0:15:45.35,0:15:47.49,Default,Spillie2,0,0,0,,المرأة التي ستموت اليوم...
Dialogue: 0,0:15:48.12,0:15:49.63,Default,Spilik2,0,0,0,,حقاً؟..
Dialogue: 0,0:16:20.02,0:16:21.46,Default,Spilik2,0,0,0,,أريد أن أموت.
Dialogue: 0,0:16:21.89,0:16:23.43,Default,Spilik2,0,0,0,,هل يجب أن أقتل نفسي؟
Dialogue: 0,0:16:23.63,0:16:25.50,Default,Spilik2,0,0,0,,ربما إذا مت، سأشعر بتحسن؟
Dialogue: 0,0:16:33.17,0:16:35.81,Default,Spilik2,0,0,0,,عذراً أيتها الملكة، ارحمي.
Dialogue: 0,0:16:36.11,0:16:38.74,Default,Spilyk2,0,0,0,,لقد أنكرت كل شيء،
Dialogue: 0,0:16:38.74,0:16:41.04,Default,Spikyulka2,0,0,0,,لكن الملك كان متأكداً جداً.
Dialogue: 0,0:16:42.28,0:16:43.61,Default,Spilik2,0,0,0,,ماذا؟ ما الذي تتحدث عنه؟
Dialogue: 0,0:16:45.05,0:16:46.18,Default,Spilik2,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:16:47.18,0:16:49.39,Default,Spilik2,0,0,0,,هل يمكنك أن تشم رائحة الاحتراق؟
Dialogue: 0,0:16:49.55,0:16:52.52,Default,Spilyk2,0,0,0,,بمن يفعلون؟ أي واحد منكم؟
Dialogue: 0,0:16:52.52,0:16:53.72,Default,Spikyulka2,0,0,0,,-إلى أين أنت ذاهب؟\N-دعني أذهب.
Dialogue: 0,0:16:55.96,0:16:57.36,Default,Spillit2,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,0:17:02.50,0:17:03.73,Default,Spilyk2,0,0,0,,في النهاية
Dialogue: 0,0:17:04.53,0:17:06.70,Default,Spilyk2,0,0,0,,لقد أخبرته بكل شيء.
Dialogue: 0,0:17:10.01,0:17:11.07,Default,Spilik2,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:17:11.37,0:17:13.61,Default,Spikyulka2,0,0,0,,دعني أوضح هذا.
Dialogue: 0,0:17:13.61,0:17:16.01,Default,Silk2,0,0,0,,جاءني الملك بالأمس ليتحدث معك،
Dialogue: 0,0:17:16.01,0:17:18.21,Default,Spikyulka2,0,0,0,,وبالتالي كل هذه الفوضى. لذا؟
Dialogue: 0,0:17:18.21,0:17:19.75,Default,Spikyulka2,0,0,0,,لم أقل شيئاً كهذا.
Dialogue: 0,0:17:21.38,0:17:23.79,Default,Spikyulka2,0,0,0,,لذا أنا في حيرة من أمري
Dialogue: 0,0:17:25.25,0:17:27.56,Default,Spilik2,0,0,0,,خطأك.
Dialogue: 0,0:17:27.76,0:17:30.26,Default,Spilik2,0,0,0,,ماذا؟ لماذا أنت مرتبك؟
Dialogue: 0,0:17:30.26,0:17:31.86,Default,Spilik2,0,0,0,,أنت!
Dialogue: 0,0:17:34.20,0:17:35.67,Default,Spikyulka2,0,0,0,,كان ذلك جيداً.
Dialogue: 0,0:17:36.80,0:17:38.20,Default,Spikyulka2,0,0,0,,ربما أفضل من المرة السابقة.
Dialogue: 0,0:17:39.20,0:17:41.00,Default,Spilik2,0,0,0,,لهذا السبب أصابني بالجنون!
Dialogue: 0,0:17:41.87,0:17:44.31,Default,Spilik2,0,0,0,,لماذا أعجبتني؟ هذا لا ينبغي أن يحدث.
Dialogue: 0,0:17:45.21,0:17:46.81,Default,Spilyk2,0,0,0,,إذن الروح لا تتحكم في الجسد؟
Dialogue: 0,0:17:47.14,0:17:49.01,Default,Spikyulka2,0,0,0,,إذن العقل والجسد خارجان عن سيطرتنا؟
Dialogue: 0,0:17:49.01,0:17:51.08,Default,Spilik2,0,0,0,,الهرمونات تحكم كل شيء؟
Dialogue: 0,0:17:52.55,0:17:54.32,Default,Spilik2,0,0,0,,-كابوس.\N-جلالتك.
Dialogue: 0,0:17:56.85,0:17:58.85,Default,Spikyulka2,0,0,0,,-ما بها؟\N-جلالتك.
Dialogue: 0,0:17:59.69,0:18:00.99,Default,Spikyulka2,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:18:02.29,0:18:05.90,Default,Spilik2,0,0,0,,إنها بروحها الخاصة.
Dialogue: 0,0:18:08.90,0:18:10.80,Default,Spilik2,0,0,0,,لماذا لم تشعر بالاشمئزاز؟
Dialogue: 0,0:18:11.33,0:18:13.00,Default,Spilik2,0,0,0,,لماذا؟
Dialogue: 0,0:18:13.80,0:18:18.21,Default,Spilik2,0,0,0,,أشعر! يشعر بالاشمئزاز. يجب أن تكره ذلك!
Dialogue: 0,0:18:18.21,0:18:20.34,Default,Silk2,0,0,0,,استعد لتحية جلالته.
Dialogue: 0,0:18:26.72,0:18:28.08,Default,Spilik2,0,0,0,,أين ملكتي؟
Dialogue: 0,0:18:28.48,0:18:30.15,Default,Spilik2,0,0,0,,جلالة الملك، هي...
Dialogue: 0,0:18:34.06,0:18:37.56,Default,Spilik2,0,0,0,,عذراً. لقد كانت هنا للتو.
Dialogue: 0,0:18:39.20,0:18:41.56,Default,Spilik2,0,0,0,,هل ذهبت إلى هذا الحد لتختبئ مني؟
Dialogue: 0,0:18:41.83,0:18:43.93,Default,Spilik2,0,0,0,,الليلة الماضية مثل النمرة...
Dialogue: 0,0:18:43.93,0:18:45.60,Default,Spilik2,0,0,0,,Rrrrr!
Dialogue: 0,0:18:51.04,0:18:53.21,Default,Spilik2,0,0,0,,هل يمكنك مساعدتي في العثور على الملكة؟
Dialogue: 0,0:18:53.64,0:18:54.74,Default,Spikyulka2,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:18:54.91,0:18:57.01,Default,Spikyulka2,0,0,0,,كما ترون، لدي الكثير لأقوله لها.
Dialogue: 0,0:19:00.68,0:19:02.15,Default,Spilyk2,0,0,0,,أتساءل ما هو بالضبط.
Dialogue: 0,0:19:09.03,0:19:11.63,Default,Spilik2,0,0,0,,لا. إذا التقيت به الآن، سأكون في ورطة كبيرة.
Dialogue: 0,0:19:12.06,0:19:13.96,Default,Spilik2,0,0,0,,ماذا لو خانني جسدي مرة أخرى؟
Dialogue: 0,0:19:14.30,0:19:15.36,Default,Spilik2,0,0,0,,بالضبط.
Dialogue: 0,0:19:15.36,0:19:18.47,Default,Spilik2,0,0,0,,أنا متأكدة من أن روح "كيم سو يون" استحوذت عليه الليلة الماضية.
Dialogue: 0,0:19:20.10,0:19:23.04,Default,Spikyulka2,0,0,0,,ولقد أحببته فقط لأنني اعتقدت أنه هونغ يونغ.
Dialogue: 0,0:19:23.04,0:19:24.77,Default,Spikyulka2,0,0,0,,ليتني أعرف أنه هو...
Dialogue: 0,0:19:28.18,0:19:29.31,Default,Spikyulka2,0,0,0,,لكنني ما زلت أحب ذلك.
Dialogue: 0,0:19:30.38,0:19:32.21,Default,Spilik2,0,0,0,,سأصاب بالجنون بالتأكيد.
Dialogue: 0,0:19:40.59,0:19:43.09,Default,Spilik2,0,0,0,,ماذا لو اختفى جانغ بونغ هوان إلى الأبد؟
Dialogue: 0,0:19:44.69,0:19:45.83,Default,Spilik2,0,0,0,,ماذا لو؟
Dialogue: 0,0:19:45.83,0:19:47.03,Default,Spilik2,0,0,0,,ما كان يجب أن أصل إلى هنا.\NJang Bong-hwan
Dialogue: 0,0:19:47.03,0:19:48.97,Default,Silk2,0,0,0,,-ملكتي.\N-جلالتك!
Dialogue: 0,0:19:49.43,0:19:50.67,Default,Spilik2,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:19:50.67,0:19:51.70,Default,Spilik2,0,0,0,,يا إلهي.
Dialogue: 0,0:19:53.10,0:19:54.17,Default,Spilyk2,0,0,0,,جلالتك.
Dialogue: 0,0:19:55.87,0:19:56.94,Default,Spilik2,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:19:58.14,0:20:00.18,Default,Spilik2,0,0,0,,-جلالتك.\N-ملكتي.
Dialogue: 0,0:20:01.41,0:20:02.48,Default,Spilik2,0,0,0,,ملكتي.
Dialogue: 0,0:20:04.41,0:20:06.72,Default,Spilik2,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:20:13.62,0:20:14.62,Default,Spilik2,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:20:15.79,0:20:16.89,Default,Spilik2,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:20:17.93,0:20:20.00,Default,Silk2,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:20:22.06,0:20:23.07,Default,Spilik2,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:20:25.97,0:20:28.54,Default,Spikyulka2,0,0,0,,كيم جواجيون على وشك أن يفقد منصبه،
Dialogue: 0,0:20:28.54,0:20:30.97,Default,Silk2,0,0,0,,بعد كل شيء، أوضح أنه كان يحاول التخلص من الملك.
Dialogue: 0,0:20:31.27,0:20:32.31,Default,Spilik2,0,0,0,,لا يصدق.
Dialogue: 0,0:20:34.24,0:20:36.28,Default,Spilyk2,0,0,0,,كلما فكرت في الأمر أكثر،
Dialogue: 0,0:20:36.28,0:20:38.28,Default,Spikyulka2,0,0,0,,كلما زاد اقتناعي بأن هذا ليس أسلوبه.
Dialogue: 0,0:20:39.05,0:20:40.65,Default,Spikyulka2,0,0,0,,بالتأكيد يشعر بأنه مدفوع إلى الزاوية.
Dialogue: 0,0:20:40.98,0:20:42.89,Default,Spikyulka2,0,0,0,,بسبب ذلك الانفجار
Dialogue: 0,0:20:42.89,0:20:45.12,Default,Spikyulka2,0,0,0,,فقد كيم جواجيون كل شيء.
Dialogue: 0,0:20:45.65,0:20:47.99,Default,Spikyulka2,0,0,0,,ومن ناحية أخرى، فاز الملك فقط.
Dialogue: 0,0:20:47.99,0:20:49.23,Default,Spilyk2,0,0,0,,حتى لو كان الأمر كذلك،
Dialogue: 0,0:20:49.23,0:20:52.29,Default,Spikyulka2,0,0,0,,أشك في أن الملك نفسه هو الذي تسبب في الانفجار، مخاطراً بحياته.
Dialogue: 0,0:20:53.80,0:20:54.90,Default,Spilik2,0,0,0,,وهذا صحيح.
Dialogue: 0,0:20:57.57,0:20:59.97,Default,Spilik2,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:21:00.10,0:21:02.44,Default,Spikyulka2,0,0,0,,-هل أنت ذاهب إلى المجلس؟\N-نعم.
Dialogue: 0,0:21:02.87,0:21:06.24,Default,Spilyk2,0,0,0,,هل لي أن أسأل، لماذا أنتم وحدكم؟
Dialogue: 0,0:21:07.28,0:21:08.28,Default,Spilik2,0,0,0,,ملكتي...
Dialogue: 0,0:21:08.38,0:21:09.45,Default,Spilik2,0,0,0,,-الملكة?\N-الملكة؟
Dialogue: 0,0:21:14.95,0:21:17.45,Default,Spikyulka2,0,0,0,,جلالتك، هل تلعب الغميضة؟
Dialogue: 0,0:21:17.82,0:21:20.16,Default,Spikyulka2,0,0,0,,-ألعبها بشكل رائع!\N-Hush.
Dialogue: 0,0:21:28.20,0:21:29.27,Default,Spilyk2,0,0,0,,تم العثور عليه.
Dialogue: 0,0:21:29.27,0:21:31.57,Default,Spillie2,0,0,0,,مثير للغضب. توقف عن ملاحقتي!
Dialogue: 0,0:21:31.57,0:21:33.44,Default,Spilyk2,0,0,0,,هل أنت مصور؟ أو مطارد؟
Dialogue: 0,0:21:33.44,0:21:34.97,Default,Spikyulka2,0,0,0,,-فهمت.\N-ماذا؟
Dialogue: 0,0:21:34.97,0:21:37.17,Default,Spilik2,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:21:37.17,0:21:39.24,Default,Spikyulka2,0,0,0,,-أراك في المجلس الملكي.\N-حسناً.
Dialogue: 0,0:21:39.44,0:21:41.74,Default,Spikyulka2,0,0,0,,دعونا نناقش كل شيء بهدوء.
Dialogue: 0,0:21:41.74,0:21:42.78,Default,Spillie2,0,0,0,,الملكة.
Dialogue: 0,0:21:42.78,0:21:44.88,Default,Spilik2,0,0,0,,إنهم مجانين بالحب تماماً.
Dialogue: 0,0:21:44.88,0:21:46.88,Default,Spikyulka2,0,0,0,,-ملكتي!\N-هل تلعب الغميضة؟
Dialogue: 0,0:21:47.42,0:21:48.95,Default,Spilik2,0,0,0,,مثل الأطفال الصغار.
Dialogue: 0,0:21:48.95,0:21:52.76,Default,Spilik2,0,0,0,,ماذا؟ يلعب الغميضة متى
Dialogue: 0,0:21:53.39,0:21:54.86,Default,Spikyulka2,0,0,0,,أوشكت على الموت مؤخراً؟
Dialogue: 0,0:21:58.13,0:22:00.33,Default,Spilik2,0,0,0,,بالضبط. هناك محظيات ملكية.
Dialogue: 0,0:22:00.46,0:22:02.20,Default,Spikyulka2,0,0,0,,كانت لدينا مراسلات حب طوال الليل.
Dialogue: 0,0:22:02.20,0:22:04.83,Default,Spilik2,0,0,0,,إنهم الملائكة الحارسة لميولي الجنسية!
Dialogue: 0,0:22:04.83,0:22:07.14,Default,Tolenka3,0,0,0,,جلالتك، نحن نرحب بك.
Dialogue: 0,0:22:07.14,0:22:08.84,Default,Tolenka3,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:22:11.17,0:22:12.41,Default,Tolenka3,0,0,0,,حسنًا، أتمنى لك يومًا سعيدًا.
Dialogue: 0,0:22:15.51,0:22:16.51,Default,Tolenka3,0,0,0,,ملكتي.
Dialogue: 0,0:22:17.35,0:22:19.11,Default,Tolenka3,0,0,0,,يجب ألا تركض في الفناء.
Dialogue: 0,0:22:19.78,0:22:22.59,Default,Tolenka3,0,0,0,,يبدو أن هذين الاثنين، باستثناء بعضهما البعض، لا يحتاجان إلى أي شخص آخر.
Dialogue: 0,0:22:23.79,0:22:24.82,Default,Tolenka3,0,0,0,,يبدو الأمر كذلك.
Dialogue: 0,0:22:24.82,0:22:28.86,Default,Tolenka3,0,0,0,,بالمناسبة، كم يبدون جميلين.
Dialogue: 0,0:22:35.06,0:22:37.77,Default,Tolenka3,0,0,0,,ممتاز. دعونا نكتب للسيدات، الانحرافات مؤكدا في التوجه لن يحدث بعد الآن.
Dialogue: 0,0:22:39.27,0:22:41.24,Default,Tolenka3,0,0,0,,-ملكتي. \N-صاحب الجلالة.
Dialogue: 0,0:22:42.97,0:22:43.97,Default,Tolenka3,0,0,0,,ملكتي.
Dialogue: 0,0:23:05.86,0:23:07.13,Default,Tolenka3,0,0,0,,وهي ليست هنا.
Dialogue: 0,0:23:08.50,0:23:12.33,Default,Tolenka3,0,0,0,,أنا لا أركض خلفها فقط. أريد أن أسألك شيئا.
Dialogue: 0,0:23:12.87,0:23:14.10,Default,Tolenka3,0,0,0,,اسأل؟
Dialogue: 0,0:23:14.10,0:23:16.44,Default,Tolenka3,0,0,0,,لكنها تبدو غير مرتاحة حولي.
Dialogue: 0,0:23:18.04,0:23:19.21,Default,Tolenka3,0,0,0,,حان وقت التوقف.
Dialogue: 0,0:23:20.94,0:23:22.71,Default,Tolenka3,0,0,0,,أتمنى ذلك عندما يكون لديها مشاعر
Dialogue: 0,0:23:24.45,0:23:26.42,Default,Tolenka3,0,0,0,,تقرر أنها ستأتي إلي بنفسها.
Dialogue: 0,0:23:34.26,0:23:36.53,Default,Tolenka3,0,0,0,, - حان وقت الذهاب إلى غرفة الاجتماعات. \N-نعم.
Dialogue: 0,0:23:40.63,0:23:41.76,Default,Tolenka3,0,0,0,,ها أنت ذا.
Dialogue: 0,0:23:42.97,0:23:44.77,Default,Tolenka3,0,0,0,,يبدو أنك تجولت في القصر بأكمله اليوم.
Dialogue: 0,0:23:44.77,0:23:46.27,Default,Tolenka3,0,0,0,,أنا أركض خلفك منذ الصباح.
Dialogue: 0,0:23:46.90,0:23:48.10,Default,Tolenka3,0,0,0,,ماذا حدث؟
Dialogue: 0,0:23:51.51,0:23:54.11,Default,Tolenka3,0,0,0,,ها أنت ذا. الليلة الماضية...
Dialogue: 0,0:23:55.78,0:23:57.18,Default,Tolenka3,0,0,0,,دعونا نناقش كل شيء على طول الطريق.
Dialogue: 0,0:23:57.81,0:23:58.85,Default,Tolenka3,0,0,0,,لنذهب.
Dialogue: 0,0:23:59.55,0:24:00.68,Default,Tolenka3,0,0,0,,إلى أين نحن ذاهبون؟
Dialogue: 0,0:24:01.68,0:24:02.82,Default,Tolenka3,0,0,0,,هل نذهب إلى مكان ما مرة أخرى؟
Dialogue: 0,0:24:06.36,0:24:07.79,Default,Tolenka3,0,0,0,,القصر كبير جدًا.
Dialogue: 0,0:24:33.35,0:24:34.38,Default,Tolenka3,0,0,0,,هل ذهبت؟
Dialogue: 0,0:24:37.42,0:24:39.39,Default,Tolenka3,0,0,0,,ماذا أراد أن يسأل؟
Dialogue: 0,0:24:41.69,0:24:44.46,Default,Tolenka3,0,0,0,,ماذا يسأل الرجال في مثل هذه المواقف؟
Dialogue: 0,0:24:46.13,0:24:47.16,Default,Tolenka3,0,0,0,,حسناً، هل كانت جيدة؟
Dialogue: 0,0:24:57.41,0:24:58.71,Default,Tolenka3,0,0,0,,أرسل كالمعتاد.
Dialogue: 0,0:25:00.74,0:25:01.98,Default,Tolenka3,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:25:04.58,0:25:05.88,Default,Tolenka3,0,0,0,,هناك خطأ ما هنا.
Dialogue: 0,0:25:07.28,0:25:08.32,Default,Tolenka3,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,0:25:09.49,0:25:10.59,Default,Tolenka3,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:25:10.85,0:25:12.96,Default,Tolenka3,0,0,0,,لماذا لا تخبرني بعد الآن؟
Dialogue: 0,0:25:13.12,0:25:15.96,Default,Tolenka3,0,0,0,,ليس من المناسب أن تترك غرفتك هكذا يا صاحب الجلالة.
Dialogue: 0,0:25:16.66,0:25:17.83,Default,Tolenka3,0,0,0,,أحتاج إلى تذكير الجميع.
Dialogue: 0,0:25:18.13,0:25:20.43,Default,Tolenka3,0,0,0,,قررت عدم توبيخك بعد الآن.
Dialogue: 0,0:25:20.93,0:25:22.20,Default,Tolenka3,0,0,0,,ماذا؟
Dialogue: 0,0:25:23.40,0:25:24.53,Default,Tolenka3,0,0,0,,لماذا حدث هذا فجأة؟
Dialogue: 0,0:25:25.53,0:25:27.77,Default,Tolenka3,0,0,0,,-حسنًا، اذهب. \N-حسنا.
Dialogue: 0,0:25:31.54,0:25:32.71,Default,Tolenka3,0,0,0,,يا لها من مفاجأة.
Dialogue: 0,0:25:56.02,0:25:57.12,Default,Tolenka3,0,0,0,,من اليوم
Dialogue: 0,0:25:58.66,0:26:01.49,Default,Tolenka3,0,0,0,,أنا أستقيل من منصب الوصي.
Dialogue: 0,0:26:44.80,0:26:45.90,Default,Tolenka3,0,0,0,,وبالتالي
Dialogue: 0,0:26:47.01,0:26:49.21,Default,Tolenka3,0,0,0,,من الآن فصاعدا سأحكم وحدي.
Dialogue: 0,0:26:49.54,0:26:54.45,Default,Tolenka3,0,0,0,,حياة طويلة للملك!
Dialogue: 0,0:27:11.70,0:27:14.00,Default,Tolenka3,0,0,0,,بهذا المعدل سأموت قريباً.
Dialogue: 0,0:27:15.03,0:27:18.40,Default,Tolenka3,0,0,0,,كل هذه التجارب ستقضي عليّ.
Dialogue: 0,0:27:19.10,0:27:21.47,Default,Tolenka3,0,0,0,,أخبرني أنك لست جائعاً اليوم؟
Dialogue: 0,0:27:21.91,0:27:25.28,Default,Tolenka3,0,0,0,,هل تريد التعجيل بوفاتي؟
Dialogue: 0,0:27:25.54,0:27:26.91,Default,Tolenka3,0,0,0,,عذراً.
Dialogue: 0,0:27:27.68,0:27:28.88,Default,Tolenka3,0,0,0,,ومع ذلك
Dialogue: 0,0:27:29.18,0:27:32.92,Default,Tolenka3,0,0,0,,ما زلت لا أستطيع أن أقرر ما إذا كنت سأطلب حمل الطعام أم لا.
Dialogue: 0,0:27:32.92,0:27:36.02,Default,Tolenka3,0,0,0,,إذا طلبت منك إحضارها فسوف تغضب،\Nلأننا نتذكرك حتى مماتك.
Dialogue: 0,0:27:36.76,0:27:39.73,Default,Tolenka3,0,0,0,,ماذا، حتى هذه الأشياء البسيطة
Dialogue: 0,0:27:39.73,0:27:41.93,Default,Tolenka3,0,0,0,,ألا تستطيع أن تقرر بدوني؟!
Dialogue: 0,0:27:43.03,0:27:44.13,Default,Tolenka3,0,0,0,,الملكة الأرملة!
Dialogue: 0,0:27:46.43,0:27:47.83,Default,Tolenka3,0,0,0,,من فضلك خفف من غضبك.
Dialogue: 0,0:27:51.80,0:27:53.91,Default,Tolenka3,0,0,0,,هل يمكنك ألا تغضب في مثل هذا الموقف؟
Dialogue: 0,0:27:54.14,0:27:57.64,Default,Tolenka3,0,0,0,,لقد فقدت نفوذي عملياً في القصر.
Dialogue: 0,0:27:58.61,0:28:00.75,Default,Tolenka3,0,0,0,,سأساعد في إعادة القوة السابقة.
Dialogue: 0,0:28:02.65,0:28:04.98,Default,Tolenka3,0,0,0,,سوف تصبح الوصي مرة أخرى.
Dialogue: 0,0:28:06.12,0:28:07.55,Default,Tolenka3,0,0,0,,وأنت واثق جدًا من نفسك.
Dialogue: 0,0:28:08.55,0:28:10.62,Default,Tolenka3,0,0,0,,كان والدك هو نفسه في شبابه.
Dialogue: 0,0:28:11.96,0:28:14.66,Default,Tolenka3,0,0,0,,هذه هي الفرصة الأخيرة.
Dialogue: 0,0:28:15.19,0:28:17.06,Default,Tolenka3,0,0,0,,وما الذي يجب فعله؟
Dialogue: 0,0:28:17.43,0:28:20.37,Default,Tolenka3,0,0,0,,ابحث عن طريقة لتقويض روح الملك.
Dialogue: 0,0:28:22.53,0:28:24.67,Default,Tolenka3,0,0,0,,إذا سارت الأمور على ما يرام بالنسبة له،
Dialogue: 0,0:28:24.67,0:28:27.17,Default,Tolenka3,0,0,0,,فكر في نفسك فقط وحاول ألا تتخلى عن نفسك.
Dialogue: 0,0:28:28.14,0:28:29.24,Default,Tolenka3,0,0,0,,فهمت.
Dialogue: 0,0:28:29.24,0:28:32.84,Default,Tolenka3,0,0,0,,ومع ذلك، فمن غير المرجح أن تكون الأساليب القديمة فعالة.
Dialogue: 0,0:28:35.01,0:28:37.15,Default,Tolenka3,0,0,0,,لا تقلل من شأن الملك.
Dialogue: 0,0:28:37.42,0:28:41.52,Default,Tolenka3,0,0,0,,هل تعتقد حقاً أن الانفجار كان من صنعه؟
Dialogue: 0,0:28:42.22,0:28:45.39,Default,Tolenka3,0,0,0,,كقاعدة عامة، يقع اللوم على من يستفيد أكثر.
Dialogue: 0,0:28:45.89,0:28:48.66,Default,Tolenka3,0,0,0,,لا أصدق أنني أعطيت العرش لمثل هذا الوغد الخبيث.
Dialogue: 0,0:28:54.83,0:28:58.27,Default,Tolenka3,0,0,0,,جلالتك، تهانينا على نهاية الوصاية.
Dialogue: 0,0:28:59.74,0:29:00.94,Default,Tolenka3,0,0,0,,شكرًا لك.
Dialogue: 0,0:29:03.11,0:29:05.41,Default,Tolenka3,0,0,0,,بينما كنت بعيدًا، تم تسليم رسالة
Dialogue: 0,0:29:05.41,0:29:07.18,Default,Tolenka3,0,0,0,,من جناح دايجوجون.
Dialogue: 0,0:29:08.11,0:29:09.92,Default,Tolenka3,0,0,0,, - من الملكة؟ \N-نعم، يا صاحب الجلالة.
Dialogue: 0,0:29:16.69,0:29:19.59,Default,Tolenka3,0,0,0,,أحاول أن أنقل بالكلمات كيف أعاني من الشوق إليك،
Dialogue: 0,0:29:19.89,0:29:21.06,Default,Tolenka3,0,0,0,,وأنا أفتقدك أكثر.
Dialogue: 0,0:29:24.43,0:29:26.20,Default,Tolenka3,0,0,0,,يجب فعل شيء حيال ذلك.
Dialogue: 0,0:29:33.04,0:29:34.97,Default,Tolenka3,0,0,0,,تم الاستماع إلى توسلاتي اليائسة.
Dialogue: 0,0:29:35.61,0:29:36.71,Default,Tolenka3,0,0,0,,يا لها من مثابرة.
Dialogue: 0,0:29:37.71,0:29:38.91,Default,Tolenka3,0,0,0,,علينا أن نلتقي.
Dialogue: 0,0:29:43.12,0:29:44.48,Default,Tolenka3,0,0,0,,هل أنت هنا بعد؟
Dialogue: 0,0:29:44.92,0:29:47.05,Default,Tolenka3,0,0,0,,لإنقاذي من هذا العذاب...
Dialogue: 0,0:29:48.29,0:29:49.39,Default,Tolenka3,0,0,0,,شولجونغ؟
Dialogue: 0,0:29:49.82,0:29:51.12,Default,Tolenka3,0,0,0,,كيف عرفت مكاني؟
Dialogue: 0,0:29:51.29,0:29:53.29,Default,Tolenka3,0,0,0,,كيف هذا؟ لقد حددت الموعد بنفسك.
Dialogue: 0,0:29:53.29,0:29:55.96,Default,Tolenka3,0,0,0,,-ولقد نادتني محظية هنا!\N-أي محظية؟
Dialogue: 0,0:29:55.96,0:29:57.63,Default,Tolenka3,0,0,0,,عندما لا تعرف، يكون الأمر أكثر إثارة للاهتمام،
Dialogue: 0,0:29:57.63,0:29:59.36,Default,Tolenka3,0,0,0,,لذلك لم أسأل.
Dialogue: 0,0:29:59.77,0:30:01.30,Default,Tolenka3,0,0,0,,على أية حال، لم أكتب إليك.
Dialogue: 0,0:30:01.70,0:30:04.00,Default,Tolenka3,0,0,0,,أحيانًا تأتيني أفكار من نوع مختلف.
Dialogue: 0,0:30:05.54,0:30:08.24,Default,Tolenka3,0,0,0,,أتمنى أن أغرق في سيل من الأفكار عنك.
Dialogue: 0,0:30:08.74,0:30:11.84,Default,Tolenka3,0,0,0,,تشبث بي.
Dialogue: 0,0:30:12.71,0:30:17.52,Default,Tolenka3,0,0,0,,أوه! لن أتركك تذهب لأي شيء!
Dialogue: 0,0:30:17.68,0:30:19.58,Default,Tolenka3,0,0,0,,-كفى. \N-هل حصلت عليه الآن؟
Dialogue: 0,0:30:20.15,0:30:21.19,Default,Tolenka3,0,0,0,,لا.
Dialogue: 0,0:30:21.29,0:30:23.26,Default,Tolenka3,0,0,0,,ليست كلمات الأغاني، بل نوع من العار. أول مرة أسمع ذلك.
Dialogue: 0,0:30:23.26,0:30:25.42,Default,Tolenka3,0,0,0,,سيبقى اسمك على شفتي حتى أرتاح.
Dialogue: 0,0:30:25.62,0:30:27.89,Default,Tolenka3,0,0,0,,سوف يشغل كل أفكاري، ولن أنساه أبدًا.
Dialogue: 0,0:30:27.99,0:30:29.66,Default,Tolenka3,0,0,0,,كفى. هناك أشخاص هنا.
Dialogue: 0,0:30:31.06,0:30:33.50,Default,Tolenka3,0,0,0,,وماذا في ذلك؟ لم تكن أنت من كتبها.
Dialogue: 0,0:30:40.37,0:30:42.74,Default,Tolenka3,0,0,0,,نحن بحاجة لمناقشة شيء ما. اتركنا.
Dialogue: 0,0:30:42.74,0:30:43.88,Default,Tolenka3,0,0,0,,حسناً؟
Dialogue: 0,0:30:43.88,0:30:45.91,Default,Tolenka3,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:30:53.92,0:30:55.19,Default,Tolenka3,0,0,0,,هل تلاحقني سراً؟
Dialogue: 0,0:30:55.32,0:30:56.96,Default,Tolenka3,0,0,0,,هل تقرأ المراسلات؟
Dialogue: 0,0:30:57.62,0:30:58.82,Default,Tolenka3,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:30:59.42,0:31:01.83,Default,Tolenka3,0,0,0,,تعترفين بحبك في الرسائل.
Dialogue: 0,0:31:01.83,0:31:03.46,Default,Tolenka3,0,0,0,,وعندما نرى بعضنا البعض، تتظاهر بعدم المبالاة.
Dialogue: 0,0:31:04.40,0:31:05.83,Default,Tolenka3,0,0,0,,كيف يمكنك أن تكون بهذه القسوة.
Dialogue: 0,0:31:10.67,0:31:12.07,Default,Tolenka3,0,0,0,,أم أن الرسالة وصلت إلى المكان الخطأ؟!
Dialogue: 0,0:31:12.80,0:31:14.57,Default,Tolenka3,0,0,0,,اتضح أن الرسائل لم تكن موجهة لي؟
Dialogue: 0,0:31:14.57,0:31:16.68,Default,Tolenka3,0,0,0,,اتضح أنه بسببك خفق قلبي؟
Dialogue: 0,0:31:17.48,0:31:19.85,Default,Tolenka3,0,0,0,,هل أنت فرصتي الأخيرة لاستعادة القوة الذكورية؟
Dialogue: 0,0:31:20.05,0:31:23.01,Default,Tolenka3,0,0,0,,بسببك ينفطر قلبي كل ليلة
Dialogue: 0,0:31:24.05,0:31:25.52,Default,Tolenka3,0,0,0,,ترتجف؟
Dialogue: 0,0:31:25.95,0:31:27.85,Default,Tolenka3,0,0,0,,إذن هذا هو سبب انقسامكم.
Dialogue: 0,0:31:29.22,0:31:30.32,Default,Tolenka3,0,0,0,,لماذا أنت؟
Dialogue: 0,0:31:30.56,0:31:32.22,Default,Tolenka3,0,0,0,,لماذا أنت دائماً؟
Dialogue: 0,0:31:32.22,0:31:34.43,Default,Tolenka3,0,0,0,,حتى في أحلامي تظهر لي!
Dialogue: 0,0:31:35.16,0:31:36.53,Default,Tolenka3,0,0,0,,هل ظهرت لك في أحلامك؟
Dialogue: 0,0:31:37.03,0:31:40.60,Default,Tolenka3,0,0,0,,انتبه إلى لغتك. غباء آخر ويمكن اعتباره اعترافًا.
Dialogue: 0,0:31:40.90,0:31:42.73,Default,Tolenka3,0,0,0,,هناك أحلام مختلفة، كما تعلم.
Dialogue: 0,0:31:43.00,0:31:44.74,Default,Tolenka3,0,0,0,,الكوابيس مثلاً.
Dialogue: 0,0:31:45.87,0:31:47.34,Default,Tolenka3,0,0,0,,لماذا ساعدتني في الوليمة؟
Dialogue: 0,0:31:49.54,0:31:51.71,Default,Tolenka3,0,0,0,,اتبعتني لتسأل هذا؟!
Dialogue: 0,0:31:52.41,0:31:54.78,Default,Tolenka3,0,0,0,,يمكنني أن أشكرك. عبثا ساعد فقط.
Dialogue: 0,0:31:54.98,0:31:56.78,Default,Tolenka3,0,0,0,,قالتها بنفسها، أقسم - إذا كنت سعيدًا برؤيتك،
Dialogue: 0,0:31:56.78,0:31:59.15,Default,Tolenka3,0,0,0,,وابحث عن القتال إذا كنت ممتناً.
Dialogue: 0,0:31:59.28,0:32:01.52,Default,Tolenka3,0,0,0,,لماذا قررت فجأة الاستماع إلي؟
Dialogue: 0,0:32:01.52,0:32:03.42,Default,Tolenka3,0,0,0,,لقد فعلت ذلك بطريقتك، لكنك مازلت غير سعيد؟
Dialogue: 0,0:32:03.92,0:32:06.06,Default,Tolenka3,0,0,0,,ماذا تريد مني أن أفعل إذًا؟
Dialogue: 0,0:32:06.49,0:32:08.73,Default,Tolenka3,0,0,0,,نبعد أنفسنا، ثم فجأة تساعدنا.
Dialogue: 0,0:32:08.73,0:32:11.20,Default,Tolenka3,0,0,0,,ثم تعلن فجأة أنك ستخونني بسهولة.
Dialogue: 0,0:32:11.86,0:32:13.23,Default,Tolenka3,0,0,0,,نعم، إذن أنا فقط...
Dialogue: 0,0:32:15.23,0:32:16.27,Default,Tolenka3,0,0,0,,انتظر لحظة.
Dialogue: 0,0:32:18.34,0:32:20.34,Default,Tolenka3,0,0,0,,هل سمعت كل شيء؟
Dialogue: 0,0:32:22.47,0:32:24.58,Default,Tolenka3,0,0,0,,اتضح أنه كذب بشأن فقدان سمعه؟
Dialogue: 0,0:32:25.68,0:32:26.81,Default,Tolenka3,0,0,0,,حقاً...
Dialogue: 0,0:32:28.01,0:32:29.68,Default,Tolenka3,0,0,0,,اتضح أن الانفجار كان من صنعك؟
Dialogue: 0,0:32:30.62,0:32:32.62,Default,Tolenka3,0,0,0,,لقد فقدت سمعي حقاً لبعض الوقت.
Dialogue: 0,0:32:33.22,0:32:35.95,Default,Tolenka3,0,0,0,,لكنه عاد تماماً كما كنت تقول هذه الكلمات.
Dialogue: 0,0:32:36.86,0:32:39.39,Default,Tolenka3,0,0,0,,هل فقدت عقلك؟ كان من الممكن أن تموت!
Dialogue: 0,0:32:39.55,0:32:40.40,Default,Tolenka3,0,0,0,,ملكتي!
Dialogue: 0,0:32:40.50,0:32:42.55,Default,Tolenka3,0,0,0,,لماذا تخاطر بنفسك؟!
Dialogue: 0,0:33:02.21,0:33:04.58,Default,Tolenka3,0,0,0,,ماذا؟ هذه تقنية محظورة!
Dialogue: 0,0:33:04.88,0:33:07.52,Default,Tolenka3,0,0,0,,أنت دائمًا تعانقني وتبتسم وتنام بجانبي...
Dialogue: 0,0:33:07.59,0:33:09.25,Default,Tolenka3,0,0,0,,كل هذا ممنوع.
Dialogue: 0,0:33:12.92,0:33:14.73,Default,Tolenka3,0,0,0,,أمنعك من أن تمنعني.
Dialogue: 0,0:33:25.34,0:33:27.24,Default,Tolenka3,0,0,0,,أحبك.
Dialogue: 0,0:33:32.31,0:33:33.48,Default,Tolenka3,0,0,0,,هل أنت عاطفي جدًا؟
Dialogue: 0,0:33:33.78,0:33:36.21,Default,Tolenka3,0,0,0,,كل ذلك بسبب ليلة واحدة أمضيناها معًا؟ \NYou لا ينبغي أن تفعل ذلك.
Dialogue: 0,0:33:36.21,0:33:37.62,Default,Tolenka3,0,0,0,,لا، ليس هذا هو السبب.
Dialogue: 0,0:33:37.62,0:33:39.25,Default,Tolenka3,0,0,0,,إذن لماذا؟
Dialogue: 0,0:33:40.22,0:33:43.72,Default,Tolenka3,0,0,0,,أنت متعجرف، نرجسي، فظ
Dialogue: 0,0:33:43.89,0:33:45.16,Default,Tolenka3,0,0,0,,ومتقلب.
Dialogue: 0,0:33:45.59,0:33:47.09,Default,Tolenka3,0,0,0,,لديك العديد من النواقص.
Dialogue: 0,0:33:47.73,0:33:50.60,Default,Tolenka3,0,0,0,,هذه هي النقطة. لذلك لا تحبني.
Dialogue: 0,0:33:50.60,0:33:52.53,Default,Tolenka3,0,0,0,,لكنني مازلت أحبك.
Dialogue: 0,0:33:53.67,0:33:56.57,Default,Tolenka3,0,0,0,,وسأحبك، دعك من ذلك
Dialogue: 0,0:33:57.44,0:33:58.97,Default,Tolenka3,0,0,0,,كل عيوب العالم.
Dialogue: 0,0:34:09.85,0:34:10.95,Default,Tolenka3,0,0,0,,تذكر ما قلته
Dialogue: 0,0:34:13.29,0:34:14.82,Default,Tolenka3,0,0,0,,في الليلة السابقة،
Dialogue: 0,0:34:16.02,0:34:17.39,Default,Tolenka3,0,0,0,,كيف تقفز إلى البركة؟
Dialogue: 0,0:34:19.29,0:34:21.43,Default,Tolenka3,0,0,0,,يجب أن تحبني.
Dialogue: 0,0:34:24.20,0:34:26.46,Default,Tolenka3,0,0,0,,قلت هذا لأنه بدا لي حينها
Dialogue: 0,0:34:26.46,0:34:27.90,Default,Tolenka3,0,0,0,,أنا وحدي من يستطيع حمايتك.
Dialogue: 0,0:34:29.03,0:34:31.84,Default,Tolenka3,0,0,0,,لأنني اعتقدت أنه لا توجد طريقة أخرى لمساعدتك.
Dialogue: 0,0:34:32.20,0:34:34.71,Default,Tolenka3,0,0,0,,أن هذه هي الطريقة الوحيدة لإنقاذي أنا وأنت.
Dialogue: 0,0:34:35.97,0:34:37.44,Default,Tolenka3,0,0,0,,إذًا هذا هو السبب؟
Dialogue: 0,0:34:37.44,0:34:38.54,Default,Tolenka3,0,0,0,,لكن هل تعلم ماذا؟
Dialogue: 0,0:34:39.88,0:34:42.68,Default,Tolenka3,0,0,0,,لم تعد "كيم سو يون" موجودة.
Dialogue: 0,0:34:44.05,0:34:45.98,Default,Tolenka3,0,0,0,,ماتت "تا كيم سو يون" في تلك الليلة.
Dialogue: 0,0:34:49.49,0:34:52.02,Default,Tolenka3,0,0,0,,لن أؤذيك بعد الآن.
Dialogue: 0,0:34:54.53,0:34:56.33,Default,Tolenka3,0,0,0,,ليس لدينا مستقبل.
Dialogue: 0,0:34:59.06,0:35:00.57,Default,Tolenka3,0,0,0,,لأنني لن أسامحك أبداً.
Dialogue: 0,0:35:03.94,0:35:05.90,Default,Tolenka3,0,0,0,,أنا لست كيم سو يون.
Dialogue: 0,0:35:06.30,0:35:08.61,Default,Tolenka3,0,0,0,,لذلك ليس لدي الحق.
Dialogue: 0,0:35:26.26,0:35:29.46,Default,Tolenka3,0,0,0,,ما الناس. هل صاحبة الجلالة بحاجة إلى شيء؟
Dialogue: 0,0:35:30.50,0:35:33.30,Default,Tolenka3,0,0,0,,- شكرًا لمساعدتك. \N-تعليمات؟
Dialogue: 0,0:35:34.53,0:35:35.97,Default,Tolenka3,0,0,0,,في مستوصف القصر.
Dialogue: 0,0:35:36.03,0:35:38.64,Default,Tolenka3,0,0,0,,آه، هذا كل شيء، أنا فقط...
Dialogue: 0,0:35:38.64,0:35:41.24,Default,Tolenka3,0,0,0,,لقد أعطيتك الماء المسموم.
Dialogue: 0,0:35:42.47,0:35:45.51,Default,Tolenka3,0,0,0,,فليكن، لكنهم أمروا أيضًا بالوخز بالإبر مع الكى.
Dialogue: 0,0:35:46.24,0:35:48.85,Default,Tolenka3,0,0,0,,ولذلك يجب أن أشكرك.
Dialogue: 0,0:35:51.92,0:35:53.05,Default,Tolenka3,0,0,0,,وجدته في الطريق.
Dialogue: 0,0:35:55.09,0:35:56.25,Default,Tolenka3,0,0,0,,لكن...
Dialogue: 0,0:36:02.83,0:36:06.23,Default,Tolenka3,0,0,0,,أين وجدت مثل هذا الشيء الباهظ الثمن؟
Dialogue: 0,0:36:11.24,0:36:12.94,Default,Kus4,0,0,0,,محاولة على الملك؟
Dialogue: 0,0:36:13.34,0:36:16.04,Default,Kus4,0,0,0,,لماذا لم تتشاور معنا قبل البدء بهذا؟
Dialogue: 0,0:36:16.04,0:36:17.88,Default,Kus4,0,0,0,,انظر إلى ماذا أدى هذا.
Dialogue: 0,0:36:17.88,0:36:21.61,Default,Kus4,0,0,0,,لا بد أن كيم جواجيون قد وصل إلى الحد الأقصى.
Dialogue: 0,0:36:31.76,0:36:33.39,Default,Kus4,0,0,0,,أفهم أنك أردت المال،
Dialogue: 0,0:36:33.39,0:36:34.79,Default,Kus4,0,0,0,,لكن نبيع أسلحتنا؟
Dialogue: 0,0:36:35.09,0:36:36.80,Default,Kus4,0,0,0,,هل تحاول تدمير هذا البلد؟
Dialogue: 0,0:36:36.80,0:36:38.73,Default,Kus4,0,0,0,,لقد أوضحت أنه لا توجد مشاكل.
Dialogue: 0,0:36:39.03,0:36:41.97,Default,Kus4,0,0,0,,أنت بحاجة إلى أشخاص لتحقيق أهدافك.
Dialogue: 0,0:36:41.97,0:36:43.97,Default,Kus4,0,0,0,,ولهذا نحتاج إلى المال.
Dialogue: 0,0:36:45.17,0:36:47.54,Default,Kus4,0,0,0,,هل تقول أنك فعلت هذا من أجلي؟
Dialogue: 0,0:36:47.54,0:36:50.81,Default,Kus4,0,0,0,,أردت أن أعرض النتائج دون التدخل معك في العملية نفسها.
Dialogue: 0,0:36:50.81,0:36:52.24,Default,Kus4,0,0,0,,لقد فعلت كل شيء من أجل هذا!
Dialogue: 0,0:36:52.68,0:36:54.21,Default,Kus4,0,0,0,,لقد حاولت من أجلك
Dialogue: 0,0:36:54.48,0:36:58.18,Default,Kus4,0,0,0,,ومن أجل جنسنا.
Dialogue: 0,0:37:00.85,0:37:01.92,Default,Kus4,0,0,0,,استعد
Dialogue: 0,0:37:01.92,0:37:04.96,Default,Kus4,0,0,0,,تحمل المسؤولية إذا لم يكن هناك طريقة أخرى.
Dialogue: 0,0:37:10.80,0:37:12.76,Default,Kus4,0,0,0,,سأعطيك فرصة للتكفير.
Dialogue: 0,0:37:21.54,0:37:24.14,Default,Kus4,0,0,0,,-هل وصل الجميع؟\N-السيد.
Dialogue: 0,0:37:25.31,0:37:28.25,Default,Kus4,0,0,0,,والد الملكة لم يصل بعد.
Dialogue: 0,0:37:29.58,0:37:31.12,Default,Kus4,0,0,0,,لم تتم دعوته.
Dialogue: 0,0:37:31.52,0:37:34.99,Default,Kus4,0,0,0,,نحن مجتمعون هنا بسبب خطأه.
Dialogue: 0,0:37:35.39,0:37:37.52,Default,Kus4,0,0,0,,كان يحتفظ بسجلات للممتلكات،
Dialogue: 0,0:37:38.59,0:37:40.43,Default,Kus4,0,0,0,,ينتمي إلى عائلتنا.
Dialogue: 0,0:37:44.80,0:37:49.00,Default,Kus4,0,0,0,,لحسن الحظ، لدي دفتر المحاسبة هذا.
Dialogue: 0,0:37:50.54,0:37:54.31,Default,Kus4,0,0,0,,طالما بقي نفوذي، فهي عديمة الفائدة،
Dialogue: 0,0:37:54.31,0:37:55.64,Default,Kus4,0,0,0,,ولا داعي للقلق.
Dialogue: 0,0:37:57.68,0:37:58.71,Default,Kus4,0,0,0,,لكن
Dialogue: 0,0:37:59.28,0:38:02.48,Default,Kus4,0,0,0,,بمجرد أن أفقد نفوذي،
Dialogue: 0,0:38:05.02,0:38:07.09,Default,Kus4,0,0,0,,لا أستطيع حماية الكتاب.
Dialogue: 0,0:38:10.36,0:38:12.62,Default,Kus4,0,0,0,,إذا كنت تحميني،
Dialogue: 0,0:38:13.12,0:38:15.23,Default,Kus4,0,0,0,,سأحميك في المقابل.
Dialogue: 0,0:38:15.93,0:38:18.23,Default,Kus4,0,0,0,,إذا قررنا حمايتك،
Dialogue: 0,0:38:18.66,0:38:19.80,Default,Kus4,0,0,0,,ماذا
Dialogue: 0,0:38:21.03,0:38:23.00,Default,Kus4,0,0,0,,هل ستفعل مع الملك؟
Dialogue: 0,0:38:23.97,0:38:25.27,Default,Kus4,0,0,0,,إذا لم نفعل أي شيء،
Dialogue: 0,0:38:25.27,0:38:28.81,Default,Kus4,0,0,0,,سوف يطردنا لأننا لم نخرجك من منصبك.
Dialogue: 0,0:38:29.87,0:38:32.91,Default,Kus4,0,0,0,,تم تشكيل مجلس لحل مشاكل الحكومة.
Dialogue: 0,0:38:35.25,0:38:36.45,Default,Kus4,0,0,0,,مجلس أمن الحدود؟
Dialogue: 0,0:38:37.08,0:38:39.45,Default,Kus4,0,0,0,,الملك غير الكفء يتولى السلطة بين يديه -
Dialogue: 0,0:38:39.45,0:38:41.45,Default,Kus4,0,0,0,,مشكلة خطيرة في الحالة.
Dialogue: 0,0:38:42.52,0:38:44.72,Default,Kus4,0,0,0,,جميع قرارات السياسة
Dialogue: 0,0:38:45.99,0:38:48.43,Default,Kus4,0,0,0,,سيتم النظر فيه من قبل مجلس حماية الحدود.
Dialogue: 0,0:38:50.76,0:38:52.26,Default,Kus4,0,0,0,,لقد جهزت كل شيء.
Dialogue: 0,0:38:52.60,0:38:55.60,Default,Kus4,0,0,0,,كما قلت، قمنا بتجميد الماء مع الزرنيخ بداخله.
Dialogue: 0,0:38:55.60,0:38:58.17,Default,Kus4,0,0,0,,عندما ذاب الجليد، خرج الزرنيخ.
Dialogue: 0,0:38:58.17,0:39:00.67,Default,Kus4,0,0,0,,كم من الوقت يستغرق ذوبان الزرنيخ؟
Dialogue: 0,0:39:01.27,0:39:02.91,Default,Kus4,0,0,0,,يعتمد الأمر على الطقس،
Dialogue: 0,0:39:03.24,0:39:05.38,Default,Kus4,0,0,0,,ولكن في الشاي لن يستغرق الأمر الكثير من الوقت.
Dialogue: 0,0:39:06.78,0:39:07.85,Default,Kus4,0,0,0,,فهمت.
Dialogue: 0,0:39:08.45,0:39:12.08,Default,Kus4,0,0,0,,بالمناسبة، هل لي أن أعرف من هو هدفك؟
Dialogue: 0,0:39:12.98,0:39:15.62,Default,Kus4,0,0,0,,إذا تخلصت من امرأة واحدة في القصر،
Dialogue: 0,0:39:15.85,0:39:18.92,Default,Kus4,0,0,0,,رجلان يهددان موقفي سيتم كسرهما.
Dialogue: 0,0:39:34.47,0:39:36.17,Default,Kus4,0,0,0,,شكرًا على وقوفك.
Dialogue: 0,0:39:37.51,0:39:40.55,Default,Kus4,0,0,0,,لقد تحملت هذا التعذيب المؤلم.
Dialogue: 0,0:39:41.91,0:39:43.08,Default,Kus4,0,0,0,,لن أنسى هذا.
Dialogue: 0,0:39:45.12,0:39:48.89,Default,Kus4,0,0,0,,الآن بعد أن تم كشفك، أصبح من الخطر البقاء في القصر.
Dialogue: 0,0:39:49.82,0:39:51.29,Default,Kus4,0,0,0,,اترك القصر.
Dialogue: 0,0:39:52.49,0:39:54.79,Default,Kus4,0,0,0,,حان الوقت لتعيش حياتك.
Dialogue: 0,0:40:44.98,0:40:46.44,Default,Kus4,0,0,0,,سأفعل كل شيء
Dialogue: 0,0:40:51.08,0:40:52.58,Default,Kus4,0,0,0,,لتحقق أحلامك.
Dialogue: 0,0:41:14.91,0:41:16.24,Default,Kus4,0,0,0,,وبطريقة ما أصبح فارغاً.
Dialogue: 0,0:41:18.01,0:41:20.55,Default,Kus4,0,0,0,,أي منكم ما زال يريد...
Dialogue: 0,0:41:22.68,0:41:23.75,Default,Kus4,0,0,0,,أنت هنا.
Dialogue: 0,0:41:47.11,0:41:48.54,Default,Kus4,0,0,0,,يجب أن أضع
Dialogue: 0,0:41:49.67,0:41:53.24,Default,Kus4,0,0,0,,مكعب ثلج سداسي الشكل في وعاء الملكة؟
Dialogue: 0,0:41:54.65,0:41:55.68,Default,Kus4,0,0,0,,نعم.
Dialogue: 0,0:42:00.08,0:42:02.35,Default,Kus4,0,0,0,,فقط أضف مكعب ثلج. هذا كل شيء.
Dialogue: 0,0:42:15.50,0:42:16.53,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:42:17.44,0:42:21.31,Default,Kus4,0,0,0,,لدي معلومات مهمة جداً.
Dialogue: 0,0:42:21.94,0:42:24.44,Default,Kus4,0,0,0,,الرجاء مساعدتي.
Dialogue: 0,0:42:25.31,0:42:27.35,Default,Kus4,0,0,0,,ماذا لديك هناك؟
Dialogue: 0,0:42:27.71,0:42:30.62,Default,Kus4,0,0,0,,إذا وعدتني بإبقائي...
Dialogue: 0,0:42:31.18,0:42:32.85,Default,Kus4,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:42:33.25,0:42:34.32,Default,Kus4,0,0,0,,سيدة البلاط خان.
Dialogue: 0,0:42:37.46,0:42:41.53,Default,Kus4,0,0,0,,أعلم أنك فتاة شجاعة، لكنك الآن ترتجفين من الخوف.
Dialogue: 0,0:42:42.63,0:42:44.53,Default,Kus4,0,0,0,,لا أعرف ما الذي لديك هناك،
Dialogue: 0,0:42:45.23,0:42:47.60,Default,Kus4,0,0,0,,لكنني سأساعدك بكل ما أستطيع.
Dialogue: 0,0:42:50.00,0:42:52.84,Default,Kus4,0,0,0,,سألني كيم جواجيون...
Dialogue: 0,0:42:56.71,0:42:58.91,Default,Kus4,0,0,0,,لماذا لم يحبها منذ البداية؟
Dialogue: 0,0:42:59.44,0:43:01.31,Default,Kus4,0,0,0,,إذن لم تكن "كيم سو يون" لتحاول الموت.
Dialogue: 0,0:43:01.31,0:43:02.88,Default,Kus4,0,0,0,,ولن أكون هنا.
Dialogue: 0,0:43:04.88,0:43:06.25,Default,Kus4,0,0,0,,ولكن الأهم من ذلك،
Dialogue: 0,0:43:11.59,0:43:14.16,Default,Kus4,0,0,0,,اعتقدت أنني قد اختبرت كل شيء ممكن.
Dialogue: 0,0:43:16.09,0:43:18.60,Default,Kus4,0,0,0,,ولكن، على ما يبدو، كان هناك شيء لم أواجهه.
Dialogue: 0,0:43:19.46,0:43:21.47,Default,Kus4,0,0,0,,كيف تفسر هذا الشعور الليلة الماضية؟
Dialogue: 0,0:43:23.77,0:43:26.94,Default,Kus4,0,0,0,,إذا كان كل شيء من قبل مثل قطعة خبز طرية،
Dialogue: 0,0:43:26.94,0:43:28.17,Default,Kus4,0,0,0,,ثم كان...
Dialogue: 0,0:43:31.21,0:43:35.05,Default,Kus4,0,0,0,,لا، كان ذلك جديداً. \NI كان مهتماً بشيء جديد.
Dialogue: 0,0:43:35.58,0:43:37.08,Default,Kus4,0,0,0,,تعالوا إلى أنفسكم، تشان سو يون.
Dialogue: 0,0:43:38.02,0:43:41.02,Default,Kus4,0,0,0,,اللعنة. أنا حتى الخلط بين الأسماء.
Dialogue: 0,0:43:42.29,0:43:43.39,Default,Kus4,0,0,0,,الملكة.
Dialogue: 0,0:43:44.52,0:43:45.99,Default,Kus4,0,0,0,,نعم. ادخل.
Dialogue: 0,0:43:51.40,0:43:55.13,Default,Kus4,0,0,0,,طلبت منك الملكة الأرملة تناول الإفطار معًا.
Dialogue: 0,0:43:56.23,0:43:58.67,Default,Kus4,0,0,0,,الإفطار في هذا الوقت؟
Dialogue: 0,0:44:00.61,0:44:04.14,Default,Kus4,0,0,0,,لست في مزاج يسمح لي بالطهي الآن.
Dialogue: 0,0:44:07.38,0:44:11.82,Default,Kus4,0,0,0,,لقد أعدت الملكة الأرملة كل شيء بالفعل.
Dialogue: 0,0:44:13.42,0:44:14.82,Default,Kus4,0,0,0,,هل سأذهب إلى قاعة Dongmyeongjong؟
Dialogue: 0,0:44:15.19,0:44:17.09,Default,Kus4,0,0,0,,لقد كنت أركض طوال اليوم - لذا فأنا جائع.
Dialogue: 0,0:44:18.86,0:44:20.66,Default,Kus4,0,0,0,,يريدون التخلص من الملكة؟
Dialogue: 0,0:44:21.49,0:44:23.76,Default,Kus4,0,0,0,,دفتر المحاسبة الآن مع كيم جواجين.
Dialogue: 0,0:44:24.40,0:44:25.90,Default,Kus4,0,0,0,,من كان يعلم أنها في قاعة دايجوجونغ؟
Dialogue: 0,0:44:26.36,0:44:27.53,Default,Kus4,0,0,0,,كيف...
Dialogue: 0,0:44:28.63,0:44:30.07,Default,Kus4,0,0,0,,سأعود إلى القصر.
Dialogue: 0,0:44:36.01,0:44:37.07,Default,Kus4,0,0,0,,هنا.
Dialogue: 0,0:44:52.19,0:44:53.96,Default,Kus4,0,0,0,,لماذا أنت عالق؟ أسرع!
Dialogue: 0,0:44:53.96,0:44:55.13,Default,Kus4,0,0,0,,أنا قادم.
Dialogue: 0,0:45:06.77,0:45:08.97,Default,Kus4,0,0,0,,أنت ستتركني مجددًا.
Dialogue: 0,0:45:10.44,0:45:14.25,Default,Kus4,0,0,0,,كما تعلم أيها العفريت، لقد بدأت أغضب منك.
Dialogue: 0,0:45:29.23,0:45:31.13,Default,Kus4,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:45:32.00,0:45:34.73,Default,Kus4,0,0,0,,الإفطار، ومع هذا المنظر الجميل.
Dialogue: 0,0:45:35.00,0:45:38.20,Default,Kus4,0,0,0,,لم أعد وصيًا على العرش، لذا لدي الكثير من وقت الفراغ.
Dialogue: 0,0:45:38.54,0:45:40.84,Default,Kus4,0,0,0,,يجب أن نتناول الإفطار معًا في كثير من الأحيان.
Dialogue: 0,0:45:41.47,0:45:43.54,Default,Kus4,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:45:51.82,0:45:54.49,Default,Kus4,0,0,0,,لا يمكن أن يكون الإفطار بدون مشروبات.
Dialogue: 0,0:45:59.16,0:46:03.06,Default,Kus4,0,0,0,,الشخص الذي سيموت في القصر اليوم هو الملكة.
Dialogue: 0,0:46:06.30,0:46:07.77,Default,Kus4,0,0,0,,يابني،
Dialogue: 0,0:46:08.73,0:46:11.14,Default,Kus4,0,0,0,,أستطيع أخيراً الانتقام.
Dialogue: 0,0:47:16.53,0:47:18.54,Default,Kus4,0,0,0,,لقد أعددت الثلج خصيصاً،
Dialogue: 0,0:47:18.54,0:47:21.61,Default,Kus4,0,0,0,,وهو أغلى من الذهب اليوم.
Dialogue: 0,0:47:26.48,0:47:28.08,Default,Kus4,0,0,0,,سوف أرى الجليد هنا للمرة الأولى.
Dialogue: 0,0:47:28.68,0:47:31.15,Default,Kus4,0,0,0,,الجو حار جدًا اليوم،
Dialogue: 0,0:47:31.18,0:47:34.32,Default,Kus4,0,0,0,,الوقت المثالي لتناول مشروب بارد.
Dialogue: 0,0:47:44.86,0:47:47.63,Default,Kus4,0,0,0,,ملكتي. لو سمحت.
Dialogue: 0,0:47:47.77,0:47:49.10,Default,Kus4,0,0,0,,أتوسل إليك. ملكتي.
Dialogue: 0,0:48:11.30,0:48:12.43,Default,Kus4,0,0,0,,كيف تجرؤ...
Dialogue: 0,0:48:12.53,0:48:17.44,Default,Kus4,0,0,0,,يجب أن أقول للملكة شيئاً.
Dialogue: 0,0:48:17.54,0:48:19.10,Default,Kus4,0,0,0,,كيف تجرؤ على المجيء إلى هنا؟ يترك.
Dialogue: 0,0:48:19.10,0:48:21.01,Default,Kus4,0,0,0,,هذا مهم جداً.
Dialogue: 0,0:48:22.67,0:48:23.77,Default,Kus4,0,0,0,,دامهيان؟
Dialogue: 0,0:48:24.04,0:48:25.84,Default,Kus4,0,0,0,,لماذا تفعل هذا؟
Dialogue: 0,0:48:25.84,0:48:27.98,Default,Kus4,0,0,0,,سأواجه مشاكل بسببك.
Dialogue: 0,0:48:28.91,0:48:31.05,Default,Kus4,0,0,0,,ما الأمر المهم جدًا؟
Dialogue: 0,0:48:36.82,0:48:38.62,Default,Kus4,0,0,0,,هل تعرف سيدة البلاط هذه؟
Dialogue: 0,0:48:40.29,0:48:43.09,Default,Kus4,0,0,0,,نعم. كثيرا ما أراها في المطبخ الملكي.
Dialogue: 0,0:48:44.86,0:48:47.06,Default,Kus4,0,0,0,,دامهيان، ماذا حدث؟
Dialogue: 0,0:48:47.67,0:48:49.10,Default,Kus4,0,0,0,,الأمر هو...
Dialogue: 0,0:48:53.27,0:48:54.94,Default,Kus4,0,0,0,,كما ترى...
Dialogue: 0,0:49:01.75,0:49:02.81,Default,Kus4,0,0,0,,أنا آسف.
Dialogue: 0,0:49:19.60,0:49:22.77,Default,Kus4,0,0,0,,لقد جئت لحضور وجبة الملكة الأرملة.
Dialogue: 0,0:49:23.73,0:49:26.34,Default,Kus4,0,0,0,,هذه تجمعات نسائية. لم يكن عليك أن تأتي.
Dialogue: 0,0:49:27.40,0:49:30.51,Default,Kus4,0,0,0,,هذه هي المرة الأولى التي أرى فيها الملكة في مثل هذا الاجتماع.
Dialogue: 0,0:49:31.08,0:49:32.34,Default,Kus4,0,0,0,,أعتذر.
Dialogue: 0,0:49:33.78,0:49:35.98,Default,Kus4,0,0,0,,إنه شرف لي.
Dialogue: 0,0:49:36.31,0:49:39.42,Default,Kus4,0,0,0,,كيف تسير الأمور مع مراقبة زوجك؟
Dialogue: 0,0:49:46.02,0:49:48.23,Default,Kus4,0,0,0,,الآن بعد أن استيقظ الملك،
Dialogue: 0,0:49:48.33,0:49:50.43,Default,Kus4,0,0,0,,سأبذل قصارى جهدي.
Dialogue: 0,0:49:52.93,0:49:55.57,Default,Kus4,0,0,0,,علينا أن نشرب قبل أن يذوب الجليد الثمين.
Dialogue: 0,0:50:06.88,0:50:08.15,Default,Kus4,0,0,0,,كيف يعجبك ذلك؟
Dialogue: 0,0:50:09.35,0:50:10.92,Default,Kus4,0,0,0,,الطعم منعش للغاية.
Dialogue: 0,0:50:14.85,0:50:16.42,Default,Kus4,0,0,0,,أعجبني كثيرًا لدرجة أنني لم أستطع المقاومة.
Dialogue: 0,0:50:58.23,0:50:59.33,Default,Kus4,0,0,0,,ملكتي!
Dialogue: 0,0:51:10.47,0:51:11.54,Default,Kus4,0,0,0,,جلالتك!
Dialogue: 0,0:51:16.91,0:51:18.12,Default,Kus4,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:51:18.38,0:51:20.45,Default,Kus4,0,0,0,,ماذا فعلت هنا؟
Dialogue: 0,0:51:23.35,0:51:25.99,Default,Kus4,0,0,0,,-هل أنت بخير؟\N-ماذا؟ نعم.
Dialogue: 0,0:51:26.12,0:51:28.63,Default,Kus4,0,0,0,,كيف تجرؤ على رمي حجر على الملكة؟
Dialogue: 0,0:51:30.33,0:51:32.06,Default,Kus4,0,0,0,,أنا بخير يا صاحب الجلالة.
Dialogue: 0,0:51:38.14,0:51:40.17,Default,Kus4,0,0,0,,خذ هذه الفتاة إلى السجن.
Dialogue: 0,0:51:40.84,0:51:42.87,Default,Kus4,0,0,0,,سوف تُعاقب على ما فعلته.
Dialogue: 0,0:51:45.24,0:51:46.28,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:51:48.78,0:51:49.88,Default,Kus4,0,0,0,,تعال معي.
Dialogue: 0,0:51:51.32,0:51:52.42,Default,Kus4,0,0,0,,دمهيان.
Dialogue: 0,0:52:01.93,0:52:03.49,Default,Kus4,0,0,0,,إنها مهمة جدًا بالنسبة لي.
Dialogue: 0,0:52:03.53,0:52:06.76,Default,Kus4,0,0,0,,أنا بخير، لذا لا تغضب.
Dialogue: 0,0:52:06.76,0:52:08.73,Default,Kus4,0,0,0,,هذا ليس له علاقة بك.
Dialogue: 0,0:52:09.20,0:52:11.54,Default,Kus4,0,0,0,,لقد أحدثت فوضى في القصر
Dialogue: 0,0:52:11.54,0:52:13.67,Default,Kus4,0,0,0,,وخالفت النظام القائم.
Dialogue: 0,0:52:14.74,0:52:16.37,Default,Kus4,0,0,0,,إنها مجرد طفلة.
Dialogue: 0,0:52:16.81,0:52:18.41,Default,Kus4,0,0,0,,أنا متأكد من أن لديها سببًا.
Dialogue: 0,0:52:18.41,0:52:20.04,Default,Kus4,0,0,0,,لن تفعل ذلك بدون سبب.
Dialogue: 0,0:52:20.04,0:52:21.65,Default,Kus4,0,0,0,,إذا واصلتم على هذا النحو،
Dialogue: 0,0:52:21.65,0:52:23.71,Default,Kus4,0,0,0,,سأتهمها بالسلوك غير اللائق
Dialogue: 0,0:52:23.71,0:52:25.62,Default,Kus4,0,0,0,,وسأعاقبك بشدة أكبر.
Dialogue: 0,0:52:30.35,0:52:32.42,Default,Kus4,0,0,0,,لماذا أتيت بهذه السرعة؟
Dialogue: 0,0:52:33.19,0:52:37.19,Default,Kus4,0,0,0,,هل تعلم حقاً أن الطفل سيحاول إيذاء الملكة؟
Dialogue: 0,0:52:39.10,0:52:40.96,Default,Kus4,0,0,0,,هل تحاول جرّي إلى هذا؟
Dialogue: 0,0:52:41.07,0:52:44.74,Default,Kus4,0,0,0,,كل ما في الأمر أن وقت وصولك تزامن تماماً.
Dialogue: 0,0:52:44.77,0:52:46.40,Default,Kus4,0,0,0,,كنت قلقة،
Dialogue: 0,0:52:46.40,0:52:48.91,Default,Kus4,0,0,0,,أن الشخص الذي خطط للخيانة،
Dialogue: 0,0:52:48.91,0:52:50.54,Default,Kus4,0,0,0,,يقع بجوار الملكة.
Dialogue: 0,0:52:51.08,0:52:52.74,Default,Kus4,0,0,0,,لقد خرب هذا الاجتماع.
Dialogue: 0,0:52:53.24,0:52:54.71,Default,Кусь4,0,0,0,,أنا في تونموندجون.
Dialogue: 0,0:53:06.96,0:53:09.86,Default,Kus4,0,0,0,,سأعاقب الطفل بالتأكيد على انتهاك خططنا.
Dialogue: 0,0:53:10.46,0:53:12.50,Default,Kus4,0,0,0,,سوف تتحمل المسؤولية أيضًا،
Dialogue: 0,0:53:12.93,0:53:14.80,Default,Кусь4,0,0,0,,لأنك لا تقف تحت قضيبنا.
Dialogue: 0,0:53:22.27,0:53:23.44,Default,أناناسيك5,0,0,0,,ماذا مع أي شيء آخر؟
Dialogue: 0,0:53:23.54,0:53:26.21,Default,Pineapple5,0,0,0,,لن يضربوا الفتاة، أليس كذلك؟
Dialogue: 0,0:53:26.41,0:53:28.08,Default,أناناسيك5,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:53:28.08,0:53:30.88,Default,Pineapple5,0,0,0,,ربما يتخدر لسانك أو أن قلبك ينبض بجنون؟
Dialogue: 0,0:53:32.05,0:53:33.68,Default,أناناسيك5,0,0,0,,لماذا أنت في عجلة من أمرك؟\Nheugeli...
Dialogue: 0,0:53:33.68,0:53:35.09,Default,أناناسيك5,0,0,0,,لم يعد هناك.
Dialogue: 0,0:53:36.19,0:53:38.06,Default,أناناسيك5,0,0,0,,نحن في طريقنا إلى تيدجون.
Dialogue: 0,0:53:38.66,0:53:39.96,Default,Pineapple5,0,0,0,,نعم يا سيدي.
Dialogue: 0,0:53:55.34,0:53:57.34,Default,أناناسيك5,0,0,0,,حسنًا، في هذه اللحظة
Dialogue: 0,0:53:57.91,0:54:00.51,Default,أناناسيك5,0,0,0,,بعد كل شيء، ما هو هذا أو ما هو آخر.
Dialogue: 0,0:54:01.35,0:54:03.25,Default,Pineapple5,0,0,0,,هل أزعجت أحداً؟
Dialogue: 0,0:54:06.18,0:54:09.99,Default,Pineapple5,0,0,0,,أنا متأكد من أن كيم جواجيون والملكة الأرملة حاولا تسميمك.
Dialogue: 0,0:54:11.32,0:54:14.36,Default,أناناسيك5,0,0,0,,بسبب ما. لم أفعل أي شيء!
Dialogue: 0,0:54:16.86,0:54:20.40,Default,ANASICK5,0,0,0,,أو هل هذا كل ما يمكنني فعله مع بيروم؟
Dialogue: 0,0:54:21.27,0:54:22.67,Default,الأناناس5,0,0,0,,وجدت في غرفتك
Dialogue: 0,0:54:24.23,0:54:25.94,Default,Pineapple5,0,0,0,,دفتر الحسابات.
Dialogue: 0,0:54:26.97,0:54:28.01,Default,أناناسيك5,0,0,0,,هل لديك كتاب؟
Dialogue: 0,0:54:30.61,0:54:33.34,Default,Pineapple5,0,0,0,,لذا سألني كيم جواجيون وأبي عنها.
Dialogue: 0,0:54:34.24,0:54:36.25,Default,Pineapple5,0,0,0,,ما مشكلة هذا الكتاب؟
Dialogue: 0,0:54:37.28,0:54:39.42,Default,Pineapple5,0,0,0,,لم تحضرها معك من المنزل؟
Dialogue: 0,0:54:40.02,0:54:41.62,Default,Pineapple5,0,0,0,,نعم، لم يكن لدي أي فكرة عن وجودها.
Dialogue: 0,0:54:41.62,0:54:44.02,Default,Pineapple5,0,0,0,,لم أرها في المنزل، بل وأكثر من ذلك هنا.
Dialogue: 0,0:54:45.82,0:54:47.02,Default,Pineapple5,0,0,0,,هكذا هو الحال.
Dialogue: 0,0:54:47.83,0:54:49.79,Default,Pineapple5,0,0,0,,أرادوا التسميم، وليس الإطاحة.
Dialogue: 0,0:54:51.73,0:54:53.66,Default,Pineapple5,0,0,0,,إذًا دامهيانغ أنقذني؟
Dialogue: 0,0:54:54.13,0:54:55.20,Default,Pineapple5,0,0,0,,يبدو هكذا.
Dialogue: 0,0:54:55.43,0:54:56.90,Default,الأناناس5,0,0,0,,السم في المشروب.
Dialogue: 0,0:54:58.07,0:55:00.10,Default,Pineapple5,0,0,0,,أخذت رشفتين.
Dialogue: 0,0:55:00.44,0:55:03.24,Default,Pineapple5,0,0,0,,سأكتشف كل شيء من دامهيانغ.
Dialogue: 0,0:55:03.57,0:55:05.01,Default,Pineapple5,0,0,0,,سأسألها بنفسي.
Dialogue: 0,0:55:05.34,0:55:07.85,Default,Pineapple5,0,0,0,,هل ستكون بخير؟\Nيجب ألا تتأذى.
Dialogue: 0,0:55:08.21,0:55:10.35,Default,Pineapple5,0,0,0,,الشخص الذي خطط لتسميمك،
Dialogue: 0,0:55:10.35,0:55:11.88,Default,Pineapple5,0,0,0,,لن أسمح لها بالرحيل بهذه الطريقة.
Dialogue: 0,0:55:14.45,0:55:16.49,Default,Pineapple5,0,0,0,,أنقذها، أتوسل إليك.
Dialogue: 0,0:55:22.16,0:55:23.79,Default,Pineapple5,0,0,0,,سأبذل قصارى جهدي.
Dialogue: 0,0:56:17.18,0:56:20.15,Default,Pineapple5,0,0,0,,لم أرتكب أي جريمة.
Dialogue: 0,0:56:20.78,0:56:22.22,Default,Pineapple5,0,0,0,,لم أسرق هذا المال.
Dialogue: 0,0:56:23.05,0:56:25.49,Default,Pineapple5,0,0,0,,لقد كنت أحفظهم لسنوات عديدة،
Dialogue: 0,0:56:25.49,0:56:27.32,Default,Pineapple5,0,0,0,,لفدية الأصغر من العبودية.
Dialogue: 0,0:56:32.20,0:56:33.30,Default,Pineapple5,0,0,0,,من فضلك ارحمني.
Dialogue: 0,0:56:34.46,0:56:36.93,Default,Pineapple5,0,0,0,,إذا مت، أصغر إخوتي...
Dialogue: 0,0:56:42.64,0:56:44.11,Default,Pineapple5,0,0,0,,قل كل ما تعرفه
Dialogue: 0,0:56:45.91,0:56:47.11,Default,Pineapple5,0,0,0,,حول هذا النوريج.
Dialogue: 0,0:57:02.73,0:57:04.90,Default,Pineapple5,0,0,0,,-دامهيانغ!\N-جلالتك!
Dialogue: 0,0:57:06.03,0:57:08.10,Default,Pineapple5,0,0,0,,هل أنت بخير أيتها الملكة؟
Dialogue: 0,0:57:08.10,0:57:09.90,Default,Pineapple5,0,0,0,,أريد أن أسألك هذا.
Dialogue: 0,0:57:10.30,0:57:12.04,Default,Pineapple5,0,0,0,,يا لها من نعمة أنك جربتها
Dialogue: 0,0:57:12.47,0:57:16.24,Default,الأناناس5,0,0,0,,اشرب قبل أن يذوب الجليد.
Dialogue: 0,0:57:17.98,0:57:18.98,Default,Pineapple5,0,0,0,,الثلج؟
Dialogue: 0,0:57:20.41,0:57:21.71,Default,Pineapple5,0,0,0,,ترجمها الآن!
Dialogue: 0,0:57:21.71,0:57:22.71,Default,Pineapple5,0,0,0,,-نعم.\N-نعم.
Dialogue: 0,0:57:25.52,0:57:27.99,Default,Pineapple5,0,0,0,,إلى أين ستنقلها؟ أين؟
Dialogue: 0,0:57:32.26,0:57:34.56,Default,Pineapple5,0,0,0,,جلالتك، لا ينبغي أن تكون هنا.
Dialogue: 0,0:57:34.99,0:57:37.19,Default,Pineapple5,0,0,0,,أنت تعلم أنها ليست مسؤولة عن أي شيء.
Dialogue: 0,0:57:37.19,0:57:38.60,Default,Pineapple5,0,0,0,,أنا لا أفهمك.
Dialogue: 0,0:57:40.93,0:57:43.50,Default,Pineapple5,0,0,0,,إنها مذنبة فقط بإنقاذي.
Dialogue: 0,0:57:44.33,0:57:46.60,Default,Pineapple5,0,0,0,,لا أعرف من قال لك هذا،\Nولكن من فضلك،
Dialogue: 0,0:57:46.94,0:57:48.21,Default,Pineapple5,0,0,0,,عد إلى نفسك.
Dialogue: 0,0:57:51.01,0:57:52.11,Default,Pineapple5,0,0,0,,ماذا لو رفضت؟
Dialogue: 0,0:57:53.14,0:57:55.98,Default,Pineapple5,0,0,0,,ستتم محاكمة الفتاة وفقاً للقوانين.
Dialogue: 0,0:57:56.98,0:57:59.22,Default,Pineapple5,0,0,0,,إذا بقيت ستعاني.
Dialogue: 0,0:58:00.45,0:58:02.29,Default,Pineapple5,0,0,0,,اصطحب الملكة إلى غرفتها.
Dialogue: 0,0:58:02.29,0:58:03.32,Default,Pineapple5,0,0,0,,-نعم.\N-نعم.
Dialogue: 0,0:58:07.56,0:58:09.79,Default,Pineapple5,0,0,0,,-دعني أذهب!\N-سوف أرافق الملكة.
Dialogue: 0,0:58:18.17,0:58:20.00,Default,Pineapple5,0,0,0,,عودي إلى نفسك أيتها الملكة.
Dialogue: 0,0:58:20.64,0:58:24.64,Default,Pineapple5,0,0,0,,الفضائح الصاخبة\Nلن تساعد هذه الفتاة بأي شكل من الأشكال.
Dialogue: 0,0:58:26.41,0:58:27.44,Default,Pineapple5,0,0,0,,يا صاحب الجلالة!
Dialogue: 0,0:58:45.26,0:58:48.43,Default,Pineapple5,0,0,0,,دامهيانغ، سأحررك قريباً.\NAهل ترغب؟
Dialogue: 0,0:58:49.93,0:58:51.77,Default,Pineapple5,0,0,0,,لا تخف.
Dialogue: 0,0:58:52.40,0:58:53.87,Default,Pineapple5,0,0,0,,حسنًا.
Dialogue: 0,0:58:55.94,0:58:58.48,Default,Pineapple5,0,0,0,,الملكة، علينا أن نذهب.
Dialogue: 0,0:59:00.78,0:59:01.91,Default,Pineapple5,0,0,0,,سوف أطلق سراحك.
Dialogue: 0,0:59:27.50,0:59:31.37,Default,Pineapple5,0,0,0,,كيف تجرؤ سيدة البلاط\Nعلى رمي حجر على الملكة؟
Dialogue: 0,0:59:31.37,0:59:32.98,Default,Pineapple5,0,0,0,,هذه إهانة للشخص الملكي!
Dialogue: 0,0:59:32.98,0:59:36.35,Default,Pineapple5,0,0,0,,كل شيء أسوأ بكثير!\Nهذه خيانة بالفعل!
Dialogue: 0,0:59:37.18,0:59:39.15,Default,Pineapple5,0,0,0,,سمعت أن والدها متهم بالانحراف
Dialogue: 0,0:59:39.15,0:59:41.15,Default,Pineapple5,0,0,0,,من الخدمة العسكرية والخيانة.
Dialogue: 0,0:59:41.15,0:59:42.85,Default,Pineapple5,0,0,0,,كما يقولون، الدم ليس ماء.
Dialogue: 0,0:59:44.25,0:59:46.62,Default,Pineapple5,0,0,0,,أعزائي الوزراء، أنتم تبالغون في ردة فعلكم.
Dialogue: 0,0:59:46.62,0:59:49.86,Default,Pineapple5,0,0,0,,لا نعرف حتى الآن ما الذي دفعها للقيام بذلك.
Dialogue: 0,0:59:50.16,0:59:53.00,Default,Pineapple5,0,0,0,,انتفاضة الفلاحين تكتسب زخماً و
Dialogue: 0,0:59:53.00,0:59:55.27,Default,Pineapple5,0,0,0,,يهدد السلطة الملكية.
Dialogue: 0,0:59:55.43,0:59:57.13,Default,Pineapple5,0,0,0,,وباستخدام هذه الفتاة كمثال، يجب علينا
Dialogue: 0,0:59:57.13,0:59:58.97,Default,Pineapple5,0,0,0,,عزز قوتك بين الناس.
Dialogue: 0,0:59:58.97,1:00:00.97,Default,Pineapple5,0,0,0,,الآن أنت تسحب الفلاحين المتمردين؟
Dialogue: 0,1:00:00.97,1:00:04.44,Default,Pineapple5,0,0,0,,كيف تجرؤ على رمي حجر على الملكة؟
Dialogue: 0,1:00:04.44,1:00:07.34,Default,Pineapple5,0,0,0,,أنا متأكد من أن هؤلاء اللصوص قاموا بغسل دماغها!
Dialogue: 0,1:00:07.58,1:00:11.25,Default,Pineapple5,0,0,0,,غسل دماغها من قبل قطاع الطرق؟\Nعمر الفتاة خمس سنوات فقط.
Dialogue: 0,1:00:11.25,1:00:13.02,Default,Pineapple5,0,0,0,,لا تعتبر الأمر وقاحة،
Dialogue: 0,1:00:13.25,1:00:15.82,Default,Pineapple5,0,0,0,,لكن البعض يعتقد\Nأنك يا سيدي،
Dialogue: 0,1:00:16.15,1:00:19.32,Default,Pineapple5,0,0,0,,نعيش في كانغهوادو،\Nتحدثنا مع قطاع الطرق المتمردين.
Dialogue: 0,1:00:20.02,1:00:23.03,Default,Pineapple5,0,0,0,,الآن قررت تهديدي بهذا؟
Dialogue: 0,1:00:23.86,1:00:26.70,Default,Pineapple5,0,0,0,,إذا رفضت معاقبة الفتاة وحاولت إنقاذها،
Dialogue: 0,1:00:27.03,1:00:31.54,Default,Pineapple5,0,0,0,,سوف تؤكد فقط شكوكنا في ذلك
Dialogue: 0,1:00:32.24,1:00:34.17,Default,Pineapple5,0,0,0,,إنك توافق على قطاع الطرق.
Dialogue: 0,1:00:35.41,1:00:38.34,Default,Pineapple5,0,0,0,,أنت فقط بحاجة إلى معاقبة الخادمة على العصيان.
Dialogue: 0,1:00:38.98,1:00:40.68,Default,Pineapple5,0,0,0,,وسينتهي كل شيء.
Dialogue: 0,1:00:46.98,1:00:48.65,Default,Pineapple5,0,0,0,,سوف يستمع إلينا، أليس كذلك؟
Dialogue: 0,1:00:49.25,1:00:52.46,Default,Pineapple5,0,0,0,,الملكة الأرملة\طلبت منا الإصرار على العقاب.
Dialogue: 0,1:00:53.09,1:00:55.43,Default,Pineapple5,0,0,0,,ينفس عن غضبه عليه
Dialogue: 0,1:00:55.43,1:00:57.06,Default,Pineapple5,0,0,0,,هل تم عزلها من العرش؟
Dialogue: 0,1:00:57.49,1:00:59.80,Default,Pineapple5,0,0,0,,مثل هذه الفتاة التي لا قيمة لها
Dialogue: 0,1:00:59.80,1:01:04.17,Default,Pineapple5,0,0,0,,هل تجرؤ على منعنا من التخلص من الملكة؟
Dialogue: 0,1:01:25.59,1:01:27.46,Default,Pineapple5,0,0,0,,ما الذي استغرق كل هذا الوقت؟
Dialogue: 0,1:01:28.59,1:01:29.99,Default,Pineapple5,0,0,0,,كل شيء سيكون على ما يرام، أليس كذلك؟
Dialogue: 0,1:01:30.69,1:01:33.50,Default,Pineapple5,0,0,0,,مثل هذه الاجتماعات المتأخرة\Nلا تؤدي أبدًا إلى أشياء جيدة.
Dialogue: 0,1:01:36.17,1:01:37.80,Default,Pineapple5,0,0,0,,-جلالتك.\N-نعم؟
Dialogue: 0,1:02:00.66,1:02:02.56,Default,Pineapple5,0,0,0,,هنا يا صاحب الجلالة!
Dialogue: 0,1:02:02.56,1:02:03.66,Default,Pineapple5,0,0,0,,حسنًا.
Dialogue: 0,1:02:09.40,1:02:12.84,Default,Pineapple5,0,0,0,,تذكر هذه اللحظة لبقية حياتك.
Dialogue: 0,1:02:13.17,1:02:18.01,Default,Pineapple5,0,0,0,,يجب أن يكون رجال البلاط في القصر\Nعميان وأصماء عما يحدث،
Dialogue: 0,1:02:18.98,1:02:22.85,Default,Pineapple5,0,0,0,,يجب ألا تكون هناك فكرة متمردة واحدة في أذهانهم.
Dialogue: 0,1:02:23.48,1:02:26.15,Default,Pineapple5,0,0,0,,إذا كان أحدكم على الأقل يدعم
Dialogue: 0,1:02:26.15,1:02:29.75,Default,Pineapple5,0,0,0,,انتفاضة الفلاحين، هذا ما ينتظرك.
Dialogue: 0,1:02:31.29,1:02:33.26,Default,Pineapple5,0,0,0,,كانت الخادمة طفلة حمقاء.
Dialogue: 0,1:02:35.06,1:02:36.13,Default,Pineapple5,0,0,0,,هادئ!
Dialogue: 0,1:02:39.33,1:02:41.30,Default,Pineapple5,0,0,0,,ظننت أننا قبضنا على شخص مهم،
Dialogue: 0,1:02:42.80,1:02:45.77,Default,Pineapple5,0,0,0,,لكن هذا مجرد طفل؟\NIإنه غير مفهوم!
Dialogue: 0,1:02:54.74,1:02:55.78,Default,Pineapple5,0,0,0,,هل تأخرنا؟
Dialogue: 0,1:03:04.55,1:03:06.39,Default,Pineapple5,0,0,0,,الآن تعرف ما أشعر به.
Dialogue: 0,1:03:14.56,1:03:16.77,Default,Pineapple5,0,0,0,,أرادت إنقاذك.
Dialogue: 0,1:03:17.97,1:03:19.20,Default,Pineapple5,0,0,0,,لهذا السبب قتلوها.
Dialogue: 0,1:03:21.07,1:03:22.87,Default,Pineapple5,0,0,0,,أرادوا تسميمي، لكن دامهيان منع ذلك.
Dialogue: 0,1:04:06.48,1:04:07.88,Default,Pineapple5,0,0,0,,ليست مسؤولة عن أي شيء.
Dialogue: 0,1:04:08.89,1:04:10.15,Default,Pineapple5,0,0,0,,لقد قلتها بنفسك،
Dialogue: 0,1:04:11.49,1:04:15.59,Default,Pineapple5,0,0,0,,لقد وضعوا خطاياهم على طفل صغير!
Dialogue: 0,1:04:21.56,1:04:22.80,Default,Pineapple5,0,0,0,,لماذا لم تنقذها؟
Dialogue: 0,1:04:24.03,1:04:26.00,Default,Pineapple5,0,0,0,,لقد أصبحت ضحية باسم شيء أعظم.
Dialogue: 0,1:04:27.80,1:04:28.84,Default,Pineapple5,0,0,0,,المزيد؟
Dialogue: 0,1:04:30.71,1:04:31.98,Default,Pineapple5,0,0,0,,هل تتحدث عن بشرتك؟
Dialogue: 0,1:04:34.78,1:04:38.01,Default,Pineapple5,0,0,0,,ألم تخبرني أن العالم غير عادل؟
Dialogue: 0,1:04:38.85,1:04:42.65,Default,Pineapple5,0,0,0,,تضحية ضئيلة ستوقف\Nشيء أكثر خطورة!
Dialogue: 0,1:04:44.09,1:04:45.26,Default,Pineapple5,0,0,0,,ضحية غير مهمة؟
Dialogue: 0,1:04:48.32,1:04:49.43,Default,Pineapple5,0,0,0,,لأنه
Dialogue: 0,1:04:50.49,1:04:52.30,Default,Pineapple5,0,0,0,,هل هي مجرد فتاة لا حول لها ولا قوة؟
Dialogue: 0,1:04:56.00,1:04:57.43,Default,Pineapple5,0,0,0,,الهواة خطيئة.
Dialogue: 0,1:04:58.97,1:05:01.20,Default,Pineapple5,0,0,0,,لا يمكنك إنقاذ هذه الفتاة!
Dialogue: 0,1:05:03.97,1:05:05.11,Default,Pineapple5,0,0,0,,أنت مذنب.
Dialogue: 0,1:05:30.60,1:05:32.40,Default,Pineapple5,0,0,0,,إذا كنت لا تريد التحدث،\Nهل يجب أن نستخدم إشارات اليد؟
Dialogue: 0,1:05:32.40,1:05:33.50,Default,Pineapple5,0,0,0,,على سبيل المثال، هذه.
Dialogue: 0,1:05:33.50,1:05:35.71,Default,Pineapple5,0,0,0,,هذا يعني أنني أكذب.
Dialogue: 0,1:05:36.04,1:05:37.17,Default,Pineapple5,0,0,0,,ماذا تقول؟
Dialogue: 0,1:05:46.24,1:05:50.68,Default,Pineapple5,0,0,0,,
Dialogue: 0,1:06:06.37,1:06:08.81,Default,Pineapple5,0,0,0,,من هذا اليوم فصاعداً، سأصبح\Nالشخص الأكثر جنوناً في القصر.
Dialogue: 0,1:06:08.81,1:06:12.68,Default,Pineapple5,0,0,0,,سأريك ما يحدث عندما تغضبني.
Dialogue: 0,1:06:12.68,1:06:14.74,Default,Pineapple5,0,0,0,,هل حاولت التخلص من الملكة؟
Dialogue: 0,1:06:14.91,1:06:16.65,Default,Pineapple5,0,0,0,,-دامهيان!\N-دمهيان!
Dialogue: 0,1:06:18.01,1:06:19.25,Default,Pineapple5,0,0,0,,أراهن بكل شيء!
Dialogue: 0,1:06:19.25,1:06:20.65,Default,Pineapple5,0,0,0,,لا تقلل من شأن كيم بيونغين.
Dialogue: 0,1:06:20.65,1:06:22.45,Default,Pineapple5,0,0,0,,حتى عشيرة تشو تطيعه.
Dialogue: 0,1:06:22.45,1:06:23.62,Default,Pineapple5,0,0,0,,دعونا نصبح حلفاء.
Dialogue: 0,1:06:23.62,1:06:26.49,Default,Pineapple5,0,0,0,,من الآن فصاعدا، انسَ أمر التباعد.
Dialogue: 0,1:06:26.49,1:06:28.02,Default,Pineapple5,0,0,0,,اهدأ أيها القلب الجامح.
Dialogue: 0,1:06:28.02,1:06:30.19,Default,Pineapple5,0,0,0,,كل هذا مجرد اختبار.
Dialogue: 0,1:06:30.19,1:06:32.43,Default,Pineapple5,0,0,0,,هل تريد أن تأكل بعض الرامن؟
Dialogue: 0,0:13:26.28,0:13:28.28,Default,,0,0,0,,


