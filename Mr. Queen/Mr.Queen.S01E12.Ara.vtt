Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.16,0:01:06.43,Default,Spilik1,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.43,0:01:08.53,Default,Spilyk1,0,0,0,,والأحداث المعروضة هي من خيال.
Dialogue: 0,0:02:10.66,0:02:11.76,Default,Spilik1,0,0,0,,إذاً لقد كنت أنت.
Dialogue: 0,0:02:12.66,0:02:14.33,Default,Spilik1,0,0,0,,لقد كنت ذلك الشخص.
Dialogue: 0,0:02:22.94,0:02:24.51,Default,Spilik1,0,0,0,,لن أسامحك.
Dialogue: 0,0:02:44.66,0:02:47.40,Default,Spilik1,0,0,0,,سأقتلك.
Dialogue: 0,0:03:42.72,0:03:45.69,Default,Spilik1,0,0,0,,12 حلقة: الرقص على حد السيف
Dialogue: 0,0:03:49.90,0:03:52.84,Default,Spilik1,0,0,0,,
Dialogue: 0,0:03:53.31,0:03:56.71,Default,Spilik1,0,0,0,,الآن أفهم من هو الرئيس في القصر؟
Dialogue: 0,0:04:04.55,0:04:07.02,Default,Spilik1,0,0,0,,كدت أن أطلق عليك النار. \NMistaken للفريسة.
Dialogue: 0,0:04:07.19,0:04:09.29,Default,Spikyulka1,0,0,0,,أو ربما فاتتها بالخطأ؟
Dialogue: 0,0:04:10.29,0:04:11.46,Default,Spilik1,0,0,0,,إنه مجرد سوء فهم.
Dialogue: 0,0:04:19.64,0:04:21.47,Default,Spilik1,0,0,0,,تذكر مكانك.
Dialogue: 0,0:04:28.58,0:04:30.68,Default,Spilik1,0,0,0,,لا بد لي من تغيير الملابس.
Dialogue: 0,0:04:30.68,0:04:31.75,Default,Spilik1,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:04:54.37,0:04:56.37,Default,Spilyk1,0,0,0,,هناك قضية لقسم المباحث.
Dialogue: 0,0:05:07.32,0:05:09.29,Default,Spikyulka1,0,0,0,,هل كان من الضروري فعل هذا مع Ovol؟
Dialogue: 0,0:05:13.46,0:05:14.82,Default,Spilik1,0,0,0,,ماذا فعلت؟
Dialogue: 0,0:05:15.22,0:05:17.36,Default,Spillie1,0,0,0,,هل كان من الضروري قتلها؟
Dialogue: 0,0:05:17.66,0:05:20.26,Default,Spiky1,0,0,0,,ثم أرمي الميت في البئر؟
Dialogue: 0,0:05:20.63,0:05:25.43,Default,Spikyulka1,0,0,0,,هل كان عليك أن تفعل هذا بفتاة بريئة فقط لتخيفني؟
Dialogue: 0,0:05:25.64,0:05:26.77,Default,Spillie1,0,0,0,,هل قتلتها؟
Dialogue: 0,0:05:26.97,0:05:28.91,Default,Spilyk1,0,0,0,,من أين يأتي هذا المفهوم الخاطئ؟
Dialogue: 0,0:05:29.04,0:05:30.51,Default,Spilik1,0,0,0,,أنا بشكل عام ضد قتل جميع الكائنات الحية،
Dialogue: 0,0:05:30.51,0:05:32.48,Default,Spilik1,0,0,0,,إلا للطهي.
Dialogue: 0,0:05:35.21,0:05:37.91,Default,Spiky1,0,0,0,,حقيقة العثور على جثتها في البئر هي إما صدفة فظيعة،
Dialogue: 0,0:05:38.38,0:05:40.52,Default,Spikyulka1,0,0,0,,أو يريد أحد أن يدفعنا إلى الأمام.
Dialogue: 0,0:05:41.75,0:05:45.62,Default,Spilik1,0,0,0,,أنكر أكثر حتى يصل غضبي إلى حده.
Dialogue: 0,0:05:45.92,0:05:49.13,Default,Spilik1,0,0,0,,أنت تقودني إلى الجنون. \NI بالتأكيد لم أفعل هذا.
Dialogue: 0,0:05:49.13,0:05:51.46,Default,Spilik1,0,0,0,,من أين يأتي هذا الرأي السيئ عني؟
Dialogue: 0,0:05:51.66,0:05:52.93,Default,Spilik1,0,0,0,,لأن هذا هو شخصيتك.
Dialogue: 0,0:05:53.23,0:05:56.83,Default,Spilik1,0,0,0,,كيم سويون، التي أعرفها، قادرة على هذا.
Dialogue: 0,0:05:57.37,0:05:59.20,Default,Spikyulka1,0,0,0,,كيف تعرفني إذا كنت لا أعرف نفسي بعد؟
Dialogue: 0,0:05:59.34,0:06:03.44,Default,Spilik1,0,0,0,,أفضل الكذاب يكذب على نفسه.
Dialogue: 0,0:06:03.77,0:06:06.51,Default,Silk1,0,0,0,,إنك تخدع نفسك بقولك أنك لا تعرف من أنت.
Dialogue: 0,0:06:12.01,0:06:15.42,Default,Spikyulka1,0,0,0,,أعتقد أننا تجاوزنا الآن نقطة اللاعودة.
Dialogue: 0,0:06:16.42,0:06:19.16,Default,Silk1,0,0,0,,لن أهتم\N بمفاهيمك الخاطئة عني.
Dialogue: 0,0:06:20.12,0:06:21.46,Default,Spilik1,0,0,0,,افعل ما تريد.
Dialogue: 0,0:06:29.73,0:06:30.77,Default,Spillit1,0,0,0,,أرنب
Dialogue: 0,0:06:43.95,0:06:45.15,Default,Spilik1,0,0,0,,من أطلق النار عليها؟
Dialogue: 0,0:06:45.15,0:06:47.38,Default,Spikyulka1,0,0,0,,طاردناها كثيراً، فمن تجرأ...
Dialogue: 0,0:06:55.42,0:06:58.39,Default,Spilik1,0,0,0,,يبدو أن لدينا فائزًا. حان الوقت للعودة.
Dialogue: 0,0:06:58.83,0:07:00.13,Default,Spilik1,0,0,0,,-نعم يا ملكة.\N-نعم يا ملكة.
Dialogue: 0,0:07:15.41,0:07:16.68,Default,Spillie1,0,0,0,,هذا هو الدم.
Dialogue: 0,0:07:19.15,0:07:20.52,Default,Spilik1,0,0,0,,هذا هراء.
Dialogue: 0,0:07:21.68,0:07:23.75,Default,Spillie1,0,0,0,,هل أنت مجنون تمامًا؟ إنه أمر مؤلم بشكل لا يصدق.
Dialogue: 0,0:07:24.32,0:07:27.12,Default,Spikyulka1,0,0,0,,آسفة، لقد انزلقت يدي.
Dialogue: 0,0:07:27.66,0:07:29.96,Default,Spilik1,0,0,0,,-ذلك الصغير...\N-هل أنت بخير يا صاحب الجلالة؟
Dialogue: 0,0:07:29.96,0:07:32.33,Default,Spilik1,0,0,0,,حتى مع طرف ناعم، لا يزال الأمر مؤلمًا.
Dialogue: 0,0:07:32.70,0:07:34.83,Default,Spilik1,0,0,0,,صاحب السمو، ماذا أنت...
Dialogue: 0,0:07:41.44,0:07:43.14,Default,Spilyk1,0,0,0,,سوف أعوضك.
Dialogue: 0,0:07:44.27,0:07:46.01,Default,Spilik1,0,0,0,,أنت ميت.
Dialogue: 0,0:07:51.71,0:07:52.75,Default,Spilik1,0,0,0,,بجدية؟
Dialogue: 0,0:07:54.08,0:07:57.62,Default,Spiky1,0,0,0,,من أجل زوجي العزيز، سأطلق سراحها اليوم.
Dialogue: 0,0:07:58.59,0:08:00.56,Default,Spilik1,0,0,0,,-لأنني المسؤول هنا.\N-بالطبع يا صاحب الجلالة.
Dialogue: 0,0:08:08.40,0:08:09.97,Default,Spilik1,0,0,0,,اذهب إلى قاعة Hidzhonjon.
Dialogue: 0,0:08:10.43,0:08:12.07,Default,Spilyk1,0,0,0,,سأساعدك على تغيير ملابسك...
Dialogue: 0,0:08:12.07,0:08:14.17,Default,Spilik1,0,0,0,,هناك من يحاول تعطيل الوليمة،
Dialogue: 0,0:08:15.14,0:08:16.81,Default,Spilik1,0,0,0,,لذا سأذهب وحدي.
Dialogue: 0,0:08:51.57,0:08:54.11,Default,Spikyulka1,0,0,0,,جميع المدعوين هنا اليوم،
Dialogue: 0,0:08:54.11,0:08:56.58,Default,Spikyulka1,0,0,0,,سوف يدرك الملك الذي يتمتع بالسلطة.
Dialogue: 0,0:08:57.01,0:08:58.91,Default,Spikyulka1,0,0,0,,وكل ما قيل عنه،
Dialogue: 0,0:08:58.91,0:09:00.68,Default,Spilik1,0,0,0,,حتى لقب أمير الحطاب من كانغهوادو،
Dialogue: 0,0:09:00.78,0:09:03.09,Default,Spikyulka1,0,0,0,,سوف تتحول إلى شائعات كاذبة.
Dialogue: 0,0:09:04.45,0:09:07.09,Default,Spilik1,0,0,0,,أصر الملك على إقامة وليمة.
Dialogue: 0,0:09:07.09,0:09:08.46,Default,Spikyulka1,0,0,0,,لابد أنني اخترت هذا اليوم،
Dialogue: 0,0:09:08.46,0:09:10.79,Default,Spikyulka1,0,0,0,,للمثول أمام المحكمة بثوب جديد.
Dialogue: 0,0:09:12.16,0:09:13.83,Default,Spilik1,0,0,0,,كيف تمكنت من الرمش
Dialogue: 0,0:09:15.40,0:09:17.93,Default,Spilyk1,0,0,0,,استعداداته؟
Dialogue: 0,0:09:20.20,0:09:21.54,Default,Spilik1,0,0,0,,عذراً.
Dialogue: 0,0:09:22.27,0:09:23.27,Default,Spilyk1,0,0,0,,ومع ذلك
Dialogue: 0,0:09:23.91,0:09:27.21,Default,Spilik1,0,0,0,,لدي أيضًا شيء مُجهز للملك،
Dialogue: 0,0:09:28.64,0:09:30.08,Default,Spilik1,0,0,0,,لذا راقب بعناية.
Dialogue: 0,0:09:32.55,0:09:35.28,Default,Spikyulka1,0,0,0,,آمل أن تكون مستعداً كما ينبغي.
Dialogue: 0,0:09:43.69,0:09:45.33,Default,Spilyk1,0,0,0,,محظية حضرة.
Dialogue: 0,0:09:46.06,0:09:47.20,Default,Spilik1,0,0,0,,نقطة واحدة.
Dialogue: 0,0:09:48.76,0:09:51.53,Default,Spilik1,0,0,0,,المحظية الملكية تشو. 2 نقطة.
Dialogue: 0,0:09:53.17,0:09:54.77,Default,Spillie1,0,0,0,,المحظية مين.
Dialogue: 0,0:09:56.37,0:09:57.67,Default,Spilyk1,0,0,0,,4 نقاط.
Dialogue: 0,0:09:58.57,0:10:02.11,Default,Spilyk1,0,0,0,,المحظية يون. لديها أيضا 4 نقاط.
Dialogue: 0,0:10:04.61,0:10:06.18,Default,Spillit1,0,0,0,,الملكة.
Dialogue: 0,0:10:09.25,0:10:10.32,Default,Spilyk1,0,0,0,,10 نقاط.
Dialogue: 0,0:10:11.19,0:10:12.22,Default,Spilik1,0,0,0,,واو!
Dialogue: 0,0:10:16.03,0:10:19.20,Default,Spilik1,0,0,0,,وفي النهاية فازت الملكة.
Dialogue: 0,0:10:19.46,0:10:22.26,Default,Spilik1,0,0,0,,ستقدم الملكة الأم الجائزة.
Dialogue: 0,0:10:33.98,0:10:36.71,Default,Spilik1,0,0,0,,قالت أنك ستستمتع بالعطلة فحسب.
Dialogue: 0,0:10:36.85,0:10:38.75,Default,Silk1,0,0,0,,تتدرب سراً؟
Dialogue: 0,0:10:38.91,0:10:41.22,Default,Spilyk1,0,0,0,,مثل الممثل المولود،
Dialogue: 0,0:10:42.75,0:10:44.99,Default,Spilyk1,0,0,0,,أنا أفضل في الألعاب الحقيقية.
Dialogue: 0,0:10:48.49,0:10:51.03,Default,Spilik1,0,0,0,,تهانينا يا صاحب الجلالة.
Dialogue: 0,0:10:51.03,0:10:53.66,Default,Silk1,0,0,0,,-تهانينا يا صاحب الجلالة.\N-تهانينا يا صاحب الجلالة.
Dialogue: 0,0:10:58.90,0:11:00.20,Default,Spilik1,0,0,0,,ما هذا الغدر.
Dialogue: 0,0:11:01.10,0:11:04.07,Default,Silk1,0,0,0,,يجب أن نذهب إلى القصر من أجل الوليمة.
Dialogue: 0,0:11:04.41,0:11:06.58,Default,Spikyulka1,0,0,0,,ولكن لدينا القليل من الوقت قبل البداية،
Dialogue: 0,0:11:06.58,0:11:09.08,Default,Spikyulka1,0,0,0,,حتى تتمكن من الراحة الآن.
Dialogue: 0,0:11:09.08,0:11:11.11,Default,Spilik1,0,0,0,,أنا متأكد من أنك متعب بعد الصيد.
Dialogue: 0,0:11:11.48,0:11:13.72,Default,Silk1,0,0,0,,-نعم، الملكة الأم.\N-نعم، الملكة الأم.
Dialogue: 0,0:11:21.46,0:11:22.76,Default,Spilik1,0,0,0,,مؤلمة جداً؟
Dialogue: 0,0:11:23.06,0:11:25.13,Default,Spilik1,0,0,0,,ما هذا؟
Dialogue: 0,0:11:26.13,0:11:28.60,Default,Silk1,0,0,0,,الآن أفهم سبب خوف كيم الخصي.
Dialogue: 0,0:11:29.16,0:11:31.17,Default,Spilik1,0,0,0,,صاحب الجلالة، عليك العودة إلى قاعة دايجوجون
Dialogue: 0,0:11:31.17,0:11:33.17,Default,Silk1,0,0,0,,وارتدي ملابس مناسبة للعيد.
Dialogue: 0,0:11:33.17,0:11:35.24,Default,Spilyk1,0,0,0,,بالضبط. وسوف آخذ قسطا من الراحة أثناء وجودي هناك.
Dialogue: 0,0:11:35.24,0:11:38.27,Default,Spikyulka1,0,0,0,,-بالطبع.\N-لا يزال الجزء الخلفي من رأسي يؤلمني.
Dialogue: 0,0:11:38.27,0:11:39.38,Default,Spilik1,0,0,0,,هذا حظ سيء.
Dialogue: 0,0:11:46.98,0:11:49.22,Default,Spilyk1,0,0,0,,دعونا نسرع. هناك القليل من الوقت قبل العيد.
Dialogue: 0,0:11:58.89,0:12:00.76,Default,Spilik1,0,0,0,,لماذا فعلت ذلك؟
Dialogue: 0,0:12:01.90,0:12:04.60,Default,Spikyulka1,0,0,0,,أنا متأكد من أن هناك من يحاول دفعنا.
Dialogue: 0,0:12:05.33,0:12:06.40,Default,Spilik1,0,0,0,,من؟
Dialogue: 0,0:12:07.55,0:12:09.84,Default,Spikyulka1,0,0,0,,من كان يعلم أن الوضع مع البئر سيفسد العلاقة.
Dialogue: 0,0:12:10.77,0:12:14.68,Default,Spilik1,0,0,0,,هناك دائماً ثلاث مشاكل في القصر.
Dialogue: 0,0:12:15.41,0:12:16.91,Default,Spilik1,0,0,0,,عداوة المرأة الخفية,
Dialogue: 0,0:12:17.41,0:12:20.22,Default,Spilyk1,0,0,0,,صراع على السلطة بين المحكمة و
Dialogue: 0,0:12:21.95,0:12:22.99,Default,Spilik1,0,0,0,,الموت بالسم.
Dialogue: 0,0:12:26.29,0:12:28.79,Default,Spikyulka1,0,0,0,,لهذا السبب تستمر في ذكر السم؟
Dialogue: 0,0:12:28.89,0:12:30.96,Default,Spilik1,0,0,0,,عشت في قصر لعقود من الزمن
Dialogue: 0,0:12:31.26,0:12:34.23,Default,Spikyulka1,0,0,0,,ورأيت الكثير ممن ماتوا بسبب سموم مختلفة.
Dialogue: 0,0:12:35.86,0:12:38.40,Default,Spill1,0,0,0,,السم القاتل يقتل بقطرة واحدة.
Dialogue: 0,0:12:38.83,0:12:40.10,Default,Spilyk1,0,0,0,,السموم المخفية
Dialogue: 0,0:12:40.10,0:12:42.14,Default,Spilik1,0,0,0,,اقتل ببطء تحت ستار المرض.
Dialogue: 0,0:12:42.67,0:12:44.57,Default,Spikyulka1,0,0,0,,وبالرغم من عدم العثور عليهما،
Dialogue: 0,0:12:45.04,0:12:47.74,Default,Spikyulka1,0,0,0,,لكنني متأكد من وجود العديد من الوفيات
Dialogue: 0,0:12:47.74,0:12:49.48,Default,Spilyk1,0,0,0,,كانت بسبب السم.
Dialogue: 0,0:12:50.21,0:12:53.55,Default,Biryulka1,0,0,0,,نعم القصر مكان خطير جداً.
Dialogue: 0,0:12:56.15,0:12:58.82,Default,Silk1,0,0,0,,إذا فكرت في الأمر، ذلك الشخص الذي يشبه خان...
Dialogue: 0,0:13:03.06,0:13:04.26,Default,Spilik1,0,0,0,,ها هو. ذلك الرجل.
Dialogue: 0,0:13:04.39,0:13:05.43,Default,Spilyk1,0,0,0,,إخفاء.
Dialogue: 0,0:13:07.00,0:13:09.90,Default,Spilik1,0,0,0,,ثم استدارت...
Dialogue: 0,0:13:10.07,0:13:12.90,Default,Spilik1,0,0,0,,هل رأت وجهي؟ لا تفكر.
Dialogue: 0,0:13:12.90,0:13:14.34,Default,Spilik1,0,0,0,,لهذا السبب هربت.
Dialogue: 0,0:13:14.67,0:13:16.27,Default,Spikyulka1,0,0,0,,-هل أنت متأكد؟\N-نعم.
Dialogue: 0,0:13:16.27,0:13:18.67,Default,Spilyk1,0,0,0,,مسكتك.
Dialogue: 0,0:13:24.81,0:13:25.81,Default,Spillit1,0,0,0,,سيدة البلاط تشوي.
Dialogue: 0,0:13:26.02,0:13:27.95,Default,Spikyulka1,0,0,0,,اذهب واكتشف من هو الشخص الذي
Dialogue: 0,0:13:27.95,0:13:28.98,Default,Spikyulka1,0,0,0,,تحدثت للتو هنا.
Dialogue: 0,0:13:30.29,0:13:32.25,Default,Spilik1,0,0,0,,أراهن بكرات التنين الضائعة،
Dialogue: 0,0:13:32.25,0:13:34.56,Default,Spikyulka1,0,0,0,,أن اسمه الأخير هو خان.
Dialogue: 0,0:13:35.32,0:13:37.79,Default,Spilik1,0,0,0,,ستبدأ الوليمة قريباً.
Dialogue: 0,0:13:37.83,0:13:39.13,Default,Spikyulka1,0,0,0,,لن يبدأ,
Dialogue: 0,0:13:39.13,0:13:40.80,Default,Spilyk1,0,0,0,,بينما يتطفل هذا الرجل هنا.
Dialogue: 0,0:13:41.16,0:13:42.23,Default,Spilik1,0,0,0,,ماذا؟
Dialogue: 0,0:13:43.53,0:13:45.03,Default,Silk1,0,0,0,,ثم ماذا عن الطباخ الملكي؟
Dialogue: 0,0:13:45.73,0:13:46.77,Default,Spilik1,0,0,0,,يا له من وغد.
Dialogue: 0,0:13:49.94,0:13:53.41,Default,Spilik1,0,0,0,,لماذا يبدو كل شيء مثل ما مررت به؟
Dialogue: 0,0:13:54.88,0:13:57.28,Default,Spilik1,0,0,0,,وليس لدى تشيولجونغ أي فكرة عما يحدث هنا.
Dialogue: 0,0:14:00.65,0:14:03.29,Default,Spilik1,0,0,0,,لكي لا تندم على أي شيء، يجب أن يعيش الناس وفقًا لوضعهم.
Dialogue: 0,0:14:03.59,0:14:05.85,Default,Spilik1,0,0,0,,لكنني سأكون على طبيعتي ولن أزعج نفسي.
Dialogue: 0,0:14:09.16,0:14:11.73,Default,Spilligu1,0,0,0,,أنا متأكد من أنه خلط شيئًا ما في الماء.
Dialogue: 0,0:14:13.60,0:14:14.90,Default,Spillie1,0,0,0,,السم؟
Dialogue: 0,0:14:17.20,0:14:18.97,Default,Spilik1,0,0,0,,هيا!
Dialogue: 0,0:14:19.20,0:14:20.97,Default,Spikyulka1,0,0,0,,حتى لو كان القصر مكاناً قاسياً،
Dialogue: 0,0:14:20.97,0:14:23.61,Default,Spikyulka1,0,0,0,,لماذا يفسد العيد بالتسمم الجماعي؟
Dialogue: 0,0:14:24.21,0:14:25.27,Default,Spilik1,0,0,0,,بالتأكيد لا.
Dialogue: 0,0:14:28.11,0:14:30.78,Default,Spilik1,0,0,0,,القلق والخوف معديان.
Dialogue: 0,0:14:30.78,0:14:32.28,Default,Spilik1,0,0,0,,يا إلهي.
Dialogue: 0,0:14:32.55,0:14:33.68,Default,Spilik1,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:14:34.15,0:14:36.49,Default,Spilyk1,0,0,0,,إلى مسرح الجريمة للحصول على الأدلة.
Dialogue: 0,0:14:36.59,0:14:38.12,Default,Spilik1,0,0,0,,حسناً، سوف تأتي إلى دايجوجون.
Dialogue: 0,0:14:38.15,0:14:40.92,Default,Spikyulka1,0,0,0,,يتسابق عقلي ذهابًا وإيابًا، ويضيع إحساسي بالاتجاه.
Dialogue: 0,0:14:42.02,0:14:43.59,Default,Spilik1,0,0,0,,انتظرني يا صاحب الجلالة!
Dialogue: 0,0:15:07.55,0:15:09.55,Default,إنه 2,0,0,0 منك،,يبدو أن رائحته تشبه نوعاً ما من العشب.
Dialogue: 0,0:15:10.65,0:15:12.25,Default,إنها 2,0,0,0,,ماذا أضاف؟
Dialogue: 0,0:15:12.96,0:15:14.12,Default، إنه 2,0,0,0 منك،،وانسى أن تفكر!
Dialogue: 0,0:15:14.79,0:15:15.89,Default، إنه 2,0,0,0 منك،،هل تعتقد ذلك؟
Dialogue: 0,0:15:17.29,0:15:18.73,Default، إنه 2,0,0,0 منك،،لقد فشلنا جميعاً.
Dialogue: 0,0:15:19.80,0:15:20.93,Default,إنه 2,0,0,0,,سيدي!
Dialogue: 0,0:15:23.33,0:15:26.07,Default، أنت 2,0,0,0,,لقد فعلت كل ما بوسعي،
Dialogue: 0,0:15:26.07,0:15:28.40,Default,هناك 2,0,0,0 منكم،,لكن الوليمة ستبدأ قريباً، وما زال لا يوجد طعام.
Dialogue: 0,0:15:29.04,0:15:30.97,Default، إنه أنت 2,0,0,0,,عاجلاً أم آجلاً، سيتم إحضارهم.
Dialogue: 0,0:15:34.08,0:15:35.78,Default, هناك اثنان منكما,0,0,0,,ثق بي ولا تستسلم.
Dialogue: 0,0:15:37.51,0:15:40.15,Default، إنه 2,0,0,0 منك،،سأحاول التوصل إلى شيء ما.
Dialogue: 0,0:15:54.16,0:15:55.50,Default,هناك اثنان منكم,0,0,0,,استسلموا بالفعل.
Dialogue: 0,0:15:57.17,0:15:58.87,Default، إنه 2,0,0,0 منك،،استسلم وستشعر بالتحسن.
Dialogue: 0,0:15:59.60,0:16:00.60,Default، أنت 2,0,0,0,,الملكة.
Dialogue: 0,0:16:01.07,0:16:03.71,Default، إنه 2,0,0,0 منك،،أنت تفهم أن كل شيء محكوم عليه بالفناء.
Dialogue: 0,0:16:03.71,0:16:05.81,Default، إنه 2,0,0,0 منك،،بغض النظر عن مدى صعوبة محاولتك،
Dialogue: 0,0:16:05.81,0:16:08.14,Default، إنه 2,0,0,0 منكم،،كل شيء سينتهي بالألم.\Nخاصتك وأحبائك.
Dialogue: 0,0:16:10.51,0:16:13.52,Default، إنه 2,0,0,0 منك،،وماذا في ذلك؟ ينبغي أن لا يهمني everything\Nand تصبح دمية مطيعة؟
Dialogue: 0,0:16:16.99,0:16:18.55,Default,هناك اثنان منكم,0,0,0,,لا أستطيع العيش هكذا.
Dialogue: 0,0:16:19.79,0:16:22.93,Default، أنت 2,0,0,0,,سأبذل قصارى جهدي حتى آخر لحظة.
Dialogue: 0,0:16:23.86,0:16:26.06,Default، إنه 2,0,0,0 منك،،إذا كنت ضد ذلك،
Dialogue: 0,0:16:27.66,0:16:28.96,Default، هناك اثنان منكما،0,0,0,,انساني.
Dialogue: 0,0:16:31.43,0:16:34.24,Default، إنه 2,0,0,0 منك،،بالضبط! نحن نحافظ على مسافة لدينا.
Dialogue: 0,0:16:34.70,0:16:36.00,Default، إنه 2,0,0,0 منك،،حسناً، كل شيء واضح.
Dialogue: 0,0:16:43.28,0:16:46.45,Default,أنت 2,0,0,0,,جلالتك،\Nلماذا تختلف أقوالك وأفعالك؟
Dialogue: 0,0:16:47.12,0:16:48.28,Default، إنها 2,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:16:48.65,0:16:51.65,Default,إنه 2,0,0,0 منك،,حتى لو كنت أتحدث هراء،\Nهذا من أعماق قلبي.
Dialogue: 0,0:16:51.75,0:16:53.62,Default, إنه 2,0,0,0 منك،،لم أكذب على أحد قط في حياتي.
Dialogue: 0,0:16:53.99,0:16:55.82,Default, هناك اثنان منكما,0,0,0,,أنت قلقة على الملك.
Dialogue: 0,0:16:55.89,0:16:58.26,Default,أنت 2,0,0,0,,أخشى أن يتأذى إذا لم يتوقف.
Dialogue: 0,0:16:59.16,0:17:00.40,Default، إنها 2,0,0,0,,لماذا؟
Dialogue: 0,0:17:00.80,0:17:03.60,Default,إنه 2,0,0,0 منك،،اقلق بشأن الملك والمشاهير -
Dialogue: 0,0:17:03.60,0:17:04.77,Default، إنه 2,0,0,0 منك،،لا يمكنك أن تتخيل أي شيء أسوأ!
Dialogue: 0,0:17:06.87,0:17:09.44,Default,إنها 2,0,0,0 منك،,سابقاً، في كل مرة\Nكنت تقول فيها شيئاً سخيفاً،
Dialogue: 0,0:17:09.44,0:17:11.27,Default,إنها 2,0,0,0,,لم يكن هذا ما كنت تعتقده حقًا.
Dialogue: 0,0:17:37.60,0:17:39.33,Default، إنه 2,0,0,0 منك،،عرفت ذلك، هناك سم في الماء.
Dialogue: 0,0:17:41.17,0:17:43.17,Default، إنها 2,0,0,0,,أنت! أين الشيف الملكي؟
Dialogue: 0,0:17:44.37,0:17:47.08,Default،إنها 2,0,0,0,,لقد كنت هنا للتو.
Dialogue: 0,0:17:48.18,0:17:49.24,Default، إنه 2,0,0,0 منك،،لا!
Dialogue: 0,0:17:52.68,0:17:54.08,Default، هذا أنت 2,0,0,0,,هل هربت أيها الوغد؟
Dialogue: 0,0:17:54.38,0:17:56.08,Default، إنه 2,0,0,0 منك،،تصرفت كمحترف حقيقي،
Dialogue: 0,0:17:56.08,0:17:57.35,Default، إنه 2,0,0,0 منك،،والآن هرب؟
Dialogue: 0,0:17:57.49,0:17:59.22,Default, هناك اثنان منكم,0,0,0,,ولكن ماذا سيحدث للعيد؟
Dialogue: 0,0:17:59.99,0:18:02.06,Default,إنها 2,0,0,0,,لقد بذل الملك الكثير من الجهد في ذلك.
Dialogue: 0,0:18:02.12,0:18:04.43,Default,هناك اثنان منكم,0,0,0,,لا طعام ولا طهاة أيضاً.
Dialogue: 0,0:18:05.69,0:18:06.90,Default,لقد انتهى الأمر 2,0,0,0,,لقد انتهى الأمر.
Dialogue: 0,0:18:08.70,0:18:11.77,Default، إنه 2,0,0,0 منك،،وماذا في ذلك؟ ينبغي أن لا يهمني everything\Nand تصبح دمية مطيعة؟
Dialogue: 0,0:18:12.13,0:18:13.60,Default, هناك اثنان منكم,0,0,0,,لا أستطيع العيش هكذا.
Dialogue: 0,0:18:14.90,0:18:18.14,Default، أنت 2,0,0,0,,سأبذل قصارى جهدي حتى آخر لحظة.
Dialogue: 0,0:18:19.71,0:18:21.41,Default, هناك اثنان منكما,0,0,0,,واو!
Dialogue: 0,0:18:23.05,0:18:25.38,Default، هناك اثنان منكما،0,0,0,,هونغ يونغ، افعل شيئاً من أجلي.
Dialogue: 0,0:18:28.62,0:18:30.09,Default,إنها 2,0,0,0,,شكرًا على خدمتك.
Dialogue: 0,0:18:31.49,0:18:32.92,Default، أنت 2,0,0,0,,خان سيمون
Dialogue: 0,0:18:35.69,0:18:37.33,Default، إنها 2,0,0,0,,شكراً لك مرة أخرى.
Dialogue: 0,0:18:42.73,0:18:44.80,Default، إنه أنت 2,0,0,0,,ما اسم الرجل الذي خرج للتو؟
Dialogue: 0,0:18:45.13,0:18:46.44,Default, هناك اثنان منكم,0,0,0,,لماذا تحتاج هذا؟
Dialogue: 0,0:18:47.14,0:18:48.64,Default, هناك اثنان منكم,0,0,0,,لدي أسبابي الخاصة.
Dialogue: 0,0:18:48.74,0:18:50.21,افتراضي، هناك اثنان منكم،0,0,0,,لا أستطيع أن أخبرك.
Dialogue: 0,0:18:54.24,0:18:55.54,Default,إنه 2,0,0,0,,رعب.
Dialogue: 0,0:18:55.78,0:18:59.08,Default, هناك اثنان منكما,0,0,0,,إذا تركت الملكة وحدها في الوليمة،
Dialogue: 0,0:18:59.65,0:19:01.92,Default، إنها 2,0,0,0 منك،،من يدري ماذا ستفعل؟
Dialogue: 0,0:19:03.55,0:19:05.85,Default,إنها 2,0,0,0,,مرحباً!\Nلم أراك منذ وقت طويل!
Dialogue: 0,0:19:05.85,0:19:07.62,Default, هناك اثنان منكم,0,0,0,,أصبت بالبرد هنا،
Dialogue: 0,0:19:08.49,0:19:10.76,Default,إنها 2,0,0,0,,أقرضتك! شكرًا لك.
Dialogue: 0,0:19:31.35,0:19:33.82,Default,إنها 2,0,0,0,,الشكل! أرز! هذا هو الأرز!
Dialogue: 0,0:19:33.82,0:19:37.42,Default، أنت 2,0,0,0,,-رايس!\N-رايس! انظر يا أرز!
Dialogue: 0,0:19:37.42,0:19:38.62,Default، إنها 2,0,0,0,,-أسرع!\N-رايس!
Dialogue: 0,0:19:39.35,0:19:40.62,Default، إنه أنت 2,0,0,0,,-رايس!\N-أمسك بك!
Dialogue: 0,0:19:41.96,0:19:44.09,Default، إنه أنت 2,0,0,0,,-اجمع!\N-أسرع!
Dialogue: 0,0:19:44.29,0:19:45.93,Default,إنها 2,0,0,0,,-أسرع!\N-اجمعها!
Dialogue: 0,0:19:47.06,0:19:48.26,Default، إنها 2,0,0,0,,-ما هذا؟\N-ماذا؟
Dialogue: 0,0:19:50.00,0:19:51.27,Default,إنها 2,0,0,0,,الشكل!
Dialogue: 0,0:20:13.96,0:20:17.16,Default، إنه أنت 2,0,0,0,,هذا زبوني من القصر!
Dialogue: 0,0:20:19.36,0:20:22.90,Default،إنها 2,0,0,0,,لقد حدث أن الكثير من الأشياء المثيرة للاهتمام وصلت اليوم.
Dialogue: 0,0:20:30.21,0:20:31.64,Default، هناك اثنان منكم،0,0,0,,ليس لدي وقت.
Dialogue: 0,0:20:32.31,0:20:33.78,Default، إنها 2,0,0,0,,لقد ارتكبت خطأً.
Dialogue: 0,0:20:34.98,0:20:36.01,Default, هناك اثنان منكم,0,0,0,,ماذا؟
Dialogue: 0,0:20:36.91,0:20:37.98,افتراضي، هناك اثنان منكم،0,0,0,,لم أرتكب أي خطأ.
Dialogue: 0,0:20:58.30,0:21:00.67,Default، إنه 2,0,0,0 منك،،لماذا يوجد الكثير من الإغراءات اليوم؟
Dialogue: 0,0:21:02.50,0:21:05.24,Default,أنت 2,0,0,0,,انس الأمر،\Nأنت سيدة البلاط، تحكمي بنفسك.
Dialogue: 0,0:21:21.72,0:21:25.29,Default,هناك اثنان منكما,0,0,0,,سيدة المحكمة،\Nهل تريدين أن تخبريني شيئاً؟
Dialogue: 0,0:21:54.32,0:21:55.92,Default، إنه أنت 2,0,0,0,,لقد كنت مختبئاً طوال هذا الوقت
Dialogue: 0,0:21:55.92,0:21:58.13,Default,أعطتك 2,0,0,0,,قدراتها الخاصة ولم تفعل شيئاً مفيداً.
Dialogue: 0,0:21:58.53,0:22:01.16,Default,إنها 2,0,0,0,,لابد أنه من الصعب الجلوس ساكناً.
Dialogue: 0,0:22:01.70,0:22:03.97,Default,إنها 2,0,0,0,,لقد اعتدت على ذلك بالفعل. ليس من الصعب بالنسبة لي.
Dialogue: 0,0:22:05.80,0:22:06.87,Default، إنها 2,0,0,0,,هكذا هي الحال.
Dialogue: 0,0:22:40.30,0:22:42.10,Default، إنها 2,0,0,0,,انتظر. الآن كل شيء كما ينبغي أن يكون.
Dialogue: 0,0:22:44.34,0:22:48.68,Default، إنه 2,0,0,0 منك،,هل أنت متأكد أنه ليس أنت في الصور؟
Dialogue: 0,0:22:48.68,0:22:51.25,Default, هناك اثنان منكما,0,0,0,,لقد أخبرتك بالفعل! هذا ليس أنا!
Dialogue: 0,0:22:51.51,0:22:54.18,Default، إنه 2,0,0,0 منك،،لن أكذب، الأمر واضح للوهلة الأولى،
Dialogue: 0,0:22:54.18,0:22:58.45,Default، إنها 2,0,0,0,,جسد هذا الرجل ملكي تماماً.
Dialogue: 0,0:22:58.89,0:23:00.66,Default، إنه 2,0,0,0 منك،،لكن، أنا آسف، هذا ليس أنا.
Dialogue: 0,0:23:01.79,0:23:04.33,Default,إنه 2,0,0,0 منك،،إنه لشرف لي أن يكون اسم رجل مماثل،
Dialogue: 0,0:23:04.33,0:23:05.53,افتراضي،إنه 2,0,0,0,,منقوش على المشكال.
Dialogue: 0,0:23:05.69,0:23:08.33,Default, إنه 2,0,0,0 منك،،قل نفس الشيء! بالمناسبة،
Dialogue: 0,0:23:09.16,0:23:13.40,Default,هل أنت 2,0,0,0,، في هذه الأيام مثل هذه الأشياء مطلوبة بين الخدم؟
Dialogue: 0,0:23:14.40,0:23:17.01,Default, يؤلمك 2,0,0,0,,تعجز الكلمات عن وصف مدى الألم
Dialogue: 0,0:23:17.01,0:23:19.84,Default، أنت 2,0,0,0,,سيدات البلاط يحببن هذا النوع من الأشياء.
Dialogue: 0,0:23:20.34,0:23:23.91,Default، إنه أنت 2,0,0,0,,أربكتني. لم أكن أعتقد أنني كنت وسيمًا جدًا.
Dialogue: 0,0:23:25.41,0:23:26.55,Default، هناك اثنان منكما،0,0,0,,واو.
Dialogue: 0,0:23:27.22,0:23:29.05,Default، هناك اثنان منك،0,0,0,,إذاً أنت السيد سيمون
Dialogue: 0,0:23:29.99,0:23:33.89,Default، أنت 2,0,0,0,,من عشيرة خان، واسمك الكامل
Dialogue: 0,0:23:33.89,0:23:36.86,Default,إنه 2,0,0,0,,يبدو مثل خان سيمون.
Dialogue: 0,0:23:41.08,0:23:42.16,افتراضي، إنه 2,0,0,0,,
Dialogue: 0,0:23:42.92,0:23:44.12,Default، إنه 2,0,0,0 منك،،لا تنسى،
Dialogue: 0,0:23:44.96,0:23:47.29,Default، إنه 2,0,0,0 منك،،في منتصف الوليمة،
Dialogue: 0,0:23:47.62,0:23:50.39,Default,سوف يكون 2,0,0,0 منك،،عندما يكون الملك أقوى،
Dialogue: 0,0:23:51.17,0:23:53.86,Default،إنها 2,0,0,0,,حان الوقت لجعل هذا للعامة.
Dialogue: 0,0:23:54.13,0:23:57.53,الافتراضي، إنه 2,0,0,0,,
Dialogue: 0,0:24:16.08,0:24:17.38,Default،إنها 2,0,0,0,,يا فتاة، استمعي.
Dialogue: 0,0:24:21.00,0:24:22.66,Default، إنه 2,0,0,0 منك،،اصنع لي معروفاً.
Dialogue: 0,0:24:23.56,0:24:26.20,Default،إنها 2,0,0,0,,هل يمكنك تمرير ملاحظة إلى شخص ما؟
Dialogue: 0,0:24:28.67,0:24:29.67,Default، إنها 2,0,0,0,,لمن؟
Dialogue: 0,0:24:35.01,0:24:36.13,Default، إنه أنت 2,0,0,0,,ذلك الشخص.
Dialogue: 0,0:24:39.87,0:24:41.25,Default، إنها 2,0,0,0,,حسنًا! مفهوم.
Dialogue: 0,0:24:47.58,0:24:48.66,Default، إنه 2,0,0,0 منك،،سيد.
Dialogue: 0,0:24:49.76,0:24:53.76,Default,إنها 2,0,0,0,,طلب هذا الرجل الشاب\Nأن يعطيك هذه.
Dialogue: 0,0:25:02.67,0:25:05.06,Default,أنت 2,0,0,0,,يجب أن أقول شيئاً،\N أضع شرف العشيرة على المحك.
Dialogue: 0,0:25:05.36,0:25:06.78,Default، إنها 2,0,0,0 لك،،سأنتظر في الجناح.
Dialogue: 0,0:25:12.91,0:25:14.04,افتراضي، إنه 2,0,0,0 منك،،لا أصدق ذلك.
Dialogue: 0,0:25:15.48,0:25:17.02,Default، إنه أنت 2,0,0,0,,هل لاحظ شيئاً؟
Dialogue: 0,0:25:32.23,0:25:33.32,Default، إنها 2,0,0,0,,لقد أتيت.
Dialogue: 0,0:25:35.29,0:25:36.63,Default، إنه 2,0,0,0 منك،،يجب أن أعترف لك.
Dialogue: 0,0:25:37.30,0:25:39.27,Default,إنه 2,0,0,0,,أعلم أنه كان من الوقاحة أن أتصل بك بهذه الطريقة،
Dialogue: 0,0:25:42.33,0:25:46.14,Default، هناك اثنان منكما،0,0,0,,لكن عائلتي عزيزة عليّ مثل الحياة.
Dialogue: 0,0:25:46.98,0:25:47.98,افتراضي، هناك اثنان منكما,0,0,0,,ومع ذلك،
Dialogue: 0,0:25:50.38,0:25:54.19,Default، إنه 2,0,0,0 منك، بعد قضاء ليالي لا حصر لها في التفكير،\NI اتخذت قراري.
Dialogue: 0,0:25:55.58,0:25:57.96,Default, هناك اثنان منكم,0,0,0,,قررت أن أختار ما هو أكثر أهمية من عائلتي.
Dialogue: 0,0:25:59.28,0:26:00.82,Default، أنت 2,0,0,0,,إذا كانت العائلة ضدها،
Dialogue: 0,0:26:02.29,0:26:03.47,افتراضي، هناك اثنان منكم،0,0,0,,ثم أنا
Dialogue: 0,0:26:05.09,0:26:06.36,Default، أنت 2,0,0,0,,سوف أرفضهم.
Dialogue: 0,0:26:07.24,0:26:10.33,Default, هناك اثنان منكما,0,0,0,,أريد أن أكون في عينيك فقط من الآن فصاعداً.
Dialogue: 0,0:26:17.21,0:26:21.78,Default,هناك اثنان منكم,0,0,0,,هل تمزح معي أم ماذا؟\NI لدي ما يكفي لأفعله بدونك!
Dialogue: 0,0:26:27.49,0:26:28.72,Default,إنها 2,0,0,0,,الفتاة حيرتك!
Dialogue: 0,0:26:40.86,0:26:42.39,Default، إنه 2,0,0,0 منك،،ماذا فعلت؟
Dialogue: 0,0:26:48.18,0:26:50.91,Default، إنه 2,0,0,0 منك،،-بطني، بطني.\N-إنه يؤلمني بشدة!
Dialogue: 0,0:26:54.18,0:26:57.34,Default، إنه أنت 2,0,0,0,,-أخرج لسانك.\N-سأموت الآن.
Dialogue: 0,0:26:58.38,0:27:00.11,Default، إنه 2,0,0,0 منك،،أقوى.
Dialogue: 0,0:27:01.85,0:27:02.92,Default، إنه 2,0,0,0 منك،،بطني، بطني.
Dialogue: 0,0:27:02.92,0:27:05.35,Default، أنت 2,0,0,0,,لقد تسممتم جميعاً ببعض الأعشاب.
Dialogue: 0,0:27:10.09,0:27:11.36,Default، إنه 2,0,0,0 منك،،-هذا يؤلمني كثيراً!\N-كيف يمكن أن يكون هذا؟
Dialogue: 0,0:27:13.36,0:27:17.44,Default,إنها 2,0,0,0,,أعتقد أن أحدهم أضاف\Nground أعشاب الطيور.
Dialogue: 0,0:27:17.44,0:27:18.51,Default، إنها 2,0,0,0,,يا رفاق!
Dialogue: 0,0:27:19.24,0:27:21.21,Default، إنه 2,0,0,0 منك،،-ماذا؟\N-أنا أموت!
Dialogue: 0,0:27:21.21,0:27:22.21,Default,إنها 2,0,0,0,,ما هذا؟
Dialogue: 0,0:27:24.34,0:27:25.75,Default, هناك اثنان منكم,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:27:25.75,0:27:28.04,Default، أنت 2,0,0,0,,أرسلت الملكة في طلبي.
Dialogue: 0,0:27:28.64,0:27:31.19,Default، إنها 2,0,0,0,,أمرتني باختبار الماء.
Dialogue: 0,0:27:31.34,0:27:34.05,Default، أنت 2,0,0,0,,أضاف شخص ما أعشاباً إلى الماء،\Nمسبباً آلاماً في البطن.
Dialogue: 0,0:27:35.92,0:27:38.78,Default، إنها 2,0,0,0,,اللعنة! وهناك مشاكل مع الماء.
Dialogue: 0,0:27:40.35,0:27:42.43,Default، إنه 2,0,0,0 منك،،لماذا لا تركب وبطنك؟
Dialogue: 0,0:27:42.43,0:27:44.59,Default، هناك اثنان منكم،0,0,0,,كما ترون،\NI أنا شخص عصبي جداً.
Dialogue: 0,0:27:44.59,0:27:46.67,Default، إنه 2,0,0,0 منك،،وعندما أشعر بالقلق، لا آخذ قطرة في فمي.
Dialogue: 0,0:27:46.67,0:27:48.86,Default, إنه 2,0,0,0 منك،،واضح منك أنك واحد من أولئك الذين، حتى في الملعب،
Dialogue: 0,0:27:48.86,0:27:51.27,Default، هناك 2,0,0,0 منكم،,حيث تدور المعركة، نم كرجل ميت.
Dialogue: 0,0:27:51.27,0:27:53.80,Default,هناك اثنان منكما,0,0,0,,انظر إليه، إنه يسمي نفسه طبيباً، وهو نفسه ليس من الازدهار بين الناس.
Dialogue: 0,0:27:53.80,0:27:55.80,Default،إنه 2,0,0,0 منك،،أنا معالج، ولست عالم ملامح.
Dialogue: 0,0:27:56.87,0:28:00.14,Default، هناك اثنان منكما،0,0,0,,أنا بالطبع معالج ذو خبرة،
Dialogue: 0,0:28:00.61,0:28:04.22,Default, هناك اثنان منكم,0,0,0,,ولكن حتى أنا لن أتمكن من الوقوف على أقدامهما حتى الغد.
Dialogue: 0,0:28:04.34,0:28:08.35,Default, هناك اثنان منكم,0,0,0,,حتى لو أحضروا الطعام،\Nفمع أخوة الأيتام والبائسين هذه...
Dialogue: 0,0:28:09.22,0:28:10.88,Default، إنها 2,0,0,0,,من فعل هذا بحق الجحيم؟
Dialogue: 0,0:28:17.89,0:28:19.29,Default,Kus3,0,0,0,,لم أره من قبل.
Dialogue: 0,0:28:22.83,0:28:24.51,Default,Kus3,0,0,0,,هل أضفت السم؟
Dialogue: 0,0:28:34.28,0:28:37.28,Default,Kus3,0,0,0,,أرسلني جلالته، طاهٍ ضيف،
Dialogue: 0,0:28:37.28,0:28:38.61,Default,Kus3,0,0,0,,لتحضير الوليمة.
Dialogue: 0,0:28:40.81,0:28:42.35,Default,Kus3,0,0,0,,اسمي لي سينمان.
Dialogue: 0,0:28:43.05,0:28:45.46,Default,Kus3,0,0,0,,لقد جئت لمساعدتك.
Dialogue: 0,0:28:45.78,0:28:46.82,Default,Kus3,0,0,0,,قبض.
Dialogue: 0,0:28:50.53,0:28:52.23,Default,Kus3,0,0,0,,لا داعي للتفكير، هذه هي الملكة.
Dialogue: 0,0:28:52.97,0:28:54.06,Default,Kus3,0,0,0,,هل توافق؟
Dialogue: 0,0:28:54.36,0:28:56.50,Default,Kus3,0,0,0,,هراء! لماذا تسميه الملكة؟
Dialogue: 0,0:28:56.56,0:28:59.41,Default,Kus3,0,0,0,,اللعنة، ما خطب عينيك؟
Dialogue: 0,0:28:59.41,0:29:03.03,Default,Kus3,0,0,0,,الملكة مشغولة بالرقص. لماذا ستكون هنا؟
Dialogue: 0,0:29:03.18,0:29:04.87,Default,Kus3,0,0,0,,رسمياً,
Dialogue: 0,0:29:04.87,0:29:07.52,Default,Kus3,0,0,0,,إنها في الوليمة الآن، هل تعلم؟
Dialogue: 0,0:29:07.84,0:29:10.34,Default,Kus3,0,0,0,,الآن أصبح الأمر واضحًا.
Dialogue: 0,0:29:11.75,0:29:12.78,Default,Kus3,0,0,0,,الطماطم؟
Dialogue: 0,0:29:13.04,0:29:15.26,Default,Kus3,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:29:15.38,0:29:18.88,Default,Kus3,0,0,0,,هذه ثمرة البرسيمون تعيش سنة واحدة فقط.
Dialogue: 0,0:29:18.88,0:29:20.66,Default,Kus3,0,0,0,,من أي منطقة نائية أنت أيها الشقي؟
Dialogue: 0,0:29:20.66,0:29:22.62,Default,Kus3,0,0,0,,كيف لا يعرف الطباخ هذا؟
Dialogue: 0,0:29:23.00,0:29:25.73,Default,Kus3,0,0,0,,كيف تجرؤ على مناداتي بالشقي؟
Dialogue: 0,0:29:25.73,0:29:28.03,Default,Kus3,0,0,0,,كلانا طباخين. أسميها ما أريد.
Dialogue: 0,0:29:28.20,0:29:30.03,Default,Kus3,0,0,0,,-حقاً؟\N-بالطبع أيها الشقي!
Dialogue: 0,0:29:30.03,0:29:32.13,Default,Kus3,0,0,0,,هذا في غير محله.
Dialogue: 0,0:29:32.13,0:29:34.03,Default,Kus3,0,0,0,,لقد تركت المطبخ وهربت.
Dialogue: 0,0:29:34.03,0:29:35.10,Default,Kus3,0,0,0,,أي نوع من الطهاة أنت؟
Dialogue: 0,0:29:35.10,0:29:36.28,Default,Kus3,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:29:36.28,0:29:38.30,Default,Kus3,0,0,0,,ذهبت إلى "نانونبو" للبحث عن الطعام
Dialogue: 0,0:29:38.30,0:29:39.71,Default,Kus3,0,0,0,,لتخفيف آلام البطن.
Dialogue: 0,0:29:40.61,0:29:41.64,Default,Kus3,0,0,0,,نينونفو؟
Dialogue: 0,0:29:41.64,0:29:43.78,Default,Kus3,0,0,0,,نعم إلى المزرعة الملكية.
Dialogue: 0,0:29:43.78,0:29:44.95,Default,Kus3,0,0,0,,أنت لا تعرف شيئاً.
Dialogue: 0,0:29:48.46,0:29:49.92,Default,Kus3,0,0,0,,أرني ما أحضرته.
Dialogue: 0,0:29:55.09,0:29:58.70,Default,Kus3,0,0,0,,يبدأ تحضير الطبق باختيار\N المنتجات عالية الجودة.
Dialogue: 0,0:30:00.59,0:30:02.74,Default,Kus3,0,0,0,,وفي المزرعة الملكية
Dialogue: 0,0:30:02.74,0:30:04.74,Default,Kus3,0,0,0,,هل يربون الدجاج أيضاً؟
Dialogue: 0,0:30:05.91,0:30:08.48,Default,Kus3,0,0,0,,إذا أحضرت بعض البيض، يمكنني طهي شيء ما.
Dialogue: 0,0:30:23.02,0:30:25.05,Default,Kus3,0,0,0,,معدتك تقرقر بالفعل.
Dialogue: 0,0:30:25.05,0:30:27.32,Default,Kus3,0,0,0,,لم تأكل منذ الأمس لكي تنفصل اليوم.
Dialogue: 0,0:30:27.32,0:30:29.39,Default,Kus3,0,0,0,,بما أنك تفهم هذا،
Dialogue: 0,0:30:29.39,0:30:31.36,Default,Kus3,0,0,0,,مما يعني أنني لم أتناول أي شيء منذ الأمس.
Dialogue: 0,0:30:38.21,0:30:40.78,Default,Kus3,0,0,0,,الوليمة التي طلبت إقامتها،
Dialogue: 0,0:30:40.78,0:30:42.71,Default,Kus3,0,0,0,,سيبدأ قريباً.
Dialogue: 0,0:30:44.64,0:30:46.18,Default,Kus3,0,0,0,,إنني أتطلع إلى ذلك.
Dialogue: 0,0:31:11.41,0:31:13.67,Default,Kus3,0,0,0,,كل مأدبة في البيت الأزرق كانت تحت عنوان معين،
Dialogue: 0,0:31:14.48,0:31:17.21,Default,Kus3,0,0,0,,لأن هذه سياسة، وليست طعاماً فقط.
Dialogue: 0,0:31:19.30,0:31:20.87,Default,Kus3,0,0,0,,ماذا تطبخ؟
Dialogue: 0,0:31:22.11,0:31:23.92,Default,Kus3,0,0,0,,ما هو الغرض من هذه المأدبة؟
Dialogue: 0,0:31:27.96,0:31:28.99,Default,Kus3,0,0,0,,ما هذا؟
Dialogue: 0,0:31:29.35,0:31:31.35,Default,Kus3,0,0,0,,القائمة أعدها الملك بنفسه.
Dialogue: 0,0:31:31.35,0:31:33.96,Default,Kus3,0,0,0,,وهذه هي القائمة الكاملة للضيوف.
Dialogue: 0,0:31:36.39,0:31:38.79,Default,Kus3,0,0,0,,إذن كان الجميع يتحدثون عن القائمة "الناهضة" هذه؟
Dialogue: 0,0:31:42.20,0:31:44.36,Default,Kus3,0,0,0,,سأقوم بإنشاء قائمة جديدة من هذه المنتجات.
Dialogue: 0,0:32:00.42,0:32:01.61,Default,Kus3,0,0,0,,كيف سار الأمر؟
Dialogue: 0,0:32:02.52,0:32:03.69,Default,Kus3,0,0,0,,عذراً.
Dialogue: 0,0:32:04.69,0:32:07.70,Default,Kus3,0,0,0,,تحدثت مع اللصوص، لكنهم لم يكونوا هم الذين يبحثون عن الطعام.
Dialogue: 0,0:32:47.39,0:32:48.94,Default,Kus3,0,0,0,,أخيرًا، تبدأ الوليمة.
Dialogue: 0,0:33:01.92,0:33:03.48,Default,Kus3,0,0,0,,هذه وليمة ملكية.
Dialogue: 0,0:33:03.92,0:33:06.69,Default,Kus3,0,0,0,,هل سيتم تقديم طبق واحد فقط؟
Dialogue: 0,0:33:07.11,0:33:09.28,Default,Kus3,0,0,0,,لا يمكن تسمية هذه الوجبة الملكية.
Dialogue: 0,0:33:09.55,0:33:11.16,Default,Kus3,0,0,0,,لا يمكن أن يكون. هذا كل شيء؟
Dialogue: 0,0:33:11.28,0:33:13.46,Default,Kus3,0,0,0,,أنا متأكد من أنه سيكون هناك المزيد من الأطباق.
Dialogue: 0,0:33:13.46,0:33:16.82,Default,Kus3,0,0,0,,جلالتك، هل يمكنك التوضيح؟
Dialogue: 0,0:33:17.09,0:33:19.47,Default,Kus3,0,0,0,,يعاني الناس من الجوع كل عام.
Dialogue: 0,0:33:19.77,0:33:22.06,Default,Kus3,0,0,0,,حتى أن البعض يموت.
Dialogue: 0,0:33:23.03,0:33:25.27,Default,Kus3,0,0,0,,للتذكير بمعاناتهم،
Dialogue: 0,0:33:25.80,0:33:28.60,Default,Kus3,0,0,0,,لقد أعدوا لك وجبة متواضعة لعامة الناس.
Dialogue: 0,0:33:29.63,0:33:31.14,Default,Kus3,0,0,0,,مع كامل احترامي،
Dialogue: 0,0:33:31.14,0:33:33.84,Default,Kus3,0,0,0,,كلمة "متواضعة" لا تناسب هنا.
Dialogue: 0,0:33:34.11,0:33:36.84,Default,Kus3,0,0,0,,أردت إبلاغ المسؤولين،
Dialogue: 0,0:33:36.95,0:33:39.34,Default,Kus3,0,0,0,,ولكن لا يمكن تقديم هذا للنبلاء،
Dialogue: 0,0:33:39.34,0:33:41.35,Default,Kus3,0,0,0,,الذي جاء إلى العيد من بعيد.
Dialogue: 0,0:33:41.35,0:33:42.49,Default,Kus3,0,0,0,,أوافق.
Dialogue: 0,0:33:42.72,0:33:45.08,Default,Kus3,0,0,0,,قدم هذا الطبق للضيوف المدعوين
Dialogue: 0,0:33:45.62,0:33:47.19,Default,Kus3,0,0,0,,أشبه بالعقاب.
Dialogue: 0,0:33:48.03,0:33:51.47,Default,Kus3,0,0,0,,ربما كنت تتوقع طعاماً مختلفاً، لكني أتمنى ذلك
Dialogue: 0,0:33:52.73,0:33:54.33,Default,Kus3,0,0,0,,سوف تفهم ما أردت إظهاره.
Dialogue: 0,0:34:07.37,0:34:08.95,Default,Kus3,0,0,0,,قبل 30 دقيقة
Dialogue: 0,0:34:11.24,0:34:12.68,Default,Kus3,0,0,0,,دعونا نثقبه بإبرة كهذه.
Dialogue: 0,0:34:13.72,0:34:15.08,Default,Kus3,0,0,0,,ما نوع هذه الشخبطة؟
Dialogue: 0,0:34:15.62,0:34:17.79,Default,Kus3,0,0,0,,ارمي البطاطس. سأوضح لك كيفية القيام بذلك.
Dialogue: 0,0:34:49.01,0:34:51.35,Default,Kus3,0,0,0,,أخيرًا، أصبحت الإبرة في متناول اليد.
Dialogue: 0,0:34:54.39,0:34:56.10,Default,Kus3,0,0,0,,سخني الزيت.
Dialogue: 0,0:34:58.66,0:34:59.70,Default,Kus3,0,0,0,,النفط؟
Dialogue: 0,0:35:05.26,0:35:07.87,Default,Kus3,0,0,0,,كيف تجرؤ على قلي إبرتي؟
Dialogue: 0,0:35:07.97,0:35:10.01,Default,Kus3,0,0,0,,اهدأ. سأقوم بتعقيمها.
Dialogue: 0,0:35:10.41,0:35:11.74,Default,Kus3,0,0,0,,هل تعرف حتى ما يعنيه ذلك؟
Dialogue: 0,0:35:12.04,0:35:14.87,Default,Kus3,0,0,0,,قبل 50 عاماً أعطاني إياها معلمي.
Dialogue: 0,0:35:15.12,0:35:16.35,Default,Kus3,0,0,0,,اهدأ.
Dialogue: 0,0:35:16.35,0:35:18.99,Default,Kus3,0,0,0,,50 سنة؟ حسنا، هذا كل شيء، الموعد النهائي لها قد انتهى.
Dialogue: 0,0:35:19.31,0:35:20.81,Default,Kus3,0,0,0,,لا! أنا بحاجة لها!
Dialogue: 0,0:35:20.81,0:35:22.49,Default,Kus3,0,0,0,,سوف أنقلها إلى تلميذي!
Dialogue: 0,0:35:22.76,0:35:23.91,Default,Kus3,0,0,0,,لا تجرؤ على خذلانها!
Dialogue: 0,0:35:31.89,0:35:32.93,Default,Kus3,0,0,0,,هذا كل شيء.
Dialogue: 0,0:35:40.06,0:35:42.68,Default,Kus3,0,0,0,,تبدو جميلة ومتناغمة مع وجود إبرة في المنتصف.
Dialogue: 0,0:35:42.68,0:35:46.14,Default,Kus3,0,0,0,,بهذه الطريقة، حتى اللب سوف ينضج بسرعة.
Dialogue: 0,0:35:47.85,0:35:51.79,Default,Kus3,0,0,0,,كيف توصلت إلى هذه الفكرة الرائعة؟
Dialogue: 0,0:35:51.79,0:35:53.89,Default,Kus3,0,0,0,,السرعة مهمة في طهي طعام الشارع.
Dialogue: 0,0:35:54.06,0:35:56.12,Default,Kus3,0,0,0,,مثالي لمثل هذه الحالة العاجلة.
Dialogue: 0,0:35:57.01,0:35:58.03,Default,Kus3,0,0,0,,الشارع؟
Dialogue: 0,0:35:58.45,0:36:00.85,Default,Kus3,0,0,0,,تبدو وكأنها منطقة حرب.
Dialogue: 0,0:36:01.49,0:36:03.62,Default,Kus3,0,0,0,,لقد نجت من المعركة الشرسة.
Dialogue: 0,0:36:08.33,0:36:09.37,Default,Kus3,0,0,0,,انتظر.
Dialogue: 0,0:36:11.43,0:36:12.64,Default,Kus3,0,0,0,,قشر البطاطس.
Dialogue: 0,0:36:12.76,0:36:13.93,Default,Kus3,0,0,0,,أنا؟
Dialogue: 0,0:36:14.58,0:36:15.91,Default,Kus3,0,0,0,,من أيضاً؟
Dialogue: 0,0:36:19.64,0:36:20.97,Default,Kus3,0,0,0,,هل تحتاج إلى حلوى الأرز؟
Dialogue: 0,0:36:22.97,0:36:25.14,Default,Kus3,0,0,0,,لقد أُرسلت للتحقق من سير الأمور.
Dialogue: 0,0:36:44.06,0:36:45.47,Default,Kus3,0,0,0,,كن حذراً.
Dialogue: 0,0:36:47.41,0:36:49.83,Default,Kus3,0,0,0,,قطّع إلى شرائح رفيعة قدر الإمكان. حتى أرق.
Dialogue: 0,0:36:49.83,0:36:50.97,Default,Kus3,0,0,0,,هذا كل شيء.
Dialogue: 0,0:36:51.04,0:36:53.10,Default,Kus3,0,0,0,,الطرف أكثر وضوحًا. حتى أكثر وضوحا.
Dialogue: 0,0:36:53.14,0:36:54.72,Default,Kus3,0,0,0,,سوف نثقب بها البطاطس.
Dialogue: 0,0:36:54.97,0:36:56.68,Default,Kus3,0,0,0,,أحسنت.
Dialogue: 0,0:36:57.72,0:36:59.41,Default,Kus3,0,0,0,,-اللهب كبير جداً.\N-حسناً.
Dialogue: 0,0:37:00.81,0:37:02.99,Default,Kus3,0,0,0,,-وهنا عليك أن تكون أقوى.\N-حسناً.
Dialogue: 0,0:37:04.01,0:37:06.72,Default,Kus3,0,0,0,,ممتاز. تذكر كل شيء.
Dialogue: 0,0:37:07.60,0:37:10.45,Default,Kus3,0,0,0,,نحن لا نعدّ الطعام اليوم فقط.
Dialogue: 0,0:37:11.43,0:37:13.79,Default,Kus3,0,0,0,,هذا هو وجه الرئيس.
Dialogue: 0,0:37:20.41,0:37:24.54,Default,Kus3,0,0,0,,أي وجه جلالته.
Dialogue: 0,0:37:33.08,0:37:35.76,Default,Kus3,0,0,0,,هل هذا جيد يا صاحب الجلالة؟
Dialogue: 0,0:37:36.26,0:37:37.93,Default,Kus3,0,0,0,,هذا هو الطباخ.
Dialogue: 0,0:37:39.16,0:37:40.33,Default,Kus3,0,0,0,,دعونا نرى.
Dialogue: 0,0:37:42.43,0:37:44.56,Default,Kus3,0,0,0,,أحسنت.
Dialogue: 0,0:37:49.70,0:37:52.91,Default,Kus3,0,0,0,,آمل أن يفهم تشيولجونغ الفكرة الأساسية.
Dialogue: 0,0:38:08.01,0:38:11.35,Default,Kus3,0,0,0,,هل هذا هو الطعام المتواضع للناس العاديين؟
Dialogue: 0,0:38:11.35,0:38:14.76,Default,Kus3,0,0,0,,لكنني لا أعرف ماذا يأكل الناس العاديون؟
Dialogue: 0,0:38:17.66,0:38:19.76,Default,Kus3,0,0,0,,البطاطا الحلزونية
Dialogue: 0,0:38:28.08,0:38:29.74,Default,Kus3,0,0,0,,كانت نيتي نبيلة،
Dialogue: 0,0:38:30.37,0:38:34.04,Default,Kus3,0,0,0,,ومع ذلك، يجب أن أحترم ضيوفي.
Dialogue: 0,0:38:34.45,0:38:36.95,Default,Kus3,0,0,0,,لذلك تم استخدام منتجات بسيطة،
Dialogue: 0,0:38:37.24,0:38:39.35,Default,Kus3,0,0,0,,لكنهم مستعدون بطريقة جديدة.
Dialogue: 0,0:38:40.64,0:38:44.95,Default,Kus3,0,0,0,,أول طبق في العيد هو البطاطس.
Dialogue: 0,0:38:45.83,0:38:47.06,Default,Kus3,0,0,0,,هل هذه البطاطس؟
Dialogue: 0,0:38:49.79,0:38:51.12,Default,Kus3,0,0,0,,هذه ليست بطاطس عادية.
Dialogue: 0,0:38:51.83,0:38:52.97,Default,Kus3,0,0,0,,الطبق يسمى...
Dialogue: 0,0:38:55.99,0:38:57.29,Default,Kus3,0,0,0,,يتلوى
Dialogue: 0,0:38:58.70,0:38:59.76,Default,Kus3,0,0,0,,مثل الربيع؟
Dialogue: 0,0:39:02.87,0:39:04.04,Default,Kus3,0,0,0,,البطاطا الحلزونية!
Dialogue: 0,0:39:04.54,0:39:05.58,Default,Kus3,0,0,0,,حسنًا.
Dialogue: 0,0:39:05.58,0:39:07.81,Default,Kus3,0,0,0,,يشبه شارب التنين.
Dialogue: 0,0:39:07.81,0:39:09.24,Default,Kus3,0,0,0,,يُسمى "الدوامة".
Dialogue: 0,0:39:10.74,0:39:12.64,Default,Kus3,0,0,0,,طبق سعيد ليوم سعيد.
Dialogue: 0,0:39:12.64,0:39:14.35,Default,Kus3,0,0,0,,إنها مجرد حبة بطاطس.
Dialogue: 0,0:39:14.35,0:39:17.16,Default,Kus3,0,0,0,,التنين؟ أنت تبالغ يا صاحب الجلالة.
Dialogue: 0,0:39:17.56,0:39:19.22,Default,Kus3,0,0,0,,إذا لم تكن هناك بطاطس،
Dialogue: 0,0:39:19.22,0:39:21.45,Default,Kus3,0,0,0,,سنفقد المزيد من الأرواح.
Dialogue: 0,0:39:22.26,0:39:23.76,Default,Kus3,0,0,0,,بطاطس القرية
Dialogue: 0,0:39:23.76,0:39:26.39,Default,Kus3,0,0,0,,ينمو حتى في التربة القاحلة ويمكن تخزينه بسهولة.
Dialogue: 0,0:39:26.60,0:39:29.20,Default,Kus3,0,0,0,,هذا هو المنتج الغذائي الرئيسي أثناء زراعة الشعير.
Dialogue: 0,0:39:29.76,0:39:33.43,Default,Kus3,0,0,0,,منتج مقدس ينقذ الأرواح.
Dialogue: 0,0:39:33.81,0:39:36.01,Default,Kus3,0,0,0,,إنها ليست "مجرد حبة بطاطس".
Dialogue: 0,0:39:37.64,0:39:38.74,Default,Kus3,0,0,0,,تذوق الطبق.
Dialogue: 0,0:39:57.35,0:40:00.03,Default,Kus3,0,0,0,,مجنون. لذيذ جدا.
Dialogue: 0,0:40:00.60,0:40:02.26,Default,Kus3,0,0,0,,لم آكل شيئاً كهذا من قبل.
Dialogue: 0,0:40:03.70,0:40:07.54,Default,Kus3,0,0,0,,يبدو أن المستشار المناسب جائع تماماً.
Dialogue: 0,0:40:16.47,0:40:17.74,Default,Kus3,0,0,0,,هل هذه البطاطس؟
Dialogue: 0,0:40:30.33,0:40:33.22,Default,Kus4,0,0,0,,هناك ثلاثة توابل أمامك.
Dialogue: 0,0:40:33.22,0:40:35.64,Default,Kus4,0,0,0,,الأخضر هو ملح الصنوبر من عائلة ناميانغ خون.
Dialogue: 0,0:40:36.06,0:40:38.81,Default,Kus4,0,0,0,,تم تحضيره من ملح البحر وإبر الصنوبر
Dialogue: 0,0:40:38.81,0:40:40.20,Default,Kus4,0,0,0,,في قصر هواسونغ.
Dialogue: 0,0:40:41.74,0:40:44.87,Default,Kus4,0,0,0,,مسحوق أحمر فاتح - سكر العنب.
Dialogue: 0,0:40:45.54,0:40:47.54,Default,Kus4,0,0,0,,سكر؟ سيكون من الأفضل لو زرعوا الشعير.
Dialogue: 0,0:40:48.24,0:40:50.37,Default,Kus4,0,0,0,,مع هذا الطعام اللذيذ لا داعي للقلق،
Dialogue: 0,0:40:50.37,0:40:52.41,Default,Kus4,0,0,0,,سيتم حل جميع الصعوبات.
Dialogue: 0,0:40:54.12,0:40:57.16,Default,Kus4,0,0,0,,سوسن مطحون ممزوج بالعنب البري.
Dialogue: 0,0:40:57.99,0:40:59.66,Default,Kus4,0,0,0,,تم جمع العنب من جبل كاماكسان
Dialogue: 0,0:40:59.66,0:41:01.66,Default,Kus4,0,0,0,,على أراضي عائلة يون "فابيونغ".
Dialogue: 0,0:41:01.66,0:41:03.72,Default,Kus4,0,0,0,,يعطي السكر لوناً ورائحة جميلة.
Dialogue: 0,0:41:04.79,0:41:07.10,Default,Kus4,0,0,0,,الصلصة الصفراء مصنوعة من الخوخ.
Dialogue: 0,0:41:07.62,0:41:09.70,Default,Kus4,0,0,0,,تم اختيار أفضل أنواع الخوخ
Dialogue: 0,0:41:09.70,0:41:12.16,Default,Kus4,0,0,0,,من يوجو، حيث تعيش عشيرة يوهين في مين.
Dialogue: 0,0:41:13.04,0:41:16.83,Default,Kus4,0,0,0,,موضوع عيد اليوم هو الانسجام.
Dialogue: 0,0:41:18.91,0:41:21.04,Default,Kus4,0,0,0,,السياسة تقسم الناس،
Dialogue: 0,0:41:21.04,0:41:24.18,Default,Kus4,0,0,0,,ولكن الطعام اللذيذ يوحدهم.
Dialogue: 0,0:41:24.62,0:41:28.08,Default,Kus4,0,0,0,,آمل أن تشعر بالانسجام بين العشائر الثلاث،
Dialogue: 0,0:41:28.49,0:41:30.29,Default,Kus4,0,0,0,,انضم إلينا اليوم.
Dialogue: 0,0:41:40.47,0:41:43.47,Default,Kus4,0,0,0,,قطّع البطاطا الحلوة والكوسا والباذنجان واقليها.
Dialogue: 0,0:41:43.47,0:41:45.37,Default,Kus4,0,0,0,,سأعدّ يخنة الخضار بالطماطم الكاملة
Dialogue: 0,0:41:45.37,0:41:46.87,Default,Kus4,0,0,0,,مع المرق والبيض.
Dialogue: 0,0:41:48.51,0:41:49.64,Default,Kus4,0,0,0,,هذه فكرة غير عادية،
Dialogue: 0,0:41:49.64,0:41:52.20,Default,Kus4,0,0,0,,كيفية أكل الوعاء نفسه سيدفعهم إلى الجنون.
Dialogue: 0,0:41:55.18,0:41:56.31,Default,Kus4,0,0,0,,ألم تنته بعد؟
Dialogue: 0,0:41:57.01,0:41:58.12,Default,Kus4,0,0,0,,أين هناك.
Dialogue: 0,0:41:58.12,0:42:00.68,Default,Kus4,0,0,0,,أطحن الشعير والفاصوليا إلى مسحوق.
Dialogue: 0,0:42:00.68,0:42:03.56,Default,Kus4,0,0,0,,لدي كل أنواع المساحيق الممكنة، وأنا أخلطها وأمزجها.
Dialogue: 0,0:42:04.35,0:42:08.26,Default,Kus4,0,0,0,,الطبق الذي تحضره الآن سيكون أبرز ما في الوليمة.
Dialogue: 0,0:42:08.26,0:42:09.26,Default,Kus4,0,0,0,,حسنًا.
Dialogue: 0,0:42:11.99,0:42:14.47,Default,Kus4,0,0,0,,ماذا تفعل؟ اعجن بقوة أكبر، مثلي.
Dialogue: 0,0:42:15.43,0:42:18.76,Default,Kus4,0,0,0,,مضر بمفاصل الكتفين والمعصمين.
Dialogue: 0,0:42:18.76,0:42:21.33,Default,Kus4,0,0,0,,هيا. استخدم المزيد من القوة. افعلها.
Dialogue: 0,0:42:21.33,0:42:24.04,Default,Kus4,0,0,0,,اعمل مع كتفيك ومعصميك إذا لزم الأمر.
Dialogue: 0,0:42:24.04,0:42:25.87,Default,Kus4,0,0,0,,اضغطي العجينة.
Dialogue: 0,0:42:29.18,0:42:31.51,Default,Kus4,0,0,0,,يا معلمة، كل شيء جاهز.
Dialogue: 0,0:42:31.51,0:42:32.51,Default,Kus4,0,0,0,,حقاً؟
Dialogue: 0,0:42:33.58,0:42:35.89,Default,Kus4,0,0,0,,حسنًا.
Dialogue: 0,0:42:36.35,0:42:38.72,Default,Kus4,0,0,0,,مهما قلت فهذه وليمة. لا توجد طريقة بدون اللحوم.
Dialogue: 0,0:42:39.22,0:42:41.08,Default,Kus4,0,0,0,,يكمل طبقنا الرئيسي -
Dialogue: 0,0:42:41.08,0:42:42.83,Default,Kus4,0,0,0,,برجر مع شريحة لحم نباتي.
Dialogue: 0,0:43:01.37,0:43:05.12,Default,Kus4,0,0,0,,McDonald's
Dialogue: 0,0:43:05.12,0:43:06.72,Default,Kus4,0,0,0,,إناء طماطم صالح للأكل.
Dialogue: 0,0:43:07.18,0:43:08.49,Default,Kus4,0,0,0,,طماطم حمراء
Dialogue: 0,0:43:08.49,0:43:10.95,Default,Kus4,0,0,0,,يوم العربة يطرد الحظ السيئ
Dialogue: 0,0:43:10.95,0:43:12.89,Default,Kus4,0,0,0,,والأرواح الشريرة.
Dialogue: 0,0:43:20.97,0:43:22.64,Default,Kus4,0,0,0,,يا له من طعم رقيق!
Dialogue: 0,0:43:30.20,0:43:31.35,Default,Kus4,0,0,0,,هل هذه شريحة لحم؟
Dialogue: 0,0:43:31.68,0:43:34.45,Default,Kus4,0,0,0,,مستحيل. لا يمكن تسليم اللحوم...
Dialogue: 0,0:43:37.14,0:43:40.64,Default,Kus4,0,0,0,,أردت أن أقول إنه من الصعب الحصول على اللحوم الآن.
Dialogue: 0,0:43:42.85,0:43:44.49,Default,Kus4,0,0,0,,هناك مثل صيني واحد:
Dialogue: 0,0:43:44.49,0:43:46.22,Default,Kus4,0,0,0,"هناك لحم تنين في السماء،"
Dialogue: 0,0:43:46.22,0:43:47.89,Default,Kus4,0,0,0,,وعلى الأرض - من القرود."
Dialogue: 0,0:43:48.16,0:43:51.93,Default,Kus4,0,0,0,,وسنضيف: "لحم الفول في الأوقات الصعبة".
Dialogue: 0,0:43:52.56,0:43:56.64,Default,Kus4,0,0,0,,بالشعير والفاصوليا سننمو البطن.
Dialogue: 0,0:43:56.99,0:43:59.81,Default,Kus4,0,0,0,,هذا هو جوهر ماكدونالدز.
Dialogue: 0,0:44:00.26,0:44:01.93,Default,Kus4,0,0,0,,ماكدونالدز.
Dialogue: 0,0:44:02.74,0:44:04.14,Default,Kus4,0,0,0,,
Dialogue: 0,0:44:04.14,0:44:08.14,Default,Kus4,0,0,0,,مغذية ولذيذة، مثل اللحوم الحقيقية.
Dialogue: 0,0:44:08.87,0:44:10.14,Default,Kus4,0,0,0,,هناك شيء ما في هذا.
Dialogue: 0,0:44:43.78,0:44:44.85,Default,Kus4,0,0,0,,كم هو جميل.
Dialogue: 0,0:44:45.24,0:44:48.49,Default,Kus4,0,0,0,,زيّنها بالورود، وسيكون الهلام الحلو المبرد جاهزًا.
Dialogue: 0,0:44:48.49,0:44:49.79,Default,Kus4,0,0,0,,علاج للعيون.
Dialogue: 0,0:44:50.31,0:44:53.03,Default,Kus4,0,0,0,,يجب أن تكون الحلويات لذيذة وجميلة.
Dialogue: 0,0:44:55.43,0:44:56.95,Default,Kus4,0,0,0,,-مدهش.\N-انظر فقط إلى هذه الألوان.
Dialogue: 0,0:44:56.95,0:44:59.43,Default,Kus4,0,0,0,,وأخيرًا، لنجعل الجميع يقولون "رائع".
Dialogue: 0,0:44:59.72,0:45:01.70,Default,Kus4,0,0,0,,نهاية مثالية للحفلة.
Dialogue: 0,0:45:12.47,0:45:13.81,Default,Kus4,0,0,0,,جيلي الحظ
Dialogue: 0,0:45:13.81,0:45:15.24,Default,Kus4,0,0,0,,جميلة بالطبع،
Dialogue: 0,0:45:15.24,0:45:17.85,Default,Kus4,0,0,0,,لكنه مجرد هلام عادي.
Dialogue: 0,0:45:18.04,0:45:22.22,Default,Kus4,0,0,0,,أعتقد أنه لم يكن لديك ما يكفي للمزيد.
Dialogue: 0,0:45:24.39,0:45:26.93,Default,Kus4,0,0,0,,بفضل العصا، أصبح تناول الجيلي أكثر ملاءمة.
Dialogue: 0,0:45:27.39,0:45:29.12,Default,Kus4,0,0,0,,وسوف تتنبأ بحظك أيضًا.
Dialogue: 0,0:45:29.62,0:45:30.62,Default,Kus4,0,0,0,,حظاً سعيداً؟
Dialogue: 0,0:45:30.85,0:45:32.62,Default,Kus4,0,0,0,,هذا الطبق يشبه البداية الجديدة،
Dialogue: 0,0:45:32.62,0:45:35.83,Default,Kus4,0,0,0,,لهذا السبب يطلق عليه هلام الحظ السعيد.
Dialogue: 0,0:45:36.47,0:45:40.01,Default,Kus4,0,0,0,,آمل أن يكون مستقبلك ناجحاً، مثل البداية الجديدة.
Dialogue: 0,0:45:46.01,0:45:49.72,Default,Kus4,0,0,0,,ربما سننهي عيدنا بمعرفة حظنا؟
Dialogue: 0,0:45:50.31,0:45:54.14,Default,Kus4,0,0,0,,كيف يمكننا أن نفعل شيئاً كهذا في قصر مقدس؟
Dialogue: 0,0:45:58.58,0:45:59.79,Default,Kus4,0,0,0,,واحد آخر
Dialogue: 0,0:46:01.18,0:46:02.29,Default,Kus4,0,0,0,,واحد آخر.
Dialogue: 0,0:46:02.29,0:46:03.35,Default,Kus4,0,0,0,,واحد آخر؟
Dialogue: 0,0:46:05.26,0:46:07.12,Default,Kus4,0,0,0,,"حاول في المرة القادمة."
Dialogue: 0,0:46:11.14,0:46:13.93,Default,Kus4,0,0,0,,الخاسر
Dialogue: 0,0:46:18.92,0:46:21.22,Default,Kus4,0,0,0,,كم يؤلمني ظهري.
Dialogue: 0,0:46:24.52,0:46:26.03,Default,Kus4,0,0,0,,سوف أستريح الآن.
Dialogue: 0,0:46:29.90,0:46:32.97,Default,Kus4,0,0,0,,أضع روحي في هذه الأطباق، وليس في المكونات.
Dialogue: 0,0:46:33.20,0:46:35.24,Default,Kus4,0,0,0,,سأموت.
Dialogue: 0,0:46:37.77,0:46:39.07,Default,Kus4,0,0,0,,لقد فعلنا ذلك.
Dialogue: 0,0:46:39.67,0:46:40.91,Default,Kus4,0,0,0,,تمكنا من ذلك.
Dialogue: 0,0:46:43.91,0:46:45.78,Default,Kus4,0,0,0,,هل تعرف ما الذي أفكر فيه الآن؟
Dialogue: 0,0:46:47.65,0:46:50.25,Default,Kus4,0,0,0,,أعلم. أشعر بنفس الطريقة.
Dialogue: 0,0:46:52.55,0:46:54.12,Default,Kus4,0,0,0,,-شرحات السمك.\N-ماذا؟
Dialogue: 0,0:46:54.69,0:46:56.32,Default,Kus4,0,0,0,,أنا أفكر في كعك السمك.
Dialogue: 0,0:46:58.69,0:47:01.09,Default,Kus4,0,0,0,,الطباخ الذي كاد أن يموت على يد الإمبراطور تشين شيهوانغ،
Dialogue: 0,0:47:01.09,0:47:03.26,Default,Kus4,0,0,0,,كعك السمك المطبوخ في الليلة السابقة.
Dialogue: 0,0:47:03.26,0:47:05.53,Default,Kus4,0,0,0,,اعتقدت أنه كان محظوظاً.
Dialogue: 0,0:47:06.23,0:47:07.37,Default,Kus4,0,0,0,,ولكن لا.
Dialogue: 0,0:47:07.57,0:47:08.60,Default,Kus4,0,0,0,,أعدهم،
Dialogue: 0,0:47:08.60,0:47:10.64,Default,Kus4,0,0,0,,أبذل قصارى جهدي للبقاء على قيد الحياة.
Dialogue: 0,0:47:10.87,0:47:12.34,Default,Kus4,0,0,0,,الإلهام -
Dialogue: 0,0:47:12.34,0:47:14.34,Default,Kus4,0,0,0,,هذا ليس شيئاً عادياً يأتي،
Dialogue: 0,0:47:14.44,0:47:15.88,Default,Kus4,0,0,0,,عندما تستسلم.
Dialogue: 0,0:47:17.18,0:47:18.31,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:47:19.35,0:47:20.41,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:47:22.28,0:47:24.79,Default,Kus4,0,0,0,,حسناً، لماذا كنت في عجلة من هذا القبيل!
Dialogue: 0,0:47:24.79,0:47:28.46,Default,Kus4,0,0,0,,هنا. هناك بعض الماء هنا. تناول مشروب.
Dialogue: 0,0:47:33.96,0:47:35.80,Default,Kus4,0,0,0,,الملكة، واسم عائلته خان.
Dialogue: 0,0:47:36.36,0:47:38.50,Default,Kus4,0,0,0,,حقاً؟ هل اسمه الأخير خان حقًا؟
Dialogue: 0,0:47:38.50,0:47:39.53,Default,Kus4,0,0,0,,نعم.
Dialogue: 0,0:47:40.30,0:47:41.64,Default,Kus4,0,0,0,,اسمه سيمون.
Dialogue: 0,0:47:41.77,0:47:43.27,Default,Kus4,0,0,0,,اسمه خان سيمون.
Dialogue: 0,0:47:43.30,0:47:45.81,Default,Kus4,0,0,0,,سيمون؟ ما اسمه كأجنبي؟
Dialogue: 0,0:47:48.68,0:47:50.88,Default,Kus4,0,0,0,,خان سيمون.
Dialogue: 0,0:47:51.38,0:47:52.38,Default,Kus4,0,0,0,,نعم.
Dialogue: 0,0:47:53.81,0:47:55.42,Default,Kus4,0,0,0,,ما هذا؟
Dialogue: 0,0:47:55.42,0:47:57.68,Default,Kus4,0,0,0,,أوه لا. لا شيء من هذا القبيل.
Dialogue: 0,0:47:59.32,0:48:01.02,Default,Kus4,0,0,0,,بينما كنت خارج القصر،
Dialogue: 0,0:48:01.02,0:48:02.89,Default,Kus4,0,0,0,,وصلت إلى هانسيونغبو
Dialogue: 0,0:48:02.89,0:48:05.16,Default,Kus4,0,0,0,,وبحثت في سجل عائلتهم.
Dialogue: 0,0:48:07.39,0:48:10.23,Default,Kus4,0,0,0,,أنا متأكد من أن سجل العائلة هذا مزيف.
Dialogue: 0,0:48:11.67,0:48:15.07,Default,Kus4,0,0,0,,لم أتوقع أي شيء آخر من أسلاف المخرج خان.
Dialogue: 0,0:48:15.30,0:48:17.10,Default,Kus4,0,0,0,,طردناه بتهمة تزوير هويته،
Dialogue: 0,0:48:17.10,0:48:19.71,Default,Kus4,0,0,0,,فقرر أن ينتصر عليه بهذه الطريقة القذرة؟
Dialogue: 0,0:48:19.71,0:48:22.08,Default,Kus4,0,0,0,,الملكة، لا يجب أن تبقى هنا.
Dialogue: 0,0:48:22.18,0:48:24.04,Default,Kus4,0,0,0,,لقد كنت غائباً لفترة طويلة بالفعل.
Dialogue: 0,0:48:24.04,0:48:25.18,Default,Kus4,0,0,0,,بالضبط.
Dialogue: 0,0:48:25.41,0:48:26.78,Default,Kus4,0,0,0,,لقد قمت بعمل جيد يا سيدة تشوي.
Dialogue: 0,0:48:26.78,0:48:28.82,Default,Kus4,0,0,0,,-لنذهب بسرعة.\N-جلالتك.
Dialogue: 0,0:48:28.82,0:48:30.48,Default,Kus4,0,0,0,,-انتظر.\N-كن حذراً.
Dialogue: 0,0:48:30.48,0:48:31.52,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:48:33.69,0:48:35.52,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:48:35.92,0:48:37.02,Default,Kus4,0,0,0,,جلالتك.
Dialogue: 0,0:48:37.92,0:48:40.46,Default,Kus4,0,0,0,,ماذا؟ ماذا حدث؟
Dialogue: 0,0:48:43.63,0:48:45.23,Default,Kus4,0,0,0,,بطني...
Dialogue: 0,0:48:46.87,0:48:49.54,Default,Kus4,0,0,0,,يبدو الأمر كما لو أن فرقة موسيقية كاملة تعزف على الطبول في معدتي.
Dialogue: 0,0:48:50.30,0:48:51.51,Default,Kus4,0,0,0,,ماذا يحدث؟
Dialogue: 0,0:48:53.01,0:48:54.07,Default,Kus4,0,0,0,,الماء...
Dialogue: 0,0:48:54.91,0:48:57.48,Default,Kus4,0,0,0,,لم يغير أحد الماء؟
Dialogue: 0,0:48:57.48,0:48:59.85,Default,Kus4,0,0,0,,ما المشكلة في هذا؟
Dialogue: 0,0:49:00.91,0:49:02.05,Default,Kus4,0,0,0,,الماء؟
Dialogue: 0,0:49:02.32,0:49:04.42,Default,Kus4,0,0,0,,هذه المياه مسمومة.
Dialogue: 0,0:49:04.95,0:49:06.92,Default,Kus4,0,0,0,,السم؟
Dialogue: 0,0:49:08.26,0:49:09.49,Default,Kus4,0,0,0,,السم؟
Dialogue: 0,0:49:10.32,0:49:11.32,Default,Kus4,0,0,0,,سيدة البلاط!
Dialogue: 0,0:49:13.43,0:49:14.93,Default,Kus4,0,0,0,,أرى أنك وصلت.
Dialogue: 0,0:49:16.03,0:49:17.40,Default,Kus4,0,0,0,,بالطبع جاء.
Dialogue: 0,0:49:18.63,0:49:22.10,Default,Kus4,0,0,0,,هذه وليمة تكريماً لتعافي الملكة.
Dialogue: 0,0:49:22.40,0:49:24.24,Default,Kus4,0,0,0,,من الآن فصاعدا، أبقِ عينيك مفتوحتين.
Dialogue: 0,0:49:24.87,0:49:27.81,Default,Kus4,0,0,0,,شاهد نتيجة أفعالك.
Dialogue: 0,0:49:40.82,0:49:42.02,Default,Kus4,0,0,0,,الله.
Dialogue: 0,0:49:43.09,0:49:46.13,Default,Kus4,0,0,0,,تبين أن الطبخ أصعب مما كنت أعتقد.
Dialogue: 0,0:49:47.53,0:49:50.33,Default,Kus4,0,0,0,,كل سنتيمتر من جسدي يؤلمني.
Dialogue: 0,0:49:51.10,0:49:55.67,Default,Kus4,0,0,0,,وأيضاً، ظل الطباخ الملكي يصرخ في وجهي.
Dialogue: 0,0:49:56.57,0:49:59.47,Default,Kus4,0,0,0,,-هذا الوغد.\N-أسرع هنا!
Dialogue: 0,0:50:02.71,0:50:04.44,Default,Kus4,0,0,0,,هل مازلت بحاجة إلى تقشير البطاطس؟
Dialogue: 0,0:50:04.44,0:50:07.01,Default,Kus4,0,0,0,,ساعد سيدة البلاط تشوي.
Dialogue: 0,0:50:07.05,0:50:08.18,Default,Kus4,0,0,0,,من فضلك.
Dialogue: 0,0:50:20.59,0:50:21.83,Default,Kus5,0,0,0,,واصل العمل الجيد.
Dialogue: 0,0:50:27.27,0:50:28.40,Default,Kus5,0,0,0,,عذراً.
Dialogue: 0,0:50:38.41,0:50:39.98,Default,Kus5,0,0,0,,كان يرتدي قناع توكيبي
Dialogue: 0,0:50:40.81,0:50:42.88,Default,Kus5,0,0,0,,وعلى وجهه ندبة قديمة.
Dialogue: 0,0:50:49.96,0:50:51.02,Default,Kus5,0,0,0,,عذراً.
Dialogue: 0,0:50:59.17,0:51:00.23,Default,Kus5,0,0,0,,الله.
Dialogue: 0,0:51:01.43,0:51:02.50,Default,Kus5,0,0,0,,عذراً.
Dialogue: 0,0:51:24.46,0:51:27.73,Default,Kus5,0,0,0,,انظر، إنها تعاني من الألم.
Dialogue: 0,0:51:28.13,0:51:30.70,Default,Kus5,0,0,0,,قومي بالوخز بالإبر، وكي بالعشب، افعلي شيئاً.
Dialogue: 0,0:51:30.70,0:51:32.73,Default,Kus5,0,0,0,,وأعطها الترياق.
Dialogue: 0,0:51:32.73,0:51:35.30,Default,Kus5,0,0,0,,اهتم بشؤونك الخاصة.
Dialogue: 0,0:51:35.44,0:51:37.27,Default,Kus5,0,0,0,,أنا المسؤول في هذا المجال.
Dialogue: 0,0:51:45.75,0:51:47.31,Default,Kus5,0,0,0,,أنا أطيع.
Dialogue: 0,0:51:47.55,0:51:49.48,Default,Kus5,0,0,0,,كنت فظيعًا في المطبخ الملكي،
Dialogue: 0,0:51:49.48,0:51:51.42,Default,Kus5,0,0,0,,لكنك مثالي في المستشفى الملكي.
Dialogue: 0,0:51:52.45,0:51:54.72,Default,Kus5,0,0,0,,سواء كان شخصاً أو كائناً،
Dialogue: 0,0:51:54.72,0:51:56.99,Default,Kus5,0,0,0,,يجب أن يكون الجميع في مكانهم.
Dialogue: 0,0:51:58.86,0:52:01.33,Default,Kus5,0,0,0,,إبرتك تعمل بشكل أفضل في المطبخ.
Dialogue: 0,0:52:01.33,0:52:02.33,Default,Kus5,0,0,0,,هذا ليس صحيحاً!
Dialogue: 0,0:52:02.33,0:52:04.53,Default,Kus5,0,0,0,,هذه الإبرة مثالية لثقب البطاطس.
Dialogue: 0,0:52:04.53,0:52:05.63,Default,Kus5,0,0,0,,دعني أستخدمه.
Dialogue: 0,0:52:05.77,0:52:07.20,Default,Kus5,0,0,0,,كيف تجرؤ على التخطيط لها! أبداً.
Dialogue: 0,0:52:07.20,0:52:08.97,Default,Kus5,0,0,0,,وهذا مثالي لتقشير البطاطس.
Dialogue: 0,0:52:08.97,0:52:11.54,Default,Kus5,0,0,0,,-أعطني إياها.\N-No.
Dialogue: 0,0:52:11.54,0:52:13.27,Default,Kus5,0,0,0,,غير مسموح لك يا صاحب الجلالة!
Dialogue: 0,0:52:20.85,0:52:25.75,Default,Kus5,0,0,0,,لقد توقف الرقص في معدتي.
Dialogue: 0,0:52:27.52,0:52:29.16,Default,Kus5,0,0,0,,لا ينبغي أن أكون هنا.
Dialogue: 0,0:52:30.56,0:52:32.26,Default,Kus5,0,0,0,,-جلالتك.\N-سيدة المحكمة تشوي!
Dialogue: 0,0:52:32.53,0:52:35.70,Default,Kus5,0,0,0,,من المستحيل أن تتعافى بهذه السرعة.
Dialogue: 0,0:52:39.63,0:52:41.60,Default,Kus5,0,0,0,,إنها امرأة قوية.
Dialogue: 0,0:52:53.11,0:52:54.31,Default,Kus5,0,0,0,,إن رائحتها مثل الزيت.
Dialogue: 0,0:52:54.31,0:52:56.48,Default,Kus5,0,0,0,,لماذا غبت كل هذه المدة؟
Dialogue: 0,0:52:57.25,0:52:59.12,Default,Kus5,0,0,0,,حسناً، الأمر...
Dialogue: 0,0:52:59.15,0:53:00.29,Default,Kus5,0,0,0,,أعتذر.
Dialogue: 0,0:53:01.12,0:53:03.06,Default,Kus5,0,0,0,,انزلقت يدي،
Dialogue: 0,0:53:03.32,0:53:05.49,Default,Kus5,0,0,0,,وأصاب سهمي الملكة.
Dialogue: 0,0:53:06.93,0:53:10.50,Default,Kus5,0,0,0,,هل أنت جريح؟
Dialogue: 0,0:53:10.76,0:53:12.67,Default,Kus5,0,0,0,,لا، أنا بخير.
Dialogue: 0,0:53:13.10,0:53:15.00,Default,Kus5,0,0,0,,كانت المطاردة متعبة للغاية،
Dialogue: 0,0:53:15.00,0:53:17.67,Default,Kus5,0,0,0,,أنني غفوت أثناء التحضير.
Dialogue: 0,0:53:17.84,0:53:18.91,Default,Kus5,0,0,0,,انظر ماذا.
Dialogue: 0,0:53:34.19,0:53:35.36,Default,Kus5,0,0,0,,المئزر؟
Dialogue: 0,0:53:44.16,0:53:46.93,Default,Kus5,0,0,0,,متى ستنجح استعداداتك؟
Dialogue: 0,0:53:47.03,0:53:48.50,Default,Kus5,0,0,0,,انتظر.
Dialogue: 0,0:53:48.77,0:53:51.37,Default,Kus5,0,0,0,,بذل الملك الكثير من الجهد في هذه الوليمة.
Dialogue: 0,0:53:51.84,0:53:54.84,Default,Kus5,0,0,0,,الآن يجب أن يكون مركز الاهتمام.
Dialogue: 0,0:54:18.53,0:54:21.00,Default,Kus5,0,0,0,,يجب على كل من جاء إلى هنا كعلماء أن يكون قدوة
Dialogue: 0,0:54:21.40,0:54:23.14,Default,Kus5,0,0,0,,الاعتدال في الطعام,
Dialogue: 0,0:54:23.14,0:54:25.64,Default,Kus5,0,0,0,,لإظهار أنك تفهم أن الناس يتضورون جوعا.
Dialogue: 0,0:54:26.04,0:54:28.84,Default,Kus5,0,0,0,,سأغتنم هذه الفرصة للإعلان.
Dialogue: 0,0:54:31.54,0:54:33.15,Default,Kus5,0,0,0,,بدءاً بهذا العيد،
Dialogue: 0,0:54:33.71,0:54:35.22,Default,Kus5,0,0,0,,سنقوم بتقليل عدد الأطباق في طعامنا.
Dialogue: 0,0:54:36.78,0:54:38.05,Default,Kus5,0,0,0,,أطباق أقل؟
Dialogue: 0,0:54:38.95,0:54:41.02,Default,Kus5,0,0,0,,ما هذا الهراء الذي يتحدث عنه؟
Dialogue: 0,0:54:41.12,0:54:44.19,Default,Kus5,0,0,0,,عندما تكون الأوقات صعبة في البلاد،
Dialogue: 0,0:54:44.19,0:54:46.83,Default,Kus5,0,0,0,,يجب أن يكون الملك جزءاً من الأطباق،
Dialogue: 0,0:54:46.99,0:54:48.80,Default,Kus5,0,0,0,,ليشارك شعبه آلامه.
Dialogue: 0,0:54:49.16,0:54:53.43,Default,Kus5,0,0,0,,من خلال تقليل عدد الأطباق، نشعر بألم شعبنا،
Dialogue: 0,0:54:53.73,0:54:55.57,Default,Kus5,0,0,0,,ويمكننا التغلب على كل شيء معًا.
Dialogue: 0,0:54:56.37,0:55:00.07,Default,Kus5,0,0,0,,في مثل هذه الأوقات، اختر الحبوب لإرضاء عشرات الأشخاص
Dialogue: 0,0:55:00.07,0:55:02.88,Default,Kus5,0,0,0,,وأبهج أحشائك بقطعة لحم -
Dialogue: 0,0:55:03.38,0:55:04.51,Default,Kus5,0,0,0,,خطيئة.
Dialogue: 0,0:55:05.58,0:55:08.15,Default,Kus5,0,0,0,,في النهاية أولئك الذين في القصر
Dialogue: 0,0:55:08.38,0:55:11.58,Default,Kus5,0,0,0,,سيقدمون اللحم على المائدة، وسيعاقبون.
Dialogue: 0,0:55:14.22,0:55:17.76,Default,Kus5,0,0,0,,أنا لا أحظر اللحوم فحسب، بل أحظر أيضًا أي طعام باهظ الثمن.
Dialogue: 0,0:55:18.22,0:55:21.53,Default,Kus5,0,0,0,,لا ينبغي للوزراء أن يستمتعوا بالشرب والغناء والرقص،
Dialogue: 0,0:55:21.96,0:55:23.83,Default,Kus5,0,0,0,,ويجب أن يوقف صراع العشائر على السلطة.
Dialogue: 0,0:55:24.73,0:55:26.27,Default,Kus5,0,0,0,,أولئك الذين لا يقبلون هذه الشروط،
Dialogue: 0,0:55:27.17,0:55:30.14,Default,Kus5,0,0,0,,سأعتبرهم متعطشين للعقاب.
Dialogue: 0,0:55:32.47,0:55:33.61,Default,Kus5,0,0,0,,جلالتك.
Dialogue: 0,0:55:47.09,0:55:49.29,Default,Kus5,0,0,0,,أنا كيم جواجيون، أرجوك سامحني
Dialogue: 0,0:55:49.46,0:55:52.03,Default,Kus5,0,0,0,,لأخبار سيئة.
Dialogue: 0,0:56:24.72,0:56:26.49,Default,Kus5,0,0,0,,هؤلاء المجرمون كذبوا بشأن وضعهم
Dialogue: 0,0:56:26.49,0:56:28.26,Default,Kus5,0,0,0,,واختبأ في الحرس الملكي.
Dialogue: 0,0:56:29.40,0:56:31.33,Default,Kus5,0,0,0,,من أجل تنفيذ أوامرك وخدمتك،
Dialogue: 0,0:56:31.33,0:56:33.13,Default,Kus5,0,0,0,,لقد استخدموا هويات مزيفة.
Dialogue: 0,0:56:35.17,0:56:38.34,Default,Kus5,0,0,0,,لقد حان الوقت للتعامل مع من يخفيهم.
Dialogue: 0,0:56:38.50,0:56:40.47,Default,Kus5,0,0,0,,أنا متأكد من أنه يعتقد أن أساس قوته هو تلك
Dialogue: 0,0:56:40.47,0:56:42.34,Default,Kus5,0,0,0,,الذي اعتنى به وحمايته.
Dialogue: 0,0:56:42.78,0:56:45.35,Default,Kus5,0,0,0,,يجب أن نبيد هذا في مهده.
Dialogue: 0,0:56:47.28,0:56:49.25,Default,Kus5,0,0,0,,حتى لا يقوم مرة أخرى.
Dialogue: 0,0:57:12.31,0:57:15.28,Default,Kus5,0,0,0,,هل عليك إفساد هذا اليوم المهم؟
Dialogue: 0,0:57:15.28,0:57:18.01,Default,Kus5,0,0,0,,هل تعرف من هم حقاً؟
Dialogue: 0,0:57:19.41,0:57:21.58,Default,Kus5,0,0,0,,بعض العائلات مذنبة بالخيانة العظمى.
Dialogue: 0,0:57:21.58,0:57:24.18,Default,Kus5,0,0,0,,وآخرون هم قطاع الطرق الذين هاجموا المسؤولين العلماء،
Dialogue: 0,0:57:24.18,0:57:26.69,Default,Kus5,0,0,0,,وبعضهم مطلوبون لدعوات مفتوحة ضد السلطات.
Dialogue: 0,0:57:27.02,0:57:29.92,Default,Kus5,0,0,0,,جميعهم معارضون للبلاط الملكي،
Dialogue: 0,0:57:29.92,0:57:31.46,Default,Kus5,0,0,0,,لكنهم متنكرين،
Dialogue: 0,0:57:31.46,0:57:33.93,Default,Kus5,0,0,0,,حراسة جلالتك.
Dialogue: 0,0:57:34.06,0:57:36.16,Default,Kus5,0,0,0,,هدفهم النهائي هو القيام بانقلاب.
Dialogue: 0,0:57:36.46,0:57:38.46,Default,Kus5,0,0,0,,نظراً لخطورة الأمر، لم يكن لدي خيار آخر،
Dialogue: 0,0:57:38.46,0:57:40.40,Default,Kus5,0,0,0,,إلا أن أبلغ جلالتك على الفور.
Dialogue: 0,0:57:45.24,0:57:46.31,Default,Kus5,0,0,0,,لا يمكن أن يكون هذا.
Dialogue: 0,0:57:46.31,0:57:49.51,Default,Kus5,0,0,0,,هناك من يتهم حراسي زوراً،
Dialogue: 0,0:57:49.84,0:57:53.15,Default,Kus5,0,0,0,,لإضعاف الدفاع وإيذائي.
Dialogue: 0,0:57:53.65,0:57:54.88,Default,Kus5,0,0,0,,من أنت
Dialogue: 0,0:57:56.32,0:57:58.65,Default,Kus5,0,0,0,,هل تقصد بشخص ما؟
Dialogue: 0,0:57:58.82,0:58:02.56,Default,Kus5,0,0,0,,أنت، قائد القوات كيم جواجيون.
Dialogue: 0,0:58:09.00,0:58:10.36,Default,Kus5,0,0,0,,أنت تتصرف هكذا،
Dialogue: 0,0:58:10.36,0:58:13.70,Default,Kus5,0,0,0,,هل تعتقد أن هذه العشائر الثلاث ستدعمك؟
Dialogue: 0,0:58:14.63,0:58:16.94,Default,Kus5,0,0,0,,هل تعتقد أن هناك ما يكفي من الخطابات اللطيفة،
Dialogue: 0,0:58:16.94,0:58:19.17,Default,Kus5,0,0,0,,لإقناعهم بالوقوف إلى جانبك؟
Dialogue: 0,0:58:20.84,0:58:22.34,Default,Kus5,0,0,0,,أنت أحمق.
Dialogue: 0,0:58:22.91,0:58:25.08,Default,Kus5,0,0,0,,حان وقت الاستيقاظ وإدراك الواقع.
Dialogue: 0,0:58:40.69,0:58:42.23,Default,Kus5,0,0,0,,يا لها من وقاحة!
Dialogue: 0,0:58:45.20,0:58:47.37,Default,Kus5,0,0,0,,كيف تجرؤ على إهانة الملك بهذه الطريقة؟
Dialogue: 0,0:58:48.03,0:58:51.34,Default,Kus5,0,0,0,,هذه خيانة وخيانة!
Dialogue: 0,0:58:51.34,0:58:53.74,Default,Kus5,0,0,0,,كم أنت مختلف يا صاحب الجلالة. اهدأ!
Dialogue: 0,0:58:53.74,0:58:56.11,Default,Kus5,0,0,0,,كيف تجرؤ على أمر الملك؟
Dialogue: 0,0:59:06.69,0:59:10.62,Default,Kus5,0,0,0,,جلالتك، يبدو أن هناك شيئًا تعتمد عليه.
Dialogue: 0,0:59:10.79,0:59:13.19,Default,Kus5,0,0,0,,مهما كان، فلن تتمكن من استخدامه،
Dialogue: 0,0:59:13.96,0:59:16.16,Default,Kus5,0,0,0,,إذا فقدت أطرافك.
Dialogue: 0,0:59:18.00,0:59:21.03,Default,Kus5,0,0,0,,سيتعين عليك أن تدفع ثمن تهورك.
Dialogue: 0,0:59:26.87,0:59:29.58,Default,Kus5,0,0,0,,سوف يتم قطع رأسك بسبب جرائمك.
Dialogue: 0,0:59:34.31,0:59:37.45,Default,Kus5,0,0,0,,جلالتك، علينا أن نتبع القوانين العسكرية.
Dialogue: 0,0:59:38.12,0:59:39.49,Default,Kus5,0,0,0,,إنهم مذنبون بالخيانة، مما يعني
Dialogue: 0,0:59:39.49,0:59:41.39,Default,Kus5,0,0,0,,هذه القضية خارج نطاق اختصاص الحرس الملكي.
Dialogue: 0,0:59:41.39,0:59:43.32,Default,Kus5,0,0,0,,سيتعامل قسم المباحث مع هذه المشكلة!
Dialogue: 0,0:59:48.86,0:59:49.86,Default,Kus5,0,0,0,,جلالتك!
Dialogue: 0,0:59:51.23,0:59:52.83,Default,Kus5,0,0,0,,سيتولى الحرس الملكي هذا الأمر!
Dialogue: 0,0:59:52.83,0:59:55.20,Default,Kus5,0,0,0,,-نحتج يا صاحب الجلالة!\N-نحتج يا صاحب الجلالة!
Dialogue: 0,0:59:55.64,0:59:59.34,Default,Kus5,0,0,0,,كان رئيس الحرس الملكي يعرف من هم حقاً!
Dialogue: 0,0:59:59.47,1:00:02.51,Default,Kus5,0,0,0,,ربما كل من في الحرس خونة.
Dialogue: 0,1:00:02.51,1:00:04.81,Default,Kus5,0,0,0,,لا يمكن السماح للحرس الملكي بالتحقيق في ما
Dialogue: 0,1:00:04.81,1:00:05.91,Default,Kus5,0,0,0,,ماذا حدث بداخلها!
Dialogue: 0,1:00:05.91,1:00:08.75,Default,Kus5,0,0,0,,-غير قرارك يا صاحب الجلالة!\N-غير قرارك يا صاحب الجلالة!
Dialogue: 0,1:00:08.75,1:00:11.18,Default,Kus5,0,0,0,,غير قرارك يا صاحب الجلالة!
Dialogue: 0,1:00:23.00,1:00:24.56,Default,Kus5,0,0,0,,يمكننا حل الحرس الملكي
Dialogue: 0,1:00:24.56,1:00:27.33,Default,Kus5,0,0,0,,والحكم على قائدها.
Dialogue: 0,1:00:27.33,1:00:28.37,Default,Kus5,0,0,0,,ومع ذلك,
Dialogue: 0,1:00:30.04,1:00:32.87,Default,Kus5,0,0,0,,إذا طلبت مني معاقبة المجرمين،
Dialogue: 0,1:00:33.37,1:00:37.44,Default,Kus5,0,0,0,,سأعتبر هذا بمثابة وعد بعدم القيام بأي شيء آخر
Dialogue: 0,1:00:38.61,1:00:40.65,Default,Kus5,0,0,0,,وسأتوقف عند هذا الحد.
Dialogue: 0,1:01:04.47,1:01:05.67,Default,Kus5,0,0,0,,مهما فعلت،
Dialogue: 0,1:01:07.91,1:01:09.11,Default,Kus5,0,0,0,,لن يتغير شيء.
Dialogue: 0,1:01:12.35,1:01:14.08,Default,Kus5,0,0,0,,ماذا تتمنى يا صاحب الجلالة؟
Dialogue: 0,1:01:26.66,1:01:27.73,Default,Kus5,0,0,0,,حسنًا.
Dialogue: 0,1:01:32.67,1:01:34.13,Default,Kus5,0,0,0,,أعطي هذه الحالة
Dialogue: 0,1:01:38.30,1:01:39.44,Default,Kus5,0,0,0,,بين يديك.
Dialogue: 0,1:04:01.68,1:04:04.28,Default,Kus5,0,0,0,,سيد الأرض
Dialogue: 0,1:04:05.42,1:04:08.65,Default,Kus5,0,0,0,,وسيد الحصاد أدعوك.
Dialogue: 0,1:04:10.22,1:04:12.26,Default,Kus5,0,0,0,,بارك لنا،
Dialogue: 0,1:04:13.03,1:04:16.73,Default,Kus5,0,0,0,,عسى أن تكون المحاصيل غنية بالحصاد.
Dialogue: 0,1:04:17.60,1:04:21.10,Default,Kus5,0,0,0,,رحمتك
Dialogue: 0,1:04:25.34,1:04:27.64,Default,Kus5,0,0,0,,لمساعدة شعب هذه الأرض\N وأتمنى ألا يعرفوا الجوع إلى الأبد.
Dialogue: 0,1:04:36.82,1:04:37.85,Default,Kus5,0,0,0,,من فضلك.
Dialogue: 0,1:05:29.14,1:05:31.07,Default,Kus5,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,1:05:47.05,1:05:51.12,Default,Kus5,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:06:06.91,1:06:09.48,Default,Kus5,0,0,0,,أدى الانفجار إلى إتلاف سمعه.
Dialogue: 0,1:06:09.48,1:06:10.54,Default,Kus5,0,0,0,,أوه، لا.
Dialogue: 0,1:06:10.94,1:06:13.15,Default,Kus5,0,0,0,,-لن تكون هناك أية مشاكل؟\N-بالطبع.
Dialogue: 0,1:06:13.15,1:06:14.58,Default,Kus5,0,0,0,,لا أحد وراء هذا؟
Dialogue: 0,1:06:14.58,1:06:16.62,Default,Kus5,0,0,0,,قررت البقاء على قيد الحياة،
Dialogue: 0,1:06:16.62,1:06:17.82,Default,Kus5,0,0,0,,فلا تموت.
Dialogue: 0,1:06:17.82,1:06:19.32,Default,Kus5,0,0,0,,تعافي وكأن شيئاً لم يحدث،
Dialogue: 0,1:06:19.32,1:06:20.59,Default,Kus5,0,0,0,,ويمكنني طعنك في الظهر.
Dialogue: 0,1:06:20.59,1:06:23.22,Default,Kus5,0,0,0,,العدو الداخلي فظيع دائمًا.
Dialogue: 0,1:06:23.22,1:06:25.26,Default,Kus5,0,0,0,,جلالتك! صاحب الجلالة...{\i}
Dialogue: 0,1:06:25.93,1:06:27.39,Default,Kus5,0,0,0,,صاحب الجلالة...
Dialogue: 0,1:06:27.69,1:06:30.70,Default,Kus5,0,0,0,,أقترح عليك إيقاف الوصاية.
Dialogue: 0,1:06:30.70,1:06:31.76,Default,Kus5,0,0,0,,جلالتك!
Dialogue: 0,1:06:31.76,1:06:34.87,Default,Kus5,0,0,0,,كل من في هذا القصر قتلوا "كيم سو يون".
Dialogue: 0,0:50:08.18,0:50:10.18,Default,,0,0,0,,

التعليق: 0,0:53:37.22,0:53:38.78,Default,Kus5,0,0,0,,دعونا نكون قدوة للناس من خلال تقليل عدد الأطباق.
