Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.09,0:01:06.37,Default,الأناناس 1,0,0,0,,جميع الشخصيات خيالية،
Dialogue: 0,0:01:06.37,0:01:08.54,Default,الأناناس 1,0,0,0,,والأحداث المعروضة خيالية.
Dialogue: 0,0:01:10.32,0:01:13.13,Default,الأناناس 1,0,0,0,,18 حلقة
Dialogue: 0,0:01:14.74,0:01:15.81,Default,الأناناس 1,0,0,0,,انتظر!
Dialogue: 0,0:01:16.41,0:01:17.71,Default,الأناناس 1,0,0,0,,توقف!
Dialogue: 0,0:01:24.01,0:01:25.08,Default,الأناناس 1,0,0,0,,لنذهب.
Dialogue: 0,0:01:27.72,0:01:30.79,Default,الأناناس 1,0,0,0,,توقف! انتظر!
Dialogue: 0,0:01:37.09,0:01:38.13,Default,الأناناس 1,0,0,0,,لماذا؟
Dialogue: 0,0:01:47.74,0:01:49.81,Default,الأناناس 1,0,0,0,,هل جاءني الملك وأنا نائم؟
Dialogue: 0,0:01:50.41,0:01:51.68,Default,الأناناس 1,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:01:52.48,0:01:53.71,Default,الأناناس 1,0,0,0,,لم يكن حلماً.
Dialogue: 0,0:01:54.44,0:01:56.68,Default,الأناناس 1,0,0,0,,ولكن لماذا يتصرف بهذه الطريقة؟
Dialogue: 0,0:01:56.68,0:01:57.95,Default,الأناناس 1,0,0,0,,كما لو أن هناك من يطارده.
Dialogue: 0,0:01:59.28,0:02:01.42,Default,الأناناس 1,0,0,0,,دونغهاك أصبح أكثر تأثيراً.
Dialogue: 0,0:02:03.12,0:02:04.86,Default,الأناناس 1,0,0,0,,أنا أفهم، ولكن لا يزال...
Dialogue: 0,0:02:05.02,0:02:06.99,Default,الأناناس 1,0,0,0,,لا تقلق يا صاحب الجلالة.
Dialogue: 0,0:02:07.36,0:02:10.13,Default,الأناناس 1,0,0,0,,هذا صحيح، سيعود الملك قريباً جداً.
Dialogue: 0,0:02:11.23,0:02:12.26,Default,الأناناس 1,0,0,0,,حسنًا.
Dialogue: 0,0:02:13.23,0:02:15.50,Default,الأناناس 1,0,0,0,,لا بد أن يكون هناك سبب لمغادرته بهذه السرعة.
Dialogue: 0,0:02:17.67,0:02:19.44,Default,الأناناس 1,0,0,0,,تأكد من أن كل شيء على ما يرام، ثم عد.
Dialogue: 0,0:02:19.74,0:02:22.64,Default,الأناناس 1,0,0,0,,بالطبع من الأفضل أن أذهب بسرعة بدلاً من الانتظار حتى آتي لأودعه.
Dialogue: 0,0:02:23.57,0:02:25.44,Default,الأناناس 1,0,0,0,,لهذا السبب غادر دون سابق إنذار.
Dialogue: 0,0:02:36.92,0:02:39.59,Default,الأناناس 1,0,0,0,,هذا العرش الآن لديه مالك جديد.
Dialogue: 0,0:02:41.09,0:02:43.49,Default,الأناناس 1,0,0,0,,يمكنك اكتشاف ذلك على الفور.
Dialogue: 0,0:02:43.86,0:02:46.66,Default,الأناناس 1,0,0,0,,كل ذلك لأن الملكة اتخذت القرار الصحيح.
Dialogue: 0,0:02:49.00,0:02:50.10,Default,الأناناس 1,0,0,0,,الملكة؟
Dialogue: 0,0:02:50.43,0:02:52.20,Default,الأناناس 1,0,0,0,,من أجل طفلك
Dialogue: 0,0:02:52.20,0:02:54.74,Default,الأناناس 1,0,0,0,,لقد انحازت إلى العائلة، وليس إلى الملك.
Dialogue: 0,0:02:55.71,0:02:58.24,Default,الأناناس 1,0,0,0,,إذا كان الأمر كذلك فمن أجل وريث العرش
Dialogue: 0,0:02:59.88,0:03:02.35,Default,الأناناس 1,0,0,0,,سأغمض عيني عن خطايا الملكة.
Dialogue: 0,0:03:04.98,0:03:09.02,Default,الأناناس 1,0,0,0,,سأتأكد من أنه لا داعي للقلق بشأن القتال من أجل العرش بعد الآن.
Dialogue: 0,0:05:21.55,0:05:23.09,Default,الأناناس 1,0,0,0,,استسلم.
Dialogue: 0,0:06:09.03,0:06:10.40,Default,الأناناس 1,0,0,0,,أريد المزيد.
Dialogue: 0,0:06:12.37,0:06:14.37,Default,الأناناس 1,0,0,0,,ألا تأكل كثيراً؟
Dialogue: 0,0:06:14.91,0:06:17.07,Default,الأناناس 1,0,0,0,,يعتاد الإنسان على كل شيء.
Dialogue: 0,0:06:17.07,0:06:19.28,Default,الأناناس 1,0,0,0,,كان الطعام بلا طعم،
Dialogue: 0,0:06:19.28,0:06:20.64,Default,الأناناس 1,0,0,0,,لكنني الآن أحبه.
Dialogue: 0,0:06:20.78,0:06:22.45,Default,الأناناس 1,0,0,0,,بغض النظر عن مقدار ما نأكله، لا يمكننا الحصول على ما يكفي.
Dialogue: 0,0:06:22.45,0:06:24.11,Default,الأناناس 1,0,0,0,,على العكس من ذلك، الجوع يزداد سوءاً.
Dialogue: 0,0:06:25.15,0:06:26.88,Default,الأناناس 1,0,0,0,,الأمير الصغير شره.
Dialogue: 0,0:06:36.43,0:06:38.26,Default,الأناناس 1,0,0,0,,حسنًا. لن أفعل ذلك بعد الآن.
Dialogue: 0,0:06:38.26,0:06:40.70,Default,الأناناس 1,0,0,0,,كل شيء على ما يرام معي.\Nلماذا تبدو هكذا؟
Dialogue: 0,0:06:41.70,0:06:44.77,Default,الأناناس 1,0,0,0,,أنت بحاجة إلى المشي.\NIإنه جيد لعملية الهضم.
Dialogue: 0,0:06:45.87,0:06:47.17,Default,الأناناس 1,0,0,0,,لكنني سأنتهي أولاً.
Dialogue: 0,0:07:00.58,0:07:02.55,Default,الأناناس 1,0,0,0,,الطقس فظيع للغاية.
Dialogue: 0,0:07:05.69,0:07:07.46,Default,الأناناس 1,0,0,0,,أود أن ألتقط صورة وأضعها في إطار وأعلقها على الحائط.
Dialogue: 0,0:07:09.59,0:07:11.29,Default,الأناناس 1,0,0,0,,لم يفت الأوان بعد لحل المشكلة
Dialogue: 0,0:07:11.60,0:07:13.23,Default,الأناناس 1,0,0,0,,كله سوء فهم.
Dialogue: 0,0:07:14.30,0:07:15.87,Default,الأناناس 1,0,0,0,,دعونا نعيش بالطريقة التي أردتها.
Dialogue: 0,0:07:17.80,0:07:18.87,Default,الأناناس 1,0,0,0,,التباعد الاجتماعي.
Dialogue: 0,0:07:20.27,0:07:22.64,Default,الأناناس 1,0,0,0,,أنت خصمي الحقيقي.
Dialogue: 0,0:07:23.97,0:07:27.48,Default,الأناناس 1,0,0,0,,كنت قلقة، لكنني الآن وجدت طريقة للخروج.
Dialogue: 0,0:07:27.48,0:07:28.91,Default,الأناناس 1,0,0,0,,لذا لا تحبني.
Dialogue: 0,0:07:28.91,0:07:30.78,Default,الأناناس 1,0,0,0,,لكنني مازلت أحبه.
Dialogue: 0,0:07:30.78,0:07:33.85,Default,الأناناس 1,0,0,0,,وسأحبك، دعك من ذلك
Dialogue: 0,0:07:34.62,0:07:36.12,Default,الأناناس 1,0,0,0,,كل عيوب العالم.
Dialogue: 0,0:07:38.19,0:07:39.72,Default,الأناناس 1,0,0,0,,لا يسعني إلا أن أفكر فيه!
Dialogue: 0,0:07:39.96,0:07:41.56,Default,الأناناس 1,0,0,0,,مكان رهيب! دعونا نغادر بسرعة!
Dialogue: 0,0:07:41.56,0:07:42.59,Default,الأناناس 1,0,0,0,,-جلالتك!\N-جلالتك!
Dialogue: 0,0:07:46.16,0:07:47.46,Default,الأناناس 1,0,0,0,,بالكاد نجحت.
Dialogue: 0,0:07:48.10,0:07:50.20,Default,الأناناس 1,0,0,0,,ليست بحيرة، بل هاوية من الذكريات.
Dialogue: 0,0:08:02.18,0:08:05.25,Default,الأناناس 1,0,0,0,,فاليوم هو يومنا الأول.
Dialogue: 0,0:08:05.95,0:08:07.28,Default,الأناناس 1,0,0,0,,أقترح التحالف.
Dialogue: 0,0:08:10.59,0:08:11.76,Default,الأناناس 1,0,0,0,,حسنًا.
Dialogue: 0,0:08:13.92,0:08:17.13,Default,الأناناس 1,0,0,0,,لا يوجد تباعد اجتماعي من الآن فصاعداً.
Dialogue: 0,0:08:26.44,0:08:27.90,Default,الأناناس 1,0,0,0,,يا إلهي.
Dialogue: 0,0:08:28.74,0:08:31.37,Default,الأناناس 1,0,0,0,,نعم، هذا القصر بأكمله هو ذكرى واحدة متواصلة.
Dialogue: 0,0:08:33.78,0:08:35.55,Default,الأناناس 1,0,0,0,,لماذا يوجد عدد قليل جداً من الناس؟
Dialogue: 0,0:08:36.45,0:08:38.25,Default,الأناناس 1,0,0,0,,منذ متى كان القصر بهذا الحجم؟
Dialogue: 0,0:08:46.65,0:08:49.95,Default,الأناناس 1,0,0,0,,الذكريات ترد
Dialogue: 0,0:08:52.90,0:08:54.26,Default,الأناناس 1,0,0,0,,جلالتك.
Dialogue: 0,0:09:01.27,0:09:04.74,Default,الأناناس 1,0,0,0,,صاحب الجلالة،\Nلقد أتى إليك وزير الحرب.
Dialogue: 0,0:09:07.21,0:09:09.28,Default,الأناناس 1,0,0,0,,لم أجدك في غرفتك.
Dialogue: 0,0:09:12.15,0:09:14.28,Default,الأناناس 1,0,0,0,,هل حدث شيء للملك؟
Dialogue: 0,0:09:14.68,0:09:15.75,Default,الأناناس 1,0,0,0,,لا.
Dialogue: 0,0:09:20.96,0:09:23.26,Default,الأناناس 1,0,0,0,,أنت تنزف!
Dialogue: 0,0:09:25.40,0:09:26.73,Default,الأناناس 1,0,0,0,,تؤذي نفسك في مكان ما؟
Dialogue: 0,0:09:27.06,0:09:30.53,Default,الأناناس 1,0,0,0,,مجرد إصابة بسيطة\Nبعد التدريب.
Dialogue: 0,0:09:31.84,0:09:34.77,Default,الأناناس 1,0,0,0,,أعلم أن الوقت متأخر،\Nلكنني جئت لأهنئك على حملك.
Dialogue: 0,0:09:36.64,0:09:37.84,Default,الأناناس 1,0,0,0,,شكرًا لك.
Dialogue: 0,0:09:37.84,0:09:41.34,Default,الأناناس 1,0,0,0,,لا تفكر في الانضمام إلى العشيرة مجددًا
Dialogue: 0,0:09:41.34,0:09:44.05,Default,الأناناس 1,0,0,0,,من أجل رفاهية طفلك؟
Dialogue: 0,0:09:45.35,0:09:47.22,Default,الأناناس 1,0,0,0,,أعتقد أننا ناقشنا كل شيء في المرة الماضية.
Dialogue: 0,0:09:47.65,0:09:49.79,Default,الأناناس 1,0,0,0,,لا يهمني أنك تخليت عني.
Dialogue: 0,0:09:50.72,0:09:52.86,Default,الأناناس 1,0,0,0,,ما زلت لن أتركك تمامًا دون مساعدة.
Dialogue: 0,0:09:53.09,0:09:54.32,Default,الأناناس 1,0,0,0,,أنت ونفسك
Dialogue: 0,0:09:55.13,0:09:57.99,Default,الأناناس 1,0,0,0,,أنت تعلم أنك لا تستطيع التأقلم بمفردك في القصر.
Dialogue: 0,0:09:59.63,0:10:02.90,Default,الأناناس 1,0,0,0,,شكرًا لك على النصيحة، لكنني لست وحدي.
Dialogue: 0,0:10:03.73,0:10:05.27,Default,الأناناس 1,0,0,0,,وأنت تعرف هذا جيداً.
Dialogue: 0,0:10:06.27,0:10:08.44,Default,الأناناس 1,0,0,0,,إذا كنت بحاجة إلى مساعدة،
Dialogue: 0,0:10:08.44,0:10:10.31,Default,الأناناس 1,0,0,0,,أنا مستعد دائماً لمد يدي.
Dialogue: 0,0:10:10.57,0:10:12.48,Default,الأناناس 1,0,0,0,,لك ولطفلك
Dialogue: 0,0:10:13.01,0:10:15.45,Default,الأناناس 1,0,0,0,,سأفعل أي شيء.
Dialogue: 0,0:10:28.73,0:10:31.83,Default,الأناناس 1,0,0,0,,في الآونة الأخيرة\Nتزايد السخط الشعبي.
Dialogue: 0,0:10:32.23,0:10:35.13,Default,الأناناس 1,0,0,0,,تصلني أخبار عن انتفاضة الفلاحين،
Dialogue: 0,0:10:35.63,0:10:39.27,Default,الأناناس 1,0,0,0,,أنوي أن أقوم شخصياً\Nبالتحقيق في الوضع في البلاد.
Dialogue: 0,0:10:40.04,0:10:43.27,Default,الأناناس 1,0,0,0,,كل ما يتعلق بالناس مهم، وأثناء عدم وجودي هنا،
Dialogue: 0,0:10:44.07,0:10:46.64,Default,الأناناس 1,0,0,0,,عليك أن تطيع\Nأوامر الملكة الأرملة.
Dialogue: 0,0:10:46.94,0:10:50.45,Default,الأناناس 1,0,0,0,,هذا أمر الملك.
Dialogue: 0,0:10:55.45,0:10:59.69,Default,الأناناس 1,0,0,0,,بما أنني الآن أستبدل الملك في منصبه، سأستبدل العديد من المسؤولين،
Dialogue: 0,0:10:59.92,0:11:02.19,Default,الأناناس 1,0,0,0,,لتنفيذ أمره بشكل صحيح.
Dialogue: 0,0:11:02.46,0:11:03.93,Default,الأناناس 1,0,0,0,,سيعود كيم سيوكيون
Dialogue: 0,0:11:03.93,0:11:05.43,Default,الأناناس 1,0,0,0,,إلى مشاركتك،
Dialogue: 0,0:11:05.80,0:11:07.66,Default,الأناناس 1,0,0,0,,ووزير الحرب السابق كيم تشانغهيوب
Dialogue: 0,0:11:07.66,0:11:09.57,Default,الأناناس 1,0,0,0,,سيأخذ مكان رئيس الحرس الملكي.
Dialogue: 0,0:11:10.03,0:11:12.20,Default,الأناناس 1,0,0,0,,الأمير يونبيونغ، الذي يشغل هذا المنصب،
Dialogue: 0,0:11:12.20,0:11:15.31,Default,الأناناس 1,0,0,0,,ركز على واجباته كرئيس لإيجيونغتشون.
Dialogue: 0,0:11:37.96,0:11:40.43,Default,الأناناس 1,0,0,0,,لقد بدأ الملك في طريق صعب.
Dialogue: 0,0:11:41.26,0:11:45.07,Default,الأناناس 1,0,0,0,,إذا حاول أحدهم\Nتشويه سمعته،
Dialogue: 0,0:11:45.70,0:11:49.61,Default,الأناناس 1,0,0,0,,يجب على هذا الشخص\Nالخوف على سلامة لغته.
Dialogue: 0,0:12:24.21,0:12:25.38,Default,الأناناس 1,0,0,0,,عزيزتي,
Dialogue: 0,0:12:26.48,0:12:27.74,Default,الأناناس 1,0,0,0,,أنت لطيف جدًا.
Dialogue: 0,0:12:30.55,0:12:31.95,Default,الأناناس 1,0,0,0,,في هذه الحياة
Dialogue: 0,0:12:32.25,0:12:33.65,Default,الأناناس 1,0,0,0,,لا تحرم نفسك من أي شيء.
Dialogue: 0,0:12:41.09,0:12:44.53,Default,الأناناس 1,0,0,0,,الرسالة المكتوبة بخط اليد هي مجرد شيء\Nلتهدئة القلب المتمرد.
Dialogue: 0,0:12:50.47,0:12:52.97,Default,الأناناس 1,0,0,0,,عزيزتي، هل تفتقدين أبي أيضاً؟
Dialogue: 0,0:12:53.24,0:12:55.07,Default,الأناناس 1,0,0,0,,قل: "أبي، عد قريبًا!"
Dialogue: 0,0:12:57.04,0:12:59.64,Default,الأناناس 1,0,0,0,,هل هو مثير حقاً؟ هل هذه هي الطريقة التي تجيبني بها؟
Dialogue: 0,0:13:00.71,0:13:02.51,Default,الأناناس 1,0,0,0,,أليست الثمار تتحرك مبكراً؟
Dialogue: 0,0:13:02.51,0:13:03.71,Default,الأناناس 1,0,0,0,,مبكر جداً.
Dialogue: 0,0:13:05.75,0:13:07.08,Default,الأناناس 1,0,0,0,,هل الطفل عبقري؟
Dialogue: 0,0:13:07.62,0:13:10.32,Default,الأناناس 1,0,0,0,,يا إلهي! سوف أنجب عبقري!
Dialogue: 0,0:13:12.26,0:13:14.72,Default,الأناناس 1,0,0,0,,ولماذا أنا سعيدة جداً؟
Dialogue: 0,0:13:20.06,0:13:21.10,Default,الأناناس 1,0,0,0,,جلالتك.
Dialogue: 0,0:13:21.93,0:13:25.50,Default,الأناناس 1,0,0,0,,هناك شيء يخبرني\Nأن هذا سيكون كابوساً.
Dialogue: 0,0:13:25.84,0:13:27.60,Default,الأناناس 1,0,0,0,,سأكون أباً سيئاً،
Dialogue: 0,0:13:27.60,0:13:30.37,Default,الأناناس 1,0,0,0,,تقاطع رهيب بين أب محب وأم مجنونة.
Dialogue: 0,0:13:30.64,0:13:32.34,Default,الأناناس 1,0,0,0,,طفلك ثمين.
Dialogue: 0,0:13:32.34,0:13:34.21,Default,الأناناس 1,0,0,0,,ليس هناك الكثير من الاهتمام على الإطلاق.
Dialogue: 0,0:13:34.51,0:13:38.18,Default,الأناناس 1,0,0,0,,أنا متأكد من أن الطفل سيكون مثلك تماماً...
Dialogue: 0,0:13:38.92,0:13:40.88,Default,الأناناس 1,0,0,0,,ما نوع الفظائع التي تتحدث عنها؟
Dialogue: 0,0:13:41.15,0:13:42.22,Default,الأناناس 1,0,0,0,,ماذا؟
Dialogue: 0,0:13:43.02,0:13:46.82,Default,الأناناس 1,0,0,0,,لماذا إذا كان طفلي مثلي، فهل هذا فظيع؟
Dialogue: 0,0:13:46.82,0:13:49.29,Default,الأناناس 1,0,0,0,,حان وقت تناول الدواء يا صاحب الجلالة.
Dialogue: 0,0:13:56.87,0:13:58.47,Default,الأناناس 1,0,0,0,,إلى الأسفل.
Dialogue: 0,0:13:59.07,0:14:00.80,Default,الأناناس 1,0,0,0,,هذا كل شيء.
Dialogue: 0,0:14:01.57,0:14:03.71,Default,الأناناس 1,0,0,0,,أطلقت صاحبة الجلالة على الطفلة لقبها.
Dialogue: 0,0:14:07.98,0:14:09.78,Default,الأناناس 1,0,0,0,,هذا كل شيء.
Dialogue: 0,0:14:19.89,0:14:21.99,Default,الأناناس 1,0,0,0,,وماذا خلطوا في مغليهم؟
Dialogue: 0,0:14:23.29,0:14:26.63,Default,الأناناس 1,0,0,0,,هذا الدواء بالتأكيد ضد الإجهاض، وليس للخرف؟
Dialogue: 0,0:14:29.40,0:14:32.34,Default,الأناناس 1,0,0,0,,رعب! ما هو نوع من الهجوم العقلي هذا؟\Nلماذا أظل أفكر فيه؟
Dialogue: 0,0:14:34.20,0:14:36.54,Default,الأناناس 1,0,0,0,,كل شيء في القصر يذكره.
Dialogue: 0,0:14:52.89,0:14:56.06,Default,الأناناس 1,0,0,0,,ملكنا هو تشيولجونغ،\Nحيث أقوم بتطريز CJ.
Dialogue: 0,0:14:56.43,0:14:59.00,Default,الأناناس 1,0,0,0,,هل طرزت هذا حقاً في ليلة واحدة فقط؟
Dialogue: 0,0:14:59.16,0:15:01.16,Default,الأناناس 1,0,0,0,,كان دائماً\Nما يجده الجميع في التطريز مثيراً للاهتمام.
Dialogue: 0,0:15:01.16,0:15:03.40,Default,الأناناس 1,0,0,0,,بينما يداي مشغولتان، يكون رأسي فارغاً من الأفكار.
Dialogue: 0,0:15:03.40,0:15:04.47,Default,الأناناس 1,0,0,0,,أعجبني ذلك.
Dialogue: 0,0:15:05.03,0:15:06.84,Default,الأناناس 1,0,0,0,,أنت حرفية حقيقية.
Dialogue: 0,0:15:07.20,0:15:08.71,Default,الأناناس 1,0,0,0,,جميلة جداً.
Dialogue: 0,0:15:08.71,0:15:11.07,Default,الأناناس 1,0,0,0,,هذا حرير من جينجو، جيونج سانج نام دو.
Dialogue: 0,0:15:11.07,0:15:12.81,Default,الأناناس 1,0,0,0,,كنت أعتقد في الأيام العاصفة
Dialogue: 0,0:15:12.81,0:15:14.64,Default,الأناناس 1,0,0,0,,أفضل شيء ترتديه هو هذا الوشاح.
Dialogue: 0,0:15:14.98,0:15:17.85,Default,الأناناس 1,0,0,0,,أنا متأكد من أن صاحب الجلالة\Nسوف تعجبه هديتك.
Dialogue: 0,0:15:18.95,0:15:21.15,Default,الأناناس 1,0,0,0,,هذا وشاح آخر لي.
Dialogue: 0,0:15:22.22,0:15:24.52,Default,الأناناس 1,0,0,0,,كل العضلات تتيبّس من الجلوس لفترة طويلة.
Dialogue: 0,0:15:25.66,0:15:27.92,Default,الأناناس 1,0,0,0,,هل ترغب في لعب شيء ممتع؟
Dialogue: 0,0:15:28.49,0:15:29.89,Default,الأناناس 1,0,0,0,,-بالطبع يا صاحب الجلالة!\N-بالطبع يا صاحب الجلالة!
Dialogue: 0,0:15:30.89,0:15:32.13,Default,الأناناس 1,0,0,0,,رئيس الخصي
Dialogue: 0,0:15:37.23,0:15:38.67,Default,الأناناس 1,0,0,0,,أعلم! ملِك!
Dialogue: 0,0:15:42.14,0:15:43.41,Default,Spilyk2,0,0,0,,هناك.
Dialogue: 0,0:15:43.87,0:15:44.91,Default,Spilik2,0,0,0,,رئيس الخصي؟
Dialogue: 0,0:15:45.58,0:15:48.11,Default,Spikyulka2,0,0,0,,حسناً، نعم، هناك رئيس خصيان يخدم الملك.
Dialogue: 0,0:15:48.58,0:15:50.78,Default,Spikyulka2,0,0,0,,نعم، هذا هو الجواب - رئيس الخصي.
Dialogue: 0,0:15:54.15,0:15:56.39,Default,Spilik2,0,0,0,,إذًا، هذا يعني؟ لم تحصل عليه.
Dialogue: 0,0:15:57.09,0:15:58.09,Default,Spilik2,0,0,0,,التالي.
Dialogue: 0,0:15:58.45,0:16:00.69,Default,Spilik2,0,0,0,,النمر.
Dialogue: 0,0:16:00.69,0:16:01.72,Default,Spilik2,0,0,0,,ملك!
Dialogue: 0,0:16:01.72,0:16:02.79,Default,Spillit2,0,0,0,,قرد.
Dialogue: 0,0:16:02.79,0:16:03.79,Default,Spilik2,0,0,0,,ملك.
Dialogue: 0,0:16:03.79,0:16:04.96,Default,Spillit2,0,0,0,,أرنب.
Dialogue: 0,0:16:04.96,0:16:06.00,Default,Spilik2,0,0,0,,ملك.
Dialogue: 0,0:16:06.00,0:16:08.23,Default,Spillie2,0,0,0,,كلب.
Dialogue: 0,0:16:11.23,0:16:13.30,Default,Spilyk2,0,0,0,,هذا سهل للغاية.
Dialogue: 0,0:16:13.30,0:16:15.41,Default,Spilik2,0,0,0,,ينتحب مثل الجرو المهجور.
Dialogue: 0,0:16:15.91,0:16:16.94,Default,Spilik2,0,0,0,,ملك؟
Dialogue: 0,0:16:18.88,0:16:19.91,Default,Spilik2,0,0,0,,جلالتك.
Dialogue: 0,0:16:20.88,0:16:23.51,Default,Spikyulka2,0,0,0,,هل تفتقدينه كثيراً؟
Dialogue: 0,0:16:24.71,0:16:26.78,Default,Spilik2,0,0,0,,علاقات عالية.
Dialogue: 0,0:16:29.42,0:16:31.62,Default,Spilik2,0,0,0,,لا شيء من هذا القبيل. لا تبالغ.
Dialogue: 0,0:16:31.89,0:16:32.96,Default,Spikyulka2,0,0,0,,يا رب، ماذا تفعل؟
Dialogue: 0,0:16:33.52,0:16:36.13,Default,Spilik2,0,0,0,,بطريقةٍ ما، الأمر ليس ممتعًا. أعطني إبرة وخيط.
Dialogue: 0,0:16:41.93,0:16:44.23,Default,Spilik2,0,0,0,,الملكة، هل أنت بخير؟
Dialogue: 0,0:16:44.87,0:16:45.87,Default,Spilik2,0,0,0,,لا.
Dialogue: 0,0:16:47.87,0:16:49.14,Default,Spilik2,0,0,0,,إطلاقاً.
Dialogue: 0,0:16:50.01,0:16:51.61,Default,Spilik2,0,0,0,,هذا مؤلم جداً.
Dialogue: 0,0:16:53.01,0:16:55.41,Default,Spikyulka2,0,0,0,,كيف يمكن أن تؤلمك إبرة رفيعة إلى هذا الحد؟
Dialogue: 0,0:16:58.51,0:17:00.42,Default,Spilik2,0,0,0,,كل هذا بسبب الهرمونات.
Dialogue: 0,0:17:01.25,0:17:02.35,Default,Spilyk2,0,0,0,,بسبب الحمل
Dialogue: 0,0:17:02.35,0:17:04.62,Default,Spilik2,0,0,0,,أنزعج بسهولة. ولدي الكثير من المخاوف.
Dialogue: 0,0:17:05.02,0:17:06.42,Default,Spikyulka2,0,0,0,,لذا فأنا أزأر باستمرار.
Dialogue: 0,0:17:07.46,0:17:09.59,Default,Spilik2,0,0,0,,هذا ليس أنا.
Dialogue: 0,0:17:10.43,0:17:11.96,Default,Spilik2,0,0,0,,هذه هرمونات.
Dialogue: 0,0:17:14.56,0:17:18.30,Default,Spilik2,0,0,0,,قلبي يؤلمني كثيراً.
Dialogue: 0,0:17:21.30,0:17:25.44,Default,Spikyulka2,0,0,0,,كما لو أن إبرة وخزته.
Dialogue: 0,0:17:25.88,0:17:27.01,Default,Spilik2,0,0,0,,جلالتك.
Dialogue: 0,0:17:31.11,0:17:33.15,Default,Spilik2,0,0,0,,أوه، لا.
Dialogue: 0,0:17:34.82,0:17:36.45,Default,Spikyulka2,0,0,0,,ما خطبي؟
Dialogue: 0,0:17:39.72,0:17:41.62,Default,Silk2,0,0,0,,ما زلنا نبحث عن الجثة.
Dialogue: 0,0:17:42.16,0:17:43.59,Default,Spikyulka2,0,0,0,,من فضلك أعطني المزيد من الوقت.
Dialogue: 0,0:17:43.79,0:17:45.03,Default,Spilik2,0,0,0,,لا أستطيع الانتظار.
Dialogue: 0,0:17:46.10,0:17:49.40,Default,Spikyulka2,0,0,0,,هذا سبب إضافي للإسراع، في حال كان الملك على قيد الحياة.
Dialogue: 0,0:17:50.50,0:17:53.00,Default,Spilik2,0,0,0,,سأعلن المصير الذي حل بالملك. استعد.
Dialogue: 0,0:17:54.50,0:17:55.57,Default,Spilyk2,0,0,0,,نعم.
Dialogue: 0,0:17:58.57,0:18:00.04,Default,Spilik2,0,0,0,,الآن أنا مستعد.
Dialogue: 0,0:18:00.44,0:18:02.31,Default,Spilik2,0,0,0,,بعض الإبر لن تجعلني أبكي بعد الآن.
Dialogue: 0,0:18:04.11,0:18:05.21,Default,Spilik2,0,0,0,,يا له من كابوس!
Dialogue: 0,0:18:05.95,0:18:07.65,Default,Spilik2,0,0,0,,-جلالتك.\N-هذا أخافني.
Dialogue: 0,0:18:07.65,0:18:09.35,Default,Spikyulka2,0,0,0,,كنت على وشك الإجهاض.
Dialogue: 0,0:18:09.35,0:18:11.25,Default,Spilyk2,0,0,0,,هل يمكنك قول شيء كهذا؟
Dialogue: 0,0:18:14.12,0:18:15.16,Default,Spillie2,0,0,0,,الملكة.
Dialogue: 0,0:18:16.89,0:18:18.26,Default,Spilik2,0,0,0,,ما الأمر؟ أنت تخيفني.
Dialogue: 0,0:18:21.76,0:18:23.07,Default,Spikyulka2,0,0,0,,هل عانى الملك؟
Dialogue: 0,0:18:25.54,0:18:27.27,Default,Spilik2,0,0,0,,صاحب الجلالة...
Dialogue: 0,0:18:29.37,0:18:31.81,Default,Spilik2,0,0,0,,ملك
Dialogue: 0,0:18:32.28,0:18:35.98,Default,Spikyulka2,0,0,0,,غادرت هذا العالم.
Dialogue: 0,0:18:53.03,0:18:57.20,Default,Spikyulka2,0,0,0,,وإذا لم أنم تلك الليلة؟
Dialogue: 0,0:18:59.34,0:19:00.44,Default,Spilik2,0,0,0,,ملك
Dialogue: 0,0:19:03.01,0:19:05.07,Default,Spikyulka2,0,0,0,,غادرت هذا العالم.
Dialogue: 0,0:19:13.52,0:19:16.42,Default,Spikyulka2,0,0,0,,ماذا لو طلبت منك البقاء؟
Dialogue: 0,0:19:17.89,0:19:21.12,Default,Silk2,0,0,0,,يا صاحب الجلالة، عد إلينا!
Dialogue: 0,0:19:22.33,0:19:25.93,Default,Silk2,0,0,0,,يا صاحب الجلالة، عد إلينا!
Dialogue: 0,0:19:28.13,0:19:31.67,Default,Silk2,0,0,0,,يا صاحب الجلالة، عد إلينا!
Dialogue: 0,0:19:32.57,0:19:35.77,Default,Spilik2,0,0,0,,لو أنني لم أصل إلى جوسون قط
Dialogue: 0,0:19:37.14,0:19:38.91,Default,Spilyk2,0,0,0,,وما كنا لنلتقي؟
Dialogue: 0,0:19:40.28,0:19:43.28,Default,Spilik2,0,0,0,,ستظل على قيد الحياة.
Dialogue: 0,0:19:43.28,0:19:46.58,Default,Spilyk2,0,0,0,,قبل خمسة أيام من اعتلاء العرش
Dialogue: 0,0:19:46.58,0:19:48.18,Default,Spilik2,0,0,0,,العودة؟
Dialogue: 0,0:19:48.68,0:19:50.52,Default,Spikyulka2,0,0,0,,هل من الممكن أن نطلب من شخص ميت أن يعود؟
Dialogue: 0,0:19:50.52,0:19:52.99,Default,Spilik2,0,0,0,,يا له من طلب رهيب.
Dialogue: 0,0:19:53.42,0:19:55.66,Default,Spikyulka2,0,0,0,,ولم يتم العثور على الجثة بعد.
Dialogue: 0,0:19:55.66,0:19:58.49,Default,Spikyulka2,0,0,0,,الصرخة التي تطلب مني العودة تجعل شعري يقف حتى النهاية.
Dialogue: 0,0:19:59.10,0:20:02.23,Default,Silk2,0,0,0,,لو كان بوسعي لتوجت ملكاً جديداً.
Dialogue: 0,0:20:02.40,0:20:04.23,Default,Spilyk2,0,0,0,,ولكن إذا لم أتبع التقاليد
Dialogue: 0,0:20:04.23,0:20:06.14,Default,Spikyulka2,0,0,0,,وانتظر قيامة الملك المتوفى،
Dialogue: 0,0:20:06.14,0:20:09.44,Default,Spikyulka2,0,0,0,,أنا متأكد من أن هذا سيأتي بنتائج عكسية عليّ ويفسد كل خططي السياسية.
Dialogue: 0,0:20:09.44,0:20:11.47,Default,Spilik2,0,0,0,,حتى لو كان الملك حياً،
Dialogue: 0,0:20:11.87,0:20:13.94,Default,Spikyulka2,0,0,0,,لن يتمكن من العودة إلى القصر.
Dialogue: 0,0:20:15.41,0:20:16.95,Default,Spikyulka2,0,0,0,,أغلقت كل البوابات
Dialogue: 0,0:20:16.95,0:20:18.65,Default,Spilyk2,0,0,0,,حتى التتويج الجديد.
Dialogue: 0,0:20:19.28,0:20:20.28,Default,Spilik2,0,0,0,,نعم.
Dialogue: 0,0:20:20.62,0:20:23.45,Default,Spikyulka2,0,0,0,,إذا تمكنا من إجراء التتويج خلال خمسة أيام،
Dialogue: 0,0:20:24.49,0:20:26.16,Default,Spikyulka2,0,0,0,,لن يصبح ملكاً بعد الآن.
Dialogue: 0,0:20:26.59,0:20:28.49,Default,Spikyulka2,0,0,0,,إذا قتلناه، فلن يعد ذلك خيانة.
Dialogue: 0,0:20:35.87,0:20:38.40,Default,Silk2,0,0,0,,كم من الوقت يجب أن أنتظر حتى تعود الملكة إلى رشدها؟
Dialogue: 0,0:20:39.87,0:20:42.64,Default,Silk2,0,0,0,,ألا تريد حقًا لم شملها مع العشيرة؟
Dialogue: 0,0:20:42.64,0:20:45.51,Default,Spikyulka2,0,0,0,,سأخبرها أن تستعد وتزورك
Dialogue: 0,0:20:45.51,0:20:46.98,Default,Spilik2,0,0,0,,في أسرع وقت ممكن.
Dialogue: 0,0:21:08.20,0:21:10.70,Default,Spilyk2,0,0,0,,مذكرات الحمل
Dialogue: 0,0:21:14.87,0:21:17.01,Default,Spikyulka2,0,0,0,,ولماذا هذا مطلوب الآن،
Dialogue: 0,0:21:20.28,0:21:21.54,Default,Spilik2,0,0,0,,عندما لا تكون هنا؟
Dialogue: 0,0:21:46.80,0:21:47.97,Default,Spikyulka2,0,0,0,,القوة تُشترى بالمال.
Dialogue: 0,0:21:56.95,0:21:57.98,Default,Spilik2,0,0,0,,طفلي.
Dialogue: 0,0:21:58.58,0:22:01.08,Default,Spillit2,0,0,0,,لا تتحسس من رائحة الطعام.
Dialogue: 0,0:22:01.25,0:22:03.32,Default,Spikyulka2,0,0,0,,لا تعقد حياة أمك الجميلة.
Dialogue: 0,0:22:04.99,0:22:07.16,Default,Spikyulka2,0,0,0,,اصمت بقدر ما تريد خلال اليوم.
Dialogue: 0,0:22:07.49,0:22:11.09,Default,Spikyulka2,0,0,0,,ولكن عندما تريد والدتك النوم، توقف.
Dialogue: 0,0:22:12.80,0:22:14.56,Default,Spilyk2,0,0,0,,عندما يحين وقت الخروج إلى العالم،
Dialogue: 0,0:22:14.56,0:22:16.83,Default,Spilyk2,0,0,0,,اخرج بسرعة،
Dialogue: 0,0:22:16.83,0:22:19.10,Default,Spikyulka2,0,0,0,,لا تجعل والدتك تعاني كثيرًا.
Dialogue: 0,0:22:20.77,0:22:24.47,Default,Spikyulka2,0,0,0,,أهم شيء هو أن تأتي إلى العالم بصحة جيدة.
Dialogue: 0,0:22:27.08,0:22:31.98,Default,Spikyulka2,0,0,0,,إنني أتطلع حقًا إلى اليوم الذي سنلتقي فيه.
Dialogue: 0,0:22:38.92,0:22:41.02,Default,Spilyk2,0,0,0,,أعدك بأن أكون بجانبك،
Dialogue: 0,0:22:41.02,0:22:43.16,Default,Spikyulka2,0,0,0,,عندما تلتقط أنفاسك الأولى في هذا العالم.
Dialogue: 0,0:22:43.79,0:22:47.76,Default,Spilik2,0,0,0,,حتى لو بدا لك العالم غريباً، فلا تخف من أي شيء.
Dialogue: 0,0:23:33.32,0:23:34.98,Default,Spilik2,0,0,0,,أظهر الاحترام.
Dialogue: 0,0:23:36.45,0:23:38.32,Default,Spikyulka2,0,0,0,,إذًا كانت هذه خطتك في البداية؟
Dialogue: 0,0:23:39.89,0:23:42.23,Default,Spikyulka2,0,0,0,,علم الملك بالخطر الذي كان يتهدده.
Dialogue: 0,0:23:42.83,0:23:44.83,Default,Spikyulka2,0,0,0,,ولكن من أجل خلاصك
Dialogue: 0,0:23:44.83,0:23:46.73,Default,Spikyulka2,0,0,0,,خاطر بحياته وغادر القصر.
Dialogue: 0,0:23:48.06,0:23:49.40,Default,Spilik2,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:23:58.01,0:23:59.78,Default,Spillie2,0,0,0,,ضعوا الأمير يونبيونغ في السجن.
Dialogue: 0,0:24:01.84,0:24:02.88,Default,Spikyulka2,0,0,0,,-لا!\N-جلالتك!
Dialogue: 0,0:24:03.15,0:24:04.88,Default,Spilik2,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:24:07.02,0:24:09.55,Default,Spikyulka2,0,0,0,,لماذا تصب غضبك على الملكة؟
Dialogue: 0,0:24:09.55,0:24:12.69,Default,Spilik2,0,0,0,,ترك الملك العالم بسبب أتباع تونهاك.
Dialogue: 0,0:24:17.06,0:24:20.06,Default,Spilyk2,0,0,0,,المتمردون لم يلمسوا الحاكم حتى.
Dialogue: 0,0:24:20.96,0:24:23.77,Default,Spikyulka2,0,0,0,,هل تقول أنهم تجرأوا على قتل الملك؟
Dialogue: 0,0:24:24.93,0:24:27.24,Default,Spikyulka2,0,0,0,,هل تعتقد أنني سأصدق مثل هذه الكذبة المثيرة للشفقة؟
Dialogue: 0,0:24:28.24,0:24:32.44,Default,Spikyulka2,0,0,0,,كيم بيونين، محاربوك قتلوا الملك.
Dialogue: 0,0:24:34.84,0:24:38.18,Default,Spilik2,0,0,0,,أنت والملكة حكمت عليه بالموت،
Dialogue: 0,0:24:39.32,0:24:41.48,Default,Spikyulka2,0,0,0,,لذلك يجب أن أقتلها شخصياً.
Dialogue: 0,0:24:45.02,0:24:46.22,Default,Spilik2,0,0,0,,من فضلك، لا!
Dialogue: 0,0:24:46.52,0:24:47.66,Default,Spillie2,0,0,0,,الملكة.
Dialogue: 0,0:24:48.56,0:24:50.73,Default,Spillie2,0,0,0,,من أجل الطفلة التي في بطنها،
Dialogue: 0,0:24:51.63,0:24:53.86,Default,Spilik2,0,0,0,,من فضلك لا تؤذيها.
Dialogue: 0,0:24:54.70,0:24:57.20,Default,Spilik2,0,0,0,,جلالتها لم تكن تعلم شيئاً.
Dialogue: 0,0:24:57.63,0:24:58.80,Default,Spilyk2,0,0,0,,من فضلك...
Dialogue: 0,0:25:01.04,0:25:02.54,Default,Spilyk2,0,0,0,,أتوسل إليك...
Dialogue: 0,0:25:12.55,0:25:14.55,Default,Spilik2,0,0,0,,يا رب! ملكة!
Dialogue: 0,0:25:20.89,0:25:22.19,Default,Spilyk2,0,0,0,,خذه بعيداً.
Dialogue: 0,0:25:37.64,0:25:39.21,Default,Spilik2,0,0,0,,هل أنت بخير؟
Dialogue: 0,0:25:43.05,0:25:44.58,Default,Spilyk2,0,0,0,,ما الذي كان يتحدث عنه؟
Dialogue: 0,0:25:45.31,0:25:47.48,Default,Spikyulka2,0,0,0,,جنودك قتلوا الملك؟
Dialogue: 0,0:25:49.09,0:25:50.45,Default,Spilik2,0,0,0,,أنتما الاثنان، غادرا الغرفة.
Dialogue: 0,0:25:52.89,0:25:54.36,Default,Spilik2,0,0,0,,-جلالتك.\N-كل شيء على ما يرام.
Dialogue: 0,0:26:07.60,0:26:10.51,Default,Spikyulka2,0,0,0,,يجب إلقاء اللوم على شخص ما بسبب سوء الحظ الذي حدث.
Dialogue: 0,0:26:12.68,0:26:14.68,Default,Spillie2,0,0,0,,كان الأمير يونبيونغ يهذي،
Dialogue: 0,0:26:15.31,0:26:17.15,Default,Spikyulka2,0,0,0,,لا تأخذ هذا على محمل الجد.
Dialogue: 0,0:26:18.38,0:26:20.78,Default,Spilik2,0,0,0,,لماذا أُرسل الأمير يونبيونغ إلى السجن؟
Dialogue: 0,0:26:21.05,0:26:23.02,Default,Spikyulka2,0,0,0,,لدي دليل على أنه تركه.
Dialogue: 0,0:26:23.02,0:26:24.79,Default,Spikyulka2,0,0,0,,أتباع تونهاك يتسللون
Dialogue: 0,0:26:24.92,0:26:27.79,Default,Silk2,0,0,0,,إلى الحرس الملكي وساعدهم على الهرب.
Dialogue: 0,0:26:27.99,0:26:30.53,Default,Spilik2,0,0,0,,يبدو أنهم على صلة بالحادثة التي حدثت مع الملك،
Dialogue: 0,0:26:30.53,0:26:32.56,Default,Spikyulka2,0,0,0,,لأنني كنت سأستجوب الأمير يونبيونغ.
Dialogue: 0,0:26:33.76,0:26:35.23,Default,Spikyulka2,0,0,0,,كان يجب أن أفعل هذا مبكراً.
Dialogue: 0,0:26:35.80,0:26:37.67,Default,Spilyk2,0,0,0,,ما الذي تتحدث عنه بالضبط؟
Dialogue: 0,0:26:38.20,0:26:40.60,Default,Spikyulka2,0,0,0,,أنت تتحدث كما لو أن الأمير يونبيونغ قتل الملك.
Dialogue: 0,0:26:40.60,0:26:43.47,Default,Spilik2,0,0,0,,لا بد أن أحداً ما في القصر قد سلّم الأمر إلى أتباع تونهاك
Dialogue: 0,0:26:43.47,0:26:46.48,Default,Spikyulka2,0,0,0,,معلومات عن موعد مغادرة الملك للقصر.
Dialogue: 0,0:26:47.64,0:26:51.01,Default,Spikyulka2,0,0,0,,يجب أن يكون شخصًا لديه حق الوصول إلى المعلومات،
Dialogue: 0,0:26:51.71,0:26:53.78,Default,Spikyulka2,0,0,0,,مما يعني أن هذا على الأرجح الأمير يونبيونغ.
Dialogue: 0,0:26:55.72,0:26:57.99,Default,Spilik2,0,0,0,,هل أنت متأكد من أن أتباع تونهاك هم من هاجموا الملك؟
Dialogue: 0,0:26:58.25,0:27:01.76,Default,Spilik2,0,0,0,,يجب أن تركز على ما هو أكثر أهمية.
Dialogue: 0,0:27:02.46,0:27:06.06,Default,Spilyk2,0,0,0,,الآن فقط عشيرتك يمكنها حمايتك
Dialogue: 0,0:27:06.06,0:27:07.43,Default,Spilyk2,0,0,0,,وطفلك.
Dialogue: 0,0:27:08.30,0:27:10.60,Default,Spikyulka2,0,0,0,,لا فائدة من القلق بشأن أي شيء آخر.
Dialogue: 0,0:27:10.63,0:27:13.34,Default,Spilik2,0,0,0,,أولاً عليك أن تتصالح مع الملكة الأرملة.
Dialogue: 0,0:27:14.00,0:27:15.24,Default,Spilyk2,0,0,0,,إذا فاتتك هذه الفرصة،
Dialogue: 0,0:27:17.74,0:27:20.84,Default,Silk2,0,0,0,,قد تخسر إلى الأبد فرصة إصلاح العلاقات مع العشيرة.
Dialogue: 0,0:27:42.00,0:27:45.30,Default,Silk2,0,0,0,,يونبيونغ، أود أن أكون أنت في الحياة القادمة.
Dialogue: 0,0:27:45.73,0:27:48.77,Default,Spilik2,0,0,0,,"ابحث عن الأدلة." يبدو بسيطا
Dialogue: 0,0:27:48.77,0:27:51.41,Default,Spikyulka2,0,0,0,,وحجم العمل الذي يتطلبه.
Dialogue: 0,0:27:59.32,0:28:00.78,Default,Lily3,0,0,0,,أرى أن الجميع هنا.
Dialogue: 0,0:28:05.09,0:28:06.79,Default,Lily3,0,0,0,,لا أعتقد أنه مناسب
Dialogue: 0,0:28:06.92,0:28:10.86,Default,Lily3,0,0,0,,التجمع في منزل كيسينغ عندما مات الملك.
Dialogue: 0,0:28:10.86,0:28:13.00,Default,Lily3,0,0,0,,لقد اخترت هذا المكان عمداً للاسترخاء.
Dialogue: 0,0:28:14.83,0:28:18.33,Default,Lily3,0,0,0,,يمكننا جميعًا أن نكون صادقين أثناء وجودنا هنا.
Dialogue: 0,0:28:20.04,0:28:21.34,Default,ليلي3,0,0,0,,موت الملك
Dialogue: 0,0:28:23.01,0:28:25.27,Default,Lily3,0,0,0,,علينا أن نحتفل.
Dialogue: 0,0:28:30.51,0:28:31.85,Default,Lily3,0,0,0,,دعنا نتناول مشروبًا.
Dialogue: 0,0:28:32.18,0:28:35.89,Default,Lily3,0,0,0,,حشود المتمردين أصيبت بالجنون.
Dialogue: 0,0:28:36.15,0:28:38.65,Default,Lily3,0,0,0,,أنا قلقة بشأن مستقبل جوسون.
Dialogue: 0,0:28:40.09,0:28:41.66,Default,Lily3,0,0,0,,على هذا المعدل، التونخاكوفيون
Dialogue: 0,0:28:41.66,0:28:44.86,Default,Lilia3,0,0,0,,سيتم القبض على خانيان قريباً.
Dialogue: 0,0:28:45.13,0:28:47.83,Default,Lily3,0,0,0,,إذا حدث هذا، فالجميع يجلس هنا
Dialogue: 0,0:28:48.16,0:28:49.87,Default,Lily3,0,0,0,,سوف تعاني.
Dialogue: 0,0:28:52.03,0:28:54.60,Default,Lily3,0,0,0,,لذلك علينا تعزيز أمن القصر
Dialogue: 0,0:28:54.90,0:28:57.84,Default,Lily3,0,0,0,,وأسوار القلعة حول خانيانغ.
Dialogue: 0,0:28:58.94,0:29:01.44,Default,Lily3,0,0,0,,سنعلن حالة الطوارئ ونقيد الدخول.
Dialogue: 0,0:29:01.81,0:29:04.05,Default,Lily3,0,0,0,,سيتم احتجاز جميع الأشخاص المشبوهين.
Dialogue: 0,0:29:05.25,0:29:07.85,Default,Lily3,0,0,0,,لذلك سوف نتخلص من كل التونهاكيت.
Dialogue: 0,0:29:11.19,0:29:14.09,Default,Lily3,0,0,0,,فكرة رائعة.
Dialogue: 0,0:29:23.33,0:29:26.74,Default,Lily3,0,0,0,,يبدو أن الملكة فقدت عقلها.
Dialogue: 0,0:29:27.84,0:29:29.81,Default,Lily3,0,0,0,,لطالما كانت هكذا.
Dialogue: 0,0:29:32.47,0:29:35.78,Default,Lilia3,0,0,0,,ظنت أن كل السلطة في يديها بسبب الحمل،
Dialogue: 0,0:29:35.98,0:29:39.11,Default,Lily3,0,0,0,,ولكن الملك مات. أراهن أنها مرعوبة.
Dialogue: 0,0:29:40.65,0:29:43.25,Default,Lily3,0,0,0,,إذا أنجبت أميراً،
Dialogue: 0,0:29:43.25,0:29:46.52,Default,Lily3,0,0,0,,هذا سيقضي عليها.
Dialogue: 0,0:29:48.26,0:29:50.36,Default,Lily3,0,0,0,,وأخيراً كلام معقول منك.
Dialogue: 0,0:30:04.64,0:30:07.81,Default,Lily3,0,0,0,,الشموع وأعواد البخور بحاجة إلى التغيير.
Dialogue: 0,0:30:30.83,0:30:34.30,Default,Lily3,0,0,0,,يا صاحب الجلالة، سأموت بنوبة قلبية.
Dialogue: 0,0:30:34.47,0:30:37.51,Default,Lily3,0,0,0,,لماذا يحرسون الرجل الميت بهذه الطريقة؟
Dialogue: 0,0:30:39.41,0:30:41.34,Default,Lily3,0,0,0,,أليس هناك أي شيء غريب في هذا؟
Dialogue: 0,0:30:44.15,0:30:45.35,Default,Lily3,0,0,0,,علينا أن نسرع.
Dialogue: 0,0:30:48.25,0:30:49.65,Default,Lily3,0,0,0,,شكرًا لك.
Dialogue: 0,0:31:06.14,0:31:09.34,Default,Lily3,0,0,0,,لقد أصيب بجروح بالغة.
Dialogue: 0,0:31:10.11,0:31:12.17,Default,Lily3,0,0,0,,وخاصة الوجه.
Dialogue: 0,0:31:12.27,0:31:16.81,Default,Lily3,0,0,0,,قوي جدًا لدرجة أنه لا يمكن التعرف عليه.
Dialogue: 0,0:31:40.34,0:31:42.07,Default,Lily3,0,0,0,,يوريكا!
Dialogue: 0,0:31:52.92,0:31:55.45,Default,Lily3,0,0,0,,أيها الجرذان، لم أفعل أي شيء.
Dialogue: 0,0:31:55.45,0:31:57.82,Default,Lily3,0,0,0,,كل من يستحق الحبس يقول ذلك.
Dialogue: 0,0:31:57.92,0:32:00.62,Default,Lily3,0,0,0,,أنت مذنب بفقدان سلاحك.
Dialogue: 0,0:32:01.82,0:32:04.66,Default,Lily3,0,0,0,,كيف يمكنك أن تلومني على هذا؟
Dialogue: 0,0:32:04.83,0:32:07.53,Default,Lily3,0,0,0,,أي أحمق قادر على فقدان سلاح؟
Dialogue: 0,0:32:07.53,0:32:10.23,Default,Lily3,0,0,0,,نفس الشيء الذي أمامي.
Dialogue: 0,0:32:11.23,0:32:12.97,Default,Lily3,0,0,0,,تمت سرقة مستودع الأسلحة.
Dialogue: 0,0:32:16.14,0:32:17.57,Default,Lily3,0,0,0,,لا أعتقد أنك مهتم،
Dialogue: 0,0:32:20.11,0:32:21.54,Default,Lily3,0,0,0,,ما هو مذنب الأمير يونبيونغ.
Dialogue: 0,0:32:21.91,0:32:24.91,Default,Lily3,0,0,0,,لا تقلق. أنت لست هنا لفترة طويلة.
Dialogue: 0,0:32:26.05,0:32:27.05,Default,Lily3,0,0,0,,ماذا؟
Dialogue: 0,0:32:28.85,0:32:31.22,Default,Lily3,0,0,0,,ماذا يعني هذا؟ نحن
Dialogue: 0,0:32:31.85,0:32:32.86,Default,Lily3,0,0,0,,أُعدمت؟
Dialogue: 0,0:32:33.96,0:32:36.13,Default,Lily3,0,0,0,,يمكنني الجلوس لفترة أطول.
Dialogue: 0,0:32:36.13,0:32:37.13,Default,Lily3,0,0,0,,أحب النوم على الأرض.
Dialogue: 0,0:32:37.13,0:32:38.46,Default,Lily3,0,0,0,,مهلا، انتظر!
Dialogue: 0,0:32:44.63,0:32:45.70,Default,Lily3,0,0,0,,حسنًا.
Dialogue: 0,0:32:46.60,0:32:49.97,Default,Lily3,0,0,0,,دعونا نتناقش. يمكننا أن نفعل ذلك.
Dialogue: 0,0:32:58.58,0:33:00.45,Default,Lily3,0,0,0,,أرسل بيونين تشيولجونغ إلى المتمردين،
Dialogue: 0,0:33:00.45,0:33:02.35,Default,Lily3,0,0,0,,استخدامي كطعم للقتل.
Dialogue: 0,0:33:04.65,0:33:06.82,Default,Lily3,0,0,0,,ولكن هناك جثة شخص آخر هناك، مما يعني
Dialogue: 0,0:33:06.82,0:33:08.62,Default,Lily3,0,0,0,,الخطة لم تنجح.
Dialogue: 0,0:33:11.13,0:33:14.96,Default,Lily3,0,0,0,,لقد احتجز رجال تشولجونغ حتى لا يساعدوه على العودة.
Dialogue: 0,0:33:21.90,0:33:25.47,Default,Lily3,0,0,0,,لا أستطيع التركيز بسبب بكائك.
Dialogue: 0,0:33:31.65,0:33:33.18,Default,Lily3,0,0,0,,اقترب.
Dialogue: 0,0:33:36.65,0:33:39.22,Default,Lily3,0,0,0,,سأخبرك سراً.
Dialogue: 0,0:33:40.49,0:33:43.13,Default,Lily3,0,0,0,,يجب أن تأخذه إلى قبرك.
Dialogue: 0,0:33:48.13,0:33:49.46,Default,Lily3,0,0,0,,ملك
Dialogue: 0,0:33:51.83,0:33:53.00,Default,Lily3,0,0,0,,على قيد الحياة.
Dialogue: 0,0:33:54.87,0:33:56.91,Default,Lily3,0,0,0,,نعم بالطبع.
Dialogue: 0,0:33:57.11,0:34:02.28,Default,Lily3,0,0,0,,سيعيش جلالته في قلبك.
Dialogue: 0,0:34:03.15,0:34:04.55,Default,Lily3,0,0,0,,...
Dialogue: 0,0:34:05.91,0:34:07.92,Default,Lily3,0,0,0,,شعرت بالجسد من الرأس إلى أخمص القدمين.
Dialogue: 0,0:34:09.02,0:34:10.22,Default,Lily3,0,0,0,,إنه ليس هو.
Dialogue: 0,0:34:10.42,0:34:12.39,Default,Lily3,0,0,0,,من الرأس إلى أخمص القدمين؟
Dialogue: 0,0:34:13.82,0:34:15.69,Default,Lily3,0,0,0,,سأتخطى التفاصيل.
Dialogue: 0,0:34:18.36,0:34:21.06,Default,Lily3,0,0,0,,-يا رب.\N-إذا كان على قيد الحياة،
Dialogue: 0,0:34:21.73,0:34:24.23,Default,Lily3,0,0,0,,لماذا لم تعد بعد؟
Dialogue: 0,0:34:25.30,0:34:27.57,Default,Lily3,0,0,0,,إما أنه جريح أو مقيد في مكان ما.
Dialogue: 0,0:34:29.14,0:34:30.47,Default,Lily3,0,0,0,,-السيدة تشوي.\N-نعم.
Dialogue: 0,0:34:30.64,0:34:32.98,Default,Lily3,0,0,0,,هناك قانون يمنع اعتلاء العرش،
Dialogue: 0,0:34:32.98,0:34:35.08,Default,Lily3,0,0,0,,بعد وفاة الملك مباشرة؟
Dialogue: 0,0:34:35.54,0:34:38.28,Default,Lily3,0,0,0,,نعم. هذه العادة تسمى سانيبوك.
Dialogue: 0,0:34:38.28,0:34:42.15,Default,Lily3,0,0,0,,يجب عليك انتظار عودة روح المتوفى خلال خمسة أيام.
Dialogue: 0,0:34:42.15,0:34:44.59,Default,Lily3,0,0,0,,يمكن للملك الجديد أن يصعد إلى العرش خلال خمسة أيام فقط.
Dialogue: 0,0:34:44.89,0:34:47.79,Default,Lily3,0,0,0,,ثم لدينا ستة أيام، بما في ذلك يوم التتويج.
Dialogue: 0,0:34:49.19,0:34:51.23,Default,Lily3,0,0,0,,سيفعلون أي شيء،
Dialogue: 0,0:34:51.23,0:34:53.30,Default,Lily3,0,0,0,,حتى لا يعود الملك خلال هذه الأيام الستة.
Dialogue: 0,0:34:55.20,0:34:56.57,Default,Lily3,0,0,0,,كم عدد الخادمات في القصر؟
Dialogue: 0,0:34:57.03,0:35:01.44,Default,Lily3,0,0,0,,حوالي 250 خادمة في البلاط.
Dialogue: 0,0:35:01.44,0:35:03.47,Default,Lily3,0,0,0,,إذا ضممت موظفي البلاط،
Dialogue: 0,0:35:03.47,0:35:05.51,Default,Lily3,0,0,0,,سيكون أكثر من 600.
Dialogue: 0,0:35:06.11,0:35:08.74,Default,Lily3,0,0,0,,600 كاميرا مراقبة حية.
Dialogue: 0,0:35:09.51,0:35:11.85,Default,Lily3,0,0,0,,إذا قال كل واحد منهم كلمة، سيكون هناك 600 كلمة.
Dialogue: 0,0:35:13.52,0:35:15.08,Default,Lily3,0,0,0,,دعونا نستخدمها.
Dialogue: 0,0:35:16.05,0:35:17.09,Default,Lily3,0,0,0,,-ماذا؟\N-ماذا؟
Dialogue: 0,0:35:17.09,0:35:19.15,Default,Lily3,0,0,0,,سأعطل التتويج.
Dialogue: 0,0:35:21.29,0:35:22.56,Default,Lily3,0,0,0,,هل أنت معي؟
Dialogue: 0,0:35:23.06,0:35:24.06,Default,Lily3,0,0,0,,حظاً موفقاً.
Dialogue: 0,0:35:24.46,0:35:26.86,Default,Lily3,0,0,0,,-نعم.\N-نعم.
Dialogue: 0,0:35:27.83,0:35:28.93,Default,Lily3,0,0,0,,نعم.
Dialogue: 0,0:35:30.23,0:35:32.10,Default,Lily3,0,0,0,,إذا كان جلالته على قيد الحياة...
Dialogue: 0,0:35:35.37,0:35:38.07,Default,Lily3,0,0,0,,ولايتنا تمر بصعوبات،
Dialogue: 0,0:35:38.47,0:35:40.48,Default,Lily3,0,0,0,,لا يمكن تأخير تعيين ملك جديد.
Dialogue: 0,0:35:40.84,0:35:43.65,Default,Lily3,0,0,0,,كملك يؤدي الواجبات الملكية،
Dialogue: 0,0:35:44.35,0:35:46.25,Default,Lily3,0,0,0,,أعلن عن السليل الثاني والثلاثين
Dialogue: 0,0:35:46.25,0:35:48.82,Default,Lily3,0,0,0,,الأمير مينهونغ، لي كيونغ وون.
Dialogue: 0,0:35:50.22,0:35:52.49,Default,Lily3,0,0,0,,لقد ترك الملك هذا العالم
Dialogue: 0,0:35:53.26,0:35:54.96,Default,Lily3,0,0,0,,بسبب انتفاضة المتمردين...
Dialogue: 0,0:35:55.39,0:35:56.86,Default,Lily3,0,0,0,,أتباع تونغهاك الذين أخذوا بعيداً
Dialogue: 0,0:35:56.86,0:35:59.16,Default,Lily3,0,0,0,,حياة ملكنا لا تستحق الرحمة.
Dialogue: 0,0:35:59.63,0:36:01.53,Default,Lily3,0,0,0,,أعلن أن كل فرد
Dialogue: 0,0:36:01.53,0:36:04.33,Default,Lily3,0,0,0,,سيتم تدمير أتباع "تونغهاك".
Dialogue: 0,0:36:05.40,0:36:07.44,Default,Lily3,0,0,0,,لقد جلب التونهاكوفيون المشاكل لأنفسهم.
Dialogue: 0,0:36:07.44,0:36:08.80,Default,Lily3,0,0,0,,الأوغاد.
Dialogue: 0,0:36:18.38,0:36:19.38,Default,Lily3,0,0,0,,بنين.
Dialogue: 0,0:36:25.89,0:36:26.96,Default,Lily3,0,0,0,,لماذا تأخرت
Dialogue: 0,0:36:26.96,0:36:28.26,Default,Lily3,0,0,0,,يونبيونغ وهونغ؟
Dialogue: 0,0:36:29.36,0:36:30.73,Default,Lily3,0,0,0,,ميزان القوى يتغير
Dialogue: 0,0:36:30.73,0:36:32.26,Default,Lily3,0,0,0,,حسب من يجلس على العرش.
Dialogue: 0,0:36:32.26,0:36:34.00,Default,Lily3,0,0,0,,هذه ليست المرة الأولى التي يحدث فيها هذا.
Dialogue: 0,0:36:34.00,0:36:36.40,Default,Lily3,0,0,0,,فليكن. توفي الملك مؤخرا.
Dialogue: 0,0:36:36.40,0:36:38.30,Default,Lily3,0,0,0,,كيف يمكنك اعتقال الأبرياء؟
Dialogue: 0,0:36:38.73,0:36:40.34,Default,Lily3,0,0,0,,بريئة؟
Dialogue: 0,0:36:42.20,0:36:44.17,Default,Lily3,0,0,0,,الوقوف إلى جانب الضعفاء جريمة أيضًا.
Dialogue: 0,0:36:44.34,0:36:48.08,Default,Lilia3,0,0,0,,بنين، إلى أي مدى أنت على استعداد للذهاب؟
Dialogue: 0,0:36:50.65,0:36:52.55,Default,Lily3,0,0,0,,أريد أن أصبح أكثر قوة.
Dialogue: 0,0:36:53.08,0:36:55.28,Default,Lily3,0,0,0,,لحماية الأشخاص الأعزاء عليّ،
Dialogue: 0,0:36:57.12,0:36:58.85,Default,Lily3,0,0,0,,أحتاج إلى المزيد من القوة.
Dialogue: 0,0:37:05.73,0:37:07.10,Default,Lily3,0,0,0,,اجعل شفتيك هامدة.
Dialogue: 0,0:37:07.76,0:37:09.60,Default,Lily3,0,0,0,,أنت بالفعل جثة حية.
Dialogue: 0,0:37:09.87,0:37:12.57,Default,Lily3,0,0,0,,إجعلها تبدو كجثة حقيقية.
Dialogue: 0,0:37:17.27,0:37:19.04,Default,Lily3,0,0,0,,لماذا نذهب إلى هذا الحد؟
Dialogue: 0,0:37:20.71,0:37:22.94,Default,Lily3,0,0,0,,لم يبق للملك سواي.
Dialogue: 0,0:37:24.88,0:37:27.38,Default,Lily3,0,0,0,,حتى لو أرادوا التخلص مني،
Dialogue: 0,0:37:27.38,0:37:29.68,Default,Lily3,0,0,0,,لن يضعوا امرأة حامل في قفص.
Dialogue: 0,0:37:32.49,0:37:33.72,Default,Lily3,0,0,0,,كيف أبدو؟
Dialogue: 0,0:37:37.56,0:37:39.76,Default,Lily3,0,0,0,,-كالجثة الحقيقية.\N-حقاً؟
Dialogue: 0,0:37:59.51,0:38:02.22,Default,Lily3,0,0,0,,لقد وصلت الملكة الأرملة.
Dialogue: 0,0:38:32.38,0:38:35.55,Default,Lily3,0,0,0,,سيقدم هذان العرضان عرضًا رائعًا هنا.
Dialogue: 0,0:38:40.09,0:38:42.69,Default,Lily3,0,0,0,,الجائزة الرئيسية فقط ستكون لي.
Dialogue: 0,0:38:44.63,0:38:48.43,Default,Lily3,0,0,0,,جلالتك.
Dialogue: 0,0:38:50.50,0:38:54.44,Default,Lily3,0,0,0,,كيف يمكنك أن تتركني؟
Dialogue: 0,0:38:55.67,0:38:58.61,Default,Lily3,0,0,0,,ماذا عن طفلنا؟
Dialogue: 0,0:39:00.11,0:39:01.14,Default,Lily3,0,0,0,,...
Dialogue: 0,0:39:01.61,0:39:06.01,Default,Lily3,0,0,0,,جلالتك.
Dialogue: 0,0:39:10.55,0:39:13.32,Default,Lily3,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:39:13.46,0:39:14.86,Default,Lily3,0,0,0,,جلالتك.
Dialogue: 0,0:39:15.89,0:39:17.66,Default,Lily3,0,0,0,,جلالتك.
Dialogue: 0,0:39:17.93,0:39:21.06,Default,Lily3,0,0,0,,اتصل بالطبيب الملكي. على وجه السرعة!
Dialogue: 0,0:39:23.60,0:39:26.23,Default,Lily3,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:39:26.23,0:39:28.17,Default,Lily3,0,0,0,,إذا تأخرت ولو لفترة قصيرة فسوف ألعنهم.
Dialogue: 0,0:39:28.17,0:39:29.24,Default,Lily3,0,0,0,,اسحب، اسحب.
Dialogue: 0,0:39:29.24,0:39:32.87,Default,Lily3,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:39:34.11,0:39:36.55,Default,Lily3,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:39:40.92,0:39:43.42,Default,Lily3,0,0,0,,كيف ذلك.
Dialogue: 0,0:39:44.69,0:39:46.72,Default,Lily3,0,0,0,,كيف ذلك.
Dialogue: 0,0:39:47.26,0:39:49.49,Default,Lily3,0,0,0,,يا رب.
Dialogue: 0,0:39:49.82,0:39:54.10,Default,Lily3,0,0,0,,كيف ذلك.
Dialogue: 0,0:39:57.37,0:39:58.57,Default,Lily3,0,0,0,,هل اتصلت بي؟
Dialogue: 0,0:40:00.54,0:40:02.17,Default,Lily3,0,0,0,,هل شعرت بالرعب عندما سمعت الأخبار؟
Dialogue: 0,0:40:02.34,0:40:05.57,Default,Lily3,0,0,0,,ماذا حدث له في الأيام الأخيرة؟
Dialogue: 0,0:40:06.78,0:40:09.38,Default,Lily3,0,0,0,,كيف يمكن أن يغادر فجأة؟
Dialogue: 0,0:40:11.71,0:40:12.81,Default,Lily3,0,0,0,,ملك
Dialogue: 0,0:40:16.59,0:40:17.72,Default,Lily3,0,0,0,,على قيد الحياة.
Dialogue: 0,0:40:19.59,0:40:21.02,Default,Lily3,0,0,0,,اتصلت لأخبرك بهذا.
Dialogue: 0,0:40:27.23,0:40:28.33,Default,Lily3,0,0,0,,شكرًا لك.
Dialogue: 0,0:40:29.70,0:40:31.40,Default,Lily3,0,0,0,,شكراً جزيلا لك.
Dialogue: 0,0:40:36.27,0:40:37.37,Default,Lily3,0,0,0,,استمع.
Dialogue: 0,0:40:38.67,0:40:40.31,Default,Lily3,0,0,0,,هذه مجرد البداية.
Dialogue: 0,0:40:45.78,0:40:49.62,Default,Lily3,0,0,0,,سنقوم بتهدئة الاضطرابات في البلاد في أربعة أيام.
Dialogue: 0,0:40:50.75,0:40:53.49,Default,Lily3,0,0,0,,بفضل الملك، سنتخلص من آل تونهاكيت.
Dialogue: 0,0:40:53.89,0:40:56.79,Default,Lily3,0,0,0,,سوف يدافع بقية الحثالة عن أنفسهم.
Dialogue: 0,0:40:57.39,0:40:59.76,Default,Lily3,0,0,0,,بالنظر إلى ما يحدث، يمكننا أن نقول،
Dialogue: 0,0:40:59.76,0:41:01.83,Default,Lilia3,0,0,0,,أنه ضحى بحياته لإنقاذ البلاد.
Dialogue: 0,0:41:07.10,0:41:08.57,Default,Lily3,0,0,0,,حتى يهدأ كل شيء،
Dialogue: 0,0:41:10.57,0:41:13.21,Default,Lily3,0,0,0,,هناك بعض المخاوف،
Dialogue: 0,0:41:13.41,0:41:16.38,Default,Lily3,0,0,0,,لهذا السبب جمعتك هنا.
Dialogue: 0,0:41:18.71,0:41:20.62,Default,Lily3,0,0,0,,أندونج كيمز وفنيانج تشوس
Dialogue: 0,0:41:20.62,0:41:22.45,Default,Lilia3,0,0,0,,كانا في عداوة لفترة طويلة.
Dialogue: 0,0:41:23.15,0:41:25.75,Default,Lily3,0,0,0,,اتحدنا لبعض الوقت،
Dialogue: 0,0:41:25.75,0:41:27.69,Default,Lily3,0,0,0,,لمواجهة العدو المشترك - الملك.
Dialogue: 0,0:41:27.96,0:41:29.86,Default,Lily3,0,0,0,,ولكن الآن ترك الملك اللعبة،
Dialogue: 0,0:41:29.86,0:41:32.23,Default,Lily3,0,0,0,,وأخشى أن تبدأ العشيرتان في الشجار مرة أخرى
Dialogue: 0,0:41:32.23,0:41:34.00,Default,Lily3,0,0,0,,ويتنافسون مع بعضهم البعض.
Dialogue: 0,0:41:35.20,0:41:36.23,Default,Lily3,0,0,0,,قبل
Dialogue: 0,0:41:37.33,0:41:39.20,Default,Lily3,0,0,0,,دعونا ننتقل إلى جدول الأعمال،
Dialogue: 0,0:41:40.04,0:41:41.97,Default,Lily3,0,0,0,,لقد أعددت شيئاً للتقوية
Dialogue: 0,0:41:41.97,0:41:43.64,Default,Lily3,0,0,0,,اتحاد عائلتين.
Dialogue: 0,0:41:52.28,0:41:55.58,Default,Lily3,0,0,0,,تمرد في المحكمة...
Dialogue: 0,0:41:59.55,0:42:00.82,Default,Lily3,0,0,0,,تحرّك أم يطيح؟
Dialogue: 0,0:42:02.22,0:42:03.22,Default,Lily3,0,0,0,,هذا يعني،
Dialogue: 0,0:42:04.73,0:42:06.09,Default,Lilia3,0,0,0,,إنك تخطط للخيانة.
Dialogue: 0,0:42:07.33,0:42:10.23,Default,Lily3,0,0,0,,إنها مخفية في أعماق نفوسكم.
Dialogue: 0,0:42:10.90,0:42:12.90,Default,Lily3,0,0,0,,لقد مات الملك على أية حال،
Dialogue: 0,0:42:12.90,0:42:15.20,Default,Lily3,0,0,0,,لماذا تترك مثل هذه الوثيقة؟
Dialogue: 0,0:42:15.20,0:42:17.61,Default,Lily3,0,0,0,,من أجل تقاسم المسؤولية.
Dialogue: 0,0:42:18.34,0:42:22.08,Default,Lily3,0,0,0,,سيمنع هذا أيًا من العائلات من انتهاك شروط التحالف.
Dialogue: 0,0:42:22.38,0:42:24.71,Default,Lily3,0,0,0,,سأترك دليلاً للتأكيد على أننا في نفس القارب.
Dialogue: 0,0:42:26.11,0:42:27.75,Default,Lily3,0,0,0,,طالما أنك توافق على هذا،
Dialogue: 0,0:42:28.35,0:42:31.92,Default,Lily3,0,0,0,,أضمن لك أن عائلتين تستطيعان ذلك
Dialogue: 0,0:42:32.99,0:42:34.96,Default,Lily3,0,0,0,,التعايش في السلطة.
Dialogue: 0,0:42:35.49,0:42:36.79,Default,Lily3,0,0,0,,هذا يعني،
Dialogue: 0,0:42:37.46,0:42:40.53,Default,Lily3,0,0,0,,أنك تريد السيطرة على حياتنا.
Dialogue: 0,0:42:46.33,0:42:49.10,Default,Lily3,0,0,0,,لا يمكننا فعل هذا.
Dialogue: 0,0:42:55.01,0:42:57.05,Default,Lily3,0,0,0,,ماذا تسمح لنفسك؟
Dialogue: 0,0:42:57.05,0:42:58.81,Default,Lily3,0,0,0,,كيف تجرؤ على جمع الجنود؟
Dialogue: 0,0:43:00.62,0:43:02.48,Default,Lily3,0,0,0,,يجب أن تتفق معي،
Dialogue: 0,0:43:03.99,0:43:06.05,Default,Lily3,0,0,0,,للخروج من هنا حياً.
Dialogue: 0,0:43:14.10,0:43:15.53,Default,Lily3,0,0,0,,كيم بيونين
Dialogue: 0,0:43:37.72,0:43:38.72,Default,معرض التصوير4,0,0,0,,جلالتك.
Dialogue: 0,0:43:38.85,0:43:41.76,Default,tier4,0,0,0,,نعم. ادخل.
Dialogue: 0,0:43:48.43,0:43:50.57,Default,معرض الرماية4,0,0,0,,-جلالتك.\N-هل اكتشفت شيئاً؟
Dialogue: 0,0:43:50.57,0:43:53.77,Default,معرض الرماية4,0,0,0,,كما قلت بوابة القصر
Dialogue: 0,0:43:54.97,0:43:58.14,Default,معرض الرماية4,0,0,0,,وجميع البوابات حول هانيانغ مغلقة.
Dialogue: 0,0:43:59.17,0:44:00.24,Default,معرض التصوير4,0,0,0,,كنت أعرف ذلك.
Dialogue: 0,0:44:01.14,0:44:02.31,Default,معرض الرماية4,0,0,0,,ماذا عن المحاربين؟
Dialogue: 0,0:44:02.31,0:44:03.58,Default,معرض التصوير4,0,0,0,,بقي مكان واحد،
Dialogue: 0,0:44:03.58,0:44:05.35,Default,معرض الرماية4,0,0,0,,حيث يواصل المحاربون بحثهم.
Dialogue: 0,0:44:06.05,0:44:07.82,Default,معرض التصوير4,0,0,0,,هذا بجوار الهاوية.
Dialogue: 0,0:44:08.62,0:44:11.75,Default,tyra4,0,0,0,,لقد وجدتك يا تشيولجونغ. سأنقذك.
Dialogue: 0,0:44:16.32,0:44:18.99,Default,معرض التصوير4,0,0,0,,هناك شيء يجعلني أشعر بالنعاس. عليك أن تذهب أيضا.
Dialogue: 0,0:44:22.96,0:44:24.50,Default,معرض التصوير4,0,0,0,,كم أريد أن أنام!
Dialogue: 0,0:44:27.94,0:44:29.34,Default,معرض التصوير4,0,0,0,,سوف أغمي عليه الآن.
Dialogue: 0,0:44:29.34,0:44:31.57,Default,tyra4,0,0,0,,ليلة سعيدة يا صاحب الجلالة.
Dialogue: 0,0:44:31.97,0:44:33.74,Default,tyra4,0,0,0,,أحلام سعيدة أيتها الملكة.
Dialogue: 0,0:44:34.21,0:44:36.34,Default,tier4,0,0,0,,نعم. ليلة سعيدة لك أيضا.
Dialogue: 0,0:44:36.54,0:44:37.65,Default,tier4,0,0,0,,نعم.
Dialogue: 0,0:44:41.38,0:44:42.72,Default,tier4,0,0,0,,كن بصحة جيدة.
Dialogue: 0,0:44:44.49,0:44:45.65,Default,معرض التصوير4,0,0,0,,ماذا؟
Dialogue: 0,0:44:45.92,0:44:49.39,Default,tyra4,0,0,0,,عندما يتعلق الأمر بالصحة، لا يجب أن تكون مهملاً.
Dialogue: 0,0:44:51.73,0:44:52.99,Default,tyra4,0,0,0,,-نعم يا ملكة.\N-نعم يا ملكة.
Dialogue: 0,0:45:25.99,0:45:27.00,Default,معرض التصوير4,0,0,0,,أين الملكة؟
Dialogue: 0,0:45:27.03,0:45:29.10,Default,tyra4,0,0,0,,لقد فقدت وعيها من الصدمة،
Dialogue: 0,0:45:29.10,0:45:30.27,Default,معرض التصوير4,0,0,0,,لكنها سرعان ما عادت إلى رشدها.
Dialogue: 0,0:45:30.60,0:45:31.70,Default,معرض التصوير4,0,0,0,,هل فقدت الوعي؟
Dialogue: 0,0:45:37.94,0:45:39.37,Default,معرض التصوير4,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:45:52.52,0:45:56.02,Default,معرض التصوير4,0,0,0,,هذا ليس ما أفكر فيه، أليس كذلك؟
Dialogue: 0,0:45:57.43,0:45:59.66,Default,معرض التصوير4,0,0,0,,هل أنت مستعد حقًا للذهاب إلى هذا الحد؟
Dialogue: 0,0:46:02.33,0:46:04.20,Default,معرض التصوير4,0,0,0,,-فقط استمر.\N-لن تغادر.
Dialogue: 0,0:46:04.87,0:46:07.20,Default,معرض الرماية4,0,0,0,,إذا غادرت القصر، ستكون في خطر.
Dialogue: 0,0:46:07.27,0:46:08.70,Default,معرض التصوير4,0,0,0,,هل تعتقد أنني لا أعرف هذا؟
Dialogue: 0,0:46:09.20,0:46:10.41,Default,معرض التصوير4,0,0,0,,أعرف كل شيء.
Dialogue: 0,0:46:10.41,0:46:12.71,Default,tyra4,0,0,0,,لقد استخدمتني كطعم للملك،
Dialogue: 0,0:46:12.71,0:46:15.08,Default,tyra4,0,0,0,,وأنت من وجهت السيف نحوه.
Dialogue: 0,0:46:16.21,0:46:17.45,Default,معرض التصوير4,0,0,0,,أعرف كل شيء.
Dialogue: 0,0:46:17.65,0:46:19.88,Default,معرض التصوير4,0,0,0,,طالما أنك آمن،
Dialogue: 0,0:46:19.88,0:46:21.85,Default,tyra4,0,0,0,,أنا مستعد لتحمل كراهيتك.
Dialogue: 0,0:46:22.15,0:46:24.05,Default,معرض التصوير4,0,0,0,,كن غاضبًا مني كما تريد.
Dialogue: 0,0:46:24.32,0:46:25.99,Default,معرض التصوير4,0,0,0,,واستسلم بالفعل.
Dialogue: 0,0:46:26.42,0:46:28.26,Default,معرض الرماية4,0,0,0,,لقد مات الملك على أية حال.
Dialogue: 0,0:46:28.26,0:46:30.79,Default,tier4,0,0,0,,لا. انه على قيد الحياة.
Dialogue: 0,0:46:31.79,0:46:34.30,Default,معرض الرماية4,0,0,0,,كما تعلمون، الملك ليس من أولئك الذين سيموتون بسهولة.
Dialogue: 0,0:46:34.66,0:46:37.07,Default,tyra4,0,0,0,,أليس هذا سبب استعجالك للتتويج؟
Dialogue: 0,0:46:37.07,0:46:38.17,Default,معرض التصوير4,0,0,0,,جلالتك.
Dialogue: 0,0:46:39.37,0:46:40.37,Default,معرض التصوير4,0,0,0,,من فضلك.
Dialogue: 0,0:46:42.07,0:46:44.51,Default,معرض الرماية4,0,0,0,,يجب أن تدير ظهرك للملك لتتمكن من البقاء.
Dialogue: 0,0:46:47.68,0:46:49.51,Default,معرض الرماية4,0,0,0,,أردت أن تعرف لماذا اخترت الملك؟
Dialogue: 0,0:46:50.61,0:46:52.58,Default,معرض التصوير4,0,0,0,,سأجيبك.
Dialogue: 0,0:46:53.18,0:46:55.25,Default,معرض الرماية4,0,0,0,,إذا كان هناك من يستحق أن يصبح ملكاً،
Dialogue: 0,0:46:55.62,0:46:57.52,Default,tier4,0,0,0,,عندها فقط جلالته.
Dialogue: 0,0:46:58.32,0:47:00.49,Default,معرض الرماية4,0,0,0,,إنه المرشح الأنسب.
Dialogue: 0,0:47:01.12,0:47:04.86,Default,معرض التصوير4,0,0,0,,لذا لا تحاول حتى أن تحدد لي خيارًا.
Dialogue: 0,0:47:04.86,0:47:05.99,Default,معرض التصوير4,0,0,0,,إذا تابعت،
Dialogue: 0,0:47:12.63,0:47:14.20,Default,معرض التصوير4,0,0,0,,لن تترك لي خيارًا.
Dialogue: 0,0:47:15.94,0:47:18.94,Default,معرض الرماية4,0,0,0,,سويون، كيف يمكنك توجيه سهم نحوي؟
Dialogue: 0,0:47:19.17,0:47:20.64,Default,shooting4,0,0,0,,أنت تعرف مشاعري.
Dialogue: 0,0:47:21.88,0:47:24.11,Default,tyra4,0,0,0,,إذا كنت تحبها كثيراً،
Dialogue: 0,0:47:24.81,0:47:26.88,Default,tyra4,0,0,0,,ألم يكن عليّ أن أفهم،
Dialogue: 0,0:47:26.88,0:47:28.72,Default,tyra4,0,0,0,,أن كيم سو يون قد تغيرت؟
Dialogue: 0,0:47:31.39,0:47:32.42,Default,معرض التصوير4,0,0,0,,انظر إلي.
Dialogue: 0,0:47:32.69,0:47:35.69,Default,tyra4,0,0,0,, هل أنا حقاً المرأة التي كنت تحلم بها طوال هذا الوقت؟
Dialogue: 0,0:47:35.69,0:47:38.23,Default,tyra4,0,0,0,,أنا شخص مختلف تمامًا من الداخل، لكنك لم تكن تعلم ذلك.
Dialogue: 0,0:47:38.76,0:47:40.06,Default,tyra4,0,0,0,,الشخص الذي أحببته -
Dialogue: 0,0:47:41.20,0:47:42.83,Default,التصويب4,0,0,0,,مجرد قذيفة.
Dialogue: 0,0:47:42.86,0:47:44.80,Default,tyra4,0,0,0,,-سويون.\N-سويون الحقيقية، التي أحببتها،
Dialogue: 0,0:47:44.80,0:47:46.17,Default,معرض التصوير4,0,0,0,,لا أكثر.
Dialogue: 0,0:47:47.44,0:47:49.44,Default,معرض التصوير4,0,0,0,,ما الذي تتحدث عنه بحق الجحيم؟
Dialogue: 0,0:47:54.74,0:47:57.25,Default,معرض الرماية4,0,0,0,,سويون الحقيقية لم تستطع إطلاق النار عليك،
Dialogue: 0,0:47:57.91,0:47:59.98,Default,tira4,0,0,0,,لأنني أحببتك كأخ.
Dialogue: 0,0:48:01.12,0:48:02.42,Default,معرض التصوير4,0,0,0,,لكنني مختلف.
Dialogue: 0,0:48:05.02,0:48:07.12,Default,معرض الرماية4,0,0,0,,يمكنني إطلاق النار عليك بقدر ما أريد.
Dialogue: 0,0:48:18.77,0:48:20.10,Default,معرض التصوير4,0,0,0,,لقد حذرتك!
Dialogue: 0,0:48:21.67,0:48:23.37,Default,tyra4,0,0,0,,لم أرغب في إيذائه.
Dialogue: 0,0:49:03.95,0:49:04.98,Default,معرض التصوير4,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:49:06.35,0:49:08.92,Default,معرض التصوير4,0,0,0,,كان الأمر واضحًا جدًا لدرجة أننا قررنا أنه كان تلميحًا.
Dialogue: 0,0:49:09.42,0:49:11.52,Default,غرفة التصوير4,0,0,0,,لقد جئت لأنني أريد أن أعيش.
Dialogue: 0,0:49:11.82,0:49:15.06,Default,tyra4,0,0,0,,عندما لا أراك، أشعر وكأنني سأموت من القلق.
Dialogue: 0,0:49:16.96,0:49:18.43,Default,معرض التصوير4,0,0,0,,انسى وأعود.
Dialogue: 0,0:49:19.69,0:49:20.90,Default,معرض التصوير4,0,0,0,,لا يا ملكة.
Dialogue: 0,0:49:21.00,0:49:23.36,Default,معرض التصوير4,0,0,0,,إذا كنت تريد الذهاب بمفردك، فسيتعين عليك أن تدوس علي.
Dialogue: 0,0:49:32.91,0:49:34.51,Default,معرض التصوير4,0,0,0,,بقي أربعة أيام.
Dialogue: 0,0:49:36.94,0:49:38.68,Default,معرض التصوير4,0,0,0,,التتويج في أربعة أيام.
Dialogue: 0,0:49:38.68,0:49:40.95,Default,معرض التصوير4,0,0,0,,كيف تبحث في غابة بأكملها
Dialogue: 0,0:49:40.95,0:49:43.05,Default,معرض الرماية4,0,0,0,,وهل ستجد الملك لوحدك؟
Dialogue: 0,0:49:45.92,0:49:47.16,Default,معرض التصوير4,0,0,0,,هل تبتسم الآن؟
Dialogue: 0,0:49:47.39,0:49:48.59,Default,معرض التصوير4,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:49:49.02,0:49:50.93,Default,معرض الرماية4,0,0,0,,هناك العديد من الحيوانات البرية في الجبال.
Dialogue: 0,0:49:50.93,0:49:52.63,Default,معرض التصوير4,0,0,0,,لن تدوم طويلاً هناك.
Dialogue: 0,0:49:52.86,0:49:54.60,Default,معرض الرماية4,0,0,0,,يمكن للذئاب أن تأكلك.
Dialogue: 0,0:49:55.30,0:49:57.97,Default,معرض الرماية4,0,0,0,,وإلا قد يجد المحاربون جثتك المجمدة.
Dialogue: 0,0:49:58.70,0:50:02.47,Default,معرض التصوير4,0,0,0,,كيف ذلك. مخيف جدا! أنا أرتجف حرفيًا من الخوف.
Dialogue: 0,0:50:02.47,0:50:04.01,Default,معرض التصوير4,0,0,0,,قل ما تريد: لا تخيفني.
Dialogue: 0,0:50:05.17,0:50:06.21,Default,معرض التصوير4,0,0,0,,دعونا نعود.
Dialogue: 0,0:50:06.41,0:50:08.58,Default,tyra4,0,0,0,,لأن الملكة لا تريدنا أن نذهب معها،
Dialogue: 0,0:50:08.58,0:50:11.48,Default,معرض التصوير4,0,0,0,,سوف نعاقب لعدم قدرتنا على إيقافها،
Dialogue: 0,0:50:11.71,0:50:14.52,Default,tyra4,0,0,0,,سيجبرنا على شرب كأس السم،
Dialogue: 0,0:50:15.28,0:50:17.85,Default,معرض التصوير4,0,0,0,,وسنغرق في النوم الأبدي.
Dialogue: 0,0:50:32.33,0:50:34.30,Default,معرض التصوير4,0,0,0,,حسنًا. يمكنك أن تأتي معي.
Dialogue: 0,0:50:38.11,0:50:39.37,Default,معرض التصوير4,0,0,0,,هذه ليست إجازة،
Dialogue: 0,0:50:39.37,0:50:40.41,Default,معرض التصوير4,0,0,0,,لماذا تحتاجه؟
Dialogue: 0,0:50:40.74,0:50:43.08,Default,معرض الرماية4,0,0,0,,كيف ستجتاز القلعة في هانيانغ؟
Dialogue: 0,0:50:44.21,0:50:47.22,Default,معرض الرماية4,0,0,0,,ظننت أنني أستطيع القفز فوق الجدار فحسب،
Dialogue: 0,0:50:47.22,0:50:49.15,Default,معرض التصوير4,0,0,0,,ولكن الآن بسببك لن تسير الأمور بهذه الطريقة.
Dialogue: 0,0:50:49.22,0:50:53.59,Default,معرض الرماية4,0,0,0,,القلعة في هانيانغ مرتفعة جداً، كيف يمكنك القفز فوقها؟
Dialogue: 0,0:50:55.19,0:50:56.52,Default,معرض التصوير4,0,0,0,,هل تضحك عليّ مرة أخرى؟
Dialogue: 0,0:50:58.36,0:51:01.43,Default,معرض التصوير4,0,0,0,,لقد اهتممنا بكل شيء بالفعل. ليس لديك ما يدعو للقلق.
Dialogue: 0,0:51:14.85,0:51:16.08,Default,معرض التصوير4,0,0,0,,جلالتك.
Dialogue: 0,0:51:25.37,0:51:26.91,Default,معرض التصوير4,0,0,0,,ظننت أننا سنحتفل،
Dialogue: 0,0:51:27.41,0:51:29.51,Default,tier4,0,0,0,,ولكن بالحكم على وجهك، فإنك تغسل الهزيمة.
Dialogue: 0,0:51:29.68,0:51:31.51,Default,tyra4,0,0,0,,ما هو الجرح الذي يمكنك شفاءه بهذه الطريقة؟
Dialogue: 0,0:51:31.97,0:51:33.47,Default,معرض الرماية4,0,0,0,,أين تأذيت؟
Dialogue: 0,0:51:35.72,0:51:38.49,Default,معرض التصوير4,0,0,0,,المس كوبي مرة أخرى،
Dialogue: 0,0:51:38.95,0:51:41.49,Default,tyra4,0,0,0,,وسأقطع يدك.
Dialogue: 0,0:51:46.36,0:51:48.43,Default,tyra4,0,0,0,,إذا كنت تحبها كثيراً،
Dialogue: 0,0:51:48.82,0:51:50.66,Default,tyra4,0,0,0,,ألم يكن عليّ أن أفهم،
Dialogue: 0,0:51:50.89,0:51:52.74,Default,tyra4,0,0,0,,أن كيم سو يون قد تغيرت؟
Dialogue: 0,0:51:53.37,0:51:56.26,Default,tyra4,0,0,0,,الليلة الماضية كان يشبهك تماماً.
Dialogue: 0,0:51:58.91,0:52:01.37,Default,معرض التصوير4,0,0,0,,ماذا؟ حب؟
Dialogue: 0,0:52:02.20,0:52:03.70,Default,معرض الرماية4,0,0,0,,يا له من رجس!
Dialogue: 0,0:52:04.18,0:52:05.55,Default,معرض التصوير4,0,0,0,,أنا بالفعل في حيرة من أمري،
Dialogue: 0,0:52:05.55,0:52:06.91,Default,معرض التصوير4,0,0,0,,وأنت تتحدث عن الحب هنا.
Dialogue: 0,0:52:29.91,0:52:31.11,Default,معرض التصوير4,0,0,0,,لقد تأخرت.
Dialogue: 0,0:52:32.70,0:52:34.34,Default,معرض التصوير4,0,0,0,,اذهب إلى غرفتك واستريح.
Dialogue: 0,0:52:34.70,0:52:37.14,Default,معرض التصوير4,0,0,0,,الموقد قيد التشغيل، لذا سيكون دافئًا.
Dialogue: 0,0:52:37.55,0:52:40.22,Default,tyra4,0,0,0,,لماذا لا تسأل أي شيء؟
Dialogue: 0,0:52:41.09,0:52:42.78,Default,tyra4,0,0,0,,لأنني أب.
Dialogue: 0,0:52:53.03,0:52:54.93,Default,معرض التصوير4,0,0,0,,ماذا فعلوا؟
Dialogue: 0,0:52:54.93,0:52:57.70,Default,shooting4,0,0,0,,رسالة تتضمن خطة للخيانة.
Dialogue: 0,0:52:58.09,0:53:00.87,Default,التصويب4,0,0,0,,بدون علمي؟ إنه أمر محفوف بالمخاطر للغاية.
Dialogue: 0,0:53:00.87,0:53:02.91,Default,معرض الرماية4,0,0,0,,بمجرد أن نحصل عليه، سيصبح سلاحنا،
Dialogue: 0,0:53:02.91,0:53:04.24,Default,tier4,0,0,0,,فلا تقلق.
Dialogue: 0,0:53:04.64,0:53:06.43,Default,معرض التصوير4,0,0,0,,سأحضره لك.
Dialogue: 0,0:53:06.74,0:53:08.05,Default,tyra4,0,0,0,,أنت متهم بالخيانة.
Dialogue: 0,0:53:08.05,0:53:10.41,Default,معرض الرماية4,0,0,0,,إذا عدت مباشرة بعد اختفاء الملك،
Dialogue: 0,0:53:11.87,0:53:13.24,Default,معرض التصوير4,0,0,0,,سيكون هذا مريبًا.
Dialogue: 0,0:53:13.72,0:53:15.59,Default,معرض التصوير4,0,0,0,,لا أريد العودة.
Dialogue: 0,0:53:16.24,0:53:18.01,Default,معرض التصوير4,0,0,0,,سأكون سعيداً،
Dialogue: 0,0:53:18.86,0:53:22.28,Default,معرض التصوير4,0,0,0,,إذا كان بإمكاني الاستمرار في مساعدتك من الظلال.
Dialogue: 0,0:53:25.62,0:53:29.12,Default,tyra4,0,0,0,,بالمناسبة، سمعت أن الملكة غادرت القصر ليلاً.
Dialogue: 0,0:53:29.97,0:53:32.39,Default,tyra4,0,0,0,,كيف تجرؤ على الهرب في منتصف الليل؟
Dialogue: 0,0:53:33.66,0:53:35.61,Default,tyra4,0,0,0,,لم أخبر أحداً بهذا الأمر،
Dialogue: 0,0:53:35.91,0:53:37.30,Default,tier4,0,0,0,,لكنك تعرف كل شيء بالفعل.
Dialogue: 0,0:53:37.47,0:53:40.24,Default,tyra4,0,0,0,,معرفة ما يمكن أن تكون عليه الملكة،
Dialogue: 0,0:53:40.70,0:53:42.91,Default,tyra4,0,0,0,,لا أعتقد أنها هربت للتو.
Dialogue: 0,0:53:43.68,0:53:44.82,Default,معرض التصوير4,0,0,0,,لماذا إذن؟
Dialogue: 0,0:53:45.84,0:53:49.51,Default,معرض الرماية4,0,0,0,,أنا متأكد من أنها تريد العثور على الملك لتعيد كل شيء إلى مكانه.
Dialogue: 0,0:53:50.34,0:53:54.68,Default,tyra4,0,0,0,,يجب أن تكون متأكدة من أن الملك على قيد الحياة.
Dialogue: 0,0:53:55.62,0:53:59.30,Default,tyra4,0,0,0,,لا بد أن لديها سببًا لتصديق ذلك.
Dialogue: 0,0:53:59.30,0:54:02.07,Default,tyra4,0,0,0,,خلعت فستانها وغادرت القصر،
Dialogue: 0,0:54:02.07,0:54:03.30,Default,tier4,0,0,0,,مما يعني
Dialogue: 0,0:54:04.49,0:54:07.03,Default,tyra4,0,0,0,,الآن هي مجرد امرأة عادية.
Dialogue: 0,0:54:07.30,0:54:09.20,Default,tyra4,0,0,0,,حتى مع العلم أنها تكذب،
Dialogue: 0,0:54:09.20,0:54:12.11,Default,tira4,0,0,0,,حاولت قبولها من أجل بيونين.
Dialogue: 0,0:54:13.53,0:54:15.97,Default,tyra4,0,0,0,,يبدو أن الزوجين الملكيين يحبان بعضهما البعض كثيراً،
Dialogue: 0,0:54:16.74,0:54:20.34,Default,tyra4,0,0,0,, فلماذا لا ندفنهم معًا.
Dialogue: 0,0:54:22.49,0:54:24.51,Default,معرض التصوير4,0,0,0,,هل تهتم بهذا؟
Dialogue: 0,0:54:36.57,0:54:37.59,Default,التصويب4,0,0,0,,سيد.
Dialogue: 0,0:54:37.97,0:54:40.87,Default,tyra4,0,0,0,,لقد عدت لمساعدة الملكة الأرملة.
Dialogue: 0,0:54:42.37,0:54:46.11,Default,tyra4,0,0,0,,هل هؤلاء هم المسؤولون عن وفاة الملك؟
Dialogue: 0,0:54:46.74,0:54:47.80,Default,tier4,0,0,0,,نعم.
Dialogue: 0,0:54:47.80,0:54:49.68,Default,tyra4,0,0,0,,نحن نجمع الأعشاب فقط.
Dialogue: 0,0:54:49.84,0:54:52.34,Default,tyra4,0,0,0,,لم نقابل الملك قط.
Dialogue: 0,0:54:53.24,0:54:56.34,Default,معرض الرماية4,0,0,0,,اتضح أن هذه المخلوقات بلا جذور
Dialogue: 0,0:54:56.72,0:54:59.01,Default,tyra4,0,0,0,,قبض على تنين دون أن يدرك ذلك.
Dialogue: 0,0:55:25.32,0:55:27.59,Default,معرض التصوير4,0,0,0,,لقد قفزت بشكل حاد، ويبدو أن كل شيء على ما يرام معك.
Dialogue: 0,0:55:28.14,0:55:29.55,Default,معرض الرماية4,0,0,0,,اعتقدت أنك ميت بالفعل.
Dialogue: 0,0:55:30.01,0:55:31.05,Default,معرض التصوير4,0,0,0,,من أنت؟
Dialogue: 0,0:55:31.05,0:55:33.59,Default,معرض التصوير4,0,0,0,,ما رأيك؟ من الواضح أن المعالج بالأعشاب.
Dialogue: 0,0:55:33.72,0:55:35.66,Default,معرض الرماية4,0,0,0,,وإلا لماذا سأعيش في الغابة؟
Dialogue: 0,0:55:37.43,0:55:38.99,Default,معرض التصوير4,0,0,0,,هل أنت من أنقذني؟
Dialogue: 0,0:55:39.86,0:55:43.32,Default,معرض التصوير4,0,0,0,,ليس حقًا. دعنا نقول فقط أنني وجدتك وأحضرتك إلى هنا.
Dialogue: 0,0:55:43.62,0:55:45.24,Default,tyra4,0,0,0,,كنت ترتدي ملابس باهظة الثمن،
Dialogue: 0,0:55:45.24,0:55:47.16,Default,tier4,0,0,0,,لذلك ظننتك
Dialogue: 0,0:55:47.16,0:55:49.01,Default,tyra4,0,0,0,,كافئني على إنقاذ حياتي.
Dialogue: 0,0:55:49.01,0:55:50.43,Default,معرض التصوير4,0,0,0,,عليك أن تدفع ثمن كل شيء، هل تعلم؟
Dialogue: 0,0:55:51.78,0:55:53.37,Default,معرض التصوير4,0,0,0,,ولكن ليس لديك شيء.
Dialogue: 0,0:55:53.74,0:55:56.11,Default,tyra4,0,0,0,,بدا القماش باهظ الثمن،
Dialogue: 0,0:55:56.11,0:55:58.82,Default,tier4,0,0,0,,لكنني لم أتمكن من بيع هذه الخرقة.
Dialogue: 0,0:56:00.18,0:56:01.49,Default,معرض التصوير4,0,0,0,,لقد أحرقت للتو كل شيء.
Dialogue: 0,0:56:02.78,0:56:03.78,Default,معرض التصوير4,0,0,0,,أحرق؟
Dialogue: 0,0:56:03.78,0:56:07.49,Default,معرض الرماية4,0,0,0,,هناك محاربون يسيرون في كل مكان ويبحثون عن شيء ما.
Dialogue: 0,0:56:09.45,0:56:11.93,Default,معرض التصوير4,0,0,0,,هل أنا مخطئ في إحضارك إلى هنا؟
Dialogue: 0,0:56:13.43,0:56:14.47,Default,معرض التصوير4,0,0,0,,جامع!
Dialogue: 0,0:56:16.20,0:56:18.26,Default,معرض التصوير4,0,0,0,,إذا هربت دون أن تدفع،
Dialogue: 0,0:56:18.26,0:56:20.09,Default,معرض التصوير4,0,0,0,,سأقطع يديك.
Dialogue: 0,0:56:21.74,0:56:22.84,Default,معرض التصوير4,0,0,0,,تذكر.
Dialogue: 0,0:56:34.72,0:56:36.41,Default,معرض التصوير4,0,0,0,,لقد أحضرت لك أفضلها.
Dialogue: 0,0:56:53.47,0:56:55.47,Default,معرض التصوير4,0,0,0,,إذن، إذن، وماذا بعد؟
Dialogue: 0,0:56:55.47,0:56:58.18,Default,tyra4,0,0,0,,لذا، أثناء الجنازة يستخدمون جثة شخص آخر.
Dialogue: 0,0:56:58.18,0:57:00.74,Default,tyra4,0,0,0,,إذا تمكنوا من إجراء التتويج خلال 6 أيام،
Dialogue: 0,0:57:01.55,0:57:02.57,Default,معرض التصويب4,0,0,0,,انتهت اللعبة.
Dialogue: 0,0:57:03.55,0:57:05.12,Default,معرض التصوير4,0,0,0,,كيف عرفت هذا؟
Dialogue: 0,0:57:05.12,0:57:07.34,Default,معرض التصوير4,0,0,0,,هؤلاء الحمقى يمكن التنبؤ بهم للغاية!
Dialogue: 0,0:57:08.09,0:57:10.84,Default,معرض الرماية4,0,0,0,,هؤلاء الأغبياء يستحقون العقاب!
Dialogue: 0,0:57:23.80,0:57:25.59,Default,Spilik,0,0,0,,هذا اعتراف أحد أتباع تونهاك.
Dialogue: 0,0:57:26.24,0:57:28.51,Default,Spilik,0,0,0,,لدي بالفعل فكرة عمن يجب أن ألومه على هذا.
Dialogue: 0,0:57:29.07,0:57:30.70,Default,Spilik,0,0,0,,ابحث عن اللحظة المناسبة بعد التتويج،
Dialogue: 0,0:57:30.70,0:57:32.01,Default,Spilik,0,0,0,,لإعلان ذلك.
Dialogue: 0,0:57:34.24,0:57:35.24,Default,Spillit,0,0,0,,أبتاه.
Dialogue: 0,0:57:37.82,0:57:40.91,Default,Spilik,0,0,0,,هل يمكنني أن أطلب منك الاعتناء بحرّاس القصر في الوقت الحالي؟
Dialogue: 0,0:57:41.74,0:57:42.89,Default,Spilik,0,0,0,,لماذا؟
Dialogue: 0,0:57:44.14,0:57:45.41,Default,Spillit,0,0,0,,أريد ذلك بنفسي
Dialogue: 0,0:57:47.18,0:57:49.95,Default,Spillit,0,0,0,,أحضر رأسي الملك والملكة.
Dialogue: 0,0:57:56.99,0:58:00.26,Default,Spilik,0,0,0,,قبل التتويج بثلاثة أيام
Dialogue: 0,0:58:02.30,0:58:03.34,Default,Spilik,0,0,0,,بنين!
Dialogue: 0,0:58:06.07,0:58:08.05,Default,Spilik,0,0,0,,هل أنت ذاهب للبحث عن الملكة؟
Dialogue: 0,0:58:09.07,0:58:11.28,Default,Spilik,0,0,0,,لماذا غادرت القصر؟
Dialogue: 0,0:58:11.28,0:58:14.14,Default,Spilik,0,0,0,,يجب أن تعرف السبب، أنت قريب جداً.
Dialogue: 0,0:58:14.95,0:58:18.51,Default,Spillit,0,0,0,,الملكة لم تعد سويون التي كنت أعرفها.
Dialogue: 0,0:58:19.41,0:58:20.41,Default,Spilik,0,0,0,,ماذا؟
Dialogue: 0,0:58:39.20,0:58:41.64,Default,Spilik,0,0,0,,يجب أن أعيد الملك.
Dialogue: 0,0:58:41.64,0:58:45.22,Default,Spillit,0,0,0,,نوع من القفل الهش. ربما أستطيع فتحه.
Dialogue: 0,0:58:52.28,0:58:54.16,Default,Spilik,0,0,0,,لا بد أن يكون هناك إمساك ثانٍ في مكان ما.
Dialogue: 0,0:58:54.39,0:58:55.78,Default,Spilik,0,0,0,,أنا مندهش أنك فتحته.
Dialogue: 0,0:58:55.78,0:58:56.95,Default,Spilik,0,0,0,,حضرة.
Dialogue: 0,0:59:02.39,0:59:04.16,Default,Spilik,0,0,0,,الأمير يونبيونغ، هل أنت بخير؟
Dialogue: 0,0:59:06.34,0:59:07.80,Default,Spilik,0,0,0,,كيف وصلت إلى هنا؟
Dialogue: 0,0:59:08.20,0:59:10.53,Default,Spilik,0,0,0,,كما تعلم، أنا صديق لكل من في القصر.
Dialogue: 0,0:59:11.30,0:59:14.70,Default,Spilik,0,0,0,,لقد تم حبسك هنا فقط لأنك أصدقاء الملك.
Dialogue: 0,0:59:15.68,0:59:16.87,Default,Spilik,0,0,0,,لا تقلق بشأن أي شيء.
Dialogue: 0,0:59:17.24,0:59:19.87,Default,Spilik,0,0,0,,سأخرجك مهما حدث.
Dialogue: 0,0:59:19.87,0:59:21.34,Default,Spilik,0,0,0,,أنت صديق حقيقي.
Dialogue: 0,0:59:22.24,0:59:25.66,Default,Spilik,0,0,0,,إخلاصك لا يتزعزع حتى في مثل هذا الوضع المحفوف بالمخاطر.
Dialogue: 0,0:59:26.51,0:59:27.59,Default,Spilik,0,0,0,,بالطبع.
Dialogue: 0,0:59:28.22,0:59:31.05,Default,Spilik,0,0,0,,لقد كونت صداقات معي ليس لأنني من آل كيم الأندونيين.
Dialogue: 0,0:59:31.55,0:59:34.99,Default,Spilik,0,0,0,,وأصبحت صديقاً لك ليس لأنك صديق مقرب من الملك.
Dialogue: 0,0:59:36.89,0:59:38.24,Default,Spilik,0,0,0,,-بالضبط.\N-الأمر هو،
Dialogue: 0,0:59:38.24,0:59:40.49,Default,Spikyulka,0,0,0,,أن هناك الآن فوضى عارمة في القصر،\N وخارجه.
Dialogue: 0,0:59:40.97,0:59:43.61,Default,Spilik,0,0,0,,يريدون إلصاق جريمة قتل الملك بأتباع تونهاك.
Dialogue: 0,0:59:44.57,0:59:46.68,Default,Spilik,0,0,0,,أخشى أن الأبرياء سيعانون.
Dialogue: 0,0:59:47.43,0:59:48.51,Default,Spillit,0,0,0,,حتى الملكة
Dialogue: 0,0:59:49.57,0:59:52.34,Default,Spillie,0,0,0,,اختفى فجأة في منتصف الليل.
Dialogue: 0,0:59:55.32,0:59:57.76,Default,Spillit,0,0,0,,ماذا تقصد بأن الملكة قد اختفت؟
Dialogue: 0,0:59:57.76,1:00:00.49,Default,Spillie,0,0,0,,اختفت من القصر
Dialogue: 0,1:00:01.12,1:00:03.36,Default,Spilik,0,0,0,,مع سيدة البلاط والخادمة.
Dialogue: 0,1:00:03.95,1:00:06.39,Default,بيريولكا,0,0,0,,بنين غادرت القصر للتو
Dialogue: 0,1:00:06.39,1:00:08.66,Default,Spillie,0,0,0,,للبحث عنها،
Dialogue: 0,1:00:09.80,1:00:11.99,Default,Spilik,0,0,0,,لكن مظهره أزعجني.
Dialogue: 0,1:00:11.99,1:00:13.24,Default,Spilik,0,0,0,,لماذا ازعجت نفسك؟
Dialogue: 0,1:00:13.24,1:00:15.41,Default,Spilik,0,0,0,,ربما أنا أختلق الأمر،
Dialogue: 0,1:00:16.24,1:00:17.34,Default,Spilik,0,0,0,,ولكنه كان يبدو هكذا،
Dialogue: 0,1:00:18.30,1:00:20.24,Default,Spilik,0,0,0,,كما لو أنه يريد تمزيقها إرباً.
Dialogue: 0,1:00:27.57,1:00:28.62,Default,Spillie,0,0,0,,أيها الأمهات.
Dialogue: 0,1:00:33.05,1:00:34.28,Default,Spilik,0,0,0,,ماذا؟ لماذا؟
Dialogue: 0,1:00:35.39,1:00:36.43,Default,Spilik,0,0,0,,ماذا؟
Dialogue: 0,1:00:41.57,1:00:42.59,Default,Spilik,0,0,0,,الآن كل شيء على ما يرام.
Dialogue: 0,1:00:43.89,1:00:44.97,Default,Spilik,0,0,0,,لنذهب.
Dialogue: 0,1:00:44.97,1:00:47.57,Default,Spillikins,0,0,0,,ما هذا يا سيدة تشوي؟ لقد أخافتني.
Dialogue: 0,1:00:50.01,1:00:51.74,Default,Spilik,0,0,0,,يجب أن تكون على أهبة الاستعداد دائمًا.
Dialogue: 0,1:00:53.03,1:00:54.18,Default,Spilik,0,0,0,,حسنًا.
Dialogue: 0,1:00:55.64,1:00:58.07,Default,Spilik,0,0,0,,أنت حذر دائمًا. يمر.
Dialogue: 0,1:00:59.24,1:01:00.51,Default,Spilik,0,0,0,,انطلق، تابع.
Dialogue: 0,1:01:01.34,1:01:02.45,Default,Spilik,0,0,0,,دعني أساعد.
Dialogue: 0,1:01:03.91,1:01:05.76,Default,Spilik,0,0,0,,يرجى توخي الحذر.
Dialogue: 0,1:01:06.05,1:01:09.45,Default,Spilik,0,0,0,,واو، لا أصدق أنك جلبت الكثير معك!
Dialogue: 0,1:01:09.78,1:01:10.86,Default,Spilik,0,0,0,,ما هذا؟
Dialogue: 0,1:01:11.43,1:01:13.03,Default,Spillit,0,0,0,,جذر الجرس المسكر.
Dialogue: 0,1:01:13.36,1:01:14.59,Default,Spillit,0,0,0,,جذر الجرس المسكر؟
Dialogue: 0,1:01:14.59,1:01:17.93,Default,Spilik,0,0,0,,لقد استلمتها من شخص مميز وأقدرها كثيراً.
Dialogue: 0,1:01:18.49,1:01:19.87,Default,Spilik,0,0,0,,يمكنك أن تأخذها يا صاحب الجلالة.
Dialogue: 0,1:01:20.07,1:01:21.70,Default,Spilik,0,0,0,,-إذن سأحاول واحدة.\N-بالطبع.
Dialogue: 0,1:01:24.41,1:01:26.93,Default,Spillit,0,0,0,,إنها معجزة كم هي لذيذة. جرب واحدة.
Dialogue: 0,1:01:26.93,1:01:28.11,Default,Spilik,0,0,0,,سيدة يونغ، وأنت؟
Dialogue: 0,1:01:28.61,1:01:30.30,Default,Spilik,0,0,0,,-حسناً، حسناً.\N-هنا، يمكنك تجربتها.
Dialogue: 0,1:01:30.30,1:01:31.32,Default,Spilik,0,0,0,,شكرًا لك.
Dialogue: 0,1:01:32.34,1:01:33.47,Default,Spillit,0,0,0,,هذا لذيذ جدًا.
Dialogue: 0,1:01:38.39,1:01:41.09,Default,Spillit,0,0,0,,سيدة البلاط تشوي! كيف ذلك؟
Dialogue: 0,1:01:41.09,1:01:42.45,Default,Spilik,0,0,0,,-أنا بخير.\N-هل أنت بخير؟
Dialogue: 0,1:01:45.30,1:01:46.72,Default,Spilik,0,0,0,,نعم، كل شيء على ما يرام.
Dialogue: 0,1:01:47.49,1:01:49.57,Default,Spilik,0,0,0,,يا إلهي، أنا بخير تماماً أيتها الملكة.
Dialogue: 0,1:01:49.99,1:01:51.12,Default,Spilik,0,0,0,,-استمر.\N-حسنًا!
Dialogue: 0,1:01:54.07,1:01:56.53,Default,Spilik,0,0,0,,أين الملك؟
Dialogue: 0,1:01:58.74,1:02:00.84,Default,Spilik,0,0,0,,يا صاحب الجلالة، لقد نشأت مثل زهرة رقيقة.
Dialogue: 0,1:02:00.84,1:02:02.74,Default,Spilik,0,0,0,,هل أنت مرتاح حقاً في النوم بهذه الطريقة؟
Dialogue: 0,1:02:03.20,1:02:04.91,Default,Spilik,0,0,0,,نعم. لقد فعلت هذا عدة مرات.
Dialogue: 0,1:02:06.22,1:02:07.51,Default,Spilik,0,0,0,,حقاً؟ أنت؟
Dialogue: 0,1:02:08.09,1:02:09.51,Default,Spilik,0,0,0,,حتى أنني لم أضطر إلى ذلك من قبل.
Dialogue: 0,1:02:09.91,1:02:11.91,Default,Spillie,0,0,0,,أسقطه. هذا هراء.
Dialogue: 0,1:02:11.91,1:02:14.01,Default,Biryulka,0,0,0,,هل قمت بمسيرة إجبارية لمسافة 400 كيلومتر بحمولة 50 كجم؟
Dialogue: 0,1:02:14.68,1:02:15.78,Default,Spilyk,0,0,0,,400 كيلومتر؟
Dialogue: 0,1:02:20.09,1:02:22.32,Default,Spilik,0,0,0,,يا له من حالم. 400 كم؟ تعال.
Dialogue: 0,1:02:23.49,1:02:25.43,Default,Spilik,0,0,0,,حسناً، نعم، لقد بالغت قليلاً.
Dialogue: 0,1:02:25.43,1:02:26.74,Default,Spilik,0,0,0,,لكنها بالتأكيد تجاوزت 200.
Dialogue: 0,1:02:26.74,1:02:29.11,Default,Spikilka,0,0,0,,خلال العمليات الشتوية قمنا بإذابة الثلج وشربنا...
Dialogue: 0,1:02:30.57,1:02:33.61,Default,Spilik,0,0,0,,حسناً، نعم، حسناً، نعم. نحن نؤمن، نؤمن.
Dialogue: 0,1:02:34.80,1:02:37.20,Default,Spilik,0,0,0,,مرحبًا! أنا جاد تماما!
Dialogue: 0,1:02:37.20,1:02:39.51,Default,Spilik,0,0,0,,بالطبع يا صاحب الجلالة.
Dialogue: 0,1:02:39.51,1:02:41.24,Default,Spillit,0,0,0,,لا أريدك أن تصاب بالبرد.
Dialogue: 0,1:02:42.78,1:02:44.91,Default,Spilik,0,0,0,,لا يمكننا حتى إشعال النار دون أن يتم أسرنا.
Dialogue: 0,1:02:45.51,1:02:47.95,Default,Spilik,0,0,0,,أنا قلقة بشأن الطريقة التي سننام بها في مثل هذه الليلة الباردة.
Dialogue: 0,1:02:48.76,1:02:50.78,Default,Spilik,0,0,0,,من المؤسف أنك تمرين بهذا يا ملكة.
Dialogue: 0,1:02:51.43,1:02:53.30,Default,Spilik,0,0,0,,هذا هراء. وليس باردا على الإطلاق.
Dialogue: 0,1:02:53.45,1:02:55.47,Default,Spilyk,0,0,0,,لا شيء يضاهي عملياتنا الشتوية.
Dialogue: 0,1:02:58.20,1:02:59.39,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,1:03:26.49,1:03:28.37,Default,Spilik,0,0,0,,أطفئ مكيف الهواء، حسناً؟
Dialogue: 0,1:03:29.39,1:03:31.76,Default,Spillit,0,0,0,,قد أصاب بالبرد.
Dialogue: 0,1:04:30.53,1:04:31.66,Default,Spilik,0,0,0,,لم نجدها.
Dialogue: 0,1:04:32.45,1:04:34.49,Default,Spilik,0,0,0,,انقسموا إلى مجموعات ومشطوا الجبل بأكمله.
Dialogue: 0,1:04:34.72,1:04:35.72,Default,Spilik,0,0,0,,-نعم!\N-نعم!
Dialogue: 0,1:04:58.86,1:05:01.09,Default,Spilik,0,0,0,,لسبب ما، لدي شعور جيد اليوم.
Dialogue: 0,1:05:01.86,1:05:05.59,Default,Spilik,0,0,0,,مع ضوء الشمس هذا، أعتقد أننا سنجد الملك اليوم.
Dialogue: 0,1:05:16.47,1:05:18.93,Default,Spilik,0,0,0,,- ليس لدينا وقت لهذا. المضي قدما.\N-نعم، هذا صحيح.
Dialogue: 0,1:05:20.11,1:05:21.24,Default,Spilik,0,0,0,,-دعونا نسرع.\N-علينا أن نسرع.
Dialogue: 0,1:05:21.95,1:05:24.91,Default,Spilik,0,0,0,,-هل هذا هو الطريق؟\N-نعم يا ملكة. دعونا نمضي قدما.
Dialogue: 0,1:05:29.01,1:05:30.34,Default,Spilik,0,0,0,,نحن على وشك الوصول.
Dialogue: 0,1:05:30.34,1:05:32.76,Default,Spillit,0,0,0,,قريباً سنصل إلى الهاوية.
Dialogue: 0,1:05:33.12,1:05:35.68,Default,Spilik,0,0,0,,أنت من تكون واثقًا جدًا في العشرينيات من عمرك.
Dialogue: 0,1:05:36.26,1:05:37.53,Default,Spilik,0,0,0,,الطاقة تندفع!
Dialogue: 0,1:05:39.09,1:05:41.53,Default,Spilik,0,0,0,,-دعنا نأخذ استراحة قصيرة.\N-نعم، يا صاحب الجلالة.
Dialogue: 0,1:05:51.01,1:05:53.93,Default,Spilik,0,0,0,,يجب أن أقول، العالم أكثر إشراقاً الآن،
Dialogue: 0,1:05:54.68,1:05:57.45,Default,Spilik,0,0,0,,عندما نكون خارج القصر أيتها الملكة.
Dialogue: 0,1:05:59.74,1:06:02.12,Default,Spilik,0,0,0,,وقبل أن تكره مغادرة القصر.
Dialogue: 0,1:06:02.28,1:06:03.28,Default,Spilik,0,0,0,,حسناً، نعم.
Dialogue: 0,1:06:05.05,1:06:06.05,Default,Spilik,0,0,0,,وأنت هونغ يونغ؟
Dialogue: 0,1:06:06.26,1:06:07.99,Default,Spilik,0,0,0,,أيهما تفضل؟\Nالقصر أم خارجه؟
Dialogue: 0,1:06:08.86,1:06:10.53,Default,Spilik,0,0,0,,أين أنت يا صاحب الجلالة.
Dialogue: 0,1:06:11.28,1:06:13.53,Default,Spilik,0,0,0,,-هذا ما قالته.\N-مرحبًا، توقف عن ذلك.
Dialogue: 0,1:06:18.14,1:06:20.07,Default,Spilik,0,0,0,,الملكة، إنهم هنا.
Dialogue: 0,1:06:21.66,1:06:23.16,Default,Spilik,0,0,0,,ها هم. الاستيلاء عليها!
Dialogue: 0,1:06:23.16,1:06:24.51,Default,Spilik,0,0,0,,اركض، عليك أن تختبئ!
Dialogue: 0,1:06:24.51,1:06:25.70,Default,Spilik,0,0,0,,-حسنًا.\N-Run!
Dialogue: 0,1:06:28.57,1:06:30.51,Default,Spilik,0,0,0,,حضرة يونغ، رافق الملكة. يجري!
Dialogue: 0,1:06:31.07,1:06:33.28,Default,Spillit,0,0,0,,سيدة تشوي، إلى أين أنت ذاهبة؟ أين؟
Dialogue: 0,1:06:34.01,1:06:36.72,Default,Spilik,0,0,0,,إياكم أن تجرؤوا أيها المهوسون! لن أسمح بذلك!
Dialogue: 0,1:06:36.72,1:06:38.12,Default,Spilik,0,0,0,,جلالتك، يجب أن نركض.
Dialogue: 0,1:06:38.45,1:06:40.62,Default,Spillit,0,0,0,,-سيدة المحكمة تشوي!\N-لن أسمح لك بالدخول!
Dialogue: 0,1:06:40.62,1:06:41.78,Default,Spillie,0,0,0,,دعني أذهب!
Dialogue: 0,1:06:43.36,1:06:44.53,Default,Spilik,0,0,0,,جلالتك...
Dialogue: 0,1:06:47.55,1:06:48.57,Default,Spilik,0,0,0,,لا!
Dialogue: 0,1:06:49.76,1:06:51.37,Default,Spilik,0,0,0,,العودة!
Dialogue: 0,1:07:04.95,1:07:06.24,Default,Spillit,0,0,0,,-سيدة البلاط تشوي!\N-Queen!
Dialogue: 0,1:07:06.74,1:07:07.84,Default,Spilik,0,0,0,,لا، من فضلك!
Dialogue: 0,1:07:09.84,1:07:10.84,Default,Spilik,0,0,0,,خذهم!
Dialogue: 0,1:07:11.18,1:07:12.59,Default,Spilik,0,0,0,,أتوسل إليك، توقف.
Dialogue: 0,1:07:14.38,1:07:16.96,Default,Spilik,0,0,0,,لا! لا حاجة.
Dialogue: 0,1:07:16.96,1:07:20.20,Default,Spillit,0,0,0,,-السيدة تشوي!\N-Queen! لو سمحت...
Dialogue: 0,1:07:20.92,1:07:24.50,Default,Spillit,0,0,0,,-السيدة تشوي!\N-No. لا!
Dialogue: 0,1:07:26.33,1:07:30.33,Default,Spilik,0,0,0,,-لا! سيدة المحكمة تشوي!\N-We يجب الهروب، الملكة!
Dialogue: 0,1:07:30.63,1:07:31.88,Default,Spillit,0,0,0,,سيدة البلاط تشوي!
Dialogue: 0,1:07:34.28,1:07:35.34,Default,Spilik,0,0,0,,جلالتك!
Dialogue: 0,1:07:35.71,1:07:39.92,Default,Spillit,0,0,0,,اركض! الملكة، أتوسل إليك، تشغيل!
Dialogue: 0,1:07:50.83,1:07:52.72,Default,Spilik,0,0,0,,يا صاحب الجلالة، أتمنى أن تجد الملك.
Dialogue: 0,1:07:57.17,1:07:58.33,Default,Spillit,0,0,0,,عزيزتي يونغ!
Dialogue: 0,1:07:59.26,1:08:00.33,Default,Spillie,0,0,0,,اتبعها!
Dialogue: 0,1:09:22.21,1:09:23.51,Default,Spilik,0,0,0,,من أنت؟
Dialogue: 0,1:09:25.25,1:09:28.08,Default,Spilik,0,0,0,,ماذا فعلت مع سويون؟
Dialogue: 0,1:09:43.63,1:09:47.91,Default,Spillit,0,0,0,,كيف أصبحت ملكة
Dialogue: 0,1:10:07.86,1:10:10.29,Default,Spilik,0,0,0,,لقد قلت أنك تعرف كل شيء عني وعن سويون.
Dialogue: 0,1:10:11.59,1:10:13.00,Default,Spilik,0,0,0,,فجأة عادوا إليّ
Dialogue: 0,1:10:13.17,1:10:14.29,Default,Spilik,0,0,0,,كل ذكرياتها.
Dialogue: 0,1:10:18.50,1:10:21.30,Default,Spilik,0,0,0,,لا تزال سويون تعيش بداخلك إذا تم الحفاظ على ذكرياتها.
Dialogue: 0,1:10:21.50,1:10:24.00,Default,Spilik,0,0,0,,أمسك بيدي حتى تخرج سالماً.
Dialogue: 0,1:10:24.00,1:10:27.01,Default,Spilik,0,0,0,,كنت أعرف ذلك. أنت تفكر في نفسك فقط.
Dialogue: 0,1:10:29.54,1:10:30.62,Default,Spilik,0,0,0,,خذهم.
Dialogue: 0,1:10:31.68,1:10:32.92,Default,Spillit,0,0,0,,اتبع الملكة!
Dialogue: 0,0:15:38.67,0:15:40.67,Default,,0,0,0,,

التعليق: 0,0:39:42.84,0:39:43.84,Default,Lily3,0,0,0,,حسنًا.
Comment: 0,0:41:02.82,0:41:04.22,Default,Lily3,0,0,0,,إزاحة الملك أو الإطاحة به
