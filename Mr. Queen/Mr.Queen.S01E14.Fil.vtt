Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Pineapple, To
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.22,0:01:06.28,Default,Lily1,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.28,0:01:08.51,Default,Lilia1,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:01:14.05,0:01:16.85,Default,Lily1,0,0,0,,Malaki ang utang ko sa iyo.
Dialogue: 0,0:01:19.92,0:01:21.93,Default,Lily1,0,0,0,,Iniisip kita,
Dialogue: 0,0:01:23.73,0:01:25.60,Default,Lilia1,0,0,0,,nang sinubukan niyang umalis sa palasyo.
Dialogue: 0,0:01:28.97,0:01:31.00,Default,Lilia1,0,0,0,,Akala ko hindi na kita makikita.
Dialogue: 0,0:01:58.33,0:02:00.60,Default,Lily1,0,0,0,,Isang oras na mas maaga
Dialogue: 0,0:02:06.34,0:02:08.64,Default,Lily1,0,0,0,,Spiral Potatoes
Dialogue: 0,0:02:10.57,0:02:15.41,Default,Lily1,0,0,0,,Natutulog ka ba?
Dialogue: 0,0:02:25.09,0:02:28.36,Default,Lily1,0,0,0,,Oo. Isinulat ko ito.
Dialogue: 0,0:02:30.13,0:02:32.40,Default,Lilia1,0,0,0,,Isinulat mo ba talaga ito?
Dialogue: 0,0:02:32.73,0:02:34.00,Default,Lily1,0,0,0,,Hindi reyna?
Dialogue: 0,0:02:34.16,0:02:37.63,Default,Lily1,0,0,0,,Nasa kapistahan ang Reyna.
Dialogue: 0,0:02:38.07,0:02:40.10,Default,Lily1,0,0,0,,Kung gayon bakit ka nag-file
Dialogue: 0,0:02:40.10,0:02:42.91,Default,Lily1,0,0,0,,wild grapes, pine needles at peach?
Dialogue: 0,0:02:43.34,0:02:47.14,Default,Lily1,0,0,0,,Peach season lang,
Dialogue: 0,0:02:47.14,0:02:49.25,Default,Lily1,0,0,0,,nagsisimula na ang ligaw na panahon ng ubas,
Dialogue: 0,0:02:49.25,0:02:51.35,Default,Lily1,0,0,0,,at may mga pine needles sa buong taon.
Dialogue: 0,0:02:51.75,0:02:52.82,Default,Lily1,0,0,0,,Manbok.
Dialogue: 0,0:02:53.98,0:02:55.69,Default,Lily1,0,0,0,,Tingnan mo ako sa mga mata at sabihin mo sa akin.
Dialogue: 0,0:03:10.00,0:03:14.34,Default,Lily1,0,0,0,,Hindi gustong malaman ng Reyna na tinutulungan ka niya.
Dialogue: 0,0:03:20.24,0:03:22.91,Default,Lily1,0,0,0,,Huli na. Bumalik ka dito bukas.
Dialogue: 0,0:03:25.78,0:03:27.25,Default,Lily1,0,0,0,,Bumalik ka sa iyong sarili.
Dialogue: 0,0:03:27.95,0:03:30.85,Default,Lily1,0,0,0,,Aalamin ko kung bakit niya ako tinulungan
Dialogue: 0,0:03:31.79,0:03:33.59,Default,Lilia1,0,0,0,,at ano ang ibig sabihin ng kanyang mga salita na ipagkanulo niya ako.
Dialogue: 0,0:03:42.40,0:03:44.67,Default,Lily1,0,0,0,,Reyna
Dialogue: 0,0:04:06.86,0:04:09.09,Default,Lily1,0,0,0,,Nasa panganib ang Reyna.
Dialogue: 0,0:04:17.57,0:04:20.20,Default,Lily1,0,0,0,,Kapag madaling araw, ipapaalam ko sa hari.
Dialogue: 0,0:04:20.50,0:04:21.67,Default,Lily1,0,0,0,,Magiging okay ba siya?
Dialogue: 0,0:04:21.81,0:04:24.41,Default,Lily1,0,0,0,,Maghintay ka. Ito ay maaaring isang bitag.
Dialogue: 0,0:04:41.16,0:04:44.29,Default,Lily1,0,0,0,,Minsan natutulog ka na parang sanggol.
Dialogue: 0,0:04:46.93,0:04:49.13,Default,Lily1,0,0,0,,Nakatulog yata ako.
Dialogue: 0,0:04:53.64,0:04:56.27,Default,Lily1,0,0,0,,Inalagaan mo ba ako?
Dialogue: 0,0:04:59.01,0:05:01.24,Default,Lily1,0,0,0,,Bakit palagi mong ginagawa ito?
Dialogue: 0,0:05:02.78,0:05:06.42,Default,Lily1,0,0,0,,Nag-aalala tungkol sa akin, sinusubukang intindihin ako.
Dialogue: 0,0:05:07.85,0:05:12.69,Default,Lily1,0,0,0,,Pag-isipan mo, ikaw ang unang taong nakita ko nang pumunta ako dito.
Dialogue: 0,0:05:18.40,0:05:21.06,Default,Lily1,0,0,0,,Malaki ang utang ko sa iyo.
Dialogue: 0,0:05:24.33,0:05:26.24,Default,Lily1,0,0,0,,Iniisip kita,
Dialogue: 0,0:05:28.04,0:05:29.87,Default,Lily1,0,0,0,,nang sinubukan niyang umalis sa palasyo.
Dialogue: 0,0:05:30.94,0:05:32.94,Default,Lily1,0,0,0,,Akala ko hindi na kita makikita.
Dialogue: 0,0:06:42.05,0:06:44.21,Default,Lily1,0,0,0,,Hon Young.
Dialogue: 0,0:06:47.68,0:06:50.12,Default,Lily1,0,0,0,,Mukhang marami kang nagsasanay.
Dialogue: 0,0:06:50.55,0:06:52.09,Default,Lily1,0,0,0,,So pumped up.
Dialogue: 0,0:07:06.97,0:07:08.14,Default,Lily1,0,0,0,,Ito ay isang panaginip.
Dialogue: 0,0:07:08.31,0:07:09.71,Default,Lily1,0,0,0,,Bumaling sa kanya si Hong Young
Dialogue: 0,0:07:09.71,0:07:11.31,Default,Lily1,0,0,0,,huling beses sa panaginip ko.
Dialogue: 0,0:07:13.41,0:07:14.78,Default,Lily1,0,0,0,,Gising ka na ba?
Dialogue: 0,0:07:27.46,0:07:29.39,Default,Lily1,0,0,0,,Ano ito? anong ginagawa mo
Dialogue: 0,0:07:29.39,0:07:33.73,Default,Lily1,0,0,0,,Ano ang nangyari? Sino ang nanakit sa aking reyna?
Dialogue: 0,0:07:34.56,0:07:36.73,Default,Lily1,0,0,0,,Ikaw. Sinaktan mo ako.
Dialogue: 0,0:07:39.37,0:07:41.30,Default,Lily1,0,0,0,,Bakit napalitan ang mukha niya ng mukha mo?
Dialogue: 0,0:07:41.84,0:07:42.84,Default,Lily1,0,0,0,,Ano?
Dialogue: 0,0:07:44.01,0:07:45.11,Default,Lily1,0,0,0,,Maging tapat ka sa akin.
Dialogue: 0,0:07:45.38,0:07:47.48,Default,Lily1,0,0,0,,Ano ang nangyari sa pagitan namin sa gabi?
Dialogue: 0,0:07:47.84,0:07:49.71,Default,Lily1,0,0,0,,Gaano ba ako dapat maging tapat?
Dialogue: 0,0:07:49.71,0:07:52.12,Default,Lily1,0,0,0,,Sabihin ang lahat, walang iwanan.
Dialogue: 0,0:07:55.45,0:07:58.15,Default,Lily1,0,0,0,,Lord. Ito ay isang kakaibang kahilingan.
Dialogue: 0,0:08:00.06,0:08:01.42,Default,Lily1,0,0,0,,Kung iyon ang gusto mo...
Dialogue: 0,0:08:04.53,0:08:07.66,Default,Lily1,0,0,0,,Nang maliwanagan ng buwan ang madilim na kalangitan kagabi,
Dialogue: 0,0:08:07.66,0:08:10.83,Default,Lily1,0,0,0,,medyo nagdikit ang aming mga kamay, pagkatapos ay paputok...
Dialogue: 0,0:08:10.83,0:08:13.60,Default,Lily1,0,0,0,,Tumahimik. Kapag may sinabi ka, papatayin kita.
Dialogue: 0,0:08:13.60,0:08:14.67,Default,Lily1,0,0,0,,Pero...
Dialogue: 0,0:08:15.67,0:08:17.67,Default,Lily1,0,0,0,,Umpisa pa lang ito, aking reyna.
Dialogue: 0,0:08:19.34,0:08:20.48,Default,Lily1,0,0,0,,My queen.
Dialogue: 0,0:08:21.28,0:08:22.48,Default,Lily1,0,0,0,,Lord.
Dialogue: 0,0:08:26.88,0:08:27.98,Default,Lily1,0,0,0,,Feeling,
Dialogue: 0,0:08:28.95,0:08:31.92,Default,Lily1,0,0,0,,parang ako ay inabandona.
Dialogue: 0,0:08:32.39,0:08:33.86,Default,Lily1,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:08:35.26,0:08:36.29,Default,Lily1,0,0,0,,Punong Eunuch.
Dialogue: 0,0:08:36.29,0:08:38.70,Default,Lily1,0,0,0,,Hon Young. Hong Young.
Dialogue: 0,0:08:39.60,0:08:40.86,Default,Lily1,0,0,0,,Saan ka natulog ngayon?
Dialogue: 0,0:08:41.36,0:08:42.83,Default,Lily1,0,0,0,,Sa bahay, Kamahalan.
Dialogue: 0,0:08:44.90,0:08:47.07,Default,Lily1,0,0,0,,Kami talaga ni Cheoljong...
Dialogue: 0,0:09:12.33,0:09:15.37,Default,Lily1,0,0,0,,14 episode. Ang babaeng dapat mamatay para mabuhay
Dialogue: 0,0:09:24.21,0:09:26.04,Default,Lily1,0,0,0,,Panaginip lang ang lahat.
Dialogue: 0,0:09:27.38,0:09:29.58,Default,Lily1,0,0,0,,Nasusunog ang larawan ng yumaong hari,
Dialogue: 0,0:09:29.81,0:09:31.88,Default,Lily1,0,0,0,,at parang totoo ang lahat.
Dialogue: 0,0:09:33.05,0:09:34.98,Default,Lily1,0,0,0,,Pagkatapos ng nangyari sa manghuhula,
Dialogue: 0,0:09:34.98,0:09:36.92,Default,Lily1,0,0,0,,Hindi ko mahulaan ang aking kapalaran.
Dialogue: 0,0:09:40.86,0:09:42.03,Default,Lily1,0,0,0,,Ominous premonition.
Dialogue: 0,0:09:42.63,0:09:45.56,Default,Lily1,0,0,0,,Court lady Khan. Kailangan kong hulaan ang kapalaran.
Dialogue: 0,0:09:46.46,0:09:49.07,Default,Lily1,0,0,0,,Kamahalan. Magdudulot na naman ito ng problema sa iyo.
Dialogue: 0,0:09:49.43,0:09:51.20,Default,Lily1,0,0,0,,May kilala akong monghe.
Dialogue: 0,0:09:52.60,0:09:55.34,Default,Lily1,0,0,0,,Hindi ito magmukhang kahina-hinala.
Dialogue: 0,0:10:00.18,0:10:04.95,Default,Lily1,0,0,0,,Nang si Avalokitesvara ay nagsanay ng malalim na Prajnaparamita,
Dialogue: 0,0:10:04.95,0:10:08.05,Default,Lily1,0,0,0,,inilawan niya ang limang skandha at nakita niyang wala silang laman...
Dialogue: 0,0:10:12.22,0:10:13.32,Default,Lily1,0,0,0,,Ano ang nakikita mo?
Dialogue: 0,0:10:13.32,0:10:16.79,Default,Lily1,0,0,0,,Nakikita ko na ang palasyo ay puno ng iskarlata na dugo.
Dialogue: 0,0:10:17.49,0:10:18.83,Default,Lily1,0,0,0,,Scarlet blood?
Dialogue: 0,0:10:20.23,0:10:21.73,Default,Lily1,0,0,0,,Ngayon isang tao
Dialogue: 0,0:10:22.53,0:10:24.17,Default,Lily1,0,0,0,,mamamatay sa palasyo.
Dialogue: 0,0:10:26.50,0:10:27.97,Default,Lily1,0,0,0,,At sino?
Dialogue: 0,0:10:28.44,0:10:30.61,Default,Lily1,0,0,0,,Hindi ko alam kung sino ito,
Dialogue: 0,0:10:38.48,0:10:39.75,Default,Lily1,0,0,0,,pero magiging babae ito.
Dialogue: 0,0:10:40.25,0:10:41.35,Default,Lily1,0,0,0,,Babae?
Dialogue: 0,0:10:43.55,0:10:45.16,Default,Lily1,0,0,0,,Talaga
Dialogue: 0,0:10:46.26,0:10:47.76,Default,Lily1,0,0,0,,ako ba?
Dialogue: 0,0:10:47.92,0:10:51.09,Default,Lily1,0,0,0,,Iguhit mo ako ng anting-anting para sa proteksyon.
Dialogue: 0,0:10:51.09,0:10:53.80,Default,Lily1,0,0,0,,Hindi ako shaman.
Dialogue: 0,0:10:54.13,0:10:56.20,Default,Lily1,0,0,0,,Dapat may paraan.
Dialogue: 0,0:10:56.87,0:10:58.23,Default,Lily1,0,0,0,,Kung pipilitin mo,
Dialogue: 0,0:10:59.00,0:11:01.30,Default,Lily1,0,0,0,,mag-alay kay Buddha.
Dialogue: 0,0:11:02.44,0:11:05.14,Default,Lily1,0,0,0,,Eksakto. Bibigyan kita hangga't gusto mo.
Dialogue: 0,0:11:07.08,0:11:09.78,Default,Lily1,0,0,0,,Ang namatay sa palasyo,
Dialogue: 0,0:11:10.11,0:11:12.45,Default,Lily1,0,0,0,,hindi ako.
Dialogue: 0,0:11:15.72,0:11:16.79,Default,Lily1,0,0,0,,Damn!
Dialogue: 0,0:11:18.45,0:11:21.06,Default,Lily1,0,0,0,,Hindi ko naitanong sa reyna ang gusto kong tanong.
Dialogue: 0,0:11:22.09,0:11:23.09,Default,Lily1,0,0,0,,Lord.
Dialogue: 0,0:11:23.39,0:11:25.03,Default,Lily1,0,0,0,,Babalik ako sa Daejeon.
Dialogue: 0,0:11:25.53,0:11:26.56,Default,Lily1,0,0,0,,Kamahalan.
Dialogue: 0,0:11:30.13,0:11:31.67,Default,Lily1,0,0,0,,Kahina-hinala.
Dialogue: 0,0:11:32.94,0:11:35.14,Default,Lily1,0,0,0,,Given kung paano siya biglang nawala.
Dialogue: 0,0:11:41.04,0:11:42.18,Default,Lily1,0,0,0,,Tama.
Dialogue: 0,0:11:42.51,0:11:44.75,Default,Lily1,0,0,0,,Kaya ko itong iguhit mismo.
Dialogue: 0,0:11:53.39,0:11:54.62,Default,Lily1,0,0,0,,Gagawin ng isang ito.
Dialogue: 0,0:12:00.50,0:12:02.27,Default,Lily1,0,0,0,,Tama. ganito.
Dialogue: 0,0:12:03.13,0:12:05.67,Default,Lily1,0,0,0,,Nakikita ko nang malinaw. ganito.
Dialogue: 0,0:12:07.84,0:12:09.64,Default,Lily1,0,0,0,,Hindi! Mali!
Dialogue: 0,0:12:12.01,0:12:13.34,Default,Lily1,0,0,0,,Ang kanyang mukha...
Dialogue: 0,0:12:17.38,0:12:18.88,Default,Lily1,0,0,0,,Ito ang mukha niya.
Dialogue: 0,0:12:21.75,0:12:23.42,Default,Lily1,0,0,0,,Hon!
Dialogue: 0,0:12:29.73,0:12:31.79,Default,Lily1,0,0,0,,Naiyak ka ba ng tuluyan?
Dialogue: 0,0:12:34.33,0:12:37.07,Default,Lily1,0,0,0,,Well. Well.
Dialogue: 0,0:12:37.07,0:12:38.90,Default,Lily1,0,0,0,,Well. Well.
Dialogue: 0,0:12:40.57,0:12:43.17,Default,Lily1,0,0,0,,Bakit hindi ko naisip na baka hindi niya ako gusto?
Dialogue: 0,0:12:43.77,0:12:47.91,Default,Lily1,0,0,0,,Bakit ang dami kong iniisip,
Dialogue: 0,0:12:48.08,0:12:50.55,Default,Lily1,0,0,0,,piliin ang pag-ibig o pamilya?
Dialogue: 0,0:12:51.21,0:12:53.82,Default,Lily1,0,0,0,,Ang pinakamalaking hadlang sa pag-ibig ay
Dialogue: 0,0:12:53.82,0:12:56.02,Default,Lily1,0,0,0,,ito ay walang iba kundi
Dialogue: 0,0:12:56.02,0:12:58.29,Default,Lily1,0,0,0,,panalo ang puso ng taong mahal mo.
Dialogue: 0,0:12:59.46,0:13:01.06,Default,Lily1,0,0,0,,Ano ang dahilan?
Dialogue: 0,0:13:01.56,0:13:02.73,Default,Lily1,0,0,0,,Sabi niya:
Dialogue: 0,0:13:03.56,0:13:04.99,Default,Lily1,0,0,0,,Hindi kita gusto.
Dialogue: 0,0:13:05.83,0:13:06.90,Default,Lily1,0,0,0,,Ano?
Dialogue: 0,0:13:07.80,0:13:08.80,Default,Lily1,0,0,0,,Paalam.
Dialogue: 0,0:13:10.57,0:13:11.70,Default,Lily1,0,0,0,,Maghintay.
Dialogue: 0,0:13:12.77,0:13:15.34,Default,Lily1,0,0,0,,Sabihin kung bakit.
Dialogue: 0,0:13:15.87,0:13:17.31,Default,Lily1,0,0,0,,Bakit hindi mo ako gusto?
Dialogue: 0,0:13:21.81,0:13:22.98,Default,Lily1,0,0,0,,I
Dialogue: 0,0:13:24.31,0:13:26.28,Default,Lily1,0,0,0,,Ayoko ng ambisyosong lalaki.
Dialogue: 0,0:13:28.28,0:13:30.65,Default,Spillik2,0,0,0,,Tumahimik, tumahimik.
Dialogue: 0,0:13:32.92,0:13:35.19,Default,Spikyulka2,0,0,0,,Narito ang dampness.
Dialogue: 0,0:13:35.89,0:13:39.46,Default,Spikyulka2,0,0,0,,Ang pag-ibig ay nagsisimula sa kahalumigmigan
Dialogue: 0,0:13:39.46,0:13:42.03,Default,Spikyulka2,0,0,0,,at nagtatapos ito sa ganoong dampness.
Dialogue: 0,0:13:44.93,0:13:46.64,Default,Spikyulka2,0,0,0,,-Pero...\N-Damn, tinakot kita.
Dialogue: 0,0:13:46.67,0:13:48.20,Default,Spikyulka2,0,0,0,,May magandang balita.
Dialogue: 0,0:13:48.20,0:13:50.11,Default,Spillik2,0,0,0,,Bumaan ang pakiramdam ng hari,
Dialogue: 0,0:13:51.21,0:13:52.71,Default,Spikyulka2,0,0,0,,nasagot ang mga panalangin ko.
Dialogue: 0,0:13:54.08,0:13:56.08,Default,Spikyulka2,0,0,0,,Sigurado akong may narinig ka pa.
Dialogue: 0,0:13:58.25,0:14:01.72,Default,Spikyulka2,0,0,0,,Ipapababa si Kim Jwageun dahil sa insidenteng ito.
Dialogue: 0,0:14:02.49,0:14:05.76,Default,Spillik2,0,0,0,,Gusto ko ang hari, at nirerespeto ko si Kim Jwageun.
Dialogue: 0,0:14:06.22,0:14:08.56,Default,Spillik2,0,0,0,,Nadudurog ang puso ko.
Dialogue: 0,0:14:08.69,0:14:11.89,Default,Spikyulka2,0,0,0,,Paano mo mamahalin ang hari, dahil hindi mo siya kilala ng personal.
Dialogue: 0,0:14:13.40,0:14:15.67,Default,Spillik2,0,0,0,,Kung tutuusin, best friend mo siya.
Dialogue: 0,0:14:15.80,0:14:17.60,Default,Spillik2,0,0,0,,Ikaw ay isang mabuting tao,
Dialogue: 0,0:14:17.60,0:14:19.60,Default,Spikyulka2,0,0,0,,kaya dapat ganyan ang kaibigan mo.
Dialogue: 0,0:14:21.40,0:14:22.67,Default,Spikyulka2,0,0,0,,Well, natapos mo na ito.
Dialogue: 0,0:14:29.21,0:14:30.75,Default,Spillik2,0,0,0,,Gumuguhit ka ba ng octopus?
Dialogue: 0,0:14:30.88,0:14:33.55,Default,Spikyulka2,0,0,0,,Ano ang ibig sabihin ng "octopus"? Lalaki ito.
Dialogue: 0,0:14:35.05,0:14:36.15,Default,Spillik2,0,0,0,,Ito?
Dialogue: 0,0:14:36.72,0:14:39.02,Default,Spikyulka2,0,0,0,,Iginuhit ko ito nang maayos, kung titingnan mong mabuti ang mga detalye.
Dialogue: 0,0:14:40.89,0:14:43.16,Default,Spillik2,0,0,0,,-Ito dapat ang mga mata.\N-Ito ang bibig.
Dialogue: 0,0:14:45.46,0:14:48.00,Default,Silk2,0,0,0,,-Iyan ba ang kanyang bibig?\N-Hindi mo ba nakikita ang kanyang mga labi?
Dialogue: 0,0:14:53.87,0:14:56.94,Default,Spikyulka2,0,0,0,,Pinakamahusay na basahin ang mga hula sa umaga.
Dialogue: 0,0:14:59.41,0:15:01.81,Default,Spillik2,0,0,0,,The Queen Mother, Her Highness is here.
Dialogue: 0,0:15:06.18,0:15:07.25,Default,Spillik2,0,0,0,,Lord.
Dialogue: 0,0:15:07.85,0:15:11.99,Default,Spilyk2,0,0,0,,Wala kang mukha.
Dialogue: 0,0:15:12.79,0:15:16.93,Default,Spillik2,0,0,0,,Para bang hindi nagising ang hari.
Dialogue: 0,0:15:17.46,0:15:20.06,Default,Spikyulka2,0,0,0,,Kumusta ang nangyayari sa reyna?
Dialogue: 0,0:15:21.06,0:15:23.23,Default,Spikyulka2,0,0,0,,Wala na akong nakikitang pakinabang dito
Dialogue: 0,0:15:23.80,0:15:25.70,Default,Spikyulka2,0,0,0,,at ginawa ang hiniling mo.
Dialogue: 0,0:15:26.54,0:15:29.21,Default,Spillit2,0,0,0,,Sigurado akong item na iyon
Dialogue: 0,0:15:29.21,0:15:31.34,Default,Spillie2,0,0,0,,matatagpuan sa kanyang mga silid.
Dialogue: 0,0:15:31.71,0:15:35.71,Default,Spillik2,0,0,0,,Nagpalipas ang hari kagabi sa mga silid ng reyna.
Dialogue: 0,0:15:35.95,0:15:37.98,Default,Spilyk2,0,0,0,,Agad-agad, paano ka naka-recover?
Dialogue: 0,0:15:38.15,0:15:40.38,Default,Spikyulka2,0,0,0,,Dahil sa insidenteng iyon sa pagsabog, napagtanto ko
Dialogue: 0,0:15:41.52,0:15:44.65,Default,Spikyulka2,0,0,0,,na kung mawala ito, mamamatay ako.
Dialogue: 0,0:15:45.35,0:15:47.49,Default,Spillie2,0,0,0,,Ang babaeng mamamatay ngayon...
Dialogue: 0,0:15:48.12,0:15:49.63,Default,Spillik2,0,0,0,,Talaga?..
Dialogue: 0,0:16:20.02,0:16:21.46,Default,Spillik2,0,0,0,,Gusto kong mamatay.
Dialogue: 0,0:16:21.89,0:16:23.43,Default,Spillik2,0,0,0,,Dapat ko bang patayin ang sarili ko?
Dialogue: 0,0:16:23.63,0:16:25.50,Default,Spillik2,0,0,0,,Siguro kung mamatay ako, bumuti ang pakiramdam ko?
Dialogue: 0,0:16:33.17,0:16:35.81,Default,Spillik2,0,0,0,,Paumanhin, reyna, maawa ka.
Dialogue: 0,0:16:36.11,0:16:38.74,Default,Spilyk2,0,0,0,,Itinanggi ko ang lahat,
Dialogue: 0,0:16:38.74,0:16:41.04,Default,Spikyulka2,0,0,0,,ngunit sigurado ang hari.
Dialogue: 0,0:16:42.28,0:16:43.61,Default,Spillik2,0,0,0,,Ano? Ano ang pinagsasabi mo?
Dialogue: 0,0:16:45.05,0:16:46.18,Default,Spillik2,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:16:47.18,0:16:49.39,Default,Spillik2,0,0,0,,Naaamoy mo ba ang nasusunog?
Dialogue: 0,0:16:49.55,0:16:52.52,Default,Spilyk2,0,0,0,,Kaninong mga kamay ang ginagawa nila? Sinuman sa inyo?
Dialogue: 0,0:16:52.52,0:16:53.72,Default,Spikyulka2,0,0,0,,-Saan ka pupunta?\N-Bitawan mo ako.
Dialogue: 0,0:16:55.96,0:16:57.36,Default,Spillit2,0,0,0,,Court lady Choi.
Dialogue: 0,0:17:02.50,0:17:03.73,Default,Spilyk2,0,0,0,,Sa huli
Dialogue: 0,0:17:04.53,0:17:06.70,Default,Spilyk2,0,0,0,,Sinabi ko sa kanya ang lahat.
Dialogue: 0,0:17:10.01,0:17:11.07,Default,Spillik2,0,0,0,,Ganun ba?
Dialogue: 0,0:17:11.37,0:17:13.61,Default,Spikyulka2,0,0,0,,Hayaan mo akong linawin ito.
Dialogue: 0,0:17:13.61,0:17:16.01,Default,Silk2,0,0,0,,Lumapit sa akin ang hari kahapon, nakikipag-usap sa iyo,
Dialogue: 0,0:17:16.01,0:17:18.21,Default,Spikyulka2,0,0,0,,at samakatuwid lahat ng kaguluhang ito. Kaya?
Dialogue: 0,0:17:18.21,0:17:19.75,Default,Spikyulka2,0,0,0,,Wala akong sinabing ganyan.
Dialogue: 0,0:17:21.38,0:17:23.79,Default,Spikyulka2,0,0,0,,Kaya nalilito ako
Dialogue: 0,0:17:25.25,0:17:27.56,Default,Spillik2,0,0,0,,kasalanan mo.
Dialogue: 0,0:17:27.76,0:17:30.26,Default,Spillik2,0,0,0,,Ano? bakit ka naguguluhan?
Dialogue: 0,0:17:30.26,0:17:31.86,Default,Spillik2,0,0,0,,Ikaw!
Dialogue: 0,0:17:34.20,0:17:35.67,Default,Spikyulka2,0,0,0,,Maganda iyon.
Dialogue: 0,0:17:36.80,0:17:38.20,Default,Spikyulka2,0,0,0,,Siguro mas maganda pa kaysa sa huling pagkakataon.
Dialogue: 0,0:17:39.20,0:17:41.00,Default,Spillik2,0,0,0,,Ito ang dahilan kung bakit ako nababaliw!
Dialogue: 0,0:17:41.87,0:17:44.31,Default,Spillik2,0,0,0,,Bakit ko ito nagustuhan? Hindi ito dapat mangyari.
Dialogue: 0,0:17:45.21,0:17:46.81,Default,Spilyk2,0,0,0,,So hindi kinokontrol ng kaluluwa ang katawan?
Dialogue: 0,0:17:47.14,0:17:49.01,Default,Spikyulka2,0,0,0,,Kaya ang isip at katawan ay lampas sa ating kontrol?
Dialogue: 0,0:17:49.01,0:17:51.08,Default,Spillik2,0,0,0,,Hormones ang namamahala sa lahat?
Dialogue: 0,0:17:52.55,0:17:54.32,Default,Spillik2,0,0,0,,-Bangungot.\N-Kamahalan.
Dialogue: 0,0:17:56.85,0:17:58.85,Default,Spikyulka2,0,0,0,,-Ano ang problema niya?\N-Kamahalan.
Dialogue: 0,0:17:59.69,0:18:00.99,Default,Spikyulka2,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:18:02.29,0:18:05.90,Default,Spillik2,0,0,0,,Siya ay nasa sarili niyang espiritu.
Dialogue: 0,0:18:08.90,0:18:10.80,Default,Spillik2,0,0,0,,Bakit hindi ka nakaramdam ng disgusto?
Dialogue: 0,0:18:11.33,0:18:13.00,Default,Spillik2,0,0,0,,Bakit?
Dialogue: 0,0:18:13.80,0:18:18.21,Default,Spillik2,0,0,0,,Feel! Naiinis ka. Dapat kinasusuklaman mo ito!
Dialogue: 0,0:18:18.21,0:18:20.34,Default,Silk2,0,0,0,,Humanda upang batiin ang Kanyang Kamahalan.
Dialogue: 0,0:18:26.72,0:18:28.08,Default,Spillik2,0,0,0,,Nasaan ang aking reyna?
Dialogue: 0,0:18:28.48,0:18:30.15,Default,Spillik2,0,0,0,,Kamahalan, siya...
Dialogue: 0,0:18:34.06,0:18:37.56,Default,Spillik2,0,0,0,,Paumanhin. Nandito lang siya.
Dialogue: 0,0:18:39.20,0:18:41.56,Default,Spillik2,0,0,0,,Ganito ba siya para magtago sa akin?
Dialogue: 0,0:18:41.83,0:18:43.93,Default,Spillik2,0,0,0,,Kagabi parang tigre...
Dialogue: 0,0:18:43.93,0:18:45.60,Default,Spillik2,0,0,0,,Rrrrr!
Dialogue: 0,0:18:51.04,0:18:53.21,Default,Spillik2,0,0,0,,Maaari mo ba akong tulungang mahanap ang reyna?
Dialogue: 0,0:18:53.64,0:18:54.74,Default,Spikyulka2,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:18:54.91,0:18:57.01,Default,Spikyulka2,0,0,0,,Sa nakikita mo, marami akong gustong sabihin sa kanya.
Dialogue: 0,0:19:00.68,0:19:02.15,Default,Spilyk2,0,0,0,,I wonder what exactly.
Dialogue: 0,0:19:09.03,0:19:11.63,Default,Spillik2,0,0,0,,No. Kung makikilala ko siya ngayon, mahihirapan ako.
Dialogue: 0,0:19:12.06,0:19:13.96,Default,Spillik2,0,0,0,,Paano kung ipagkanulo na naman ako ng katawan ko?
Dialogue: 0,0:19:14.30,0:19:15.36,Default,Spillik2,0,0,0,,Eksakto.
Dialogue: 0,0:19:15.36,0:19:18.47,Default,Spillik2,0,0,0,,Sigurado akong sinapian siya ng espiritu ni Kim So-yeon kagabi.
Dialogue: 0,0:19:20.10,0:19:23.04,Default,Spikyulka2,0,0,0,,At nagustuhan ko lang ito dahil akala ko si Hong Young iyon.
Dialogue: 0,0:19:23.04,0:19:24.77,Default,Spikyulka2,0,0,0,,Kung alam ko lang na siya yun...
Dialogue: 0,0:19:28.18,0:19:29.31,Default,Spikyulka2,0,0,0,,Pero gusto ko pa rin.
Dialogue: 0,0:19:30.38,0:19:32.21,Default,Spillik2,0,0,0,,Mababaliw na talaga ako.
Dialogue: 0,0:19:40.59,0:19:43.09,Default,Spillik2,0,0,0,,Paano kung mawala ng tuluyan si Jang Bong-hwan?
Dialogue: 0,0:19:44.69,0:19:45.83,Default,Spillik2,0,0,0,,Paano kung?
Dialogue: 0,0:19:45.83,0:19:47.03,Default,Spillik2,0,0,0,,Hindi dapat ako nakarating dito.\NJang Bong-hwan
Dialogue: 0,0:19:47.03,0:19:48.97,Default,Silk2,0,0,0,,-Aking reyna.\N-Kamahalan!
Dialogue: 0,0:19:49.43,0:19:50.67,Default,Spillik2,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:19:50.67,0:19:51.70,Default,Spillik2,0,0,0,,Holy shit.
Dialogue: 0,0:19:53.10,0:19:54.17,Default,Spilyk2,0,0,0,,Kamahalan.
Dialogue: 0,0:19:55.87,0:19:56.94,Default,Spillik2,0,0,0,,Kamahalan!
Dialogue: 0,0:19:58.14,0:20:00.18,Default,Spillik2,0,0,0,,-Your Majesty.\N-My queen.
Dialogue: 0,0:20:01.41,0:20:02.48,Default,Spillik2,0,0,0,,My queen.
Dialogue: 0,0:20:04.41,0:20:06.72,Default,Spillik2,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:20:13.62,0:20:14.62,Default,Spillik2,0,0,0,,Kamahalan!
Dialogue: 0,0:20:15.79,0:20:16.89,Default,Spillik2,0,0,0,,Kamahalan!
Dialogue: 0,0:20:17.93,0:20:20.00,Default,Silk2,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:20:22.06,0:20:23.07,Default,Spillik2,0,0,0,,Kamahalan!
Dialogue: 0,0:20:25.97,0:20:28.54,Default,Spikyulka2,0,0,0,,Malapit nang mawala si Kim Jwageun sa kanyang posisyon,
Dialogue: 0,0:20:28.54,0:20:30.97,Default,Silk2,0,0,0,,pagkatapos ng lahat, nilinaw niya na sinusubukan niyang tanggalin ang hari.
Dialogue: 0,0:20:31.27,0:20:32.31,Default,Spillik2,0,0,0,,Hindi kapani-paniwala.
Dialogue: 0,0:20:34.24,0:20:36.28,Default,Spilyk2,0,0,0,,Lalong iniisip ko ito,
Dialogue: 0,0:20:36.28,0:20:38.28,Default,Spikyulka2,0,0,0,, lalo akong kumbinsido na hindi ito ang kanyang istilo.
Dialogue: 0,0:20:39.05,0:20:40.65,Default,Spikyulka2,0,0,0,,Tiyak na nadarama siya sa isang sulok.
Dialogue: 0,0:20:40.98,0:20:42.89,Default,Spikyulka2,0,0,0,,Dahil sa pagsabog na iyon
Dialogue: 0,0:20:42.89,0:20:45.12,Default,Spikyulka2,0,0,0,,Nawala ang lahat kay Kim Jwageun.
Dialogue: 0,0:20:45.65,0:20:47.99,Default,Spikyulka2,0,0,0,,Sa kabilang banda, nanalo lang ang hari.
Dialogue: 0,0:20:47.99,0:20:49.23,Default,Spilyk2,0,0,0,,Kahit na,
Dialogue: 0,0:20:49.23,0:20:52.29,Default,Spikyulka2,0,0,0,,Nagdududa ako na ang hari mismo ang naging sanhi ng pagsabog, na inilagay sa panganib ang kanyang buhay.
Dialogue: 0,0:20:53.80,0:20:54.90,Default,Spillik2,0,0,0,,At totoo ito.
Dialogue: 0,0:20:57.57,0:20:59.97,Default,Spillik2,0,0,0,,-Your Majesty.\N-Your Majesty.
Dialogue: 0,0:21:00.10,0:21:02.44,Default,Spikyulka2,0,0,0,,-Pupunta ka ba sa council?\N-Oo.
Dialogue: 0,0:21:02.87,0:21:06.24,Default,Spilyk2,0,0,0,,Maari ko bang itanong, bakit ka mag-isa?
Dialogue: 0,0:21:07.28,0:21:08.28,Default,Spillik2,0,0,0,,My queen...
Dialogue: 0,0:21:08.38,0:21:09.45,Default,Spillik2,0,0,0,,-Reyna?\N-Reyna?
Dialogue: 0,0:21:14.95,0:21:17.45,Default,Spikyulka2,0,0,0,,Kamahalan, naglalaro ka ba ng taguan?
Dialogue: 0,0:21:17.82,0:21:20.16,Default,Spikyulka2,0,0,0,,-Magaling akong tumugtog sa kanila!\N-Hush.
Dialogue: 0,0:21:28.20,0:21:29.27,Default,Spilyk2,0,0,0,,Natagpuan.
Dialogue: 0,0:21:29.27,0:21:31.57,Default,Spillie2,0,0,0,,Nakakagalit. Tigilan mo na ang pag-stalk sa akin!
Dialogue: 0,0:21:31.57,0:21:33.44,Default,Spilyk2,0,0,0,,Paparazzi ka ba? O isang stalker?
Dialogue: 0,0:21:33.44,0:21:34.97,Default,Spikyulka2,0,0,0,,-Got it.\N-Ano?
Dialogue: 0,0:21:34.97,0:21:37.17,Default,Spillik2,0,0,0,,-Your Majesty.\N-Your Majesty.
Dialogue: 0,0:21:37.17,0:21:39.24,Default,Spikyulka2,0,0,0,,-Magkita tayo sa royal council.\N-Okay.
Dialogue: 0,0:21:39.44,0:21:41.74,Default,Spikyulka2,0,0,0,,Pag-usapan natin ang lahat nang mahinahon.
Dialogue: 0,0:21:41.74,0:21:42.78,Default,Spillie2,0,0,0,,Reyna.
Dialogue: 0,0:21:42.78,0:21:44.88,Default,Spillik2,0,0,0,,Lubos silang baliw sa pag-ibig.
Dialogue: 0,0:21:44.88,0:21:46.88,Default,Spikyulka2,0,0,0,,-My queen!\N-Naglalaro ng taguan?
Dialogue: 0,0:21:47.42,0:21:48.95,Default,Spillik2,0,0,0,,Tulad ng maliliit na bata.
Dialogue: 0,0:21:48.95,0:21:52.76,Default,Spillik2,0,0,0,,Ano? Naglalaro ng taguan kung kailan
Dialogue: 0,0:21:53.39,0:21:54.86,Default,Spikyulka2,0,0,0,,halos namatay kamakailan?
Dialogue: 0,0:21:58.13,0:22:00.33,Default,Spillik2,0,0,0,,Eksakto. May mga royal concubines.
Dialogue: 0,0:22:00.46,0:22:02.20,Default,Spikyulka2,0,0,0,,Nagkaroon kami ng love correspondence buong gabi.
Dialogue: 0,0:22:02.20,0:22:04.83,Default,Spillik2,0,0,0,,Sila ang mga anghel na tagapag-alaga ng aking sekswal na oryentasyon!
Dialogue: 0,0:22:04.83,0:22:07.14,Default,Tolenka3,0,0,0,,Kamahalan, tinatanggap ka namin.
Dialogue: 0,0:22:07.14,0:22:08.84,Default,Tolenka3,0,0,0,,Okay ka lang?
Dialogue: 0,0:22:11.17,0:22:12.41,Default,Tolenka3,0,0,0,,Well, have a nice day.
Dialogue: 0,0:22:15.51,0:22:16.51,Default,Tolenka3,0,0,0,,My queen.
Dialogue: 0,0:22:17.35,0:22:19.11,Default,Tolenka3,0,0,0,,Hindi ka dapat tumakbo sa paligid ng bakuran.
Dialogue: 0,0:22:19.78,0:22:22.59,Default,Tolenka3,0,0,0,,Mukhang ang dalawang ito, maliban sa isa't isa, ay hindi nangangailangan ng iba.
Dialogue: 0,0:22:23.79,0:22:24.82,Default,Tolenka3,0,0,0,,Parang ito.
Dialogue: 0,0:22:24.82,0:22:28.86,Default,Tolenka3,0,0,0,,Nga pala, gaano sila kaganda.
Dialogue: 0,0:22:35.06,0:22:37.77,Default,Tolenka3,0,0,0,,Mahusay. Sumulat tayo sa mga kababaihan,\Nand deviations sa oryentasyon ay hindi na mangyayari.
Dialogue: 0,0:22:39.27,0:22:41.24,Default,Tolenka3,0,0,0,,-My queen. \N-Kamahalan.
Dialogue: 0,0:22:42.97,0:22:43.97,Default,Tolenka3,0,0,0,,My queen.
Dialogue: 0,0:23:05.86,0:23:07.13,Default,Tolenka3,0,0,0,,At wala siya dito.
Dialogue: 0,0:23:08.50,0:23:12.33,Default,Tolenka3,0,0,0,,Hindi ko lang siya tinatakbuhan. may gusto akong itanong sayo.
Dialogue: 0,0:23:12.87,0:23:14.10,Default,Tolenka3,0,0,0,,Itanong?
Dialogue: 0,0:23:14.10,0:23:16.44,Default,Tolenka3,0,0,0,,Pero parang hindi siya komportable sa tabi ko.
Dialogue: 0,0:23:18.04,0:23:19.21,Default,Tolenka3,0,0,0,,Panahon na para huminto.
Dialogue: 0,0:23:20.94,0:23:22.71,Default,Tolenka3,0,0,0,,Sana kapag may nararamdaman siya
Dialogue: 0,0:23:24.45,0:23:26.42,Default,Tolenka3,0,0,0,,nagpasya, siya mismo ang lalapit sa akin.
Dialogue: 0,0:23:34.26,0:23:36.53,Default,Tolenka3,0,0,0,, -Oras na para pumunta sa meeting room. \N-Oo.
Dialogue: 0,0:23:40.63,0:23:41.76,Default,Tolenka3,0,0,0,,Narito ka na.
Dialogue: 0,0:23:42.97,0:23:44.77,Default,Tolenka3,0,0,0,,Mukhang nilibot mo ang buong palasyo ngayon.
Dialogue: 0,0:23:44.77,0:23:46.27,Default,Tolenka3,0,0,0,,Hinahabol kita simula umaga.
Dialogue: 0,0:23:46.90,0:23:48.10,Default,Tolenka3,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:23:51.51,0:23:54.11,Default,Tolenka3,0,0,0,,Nandito ka na. kagabi...
Dialogue: 0,0:23:55.78,0:23:57.18,Default,Tolenka3,0,0,0,,Pag-usapan natin ang lahat sa daan.
Dialogue: 0,0:23:57.81,0:23:58.85,Default,Tolenka3,0,0,0,,Tara na.
Dialogue: 0,0:23:59.55,0:24:00.68,Default,Tolenka3,0,0,0,,Saan tayo pupunta?
Dialogue: 0,0:24:01.68,0:24:02.82,Default,Tolenka3,0,0,0,,May pupuntahan pa ba tayo?
Dialogue: 0,0:24:06.36,0:24:07.79,Default,Tolenka3,0,0,0,,Masyadong malaki ang palasyo.
Dialogue: 0,0:24:33.35,0:24:34.38,Default,Tolenka3,0,0,0,,Wala na?
Dialogue: 0,0:24:37.42,0:24:39.39,Default,Tolenka3,0,0,0,,Ano ang gusto niyang itanong?
Dialogue: 0,0:24:41.69,0:24:44.46,Default,Tolenka3,0,0,0,,Ano ang itatanong ng mga lalaki sa mga ganitong sitwasyon?
Dialogue: 0,0:24:46.13,0:24:47.16,Default,Tolenka3,0,0,0,,Well, maganda ba?
Dialogue: 0,0:24:57.41,0:24:58.71,Default,Tolenka3,0,0,0,,Ipadala gaya ng dati.
Dialogue: 0,0:25:00.74,0:25:01.98,Default,Tolenka3,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:25:04.58,0:25:05.88,Default,Tolenka3,0,0,0,,May mali dito.
Dialogue: 0,0:25:07.28,0:25:08.32,Default,Tolenka3,0,0,0,,Court lady Choi.
Dialogue: 0,0:25:09.49,0:25:10.59,Default,Tolenka3,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:25:10.85,0:25:12.96,Default,Tolenka3,0,0,0,,Bakit hindi mo na ako sinasabihan?
Dialogue: 0,0:25:13.12,0:25:15.96,Default,Tolenka3,0,0,0,,Hindi nararapat na umalis ng ganito sa iyong mga silid, Kamahalan.
Dialogue: 0,0:25:16.66,0:25:17.83,Default,Tolenka3,0,0,0,,Kailangan kong paalalahanan ang lahat.
Dialogue: 0,0:25:18.13,0:25:20.43,Default,Tolenka3,0,0,0,,Napagpasyahan kong hindi na kita pagsabihan.
Dialogue: 0,0:25:20.93,0:25:22.20,Default,Tolenka3,0,0,0,,Ano?
Dialogue: 0,0:25:23.40,0:25:24.53,Default,Tolenka3,0,0,0,,Bakit biglaan?
Dialogue: 0,0:25:25.53,0:25:27.77,Default,Tolenka3,0,0,0,,-Okay, go. \N-Okay.
Dialogue: 0,0:25:31.54,0:25:32.71,Default,Tolenka3,0,0,0,,Nakakagulat.
Dialogue: 0,0:25:56.02,0:25:57.12,Default,Tolenka3,0,0,0,,Mula ngayon
Dialogue: 0,0:25:58.66,0:26:01.49,Default,Tolenka3,0,0,0,,Nagbitiw ako bilang regent.
Dialogue: 0,0:26:44.80,0:26:45.90,Default,Tolenka3,0,0,0,,At samakatuwid
Dialogue: 0,0:26:47.01,0:26:49.21,Default,Tolenka3,0,0,0,,mula ngayon mag-isa akong mamumuno.
Dialogue: 0,0:26:49.54,0:26:54.45,Default,Tolenka3,0,0,0,,Mabuhay ang hari!
Dialogue: 0,0:27:11.70,0:27:14.00,Default,Tolenka3,0,0,0,,Sa bilis na ito malapit na akong mamatay.
Dialogue: 0,0:27:15.03,0:27:18.40,Default,Tolenka3,0,0,0,,Lahat ng mga karanasang ito ay tatapusin ako.
Dialogue: 0,0:27:19.10,0:27:21.47,Default,Tolenka3,0,0,0,,Ipaalam sa akin na hindi ka nagugutom ngayon?
Dialogue: 0,0:27:21.91,0:27:25.28,Default,Tolenka3,0,0,0,,Gusto mo bang mapabilis ang pagkamatay ko?
Dialogue: 0,0:27:25.54,0:27:26.91,Default,Tolenka3,0,0,0,,Paumanhin.
Dialogue: 0,0:27:27.68,0:27:28.88,Default,Tolenka3,0,0,0,,Gayunpaman
Dialogue: 0,0:27:29.18,0:27:32.92,Default,Tolenka3,0,0,0,,Hindi pa rin ako makapagpasya kung iuutos ang pagkain na dadalhin o hindi.
Dialogue: 0,0:27:32.92,0:27:36.02,Default,Tolenka3,0,0,0,,Kung utusan kitang dalhin ito, magagalit ka,\Nnaaalala ka namin hanggang sa iyong kamatayan.
Dialogue: 0,0:27:36.76,0:27:39.73,Default,Tolenka3,0,0,0,,Ano, kahit mga simpleng bagay
Dialogue: 0,0:27:39.73,0:27:41.93,Default,Tolenka3,0,0,0,,hindi ka ba makakapagdesisyon nang wala ako?!
Dialogue: 0,0:27:43.03,0:27:44.13,Default,Tolenka3,0,0,0,,Dowager Queen!
Dialogue: 0,0:27:46.43,0:27:47.83,Default,Tolenka3,0,0,0,,Paki-moderate ang iyong galit.
Dialogue: 0,0:27:51.80,0:27:53.91,Default,Tolenka3,0,0,0,,Pwede bang huwag kang magalit sa ganoong sitwasyon?
Dialogue: 0,0:27:54.14,0:27:57.64,Default,Tolenka3,0,0,0,,Halos nawalan ako ng impluwensya sa palasyo.
Dialogue: 0,0:27:58.61,0:28:00.75,Default,Tolenka3,0,0,0,,Tutulong akong ibalik ang dating kapangyarihan.
Dialogue: 0,0:28:02.65,0:28:04.98,Default,Tolenka3,0,0,0,,Magiging regent ka ulit.
Dialogue: 0,0:28:06.12,0:28:07.55,Default,Tolenka3,0,0,0,,At ikaw ay may tiwala sa sarili.
Dialogue: 0,0:28:08.55,0:28:10.62,Default,Tolenka3,0,0,0,,Ganun din ang tatay mo noong kabataan niya.
Dialogue: 0,0:28:11.96,0:28:14.66,Default,Tolenka3,0,0,0,,Ito na ang huling pagkakataon.
Dialogue: 0,0:28:15.19,0:28:17.06,Default,Tolenka3,0,0,0,,At ano ang kailangang gawin?
Dialogue: 0,0:28:17.43,0:28:20.37, Default, Tolenka3,0,0,0,, Humanap ng paraan para pahinain ang espiritu ng hari.
Dialogue: 0,0:28:22.53,0:28:24.67,Default,Tolenka3,0,0,0,,Kung magiging maayos ang lahat para sa kanya,
Dialogue: 0,0:28:24.67,0:28:27.17,Default,Tolenka3,0,0,0,,isipin mo lang ang iyong sarili at subukang huwag ibigay ang iyong sarili.
Dialogue: 0,0:28:28.14,0:28:29.24,Default,Tolenka3,0,0,0,,Nakuha ko.
Dialogue: 0,0:28:29.24,0:28:32.84,Default,Tolenka3,0,0,0,,Gayunpaman, malamang na hindi magiging epektibo ang mga lumang pamamaraan.
Dialogue: 0,0:28:35.01,0:28:37.15,Default,Tolenka3,0,0,0,,Huwag maliitin ang hari.
Dialogue: 0,0:28:37.42,0:28:41.52,Default,Tolenka3,0,0,0,,Sa tingin mo ba ay ang pagsabog ang kanyang kagagawan?
Dialogue: 0,0:28:42.22,0:28:45.39,Default,Tolenka3,0,0,0,,Bilang panuntunan, ang mas nakikinabang ay dapat sisihin.
Dialogue: 0,0:28:45.89,0:28:48.66,Default,Tolenka3,0,0,0,,Hindi ako makapaniwala na ibinigay ko ang trono sa gayong mapanlinlang na halimaw.
Dialogue: 0,0:28:54.83,0:28:58.27,Default,Tolenka3,0,0,0,,Kamahalan, binabati kita sa pagtatapos ng regency.
Dialogue: 0,0:28:59.74,0:29:00.94,Default,Tolenka3,0,0,0,,Salamat.
Dialogue: 0,0:29:03.11,0:29:05.41,Default,Tolenka3,0,0,0,,Habang wala ka, may naihatid na mensahe
Dialogue: 0,0:29:05.41,0:29:07.18,Default,Tolenka3,0,0,0,,mula sa Daejojon pavilion.
Dialogue: 0,0:29:08.11,0:29:09.92,Default,Tolenka3,0,0,0,,-Mula sa reyna? \N-Oo, Kamahalan.
Dialogue: 0,0:29:16.69,0:29:19.59,Default,Tolenka3,0,0,0,,Sinisikap kong ipahiwatig sa mga salita kung paano ako nanghihina sa pananabik para sa iyo,
Dialogue: 0,0:29:19.89,0:29:21.06,Default,Tolenka3,0,0,0,,at lalo pa kitang nami-miss.
Dialogue: 0,0:29:24.43,0:29:26.20,Default,Tolenka3,0,0,0,,May kailangang gawin tungkol dito.
Dialogue: 0,0:29:33.04,0:29:34.97,Default,Tolenka3,0,0,0,,Narinig ang mga desperadong pakiusap ko.
Dialogue: 0,0:29:35.61,0:29:36.71,Default,Tolenka3,0,0,0,,Napakapursigi.
Dialogue: 0,0:29:37.71,0:29:38.91,Default,Tolenka3,0,0,0,,Kailangan nating magkita.
Dialogue: 0,0:29:43.12,0:29:44.48,Default,Tolenka3,0,0,0,,Nandito ka na ba?
Dialogue: 0,0:29:44.92,0:29:47.05,Default,Tolenka3,0,0,0,,Upang iligtas ako sa mga pahirap na ito...
Dialogue: 0,0:29:48.29,0:29:49.39,Default,Tolenka3,0,0,0,,Choljong?
Dialogue: 0,0:29:49.82,0:29:51.12,Default,Tolenka3,0,0,0,,Paano mo nalaman kung nasaan ako?
Dialogue: 0,0:29:51.29,0:29:53.29,Default,Tolenka3,0,0,0,,Paano ito? Ikaw mismo ang gumawa ng appointment.
Dialogue: 0,0:29:53.29,0:29:55.96,Default,Tolenka3,0,0,0,,-At tinawag ako ng isang concubine dito!\N-Sinong concubine?
Dialogue: 0,0:29:55.96,0:29:57.63,Default,Tolenka3,0,0,0,,Kapag hindi mo alam, ito ay mas kawili-wili,
Dialogue: 0,0:29:57.63,0:29:59.36,Default,Tolenka3,0,0,0,,kaya hindi ako nagtanong.
Dialogue: 0,0:29:59.77,0:30:01.30,Default,Tolenka3,0,0,0,,Sa anumang kaso, hindi ako sumulat sa iyo.
Dialogue: 0,0:30:01.70,0:30:04.00,Default,Tolenka3,0,0,0,,Minsan iba ang iniisip ko.
Dialogue: 0,0:30:05.54,0:30:08.24,Default,Tolenka3,0,0,0,,Sana malunod ako sa daloy ng mga iniisip tungkol sa iyo.
Dialogue: 0,0:30:08.74,0:30:11.84,Default,Tolenka3,0,0,0,,Kumapit ka sa akin.
Dialogue: 0,0:30:12.71,0:30:17.52,Default,Tolenka3,0,0,0,,Oh! Hindi kita papakawalan para sa kahit ano!
Dialogue: 0,0:30:17.68,0:30:19.58,Default,Tolenka3,0,0,0,,-Sapat na. \N-Nakuha mo na ba?
Dialogue: 0,0:30:20.15,0:30:21.19,Default,Tolenka3,0,0,0,,No.
Dialogue: 0,0:30:21.29,0:30:23.26,Default,Tolenka3,0,0,0,,Hindi lyrics, ngunit isang uri ng kahihiyan. First time kong narinig.
Dialogue: 0,0:30:23.26,0:30:25.42,Default,Tolenka3,0,0,0,,Ang pangalan mo ay mananatili sa aking mga labi hanggang sa ako ay makapagpahinga.
Dialogue: 0,0:30:25.62,0:30:27.89,Default,Tolenka3,0,0,0,,Will occupy all my thoughts, Hindi ko siya malilimutan.
Dialogue: 0,0:30:27.99,0:30:29.66,Default,Tolenka3,0,0,0,,Sapat na. May mga tao dito.
Dialogue: 0,0:30:31.06,0:30:33.50,Default,Tolenka3,0,0,0,,Ano kaya? Hindi ikaw ang nagsulat nito.
Dialogue: 0,0:30:40.37,0:30:42.74,Default,Tolenka3,0,0,0,,May kailangan tayong pag-usapan. Iwan mo na kami.
Dialogue: 0,0:30:42.74,0:30:43.88,Default,Tolenka3,0,0,0,,Okay?
Dialogue: 0,0:30:43.88,0:30:45.91,Default,Tolenka3,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:30:53.92,0:30:55.19,Default,Tolenka3,0,0,0,,Lihim mo ba akong sinusundan?
Dialogue: 0,0:30:55.32,0:30:56.96,Default,Tolenka3,0,0,0,,Nagbabasa ka ba ng sulat?
Dialogue: 0,0:30:57.62,0:30:58.82,Default,Tolenka3,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:30:59.42,0:31:01.83,Default,Tolenka3,0,0,0,,Ipagtapat mo ang iyong pagmamahal sa mga mensahe.
Dialogue: 0,0:31:01.83,0:31:03.46,Default,Tolenka3,0,0,0,,At kapag nagkita tayo, nagpapanggap ka na walang pakialam.
Dialogue: 0,0:31:04.40,0:31:05.83,Default,Tolenka3,0,0,0,,Paano ka magiging malupit.
Dialogue: 0,0:31:10.67,0:31:12.07,Default,Tolenka3,0,0,0,,O ang sulat ay naihatid sa maling lugar?!
Dialogue: 0,0:31:12.80,0:31:14.57,Default,Tolenka3,0,0,0,,Lumalabas na hindi para sa akin ang mga mensahe?
Dialogue: 0,0:31:14.57,0:31:16.68,Default,Tolenka3,0,0,0,,Ito pala ay dahil sa iyo kaya bumilis ang tibok ng puso ko?
Dialogue: 0,0:31:17.48,0:31:19.85,Default,Tolenka3,0,0,0,,Ikaw ba ang huling pagkakataon ko para ibalik ang lakas ng lalaki?
Dialogue: 0,0:31:20.05,0:31:23.01,Default,Tolenka3,0,0,0,,Dahil sayo nadudurog ang puso ko tuwing gabi
Dialogue: 0,0:31:24.05,0:31:25.52,Default,Tolenka3,0,0,0,, nanginginig?
Dialogue: 0,0:31:25.95,0:31:27.85,Default,Tolenka3,0,0,0,,Kaya ito ang dahilan ng inyong paghihiwalay.
Dialogue: 0,0:31:29.22,0:31:30.32,Default,Tolenka3,0,0,0,,Bakit ikaw?
Dialogue: 0,0:31:30.56,0:31:32.22,Default,Tolenka3,0,0,0,,Bakit laging ikaw?
Dialogue: 0,0:31:32.22,0:31:34.43,Default,Tolenka3,0,0,0,,Kahit sa panaginip ko nagpakita ka sa akin!
Dialogue: 0,0:31:35.16,0:31:36.53,Default,Tolenka3,0,0,0,,Nagpakita ba ako sa iyo sa iyong mga panaginip?
Dialogue: 0,0:31:37.03,0:31:40.60,Default,Tolenka3,0,0,0,,Panoorin ang iyong wika. Isa pang katangahan at masasabing confession na ito.
Dialogue: 0,0:31:40.90,0:31:42.73,Default,Tolenka3,0,0,0,,May iba't ibang pangarap, alam mo.
Dialogue: 0,0:31:43.00,0:31:44.74,Default,Tolenka3,0,0,0,, Bangungot, halimbawa.
Dialogue: 0,0:31:45.87,0:31:47.34,Default,Tolenka3,0,0,0,,Bakit mo ako tinulungan sa kapistahan?
Dialogue: 0,0:31:49.54,0:31:51.71,Default,Tolenka3,0,0,0,,Sinundan ako para itanong ito?!
Dialogue: 0,0:31:52.41,0:31:54.78,Default,Tolenka3,0,0,0,,Maaari akong magpasalamat sa iyo. Walang kabuluhan nakatulong lamang ito.
Dialogue: 0,0:31:54.98,0:31:56.78,Default,Tolenka3,0,0,0,,Siya mismo ang nagsabi, sumumpa - kung natutuwa kang makita,
Dialogue: 0,0:31:56.78,0:31:59.15,Default,Tolenka3,0,0,0,,at maghanap ng away, kung nagpapasalamat.
Dialogue: 0,0:31:59.28,0:32:01.52,Default,Tolenka3,0,0,0,,Bakit bigla kang nagpasya na makinig sa akin?
Dialogue: 0,0:32:01.52,0:32:03.42,Default,Tolenka3,0,0,0,,Ginawa ko ito sa iyong paraan, ngunit hindi ka pa rin masaya?
Dialogue: 0,0:32:03.92,0:32:06.06,Default,Tolenka3,0,0,0,,Ano ang gusto mong gawin ko?
Dialogue: 0,0:32:06.49,0:32:08.73,Default,Tolenka3,0,0,0,,Dumidistansya tayo, tapos bigla kang tumulong.
Dialogue: 0,0:32:08.73,0:32:11.20,Default,Tolenka3,0,0,0,,Tapos bigla mong idineklara na madali mo akong pagtataksilan.
Dialogue: 0,0:32:11.86,0:32:13.23,Default,Tolenka3,0,0,0,,Oo, tapos ako lang...
Dialogue: 0,0:32:15.23,0:32:16.27,Default,Tolenka3,0,0,0,,Maghintay ng isang minuto.
Dialogue: 0,0:32:18.34,0:32:20.34,Default,Tolenka3,0,0,0,,So narinig mo ba lahat?
Dialogue: 0,0:32:22.47,0:32:24.58,Default,Tolenka3,0,0,0,,Lumalabas na nagsinungaling siya tungkol sa pagkawala ng kanyang pandinig?
Dialogue: 0,0:32:25.68,0:32:26.81,Default,Tolenka3,0,0,0,,Talaga...
Dialogue: 0,0:32:28.01,0:32:29.68,Default,Tolenka3,0,0,0,,Lumalabas na ang pagsabog ang iyong ginagawa?
Dialogue: 0,0:32:30.62,0:32:32.62,Default,Tolenka3,0,0,0,,Nawalan talaga ako ng pandinig saglit.
Dialogue: 0,0:32:33.22,0:32:35.95,Default,Tolenka3,0,0,0,,Ngunit bumalik siya tulad ng sinasabi mo sa mga salitang ito.
Dialogue: 0,0:32:36.86,0:32:39.39,Default,Tolenka3,0,0,0,,Nababaliw ka na ba? Baka namatay ka!
Dialogue: 0,0:32:39.55,0:32:40.40,Default,Tolenka3,0,0,0,,My queen!
Dialogue: 0,0:32:40.50,0:32:42.55,Default,Tolenka3,0,0,0,,Bakit ipagsapalaran ang iyong sarili?!
Dialogue: 0,0:33:02.21,0:33:04.58,Default,Tolenka3,0,0,0,,Ano? Ito ay isang ipinagbabawal na pamamaraan!
Dialogue: 0,0:33:04.88,0:33:07.52,Default,Tolenka3,0,0,0,,Lagi kang nakayakap, nakangiti, natutulog sa tabi ko...
Dialogue: 0,0:33:07.59,0:33:09.25,Default,Tolenka3,0,0,0,,Lahat ng ito ay ipinagbabawal.
Dialogue: 0,0:33:12.92,0:33:14.73,Default,Tolenka3,0,0,0,,Pinagbabawalan kitang pagbawalan ako.
Dialogue: 0,0:33:25.34,0:33:27.24,Default,Tolenka3,0,0,0,,Mahal kita.
Dialogue: 0,0:33:32.31,0:33:33.48,Default,Tolenka3,0,0,0,,So amorous?
Dialogue: 0,0:33:33.78,0:33:36.21,Default,Tolenka3,0,0,0,,Lahat dahil sa isang gabing magkasama? \NHindi mo dapat ginawa iyon.
Dialogue: 0,0:33:36.21,0:33:37.62,Default,Tolenka3,0,0,0,,Hindi, hindi iyon ang dahilan.
Dialogue: 0,0:33:37.62,0:33:39.25,Default,Tolenka3,0,0,0,,Kung gayon bakit?
Dialogue: 0,0:33:40.22,0:33:43.72,Default,Tolenka3,0,0,0,,Ikaw ay mayabang, narcissistic, bastos
Dialogue: 0,0:33:43.89,0:33:45.16,Default,Tolenka3,0,0,0,,at pabagu-bago.
Dialogue: 0,0:33:45.59,0:33:47.09,Default,Tolenka3,0,0,0,,Marami kang pagkukulang.
Dialogue: 0,0:33:47.73,0:33:50.60,Default,Tolenka3,0,0,0,,Iyan ang punto. Kaya wag mo akong mahalin.
Dialogue: 0,0:33:50.60,0:33:52.53,Default,Tolenka3,0,0,0,,Pero mahal pa rin kita.
Dialogue: 0,0:33:53.67,0:33:56.57,Default,Tolenka3,0,0,0,,At mamahalin kita, hayaan kang magkaroon
Dialogue: 0,0:33:57.44,0:33:58.97,Default,Tolenka3,0,0,0,,lahat ng pagkukulang ng mundo.
Dialogue: 0,0:34:09.85,0:34:10.95,Default,Tolenka3,0,0,0,,Tandaan ang sinabi ko
Dialogue: 0,0:34:13.29,0:34:14.82,Default,Tolenka3,0,0,0,,sa gabi bago,
Dialogue: 0,0:34:16.02,0:34:17.39,Default,Tolenka3,0,0,0,,paano tumalon sa isang lawa?
Dialogue: 0,0:34:19.29,0:34:21.43,Default,Tolenka3,0,0,0,,Dapat mahalin mo ako.
Dialogue: 0,0:34:24.20,0:34:26.46,Default,Tolenka3,0,0,0,,Sinabi ko ito dahil parang sa akin noon
Dialogue: 0,0:34:26.46,0:34:27.90,Default,Tolenka3,0,0,0,,na ako lang ang makakapagprotekta sa iyo.
Dialogue: 0,0:34:29.03,0:34:31.84,Default,Tolenka3,0,0,0,,Dahil naisip ko na wala nang ibang paraan para matulungan ka.
Dialogue: 0,0:34:32.20,0:34:34.71,Default,Tolenka3,0,0,0,,Na ito lang ang tanging paraan para mailigtas ka at ako.
Dialogue: 0,0:34:35.97,0:34:37.44,Default,Tolenka3,0,0,0,,So ito ang dahilan?
Dialogue: 0,0:34:37.44,0:34:38.54,Default,Tolenka3,0,0,0,,Pero alam mo kung ano?
Dialogue: 0,0:34:39.88,0:34:42.68,Default,Tolenka3,0,0,0,,Wala na ang Kim So-yeon na iyon.
Dialogue: 0,0:34:44.05,0:34:45.98,Default,Tolenka3,0,0,0,,Namatay si Ta Kim So-yeon noong gabing iyon.
Dialogue: 0,0:34:49.49,0:34:52.02,Default,Tolenka3,0,0,0,,Hindi na kita sasaktan.
Dialogue: 0,0:34:54.53,0:34:56.33,Default,Tolenka3,0,0,0,,Wala tayong hinaharap.
Dialogue: 0,0:34:59.06,0:35:00.57,Default,Tolenka3,0,0,0,,Dahil hinding hindi kita mapapatawad.
Dialogue: 0,0:35:03.94,0:35:05.90,Default,Tolenka3,0,0,0,,Hindi ako Kim So-yeon.
Dialogue: 0,0:35:06.30,0:35:08.61,Default,Tolenka3,0,0,0,,Samakatuwid, wala akong karapatan.
Dialogue: 0,0:35:26.26,0:35:29.46,Default,Tolenka3,0,0,0,,Anong mga tao. May kailangan ba ang Her Majesty?
Dialogue: 0,0:35:30.50,0:35:33.30,Default,Tolenka3,0,0,0,,-Salamat sa iyong tulong. \N-Tulong?
Dialogue: 0,0:35:34.53,0:35:35.97,Default,Tolenka3,0,0,0,,Sa infirmary ng palasyo.
Dialogue: 0,0:35:36.03,0:35:38.64,Default,Tolenka3,0,0,0,,Ah, yun lang, ako lang...
Dialogue: 0,0:35:38.64,0:35:41.24,Default,Tolenka3,0,0,0,,Binigyan kita ng may lason na tubig.
Dialogue: 0,0:35:42.47,0:35:45.51,Default,Tolenka3,0,0,0,,Gayunpaman, ngunit nag-order din sila ng acupuncture na may moxibustion.
Dialogue: 0,0:35:46.24,0:35:48.85,Default,Tolenka3,0,0,0,,At samakatuwid dapat akong magpasalamat sa iyo.
Dialogue: 0,0:35:51.92,0:35:53.05,Default,Tolenka3,0,0,0,,Natagpuan ito sa daan.
Dialogue: 0,0:35:55.09,0:35:56.25,Default,Tolenka3,0,0,0,,Pero...
Dialogue: 0,0:36:02.83,0:36:06.23,Default,Tolenka3,0,0,0,,Saan siya nakakita ng ganoon kamahal na bagay?
Dialogue: 0,0:36:11.24,0:36:12.94,Default,Kus4,0,0,0,,Pagtatangka sa hari?
Dialogue: 0,0:36:13.34,0:36:16.04,Default,Kus4,0,0,0,,Bakit hindi ka kumunsulta sa amin bago simulan ito?
Dialogue: 0,0:36:16.04,0:36:17.88,Default,Kus4,0,0,0,,Tingnan kung ano ang humantong sa.
Dialogue: 0,0:36:17.88,0:36:21.61,Default,Kus4,0,0,0,,Naabot na siguro ni Kim Jwageun ang kanyang limitasyon.
Dialogue: 0,0:36:31.76,0:36:33.39,Default,Kus4,0,0,0,,Naiintindihan ko, gusto mo ng pera,
Dialogue: 0,0:36:33.39,0:36:34.79,Default,Kus4,0,0,0,,pero ibenta ang mga armas natin?
Dialogue: 0,0:36:35.09,0:36:36.80,Default,Kus4,0,0,0,,Sinisikap mo bang sirain ang bansang ito?
Dialogue: 0,0:36:36.80,0:36:38.73,Default,Kus4,0,0,0,,Nilinaw mo na walang problema.
Dialogue: 0,0:36:39.03,0:36:41.97,Default,Kus4,0,0,0,,Kailangan mo ng mga tao para makamit ang iyong mga layunin.
Dialogue: 0,0:36:41.97,0:36:43.97,Default,Kus4,0,0,0,,At para dito kailangan natin ng pera.
Dialogue: 0,0:36:45.17,0:36:47.54,Default,Kus4,0,0,0,,Sinasabi mo bang ginawa mo ito para sa akin?
Dialogue: 0,0:36:47.54,0:36:50.81,Default,Kus4,0,0,0,,Gusto kong ipakita ang mga resulta nang hindi nakikialam sa iyo sa mismong proseso.
Dialogue: 0,0:36:50.81,0:36:52.24,Default,Kus4,0,0,0,,Ginawa ko ang lahat para dito!
Dialogue: 0,0:36:52.68,0:36:54.21,Default,Kus4,0,0,0,,Sinubukan ko para sa iyo
Dialogue: 0,0:36:54.48,0:36:58.18,Default,Kus4,0,0,0,,at para sa kapakanan ng ating uri.
Dialogue: 0,0:37:00.85,0:37:01.92,Default,Kus4,0,0,0,,Humanda
Dialogue: 0,0:37:01.92,0:37:04.96,Default,Kus4,0,0,0,,akuin ang responsibilidad kung walang ibang paraan.
Dialogue: 0,0:37:10.80,0:37:12.76,Default,Kus4,0,0,0,,Bibigyan kita ng pagkakataong magbayad.
Dialogue: 0,0:37:21.54,0:37:24.14,Default,Kus4,0,0,0,,-Dumating na ba ang lahat?\N-Mr.
Dialogue: 0,0:37:25.31,0:37:28.25,Default,Kus4,0,0,0,,Wala pa ang ama ng reyna.
Dialogue: 0,0:37:29.58,0:37:31.12,Default,Kus4,0,0,0,,Hindi siya inimbitahan.
Dialogue: 0,0:37:31.52,0:37:34.99,Default,Kus4,0,0,0,,Nagtipon kami dito dahil sa pagkakamali niya.
Dialogue: 0,0:37:35.39,0:37:37.52,Default,Kus4,0,0,0,,Iningatan niya ang mga talaan ng ari-arian,
Dialogue: 0,0:37:38.59,0:37:40.43,Default,Kus4,0,0,0,,pag-aari ng aming pamilya.
Dialogue: 0,0:37:44.80,0:37:49.00,Default,Kus4,0,0,0,,Buti na lang at mayroon akong accounting book na ito.
Dialogue: 0,0:37:50.54,0:37:54.31,Default,Kus4,0,0,0,,Hangga't nananatili ang impluwensya ko, wala siyang silbi,
Dialogue: 0,0:37:54.31,0:37:55.64,Default,Kus4,0,0,0,,at hindi mo kailangang mag-alala.
Dialogue: 0,0:37:57.68,0:37:58.71,Default,Kus4,0,0,0,,Pero
Dialogue: 0,0:37:59.28,0:38:02.48,Default,Kus4,0,0,0,,sa sandaling mawala ang impluwensya ko,
Dialogue: 0,0:38:05.02,0:38:07.09,Default,Kus4,0,0,0,,Hindi ko maprotektahan ang libro.
Dialogue: 0,0:38:10.36,0:38:12.62,Default,Kus4,0,0,0,,Kung protektahan mo ako,
Dialogue: 0,0:38:13.12,0:38:15.23,Default,Kus4,0,0,0,,Poprotektahan kita bilang kapalit.
Dialogue: 0,0:38:15.93,0:38:18.23,Default,Kus4,0,0,0,,Kung magpasya kaming protektahan ka,
Dialogue: 0,0:38:18.66,0:38:19.80,Default,Kus4,0,0,0,,ano
Dialogue: 0,0:38:21.03,0:38:23.00,Default,Kus4,0,0,0,,gagawin mo ba ang hari?
Dialogue: 0,0:38:23.97,0:38:25.27,Default,Kus4,0,0,0,,Kung wala tayong gagawin,
Dialogue: 0,0:38:25.27,0:38:28.81,Default,Kus4,0,0,0,,sipain niya kami dahil hindi ka namin inalis sa posisyon mo.
Dialogue: 0,0:38:29.87,0:38:32.91,Default,Kus4,0,0,0,,Bumuo ang isang konseho upang malutas ang mga problema ng gobyerno.
Dialogue: 0,0:38:35.25,0:38:36.45,Default,Kus4,0,0,0,,Border Security Council?
Dialogue: 0,0:38:37.08,0:38:39.45,Default,Kus4,0,0,0,,Ang walang kakayahan na hari ay kumuha ng kapangyarihan sa kanyang sariling mga kamay -
Dialogue: 0,0:38:39.45,0:38:41.45,Default,Kus4,0,0,0,,seryosong problema ng estado.
Dialogue: 0,0:38:42.52,0:38:44.72,Default,Kus4,0,0,0,,Lahat ng desisyon sa patakaran
Dialogue: 0,0:38:45.99,0:38:48.43,Default,Kus4,0,0,0,,ay isasaalang-alang ng Border Protection Council.
Dialogue: 0,0:38:50.76,0:38:52.26,Default,Kus4,0,0,0,,Inihanda ko na ang lahat.
Dialogue: 0,0:38:52.60,0:38:55.60,Default,Kus4,0,0,0,,Gaya ng sinabi mo, ni-freeze namin ang tubig na may arsenic sa loob.
Dialogue: 0,0:38:55.60,0:38:58.17,Default,Kus4,0,0,0,,Nang matunaw ang yelo, lumabas ang arsenic.
Dialogue: 0,0:38:58.17,0:39:00.67,Default,Kus4,0,0,0,,Gaano katagal bago matunaw ang arsenic?
Dialogue: 0,0:39:01.27,0:39:02.91,Default,Kus4,0,0,0,,Depende sa lagay ng panahon,
Dialogue: 0,0:39:03.24,0:39:05.38,Default,Kus4,0,0,0,,ngunit sa tsaa hindi ito magtatagal.
Dialogue: 0,0:39:06.78,0:39:07.85,Default,Kus4,0,0,0,,Nakikita ko.
Dialogue: 0,0:39:08.45,0:39:12.08,Default,Kus4,0,0,0,,By the way, pwede ko bang malaman kung sino ang target mo?
Dialogue: 0,0:39:12.98,0:39:15.62,Default,Kus4,0,0,0,,Kung aalisin ko ang isang babae sa palasyo,
Dialogue: 0,0:39:15.85,0:39:18.92,Default,Kus4,0,0,0,,masisira ang dalawang lalaking nagbabanta sa posisyon ko.
Dialogue: 0,0:39:34.47,0:39:36.17,Default,Kus4,0,0,0,,Salamat sa pagtayo.
Dialogue: 0,0:39:37.51,0:39:40.55,Default,Kus4,0,0,0,,Nagtiis ka ng napakasakit na pagpapahirap.
Dialogue: 0,0:39:41.91,0:39:43.08,Default,Kus4,0,0,0,,Hindi ko ito malilimutan.
Dialogue: 0,0:39:45.12,0:39:48.89,Default,Kus4,0,0,0,,Ngayong nalantad ka, delikado ang manatili sa palasyo.
Dialogue: 0,0:39:49.82,0:39:51.29,Default,Kus4,0,0,0,,Umalis sa palasyo.
Dialogue: 0,0:39:52.49,0:39:54.79,Default,Kus4,0,0,0,,Panahon na para mamuhay ka.
Dialogue: 0,0:40:44.98,0:40:46.44,Default,Kus4,0,0,0,,Gagawin ko ang lahat
Dialogue: 0,0:40:51.08,0:40:52.58,Default,Kus4,0,0,0,,upang matupad ang iyong mga pangarap.
Dialogue: 0,0:41:14.91,0:41:16.24,Default,Kus4,0,0,0,, Kahit papaano naging walang laman.
Dialogue: 0,0:41:18.01,0:41:20.55,Default,Kus4,0,0,0,,Sino sa inyo ang gusto pa...
Dialogue: 0,0:41:22.68,0:41:23.75,Default,Kus4,0,0,0,,Nandito ka.
Dialogue: 0,0:41:47.11,0:41:48.54,Default,Kus4,0,0,0,,Kailangan kong ilagay
Dialogue: 0,0:41:49.67,0:41:53.24,Default,Kus4,0,0,0,,isang hexagonal ice cube sa mangkok ng reyna?
Dialogue: 0,0:41:54.65,0:41:55.68,Default,Kus4,0,0,0,,Oo.
Dialogue: 0,0:42:00.08,0:42:02.35,Default,Kus4,0,0,0,,Magdagdag lang ng ice cube. Ito lang.
Dialogue: 0,0:42:15.50,0:42:16.53,Default,Kus4,0,0,0,,Kamahalan.
Dialogue: 0,0:42:17.44,0:42:21.31,Default,Kus4,0,0,0,,Mayroon akong napakahalagang impormasyon.
Dialogue: 0,0:42:21.94,0:42:24.44,Default,Kus4,0,0,0,,Tulungan mo ako.
Dialogue: 0,0:42:25.31,0:42:27.35,Default,Kus4,0,0,0,,Ano ang nakuha mo diyan?
Dialogue: 0,0:42:27.71,0:42:30.62,Default,Kus4,0,0,0,,Kung nangako kang ililibre mo ako...
Dialogue: 0,0:42:31.18,0:42:32.85,Default,Kus4,0,0,0,,How dare you?
Dialogue: 0,0:42:33.25,0:42:34.32,Default,Kus4,0,0,0,,Court lady Khan.
Dialogue: 0,0:42:37.46,0:42:41.53,Default,Kus4,0,0,0,,Alam kong matapang kang babae, pero ngayon nanginginig ka sa takot.
Dialogue: 0,0:42:42.63,0:42:44.53,Default,Kus4,0,0,0,,Hindi ko alam kung anong meron ka diyan,
Dialogue: 0,0:42:45.23,0:42:47.60,Default,Kus4,0,0,0,,pero tutulungan kita sa lahat ng makakaya ko.
Dialogue: 0,0:42:50.00,0:42:52.84,Default,Kus4,0,0,0,,tanong sa akin ni Kim Jwageun...
Dialogue: 0,0:42:56.71,0:42:58.91,Default,Kus4,0,0,0,,Bakit hindi niya siya gusto sa simula pa lang?
Dialogue: 0,0:42:59.44,0:43:01.31,Default,Kus4,0,0,0,,Kung gayon hindi sana sinubukan ni Kim So-yeon na mamatay.
Dialogue: 0,0:43:01.31,0:43:02.88,Default,Kus4,0,0,0,,At wala ako dito.
Dialogue: 0,0:43:04.88,0:43:06.25,Default,Kus4,0,0,0,,Ngunit higit sa lahat,
Dialogue: 0,0:43:11.59,0:43:14.16,Default,Kus4,0,0,0,,Akala ko naranasan ko na lahat ng posible.
Dialogue: 0,0:43:16.09,0:43:18.60,Default,Kus4,0,0,0,,Ngunit, tila, mayroong isang bagay na hindi ko na-encounter.
Dialogue: 0,0:43:19.46,0:43:21.47,Default,Kus4,0,0,0,,Paano ipaliwanag ang pakiramdam kagabi?
Dialogue: 0,0:43:23.77,0:43:26.94,Default,Kus4,0,0,0,,Kung ang lahat noon ay parang malambot na piraso ng tinapay,
Dialogue: 0,0:43:26.94,0:43:28.17,Default,Kus4,0,0,0,,pagkatapos ay...
Dialogue: 0,0:43:31.21,0:43:35.05,Default,Kus4,0,0,0,,Hindi, bago iyon. Ang \NI ay interesado sa isang bagong bagay.
Dialogue: 0,0:43:35.58,0:43:37.08,Default,Kus4,0,0,0,,Come to yourselves, Chan So-yeon.
Dialogue: 0,0:43:38.02,0:43:41.02,Default,Kus4,0,0,0,,Damn it. Nalilito pa nga ako sa mga pangalan.
Dialogue: 0,0:43:42.29,0:43:43.39,Default,Kus4,0,0,0,,Reyna.
Dialogue: 0,0:43:44.52,0:43:45.99,Default,Kus4,0,0,0,,Oo. Pumasok ka.
Dialogue: 0,0:43:51.40,0:43:55.13,Default,Kus4,0,0,0,,Hiniling ka ng Reyna Dowager na mag-almusal nang sabay.
Dialogue: 0,0:43:56.23,0:43:58.67,Default,Kus4,0,0,0,,Almusal sa oras na ito?
Dialogue: 0,0:44:00.61,0:44:04.14,Default,Kus4,0,0,0,,Wala ako sa mood magluto ngayon.
Dialogue: 0,0:44:07.38,0:44:11.82,Default,Kus4,0,0,0,,Inihanda na ng Dowager Queen ang lahat.
Dialogue: 0,0:44:13.42,0:44:14.82,Default,Kus4,0,0,0,,Pupunta ba ako sa Dongmyeongjong Hall?
Dialogue: 0,0:44:15.19,0:44:17.09,Default,Kus4,0,0,0,,Buong araw akong tumatakbo ngayon - kaya nagugutom ako.
Dialogue: 0,0:44:18.86,0:44:20.66,Default,Kus4,0,0,0,,Gusto nilang tanggalin ang reyna?
Dialogue: 0,0:44:21.49,0:44:23.76,Default,Kus4,0,0,0,,Ang accounting book ay kay Kim Jwagyn na ngayon.
Dialogue: 0,0:44:24.40,0:44:25.90,Default,Kus4,0,0,0,,Sino ang nakakaalam na nasa Daejojong Hall siya?
Dialogue: 0,0:44:26.36,0:44:27.53,Default,Kus4,0,0,0,,Paano...
Dialogue: 0,0:44:28.63,0:44:30.07,Default,Kus4,0,0,0,,Babalik ako sa palasyo.
Dialogue: 0,0:44:36.01,0:44:37.07,Default,Kus4,0,0,0,,Dito.
Dialogue: 0,0:44:52.19,0:44:53.96,Default,Kus4,0,0,0,,Bakit ka natigil? Bilisan mo!
Dialogue: 0,0:44:53.96,0:44:55.13,Default,Kus4,0,0,0,,Darating ako.
Dialogue: 0,0:45:06.77,0:45:08.97,Default,Kus4,0,0,0,,Iiwan mo na naman ako.
Dialogue: 0,0:45:10.44,0:45:14.25,Default,Kus4,0,0,0,,Alam mo, Imp, nagsisimula na akong magalit sa iyo.
Dialogue: 0,0:45:29.23,0:45:31.13,Default,Kus4,0,0,0,,Salamat, Kamahalan.
Dialogue: 0,0:45:32.00,0:45:34.73,Default,Kus4,0,0,0,,Almusal, at may napakagandang tanawin.
Dialogue: 0,0:45:35.00,0:45:38.20,Default,Kus4,0,0,0,,Hindi na ako regent, kaya marami akong free time.
Dialogue: 0,0:45:38.54,0:45:40.84,Default,Kus4,0,0,0,,Dapat mas madalas tayong mag-almusal.
Dialogue: 0,0:45:41.47,0:45:43.54,Default,Kus4,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:45:51.82,0:45:54.49,Default,Kus4,0,0,0,,Ang almusal ay hindi maaaring walang inumin.
Dialogue: 0,0:45:59.16,0:46:03.06,Default,Kus4,0,0,0,,Ang mamamatay sa palasyo ngayon ay ang reyna.
Dialogue: 0,0:46:06.30,0:46:07.77,Default,Kus4,0,0,0,,Anak ko,
Dialogue: 0,0:46:08.73,0:46:11.14,Default,Kus4,0,0,0,,Makapaghiganti na rin ako sa wakas.
Dialogue: 0,0:47:16.53,0:47:18.54,Default,Kus4,0,0,0,, Espesyal kong inihanda ang yelo,
Dialogue: 0,0:47:18.54,0:47:21.61,Default,Kus4,0,0,0,,na mas mahal kaysa sa ginto ngayon.
Dialogue: 0,0:47:26.48,0:47:28.08,Default,Kus4,0,0,0,,Makakakita ako ng yelo dito sa unang pagkakataon.
Dialogue: 0,0:47:28.68,0:47:31.15,Default,Kus4,0,0,0,,Napakainit ngayon,
Dialogue: 0,0:47:31.18,0:47:34.32,Default,Kus4,0,0,0,,perpektong oras para sa isang malamig na inumin.
Dialogue: 0,0:47:44.86,0:47:47.63,Default,Kus4,0,0,0,,My queen. Pakiusap.
Dialogue: 0,0:47:47.77,0:47:49.10,Default,Kus4,0,0,0,,Nakikiusap ako sa iyo. Aking reyna.
Dialogue: 0,0:48:11.30,0:48:12.43,Default,Kus4,0,0,0,,How dare you...
Dialogue: 0,0:48:12.53,0:48:17.44,Default,Kus4,0,0,0,,May sasabihin ako sa reyna.
Dialogue: 0,0:48:17.54,0:48:19.10,Default,Kus4,0,0,0,,How dare you pumunta dito? umalis.
Dialogue: 0,0:48:19.10,0:48:21.01,Default,Kus4,0,0,0,,Napakahalaga nito.
Dialogue: 0,0:48:22.67,0:48:23.77,Default,Kus4,0,0,0,,Damhyan?
Dialogue: 0,0:48:24.04,0:48:25.84,Default,Kus4,0,0,0,,Bakit mo ginagawa ito?
Dialogue: 0,0:48:25.84,0:48:27.98,Default,Kus4,0,0,0,,Magkakaproblema ako dahil sayo.
Dialogue: 0,0:48:28.91,0:48:31.05,Default,Kus4,0,0,0,,Ano ang napakahalaga?
Dialogue: 0,0:48:36.82,0:48:38.62,Default,Kus4,0,0,0,,Kilala mo ba itong court lady?
Dialogue: 0,0:48:40.29,0:48:43.09,Default,Kus4,0,0,0,,Oo. Madalas ko siyang nakikita sa royal kitchen.
Dialogue: 0,0:48:44.86,0:48:47.06,Default,Kus4,0,0,0,,Damhyan, anong nangyari?
Dialogue: 0,0:48:47.67,0:48:49.10,Default,Kus4,0,0,0,,Ang bagay ay...
Dialogue: 0,0:48:53.27,0:48:54.94,Default,Kus4,0,0,0,,Nakikita mo...
Dialogue: 0,0:49:01.75,0:49:02.81,Default,Kus4,0,0,0,,I'm sorry.
Dialogue: 0,0:49:19.60,0:49:22.77,Default,Kus4,0,0,0,,Pumunta ako para dumalo sa pagkain ng dowager queen.
Dialogue: 0,0:49:23.73,0:49:26.34,Default,Kus4,0,0,0,,Ito ay mga pagtitipon ng kababaihan. Hindi mo kailangang sumama.
Dialogue: 0,0:49:27.40,0:49:30.51,Default,Kus4,0,0,0,,Ito ang unang pagkakataon na makikita ko ang reyna sa ganoong pagpupulong.
Dialogue: 0,0:49:31.08,0:49:32.34,Default,Kus4,0,0,0,,Humihingi ako ng paumanhin.
Dialogue: 0,0:49:33.78,0:49:35.98,Default,Kus4,0,0,0,,Isang karangalan para sa akin.
Dialogue: 0,0:49:36.31,0:49:39.42,Default,Kus4,0,0,0,,Kumusta ang mga bagay sa pagsubaybay sa iyong asawa?
Dialogue: 0,0:49:46.02,0:49:48.23,Default,Kus4,0,0,0,,Ngayong nagising na ang hari,
Dialogue: 0,0:49:48.33,0:49:50.43,Default,Kus4,0,0,0,,Gagawin ko ang lahat.
Dialogue: 0,0:49:52.93,0:49:55.57,Default,Kus4,0,0,0,,Kailangan nating uminom bago matunaw ang mahalagang yelo.
Dialogue: 0,0:50:06.88,0:50:08.15,Default,Kus4,0,0,0,,Paano mo ito gusto?
Dialogue: 0,0:50:09.35,0:50:10.92,Default,Kus4,0,0,0,,Nakakapresko ang lasa.
Dialogue: 0,0:50:14.85,0:50:16.42,Default,Kus4,0,0,0,,Nagustuhan ko ito kaya hindi ko napigilan.
Dialogue: 0,0:50:58.23,0:50:59.33,Default,Kus4,0,0,0,,My queen!
Dialogue: 0,0:51:10.47,0:51:11.54,Default,Kus4,0,0,0,,Kamahalan!
Dialogue: 0,0:51:16.91,0:51:18.12,Default,Kus4,0,0,0,,How dare you?
Dialogue: 0,0:51:18.38,0:51:20.45,Default,Kus4,0,0,0,,Anong ginawa mo dito?
Dialogue: 0,0:51:23.35,0:51:25.99,Default,Kus4,0,0,0,,-Okay ka lang?\N-Ano? Oo.
Dialogue: 0,0:51:26.12,0:51:28.63,Default,Kus4,0,0,0,,How dare you throw a stone at the queen?
Dialogue: 0,0:51:30.33,0:51:32.06,Default,Kus4,0,0,0,,Ayos lang ako, Kamahalan.
Dialogue: 0,0:51:38.14,0:51:40.17,Default,Kus4,0,0,0,,Kunin ang babaeng ito sa kustodiya.
Dialogue: 0,0:51:40.84,0:51:42.87,Default,Kus4,0,0,0,,Parurusahan siya sa ginawa niya.
Dialogue: 0,0:51:45.24,0:51:46.28,Default,Kus4,0,0,0,,Kamahalan.
Dialogue: 0,0:51:48.78,0:51:49.88,Default,Kus4,0,0,0,,Sumama ka sa akin.
Dialogue: 0,0:51:51.32,0:51:52.42,Default,Kus4,0,0,0,,Damhyan.
Dialogue: 0,0:52:01.93,0:52:03.49,Default,Kus4,0,0,0,,Napakahalaga niya sa akin.
Dialogue: 0,0:52:03.53,0:52:06.76,Default,Kus4,0,0,0,,Okay lang ako, kaya huwag kang magalit.
Dialogue: 0,0:52:06.76,0:52:08.73,Default,Kus4,0,0,0,,Wala itong kinalaman sa iyo.
Dialogue: 0,0:52:09.20,0:52:11.54,Default,Kus4,0,0,0,,Gumawa siya ng gulo sa palasyo
Dialogue: 0,0:52:11.54,0:52:13.67,Default,Kus4,0,0,0,,at lumabag sa itinatag na utos.
Dialogue: 0,0:52:14.74,0:52:16.37,Default,Kus4,0,0,0,,Bata lang siya.
Dialogue: 0,0:52:16.81,0:52:18.41,Default,Kus4,0,0,0,,Sigurado akong may dahilan siya.
Dialogue: 0,0:52:18.41,0:52:20.04,Default,Kus4,0,0,0,,Hindi niya ito gagawin nang walang dahilan.
Dialogue: 0,0:52:20.04,0:52:21.65,Default,Kus4,0,0,0,,Kung magpapatuloy ka ng ganito,
Dialogue: 0,0:52:21.65,0:52:23.71,Default,Kus4,0,0,0,,Aakusahan ko siya ng hindi naaangkop na pag-uugali
Dialogue: 0,0:52:23.71,0:52:25.62,Default,Kus4,0,0,0,,at paparusahan pa kita ng mas matindi.
Dialogue: 0,0:52:30.35,0:52:32.42,Default,Kus4,0,0,0,,Bakit ka nagmamadaling dumating?
Dialogue: 0,0:52:33.19,0:52:37.19,Default,Kus4,0,0,0,,Alam mo ba talaga na susubukang saktan ng bata ang reyna?
Dialogue: 0,0:52:39.10,0:52:40.96,Default,Kus4,0,0,0,,Sinusubukan mo ba akong kaladkarin dito?
Dialogue: 0,0:52:41.07,0:52:44.74,Default,Kus4,0,0,0,,Ito lang na ang oras ng iyong pagdating ay ganap na nag-tutugma.
Dialogue: 0,0:52:44.77,0:52:46.40,Default,Kus4,0,0,0,,Nag-alala ako,
Dialogue: 0,0:52:46.40,0:52:48.91,Default,Kus4,0,0,0,,na ang taong nagplano ng pagtataksil,
Dialogue: 0,0:52:48.91,0:52:50.54,Default,Kus4,0,0,0,,ay matatagpuan sa tabi ng reyna.
Dialogue: 0,0:52:51.08,0:52:52.74,Default,Kus4,0,0,0,,Nasira ang meeting na ito.
Dialogue: 0,0:52:53.24,0:52:54.71,Default,Kus4,0,0,0,,Babalik ako sa Dongmyeongjong.
Dialogue: 0,0:53:06.96,0:53:09.86,Default,Kus4,0,0,0,,Parurusahan ko talaga ang bata sa paglabag sa mga plano natin.
Dialogue: 0,0:53:10.46,0:53:12.50,Default,Kus4,0,0,0,,Aakohin mo rin ang responsibilidad,
Dialogue: 0,0:53:12.93,0:53:14.80,Default,Kus4,0,0,0,,para hindi malagay sa panganib ang pamilya natin.
Dialogue: 0,0:53:22.27,0:53:23.44,Default,Pineapple5,0,0,0,,Ano na ang mangyayari sa kanya ngayon?
Dialogue: 0,0:53:23.54,0:53:26.21,Default,Pineapple5,0,0,0,,Hindi naman nila sasampalin yung babae diba?
Dialogue: 0,0:53:26.41,0:53:28.08,Default,Pineapple5,0,0,0,,Sigurado ka bang okay ka lang?
Dialogue: 0,0:53:28.08,0:53:30.88,Default,Pineapple5,0,0,0,,Baka manhid ang dila mo o parang baliw ang tibok ng puso mo?
Dialogue: 0,0:53:32.05,0:53:33.68,Default,Pineapple5,0,0,0,,Ano ba ang pinag-uusapan niyo?\Ntalaga...
Dialogue: 0,0:53:33.68,0:53:35.09,Default,Pineapple5,0,0,0,,Wala dito.
Dialogue: 0,0:53:36.19,0:53:38.06,Default,Pineapple5,0,0,0,,Pupunta kami ng reyna sa Daejojon.
Dialogue: 0,0:53:38.66,0:53:39.96,Default,Pineapple5,0,0,0,,Oo, sir.
Dialogue: 0,0:53:55.34,0:53:57.34,Default,Pinya5,0,0,0,,Pakiusap, mula ngayon
Dialogue: 0,0:53:57.91,0:54:00.51,Default,Pineapple5,0,0,0,,panoorin ang lahat ng kinakain o inumin.
Dialogue: 0,0:54:01.35,0:54:03.25,Default,Pineapple5,0,0,0,,May inis ba ako?
Dialogue: 0,0:54:06.18,0:54:09.99,Default,Pineapple5,0,0,0,,Sigurado akong sinubukan kang lasunin ni Kim Jwageun at ng Queen Dowager.
Dialogue: 0,0:54:11.32,0:54:14.36,Default,Pineapple5,0,0,0,,Isang uri ng kalokohan. wala akong ginawa!
Dialogue: 0,0:54:16.86,0:54:20.40,Default,Pineapple5,0,0,0,,O lahat ba ito ay dahil tumulong ako sa handaan?
Dialogue: 0,0:54:21.27,0:54:22.67,Default,Pineapple5,0,0,0,,Natagpuan sa iyong mga silid
Dialogue: 0,0:54:24.23,0:54:25.94,Default,Pineapple5,0,0,0,,account book.
Dialogue: 0,0:54:26.97,0:54:28.01,Default,Pineapple5,0,0,0,,Account book?
Dialogue: 0,0:54:30.61,0:54:33.34,Default,Pineapple5,0,0,0,,Kaya tinanong ako ni Kim Jwageun at ng tatay ko tungkol sa kanya.
Dialogue: 0,0:54:34.24,0:54:36.25,Default,Pineapple5,0,0,0,,Ano ang mali sa aklat na ito?
Dialogue: 0,0:54:37.28,0:54:39.42,Default,Pineapple5,0,0,0,,Hindi mo siya sinama mula sa bahay?
Dialogue: 0,0:54:40.02,0:54:41.62,Default,Pineapple5,0,0,0,,Oo, wala akong ideya na umiral siya.
Dialogue: 0,0:54:41.62,0:54:44.02,Default,Pineapple5,0,0,0,,Hindi ko siya nakikita sa bahay, at higit pa rito.
Dialogue: 0,0:54:45.82,0:54:47.02,Default,Pineapple5,0,0,0,,Ganyan yan.
Dialogue: 0,0:54:47.83,0:54:49.79,Default,Pineapple5,0,0,0,,Gusto nilang lasunin, hindi ibagsak.
Dialogue: 0,0:54:51.73,0:54:53.66,Default,Pineapple5,0,0,0,,So iniligtas ako ni Damhyang?
Dialogue: 0,0:54:54.13,0:54:55.20,Default,Pineapple5,0,0,0,,Ganito pala.
Dialogue: 0,0:54:55.43,0:54:56.90,Default,Pineapple5,0,0,0,,Lason sa inumin.
Dialogue: 0,0:54:58.07,0:55:00.10,Default,Pineapple5,0,0,0,,Tumugo ako ng ilang higop.
Dialogue: 0,0:55:00.44,0:55:03.24,Default,Pineapple5,0,0,0,,Aalamin ko lahat mula kay Damhyang.
Dialogue: 0,0:55:03.57,0:55:05.01,Default,Pineapple5,0,0,0,,Ako mismo ang magtatanong sa kanya.
Dialogue: 0,0:55:05.34,0:55:07.85,Default,Pineapple5,0,0,0,,Magiging okay ba siya?\NSHindi siya dapat masaktan.
Dialogue: 0,0:55:08.21,0:55:10.35,Default,Pineapple5,0,0,0,,Yung nagplanong lasunin ka,
Dialogue: 0,0:55:10.35,0:55:11.88,Default,Pineapple5,0,0,0,,hindi siya bibitawan ng ganun-ganun lang.
Dialogue: 0,0:55:14.45,0:55:16.49,Default,Pineapple5,0,0,0,,Iligtas mo siya, nakikiusap ako.
Dialogue: 0,0:55:22.16,0:55:23.79,Default,Pineapple5,0,0,0,,Gagawin ko ang lahat.
Dialogue: 0,0:56:17.18,0:56:20.15,Default,Pineapple5,0,0,0,,Wala akong nagawang krimen.
Dialogue: 0,0:56:20.78,0:56:22.22,Default,Pineapple5,0,0,0,,Hindi ko ninakaw ang perang ito.
Dialogue: 0,0:56:23.05,0:56:25.49,Default,Pineapple5,0,0,0,,Inililigtas ko sila sa loob ng maraming taon,
Dialogue: 0,0:56:25.49,0:56:27.32,Default,Pineapple5,0,0,0,,upang tubusin ang bunso mula sa pagkaalipin.
Dialogue: 0,0:56:32.20,0:56:33.30,Default,Pineapple5,0,0,0,,Maawa ka.
Dialogue: 0,0:56:34.46,0:56:36.93,Default,Pineapple5,0,0,0,,Kung mamatay ako, bunso ko...
Dialogue: 0,0:56:42.64,0:56:44.11,Default,Pinya5,0,0,0,,Sabihin ang lahat ng alam mo
Dialogue: 0,0:56:45.91,0:56:47.11,Default,Pineapple5,0,0,0,,tungkol sa norig na ito.
Dialogue: 0,0:57:02.73,0:57:04.90,Default,Pineapple5,0,0,0,,-Damhyang!\N-Kamahalan!
Dialogue: 0,0:57:06.03,0:57:08.10,Default,Pineapple5,0,0,0,,Okay ka lang, reyna?
Dialogue: 0,0:57:08.10,0:57:09.90,Default,Pineapple5,0,0,0,,Kailangan kong itanong ito sa iyo.
Dialogue: 0,0:57:10.30,0:57:12.04,Default,Pineapple5,0,0,0,,Napakalaking pagpapala na sinubukan mo
Dialogue: 0,0:57:12.47,0:57:16.24,Default,Pineapple5,0,0,0,,inumin bago matunaw ang yelo.
Dialogue: 0,0:57:17.98,0:57:18.98,Default,Pineapple5,0,0,0,,Yelo?
Dialogue: 0,0:57:20.41,0:57:21.71,Default,Pineapple5,0,0,0,,Isalin siya ngayon!
Dialogue: 0,0:57:21.71,0:57:22.71,Default,Pineapple5,0,0,0,,-Oo.\N-Oo.
Dialogue: 0,0:57:25.52,0:57:27.99,Default,Pineapple5,0,0,0,,Saan mo siya ililipat? saan?
Dialogue: 0,0:57:32.26,0:57:34.56,Default,Pineapple5,0,0,0,,Kamahalan, wala ka dapat dito.
Dialogue: 0,0:57:34.99,0:57:37.19,Default,Pineapple5,0,0,0,,Alam mo na wala siyang dapat sisihin.
Dialogue: 0,0:57:37.19,0:57:38.60,Default,Pineapple5,0,0,0,,Hindi kita maintindihan.
Dialogue: 0,0:57:40.93,0:57:43.50,Default,Pineapple5,0,0,0,,Siya lang ang may kasalanan sa pagligtas sa akin.
Dialogue: 0,0:57:44.33,0:57:46.60,Default,Pineapple5,0,0,0,,Hindi ko alam kung sino ang nagsabi nito sa iyo,\Nbut please,
Dialogue: 0,0:57:46.94,0:57:48.21,Default,Pineapple5,0,0,0,,bumalik sa iyong sarili.
Dialogue: 0,0:57:51.01,0:57:52.11,Default,Pineapple5,0,0,0,,Paano kung tumanggi ako?
Dialogue: 0,0:57:53.14,0:57:55.98,Default,Pineapple5,0,0,0,,Ang babae ay lilitisin alinsunod sa mga batas.
Dialogue: 0,0:57:56.98,0:57:59.22,Default,Pineapple5,0,0,0,,Kung mananatili ka, magdurusa ka.
Dialogue: 0,0:58:00.45,0:58:02.29,Default,Pineapple5,0,0,0,,I-escort ang reyna sa kanyang mga silid.
Dialogue: 0,0:58:02.29,0:58:03.32,Default,Pineapple5,0,0,0,,-Oo.\N-Oo.
Dialogue: 0,0:58:07.56,0:58:09.79,Default,Pineapple5,0,0,0,,-Bitiwan mo ako!\N-Sasamahan ko ang reyna.
Dialogue: 0,0:58:18.17,0:58:20.00,Default,Pineapple5,0,0,0,,Bumalik ka sa iyong sarili, reyna.
Dialogue: 0,0:58:20.64,0:58:24.64,Default,Pineapple5,0,0,0,,Loud scandals\Nyou ay hindi makakatulong sa babaeng ito sa anumang paraan.
Dialogue: 0,0:58:26.41,0:58:27.44,Default,Pinya5,0,0,0,,Kamahalan!
Dialogue: 0,0:58:45.26,0:58:48.43,Default,Pineapple5,0,0,0,,Damhyang, ililibre na kita.\NAgreed?
Dialogue: 0,0:58:49.93,0:58:51.77,Default,Pineapple5,0,0,0,,Wag kang matakot.
Dialogue: 0,0:58:52.40,0:58:53.87,Default,Pineapple5,0,0,0,,Okay.
Dialogue: 0,0:58:55.94,0:58:58.48,Default,Pineapple5,0,0,0,,Reyna, kailangan na nating umalis.
Dialogue: 0,0:59:00.78,0:59:01.91,Default,Pineapple5,0,0,0,,Ililibre kita.
Dialogue: 0,0:59:27.50,0:59:31.37,Default,Pineapple5,0,0,0,,How dare the lady of the court\NBato ng bato sa reyna?
Dialogue: 0,0:59:31.37,0:59:32.98,Default,Pineapple5,0,0,0,,Ito ay isang insulto sa maharlikang tao!
Dialogue: 0,0:59:32.98,0:59:36.35,Default,Pineapple5,0,0,0,,Lahat ay mas masahol pa!\NIto ay pagtataksil na!
Dialogue: 0,0:59:37.18,0:59:39.15,Default,Pineapple5,0,0,0,,Narinig kong inakusahan ang kanyang ama ng paglihis
Dialogue: 0,0:59:39.15,0:59:41.15,Default,Pineapple5,0,0,0,,mula sa serbisyo militar at pagtataksil.
Dialogue: 0,0:59:41.15,0:59:42.85,Default,Pineapple5,0,0,0,,Gaya ng sabi nila, ang dugo ay hindi tubig.
Dialogue: 0,0:59:44.25,0:59:46.62,Default,Pineapple5,0,0,0,,Mahal na mga ministro, sobra kayong nagre-react.
Dialogue: 0,0:59:46.62,0:59:49.86,Default,Pineapple5,0,0,0,,Hindi pa namin alam kung ano ang nag-udyok sa kanya na gawin ito.
Dialogue: 0,0:59:50.16,0:59:53.00,Default,Pinya5,0,0,0,,Ang pag-aalsa ng magsasaka\Nis pagkakaroon ng momentum at
Dialogue: 0,0:59:53.00,0:59:55.27,Default,Pineapple5,0,0,0,,nagbabanta sa maharlikang kapangyarihan.
Dialogue: 0,0:59:55.43,0:59:57.13,Default,Pineapple5,0,0,0,,Gamit ang babaeng ito bilang halimbawa, kailangan nating
Dialogue: 0,0:59:57.13,0:59:58.97,Default,Pineapple5,0,0,0,,palakasin ang iyong kapangyarihan sa mga tao.
Dialogue: 0,0:59:58.97,1:00:00.97,Default,Pineapple5,0,0,0,,Ngayon kinakaladkad mo ang mga rebeldeng magsasaka?
Dialogue: 0,1:00:00.97,1:00:04.44,Default,Pineapple5,0,0,0,,How dare she throw a stone at the queen?
Dialogue: 0,1:00:04.44,1:00:07.34,Default,Pineapple5,0,0,0,,Sigurado akong na-brainwash siya ng mga banditang iyon!
Dialogue: 0,1:00:07.58,1:00:11.25,Default,Pineapple5,0,0,0,,Brainwash ng mga bandido?\NLimang taong gulang pa lang ang babae.
Dialogue: 0,1:00:11.25,1:00:13.02,Default,Pineapple5,0,0,0,,Huwag isipin ito bilang kabastusan,
Dialogue: 0,1:00:13.25,1:00:15.82,Default,Pineapple5,0,0,0,,pero may naniniwala\Nna ikaw, ginoo,
Dialogue: 0,1:00:16.15,1:00:19.32,Default,Pineapple5,0,0,0,,nakatira sa Ganghwado,\Nkipag-usap kami sa mga rebeldeng bandido.
Dialogue: 0,1:00:20.02,1:00:23.03,Default,Pineapple5,0,0,0,,Ngayon nagpasya ka na banta ako nito?
Dialogue: 0,1:00:23.86,1:00:26.70,Default,Pineapple5,0,0,0,,Kung tumanggi kang parusahan ang babae\Nand subukang iligtas siya,
Dialogue: 0,1:00:27.03,1:00:31.54,Default,Pineapple5,0,0,0,,kukumpirmahin mo lang ang aming mga hinala na
Dialogue: 0,1:00:32.24,1:00:34.17,Default,Pineapple5,0,0,0,,na sumasang-ayon ka sa mga bandido.
Dialogue: 0,1:00:35.41,1:00:38.34,Default,Pineapple5,0,0,0,,Kailangan mo lang parusahan ang maid sa pagsuway.
Dialogue: 0,1:00:38.98,1:00:40.68,Default,Pineapple5,0,0,0,,At matatapos na ang lahat.
Dialogue: 0,1:00:46.98,1:00:48.65,Default,Pineapple5,0,0,0,,Pakikinggan niya tayo di ba?
Dialogue: 0,1:00:49.25,1:00:52.46,Default,Pineapple5,0,0,0,,The Queen Dowager\Nasked sa amin na igiit ang parusa.
Dialogue: 0,1:00:53.09,1:00:55.43,Default,Pineapple5,0,0,0,,Pinaalis ang galit sa kanya para sa
Dialogue: 0,1:00:55.43,1:00:57.06,Default,Pineapple5,0,0,0,,na tinanggal siya sa trono?
Dialogue: 0,1:00:57.49,1:00:59.80,Default,Pineapple5,0,0,0,,Tulad ng walang kwentang babaeng ito
Dialogue: 0,1:00:59.80,1:01:04.17,Default,Pineapple5,0,0,0,,naglakas-loob na pigilan kami sa pagtanggal ng reyna?
Dialogue: 0,1:01:25.59,1:01:27.46,Default,Pineapple5,0,0,0,,Ano ang nagtagal?
Dialogue: 0,1:01:28.59,1:01:29.99,Default,Pineapple5,0,0,0,,Magiging maayos ang lahat, tama ba?
Dialogue: 0,1:01:30.69,1:01:33.50,Default,Pineapple5,0,0,0,,Ang mga ganoong late meeting\Nhindi hahantong sa magagandang bagay.
Dialogue: 0,1:01:36.17,1:01:37.80,Default,Pineapple5,0,0,0,,-Kamahalan.\N-Yes?
Dialogue: 0,1:02:00.66,1:02:02.56,Default,Pinya5,0,0,0,,Narito, Kamahalan!
Dialogue: 0,1:02:02.56,1:02:03.66,Default,Pineapple5,0,0,0,,Okay.
Dialogue: 0,1:02:09.40,1:02:12.84,Default,Pineapple5,0,0,0,,Tandaan ang sandaling ito sa buong buhay mo.
Dialogue: 0,1:02:13.17,1:02:18.01,Default,Pineapple5,0,0,0,,Ang mga courtier sa palasyo\Ndapat bulag at bingi sa mga nangyayari,
Dialogue: 0,1:02:18.98,1:02:22.85,Default,Pineapple5,0,0,0,,hindi dapat magkaroon ng kahit isang mapaghimagsik na kaisipan sa kanilang isipan.
Dialogue: 0,1:02:23.48,1:02:26.15,Default,Pineapple5,0,0,0,,Kung kahit isa sa inyo ang sumusuporta
Dialogue: 0,1:02:26.15,1:02:29.75,Default,Pineapple5,0,0,0,,pag-aalsa ng mga magsasaka, ito ang naghihintay sa iyo.
Dialogue: 0,1:02:31.29,1:02:33.26,Default,Pineapple5,0,0,0,,Ang katulong ay isang hangal na bata.
Dialogue: 0,1:02:35.06,1:02:36.13,Default,Pineapple5,0,0,0,,Tahimik!
Dialogue: 0,1:02:39.33,1:02:41.30,Default,Pineapple5,0,0,0,,Akala ko may nahuli tayong importante,
Dialogue: 0,1:02:42.80,1:02:45.77,Default,Pineapple5,0,0,0,,pero bata lang ito?\NIIto ay hindi maintindihan!
Dialogue: 0,1:02:54.74,1:02:55.78,Default,Pineapple5,0,0,0,,Late na ba tayo?
Dialogue: 0,1:03:04.55,1:03:06.39,Default,Pineapple5,0,0,0,,Ngayon alam mo na ang nararamdaman ko.
Dialogue: 0,1:03:14.56,1:03:16.77,Default,Pineapple5,0,0,0,,Gusto ka niyang iligtas.
Dialogue: 0,1:03:17.97,1:03:19.20,Default,Pineapple5,0,0,0,,Kaya nila siya pinatay.
Dialogue: 0,1:03:21.07,1:03:22.87,Default,Pineapple5,0,0,0,,Gusto nila akong lasunin, pero pinigilan ito ni Damhyan.
Dialogue: 0,1:04:06.48,1:04:07.88,Default,Pineapple5,0,0,0,,Wala siyang dapat sisihin sa anuman.
Dialogue: 0,1:04:08.89,1:04:10.15,Default,Pineapple5,0,0,0,,Ikaw na mismo ang nagsabi,
Dialogue: 0,1:04:11.49,1:04:15.59,Default,Pineapple5,0,0,0,,inilagay nila ang kanilang mga kasalanan sa isang maliit na bata!
Dialogue: 0,1:04:21.56,1:04:22.80,Default,Pineapple5,0,0,0,,Bakit hindi mo siya nailigtas?
Dialogue: 0,1:04:24.03,1:04:26.00,Default,Pineapple5,0,0,0,,Siya ay naging biktima sa pangalan ng isang bagay na mas malaki.
Dialogue: 0,1:04:27.80,1:04:28.84,Default,Pineapple5,0,0,0,,Higit pa?
Dialogue: 0,1:04:30.71,1:04:31.98,Default,Pineapple5,0,0,0,,Ikaw ba ay nagsasalita tungkol sa iyong sariling balat?
Dialogue: 0,1:04:34.78,1:04:38.01,Default,Pineapple5,0,0,0,,Hindi mo ba sinabi sa akin na ang mundo ay hindi patas?
Dialogue: 0,1:04:38.85,1:04:42.65,Default,Pineapple5,0,0,0,,Hihinto ang isang hindi gaanong sakripisyo\Nisang bagay na mas mapanganib!
Dialogue: 0,1:04:44.09,1:04:45.26,Default,Pineapple5,0,0,0,,Hindi gaanong biktima?
Dialogue: 0,1:04:48.32,1:04:49.43,Default,Pinya5,0,0,0,,Dahil
Dialogue: 0,1:04:50.49,1:04:52.30,Default,Pineapple5,0,0,0,,isa lang ba siyang walang pagtatanggol na babae?
Dialogue: 0,1:04:56.00,1:04:57.43,Default,Pineapple5,0,0,0,,Ang amateurism ay isang kasalanan.
Dialogue: 0,1:04:58.97,1:05:01.20,Default,Pineapple5,0,0,0,,Hindi mo mailigtas ang babaeng ito!
Dialogue: 0,1:05:03.97,1:05:05.11,Default,Pineapple5,0,0,0,,Ikaw ay isang makasalanan.
Dialogue: 0,1:05:30.60,1:05:32.40,Default,Pineapple5,0,0,0,,Kung ayaw mong magsalita,\Ndapat ba tayong gumamit ng mga hand signal?
Dialogue: 0,1:05:32.40,1:05:33.50,Default,Pineapple5,0,0,0,,Halimbawa, ito.
Dialogue: 0,1:05:33.50,1:05:35.71,Default,Pineapple5,0,0,0,,Ibig sabihin nagsisinungaling ako.
Dialogue: 0,1:05:36.04,1:05:37.17,Default,Pineapple5,0,0,0,,Ano ang masasabi mo?
Dialogue: 0,1:05:46.24,1:05:50.68,Default,Pinya5,0,0,0,,
Dialogue: 0,1:06:06.37,1:06:08.81,Default,Pineapple5,0,0,0,,Mula sa araw na ito, ako ay magiging\Npinakabaliw sa palasyo.
Dialogue: 0,1:06:08.81,1:06:12.68,Default,Pineapple5,0,0,0,,Ipapakita ko sa iyo kung ano ang mangyayari kapag inasar mo ako.
Dialogue: 0,1:06:12.68,1:06:14.74,Default,Pineapple5,0,0,0,,Nasubukan mo na bang tanggalin ang reyna?
Dialogue: 0,1:06:14.91,1:06:16.65,Default,Pineapple5,0,0,0,,-Damhyan!\N-Damhyan!
Dialogue: 0,1:06:18.01,1:06:19.25,Default,Pineapple5,0,0,0,,Pusta ko lahat!
Dialogue: 0,1:06:19.25,1:06:20.65,Default,Pineapple5,0,0,0,,Huwag maliitin si Kim Byungin.
Dialogue: 0,1:06:20.65,1:06:22.45,Default,Pineapple5,0,0,0,,Kahit ang Cho clan ay sumusunod sa kanya.
Dialogue: 0,1:06:22.45,1:06:23.62,Default,Pineapple5,0,0,0,,Maging kakampi tayo.
Dialogue: 0,1:06:23.62,1:06:26.49,Default,Pineapple5,0,0,0,,Mula ngayon, kalimutan ang tungkol sa pagdistansya.
Dialogue: 0,1:06:26.49,1:06:28.02,Default,Pineapple5,0,0,0,,Kalmado, ligaw na puso.
Dialogue: 0,1:06:28.02,1:06:30.19,Default,Pineapple5,0,0,0,,Ang lahat ng ito ay pagsubok lamang.
Dialogue: 0,1:06:30.19,1:06:32.43,Default,Pineapple5,0,0,0,,Gusto mo bang kumain ng ramen?
Dialogue: 0,0:13:26.28,0:13:28.28,Default,,0,0,0,,


